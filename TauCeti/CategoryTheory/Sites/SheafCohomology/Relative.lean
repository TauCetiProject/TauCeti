/-!
# Relative sheaf cohomology of a morphism of a site

Let `i : U ⟶ V` be a morphism in a site `(C, J)`, and write `ℤ_U`, `ℤ_V` for the free abelian
sheaves generated by `U` and `V` (`TauCeti.CategoryTheory.freeYonedaSheafFunctor`). The *relative
free sheaf* `ℤ_{V,U}` is the cokernel of the induced map `ℤ_U ⟶ ℤ_V`. Morphisms out of it are the
sections over `V` whose restriction along `i` vanishes, and the relative cohomology of an abelian
sheaf `F` is defined as `Hⁿ(V, U; F) = Extⁿ(ℤ_{V,U}, F)`.

When `i` is a monomorphism, `0 ⟶ ℤ_U ⟶ ℤ_V ⟶ ℤ_{V,U} ⟶ 0` is short exact, and the contravariant
long exact `Ext` sequence becomes the long exact sequence of the pair

`⋯ ⟶ Hⁿ(V, U; F) ⟶ Hⁿ(V, F) ⟶ Hⁿ(U, F) ⟶ Hⁿ⁺¹(V, U; F) ⟶ ⋯`.

Here `Hⁿ(V, F)` is Mathlib's `CategoryTheory.Sheaf.H'`, which is by definition `Ext` out of the
free abelian sheaf on `V` (`CategoryTheory.Sheaf.H'AddEquivExt`), and the middle map is the
restriction map of the cohomology presheaf, which is precomposition with `ℤ_U ⟶ ℤ_V`
(`CategoryTheory.Sheaf.cohomologyPresheaf_map_apply`).

For a triple `i : U ⟶ U'`, `j : U' ⟶ V` with `j` a monomorphism, the maps of pairs
`(U', U) ⟶ (V, U) ⟶ (V, U')` induce a short exact sequence
`0 ⟶ ℤ_{U',U} ⟶ ℤ_{V,U} ⟶ ℤ_{V,U'} ⟶ 0`, and its long exact `Ext` sequence is the long exact
sequence of the triple

`⋯ ⟶ Hⁿ(V, U'; F) ⟶ Hⁿ(V, U; F) ⟶ Hⁿ(U', U; F) ⟶ Hⁿ⁺¹(V, U'; F) ⟶ ⋯`.

For the site of open subsets of a topological space, an open `W` and a closed subset `S`, the
morphism `W ∖ S ⟶ W` gives the cohomology of `F` on `W` with supports in `S`; this is developed in
`TauCeti.Topology.Sheaves.SupportedCohomology`.

## Main declarations

* `TauCeti.CategoryTheory.relativeFreeYonedaSheaf J i`: the relative free sheaf `ℤ_{V,U}`;
* `TauCeti.CategoryTheory.relativeFreeYonedaSheafHomEquiv`: morphisms `ℤ_{V,U} ⟶ F` are the
  sections of `F` over `V` restricting to zero along `i`;
* `TauCeti.CategoryTheory.relativeFreeYonedaSequence_shortExact`: the sequence
  `0 ⟶ ℤ_U ⟶ ℤ_V ⟶ ℤ_{V,U} ⟶ 0` is short exact for a monomorphism `i`;
* `CategoryTheory.Sheaf.relativeH' F i n`: the relative cohomology `Hⁿ(V, U; F)`;
* `CategoryTheory.Sheaf.relativeH'.toH'` and `CategoryTheory.Sheaf.relativeH'.δ`: the maps of
  the long exact sequence of the pair, whose exactness is
  `relativeH'.exact_toH'_cohomologyPresheaf_map`, `relativeH'.exact_cohomologyPresheaf_map_δ` and
  `relativeH'.exact_δ_toH'`;
* `CategoryTheory.Sheaf.relativeH'.zeroEquiv`: `H⁰(V, U; F)` is the group of sections over `V`
  restricting to zero along `i`, naturally in `F` (`relativeH'.coe_zeroEquiv_naturality_right`);
* `CategoryTheory.Sheaf.relativeH'.subsingleton_one` and `relativeH'.subsingleton_add_two`:
  vanishing of relative cohomology from vanishing of absolute cohomology.
* `TauCeti.CategoryTheory.relativeFreeYonedaSheafMap`: the map `ℤ_{V',U'} ⟶ ℤ_{V,U}` induced by a
  commutative square from `i' : U' ⟶ V'` to `i : U ⟶ V`, and
  `TauCeti.CategoryTheory.isIso_relativeFreeYonedaSheafMap_iff`, its Yoneda criterion for being an
  isomorphism in terms of sections restricting to zero;
* `CategoryTheory.Sheaf.relativeH'.map` and `CategoryTheory.Sheaf.relativeH'.mapAddEquiv`: the
  induced map `Hⁿ(V, U; F) ⟶ Hⁿ(V', U'; F)`, and the equivalence it gives when the map of relative
  free sheaves is an isomorphism;
* `TauCeti.CategoryTheory.relativeFreeYonedaTripleSequence_shortExact`: the sequence
  `0 ⟶ ℤ_{U',U} ⟶ ℤ_{V,U} ⟶ ℤ_{V,U'} ⟶ 0` of a triple `U ⟶ U' ⟶ V` is short exact when
  `U' ⟶ V` is a monomorphism;
* `CategoryTheory.Sheaf.relativeH'.tripleδ`: the connecting map `Hⁿ(U', U; F) ⟶ Hⁿ⁺¹(V, U'; F)`
  of the long exact sequence of the triple, whose exactness is `relativeH'.exact_map_map`,
  `relativeH'.exact_map_tripleδ` and `relativeH'.exact_tripleδ_map`.

## References

* A. Grothendieck, *Local cohomology*, Lecture Notes in Mathematics 41, §1.
* M. Kashiwara and P. Schapira, *Sheaves on Manifolds*, §2.6.
-/

public section

open CategoryTheory Limits Opposite Abelian

universe w v u

namespace TauCeti

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

noncomputable section

variable [HasSheafify J AddCommGrpCat.{v}]

/-- The free abelian sheaf on `V` relative to `U`: the cokernel of the map `ℤ_U ⟶ ℤ_V` of free
abelian sheaves induced by `i : U ⟶ V`. -/
abbrev relativeFreeYonedaSheaf {U V : C} (i : U ⟶ V) : Sheaf J AddCommGrpCat.{v} :=
  cokernel ((freeYonedaSheafFunctor J).map i)

/-- Morphisms from the relative free sheaf of `i : U ⟶ V` to an abelian sheaf `F` are additively
equivalent to the sections of `F` over `V` whose restriction along `i` vanishes. -/
def relativeFreeYonedaSheafHomEquiv {U V : C} (i : U ⟶ V) (F : Sheaf J AddCommGrpCat.{v}) :
    (relativeFreeYonedaSheaf J i ⟶ F) ≃+ (F.obj.map i.op).hom.ker where
  toFun g := ⟨freeYonedaSheafSectionsEquiv J V F (cokernel.π _ ≫ g), by
    -- `AddCommGrpCat.Hom.hom` unfolds to the `ConcreteCategory.hom` coercion used by the
    -- naturality lemma
    rw [AddMonoidHom.mem_ker, AddCommGrpCat.Hom.hom, ← freeYonedaSheafSectionsEquiv_naturality_left,
      cokernel.condition_assoc, zero_comp, map_zero]⟩
  invFun s := cokernel.desc _ ((freeYonedaSheafSectionsEquiv J V F).symm s) <| by
    apply (freeYonedaSheafSectionsEquiv J U F).injective
    rw [freeYonedaSheafSectionsEquiv_naturality_left, AddEquiv.apply_symm_apply, map_zero]
    exact s.2
  left_inv g := by
    refine (cancel_epi (cokernel.π _)).1 ?_
    exact (cokernel.π_desc _ _ _).trans (AddEquiv.symm_apply_apply _ _)
  right_inv s := by
    apply Subtype.ext
    simp
  map_add' g h := by
    apply Subtype.ext
    simp

@[simp]
lemma coe_relativeFreeYonedaSheafHomEquiv_apply {U V : C} (i : U ⟶ V)
    (F : Sheaf J AddCommGrpCat.{v}) (g : relativeFreeYonedaSheaf J i ⟶ F) :
    (relativeFreeYonedaSheafHomEquiv J i F g : F.obj.obj (op V)) =
      freeYonedaSheafSectionsEquiv J V F (cokernel.π _ ≫ g) :=
  (rfl)

@[simp]
lemma cokernel_π_comp_relativeFreeYonedaSheafHomEquiv_symm_apply {U V : C} (i : U ⟶ V)
    (F : Sheaf J AddCommGrpCat.{v}) (s : (F.obj.map i.op).hom.ker) :
    cokernel.π _ ≫ (relativeFreeYonedaSheafHomEquiv J i F).symm s =
      (freeYonedaSheafSectionsEquiv J V F).symm s :=
  cokernel.π_desc _ _ _

/-- The equivalence `relativeFreeYonedaSheafHomEquiv` is natural in the coefficient sheaf. -/
lemma relativeFreeYonedaSheafHomEquiv_naturality_right {U V : C} (i : U ⟶ V)
    {F G : Sheaf J AddCommGrpCat.{v}} (g : relativeFreeYonedaSheaf J i ⟶ F) (f : F ⟶ G) :
    (relativeFreeYonedaSheafHomEquiv J i G (g ≫ f) : G.obj.obj (op V)) =
      f.hom.app (op V) (relativeFreeYonedaSheafHomEquiv J i F g) := by
  simp

/-- The sequence `ℤ_U ⟶ ℤ_V ⟶ ℤ_{V,U}` of free abelian sheaves attached to `i : U ⟶ V`. -/
abbrev relativeFreeYonedaSequence {U V : C} (i : U ⟶ V) :
    ShortComplex (Sheaf J AddCommGrpCat.{v}) :=
  ShortComplex.cokernelSequence ((freeYonedaSheafFunctor J).map i)

/-- For a monomorphism `i : U ⟶ V`, the sequence `0 ⟶ ℤ_U ⟶ ℤ_V ⟶ ℤ_{V,U} ⟶ 0` is short
exact. -/
lemma relativeFreeYonedaSequence_shortExact {U V : C} (i : U ⟶ V) [Mono i] :
    (relativeFreeYonedaSequence J i).ShortExact where
  exact := ShortComplex.cokernelSequence_exact _
  mono_f := inferInstanceAs (Mono ((freeYonedaSheafFunctor J).map i))

/-- If `i` is an isomorphism, the relative free sheaf of `i` is zero. -/
lemma isZero_relativeFreeYonedaSheaf {U V : C} (i : U ⟶ V) [IsIso i] :
    IsZero (relativeFreeYonedaSheaf J i) :=
  isZero_cokernel_of_epi _

section map

variable {U' V' U V : C} (i' : U' ⟶ V') (i : U ⟶ V) (a : U' ⟶ U) (b : V' ⟶ V)
  (w : i' ≫ b = a ≫ i)

/-- The map of relative free sheaves `ℤ_{V',U'} ⟶ ℤ_{V,U}` induced by a commutative square
`i' ≫ b = a ≫ i` from `i' : U' ⟶ V'` to `i : U ⟶ V`. -/
def relativeFreeYonedaSheafMap : relativeFreeYonedaSheaf J i' ⟶ relativeFreeYonedaSheaf J i :=
  cokernel.map _ _ ((freeYonedaSheafFunctor J).map a) ((freeYonedaSheafFunctor J).map b) (by
    rw [← Functor.map_comp, ← Functor.map_comp, w])

@[reassoc (attr := simp)]
lemma cokernel_π_relativeFreeYonedaSheafMap :
    cokernel.π _ ≫ relativeFreeYonedaSheafMap J i' i a b w =
      (freeYonedaSheafFunctor J).map b ≫ cokernel.π _ :=
  cokernel.π_desc _ _ _

@[simp]
lemma relativeFreeYonedaSheafMap_id :
    relativeFreeYonedaSheafMap J i i (𝟙 U) (𝟙 V) (by simp) = 𝟙 _ :=
  (cancel_epi (cokernel.π _)).1 (by simp)

lemma relativeFreeYonedaSheafMap_comp {U'' V'' : C} (i'' : U'' ⟶ V'') (a' : U'' ⟶ U')
    (b' : V'' ⟶ V') (w' : i'' ≫ b' = a' ≫ i') :
    relativeFreeYonedaSheafMap J i'' i' a' b' w' ≫ relativeFreeYonedaSheafMap J i' i a b w =
      relativeFreeYonedaSheafMap J i'' i (a' ≫ a) (b' ≫ b)
        (by rw [reassoc_of% w', w, Category.assoc]) :=
  (cancel_epi (cokernel.π _)).1 (by simp)

/-- Under `relativeFreeYonedaSheafHomEquiv`, precomposition with `relativeFreeYonedaSheafMap` is
the restriction of sections along `b`. -/
lemma coe_relativeFreeYonedaSheafHomEquiv_map_comp (F : Sheaf J AddCommGrpCat.{v})
    (g : relativeFreeYonedaSheaf J i ⟶ F) :
    (relativeFreeYonedaSheafHomEquiv J i' F (relativeFreeYonedaSheafMap J i' i a b w ≫ g) :
        F.obj.obj (op V')) =
      F.obj.map b.op (relativeFreeYonedaSheafHomEquiv J i F g) := by
  rw [coe_relativeFreeYonedaSheafHomEquiv_apply, coe_relativeFreeYonedaSheafHomEquiv_apply,
    cokernel_π_relativeFreeYonedaSheafMap_assoc, freeYonedaSheafSectionsEquiv_naturality_left]

/-- The map of relative free sheaves induced by a commutative square is an isomorphism if and only
if, for every abelian sheaf `F`, restriction along `b` is a bijection from the sections over `V`
vanishing along `i` to the sections over `V'` vanishing along `i'`. -/
theorem isIso_relativeFreeYonedaSheafMap_iff :
    IsIso (relativeFreeYonedaSheafMap J i' i a b w) ↔
      ∀ (F : Sheaf J AddCommGrpCat.{v}) (s : F.obj.obj (op V')),
        s ∈ (F.obj.map i'.op).hom.ker →
          ∃! t : F.obj.obj (op V), t ∈ (F.obj.map i.op).hom.ker ∧ F.obj.map b.op t = s := by
  set f := relativeFreeYonedaSheafMap J i' i a b w
  -- both directions compare precomposition with `f` and restriction along `b` through
  -- `relativeFreeYonedaSheafHomEquiv`
  have key (F : Sheaf J AddCommGrpCat.{v}) (g : relativeFreeYonedaSheaf J i ⟶ F)
      (g' : relativeFreeYonedaSheaf J i' ⟶ F) :
      f ≫ g = g' ↔ F.obj.map b.op (relativeFreeYonedaSheafHomEquiv J i F g) =
        relativeFreeYonedaSheafHomEquiv J i' F g' := by
    rw [← coe_relativeFreeYonedaSheafHomEquiv_map_comp, Subtype.coe_inj,
      (relativeFreeYonedaSheafHomEquiv J i' F).injective.eq_iff]
  constructor
  · intro _ F s hs
    let g' := (relativeFreeYonedaSheafHomEquiv J i' F).symm ⟨s, hs⟩
    refine ⟨relativeFreeYonedaSheafHomEquiv J i F (inv f ≫ g'),
      ⟨(relativeFreeYonedaSheafHomEquiv J i F _).2, ?_⟩, ?_⟩
    · simpa [g'] using (key F (inv f ≫ g') g').1 (IsIso.hom_inv_id_assoc f g')
    · rintro t ⟨ht, hts⟩
      have h : f ≫ (relativeFreeYonedaSheafHomEquiv J i F).symm ⟨t, ht⟩ = g' :=
        (key F _ g').2 (by simpa [g'] using hts)
      rw [← h, IsIso.inv_hom_id_assoc, AddEquiv.apply_symm_apply]
  · intro h
    refine isIso_of_coyoneda_map_bijective f fun F ↦ ⟨fun g₁ g₂ hg ↦ ?_, fun g' ↦ ?_⟩
    · set s := relativeFreeYonedaSheafHomEquiv J i' F (f ≫ g₂)
      apply (relativeFreeYonedaSheafHomEquiv J i F).injective
      exact Subtype.ext <| (h F s s.2).unique
        ⟨(relativeFreeYonedaSheafHomEquiv J i F g₁).2, (key F g₁ _).1 hg⟩
        ⟨(relativeFreeYonedaSheafHomEquiv J i F g₂).2, (key F g₂ _).1 rfl⟩
    · obtain ⟨t, ⟨ht, hts⟩, -⟩ := h F _ (relativeFreeYonedaSheafHomEquiv J i' F g').2
      refine ⟨(relativeFreeYonedaSheafHomEquiv J i F).symm ⟨t, ht⟩, (key F _ g').2 ?_⟩
      rw [AddEquiv.apply_symm_apply]
      exact hts

/-- A commutative square `i' ≫ b = a ≫ i` in which `a` and `b` are isomorphisms induces an
isomorphism of relative free sheaves. -/
instance isIso_relativeFreeYonedaSheafMap [IsIso a] [IsIso b] :
    IsIso (relativeFreeYonedaSheafMap J i' i a b w) :=
  -- `relativeFreeYonedaSheafMap` is a `cokernel.map`, which Mathlib inverts
  inferInstanceAs (IsIso (cokernel.map _ _ ((freeYonedaSheafFunctor J).map a) _
    (by rw [← Functor.map_comp, ← Functor.map_comp, w])))

end map

section triple

variable {U U' V : C} (i : U ⟶ U') (j : U' ⟶ V)

/-- The sequence `ℤ_{U',U} ⟶ ℤ_{V,U} ⟶ ℤ_{V,U'}` of relative free sheaves attached to a triple
`U ⟶ U' ⟶ V`, whose maps are induced by the morphisms of pairs `(U', U) ⟶ (V, U)` and
`(V, U) ⟶ (V, U')`. -/
abbrev relativeFreeYonedaTripleSequence : ShortComplex (Sheaf J AddCommGrpCat.{v}) where
  X₁ := relativeFreeYonedaSheaf J i
  X₂ := relativeFreeYonedaSheaf J (i ≫ j)
  X₃ := relativeFreeYonedaSheaf J j
  f := relativeFreeYonedaSheafMap J i (i ≫ j) (𝟙 U) j (by simp)
  g := relativeFreeYonedaSheafMap J (i ≫ j) j i (𝟙 V) (by simp)
  zero := (cancel_epi (cokernel.π _)).1 (by simp)

/-- For morphisms `i : U ⟶ U'` and `j : U' ⟶ V` with `j` a monomorphism, the sequence
`0 ⟶ ℤ_{U',U} ⟶ ℤ_{V,U} ⟶ ℤ_{V,U'} ⟶ 0` is short exact. -/
lemma relativeFreeYonedaTripleSequence_shortExact [Mono j] :
    (relativeFreeYonedaTripleSequence J i j).ShortExact :=
  TauCeti.shortExact_of_isColimit_cokernelCofork (Functor.map_comp _ _ _).symm inferInstance
    (cokernelIsCokernel _) (cokernelIsCokernel _) (cokernelIsCokernel _)
    (by simp [relativeFreeYonedaSheafMap]) (by simp [relativeFreeYonedaSheafMap])

end triple

end

end CategoryTheory

end TauCeti

namespace CategoryTheory

namespace Sheaf

open TauCeti.CategoryTheory

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  [HasSheafify J AddCommGrpCat.{v}] [HasExt.{w} (Sheaf J AddCommGrpCat.{v})]

/-- The relative cohomology `Hⁿ(V, U; F)` of an abelian sheaf `F` for a morphism `i : U ⟶ V` of
the site: the `n`-th `Ext` group from the relative free sheaf `ℤ_{V,U}` to `F`. -/
abbrev relativeH' (F : Sheaf J AddCommGrpCat.{v}) {U V : C} (i : U ⟶ V) (n : ℕ) : Type w :=
  Ext (relativeFreeYonedaSheaf J i) F n

namespace relativeH'

variable (F : Sheaf J AddCommGrpCat.{v}) {U V : C} (i : U ⟶ V)

/-- The map `Hⁿ(V, U; F) ⟶ Hⁿ(V, F)` of the long exact sequence of the pair, induced by
`ℤ_V ⟶ ℤ_{V,U}`. -/
noncomputable def toH' (n : ℕ) : F.relativeH' i n →+ F.H' n V :=
  (F.H'AddEquivExt n V).symm.toAddMonoidHom.comp
    ((Ext.mk₀ (cokernel.π ((freeYonedaSheafFunctor J).map i))).precomp F (zero_add n))

lemma H'AddEquivExt_toH' {n : ℕ} (x : F.relativeH' i n) :
    F.H'AddEquivExt n V (toH' F i n x) =
      (Ext.mk₀ (cokernel.π ((freeYonedaSheafFunctor J).map i))).comp x (zero_add n) :=
  AddEquiv.apply_symm_apply _ _

/-- The connecting map `Hⁿ(U, F) ⟶ Hⁿ⁺¹(V, U; F)` of the long exact sequence of the pair. -/
noncomputable def δ [Mono i] {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁) : F.H' n₀ U →+ F.relativeH' i n₁ :=
  ((relativeFreeYonedaSequence_shortExact J i).extClass.precomp F h).comp
    (F.H'AddEquivExt n₀ U).toAddMonoidHom

lemma δ_apply [Mono i] {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁) (x : F.H' n₀ U) :
    δ F i h x =
      (relativeFreeYonedaSequence_shortExact J i).extClass.comp (F.H'AddEquivExt n₀ U x) h :=
  (rfl)

/-- The restriction map of the cohomology presheaf along `i` is precomposition with
`ℤ_U ⟶ ℤ_V`, transported along `CategoryTheory.Sheaf.H'AddEquivExt`. -/
private lemma cohomologyPresheaf_map_comp_symm (n : ℕ) :
    ((F.cohomologyPresheaf n).map i.op).hom.comp (F.H'AddEquivExt n V).symm.toAddMonoidHom =
      (F.H'AddEquivExt n U).symm.toAddMonoidHom.comp
        ((Ext.mk₀ ((freeYonedaSheafFunctor J).map i)).precomp F (zero_add n)) := by
  ext x
  apply (F.H'AddEquivExt n U).injective
  simp only [AddMonoidHom.coe_comp, AddEquiv.coe_toAddMonoidHom, Function.comp_apply,
    AddEquiv.apply_symm_apply]
  rw [cohomologyPresheaf_map_apply, AddEquiv.apply_symm_apply]
  rfl

section exact

variable [Mono i]

/-- The connecting map `δ` is precomposition with the extension class, transported along
`CategoryTheory.Sheaf.H'AddEquivExt`. -/
private lemma δ_comp_symm {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁) :
    (δ F i h).comp (F.H'AddEquivExt n₀ U).symm.toAddMonoidHom =
      (relativeFreeYonedaSequence_shortExact J i).extClass.precomp F h := by
  ext x
  exact congrArg ((relativeFreeYonedaSequence_shortExact J i).extClass.precomp F h)
    (AddEquiv.apply_symm_apply _ x)

/-- The long exact sequence of the pair is exact at `Hⁿ(V, F)`: a class on `V` comes from
relative cohomology exactly when its restriction to `U` vanishes. -/
theorem exact_toH'_cohomologyPresheaf_map (n : ℕ) :
    Function.Exact (toH' F i n) ((F.cohomologyPresheaf n).map i.op) :=
  (Function.Exact.iff_of_ladder_addEquiv (AddEquiv.refl _) (F.H'AddEquivExt n V).symm
    (F.H'AddEquivExt n U).symm
    (f₁₂ := (Ext.mk₀ (cokernel.π ((freeYonedaSheafFunctor J).map i))).precomp F (zero_add n))
    (f₂₃ := (Ext.mk₀ ((freeYonedaSheafFunctor J).map i)).precomp F (zero_add n))
    (g₁₂ := toH' F i n) (g₂₃ := ((F.cohomologyPresheaf n).map i.op).hom) rfl
    (cohomologyPresheaf_map_comp_symm F i n)).2
    (TauCeti.exact_precomp (relativeFreeYonedaSequence_shortExact J i) F n)

/-- The long exact sequence of the pair is exact at `Hⁿ(U, F)`: the kernel of the connecting map
consists of the restrictions of classes on `V`. -/
theorem exact_cohomologyPresheaf_map_δ {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁) :
    Function.Exact ((F.cohomologyPresheaf n₀).map i.op) (δ F i h) :=
  (Function.Exact.iff_of_ladder_addEquiv (F.H'AddEquivExt n₀ V).symm (F.H'AddEquivExt n₀ U).symm
    (AddEquiv.refl _)
    (f₁₂ := (Ext.mk₀ ((freeYonedaSheafFunctor J).map i)).precomp F (zero_add n₀))
    (f₂₃ := (relativeFreeYonedaSequence_shortExact J i).extClass.precomp F h)
    (g₁₂ := ((F.cohomologyPresheaf n₀).map i.op).hom) (g₂₃ := δ F i h)
    (cohomologyPresheaf_map_comp_symm F i n₀) ((δ_comp_symm F i h).trans rfl)).2
    (TauCeti.exact_precomp₁ (relativeFreeYonedaSequence_shortExact J i) F n₀ n₁ h)

/-- The long exact sequence of the pair is exact at `Hⁿ⁺¹(V, U; F)`. -/
theorem exact_δ_toH' {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁) :
    Function.Exact (δ F i h) (toH' F i n₁) :=
  (Function.Exact.iff_of_ladder_addEquiv (F.H'AddEquivExt n₀ U).symm (AddEquiv.refl _)
    (F.H'AddEquivExt n₁ V).symm
    (f₁₂ := (relativeFreeYonedaSequence_shortExact J i).extClass.precomp F h)
    (f₂₃ := (Ext.mk₀ (cokernel.π ((freeYonedaSheafFunctor J).map i))).precomp F (zero_add n₁))
    (g₁₂ := δ F i h) (g₂₃ := toH' F i n₁) ((δ_comp_symm F i h).trans rfl) rfl).2
    (TauCeti.exact_precomp₃ (relativeFreeYonedaSequence_shortExact J i) F n₀ n₁ h)

end exact

/-- Degree-zero relative cohomology is the group of sections over `V` whose restriction along `i`
vanishes. -/
noncomputable def zeroEquiv : F.relativeH' i 0 ≃+ (F.obj.map i.op).hom.ker :=
  Ext.addEquiv₀.trans (relativeFreeYonedaSheafHomEquiv J i F)

@[simp]
lemma coe_zeroEquiv_apply (x : F.relativeH' i 0) :
    (zeroEquiv F i x : F.obj.obj (op V)) =
      freeYonedaSheafSectionsEquiv J V F (cokernel.π _ ≫ Ext.addEquiv₀ x) :=
  (rfl)

/-- The equivalence `zeroEquiv` is natural in the coefficient sheaf. -/
lemma coe_zeroEquiv_naturality_right {F G : Sheaf J AddCommGrpCat.{v}} (f : F ⟶ G)
    (x : F.relativeH' i 0) :
    (zeroEquiv G i (x.comp (Ext.mk₀ f) (add_zero 0)) : G.obj.obj (op V)) =
      f.hom.app (op V) (zeroEquiv F i x) := by
  rw [coe_zeroEquiv_apply, coe_zeroEquiv_apply, TauCeti.ext_addEquiv₀_comp_mk₀, ← Category.assoc,
    freeYonedaSheafSectionsEquiv_naturality_right]

/-- Under `zeroEquiv` and the identification of degree-zero cohomology with sections, the map
`toH'` is the inclusion of the sections restricting to zero. -/
lemma freeYonedaSheafSectionsEquiv_addEquiv₀_toH' (x : F.relativeH' i 0) :
    freeYonedaSheafSectionsEquiv J V F (Ext.addEquiv₀ (F.H'AddEquivExt 0 V (toH' F i 0 x))) =
      zeroEquiv F i x := by
  rw [H'AddEquivExt_toH', TauCeti.ext_addEquiv₀_mk₀_comp, coe_zeroEquiv_apply]

/-- Relative cohomology vanishes for an isomorphism. -/
instance subsingleton_of_isIso [IsIso i] (n : ℕ) : Subsingleton (F.relativeH' i n) :=
  TauCeti.subsingleton_ext_of_isZero_left (isZero_relativeFreeYonedaSheaf J i) F n

section map

variable {U' V' : C} (i' : U' ⟶ V') (a : U' ⟶ U) (b : V' ⟶ V) (w : i' ≫ b = a ≫ i)

/-- The map `Hⁿ(V, U; F) ⟶ Hⁿ(V', U'; F)` induced by a commutative square `i' ≫ b = a ≫ i`:
precomposition with the map `ℤ_{V',U'} ⟶ ℤ_{V,U}` of relative free sheaves. -/
noncomputable def map (n : ℕ) : F.relativeH' i n →+ F.relativeH' i' n :=
  (Ext.mk₀ (relativeFreeYonedaSheafMap J i' i a b w)).precomp F (zero_add n)

lemma map_apply {n : ℕ} (x : F.relativeH' i n) :
    map F i i' a b w n x =
      (Ext.mk₀ (relativeFreeYonedaSheafMap J i' i a b w)).comp x (zero_add n) :=
  (rfl)

@[simp]
lemma map_id {n : ℕ} (x : F.relativeH' i n) : map F i i (𝟙 U) (𝟙 V) (by simp) n x = x := by
  simp [map_apply]

lemma map_map {U'' V'' : C} (i'' : U'' ⟶ V'') (a' : U'' ⟶ U') (b' : V'' ⟶ V')
    (w' : i'' ≫ b' = a' ≫ i') {n : ℕ} (x : F.relativeH' i n) :
    map F i' i'' a' b' w' n (map F i i' a b w n x) =
      map F i i'' (a' ≫ a) (b' ≫ b) (by rw [reassoc_of% w', w, Category.assoc]) n x := by
  simp [map_apply, relativeFreeYonedaSheafMap_comp]

/-- Under `zeroEquiv`, the induced map in degree zero is the restriction of sections along `b`. -/
lemma coe_zeroEquiv_map (x : F.relativeH' i 0) :
    (zeroEquiv F i' (map F i i' a b w 0 x) : F.obj.obj (op V')) =
      F.obj.map b.op (zeroEquiv F i x) := by
  rw [zeroEquiv, AddEquiv.trans_apply, map_apply, TauCeti.ext_addEquiv₀_mk₀_comp,
    coe_relativeFreeYonedaSheafHomEquiv_map_comp]
  rfl

/-- When the square induces an isomorphism of relative free sheaves (see
`TauCeti.CategoryTheory.isIso_relativeFreeYonedaSheafMap_iff`), the induced map on relative
cohomology is an equivalence. -/
noncomputable def mapAddEquiv [IsIso (relativeFreeYonedaSheafMap J i' i a b w)] (n : ℕ) :
    F.relativeH' i n ≃+ F.relativeH' i' n :=
  TauCeti.extAddEquivOfIso (asIso (relativeFreeYonedaSheafMap J i' i a b w)).symm (Iso.refl F) n

@[simp]
lemma mapAddEquiv_apply [IsIso (relativeFreeYonedaSheafMap J i' i a b w)] {n : ℕ}
    (x : F.relativeH' i n) : mapAddEquiv F i i' a b w n x = map F i i' a b w n x := by
  simp [mapAddEquiv, map_apply]

end map

section vanishing

variable [Mono i]

/-- If restriction of sections along `i` is surjective and `H¹(V, F)` vanishes, then so does
`H¹(V, U; F)`. -/
theorem subsingleton_one (hF : Function.Surjective (F.obj.map i.op))
    (hV : Subsingleton (F.H' 1 V)) : Subsingleton (F.relativeH' i 1) := by
  refine subsingleton_of_forall_eq 0 fun x ↦ ?_
  obtain ⟨y, rfl⟩ := (exact_δ_toH' F i (add_zero 1) x).1 (Subsingleton.elim _ _)
  obtain ⟨z, rfl⟩ := cohomologyPresheaf_zero_map_surjective F i hF y
  exact (exact_cohomologyPresheaf_map_δ F i (add_zero 1)).apply_apply_eq_zero z

/-- If `Hⁿ⁺¹(U, F)` and `Hⁿ⁺²(V, F)` vanish, then so does `Hⁿ⁺²(V, U; F)`. -/
theorem subsingleton_add_two {n : ℕ} (hU : Subsingleton (F.H' (n + 1) U))
    (hV : Subsingleton (F.H' (n + 2) V)) : Subsingleton (F.relativeH' i (n + 2)) := by
  refine subsingleton_of_forall_eq 0 fun x ↦ ?_
  obtain ⟨y, rfl⟩ :=
    (exact_δ_toH' F i (show 1 + (n + 1) = n + 2 by omega) x).1 (Subsingleton.elim _ _)
  rw [Subsingleton.elim y 0, map_zero]

end vanishing

section triple

variable {U' : C} (i : U ⟶ U') (j : U' ⟶ V) [Mono j]

/-- The connecting map `Hⁿ(U', U; F) ⟶ Hⁿ⁺¹(V, U'; F)` of the long exact sequence of a triple
`U ⟶ U' ⟶ V` whose second morphism is a monomorphism. -/
noncomputable def tripleδ {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁) :
    F.relativeH' i n₀ →+ F.relativeH' j n₁ :=
  (relativeFreeYonedaTripleSequence_shortExact J i j).extClass.precomp F h

lemma tripleδ_apply {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁) (x : F.relativeH' i n₀) :
    tripleδ F i j h x = (relativeFreeYonedaTripleSequence_shortExact J i j).extClass.comp x h :=
  (rfl)

/-- The long exact sequence of a triple `U ⟶ U' ⟶ V` is exact at `Hⁿ(V, U; F)`: a class
restricts to zero on the pair `(U', U)` exactly when it comes from `Hⁿ(V, U'; F)`. -/
theorem exact_map_map (n : ℕ) :
    Function.Exact (map F j (i ≫ j) i (𝟙 V) (by simp) n) (map F (i ≫ j) i (𝟙 U) j (by simp) n) :=
  TauCeti.exact_precomp (relativeFreeYonedaTripleSequence_shortExact J i j) F n

/-- The long exact sequence of a triple `U ⟶ U' ⟶ V` is exact at `Hⁿ(U', U; F)`: the kernel of
the connecting map consists of the restrictions of classes on the pair `(V, U)`. -/
theorem exact_map_tripleδ {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁) :
    Function.Exact (map F (i ≫ j) i (𝟙 U) j (by simp) n₀) (tripleδ F i j h) :=
  TauCeti.exact_precomp₁ (relativeFreeYonedaTripleSequence_shortExact J i j) F n₀ n₁ h

/-- The long exact sequence of a triple `U ⟶ U' ⟶ V` is exact at `Hⁿ⁺¹(V, U'; F)`. -/
theorem exact_tripleδ_map {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁) :
    Function.Exact (tripleδ F i j h) (map F j (i ≫ j) i (𝟙 V) (by simp) n₁) :=
  TauCeti.exact_precomp₃ (relativeFreeYonedaTripleSequence_shortExact J i j) F n₀ n₁ h

end triple

end relativeH'

end Sheaf

end CategoryTheory
