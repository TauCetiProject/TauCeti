module

public import Mathlib.Algebra.Homology.DerivedCategory.Ext.ExactSequences
public import TauCeti.CategoryTheory.Sites.SheafCohomology.FreeYoneda

/-!
# Relative sheaf cohomology of a morphism of a site

Let `i : U ⟶ V` be a morphism in a site `(C, J)`, and write `ℤ_U`, `ℤ_V` for the free abelian
sheaves generated by `U` and `V` (`TauCeti.CategoryTheory.freeYonedaSheafFunctor`). The *relative
free sheaf* `ℤ_{V,U}` is the cokernel of the induced map `ℤ_U ⟶ ℤ_V`. Morphisms out of it are the
sections over `V` whose restriction along `i` vanishes, and the relative cohomology of an abelian
sheaf `F` is defined as `Hⁿ(V, U; F) = Extⁿ(ℤ_{V,U}, F)`.

When `i` is a monomorphism, `0 ⟶ ℤ_U ⟶ ℤ_V ⟶ ℤ_{V,U} ⟶ 0` is short exact, and the contravariant
long exact `Ext` sequence becomes the long exact sequence of the pair

`⋯ ⟶ Hⁿ(V, U; F) ⟶ Hⁿ(V, F) ⟶ Hⁿ(U, F) ⟶ Hⁿ⁺¹(V, U; F) ⟶ ⋯`.

Here `Hⁿ(V, F)` is Mathlib's `CategoryTheory.Sheaf.H'`, which is by definition `Ext` out of the
free abelian sheaf on `V` (`TauCeti.CategoryTheory.sheafH'_eq`), and the middle map is the
restriction map of the cohomology presheaf (`TauCeti.CategoryTheory.cohomologyPresheaf_map_apply`).

For the site of open subsets of a topological space, an open `W` and a closed subset `S`, the
morphism `W ∖ S ⟶ W` gives the cohomology of `F` on `W` with supports in `S`; this is developed in
`TauCeti.Topology.Sheaves.SupportedCohomology`.

## Main declarations

* `TauCeti.CategoryTheory.relativeFreeYonedaSheaf J i`: the relative free sheaf `ℤ_{V,U}`;
* `TauCeti.CategoryTheory.relativeFreeYonedaSheafHomEquiv`: morphisms `ℤ_{V,U} ⟶ F` are the
  sections of `F` over `V` restricting to zero along `i`;
* `TauCeti.CategoryTheory.relativeFreeYonedaSequence_shortExact`: the sequence
  `0 ⟶ ℤ_U ⟶ ℤ_V ⟶ ℤ_{V,U} ⟶ 0` is short exact for a monomorphism `i`;
* `CategoryTheory.Sheaf.relativeH' F i n`: the relative cohomology `Hⁿ(V, U; F)`;
* `CategoryTheory.Sheaf.relativeH'.toH'` and `CategoryTheory.Sheaf.relativeH'.δ`: the maps of
  the long exact sequence of the pair, whose exactness is
  `relativeH'.exact_toH'_precomp`, `relativeH'.exact_precomp_δ` and `relativeH'.exact_δ_toH'`;
* `CategoryTheory.Sheaf.relativeH'.zeroEquiv`: `H⁰(V, U; F)` is the group of sections over `V`
  restricting to zero along `i`, naturally in `F` (`relativeH'.coe_zeroEquiv_naturality_right`);
* `CategoryTheory.Sheaf.relativeH'.subsingleton_one` and `relativeH'.subsingleton_add_two`:
  vanishing of relative cohomology from vanishing of absolute cohomology.

## References

* A. Grothendieck, *Local cohomology*, Lecture Notes in Mathematics 41, §1.
* M. Kashiwara and P. Schapira, *Sheaves on Manifolds*, §2.6.
-/

public section

open CategoryTheory Limits Opposite Abelian

universe w v u

namespace TauCeti

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

noncomputable section

variable [HasSheafify J AddCommGrpCat.{v}]

/-- The free abelian sheaf on `V` relative to `U`: the cokernel of the map `ℤ_U ⟶ ℤ_V` of free
abelian sheaves induced by `i : U ⟶ V`. -/
abbrev relativeFreeYonedaSheaf {U V : C} (i : U ⟶ V) : Sheaf J AddCommGrpCat.{v} :=
  cokernel ((freeYonedaSheafFunctor J).map i)

/-- Morphisms from the relative free sheaf of `i : U ⟶ V` to an abelian sheaf `F` are additively
equivalent to the sections of `F` over `V` whose restriction along `i` vanishes. -/
def relativeFreeYonedaSheafHomEquiv {U V : C} (i : U ⟶ V) (F : Sheaf J AddCommGrpCat.{v}) :
    (relativeFreeYonedaSheaf J i ⟶ F) ≃+ (F.obj.map i.op).hom.ker where
  toFun g := ⟨freeYonedaSheafSectionsEquiv J V F (cokernel.π _ ≫ g), by
    -- `AddCommGrpCat.Hom.hom` unfolds to the `ConcreteCategory.hom` coercion used by the
    -- naturality lemma
    rw [AddMonoidHom.mem_ker, AddCommGrpCat.Hom.hom, ← freeYonedaSheafSectionsEquiv_naturality_left,
      cokernel.condition_assoc, zero_comp, map_zero]⟩
  invFun s := cokernel.desc _ ((freeYonedaSheafSectionsEquiv J V F).symm s) <| by
    apply (freeYonedaSheafSectionsEquiv J U F).injective
    rw [freeYonedaSheafSectionsEquiv_naturality_left, AddEquiv.apply_symm_apply, map_zero]
    exact s.2
  left_inv g := by
    refine (cancel_epi (cokernel.π _)).1 ?_
    exact (cokernel.π_desc _ _ _).trans (AddEquiv.symm_apply_apply _ _)
  right_inv s := by
    apply Subtype.ext
    simp
  map_add' g h := by
    apply Subtype.ext
    simp

@[simp]
lemma coe_relativeFreeYonedaSheafHomEquiv_apply {U V : C} (i : U ⟶ V)
    (F : Sheaf J AddCommGrpCat.{v}) (g : relativeFreeYonedaSheaf J i ⟶ F) :
    (relativeFreeYonedaSheafHomEquiv J i F g : F.obj.obj (op V)) =
      freeYonedaSheafSectionsEquiv J V F (cokernel.π _ ≫ g) :=
  (rfl)

@[simp]
lemma cokernel_π_comp_relativeFreeYonedaSheafHomEquiv_symm_apply {U V : C} (i : U ⟶ V)
    (F : Sheaf J AddCommGrpCat.{v}) (s : (F.obj.map i.op).hom.ker) :
    cokernel.π _ ≫ (relativeFreeYonedaSheafHomEquiv J i F).symm s =
      (freeYonedaSheafSectionsEquiv J V F).symm s :=
  cokernel.π_desc _ _ _

/-- The equivalence `relativeFreeYonedaSheafHomEquiv` is natural in the coefficient sheaf. -/
lemma relativeFreeYonedaSheafHomEquiv_naturality_right {U V : C} (i : U ⟶ V)
    {F G : Sheaf J AddCommGrpCat.{v}} (g : relativeFreeYonedaSheaf J i ⟶ F) (f : F ⟶ G) :
    (relativeFreeYonedaSheafHomEquiv J i G (g ≫ f) : G.obj.obj (op V)) =
      f.hom.app (op V) (relativeFreeYonedaSheafHomEquiv J i F g) := by
  simp

/-- The sequence `ℤ_U ⟶ ℤ_V ⟶ ℤ_{V,U}` of free abelian sheaves attached to `i : U ⟶ V`. -/
abbrev relativeFreeYonedaSequence {U V : C} (i : U ⟶ V) :
    ShortComplex (Sheaf J AddCommGrpCat.{v}) :=
  ShortComplex.cokernelSequence ((freeYonedaSheafFunctor J).map i)

/-- For a monomorphism `i : U ⟶ V`, the sequence `0 ⟶ ℤ_U ⟶ ℤ_V ⟶ ℤ_{V,U} ⟶ 0` is short
exact. -/
lemma relativeFreeYonedaSequence_shortExact {U V : C} (i : U ⟶ V) [Mono i] :
    (relativeFreeYonedaSequence J i).ShortExact where
  exact := ShortComplex.cokernelSequence_exact _
  mono_f := inferInstanceAs (Mono ((freeYonedaSheafFunctor J).map i))

/-- If `i` is an isomorphism, the relative free sheaf of `i` is zero. -/
lemma isZero_relativeFreeYonedaSheaf {U V : C} (i : U ⟶ V) [IsIso i] :
    IsZero (relativeFreeYonedaSheaf J i) :=
  isZero_cokernel_of_epi _

end

end CategoryTheory

end TauCeti

namespace CategoryTheory

namespace Sheaf

open TauCeti.CategoryTheory

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  [HasSheafify J AddCommGrpCat.{v}] [HasExt.{w} (Sheaf J AddCommGrpCat.{v})]

/-- The relative cohomology `Hⁿ(V, U; F)` of an abelian sheaf `F` for a morphism `i : U ⟶ V` of
the site: the `n`-th `Ext` group from the relative free sheaf `ℤ_{V,U}` to `F`. -/
abbrev relativeH' (F : Sheaf J AddCommGrpCat.{v}) {U V : C} (i : U ⟶ V) (n : ℕ) : Type w :=
  Ext (relativeFreeYonedaSheaf J i) F n

namespace relativeH'

variable (F : Sheaf J AddCommGrpCat.{v}) {U V : C} (i : U ⟶ V)

/-- The map `Hⁿ(V, U; F) ⟶ Hⁿ(V, F)` of the long exact sequence of the pair, induced by
`ℤ_V ⟶ ℤ_{V,U}`. -/
noncomputable def toH' (n : ℕ) :
    F.relativeH' i n →+ Ext ((freeYonedaSheafFunctor J).obj V) F n :=
  (Ext.mk₀ (cokernel.π ((freeYonedaSheafFunctor J).map i))).precomp F (zero_add n)

lemma toH'_apply {n : ℕ} (x : F.relativeH' i n) :
    toH' F i n x = (Ext.mk₀ (cokernel.π ((freeYonedaSheafFunctor J).map i))).comp x (zero_add n) :=
  (rfl)

/-- The connecting map `Hⁿ(U, F) ⟶ Hⁿ⁺¹(V, U; F)` of the long exact sequence of the pair. -/
noncomputable def δ [Mono i] {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁) :
    Ext ((freeYonedaSheafFunctor J).obj U) F n₀ →+ F.relativeH' i n₁ :=
  (relativeFreeYonedaSequence_shortExact J i).extClass.precomp F h

lemma δ_apply [Mono i] {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁)
    (x : Ext ((freeYonedaSheafFunctor J).obj U) F n₀) :
    δ F i h x = (relativeFreeYonedaSequence_shortExact J i).extClass.comp x h :=
  (rfl)

section exact

variable [Mono i]

/-- The long exact sequence of the pair is exact at `Hⁿ(V, F)`: a class on `V` comes from
relative cohomology exactly when its restriction to `U` vanishes. -/
theorem exact_toH'_precomp (n : ℕ) :
    Function.Exact (toH' F i n)
      ((Ext.mk₀ ((freeYonedaSheafFunctor J).map i)).precomp F (zero_add n)) := by
  rw [toH']
  exact TauCeti.exact_precomp (relativeFreeYonedaSequence_shortExact J i) F n

/-- The long exact sequence of the pair is exact at `Hⁿ(U, F)`: the kernel of the connecting map
consists of the restrictions of classes on `V`. -/
theorem exact_precomp_δ {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁) :
    Function.Exact ((Ext.mk₀ ((freeYonedaSheafFunctor J).map i)).precomp F (zero_add n₀))
      (δ F i h) := by
  rw [δ]
  -- the maps of Mathlib's `AddCommGrpCat`-valued sequence are `AddCommGrpCat.ofHom` of these
  exact (ShortComplex.ab_exact_iff_function_exact _).1
    (Ext.contravariant_sequence_exact₁' (relativeFreeYonedaSequence_shortExact J i) F n₀ n₁ h)

/-- The long exact sequence of the pair is exact at `Hⁿ⁺¹(V, U; F)`. -/
theorem exact_δ_toH' {n₀ n₁ : ℕ} (h : 1 + n₀ = n₁) :
    Function.Exact (δ F i h) (toH' F i n₁) := by
  rw [δ, toH']
  exact TauCeti.exact_precomp₃ (relativeFreeYonedaSequence_shortExact J i) F n₀ n₁ h

end exact

/-- Degree-zero relative cohomology is the group of sections over `V` whose restriction along `i`
vanishes. -/
noncomputable def zeroEquiv : F.relativeH' i 0 ≃+ (F.obj.map i.op).hom.ker :=
  Ext.addEquiv₀.trans (relativeFreeYonedaSheafHomEquiv J i F)

@[simp]
lemma coe_zeroEquiv_apply (x : F.relativeH' i 0) :
    (zeroEquiv F i x : F.obj.obj (op V)) =
      freeYonedaSheafSectionsEquiv J V F (cokernel.π _ ≫ Ext.addEquiv₀ x) :=
  (rfl)

/-- The equivalence `zeroEquiv` is natural in the coefficient sheaf. -/
lemma coe_zeroEquiv_naturality_right {F G : Sheaf J AddCommGrpCat.{v}} (f : F ⟶ G)
    (x : F.relativeH' i 0) :
    (zeroEquiv G i (x.comp (Ext.mk₀ f) (add_zero 0)) : G.obj.obj (op V)) =
      f.hom.app (op V) (zeroEquiv F i x) := by
  rw [coe_zeroEquiv_apply, coe_zeroEquiv_apply, TauCeti.ext_addEquiv₀_comp_mk₀, ← Category.assoc,
    freeYonedaSheafSectionsEquiv_naturality_right]

/-- Under `zeroEquiv` and the identification of degree-zero cohomology with sections, the map
`toH'` is the inclusion of the sections restricting to zero. -/
lemma freeYonedaSheafSectionsEquiv_addEquiv₀_toH' (x : F.relativeH' i 0) :
    freeYonedaSheafSectionsEquiv J V F (Ext.addEquiv₀ (toH' F i 0 x)) = zeroEquiv F i x := by
  rw [toH'_apply, TauCeti.ext_addEquiv₀_mk₀_comp, coe_zeroEquiv_apply]

/-- Relative cohomology vanishes for an isomorphism. -/
instance subsingleton_of_isIso [IsIso i] (n : ℕ) : Subsingleton (F.relativeH' i n) :=
  TauCeti.subsingleton_ext_of_isZero_left (isZero_relativeFreeYonedaSheaf J i) F n

section vanishing

variable [Mono i]

/-- If restriction of sections along `i` is surjective and `H¹(V, F)` vanishes, then so does
`H¹(V, U; F)`. -/
theorem subsingleton_one (hF : Function.Surjective (F.obj.map i.op))
    (hV : Subsingleton (F.H' 1 V)) : Subsingleton (F.relativeH' i 1) := by
  have hV' : Subsingleton (Ext ((freeYonedaSheafFunctor J).obj V) F 1) := by
    simpa only [sheafH'_eq] using hV
  refine subsingleton_of_forall_eq 0 fun x ↦ ?_
  obtain ⟨y, rfl⟩ := (exact_δ_toH' F i (add_zero 1) x).1 (Subsingleton.elim _ _)
  obtain ⟨z, hz⟩ := cohomologyPresheaf_zero_map_surjective F i hF y
  rw [← hz, cohomologyPresheaf_map_apply]
  exact (exact_precomp_δ F i (add_zero 1)).apply_apply_eq_zero z

/-- If `Hⁿ⁺¹(U, F)` and `Hⁿ⁺²(V, F)` vanish, then so does `Hⁿ⁺²(V, U; F)`. -/
theorem subsingleton_add_two {n : ℕ} (hU : Subsingleton (F.H' (n + 1) U))
    (hV : Subsingleton (F.H' (n + 2) V)) : Subsingleton (F.relativeH' i (n + 2)) := by
  have hU' : Subsingleton (Ext ((freeYonedaSheafFunctor J).obj U) F (n + 1)) := by
    simpa only [sheafH'_eq] using hU
  have hV' : Subsingleton (Ext ((freeYonedaSheafFunctor J).obj V) F (n + 2)) := by
    simpa only [sheafH'_eq] using hV
  refine subsingleton_of_forall_eq 0 fun x ↦ ?_
  obtain ⟨y, rfl⟩ :=
    (exact_δ_toH' F i (show 1 + (n + 1) = n + 2 by omega) x).1 (Subsingleton.elim _ _)
  rw [Subsingleton.elim y 0, map_zero]

end vanishing

end relativeH'

end Sheaf

end CategoryTheory
