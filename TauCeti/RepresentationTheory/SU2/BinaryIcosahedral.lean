/-!
# The binary icosahedral subgroup of SU(2)

With `φ = (1 + √5) / 2` the golden ratio, the **binary icosahedral group** consists of the 120
unit quaternions forming the vertices of the 600-cell:

* the 24 points of the binary tetrahedral group, `±1, ±i, ±j, ±k` and `(±1 ± i ± j ± k) / 2`, and
* the 96 points obtained from `(0, ±1, ±φ, ±φ⁻¹) / 2` by the even permutations of the four
  coordinates, such as `(φ⁻¹ + φ i + j) / 2`.

This file constructs the binary icosahedral subgroup `TauCeti.SU2.binaryIcosahedralSubgroup` of
the native matrix group `SU(2)` as the matrices of these quaternions under
`Quaternion.toComplexMatrix`. Its carrier is this coordinate description
(`TauCeti.SU2.mem_binaryIcosahedralSubgroup_iff`): an element is binary tetrahedral, or its doubled
quaternion coordinates are, in absolute value, `(0, 1, φ, φ⁻¹)` permuted by an element of the
alternating group. Odd permutations must be excluded: the point `(φ + φ⁻¹ i + j) / 2` comes from an
odd permutation and does not lie in the subgroup
(`TauCeti.SU2.notMem_binaryIcosahedralSubgroup_of_coe_eq`), and the set built from all
permutations is not closed under multiplication
(`TauCeti.SU2.not_exists_submonoid_coe_eq_allPerms`).

The subgroup has exactly 120 elements (`TauCeti.SU2.natCard_binaryIcosahedralSubgroup`), the binary
tetrahedral subgroup has index five in it, and it is generated by the generators `i`, `j` and
`ω = (-1 + i + j + k) / 2` of the binary tetrahedral group together with the element
`τ = (φ⁻¹ + φ i + j) / 2` of order five (`TauCeti.SU2.binaryIcosahedralSubgroup_eq_closure`).

## Implementation notes

The doubled coordinates of all 120 points lie in the ring `ℤ[φ]`, which is Mathlib's
`QuadraticAlgebra ℤ 1 1` (with `ω² = 1 + ω`), mapped to `ℝ` by `TauCeti.goldenEval : ω ↦ φ` and to
`ℍ[ℝ]` coordinatewise by `Quaternion.map`. Left multiplication by the four generators `i`, `j`, `ω`
and `τ` preserves the coordinate set; this finite check of `4 × 120` products is carried out in
`ℤ[φ]` by `decide`, with the product of a generator and a point tested directly against the
coordinate description rather than searched for in a list. Since the
coordinate set is finite, it is then closed under left multiplication by the whole subgroup
generated by `i`, `j`, `ω` and `τ`, so this subgroup lies inside it. The order of the generated
subgroup is divisible by `24` (it contains the binary tetrahedral group) and by `5`, while the
coordinate set has at most `24 + 12 · 8 = 120` points, so the two coincide and have 120 elements.

## Main definitions

* `TauCeti.SU2.binaryIcosahedralTau`: the element `τ = (φ⁻¹ + φ i + j) / 2` of order five.
* `TauCeti.SU2.binaryIcosahedralSubgroup`: the binary icosahedral subgroup of `SU(2)`.

## Main results

* `TauCeti.SU2.mem_binaryIcosahedralSubgroup_iff`: the coordinate description of its elements.
* `TauCeti.SU2.natCard_binaryIcosahedralSubgroup`: it has exactly 120 elements.
* `TauCeti.SU2.relIndex_binaryTetrahedralSubgroup_binaryIcosahedralSubgroup`: the binary tetrahedral
  subgroup has index five in it.
* `TauCeti.SU2.binaryIcosahedralSubgroup_eq_closure`: it is generated by `i`, `j`, `ω` and `τ`.
* `TauCeti.SU2.notMem_binaryIcosahedralSubgroup_of_coe_eq`: the odd-permutation point
  `(φ + φ⁻¹ i + j) / 2` does not lie in it.
* `TauCeti.SU2.not_exists_submonoid_coe_eq_allPerms`: the set built from all permutations of
  `(0, ±1, ±φ, ±φ⁻¹) / 2`, rather than only the even ones, is not closed under multiplication.

## References

* J. H. Conway and D. A. Smith, *On Quaternions and Octonions*, A K Peters, 2003, Chapter 3 (the
  binary polyhedral groups).
-/

public section

namespace TauCeti.SU2

open Quaternion Real
open scoped goldenRatio QuadraticAlgebra

/-! ### The generator `τ` -/

/-- The quaternion `(a + b i + j) / 2` is a unit quaternion when `a² + b² = φ² + φ⁻²`, as for
`(a, b) = (φ⁻¹, φ)` or `(φ, φ⁻¹)`. -/
private theorem toComplexMatrix_mem_specialUnitaryGroup_of_sq_add_sq {a b : ℝ}
    (h : a ^ 2 + b ^ 2 = φ ^ 2 + φ⁻¹ ^ 2) :
    toComplexMatrix ⟨a / 2, b / 2, 1 / 2, 0⟩ ∈ Matrix.specialUnitaryGroup (Fin 2) ℂ :=
  mem_specialUnitaryGroup_toComplexMatrix ((mem_unitary_iff_normSq_eq_one _).mpr (by
    rw [inv_goldenRatio_eq_goldenRatio_sub_one] at h
    rw [normSq_def']
    linear_combination h / 4 + goldenRatio_sq / 2))

/-- The element `τ = (φ⁻¹ + φ i + j) / 2` of the binary icosahedral group, of order five, where
`φ = (1 + √5) / 2` is the golden ratio. -/
noncomputable def binaryIcosahedralTau : SU2 :=
  ⟨toComplexMatrix ⟨φ⁻¹ / 2, φ / 2, 1 / 2, 0⟩,
    toComplexMatrix_mem_specialUnitaryGroup_of_sq_add_sq (add_comm _ _)⟩

/-- The matrix of `τ` is that of the quaternion `(φ⁻¹ + φ i + j) / 2`. -/
theorem coe_binaryIcosahedralTau :
    (binaryIcosahedralTau : Matrix (Fin 2) (Fin 2) ℂ) =
      toComplexMatrix ⟨φ⁻¹ / 2, φ / 2, 1 / 2, 0⟩ :=
  (rfl)

/-! ### Doubled coordinates in `ℤ[φ]` -/

/-- The quaternion product over `ℤ[φ]` written out coordinatewise, which the kernel evaluates much
faster than the generic product of `ℍ[R]`. -/
private def qmul (x y : ℍ[QuadraticAlgebra ℤ 1 1]) : ℍ[QuadraticAlgebra ℤ 1 1] :=
  ⟨x.re * y.re - x.imI * y.imI - x.imJ * y.imJ - x.imK * y.imK,
    x.re * y.imI + x.imI * y.re + x.imJ * y.imK - x.imK * y.imJ,
    x.re * y.imJ - x.imI * y.imK + x.imJ * y.re + x.imK * y.imI,
    x.re * y.imK + x.imI * y.imJ - x.imJ * y.imI + x.imK * y.re⟩

private theorem qmul_eq (x y : ℍ[QuadraticAlgebra ℤ 1 1]) : qmul x y = x * y := by
  ext <;> simp [qmul]

/-- The base coordinates `0, 1, φ, φ⁻¹ = φ - 1` of the 96 points outside the binary tetrahedral
group, in `ℤ[φ]`. -/
private def baseCoord : Fin 4 → QuadraticAlgebra ℤ 1 1 := ![⟨0, 0⟩, ⟨1, 0⟩, ⟨0, 1⟩, ⟨-1, 1⟩]

/-- Twice the base coordinates. -/
private def baseCoord₂ : Fin 4 → QuadraticAlgebra ℤ 1 1 := ![⟨0, 0⟩, ⟨2, 0⟩, ⟨0, 2⟩, ⟨-2, 2⟩]

/-- A property holds at each of the base values `0, 1, φ, φ⁻¹` exactly when it holds at all four
of them. -/
private theorem forall_baseValue {P : ℝ → Prop} :
    (∀ k : Fin 4, P (![0, 1, φ, φ⁻¹] k)) ↔ P 0 ∧ P 1 ∧ P φ ∧ P φ⁻¹ := by
  simp [Fin.forall_fin_succ]

private theorem goldenEval_baseCoord (k : Fin 4) :
    goldenEval (baseCoord k) = ![0, 1, φ, φ⁻¹] k := by
  rw [inv_goldenRatio_eq_goldenRatio_sub_one]
  fin_cases k <;> simp [baseCoord]
  ring

private theorem baseCoord₂_eq (k : Fin 4) : baseCoord₂ k = 2 • baseCoord k := by
  fin_cases k <;> decide

private theorem goldenEval_baseCoord₂ (k : Fin 4) :
    goldenEval (baseCoord₂ k) = 2 * ![0, 1, φ, φ⁻¹] k := by
  rw [baseCoord₂_eq, map_nsmul, goldenEval_baseCoord, nsmul_eq_mul, Nat.cast_ofNat]

private theorem nonneg_baseValue (k : Fin 4) : 0 ≤ ![0, 1, φ, φ⁻¹] k :=
  forall_baseValue.mpr ⟨le_rfl, zero_le_one, goldenRatio_pos.le, inv_nonneg.mpr goldenRatio_pos.le⟩
    k

/-- The twelve even permutations of `Fin 4`, in a form the kernel evaluates quickly. -/
private def evenPerms : List (Fin 4 → Fin 4) :=
  [![0, 1, 2, 3], ![0, 2, 3, 1], ![0, 3, 1, 2], ![1, 0, 3, 2], ![1, 2, 0, 3], ![1, 3, 2, 0],
    ![2, 0, 1, 3], ![2, 1, 3, 0], ![2, 3, 0, 1], ![3, 0, 2, 1], ![3, 1, 0, 2], ![3, 2, 1, 0]]

private theorem mem_evenPerms_of_mem_alternatingGroup {σ : Equiv.Perm (Fin 4)}
    (hσ : σ ∈ alternatingGroup (Fin 4)) : ⇑σ ∈ evenPerms :=
  (by decide +kernel : ∀ σ : Equiv.Perm (Fin 4), Equiv.Perm.sign σ = 1 → ⇑σ ∈ evenPerms) σ
    (Equiv.Perm.mem_alternatingGroup.mp hσ)

private theorem exists_mem_alternatingGroup_of_mem_evenPerms {p : Fin 4 → Fin 4}
    (hp : p ∈ evenPerms) : ∃ σ ∈ alternatingGroup (Fin 4), ⇑σ = p := by
  obtain ⟨σ, hσ, rfl⟩ := (by decide +kernel : ∀ p ∈ evenPerms,
    ∃ σ : Equiv.Perm (Fin 4), Equiv.Perm.sign σ = 1 ∧ ⇑σ = p) p hp
  exact ⟨σ, Equiv.Perm.mem_alternatingGroup.mpr hσ, rfl⟩

/-- `z ∈ ℤ[φ]` is twice an integer. -/
private abbrev IsTwiceInt (z : QuadraticAlgebra ℤ 1 1) : Prop :=
  z.im = 0 ∧ z.re % 2 = 0

/-- `z ∈ ℤ[φ]` is plus or minus twice the base coordinate `k`. -/
private abbrev IsTwiceBase (z : QuadraticAlgebra ℤ 1 1) (k : Fin 4) : Prop :=
  z = baseCoord₂ k ∨ z = -baseCoord₂ k

/-- The quaternion `x / 4` is one of the 120 points: either all coordinates of `x / 2` are
integers, or the coordinates of `x / 2` are `±(0, 1, φ, φ⁻¹)` permuted evenly. -/
private abbrev IsQuadPoint (x : ℍ[QuadraticAlgebra ℤ 1 1]) : Prop :=
  (IsTwiceInt x.re ∧ IsTwiceInt x.imI ∧ IsTwiceInt x.imJ ∧ IsTwiceInt x.imK) ∨
    ∃ p ∈ evenPerms, IsTwiceBase x.re (p 0) ∧ IsTwiceBase x.imI (p 1) ∧ IsTwiceBase x.imJ (p 2) ∧
      IsTwiceBase x.imK (p 3)

/-- The doubled coordinates of a binary tetrahedral point. -/
private def intQuat (v : Fin 4 → ℤ) : ℍ[QuadraticAlgebra ℤ 1 1] :=
  ⟨(v 0 : QuadraticAlgebra ℤ 1 1), v 1, v 2, v 3⟩

/-- The parameters of the 96 points outside the binary tetrahedral group: an even permutation `p`
and the signs of the base coordinates `1, φ, φ⁻¹`. -/
private def cosetParams : Finset ((Fin 4 → Fin 4) × ℤ × ℤ × ℤ) :=
  evenPerms.toFinset ×ˢ ({1, -1} ×ˢ ({1, -1} ×ˢ {1, -1}))

/-- The doubled coordinates of the point with parameters `(p, t₁, t₂, t₃)`: its coordinate `i` is
the base coordinate `p i`, with sign `tₖ` for the base coordinate `k = p i`. -/
private def cosetQuat (q : (Fin 4 → Fin 4) × ℤ × ℤ × ℤ) : ℍ[QuadraticAlgebra ℤ 1 1] :=
  let t : Fin 4 → ℤ := ![1, q.2.1, q.2.2.1, q.2.2.2]
  ⟨t (q.1 0) • baseCoord (q.1 0), t (q.1 1) • baseCoord (q.1 1), t (q.1 2) • baseCoord (q.1 2),
    t (q.1 3) • baseCoord (q.1 3)⟩

/-- The doubled coordinates `(φ⁻¹, φ, 1, 0)` of `τ`. -/
private def tauQuat : ℍ[QuadraticAlgebra ℤ 1 1] := ⟨⟨-1, 1⟩, ⟨0, 1⟩, ⟨1, 0⟩, ⟨0, 0⟩⟩

/-- The doubled coordinates of `i`, `j`, `ω = (-1 + i + j + k) / 2` and `τ = (φ⁻¹ + φ i + j) / 2`.
-/
private def generatorQuats : List ℍ[QuadraticAlgebra ℤ 1 1] :=
  [⟨⟨0, 0⟩, ⟨2, 0⟩, ⟨0, 0⟩, ⟨0, 0⟩⟩, ⟨⟨0, 0⟩, ⟨0, 0⟩, ⟨2, 0⟩, ⟨0, 0⟩⟩,
    ⟨⟨-1, 0⟩, ⟨1, 0⟩, ⟨1, 0⟩, ⟨1, 0⟩⟩, tauQuat]

/-- **The finite check.** A generator times a binary tetrahedral point is one of the 120 points. -/
private theorem isQuadPoint_qmul_intQuat :
    ∀ v ∈ binaryTetrahedralCoords, ∀ a ∈ generatorQuats, IsQuadPoint (qmul a (intQuat v)) := by
  rw [binaryTetrahedralCoords_def]
  decide +kernel

/-- **The finite check.** A generator times one of the 96 other points is one of the 120 points. -/
private theorem isQuadPoint_qmul_cosetQuat :
    ∀ q ∈ cosetParams, ∀ a ∈ generatorQuats, IsQuadPoint (qmul a (cosetQuat q)) := by
  decide +kernel

/-! ### The coordinate set -/

/-- The 120 points: the binary tetrahedral group, and the quaternions
`(x₀ + x₁ i + x₂ j + x₃ k) / 2` whose coordinates `xᵢ` are in absolute value `(0, 1, φ, φ⁻¹)`
permuted evenly. -/
private def binaryIcosahedralSet : Set SU2 :=
  {g | g ∈ binaryTetrahedralSubgroup ∨ ∃ σ ∈ alternatingGroup (Fin 4), ∃ x : Fin 4 → ℝ,
    (∀ i, |x i| = ![0, 1, φ, φ⁻¹] (σ i)) ∧
      (g : Matrix (Fin 2) (Fin 2) ℂ) = toComplexMatrix ⟨x 0 / 2, x 1 / 2, x 2 / 2, x 3 / 2⟩}

private theorem exists_int_of_isTwiceInt {z : QuadraticAlgebra ℤ 1 1} (hz : IsTwiceInt z) :
    ∃ m : ℤ, goldenEval z / 4 = m / 2 := by
  obtain ⟨m, hm⟩ := Int.dvd_of_emod_eq_zero hz.2
  refine ⟨m, ?_⟩
  rw [goldenEval_apply, hz.1, hm]
  push_cast
  ring

private theorem abs_of_isTwiceBase {z : QuadraticAlgebra ℤ 1 1} {k : Fin 4}
    (hz : IsTwiceBase z k) : |goldenEval z / 2| = ![0, 1, φ, φ⁻¹] k := by
  rcases hz with rfl | rfl
  · rw [goldenEval_baseCoord₂, mul_div_cancel_left₀ _ two_ne_zero,
      abs_of_nonneg (nonneg_baseValue k)]
  · rw [map_neg, goldenEval_baseCoord₂, neg_div, mul_div_cancel_left₀ _ two_ne_zero, abs_neg,
      abs_of_nonneg (nonneg_baseValue k)]

/-- If `x / 4` is one of the 120 points, then so is any element of `SU(2)` with this quaternion. -/
private theorem mem_binaryIcosahedralSet_of_isQuadPoint {g : SU2} {x : ℍ[QuadraticAlgebra ℤ 1 1]}
    (hx : IsQuadPoint x)
    (hg : (g : Matrix (Fin 2) (Fin 2) ℂ) =
      toComplexMatrix ((4⁻¹ : ℝ) • Quaternion.map goldenEval x)) :
    g ∈ binaryIcosahedralSet := by
  rcases hx with ⟨h₀, h₁, h₂, h₃⟩ | ⟨p, hp, h₀, h₁, h₂, h₃⟩
  · obtain ⟨m₀, hm₀⟩ := exists_int_of_isTwiceInt h₀
    obtain ⟨m₁, hm₁⟩ := exists_int_of_isTwiceInt h₁
    obtain ⟨m₂, hm₂⟩ := exists_int_of_isTwiceInt h₂
    obtain ⟨m₃, hm₃⟩ := exists_int_of_isTwiceInt h₃
    refine .inl (mem_binaryTetrahedralSubgroup_iff_exists_int.mpr ⟨![m₀, m₁, m₂, m₃], ?_⟩)
    rw [hg]
    congr 1
    ext <;> simp [← hm₀, ← hm₁, ← hm₂, ← hm₃, div_eq_inv_mul]
  · obtain ⟨σ, hσ, rfl⟩ := exists_mem_alternatingGroup_of_mem_evenPerms hp
    refine .inr ⟨σ, hσ, ![goldenEval x.re / 2, goldenEval x.imI / 2, goldenEval x.imJ / 2,
      goldenEval x.imK / 2], fun i => ?_, ?_⟩
    · fin_cases i
      exacts [abs_of_isTwiceBase h₀, abs_of_isTwiceBase h₁, abs_of_isTwiceBase h₂,
        abs_of_isTwiceBase h₃]
    · rw [hg]
      congr 1
      ext <;> simp <;> ring

/-- A real number is its sign times its absolute value. -/
private theorem eq_sign_mul_abs (y : ℝ) : y = ((if 0 ≤ y then 1 else -1 : ℤ) : ℝ) * |y| := by
  split_ifs with h
  · simp [abs_of_nonneg h]
  · simp [abs_of_neg (not_le.mp h)]

/-- Every one of the 120 points has doubled coordinates `intQuat v` for a binary tetrahedral `v`, or
`cosetQuat q` for parameters `q`. -/
private theorem exists_of_mem_binaryIcosahedralSet {g : SU2} (hg : g ∈ binaryIcosahedralSet) :
    ∃ v ∈ intQuat '' ↑binaryTetrahedralCoords ∪ cosetQuat '' ↑cosetParams,
      (g : Matrix (Fin 2) (Fin 2) ℂ) =
        toComplexMatrix ((2⁻¹ : ℝ) • Quaternion.map goldenEval v) := by
  rcases hg with hg | ⟨σ, hσ, x, hx, hg⟩
  · obtain ⟨v, hv, hg⟩ := mem_binaryTetrahedralSubgroup_iff.mp hg
    refine ⟨intQuat v, .inl ⟨v, hv, rfl⟩, ?_⟩
    rw [hg]
    congr 1
    ext <;> simp [intQuat, div_eq_inv_mul]
  -- The sign of the coordinate carrying the base coordinate `k`.
  set t : Fin 4 → ℤ := fun k => if 0 ≤ x (σ.symm k) then 1 else -1 with ht
  have hmem : (⇑σ, t 1, t 2, t 3) ∈ cosetParams := by
    simp only [cosetParams, Finset.mem_product, List.mem_toFinset, Finset.mem_insert,
      Finset.mem_singleton, ht]
    refine ⟨mem_evenPerms_of_mem_alternatingGroup hσ, ?_, ?_, ?_⟩ <;> split_ifs <;> simp
  -- Each coordinate is its sign times the base coordinate it carries.
  have key (k : Fin 4) :
      x (σ.symm k) = ((![1, t 1, t 2, t 3] k : ℤ) : ℝ) * ![0, 1, φ, φ⁻¹] k := by
    have habs : |x (σ.symm k)| = ![0, 1, φ, φ⁻¹] k := by simpa using hx (σ.symm k)
    rw [eq_sign_mul_abs (x (σ.symm k)), habs]
    fin_cases k <;> simp [ht]
  have hcoord (i : Fin 4) : goldenEval (![1, t 1, t 2, t 3] (σ i) • baseCoord (σ i)) / 2 =
      x i / 2 := by
    rw [map_zsmul, goldenEval_baseCoord, zsmul_eq_mul, ← key, Equiv.symm_apply_apply]
  refine ⟨cosetQuat (⇑σ, t 1, t 2, t 3), .inr ⟨_, hmem, rfl⟩, ?_⟩
  rw [hg]
  congr 1
  ext <;> simp only [cosetQuat, Quaternion.re_map, Quaternion.imI_map, Quaternion.imJ_map,
    Quaternion.imK_map, AlgHom.coe_toRingHom, QuaternionAlgebra.re_smul, QuaternionAlgebra.imI_smul,
    QuaternionAlgebra.imJ_smul, QuaternionAlgebra.imK_smul, smul_eq_mul, ← hcoord] <;> ring

private theorem ncard_params_le :
    (intQuat '' ↑binaryTetrahedralCoords ∪ cosetQuat '' ↑cosetParams).ncard ≤ 120 := by
  have hT : (intQuat '' ↑binaryTetrahedralCoords).ncard ≤ 24 :=
    (Set.ncard_image_le (Finset.finite_toSet _)).trans_eq
      ((Set.ncard_coe_finset _).trans card_binaryTetrahedralCoords)
  have hC : (cosetQuat '' ↑cosetParams).ncard ≤ 96 :=
    (Set.ncard_image_le (Finset.finite_toSet _)).trans_eq
      ((Set.ncard_coe_finset _).trans (by decide +kernel))
  exact (Set.ncard_union_le _ _).trans (by omega)

/-- The matrices of the 120 points. -/
private theorem coe_image_binaryIcosahedralSet_subset :
    Subtype.val '' binaryIcosahedralSet ⊆
      (fun v => toComplexMatrix ((2⁻¹ : ℝ) • Quaternion.map goldenEval v)) ''
        (intQuat '' ↑binaryTetrahedralCoords ∪ cosetQuat '' ↑cosetParams) := by
  rintro _ ⟨g, hg, rfl⟩
  obtain ⟨v, hv, hgv⟩ := exists_of_mem_binaryIcosahedralSet hg
  exact ⟨v, hv, hgv.symm⟩

private theorem finite_params :
    (intQuat '' ↑binaryTetrahedralCoords ∪ cosetQuat '' ↑cosetParams).Finite :=
  ((Finset.finite_toSet _).image _).union ((Finset.finite_toSet _).image _)

private theorem finite_binaryIcosahedralSet : binaryIcosahedralSet.Finite :=
  Set.Finite.of_finite_image ((finite_params.image _).subset coe_image_binaryIcosahedralSet_subset)
    Subtype.val_injective.injOn

private theorem ncard_binaryIcosahedralSet_le : binaryIcosahedralSet.ncard ≤ 120 := by
  rw [← Set.ncard_image_of_injective _ Subtype.val_injective]
  exact (Set.ncard_le_ncard coe_image_binaryIcosahedralSet_subset (finite_params.image _)).trans
    ((Set.ncard_image_le finite_params).trans ncard_params_le)

/-! ### Closure under the generators -/

private theorem coe_binaryIcosahedralTau_eq : (binaryIcosahedralTau : Matrix (Fin 2) (Fin 2) ℂ) =
    toComplexMatrix ((2⁻¹ : ℝ) • Quaternion.map goldenEval tauQuat) := by
  rw [coe_binaryIcosahedralTau, inv_goldenRatio_eq_goldenRatio_sub_one]
  congr 1
  ext <;> simp [tauQuat] <;> ring

/-- The four generators `i`, `j`, `ω` and `τ`. -/
private noncomputable def generators : Set SU2 :=
  {binaryDihedralRotation 2, weylElement⁻¹, binaryTetrahedralOmega, binaryIcosahedralTau}

private theorem exists_generatorQuat {a : SU2} (ha : a ∈ generators) :
    ∃ x ∈ generatorQuats,
      (a : Matrix (Fin 2) (Fin 2) ℂ) =
        toComplexMatrix ((2⁻¹ : ℝ) • Quaternion.map goldenEval x) := by
  rcases ha with rfl | rfl | rfl | rfl
  · refine ⟨_, List.mem_cons_self, ?_⟩
    rw [coe_binaryDihedralRotation_eq_toComplexMatrix]
    congr 1
    ext <;> norm_num [map_ofNat]
  · refine ⟨_, List.mem_cons_of_mem _ List.mem_cons_self, ?_⟩
    rw [coe_weylElement_inv_eq_toComplexMatrix]
    congr 1
    ext <;> norm_num [map_ofNat]
  · refine ⟨_, List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self), ?_⟩
    rw [coe_binaryTetrahedralOmega]
    congr 1
    ext <;> norm_num [map_ofNat]
  · refine ⟨_, List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
      List.mem_cons_self)), ?_⟩
    exact coe_binaryIcosahedralTau_eq

/-- **Closure under the generators.** -/
private theorem mul_mem_binaryIcosahedralSet {a g : SU2} (ha : a ∈ generators)
    (hg : g ∈ binaryIcosahedralSet) : a * g ∈ binaryIcosahedralSet := by
  obtain ⟨x, hx, ha⟩ := exists_generatorQuat ha
  obtain ⟨v, hv, hgv⟩ := exists_of_mem_binaryIcosahedralSet hg
  refine mem_binaryIcosahedralSet_of_isQuadPoint (x := qmul x v) ?_ ?_
  · rcases hv with ⟨w, hw, rfl⟩ | ⟨q, hq, rfl⟩
    exacts [isQuadPoint_qmul_intQuat w hw x hx, isQuadPoint_qmul_cosetQuat q hq x hx]
  · rw [Submonoid.coe_mul, ha, hgv, ← map_mul, smul_mul_smul_comm, ← map_mul, qmul_eq]
    norm_num

/-- Left multiplication by an element of the generated subgroup preserves the coordinate set; for
inverses this uses that left multiplication is a bijection of the finite coordinate set. -/
private theorem mul_mem_binaryIcosahedralSet_of_mem_closure {h : SU2}
    (hh : h ∈ Subgroup.closure generators) :
    ∀ g ∈ binaryIcosahedralSet, h * g ∈ binaryIcosahedralSet := by
  induction hh using Subgroup.closure_induction with
  | mem a ha => exact fun g hg => mul_mem_binaryIcosahedralSet ha hg
  | one => simp
  | mul a b _ _ ha hb => exact fun g hg => mul_assoc a b g ▸ ha _ (hb g hg)
  | inv a _ ha =>
    intro g hg
    have hbij := (finite_binaryIcosahedralSet.injOn_iff_bijOn_of_mapsTo
      (f := (a * ·)) ha).mp (mul_right_injective a).injOn
    obtain ⟨g', hg', rfl⟩ := hbij.surjOn hg
    simpa using hg'

private theorem closure_le_binaryIcosahedralSet :
    (Subgroup.closure generators : Set SU2) ⊆ binaryIcosahedralSet := fun h hh => by
  simpa using mul_mem_binaryIcosahedralSet_of_mem_closure hh 1
    (.inl (one_mem binaryTetrahedralSubgroup))

/-! ### The order of `τ` -/

/-- `τ⁵ = 1`. -/
theorem binaryIcosahedralTau_pow_five : binaryIcosahedralTau ^ 5 = 1 := by
  -- On doubled coordinates, `(2τ)⁵ = 32`.
  have h : tauQuat ^ 5 = ⟨⟨32, 0⟩, ⟨0, 0⟩, ⟨0, 0⟩, ⟨0, 0⟩⟩ := by
    ext <;> decide +kernel
  apply Subtype.ext
  rw [SubmonoidClass.coe_pow, coe_binaryIcosahedralTau_eq, ← map_pow, smul_pow, ← map_pow, h,
    OneMemClass.coe_one, ← map_one toComplexMatrix]
  congr 1
  ext <;> norm_num [map_ofNat]

/-- `τ = (φ⁻¹ + φ i + j) / 2` has order five. -/
@[simp]
theorem orderOf_binaryIcosahedralTau : orderOf binaryIcosahedralTau = 5 := by
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  refine orderOf_eq_prime binaryIcosahedralTau_pow_five fun h => ?_
  have h' : toComplexMatrix ⟨φ⁻¹ / 2, φ / 2, 1 / 2, 0⟩ = toComplexMatrix (1 : ℍ[ℝ]) := by
    rw [map_one, ← coe_binaryIcosahedralTau, h, OneMemClass.coe_one]
  have := congrArg QuaternionAlgebra.imJ (toComplexMatrix_injective h')
  norm_num at this

/-! ### The binary icosahedral subgroup -/

/-- The subgroup generated by `i`, `j`, `ω` and `τ` has 120 elements: its order is divisible by the
order `24` of the binary tetrahedral group and by the order `5` of `τ`, and it lies in the
coordinate set, which has at most 120 points. -/
private theorem natCard_closure_generators : Nat.card (Subgroup.closure generators) = 120 := by
  set H := Subgroup.closure generators
  have : Finite H :=
    (finite_binaryIcosahedralSet.subset closure_le_binaryIcosahedralSet).to_subtype
  have hT : binaryTetrahedralSubgroup ≤ H := by
    rw [binaryTetrahedralSubgroup_eq_closure]
    refine Subgroup.closure_mono fun g hg => ?_
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    simp only [generators, Set.mem_insert_iff, Set.mem_singleton_iff]
    tauto
  have h24 : 24 ∣ Nat.card H := by
    simpa using Subgroup.card_dvd_of_le hT
  have h5 : 5 ∣ Nat.card H := by
    simpa using H.orderOf_dvd_natCard
      (Subgroup.subset_closure (by simp [generators]) : binaryIcosahedralTau ∈ H)
  have hle : Nat.card H ≤ 120 := by
    rw [← SetLike.coe_sort_coe, Nat.card_coe_set_eq]
    exact (Set.ncard_le_ncard closure_le_binaryIcosahedralSet finite_binaryIcosahedralSet).trans
      ncard_binaryIcosahedralSet_le
  exact le_antisymm hle
    (Nat.le_of_dvd Nat.card_pos (Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) h24 h5))

private theorem coe_closure_generators :
    (Subgroup.closure generators : Set SU2) = binaryIcosahedralSet := by
  refine Set.eq_of_subset_of_ncard_le closure_le_binaryIcosahedralSet ?_
    finite_binaryIcosahedralSet
  have h := natCard_closure_generators
  rw [← SetLike.coe_sort_coe, Nat.card_coe_set_eq] at h
  rw [h]
  exact ncard_binaryIcosahedralSet_le

/-- **The binary icosahedral subgroup of `SU(2)`**: the 120 matrices of the unit quaternions in the
binary tetrahedral subgroup together with the 96 quaternions obtained from
`(0, ±1, ±φ, ±φ⁻¹) / 2` by even permutations of the coordinates, the vertices of the 600-cell. -/
noncomputable def binaryIcosahedralSubgroup : Subgroup SU2 :=
  (Subgroup.closure generators).copy binaryIcosahedralSet coe_closure_generators.symm

/-- Membership in the binary icosahedral subgroup: an element is binary tetrahedral, or its
quaternion coordinates are `x / 2` for a vector `x` whose absolute values are `(0, 1, φ, φ⁻¹)`
permuted by an even permutation `σ`, that is `|xᵢ| = (0, 1, φ, φ⁻¹)_{σ i}`. -/
theorem mem_binaryIcosahedralSubgroup_iff {g : SU2} :
    g ∈ binaryIcosahedralSubgroup ↔ g ∈ binaryTetrahedralSubgroup ∨
      ∃ σ ∈ alternatingGroup (Fin 4), ∃ x : Fin 4 → ℝ, (∀ i, |x i| = ![0, 1, φ, φ⁻¹] (σ i)) ∧
        (g : Matrix (Fin 2) (Fin 2) ℂ) = toComplexMatrix ⟨x 0 / 2, x 1 / 2, x 2 / 2, x 3 / 2⟩ :=
  Iff.rfl

/-- **The binary icosahedral subgroup is generated by `i`, `j`, `ω = (-1 + i + j + k) / 2` and
`τ = (φ⁻¹ + φ i + j) / 2`**, that is, by the generators of the binary tetrahedral group together
with an element of order five. -/
theorem binaryIcosahedralSubgroup_eq_closure :
    binaryIcosahedralSubgroup = Subgroup.closure
      {binaryDihedralRotation 2, weylElement⁻¹, binaryTetrahedralOmega, binaryIcosahedralTau} :=
  Subgroup.copy_eq _ _ _

/-- **The binary tetrahedral subgroup is contained in the binary icosahedral subgroup.** -/
theorem binaryTetrahedralSubgroup_le_binaryIcosahedralSubgroup :
    binaryTetrahedralSubgroup ≤ binaryIcosahedralSubgroup :=
  fun _ => .inl

@[simp]
theorem binaryIcosahedralTau_mem_binaryIcosahedralSubgroup :
    binaryIcosahedralTau ∈ binaryIcosahedralSubgroup := by
  rw [binaryIcosahedralSubgroup_eq_closure]
  exact Subgroup.subset_closure (by simp)

/-- **The binary icosahedral subgroup has exactly 120 elements.** -/
@[simp]
theorem natCard_binaryIcosahedralSubgroup : Nat.card binaryIcosahedralSubgroup = 120 := by
  rw [binaryIcosahedralSubgroup_eq_closure]
  exact natCard_closure_generators

instance : Finite binaryIcosahedralSubgroup :=
  Nat.finite_of_card_ne_zero (by simp)

/-- **The binary tetrahedral subgroup has index five in the binary icosahedral subgroup.** -/
theorem relIndex_binaryTetrahedralSubgroup_binaryIcosahedralSubgroup :
    binaryTetrahedralSubgroup.relIndex binaryIcosahedralSubgroup = 5 := by
  have h := binaryTetrahedralSubgroup.relIndex_mul_card binaryIcosahedralSubgroup
  rw [inf_of_le_left binaryTetrahedralSubgroup_le_binaryIcosahedralSubgroup,
    natCard_binaryTetrahedralSubgroup, natCard_binaryIcosahedralSubgroup] at h
  omega

/-! ### Odd permutations are excluded -/

private theorem baseValue_injective : Function.Injective ![(0 : ℝ), 1, φ, φ⁻¹] := by
  rw [inv_goldenRatio_eq_goldenRatio_sub_one]
  have h₁ := one_lt_goldenRatio
  have h₂ := goldenRatio_lt_two
  intro a b hab
  fin_cases a <;> fin_cases b <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk,
    Fin.isValue, Matrix.cons_val] at hab ⊢ <;> linarith

/-- **Odd permutations are excluded.** The point `(φ + φ⁻¹ i + j) / 2`, whose doubled coordinates
`(φ, φ⁻¹, 1, 0)` are `(0, 1, φ, φ⁻¹)` permuted by an odd permutation, is not in the binary
icosahedral subgroup. -/
theorem notMem_binaryIcosahedralSubgroup_of_coe_eq {g : SU2}
    (hg : (g : Matrix (Fin 2) (Fin 2) ℂ) = toComplexMatrix ⟨φ / 2, φ⁻¹ / 2, 1 / 2, 0⟩) :
    g ∉ binaryIcosahedralSubgroup := by
  rw [mem_binaryIcosahedralSubgroup_iff, mem_binaryTetrahedralSubgroup_iff_exists_int]
  rintro (⟨v, hv⟩ | ⟨σ, hσ, x, hx, hgx⟩)
  · -- A binary tetrahedral point has half-integer coordinates, but `1 < φ < 2`.
    have h := congrArg QuaternionAlgebra.re (toComplexMatrix_injective (hv.symm.trans hg))
    simp only [div_left_inj₀ (two_ne_zero' ℝ)] at h
    have h₁ : ((1 : ℤ) : ℝ) < v 0 := by rw [h]; exact_mod_cast one_lt_goldenRatio
    have h₂ : (v 0 : ℝ) < ((2 : ℤ) : ℝ) := by rw [h]; exact_mod_cast goldenRatio_lt_two
    have h₁ := Int.cast_lt.mp h₁
    have h₂ := Int.cast_lt.mp h₂
    omega
  · -- The coordinates determine `σ 0 = 2`, `σ 1 = 3` and `σ 2 = 1`, an odd permutation.
    have h := toComplexMatrix_injective (hgx.symm.trans hg)
    simp only [QuaternionAlgebra.mk.injEq, div_left_inj₀ (two_ne_zero' ℝ)] at h
    obtain ⟨h₀, h₁, h₂, -⟩ := h
    have e₀ : σ 0 = 2 := baseValue_injective (by
      rw [← hx 0, h₀, abs_of_pos goldenRatio_pos]
      simp)
    have e₁ : σ 1 = 3 := baseValue_injective (by
      rw [← hx 1, h₁, abs_of_pos (inv_pos.mpr goldenRatio_pos)]
      simp)
    have e₂ : σ 2 = 1 := baseValue_injective (by
      rw [← hx 2, h₂, abs_one]
      simp)
    exact (by decide +kernel : ∀ σ : Equiv.Perm (Fin 4), Equiv.Perm.sign σ = 1 → σ 0 = 2 →
      σ 1 = 3 → σ 2 = 1 → False) σ (Equiv.Perm.mem_alternatingGroup.mp hσ) e₀ e₁ e₂

/-- **The list built from all permutations is not closed.** The binary tetrahedral points together
with the quaternions `(x₀ + x₁ i + x₂ j + x₃ k) / 2` whose coordinates `xᵢ` are in absolute value
`(0, 1, φ, φ⁻¹)` permuted by an arbitrary permutation do not form a submonoid of `SU(2)`: the
product of `τ = (φ⁻¹ + φ i + j) / 2` and the odd-permutation point `(φ + φ⁻¹ i + j) / 2` has
`i`-coordinate `3 / 4`. -/
theorem not_exists_submonoid_coe_eq_allPerms :
    ¬ ∃ M : Submonoid SU2, (M : Set SU2) = {g | g ∈ binaryTetrahedralSubgroup ∨
      ∃ σ : Equiv.Perm (Fin 4), ∃ x : Fin 4 → ℝ, (∀ i, |x i| = ![0, 1, φ, φ⁻¹] (σ i)) ∧
        (g : Matrix (Fin 2) (Fin 2) ℂ) = toComplexMatrix ⟨x 0 / 2, x 1 / 2, x 2 / 2, x 3 / 2⟩} := by
  rintro ⟨M, hM⟩
  have hφ := inv_goldenRatio_eq_goldenRatio_sub_one
  -- The odd-permutation point `ρ = (φ + φ⁻¹ i + j) / 2`.
  let ρ : SU2 := ⟨toComplexMatrix ⟨φ / 2, φ⁻¹ / 2, 1 / 2, 0⟩,
    toComplexMatrix_mem_specialUnitaryGroup_of_sq_add_sq rfl⟩
  have hτ : binaryIcosahedralTau ∈ M := by
    rw [← SetLike.mem_coe, hM]
    rcases mem_binaryIcosahedralSubgroup_iff.mp
      binaryIcosahedralTau_mem_binaryIcosahedralSubgroup with h | ⟨σ, -, x, hx, h⟩
    exacts [.inl h, .inr ⟨σ, x, hx, h⟩]
  have hρ : ρ ∈ M := by
    rw [← SetLike.mem_coe, hM]
    refine .inr ⟨⟨![2, 3, 1, 0], ![3, 2, 0, 1], by decide, by decide⟩, ![φ, φ⁻¹, 1, 0],
      fun i => ?_, by simp [ρ]⟩
    fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue,
      Matrix.cons_val, Equiv.coe_fn_mk, abs_of_pos goldenRatio_pos,
      abs_of_pos (inv_pos.mpr goldenRatio_pos), abs_one, abs_zero]
  have hmul := M.mul_mem hτ hρ
  rw [← SetLike.mem_coe, hM] at hmul
  -- Any quaternion of `τρ` has `i`-coordinate `3 / 4`.
  have himI (q : ℍ[ℝ]) (hq : ((binaryIcosahedralTau * ρ : SU2) : Matrix (Fin 2) (Fin 2) ℂ) =
      toComplexMatrix q) : q.imI = 3 / 4 := by
    have h : toComplexMatrix q =
        toComplexMatrix ((⟨φ⁻¹ / 2, φ / 2, 1 / 2, 0⟩ : ℍ[ℝ]) * ⟨φ / 2, φ⁻¹ / 2, 1 / 2, 0⟩) := by
      rw [← hq, Submonoid.coe_mul, coe_binaryIcosahedralTau, map_mul]
    rw [toComplexMatrix_injective h]
    simp only [QuaternionAlgebra.imI_mul]
    rw [hφ]
    linear_combination goldenRatio_sq / 2
  rcases hmul with h | ⟨σ, x, hx, h⟩
  · -- A binary tetrahedral point has half-integer coordinates.
    obtain ⟨v, hv⟩ := mem_binaryTetrahedralSubgroup_iff_exists_int.mp h
    have h₁ : (v 1 : ℝ) * 2 = 3 := by linarith [himI _ hv]
    have h₂ : v 1 * 2 = 3 := by exact_mod_cast h₁
    omega
  · -- Otherwise `|x₁| = 3 / 2` would be one of `0, 1, φ, φ⁻¹ = φ - 1`, but `φ² = φ + 1`.
    have h₁ := hx 1
    rw [show x 1 = 3 / 2 by linarith [himI _ h], abs_of_pos (by norm_num)] at h₁
    refine (forall_baseValue (P := fun y => (3 / 2 : ℝ) ≠ y)).mpr ⟨by norm_num, by norm_num, ?_, ?_⟩
      (σ 1) h₁ <;> intro h <;> nlinarith [goldenRatio_sq, hφ]

end TauCeti.SU2
