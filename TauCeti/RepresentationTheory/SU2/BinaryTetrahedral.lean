public import TauCeti.Algebra.Quaternion.Hurwitz
public import TauCeti.RepresentationTheory.SU2.BinaryDihedral
import Mathlib.GroupTheory.OrderOfElement

/-!
# The concrete binary tetrahedral subgroup of `SU(2)`

Under the quaternion-matrix identification `Quaternion.unitaryEquivSpecialUnitaryGroup :
unitary ℍ[ℝ] ≃* SU(2)` sending

`a + b i + c j + d k  ↦  !![a + b I, c + d I; -c + d I, a - b I]`,

the twenty-four Hurwitz units (`TauCeti.hurwitzUnitSubgroup`) map to a concrete subgroup
`TauCeti.SU2.binaryTetrahedralSubgroup` of `SU(2)` of exact order `24`. Its elements fall into two
disjoint coordinate families (`TauCeti.SU2.mem_binaryTetrahedralSubgroup_iff`):

* the `8` matrices `Quaternion.toComplexMatrix (lipschitzUnit a ε)` attached to the coordinate
  permutations of `(±1, 0, 0, 0)`, which are precisely the elements of the quaternion subgroup
  `Q₈ = TauCeti.SU2.binaryDihedralSubgroup 2`
  (`TauCeti.SU2.mem_binaryDihedralSubgroup_two_iff_exists_lipschitzUnit`);
* the `16` matrices `Quaternion.toComplexMatrix (halfHurwitzUnit δ)` attached to the half-integer
  unit quaternions `(±1 ± i ± j ± k) / 2`.

All `24` matrices are pairwise distinct, packaged as the coordinate bijection
`TauCeti.SU2.binaryTetrahedralParam : (Fin 4 × ℤˣ) ⊕ (Fin 4 → ℤˣ) ≃ binaryTetrahedralSubgroup`,
and reduction modulo `3` identifies the subgroup with `SL₂(𝔽₃)`
(`TauCeti.SU2.binaryTetrahedralEquiv`).

To connect the unit-quaternion coordinates with standard group presentations, we name the
generator `t = TauCeti.SU2.binaryTetrahedralGenerator` attached to `(1 + i + j + k) / 2`:

`t = !![(1 + I) / 2, (1 + I) / 2; (-1 + I) / 2, (1 - I) / 2]`.

It has exact order `6` with `t³ = -1`. Conjugation by `t` cyclically permutes the three quaternion
generators `r = binaryDihedralRotation 2` (`i`), `s = weylElement⁻¹` (`j`), and `r s` (`k`):

`t r t⁻¹ = s`,    `t s t⁻¹ = r s`,    `t (r s) t⁻¹ = r`.

Consequently `binaryDihedralSubgroup 2` is normal of index `3` inside `binaryTetrahedralSubgroup`,
every element admits a coset normal form `t ^ k * q` (`k < 3`, `q ∈ binaryDihedralSubgroup 2`),
`binaryTetrahedralSubgroup` is generated by `{r, t}`, and `(r, t, t⁻¹ r)` satisfies the binary
polyhedral `<2, 3, 3>` relations `r² = t³ = (t⁻¹ r)³ = r t (t⁻¹ r) = -1`.

## Main definitions

* `TauCeti.SU2.binaryTetrahedralSubgroup`: the concrete binary tetrahedral subgroup of `SU(2)`.
* `TauCeti.SU2.hurwitzUnitEquivBinaryTetrahedral`: `hurwitzUnitSubgroup ≃*
  binaryTetrahedralSubgroup`.
* `TauCeti.SU2.binaryTetrahedralParam`: `(Fin 4 × ℤˣ) ⊕ (Fin 4 → ℤˣ) ≃ binaryTetrahedralSubgroup`.
* `TauCeti.SU2.binaryTetrahedralEquiv`: `binaryTetrahedralSubgroup ≃*
  Matrix.SpecialLinearGroup (Fin 2) (ZMod 3)`.
* `TauCeti.SU2.binaryTetrahedralGenerator`: the order-`6` generator attached to
  `(1 + i + j + k) / 2`.

## References

* J. H. Conway and D. A. Smith, *On Quaternions and Octonions*, A K Peters, 2003, §6.5.
* T. A. Springer, *Invariant Theory*, Lecture Notes in Mathematics 585, Springer, 1977, §4.4.
-/

public section

open scoped Matrix Quaternion Real

namespace TauCeti.SU2

/-! ### Construction and unit-quaternion coordinates -/

/-- **The concrete binary tetrahedral subgroup of `SU(2)`**, the image of the twenty-four Hurwitz
units under `Quaternion.unitaryEquivSpecialUnitaryGroup`. -/
noncomputable def binaryTetrahedralSubgroup : Subgroup SU2 :=
  hurwitzUnitSubgroup.map Quaternion.unitaryEquivSpecialUnitaryGroup.toMonoidHom

/-- `TauCeti.SU2.binaryTetrahedralSubgroup` is the image of `TauCeti.hurwitzUnitSubgroup` under
`Quaternion.unitaryEquivSpecialUnitaryGroup`. -/
theorem binaryTetrahedralSubgroup_def :
    binaryTetrahedralSubgroup =
      hurwitzUnitSubgroup.map Quaternion.unitaryEquivSpecialUnitaryGroup.toMonoidHom :=
  (rfl)

/-- The unit-quaternion equivalence `hurwitzUnitSubgroup ≃* binaryTetrahedralSubgroup`. -/
noncomputable def hurwitzUnitEquivBinaryTetrahedral :
    hurwitzUnitSubgroup ≃* binaryTetrahedralSubgroup :=
  Quaternion.unitaryEquivSpecialUnitaryGroup.subgroupMap hurwitzUnitSubgroup

/-- `TauCeti.SU2.hurwitzUnitEquivBinaryTetrahedral` restricts
`Quaternion.unitaryEquivSpecialUnitaryGroup`. -/
@[simp]
theorem coe_hurwitzUnitEquivBinaryTetrahedral_apply (u : hurwitzUnitSubgroup) :
    (hurwitzUnitEquivBinaryTetrahedral u : SU2) =
      Quaternion.unitaryEquivSpecialUnitaryGroup (u : unitary ℍ[ℝ]) :=
  (rfl)

/-- `TauCeti.SU2.hurwitzUnitEquivBinaryTetrahedral.symm` restricts
`Quaternion.unitaryEquivSpecialUnitaryGroup.symm`. -/
@[simp]
theorem coe_hurwitzUnitEquivBinaryTetrahedral_symm_apply (g : binaryTetrahedralSubgroup) :
    (hurwitzUnitEquivBinaryTetrahedral.symm g : unitary ℍ[ℝ]) =
      Quaternion.unitaryEquivSpecialUnitaryGroup.symm (g : SU2) :=
  (rfl)

/-- An element of `SU(2)` lies in `binaryTetrahedralSubgroup` precisely when its matrix is
`Quaternion.toComplexMatrix q` for a Hurwitz unit `q ∈ unitary ℍ[ℝ]`. -/
theorem mem_binaryTetrahedralSubgroup_iff_exists_isHurwitz {g : SU2} :
    g ∈ binaryTetrahedralSubgroup ↔
      ∃ q ∈ unitary ℍ[ℝ], q.IsHurwitz ∧
        (g : Matrix (Fin 2) (Fin 2) ℂ) = Quaternion.toComplexMatrix q := by
  rw [binaryTetrahedralSubgroup_def, Subgroup.mem_map]
  constructor
  · rintro ⟨u, hu, rfl⟩
    exact ⟨(u : ℍ[ℝ]), u.2, mem_hurwitzUnitSubgroup_iff_isHurwitz.mp hu, by simp⟩
  · rintro ⟨q, hqU, hqH, hg⟩
    refine ⟨⟨q, hqU⟩, mem_hurwitzUnitSubgroup_iff_isHurwitz.mpr hqH, Subtype.ext ?_⟩
    simp [hg]

/-- **Unit-quaternion coordinates of the binary tetrahedral subgroup.** An element of `SU(2)` lies
in `binaryTetrahedralSubgroup` if and only if its matrix is `Quaternion.toComplexMatrix` at one of
the `8` Lipschitz units or one of the `16` half-integer Hurwitz units `(±1 ± i ± j ± k) / 2`. -/
theorem mem_binaryTetrahedralSubgroup_iff {g : SU2} :
    g ∈ binaryTetrahedralSubgroup ↔
      (∃ (a : Fin 4) (ε : ℤˣ),
        (g : Matrix (Fin 2) (Fin 2) ℂ) = Quaternion.toComplexMatrix (lipschitzUnit a ε)) ∨
      ∃ δ : Fin 4 → ℤˣ,
        (g : Matrix (Fin 2) (Fin 2) ℂ) = Quaternion.toComplexMatrix (halfHurwitzUnit δ) := by
  rw [binaryTetrahedralSubgroup_def, Subgroup.mem_map]
  constructor
  · rintro ⟨u, hu, rfl⟩
    rcases mem_hurwitzUnitSubgroup_iff.mp hu with ⟨a, ε, hq⟩ | ⟨δ, hq⟩
    · exact Or.inl ⟨a, ε, by simp [hq]⟩
    · exact Or.inr ⟨δ, by simp [hq]⟩
  · rintro (⟨a, ε, hg⟩ | ⟨δ, hg⟩)
    · refine ⟨⟨lipschitzUnit a ε, lipschitzUnit_mem_unitary a ε⟩,
        mem_hurwitzUnitSubgroup_iff_isHurwitz.mpr (isHurwitz_lipschitzUnit a ε), Subtype.ext ?_⟩
      simp [hg]
    · refine ⟨⟨halfHurwitzUnit δ, halfHurwitzUnit_mem_unitary δ⟩,
        mem_hurwitzUnitSubgroup_iff_isHurwitz.mpr (isHurwitz_halfHurwitzUnit δ), Subtype.ext ?_⟩
      simp [hg]

/-- Distinct `(a, ε)` determine distinct Lipschitz matrices in `M₂(ℂ)`. -/
theorem toComplexMatrix_lipschitzUnit_injective :
    Function.Injective
      (fun p : Fin 4 × ℤˣ => Quaternion.toComplexMatrix (lipschitzUnit p.1 p.2)) :=
  Quaternion.toComplexMatrix_injective.comp lipschitzUnit_injective

/-- Distinct sign vectors determine distinct half-integer Hurwitz matrices in `M₂(ℂ)`. -/
theorem toComplexMatrix_halfHurwitzUnit_injective :
    Function.Injective (fun δ : Fin 4 → ℤˣ => Quaternion.toComplexMatrix (halfHurwitzUnit δ)) :=
  Quaternion.toComplexMatrix_injective.comp halfHurwitzUnit_injective

/-- No Lipschitz matrix equals any half-integer Hurwitz matrix. -/
theorem toComplexMatrix_lipschitzUnit_ne_halfHurwitzUnit
    (a : Fin 4) (ε : ℤˣ) (δ : Fin 4 → ℤˣ) :
    Quaternion.toComplexMatrix (lipschitzUnit a ε) ≠
      Quaternion.toComplexMatrix (halfHurwitzUnit δ) :=
  fun h => lipschitzUnit_ne_halfHurwitzUnit a ε δ (Quaternion.toComplexMatrix_injective h)

/-- **Explicit `24`-element parametrization of `binaryTetrahedralSubgroup`**, witnessing closure and
pairwise distinctness of the `8 + 16` matrices. -/
noncomputable def binaryTetrahedralParam :
    (Fin 4 × ℤˣ) ⊕ (Fin 4 → ℤˣ) ≃ binaryTetrahedralSubgroup :=
  hurwitzUnitParam.trans hurwitzUnitEquivBinaryTetrahedral.toEquiv

/-- On the left summand `binaryTetrahedralParam` gives the `8` Lipschitz matrices. -/
@[simp]
theorem coe_binaryTetrahedralParam_inl (p : Fin 4 × ℤˣ) :
    ((binaryTetrahedralParam (Sum.inl p) : SU2) : Matrix (Fin 2) (Fin 2) ℂ) =
      Quaternion.toComplexMatrix (lipschitzUnit p.1 p.2) := by
  simp [binaryTetrahedralParam]

/-- On the right summand `binaryTetrahedralParam` gives the `16` half-integer Hurwitz matrices. -/
@[simp]
theorem coe_binaryTetrahedralParam_inr (δ : Fin 4 → ℤˣ) :
    ((binaryTetrahedralParam (Sum.inr δ) : SU2) : Matrix (Fin 2) (Fin 2) ℂ) =
      Quaternion.toComplexMatrix (halfHurwitzUnit δ) := by
  simp [binaryTetrahedralParam]

/-- `TauCeti.SU2.binaryTetrahedralSubgroup` is finite. -/
instance : Finite binaryTetrahedralSubgroup :=
  Finite.of_equiv _ binaryTetrahedralParam

/-- **The binary tetrahedral subgroup has exact order `24`.** -/
@[simp]
theorem natCard_binaryTetrahedralSubgroup : Nat.card binaryTetrahedralSubgroup = 24 := by
  rw [← Nat.card_congr hurwitzUnitEquivBinaryTetrahedral.toEquiv, natCard_hurwitzUnitSubgroup]

/-- **The binary tetrahedral subgroup is isomorphic to `SL₂(𝔽₃)`.** -/
noncomputable def binaryTetrahedralEquiv :
    binaryTetrahedralSubgroup ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 3) :=
  hurwitzUnitEquivBinaryTetrahedral.symm.trans hurwitzUnitEquivSpecialLinear

/-- Unfolding lemma for `TauCeti.SU2.binaryTetrahedralEquiv`. -/
theorem binaryTetrahedralEquiv_def :
    binaryTetrahedralEquiv =
      hurwitzUnitEquivBinaryTetrahedral.symm.trans hurwitzUnitEquivSpecialLinear :=
  (rfl)

/-! ### Quaternion coordinates of `Q₈` and the tetrahedral generator -/

/-- At `n = 2` the binary dihedral rotation generator `r` is the matrix of the quaternion `i`. -/
theorem coe_binaryDihedralRotation_two_eq_toComplexMatrix :
    ((binaryDihedralRotation 2 : SU2) : Matrix (Fin 2) (Fin 2) ℂ) =
      Quaternion.toComplexMatrix ⟨0, 1, 0, 0⟩ := by
  rw [coe_binaryDihedralRotation_eq_toComplexMatrix 2]
  congr 1
  ext <;> simp

/-- Explicit matrix of `binaryDihedralRotation 2`: `diag (I, -I)`. -/
theorem coe_binaryDihedralRotation_two :
    ((binaryDihedralRotation 2 : SU2) : Matrix (Fin 2) (Fin 2) ℂ) =
      !![Complex.I, 0; 0, -Complex.I] := by
  rw [coe_binaryDihedralRotation_two_eq_toComplexMatrix, Quaternion.toComplexMatrix_apply]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

/-- **The tetrahedral generator** `t ∈ SU(2)`, attached to the Hurwitz unit
`ω = (1 + i + j + k) / 2`. -/
noncomputable def binaryTetrahedralGenerator : SU2 :=
  Quaternion.unitaryEquivSpecialUnitaryGroup
    ⟨halfHurwitzUnit (fun _ => 1), halfHurwitzUnit_mem_unitary _⟩

/-- Unfolding lemma for `TauCeti.SU2.binaryTetrahedralGenerator`. -/
theorem binaryTetrahedralGenerator_def :
    binaryTetrahedralGenerator =
      Quaternion.unitaryEquivSpecialUnitaryGroup
        ⟨halfHurwitzUnit (fun _ => 1), halfHurwitzUnit_mem_unitary _⟩ :=
  (rfl)

/-- In quaternion coordinates `binaryTetrahedralGenerator` is `(1 + i + j + k) / 2`. -/
theorem coe_binaryTetrahedralGenerator_eq_toComplexMatrix :
    (binaryTetrahedralGenerator : Matrix (Fin 2) (Fin 2) ℂ) =
      Quaternion.toComplexMatrix ⟨1 / 2, 1 / 2, 1 / 2, 1 / 2⟩ := by
  rw [binaryTetrahedralGenerator_def, Quaternion.coe_unitaryEquivSpecialUnitaryGroup_apply]
  congr 1
  ext <;> simp [halfHurwitzUnit_def]

/-- **Explicit matrix of `binaryTetrahedralGenerator`**:
`!![(1 + I) / 2, (1 + I) / 2; (-1 + I) / 2, (1 - I) / 2]`. -/
theorem coe_binaryTetrahedralGenerator :
    (binaryTetrahedralGenerator : Matrix (Fin 2) (Fin 2) ℂ) =
      !![(1 + Complex.I) / 2, (1 + Complex.I) / 2;
        (-1 + Complex.I) / 2, (1 - Complex.I) / 2] := by
  rw [coe_binaryTetrahedralGenerator_eq_toComplexMatrix, Quaternion.toComplexMatrix_apply]
  ext i j
  fin_cases i <;> fin_cases j <;> simp <;> ring

/-- `TauCeti.SU2.binaryTetrahedralGenerator` belongs to `binaryTetrahedralSubgroup`. -/
@[simp]
theorem binaryTetrahedralGenerator_mem_binaryTetrahedralSubgroup :
    binaryTetrahedralGenerator ∈ binaryTetrahedralSubgroup := by
  refine mem_binaryTetrahedralSubgroup_iff.mpr (Or.inr ⟨fun _ => 1, ?_⟩)
  simp [binaryTetrahedralGenerator_def]

/-- The inverse of `binaryTetrahedralGenerator` is the matrix of `(1 - i - j - k) / 2`. -/
theorem coe_binaryTetrahedralGenerator_inv_eq_toComplexMatrix :
    ((binaryTetrahedralGenerator⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ) =
      Quaternion.toComplexMatrix ⟨1 / 2, -1 / 2, -1 / 2, -1 / 2⟩ := by
  rw [← Matrix.star_eq_inv, Matrix.specialUnitaryGroup.coe_star,
    coe_binaryTetrahedralGenerator_eq_toComplexMatrix, ← map_star]
  congr 1
  ext <;> simp <;> ring

/-- The square of `binaryTetrahedralGenerator` is the matrix of `(-1 + i + j + k) / 2`. -/
theorem coe_binaryTetrahedralGenerator_sq_eq_toComplexMatrix :
    ((binaryTetrahedralGenerator ^ 2 : SU2) : Matrix (Fin 2) (Fin 2) ℂ) =
      Quaternion.toComplexMatrix ⟨-1 / 2, 1 / 2, 1 / 2, 1 / 2⟩ := by
  rw [SubmonoidClass.coe_pow, sq, coe_binaryTetrahedralGenerator_eq_toComplexMatrix, ← map_mul]
  congr 1
  ext <;> simp <;> ring

/-- **The cube of `binaryTetrahedralGenerator` is `-1`.** -/
theorem coe_binaryTetrahedralGenerator_cubed :
    ((binaryTetrahedralGenerator ^ 3 : SU2) : Matrix (Fin 2) (Fin 2) ℂ) = -1 := by
  have h3 : binaryTetrahedralGenerator ^ 3 =
      binaryTetrahedralGenerator ^ 2 * binaryTetrahedralGenerator := by group
  rw [h3, Submonoid.coe_mul, coe_binaryTetrahedralGenerator_sq_eq_toComplexMatrix,
    coe_binaryTetrahedralGenerator_eq_toComplexMatrix, ← map_mul]
  have hq : (⟨-1 / 2, 1 / 2, 1 / 2, 1 / 2⟩ : ℍ[ℝ]) * ⟨1 / 2, 1 / 2, 1 / 2, 1 / 2⟩ = -1 := by
    ext <;> simp <;> ring
  rw [hq, map_neg, map_one]

/-- The generators satisfy `t³ = r²` (`= -1`) at `n = 2`. -/
theorem binaryTetrahedralGenerator_cubed_eq_binaryDihedralRotation_two_sq :
    binaryTetrahedralGenerator ^ 3 = binaryDihedralRotation 2 ^ 2 :=
  Subtype.ext (by rw [coe_binaryTetrahedralGenerator_cubed, coe_binaryDihedralRotation_pow_self 2])

/-- The generators satisfy `t³ = s²` (`= -1`). -/
theorem binaryTetrahedralGenerator_cubed_eq_weylElement_inv_sq :
    binaryTetrahedralGenerator ^ 3 = weylElement⁻¹ ^ 2 :=
  Subtype.ext (by rw [coe_binaryTetrahedralGenerator_cubed, coe_weylElement_inv_sq])

/-- `binaryTetrahedralGenerator` satisfies `t ^ 6 = 1`. -/
theorem binaryTetrahedralGenerator_pow_six : binaryTetrahedralGenerator ^ 6 = 1 := by
  refine Subtype.ext ?_
  have h6 : (6 : ℕ) = 3 * 2 := rfl
  rw [h6, pow_mul, SubmonoidClass.coe_pow, coe_binaryTetrahedralGenerator_cubed]
  simp

/-- **`binaryTetrahedralGenerator` has exact order `6`.** -/
@[simp]
theorem orderOf_binaryTetrahedralGenerator : orderOf binaryTetrahedralGenerator = 6 := by
  refine orderOf_eq_of_pow_and_pow_div_prime binaryTetrahedralGenerator_pow_six ?_
  intro p hp hdvd
  have h2le : 2 ≤ p := hp.two_le
  have hle : p ≤ 6 := Nat.le_of_dvd (by norm_num) hdvd
  interval_cases p
  · -- `p = 2`: `t ^ 3 = -1 ≠ 1`.
    intro h3
    norm_num at h3
    have hmat : ((binaryTetrahedralGenerator ^ 3 : SU2) : Matrix (Fin 2) (Fin 2) ℂ) 0 0 =
        ((1 : SU2) : Matrix (Fin 2) (Fin 2) ℂ) 0 0 := by rw [h3]
    rw [coe_binaryTetrahedralGenerator_cubed] at hmat
    norm_num at hmat
  · -- `p = 3`: `t ^ 2` has real quaternion coordinate `-1 / 2`, so it is not `1`.
    intro h2
    norm_num at h2
    have hmat : ((binaryTetrahedralGenerator ^ 2 : SU2) : Matrix (Fin 2) (Fin 2) ℂ) =
        ((1 : SU2) : Matrix (Fin 2) (Fin 2) ℂ) := by rw [h2]
    rw [coe_binaryTetrahedralGenerator_sq_eq_toComplexMatrix, Submonoid.coe_one,
      ← map_one Quaternion.toComplexMatrix] at hmat
    have hre := congrArg QuaternionAlgebra.re (Quaternion.toComplexMatrix_injective hmat)
    norm_num at hre
  · exact absurd hdvd (by decide)
  · exact absurd hdvd (by decide)
  · exact absurd hp (by decide)

/-! ### Conjugation action and `<2, 3, 3>` presentation relations -/

/-- **Conjugation by `t` sends `r` (`i`) to `s` (`j`).** -/
theorem binaryTetrahedralGenerator_conj_binaryDihedralRotation_two :
    binaryTetrahedralGenerator * binaryDihedralRotation 2 * binaryTetrahedralGenerator⁻¹ =
      weylElement⁻¹ := by
  refine Subtype.ext ?_
  rw [Submonoid.coe_mul, Submonoid.coe_mul, coe_binaryTetrahedralGenerator_eq_toComplexMatrix,
    coe_binaryDihedralRotation_two_eq_toComplexMatrix,
    coe_binaryTetrahedralGenerator_inv_eq_toComplexMatrix, coe_weylElement_inv_eq_toComplexMatrix,
    ← map_mul, ← map_mul]
  congr 1
  ext <;> simp <;> ring

/-- **Conjugation by `t` sends `s` (`j`) to `r s` (`k`).** -/
theorem binaryTetrahedralGenerator_conj_weylElement_inv :
    binaryTetrahedralGenerator * weylElement⁻¹ * binaryTetrahedralGenerator⁻¹ =
      binaryDihedralRotation 2 * weylElement⁻¹ := by
  refine Subtype.ext ?_
  rw [Submonoid.coe_mul, Submonoid.coe_mul, Submonoid.coe_mul,
    coe_binaryTetrahedralGenerator_eq_toComplexMatrix, coe_weylElement_inv_eq_toComplexMatrix,
    coe_binaryTetrahedralGenerator_inv_eq_toComplexMatrix,
    coe_binaryDihedralRotation_two_eq_toComplexMatrix, ← map_mul, ← map_mul, ← map_mul]
  congr 1
  ext <;> simp <;> ring

/-- **Conjugation by `t` sends `r s` (`k`) back to `r` (`i`).** -/
theorem binaryTetrahedralGenerator_conj_mul :
    binaryTetrahedralGenerator * (binaryDihedralRotation 2 * weylElement⁻¹) *
        binaryTetrahedralGenerator⁻¹ =
      binaryDihedralRotation 2 := by
  refine Subtype.ext ?_
  rw [Submonoid.coe_mul, Submonoid.coe_mul, Submonoid.coe_mul,
    coe_binaryTetrahedralGenerator_eq_toComplexMatrix,
    coe_binaryDihedralRotation_two_eq_toComplexMatrix, coe_weylElement_inv_eq_toComplexMatrix,
    coe_binaryTetrahedralGenerator_inv_eq_toComplexMatrix, ← map_mul, ← map_mul, ← map_mul]
  congr 1
  ext <;> simp <;> ring

/-- **Binary `<2, 3, 3>` relation (third generator cube)**: `(t⁻¹ r)³ = -1`. Together with
`r² = -1` (`coe_binaryDihedralRotation_pow_self 2`), `t³ = -1`
(`coe_binaryTetrahedralGenerator_cubed`), and `r * t * (t⁻¹ * r) = r² = -1`, the triple
`(r, t, t⁻¹ r)` satisfies the standard `<2, 3, 3>` presentation `x² = y³ = z³ = x y z = -1`. -/
theorem coe_binaryTetrahedralGenerator_inv_mul_binaryDihedralRotation_two_cubed :
    (((binaryTetrahedralGenerator⁻¹ * binaryDihedralRotation 2) ^ 3 : SU2) :
      Matrix (Fin 2) (Fin 2) ℂ) = -1 := by
  have hmul :
      ((binaryTetrahedralGenerator⁻¹ * binaryDihedralRotation 2 : SU2) :
        Matrix (Fin 2) (Fin 2) ℂ) =
        Quaternion.toComplexMatrix ⟨1 / 2, 1 / 2, -1 / 2, 1 / 2⟩ := by
    rw [Submonoid.coe_mul, coe_binaryTetrahedralGenerator_inv_eq_toComplexMatrix,
      coe_binaryDihedralRotation_two_eq_toComplexMatrix, ← map_mul]
    congr 1
    ext <;> simp <;> ring
  rw [SubmonoidClass.coe_pow, hmul, ← map_pow]
  have hpow : (⟨1 / 2, 1 / 2, -1 / 2, 1 / 2⟩ : ℍ[ℝ]) ^ 3 = -1 := by
    have h3 : (3 : ℕ) = 2 + 1 := rfl
    rw [h3, pow_add, sq, pow_one]
    ext <;> simp <;> ring
  rw [hpow, map_neg, map_one]

/-- **Binary `<2, 3, 3>` product relation**: `r * t * (t⁻¹ * r) = -1`. -/
theorem coe_binaryDihedralRotation_two_mul_binaryTetrahedralGenerator_mul :
    ((binaryDihedralRotation 2 * binaryTetrahedralGenerator *
        (binaryTetrahedralGenerator⁻¹ * binaryDihedralRotation 2) : SU2) :
      Matrix (Fin 2) (Fin 2) ℂ) = -1 := by
  have hgrp :
      binaryDihedralRotation 2 * binaryTetrahedralGenerator *
          (binaryTetrahedralGenerator⁻¹ * binaryDihedralRotation 2) =
        binaryDihedralRotation 2 ^ 2 := by
    simp [mul_assoc, sq]
  rw [hgrp, coe_binaryDihedralRotation_pow_self 2]

/-! ### Normal containment of `Q₈`, cosets, and generation -/

private noncomputable def lipschitzSU2 (a : Fin 4) (ε : ℤˣ) : SU2 :=
  Quaternion.unitaryEquivSpecialUnitaryGroup ⟨lipschitzUnit a ε, lipschitzUnit_mem_unitary a ε⟩

private theorem coe_lipschitzSU2 (a : Fin 4) (ε : ℤˣ) :
    (lipschitzSU2 a ε : Matrix (Fin 2) (Fin 2) ℂ) =
      Quaternion.toComplexMatrix (lipschitzUnit a ε) :=
  Quaternion.coe_unitaryEquivSpecialUnitaryGroup_apply _

private theorem lipschitzSU2_mem_binaryDihedralSubgroup_two (a : Fin 4) (ε : ℤˣ) :
    lipschitzSU2 a ε ∈ binaryDihedralSubgroup 2 := by
  have hpos : ∀ b : Fin 4, lipschitzSU2 b 1 ∈ binaryDihedralSubgroup 2 := by
    intro b
    fin_cases b <;> dsimp
    · have h0 : lipschitzSU2 0 1 = 1 := Subtype.ext <| by
        rw [coe_lipschitzSU2, lipschitzUnit_zero, Submonoid.coe_one,
          ← map_one Quaternion.toComplexMatrix]
        congr 1
        ext <;> simp
      rw [h0]
      exact one_mem _
    · have h1 : lipschitzSU2 1 1 = binaryDihedralRotation 2 := Subtype.ext <| by
        rw [coe_lipschitzSU2, coe_binaryDihedralRotation_two_eq_toComplexMatrix, lipschitzUnit_one]
        simp
      rw [h1]
      exact binaryDihedralRotation_mem_binaryDihedralSubgroup 2
    · have h2 : lipschitzSU2 2 1 = weylElement⁻¹ := Subtype.ext <| by
        rw [coe_lipschitzSU2, coe_weylElement_inv_eq_toComplexMatrix, lipschitzUnit_two]
        simp
      rw [h2]
      exact inv_mem (weylElement_mem_binaryDihedralSubgroup 2)
    · have h3 : lipschitzSU2 3 1 = binaryDihedralRotation 2 * weylElement⁻¹ := Subtype.ext <| by
        rw [coe_lipschitzSU2, Submonoid.coe_mul, coe_binaryDihedralRotation_two_eq_toComplexMatrix,
          coe_weylElement_inv_eq_toComplexMatrix, ← map_mul, lipschitzUnit_three]
        congr 1
        ext <;> simp
      rw [h3]
      exact mul_mem (binaryDihedralRotation_mem_binaryDihedralSubgroup 2)
        (inv_mem (weylElement_mem_binaryDihedralSubgroup 2))
  rcases Int.units_eq_one_or ε with rfl | rfl
  · exact hpos a
  · have hneg : lipschitzSU2 a (-1) = binaryDihedralRotation 2 ^ 2 * lipschitzSU2 a 1 :=
      Subtype.ext <| by
        rw [Submonoid.coe_mul, coe_binaryDihedralRotation_pow_self 2, coe_lipschitzSU2,
          coe_lipschitzSU2, neg_one_mul, ← map_neg]
        congr 1
        fin_cases a <;>
          simp [lipschitzUnit_zero, lipschitzUnit_one, lipschitzUnit_two, lipschitzUnit_three]
    rw [hneg]
    exact mul_mem (pow_mem (binaryDihedralRotation_mem_binaryDihedralSubgroup 2) 2) (hpos a)

/-- **The quaternion subgroup `binaryDihedralSubgroup 2` consists precisely of the `8` Lipschitz
unit matrices `±1, ±i, ±j, ±k`.** -/
theorem mem_binaryDihedralSubgroup_two_iff_exists_lipschitzUnit {g : SU2} :
    g ∈ binaryDihedralSubgroup 2 ↔
      ∃ (a : Fin 4) (ε : ℤˣ),
        (g : Matrix (Fin 2) (Fin 2) ℂ) = Quaternion.toComplexMatrix (lipschitzUnit a ε) := by
  let f : Fin 4 × ℤˣ → binaryDihedralSubgroup 2 :=
    fun p => ⟨lipschitzSU2 p.1 p.2, lipschitzSU2_mem_binaryDihedralSubgroup_two p.1 p.2⟩
  have hf_inj : Function.Injective f := by
    intro p q hpq
    apply toComplexMatrix_lipschitzUnit_injective
    have hmat := congrArg (fun x : binaryDihedralSubgroup 2 =>
      ((x : SU2) : Matrix (Fin 2) (Fin 2) ℂ)) hpq
    simpa [f, lipschitzSU2] using hmat
  have hf_bij : Function.Bijective f := by
    refine (Nat.bijective_iff_injective_and_card f).mpr ⟨hf_inj, ?_⟩
    rw [natCard_binaryDihedralSubgroup 2, Nat.card_eq_fintype_card]
    simp [Fintype.card_units_int]
  constructor
  · intro hg
    obtain ⟨⟨a, ε⟩, h⟩ := hf_bij.2 ⟨g, hg⟩
    refine ⟨a, ε, ?_⟩
    have hmat := congrArg (fun x : binaryDihedralSubgroup 2 =>
      ((x : SU2) : Matrix (Fin 2) (Fin 2) ℂ)) h
    simpa [f, lipschitzSU2] using hmat.symm
  · rintro ⟨a, ε, hg⟩
    have hge : g = lipschitzSU2 a ε := Subtype.ext <| by
      rw [hg, lipschitzSU2, Quaternion.coe_unitaryEquivSpecialUnitaryGroup_apply]
    rw [hge]
    exact lipschitzSU2_mem_binaryDihedralSubgroup_two a ε

/-- `binaryDihedralSubgroup 2` (`Q₈`) is contained in `binaryTetrahedralSubgroup`. -/
theorem binaryDihedralSubgroup_two_le_binaryTetrahedralSubgroup :
    binaryDihedralSubgroup 2 ≤ binaryTetrahedralSubgroup := by
  intro g hg
  exact mem_binaryTetrahedralSubgroup_iff.mpr
    (Or.inl (mem_binaryDihedralSubgroup_two_iff_exists_lipschitzUnit.mp hg))

/-- `binaryTetrahedralGenerator` does not lie in `binaryDihedralSubgroup 2`. -/
theorem binaryTetrahedralGenerator_notMem_binaryDihedralSubgroup_two :
    binaryTetrahedralGenerator ∉ binaryDihedralSubgroup 2 := by
  rw [mem_binaryDihedralSubgroup_two_iff_exists_lipschitzUnit]
  rintro ⟨a, ε, h⟩
  rw [binaryTetrahedralGenerator_def, Quaternion.coe_unitaryEquivSpecialUnitaryGroup_apply] at h
  exact toComplexMatrix_lipschitzUnit_ne_halfHurwitzUnit a ε (fun _ => 1) h.symm

/-- `binaryTetrahedralGenerator ^ 2` does not lie in `binaryDihedralSubgroup 2`. -/
theorem binaryTetrahedralGenerator_sq_notMem_binaryDihedralSubgroup_two :
    binaryTetrahedralGenerator ^ 2 ∉ binaryDihedralSubgroup 2 := by
  intro hmem
  apply binaryTetrahedralGenerator_notMem_binaryDihedralSubgroup_two
  have h7 : binaryTetrahedralGenerator ^ 7 =
      binaryTetrahedralGenerator ^ 6 * binaryTetrahedralGenerator := by group
  rw [binaryTetrahedralGenerator_pow_six, one_mul] at h7
  have heq : binaryTetrahedralGenerator =
      (binaryTetrahedralGenerator ^ 2) ^ 2 * binaryDihedralRotation 2 ^ 2 := by
    calc
      binaryTetrahedralGenerator = binaryTetrahedralGenerator ^ 7 := h7.symm
      _ = (binaryTetrahedralGenerator ^ 2) ^ 2 * binaryTetrahedralGenerator ^ 3 := by group
      _ = (binaryTetrahedralGenerator ^ 2) ^ 2 * binaryDihedralRotation 2 ^ 2 := by
        rw [binaryTetrahedralGenerator_cubed_eq_binaryDihedralRotation_two_sq]
  rw [heq]
  exact mul_mem (pow_mem hmem 2)
    (pow_mem (binaryDihedralRotation_mem_binaryDihedralSubgroup 2) 2)

/-- **`binaryDihedralSubgroup 2` has index `3` inside `binaryTetrahedralSubgroup`.** -/
@[simp]
theorem index_binaryDihedralSubgroup_two :
    ((binaryDihedralSubgroup 2).subgroupOf binaryTetrahedralSubgroup).index = 3 := by
  have hmul :=
    Subgroup.card_mul_index ((binaryDihedralSubgroup 2).subgroupOf binaryTetrahedralSubgroup)
  let e := Subgroup.subgroupOfEquivOfLe binaryDihedralSubgroup_two_le_binaryTetrahedralSubgroup
  have hcard :
      Nat.card ((binaryDihedralSubgroup 2).subgroupOf binaryTetrahedralSubgroup) = 8 := by
    rw [Nat.card_congr e.toEquiv, natCard_binaryDihedralSubgroup 2]
  rw [hcard, natCard_binaryTetrahedralSubgroup] at hmul
  omega

private noncomputable def cosetMap (p : Fin 3 × binaryDihedralSubgroup 2) :
    binaryTetrahedralSubgroup :=
  ⟨binaryTetrahedralGenerator ^ p.1.val * (p.2 : SU2),
    mul_mem (pow_mem binaryTetrahedralGenerator_mem_binaryTetrahedralSubgroup p.1.val)
      (binaryDihedralSubgroup_two_le_binaryTetrahedralSubgroup p.2.2)⟩

private theorem cosetMap_injective : Function.Injective cosetMap := by
  have hstep : ∀ {i j : ℕ} {q₁ q₂ : binaryDihedralSubgroup 2},
      i < j → j < 3 →
        binaryTetrahedralGenerator ^ i * (q₁ : SU2) =
          binaryTetrahedralGenerator ^ j * (q₂ : SU2) → False := by
    intro i j q₁ q₂ hij hj3 heq
    have hpow : binaryTetrahedralGenerator ^ (j - i) = (q₁ : SU2) * (q₂ : SU2)⁻¹ := by
      have hj : j = i + (j - i) := (Nat.add_sub_of_le hij.le).symm
      have heq' : binaryTetrahedralGenerator ^ i * (q₁ : SU2) =
          binaryTetrahedralGenerator ^ i *
            (binaryTetrahedralGenerator ^ (j - i) * (q₂ : SU2)) := by
        rw [← mul_assoc, ← pow_add, ← hj]
        exact heq
      exact eq_mul_inv_of_mul_eq (mul_left_cancel heq').symm
    have hmem : binaryTetrahedralGenerator ^ (j - i) ∈ binaryDihedralSubgroup 2 := by
      rw [hpow]
      exact mul_mem q₁.2 (inv_mem q₂.2)
    have hdiff : j - i = 1 ∨ j - i = 2 := by omega
    rcases hdiff with h1 | h2
    · rw [h1, pow_one] at hmem
      exact binaryTetrahedralGenerator_notMem_binaryDihedralSubgroup_two hmem
    · rw [h2] at hmem
      exact binaryTetrahedralGenerator_sq_notMem_binaryDihedralSubgroup_two hmem
  rintro ⟨k₁, q₁⟩ ⟨k₂, q₂⟩ h
  have hval : binaryTetrahedralGenerator ^ k₁.val * (q₁ : SU2) =
      binaryTetrahedralGenerator ^ k₂.val * (q₂ : SU2) :=
    congrArg Subtype.val h
  rcases lt_trichotomy k₁.val k₂.val with hlt | heq | hgt
  · exact False.elim (hstep hlt k₂.isLt hval)
  · have hfin : k₁ = k₂ := Fin.ext heq
    subst hfin
    exact Prod.ext rfl (Subtype.ext (mul_left_cancel hval))
  · exact False.elim (hstep hgt k₁.isLt hval.symm)

private theorem cosetMap_bijective : Function.Bijective cosetMap := by
  refine (Nat.bijective_iff_injective_and_card _).mpr ⟨cosetMap_injective, ?_⟩
  rw [Nat.card_prod, Nat.card_eq_fintype_card, Fintype.card_fin,
    natCard_binaryDihedralSubgroup 2, natCard_binaryTetrahedralSubgroup]

/-- **Coset normal forms in `binaryTetrahedralSubgroup` over `Q₈`.** Every element is `t ^ k * q`
for some `k < 3` and `q ∈ binaryDihedralSubgroup 2`. -/
theorem mem_binaryTetrahedralSubgroup_iff_exists_coset {g : SU2} :
    g ∈ binaryTetrahedralSubgroup ↔
      ∃ k < 3, ∃ q ∈ binaryDihedralSubgroup 2, g = binaryTetrahedralGenerator ^ k * q := by
  constructor
  · intro hg
    obtain ⟨⟨k, q⟩, hkq⟩ := cosetMap_bijective.2 ⟨g, hg⟩
    exact ⟨k.val, k.isLt, (q : SU2), q.2, (congrArg Subtype.val hkq).symm⟩
  · rintro ⟨k, -, q, hq, rfl⟩
    exact mul_mem (pow_mem binaryTetrahedralGenerator_mem_binaryTetrahedralSubgroup k)
      (binaryDihedralSubgroup_two_le_binaryTetrahedralSubgroup hq)

/-- **The binary tetrahedral subgroup is generated by `r = binaryDihedralRotation 2` and
`t = binaryTetrahedralGenerator`.** -/
theorem binaryTetrahedralSubgroup_eq_closure :
    binaryTetrahedralSubgroup =
      Subgroup.closure {binaryDihedralRotation 2, binaryTetrahedralGenerator} := by
  have hr : binaryDihedralRotation 2 ∈
      Subgroup.closure ({binaryDihedralRotation 2, binaryTetrahedralGenerator} : Set SU2) :=
    Subgroup.subset_closure (by simp)
  have ht : binaryTetrahedralGenerator ∈
      Subgroup.closure ({binaryDihedralRotation 2, binaryTetrahedralGenerator} : Set SU2) :=
    Subgroup.subset_closure (by simp)
  have hs : weylElement⁻¹ ∈
      Subgroup.closure ({binaryDihedralRotation 2, binaryTetrahedralGenerator} : Set SU2) := by
    rw [← binaryTetrahedralGenerator_conj_binaryDihedralRotation_two]
    exact mul_mem (mul_mem ht hr) (inv_mem ht)
  have hQ8 : binaryDihedralSubgroup 2 ≤
      Subgroup.closure ({binaryDihedralRotation 2, binaryTetrahedralGenerator} : Set SU2) := by
    rw [binaryDihedralSubgroup_eq_closure 2, Subgroup.closure_le,
      Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨hr, hs⟩
  refine le_antisymm (fun g hg => ?_) ?_
  · obtain ⟨k, -, q, hq, rfl⟩ := mem_binaryTetrahedralSubgroup_iff_exists_coset.mp hg
    exact mul_mem (pow_mem ht k) (hQ8 hq)
  · rw [Subgroup.closure_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨binaryDihedralSubgroup_two_le_binaryTetrahedralSubgroup
      (binaryDihedralRotation_mem_binaryDihedralSubgroup 2),
      binaryTetrahedralGenerator_mem_binaryTetrahedralSubgroup⟩

/-- The binary tetrahedral subgroup is also generated by `{r, s, t}`. -/
theorem binaryTetrahedralSubgroup_eq_closure_three :
    binaryTetrahedralSubgroup =
      Subgroup.closure {binaryDihedralRotation 2, weylElement⁻¹, binaryTetrahedralGenerator} := by
  refine le_antisymm ?_ ?_
  · rw [binaryTetrahedralSubgroup_eq_closure]
    exact Subgroup.closure_mono (by intro x hx; simp at hx ⊢; tauto)
  · rw [Subgroup.closure_le]
    rintro g (rfl | rfl | rfl)
    · exact binaryDihedralSubgroup_two_le_binaryTetrahedralSubgroup
        (binaryDihedralRotation_mem_binaryDihedralSubgroup 2)
    · exact binaryDihedralSubgroup_two_le_binaryTetrahedralSubgroup
        (inv_mem (weylElement_mem_binaryDihedralSubgroup 2))
    · exact binaryTetrahedralGenerator_mem_binaryTetrahedralSubgroup

/-- `binaryTetrahedralSubgroup` normalizes `binaryDihedralSubgroup 2` in `SU(2)`. -/
theorem binaryTetrahedralSubgroup_le_normalizer_binaryDihedralSubgroup_two :
    binaryTetrahedralSubgroup ≤ Subgroup.normalizer (binaryDihedralSubgroup 2 : Set SU2) := by
  rw [binaryTetrahedralSubgroup_eq_closure, Subgroup.closure_le,
    Set.insert_subset_iff, Set.singleton_subset_iff]
  refine ⟨Subgroup.le_normalizer (binaryDihedralRotation_mem_binaryDihedralSubgroup 2), ?_⟩
  rw [SetLike.mem_coe, Subgroup.mem_normalizer_iff_map_conj_eq, binaryDihedralSubgroup_eq_closure 2,
    MonoidHom.map_closure]
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le, Set.image_subset_iff]
    rintro g (rfl | rfl)
    · simp only [Set.mem_preimage, SetLike.mem_coe, MonoidHom.coe_ofClass, MulAut.conj_apply]
      rw [binaryTetrahedralGenerator_conj_binaryDihedralRotation_two]
      exact Subgroup.subset_closure (by simp)
    · simp only [Set.mem_preimage, SetLike.mem_coe, MonoidHom.coe_ofClass, MulAut.conj_apply]
      rw [binaryTetrahedralGenerator_conj_weylElement_inv]
      exact mul_mem (Subgroup.subset_closure (by simp)) (Subgroup.subset_closure (by simp))
  · rw [Subgroup.closure_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    refine ⟨?_, ?_⟩
    · have hmem :
          MulAut.conj binaryTetrahedralGenerator (binaryDihedralRotation 2 * weylElement⁻¹) ∈
            Subgroup.closure (MulAut.conj binaryTetrahedralGenerator ''
              ({binaryDihedralRotation 2, weylElement⁻¹} : Set SU2)) := by
        rw [map_mul]
        exact mul_mem
          (Subgroup.subset_closure (Set.mem_image_of_mem _ (by simp)))
          (Subgroup.subset_closure (Set.mem_image_of_mem _ (by simp)))
      rw [MulAut.conj_apply, binaryTetrahedralGenerator_conj_mul] at hmem
      exact hmem
    · have hmem :
          MulAut.conj binaryTetrahedralGenerator (binaryDihedralRotation 2) ∈
            Subgroup.closure (MulAut.conj binaryTetrahedralGenerator ''
              ({binaryDihedralRotation 2, weylElement⁻¹} : Set SU2)) :=
        Subgroup.subset_closure (Set.mem_image_of_mem _ (by simp))
      rw [MulAut.conj_apply, binaryTetrahedralGenerator_conj_binaryDihedralRotation_two] at hmem
      exact hmem

/-- **`binaryDihedralSubgroup 2` (`Q₈`) is a normal subgroup of `binaryTetrahedralSubgroup`.** -/
instance : ((binaryDihedralSubgroup 2).subgroupOf binaryTetrahedralSubgroup).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer
    binaryTetrahedralSubgroup_le_normalizer_binaryDihedralSubgroup_two

