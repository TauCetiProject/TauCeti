module

public import TauCeti.RepresentationTheory.SU2.BinaryDihedral

/-!
# The binary tetrahedral subgroup of SU(2)

In unit-quaternion coordinates the **binary tetrahedral group** consists of the 24 points

* `±1`, `±i`, `±j`, `±k`, that is `(±1, 0, 0, 0)` and its coordinate permutations, and
* `(±1 ± i ± j ± k) / 2`.

This file records these points by their doubled coordinates, the finite set
`TauCeti.SU2.binaryTetrahedralCoords` of the 24 integer vectors `(±2, 0, 0, 0)` (and coordinate
permutations) and `(±1, ±1, ±1, ±1)`, and constructs the binary tetrahedral subgroup of the
native matrix group `SU(2)` as the matrices of the quaternions `(v₀ + v₁ i + v₂ j + v₃ k) / 2`
under `Quaternion.toComplexMatrix`, for these `v`.

The doubled coordinate vectors are exactly the integer solutions of `v₀² + v₁² + v₂² + v₃² = 4`
(`TauCeti.SU2.mem_binaryTetrahedralCoords_iff`). So the binary tetrahedral group is the group of
unit quaternions with half-integer coordinates, the units of the Hurwitz order
(`TauCeti.SU2.mem_binaryTetrahedralSubgroup_iff_exists_int`). This is what makes it closed under
multiplication: the four doubled coordinates of each point share a parity, so the doubled
coordinates of a product of two points are even and, halved again, the product has
half-integer coordinates; it has norm one because both factors do.

The 24 points are distinct and exhaust the subgroup
(`TauCeti.SU2.binaryTetrahedralCoordsEquiv`), so the subgroup has exactly 24 elements. It contains
the binary dihedral subgroup of order eight, the quaternion group `{±1, ±i, ±j, ±k}`, and is
generated by its generators `i` and `j` together with the element `ω = (-1 + i + j + k) / 2` of
order three.

## Main definitions

* `TauCeti.SU2.binaryTetrahedralCoords`: the 24 doubled coordinate vectors.
* `TauCeti.SU2.binaryTetrahedralSubgroup`: the binary tetrahedral subgroup of `SU(2)`.
* `TauCeti.SU2.binaryTetrahedralCoordsEquiv`: its parametrization by the doubled coordinates.
* `TauCeti.SU2.binaryTetrahedralOmega`: the element `ω = (-1 + i + j + k) / 2` of order three.

## Main results

* `TauCeti.SU2.mem_binaryTetrahedralSubgroup_iff_exists_int`: the binary tetrahedral subgroup is
  the set of elements of `SU(2)` whose quaternion coordinates are half-integers.
* `TauCeti.SU2.natCard_binaryTetrahedralSubgroup`: it has exactly 24 elements.
* `TauCeti.SU2.binaryDihedralSubgroup_two_le_binaryTetrahedralSubgroup`: it contains the
  quaternion group of order eight.
* `TauCeti.SU2.binaryTetrahedralSubgroup_eq_closure`: it is generated by `i`, `j` and `ω`.

## References

* J. H. Conway and D. A. Smith, *On Quaternions and Octonions*, A K Peters, 2003, Chapter 3 (the
  binary polyhedral groups) and Chapter 5 (the Hurwitz integral quaternions).
-/

public section

namespace TauCeti.SU2

open Quaternion

/-! ### The doubled coordinates -/

/-- The doubled coordinates `2q = (v₀, v₁, v₂, v₃)` of the 24 points `q` of the binary
tetrahedral group: the eight vectors `(±2, 0, 0, 0)` up to coordinate permutation, giving
`±1, ±i, ±j, ±k`, and the sixteen vectors `(±1, ±1, ±1, ±1)`, giving `(±1 ± i ± j ± k) / 2`. -/
def binaryTetrahedralCoords : Finset (Fin 4 → ℤ) :=
  {![2, 0, 0, 0], ![-2, 0, 0, 0], ![0, 2, 0, 0], ![0, -2, 0, 0], ![0, 0, 2, 0], ![0, 0, -2, 0],
    ![0, 0, 0, 2], ![0, 0, 0, -2]} ∪ Fintype.piFinset fun _ => {1, -1}

/-- **The 24 doubled coordinate vectors are distinct.** -/
@[simp]
theorem card_binaryTetrahedralCoords : binaryTetrahedralCoords.card = 24 := by
  decide

/-- **The doubled coordinate vectors are the integer solutions of `v₀² + v₁² + v₂² + v₃² = 4`.** -/
theorem mem_binaryTetrahedralCoords_iff {v : Fin 4 → ℤ} :
    v ∈ binaryTetrahedralCoords ↔ ∑ i, v i ^ 2 = 4 := by
  refine ⟨fun hv => (by decide : ∀ v ∈ binaryTetrahedralCoords, ∑ i, v i ^ 2 = 4) v hv,
    fun hv => ?_⟩
  -- Each coordinate is bounded by `2`, which reduces the claim to a finite check.
  have hb (i : Fin 4) : v i ∈ Finset.Icc (-2 : ℤ) 2 := by
    have hi : v i ^ 2 ≤ 2 ^ 2 := by
      rw [show (2 : ℤ) ^ 2 = 4 by norm_num, ← hv]
      exact Finset.single_le_sum (fun j _ => sq_nonneg (v j)) (Finset.mem_univ i)
    exact Finset.mem_Icc.mpr (abs_le.mp (abs_le_of_sq_le_sq hi (by norm_num)))
  have key : ∀ a ∈ Finset.Icc (-2 : ℤ) 2, ∀ b ∈ Finset.Icc (-2 : ℤ) 2,
      ∀ c ∈ Finset.Icc (-2 : ℤ) 2, ∀ d ∈ Finset.Icc (-2 : ℤ) 2,
        a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2 = 4 → ![a, b, c, d] ∈ binaryTetrahedralCoords := by
    decide
  have hv' := key _ (hb 0) _ (hb 1) _ (hb 2) _ (hb 3) (by simpa [Fin.sum_univ_four] using hv)
  convert hv' using 1
  ext i
  fin_cases i <;> simp

/-- The four doubled coordinates of each point share a parity. -/
private theorem even_iff_even_of_mem_binaryTetrahedralCoords {v : Fin 4 → ℤ}
    (hv : v ∈ binaryTetrahedralCoords) (i : Fin 4) : Even (v i) ↔ Even (v 0) :=
  (by decide : ∀ v ∈ binaryTetrahedralCoords, ∀ i : Fin 4, Even (v i) ↔ Even (v 0)) v hv i

/-! ### Half-integer quaternions -/

/-- The norm of the quaternion `(v₀ + v₁ i + v₂ j + v₃ k) / 2` is a quarter of `∑ vᵢ²`. -/
private theorem normSq_half (v : Fin 4 → ℤ) :
    normSq (⟨v 0 / 2, v 1 / 2, v 2 / 2, v 3 / 2⟩ : ℍ[ℝ]) = ((∑ i, v i ^ 2 : ℤ) : ℝ) / 4 := by
  rw [normSq_def', Fin.sum_univ_four]
  push_cast
  ring

/-- An element of `SU(2)` with half-integer quaternion coordinates has doubled coordinates in the
binary tetrahedral coordinate set, since its quaternion has norm one. -/
private theorem exists_mem_binaryTetrahedralCoords_of_coe_eq {g : SU2} {v : Fin 4 → ℤ}
    (hg : (g : Matrix (Fin 2) (Fin 2) ℂ) = toComplexMatrix ⟨v 0 / 2, v 1 / 2, v 2 / 2, v 3 / 2⟩) :
    ∃ v ∈ binaryTetrahedralCoords,
      (g : Matrix (Fin 2) (Fin 2) ℂ) = toComplexMatrix ⟨v 0 / 2, v 1 / 2, v 2 / 2, v 3 / 2⟩ := by
  have hdet := (Matrix.mem_specialUnitaryGroup_iff.mp g.2).2
  rw [hg, det_toComplexMatrix, normSq_half, ← Complex.ofReal_one, Complex.ofReal_inj,
    div_eq_one_iff_eq four_ne_zero] at hdet
  exact ⟨v, mem_binaryTetrahedralCoords_iff.mpr (by exact_mod_cast hdet), hg⟩

/-- The points of the binary tetrahedral coordinate set give unit quaternions. -/
private theorem toComplexMatrix_mem_of_mem_binaryTetrahedralCoords {v : Fin 4 → ℤ}
    (hv : v ∈ binaryTetrahedralCoords) :
    toComplexMatrix ⟨v 0 / 2, v 1 / 2, v 2 / 2, v 3 / 2⟩ ∈
      Matrix.specialUnitaryGroup (Fin 2) ℂ := by
  refine mem_specialUnitaryGroup_toComplexMatrix ((mem_unitary_iff_normSq_eq_one _).mpr ?_)
  rw [normSq_half, mem_binaryTetrahedralCoords_iff.mp hv]
  norm_num

/-- **Closure under multiplication.** The product of two points of the binary tetrahedral group
is again a half-integer quaternion: the doubled coordinates of each factor share a parity, so
the coordinates of the product of the doubled factors are all even. -/
private theorem exists_mul_eq_half {v w : Fin 4 → ℤ} (hv : v ∈ binaryTetrahedralCoords)
    (hw : w ∈ binaryTetrahedralCoords) :
    ∃ u : Fin 4 → ℤ, (⟨v 0 / 2, v 1 / 2, v 2 / 2, v 3 / 2⟩ : ℍ[ℝ]) *
      ⟨w 0 / 2, w 1 / 2, w 2 / 2, w 3 / 2⟩ = ⟨u 0 / 2, u 1 / 2, u 2 / 2, u 3 / 2⟩ := by
  -- The product of the doubled factors, an integer quaternion with even coordinates.
  set x : ℍ[ℤ] := ⟨v 0, v 1, v 2, v 3⟩ * ⟨w 0, w 1, w 2, w 3⟩ with hx
  have hpv := even_iff_even_of_mem_binaryTetrahedralCoords hv
  have hpw := even_iff_even_of_mem_binaryTetrahedralCoords hw
  have heven : Even x.re ∧ Even x.imI ∧ Even x.imJ ∧ Even x.imK := by
    simp only [hx, re_mul, imI_mul, imJ_mul, imK_mul, Int.even_add, Int.even_sub, Int.even_mul,
      hpv 1, hpv 2, hpv 3, hpw 1, hpw 2, hpw 3]
    tauto
  obtain ⟨⟨a, ha⟩, ⟨b, hb⟩, ⟨c, hc⟩, ⟨d, hd⟩⟩ := heven
  simp only [hx, re_mul, imI_mul, imJ_mul, imK_mul] at ha hb hc hd
  rify at ha hb hc hd
  refine ⟨![a, b, c, d], ?_⟩
  ext <;> simp only [re_mul, imI_mul, imJ_mul, imK_mul, Matrix.cons_val]
  · linear_combination ha / 4
  · linear_combination hb / 4
  · linear_combination hc / 4
  · linear_combination hd / 4

/-! ### The binary tetrahedral subgroup -/

/-- **The binary tetrahedral subgroup of `SU(2)`**: the 24 matrices of the unit quaternions
`±1, ±i, ±j, ±k` and `(±1 ± i ± j ± k) / 2`, that is, of `(v₀ + v₁ i + v₂ j + v₃ k) / 2` for the
doubled coordinate vectors `v` in `TauCeti.SU2.binaryTetrahedralCoords`. -/
noncomputable def binaryTetrahedralSubgroup : Subgroup SU2 where
  carrier := {g | ∃ v ∈ binaryTetrahedralCoords,
    (g : Matrix (Fin 2) (Fin 2) ℂ) = toComplexMatrix ⟨v 0 / 2, v 1 / 2, v 2 / 2, v 3 / 2⟩}
  mul_mem' := by
    rintro g h ⟨v, hv, hg⟩ ⟨w, hw, hh⟩
    obtain ⟨u, hu⟩ := exists_mul_eq_half hv hw
    refine exists_mem_binaryTetrahedralCoords_of_coe_eq (v := u) ?_
    rw [← hu, map_mul, ← hg, ← hh, Submonoid.coe_mul]
  one_mem' := ⟨![2, 0, 0, 0], by decide, by
    rw [OneMemClass.coe_one, ← map_one toComplexMatrix]
    congr 1
    ext <;> simp⟩
  inv_mem' := by
    rintro g ⟨v, -, hg⟩
    refine exists_mem_binaryTetrahedralCoords_of_coe_eq (v := ![v 0, -v 1, -v 2, -v 3]) ?_
    rw [← Matrix.star_eq_inv, Matrix.specialUnitaryGroup.coe_star, hg, ← map_star]
    congr 1
    ext <;> simp [neg_div]

/-- Membership in the binary tetrahedral subgroup: the quaternion coordinates are halves of one
of the 24 doubled coordinate vectors. -/
theorem mem_binaryTetrahedralSubgroup_iff {g : SU2} :
    g ∈ binaryTetrahedralSubgroup ↔ ∃ v ∈ binaryTetrahedralCoords,
      (g : Matrix (Fin 2) (Fin 2) ℂ) = toComplexMatrix ⟨v 0 / 2, v 1 / 2, v 2 / 2, v 3 / 2⟩ :=
  Iff.rfl

/-- **The binary tetrahedral subgroup consists of the unit quaternions with half-integer
coordinates**, the units of the Hurwitz order: an element of `SU(2)` lies in it exactly when its
quaternion coordinates are half-integers. -/
theorem mem_binaryTetrahedralSubgroup_iff_exists_int {g : SU2} :
    g ∈ binaryTetrahedralSubgroup ↔ ∃ v : Fin 4 → ℤ,
      (g : Matrix (Fin 2) (Fin 2) ℂ) = toComplexMatrix ⟨v 0 / 2, v 1 / 2, v 2 / 2, v 3 / 2⟩ :=
  ⟨fun ⟨v, _, hg⟩ => ⟨v, hg⟩, fun ⟨_, hg⟩ => exists_mem_binaryTetrahedralCoords_of_coe_eq hg⟩

/-- The element of the binary tetrahedral subgroup with doubled coordinates `v`. -/
private noncomputable def binaryTetrahedralCoordsFun (v : binaryTetrahedralCoords) :
    binaryTetrahedralSubgroup :=
  ⟨⟨_, toComplexMatrix_mem_of_mem_binaryTetrahedralCoords v.2⟩, v, v.2, rfl⟩

private theorem binaryTetrahedralCoordsFun_bijective :
    Function.Bijective binaryTetrahedralCoordsFun := by
  refine ⟨fun v w hvw => ?_, fun g => ?_⟩
  · have h := toComplexMatrix_injective (congrArg (fun g : binaryTetrahedralSubgroup =>
      ((g : SU2) : Matrix (Fin 2) (Fin 2) ℂ)) hvw)
    simp only [QuaternionAlgebra.mk.injEq, div_left_inj₀ (two_ne_zero' ℝ), Int.cast_inj] at h
    obtain ⟨h0, h1, h2, h3⟩ := h
    ext i
    fin_cases i
    exacts [h0, h1, h2, h3]
  · obtain ⟨v, hv, hg⟩ := g.2
    exact ⟨⟨v, hv⟩, Subtype.ext (Subtype.ext hg.symm)⟩

/-- **The 24 points parametrize the binary tetrahedral subgroup**: the doubled coordinate vector
`v` corresponds to the matrix of `(v₀ + v₁ i + v₂ j + v₃ k) / 2`. -/
noncomputable def binaryTetrahedralCoordsEquiv :
    binaryTetrahedralCoords ≃ binaryTetrahedralSubgroup :=
  Equiv.ofBijective _ binaryTetrahedralCoordsFun_bijective

@[simp]
theorem coe_binaryTetrahedralCoordsEquiv_apply (v : binaryTetrahedralCoords) :
    ((binaryTetrahedralCoordsEquiv v : SU2) : Matrix (Fin 2) (Fin 2) ℂ) =
      toComplexMatrix ⟨(v : Fin 4 → ℤ) 0 / 2, (v : Fin 4 → ℤ) 1 / 2, (v : Fin 4 → ℤ) 2 / 2,
        (v : Fin 4 → ℤ) 3 / 2⟩ := (rfl)

instance : Finite binaryTetrahedralSubgroup :=
  Finite.of_equiv _ binaryTetrahedralCoordsEquiv

/-- **The binary tetrahedral subgroup has exactly 24 elements.** -/
@[simp]
theorem natCard_binaryTetrahedralSubgroup : Nat.card binaryTetrahedralSubgroup = 24 := by
  rw [← Nat.card_congr binaryTetrahedralCoordsEquiv, Nat.card_eq_fintype_card,
    Fintype.card_coe, card_binaryTetrahedralCoords]

/-! ### The quaternion group inside the binary tetrahedral group -/

/-- **The binary tetrahedral subgroup contains the quaternion group** `{±1, ±i, ±j, ±k}`, the
binary dihedral subgroup of order eight, generated by `i = diag (I, -I)` and `j = !![0, 1; -1, 0]`.
-/
theorem binaryDihedralSubgroup_two_le_binaryTetrahedralSubgroup :
    binaryDihedralSubgroup 2 ≤ binaryTetrahedralSubgroup := by
  rw [binaryDihedralSubgroup_eq_closure, Subgroup.closure_le, Set.insert_subset_iff,
    Set.singleton_subset_iff]
  refine ⟨⟨![0, 2, 0, 0], by decide, ?_⟩, ⟨![0, 0, 2, 0], by decide, ?_⟩⟩
  · rw [coe_binaryDihedralRotation_eq_toComplexMatrix]
    congr 1
    ext <;> simp
  · rw [coe_weylElement_inv_eq_toComplexMatrix]
    congr 1
    ext <;> simp

/-! ### Generators -/

/-- The element `ω = (-1 + i + j + k) / 2` of the binary tetrahedral group, of order three. -/
noncomputable def binaryTetrahedralOmega : SU2 :=
  ⟨toComplexMatrix ⟨-1 / 2, 1 / 2, 1 / 2, 1 / 2⟩,
    mem_specialUnitaryGroup_toComplexMatrix
      ((mem_unitary_iff_normSq_eq_one _).mpr (by rw [normSq_def']; norm_num))⟩

/-- The matrix of `ω` is that of the quaternion `(-1 + i + j + k) / 2`. -/
theorem coe_binaryTetrahedralOmega :
    (binaryTetrahedralOmega : Matrix (Fin 2) (Fin 2) ℂ) =
      toComplexMatrix ⟨-1 / 2, 1 / 2, 1 / 2, 1 / 2⟩ := (rfl)

@[simp]
theorem binaryTetrahedralOmega_mem_binaryTetrahedralSubgroup :
    binaryTetrahedralOmega ∈ binaryTetrahedralSubgroup := by
  refine ⟨![-1, 1, 1, 1], by decide, ?_⟩
  rw [coe_binaryTetrahedralOmega]
  congr 1
  ext <;> simp [neg_div]

/-- The element `ω = (-1 + i + j + k) / 2` is a cube root of unity. -/
theorem binaryTetrahedralOmega_pow_three : binaryTetrahedralOmega ^ 3 = 1 := by
  apply Subtype.ext
  rw [SubmonoidClass.coe_pow, coe_binaryTetrahedralOmega, ← map_pow, OneMemClass.coe_one,
    ← map_one toComplexMatrix]
  congr 1
  ext <;> norm_num [pow_succ]

/-- The element `ω = (-1 + i + j + k) / 2` has order three. -/
@[simp]
theorem orderOf_binaryTetrahedralOmega : orderOf binaryTetrahedralOmega = 3 := by
  refine orderOf_eq_prime binaryTetrahedralOmega_pow_three fun h => ?_
  have h' : toComplexMatrix ⟨-1 / 2, 1 / 2, 1 / 2, 1 / 2⟩ = toComplexMatrix 1 := by
    rw [map_one, ← coe_binaryTetrahedralOmega, h, OneMemClass.coe_one]
  have := congrArg QuaternionAlgebra.re (toComplexMatrix_injective h')
  norm_num at this

/-- **The binary tetrahedral subgroup is generated by `i`, `j` and `ω = (-1 + i + j + k) / 2`**,
that is, by the generators `r` and `s` of the quaternion group of order eight together with an
element of order three. -/
theorem binaryTetrahedralSubgroup_eq_closure :
    binaryTetrahedralSubgroup = Subgroup.closure
      {binaryDihedralRotation 2, weylElement⁻¹, binaryTetrahedralOmega} := by
  set H := Subgroup.closure {binaryDihedralRotation 2, weylElement⁻¹, binaryTetrahedralOmega}
  have hle : H ≤ binaryTetrahedralSubgroup := by
    rw [Subgroup.closure_le, Set.insert_subset_iff, Set.insert_subset_iff,
      Set.singleton_subset_iff]
    exact ⟨binaryDihedralSubgroup_two_le_binaryTetrahedralSubgroup
        (binaryDihedralRotation_mem_binaryDihedralSubgroup 2),
      binaryDihedralSubgroup_two_le_binaryTetrahedralSubgroup
        (inv_mem (weylElement_mem_binaryDihedralSubgroup 2)),
      binaryTetrahedralOmega_mem_binaryTetrahedralSubgroup⟩
  have : Finite H := Finite.of_injective _ (Subgroup.inclusion_injective hle)
  -- The order of `H` is divisible by the order eight of the quaternion group and by three.
  have h8 : 8 ∣ Nat.card H := by
    have hQ : binaryDihedralSubgroup 2 ≤ H := by
      rw [binaryDihedralSubgroup_eq_closure]
      exact Subgroup.closure_mono (Set.insert_subset_insert (Set.singleton_subset_iff.mpr
        (Set.mem_insert _ _)))
    simpa using Subgroup.card_dvd_of_le hQ
  have h3 : 3 ∣ Nat.card H := by
    simpa using H.orderOf_dvd_natCard (Subgroup.subset_closure (by simp) :
      binaryTetrahedralOmega ∈ H)
  refine (Subgroup.eq_of_le_of_card_ge hle ?_).symm
  rw [natCard_binaryTetrahedralSubgroup]
  exact Nat.le_of_dvd Nat.card_pos (Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) h8 h3)

end TauCeti.SU2
