module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import TauCeti.Analysis.Complex.RootsOfUnity.Circle
public import TauCeti.RepresentationTheory.SU2.Basic

/-!
# Concrete cyclic subgroups of SU(2)

The diagonal embedding of the circle sends the standard character of `ZMod n` to the
cyclic subgroup generated by `diag (exp (2πi/n), exp (-2πi/n))`. We construct this as an
actual subgroup of the native matrix group, identify it with `Multiplicative (ZMod n)`,
and prove that both its order and the order of the displayed generator are exactly `n`.
The parameter is nonzero; `n = 1` gives the trivial subgroup.

Membership is characterized as membership in the diagonal torus together with `g ^ n = 1`.
Consequently these are precisely the finite subgroups of the diagonal torus, indexed by
order. This makes the concrete models usable after conjugating a finite subgroup into a torus.

The circle parameter and its exponential formula are Mathlib's `ZMod.toCircle`; the matrix
embedding is `TauCeti.SU2.torusHom`.
-/

public section

namespace TauCeti.SU2

open scoped Real

variable (n : ℕ) [NeZero n]

/-- The diagonal embedding of the cyclic group of order `n` into `SU(2)`. -/
noncomputable def cyclicHom : Multiplicative (ZMod n) →* SU2 :=
  torusHom.comp ZMod.toCircle.toMonoidHom

@[simp]
theorem cyclicHom_apply (j : Multiplicative (ZMod n)) :
    cyclicHom n j = torusHom (ZMod.toCircle j.toAdd) := (rfl)

/-- The cyclic embedding is faithful. -/
theorem cyclicHom_injective : Function.Injective (cyclicHom n) := by
  intro j k h
  exact Multiplicative.toAdd.injective
    (ZMod.injective_toCircle (torusHom_injective (by simpa using h)))

/-- The standard generator, with diagonal entries `exp (2πi/n)` and `exp (-2πi/n)`. -/
noncomputable def cyclicGenerator : SU2 := cyclicHom n (Multiplicative.ofAdd 1)

/-- The standard generator is the image of the unit cyclic coordinate. -/
theorem cyclicGenerator_def :
    cyclicGenerator n = cyclicHom n (Multiplicative.ofAdd 1) := (rfl)

/-- The actual matrix of the standard cyclic generator. -/
theorem coe_cyclicGenerator :
    (cyclicGenerator n : Matrix (Fin 2) (Fin 2) ℂ) =
      Matrix.diagonal ![Complex.exp (2 * π * Complex.I / n),
        Complex.exp (-(2 * π * Complex.I / n))] := by
  have h : (ZMod.toCircle (1 : ZMod n) : ℂ) =
      Complex.exp (2 * π * Complex.I / n) := by
    simpa using ZMod.toCircle_natCast (N := n) 1
  simp only [cyclicGenerator, cyclicHom_apply, coe_torusHom]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [h, Complex.exp_neg]

/-- The standard diagonal generator has exact order `n`, including at `n = 1`. -/
@[simp]
theorem orderOf_cyclicGenerator : orderOf (cyclicGenerator n) = n := by
  simpa [cyclicGenerator, orderOf_ofAdd_eq_addOrderOf] using
    (orderOf_injective (cyclicHom n) (cyclicHom_injective n) (Multiplicative.ofAdd 1)).trans
      (ZMod.addOrderOf_one n)

/-- The concrete diagonal cyclic subgroup of order `n`. -/
noncomputable def cyclicSubgroup : Subgroup SU2 := (cyclicHom n).range

/-- The concrete cyclic subgroup, with its specified coordinate parametrization. -/
noncomputable def cyclicEquiv : Multiplicative (ZMod n) ≃* cyclicSubgroup n :=
  MonoidHom.ofInjective (cyclicHom_injective n)

@[simp]
theorem coe_cyclicEquiv (j : Multiplicative (ZMod n)) :
    (cyclicEquiv n j : SU2) = cyclicHom n j := (rfl)

instance : Finite (cyclicSubgroup n) := Finite.of_equiv _ (cyclicEquiv n).toEquiv

/-- The concrete cyclic subgroup has exactly `n` elements. -/
@[simp]
theorem natCard_cyclicSubgroup : Nat.card (cyclicSubgroup n) = n := by
  rw [← Nat.card_congr (cyclicEquiv n).toEquiv]
  simp

/-- Membership in the cyclic subgroup is given by the standard circle character. -/
theorem mem_cyclicSubgroup_iff {g : SU2} :
    g ∈ cyclicSubgroup n ↔ ∃ j : ZMod n, torusHom (ZMod.toCircle j) = g := by
  simp [cyclicSubgroup, MonoidHom.mem_range, Multiplicative.ofAdd.surjective.exists]

/-- The cyclic subgroup lies in the diagonal maximal torus. -/
theorem cyclicSubgroup_le_torus : cyclicSubgroup n ≤ torus := by
  rintro _ ⟨j, rfl⟩
  exact torusHom_mem_torus _

/-- The cyclic subgroup is generated by the displayed exponential matrix. -/
theorem cyclicSubgroup_eq_zpowers :
    cyclicSubgroup n = Subgroup.zpowers (cyclicGenerator n) := by
  symm
  apply Subgroup.eq_of_le_of_card_ge
  · exact Subgroup.zpowers_le.mpr ⟨Multiplicative.ofAdd 1, rfl⟩
  · simp [Nat.card_zpowers]

instance : IsCyclic (cyclicSubgroup n) := by
  rw [cyclicSubgroup_eq_zpowers]
  infer_instance

/-- The diagonal cyclic subgroup consists exactly of the torus elements killed by `n`. -/
theorem mem_cyclicSubgroup_iff_mem_torus_and_pow_eq_one {g : SU2} :
    g ∈ cyclicSubgroup n ↔ g ∈ torus ∧ g ^ n = 1 := by
  constructor
  · intro hg
    refine ⟨cyclicSubgroup_le_torus n hg, ?_⟩
    simpa using congrArg Subtype.val
      (pow_card_eq_one' (x := (⟨g, hg⟩ : cyclicSubgroup n)))
  · rintro ⟨hg, hz⟩
    obtain ⟨z, rfl⟩ := mem_torus_iff_exists_torusHom.mp hg
    have hzn : z ^ n = 1 := torusHom_injective (by simpa using hz)
    obtain ⟨j, hj⟩ := ZMod.exists_toCircle_eq_of_pow_eq_one hzn
    exact (mem_cyclicSubgroup_iff n).2 ⟨j, congrArg torusHom hj⟩

/-- The parameter-one cyclic model is the trivial subgroup. -/
@[simp]
theorem cyclicSubgroup_one : cyclicSubgroup 1 = ⊥ := by
  ext g
  simp only [mem_cyclicSubgroup_iff_mem_torus_and_pow_eq_one, pow_one, Subgroup.mem_bot]
  exact ⟨And.right, fun h => by subst g; exact ⟨torus.one_mem, rfl⟩⟩

end TauCeti.SU2

namespace Subgroup

open TauCeti TauCeti.SU2

/-- Every finite subgroup of the diagonal torus is the concrete cyclic model of its order. -/
theorem eq_SU2_cyclicSubgroup_of_le_torus (H : Subgroup SU2) [Finite H] (hH : H ≤ torus) :
    H = cyclicSubgroup (Nat.card H) := by
  have hle : H ≤ cyclicSubgroup (Nat.card H) := by
    intro g hg
    apply (mem_cyclicSubgroup_iff_mem_torus_and_pow_eq_one _).2
    exact ⟨hH hg, congrArg Subtype.val (pow_card_eq_one' (x := (⟨g, hg⟩ : H)))⟩
  exact Subgroup.eq_of_le_of_card_ge hle (by simp)

end Subgroup
