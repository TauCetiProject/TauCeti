/-!
# The Lie algebra of `SU(2)` in the basis `-iσₐ/2`

The Lie algebra `𝔰𝔲(2)` of `SU(2)` (`TauCeti.SU2.lieAlgebra`, the Lie algebra of the special
unitary subgroup of the real Lie group `GL(2, ℂ)`) consists, in matrix coordinates
(`TauCeti.SU2.toMatrix`), of the trace-free skew-Hermitian `2 × 2` matrices. This file fixes its
standard normalization: the basis

`-iσ₁/2, -iσ₂/2, -iσ₃/2`,

where `σₐ` are the Pauli matrices, that is, the isomorphism
`TauCeti.suTwoEquiv : ℝ³ ≃ 𝔰𝔲(2)`, `x ↦ -(i/2) (x₀ σ₁ + x₁ σ₂ + x₂ σ₃)`. In this basis:

* the bracket is the cross product, `⁅suTwoEquiv x, suTwoEquiv y⁆ = suTwoEquiv (x ⨯₃ y)`
  (`TauCeti.lie_suTwoEquiv`), so `𝔰𝔲(2)` is isomorphic to `so(3)` with `-iσₐ/2` corresponding
  to the infinitesimal rotation about the `a`-th axis (`TauCeti.suTwoLieEquivSoThree`);
* the basis is orthonormal for the invariant form `B(X, Y) = -2 tr(XY)`
  (`TauCeti.trace_toMatrix_suTwoEquiv_mul`); the dot product therefore identifies `ℝ³` with the
  dual `𝔰𝔲(2)*` (`TauCeti.suTwoDualEquiv`), compatibly with the identification of `so(3)*`
  (`TauCeti.soThreeDualEquiv_comp_suTwoLieEquivSoThree`);
* the coadjoint action is the infinitesimal rotation `n ↦ ξ ⨯₃ n`
  (`TauCeti.lie_suTwoEquiv_suTwoDualEquiv`) and the Kirillov–Kostant–Souriau form at `ν_n` is the
  triple product `n ⬝ᵥ (ξ ⨯₃ η)` (`TauCeti.kksForm_suTwoDualEquiv_mk`), exactly as for `so(3)`.
  So in these coordinates the coadjoint orbit models of `𝔰𝔲(2)` and `so(3)`, and their KKS forms,
  are literally the same, and the normalization of the KKS form on the spheres is unchanged;
* the adjoint action of a unitary matrix `U` is the rotation `pauliRotation U`
  (`TauCeti.Ad_toUnits_suTwoEquiv`); for `U ∈ SU(2)` this is the double cover
  `SU(2) → SO(3)`.

The two groups differ in their global normalization. The one-parameter subgroup generated by
`-iσ₃/2` is the maximal torus, `exp (t (-iσ₃/2)) = diag (e^{-it/2}, e^{it/2})`
(`TauCeti.coe_lieExp_smul_suTwoEquiv_single_two`), so in `SU(2)` this generator has period `4π`
(`TauCeti.lieExp_smul_suTwoEquiv_single_two_eq_one_iff`), and reaches the central element `-1` at
time `2π`; its image in `SO(3)`, the rotation about the third axis, has period `2π`
(`TauCeti.toSO3_eq_one_iff_of_coe_eq_lieExp`).

## References

* J. E. Marsden and T. S. Ratiu, *Introduction to Mechanics and Symmetry*, second edition, Texts
  in Applied Mathematics 17, Springer, 1999, Chapters 9 and 14 (`SU(2)`, `SO(3)`, the hat map and
  their coadjoint orbits).
-/

public section

open Manifold Matrix Module Complex
open scoped ContDiff Manifold Matrix.Norms.Operator

noncomputable section

namespace TauCeti

attribute [local instance 100] LieRing.ofAssociativeRing

-- Select the matrix topology underlying the operator norm used for the general linear Lie group,
-- together with continuity of the conjugate transpose for it, and the rational algebra structure
-- under which the Lie exponential of `GL(2, ℂ)` is the Banach-algebra exponential.
attribute [local instance] Matrix.linftyOpTopologicalSpace Matrix.linftyOpContinuousStar
  TauCeti.normedAlgebraRatOfReal

namespace SU2

/-- The Lie algebra `𝔰𝔲(2)` of `SU(2)`: the Lie algebra of the special unitary subgroup of the real
Lie group `GL(2, ℂ)`. -/
abbrev lieAlgebra :
    LieSubalgebra ℝ (LeftInvariantDerivation 𝓘(ℝ, Matrix (Fin 2) (Fin 2) ℂ)
      (Matrix (Fin 2) (Fin 2) ℂ)ˣ) :=
  Lie.lieSubalgebraOfSubgroup (GLSpecialUnitary (Fin 2) ℂ : Subgroup (Matrix (Fin 2) (Fin 2) ℂ)ˣ)

/-- The matrix coordinates of `𝔰𝔲(2)`, as an injective homomorphism of real Lie algebras into the
`2 × 2` complex matrices with their commutator bracket. Its range is the trace-free
skew-Hermitian matrices (`TauCeti.SU2.exists_toMatrix_eq_iff`). -/
def toMatrix : lieAlgebra →ₗ⁅ℝ⁆ Matrix (Fin 2) (Fin 2) ℂ :=
  (Lie.unitsLieAlgebraLieEquiv (R := Matrix (Fin 2) (Fin 2) ℂ) :
    LeftInvariantDerivation 𝓘(ℝ, Matrix (Fin 2) (Fin 2) ℂ) (Matrix (Fin 2) (Fin 2) ℂ)ˣ →ₗ⁅ℝ⁆
      Matrix (Fin 2) (Fin 2) ℂ).comp lieAlgebra.incl

/-- The matrix coordinates of `X` are its image under the canonical identification of the Lie
algebra of `GL(2, ℂ)` with the `2 × 2` complex matrices. -/
theorem toMatrix_apply (X : lieAlgebra) :
    toMatrix X = unitsLieAlgebraEquiv (R := Matrix (Fin 2) (Fin 2) ℂ)
      (X : LeftInvariantDerivation 𝓘(ℝ, Matrix (Fin 2) (Fin 2) ℂ) (Matrix (Fin 2) (Fin 2) ℂ)ˣ) :=
  Lie.unitsLieAlgebraLieEquiv_apply _

/-- An element of `𝔰𝔲(2)` is determined by its matrix coordinates. -/
theorem toMatrix_injective : Function.Injective toMatrix := fun X Y h ↦ by
  rw [toMatrix_apply, toMatrix_apply] at h
  exact Subtype.ext ((unitsLieAlgebraEquiv (R := Matrix (Fin 2) (Fin 2) ℂ)).injective h)

/-- **The matrices of `𝔰𝔲(2)` are the trace-free skew-Hermitian matrices.** -/
theorem exists_toMatrix_eq_iff (A : Matrix (Fin 2) (Fin 2) ℂ) :
    (∃ X, toMatrix X = A) ↔ Aᴴ = -A ∧ A.trace = 0 := by
  rw [← Lie.unitsLieAlgebraLieEquiv_symm_mem_GLSpecialUnitary_lieSubalgebra_iff,
    Lie.unitsLieAlgebraLieEquiv_symm_apply]
  refine ⟨?_, fun hA ↦ ⟨⟨_, hA⟩, ?_⟩⟩
  · rintro ⟨X, rfl⟩
    rw [toMatrix_apply, LinearEquiv.symm_apply_apply]
    exact X.2
  · rw [toMatrix_apply, LinearEquiv.apply_symm_apply]

/-- The matrix coordinates of an element of `𝔰𝔲(2)` are skew-Hermitian. -/
@[simp]
theorem conjTranspose_toMatrix (X : lieAlgebra) : (toMatrix X)ᴴ = -toMatrix X :=
  ((exists_toMatrix_eq_iff _).1 ⟨X, rfl⟩).1

/-- The matrix coordinates of an element of `𝔰𝔲(2)` are trace-free. -/
@[simp]
theorem trace_toMatrix (X : lieAlgebra) : (toMatrix X).trace = 0 :=
  ((exists_toMatrix_eq_iff _).1 ⟨X, rfl⟩).2

end SU2

/-- The matrix `-(i/2) • pauli x` is skew-Hermitian. -/
private theorem conjTranspose_smul_pauli (x : Fin 3 → ℝ) :
    ((-(I / 2)) • pauli x)ᴴ = -((-(I / 2)) • pauli x) := by
  rw [conjTranspose_smul, (isHermitian_pauli x).eq]
  simp [neg_div]

/-- The matrices `-(i/2) • pauli x` satisfy the cross-product commutator relation. -/
private theorem smul_pauli_mul_sub_mul_smul_pauli (x y : Fin 3 → ℝ) :
    (-(I / 2)) • pauli x * (-(I / 2)) • pauli y - (-(I / 2)) • pauli y * (-(I / 2)) • pauli x =
      (-(I / 2)) • pauli (x ⨯₃ y) := by
  rw [smul_mul_smul_comm, smul_mul_smul_comm, ← smul_sub, pauli_mul_sub_mul_pauli, smul_smul]
  congr 1
  linear_combination (I / 2) * I_sq

/-! ### The basis `-iσₐ/2` -/

/-- The matrix `-(i/2) • pauli x` is the matrix of an element of `𝔰𝔲(2)`. -/
private theorem unitsLieAlgebraEquiv_symm_smul_pauli_mem (x : Fin 3 → ℝ) :
    (unitsLieAlgebraEquiv (R := Matrix (Fin 2) (Fin 2) ℂ)).symm ((-(I / 2)) • pauli x) ∈
      SU2.lieAlgebra := by
  rw [← Lie.unitsLieAlgebraLieEquiv_symm_apply,
    Lie.unitsLieAlgebraLieEquiv_symm_mem_GLSpecialUnitary_lieSubalgebra_iff]
  exact ⟨conjTranspose_smul_pauli x, by rw [trace_smul, trace_pauli, smul_zero]⟩

/-- The isomorphism `x ↦ -(i/2) (x₀ σ₁ + x₁ σ₂ + x₂ σ₃)` from `ℝ³` onto the Lie algebra of
`SU(2)`. It sends the standard basis to `-iσₐ/2` (`TauCeti.toMatrix_suTwoEquiv`) and carries the
cross product to the bracket (`TauCeti.lie_suTwoEquiv`). -/
def suTwoEquiv : (Fin 3 → ℝ) ≃ₗ[ℝ] SU2.lieAlgebra where
  toFun x := ⟨_, unitsLieAlgebraEquiv_symm_smul_pauli_mem x⟩
  map_add' x y := Subtype.ext <| by simp only [map_add, smul_add, AddMemClass.coe_add]
  map_smul' c x := Subtype.ext <| by
    simp only [map_smul, smul_comm _ c, RingHom.id_apply, SetLike.val_smul]
  invFun X := pauliCoord ((2 * I) • SU2.toMatrix X)
  left_inv x := by
    dsimp only
    rw [SU2.toMatrix_apply, LinearEquiv.apply_symm_apply, smul_smul,
      show 2 * I * -(I / 2) = 1 by linear_combination -I_sq, one_smul, pauliCoord_pauli]
  right_inv X := by
    refine SU2.toMatrix_injective ?_
    rw [SU2.toMatrix_apply, SU2.toMatrix_apply, LinearEquiv.apply_symm_apply, ← SU2.toMatrix_apply,
      pauli_pauliCoord, smul_smul, show -(I / 2) * (2 * I) = 1 by linear_combination -I_sq,
      one_smul]
    · rw [IsHermitian, conjTranspose_smul, SU2.conjTranspose_toMatrix, smul_neg, ← neg_smul]
      simp
    · rw [trace_smul, SU2.trace_toMatrix, smul_zero]

/-- The matrix coordinates of `suTwoEquiv x` are `-(i/2) • pauli x`; in particular `suTwoEquiv`
sends the standard basis vector `eₐ` to `-iσₐ/2`. -/
@[simp]
theorem toMatrix_suTwoEquiv (x : Fin 3 → ℝ) :
    SU2.toMatrix (suTwoEquiv x) = (-(I / 2)) • pauli x := by
  rw [SU2.toMatrix_apply]
  exact LinearEquiv.apply_symm_apply _ _

/-- **The bracket of `𝔰𝔲(2)` is the cross product** in the basis `-iσₐ/2`. -/
@[simp]
theorem lie_suTwoEquiv (x y : Fin 3 → ℝ) :
    ⁅suTwoEquiv x, suTwoEquiv y⁆ = suTwoEquiv (x ⨯₃ y) := by
  refine SU2.toMatrix_injective ?_
  rw [LieHom.map_lie, toMatrix_suTwoEquiv, toMatrix_suTwoEquiv, toMatrix_suTwoEquiv, Ring.lie_def,
    smul_pauli_mul_sub_mul_smul_pauli]

/-- **The basis `-iσₐ/2` is orthonormal for `B(X, Y) = -2 tr(XY)`**:
`tr (X Y) = -(x ⬝ᵥ y) / 2` for `X = suTwoEquiv x` and `Y = suTwoEquiv y`. -/
theorem trace_toMatrix_suTwoEquiv_mul (x y : Fin 3 → ℝ) :
    (SU2.toMatrix (suTwoEquiv x) * SU2.toMatrix (suTwoEquiv y)).trace =
      -((x ⬝ᵥ y : ℝ) : ℂ) / 2 := by
  rw [toMatrix_suTwoEquiv, toMatrix_suTwoEquiv, smul_mul_smul_comm, trace_smul,
    trace_pauli_mul_pauli, smul_eq_mul]
  linear_combination ((x ⬝ᵥ y : ℝ) : ℂ) / 2 * I_sq

/-- The Lie algebra `𝔰𝔲(2)` has dimension `3`. -/
theorem SU2.finrank_lieAlgebra : finrank ℝ SU2.lieAlgebra = 3 := by
  rw [← suTwoEquiv.finrank_eq, finrank_fin_fun]

/-! ### The isomorphism with `so(3)` -/

/-- The isomorphism of real Lie algebras `𝔰𝔲(2) ≃ so(3)` sending `-iσₐ/2` to the infinitesimal
rotation `êₐ` about the `a`-th coordinate axis: both brackets are the cross product
(`TauCeti.lie_suTwoEquiv`, `TauCeti.lie_soThreeEquiv`). -/
def suTwoLieEquivSoThree : SU2.lieAlgebra ≃ₗ⁅ℝ⁆ LieAlgebra.Orthogonal.so (Fin 3) ℝ :=
  { suTwoEquiv.symm.trans (soThreeEquiv ℝ) with
    map_lie' := fun {X Y} ↦ by
      obtain ⟨x, rfl⟩ := suTwoEquiv.surjective X
      obtain ⟨y, rfl⟩ := suTwoEquiv.surjective Y
      simp }

/-- The isomorphism `𝔰𝔲(2) ≃ so(3)` sends `suTwoEquiv x` to the hat matrix of `x`. -/
@[simp]
theorem suTwoLieEquivSoThree_suTwoEquiv (x : Fin 3 → ℝ) :
    suTwoLieEquivSoThree (suTwoEquiv x) = soThreeEquiv ℝ x :=
  congrArg (soThreeEquiv ℝ) (suTwoEquiv.symm_apply_apply x)

/-! ### The dual of `𝔰𝔲(2)` and the coadjoint action -/

/-- The identification of `ℝ³` with the dual of `𝔰𝔲(2)` through the basis `-iσₐ/2`: the vector `n`
gives the functional `ν_n : suTwoEquiv x ↦ n ⬝ᵥ x`. Since the basis is orthonormal for
`B(X, Y) = -2 tr(XY)`, `ν_n = B(suTwoEquiv n, ·)` (`TauCeti.suTwoDualEquiv_apply`). -/
def suTwoDualEquiv : (Fin 3 → ℝ) ≃ₗ[ℝ] Dual ℝ SU2.lieAlgebra :=
  (dotProductEquiv ℝ (Fin 3)).trans suTwoEquiv.symm.dualMap

/-- The functional `ν_n` pairs `suTwoEquiv x` with `n ⬝ᵥ x`. -/
@[simp]
theorem suTwoDualEquiv_apply_suTwoEquiv (n x : Fin 3 → ℝ) :
    suTwoDualEquiv n (suTwoEquiv x) = n ⬝ᵥ x := by
  simp [suTwoDualEquiv]

/-- The functional `ν_n` is `B(suTwoEquiv n, ·)` for the invariant form `B(X, Y) = -2 tr(XY)`. -/
theorem suTwoDualEquiv_apply (n : Fin 3 → ℝ) (X : SU2.lieAlgebra) :
    (suTwoDualEquiv n X : ℂ) = -2 * (SU2.toMatrix (suTwoEquiv n) * SU2.toMatrix X).trace := by
  obtain ⟨x, rfl⟩ := suTwoEquiv.surjective X
  rw [suTwoDualEquiv_apply_suTwoEquiv, trace_toMatrix_suTwoEquiv_mul]
  ring

/-- Under `𝔰𝔲(2) ≃ so(3)` the functional `ν_n` of `so(3)` pulls back to the functional `ν_n` of
`𝔰𝔲(2)`. -/
theorem soThreeDualEquiv_comp_suTwoLieEquivSoThree (n : Fin 3 → ℝ) :
    (soThreeDualEquiv ℝ n).comp (suTwoLieEquivSoThree : SU2.lieAlgebra →ₗ[ℝ] _) =
      suTwoDualEquiv n := by
  refine LinearMap.ext fun X ↦ ?_
  obtain ⟨x, rfl⟩ := suTwoEquiv.surjective X
  simp

/-- **The coadjoint action of `𝔰𝔲(2)` is the infinitesimal rotation of `ℝ³`**:
`⁅suTwoEquiv ξ, ν_n⁆ = ν_(ξ ⨯₃ n)`. -/
@[simp]
theorem lie_suTwoEquiv_suTwoDualEquiv (ξ n : Fin 3 → ℝ) :
    ⁅suTwoEquiv ξ, suTwoDualEquiv n⁆ = suTwoDualEquiv (ξ ⨯₃ n) := by
  refine LinearMap.ext fun X ↦ ?_
  obtain ⟨η, rfl⟩ := suTwoEquiv.surjective X
  rw [Dual.lie_apply, lie_suTwoEquiv, suTwoDualEquiv_apply_suTwoEquiv,
    suTwoDualEquiv_apply_suTwoEquiv, ← cross_anticomm n ξ, neg_dotProduct,
    dotProduct_comm (n ⨯₃ ξ), triple_product_permutation η n ξ]

/-- **The KKS form of `𝔰𝔲(2)` is the triple product**: `ω_n([ξ], [η]) = n ⬝ᵥ (ξ ⨯₃ η)` for
`ξ, η` in the basis `-iσₐ/2`, the same formula as for `so(3)`
(`TauCeti.kksForm_soThreeDualEquiv_mk`). -/
theorem kksForm_suTwoDualEquiv_mk (n ξ η : Fin 3 → ℝ) :
    (suTwoDualEquiv n).kksForm (Submodule.Quotient.mk (suTwoEquiv ξ))
      (Submodule.Quotient.mk (suTwoEquiv η)) = n ⬝ᵥ ξ ⨯₃ η := by
  rw [Dual.kksForm_mk, lie_suTwoEquiv, suTwoDualEquiv_apply_suTwoEquiv]

/-! ### The adjoint action and the double cover -/

/-- **The adjoint action of `U(2)` on `𝔰𝔲(2)` is the rotation `pauliRotation U`** in the basis
`-iσₐ/2`: `Ad_U (suTwoEquiv x) = suTwoEquiv (pauliRotation U *ᵥ x)`. -/
theorem Ad_toUnits_suTwoEquiv (U : unitaryGroup (Fin 2) ℂ) (x : Fin 3 → ℝ) :
    Lie.Ad (I := 𝓘(ℝ, Matrix (Fin 2) (Fin 2) ℂ)) (Unitary.toUnits U) (suTwoEquiv x) =
      suTwoEquiv (pauliRotation U *ᵥ x) := by
  refine (unitsLieAlgebraEquiv (R := Matrix (Fin 2) (Fin 2) ℂ)).injective ?_
  rw [Lie.unitsLieAlgebraEquiv_Ad, Unitary.val_toUnits_apply, Unitary.val_inv_toUnits_apply,
    ← SU2.toMatrix_apply, ← SU2.toMatrix_apply, toMatrix_suTwoEquiv, toMatrix_suTwoEquiv,
    pauli_pauliRotation_mulVec, mul_smul_comm, smul_mul_assoc, ← Unitary.star_eq_inv,
    Unitary.coe_star]

/-- The adjoint action of `g ∈ SU(2)` on `𝔰𝔲(2)` is the rotation `toSO3 g` of the double cover
`SU(2) → SO(3)`. -/
theorem Ad_toUnits_inclusion_suTwoEquiv (g : SU2) (x : Fin 3 → ℝ) :
    Lie.Ad (I := 𝓘(ℝ, Matrix (Fin 2) (Fin 2) ℂ))
        (Unitary.toUnits (Submonoid.inclusion specialUnitaryGroup_le_unitaryGroup g))
        (suTwoEquiv x) =
      suTwoEquiv ((SU2.toSO3 g : Matrix (Fin 3) (Fin 3) ℝ) *ᵥ x) := by
  rw [Ad_toUnits_suTwoEquiv, SU2.coe_toSO3]

/-! ### The maximal torus and its period -/

/-- The generator `-iσ₃/2 = diag(-i/2, i/2)` of the maximal torus of `SU(2)`. -/
theorem toMatrix_suTwoEquiv_single_two :
    SU2.toMatrix (suTwoEquiv (Pi.single 2 1)) = diagonal ![-(I / 2), I / 2] := by
  rw [toMatrix_suTwoEquiv]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [pauli_apply]

/-- **The one-parameter subgroup generated by `-iσ₃/2` is the maximal torus of `SU(2)`**:
`exp (t (-iσ₃/2)) = diag (e^{-it/2}, e^{it/2})`, the torus element `torusExp (-t/2)`. -/
theorem coe_lieExp_smul_suTwoEquiv_single_two (t : ℝ) :
    ((lieExp ((t • suTwoEquiv (Pi.single 2 1) : SU2.lieAlgebra) :
        LeftInvariantDerivation 𝓘(ℝ, Matrix (Fin 2) (Fin 2) ℂ) (Matrix (Fin 2) (Fin 2) ℂ)ˣ) :
          (Matrix (Fin 2) (Fin 2) ℂ)ˣ) : Matrix (Fin 2) (Fin 2) ℂ) =
      (SU2.torusExp (-(t / 2)) : Matrix (Fin 2) (Fin 2) ℂ) := by
  rw [lieExp_eq_expUnit, TauCeti.expUnit_coe, ← SU2.toMatrix_apply, map_smul,
    toMatrix_suTwoEquiv_single_two, SU2.coe_torusExp, ← diagonal_smul]
  -- `Matrix.exp_diagonal` is stated for the entrywise topology on matrices, which the operator-norm
  -- topology selected above is by definition (`Matrix.linftyOpTopologicalSpace_eq`), so its
  -- exponential is the same series up to unfolding these instances.
  refine (Matrix.exp_diagonal (t • ![-(I / 2), I / 2])).trans (congrArg diagonal ?_)
  ext i
  fin_cases i <;> simp [← Complex.exp_eq_exp_ℂ] <;> ring_nf

/-- **The torus generator `-iσ₃/2` of `SU(2)` has period `4π`**: `exp (t (-iσ₃/2)) = 1` exactly
when `t` is an integer multiple of `4π`. -/
theorem lieExp_smul_suTwoEquiv_single_two_eq_one_iff (t : ℝ) :
    lieExp ((t • suTwoEquiv (Pi.single 2 1) : SU2.lieAlgebra) :
        LeftInvariantDerivation 𝓘(ℝ, Matrix (Fin 2) (Fin 2) ℂ) (Matrix (Fin 2) (Fin 2) ℂ)ˣ) = 1 ↔
      ∃ n : ℤ, t = n * (4 * Real.pi) := by
  rw [Units.ext_iff, coe_lieExp_smul_suTwoEquiv_single_two, Units.val_one,
    ← OneMemClass.coe_one (specialUnitaryGroup (Fin 2) ℂ), Subtype.coe_inj, SU2.torusExp_eq_one_iff]
  exact ⟨fun ⟨n, hn⟩ ↦ ⟨-n, by push_cast; linarith⟩, fun ⟨n, hn⟩ ↦ ⟨-n, by push_cast; linarith⟩⟩

/-- At time `2π` the torus generator `-iσ₃/2` reaches the central element `-1` of `SU(2)`, the
nontrivial element of the kernel of the double cover `SU(2) → SO(3)`. -/
theorem coe_lieExp_two_pi_smul_suTwoEquiv_single_two :
    ((lieExp (((2 * Real.pi) • suTwoEquiv (Pi.single 2 1) : SU2.lieAlgebra) :
        LeftInvariantDerivation 𝓘(ℝ, Matrix (Fin 2) (Fin 2) ℂ) (Matrix (Fin 2) (Fin 2) ℂ)ˣ) :
          (Matrix (Fin 2) (Fin 2) ℂ)ˣ) : Matrix (Fin 2) (Fin 2) ℂ) = -1 := by
  rw [coe_lieExp_smul_suTwoEquiv_single_two, SU2.coe_torusExp]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Complex.exp_neg, mul_div_cancel_left₀]

/-- **The image of the torus generator in `SO(3)` has period `2π`**: if `g ∈ SU(2)` is
`exp (t (-iσ₃/2))`, then `toSO3 g = 1` exactly when `t` is an integer multiple of `2π`. So the
double cover `SU(2) → SO(3)` halves the period of the torus generator. -/
theorem toSO3_eq_one_iff_of_coe_eq_lieExp {g : SU2} {t : ℝ}
    (hg : (g : Matrix (Fin 2) (Fin 2) ℂ) =
      ((lieExp ((t • suTwoEquiv (Pi.single 2 1) : SU2.lieAlgebra) :
        LeftInvariantDerivation 𝓘(ℝ, Matrix (Fin 2) (Fin 2) ℂ) (Matrix (Fin 2) (Fin 2) ℂ)ˣ) :
          (Matrix (Fin 2) (Fin 2) ℂ)ˣ) : Matrix (Fin 2) (Fin 2) ℂ)) :
    SU2.toSO3 g = 1 ↔ ∃ n : ℤ, t = n * (2 * Real.pi) := by
  rw [coe_lieExp_smul_suTwoEquiv_single_two, Subtype.coe_inj] at hg
  rw [hg, SU2.toSO3_torusExp_eq_one_iff]
  exact ⟨fun ⟨n, hn⟩ ↦ ⟨-n, by push_cast; linarith⟩, fun ⟨n, hn⟩ ↦ ⟨-n, by push_cast; linarith⟩⟩

end TauCeti
