import TauCeti.Algebra.Quaternion.Basic

/-!
# The binary octahedral subgroup of SU(2)

In unit-quaternion coordinates the **binary octahedral group** consists of the 48 points

* the 24 points of the binary tetrahedral group, `±1, ±i, ±j, ±k` and `(±1 ± i ± j ± k) / 2`, and
* the 24 points with exactly two nonzero coordinates, both `±1/√2`, such as `(1 + i) / √2`.

This file records the second family by its coordinates scaled by `√2`, the finite set
`TauCeti.SU2.binaryOctahedralCosetCoords` of the 24 integer vectors with two entries `±1` and two
entries `0`, and constructs the binary octahedral subgroup of the native matrix group `SU(2)` by
adjoining the matrices of the quaternions `(w₀ + w₁ i + w₂ j + w₃ k) / √2`, for these `w`, to the
binary tetrahedral subgroup.

The scaled coordinate vectors are exactly the integer solutions of `w₀² + w₁² + w₂² + w₃² = 2`
(`TauCeti.SU2.mem_binaryOctahedralCosetCoords_iff`). So the binary octahedral group is the group of
unit quaternions whose coordinates all lie in `ℤ/2` or all lie in `ℤ/√2`
(`TauCeti.SU2.mem_binaryOctahedralSubgroup_iff_exists_int`). This is what makes it closed under
multiplication. A product of two points of the second family is half of an integer quaternion, so
it is a binary tetrahedral point. For a binary tetrahedral point `v / 2` and a point `w / √2` of
the second family, every coordinate of the integer quaternion `v w` is even: either all
coordinates of `v` are even, or they are all odd and each coordinate of `v w` has the parity of
`w₀ + w₁ + w₂ + w₃`, which is that of `w₀² + w₁² + w₂² + w₃² = 2`. So `v w / (2√2)` lies in the
second family again, and likewise `w v / (2√2)`.

The 48 points are distinct and exhaust the subgroup (`TauCeti.SU2.binaryOctahedralCoordsEquiv`):
a coordinate `±1/√2` is never a half-integer. So the subgroup has exactly 48 elements, and the
binary tetrahedral subgroup has index two in it. It contains the binary dihedral subgroup of order
sixteen, whose rotation generator `r = diag (exp (πi/4), exp (-πi/4))` is the quaternion
`(1 + i) / √2`, and it is generated by `r`, `j` and the element `ω = (-1 + i + j + k) / 2` of order
three.

## Main definitions

* `TauCeti.SU2.binaryOctahedralCosetCoords`: the 24 scaled coordinate vectors of the second family.
* `TauCeti.SU2.binaryOctahedralSubgroup`: the binary octahedral subgroup of `SU(2)`.
* `TauCeti.SU2.binaryOctahedralCoordsEquiv`: its parametrization by the coordinates of both
  families.

## Main results

* `TauCeti.SU2.mem_binaryOctahedralSubgroup_iff_exists_int`: the binary octahedral subgroup is the
  set of elements of `SU(2)` whose quaternion coordinates all lie in `ℤ/2` or all lie in `ℤ/√2`.
* `TauCeti.SU2.natCard_binaryOctahedralSubgroup`: it has exactly 48 elements.
* `TauCeti.SU2.relIndex_binaryTetrahedralSubgroup_binaryOctahedralSubgroup`: the binary tetrahedral
  subgroup has index two in it.
* `TauCeti.SU2.binaryDihedralSubgroup_four_le_binaryOctahedralSubgroup`: it contains the binary
  dihedral subgroup of order sixteen.
* `TauCeti.SU2.binaryOctahedralSubgroup_eq_closure`: it is generated by `(1 + i) / √2`, `j` and
  `ω`.

## References

* J. H. Conway and D. A. Smith, *On Quaternions and Octonions*, A K Peters, 2003, Chapter 3 (the
  binary polyhedral groups).
-/

public section

namespace TauCeti.SU2

open Quaternion

/-! ### The scaled coordinates of the second family -/

/-- The coordinates `√2 q = (w₀, w₁, w₂, w₃)`, scaled by `√2`, of the 24 points `q` of the binary
octahedral group outside the binary tetrahedral group: the integer vectors with exactly two
nonzero entries, both `±1`, giving the quaternions `(±1 ± i) / √2`, `(±1 ± j) / √2`, …,
`(±j ± k) / √2`. -/
def binaryOctahedralCosetCoords : Finset (Fin 4 → ℤ) :=
  (Fintype.piFinset fun _ => {-1, 0, 1}).filter fun w => ∑ i, w i ^ 2 = 2

/-- The scaled coordinate vectors as an explicit finite filter, for finite checks by `decide`. -/
theorem binaryOctahedralCosetCoords_def : binaryOctahedralCosetCoords =
    (Fintype.piFinset fun _ => {-1, 0, 1}).filter fun w => ∑ i, w i ^ 2 = 2 :=
  (rfl)

/-- **The 24 scaled coordinate vectors are distinct.** -/
@[simp]
theorem card_binaryOctahedralCosetCoords : binaryOctahedralCosetCoords.card = 24 := by
  decide

/-- **The scaled coordinate vectors are the integer solutions of
`w₀² + w₁² + w₂² + w₃² = 2`.** -/
theorem mem_binaryOctahedralCosetCoords_iff {w : Fin 4 → ℤ} :
    w ∈ binaryOctahedralCosetCoords ↔ ∑ i, w i ^ 2 = 2 := by
  refine ⟨fun hw => (Finset.mem_filter.mp hw).2, fun hw => Finset.mem_filter.mpr ⟨?_, hw⟩⟩
  -- Each coordinate is bounded by `1`.
  refine Fintype.mem_piFinset.mpr fun i => ?_
  have hi : w i ^ 2 ≤ 2 := by
    rw [← hw]
    exact Finset.single_le_sum (fun j _ => sq_nonneg (w j)) (Finset.mem_univ i)
  have h1 : -1 ≤ w i := by nlinarith
  have h2 : w i ≤ 1 := by nlinarith
  simp only [Finset.mem_insert, Finset.mem_singleton]
  omega

/-- Each scaled coordinate vector has a coordinate `±1`. -/
private theorem exists_sq_eq_one_of_mem_binaryOctahedralCosetCoords {w : Fin 4 → ℤ}
    (hw : w ∈ binaryOctahedralCosetCoords) : ∃ i, w i ^ 2 = 1 :=
  (by decide : ∀ w ∈ binaryOctahedralCosetCoords, ∃ i, w i ^ 2 = 1) w hw

/-! ### Quaternions with coordinates in `ℤ/√2` -/

/-- An element of `SU(2)` whose quaternion coordinates lie in `ℤ/√2` has scaled coordinates in
`TauCeti.SU2.binaryOctahedralCosetCoords`, since its quaternion has norm one. -/
private theorem exists_mem_binaryOctahedralCosetCoords_of_coe_eq {g : SU2} {w : Fin 4 → ℤ}
    (hg : (g : Matrix (Fin 2) (Fin 2) ℂ) =
      toComplexMatrix ⟨w 0 / √2, w 1 / √2, w 2 / √2, w 3 / √2⟩) :
    ∃ w ∈ binaryOctahedralCosetCoords, (g : Matrix (Fin 2) (Fin 2) ℂ) =
      toComplexMatrix ⟨w 0 / √2, w 1 / √2, w 2 / √2, w 3 / √2⟩ := by
  have hdet := (Matrix.mem_specialUnitaryGroup_iff.mp g.property).2
  rw [hg, det_toComplexMatrix, normSq_mk_div, Real.sq_sqrt zero_le_two, ← Complex.ofReal_one,
    Complex.ofReal_inj, div_eq_one_iff_eq two_ne_zero] at hdet
  refine ⟨w, mem_binaryOctahedralCosetCoords_iff.mpr ?_, hg⟩
  rw [Fin.sum_univ_four]
  exact_mod_cast hdet

/-- The points of the scaled coordinate set give unit quaternions. -/
private theorem toComplexMatrix_mem_of_mem_binaryOctahedralCosetCoords {w : Fin 4 → ℤ}
    (hw : w ∈ binaryOctahedralCosetCoords) :
    toComplexMatrix ⟨w 0 / √2, w 1 / √2, w 2 / √2, w 3 / √2⟩ ∈
      Matrix.specialUnitaryGroup (Fin 2) ℂ := by
  refine mem_specialUnitaryGroup_toComplexMatrix ((mem_unitary_iff_normSq_eq_one _).mpr ?_)
  have hw := mem_binaryOctahedralCosetCoords_iff.mp hw
  rw [Fin.sum_univ_four] at hw
  rw [normSq_mk_div, Real.sq_sqrt zero_le_two, div_eq_one_iff_eq two_ne_zero]
  exact_mod_cast hw

/-- The integer quaternion with coordinates `v`. -/
private def intQuaternion (v : Fin 4 → ℤ) : ℍ[ℤ] := ⟨v 0, v 1, v 2, v 3⟩

/-- The product of two quaternions with coordinates in `ℤ/√2` has coordinates in `ℤ/2`. -/
private theorem exists_div_sqrt_two_mul_div_sqrt_two_eq_half (w w' : Fin 4 → ℤ) :
    ∃ u : Fin 4 → ℤ, (⟨w 0 / √2, w 1 / √2, w 2 / √2, w 3 / √2⟩ : ℍ[ℝ]) *
      ⟨w' 0 / √2, w' 1 / √2, w' 2 / √2, w' 3 / √2⟩ = ⟨u 0 / 2, u 1 / 2, u 2 / 2, u 3 / 2⟩ := by
  set x := intQuaternion w * intQuaternion w' with hx
  have hs (a b : ℝ) : a / √2 * (b / √2) = a * b / 2 := by
    rw [div_mul_div_comm, Real.mul_self_sqrt zero_le_two]
  refine ⟨![x.re, x.imI, x.imJ, x.imK], ?_⟩
  ext <;> simp only [hx, intQuaternion, re_mul, imI_mul, imJ_mul, imK_mul, Matrix.cons_val, hs] <;>
    push_cast <;> ring

/-- For a doubled binary tetrahedral coordinate vector `v` and a scaled coordinate vector `w` of the
second family, all coordinates of the integer quaternions `v w` and `w v` are even. Either all
coordinates of `v` are even, or they are all odd and each coordinate of `v w` and `w v` has the
parity of `w₀ + w₁ + w₂ + w₃`, which is even; this is checked over the 24 × 24 pairs. -/
private theorem even_coords_of_mem {v w : Fin 4 → ℤ} (hv : v ∈ binaryTetrahedralCoords)
    (hw : w ∈ binaryOctahedralCosetCoords) :
    ∀ x ∈ [intQuaternion v * intQuaternion w, intQuaternion w * intQuaternion v],
      Even x.re ∧ Even x.imI ∧ Even x.imJ ∧ Even x.imK :=
  (by rw [binaryTetrahedralCoords_def]; decide : ∀ v ∈ binaryTetrahedralCoords,
    ∀ w ∈ binaryOctahedralCosetCoords,
    ∀ x ∈ [intQuaternion v * intQuaternion w, intQuaternion w * intQuaternion v],
      Even x.re ∧ Even x.imI ∧ Even x.imJ ∧ Even x.imK) v hv w hw

/-- An integer quaternion `x` with even coordinates gives a quaternion `x / (2√2)` with coordinates
in `ℤ/√2`. -/
private theorem exists_div_two_mul_sqrt_two_eq {x : ℍ[ℤ]}
    (hx : Even x.re ∧ Even x.imI ∧ Even x.imJ ∧ Even x.imK) :
    ∃ u : Fin 4 → ℤ, (⟨x.re / (2 * √2), x.imI / (2 * √2), x.imJ / (2 * √2), x.imK / (2 * √2)⟩ :
      ℍ[ℝ]) = ⟨u 0 / √2, u 1 / √2, u 2 / √2, u 3 / √2⟩ := by
  obtain ⟨⟨a, ha⟩, ⟨b, hb⟩, ⟨c, hc⟩, ⟨d, hd⟩⟩ := hx
  refine ⟨![a, b, c, d], ?_⟩
  ext <;> simp only [ha, hb, hc, hd, Matrix.cons_val] <;> push_cast <;> field_simp <;> ring

/-- The product of a binary tetrahedral point `v / 2` and a quaternion `w / √2` of the second
family, in either order, has coordinates in `ℤ/√2`. -/
private theorem exists_half_mul_div_sqrt_two_eq {v w : Fin 4 → ℤ}
    (hv : v ∈ binaryTetrahedralCoords) (hw : w ∈ binaryOctahedralCosetCoords) :
    (∃ u : Fin 4 → ℤ, (⟨v 0 / 2, v 1 / 2, v 2 / 2, v 3 / 2⟩ : ℍ[ℝ]) *
      ⟨w 0 / √2, w 1 / √2, w 2 / √2, w 3 / √2⟩ = ⟨u 0 / √2, u 1 / √2, u 2 / √2, u 3 / √2⟩) ∧
    ∃ u : Fin 4 → ℤ, (⟨w 0 / √2, w 1 / √2, w 2 / √2, w 3 / √2⟩ : ℍ[ℝ]) *
      ⟨v 0 / 2, v 1 / 2, v 2 / 2, v 3 / 2⟩ = ⟨u 0 / √2, u 1 / √2, u 2 / √2, u 3 / √2⟩ := by
  have h := even_coords_of_mem hv hw
  refine ⟨(exists_div_two_mul_sqrt_two_eq (h (intQuaternion v * intQuaternion w) (by simp))).imp
    fun u hu => ?_,
    (exists_div_two_mul_sqrt_two_eq (h (intQuaternion w * intQuaternion v) (by simp))).imp
    fun u hu => ?_⟩ <;>
  · rw [← hu]
    ext <;> simp only [intQuaternion, re_mul, imI_mul, imJ_mul, imK_mul] <;> push_cast <;>
      field_simp

/-- A quaternion with coordinates in `ℤ/√2` is never a binary tetrahedral point: a coordinate
`±1/√2` is not a half-integer. -/
private theorem toComplexMatrix_ne_of_mem_binaryOctahedralCosetCoords {v w : Fin 4 → ℤ}
    (hw : w ∈ binaryOctahedralCosetCoords) :
    toComplexMatrix ⟨v 0 / 2, v 1 / 2, v 2 / 2, v 3 / 2⟩ ≠
      toComplexMatrix ⟨w 0 / √2, w 1 / √2, w 2 / √2, w 3 / √2⟩ := by
  intro h
  have h := toComplexMatrix_injective h
  simp only [QuaternionAlgebra.mk.injEq] at h
  obtain ⟨i, hi⟩ := exists_sq_eq_one_of_mem_binaryOctahedralCosetCoords hw
  -- Squaring `v i / 2 = w i / √2` gives `v i ^ 2 = 2 w i ^ 2 = 2`.
  have hvi : (v i : ℝ) / 2 = w i / √2 := by
    fin_cases i
    exacts [h.1, h.2.1, h.2.2.1, h.2.2.2]
  have hsq : ((v i : ℝ) / 2) ^ 2 = (w i : ℝ) ^ 2 / 2 := by
    rw [hvi, div_pow, Real.sq_sqrt zero_le_two]
  have hv2 : v i * v i = 2 := by
    have hwi : ((w i : ℤ) : ℝ) ^ 2 = 1 := by exact_mod_cast hi
    rw [hwi] at hsq
    have : ((v i * v i : ℤ) : ℝ) = 2 := by push_cast; linear_combination 4 * hsq
    exact_mod_cast this
  have h1 : v i ≤ 1 := by nlinarith
  have h2 : -1 ≤ v i := by nlinarith
  rcases (by omega : v i = -1 ∨ v i = 0 ∨ v i = 1) with h | h | h <;> rw [h] at hv2 <;>
    norm_num at hv2

/-! ### The binary octahedral subgroup -/

/-- **The binary octahedral subgroup of `SU(2)`**: the 48 matrices of the unit quaternions in the
binary tetrahedral subgroup together with the quaternions `(w₀ + w₁ i + w₂ j + w₃ k) / √2` for the
scaled coordinate vectors `w` in `TauCeti.SU2.binaryOctahedralCosetCoords`, the 24 points with
exactly two nonzero coordinates, both `±1/√2`. -/
noncomputable def binaryOctahedralSubgroup : Subgroup SU2 where
  carrier := {g | g ∈ binaryTetrahedralSubgroup ∨ ∃ w ∈ binaryOctahedralCosetCoords,
    (g : Matrix (Fin 2) (Fin 2) ℂ) = toComplexMatrix ⟨w 0 / √2, w 1 / √2, w 2 / √2, w 3 / √2⟩}
  mul_mem' := by
    rintro g h (hg | ⟨w, hw, hg⟩) (hh | ⟨w', hw', hh⟩)
    · exact .inl (mul_mem hg hh)
    · obtain ⟨v, hv, hg⟩ := mem_binaryTetrahedralSubgroup_iff.mp hg
      obtain ⟨u, hu⟩ := (exists_half_mul_div_sqrt_two_eq hv hw').1
      refine .inr (exists_mem_binaryOctahedralCosetCoords_of_coe_eq (w := u) ?_)
      rw [← hu, map_mul, ← hg, ← hh, Submonoid.coe_mul]
    · obtain ⟨v, hv, hh⟩ := mem_binaryTetrahedralSubgroup_iff.mp hh
      obtain ⟨u, hu⟩ := (exists_half_mul_div_sqrt_two_eq hv hw).2
      refine .inr (exists_mem_binaryOctahedralCosetCoords_of_coe_eq (w := u) ?_)
      rw [← hu, map_mul, ← hg, ← hh, Submonoid.coe_mul]
    · obtain ⟨u, hu⟩ := exists_div_sqrt_two_mul_div_sqrt_two_eq_half w w'
      refine .inl (mem_binaryTetrahedralSubgroup_iff_exists_int.mpr ⟨u, ?_⟩)
      rw [← hu, map_mul, ← hg, ← hh, Submonoid.coe_mul]
  one_mem' := .inl (one_mem _)
  inv_mem' := by
    rintro g (hg | ⟨w, -, hg⟩)
    · exact .inl (inv_mem hg)
    refine .inr
      (exists_mem_binaryOctahedralCosetCoords_of_coe_eq (w := ![w 0, -w 1, -w 2, -w 3]) ?_)
    rw [← Matrix.star_eq_inv, Matrix.specialUnitaryGroup.coe_star, hg, ← map_star]
    congr 1
    ext <;> simp [neg_div]

/-- Membership in the binary octahedral subgroup: an element is binary tetrahedral, or its
quaternion coordinates are the scaled coordinates of one of the 24 points of the second family,
divided by `√2`. -/
theorem mem_binaryOctahedralSubgroup_iff {g : SU2} :
    g ∈ binaryOctahedralSubgroup ↔ g ∈ binaryTetrahedralSubgroup ∨
      ∃ w ∈ binaryOctahedralCosetCoords, (g : Matrix (Fin 2) (Fin 2) ℂ) =
        toComplexMatrix ⟨w 0 / √2, w 1 / √2, w 2 / √2, w 3 / √2⟩ :=
  Iff.rfl

/-- **The binary octahedral subgroup consists of the unit quaternions whose coordinates all lie in
`ℤ/2` or all lie in `ℤ/√2`.** -/
theorem mem_binaryOctahedralSubgroup_iff_exists_int {g : SU2} :
    g ∈ binaryOctahedralSubgroup ↔
      (∃ v : Fin 4 → ℤ, (g : Matrix (Fin 2) (Fin 2) ℂ) =
        toComplexMatrix ⟨v 0 / 2, v 1 / 2, v 2 / 2, v 3 / 2⟩) ∨
      ∃ w : Fin 4 → ℤ, (g : Matrix (Fin 2) (Fin 2) ℂ) =
        toComplexMatrix ⟨w 0 / √2, w 1 / √2, w 2 / √2, w 3 / √2⟩ := by
  rw [mem_binaryOctahedralSubgroup_iff, mem_binaryTetrahedralSubgroup_iff_exists_int]
  exact or_congr_right ⟨fun ⟨w, _, hg⟩ => ⟨w, hg⟩,
    fun ⟨_, hg⟩ => exists_mem_binaryOctahedralCosetCoords_of_coe_eq hg⟩

/-- **The binary tetrahedral subgroup is contained in the binary octahedral subgroup.** -/
theorem binaryTetrahedralSubgroup_le_binaryOctahedralSubgroup :
    binaryTetrahedralSubgroup ≤ binaryOctahedralSubgroup :=
  fun _ => .inl

/-- The element of the binary octahedral subgroup with the given coordinates: doubled binary
tetrahedral coordinates, or scaled coordinates of the second family. -/
private noncomputable def binaryOctahedralCoordsFun :
    binaryTetrahedralCoords ⊕ binaryOctahedralCosetCoords → binaryOctahedralSubgroup
  | .inl v => ⟨binaryTetrahedralCoordsEquiv v, .inl (binaryTetrahedralCoordsEquiv v).property⟩
  | .inr w => ⟨⟨_, toComplexMatrix_mem_of_mem_binaryOctahedralCosetCoords w.property⟩, .inr ⟨w,
      w.property, rfl⟩⟩

private theorem binaryOctahedralCoordsFun_bijective :
    Function.Bijective binaryOctahedralCoordsFun := by
  refine ⟨fun x y hxy => ?_, fun g => ?_⟩
  · have h := congrArg (fun g : binaryOctahedralSubgroup =>
      ((g : SU2) : Matrix (Fin 2) (Fin 2) ℂ)) hxy
    rcases x with v | w <;> rcases y with v' | w' <;>
      simp only [binaryOctahedralCoordsFun, coe_binaryTetrahedralCoordsEquiv_apply] at h
    · refine congrArg Sum.inl
        (binaryTetrahedralCoordsEquiv.injective (Subtype.ext (Subtype.ext ?_)))
      rw [coe_binaryTetrahedralCoordsEquiv_apply, coe_binaryTetrahedralCoordsEquiv_apply, h]
    · exact absurd h (toComplexMatrix_ne_of_mem_binaryOctahedralCosetCoords w'.property)
    · exact absurd h.symm (toComplexMatrix_ne_of_mem_binaryOctahedralCosetCoords w.property)
    · have h := toComplexMatrix_injective h
      simp only [QuaternionAlgebra.mk.injEq, div_left_inj₀ (Real.sqrt_ne_zero'.mpr two_pos),
        Int.cast_inj] at h
      obtain ⟨h0, h1, h2, h3⟩ := h
      refine congrArg Sum.inr (Subtype.ext ?_)
      ext i
      fin_cases i
      exacts [h0, h1, h2, h3]
  · obtain ⟨g, hg | ⟨w, hw, hg'⟩⟩ := g
    · obtain ⟨v, hv⟩ := binaryTetrahedralCoordsEquiv.surjective ⟨g, hg⟩
      exact ⟨.inl v, Subtype.ext (congrArg (fun x : binaryTetrahedralSubgroup => (x : SU2)) hv)⟩
    · exact ⟨.inr ⟨w, hw⟩, Subtype.ext (Subtype.ext hg'.symm)⟩

/-- **The 48 points parametrize the binary octahedral subgroup**: a doubled binary tetrahedral
coordinate vector `v` corresponds to the matrix of `(v₀ + v₁ i + v₂ j + v₃ k) / 2`, and a scaled
coordinate vector `w` of the second family to the matrix of `(w₀ + w₁ i + w₂ j + w₃ k) / √2`. -/
noncomputable def binaryOctahedralCoordsEquiv :
    binaryTetrahedralCoords ⊕ binaryOctahedralCosetCoords ≃ binaryOctahedralSubgroup :=
  Equiv.ofBijective _ binaryOctahedralCoordsFun_bijective

@[simp]
theorem coe_binaryOctahedralCoordsEquiv_inl (v : binaryTetrahedralCoords) :
    (binaryOctahedralCoordsEquiv (.inl v) : SU2) = binaryTetrahedralCoordsEquiv v := (rfl)

@[simp]
theorem coe_binaryOctahedralCoordsEquiv_inr (w : binaryOctahedralCosetCoords) :
    ((binaryOctahedralCoordsEquiv (.inr w) : SU2) : Matrix (Fin 2) (Fin 2) ℂ) =
      toComplexMatrix ⟨(w : Fin 4 → ℤ) 0 / √2, (w : Fin 4 → ℤ) 1 / √2, (w : Fin 4 → ℤ) 2 / √2,
        (w : Fin 4 → ℤ) 3 / √2⟩ := (rfl)

instance : Finite binaryOctahedralSubgroup :=
  Finite.of_equiv _ binaryOctahedralCoordsEquiv

/-- **The binary octahedral subgroup has exactly 48 elements.** -/
@[simp]
theorem natCard_binaryOctahedralSubgroup : Nat.card binaryOctahedralSubgroup = 48 := by
  rw [← Nat.card_congr binaryOctahedralCoordsEquiv, Nat.card_sum, Nat.card_eq_fintype_card,
    Nat.card_eq_fintype_card, Fintype.card_coe, Fintype.card_coe, card_binaryTetrahedralCoords,
    card_binaryOctahedralCosetCoords]

/-- **The binary tetrahedral subgroup has index two in the binary octahedral subgroup.** -/
theorem relIndex_binaryTetrahedralSubgroup_binaryOctahedralSubgroup :
    binaryTetrahedralSubgroup.relIndex binaryOctahedralSubgroup = 2 := by
  have h := binaryTetrahedralSubgroup.relIndex_mul_card binaryOctahedralSubgroup
  rw [inf_of_le_left binaryTetrahedralSubgroup_le_binaryOctahedralSubgroup,
    natCard_binaryTetrahedralSubgroup, natCard_binaryOctahedralSubgroup] at h
  omega

/-! ### Generators -/

/-- The rotation generator `r = diag (exp (πi/4), exp (-πi/4))` of the binary dihedral group of
order sixteen is the quaternion `(1 + i) / √2`. -/
theorem coe_binaryDihedralRotation_four_eq_toComplexMatrix :
    (binaryDihedralRotation 4 : Matrix (Fin 2) (Fin 2) ℂ) =
      toComplexMatrix ⟨1 / √2, 1 / √2, 0, 0⟩ := by
  rw [coe_binaryDihedralRotation_eq_toComplexMatrix, Nat.cast_ofNat, Real.cos_pi_div_four,
    Real.sin_pi_div_four, Real.sqrt_div_self']

@[simp]
theorem binaryDihedralRotation_four_mem_binaryOctahedralSubgroup :
    binaryDihedralRotation 4 ∈ binaryOctahedralSubgroup := by
  refine .inr ⟨![1, 1, 0, 0], by decide, ?_⟩
  rw [coe_binaryDihedralRotation_four_eq_toComplexMatrix]
  congr 1
  ext <;> simp

/-- **The binary octahedral subgroup contains the binary dihedral subgroup of order sixteen**,
generated by `r = (1 + i) / √2` and `s = j`. -/
theorem binaryDihedralSubgroup_four_le_binaryOctahedralSubgroup :
    binaryDihedralSubgroup 4 ≤ binaryOctahedralSubgroup := by
  rw [binaryDihedralSubgroup_eq_closure, Subgroup.closure_le, Set.insert_subset_iff,
    Set.singleton_subset_iff]
  refine ⟨binaryDihedralRotation_four_mem_binaryOctahedralSubgroup,
    binaryTetrahedralSubgroup_le_binaryOctahedralSubgroup
      (binaryDihedralSubgroup_two_le_binaryTetrahedralSubgroup
        (inv_mem (weylElement_mem_binaryDihedralSubgroup 2)))⟩

/-- **The binary octahedral subgroup is generated by `(1 + i) / √2`, `j` and
`ω = (-1 + i + j + k) / 2`**, that is, by the generators `r` and `s` of the binary dihedral group of
order sixteen together with an element of order three. -/
theorem binaryOctahedralSubgroup_eq_closure :
    binaryOctahedralSubgroup = Subgroup.closure
      {binaryDihedralRotation 4, weylElement⁻¹, binaryTetrahedralOmega} := by
  set H := Subgroup.closure {binaryDihedralRotation 4, weylElement⁻¹, binaryTetrahedralOmega}
  have hle : H ≤ binaryOctahedralSubgroup := by
    rw [Subgroup.closure_le, Set.insert_subset_iff, Set.insert_subset_iff,
      Set.singleton_subset_iff]
    exact ⟨binaryDihedralRotation_four_mem_binaryOctahedralSubgroup,
      binaryDihedralSubgroup_four_le_binaryOctahedralSubgroup
        (inv_mem (weylElement_mem_binaryDihedralSubgroup 4)),
      binaryTetrahedralSubgroup_le_binaryOctahedralSubgroup
        binaryTetrahedralOmega_mem_binaryTetrahedralSubgroup⟩
  have : Finite H := Finite.of_injective _ (Subgroup.inclusion_injective hle)
  -- The order of `H` is divisible by the order sixteen of the binary dihedral group and by three.
  have h16 : 16 ∣ Nat.card H := by
    have hQ : binaryDihedralSubgroup 4 ≤ H := by
      rw [binaryDihedralSubgroup_eq_closure]
      exact Subgroup.closure_mono (Set.insert_subset_insert (Set.singleton_subset_iff.mpr
        (Set.mem_insert _ _)))
    simpa using Subgroup.card_dvd_of_le hQ
  have h3 : 3 ∣ Nat.card H := by
    simpa using H.orderOf_dvd_natCard (Subgroup.subset_closure (by simp) :
      binaryTetrahedralOmega ∈ H)
  refine (Subgroup.eq_of_le_of_card_ge hle ?_).symm
  rw [natCard_binaryOctahedralSubgroup]
  exact Nat.le_of_dvd Nat.card_pos (Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) h16 h3)

end TauCeti.SU2
