public import TauCeti.RepresentationTheory.SU2.Weyl.Basic

/-!
# Concrete binary dihedral subgroups of SU(2)

For `n ≥ 1` the **binary dihedral group** of order `4n` is the subgroup of `SU(2)` generated by

`r = diag (exp (πi/n), exp (-πi/n))`  and  `s = !![0, 1; -1, 0]`,

the second being the matrix of the quaternion `j`, and the inverse of the quarter turn
`TauCeti.SU2.weylElement`. They satisfy `r ^ (2n) = 1`, `s² = r ^ n = -1` and `s r s⁻¹ = r⁻¹`,
which are the defining relations of Mathlib's dicyclic group `QuaternionGroup n`. This file
constructs the homomorphism `QuaternionGroup n →* SU(2)` sending `a i ↦ r ^ i` and
`xa i ↦ s r ^ i`, proves it is injective, and takes the binary dihedral subgroup to be its range.
So the subgroup is an actual subgroup of the native matrix group, generated by `r` and `s`, with
every element in one of the normal forms `r ^ j` or `s r ^ j` (`0 ≤ j < 2n`), no `r ^ j` equal to
any `s r ^ k`, and exactly `4n` elements.

The rotation part is the diagonal circle parametrised by Mathlib's `ZMod.toCircle` at level `2n`,
so `r ^ j = diag (exp (πij/n), exp (-πij/n))`. The quaternion coordinates of the generators are
`r = cos (π/n) + sin (π/n) i` and `s = j`, recorded through `Quaternion.toComplexMatrix`.

For `n = 1` the subgroup is cyclic of order four, generated by `s`; the binary dihedral family
proper starts at `n = 2`, where it is the quaternion group `Q₈`.

## Main definitions

* `TauCeti.SU2.binaryDihedralHom n`: the faithful homomorphism `QuaternionGroup n →* SU(2)`.
* `TauCeti.SU2.binaryDihedralRotation n`: the generator `r = diag (exp (πi/n), exp (-πi/n))`.
* `TauCeti.SU2.binaryDihedralSubgroup n`: the binary dihedral subgroup of order `4n`.
* `TauCeti.SU2.binaryDihedralEquiv n`: its identification with `QuaternionGroup n`.

## References

* J. H. Conway and D. A. Smith, *On Quaternions and Octonions*, A K Peters, 2003, §6.5.
-/

public section

namespace TauCeti.SU2

open QuaternionGroup
open scoped Real

/-! ### The second generator -/

/-- The inverse quarter turn is the matrix of the quaternion `j`. -/
theorem coe_weylElement_inv_eq_toComplexMatrix :
    ((weylElement⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ) =
      Quaternion.toComplexMatrix ⟨0, 0, 1, 0⟩ := by
  rw [coe_weylElement_inv, Quaternion.toComplexMatrix_apply]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

/-- Moving a torus element past `s = weylElement⁻¹` inverts it, in the form used to multiply
normal forms `z (s w) = s (z⁻¹ w)`. -/
private theorem torusHom_mul_weylElement_inv_mul (z w : Circle) :
    torusHom z * (weylElement⁻¹ * torusHom w) = weylElement⁻¹ * torusHom (z⁻¹ * w) := by
  rw [← mul_assoc, torusHom_mul_weylElement_inv, mul_assoc, map_mul]

/-! ### The homomorphism from the dicyclic group -/

variable (n : ℕ) [NeZero n]

/-- The standard circle character of `ZMod (2n)` sends `n` to `exp (πi) = -1`. -/
private theorem coe_toCircle_natCast_self :
    ((ZMod.toCircle ((n : ℕ) : ZMod (2 * n)) : Circle) : ℂ) = -1 := by
  have hn : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne n)
  rw [ZMod.toCircle_natCast, Nat.cast_mul, Nat.cast_two]
  have : 2 * π * Complex.I * n / (2 * n) = π * Complex.I := by
    field_simp
  rw [this, Complex.exp_pi_mul_I]

/-- The square of the inverse quarter turn is the torus element at index `n` of `ZMod (2n)`. -/
private theorem weylElement_inv_sq_eq_torusHom :
    weylElement⁻¹ ^ 2 = torusHom (ZMod.toCircle ((n : ℕ) : ZMod (2 * n))) := by
  refine Subtype.ext ?_
  rw [coe_weylElement_inv_sq, coe_torusHom]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [torusMatrix_apply_zero_zero, torusMatrix_apply_one_one, torusMatrix_apply_zero_one,
      torusMatrix_apply_one_zero, coe_toCircle_natCast_self]

/-- The values of the binary dihedral homomorphism on the two cosets of the rotations. -/
private noncomputable def binaryDihedralFun : QuaternionGroup n → SU2
  | .a i => torusHom (ZMod.toCircle i)
  | .xa i => weylElement⁻¹ * torusHom (ZMod.toCircle i)

private theorem binaryDihedralFun_mul (g h : QuaternionGroup n) :
    binaryDihedralFun n (g * h) = binaryDihedralFun n g * binaryDihedralFun n h := by
  cases g with
  | a i =>
    cases h with
    | a j => simp [binaryDihedralFun, AddChar.map_add_eq_mul]
    | xa j =>
      simp only [binaryDihedralFun, a_mul_xa, torusHom_mul_weylElement_inv_mul,
        AddChar.map_sub_eq_div, div_eq_inv_mul]
  | xa i =>
    cases h with
    | a j => simp [binaryDihedralFun, mul_assoc, AddChar.map_add_eq_mul]
    | xa j =>
      simp only [binaryDihedralFun, xa_mul_xa]
      rw [mul_assoc, torusHom_mul_weylElement_inv_mul, ← mul_assoc, ← sq,
        weylElement_inv_sq_eq_torusHom n, ← map_mul, add_sub_assoc, AddChar.map_add_eq_mul,
        AddChar.map_sub_eq_div, div_eq_inv_mul]

/-- **The binary dihedral representation of the dicyclic group.** The homomorphism
`QuaternionGroup n →* SU(2)` sending `a i` to `diag (exp (πi i/n), exp (-πi i/n))` and `xa i` to
`!![0, 1; -1, 0]` times that matrix. -/
noncomputable def binaryDihedralHom : QuaternionGroup n →* SU2 where
  toFun := binaryDihedralFun n
  map_one' := by
    rw [one_def]
    simp only [binaryDihedralFun, AddChar.map_zero_eq_one, map_one]
  map_mul' := binaryDihedralFun_mul n

@[simp]
theorem binaryDihedralHom_a (i : ZMod (2 * n)) :
    binaryDihedralHom n (a i) = torusHom (ZMod.toCircle i) := (rfl)

@[simp]
theorem binaryDihedralHom_xa (i : ZMod (2 * n)) :
    binaryDihedralHom n (xa i) = weylElement⁻¹ * torusHom (ZMod.toCircle i) := (rfl)

/-- The binary dihedral representation of the dicyclic group is faithful. -/
theorem binaryDihedralHom_injective : Function.Injective (binaryDihedralHom n) := by
  refine (injective_iff_map_eq_one _).mpr fun g hg => ?_
  cases g with
  | a i =>
    rw [binaryDihedralHom_a, ← map_one torusHom,
      ← AddChar.map_zero_eq_one (ZMod.toCircle (N := 2 * n))] at hg
    rw [ZMod.injective_toCircle (torusHom_injective hg), a_zero]
  | xa i =>
    rw [binaryDihedralHom_xa, inv_mul_eq_one] at hg
    exact absurd (hg ▸ torusHom_mem_torus _) weylElement_notMem_torus

/-! ### The rotation generator -/

/-- The rotation generator `r = diag (exp (πi/n), exp (-πi/n))` of the binary dihedral group of
order `4n`. -/
noncomputable def binaryDihedralRotation : SU2 := binaryDihedralHom n (a 1)

theorem binaryDihedralRotation_def :
    binaryDihedralRotation n = torusHom (ZMod.toCircle (1 : ZMod (2 * n))) := (rfl)

/-- The diagonal entries of the rotation generator are `exp (πi/n)` and `exp (-πi/n)`. -/
theorem coe_binaryDihedralRotation :
    (binaryDihedralRotation n : Matrix (Fin 2) (Fin 2) ℂ) =
      Matrix.diagonal ![Complex.exp (π * Complex.I / n), Complex.exp (-(π * Complex.I / n))] := by
  have hn : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne n)
  have h : (ZMod.toCircle (1 : ZMod (2 * n)) : ℂ) = Complex.exp (π * Complex.I / n) := by
    have := ZMod.toCircle_natCast (N := 2 * n) 1
    rw [Nat.cast_one] at this
    rw [this]
    congr 1
    push_cast
    field_simp
  rw [binaryDihedralRotation_def, coe_torusHom]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [torusMatrix_apply_zero_zero, torusMatrix_apply_one_one, torusMatrix_apply_zero_one,
      torusMatrix_apply_one_zero, h, Complex.exp_neg]

/-- In quaternion coordinates the rotation generator is `cos (π/n) + sin (π/n) i`. -/
theorem coe_binaryDihedralRotation_eq_toComplexMatrix :
    (binaryDihedralRotation n : Matrix (Fin 2) (Fin 2) ℂ) =
      Quaternion.toComplexMatrix ⟨Real.cos (π / n), Real.sin (π / n), 0, 0⟩ := by
  have hexp : Complex.exp (π * Complex.I / n) =
      (Real.cos (π / n) : ℂ) + Real.sin (π / n) * Complex.I := by
    rw [show (π : ℂ) * Complex.I / n = ((π / n : ℝ) : ℂ) * Complex.I by push_cast; ring,
      Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
  have hexp' : Complex.exp (-(π * Complex.I / n)) =
      (Real.cos (π / n) : ℂ) - Real.sin (π / n) * Complex.I := by
    rw [show -((π : ℂ) * Complex.I / n) = ((-(π / n) : ℝ) : ℂ) * Complex.I by push_cast; ring,
      Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_neg, Real.sin_neg]
    push_cast
    ring
  rw [coe_binaryDihedralRotation, Quaternion.toComplexMatrix_apply]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [hexp, hexp']

/-- The rotations of the binary dihedral group are the powers of the rotation generator. -/
theorem binaryDihedralHom_a_eq_pow (i : ZMod (2 * n)) :
    binaryDihedralHom n (a i) = binaryDihedralRotation n ^ i.val := by
  rw [binaryDihedralRotation, ← map_pow, a_one_pow, ZMod.natCast_zmod_val]

/-- The elements of the second coset are `s r ^ i`. -/
theorem binaryDihedralHom_xa_eq_mul_pow (i : ZMod (2 * n)) :
    binaryDihedralHom n (xa i) = weylElement⁻¹ * binaryDihedralRotation n ^ i.val := by
  rw [← binaryDihedralHom_a_eq_pow, binaryDihedralHom_xa, binaryDihedralHom_a]

/-- The rotation generator has exact order `2n`. -/
@[simp]
theorem orderOf_binaryDihedralRotation : orderOf (binaryDihedralRotation n) = 2 * n := by
  rw [binaryDihedralRotation, orderOf_injective _ (binaryDihedralHom_injective n), orderOf_a_one]

/-- The rotation generator satisfies `r ^ (2n) = 1`. -/
theorem binaryDihedralRotation_pow_two_mul : binaryDihedralRotation n ^ (2 * n) = 1 := by
  rw [binaryDihedralRotation, ← map_pow, a_one_pow_n, map_one]

/-- The two generators satisfy `s² = r ^ n`. -/
theorem weylElement_inv_sq_eq_binaryDihedralRotation_pow :
    weylElement⁻¹ ^ 2 = binaryDihedralRotation n ^ n := by
  rw [weylElement_inv_sq_eq_torusHom n, ← binaryDihedralHom_a, binaryDihedralRotation, ← map_pow,
    a_one_pow]

/-- The rotation generator satisfies `r ^ n = -1`. -/
theorem coe_binaryDihedralRotation_pow_self :
    ((binaryDihedralRotation n ^ n : SU2) : Matrix (Fin 2) (Fin 2) ℂ) = -1 := by
  rw [← weylElement_inv_sq_eq_binaryDihedralRotation_pow, coe_weylElement_inv_sq]

/-- Conjugation by `s` inverts the rotation generator: `s r s⁻¹ = r⁻¹`. -/
theorem weylElement_inv_conj_binaryDihedralRotation :
    weylElement⁻¹ * binaryDihedralRotation n * weylElement = (binaryDihedralRotation n)⁻¹ := by
  rw [← inv_inv weylElement, binaryDihedralRotation_def, mul_inv_eq_iff_eq_mul, ← map_inv,
    torusHom_mul_weylElement_inv, inv_inv, inv_inv]

/-! ### The binary dihedral subgroup -/

/-- **The binary dihedral subgroup of `SU(2)` of order `4n`**, the image of the faithful
representation `TauCeti.SU2.binaryDihedralHom` of the dicyclic group. -/
noncomputable def binaryDihedralSubgroup : Subgroup SU2 := (binaryDihedralHom n).range

/-- The binary dihedral subgroup is isomorphic to the dicyclic group `QuaternionGroup n`. -/
noncomputable def binaryDihedralEquiv : QuaternionGroup n ≃* binaryDihedralSubgroup n :=
  MonoidHom.ofInjective (binaryDihedralHom_injective n)

@[simp]
theorem coe_binaryDihedralEquiv (g : QuaternionGroup n) :
    (binaryDihedralEquiv n g : SU2) = binaryDihedralHom n g := (rfl)

instance : Finite (binaryDihedralSubgroup n) := Finite.of_equiv _ (binaryDihedralEquiv n).toEquiv

/-- **The binary dihedral subgroup has exactly `4n` elements.** -/
@[simp]
theorem natCard_binaryDihedralSubgroup : Nat.card (binaryDihedralSubgroup n) = 4 * n := by
  rw [← Nat.card_congr (binaryDihedralEquiv n).toEquiv, Nat.card_eq_fintype_card, card]

@[simp]
theorem binaryDihedralRotation_mem_binaryDihedralSubgroup :
    binaryDihedralRotation n ∈ binaryDihedralSubgroup n :=
  ⟨a 1, rfl⟩

@[simp]
theorem weylElement_mem_binaryDihedralSubgroup : weylElement ∈ binaryDihedralSubgroup n :=
  inv_mem_iff.mp ⟨xa 0, by simp⟩

/-- **Normal forms in the binary dihedral subgroup.** Every element is `r ^ j` or `s r ^ j` for
some `j < 2n`. -/
theorem mem_binaryDihedralSubgroup_iff {g : SU2} :
    g ∈ binaryDihedralSubgroup n ↔ ∃ j < 2 * n,
      g = binaryDihedralRotation n ^ j ∨ g = weylElement⁻¹ * binaryDihedralRotation n ^ j := by
  constructor
  · rintro ⟨x, rfl⟩
    cases x with
    | a i => exact ⟨i.val, ZMod.val_lt i, .inl (binaryDihedralHom_a_eq_pow n i)⟩
    | xa i => exact ⟨i.val, ZMod.val_lt i, .inr (binaryDihedralHom_xa_eq_mul_pow n i)⟩
  · rintro ⟨j, -, rfl | rfl⟩
    · exact pow_mem (binaryDihedralRotation_mem_binaryDihedralSubgroup n) j
    · exact mul_mem (inv_mem (weylElement_mem_binaryDihedralSubgroup n))
        (pow_mem (binaryDihedralRotation_mem_binaryDihedralSubgroup n) j)

/-- A rotation `r ^ j` is never of the form `s r ^ k`. -/
theorem binaryDihedralRotation_pow_ne_weylElement_inv_mul (j k : ℕ) :
    binaryDihedralRotation n ^ j ≠ weylElement⁻¹ * binaryDihedralRotation n ^ k := by
  intro h
  rw [binaryDihedralRotation, ← map_pow, ← map_pow, a_one_pow, a_one_pow,
    show weylElement⁻¹ = binaryDihedralHom n (xa 0) by simp, ← map_mul, xa_mul_a] at h
  simpa using binaryDihedralHom_injective n h

/-- **The binary dihedral subgroup is generated by `r` and `s`.** -/
theorem binaryDihedralSubgroup_eq_closure :
    binaryDihedralSubgroup n =
      Subgroup.closure {binaryDihedralRotation n, weylElement⁻¹} := by
  refine le_antisymm (fun g hg => ?_) ?_
  · obtain ⟨j, -, rfl | rfl⟩ := (mem_binaryDihedralSubgroup_iff n).mp hg
    · exact pow_mem (Subgroup.subset_closure (by simp)) j
    · exact mul_mem (Subgroup.subset_closure (by simp))
        (pow_mem (Subgroup.subset_closure (by simp)) j)
  · rw [Subgroup.closure_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨binaryDihedralRotation_mem_binaryDihedralSubgroup n,
      inv_mem (weylElement_mem_binaryDihedralSubgroup n)⟩

/-- For `n = 1` the binary dihedral subgroup is cyclic of order four. -/
instance : IsCyclic (binaryDihedralSubgroup 1) :=
  have := quaternionGroup_one_isCyclic
  isCyclic_of_surjective (binaryDihedralEquiv 1).toMonoidHom (binaryDihedralEquiv 1).surjective

end TauCeti.SU2
