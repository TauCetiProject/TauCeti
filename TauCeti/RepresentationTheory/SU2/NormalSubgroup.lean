/-!
# The normal subgroups of `SU(2)` and kernels of its homomorphisms

The centre of `SU(2)` is `{1, -1}` (`TauCeti.SU2.ker_toSO3` and `TauCeti.SU2.toSO3_eq_one_iff`).
This file proves that every noncentral normal subgroup of `SU(2)`, that is, every normal subgroup
not contained in the centre, is the whole group, so the normal subgroups of `SU(2)` are exactly
`⊥`, the centre and `⊤` (`TauCeti.SU2.eq_bot_or_eq_center_or_eq_top_of_normal`). No closedness is
assumed; the statement is about abstract normal subgroups.

The consequence for homomorphisms is the kernel bound for rank-one maps out of `SU(2)`: every
homomorphism `φ : SU(2) →* G` to any monoid is either trivial or has kernel contained in
`{1, -1}` (`TauCeti.SU2.ker_le_center_iff`), so the kernel of a nontrivial homomorphism is `⊥` or
the centre (`TauCeti.SU2.ker_eq_bot_or_eq_center`). In particular, if `G` is a manifold and the
curve `t ↦ φ (diag (e^{it}, e^{-it}))` has a nonzero derivative at `0`, then `ker φ ⊆ {1, -1}`
(`TauCeti.SU2.ker_le_center_of_mfderiv_ne_zero`). For a smooth homomorphism this derivative is the
differential of `φ` at the identity evaluated on `diag (i, -i)`; the statement itself assumes no
smoothness of `φ` and no Lie group structure on `G`. The bound is attained by the double cover
`SU(2) → SO(3)`, whose kernel is the whole centre.

## Proof

Let `N` be a normal subgroup containing a noncentral element `g`. For every `h`, the commutator
`g h g⁻¹ h⁻¹` lies in `N`, and its trace is a real number depending continuously on `h`. At
`h = 1` the commutator is `1`, of trace `2`; at an `h₀` not commuting with `g` it is not `1`, so
its trace `m` is smaller than `2` (`TauCeti.SU2.trace_eq_two_iff`). Since `SU(2)` is connected,
the intermediate value theorem shows that every trace in `[m, 2]` is the trace of such a
commutator. Conjugacy classes of `SU(2)` are determined by the trace
(`TauCeti.SU2.isConj_iff_trace_eq`) and `N` is normal, so `N` contains every element whose trace
has real part greater than `m`. This set is a neighbourhood of `1`, and a connected topological
group is generated by any neighbourhood of `1` (`Subgroup.closure_eq_top_of_mem_nhds_one`), so
`N = ⊤`.

## Main results

* `TauCeti.SU2.le_center_or_eq_top_of_normal`: a normal subgroup of `SU(2)` is central or
  everything.
* `TauCeti.SU2.eq_bot_or_eq_center_of_le_center`: a subgroup of the centre is `⊥` or the centre.
* `TauCeti.SU2.eq_bot_or_eq_center_or_eq_top_of_normal`: the normal subgroups of `SU(2)` are `⊥`,
  the centre and `⊤`.
* `TauCeti.SU2.ker_le_center_iff`: a homomorphism out of `SU(2)` has kernel in `{1, -1}` exactly
  when it is nontrivial.
* `TauCeti.SU2.ker_le_center_of_mfderiv_ne_zero`: the kernel bound from a nonzero derivative along
  the maximal torus.

## References

* J. Stillwell, *Naive Lie Theory*, Springer Undergraduate Texts in Mathematics (2008),
  Chapter 2 (the groups `SU(2)` and `SO(3)`, and the simplicity of `SO(3)`).
* T. Bröcker, T. tom Dieck, *Representations of Compact Lie Groups*, Springer GTM 98 (1985),
  Chapter I.
-/

public section

namespace TauCeti

namespace SU2

open scoped Manifold

/-- **A normal subgroup of `SU(2)` is central or everything.** A normal subgroup containing a
noncentral element contains every element whose trace is close enough to `2`, hence a
neighbourhood of `1`, and so it is all of the connected group `SU(2)`. -/
theorem le_center_or_eq_top_of_normal {N : Subgroup SU2} [hN : N.Normal] :
    N ≤ Subgroup.center SU2 ∨ N = ⊤ := by
  refine or_iff_not_imp_left.mpr fun hle => ?_
  obtain ⟨g, hgN, hg⟩ := IsConcreteLE.not_le_iff_exists.mp hle
  obtain ⟨h₀, hh₀⟩ : ∃ h₀ : SU2, g * h₀ * g⁻¹ * h₀⁻¹ ≠ 1 := by
    by_contra! hcomm
    refine hg (Subgroup.mem_center_iff.mpr fun h => ?_)
    have hgh := hcomm h
    rw [mul_inv_eq_one, mul_inv_eq_iff_eq_mul] at hgh
    exact hgh.symm
  -- The real trace of the commutator `[g, h]`, a continuous function of `h`.
  let c : SU2 → ℝ := fun h =>
    (Matrix.trace ((g * h * g⁻¹ * h⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ)).re
  have hc : Continuous c := by fun_prop
  have hcN (h : SU2) : g * h * g⁻¹ * h⁻¹ ∈ N := by
    rw [show g * h * g⁻¹ * h⁻¹ = g * (h * g⁻¹ * h⁻¹) by group]
    exact N.mul_mem hgN (hN.conj_mem _ (N.inv_mem hgN) h)
  -- Every element whose trace has real part greater than `c h₀` is conjugate to a commutator.
  have hsub : {x : SU2 | c h₀ < (Matrix.trace (x : Matrix (Fin 2) (Fin 2) ℂ)).re} ⊆ N := by
    intro x hx
    have hc1 : c 1 = 2 := by
      simp only [c, mul_one, inv_one, mul_inv_cancel]
      simp [Matrix.trace_one]
    obtain ⟨h, hh⟩ := intermediate_value_univ h₀ 1 hc ⟨le_of_lt hx, hc1 ▸ re_trace_le_two x⟩
    obtain ⟨u, hu⟩ := isConj_iff.mp (isConj_of_re_trace_eq hh)
    exact hu ▸ hN.conj_mem _ (hcN h) u
  have hnhds : (N : Set SU2) ∈ nhds (1 : SU2) := by
    refine Filter.mem_of_superset ((isOpen_lt continuous_const ?_).mem_nhds ?_) hsub
    · fun_prop
    · exact (re_trace_lt_two hh₀).trans_le (by simp [Matrix.trace_one])
  rw [← Subgroup.closure_eq_top_of_mem_nhds_one hnhds, Subgroup.closure_eq]

/-- **A subgroup of the centre `{1, -1}` of `SU(2)` is `⊥` or the centre.** -/
theorem eq_bot_or_eq_center_of_le_center {K : Subgroup SU2} (hK : K ≤ Subgroup.center SU2) :
    K = ⊥ ∨ K = Subgroup.center SU2 := by
  refine K.bot_or_exists_ne_one.imp_right fun ⟨k, hkK, hk⟩ => le_antisymm hK fun z hz => ?_
  rw [← ker_toSO3, MonoidHom.mem_ker, toSO3_eq_one_iff] at hz
  have hkc : k ∈ toSO3.ker := by
    rw [ker_toSO3]
    exact hK hkK
  have hk' := (toSO3_eq_one_iff k).mp hkc
  rcases hz with hz | hz
  · rw [show z = 1 from Subtype.ext hz]
    exact K.one_mem
  · rcases hk' with hk' | hk'
    · exact absurd (Subtype.ext hk') hk
    · rwa [show z = k from Subtype.ext (hz.trans hk'.symm)]

/-- **The normal subgroups of `SU(2)` are `⊥`, the centre `{1, -1}` and `⊤`.** -/
theorem eq_bot_or_eq_center_or_eq_top_of_normal {N : Subgroup SU2} [N.Normal] :
    N = ⊥ ∨ N = Subgroup.center SU2 ∨ N = ⊤ :=
  le_center_or_eq_top_of_normal.elim
    (fun h => (eq_bot_or_eq_center_of_le_center h).elim Or.inl (Or.inr ∘ Or.inl))
    (Or.inr ∘ Or.inr)

/-- **A homomorphism out of `SU(2)` has kernel in the centre `{1, -1}` exactly when it is
nontrivial.** -/
theorem ker_le_center_iff {G : Type*} [MulOneClass G] {φ : SU2 →* G} :
    φ.ker ≤ Subgroup.center SU2 ↔ φ ≠ 1 := by
  refine ⟨fun h hφ => center_ne_top (top_le_iff.mp ?_), fun hφ => ?_⟩
  · rwa [hφ, MonoidHom.ker_one] at h
  · refine (le_center_or_eq_top_of_normal (N := φ.ker)).resolve_right fun h => hφ ?_
    ext g
    exact MonoidHom.mem_ker.mp (h ▸ Subgroup.mem_top g)

/-- **The kernel of a nontrivial homomorphism out of `SU(2)` is `⊥` or the centre `{1, -1}`.** -/
theorem ker_eq_bot_or_eq_center {G : Type*} [MulOneClass G] {φ : SU2 →* G} (hφ : φ ≠ 1) :
    φ.ker = ⊥ ∨ φ.ker = Subgroup.center SU2 :=
  eq_bot_or_eq_center_of_le_center (ker_le_center_iff.mpr hφ)

/-- **Kernel bound for rank-one maps.** Let `φ : SU(2) →* G` be a homomorphism into a manifold
`G` such that the curve `t ↦ φ (diag (e^{it}, e^{-it}))` has a nonzero derivative at `t = 0`,
as it does when `φ` is smooth with differential at the identity nonzero on `diag (i, -i)`. Then
the kernel of `φ` is contained in the centre `{1, -1}` of `SU(2)`. -/
theorem ker_le_center_of_mfderiv_ne_zero {E H G : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [TopologicalSpace G]
    [ChartedSpace H G] [MulOneClass G] {φ : SU2 →* G}
    (h : mfderiv 𝓘(ℝ) I (fun t : ℝ => φ (torusExp t)) 0 ≠ 0) :
    φ.ker ≤ Subgroup.center SU2 := by
  refine ker_le_center_iff.mpr fun hφ => h ?_
  subst hφ
  exact mfderiv_const

end SU2

end TauCeti
