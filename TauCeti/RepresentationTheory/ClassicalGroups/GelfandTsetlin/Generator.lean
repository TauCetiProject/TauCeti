/-!
# The Gelfand–Tsetlin generators act on the Gelfand–Tsetlin lines by scalars

The rational Weyl module `V_λ` of `GL n ℂ` is a module over the universal enveloping algebra
`U(𝔤𝔩ₙ)` through its differential (`TauCeti.IsRationalRep.differential`). The Gelfand–Tsetlin
generators `TauCeti.gelfandTsetlinGenerator` of `U(𝔤𝔩ₙ)` are the images of the Gelfand invariants
`Cᵣ = trace (𝔼 ^ r)` of the upper-left corners `𝔤𝔩ₖ ⊆ 𝔤𝔩ₙ`, and they pairwise commute. This file
shows that they are simultaneously diagonalized by the Gelfand–Tsetlin decomposition
`V_λ = ⨁_P gtLine λ P` (`TauCeti.isInternal_gtLine`): the generator of level `k` and degree `r`
acts on the line of a pattern `P` by the scalar

`gelfandEigenvalue (P₀ₖ, …, Pₖ₋₁ₖ) r`,

the eigenvalue of `Cᵣ` on a highest weight vector for `𝔤𝔩ₖ` whose weight is the row of length `k`
of `P` (`TauCeti.lift_differential_gelfandTsetlinGenerator_apply_of_mem_gtLine`). Every nonzero
vector of a Gelfand–Tsetlin line is therefore a joint eigenvector of all the Gelfand–Tsetlin
generators, and by `TauCeti.GTPattern.eq_of_forall_gelfandEigenvalue_eq` the eigencharacters of
the lines of two distinct patterns are distinct.

## The argument

At the top level `k = n` the generators are the Gelfand invariants of `𝔤𝔩ₙ` itself, which are
central in `U(𝔤𝔩ₙ)`. An irreducible rational representation is irreducible for `𝔤𝔩ₙ`
(`TauCeti.IsRationalRep.isIrreducible_differential`) and is generated by a highest weight vector,
on which `Cᵣ` acts by its highest-weight eigenvalue
(`TauCeti.gelfandInvariant_smul_of_isGlHighestWeightVector`), so `Cᵣ` acts by that scalar everywhere
(`TauCeti.IsRationalRep.lift_differential_gelfandInvariant_apply`).

Below the top level, the line of a pattern with `n + 1` rows is the image of the line of its
truncation under an intertwiner `f` from the Weyl module `V_μ` of the second row to the
restriction of `V_λ` to `GL n ℂ` (`TauCeti.gtLine_succ`). The differential of that restriction is
the differential of `V_λ` on the upper-left corner `𝔤𝔩ₙ ⊆ 𝔤𝔩ₙ₊₁`
(`TauCeti.IsRationalRep.differential_comp_glBlockSucc`), so `f` intertwines the enveloping-algebra
action of `U(𝔤𝔩ₙ)` on `V_μ` with that of its image in `U(𝔤𝔩ₙ₊₁)` on `V_λ`, and the Gelfand–Tsetlin
generators of `U(𝔤𝔩ₙ)` map to those of `U(𝔤𝔩ₙ₊₁)`
(`TauCeti.map_glEmbedding_castSuccEmb_gelfandTsetlinGenerator`). Induction on `n` concludes.

## Main results

* `TauCeti.IsRationalRep.lift_differential_gelfandInvariant_apply`: on an irreducible rational
  representation with a highest weight vector of weight `λ`, the Gelfand invariant `Cᵣ` acts by
  `gelfandEigenvalue λ r`.
* `TauCeti.lift_differential_gelfandInvariant_rationalWeylRep_apply`: the same on `V_λ`.
* `TauCeti.lift_differential_gelfandTsetlinGenerator_apply_of_mem_gtLine`: **the Gelfand–Tsetlin
  generators act on the Gelfand–Tsetlin line of `P` by the Gelfand-invariant eigenvalues of the
  rows of `P`.**

## References

* I. M. Gelfand and M. L. Tsetlin, *Finite-dimensional representations of the group of unimodular
  matrices*, Doklady Akad. Nauk SSSR **71** (1950), 825–828.
* A. Molev, *Yangians and Classical Lie Algebras*, Mathematical Surveys and Monographs 143,
  American Mathematical Society (2007), Chapter 7.
-/

public section

open Module Representation

attribute [local instance 100] LieRing.ofAssociativeRing

namespace TauCeti

/-! ### The Gelfand invariants on an irreducible rational representation -/

namespace IsRationalRep

variable {n : ℕ} {W : Type*} [AddCommGroup W] [Module ℂ W]
  {ρ : Representation ℂ (GL (Fin n) ℂ) W}

/-- **The Gelfand invariants act on an irreducible rational representation by scalars**: if `ρ`
has a nonzero vector of weight `λ` fixed by every transvection `xᵢⱼ(c)` with `i < j`, the Gelfand
invariant `Cᵣ` of `𝔤𝔩ₙ` acts through the differential of `ρ` by its highest-weight eigenvalue
`gelfandEigenvalue λ r`. -/
theorem lift_differential_gelfandInvariant_apply (hρ : IsRationalRep ρ) [ρ.IsIrreducible]
    {l : Fin n → ℤ} {w₀ : W} (hw₀ : w₀ ≠ 0) (hw₀l : w₀ ∈ weightSpace ρ l)
    (hw₀t : ∀ (i j : Fin n) (hij : i < j) (c : ℂ), ρ (transvectionUnit hij.ne c) w₀ = w₀)
    (r : ℕ) (w : W) :
    _root_.UniversalEnvelopingAlgebra.lift ℂ hρ.differential (gelfandInvariant ℂ (Fin n) r) w =
      gelfandEigenvalue (fun i ↦ (l i : ℂ)) r • w := by
  let _ := LieRingModule.compLieHom W hρ.differential
  let _ := LieModule.compLieHom W hρ.differential
  have _ := hρ.isIrreducible_differential
  have hrep : UniversalEnvelopingAlgebra.representation ℂ (Matrix (Fin n) (Fin n) ℂ) W =
      _root_.UniversalEnvelopingAlgebra.lift ℂ hρ.differential := by
    apply _root_.UniversalEnvelopingAlgebra.hom_ext
    refine LieHom.ext fun X ↦ LinearMap.ext fun w ↦ ?_
    rw [LieHom.comp_apply, LieHom.comp_apply, AlgHom.coe_toLieHom, AlgHom.coe_toLieHom,
      UniversalEnvelopingAlgebra.representation_ι, _root_.UniversalEnvelopingAlgebra.lift_ι_apply,
      LieModule.toEnd_apply_apply, LieRingModule.compLieHom_apply, Module.End.lie_apply]
  rw [← hrep]
  exact gelfandInvariant_smul_of_isGlHighestWeightVector_of_lieSpan_eq_top
    (hρ.isGlHighestWeightVector_differential hw₀ hw₀l hw₀t)
    (lieSpan_singleton_eq_top_of_ne_zero hw₀) r w

end IsRationalRep

variable {n : ℕ}

/-- **The Gelfand invariants act on the rational Weyl module `V_λ` by scalars**: the Gelfand
invariant `Cᵣ` of `𝔤𝔩ₙ` acts on `V_λ` through its differential by `gelfandEigenvalue λ r`. -/
theorem lift_differential_gelfandInvariant_rationalWeylRep_apply (l : DominantWeight n) (r : ℕ)
    (w : (weylModuleOfShape ℂ n l.detShiftShape).toSubmodule) :
    _root_.UniversalEnvelopingAlgebra.lift ℂ (isRationalRep_rationalWeylRep n l).differential
        (gelfandInvariant ℂ (Fin n) r) w =
      gelfandEigenvalue (fun i ↦ (l.1 i : ℂ)) r • w := by
  obtain ⟨w₀, hw₀l, hw₀⟩ := Submodule.exists_mem_ne_zero_of_ne_bot
    (weightSpace_rationalWeylRep_self_ne_bot ℂ l)
  exact (isRationalRep_rationalWeylRep n l).lift_differential_gelfandInvariant_apply hw₀ hw₀l
    (fun i j hij c ↦ rationalWeylRep_apply_transvectionUnit_eq_self l hij hw₀l c) r w

/-- **The Gelfand–Tsetlin generators act on the Gelfand–Tsetlin lines by scalars.** On the line of
a pattern `P` with top weight `λ`, the Gelfand–Tsetlin generator of level `k` and degree `r` acts
through the differential of `V_λ` by `gelfandEigenvalue (P₀ₖ, …, Pₖ₋₁ₖ) r`, the eigenvalue of the
Gelfand invariant `Cᵣ` of `𝔤𝔩ₖ` on a highest weight vector whose weight is the row of length `k`
of `P`. -/
theorem lift_differential_gelfandTsetlinGenerator_apply_of_mem_gtLine (l : DominantWeight n)
    (P : {P : GTPattern n // P.topWeight = l}) {k : ℕ} (hk : k ≤ n) (r : ℕ)
    {v : (weylModuleOfShape ℂ n l.detShiftShape).toSubmodule} (hv : v ∈ gtLine l P) :
    _root_.UniversalEnvelopingAlgebra.lift ℂ (isRationalRep_rationalWeylRep n l).differential
        (gelfandTsetlinGenerator ℂ hk r) v =
      gelfandEigenvalue (fun i : Fin k ↦ (P.1 i k : ℂ)) r • v := by
  -- At the top level the generators are the central Gelfand invariants of `𝔤𝔩ₙ`, and the row of
  -- length `n` of `P` is its top weight `λ`.
  have htop : ∀ {n : ℕ} (l : DominantWeight n) (P : {P : GTPattern n // P.topWeight = l}) (r : ℕ)
      (v : (weylModuleOfShape ℂ n l.detShiftShape).toSubmodule),
      _root_.UniversalEnvelopingAlgebra.lift ℂ (isRationalRep_rationalWeylRep n l).differential
          (gelfandTsetlinGenerator ℂ le_rfl r) v =
        gelfandEigenvalue (fun i : Fin n ↦ (P.1 i n : ℂ)) r • v := by
    rintro n l ⟨P, rfl⟩ r v
    rw [gelfandTsetlinGenerator_self, lift_differential_gelfandInvariant_rationalWeylRep_apply]
    simp only [GTPattern.topWeight_coe, GTPattern.topRow_apply]
  induction n generalizing k with
  | zero =>
    obtain rfl := Nat.le_zero.mp hk
    exact htop l P r v
  | succ n ih =>
    rcases hk.eq_or_lt with rfl | hlt
    · exact htop l P r v
    obtain ⟨P, rfl⟩ := P
    have hk' : k ≤ n := Nat.lt_succ_iff.mp hlt
    obtain ⟨f, hf⟩ := exists_intertwiningMap_rationalWeylRep_comp_glBlockSucc_ne_zero
      P.topWeight_truncate_mem_interlacingWeights
    rw [gtLine_succ _ ⟨P, rfl⟩ f hf] at hv
    obtain ⟨w, hw, rfl⟩ := Submodule.mem_map.mp hv
    -- Move the generator down to `U(𝔤𝔩ₙ)`, where `f` intertwines the two actions.
    have hρ := isRationalRep_rationalWeylRep (n + 1) P.topWeight
    have hσ := isRationalRep_rationalWeylRep n P.truncate.topWeight
    have hiff := IsRationalRep.isIntertwiningMap_iff_forall_map_differential
      (W := (weylModuleOfShape ℂ n P.truncate.topWeight.detShiftShape).toSubmodule)
      (V := (weylModuleOfShape ℂ (n + 1) P.topWeight.detShiftShape).toSubmodule)
      hσ hρ.comp_glBlockSucc f.toLinearMap
    have hint := hiff.mp ⟨f.isIntertwining⟩
    rw [← map_glEmbedding_castSuccEmb_gelfandTsetlinGenerator ℂ hk' r,
      UniversalEnvelopingAlgebra.lift_map, ← IsRationalRep.differential_comp_glBlockSucc]
    have key := UniversalEnvelopingAlgebra.map_lift_apply_of_map_apply
      (V := (weylModuleOfShape ℂ n P.truncate.topWeight.detShiftShape).toSubmodule)
      (W := (weylModuleOfShape ℂ (n + 1) P.topWeight.detShiftShape).toSubmodule)
      (a := hσ.differential) (b := hρ.comp_glBlockSucc.differential) f.toLinearMap hint
      (gelfandTsetlinGenerator ℂ hk' r) w
    -- The row of length `k ≤ n` of `P` is a row of its truncation.
    have hrow :
        (fun i : Fin k ↦ ((P.truncate i k : ℤ) : ℂ)) = fun i : Fin k ↦ ((P i k : ℤ) : ℂ) := by
      funext i
      rw [GTPattern.truncate_apply, ite_eq_left hk']
    rw [ih _ ⟨P.truncate, rfl⟩ hk' hw, map_smul, hrow] at key
    -- `key` is the goal read through the additive group of the Weyl module carriers that
    -- `TauCeti.IsRationalRep` uses, rather than their submodule additive monoid; the two instance
    -- paths agree definitionally.
    exact key.symm

end TauCeti
