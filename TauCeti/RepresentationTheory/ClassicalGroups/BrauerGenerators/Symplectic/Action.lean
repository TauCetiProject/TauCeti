module

public import TauCeti.Algebra.BrauerAlgebra.Generation
public import TauCeti.RepresentationTheory.ClassicalGroups.BrauerGenerators.Symplectic.Crossing
public import TauCeti.RepresentationTheory.ClassicalGroups.BrauerGenerators.Symplectic.Matrix

/-!
# The Brauer algebra acting on a tensor power of the standard symplectic module

Equip `V = (Fin n ⊕ Fin n) → R` with its standard alternating form `Matrix.J (Fin n) R`. A Brauer
diagram `D` on `k` strands acts on the tensor power `⨂[R]^k V` by the Pfaffian-signed action
matrix `TauCeti.BrauerDiagram.symplecticActionMatrix` in the monomial basis
`Basis.piTensorProduct fun _ : Fin k => Pi.basisFun R (Fin n ⊕ Fin n)`. Because these matrices
multiply by the loop rule at the symplectic loop value `δ = -(2 * n : R)`
(`TauCeti.BrauerDiagram.symplecticActionMatrix_mul`), they assemble into an algebra map
`TauCeti.brauerActionSymp` from `BrauerAlgebra R (-(2 * n : R)) k` to the endomorphisms of
`⨂[R]^k V`.

This action extends the two families of symplectic Brauer generators already available:
* on a permutation diagram `permToBrauer σ`, it is the sign-twisted permutation action
  `TauCeti.symplecticPermTensorAction` of `Sₖ` on the tensor factors
  (`TauCeti.brauerActionSymp_of_permToBrauer`), so it restricts along
  `TauCeti.BrauerAlgebra.ofPerm` to `(TauCeti.symplecticPermTensorAction R n k).asAlgebraHom`
  (`TauCeti.brauerActionSymp_comp_ofPerm`);
* on the cap-cup diagram `capCup a b` for distinct strands `a ≠ b`, it is the single-arc generator
  `TauCeti.symplecticCupCapAt` (`TauCeti.brauerActionSymp_of_capCup`).

In particular, on two strands `permToBrauer (Equiv.swap 0 1)` acts by `TauCeti.symplecticCrossing`,
`capCup 0 1` acts by `TauCeti.symplecticCupCap`, and the range of `TauCeti.brauerActionSymp R n 2`
is the subalgebra generated by those two operators (`TauCeti.range_brauerActionSymp_two_eq_adjoin`).
Commutation with the symplectic group and the resulting two-strand commutant theorem live in
`TauCeti/RepresentationTheory/ClassicalGroups/BrauerGenerators/Symplectic/Equivariance.lean`.

## Main definitions

* `TauCeti.brauerActionSymp`: the action of the Brauer algebra `B_k(-2n)` on
  `⨂[R]^k ((Fin n ⊕ Fin n) → R)`.

## Main results

* `TauCeti.brauerActionSymp_of`: a Brauer diagram acts by its matrix
  `TauCeti.BrauerDiagram.symplecticActionMatrix` in the monomial basis.
* `TauCeti.toMatrix_brauerActionSymp`: in the monomial basis, an element of `B_k(-2n)` acts by the
  linear combination of the action matrices weighted by its diagram coefficients.
* `TauCeti.brauerActionSymp_of_permToBrauer` and `TauCeti.brauerActionSymp_comp_ofPerm`: on
  permutation diagrams the action is the sign-twisted permutation action of `Sₖ`.
* `TauCeti.brauerActionSymp_of_capCup`: on a cap-cup diagram on distinct strands the action is the
  single-arc generator `TauCeti.symplecticCupCapAt`.
* `TauCeti.brauerActionSymp_of_permToBrauer_swap_zero_one` and
  `TauCeti.brauerActionSymp_of_capCup_zero_one`: on two strands the transposition and cap-cup
  diagrams act by `TauCeti.symplecticCrossing` and `TauCeti.symplecticCupCap`.
* `TauCeti.range_brauerActionSymp_eq_adjoin` and `TauCeti.range_brauerActionSymp_two_eq_adjoin`:
  the image of `B_k(-2n)` is generated by the sign-twisted permutations and one single-arc
  generator; for `k = 2` it is generated by `TauCeti.symplecticCrossing` and
  `TauCeti.symplecticCupCap`.

## References

* [R. Brauer, *On algebras which are connected with the semisimple continuous groups*][brauer1937],
  Annals of Mathematics 38 (1937), 857-872.
* R. Goodman and N. R. Wallach, *Symmetry, Representations, and Invariants*, Springer GTM 255
  (2009), §10.1.
-/

public section

open scoped Matrix TensorProduct

namespace TauCeti

universe u

variable (R : Type u) [CommRing R] (n k : ℕ)

/-- **The Brauer algebra acting on a tensor power of the standard symplectic module.** The Brauer
algebra `B_k(-2n)` at the symplectic loop value `-(2 * n : R)` acts on
`⨂[R]^k ((Fin n ⊕ Fin n) → R)`: each diagram acts by `TauCeti.BrauerDiagram.symplecticActionMatrix`
in the monomial basis, and these matrices satisfy the loop rule
(`TauCeti.BrauerDiagram.symplecticActionMatrix_mul`). -/
noncomputable def brauerActionSymp :
    BrauerAlgebra R (-(2 * n : R)) k →ₐ[R] Module.End R (⨂[R]^k ((Fin n ⊕ Fin n) → R)) :=
  let b := Basis.piTensorProduct fun _ : Fin k => Pi.basisFun R (Fin n ⊕ Fin n)
  BrauerAlgebra.lift
    (fun D => Matrix.toLin b b (D.symplecticActionMatrix R (Fin n)))
    (by
      rw [BrauerDiagram.symplecticActionMatrix_permToBrauer_one, Matrix.toLin_one,
        Module.End.one_eq_id])
    fun D₁ D₂ => by
      rw [Module.End.mul_eq_comp, ← Matrix.toLin_mul, BrauerDiagram.symplecticActionMatrix_mul,
        Fintype.card_fin, map_smul]

/-- A Brauer diagram acts by its symplectic action matrix in the monomial basis. -/
theorem brauerActionSymp_of (D : BrauerDiagram k) :
    brauerActionSymp R n k (BrauerAlgebra.of D) =
      Matrix.toLin
        (Basis.piTensorProduct fun _ : Fin k => Pi.basisFun R (Fin n ⊕ Fin n))
        (Basis.piTensorProduct fun _ : Fin k => Pi.basisFun R (Fin n ⊕ Fin n))
        (D.symplecticActionMatrix R (Fin n)) :=
  BrauerAlgebra.lift_of ..

/-- **The matrix of the symplectic Brauer action.** In the monomial basis, an element `x` of the
Brauer algebra acts by the combination `∑ D, x.coeff D • M(D)` of the action matrices of the
diagrams. -/
theorem toMatrix_brauerActionSymp (x : BrauerAlgebra R (-(2 * n : R)) k) :
    LinearMap.toMatrix
        (Basis.piTensorProduct fun _ : Fin k => Pi.basisFun R (Fin n ⊕ Fin n))
        (Basis.piTensorProduct fun _ : Fin k => Pi.basisFun R (Fin n ⊕ Fin n))
        (brauerActionSymp R n k x) =
      Finsupp.linearCombination R
        (fun D : BrauerDiagram k => D.symplecticActionMatrix R (Fin n)) x.coeff := by
  let b := Basis.piTensorProduct fun _ : Fin k => Pi.basisFun R (Fin n ⊕ Fin n)
  have h : (LinearMap.toMatrix b b).toLinearMap ∘ₗ (brauerActionSymp R n k).toLinearMap =
      Finsupp.linearCombination R
        (fun D : BrauerDiagram k => D.symplecticActionMatrix R (Fin n)) ∘ₗ
        (BrauerAlgebra.coeffLinearEquiv R (-(2 * n : R)) k).toLinearMap :=
    (BrauerAlgebra.basis R (-(2 * n : R)) k).ext fun D => by
      simp [b, BrauerAlgebra.basis_apply, brauerActionSymp_of, BrauerAlgebra.coeffLinearEquiv_apply]
  simpa using LinearMap.congr_fun h x

/-- **Permutation diagrams act by the sign-twisted permutation action.** The diagram
`permToBrauer σ` acts on `⨂[R]^k ((Fin n ⊕ Fin n) → R)` as `σ` does in
`TauCeti.symplecticPermTensorAction`. -/
@[simp]
theorem brauerActionSymp_of_permToBrauer (σ : Equiv.Perm (Fin k)) :
    brauerActionSymp R n k (BrauerAlgebra.of (permToBrauer σ)) =
      symplecticPermTensorAction R n k σ := by
  let b := Basis.piTensorProduct fun _ : Fin k => Pi.basisFun R (Fin n ⊕ Fin n)
  have hb (u : Fin k → Fin n ⊕ Fin n) : b u = PiTensorProduct.tprod R fun t =>
      (Pi.single (u t) (1 : R) : (Fin n ⊕ Fin n) → R) := by
    simp [b, Basis.piTensorProduct_apply]
  refine b.ext fun u => ?_
  rw [brauerActionSymp_of, Matrix.toLin_self]
  simp_rw [BrauerDiagram.symplecticActionMatrix_permToBrauer, ite_smul, zero_smul]
  rw [Finset.sum_ite_eq', ite_eq_left (Finset.mem_univ _), hb (u ∘ σ.symm), hb u,
    symplecticPermTensorAction_tprod]
  rfl

/-- **The action restricts to the sign-twisted symmetric group algebra.** Along the embedding
`TauCeti.BrauerAlgebra.ofPerm` of the group algebra of `Sₖ`, the symplectic Brauer action is the
algebra map `(TauCeti.symplecticPermTensorAction R n k).asAlgebraHom`. -/
theorem brauerActionSymp_comp_ofPerm :
    (brauerActionSymp R n k).comp (BrauerAlgebra.ofPerm R (-(2 * n : R)) k) =
      (symplecticPermTensorAction R n k).asAlgebraHom := by
  refine MonoidAlgebra.algHom_ext (fun σ => ?_) (by ext)
  rw [AlgHom.comp_apply, BrauerAlgebra.ofPerm_single, map_smul, one_smul,
    brauerActionSymp_of_permToBrauer, Representation.asAlgebraHom_single_one]

/-- **Cap-cup diagrams act by the single-arc generators.** On two distinct strands `a ≠ b`, the
cap-cup diagram acts on `⨂[R]^k ((Fin n ⊕ Fin n) → R)` as `TauCeti.symplecticCupCapAt`. -/
@[simp]
theorem brauerActionSymp_of_capCup {a b : Fin k} (hab : a ≠ b) :
    brauerActionSymp R n k (BrauerAlgebra.of (capCup a b)) = symplecticCupCapAt R n k a b := by
  let b' := Basis.piTensorProduct fun _ : Fin k => Pi.basisFun R (Fin n ⊕ Fin n)
  apply (LinearMap.toMatrix b' b').injective
  ext v u
  rw [brauerActionSymp_of, LinearMap.toMatrix_toLin,
    BrauerDiagram.symplecticActionMatrix_capCup R (Fin n) hab, LinearMap.toMatrix_apply,
    piTensorProduct_repr_symplecticCupCapAt_piTensorProduct hab]

/-- **On two strands, the transposition diagram acts by `TauCeti.symplecticCrossing`.** -/
theorem brauerActionSymp_of_permToBrauer_swap_zero_one :
    brauerActionSymp R n 2 (BrauerAlgebra.of (permToBrauer (Equiv.swap (0 : Fin 2) 1))) =
      symplecticCrossing R n := by
  rw [brauerActionSymp_of_permToBrauer, symplecticPermTensorAction_swap_zero_one]

/-- **On two strands, the cap-cup diagram acts by `TauCeti.symplecticCupCap`.** -/
theorem brauerActionSymp_of_capCup_zero_one :
    brauerActionSymp R n 2 (BrauerAlgebra.of (capCup (0 : Fin 2) 1)) = symplecticCupCap R n := by
  rw [brauerActionSymp_of_capCup R n 2 (by decide), symplecticCupCapAt_zero_one]

/-- **The image of the symplectic Brauer algebra is generated by the sign-twisted permutations and
one single-arc generator.** -/
theorem range_brauerActionSymp_eq_adjoin {a b : Fin k} (hab : a ≠ b) :
    (brauerActionSymp R n k).range =
      Algebra.adjoin R
        (insert (symplecticCupCapAt R n k a b) (Set.range (symplecticPermTensorAction R n k))) := by
  rw [← Algebra.map_top,
    ← BrauerAlgebra.adjoin_insert_of_capCup_range_of_permToBrauer R (-(2 * n : R)) hab,
    AlgHom.map_adjoin, Set.image_insert_eq, ← Set.range_comp, brauerActionSymp_of_capCup R n k hab]
  simp only [Function.comp_def, brauerActionSymp_of_permToBrauer]

/-- **On two strands, the image of `B₂(-2n)` is generated by `TauCeti.symplecticCrossing` and
`TauCeti.symplecticCupCap`.** -/
theorem range_brauerActionSymp_two_eq_adjoin :
    (brauerActionSymp R n 2).range =
      Algebra.adjoin R {symplecticCrossing R n, symplecticCupCap R n} := by
  rw [range_brauerActionSymp_eq_adjoin R n 2 (a := 0) (b := 1) (by decide),
    symplecticCupCapAt_zero_one]
  refine le_antisymm ?_ ?_
  · rw [Algebra.adjoin_le_iff]
    rintro _ (rfl | ⟨σ, rfl⟩)
    · exact Algebra.subset_adjoin (by simp)
    · have hfin2 (x : Fin 2) : x = 0 ∨ x = 1 := by fin_cases x <;> simp
      have hσ : σ = 1 ∨ σ = Equiv.swap (0 : Fin 2) 1 := by
        rcases hfin2 (σ 0) with h0 | h0
        · left
          refine Equiv.ext fun i => ?_
          fin_cases i
          · exact h0
          · rcases hfin2 (σ 1) with h1 | h1
            · exact absurd (σ.injective (h1.trans h0.symm)) (by decide)
            · exact h1
        · right
          refine Equiv.ext fun i => ?_
          fin_cases i
          · exact h0
          · rcases hfin2 (σ 1) with h1 | h1
            · exact h1
            · exact absurd (σ.injective (h1.trans h0.symm)) (by decide)
      rcases hσ with rfl | rfl
      · rw [map_one]
        exact Subalgebra.one_mem _
      · rw [symplecticPermTensorAction_swap_zero_one]
        exact Algebra.subset_adjoin (by simp)
  · rw [Algebra.adjoin_le_iff]
    rintro _ (rfl | rfl)
    · exact Algebra.subset_adjoin (Or.inr ⟨Equiv.swap 0 1,
        symplecticPermTensorAction_swap_zero_one⟩)
    · exact Algebra.subset_adjoin (Or.inl rfl)

end TauCeti
