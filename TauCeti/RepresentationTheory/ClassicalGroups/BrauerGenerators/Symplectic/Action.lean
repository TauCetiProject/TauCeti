module

public import TauCeti.Algebra.BrauerAlgebra.Basic
public import TauCeti.RepresentationTheory.ClassicalGroups.BrauerGenerators.Symplectic.Crossing

import TauCeti.Algebra.BrauerAlgebra.Generation
import TauCeti.Algebra.BrauerAlgebra.Presentation

/-!
# The Brauer algebra acting on a tensor power of a symplectic space

Equip `V = k^{2n}` (`(Fin n ⊕ Fin n) → k`) with its standard alternating bilinear form, given by
`Matrix.J (Fin n) k`, whose inverse-form copairing has matrix `-Matrix.J (Fin n) k`. Unlike the
orthogonal action on `(kⁿ)^{⊗d}`, where a permutation diagram simply permutes tensor factors and
every diagram has a `{0, 1}`-matrix in the monomial basis, the alternating form forces signs:

* a permutation diagram `permToBrauer σ` acts by the sign-twisted permutation representation
  `TauCeti.symplecticPermTensorAction k n d σ`, multiplying the reindexing of the tensor slots by
  `sign σ` so that the crossing of the two endpoints of an arc absorbs rather than negates the arc;
* a cap-cup diagram `capCup i j` on distinct strands `i ≠ j` acts by the single-arc operator
  `TauCeti.symplecticCupCapAt k n d i j`, contracting slots `i` and `j` against `J` and inserting
  the copairing `-J`, so that closing a loop evaluates to `-2n = -dim V`.

Rather than assigning orientation signs to arbitrary stacked diagrams by hand, this file feeds the
six generator relations proved in
`TauCeti/RepresentationTheory/ClassicalGroups/BrauerGenerators/Symplectic/TensorPower.lean` and
`TauCeti/RepresentationTheory/ClassicalGroups/BrauerGenerators/Symplectic/Crossing.lean` into the
presentation universal property `TauCeti.BrauerAlgebra.liftOfPermCapCup` to obtain the `k`-algebra
homomorphism `TauCeti.brauerActionSymp` from `B_d(-2n)` to the endomorphisms of `V^{⊗d}`.

In the monomial basis `Basis.piTensorProduct fun _ => Pi.basisFun k (Fin n ⊕ Fin n)`, each
permutation diagram has signed permutation matrix whose transpose (and conjugate transpose, for any
star ring structure on `k`) is the matrix of the inverse permutation, and each arc has a Hermitian
integer-valued matrix (`TauCeti.isHermitian_toMatrix_symplecticCupCapAt`). Inducting along loop-free
cap-cup stacks shows that reflecting any Brauer diagram (`TauCeti.BrauerDiagram.flip`) transposes
and conjugate-transposes its matrix (`TauCeti.transpose_toMatrix_brauerActionSymp_of`,
`TauCeti.conjTranspose_toMatrix_brauerActionSymp_of`).

## Main definitions

* `TauCeti.brauerActionSymp`: the action of the Brauer algebra `B_d(-2n)` on `(k^{2n})^{⊗d}`.

## Main results

* `TauCeti.brauerActionSymp_of_permToBrauer` and `TauCeti.brauerActionSymp_comp_ofPerm`: on the
  permutation diagrams the action is `TauCeti.symplecticPermTensorAction`, restricting along
  `TauCeti.BrauerAlgebra.ofPerm` to `(symplecticPermTensorAction k n d).asAlgebraHom`.
* `TauCeti.brauerActionSymp_of_capCup`: on a cap-cup diagram at distinct strands the action is
  `TauCeti.symplecticCupCapAt`.
* `TauCeti.eq_brauerActionSymp`: uniqueness of `TauCeti.brauerActionSymp` from its values on the
  permutation and cap-cup diagrams.
* `TauCeti.brauerActionSymp_two_of_permToBrauer_swap` and
  `TauCeti.brauerActionSymp_two_of_capCup_zero_one`: on two strands the generators reproduce
  `TauCeti.symplecticCrossing` and `TauCeti.symplecticCupCap`.
* `TauCeti.range_brauerActionSymp_eq_adjoin_union`, `TauCeti.range_brauerActionSymp_eq_adjoin`,
  and `TauCeti.range_brauerActionSymp_two_eq_adjoin`: the image of `B_d(-2n)` is generated by the
  sign-twisted permutations and the arcs `i ≠ j` for every `d`, by the sign-twisted permutations
  and a single arc when `i ≠ j` exists, and at `d = 2` by `TauCeti.symplecticCrossing` and
  `TauCeti.symplecticCupCap`.
* `TauCeti.conjTranspose_toMatrix_brauerActionSymp_of` and
  `TauCeti.transpose_toMatrix_brauerActionSymp_of`: reflecting a Brauer diagram conjugate-transposes
  and transposes its matrix in the monomial basis.

## References

* [R. Brauer, *On algebras which are connected with the semisimple continuous groups*][brauer1937],
  Annals of Mathematics 38 (1937), 857-872.
* R. Dipper, S. Doty, and J. Hu, *Brauer algebras, symplectic Schur algebras and Schur-Weyl
  duality*, Transactions of the American Mathematical Society 360 (2008), 189-213, §1.
* R. Goodman and N. R. Wallach, *Symmetry, Representations, and Invariants*, Springer GTM 255
  (2009), Chapter 10.
-/

public section

open scoped Matrix TensorProduct

namespace TauCeti

universe u

variable (k : Type u) [CommRing k] (n d : ℕ)

/-- **The Brauer algebra acting on a tensor power of `k^{2n}`.** The Brauer algebra `B_d(-2n)` at
the symplectic loop value `δ = -2n = -dim k^{2n}` acts on `(k^{2n})^{⊗d}` through the standard
alternating form: permutation diagrams act by the sign-twisted permutation representation
`TauCeti.symplecticPermTensorAction`, and cap-cup diagrams on distinct strands act by the
single-arc operators `TauCeti.symplecticCupCapAt`. -/
noncomputable def brauerActionSymp :
    BrauerAlgebra k (-(2 * n : k)) d →ₐ[k] Module.End k (⨂[k]^d ((Fin n ⊕ Fin n) → k)) :=
  BrauerAlgebra.liftOfPermCapCup
    (symplecticPermTensorAction k n d)
    (symplecticCupCapAt k n d)
    (fun i j => symplecticCupCapAt_comm i j)
    (fun _ => symplecticCupCapAt_mul_self)
    (fun hip hiq hjp hjq => commute_symplecticCupCapAt_of_disjoint hip hiq hjp hjq)
    (fun σ {i j} _ => symplecticPermTensorAction_mul_symplecticCupCapAt σ i j)
    (fun {i j} _ => symplecticPermTensorAction_swap_mul_symplecticCupCapAt i j)
    (fun hij hjl hil => symplecticCupCapAt_mul_symplecticCupCapAt hij hjl hil)

/-- **Permutation diagrams act by the sign-twisted permutation representation.** The diagram of `σ`
acts on `(k^{2n})^{⊗d}` by `TauCeti.symplecticPermTensorAction k n d σ`. -/
@[simp]
theorem brauerActionSymp_of_permToBrauer (σ : Equiv.Perm (Fin d)) :
    brauerActionSymp k n d (BrauerAlgebra.of (permToBrauer σ)) =
      symplecticPermTensorAction k n d σ := by
  rw [brauerActionSymp]
  exact BrauerAlgebra.liftOfPermCapCup_of_permToBrauer ..

/-- **The action restricts to the symmetric group.** Along the embedding
`TauCeti.BrauerAlgebra.ofPerm` of the group algebra of `S_d`, the symplectic Brauer action is the
group-algebra extension of `TauCeti.symplecticPermTensorAction`. -/
theorem brauerActionSymp_comp_ofPerm :
    (brauerActionSymp k n d).comp (BrauerAlgebra.ofPerm k (-(2 * n : k)) d) =
      (symplecticPermTensorAction k n d).asAlgebraHom := by
  rw [brauerActionSymp]
  exact (BrauerAlgebra.liftOfPermCapCup_comp_ofPerm ..).trans
    (Representation.asAlgebraHom_def _).symm

/-- **Cap-cup diagrams act by the symplectic single-arc generators.** On two distinct strands `i`
and `j`, the cap-cup diagram acts on `(k^{2n})^{⊗d}` by `TauCeti.symplecticCupCapAt k n d i j`. -/
@[simp]
theorem brauerActionSymp_of_capCup {i j : Fin d} (hij : i ≠ j) :
    brauerActionSymp k n d (BrauerAlgebra.of (capCup i j)) =
      symplecticCupCapAt k n d i j := by
  rw [brauerActionSymp]
  exact BrauerAlgebra.liftOfPermCapCup_of_capCup _ _ _ _ _ _ _ _ hij

/-- **Uniqueness of `brauerActionSymp`**: any `k`-algebra map out of `B_d(-2n)` that acts as
`TauCeti.symplecticPermTensorAction` on permutation diagrams and as `TauCeti.symplecticCupCapAt` on
cap-cup diagrams at distinct strands equals `TauCeti.brauerActionSymp`. -/
theorem eq_brauerActionSymp
    {f : BrauerAlgebra k (-(2 * n : k)) d →ₐ[k] Module.End k (⨂[k]^d ((Fin n ⊕ Fin n) → k))}
    (hperm : ∀ σ : Equiv.Perm (Fin d),
      f (BrauerAlgebra.of (permToBrauer σ)) = symplecticPermTensorAction k n d σ)
    (hcapCup : ∀ {i j : Fin d}, i ≠ j →
      f (BrauerAlgebra.of (capCup i j)) = symplecticCupCapAt k n d i j) :
    f = brauerActionSymp k n d :=
  BrauerAlgebra.algHom_ext_of_permToBrauer_of_capCup
    (fun σ => (hperm σ).trans (brauerActionSymp_of_permToBrauer k n d σ).symm)
    (fun hij => (hcapCup hij).trans (brauerActionSymp_of_capCup k n d hij).symm)

/-! ### Specializations to two strands and image subalgebra -/

/-- On two strands, the transposition diagram acts by the crossing `TauCeti.symplecticCrossing`. -/
theorem brauerActionSymp_two_of_permToBrauer_swap :
    brauerActionSymp k n 2 (BrauerAlgebra.of (permToBrauer (Equiv.swap 0 1))) =
      symplecticCrossing k n :=
  (brauerActionSymp_of_permToBrauer k n 2 _).trans symplecticPermTensorAction_swap_zero_one

/-- On two strands, the cap-cup diagram `capCup 0 1` acts by `TauCeti.symplecticCupCap`. -/
theorem brauerActionSymp_two_of_capCup_zero_one :
    brauerActionSymp k n 2 (BrauerAlgebra.of (capCup 0 1)) =
      symplecticCupCap k n :=
  (brauerActionSymp_of_capCup k n 2 (by decide)).trans symplecticCupCapAt_zero_one

/-- **The image of `B_d(-2n)` is generated by the sign-twisted permutations and the non-degenerate
arcs**, uniformly in `d : ℕ` (including `d < 2`, where the set of arcs is empty; the degenerate
operators `symplecticCupCapAt k n d i i` are excluded). -/
theorem range_brauerActionSymp_eq_adjoin_union :
    (brauerActionSymp k n d).range =
      Algebra.adjoin k (Set.range (symplecticPermTensorAction k n d) ∪
        {T | ∃ (i j : Fin d) (_ : i ≠ j), symplecticCupCapAt k n d i j = T}) := by
  rw [← Algebra.map_top,
    ← BrauerAlgebra.adjoin_range_of_permToBrauer_union_range_of_capCup k (-(2 * n : k)) d,
    AlgHom.map_adjoin]
  refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le ?_)
  · rintro _ ⟨x, ⟨σ, rfl⟩ | ⟨⟨i, j⟩, rfl⟩, rfl⟩
    · exact Algebra.subset_adjoin (Or.inl ⟨σ, (brauerActionSymp_of_permToBrauer k n d σ).symm⟩)
    · dsimp only
      rcases eq_or_ne i j with rfl | hij
      · rw [capCup_self, brauerActionSymp_of_permToBrauer, map_one]
        exact Subalgebra.one_mem _
      · exact Algebra.subset_adjoin (Or.inr ⟨i, j, hij,
          (brauerActionSymp_of_capCup k n d hij).symm⟩)
  · rintro _ (⟨σ, rfl⟩ | ⟨i, j, hij, rfl⟩)
    · exact Algebra.subset_adjoin ⟨BrauerAlgebra.of (permToBrauer σ), Or.inl ⟨σ, rfl⟩,
        brauerActionSymp_of_permToBrauer k n d σ⟩
    · exact Algebra.subset_adjoin ⟨BrauerAlgebra.of (capCup i j), Or.inr ⟨(i, j), rfl⟩,
        brauerActionSymp_of_capCup k n d hij⟩

/-- **The image of the symplectic Brauer action is generated by the sign-twisted permutations and
one arc.** For any two distinct strands `i ≠ j`, the image of `B_d(-2n)` in the endomorphisms of
`(k^{2n})^{⊗d}` is the subalgebra generated by `TauCeti.symplecticPermTensorAction` together with
`TauCeti.symplecticCupCapAt k n d i j`. -/
theorem range_brauerActionSymp_eq_adjoin {i j : Fin d} (hij : i ≠ j) :
    (brauerActionSymp k n d).range =
      Algebra.adjoin k
        (insert (symplecticCupCapAt k n d i j) (Set.range (symplecticPermTensorAction k n d))) := by
  rw [← Algebra.map_top,
    ← BrauerAlgebra.adjoin_insert_of_capCup_range_of_permToBrauer k (-(2 * n : k)) hij,
    AlgHom.map_adjoin, Set.image_insert_eq, ← Set.range_comp, brauerActionSymp_of_capCup k n d hij]
  simp only [Function.comp_def, brauerActionSymp_of_permToBrauer]

/-- **On two strands, the image of `B_2(-2n)` is generated by the crossing and the cap-cup
operator.** -/
theorem range_brauerActionSymp_two_eq_adjoin :
    (brauerActionSymp k n 2).range =
      Algebra.adjoin k {symplecticCrossing k n, symplecticCupCap k n} := by
  rw [range_brauerActionSymp_eq_adjoin k n 2 (show (0 : Fin 2) ≠ 1 by decide),
    symplecticCupCapAt_zero_one]
  refine le_antisymm ?_ ?_
  · rw [Algebra.adjoin_le_iff]
    rintro _ (rfl | ⟨σ, rfl⟩)
    · exact Algebra.subset_adjoin (by simp)
    · rcases Fin.exists_fin_two.mp ⟨σ 0, rfl⟩ with h0 | h0
      · have hσ : σ = 1 := Equiv.ext fun t => by
          fin_cases t
          · exact h0
          · rcases Fin.exists_fin_two.mp ⟨σ 1, rfl⟩ with h1 | h1
            · exact absurd (σ.injective (h1.trans h0.symm)) (by decide)
            · exact h1
        rw [hσ, map_one]
        exact Subalgebra.one_mem _
      · have hσ : σ = Equiv.swap 0 1 := Equiv.ext fun t => by
          fin_cases t
          · simpa using h0
          · rcases Fin.exists_fin_two.mp ⟨σ 1, rfl⟩ with h1 | h1
            · simpa using h1
            · exact absurd (σ.injective (h0.trans h1.symm)) (by decide)
        rw [hσ, symplecticPermTensorAction_swap_zero_one]
        exact Algebra.subset_adjoin (by simp)
  · rw [Algebra.adjoin_le_iff]
    rintro _ (rfl | rfl)
    · rw [← symplecticPermTensorAction_swap_zero_one]
      exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ ⟨Equiv.swap 0 1, rfl⟩)
    · exact Algebra.subset_adjoin (Set.mem_insert _ _)

/-! ### Reflection of diagrams and matrix adjoints in the monomial basis -/

/-- In the monomial basis, the conjugate transpose of the matrix of a sign-twisted permutation `σ`
is the matrix of `σ⁻¹`. -/
private theorem conjTranspose_toMatrix_symplecticPermTensorAction [StarRing k]
    (σ : Equiv.Perm (Fin d)) :
    (LinearMap.toMatrix
      (Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n))
      (Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n))
      (symplecticPermTensorAction k n d σ))ᴴ =
    LinearMap.toMatrix
      (Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n))
      (Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n))
      (symplecticPermTensorAction k n d σ⁻¹) := by
  set b := Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n)
  have hact (τ : Equiv.Perm (Fin d)) (u : Fin d → Fin n ⊕ Fin n) :
      symplecticPermTensorAction k n d τ (b u) =
        ((Equiv.Perm.sign τ : ℤ) : k) • b (fun t => u (τ.symm t)) := by
    simp [b, Basis.piTensorProduct_apply]
  ext v u
  rw [Matrix.conjTranspose_apply, LinearMap.toMatrix_apply, LinearMap.toMatrix_apply,
    hact, hact, map_smul, map_smul, Finsupp.smul_apply, Finsupp.smul_apply, b.repr_self,
    b.repr_self, Finsupp.single_apply, Finsupp.single_apply, smul_eq_mul, smul_eq_mul]
  have heq : (fun t => v (σ.symm t)) = u ↔ (fun t => u ((σ⁻¹).symm t)) = v := by
    simp only [funext_iff, Equiv.Perm.inv_def, Equiv.symm_symm]
    exact ⟨fun h t => by simpa using (h (σ t)).symm,
      fun h t => by simpa using (h (σ.symm t)).symm⟩
  simp only [heq, Equiv.Perm.sign_inv, star_mul', star_intCast]
  split_ifs <;> simp

/-- **Reflecting a Brauer diagram conjugate-transposes its matrix.** For any star ring structure on
`k`, the conjugate transpose of the matrix of `D` in the monomial basis of `(k^{2n})^{⊗d}` is the
matrix of the reflected diagram `D.flip`. -/
theorem conjTranspose_toMatrix_brauerActionSymp_of [StarRing k] (D : BrauerDiagram d) :
    (LinearMap.toMatrix
      (Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n))
      (Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n))
      (brauerActionSymp k n d (BrauerAlgebra.of D)))ᴴ =
    LinearMap.toMatrix
      (Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n))
      (Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n))
      (brauerActionSymp k n d (BrauerAlgebra.of D.flip)) := by
  set b := Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n)
  induction D using BrauerDiagram.capCup_induction_on with
  | permToBrauer σ =>
    rw [BrauerDiagram.flip_permToBrauer, brauerActionSymp_of_permToBrauer,
      brauerActionSymp_of_permToBrauer]
    exact conjTranspose_toMatrix_symplecticPermTensorAction k n d σ
  | capCup_compose i j X hij hloop ih =>
    have hloop' : middleLoopCount X.flip (capCup i j).flip = 0 :=
      (middleLoopCount_flip (capCup i j) X).trans hloop
    rw [flip_composeDiagram, ← BrauerAlgebra.of_mul_of_of_middleLoopCount_eq_zero hloop,
      ← BrauerAlgebra.of_mul_of_of_middleLoopCount_eq_zero hloop',
      map_mul (brauerActionSymp k n d), map_mul (brauerActionSymp k n d),
      LinearMap.toMatrix_mul, LinearMap.toMatrix_mul, Matrix.conjTranspose_mul, ih,
      BrauerDiagram.flip_capCup, brauerActionSymp_of_capCup k n d hij,
      (isHermitian_toMatrix_symplecticCupCapAt (k := k) (n := n) (d := d) (i := i) (j := j)).eq]

/-- **Reflecting a Brauer diagram transposes its matrix** in the monomial basis of
`(k^{2n})^{⊗d}`. -/
theorem transpose_toMatrix_brauerActionSymp_of (D : BrauerDiagram d) :
    (LinearMap.toMatrix
      (Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n))
      (Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n))
      (brauerActionSymp k n d (BrauerAlgebra.of D)))ᵀ =
    LinearMap.toMatrix
      (Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n))
      (Basis.piTensorProduct fun _ : Fin d => Pi.basisFun k (Fin n ⊕ Fin n))
      (brauerActionSymp k n d (BrauerAlgebra.of D.flip)) := by
  let _ : StarRing k := starRingOfComm
  have : TrivialStar k := ⟨fun _ => rfl⟩
  rw [← Matrix.conjTranspose_eq_transpose_of_trivial]
  exact conjTranspose_toMatrix_brauerActionSymp_of k n d D

end TauCeti
