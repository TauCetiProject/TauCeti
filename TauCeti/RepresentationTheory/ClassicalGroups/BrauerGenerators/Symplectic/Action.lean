import Mathlib.Tactic.FinCases

/-!
# The Brauer algebra acting on a tensor power of `R^{2n}`

Equip `V = R^{2n} = (Fin n ⊕ Fin n) → R` with its standard alternating bilinear form, represented
by `Matrix.J (Fin n) R`, whose inverse copairing is the bivector of `-Matrix.J (Fin n) R`
(`TauCeti.symplecticCup`). In the monomial basis `TauCeti.symplecticTensorPowerBasis`, each Brauer
diagram `D` on `k` strands acts on `V^{⊗k}` by its symplectic matrix
`TauCeti.BrauerDiagram.symplecticActionMatrix`. Because those matrices obey the loop rule at the
negative loop value `δ = -(2 * n) = -dim V` (`TauCeti.BrauerDiagram.symplecticActionMatrix_mul`),
they assemble via `TauCeti.BrauerAlgebra.lift` into an `R`-algebra homomorphism
`TauCeti.brauerActionSymplectic` from `B_k(-2n)` to `Module.End R (⨂[R]^k ((Fin n ⊕ Fin n) → R))`,
over every commutative ring `R`.

This action extends the symplectic generators constructed earlier:

* on a permutation diagram `permToBrauer σ` it is the sign-twisted permutation action
  `TauCeti.symplecticPermTensorAction` (`σ` acting by `sign σ` times slot reindexing), so on two
  strands the crossing diagram acts by `TauCeti.symplecticCrossing` (minus the flip);
* on a cap-cup diagram `capCup a b` for `a ≠ b` it is the single-arc generator
  `TauCeti.symplecticCupCapAt`, so on two strands it acts by `TauCeti.symplecticCupCap`.

This is the action through which the Brauer algebra `B_k(-2n)` is the partner of the symplectic
group `Sp(2n)` in Schur–Weyl duality; that its image commutes with the diagonal symplectic action is
proved in `TauCeti.RepresentationTheory.ClassicalGroups.BrauerGenerators.Symplectic.Equivariance`.

## Main definitions

* `TauCeti.symplecticTensorPowerBasis`: the monomial basis of `⨂[R]^k ((Fin n ⊕ Fin n) → R)`.
* `TauCeti.brauerActionSymplectic`: the action of the Brauer algebra `B_k(-2n)` on `(R^{2n})^{⊗k}`.

## Main results

* `TauCeti.finrank_symplecticTensorPower`: `(R^{2n})^{⊗k}` has rank `(2 * n) ^ k`.
* `Matrix.toMatrix_piTensorProductMap_symplecticTensorPowerBasis`: the matrix of `A^{⊗k}` in the
  symplectic monomial basis is `A.kroneckerPower (Fin k)`.
* `TauCeti.toMatrix_brauerActionSymplectic`: an element of `B_k(-2n)` acts in the monomial basis by
  the linear combination of the matrices of the diagrams with its coefficients.
* `TauCeti.brauerActionSymplectic_of_permToBrauer` and
  `TauCeti.brauerActionSymplectic_comp_ofPerm`: permutation diagrams act by the sign-twisted
  permutation action `TauCeti.symplecticPermTensorAction`.
* `TauCeti.brauerActionSymplectic_of_capCup`: a cap-cup diagram on two distinct strands acts by
  `TauCeti.symplecticCupCapAt`.
* `TauCeti.range_brauerActionSymplectic_eq_adjoin` and
  `TauCeti.range_brauerActionSymplectic_two_eq_adjoin`: the image of `B_k(-2n)` is generated by the
  sign-twisted permutations and one single-arc generator (on two strands, by
  `TauCeti.symplecticCrossing` and `TauCeti.symplecticCupCap`).

## References

* [R. Brauer, *On algebras which are connected with the semisimple continuous groups*][brauer1937],
  Annals of Mathematics 38 (1937), 857-872.
* R. Dipper, S. Doty and J. Hu, *Brauer algebras, symplectic Schur algebras and Schur–Weyl
  duality*, Trans. Amer. Math. Soc. 360 (2008), 189-213, §1.
* R. Goodman and N. R. Wallach, *Symmetry, Representations, and Invariants*, Springer GTM 255
  (2009), §10.1.
-/

public section

open scoped Matrix TensorProduct

namespace TauCeti

universe u

/-! ### The monomial basis of a symplectic tensor power -/

section CommSemiring

variable (R : Type u) [CommSemiring R] (n k : ℕ)

/-- **The monomial basis of `(R^{2n})^{⊗k}`**: the basis tensor at `f : Fin k → Fin n ⊕ Fin n` is
the pure tensor whose `i`-th factor is the `f i`-th standard basis vector of
`(Fin n ⊕ Fin n) → R`. -/
noncomputable def symplecticTensorPowerBasis :
    Module.Basis (Fin k → Fin n ⊕ Fin n) R (⨂[R]^k ((Fin n ⊕ Fin n) → R)) :=
  Basis.piTensorProduct fun _ : Fin k => Pi.basisFun R (Fin n ⊕ Fin n)

/-- `TauCeti.symplecticTensorPowerBasis` is `Basis.piTensorProduct` of the standard bases of
`(Fin n ⊕ Fin n) → R`. -/
theorem symplecticTensorPowerBasis_def :
    symplecticTensorPowerBasis R n k =
      Basis.piTensorProduct fun _ : Fin k => Pi.basisFun R (Fin n ⊕ Fin n) :=
  (rfl)

@[simp]
theorem symplecticTensorPowerBasis_apply (f : Fin k → Fin n ⊕ Fin n) :
    symplecticTensorPowerBasis R n k f =
      PiTensorProduct.tprod R fun i => Pi.single (f i) (1 : R) := by
  classical
  rw [symplecticTensorPowerBasis, Basis.piTensorProduct_apply]
  simp

/-- **The dimension of `(R^{2n})^{⊗k}` is `(2 * n) ^ k`**, read off its monomial basis. -/
theorem finrank_symplecticTensorPower [StrongRankCondition R] :
    Module.finrank R (⨂[R]^k ((Fin n ⊕ Fin n) → R)) = (2 * n) ^ k := by
  rw [Module.finrank_eq_card_basis (symplecticTensorPowerBasis R n k), Fintype.card_fun,
    Fintype.card_sum, Fintype.card_fin, Fintype.card_fin, ← two_mul]

/-- **The matrix of `A^{⊗k}` in the symplectic monomial basis is the Kronecker power of `A`.** -/
theorem _root_.Matrix.toMatrix_piTensorProductMap_symplecticTensorPowerBasis
    {R : Type u} [CommSemiring R] {n k : ℕ} (A : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R) :
    LinearMap.toMatrix (symplecticTensorPowerBasis R n k) (symplecticTensorPowerBasis R n k)
        (PiTensorProduct.map fun _ : Fin k => A.mulVecLin) =
      A.kroneckerPower (Fin k) := by
  rw [symplecticTensorPowerBasis_def]
  exact A.toMatrix_piTensorProductMap_mulVecLin

end CommSemiring

/-! ### The symplectic Brauer algebra action -/

section CommRing

variable (R : Type u) [CommRing R] (n k : ℕ)

/-- **The Brauer algebra acting on a tensor power of `R^{2n}`.** The Brauer algebra `B_k(-2n)` at
the symplectic loop value `-(2 * n : R)` acts on `⨂[R]^k ((Fin n ⊕ Fin n) → R)` through the
standard alternating form: a diagram acts in the monomial basis by
`TauCeti.BrauerDiagram.symplecticActionMatrix`, and those matrices satisfy the loop rule at
`-(2 * n : R)` (`TauCeti.BrauerDiagram.symplecticActionMatrix_mul`). -/
noncomputable def brauerActionSymplectic :
    BrauerAlgebra R (-(2 * n : R)) k →ₐ[R] Module.End R (⨂[R]^k ((Fin n ⊕ Fin n) → R)) :=
  BrauerAlgebra.lift
    (fun D => Matrix.toLin (symplecticTensorPowerBasis R n k) (symplecticTensorPowerBasis R n k)
      (D.symplecticActionMatrix R (Fin n)))
    (by
      rw [BrauerDiagram.symplecticActionMatrix_permToBrauer_one, Matrix.toLin_one,
        Module.End.one_eq_id])
    fun D₁ D₂ => by
      rw [Module.End.mul_eq_comp, ← Matrix.toLin_mul,
        BrauerDiagram.symplecticActionMatrix_mul, Fintype.card_fin, map_smul]

/-- A Brauer diagram acts in the monomial basis by its symplectic matrix. -/
theorem brauerActionSymplectic_of (D : BrauerDiagram k) :
    brauerActionSymplectic R n k (BrauerAlgebra.of D) =
      Matrix.toLin (symplecticTensorPowerBasis R n k) (symplecticTensorPowerBasis R n k)
        (D.symplecticActionMatrix R (Fin n)) :=
  BrauerAlgebra.lift_of ..

/-- **The matrix of the symplectic Brauer action.** In the monomial basis, an element `x` of
`B_k(-2n)` acts by the linear combination `∑ D, x.coeff D • M(D)` of the matrices of the diagrams.
-/
theorem toMatrix_brauerActionSymplectic (x : BrauerAlgebra R (-(2 * n : R)) k) :
    LinearMap.toMatrix (symplecticTensorPowerBasis R n k) (symplecticTensorPowerBasis R n k)
        (brauerActionSymplectic R n k x) =
      Finsupp.linearCombination R
        (fun D : BrauerDiagram k => D.symplecticActionMatrix R (Fin n)) x.coeff := by
  have h :
      (LinearMap.toMatrix (symplecticTensorPowerBasis R n k)
            (symplecticTensorPowerBasis R n k)).toLinearMap ∘ₗ
          (brauerActionSymplectic R n k).toLinearMap =
        Finsupp.linearCombination R
            (fun D : BrauerDiagram k => D.symplecticActionMatrix R (Fin n)) ∘ₗ
          (BrauerAlgebra.coeffLinearEquiv R (-(2 * n : R)) k).toLinearMap :=
    (BrauerAlgebra.basis R (-(2 * n : R)) k).ext fun D => by
      simp [BrauerAlgebra.basis_apply, brauerActionSymplectic_of,
        BrauerAlgebra.coeffLinearEquiv_apply]
  simpa using LinearMap.congr_fun h x

/-- **A Brauer diagram on a monomial basis tensor**: `D` sends `e_u` to the linear combination of
monomial basis tensors `e_v` weighted by `D.symplecticActionMatrix R (Fin n) v u`. -/
theorem brauerActionSymplectic_of_symplecticTensorPowerBasis (D : BrauerDiagram k)
    (u : Fin k → Fin n ⊕ Fin n) :
    brauerActionSymplectic R n k (BrauerAlgebra.of D) (symplecticTensorPowerBasis R n k u) =
      ∑ v, D.symplecticActionMatrix R (Fin n) v u • symplecticTensorPowerBasis R n k v := by
  rw [brauerActionSymplectic_of, Matrix.toLin_self]

/-- **Permutation diagrams act by the sign-twisted permutation action**: `permToBrauer σ` acts on
`(R^{2n})^{⊗k}` as `TauCeti.symplecticPermTensorAction R n k σ`, reindexing the tensor factors along
`σ` and multiplying by `sign σ`. -/
@[simp]
theorem brauerActionSymplectic_of_permToBrauer (σ : Equiv.Perm (Fin k)) :
    brauerActionSymplectic R n k (BrauerAlgebra.of (permToBrauer σ)) =
      symplecticPermTensorAction R n k σ := by
  refine (symplecticTensorPowerBasis R n k).ext fun u => ?_
  rw [brauerActionSymplectic_of_symplecticTensorPowerBasis, symplecticTensorPowerBasis_apply,
    symplecticPermTensorAction_tprod]
  have hcond (v : Fin k → Fin n ⊕ Fin n) : (u = v ∘ σ) ↔ v = fun i => u (σ.symm i) := by
    refine ⟨fun h => funext fun i => ?_, fun h => funext fun i => ?_⟩
    · simpa using (congrFun h (σ.symm i)).symm
    · simp [h]
  simp only [BrauerDiagram.symplecticActionMatrix_permToBrauer, hcond, ite_smul, zero_smul,
    Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte, symplecticTensorPowerBasis_apply]

/-- **The symplectic Brauer action restricts along `BrauerAlgebra.ofPerm` to the sign-twisted
group-algebra action** `(symplecticPermTensorAction R n k).asAlgebraHom`. -/
theorem brauerActionSymplectic_comp_ofPerm :
    (brauerActionSymplectic R n k).comp (BrauerAlgebra.ofPerm R (-(2 * n : R)) k) =
      (symplecticPermTensorAction R n k).asAlgebraHom := by
  refine MonoidAlgebra.algHom_ext (fun σ => ?_) (by ext)
  rw [AlgHom.comp_apply, BrauerAlgebra.ofPerm_single, map_smul, one_smul,
    brauerActionSymplectic_of_permToBrauer, ← Representation.asAlgebraHom_of,
    MonoidAlgebra.of_apply]

/-- **Cap-cup diagrams act by the single-arc generators**: for distinct strands `a ≠ b`, the
diagram `capCup a b` acts on `(R^{2n})^{⊗k}` as `TauCeti.symplecticCupCapAt R n k a b`, contracting
the two slots against `J` and re-expanding them through `-J`. -/
@[simp]
theorem brauerActionSymplectic_of_capCup {a b : Fin k} (hab : a ≠ b) :
    brauerActionSymplectic R n k (BrauerAlgebra.of (capCup a b)) =
      symplecticCupCapAt R n k a b := by
  refine (LinearMap.toMatrix (symplecticTensorPowerBasis R n k)
    (symplecticTensorPowerBasis R n k)).injective ?_
  rw [brauerActionSymplectic_of, LinearMap.toMatrix_toLin]
  ext v u
  rw [BrauerDiagram.symplecticActionMatrix_capCup R (Fin n) hab, LinearMap.toMatrix_apply,
    symplecticTensorPowerBasis_def, piTensorProduct_repr_symplecticCupCapAt_piTensorProduct hab]

/-- **On two strands the crossing diagram acts by `TauCeti.symplecticCrossing`**, minus the flip of
the two tensor factors.

Not a `simp` lemma: `simp` already rewrites the left-hand side via
`TauCeti.brauerActionSymplectic_of_permToBrauer`. -/
theorem brauerActionSymplectic_two_of_permToBrauer_swap :
    brauerActionSymplectic R n 2 (BrauerAlgebra.of (permToBrauer (Equiv.swap 0 1))) =
      symplecticCrossing R n := by
  rw [brauerActionSymplectic_of_permToBrauer, symplecticPermTensorAction_swap_zero_one]

/-- **On two strands the cap-cup diagram acts by `TauCeti.symplecticCupCap`**, the composite
`cup ∘ₗ cap` through the base ring.

Not a `simp` lemma: `simp` already rewrites the left-hand side via
`TauCeti.brauerActionSymplectic_of_capCup`. -/
theorem brauerActionSymplectic_two_of_capCup :
    brauerActionSymplectic R n 2 (BrauerAlgebra.of (capCup 0 1)) = symplecticCupCap R n := by
  rw [brauerActionSymplectic_of_capCup R n 2 (by decide), symplecticCupCapAt_zero_one]

/-- **The image of `B_k(-2n)` is generated by the sign-twisted permutations and one single-arc
generator** on any two distinct strands `a ≠ b`. -/
theorem range_brauerActionSymplectic_eq_adjoin {a b : Fin k} (hab : a ≠ b) :
    (brauerActionSymplectic R n k).range =
      Algebra.adjoin R
        (insert (symplecticCupCapAt R n k a b) (Set.range (symplecticPermTensorAction R n k))) := by
  rw [← Algebra.map_top,
    ← BrauerAlgebra.adjoin_insert_of_capCup_range_of_permToBrauer R (-(2 * n : R)) hab,
    AlgHom.map_adjoin, Set.image_insert_eq, ← Set.range_comp,
    brauerActionSymplectic_of_capCup R n k hab]
  simp only [Function.comp_def, brauerActionSymplectic_of_permToBrauer]

/-- **On two strands the image of `B₂(-2n)` is the subalgebra generated by the crossing
`TauCeti.symplecticCrossing` and the cap-cup operator `TauCeti.symplecticCupCap`.** -/
theorem range_brauerActionSymplectic_two_eq_adjoin :
    (brauerActionSymplectic R n 2).range =
      Algebra.adjoin R {symplecticCrossing R n, symplecticCupCap R n} := by
  rw [range_brauerActionSymplectic_eq_adjoin R n 2 (a := 0) (b := 1) (by decide),
    symplecticCupCapAt_zero_one]
  refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le ?_)
  · rintro _ (rfl | ⟨σ, rfl⟩)
    · exact Algebra.subset_adjoin (by simp)
    · have hσ : σ = 1 ∨ σ = Equiv.swap 0 1 := by
        fin_cases σ <;> decide
      rcases hσ with rfl | rfl
      · rw [map_one]
        exact Subalgebra.one_mem _
      · rw [symplecticPermTensorAction_swap_zero_one]
        exact Algebra.subset_adjoin (by simp)
  · rintro _ (rfl | rfl)
    · rw [← symplecticPermTensorAction_swap_zero_one]
      exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ ⟨Equiv.swap 0 1, rfl⟩)
    · exact Algebra.subset_adjoin (Set.mem_insert _ _)

end CommRing

-- Over `ℤ` at `n = 1` on two strands, `e * e = (-2) • e` and `s * e = e`.
example :
    brauerActionSymplectic ℤ 1 2
        (BrauerAlgebra.of (capCup 0 1) * BrauerAlgebra.of (capCup 0 1)) =
      (-2 : ℤ) • symplecticCupCap ℤ 1 := by
  rw [BrauerAlgebra.of_capCup_mul_of_capCup (by decide), Algebra.smul_def, map_mul,
    AlgHom.commutes, brauerActionSymplectic_two_of_capCup, ← Algebra.smul_def]
  simp

example :
    brauerActionSymplectic ℤ 1 2
        (BrauerAlgebra.of (permToBrauer (Equiv.swap 0 1)) * BrauerAlgebra.of (capCup 0 1)) =
      symplecticCupCap ℤ 1 := by
  rw [BrauerAlgebra.of_permToBrauer_swap_mul_of_capCup, brauerActionSymplectic_two_of_capCup]

end TauCeti
