module

public import TauCeti.Algebra.Category.GradedModuleCat.CartanMap.Specialization
public import TauCeti.Algebra.Homology.EulerCharacteristic.ExtEuler.Matrix
public import TauCeti.RepresentationTheory.GrothendieckGroup.CartanMatrix
public import TauCeti.RepresentationTheory.GrothendieckGroup.Quiver.ExtEuler
public import TauCeti.RepresentationTheory.GrothendieckGroup.Quiver.ForgetGrading
public import TauCeti.RepresentationTheory.Quiver.PathAlgebra.GradedCartanMatrix
public import TauCeti.RepresentationTheory.Quiver.PrimitiveIdempotent
import TauCeti.RepresentationTheory.Quiver.LastArrow

/-!
# The Cartan matrix of a path algebra

Let `Q` be a finite quiver whose path algebra `kQ` is finite-dimensional, so that `Q` is acyclic
with finitely many arrows. The left ideals `kQ eᵢ` generated by the vertex idempotents are
indecomposable, pairwise nonisomorphic, and exhaust the indecomposable finitely generated
projective `kQ`-modules; the vertex simples `Sᵢ` exhaust the simple modules. In these two families
the Cartan matrix `TauCeti.cartanMatrix`, whose `(i, j)` entry is the composition multiplicity
`[kQ eⱼ : Sᵢ]`, is the path-counting matrix of the quiver: its `(i, j)` entry is the number of
paths from `j` to `i`. Rows are indexed by simples and columns by projectives, following the
left-module convention.

The ungraded matrix is the graded Cartan matrix of the path-length grading evaluated at `q = 1`,
an instance of `TauCeti.toMatrix_cartanMap_eq_map_gradedCartanMatrix`. Evaluating the graded
identity `(1 - q Aᵀ) C_q = 1` at `q = 1` gives `(1 - Aᵀ) C = 1`, where the `(i, j)` entry of `A`
counts arrows `i ⟶ j`. The path-counting matrix satisfies the same identity by the last-arrow
recursion for paths, so the two agree.

Transposing, `Cᵀ (1 - A) = 1`. The matrix `1 - A` is the Ext-Euler matrix of the vertex simples,
read off from their first-arrow resolutions, so the Ext-Euler matrix of a path algebra is the
transposed inverse of its Cartan matrix. For a general finite-dimensional algebra this is
`TauCeti.cartanMatrix_transpose_mul_extEulerMatrix_eq_one`, which takes projective covers as
input; here both matrices are computed explicitly instead.

## Main definitions

* `TauCeti.PathAlgebra.vertexProjective`: the vertex projective `kQ eᵢ` as a finitely generated
  projective module.

## Main results

* `TauCeti.PathAlgebra.isExhaustiveIndecomposableProjectiveFamily_vertexProjective`: the vertex
  projectives exhaust the indecomposable finitely generated projective modules.
* `TauCeti.PathAlgebra.gradedFiniteProjectiveModulesForgetK0_mk_gradedVertexProjectiveClass`:
  forgetting the grading sends the graded vertex projective to the vertex projective.
* `TauCeti.PathAlgebra.cartanMatrix_vertexProjective_eq_map_gradedCartanMatrix`: the Cartan
  matrix is the graded Cartan matrix at `q = 1`.
* `TauCeti.PathAlgebra.cartanMatrix_vertexProjective_apply`: the `(i, j)` entry of the Cartan
  matrix is the number of paths from `j` to `i`.
* `TauCeti.PathAlgebra.one_sub_transpose_mul_cartanMatrix_vertexProjective_eq_one` and
  `TauCeti.PathAlgebra.cartanMatrix_vertexProjective_eq_inv`: the Cartan matrix is `(1 - Aᵀ)⁻¹`.
* `TauCeti.PathAlgebra.cartanMap_vertexProjective`: the Cartan map sends `[kQ eⱼ]` to the sum of
  the vertex simple classes weighted by path counts.
* `TauCeti.PathAlgebra.extEulerMatrix_vertexSimple`: the Ext-Euler matrix of the vertex simples
  is `1 - A`.
* `TauCeti.PathAlgebra.cartanMatrix_vertexProjective_transpose_mul_extEulerMatrix_eq_one`:
  `Cᵀ E = 1`.

## References

* I. Assem, D. Simson and A. Skowroński, *Elements of the Representation Theory of Associative
  Algebras I*, Chapter III, Section 3, Definition 3.7 and Proposition 3.13, for the Cartan matrix
  of a path algebra and its relation to the Euler form.
-/

public section

noncomputable section

namespace TauCeti.PathAlgebra

open CategoryTheory LaurentPolynomial
open scoped Matrix

universe u v

variable (k : Type (max u v)) (Q : Type u) [Field k] [Quiver.{v} Q] [Finite Q]

/-! ### The vertex projectives -/

/-- **The vertex projective `kQ eᵢ`**, the left ideal generated by the vertex idempotent, as a
finitely generated projective module. Its graded counterpart is `gradedVertexProjective`. -/
def vertexProjective (i : Q) : (finiteProjectiveModules (pathAlgebra k Q)).FullSubcategory :=
  ⟨ModuleCat.of _ (Ideal.span {(vertexIdempotent k i : pathAlgebra k Q)}),
    finiteProjectiveModules_iff.2
      ⟨inferInstance, IsIdempotentElem.projective_span_singleton (vertexIdempotent_mul_self i)⟩⟩

/-- The underlying module of the vertex projective is the left ideal generated by `eᵢ`. -/
@[simp]
theorem vertexProjective_obj (i : Q) :
    (vertexProjective k Q i).obj =
      ModuleCat.of _ (Ideal.span {(vertexIdempotent k i : pathAlgebra k Q)}) :=
  (rfl)

/-- The vertex projective `kQ eᵢ` is indecomposable. -/
theorem isIndecomposableModule_vertexProjective (i : Q) :
    IsIndecomposableModule (pathAlgebra k Q) (vertexProjective k Q i).obj :=
  isIndecomposableModule_span_singleton_vertexIdempotent isPrimitiveIdempotent_one i

/-- Vertex projectives at distinct vertices are nonisomorphic. -/
theorem pairwise_isEmpty_linearEquiv_vertexProjective :
    Pairwise fun i j : Q ↦ IsEmpty
      ((vertexProjective k Q i).obj ≃ₗ[pathAlgebra k Q] (vertexProjective k Q j).obj) := by
  intro i j hij
  let _ := integerGradedAlgebra k Q
  let _ := Fintype.ofFinite Q
  exact isEmpty_linearEquiv_span_singleton_of_gradeZero_le_span
    (vertexIdempotent_mem_integerGrade_zero k Q)
    (completeOrthogonalIdempotents_vertexIdempotent k Q).toOrthogonalIdempotents
    (fun _ ↦ integerGrade_eq_bot_of_neg k Q)
    (integerGrade_zero_eq_span_range_vertexIdempotent k Q).le hij (vertexIdempotent_ne_zero i)

/-- **Forgetting the grading of the graded vertex projective `kQ eᵢ`** at `q = 1` gives the class
of the vertex projective. -/
theorem gradedFiniteProjectiveModulesForgetK0_mk_gradedVertexProjectiveClass (i : Q) :
    gradedFiniteProjectiveModulesForgetK0 (integerGrade k Q)
        (LaurentSpecialization.mk 1 (gradedVertexProjectiveClass k Q i)) =
      ExactK0.of.{max u v} (vertexProjective k Q i) := by
  rw [gradedVertexProjectiveClass_eq, gradedFiniteProjectiveModulesForgetK0_mk_of]
  exact ExactK0.of_congr ((finiteProjectiveModules (pathAlgebra k Q)).fullyFaithfulι.preimageIso
    (gradedVertexProjectiveEquiv k Q i).toModuleIso)

variable [FiniteDimensional k (pathAlgebra k Q)]

/-- **The vertex projectives exhaust the indecomposable finitely generated projective modules**
of a finite-dimensional path algebra. -/
theorem isExhaustiveIndecomposableProjectiveFamily_vertexProjective :
    IsExhaustiveIndecomposableProjectiveFamily (vertexProjective k Q) :=
  let _ := Fintype.ofFinite Q
  isExhaustiveIndecomposableProjectiveFamily_span_singleton
    (completeOrthogonalIdempotents_vertexIdempotent k Q)
    fun i ↦ isPrimitiveIdempotent_vertexIdempotent isPrimitiveIdempotent_one i

/-! ### The Cartan matrix -/

variable [Fintype Q]

/-- **The Cartan matrix of a path algebra is its graded Cartan matrix at `q = 1`**, in the bases of
vertex projectives and vertex simples, with the path-length grading on the graded side. -/
theorem cartanMatrix_vertexProjective_eq_map_gradedCartanMatrix :
    cartanMatrix (vertexProjective k Q) (vertexSimpleModuleFG k Q)
        (isIndecomposableModule_vertexProjective k Q)
        (pairwise_isEmpty_linearEquiv_vertexProjective k Q)
        (isExhaustiveIndecomposableProjectiveFamily_vertexProjective k Q)
        (pairwise_isEmpty_linearEquiv_vertexSimpleModuleFG k Q)
        (isExhaustiveSimpleFamily_vertexSimpleModuleFG k Q) =
      (gradedCartanMatrix (integerGrade k Q) (gradedVertexProjectiveClassBasis k Q)
        (gradedVertexSimpleClassBasis k Q)).map (laurentEval (1 : ℤˣ)) := by
  classical
  let _ := integerGradedAlgebra k Q
  rw [cartanMatrix_eq_toMatrix]
  refine toMatrix_cartanMap_eq_map_gradedCartanMatrix _ _ _ _ _ (fun j ↦ ?_) fun i ↦ ?_
  · rw [indecomposableProjectiveClassBasis_apply, LaurentSpecialization.basis_apply,
      gradedVertexProjectiveClassBasis_apply,
      gradedFiniteProjectiveModulesForgetK0_mk_gradedVertexProjectiveClass]
  · -- `gradedFiniteModulesForgetK0Equiv` is the forgetful map, and its inverse is known on the
    -- vertex simples.
    rw [simpleClassBasis_apply, LaurentSpecialization.basis_apply,
      gradedVertexSimpleClassBasis_apply, ← gradedFiniteModulesForgetK0Equiv_symm_vertexSimple,
      ← gradedFiniteModulesForgetK0Equiv_toLinearMap, LinearEquiv.coe_coe,
      LinearEquiv.apply_symm_apply]

variable [DecidableEq Q]

/-- **The Cartan matrix of a path algebra inverts `1 - Aᵀ`**, where the `(i, j)` entry of `A`
counts arrows `i ⟶ j`. This is the graded identity
`TauCeti.PathAlgebra.one_sub_T_smul_transpose_mul_gradedCartanMatrix_eq_one` at `q = 1`. -/
theorem one_sub_transpose_mul_cartanMatrix_vertexProjective_eq_one :
    (1 - (Matrix.of fun i j : Q ↦ (Nat.card (i ⟶ j) : ℤ))ᵀ) *
      cartanMatrix (vertexProjective k Q) (vertexSimpleModuleFG k Q)
        (isIndecomposableModule_vertexProjective k Q)
        (pairwise_isEmpty_linearEquiv_vertexProjective k Q)
        (isExhaustiveIndecomposableProjectiveFamily_vertexProjective k Q)
        (pairwise_isEmpty_linearEquiv_vertexSimpleModuleFG k Q)
        (isExhaustiveSimpleFamily_vertexSimpleModuleFG k Q) = 1 := by
  have h := congrArg (laurentEval (R := ℤ) (1 : ℤˣ)).toRingHom.mapMatrix
    (one_sub_T_smul_transpose_mul_gradedCartanMatrix_eq_one k Q)
  have hA : (laurentEval (R := ℤ) (1 : ℤˣ)).toRingHom.mapMatrix
      (1 - (T 1 : LaurentPolynomial ℤ) •
        (Matrix.of fun i j : Q ↦ (Nat.card (i ⟶ j) : LaurentPolynomial ℤ))ᵀ) =
      1 - (Matrix.of fun i j : Q ↦ (Nat.card (i ⟶ j) : ℤ))ᵀ := by
    ext i j
    by_cases hij : i = j <;> simp [hij]
  rw [map_mul, map_one, hA, RingHom.mapMatrix_apply] at h
  rw [cartanMatrix_vertexProjective_eq_map_gradedCartanMatrix]
  exact h

/-- **The Cartan matrix of a path algebra is `(1 - Aᵀ)⁻¹`**, where the `(i, j)` entry of `A`
counts arrows `i ⟶ j`. -/
theorem cartanMatrix_vertexProjective_eq_inv :
    cartanMatrix (vertexProjective k Q) (vertexSimpleModuleFG k Q)
        (isIndecomposableModule_vertexProjective k Q)
        (pairwise_isEmpty_linearEquiv_vertexProjective k Q)
        (isExhaustiveIndecomposableProjectiveFamily_vertexProjective k Q)
        (pairwise_isEmpty_linearEquiv_vertexSimpleModuleFG k Q)
        (isExhaustiveSimpleFamily_vertexSimpleModuleFG k Q) =
      (1 - (Matrix.of fun i j : Q ↦ (Nat.card (i ⟶ j) : ℤ))ᵀ)⁻¹ :=
  (Matrix.inv_eq_right_inv (one_sub_transpose_mul_cartanMatrix_vertexProjective_eq_one k Q)).symm

omit [DecidableEq Q] in
/-- **The Cartan matrix of a path algebra counts paths**: in the bases of vertex projectives and
vertex simples, its `(i, j)` entry `[kQ eⱼ : Sᵢ]` is the number of paths from `j` to `i`. -/
theorem cartanMatrix_vertexProjective_apply (i j : Q) :
    cartanMatrix (vertexProjective k Q) (vertexSimpleModuleFG k Q)
        (isIndecomposableModule_vertexProjective k Q)
        (pairwise_isEmpty_linearEquiv_vertexProjective k Q)
        (isExhaustiveIndecomposableProjectiveFamily_vertexProjective k Q)
        (pairwise_isEmpty_linearEquiv_vertexSimpleModuleFG k Q)
        (isExhaustiveSimpleFamily_vertexSimpleModuleFG k Q) i j =
      Nat.card (Quiver.Path j i) := by
  classical
  have : ∀ a b : Q, Finite (a ⟶ b) :=
    finite_hom_of_module_finite_pathAlgebra k Q inferInstance
  have : Finite (Quiver.TotalPath Q) := (module_finite_pathAlgebra_iff k Q).1 inferInstance
  have : ∀ a b : Q, Finite (Quiver.Path a b) := fun a b ↦
    Finite.of_injective (fun p : Quiver.Path a b ↦ (⟨a, b, p⟩ : Quiver.TotalPath Q))
      fun _ _ h ↦ by cases h; rfl
  set M := 1 - (Matrix.of fun i j : Q ↦ (Nat.card (i ⟶ j) : ℤ))ᵀ
  set N := Matrix.of fun i j : Q ↦ (Nat.card (Quiver.Path j i) : ℤ)
  -- The last-arrow recursion for paths says that `N` also inverts `M`.
  have hN : M * N = 1 := by
    ext i j
    simp only [M, Matrix.sub_mul, Matrix.one_mul]
    simp only [N, Matrix.sub_apply, Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply,
      Matrix.one_apply]
    rw [card_path_eq_ite_add_sum_lastArrow j i]
    push_cast
    rw [Finset.sum_congr rfl fun a _ ↦ mul_comm (Nat.card (Quiver.Path j a) : ℤ) _,
      add_sub_cancel_right]
    exact if_congr eq_comm rfl rfl
  exact congrFun₂ ((cartanMatrix_vertexProjective_eq_inv k Q).trans
    (Matrix.inv_eq_right_inv hN)) i j

omit [DecidableEq Q] in
/-- **The Cartan map of a path algebra counts paths**: it sends the class of the vertex
projective `kQ eⱼ` to the sum of the vertex simple classes `[Sᵢ]`, each weighted by the number of
paths from `j` to `i`. -/
theorem cartanMap_vertexProjective (j : Q) :
    cartanMap (pathAlgebra k Q) (ExactK0.of (vertexProjective k Q j)) =
      ∑ i, (Nat.card (Quiver.Path j i) : ℤ) • ExactK0.of (vertexSimpleModuleFG k Q i) := by
  rw [cartanMap_of_eq_sum (vertexProjective k Q) (vertexSimpleModuleFG k Q)
    (pairwise_isEmpty_linearEquiv_vertexSimpleModuleFG k Q)
    (isExhaustiveSimpleFamily_vertexSimpleModuleFG k Q) j]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [← cartanMatrix_apply (vertexProjective k Q) (vertexSimpleModuleFG k Q)
    (isIndecomposableModule_vertexProjective k Q)
    (pairwise_isEmpty_linearEquiv_vertexProjective k Q)
    (isExhaustiveIndecomposableProjectiveFamily_vertexProjective k Q)
    (pairwise_isEmpty_linearEquiv_vertexSimpleModuleFG k Q)
    (isExhaustiveSimpleFamily_vertexSimpleModuleFG k Q), cartanMatrix_vertexProjective_apply]

/-! ### The Ext-Euler matrix -/

omit [Fintype Q] in
/-- **The Ext-Euler matrix of the vertex simples is `1 - A`**, where the `(i, j)` entry of `A`
counts arrows `i ⟶ j`: `χ(Sᵢ, Sⱼ) = δᵢⱼ - #(i ⟶ j)`. -/
theorem extEulerMatrix_vertexSimple :
    extEulerMatrix (ModuleCat.isFG (pathAlgebra k Q)) (ModuleCat.isFG (pathAlgebra k Q))
        (isExtensionClosed_finiteModules (pathAlgebra k Q))
        (isExtensionClosed_finiteModules (pathAlgebra k Q))
        (isEulerAdmissibleOn_isFG_pathAlgebra k Q)
        ((simpleClassBasis (vertexSimpleModuleFG k Q)
          (pairwise_isEmpty_linearEquiv_vertexSimpleModuleFG k Q)
          (isExhaustiveSimpleFamily_vertexSimpleModuleFG k Q)).map
            (finiteModulesExactK0Equiv (pathAlgebra k Q)).toIntLinearEquiv)
        ((simpleClassBasis (vertexSimpleModuleFG k Q)
          (pairwise_isEmpty_linearEquiv_vertexSimpleModuleFG k Q)
          (isExhaustiveSimpleFamily_vertexSimpleModuleFG k Q)).map
            (finiteModulesExactK0Equiv (pathAlgebra k Q)).toIntLinearEquiv) =
      1 - Matrix.of fun i j : Q ↦ (Nat.card (i ⟶ j) : ℤ) := by
  have : ∀ a b : Q, Finite (a ⟶ b) :=
    finite_hom_of_module_finite_pathAlgebra k Q inferInstance
  ext i j
  rw [extEulerMatrix_of_of (X := vertexSimpleModuleFG k Q i) (Y := vertexSimpleModuleFG k Q j)
      (hi := by simp) (hj := by simp)]
  -- The entry is computed by the simp lemma `extEuler_vertexSimpleModule_vertexSimpleModule`.
  simp [Matrix.one_apply]

/-- **The transposed Cartan matrix of a path algebra inverts its Ext-Euler matrix**: `Cᵀ E = 1`,
where `C` is the Cartan matrix in the bases of vertex projectives and vertex simples and `E` is
the Ext-Euler matrix of the vertex simples. Thus `E = (C⁻¹)ᵀ`. -/
theorem cartanMatrix_vertexProjective_transpose_mul_extEulerMatrix_eq_one :
    (cartanMatrix (vertexProjective k Q) (vertexSimpleModuleFG k Q)
        (isIndecomposableModule_vertexProjective k Q)
        (pairwise_isEmpty_linearEquiv_vertexProjective k Q)
        (isExhaustiveIndecomposableProjectiveFamily_vertexProjective k Q)
        (pairwise_isEmpty_linearEquiv_vertexSimpleModuleFG k Q)
        (isExhaustiveSimpleFamily_vertexSimpleModuleFG k Q))ᵀ *
      extEulerMatrix (ModuleCat.isFG (pathAlgebra k Q)) (ModuleCat.isFG (pathAlgebra k Q))
        (isExtensionClosed_finiteModules (pathAlgebra k Q))
        (isExtensionClosed_finiteModules (pathAlgebra k Q))
        (isEulerAdmissibleOn_isFG_pathAlgebra k Q)
        ((simpleClassBasis (vertexSimpleModuleFG k Q)
          (pairwise_isEmpty_linearEquiv_vertexSimpleModuleFG k Q)
          (isExhaustiveSimpleFamily_vertexSimpleModuleFG k Q)).map
            (finiteModulesExactK0Equiv (pathAlgebra k Q)).toIntLinearEquiv)
        ((simpleClassBasis (vertexSimpleModuleFG k Q)
          (pairwise_isEmpty_linearEquiv_vertexSimpleModuleFG k Q)
          (isExhaustiveSimpleFamily_vertexSimpleModuleFG k Q)).map
            (finiteModulesExactK0Equiv (pathAlgebra k Q)).toIntLinearEquiv) = 1 := by
  have h := congrArg Matrix.transpose
    (one_sub_transpose_mul_cartanMatrix_vertexProjective_eq_one k Q)
  rw [Matrix.transpose_mul, Matrix.transpose_sub, Matrix.transpose_one, Matrix.transpose_transpose]
    at h
  rw [extEulerMatrix_vertexSimple, h]

end TauCeti.PathAlgebra
