module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
public import TauCeti.RepresentationTheory.GrothendieckGroup.GroupAlgebra.Projection

/-!
# The classes of `G₀(k[G])` induced from a family of subgroups

Let `k` be a commutative ring and `G` a finite group. A family of subgroups of `G`, singled out by
a predicate `P : Subgroup G → Prop`, spans a subgroup of the Grothendieck group `G₀(k[G])`, namely
the subgroup

`indClassesK0 k G P = ⨆ C, ⨆ _ : P C, (indK0 k C).range`

generated by the classes induced from the members of the family. It is the `G₀` counterpart of
Tau Ceti's `TauCeti.ClassFunction.indVirtualCharacters`, and it is the subgroup in which induction
theorems place a multiple of every class. The whole of `G₀(k[C])` is induced, not only the
permutation classes of `C`, which is why the subgroup is defined from the ranges of `TauCeti.indK0`
rather than from coset classes.

Over a field, `indClassesK0 k G P` is an **ideal** of the Grothendieck ring `G₀(k[G])`
(`TauCeti.mul_mem_indClassesK0`): the projection formula `TauCeti.indK0_mul_resK0` rewrites the
product `x · Ind_C^G y` as `Ind_C^G (y · Res_C^G x)`, which is induced from `C` again. This is the
mechanism by which an identity among induced classes, such as Artin's identity, spreads from the
unit to every class of `G₀(k[G])`.

Two instances are the ones the induction theorems are stated with: `TauCeti.indCyclicK0`, the
classes induced from cyclic subgroups, and `TauCeti.indCyclicCoprimeK0 ℓ`, the classes induced
from cyclic subgroups of order prime to `ℓ`. Both are everything when `G` is itself cyclic (of
order prime to `ℓ` in the second case), since the whole group is then a member of the family and
induction from `⊤` is surjective (`TauCeti.indClassesK0_eq_top`). Induction from `⊤` is in fact
inverse to restriction to `⊤`, which is an equivalence of representation categories with
induction as its right adjoint (`Rep.resIndAdjunction`), so the computations at `⊤` are over a
commutative ring, like the definitions; only the ideal property needs the ring structure of
`G₀(k[G])` and hence a field.

## Main definitions

* `TauCeti.indClassesK0`: the subgroup of `G₀(k[G])` generated by the classes induced from the
  subgroups of a family.
* `TauCeti.indCyclicK0`: the classes induced from cyclic subgroups.
* `TauCeti.indCyclicCoprimeK0`: the classes induced from cyclic subgroups of order prime to a
  given natural number.

## Main results

* `TauCeti.indK0_mem_indClassesK0` and `TauCeti.indClassesK0_le_iff`: membership of an induced
  class, and the universal property of the subgroup it generates.
* `TauCeti.mul_mem_indClassesK0`: the induced classes form an ideal, by the projection formula.
* `TauCeti.permK0_quotient_mem_indClassesK0`: the coset permutation class of a member of the
  family is induced from it.
* `TauCeti.indClassesK0_eq_top`: a family containing `⊤` induces all of `G₀(k[G])`.
* `TauCeti.indCyclicK0_eq_top` and `TauCeti.indCyclicCoprimeK0_eq_top`: for a cyclic group every
  class is induced from a cyclic subgroup, and from one of order prime to `ℓ` when the order is
  prime to `ℓ`.

## References

* J.-P. Serre, *Linear Representations of Finite Groups*, Springer GTM 42 (1977), §9.2 and §14.1,
  for the subgroup of `R(G)` generated by the characters induced from a family of subgroups.
* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, second edition, Springer
  (2008), VII.3, for the spanning lemma stated in this subgroup.
-/

public section

open scoped MonoidAlgebra

namespace TauCeti

universe u

section CommRing

variable (k : Type u) [CommRing k] (G : Type u) [Group G] [Finite G]

/-- **The classes induced from a family of subgroups.** For a predicate `P` on the subgroups of a
finite group `G`, this is the subgroup of `G₀(k[G])` generated by the images of `TauCeti.indK0`
over the subgroups `C` with `P C`: the classes that are sums of classes induced from members of
the family. Membership is `TauCeti.indK0_mem_indClassesK0`, and
`TauCeti.indClassesK0_le_iff` is its universal property. -/
noncomputable def indClassesK0 (P : Subgroup G → Prop) :
    AddSubgroup (ExactK0 (finiteModulesExactStructure k[G])) :=
  ⨆ (C : Subgroup G) (_ : P C), (indK0 k C).range

variable {G}

/-- A class induced from a member of the family lies in the subgroup the family generates. -/
theorem indK0_mem_indClassesK0 {P : Subgroup G → Prop} {C : Subgroup G} (hC : P C)
    (y : ExactK0 (finiteModulesExactStructure k[C])) :
    indK0 k C y ∈ indClassesK0 k G P :=
  le_iSup₂ (f := fun (C : Subgroup G) (_ : P C) ↦ (indK0 k C).range) C hC ⟨y, rfl⟩

/-- **The universal property of the induced classes.** The subgroup generated by the classes
induced from a family is contained in a subgroup `T` exactly when every class induced from a
member of the family lies in `T`. -/
theorem indClassesK0_le_iff {P : Subgroup G → Prop}
    {T : AddSubgroup (ExactK0 (finiteModulesExactStructure k[G]))} :
    indClassesK0 k G P ≤ T ↔
      ∀ C : Subgroup G, P C → ∀ y : ExactK0 (finiteModulesExactStructure k[C]),
        indK0 k C y ∈ T := by
  refine ⟨fun h C hC y ↦ h (indK0_mem_indClassesK0 k hC y), fun h ↦ iSup₂_le fun C hC ↦ ?_⟩
  rintro _ ⟨y, rfl⟩
  exact h C hC y

/-- **The induced classes grow with the family.** -/
theorem indClassesK0_le_indClassesK0 {P Q : Subgroup G → Prop} (h : ∀ C, P C → Q C) :
    indClassesK0 k G P ≤ indClassesK0 k G Q :=
  (indClassesK0_le_iff k).2 fun C hC y ↦ indK0_mem_indClassesK0 k (h C hC) y

/-- Logically equivalent families induce the same classes. -/
theorem indClassesK0_congr {P Q : Subgroup G → Prop} (h : ∀ C, P C ↔ Q C) :
    indClassesK0 k G P = indClassesK0 k G Q :=
  le_antisymm (indClassesK0_le_indClassesK0 k fun C hC ↦ (h C).1 hC)
    (indClassesK0_le_indClassesK0 k fun C hC ↦ (h C).2 hC)

/-- **Induction from `⊤` undoes restriction to `⊤`.** Restriction along `(⊤ : Subgroup G).subtype`
is an equivalence of representation categories, with inverse restriction along
`Subgroup.topEquiv.symm`, and induction is right adjoint to it (`Rep.resIndAdjunction`); a right
adjoint is unique, so inducing a restricted representation gives it back. Private: it exists only
to feed `TauCeti.indClassesK0_eq_top`. -/
private noncomputable def indTopEquiv {W : Type u} [AddCommGroup W] [Module k W]
    (σ : Representation k G W) :
    (Representation.ind (⊤ : Subgroup G).subtype
      (σ.comp (⊤ : Subgroup G).subtype)).Equiv σ := by
  classical
  exact Representation.equivOfIso
    ((CategoryTheory.Adjunction.rightAdjointUniq (Rep.resIndAdjunction k ⊤)
      (CategoryTheory.Equivalence.mk (Rep.resFunctor (⊤ : Subgroup G).subtype)
        (Rep.resFunctor (Subgroup.topEquiv (G := G)).symm.toMonoidHom)
        (CategoryTheory.eqToIso rfl) (CategoryTheory.eqToIso rfl)).toAdjunction).app
      (Rep.of (σ.comp (⊤ : Subgroup G).subtype)))

/-- **A family containing `⊤` induces everything.** Induction from the whole group is inverse to
restriction to it, so every class, being the class of some module, is induced from `⊤`. -/
theorem indClassesK0_eq_top {P : Subgroup G → Prop} (hP : P ⊤) : indClassesK0 k G P = ⊤ := by
  rw [eq_top_iff, ← ExactK0.closure_range_of, AddSubgroup.closure_le]
  rintro _ ⟨M, rfl⟩
  -- Write `M` as the module of the representation `σ` it defines, as in `TauCeti.indK0_indK0`.
  let := Module.restrictScalars k k[G] M.obj
  have := IsScalarTower.restrictScalars k k[G] M.obj
  have : Module.Finite k[G] M.obj := M.2
  have : Module.Finite k M.obj := Module.Finite.trans k[G] M.obj
  let σ := Representation.ofModule' (k := k) (G := G) M.obj
  have : Module.Finite k[G] σ.asModule := Module.Finite.of_restrictScalars_finite k _ σ.asModule
  have hM : (ExactK0.of M : ExactK0 (finiteModulesExactStructure k[G])) =
      ExactK0.of (FGModuleCat.of _ σ.asModule) :=
    ExactK0.of_congr (Representation.ofModule'AsModuleEquiv M.obj).symm.toFGModuleCatIso
  rw [SetLike.mem_coe, hM,
    ← indK0_of_asModule_of_equiv k ⊤ (σ.comp (⊤ : Subgroup G).subtype) σ (indTopEquiv k σ)]
  exact indK0_mem_indClassesK0 k hP _

end CommRing

section Field

variable {k : Type u} [Field k] {G : Type u} [Group G] [Finite G]

/-- **The induced classes form an ideal of `G₀(k[G])`.** Multiplying a class induced from `C` by
an arbitrary class `z` gives the class induced from `C` of the product with the restriction of
`z`, by the projection formula `TauCeti.indK0_mul_resK0`; so the subgroup generated by the classes
induced from any family is stable under multiplication. -/
theorem mul_mem_indClassesK0 {P : Subgroup G → Prop}
    {x : ExactK0 (finiteModulesExactStructure k[G])} (hx : x ∈ indClassesK0 k G P)
    (z : ExactK0 (finiteModulesExactStructure k[G])) : z * x ∈ indClassesK0 k G P := by
  have h : indClassesK0 k G P ≤ (indClassesK0 k G P).comap (AddMonoidHom.mulLeft z) := by
    refine (indClassesK0_le_iff k).2 fun C hC y ↦ ?_
    simp only [AddSubgroup.mem_comap, AddMonoidHom.coe_mulLeft]
    rw [mul_comm, ← indK0_mul_resK0]
    exact indK0_mem_indClassesK0 k hC _
  exact h hx

/-- **The coset permutation class of a member of the family is induced from it**: the class
`[k[G ⧸ C]]` is the induction of the unit of `G₀(k[C])` (`TauCeti.indK0_one`). -/
theorem permK0_quotient_mem_indClassesK0 {P : Subgroup G → Prop} {C : Subgroup G} (hC : P C) :
    permK0 k G (G ⧸ C) ∈ indClassesK0 k G P := by
  rw [← indK0_one (k := k) (S := C)]
  exact indK0_mem_indClassesK0 k hC 1

end Field

section Cyclic

variable (k : Type u) [CommRing k] (G : Type u) [Group G] [Finite G]

/-- **The classes induced from cyclic subgroups**, the subgroup of `G₀(k[G])` in which Artin's
induction theorem places a multiple of every class. -/
noncomputable abbrev indCyclicK0 : AddSubgroup (ExactK0 (finiteModulesExactStructure k[G])) :=
  indClassesK0 k G fun C ↦ IsCyclic C

/-- **The classes induced from cyclic subgroups of order prime to `ℓ`**, the subgroup of
`G₀(k[G])` in which the modular Artin theorem places a multiple of every class. For a prime `ℓ`,
the case the modular theorem is stated in, coprimality of the order is non-divisibility by `ℓ`
(`Nat.Prime.coprime_iff_not_dvd`), so the family is the cyclic `ℓ′`-subgroups. -/
noncomputable abbrev indCyclicCoprimeK0 (ℓ : ℕ) :
    AddSubgroup (ExactK0 (finiteModulesExactStructure k[G])) :=
  indClassesK0 k G fun C ↦ IsCyclic C ∧ Nat.Coprime ℓ (Nat.card C)

/-- The classes induced from cyclic subgroups of order prime to `ℓ` are induced from cyclic
subgroups. -/
theorem indCyclicCoprimeK0_le_indCyclicK0 (ℓ : ℕ) :
    indCyclicCoprimeK0 k G ℓ ≤ indCyclicK0 k G :=
  indClassesK0_le_indClassesK0 k fun _ hC ↦ hC.1

/-- **For a cyclic group every class is induced from a cyclic subgroup**, the whole group being
one. Artin's theorem is vacuous here: no multiplier is needed. -/
theorem indCyclicK0_eq_top [IsCyclic G] : indCyclicK0 k G = ⊤ :=
  indClassesK0_eq_top k (Subgroup.isCyclic ⊤)

/-- **For a cyclic group of order prime to `ℓ` every class is induced from a cyclic subgroup of
order prime to `ℓ`**, the whole group being one. -/
theorem indCyclicCoprimeK0_eq_top [IsCyclic G] {ℓ : ℕ} (hℓ : Nat.Coprime ℓ (Nat.card G)) :
    indCyclicCoprimeK0 k G ℓ = ⊤ :=
  indClassesK0_eq_top k ⟨Subgroup.isCyclic ⊤, by rwa [Subgroup.card_top]⟩

variable {G}

/-- **Induction from the subgroup generated by an element lands in the cyclic classes.** Every
element `g` generates a cyclic subgroup, so the classes induced from `Subgroup.zpowers g` are
cyclically induced. -/
theorem indK0_zpowers_mem_indCyclicK0 (g : G)
    (y : ExactK0 (finiteModulesExactStructure k[Subgroup.zpowers g])) :
    indK0 k (Subgroup.zpowers g) y ∈ indCyclicK0 k G :=
  indK0_mem_indClassesK0 k (Subgroup.isCyclic_zpowers g) y

/-- **Classes induced from the trivial subgroup are induced from a cyclic `ℓ′`-subgroup.** The
trivial subgroup is cyclic of order `1`, which is prime to every `ℓ`. -/
theorem indK0_bot_mem_indCyclicCoprimeK0 (ℓ : ℕ)
    (y : ExactK0 (finiteModulesExactStructure k[(⊥ : Subgroup G)])) :
    indK0 k ⊥ y ∈ indCyclicCoprimeK0 k G ℓ := by
  refine indK0_mem_indClassesK0 k ⟨Bot.isCyclic, ?_⟩ y
  rw [Subgroup.card_bot]
  exact Nat.coprime_one_right ℓ

end Cyclic

end TauCeti
