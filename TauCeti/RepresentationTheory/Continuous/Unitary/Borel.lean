public import TauCeti.Topology.Algebra.Group.Baire

/-!
# Borel unitary representations and automatic strong continuity

A unitary group representation `π : ContRepresentation 𝕜 G H` on a complete inner product space `H`
corresponds bijectively to a group homomorphism `G →* TauCeti.StrongUnitary 𝕜 H`: strong continuity
of the orbits `g ↦ π g ξ` is equivalent both to continuity of the induced homomorphism into
`StrongUnitary 𝕜 H` and to weak continuity of the matrix coefficients `g ↦ ⟪ξ, π g η⟫_𝕜`.

When `H` is separable, `StrongUnitary 𝕜 H` is a Polish topological group whose Borel σ-algebra is
generated by the matrix coefficients along any countable dense family `d : ι → H`. Combining the
matrix-coefficient comparison
(`TauCeti.StrongUnitary.measurable_iff_forall_measurable_inner_of_dense`) with Pettis automatic
continuity (`TauCeti.continuous_of_measurable_monoidHom`) yields **automatic strong continuity of
Borel unitary representations**: on any Baire Borel topological group `G` (in particular any Polish
group or any locally compact Hausdorff group), a unitary representation on a separable Hilbert space
is strongly continuous as soon as its matrix coefficients along a countable dense subset of `H` are
Borel-measurable.

## Main declarations

* `TauCeti.StrongUnitary.toContRepresentation` and
  `ContRepresentation.IsUnitary.toStrongUnitaryHom`: mutually inverse constructions between group
  homomorphisms `G →* StrongUnitary 𝕜 H` and unitary representations `ContRepresentation 𝕜 G H`.
* `ContRepresentation.IsUnitary.continuous_toStrongUnitaryHom_iff` and
  `ContRepresentation.IsUnitary.continuous_apply_iff_continuous_inner`: equivalence of strong
  continuity, continuity into `StrongUnitary 𝕜 H`, and weak continuity of matrix coefficients.
* `ContRepresentation.IsUnitary.measurable_toStrongUnitaryHom_iff_inner_of_dense`: Borel
  measurability into `StrongUnitary 𝕜 H` is tested on countable dense matrix coefficients.
* `ContRepresentation.IsUnitary.continuous_apply_of_measurable_inner_of_dense` and
  `ContRepresentation.IsUnitary.continuous_apply_iff_measurable_inner_of_dense`: automatic strong
  continuity of unitary representations on Baire Borel topological groups.

## References

* D. P. Williams, *Crossed Products of C*-Algebras*, Mathematical Surveys and Monographs 134, AMS,
  2007, Theorem D.11 and Lemmas D.42–D.43.
-/

public noncomputable section

open MeasureTheory Topology TopologicalSpace
open scoped InnerProductSpace

namespace TauCeti.StrongUnitary

variable {𝕜 G H : Type*} [RCLike 𝕜] [Group G] [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]
  [CompleteSpace H]

/-- Evaluation into `H →L[𝕜] H` as a monoid homomorphism on `StrongUnitary 𝕜 H`. -/
def toCLMMonoidHom : StrongUnitary 𝕜 H →* (H →L[𝕜] H) where
  toFun := toCLM
  map_one' := toCLM_one
  map_mul' := toCLM_mul

@[simp]
theorem toCLMMonoidHom_apply (u : StrongUnitary 𝕜 H) : toCLMMonoidHom u = u.toCLM := by
  rfl

/-- View a group homomorphism into `StrongUnitary 𝕜 H` as a `ContRepresentation 𝕜 G H`. -/
def toContRepresentation (φ : G →* StrongUnitary 𝕜 H) : ContRepresentation 𝕜 G H :=
  ContRepresentation.ofMonoidHom (toCLMMonoidHom.comp φ)

@[simp]
theorem toContRepresentation_apply (φ : G →* StrongUnitary 𝕜 H) (g : G) :
    toContRepresentation φ g = (φ g).toCLM := by
  rfl

theorem toContRepresentation_apply_apply (φ : G →* StrongUnitary 𝕜 H) (g : G) (ξ : H) :
    toContRepresentation φ g ξ = φ g ξ := by
  rw [toContRepresentation_apply, toCLM_apply]

/-- Every group homomorphism into `StrongUnitary 𝕜 H` defines a unitary representation. -/
theorem isUnitary_toContRepresentation (φ : G →* StrongUnitary 𝕜 H) :
    (toContRepresentation φ).IsUnitary :=
  (ContRepresentation.isUnitary_iff_norm_map _).2 fun g ξ => by
    rw [toContRepresentation_apply_apply, SemilinearIsometryClass.norm_map]

end TauCeti.StrongUnitary

namespace ContRepresentation.IsUnitary

variable {𝕜 G H : Type*} [RCLike 𝕜] [Group G] [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]
  [CompleteSpace H] {π : ContRepresentation 𝕜 G H}

/-- Bundle a unitary group representation `π` as a group homomorphism `G →* StrongUnitary 𝕜 H`. -/
def toStrongUnitaryHom (hπ : π.IsUnitary) : G →* TauCeti.StrongUnitary 𝕜 H where
  toFun g := .ofUnitary ⟨π g, hπ.mem_unitary g⟩
  map_one' := TauCeti.StrongUnitary.toUnitary_injective <| Subtype.ext (map_one π)
  map_mul' g₁ g₂ := TauCeti.StrongUnitary.toUnitary_injective <| Subtype.ext (map_mul π g₁ g₂)

@[simp]
theorem toCLM_toStrongUnitaryHom (hπ : π.IsUnitary) (g : G) :
    (hπ.toStrongUnitaryHom g).toCLM = π g := by
  simp [toStrongUnitaryHom]

@[simp]
theorem toStrongUnitaryHom_apply (hπ : π.IsUnitary) (g : G) (ξ : H) :
    hπ.toStrongUnitaryHom g ξ = π g ξ := by
  simp [toStrongUnitaryHom]

@[simp]
theorem toContRepresentation_toStrongUnitaryHom (hπ : π.IsUnitary) :
    TauCeti.StrongUnitary.toContRepresentation hπ.toStrongUnitaryHom = π := by
  apply DFunLike.ext
  intro g
  simp

@[simp]
theorem toStrongUnitaryHom_toContRepresentation (φ : G →* TauCeti.StrongUnitary 𝕜 H) :
    (TauCeti.StrongUnitary.isUnitary_toContRepresentation φ).toStrongUnitaryHom = φ := by
  ext g ξ
  simp

section Topological

variable [TopologicalSpace G]

/-- Continuity of `hπ.toStrongUnitaryHom` into `StrongUnitary 𝕜 H` is strong continuity of `π`. -/
theorem continuous_toStrongUnitaryHom_iff (hπ : π.IsUnitary) :
    Continuous hπ.toStrongUnitaryHom ↔ ∀ ξ, Continuous fun g => π g ξ := by
  simp_rw [TauCeti.StrongUnitary.continuous_iff_forall_continuous, hπ.toStrongUnitaryHom_apply]

/-- A unitary group representation is strongly continuous if and only if all of its matrix
coefficients `g ↦ ⟪ξ, π g η⟫_𝕜` are continuous. -/
theorem continuous_apply_iff_continuous_inner (hπ : π.IsUnitary) :
    (∀ ξ, Continuous fun g => π g ξ) ↔ ∀ ξ η, Continuous fun g => ⟪ξ, π g η⟫_𝕜 := by
  simp_rw [← hπ.continuous_toStrongUnitaryHom_iff,
    TauCeti.StrongUnitary.continuous_iff_forall_inner_continuous, hπ.toStrongUnitaryHom_apply]

end Topological

section Measurable

variable [MeasurableSpace G] [SeparableSpace H] [MeasurableSpace 𝕜] [BorelSpace 𝕜]

/-- Borel measurability of `hπ.toStrongUnitaryHom` is equivalent to measurability of matrix
coefficients along any countable dense family in `H`. -/
theorem measurable_toStrongUnitaryHom_iff_inner_of_dense {ι : Type*} [Countable ι] {d : ι → H}
    (hπ : π.IsUnitary) (hd : DenseRange d) :
    Measurable hπ.toStrongUnitaryHom ↔ ∀ i j : ι, Measurable fun g => ⟪d i, π g (d j)⟫_𝕜 := by
  simp_rw [TauCeti.StrongUnitary.measurable_iff_forall_measurable_inner_of_dense hd,
    hπ.toStrongUnitaryHom_apply]

/-- Borel measurability of `hπ.toStrongUnitaryHom` is equivalent to measurability of all matrix
coefficients `g ↦ ⟪ξ, π g η⟫_𝕜`. -/
theorem measurable_toStrongUnitaryHom_iff_inner (hπ : π.IsUnitary) :
    Measurable hπ.toStrongUnitaryHom ↔ ∀ ξ η : H, Measurable fun g => ⟪ξ, π g η⟫_𝕜 := by
  simp_rw [TauCeti.StrongUnitary.measurable_iff_forall_measurable_inner,
    hπ.toStrongUnitaryHom_apply]

/-- Borel measurability of `hπ.toStrongUnitaryHom` is equivalent to Borel measurability of all
orbits `g ↦ π g η`. -/
theorem measurable_toStrongUnitaryHom_iff_apply [MeasurableSpace H] [BorelSpace H]
    (hπ : π.IsUnitary) :
    Measurable hπ.toStrongUnitaryHom ↔ ∀ η : H, Measurable fun g => π g η := by
  simp_rw [TauCeti.StrongUnitary.measurable_iff_forall_measurable_apply,
    hπ.toStrongUnitaryHom_apply]

end Measurable

section AutomaticContinuity

variable [TopologicalSpace G] [IsTopologicalGroup G] [BaireSpace G]
  [MeasurableSpace G] [BorelSpace G] [SeparableSpace H] [MeasurableSpace 𝕜] [BorelSpace 𝕜]

/-- **Automatic strong continuity of Borel unitary representations.** On a Baire Borel topological
group `G` (such as any Polish group or any locally compact Hausdorff group), if `H` is separable and
the matrix coefficients `g ↦ ⟪d i, π g (d j)⟫_𝕜` of a unitary representation `π` are measurable
along a countable dense family `d : ι → H`, then every orbit `g ↦ π g ξ` is continuous. -/
theorem continuous_apply_of_measurable_inner_of_dense {ι : Type*} [Countable ι] {d : ι → H}
    (hπ : π.IsUnitary) (hd : DenseRange d)
    (hm : ∀ i j : ι, Measurable fun g => ⟪d i, π g (d j)⟫_𝕜) (ξ : H) :
    Continuous fun g => π g ξ :=
  (hπ.continuous_toStrongUnitaryHom_iff.1 <|
    TauCeti.continuous_of_measurable_monoidHom hπ.toStrongUnitaryHom
      ((hπ.measurable_toStrongUnitaryHom_iff_inner_of_dense hd).2 hm)) ξ

/-- If all matrix coefficients `g ↦ ⟪ξ, π g η⟫_𝕜` of a unitary representation of a Baire Borel
topological group on a separable Hilbert space are measurable, then `π` is strongly continuous. -/
theorem continuous_apply_of_measurable_inner (hπ : π.IsUnitary)
    (hm : ∀ ξ η : H, Measurable fun g => ⟪ξ, π g η⟫_𝕜) (ξ : H) :
    Continuous fun g => π g ξ := by
  obtain ⟨d, hd⟩ := TopologicalSpace.exists_dense_seq H
  exact hπ.continuous_apply_of_measurable_inner_of_dense hd (fun i j => hm (d i) (d j)) ξ

/-- On a Baire Borel topological group `G` and separable Hilbert space `H`, strong continuity of a
unitary representation is equivalent to Borel measurability of its matrix coefficients on any
countable dense subset of `H`. -/
theorem continuous_apply_iff_measurable_inner_of_dense {ι : Type*} [Countable ι] {d : ι → H}
    (hπ : π.IsUnitary) (hd : DenseRange d) :
    (∀ ξ, Continuous fun g => π g ξ) ↔ ∀ i j : ι, Measurable fun g => ⟪d i, π g (d j)⟫_𝕜 :=
  ⟨fun hc _ j => (continuous_const.inner (hc (d j))).measurable,
    hπ.continuous_apply_of_measurable_inner_of_dense hd⟩

/-- On a Baire Borel topological group `G` and separable Hilbert space `H`, strong continuity of a
unitary representation is equivalent to Borel measurability of all its matrix coefficients. -/
theorem continuous_apply_iff_measurable_inner (hπ : π.IsUnitary) :
    (∀ ξ, Continuous fun g => π g ξ) ↔ ∀ ξ η : H, Measurable fun g => ⟪ξ, π g η⟫_𝕜 :=
  ⟨fun hc _ η => (continuous_const.inner (hc η)).measurable,
    hπ.continuous_apply_of_measurable_inner⟩

end AutomaticContinuity

end ContRepresentation.IsUnitary
