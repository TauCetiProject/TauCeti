module

public import TauCeti.Analysis.VonNeumannAlgebra.Adjoin
public import TauCeti.RepresentationTheory.Continuous.Unitary.Basic

/-!
# Commutant of the von Neumann algebra generated by a unitary representation

When building von Neumann algebras generated by unitary group representations—such as the left and
right group von Neumann algebras `L(Γ)` and `R(Γ)`—checking membership in the commutant reduces to
commuting with the group generators because the range of a unitary representation `π` is closed
under adjoints (`star (π g) = π g⁻¹`), formalized in
`ContRepresentation.IsUnitary.mem_commutant_adjoin_range_iff`.
-/

public section

namespace ContRepresentation.IsUnitary

/-- An operator lies in the commutant of the von Neumann algebra generated by the range of a
unitary group representation `π` if and only if it commutes with every `π g`. -/
theorem mem_commutant_adjoin_range_iff {G H : Type*} [Group G] [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] {π : ContRepresentation ℂ G H}
    (hπ : IsUnitary π) {T : H →L[ℂ] H} :
    T ∈ (VonNeumannAlgebra.adjoin (Set.range π)).commutant ↔ ∀ g : G, π g * T = T * π g := by
  refine ⟨fun hT g => VonNeumannAlgebra.mem_commutant_iff.1 hT _
      (VonNeumannAlgebra.subset_adjoin _ ⟨g, rfl⟩),
    fun hT => ?_⟩
  rw [← SetLike.mem_coe, VonNeumannAlgebra.coe_commutant_adjoin, Set.mem_centralizer_iff]
  rintro x (⟨g, rfl⟩ | hx)
  · exact hT g
  · obtain ⟨g, hg⟩ := Set.mem_star.1 hx
    have hstar : x = π g⁻¹ := by simpa [hπ.star_eq_inv] using congr_arg star hg.symm
    exact hstar ▸ hT g⁻¹
end ContRepresentation.IsUnitary
