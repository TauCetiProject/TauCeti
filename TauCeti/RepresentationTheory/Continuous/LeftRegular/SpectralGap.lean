/-!
# Hulanicki–Reiter almost-invariant vectors and spectral gap of the regular representation

For a group `G`, combining the Koopman $P_2$ converse criterion
(`Measure.exists_finset_card_smul_symmDiff_lt_of_hasAlmostInvariantVectors_count_koopman`) with
Følner indicators (`Measure.hasAlmostInvariantVectors_count_leftRegular`) yields the
Hulanicki–Reiter equivalence between Følner sets on `G` and almost invariant vectors in the
vector-valued counting-measure regular representation `ℓ²(G, E)`. Together with vanishing of
invariants on infinite groups (`Measure.invariants_count_leftRegular`) and Anantharaman–Popa
Lemma 15.1.9 (`Measure.hasSpectralGap_count_koopman_of_finite_stabilizer`), this characterizes when
`ℓ²(G, E)` has spectral gap: precisely when `G` is finite, `E` is a subsingleton, or `G` does not
have Følner sets.

Specializing to nonamenable finitely generated groups gives a uniform Poincaré-type inequality on
*all* of `ℓ²(G, E)` summed over any finite generating set. In particular, the left regular
representation of any free group on at least two generators (`FreeGroup α` with `[Nontrivial α]`)
has spectral gap, whereas the left regular representation of any infinite commutative group (and in
particular `Multiplicative ℤ`) does not.

## Main results

* `Measure.hasAlmostInvariantVectors_count_leftRegular_iff` and
  `Measure.hasAlmostInvariantVectors_count_leftRegular_scalar_iff`: Hulanicki–Reiter equivalence
  between Følner sets and almost invariant vectors in `ℓ²(G, E)`.
* `Measure.hasSpectralGap_count_leftRegular_iff` and
  `Measure.hasSpectralGap_count_leftRegular_scalar_iff`: complete characterization of spectral gap
  for `ℓ²(G, E)`.
* `Measure.exists_norm_sq_le_sum_count_leftRegular_of_closure_eq_top`: when `G` has no Følner sets
  and is generated by a finite set `S`, `‖v‖² ≤ C ∑_{s ∈ S} ‖λ s v - v‖²` for every `v ∈ ℓ²(G, E)`.
* `Measure.hasSpectralGap_count_leftRegular_freeGroup`,
  `Measure.exists_norm_sq_le_sum_count_leftRegular_freeGroup`, and
  `Measure.exists_norm_sq_le_add_count_leftRegular_freeGroup_of_equiv_fin_two`: spectral gap of the
  left regular representation of nonabelian free groups.
* `Measure.not_hasSpectralGap_count_leftRegular_of_commGroup` and
  `Measure.not_hasSpectralGap_count_leftRegular_multiplicative_int`: failure of spectral gap for
  infinite commutative groups and `Multiplicative ℤ`.

## References

* B. Bekka, P. de la Harpe, A. Valette, *Kazhdan's Property (T)*, Theorem G.3.2 and Appendix G.5.
* C. Anantharaman, S. Popa, *An Introduction to II₁ Factors*, Proposition 15.1.3 and Lemma 15.1.9.
-/

public section

open MeasureTheory Finset
open scoped ENNReal Pointwise symmDiff

namespace MeasureTheory.Measure

section P2Inequality

variable {G 𝕜 E : Type*} [Group G] [MeasurableSpace G] [MeasurableMul G] [RCLike 𝕜]
  [NormedAddCommGroup E] [NormedSpace 𝕜 E] (μ : Measure G) [μ.IsMulLeftInvariant]

/-- **$P_2$ squared-density variation bound for left translation.** For `f ∈ L²(G, E; μ)` and
`g : G`, the `L¹(μ)` variation of `x ↦ ‖f x‖²` under left translation is at most
`2 ‖f‖ ‖λ g f - f‖`. -/
theorem integral_abs_norm_sq_leftRegular_sub_le (g : G) (f : Lp E 2 μ) :
    ∫ x, |‖f (g⁻¹ * x)‖ ^ 2 - ‖f x‖ ^ 2| ∂μ ≤ 2 * ‖f‖ * ‖μ.leftRegular 𝕜 E 2 g f - f‖ := by
  rw [← koopman_eq_leftRegular]
  exact integral_abs_norm_sq_koopman_sub_le (G := G) (𝕜 := 𝕜) μ g f

/-- Unit-vector specialization of `integral_abs_norm_sq_leftRegular_sub_le`. -/
theorem integral_abs_norm_sq_leftRegular_sub_le_two_mul (g : G) {f : Lp E 2 μ} (hf : ‖f‖ = 1) :
    ∫ x, |‖f (g⁻¹ * x)‖ ^ 2 - ‖f x‖ ^ 2| ∂μ ≤ 2 * ‖μ.leftRegular 𝕜 E 2 g f - f‖ := by
  simpa [hf] using integral_abs_norm_sq_leftRegular_sub_le (𝕜 := 𝕜) μ g f

end P2Inequality

section AlmostInvariant

variable {G 𝕜 E : Type*} [Group G] [MeasurableSpace G] [MeasurableSingletonClass G]
  [MeasurableMul G] [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- **Hulanicki–Reiter converse.** Almost invariant vectors in `ℓ²(G, E)` yield Følner sets in
`G`. -/
theorem hasFoelnerSets_of_hasAlmostInvariantVectors_count_leftRegular
    (h : ((count : Measure G).leftRegular 𝕜 E 2).HasAlmostInvariantVectors) :
    TauCeti.HasFoelnerSets G := by
  classical
  rw [← koopman_eq_leftRegular] at h
  rw [TauCeti.hasFoelnerSets_iff]
  intro K ε hε
  exact exists_finset_card_smul_symmDiff_lt_of_hasAlmostInvariantVectors_count_koopman h K hε

/-- **Hulanicki–Reiter characterization of almost invariant vectors in `ℓ²(G, E)`.** The
vector-valued counting-measure regular representation has almost invariant vectors if and only if
`E` is nontrivial and `G` has Følner sets. -/
theorem hasAlmostInvariantVectors_count_leftRegular_iff :
    ((count : Measure G).leftRegular 𝕜 E 2).HasAlmostInvariantVectors ↔
      Nontrivial E ∧ TauCeti.HasFoelnerSets G := by
  classical
  constructor
  · intro h
    refine ⟨?_, hasFoelnerSets_of_hasAlmostInvariantVectors_count_leftRegular h⟩
    by_contra hsub
    rw [not_nontrivial_iff_subsingleton] at hsub
    obtain ⟨v, hv⟩ := h.exists_ne_zero
    exact hv (Lp.eq_zero_iff_ae_eq_zero.mpr (ae_of_all _ fun x ↦ Subsingleton.elim (v x) 0))
  · rintro ⟨hE, hG⟩
    obtain ⟨w, hw⟩ := exists_ne (0 : E)
    rw [← koopman_eq_leftRegular, ContRepresentation.hasAlmostInvariantVectors_def]
    intro K ε hε
    let c : E := (‖w‖⁻¹ : 𝕜) • w
    have hc : ‖c‖ = 1 := norm_smul_inv_norm hw
    obtain ⟨F, hF, hboundary⟩ := TauCeti.hasFoelnerSets_iff.mp hG K (ε ^ 2) (sq_pos_of_pos hε)
    let ξ : Lp E 2 (count : Measure G) := indicatorConstLp 2 F.measurableSet (by simp) c
    have hnorm : ‖ξ‖ = Real.sqrt (#F : ℝ) := by
      rw [norm_indicatorConstLp (by simp) (by simp)]
      simp [hc, measureReal_def, Real.sqrt_eq_rpow]
    have hcard : (0 : ℝ) < #F := Nat.cast_pos.mpr hF.card_pos
    have hξ : ξ ≠ 0 := norm_ne_zero_iff.mp (by rw [hnorm]; positivity)
    refine ⟨(‖ξ‖⁻¹ : 𝕜) • ξ, norm_smul_inv_norm hξ, fun g hg ↦ ?_⟩
    rw [map_smul, ← smul_sub]
    have hdisp : ‖(count : Measure G).leftRegular 𝕜 E 2 g ξ - ξ‖ =
        Real.sqrt (#((g • F) ∆ F) : ℝ) := by
      rw [← koopman_eq_leftRegular]
      simpa [hc] using F.norm_count_koopman_sub_indicatorConstLp (G := G) (𝕜 := 𝕜) g c
    have hroot : Real.sqrt (#((g • F) ∆ F) : ℝ) < ε * Real.sqrt (#F : ℝ) := by
      apply (sq_lt_sq₀ (Real.sqrt_nonneg _) (by positivity)).mp
      rw [Real.sq_sqrt (by positivity), mul_pow, Real.sq_sqrt hcard.le]
      exact hboundary g hg
    rw [koopman_eq_leftRegular]
    simpa [norm_smul, hnorm, hdisp, abs_of_nonneg (Real.sqrt_nonneg _)] using
      (inv_mul_lt_iff₀ (Real.sqrt_pos.mpr hcard)).mpr (by simpa [mul_comm] using hroot)

/-- Scalar specialization of `hasAlmostInvariantVectors_count_leftRegular_iff`: `ℓ²(G, 𝕜)` has
almost invariant vectors if and only if `G` has Følner sets. -/
theorem hasAlmostInvariantVectors_count_leftRegular_scalar_iff :
    ((count : Measure G).leftRegular 𝕜 𝕜 2).HasAlmostInvariantVectors ↔
      TauCeti.HasFoelnerSets G := by
  rw [hasAlmostInvariantVectors_count_leftRegular_iff]
  exact and_iff_right inferInstance

/-- Discrete-group amenability form of `hasAlmostInvariantVectors_count_leftRegular_iff`. -/
theorem hasAlmostInvariantVectors_count_leftRegular_iff_amenable [TopologicalSpace G]
    [DiscreteTopology G] [IsTopologicalGroup G] :
    ((count : Measure G).leftRegular 𝕜 E 2).HasAlmostInvariantVectors ↔
      Nontrivial E ∧ TauCeti.Amenable G := by
  rw [hasAlmostInvariantVectors_count_leftRegular_iff, TauCeti.amenable_iff_hasFoelnerSets]

end AlmostInvariant

section SpectralGap

variable {G 𝕜 E : Type*} [Group G] [MeasurableSpace G] [MeasurableSingletonClass G]
  [MeasurableMul G] [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]

/-- If `G` does not have Følner sets, then its counting-measure regular representation on
`ℓ²(G, E)` has spectral gap. -/
theorem hasSpectralGap_count_leftRegular_of_not_hasFoelnerSets (hG : ¬ TauCeti.HasFoelnerSets G) :
    ((count : Measure G).leftRegular 𝕜 E 2).HasSpectralGap := by
  rw [← koopman_eq_leftRegular]
  refine hasSpectralGap_count_koopman_of_finite_stabilizer hG fun x _ ↦ ?_
  have : Subsingleton (MulAction.stabilizer G x) :=
    ⟨fun a b ↦ Subtype.ext (mul_right_cancel (a.2.trans b.2.symm))⟩
  exact Finite.of_subsingleton

/-- **Spectral gap characterization for the regular representation.** The counting-measure regular
representation on `ℓ²(G, E)` has spectral gap if and only if `G` is finite, `E` is a subsingleton,
or `G` does not have Følner sets. -/
theorem hasSpectralGap_count_leftRegular_iff :
    ((count : Measure G).leftRegular 𝕜 E 2).HasSpectralGap ↔
      Finite G ∨ Subsingleton E ∨ ¬ TauCeti.HasFoelnerSets G := by
  constructor
  · intro hgap
    by_contra! hnot
    obtain ⟨hinf, hnontriv, hG⟩ := hnot
    have hinv : ((count : Measure G).leftRegular 𝕜 E 2).invariants = ⊥ :=
      invariants_count_leftRegular (by norm_num)
    have horth : ((count : Measure G).leftRegular 𝕜 E 2).invariantsᗮ = ⊤ := by
      rw [hinv, Submodule.bot_orthogonal_eq_top]
    have hunit := isUnitary_leftRegular (𝕜 := 𝕜) (E := E) (count : Measure G)
    have haiv : ((count : Measure G).leftRegular 𝕜 E 2).HasAlmostInvariantVectors :=
      hasAlmostInvariantVectors_count_leftRegular_iff.mpr ⟨hnontriv, hG⟩
    let e := LinearIsometryEquiv.ofTop _ _ horth
    have haiv_orth : hunit.invariantsOrthogonal.HasAlmostInvariantVectors :=
      (ContRepresentation.hasAlmostInvariantVectors_iff_of_linearIsometryEquiv e
        fun g v ↦ hunit.coe_invariantsOrthogonal_apply g v).mpr haiv
    exact (ContRepresentation.hasSpectralGap_iff_not_hasAlmostInvariantVectors _ hunit).mp
      hgap haiv_orth
  · rintro (hfin | hsub | hnotG)
    · exact ContRepresentation.hasSpectralGap_of_finite _
    · have : Subsingleton (Lp E 2 (count : Measure G)) :=
        ⟨fun f g ↦ Lp.ext (ae_of_all _ fun x ↦ Subsingleton.elim (f x) (g x))⟩
      exact ContRepresentation.hasSpectralGap_of_subsingleton _
    · exact hasSpectralGap_count_leftRegular_of_not_hasFoelnerSets hnotG

/-- Scalar specialization of `hasSpectralGap_count_leftRegular_iff`: `ℓ²(G, 𝕜)` has spectral gap if
and only if `G` is finite or `G` does not have Følner sets. -/
theorem hasSpectralGap_count_leftRegular_scalar_iff :
    ((count : Measure G).leftRegular 𝕜 𝕜 2).HasSpectralGap ↔
      Finite G ∨ ¬ TauCeti.HasFoelnerSets G := by
  rw [hasSpectralGap_count_leftRegular_iff]
  exact or_congr_right (or_iff_right (not_subsingleton 𝕜))

/-- Discrete-group amenability form of `hasSpectralGap_count_leftRegular_scalar_iff`. -/
theorem hasSpectralGap_count_leftRegular_scalar_iff_amenable [TopologicalSpace G]
    [DiscreteTopology G] [IsTopologicalGroup G] :
    ((count : Measure G).leftRegular 𝕜 𝕜 2).HasSpectralGap ↔
      Finite G ∨ ¬ TauCeti.Amenable G := by
  rw [hasSpectralGap_count_leftRegular_scalar_iff, TauCeti.amenable_iff_hasFoelnerSets]

/-- **Generating-set Poincaré inequality on `ℓ²(G, E)`.** When `G` has no Følner sets and is
generated by a finite set `S`, `ℓ²(G, E)` has no nonzero invariant vectors and satisfies a uniform
bound `‖v‖² ≤ C ∑_{s ∈ S} ‖λ s v - v‖²` for every `v ∈ ℓ²(G, E)`. -/
theorem exists_norm_sq_le_sum_count_leftRegular_of_closure_eq_top
    (hG : ¬ TauCeti.HasFoelnerSets G) {S : Finset G} (hS : Subgroup.closure (S : Set G) = ⊤) :
    ∃ C : ℝ, 0 < C ∧ ∀ v : Lp E 2 (count : Measure G),
      ‖v‖ ^ 2 ≤ C * ∑ s ∈ S, ‖(count : Measure G).leftRegular 𝕜 E 2 s v - v‖ ^ 2 := by
  have : Infinite G := ⟨fun _ ↦ hG .of_finite⟩
  have hunit := isUnitary_leftRegular (𝕜 := 𝕜) (E := E) (count : Measure G)
  have hgap := hasSpectralGap_count_leftRegular_of_not_hasFoelnerSets (𝕜 := 𝕜) (E := E) hG
  obtain ⟨C, hC, h⟩ := hgap.exists_of_closure_eq_top hunit hS
  have horth : ((count : Measure G).leftRegular 𝕜 E 2).invariantsᗮ = ⊤ := by
    rw [invariants_count_leftRegular (by norm_num), Submodule.bot_orthogonal_eq_top]
  exact ⟨C, hC, fun v ↦ h v (horth.ge Submodule.mem_top)⟩

end SpectralGap

section Examples

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]

/-- **Spectral gap of free groups.** For any type `α` with at least two elements, the left regular
representation of `FreeGroup α` on `ℓ²(FreeGroup α, E)` has spectral gap. -/
theorem hasSpectralGap_count_leftRegular_freeGroup {α : Type*} [Nontrivial α]
    [MeasurableSpace (FreeGroup α)] [MeasurableSingletonClass (FreeGroup α)]
    [MeasurableMul (FreeGroup α)] :
    ((count : Measure (FreeGroup α)).leftRegular 𝕜 E 2).HasSpectralGap :=
  hasSpectralGap_count_leftRegular_of_not_hasFoelnerSets TauCeti.not_hasFoelnerSets_freeGroup

/-- **Explicit generator inequality on `ℓ²(FreeGroup α, E)`.** When `α` is finite with at least two
elements, there exists `C > 0` such that `‖v‖² ≤ C ∑_{a : α} ‖λ (.of a) v - v‖²` for every
`v ∈ ℓ²(FreeGroup α, E)`. -/
theorem exists_norm_sq_le_sum_count_leftRegular_freeGroup {α : Type*} [Fintype α] [Nontrivial α]
    [MeasurableSpace (FreeGroup α)] [MeasurableSingletonClass (FreeGroup α)]
    [MeasurableMul (FreeGroup α)] :
    ∃ C : ℝ, 0 < C ∧ ∀ v : Lp E 2 (count : Measure (FreeGroup α)),
      ‖v‖ ^ 2 ≤ C * ∑ a : α,
        ‖(count : Measure (FreeGroup α)).leftRegular 𝕜 E 2 (.of a) v - v‖ ^ 2 := by
  let S : Finset (FreeGroup α) := Finset.univ.map ⟨FreeGroup.of, FreeGroup.of_injective⟩
  have hS : Subgroup.closure (S : Set (FreeGroup α)) = ⊤ := by simp [S]
  obtain ⟨C, hC, h⟩ :=
    exists_norm_sq_le_sum_count_leftRegular_of_closure_eq_top (𝕜 := 𝕜) (E := E)
      TauCeti.not_hasFoelnerSets_freeGroup hS
  exact ⟨C, hC, fun v ↦ by simpa [S] using h v⟩

/-- **Two-generator spectral-gap inequality on a rank-2 free group.** For any two-element alphabet
`e : Fin 2 ≃ α`, there exists `C > 0` such that
`‖v‖² ≤ C (‖λ (.of (e 0)) v - v‖² + ‖λ (.of (e 1)) v - v‖²)` for every
`v ∈ ℓ²(FreeGroup α, E)`. -/
theorem exists_norm_sq_le_add_count_leftRegular_freeGroup_of_equiv_fin_two {α : Type*}
    [MeasurableSpace (FreeGroup α)] [MeasurableSingletonClass (FreeGroup α)]
    [MeasurableMul (FreeGroup α)] (e : Fin 2 ≃ α) :
    ∃ C : ℝ, 0 < C ∧ ∀ v : Lp E 2 (count : Measure (FreeGroup α)),
      ‖v‖ ^ 2 ≤ C *
        (‖(count : Measure (FreeGroup α)).leftRegular 𝕜 E 2 (.of (e 0)) v - v‖ ^ 2 +
          ‖(count : Measure (FreeGroup α)).leftRegular 𝕜 E 2 (.of (e 1)) v - v‖ ^ 2) := by
  let : Fintype α := Fintype.ofEquiv (Fin 2) e
  have : Nontrivial α := ⟨⟨e 0, e 1, e.injective.ne (by decide)⟩⟩
  obtain ⟨C, hC, h⟩ :=
    exists_norm_sq_le_sum_count_leftRegular_freeGroup (α := α) (𝕜 := 𝕜) (E := E)
  refine ⟨C, hC, fun v ↦ ?_⟩
  have hv := h v
  rwa [← e.sum_comp, Fin.sum_univ_two] at hv

/-- **Failure of spectral gap for infinite commutative groups.** For any infinite commutative group
`A` and nontrivial Hilbert space `E`, the regular representation on `ℓ²(A, E)` does not have
spectral gap. -/
theorem not_hasSpectralGap_count_leftRegular_of_commGroup {A : Type*} [CommGroup A] [Infinite A]
    [MeasurableSpace A] [MeasurableSingletonClass A] [MeasurableMul A] [Nontrivial E] :
    ¬ ((count : Measure A).leftRegular 𝕜 E 2).HasSpectralGap := by
  have hF : TauCeti.HasFoelnerSets A := by
    let : TopologicalSpace A := ⊥
    have : DiscreteTopology A := ⟨rfl⟩
    have : IsTopologicalGroup A := {}
    exact TauCeti.Amenable.hasFoelnerSets
  rw [hasSpectralGap_count_leftRegular_iff]
  rintro (hfin | hsub | hnotF)
  · exact not_finite A
  · exact not_subsingleton E hsub
  · exact hnotF hF

/-- **Failure of spectral gap for `ℤ`.** For any nontrivial Hilbert space `E`, the left regular
representation of `Multiplicative ℤ` on `ℓ²(Multiplicative ℤ, E)` does not have spectral gap. -/
theorem not_hasSpectralGap_count_leftRegular_multiplicative_int [Nontrivial E] :
    ¬ ((count : Measure (Multiplicative ℤ)).leftRegular 𝕜 E 2).HasSpectralGap :=
  not_hasSpectralGap_count_leftRegular_of_commGroup

end Examples

end MeasureTheory.Measure
