/-!
# Normal crystals of integral piecewise-linear paths

Fix a root datum `P : RootDatum ι X Y` with a base `b : P.Base`, an injective additive realization
`f : X →+ V` of the weight lattice in a vector space over a linearly ordered field `𝕜`, and height
forms `F : b.support → Module.Dual 𝕜 V` agreeing with the simple coroots on `f(X)`:
`F i (f x) = ⟨x, α_i^∨⟩`.

On arbitrary piecewise-linear paths `π : PLPath 𝕜 V`, Littelmann's root operators
`e_i = raise (F i) (f α_i)` and `f_i = lower (F i) (f α_i)` satisfy ambient rational string-length
bounds (`TauCeti.PLPath.isSome_raiseIter_iff`, `TauCeti.PLPath.isSome_lowerIter_iff`), but neither
all paths in `V` nor all paths with lattice endpoint in `f(X)` have integral minimum heights: a
short excursion of endpoint `0` can attain minimum coroot height `-1/2`
(`TauCeti.PLPath.exists_endpoint_eq_zero_and_not_isIntegralPath`).

When a set `S` of paths with endpoints in `f(X)` is closed under all simple-root operators and
every path in `S` has integral minimum height against every simple coroot
(`TauCeti.PLPath.IsCrystalSet`), the ambient rational bounds specialize to the normal-crystal
string-length identities `ε_i(π) = -min H_i(π)` and `φ_i(π) = H_i(π)(1) - min H_i(π)`, assembling
`S` into a normal crystal `TauCeti.PLPath.normalCrystalOn`.

Littelmann's *integral paths* (`TauCeti.PLPath.IsIntegralPath`) are the paths with endpoint in
`f(X)` whose entire `{e_i, f_i}`-orbit has integral minimum simple-coroot heights. They form the
greatest crystal-admissible set of paths, carrying the ambient path crystal
`TauCeti.PLPath.normalCrystal` into which every `normalCrystalOn` embeds via the strict morphism
`TauCeti.PLPath.embedHom`, and whose connected components are the path crystals
`TauCeti.PLPath.normalCrystalComponent`. For a finite free coweight lattice, scalar extension
`P.baseChange 𝕜` supplies a canonical realization in `𝕜 ⊗[ℤ] X` with no auxiliary parameters
(`TauCeti.PLPath.baseChangeNormalCrystal`).

Categorical path operations (central straight paths, reversal, concatenation, compatible linear
maps) and simple-root string examples are developed in
`TauCeti.RepresentationTheory.LSPath.Crystal.Operations`.

## Main definitions

* `TauCeti.PLPath.RootStep`: single-step adjacency of two paths under a simple-root raising or
  lowering operator.
* `TauCeti.PLPath.IsCrystalSet`: a set of paths with lattice endpoints, integral minimum
  simple-coroot heights, and stability under the simple-root operators.
* `TauCeti.PLPath.normalCrystalOn`: the normal crystal structure on an `IsCrystalSet`.
* `TauCeti.PLPath.IsIntegralPath`: Littelmann's integrality condition on a path (lattice endpoint
  and integral minimum simple-coroot heights along its entire root-operator orbit).
* `TauCeti.PLPath.normalCrystal`: the normal crystal of all integral paths.
* `TauCeti.PLPath.normalCrystalComponent`: the connected crystal component generated by an integral
  path.
* `TauCeti.PLPath.baseChangeNormalCrystal`: the canonical normal path crystal in `𝕜 ⊗[ℤ] X`.

## References

* P. Littelmann, *Paths and root operators in representation theory*, Ann. of Math. 142 (1995),
  §§1–2.
* M. Kashiwara, *On crystal bases*, CMS Conf. Proc. 16 (1995), §7.
-/

public section

namespace TauCeti.PLPath

open Module Relation Set
open scoped TensorProduct

section Realization

variable {ι X Y 𝕜 V : Type*} [AddCommGroup X] [AddCommGroup Y]
  {P : RootDatum ι X Y} (b : P.Base)
  [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] [AddCommGroup V] [Module 𝕜 V]

/-! ### Root-operator steps and crystal-closed sets of paths -/

/-- Two paths are related by a **root step** if some simple-root raising or lowering operator sends
the first to the second. -/
def RootStep (f : X →+ V) (F : b.support → Dual 𝕜 V) (π π' : PLPath 𝕜 V) : Prop :=
  ∃ i : b.support,
    raise (F i) (f (P.root i)) π = some π' ∨ lower (F i) (f (P.root i)) π = some π'

variable {b} {f : X →+ V} {F : b.support → Dual 𝕜 V}

theorem rootStep_iff {π π' : PLPath 𝕜 V} :
    RootStep b f F π π' ↔
      ∃ i : b.support,
        raise (F i) (f (P.root i)) π = some π' ∨ lower (F i) (f (P.root i)) π = some π' :=
  Iff.rfl

theorem RootStep.of_raise_eq_some {i : b.support} {π π' : PLPath 𝕜 V}
    (h : raise (F i) (f (P.root i)) π = some π') : RootStep b f F π π' :=
  ⟨i, Or.inl h⟩

theorem RootStep.of_lower_eq_some {i : b.support} {π π' : PLPath 𝕜 V}
    (h : lower (F i) (f (P.root i)) π = some π') : RootStep b f F π π' :=
  ⟨i, Or.inr h⟩

omit [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] in
/-- Every simple-coroot height form evaluates to `2` on its realized simple root. -/
theorem apply_root_eq_two (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (i : b.support) : F i (f (P.root i)) = 2 := by
  rw [hF, P.root_coroot'_eq_pairing, P.pairing_same, Int.cast_ofNat]

/-- Because raising and lowering are partial inverses, `RootStep` is symmetric whenever the height
forms agree with the simple coroots on `f(X)`. -/
theorem RootStep.symm (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {π π' : PLPath 𝕜 V} (h : RootStep b f F π π') : RootStep b f F π' π := by
  obtain ⟨i, h | h⟩ := h
  · exact ⟨i, Or.inr ((raise_eq_some_iff (apply_root_eq_two hF i)).mp h)⟩
  · exact ⟨i, Or.inl ((lower_eq_some_iff (apply_root_eq_two hF i)).mp h)⟩

/-- Root steps preserve paths whose endpoints lie in the realized weight lattice `f(X)`. -/
theorem RootStep.endpoint_mem_range {π π' : PLPath 𝕜 V} (h : RootStep b f F π π')
    (hπ : π.endpoint ∈ range f) : π'.endpoint ∈ range f := by
  obtain ⟨μ, hμ⟩ := hπ
  obtain ⟨i, h | h⟩ := h
  · exact ⟨μ + P.root i, by rw [map_add, hμ, endpoint_of_raise_eq_some h]⟩
  · exact ⟨μ - P.root i, by rw [map_sub, hμ, endpoint_of_lower_eq_some h]⟩

/-- Any finite walk of root steps preserves membership of the endpoint in `f(X)`. -/
theorem endpoint_mem_range_of_reflTransGen_rootStep {π π' : PLPath 𝕜 V}
    (h : ReflTransGen (RootStep b f F) π π') (hπ : π.endpoint ∈ range f) :
    π'.endpoint ∈ range f := by
  induction h with
  | refl => exact hπ
  | tail _ hstep ih => exact hstep.endpoint_mem_range ih

variable (b f F) in
/-- A set `S` of piecewise-linear paths is **crystal-admissible** (`IsCrystalSet`) if every path in
`S` ends in the realized weight lattice `f(X)`, has integral minimum height against every simple
coroot, and stays in `S` under all simple-root raising and lowering operators. -/
structure IsCrystalSet (S : Set (PLPath 𝕜 V)) : Prop where
  /-- Every path in `S` has endpoint in `f(X)`. -/
  endpoint_mem_range {π : PLPath 𝕜 V} : π ∈ S → π.endpoint ∈ range f
  /-- Every path in `S` has integral minimum height against every simple coroot. -/
  exists_minHeight_eq_intCast {π : PLPath 𝕜 V} :
    π ∈ S → ∀ i : b.support, ∃ z : ℤ, π.minHeight (F i) = z
  /-- `S` is closed under the simple-root raising operators. -/
  mem_of_raise_eq_some {i : b.support} {π π' : PLPath 𝕜 V} :
    raise (F i) (f (P.root i)) π = some π' → π ∈ S → π' ∈ S
  /-- `S` is closed under the simple-root lowering operators. -/
  mem_of_lower_eq_some {i : b.support} {π π' : PLPath 𝕜 V} :
    lower (F i) (f (P.root i)) π = some π' → π ∈ S → π' ∈ S

section IsCrystalSetClosure

variable {S S₁ S₂ : Set (PLPath 𝕜 V)}

@[simp]
theorem IsCrystalSet.empty : IsCrystalSet b f F (∅ : Set (PLPath 𝕜 V)) where
  endpoint_mem_range := False.elim
  exists_minHeight_eq_intCast := False.elim
  mem_of_raise_eq_some _ := False.elim
  mem_of_lower_eq_some _ := False.elim

theorem IsCrystalSet.union (h₁ : IsCrystalSet b f F S₁) (h₂ : IsCrystalSet b f F S₂) :
    IsCrystalSet b f F (S₁ ∪ S₂) where
  endpoint_mem_range h := h.elim h₁.endpoint_mem_range h₂.endpoint_mem_range
  exists_minHeight_eq_intCast h :=
    h.elim h₁.exists_minHeight_eq_intCast h₂.exists_minHeight_eq_intCast
  mem_of_raise_eq_some hr h := Or.imp (h₁.mem_of_raise_eq_some hr) (h₂.mem_of_raise_eq_some hr) h
  mem_of_lower_eq_some hl h := Or.imp (h₁.mem_of_lower_eq_some hl) (h₂.mem_of_lower_eq_some hl) h

theorem IsCrystalSet.inter (h₁ : IsCrystalSet b f F S₁) (h₂ : IsCrystalSet b f F S₂) :
    IsCrystalSet b f F (S₁ ∩ S₂) where
  endpoint_mem_range h := h₁.endpoint_mem_range h.1
  exists_minHeight_eq_intCast h := h₁.exists_minHeight_eq_intCast h.1
  mem_of_raise_eq_some hr h := ⟨h₁.mem_of_raise_eq_some hr h.1, h₂.mem_of_raise_eq_some hr h.2⟩
  mem_of_lower_eq_some hl h := ⟨h₁.mem_of_lower_eq_some hl h.1, h₂.mem_of_lower_eq_some hl h.2⟩

theorem IsCrystalSet.sUnion {𝒜 : Set (Set (PLPath 𝕜 V))}
    (h𝒜 : ∀ S ∈ 𝒜, IsCrystalSet b f F S) : IsCrystalSet b f F (⋃₀ 𝒜) where
  endpoint_mem_range := fun ⟨S, hS, hπ⟩ ↦ (h𝒜 S hS).endpoint_mem_range hπ
  exists_minHeight_eq_intCast := fun ⟨S, hS, hπ⟩ ↦ (h𝒜 S hS).exists_minHeight_eq_intCast hπ
  mem_of_raise_eq_some hr := fun ⟨S, hS, hπ⟩ ↦ ⟨S, hS, (h𝒜 S hS).mem_of_raise_eq_some hr hπ⟩
  mem_of_lower_eq_some hl := fun ⟨S, hS, hπ⟩ ↦ ⟨S, hS, (h𝒜 S hS).mem_of_lower_eq_some hl hπ⟩

theorem IsCrystalSet.mem_of_rootStep (hS : IsCrystalSet b f F S) {π π' : PLPath 𝕜 V}
    (h : RootStep b f F π π') (hπ : π ∈ S) : π' ∈ S := by
  obtain ⟨i, h | h⟩ := h
  · exact hS.mem_of_raise_eq_some h hπ
  · exact hS.mem_of_lower_eq_some h hπ

theorem IsCrystalSet.mem_of_reflTransGen_rootStep (hS : IsCrystalSet b f F S) {π π' : PLPath 𝕜 V}
    (h : ReflTransGen (RootStep b f F) π π') (hπ : π ∈ S) : π' ∈ S := by
  induction h with
  | refl => exact hπ
  | tail _ hstep ih => exact hS.mem_of_rootStep hstep ih

theorem IsCrystalSet.mem_of_raiseIter_eq_some (hS : IsCrystalSet b f F S) {i : b.support} {n : ℕ}
    {π π' : PLPath 𝕜 V} (h : raiseIter (F i) (f (P.root i)) n π = some π') (hπ : π ∈ S) :
    π' ∈ S := by
  induction n generalizing π with
  | zero =>
    simp only [raiseIter_zero, Option.some.injEq] at h
    exact h ▸ hπ
  | succ n ih =>
    rw [raiseIter_succ, Option.bind_eq_some_iff] at h
    obtain ⟨ρ, hρ, h⟩ := h
    exact ih h (hS.mem_of_raise_eq_some hρ hπ)

theorem IsCrystalSet.mem_of_lowerIter_eq_some (hS : IsCrystalSet b f F S) {i : b.support} {n : ℕ}
    {π π' : PLPath 𝕜 V} (h : lowerIter (F i) (f (P.root i)) n π = some π') (hπ : π ∈ S) :
    π' ∈ S := by
  induction n generalizing π with
  | zero =>
    simp only [lowerIter_zero, Option.some.injEq] at h
    exact h ▸ hπ
  | succ n ih =>
    rw [lowerIter_succ, Option.bind_eq_some_iff] at h
    obtain ⟨ρ, hρ, h⟩ := h
    exact ih h (hS.mem_of_lower_eq_some hρ hπ)

end IsCrystalSetClosure

/-! ### The normal crystal on a crystal-closed set of paths -/

section NormalCrystalOn

variable {S T : Set (PLPath 𝕜 V)}

private noncomputable def wtAux (hS : IsCrystalSet b f F S) (π : S) : X :=
  (hS.endpoint_mem_range π.2).choose

private theorem apply_wtAux (hS : IsCrystalSet b f F S) (π : S) :
    f (wtAux hS π) = π.1.endpoint :=
  (hS.endpoint_mem_range π.2).choose_spec

private noncomputable def εAux (hS : IsCrystalSet b f F S) (i : b.support) (π : S) : ℕ :=
  (-(hS.exists_minHeight_eq_intCast π.2 i).choose).toNat

private theorem cast_εAux (hS : IsCrystalSet b f F S) (i : b.support) (π : S) :
    (εAux hS i π : 𝕜) = -π.1.minHeight (F i) := by
  set z := (hS.exists_minHeight_eq_intCast π.2 i).choose
  have hz : π.1.minHeight (F i) = z := (hS.exists_minHeight_eq_intCast π.2 i).choose_spec
  have hnonpos : z ≤ 0 := by
    have : (z : 𝕜) ≤ 0 := hz ▸ minHeight_nonpos (f := F i) π.1
    exact_mod_cast this
  have hnat : ((εAux hS i π : ℕ) : ℤ) = -z := Int.toNat_of_nonneg (neg_nonneg.mpr hnonpos)
  rw [hz, ← Int.cast_neg, ← hnat, Int.cast_natCast]

private noncomputable def φAux (hS : IsCrystalSet b f F S) (i : b.support) (π : S) : ℕ :=
  (P.coroot' i (wtAux hS π) - (hS.exists_minHeight_eq_intCast π.2 i).choose).toNat

private theorem apply_endpoint_eq_coroot'_wtAux
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (hS : IsCrystalSet b f F S) (i : b.support) (π : S) :
    F i π.1.endpoint = (P.coroot' i (wtAux hS π) : 𝕜) := by
  rw [← apply_wtAux hS π, hF]

private theorem cast_φAux (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (hS : IsCrystalSet b f F S) (i : b.support) (π : S) :
    (φAux hS i π : 𝕜) = F i π.1.endpoint - π.1.minHeight (F i) := by
  set z := (hS.exists_minHeight_eq_intCast π.2 i).choose
  have hz : π.1.minHeight (F i) = z := (hS.exists_minHeight_eq_intCast π.2 i).choose_spec
  have hend := apply_endpoint_eq_coroot'_wtAux hF hS i π
  have hle : z ≤ P.coroot' i (wtAux hS π) := by
    have : (z : 𝕜) ≤ (P.coroot' i (wtAux hS π) : 𝕜) :=
      hz ▸ hend ▸ minHeight_le_apply_endpoint (f := F i) π.1
    exact_mod_cast this
  have hnat : ((φAux hS i π : ℕ) : ℤ) = P.coroot' i (wtAux hS π) - z :=
    Int.toNat_of_nonneg (sub_nonneg.mpr hle)
  rw [hend, hz, ← Int.cast_sub, ← hnat, Int.cast_natCast]

/-- Assemble a crystal-admissible set `S` of piecewise-linear paths into a **normal crystal** over
`(P, b)`, with weight determined by `f (wt π) = π.endpoint`, raising and lowering operators
`raise (F i) (f α_i)` and `lower (F i) (f α_i)`, and string lengths `ε_i(π) = -min H_i(π)` and
`φ_i(π) = H_i(π)(1) - min H_i(π)`. -/
noncomputable def normalCrystalOn (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (hS : IsCrystalSet b f F S) : NormalCrystal P b S where
  wt := wtAux hS
  e i := S.optionRestrict S (raise (F i) (f (P.root i))) fun _ _ ↦ hS.mem_of_raise_eq_some
  f i := S.optionRestrict S (lower (F i) (f (P.root i))) fun _ _ ↦ hS.mem_of_lower_eq_some
  ε := εAux hS
  φ := φAux hS
  f_eq_some_iff {i x y} := by
    simp only [Set.optionRestrict_eq_some_iff, lower_eq_some_iff (apply_root_eq_two hF i)]
  wt_of_e_eq_some {i x y} h := by
    have hr := Set.optionRestrict_eq_some_iff.mp h
    apply hf
    rw [map_add, apply_wtAux, apply_wtAux, endpoint_of_raise_eq_some hr]
  ε_eq_zero_iff {i x} := by
    rw [Set.optionRestrict_eq_none_iff, raise_eq_none_iff]
    have hε := cast_εAux hS i x
    constructor
    · intro h0
      rw [h0, Nat.cast_zero] at hε
      linarith
    · intro hgt
      by_contra hne
      have hge : (1 : 𝕜) ≤ (εAux hS i x : 𝕜) := by
        exact_mod_cast Nat.one_le_iff_ne_zero.mpr hne
      linarith
  ε_of_e_eq_some {i x y} h := by
    have hr := Set.optionRestrict_eq_some_iff.mp h
    apply Nat.cast_injective (R := 𝕜)
    rw [Nat.cast_add, Nat.cast_one, cast_εAux, cast_εAux,
      minHeight_of_raise_eq_some (apply_root_eq_two hF i) hr]
    ring
  φ_eq_zero_iff {i x} := by
    rw [Set.optionRestrict_eq_none_iff, lower_eq_none_iff, ← cast_φAux hF hS i x, ← Nat.cast_one,
      Nat.cast_lt, Nat.lt_one_iff]
  φ_sub_ε i x := by
    apply Int.cast_injective (α := 𝕜)
    rw [Int.cast_sub, Int.cast_natCast, Int.cast_natCast, cast_φAux hF hS, cast_εAux,
      apply_endpoint_eq_coroot'_wtAux hF hS i x]
    dsimp only [RootPairing.coroot', LinearMap.flip_apply]
    ring

variable {hf : Function.Injective f}
  {hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)}
  {hS : IsCrystalSet b f F S}

/-- The realized weight of a path in `normalCrystalOn` is its endpoint. -/
@[simp]
theorem apply_normalCrystalOn_wt (π : S) :
    f ((normalCrystalOn hf hF hS).wt π) = π.1.endpoint :=
  apply_wtAux hS π

theorem normalCrystalOn_wt_eq_iff {π : S} {μ : X} :
    (normalCrystalOn hf hF hS).wt π = μ ↔ π.1.endpoint = f μ := by
  rw [← hf.eq_iff, apply_normalCrystalOn_wt, eq_comm]

/-- **Normal-crystal raising string length**: `ε_i(π) = -min H_i(π)`. -/
@[simp]
theorem cast_normalCrystalOn_ε (i : b.support) (π : S) :
    ((normalCrystalOn hf hF hS).ε i π : 𝕜) = -π.1.minHeight (F i) :=
  cast_εAux hS i π

/-- **Normal-crystal lowering string length**: `φ_i(π) = H_i(π)(1) - min H_i(π)`. -/
@[simp]
theorem cast_normalCrystalOn_φ (i : b.support) (π : S) :
    ((normalCrystalOn hf hF hS).φ i π : 𝕜) = F i π.1.endpoint - π.1.minHeight (F i) :=
  cast_φAux hF hS i π

theorem normalCrystalOn_ε_eq_iff {i : b.support} {π : S} {n : ℕ} :
    (normalCrystalOn hf hF hS).ε i π = n ↔ -π.1.minHeight (F i) = n := by
  rw [← Nat.cast_inj (R := 𝕜), cast_normalCrystalOn_ε]

theorem normalCrystalOn_φ_eq_iff {i : b.support} {π : S} {n : ℕ} :
    (normalCrystalOn hf hF hS).φ i π = n ↔ F i π.1.endpoint - π.1.minHeight (F i) = n := by
  rw [← Nat.cast_inj (R := 𝕜), cast_normalCrystalOn_φ]

@[simp]
theorem normalCrystalOn_e_eq_some_iff {i : b.support} {π π' : S} :
    (normalCrystalOn hf hF hS).e i π = some π' ↔
      raise (F i) (f (P.root i)) π.1 = some π'.1 :=
  Set.optionRestrict_eq_some_iff

@[simp]
theorem normalCrystalOn_f_eq_some_iff {i : b.support} {π π' : S} :
    (normalCrystalOn hf hF hS).f i π = some π' ↔
      lower (F i) (f (P.root i)) π.1 = some π'.1 :=
  Set.optionRestrict_eq_some_iff

@[simp]
theorem normalCrystalOn_e_eq_none_iff {i : b.support} {π : S} :
    (normalCrystalOn hf hF hS).e i π = none ↔ raise (F i) (f (P.root i)) π.1 = none :=
  Set.optionRestrict_eq_none_iff

@[simp]
theorem normalCrystalOn_f_eq_none_iff {i : b.support} {π : S} :
    (normalCrystalOn hf hF hS).f i π = none ↔ lower (F i) (f (P.root i)) π.1 = none :=
  Set.optionRestrict_eq_none_iff

@[simp]
theorem unattach_normalCrystalOn_e (i : b.support) (π : S) :
    ((normalCrystalOn hf hF hS).e i π).unattach = raise (F i) (f (P.root i)) π.1 :=
  Set.unattach_optionRestrict π

@[simp]
theorem unattach_normalCrystalOn_f (i : b.support) (π : S) :
    ((normalCrystalOn hf hF hS).f i π).unattach = lower (F i) (f (P.root i)) π.1 :=
  Set.unattach_optionRestrict π

theorem normalCrystalOn_e_eq_iff {i : b.support} {π : S} {o : Option S} :
    (normalCrystalOn hf hF hS).e i π = o ↔ raise (F i) (f (P.root i)) π.1 = o.unattach := by
  cases o <;> simp

theorem normalCrystalOn_f_eq_iff {i : b.support} {π : S} {o : Option S} :
    (normalCrystalOn hf hF hS).f i π = o ↔ lower (F i) (f (P.root i)) π.1 = o.unattach := by
  cases o <;> simp

theorem normalCrystalOn_e_eq_map_iff {B : Type*} {i : b.support} {π : S} {o : Option B}
    {g : B → S} :
    (normalCrystalOn hf hF hS).e i π = o.map g ↔
      raise (F i) (f (P.root i)) π.1 = o.map (fun x ↦ (g x).1) := by
  rw [normalCrystalOn_e_eq_iff, Option.unattach, Option.map_map, Function.comp_def]

theorem normalCrystalOn_f_eq_map_iff {B : Type*} {i : b.support} {π : S} {o : Option B}
    {g : B → S} :
    (normalCrystalOn hf hF hS).f i π = o.map g ↔
      lower (F i) (f (P.root i)) π.1 = o.map (fun x ↦ (g x).1) := by
  rw [normalCrystalOn_f_eq_iff, Option.unattach, Option.map_map, Function.comp_def]

private theorem unattach_bind {α β : Type*} {p : α → Prop} {q : β → Prop}
    (o : Option {x // p x}) (g : {x // p x} → Option {y // q y}) (g' : α → Option β)
    (hg : ∀ x : {x // p x}, (g x).unattach = g' x.1) :
    (o.bind g).unattach = o.unattach.bind g' := by
  cases o <;> simp [hg]

@[simp]
theorem unattach_normalCrystalOn_eIter (i : b.support) (n : ℕ) (π : S) :
    ((normalCrystalOn hf hF hS).eIter i n π).unattach =
      raiseIter (F i) (f (P.root i)) n π.1 := by
  induction n generalizing π with
  | zero => simp
  | succ n ih =>
    rw [NormalCrystal.eIter_succ, raiseIter_succ, unattach_bind _ _ _ ih,
      unattach_normalCrystalOn_e]

@[simp]
theorem unattach_normalCrystalOn_fIter (i : b.support) (n : ℕ) (π : S) :
    ((normalCrystalOn hf hF hS).fIter i n π).unattach =
      lowerIter (F i) (f (P.root i)) n π.1 := by
  induction n generalizing π with
  | zero => simp
  | succ n ih =>
    rw [NormalCrystal.fIter_succ, lowerIter_succ, unattach_bind _ _ _ ih,
      unattach_normalCrystalOn_f]

/-- Adjacency in the crystal graph of `normalCrystalOn` is single-step root-operator adjacency. -/
@[simp]
theorem normalCrystalOn_graph_adj_iff {π π' : S} :
    (normalCrystalOn hf hF hS).graph.Adj π π' ↔ RootStep b f F π.1 π'.1 := by
  rw [NormalCrystal.graph_adj_iff, rootStep_iff]
  refine exists_congr fun i ↦ or_congr normalCrystalOn_e_eq_some_iff ?_
  rw [normalCrystalOn_e_eq_some_iff, raise_eq_some_iff (apply_root_eq_two hF i)]

/-- Two paths in a crystal-admissible set lie in the same connected component of `normalCrystalOn`
if and only if one is reachable from the other by a finite sequence of root steps. -/
theorem normalCrystalOn_graph_reachable_iff (x y : S) :
    (normalCrystalOn hf hF hS).graph.Reachable x y ↔ ReflTransGen (RootStep b f F) x.1 y.1 := by
  rw [SimpleGraph.reachable_iff_reflTransGen]
  constructor
  · intro h
    induction h with
    | refl => exact .refl
    | tail _ hadj ih => exact ih.tail (normalCrystalOn_graph_adj_iff.mp hadj)
  · generalize hu : x.1 = u
    generalize hv : y.1 = v
    intro h
    induction h generalizing x y with
    | refl =>
      obtain rfl : x = y := Subtype.ext (hu.trans hv.symm)
      exact .refl
    | tail hwalk hstep ih =>
      subst hu hv
      let z : S := ⟨_, hS.mem_of_reflTransGen_rootStep hwalk x.2⟩
      exact (ih x z rfl rfl).tail (normalCrystalOn_graph_adj_iff.mpr hstep)

/-- Membership in the connected crystal component of `x` in `normalCrystalOn` is reachability from
`x` by root steps. -/
theorem mem_supp_connectedComponentMk_normalCrystalOn_iff (x y : S) :
    y ∈ ((normalCrystalOn hf hF hS).graph.connectedComponentMk x).supp ↔
      ReflTransGen (RootStep b f F) x.1 y.1 := by
  rw [SimpleGraph.ConnectedComponent.mem_supp_iff, SimpleGraph.ConnectedComponent.eq,
    SimpleGraph.reachable_comm, normalCrystalOn_graph_reachable_iff]

/-- A path in a crystal-admissible set is highest-weight (annihilated by all simple-root raising
operators) if and only if every simple-coroot minimum height vanishes. -/
theorem forall_normalCrystalOn_e_eq_none_iff {π : S} :
    (∀ i, (normalCrystalOn hf hF hS).e i π = none) ↔ ∀ i, π.1.minHeight (F i) = 0 := by
  refine forall_congr' fun i ↦ ?_
  rw [← (normalCrystalOn hf hF hS).ε_eq_zero_iff, normalCrystalOn_ε_eq_iff, Nat.cast_zero,
    neg_eq_zero]

/-- An inclusion `S ⊆ T` of crystal-admissible path sets induces a strict morphism of normal
crystals. -/
noncomputable def inclusionHom (hS : IsCrystalSet b f F S) (hT : IsCrystalSet b f F T)
    (hST : S ⊆ T) :
    NormalCrystal.StrictHom (normalCrystalOn hf hF hS) (normalCrystalOn hf hF hT) where
  toFun := Set.inclusion hST
  wt_toFun π := hf (by simp)
  e_toFun i π := normalCrystalOn_e_eq_map_iff.mpr (unattach_normalCrystalOn_e i π).symm

@[simp]
theorem inclusionHom_apply (hS : IsCrystalSet b f F S) (hT : IsCrystalSet b f F T) (hST : S ⊆ T)
    (π : S) : (inclusionHom (hf := hf) (hF := hF) hS hT hST π).1 = π.1 :=
  (rfl)

@[simp]
theorem inclusionHom_refl (hS : IsCrystalSet b f F S) :
    inclusionHom (hf := hf) (hF := hF) hS hS Subset.rfl = NormalCrystal.StrictHom.id _ :=
  NormalCrystal.StrictHom.ext fun _ ↦ Subtype.ext (by simp)

theorem inclusionHom_comp {U : Set (PLPath 𝕜 V)} (hS : IsCrystalSet b f F S)
    (hT : IsCrystalSet b f F T) (hU : IsCrystalSet b f F U) (hST : S ⊆ T) (hTU : T ⊆ U) :
    (inclusionHom (hf := hf) (hF := hF) hT hU hTU).comp
      (inclusionHom (hf := hf) (hF := hF) hS hT hST) =
      inclusionHom (hf := hf) (hF := hF) hS hU (hST.trans hTU) :=
  NormalCrystal.StrictHom.ext fun _ ↦ Subtype.ext (by simp)

end NormalCrystalOn

/-! ### Littelmann's crystal of integral paths -/

variable (b f F) in
/-- A piecewise-linear path `π` is an **integral path** (`IsIntegralPath`) if its endpoint lies in
the realized weight lattice `f(X)` and every path reachable from `π` by simple-root raising and
lowering operators has integral minimum height against every simple coroot. -/
def IsIntegralPath (π : PLPath 𝕜 V) : Prop :=
  π.endpoint ∈ range f ∧
    ∀ ⦃π'⦄, ReflTransGen (RootStep b f F) π π' → ∀ i : b.support, ∃ z : ℤ, π'.minHeight (F i) = z

theorem isIntegralPath_iff {π : PLPath 𝕜 V} :
    IsIntegralPath b f F π ↔
      π.endpoint ∈ range f ∧
        ∀ ⦃π'⦄, ReflTransGen (RootStep b f F) π π' →
          ∀ i : b.support, ∃ z : ℤ, π'.minHeight (F i) = z :=
  Iff.rfl

theorem IsIntegralPath.endpoint_mem_range {π : PLPath 𝕜 V} (h : IsIntegralPath b f F π) :
    π.endpoint ∈ range f :=
  h.1

theorem IsIntegralPath.exists_minHeight_eq_intCast {π : PLPath 𝕜 V} (h : IsIntegralPath b f F π)
    (i : b.support) : ∃ z : ℤ, π.minHeight (F i) = z :=
  h.2 .refl i

theorem IsIntegralPath.of_rootStep {π π' : PLPath 𝕜 V} (h : IsIntegralPath b f F π)
    (hstep : RootStep b f F π π') : IsIntegralPath b f F π' :=
  ⟨hstep.endpoint_mem_range h.1, fun _ hwalk ↦ h.2 (.head hstep hwalk)⟩

theorem IsIntegralPath.of_reflTransGen_rootStep {π π' : PLPath 𝕜 V} (h : IsIntegralPath b f F π)
    (hwalk : ReflTransGen (RootStep b f F) π π') : IsIntegralPath b f F π' :=
  ⟨endpoint_mem_range_of_reflTransGen_rootStep hwalk h.1, fun _ hwalk' ↦ h.2 (hwalk.trans hwalk')⟩

theorem IsIntegralPath.of_raise_eq_some {i : b.support} {π π' : PLPath 𝕜 V}
    (h : IsIntegralPath b f F π) (hr : raise (F i) (f (P.root i)) π = some π') :
    IsIntegralPath b f F π' :=
  h.of_rootStep (.of_raise_eq_some hr)

theorem IsIntegralPath.of_lower_eq_some {i : b.support} {π π' : PLPath 𝕜 V}
    (h : IsIntegralPath b f F π) (hl : lower (F i) (f (P.root i)) π = some π') :
    IsIntegralPath b f F π' :=
  h.of_rootStep (.of_lower_eq_some hl)

/-- Root steps preserve and reflect integrality of paths. -/
theorem RootStep.isIntegralPath_iff
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {π π' : PLPath 𝕜 V} (h : RootStep b f F π π') :
    IsIntegralPath b f F π ↔ IsIntegralPath b f F π' :=
  ⟨fun hπ ↦ hπ.of_rootStep h, fun hπ' ↦ hπ'.of_rootStep (h.symm hF)⟩

/-- The set of all integral paths is crystal-admissible. -/
theorem isCrystalSet_setOf_isIntegralPath : IsCrystalSet b f F {π | IsIntegralPath b f F π} where
  endpoint_mem_range h := h.endpoint_mem_range
  exists_minHeight_eq_intCast h := h.exists_minHeight_eq_intCast
  mem_of_raise_eq_some hr h := h.of_raise_eq_some hr
  mem_of_lower_eq_some hl h := h.of_lower_eq_some hl

/-- **Maximality of integral paths**: every crystal-admissible set of paths consists of integral
paths. -/
theorem IsCrystalSet.subset_isIntegralPath {S : Set (PLPath 𝕜 V)} (hS : IsCrystalSet b f F S) :
    S ⊆ {π | IsIntegralPath b f F π} :=
  fun _ hπ ↦ ⟨hS.endpoint_mem_range hπ,
    fun _ hwalk ↦ hS.exists_minHeight_eq_intCast (hS.mem_of_reflTransGen_rootStep hwalk hπ)⟩

/-- A set of paths is crystal-admissible if and only if it is a root-operator-closed set of
integral paths. -/
theorem isCrystalSet_iff_subset_isIntegralPath_and_closed {S : Set (PLPath 𝕜 V)} :
    IsCrystalSet b f F S ↔
      S ⊆ {π | IsIntegralPath b f F π} ∧
        (∀ {i : b.support} {π π'}, raise (F i) (f (P.root i)) π = some π' → π ∈ S → π' ∈ S) ∧
        (∀ {i : b.support} {π π'}, lower (F i) (f (P.root i)) π = some π' → π ∈ S → π' ∈ S) :=
  ⟨fun hS ↦ ⟨hS.subset_isIntegralPath, hS.mem_of_raise_eq_some, hS.mem_of_lower_eq_some⟩,
    fun ⟨hsub, hraise, hlower⟩ ↦
      ⟨fun hπ ↦ (hsub hπ).endpoint_mem_range,
        fun hπ ↦ (hsub hπ).exists_minHeight_eq_intCast, hraise, hlower⟩⟩

section AmbientCrystal

/-- **Littelmann's normal crystal of integral paths** over `(P, b)` in the realization `(f, F)`. -/
noncomputable abbrev normalCrystal (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    NormalCrystal P b {π : PLPath 𝕜 V | IsIntegralPath b f F π} :=
  normalCrystalOn hf hF isCrystalSet_setOf_isIntegralPath

variable {hf : Function.Injective f}
  {hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)}

/-- Every crystal-admissible set `S` embeds strictly into `normalCrystal`. -/
noncomputable def embedHom {S : Set (PLPath 𝕜 V)} (hS : IsCrystalSet b f F S) :
    NormalCrystal.StrictHom (normalCrystalOn hf hF hS) (normalCrystal hf hF) :=
  inclusionHom hS isCrystalSet_setOf_isIntegralPath hS.subset_isIntegralPath

@[simp]
theorem embedHom_apply {S : Set (PLPath 𝕜 V)} (hS : IsCrystalSet b f F S) (π : S) :
    (embedHom (hf := hf) (hF := hF) hS π).1 = π.1 :=
  (rfl)

/-- The **connected path crystal component** `B(π)` generated by an integral path `π` under all
simple-root raising and lowering operators. -/
noncomputable abbrev normalCrystalComponent (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (x : {π : PLPath 𝕜 V | IsIntegralPath b f F π}) :
    NormalCrystal P b ((normalCrystal hf hF).graph.connectedComponentMk x) :=
  (normalCrystal hf hF).component ((normalCrystal hf hF).graph.connectedComponentMk x)

end AmbientCrystal

/-! ### Lattice-endpoint paths need not be integral -/

/-- **Not every path with lattice endpoint is integral**: as soon as `b.support` is nonempty, the
two-segment excursion `-(1/4) α_i` followed by `(1/4) α_i` has endpoint `0 ∈ f(X)` and minimum
coroot height `-1/2 ∉ ℤ`. -/
theorem exists_endpoint_eq_zero_and_not_isIntegralPath [Nonempty b.support]
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    ∃ π : PLPath 𝕜 V, π.endpoint = 0 ∧ ¬ IsIntegralPath b f F π := by
  obtain ⟨i⟩ := ‹Nonempty b.support›
  let u := (4 : 𝕜)⁻¹ • f (P.root i)
  let π : PLPath 𝕜 V := straight 𝕜 (-u) * straight 𝕜 u
  refine ⟨π, by simp [π], fun hπ ↦ ?_⟩
  obtain ⟨z, hz⟩ := hπ.exists_minHeight_eq_intCast i
  have hmin : π.minHeight (F i) = -(2 : 𝕜)⁻¹ := by
    rw [minHeight_straight_neg_mul_straight]
    simp only [u, map_smul, smul_eq_mul, apply_root_eq_two hF i]
    norm_num
  rw [hmin] at hz
  have h2z : ((2 * z : ℤ) : 𝕜) = -1 := by
    push_cast
    linarith
  have : (2 * z : ℤ) = -1 := by exact_mod_cast h2z
  omega

end Realization

/-! ### Canonical realization via scalar extension `𝕜 ⊗[ℤ] X` -/

section BaseChange

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
  [Module.Free ℤ Y] [Module.Finite ℤ Y] {P : RootDatum ι X Y} (b : P.Base) (𝕜 : Type*)

/-- **The canonical normal crystal of integral paths in `𝕜 ⊗[ℤ] X`** for a root datum `P` with
finite free coweight lattice `Y` and base `b`, requiring no auxiliary realization parameters. -/
noncomputable abbrev baseChangeNormalCrystal [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] :
    NormalCrystal P b
      {π : PLPath 𝕜 (𝕜 ⊗[ℤ] X) |
        IsIntegralPath b (TensorProduct.mk ℤ 𝕜 X 1).toAddMonoidHom
          (fun i ↦ (P.baseChange 𝕜).coroot' i.1) π} :=
  normalCrystal (P := P) (b := b) (P.tensorProduct_mk_injective 𝕜)
    fun i x ↦ by simp

end BaseChange

end TauCeti.PLPath
