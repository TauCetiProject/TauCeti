module

public import TauCeti.RepresentationTheory.Crystal.Highest
public import TauCeti.RepresentationTheory.LSPath.Highest
public import TauCeti.RepresentationTheory.LSPath.Raise
import TauCeti.LinearAlgebra.RootSystem.Reduced

/-!
# The connected crystal `B(λ)` of Lakshmibai–Seshadri paths

Fix a dominant weight `λ`, an injective additive realization `f : M →+ V` of the weight lattice in
a vector space over a linearly ordered field, and height forms `F i` on `V` inducing the simple
coroot pairings on `f(M)`. Littelmann's raising and lowering operators preserve the realized
Lakshmibai–Seshadri paths of shape `λ` (`TauCeti.LSPath.isCrystalSet_range_toPLPath`), so they
form a normal crystal `B(λ)` (`TauCeti.LSPath.normalCrystal`), with weight the endpoint and string
lengths `ε_i = -min H_i` and `φ_i = H_i(1) - min H_i`.

This file proves Littelmann's Corollary 3: `B(λ)` is generated by its straight path `t ↦ tλ`. The
straight path is the only element of `B(λ)` killed by every raising operator
(`TauCeti.LSPath.forall_raise_eq_none_iff`). Since `B(λ)` is finite, successive raising
terminates (`TauCeti.NormalCrystal.wellFounded_e`), at a highest element, so at the straight path.
Reversing the raising word expresses every element as a word of lowering operators applied to the
straight path. In particular the crystal graph of `B(λ)` is connected.

On realized paths this identifies the chain encoding of LS paths with Littelmann's generated-path
definition: a path in `V` is the realized path of an LS path of shape `λ` exactly when some word
of lowering operators sends the straight path to it. The shape may lie on chamber walls, be zero
or central, and the root system may be empty.

## Main definitions

* `TauCeti.LSPath.normalCrystal`: the normal crystal `B(λ)` of realized LS paths of shape `λ`.

## Main results

* `TauCeti.LSPath.forall_normalCrystal_e_eq_none_iff`: the straight path is the unique highest
  element of `B(λ)`.
* `TauCeti.LSPath.exists_normalCrystal_fWord_straight_eq_some`: every element of `B(λ)` is a word
  of lowering operators applied to the straight path.
* `TauCeti.LSPath.connected_normalCrystal_graph`: the crystal graph of `B(λ)` is connected.
* `TauCeti.LSPath.exists_lowerWord_straight_eq_some_iff`: the realized LS paths of shape
  `λ` are exactly the paths obtained from the straight path by words of lowering operators.
* `TauCeti.LSPath.reflTransGen_lower_toPLPath_straight`: the realized path of every LS path of
  shape `λ` is reached from the straight path by finitely many simple lowerings.

## References

* P. Littelmann, *Paths and root operators in representation theory*, Ann. of Math. 142 (1995),
  499--525, §4, Corollary 3.
-/

public section

namespace TauCeti.LSPath

open RootPairing

variable {ι M N 𝕜 V : Type*} [AddCommGroup M] [AddCommGroup N]
  {P : RootPairing ι ℤ M N} {b : P.Base} [Finite ι] [P.IsReduced] {lam : M}
  [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] [AddCommGroup V] [Module 𝕜 V]
  {f : M →+ V} {F : b.support → Module.Dual 𝕜 V}

/-- **Littelmann's crystal `B(λ)`.** For a dominant shape `λ`, an injective realization `f` of the
weights and height forms `F i` inducing the simple coroot pairings on `f(M)`, the realized
Lakshmibai–Seshadri paths of shape `λ` form a normal crystal, with weight the endpoint, the
raising and lowering operators `raise (F i) (f αᵢ)` and `lower (F i) (f αᵢ)`, and string lengths
`ε_i = -min H_i` and `φ_i = H_i(1) - min H_i`. It is `TauCeti.PLPath.normalCrystalOn` on this
set, whose API therefore applies. -/
noncomputable abbrev normalCrystal (hlam : lam ∈ dominantChamber P b) (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (m : M), F i (f m) = P.coroot' i m) :
    NormalCrystal P b (Set.range fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f) :=
  PLPath.normalCrystalOn hf hF (isCrystalSet_range_toPLPath hlam f hF)

variable (hlam : lam ∈ dominantChamber P b) (hf : Function.Injective f)
  (hF : ∀ (i : b.support) (m : M), F i (f m) = P.coroot' i m)
include hlam hf hF

/-- **The straight path is the unique highest element of `B(λ)`**: an element of `B(λ)` is killed
by every raising operator exactly when it is the straight path `t ↦ tλ`. -/
theorem forall_normalCrystal_e_eq_none_iff
    (x : Set.range fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f) :
    (∀ i, (normalCrystal hlam hf hF).e i x = none) ↔ x.val = PLPath.straight 𝕜 (f lam) := by
  have := P.flip_isReduced
  obtain ⟨_, π, rfl⟩ := x
  simp only [PLPath.normalCrystalOn_e_eq_none_iff]
  constructor
  · intro h
    rw [(π.forall_raise_eq_none_iff hlam f F hF).mp h, toPLPath_straight 𝕜 f]
  · intro h
    rw [h, ← toPLPath_straight (P := P) (b := b) 𝕜 f]
    exact ((straight lam).forall_raise_eq_none_iff hlam f F hF).mpr rfl

/-- **`B(λ)` is generated by the straight path** (Littelmann, Corollary 3): every element of `B(λ)`
is obtained from the straight path `t ↦ tλ` by a word of lowering operators. -/
theorem exists_normalCrystal_fWord_straight_eq_some
    (x : Set.range fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f) :
    ∃ w : List b.support,
      (normalCrystal hlam hf hF).fWord w ⟨_, straight lam, toPLPath_straight 𝕜 f⟩ = some x := by
  have := LSPath.finite hlam
  exact (normalCrystal hlam hf hF).exists_fWord_eq_some_of_unique_highest
    (fun y hy ↦ Subtype.ext ((forall_normalCrystal_e_eq_none_iff hlam hf hF y).mp hy)) x

/-- **`B(λ)` is a connected crystal**: its crystal graph is connected. -/
theorem connected_normalCrystal_graph : (normalCrystal hlam hf hF).graph.Connected := by
  have := LSPath.finite hlam
  exact (normalCrystal hlam hf hF).connected_graph_of_unique_highest
    (h := ⟨_, straight lam, toPLPath_straight 𝕜 f⟩)
    (fun y hy ↦ Subtype.ext ((forall_normalCrystal_e_eq_none_iff hlam hf hF y).mp hy))

/-- **LS paths are the paths generated from the straight path.** A path in `V` is the realized
path of a Lakshmibai–Seshadri path of dominant shape `λ` exactly when some word of lowering
operators `f_{i_1} ⋯ f_{i_r}` sends the straight path `t ↦ tλ` to it. -/
theorem exists_lowerWord_straight_eq_some_iff (q : PLPath 𝕜 V) :
    (∃ w : List b.support, PLPath.lowerWord F (fun i ↦ f (P.root i)) w
        (PLPath.straight 𝕜 (f lam)) = some q) ↔
      ∃ π : LSPath P b lam, π.toPLPath 𝕜 f = q := by
  have h (w : List b.support) := PLPath.unattach_normalCrystalOn_fWord (hf := hf) (hF := hF)
    (hS := isCrystalSet_range_toPLPath hlam f hF) w ⟨_, straight lam, toPLPath_straight 𝕜 f⟩
  constructor
  · rintro ⟨w, hw⟩
    obtain ⟨y, -, hy⟩ := Option.map_eq_some_iff.mp ((h w).trans hw)
    exact hy ▸ y.property
  · rintro ⟨π, rfl⟩
    obtain ⟨w, hw⟩ := exists_normalCrystal_fWord_straight_eq_some hlam hf hF ⟨_, π, rfl⟩
    exact ⟨w, by rw [← h w, hw]; rfl⟩

/-- **Every LS path is reached from the straight path by lowering.** For a dominant shape `λ`, the
realized path of every Lakshmibai–Seshadri path of shape `λ` is obtained from the realized
straight path `t ↦ tλ` by finitely many simple-root lowering operators. -/
theorem reflTransGen_lower_toPLPath_straight (π : LSPath P b lam) :
    Relation.ReflTransGen
      (fun p q ↦ ∃ i : b.support, PLPath.lower (F i) (f (P.root i)) p = some q)
      (PLPath.straight 𝕜 (f lam)) (π.toPLPath 𝕜 f) :=
  PLPath.exists_lowerWord_eq_some_iff_reflTransGen.mp
    ((exists_lowerWord_straight_eq_some_iff hlam hf hF _).mpr ⟨π, rfl⟩)

end TauCeti.LSPath
