public import TauCeti.RepresentationTheory.LSPath.Central.Transport
public import TauCeti.RepresentationTheory.LSPath.Crystal.HighestWeight

import TauCeti.RepresentationTheory.LSPath.Realization

/-!
# Central transport of highest-weight path crystals

Let `P : RootDatum ι X Y` be a finite reduced root datum with base `b : P.Base`, let `λ` be a
dominant weight, and let `χ, σ ∈ X` be central weights (weights annihilating the simple coroots,
hence fixed by the Weyl group). Adding `χ` to `λ` preserves dominance, leaves the parabolic
stabilizer `W_λ` and reflection bonds unchanged, and induces the bijection
`TauCeti.LSPath.centralTransport χ : LSPath P b λ ≃ LSPath P b (λ + χ)` from
`TauCeti.RepresentationTheory.LSPath.Central.Transport`.

This file upgrades central transport to a family of strict isomorphisms of normal crystals
$$T_{\lambda,\chi}^\sigma : B(\lambda)^{\sigma + \chi} \to B(\lambda + \chi)^\sigma$$
both on the canonical encoding crystal `TauCeti.LSPath.normalCrystal`
(`TauCeti.LSPath.centralTransportIso`, `TauCeti.LSPath.centralTransportIsoOfEq`) and on the
connected component `B(λ)` generated by the straight path `PLPath.straight 𝕜 (f λ)` in any
injective simple-coroot realization `(f, F)`
(`TauCeti.LSPath.straightComponentCentralTransportIso`,
`TauCeti.LSPath.straightComponentCentralTransportIsoOfEq`).

On the realized path component `B(λ)`, the underlying map of $T_{\lambda,\chi}^\sigma$ is
independent of the auxiliary twist `σ` and acts via `TauCeti.PLPath.shiftDistinguished` on the
unique distinguished `f(W λ)`-orbit presentation of each path — never by a pointwise shear on
arbitrary reparametrization representatives, which is ill-defined on `PLPath`
(`TauCeti.PLPath.not_exists_shiftTimed_on_paths`). At `σ = 0` one recovers central transport from
the weight-twisted crystal `B(λ)^χ` onto untwisted `B(λ + χ)`
(`TauCeti.LSPath.centralTransportIsoZero`,
`TauCeti.LSPath.straightComponentCentralTransportIsoZero`).

Indexing the endpoints by explicit additive equations `λ + χ = λ'` and `σ + χ = τ` makes the
displayed sources, intermediate crystals, and targets definitionally identical in the coherence
identities:

* **identity** ($T_{\lambda,0}^\sigma = \mathrm{id}$):
  `TauCeti.LSPath.centralTransportIsoOfEq_zero` and
  `TauCeti.LSPath.straightComponentCentralTransportIsoOfEq_zero`;
* **additive composition** ($T_{\lambda+\chi,\psi}^\sigma \circ T_{\lambda,\chi}^{\sigma+\psi}
  = T_{\lambda,\chi+\psi}^\sigma$):
  `TauCeti.LSPath.centralTransportIsoOfEq_trans` and
  `TauCeti.LSPath.straightComponentCentralTransportIsoOfEq_trans`;
* **inverse** ($(T_{\lambda,\chi}^\sigma)^{-1} = T_{\lambda+\chi,-\chi}^{\sigma+\chi}$):
  `TauCeti.LSPath.centralTransportIsoOfEq_symm` and
  `TauCeti.LSPath.straightComponentCentralTransportIsoOfEq_symm`.

All results apply without restriction to `λ = 0`, `λ + χ = 0`, pure central weights, chamber
walls, and empty root systems.

## Main definitions

* `TauCeti.LSPath.centralTransportIsoOfEq`, `TauCeti.LSPath.centralTransportIso`,
  `TauCeti.LSPath.centralTransportIsoZero`: strict crystal isomorphisms
  $T_{\lambda,\chi}^\sigma : B(\lambda)^{\sigma+\chi} \to B(\lambda+\chi)^\sigma$ and the `σ = 0`
  transport on `LSPath.normalCrystal`.
* `TauCeti.LSPath.straightComponentCentralTransportIsoOfEq`,
  `TauCeti.LSPath.straightComponentCentralTransportIso`,
  `TauCeti.LSPath.straightComponentCentralTransportIsoZero`: the corresponding strict crystal
  isomorphisms on the realized straight-path component `PLPath.normalCrystalComponent`.

## Main results

* `TauCeti.LSPath.normalCrystal_wt_centralTransportOfEq`,
  `TauCeti.LSPath.normalCrystal_e_centralTransportOfEq`: central transport shifts crystal weights by
  `χ` and commutes with all simple-root raising operators.
* `TauCeti.LSPath.centralTransportIsoOfEq_zero`, `TauCeti.LSPath.centralTransportIsoOfEq_trans`,
  `TauCeti.LSPath.centralTransportIsoOfEq_symm`: strict-isomorphism identity, additive composition,
  and inverse formulas on `LSPath.normalCrystal`.
* `TauCeti.LSPath.straightComponentCentralTransportIsoOfEq_apply`,
  `TauCeti.LSPath.straightComponentCentralTransportIso_apply`: on `B(λ)` the underlying map is
  `PLPath.shiftDistinguished` along `f(W λ)`, independent of `σ`.
* `TauCeti.LSPath.straightComponentCentralTransportIsoOfEq_zero`,
  `TauCeti.LSPath.straightComponentCentralTransportIsoOfEq_trans`,
  `TauCeti.LSPath.straightComponentCentralTransportIsoOfEq_symm`: strict-isomorphism identity,
  additive composition, and inverse formulas on the straight-path component `B(λ)`.

## References

* P. Littelmann, *A Littlewood–Richardson rule for symmetrizable Kac–Moody algebras*, Invent. Math.
  116 (1994), 329–346, §4.
* P. Littelmann, *Paths and root operators in representation theory*, Ann. of Math. 142 (1995),
  499–525, §4.
* M. Kashiwara, *On crystal bases*, CMS Conf. Proc. 16 (1995), §7.
-/

public section

namespace TauCeti.LSPath

open Module RootPairing Set
open scoped TensorProduct

section EncodingCrystal

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
  {P : RootDatum ι X Y} {b : P.Base} [Finite ι] [P.IsReduced]

omit [Finite ι] [P.IsReduced] in
/-- Translating a dominant weight by a central weight preserves membership in the dominant
chamber. -/
theorem mem_dominantChamber_add_of_forall_coroot_eq_zero {lam χ : X}
    (hlam : lam ∈ dominantChamber P b)
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0) :
    lam + χ ∈ dominantChamber P b := by
  rw [mem_dominantChamber] at hlam ⊢
  intro i hi
  have h0 : P.coroot' i χ = 0 := hχ ⟨i, hi⟩
  rw [map_add, h0, add_zero]
  exact hlam i hi

/-- Central transport shifts the crystal weight of an LS path by `χ`. -/
theorem normalCrystal_wt_centralTransportOfEq {lam lam' χ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hχ : ∀ i ∈ b.support, P.coroot' i χ = 0) (h_lam : lam + χ = lam')
    (π : LSPath P b lam) :
    (normalCrystal hlam').wt (centralTransportOfEq χ hχ h_lam π) =
      (normalCrystal hlam).wt π + χ := by
  let f₀ : X →+ ℚ ⊗[ℤ] X := (TensorProduct.mk ℤ ℚ X 1).toAddMonoidHom
  apply P.tensorProduct_mk_injective ℚ
  change f₀ _ = f₀ _
  rw [map_add, apply_normalCrystal_wt (𝕜 := ℚ), apply_normalCrystal_wt (𝕜 := ℚ),
    endpoint_toPLPath_centralTransportOfEq]

/-- Central transport commutes with the raising operators of `LSPath.normalCrystal`. -/
theorem normalCrystal_e_centralTransportOfEq {lam lam' χ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hχ : ∀ i ∈ b.support, P.coroot' i χ = 0) (h_lam : lam + χ = lam')
    (i : b.support) (π : LSPath P b lam) :
    (normalCrystal hlam').e i (centralTransportOfEq χ hχ h_lam π) =
      ((normalCrystal hlam).e i π).map (centralTransportOfEq χ hχ h_lam) := by
  let f₀ : X →+ ℚ ⊗[ℤ] X := (TensorProduct.mk ℤ ℚ X 1).toAddMonoidHom
  let F₀ : b.support → Dual ℚ (ℚ ⊗[ℤ] X) :=
    fun j ↦ ((Algebra.linearMap ℤ ℚ).comp (P.coroot' j.1)).liftBaseChange ℚ
  have hF₀ : ∀ (j : b.support) (x : X), F₀ j (f₀ x) = (P.coroot' j x : ℚ) := fun j x ↦ by
    simp [f₀, F₀]
  apply Option.map_injective (toPLPath_injective_of_coroot' (𝕜 := ℚ) hlam' hF₀)
  rw [← raise_toPLPath_eq_map_normalCrystal_e hlam' hF₀ i,
    raise_toPLPath_centralTransportOfEq_of_coroot' χ hχ π ℚ f₀ h_lam hlam hF₀ i,
    raise_toPLPath_eq_map_normalCrystal_e hlam hF₀ i, Option.map_map, Option.map_map]
  exact Option.map_congr fun π' _ ↦
    (toPLPath_centralTransportOfEq_of_coroot' χ hχ π' ℚ f₀ h_lam hlam hF₀).symm

omit [Finite ι] [P.IsReduced] in
/-- Convert a simple-coroot vanishing hypothesis written via `P.toLinearMap` to the `P.coroot'`
form expected by `LSPath.centralTransportOfEq`. -/
theorem coroot'_eq_zero_of_forall {χ : X}
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0) :
    ∀ i ∈ b.support, P.coroot' i χ = 0 :=
  fun i hi ↦ hχ ⟨i, hi⟩

/-- **Equation-indexed central transport strict crystal isomorphism** between weight-twisted LS
path crystals: when `λ + χ = λ'` and `σ + χ = τ` for central weights `χ, σ, τ`,
`centralTransportOfEq` is a strict crystal isomorphism
`(normalCrystal hlam)^τ ≃ (normalCrystal hlam')^σ`. -/
noncomputable def centralTransportIsoOfEq {lam lam' χ σ τ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0)
    (hτ : ∀ i : b.support, P.toLinearMap τ (P.coroot i) = 0)
    (h_lam : lam + χ = lam') (h_στ : σ + χ = τ) :
    NormalCrystal.StrictIso
      ((normalCrystal hlam).weightTwist τ hτ)
      ((normalCrystal hlam').weightTwist σ hσ) where
  toEquiv := centralTransportOfEq χ (coroot'_eq_zero_of_forall hχ) h_lam
  wt_toFun π := by
    rw [NormalCrystal.weightTwist_wt, NormalCrystal.weightTwist_wt, Equiv.toFun_as_coe,
      normalCrystal_wt_centralTransportOfEq hlam, ← h_στ, add_assoc, add_comm χ σ]
  e_toFun i π := by
    rw [NormalCrystal.weightTwist_e, NormalCrystal.weightTwist_e, Equiv.toFun_as_coe,
      normalCrystal_e_centralTransportOfEq hlam]

@[simp]
theorem toEquiv_centralTransportIsoOfEq {lam lam' χ σ τ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0)
    (hτ : ∀ i : b.support, P.toLinearMap τ (P.coroot i) = 0)
    (h_lam : lam + χ = lam') (h_στ : σ + χ = τ) :
    (centralTransportIsoOfEq hlam hlam' hχ hσ hτ h_lam h_στ).toEquiv =
      centralTransportOfEq χ (coroot'_eq_zero_of_forall hχ) h_lam :=
  (rfl)

@[simp]
theorem coe_centralTransportIsoOfEq {lam lam' χ σ τ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0)
    (hτ : ∀ i : b.support, P.toLinearMap τ (P.coroot i) = 0)
    (h_lam : lam + χ = lam') (h_στ : σ + χ = τ) :
    ⇑(centralTransportIsoOfEq hlam hlam' hχ hσ hτ h_lam h_στ) =
      centralTransportOfEq χ (coroot'_eq_zero_of_forall hχ) h_lam :=
  (rfl)

@[simp]
theorem centralTransportIsoOfEq_apply {lam lam' χ σ τ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0)
    (hτ : ∀ i : b.support, P.toLinearMap τ (P.coroot i) = 0)
    (h_lam : lam + χ = lam') (h_στ : σ + χ = τ) (π : LSPath P b lam) :
    centralTransportIsoOfEq hlam hlam' hχ hσ hτ h_lam h_στ π =
      centralTransportOfEq χ (coroot'_eq_zero_of_forall hχ) h_lam π :=
  (rfl)

/-- **Central transport strict crystal isomorphism**
$T_{\lambda,\chi}^\sigma : B(\lambda)^{\sigma + \chi} \to B(\lambda + \chi)^\sigma$ on
`LSPath.normalCrystal`. -/
noncomputable def centralTransportIso {lam : X}
    (hlam : lam ∈ dominantChamber P b) (χ : X)
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0) (σ : X)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0) :
    NormalCrystal.StrictIso
      ((normalCrystal hlam).weightTwist (σ + χ) (by simp [map_add, hσ, hχ]))
      ((normalCrystal (mem_dominantChamber_add_of_forall_coroot_eq_zero hlam hχ)).weightTwist
        σ hσ) :=
  centralTransportIsoOfEq hlam (mem_dominantChamber_add_of_forall_coroot_eq_zero hlam hχ)
    hχ hσ (by simp [map_add, hσ, hχ]) rfl rfl

/-- The underlying map of `centralTransportIso` is `centralTransport χ`, independent of the
auxiliary central weight `σ`. -/
@[simp]
theorem coe_centralTransportIso {lam : X}
    (hlam : lam ∈ dominantChamber P b) (χ : X)
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0) (σ : X)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0) :
    ⇑(centralTransportIso hlam χ hχ σ hσ) =
      centralTransport χ (coroot'_eq_zero_of_forall hχ) := by
  rw [centralTransport_eq_centralTransportOfEq]
  rfl

/-- Specialization of central transport at `σ = 0`, identifying the weight-twisted crystal
`B(λ)^χ` with the untwisted crystal `B(λ + χ)`. -/
noncomputable def centralTransportIsoZero {lam : X}
    (hlam : lam ∈ dominantChamber P b) (χ : X)
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0) :
    NormalCrystal.StrictIso
      ((normalCrystal hlam).weightTwist χ hχ)
      (normalCrystal (mem_dominantChamber_add_of_forall_coroot_eq_zero hlam hχ)) where
  toEquiv := centralTransport χ (coroot'_eq_zero_of_forall hχ)
  wt_toFun π := by
    rw [NormalCrystal.weightTwist_wt, Equiv.toFun_as_coe,
      centralTransport_eq_centralTransportOfEq,
      normalCrystal_wt_centralTransportOfEq hlam]
  e_toFun i π := by
    rw [NormalCrystal.weightTwist_e, Equiv.toFun_as_coe,
      centralTransport_eq_centralTransportOfEq,
      normalCrystal_e_centralTransportOfEq hlam]

@[simp]
theorem coe_centralTransportIsoZero {lam : X}
    (hlam : lam ∈ dominantChamber P b) (χ : X)
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0) :
    ⇑(centralTransportIsoZero hlam χ hχ) =
      centralTransport χ (coroot'_eq_zero_of_forall hχ) :=
  (rfl)

theorem normalCrystal_f_centralTransportOfEq {lam lam' χ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hχ : ∀ i ∈ b.support, P.coroot' i χ = 0) (h_lam : lam + χ = lam')
    (i : b.support) (π : LSPath P b lam) :
    (normalCrystal hlam').f i (centralTransportOfEq χ hχ h_lam π) =
      ((normalCrystal hlam).f i π).map (centralTransportOfEq χ hχ h_lam) := by
  have hχ' : ∀ j : b.support, P.toLinearMap χ (P.coroot j) = 0 := fun j ↦ hχ j.1 j.2
  simpa using (centralTransportIsoOfEq hlam hlam' hχ' (σ := 0) (τ := χ) (by simp) hχ' h_lam
    (zero_add χ)).f_apply i π

theorem normalCrystal_ε_centralTransportOfEq {lam lam' χ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hχ : ∀ i ∈ b.support, P.coroot' i χ = 0) (h_lam : lam + χ = lam')
    (i : b.support) (π : LSPath P b lam) :
    (normalCrystal hlam').ε i (centralTransportOfEq χ hχ h_lam π) =
      (normalCrystal hlam).ε i π := by
  have hχ' : ∀ j : b.support, P.toLinearMap χ (P.coroot j) = 0 := fun j ↦ hχ j.1 j.2
  simpa using (centralTransportIsoOfEq hlam hlam' hχ' (σ := 0) (τ := χ) (by simp) hχ' h_lam
    (zero_add χ)).ε_apply i π

theorem normalCrystal_φ_centralTransportOfEq {lam lam' χ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hχ : ∀ i ∈ b.support, P.coroot' i χ = 0) (h_lam : lam + χ = lam')
    (i : b.support) (π : LSPath P b lam) :
    (normalCrystal hlam').φ i (centralTransportOfEq χ hχ h_lam π) =
      (normalCrystal hlam).φ i π := by
  have hχ' : ∀ j : b.support, P.toLinearMap χ (P.coroot j) = 0 := fun j ↦ hχ j.1 j.2
  simpa using (centralTransportIsoOfEq hlam hlam' hχ' (σ := 0) (τ := χ) (by simp) hχ' h_lam
    (zero_add χ)).φ_apply i π

/-- **Identity law $T_{\lambda,0}^\sigma = \mathrm{id}$** for `centralTransportIsoOfEq`. -/
@[simp]
theorem centralTransportIsoOfEq_zero {lam σ : X}
    (hlam : lam ∈ dominantChamber P b)
    (h0 : ∀ i : b.support, P.toLinearMap (0 : X) (P.coroot i) = 0)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0) :
    centralTransportIsoOfEq hlam hlam h0 hσ hσ (add_zero lam) (add_zero σ) =
      NormalCrystal.StrictIso.refl ((normalCrystal hlam).weightTwist σ hσ) :=
  NormalCrystal.StrictIso.ext fun π ↦ by simp

/-- **Additive composition law
$T_{\lambda+\chi,\psi}^\sigma \circ T_{\lambda,\chi}^{\sigma+\psi} = T_{\lambda,\chi+\psi}^\sigma$**
for `centralTransportIsoOfEq`. (Recall `StrictIso.trans` composes left-to-right:
`(T₁.trans T₂) π = T₂ (T₁ π)`.) -/
@[simp]
theorem centralTransportIsoOfEq_trans {lam₁ lam₂ lam₃ χ ψ σ₁ σ₂ σ₃ : X}
    (hlam₁ : lam₁ ∈ dominantChamber P b) (hlam₂ : lam₂ ∈ dominantChamber P b)
    (hlam₃ : lam₃ ∈ dominantChamber P b)
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (hψ : ∀ i : b.support, P.toLinearMap ψ (P.coroot i) = 0)
    (hσ₁ : ∀ i : b.support, P.toLinearMap σ₁ (P.coroot i) = 0)
    (hσ₂ : ∀ i : b.support, P.toLinearMap σ₂ (P.coroot i) = 0)
    (hσ₃ : ∀ i : b.support, P.toLinearMap σ₃ (P.coroot i) = 0)
    (h_lam₁ : lam₁ + χ = lam₂) (h_lam₂ : lam₂ + ψ = lam₃)
    (h_σ₁ : σ₂ + χ = σ₁) (h_σ₂ : σ₃ + ψ = σ₂) :
    (centralTransportIsoOfEq hlam₁ hlam₂ hχ hσ₂ hσ₁ h_lam₁ h_σ₁).trans
      (centralTransportIsoOfEq hlam₂ hlam₃ hψ hσ₃ hσ₂ h_lam₂ h_σ₂) =
      centralTransportIsoOfEq (χ := χ + ψ) hlam₁ hlam₃ (by simp [map_add, hχ, hψ]) hσ₃ hσ₁
        (by rw [← add_assoc, h_lam₁, h_lam₂])
        (by rw [← h_σ₁, ← h_σ₂, add_assoc, add_comm ψ χ]) :=
  NormalCrystal.StrictIso.ext fun π ↦ by simp

/-- **Inverse formula $(T_{\lambda,\chi}^\sigma)^{-1} = T_{\lambda+\chi,-\chi}^{\sigma+\chi}$**
for `centralTransportIsoOfEq`. -/
@[simp]
theorem centralTransportIsoOfEq_symm {lam lam' χ σ τ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0)
    (hτ : ∀ i : b.support, P.toLinearMap τ (P.coroot i) = 0)
    (h_lam : lam + χ = lam') (h_στ : σ + χ = τ) :
    (centralTransportIsoOfEq hlam hlam' hχ hσ hτ h_lam h_στ).symm =
      centralTransportIsoOfEq (χ := -χ) hlam' hlam (by simp [hχ]) hτ hσ
        (by rw [← h_lam, add_neg_cancel_right])
        (by rw [← h_στ, add_neg_cancel_right]) :=
  NormalCrystal.StrictIso.ext fun π ↦ by
    let T := centralTransportIsoOfEq hlam hlam' hχ hσ hτ h_lam h_στ
    obtain ⟨y, rfl⟩ := EquivLike.surjective T π
    rw [NormalCrystal.StrictIso.symm_apply_apply]
    simp only [T, centralTransportIsoOfEq_apply]
    have hsymm :
        centralTransportOfEq (-χ) (coroot'_eq_zero_of_forall (by simp [hχ]))
          (by rw [← h_lam, add_neg_cancel_right]) =
          (centralTransportOfEq χ (coroot'_eq_zero_of_forall hχ) h_lam).symm := by
      rw [centralTransportOfEq_symm]
    rw [hsymm, Equiv.symm_apply_apply]

/-- Inverse formula specialized directly to `centralTransportIso`. -/
theorem centralTransportIso_symm {lam : X}
    (hlam : lam ∈ dominantChamber P b) (χ : X)
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0) (σ : X)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0) :
    (centralTransportIso hlam χ hχ σ hσ).symm =
      centralTransportIsoOfEq (χ := -χ)
        (mem_dominantChamber_add_of_forall_coroot_eq_zero hlam hχ) hlam
        (by simp [hχ]) (by simp [map_add, hσ, hχ]) hσ
        (add_neg_cancel_right lam χ) (add_neg_cancel_right σ χ) :=
  centralTransportIsoOfEq_symm hlam
    (mem_dominantChamber_add_of_forall_coroot_eq_zero hlam hχ)
    hχ hσ (by simp [map_add, hσ, hχ]) rfl rfl

end EncodingCrystal

/-! ### Central transport on the realized straight-path crystal component `B(λ)` -/

section StraightComponent

variable {ι X Y 𝕜 V : Type*} [AddCommGroup X] [AddCommGroup Y]
  {P : RootDatum ι X Y} {b : P.Base} [Finite ι] [P.IsReduced]
  [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] [AddCommGroup V] [Module 𝕜 V]
  {f : X →+ V} {F : b.support → Dual 𝕜 V}

/-- **Equation-indexed central transport strict crystal isomorphism on the straight-path component
`B(λ)`.** When `λ + χ = λ'` and `σ + χ = τ` for central weights `χ, σ, τ`, this is a strict crystal
isomorphism from `B(λ)^τ` onto `B(λ')^σ` inside Littelmann's path crystal. -/
noncomputable def straightComponentCentralTransportIsoOfEq {lam lam' χ σ τ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0)
    (hτ : ∀ i : b.support, P.toLinearMap τ (P.coroot i) = 0)
    (h_lam : lam + χ = lam') (h_στ : σ + χ = τ) :
    NormalCrystal.StrictIso
      ((PLPath.normalCrystalComponent hf hF
        ⟨PLPath.straight 𝕜 (f lam),
          PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩).weightTwist τ hτ)
      ((PLPath.normalCrystalComponent hf hF
        ⟨PLPath.straight 𝕜 (f lam'),
          PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam' hF⟩).weightTwist σ hσ) :=
  (((normalCrystalComponentIso hlam hf hF).symm).weightTwist τ hτ).trans
    ((centralTransportIsoOfEq hlam hlam' hχ hσ hτ h_lam h_στ).trans
      ((normalCrystalComponentIso hlam' hf hF).weightTwist σ hσ))

/-- **On the straight-path component `B(λ)`, central transport acts by `PLPath.shiftDistinguished`
along the realized orbit `f(W λ)`, independent of `σ` and `τ`.** -/
@[simp]
theorem straightComponentCentralTransportIsoOfEq_apply {lam lam' χ σ τ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0)
    (hτ : ∀ i : b.support, P.toLinearMap τ (P.coroot i) = 0)
    (h_lam : lam + χ = lam') (h_στ : σ + χ = τ)
    (x : (PLPath.normalCrystal hf hF).graph.connectedComponentMk
      ⟨PLPath.straight 𝕜 (f lam),
        PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩) :
    (straightComponentCentralTransportIsoOfEq hlam hlam' hf hF hχ hσ hτ h_lam h_στ x).1.1 =
      PLPath.shiftDistinguished (range fun w : P.weylGroup ↦ f (w • lam)) (f χ) x.1.1 := by
  simp only [straightComponentCentralTransportIsoOfEq, NormalCrystal.StrictIso.trans_apply,
    NormalCrystal.StrictIso.weightTwist_apply, centralTransportIsoOfEq_apply,
    normalCrystalComponentIso_apply]
  rw [toPLPath_centralTransportOfEq_of_coroot' χ (coroot'_eq_zero_of_forall hχ) _ 𝕜 f h_lam hlam
    hF, toPLPath_normalCrystalComponentIso_symm]

/-- **Central transport strict crystal isomorphism
$T_{\lambda,\chi}^\sigma : B(\lambda)^{\sigma + \chi} \to B(\lambda + \chi)^\sigma$ on the
realized straight-path component.** -/
noncomputable def straightComponentCentralTransportIso {lam : X}
    (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (χ : X) (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (σ : X) (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0) :
    NormalCrystal.StrictIso
      ((PLPath.normalCrystalComponent hf hF
        ⟨PLPath.straight 𝕜 (f lam),
          PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩).weightTwist
        (σ + χ) (by simp [map_add, hσ, hχ]))
      ((PLPath.normalCrystalComponent hf hF
        ⟨PLPath.straight 𝕜 (f (lam + χ)),
          PLPath.isIntegralPath_straight_of_mem_dominantChamber
            (mem_dominantChamber_add_of_forall_coroot_eq_zero hlam hχ) hF⟩).weightTwist σ hσ) :=
  straightComponentCentralTransportIsoOfEq hlam
    (mem_dominantChamber_add_of_forall_coroot_eq_zero hlam hχ) hf hF hχ hσ
    (by simp [map_add, hσ, hχ]) rfl rfl

/-- The underlying path map of `straightComponentCentralTransportIso` is
`PLPath.shiftDistinguished` along `f(W λ)` and does not depend on `σ`. -/
@[simp]
theorem straightComponentCentralTransportIso_apply {lam : X}
    (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (χ : X) (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (σ : X) (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0)
    (x : (PLPath.normalCrystal hf hF).graph.connectedComponentMk
      ⟨PLPath.straight 𝕜 (f lam),
        PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩) :
    (straightComponentCentralTransportIso hlam hf hF χ hχ σ hσ x).1.1 =
      PLPath.shiftDistinguished (range fun w : P.weylGroup ↦ f (w • lam)) (f χ) x.1.1 :=
  straightComponentCentralTransportIsoOfEq_apply hlam _ hf hF hχ hσ _ rfl rfl x

/-- Specialization at `σ = 0` on the straight-path component: strict crystal isomorphism from
`B(λ)^χ` onto untwisted `B(λ + χ)`. -/
noncomputable def straightComponentCentralTransportIsoZero {lam : X}
    (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (χ : X) (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0) :
    NormalCrystal.StrictIso
      ((PLPath.normalCrystalComponent hf hF
        ⟨PLPath.straight 𝕜 (f lam),
          PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩).weightTwist χ hχ)
      (PLPath.normalCrystalComponent hf hF
        ⟨PLPath.straight 𝕜 (f (lam + χ)),
          PLPath.isIntegralPath_straight_of_mem_dominantChamber
            (mem_dominantChamber_add_of_forall_coroot_eq_zero hlam hχ) hF⟩) :=
  (((normalCrystalComponentIso hlam hf hF).symm).weightTwist χ hχ).trans
    ((centralTransportIsoZero hlam χ hχ).trans
      (normalCrystalComponentIso
        (mem_dominantChamber_add_of_forall_coroot_eq_zero hlam hχ) hf hF))

@[simp]
theorem straightComponentCentralTransportIsoZero_apply {lam : X}
    (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (χ : X) (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (x : (PLPath.normalCrystal hf hF).graph.connectedComponentMk
      ⟨PLPath.straight 𝕜 (f lam),
        PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩) :
    (straightComponentCentralTransportIsoZero hlam hf hF χ hχ x).1.1 =
      PLPath.shiftDistinguished (range fun w : P.weylGroup ↦ f (w • lam)) (f χ) x.1.1 := by
  simp only [straightComponentCentralTransportIsoZero, NormalCrystal.StrictIso.trans_apply,
    NormalCrystal.StrictIso.weightTwist_apply, coe_centralTransportIsoZero,
    normalCrystalComponentIso_apply]
  rw [toPLPath_centralTransport_of_coroot' χ (coroot'_eq_zero_of_forall hχ) _ 𝕜 f hlam hF,
    toPLPath_normalCrystalComponentIso_symm]

/-- **Identity law $T_{\lambda,0}^\sigma = \mathrm{id}$** on the straight-path component
`B(λ)^σ`. -/
@[simp]
theorem straightComponentCentralTransportIsoOfEq_zero {lam σ : X}
    (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (h0 : ∀ i : b.support, P.toLinearMap (0 : X) (P.coroot i) = 0)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0) :
    straightComponentCentralTransportIsoOfEq hlam hlam hf hF h0 hσ hσ
      (add_zero lam) (add_zero σ) =
      NormalCrystal.StrictIso.refl
        ((PLPath.normalCrystalComponent hf hF
          ⟨PLPath.straight 𝕜 (f lam),
            PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩).weightTwist σ hσ) := by
  refine NormalCrystal.StrictIso.ext fun x ↦ ?_
  simp [straightComponentCentralTransportIsoOfEq]

/-- **Additive composition law
$T_{\lambda+\chi,\psi}^\sigma \circ T_{\lambda,\chi}^{\sigma+\psi} = T_{\lambda,\chi+\psi}^\sigma$**
on the straight-path components. -/
@[simp]
theorem straightComponentCentralTransportIsoOfEq_trans {lam₁ lam₂ lam₃ χ ψ σ₁ σ₂ σ₃ : X}
    (hlam₁ : lam₁ ∈ dominantChamber P b) (hlam₂ : lam₂ ∈ dominantChamber P b)
    (hlam₃ : lam₃ ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (hψ : ∀ i : b.support, P.toLinearMap ψ (P.coroot i) = 0)
    (hσ₁ : ∀ i : b.support, P.toLinearMap σ₁ (P.coroot i) = 0)
    (hσ₂ : ∀ i : b.support, P.toLinearMap σ₂ (P.coroot i) = 0)
    (hσ₃ : ∀ i : b.support, P.toLinearMap σ₃ (P.coroot i) = 0)
    (h_lam₁ : lam₁ + χ = lam₂) (h_lam₂ : lam₂ + ψ = lam₃)
    (h_σ₁ : σ₂ + χ = σ₁) (h_σ₂ : σ₃ + ψ = σ₂) :
    (straightComponentCentralTransportIsoOfEq hlam₁ hlam₂ hf hF hχ hσ₂ hσ₁ h_lam₁ h_σ₁).trans
      (straightComponentCentralTransportIsoOfEq hlam₂ hlam₃ hf hF hψ hσ₃ hσ₂ h_lam₂ h_σ₂) =
      straightComponentCentralTransportIsoOfEq (χ := χ + ψ) hlam₁ hlam₃ hf hF
        (by simp [map_add, hχ, hψ]) hσ₃ hσ₁
        (by rw [← add_assoc, h_lam₁, h_lam₂])
        (by rw [← h_σ₁, ← h_σ₂, add_assoc, add_comm ψ χ]) := by
  refine NormalCrystal.StrictIso.ext fun x ↦ ?_
  simp [straightComponentCentralTransportIsoOfEq]

/-- **Inverse formula $(T_{\lambda,\chi}^\sigma)^{-1} = T_{\lambda+\chi,-\chi}^{\sigma+\chi}$**
on the straight-path components. -/
@[simp]
theorem straightComponentCentralTransportIsoOfEq_symm {lam lam' χ σ τ : X}
    (hlam : lam ∈ dominantChamber P b) (hlam' : lam' ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0)
    (hσ : ∀ i : b.support, P.toLinearMap σ (P.coroot i) = 0)
    (hτ : ∀ i : b.support, P.toLinearMap τ (P.coroot i) = 0)
    (h_lam : lam + χ = lam') (h_στ : σ + χ = τ) :
    (straightComponentCentralTransportIsoOfEq hlam hlam' hf hF hχ hσ hτ h_lam h_στ).symm =
      straightComponentCentralTransportIsoOfEq (χ := -χ) hlam' hlam hf hF (by simp [hχ]) hτ hσ
        (by rw [← h_lam, add_neg_cancel_right])
        (by rw [← h_στ, add_neg_cancel_right]) := by
  refine NormalCrystal.StrictIso.ext fun x ↦ ?_
  let T := straightComponentCentralTransportIsoOfEq hlam hlam' hf hF hχ hσ hτ h_lam h_στ
  obtain ⟨y, rfl⟩ := EquivLike.surjective T x
  rw [NormalCrystal.StrictIso.symm_apply_apply]
  simp only [T, straightComponentCentralTransportIsoOfEq, NormalCrystal.StrictIso.trans_apply,
    NormalCrystal.StrictIso.weightTwist_apply, NormalCrystal.StrictIso.symm_apply_apply,
    ← centralTransportIsoOfEq_symm hlam hlam' hχ hσ hτ h_lam h_στ,
    NormalCrystal.StrictIso.apply_symm_apply]

end StraightComponent

