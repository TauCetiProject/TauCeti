/-!
# The Lakshmibai–Seshadri crystal `B(λ)` and its equivalence with the straight-path component

Fix a finite reduced root datum `P : RootDatum ι X Y` with a base `b : P.Base` and a dominant weight
`λ ∈ dominantChamber P b`. A Lakshmibai–Seshadri path `π : LSPath P b λ` is defined combinatorially
by a decreasing sequence of minimal coset directions in `W / W_λ` and rational break times connected
by `a`-chains (`TauCeti.LSPath`).

In any ordered-field realization `(𝕜, V, f, F)` whose height forms agree with the simple coroots on
`f(X)` (`F i (f x) = ⟨x, α_i^∨⟩`), the realized LS paths of shape `λ` have endpoints in `f(X)`
(`TauCeti.LSPath.exists_mem_rootSpan_endpoint_eq_add`), integral minimum simple-coroot heights
(`TauCeti.LSPath.exists_minHeight_eq_intCast`), and are stable under both Littelmann's lowering and
raising operators (`TauCeti.LSPath.exists_toPLPath_eq_of_lower_eq_some`,
`TauCeti.LSPath.exists_toPLPath_eq_of_raise_eq_some`), with the resulting LS encodings independent
of the realization (`TauCeti.LSPath.exists_toPLPath_eq_and_lower_eq_some`,
`TauCeti.LSPath.exists_toPLPath_eq_and_raise_eq_some`). Moreover, the height forms alone separate
the Weyl orbit `W λ` and prevent distinct orbit weights from lying on a common ray
(`RootPairing.injOn_range_smul_of_coroot'`,
`RootPairing.pairwise_not_sameRay_range_smul_of_coroot'`), so `π ↦ π.toPLPath 𝕜 f` is injective
(`TauCeti.LSPath.toPLPath_injective_of_coroot'`).

Evaluating in the canonical injective rational realization `X →+ (ℚ ⊗[ℤ] X)`
(`RootPairing.tensorProduct_mk_injective`, needing no freeness or finite-generation assumption on
`Y`) equips `LSPath P b λ` itself with an intrinsic, realization-free normal crystal structure
`TauCeti.LSPath.normalCrystal hlam : NormalCrystal P b (LSPath P b λ)`. Every compatible realization
`(𝕜, V, f, F)` computes its weights, raising and lowering operators, and string lengths; when `f` is
injective on `X`, `π ↦ π.toPLPath 𝕜 f` is a strict crystal isomorphism onto the realized path
crystal (`TauCeti.LSPath.toPLPathIso`) and onto the connected path-crystal component generated by
the straight path `t ↦ t • f λ` (`TauCeti.LSPath.toComponentIso`).

Combining finiteness of `LSPath P b λ` (`TauCeti.LSPath.finite`) with uniqueness of the highest LS
path `straight λ` (`TauCeti.LSPath.forall_raise_eq_none_iff`) and well-foundedness of raising in
finite normal crystals (`TauCeti.NormalCrystal.exists_fWord_eq_some_of_unique_highest`) yields
Littelmann's equivalence between the combinatorial `a`-chain definition of LS paths, pure lowering
from the straight path, and the full `{e_i, f_i}`-component of the straight path
(`TauCeti.LSPath.mem_range_toPLPath_iff_exists_lowerWord`,
`TauCeti.LSPath.mem_range_toPLPath_iff_reflTransGen_rootStep`). Finally, LS-path duality induces a
strict crystal isomorphism `TauCeti.LSPath.dualIso` from `(normalCrystal hlam).dual` to
`normalCrystal (-w₀ λ)`.

## Main definitions

* `TauCeti.LSPath.normalCrystal`: **the intrinsic normal crystal `B(λ)` on `LSPath P b λ`** for a
  dominant weight `λ`.
* `TauCeti.LSPath.toPLPathIso`, `TauCeti.LSPath.toPLPathHom`: strict crystal isomorphism onto
  `PLPath.normalCrystalOn` and strict embedding into `PLPath.normalCrystal` in any injective
  realization `(f, F)`.
* `TauCeti.LSPath.toComponentIso`: **strict crystal isomorphism between `LSPath.normalCrystal` and
  the connected path-crystal component `PLPath.normalCrystalComponent` of `straight 𝕜 (f λ)`.**
* `TauCeti.LSPath.dualIso`: **contragredient crystal duality**
  `(normalCrystal hlam).dual ≃ normalCrystal (-w₀ λ)`.

## Main results

* `TauCeti.LSPath.isCrystalSet_range_toPLPath`, `TauCeti.LSPath.isIntegralPath_toPLPath`,
  `TauCeti.PLPath.isIntegralPath_straight_of_mem_dominantChamber`: realized LS paths form a
  crystal-admissible set of integral paths; in particular every dominant straight path is integral.
* `TauCeti.LSPath.forall_normalCrystal_e_eq_none_iff`,
  `TauCeti.LSPath.exists_fWord_straight_eq_some`, `TauCeti.LSPath.connected_normalCrystal_graph`:
  `straight λ` is the unique highest element of `normalCrystal hlam`, generates it by lowering
  words, and `normalCrystal hlam` is connected.
* `TauCeti.LSPath.mem_range_toPLPath_iff_exists_lowerWord`,
  `TauCeti.LSPath.mem_range_toPLPath_iff_reflTransGen_rootStep`,
  `TauCeti.LSPath.image_val_supp_connectedComponentMk_straight`: **equivalence of the `a`-chain LS
  encoding model with the operator-generated straight-path crystal.**

## References

* P. Littelmann, *A Littlewood–Richardson rule for symmetrizable Kac–Moody algebras*, Invent. Math.
  116 (1994), §4.
* P. Littelmann, *Paths and root operators in representation theory*, Ann. of Math. 142 (1995),
  §§2, 4.
* M. Kashiwara, *On crystal bases*, CMS Conf. Proc. 16 (1995), §7.
-/

public section

namespace TauCeti

open Module Relation RootPairing Set
open scoped TensorProduct

section Realization

variable {ι X Y 𝕜 V : Type*} [AddCommGroup X] [AddCommGroup Y]
  {P : RootDatum ι X Y} {b : P.Base} [Finite ι] [P.IsReduced] {lam : X}
  [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] [AddCommGroup V] [Module 𝕜 V]
  {f : X →+ V} {F : b.support → Dual 𝕜 V}

namespace LSPath

/-- **Faithfulness of realized LS paths from simple-coroot height forms alone.** When the forms
`F i` induce the simple coroots on `f(X)`, `f` is automatically injective on `W λ` and no two
distinct realized orbit weights lie on a common ray, so `π ↦ π.toPLPath 𝕜 f` is injective on
`LSPath P b λ`. -/
theorem toPLPath_injective_of_coroot' (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    Function.Injective (fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f) :=
  toPLPath_injective hlam (P.injOn_range_smul_of_coroot' b hF lam)
    (P.pairwise_not_sameRay_range_smul_of_coroot' b hF lam)

theorem toPLPath_inj_of_coroot' (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {π π' : LSPath P b lam} :
    π.toPLPath 𝕜 f = π'.toPLPath 𝕜 f ↔ π = π' :=
  (toPLPath_injective_of_coroot' hlam hF).eq_iff

/-- **The realized Lakshmibai–Seshadri paths of dominant shape `λ` form a crystal-admissible set.**
No global injectivity assumption on `f` is required. -/
theorem isCrystalSet_range_toPLPath (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    PLPath.IsCrystalSet b f F (range fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f) where
  endpoint_mem_range := by
    rintro _ ⟨π, rfl⟩
    obtain ⟨m, -, hm⟩ := π.exists_mem_rootSpan_endpoint_eq_add (𝕜 := 𝕜) hlam f
    exact ⟨_, hm.symm⟩
  exists_minHeight_eq_intCast := by
    rintro _ ⟨π, rfl⟩ i
    have := P.flip_isReduced
    exact π.exists_minHeight_eq_intCast hlam f i (F i) (hF i)
  mem_of_raise_eq_some := by
    rintro i _ q hr ⟨π, rfl⟩
    exact π.exists_toPLPath_eq_of_raise_eq_some hlam f i (F i) (hF i) hr
  mem_of_lower_eq_some := by
    rintro i _ q hl ⟨π, rfl⟩
    exact π.exists_toPLPath_eq_of_lower_eq_some hlam f i (F i) (hF i) hl

/-- **Every realized Lakshmibai–Seshadri path of dominant shape is an integral path.** -/
theorem isIntegralPath_toPLPath (π : LSPath P b lam) (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    PLPath.IsIntegralPath b f F (π.toPLPath 𝕜 f) :=
  (isCrystalSet_range_toPLPath hlam hF).subset_isIntegralPath ⟨π, rfl⟩

end LSPath

/-- **Every straight path along a dominant weight is an integral path.** -/
theorem PLPath.isIntegralPath_straight_of_mem_dominantChamber (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    PLPath.IsIntegralPath b f F (PLPath.straight 𝕜 (f lam)) := by
  rw [← LSPath.toPLPath_straight (P := P) (b := b)]
  exact (LSPath.straight lam).isIntegralPath_toPLPath hlam hF

end Realization

namespace LSPath

section CanonicalRealization

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
  {P : RootDatum ι X Y} {b : P.Base}

/-- Canonical injective realization `x ↦ 1 ⊗ x` of `X` in `ℚ ⊗[ℤ] X`, requiring no freeness or
finite-generation hypothesis on `Y`. -/
private noncomputable def ratEmbed (X : Type*) [AddCommGroup X] : X →+ (ℚ ⊗[ℤ] X) :=
  (TensorProduct.mk ℤ ℚ X 1).toAddMonoidHom

private theorem ratEmbed_apply (x : X) : ratEmbed X x = 1 ⊗ₜ[ℤ] x :=
  (rfl)

private theorem ratEmbed_injective (P : RootDatum ι X Y) : Function.Injective (ratEmbed X) :=
  P.tensorProduct_mk_injective ℚ

/-- Canonical `ℚ`-linear height forms on `ℚ ⊗[ℤ] X` extending the simple coroots. -/
private noncomputable def ratHeight (b : P.Base) (i : b.support) : Dual ℚ (ℚ ⊗[ℤ] X) :=
  LinearMap.liftBaseChange ℚ ((Algebra.linearMap ℤ ℚ).comp (P.coroot' i.1))

private theorem ratHeight_apply (i : b.support) (x : X) :
    ratHeight b i (ratEmbed X x) = (P.coroot' i x : ℚ) := by
  simp [ratHeight, ratEmbed, Algebra.linearMap_apply]

end CanonicalRealization

section Model

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
  {P : RootDatum ι X Y} {b : P.Base} [Finite ι] [P.IsReduced] {lam : X}

private noncomputable def ratRangeEquiv (hlam : lam ∈ dominantChamber P b) :
    LSPath P b lam ≃ range (fun π : LSPath P b lam ↦ π.toPLPath ℚ (ratEmbed X)) :=
  Equiv.ofInjective _ (toPLPath_injective_of_coroot' hlam ratHeight_apply)

@[simp]
private theorem coe_ratRangeEquiv (hlam : lam ∈ dominantChamber P b) (π : LSPath P b lam) :
    (ratRangeEquiv hlam π).1 = π.toPLPath ℚ (ratEmbed X) :=
  (rfl)

/-- **The Lakshmibai–Seshadri normal crystal `B(λ)`** on `LSPath P b λ` for a dominant weight `λ`.
It is intrinsic to `(P, b, λ)` and requires no choice of ambient vector-space realization; every
realization `(𝕜, V, f, F)` whose height forms induce the simple coroots agrees with its weights,
root operators, and string lengths (`TauCeti.LSPath.endpoint_toPLPath_eq_apply_wt`,
`TauCeti.LSPath.raise_toPLPath_eq_map`, `TauCeti.LSPath.lower_toPLPath_eq_map`). -/
noncomputable def normalCrystal (hlam : lam ∈ dominantChamber P b) :
    NormalCrystal P b (LSPath P b lam) :=
  (PLPath.normalCrystalOn (ratEmbed_injective P) ratHeight_apply
    (isCrystalSet_range_toPLPath hlam ratHeight_apply)).transport (ratRangeEquiv hlam).symm

section Compatibility

variable {𝕜 V : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜]
  [AddCommGroup V] [Module 𝕜 V]

/-- **Endpoint-weight compatibility**: in any realization `f : X →+ V`, the endpoint of
`π.toPLPath 𝕜 f` is `f` applied to the crystal weight `(normalCrystal hlam).wt π`. -/
theorem endpoint_toPLPath_eq_apply_wt (hlam : lam ∈ dominantChamber P b) (f : X →+ V)
    (π : LSPath P b lam) :
    (π.toPLPath 𝕜 f).endpoint = f ((normalCrystal hlam).wt π) := by
  let B : ℚ →ₗ[ℤ] X →ₗ[ℤ] V :=
    { toFun q :=
        { toFun x := (q : 𝕜) • f x
          map_add' x y := by simp [smul_add]
          map_smul' n x := by simp [smul_comm (q : 𝕜) n] }
      map_add' p q := by ext x; simp [add_smul]
      map_smul' n q := by
        ext x
        simp only [RingHom.id_apply, LinearMap.coe_mk, AddHom.coe_mk, LinearMap.smul_apply,
          zsmul_eq_mul, Rat.cast_mul, Rat.cast_intCast, mul_smul, Int.cast_smul_eq_zsmul] }
  let L : (ℚ ⊗[ℤ] X) →ₗ[ℤ] V := TensorProduct.lift B
  have hL_tmul (q : ℚ) (x : X) : L (q ⊗ₜ[ℤ] x) = (q : 𝕜) • f x := TensorProduct.lift.tmul q x
  have hrat : ratEmbed X ((normalCrystal hlam).wt π) = (π.toPLPath ℚ (ratEmbed X)).endpoint := by
    simp [normalCrystal]
  have hLHS : L (ratEmbed X ((normalCrystal hlam).wt π)) = f ((normalCrystal hlam).wt π) := by
    simp [ratEmbed_apply, hL_tmul]
  have hRHS : L (π.toPLPath ℚ (ratEmbed X)).endpoint = (π.toPLPath 𝕜 f).endpoint := by
    rw [endpoint_toPLPath, endpoint_toPLPath, map_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [ratEmbed_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one, hL_tmul, Rat.cast_id]
  rw [← hRHS, ← hrat, hLHS]

theorem normalCrystal_wt_eq_iff (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    (hf : Function.Injective f) {π : LSPath P b lam} {μ : X} :
    (normalCrystal hlam).wt π = μ ↔ (π.toPLPath 𝕜 f).endpoint = f μ := by
  rw [← hf.eq_iff, endpoint_toPLPath_eq_apply_wt (𝕜 := 𝕜) hlam f π]

/-- **Realization compatibility for raising**: in any realization `(f, F)` agreeing with the simple
coroots, Littelmann's path raising operator computes `(normalCrystal hlam).e`. -/
theorem raise_toPLPath_eq_map (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    {F : b.support → Dual 𝕜 V}
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (i : b.support) (π : LSPath P b lam) :
    PLPath.raise (F i) (f (P.root i)) (π.toPLPath 𝕜 f) =
      ((normalCrystal hlam).e i π).map (fun π' ↦ π'.toPLPath 𝕜 f) := by
  have he_rat {π' : LSPath P b lam} :
      (normalCrystal hlam).e i π = some π' ↔
        PLPath.raise (ratHeight b i) (ratEmbed X (P.root i)) (π.toPLPath ℚ (ratEmbed X)) =
          some (π'.toPLPath ℚ (ratEmbed X)) := by
    simp only [normalCrystal, NormalCrystal.transport_e, Equiv.symm_symm, Option.map_eq_some_iff]
    constructor
    · rintro ⟨q, hq, rfl⟩
      have hq' := PLPath.normalCrystalOn_e_eq_some_iff.mp hq
      rw [coe_ratRangeEquiv] at hq'
      rwa [← coe_ratRangeEquiv hlam ((ratRangeEquiv hlam).symm q),
        (ratRangeEquiv hlam).apply_symm_apply]
    · intro hq
      exact ⟨ratRangeEquiv hlam π', PLPath.normalCrystalOn_e_eq_some_iff.mpr hq,
        (ratRangeEquiv hlam).symm_apply_apply π'⟩
  cases he : (normalCrystal hlam).e i π with
  | none =>
    rw [Option.map_none]
    by_contra hne
    obtain ⟨q, hq⟩ := Option.ne_none_iff_exists'.mp hne
    obtain ⟨π', -, hπ'⟩ := π.exists_toPLPath_eq_and_raise_eq_some hlam f i (F i) (hF i) hq
      (ratEmbed X) (ratHeight b i) (ratHeight_apply i)
    exact Option.some_ne_none _ ((he_rat.mpr hπ').symm.trans he)
  | some π' =>
    rw [Option.map_some]
    obtain ⟨π'', hπ'', hlow⟩ := π.exists_toPLPath_eq_and_raise_eq_some hlam
      (ratEmbed X) i (ratHeight b i) (ratHeight_apply i) (he_rat.mp he) f (F i) (hF i)
    obtain rfl := toPLPath_injective_of_coroot' hlam ratHeight_apply hπ''
    exact hlow

/-- **Realization compatibility for lowering**: in any realization `(f, F)` agreeing with the simple
coroots, Littelmann's path lowering operator computes `(normalCrystal hlam).f`. -/
theorem lower_toPLPath_eq_map (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    {F : b.support → Dual 𝕜 V}
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (i : b.support) (π : LSPath P b lam) :
    PLPath.lower (F i) (f (P.root i)) (π.toPLPath 𝕜 f) =
      ((normalCrystal hlam).f i π).map (fun π' ↦ π'.toPLPath 𝕜 f) := by
  have hf_rat {π' : LSPath P b lam} :
      (normalCrystal hlam).f i π = some π' ↔
        PLPath.lower (ratHeight b i) (ratEmbed X (P.root i)) (π.toPLPath ℚ (ratEmbed X)) =
          some (π'.toPLPath ℚ (ratEmbed X)) := by
    simp only [normalCrystal, NormalCrystal.transport_f, Equiv.symm_symm, Option.map_eq_some_iff]
    constructor
    · rintro ⟨q, hq, rfl⟩
      have hq' := PLPath.normalCrystalOn_f_eq_some_iff.mp hq
      rw [coe_ratRangeEquiv] at hq'
      rwa [← coe_ratRangeEquiv hlam ((ratRangeEquiv hlam).symm q),
        (ratRangeEquiv hlam).apply_symm_apply]
    · intro hq
      exact ⟨ratRangeEquiv hlam π', PLPath.normalCrystalOn_f_eq_some_iff.mpr hq,
        (ratRangeEquiv hlam).symm_apply_apply π'⟩
  cases hf_eq : (normalCrystal hlam).f i π with
  | none =>
    rw [Option.map_none]
    by_contra hne
    obtain ⟨q, hq⟩ := Option.ne_none_iff_exists'.mp hne
    obtain ⟨π', -, hπ'⟩ := π.exists_toPLPath_eq_and_lower_eq_some hlam f i (F i) (hF i) hq
      (ratEmbed X) (ratHeight b i) (ratHeight_apply i)
    exact Option.some_ne_none _ ((hf_rat.mpr hπ').symm.trans hf_eq)
  | some π' =>
    rw [Option.map_some]
    obtain ⟨π'', hπ'', hlow⟩ := π.exists_toPLPath_eq_and_lower_eq_some hlam
      (ratEmbed X) i (ratHeight b i) (ratHeight_apply i) (hf_rat.mp hf_eq) f (F i) (hF i)
    obtain rfl := toPLPath_injective_of_coroot' hlam ratHeight_apply hπ''
    exact hlow

theorem normalCrystal_e_eq_some_iff (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    {F : b.support → Dual 𝕜 V}
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {i : b.support} {π π' : LSPath P b lam} :
    (normalCrystal hlam).e i π = some π' ↔
      PLPath.raise (F i) (f (P.root i)) (π.toPLPath 𝕜 f) = some (π'.toPLPath 𝕜 f) := by
  rw [raise_toPLPath_eq_map hlam hF, Option.map_eq_some_iff]
  exact ⟨fun h ↦ ⟨π', h, rfl⟩, fun ⟨ρ, hρ, heq⟩ ↦
    toPLPath_injective_of_coroot' hlam hF heq ▸ hρ⟩

theorem normalCrystal_f_eq_some_iff (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    {F : b.support → Dual 𝕜 V}
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {i : b.support} {π π' : LSPath P b lam} :
    (normalCrystal hlam).f i π = some π' ↔
      PLPath.lower (F i) (f (P.root i)) (π.toPLPath 𝕜 f) = some (π'.toPLPath 𝕜 f) := by
  rw [lower_toPLPath_eq_map hlam hF, Option.map_eq_some_iff]
  exact ⟨fun h ↦ ⟨π', h, rfl⟩, fun ⟨ρ, hρ, heq⟩ ↦
    toPLPath_injective_of_coroot' hlam hF heq ▸ hρ⟩

theorem normalCrystal_e_eq_none_iff (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    {F : b.support → Dual 𝕜 V}
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {i : b.support} {π : LSPath P b lam} :
    (normalCrystal hlam).e i π = none ↔
      PLPath.raise (F i) (f (P.root i)) (π.toPLPath 𝕜 f) = none := by
  rw [raise_toPLPath_eq_map hlam hF, Option.map_eq_none_iff]

theorem normalCrystal_f_eq_none_iff (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    {F : b.support → Dual 𝕜 V}
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {i : b.support} {π : LSPath P b lam} :
    (normalCrystal hlam).f i π = none ↔
      PLPath.lower (F i) (f (P.root i)) (π.toPLPath 𝕜 f) = none := by
  rw [lower_toPLPath_eq_map hlam hF, Option.map_eq_none_iff]

theorem raiseIter_toPLPath_eq_map (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    {F : b.support → Dual 𝕜 V}
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (i : b.support) (n : ℕ) (π : LSPath P b lam) :
    PLPath.raiseIter (F i) (f (P.root i)) n (π.toPLPath 𝕜 f) =
      ((normalCrystal hlam).eIter i n π).map (fun π' ↦ π'.toPLPath 𝕜 f) := by
  induction n generalizing π with
  | zero => simp
  | succ n ih =>
    rw [PLPath.raiseIter_succ, NormalCrystal.eIter_succ, raise_toPLPath_eq_map hlam hF]
    cases (normalCrystal hlam).e i π <;> simp [ih]

theorem lowerIter_toPLPath_eq_map (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    {F : b.support → Dual 𝕜 V}
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (i : b.support) (n : ℕ) (π : LSPath P b lam) :
    PLPath.lowerIter (F i) (f (P.root i)) n (π.toPLPath 𝕜 f) =
      ((normalCrystal hlam).fIter i n π).map (fun π' ↦ π'.toPLPath 𝕜 f) := by
  induction n generalizing π with
  | zero => simp
  | succ n ih =>
    rw [PLPath.lowerIter_succ, NormalCrystal.fIter_succ, lower_toPLPath_eq_map hlam hF]
    cases (normalCrystal hlam).f i π <;> simp [ih]

theorem raiseWord_toPLPath_eq_map (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    {F : b.support → Dual 𝕜 V}
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (w : List b.support) (π : LSPath P b lam) :
    PLPath.raiseWord F (fun i ↦ f (P.root i)) w (π.toPLPath 𝕜 f) =
      ((normalCrystal hlam).eWord w π).map (fun π' ↦ π'.toPLPath 𝕜 f) := by
  induction w generalizing π with
  | nil => simp
  | cons i w ih =>
    rw [PLPath.raiseWord_cons, NormalCrystal.eWord_cons, raise_toPLPath_eq_map hlam hF]
    cases (normalCrystal hlam).e i π <;> simp [ih]

theorem lowerWord_toPLPath_eq_map (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    {F : b.support → Dual 𝕜 V}
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (w : List b.support) (π : LSPath P b lam) :
    PLPath.lowerWord F (fun i ↦ f (P.root i)) w (π.toPLPath 𝕜 f) =
      ((normalCrystal hlam).fWord w π).map (fun π' ↦ π'.toPLPath 𝕜 f) := by
  induction w generalizing π with
  | nil => simp
  | cons i w ih =>
    rw [PLPath.lowerWord_cons, NormalCrystal.fWord_cons, lower_toPLPath_eq_map hlam hF]
    cases (normalCrystal hlam).f i π <;> simp [ih]

/-- **Realization compatibility for `ε_i`**: `-(π.toPLPath 𝕜 f).minHeight (F i)` equals the
intrinsic crystal string length `(normalCrystal hlam).ε i π` in every compatible realization. -/
theorem minHeight_toPLPath_eq_neg_ε (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    {F : b.support → Dual 𝕜 V}
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (i : b.support) (π : LSPath P b lam) :
    (π.toPLPath 𝕜 f).minHeight (F i) = -((normalCrystal hlam).ε i π : 𝕜) := by
  have := P.flip_isReduced
  obtain ⟨ε', -, hε', -⟩ :=
    π.exists_neg_minHeight_eq_natCast_and_apply_endpoint_sub_minHeight_eq_natCast hlam f i (F i)
      (hF i)
  have hisSome (n : ℕ) : n ≤ (normalCrystal hlam).ε i π ↔ n ≤ ε' := by
    rw [← (normalCrystal hlam).isSome_eIter_iff, ← Option.isSome_map
      (f := fun π' : LSPath P b lam ↦ π'.toPLPath 𝕜 f), ← raiseIter_toPLPath_eq_map hlam hF,
      PLPath.isSome_raiseIter_iff_of_eq_natCast (PLPath.apply_root_eq_two hF i) hε']
  have h_eq : (normalCrystal hlam).ε i π = ε' :=
    le_antisymm ((hisSome _).mp le_rfl) ((hisSome _).mpr le_rfl)
  rw [h_eq, ← hε', neg_neg]

/-- **Realization compatibility for `φ_i`**: `F i (π.toPLPath 𝕜 f).endpoint - minHeight` equals the
intrinsic crystal string length `(normalCrystal hlam).φ i π` in every compatible realization. -/
theorem endpoint_sub_minHeight_toPLPath_eq_φ (hlam : lam ∈ dominantChamber P b) {f : X →+ V}
    {F : b.support → Dual 𝕜 V}
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (i : b.support) (π : LSPath P b lam) :
    F i (π.toPLPath 𝕜 f).endpoint - (π.toPLPath 𝕜 f).minHeight (F i) =
      ((normalCrystal hlam).φ i π : 𝕜) := by
  have hrel := (normalCrystal hlam).φ_sub_ε i π
  rw [endpoint_toPLPath_eq_apply_wt hlam f π, hF, minHeight_toPLPath_eq_neg_ε hlam hF]
  have hrel' : ((normalCrystal hlam).φ i π : 𝕜) - (normalCrystal hlam).ε i π =
      (P.coroot' i ((normalCrystal hlam).wt π) : 𝕜) := by
    exact_mod_cast hrel
  linarith

/-- **Strict crystal isomorphism from `LSPath.normalCrystal` onto the realized path crystal** in
any injective realization `(f, F)`. -/
noncomputable def toPLPathIso (hlam : lam ∈ dominantChamber P b)
    {f : X →+ V} {F : b.support → Dual 𝕜 V} (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    NormalCrystal.StrictIso (normalCrystal hlam)
      (PLPath.normalCrystalOn hf hF (isCrystalSet_range_toPLPath hlam hF)) where
  toEquiv := Equiv.ofInjective _ (toPLPath_injective_of_coroot' hlam hF)
  wt_toFun π := hf (by
    rw [PLPath.apply_normalCrystalOn_wt]
    exact endpoint_toPLPath_eq_apply_wt hlam f π)
  e_toFun i π := PLPath.normalCrystalOn_e_eq_map_iff.mpr (raise_toPLPath_eq_map hlam hF i π)

@[simp]
theorem toPLPathIso_apply (hlam : lam ∈ dominantChamber P b)
    {f : X →+ V} {F : b.support → Dual 𝕜 V} (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (π : LSPath P b lam) :
    (toPLPathIso hlam hf hF π).1 = π.toPLPath 𝕜 f := by
  simp [toPLPathIso]

/-- **Strict crystal embedding of `LSPath.normalCrystal` into Littelmann's ambient crystal of
integral paths** in any injective realization `(f, F)`. -/
noncomputable def toPLPathHom (hlam : lam ∈ dominantChamber P b)
    {f : X →+ V} {F : b.support → Dual 𝕜 V} (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    NormalCrystal.StrictHom (normalCrystal hlam) (PLPath.normalCrystal hf hF) :=
  (PLPath.embedHom (hf := hf) (hF := hF) (isCrystalSet_range_toPLPath hlam hF)).comp
    (toPLPathIso hlam hf hF).toStrictHom

@[simp]
theorem toPLPathHom_apply (hlam : lam ∈ dominantChamber P b)
    {f : X →+ V} {F : b.support → Dual 𝕜 V} (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (π : LSPath P b lam) :
    (toPLPathHom hlam hf hF π).1 = π.toPLPath 𝕜 f := by
  simp [toPLPathHom]

end Compatibility

/-! ### Highest-weight generation, connectedness, and straight-path component equivalence -/

/-- The straight LS path of dominant shape `λ` has crystal weight `λ`. -/
@[simp]
theorem normalCrystal_wt_straight (hlam : lam ∈ dominantChamber P b) :
    (normalCrystal hlam).wt (straight lam) = lam := by
  apply ratEmbed_injective P
  rw [← endpoint_toPLPath_eq_apply_wt (𝕜 := ℚ) hlam (ratEmbed X), toPLPath_straight,
    PLPath.endpoint_straight]

/-- **Uniqueness of the highest element in `B(λ)`**: `straight λ` is the unique LS path of dominant
shape `λ` annihilated by all simple-root crystal raising operators. -/
theorem forall_normalCrystal_e_eq_none_iff (hlam : lam ∈ dominantChamber P b)
    {π : LSPath P b lam} :
    (∀ i, (normalCrystal hlam).e i π = none) ↔ π = straight lam := by
  have := P.flip_isReduced
  simp only [normalCrystal_e_eq_none_iff hlam ratHeight_apply]
  exact π.forall_raise_eq_none_iff hlam (ratEmbed X) (ratHeight b) ratHeight_apply

/-- **Generation of `B(λ)` by lowering from the straight path**: every Lakshmibai–Seshadri path of
dominant shape `λ` is obtained from `straight λ` by a word of crystal lowering operators. -/
theorem exists_fWord_straight_eq_some (hlam : lam ∈ dominantChamber P b)
    (π : LSPath P b lam) :
    ∃ w : List b.support, (normalCrystal hlam).fWord w (straight lam) = some π := by
  have := P.flip_isReduced
  have := finite hlam
  exact (normalCrystal hlam).exists_fWord_eq_some_of_unique_highest
    (fun _ hx ↦ (forall_normalCrystal_e_eq_none_iff hlam).mp hx) π

/-- **Connectedness of the Lakshmibai–Seshadri crystal graph**: `normalCrystal hlam` has a single
connected component. -/
theorem connected_normalCrystal_graph (hlam : lam ∈ dominantChamber P b) :
    (normalCrystal hlam).graph.Connected := by
  rw [SimpleGraph.connected_iff_exists_forall_reachable]
  refine ⟨straight lam, fun π ↦ ?_⟩
  obtain ⟨w, hw⟩ := exists_fWord_straight_eq_some hlam π
  have hwalk : ∀ (u : List b.support) (x y : LSPath P b lam),
      (normalCrystal hlam).fWord u x = some y →
        (normalCrystal hlam).graph.Reachable x y := by
    intro u
    induction u with
    | nil =>
      intro x y h
      rw [NormalCrystal.fWord_nil, Option.some.injEq] at h
      exact h ▸ .rfl
    | cons i u ih =>
      intro x y h
      rw [NormalCrystal.fWord_cons, Option.bind_eq_some_iff] at h
      obtain ⟨z, hz, hu⟩ := h
      exact ((normalCrystal hlam).graph_adj_of_f_eq_some hz).reachable.trans (ih z y hu)
  exact hwalk w (straight lam) π hw

section ComponentEquivalence

variable {𝕜 V : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜]
  [AddCommGroup V] [Module 𝕜 V] {f : X →+ V} {F : b.support → Dual 𝕜 V}

omit [Finite ι] [P.IsReduced] in
private theorem reflTransGen_rootStep_of_lowerWord_eq_some {w : List b.support}
    {p q : PLPath 𝕜 V} (hw : PLPath.lowerWord F (fun i ↦ f (P.root i)) w p = some q) :
    ReflTransGen (PLPath.RootStep b f F) p q := by
  induction w generalizing p with
  | nil =>
    rw [PLPath.lowerWord_nil, Option.some.injEq] at hw
    exact hw ▸ .refl
  | cons i w ih =>
    rw [PLPath.lowerWord_cons, Option.bind_eq_some_iff] at hw
    obtain ⟨r, hr, hw⟩ := hw
    exact .head (.of_lower_eq_some hr) (ih hw)

/-- **Littelmann's pure-lowering characterization of LS paths**: a piecewise-linear path in a
compatible realization `(f, F)` is the path of an LS encoding of dominant shape `λ` if and only if
it is obtained from the straight path `t ↦ t • f λ` by a word of lowering operators `f_{α_i}`. -/
theorem mem_range_toPLPath_iff_exists_lowerWord (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {q : PLPath 𝕜 V} :
    q ∈ range (fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f) ↔
      ∃ w : List b.support,
        PLPath.lowerWord F (fun i ↦ f (P.root i)) w (PLPath.straight 𝕜 (f lam)) = some q := by
  constructor
  · rintro ⟨π, rfl⟩
    obtain ⟨w, hw⟩ := exists_fWord_straight_eq_some hlam π
    refine ⟨w, ?_⟩
    rw [← toPLPath_straight (P := P) (b := b) 𝕜 f, lowerWord_toPLPath_eq_map hlam hF, hw,
      Option.map_some]
  · rintro ⟨w, hw⟩
    exact (isCrystalSet_range_toPLPath hlam hF).mem_of_reflTransGen_rootStep
      (reflTransGen_rootStep_of_lowerWord_eq_some hw) ⟨straight lam, toPLPath_straight 𝕜 f⟩

/-- **Littelmann's component characterization of LS paths**: a piecewise-linear path in a compatible
realization `(f, F)` is the path of an LS encoding of dominant shape `λ` if and only if it is
reachable from `PLPath.straight 𝕜 (f λ)` by a finite sequence of raising and lowering steps. -/
theorem mem_range_toPLPath_iff_reflTransGen_rootStep (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {q : PLPath 𝕜 V} :
    q ∈ range (fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f) ↔
      ReflTransGen (PLPath.RootStep b f F) (PLPath.straight 𝕜 (f lam)) q := by
  constructor
  · intro hq
    obtain ⟨w, hw⟩ := (mem_range_toPLPath_iff_exists_lowerWord hlam hF).mp hq
    exact reflTransGen_rootStep_of_lowerWord_eq_some hw
  · intro hwalk
    exact (isCrystalSet_range_toPLPath hlam hF).mem_of_reflTransGen_rootStep hwalk
      ⟨straight lam, toPLPath_straight 𝕜 f⟩

/-- The underlying paths in the connected component of `PLPath.straight 𝕜 (f λ)` in
`PLPath.normalCrystal hf hF` are precisely the realized LS paths of shape `λ`. -/
theorem image_val_supp_connectedComponentMk_straight (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    Subtype.val ''
        (((PLPath.normalCrystal hf hF).graph.connectedComponentMk
          ⟨PLPath.straight 𝕜 (f lam),
            PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩).supp) =
      range (fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f) := by
  ext q
  simp only [mem_image, PLPath.mem_supp_connectedComponentMk_normalCrystalOn_iff,
    mem_range_toPLPath_iff_reflTransGen_rootStep hlam hF]
  exact ⟨fun ⟨_, hx, hxq⟩ ↦ hxq ▸ hx, fun hq ↦
    ⟨⟨q, (PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF).of_reflTransGen_rootStep
      hq⟩, hq, rfl⟩⟩

private noncomputable def toComponentFun (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (π : LSPath P b lam) :
    (PLPath.normalCrystal hf hF).graph.connectedComponentMk
      ⟨PLPath.straight 𝕜 (f lam),
        PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩ :=
  ⟨toPLPathHom hlam hf hF π,
    (PLPath.mem_supp_connectedComponentMk_normalCrystalOn_iff _ _).mpr
      ((mem_range_toPLPath_iff_reflTransGen_rootStep hlam hF).mp
        (mem_range.mpr ⟨π, (toPLPathHom_apply hlam hf hF π).symm⟩))⟩

private theorem bijective_toComponentFun (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    Function.Bijective (toComponentFun hlam hf hF) := by
  refine ⟨fun π₁ π₂ h ↦ ?_, fun ⟨y, hy⟩ ↦ ?_⟩
  · exact toPLPath_injective_of_coroot' hlam hF
      (by simpa [toComponentFun] using congrArg (fun z ↦ z.1.1) h)
  · obtain ⟨π, hπ⟩ := (mem_range_toPLPath_iff_reflTransGen_rootStep hlam hF).mpr
      ((PLPath.mem_supp_connectedComponentMk_normalCrystalOn_iff _ y).mp hy)
    exact ⟨π, Subtype.ext (Subtype.ext (by simpa [toComponentFun] using hπ))⟩

/-- **Equivalence of `LSPath.normalCrystal` with the operator-generated straight-path component**:
in any injective realization `(f, F)`, `π ↦ π.toPLPath 𝕜 f` is a strict crystal isomorphism from
`LSPath.normalCrystal hlam` onto the connected component of `PLPath.straight 𝕜 (f λ)` in
`PLPath.normalCrystal hf hF`. -/
noncomputable def toComponentIso (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    NormalCrystal.StrictIso (normalCrystal hlam)
      (PLPath.normalCrystalComponent hf hF
        ⟨PLPath.straight 𝕜 (f lam),
          PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩) where
  toEquiv := Equiv.ofBijective (toComponentFun hlam hf hF) (bijective_toComponentFun hlam hf hF)
  wt_toFun π := by
    dsimp only [PLPath.normalCrystalComponent]
    rw [NormalCrystal.component_eq_restrict, NormalCrystal.restrict_wt]
    exact (toPLPathHom hlam hf hF).wt_apply π
  e_toFun i π := by
    simp only [Equiv.toFun_as_coe, Equiv.coe_ofBijective]
    apply Option.map_injective Subtype.val_injective
    rw [Option.map_map]
    dsimp only [PLPath.normalCrystalComponent]
    change (((PLPath.normalCrystal hf hF).component _).e i
        (toComponentFun hlam hf hF π)).unattach =
      ((normalCrystal hlam).e i π).map (toPLPathHom hlam hf hF)
    rw [NormalCrystal.component_eq_restrict, NormalCrystal.unattach_restrict_e]
    exact (toPLPathHom hlam hf hF).e_apply i π

@[simp]
theorem toComponentIso_apply (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (π : LSPath P b lam) :
    (toComponentIso hlam hf hF π).1.1 = π.toPLPath 𝕜 f := by
  simp [toComponentIso, toComponentFun]

end ComponentEquivalence

/-! ### Contragredient crystal duality -/

/-- **Contragredient duality of Lakshmibai–Seshadri crystals**: LS-path duality
`TauCeti.LSPath.dualEquiv` is a strict crystal isomorphism from the dual crystal
`(normalCrystal hlam).dual` of `B(λ)` to `B(-w₀ λ)`. -/
noncomputable def dualIso (hlam : lam ∈ dominantChamber P b) :
    NormalCrystal.StrictIso (normalCrystal hlam).dual
      (normalCrystal (neg_smul_mem_dominantChamber_longestElement_int hlam)) where
  toEquiv := dualEquiv hlam
  wt_toFun π := by
    simp only [Equiv.toFun_as_coe, dualEquiv_apply]
    apply ratEmbed_injective P
    rw [← endpoint_toPLPath_eq_apply_wt (𝕜 := ℚ) _ (ratEmbed X), endpoint_toPLPath_dual,
      endpoint_toPLPath_eq_apply_wt (𝕜 := ℚ) hlam (ratEmbed X), NormalCrystal.dual_wt, map_neg]
  e_toFun i π := by
    have hlam' := neg_smul_mem_dominantChamber_longestElement_int hlam
    simp only [Equiv.toFun_as_coe]
    apply Option.map_injective
      (toPLPath_injective_of_coroot' hlam' (ratHeight_apply (P := P) (b := b)))
    rw [← raise_toPLPath_eq_map hlam' ratHeight_apply, dualEquiv_apply, toPLPath_dual,
      PLPath.raise_reverse, lower_toPLPath_eq_map hlam ratHeight_apply, Option.map_map,
      Option.map_map, NormalCrystal.dual_e]
    congr 1
    ext ρ
    simp

@[simp]
theorem dualIso_apply (hlam : lam ∈ dominantChamber P b) (π : LSPath P b lam) :
    dualIso hlam π = π.dual hlam := by
  simp [dualIso]

@[simp]
theorem dualIso_symm_apply (hlam : lam ∈ dominantChamber P b)
    (ρ : LSPath P b (-(longestElement P b • lam))) :
    (dualIso hlam).symm ρ = (dualEquiv hlam).symm ρ := by
  apply (dualIso hlam).toEquiv.injective
  simp [← dualEquiv_apply]

end Model

