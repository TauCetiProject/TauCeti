section CrystalAdmissibility

variable {ι X Y 𝕜 V : Type*} [AddCommGroup X] [AddCommGroup Y]
  {P : RootDatum ι X Y} {b : P.Base} [Finite ι] [P.IsReduced] {lam : X}
  [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] [AddCommGroup V] [Module 𝕜 V]
  {f : X →+ V} {F : b.support → Dual 𝕜 V}

/-- **Realized Lakshmibai–Seshadri paths of dominant shape form a crystal-admissible set.** No
injectivity assumption on `f` is needed beyond agreement of the height forms `F` with the simple
coroots on `f(X)`. -/
theorem LSPath.isCrystalSet_range_toPLPath (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    PLPath.IsCrystalSet b f F (range fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f) where
  endpoint_mem_range := by
    rintro _ ⟨π, rfl⟩
    obtain ⟨m, -, hm⟩ := π.exists_mem_rootSpan_endpoint_eq_add (𝕜 := 𝕜) hlam f
    exact ⟨_, hm.symm⟩
  exists_minHeight_eq_intCast := by
    have := P.flip_isReduced
    rintro _ ⟨π, rfl⟩ i
    exact π.exists_minHeight_eq_intCast hlam f i (F i) (hF i)
  mem_of_raise_eq_some := by
    have := P.flip_isReduced
    rintro i _ q hq ⟨π, rfl⟩
    exact π.exists_toPLPath_eq_of_raise_eq_some hlam f i (F i) (hF i) hq
  mem_of_lower_eq_some := by
    have := P.flip_isReduced
    rintro i _ q hq ⟨π, rfl⟩
    exact π.exists_toPLPath_eq_of_lower_eq_some hlam f i (F i) (hF i) hq

/-- Every realized Lakshmibai–Seshadri path of dominant shape is an integral path in Littelmann's
sense. -/
theorem LSPath.isIntegralPath_toPLPath (π : LSPath P b lam) (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    PLPath.IsIntegralPath b f F (π.toPLPath 𝕜 f) :=
  (LSPath.isCrystalSet_range_toPLPath hlam hF).subset_isIntegralPath ⟨π, rfl⟩

/-- **Every straight path along a dominant weight is an integral path.** -/
theorem PLPath.isIntegralPath_straight_of_mem_dominantChamber (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    PLPath.IsIntegralPath b f F (PLPath.straight 𝕜 (f lam)) := by
  rw [← LSPath.toPLPath_straight (P := P) (b := b) (lam := lam) 𝕜 f]
  exact (LSPath.straight lam).isIntegralPath_toPLPath hlam hF

end CrystalAdmissibility

namespace LSPath

section NormalCrystal

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
  {P : RootDatum ι X Y} {b : P.Base} [Finite ι] [P.IsReduced] {lam : X}

/-- **The canonical normal crystal of Lakshmibai–Seshadri paths of dominant shape `λ`**, requiring
no choice of ordered-field realization or finite-free coweight hypothesis. -/
noncomputable def normalCrystal (hlam : lam ∈ dominantChamber P b) :
    NormalCrystal P b (LSPath P b lam) :=
  let f₀ : X →+ ℚ ⊗[ℤ] X := (TensorProduct.mk ℤ ℚ X 1).toAddMonoidHom
  let F₀ : b.support → Dual ℚ (ℚ ⊗[ℤ] X) :=
    fun i ↦ ((Algebra.linearMap ℤ ℚ).comp (P.coroot' i.1)).liftBaseChange ℚ
  have hF₀ : ∀ (i : b.support) (x : X), F₀ i (f₀ x) = (P.coroot' i x : ℚ) := fun i x ↦ by
    simp [f₀, F₀]
  (PLPath.normalCrystalOn (P.tensorProduct_mk_injective ℚ) hF₀
      (isCrystalSet_range_toPLPath hlam hF₀)).transport
    (Equiv.ofInjective (fun π : LSPath P b lam ↦ π.toPLPath ℚ f₀)
      (toPLPath_injective_of_coroot' hlam hF₀)).symm

section UniversalRealization

variable {𝕜 V : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜]
  [AddCommGroup V] [Module 𝕜 V]

/-- For *any* additive realization `f : X →+ V` into a vector space over a linearly ordered field
`𝕜`, the image of `(normalCrystal hlam).wt π` is the endpoint of `π.toPLPath 𝕜 f`. -/
theorem apply_normalCrystal_wt (hlam : lam ∈ dominantChamber P b) (f : X →+ V)
    (π : LSPath P b lam) :
    f ((normalCrystal hlam).wt π) = (π.toPLPath 𝕜 f).endpoint := by
  let f₀ : X →+ ℚ ⊗[ℤ] X := (TensorProduct.mk ℤ ℚ X 1).toAddMonoidHom
  let F₀ : b.support → Dual ℚ (ℚ ⊗[ℤ] X) :=
    fun i ↦ ((Algebra.linearMap ℤ ℚ).comp (P.coroot' i.1)).liftBaseChange ℚ
  have hF₀ : ∀ (i : b.support) (x : X), F₀ i (f₀ x) = (P.coroot' i x : ℚ) := fun i x ↦ by
    simp [f₀, F₀]
  let e₀ := Equiv.ofInjective (fun ρ : LSPath P b lam ↦ ρ.toPLPath ℚ f₀)
    (toPLPath_injective_of_coroot' hlam hF₀)
  have hwt₀ : f₀ ((normalCrystal hlam).wt π) = (π.toPLPath ℚ f₀).endpoint := by
    simp only [normalCrystal, NormalCrystal.transport_wt, Equiv.symm_symm]
    simpa [e₀] using PLPath.apply_normalCrystalOn_wt (hf := P.tensorProduct_mk_injective ℚ)
      (hF := hF₀) (hS := isCrystalSet_range_toPLPath hlam hF₀) (e₀ π)
  let B : ℚ →ₗ[ℤ] X →ₗ[ℤ] V :=
    { toFun q :=
        { toFun x := (q : 𝕜) • f x
          map_add' x₁ x₂ := by rw [map_add, smul_add]
          map_smul' z x := by rw [map_zsmul, smul_comm]; rfl }
      map_add' q₁ q₂ := by ext x; simp [add_smul]
      map_smul' z q := by ext x; simp [mul_smul, Int.cast_smul_eq_zsmul] }
  let ψ : ℚ ⊗[ℤ] X →ₗ[ℤ] V := TensorProduct.lift B
  have hψ_f₀ (x : X) : ψ (f₀ x) = f x :=
    (TensorProduct.lift.tmul (f' := B) (1 : ℚ) x).trans (by simp [B])
  have hψ_end : ψ (π.toPLPath ℚ f₀).endpoint = (π.toPLPath 𝕜 f).endpoint := by
    rw [endpoint_toPLPath, endpoint_toPLPath, map_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    change ψ ((π.duration j) • ((1 : ℚ) ⊗ₜ[ℤ] ((π.dir j).1 • lam))) = _
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    exact TensorProduct.lift.tmul (f' := B) (π.duration j) ((π.dir j).1 • lam)
  rw [← hψ_f₀, hwt₀, hψ_end]

/-- The crystal weight of an LS path differs from its final orbit weight by an element of the
root lattice. -/
theorem normalCrystal_wt_sub_smul_mem_rootSpan (hlam : lam ∈ dominantChamber P b)
    (π : LSPath P b lam) :
    (normalCrystal hlam).wt π - (π.dir (Fin.last _)).1 • lam ∈ P.rootSpan ℤ := by
  let f₀ : X →+ ℚ ⊗[ℤ] X := (TensorProduct.mk ℤ ℚ X 1).toAddMonoidHom
  obtain ⟨m, hm, hend⟩ := π.exists_mem_rootSpan_endpoint_eq_add (𝕜 := ℚ) hlam f₀
  have hwt : (normalCrystal hlam).wt π = (π.dir (Fin.last _)).1 • lam + m :=
    (P.tensorProduct_mk_injective ℚ) ((apply_normalCrystal_wt (𝕜 := ℚ) hlam f₀ π).trans hend)
  simpa [hwt] using hm

/-- The crystal weight of the straight LS path of dominant shape `λ` is `λ`. -/
@[simp]
theorem normalCrystal_wt_straight (hlam : lam ∈ dominantChamber P b) :
    (normalCrystal hlam).wt (straight lam) = lam := by
  let f₀ : X →+ ℚ ⊗[ℤ] X := (TensorProduct.mk ℤ ℚ X 1).toAddMonoidHom
  apply P.tensorProduct_mk_injective ℚ
  simpa [f₀] using apply_normalCrystal_wt (𝕜 := ℚ) hlam f₀ (straight lam)

variable {f : X →+ V} {F : b.support → Dual 𝕜 V}

/-- **Normal-crystal raising string length in any simple-coroot realization**:
`ε_i(π) = -min H_i(π)`. -/
theorem cast_normalCrystal_ε (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (i : b.support) (π : LSPath P b lam) :
    ((normalCrystal hlam).ε i π : 𝕜) = -(π.toPLPath 𝕜 f).minHeight (F i) := by
  have := P.flip_isReduced
  let f₀ : X →+ ℚ ⊗[ℤ] X := (TensorProduct.mk ℤ ℚ X 1).toAddMonoidHom
  let F₀ : b.support → Dual ℚ (ℚ ⊗[ℤ] X) :=
    fun j ↦ ((Algebra.linearMap ℤ ℚ).comp (P.coroot' j.1)).liftBaseChange ℚ
  have hF₀ : ∀ (j : b.support) (x : X), F₀ j (f₀ x) = (P.coroot' j x : ℚ) := fun j x ↦ by
    simp [f₀, F₀]
  let e₀ := Equiv.ofInjective (fun ρ : LSPath P b lam ↦ ρ.toPLPath ℚ f₀)
    (toPLPath_injective_of_coroot' hlam hF₀)
  have hε₀ : ((normalCrystal hlam).ε i π : ℚ) = -(π.toPLPath ℚ f₀).minHeight (F₀ i) := by
    simp only [normalCrystal, NormalCrystal.transport_ε, Equiv.symm_symm]
    simpa [e₀] using PLPath.cast_normalCrystalOn_ε (hf := P.tensorProduct_mk_injective ℚ)
      (hF := hF₀) (hS := isCrystalSet_range_toPLPath hlam hF₀) i (e₀ π)
  obtain ⟨z, hz₀, hz⟩ := π.exists_minHeight_eq_intCast_and_eq_intCast hlam i f₀ (F₀ i) (hF₀ i)
    f (F i) (hF i)
  have hεz : ((normalCrystal hlam).ε i π : ℤ) = -z :=
    Int.cast_injective (α := ℚ) (by rw [Int.cast_natCast, hε₀, hz₀, Int.cast_neg])
  rw [hz, ← Int.cast_neg, ← hεz, Int.cast_natCast]

/-- **Normal-crystal lowering string length in any simple-coroot realization**:
`φ_i(π) = H_i(π)(1) - min H_i(π)`. -/
theorem cast_normalCrystal_φ (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (i : b.support) (π : LSPath P b lam) :
    ((normalCrystal hlam).φ i π : 𝕜) =
      F i (π.toPLPath 𝕜 f).endpoint - (π.toPLPath 𝕜 f).minHeight (F i) := by
  have hdiff : ((normalCrystal hlam).φ i π : ℤ) - (normalCrystal hlam).ε i π =
      P.coroot' i ((normalCrystal hlam).wt π) :=
    (normalCrystal hlam).φ_sub_ε i π
  have hφ : ((normalCrystal hlam).φ i π : ℤ) =
      P.coroot' i ((normalCrystal hlam).wt π) + (normalCrystal hlam).ε i π :=
    sub_eq_iff_eq_add.mp hdiff
  have hcast : (((normalCrystal hlam).φ i π : ℤ) : 𝕜) =
      (P.coroot' i ((normalCrystal hlam).wt π) : 𝕜) + ((normalCrystal hlam).ε i π : 𝕜) := by
    exact_mod_cast hφ
  rw [Int.cast_natCast, ← hF i, apply_normalCrystal_wt (𝕜 := 𝕜) hlam f π,
    cast_normalCrystal_ε hlam hF] at hcast
  linarith

/-- **Raising in any simple-coroot realization agrees with `(normalCrystal hlam).e`.** -/
theorem raise_toPLPath_eq_map_normalCrystal_e (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (i : b.support) (π : LSPath P b lam) :
    PLPath.raise (F i) (f (P.root i)) (π.toPLPath 𝕜 f) =
      ((normalCrystal hlam).e i π).map (fun π' ↦ π'.toPLPath 𝕜 f) := by
  have := P.flip_isReduced
  let f₀ : X →+ ℚ ⊗[ℤ] X := (TensorProduct.mk ℤ ℚ X 1).toAddMonoidHom
  let F₀ : b.support → Dual ℚ (ℚ ⊗[ℤ] X) :=
    fun j ↦ ((Algebra.linearMap ℤ ℚ).comp (P.coroot' j.1)).liftBaseChange ℚ
  have hF₀ : ∀ (j : b.support) (x : X), F₀ j (f₀ x) = (P.coroot' j x : ℚ) := fun j x ↦ by
    simp [f₀, F₀]
  let e₀ := Equiv.ofInjective (fun ρ : LSPath P b lam ↦ ρ.toPLPath ℚ f₀)
    (toPLPath_injective_of_coroot' hlam hF₀)
  have he₀ : PLPath.raise (F₀ i) (f₀ (P.root i)) (π.toPLPath ℚ f₀) =
      ((normalCrystal hlam).e i π).map (fun π' ↦ π'.toPLPath ℚ f₀) := by
    have hmap : ((PLPath.normalCrystalOn (P.tensorProduct_mk_injective ℚ) hF₀
        (isCrystalSet_range_toPLPath hlam hF₀)).e i (e₀ π)).unattach =
        PLPath.raise (F₀ i) (f₀ (P.root i)) (π.toPLPath ℚ f₀) :=
      PLPath.unattach_normalCrystalOn_e i (e₀ π)
    rw [← hmap]
    simp only [normalCrystal, NormalCrystal.transport_e, Equiv.symm_symm, Option.map_map,
      Option.unattach]
    exact Option.map_congr fun y _ ↦ (Equiv.apply_ofInjective_symm _ y).symm
  rcases π.raise_toPLPath_eq_none_and_eq_none_or_exists_eq_some hlam i f₀ (F₀ i) (hF₀ i)
      f (F i) (hF i) with ⟨hnone₀, hnone⟩ | ⟨π', hsome₀, hsome⟩
  · have he_none : (normalCrystal hlam).e i π = none :=
      Option.map_eq_none_iff.mp (he₀.symm.trans hnone₀)
    rw [he_none, Option.map_none, hnone]
  · obtain ⟨ρ, hρ, hρeq⟩ := Option.map_eq_some_iff.mp (he₀.symm.trans hsome₀)
    have he_some : (normalCrystal hlam).e i π = some π' :=
      hρ.trans (congrArg some (toPLPath_injective_of_coroot' hlam hF₀ hρeq))
    rw [he_some, Option.map_some, hsome]

theorem normalCrystal_e_eq_some_iff (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {i : b.support} {π π' : LSPath P b lam} :
    (normalCrystal hlam).e i π = some π' ↔
      PLPath.raise (F i) (f (P.root i)) (π.toPLPath 𝕜 f) = some (π'.toPLPath 𝕜 f) := by
  rw [raise_toPLPath_eq_map_normalCrystal_e hlam hF,
    Option.map_eq_some_iff]
  exact ⟨fun h ↦ ⟨π', h, rfl⟩,
    fun ⟨ρ, hρ, heq⟩ ↦ hρ.trans (congrArg some (toPLPath_injective_of_coroot' hlam hF heq))⟩

theorem normalCrystal_e_eq_none_iff (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {i : b.support} {π : LSPath P b lam} :
    (normalCrystal hlam).e i π = none ↔
      PLPath.raise (F i) (f (P.root i)) (π.toPLPath 𝕜 f) = none := by
  rw [raise_toPLPath_eq_map_normalCrystal_e hlam hF, Option.map_eq_none_iff]

/-- **Lowering in any simple-coroot realization agrees with `(normalCrystal hlam).f`.** -/
theorem lower_toPLPath_eq_map_normalCrystal_f (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (i : b.support) (π : LSPath P b lam) :
    PLPath.lower (F i) (f (P.root i)) (π.toPLPath 𝕜 f) =
      ((normalCrystal hlam).f i π).map (fun π' ↦ π'.toPLPath 𝕜 f) := by
  have := P.flip_isReduced
  have htwo := PLPath.apply_root_eq_two hF i
  rcases hf_opt : (normalCrystal hlam).f i π with _ | π'
  · simp only [Option.map_none]
    by_contra hne
    obtain ⟨q, hq⟩ := Option.ne_none_iff_exists'.mp hne
    obtain ⟨ρ, rfl⟩ := π.exists_toPLPath_eq_of_lower_eq_some hlam f i (F i) (hF i) hq
    have hr : PLPath.raise (F i) (f (P.root i)) (ρ.toPLPath 𝕜 f) = some (π.toPLPath 𝕜 f) :=
      (PLPath.lower_eq_some_iff htwo).mp hq
    have he : (normalCrystal hlam).e i ρ = some π :=
      (normalCrystal_e_eq_some_iff hlam hF).mpr hr
    exact Option.some_ne_none _ (((normalCrystal hlam).f_eq_some_iff.mpr he).symm.trans hf_opt)
  · simp only [Option.map_some]
    have he : (normalCrystal hlam).e i π' = some π :=
      (normalCrystal hlam).f_eq_some_iff.mp hf_opt
    exact (PLPath.lower_eq_some_iff htwo).mpr ((normalCrystal_e_eq_some_iff hlam hF).mp he)

theorem normalCrystal_f_eq_some_iff (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {i : b.support} {π π' : LSPath P b lam} :
    (normalCrystal hlam).f i π = some π' ↔
      PLPath.lower (F i) (f (P.root i)) (π.toPLPath 𝕜 f) = some (π'.toPLPath 𝕜 f) := by
  rw [(normalCrystal hlam).f_eq_some_iff, normalCrystal_e_eq_some_iff hlam hF,
    PLPath.lower_eq_some_iff (PLPath.apply_root_eq_two hF i)]

theorem normalCrystal_f_eq_none_iff (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    {i : b.support} {π : LSPath P b lam} :
    (normalCrystal hlam).f i π = none ↔
      PLPath.lower (F i) (f (P.root i)) (π.toPLPath 𝕜 f) = none := by
  rw [lower_toPLPath_eq_map_normalCrystal_f hlam hF, Option.map_eq_none_iff]

/-- Words of raising operators on `LSPath.normalCrystal` agree with `PLPath.raiseWord` in every
simple-coroot realization. -/
theorem raiseWord_toPLPath_eq_map_normalCrystal_eWord (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (w : List b.support) (π : LSPath P b lam) :
    PLPath.raiseWord F (fun i : b.support ↦ f (P.root i)) w (π.toPLPath 𝕜 f) =
      ((normalCrystal hlam).eWord w π).map (fun π' ↦ π'.toPLPath 𝕜 f) := by
  induction w generalizing π with
  | nil => simp
  | cons i w ih =>
    rw [PLPath.raiseWord_cons, NormalCrystal.eWord_cons,
      raise_toPLPath_eq_map_normalCrystal_e hlam hF]
    cases (normalCrystal hlam).e i π <;> simp [ih]

/-- Words of lowering operators on `LSPath.normalCrystal` agree with `PLPath.lowerWord` in every
simple-coroot realization. -/
theorem lowerWord_toPLPath_eq_map_normalCrystal_fWord (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (w : List b.support) (π : LSPath P b lam) :
    PLPath.lowerWord F (fun i : b.support ↦ f (P.root i)) w (π.toPLPath 𝕜 f) =
      ((normalCrystal hlam).fWord w π).map (fun π' ↦ π'.toPLPath 𝕜 f) := by
  induction w generalizing π with
  | nil => simp
  | cons i w ih =>
    rw [PLPath.lowerWord_cons, NormalCrystal.fWord_cons,
      lower_toPLPath_eq_map_normalCrystal_f hlam hF]
    cases (normalCrystal hlam).f i π <;> simp [ih]

end UniversalRealization

/-! ### Unique highest element, lowering-word generation, and connectedness -/

@[simp]
theorem normalCrystal_ε_straight (hlam : lam ∈ dominantChamber P b) (i : b.support) :
    (normalCrystal hlam).ε i (straight lam) = 0 := by
  let f₀ : X →+ ℚ ⊗[ℤ] X := (TensorProduct.mk ℤ ℚ X 1).toAddMonoidHom
  let F₀ : b.support → Dual ℚ (ℚ ⊗[ℤ] X) :=
    fun j ↦ ((Algebra.linearMap ℤ ℚ).comp (P.coroot' j.1)).liftBaseChange ℚ
  have hF₀ : ∀ (j : b.support) (x : X), F₀ j (f₀ x) = (P.coroot' j x : ℚ) := fun j x ↦ by
    simp [f₀, F₀]
  have hnonneg : (0 : ℚ) ≤ F₀ i (f₀ lam) := by
    rw [hF₀]
    exact_mod_cast (mem_dominantChamber P b lam).mp hlam i.1 i.2
  have hε := cast_normalCrystal_ε hlam hF₀ i (straight lam)
  rw [toPLPath_straight, PLPath.minHeight_straight, min_eq_left hnonneg, neg_zero] at hε
  exact_mod_cast hε

@[simp]
theorem normalCrystal_e_straight (hlam : lam ∈ dominantChamber P b) (i : b.support) :
    (normalCrystal hlam).e i (straight lam) = none :=
  (normalCrystal hlam).ε_eq_zero_iff.mp (normalCrystal_ε_straight hlam i)

@[simp]
theorem normalCrystal_φ_straight (hlam : lam ∈ dominantChamber P b) (i : b.support) :
    (normalCrystal hlam).φ i (straight lam) = (P.coroot' i lam).toNat := by
  have hdiff := (normalCrystal hlam).φ_sub_ε i (straight lam)
  rw [normalCrystal_ε_straight, normalCrystal_wt_straight, Nat.cast_zero, sub_zero] at hdiff
  have hnonneg : 0 ≤ P.coroot' i lam := (mem_dominantChamber P b lam).mp hlam i.1 i.2
  exact Int.ofNat.inj (hdiff.trans (Int.toNat_of_nonneg hnonneg).symm)

/-- **`straight lam` is the unique highest element of `LSPath.normalCrystal`.** -/
theorem forall_normalCrystal_e_eq_none_iff (hlam : lam ∈ dominantChamber P b)
    {π : LSPath P b lam} :
    (∀ i, (normalCrystal hlam).e i π = none) ↔ π = straight lam := by
  have := P.flip_isReduced
  let f₀ : X →+ ℚ ⊗[ℤ] X := (TensorProduct.mk ℤ ℚ X 1).toAddMonoidHom
  let F₀ : b.support → Dual ℚ (ℚ ⊗[ℤ] X) :=
    fun j ↦ ((Algebra.linearMap ℤ ℚ).comp (P.coroot' j.1)).liftBaseChange ℚ
  have hF₀ : ∀ (j : b.support) (x : X), F₀ j (f₀ x) = (P.coroot' j x : ℚ) := fun j x ↦ by
    simp [f₀, F₀]
  simpa only [normalCrystal_e_eq_none_iff hlam hF₀] using
    π.forall_raise_eq_none_iff hlam f₀ F₀ hF₀

/-- **Every Lakshmibai–Seshadri path of dominant shape `λ` is obtained from `straight λ` by a
word of lowering operators.** -/
theorem exists_fWord_straight_eq_some (hlam : lam ∈ dominantChamber P b)
    (π : LSPath P b lam) :
    ∃ w : List b.support, (normalCrystal hlam).fWord w (straight lam) = some π := by
  have := P.flip_isReduced
  have := LSPath.finite (P := P) (b := b) hlam
  exact (normalCrystal hlam).exists_fWord_eq_some_of_unique_highest
    (fun _ hx ↦ (forall_normalCrystal_e_eq_none_iff hlam).mp hx) π

/-- Every Lakshmibai–Seshadri path of dominant shape `λ` can be raised to `straight λ` by a word
of raising operators. -/
theorem exists_eWord_eq_some_straight (hlam : lam ∈ dominantChamber P b)
    (π : LSPath P b lam) :
    ∃ w : List b.support, (normalCrystal hlam).eWord w π = some (straight lam) := by
  obtain ⟨w, hw⟩ := exists_fWord_straight_eq_some hlam π
  exact ⟨w.reverse, (normalCrystal hlam).fWord_eq_some_iff.mp hw⟩

/-- **The crystal graph of `LSPath.normalCrystal` is connected.** -/
theorem connected_normalCrystal_graph (hlam : lam ∈ dominantChamber P b) :
    (normalCrystal hlam).graph.Connected := by
  refine ((normalCrystal hlam).graph.connected_iff_exists_forall_reachable).mpr
    ⟨straight lam, fun π ↦ ?_⟩
  obtain ⟨w, hw⟩ := exists_fWord_straight_eq_some hlam π
  have hreach : ∀ {w : List b.support} {x y : LSPath P b lam},
      (normalCrystal hlam).fWord w x = some y → (normalCrystal hlam).graph.Reachable x y := by
    intro w
    induction w with
    | nil =>
      intro x y h
      rw [NormalCrystal.fWord_nil] at h
      obtain rfl := Option.some.inj h
      exact SimpleGraph.Reachable.rfl
    | cons i w ih =>
      intro x y h
      obtain ⟨z, hz, hy⟩ := Option.bind_eq_some_iff.mp ((normalCrystal hlam).fWord_cons i w x ▸ h)
      exact ((normalCrystal hlam).graph_adj_of_f_eq_some hz).reachable.trans (ih hy)
  exact hreach hw

/-! ### Central weights, zero weight, and empty root systems -/

omit [Finite ι] [P.IsReduced] in
/-- Every weight annihilating the simple coroots lies in the dominant chamber. -/
theorem mem_dominantChamber_of_forall_coroot_eq_zero {χ : X}
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0) :
    χ ∈ dominantChamber P b := by
  rw [mem_dominantChamber]
  intro i hi
  have := hχ ⟨i, hi⟩
  simpa [RootPairing.coroot'] using le_of_eq this.symm

/-- For a weight `χ` annihilating the simple coroots (including `χ = 0` and pure central
characters), `straight χ` is the only Lakshmibai–Seshadri path of shape `χ`. -/
theorem eq_straight_of_forall_coroot_eq_zero {χ : X}
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0) (π : LSPath P b χ) :
    π = straight χ := by
  have hdom := mem_dominantChamber_of_forall_coroot_eq_zero hχ
  obtain ⟨w, hw⟩ := exists_fWord_straight_eq_some hdom π
  cases w with
  | nil =>
    rw [NormalCrystal.fWord_nil] at hw
    exact (Option.some.inj hw).symm
  | cons i w =>
    have hf0 : (normalCrystal hdom).f i (straight χ) = none :=
      (normalCrystal hdom).φ_eq_zero_iff.mp
        (by simp [normalCrystal_φ_straight, RootPairing.coroot', hχ i])
    simp [NormalCrystal.fWord_cons, hf0] at hw

/-- For a central weight `χ`, `LSPath.normalCrystal` is strictly isomorphic to the one-element
central crystal `NormalCrystal.central χ hχ`. -/
noncomputable def centralIso {χ : X}
    (hχ : ∀ i : b.support, P.toLinearMap χ (P.coroot i) = 0) :
    NormalCrystal.StrictIso (normalCrystal (mem_dominantChamber_of_forall_coroot_eq_zero hχ))
      (NormalCrystal.central χ hχ) where
  toEquiv :=
    { toFun := fun _ ↦ PUnit.unit
      invFun := fun _ ↦ straight χ
      left_inv := fun π ↦ (eq_straight_of_forall_coroot_eq_zero hχ π).symm
      right_inv := fun _ ↦ rfl }
  wt_toFun π := by
    rw [eq_straight_of_forall_coroot_eq_zero hχ π]
    simp
  e_toFun i π := by
    rw [eq_straight_of_forall_coroot_eq_zero hχ π]
    simp

/-- When the base `b` has empty support (empty root system), every weight `λ` is dominant and
`straight λ` is the unique LS path of shape `λ`. -/
theorem eq_straight_of_isEmpty [IsEmpty b.support] (π : LSPath P b lam) :
    π = straight lam :=
  eq_straight_of_forall_coroot_eq_zero (fun i ↦ IsEmpty.elim ‹IsEmpty b.support› i) π

noncomputable instance [IsEmpty b.support] : Unique (LSPath P b lam) where
  default := straight lam
  uniq := eq_straight_of_isEmpty

end NormalCrystal

/-! ### Equivalence with the straight-path crystal component `B(λ)` -/

section ComponentEquivalence

variable {ι X Y 𝕜 V : Type*} [AddCommGroup X] [AddCommGroup Y]
  {P : RootDatum ι X Y} {b : P.Base} [Finite ι] [P.IsReduced] {lam : X}
  [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] [AddCommGroup V] [Module 𝕜 V]
  {f : X →+ V} {F : b.support → Dual 𝕜 V}

/-- **Equivalence of the `a`-chain LS encoding with lowering-word generation from `straight λ`.**
In any ordered-field simple-coroot realization `(f, F)`, the realized Lakshmibai–Seshadri paths of
dominant shape `λ` are precisely the paths obtained from `PLPath.straight 𝕜 (f λ)` by words of
simple-root lowering operators. -/
theorem range_toPLPath_eq_setOf_exists_lowerWord_straight (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    range (fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f) =
      {q | ∃ w : List b.support,
        PLPath.lowerWord F (fun i : b.support ↦ f (P.root i)) w
          (PLPath.straight 𝕜 (f lam)) = some q} := by
  ext q
  simp only [mem_range, mem_ofPred_eq, ← toPLPath_straight (P := P) (b := b) (lam := lam) 𝕜 f,
    lowerWord_toPLPath_eq_map_normalCrystal_fWord hlam hF, Option.map_eq_some_iff]
  exact ⟨fun ⟨π, hπ⟩ ↦ let ⟨w, hw⟩ := exists_fWord_straight_eq_some hlam π; ⟨w, π, hw, hπ⟩,
    fun ⟨_, π, _, hπ⟩ ↦ ⟨π, hπ⟩⟩

/-- The realized Lakshmibai–Seshadri paths of dominant shape `λ` are precisely the paths reachable
from `PLPath.straight 𝕜 (f λ)` by arbitrary finite sequences of simple-root raising and lowering
steps. -/
theorem range_toPLPath_eq_setOf_reflTransGen_rootStep_straight (hlam : lam ∈ dominantChamber P b)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    range (fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f) =
      {q | ReflTransGen (PLPath.RootStep b f F) (PLPath.straight 𝕜 (f lam)) q} := by
  ext q
  refine ⟨fun hq ↦ ?_, fun hwalk ↦
    (isCrystalSet_range_toPLPath hlam hF).mem_of_reflTransGen_rootStep hwalk
      ⟨straight lam, toPLPath_straight (lam := lam) 𝕜 f⟩⟩
  rw [range_toPLPath_eq_setOf_exists_lowerWord_straight hlam hF] at hq
  obtain ⟨w, hw⟩ := hq
  have hstep : ∀ {w : List b.support} {p r : PLPath 𝕜 V},
      PLPath.lowerWord F (fun i : b.support ↦ f (P.root i)) w p = some r →
      ReflTransGen (PLPath.RootStep b f F) p r := by
    intro w
    induction w with
    | nil =>
      intro p r h
      rw [PLPath.lowerWord_nil] at h
      obtain rfl := Option.some.inj h
      exact .refl
    | cons i w ih =>
      intro p r h
      obtain ⟨s, hs, hr⟩ := Option.bind_eq_some_iff.mp
        (PLPath.lowerWord_cons i w p ▸ h)
      exact .head (.of_lower_eq_some hs) (ih hr)
  exact hstep hw

/-- When `f` is injective, `toPLPath` induces a strict crystal isomorphism from
`LSPath.normalCrystal` onto `PLPath.normalCrystalOn` of the realized LS paths. -/
noncomputable def toPLPathCrystalIso (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    NormalCrystal.StrictIso (normalCrystal hlam)
      (PLPath.normalCrystalOn hf hF (isCrystalSet_range_toPLPath hlam hF)) where
  toEquiv := Equiv.ofInjective (fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f)
    (toPLPath_injective_of_coroot' (𝕜 := 𝕜) hlam hF)
  wt_toFun π := hf (by
    rw [PLPath.apply_normalCrystalOn_wt, apply_normalCrystal_wt (𝕜 := 𝕜) hlam f π]
    rfl)
  e_toFun i π := by
    rw [PLPath.normalCrystalOn_e_eq_map_iff]
    exact raise_toPLPath_eq_map_normalCrystal_e hlam hF i π

@[simp]
theorem toPLPathCrystalIso_apply (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (π : LSPath P b lam) :
    (toPLPathCrystalIso hlam hf hF π).1 = π.toPLPath 𝕜 f :=
  (rfl)

/-- Strict crystal embedding of `LSPath.normalCrystal` into Littelmann's ambient crystal of
integral paths `PLPath.normalCrystal`. -/
noncomputable def toPLPathCrystalHom (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    NormalCrystal.StrictHom (normalCrystal hlam) (PLPath.normalCrystal hf hF) :=
  (PLPath.embedHom (isCrystalSet_range_toPLPath hlam hF)).comp
    (toPLPathCrystalIso hlam hf hF).toStrictHom

@[simp]
theorem toPLPathCrystalHom_apply (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (π : LSPath P b lam) :
    (toPLPathCrystalHom hlam hf hF π).1 = π.toPLPath 𝕜 f := by
  simp [toPLPathCrystalHom]

/-- Membership in the connected crystal component of `PLPath.straight 𝕜 (f λ)` inside
`PLPath.normalCrystal` is equivalent to being the realization of an LS path of shape `λ`. -/
theorem mem_supp_connectedComponentMk_straight_iff (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (x : {q : PLPath 𝕜 V | PLPath.IsIntegralPath b f F q}) :
    x ∈ ((PLPath.normalCrystal hf hF).graph.connectedComponentMk
        ⟨PLPath.straight 𝕜 (f lam),
          PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩).supp ↔
      x.1 ∈ range (fun π : LSPath P b lam ↦ π.toPLPath 𝕜 f) := by
  rw [PLPath.mem_supp_connectedComponentMk_normalCrystalOn_iff,
    range_toPLPath_eq_setOf_reflTransGen_rootStep_straight hlam hF, mem_ofPred_eq]

private noncomputable def toPLPathComponentHom (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    NormalCrystal.StrictHom (normalCrystal hlam)
      (PLPath.normalCrystalComponent hf hF
        ⟨PLPath.straight 𝕜 (f lam),
          PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩) where
  toFun π := ⟨toPLPathCrystalHom hlam hf hF π,
    (mem_supp_connectedComponentMk_straight_iff hlam hf hF _).mpr
      (Set.mem_range.mpr ⟨π, (toPLPathCrystalHom_apply hlam hf hF π).symm⟩)⟩
  wt_toFun π := by
    have h := ((PLPath.normalCrystal hf hF).componentHom _).wt_apply
      ⟨toPLPathCrystalHom hlam hf hF π,
        (mem_supp_connectedComponentMk_straight_iff hlam hf hF _).mpr
          (Set.mem_range.mpr ⟨π, (toPLPathCrystalHom_apply hlam hf hF π).symm⟩)⟩
    rw [NormalCrystal.componentHom_apply] at h
    exact h.symm.trans ((toPLPathCrystalHom hlam hf hF).wt_apply π)
  e_toFun i π := by
    let C := (PLPath.normalCrystal hf hF).graph.connectedComponentMk
      ⟨PLPath.straight 𝕜 (f lam),
        PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩
    let y : C := ⟨toPLPathCrystalHom hlam hf hF π,
      (mem_supp_connectedComponentMk_straight_iff hlam hf hF _).mpr
        (Set.mem_range.mpr ⟨π, (toPLPathCrystalHom_apply hlam hf hF π).symm⟩)⟩
    have hcomp : ⇑((PLPath.normalCrystal hf hF).componentHom C) = Subtype.val :=
      funext ((PLPath.normalCrystal hf hF).componentHom_apply C)
    apply Option.map_injective Subtype.val_injective
    rw [← hcomp, ← ((PLPath.normalCrystal hf hF).componentHom C).e_apply i y,
      NormalCrystal.componentHom_apply, (toPLPathCrystalHom hlam hf hF).e_apply i π,
      Option.map_map, hcomp]
    rfl

/-- **Main crystal isomorphism `LSPath P b λ ≃ B(λ)`**: the normal crystal of Lakshmibai–Seshadri
paths of dominant shape `λ` is strictly isomorphic to the connected crystal component generated by
the dominant straight path `PLPath.straight 𝕜 (f λ)` inside `PLPath.normalCrystal`. -/
noncomputable def normalCrystalComponentIso (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    NormalCrystal.StrictIso (normalCrystal hlam)
      (PLPath.normalCrystalComponent hf hF
        ⟨PLPath.straight 𝕜 (f lam),
          PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩) :=
  NormalCrystal.StrictIso.ofBijective (toPLPathComponentHom hlam hf hF)
    (show Function.Bijective (toPLPathComponentHom hlam hf hF) from
      ⟨fun _ _ h ↦ by
        have h' : (toPLPathCrystalHom hlam hf hF _).1 = (toPLPathCrystalHom hlam hf hF _).1 :=
          congrArg (fun z ↦ z.1.1) h
        rw [toPLPathCrystalHom_apply, toPLPathCrystalHom_apply] at h'
        exact toPLPath_injective_of_coroot' (𝕜 := 𝕜) hlam hF h',
       fun y ↦ by
        obtain ⟨π, hπ⟩ := (mem_supp_connectedComponentMk_straight_iff hlam hf hF y.1).mp y.2
        exact ⟨π, Subtype.ext (Subtype.ext ((toPLPathCrystalHom_apply hlam hf hF π).trans hπ))⟩⟩)

@[simp]
theorem normalCrystalComponentIso_apply (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (π : LSPath P b lam) :
    (normalCrystalComponentIso hlam hf hF π).1.1 = π.toPLPath 𝕜 f := by
  simp only [normalCrystalComponentIso, NormalCrystal.StrictIso.coe_ofBijective]
  exact toPLPathCrystalHom_apply hlam hf hF π

@[simp]
theorem normalCrystalComponentIso_straight (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜)) :
    (normalCrystalComponentIso hlam hf hF (straight lam)).1 =
      ⟨PLPath.straight 𝕜 (f lam),
        PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩ :=
  Subtype.ext (by rw [normalCrystalComponentIso_apply, toPLPath_straight])

@[simp]
theorem toPLPath_normalCrystalComponentIso_symm (hlam : lam ∈ dominantChamber P b)
    (hf : Function.Injective f)
    (hF : ∀ (i : b.support) (x : X), F i (f x) = (P.coroot' i x : 𝕜))
    (y : (PLPath.normalCrystal hf hF).graph.connectedComponentMk
      ⟨PLPath.straight 𝕜 (f lam),
        PLPath.isIntegralPath_straight_of_mem_dominantChamber hlam hF⟩) :
    ((normalCrystalComponentIso hlam hf hF).symm y).toPLPath 𝕜 f = y.1.1 := by
  have h := congrArg (fun z ↦ z.1.1)
    ((normalCrystalComponentIso hlam hf hF).apply_symm_apply y)
  rwa [normalCrystalComponentIso_apply] at h

end ComponentEquivalence

end LSPath

end TauCeti
