import TauCeti.LinearAlgebra.RootSystem.Reduced

/-!
# The Bruhat-chain complex and its polyhedron

For a weight `λ` of a finite reduced root datum `(P, b)`, the minimal coset representatives for the
simple-wall parabolic subgroup generated by `P.wallIndices b lam` (which equals the stabilizer `W_λ`
when `λ` is dominant) carry the restricted Bruhat partial order. Their order complex
`TauCeti.LSPath.bruhatChainComplex` has these minimal coset representatives as vertices and the
nonempty finite Bruhat chains as faces. Each weakly decreasing Bruhat sequence
`τ₀ ≥ τ₁ ≥ ⋯ ≥ τ_l` induces a continuous simplex map `TauCeti.LSPath.chainSimplexToRealization`
from the closed `l`-simplex into the geometric realization
`(bruhatChainComplex P b lam).Realization`.

Summing barycentric weights over equal directions gives the simplicial operations inside this
polyhedron:

* face inclusions (`w.map p.succAbove`) restrict a simplex map to a subchain face;
* adjacent-direction merges (`w.map p.predAbove` when `dir p.castSucc = dir p.succ`) leave the
  realized point in `(bruhatChainComplex P b lam).Realization` unchanged; and
* two closed chain simplices meet precisely along the face spanned by their shared directions.

Evaluating any point of `(bruhatChainComplex P b lam).Realization` on its strictly decreasing
carrier chain yields a global piecewise-linear path map `TauCeti.LSPath.bruhatRealizationPath` into
`PLPath ℝ V`, compatible with every weakly decreasing chain presentation and injective whenever `λ`
is dominant, `f` is injective on the Weyl orbit of `λ`, and distinct realized orbit weights lie in
distinct rays.

The Lakshmibai–Seshadri paths of shape `λ` embed injectively into this polyhedron via
`TauCeti.LSPath.toBruhatRealization`, cutting out `lsChainSimplexSet ℝ dir` on each injective Bruhat
chain `dir`. Because `LSPath P b lam` is always countable (and finite when `λ` is dominant), its
image is a strict subset of the polyhedron if and only if the polyhedron is uncountable, namely if
and only if `⟨λ, αᵢ^∨⟩ ≠ 0` for some simple root `αᵢ`.

For the concrete rank-two Cartan type `A₂` specialization (homeomorphic to the six-vertex
four-tetrahedron `S₃` Bruhat-chain complex), see
`TauCeti.RepresentationTheory.LSPath.Simplex.TypeATwo`.

## Main definitions

* `TauCeti.LSPath.bruhatChainComplex`: the order complex of Bruhat chains of minimal coset
  representatives for `P.wallIndices b lam`.
* `TauCeti.LSPath.chainSimplexToRealization`: continuous map from a closed fixed-chain simplex into
  the Bruhat-chain polyhedron, merging equal directions.
* `TauCeti.LSPath.bruhatRealizationPath`: piecewise-linear path attached to a point of the
  Bruhat-chain polyhedron.
* `TauCeti.LSPath.toBruhatRealization`: embedding of `LSPath P b lam` into the Bruhat-chain
  polyhedron.

## Main results

* `TauCeti.LSPath.chainSimplexToRealization_map_orderHom`,
  `TauCeti.LSPath.chainSimplexToRealization_map_succAbove`,
  `TauCeti.LSPath.chainSimplexToRealization_map_predAbove`,
  `TauCeti.LSPath.range_chainSimplexToRealization_inter`, and
  `TauCeti.LSPath.exists_chainSimplexToRealization_eq`: face inclusions, equal-adjacent-direction
  merges, common-face intersections, and open-simplex realization of every point in
  `(bruhatChainComplex P b lam).Realization`.
* `TauCeti.LSPath.bruhatRealizationPath_chainSimplexToRealization`,
  `TauCeti.LSPath.bruhatRealizationPath_vertex`, and
  `TauCeti.LSPath.bruhatRealizationPath_injective`: compatibility with fixed-chain simplex paths,
  vertex evaluation, and injectivity of global path evaluation.
* `TauCeti.LSPath.support_toBruhatRealization`,
  `TauCeti.LSPath.toBruhatRealization_injective`, and
  `TauCeti.LSPath.chainSimplexToRealization_mem_range_toBruhatRealization_iff`: support,
  injectivity, and closed-simplex characterization of the LS subset inside the Bruhat-chain
  polyhedron.
* `TauCeti.LSPath.finite_range_toBruhatRealization`,
  `TauCeti.LSPath.uncountable_realization_bruhatChainComplex_iff`, and
  `TauCeti.LSPath.range_toBruhatRealization_ssubset_univ_iff`: finiteness for dominant `λ`,
  uncountability criterion, and unconditional strict-containment criterion for the LS subset.

## References

* A. Björner and F. Brenti, *Combinatorics of Coxeter Groups*, GTM 231, Springer (2005), §§2.2–2.5.
* P. Littelmann, *A Littlewood–Richardson rule for symmetrizable Kac–Moody algebras*, Invent.
  Math. 116 (1994), 329–346, §4.
* P. Littelmann, *Paths and root operators in representation theory*, Ann. of Math. 142 (1995),
  499–525, §4.
-/

public section

universe u w x

namespace TauCeti.LSPath

open RootPairing

attribute [local instance] Classical.propDecidable

section BruhatChainComplex

variable {ι : Type u} {M : Type w} {N : Type x} [AddCommGroup M] [AddCommGroup N]
  {P : RootPairing ι ℤ M N} {b : P.Base} [Finite ι] [P.IsReduced] {lam : M}

variable (P b lam) in
/-- The **Bruhat-chain simplicial complex** of shape `λ`: the order complex of the Bruhat order on
minimal coset representatives for the simple-wall parabolic `P.wallIndices b lam` (which equals the
stabilizer `W_λ` when `λ` is dominant). -/
noncomputable def bruhatChainComplex :
    _root_.AbstractSimplicialComplex
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w} :=
  letI := (weylCoxeterSystem P b).bruhatPartialOrder
  AbstractSimplicialComplex.orderComplex
    {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}

/-- A finite set of minimal coset representatives is a face of `bruhatChainComplex` exactly when it
is nonempty and pairwise comparable in Bruhat order. -/
@[simp]
theorem mem_bruhatChainComplex_iff
    {σ : Finset {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}} :
    σ ∈ bruhatChainComplex P b lam ↔
      σ.Nonempty ∧ ∀ u ∈ σ, ∀ v ∈ σ,
        (weylCoxeterSystem P b).BruhatLE u.val v.val ∨
          (weylCoxeterSystem P b).BruhatLE v.val u.val := by
  let : PartialOrder P.weylGroup := (weylCoxeterSystem P b).bruhatPartialOrder
  rw [bruhatChainComplex, AbstractSimplicialComplex.mem_orderComplex_iff']
  simp only [← Subtype.coe_le_coe, CoxeterSystem.bruhatPartialOrder_le]

private theorem antitone_of_bruhatLE_succ {l : ℕ}
    {dir : Fin (l + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}}
    (hdir : ∀ j : Fin l, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val) :
    letI : PartialOrder P.weylGroup := (weylCoxeterSystem P b).bruhatPartialOrder
    Antitone dir := by
  let : PartialOrder P.weylGroup := (weylCoxeterSystem P b).bruhatPartialOrder
  exact Fin.antitone_iff_succ_le.mpr fun j ↦ by
    simpa only [← Subtype.coe_le_coe, CoxeterSystem.bruhatPartialOrder_le] using hdir j

private theorem image_dir_mem_bruhatChainComplex {l : ℕ}
    (dir : Fin (l + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w})
    (hdir : ∀ j : Fin l, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val) :
    Finset.univ.image dir ∈ bruhatChainComplex P b lam := by
  let : PartialOrder P.weylGroup := (weylCoxeterSystem P b).bruhatPartialOrder
  have hant : Antitone dir := antitone_of_bruhatLE_succ hdir
  rw [mem_bruhatChainComplex_iff]
  refine ⟨Finset.univ_nonempty.image dir, fun u hu v hv ↦ ?_⟩
  obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hu
  obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hv
  exact (le_total j i).imp
    (fun hji ↦ by
      simpa only [← Subtype.coe_le_coe, CoxeterSystem.bruhatPartialOrder_le] using hant hji)
    (fun hij ↦ by
      simpa only [← Subtype.coe_le_coe, CoxeterSystem.bruhatPartialOrder_le] using hant hij)

/-- Continuous map from the closed standard `l`-simplex into the geometric realization of
`bruhatChainComplex P b lam` along any weakly decreasing Bruhat sequence `dir`. Equal directions
have their barycentric coordinates summed. -/
noncomputable def chainSimplexToRealization {l : ℕ}
    (dir : Fin (l + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w})
    (hdir : ∀ j : Fin l, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val) :
    C(Convexity.StdSimplex ℝ (Fin (l + 1)), (bruhatChainComplex P b lam).Realization) where
  toFun w :=
    let σ := Finset.univ.image dir
    let g : Fin (l + 1) → σ := fun j ↦ ⟨dir j, Finset.mem_image_of_mem dir (Finset.mem_univ j)⟩
    _root_.AbstractSimplicialComplex.faceInclusion (bruhatChainComplex P b lam)
      ⟨σ, image_dir_mem_bruhatChainComplex dir hdir⟩
      ((Finset.standardSimplexHomeomorph σ).symm (w.map g))
  continuous_toFun := by
    let σ := Finset.univ.image dir
    let g : Fin (l + 1) → σ := fun j ↦ ⟨dir j, Finset.mem_image_of_mem dir (Finset.mem_univ j)⟩
    exact (_root_.AbstractSimplicialComplex.continuous_faceInclusion _ _).comp
      ((Finset.standardSimplexHomeomorph σ).symm.continuous.comp
        (Convexity.StdSimplex.continuous_map ℝ g))

/-- The barycentric coordinates of `chainSimplexToRealization` are the pushforward of `w.weights`
along `dir`. -/
@[simp]
theorem chainSimplexToRealization_val {l : ℕ}
    (dir : Fin (l + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w})
    (hdir : ∀ j : Fin l, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val)
    (w : Convexity.StdSimplex ℝ (Fin (l + 1))) :
    (chainSimplexToRealization dir hdir w :
        {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w} →₀ ℝ) =
      w.weights.mapDomain dir := by
  simp only [chainSimplexToRealization, ContinuousMap.coe_mk,
    _root_.AbstractSimplicialComplex.faceInclusion_val, Finset.standardSimplexHomeomorph_symm_val,
    Convexity.StdSimplex.weights_map, ← Finsupp.mapDomain_comp]
  exact Finsupp.mapDomain_congr rfl fun _ _ ↦ rfl

/-- At the `j`-th vertex of the standard simplex, `chainSimplexToRealization` lands at the
realization vertex `dir j`. -/
@[simp]
theorem chainSimplexToRealization_single {l : ℕ}
    (dir : Fin (l + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w})
    (hdir : ∀ j : Fin l, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val)
    (j : Fin (l + 1)) :
    chainSimplexToRealization dir hdir (Convexity.StdSimplex.single j) =
      _root_.AbstractSimplicialComplex.vertex (bruhatChainComplex P b lam) (dir j) := by
  apply Subtype.ext
  simp [chainSimplexToRealization_val]

/-- Pulling back a weakly decreasing Bruhat sequence along a monotone map preserves the Bruhat
monotonicity condition. -/
theorem bruhatLE_comp_orderHom {m l : ℕ}
    {dir : Fin (l + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}}
    (hdir : ∀ j : Fin l, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val)
    (φ : Fin (m + 1) →o Fin (l + 1)) (j : Fin m) :
    (weylCoxeterSystem P b).BruhatLE ((dir ∘ φ) j.succ).val ((dir ∘ φ) j.castSucc).val := by
  let : PartialOrder P.weylGroup := (weylCoxeterSystem P b).bruhatPartialOrder
  simpa only [Function.comp_apply, ← Subtype.coe_le_coe, CoxeterSystem.bruhatPartialOrder_le] using
    antitone_of_bruhatLE_succ hdir (φ.monotone j.castSucc_le_succ)

/-- Pulling back a weakly decreasing Bruhat sequence along `Fin.succAbove` preserves the Bruhat
monotonicity condition. -/
theorem bruhatLE_comp_succAbove {l : ℕ}
    {dir : Fin (l + 2) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}}
    (hdir : ∀ j : Fin (l + 1), (weylCoxeterSystem P b).BruhatLE (dir j.succ).val
        (dir j.castSucc).val)
    (p : Fin (l + 2)) (j : Fin l) :
    (weylCoxeterSystem P b).BruhatLE
      ((dir ∘ p.succAbove) j.succ).val ((dir ∘ p.succAbove) j.castSucc).val :=
  bruhatLE_comp_orderHom hdir p.succAboveOrderEmb.toOrderHom j

/-- **Simplicial functoriality in the Bruhat-chain polyhedron.** Pushing simplex coordinates
forward along any monotone map `φ` agrees with mapping along the pulled-back chain `dir ∘ φ`. -/
theorem chainSimplexToRealization_map_orderHom {m l : ℕ}
    (dir : Fin (l + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w})
    (hdir : ∀ j : Fin l, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val)
    (φ : Fin (m + 1) →o Fin (l + 1)) (w : Convexity.StdSimplex ℝ (Fin (m + 1))) :
    chainSimplexToRealization dir hdir (w.map φ) =
      chainSimplexToRealization (dir ∘ φ) (bruhatLE_comp_orderHom hdir φ) w := by
  apply Subtype.ext
  simp only [chainSimplexToRealization_val, Convexity.StdSimplex.weights_map,
    Finsupp.mapDomain_comp]

/-- **Face inclusion in the Bruhat-chain polyhedron.** Restricting to the facet opposite `p`
agrees with mapping the `(l - 1)`-simplex along the subchain `dir ∘ p.succAbove`. -/
@[simp]
theorem chainSimplexToRealization_map_succAbove {l : ℕ}
    (dir : Fin (l + 2) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w})
    (hdir : ∀ j : Fin (l + 1), (weylCoxeterSystem P b).BruhatLE (dir j.succ).val
        (dir j.castSucc).val)
    (p : Fin (l + 2)) (w : Convexity.StdSimplex ℝ (Fin (l + 1))) :
    chainSimplexToRealization dir hdir (w.map p.succAbove) =
      chainSimplexToRealization (dir ∘ p.succAbove) (bruhatLE_comp_succAbove hdir p) w :=
  chainSimplexToRealization_map_orderHom dir hdir p.succAboveOrderEmb.toOrderHom w

/-- **Merging equal adjacent directions in the Bruhat-chain polyhedron.** When
`dir p.castSucc = dir p.succ`, collapsing the `(l + 1)`-simplex along `p.predAbove` onto the
merged chain `dir ∘ p.succ.succAbove` gives the exact same point in the realization. -/
theorem chainSimplexToRealization_map_predAbove {l : ℕ}
    {dir : Fin (l + 2) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}}
    (hdir : ∀ j : Fin (l + 1), (weylCoxeterSystem P b).BruhatLE (dir j.succ).val
        (dir j.castSucc).val)
    {p : Fin (l + 1)} (hmerge : dir p.castSucc = dir p.succ)
    (w : Convexity.StdSimplex ℝ (Fin (l + 2))) :
    chainSimplexToRealization (dir ∘ p.succ.succAbove)
        (bruhatLE_comp_succAbove hdir p.succ) (w.map p.predAbove) =
      chainSimplexToRealization dir hdir w := by
  apply Subtype.ext
  simp only [chainSimplexToRealization_val, Convexity.StdSimplex.weights_map,
    ← Finsupp.mapDomain_comp, Fin.comp_succ_succAbove_comp_predAbove hmerge]

/-- When all directions in `dir` are distinct (in particular for any strictly decreasing Bruhat
chain), `chainSimplexToRealization` embeds the closed `l`-simplex injectively into the
Bruhat-chain polyhedron. -/
theorem chainSimplexToRealization_injective {l : ℕ}
    {dir : Fin (l + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}}
    (hdir : ∀ j : Fin l, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val)
    (hinj : Function.Injective dir) :
    Function.Injective (chainSimplexToRealization dir hdir) := by
  intro w₁ w₂ h
  apply Convexity.StdSimplex.ext
  exact Finsupp.mapDomain_injective hinj
    (by simpa only [chainSimplexToRealization_val] using congrArg Subtype.val h)

/-- The image of `chainSimplexToRealization dir hdir` consists of all realization points supported
within `Set.range dir`. -/
theorem range_chainSimplexToRealization {l : ℕ}
    (dir : Fin (l + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w})
    (hdir : ∀ j : Fin l, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val) :
    Set.range (chainSimplexToRealization dir hdir) =
      {x | (x.val.support : Set _) ⊆ Set.range dir} := by
  ext x
  constructor
  · rintro ⟨w, rfl⟩ u hu
    rw [Finset.mem_coe, chainSimplexToRealization_val] at hu
    obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp (Finsupp.mapDomain_support hu)
    exact ⟨j, rfl⟩
  · intro hx
    let x' : Convexity.StdSimplex ℝ
        {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w} :=
      ⟨x.val, _root_.AbstractSimplicialComplex.Realization.nonneg _ x,
        _root_.AbstractSimplicialComplex.Realization.sum_eq_one _ x⟩
    let s : {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w} →
        Fin (l + 1) :=
      fun u ↦ if hu : u ∈ Set.range dir then hu.choose else 0
    refine ⟨x'.map s, Subtype.ext ?_⟩
    rw [chainSimplexToRealization_val, Convexity.StdSimplex.weights_map, ← Finsupp.mapDomain_comp]
    refine (Finsupp.mapDomain_congr rfl fun u hu ↦ ?_).trans Finsupp.mapDomain_id
    have hur : u ∈ Set.range dir := hx hu
    simp only [Function.comp_apply, s, dite_eq_left hur, hur.choose_spec, id_eq]

/-- **Gluing along shared subchains.** Two closed chain simplices in the Bruhat-chain polyhedron
intersect precisely in the points supported on their common directions. -/
theorem range_chainSimplexToRealization_inter {l₁ l₂ : ℕ}
    (dir₁ : Fin (l₁ + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w})
    (hdir₁ : ∀ j : Fin l₁, (weylCoxeterSystem P b).BruhatLE (dir₁ j.succ).val (dir₁ j.castSucc).val)
    (dir₂ : Fin (l₂ + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w})
    (hdir₂ : ∀ j : Fin l₂, (weylCoxeterSystem P b).BruhatLE (dir₂ j.succ).val
        (dir₂ j.castSucc).val) :
    Set.range (chainSimplexToRealization dir₁ hdir₁) ∩
        Set.range (chainSimplexToRealization dir₂ hdir₂) =
      {x | (x.val.support : Set _) ⊆ Set.range dir₁ ∩ Set.range dir₂} := by
  rw [range_chainSimplexToRealization, range_chainSimplexToRealization]
  ext x
  exact Set.subset_inter_iff.symm

end BruhatChainComplex

section GlobalPath

variable {ι : Type u} {M : Type w} {N : Type x} [AddCommGroup M] [AddCommGroup N]
  {P : RootPairing ι ℤ M N} {b : P.Base} [Finite ι] [P.IsReduced] {lam : M}
  {V : Type*} [AddCommGroup V] [Module ℝ V]

private noncomputable def supportStandardSimplex
    (x : (bruhatChainComplex P b lam).Realization) :
    _root_.AbstractSimplicialComplex.StandardSimplex x.val.support :=
  ⟨x.val, by
    simpa only [_root_.AbstractSimplicialComplex.carrier_val] using
      _root_.AbstractSimplicialComplex.mem_convexHull_carrier _ x⟩

private noncomputable def chainVertexEquiv
    {σ : Finset {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}}
    (hσ : σ ∈ bruhatChainComplex P b lam) : Fin σ.card ≃ ↥σ :=
  letI := (weylCoxeterSystem P b).bruhatPartialOrder
  Fin.revPerm.trans (AbstractSimplicialComplex.orderIsoFinOfMemOrderComplex hσ).toEquiv

private theorem chainVertexEquiv_apply
    {σ : Finset {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}}
    (hσ : σ ∈ bruhatChainComplex P b lam) (k : Fin σ.card) :
    chainVertexEquiv hσ k =
      letI := (weylCoxeterSystem P b).bruhatPartialOrder
      AbstractSimplicialComplex.orderIsoFinOfMemOrderComplex hσ k.rev :=
  (rfl)

private theorem bruhatLE_chainVertexEquiv_iff
    {σ : Finset {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}}
    (hσ : σ ∈ bruhatChainComplex P b lam) {i j : Fin σ.card} :
    (weylCoxeterSystem P b).BruhatLE
      (chainVertexEquiv hσ j).val.val (chainVertexEquiv hσ i).val.val ↔ i ≤ j := by
  let : PartialOrder P.weylGroup := (weylCoxeterSystem P b).bruhatPartialOrder
  rw [chainVertexEquiv_apply, chainVertexEquiv_apply, ← CoxeterSystem.bruhatPartialOrder_le,
    Subtype.coe_le_coe, Subtype.coe_le_coe, OrderIso.le_iff_le, Fin.rev_le_rev]

private noncomputable def bruhatFacePath (f : M →+ V)
    (σ : Finset {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w})
    (hσ : σ ∈ bruhatChainComplex P b lam) (w : Convexity.StdSimplex ℝ ↥σ) : PLPath ℝ V :=
  PLPath.chainSimplexPath
    (fun k : Fin σ.card ↦ f ((chainVertexEquiv hσ k).val.val • lam))
    (w.map (chainVertexEquiv hσ).symm)

private theorem bruhatFacePath_mono (f : M →+ V)
    {σ τ : Finset {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}}
    (hσ : σ ∈ bruhatChainComplex P b lam) (hτ : τ ∈ bruhatChainComplex P b lam) (hστ : σ ⊆ τ)
    (w : Convexity.StdSimplex ℝ ↥σ) :
    bruhatFacePath f τ hτ (w.map fun a ↦ ⟨a.val, hστ a.property⟩) = bruhatFacePath f σ hσ w := by
  let φ : Fin σ.card →o Fin τ.card :=
    ⟨fun k ↦ (chainVertexEquiv hτ).symm
        ⟨(chainVertexEquiv hσ k).val, hστ (chainVertexEquiv hσ k).property⟩,
      fun i j hij ↦ (bruhatLE_chainVertexEquiv_iff hτ).mp (by
        simpa using (bruhatLE_chainVertexEquiv_iff hσ).mpr hij)⟩
  have hφ : ⇑φ = fun k ↦
      (chainVertexEquiv hτ).symm
        ⟨(chainVertexEquiv hσ k).val, hστ (chainVertexEquiv hσ k).property⟩ :=
    OrderHom.coe_mk _ _
  have hmap :
      ((w.map fun a : ↥σ ↦ (⟨a.val, hστ a.property⟩ : ↥τ)).map (chainVertexEquiv hτ).symm) =
        (w.map (chainVertexEquiv hσ).symm).map φ := by
    rw [← Convexity.StdSimplex.map_comp, ← Convexity.StdSimplex.map_comp]
    congr 1
    funext a
    simp [hφ]
  have hvel :
      ((fun k : Fin τ.card ↦ f ((chainVertexEquiv hτ k).val.val • lam)) ∘ φ) =
        fun k : Fin σ.card ↦ f ((chainVertexEquiv hσ k).val.val • lam) := by
    funext k
    simp [hφ]
  simp only [bruhatFacePath]
  rw [hmap, PLPath.chainSimplexPath_map_orderHom _ φ _, hvel]

/-- Evaluate a point of the Bruhat-chain polyhedron as a piecewise-linear path in `V`, traversing
its support directions in strictly decreasing Bruhat order with durations equal to its barycentric
coordinates. -/
noncomputable def bruhatRealizationPath (f : M →+ V)
    (x : (bruhatChainComplex P b lam).Realization) : PLPath ℝ V :=
  bruhatFacePath f x.val.support
    (_root_.AbstractSimplicialComplex.support_mem (bruhatChainComplex P b lam) x)
    (Finset.standardSimplexHomeomorph x.val.support (supportStandardSimplex x))

/-- **Compatibility of global path evaluation with fixed-chain simplices.** On every weakly
decreasing Bruhat sequence `dir`, `bruhatRealizationPath` agrees with `PLPath.chainSimplexPath`
(automatically merging equal adjacent directions and dropping zero-weight vertices). -/
@[simp]
theorem bruhatRealizationPath_chainSimplexToRealization (f : M →+ V) {l : ℕ}
    (dir : Fin (l + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w})
    (hdir : ∀ j : Fin l, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val)
    (w : Convexity.StdSimplex ℝ (Fin (l + 1))) :
    bruhatRealizationPath f (chainSimplexToRealization dir hdir w) =
      PLPath.chainSimplexPath (fun j ↦ f ((dir j).val • lam)) w := by
  set x := chainSimplexToRealization dir hdir w
  let τ := Finset.univ.image dir
  have hτ : τ ∈ bruhatChainComplex P b lam := image_dir_mem_bruhatChainComplex dir hdir
  have hστ : x.val.support ⊆ τ := fun u hu ↦ by
    rw [chainSimplexToRealization_val] at hu
    exact Finset.image_subset_image (Finset.subset_univ _) (Finsupp.mapDomain_support hu)
  let g : Fin (l + 1) → ↥τ := fun j ↦ ⟨dir j, Finset.mem_image_of_mem dir (Finset.mem_univ j)⟩
  have hpush :
      (Finset.standardSimplexHomeomorph x.val.support (supportStandardSimplex x)).map
        (fun a ↦ (⟨a.val, hστ a.property⟩ : ↥τ)) = w.map g := by
    apply Convexity.StdSimplex.ext
    apply Finsupp.mapDomain_injective Subtype.val_injective
    rw [Convexity.StdSimplex.weights_map, Convexity.StdSimplex.weights_map,
      ← Finsupp.mapDomain_comp, ← Finsupp.mapDomain_comp]
    have hcomp₁ :
        (Subtype.val : ↥τ → _) ∘ (fun a : ↥x.val.support ↦ (⟨a.val, hστ a.property⟩ : ↥τ)) =
          (Subtype.val : ↥x.val.support → _) := by
      funext a
      simp
    have hcomp₂ : (Subtype.val : ↥τ → _) ∘ g = dir := by
      funext j
      simp [g]
    rw [hcomp₁, hcomp₂, ← Finset.standardSimplexHomeomorph_symm_val, Homeomorph.symm_apply_apply]
    exact chainSimplexToRealization_val dir hdir w
  rw [bruhatRealizationPath, ← bruhatFacePath_mono f _ hτ hστ, hpush]
  let ψ : Fin (l + 1) →o Fin τ.card :=
    ⟨fun j ↦ (chainVertexEquiv hτ).symm (g j),
      Fin.monotone_iff_le_succ.mpr fun j ↦ (bruhatLE_chainVertexEquiv_iff hτ).mp (by
        simpa [g] using hdir j)⟩
  have hcomp : ((w.map g).map (chainVertexEquiv hτ).symm) = w.map ψ := by
    rw [← Convexity.StdSimplex.map_comp]
    exact congrArg (w.map ·) (OrderHom.coe_mk _ _).symm
  simp only [bruhatFacePath]
  rw [hcomp, PLPath.chainSimplexPath_map_orderHom _ ψ w]
  congr 1
  funext j
  simp [ψ, g]

/-- At a vertex `τ` of the Bruhat-chain polyhedron, `bruhatRealizationPath` evaluates to the
straight path along `f (τ • lam)`. -/
@[simp]
theorem bruhatRealizationPath_vertex (f : M →+ V)
    (τ : {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}) :
    bruhatRealizationPath f
      (_root_.AbstractSimplicialComplex.vertex (bruhatChainComplex P b lam) τ) =
      PLPath.straight ℝ (f (τ.val • lam)) := by
  rw [← chainSimplexToRealization_single (fun _ : Fin 1 ↦ τ) (fun j ↦ j.elim0) 0,
    bruhatRealizationPath_chainSimplexToRealization, PLPath.chainSimplexPath_single]

private noncomputable def bruhatSupportVertex
    (x : (bruhatChainComplex P b lam).Realization) :
    Fin x.val.support.card ≃ ↥x.val.support :=
  chainVertexEquiv (_root_.AbstractSimplicialComplex.support_mem _ x)

private noncomputable def bruhatSupportSimplex
    (x : (bruhatChainComplex P b lam).Realization) :
    Convexity.StdSimplex ℝ (Fin x.val.support.card) :=
  (Finset.standardSimplexHomeomorph x.val.support (supportStandardSimplex x)).map
    (bruhatSupportVertex x).symm

private theorem weights_bruhatSupportSimplex_apply
    (x : (bruhatChainComplex P b lam).Realization) (k : Fin x.val.support.card) :
    (bruhatSupportSimplex x).weights k = x.val (bruhatSupportVertex x k).val := by
  have hk : k = (bruhatSupportVertex x).symm (bruhatSupportVertex x k) :=
    ((bruhatSupportVertex x).symm_apply_apply k).symm
  nth_rw 1 [hk]
  rw [bruhatSupportSimplex,
    Convexity.StdSimplex.weights_map_apply_of_injective (bruhatSupportVertex x).symm.injective]
  simp [supportStandardSimplex]

/-- Every point of `(bruhatChainComplex P b lam).Realization` lies in the open interior of a
fixed-chain simplex `chainSimplexToRealization dir hdir` along a strictly decreasing (injective)
Bruhat chain `dir`. Together with `bruhatRealizationPath_chainSimplexToRealization`, this gives a
public evaluation route for `bruhatRealizationPath` at arbitrary points. -/
theorem exists_chainSimplexToRealization_eq (x : (bruhatChainComplex P b lam).Realization) :
    ∃ (l : ℕ)
      (dir : Fin (l + 1) →
        {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w})
      (hdir : ∀ j : Fin l, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val),
      Function.Injective dir ∧
      ∃ w : Convexity.StdSimplex ℝ (Fin (l + 1)),
        (∀ j, 0 < w.weights j) ∧ chainSimplexToRealization dir hdir w = x := by
  have hmem := _root_.AbstractSimplicialComplex.support_mem (bruhatChainComplex P b lam) x
  have hne : 0 < x.val.support.card :=
    Finset.card_pos.mpr (mem_bruhatChainComplex_iff.mp hmem).1
  let l := x.val.support.card - 1
  have hl : l + 1 = x.val.support.card := Nat.sub_add_cancel hne
  let e : Fin (l + 1) ≃o Fin x.val.support.card := Fin.castOrderIso hl
  let dir : Fin (l + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w} :=
    fun j ↦ (bruhatSupportVertex x (e j)).val
  have hdir : ∀ j : Fin l,
      (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val := fun j ↦
    (bruhatLE_chainVertexEquiv_iff hmem).mpr (e.monotone j.castSucc_le_succ)
  have hinj : Function.Injective dir := fun i j hij ↦
    e.injective ((bruhatSupportVertex x).injective (Subtype.ext hij))
  let w : Convexity.StdSimplex ℝ (Fin (l + 1)) := (bruhatSupportSimplex x).map e.symm
  refine ⟨l, dir, hdir, hinj, w, fun j ↦ ?_, Subtype.ext ?_⟩
  · have hwt : w.weights j = (bruhatSupportSimplex x).weights (e j) := by
      have hj : j = e.symm (e j) := (e.symm_apply_apply j).symm
      nth_rw 1 [hj]
      exact Convexity.StdSimplex.weights_map_apply_of_injective e.symm.injective _ _
    rw [hwt, weights_bruhatSupportSimplex_apply]
    exact _root_.AbstractSimplicialComplex.Realization.pos_of_mem_support _ x
      (bruhatSupportVertex x (e j)).property
  · rw [chainSimplexToRealization_val]
    simp only [w, bruhatSupportSimplex, Convexity.StdSimplex.weights_map,
      ← Finsupp.mapDomain_comp]
    have hcomp : dir ∘ ⇑e.symm ∘ ⇑(bruhatSupportVertex x).symm = Subtype.val := by
      funext u
      simp [dir, e]
    rw [hcomp, ← Finset.standardSimplexHomeomorph_symm_val, Homeomorph.symm_apply_apply]
    simp only [supportStandardSimplex]

private theorem bruhatRealizationPath_eq_chainSimplexPath_support (f : M →+ V)
    (x : (bruhatChainComplex P b lam).Realization) :
    bruhatRealizationPath f x =
      PLPath.chainSimplexPath (fun k ↦ f ((bruhatSupportVertex x k).val.val • lam))
        (bruhatSupportSimplex x) := by
  simp only [bruhatRealizationPath, bruhatFacePath, bruhatSupportVertex, bruhatSupportSimplex]

private theorem isDistinguished_bruhatSupportTimed {f : M →+ V}
    (hlam : lam ∈ dominantChamber P b)
    (hf : Set.InjOn f (Set.range fun w : P.weylGroup ↦ w • lam))
    (x : (bruhatChainComplex P b lam).Realization) :
    PLPath.IsDistinguished (Set.range fun w : P.weylGroup ↦ f (w • lam))
      (PLPath.chainSimplexTimed
        (fun k ↦ f ((bruhatSupportVertex x k).val.val • lam)) (bruhatSupportSimplex x)) := by
  have := P.flip_isReduced
  refine PLPath.isDistinguished_chainSimplexTimed
    (S := Set.range fun w : P.weylGroup ↦ f (w • lam))
    (fun k ↦ ⟨(bruhatSupportVertex x k).val.val, rfl⟩) (fun k hk h ↦ ?_) (fun k ↦ ?_)
  · have heq := eq_of_isMinimalCosetRep_of_apply_smul_eq hlam hf h
    exact (Fin.ne_of_lt (Nat.lt_succ_self k.val) : k ≠ ⟨k.val + 1, hk⟩)
      ((bruhatSupportVertex x).injective (Subtype.ext heq))
  · rw [weights_bruhatSupportSimplex_apply]
    exact _root_.AbstractSimplicialComplex.Realization.pos_of_mem_support _ x
      (bruhatSupportVertex x k).property

private theorem eq_of_bruhatSupportVertex_eq
    {x₁ x₂ : (bruhatChainComplex P b lam).Realization}
    (hcard : x₁.val.support.card = x₂.val.support.card)
    (hval : ∀ k : Fin x₁.val.support.card,
      x₁.val (bruhatSupportVertex x₁ k).val = x₂.val (bruhatSupportVertex x₂ (k.cast hcard)).val ∧
        (bruhatSupportVertex x₁ k).val = (bruhatSupportVertex x₂ (k.cast hcard)).val) :
    x₁ = x₂ := by
  have hsupp : x₁.val.support = x₂.val.support := by
    ext u
    constructor
    · intro hu
      let k := (bruhatSupportVertex x₁).symm ⟨u, hu⟩
      have hk : (bruhatSupportVertex x₁ k).val = u :=
        congrArg Subtype.val ((bruhatSupportVertex x₁).apply_symm_apply ⟨u, hu⟩)
      rw [← hk, (hval k).2]
      exact (bruhatSupportVertex x₂ (k.cast hcard)).property
    · intro hu
      let k₂ := (bruhatSupportVertex x₂).symm ⟨u, hu⟩
      let k := k₂.cast hcard.symm
      have hk₂ : (bruhatSupportVertex x₂ (k.cast hcard)).val = u := by simp [k, k₂]
      rw [← hk₂, ← (hval k).2]
      exact (bruhatSupportVertex x₁ k).property
  apply Subtype.ext
  ext u
  by_cases hu : u ∈ x₁.val.support
  · let k := (bruhatSupportVertex x₁).symm ⟨u, hu⟩
    have hk : (bruhatSupportVertex x₁ k).val = u :=
      congrArg Subtype.val ((bruhatSupportVertex x₁).apply_symm_apply ⟨u, hu⟩)
    rw [← hk, (hval k).1, (hval k).2]
  · have hu₂ : u ∉ x₂.val.support := hsupp ▸ hu
    rw [Finsupp.notMem_support_iff.mp hu, Finsupp.notMem_support_iff.mp hu₂]

/-- **Global injectivity of path evaluation on the Bruhat-chain polyhedron.** For a dominant
weight `λ` and an additive map `f` injective on the Weyl orbit of `λ` whose realized orbit has no
two distinct weights in the same ray, distinct points of `(bruhatChainComplex P b lam).Realization`
evaluate to distinct piecewise-linear paths. -/
theorem bruhatRealizationPath_injective {f : M →+ V} (hlam : lam ∈ dominantChamber P b)
    (hf : Set.InjOn f (Set.range fun w : P.weylGroup ↦ w • lam))
    (hS : (Set.range fun w : P.weylGroup ↦ f (w • lam)).Pairwise fun u v ↦ ¬ SameRay ℝ u v) :
    Function.Injective (bruhatRealizationPath (P := P) (b := b) (lam := lam) f) := by
  have := P.flip_isReduced
  intro x₁ x₂ hp
  have htimed :
      PLPath.chainSimplexTimed
          (fun k ↦ f ((bruhatSupportVertex x₁ k).val.val • lam)) (bruhatSupportSimplex x₁) =
        PLPath.chainSimplexTimed
          (fun k ↦ f ((bruhatSupportVertex x₂ k).val.val • lam)) (bruhatSupportSimplex x₂) := by
    refine (isDistinguished_bruhatSupportTimed hlam hf x₁).unique
      (isDistinguished_bruhatSupportTimed hlam hf x₂) hS ?_
    rw [PLPath.ofSegments_map_snd_chainSimplexTimed, PLPath.ofSegments_map_snd_chainSimplexTimed,
      ← bruhatRealizationPath_eq_chainSimplexPath_support,
      ← bruhatRealizationPath_eq_chainSimplexPath_support, hp]
  have hcard : x₁.val.support.card = x₂.val.support.card := by
    simpa [PLPath.chainSimplexTimed_def] using congrArg List.length htimed
  rw [PLPath.chainSimplexTimed_def, PLPath.chainSimplexTimed_def,
    List.ofFn_congr hcard.symm] at htimed
  have hentry (k : Fin x₁.val.support.card) := congrFun (List.ofFn_injective htimed) k
  refine eq_of_bruhatSupportVertex_eq hcard fun k ↦ ?_
  have hfst : x₁.val (bruhatSupportVertex x₁ k).val =
      x₂.val (bruhatSupportVertex x₂ (k.cast hcard)).val := by
    simpa [weights_bruhatSupportSimplex_apply] using congrArg Prod.fst (hentry k)
  have hsnd : x₁.val (bruhatSupportVertex x₁ k).val • f ((bruhatSupportVertex x₁ k).val.val • lam) =
      x₂.val (bruhatSupportVertex x₂ (k.cast hcard)).val •
        f ((bruhatSupportVertex x₂ (k.cast hcard)).val.val • lam) := by
    simpa [weights_bruhatSupportSimplex_apply] using congrArg Prod.snd (hentry k)
  rw [hfst] at hsnd
  have hpos := _root_.AbstractSimplicialComplex.Realization.pos_of_mem_support _ x₂
    (bruhatSupportVertex x₂ (k.cast hcard)).property
  exact ⟨hfst, eq_of_isMinimalCosetRep_of_smul_apply_smul_eq hlam hf hpos.ne' hsnd⟩

end GlobalPath

section LSSubset

variable {ι : Type u} {M : Type w} {N : Type x} [AddCommGroup M] [AddCommGroup N]
  {P : RootPairing ι ℤ M N} {b : P.Base} [Finite ι] [P.IsReduced] {lam : M}

/-- Embed a Lakshmibai–Seshadri path `π` into the Bruhat-chain polyhedron at the barycentric point
determined by its segment durations along `π.dir`. -/
noncomputable def toBruhatRealization (π : LSPath P b lam) :
    (bruhatChainComplex P b lam).Realization :=
  chainSimplexToRealization π.dir (fun j ↦ π.bruhatLE_dir_succ j)
    (π.durationSimplex.mapRange (Rat.castHom ℝ) Rat.cast_mono)

/-- The barycentric coordinates of `π.toBruhatRealization` push its rational segment durations
forward along `π.dir`. -/
@[simp]
theorem toBruhatRealization_val (π : LSPath P b lam) :
    (π.toBruhatRealization :
        {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w} →₀ ℝ) =
      ((π.durationSimplex.mapRange (Rat.castHom ℝ) Rat.cast_mono).weights).mapDomain π.dir :=
  chainSimplexToRealization_val _ _ _

/-- The support of `π.toBruhatRealization` as a `Finset` is the image of `π.dir`. -/
-- Fires before `toBruhatRealization_val` rewrites the coordinate vector to `Finsupp.mapDomain`.
@[simp↓]
theorem support_toBruhatRealization (π : LSPath P b lam) :
    π.toBruhatRealization.val.support = Finset.univ.image π.dir := by
  let w := π.durationSimplex.mapRange (Rat.castHom ℝ) Rat.cast_mono
  rw [toBruhatRealization_val, Finsupp.support_mapDomain_of_nonneg w.nonneg]
  simp [w, Convexity.StdSimplex.support_weights_mapRange Rat.cast_mono (Rat.castHom ℝ).injective]

/-- The support of `π.toBruhatRealization` as a `Set` is the exact set of directions visited by
`π`. -/
theorem coe_support_toBruhatRealization (π : LSPath P b lam) :
    (π.toBruhatRealization.val.support : Set _) = Set.range π.dir := by
  simp [support_toBruhatRealization]

/-- `LSPath.single τ` embeds at the realization vertex `τ`. -/
@[simp]
theorem toBruhatRealization_single
    (τ : {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}) :
    (single τ : LSPath P b lam).toBruhatRealization =
      _root_.AbstractSimplicialComplex.vertex (bruhatChainComplex P b lam) τ := by
  simp [toBruhatRealization]

/-- `LSPath.straight lam` embeds at the identity minimal coset representative vertex. -/
@[simp]
theorem toBruhatRealization_straight :
    (straight lam : LSPath P b lam).toBruhatRealization =
      _root_.AbstractSimplicialComplex.vertex (bruhatChainComplex P b lam)
        ⟨1, (weylCoxeterSystem P b).isMinimalCosetRep_one _⟩ := by
  rw [← single_one, toBruhatRealization_single]

/-- Global path evaluation on `π.toBruhatRealization` recovers `π.toPLPath ℝ f`. -/
@[simp]
theorem bruhatRealizationPath_toBruhatRealization {V : Type*} [AddCommGroup V] [Module ℝ V]
    (f : M →+ V) (π : LSPath P b lam) :
    bruhatRealizationPath f π.toBruhatRealization = π.toPLPath ℝ f := by
  rw [toBruhatRealization, bruhatRealizationPath_chainSimplexToRealization,
    π.chainSimplexPath_durationSimplex ℝ f]

private theorem dir_eq_of_toBruhatRealization_eq {π₁ π₂ : LSPath P b lam}
    (h : π₁.toBruhatRealization = π₂.toBruhatRealization) :
    ∃ hlen : π₁.length = π₂.length,
      π₁.dir = fun j ↦ π₂.dir (j.cast (congrArg (· + 1) hlen)) := by
  let : PartialOrder P.weylGroup := (weylCoxeterSystem P b).bruhatPartialOrder
  have hrange : Set.range π₁.dir = Set.range π₂.dir := by
    rw [← coe_support_toBruhatRealization, ← coe_support_toBruhatRealization, h]
  have hlen : π₁.length = π₂.length := by
    have hcard := congrArg Set.ncard hrange
    rw [Set.ncard_range_of_injective π₁.dir_injective,
      Set.ncard_range_of_injective π₂.dir_injective, Nat.card_fin, Nat.card_fin] at hcard
    omega
  let e : Fin (π₁.length + 1) ≃o Fin (π₂.length + 1) :=
    Fin.castOrderIso (congrArg (· + 1) hlen)
  let g : Fin (π₁.length + 1) → _ := π₂.dir ∘ e
  have hg_range : Set.range π₁.dir = Set.range g := by
    rw [hrange, Set.range_comp, e.surjective.range_eq, Set.image_univ]
  exact ⟨hlen,
    (π₁.strictAnti_dir.range_inj_of_wellFoundedGT (π₂.strictAnti_dir.comp_strictMono
      e.strictMono)).mp hg_range⟩

/-- `LSPath.toBruhatRealization` is injective for every weight `λ`. -/
theorem toBruhatRealization_injective :
    Function.Injective (toBruhatRealization (P := P) (b := b) (lam := lam)) := by
  intro π₁ π₂ h
  obtain ⟨hlen, hdir_eq⟩ := dir_eq_of_toBruhatRealization_eq h
  have hdur (j : Fin (π₁.length + 1)) :
      π₁.duration j = π₂.duration (j.cast (congrArg (· + 1) hlen)) := by
    have hval := congrArg (fun x : (bruhatChainComplex P b lam).Realization ↦ x.val (π₁.dir j)) h
    rw [toBruhatRealization_val, toBruhatRealization_val,
      Finsupp.mapDomain_apply_of_injective π₁.dir_injective] at hval
    have hgj : π₁.dir j = π₂.dir (j.cast (congrArg (· + 1) hlen)) := congrFun hdir_eq j
    rw [hgj, Finsupp.mapDomain_apply_of_injective π₂.dir_injective] at hval
    simpa using hval
  have hsimp : π₁.durationSimplex.map (finCongr (congrArg (· + 1) hlen)) =
      π₂.durationSimplex := by
    ext j
    obtain ⟨i, rfl⟩ := (finCongr (congrArg (· + 1) hlen)).surjective j
    rw [Convexity.StdSimplex.weights_map_apply_of_injective (finCongr _).injective]
    simpa [finCongr_apply] using hdur i
  apply LSPath.ext
  · rw [List.ofFn_congr (congrArg (· + 1) hlen).symm]
    exact congrArg List.ofFn hdir_eq
  · rw [List.ofFn_congr (congrArg (· + 2) hlen).symm]
    apply congrArg List.ofFn
    funext k
    rw [← π₁.prefixSum_durationSimplex, ← π₂.prefixSum_durationSimplex, ← hsimp,
      Convexity.StdSimplex.prefixSum_map_finCongr]
    simp

/-- Two Lakshmibai–Seshadri paths embed to the same point of the Bruhat-chain polyhedron if and
only if they are equal. -/
@[simp]
theorem toBruhatRealization_inj {π₁ π₂ : LSPath P b lam} :
    π₁.toBruhatRealization = π₂.toBruhatRealization ↔ π₁ = π₂ :=
  toBruhatRealization_injective.eq_iff

/-- **Closed-simplex characterization in the Bruhat-chain polyhedron.** Along an injective weakly
decreasing Bruhat sequence `dir` (such as any strictly decreasing Bruhat chain), a point `x` of the
closed simplex `StdSimplex ℝ (Fin (l + 1))` maps into the Lakshmibai–Seshadri subset of
`(bruhatChainComplex P b lam).Realization` if and only if `x ∈ lsChainSimplexSet ℝ dir` (with no
ray or dominance hypotheses needed on `λ`). -/
theorem chainSimplexToRealization_mem_range_toBruhatRealization_iff {l : ℕ}
    {dir : Fin (l + 1) →
      {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w}}
    (hdir : ∀ j : Fin l, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val)
    (hinj : Function.Injective dir)
    (x : Convexity.StdSimplex ℝ (Fin (l + 1))) :
    chainSimplexToRealization dir hdir x ∈
        Set.range (toBruhatRealization (P := P) (b := b) (lam := lam)) ↔
      x ∈ lsChainSimplexSet ℝ dir := by
  rw [mem_lsChainSimplexSet_iff]
  constructor
  · rintro ⟨π, hπ⟩
    let : PartialOrder P.weylGroup := (weylCoxeterSystem P b).bruhatPartialOrder
    have hsub : Set.range π.dir ⊆ Set.range dir := by
      rw [← coe_support_toBruhatRealization, hπ]
      exact (range_chainSimplexToRealization dir hdir).subset ⟨x, rfl⟩
    let g : Fin (π.length + 1) → Fin (l + 1) := fun i ↦ (hsub ⟨i, rfl⟩).choose
    have hg (i : Fin (π.length + 1)) : dir (g i) = π.dir i := (hsub ⟨i, rfl⟩).choose_spec
    have hant : Antitone dir := antitone_of_bruhatLE_succ hdir
    have hg_mono : StrictMono g := fun i₁ i₂ hi ↦ by
      by_contra! hle
      exact (π.strictAnti_dir hi).not_ge (by rw [← hg i₁, ← hg i₂]; exact hant hle)
    let φ : Fin (π.length + 1) ↪o Fin (l + 1) := OrderEmbedding.ofStrictMono g hg_mono
    have hcomp : dir ∘ φ = π.dir := funext hg
    refine ⟨π, φ, hcomp, chainSimplexToRealization_injective hdir hinj (Subtype.ext ?_)⟩
    rw [chainSimplexToRealization_val, Convexity.StdSimplex.weights_map,
      ← Finsupp.mapDomain_comp, hcomp, ← toBruhatRealization_val, hπ]
  · rintro ⟨π, φ, hcomp, rfl⟩
    refine ⟨π, Subtype.ext ?_⟩
    simp only [toBruhatRealization_val, chainSimplexToRealization_val,
      Convexity.StdSimplex.weights_map, ← Finsupp.mapDomain_comp, hcomp]

/-- For a dominant shape `λ`, the Lakshmibai–Seshadri subset of the Bruhat-chain polyhedron is
finite. -/
theorem finite_range_toBruhatRealization (hlam : lam ∈ dominantChamber P b) :
    (Set.range (toBruhatRealization (P := P) (b := b) (lam := lam))).Finite := by
  have := LSPath.finite hlam
  exact Set.finite_range _

private theorem eq_toBruhatRealization_straight_of_forall_coroot'_eq_zero
    (hall : ∀ i : b.support, P.coroot' i lam = 0)
    (x : (bruhatChainComplex P b lam).Realization) :
    x = (straight lam).toBruhatRealization := by
  have hwall : P.wallIndices b lam = Set.univ :=
    Set.eq_univ_of_forall fun i ↦ mem_wallIndices.mpr (hall i)
  let u₀ : {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w} :=
    ⟨1, (weylCoxeterSystem P b).isMinimalCosetRep_one _⟩
  have huniq : ∀ u : {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w},
      u = u₀ := by
    intro u
    apply Subtype.ext
    by_contra hu1
    obtain ⟨i, hdesc⟩ := (weylCoxeterSystem P b).exists_rightDescent_of_ne_one hu1
    exact ((weylCoxeterSystem P b).isMinimalCosetRep_iff.mp u.property) i
        (hwall ▸ Set.mem_univ i) hdesc
  apply Subtype.ext
  ext u
  rw [huniq u]
  have hsum₁ := _root_.AbstractSimplicialComplex.Realization.sum_eq_one _ x
  have hsum₂ := _root_.AbstractSimplicialComplex.Realization.sum_eq_one _
    (straight (P := P) (b := b) lam).toBruhatRealization
  rw [Finsupp.sum_eq_single u₀ (fun v _ hvu ↦ absurd (huniq v) hvu) (by simp)] at hsum₁ hsum₂
  exact hsum₁.trans hsum₂.symm

/-- The Bruhat-chain polyhedron `(bruhatChainComplex P b lam).Realization` is uncountable if and
only if `⟨λ, αᵢ^∨⟩ ≠ 0` for some simple root `αᵢ`. -/
theorem uncountable_realization_bruhatChainComplex_iff :
    Uncountable (bruhatChainComplex P b lam).Realization ↔
      ∃ i : b.support, P.coroot' i lam ≠ 0 := by
  constructor
  · intro hunc
    by_contra! hall
    have : Subsingleton (bruhatChainComplex P b lam).Realization :=
      ⟨fun x y ↦ (eq_toBruhatRealization_straight_of_forall_coroot'_eq_zero hall x).trans
        (eq_toBruhatRealization_straight_of_forall_coroot'_eq_zero hall y).symm⟩
    exact not_uncountable hunc
  · rintro ⟨i, hi⟩
    -- Embed the real `1`-simplex injectively along the covering edge `sᵢ > 1`.
    have hcov := minimalCosetRepCovBy_one_simple_of_coroot'_ne_zero hi
    let dir : Fin 2 →
        {w // (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) w} :=
      ![⟨(weylCoxeterSystem P b).simple i, hcov.isMinimalCosetRep_right⟩,
        ⟨1, hcov.isMinimalCosetRep_left⟩]
    have hdir :
        ∀ j : Fin 1, (weylCoxeterSystem P b).BruhatLE (dir j.succ).val (dir j.castSucc).val := by
      intro j
      rw [Subsingleton.elim j 0]
      exact hcov.bruhatLE
    have hinj : Function.Injective dir := by
      intro a c hac
      fin_cases a <;> fin_cases c
      · rfl
      · exact absurd (congrArg Subtype.val hac).symm hcov.ne
      · exact absurd (congrArg Subtype.val hac) hcov.ne
      · rfl
    exact (chainSimplexToRealization_injective hdir hinj).uncountable

/-- **Exact strict-containment criterion.** For any weight `λ`, the Lakshmibai–Seshadri subset is a
strict subset of `(bruhatChainComplex P b lam).Realization` if and only if `λ` pairs nontrivially
with at least one simple coroot. (When all simple-coroot pairings vanish, the polyhedron consists
of a single vertex hit by `LSPath.straight`.) -/
theorem range_toBruhatRealization_ssubset_univ_iff :
    Set.range (toBruhatRealization (P := P) (b := b) (lam := lam)) ⊂ Set.univ ↔
      ∃ i : b.support, P.coroot' i lam ≠ 0 := by
  rw [Set.ssubset_univ_iff]
  constructor
  · intro hne
    by_contra! hall
    exact hne (Set.eq_univ_iff_forall.mpr fun x ↦
      ⟨straight lam, (eq_toBruhatRealization_straight_of_forall_coroot'_eq_zero hall x).symm⟩)
  · intro hex heq
    have := uncountable_realization_bruhatChainComplex_iff.mpr hex
    exact not_surjective_countable_uncountable toBruhatRealization (Set.range_eq_univ.mp heq)

end LSSubset

end TauCeti.LSPath
