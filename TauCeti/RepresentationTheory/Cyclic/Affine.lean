/-!
# Affine maps with a periodic linear part

Let `T` be an additive commutative group, `A : T ≃+ T` an additive automorphism and `t : T`. The
affine permutation `A.affineEquiv t : x ↦ A x + t` of `T` has powers
`(A.affineEquiv t)^k x = A^k x + N_k(t)`, where `N_k(t) = ∑ j < k, A^j t` is the partial norm
of `t`. The basic properties of the cyclic group generated by the affine map are read off from
this formula: when it has order dividing `m`, when it has exact order `m`, how conjugation by a
translation changes the twist `t`, and when its powers have fixed points.

When `A` has order dividing `m`, that is `A^[m] = id`, and `N_m(t) = 0`, the affine map generates
an action of `C_m = Multiplicative (ZMod m)` on `T` (`AddEquiv.cyclicAffineHom`). This action is
faithful exactly when the affine map has exact order `m`, and it is free exactly when no
nonidentity power has a fixed point; for composite `m` every power must be checked. Up to
conjugation by translations, the twists `t` are classified by degree-one group cohomology, as
shown in `TauCeti.RepresentationTheory.Homological.GroupCohomology.CyclicAutomorphism`.

## Main definitions

* `AddEquiv.affineEquiv A t`: the affine permutation `x ↦ A x + t`.
* `AddEquiv.cyclicAffineHom A hA ht`: for `A^[m] = id` and `N_m(t) = 0`, the action of `C_m` on
  `T` in which the generator acts by `A.affineEquiv t`.

## Main results

* `AddEquiv.affineEquiv_pow_apply`: the iterate formula `(A.affineEquiv t)^k x = A^k x + N_k(t)`.
* `AddEquiv.affineEquiv_pow_eq_one_iff`: the `k`-th power is the identity exactly when
  `A^[k] = id` and `N_k(t) = 0`; under `A^[m] = id` the affine map has order dividing `m`
  exactly when `N_m(t) = 0` (`AddEquiv.affineEquiv_pow_eq_one_iff_of_iterate_eq_id`).
* `AddEquiv.orderOf_affineEquiv_eq_iff`: the affine map has exact order `m` exactly when it has
  order dividing `m` and, for every `0 < k < m`, either `A^[k] ≠ id` or `N_k(t) ≠ 0`.
* `AddEquiv.conj_addRight_affineEquiv`: conjugation by the translation by `b` changes the twist
  `t` to `t + (b - A b)`.
* `AddEquiv.affineEquiv_pow_apply_eq_self_iff`: `x` is fixed by the `k`-th power exactly when
  `x - A^k x = N_k(t)`, so the `k`-th power has a fixed point exactly when `N_k(t)` lies in the
  image of `1 - A^k`.
* `AddEquiv.injective_cyclicAffineHom_iff`: the action of `C_m` is faithful exactly when the
  affine map has exact order `m`.
* `AddEquiv.cyclicAffineHom_free_iff`: the action of `C_m` is free exactly when, for every
  `0 < k < m`, the partial norm `N_k(t)` does not lie in the image of `1 - A^k`.
* `AddEquiv.cyclicAffineHom_free_iff_of_prime`: for `m` prime, it suffices to check the
  generator: the action is free exactly when `t` does not lie in the image of `1 - A`.

## References

* W. P. Barth, K. Hulek, C. A. M. Peters, A. Van de Ven, *Compact Complex Surfaces*, second
  edition, Springer (2004), Chapter V, section *Logarithmic transformations*, for the cyclic
  quotients of tori by affine automorphisms.
-/

public section

open Finset

namespace AddEquiv

section AddGroup

variable {T : Type*} [AddGroup T]

/-- The affine permutation `x ↦ A x + t` of `T`, with linear part `A` and twist `t`. -/
def affineEquiv (A : T ≃+ T) (t : T) : Equiv.Perm T :=
  A.toEquiv.trans (Equiv.addRight t)

variable (A : T ≃+ T) (t : T)

@[simp]
theorem affineEquiv_apply (x : T) : A.affineEquiv t x = A x + t :=
  (rfl)

@[simp]
theorem affineEquiv_symm_apply (x : T) : (A.affineEquiv t).symm x = A.symm (x - t) := by
  simp [affineEquiv, sub_eq_add_neg]

/-- An affine permutation determines its linear part and its twist. -/
theorem affineEquiv_inj {A B : T ≃+ T} {t s : T} :
    A.affineEquiv t = B.affineEquiv s ↔ A = B ∧ t = s := by
  refine ⟨fun h ↦ ?_, fun ⟨hAB, hts⟩ ↦ hAB ▸ hts ▸ rfl⟩
  -- Evaluating at `0` recovers the twist, and then the linear part.
  have hts : t = s := by simpa using Equiv.congr_fun h 0
  subst hts
  exact ⟨AddEquiv.ext fun x ↦ by simpa using Equiv.congr_fun h x, rfl⟩

@[simp]
theorem affineEquiv_zero : A.affineEquiv 0 = A.toEquiv := by
  ext x
  simp

@[simp]
theorem refl_affineEquiv : (AddEquiv.refl T).affineEquiv t = Equiv.addRight t := by
  ext x
  simp

/-- The composite of two affine permutations is affine: its linear part is the composite of the
linear parts. -/
@[simp]
theorem affineEquiv_mul_affineEquiv (B : T ≃+ T) (s : T) :
    A.affineEquiv t * B.affineEquiv s = (B.trans A).affineEquiv (A s + t) := by
  ext x
  simp [add_assoc]

/-- The inverse of an affine permutation is affine, with linear part `A⁻¹`. -/
@[simp]
theorem inv_affineEquiv : (A.affineEquiv t)⁻¹ = A.symm.affineEquiv (-A.symm t) := by
  ext x
  simp [Equiv.Perm.inv_def, sub_eq_add_neg]

end AddGroup

variable {T : Type*} [AddCommGroup T] (A : T ≃+ T) (t : T)

/-- **Conjugation by a translation.** Conjugating `x ↦ A x + t` by the translation by `b` gives
the affine map with the same linear part and twist `t + (b - A b)`. -/
theorem conj_addRight_affineEquiv (b : T) :
    MulAut.conj (Equiv.addRight b) (A.affineEquiv t) = A.affineEquiv (t + (b - A b)) := by
  ext x
  simp only [MulAut.conj_apply, Equiv.Perm.mul_apply, Equiv.Perm.inv_def, Equiv.coe_addRight,
    Equiv.addRight_symm, affineEquiv_apply, map_add, map_neg]
  abel

/-! ### Powers of an affine map -/

/-- **The iterate formula.** The `k`-th power of `x ↦ A x + t` sends `x` to
`A^k x + ∑ j < k, A^j t`. -/
theorem affineEquiv_pow_apply (k : ℕ) (x : T) :
    (A.affineEquiv t ^ k) x = (⇑A)^[k] x + ∑ j ∈ range k, (⇑A)^[j] t := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', Equiv.Perm.mul_apply, ih]
    simp [sum_range_succ', Function.iterate_succ_apply', add_assoc]

/-- The `k`-th power of `x ↦ A x + t` is the identity exactly when `A^[k] = id` and the partial
norm `∑ j < k, A^j t` vanishes. -/
theorem affineEquiv_pow_eq_one_iff (k : ℕ) :
    A.affineEquiv t ^ k = 1 ↔ (⇑A)^[k] = id ∧ ∑ j ∈ range k, (⇑A)^[j] t = 0 := by
  refine ⟨fun h ↦ ?_, fun ⟨hA, ht⟩ ↦ ?_⟩
  · -- Evaluating at `0` gives the partial norm, and then the linear part.
    have ht : ∑ j ∈ range k, (⇑A)^[j] t = 0 := by
      simpa [affineEquiv_pow_apply, iterate_map_zero] using Equiv.congr_fun h 0
    refine ⟨funext fun x ↦ ?_, ht⟩
    simpa [affineEquiv_pow_apply, ht] using Equiv.congr_fun h x
  · ext x
    simp [affineEquiv_pow_apply, hA, ht]

/-- **Order dividing `m`.** When `A` has order dividing `m`, the affine map `x ↦ A x + t` has
order dividing `m` exactly when the norm `∑ j < m, A^j t` vanishes. -/
theorem affineEquiv_pow_eq_one_iff_of_iterate_eq_id {m : ℕ} (hA : (⇑A)^[m] = id) :
    A.affineEquiv t ^ m = 1 ↔ ∑ j ∈ range m, (⇑A)^[j] t = 0 := by
  rw [affineEquiv_pow_eq_one_iff, and_iff_right hA]

/-- **Exact order `m`.** The affine map `x ↦ A x + t` has exact order `m > 0` exactly when it has
order dividing `m`, that is `A^[m] = id` and `∑ j < m, A^j t = 0`, and no smaller positive power
is the identity: for every `0 < k < m`, either `A^[k] ≠ id` or `∑ j < k, A^j t ≠ 0`. -/
theorem orderOf_affineEquiv_eq_iff {m : ℕ} (hm : 0 < m) :
    orderOf (A.affineEquiv t) = m ↔
      ((⇑A)^[m] = id ∧ ∑ j ∈ range m, (⇑A)^[j] t = 0) ∧
        ∀ k, 0 < k → k < m → (⇑A)^[k] ≠ id ∨ ∑ j ∈ range k, (⇑A)^[j] t ≠ 0 := by
  rw [orderOf_eq_iff hm, affineEquiv_pow_eq_one_iff]
  refine and_congr_right' ⟨fun h k hk hkm ↦ ?_, fun h k hkm hk ↦ ?_⟩
  · rw [← not_and_or, ← affineEquiv_pow_eq_one_iff]
    exact h k hkm hk
  · rw [Ne, affineEquiv_pow_eq_one_iff, not_and_or]
    exact h k hk hkm

/-! ### Fixed points of the powers -/

/-- **Fixed points of a power.** A point `x` is fixed by the `k`-th power of `x ↦ A x + t`
exactly when `x - A^k x = ∑ j < k, A^j t`. -/
theorem affineEquiv_pow_apply_eq_self_iff (k : ℕ) (x : T) :
    (A.affineEquiv t ^ k) x = x ↔ x - (⇑A)^[k] x = ∑ j ∈ range k, (⇑A)^[j] t := by
  rw [affineEquiv_pow_apply, sub_eq_iff_eq_add', eq_comm]

/-- **The fixed-point criterion.** The `k`-th power of `x ↦ A x + t` has a fixed point exactly
when the partial norm `∑ j < k, A^j t` lies in the image of `1 - A^k`. -/
theorem exists_affineEquiv_pow_apply_eq_self_iff (k : ℕ) :
    (∃ x, (A.affineEquiv t ^ k) x = x) ↔ ∃ b, b - (⇑A)^[k] b = ∑ j ∈ range k, (⇑A)^[j] t :=
  exists_congr (affineEquiv_pow_apply_eq_self_iff A t k)

/-! ### The cyclic action -/

variable {m : ℕ} [NeZero m] {A t} (hA : (⇑A)^[m] = id) (ht : ∑ j ∈ range m, (⇑A)^[j] t = 0)

variable (A t) in
/-- For `A` of order dividing `m` and `∑ j < m, A^j t = 0`, the action of the cyclic group
`C_m = Multiplicative (ZMod m)` on `T` in which the generator `ofAdd 1` acts by `x ↦ A x + t`.
It is faithful exactly when the affine map has exact order `m`
(`AddEquiv.injective_cyclicAffineHom_iff`). -/
noncomputable def cyclicAffineHom : Multiplicative (ZMod m) →* Equiv.Perm T :=
  (TauCeti.zmodMonoidHomEquiv m (Equiv.Perm T)).symm
    ⟨A.affineEquiv t, (affineEquiv_pow_eq_one_iff_of_iterate_eq_id A t hA).2 ht⟩

/-- The element `a` of `C_m` acts by the `a.val`-th power of `x ↦ A x + t`. -/
theorem cyclicAffineHom_ofAdd (a : ZMod m) :
    A.cyclicAffineHom t hA ht (.ofAdd a) = A.affineEquiv t ^ a.val :=
  TauCeti.zmodMonoidHomEquiv_symm_apply _ _

/-- The generator `ofAdd 1` of `C_m` acts by `x ↦ A x + t`. -/
@[simp]
theorem cyclicAffineHom_ofAdd_one :
    A.cyclicAffineHom t hA ht (.ofAdd 1) = A.affineEquiv t :=
  TauCeti.zmodMonoidHomEquiv_symm_apply_ofAdd_one _

/-- The action of `C_m` generated by `x ↦ A x + t` is free, that is every point has trivial
stabilizer, exactly when no power `0 < k < m` of the affine map has a fixed point. -/
private theorem cyclicAffineHom_free_iff_pow :
    (∀ g x, A.cyclicAffineHom t hA ht g x = x → g = 1) ↔
      ∀ k, 0 < k → k < m → ∀ x, (A.affineEquiv t ^ k) x ≠ x := by
  have h : (∀ g x, A.cyclicAffineHom t hA ht g x = x → g = 1) ↔
      ∀ g, g ≠ 1 → ∀ x, A.cyclicAffineHom t hA ht g x ≠ x :=
    ⟨fun h g hg x hx ↦ hg (h g x hx), fun h g x hx ↦ by_contra fun hg ↦ h g hg x hx⟩
  rw [h, Multiplicative.forall_zmod_ne_one_iff]
  refine forall_congr' fun k ↦ forall_congr' fun _ ↦ forall_congr' fun hkm ↦ ?_
  rw [cyclicAffineHom_ofAdd, ZMod.val_natCast, Nat.mod_eq_of_lt hkm]

/-- **Faithfulness.** The action of `C_m` generated by `x ↦ A x + t` is faithful exactly when the
affine map has exact order `m`. -/
theorem injective_cyclicAffineHom_iff :
    Function.Injective (A.cyclicAffineHom t hA ht) ↔ orderOf (A.affineEquiv t) = m := by
  have h : Function.Injective (A.cyclicAffineHom t hA ht) ↔
      ∀ g, g ≠ 1 → A.cyclicAffineHom t hA ht g ≠ 1 := by
    rw [injective_iff_map_eq_one]
    exact ⟨fun h g hg hg' ↦ hg (h g hg'), fun h g hg ↦ by_contra fun hg' ↦ h g hg' hg⟩
  rw [h, Multiplicative.forall_zmod_ne_one_iff, orderOf_eq_iff (Nat.pos_of_neZero m),
    and_iff_right ((affineEquiv_pow_eq_one_iff_of_iterate_eq_id A t hA).2 ht)]
  refine forall_congr' fun k ↦ ⟨fun h hkm hk ↦ ?_, fun h hk hkm ↦ ?_⟩
  · simpa [cyclicAffineHom_ofAdd, Nat.mod_eq_of_lt hkm] using h hk hkm
  · simpa [cyclicAffineHom_ofAdd, Nat.mod_eq_of_lt hkm] using h hkm hk

/-- **Freeness.** The action of `C_m` generated by `x ↦ A x + t` is free exactly when, for every
`0 < k < m`, the partial norm `∑ j < k, A^j t` does not lie in the image of `1 - A^k`. For
composite `m`, checking the generator alone does not suffice. -/
theorem cyclicAffineHom_free_iff :
    (∀ g x, A.cyclicAffineHom t hA ht g x = x → g = 1) ↔
      ∀ k, 0 < k → k < m → ∀ b, b - (⇑A)^[k] b ≠ ∑ j ∈ range k, (⇑A)^[j] t := by
  rw [cyclicAffineHom_free_iff_pow]
  simp only [Ne, affineEquiv_pow_apply_eq_self_iff]

/-- **Freeness in prime order.** For `m` prime, the action of `C_m` generated by `x ↦ A x + t` is
free exactly when the generator has no fixed point, that is when `t` does not lie in the image of
`1 - A`: every nonidentity element generates `C_m`. -/
theorem cyclicAffineHom_free_iff_of_prime (hm : m.Prime) :
    (∀ g x, A.cyclicAffineHom t hA ht g x = x → g = 1) ↔ ∀ b, b - A b ≠ t := by
  rw [cyclicAffineHom_free_iff_pow]
  refine ⟨fun h b hb ↦ h 1 one_pos hm.one_lt b ?_, fun h k hk hkm x hx ↦ h x ?_⟩
  · rw [pow_one, affineEquiv_apply, ← hb, add_sub_cancel]
  · -- Some multiple `k * n` of `k` is `1` modulo `m`, and the affine map has order dividing `m`.
    obtain ⟨n, -, hn⟩ := Nat.exists_mul_mod_eq_one_of_coprime
      ((Nat.coprime_of_lt_prime hk.ne' hkm hm).symm) hm.one_lt
    have hfix : (A.affineEquiv t ^ (k * n)) x = x := by
      rw [pow_mul]
      exact Function.IsFixedPt.perm_pow hx n
    rw [pow_eq_pow_mod _ ((affineEquiv_pow_eq_one_iff_of_iterate_eq_id A t hA).2 ht), hn,
      pow_one, affineEquiv_apply] at hfix
    rw [← eq_sub_iff_add_eq'.2 hfix]

end AddEquiv
