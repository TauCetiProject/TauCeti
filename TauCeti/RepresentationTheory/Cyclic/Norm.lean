module

public import Mathlib.RepresentationTheory.Invariants
public import Mathlib.GroupTheory.OrderOfElement
import TauCeti.GroupTheory.SpecificGroups.Cyclic.Basic
import TauCeti.Algebra.BigOperators.Finset.Range

/-!
# The norm of a representation of a finite cyclic group

Let `G` be a finite group generated by `g`, of order `n`. The norm `∑ x : G, ρ x` of a
representation `ρ` of `G` is then the sum `1 + ρ g + ⋯ + ρ gⁿ⁻¹` over the powers of the generator.
Consequently, for a vector `a` killed by the norm, the partial norms
`a + g a + ⋯ + gⁱ⁻¹ a` are periodic in `i` with period `n`: each block of `n` consecutive terms
sums to the norm of `a`. These partial norms are the values of the degree-`1` cocycles describing
the odd-degree cohomology of a finite cyclic group.

## Main results

* `Representation.sum_range_mod_orderOf_apply`: for a vector killed by the norm, the partial norm
  of length `i` depends only on `i` modulo `n`.
* `Representation.norm_apply_eq_zero_of_apply_eq_neg`: when `n` is even and the generator acts by
  negation, the norm vanishes identically.
* `Rep.mem_ker_norm_of_ρ_eq_neg`, `Rep.mem_range_norm_iff_of_ρ_eq_neg`: kernel and range of
  `A.norm.asHom` under an even-order negation action.
-/

public section

open TauCeti (sum_range_orderOf_eq_sum)

namespace Representation

variable {k G V : Type*} [Semiring k] [Group G]

section PartialNorm

variable [Fintype G] [AddCommMonoid V] [Module k V]
  (ρ : Representation k G V) {g : G} (hg : ∀ x, x ∈ Subgroup.zpowers g)

include hg in
/-- For `a` killed by the norm, the partial norm `a + g a + ⋯ + gⁱ⁻¹ a` depends only on `i`
modulo the order `n` of `g`: each block of `n` consecutive terms sums to the norm of `a`. -/
theorem sum_range_mod_orderOf_apply {a : V} (ha : ρ.norm a = 0) (i : ℕ) :
    ∑ l ∈ Finset.range (i % orderOf g), ρ (g ^ l) a = ∑ l ∈ Finset.range i, ρ (g ^ l) a := by
  have hblock (q : ℕ) :
      ∑ l ∈ Finset.range (orderOf g), ρ (g ^ (orderOf g * q + l)) a = 0 := by
    simp only [pow_add, pow_mul, pow_orderOf_eq_one, one_pow, one_mul]
    rw [sum_range_orderOf_eq_sum g hg (fun x ↦ ρ x a)]
    simpa only [Representation.norm, LinearMap.sum_apply] using ha
  conv_rhs => rw [← Nat.div_add_mod i (orderOf g), Finset.sum_range_add,
    Finset.sum_range_mul_eq_sum_sum, Finset.sum_eq_zero fun q _ => hblock q, zero_add]
  simp only [pow_add, pow_mul, pow_orderOf_eq_one, one_pow, one_mul]

end PartialNorm

section Negation

variable [AddCommGroup V] [Module k V] (ρ : Representation k G V) {g : G}

/-- If `g` acts by negation, then `g ^ j` fixes every vector for even `j` and negates it for
odd `j`. -/
theorem pow_apply_of_apply_eq_neg (hneg : ∀ v : V, ρ g v = -v) (j : ℕ) (v : V) :
    ρ (g ^ j) v = if Even j then v else -v := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [pow_succ', map_mul, mul_apply_eq_comp, ih, hneg]
    by_cases hj : Even j <;> simp [hj, Nat.even_add_one]

/-- **The norm vanishes for a negation action of an even-order cyclic group.** If `G` is generated
by an element `g` of even order acting as `-1`, then consecutive terms `v + (-v)` cancel in pairs,
so `∑ x : G, ρ x v = 0`. -/
theorem norm_apply_eq_zero_of_apply_eq_neg [Fintype G] (hg : ∀ x, x ∈ Subgroup.zpowers g)
    (hord : Even (orderOf g)) (hneg : ∀ v : V, ρ g v = -v) (v : V) :
    ρ.norm v = 0 := by
  rw [Representation.norm, LinearMap.sum_apply, ← sum_range_orderOf_eq_sum g hg (fun x ↦ ρ x v)]
  obtain ⟨q, hq⟩ := hord
  rw [hq, ← two_mul]
  clear hq
  induction q with
  | zero => simp
  | succ q ih =>
    have hsucc : 2 * (q + 1) = (2 * q + 1) + 1 := by omega
    rw [hsucc, Finset.sum_range_succ, Finset.sum_range_succ, ih, zero_add,
      pow_apply_of_apply_eq_neg ρ hneg, pow_apply_of_apply_eq_neg ρ hneg]
    simp

end Negation

end Representation

namespace Rep

section Negation

variable {k G : Type*} [Semiring k] [Group G] [Fintype G]

/-- When `G` is generated by an element `g` of even order acting by negation, every element of `A`
lies in the kernel of the norm. -/
theorem mem_ker_norm_of_ρ_eq_neg (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g)
    (hord : Even (orderOf g)) (hneg : ∀ x : A, A.ρ g x = -x) (x : A) :
    x ∈ LinearMap.ker A.norm.asHom.hom.toLinearMap := by
  rw [LinearMap.mem_ker, Representation.IntertwiningMap.toLinearMap_apply, Rep.norm_apply]
  exact A.ρ.norm_apply_eq_zero_of_apply_eq_neg hg hord hneg x

/-- When `G` is generated by an element `g` of even order acting by negation, the image of the
norm is zero. -/
theorem mem_range_norm_iff_of_ρ_eq_neg (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g)
    (hord : Even (orderOf g)) (hneg : ∀ x : A, A.ρ g x = -x) (x : A) :
    x ∈ LinearMap.range A.norm.asHom.hom.toLinearMap ↔ x = 0 := by
  rw [LinearMap.mem_range]
  constructor
  · rintro ⟨y, rfl⟩
    rw [Representation.IntertwiningMap.toLinearMap_apply, Rep.norm_apply]
    exact A.ρ.norm_apply_eq_zero_of_apply_eq_neg hg hord hneg y
  · rintro rfl
    exact ⟨0, map_zero _⟩

end Negation

end Rep
