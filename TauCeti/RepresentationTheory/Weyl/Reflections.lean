/-!
# Pseudoreflections and reflecting hyperplanes of a Weyl group

For a root pairing `P : RootPairing ι R M N`, the weight-space representation `P.weylGroupRootRep`
realizes `P.weylGroup` as a linear group generated by reflections. Over any integral domain with
`2 ≠ 0`, the `W`-fixed vectors in `M` are the common zeros of the coroots, the `W`-invariant linear
forms on `M` are those vanishing on the root span, each root reflection `weylGroup.ofIdx P i` has
fixed space `ker (P.coroot' i)`, and when `P.flip` is reduced the pointwise stabilizer in
`P.weylGroup` of `ker (P.coroot' α)` is `{1, weylGroup.ofIdx P α}`. Over a field with `2 ≠ 0`, each
root reflection is a pseudoreflection, so `P.weylGroup` equals its pseudoreflection subgroup.

For a finite reduced crystallographic root pairing over a field `K` of characteristic zero (with no
ordering or spanning hypothesis on `K` or the roots), choosing a base `b : P.Base`:

* the pseudoreflections of `P.weylGroupRootRep` are precisely the reflections `weylGroup.ofIdx P α`
  for `α ∈ posRoots P b`, giving the bijection `RootPairing.posRootsEquivPseudoreflections`;
* the reflecting hyperplanes `P.weylGroupRootRep.reflectingHyperplanes` are precisely the coroot
  hyperplanes `ker (P.coroot' α)` for `α ∈ posRoots P b`, giving the bijection
  `RootPairing.posRootsEquivReflectingHyperplanes`, so both counts equal `(posRoots P b).ncard`;
* a weight lies on a reflecting hyperplane if and only if it is not regular.

## Main definitions

* `RootPairing.posRootsEquivPseudoreflections`: bijection between `posRoots P b` and the
  pseudoreflections of `P.weylGroupRootRep`.
* `RootPairing.posRootsEquivReflectingHyperplanes`: bijection between `posRoots P b` and
  `P.weylGroupRootRep.reflectingHyperplanes`.

## Main results

* `RootPairing.invariants_weylGroupRootRep` and `RootPairing.invariants_weylGroupRootRep_dual`:
  the `W`-invariants on `M` and `M*`.
* `RootPairing.fixedSubmodule_weylGroupRootRep_ofIdx` and
  `RootPairing.ker_coroot'_le_fixedSubmodule_weylGroupRootRep_iff`: the fixed space of
  `weylGroup.ofIdx P α` is `ker (P.coroot' α)`, whose pointwise stabilizer in `P.weylGroup` is
  `{1, weylGroup.ofIdx P α}`.
* `RootPairing.pseudoreflectionSubgroup_weylGroupRootRep_eq_top`: `P.weylGroup` is generated by
  pseudoreflections on `M`.
* `RootPairing.finrank_quotient_fixedSubmodule_weylGroupRootRep_eq_one_iff`: classification of
  pseudoreflections of `P.weylGroupRootRep` as positive-root reflections.
* `RootPairing.reflectingHyperplanes_weylGroupRootRep`,
  `RootPairing.card_reflectingHyperplanes_weylGroupRootRep`, and
  `RootPairing.exists_mem_reflectingHyperplanes_weylGroupRootRep_iff`: explicit description, count,
  and union of the reflecting hyperplanes.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Ch. V, §3 and Ch. VI, §1.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press (1990),
  §§1.14, 3.9.
-/

public section

open TauCeti

namespace RootPairing

section Domain

variable {ι R M N : Type*} [CommRing R] [IsDomain R] [NeZero (2 : R)]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] (P : RootPairing ι R M N)

/-- Over an integral domain in which `2 ≠ 0`, the `W`-fixed vectors in `M` are the common zeros of
all coroot functionals. -/
theorem invariants_weylGroupRootRep :
    P.weylGroupRootRep.invariants = ⨅ i, LinearMap.ker (P.coroot' i) := by
  have : Module.IsReflexive R M := .of_isPerfPair P.toLinearMap
  have : Module.IsTorsionFree R M := inferInstance
  ext x
  simp only [Representation.mem_invariants, Submodule.mem_iInf, LinearMap.mem_ker]
  refine ⟨fun hx i ↦ ?_, fun hx ⟨g, hg⟩ ↦ ?_⟩
  · have hfix : P.reflection i x = x := by simpa [reflection_apply] using hx (weylGroup.ofIdx P i)
    rw [reflection_apply, sub_eq_self, smul_eq_zero] at hfix
    exact hfix.resolve_right (P.ne_zero i)
  · induction hg using weylGroup.induction with
    | mem i => simp [weylGroupRootRep_apply, Subgroup.smul_def, Equiv.reflection_smul,
        reflection_apply, hx i]
    | one => simp
    | mul _ _ hu hv ihu ihv =>
      rw [← Submonoid.mk_mul_mk _ _ _ hu hv, map_mul, Module.End.mul_eq_comp,
        LinearMap.comp_apply, ihv, ihu]

/-- Over an integral domain in which `2 ≠ 0`, the `W`-invariant linear forms on `M` are the linear
forms vanishing on the root span. -/
theorem invariants_weylGroupRootRep_dual :
    P.weylGroupRootRep.dual.invariants = (P.rootSpan R).dualAnnihilator := by
  ext φ
  rw [Representation.mem_invariants, Submodule.mem_dualAnnihilator]
  refine ⟨fun hφ x hx ↦ ?_, fun hφ w ↦ ?_⟩
  · have hle : P.rootSpan R ≤ LinearMap.ker φ := by
      rw [rootSpan, Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      have hfix : -φ (P.root i) = φ (P.root i) := by
        simpa [Representation.dual_apply, Module.Dual.transpose_apply] using
          congr($(hφ (weylGroup.ofIdx P i)) (P.root i))
      have h2 : (2 : R) * φ (P.root i) = 0 := by linear_combination -hfix
      exact LinearMap.mem_ker.mpr ((mul_eq_zero.mp h2).resolve_left (NeZero.ne (2 : R)))
    exact hle hx
  · ext x
    rw [Representation.dual_apply, Module.Dual.transpose_apply, LinearMap.comp_apply,
      weylGroupRootRep_apply, ← sub_eq_zero, ← map_sub]
    exact hφ _ (weylGroup.smul_sub_mem_rootSpan w⁻¹ x)

/-- Over an integral domain in which `2 ≠ 0`, the fixed submodule of the reflection
`weylGroup.ofIdx P i` is `ker (P.coroot' i)`. -/
@[simp]
theorem fixedSubmodule_weylGroupRootRep_ofIdx (i : ι) :
    (P.weylGroupRootRep (weylGroup.ofIdx P i)).fixedSubmodule = LinearMap.ker (P.coroot' i) := by
  have : Module.IsReflexive R M := .of_isPerfPair P.toLinearMap
  have : Module.IsTorsionFree R M := inferInstance
  ext x
  simp [reflection_apply, P.ne_zero i]

/-- **Pointwise stabilizer of a root hyperplane.** Over an integral domain in which `2 ≠ 0`, when
`P.flip` is reduced, an element of `P.weylGroup` fixes `ker (P.coroot' α)` pointwise if and only if
it is `1` or `weylGroup.ofIdx P α`. -/
theorem ker_coroot'_le_fixedSubmodule_weylGroupRootRep_iff [P.flip.IsReduced] {α : ι}
    {w : P.weylGroup} :
    LinearMap.ker (P.coroot' α) ≤ (P.weylGroupRootRep w).fixedSubmodule ↔
      w = 1 ∨ w = weylGroup.ofIdx P α := by
  have : Module.IsReflexive R M := .of_isPerfPair P.toLinearMap
  have : Module.IsTorsionFree R M := inferInstance
  refine ⟨fun h ↦ ?_, ?_⟩
  · let β := P.weylGroupToPerm w α
    have hker : LinearMap.ker (P.coroot' α) ≤ LinearMap.ker (P.coroot' β) := fun y hy ↦ by
      have hwy : w • y = y := LinearMap.mem_fixedSubmodule_iff.mp (h hy)
      rw [LinearMap.mem_ker, ← hwy, coroot'_weylGroupToPerm_smul, LinearMap.mem_ker.mp hy]
    have hdecomp (x : M) :
        (2 : R) • (w • x) =
          ((2 : R) • x - P.coroot' α x • P.root α) + P.coroot' α x • P.root β := by
      have hwy : P.weylGroupRootRep w ((2 : R) • x - P.coroot' α x • P.root α) =
          (2 : R) • x - P.coroot' α x • P.root α :=
        LinearMap.mem_fixedSubmodule_iff.mp
          (h (P.two_smul_sub_coroot'_smul_root_mem_ker_coroot' α x))
      rw [map_sub, map_smul, map_smul, weylGroupRootRep_apply, weylGroupRootRep_apply,
        weylGroup_apply_root] at hwy
      exact eq_add_of_sub_eq hwy
    rcases P.eq_or_eq_reflectionPerm_self_of_ker_coroot'_le hker with hpos | hneg
    · exact Or.inl <| weylGroup.ext fun x ↦ smul_right_injective M (NeZero.ne (2 : R)) <| by
        dsimp only
        rw [hdecomp x, hpos, sub_add_cancel, one_smul]
    · refine Or.inr <| weylGroup.ext fun x ↦ smul_right_injective M (NeZero.ne (2 : R)) ?_
      have hx := hdecomp x
      simp only [hneg, root_reflectionPerm, reflection_apply_self, smul_neg] at hx
      dsimp only
      rw [hx, weylGroup.ofIdx_smul, Equiv.reflection_smul, reflection_apply]
      module
  · rintro (rfl | rfl)
    · exact fun _ _ ↦ by simp
    · rw [fixedSubmodule_weylGroupRootRep_ofIdx]

end Domain

section Field

variable {ι K M N : Type*} [Field K] [NeZero (2 : K)] [AddCommGroup M] [Module K M]
  [AddCommGroup N] [Module K N] (P : RootPairing ι K M N)

/-- Every root reflection is a pseudoreflection on `M`: its fixed hyperplane has codimension `1`. -/
@[simp]
theorem finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx (i : ι) :
    Module.finrank K (M ⧸ (P.weylGroupRootRep (weylGroup.ofIdx P i)).fixedSubmodule) = 1 := by
  rw [fixedSubmodule_weylGroupRootRep_ofIdx]
  exact Module.Dual.finrank_quotient_ker_eq_one_of_ne_zero (P.coroot'_ne_zero i)

/-- **The Weyl group is generated by pseudoreflections** in its weight-space representation. -/
@[simp]
theorem pseudoreflectionSubgroup_weylGroupRootRep_eq_top :
    P.weylGroupRootRep.pseudoreflectionSubgroup = ⊤ := by
  rw [eq_top_iff]
  rintro ⟨g, hg⟩ -
  induction hg using weylGroup.induction with
  | mem i =>
    exact P.weylGroupRootRep.mem_pseudoreflectionSubgroup_of_finrank_quotient_eq_one
      (P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx i)
  | one => exact one_mem _
  | mul _ _ hu hv ihu ihv => rw [← Submonoid.mk_mul_mk _ _ _ hu hv]; exact mul_mem ihu ihv

end Field

section CharZero

variable {ι K M N : Type*} [Field K] [CharZero K] [AddCommGroup M] [Module K M]
  [AddCommGroup N] [Module K N] (P : RootPairing ι K M N)
  [Finite ι] [P.IsCrystallographic] [P.IsReduced]

/-- **Classification of the pseudoreflections of `P.weylGroupRootRep`.** An element of `P.weylGroup`
has fixed space of codimension one in `M` (i.e., is a pseudoreflection) if and only if it is the
reflection `weylGroup.ofIdx P α` at a positive root `α ∈ posRoots P b`. -/
theorem finrank_quotient_fixedSubmodule_weylGroupRootRep_eq_one_iff (b : P.Base)
    {w : P.weylGroup} :
    Module.finrank K (M ⧸ (P.weylGroupRootRep w).fixedSubmodule) = 1 ↔
      ∃ α ∈ posRoots P b, w = weylGroup.ofIdx P α := by
  refine ⟨fun hw ↦ ?_, ?_⟩
  · have hw1 : w ≠ 1 := P.weylGroupRootRep.ne_one_of_finrank_quotient_fixedSubmodule_eq_one hw
    let H := (P.weylGroupRootRep w).fixedSubmodule
    obtain ⟨i, hi⟩ : ∃ i, H ≤ LinearMap.ker (P.coroot' i) := by
      by_contra! hnot
      obtain ⟨x, hxH, hxreg⟩ := Module.Dual.exists_forall_mem_ne_zero_of_forall_exists H P.coroot'
        fun i ↦ IsConcreteLE.not_le_iff_exists.mp (hnot i)
      exact hw1 (P.eq_one_of_isRegularWeight_of_smul_eq b
        ((P.isRegularWeight_iff x).mpr hxreg) (LinearMap.mem_fixedSubmodule_iff.mp hxH))
    let _ : Finite P.weylGroup := P.finite_weylGroup_of_base b
    have hHeq : LinearMap.ker (P.coroot' i) = H := by
      rw [← P.fixedSubmodule_weylGroupRootRep_ofIdx i]
      exact P.weylGroupRootRep.fixedSubmodule_eq_of_mem_reflectingHyperplanes
        (P.weylGroupRootRep.fixedSubmodule_mem_reflectingHyperplanes hw)
        (by
          rw [← P.weylGroupRootRep.map_one]
          exact P.weylGroupRootRep_injective.ne (weylGroup.ofIdx_ne_one P i))
        (by rwa [P.fixedSubmodule_weylGroupRootRep_ofIdx])
    have hw_eq : w = weylGroup.ofIdx P i :=
      (P.ker_coroot'_le_fixedSubmodule_weylGroupRootRep_iff.1 hHeq.le).resolve_left hw1
    by_cases hpos : i ∈ posRoots P b
    · exact ⟨i, hpos, hw_eq⟩
    · refine ⟨P.reflectionPerm i i, (reflectionPerm_self_mem_posRoots_iff_mem_negRoots P b i).2
        ((not_mem_posRoots_iff_mem_negRoots P b i).1 hpos),
        hw_eq.trans (weylGroup.ofIdx_reflectionPerm_self P i).symm⟩
  · rintro ⟨α, -, rfl⟩
    exact P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx α

/-- **Bijection between the positive roots and the pseudoreflections of `P.weylGroupRootRep`.** -/
noncomputable def posRootsEquivPseudoreflections (b : P.Base) :
    posRoots P b ≃
      {w : P.weylGroup // Module.finrank K (M ⧸ (P.weylGroupRootRep w).fixedSubmodule) = 1} :=
  Equiv.ofBijective
    (fun α ↦ ⟨weylGroup.ofIdx P α.val,
      P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx α.val⟩)
    ⟨fun α β h ↦ Subtype.ext <|
      (P.ofIdx_eq_ofIdx_iff_of_mem_posRoots b α.property β.property).1 (congrArg Subtype.val h),
     fun ⟨_, hw⟩ ↦ by
      obtain ⟨α, hα, rfl⟩ := (P.finrank_quotient_fixedSubmodule_weylGroupRootRep_eq_one_iff b).1 hw
      exact ⟨⟨α, hα⟩, rfl⟩⟩

/-- `posRootsEquivPseudoreflections` sends a positive root `α` to `weylGroup.ofIdx P α.1`. -/
@[simp]
theorem coe_posRootsEquivPseudoreflections (b : P.Base) (α : posRoots P b) :
    (P.posRootsEquivPseudoreflections b α : P.weylGroup) = weylGroup.ofIdx P α.val :=
  (rfl)

/-- `(posRootsEquivPseudoreflections b).symm` recovers the positive root `α` from its reflection. -/
@[simp]
theorem posRootsEquivPseudoreflections_symm_ofIdx (b : P.Base) (α : posRoots P b) :
    (P.posRootsEquivPseudoreflections b).symm
        ⟨weylGroup.ofIdx P α.val,
          P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx α.val⟩ = α :=
  (P.posRootsEquivPseudoreflections b).symm_apply_apply α

/-- The number of pseudoreflections of `P.weylGroupRootRep` equals the number of positive roots. -/
theorem natCard_pseudoreflections_weylGroupRootRep (b : P.Base) :
    Nat.card {w : P.weylGroup //
      Module.finrank K (M ⧸ (P.weylGroupRootRep w).fixedSubmodule) = 1} =
      (posRoots P b).ncard := by
  rw [← Nat.card_congr (P.posRootsEquivPseudoreflections b), Nat.card_coe_set_eq]

/-- **Explicit description of the reflecting hyperplanes of `P.weylGroupRootRep`:** they are the
coroot hyperplanes `ker (P.coroot' α)` of the positive roots `α ∈ posRootsFinset P b`. -/
theorem reflectingHyperplanes_weylGroupRootRep (b : P.Base) [DecidableEq (Submodule K M)] :
    letI := P.finite_weylGroup_of_base b
    P.weylGroupRootRep.reflectingHyperplanes =
      (posRootsFinset P b).image fun α ↦ LinearMap.ker (P.coroot' α) := by
  let _ := P.finite_weylGroup_of_base b
  ext H
  rw [Representation.mem_reflectingHyperplanes, Finset.mem_image]
  refine ⟨?_, ?_⟩
  · rintro ⟨_, hw, rfl⟩
    obtain ⟨α, hα, rfl⟩ := (P.finrank_quotient_fixedSubmodule_weylGroupRootRep_eq_one_iff b).1 hw
    exact ⟨α, (mem_posRootsFinset P b α).2 hα, (P.fixedSubmodule_weylGroupRootRep_ofIdx α).symm⟩
  · rintro ⟨α, -, rfl⟩
    exact ⟨weylGroup.ofIdx P α, P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx α,
      P.fixedSubmodule_weylGroupRootRep_ofIdx α⟩

/-- **Bijection between the positive roots and the reflecting hyperplanes of
`P.weylGroupRootRep`.** -/
noncomputable def posRootsEquivReflectingHyperplanes (b : P.Base) :
    letI := P.finite_weylGroup_of_base b
    posRoots P b ≃ P.weylGroupRootRep.reflectingHyperplanes :=
  letI := P.finite_weylGroup_of_base b
  Equiv.ofBijective
    (fun α ↦ ⟨LinearMap.ker (P.coroot' α.val),
      P.weylGroupRootRep.mem_reflectingHyperplanes.2
        ⟨weylGroup.ofIdx P α.val, P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx α.val,
          P.fixedSubmodule_weylGroupRootRep_ofIdx α.val⟩⟩)
    ⟨fun α β h ↦ Subtype.ext <|
      (P.ker_coroot'_eq_iff_of_mem_posRoots b α.property β.property).1 (congrArg Subtype.val h),
     fun ⟨_, hH⟩ ↦ by
      obtain ⟨_, hw, rfl⟩ := P.weylGroupRootRep.mem_reflectingHyperplanes.1 hH
      obtain ⟨α, hα, rfl⟩ := (P.finrank_quotient_fixedSubmodule_weylGroupRootRep_eq_one_iff b).1 hw
      exact ⟨⟨α, hα⟩, Subtype.ext (P.fixedSubmodule_weylGroupRootRep_ofIdx α).symm⟩⟩

/-- `posRootsEquivReflectingHyperplanes` sends a positive root `α` to `ker (P.coroot' α.1)`. -/
@[simp]
theorem coe_posRootsEquivReflectingHyperplanes (b : P.Base) (α : posRoots P b) :
    letI := P.finite_weylGroup_of_base b
    ((P.posRootsEquivReflectingHyperplanes b α).val : Submodule K M) =
      LinearMap.ker (P.coroot' α.val) :=
  (rfl)

/-- `(posRootsEquivReflectingHyperplanes b).symm` recovers the positive root `α` from its coroot
hyperplane. -/
@[simp]
theorem posRootsEquivReflectingHyperplanes_symm_ker_coroot' (b : P.Base) (α : posRoots P b)
    (hH : LinearMap.ker (P.coroot' α.val) ∈
      (letI := P.finite_weylGroup_of_base b; P.weylGroupRootRep.reflectingHyperplanes)) :
    letI := P.finite_weylGroup_of_base b
    (P.posRootsEquivReflectingHyperplanes b).symm ⟨LinearMap.ker (P.coroot' α.val), hH⟩ = α :=
  letI := P.finite_weylGroup_of_base b
  (P.posRootsEquivReflectingHyperplanes b).symm_apply_apply α

/-- **The number of reflecting hyperplanes of `P.weylGroupRootRep` equals the number of positive
roots.** -/
theorem card_reflectingHyperplanes_weylGroupRootRep (b : P.Base) :
    letI := P.finite_weylGroup_of_base b
    P.weylGroupRootRep.reflectingHyperplanes.card = (posRoots P b).ncard := by
  let _ := P.finite_weylGroup_of_base b
  rw [← Fintype.card_coe, ← Nat.card_eq_fintype_card,
    ← Nat.card_congr (P.posRootsEquivReflectingHyperplanes b), Nat.card_coe_set_eq]

/-- **A weight lies on a reflecting hyperplane if and only if it is not regular.** -/
theorem exists_mem_reflectingHyperplanes_weylGroupRootRep_iff (b : P.Base) (x : M) :
    letI := P.finite_weylGroup_of_base b
    (∃ H ∈ P.weylGroupRootRep.reflectingHyperplanes, x ∈ H) ↔ ¬ P.IsRegularWeight x := by
  let _ := P.finite_weylGroup_of_base b
  classical
  rw [P.reflectingHyperplanes_weylGroupRootRep b, isRegularWeight_iff]
  simp only [Finset.mem_image, not_forall, not_not]
  refine ⟨fun ⟨_, ⟨α, _, rfl⟩, hαx⟩ ↦ ⟨α, LinearMap.mem_ker.mp hαx⟩, fun ⟨i, hix⟩ ↦ ?_⟩
  by_cases hi : i ∈ posRoots P b
  · exact ⟨_, ⟨i, (mem_posRootsFinset P b i).2 hi, rfl⟩, LinearMap.mem_ker.mpr hix⟩
  · refine ⟨_, ⟨P.reflectionPerm i i, (mem_posRootsFinset P b _).2
      ((reflectionPerm_self_mem_posRoots_iff_mem_negRoots P b i).2
        ((not_mem_posRoots_iff_mem_negRoots P b i).1 hi)), rfl⟩, ?_⟩
    simp [coroot'_reflectionPerm_self, hix]

end CharZero

end RootPairing
