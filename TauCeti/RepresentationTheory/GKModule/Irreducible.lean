public import TauCeti.RepresentationTheory.GKModule.Basic

/-!
# Irreducible `(𝔤, K)`-modules

A `(𝔤, K)`-module is irreducible when it is nonzero and its only `(𝔤, K)`-submodules are `⊥` and
`⊤`. The Lie submodule generated by a set whose `K`-translates stay in it is a
`(𝔤, K)`-submodule (`TauCeti.GKSubmodule.lieSpan`). Since every vector is `K`-finite, the span of
the `K`-orbit of a nonzero vector is finite-dimensional, and the Lie submodule it generates is a
nonzero `(𝔤, K)`-submodule. So an irreducible `(𝔤, K)`-module is generated over `𝔤` by a finite
set, and it is a Harish-Chandra module exactly when it is admissible.

## Main definitions

* `TauCeti.GKSubmodule.lieSpan M s hs`: the `(𝔤, K)`-submodule generated by a set `s` whose
  `K`-translates lie in the Lie submodule generated by `s`.
* `TauCeti.GKModule.IsIrreducible M`: `M` is nonzero and has no `(𝔤, K)`-submodules besides `⊥`
  and `⊤`, that is, `IsSimpleOrder (GKSubmodule M)` (as for `LieModule.IsIrreducible`).

## Main statements

* `TauCeti.GKModule.IsIrreducible.exists_lieSpan_eq_top`: an irreducible `(𝔤, K)`-module is
  generated over `𝔤` by a finite set.
* `TauCeti.GKModule.IsIrreducible.isHarishChandraModule_iff`: an irreducible `(𝔤, K)`-module is a
  Harish-Chandra module if and only if it is admissible.

## References

* N. R. Wallach, *Real Reductive Groups I*, Academic Press (1988), Chapter 3.
-/

public section

namespace TauCeti

open Representation

variable {k 𝔤 K : Type*} [Field k] [LieRing 𝔤] [LieAlgebra k 𝔤] [Monoid K]
  {Ad : Representation k K 𝔤} [IsLieAction Ad] {V : Type*} [AddCommGroup V]
  [Module k V] [LieRingModule 𝔤 V] [LieModule k 𝔤 V]

namespace GKSubmodule

variable (M : GKModule Ad V)

/-- The **`(𝔤, K)`-submodule generated** by a set `s` whose `K`-translates lie in the Lie
submodule generated by `s`: that Lie submodule is `K`-stable, by covariance of the action of `K`. -/
def lieSpan (s : Set V) (hs : ∀ (g : K), ∀ v ∈ s, M.ρ g v ∈ LieSubmodule.lieSpan k 𝔤 s) :
    GKSubmodule M where
  toLieSubmodule := LieSubmodule.lieSpan k 𝔤 s
  apply_mem g v hv := by
    -- The vectors all of whose `K`-translates lie in `lieSpan s` form a Lie submodule
    -- containing `s`.
    let N : LieSubmodule k 𝔤 V :=
      { carrier := {v | ∀ g, M.ρ g v ∈ LieSubmodule.lieSpan k 𝔤 s}
        add_mem' := fun ha hb g ↦ by
          simpa only [map_add] using add_mem (ha g) (hb g)
        zero_mem' := fun g ↦ by simp
        smul_mem' := fun c v hv g ↦ by
          simpa only [map_smul] using SMulMemClass.smul_mem c (hv g)
        lie_mem := fun {x v} hv g ↦ by
          rw [M.map_lie]
          exact LieSubmodule.lie_mem _ (hv g) }
    have hsN : s ⊆ N := fun v hv g ↦ hs g v hv
    exact LieSubmodule.lieSpan_le.2 hsN hv g

@[simp]
theorem toLieSubmodule_lieSpan (s : Set V)
    (hs : ∀ (g : K), ∀ v ∈ s, M.ρ g v ∈ LieSubmodule.lieSpan k 𝔤 s) :
    (lieSpan M s hs).toLieSubmodule = LieSubmodule.lieSpan k 𝔤 s :=
  (rfl)

/-- Membership in the `(𝔤, K)`-submodule generated by `s` is membership in the Lie submodule
generated by `s`. -/
@[simp]
theorem mem_lieSpan {s : Set V} {hs : ∀ (g : K), ∀ v ∈ s, M.ρ g v ∈ LieSubmodule.lieSpan k 𝔤 s}
    {v : V} : v ∈ lieSpan M s hs ↔ v ∈ LieSubmodule.lieSpan k 𝔤 s :=
  Iff.rfl

/-- The `(𝔤, K)`-submodule generated by `s` contains `s`. -/
theorem subset_lieSpan {s : Set V} {hs : ∀ (g : K), ∀ v ∈ s, M.ρ g v ∈ LieSubmodule.lieSpan k 𝔤 s} :
    s ⊆ lieSpan M s hs :=
  LieSubmodule.subset_lieSpan

/-- The `(𝔤, K)`-submodule generated by `s` is the least one containing `s`. -/
theorem lieSpan_le {s : Set V} {hs : ∀ (g : K), ∀ v ∈ s, M.ρ g v ∈ LieSubmodule.lieSpan k 𝔤 s}
    {N : GKSubmodule M} : lieSpan M s hs ≤ N ↔ s ⊆ N := by
  rw [← toLieSubmodule_le_toLieSubmodule, toLieSubmodule_lieSpan, LieSubmodule.lieSpan_le]
  rfl

end GKSubmodule

namespace GKModule

variable (M : GKModule Ad V)

/-- A `(𝔤, K)`-module is **irreducible** when it is nonzero and its only `(𝔤, K)`-submodules are
`⊥` and `⊤`. -/
abbrev IsIrreducible : Prop :=
  IsSimpleOrder (GKSubmodule M)

variable {M}

/-- A nonzero `(𝔤, K)`-module whose nonzero `(𝔤, K)`-submodules are all `⊤` is irreducible. -/
theorem IsIrreducible.mk [Nontrivial V] (h : ∀ N : GKSubmodule M, N ≠ ⊥ → N = ⊤) :
    M.IsIrreducible :=
  IsSimpleOrder.of_forall_eq_top h

/-- An irreducible `(𝔤, K)`-module is nonzero. -/
theorem IsIrreducible.nontrivial (hM : M.IsIrreducible) : Nontrivial V := by
  refine (nontrivial_iff_exists_ne (0 : V)).2 ?_
  by_contra! h
  exact (bot_ne_top (α := GKSubmodule M)) (GKSubmodule.ext fun v ↦ by simp [h v])

/-- **An irreducible `(𝔤, K)`-module is finitely generated over `𝔤`**: a finite spanning set
of the finite-dimensional span of the `K`-orbit of a nonzero vector generates it. -/
theorem IsIrreducible.exists_lieSpan_eq_top (hM : M.IsIrreducible) :
    ∃ s : Finset V, LieSubmodule.lieSpan k 𝔤 (s : Set V) = ⊤ := by
  obtain ⟨v, hv⟩ := (nontrivial_iff_exists_ne (0 : V)).1 hM.nontrivial
  let O := Submodule.span k (Set.range fun g : K ↦ M.ρ g v)
  have : FiniteDimensional k O := (isGFinite_iff _ _).1 (M.isGFinite v)
  obtain ⟨s, hspan⟩ := Module.Finite.iff_fg.1 this
  have hs : ∀ (g : K), ∀ w ∈ (s : Set V), M.ρ g w ∈ LieSubmodule.lieSpan k 𝔤 (s : Set V) := by
    intro g w hw
    refine LieSubmodule.submodule_span_le_lieSpan ?_
    replace hw := hspan ▸ Submodule.subset_span (R := k) hw
    rw [hspan]
    exact M.ρ.apply_mem_span_range_apply v g hw
  refine ⟨s, congrArg GKSubmodule.toLieSubmodule
    ((IsSimpleOrder.eq_bot_or_eq_top (GKSubmodule.lieSpan M _ hs)).resolve_left fun h ↦ hv ?_)⟩
  have hvO : v ∈ Submodule.span k (s : Set V) := by
    rw [hspan]
    exact Submodule.subset_span ⟨1, by simp⟩
  have hv' : v ∈ GKSubmodule.lieSpan M _ hs :=
    (GKSubmodule.mem_lieSpan M).2 (LieSubmodule.submodule_span_le_lieSpan hvO)
  rwa [h, GKSubmodule.mem_bot] at hv'

/-- **An irreducible `(𝔤, K)`-module is a Harish-Chandra module if and only if it is
admissible**, since it is finitely generated over `𝔤`. -/
theorem IsIrreducible.isHarishChandraModule_iff (hM : M.IsIrreducible) :
    M.IsHarishChandraModule ↔ M.ρ.HasFiniteMultiplicities :=
  ⟨IsHarishChandraModule.hasFiniteMultiplicities, fun h ↦
    (GKModule.isHarishChandraModule_iff M).2 ⟨h, hM.exists_lieSpan_eq_top⟩⟩

end GKModule

end TauCeti
