module

public import TauCeti.RepresentationTheory.Spin.Exceptional.Six.SpecialIsometry

/-!
# Transvection calculations for the six-dimensional exterior-square action

The exterior-square model of the six-dimensional orthogonal representation is generated by
special-linear transvections. This file records the pure-wedge calculation in the same
`spinSixSpecialLinearToIsometryGroup` carrier as the invariant form and kernel results.
-/

public section

namespace TauCeti

universe u

open scoped TensorProduct

variable (K : Type u) [CommRing K] [Nontrivial K]

/-- A special-linear transvection acts on a pure bivector by applying the standard
transvection to each factor. This is the generator calculation used when comparing the
exterior-square action with transported Spin-vector action. -/
theorem spinSixSpecialLinearToIsometryGroup_transvection_ιMulti
    {i j : Fin 4} (hij : i ≠ j) (c : K) (u v : Fin 4 → K) :
    (spinSixSpecialLinearToIsometryGroup K
      (Matrix.SpecialLinearGroup.transvection hij c)).1
      (exteriorPower.ιMulti K 2 ![u, v]) =
      exteriorPower.ιMulti K 2
        ![Matrix.mulVec (Matrix.transvection i j c) u,
          Matrix.mulVec (Matrix.transvection i j c) v] := by
  rw [spinSixSpecialLinearToIsometryGroup_apply, Representation.exteriorPower_apply,
    exteriorPower.map_apply_ιMulti]
  simp only [stdSLRep_apply]
  rfl

end TauCeti

end
