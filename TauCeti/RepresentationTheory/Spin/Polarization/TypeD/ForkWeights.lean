module

public import TauCeti.RepresentationTheory.Spin.Polarization.TypeD.GraphAutomorphism

/-!
# The fork-weight vectors in the type-D spin representation

The two spin fundamental weights of type `Dₙ` occur at the fork of its Dynkin diagram. In the
exterior model they are represented by the basis vector with every coordinate occupied and the
basis vector obtained from it by erasing the final coordinate. This file combines two facts that
identify those vectors in the pinned Serre representation:

* every positive simple generator annihilates each vector;
* their Cartan weights are respectively the final and penultimate fundamental coordinates.

These are the generator-level inputs for a highest-weight identification. A promotion to
`IsHighestWeightVector` additionally requires a compatible Borel and the proof that its positive
nilradical is generated by the displayed positive root spaces; no such Borel is asserted here.

## Main results

* `TauCeti.SpinPolarizationData.typeDSpinRep_serreE_exteriorBasis_univ_eq_zero` and
  `TauCeti.SpinPolarizationData.typeDSpinRep_serreE_exteriorBasis_univ_erase_last_eq_zero`: the two
  vectors are annihilated by every positive simple generator.
* `TauCeti.SpinPolarizationData.isCartanWeightVector_typeDSpinRep_exteriorBasis_univ` and its
  `univ_erase_last` counterpart: their exact fork fundamental weights.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4--6*, Plate IV.
* W. Fulton and J. Harris, *Representation Theory: A First Course* (1991), Section 20.2.
-/

public section

open CliffordAlgebra

namespace TauCeti.SpinPolarizationData

universe u v

/-! ## Positive-generator annihilation -/

variable {K : Type u} [CommRing K] {V : Type v} [AddCommGroup V] [Module K V]
  {Q : QuadraticForm K V} (P : SpinPolarizationData Q) {n : ℕ}
  (b : Module.Basis (Fin n) K P.W)

/-- Every positive simple-root Clifford bivector annihilates the all-coordinate exterior-basis
vector. This is the action-level calculation used by the type-`D` highest-weight vector. -/
@[simp] theorem spinAction_typeDSimpleRootBivector_exteriorBasis_univ_eq_zero
    (hn : 2 ≤ n) (i : Fin n) :
    spinAction Q P (P.typeDSimpleRootBivector b hn i)
        (b.ExteriorAlgebra (Finset.univ : Finset (Fin n))) = 0 := by
  by_cases hnext : (i : ℕ) + 1 < n
  · have hne : i ≠ (⟨(i : ℕ) + 1, hnext⟩ : Fin n) := by
      exact Fin.ne_of_lt (Nat.lt_succ_self _)
    simp only [P.typeDSimpleRootBivector_def b, dite_eq_left hnext, map_mul,
      Module.End.mul_apply, TauCeti.spinAction_ι_wedge,
      TauCeti.spinAction_ι_contract, P.pairingEquiv_dualVector,
      TauCeti.ExteriorAlgebra.contractLeft_coord_basis, Finset.mem_univ, ite_true,
      mul_smul_comm, TauCeti.ExteriorAlgebra.ι_mul_basis]
    simp [hne]
  · simp only [P.typeDSimpleRootBivector_def b, dite_eq_right hnext, map_mul,
      Module.End.mul_apply, TauCeti.spinAction_ι_wedge,
      TauCeti.ExteriorAlgebra.ι_mul_basis, Finset.mem_univ, ite_true, mul_zero]

/-- Every positive simple-root Clifford bivector annihilates the exterior-basis vector obtained by
erasing the final coordinate. -/
@[simp] theorem spinAction_typeDSimpleRootBivector_exteriorBasis_univ_erase_last_eq_zero
    (hn : 2 ≤ n) (i : Fin n) :
    spinAction Q P (P.typeDSimpleRootBivector b hn i)
        (b.ExteriorAlgebra
          ((Finset.univ : Finset (Fin n)).erase (⟨n - 1, by omega⟩ : Fin n))) = 0 := by
  apply (P.typeDGraphOperator b hn).injective
  rw [map_zero, P.typeDGraphOperator_spinAction_typeDSimpleRootBivector b hn,
    P.typeDGraphOperator_basis_of_notMem b hn (by simp), map_zsmul,
    Finset.insert_erase (Finset.mem_univ _),
    P.spinAction_typeDSimpleRootBivector_exteriorBasis_univ_eq_zero b hn, smul_zero]

variable {V : Type u} [AddCommGroup V] [Module ℚ V] {Q : QuadraticForm ℚ V}
  (P : SpinPolarizationData Q) {n : ℕ} (b : Module.Basis (Fin n) ℚ P.W)

/-- **Every positive simple type-`D` generator annihilates the all-coordinate exterior-basis
vector.** This supplies the positive-generator condition for the terminal fork highest-weight
vector. -/
theorem typeDSpinRep_serreE_exteriorBasis_univ_eq_zero (hn : 4 ≤ n) (i : Fin n) :
    P.typeDSpinRep b hn
        (_root_.UniversalEnvelopingAlgebra.ι ℚ
          (TauCeti.serreE ℚ (CartanMatrix.D n) i))
        (b.ExteriorAlgebra (Finset.univ : Finset (Fin n))) = 0 := by
  rw [P.typeDSpinRep_serreE_eq_spinAction b hn]
  exact P.spinAction_typeDSimpleRootBivector_exteriorBasis_univ_eq_zero b (by omega) i

/-- **Every positive simple type-`D` generator annihilates the exterior-basis vector obtained by
erasing the final coordinate.** This is the fork companion of
`typeDSpinRep_serreE_exteriorBasis_univ_eq_zero`. -/
theorem typeDSpinRep_serreE_exteriorBasis_univ_erase_last_eq_zero
    (hn : 4 ≤ n) (i : Fin n) :
    P.typeDSpinRep b hn
        (_root_.UniversalEnvelopingAlgebra.ι ℚ
          (TauCeti.serreE ℚ (CartanMatrix.D n) i))
        (b.ExteriorAlgebra
          ((Finset.univ : Finset (Fin n)).erase (⟨n - 1, by omega⟩ : Fin n))) = 0 := by
  rw [P.typeDSpinRep_serreE_eq_spinAction b hn]
  exact P.spinAction_typeDSimpleRootBivector_exteriorBasis_univ_erase_last_eq_zero
    b (by omega) i

/-! ## Exact fork weights -/

/-- The all-coordinate exterior-basis vector has the terminal fork fundamental weight for the
type-`D` Serre Cartan action. -/
@[simp 1100] theorem isCartanWeightVector_typeDSpinRep_exteriorBasis_univ (hn : 4 ≤ n) :
    TauCeti.UniversalEnvelopingAlgebra.IsCartanWeightVector
      (TauCeti.serreH ℚ (CartanMatrix.D n)) (P.typeDSpinRep b hn)
      (Pi.single (⟨n - 1, by omega⟩ : Fin n) 1)
      (b.ExteriorAlgebra (Finset.univ : Finset (Fin n))) := by
  simpa only [TauCeti.DynkinType.typeDSpinWeight_univ_eq_single (n := n) (by omega)] using
    P.isCartanWeightVector_typeDSpinRep_exteriorBasis b hn
      (Finset.univ : Finset (Fin n))

/-- The exterior-basis vector obtained by erasing the final coordinate has the penultimate fork
fundamental weight for the type-`D` Serre Cartan action. -/
@[simp 1100] theorem isCartanWeightVector_typeDSpinRep_exteriorBasis_univ_erase_last (hn : 4 ≤ n) :
    TauCeti.UniversalEnvelopingAlgebra.IsCartanWeightVector
      (TauCeti.serreH ℚ (CartanMatrix.D n)) (P.typeDSpinRep b hn)
      (Pi.single (⟨n - 2, by omega⟩ : Fin n) 1)
      (b.ExteriorAlgebra
        ((Finset.univ : Finset (Fin n)).erase (⟨n - 1, by omega⟩ : Fin n))) := by
  simpa only
    [TauCeti.DynkinType.typeDSpinWeight_univ_erase_last_eq_single (n := n) (by omega)] using
    P.isCartanWeightVector_typeDSpinRep_exteriorBasis b hn
      ((Finset.univ : Finset (Fin n)).erase (⟨n - 1, by omega⟩ : Fin n))

end TauCeti.SpinPolarizationData
