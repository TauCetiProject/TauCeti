/-!
# The twisted `SU(r)` relation set

For a rank `r`, a complex number `ζ` and a genus `g`, the *twisted relation set*
`TauCeti.relationSet r ζ g` consists of the tuples `(A₁, B₁, …, A_g, B_g)` in `SU(r)` whose
ordered product of group commutators is the scalar matrix `ζ • 1`:

    [A₁,B₁]⋯[A_g,B_g] = ζ • 1.

With `ζ = exp(2πi d/r)` this is the holonomy description of the projectively flat
connections of rank `r` and degree `d` on a closed surface of genus `g` whose determinant is a
fixed connection; its quotient by simultaneous conjugation is the representation model of the
fixed-determinant moduli space (Wehrheim–Woodward, *Floer field theory for coprime rank and
degree*, Theorem 3.3.3 and Remark 3.3.7).

When `ζ` is a primitive `r`-th root of unity (equivalently `gcd(r, d) = 1`) and `r ≥ 1`, the
representation of the subgroup generated by the entries `A_j, B_j` on `ℂ^r` is irreducible
(`Representation.isIrreducible_of_mem_commutator`). Still assuming `IsPrimitiveRoot ζ r`, for
every `r : ℕ` (with only the positive-rank restriction dropped), no proper nonzero subspace of
`ℂ^r` is invariant under all entries (`TauCeti.eq_bot_or_eq_top_of_invariant_relationSet`), every
complex matrix commuting with all `A_j, B_j` is scalar by Schur's lemma
(`TauCeti.exists_eq_smul_one_of_commute_relationSet`), and every element of `SU(r)` commuting
with all entries lies in the center of `SU(r)` (`TauCeti.relationSet_stabilizer_central`;
for the full stabilizer characterization `TauCeti.GaugeModuli.conjAct_smul_relationSet_eq_self_iff`,
see `TauCeti.Geometry.Symplectic.GaugeModuli.RelationModel.Basic`).

So the induced action of `PSU(r)` on the relation set is free (and faithful whenever
`relationSet r ζ g` is nonempty). Without the primitivity hypothesis this fails: for `r = 2`,
`ζ = 1` the pair `(1, 1)` is a solution stabilized by all of `SU(2)`.

## Main definitions

* `TauCeti.relationSet`: the tuples in `SU(r)` whose ordered product of commutators is `ζ • 1`.

## Main results

* `TauCeti.mem_relationSet`, `TauCeti.mem_relationSet_zero_iff`,
  `TauCeti.mem_relationSet_one_iff`, `TauCeti.one_mem_relationSet`,
  `TauCeti.conjAct_smul_mem_relationSet`, `TauCeti.center_mul_mem_relationSet`: basic membership
  characterizations and symmetries of `relationSet`.
* `TauCeti.relationSet_zero_eq_empty`: in genus zero the relation set is empty unless `ζ = 1`
  (for `r ≥ 1`).
* `TauCeti.eq_bot_or_eq_top_of_invariant_relationSet`: for a primitive `r`-th root of unity `ζ`,
  no proper nonzero subspace of `ℂ^r` is invariant under all entries of a solution in
  `relationSet r ζ g` (giving irreducibility of the entry-subgroup representation for `r ≥ 1`).
* `TauCeti.exists_eq_smul_one_of_commute_relationSet`: for a primitive `r`-th root of unity `ζ`,
  every complex `r × r` matrix commuting with all entries of a solution is a scalar matrix.
* `TauCeti.relationSet_stabilizer_central`: for a primitive `r`-th root of unity `ζ`, every element
  of `SU(r)` commuting with all entries of a solution is central.
-/

public section

open scoped commutatorElement

namespace TauCeti

/-- **The twisted relation set.** The tuples `(A₁, B₁, …, A_g, B_g)` in `SU(r)`, recorded as a
family of pairs indexed by `Fin g`, whose ordered product of group commutators
`[A₁,B₁]⋯[A_g,B_g]` is the scalar matrix `ζ • 1`. With `ζ = exp(2πi d/r)` this is the holonomy
relation of the projectively flat rank-`r`, degree-`d` connections on a closed surface of genus `g`
(Wehrheim–Woodward, *Floer field theory for coprime rank and degree*, Remark 3.3.7). -/
def relationSet (r : ℕ) (ζ : ℂ) (g : ℕ) :
    Set (Fin g → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ) :=
  {x | ((List.ofFn fun j ↦ ⁅(x j).1, (x j).2⁆).prod : Matrix (Fin r) (Fin r) ℂ) = ζ • 1}

/-- Membership in the twisted relation set: the ordered product of commutators is `ζ • 1`. -/
@[simp]
theorem mem_relationSet {r : ℕ} {ζ : ℂ} {g : ℕ}
    {x : Fin g → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ} :
    x ∈ relationSet r ζ g ↔
      ((List.ofFn fun j ↦ ⁅(x j).1, (x j).2⁆).prod : Matrix (Fin r) (Fin r) ℂ) = ζ • 1 :=
  Iff.rfl

/-- Membership in the genus-zero twisted relation set reduces to `1 = ζ • 1`. -/
@[simp high]
theorem mem_relationSet_zero_iff {r : ℕ} {ζ : ℂ}
    {x : Fin 0 → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ} :
    x ∈ relationSet r ζ 0 ↔ (1 : Matrix (Fin r) (Fin r) ℂ) = ζ • 1 := by
  simp [mem_relationSet]

/-- Membership in the genus-one twisted relation set reduces to `⁅A, B⁆ = ζ • 1`. -/
@[simp high]
theorem mem_relationSet_one_iff {r : ℕ} {ζ : ℂ}
    {x : Fin 1 → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ} :
    x ∈ relationSet r ζ 1 ↔
      ((⁅(x 0).1, (x 0).2⁆ : Matrix.specialUnitaryGroup (Fin r) ℂ) :
        Matrix (Fin r) (Fin r) ℂ) = ζ • 1 := by
  simp [mem_relationSet]

/-- In the untwisted (`ζ = 1`) relation set, the trivial tuple `1` (all entries equal to `1`) is
always a solution. -/
@[simp high]
theorem one_mem_relationSet (r g : ℕ) :
    (1 : Fin g → Matrix.specialUnitaryGroup (Fin r) ℂ ×
      Matrix.specialUnitaryGroup (Fin r) ℂ) ∈ relationSet r 1 g := by
  rw [mem_relationSet, one_smul]
  have hprod : (List.ofFn fun _ : Fin g =>
      ⁅(1 : Matrix.specialUnitaryGroup (Fin r) ℂ),
        (1 : Matrix.specialUnitaryGroup (Fin r) ℂ)⁆).prod = 1 := by
    simp [List.ofFn_const]
  exact congrArg Subtype.val hprod

/-- Simultaneous conjugation in `SU(r)` preserves the twisted relation set. -/
theorem conjAct_smul_mem_relationSet {r : ℕ} {ζ : ℂ} {g : ℕ}
    (u : ConjAct (Matrix.specialUnitaryGroup (Fin r) ℂ))
    {x : Fin g → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ}
    (hx : x ∈ relationSet r ζ g) : u • x ∈ relationSet r ζ g := by
  rw [mem_relationSet] at hx ⊢
  set g₀ := ConjAct.ofConjAct u
  have hprod :
      (List.ofFn fun j => ⁅((u • x) j).1, ((u • x) j).2⁆).prod =
        g₀ * (List.ofFn fun j => ⁅(x j).1, (x j).2⁆).prod * g₀⁻¹ := by
    have hmap := map_list_prod (MulAut.conj g₀) (List.ofFn fun j => ⁅(x j).1, (x j).2⁆)
    rw [List.map_ofFn] at hmap
    simpa [Function.comp_def, MulAut.conj_apply, map_commutatorElement, ConjAct.smul_def, g₀] using
      hmap.symm
  rw [hprod]
  have hval : ((g₀ * (List.ofFn fun j => ⁅(x j).1, (x j).2⁆).prod * g₀⁻¹ :
      Matrix.specialUnitaryGroup (Fin r) ℂ) : Matrix (Fin r) (Fin r) ℂ) =
      (g₀ : Matrix (Fin r) (Fin r) ℂ) * (ζ • (1 : Matrix (Fin r) (Fin r) ℂ)) *
        ((g₀⁻¹ : Matrix.specialUnitaryGroup (Fin r) ℂ) : Matrix (Fin r) (Fin r) ℂ) := by
    simp [hx]
  rw [hval, Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_one]
  have hmul : (g₀ : Matrix (Fin r) (Fin r) ℂ) *
      ((g₀⁻¹ : Matrix.specialUnitaryGroup (Fin r) ℂ) : Matrix (Fin r) (Fin r) ℂ) = 1 :=
    congrArg Subtype.val (mul_inv_cancel g₀)
  rw [hmul]

/-- Multiplying the entries of a solution `x ∈ relationSet r ζ g` by central elements of `SU(r)`
preserves the commutator product and hence preserves `relationSet r ζ g`. -/
theorem center_mul_mem_relationSet {r : ℕ} {ζ : ℂ} {g : ℕ}
    (ε : Fin g → Subgroup.center (Matrix.specialUnitaryGroup (Fin r) ℂ) ×
      Subgroup.center (Matrix.specialUnitaryGroup (Fin r) ℂ))
    {x : Fin g → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ}
    (hx : x ∈ relationSet r ζ g) :
    (fun j => ((ε j).1.val * (x j).1, (ε j).2.val * (x j).2)) ∈ relationSet r ζ g := by
  rw [mem_relationSet] at hx ⊢
  have hcomm (j : Fin g) :
      ⁅(ε j).1.val * (x j).1, (ε j).2.val * (x j).2⁆ = ⁅(x j).1, (x j).2⁆ := by
    rw [(Subgroup.mem_center_iff.mp (ε j).1.property (x j).1).symm,
      (Subgroup.mem_center_iff.mp (ε j).2.property (x j).2).symm]
    exact TauCeti.commutatorElement_mul_mul_of_mem_center (ε j).1.property (ε j).2.property
  simpa [hcomm] using hx

/-- **The sphere relation set.** In genus zero the product of commutators is empty, so for
`r ≥ 1` the relation `1 = ζ • 1` has no solution unless `ζ = 1`; in particular, for a primitive
`r`-th root of unity with `r ≥ 2` the sphere moduli space is empty. -/
theorem relationSet_zero_eq_empty {r : ℕ} (hr : r ≠ 0) {ζ : ℂ} (hζ : ζ ≠ 1) :
    relationSet r ζ 0 = ∅ := by
  refine Set.eq_empty_of_forall_notMem fun x hx ↦ hζ ?_
  have h := congrFun (congrFun (mem_relationSet.1 hx) ⟨0, Nat.pos_of_ne_zero hr⟩)
    ⟨0, Nat.pos_of_ne_zero hr⟩
  simpa using h.symm

/-- The subgroup of `SU(r)` generated by the entries of a tuple `x`. -/
private def entrySubgroup {r g : ℕ}
    (x : Fin g → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ) :
    Subgroup (Matrix.specialUnitaryGroup (Fin r) ℂ) :=
  Subgroup.closure (Set.range (fun j => (x j).1) ∪ Set.range (fun j => (x j).2))

/-- The canonical representation of `entrySubgroup x` on `ℂ^r`. -/
private noncomputable def entryRep {r g : ℕ}
    (x : Fin g → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ) :
    Representation ℂ (entrySubgroup x) (Fin r → ℂ) :=
  MonoidHom.comp (Matrix.toLinAlgEquiv' : Matrix (Fin r) (Fin r) ℂ ≃ₐ[ℂ] _).toMonoidHom
    ((Matrix.specialUnitaryGroup (Fin r) ℂ).subtype.comp (entrySubgroup x).subtype)

private theorem entryRep_apply {r g : ℕ}
    (x : Fin g → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ)
    (u : entrySubgroup x) :
    entryRep x u =
      Matrix.toLin' ((u : Matrix.specialUnitaryGroup (Fin r) ℂ) : Matrix (Fin r) (Fin r) ℂ) :=
  LinearMap.ext fun v => by
    simp [entryRep, Matrix.toLinAlgEquiv'_apply, Matrix.toLin'_apply]

private theorem isIrreducible_entryRep {r : ℕ} {ζ : ℂ} (hζ : IsPrimitiveRoot ζ r)
    (hr : 0 < r) {g : ℕ}
    {x : Fin g → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ}
    (hx : x ∈ relationSet r ζ g) : (entryRep x).IsIrreducible := by
  have : NeZero r := ⟨hr.ne'⟩
  have hmem (j : Fin g) : (x j).1 ∈ entrySubgroup x ∧ (x j).2 ∈ entrySubgroup x :=
    ⟨Subgroup.subset_closure (Or.inl ⟨j, rfl⟩), Subgroup.subset_closure (Or.inr ⟨j, rfl⟩)⟩
  let z : entrySubgroup x :=
    (List.ofFn fun j => ⁅(⟨(x j).1, (hmem j).1⟩ : entrySubgroup x), ⟨(x j).2, (hmem j).2⟩⁆).prod
  have hz : z ∈ commutator (entrySubgroup x) := by
    refine Subgroup.list_prod_mem _ fun y hy => ?_
    obtain ⟨j, rfl⟩ := List.mem_ofFn.1 hy
    exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
  have hzζ : entryRep x z = ζ • 1 := by
    have hzx : (((z : Matrix.specialUnitaryGroup (Fin r) ℂ)) : Matrix (Fin r) (Fin r) ℂ) =
        ((List.ofFn fun j => ⁅(x j).1, (x j).2⁆).prod : Matrix (Fin r) (Fin r) ℂ) := by
      simp [z, ← (entrySubgroup x).subtype_apply, List.map_ofFn, Function.comp_def,
        map_commutatorElement]
    simp [entryRep_apply, hzx, mem_relationSet.1 hx, Module.End.one_eq_id]
  exact Representation.isIrreducible_of_mem_commutator hz (by simpa using hζ) hzζ

/-- **Irreducibility of coprime twisted representations.** For a primitive `r`-th root of unity
`ζ`, no proper nontrivial subspace of `ℂ^r` is invariant under all entries `(x j).1` and
`(x j).2` of a solution `x ∈ relationSet r ζ g`. -/
theorem eq_bot_or_eq_top_of_invariant_relationSet {r : ℕ} {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ r) {g : ℕ}
    {x : Fin g → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ}
    (hx : x ∈ relationSet r ζ g) (V : Submodule ℂ (Fin r → ℂ))
    (hV : ∀ j, (∀ v ∈ V, Matrix.toLin' ((x j).1 : Matrix (Fin r) (Fin r) ℂ) v ∈ V) ∧
      (∀ v ∈ V, Matrix.toLin' ((x j).2 : Matrix (Fin r) (Fin r) ℂ) v ∈ V)) :
    V = ⊥ ∨ V = ⊤ := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · exact Or.inl (Subsingleton.elim _ _)
  have hirr := isIrreducible_entryRep hζ hr hx
  have hinv := V.forall_mem_closure_toLin'_mem
    (Set.range (fun j => (x j).1) ∪ Set.range (fun j => (x j).2)) (by
      rintro y (⟨j, rfl⟩ | ⟨j, rfl⟩)
      · exact (hV j).1
      · exact (hV j).2)
  let σ : Subrepresentation (entryRep x) :=
    ⟨V, fun u v hv => by rw [entryRep_apply]; exact hinv u u.property v hv⟩
  rcases hirr.eq_bot_or_eq_top σ with hbot | htop
  · exact Or.inl (congrArg Subrepresentation.toSubmodule hbot)
  · exact Or.inr (congrArg Subrepresentation.toSubmodule htop)

/-- **Schur's lemma for the twisted relation set.** For a primitive `r`-th root of unity `ζ`,
every complex `r × r` matrix commuting with all entries of a solution `x ∈ relationSet r ζ g` is
a scalar matrix. -/
theorem exists_eq_smul_one_of_commute_relationSet {r : ℕ} {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ r) {g : ℕ}
    {x : Fin g → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ}
    (hx : x ∈ relationSet r ζ g) (M : Matrix (Fin r) (Fin r) ℂ)
    (hM : ∀ j, Commute M ((x j).1 : Matrix (Fin r) (Fin r) ℂ) ∧
      Commute M ((x j).2 : Matrix (Fin r) (Fin r) ℂ)) :
    ∃ c : ℂ, M = c • (1 : Matrix (Fin r) (Fin r) ℂ) := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · exact ⟨0, Subsingleton.elim _ _⟩
  have := isIrreducible_entryRep hζ hr hx
  have hcomm := M.forall_mem_closure_commute
    (Set.range (fun j => (x j).1) ∪ Set.range (fun j => (x j).2)) (by
      rintro y (⟨j, rfl⟩ | ⟨j, rfl⟩)
      · exact (hM j).1
      · exact (hM j).2)
  obtain ⟨c, hc⟩ := Representation.IsIrreducible.exists_forall_apply_eq_smul (ρ := entryRep x)
    (Matrix.toLin' M) fun u v => by
      simp [entryRep_apply, Matrix.toLin'_apply, Matrix.mulVec_mulVec, (hcomm u u.property).eq]
  exact ⟨c, Matrix.toLin'.injective <| LinearMap.ext fun v => by simpa using hc v⟩

/-- **Stabilizers of the coprime twisted relation are central.** Let `ζ` be a primitive `r`-th root
of unity and `x` a solution of `[A₁,B₁]⋯[A_g,B_g] = ζ • 1` in `SU(r)`. Every `u ∈ SU(r)` commuting
with all `A_j` and `B_j` lies in the center of `SU(r)`. Equivalently, the induced `PSU(r)` action
on the relation set by simultaneous conjugation is free, and faithful whenever `relationSet r ζ g`
is nonempty (Wehrheim–Woodward, *Floer field theory for coprime rank and degree*, proof of
Theorem 3.3.3). -/
theorem relationSet_stabilizer_central {r : ℕ} {ζ : ℂ} (hζ : IsPrimitiveRoot ζ r) {g : ℕ}
    {x : Fin g → Matrix.specialUnitaryGroup (Fin r) ℂ × Matrix.specialUnitaryGroup (Fin r) ℂ}
    (hx : x ∈ relationSet r ζ g) {u : Matrix.specialUnitaryGroup (Fin r) ℂ}
    (hu : ∀ j, Commute u (x j).1 ∧ Commute u (x j).2) :
    u ∈ Subgroup.center (Matrix.specialUnitaryGroup (Fin r) ℂ) := by
  obtain ⟨c, hc⟩ := exists_eq_smul_one_of_commute_relationSet hζ hx (u : Matrix (Fin r) (Fin r) ℂ)
    fun j => ⟨congrArg Subtype.val (hu j).1, congrArg Subtype.val (hu j).2⟩
  exact Subgroup.mem_center_iff.2 fun w ↦ Subtype.ext <| by simp [hc]

end TauCeti
