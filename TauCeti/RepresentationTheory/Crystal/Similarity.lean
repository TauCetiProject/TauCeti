module

public import TauCeti.RepresentationTheory.Crystal.Component
public import TauCeti.RepresentationTheory.Crystal.Highest

/-!
# Similarity morphisms of normal crystals

Fix a root datum `P : RootDatum ι X Y` with a base `b`. For a natural number `n`, a
*similarity morphism of magnification `n`* (`TauCeti.NormalCrystal.SimilarityHom c d n`) between
normal crystals `c` and `d` over `(P, b)` is a map `ψ : B → B'` scaling weights and raising-string
lengths by `n` (`d.wt (ψ x) = n • c.wt x` and `d.ε i (ψ x) = n * c.ε i x`) and intertwining each
raising operator `c.e i` with the `n`-fold iterate `d.eIter i n` (`d.eIter i n (ψ x) =
(c.e i x).map ψ`).

Unlike `StrictHom` (the magnification-`1` case), `ε_toFun` cannot be omitted when `n ≥ 2`:
`d.eIter i n (ψ x) = none` only bounds `d.ε i (ψ x) < n` rather than forcing `d.ε i (ψ x) = 0`.
From `wt_toFun`, `ε_toFun` and `eIter_toFun`, however, both `d.φ i (ψ x) = n * c.φ i x` and
`d.fIter i n (ψ x) = (c.f i x).map ψ` follow unconditionally for all `n : ℕ`, and every raising
or lowering word `w` intertwines with the `n`-fold letter-replicated word
`w.flatMap (List.replicate n)`.

Agreement of two `SimilarityHom c d n` propagates across edges of the crystal graph, so on any
connected normal crystal `c` a similarity morphism is uniquely determined by its value at a single
element (`TauCeti.NormalCrystal.SimilarityHom.eq_of_apply_eq_of_connected`). Moreover, whenever `c`
is generated by lowering words from an element `h`, any `SimilarityHom c d n` is automatically
injective (`TauCeti.NormalCrystal.SimilarityHom.injective_of_forall_exists_fWord_eq_some`).

## Main definitions

* `TauCeti.NormalCrystal.SimilarityHom`: magnification-`n` similarity morphisms of normal crystals,
  with `id`, `comp`, `compStrictHom`, `StrictHom.compSimilarityHom`, `dual`, and the
  magnification-`1` equivalence `TauCeti.NormalCrystal.SimilarityHom.equivStrictHom` with
  `StrictHom`.

## Main results

* `TauCeti.NormalCrystal.SimilarityHom.φ_apply`,
  `TauCeti.NormalCrystal.SimilarityHom.fIter_apply`: automatic compatibility with `φ` and `fIter`.
* `TauCeti.NormalCrystal.SimilarityHom.eWord_flatMap_replicate_apply`,
  `TauCeti.NormalCrystal.SimilarityHom.fWord_flatMap_replicate_apply`: intertwining crystal words
  with letter-replicated words.
* `TauCeti.NormalCrystal.SimilarityHom.eq_of_apply_eq_of_connected`,
  `TauCeti.NormalCrystal.SimilarityHom.eq_of_apply_eq_of_forall_exists_fWord_eq_some`,
  `TauCeti.NormalCrystal.SimilarityHom.injective_of_forall_exists_fWord_eq_some`: rigidity on
  connected crystals and automatic injectivity on crystals generated by lowering words.

## References

* M. Kashiwara, *Similarity of crystal bases*, in *Lie Algebras and Their Representations*
  (Seoul, 1995), Contemp. Math. 194, Amer. Math. Soc. (1996), 177–186.
* P. Littelmann, *Paths and root operators in representation theory*, Ann. of Math. 142 (1995),
  §5.
* D. Bump and A. Schilling, *Crystal bases: representations and combinatorics*, World Scientific
  (2017), §14.1.
-/

public section

namespace TauCeti.NormalCrystal

universe u v w x₁ x₂ x₃

variable {ι : Type u} {X : Type v} {Y : Type w} [AddCommGroup X] [AddCommGroup Y]
  {P : RootDatum ι X Y} {b : P.Base}
  {B : Type x₁} {B' : Type x₂} {B'' : Type x₃}

/-- A **similarity morphism of magnification `n`** between normal crystals: a map scaling weights
and raising-string lengths by `n` and intertwining each raising operator `e i` with `eIter i n`.
Compatibility with `φ` and `fIter` follows (`SimilarityHom.φ_apply`,
`SimilarityHom.fIter_apply`). -/
structure SimilarityHom (c : NormalCrystal P b B) (d : NormalCrystal P b B') (n : ℕ) where
  /-- The underlying map. -/
  toFun : B → B'
  /-- Magnification scales weights by `n`. -/
  wt_toFun (x : B) : d.wt (toFun x) = n • c.wt x
  /-- Magnification scales raising-string lengths by `n`. -/
  ε_toFun (i : b.support) (x : B) : d.ε i (toFun x) = n * c.ε i x
  /-- Raising once in the source corresponds to raising `n` times in the target. -/
  eIter_toFun (i : b.support) (x : B) : d.eIter i n (toFun x) = (c.e i x).map toFun

namespace SimilarityHom

variable {c : NormalCrystal P b B} {d : NormalCrystal P b B'} {d' : NormalCrystal P b B''}
  {m n : ℕ}

instance : FunLike (SimilarityHom c d n) B B' where
  coe := toFun
  coe_injective ψ χ h := by cases ψ; cases χ; congr

@[simp]
theorem toFun_eq_coe (ψ : SimilarityHom c d n) : ψ.toFun = ψ := (rfl)

@[simp]
theorem coe_mk (g : B → B') (hwt hε he) :
    ⇑(⟨g, hwt, hε, he⟩ : SimilarityHom c d n) = g :=
  (rfl)

@[ext]
theorem ext {ψ χ : SimilarityHom c d n} (h : ∀ x, ψ x = χ x) : ψ = χ :=
  DFunLike.ext _ _ h

section Basic

variable (ψ : SimilarityHom c d n) (i : b.support) (x : B)

@[simp]
theorem wt_apply : d.wt (ψ x) = n • c.wt x := ψ.wt_toFun x

@[simp]
theorem ε_apply : d.ε i (ψ x) = n * c.ε i x := ψ.ε_toFun i x

@[simp]
theorem eIter_apply : d.eIter i n (ψ x) = (c.e i x).map ψ := ψ.eIter_toFun i x

/-- Magnification scales the lowering-string lengths `φ i` by `n`. -/
@[simp]
theorem φ_apply : d.φ i (ψ x) = n * c.φ i x := by
  have hd := d.φ_sub_ε i (ψ x)
  have hc := congrArg ((n : ℤ) * ·) (c.φ_sub_ε i x)
  rw [ψ.wt_apply, ψ.ε_apply, map_nsmul, LinearMap.smul_apply, nsmul_eq_mul, ← hc, mul_sub] at hd
  have hcast : (d.φ i (ψ x) : ℤ) = ((n * c.φ i x : ℕ) : ℤ) := by
    push_cast at hd ⊢
    omega
  exact Int.ofNat.inj hcast

/-- When `b.support` and `B` are nonempty, the magnification factor of any similarity morphism is
strictly positive: the top of an `i`-string is annihilated by `c.e i`, whereas `d.eIter i 0` is
always `some`. -/
theorem pos [Nonempty b.support] [Nonempty B] (ψ : SimilarityHom c d n) : 0 < n := by
  obtain ⟨j⟩ := ‹Nonempty b.support›
  obtain ⟨x₀⟩ := ‹Nonempty B›
  obtain ⟨z, hz⟩ := Option.isSome_iff_exists.mp
    ((c.isSome_eIter_iff (i := j) (n := c.ε j x₀) (x := x₀)).mpr le_rfl)
  have hεz : c.ε j z = 0 := by
    have := c.ε_of_eIter_eq_some hz
    omega
  have hez : c.e j z = none := c.ε_eq_zero_iff.mp hεz
  by_contra hn
  obtain rfl : n = 0 := by omega
  have h0 : some (ψ z) = (c.e j z).map ψ := (d.eIter_zero (ψ z)).symm.trans (ψ.eIter_apply j z)
  simp [hez] at h0

/-- Lowering once in the source corresponds to lowering `n` times in the target. -/
@[simp]
theorem fIter_apply : d.fIter i n (ψ x) = (c.f i x).map ψ := by
  have : Nonempty b.support := ⟨i⟩
  have : Nonempty B := ⟨x⟩
  have hn : 0 < n := ψ.pos
  cases hf : c.f i x with
  | none =>
    have hφ : c.φ i x = 0 := c.φ_eq_zero_iff.mpr hf
    simp [d.fIter_eq_none_iff.mpr (by rw [ψ.φ_apply, hφ, mul_zero]; exact hn)]
  | some y =>
    have hey : c.e i y = some x := c.f_eq_some_iff.mp hf
    have heIter : d.eIter i n (ψ y) = some (ψ x) := by simp [ψ.eIter_apply, hey]
    simpa using d.fIter_eq_some_iff.mpr heIter

/-- A magnification-`n` similarity morphism induces a magnification-`n` similarity morphism between
the dual crystals. -/
def dual (ψ : SimilarityHom c d n) : SimilarityHom c.dual d.dual n where
  toFun := ψ
  wt_toFun x := by simp
  ε_toFun i x := by simp
  eIter_toFun i x := by simp

@[simp]
theorem dual_apply (ψ : SimilarityHom c d n) (x : B) : ψ.dual x = ψ x := (rfl)

/-- Applying a raising word in the source corresponds to applying the `n`-fold letter-replicated
raising word in the target. -/
theorem eWord_flatMap_replicate_apply (w : List b.support) (x : B) :
    d.eWord (w.flatMap (List.replicate n)) (ψ x) = (c.eWord w x).map ψ := by
  induction w generalizing x with
  | nil => simp
  | cons j w ih =>
    rw [List.flatMap_cons, d.eWord_append, d.eWord_replicate, ψ.eIter_apply, c.eWord_cons]
    cases c.e j x <;> simp [ih]

/-- Applying a lowering word in the source corresponds to applying the `n`-fold letter-replicated
lowering word in the target. -/
theorem fWord_flatMap_replicate_apply (w : List b.support) (x : B) :
    d.fWord (w.flatMap (List.replicate n)) (ψ x) = (c.fWord w x).map ψ := by
  have hdual : ⇑ψ.dual = ⇑ψ := funext ψ.dual_apply
  simpa [hdual] using ψ.dual.eWord_flatMap_replicate_apply w x

/-- Raising `k` times in the source corresponds to raising `k * n` times in the target. -/
theorem eIter_mul_apply (k : ℕ) :
    d.eIter i (k * n) (ψ x) = (c.eIter i k x).map ψ := by
  simpa [List.flatMap_replicate] using ψ.eWord_flatMap_replicate_apply (List.replicate k i) x

/-- Lowering `k` times in the source corresponds to lowering `k * n` times in the target. -/
theorem fIter_mul_apply (k : ℕ) :
    d.fIter i (k * n) (ψ x) = (c.fIter i k x).map ψ := by
  have hdual : ⇑ψ.dual = ⇑ψ := funext ψ.dual_apply
  simpa [hdual] using ψ.dual.eIter_mul_apply i x k

/-- `ψ x` is annihilated by `d.e i` if and only if `x` is annihilated by `c.e i`. -/
@[simp]
theorem e_apply_eq_none_iff {i : b.support} {x : B} :
    d.e i (ψ x) = none ↔ c.e i x = none := by
  have : Nonempty b.support := ⟨i⟩
  have : Nonempty B := ⟨x⟩
  rw [← d.ε_eq_zero_iff, ← c.ε_eq_zero_iff, ψ.ε_apply, mul_eq_zero, or_iff_right ψ.pos.ne']

/-- `ψ x` is annihilated by `d.f i` if and only if `x` is annihilated by `c.f i`. -/
@[simp]
theorem f_apply_eq_none_iff {i : b.support} {x : B} :
    d.f i (ψ x) = none ↔ c.f i x = none := by
  simpa using ψ.dual.e_apply_eq_none_iff (i := i) (x := x)

/-- `ψ x` is a highest element of `d` if and only if `x` is a highest element of `c`. -/
theorem forall_e_apply_eq_none_iff {x : B} :
    (∀ j, d.e j (ψ x) = none) ↔ ∀ j, c.e j x = none :=
  forall_congr' fun _ ↦ ψ.e_apply_eq_none_iff

end Basic

/-! ### Composition and strict morphisms -/

/-- Every strict crystal morphism is a similarity morphism of magnification `1`. -/
def ofStrictHom (φ : StrictHom c d) : SimilarityHom c d 1 where
  toFun := φ
  wt_toFun x := by simp
  ε_toFun i x := by simp
  eIter_toFun i x := by simp

@[simp]
theorem coe_ofStrictHom (φ : StrictHom c d) : ⇑(ofStrictHom φ) = φ := (rfl)

/-- Every similarity morphism of magnification `1` is a strict crystal morphism. -/
def toStrictHom (ψ : SimilarityHom c d 1) : StrictHom c d where
  toFun := ψ
  wt_toFun x := by simp
  e_toFun i x := by simpa only [eIter_one] using ψ.eIter_apply i x

@[simp]
theorem coe_toStrictHom (ψ : SimilarityHom c d 1) : ⇑ψ.toStrictHom = ψ := (rfl)

@[simp]
theorem toStrictHom_ofStrictHom (φ : StrictHom c d) : (ofStrictHom φ).toStrictHom = φ := (rfl)

@[simp]
theorem ofStrictHom_toStrictHom (ψ : SimilarityHom c d 1) : ofStrictHom ψ.toStrictHom = ψ := (rfl)

/-- Similarity morphisms of magnification `1` are canonically equivalent to strict morphisms. -/
def equivStrictHom : SimilarityHom c d 1 ≃ StrictHom c d where
  toFun := toStrictHom
  invFun := ofStrictHom
  left_inv _ := ext fun _ ↦ rfl
  right_inv _ := StrictHom.ext fun _ ↦ rfl

@[simp]
theorem equivStrictHom_apply (ψ : SimilarityHom c d 1) : equivStrictHom ψ = ψ.toStrictHom := (rfl)

@[simp]
theorem equivStrictHom_symm_apply (φ : StrictHom c d) :
    equivStrictHom.symm φ = ofStrictHom φ :=
  (rfl)

variable (c) in
/-- The identity similarity morphism (magnification `1`). -/
def id : SimilarityHom c c 1 where
  toFun x := x
  wt_toFun _ := by simp
  ε_toFun _ _ := by simp
  eIter_toFun _ _ := by simp

@[simp]
theorem id_apply (x : B) : SimilarityHom.id c x = x := (rfl)

@[simp]
theorem toStrictHom_id (c : NormalCrystal P b B) :
    (SimilarityHom.id c).toStrictHom = StrictHom.id c :=
  StrictHom.ext fun _ ↦ by simp

@[simp]
theorem ofStrictHom_id (c : NormalCrystal P b B) :
    ofStrictHom (StrictHom.id c) = SimilarityHom.id c :=
  ext fun _ ↦ by simp

/-- Composing a magnification-`m` similarity morphism with a magnification-`n` similarity morphism
gives a magnification-`(m * n)` similarity morphism. -/
def comp (χ : SimilarityHom d d' m) (ψ : SimilarityHom c d n) : SimilarityHom c d' (m * n) where
  toFun x := χ (ψ x)
  wt_toFun x := by simp [mul_smul]
  ε_toFun i x := by simp [mul_assoc]
  eIter_toFun i x := by
    rw [mul_comm, χ.eIter_mul_apply, ψ.eIter_apply, Option.map_map]
    rfl

@[simp]
theorem comp_apply (χ : SimilarityHom d d' m) (ψ : SimilarityHom c d n) (x : B) :
    χ.comp ψ x = χ (ψ x) :=
  (rfl)

/-- Precomposing a magnification-`n` similarity morphism with a strict crystal morphism keeps the
magnification index definitionally equal to `n`. -/
def compStrictHom (ψ : SimilarityHom d d' n) (φ : StrictHom c d) : SimilarityHom c d' n where
  toFun x := ψ (φ x)
  wt_toFun x := by simp
  ε_toFun i x := by simp
  eIter_toFun i x := by
    rw [ψ.eIter_apply, φ.e_apply, Option.map_map]
    rfl

@[simp]
theorem compStrictHom_apply (ψ : SimilarityHom d d' n) (φ : StrictHom c d) (x : B) :
    ψ.compStrictHom φ x = ψ (φ x) :=
  (rfl)

@[simp]
theorem compStrictHom_id (ψ : SimilarityHom c d n) : ψ.compStrictHom (StrictHom.id c) = ψ :=
  ext fun _ ↦ by simp

theorem compStrictHom_comp {B''' : Type*} {d'' : NormalCrystal P b B'''}
    (θ : SimilarityHom d' d'' n) (χ : StrictHom d d') (ψ : StrictHom c d) :
    θ.compStrictHom (χ.comp ψ) = (θ.compStrictHom χ).compStrictHom ψ :=
  ext fun _ ↦ by simp

/-! ### Rigidity and injectivity -/

/-- Two magnification-`n` similarity morphisms that agree at `x` agree at every element reachable
from `x` in the crystal graph. -/
theorem apply_eq_of_reachable {ψ₁ ψ₂ : SimilarityHom c d n} {x y : B}
    (hxy : c.graph.Reachable x y) (hx : ψ₁ x = ψ₂ x) :
    ψ₁ y = ψ₂ y := by
  rw [SimpleGraph.reachable_iff_reflTransGen] at hxy
  induction hxy with
  | refl => exact hx
  | @tail u v _ hadj ih =>
    obtain ⟨i, h | h⟩ := c.graph_adj_iff.mp hadj
    · have h₁ := ψ₁.eIter_apply i u
      have h₂ := ψ₂.eIter_apply i u
      rw [h, Option.map_some, ih] at h₁
      rw [h, Option.map_some, h₁] at h₂
      exact Option.some.inj h₂
    · have hf := c.e_eq_some_iff.mp h
      have h₁ := ψ₁.fIter_apply i u
      have h₂ := ψ₂.fIter_apply i u
      rw [hf, Option.map_some, ih] at h₁
      rw [hf, Option.map_some, h₁] at h₂
      exact Option.some.inj h₂

/-- Two magnification-`n` similarity morphisms out of a connected normal crystal are equal as soon
as they agree at a single element. -/
theorem eq_of_apply_eq_of_connected {ψ₁ ψ₂ : SimilarityHom c d n} {x₀ : B}
    (hx₀ : ψ₁ x₀ = ψ₂ x₀) (hc : c.graph.Connected) :
    ψ₁ = ψ₂ :=
  ext fun x ↦ apply_eq_of_reachable (hc x₀ x) hx₀

/-- Two magnification-`n` similarity morphisms out of a crystal generated by lowering words from
`h` are equal as soon as they agree at `h`. -/
theorem eq_of_apply_eq_of_forall_exists_fWord_eq_some {ψ₁ ψ₂ : SimilarityHom c d n} {h : B}
    (hh : ψ₁ h = ψ₂ h) (hgen : ∀ x, ∃ w : List b.support, c.fWord w h = some x) :
    ψ₁ = ψ₂ := by
  have hreach {w : List b.support} {u v : B} (hw : c.fWord w u = some v) :
      c.graph.Reachable u v := by
    induction w generalizing u with
    | nil =>
      rw [c.fWord_nil] at hw
      obtain rfl := Option.some.inj hw
      exact .rfl
    | cons i w ih =>
      obtain ⟨z, hz, hzw⟩ := Option.bind_eq_some_iff.mp (c.fWord_cons i w u ▸ hw)
      exact (c.graph_adj_of_f_eq_some hz).reachable.trans (ih hzw)
  have : Nonempty B := ⟨h⟩
  refine eq_of_apply_eq_of_connected hh ⟨fun x y ↦ ?_⟩
  obtain ⟨wx, hwx⟩ := hgen x
  obtain ⟨wy, hwy⟩ := hgen y
  exact (hreach hwx).symm.trans (hreach hwy)

/-- **Automatic injectivity of crystal similarity**: every magnification-`n` similarity morphism
out of a crystal generated by lowering words from an element `h` is injective. -/
theorem injective_of_forall_exists_fWord_eq_some (ψ : SimilarityHom c d n) {h : B}
    (hgen : ∀ x, ∃ w : List b.support, c.fWord w h = some x) :
    Function.Injective ψ := by
  intro x y hxy
  obtain ⟨w, hw⟩ := hgen x
  have hfy : d.fWord (w.flatMap (List.replicate n)) (ψ h) = some (ψ y) := by
    rw [← hxy, ψ.fWord_flatMap_replicate_apply, hw, Option.map_some]
  have hey : d.eWord (w.reverse.flatMap (List.replicate n)) (ψ y) = some (ψ h) := by
    simpa [List.reverse_flatMap, Function.comp_def] using d.fWord_eq_some_iff.mp hfy
  rw [ψ.eWord_flatMap_replicate_apply, Option.map_eq_some_iff] at hey
  obtain ⟨h', hh', hψh⟩ := hey
  have hh_high : ∀ i, c.e i h = none := c.e_eq_none_of_forall_exists_fWord_eq_some hgen
  have hh'_high : ∀ i, c.e i h' = none :=
    ψ.forall_e_apply_eq_none_iff.mp (by rwa [hψh, ψ.forall_e_apply_eq_none_iff])
  obtain rfl : h = h' := (c.eq_of_highest_of_exists_fWord_eq_some hh'_high (hgen h')).symm
  have hwy : c.fWord w h = some y := c.fWord_eq_some_iff.mpr hh'
  exact Option.some.inj (hw.symm.trans hwy)

/-- On a finite normal crystal over a finite reduced root datum with a unique highest element `h`,
two magnification-`n` similarity morphisms agreeing on `h` are equal. -/
theorem eq_of_apply_eq_of_unique_highest [Finite ι] [P.IsReduced] [Finite B]
    {ψ₁ ψ₂ : SimilarityHom c d n} {h : B}
    (heq : ψ₁ h = ψ₂ h) (hh : ∀ x, (∀ i, c.e i x = none) → x = h) :
    ψ₁ = ψ₂ :=
  eq_of_apply_eq_of_forall_exists_fWord_eq_some heq
    (c.exists_fWord_eq_some_of_unique_highest hh)

/-- On a finite normal crystal over a finite reduced root datum with a unique highest element `h`,
every magnification-`n` similarity morphism is injective. -/
theorem injective_of_unique_highest [Finite ι] [P.IsReduced] [Finite B]
    (ψ : SimilarityHom c d n) {h : B}
    (hh : ∀ x, (∀ i, c.e i x = none) → x = h) :
    Function.Injective ψ :=
  ψ.injective_of_forall_exists_fWord_eq_some (c.exists_fWord_eq_some_of_unique_highest hh)

end SimilarityHom

namespace StrictHom

variable {c : NormalCrystal P b B} {d : NormalCrystal P b B'} {d' : NormalCrystal P b B''} {n : ℕ}

/-- Postcomposing a magnification-`n` similarity morphism with a strict crystal morphism keeps the
magnification index definitionally equal to `n`. -/
def compSimilarityHom (φ : StrictHom d d') (ψ : SimilarityHom c d n) : SimilarityHom c d' n where
  toFun x := φ (ψ x)
  wt_toFun x := by simp
  ε_toFun i x := by simp
  eIter_toFun i x := by
    rw [φ.eIter_apply, ψ.eIter_apply, Option.map_map]
    rfl

@[simp]
theorem compSimilarityHom_apply (φ : StrictHom d d') (ψ : SimilarityHom c d n) (x : B) :
    φ.compSimilarityHom ψ x = φ (ψ x) :=
  (rfl)

@[simp]
theorem id_compSimilarityHom (ψ : SimilarityHom c d n) :
    (StrictHom.id d).compSimilarityHom ψ = ψ :=
  SimilarityHom.ext fun _ ↦ by simp

theorem comp_compSimilarityHom {B''' : Type*} {d'' : NormalCrystal P b B'''}
    (θ : StrictHom d' d'') (χ : StrictHom d d') (ψ : SimilarityHom c d n) :
    (θ.comp χ).compSimilarityHom ψ = θ.compSimilarityHom (χ.compSimilarityHom ψ) :=
  SimilarityHom.ext fun _ ↦ by simp

theorem compSimilarityHom_compStrictHom {B''' : Type*} {d'' : NormalCrystal P b B'''}
    (θ : StrictHom d' d'') (ψ : SimilarityHom d d' n) (φ : StrictHom c d) :
    (θ.compSimilarityHom ψ).compStrictHom φ = θ.compSimilarityHom (ψ.compStrictHom φ) :=
  (rfl)

end StrictHom

end TauCeti.NormalCrystal
