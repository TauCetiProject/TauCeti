module

public import TauCeti.RepresentationTheory.Crystal.Word
import TauCeti.LinearAlgebra.RootSystem.Weyl.Vector
import Mathlib.Order.WellFoundedSet

/-!
# Generation of finite crystals by highest elements

In a finite normal crystal over a finite reduced root datum, raising always terminates.
Indeed, pairing the weight with the sum of the positive coroots increases by two at each
raising step. Every element therefore lies below a highest element, and reversing the raising
word expresses it as a lowering word from that highest element.

Consequently a finite crystal with a specified highest element is generated by that element
exactly when it is the unique highest element. This criterion separates termination from the
additional highest-element uniqueness theorems needed in path models. No uniqueness or
classification of connected normal crystals follows from the rank-one axioms alone.

The integral height uses `TauCeti.coroot'_twoWeylVector` on the dual root datum; it needs no
choice of fundamental weights or assumption that the roots span the character lattice.

## References

* P. Littelmann, *Paths and root operators in representation theory*, Ann. of Math. 142 (1995),
  §§2, 4.
* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §13.3
  (the Weyl vector).
-/

public section

namespace TauCeti.NormalCrystal

variable {ι X Y B : Type*} [AddCommGroup X] [AddCommGroup Y]
  {P : RootDatum ι X Y} {b : P.Base} (c : NormalCrystal P b B)

section Finite

variable [Finite ι] [P.IsReduced] [Finite B]

/-- Raising in a finite normal crystal is well-founded, oriented towards highest elements. -/
theorem wellFounded_e : WellFounded (fun y x : B ↦ ∃ i, c.e i x = some y) := by
  have : Module.IsReflexive ℤ X := .of_isPerfPair P.toLinearMap
  have : Module.IsReflexive ℤ Y := .of_isPerfPair P.flip.toLinearMap
  let H : B → ℤ := fun x ↦ P.toLinearMap (c.wt x) (twoWeylVector P.flip b.flip)
  have hH {x y : B} {i : b.support} (h : c.e i x = some y) : H y = H x + 2 := by
    have hi := coroot'_twoWeylVector P.flip b.flip i.prop
    simpa only [H, c.wt_of_e_eq_some h, map_add, LinearMap.add_apply,
      RootPairing.coroot', RootPairing.flip_toLinearMap, RootPairing.flip_coroot,
      LinearMap.flip_apply] using congrArg (H x + ·) hi
  have hw : WellFounded (fun y x : B ↦ H x < H y) :=
    Set.wellFoundedOn_range.mp ((Set.finite_range H).wellFoundedOn (r := (· > ·)))
  exact hw.mono fun y x ⟨i, hi⟩ ↦ by linarith [hH hi]

/-- Every element of a finite normal crystal can be raised to a highest element. -/
theorem exists_eWord_eq_some_highest (x : B) :
    ∃ (w : List b.support) (y : B), c.eWord w x = some y ∧ ∀ i, c.e i y = none := by
  classical
  induction x using c.wellFounded_e.induction with
  | h x ih =>
    by_cases hx : ∀ i, c.e i x = none
    · exact ⟨[], x, c.eWord_nil x, hx⟩
    · obtain ⟨i, hi⟩ := not_forall.mp hx
      obtain ⟨y, hy⟩ := Option.ne_none_iff_exists'.mp hi
      obtain ⟨w, z, hw, hz⟩ := ih y ⟨i, hy⟩
      exact ⟨i :: w, z, by rw [eWord_cons, hy, Option.bind_some, hw], hz⟩

/-- Every element of a finite normal crystal is obtained by lowering a highest element. -/
theorem exists_highest_fWord_eq_some (x : B) :
    ∃ (y : B) (w : List b.support), (∀ i, c.e i y = none) ∧ c.fWord w y = some x := by
  obtain ⟨w, y, hw, hy⟩ := c.exists_eWord_eq_some_highest x
  exact ⟨y, w.reverse, hy, c.eWord_eq_some_iff.mp hw⟩

/-- A finite normal crystal with a unique highest element is generated from it by lowering. -/
theorem exists_fWord_eq_some_of_unique_highest {h : B}
    (hh : ∀ x, (∀ i, c.e i x = none) → x = h) (x : B) :
    ∃ w : List b.support, c.fWord w h = some x := by
  obtain ⟨y, w, hy, hw⟩ := c.exists_highest_fWord_eq_some x
  exact ⟨w, hh y hy ▸ hw⟩

end Finite

/-- A highest element reachable by lowering from `h` equals `h`.
This direction requires no finiteness assumption. -/
theorem eq_of_highest_of_exists_fWord_eq_some {h x : B} (hx : ∀ i, c.e i x = none)
    (hgen : ∃ w : List b.support, c.fWord w h = some x) : x = h := by
  obtain ⟨w, hw⟩ := hgen
  exact ((c.eWord_eq_some_iff_of_highest hx w.reverse).mp
    (c.fWord_eq_some_iff.mp hw)).2

/-- For a finite normal crystal, generation from a given element is equivalent to that
element being the only possible highest element. -/
theorem forall_exists_fWord_eq_some_iff [Finite ι] [P.IsReduced] [Finite B] (h : B) :
    (∀ x, ∃ w : List b.support, c.fWord w h = some x) ↔
      ∀ x, (∀ i, c.e i x = none) → x = h := by
  exact ⟨fun hgen x hx ↦ c.eq_of_highest_of_exists_fWord_eq_some hx (hgen x),
    fun hh x ↦ c.exists_fWord_eq_some_of_unique_highest hh x⟩

end TauCeti.NormalCrystal
