module

public import Mathlib.RepresentationTheory.Homological.GroupHomology.LowDegree
import TauCeti.RepresentationTheory.Coinvariants

/-!
# Group homology in degrees zero and one

Complements to Mathlib's `Mathlib.RepresentationTheory.Homological.GroupHomology.LowDegree`, which
identifies `H₀(G, A)` with the coinvariants of `A`, and `H₁(G, A)` with `Gᵃᵇ ⊗ A` for trivial
coefficients `A`.

## Main definitions

* `TauCeti.groupHomology.H0IsoOfForallMemZpowers`: if `g` generates `G`, then `H₀(G, A)` is
  `A / (ρ(g) - 𝟙) A`. Unlike Mathlib's `Rep.FiniteCyclicGroup.groupHomologyIso₀`, `G` need not be
  finite.

## Main results

* `TauCeti.groupHomology.H0π_eq_iff`: two elements of `A` have the same class in `H₀(G, A)`
  exactly when their difference lies in the augmentation submodule
  `Representation.Coinvariants.ker A.ρ`.
* `TauCeti.groupHomology.H0π_comp_H0IsoOfForallMemZpowers_hom`: `H0IsoOfForallMemZpowers` sends
  the class of `a` to the class of `a`.
* `TauCeti.groupHomology.isZero_H1_of_forall_exists_zpow_eq`: if every element of `G` is an
  `m`-th power and `m` kills the trivial coefficients `A`, then `H₁(G, A) = 0`.
-/

public section

universe u

namespace TauCeti.groupHomology

open _root_.groupHomology

variable {k G : Type u} [CommRing k] [Group G] (A : Rep k G)

/-- Two elements of `A` have the same class in `H₀(G, A)` exactly when their difference lies in
the augmentation submodule `Representation.Coinvariants.ker A.ρ`, the kernel of the projection to
the coinvariants. -/
theorem H0π_eq_iff {x y : A.V} :
    H0π A x = H0π A y ↔ x - y ∈ Representation.Coinvariants.ker A.ρ := by
  rw [← coinvariantsMk_comp_H0Iso_inv_apply, ← coinvariantsMk_comp_H0Iso_inv_apply]
  exact (H0Iso A).toLinearEquiv.symm.injective.eq_iff.trans
    (Representation.Coinvariants.mk_eq_iff _)

/-- **The zeroth homology of a cyclic group** generated by `g` is the module of coinvariants
`A / (ρ(g) - 𝟙) A`. Unlike Mathlib's `Rep.FiniteCyclicGroup.groupHomologyIso₀`, `G` need not be
finite. -/
noncomputable def H0IsoOfForallMemZpowers {g : G} (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    groupHomology A 0 ≅ ModuleCat.of k (A ⧸ LinearMap.range (A.ρ g - LinearMap.id)) :=
  H0Iso A ≪≫ (Submodule.quotEquivOfEq _ _
    (Representation.coinvariantsKer_eq_range_of_forall_mem_zpowers A.ρ g hg)).toModuleIso

open CategoryTheory in
/-- The identification `H0IsoOfForallMemZpowers` sends the class of `a` to the class of `a`
modulo `(ρ(g) - 𝟙) A`. -/
@[reassoc (attr := simp), elementwise (attr := simp)]
theorem H0π_comp_H0IsoOfForallMemZpowers_hom {g : G} (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    H0π A ≫ (H0IsoOfForallMemZpowers A hg).hom =
      ModuleCat.ofHom (LinearMap.range (A.ρ g - LinearMap.id)).mkQ := by
  ext x
  -- `(H0Iso A ≪≫ e.toModuleIso).hom` is `e` after `H0Iso A`, which sends the class of `a` to
  -- `Coinvariants.mk a`, by definition the quotient class `Submodule.Quotient.mk a`; the
  -- composite `≪≫` is stated through this definitional equality, so `Iso.trans_hom` cannot
  -- rewrite it. `Submodule.quotEquivOfEq_mk` then says that `e` keeps the class of `a`.
  exact (congrArg (Submodule.quotEquivOfEq _ _
    (Representation.coinvariantsKer_eq_range_of_forall_mem_zpowers A.ρ g hg))
      congr($(H0π_comp_H0Iso_hom A).hom x)).trans
    (Submodule.quotEquivOfEq_mk _ _ _ x)

open TensorProduct in
/-- **First homology of a divisible group.** If every element of `G` is an `m`-th power and
multiplication by `m` is zero on the trivial representation `A`, then `H₁(G, A) = Gᵃᵇ ⊗ A`
vanishes. -/
theorem isZero_H1_of_forall_exists_zpow_eq [A.IsTrivial] (m : ℤ) (hG : ∀ g : G, ∃ x, x ^ m = g)
    (hA : ∀ a : A.V, m • a = 0) : CategoryTheory.Limits.IsZero (H1 A) := by
  rw [ModuleCat.isZero_iff_subsingleton]
  suffices Subsingleton (Additive (Group.Abelianization G) ⊗[ℤ] A) from
    (H1AddEquivOfIsTrivial A).injective.subsingleton
  rw [subsingleton_iff_forall_eq 0]
  intro z
  induction z using TensorProduct.inductionOn with
  | tmul x a =>
    -- the class of `g = yᵐ` is `m` times that of `y`, and `m` kills `a`
    obtain ⟨g, hg⟩ : ∃ g, Group.Abelianization.of g = x.toMul := QuotientGroup.mk_surjective x.toMul
    obtain ⟨y, rfl⟩ := hG g
    rw [← ofMul_toMul x, ← hg, map_zpow, ofMul_zpow, TensorProduct.smul_tmul, hA,
      TensorProduct.tmul_zero]
  | add x y hx hy => rw [hx, hy, add_zero]

end TauCeti.groupHomology
