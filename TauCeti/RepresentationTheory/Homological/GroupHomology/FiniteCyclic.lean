module

public import Mathlib.Algebra.Module.Torsion.Basic
public import Mathlib.Data.ZMod.QuotientRing
public import Mathlib.RepresentationTheory.Homological.GroupHomology.FiniteCyclic
public import Mathlib.RingTheory.QuotSMulTop

/-!
# Homology of a finite cyclic group with trivial coefficients

Let `G` be a finite cyclic group generated by `g`, and let `A` be a `k`-module on which `G` acts
trivially. Mathlib computes the group homology of `G` from the periodic resolution
`⋯ → k[G] --N--> k[G] --(g - 1)--> k[G] → k`: in odd degree it is the homology of
`A --N--> A --(ρ(g) - 𝟙)--> A`, and in positive even degree that of
`A --(ρ(g) - 𝟙)--> A --N--> A` (`Rep.FiniteCyclicGroup.groupHomologyIsoOdd`,
`Rep.FiniteCyclicGroup.groupHomologyIsoEven`). For the trivial action `ρ(g) - 𝟙` vanishes and the
norm `N` is multiplication by the order `|G|`, so

* `Hᵢ(G, A) ≅ A / |G| A` for odd `i`, the quotient `QuotSMulTop (Nat.card G) A`;
* `Hᵢ(G, A) ≅ A[|G|]` for positive even `i`, the `|G|`-torsion submodule
  `Submodule.torsionBy k A (Nat.card G)`.

Both identifications are induced by the representative maps
`Rep.FiniteCyclicGroup.groupHomologyπOdd` and `Rep.FiniteCyclicGroup.groupHomologyπEven`, so they
depend on the generator `g`. For integral coefficients they give `Hᵢ(G, ℤ) ≅ ℤ/|G|` in odd degree
and `Hᵢ(G, ℤ) = 0` in positive even degree.

## Main definitions

* `Rep.FiniteCyclicGroup.groupHomologyTrivialLinearEquivOdd`: `Hᵢ(G, A) ≃ₗ[k] A / |G| A` for odd
  `i`.
* `Rep.FiniteCyclicGroup.groupHomologyTrivialLinearEquivEven`: `Hᵢ(G, A) ≃ₗ[k] A[|G|]` for
  positive even `i`.
* `Rep.FiniteCyclicGroup.groupHomologyTrivialIntLinearEquivOdd`: `Hᵢ(G, ℤ) ≃ₗ[ℤ] ZMod |G|` for odd
  `i`.

## Main results

* `Rep.FiniteCyclicGroup.groupHomologyπOdd_surjective`,
  `Rep.FiniteCyclicGroup.groupHomologyπEven_surjective`: every homology class of a finite cyclic
  group, with arbitrary coefficients, has a representative in the periodic model.
* `Rep.FiniteCyclicGroup.subsingleton_groupHomology_trivial_of_even`: if multiplication by `|G|`
  is injective on `A`, then `Hᵢ(G, A)` vanishes in positive even degree; in particular
  `Hᵢ(G, ℤ) = 0` (`Rep.FiniteCyclicGroup.subsingleton_groupHomology_trivial_int_of_even`).

## References

* K. S. Brown, *Cohomology of Groups*, GTM 87, Springer, 1982, Chapter I, Section 6, for the
  periodic resolution, and Chapter III, Section 1, for the homology of a finite cyclic group.
-/

public noncomputable section

universe u

open CategoryTheory

open scoped Pointwise

namespace Rep.FiniteCyclicGroup

section Surjective

variable {k G : Type u} [CommRing k] [CommGroup G] [Fintype G] [DecidableEq G] (A : Rep k G)
  (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g)

/-- In odd degree, every class in the homology of a finite cyclic group is represented by an
element killed by `ρ(g) - 𝟙`. -/
theorem groupHomologyπOdd_surjective (i : ℕ) (hi : Odd i) :
    Function.Surjective (groupHomologyπOdd A g hg i hi) := by
  rw [← ModuleCat.epi_iff_surjective]
  have h₁ : Epi (normHomCompSub A g).moduleCatCyclesIso.inv := inferInstance
  have h₂ : Epi (normHomCompSub A g).homologyπ := inferInstance
  exact epi_comp' h₁ (epi_comp' h₂ inferInstance)

/-- In positive even degree, every class in the homology of a finite cyclic group is represented
by an element killed by the norm. -/
theorem groupHomologyπEven_surjective (i : ℕ) [NeZero i] (hi : Even i) :
    Function.Surjective (groupHomologyπEven A g hg i hi) := by
  rw [← ModuleCat.epi_iff_surjective]
  have h₁ : Epi (subCompNormHom A g).moduleCatCyclesIso.inv := inferInstance
  have h₂ : Epi (subCompNormHom A g).homologyπ := inferInstance
  exact epi_comp' h₁ (epi_comp' h₂ inferInstance)

end Surjective

section Trivial

variable (k : Type u) {G : Type u} [CommRing k] [CommGroup G] [Fintype G] [DecidableEq G]
  (A : Type u) [AddCommGroup A] [Module k A] (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g)

/-- The representative map `A → Hᵢ(G, A)` in odd degree, for the trivial representation: every
element of `A` is killed by `ρ(g) - 𝟙 = 0`, so `Rep.FiniteCyclicGroup.groupHomologyπOdd` is defined
on all of `A`. -/
private def groupHomologyTrivialπOdd (i : ℕ) (hi : Odd i) :
    A →ₗ[k] groupHomology (Rep.trivial k G A) i :=
  (groupHomologyπOdd (Rep.trivial k G A) g hg i hi).hom ∘ₗ
    LinearMap.codRestrict _ (LinearMap.id : A →ₗ[k] A) fun _ ↦ by simp [Rep.applyAsHom, sub_hom]

private theorem groupHomologyTrivialπOdd_surjective (i : ℕ) (hi : Odd i) :
    Function.Surjective (groupHomologyTrivialπOdd k A g hg i hi) := by
  intro y
  obtain ⟨x, rfl⟩ := groupHomologyπOdd_surjective (Rep.trivial k G A) g hg i hi y
  exact ⟨x.1, rfl⟩

private theorem ker_groupHomologyTrivialπOdd (i : ℕ) (hi : Odd i) :
    LinearMap.ker (groupHomologyTrivialπOdd k A g hg i hi) =
      (Nat.card G : k) • (⊤ : Submodule k A) := by
  ext x
  rw [LinearMap.mem_ker, groupHomologyTrivialπOdd, LinearMap.comp_apply]
  rw [groupHomologyπOdd_eq_zero_iff]
  simp [Representation.norm, Submodule.mem_smul_pointwise_iff_exists, Nat.card_eq_fintype_card,
    Nat.cast_smul_eq_nsmul, eq_comm]

/-- **Odd-degree homology of a finite cyclic group with trivial coefficients.** If `G` is a finite
group generated by `g` and `A` is a `k`-module with the trivial action, then for odd `i`,
`Hᵢ(G, A) ≃ A / |G| A`. It sends the class that `Rep.FiniteCyclicGroup.groupHomologyπOdd`
assigns to `x ∈ A` to the residue class of `x`. -/
def groupHomologyTrivialLinearEquivOdd (i : ℕ) (hi : Odd i) :
    groupHomology (Rep.trivial k G A) i ≃ₗ[k] QuotSMulTop (Nat.card G : k) A :=
  ((Submodule.quotEquivOfEq _ _ (ker_groupHomologyTrivialπOdd k A g hg i hi).symm).trans
    ((groupHomologyTrivialπOdd k A g hg i hi).quotKerEquivOfSurjective
      (groupHomologyTrivialπOdd_surjective k A g hg i hi))).symm

/-- The odd-degree identification sends the homology class of a representative `x` to the residue
class of `x` modulo `|G|`. -/
theorem groupHomologyTrivialLinearEquivOdd_groupHomologyπOdd (i : ℕ) (hi : Odd i)
    (x : LinearMap.ker (applyAsHom (Rep.trivial k G A) g - 𝟙 (Rep.trivial k G A)).hom.toLinearMap) :
    groupHomologyTrivialLinearEquivOdd k A g hg i hi
        (groupHomologyπOdd (Rep.trivial k G A) g hg i hi x) =
      Submodule.Quotient.mk (x : A) := by
  rw [← LinearEquiv.eq_symm_apply, groupHomologyTrivialLinearEquivOdd, LinearEquiv.symm_symm,
    LinearEquiv.trans_apply, Submodule.quotEquivOfEq_mk,
    LinearMap.quotKerEquivOfSurjective_apply_mk]
  -- `groupHomologyTrivialπOdd` is `groupHomologyπOdd` precomposed with the corestriction of the
  -- identity, so it sends `x` to `groupHomologyπOdd x`.
  rfl

/-- The even-degree representative map is injective for a trivial representation, since
`ρ(g) - 𝟙 = 0` has no nonzero image. -/
private theorem groupHomologyπEven_trivial_injective (i : ℕ) [NeZero i] (hi : Even i) :
    Function.Injective (groupHomologyπEven (Rep.trivial k G A) g hg i hi) := by
  refine (injective_iff_map_eq_zero (groupHomologyπEven (Rep.trivial k G A) g hg i hi).hom).2 ?_
  intro x hx
  rw [groupHomologyπEven_eq_zero_iff] at hx
  obtain ⟨y, hy⟩ := hx
  ext
  simpa [Rep.applyAsHom, sub_hom] using hy.symm

/-- **Even-degree homology of a finite cyclic group with trivial coefficients.** If `G` is a
finite group generated by `g` and `A` is a `k`-module with the trivial action, then for positive
even `i`, `Hᵢ(G, A)` is the `|G|`-torsion `A[|G|]` of `A`. It sends the class that
`Rep.FiniteCyclicGroup.groupHomologyπEven` assigns to an element of `A[|G|]` to that element. -/
def groupHomologyTrivialLinearEquivEven (i : ℕ) [NeZero i] (hi : Even i) :
    groupHomology (Rep.trivial k G A) i ≃ₗ[k] Submodule.torsionBy k A (Nat.card G : k) :=
  (LinearEquiv.ofBijective (groupHomologyπEven (Rep.trivial k G A) g hg i hi).hom
    ⟨groupHomologyπEven_trivial_injective k A g hg i hi,
      groupHomologyπEven_surjective (Rep.trivial k G A) g hg i hi⟩).symm.trans
    -- For the trivial representation the norm is multiplication by `|G|`.
    (LinearEquiv.ofEq _ _ (by
      ext x
      simp [Representation.norm, Submodule.mem_torsionBy_iff, Nat.card_eq_fintype_card,
        Nat.cast_smul_eq_nsmul]))

/-- The even-degree identification sends the homology class of a representative `x` to `x`. -/
theorem coe_groupHomologyTrivialLinearEquivEven_groupHomologyπEven (i : ℕ) [NeZero i]
    (hi : Even i) (x : LinearMap.ker (Rep.trivial k G A).ρ.norm) :
    (groupHomologyTrivialLinearEquivEven k A g hg i hi
        (groupHomologyπEven (Rep.trivial k G A) g hg i hi x) : A) = x := by
  rw [groupHomologyTrivialLinearEquivEven, LinearEquiv.trans_apply, LinearEquiv.coe_ofEq_apply]
  exact congrArg Subtype.val ((LinearEquiv.ofBijective _ _).symm_apply_apply x)

end Trivial

section IsCyclic

variable (k : Type u) {G : Type u} [CommRing k] [Group G] [Finite G] [IsCyclic G]
  (A : Type u) [AddCommGroup A] [Module k A]

/-- **The even-degree homology of a finite cyclic group vanishes when `A` has no `|G|`-torsion.**
If multiplication by `|G|` is injective on `A`, then `Hᵢ(G, A) = 0` for every positive even `i`. -/
theorem subsingleton_groupHomology_trivial_of_even (hA : IsSMulRegular A (Nat.card G : k))
    (i : ℕ) [NeZero i] (hi : Even i) : Subsingleton (groupHomology (Rep.trivial k G A) i) := by
  classical
  have := Fintype.ofFinite G
  let : CommGroup G := IsCyclic.commGroup
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := G)
  have : Subsingleton (Submodule.torsionBy k A (Nat.card G : k)) := by
    rw [(isSMulRegular_iff_torsionBy_eq_bot A _).1 hA]
    infer_instance
  exact (groupHomologyTrivialLinearEquivEven k A g hg i hi).toEquiv.subsingleton

/-- **The even-degree integral homology of a finite cyclic group vanishes**: `Hᵢ(G, ℤ) = 0` for
every positive even `i`. -/
theorem subsingleton_groupHomology_trivial_int_of_even {G : Type} [Group G] [Finite G]
    [IsCyclic G] (i : ℕ) [NeZero i] (hi : Even i) :
    Subsingleton (groupHomology (Rep.trivial ℤ G ℤ) i) :=
  subsingleton_groupHomology_trivial_of_even ℤ ℤ
    (IsSMulRegular.of_ne_zero (Nat.cast_ne_zero.2 Nat.card_pos.ne')) i hi

end IsCyclic

/-- **The odd-degree integral homology of a finite cyclic group**: if `G` is a finite group
generated by `g`, then `Hᵢ(G, ℤ) ≃ ZMod |G|` for every odd `i`. It sends the class that
`Rep.FiniteCyclicGroup.groupHomologyπOdd` assigns to `n ∈ ℤ` to the residue of `n`. -/
def groupHomologyTrivialIntLinearEquivOdd {G : Type} [CommGroup G] [Fintype G] [DecidableEq G]
    (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) (i : ℕ) (hi : Odd i) :
    groupHomology (Rep.trivial ℤ G ℤ) i ≃ₗ[ℤ] ZMod (Nat.card G) :=
  (groupHomologyTrivialLinearEquivOdd ℤ ℤ g hg i hi).trans <|
    -- `ℤ / |G| ℤ`, in the sense of `QuotSMulTop`, is `ZMod |G|`.
    (Submodule.quotEquivOfEq _ (Ideal.span {(Nat.card G : ℤ)}) (by
      ext x
      simp [Submodule.mem_smul_pointwise_iff_exists, Ideal.mem_span_singleton', mul_comm])).trans
    (Int.quotientSpanNatEquivZMod _).toIntLinearEquiv

/-- The odd-degree integral identification sends the homology class of a representative `n` to
the residue of `n` modulo `|G|`. -/
theorem groupHomologyTrivialIntLinearEquivOdd_groupHomologyπOdd {G : Type} [CommGroup G]
    [Fintype G] [DecidableEq G] (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) (i : ℕ) (hi : Odd i)
    (x : LinearMap.ker (applyAsHom (Rep.trivial ℤ G ℤ) g - 𝟙 (Rep.trivial ℤ G ℤ)).hom.toLinearMap) :
    groupHomologyTrivialIntLinearEquivOdd g hg i hi
        (groupHomologyπOdd (Rep.trivial ℤ G ℤ) g hg i hi x) = ((x : ℤ) : ZMod (Nat.card G)) := by
  rw [groupHomologyTrivialIntLinearEquivOdd, LinearEquiv.trans_apply,
    groupHomologyTrivialLinearEquivOdd_groupHomologyπOdd]
  -- Both remaining maps act on representatives: `x` goes to the class of `x` in `ℤ ⧸ (|G|)`, and
  -- then to its cast in `ZMod |G|`.
  rfl

end Rep.FiniteCyclicGroup
