module

public import TauCeti.GroupTheory.LocallyFinite
public import TauCeti.GroupTheory.OrderOfElement.Cauchy
public import TauCeti.RepresentationTheory.Homological.GroupHomology.DirectedUnion
public import TauCeti.RepresentationTheory.Homological.GroupHomology.Transfer.Basic

/-!
# Homology of locally finite groups

Let `G` be a locally finite group, in which every finitely generated subgroup is finite
(`TauCeti.Group.IsLocallyFinite`), and let `A` be a representation of `G` over a commutative ring
`k`. Then `G` is the directed union of the finite subgroups generated by its finite subsets, so
every class of `Hₙ(G, A)` is the image of a class of a finite subgroup `S`
(`groupHomology.exists_finite_subgroup_map_eq`). In positive degrees such a class is killed by the
order of `S`, so:

* positive-degree homology of a locally finite group is a torsion group
  (`groupHomology.isAddTorsion_groupHomology_succ`);
* positive-degree homology of a locally finite group vanishes when the order of every element of
  `G` is a unit of `k` (`groupHomology.subsingleton_of_forall_isUnit_orderOf`), since the order of
  each finite subgroup is then a unit of `k`.

Commutative torsion groups are locally finite, so these apply to every torsion abelian group. For
the Eilenberg--MacLane space `K(A, 1)` of a torsion abelian group `A`, whose singular homology is
the group homology of `A`, the first statement is Serre's axiom on the homology of `K(A, 1)` for
the class of torsion abelian groups.

## Main results

* `groupHomology.exists_finite_subgroup_map_eq`: every homology class of a locally finite group
  comes from a finite subgroup.
* `groupHomology.isAddTorsion_groupHomology_succ`: positive-degree homology of a locally finite
  group is torsion.
* `groupHomology.subsingleton_of_forall_isUnit_orderOf`: positive-degree homology of a locally
  finite group vanishes when the order of every element is a unit of the coefficients.

## References

* K. S. Brown, *Cohomology of Groups*, Graduate Texts in Mathematics 87, Springer, 1982,
  Chapter III, Section 10 (positive-degree homology of a finite group is killed by its order).
* J.-P. Serre, *Groupes d'homotopie et classes de groupes abéliens*, Ann. of Math. 58 (1953),
  258--294.
-/

public section

open CategoryTheory

universe u

namespace groupHomology

variable {k G : Type u} [CommRing k] [Group G] [TauCeti.Group.IsLocallyFinite G]

/-- **Homology classes of a locally finite group come from finite subgroups.** Every class of
`Hₙ(G, A)` is the image of a class of `Hₙ(S, A)`, for some finite subgroup `S` of `G`, under the
map induced by the inclusion of `S`. -/
theorem exists_finite_subgroup_map_eq {A : Rep k G} {n : ℕ} (x : groupHomology A n) :
    ∃ (S : Subgroup G) (_ : Finite S) (y : groupHomology (Rep.res S.subtype A) n),
      map S.subtype (𝟙 (Rep.res S.subtype A)) n y = x := by
  obtain ⟨s, y, hy⟩ := exists_map_subtype_eq (TauCeti.Group.directed_closure_finset G)
    (TauCeti.Group.iSup_closure_finset G) x
  exact ⟨_, inferInstance, y, hy⟩

/-- **Positive-degree homology of a locally finite group is torsion**: every class of `Hₙ₊₁(G, A)`
comes from a finite subgroup, whose order kills it. -/
theorem isAddTorsion_groupHomology_succ (A : Rep k G) (n : ℕ) :
    IsAddTorsion (groupHomology A (n + 1)) := fun x ↦ by
  obtain ⟨S, _, y, rfl⟩ := exists_finite_subgroup_map_eq x
  refine isOfFinAddOrder_iff_nsmul_eq_zero.2 ⟨Nat.card S, Nat.card_pos, ?_⟩
  rw [← map_nsmul, natCard_nsmul_eq_zero, map_zero]

/-- **Positive-degree homology of a locally finite group vanishes when the orders of its elements
are invertible**: if the order of every element of `G` is a unit of `k`, then `Hₙ₊₁(G, A) = 0`. -/
theorem subsingleton_of_forall_isUnit_orderOf (A : Rep k G) (h : ∀ g : G, IsUnit (orderOf g : k))
    (n : ℕ) : Subsingleton (groupHomology A (n + 1)) := by
  refine subsingleton_of_forall_eq 0 fun x ↦ ?_
  obtain ⟨S, _, y, rfl⟩ := exists_finite_subgroup_map_eq x
  have := subsingleton_of_isUnit_natCard (Rep.res S.subtype A)
    (TauCeti.isUnit_natCard_iff_forall_isUnit_orderOf.2 fun g ↦ Subgroup.orderOf_coe g ▸ h g) n
  rw [Subsingleton.elim y 0, map_zero]

end groupHomology
