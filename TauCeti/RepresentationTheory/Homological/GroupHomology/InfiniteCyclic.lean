module

public import Mathlib.RepresentationTheory.Homological.GroupHomology.LowDegree
public import TauCeti.CategoryTheory.Abelian.LeftDerived
public import TauCeti.RepresentationTheory.Homological.Augmentation.Basic
import TauCeti.Algebra.MonoidAlgebra.Eigenvector
import TauCeti.Algebra.MonoidAlgebra.Exactness
import TauCeti.RepresentationTheory.OfMulAction

/-!
# Group homology of an infinite cyclic group

Let `G` be a commutative group generated by an element `g` of infinite order, so that `G` is
infinite cyclic, and let `A` be a `k`-linear representation of `G`. The augmentation
`k[G] → k` and the endomorphism `ρ(g) - 𝟙` of the left regular representation form a short exact
sequence

`0 → k[G] --(ρ(g) - 𝟙)--> k[G] → k → 0`

(`Rep.InfiniteCyclicGroup.shortExact_shortComplex`). On `k[G]`, `ρ(g) - 𝟙` is multiplication by
`single g 1 - 1` (`Rep.InfiniteCyclicGroup.applyAsHom_sub_hom_apply`). Its range is the
augmentation ideal (`Rep.InfiniteCyclicGroup.range_applyAsHom_sub_eq_ker_augmentation`), which
the basis differences `single g 1 - 1` of a generating set generate
(`TauCeti.MonoidAlgebra.ker_augmentation_eq_span_of_closure_eq_top`), and it is injective
(`Rep.InfiniteCyclicGroup.injective_applyAsHom_sub`) because `single g 1 - 1` is regular when `g`
has infinite order (`TauCeti.isRegular_single_sub_one_of_not_isOfFinOrder`). So `k` has the
projective resolution `0 → k[G] → k[G]` of length one
(`CategoryTheory.ShortComplex.ShortExact.projectiveResolution`), and the group homology of `G` is

* `H₀(G, A) ≅ A / (ρ(g) - 𝟙) A`, the coinvariants
  (`TauCeti.groupHomology.H0IsoOfForallMemZpowers`), which holds for every cyclic group, finite or
  not, by `Representation.coinvariantsKer_eq_range_of_forall_mem_zpowers`;
* `H₁(G, A) ≅ ker (ρ(g) - 𝟙)`, the invariants (`Rep.InfiniteCyclicGroup.groupHomologyIso₁`);
* `Hₙ(G, A) = 0` for `n ≥ 2` (`Rep.InfiniteCyclicGroup.isZero_groupHomology_add_two`).

The degree-one computation uses the resolution for the generator `g⁻¹`: under the
identification `(A ⊗ k[G])_G ≅ A`, `⟦a ⊗ single h r⟧ ↦ r • ρ(h⁻¹) a`, the map induced by
`ρ(g⁻¹) - 𝟙` on `k[G]` is `ρ(g) - 𝟙` on `A`
(`Rep.InfiniteCyclicGroup.coinvariantsTensor_map_shortComplex_inv_f_comp`).

As motivation: topologically, `G` is the fundamental group of the circle, `k[G] → k[G]` is the
cellular chain complex of its universal cover `ℝ`, with one vertex and one edge in each fundamental
domain, and `A --(ρ(g) - 𝟙)--> A` is the cellular complex of the circle with coefficients in the
local system of monodromy `ρ(g)`. That cellular comparison is not formalised; what is formalised is
`TauCeti.circleTwistedHomologyIsoGroupHomology`, which identifies the twisted singular homology of
the circle with the group homology of `ℤ`. For the integral sign representation, on which `g` acts
by `-1`, the differential is `-2`, so `H₀ = ℤ / 2` and `H₁ = 0`.

## Main definitions

* `Rep.InfiniteCyclicGroup.shortComplex`: the short complex `k[G] → k[G] → k`.
* `Rep.InfiniteCyclicGroup.groupHomologyIso₁`: `H₁(G, A) ≅ ker (ρ(g) - 𝟙)`.

## Main results

* `Rep.InfiniteCyclicGroup.range_applyAsHom_sub_eq_ker_augmentation`: the range of `ρ(g) - 𝟙` on
  `k[G]` is the augmentation ideal.
* `Rep.InfiniteCyclicGroup.injective_applyAsHom_sub`: `ρ(g) - 𝟙` is injective on `k[G]`.
* `Rep.InfiniteCyclicGroup.shortExact_shortComplex`: the short complex is short exact.
* `Rep.InfiniteCyclicGroup.isZero_groupHomology_add_two`: `Hₙ(G, A) = 0` for `n ≥ 2`.

## References

The API and layout follow Mathlib's finite cyclic group homology
(`Mathlib.RepresentationTheory.Homological.FiniteCyclic` and
`Mathlib.RepresentationTheory.Homological.GroupHomology.FiniteCyclic`, by Amelia Livingston), in
particular `Rep.FiniteCyclicGroup.groupHomologyIso₀` and its resolution built from
`applyAsHom (leftRegular k G) g - 𝟙`.

* K. S. Brown, *Cohomology of Groups*, Graduate Texts in Mathematics 87, Springer, 1982,
  Chapter I, Section 4, Example 1 (the resolution of `ℤ` over the group ring of an infinite cyclic
  group) and Chapter III, Section 1 (homology of an infinite cyclic group).
-/

public section

noncomputable section

universe u

open CategoryTheory Limits

namespace Rep.InfiniteCyclicGroup

variable (k : Type u) {G : Type u} [CommRing k] [CommGroup G] {g : G}

/-- On `k[G]`, `ρ(g) - 𝟙` is left multiplication by `single g 1 - 1`. -/
theorem applyAsHom_sub_hom_apply (x : MonoidAlgebra k G) :
    (applyAsHom (leftRegular k G) g - 𝟙 _).hom x = (MonoidAlgebra.single g 1 - 1) * x := by
  rw [Rep.sub_hom, Representation.IntertwiningMap.coe_sub, Pi.sub_apply, Rep.applyAsHom_apply,
    sub_mul, one_mul, ← Representation.leftRegular_apply_eq_single_mul]
  simp

/-- **Translation by an element of infinite order has no fixed vectors in `k[G]`**: `ρ(g) - 𝟙` is
left multiplication by `single g 1 - 1`, which is regular when `g` has infinite order. -/
theorem injective_applyAsHom_sub (hg : ¬IsOfFinOrder g) :
    Function.Injective (applyAsHom (leftRegular k G) g - 𝟙 _).hom := fun x y hxy ↦
  (TauCeti.isRegular_single_sub_one_of_not_isOfFinOrder (R := k) hg).left <|
    (applyAsHom_sub_hom_apply k x).symm.trans (hxy.trans (applyAsHom_sub_hom_apply k y))

/-- **The augmentation ideal of a cyclic group** generated by `g` is the range of `ρ(g) - 𝟙` on
`k[G]`. -/
theorem range_applyAsHom_sub_eq_ker_augmentation (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    LinearMap.range (applyAsHom (leftRegular k G) g - 𝟙 _).hom.toLinearMap =
      LinearMap.ker (augmentation k G).hom.toLinearMap := by
  have hgen : Subgroup.closure {g} = ⊤ :=
    (Subgroup.zpowers_eq_closure g).symm.trans ((Subgroup.eq_top_iff' _).2 hg)
  ext x
  rw [LinearMap.mem_ker, Representation.IntertwiningMap.toLinearMap_apply,
    augmentation_hom_apply, ← RingHom.mem_ker,
    TauCeti.MonoidAlgebra.ker_augmentation_eq_span_of_closure_eq_top k hgen, Set.image_singleton,
    Ideal.mem_span_singleton']
  refine exists_congr fun y ↦ ?_
  rw [Representation.IntertwiningMap.toLinearMap_apply, applyAsHom_sub_hom_apply, mul_comm]

variable (g) in
/-- The short complex `k[G] --(ρ(g) - 𝟙)--> k[G] --ε--> k` of representations of `G`, with `ε` the
augmentation, which sends `single h r` to `r`. -/
abbrev shortComplex : ShortComplex (Rep k G) :=
  ShortComplex.mk (applyAsHom (leftRegular k G) g - 𝟙 _) (augmentation k G) <| by
    -- `ε` is `G`-equivariant into the trivial representation, so it kills `ρ(g) - 𝟙`.
    have h : (trivial k G k).applyAsHom g = 𝟙 _ :=
      Rep.hom_ext <| Representation.IntertwiningMap.ext <| LinearMap.ext fun x ↦
        (Rep.applyAsHom_apply g x).trans (Rep.trivial_ρ_apply g x)
    rw [Preadditive.sub_comp, Category.id_comp, applyAsHom_comm, h, Category.comp_id, sub_self]

/-- **The resolution of `k` over an infinite cyclic group.** If `g` generates `G` and has
infinite order, then `0 → k[G] --(ρ(g) - 𝟙)--> k[G] → k → 0` is short exact. -/
theorem shortExact_shortComplex (hg : ∀ x, x ∈ Subgroup.zpowers g) (hg' : ¬IsOfFinOrder g) :
    (shortComplex k g).ShortExact where
  exact := by
    apply (forget₂ _ (ModuleCat k)).reflects_exact_of_faithful
    rw [ShortComplex.moduleCat_exact_iff_range_eq_ker]
    exact range_applyAsHom_sub_eq_ker_augmentation k hg
  mono_f := (Rep.mono_iff_injective _).2 (injective_applyAsHom_sub k hg')
  epi_g := inferInstanceAs (Epi (augmentation k G))

instance : Projective (shortComplex k g).X₁ :=
  inferInstanceAs (Projective (leftRegular k G))

instance : Projective (shortComplex k g).X₂ :=
  inferInstanceAs (Projective (leftRegular k G))

variable {k} (A : Rep k G)

/-- **The homology of an infinite cyclic group vanishes in degrees at least `2`.** -/
theorem isZero_groupHomology_add_two (hg : ∀ x, x ∈ Subgroup.zpowers g) (hg' : ¬IsOfFinOrder g)
    (n : ℕ) : IsZero (groupHomology A (n + 2)) :=
  ((shortExact_shortComplex k hg hg').isZero_leftDerived_add_two
    ((coinvariantsTensor k G).obj A) n).of_iso (groupHomologyIsoTor A (n + 2))

/-- Under the identification `(A ⊗ k[G])_G ≅ A`, `⟦a ⊗ single h r⟧ ↦ r • ρ(h⁻¹) a`, the map
induced by `ρ(g⁻¹) - 𝟙` on `k[G]` is `ρ(g) - 𝟙` on `A`. -/
theorem coinvariantsTensor_map_shortComplex_inv_f_comp (g : G) :
    ((coinvariantsTensor k G).obj A).map (shortComplex k g⁻¹).f ≫
        (Representation.coinvariantsTprodLeftRegularLEquiv A.ρ).toModuleIso.hom =
      (Representation.coinvariantsTprodLeftRegularLEquiv A.ρ).toModuleIso.hom ≫
        ModuleCat.ofHom (A.ρ g - LinearMap.id) := by
  refine coinvariantsTensor_hom_ext (LinearMap.ext fun a ↦ MonoidAlgebra.lhom_ext' fun h ↦
    LinearMap.ext_ring ?_)
  have hf : (applyAsHom (leftRegular k G) g⁻¹ - 𝟙 _).hom (MonoidAlgebra.single h 1) =
      MonoidAlgebra.single (g⁻¹ * h) 1 - MonoidAlgebra.single h 1 := by
    rw [applyAsHom_sub_hom_apply, sub_mul, MonoidAlgebra.single_mul_single, one_mul, one_mul]
  -- The functor `(A ⊗ -)_G` acts on the class of `a ⊗ v` through `v`, by definition.
  have hmap : (((coinvariantsTensor k G).obj A).map
      (applyAsHom (leftRegular k G) g⁻¹ - 𝟙 _)).hom
        (coinvariantsTensorMk A (leftRegular k G) a (MonoidAlgebra.single h 1)) =
      coinvariantsTensorMk A (leftRegular k G) a
        ((applyAsHom (leftRegular k G) g⁻¹ - 𝟙 _).hom (MonoidAlgebra.single h 1)) := rfl
  simp only [LinearMap.comp_apply, LinearMap.compr₂_apply (coinvariantsTensorMk _ _),
    MonoidAlgebra.lsingle_apply, ModuleCat.hom_comp]
  have he : ∀ x : G, (Representation.coinvariantsTprodLeftRegularLEquiv A.ρ).toModuleIso.hom.hom
      (coinvariantsTensorMk A (leftRegular k G) a (MonoidAlgebra.single x 1)) = A.ρ x⁻¹ a :=
    fun x ↦ (Representation.ofCoinvariantsTprodLeftRegular_mk_tmul_single A.ρ a x 1).trans
      (one_smul k _)
  rw [hmap, hf, map_sub, map_sub, he, he]
  simp [mul_comm, map_mul]

/-- **The first homology of an infinite cyclic group** generated by `g` is the module of invariants
`ker (ρ(g) - 𝟙)`. -/
def groupHomologyIso₁ (hg : ∀ x, x ∈ Subgroup.zpowers g) (hg' : ¬IsOfFinOrder g) :
    groupHomology A 1 ≅ ModuleCat.of k (LinearMap.ker (A.ρ g - LinearMap.id)) :=
  groupHomologyIsoTor A 1 ≪≫
    (shortExact_shortComplex k (g := g⁻¹) (fun x ↦ by rw [Subgroup.zpowers_inv]; exact hg x)
      (isOfFinOrder_inv_iff.not.2 hg')).leftDerivedOneIsoKernel
        ((coinvariantsTensor k G).obj A) ≪≫
    kernel.mapIso _ (ModuleCat.ofHom (A.ρ g - LinearMap.id))
      (Representation.coinvariantsTprodLeftRegularLEquiv A.ρ).toModuleIso
      (Representation.coinvariantsTprodLeftRegularLEquiv A.ρ).toModuleIso
      (coinvariantsTensor_map_shortComplex_inv_f_comp A g) ≪≫
    ModuleCat.kernelIsoKer _

end Rep.InfiniteCyclicGroup
