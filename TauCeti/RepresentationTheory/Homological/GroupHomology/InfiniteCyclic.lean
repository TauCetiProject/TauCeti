module

public import Mathlib.RepresentationTheory.Homological.GroupHomology.LowDegree
public import TauCeti.CategoryTheory.Abelian.LeftDerived
public import TauCeti.RepresentationTheory.Coinvariants
public import TauCeti.RepresentationTheory.Homological.Augmentation.Basic
public import TauCeti.RepresentationTheory.Invariants

/-!
# Homology of an infinite cyclic group

Let `G` be an infinite cyclic group generated by `g`, for instance `Multiplicative ℤ` generated by
`ofAdd 1`, and let `k` be a commutative ring. Multiplication by `g - 1` on the group algebra `k[G]`
is injective, and its image is the kernel of the augmentation `k[G] → k`, so

`0 → k[G] --(g - 1)--> k[G] → k → 0`

is a projective resolution of the trivial representation `k` of length one
(`Rep.InfiniteCyclicGroup.resolution`). For a representation `A` of `G`, the group homology of
`A` is therefore the homology of the two-term complex `A --(ρ(g⁻¹) - 1)--> A`:

* `H₀(G, A) ≅ A / (ρ(g) - 1) A`, the coinvariants (`Rep.InfiniteCyclicGroup.groupHomologyZeroIso`,
  which holds for every cyclic group, finite or not);
* `H₁(G, A) ≅ A^G`, the invariants, which are the kernel of `ρ(g) - 1`
  (`Rep.InfiniteCyclicGroup.groupHomologyOneIso`);
* `Hₙ(G, A) = 0` for `n ≥ 2` (`Rep.InfiniteCyclicGroup.isZero_groupHomology_add_two`).

This is the algebraic form of the cellular complex of the circle, a vertex and an edge, with local
coefficients: the edge has boundary `ρ(g) - 1` applied to the coefficient at the vertex.

The finite cyclic case is Mathlib's `Rep.FiniteCyclicGroup.resolution`, a periodic resolution of
infinite length; for an infinite cyclic group the norm map is unavailable and the resolution stops.

## Main definitions

* `Rep.InfiniteCyclicGroup.presentation`: the short complex `k[G] --(g - 1)--> k[G] → k`.
* `Rep.InfiniteCyclicGroup.resolution`: the resulting projective resolution of `k`.
* `Rep.InfiniteCyclicGroup.groupHomologyZeroIso`: `H₀(G, A) ≅ A / (ρ(g) - 1) A`.
* `Rep.InfiniteCyclicGroup.groupHomologyOneIso`: `H₁(G, A) ≅ A^G`.

## Main results

* `Multiplicative.mem_zpowers_ofAdd_one_int`: `Multiplicative ℤ` is generated by `ofAdd 1`.
* `Rep.InfiniteCyclicGroup.shortExact_presentation`: the presentation is short exact.
* `Rep.InfiniteCyclicGroup.isZero_groupHomology_add_two`: `Hₙ(G, A) = 0` for `n ≥ 2`.

## References

* K. S. Brown, *Cohomology of Groups*, Graduate Texts in Mathematics 87, Springer, 1982,
  Chapter I, Section 6, Example 1 (the resolution of `ℤ` over `ℤ[ℤ]`), and Chapter III, Section 1.
-/

public section

noncomputable section

open CategoryTheory Limits Representation

namespace Rep.InfiniteCyclicGroup

universe u

section Zero

variable {k G : Type u} [CommRing k] [Group G] {g : G} (A : Rep k G)

/-- **The zeroth homology of a cyclic group**: if `g` generates `G`, then `H₀(G, A)` is the
quotient `A / (ρ(g) - 1) A`. The group need not be infinite; for finite `G` this is Mathlib's
`Rep.FiniteCyclicGroup.groupHomologyIso₀`. -/
def groupHomologyZeroIso (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    groupHomology A 0 ≅ ModuleCat.of k (A ⧸ LinearMap.range (A.ρ g - LinearMap.id)) :=
  groupHomology.H0Iso A ≪≫ (Submodule.quotEquivOfEq _ _
    (coinvariantsKer_eq_range_of_forall_mem_zpowers _ g hg)).toModuleIso

end Zero

variable (k : Type u) {G : Type u} [CommRing k] [CommGroup G] (g : G)

/-- The short complex `k[G] --(g - 1)--> k[G] → k` of representations of a commutative group `G`,
whose second map is the augmentation sending `x` to the sum of its coefficients. When `G` is
infinite cyclic generated by `g`, it is short exact (`shortExact_presentation`). -/
abbrev presentation : ShortComplex (Rep k G) :=
  ShortComplex.mk (applyAsHom (leftRegular k G) g - 𝟙 _) (augmentation k G) (by
      ext x
      simp [sub_hom, applyAsHom])

variable {g}

/-- Multiplication by `g - 1` on `k[G]` is injective when `G` is infinite and generated by `g`: an
element fixed by `g` has constant coefficients, and finite support forces them to vanish. -/
lemma mono_presentation_f [Infinite G] (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    Mono (presentation k g).f := by
  rw [Rep.mono_iff_injective, injective_iff_map_eq_zero]
  intro x hx
  have hx' : Representation.leftRegular k G g x = x := by
    simpa [sub_hom, applyAsHom, sub_eq_zero] using hx
  have hc := coeff_of_leftRegular_of_generator g hg x hx'
  ext γ
  by_contra hne
  rw [hc] at hne
  refine Set.infinite_univ (α := G) ((x.coeff.support.finite_toSet).subset fun γ _ ↦ ?_)
  simpa [hc γ] using hne

/-- The kernel of the augmentation `k[G] → k` is the image of multiplication by `g - 1` when `g`
generates `G`. -/
lemma exact_presentation (hg : ∀ x, x ∈ Subgroup.zpowers g) : (presentation k g).Exact := by
  apply (forget₂ _ (ModuleCat k)).reflects_exact_of_faithful
  rw [ShortComplex.moduleCat_exact_iff_ker_sub_range]
  rintro (x : MonoidAlgebra k G) hx
  replace hx : x.coeff.sum (fun _ r ↦ r) = 0 := by simpa using hx
  -- Pushing `x` forward along the constant map to `1` gives `δ₁` times its coefficient sum, zero.
  have h0 : MonoidAlgebra.mapDomainLinearMap k k (fun _ : G ↦ (1 : G)) x = 0 := by
    ext : 1
    simp [Finsupp.mapDomain, ← Finsupp.single_sum, hx]
  have hker : x ∈ Coinvariants.ker (Representation.leftRegular k G) := by
    simpa [h0] using sub_mapDomainLinearMap_mem_coinvariantsKer (k := k)
      (f := fun _ : G ↦ (1 : G)) (fun γ ↦ ⟨γ, by simp⟩) x
  rw [coinvariantsKer_eq_range_of_forall_mem_zpowers _ g hg] at hker
  obtain ⟨y, hy⟩ := hker
  exact ⟨y, by simpa [sub_hom, applyAsHom] using hy⟩

/-- **The resolution of an infinite cyclic group.** If `G` is infinite and generated by `g`, then
`0 → k[G] --(g - 1)--> k[G] → k → 0` is short exact. -/
lemma shortExact_presentation [Infinite G] (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (presentation k g).ShortExact where
  exact := exact_presentation k hg
  mono_f := mono_presentation_f k hg
  epi_g := augmentation_epi k G

/-- The projective resolution `0 → k[G] --(g - 1)--> k[G]` of the trivial representation `k` of an
infinite group `G` generated by `g`, with `k[G]` in degrees `0` and `1`. -/
abbrev resolution [Infinite G] (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    ProjectiveResolution (trivial k G k) :=
  (shortExact_presentation k hg).projectiveResolution

variable {k} (A : Rep k G)

/-- **The homology of an infinite cyclic group vanishes in degrees at least two.** -/
theorem isZero_groupHomology_add_two [Infinite G] (hg : ∀ x, x ∈ Subgroup.zpowers g) (n : ℕ) :
    IsZero (groupHomology A (n + 2)) := by
  classical
  exact ((shortExact_presentation k hg).isZero_leftDerived_add_two
    ((coinvariantsTensor k G).obj A) n).of_iso (groupHomologyIsoTor A (n + 2))

/-- Under the identification `(A ⊗ k[G])_G ≅ A`, `⟦a ⊗ h⟧ ↦ ρ(h⁻¹) a`, multiplication by `g - 1`
on `k[G]` becomes `ρ(g⁻¹) - 1` on `A`. -/
private lemma map_presentation_f_comp :
    ((coinvariantsTensor k G).obj A).map (presentation k g).f ≫
      (coinvariantsTprodLeftRegularLEquiv A.ρ).toModuleIso.hom =
    (coinvariantsTprodLeftRegularLEquiv A.ρ).toModuleIso.hom ≫
      ModuleCat.ofHom (A.ρ g⁻¹ - LinearMap.id) := by
  ext : 1
  refine LinearMap.ext fun a ↦ MonoidAlgebra.lhom_ext' fun h ↦ LinearMap.ext_ring ?_
  simp [sub_hom, applyAsHom, coinvariantsTensorMk, TensorProduct.tmul_sub, mul_comm g, mul_inv_rev,
    map_mul]

/-- **The first homology of an infinite cyclic group is the invariants**: if `G` is infinite and
generated by `g`, then `H₁(G, A) ≅ A^G`. It is computed from `resolution`: `H₁(G, A)` is the kernel
of `ρ(g⁻¹) - 1` on `A ≅ (A ⊗ k[G])_G`. -/
def groupHomologyOneIso [Infinite G] (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    groupHomology A 1 ≅ ModuleCat.of k A.ρ.invariants := by
  classical
  exact groupHomologyIsoTor A 1 ≪≫
    (shortExact_presentation k hg).leftDerivedOneIsoKernel ((coinvariantsTensor k G).obj A) ≪≫
    kernel.mapIso _ (ModuleCat.ofHom (A.ρ g⁻¹ - LinearMap.id))
      (coinvariantsTprodLeftRegularLEquiv A.ρ).toModuleIso
      (coinvariantsTprodLeftRegularLEquiv A.ρ).toModuleIso (map_presentation_f_comp A) ≪≫
    ModuleCat.kernelIsoKer _ ≪≫
    (LinearEquiv.ofEq _ _ (FiniteCyclicGroup.invariants_eq_ker_apply_sub A g⁻¹
      (by simpa using hg)).symm).toModuleIso

end Rep.InfiniteCyclicGroup

/-- `Multiplicative ℤ` is the infinite cyclic group generated by `ofAdd 1`. -/
theorem Multiplicative.mem_zpowers_ofAdd_one_int (x : Multiplicative ℤ) :
    x ∈ Subgroup.zpowers (Multiplicative.ofAdd 1) :=
  ⟨x.toAdd, by simp [← ofAdd_zsmul]⟩
