module

public import TauCeti.RepresentationTheory.Homological.GroupCohomology.FiniteCyclic

/-!
# Restriction of degree-two cyclic cohomology classes

Restriction from a cyclic group to the subgroup generated by the appropriate power of its
chosen generator preserves the fixed element representing a degree-two class in the periodic
resolution. This formula is used to compare relative Brauer invariants when the ground field
is enlarged. It follows the carry-cocycle description of
`Rep.FiniteCyclicGroup.groupCohomologyπEven_two_apply`.

## References

* J.-P. Serre, *Local Fields*, Chapter VIII, §4 and Chapter XIII, §3.
-/

public noncomputable section

universe u

open CategoryTheory groupCohomology Rep Rep.FiniteCyclicGroup

namespace TauCeti

variable {k G G' : Type u} [CommRing k] [CommGroup G] [Fintype G]
  [CommGroup G'] [Fintype G'] (A : Rep k G) (g : G)
  (hg : ∀ x, x ∈ Subgroup.zpowers g) {B : Rep k G'} (f : G →* G')

/-! ### Restriction between finite cyclic groups -/

/-- Restricting a degree-two periodicity class to the subgroup generated by `g' ^ d`
preserves its representing fixed element. Here `f` sends the generator `g` of the smaller
group to `g' ^ d`, and the larger group has `d` times as many elements. -/
theorem map_groupCohomologyπEven_two_of_pow {g' : G'}
    (hg' : ∀ x, x ∈ Subgroup.zpowers g') (d : ℕ) (hfg : f g = g' ^ d)
    (hd : Nat.card G' = d * Nat.card G) (φ : res f B ⟶ A)
    (y : LinearMap.ker (applyAsHom B g' - 𝟙 B).hom.toLinearMap)
    (z : LinearMap.ker (applyAsHom A g - 𝟙 A).hom.toLinearMap) (hz : z.1 = φ.hom y.1) :
    groupCohomology.map f φ 2 (groupCohomologyπEven B g' hg' 2 even_two y) =
      groupCohomologyπEven A g hg 2 even_two z := by
  classical
  have hn : orderOf g' = d * orderOf g := by
    simpa only [orderOf_eq_card_of_forall_mem_zpowers hg,
      orderOf_eq_card_of_forall_mem_zpowers hg'] using hd
  have hdpos : 0 < d := by
    have := orderOf_pos g'
    rw [hn] at this
    exact Nat.pos_of_mul_pos_right this
  rw [groupCohomologyπEven_two_apply, groupCohomologyπEven_two_apply,
    ← LinearMap.comp_apply (groupCohomology.map f φ 2).hom, ← ModuleCat.hom_comp, H2π_comp_map,
    ModuleCat.hom_comp, LinearMap.comp_apply]
  congr 1
  refine cocycles₂_ext fun x₁ x₂ ↦ ?_
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.1 (mem_zpowers_iff_mem_range_orderOf.1 (hg x₁))
  obtain ⟨j, hj, rfl⟩ := Finset.mem_image.1 (mem_zpowers_iff_mem_range_orderOf.1 (hg x₂))
  rw [Finset.mem_range] at hi hj
  rw [coe_mapCocycles₂, cochainsMap₂, ModuleCat.ofHom_apply, LinearMap.comp_apply,
    LinearMap.compLeft_apply, Function.comp_apply, LinearMap.funLeft_apply, Prod.map_apply,
    map_pow, map_pow, hfg, ← pow_mul, ← pow_mul,
    carryCocycle_apply_pow B g' hg' y (hn ▸ Nat.mul_lt_mul_of_pos_left hi hdpos)
      (hn ▸ Nat.mul_lt_mul_of_pos_left hj hdpos), carryCocycle_apply_pow A g hg z hi hj, hn,
    ← Nat.mul_add]
  simp only [mul_le_mul_iff_right₀ hdpos, hz]
  split_ifs <;> simp

end TauCeti
