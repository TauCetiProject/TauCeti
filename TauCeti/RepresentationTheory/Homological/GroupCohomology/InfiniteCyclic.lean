module

public import Mathlib.RepresentationTheory.Homological.GroupCohomology.Basic
public import TauCeti.RepresentationTheory.Homological.GroupHomology.InfiniteCyclic

/-!
# Group cohomology of an infinite cyclic group

Let `G` be a commutative group generated by an element `g` of infinite order, and let `A` be a
`k`-linear representation of `G`. The short exact sequence

`0 → k[G] --(ρ(g) - 𝟙)--> k[G] → k → 0`

of `Rep.InfiniteCyclicGroup.shortExact_shortComplex` is a projective resolution of `k` of length
one. Applying `Hom(-, A)` and identifying `Hom(k[G], A)` with `A` by evaluation at `1`
(`Rep.leftRegularHomEquiv`), under which precomposition with `ρ(g) - 𝟙` becomes `ρ(g) - 𝟙` on `A`
(`Rep.InfiniteCyclicGroup.leftRegularHomEquiv_comp_applyAsHom_sub`), the cohomology of `G` is
that of the complex `A --(ρ(g) - 𝟙)--> A`:

* `H⁰(G, A) ≅ ker (ρ(g) - 𝟙)`, the invariants
  (`TauCeti.groupCohomology.H0IsoOfForallMemZpowers`), which holds for every cyclic group;
* `H¹(G, A) ≅ A / (ρ(g) - 𝟙) A` (`Rep.InfiniteCyclicGroup.groupCohomologyIso₁`);
* `Hⁿ(G, A) = 0` for `n ≥ 2` (`Rep.InfiniteCyclicGroup.isZero_groupCohomology_add_two`).

This is dual to the group homology of `G` in
`TauCeti.RepresentationTheory.Homological.GroupHomology.InfiniteCyclic`, where invariants and
coinvariants appear in the opposite degrees. Topologically, `G` is the fundamental group of the
circle and these are its cohomology groups with local coefficients
(`TauCeti.circleTwistedCohomologyIsoGroupCohomology`).

## Main definitions

* `Rep.InfiniteCyclicGroup.groupCohomologyIso₁`: `H¹(G, A) ≅ A / (ρ(g) - 𝟙) A`.

## Main results

* `Rep.InfiniteCyclicGroup.isZero_groupCohomology_add_two`: `Hⁿ(G, A) = 0` for `n ≥ 2`.

## References

The layout follows Mathlib's finite cyclic group cohomology
(`Mathlib.RepresentationTheory.Homological.GroupCohomology.FiniteCyclic`, by Amelia Livingston),
which computes cohomology from `Rep.leftRegularHomEquiv` applied to a periodic resolution.

* K. S. Brown, *Cohomology of Groups*, Graduate Texts in Mathematics 87, Springer, 1982,
  Chapter I, Section 4, Example 1 (the resolution of `ℤ` over the group ring of an infinite cyclic
  group) and Chapter III, Section 1.
-/

public section

noncomputable section

universe u

open CategoryTheory Limits

namespace Rep.InfiniteCyclicGroup

variable {k G : Type u} [CommRing k] [CommGroup G] {g : G} (A : Rep k G)

/-- Under the identification `Hom(k[G], A) ≅ A` by evaluation at `1`, precomposition with
`ρ(g) - 𝟙` on `k[G]` is `ρ(g) - 𝟙` on `A`. -/
theorem leftRegularHomEquiv_comp_applyAsHom_sub (x : leftRegular k G ⟶ A) :
    leftRegularHomEquiv A ((applyAsHom (leftRegular k G) g - 𝟙 _) ≫ x) =
      (A.ρ g - LinearMap.id : A.V →ₗ[k] A.V) (leftRegularHomEquiv A x) := by
  simp [sub_hom, homEquiv, ← hom_comm_apply x, Rep.applyAsHom]

/-- The cochain complex of the resolution vanishes in degrees at least `2`, since `Hom(-, A)`
takes the zero terms of the resolution to zero modules. -/
private theorem isZero_linearYonedaObj_X_add_two (hg : ∀ x, x ∈ Subgroup.zpowers g)
    (hg' : ¬IsOfFinOrder g) (n : ℕ) :
    IsZero (((shortExact_shortComplex k hg hg').projectiveResolution.complex.linearYonedaObj
      k A).X (n + 2)) :=
  ((linearYoneda k (Rep k G)).obj A).map_isZero
    ((shortComplex k g).isZero_resolutionComplex_X_add_two n).op

/-- **The cohomology of an infinite cyclic group vanishes in degrees at least `2`.** -/
theorem isZero_groupCohomology_add_two (hg : ∀ x, x ∈ Subgroup.zpowers g) (hg' : ¬IsOfFinOrder g)
    (n : ℕ) : IsZero (groupCohomology A (n + 2)) := by
  refine IsZero.of_iso (ShortComplex.isZero_homology_of_isZero_X₂ _ ?_)
    (groupCohomologyIso A (n + 2) (shortExact_shortComplex k hg hg').projectiveResolution)
  exact isZero_linearYonedaObj_X_add_two A hg hg' n

/-- **The first cohomology of an infinite cyclic group** generated by `g` is
`A / (ρ(g) - 𝟙) A`. -/
def groupCohomologyIso₁ (hg : ∀ x, x ∈ Subgroup.zpowers g) (hg' : ¬IsOfFinOrder g) :
    groupCohomology A 1 ≅ ModuleCat.of k (A ⧸ LinearMap.range (A.ρ g - LinearMap.id)) := by
  -- The cochain complex `Hom(k[G], A) ⟶ Hom(k[G], A) ⟶ 0 ⟶ ⋯` of the resolution.
  let K := (shortExact_shortComplex k hg hg').projectiveResolution.complex.linearYonedaObj k A
  have h2 : IsZero (K.X 2) := isZero_linearYonedaObj_X_add_two A hg hg' 0
  refine groupCohomologyIso A 1 (shortExact_shortComplex k hg hg').projectiveResolution ≪≫
    K.isoHomologyι 1 2 (by simp) (h2.eq_of_tgt _ _) ≪≫
    ShortComplex.opcyclesMapIso (K.isoSc' 0 1 2 (by simp) (by simp)) ≪≫
    (K.sc' 0 1 2).moduleCatOpcyclesIso ≪≫
    (Submodule.Quotient.equiv _ _ (leftRegularHomEquiv A) ?_).toModuleIso
  -- The terms of `K` in degrees `0` and `1` are `leftRegular k G ⟶ A` by definition of the
  -- resolution, and `K.d 0 1` is precomposition with `ρ(g) - 𝟙`.
  have hf : (leftRegularHomEquiv A).toLinearMap ∘ₗ (K.d 0 1).hom =
      (A.ρ g - LinearMap.id) ∘ₗ (leftRegularHomEquiv A).toLinearMap := by
    ext x
    exact leftRegularHomEquiv_comp_applyAsHom_sub A x
  exact (LinearMap.range_comp (K.d 0 1).hom (leftRegularHomEquiv A).toLinearMap).symm.trans <|
    (congrArg LinearMap.range hf).trans
      (LinearMap.range_comp_of_range_eq_top _ (LinearEquiv.range _))

end Rep.InfiniteCyclicGroup
