/-!
# The norm of an extension of the augmentation ideal

For a finite abelian group `Q`, this file proves Artin and Tate's lemma on the norm of an
extension of the augmentation ideal `I_Q` (`Rep.norm_eq_zero_of_ker_le_coinvariantsKer`): if `B`
surjects onto `I_Q` with a finitely generated kernel contained in `I_Q B`, then the norm
`∑_{q ∈ Q} q` kills `B`. Applied to the splitting module of the extension `G ⧸ G''` of `G^{ab}`,
whose kernel `G' ⧸ G''` lies in `I_Q B` because it is generated by commutators, this is the
algebraic core of the theorem that the transfer of a finite group into its commutator subgroup is
trivial.

## Proof

View `B` as a module over `ℤ[Q]`. Choose a basis `σ` of `Q` whose orders multiply to `|Q|`, lifts
`x i ∈ B` of the generators `[σ i] - 1` of `I_Q`, and generators of the kernel. Together they span
`B`, and `ord(σ i) • x i` and the kernel generators lie in `I_Q B`. The determinant trick gives
`γ ≡ |Q| (mod I_Q)` killing `B`. As `γ` also kills `I_Q`, it is invariant under multiplication by
every `[q]`, so it is a constant multiple of the norm element, and its augmentation `|Q|` makes
that constant `1`.

## Main results

* `Rep.norm_eq_zero_of_ker_le_coinvariantsKer`: for a finite abelian group `Q`, the norm kills
  every extension of `I_Q` by a finitely generated submodule of `I_Q B`.

## References

* E. Artin and J. Tate, *Class Field Theory*, Chapter XIII (the splitting-module lemma).
* D. Ferrand, *La démonstration par Artin–Tate du théorème de l'idéal principal* (2011), §2.
-/

public section

namespace Rep

open MonoidAlgebra TauCeti.AugmentationIdeal

section Group

variable {Q : Type} [Group Q]

/-- An augmentation-ideal morphism intertwines the associated monoid-algebra action. -/
private theorem augmentationHom_apply_asModule_smul {B : Rep ℤ Q}
    (π : B ⟶ augmentationIdeal ℤ Q) (r : MonoidAlgebra ℤ Q) (v : B.ρ.asModule) :
    π.hom (B.ρ.asModuleEquiv (r • v)) =
      (augmentationIdeal ℤ Q).ρ.asAlgebraHom r (π.hom (B.ρ.asModuleEquiv v)) := by
  rw [Representation.asModuleEquiv_map_smul]
  exact π.hom.apply_asAlgebraHom r _

/-- Lifts `x i` of the generators `[σ i] - 1` of `I_Q`, together with generators of the kernel of
`π : B → I_Q`, span `B` as a `ℤ[Q]`-module. -/
private theorem span_range_sumElim_eq_top {B : Rep ℤ Q}
    (π : B ⟶ augmentationIdeal ℤ Q) {ι : Type} {σ : ι → Q}
    (hσ : Subgroup.closure (Set.range σ) = ⊤) {x : ι → B.ρ.asModule}
    (hx : ∀ i, π.hom (B.ρ.asModuleEquiv (x i)) = singleSub ℤ Q 1 (σ i))
    {s : Set B} (hs : Submodule.span ℤ s = LinearMap.ker π.hom.toLinearMap) :
    Submodule.span (MonoidAlgebra ℤ Q)
      (Set.range (Sum.elim x fun k : s ↦ B.ρ.asModuleEquiv.symm k.val)) = ⊤ := by
  -- `π` as a `ℤ[Q]`-linear map `f`, and the span `N` of the lifts and kernel generators.
  let f := Representation.IntertwiningMap.equivLinearMapAsModule _ _ π.hom
  set N := Submodule.span (MonoidAlgebra ℤ Q)
    (Set.range (Sum.elim x fun k : s ↦ B.ρ.asModuleEquiv.symm k.val))
  -- `f` maps `N` onto `I_Q`, since the image contains the generators `[σ i] - 1`.
  have hmap : N.map f = ⊤ := by
    rw [eq_top_iff, ← span_range_singleSub_eq_top ℤ Q hσ, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    exact ⟨x i, Submodule.subset_span ⟨Sum.inl i, rfl⟩, hx i⟩
  -- The kernel of `f` lies in `N`: it is spanned over `ℤ` by the kernel generators.
  have hker : LinearMap.ker f ≤ N := by
    -- Use the associated module's scalar instance for the linear-equivalence transport.
    let : Module ℤ B.ρ.asModule := B.ρ.instModuleAsModule
    intro v hv
    have hv' : B.ρ.asModuleEquiv v ∈ Submodule.span ℤ s := hs ▸ hv
    have hmem := Submodule.mem_map_of_mem (f := B.ρ.asModuleEquiv.symm.toLinearMap) hv'
    rw [Submodule.map_span] at hmem
    have hle : B.ρ.asModuleEquiv.symm '' s ⊆
        Set.range (Sum.elim x fun k : s ↦ B.ρ.asModuleEquiv.symm k.val) := by
      rintro _ ⟨y, hy, rfl⟩
      exact ⟨Sum.inr ⟨y, hy⟩, rfl⟩
    have hmem' := Submodule.span_le_restrictScalars ℤ (MonoidAlgebra ℤ Q) _ hmem
    simpa only [LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply] using
      Submodule.span_mono hle hmem'
  -- So `N ⊔ ker f = N` is everything.
  rwa [LinearMap.map_eq_top_iff (top_unique (hmap ▸ LinearMap.map_le_range)),
    sup_eq_left.2 hker] at hmap

/-- A lift `x` of the generator `[σ] - 1` of `I_Q`, weighted by the order of `σ`, lies in
`I • B` for the augmentation ideal `I` of `ℤ[Q]`, once the kernel of `π` lies in `I • B`. -/
private theorem orderOf_smul_mem_ker_augmentation_smul_top {B : Rep ℤ Q}
    (π : B ⟶ augmentationIdeal ℤ Q)
    (hkerI : ∀ v : B.ρ.asModule, π.hom (B.ρ.asModuleEquiv v) = 0 →
      v ∈ RingHom.ker (MonoidAlgebra.augmentation ℤ Q) •
        (⊤ : Submodule (MonoidAlgebra ℤ Q) B.ρ.asModule))
    (σ : Q) {x : B.ρ.asModule} (hx : π.hom (B.ρ.asModuleEquiv x) = singleSub ℤ Q 1 σ) :
    (orderOf σ : MonoidAlgebra ℤ Q) • x ∈ RingHom.ker (MonoidAlgebra.augmentation ℤ Q) •
      (⊤ : Submodule (MonoidAlgebra ℤ Q) B.ρ.asModule) := by
  classical
  -- `ord(σ) = (ord(σ) - μ) + μ` with `μ = ∑ₖ [σ ^ k]`, and `μ • x` lies in the kernel.
  let μ : MonoidAlgebra ℤ Q := ∑ j ∈ Finset.range (orderOf σ), single (σ ^ j) 1
  have hμ : π.hom (B.ρ.asModuleEquiv (μ • x)) = 0 := by
    rw [augmentationHom_apply_asModule_smul, hx]
    simp only [μ, map_sum, Representation.asAlgebraHom_single_one, LinearMap.sum_apply,
      ρ_singleSub, ← pow_succ]
    rw [Finset.sum_range_sub (fun j ↦ singleSub ℤ Q 1 (σ ^ j)), pow_orderOf_eq_one,
      pow_zero, sub_self]
  have hsplit : (orderOf σ : MonoidAlgebra ℤ Q) • x =
      ((orderOf σ : MonoidAlgebra ℤ Q) - μ) • x + μ • x := by
    rw [← add_smul, sub_add_cancel]
  rw [hsplit]
  refine Submodule.add_mem _ (Submodule.smul_mem_smul ?_ Submodule.mem_top) (hkerI _ hμ)
  simp [RingHom.mem_ker, μ]

/-- If `γ ∈ ℤ[Q]` kills `B` and `π : B → I_Q` is surjective, then `γ` kills `I_Q`, so `γ` is
invariant under multiplication by every `[q]`. -/
private theorem mul_single_one_eq_self_of_smul_eq_zero {B : Rep ℤ Q}
    (π : B ⟶ augmentationIdeal ℤ Q) (hπM : Function.Surjective (π.hom ∘ B.ρ.asModuleEquiv))
    {γ : MonoidAlgebra ℤ Q} (hγ : ∀ y : B.ρ.asModule, γ • y = 0) (q : Q) :
    γ * single q 1 = γ := by
  obtain ⟨y, hy⟩ := hπM (singleSub ℤ Q 1 q)
  simp only [Function.comp_apply] at hy
  have h0 := congrArg (augmentationι ℤ Q).hom
    (congrArg (fun v ↦ π.hom (B.ρ.asModuleEquiv v)) (hγ y))
  rw [augmentationHom_apply_asModule_smul, hy, map_zero, map_zero, map_zero,
    ι_asAlgebraHom_singleSub, mul_sub, sub_eq_zero] at h0
  rw [h0, ← one_def, mul_one]

/-- If `γ ∈ ℤ[Q]` kills `B`, is invariant under multiplication by every `[q]` and has
augmentation `|Q|`, then `γ` is the norm element and the norm vanishes on `B`. -/
private theorem norm_eq_zero_of_smul_eq_zero [Fintype Q] (B : Rep ℤ Q) {γ : MonoidAlgebra ℤ Q}
    (hγ : ∀ y : B.ρ.asModule, γ • y = 0) (hinv : ∀ q : Q, γ * single q 1 = γ)
    (hεγ : MonoidAlgebra.augmentation ℤ Q γ = Fintype.card Q) :
    B.ρ.norm = 0 := by
  -- `γ` is the norm element.
  have hγnorm := MonoidAlgebra.eq_sum_single_of_mul_single_eq_self
    (IsSMulRegular.of_ne_zero Fintype.card_ne_zero) hinv (hεγ.trans (nsmul_one _).symm)
  ext v
  have h := congrArg B.ρ.asModuleEquiv (hγ (B.ρ.asModuleEquiv.symm v))
  rw [Representation.asModuleEquiv_map_smul, hγnorm, Representation.asAlgebraHom_sum_single_one]
    at h
  simpa only [LinearEquiv.apply_symm_apply, map_zero, LinearMap.zero_apply] using h

end Group

variable {Q : Type} [CommGroup Q]

/-- **The norm kills an extension of the augmentation ideal by part of `I_Q B`** (Artin–Tate).
Let `Q` be a finite abelian group and `π : B → I_Q` a surjection of integral representations whose
kernel is finitely generated and contained in `I_Q B`, the span of the elements `q • b - b`. Then
the norm `∑_{q ∈ Q} q` vanishes on `B`. -/
theorem norm_eq_zero_of_ker_le_coinvariantsKer [Fintype Q] (B : Rep ℤ Q)
    (π : B ⟶ augmentationIdeal ℤ Q) (hπ : Function.Surjective π.hom)
    (hfg : (LinearMap.ker π.hom.toLinearMap).FG)
    (hker : LinearMap.ker π.hom.toLinearMap ≤ Representation.Coinvariants.ker B.ρ) :
    B.ρ.norm = 0 := by
  classical
  -- `B` is a module over the commutative ring `ℤ[Q]`, with augmentation ideal `I = ker ε`.
  let ε := MonoidAlgebra.augmentation ℤ Q
  have hkerI (v : B.ρ.asModule) (hv : π.hom (B.ρ.asModuleEquiv v) = 0) :
      v ∈ RingHom.ker ε • (⊤ : Submodule (MonoidAlgebra ℤ Q) B.ρ.asModule) := by
    simpa only [LinearEquiv.symm_apply_apply] using
      (B.ρ.mem_coinvariantsKer_iff_mem_ker_augmentation_smul_top).mp (hker hv)
  -- A basis `σ` of `Q`, lifts `x i` of the generators `[σ i] - 1` of `I_Q`, and generators `s` of
  -- the kernel span `B`; their weights are the orders of the `σ i`, and `1`.
  obtain ⟨ι, _, σ, hσ, hord⟩ := CommGroup.exists_closure_range_eq_top_and_prod_orderOf_eq_card Q
  obtain ⟨s, hs⟩ := hfg
  have hπM : Function.Surjective (π.hom ∘ B.ρ.asModuleEquiv) :=
    hπ.comp B.ρ.asModuleEquiv.surjective
  choose x hx using fun i ↦ hπM (singleSub ℤ Q 1 (σ i))
  simp only [Function.comp_apply] at hx
  let b : ι ⊕ s → B.ρ.asModule := Sum.elim x fun k ↦ B.ρ.asModuleEquiv.symm k.val
  let e : ι ⊕ s → MonoidAlgebra ℤ Q := Sum.elim (fun i ↦ (orderOf (σ i) : MonoidAlgebra ℤ Q)) 1
  have he (j : ι ⊕ s) :
      e j • b j ∈ RingHom.ker ε • (⊤ : Submodule (MonoidAlgebra ℤ Q) B.ρ.asModule) := by
    rcases j with i | k
    · exact orderOf_smul_mem_ker_augmentation_smul_top π hkerI (σ i) (hx i)
    · have hk : π.hom k.val = 0 :=
        LinearMap.mem_ker.mp (hs ▸ Submodule.subset_span k.property)
      simpa [e, b] using hkerI (B.ρ.asModuleEquiv.symm k.val) (by simpa using hk)
  -- The determinant trick gives `γ ≡ ∏ ord(σ i) = |Q|` modulo `I` killing `B`.
  obtain ⟨γ, hγI, hγ⟩ := Submodule.exists_sub_prod_mem_and_smul_eq_zero (RingHom.ker ε)
    (span_range_sumElim_eq_top π hσ hx hs) e he
  -- `γ` kills `I_Q` too, so it is invariant under multiplication by every `[q]`.
  have hinv := mul_single_one_eq_self_of_smul_eq_zero π hπM hγ
  -- Its augmentation is `|Q|`, so `γ` is the norm element.
  have hεγ : ε γ = Fintype.card Q := by
    rw [RingHom.mem_ker, map_sub, sub_eq_zero] at hγI
    rw [hγI, map_prod, Fintype.prod_sum_type]
    simp only [e, ε, Sum.elim_inl, Sum.elim_inr, Pi.one_apply, map_one, map_natCast,
      Finset.prod_const_one, mul_one]
    rw [← Nat.cast_prod, hord, Nat.card_eq_fintype_card]
  exact norm_eq_zero_of_smul_eq_zero B hγ hinv hεγ

end Rep
