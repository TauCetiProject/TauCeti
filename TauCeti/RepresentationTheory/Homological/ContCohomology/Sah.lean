/-!
# The scalar trick: restriction to a subgroup is injective on `H¹`

Let `G` be a topological group acting continuously on a topological abelian group `M`, and let
`z : G` act on `M` by a map commuting with the action of `G` and with `m ↦ z • m - m` bijective, for
instance by a scalar `r` of a coefficient ring with `r - 1` a unit. If `L` is a subgroup of `G`
modulo which `z` is central, in the sense that `g * z ∈ z * g * L` for every `g : G`, then
restriction `H¹(G, M) → H¹(L, M)` is injective. For `L = ⊥`, that is for `z` central in `G`, this is
Sah's lemma `H¹(G, M) = 0`.

The proof is the cocycle computation of
`TauCeti/RepresentationTheory/Homological/GroupCohomology/Sah.lean`: if the restriction of a
continuous cocycle `c` to `L` is the coboundary of `m`, then `c - d⁰ m` vanishes on `L`, in
particular at every `(z * g)⁻¹ * (g * z)`, so it is a coboundary
(`groupCohomology.IsCocycle₁.isCoboundary₁_of_bijective`), and hence so is `c`. Neither normality
nor openness of `L` is needed, and no inflation from `G ⧸ L` is used.

The motivating case is an absolute Galois group `G` of a CM field, an open subgroup `L` modulo
which an element `z` is central, and coefficients on which `z` acts by a scalar `[ϑ]` or
`[ϑ]⁻¹` of a group ring, with `[ϑ]^{±1} - 1` a unit; the theorems below are stated for an
arbitrary continuous module.

## Main statements

* `TauCeti.ContCohomology.explicitRes1_injective_of_bijective`: restriction to `L` is injective
  on explicit `H¹` when `z` is central modulo `L`, its action commutes with `G`, and
  `m ↦ z • m - m` is bijective.
* `TauCeti.ContCohomology.explicitRes1_injective_of_smul_eq`: the same when `z` acts by a scalar
  `r` with `r - 1` a unit.
* `TauCeti.ContCohomology.subsingleton_H1_of_commute`: Sah's lemma, `H¹(G, M) = 0` for central
  `z` with `m ↦ z • m - m` bijective.
* `TauCeti.ContinuousCohomology.res_injective_of_bijective` and `res_injective_of_smul_eq`: the
  same injectivity for Mathlib's canonical `continuousCohomology 1` of a discrete module, through
  `TauCeti.ContCohomology.explicitH1AddEquivContinuousCohomology_res`.

## Provenance

The cocycle argument is adapted from grh-lean (https://github.com/lsernau/grh-lean, Apache 2.0,
Copyright 2026 Anthropic, PBC), file `src/New/Congruences/Selmer/SelmerData.lean`, declarations
`New.Selmer.SelmerDatum.cocycle_commutator_γ` and
`New.Selmer.SelmerDatum.cocycle_eq_zero_of_sahGroup`, where classes of a matrix representation are
detected on the subgroup generated by the commutators with an element acting by a scalar.

## References

* C.-H. Sah, *Automorphisms of finite groups*, J. Algebra 10 (1968), 47–68.
* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, 2nd ed., (1.6.7): the
  inflation-restriction sequence, which is the usual route to the statement and is bypassed here.
-/

public section

namespace TauCeti.ContCohomology

open groupCohomology

variable {G : Type*} [Group G] [TopologicalSpace G]
  {M : Type*} [AddCommGroup M] [TopologicalSpace M] [IsTopologicalAddGroup M]
  [DistribMulAction G M] [ContinuousSMul G M]

/-- **The scalar trick.** Let `z : G` act on `M` by a map commuting with the action of `G`, with
`m ↦ z • m - m` bijective, and let `L` be a subgroup modulo which `z` is central:
`(z * g)⁻¹ * (g * z) ∈ L` for every `g`. Then restriction `H¹(G, M) → H¹(L, M)` is injective. -/
theorem explicitRes1_injective_of_bijective (L : Subgroup G) {z : G}
    (hzL : ∀ g, (z * g)⁻¹ * (g * z) ∈ L) (hz : ∀ (g : G) (m : M), z • g • m = g • z • m)
    (hbij : Function.Bijective fun m : M => z • m - m) :
    Function.Injective (explicitRes1 G M L) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  induction x using QuotientAddGroup.induction_on with
  | _ c =>
    rw [explicitRes1_mk, H1pi_eq_zero_iff, mem_B1_iff] at hx
    obtain ⟨m, hm⟩ := hx
    -- Subtract the coboundary of `m`: the corrected cocycle vanishes on `L`.
    set c' : Z1 G M := c - ⟨d0 G M m, B1_le_Z1 G M (d0_mem_B1 m)⟩ with hc'
    have hc'L (l : G) (hl : l ∈ L) : (c' : G → M) l = 0 := by
      have h := hm ⟨l, hl⟩
      rw [cocyclesMap1_apply] at h
      simp only [ContinuousMonoidHom.subgroupSubtype_apply, AddMonoidHom.id_apply] at h
      simp [hc', ← h, Subgroup.smul_def]
    obtain ⟨m', hm'⟩ := (mem_Z1_iff.1 c'.property).2.isCoboundary₁_of_bijective
      (fun g => hc'L _ (hzL g)) hz hbij
    rw [H1pi_eq_zero_iff, mem_B1_iff]
    refine ⟨m' + m, fun g => ?_⟩
    have h := hm' g
    simp only [hc', AddSubgroup.coe_sub, Pi.sub_apply, d0_apply] at h
    rw [smul_add, add_sub_add_comm, h, sub_add_cancel]

/-- **The scalar trick for a scalar.** If `z` acts on `M` by a scalar `r` of a ring acting
compatibly with `G`, with `r - 1` a unit, and `z` is central modulo `L`, then restriction
`H¹(G, M) → H¹(L, M)` is injective. -/
theorem explicitRes1_injective_of_smul_eq {R : Type*} [Ring R] [Module R M] [SMulCommClass G R M]
    (L : Subgroup G) {z : G} (hzL : ∀ g, (z * g)⁻¹ * (g * z) ∈ L) {r : R}
    (hzr : ∀ m : M, z • m = r • m) (hr : IsUnit (r - 1)) :
    Function.Injective (explicitRes1 G M L) :=
  explicitRes1_injective_of_bijective L hzL (smul_comm_of_smul_eq hzr)
    (bijective_smul_sub_of_smul_eq hzr hr)

/-- **Sah's lemma in degree one.** If `z` is central in `G` and `m ↦ z • m - m` is bijective, then
`H¹(G, M) = 0`. -/
theorem subsingleton_H1_of_commute {z : G} (hzG : ∀ g, Commute z g)
    (hbij : Function.Bijective fun m : M => z • m - m) :
    Subsingleton (H1 G M) := by
  refine subsingleton_of_forall_eq 0 fun x => ?_
  induction x using QuotientAddGroup.induction_on with
  | _ c =>
    rw [H1pi_eq_zero_iff, mem_B1_iff]
    exact (mem_Z1_iff.1 c.property).2.isCoboundary₁_of_commute hzG hbij

end TauCeti.ContCohomology

namespace TauCeti.ContinuousCohomology

open ContCohomology

universe u

variable {G M : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [AddCommGroup M] [TopologicalSpace M] [DiscreteTopology M]
  [DistribMulAction G M] [ContinuousSMul G M]

/-- **The scalar trick, canonical form.** For a discrete `G`-module `M`, an element `z` acting by
a map commuting with `G` with `m ↦ z • m - m` bijective, and a subgroup `L` modulo which `z` is
central, restriction `H¹(G, M) → H¹(L, M)` on Mathlib's canonical continuous cohomology is
injective. -/
theorem res_injective_of_bijective (L : Subgroup G) {z : G}
    (hzL : ∀ g, (z * g)⁻¹ * (g * z) ∈ L) (hz : ∀ (g : G) (m : M), z • g • m = g • z • m)
    (hbij : Function.Bijective fun m : M => z • m - m) :
    Function.Injective (res L (ofDiscreteModule ℤ G M) 1) := by
  intro a b hab
  obtain ⟨a, rfl⟩ := (explicitH1AddEquivContinuousCohomology G M).surjective a
  obtain ⟨b, rfl⟩ := (explicitH1AddEquivContinuousCohomology G M).surjective b
  rw [explicitH1AddEquivContinuousCohomology_res, explicitH1AddEquivContinuousCohomology_res]
    at hab
  exact congrArg _ (explicitRes1_injective_of_bijective L hzL hz hbij
    ((explicitH1AddEquivContinuousCohomology L M).injective hab))

/-- **The scalar trick for a scalar, canonical form.** For a discrete `G`-module `M` on which `z`
acts by a scalar `r` with `r - 1` a unit, and a subgroup `L` modulo which `z` is central,
restriction on Mathlib's canonical `H¹` is injective. -/
theorem res_injective_of_smul_eq {R : Type*} [Ring R] [Module R M] [SMulCommClass G R M]
    (L : Subgroup G) {z : G} (hzL : ∀ g, (z * g)⁻¹ * (g * z) ∈ L) {r : R}
    (hzr : ∀ m : M, z • m = r • m) (hr : IsUnit (r - 1)) :
    Function.Injective (res L (ofDiscreteModule ℤ G M) 1) :=
  res_injective_of_bijective L hzL (groupCohomology.smul_comm_of_smul_eq hzr)
    (groupCohomology.bijective_smul_sub_of_smul_eq hzr hr)

end TauCeti.ContinuousCohomology
