module

public import TauCeti.RepresentationTheory.Homological.ContCohomology.CohomologicalDimension.ClassModule.Basic
import TauCeti.Topology.Algebra.Group.TopologicalAbelianization.Lift
import TauCeti.Topology.Algebra.Group.Profinite.ProP.Extension
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# The cyclic-quotient kernel in the pro-p class module

Let `V` be an open normal subgroup of a profinite group `G`, with cyclic `p`-group quotient
generated by the class of `s`. An element of `V` with trivial image in `G^ab(p)` has image in
`V^ab(p)` of the form `(s • b) / b`. This identifies the kernel needed in the cyclic computation
of the first cohomology of the class module.

Use `exists_abelianizationProPMk_eq_smul_div_of_mk_eq_one` to obtain the witness `b`.
The converse, giving the full kernel characterization, is
`exists_abelianizationProPMk_eq_smul_div_iff_mk_eq_one`.

## References

* J. Neukirch, A. Schmidt and K. Wingberg, *Cohomology of Number Fields*, 2nd ed.,
  diagram (3.6.2) and the cyclic case in the proof of (3.6.4), (ii) ⇒ (iii).
-/

public section

namespace TauCeti

universe u

variable (p : ℕ) {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  (V : Subgroup G) [V.Normal]

private noncomputable def cyclicDifference (s : G) :
    abelianizationProP p G V →* abelianizationProP p G V :=
  MulDistribMulAction.toMonoidHom _ (s : G ⧸ V) / MonoidHom.id _

private theorem cyclicDifference_apply (s : G) (a : abelianizationProP p G V) :
    cyclicDifference p V s a = (s : G ⧸ V) • a / a :=
  (rfl)

private theorem cyclicDifference_smul (s : G)
    (hs : ∀ q : G ⧸ V, q ∈ Subgroup.zpowers (s : G ⧸ V))
    (q : G ⧸ V) (a : abelianizationProP p G V) :
    cyclicDifference p V s (q • a) = q • cyclicDifference p V s a := by
  have : IsCyclic (G ⧸ V) := ⟨⟨_, hs⟩⟩
  simp only [cyclicDifference_apply, smul_div', smul_smul]
  rw [IsMulCommutative.is_comm.comm (s : G ⧸ V) q]

private theorem cyclicDifference_quotient_smul (s : G)
    (hs : ∀ q : G ⧸ V, q ∈ Subgroup.zpowers (s : G ⧸ V))
    (q : G ⧸ V) (a : abelianizationProP p G V) :
    QuotientGroup.mk' (cyclicDifference p V s).range (q • a) =
      QuotientGroup.mk' (cyclicDifference p V s).range a := by
  let D := (cyclicDifference p V s).range
  let : MulAction.QuotientAction (G ⧸ V) D :=
    { inv_mul_mem := fun q x y h => by
        obtain ⟨b, hb⟩ := h
        refine ⟨q • b, ?_⟩
        rw [cyclicDifference_smul p V s hs, hb, smul_mul', smul_inv'] }
  have hfixed : (s : G ⧸ V) • (a : abelianizationProP p G V ⧸ D) = a := by
    rw [MulAction.Quotient.smul_mk, QuotientGroup.eq]
    have hmem : cyclicDifference p V s a ∈ D := ⟨a, rfl⟩
    -- In a commutative group, the left quotient relation is the inverse of our difference.
    simpa [cyclicDifference_apply, div_eq_mul_inv, mul_comm] using
      D.inv_mem hmem
  exact (MulAction.Quotient.smul_mk _ q a).symm.trans
    (smul_eq_self_of_mem_zpowers (hs q) hfixed)

private noncomputable def cyclicCoinvariantMap (s : G) :
    V →* abelianizationProP p G V ⧸ (cyclicDifference p V s).range :=
  (QuotientGroup.mk' (cyclicDifference p V s).range).comp (abelianizationProPMk p G V)

private noncomputable def cyclicKernel (s : G) : Subgroup G :=
  (cyclicCoinvariantMap p V s).ker.map V.subtype

private theorem cyclicCoinvariantMap_conj (s : G)
    (hs : ∀ q : G ⧸ V, q ∈ Subgroup.zpowers (s : G ⧸ V)) (g : G) (v : V) :
    cyclicCoinvariantMap p V s (MulAut.conjNormal g v) = cyclicCoinvariantMap p V s v := by
  simp only [cyclicCoinvariantMap, MonoidHom.comp_apply, ← abelianizationProPMk_conj]
  exact cyclicDifference_quotient_smul p V s hs _ _

private theorem cyclicKernel_normal (s : G)
    (hs : ∀ q : G ⧸ V, q ∈ Subgroup.zpowers (s : G ⧸ V)) : (cyclicKernel p V s).Normal :=
  ⟨fun x hx g => by
    obtain ⟨w, hw, rfl⟩ := hx
    exact ⟨MulAut.conjNormal g w, MonoidHom.mem_ker.mpr
      ((cyclicCoinvariantMap_conj p V s hs g w).trans (MonoidHom.mem_ker.mp hw)), rfl⟩⟩

private theorem cyclicDifference_isClosed_range [CompactSpace V] (s : G) :
    IsClosed ((cyclicDifference p V s).range : Set (abelianizationProP p G V)) :=
  (isCompact_range ((continuous_const_smul (s : G ⧸ V)).div'
    (continuous_id : Continuous (id : abelianizationProP p G V → _)))).isClosed

variable [CompactSpace G]

private theorem cyclicKernel_isClosed (hV : IsOpen (V : Set G)) (s : G) :
    IsClosed (cyclicKernel p V s : Set G) := by
  have : CompactSpace V := isCompact_iff_compactSpace.mp (V.isClosed_of_isOpen hV).isCompact
  let D := (cyclicDifference p V s).range
  have hD : IsClosed (D : Set (abelianizationProP p G V)) := cyclicDifference_isClosed_range p V s
  let : IsClosed (D : Set (abelianizationProP p G V)) := hD
  have hβ : Continuous (cyclicCoinvariantMap p V s) :=
    QuotientGroup.continuous_mk.comp (continuous_abelianizationProPMk p G V)
  rw [cyclicKernel, Subgroup.coe_map]
  exact (V.isClosed_of_isOpen hV).isClosedMap_subtype_val _ (isClosed_singleton.preimage hβ)

omit [CompactSpace G] in
private theorem cyclicKernel_quotient_commutative (s : G)
    (hs : ∀ q : G ⧸ V, q ∈ Subgroup.zpowers (s : G ⧸ V))
    [hK : (cyclicKernel p V s).Normal] : IsMulCommutative (G ⧸ cyclicKernel p V s) := by
  let K := cyclicKernel p V s
  let f : G ⧸ K →* G ⧸ V := QuotientGroup.map K V (MonoidHom.id G) (Subgroup.map_subtype_le _)
  have hcentral : f.ker ≤ Subgroup.center (G ⧸ K) := by
    rintro x hx
    obtain ⟨w, rfl⟩ := QuotientGroup.mk_surjective x
    have hw : w ∈ V := (QuotientGroup.eq_one_iff w).mp hx
    rw [Subgroup.mem_center_iff]
    intro y
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective y
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
    let z : V := ⟨(g * w)⁻¹ * (w * g), by
      simpa only [mul_inv_rev, mul_assoc] using V.mul_mem
        (V.inv_mem hw) (‹V.Normal›.conj_mem' w hw g)⟩
    refine ⟨z, MonoidHom.mem_ker.mpr ?_, rfl⟩
    -- The two factors have inverse images under the conjugation-invariant coinvariant map.
    have hz : z = ⟨w, hw⟩⁻¹ * MulAut.conjNormal g⁻¹ ⟨w, hw⟩ :=
      Subtype.ext (by simp [z, mul_assoc])
    rw [hz, map_mul, cyclicCoinvariantMap_conj p V s hs, map_inv, inv_mul_cancel]
  have : IsCyclic (G ⧸ V) := ⟨⟨_, hs⟩⟩
  exact f.isMulCommutative_of_isCyclic_of_ker_le_center hcentral

private theorem cyclicKernel_quotient_isProP (hV : IsOpen (V : Set G))
    (hpV : IsPGroup p (G ⧸ V)) (s : G) [(cyclicKernel p V s).Normal] :
    IsProP p (G ⧸ cyclicKernel p V s) := by
  have : CompactSpace V := isCompact_iff_compactSpace.mp (V.isClosed_of_isOpen hV).isCompact
  let : IsClosed (V : Set G) := V.isClosed_of_isOpen hV
  let A := abelianizationProP p G V
  let D := (cyclicDifference p V s).range
  have hD : IsClosed (D : Set A) := cyclicDifference_isClosed_range p V s
  let : IsClosed (D : Set A) := hD
  let β := cyclicCoinvariantMap p V s
  have hβ : Continuous β := QuotientGroup.continuous_mk.comp (continuous_abelianizationProPMk p G V)
  have hβsurj : Function.Surjective β :=
    (QuotientGroup.mk'_surjective D).comp (abelianizationProPMk_surjective p G V)
  let K := cyclicKernel p V s
  let f : G ⧸ K →* G ⧸ V := QuotientGroup.map K V (MonoidHom.id G) (Subgroup.map_subtype_le _)
  have hf : Continuous f := (QuotientGroup.isQuotientMap_mk K).continuous_iff.mpr
    QuotientGroup.continuous_mk
  have hfs : Function.Surjective f := QuotientGroup.map_surjective_of_surjective K V
    (MonoidHom.id G) (QuotientGroup.mk'_surjective V) (Subgroup.map_subtype_le _)
  -- The kernel of `f` is a continuous image of `V^ab(p) / (s - 1)`.
  let ψ : V →* f.ker := ((QuotientGroup.mk' K).comp V.subtype).codRestrict f.ker
    fun w => (QuotientGroup.eq_one_iff (N := V) _).mpr w.2
  have hψker : β.ker ≤ ψ.ker := fun w hw =>
    Subtype.ext ((QuotientGroup.eq_one_iff _).mpr ⟨w, hw, rfl⟩)
  let φ : V ⧸ β.ker →* f.ker := QuotientGroup.lift β.ker ψ hψker
  have hφ : Continuous φ := (QuotientGroup.isQuotientMap_mk β.ker).continuous_iff.mpr
    ((QuotientGroup.continuous_mk.comp continuous_subtype_val).subtype_mk _)
  have hφs : Function.Surjective φ := by
    rintro ⟨x, hx⟩
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
    exact ⟨QuotientGroup.mk ⟨g, (QuotientGroup.eq_one_iff g).mp hx⟩, rfl⟩
  let e : V ⧸ β.ker ≃* A ⧸ D := QuotientGroup.quotientKerEquivOfSurjective β hβsurj
  -- The first isomorphism theorem computes on classes as `β`; compactness makes its inverse
  -- continuous. This also identifies the quotient topology, not just the abstract group.
  have he : Continuous e := (QuotientGroup.isQuotientMap_mk β.ker).continuous_iff.mpr hβ
  have hec : Continuous e.symm :=
    (e.toEquiv.toHomeomorphOfContinuousClosed he he.isClosedMap).symm.continuous
  have hproKer : IsProP p f.ker :=
    (isProP_maximalProPQuotient (p := p) (G := TopologicalAbelianization V)).quotient D
      |>.of_surjective (φ.comp e.symm.toMonoidHom) (hφ.comp hec) (hφs.comp e.symm.surjective)
  exact hpV.isProP.of_ker_isProP hf hfs hproKer

variable [TotallyDisconnectedSpace G]

/-- **The cyclic-quotient kernel calculation for the pro-`p` class module.** If `G ⧸ V` is a
cyclic `p`-group generated by the class of `s`, an element of `V` killed in `G^ab(p)` has class
`(s • b) / b` in `V^ab(p)`. No cohomological-dimension hypothesis is needed. -/
theorem exists_abelianizationProPMk_eq_smul_div_of_mk_eq_one
    (hV : IsOpen (V : Set G)) (hpV : IsPGroup p (G ⧸ V)) (s : G)
    (hs : ∀ q : G ⧸ V, q ∈ Subgroup.zpowers (s : G ⧸ V)) (v : V)
    (hv : maximalProPQuotient.mk p (TopologicalAbelianization G)
      (v.val : TopologicalAbelianization G) = 1) :
    ∃ b : abelianizationProP p G V, abelianizationProPMk p G V v = (s : G ⧸ V) • b / b := by
  let K := cyclicKernel p V s
  have : K.Normal := cyclicKernel_normal p V s hs
  let : IsClosed (K : Set G) := cyclicKernel_isClosed p V hV s
  let : CommGroup (G ⧸ K) :=
    { mul_comm := (cyclicKernel_quotient_commutative p V s hs).is_comm.comm }
  have hpro := cyclicKernel_quotient_isProP p V hV hpV s
  let π : G →ₜ* G ⧸ K := ⟨QuotientGroup.mk' K, QuotientGroup.continuous_mk⟩
  let πab := TopologicalAbelianization.lift π
  have hkill := congrArg (maximalProPQuotient.lift hpro πab.toMonoidHom πab.continuous) hv
  rw [maximalProPQuotient.mk_apply, maximalProPQuotient.lift_mk, map_one] at hkill
  have hπ : π v.val = 1 := (TopologicalAbelianization.lift_mk π v.val).symm.trans hkill
  have hvK : v.val ∈ K := (QuotientGroup.eq_one_iff _).mp hπ
  obtain ⟨w, hw, hwv⟩ := hvK
  have hwv' : w = v := Subtype.ext hwv
  have hwβ : cyclicCoinvariantMap p V s v = 1 := MonoidHom.mem_ker.mp (hwv' ▸ hw)
  rw [cyclicCoinvariantMap, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
    QuotientGroup.eq_one_iff] at hwβ
  obtain ⟨b, hb⟩ := hwβ
  exact ⟨b, hb.symm⟩

/-- **The kernel characterization for a cyclic `p`-group quotient.** An element of `V` dies
in `G^ab(p)` exactly when its class in `V^ab(p)` is a difference `(s • b) / b`, where the class
of `s` generates `G ⧸ V`. -/
theorem exists_abelianizationProPMk_eq_smul_div_iff_mk_eq_one
    (hV : IsOpen (V : Set G)) (hpV : IsPGroup p (G ⧸ V)) (s : G)
    (hs : ∀ q : G ⧸ V, q ∈ Subgroup.zpowers (s : G ⧸ V)) (v : V) :
    (∃ b : abelianizationProP p G V, abelianizationProPMk p G V v = (s : G ⧸ V) • b / b) ↔
      maximalProPQuotient.mk p (TopologicalAbelianization G)
        (v.val : TopologicalAbelianization G) = 1 := by
  symm
  refine ⟨exists_abelianizationProPMk_eq_smul_div_of_mk_eq_one p V hV hpV s hs v, ?_⟩
  rintro ⟨b, hb⟩
  obtain ⟨w, rfl⟩ := abelianizationProPMk_surjective p G V b
  let ι := TopologicalAbelianization.map V.subtype continuous_subtype_val
  let F := maximalProPQuotient.map (p := p) ι
    (TopologicalAbelianization.continuous_map V.subtype continuous_subtype_val)
  have hF (x : V) : F (abelianizationProPMk p G V x) =
      maximalProPQuotient.mk p (TopologicalAbelianization G)
        (x.val : TopologicalAbelianization G) := by
    rw [abelianizationProPMk_apply, maximalProPQuotient.mk_apply,
      maximalProPQuotient.map_mk]
    exact congrArg (maximalProPQuotient.mk p (TopologicalAbelianization G))
      (TopologicalAbelianization.map_mk V.subtype continuous_subtype_val x)
  have h := congrArg F hb
  rw [abelianizationProPMk_conj, map_div, hF, hF, hF] at h
  -- Conjugation vanishes in the ambient commutative quotient.
  let f := (maximalProPQuotient.mk p (TopologicalAbelianization G)).comp
    (QuotientGroup.mk' (commutator G).topologicalClosure)
  have hconj : f (MulAut.conjNormal s w).val = f w.val := by
    simp [MulAut.conjNormal_apply]
  exact h.trans ((congrArg (· / f w.val) hconj).trans (div_self' _))

end TauCeti
