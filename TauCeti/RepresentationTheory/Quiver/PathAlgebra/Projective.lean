module

public import TauCeti.RepresentationTheory.GrothendieckGroup.ProjectiveBasis
public import TauCeti.RepresentationTheory.Quiver.PathAlgebra.Basic
import TauCeti.Algebra.Category.GradedModuleCat.CartanMap.Idempotent.Projective
import TauCeti.RepresentationTheory.Quiver.Acyclic.PathAlgebra
import TauCeti.RepresentationTheory.Quiver.PathAlgebra.Grading
import TauCeti.RepresentationTheory.Quiver.PrimitiveIdempotent
import TauCeti.RingTheory.Idempotents.Projective

/-!
# The vertex projectives of a path algebra

Let `Q` be a quiver with finitely many vertices and `k` a field. The left ideals `kQ eᵢ` generated
by the vertex idempotents are finitely generated projective `kQ`-modules. They are indecomposable
and pairwise nonisomorphic, and when `kQ` is finite-dimensional they exhaust the indecomposable
finitely generated projective `kQ`-modules. All three facts are read off from the vertex
idempotents: they are primitive, of degree zero for the path-length grading, and form a complete
family of orthogonal idempotents.

## Main definitions

* `TauCeti.PathAlgebra.vertexProjective`: the vertex projective `kQ eᵢ` as a finitely generated
  projective module.

## Main results

* `TauCeti.PathAlgebra.isIndecomposableModule_vertexProjective`: `kQ eᵢ` is indecomposable.
* `TauCeti.PathAlgebra.pairwise_isEmpty_linearEquiv_vertexProjective`: vertex projectives at
  distinct vertices are nonisomorphic.
* `TauCeti.PathAlgebra.isExhaustiveIndecomposableProjectiveFamily_vertexProjective`: the vertex
  projectives exhaust the indecomposable finitely generated projective modules.

## References

* I. Assem, D. Simson and A. Skowroński, *Elements of the Representation Theory of Associative
  Algebras I*, Chapter III, Section 3.
-/

public section

noncomputable section

namespace TauCeti.PathAlgebra

open CategoryTheory

universe u v

variable (k : Type (max u v)) (Q : Type u) [Field k] [Quiver.{v} Q] [Finite Q]

/-- **The vertex projective `kQ eᵢ`**, the left ideal generated by the vertex idempotent, as a
finitely generated projective module. Its graded counterpart is `gradedVertexProjective`. -/
def vertexProjective (i : Q) : (finiteProjectiveModules (pathAlgebra k Q)).FullSubcategory :=
  ⟨ModuleCat.of _ (Ideal.span {(vertexIdempotent k i : pathAlgebra k Q)}),
    finiteProjectiveModules_iff.2
      ⟨inferInstance, IsIdempotentElem.projective_span_singleton (vertexIdempotent_mul_self i)⟩⟩

/-- The underlying module of the vertex projective is the left ideal generated by `eᵢ`. -/
@[simp]
theorem vertexProjective_obj (i : Q) :
    (vertexProjective k Q i).obj =
      ModuleCat.of _ (Ideal.span {(vertexIdempotent k i : pathAlgebra k Q)}) :=
  (rfl)

/-- The vertex projective `kQ eᵢ` is indecomposable. -/
theorem isIndecomposableModule_vertexProjective (i : Q) :
    IsIndecomposableModule (pathAlgebra k Q) (vertexProjective k Q i).obj :=
  isIndecomposableModule_span_singleton_vertexIdempotent isPrimitiveIdempotent_one i

/-- Vertex projectives at distinct vertices are nonisomorphic. -/
theorem pairwise_isEmpty_linearEquiv_vertexProjective :
    Pairwise fun i j : Q ↦ IsEmpty
      ((vertexProjective k Q i).obj ≃ₗ[pathAlgebra k Q] (vertexProjective k Q j).obj) := by
  intro i j hij
  let _ := integerGradedAlgebra k Q
  let _ := Fintype.ofFinite Q
  exact isEmpty_linearEquiv_span_singleton_of_gradeZero_le_span
    (vertexIdempotent_mem_integerGrade_zero k Q)
    (completeOrthogonalIdempotents_vertexIdempotent k Q).toOrthogonalIdempotents
    (fun _ ↦ integerGrade_eq_bot_of_neg k Q)
    (integerGrade_zero_eq_span_range_vertexIdempotent k Q).le hij (vertexIdempotent_ne_zero i)

variable [FiniteDimensional k (pathAlgebra k Q)]

/-- **The vertex projectives exhaust the indecomposable finitely generated projective modules**
of a finite-dimensional path algebra. -/
theorem isExhaustiveIndecomposableProjectiveFamily_vertexProjective :
    IsExhaustiveIndecomposableProjectiveFamily (vertexProjective k Q) :=
  let _ := Fintype.ofFinite Q
  isExhaustiveIndecomposableProjectiveFamily_span_singleton
    (completeOrthogonalIdempotents_vertexIdempotent k Q)
    fun i ↦ isPrimitiveIdempotent_vertexIdempotent isPrimitiveIdempotent_one i

end TauCeti.PathAlgebra
