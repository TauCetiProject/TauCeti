/-!
# The standard bimodule resolution of a path algebra

Let `A = kQ` be the path algebra of a quiver `Q` with finitely many vertices over a commutative
ring `k`, and let `Aᵉ = A ⊗[k] Aᵐᵒᵖ` be its enveloping algebra, so that an `A`-bimodule is a left
`Aᵉ`-module, `x ⊗ y` acting by `m ↦ x m y`. Write `eᵥ` for the vertex idempotents. The
**standard resolution** of `A` as a bimodule is the short exact sequence of `A`-bimodules

```text
0 ⟶ ⨁_{b : i ⟶ j} A eⱼ ⊗_k eᵢ A ⟶ ⨁_v A eᵥ ⊗_k eᵥ A ⟶ A ⟶ 0,
x ⊗ y ↦ x b ⊗ y - x ⊗ b y   (in the components `i` and `j`),
x ⊗ y ↦ x y.
```

Both terms on the left are projective bimodules, so this is a projective resolution of `A` of
length one, and `A` has projective dimension at most one as a bimodule; through it the Hochschild
cohomology of a path algebra is computed by a two-term complex. The middle term is the tensor
product `A ⊗_{kQ₀} A` over the vertex subalgebra `kQ₀ ≅ ∏ᵥ k`, and the left one is
`A ⊗_{kQ₀} kQ₁ ⊗_{kQ₀} A` for the bimodule `kQ₁` spanned by the arrows. A path algebra is the
tensor algebra of `kQ₁` over `kQ₀`, and the sequence is the standard resolution of a tensor
algebra; it underlies the small resolution of a semifree differential graded path algebra, such as
a Ginzburg algebra.

Following `TauCeti.zigzagBraidBimodule`, the bimodule `A eⱼ ⊗_k eᵢ A` is realized as the cyclic
left ideal of `Aᵉ` generated by the idempotent `eⱼ ⊗ eᵢ`, and `A ⊗_{kQ₀} A` as the cyclic left
ideal generated by the idempotent `∑ᵥ eᵥ ⊗ eᵥ`, the internal direct sum of the `A eᵥ ⊗_k eᵥ A`.
Both maps are then right multiplications in `Aᵉ` followed by the action on `1 ∈ A`, and they are
automatically maps of bimodules.

Exactness is proved with a contracting homotopy of `k`-modules. For a path `q` from `s` to `t`
and `x ∈ A`, the element `x eₜ ⊗ q` of the middle term is sent to
`∑ x q'' ⊗ q'` in the left term, the sum running over the factorizations `q = q'' b q'` with the
arrow `b` in the component `b`; the boundary of this sum telescopes to `x q ⊗ eₛ - x eₜ ⊗ q`. The
same homotopy composed with the left map is minus the identity.

## Main definitions

* `TauCeti.PathAlgebra.vertexTensorIdempotent`: the idempotent `∑ᵥ eᵥ ⊗ eᵥ` of `Aᵉ`.
* `TauCeti.PathAlgebra.vertexTensorBimodule`: the bimodule `A ⊗_{kQ₀} A`, the left ideal of `Aᵉ`
  generated by `∑ᵥ eᵥ ⊗ eᵥ`.
* `TauCeti.PathAlgebra.arrowTensorBimodule`: the bimodule `⨁_{b : i ⟶ j} A eⱼ ⊗_k eᵢ A`.
* `TauCeti.PathAlgebra.vertexTensorMul`: the multiplication map `A ⊗_{kQ₀} A → A`.
* `TauCeti.PathAlgebra.arrowTensorDifferential`: the map `x ⊗ y ↦ x b ⊗ y - x ⊗ b y`.

## Main results

* `TauCeti.PathAlgebra.arrowTensorDifferential_injective`,
  `TauCeti.PathAlgebra.exact_arrowTensorDifferential_vertexTensorMul` and
  `TauCeti.PathAlgebra.vertexTensorMul_surjective`: **the standard sequence of a path algebra is
  a short exact sequence of bimodules**.
* The instances `Module.Projective Aᵉ (vertexTensorBimodule k Q)` and
  `Module.Projective Aᵉ (arrowTensorBimodule k Q)`: both terms are projective bimodules.

## References

* D. Happel, *Hochschild cohomology of finite-dimensional algebras*, Séminaire d'Algèbre Paul
  Dubreil et Marie-Paul Malliavin, Lecture Notes in Mathematics 1404 (1989), 108--126, Section 1,
  for the standard bimodule resolution of a path algebra.
* W. Crawley-Boevey, *Lectures on representations of quivers*, Section 1, for the standard
  resolution of a quiver representation, which is this sequence tensored with the module.
-/

public section

namespace TauCeti

namespace PathAlgebra

open MulOpposite
open scoped TensorProduct DirectSum

universe u v w

variable (k : Type w) [CommRing k] (Q : Type u) [Quiver.{v} Q]

/-- The path algebra, in this file. -/
local notation "𝒜" => pathAlgebra k Q

/-- The enveloping algebra of the path algebra, in this file. -/
local notation "𝒜ᵉ" => pathAlgebra k Q ⊗[k] (pathAlgebra k Q)ᵐᵒᵖ

/-- The vertex idempotent `eᵥ`, in this file. -/
local notation "ε" => vertexIdempotent k

section

variable [Finite Q]

/-! ### The arrow idempotents -/

/-- The idempotent of the bimodule `kQ eⱼ ⊗_k eᵢ kQ` attached to an arrow `b : i ⟶ j`: the pure
tensor `eⱼ ⊗ eᵢ` in the enveloping algebra. -/
noncomputable def arrowTensorIdempotent (b : Σ i j : Q, i ⟶ j) : 𝒜ᵉ :=
  ε b.2.1 ⊗ₜ[k] op (ε b.1)

omit [Finite Q] in
/-- The arrow idempotent attached to `b : i ⟶ j` is the pure tensor `eⱼ ⊗ eᵢ`. -/
theorem arrowTensorIdempotent_def (b : Σ i j : Q, i ⟶ j) :
    arrowTensorIdempotent k Q b = ε b.2.1 ⊗ₜ[k] op (ε b.1) := (rfl)

/-- The element `b ⊗ eᵢ - eⱼ ⊗ b` of the enveloping algebra attached to an arrow `b : i ⟶ j`;
right multiplication by it is the component at `b` of the differential of the standard
resolution. -/
noncomputable def arrowTensorBoundary (b : Σ i j : Q, i ⟶ j) : 𝒜ᵉ :=
  ofArrow b.2.2 ⊗ₜ[k] op (ε b.1) - ε b.2.1 ⊗ₜ[k] op (ofArrow b.2.2)

/-- The boundary element attached to `b : i ⟶ j` is `b ⊗ eᵢ - eⱼ ⊗ b`. -/
theorem arrowTensorBoundary_def (b : Σ i j : Q, i ⟶ j) :
    arrowTensorBoundary k Q b = ofArrow b.2.2 ⊗ₜ[k] op (ε b.1) - ε b.2.1 ⊗ₜ[k] op (ofArrow b.2.2) :=
  (rfl)

/-- The pure tensor `eⱼ ⊗ eᵢ` attached to an arrow is idempotent. -/
theorem isIdempotentElem_arrowTensorIdempotent (b : Σ i j : Q, i ⟶ j) :
    IsIdempotentElem (arrowTensorIdempotent k Q b) :=
  IsIdempotentElem.tmul (k := k) (vertexIdempotent_mul_self _) (by
    rw [IsIdempotentElem, ← op_mul, vertexIdempotent_mul_self])

variable {k Q}

/-- The element `b ⊗ eᵢ - eⱼ ⊗ b` lies in `eⱼ ⊗ eᵢ (kQ ⊗ kQᵐᵒᵖ)`. -/
theorem arrowTensorIdempotent_mul_arrowTensorBoundary (b : Σ i j : Q, i ⟶ j) :
    arrowTensorIdempotent k Q b * arrowTensorBoundary k Q b = arrowTensorBoundary k Q b := by
  obtain ⟨i, j, b⟩ := b
  simp only [arrowTensorIdempotent, arrowTensorBoundary, mul_sub,
    Algebra.TensorProduct.tmul_mul_tmul, ← op_mul, ofArrow_eq_ofPath, vertexIdempotent_mul_self,
    vertexIdempotent_mul_ofPath, ofPath_mul_vertexIdempotent]

/-! ### The left term of the resolution -/

variable (k Q)

/-- **The bimodule `⨁_{b : i ⟶ j} kQ eⱼ ⊗_k eᵢ kQ`**, the left term of the standard resolution:
the direct sum, over the arrows, of the cyclic left ideals of the enveloping algebra generated by
the idempotents `eⱼ ⊗ eᵢ`. -/
abbrev arrowTensorBimodule : Type _ :=
  ⨁ b : Σ i j : Q, i ⟶ j, (Ideal.span {arrowTensorIdempotent k Q b} : Ideal 𝒜ᵉ)

variable {k Q}

/-- The pure tensor `x eⱼ ⊗ eᵢ y` lies in `kQ eⱼ ⊗_k eᵢ kQ`, for an arrow `b : i ⟶ j`. -/
theorem tmul_mem_span_arrowTensorIdempotent (b : Σ i j : Q, i ⟶ j) (x y : 𝒜) :
    (x * ε b.2.1) ⊗ₜ[k] op (ε b.1 * y) ∈
      (Ideal.span {arrowTensorIdempotent k Q b} : Ideal 𝒜ᵉ) := by
  rw [mem_span_singleton_iff_mul_eq_self (isIdempotentElem_arrowTensorIdempotent k Q b)]
  simp [arrowTensorIdempotent_def, ← op_mul, mul_assoc,
    IsIdempotentElem.mul_self_mul (x := ε b.1) (vertexIdempotent_mul_self _)]

-- Instance search does not find the componentwise additive groups of the ideals of the tensor
-- product algebra under the binder over arrows, so the group structure is supplied directly.
noncomputable instance : AddCommGroup (arrowTensorBimodule k Q) :=
  @DirectSum.instAddCommGroup _ _ fun _ ↦ Submodule.addCommGroup _

instance : Module.Projective 𝒜ᵉ (arrowTensorBimodule k Q) :=
  haveI := fun b ↦ (isIdempotentElem_arrowTensorIdempotent k Q b).projective_span_singleton
  inferInstance

/-- The element `b ⊗ eᵢ - eⱼ ⊗ b` kills `1 ∈ kQ`, both terms acting by `b`. -/
@[simp]
theorem arrowTensorBoundary_smul_one (b : Σ i j : Q, i ⟶ j) :
    arrowTensorBoundary k Q b • Bimodule.of (AlgHom.id k 𝒜) 1 = 0 := by
  obtain ⟨i, j, b⟩ := b
  simp [arrowTensorBoundary, sub_smul, Bimodule.smul_of]

/-! ### Building blocks of the contracting homotopy -/

section Homotopy

variable [DecidableEq Q] [∀ i j : Q, DecidableEq (i ⟶ j)]

/-- Projection of the enveloping algebra onto the component of an arrow `b` of
`⨁_b kQ eⱼ ⊗_k eᵢ kQ`: right multiplication by `eⱼ ⊗ eᵢ`. -/
private noncomputable def arrowTensorProj (b : Σ i j : Q, i ⟶ j) :
    𝒜ᵉ →ₗ[𝒜ᵉ] arrowTensorBimodule k Q :=
  DirectSum.lof 𝒜ᵉ _ _ b ∘ₗ
    LinearMap.toSpanSingleton 𝒜ᵉ _ (spanSingletonGenerator (arrowTensorIdempotent k Q b))

private theorem arrowTensorProj_apply (b : Σ i j : Q, i ⟶ j) (w : 𝒜ᵉ) :
    arrowTensorProj b w = DirectSum.lof 𝒜ᵉ _ _ b ⟨w * arrowTensorIdempotent k Q b,
      Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)⟩ := by
  rw [arrowTensorProj, LinearMap.comp_apply, LinearMap.toSpanSingleton_apply]
  congr 1
  exact Subtype.ext (by rw [SetLike.val_smul, coe_spanSingletonGenerator, smul_eq_mul])

private theorem arrowTensorProj_mul_arrowTensorIdempotent (b : Σ i j : Q, i ⟶ j) (w : 𝒜ᵉ) :
    arrowTensorProj b (w * arrowTensorIdempotent k Q b) = arrowTensorProj b w := by
  rw [arrowTensorProj_apply, arrowTensorProj_apply]
  congr 2
  rw [mul_assoc, (isIdempotentElem_arrowTensorIdempotent k Q b).eq]

/-- The projection onto the component of an arrow `b : i ⟶ j` only sees `x eⱼ ⊗ eᵢ y`. -/
private theorem arrowTensorProj_tmul (b : Σ i j : Q, i ⟶ j) (x y : 𝒜) :
    arrowTensorProj b (x ⊗ₜ[k] op y) = arrowTensorProj b ((x * ε b.2.1) ⊗ₜ[k] op (ε b.1 * y)) := by
  rw [← arrowTensorProj_mul_arrowTensorIdempotent, arrowTensorIdempotent,
    Algebra.TensorProduct.tmul_mul_tmul, ← op_mul]

/-- The homotopy on the elements `x ⊗ q` of the enveloping algebra, for a path `q`: the sum, over
the factorizations `q = q'' c q'` with `c` an arrow, of `x q'' ⊗ q'` in the component of `c`. It is
defined by recursion on the last arrow of `q`. -/
private noncomputable def homotopyPath :
    {s t : Q} → Quiver.Path s t → 𝒜 →ₗ[k] arrowTensorBimodule k Q
  | _, _, .nil => 0
  | _, _, .cons q c => homotopyPath q ∘ₗ LinearMap.mulRight k (ofArrow c) +
      (arrowTensorProj (k := k) ⟨_, _, c⟩).restrictScalars k ∘ₗ
        (TensorProduct.mk k 𝒜 𝒜ᵐᵒᵖ).flip (op (ofPath ⟨_, _, q⟩))

private theorem homotopyPath_nil (s : Q) :
    homotopyPath (k := k) (Quiver.Path.nil : Quiver.Path s s) = 0 := by
  rw [homotopyPath]

private theorem homotopyPath_cons {s t t' : Q} (q : Quiver.Path s t) (c : t ⟶ t') (x : 𝒜) :
    homotopyPath (q.cons c) x =
      homotopyPath q (x * ofArrow c) +
        arrowTensorProj ⟨_, _, c⟩ (x ⊗ₜ[k] op (ofPath ⟨_, _, q⟩)) := by
  simp [homotopyPath]

/-- The contracting homotopy, from the enveloping algebra to `⨁_b kQ eⱼ ⊗_k eᵢ kQ`: the `k`-linear
map sending `x ⊗ q`, for a path `q`, to `homotopyPath q x`. -/
private noncomputable def homotopy : 𝒜ᵉ →ₗ[k] arrowTensorBimodule k Q :=
  TensorProduct.lift (liftLinear k (fun q : Quiver.TotalPath Q ↦ homotopyPath q.2.2) ∘ₗ
    (opLinearEquiv k).symm.toLinearMap).flip

private theorem homotopy_tmul {s t : Q} (x : 𝒜) (q : Quiver.Path s t) :
    homotopy (x ⊗ₜ[k] op (ofPath ⟨s, t, q⟩)) = homotopyPath q x := by
  simp [homotopy]

end Homotopy

end

/-! ### The vertex idempotent -/

variable [Fintype Q]

/-- **The idempotent `∑ᵥ eᵥ ⊗ eᵥ`** of the enveloping algebra `kQ ⊗[k] kQᵐᵒᵖ`. Its left ideal is
the bimodule `kQ ⊗_{kQ₀} kQ`. -/
noncomputable def vertexTensorIdempotent : 𝒜ᵉ :=
  ∑ v : Q, ε v ⊗ₜ[k] op (ε v)

/-- The vertex idempotent of the enveloping algebra is the sum `∑ᵥ eᵥ ⊗ eᵥ`. -/
theorem vertexTensorIdempotent_def :
    vertexTensorIdempotent k Q = ∑ v : Q, ε v ⊗ₜ[k] op (ε v) := (rfl)

variable {k Q}

/-- Right multiplication by `∑ᵥ eᵥ ⊗ eᵥ` on a pure tensor whose left factor ends in `eᵥ`. -/
theorem tmul_mul_vertexTensorIdempotent_of_mul_vertexIdempotent {v : Q} {x : 𝒜} (hx : x * ε v = x)
    (y : 𝒜) :
    (x ⊗ₜ[k] op y) * vertexTensorIdempotent k Q = x ⊗ₜ[k] op (ε v * y) := by
  rw [vertexTensorIdempotent, Finset.mul_sum, Finset.sum_eq_single v]
  · rw [Algebra.TensorProduct.tmul_mul_tmul, hx, ← op_mul]
  · intro w _ hw
    rw [Algebra.TensorProduct.tmul_mul_tmul, ← hx, mul_assoc,
      vertexIdempotent_mul_vertexIdempotent_of_ne (Ne.symm hw), mul_zero, TensorProduct.zero_tmul]
  · simp

/-- Right multiplication by `∑ᵥ eᵥ ⊗ eᵥ` on a pure tensor whose right factor begins in `eᵥ`. -/
theorem tmul_mul_vertexTensorIdempotent_of_vertexIdempotent_mul {v : Q} (x : 𝒜) {y : 𝒜}
    (hy : ε v * y = y) :
    (x ⊗ₜ[k] op y) * vertexTensorIdempotent k Q = (x * ε v) ⊗ₜ[k] op y := by
  rw [vertexTensorIdempotent, Finset.mul_sum, Finset.sum_eq_single v]
  · rw [Algebra.TensorProduct.tmul_mul_tmul, ← op_mul, hy]
  · intro w _ hw
    rw [Algebra.TensorProduct.tmul_mul_tmul, ← op_mul, ← hy, ← mul_assoc,
      vertexIdempotent_mul_vertexIdempotent_of_ne hw, zero_mul, op_zero, TensorProduct.tmul_zero]
  · simp

variable (k Q)

/-- The element `∑ᵥ eᵥ ⊗ eᵥ` is idempotent, the `eᵥ ⊗ eᵥ` being orthogonal idempotents. -/
theorem isIdempotentElem_vertexTensorIdempotent :
    IsIdempotentElem (vertexTensorIdempotent k Q) := by
  rw [IsIdempotentElem]
  nth_rw 1 [vertexTensorIdempotent]
  rw [Finset.sum_mul]
  conv_rhs => rw [vertexTensorIdempotent]
  refine Finset.sum_congr rfl fun v _ ↦ ?_
  rw [tmul_mul_vertexTensorIdempotent_of_mul_vertexIdempotent (vertexIdempotent_mul_self v),
    vertexIdempotent_mul_self]

variable {k Q}

/-- The element `b ⊗ eᵢ - eⱼ ⊗ b` lies in the left ideal generated by `∑ᵥ eᵥ ⊗ eᵥ`. -/
theorem arrowTensorBoundary_mul_vertexTensorIdempotent (b : Σ i j : Q, i ⟶ j) :
    arrowTensorBoundary k Q b * vertexTensorIdempotent k Q = arrowTensorBoundary k Q b := by
  obtain ⟨i, j, b⟩ := b
  rw [arrowTensorBoundary, sub_mul,
    tmul_mul_vertexTensorIdempotent_of_mul_vertexIdempotent (v := i) (by
      rw [ofArrow_eq_ofPath, ofPath_mul_vertexIdempotent]),
    tmul_mul_vertexTensorIdempotent_of_mul_vertexIdempotent (vertexIdempotent_mul_self j),
    vertexIdempotent_mul_self, ofArrow_eq_ofPath, vertexIdempotent_mul_ofPath]

/-! ### The middle term of the resolution -/

variable (k Q)

/-- **The bimodule `kQ ⊗_{kQ₀} kQ`**, the middle term of the standard resolution: the cyclic left
ideal of the enveloping algebra generated by the idempotent `∑ᵥ eᵥ ⊗ eᵥ`. Its elements are the sums
of the `x eᵥ ⊗ eᵥ y`. -/
noncomputable def vertexTensorBimodule : Ideal 𝒜ᵉ :=
  Ideal.span {vertexTensorIdempotent k Q}

variable {k Q}

/-- An element lies in `kQ ⊗_{kQ₀} kQ` exactly when it is fixed by right multiplication by
`∑ᵥ eᵥ ⊗ eᵥ`. -/
theorem mem_vertexTensorBimodule_iff {u : 𝒜ᵉ} :
    u ∈ vertexTensorBimodule k Q ↔ u * vertexTensorIdempotent k Q = u :=
  mem_span_singleton_iff_mul_eq_self (isIdempotentElem_vertexTensorIdempotent k Q)

/-- The pure tensor `x eᵥ ⊗ eᵥ y` lies in `kQ ⊗_{kQ₀} kQ`. -/
theorem tmul_mem_vertexTensorBimodule (v : Q) (x y : 𝒜) :
    (x * ε v) ⊗ₜ[k] op (ε v * y) ∈ vertexTensorBimodule k Q := by
  rw [mem_vertexTensorBimodule_iff,
    tmul_mul_vertexTensorIdempotent_of_mul_vertexIdempotent
      (by rw [mul_assoc, vertexIdempotent_mul_self]),
    ← mul_assoc, vertexIdempotent_mul_self]

instance : Module.Projective 𝒜ᵉ (vertexTensorBimodule k Q) :=
  (isIdempotentElem_vertexTensorIdempotent k Q).projective_span_singleton

/-! ### The multiplication map -/

variable (k Q)

/-- **The multiplication map `kQ ⊗_{kQ₀} kQ → kQ`**, `x eᵥ ⊗ eᵥ y ↦ x eᵥ y`: the restriction of the
action of the enveloping algebra on `1`. -/
noncomputable def vertexTensorMul :
    vertexTensorBimodule k Q →ₗ[𝒜ᵉ] Bimodule (AlgHom.id k 𝒜) :=
  LinearMap.toSpanSingleton 𝒜ᵉ _ (Bimodule.of (AlgHom.id k 𝒜) 1) ∘ₗ
    (vertexTensorBimodule k Q).subtype

variable {k Q}

/-- The multiplication map acts on `kQ ⊗_{kQ₀} kQ` as the enveloping algebra acts on `1`. -/
theorem vertexTensorMul_apply (u : vertexTensorBimodule k Q) :
    vertexTensorMul k Q u = (u : 𝒜ᵉ) • Bimodule.of (AlgHom.id k 𝒜) 1 := (rfl)

/-- **The multiplication map is multiplication**: `x eᵥ ⊗ eᵥ y ↦ x eᵥ y`. -/
theorem vertexTensorMul_tmul (v : Q) (x y : 𝒜) :
    vertexTensorMul k Q ⟨_, tmul_mem_vertexTensorBimodule v x y⟩ =
      Bimodule.of (AlgHom.id k 𝒜) (x * ε v * y) := by
  simp [vertexTensorMul_apply, mul_assoc,
    IsIdempotentElem.mul_self_mul (x := ε v) (vertexIdempotent_mul_self v)]

/-- **The multiplication map is surjective**: `x ⊗ 1` cut down by `∑ᵥ eᵥ ⊗ eᵥ` maps to `x`. -/
theorem vertexTensorMul_surjective : Function.Surjective (vertexTensorMul k Q) := by
  intro x
  refine ⟨⟨((Bimodule.of (AlgHom.id k 𝒜)).symm x ⊗ₜ[k] 1) * vertexTensorIdempotent k Q,
    Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)⟩, ?_⟩
  rw [vertexTensorMul_apply, mul_smul, vertexTensorIdempotent_def, Finset.sum_smul]
  simp [← map_sum, ← one_def]

/-! ### The differential -/

variable [DecidableEq Q] [∀ i j : Q, DecidableEq (i ⟶ j)]

variable (k Q)

/-- The component at an arrow `b : i ⟶ j` of the differential of the standard resolution: right
multiplication by `b ⊗ eᵢ - eⱼ ⊗ b`, from `kQ eⱼ ⊗_k eᵢ kQ` to `kQ ⊗_{kQ₀} kQ`. -/
private noncomputable def arrowTensorDifferentialComponent (b : Σ i j : Q, i ⟶ j) :
    (Ideal.span {arrowTensorIdempotent k Q b} : Ideal 𝒜ᵉ) →ₗ[𝒜ᵉ] vertexTensorBimodule k Q :=
  LinearMap.toSpanSingleton 𝒜ᵉ _ ⟨arrowTensorBoundary k Q b, mem_vertexTensorBimodule_iff.2
    (arrowTensorBoundary_mul_vertexTensorIdempotent b)⟩ ∘ₗ
      (Ideal.span {arrowTensorIdempotent k Q b}).subtype

/-- **The differential of the standard resolution**, `x eⱼ ⊗ eᵢ y ↦ x b ⊗ eᵢ y - x eⱼ ⊗ b y` in
the component of an arrow `b : i ⟶ j`. -/
noncomputable def arrowTensorDifferential :
    arrowTensorBimodule k Q →ₗ[𝒜ᵉ] vertexTensorBimodule k Q :=
  DirectSum.toModule 𝒜ᵉ _ _ (arrowTensorDifferentialComponent k Q)

variable {k Q}

/-- The differential on the component of an arrow `b : i ⟶ j` is right multiplication by
`b ⊗ eᵢ - eⱼ ⊗ b`. -/
@[simp]
theorem coe_arrowTensorDifferential_lof (b : Σ i j : Q, i ⟶ j)
    (u : (Ideal.span {arrowTensorIdempotent k Q b} : Ideal 𝒜ᵉ)) :
    (arrowTensorDifferential k Q (DirectSum.lof 𝒜ᵉ _ _ b u) : 𝒜ᵉ) =
      u * arrowTensorBoundary k Q b := by
  simp [arrowTensorDifferential, arrowTensorDifferentialComponent]

/-- **The differential is `x ⊗ y ↦ x b ⊗ y - x ⊗ b y`**: on the generator `x eⱼ ⊗ eᵢ y` of the
component of an arrow `b : i ⟶ j` its value is `x b ⊗ eᵢ y - x eⱼ ⊗ b y`. -/
theorem coe_arrowTensorDifferential_lof_tmul (b : Σ i j : Q, i ⟶ j) (x y : 𝒜) :
    (arrowTensorDifferential k Q
      (DirectSum.lof 𝒜ᵉ _ _ b ⟨_, tmul_mem_span_arrowTensorIdempotent b x y⟩) : 𝒜ᵉ) =
      (x * ofArrow b.2.2) ⊗ₜ[k] op (ε b.1 * y) - (x * ε b.2.1) ⊗ₜ[k] op (ofArrow b.2.2 * y) := by
  obtain ⟨i, j, b⟩ := b
  rw [coe_arrowTensorDifferential_lof, arrowTensorBoundary, mul_sub]
  simp [← op_mul, mul_assoc, IsIdempotentElem.mul_self_mul (x := ε i) (vertexIdempotent_mul_self i)]

/-- **The standard sequence is a complex**: multiplication kills the image of the differential. -/
theorem vertexTensorMul_comp_arrowTensorDifferential :
    vertexTensorMul k Q ∘ₗ arrowTensorDifferential k Q = 0 := by
  refine DirectSum.linearMap_ext 𝒜ᵉ fun b ↦ LinearMap.ext fun u ↦ ?_
  simp [vertexTensorMul_apply, mul_smul]

/-- **The standard sequence is a complex**, pointwise. -/
@[simp]
theorem vertexTensorMul_arrowTensorDifferential (w : arrowTensorBimodule k Q) :
    vertexTensorMul k Q (arrowTensorDifferential k Q w) = 0 :=
  LinearMap.congr_fun vertexTensorMul_comp_arrowTensorDifferential w

/-! ### The contracting homotopy -/

private theorem coe_arrowTensorDifferential_arrowTensorProj (b : Σ i j : Q, i ⟶ j) (w : 𝒜ᵉ) :
    (arrowTensorDifferential k Q (arrowTensorProj b w) : 𝒜ᵉ) = w * arrowTensorBoundary k Q b := by
  simp [arrowTensorProj_apply, mul_assoc, arrowTensorIdempotent_mul_arrowTensorBoundary]

/-- The boundary of the homotopy on `x ⊗ q` telescopes to `x q ⊗ eₛ - x eₜ ⊗ q`. -/
private theorem coe_arrowTensorDifferential_homotopyPath {s t : Q} (q : Quiver.Path s t) (x : 𝒜) :
    (arrowTensorDifferential k Q (homotopyPath q x) : 𝒜ᵉ) =
      (x * ofPath ⟨s, t, q⟩) ⊗ₜ[k] op (ε s) - (x * ε t) ⊗ₜ[k] op (ofPath ⟨s, t, q⟩) := by
  induction q generalizing x with
  | nil => rw [homotopyPath_nil, LinearMap.zero_apply, map_zero, ← vertexIdempotent_eq_ofPath,
      ZeroMemClass.coe_zero, sub_self]
  | @cons t t' q c ih =>
    rw [homotopyPath_cons, map_add, Submodule.coe_add, ih,
      coe_arrowTensorDifferential_arrowTensorProj, arrowTensorBoundary, mul_sub]
    simp only [Algebra.TensorProduct.tmul_mul_tmul, ← op_mul, mul_assoc, ofArrow_eq_ofPath,
      ofPath_mul_ofPath_of_comp, Quiver.Path.comp_toPath_eq_cons, vertexIdempotent_mul_ofPath,
      ofPath_mul_vertexIdempotent]
    abel

omit [Fintype Q] in
/-- On the component of an arrow `b`, the homotopy after right multiplication by the boundary
of `b` is minus the projection onto that component. -/
private theorem homotopy_comp_mulRight_arrowTensorBoundary [Finite Q] (b : Σ i j : Q, i ⟶ j) :
    homotopy ∘ₗ LinearMap.mulRight k (arrowTensorBoundary k Q b) =
      -(arrowTensorProj (k := k) b).restrictScalars k := by
  -- Both sides are `k`-linear, so they agree as linear maps, compared on the `x ⊗ q`.
  refine tensorProduct_op_linearMap_ext fun x s t q ↦ ?_
  obtain ⟨i, j, c⟩ := b
  simp only [LinearMap.comp_apply, LinearMap.mulRight_apply, LinearMap.neg_apply,
    LinearMap.restrictScalars_apply]
  rw [arrowTensorBoundary, mul_sub, map_sub, arrowTensorProj_tmul]
  simp only [Algebra.TensorProduct.tmul_mul_tmul, ← op_mul]
  by_cases ht : t = i
  · subst ht
    rw [vertexIdempotent_mul_ofPath, ofArrow_mul_ofPath, homotopy_tmul, homotopy_tmul,
      homotopyPath_cons]
    simp [mul_assoc]
  · simp [vertexIdempotent_mul_ofPath_of_ne ⟨s, t, q⟩ (Ne.symm ht),
      ofPath_mul_ofPath_of_not_composable (x := ⟨i, j, c.toPath⟩) (y := ⟨s, t, q⟩) ht]

/-- **The homotopy composed with the differential is minus the identity.** -/
private theorem homotopy_arrowTensorDifferential (w : arrowTensorBimodule k Q) :
    homotopy (arrowTensorDifferential k Q w : 𝒜ᵉ) = -w := by
  induction w using DirectSum.induction_on with
  | zero => rw [map_zero, ZeroMemClass.coe_zero, map_zero, neg_zero]
  | add w w' hw hw' => rw [map_add, Submodule.coe_add, map_add, hw, hw', neg_add]
  | of b u =>
    obtain ⟨u, hu⟩ := u
    obtain ⟨v, rfl⟩ := Ideal.mem_span_singleton'.1 hu
    have hof : DirectSum.of _ b ⟨v * arrowTensorIdempotent k Q b, hu⟩ = arrowTensorProj b v := by
      rw [arrowTensorProj_apply, DirectSum.lof_eq_of]
    rw [hof, coe_arrowTensorDifferential_arrowTensorProj]
    simpa using LinearMap.congr_fun (homotopy_comp_mulRight_arrowTensorBoundary b) v

/-- **The differential composed with the homotopy** is `u ↦ (μ u ⊗ 1)(∑ᵥ eᵥ ⊗ eᵥ) - u` on
`kQ ⊗_{kQ₀} kQ`, for `μ` the multiplication map, here the action of `u` on `1`; the elements of
`kQ ⊗_{kQ₀} kQ` are the `v (∑ᵥ eᵥ ⊗ eᵥ)`. -/
private theorem coe_arrowTensorDifferential_homotopy (v : 𝒜ᵉ) :
    (arrowTensorDifferential k Q (homotopy (v * vertexTensorIdempotent k Q)) : 𝒜ᵉ) =
      ((Bimodule.of (AlgHom.id k 𝒜)).symm
          ((v * vertexTensorIdempotent k Q) • Bimodule.of (AlgHom.id k 𝒜) 1) ⊗ₜ[k] 1) *
        vertexTensorIdempotent k Q - v * vertexTensorIdempotent k Q := by
  -- Both sides are `k`-linear in `v`, so they agree as linear maps, compared on the `x ⊗ q`.
  have key : (vertexTensorBimodule k Q).subtype.restrictScalars k ∘ₗ
      (arrowTensorDifferential k Q).restrictScalars k ∘ₗ homotopy ∘ₗ
        LinearMap.mulRight k (vertexTensorIdempotent k Q) =
      LinearMap.mulRight k (vertexTensorIdempotent k Q) ∘ₗ
        (TensorProduct.mk k 𝒜 𝒜ᵐᵒᵖ).flip 1 ∘ₗ (Bimodule.of (AlgHom.id k 𝒜)).symm.toLinearMap ∘ₗ
          (LinearMap.toSpanSingleton 𝒜ᵉ _ (Bimodule.of (AlgHom.id k 𝒜) 1)).restrictScalars k ∘ₗ
            LinearMap.mulRight k (vertexTensorIdempotent k Q) -
        LinearMap.mulRight k (vertexTensorIdempotent k Q) := by
    refine tensorProduct_op_linearMap_ext fun x s t q ↦ ?_
    simp only [LinearMap.comp_apply, LinearMap.sub_apply, LinearMap.mulRight_apply,
      LinearMap.restrictScalars_apply, Submodule.subtype_apply, TensorProduct.mk_apply,
      LinearMap.flip_apply, LinearEquiv.coe_coe, LinearMap.toSpanSingleton_apply]
    rw [tmul_mul_vertexTensorIdempotent_of_vertexIdempotent_mul x (vertexIdempotent_mul_ofPath q),
      homotopy_tmul, coe_arrowTensorDifferential_homotopyPath, Bimodule.smul_of,
      LinearEquiv.symm_apply_apply, ← op_one,
      tmul_mul_vertexTensorIdempotent_of_mul_vertexIdempotent (v := s) (by simp [mul_assoc])]
    simp [mul_assoc]
  simpa using LinearMap.congr_fun key v

/-! ### Exactness -/

/-- **The differential of the standard resolution is injective.** -/
theorem arrowTensorDifferential_injective : Function.Injective (arrowTensorDifferential k Q) := by
  intro w w' h
  rw [← neg_inj, ← homotopy_arrowTensorDifferential, ← homotopy_arrowTensorDifferential, h]

/-- **The standard resolution is exact in the middle**: the kernel of the multiplication map
`kQ ⊗_{kQ₀} kQ → kQ` is the image of the differential. -/
theorem exact_arrowTensorDifferential_vertexTensorMul :
    Function.Exact (arrowTensorDifferential k Q) (vertexTensorMul k Q) := by
  intro u
  refine ⟨fun hu ↦ ?_, ?_⟩
  · obtain ⟨u, hmem⟩ := u
    have hE := mem_vertexTensorBimodule_iff.1 hmem
    refine ⟨-homotopy u, Subtype.ext ?_⟩
    rw [vertexTensorMul_apply, Submodule.coe_mk] at hu
    have key := coe_arrowTensorDifferential_homotopy (k := k) (Q := Q) u
    rw [hE, hu, map_zero, TensorProduct.zero_tmul, zero_mul, zero_sub] at key
    rw [map_neg, Submodule.coe_neg, key, neg_neg]
  · rintro ⟨w, rfl⟩
    exact vertexTensorMul_arrowTensorDifferential w

