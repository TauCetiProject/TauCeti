/-!
# Necklace functionals and simple cycles in path algebras

Let `Q` be a quiver. Every closed path `p : Path u u` determines its *necklace*, the cyclic list
`(p.vertices.dropLast : Cycle Q)` of vertices visited before returning to `u`. A weight
`W : Cycle Q → k` defines a linear functional `TauCeti.PathAlgebra.necklaceFunctional` on the path
algebra `kQ`, sending each closed path to the weight of its necklace and every non-closed path to
zero; for the doubled quiver of a simple graph, `TauCeti.DoubledQuiver.necklaceFunctional` is the
specialization reading vertices in the underlying graph. Because concatenating two composable paths
in opposite orders rotates their vertex lists, `necklaceFunctional` is a trace when `k` is
commutative, and therefore vanishes on the commutator submodule `[kQ, kQ]`.

Suppose moreover that `W` vanishes on cycles of length two and on cycles with repeated vertices
(`¬ s.Nodup`). Then `necklaceFunctional k W` kills every product `(ofArrow e₂ * ofArrow e₁) * x` of
a two-step loop `v → w → v` with an arbitrary path-algebra element `x`: on a closed path `q` at
`v`, appending `v → w → v` produces `[v, w]` of length two when `q` is trivial, and repeats the
base vertex `v` when `q` has positive length. By the trace property, `necklaceFunctional k W`
therefore kills any two-sided ideal generated by linear combinations of two-step loops, including
the preprojective, gauged preprojective, and signless preprojective relation ideals.

Evaluating the indicator weight of a single simple cycle yields a general obstruction to positive
cyclic-quotient vanishing: if `f : pathAlgebra k Q →ₐ[k] A` is a surjective algebra homomorphism
over a nontrivial commutative ring whose kernel is generated as a two-sided ideal by linear
combinations of two-step loops, then the image of every closed path `p : Path u u` with
`p.length ≠ 2` and `p.vertices.dropLast.Nodup` does not belong to `[A, A]`.

## Main definitions

* `TauCeti.PathAlgebra.necklaceFunctional`: the linear functional on `pathAlgebra k Q` induced by a
  weight `W : Cycle Q → k`.

## Main results

* `TauCeti.PathAlgebra.necklaceFunctional_mul_comm` and
  `TauCeti.PathAlgebra.commutatorSubmodule_le_ker_necklaceFunctional`: `necklaceFunctional` is a
  trace and vanishes on `[kQ, kQ]`.
* `TauCeti.PathAlgebra.necklaceFunctional_ofArrow_mul_ofArrow_mul_eq_zero`: weights vanishing on
  length-two and non-nodup cycles annihilate left multiples of two-step loops.
* `TauCeti.PathAlgebra.necklaceFunctional_eq_zero_of_mem_twoSidedIdeal_span`: such weights vanish
  on two-sided ideals generated by linear combinations of two-step loops.
* `TauCeti.PathAlgebra.map_ofPath_notMem_commutatorSubmodule_of_nodup`: a simple closed path of
  length different from two survives in the cyclic quotient `A / [A, A]`.

## Implementation notes

The trace property and two-sided-ideal descent generalize `TauCeti.DoubledQuiver.necklaceFunctional`
and `TauCeti.signlessNecklaceFunctional`
(`TauCeti.RepresentationTheory.Quiver.Preprojective.Signless.Necklace`) from doubled quivers of
simple graphs to arbitrary quivers `Q`. Working directly on `Q` (and `Quiver.Symmetrify Q`) avoids
any bipartiteness assumption, so simple cycles of odd length are covered directly in additive and
gauged preprojective algebras.

## References

* J.-L. Loday, *Cyclic Homology*, Section 1.1, for the cyclic quotient as zeroth Hochschild
  homology.
* T. Schedler, *Hochschild homology of preprojective algebras over the integers*, Adv. Math. 299
  (2016), Theorem 13.1.1, https://arxiv.org/abs/0704.3278.
* Y. Liu and Z. Wang, *A-infinity deformations of zigzag algebras via Ginzburg dg algebras*,
  Corollary 3.4, https://arxiv.org/abs/2301.06757, where simple cycles of length at least three
  produce nonzero cyclic classes of non-tree graphs.
-/

public section

namespace TauCeti.PathAlgebra

open _root_.Quiver

universe u v w

section Semiring

variable (k : Type w) [Semiring k] {Q : Type u} [Quiver.{v} Q]

open scoped Classical in
/-- The **necklace functional** on `pathAlgebra k Q` attached to a weight `W : Cycle Q → k`: it
sends every closed path to the weight of its cyclic vertex list (with the final return to the base
vertex omitted) and every non-closed path to `0`. -/
noncomputable def necklaceFunctional (W : Cycle Q → k) : pathAlgebra k Q →ₗ[k] k :=
  liftLinear k fun x =>
    if x.1 = x.2.1 then W (x.2.2.vertices.dropLast : Cycle Q) else 0

variable {k} (W : Cycle Q → k)

/-- On a closed path, the necklace functional evaluates `W` on its cyclic vertex list. -/
@[simp]
theorem necklaceFunctional_ofPath (a : Q) (p : Path a a) :
    necklaceFunctional k W (ofPath ⟨a, a, p⟩) = W (p.vertices.dropLast : Cycle Q) := by
  classical
  rw [necklaceFunctional, liftLinear_ofPath, ite_eq_left rfl]

/-- On a path between distinct vertices, the necklace functional vanishes. -/
@[simp]
theorem necklaceFunctional_ofPath_of_ne {a b : Q} (p : Path a b) (h : a ≠ b) :
    necklaceFunctional k W (ofPath ⟨a, b, p⟩) = 0 := by
  classical
  rw [necklaceFunctional, liftLinear_ofPath, ite_eq_right h]

private theorem necklaceFunctional_ofPath_mul_ofPath (x y : Quiver.TotalPath Q) :
    necklaceFunctional k W (ofPath x * ofPath y) =
      necklaceFunctional k W (ofPath y * ofPath x) := by
  obtain ⟨a, b, p⟩ := x
  obtain ⟨c, d, q⟩ := y
  by_cases hda : d = a
  · subst d
    by_cases hbc : b = c
    · subst c
      rw [ofPath_mul_ofPath_of_comp, ofPath_mul_ofPath_of_comp, necklaceFunctional_ofPath,
        necklaceFunctional_ofPath, Path.vertices_comp, Path.vertices_comp,
        List.dropLast_append_of_ne_nil q.vertices_ne_nil,
        List.dropLast_append_of_ne_nil p.vertices_ne_nil]
      exact congrArg W (Cycle.coe_eq_coe.mpr List.isRotated_append)
    · rw [ofPath_mul_ofPath_of_comp, ofPath_mul_ofPath_of_not_composable hbc,
        necklaceFunctional_ofPath_of_ne W _ (Ne.symm hbc), map_zero]
  · rw [ofPath_mul_ofPath_of_not_composable hda, map_zero]
    by_cases hbc : b = c
    · subst c
      rw [ofPath_mul_ofPath_of_comp, necklaceFunctional_ofPath_of_ne W _ (Ne.symm hda)]
    · rw [ofPath_mul_ofPath_of_not_composable hbc, map_zero]

private theorem necklaceFunctional_ofArrow_mul_ofArrow_mul_ofPath_eq_zero {W : Cycle Q → k}
    (hW₂ : ∀ s : Cycle Q, s.length = 2 → W s = 0)
    (hW_nodup : ∀ s : Cycle Q, ¬ s.Nodup → W s = 0)
    {v w : Q} (e₁ : v ⟶ w) (e₂ : w ⟶ v) (x : Quiver.TotalPath Q) :
    necklaceFunctional k W ((ofArrow e₂ * ofArrow e₁) * ofPath x) = 0 := by
  rw [ofArrow_eq_ofPath, ofArrow_eq_ofPath, ofPath_mul_ofPath_of_comp]
  obtain ⟨c, d, q⟩ := x
  by_cases hd : d = v
  swap
  · rw [ofPath_mul_ofPath_of_not_composable hd, map_zero]
  subst d
  rw [ofPath_mul_ofPath_of_comp]
  by_cases hc : c = v
  swap
  · exact necklaceFunctional_ofPath_of_ne W _ hc
  subst c
  rw [necklaceFunctional_ofPath]
  have hloop : (e₁.toPath.comp e₂.toPath).vertices = [v, w, v] := by
    rw [Path.vertices_comp, Path.vertices_toPath, Path.vertices_toPath]
    rfl
  have hne : (e₁.toPath.comp e₂.toPath).vertices ≠ [] := by
    rw [hloop]
    exact List.cons_ne_nil _ _
  rw [Path.vertices_comp, List.dropLast_append_of_ne_nil hne, hloop]
  simp only [List.dropLast_cons_cons, List.dropLast_singleton]
  cases hL : q.vertices.dropLast with
  | nil =>
      exact hW₂ _ (by simp [Cycle.length_coe])
  | cons a L =>
      have ha : a = v := by
        have hh := q.vertices_head?
        rw [← q.dropLast_append_end_eq, hL] at hh
        exact Option.some.inj hh
      subst a
      refine hW_nodup _ ?_
      rw [Cycle.nodup_coe_iff, List.cons_append, List.nodup_cons]
      intro hmem
      exact hmem.1 (List.mem_append_right _ (List.mem_cons_self))

end Semiring

section CommSemiring

variable {k : Type w} [CommSemiring k] {Q : Type u} [Quiver.{v} Q]

/-- **The necklace functional is a trace**: swapping the factors of a product rotates the necklaces
of composable path pairs. -/
theorem necklaceFunctional_mul_comm (W : Cycle Q → k) (x y : pathAlgebra k Q) :
    necklaceFunctional k W (x * y) = necklaceFunctional k W (y * x) := by
  induction x using induction_linear with
  | zero => simp
  | add x x' hx hx' => simp only [add_mul, mul_add, map_add, hx, hx']
  | single p a =>
      induction y using induction_linear with
      | zero => simp
      | add y y' hy hy' => simp only [add_mul, mul_add, map_add, hy, hy']
      | single q b =>
          simp only [single_eq_smul_ofPath, smul_mul_assoc, mul_smul_comm, map_smul,
            necklaceFunctional_ofPath_mul_ofPath, smul_smul, mul_comm]

/-- If `W` vanishes on length-two cycles and on cycles with repeated vertices, then
`necklaceFunctional k W` kills every right multiple of a two-step loop `ofArrow e₂ * ofArrow e₁`. -/
theorem necklaceFunctional_ofArrow_mul_ofArrow_mul_eq_zero {W : Cycle Q → k}
    (hW₂ : ∀ s : Cycle Q, s.length = 2 → W s = 0)
    (hW_nodup : ∀ s : Cycle Q, ¬ s.Nodup → W s = 0)
    {v w : Q} (e₁ : v ⟶ w) (e₂ : w ⟶ v) (x : pathAlgebra k Q) :
    necklaceFunctional k W ((ofArrow e₂ * ofArrow e₁) * x) = 0 := by
  induction x using induction_linear with
  | zero => simp
  | add x y hx hy => rw [mul_add, map_add, hx, hy, add_zero]
  | single p c =>
      rw [single_eq_smul_ofPath, mul_smul_comm, map_smul,
        necklaceFunctional_ofArrow_mul_ofArrow_mul_ofPath_eq_zero hW₂ hW_nodup, smul_zero]

end CommSemiring

section CommRing

variable {k : Type w} [CommRing k] {Q : Type u} [Quiver.{v} Q]

/-- **The necklace functional vanishes on the commutator submodule.** -/
theorem commutatorSubmodule_le_ker_necklaceFunctional (W : Cycle Q → k) :
    commutatorSubmodule k (pathAlgebra k Q) ≤ LinearMap.ker (necklaceFunctional k W) :=
  (commutatorSubmodule_le_ker_iff _).2 (necklaceFunctional_mul_comm W)

variable [Finite Q]

/-- If `W` vanishes on length-two cycles and on cycles with repeated vertices, then
`necklaceFunctional k W` vanishes on any two-sided ideal generated by linear combinations of
two-step loops `ofArrow e₂ * ofArrow e₁`. -/
theorem necklaceFunctional_eq_zero_of_mem_twoSidedIdeal_span {W : Cycle Q → k}
    (hW₂ : ∀ s : Cycle Q, s.length = 2 → W s = 0)
    (hW_nodup : ∀ s : Cycle Q, ¬ s.Nodup → W s = 0)
    {S : Set (pathAlgebra k Q)}
    (hS : ∀ s ∈ S, s ∈ Submodule.span k
      {z : pathAlgebra k Q | ∃ (v w : Q) (e₁ : v ⟶ w) (e₂ : w ⟶ v), z = ofArrow e₂ * ofArrow e₁})
    {x : pathAlgebra k Q} (hx : x ∈ TwoSidedIdeal.span S) :
    necklaceFunctional k W x = 0 := by
  suffices h : ∀ a b : pathAlgebra k Q, necklaceFunctional k W (a * x * b) = 0 by
    simpa using h 1 1
  induction hx using TwoSidedIdeal.span_induction with
  | mem y hy =>
      intro a b
      rw [mul_assoc, necklaceFunctional_mul_comm, mul_assoc]
      have hspan := hS y hy
      clear hy
      induction hspan using Submodule.span_induction with
      | mem _ hz =>
          obtain ⟨v, w, e₁, e₂, rfl⟩ := hz
          exact necklaceFunctional_ofArrow_mul_ofArrow_mul_eq_zero hW₂ hW_nodup e₁ e₂ (b * a)
      | zero => simp
      | add _ _ _ _ h₁ h₂ => rw [add_mul, map_add, h₁, h₂, add_zero]
      | smul r _ _ h₁ => rw [smul_mul_assoc, map_smul, h₁, smul_zero]
  | zero => simp
  | add _ _ _ _ hx hy => intro a b; rw [mul_add, add_mul, map_add, hx, hy, add_zero]
  | neg _ _ hx => intro a b; rw [mul_neg, neg_mul, map_neg, hx, neg_zero]
  | left_absorb c _ _ hx => intro a b; simpa only [mul_assoc] using hx (a * c) b
  | right_absorb c _ _ hx => intro a b; simpa only [mul_assoc] using hx a (c * b)

/-- **Simple cycles of length different from two survive modulo commutators.** Let
`f : pathAlgebra k Q →ₐ[k] A` be a surjective algebra homomorphism over a nontrivial commutative
ring whose kernel is contained in a two-sided ideal generated by linear combinations of two-step
loops. Then the image of every closed path `p : Path u u` with `p.length ≠ 2` and
`p.vertices.dropLast.Nodup` does not belong to `commutatorSubmodule k A`. -/
theorem map_ofPath_notMem_commutatorSubmodule_of_nodup [Nontrivial k]
    {A : Type*} [Ring A] [Algebra k A] (f : pathAlgebra k Q →ₐ[k] A)
    (hf : Function.Surjective f) {S : Set (pathAlgebra k Q)}
    (hS : ∀ s ∈ S, s ∈ Submodule.span k
      {z : pathAlgebra k Q | ∃ (v w : Q) (e₁ : v ⟶ w) (e₂ : w ⟶ v), z = ofArrow e₂ * ofArrow e₁})
    (hker : ∀ x, f x = 0 → x ∈ TwoSidedIdeal.span S)
    {u : Q} (p : Path u u) (hlen : p.length ≠ 2) (hnodup : p.vertices.dropLast.Nodup) :
    f (ofPath ⟨u, u, p⟩) ∉ commutatorSubmodule k A := by
  classical
  let c₀ : Cycle Q := p.vertices.dropLast
  let W : Cycle Q → k := fun s => if s = c₀ then 1 else 0
  have hW₂ (s : Cycle Q) (hs : s.length = 2) : W s = 0 := by
    refine ite_eq_right fun (h : s = c₀) => hlen ?_
    have hlen₀ : c₀.length = p.length := by
      simp [c₀, Cycle.length_coe, Path.vertices_length]
    exact hlen₀.symm.trans (h ▸ hs)
  have hW_nodup (s : Cycle Q) (hs : ¬ s.Nodup) : W s = 0 :=
    ite_eq_right fun (h : s = c₀) => hs (h ▸ Cycle.nodup_coe_iff.mpr hnodup)
  let τ : A →ₗ[k] k :=
    f.toLinearMap.liftOfSurjective hf
      ⟨necklaceFunctional k W, fun x hx => LinearMap.mem_ker.mpr
        (necklaceFunctional_eq_zero_of_mem_twoSidedIdeal_span hW₂ hW_nodup hS
          (hker x (LinearMap.mem_ker.mp hx)))⟩
  have hτ_mk (x : pathAlgebra k Q) : τ (f x) = necklaceFunctional k W x :=
    LinearMap.equivOfSurjective_apply _ _
  have hτ_comm (x y : A) : τ (x * y) = τ (y * x) := by
    obtain ⟨x, rfl⟩ := hf x
    obtain ⟨y, rfl⟩ := hf y
    rw [← map_mul, ← map_mul, hτ_mk, hτ_mk, necklaceFunctional_mul_comm]
  intro hmem
  have hzero := LinearMap.mem_ker.mp ((commutatorSubmodule_le_ker_iff τ).mpr hτ_comm hmem)
  rw [hτ_mk, necklaceFunctional_ofPath] at hzero
  simp only [W, c₀, ↓reduceIte] at hzero
  exact one_ne_zero hzero

end CommRing

end TauCeti.PathAlgebra
