module

public import TauCeti.RepresentationTheory.Quiver.Preprojective.Resolution
public import TauCeti.Algebra.Module.GradedModule.Resolution
public import TauCeti.Algebra.Module.GradedModule.Opposite
public import TauCeti.Algebra.Category.GradedModuleCat.Abelian

/-!
# The graded preprojective Koszul resolution

The right vertex projectives of a preprojective algebra inherit the path-length grading.
The Koszul differentials multiply by arrows and therefore raise path degree by one.
Shifting the middle projective by one and the left projective by two makes the differentials
homogeneous of degree zero. For quivers without sinks these terms give a linear graded
projective resolution of the vertex augmentation module.

Right modules are left modules over the ordinary opposite algebra, without a Koszul sign.
The internal shifts are implemented by `InternalGrading.shift (-n)`, so generators of the
term in homological degree `n` have internal degree `n`.

## References

* P. Etingof and C.-H. Eu, *Koszulity and the Hilbert series of preprojective algebras*,
  Math. Res. Lett. 14 (2007), Sections 2 and 3.
-/

public section

namespace TauCeti

open _root_.Quiver PathAlgebra MulOpposite

universe u v w

variable (k : Type w) {Q : Type u} [CommRing k] [Quiver.{v} Q] [Fintype Q]
  [∀ i j : Q, Fintype (i ⟶ j)]

local notation "Π" => preprojectiveAlgebra k Q
local notation "π" => preprojectiveMk k Q
local notation "e" => fun i : Symmetrify Q => π (vertexIdempotent k i)

attribute [local instance] preprojectiveIntegerGradedAlgebra

/-- The right vertex ideal is homogeneous: projection commutes with left multiplication
by its degree-zero idempotent. -/
theorem isHomogeneous_preprojectiveRightProjective (i : Symmetrify Q) :
    DirectSum.SetLike.IsHomogeneous (preprojectiveIntegerGrade k (Q := Q))
      ((preprojectiveRightProjective k i).restrictScalars k : Submodule k Π) := by
  have hm : LinearMap.IsHomogeneous (LinearMap.mulLeft k (e i))
      (preprojectiveIntegerGrade k (Q := Q)) (preprojectiveIntegerGrade k (Q := Q)) 0 :=
    LinearMap.isHomogeneous_def.2 fun _ _ hx => by
      simpa using SetLike.mul_mem_graded
        (preprojectiveMk_vertexIdempotent_mem_preprojectiveIntegerGrade_zero k i) hx
  intro p x hx
  rw [Submodule.restrictScalars_mem, mem_preprojectiveRightProjective_iff] at hx ⊢
  have h := hm.map_decompose p x
  rw [Int.add_zero] at h
  simpa only [LinearMap.mulLeft_apply, hx] using h

/-- The internal grading on `e_i Π`, restricted from the actual preprojective algebra. -/
noncomputable def preprojectiveRightProjectiveGrading (i : Symmetrify Q) :
    InternalGrading k (preprojectiveRightProjective k i) :=
  (preprojectiveInternalGrading k (Q := Q)).submodule
    ((preprojectiveRightProjective k i).restrictScalars k)
    ((InternalGrading.isHomogeneous_ofDecomposition_piece_iff _ _).2
      (isHomogeneous_preprojectiveRightProjective k i))

/-- Homogeneity in the right vertex ideal is homogeneity of its underlying path class. -/
@[simp]
theorem mem_preprojectiveRightProjectiveGrading_piece_iff (i : Symmetrify Q) (p : ℤ)
    (x : preprojectiveRightProjective k i) :
    x ∈ (preprojectiveRightProjectiveGrading k i).piece p ↔
      (x : Π) ∈ preprojectiveIntegerGrade k (Q := Q) p := by
  simp only [preprojectiveRightProjectiveGrading, InternalGrading.submodule_piece,
    InternalGrading.ofDecomposition_piece]
  -- Restricting scalars preserves the underlying subtype; membership in the comap along
  -- its subtype map is definitionally membership of the underlying algebra element.
  exact Iff.rfl

/-- Right multiplication respects the restricted path-length grading. -/
instance preprojectiveRightProjective_gradedSMul (i : Symmetrify Q) :
    SetLike.GradedSMul (preprojectiveInternalGrading k (Q := Q)).opposite.piece
      (preprojectiveRightProjectiveGrading k i).piece where
  smul_mem := by
    intro p q a x ha hx
    rw [mem_preprojectiveRightProjectiveGrading_piece_iff] at hx ⊢
    rw [InternalGrading.mem_opposite_piece_iff, InternalGrading.ofDecomposition_piece] at ha
    simpa only [Submodule.coe_smul, MulOpposite.smul_eq_mul_unop, vadd_eq_add, add_comm p q] using
      SetLike.mul_mem_graded hx ha

/-- Every right vertex projective is generated by its degree-zero idempotent. -/
theorem isGeneratedInDegree_preprojectiveRightProjectiveGrading (i : Symmetrify Q) :
    (preprojectiveRightProjectiveGrading k i).IsGeneratedInDegree Πᵐᵒᵖ 0 := by
  let g : preprojectiveRightProjective k i := ⟨e i, by
    rw [mem_preprojectiveRightProjective_iff, ← map_mul, vertexIdempotent_mul_self]⟩
  have hg : g ∈ (preprojectiveRightProjectiveGrading k i).piece 0 :=
    (mem_preprojectiveRightProjectiveGrading_piece_iff k i 0 g).2
      (preprojectiveMk_vertexIdempotent_mem_preprojectiveIntegerGrade_zero k i)
  rw [InternalGrading.isGeneratedInDegree_iff]
  intro x
  have hx : op (x : Π) • g = x := by
    apply Subtype.ext
    exact (mem_preprojectiveRightProjective_iff k i x).1 x.property
  rw [← hx]
  exact Submodule.smul_mem _ _ (Submodule.subset_span hg)

/-- The middle Koszul term with the componentwise path grading. -/
noncomputable def preprojectiveKoszulMiddleGrading (v : Q) :
    InternalGrading k (preprojectiveKoszulMiddle k v) :=
  ((InternalGrading.directSum fun i : Symmetrify Q =>
    (InternalGrading.directSum fun _ : i ⟶ Symmetrify.of.obj v =>
      preprojectiveRightProjectiveGrading k i).map
        (DirectSum.linearEquivFunOnFintype k _ _))).map
    (DirectSum.linearEquivFunOnFintype k _ _)

/-- The path degree in the middle Koszul term is tested in each arrow-indexed component. -/
@[simp]
theorem mem_preprojectiveKoszulMiddleGrading_piece_iff (v : Q) (p : ℤ)
    (x : preprojectiveKoszulMiddle k v) :
    x ∈ (preprojectiveKoszulMiddleGrading k v).piece p ↔
      ∀ (i : Symmetrify Q) (b : i ⟶ Symmetrify.of.obj v),
        (x i b : Π) ∈ preprojectiveIntegerGrade k (Q := Q) p := by
  simp only [preprojectiveKoszulMiddleGrading, InternalGrading.mem_map_piece_iff,
    InternalGrading.directSum_piece, InternalGrading.mem_directSumPiece_iff,
    mem_preprojectiveRightProjectiveGrading_piece_iff]
  have h₁ (i : Symmetrify Q) :
      (DirectSum.linearEquivFunOnFintype k (Symmetrify Q) _).symm x i = x i :=
    congrFun ((DirectSum.linearEquivFunOnFintype k (Symmetrify Q) _).apply_symm_apply x) i
  have h₂ (i : Symmetrify Q) (b : i ⟶ Symmetrify.of.obj v) :
      (DirectSum.linearEquivFunOnFintype k (i ⟶ Symmetrify.of.obj v) _).symm (x i) b = x i b :=
    congrFun ((DirectSum.linearEquivFunOnFintype k (i ⟶ Symmetrify.of.obj v) _).apply_symm_apply
      (x i)) b
  simp only [h₁, h₂]

private theorem arrow_mul_mem {i j : Symmetrify Q} (b : i ⟶ j) {p : ℤ} {x : Π}
    (hx : x ∈ preprojectiveIntegerGrade k (Q := Q) p) :
    π (ofArrow b) * x ∈ preprojectiveIntegerGrade k (Q := Q) (p + 1) := by
  have hb := preprojectiveMk_ofArrow_mem_preprojectiveIntegerGrade_one k b
  simpa only [add_comm 1 p] using SetLike.mul_mem_graded hb hx

/-- The left Koszul differential raises path degree by one. -/
theorem isHomogeneous_preprojectiveKoszulLeft (v : Q) :
    LinearMap.IsHomogeneous (preprojectiveKoszulLeft k v)
      (preprojectiveRightProjectiveGrading k (Symmetrify.of.obj v)).piece
      (preprojectiveKoszulMiddleGrading k v).piece 1 := by
  refine LinearMap.isHomogeneous_def.2 fun p x hx => ?_
  rw [mem_preprojectiveRightProjectiveGrading_piece_iff] at hx
  rw [mem_preprojectiveKoszulMiddleGrading_piece_iff]
  intro i b
  rw [coe_preprojectiveKoszulLeft_apply]
  exact Submodule.smul_mem _ _ (arrow_mul_mem k (Quiver.reverse b) hx)

/-- The right Koszul differential raises path degree by one. -/
theorem isHomogeneous_preprojectiveKoszulRight (v : Q) :
    LinearMap.IsHomogeneous (preprojectiveKoszulRight k v)
      (preprojectiveKoszulMiddleGrading k v).piece
      (preprojectiveRightProjectiveGrading k (Symmetrify.of.obj v)).piece 1 := by
  refine LinearMap.isHomogeneous_def.2 fun p x hx => ?_
  rw [mem_preprojectiveKoszulMiddleGrading_piece_iff] at hx
  rw [mem_preprojectiveRightProjectiveGrading_piece_iff, coe_preprojectiveKoszulRight_apply]
  exact Submodule.sum_mem _ fun i _ => Submodule.sum_mem _ fun b _ => arrow_mul_mem k b (hx i b)

/-- Right multiplication respects the arrow-indexed grading of the middle Koszul term. -/
instance preprojectiveKoszulMiddle_gradedSMul (v : Q) :
    SetLike.GradedSMul (preprojectiveInternalGrading k (Q := Q)).opposite.piece
      (preprojectiveKoszulMiddleGrading k v).piece where
  smul_mem := by
    intro p q a x ha hx
    rw [mem_preprojectiveKoszulMiddleGrading_piece_iff] at hx ⊢
    intro i b
    have h := SetLike.GradedSMul.smul_mem
      (B := (preprojectiveRightProjectiveGrading k i).piece) ha
      ((mem_preprojectiveRightProjectiveGrading_piece_iff k i q _).2 (hx i b))
    exact (mem_preprojectiveRightProjectiveGrading_piece_iff k i _ _).1 h

/-- The unshifted middle Koszul term is generated in path degree zero. -/
theorem isGeneratedInDegree_preprojectiveKoszulMiddleGrading (v : Q) :
    (preprojectiveKoszulMiddleGrading k v).IsGeneratedInDegree Πᵐᵒᵖ 0 := by
  unfold preprojectiveKoszulMiddleGrading
  apply (InternalGrading.isGeneratedInDegree_map_iff _
    (DirectSum.linearEquivFunOnFintype Πᵐᵒᵖ _ _) 0).2
  apply InternalGrading.isGeneratedInDegree_directSum
  intro i
  apply (InternalGrading.isGeneratedInDegree_map_iff _
    (DirectSum.linearEquivFunOnFintype Πᵐᵒᵖ _ _) 0).2
  exact InternalGrading.isGeneratedInDegree_directSum _ _ fun _ =>
    isGeneratedInDegree_preprojectiveRightProjectiveGrading k i

open CategoryTheory

local notation "𝒜" => InternalGrading.piece
  (InternalGrading.opposite (preprojectiveInternalGrading k (Q := Q)))

/-- The graded right vertex projective, with its unshifted path-length grading. -/
noncomputable abbrev preprojectiveGradedRightProjective (i : Symmetrify Q) :
    GradedModuleCat.{max u v w} 𝒜 where
  carrier := preprojectiveRightProjective k i
  grading := preprojectiveRightProjectiveGrading k i

/-- The middle projective shifted so its vertex generators have internal degree one. -/
noncomputable abbrev preprojectiveGradedKoszulMiddle (v : Q) :
    GradedModuleCat.{max u v w} 𝒜 :=
  ({ carrier := preprojectiveKoszulMiddle k v
     grading := preprojectiveKoszulMiddleGrading k v } : GradedModuleCat 𝒜).shiftObj 1

/-- The incoming-arrow differential, as a degree-zero map from the shifted middle term.
This is an abbreviation so its cokernel has the carrier of the existing vertex module
without transporting along an equality of ranges. -/
noncomputable abbrev preprojectiveGradedKoszulRight (v : Q) :
    preprojectiveGradedKoszulMiddle k v ⟶
      preprojectiveGradedRightProjective k (Symmetrify.of.obj v) :=
  GradedModuleCat.ofHom (preprojectiveKoszulRight k v) <|
    LinearMap.isHomogeneous_def.2 fun p x hx => by
      rw [InternalGrading.shift_piece] at hx
      convert (isHomogeneous_preprojectiveKoszulRight k v).map_mem hx using 1
      congr 1
      omega

/-- The reverse-arrow differential, as a degree-zero map from the twice-shifted vertex term. -/
noncomputable def preprojectiveGradedKoszulLeft (v : Q) :
    (preprojectiveGradedRightProjective k (Symmetrify.of.obj v)).shiftObj 2 ⟶
      preprojectiveGradedKoszulMiddle k v :=
  GradedModuleCat.ofHom (preprojectiveKoszulLeft k v) <|
    LinearMap.isHomogeneous_def.2 fun p x hx => by
      simp only [InternalGrading.shift_piece, Int.add_zero] at hx ⊢
      convert (isHomogeneous_preprojectiveKoszulLeft k v).map_mem hx using 1
      congr 1
      omega

@[simp]
theorem preprojectiveGradedKoszulRight_hom (v : Q) :
    (preprojectiveGradedKoszulRight k v).hom = preprojectiveKoszulRight k v := (rfl)

@[simp]
theorem preprojectiveGradedKoszulLeft_hom (v : Q) :
    (preprojectiveGradedKoszulLeft k v).hom = preprojectiveKoszulLeft k v := (rfl)

/-- The vertex augmentation module with the quotient grading of the incoming-arrow map. -/
noncomputable abbrev preprojectiveGradedVertexModule (v : Q) :
    GradedModuleCat.{max u v w} 𝒜 :=
  GradedModuleCat.cokernelObj (preprojectiveGradedKoszulRight k v)

/-- The graded augmentation onto the vertex module. -/
noncomputable def preprojectiveGradedVertexAugmentation (v : Q) :
    preprojectiveGradedRightProjective k (Symmetrify.of.obj v) ⟶
      preprojectiveGradedVertexModule k v :=
  GradedModuleCat.cokernelπ (preprojectiveGradedKoszulRight k v)

@[simp]
theorem preprojectiveGradedVertexAugmentation_hom (v : Q) :
    (preprojectiveGradedVertexAugmentation k v).hom = preprojectiveVertexAugmentation k v := by
  ext x
  simp only [preprojectiveGradedVertexAugmentation, GradedModuleCat.cokernelπ,
    GradedModuleCat.hom_ofHom, Submodule.mkQ_apply, preprojectiveVertexAugmentation_apply]

/-- The homogeneous vectors of the vertex module are precisely the classes of homogeneous
vectors of its vertex projective. -/
@[simp]
theorem mem_preprojectiveGradedVertexModule_piece_iff (v : Q) (p : ℤ)
    (x : preprojectiveGradedVertexModule k v) :
    x ∈ (preprojectiveGradedVertexModule k v).grading.piece p ↔
      ∃ y : preprojectiveRightProjective k (Symmetrify.of.obj v),
        (y : Π) ∈ preprojectiveIntegerGrade k (Q := Q) p ∧
          preprojectiveVertexAugmentation k v y = x := by
  rw [GradedModuleCat.mem_cokernelGrading_piece_iff]
  simp only [mem_preprojectiveRightProjectiveGrading_piece_iff,
    preprojectiveVertexAugmentation_apply]

/-- The graded Koszul terms: the vertex projective in degrees zero and two, with internal
shifts zero and two, the arrow-indexed projective shifted by one, and zero thereafter. -/
noncomputable abbrev preprojectiveGradedKoszulTerm (v : Q) :
    ℕ → GradedModuleCat.{max u v w} 𝒜
  | 0 => preprojectiveGradedRightProjective k (Symmetrify.of.obj v)
  | 1 => preprojectiveGradedKoszulMiddle k v
  | 2 => (preprojectiveGradedRightProjective k (Symmetrify.of.obj v)).shiftObj 2
  | _ + 3 => GradedModuleCat.directSumObj fun _ : Fin 0 =>
      preprojectiveGradedRightProjective k (Symmetrify.of.obj v)

/-- The degree-zero graded Koszul differentials. -/
noncomputable def preprojectiveGradedKoszulDifferential (v : Q) : ∀ n : ℕ,
    preprojectiveGradedKoszulTerm k v (n + 1) ⟶ preprojectiveGradedKoszulTerm k v n
  | 0 => preprojectiveGradedKoszulRight k v
  | 1 => preprojectiveGradedKoszulLeft k v
  | _ + 2 => 0

@[simp]
theorem preprojectiveGradedKoszulDifferential_zero (v : Q) :
    preprojectiveGradedKoszulDifferential k v 0 = preprojectiveGradedKoszulRight k v := (rfl)

@[simp]
theorem preprojectiveGradedKoszulDifferential_one (v : Q) :
    preprojectiveGradedKoszulDifferential k v 1 = preprojectiveGradedKoszulLeft k v := (rfl)

@[simp]
theorem preprojectiveGradedKoszulDifferential_add_two (v : Q) (n : ℕ) :
    preprojectiveGradedKoszulDifferential k v (n + 2) = 0 := (rfl)

/-- If the left Koszul map is injective at the chosen vertex, the graded Koszul sequence
is exact at every positive homological degree. -/
theorem preprojectiveGradedKoszulDifferential_exact
    (v : Q) (hinj : Function.Injective (preprojectiveKoszulLeft k v)) (n : ℕ) :
    Function.Exact (preprojectiveGradedKoszulDifferential k v (n + 1)).hom
      (preprojectiveGradedKoszulDifferential k v n).hom := by
  rcases n with _ | (_ | n)
  · rw [LinearMap.exact_iff]
    simp only [preprojectiveGradedKoszulDifferential_zero, preprojectiveGradedKoszulRight_hom]
    exact (range_preprojectiveKoszulLeft_eq_ker_right k v).symm
  · rw [LinearMap.exact_iff]
    simp only [preprojectiveGradedKoszulDifferential_add_two, GradedModuleCat.hom_zero,
      LinearMap.range_zero]
    exact (LinearMap.ker_eq_bot).2 hinj
  · rw [LinearMap.exact_iff]
    simp only [preprojectiveGradedKoszulDifferential_add_two, GradedModuleCat.hom_zero,
      LinearMap.range_zero, LinearMap.ker_zero]
    exact Subsingleton.elim _ _

/-- If the left Koszul map is injective at the chosen vertex, the shifted Koszul complex
is a graded projective resolution of its vertex augmentation module, over the ordinary
opposite algebra.
This is an abbreviation so the types and module instances of its explicit terms can be used
without transporting along equalities. Its augmentation is computed by
`preprojectiveGradedKoszulResolution_π`. -/
noncomputable abbrev preprojectiveGradedKoszulResolution
    (v : Q) (hinj : Function.Injective (preprojectiveKoszulLeft k v)) :
    GradedProjectiveResolution 𝒜 (preprojectiveGradedVertexModule k v).grading where
  X n := preprojectiveGradedKoszulTerm k v n
  grading n := (preprojectiveGradedKoszulTerm k v n).grading
  projective n := by
    rcases n with _ | (_ | (_ | n))
    · exact inferInstanceAs (Module.Projective Πᵐᵒᵖ
        (preprojectiveRightProjective k (Symmetrify.of.obj v)))
    · exact inferInstanceAs (Module.Projective Πᵐᵒᵖ (preprojectiveKoszulMiddle k v))
    · exact inferInstanceAs (Module.Projective Πᵐᵒᵖ
        (preprojectiveRightProjective k (Symmetrify.of.obj v)))
    · infer_instance
  d n := (preprojectiveGradedKoszulDifferential k v n).hom
  «π» := preprojectiveVertexAugmentation k v
  isHomogeneous_d n := (preprojectiveGradedKoszulDifferential k v n).isHomogeneous
  isHomogeneous_π := by
    rw [← preprojectiveGradedVertexAugmentation_hom]
    exact (preprojectiveGradedVertexAugmentation k v).isHomogeneous
  surjective_π := preprojectiveVertexAugmentation_surjective k v
  exact_d_π := by
    rw [LinearMap.exact_iff, preprojectiveGradedKoszulDifferential_zero,
      preprojectiveGradedKoszulRight_hom, ker_preprojectiveVertexAugmentation]
  exact_d_d := preprojectiveGradedKoszulDifferential_exact k v hinj

/-- Each resolution term carries the grading of the corresponding shifted Koszul term. -/
@[simp]
theorem preprojectiveGradedKoszulResolution_grading
    (v : Q) (hinj : Function.Injective (preprojectiveKoszulLeft k v)) (n : ℕ) :
    (preprojectiveGradedKoszulResolution k v hinj).grading n =
      (preprojectiveGradedKoszulTerm k v n).grading := (rfl)

/-- The differentials of the resolution are the explicit graded Koszul maps. -/
@[simp]
theorem preprojectiveGradedKoszulResolution_d
    (v : Q) (hinj : Function.Injective (preprojectiveKoszulLeft k v)) (n : ℕ) :
    (preprojectiveGradedKoszulResolution k v hinj).d n =
      (preprojectiveGradedKoszulDifferential k v n).hom := (rfl)

/-- The augmentation of the resolution is the vertex augmentation. -/
@[simp]
theorem preprojectiveGradedKoszulResolution_π
    (v : Q) (hinj : Function.Injective (preprojectiveKoszulLeft k v)) :
    (preprojectiveGradedKoszulResolution k v hinj).π = preprojectiveVertexAugmentation k v := (rfl)

/-- The terms of the resolution are the shifted graded Koszul terms. -/
@[simp]
theorem preprojectiveGradedKoszulResolution_X
    (v : Q) (hinj : Function.Injective (preprojectiveKoszulLeft k v)) (n : ℕ) :
    (preprojectiveGradedKoszulResolution k v hinj).X n =
      preprojectiveGradedKoszulTerm k v n := (rfl)

/-- The graded Koszul resolution is linear: its term in homological degree `n` is generated
in internal degree `n`. The terms beyond degree two are zero. -/
theorem isLinear_preprojectiveGradedKoszulResolution
    (v : Q) (hinj : Function.Injective (preprojectiveKoszulLeft k v)) :
    (preprojectiveGradedKoszulResolution k v hinj).IsLinear := by
  rw [GradedProjectiveResolution.isLinear_iff]
  intro n
  rw [preprojectiveGradedKoszulResolution_grading]
  rcases n with _ | (_ | (_ | n))
  · exact isGeneratedInDegree_preprojectiveRightProjectiveGrading k _
  · simpa using isGeneratedInDegree_preprojectiveKoszulMiddleGrading k v
  · simpa using isGeneratedInDegree_preprojectiveRightProjectiveGrading k (Symmetrify.of.obj v)
  · apply InternalGrading.isGeneratedInDegree_of_piece_eq_top
    exact Subsingleton.elim _ _

/-- For a finite quiver without sinks, the graded Koszul resolution at every vertex is linear. -/
theorem isLinear_preprojectiveGradedKoszulResolution_of_no_sinks
    (hQ : ∀ u : Q, ∃ w, Nonempty (u ⟶ w)) (v : Q) :
    (preprojectiveGradedKoszulResolution k v
      (preprojectiveKoszulLeft_injective k hQ v)).IsLinear :=
  isLinear_preprojectiveGradedKoszulResolution k v (preprojectiveKoszulLeft_injective k hQ v)

end TauCeti
