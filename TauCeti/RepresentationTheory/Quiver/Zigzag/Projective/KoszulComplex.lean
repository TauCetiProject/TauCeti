/-!
# The Koszul complex of a zigzag simple module

Let `Z` be the zigzag relation quotient `TauCeti.nonisolatedZigzagQuotient` of a finite graph `G`
and let `Π` be the signless preprojective algebra of the doubled quiver of `G`, the quadratic dual
of the quadratic zigzag presentation (`TauCeti.quadraticDualQuadraticZigzagEquivSignless`). For a
vertex `v`, the Koszul complex of the simple `Z`-module at `v` has in homological degree `n` the
left `Z`-module

```text
K_n = ⨁_u Hom_k(e_u Π_n e_v, Z e_u),
```

the Hom form of `⨁_u Z e_u ⊗_k (e_u Π_n e_v)^*`, and the differential

```text
(d f)_w (y) = ∑_{j ∼ w} f_j (a_{wj} y) · a_{wj},
```

where `a_{wj}` is the arrow `w → j`, acting on the left of `Π` and on the right of `Z`. Composing
two differentials multiplies by a length-two zigzag path; only the returning paths survive, all
equal to the volume class, against the signless relator `∑_{j ∼ w} (w → j → w) = 0`. So `K` is a
complex.

The main theorem is the Koszul duality between `K` and the vertex Koszul complexes
`0 → e_w Π → ⨁_{j ∼ w} e_j Π → e_w Π` of `Π`. The vertex, arrow and volume coordinates of the
values of `f ∈ K_{n+1}` pair with the three terms of these complexes: the vertex coordinates of a
cycle vanish because `Π` is generated by its arrows, the arrow coordinates lift by exactness of the
signless complex at its middle term, and the volume coordinates lift by exactness at its left end.
Hence, if every signless vertex complex is exact at its left end, `K` is exact in every positive
homological degree. A non-backtracking choice of neighbours supplies this exactness, so the result
holds for every connected graph which is not a tree, and these graphs are never finite ADE Dynkin
diagrams. The augmentation of `K_0` onto the simple module and the internal grading of the terms
are not treated here.

## Main definitions

* `TauCeti.ZigzagKoszulTerm`: the term `K_n`.
* `TauCeti.zigzagKoszulDifferential`: the differential `K_{n+1} → K_n`.

## Main results

* `TauCeti.zigzagKoszulDifferential_comp_zigzagKoszulDifferential`: `d ∘ d = 0`.
* `TauCeti.range_zigzagKoszulDifferential_eq_ker`: exactness in positive homological degrees,
  given exactness of the signless vertex Koszul complexes at their left ends.
* `TauCeti.range_zigzagKoszulDifferential_eq_ker_of_adj` and
  `TauCeti.range_zigzagKoszulDifferential_eq_ker_of_not_isAcyclic`: exactness for a
  non-backtracking choice of neighbours, and for connected graphs which are not trees.

## References

* R. S. Huerfano and M. Khovanov, *A category for the adjoint representation*, J. Algebra 246
  (2001), Section 3, for the quadratic dual of the zigzag algebra.
* A. Beilinson, V. Ginzburg and W. Soergel, *Koszul duality patterns in representation theory*,
  J. Amer. Math. Soc. 9 (1996), Section 2, for the Koszul complex and the exactness of the Koszul
  complexes of a quadratic algebra and its dual.
* P. Etingof and C.-H. Eu, *Koszulity and the Hilbert series of preprojective algebras*, Math.
  Res. Lett. 14 (2007), Sections 2 and 3, for the vertex Koszul complexes of `Π`.
-/

public section

namespace TauCeti

open _root_.Quiver PathAlgebra DoubledQuiver

variable (k : Type*) [Field k] {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]

local notation "Z" => nonisolatedZigzagQuotient k G
local notation "Π" => signlessPreprojectiveAlgebra k (DoubledQuiver G)
local notation "σ" => signlessPreprojectiveMk k (DoubledQuiver G)
local notation "C" => signlessPreprojectiveCorner k (DoubledQuiver G)

/-- The term in homological degree `n` of the Koszul complex of the zigzag simple module at `v`:
the left module `⨁_u Hom_k(e_u Π_n e_v, Z e_u)` over the zigzag relation quotient `Z`, where `Π`
is the signless preprojective algebra of the doubled quiver, the quadratic dual of the quadratic
zigzag presentation (`TauCeti.quadraticDualQuadraticZigzagEquivSignless`). -/
abbrev ZigzagKoszulTerm (v : V) (n : ℕ) : Type _ :=
  ∀ u : V, C n (vertex G v) (vertex G u) →ₗ[k] zigzagProjective k G u

/-- Left multiplication by the signless arrow `w → j`, from `e_w Π_n e_v` to `e_j Π_{n+1} e_v`. -/
private noncomputable def cornerArrowMul (v : V) (n : ℕ) {w j : V} (h : G.Adj w j) :
    C n (vertex G v) (vertex G w) →ₗ[k] C (n + 1) (vertex G v) (vertex G j) :=
  (LinearMap.mulLeft k (σ (ofArrow (arrow G h)))).restrict fun _ hy =>
    signlessPreprojectiveMk_ofArrow_mul_mem_signlessPreprojectiveCorner _ hy

private theorem coe_cornerArrowMul_apply (v : V) (n : ℕ) {w j : V} (h : G.Adj w j)
    (y : C n (vertex G v) (vertex G w)) :
    (cornerArrowMul k G v n h y : Π) = σ (ofArrow (arrow G h)) * y :=
  (rfl)

/-- The summand of the Koszul differential along the arrow `w → j`: precompose with left
multiplication by the signless arrow and postcompose with right multiplication by the zigzag
arrow. -/
private noncomputable def koszulSummand (v : V) (n : ℕ) {w j : V} (h : G.Adj w j)
    (g : C (n + 1) (vertex G v) (vertex G j) →ₗ[k] zigzagProjective k G j) :
    C n (vertex G v) (vertex G w) →ₗ[k] zigzagProjective k G w :=
  ((zigzagProjectiveArrowMul k G ⟨(w, j), h⟩).restrictScalars k).comp
    (g.comp (cornerArrowMul k G v n h))

private theorem coe_koszulSummand_apply (v : V) (n : ℕ) {w j : V} (h : G.Adj w j)
    (g : C (n + 1) (vertex G v) (vertex G j) →ₗ[k] zigzagProjective k G j)
    (y : C n (vertex G v) (vertex G w)) :
    (koszulSummand k G v n h g y : Z) =
      (g (cornerArrowMul k G v n h y) : Z) * zigzagMk k G (ofArrow (arrow G h)) :=
  coe_zigzagProjectiveArrowMul_apply k G _ _

/-- **The Koszul differential** of the zigzag simple module at `v`, from homological degree
`n + 1` to `n`. At the vertex `w` it sends `f` to `y ↦ ∑_{j ∼ w} f_j (a_{wj} y) · a_{wj}`: the
signless arrow `w → j` moves `y ∈ e_w Π_n e_v` to `e_j Π_{n+1} e_v`, and right multiplication by
the zigzag arrow `w → j` moves the value from `Z e_j` back to `Z e_w`. -/
noncomputable def zigzagKoszulDifferential (v : V) (n : ℕ) :
    ZigzagKoszulTerm k G v (n + 1) →ₗ[Z] ZigzagKoszulTerm k G v n where
  toFun f w := ∑ j : G.neighborSet w, koszulSummand k G v n ((G.mem_neighborSet w j).1 j.2) (f j)
  map_add' f g := by
    funext w
    simp only [Pi.add_apply, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => LinearMap.ext fun y => ?_
    simp only [koszulSummand, LinearMap.add_comp, LinearMap.comp_add]
  map_smul' c f := by
    funext w
    simp only [Pi.smul_apply, RingHom.id_apply, Finset.smul_sum]
    refine Finset.sum_congr rfl fun j _ => LinearMap.ext fun y => ?_
    simp only [koszulSummand, LinearMap.comp_apply, LinearMap.smul_apply,
      LinearMap.restrictScalars_apply, map_smul]

/-- The value of the Koszul differential, computed in the zigzag algebra. -/
@[simp]
theorem coe_zigzagKoszulDifferential_apply (v : V) (n : ℕ) (f : ZigzagKoszulTerm k G v (n + 1))
    (w : V) (y : C n (vertex G v) (vertex G w)) :
    (zigzagKoszulDifferential k G v n f w y : Z) =
      ∑ j : G.neighborSet w,
        (f j ⟨σ (ofArrow (arrow G ((G.mem_neighborSet w j).1 j.2))) * y,
          signlessPreprojectiveMk_ofArrow_mul_mem_signlessPreprojectiveCorner _ y.2⟩ : Z) *
          zigzagMk k G (ofArrow (arrow G ((G.mem_neighborSet w j).1 j.2))) := by
  -- unfold the bundled map to the sum of its summands
  change ((∑ j : G.neighborSet w,
    koszulSummand k G v n ((G.mem_neighborSet w j).1 j.2) (f j)) y : Z) = _
  rw [LinearMap.sum_apply, Submodule.coe_sum]
  exact Finset.sum_congr rfl fun j _ => coe_koszulSummand_apply k G v n _ (f j) y

/-! ### The Koszul complex is a complex -/

omit [Fintype V] [DecidableRel G.Adj] in
/-- A zigzag arrow `w → j` followed by an arrow `j → l` with `l ≠ w` vanishes. -/
private theorem zigzagMk_arrow_mul_arrow_of_ne [Finite V] {w j l : V} (h : G.Adj w j)
    (h' : G.Adj j l) (hl : l ≠ w) :
    zigzagMk k G (ofArrow (arrow G h')) * zigzagMk k G (ofArrow (arrow G h)) = 0 :=
  zigzagMk_ofArrow_mul_ofArrow_of_ne k G (d := ⟨(j, l), h'⟩) (e := ⟨(w, j), h⟩) fun he =>
    hl (congrArg (fun d : G.Dart => d.fst) he).symm

omit [Fintype V] [DecidableRel G.Adj] in
/-- A zigzag arrow `w → j` followed by its reverse is the volume class at `w`. -/
private theorem zigzagMk_arrow_symm_mul_arrow [Finite V] {w j : V} (h : G.Adj w j) :
    zigzagMk k G (ofArrow (arrow G h.symm)) * zigzagMk k G (ofArrow (arrow G h)) =
      zigzagVolume k G w :=
  zigzagMk_ofArrow_mul_ofArrow_symm k G ⟨(j, w), h.symm⟩

/-- **The Koszul complex is a complex:** two consecutive Koszul differentials compose to zero. -/
@[simp]
theorem zigzagKoszulDifferential_comp_zigzagKoszulDifferential (v : V) (n : ℕ) :
    zigzagKoszulDifferential k G v n ∘ₗ zigzagKoszulDifferential k G v (n + 1) = 0 := by
  -- Composing two differentials multiplies by a length-two zigzag path: it vanishes unless the
  -- path returns, and the returning paths at `w` all give the volume class, multiplied by the
  -- image of the signless relator `∑_{j ∼ w} (w → j → w)`, which is zero.
  refine LinearMap.ext fun f => funext fun w => LinearMap.ext fun y => Subtype.ext ?_
  rw [LinearMap.comp_apply, coe_zigzagKoszulDifferential_apply, LinearMap.zero_apply,
    Pi.zero_apply, LinearMap.zero_apply, ZeroMemClass.coe_zero]
  -- Only the returning paths `w → j → w` survive, and they all give `x_w`.
  have hj (j : G.neighborSet w) :
      (zigzagKoszulDifferential k G v (n + 1) f j
          ⟨σ (ofArrow (arrow G ((G.mem_neighborSet w j).1 j.2))) * y,
            signlessPreprojectiveMk_ofArrow_mul_mem_signlessPreprojectiveCorner _ y.2⟩ : Z) *
          zigzagMk k G (ofArrow (arrow G ((G.mem_neighborSet w j).1 j.2))) =
        (f w ⟨σ (ofArrow (arrow G ((G.mem_neighborSet w j).1 j.2).symm)) *
            (σ (ofArrow (arrow G ((G.mem_neighborSet w j).1 j.2))) * y),
          signlessPreprojectiveMk_ofArrow_mul_mem_signlessPreprojectiveCorner _
            (signlessPreprojectiveMk_ofArrow_mul_mem_signlessPreprojectiveCorner _ y.2)⟩ : Z) *
          zigzagVolume k G w := by
    rw [coe_zigzagKoszulDifferential_apply, Finset.sum_mul,
      Finset.sum_eq_single ⟨w, (G.mem_neighborSet j w).2 ((G.mem_neighborSet w j).1 j.2).symm⟩]
    · rw [mul_assoc, zigzagMk_arrow_symm_mul_arrow]
    · intro l _ hl
      rw [mul_assoc, zigzagMk_arrow_mul_arrow_of_ne k G _ _ fun h => hl (Subtype.ext h),
        mul_zero]
    · exact fun h => absurd (Finset.mem_univ _) h
  simp_rw [hj]
  rw [← Finset.sum_mul, ← Submodule.coe_sum, ← map_sum]
  -- The arguments sum to the signless relator at `w` applied to `y`, which vanishes.
  have hrel : ∑ j : G.neighborSet w,
      (⟨σ (ofArrow (arrow G ((G.mem_neighborSet w j).1 j.2).symm)) *
          (σ (ofArrow (arrow G ((G.mem_neighborSet w j).1 j.2))) * y),
        signlessPreprojectiveMk_ofArrow_mul_mem_signlessPreprojectiveCorner _
          (signlessPreprojectiveMk_ofArrow_mul_mem_signlessPreprojectiveCorner _ y.2)⟩ :
        C (n + 2) (vertex G v) (vertex G w)) = 0 := by
    refine Subtype.ext ?_
    rw [Submodule.coe_sum, ZeroMemClass.coe_zero,
      ← sum_signlessPreprojectiveMk_ofArrow_mul_ofArrow_reverse_mul_eq_zero k (vertex G w)
        (y : Π), sum_sum_hom_eq_sum_neighborSet]
    simp only [reverse_arrow]
  rw [hrel, map_zero, ZeroMemClass.coe_zero, zero_mul]

/-- Two consecutive Koszul differentials compose to zero, pointwise. -/
@[simp]
theorem zigzagKoszulDifferential_zigzagKoszulDifferential (v : V) (n : ℕ)
    (f : ZigzagKoszulTerm k G v (n + 2)) :
    zigzagKoszulDifferential k G v n (zigzagKoszulDifferential k G v (n + 1) f) = 0 :=
  LinearMap.congr_fun (zigzagKoszulDifferential_comp_zigzagKoszulDifferential k G v n) f

/-! ### Coordinates in the vertex projectives -/

section Coordinates

variable {G} (hns : ∀ i : V, ∃ j, G.Adj i j)

/-- The vertex, arrow and volume basis of `Z e_u`, with the arrows indexed by the neighbours. -/
private noncomputable def projBasis (u : V) :
    Module.Basis (Unit ⊕ G.neighborSet u ⊕ Unit) k (zigzagProjective k G u) :=
  (zigzagProjectiveBasis k G hns u).reindex
    (Equiv.sumCongr (Equiv.refl _) (Equiv.sumCongr (G.dartFstEquivNeighborSet u) (Equiv.refl _)))

omit [DecidableRel G.Adj] in
private theorem coe_projBasis_inl (u : V) (a : Unit) :
    (projBasis k hns u (.inl a) : Z) = zigzagVertexIdempotent k G u := by
  simp [projBasis]

omit [DecidableRel G.Adj] in
private theorem coe_projBasis_inr_inl (u : V) (j : G.neighborSet u) :
    (projBasis k hns u (.inr (.inl j)) : Z) =
      zigzagMk k G (ofArrow (arrow G ((G.mem_neighborSet u j).1 j.2))) := by
  simp only [projBasis, Module.Basis.reindex_apply, zigzagProjectiveBasis_apply,
    Equiv.sumCongr_symm, Equiv.sumCongr_apply, Sum.map_inr, Sum.map_inl,
    coe_zigzagProjectiveBasisFun_inr_inl]
  rfl

omit [DecidableRel G.Adj] in
private theorem coe_projBasis_inr_inr (u : V) (a : Unit) :
    (projBasis k hns u (.inr (.inr a)) : Z) = zigzagVolume k G u := by
  simp [projBasis]

/-- The expansion of an element of `Z e_u` in the vertex, arrow and volume basis. -/
private theorem coe_eq_projBasis_repr (u : V) (z : zigzagProjective k G u) :
    (z : Z) = (projBasis k hns u).repr z (.inl ()) • zigzagVertexIdempotent k G u +
      ∑ j : G.neighborSet u, (projBasis k hns u).repr z (.inr (.inl j)) •
        zigzagMk k G (ofArrow (arrow G ((G.mem_neighborSet u j).1 j.2))) +
      (projBasis k hns u).repr z (.inr (.inr ())) • zigzagVolume k G u := by
  conv_lhs => rw [← (projBasis k hns u).sum_repr z]
  simp only [Submodule.coe_add, Submodule.coe_sum, Submodule.coe_smul_of_tower,
    Fintype.sum_sum_type,
    Finset.univ_unique, Finset.sum_singleton, coe_projBasis_inl, coe_projBasis_inr_inl,
    coe_projBasis_inr_inr, add_assoc]

/-- Reading the coordinates of an element of `Z e_u` off an expansion in the zigzag algebra. -/
private theorem projBasis_repr_eq_of_coe_eq (u : V) (z : zigzagProjective k G u) (a c : k)
    (α : G.neighborSet u → k)
    (h : (z : Z) = a • zigzagVertexIdempotent k G u +
      ∑ j : G.neighborSet u,
        α j • zigzagMk k G (ofArrow (arrow G ((G.mem_neighborSet u j).1 j.2))) +
      c • zigzagVolume k G u) :
    ⇑((projBasis k hns u).repr z) = Sum.elim (fun _ => a) (Sum.elim α fun _ => c) := by
  have hz : z = ∑ β, Sum.elim (fun _ => a) (Sum.elim α fun _ => c) β • projBasis k hns u β := by
    refine Subtype.ext ?_
    simp only [h, Submodule.coe_add, Submodule.coe_sum, Submodule.coe_smul_of_tower,
      Fintype.sum_sum_type,
      Finset.univ_unique, Finset.sum_singleton, Sum.elim_inl, Sum.elim_inr, coe_projBasis_inl,
      coe_projBasis_inr_inl, coe_projBasis_inr_inr, add_assoc]
  rw [hz, Module.Basis.repr_sum_self]

omit [DecidableRel G.Adj] in
/-- Right multiplication of `z ∈ Z e_j` by the zigzag arrow `w → j`: only the vertex coordinate
and the coordinate of the reverse arrow `j → w` of `z` survive. -/
private theorem coe_mul_zigzagMk_arrow {w j : V} (h : G.Adj w j) (z : zigzagProjective k G j) :
    (z : Z) * zigzagMk k G (ofArrow (arrow G h)) =
      (projBasis k hns j).repr z (.inl ()) • zigzagMk k G (ofArrow (arrow G h)) +
        (projBasis k hns j).repr z (.inr (.inl ⟨w, (G.mem_neighborSet j w).2 h.symm⟩)) •
          zigzagVolume k G w := by
  classical
  rw [coe_eq_projBasis_repr k hns j z, add_mul, add_mul, Finset.sum_mul, smul_mul_assoc,
    smul_mul_assoc, zigzagVolume_mul_zigzagMk_ofArrow k G j ⟨(w, j), h⟩, smul_zero, add_zero,
    zigzagVertexIdempotent, zigzagMk_vertexIdempotent_mul_ofArrow k G ⟨(w, j), h⟩,
    Finset.sum_eq_single ⟨w, (G.mem_neighborSet j w).2 h.symm⟩]
  · rw [smul_mul_assoc, zigzagMk_arrow_symm_mul_arrow]
  · intro l _ hl
    rw [smul_mul_assoc, zigzagMk_arrow_mul_arrow_of_ne k G _ _ fun h => hl (Subtype.ext h),
      smul_zero]
  · exact fun h => absurd (Finset.mem_univ _) h

/-- **The coordinates of the Koszul differential.** The value of `d f` at `y ∈ e_w Π_n e_v` has no
vertex coordinate; its coordinate along the arrow `w → j` is the vertex coordinate of
`f_j (a_{wj} y)`, and its volume coordinate is the sum over `j ∼ w` of the coordinates of
`f_j (a_{wj} y)` along the reverse arrows `j → w`. -/
private theorem projBasis_repr_zigzagKoszulDifferential (v : V) (n : ℕ)
    (f : ZigzagKoszulTerm k G v (n + 1)) (w : V) (y : C n (vertex G v) (vertex G w)) :
    ⇑((projBasis k hns w).repr (zigzagKoszulDifferential k G v n f w y)) =
      Sum.elim (fun _ => 0) (Sum.elim
        (fun j : G.neighborSet w => (projBasis k hns j).repr (f j (cornerArrowMul k G v n
          ((G.mem_neighborSet w j).1 j.2) y)) (.inl ()))
        fun _ => ∑ j : G.neighborSet w, (projBasis k hns j).repr
          (f j (cornerArrowMul k G v n ((G.mem_neighborSet w j).1 j.2) y))
            (.inr (.inl ⟨w, (G.mem_neighborSet j w).2 ((G.mem_neighborSet w j).1 j.2).symm⟩))) := by
  refine projBasis_repr_eq_of_coe_eq k hns w _ _ _ _ ?_
  rw [coe_zigzagKoszulDifferential_apply, zero_smul, zero_add, Finset.sum_smul,
    ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun j _ => coe_mul_zigzagMk_arrow k hns _ _

end Coordinates

/-! ### The signless Koszul complex, indexed by neighbours -/

section Neighbours

variable {k G}

/-- Last-arrow decomposition in `e_u Π_{n+1} e_v`, indexed by the neighbours of `u`. -/
private theorem exists_eq_sum_neighborSet {v u : V} {n : ℕ} {t : Π}
    (ht : t ∈ C (n + 1) (vertex G v) (vertex G u)) :
    ∃ z : G.neighborSet u → Π, (∀ l : G.neighborSet u, z l ∈ C n (vertex G v) (vertex G l)) ∧
      t = ∑ l : G.neighborSet u,
        σ (ofArrow (arrow G ((G.mem_neighborSet u l).1 l.2).symm)) * z l := by
  obtain ⟨z, hz, rfl⟩ := exists_eq_sum_signlessPreprojectiveMk_ofArrow_mul ht
  exact ⟨fun l => z (vertex G l) (arrow G _), fun l => hz _ _,
    sum_sum_hom_eq_sum_neighborSet G u fun i b => σ (ofArrow b) * z i b⟩

/-- Graded middle exactness of the signless Koszul complex at `u`, indexed by the neighbours. -/
private theorem exists_of_sum_neighborSet_eq_zero {v u : V} {n : ℕ} (z : G.neighborSet u → Π)
    (hz : ∀ l : G.neighborSet u, z l ∈ C n (vertex G v) (vertex G l))
    (h : ∑ l : G.neighborSet u,
      σ (ofArrow (arrow G ((G.mem_neighborSet u l).1 l.2).symm)) * z l = 0) :
    ∃ y ∈ C (n - 1) (vertex G v) (vertex G u),
      ∀ l : G.neighborSet u, z l = σ (ofArrow (arrow G ((G.mem_neighborSet u l).1 l.2))) * y := by
  -- Re-index the family by the arrows of the doubled quiver into `u`.
  let z' : ∀ i : DoubledQuiver G, (i ⟶ vertex G u) → Π := fun i b =>
    z ⟨(vertexEquiv G).symm i, (G.mem_neighborSet _ _).2 (by simpa using b.down.symm)⟩
  have hz'l (l : G.neighborSet u) (b : vertex G l ⟶ vertex G u) : z' (vertex G l) b = z l :=
    congrArg z (Subtype.ext (vertexEquiv_symm_vertex G l))
  have hz' (i : DoubledQuiver G) (b : i ⟶ vertex G u) : z' i b ∈ C n (vertex G v) i := by
    obtain ⟨l, rfl⟩ := exists_eq_vertex G i
    have hl : G.Adj u l := by simpa using b.down.symm
    rw [hz'l ⟨l, (G.mem_neighborSet u l).2 hl⟩ b]
    exact hz ⟨l, (G.mem_neighborSet u l).2 hl⟩
  obtain ⟨y, hy, hyz⟩ := exists_mem_signlessPreprojectiveCorner_of_sum_ofArrow_mul_eq_zero hz' (by
    rw [sum_sum_hom_eq_sum_neighborSet G u fun i b => σ (ofArrow b) * z' i b]
    simpa only [hz'l] using h)
  refine ⟨y, hy, fun l => ?_⟩
  have hl := hyz (vertex G l) (arrow G ((G.mem_neighborSet u l).1 l.2).symm)
  rwa [hz'l l (arrow G ((G.mem_neighborSet u l).1 l.2).symm), reverse_arrow] at hl

/-- Exactness of the signless Koszul complex at its left end, indexed by the neighbours. -/
private theorem eq_zero_of_forall_arrow_mul_eq_zero
    (hinj : ∀ (w : V) (y : Π), σ (vertexIdempotent k (vertex G w)) * y = y →
      (∀ (i : DoubledQuiver G) (b : i ⟶ vertex G w), σ (ofArrow (reverse b)) * y = 0) → y = 0)
    {w : V} {y : Π} (hy : σ (vertexIdempotent k (vertex G w)) * y = y)
    (h : ∀ j : G.neighborSet w, σ (ofArrow (arrow G ((G.mem_neighborSet w j).1 j.2))) * y = 0) :
    y = 0 :=
  hinj w y hy fun i b => by
    obtain ⟨l, rfl⟩ := exists_eq_vertex G i
    have hl : G.Adj w l := by simpa using b.down.symm
    rw [Subsingleton.elim (reverse b) (arrow G hl)]
    exact h ⟨l, (G.mem_neighborSet w l).2 hl⟩

end Neighbours

/-! ### Exactness -/

section Exactness

variable {k G} (hns : ∀ i : V, ∃ j, G.Adj i j) {v : V} {n : ℕ}
  {f : ZigzagKoszulTerm k G v (n + 1)}

include hns in
/-- On a cycle `f` of the Koszul complex, `f_j (a_{wj} y)` has no vertex coordinate. -/
private theorem projBasis_repr_inl_of_mem_ker (hf : zigzagKoszulDifferential k G v n f = 0)
    {w : V} (j : G.neighborSet w) (y : C n (vertex G v) (vertex G w)) :
    (projBasis k hns j).repr (f j (cornerArrowMul k G v n ((G.mem_neighborSet w j).1 j.2) y))
      (.inl ()) = 0 := by
  have h := congrFun (projBasis_repr_zigzagKoszulDifferential k hns v n f w y) (.inr (.inl j))
  rwa [hf, Pi.zero_apply, LinearMap.zero_apply, map_zero, Finsupp.coe_zero, Pi.zero_apply,
    Sum.elim_inr, Sum.elim_inl, eq_comm] at h

include hns in
/-- On a cycle `f` of the Koszul complex, the coordinates of the `f_j (a_{wj} y)` along the
reverse arrows `j → w` sum to zero. -/
private theorem sum_projBasis_repr_inr_of_mem_ker (hf : zigzagKoszulDifferential k G v n f = 0)
    (w : V) (y : C n (vertex G v) (vertex G w)) :
    ∑ j : G.neighborSet w, (projBasis k hns j).repr
      (f j (cornerArrowMul k G v n ((G.mem_neighborSet w j).1 j.2) y))
        (.inr (.inl ⟨w, (G.mem_neighborSet j w).2 ((G.mem_neighborSet w j).1 j.2).symm⟩)) = 0 := by
  have h := congrFun (projBasis_repr_zigzagKoszulDifferential k hns v n f w y) (.inr (.inr ()))
  rwa [hf, Pi.zero_apply, LinearMap.zero_apply, map_zero, Finsupp.coe_zero, Pi.zero_apply,
    Sum.elim_inr, Sum.elim_inr, eq_comm] at h

include hns in
/-- **Step 1.** On a cycle `f`, the values of `f` have no vertex coordinate, since every element
of `e_u Π_{n+1} e_v` is a sum of arrows times elements of degree `n`. -/
private theorem projBasis_repr_inl_eq_zero (hf : zigzagKoszulDifferential k G v n f = 0) (u : V)
    (t : C (n + 1) (vertex G v) (vertex G u)) :
    (projBasis k hns u).repr (f u t) (.inl ()) = 0 := by
  obtain ⟨z, hz, ht⟩ := exists_eq_sum_neighborSet t.2
  have ht' : t = ∑ l : G.neighborSet u,
      cornerArrowMul k G v n ((G.mem_neighborSet u l).1 l.2).symm ⟨z l, hz l⟩ :=
    Subtype.ext (by rw [ht, Submodule.coe_sum]; rfl)
  rw [ht', map_sum, map_sum, Finsupp.coe_finsetSum, Finset.sum_apply]
  exact Finset.sum_eq_zero fun l _ => projBasis_repr_inl_of_mem_ker hns hf
    ⟨u, (G.mem_neighborSet l u).2 ((G.mem_neighborSet u l).1 l.2).symm⟩ ⟨z l, hz l⟩

/-- Left multiplication by the arrows into `u`, as a map out of the direct sum of the graded
corners at the neighbours of `u`. -/
private noncomputable def incomingArrowSum [DecidableEq V] (v : V) (n : ℕ) (u : V) :
    (∀ l : G.neighborSet u, C n (vertex G v) (vertex G l)) →ₗ[k]
      C (n + 1) (vertex G v) (vertex G u) :=
  LinearMap.lsum k _ k fun l => cornerArrowMul k G v n ((G.mem_neighborSet u l).1 l.2).symm

private theorem coe_incomingArrowSum_apply [DecidableEq V] (v : V) (n : ℕ) (u : V)
    (z : ∀ l : G.neighborSet u, C n (vertex G v) (vertex G l)) :
    (incomingArrowSum v n u z : Π) = ∑ l : G.neighborSet u,
      σ (ofArrow (arrow G ((G.mem_neighborSet u l).1 l.2).symm)) * z l := by
  simp only [incomingArrowSum, LinearMap.lsum_apply, LinearMap.sum_apply, LinearMap.comp_apply,
    LinearMap.proj_apply, Submodule.coe_sum, coe_cornerArrowMul_apply]

/-- The arrow coordinates of a would-be lift of `f` at `u`, as a functional on the direct sum of
the graded corners at the neighbours of `u`. -/
private noncomputable def arrowCoordSum [DecidableEq V] (f : ZigzagKoszulTerm k G v (n + 1))
    (u : V) :
    (∀ l : G.neighborSet u, C (n + 1) (vertex G v) (vertex G l)) →ₗ[k] k :=
  LinearMap.lsum k _ k fun l => (projBasis k hns l).coord
    (.inr (.inl ⟨u, (G.mem_neighborSet l u).2 ((G.mem_neighborSet u l).1 l.2).symm⟩)) ∘ₗ f l

private theorem arrowCoordSum_apply [DecidableEq V] (u : V)
    (z : ∀ l : G.neighborSet u, C (n + 1) (vertex G v) (vertex G l)) :
    arrowCoordSum hns f u z = ∑ l : G.neighborSet u, (projBasis k hns l).repr (f l (z l))
      (.inr (.inl ⟨u, (G.mem_neighborSet l u).2 ((G.mem_neighborSet u l).1 l.2).symm⟩)) := by
  simp only [arrowCoordSum, LinearMap.lsum_apply, LinearMap.sum_apply, LinearMap.comp_apply,
    LinearMap.proj_apply, Module.Basis.coord_apply]

/-- **Step 2.** On a cycle `f`, the arrow coordinates of `f` along the arrows into `u` factor
through the multiplication `⨁_{l ∼ u} e_l Π_{n+1} e_v → e_u Π_{n+2} e_v`, by exactness of the
signless Koszul complex at its middle term. -/
private theorem exists_arrowLift (hf : zigzagKoszulDifferential k G v n f = 0) (u : V) :
    ∃ ψ : C (n + 2) (vertex G v) (vertex G u) →ₗ[k] k,
      ∀ (l : G.neighborSet u) (z : C (n + 1) (vertex G v) (vertex G l)),
        ψ (cornerArrowMul k G v (n + 1) ((G.mem_neighborSet u l).1 l.2).symm z) =
          (projBasis k hns l).repr (f l z)
            (.inr (.inl ⟨u, (G.mem_neighborSet l u).2 ((G.mem_neighborSet u l).1 l.2).symm⟩)) := by
  classical
  have hM : Function.Surjective (incomingArrowSum (k := k) (G := G) v (n + 1) u) := fun t => by
    obtain ⟨z, hz, ht⟩ := exists_eq_sum_neighborSet t.2
    exact ⟨fun l => ⟨z l, hz l⟩, Subtype.ext (by rw [coe_incomingArrowSum_apply, ht])⟩
  have hker (z : ∀ l : G.neighborSet u, C (n + 1) (vertex G v) (vertex G l))
      (hz : incomingArrowSum v (n + 1) u z = 0) : arrowCoordSum hns f u z = 0 := by
    obtain ⟨y, hy, hyz⟩ := exists_of_sum_neighborSet_eq_zero (fun l => (z l : Π))
      (fun l => (z l).2) (by rw [← coe_incomingArrowSum_apply, hz, ZeroMemClass.coe_zero])
    have hzl (l : G.neighborSet u) :
        z l = cornerArrowMul k G v n ((G.mem_neighborSet u l).1 l.2) ⟨y, hy⟩ :=
      Subtype.ext (hyz l)
    simp only [arrowCoordSum_apply, hzl]
    exact sum_projBasis_repr_inr_of_mem_ker hns hf u ⟨y, hy⟩
  refine ⟨(incomingArrowSum v (n + 1) u).liftOfSurjective hM
    ⟨arrowCoordSum hns f u, fun z hz =>
      LinearMap.mem_ker.2 (hker z (LinearMap.mem_ker.1 hz))⟩, fun l z => ?_⟩
  have hl : incomingArrowSum v (n + 1) u (Pi.single l z) =
      cornerArrowMul k G v (n + 1) ((G.mem_neighborSet u l).1 l.2).symm z :=
    by rw [incomingArrowSum, LinearMap.lsum_piSingle]
  rw [← hl, LinearMap.equivOfSurjective_apply, arrowCoordSum, LinearMap.lsum_piSingle,
    LinearMap.comp_apply, Module.Basis.coord_apply]

/-- Left multiplication by the arrows out of `w`, as a map into the direct sum of the graded
corners at the neighbours of `w`. -/
private noncomputable def outgoingArrows (v : V) (n : ℕ) (w : V) :
    C n (vertex G v) (vertex G w) →ₗ[k]
      ∀ j : G.neighborSet w, C (n + 1) (vertex G v) (vertex G j) :=
  LinearMap.pi fun j => cornerArrowMul k G v n ((G.mem_neighborSet w j).1 j.2)

/-- **Step 3.** The volume coordinate of `f` at `w` extends along the map
`e_w Π_{n+1} e_v → ⨁_{j ∼ w} e_j Π_{n+2} e_v`, which is injective when the signless Koszul
complex is exact at its left end. -/
private theorem exists_volumeLift
    (hinj : ∀ (w : V) (y : Π), σ (vertexIdempotent k (vertex G w)) * y = y →
      (∀ (i : DoubledQuiver G) (b : i ⟶ vertex G w), σ (ofArrow (reverse b)) * y = 0) → y = 0)
    (f : ZigzagKoszulTerm k G v (n + 1)) (w : V) :
    ∃ Ξ : (∀ j : G.neighborSet w, C (n + 2) (vertex G v) (vertex G j)) →ₗ[k] k,
      ∀ z : C (n + 1) (vertex G v) (vertex G w),
        Ξ (outgoingArrows v (n + 1) w z) = (projBasis k hns w).repr (f w z) (.inr (.inr ())) := by
  obtain ⟨g, hg⟩ := (outgoingArrows (k := k) (G := G) v (n + 1) w).exists_leftInverse_of_injective
    (LinearMap.ker_eq_bot'.2 fun z hz => Subtype.ext (eq_zero_of_forall_arrow_mul_eq_zero hinj
      (signlessPreprojectiveMk_vertexIdempotent_mul_of_mem_signlessPreprojectiveCorner z.2)
      fun j => congrArg Subtype.val (congrFun hz j)))
  refine ⟨(projBasis k hns w).coord (.inr (.inr ())) ∘ₗ f w ∘ₗ g, fun z => ?_⟩
  rw [LinearMap.comp_apply, LinearMap.comp_apply, ← LinearMap.comp_apply g, hg,
    LinearMap.id_apply, Module.Basis.coord_apply]

variable [DecidableEq V]

/-- The lift of a cycle, specified by its coordinates: at `u`, the vertex coordinate is `ψ_u`,
the coordinate along the arrow `u → l` is `Ξ_l` on the summand of `u`, and the volume coordinate
vanishes. -/
private noncomputable def koszulLift (ψ : ∀ u : V, C (n + 2) (vertex G v) (vertex G u) →ₗ[k] k)
    (Ξ : ∀ w : V, (∀ j : G.neighborSet w, C (n + 2) (vertex G v) (vertex G j)) →ₗ[k] k) :
    ZigzagKoszulTerm k G v (n + 2) := fun u =>
  (projBasis k hns u).equivFun.symm.toLinearMap ∘ₗ LinearMap.pi (Sum.elim (fun _ => ψ u)
    (Sum.elim (fun l : G.neighborSet u => Ξ l ∘ₗ
      LinearMap.single k (fun j : G.neighborSet l => C (n + 2) (vertex G v) (vertex G j))
        ⟨u, (G.mem_neighborSet l u).2 ((G.mem_neighborSet u l).1 l.2).symm⟩) fun _ => 0))

private theorem projBasis_repr_koszulLift
    (ψ : ∀ u : V, C (n + 2) (vertex G v) (vertex G u) →ₗ[k] k)
    (Ξ : ∀ w : V, (∀ j : G.neighborSet w, C (n + 2) (vertex G v) (vertex G j)) →ₗ[k] k)
    (u : V) (t : C (n + 2) (vertex G v) (vertex G u)) :
    ⇑((projBasis k hns u).repr (koszulLift hns ψ Ξ u t)) = Sum.elim (fun _ => ψ u t)
      (Sum.elim (fun l : G.neighborSet u => Ξ l (Pi.single
        ⟨u, (G.mem_neighborSet l u).2 ((G.mem_neighborSet u l).1 l.2).symm⟩ t)) fun _ => 0) := by
  rw [← Module.Basis.equivFun_apply, koszulLift, LinearMap.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.apply_symm_apply]
  funext β
  rcases β with _ | l | _ <;> rfl

end Exactness

/-- Exactness of the signless Koszul complex at its left end forces every vertex to have a
neighbour: at an isolated vertex `w` the condition would kill the nonzero idempotent `e_w`. -/
private theorem exists_adj_of_forall_eq_zero
    (hinj : ∀ (w : V) (y : Π), σ (vertexIdempotent k (vertex G w)) * y = y →
      (∀ (i : DoubledQuiver G) (b : i ⟶ vertex G w), σ (ofArrow (reverse b)) * y = 0) → y = 0)
    (w : V) : ∃ j, G.Adj w j := by
  classical
  by_contra hw
  have he := hinj w _ (by rw [← map_mul, vertexIdempotent_mul_self]) fun i b => by
    obtain ⟨j, rfl⟩ := exists_eq_vertex G i
    exact absurd ⟨j, by simpa using b.down.symm⟩ hw
  have h1 := congrFun (congrArg (signlessPreprojectiveAugmentation k) he) (vertex G w)
  rw [signlessPreprojectiveAugmentation_mk, trivialCoeff_vertexIdempotent, map_zero,
    Pi.zero_apply, Pi.single_eq_same] at h1
  exact one_ne_zero h1

/-- **Koszul duality for the zigzag Koszul complex.** Let `G` be a finite graph. If the Koszul
complex `0 → e_w Π → ⨁_{j ∼ w} e_j Π` of the signless preprojective
algebra `Π` is exact at its left end at every vertex `w`, then the Koszul complex of every zigzag
simple module is exact in every positive homological degree: the image of the differential out of
degree `n + 2` is the kernel of the differential out of degree `n + 1`. -/
theorem range_zigzagKoszulDifferential_eq_ker
    (hinj : ∀ (w : V) (y : Π), σ (vertexIdempotent k (vertex G w)) * y = y →
      (∀ (i : DoubledQuiver G) (b : i ⟶ vertex G w), σ (ofArrow (reverse b)) * y = 0) → y = 0)
    (v : V) (n : ℕ) :
    LinearMap.range (zigzagKoszulDifferential k G v (n + 1)) =
      LinearMap.ker (zigzagKoszulDifferential k G v n) := by
  -- The three coordinates of a zigzag projective match the three terms of the signless Koszul
  -- complex: vertex coordinates vanish on cycles because `Π` is generated by its arrows, arrow
  -- coordinates lift by the exactness of the signless complex at its middle term, and volume
  -- coordinates lift by its exactness at its left end.
  classical
  refine le_antisymm (LinearMap.range_le_ker_iff.2
    (zigzagKoszulDifferential_comp_zigzagKoszulDifferential k G v n)) fun f hf => ?_
  rw [LinearMap.mem_ker] at hf
  have hns := exists_adj_of_forall_eq_zero k G hinj
  choose ψ hψ using exists_arrowLift hns hf
  choose Ξ hΞ using exists_volumeLift hns hinj f
  refine ⟨koszulLift hns ψ Ξ, funext fun w => LinearMap.ext fun z =>
    (projBasis k hns w).ext_elem fun β => ?_⟩
  rw [projBasis_repr_zigzagKoszulDifferential]
  rcases β with ⟨⟩ | j | ⟨⟩
  · exact (projBasis_repr_inl_eq_zero hns hf w z).symm
  · rw [Sum.elim_inr, Sum.elim_inl, projBasis_repr_koszulLift, Sum.elim_inl]
    exact hψ j ⟨w, (G.mem_neighborSet j w).2 ((G.mem_neighborSet w j).1 j.2).symm⟩ z
  · simp only [Sum.elim_inr, projBasis_repr_koszulLift, Sum.elim_inl]
    refine (map_sum (Ξ w) (fun j : G.neighborSet w => Pi.single j (cornerArrowMul k G v (n + 1)
      ((G.mem_neighborSet w j).1 j.2) z)) Finset.univ).symm.trans ?_
    rw [Finset.univ_sum_single]
    exact hΞ w z

/-- **The zigzag Koszul complex is exact for a non-backtracking choice of neighbours.** If `f`
sends every vertex of `G` to a neighbour, with `f (f u) ≠ u` for every `u`, then the Koszul complex
of every zigzag simple module of `G` is exact in every positive homological degree. Such an `f`
exists exactly when every connected component of `G` contains a cycle. -/
theorem range_zigzagKoszulDifferential_eq_ker_of_adj {f : V → V} (hf : ∀ u, G.Adj u (f u))
    (hff : ∀ u, f (f u) ≠ u) (v : V) (n : ℕ) :
    LinearMap.range (zigzagKoszulDifferential k G v (n + 1)) =
      LinearMap.ker (zigzagKoszulDifferential k G v n) :=
  range_zigzagKoszulDifferential_eq_ker k G (fun w _ hy h =>
    (forall_signlessPreprojectiveMk_ofArrow_reverse_mul_eq_zero_iff_of_adj k hf hff w hy).1 h) v n

/-- **The zigzag Koszul complex of a connected graph which is not a tree is exact** in every
positive homological degree, at every vertex. Such a graph is never a finite ADE Dynkin
diagram. -/
theorem range_zigzagKoszulDifferential_eq_ker_of_not_isAcyclic (hG : G.Preconnected)
    (hc : ¬G.IsAcyclic) (v : V) (n : ℕ) :
    LinearMap.range (zigzagKoszulDifferential k G v (n + 1)) =
      LinearMap.ker (zigzagKoszulDifferential k G v n) := by
  obtain ⟨f, hf⟩ := hG.exists_forall_adj_and_apply_apply_ne_of_not_isAcyclic hc
  exact range_zigzagKoszulDifferential_eq_ker_of_adj k G (fun u => (hf u).1) (fun u => (hf u).2)
    v n

end TauCeti
