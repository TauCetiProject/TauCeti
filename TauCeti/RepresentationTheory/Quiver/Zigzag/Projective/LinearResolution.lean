/-!
# Linear resolutions over a zigzag algebra

Let `Z` be the zigzag relation quotient of a finite simple graph `G` without isolated vertices,
graded by path length, with vertex idempotents `e_u`, arrows `a_d` and volume classes `x_u`.

## Graded projectives generated in one degree

Let `P` be a graded `Z`-module whose underlying module is projective and which is generated by
its homogeneous piece `P_n`. Then `P` is determined degreewise by the vertex parts `e_u • P_n`:

```text
e_u • P_n ≅ e_u • P_{n+2},                 x ↦ x_u • x,
⨁_{w ∼ u} e_w • P_n ≅ e_u • P_{n+1},         (x_w)_w ↦ ∑_w a_{w → u} • x_w,
```

and `P` vanishes in all other degrees. The maps are onto because `Z` is spanned by idempotents,
arrows and volume classes. The volume map is injective because `P` is a direct summand of a free
module: an element `x` of `e_u • P_n` with `x_u • x = 0` has all its coefficients in the radical,
so it lies in `Z₊ P`, which has no component in the lowest degree `n`. Multiplying by reverse
arrows reduces the injectivity of the arrow map to that of the volume maps.

## Linear resolutions

Let `M` be a finite-dimensional graded `Z`-module concentrated in degree `0`, and let
`⋯ ⟶ X₁ ⟶ X₀ ⟶ M` be a linear graded projective resolution, so `X_n` is generated in degree `n`.
Write `m_n(u) = dim_k (e_u • (X_n)_n)`, the multiplicity of the shifted projective `P_u{n}` in
`X_n`. In internal degree `p` only `X_p`, `X_{p-1}` and `X_{p-2}` are nonzero, so the resolution
restricts to short exact sequences `0 ⟶ e_u (X_p)_p ⟶ e_u (X_{p-1})_p ⟶ e_u (X_{p-2})_p ⟶ 0`.
Counting dimensions with the description above gives the recursion

```text
m_{p+2}(u) + m_p(u) = ∑_{w ∼ u} m_{p+1}(w),     m_1(u) = ∑_{w ∼ u} m_0(w),     m_0(u) = dim e_u M,
```

that is, `C_G(-X) m(X) = dim M` for the graded Cartan matrix `C_G(q) = (1 + q²) I + q A_G`
(`TauCeti.zigzagGradedCartanMatrix_map_aeval_neg_X_mulVec_eq`). For the graded simple module
`S_v` this says that the multiplicities of any linear resolution of `S_v` are the entries of the
column `v` of `C_G(-X)⁻¹` (`TauCeti.coeff_inv_zigzagGradedCartanMatrix_map_aeval_neg_X_eq`). In
particular, if `S_v` has a linear resolution then every coefficient in that column is
nonnegative: nonnegativity of `C_G(-X)⁻¹` is a necessary condition for the zigzag algebra to be
Koszul.

## Main results

* `TauCeti.finrank_zigzagVertexIdempotent_smul_piece_add_two` and
  `TauCeti.finrank_zigzagVertexIdempotent_smul_piece_add_one`: the vertex parts of a graded
  projective generated in degree `n`, in degrees `n + 2` and `n + 1`.
* `TauCeti.finrank_zigzagVertexIdempotent_smul_piece_zero_of_isLinear`,
  `TauCeti.finrank_zigzagVertexIdempotent_smul_piece_one_of_isLinear` and
  `TauCeti.finrank_zigzagVertexIdempotent_smul_piece_add_two_add_finrank_of_isLinear`: the
  initial values and the recursion of the multiplicities of a linear resolution.
* `TauCeti.zigzagGradedCartanMatrix_map_aeval_neg_X_mulVec_eq`: their matrix form
  `C_G(-X) m(X) = dim M`.
* `TauCeti.coeff_inv_zigzagGradedCartanMatrix_map_aeval_neg_X_eq` and
  `TauCeti.coeff_inv_zigzagGradedCartanMatrix_map_aeval_neg_X_nonneg`: the multiplicities of a
  linear resolution of `S_v` are the coefficients of the column `v` of `C_G(-X)⁻¹`, which are
  therefore nonnegative.

## References

* A. Beilinson, V. Ginzburg and W. Soergel, *Koszul duality patterns in representation theory*,
  J. Amer. Math. Soc. 9 (1996), Sections 1.2 and 2.11, for linear resolutions and the relation
  between Koszulity and inverse Hilbert series.
* R. S. Huerfano and M. Khovanov, *A category for the adjoint representation*, J. Algebra 246
  (2001), Section 3, for the projective modules of zigzag algebras and their graded Cartan matrix.
-/

public section

namespace TauCeti

open PathAlgebra DoubledQuiver
open scoped Pointwise

universe u v w

variable {k : Type w} [Field k] {V : Type u} {G : SimpleGraph V} [Finite V]

attribute [local instance] zigzagIntegerGradedAlgebra

variable (hns : ∀ i : V, ∃ j, G.Adj i j)
include hns

/-- The radical, spanned by the arrows and volume classes, lies in positive degree. -/
private theorem zigzagPositiveSpan_le_iSup :
    zigzagPositiveSpan k G ≤ ⨆ (i : ℤ) (_ : 0 < i), zigzagIntegerGrade k G i := by
  intro x hx
  rw [mem_zigzagPositiveSpan_iff hns] at hx
  rw [← (zigzagBasis k G hns).linearCombination_repr x, Finsupp.linearCombination_apply,
    Finsupp.sum]
  refine Submodule.sum_mem _ fun b _ => ?_
  rcases b with i | d | i
  · rw [hx i, zero_smul]
    exact Submodule.zero_mem _
  · rw [zigzagBasis_apply, zigzagBasisFun_inr_inl]
    exact Submodule.smul_mem _ _ (le_iSup₂ (f := fun (i : ℤ) (_ : 0 < i) =>
      zigzagIntegerGrade k G i) 1 one_pos (zigzagMk_ofArrow_mem_zigzagIntegerGrade_one k G d))
  · rw [zigzagBasis_apply, zigzagBasisFun_inr_inr]
    exact Submodule.smul_mem _ _ (le_iSup₂ (f := fun (i : ℤ) (_ : 0 < i) =>
      zigzagIntegerGrade k G i) 2 two_pos (zigzagVolume_mem_zigzagIntegerGrade_two k G i))

/-! ### Graded projectives generated in one degree -/

variable {P : GradedModuleCat.{v} (zigzagIntegerGrade k G)}

variable [Module.Projective (nonisolatedZigzagQuotient k G) P] {n : ℤ}

/-- The volume class acts injectively on the lowest vertex parts of a graded projective: if `P` is
projective and generated in degree `n`, then `x ∈ e_u • P_n` with `x_u • x = 0` vanishes. -/
private theorem eq_zero_of_zigzagVolume_smul_eq_zero
    (hP : P.grading.IsGeneratedInDegree (nonisolatedZigzagQuotient k G) n) {u : V} {x : P}
    (hx : x ∈ zigzagVertexIdempotent k G u • P.grading.piece n)
    (h : zigzagVolume k G u • x = 0) : x = 0 := by
  rw [GradedModuleCat.mem_smul_grading_piece_iff (isIdempotentElem_zigzagVertexIdempotent k G _)
    (zigzagVertexIdempotent_mem_zigzagIntegerGrade_zero k G _)] at hx
  obtain ⟨s, hs⟩ := Module.projective_def'.1 ‹Module.Projective _ P›
  have hsx : Finsupp.linearCombination _ id (s x) = x := LinearMap.congr_fun hs x
  -- Every coefficient of `x` in the splitting `s` lies in the radical.
  have hpos (y : P) : s x y ∈ zigzagPositiveSpan k G := by
    refine mem_zigzagPositiveSpan_of_zigzagVolume_mul_eq_zero hns (u := u) ?_ ?_
    · conv_rhs => rw [← hx.2]
      rw [map_smul, Finsupp.smul_apply, smul_eq_mul]
    · rw [← smul_eq_mul, ← Finsupp.smul_apply, ← map_smul, h, map_zero, Finsupp.zero_apply]
  have hmem : x ∈ (⨆ (i : ℤ) (_ : 0 < i), zigzagIntegerGrade k G i) • (⊤ : Submodule k P) := by
    rw [← hsx, Finsupp.linearCombination_apply, Finsupp.sum]
    exact Submodule.sum_mem _ fun y _ =>
      Submodule.smul_mem_smul (zigzagPositiveSpan_le_iSup hns (hpos y)) Submodule.mem_top
  -- An element of `Z₊ P` has no component in the lowest degree `n`.
  have h0 := InternalGrading.decompose_mem_of_mem_positive_smul_top (zigzagIntegerGrade k G)
    (⊥ : Submodule (nonisolatedZigzagQuotient k G) P) (p := n) (fun q hq z hz => by
      rwa [hP.piece_eq_bot_of_lt _ (fun i hi => zigzagIntegerGrade_eq_bot_of_neg k G hi) hq]
        at hz) hmem
  rwa [DirectSum.decompose_of_mem_same _ hx.1, Submodule.mem_bot] at h0

/-! ### The volume map -/

omit hns [Module.Projective (nonisolatedZigzagQuotient k G) P] in
private theorem zigzagVolume_smul_mem {u : V} {p : ℤ} {x : P}
    (hx : x ∈ zigzagVertexIdempotent k G u • P.grading.piece p) :
    zigzagVolume k G u • x ∈ zigzagVertexIdempotent k G u • P.grading.piece (p + 2) := by
  rw [GradedModuleCat.mem_smul_grading_piece_iff (isIdempotentElem_zigzagVertexIdempotent k G _)
    (zigzagVertexIdempotent_mem_zigzagIntegerGrade_zero k G _)] at hx ⊢
  refine ⟨?_, by rw [smul_smul, zigzagMk_vertexIdempotent_mul_zigzagVolume]⟩
  have h := SetLike.GradedSMul.smul_mem (A := zigzagIntegerGrade k G) (B := P.grading.piece)
    (zigzagVolume_mem_zigzagIntegerGrade_two k G u) hx.1
  rwa [vadd_eq_add, add_comm] at h

omit hns [Module.Projective (nonisolatedZigzagQuotient k G) P] in
/-- Multiplication by the volume class `x_u`, from `e_u • P_p` to `e_u • P_{p+2}`. -/
private noncomputable def zigzagVolumeSMulPiece (u : V) (p : ℤ) :
    ↥(zigzagVertexIdempotent k G u • P.grading.piece p) →ₗ[k]
      ↥(zigzagVertexIdempotent k G u • P.grading.piece (p + 2)) :=
  (DistribSMul.toLinearMap k P (zigzagVolume k G u)).restrict fun _ hx =>
    zigzagVolume_smul_mem hx

omit hns [Module.Projective (nonisolatedZigzagQuotient k G) P] in
private theorem coe_zigzagVolumeSMulPiece_apply (u : V) (p : ℤ)
    (x : ↥(zigzagVertexIdempotent k G u • P.grading.piece p)) :
    (zigzagVolumeSMulPiece u p x : P) = zigzagVolume k G u • (x : P) :=
  (rfl)

/-- On a graded projective generated in degree `n`, multiplication by `x_u` is a bijection
`e_u • P_n → e_u • P_{n+2}`. -/
private theorem bijective_zigzagVolumeSMulPiece
    (hP : P.grading.IsGeneratedInDegree (nonisolatedZigzagQuotient k G) n) (u : V) :
    Function.Bijective (zigzagVolumeSMulPiece (P := P) u n) := by
  refine ⟨(injective_iff_map_eq_zero _).2 fun x hx => Subtype.ext
    (eq_zero_of_zigzagVolume_smul_eq_zero hns hP x.2
    (by rw [← coe_zigzagVolumeSMulPiece_apply, hx, ZeroMemClass.coe_zero])), ?_⟩
  rintro ⟨z, hz⟩
  rw [GradedModuleCat.mem_smul_grading_piece_iff (isIdempotentElem_zigzagVertexIdempotent k G _)
    (zigzagVertexIdempotent_mem_zigzagIntegerGrade_zero k G _)] at hz
  -- The image of the volume map, as a subspace of `P`.
  let T : Submodule k P := (zigzagVertexIdempotent k G u • P.grading.piece n).map
    (DistribSMul.toLinearMap k P (zigzagVolume k G u))
  suffices hT : ∀ y ∈ P.grading.piece (n + 2), zigzagVertexIdempotent k G u • y ∈ T by
    obtain ⟨x, hx, hxz⟩ := hT z hz.1
    exact ⟨⟨x, hx⟩, Subtype.ext (hxz.trans hz.2)⟩
  intro y hy
  rw [add_comm, hP.piece_add_eq_smul (zigzagIntegerGrade k G),
    ← Nat.cast_ofNat (R := ℤ) (n := 2), zigzagIntegerGrade_ofNat,
    zigzagGrade_two_eq_span_range_zigzagVolume] at hy
  refine Submodule.smul_induction_on hy (fun a ha w hw => ?_) (fun y₁ y₂ h₁ h₂ => ?_)
  · induction ha using Submodule.span_induction with
    | mem a ha =>
      obtain ⟨i, rfl⟩ := ha
      rw [smul_smul]
      rcases eq_or_ne u i with rfl | hne
      · refine ⟨zigzagVertexIdempotent k G u • w, Submodule.smul_mem_pointwise_smul _ _ _ hw, ?_⟩
        rw [DistribSMul.toLinearMap_apply, smul_smul,
          zigzagVolume_mul_zigzagMk_vertexIdempotent, zigzagMk_vertexIdempotent_mul_zigzagVolume]
      · rw [zigzagMk_vertexIdempotent_mul_zigzagVolume_of_ne k G hne, zero_smul]
        exact T.zero_mem
    | zero => simp
    | add a b _ _ ha hb =>
      rw [add_smul, smul_add]
      exact T.add_mem ha hb
    | smul c a _ ha =>
      rw [smul_assoc, smul_comm]
      exact T.smul_mem c ha
  · rw [smul_add]
    exact T.add_mem h₁ h₂

/-- **Degree `n + 2` of a graded projective generated in degree `n`.** If `P` is a graded
projective over the zigzag algebra generated in degree `n`, then multiplication by the volume class
identifies `e_u • P_n` with `e_u • P_{n+2}`. -/
theorem finrank_zigzagVertexIdempotent_smul_piece_add_two
    (hP : P.grading.IsGeneratedInDegree (nonisolatedZigzagQuotient k G) n) (u : V) :
    Module.finrank k ↥(zigzagVertexIdempotent k G u • P.grading.piece (n + 2)) =
      Module.finrank k ↥(zigzagVertexIdempotent k G u • P.grading.piece n) :=
  (LinearEquiv.ofBijective _ (bijective_zigzagVolumeSMulPiece hns hP u)).finrank_eq.symm

omit hns [Module.Projective (nonisolatedZigzagQuotient k G) P] in
/-- A graded module generated in degree `n` vanishes above degree `n + 2`, since `Z` does. -/
private theorem piece_eq_bot_of_add_two_lt
    (hP : P.grading.IsGeneratedInDegree (nonisolatedZigzagQuotient k G) n) {p : ℤ}
    (hp : n + 2 < p) : P.grading.piece p = ⊥ := by
  obtain ⟨m, rfl⟩ : ∃ m : ℕ, p = m + n := ⟨(p - n).toNat, by omega⟩
  rw [hP.piece_add_eq_smul (zigzagIntegerGrade k G), zigzagIntegerGrade_ofNat,
    zigzagGrade_eq_bot_of_three_le k G (by omega), Submodule.bot_smul]

/-! ### The arrow map -/

/-- The dart `w → u` from a neighbour `w` of `u`. -/
private def inDart (u : V) (w : G.neighborSet u) : G.Dart :=
  ⟨(w, u), ((G.mem_neighborSet u w).1 w.2).symm⟩

omit hns [Module.Projective (nonisolatedZigzagQuotient k G) P] in
private theorem ofArrow_inDart_smul_mem {u : V} (w : G.neighborSet u) {p : ℤ} {x : P}
    (hx : x ∈ zigzagVertexIdempotent k G w • P.grading.piece p) :
    zigzagMk k G (ofArrow (arrow G (inDart u w).adj)) • x ∈
      zigzagVertexIdempotent k G u • P.grading.piece (p + 1) := by
  rw [GradedModuleCat.mem_smul_grading_piece_iff (isIdempotentElem_zigzagVertexIdempotent k G _)
    (zigzagVertexIdempotent_mem_zigzagIntegerGrade_zero k G _)] at hx
  rw [GradedModuleCat.mem_smul_grading_piece_iff (isIdempotentElem_zigzagVertexIdempotent k G _)
    (zigzagVertexIdempotent_mem_zigzagIntegerGrade_zero k G _)]
  have he : zigzagVertexIdempotent k G u * zigzagMk k G (ofArrow (arrow G (inDart u w).adj)) =
      zigzagMk k G (ofArrow (arrow G (inDart u w).adj)) :=
    zigzagMk_vertexIdempotent_mul_ofArrow k G (inDart u w)
  refine ⟨?_, by rw [smul_smul, he]⟩
  have h := SetLike.GradedSMul.smul_mem (A := zigzagIntegerGrade k G) (B := P.grading.piece)
    (zigzagMk_ofArrow_mem_zigzagIntegerGrade_one k G (inDart u w)) hx.1
  rwa [vadd_eq_add, add_comm] at h

section Arrow

variable [Fintype V] [DecidableRel G.Adj]

omit hns [Module.Projective (nonisolatedZigzagQuotient k G) P] in
/-- The sum of the arrows into `u`, from `⨁_{w ∼ u} e_w • P_p` to `e_u • P_{p+1}`. -/
private noncomputable def zigzagArrowSumPiece (u : V) (p : ℤ) :
    (∀ w : G.neighborSet u, ↥(zigzagVertexIdempotent k G w • P.grading.piece p)) →ₗ[k]
      ↥(zigzagVertexIdempotent k G u • P.grading.piece (p + 1)) :=
  LinearMap.codRestrict _ (∑ w : G.neighborSet u,
      DistribSMul.toLinearMap k P (zigzagMk k G (ofArrow (arrow G (inDart u w).adj))) ∘ₗ
        (zigzagVertexIdempotent k G w • P.grading.piece p).subtype ∘ₗ LinearMap.proj w)
    fun f => by
      rw [LinearMap.sum_apply]
      exact Submodule.sum_mem _ fun w _ => ofArrow_inDart_smul_mem w (f w).2

omit hns [Module.Projective (nonisolatedZigzagQuotient k G) P] in
private theorem coe_zigzagArrowSumPiece_apply (u : V) (p : ℤ)
    (f : ∀ w : G.neighborSet u, ↥(zigzagVertexIdempotent k G w • P.grading.piece p)) :
    (zigzagArrowSumPiece u p f : P) =
      ∑ w, zigzagMk k G (ofArrow (arrow G (inDart u w).adj)) • (f w : P) := by
  simp [zigzagArrowSumPiece, LinearMap.sum_apply]

/-- On a graded projective generated in degree `n`, the sum of the arrows into `u` is a bijection
`⨁_{w ∼ u} e_w • P_n → e_u • P_{n+1}`. -/
private theorem bijective_zigzagArrowSumPiece
    (hP : P.grading.IsGeneratedInDegree (nonisolatedZigzagQuotient k G) n) (u : V) :
    Function.Bijective (zigzagArrowSumPiece (P := P) u n) := by
  classical
  refine ⟨(injective_iff_map_eq_zero _).2 fun f hf => funext fun w₀ => Subtype.ext ?_, ?_⟩
  · -- Multiplying by the reverse of the arrow from `w₀` isolates the `w₀` component.
    have hf' := congrArg (fun z : ↥(zigzagVertexIdempotent k G u • P.grading.piece (n + 1)) =>
      zigzagMk k G (ofArrow (arrow G (inDart u w₀).symm.adj)) • (z : P)) hf
    simp only [coe_zigzagArrowSumPiece_apply, ZeroMemClass.coe_zero, smul_zero,
      Finset.smul_sum, smul_smul] at hf'
    rw [Finset.sum_eq_single w₀ (fun w _ hw => ?_) (by simp)] at hf'
    · have hvol := zigzagMk_ofArrow_mul_ofArrow_symm k G (inDart u w₀).symm
      rw [SimpleGraph.Dart.symm_symm] at hvol
      rw [hvol] at hf'
      exact eq_zero_of_zigzagVolume_smul_eq_zero hns hP (f w₀).2 hf'
    · have hne : inDart u w ≠ (inDart u w₀).symm.symm := by
        rw [SimpleGraph.Dart.symm_symm]
        intro h
        exact hw (Subtype.ext (congrArg (fun d : G.Dart => d.fst) h))
      rw [zigzagMk_ofArrow_mul_ofArrow_of_ne k G hne, zero_smul]
  · rintro ⟨z, hz⟩
    rw [GradedModuleCat.mem_smul_grading_piece_iff
      (isIdempotentElem_zigzagVertexIdempotent k G _)
      (zigzagVertexIdempotent_mem_zigzagIntegerGrade_zero k G _)] at hz
    let T : Submodule k P := LinearMap.range
      ((zigzagVertexIdempotent k G u • P.grading.piece (n + 1)).subtype ∘ₗ zigzagArrowSumPiece u n)
    suffices hT : ∀ y ∈ P.grading.piece (n + 1), zigzagVertexIdempotent k G u • y ∈ T by
      obtain ⟨f, hf⟩ := hT z hz.1
      exact ⟨f, Subtype.ext (hf.trans hz.2)⟩
    intro y hy
    rw [add_comm, hP.piece_add_eq_smul (zigzagIntegerGrade k G),
      ← Nat.cast_one (R := ℤ), zigzagIntegerGrade_ofNat,
      zigzagGrade_one_eq_span_range_ofArrow] at hy
    refine Submodule.smul_induction_on hy (fun a ha w hw => ?_) (fun y₁ y₂ h₁ h₂ => ?_)
    · induction ha using Submodule.span_induction with
      | mem a ha =>
        obtain ⟨⟨⟨i, j⟩, hij⟩, rfl⟩ := ha
        rw [smul_smul]
        rcases eq_or_ne j u with rfl | hne
        · -- The arrow ends at `u`, so it is the arrow from the neighbour `i`.
          let i' : G.neighborSet j := ⟨i, (G.mem_neighborSet j i).2 hij.symm⟩
          have hd : (⟨(i, j), hij⟩ : G.Dart) = inDart j i' := rfl
          refine ⟨Pi.single i' ⟨zigzagVertexIdempotent k G i • w,
            Submodule.smul_mem_pointwise_smul _ _ _ hw⟩, ?_⟩
          rw [LinearMap.comp_apply, Submodule.subtype_apply, coe_zigzagArrowSumPiece_apply,
            Finset.sum_eq_single i' (fun w' _ hw' => by simp [Pi.single_eq_of_ne hw']) (by simp),
            Pi.single_eq_same, smul_smul, hd]
          have he : zigzagVertexIdempotent k G j *
              zigzagMk k G (ofArrow (arrow G (inDart j i').adj)) =
                zigzagMk k G (ofArrow (arrow G (inDart j i').adj)) :=
            zigzagMk_vertexIdempotent_mul_ofArrow k G (inDart j i')
          have he' : zigzagMk k G (ofArrow (arrow G (inDart j i').adj)) *
              zigzagVertexIdempotent k G i = zigzagMk k G (ofArrow (arrow G (inDart j i').adj)) :=
            zigzagMk_ofArrow_mul_vertexIdempotent k G (inDart j i')
          rw [he, he']
        · rw [zigzagMk_vertexIdempotent_mul_ofArrow_of_ne k G _ (Ne.symm hne), zero_smul]
          exact T.zero_mem
      | zero => simp
      | add a b _ _ ha hb =>
        rw [add_smul, smul_add]
        exact T.add_mem ha hb
      | smul c a _ ha =>
        rw [smul_assoc, smul_comm]
        exact T.smul_mem c ha
    · rw [smul_add]
      exact T.add_mem h₁ h₂

/-- **Degree `n + 1` of a graded projective generated in degree `n`.** If `P` is a graded
projective over the zigzag algebra generated in degree `n`, with finite-dimensional vertex parts
`e_w • P_n`, then the arrows into `u` identify `e_u • P_{n+1}` with `⨁_{w ∼ u} e_w • P_n`. -/
theorem finrank_zigzagVertexIdempotent_smul_piece_add_one
    (hP : P.grading.IsGeneratedInDegree (nonisolatedZigzagQuotient k G) n)
    [∀ w : V, FiniteDimensional k ↥(zigzagVertexIdempotent k G w • P.grading.piece n)]
    (u : V) :
    Module.finrank k ↥(zigzagVertexIdempotent k G u • P.grading.piece (n + 1)) =
      ∑ w ∈ G.neighborFinset u,
        Module.finrank k ↥(zigzagVertexIdempotent k G w • P.grading.piece n) := by
  rw [← (LinearEquiv.ofBijective _ (bijective_zigzagArrowSumPiece hns hP u)).finrank_eq,
    Module.finrank_pi_fintype,
    Finset.sum_subtype (p := fun w => w ∈ G.neighborSet u) (G.neighborFinset u)
      (fun w => by simp)
      (fun w => Module.finrank k ↥(zigzagVertexIdempotent k G w • P.grading.piece n))]

end Arrow

/-! ### Linear resolutions -/

section Resolution

variable {M : GradedModuleCat.{v} (zigzagIntegerGrade k G)}
  {r : GradedProjectiveResolution.{w, max u w, v, v} (zigzagIntegerGrade k G) M.grading}

omit hns in
/-- The vertex part of a zero piece is zero. -/
private theorem subsingleton_smul_of_eq_bot {X : Type*} [AddCommGroup X] [Module k X]
    [Module (nonisolatedZigzagQuotient k G) X] [IsScalarTower k (nonisolatedZigzagQuotient k G) X]
    {S : Submodule k X} (hS : S = ⊥) (u : V) :
    Subsingleton ↥(zigzagVertexIdempotent k G u • S) := by
  rw [hS, Submodule.smul_bot']
  infer_instance

omit hns in
/-- Restricted to vertex parts of one internal degree, a resolution stays exact. -/
private theorem exact_smulPieceMap_differential (u : V) (n : ℕ) (p : ℤ) :
    Function.Exact
      (GradedModuleCat.smulPieceMap (zigzagVertexIdempotent k G u) (r.differential (n + 1)) p)
      (GradedModuleCat.smulPieceMap (zigzagVertexIdempotent k G u) (r.differential n) p) :=
  GradedModuleCat.exact_smulPieceMap (isIdempotentElem_zigzagVertexIdempotent k G u)
    (zigzagVertexIdempotent_mem_zigzagIntegerGrade_zero k G u) (r.exact_d_d n) p

omit hns in
private theorem exact_smulPieceMap_augmentation (u : V) (p : ℤ) :
    Function.Exact
      (GradedModuleCat.smulPieceMap (zigzagVertexIdempotent k G u) (r.differential 0) p)
      (GradedModuleCat.smulPieceMap (zigzagVertexIdempotent k G u) r.augmentation p) :=
  GradedModuleCat.exact_smulPieceMap (isIdempotentElem_zigzagVertexIdempotent k G u)
    (zigzagVertexIdempotent_mem_zigzagIntegerGrade_zero k G u) r.exact_d_π p

omit hns in
/-- A term of a linear resolution vanishes below its homological degree. -/
private theorem subsingleton_smul_piece_of_lt (hr : r.IsLinear) (u : V) {n : ℕ} {p : ℤ}
    (hp : p < n) : Subsingleton ↥(zigzagVertexIdempotent k G u • (r.grading n).piece p) :=
  subsingleton_smul_of_eq_bot
    (hr.piece_eq_bot_of_lt (fun _ hi => zigzagIntegerGrade_eq_bot_of_neg k G hi) hp) u

omit hns in
/-- A term of a linear resolution vanishes in degrees strictly greater than two above its
homological degree. -/
private theorem subsingleton_smul_piece_of_add_two_lt (hr : r.IsLinear) (u : V) {n : ℕ}
    {p : ℤ} (hp : n + 2 < p) :
    Subsingleton ↥(zigzagVertexIdempotent k G u • (r.grading n).piece p) :=
  have := r.projective n
  subsingleton_smul_of_eq_bot
    (piece_eq_bot_of_add_two_lt (P := r.termObj n) (r.isLinear_iff.1 hr n) hp) u

omit hns in
/-- In its lowest degree, a term of a linear resolution injects into the previous term (or, for
the first term, into the resolved module). -/
private theorem injective_smulPieceMap_differential (hr : r.IsLinear) (u : V) (n : ℕ) :
    Function.Injective (GradedModuleCat.smulPieceMap (zigzagVertexIdempotent k G u)
      (r.differential n) (n + 1 : ℕ)) := by
  have := subsingleton_smul_piece_of_lt hr u (n := n + 2) (p := (n + 1 : ℕ)) (by omega)
  refine (injective_iff_map_eq_zero _).2 fun x hx => ?_
  obtain ⟨y, rfl⟩ := (exact_smulPieceMap_differential u n _ x).1 hx
  rw [Subsingleton.elim y 0, map_zero]

omit hns in
private theorem injective_smulPieceMap_augmentation (hr : r.IsLinear) (u : V) :
    Function.Injective (GradedModuleCat.smulPieceMap (zigzagVertexIdempotent k G u)
      r.augmentation 0) := by
  have := subsingleton_smul_piece_of_lt hr u (n := 1) (p := 0) (by omega)
  refine (injective_iff_map_eq_zero _).2 fun x hx => ?_
  obtain ⟨y, rfl⟩ := (exact_smulPieceMap_augmentation u 0 x).1 hx
  rw [Subsingleton.elim y 0, map_zero]

omit hns in
/-- **Degree zero of a linear resolution**: the augmentation identifies the lowest vertex parts of
`X₀` with those of the resolved module. -/
theorem finrank_zigzagVertexIdempotent_smul_piece_zero_of_isLinear (hr : r.IsLinear) (u : V) :
    Module.finrank k ↥(zigzagVertexIdempotent k G u • (r.grading 0).piece 0) =
      Module.finrank k ↥(zigzagVertexIdempotent k G u • M.grading.piece 0) :=
  (LinearEquiv.ofBijective _ ⟨injective_smulPieceMap_augmentation hr u,
    GradedModuleCat.smulPieceMap_surjective r.surjective_π 0⟩).finrank_eq

/-- The lowest vertex parts of a linear resolution of a finite-dimensional module are
finite-dimensional. -/
private theorem finiteDimensional_smul_piece [Module.Finite k M] (hr : r.IsLinear) :
    ∀ (n : ℕ) (u : V),
      FiniteDimensional k ↥(zigzagVertexIdempotent k G u • (r.grading n).piece n)
  | 0, u => FiniteDimensional.of_injective _ (injective_smulPieceMap_augmentation hr u)
  | n + 1, u => by
    classical
    let _ := Fintype.ofFinite V
    have := r.projective n
    have := finiteDimensional_smul_piece hr n
    have : FiniteDimensional k
        ↥(zigzagVertexIdempotent k G u • (r.termObj n).grading.piece ((n + 1 : ℕ) : ℤ)) := by
      rw [Nat.cast_succ]
      exact (LinearEquiv.ofBijective _ (bijective_zigzagArrowSumPiece hns (P := r.termObj n)
        (r.isLinear_iff.1 hr n) u)).finiteDimensional
    exact FiniteDimensional.of_injective _ (injective_smulPieceMap_differential hr u n)

variable [Fintype V] [DecidableRel G.Adj]

/-- **Degree one of a linear resolution** of a module `M` with `e_u • M₁ = 0`: the multiplicity
of `P_u{1}` in `X₁` is the sum of the multiplicities in `X₀` over the neighbours of `u`. -/
theorem finrank_zigzagVertexIdempotent_smul_piece_one_of_isLinear [Module.Finite k M]
    (hr : r.IsLinear) {u : V} (hM : zigzagVertexIdempotent k G u • M.grading.piece 1 = ⊥) :
    Module.finrank k ↥(zigzagVertexIdempotent k G u • (r.grading 1).piece 1) =
      ∑ w ∈ G.neighborFinset u,
        Module.finrank k ↥(zigzagVertexIdempotent k G w • (r.grading 0).piece 0) := by
  have := r.projective 0
  have := finiteDimensional_smul_piece hns hr 0
  have hM₁ : Subsingleton ↥(zigzagVertexIdempotent k G u • M.grading.piece 1) := by
    rw [hM]
    infer_instance
  have hsurj : Function.Surjective (GradedModuleCat.smulPieceMap (zigzagVertexIdempotent k G u)
      (r.differential 0) 1) := fun x => (exact_smulPieceMap_augmentation u 1 x).1
    (Subsingleton.elim _ _)
  have h₁ := (LinearEquiv.ofBijective _
    ⟨injective_smulPieceMap_differential hr u 0, hsurj⟩).finrank_eq
  have h₂ := finrank_zigzagVertexIdempotent_smul_piece_add_one hns (P := r.termObj 0)
    (r.isLinear_iff.1 hr 0) u
  exact h₁.trans h₂

/-- **The multiplicity recursion of a linear resolution.** Let `X` be a linear graded projective
resolution of a finite-dimensional graded module `M` over the zigzag algebra of a finite graph
without isolated vertices, and let `u` be a vertex with `e_u • M₂ = 0`. Then the multiplicities
`m_n(u) = dim_k (e_u • (X_n)_n)` of the shifted projectives `P_u{n}` in `X_n` satisfy
`m_{p+2}(u) + m_p(u) = ∑_{w ∼ u} m_{p+1}(w)`. -/
theorem finrank_zigzagVertexIdempotent_smul_piece_add_two_add_finrank_of_isLinear
    [Module.Finite k M] (hr : r.IsLinear) (p : ℕ) {u : V}
    (hM : zigzagVertexIdempotent k G u • M.grading.piece 2 = ⊥) :
    Module.finrank k ↥(zigzagVertexIdempotent k G u • (r.grading (p + 2)).piece (p + 2 : ℕ)) +
        Module.finrank k ↥(zigzagVertexIdempotent k G u • (r.grading p).piece p) =
      ∑ w ∈ G.neighborFinset u,
        Module.finrank k
          ↥(zigzagVertexIdempotent k G w • (r.grading (p + 1)).piece (p + 1 : ℕ)) := by
  have := r.projective p
  have := r.projective (p + 1)
  have := finiteDimensional_smul_piece hns hr (p + 1)
  -- In degree `p + 2`, the sequence `0 ⟶ X_{p+2} ⟶ X_{p+1} ⟶ X_p ⟶ 0` of vertex parts is exact.
  let f := GradedModuleCat.smulPieceMap (zigzagVertexIdempotent k G u) (r.differential (p + 1))
    ((p + 2 : ℕ) : ℤ)
  let g := GradedModuleCat.smulPieceMap (zigzagVertexIdempotent k G u) (r.differential p)
    ((p + 2 : ℕ) : ℤ)
  have hf : Function.Injective f := injective_smulPieceMap_differential hr u (p + 1)
  have hfg : Function.Exact f g := exact_smulPieceMap_differential u p _
  have hg : Function.Surjective g := by
    rcases p with _ | q
    · have : Subsingleton ↥(zigzagVertexIdempotent k G u • M.grading.piece 2) := by
        rw [hM]
        infer_instance
      exact fun x => (exact_smulPieceMap_augmentation u 2 x).1 (Subsingleton.elim _ _)
    · have := subsingleton_smul_piece_of_add_two_lt hr u (n := q) (p := ((q + 1 + 2 : ℕ) : ℤ))
        (by omega)
      exact fun x => (exact_smulPieceMap_differential u q _ x).1 (Subsingleton.elim _ _)
  have hcast : ((p + 2 : ℕ) : ℤ) = ((p + 1 : ℕ) : ℤ) + 1 := by push_cast; ring
  have : FiniteDimensional k ↥(zigzagVertexIdempotent k G u •
      (r.termObj (p + 1)).grading.piece ((p + 2 : ℕ) : ℤ)) := by
    rw [hcast]
    exact (LinearEquiv.ofBijective _ (bijective_zigzagArrowSumPiece hns (P := r.termObj (p + 1))
      (r.isLinear_iff.1 hr (p + 1)) u)).finiteDimensional
  have hrank := hfg.finrank_eq_add hf hg
  have hB := finrank_zigzagVertexIdempotent_smul_piece_add_one hns (P := r.termObj (p + 1))
    (r.isLinear_iff.1 hr (p + 1)) u
  have hC := finrank_zigzagVertexIdempotent_smul_piece_add_two hns (P := r.termObj p)
    (r.isLinear_iff.1 hr p) u
  rw [← hcast] at hB
  rw [show ((p : ℤ) + 2) = ((p + 2 : ℕ) : ℤ) by push_cast; ring] at hC
  -- The three equations concern the terms `r.termObj n`, whose carrier is `r.X n` and whose
  -- grading is `r.grading n`; restate them on those terms so that `omega` sees common atoms.
  change Module.finrank k ↥(zigzagVertexIdempotent k G u •
      (r.grading (p + 1)).piece ((p + 2 : ℕ) : ℤ)) =
    Module.finrank k ↥(zigzagVertexIdempotent k G u •
        (r.grading (p + 2)).piece ((p + 2 : ℕ) : ℤ)) +
      Module.finrank k ↥(zigzagVertexIdempotent k G u • (r.grading p).piece ((p + 2 : ℕ) : ℤ))
    at hrank
  change Module.finrank k ↥(zigzagVertexIdempotent k G u •
      (r.grading (p + 1)).piece ((p + 2 : ℕ) : ℤ)) = ∑ w ∈ G.neighborFinset u,
        Module.finrank k
          ↥(zigzagVertexIdempotent k G w • (r.grading (p + 1)).piece (p + 1 : ℕ))
    at hB
  change Module.finrank k
      ↥(zigzagVertexIdempotent k G u • (r.grading p).piece ((p + 2 : ℕ) : ℤ)) =
    Module.finrank k ↥(zigzagVertexIdempotent k G u • (r.grading p).piece (p : ℤ)) at hC
  omega

/-! ### The inverse graded Cartan matrix -/

open PowerSeries
open scoped _root_.Matrix

/-- The `u`-th entry of `C_G(-X) m` for the graded Cartan matrix of a graph without isolated
vertices: `(1 + X²) m_u - X ∑_{w ∼ u} m_w`. -/
private theorem zigzagGradedCartanMatrix_map_aeval_neg_X_mulVec_apply
    (m : V → ℤ⟦X⟧) (u : V) :
    ((zigzagGradedCartanMatrix k G).map (Polynomial.aeval (-X : ℤ⟦X⟧)) *ᵥ m) u =
      (1 + X ^ 2) * m u - X * ∑ w ∈ G.neighborFinset u, m w := by
  classical
  have hentry (w : V) : Polynomial.aeval (-X : ℤ⟦X⟧) (zigzagGradedCartanMatrix k G u w) =
      (if u = w then 1 + X ^ 2 else 0) - if G.Adj u w then X else 0 := by
    rw [zigzagGradedCartanMatrix_apply k G hns]
    split_ifs <;> simp_all [sub_eq_add_neg]
  simp only [Matrix.mulVec, dotProduct, Matrix.map_apply, hentry, sub_mul, ite_mul, zero_mul,
    Finset.sum_sub_distrib, Finset.sum_ite_eq, Finset.mem_univ, ite_true, Finset.sum_ite,
    Finset.sum_const_zero, add_zero, Finset.mul_sum, SimpleGraph.neighborFinset_eq_filter]

omit [DecidableRel G.Adj] in
/-- **The multiplicities of a linear resolution invert the graded Cartan matrix.** Let `X` be a
linear graded projective resolution of a finite-dimensional graded module `M` concentrated in
degree `0` over the zigzag algebra of a finite graph without isolated vertices, and let
`m_u(X) = ∑_n dim_k (e_u • (X_n)_n) Xⁿ` record the multiplicities of the shifted projectives
`P_u{n}` in `X_n`. Then `C_G(-X) m(X)` is the constant vector `(dim_k (e_u • M))_u`, for the graded
Cartan matrix `C_G(q) = (1 + q²) I + q A_G`. -/
theorem zigzagGradedCartanMatrix_map_aeval_neg_X_mulVec_eq [Module.Finite k M]
    (hM : ∀ (u : V) (p : ℤ), p ≠ 0 → zigzagVertexIdempotent k G u • M.grading.piece p = ⊥)
    (hr : r.IsLinear) :
    (zigzagGradedCartanMatrix k G).map (Polynomial.aeval (-X : ℤ⟦X⟧)) *ᵥ
        (fun u => PowerSeries.mk fun n =>
          (Module.finrank k ↥(zigzagVertexIdempotent k G u • (r.grading n).piece n) : ℤ)) =
      fun u => PowerSeries.C
        (Module.finrank k ↥(zigzagVertexIdempotent k G u • M.grading.piece 0) : ℤ) := by
  classical
  funext u
  rw [zigzagGradedCartanMatrix_map_aeval_neg_X_mulVec_apply hns]
  ext n
  rcases n with _ | _ | p
  · simp [finrank_zigzagVertexIdempotent_smul_piece_zero_of_isLinear hr u]
  · have h := finrank_zigzagVertexIdempotent_smul_piece_one_of_isLinear hns hr (hM u 1 one_ne_zero)
    simp only [map_sub, add_mul, one_mul, map_add, coeff_X_pow_mul', coeff_succ_X_mul, map_sum,
      coeff_mk, coeff_C]
    simp [h]
  · have h :=
      finrank_zigzagVertexIdempotent_smul_piece_add_two_add_finrank_of_isLinear hns hr p
        (hM u 2 two_ne_zero)
    simp only [map_sub, add_mul, one_mul, map_add, coeff_X_pow_mul', coeff_succ_X_mul, map_sum,
      coeff_mk, coeff_C]
    simp only [show 2 ≤ p + 2 by omega, show p + 1 + 1 = p + 2 from rfl,
      show p + 2 ≠ 0 by omega, ite_true, ite_false]
    rw [← Nat.cast_sum, ← Nat.cast_add, sub_eq_zero, Nat.cast_inj]
    exact h

end Resolution

/-! ### Linear resolutions of the graded simples -/

section Simple

open PowerSeries
open scoped _root_.Matrix

variable [Fintype V] [DecidableEq V]

omit hns in
/-- The graded Cartan matrix `C_G(-X)` is invertible over `ℤ⟦X⟧`: its constant term is the
identity matrix. -/
private theorem isUnit_det_zigzagGradedCartanMatrix_map_aeval_neg_X :
    IsUnit ((zigzagGradedCartanMatrix k G).map (Polynomial.aeval (-X : ℤ⟦X⟧))).det := by
  have hcc : (constantCoeff (R := ℤ)).comp (Polynomial.aeval (-X : ℤ⟦X⟧)).toRingHom =
      Polynomial.evalRingHom 0 :=
    Polynomial.ringHom_ext (fun a => by simp) (by simp)
  have hA : (constantCoeff (R := ℤ)).mapMatrix
      ((zigzagGradedCartanMatrix k G).map (Polynomial.aeval (-X : ℤ⟦X⟧))) = 1 := by
    rw [← zigzagGradedCartanMatrix_map_eval_zero k G]
    ext i j
    exact DFunLike.congr_fun hcc (zigzagGradedCartanMatrix k G i j)
  rw [PowerSeries.isUnit_iff_constantCoeff, RingHom.map_det, hA, Matrix.det_one]
  exact isUnit_one

omit hns [Fintype V] in
/-- The vertex parts of the graded simple `S_v`: one-dimensional at `v` in degree `0`, and zero
otherwise. -/
private theorem finrank_smul_zigzagGradedSimple_piece (v u : V) (p : ℤ) :
    Module.finrank k
        ↥(zigzagVertexIdempotent k G u • (zigzagGradedSimple k G v).grading.piece p) =
      if p = 0 ∧ u = v then 1 else 0 := by
  have h := congrArg (fun f : LaurentPolynomial ℤ => f.coeff p)
    (smulGradedDimension_zigzagGradedSimple k G u v)
  simp only [GradedModuleCat.coeff_smulGradedDimension] at h
  rw [← Nat.cast_inj (R := ℤ), h]
  by_cases huv : u = v
  · rw [ite_eq_left huv, AddMonoidAlgebra.one_def, AddMonoidAlgebra.coeff_single,
      Finsupp.single_apply]
    rcases eq_or_ne p 0 with rfl | hp
    · simp [huv]
    · simp [hp, Ne.symm hp]
  · simp [huv]

/-- **The multiplicities of a linear resolution of a graded simple.** Let `G` be a finite graph
without isolated vertices and `S_v` the graded simple module of its zigzag algebra at `v`. For any
linear graded projective resolution `X` of `S_v`, the multiplicity `dim_k (e_u • (X_n)_n)` of the
shifted projective `P_u{n}` in `X_n` is the coefficient of `Xⁿ` in the entry `(u, v)` of the
inverse `C_G(-X)⁻¹` of the graded Cartan matrix `C_G(q) = (1 + q²) I + q A_G`. -/
theorem coeff_inv_zigzagGradedCartanMatrix_map_aeval_neg_X_eq (v : V)
    {r : GradedProjectiveResolution.{w, max u w, max u w, max u w} (zigzagIntegerGrade k G)
      (zigzagGradedSimple k G v).grading} (hr : r.IsLinear) (n : ℕ) (u : V) :
    coeff n (((zigzagGradedCartanMatrix k G).map (Polynomial.aeval (-X : ℤ⟦X⟧)))⁻¹ u v) =
      Module.finrank k ↥(zigzagVertexIdempotent k G u • (r.grading n).piece n) := by
  classical
  have hM (u : V) (p : ℤ) (hp : p ≠ 0) :
      zigzagVertexIdempotent k G u • (zigzagGradedSimple k G v).grading.piece p = ⊥ := by
    rw [← Submodule.finrank_eq_zero, finrank_smul_zigzagGradedSimple_piece, ite_eq_right_iff]
    exact fun h => absurd h.1 hp
  have hmat := zigzagGradedCartanMatrix_map_aeval_neg_X_mulVec_eq hns hM hr
  have hsingle : (fun u : V => PowerSeries.C (Module.finrank k
      ↥(zigzagVertexIdempotent k G u • (zigzagGradedSimple k G v).grading.piece 0) : ℤ)) =
      Pi.single v 1 := by
    funext u
    rw [finrank_smul_zigzagGradedSimple_piece, Pi.single_apply]
    by_cases huv : u = v <;> simp [huv]
  rw [hsingle] at hmat
  let := Matrix.invertibleOfIsUnitDet _
    (isUnit_det_zigzagGradedCartanMatrix_map_aeval_neg_X (k := k) (G := G))
  have hinv := Matrix.inv_mulVec_eq_vec hmat.symm
  rw [Matrix.mulVec_single_one] at hinv
  have hu := congrFun hinv u
  rw [Matrix.col_apply] at hu
  rw [hu, coeff_mk]

/-- **Linearly resolved simples give nonnegative inverse Cartan coefficients.** If the graded
simple module `S_v` of the zigzag algebra of a finite graph without isolated vertices has a linear
graded projective resolution, then every coefficient of the column `v` of the inverse
`C_G(-X)⁻¹` of the graded Cartan matrix is nonnegative. -/
theorem coeff_inv_zigzagGradedCartanMatrix_map_aeval_neg_X_nonneg (v : V)
    (h : ∃ r : GradedProjectiveResolution.{w, max u w, max u w, max u w}
      (zigzagIntegerGrade k G) (zigzagGradedSimple k G v).grading, r.IsLinear) (n : ℕ) (u : V) :
    0 ≤ coeff n (((zigzagGradedCartanMatrix k G).map (Polynomial.aeval (-X : ℤ⟦X⟧)))⁻¹ u v) := by
  obtain ⟨r, hr⟩ := h
  rw [coeff_inv_zigzagGradedCartanMatrix_map_aeval_neg_X_eq hns v hr]
  exact Int.natCast_nonneg _

end Simple

end TauCeti
