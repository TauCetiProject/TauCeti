module

public import TauCeti.RepresentationTheory.Quiver.Zigzag.Braid.Factors
public import TauCeti.RepresentationTheory.Quiver.Zigzag.Braid.Adjacent.Basic

/-!
# The top tensor term of an adjacent braid product

The two middle corners of `U_i ⊗[Z] U_j ⊗[Z] U_i` are generated by opposite
arrows when `i` and `j` are adjacent. Extracting these corners leaves the two
outer factors of `U_i`. Each arrow has internal degree one, so the resulting
vertex bimodule is shifted by two. This is the top term of the adjacent
triple-product cancellation.
-/

public section
noncomputable section
namespace TauCeti
open MulOpposite CategoryTheory
open scoped TensorProduct
variable (k : Type*) [CommRing k] {V : Type*} (G : SimpleGraph V) [Finite V]
local notation "Z" => AlgCat.carrier (zigzagAlgebra k G)
local notation "E" => Z ⊗[k] Zᵐᵒᵖ
local notation "Γ" => zigzagAlgebraInternalGrading k G
local notation "U" => zigzagGradedBraidBimodule k G
local notation "T" => GradedModuleCat.bimoduleTensorObj Γ Γ Γ
local notation "e" => fun i : V ↦ zigzagAlgebraBasis k G (Sum.inl i)
local notation "L" => fun i : V ↦ (Ideal.span {e i} : Ideal Z)
local notation "R" => fun i : V ↦ (Ideal.span {op (e i)} : Ideal Zᵐᵒᵖ)
attribute [local instance] zigzagAlgebraIntegerGradedAlgebra

private local instance adjacentRightModule
    (M : GradedModuleCat (zigzagEnvelopingGrading k G).piece) : Module Zᵐᵒᵖ M :=
  TauCeti.Algebra.TensorProduct.moduleRight (k := k) (A := Z) (B := Zᵐᵒᵖ) M
private local instance adjacentLeftModule
    (M : GradedModuleCat (zigzagEnvelopingGrading k G).piece) : Module Z M :=
  TauCeti.Algebra.TensorProduct.moduleLeft (k := k) (A := Z) (B := Zᵐᵒᵖ) M

private def adjacentPairFactorsEquiv {i j : V} (h : G.Adj j i) :
    T (U i) (U j) ≃ₗ[k] L i ⊗[k] R j :=
  (zigzagBraidTensorCornerEquiv k G i j).trans
    ((TensorProduct.congr (zigzagAlgebraAdjacentCornerEquiv k G h)
      (LinearEquiv.refl k _)).trans (TensorProduct.lid k _))

private def adjacentPairRightFactors {i j : V} (h : G.Adj j i) :
    T (U i) (U j) ≃ₗ[k] R j ⊗[k] L i :=
  (adjacentPairFactorsEquiv k G h).trans (TensorProduct.comm k _ _)

private theorem adjacentPairRightFactors_equivariant {i j : V} (h : G.Adj j i)
    (a : Z) (m : T (U i) (U j)) :
    adjacentPairRightFactors k G h (op a • m) =
      op a • adjacentPairRightFactors k G h m := by
  have key (x : cornerSubmodule k (e i) (e j) ⊗[k] (L i ⊗[k] R j)) :
      TensorProduct.comm k (L i) (R j)
          (TensorProduct.lid k (L i ⊗[k] R j)
            ((TensorProduct.congr (zigzagAlgebraAdjacentCornerEquiv k G h)
              (LinearEquiv.refl k _))
                (TensorProduct.map LinearMap.id
                  (TensorProduct.map ((Algebra.lsmul k k (L i)) (1 : Z))
                    ((Algebra.lsmul k k (R j)) (op a))) x))) =
        op a • TensorProduct.comm k (L i) (R j)
          (TensorProduct.lid k (L i ⊗[k] R j)
            ((TensorProduct.congr (zigzagAlgebraAdjacentCornerEquiv k G h)
              (LinearEquiv.refl k _)) x)) := by
    induction x using TensorProduct.inductionOn with
    | tmul c t =>
      induction t using TensorProduct.inductionOn with
      | tmul l r =>
        simp only [TensorProduct.map_tmul, LinearMap.id_apply, Algebra.lsmul_apply,
          one_smul, TensorProduct.congr_tmul, LinearEquiv.refl_apply,
          TensorProduct.lid_tmul, TensorProduct.comm_tmul,
          TensorProduct.smul_tmul']
      | add t t' ht ht' => simp only [map_add, TensorProduct.tmul_add, smul_add, ht, ht']
    | add x x' hx hx' => simp only [map_add, smul_add, hx, hx']
  -- The local right module restricts the enveloping action along a ↦ 1 ⊗ op a.
  -- Its scalar operation is definitional; the corner-action equation below instead
  -- takes the enveloping scalar explicitly, so identify that action here.
  change adjacentPairRightFactors k G h (((1 : Z) ⊗ₜ[k] op a) • m) = _
  exact (congrArg (fun x ↦ TensorProduct.comm k (L i) (R j)
    (TensorProduct.lid k (L i ⊗[k] R j)
      ((TensorProduct.congr (zigzagAlgebraAdjacentCornerEquiv k G h)
        (LinearEquiv.refl k _)) x)))
          (zigzagBraidTensorCornerEquiv_tmul_smul k G i j 1 (op a) m)).trans
    (key (zigzagBraidTensorCornerEquiv k G i j m))

private theorem adjacentVertexFactors_equivariant (i : V) (a : Z) (m : U i) :
    zigzagBraidBimoduleFactorsEquiv k G i (a • m) =
      a • zigzagBraidBimoduleFactorsEquiv k G i m := by
  have key (t : L i ⊗[k] R i) :
      TensorProduct.map ((Algebra.lsmul k k (L i)) a)
        ((Algebra.lsmul k k (R i)) (op (1 : Z))) t = a • t := by
    induction t using TensorProduct.inductionOn with
    | tmul l r => simp [TensorProduct.smul_tmul']
    | add x y hx hy => simp only [smul_add, map_add, hx, hy]
  exact (zigzagBraidBimoduleFactorsEquiv_tmul_smul k G i a 1 m).trans
    (key (zigzagBraidBimoduleFactorsEquiv k G i m))

/-- The two adjacent middle-arrow coordinates identify the triple carrier with the vertex
bimodule carrier. Its internal grading is accounted for by the degree-two insertion. -/
def zigzagBraidAdjacentTripleUnderlyingEquiv {i j : V} (h : G.Adj j i) :
    T (T (U i) (U j)) (U i) ≃ₗ[k] U i :=
  (GradedModuleCat.bimoduleTensorUnderlyingEquiv Γ Γ Γ (T (U i) (U j)) (U i)).trans
    ((BalancedTensorProduct.congr (adjacentPairRightFactors k G h)
      (zigzagBraidBimoduleFactorsEquiv k G i)
      (adjacentPairRightFactors_equivariant k G h)
      (adjacentVertexFactors_equivariant k G i)).trans
    ((BalancedTensorProduct.outerFactors k Z (R j) (L i) (L i) (R i)).trans
    ((TensorProduct.congr (zigzagAdjacentBalancedTensorEquiv k G h.symm)
      (LinearEquiv.refl k _)).trans
    ((TensorProduct.lid k (L i ⊗[k] R i)).trans
      (zigzagBraidBimoduleFactorsEquiv k G i).symm))))

private theorem adjacentPairRightFactors_tmul {i j : V} (h : G.Adj j i)
    (l : L i) (r : R i) (l' : L j) (r' : R j) :
    adjacentPairRightFactors k G h
      (GradedModuleCat.bimoduleTensorTmul Γ Γ Γ (U i) (U j)
        ((zigzagBraidBimoduleFactorsEquiv k G i).symm (l ⊗ₜ[k] r))
        ((zigzagBraidBimoduleFactorsEquiv k G j).symm (l' ⊗ₜ[k] r'))) =
      r' ⊗ₜ[k] ((zigzagAdjacentBalancedTensorEquiv k G h
        (BalancedTensorProduct.tmul k Z r l')) • l) := by
  simp only [adjacentPairRightFactors, adjacentPairFactorsEquiv, LinearEquiv.trans_apply,
    zigzagBraidTensorCornerEquiv_tmul, TensorProduct.congr_tmul, LinearEquiv.refl_apply,
    TensorProduct.lid_tmul, map_smul, TensorProduct.comm_tmul]
  rw [zigzagAdjacentBalancedTensorEquiv_tmul, zigzagAlgebraAdjacentCornerEquiv_apply,
    coe_spanSingletonBalancedTensorProductEquivCorner_tmul, TensorProduct.tmul_smul]

/-- On pure vertex factors, the two middle arrow coordinates multiply the surviving
outer factors. This formula concerns carriers; the two internal arrow degrees sum to two. -/
@[simp]
theorem zigzagBraidAdjacentTripleUnderlyingEquiv_tmul {i j : V} (h : G.Adj j i)
    (l : L i) (r : R i) (l' : L j) (r' : R j) (l'' : L i) (r'' : R i) :
    zigzagBraidAdjacentTripleUnderlyingEquiv k G h
      (GradedModuleCat.bimoduleTensorTmul Γ Γ Γ (T (U i) (U j)) (U i)
        (GradedModuleCat.bimoduleTensorTmul Γ Γ Γ (U i) (U j)
          ((zigzagBraidBimoduleFactorsEquiv k G i).symm (l ⊗ₜ[k] r))
          ((zigzagBraidBimoduleFactorsEquiv k G j).symm (l' ⊗ₜ[k] r')))
        ((zigzagBraidBimoduleFactorsEquiv k G i).symm (l'' ⊗ₜ[k] r''))) =
      (zigzagAdjacentBalancedTensorEquiv k G h.symm
          (BalancedTensorProduct.tmul k Z r' l'')) •
        (zigzagAdjacentBalancedTensorEquiv k G h
          (BalancedTensorProduct.tmul k Z r l')) •
            (zigzagBraidBimoduleFactorsEquiv k G i).symm (l ⊗ₜ[k] r'') := by
  simp only [zigzagBraidAdjacentTripleUnderlyingEquiv, LinearEquiv.trans_apply]
  rw [GradedModuleCat.bimoduleTensorUnderlyingEquiv_tmul Γ Γ Γ (T (U i) (U j)) (U i)]
  simp only [BalancedTensorProduct.congr_tmul, adjacentPairRightFactors_tmul,
    LinearEquiv.apply_symm_apply, BalancedTensorProduct.outerFactors_tmul,
    TensorProduct.congr_tmul, LinearEquiv.refl_apply, TensorProduct.lid_tmul,
    TensorProduct.smul_tmul']
  simp only [← TensorProduct.smul_tmul', map_smul]

private def adjacentArrowLeft {i j : V} (h : G.Adj j i) : L j :=
  ⟨zigzagAlgebraBasis k G (.inr (.inl (⟨(j, i), h⟩ : G.Dart))), by
    rw [mem_span_singleton_iff_mul_eq_self (isIdempotentElem_zigzagAlgebraBasis_inl k G j)]
    simp⟩

private def adjacentVertexGenerator (i : V) : U i :=
  (zigzagBraidBimoduleFactorsEquiv k G i).symm
    (spanSingletonGenerator (e i) ⊗ₜ[k] spanSingletonGenerator (op (e i)))

private def adjacentArrowVertex {i j : V} (h : G.Adj j i) : U j :=
  (zigzagBraidBimoduleFactorsEquiv k G j).symm
    (adjacentArrowLeft k G h ⊗ₜ[k] spanSingletonGenerator (op (e j)))

private def adjacentTripleGenerator {i j : V} (h : G.Adj j i) :
    T (T (U i) (U j)) (U i) :=
  GradedModuleCat.bimoduleTensorTmul Γ Γ Γ (T (U i) (U j)) (U i)
    (GradedModuleCat.bimoduleTensorTmul Γ Γ Γ (U i) (U j)
      (adjacentVertexGenerator k G i) (adjacentArrowVertex k G h))
    (adjacentArrowVertex k G h.symm)

private theorem adjacentVertexGenerator_mem (i : V) :
    adjacentVertexGenerator k G i ∈ (U i).grading.piece 0 := by
  have he : e i ∈ zigzagAlgebraIntegerGrade k G 0 :=
    (zigzagAlgebraIntegerGrade_ofNat k G 0).ge
      (zigzagAlgebraBasis_inl_mem_grade_zero k G i)
  apply mem_zigzagBraidBimoduleGrade_iff.mpr
  simp only [adjacentVertexGenerator, coe_zigzagBraidBimoduleFactorsEquiv_symm_tmul,
    coe_spanSingletonGenerator]
  exact tmul_mem_zigzagEnvelopingGrading he he

private theorem adjacentArrowVertex_mem {i j : V} (h : G.Adj j i) :
    adjacentArrowVertex k G h ∈ (U j).grading.piece 1 := by
  have he : e j ∈ zigzagAlgebraIntegerGrade k G 0 :=
    (zigzagAlgebraIntegerGrade_ofNat k G 0).ge
      (zigzagAlgebraBasis_inl_mem_grade_zero k G j)
  have ha : zigzagAlgebraBasis k G (.inr (.inl (⟨(j, i), h⟩ : G.Dart))) ∈
      zigzagAlgebraIntegerGrade k G 1 :=
    (zigzagAlgebraIntegerGrade_ofNat k G 1).ge
      (zigzagAlgebraBasis_inr_inl_mem_grade_one k G _)
  apply mem_zigzagBraidBimoduleGrade_iff.mpr
  simp only [adjacentArrowVertex, coe_zigzagBraidBimoduleFactorsEquiv_symm_tmul,
    coe_spanSingletonGenerator, adjacentArrowLeft]
  simpa only [add_zero] using tmul_mem_zigzagEnvelopingGrading ha he

private theorem adjacentTripleGenerator_mem {i j : V} (h : G.Adj j i) :
    adjacentTripleGenerator k G h ∈ (T (T (U i) (U j)) (U i)).grading.piece 2 := by
  exact GradedModuleCat.bimoduleTensorTmul_mem Γ Γ Γ (T (U i) (U j)) (U i)
    (GradedModuleCat.bimoduleTensorTmul_mem Γ Γ Γ (U i) (U j)
      (adjacentVertexGenerator_mem k G i) (adjacentArrowVertex_mem k G h))
    (adjacentArrowVertex_mem k G h.symm)

private def adjacentTripleInsert {i j : V} (h : G.Adj j i) :
    U i →ₗ[E] T (T (U i) (U j)) (U i) :=
  (LinearMap.toSpanSingleton E _ (adjacentTripleGenerator k G h)).comp
    (zigzagBraidBimodule k G i).subtype

private theorem adjacentTripleInsert_apply {i j : V} (h : G.Adj j i) (u : U i) :
    adjacentTripleInsert k G h u = (u : zigzagBraidBimodule k G i).val •
      adjacentTripleGenerator k G h := (rfl)

/-- Insert the two opposite middle arrows. The total internal degree is two, so the
source is the vertex bimodule shifted by two and this morphism has degree zero. -/
def zigzagBraidAdjacentTripleInsert {i j : V} (h : G.Adj j i) :
    (U i).shiftObj 2 ⟶ T (T (U i) (U j)) (U i) :=
  GradedModuleCat.ofHom (adjacentTripleInsert k G h) <|
    (by
      rw [LinearMap.isHomogeneous_def]
      intro p u hu
      have hu' := ((U i).mem_shiftObj_piece_iff 2 p u).mp hu
      have hz := adjacentTripleGenerator_mem k G h
      have hdeg : (p - 2) + 2 = p + 0 := by omega
      simpa only [adjacentTripleInsert_apply, vadd_eq_add, hdeg] using
        SetLike.GradedSMul.smul_mem (mem_zigzagBraidBimoduleGrade_iff.mp hu') hz)

private theorem adjacentTripleInsert_factors {i j : V} (h : G.Adj j i)
    (l : L i) (r : R i) :
    adjacentTripleInsert k G h ((zigzagBraidBimoduleFactorsEquiv k G i).symm (l ⊗ₜ[k] r)) =
      GradedModuleCat.bimoduleTensorTmul Γ Γ Γ (T (U i) (U j)) (U i)
        (GradedModuleCat.bimoduleTensorTmul Γ Γ Γ (U i) (U j)
          ((zigzagBraidBimoduleFactorsEquiv k G i).symm
            (l ⊗ₜ[k] spanSingletonGenerator (op (e i))))
          (adjacentArrowVertex k G h))
        ((zigzagBraidBimoduleFactorsEquiv k G i).symm
          (adjacentArrowLeft k G h.symm ⊗ₜ[k] r)) := by
  have he := isIdempotentElem_zigzagAlgebraBasis_inl k G i
  have heop : IsIdempotentElem (op (e i)) := by rw [IsIdempotentElem, ← op_mul, he.eq]
  rw [adjacentTripleInsert_apply, coe_zigzagBraidBimoduleFactorsEquiv_symm_tmul,
    adjacentTripleGenerator]
  rw [GradedModuleCat.tmul_smul_bimoduleTensorTmul Γ Γ Γ (T (U i) (U j)) (U i),
    GradedModuleCat.tmul_smul_bimoduleTensorTmul Γ Γ Γ (U i) (U j)]
  simp only [adjacentVertexGenerator, adjacentArrowVertex,
    zigzagBraidBimoduleFactorsEquiv_symm_tmul_smul, one_smul,
    smul_spanSingletonGenerator he, smul_spanSingletonGenerator heop]

private theorem adjacentTripleUnderlyingEquiv_insert {i j : V} (h : G.Adj j i)
    (u : U i) :
    zigzagBraidAdjacentTripleUnderlyingEquiv k G h (adjacentTripleInsert k G h u) = u := by
  classical
  have key (t : L i ⊗[k] R i) :
      zigzagBraidAdjacentTripleUnderlyingEquiv k G h
        (adjacentTripleInsert k G h ((zigzagBraidBimoduleFactorsEquiv k G i).symm t)) =
          (zigzagBraidBimoduleFactorsEquiv k G i).symm t := by
    induction t using TensorProduct.inductionOn with
    | tmul l r =>
      rw [adjacentTripleInsert_factors]
      simp only [adjacentArrowVertex]
      rw [zigzagBraidAdjacentTripleUnderlyingEquiv_tmul]
      simp [zigzagAdjacentBalancedTensorEquiv_tmul, adjacentArrowLeft]
    | add x y hx hy => simp only [map_add, hx, hy]
  simpa only [LinearEquiv.symm_apply_apply] using key (zigzagBraidBimoduleFactorsEquiv k G i u)

private theorem bijective_adjacentTripleInsert {i j : V} (h : G.Adj j i) :
    Function.Bijective (adjacentTripleInsert k G h) :=
  ⟨fun x y heq ↦ by
    simpa only [adjacentTripleUnderlyingEquiv_insert] using
      congrArg (zigzagBraidAdjacentTripleUnderlyingEquiv k G h) heq,
   fun t ↦ ⟨zigzagBraidAdjacentTripleUnderlyingEquiv k G h t, by
     apply (zigzagBraidAdjacentTripleUnderlyingEquiv k G h).injective
     exact adjacentTripleUnderlyingEquiv_insert k G h _⟩⟩

private theorem isIso_adjacentTripleInsert {i j : V} (h : G.Adj j i) :
    IsIso (zigzagBraidAdjacentTripleInsert k G h) :=
  (GradedModuleCat.isIso_iff_bijective _).2 <| by
    simpa only [zigzagBraidAdjacentTripleInsert, GradedModuleCat.hom_ofHom] using
      bijective_adjacentTripleInsert k G h

/-- At adjacent vertices, the top actual triple tensor is the vertex bimodule shifted by two. -/
def zigzagBraidAdjacentTripleIso {i j : V} (h : G.Adj j i) :
    T (T (U i) (U j)) (U i) ≅ (U i).shiftObj 2 := by
  haveI := isIso_adjacentTripleInsert k G h
  exact (asIso (zigzagBraidAdjacentTripleInsert k G h)).symm

/-- The inverse graded comparison is the insertion of the two opposite arrows. -/
@[simp]
theorem zigzagBraidAdjacentTripleIso_inv {i j : V} (h : G.Adj j i) :
    (zigzagBraidAdjacentTripleIso k G h).inv = zigzagBraidAdjacentTripleInsert k G h := (rfl)

private theorem adjacentArrowLeft_eq {i j : V} (h : G.Adj j i) :
    adjacentArrowLeft k G h =
      zigzagAlgebraBasis k G (.inr (.inl (⟨(j, i), h⟩ : G.Dart))) •
        spanSingletonGenerator (e j) := by
  apply Subtype.ext
  simp [adjacentArrowLeft]

/-- On outer ideal factors, the inverse graded comparison inserts the two middle arrows. -/
@[simp]
theorem zigzagBraidAdjacentTripleInsert_hom_factors {i j : V} (h : G.Adj j i)
    (l : L i) (r : R i) :
    (zigzagBraidAdjacentTripleInsert k G h).hom
        ((zigzagBraidBimoduleFactorsEquiv k G i).symm (l ⊗ₜ[k] r)) =
      GradedModuleCat.bimoduleTensorTmul Γ Γ Γ (T (U i) (U j)) (U i)
        (GradedModuleCat.bimoduleTensorTmul Γ Γ Γ (U i) (U j)
          ((zigzagBraidBimoduleFactorsEquiv k G i).symm
            (l ⊗ₜ[k] spanSingletonGenerator (op (e i))))
          ((zigzagBraidBimoduleFactorsEquiv k G j).symm
            ((zigzagAlgebraBasis k G (.inr (.inl (⟨(j, i), h⟩ : G.Dart))) •
              spanSingletonGenerator (e j)) ⊗ₜ[k]
                spanSingletonGenerator (op (e j)))))
        ((zigzagBraidBimoduleFactorsEquiv k G i).symm
          ((zigzagAlgebraBasis k G (.inr (.inl (⟨(i, j), h.symm⟩ : G.Dart))) •
            spanSingletonGenerator (e i)) ⊗ₜ[k] r)) := by
  simpa only [zigzagBraidAdjacentTripleInsert, GradedModuleCat.hom_ofHom,
    adjacentArrowVertex, adjacentArrowLeft_eq] using adjacentTripleInsert_factors k G h l r

/-- The forward graded comparison computes by the two middle-arrow coordinates. -/
@[simp]
theorem zigzagBraidAdjacentTripleIso_hom_apply {i j : V} (h : G.Adj j i)
    (t : T (T (U i) (U j)) (U i)) :
    (zigzagBraidAdjacentTripleIso k G h).hom.hom t =
      zigzagBraidAdjacentTripleUnderlyingEquiv k G h t := by
  obtain ⟨u, hu⟩ := (bijective_adjacentTripleInsert k G h).2 t
  rw [← hu, adjacentTripleUnderlyingEquiv_insert]
  have heq := congrArg (fun f : (U i).shiftObj 2 ⟶ (U i).shiftObj 2 ↦ f.hom u)
    (Iso.inv_hom_id (zigzagBraidAdjacentTripleIso k G h))
  simpa only [GradedModuleCat.hom_comp, LinearMap.comp_apply,
    zigzagBraidAdjacentTripleIso_inv, zigzagBraidAdjacentTripleInsert,
    GradedModuleCat.hom_ofHom, GradedModuleCat.hom_id, LinearMap.id_apply] using heq

end TauCeti
