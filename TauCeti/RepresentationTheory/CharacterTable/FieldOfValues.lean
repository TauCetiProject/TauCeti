/-!
# Fields of character values

The field of values of a representation is the intermediate field generated by its character
values. It records the arithmetic of the character, rather than a field over which the
representation can be realized: these can differ because of the Schur index.

The character field `Representation.characterField` is defined for an unbundled
`Representation`; `FDRep.characterField` is the bundled case, defined through it. A
representation with finite image over a finite base field has a finite character field
(`Representation.finite_characterField`).

This file characterizes the field by its generators and identifies it with the fixed field of
the automorphisms fixing the character. The latter description works inside any Galois
extension containing the values. For a complex representation of a finite group, the
cyclotomic field generated by a primitive root of order the group exponent supplies such an
extension, without any field-of-definition assumption on the representation.

In a Galois extension, fixing all the character values is equivalent to fixing the
field they generate pointwise.

## References

* J.-P. Serre, *Linear Representations of Finite Groups*, Section 12.4.
* I. M. Isaacs, *Character Theory of Finite Groups*, Chapter 9.
-/

public section

namespace Representation

universe u v w

variable {k : Type u} [Field k] {G : Type v} [Monoid G] {V : Type*} [AddCommGroup V] [Module k V]

/-- The intermediate field generated over `F` by the character values of `ρ`. This is a field
of values, without an assertion that `ρ` has a model over this field. -/
noncomputable def characterField (ρ : Representation k G V) (F : Type w) [Field F] [Algebra F k] :
    IntermediateField F k :=
  IntermediateField.adjoin F (Set.range ρ.character)

/-- The character field is the intermediate field adjoined by the range of the character. -/
theorem characterField_def (ρ : Representation k G V) (F : Type w) [Field F] [Algebra F k] :
    ρ.characterField F = IntermediateField.adjoin F (Set.range ρ.character) :=
  (rfl)

/-- Every character value belongs to the character field. -/
@[simp]
theorem character_mem_characterField (ρ : Representation k G V) (F : Type w) [Field F]
    [Algebra F k] (g : G) : ρ.character g ∈ ρ.characterField F :=
  IntermediateField.subset_adjoin F _ (Set.mem_range_self g)

/-- The character field is the smallest intermediate field containing all character values. -/
@[simp]
theorem characterField_le_iff (ρ : Representation k G V) (F : Type w) [Field F] [Algebra F k]
    (L : IntermediateField F k) : ρ.characterField F ≤ L ↔ ∀ g, ρ.character g ∈ L := by
  simp [characterField_def, IntermediateField.adjoin_le_iff, Set.range_subset_iff]

/-- Equivalent representations have the same field of character values. -/
theorem characterField_eq_of_equiv {W : Type*} [AddCommGroup W] [Module k W]
    {ρ : Representation k G V} {σ : Representation k G W} (φ : ρ.Equiv σ) (F : Type w) [Field F]
    [Algebra F k] : ρ.characterField F = σ.characterField F := by
  rw [characterField_def, characterField_def, char_iso φ]

/-- **A representation with finite image over a finite field has a finite character field.** -/
theorem finite_characterField {ρ : Representation k G V} (F : Type w) [Field F] [Finite F]
    [Algebra F k] (h : (Set.range ρ).Finite) : Finite (ρ.characterField F) := by
  have hfin : (Set.range ρ.character).Finite := by
    have : Set.range ρ.character = LinearMap.trace k V '' Set.range ρ := by
      ext; simp [character]
    exact this ▸ h.image _
  have : Finite (Set.range ρ.character) := hfin.to_subtype
  have : FiniteDimensional F (ρ.characterField F) := by
    rw [characterField_def]
    exact IntermediateField.finiteDimensional_adjoin fun _ ⟨g, hg⟩ =>
      hg ▸ ρ.isIntegral_character_of_finite_range h g
  exact Module.finite_of_finite F

end Representation

namespace FDRep

universe u v w

variable {k : Type u} [Field k] {G : Type v} [Monoid G]

/-- The intermediate field generated over `F` by the character values of `X`: the character field
`Representation.characterField` of the underlying representation `X.ρ`. -/
noncomputable def characterField (X : FDRep k G) (F : Type w) [Field F] [Algebra F k] :
    IntermediateField F k :=
  Representation.characterField X.ρ F

/-- The character field of `X` is that of its underlying representation. -/
theorem characterField_ρ (X : FDRep k G) (F : Type w) [Field F] [Algebra F k] :
    Representation.characterField X.ρ F = X.characterField F :=
  (rfl)

/-- The character field is the intermediate field adjoined by the range of the character. -/
theorem characterField_def (X : FDRep k G) (F : Type w) [Field F] [Algebra F k] :
    X.characterField F = IntermediateField.adjoin F (Set.range X.character) := by
  simpa only [characterField_ρ, funext (character_ρ X)] using
    Representation.characterField_def X.ρ F

/-- Every character value belongs to the character field. -/
@[simp]
theorem character_mem_characterField (X : FDRep k G) (F : Type w) [Field F] [Algebra F k]
    (g : G) : X.character g ∈ X.characterField F := by
  simpa only [characterField_ρ, character_ρ] using
    Representation.character_mem_characterField X.ρ F g

/-- The character field is the smallest intermediate field containing all character values. -/
@[simp]
theorem characterField_le_iff (X : FDRep k G) (F : Type w) [Field F] [Algebra F k]
    (L : IntermediateField F k) : X.characterField F ≤ L ↔ ∀ g, X.character g ∈ L := by
  simpa only [characterField_ρ, character_ρ] using Representation.characterField_le_iff X.ρ F L

/-- Isomorphic representations have the same field of character values. -/
theorem characterField_eq_of_iso (X Y : FDRep k G) (e : X ≅ Y) (F : Type w) [Field F]
    [Algebra F k] : X.characterField F = Y.characterField F := by
  rw [characterField_def, characterField_def, char_iso e]

/-- An automorphism fixes the character field pointwise exactly when it fixes the character. -/
@[simp]
theorem forall_mem_characterField_apply_eq_self_iff (X : FDRep k G) (F : Type w) [Field F]
    [Algebra F k] (σ : k ≃ₐ[F] k) :
    (∀ x ∈ X.characterField F, σ x = x) ↔ ∀ g, σ (X.character g) = X.character g := by
  simpa [characterField_def, Set.forall_mem_range] using
    (IntermediateField.forall_mem_adjoin_smul_eq_self_iff F
      (S := Set.range X.character) σ)

/-- Inside any Galois extension containing the character values, their pointwise
stabilizer has fixed field equal to the field of values, viewed in the original coefficient
field through the inclusion of the extension. -/
theorem lift_fixedField_fixingSubgroup_character (X : FDRep k G) (F : Type w) [Field F]
    [Algebra F k] (L : IntermediateField F k) [IsGalois F L]
    (hL : ∀ g, X.character g ∈ L) :
    IntermediateField.lift (F := L)
      (IntermediateField.fixedField (_root_.fixingSubgroup (L ≃ₐ[F] L)
        {x : L | (x : k) ∈ Set.range X.character})) = X.characterField F := by
  let χ : G → L := fun g ↦ ⟨X.character g, hL g⟩
  have hS : {x : L | (x : k) ∈ Set.range X.character} = Set.range χ := by
    ext x
    simp [χ, Subtype.ext_iff]
  have hfix : _root_.fixingSubgroup (L ≃ₐ[F] L) (Set.range χ) =
      ⨅ g, MulAction.stabilizer (L ≃ₐ[F] L) (χ g) := by
    ext σ
    simp [_root_.mem_fixingSubgroup_iff, MulAction.mem_stabilizer_iff]
  -- Use the family-stabilizer theorem from `TauCeti.FieldTheory.Galois.FixedField`.
  rw [hS, hfix, IntermediateField.fixedField_iInf_stabilizer_eq_adjoin_range,
    IntermediateField.lift_adjoin, ← Set.range_comp, characterField_def]
  rfl

section FiniteGroup

variable {G : Type v} [Group G] [Finite G] [Algebra ℚ k]

/-- The field of values of a finite-group character in characteristic zero is a finite
extension of `ℚ`. -/
instance finiteDimensional_characterField (X : FDRep k G) :
    FiniteDimensional ℚ (X.characterField ℚ) := by
  let : Finite (Set.range X.character) := Set.finite_range X.character |>.to_subtype
  rw [characterField_def]
  exact IntermediateField.finiteDimensional_adjoin fun _ ⟨g, hg⟩ ↦
    hg ▸ (X.isIntegral_character g).tower_top

end FiniteGroup

section Complex

variable {G : Type v} [Group G] [Finite G]

/-- The field of a complex character lies in the cyclotomic field of the group exponent. -/
theorem characterField_le_adjoin_of_isPrimitiveRoot (X : FDRep ℂ G) {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ (Monoid.exponent G)) :
    X.characterField ℚ ≤ IntermediateField.adjoin ℚ {ζ} := by
  rw [characterField_le_iff]
  intro g
  have h : Algebra.adjoin ℤ ({ζ} : Set ℂ) ≤
      (IntermediateField.adjoin ℚ {ζ}).toSubalgebra.restrictScalars ℤ :=
    Algebra.adjoin_le fun _ hz ↦ IntermediateField.subset_adjoin ℚ _ hz
  exact h (X.char_mem_adjoin_of_isPrimitiveRoot hζ g)

/-- The field of values of a complex character is the fixed field of its stabilizer in the
cyclotomic Galois group, embedded back into `ℂ`. -/
theorem lift_fixedField_fixingSubgroup_character_of_isPrimitiveRoot (X : FDRep ℂ G) {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ (Monoid.exponent G)) :
    IntermediateField.lift (F := IntermediateField.adjoin ℚ {ζ})
      (IntermediateField.fixedField (_root_.fixingSubgroup
        ((IntermediateField.adjoin ℚ {ζ}) ≃ₐ[ℚ] (IntermediateField.adjoin ℚ {ζ}))
        {x : IntermediateField.adjoin ℚ {ζ} | (x : ℂ) ∈ Set.range X.character})) =
      X.characterField ℚ := by
  let n := Monoid.exponent G
  let : NeZero n := ⟨Monoid.exponent_ne_zero_of_finite⟩
  let L := IntermediateField.adjoin ℚ {ζ}
  let : IsCyclotomicExtension {n} ℚ L :=
    (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin n ℚ ℂ L hζ).2 rfl
  let : IsGalois ℚ L := IsCyclotomicExtension.isGalois {n} ℚ L
  exact X.lift_fixedField_fixingSubgroup_character ℚ L
    ((X.characterField_le_iff ℚ L).1 (X.characterField_le_adjoin_of_isPrimitiveRoot hζ))

end Complex

end FDRep
