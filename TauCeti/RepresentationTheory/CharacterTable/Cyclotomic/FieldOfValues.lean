/-!
# The field of values as a fixed field of power maps

The Galois group of a cyclotomic field acts on the virtual characters of a finite group by
`(σ · χ)(g) = χ(g ^ j)`, with `j` the cyclotomic exponent of `σ`. This file identifies the field
generated by the values of `χ` with the image of the fixed field of the stabilizer of `χ`, so the
field of values is computed from the power maps of the group alone. No automorphism of the
algebraically closed coefficient field is chosen.

The stabilizer makes sense for every function on `G`, but the identification needs a virtual
character: on the cyclic group of order three, a function with the constant value `i` off the
identity is fixed by every power map, while its values generate a field containing `i`.

## Main definitions

* `IsPrimitiveRoot.cyclotomicPowerStabilizer`: the automorphisms of a field containing a primitive
  root whose cyclotomic exponent fixes a given function on a monoid.

## Main results

* `IsPrimitiveRoot.adjoin_range_eq_map_fixedField_cyclotomicPowerStabilizer`: over any Galois
  extension of `ℚ` containing the requisite roots of unity, the field of values of a virtual
  character is the image of the fixed field of its power-map stabilizer.
* `TauCeti.fieldOfValues_eq_map_fixedField_stabilizer`: the case of an irreducible complex
  character and the exponent cyclotomic field.
* `FDRep.characterField_eq_map_fixedField_cyclotomicPowerStabilizer`: the same identification for
  the field of values of a representation.

## References

* J.-P. Serre, *Linear Representations of Finite Groups* (1977), §§12.3–12.4.
* I. M. Isaacs, *Character Theory of Finite Groups* (1976), Chapter 9.
-/

public section

open TauCeti

namespace IsPrimitiveRoot

universe u

section Stabilizer

variable {K : Type*} [Field K] [Algebra ℚ K] {G X : Type*} [Monoid G]
  {n : ℕ} [NeZero n] {ζ : K}

/-- The automorphisms `σ` of `K` fixing `f` under the power-map action `(σ · f)(g) = f (g ^ j)`,
with `j` the cyclotomic exponent of `σ` relative to `ζ`. -/
noncomputable def cyclotomicPowerStabilizer (hζ : IsPrimitiveRoot ζ n)
    (hG : Monoid.exponent G ∣ n) (f : G → X) : Subgroup Gal(K/ℚ) where
  carrier := {σ | ∀ g, f (g ^ (hζ.autToPow ℚ σ : ZMod n).val) = f g}
  one_mem' g := by
    rw [map_one, Units.val_one, pow_val_one (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp hG g)]
  mul_mem' {σ τ} hσ hτ g := by
    rw [map_mul, Units.val_mul, pow_val_mul (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp hG g)]
    exact (hτ _).trans (hσ g)
  inv_mem' {σ} hσ g := by
    have hg := Monoid.exponent_dvd_iff_forall_pow_eq_one.mp hG g
    rw [← hσ (g ^ _), ← pow_val_mul hg, map_inv, Units.inv_mul, pow_val_one hg]

/-- Membership in the power-map stabilizer. -/
@[simp]
theorem mem_cyclotomicPowerStabilizer_iff (hζ : IsPrimitiveRoot ζ n)
    (hG : Monoid.exponent G ∣ n) (f : G → X) (σ : Gal(K/ℚ)) :
    σ ∈ cyclotomicPowerStabilizer hζ hG f ↔
      ∀ g, f (g ^ (hζ.autToPow ℚ σ : ZMod n).val) = f g :=
  Iff.rfl

end Stabilizer

section Field

variable {K L G : Type u} [Field K] [Field L] [Algebra K L] [CharZero K] [Algebra ℚ K]
  [Group G] [Finite G] [IsAlgClosed L] {n : ℕ} [NeZero n] {ζ : K}

/-- A virtual character is fixed by `σ` for the cyclotomic Galois action exactly when `σ` lies in
its power-map stabilizer. -/
theorem cyclotomicVirtualCharacterAction_apply_eq_self_iff (hζ : IsPrimitiveRoot ζ n)
    (hG : Monoid.exponent G ∣ n) (σ : Gal(K/ℚ)) (χ : virtualCharacters L G) :
    Multiplicative.toAdd (cyclotomicVirtualCharacterAction hζ hG σ) χ = χ ↔
      σ ∈ cyclotomicPowerStabilizer hζ hG χ.1 := by
  rw [Subtype.ext_iff, funext_iff]
  exact forall_congr' fun g ↦ by rw [cyclotomicVirtualCharacterAction_apply]

/-- An irreducible character is fixed by `σ` for the cyclotomic Galois action exactly when `σ` lies
in its power-map stabilizer. -/
theorem cyclotomicIrreducibleCharacterAction_apply_eq_self_iff (hζ : IsPrimitiveRoot ζ n)
    (hG : Monoid.exponent G ∣ n) (σ : Gal(K/ℚ)) (χ : irreducibleCharacters L G) :
    cyclotomicIrreducibleCharacterAction hζ hG σ χ = χ ↔
      σ ∈ cyclotomicPowerStabilizer hζ hG χ.1 := by
  rw [Subtype.ext_iff, funext_iff]
  exact forall_congr' fun g ↦ by rw [cyclotomicIrreducibleCharacterAction_apply]

/-- The power-map stabilizer of a scalar-extended virtual character consists of the automorphisms
fixing each of its values in the splitting field. -/
theorem mem_cyclotomicPowerStabilizer_cyclotomicVirtualCharacterEquiv_iff
    (hζ : IsPrimitiveRoot ζ n) (hG : Monoid.exponent G ∣ n) (ψ : virtualCharacters K G)
    (σ : Gal(K/ℚ)) :
    σ ∈ cyclotomicPowerStabilizer hζ hG (cyclotomicVirtualCharacterEquiv (L := L) hζ hG ψ).1 ↔
      ∀ g, σ (ψ.1 g) = ψ.1 g := by
  rw [mem_cyclotomicPowerStabilizer_iff]
  refine forall_congr' fun g ↦ ?_
  rw [← cyclotomicVirtualCharacterAction_apply hζ hG σ,
    cyclotomicVirtualCharacterAction_equiv_apply, cyclotomicVirtualCharacterEquiv_apply,
    (algebraMap K L).injective.eq_iff]

variable [Algebra ℚ L]

omit [CharZero K] in
/-- **The field of values of a virtual character.** Over a Galois extension `K` of `ℚ` containing
a primitive `n`-th root of unity, with the exponent of `G` dividing `n`, the field generated by the
values of a virtual character `χ` over an algebraically closed extension of `K` is the image of the
fixed field of the power-map stabilizer of `χ`. -/
theorem adjoin_range_eq_map_fixedField_cyclotomicPowerStabilizer [IsGalois ℚ K]
    (hζ : IsPrimitiveRoot ζ n) (hG : Monoid.exponent G ∣ n) {χ : G → L}
    (hχ : χ ∈ virtualCharacters L G) :
    IntermediateField.adjoin ℚ (Set.range χ) =
      (IntermediateField.fixedField (cyclotomicPowerStabilizer hζ hG χ)).map
        (algebraMap K L).toRatAlgHom := by
  -- Descend `χ` to the splitting field, where the stabilizer fixes each value.
  have : CharZero K := algebraRat.charZero K
  obtain ⟨ψ, hψ⟩ := (cyclotomicVirtualCharacterEquiv (L := L) hζ hG).surjective ⟨χ, hχ⟩
  have hχψ : χ = (cyclotomicVirtualCharacterEquiv (L := L) hζ hG ψ).1 :=
    (congrArg Subtype.val hψ).symm
  have hstab : cyclotomicPowerStabilizer hζ hG χ =
      ⨅ g, MulAction.stabilizer Gal(K/ℚ) (ψ.1 g) := by
    ext σ
    rw [hχψ, mem_cyclotomicPowerStabilizer_cyclotomicVirtualCharacterEquiv_iff]
    simp [Subgroup.mem_iInf, MulAction.mem_stabilizer_iff]
  rw [hstab, IntermediateField.fixedField_iInf_stabilizer_eq_adjoin_range,
    IntermediateField.adjoin_map, ← Set.range_comp]
  congr 2
  ext g
  simp [hχψ]

end Field

end IsPrimitiveRoot

namespace FDRep

universe u

variable {K L G : Type u} [Field K] [Field L] [Algebra K L] [Algebra ℚ K]
  [Group G] [Finite G] [IsAlgClosed L] [Algebra ℚ L] [IsGalois ℚ K] {n : ℕ} [NeZero n] {ζ : K}

/-- The field of values of a representation is the image of the fixed field of the power-map
stabilizer of its character. -/
theorem characterField_eq_map_fixedField_cyclotomicPowerStabilizer (X : FDRep L G)
    (hζ : IsPrimitiveRoot ζ n) (hG : Monoid.exponent G ∣ n) :
    X.characterField ℚ =
      (IntermediateField.fixedField (hζ.cyclotomicPowerStabilizer hG X.character)).map
        (algebraMap K L).toRatAlgHom :=
  (X.characterField_def ℚ).trans <|
    IsPrimitiveRoot.adjoin_range_eq_map_fixedField_cyclotomicPowerStabilizer hζ hG
      (character_mem_virtualCharacters X)

end FDRep

namespace TauCeti

/-- **The field of values is the fixed field of the stabilizer.** Let `K` be a cyclotomic field of
the exponent of `G`, embedded in `ℂ`, with distinguished primitive root `ζ`. The field `ℚ(χ) ⊆ ℂ`
generated by the values of an irreducible complex character `χ` is the image of the fixed field of
the subgroup of those `σ` with `χ(g ^ j) = χ(g)` for all `g`, with `j` the cyclotomic exponent of
`σ` relative to `ζ`. -/
theorem fieldOfValues_eq_map_fixedField_stabilizer {G : Type} [Group G] [Finite G]
    {K : Type} [Field K] [Algebra ℚ K] [Algebra K ℂ]
    [IsCyclotomicExtension {Monoid.exponent G} ℚ K] {χ : G → ℂ}
    (hχ : χ ∈ irreducibleCharacters ℂ G) :
    IntermediateField.adjoin ℚ (Set.range χ) =
      (IntermediateField.fixedField
        ((IsCyclotomicExtension.zeta_spec (Monoid.exponent G) ℚ K).cyclotomicPowerStabilizer
          dvd_rfl χ)).map (algebraMap K ℂ).toRatAlgHom := by
  have : IsGalois ℚ K := IsCyclotomicExtension.isGalois {Monoid.exponent G} ℚ K
  refine IsPrimitiveRoot.adjoin_range_eq_map_fixedField_cyclotomicPowerStabilizer _ _ ?_
  rw [virtualCharacters_eq_closure_irreducibleCharacters]
  exact AddSubgroup.subset_closure hχ

end TauCeti
