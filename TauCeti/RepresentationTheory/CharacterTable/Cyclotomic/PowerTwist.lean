module

public import Mathlib.NumberTheory.Cyclotomic.Gal
public import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed
public import TauCeti.RepresentationTheory.CharacterTable.Cyclotomic.Action
public import TauCeti.RepresentationTheory.CharacterTable.Determined

/-!
# Power-map twists of characters and their determinants

For a finite group `G` and `j` coprime to `|G|`, the function `χ^{(j)} : g ↦ χ(g ^ j)` is an
irreducible character whenever `χ` is (`TauCeti.pow_mem_irreducibleCharacters`), over any
algebraically closed field of characteristic zero. It is the image of `χ` under the
cyclotomic Galois action of the automorphism `ζ ↦ ζ ^ j` of the `|G|`-th cyclotomic field,
embedded in the coefficient field.

The determinant of a representation affording `χ^{(j)}` is the `j`-th power of the determinant of
one affording `χ` (`Representation.det_eq_det_pow_of_character_eq`). The proof restricts both
representations to the finite cyclic subgroup generated by an element `x`: there the first is
equivalent to the second precomposed with `y ↦ y ^ j`, since the two have the same character. So
`det ρ'(x) = det ρ(x ^ j) = (det ρ(x)) ^ j`, without a realization of either representation over a
smaller field.

## Main results

* `TauCeti.pow_mem_irreducibleCharacters`: `χ^{(j)}` is irreducible for `j` coprime to `|G|`.
* `Representation.det_eq_det_pow_of_character_eq`: if `χ_{ρ'}(y) = χ_ρ(y ^ j)` on the powers of an
  element `x` of finite order, then `det ρ'(x) = (det ρ(x)) ^ j`.
-/

public section

open Module IntermediateField

namespace TauCeti

variable {k G : Type*} [Field k] [IsAlgClosed k] [CharZero k] [Group G] [Finite G]

/-- **Power maps preserve irreducible characters.** For `j` coprime to `|G|`, the function
`g ↦ χ(g ^ j)` is an irreducible character of `G` whenever `χ` is. -/
theorem pow_mem_irreducibleCharacters {χ : G → k} (hχ : χ ∈ irreducibleCharacters k G) {j : ℕ}
    (hj : j.Coprime (Nat.card G)) : (fun g => χ (g ^ j)) ∈ irreducibleCharacters k G := by
  have : NeZero (Nat.card G) := ⟨Nat.card_pos.ne'⟩
  have : NeZero (Nat.card G : k) := ⟨Nat.cast_ne_zero.2 Nat.card_pos.ne'⟩
  obtain ⟨ζ, hζ₀⟩ := HasEnoughRootsOfUnity.exists_isPrimitiveRoot k (Nat.card G)
  have := hζ₀.intermediateField_adjoin_isCyclotomicExtension ℚ
  have hζ := IsCyclotomicExtension.zeta_spec (Nat.card G) ℚ ℚ⟮ζ⟯
  have hG : Monoid.exponent G ∣ Nat.card G := Group.exponent_dvd_nat_card
  have hirr := Polynomial.cyclotomic.irreducible_rat (NeZero.pos (Nat.card G))
  let σ := (IsCyclotomicExtension.autEquivPow ℚ⟮ζ⟯ hirr).symm (ZMod.unitOfCoprime j hj)
  have hσ : (hζ.autToPow ℚ σ : ZMod (Nat.card G)).val = j % Nat.card G := by
    rw [← IsCyclotomicExtension.autEquivPow_apply _ hirr, MulEquiv.apply_symm_apply,
      ZMod.coe_unitOfCoprime, ZMod.val_natCast]
  convert (hζ.cyclotomicIrreducibleCharacterAction (L := k) hG σ ⟨χ, hχ⟩).property using 1
  funext g
  rw [IsPrimitiveRoot.cyclotomicIrreducibleCharacterAction_apply, hσ, pow_mod_natCard]

end TauCeti

namespace Representation

universe u v w

variable {k : Type u} {G : Type v} {V W : Type w} [Field k] [CharZero k] [Group G]
  [AddCommGroup V] [Module k V] [FiniteDimensional k V] [AddCommGroup W] [Module k W]
  [FiniteDimensional k W]

/-- **Determinants of power-map twists.** Let `x` be an element of finite order. If the character
of `ρ'` at every power `y` of `x` is the character of `ρ` at `y ^ j`, then
`det ρ'(x) = (det ρ(x)) ^ j`. -/
theorem det_eq_det_pow_of_character_eq (ρ : Representation k G V) (ρ' : Representation k G W)
    {x : G} (hx : IsOfFinOrder x) {j : ℕ}
    (h : ∀ y ∈ Subgroup.zpowers x, ρ'.character y = ρ.character (y ^ j)) :
    (ρ' x).det = (ρ x).det ^ j := by
  let H := Subgroup.zpowers x
  have : Finite H := hx.finite_zpowers
  let f : H →* G :=
    { toFun y := (y : G) ^ j
      map_one' := by simp
      map_mul' a b := by
        obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.1 a.property
        obtain ⟨m', hm'⟩ := Subgroup.mem_zpowers_iff.1 b.property
        have hab : Commute (a : G) (b : G) := by
          rw [← hm, ← hm']
          exact (Commute.refl x).zpow_zpow m m'
        exact hab.mul_pow j }
  have hchar : Representation.character (ρ'.comp H.subtype) =
      Representation.character (ρ.comp f) := by
    funext y
    simpa [Representation.character, f] using h y y.property
  obtain ⟨E⟩ := Representation.nonempty_equiv_of_character_eq _ _ hchar
  have hE := E.conj_apply_self ⟨x, Subgroup.mem_zpowers x⟩
  have hdet := congrArg LinearMap.det hE
  rw [LinearEquiv.conj_apply, LinearMap.comp_assoc, LinearMap.det_conj] at hdet
  simpa [f, map_pow] using hdet

end Representation
