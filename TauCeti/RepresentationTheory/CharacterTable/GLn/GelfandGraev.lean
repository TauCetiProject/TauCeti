module

-- `IsRegularChar` occurs in the definition of the Gelfand–Graev representation.
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.UpperUnitriangular.RegularCharacter
-- `indFDRep` and `FDRep` occur in the statements.
public import TauCeti.RepresentationTheory.Induction.FiniteDimensional.Basic
-- `FDRep.ofLinearCharacter` occurs in the statements.
public import TauCeti.RepresentationTheory.LinearCharacter.Basic
-- Non-public: `ordCompl[p]` is the prime-to-`p` part of a natural number.
import Mathlib.Data.Nat.Factorization.Basic
-- Non-public: the degree of an induced linear character is the index of its subgroup.
import TauCeti.RepresentationTheory.Induction.LinearCharacter
-- Non-public: `index_upperUnitriangularGroup` is the index of the upper-unitriangular group.
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.UpperUnitriangular.Card
-- Non-public: `natCard_GL_fin` is the order of `GLₙ₊₁(F)` over a field.
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Card
-- Non-public: `FiniteField.card` writes the order of `F` as a power of its characteristic.
import Mathlib.FieldTheory.Finite.Basic
-- Non-public: `Nat.coprime_prod_right_iff` shows the index is prime to the characteristic.
import Mathlib.Data.Nat.GCD.BigOperators
-- Non-public: `CharP.char_is_prime` is the primality of the characteristic of `F`.
import Mathlib.Algebra.CharP.Lemmas
-- Non-public: `Nat.coprime_pow_sub_one` shows that each factor of the index is prime to `p`.
import TauCeti.Data.Nat.GCD

/-!
# The Gelfand–Graev representation of `GLₙ₊₁(F)`

Let `F` be a finite field. The **Gelfand–Graev representation** of `GLₙ₊₁(F)` is the
representation induced from a regular character `χ` of the upper-unitriangular subgroup
`Uₙ₊₁(F)` (`TauCeti.UpperUnitriangularGroup.IsRegularChar`), with values in the units `kˣ` of a
field `k`. A character is a homomorphism to a commutative monoid; it is regular when it is
nontrivial on the root subgroup of every simple positive root (every character is trivial on the
subgroup `U²` generated by the root subgroups of the non-simple positive roots, the commutator
subgroup of `Uₙ₊₁(F)`). With values in an `RCLike` field such as `ℂ`, the regular
characters are exactly the characters `u ↦ ψ₀ (∑ᵢ aᵢ uᵢ,ᵢ₊₁)` with every `aᵢ ≠ 0`, for a
primitive additive character `ψ₀` of `F`
(`TauCeti.UpperUnitriangularGroup.isRegularChar_iff`).

Induction multiplies the dimension by the index, so the degree is the index of `Uₙ₊₁(F)` in
`GLₙ₊₁(F)`, which is `∏_{i = 1}^{n + 1} (q ^ i - 1)` over a field with `q` elements. For `p` the
characteristic of `F`, this is the prime-to-`p` part `|GLₙ₊₁(F)|ₚ′` of the group order: the index
is prime to `p`, and `Uₙ₊₁(F)` has order `q ^ (n (n + 1) / 2)`.

## Main declarations

* `TauCeti.gelfandGraev`: the Gelfand–Graev representation `Ind_{Uₙ₊₁(F)}^{GLₙ₊₁(F)} χ`.
* `TauCeti.finrank_gelfandGraev`: its degree is `∏_{i = 1}^{n + 1} (q ^ i - 1)`.
* `TauCeti.finrank_gelfandGraev_eq_ordCompl`: its degree is `|GLₙ₊₁(F)|ₚ′`.

## References

* R. W. Carter, *Finite Groups of Lie Type*, Chapter 5.
* F. Digne, J. Michel, *Representations of Finite Groups of Lie Type*, Cambridge University Press,
  1991, §9.1 and §14.1.
-/

public section

open Matrix

namespace TauCeti

universe u v

variable {k : Type u} [Field k] {n : ℕ} {F : Type v} [Field F] [Finite F]

/-- The **Gelfand–Graev representation** of `GLₙ₊₁(F)` attached to a regular character `χ` of the
upper-unitriangular subgroup `Uₙ₊₁(F)`: the representation induced from the one-dimensional
representation of `Uₙ₊₁(F)` given by `χ`. -/
noncomputable def gelfandGraev
    (χ : {χ : upperUnitriangularGroup (Fin (n + 1)) F →* kˣ //
      UpperUnitriangularGroup.IsRegularChar χ}) : FDRep k (GL (Fin (n + 1)) F) :=
  indFDRep (FDRep.ofLinearCharacter χ.val)

/-- The Gelfand–Graev representation is the representation induced from the character. -/
theorem gelfandGraev_def
    (χ : {χ : upperUnitriangularGroup (Fin (n + 1)) F →* kˣ //
      UpperUnitriangularGroup.IsRegularChar χ}) :
    gelfandGraev χ = indFDRep (FDRep.ofLinearCharacter χ.val) :=
  (rfl)

/-- The degree of the Gelfand–Graev representation is the index of the upper-unitriangular group
in `GLₙ₊₁(F)`: `∏_{i = 1}^{n + 1} (q ^ i - 1)` for a field `F` with `q` elements. -/
@[simp]
theorem finrank_gelfandGraev
    (χ : {χ : upperUnitriangularGroup (Fin (n + 1)) F →* kˣ //
      UpperUnitriangularGroup.IsRegularChar χ}) :
    Module.finrank k (gelfandGraev χ) =
      ∏ i ∈ Finset.range (n + 1), (Nat.card F ^ (i + 1) - 1) := by
  rw [gelfandGraev_def, finrank_indFDRep_ofLinearCharacter, index_upperUnitriangularGroup]

/-- The degree of the Gelfand–Graev representation is the prime-to-`p` part `|GLₙ₊₁(F)|ₚ′` of the
order of `GLₙ₊₁(F)`, where `p` is the characteristic of `F`: the order is `q ^ (n + 1).choose 2`
times the index, `q` is a power of `p`, and the index is prime to `p`. -/
theorem finrank_gelfandGraev_eq_ordCompl (p : ℕ) [CharP F p]
    (χ : {χ : upperUnitriangularGroup (Fin (n + 1)) F →* kˣ //
      UpperUnitriangularGroup.IsRegularChar χ}) :
    Module.finrank k (gelfandGraev χ) = ordCompl[p] (Nat.card (GL (Fin (n + 1)) F)) := by
  have hp : p.Prime := CharP.char_is_prime F p
  have hF := Fintype.ofFinite F
  obtain ⟨f, -, hf⟩ := FiniteField.card F p
  have hfq : Nat.card F = p ^ (f : ℕ) := by rw [Nat.card_eq_fintype_card, hf]
  -- The index is prime to `p`, as `p` is prime to `(p ^ f) ^ (i + 1) - 1`.
  have hindex : ¬ p ∣ ∏ i ∈ Finset.range (n + 1), ((p ^ (f : ℕ)) ^ (i + 1) - 1) := by
    rw [← Nat.Prime.coprime_iff_not_dvd hp, Nat.coprime_prod_right_iff]
    intro i _
    rw [← Nat.pow_mul]
    exact Nat.coprime_pow_sub_one hp.ne_zero (Nat.mul_ne_zero f.pos.ne' (Nat.succ_ne_zero i))
  rw [finrank_gelfandGraev χ, natCard_GL_fin F (n + 1), hfq,
    ← Nat.pow_mul p (f : ℕ) ((n + 1).choose 2), Nat.ordCompl_pow_mul_of_not_dvd _ hp hindex]

end TauCeti
