module

public import Mathlib.Data.Nat.Prime.Defs
public import TauCeti.RepresentationTheory.Tensor.Induction.Trace

import TauCeti.GroupTheory.GroupAction.Orbit.Card
import TauCeti.GroupTheory.QuotientGroup.Index
import TauCeti.RepresentationTheory.Character.Basic

/-!
# Tensor induction in prime index

For a subgroup `H ≤ G` of prime index `l`, the orbit decomposition of `Subgroup.tensorIndClassFun`
and `Subgroup.trace_tensorInducedRepresentation` collapses into two sharp cases:

* **Outside `H`** (`Subgroup.tensorIndClassFun_apply_of_notMem_of_index_prime`,
  `Subgroup.trace_tensorInducedRepresentation_of_notMem_of_index_prime`): for any `g ∉ H` such
  that `g ^ l ∈ H` (for example, any `g ∉ H` when `H` is normal, though normality is not
  required), the coset `1 · H` cannot be fixed by `g` and is fixed by `g ^ l`, so its `⟨g⟩`-orbit
  has prime size `l = H.index`. Thus `⟨g⟩` acts transitively on `G ⧸ H` in a single `l`-cycle, and
  the trace at `g` collapses to the single trace at `g ^ l ∈ H`.
* **Inside `H`** (`Subgroup.tensorIndClassFun_apply_of_mem_of_index_prime`,
  `Subgroup.trace_tensorInducedRepresentation_of_mem_of_index_prime`): when `H` is normal of prime
  index `l` and `x ∉ H`, the quotient `G ⧸ H` is cyclic of order `l` generated by `x`, so the
  tensor-induced value at `h ∈ H` is the product over `i : Fin l` of the values at the
  `xⁱ`-conjugates `MulAut.conjNormal (x ^ (i : ℕ)) h`.

## Main results

* `Subgroup.tensorIndClassFun_apply_of_mem_of_index_prime` and
  `Subgroup.tensorIndClassFun_apply_of_notMem_of_index_prime`: prime-index evaluations of
  `Subgroup.tensorIndClassFun`.
* `Subgroup.trace_tensorInducedRepresentation_of_mem_of_index_prime` and
  `Subgroup.trace_tensorInducedRepresentation_of_notMem_of_index_prime`: prime-index trace
  formulas for `Subgroup.tensorInducedRepresentation`.

## References

* L. Alpöge, *The Riemann Hypothesis for Dirichlet L-Functions* (2026).
* J.-P. Serre, *Linear Representations of Finite Groups*, Chapter 7.
-/

public section

open scoped TensorProduct

namespace Subgroup

/-- **Prime-index normal evaluation on `H`.** For a normal subgroup `H ≤ G` of prime index `l`,
any `x ∉ H`, and any `H`-conjugation-invariant function `f : H → R`, `H.tensorIndClassFun f h`
equals `∏ i : Fin l, f (MulAut.conjNormal (x ^ (i : ℕ)) h)` for every `h : H`. -/
theorem tensorIndClassFun_apply_of_mem_of_index_prime {R G : Type*} [CommMonoid R] [Group G]
    (H : Subgroup G) [H.Normal] [H.FiniteIndex] {l : ℕ} (hl : l.Prime) (hH : H.index = l)
    {x : G} (hx : x ∉ H) {f : H → R} (hf : ∀ u v : H, f (v * u * v⁻¹) = f u) (h : H) :
    H.tensorIndClassFun f h =
      ∏ i : Fin l, f (MulAut.conjNormal (x ^ (i : ℕ)) h) := by
  rw [tensorIndClassFun_apply_of_mem_of_normal H f h]
  let := H.fintypeQuotientOfFiniteIndex
  let e := quotientPrimeEquiv H hl hH hx
  refine (Fintype.prod_equiv e _ _ fun i ↦ ?_).symm
  have hmk : (QuotientGroup.mk (e i).out : G ⧸ H) = QuotientGroup.mk ((x ^ (i : ℕ))⁻¹) :=
    (QuotientGroup.out_eq' _).trans (quotientPrimeEquiv_apply H hl hH hx i)
  let u : H :=
    ⟨(e i).out⁻¹ * (x ^ (i : ℕ))⁻¹, QuotientGroup.leftRel_apply.mp (Quotient.exact' hmk)⟩
  have hconj :
      MulAut.conjNormal (x ^ (i : ℕ)) h = u⁻¹ * MulAut.conjNormal (e i).out⁻¹ h * (u⁻¹)⁻¹ := by
    ext
    simp only [Subgroup.coe_mul, InvMemClass.coe_inv, inv_inv, MulAut.conjNormal_apply, u,
      mul_inv_rev, mul_assoc]
    simp
  rw [hconj, hf]

/-- **Prime-index evaluation outside `H`.** For any subgroup `H ≤ G` of prime index `l` (not
necessarily normal), any `H`-conjugation-invariant function `f : H → R`, and any `g ∉ H` such that
`(h : G) = g ^ l` for some `h : H`, `H.tensorIndClassFun f g` equals `f h`. -/
theorem tensorIndClassFun_apply_of_notMem_of_index_prime {R G : Type*} [CommMonoid R] [Group G]
    (H : Subgroup G) [H.FiniteIndex] {l : ℕ} (hl : l.Prime) (hH : H.index = l)
    {f : H → R} (hf : ∀ u v : H, f (v * u * v⁻¹) = f u)
    {g : G} (hg : g ∉ H) {h : H} (hh : (h : G) = g ^ l) :
    H.tensorIndClassFun f g = f h := by
  classical
  let := H.fintypeQuotientOfFiniteIndex
  let := Fintype.ofFinite (MulAction.orbitRel.Quotient (Subgroup.zpowers g) (G ⧸ H))
  let q₁ : G ⧸ H := QuotientGroup.mk 1
  have hl_fix : (g • ·)^[l] q₁ = q₁ := by
    rw [smul_iterate_apply]
    have hmk : g ^ l • q₁ = QuotientGroup.mk (g ^ l) := by simp [q₁]
    rw [hmk, ← hh]
    exact Quotient.sound' (QuotientGroup.leftRel_apply.mpr (by simp))
  have hnfix : ¬Function.IsFixedPt (g • ·) q₁ := fun hfix ↦ hg <| by
    simpa using (TauCeti.smul_quotientGroup_mk_eq_self_iff H g 1).mp hfix
  have : Fact l.Prime := ⟨hl⟩
  have hper1 : Function.minimalPeriod (g • ·) q₁ = l := Function.minimalPeriod_eq_prime hl_fix hnfix
  let q₀ : MulAction.orbitRel.Quotient (Subgroup.zpowers g) (G ⧸ H) := Quotient.mk'' q₁
  have hper_q₀ : Function.minimalPeriod (g • ·) q₀.out = l := by
    rw [← MulAction.natCard_orbit_zpowers g q₀.out,
      MulAction.orbit_eq_iff.mpr (Quotient.exact' (Quotient.out_eq q₀)),
      MulAction.natCard_orbit_zpowers g q₁, hper1]
  have hsum := H.index_eq_sum_minimalPeriod g
  rw [hH, ← Finset.add_sum_erase _ _ (Finset.mem_univ q₀), hper_q₀] at hsum
  have hrem_zero : ∑ q ∈ Finset.univ.erase q₀, Function.minimalPeriod (g • ·) q.out = 0 := by omega
  have hall : ∀ q : MulAction.orbitRel.Quotient (Subgroup.zpowers g) (G ⧸ H), q = q₀ := fun q ↦ by
    by_contra hne
    have hterm : Function.minimalPeriod (g • ·) q.out = 0 :=
      (Finset.sum_eq_zero_iff.mp hrem_zero) q (Finset.mem_erase.mpr ⟨hne, Finset.mem_univ q⟩)
    rw [← MulAction.natCard_orbit_zpowers g q.out] at hterm
    exact MulAction.orbitRel.Quotient.card_orbit_ne_zero (Quotient.mk'' q.out) hterm
  rw [tensorIndClassFun_def, Fintype.prod_eq_single q₀ fun q hq ↦ absurd (hall q) hq]
  refine (apply_conj_pow_minimalPeriod_eq_of_orbitRel hf g
    (Quotient.exact' (Quotient.out_eq q₀).symm) rfl (QuotientGroup.out_eq' q₀.out)).trans ?_
  congr 1
  ext
  simp [hper1, hh]

/-- **Trace of a tensor-induced representation on `H` in prime index.** For a normal subgroup
`H ≤ G` of prime index `l`, `x ∉ H`, any left transversal `s`, and any representation `ρ` of `H`
on a free `R`-module `M`, the trace at `h : H` is the product of the traces of `ρ` at the
`xⁱ`-conjugates of `h`. -/
theorem trace_tensorInducedRepresentation_of_mem_of_index_prime {R G M : Type*}
    [CommSemiring R] [Group G] (H : Subgroup G) [H.Normal] {l : ℕ} (hl : l.Prime)
    (hH : H.index = l) {x : G} (hx : x ∉ H) (s : H.LeftTransversal)
    [AddCommMonoid M] [Module R M] [Module.Free R M]
    (ρ : Representation R H M) (h : H) :
    LinearMap.trace R (⨂[R] _ : G ⧸ H, M) (H.tensorInducedRepresentation s ρ h) =
      ∏ i : Fin l, LinearMap.trace R M (ρ (MulAut.conjNormal (x ^ (i : ℕ)) h)) := by
  have : H.FiniteIndex := ⟨hH ▸ hl.ne_zero⟩
  rw [trace_tensorInducedRepresentation,
    tensorIndClassFun_apply_of_mem_of_index_prime H hl hH hx (fun u v ↦ ρ.trace_conj u v) h]

/-- **Trace of a tensor-induced representation outside `H` in prime index.** For any subgroup
`H ≤ G` of prime index `l`, any left transversal `s`, and any representation `ρ` of `H` on a free
`R`-module `M`, the trace at `g ∉ H` satisfying `(h : G) = g ^ l` equals `trace R M (ρ h)`. -/
theorem trace_tensorInducedRepresentation_of_notMem_of_index_prime {R G M : Type*}
    [CommSemiring R] [Group G] (H : Subgroup G) {l : ℕ} (hl : l.Prime)
    (hH : H.index = l) (s : H.LeftTransversal)
    [AddCommMonoid M] [Module R M] [Module.Free R M]
    (ρ : Representation R H M) {g : G} (hg : g ∉ H) {h : H} (hh : (h : G) = g ^ l) :
    LinearMap.trace R (⨂[R] _ : G ⧸ H, M) (H.tensorInducedRepresentation s ρ g) =
      LinearMap.trace R M (ρ h) := by
  have : H.FiniteIndex := ⟨hH ▸ hl.ne_zero⟩
  rw [trace_tensorInducedRepresentation,
    tensorIndClassFun_apply_of_notMem_of_index_prime H hl hH (fun u v ↦ ρ.trace_conj u v) hg hh]

end Subgroup
