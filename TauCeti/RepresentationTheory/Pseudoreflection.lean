public import TauCeti.LinearAlgebra.Dimension.FixedSubmodule
public import TauCeti.RepresentationTheory.Quotient

/-!
# The subgroup generated by the pseudoreflections of a representation

Let `ρ` be a representation of a group `G` on a vector space `V` over a field `K`. An element `g`
is a *pseudoreflection* of `ρ` when its fixed space `(ρ g).fixedSubmodule` is a hyperplane, that is,
has codimension one in `V`. Such an element acts nontrivially on `V`, and need not have order two.

The pseudoreflections of `ρ` generate the subgroup `Representation.pseudoreflectionSubgroup`. It is
normal: `ρ h` carries the fixed space of `g` onto the fixed space of `h * g * h⁻¹`, so a conjugate
of a pseudoreflection is a pseudoreflection. For a faithful representation of a finite group, it
is the subgroup `H` in the converse of the Chevalley–Shephard–Todd theorem: it contains the inertia
group of every codimension-one point of `Spec Sym(V*)`, so the residual quotient `V/H → V/G` by
`G ⧸ H` has trivial inertia in codimension one
(`Representation.inertia_quotient_pseudoreflectionSubgroup_eq_bot`, in
`TauCeti.RepresentationTheory.SymmetricAlgebra.Inertia`).

## Main definitions

* `Representation.pseudoreflectionSubgroup`: the subgroup generated by the elements whose fixed
  space has codimension one.

## Main results

* `Representation.finrank_quotient_fixedSubmodule_conj`: conjugation preserves the codimension
  of the fixed space.
* `Representation.fixedSubmodule_inv`: an element and its inverse have the same fixed space.
* `Representation.finrank_fixedSubmodule_eq_iff_mem_ker`: in finite dimension, the fixed space of
  an element is the whole space exactly when the element acts trivially.
* `Representation.finrank_quotient_fixedSubmodule_dual`: the quotients of `V` and of the dual `V*`
  by the fixed spaces of `g` have the same `finrank`, so `ρ` and its contragredient `ρ.dual` have
  the same pseudoreflections.
* `Representation.pseudoreflectionSubgroup_le_iff`: a subgroup contains the pseudoreflection
  subgroup exactly when it contains every pseudoreflection.
* `Representation.normal_pseudoreflectionSubgroup`: the pseudoreflection subgroup is normal.
* `Representation.sum_inv_one_sub_det_mul_two`: if no pseudoreflection has determinant `1`, then
  `2 ∑_s (1 - det s)⁻¹`, over the pseudoreflections `s` of a finite group, is their number.
* `Representation.card_filter_comp_subtype_eq_of_pseudoreflectionSubgroup_le`: a subgroup
  containing every pseudoreflection has as many pseudoreflections as the whole group.

## References

* R. Kane, *Reflection Groups and Invariant Theory*, CMS Books in Mathematics, Springer (2001),
  § 18.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), § 7.4.
-/

public section

namespace Representation

variable {K G V : Type*} [Field K] [Group G] [AddCommGroup V] [Module K V]
variable (ρ : Representation K G V)

/-- Conjugating `g` by `h` does not change the codimension of its fixed space: `ρ h` carries the
fixed space of `g` onto the fixed space of `h * g * h⁻¹`. -/
theorem finrank_quotient_fixedSubmodule_conj (h g : G) :
    Module.finrank K (V ⧸ (ρ (h * g * h⁻¹)).fixedSubmodule) =
      Module.finrank K (V ⧸ (ρ g).fixedSubmodule) := by
  let e := LinearMap.GeneralLinearGroup.generalLinearEquiv K V (ρ.asGroupHom h)
  have hmap : (ρ g).fixedSubmodule.map (e : V →ₗ[K] V) = (ρ (h * g * h⁻¹)).fixedSubmodule :=
    e.map_fixedSubmodule <| by
      simp [e, asGroupHom_apply, ← Module.End.mul_eq_comp, ← map_mul]
  exact (Submodule.Quotient.equiv _ _ e hmap).finrank_eq.symm

/-- An element and its inverse have the same fixed space, so the inverse of a pseudoreflection is
a pseudoreflection. -/
@[simp]
theorem fixedSubmodule_inv (g : G) : (ρ g⁻¹).fixedSubmodule = (ρ g).fixedSubmodule :=
  -- The inverse of the linear equivalence `ρ g` is `ρ g⁻¹` by definition.
  (LinearMap.GeneralLinearGroup.generalLinearEquiv K V (ρ.asGroupHom g)).fixedSubmodule_symm_eq

/-- In finite dimension, the fixed space of `g` is the whole space exactly when `g` acts
trivially. -/
theorem finrank_fixedSubmodule_eq_iff_mem_ker [FiniteDimensional K V] {g : G} :
    Module.finrank K (ρ g).fixedSubmodule = Module.finrank K V ↔ g ∈ ρ.ker := by
  rw [MonoidHom.mem_ker, Module.End.one_eq_id, ← LinearMap.fixedSubmodule_eq_top_iff]
  exact ⟨Submodule.eq_top_of_finrank_eq, fun h ↦ by rw [h, finrank_top]⟩

/-- The quotients of `V` and of the dual space `V*`, acted on by the contragredient representation,
by the fixed spaces of `g` have the same `finrank`. In finite dimension the two fixed spaces thus
have the same codimension, and `ρ` and `ρ.dual` have the same pseudoreflections. -/
theorem finrank_quotient_fixedSubmodule_dual (g : G) :
    Module.finrank K (Module.Dual K V ⧸ (ρ.dual g).fixedSubmodule) =
      Module.finrank K (V ⧸ (ρ g).fixedSubmodule) := by
  rw [dual_apply, ← LinearMap.dualMap_def, LinearMap.finrank_quotient_fixedSubmodule_dualMap,
    fixedSubmodule_inv]

/-- A pseudoreflection is not the identity element. -/
theorem ne_one_of_finrank_quotient_fixedSubmodule_eq_one {g : G}
    (hg : Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1) : g ≠ 1 := by
  rintro rfl
  rw [LinearMap.fixedSubmodule_eq_top_iff.2 (map_one ρ)] at hg
  simp only [Module.finrank_zero_of_subsingleton, zero_ne_one] at hg

/-- The subgroup of `G` generated by the pseudoreflections of `ρ`, the elements whose fixed space
in `V` has codimension one. -/
def pseudoreflectionSubgroup : Subgroup G :=
  Subgroup.closure {g | Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1}

/-- The pseudoreflection subgroup is the subgroup generated by the elements whose fixed space has
codimension one. -/
theorem pseudoreflectionSubgroup_def :
    ρ.pseudoreflectionSubgroup =
      Subgroup.closure {g | Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1} :=
  (rfl)

/-- A pseudoreflection lies in the pseudoreflection subgroup. -/
theorem mem_pseudoreflectionSubgroup_of_finrank_quotient_eq_one {g : G}
    (hg : Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1) : g ∈ ρ.pseudoreflectionSubgroup :=
  Subgroup.subset_closure hg

/-- A subgroup contains the pseudoreflection subgroup exactly when it contains every
pseudoreflection. -/
theorem pseudoreflectionSubgroup_le_iff {H : Subgroup G} :
    ρ.pseudoreflectionSubgroup ≤ H ↔
      ∀ g, Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1 → g ∈ H :=
  Subgroup.closure_le H

/-- Under a surjective change of group, the image of the pseudoreflection subgroup is the
pseudoreflection subgroup of the target representation. -/
theorem map_pseudoreflectionSubgroup_comp {H : Type*} [Group H]
    (σ : Representation K H V) (f : G →* H) (hf : Function.Surjective f) :
    (Representation.pseudoreflectionSubgroup (σ.comp f)).map f = σ.pseudoreflectionSubgroup := by
  rw [pseudoreflectionSubgroup_def, pseudoreflectionSubgroup_def, MonoidHom.map_closure]
  congr 1
  exact Set.image_preimage_eq
    {g : H | Module.finrank K (V ⧸ (σ g).fixedSubmodule) = 1} hf

/-- The preimage of the pseudoreflection subgroup after a surjective change of group is generated
by the original pseudoreflections together with the kernel of the group homomorphism. -/
theorem comap_pseudoreflectionSubgroup {H : Type*} [Group H]
    (σ : Representation K H V) (f : G →* H) (hf : Function.Surjective f) :
    σ.pseudoreflectionSubgroup.comap f =
      Representation.pseudoreflectionSubgroup (σ.comp f) ⊔ f.ker := by
  rw [← map_pseudoreflectionSubgroup_comp σ f hf, Subgroup.comap_map_eq]

/-- The faithful quotient is generated by pseudoreflections exactly when pseudoreflections and
the kernel generate the original group. No finiteness hypothesis is needed. -/
theorem pseudoreflectionSubgroup_ofQuotient_ker_eq_top_iff :
    (ρ.ofQuotient ρ.ker).pseudoreflectionSubgroup = ⊤ ↔
      ρ.pseudoreflectionSubgroup ⊔ ρ.ker = ⊤ := by
  rw [← Subgroup.comap_injective (f := QuotientGroup.mk' ρ.ker)
    (QuotientGroup.mk'_surjective ρ.ker) |>.eq_iff, comap_pseudoreflectionSubgroup _ _
      (QuotientGroup.mk'_surjective ρ.ker), ρ.ofQuotient_comp_mk', QuotientGroup.ker_mk',
    Subgroup.comap_top]

/-- The pseudoreflection subgroup is normal, since a conjugate of a pseudoreflection is a
pseudoreflection. -/
instance normal_pseudoreflectionSubgroup : ρ.pseudoreflectionSubgroup.Normal :=
  Subgroup.closure_normal_of_forall_conj_mem fun h g hg ↦
    (ρ.finrank_quotient_fixedSubmodule_conj h g).trans hg

open Finset in
/-- **Pairing a pseudoreflection with its inverse.** If no pseudoreflection has determinant `1`,
then `2 ∑_s (1 - det s)⁻¹`, over the pseudoreflections `s`, is their number, since `s⁻¹` is a
pseudoreflection of determinant `(det s)⁻¹` and `(1 - λ)⁻¹ + (1 - λ⁻¹)⁻¹ = 1`. -/
theorem sum_inv_one_sub_det_mul_two [Fintype G]
    (hdet : ∀ g, Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1 → LinearMap.det (ρ g) ≠ 1) :
    (∑ g ∈ {g | Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1}, (1 - LinearMap.det (ρ g))⁻¹) *
      2 = #{g | Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1} := by
  set T := ({g | Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1} : Finset G)
  have hmul (g : G) : LinearMap.det (ρ g) * LinearMap.det (ρ g⁻¹) = 1 := by
    rw [← map_mul, ← map_mul, mul_inv_cancel, map_one, map_one]
  have hdet_inv (g : G) : LinearMap.det (ρ g⁻¹) = (LinearMap.det (ρ g))⁻¹ :=
    eq_inv_of_mul_eq_one_right (hmul g)
  have hT (g : G) : g ∈ T ↔ g⁻¹ ∈ T := by
    simp only [T, mem_filter, mem_univ, true_and]
    rw [fixedSubmodule_inv]
  have hswap : ∑ g ∈ T, (1 - LinearMap.det (ρ g⁻¹))⁻¹ = ∑ g ∈ T, (1 - LinearMap.det (ρ g))⁻¹ :=
    sum_equiv (Equiv.inv G) hT fun _ _ ↦ rfl
  rw [mul_two]
  nth_rw 2 [← hswap]
  rw [← sum_add_distrib, card_eq_sum_ones, Nat.cast_sum, Nat.cast_one]
  refine sum_congr rfl fun g hg ↦ ?_
  have h1 : LinearMap.det (ρ g) ≠ 1 := hdet g (by simpa [T] using hg)
  have h0 : LinearMap.det (ρ g) ≠ 0 := fun h0 ↦ by simpa [h0] using hmul g
  rw [hdet_inv]
  have : 1 - LinearMap.det (ρ g) ≠ 0 := sub_ne_zero.2 h1.symm
  have : 1 - (LinearMap.det (ρ g))⁻¹ ≠ 0 := sub_ne_zero.2 (by simpa [eq_comm] using h1)
  field_simp
  ring

open Finset in
/-- **A subgroup containing every pseudoreflection has the same pseudoreflections.** If a subgroup
`H` of a finite group contains every pseudoreflection of `ρ`, then the restriction of `ρ` to `H`
has as many pseudoreflections as `ρ`. -/
theorem card_filter_comp_subtype_eq_of_pseudoreflectionSubgroup_le [Fintype G] {H : Subgroup G}
    [Fintype H] (hH : ρ.pseudoreflectionSubgroup ≤ H) :
    #{h : H | Module.finrank K (V ⧸ (ρ.comp H.subtype h).fixedSubmodule) = 1} =
      #{g | Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1} := by
  classical
  -- `ρ.comp H.subtype h` is `ρ h` by definition, so the two filters test the same condition.
  refine card_bij (fun h _ ↦ (h : G)) (fun h hh ↦ mem_filter.2 ⟨mem_univ _, (mem_filter.1 hh).2⟩)
    (fun _ _ _ _ ↦ Subtype.ext) fun g hg ↦ ?_
  exact ⟨⟨g, hH (mem_pseudoreflectionSubgroup_of_finrank_quotient_eq_one ρ (mem_filter.1 hg).2)⟩,
    mem_filter.2 ⟨mem_univ _, (mem_filter.1 hg).2⟩, rfl⟩

end Representation
