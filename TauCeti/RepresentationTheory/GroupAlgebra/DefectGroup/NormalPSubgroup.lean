/-!
# Normal `p`-subgroups lie in every defect group

Let `k` be a field of characteristic `p`, `G` a finite group and `Q` a normal `p`-subgroup of
`G`, for instance `O_p(G)` (`TauCeti.piCore {p} G`). Then `Q` lies in every defect group of every
block of `k[G]` (Webb, Corollary 12.3.4, pp. 236–237; Martínez, Corollary 3.9, p. 21). The proof
follows the roadmap's route, without vertices.

* `Q` acts trivially on every irreducible representation `ρ` of `G`
  (`Representation.IsIrreducible.comp_eq_trivial_of_isPGroup`). So for `z ∈ k[G]` fixed by
  conjugation by `Q`, `ρ(z) = ∑_g z_g ρ(g)` is a sum of a function constant on the orbits of `Q`
  acting on `G` by conjugation; the orbits have `p`-power size, and the sum is the sum over the
  fixed points `C_G(Q)`. If `Br_Q(z) = 0`, the coefficients of `z` vanish there and `ρ(z) = 0`
  (`TauCeti.asAlgebraHom_eq_zero_of_brauerProjection_eq_zero`).
* An idempotent `e` of `k[G]` acting as `0` on every simple module lies in every maximal left
  ideal, and so is `0`: otherwise the proper left ideal generated by `1 - e` lies in a maximal
  one, which would contain `1`. Thus a nonzero `Q`-invariant idempotent `e` has
  `Br_Q(e) ≠ 0` (`TauCeti.brauerProjection_ne_zero_of_isPGroup_of_normal`).
* For a block idempotent `e` and a subgroup `P` minimal with `e ∈ Tr_P^G(k[G]^P)`, the `p`-subgroup
  `Q` with `Br_Q(e) ≠ 0` lies in a conjugate of `P` (`TauCeti.exists_le_conj_of_mem_relTraceIdeal`).
  The defect groups are the conjugates of `P`, and `Q` is normal, so `Q` lies in all of them
  (`TauCeti.IsBlockIdempotent.le_of_isDefectGroup_of_isPGroup_of_normal`).

Normality is needed: for `S₃` at `p = 2`, `⟨(12)⟩` is a `2`-subgroup, but the defect group of the
block `r + r²` is `1`.

## Main results

* `TauCeti.asAlgebraHom_eq_zero_of_brauerProjection_eq_zero`: an element of `k[G]^Q` with
  `Br_Q(z) = 0` acts as `0` on every irreducible representation.
* `TauCeti.brauerProjection_ne_zero_of_isPGroup_of_normal`: a nonzero idempotent of `k[G]^Q` has
  nonzero Brauer projection at `Q`.
* `TauCeti.IsBlockIdempotent.le_of_isDefectGroup_of_isPGroup_of_normal`: a normal `p`-subgroup
  lies in every defect group of a block.
* `TauCeti.IsBlockIdempotent.piCore_le_of_isDefectGroup`: `O_p(G)` lies in every defect group of
  a block.
* `TauCeti.IsBlockIdempotent.zpowers_le_of_isDefectGroup_centralizer`: for a `p`-element `x`,
  `⟨x⟩` lies in every defect group of every block of `k[C_G(x)]`.

## References

* P. Webb, *A Course in Finite Group Representation Theory*, Corollary 12.3.4, pp. 236–237.
* A. Martínez, *Modular representation theory of finite groups*, Corollary 3.9, p. 21.
-/

public section

namespace TauCeti

open MonoidAlgebra
open scoped Pointwise

variable {k G : Type*} [Field k] [Group G] [Finite G] {p : ℕ} [Fact p.Prime] [CharP k p]
  {Q : Subgroup G} [Q.Normal]

/-- **An element with vanishing Brauer projection at a normal `p`-subgroup acts as zero on every
irreducible representation.** Let `Q` be a normal `p`-subgroup of a finite group `G` and `k` a
field of characteristic `p`. If `z ∈ k[G]` is fixed by conjugation by `Q` and `Br_Q(z) = 0`, then
`z` acts as `0` on every irreducible representation of `G`: `Q` acts trivially there, so the
action of `z` is a sum over the `Q`-conjugation orbits of `G`, which reduces to the sum over the
fixed points `C_G(Q)`, where the coefficients of `z` vanish. -/
theorem asAlgebraHom_eq_zero_of_brauerProjection_eq_zero (hQ : IsPGroup p Q)
    {V : Type*} [AddCommGroup V] [Module k V] {ρ : Representation k G V}
    (hρ : Representation.IsIrreducible ρ)
    {z : MonoidAlgebra k G} (hz : z ∈ conjInvariants k Q) (hBr : brauerProjection Q z = 0) :
    ρ.asAlgebraHom z = 0 := by
  classical
  have := Fintype.ofFinite G
  have htriv := hρ.comp_eq_trivial_of_isPGroup p Q hQ
  have hq (q : Q) : ρ q = 1 := by
    ext v
    simpa [Representation.trivial_apply] using congrArg (fun σ => σ q v) htriv
  let : MulAction Q G := MulAction.compHom G (MulAut.conj.comp Q.subtype)
  have hsmul (q : Q) (a : G) : q • a = q * a * (q : G)⁻¹ := by
    rw [MulAction.compHom_smul_def]
    simp
  have hsum : ρ.asAlgebraHom z = ∑ g : G, z.coeff g • ρ g := by
    conv_lhs => rw [← MonoidAlgebra.sum_coeff_single z]
    rw [Finsupp.sum_fintype _ _ (by simp), map_sum]
    exact Finset.sum_congr rfl fun g _ => by simp [Representation.asAlgebraHom_single]
  rw [hsum, IsPGroup.sum_eq_sum_fixedPoints_of_nsmul_eq_zero hQ (fun x => ?_) _ fun q a => ?_]
  · refine Finset.sum_eq_zero fun g hg => ?_
    have hg' : g ∈ Subgroup.centralizer (Q : Set G) := by
      rw [Subgroup.mem_centralizer_iff]
      intro q hqQ
      have := (Finset.mem_filter.1 hg).2 ⟨q, hqQ⟩
      rw [hsmul, mul_inv_eq_iff_eq_mul] at this
      exact this
    have := (brauerProjection_eq_zero_iff.1 hBr) g hg'
    rw [this, zero_smul]
  · rw [← Nat.cast_smul_eq_nsmul k, CharP.cast_eq_zero, zero_smul]
  · rw [hsmul, (mem_conjInvariants_iff_coeff.1 hz) q q.property a, map_mul, map_mul, hq,
      ← Subgroup.coe_inv, hq, one_mul, mul_one]

/-- **A nonzero idempotent fixed by a normal `p`-subgroup has nonzero Brauer projection there.**
Let `Q` be a normal `p`-subgroup of a finite group `G` and `k` a field of characteristic `p`.
If `e ∈ k[G]^Q` is a nonzero idempotent, then `Br_Q(e) ≠ 0`: otherwise `e` acts as `0` on every
simple `k[G]`-module (`TauCeti.asAlgebraHom_eq_zero_of_brauerProjection_eq_zero`), so it lies in
every maximal left ideal. But the proper left ideal generated by `1 - e` lies in a maximal one,
which then contains `1`. -/
theorem brauerProjection_ne_zero_of_isPGroup_of_normal (hQ : IsPGroup p Q)
    {e : MonoidAlgebra k G} (he : e ∈ conjInvariants k Q) (hidem : IsIdempotentElem e)
    (hne : e ≠ 0) : brauerProjection Q e ≠ 0 := by
  intro hBr
  -- `e` lies in every maximal left ideal `m`: it acts as `0` on the simple module `k[G] ⧸ m`.
  have hmem (m : Ideal (MonoidAlgebra k G)) (hm : m.IsMaximal) : e ∈ m := by
    have : IsSimpleModule (MonoidAlgebra k G) (MonoidAlgebra k G ⧸ m) :=
      isSimpleModule_iff_isCoatom.2 (Ideal.isMaximal_def.1 hm)
    have hρ := (Representation.isIrreducible_ofModule'_iff
      (k := k) (G := G) (MonoidAlgebra k G ⧸ m)).2 this
    have h0 := congrArg (fun f => f (Submodule.Quotient.mk 1))
      (asAlgebraHom_eq_zero_of_brauerProjection_eq_zero hQ hρ he hBr)
    simp only [Representation.asAlgebraHom_ofModule'_apply, LinearMap.zero_apply,
      ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one, Submodule.Quotient.mk_eq_zero] at h0
    exact h0
  -- The left ideal generated by `1 - e` is proper, since `a (1 - e) = 1` would give `e = 0`.
  have hprop : Ideal.span {1 - e} ≠ ⊤ := by
    intro htop
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.1 ((Ideal.eq_top_iff_one _).1 htop)
    refine hne ?_
    calc e = a * (1 - e) * e := by rw [ha, one_mul]
      _ = 0 := by rw [mul_assoc, sub_mul, one_mul, hidem.eq, sub_self, mul_zero]
  obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hprop
  refine hm.ne_top ((Ideal.eq_top_iff_one _).2 ?_)
  simpa using m.add_mem (hle (Ideal.mem_span_singleton_self _)) (hmem m hm)

namespace IsBlockIdempotent

variable {b : Subalgebra.center k (MonoidAlgebra k G)}

/-- **A normal `p`-subgroup lies in every defect group of a block** (Webb, Corollary 12.3.4,
pp. 236–237). Let `Q` be a normal `p`-subgroup of a finite group `G` and `k` a field of
characteristic `p`. Then `Q` lies in every defect group of every block idempotent of `k[G]`. -/
theorem le_of_isDefectGroup_of_isPGroup_of_normal (hb : IsBlockIdempotent b) (hQ : IsPGroup p Q)
    {D : Subgroup G} (hD : IsDefectGroup k p (b : MonoidAlgebra k G) D) : Q ≤ D := by
  have he := hb.isPrimitiveIdempotent_conjInvariants
  have hBr : brauerProjection Q (b : MonoidAlgebra k G) ≠ 0 :=
    brauerProjection_ne_zero_of_isPGroup_of_normal hQ
      (center_le_conjInvariants Q b.property) hb.isIdempotentElem_val
      (fun h => he.ne_zero (Subtype.ext h))
  obtain ⟨P, hP⟩ := exists_minimal_mem_relTraceIdeal
    (⟨b, center_le_conjInvariants ⊤ b.property⟩ : conjInvariants k (⊤ : Subgroup G))
  obtain ⟨g, hg⟩ := exists_le_conj_of_mem_relTraceIdeal hP.prop hQ hBr
  obtain ⟨h, rfl⟩ := (isDefectGroup_iff_exists_eq_conj he hP).1 hD
  -- `Q = (h g⁻¹) Q (h g⁻¹)⁻¹ ≤ (h g⁻¹) (g P g⁻¹) (h g⁻¹)⁻¹ = h P h⁻¹`.
  calc Q = MulAut.conj (h * g⁻¹) • Q := (Subgroup.Normal.conj_smul_eq_self _ _).symm
    _ ≤ MulAut.conj (h * g⁻¹) • (MulAut.conj g • P) :=
      Subgroup.pointwise_smul_le_pointwise_smul_iff.2 hg
    _ = MulAut.conj h • P := by rw [smul_smul, ← map_mul, inv_mul_cancel_right]

/-- **`O_p(G)` lies in every defect group of a block** (Webb, Corollary 12.3.4, pp. 236–237;
Martínez, Corollary 3.9, p. 21): for a finite group `G` and a field `k` of characteristic `p`,
the `p`-core `O_p(G) = TauCeti.piCore {p} G` lies in every defect group of every block of
`k[G]`. -/
theorem piCore_le_of_isDefectGroup (hb : IsBlockIdempotent b) {D : Subgroup G}
    (hD : IsDefectGroup k p (b : MonoidAlgebra k G) D) : piCore {p} G ≤ D :=
  hb.le_of_isDefectGroup_of_isPGroup_of_normal
    ((isPiGroup_singleton_iff Fact.out).1 (isPiGroup_piCore {p} G)) hD

/-- **A central `p`-element lies in every defect group.** If `x` is central in a finite group `G`
and `⟨x⟩` is a `p`-group, then `⟨x⟩`, a normal `p`-subgroup, lies in every defect group of every
block of `k[G]`, `k` a field of characteristic `p`. -/
theorem zpowers_le_of_isDefectGroup (hb : IsBlockIdempotent b) {x : G}
    (hx : x ∈ Subgroup.center G) (hxp : IsPGroup p (Subgroup.zpowers x)) {D : Subgroup G}
    (hD : IsDefectGroup k p (b : MonoidAlgebra k G) D) : Subgroup.zpowers x ≤ D :=
  have : (Subgroup.zpowers x).Normal :=
    Subgroup.normal_of_le_center ((Subgroup.zpowers_le (H := Subgroup.center G)).2 hx)
  hb.le_of_isDefectGroup_of_isPGroup_of_normal hxp hD

/-- **A `p`-element lies in every defect group of every block of its centralizer** (Webb,
Corollary 12.3.4, pp. 236–237): for a `p`-element `x` of a finite group `G` and a field `k` of
characteristic `p`, `⟨x⟩` lies in every defect group of every block of `k[C_G(x)]`. -/
theorem zpowers_le_of_isDefectGroup_centralizer {x : G} (hxp : IsPGroup p (Subgroup.zpowers x))
    {b : Subalgebra.center k (MonoidAlgebra k (Subgroup.centralizer {x}))}
    (hb : IsBlockIdempotent b) {D : Subgroup (Subgroup.centralizer {x})}
    (hD : IsDefectGroup k p (b : MonoidAlgebra k (Subgroup.centralizer {x})) D) :
    Subgroup.zpowers (⟨x, Subgroup.mem_centralizer_singleton_iff.2 rfl⟩ :
      Subgroup.centralizer {x}) ≤ D := by
  refine hb.zpowers_le_of_isDefectGroup (Subgroup.mem_center_iff.2 fun g => ?_) ?_ hD
  · exact Subtype.ext (Subgroup.mem_centralizer_singleton_iff.1 g.property)
  · have hmap : IsPGroup p ((Subgroup.zpowers (⟨x, Subgroup.mem_centralizer_singleton_iff.2 rfl⟩ :
        Subgroup.centralizer {x})).map (Subgroup.centralizer {x}).subtype) := by
      rwa [MonoidHom.map_zpowers]
    exact hmap.of_equiv (Subgroup.equivMapOfInjective _ _ Subtype.val_injective).symm

end IsBlockIdempotent

end TauCeti
