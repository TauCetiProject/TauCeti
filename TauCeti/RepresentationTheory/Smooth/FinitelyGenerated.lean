import TauCeti.RepresentationTheory.Rep.DirectSum.AsModule

/-!
# Finitely generated smooth representations

A representation `ρ` of a group `G` on an `A`-module `V` is *finitely generated* when `V` is a
finitely generated module over the group algebra `A[G]`, that is
`Module.Finite A[G] ρ.asModule`. This file proves that a smooth representation of a topological
group is finitely generated exactly when it is a quotient of a finite direct sum
`⊕_{i < n} A[G ⧸ U_i]` of permutation representations on the cosets of open subgroups `U_i`, and,
for a locally profinite group, of compact open subgroups `U_i`.

Given generators `v_i`, the summand `A[G ⧸ U_i]` maps onto the subrepresentation generated by
`v_i` through `g U_i ↦ ρ g v_i`, for any open `U_i` fixing `v_i`; conversely each `A[G ⧸ U]` is
generated by the coset `U`, and finite generation passes to finite direct sums and quotients.

## Main definitions

* `Representation.cosetLift ρ U v hU`: for `U` fixing `v`, the intertwining map
  `A[G ⧸ U] → V`, `g U ↦ ρ g v`.
* `Representation.directSumDesc`: the intertwining map out of a direct sum of representations
  given by intertwining maps out of the summands.

## Main results

* `Representation.finite_asModule_of_surjective`: finite generation passes to quotients.
* `Representation.finite_asModule_directSum`: a finite direct sum of finitely generated
  representations is finitely generated.
* `Representation.finite_asModule_ofMulAction_quotient`: `A[G ⧸ U]` is generated by one vector.
* `Representation.finite_asModule_iff_exists_surjective`: a smooth representation is finitely
  generated exactly when it is a quotient of `⊕_{i < n} A[G ⧸ U_i]` with `U_i` open.
* `Representation.finite_asModule_iff_exists_surjective_isCompact`: for a locally profinite
  group, the `U_i` may be taken compact open.

## References

* J. Bernstein, *Representations of p-adic groups*, Harvard lectures 1992, written by
  K. Rumelhart, Chapter I, §1.
* F. Calegari and D. Geraghty, *Modularity lifting beyond the Taylor–Wiles method*,
  arXiv:1207.4224v2, §9.2.1, Definition 9.11.
-/

public section

open DirectSum
open scoped MonoidAlgebra

namespace Representation

variable {A G V W : Type*} [CommSemiring A] [Group G]
  [AddCommMonoid V] [Module A V] [AddCommMonoid W] [Module A W]
  {ρ : Representation A G V} {σ : Representation A G W}

/-! ### Maps out of permutation representations and direct sums -/

section Lift

variable (ρ) in
/-- For a subgroup `U` fixing `v`, the map `g U ↦ ρ g v` on the cosets of `U`. -/
def cosetOrbitMap (U : Subgroup G) (v : V) (hU : U ≤ ρ.stabilizer v) : G ⧸ U → V :=
  Quotient.lift (s := QuotientGroup.leftRel _) (fun g : G ↦ ρ g v) fun g h hgh ↦ by
    have hk : ρ (g⁻¹ * h) v = v := mem_stabilizer.1 (hU (QuotientGroup.leftRel_apply.1 hgh))
    rw [← mul_inv_cancel_left g h, map_mul, mul_apply_eq_comp, hk]

@[simp]
theorem cosetOrbitMap_mk (U : Subgroup G) (v : V) (hU : U ≤ ρ.stabilizer v) (g : G) :
    ρ.cosetOrbitMap U v hU (g : G ⧸ U) = ρ g v :=
  (rfl)

private theorem constr_single {X : Type*} (w : X → V) (x : X) (c : A) :
    (MonoidAlgebra.basis X A).constr A w (MonoidAlgebra.single x c) = c • w x := by
  have he : MonoidAlgebra.single x c = c • MonoidAlgebra.basis X A x := by
    simp [MonoidAlgebra.basis_apply]
  rw [he, map_smul, Module.Basis.constr_basis]

variable (ρ) in
/-- For a subgroup `U` fixing `v`, the intertwining map `A[G ⧸ U] → V` sending the basis vector
of the coset `g U` to `ρ g v`. -/
noncomputable def cosetLift (U : Subgroup G) (v : V) (hU : U ≤ ρ.stabilizer v) :
    IntertwiningMap (ofMulAction A G (G ⧸ U)) ρ :=
  ((MonoidAlgebra.basis (G ⧸ U) A).constr A
    (ρ.cosetOrbitMap U v hU)).intertwiningMap_of_isIntertwiningMap _ _ fun g x ↦ by
      induction x using MonoidAlgebra.induction_linear with
      | zero => simp
      | add x y hx hy => simp only [map_add, hx, hy]
      | single x c =>
        induction x using QuotientGroup.induction_on with | H h =>
        rw [ofMulAction_single, constr_single, constr_single, MulAction.Quotient.smul_coe,
          smul_eq_mul, cosetOrbitMap_mk, cosetOrbitMap_mk, map_smul, map_mul, mul_apply_eq_comp]

@[simp]
theorem cosetLift_single (U : Subgroup G) (v : V) (hU : U ≤ ρ.stabilizer v) (g : G) (c : A) :
    ρ.cosetLift U v hU (MonoidAlgebra.single (g : G ⧸ U) c) = c • ρ g v :=
  constr_single _ _ c

variable {ι : Type*} [DecidableEq ι] {V' : ι → Type*} [∀ i, AddCommMonoid (V' i)]
  [∀ i, Module A (V' i)]

/-- The intertwining map out of a direct sum of representations given by intertwining maps out of
the summands. -/
noncomputable def directSumDesc (ρ' : ∀ i, Representation A G (V' i))
    (f : ∀ i, IntertwiningMap (ρ' i) ρ) : IntertwiningMap (directSum ρ') ρ :=
  (DirectSum.toModule A ι V fun i ↦ (f i).toLinearMap).intertwiningMap_of_isIntertwiningMap _ _
    fun g x ↦ by
      induction x using DirectSum.induction_on with
      | zero => simp
      | add x y hx hy => simp only [map_add, hx, hy]
      | of i x =>
        rw [← DirectSum.lof_eq_of A]
        simp [directSum_apply, DirectSum.lmap_lof, DirectSum.toModule_lof, (f i).isIntertwining]

@[simp]
theorem directSumDesc_lof (ρ' : ∀ i, Representation A G (V' i))
    (f : ∀ i, IntertwiningMap (ρ' i) ρ) (i : ι) (x : V' i) :
    directSumDesc ρ' f (DirectSum.lof A ι V' i x) = f i x :=
  DirectSum.toModule_lof A i x

end Lift

/-! ### Finite generation -/

section Finite

/-- **Finite generation passes to quotients.** -/
theorem finite_asModule_of_surjective [Module.Finite A[G] ρ.asModule] (f : IntertwiningMap ρ σ)
    (hf : Function.Surjective f) : Module.Finite A[G] σ.asModule :=
  Module.Finite.of_surjective (IntertwiningMap.equivLinearMapAsModule ρ σ f) hf

/-- A finite direct sum of finitely generated representations is finitely generated. -/
theorem finite_asModule_directSum {ι : Type*} [Finite ι] {V' : ι → Type*}
    [∀ i, AddCommMonoid (V' i)] [∀ i, Module A (V' i)] (ρ' : ∀ i, Representation A G (V' i))
    [∀ i, Module.Finite A[G] (ρ' i).asModule] : Module.Finite A[G] (directSum ρ').asModule :=
  Module.Finite.equiv (directSumAsModuleEquiv ρ').symm

/-- **A permutation representation on cosets is cyclic**: `A[G ⧸ U]` is generated over `A[G]` by
the basis vector of the coset `U`. -/
instance finite_asModule_ofMulAction_quotient (U : Subgroup G) :
    Module.Finite A[G] (ofMulAction A G (G ⧸ U)).asModule := by
  set τ := ofMulAction A G (G ⧸ U)
  refine ⟨⟨{τ.asModuleEquiv.symm (MonoidAlgebra.single ((1 : G) : G ⧸ U) 1)}, ?_⟩⟩
  suffices h : ∀ y, τ.asModuleEquiv.symm y ∈ Submodule.span A[G]
      ↑({τ.asModuleEquiv.symm (MonoidAlgebra.single ((1 : G) : G ⧸ U) 1)} : Finset _) from
    eq_top_iff.2 fun x _ ↦ by
      have := h (τ.asModuleEquiv x)
      rwa [LinearEquiv.symm_apply_apply] at this
  intro y
  induction y using MonoidAlgebra.induction_linear with
  | zero => rw [map_zero]; exact zero_mem _
  | add y z hy hz => rw [map_add]; exact add_mem hy hz
  | single x c =>
    induction x using QuotientGroup.induction_on with | H g =>
    have hx : MonoidAlgebra.single (g : G ⧸ U) c =
        c • τ g (MonoidAlgebra.single ((1 : G) : G ⧸ U) 1) := by
      rw [ofMulAction_single, MulAction.Quotient.smul_coe, smul_eq_mul, mul_one,
        MonoidAlgebra.smul_single, smul_eq_mul, mul_one]
    rw [hx, asModuleEquiv_symm_map_smul, asModuleEquiv_symm_map_rho]
    exact Submodule.smul_mem _ _ (Submodule.smul_mem _ _
      (Submodule.subset_span (Finset.mem_coe.2 (Finset.mem_singleton_self _))))

/-- A finite direct sum `⊕_{i < n} A[G ⧸ U_i]` of permutation representations on cosets is
finitely generated. -/
instance finite_asModule_directSum_ofMulAction_quotient {n : ℕ} (U : Fin n → Subgroup G) :
    Module.Finite A[G] (directSum fun i ↦ ofMulAction A G (G ⧸ U i)).asModule :=
  finite_asModule_directSum _

variable [TopologicalSpace G]

/-- **Generators give a surjection from permutation representations.** If `V` is finitely
generated and every vector is fixed by an open subgroup satisfying `P`, then `V` is a quotient of
`⊕_{i < n} A[G ⧸ U_i]` for open subgroups `U_i` satisfying `P`. -/
theorem exists_surjective_of_finite_asModule [Module.Finite A[G] ρ.asModule]
    {P : OpenSubgroup G → Prop}
    (hP : ∀ v : V, ∃ U : OpenSubgroup G, P U ∧ (U : Subgroup G) ≤ ρ.stabilizer v) :
    ∃ (n : ℕ) (U : Fin n → OpenSubgroup G), (∀ i, P (U i)) ∧
      ∃ f : IntertwiningMap (directSum fun i ↦ ofMulAction A G (G ⧸ (U i : Subgroup G))) ρ,
        Function.Surjective f := by
  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := A[G]) (M := ρ.asModule)
  choose U hPU hU using fun i : Fin n ↦ hP (ρ.asModuleEquiv (s i))
  let f := directSumDesc (fun i ↦ ofMulAction A G (G ⧸ (U i : Subgroup G)))
    fun i ↦ ρ.cosetLift _ _ (hU i)
  refine ⟨n, U, hPU, f, ?_⟩
  have hrange : LinearMap.range (IntertwiningMap.equivLinearMapAsModule _ ρ f) = ⊤ := by
    rw [eq_top_iff, ← hs, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    refine ⟨(directSum _).asModuleEquiv.symm
      (DirectSum.lof A _ _ i (MonoidAlgebra.single ((1 : G) : G ⧸ (U i : Subgroup G)) 1)), ?_⟩
    rw [IntertwiningMap.equivLinearMapAsModule_apply]
    change f (DirectSum.lof A _ _ i _) = _
    rw [directSumDesc_lof, cosetLift_single, map_one, one_smul]
    rfl
  intro v
  obtain ⟨x, hx⟩ := LinearMap.range_eq_top.1 hrange (ρ.asModuleEquiv.symm v)
  exact ⟨x, hx⟩

/-- **Finitely generated smooth representations are quotients of permutation representations.**
A smooth representation is finitely generated over `A[G]` exactly when it is a quotient of a
finite direct sum `⊕_{i < n} A[G ⧸ U_i]` for open subgroups `U_i`. -/
theorem finite_asModule_iff_exists_surjective [IsSmooth ρ] :
    Module.Finite A[G] ρ.asModule ↔
      ∃ (n : ℕ) (U : Fin n → OpenSubgroup G)
        (f : IntertwiningMap (directSum fun i ↦ ofMulAction A G (G ⧸ (U i : Subgroup G))) ρ),
        Function.Surjective f := by
  refine ⟨fun _ ↦ ?_, fun ⟨n, U, f, hf⟩ ↦ finite_asModule_of_surjective f hf⟩
  obtain ⟨n, U, -, hf⟩ := exists_surjective_of_finite_asModule (ρ := ρ) (P := fun _ ↦ True)
    fun v ↦ ⟨⟨ρ.stabilizer v, IsSmooth.isOpen_stabilizer v⟩, True.intro, le_rfl⟩
  exact ⟨n, U, hf⟩

/-- For a locally profinite group, a smooth representation is finitely generated over `A[G]`
exactly when it is a quotient of a finite direct sum `⊕_{i < n} A[G ⧸ U_i]` for compact open
subgroups `U_i`. -/
theorem finite_asModule_iff_exists_surjective_isCompact [NonarchimedeanGroup G]
    [WeaklyLocallyCompactSpace G] [IsSmooth ρ] :
    Module.Finite A[G] ρ.asModule ↔
      ∃ (n : ℕ) (U : Fin n → OpenSubgroup G), (∀ i, IsCompact (U i : Set G)) ∧
        ∃ f : IntertwiningMap (directSum fun i ↦ ofMulAction A G (G ⧸ (U i : Subgroup G))) ρ,
          Function.Surjective f := by
  refine ⟨fun _ ↦ exists_surjective_of_finite_asModule (ρ := ρ)
    (P := fun U ↦ IsCompact (U : Set G)) fun v ↦ ?_,
    fun ⟨n, U, _, f, hf⟩ ↦ finite_asModule_of_surjective f hf⟩
  exact mem_smoothVectors_iff_exists_isCompact_openSubgroup.1 (IsSmooth.mem_smoothVectors v)

end Finite

end Representation
