module

public import TauCeti.RepresentationTheory.Smooth.Basic
public import TauCeti.RepresentationTheory.FinitelyGenerated
public import TauCeti.RepresentationTheory.OfMulAction.CosetLift
import TauCeti.RepresentationTheory.AsModule
import TauCeti.RepresentationTheory.Intertwining
import TauCeti.RepresentationTheory.Intertwining.DirectSum

/-!
# Finitely generated smooth representations

A representation `ρ` of a group `G` on an `A`-module `V` is *finitely generated* when `V` is a
finitely generated module over the group algebra `A[G]`, that is
`Module.Finite A[G] ρ.asModule`. This file proves that a smooth representation of a topological
group is finitely generated exactly when it is a quotient of a finite direct sum
`⊕_{i < n} A[G ⧸ U_i]` of permutation representations on the cosets of open subgroups `U_i`, and,
for a locally profinite group, of compact open subgroups `U_i`.

Given generators `v_i`, the summand `A[G ⧸ U_i]` maps onto the subrepresentation generated by
`v_i` through the coset lift `g U_i ↦ ρ g v_i` (`Representation.cosetLift`), for any open `U_i`
fixing `v_i`; conversely each `A[G ⧸ U]` is generated by the coset `U`, and finite generation
passes to finite direct sums and quotients (`TauCeti.RepresentationTheory.FinitelyGenerated`).

## Main results

* `Representation.exists_surjective_of_finite_asModule`: a finitely generated representation
  whose vectors are fixed by open subgroups satisfying `P` is a quotient of `⊕_{i < n} A[G ⧸ U_i]`
  with each `U_i` satisfying `P`.
* `Representation.finite_asModule_iff_exists_surjective`: a smooth representation is finitely
  generated exactly when it is a quotient of `⊕_{i < n} A[G ⧸ U_i]` with `U_i` open.
* `Representation.finite_asModule_iff_exists_surjective_isCompact`: for a locally profinite
  group, the `U_i` may be taken compact open.

## References

* J. Bernstein, *Representations of p-adic groups*, Harvard lectures 1992, written by
  K. Rumelhart, Chapter I, §2.2, Theorem 3 and its proof, p. 13 (over `ℂ`, every smooth
  representation is a quotient of a direct sum of the modules `H(G) e_K ≅ ℂ[G ⧸ K]`).
-/

public section

open scoped MonoidAlgebra

namespace Representation

variable {A G V : Type*} [CommSemiring A] [Group G] [AddCommMonoid V] [Module A V]
  {ρ : Representation A G V}

variable [TopologicalSpace G]

/-- **Generators give a surjection from permutation representations.** If `V` is finitely
generated and every vector is fixed by an open subgroup satisfying `P`, then `V` is a quotient of
`⊕_{i < n} A[G ⧸ U_i]` for open subgroups `U_i` satisfying `P`. -/
theorem exists_surjective_of_finite_asModule [Module.Finite A[G] ρ.asModule]
    {P : OpenSubgroup G → Prop}
    (hP : ∀ v : V, ∃ U : OpenSubgroup G, P U ∧ (U : Subgroup G) ≤ ρ.stabilizer v) :
    ∃ (n : ℕ) (U : Fin n → OpenSubgroup G), (∀ i, P (U i)) ∧
      ∃ f : IntertwiningMap (directSum fun i ↦ ofMulAction A G (G ⧸ (U i : Subgroup G))) ρ,
        Function.Surjective f := by
  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := A[G]) (M := ρ.asModule)
  choose U hPU hU using fun i : Fin n ↦ hP (ρ.asModuleEquiv (s i))
  let f := IntertwiningMap.directSumToModule fun i ↦ ρ.cosetLift _ _ (hU i)
  refine ⟨n, U, hPU, f, ?_⟩
  have hrange : LinearMap.range (IntertwiningMap.equivLinearMapAsModule _ ρ f) = ⊤ := by
    rw [eq_top_iff, ← hs, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    refine ⟨(directSum _).asModuleEquiv.symm
      (DirectSum.lof A _ _ i (MonoidAlgebra.single ((1 : G) : G ⧸ (U i : Subgroup G)) 1)), ?_⟩
    rw [IntertwiningMap.equivLinearMapAsModule_apply, asModuleEquiv_symm_apply]
    simp only [f, IntertwiningMap.directSumToModule_lof, cosetLift_single, map_one, one_smul,
      one_apply_eq_self]
    exact asModuleEquiv_apply (s i)
  intro v
  obtain ⟨x, hx⟩ := LinearMap.range_eq_top.1 hrange (ρ.asModuleEquiv.symm v)
  rw [IntertwiningMap.equivLinearMapAsModule_apply, asModuleEquiv_symm_apply] at hx
  refine ⟨(directSum _).asModuleEquiv x, ?_⟩
  rw [asModuleEquiv_apply]
  exact hx

/-- **Finitely generated smooth representations are quotients of permutation representations.**
A smooth representation is finitely generated over `A[G]` exactly when it is a quotient of a
finite direct sum `⊕_{i < n} A[G ⧸ U_i]` for open subgroups `U_i`. -/
theorem finite_asModule_iff_exists_surjective [IsSmooth ρ] :
    Module.Finite A[G] ρ.asModule ↔
      ∃ (n : ℕ) (U : Fin n → OpenSubgroup G)
        (f : IntertwiningMap (directSum fun i ↦ ofMulAction A G (G ⧸ (U i : Subgroup G))) ρ),
        Function.Surjective f := by
  refine ⟨fun _ ↦ ?_, fun ⟨n, U, f, hf⟩ ↦ finite_asModule_of_surjective f hf⟩
  obtain ⟨n, U, -, hf⟩ := exists_surjective_of_finite_asModule (ρ := ρ) (P := fun _ ↦ True)
    fun v ↦ ⟨⟨ρ.stabilizer v, IsSmooth.isOpen_stabilizer v⟩, True.intro, le_rfl⟩
  exact ⟨n, U, hf⟩

/-- For a locally profinite group, a smooth representation is finitely generated over `A[G]`
exactly when it is a quotient of a finite direct sum `⊕_{i < n} A[G ⧸ U_i]` for compact open
subgroups `U_i`. -/
theorem finite_asModule_iff_exists_surjective_isCompact [NonarchimedeanGroup G]
    [WeaklyLocallyCompactSpace G] [IsSmooth ρ] :
    Module.Finite A[G] ρ.asModule ↔
      ∃ (n : ℕ) (U : Fin n → OpenSubgroup G), (∀ i, IsCompact (U i : Set G)) ∧
        ∃ f : IntertwiningMap (directSum fun i ↦ ofMulAction A G (G ⧸ (U i : Subgroup G))) ρ,
          Function.Surjective f := by
  refine ⟨fun _ ↦ exists_surjective_of_finite_asModule (ρ := ρ)
    (P := fun U ↦ IsCompact (U : Set G)) fun v ↦ ?_,
    fun ⟨n, U, _, f, hf⟩ ↦ finite_asModule_of_surjective f hf⟩
  exact mem_smoothVectors_iff_exists_isCompact_openSubgroup.1 (IsSmooth.mem_smoothVectors v)

end Representation
