module

public import TauCeti.RepresentationTheory.Smooth.Admissible

/-!
# Locally admissible representations

A smooth representation `V` of a topological group `G` over a commutative ring `A` is *locally
admissible* if every vector `v` generates an admissible subrepresentation `A[G] · v`, the
subrepresentation `Representation.cyclicSubrepresentation ρ v` corresponding to the cyclic
`A[G]`-submodule of `ρ.asModule` spanned by `v`. Over a noetherian ring every subrepresentation of
an admissible representation is admissible, so admissible representations are locally admissible
(`Representation.IsAdmissible.isLocallyAdmissible`). The converse needs finite generation and
invertible pro-orders, and is not proved here.

## Main definitions

* `Representation.cyclicSubrepresentation ρ v`: the subrepresentation `A[G] · v` generated by `v`.
* `Representation.IsLocallyAdmissible ρ`: every `A[G] · v` is admissible.

## Main results

* `Representation.mem_cyclicSubrepresentation_self`: `v ∈ A[G] · v`.
* `Representation.IsAdmissible.isLocallyAdmissible`: over a noetherian ring, admissible
  representations are locally admissible.
* `Representation.isLocallyAdmissible_trivial_self`: over a noetherian ring, the trivial rank-one
  representation is locally admissible.

## References

* F. Calegari and D. Geraghty, *Modularity lifting beyond the Taylor–Wiles method*,
  arXiv:1207.4224v2, §9.2.1, Definition 9.11, p. 91.
-/

public section

namespace Representation

variable {A G V : Type*} [CommRing A] [Group G] [AddCommGroup V] [Module A V]
  {ρ : Representation A G V}

variable (ρ) in
/-- The subrepresentation `A[G] · v` generated by a vector `v`: the cyclic `A[G]`-submodule of
`ρ.asModule` spanned by `v`, as a subrepresentation. -/
noncomputable def cyclicSubrepresentation (v : V) : Subrepresentation ρ :=
  Subrepresentation.ofSubmodule' (Submodule.span (MonoidAlgebra A G) {ρ.asModuleEquiv.symm v})

/-- A vector lies in the subrepresentation it generates. -/
theorem mem_cyclicSubrepresentation_self (v : V) : v ∈ cyclicSubrepresentation ρ v :=
  show ρ.asModuleEquiv.symm v ∈ Submodule.span (MonoidAlgebra A G) {ρ.asModuleEquiv.symm v} from
    Submodule.subset_span rfl

variable [TopologicalSpace G]

variable (ρ) in
/-- A representation is *locally admissible* if every vector generates an admissible
subrepresentation. -/
def IsLocallyAdmissible : Prop :=
  ∀ v : V, IsAdmissible (cyclicSubrepresentation ρ v).toRepresentation

theorem isLocallyAdmissible_iff :
    IsLocallyAdmissible ρ ↔ ∀ v : V, IsAdmissible (cyclicSubrepresentation ρ v).toRepresentation :=
  Iff.rfl

/-- **Admissible representations are locally admissible** over a noetherian ring. -/
theorem IsAdmissible.isLocallyAdmissible [IsNoetherianRing A] [IsAdmissible ρ] :
    IsLocallyAdmissible ρ :=
  fun _ ↦ inferInstance

variable (A G) in
/-- Over a noetherian ring, the trivial rank-one representation `A` is locally admissible. -/
theorem isLocallyAdmissible_trivial_self [IsNoetherianRing A] :
    IsLocallyAdmissible (trivial A G A) :=
  IsAdmissible.isLocallyAdmissible

end Representation
