/-!
# The image algebra of an absolutely irreducible representation

Let `K` be a field, `k ⊆ K` a subfield and `ρ : Representation K G V` a finite-dimensional
representation of a monoid whose image spans `End_K(V)` over `K` (Burnside's form of absolute
irreducibility). Its **character field** `k(ρ)` (`Representation.characterField`, also called the
trace field) is the subfield of `K` generated over `k` by the character values, and its **image
algebra** `B(ρ)` is the `k(ρ)`-subalgebra of `End_K(V)` generated by the image of `ρ`. This file
proves that `B(ρ)` is a `k(ρ)`-form of `End_K(V)`: multiplication `K ⊗_{k(ρ)} B(ρ) → End_K(V)` is
an isomorphism. Consequently `B(ρ)` is central simple over `k(ρ)` of dimension `n²`,
`n = dim_K V`, and it has a Schur index `s(ρ)` dividing `n` and a Brauer class `β(ρ)`, with
`s(ρ) = 1` exactly when `β(ρ) = 1`, and both equal to one when `k(ρ)` is finite.

The descent is `Subalgebra.tensorMulEndAlgEquiv` from
`TauCeti/LinearAlgebra/Trace/Descent.lean`: a subalgebra of `End_K(V)` over a subfield `F ⊆ K`
that spans `End_K(V)` and has all its traces in `F` is an `F`-form of `End_K(V)`. The image algebra
qualifies because its traces are `k(ρ)`-linear combinations of character values.

The Schur index and the Brauer class take the spanning hypothesis as an instance
`[Fact (Submodule.span K (Set.range ρ) = ⊤)]`, so that instance search sees `B(ρ)` as a
finite-dimensional central simple `k(ρ)`-algebra. The Brauer class needs `K` and `V` in one
universe, as `TauCeti.BrauerGroup.mk_eq_one_iff_isSplittingField` does.

## Main definitions

* `Representation.imageAlgebra`: the `k(ρ)`-subalgebra `B(ρ)` of `End_K(V)` generated by `ρ(G)`.
* `Representation.schurIndex`: the index `s(ρ)` of `B(ρ)` over `k(ρ)`.
* `Representation.brauerClass`: the class `β(ρ)` of `B(ρ)` in the Brauer group of `k(ρ)`.

## Main results

* `Representation.imageAlgebraBaseChangeAlgEquiv`: `K ⊗_{k(ρ)} B(ρ) ≅ End_K(V)`.
* `Representation.finrank_imageAlgebra`: `dim_{k(ρ)} B(ρ) = n²`.
* `Representation.isCentral_imageAlgebra`, `Representation.isSimpleRing_imageAlgebra`: `B(ρ)` is
  central simple over `k(ρ)`.
* `Representation.schurIndex_dvd_finrank`: `s(ρ) ∣ n`.
* `Representation.brauerClass_eq_one_iff_schurIndex_eq_one`: `β(ρ) = 1 ↔ s(ρ) = 1`.
* `Representation.brauerClass_eq_one_of_finite`: `β(ρ) = 1` when `k(ρ)` is finite.

Over an algebraically closed `K` an irreducible representation satisfies the spanning hypothesis
(`Representation.span_range_eq_top_of_isIrreducible`), and so does every one-dimensional
representation (`Representation.span_range_eq_top_of_finrank_eq_one`).

## References

* T. Barnet-Lamb, T. Gee, D. Geraghty, R. Taylor, *Potential automorphy and change of weight*,
  Ann. of Math. 179 (2014), proof of Lemma A.1.5.
* G. Chenevier, *The p-adic analytic space of pseudocharacters of a profinite group, and
  pseudorepresentations over arbitrary rings*, arXiv:0809.0415v2, Definition-Proposition 2.18.
* P. Deligne, J.-P. Serre, *Formes modulaires de poids 1*, Ann. Sci. ENS 7 (1974), proof of
  Lemme 6.13.
-/

public section

open Module
open scoped TensorProduct

namespace Representation


section Definitions

variable (k : Type*) {K G V : Type*} [Field k] [Field K] [Algebra k K] [Monoid G]
  [AddCommGroup V] [Module K V] (ρ : Representation K G V)

/-- The **image algebra** `B(ρ)`: the `k(ρ)`-subalgebra of `End_K(V)` generated by the image of
`ρ`, where `k(ρ)` is the character field. -/
noncomputable def imageAlgebra : Subalgebra (ρ.characterField k) (Module.End K V) :=
  Algebra.adjoin (ρ.characterField k) (Set.range ρ)

theorem imageAlgebra_def :
    ρ.imageAlgebra k = Algebra.adjoin (ρ.characterField k) (Set.range ρ) :=
  (rfl)

/-- Every `ρ(g)` lies in the image algebra. -/
@[simp]
theorem apply_mem_imageAlgebra (g : G) : ρ g ∈ ρ.imageAlgebra k :=
  Algebra.subset_adjoin (Set.mem_range_self g)

/-- The image algebra is the smallest `k(ρ)`-subalgebra containing every `ρ(g)`. -/
@[simp]
theorem imageAlgebra_le_iff (S : Subalgebra (ρ.characterField k) (Module.End K V)) :
    ρ.imageAlgebra k ≤ S ↔ ∀ g, ρ g ∈ S := by
  simp [imageAlgebra_def, Algebra.adjoin_le_iff, Set.range_subset_iff]

/-- As a `k(ρ)`-subspace, the image algebra is the `k(ρ)`-span of the image of `ρ`, since that image
is already closed under multiplication. -/
theorem toSubmodule_imageAlgebra :
    Subalgebra.toSubmodule (ρ.imageAlgebra k) =
      Submodule.span (ρ.characterField k) (Set.range ρ) := by
  rw [imageAlgebra_def, Algebra.adjoin_eq_span, ← MonoidHom.coe_mrange, Submonoid.closure_eq]

/-- Every element of the image algebra has trace in the character field. -/
theorem trace_mem_characterField {x : Module.End K V} (hx : x ∈ ρ.imageAlgebra k) :
    LinearMap.trace K V x ∈ ρ.characterField k := by
  have hx' : x ∈ Submodule.span (ρ.characterField k) (Set.range ρ) := by
    rw [← toSubmodule_imageAlgebra]; exact hx
  clear hx
  induction hx' using Submodule.span_induction with
  | mem y hy => obtain ⟨g, rfl⟩ := hy; exact ρ.character_mem_characterField k g
  | zero => simp
  | add y z _ _ hy hz => simpa using add_mem hy hz
  | smul a y _ hy =>
    rw [← algebraMap_smul K a y, map_smul, smul_eq_mul]
    exact mul_mem a.property hy

variable {k ρ}

/-- If the image of `ρ` spans `End_K(V)` over `K`, so does the image algebra. -/
theorem span_imageAlgebra_eq_top (hρ : Submodule.span K (Set.range ρ) = ⊤) :
    Submodule.span K (ρ.imageAlgebra k : Set (Module.End K V)) = ⊤ :=
  eq_top_mono (Submodule.span_mono (Set.range_subset_iff.mpr (ρ.apply_mem_imageAlgebra k))) hρ

end Definitions

section CentralSimple

variable {k K G V : Type*} [Field k] [Field K] [Algebra k K] [Monoid G]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V] {ρ : Representation K G V}
  (hρ : Submodule.span K (Set.range ρ) = ⊤)

/-- **The image algebra is a `k(ρ)`-form of `End_K(V)`**: when the image of `ρ` spans `End_K(V)`,
multiplication `K ⊗_{k(ρ)} B(ρ) → End_K(V)` is an isomorphism. -/
noncomputable def imageAlgebraBaseChangeAlgEquiv :
    K ⊗[ρ.characterField k] ρ.imageAlgebra k ≃ₐ[K] Module.End K V :=
  (ρ.imageAlgebra k).tensorMulEndAlgEquiv (span_imageAlgebra_eq_top hρ)
    fun _ hx => ρ.trace_mem_characterField k hx

@[simp]
theorem imageAlgebraBaseChangeAlgEquiv_tmul (a : K) (x : ρ.imageAlgebra k) :
    imageAlgebraBaseChangeAlgEquiv hρ (a ⊗ₜ x) = a • (x : Module.End K V) :=
  Subalgebra.tensorMulEndAlgEquiv_tmul _ _ _ a x

include hρ in
/-- The image algebra is finite-dimensional over the character field. -/
theorem finiteDimensional_imageAlgebra :
    FiniteDimensional (ρ.characterField k) (ρ.imageAlgebra k) :=
  (ρ.imageAlgebra k).finiteDimensional_of_trace_mem (span_imageAlgebra_eq_top hρ)
    fun _ hx => ρ.trace_mem_characterField k hx

include hρ in
/-- **The image algebra has dimension `n²`** over the character field, `n = dim_K V`. -/
theorem finrank_imageAlgebra :
    finrank (ρ.characterField k) (ρ.imageAlgebra k) = finrank K V ^ 2 :=
  (ρ.imageAlgebra k).finrank_of_trace_mem (span_imageAlgebra_eq_top hρ)
    fun _ hx => ρ.trace_mem_characterField k hx

include hρ in
/-- The image algebra is central over the character field. -/
theorem isCentral_imageAlgebra : Algebra.IsCentral (ρ.characterField k) (ρ.imageAlgebra k) :=
  (ρ.imageAlgebra k).isCentral_of_trace_mem (span_imageAlgebra_eq_top hρ)
    fun _ hx => ρ.trace_mem_characterField k hx

include hρ in
/-- The image algebra of a representation on a nonzero space is a simple ring. -/
theorem isSimpleRing_imageAlgebra [Nontrivial V] : IsSimpleRing (ρ.imageAlgebra k) :=
  (ρ.imageAlgebra k).isSimpleRing_of_trace_mem (span_imageAlgebra_eq_top hρ)
    fun _ hx => ρ.trace_mem_characterField k hx

include hρ in
/-- The degree of the image algebra over the character field is `n = dim_K V`. -/
theorem deg_imageAlgebra :
    TauCeti.Algebra.deg (ρ.characterField k) (ρ.imageAlgebra k) = finrank K V :=
  TauCeti.Algebra.deg_eq_of_finrank_eq_sq (finrank_imageAlgebra hρ)

end CentralSimple

/-! ### The Schur index and the Brauer class

These are stated under the spanning hypothesis as an instance argument
`[Fact (Submodule.span K (Set.range ρ) = ⊤)]`, which makes `B(ρ)` a finite-dimensional central
simple `k(ρ)`-algebra for instance search. -/

section SchurIndex

variable (k : Type*) {K G V : Type*} [Field k] [Field K] [Algebra k K] [Monoid G]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V] (ρ : Representation K G V)
  [hρ : Fact (Submodule.span K (Set.range ρ) = ⊤)]

instance instFiniteDimensionalImageAlgebra :
    FiniteDimensional (ρ.characterField k) (ρ.imageAlgebra k) :=
  finiteDimensional_imageAlgebra hρ.out

instance instIsCentralImageAlgebra : Algebra.IsCentral (ρ.characterField k) (ρ.imageAlgebra k) :=
  isCentral_imageAlgebra hρ.out

instance instIsSimpleRingImageAlgebra [Nontrivial V] : IsSimpleRing (ρ.imageAlgebra k) :=
  isSimpleRing_imageAlgebra hρ.out

variable [Nontrivial V]

/-- The **Schur index** `s(ρ)`: the index of the central simple algebra `B(ρ)` over `k(ρ)`. -/
noncomputable def schurIndex : ℕ :=
  TauCeti.Algebra.index (ρ.characterField k) (ρ.imageAlgebra k)

theorem schurIndex_def :
    ρ.schurIndex k = TauCeti.Algebra.index (ρ.characterField k) (ρ.imageAlgebra k) :=
  (rfl)

/-- **The Schur index divides the dimension**: `s(ρ) ∣ n`. -/
theorem schurIndex_dvd_finrank : ρ.schurIndex k ∣ finrank K V := by
  rw [schurIndex_def, ← deg_imageAlgebra (k := k) hρ.out]
  exact TauCeti.Algebra.index_dvd_deg _ _

/-- The Schur index is one exactly when `B(ρ)` is a matrix algebra over `k(ρ)`. -/
theorem schurIndex_eq_one_iff :
    ρ.schurIndex k = 1 ↔
      TauCeti.Algebra.IsSplittingField (ρ.characterField k) (ρ.imageAlgebra k)
        (ρ.characterField k) := by
  rw [schurIndex_def, TauCeti.Algebra.isSplittingField_self_iff_index_eq_one]

/-- Over a finite character field the Schur index is one. -/
theorem schurIndex_eq_one_of_finite [Finite (ρ.characterField k)] : ρ.schurIndex k = 1 :=
  TauCeti.Algebra.index_eq_one_of_finite _ _

end SchurIndex

section Brauer

universe u

variable (k : Type*) {K V : Type u} {G : Type*} [Field k] [Field K] [Algebra k K] [Monoid G]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V] [Nontrivial V] (ρ : Representation K G V)
  [Fact (Submodule.span K (Set.range ρ) = ⊤)]

/-- The **Brauer class** `β(ρ)` of the image algebra in the Brauer group of the character field. -/
noncomputable def brauerClass : BrauerGroup (ρ.characterField k) :=
  TauCeti.BrauerGroup.mk (TauCeti.CSA.of (ρ.characterField k) (ρ.imageAlgebra k))

theorem brauerClass_def :
    ρ.brauerClass k =
      TauCeti.BrauerGroup.mk (TauCeti.CSA.of (ρ.characterField k) (ρ.imageAlgebra k)) :=
  (rfl)

/-- **The Brauer class is trivial exactly when the Schur index is one.** -/
theorem brauerClass_eq_one_iff_schurIndex_eq_one :
    ρ.brauerClass k = 1 ↔ ρ.schurIndex k = 1 := by
  rw [brauerClass_def, TauCeti.BrauerGroup.mk_eq_one_iff_isSplittingField, schurIndex_eq_one_iff]

/-- Over a finite character field the Brauer class is trivial. -/
theorem brauerClass_eq_one_of_finite [Finite (ρ.characterField k)] : ρ.brauerClass k = 1 :=
  (brauerClass_eq_one_iff_schurIndex_eq_one k ρ).mpr (schurIndex_eq_one_of_finite k ρ)

end Brauer

/-! ### Checks -/

section Examples

/-- A one-dimensional representation (for instance a faithful character of `ℤ/3`) has a
one-dimensional image algebra over its character field. -/
example {k K G V : Type*} [Field k] [Field K] [Algebra k K] [Monoid G] [AddCommGroup V]
    [Module K V] [FiniteDimensional K V] (ρ : Representation K G V) (h : finrank K V = 1) :
    finrank (ρ.characterField k) (ρ.imageAlgebra k) = 1 := by
  rw [finrank_imageAlgebra (span_range_eq_top_of_finrank_eq_one ρ h), h, one_pow]

/-- Over an algebraically closed field, an irreducible representation has a central simple image
algebra over its character field. -/
example {k K G V : Type*} [Field k] [Field K] [Algebra k K] [IsAlgClosed K] [Monoid G]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] (ρ : Representation K G V)
    (h : ρ.IsIrreducible) :
    Algebra.IsCentral (ρ.characterField k) (ρ.imageAlgebra k) ∧ IsSimpleRing (ρ.imageAlgebra k) :=
  have := h.nontrivial
  ⟨isCentral_imageAlgebra (span_range_eq_top_of_isIrreducible h),
    isSimpleRing_imageAlgebra (span_range_eq_top_of_isIrreducible h)⟩

/-- Over a finite field `k`, a representation with finite image has trivial Brauer class. -/
example {k K V G : Type} [Field k] [Finite k] [Field K] [Algebra k K]
    [Monoid G] [AddCommGroup V] [Module K V] [FiniteDimensional K V] [Nontrivial V]
    (ρ : Representation K G V) [Fact (Submodule.span K (Set.range ρ) = ⊤)]
    (h : (Set.range ρ).Finite) : ρ.brauerClass k = 1 :=
  have := finite_characterField k h
  ρ.brauerClass_eq_one_of_finite k

end Examples

end Representation
