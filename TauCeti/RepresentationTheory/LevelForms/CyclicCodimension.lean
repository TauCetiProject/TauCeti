module

public import TauCeti.RepresentationTheory.LevelForms.Action
import TauCeti.GroupTheory.DoubleCoset.Map
import TauCeti.GroupTheory.SpecificGroups.Cyclic.Adjoin
import TauCeti.LinearAlgebra.FixedSubmodule.Codimension

/-!
# Codimension of cyclic norm conditions on level forms

A translation has period `n` modulo the level if its `n`th power is the first positive power
lying in the level. When adjoining the translation leaves the arithmetic stabilizers trivial,
its fixed space has exactly `1/n` of the original dimension. Consequently, imposing several
cyclic norm conditions loses at most that share of the dimension per condition.

This is the dimension argument of `New.Data.finrank_ker_one_sub_scalingGenerator_le` and
`New.Data.le_finrank_ramifiedSourceForms` in `grh/src/New/UpperBound/Size/ShortColumns.lean`
of [lsernau/grh-lean](https://github.com/lsernau/grh-lean), revision `72fead1`.
-/

public section

open Module Subgroup TauCeti

namespace Representation

variable {G K M : Type*} [Group G] [Field K] [AddCommGroup M] [Module K M]
  {J₀ J : Subgroup G} (ρ : Representation K Jᵐᵒᵖ M) (Γ : Subgroup G)
  (h : J₀ ≤ J) (hn : J ≤ normalizer (J₀ : Set G))

/-- If the level enlarged by `z` has trivial stabilizers, then the dimension of the fixed
space of `z`, multiplied by its least positive period modulo the original level, is the
original dimension. Only the level generated by `J₀` and `z` needs to be free. -/
theorem mul_finrank_fixedSubmodule_levelFormsAction_eq_of_isLeast
    [FiniteDimensional K M] [Finite (DoubleCoset.Quotient (Γ : Set G) J₀)]
    (z : J) {n : ℕ} (hz : IsLeast {i : ℕ | 0 < i ∧ (z : G) ^ i ∈ J₀} n)
    (hfree : ∀ g : G, mackeySubgroup g (J₀ ⊔ zpowers (z : G)) Γ = ⊥) :
    n * finrank K (ρ.levelFormsAction Γ h hn z).fixedSubmodule =
      finrank K (levelForms (ρ.comp (MonoidHom.op (inclusion h))) Γ) := by
  let L := J₀ ⊔ zpowers (z : G)
  have h₀ : J₀ ≤ L := le_sup_left
  have hL : L ≤ J := sup_le h (zpowers_le.mpr z.property)
  let zL : L := ⟨z, (le_sup_right : zpowers (z : G) ≤ L) (mem_zpowers (z : G))⟩
  have hzp : zpowers zL = (zpowers (z : G)).subgroupOf L := by
    ext a
    simp only [mem_zpowers_iff, mem_subgroupOf, ← Subtype.coe_inj, Subgroup.coe_zpow, zL]
  have hgen : J₀.subgroupOf L ⊔ zpowers zL = ⊤ := by
    rw [hzp, ← subgroupOf_sup h₀ le_sup_right, subgroupOf_self]
  have hidx : J₀.relIndex L = n := J₀.relIndex_sup_zpowers_eq_of_isLeast_pow_mem (hn z.property) hz
  have : J₀.IsFiniteRelIndex L := ⟨hidx.symm ▸ hz.1.1.ne'⟩
  let : Finite (DoubleCoset.Quotient (Γ : Set G) L) :=
    Finite.of_surjective (DoubleCoset.quotientMapOfLERight Γ h₀)
      (DoubleCoset.quotientMapOfLERight_surjective Γ h₀)
  let σ : Representation K Lᵐᵒᵖ M := ρ.comp (MonoidHom.op (inclusion hL))
  have hdim := σ.relIndex_mul_finrank_fixedSubmodule_levelFormsAction Γ h₀
    (hL.trans hn) zL hgen hfree
  have hact : σ.levelFormsAction Γ h₀ (hL.trans hn) zL = ρ.levelFormsAction Γ h hn z := by
    apply LinearMap.ext
    intro f
    apply Subtype.ext
    refine (coe_levelFormsAction_apply σ Γ h₀ (hL.trans hn) zL f).trans
      (Eq.trans ?_ (coe_levelFormsAction_apply ρ Γ h hn z f).symm)
    funext g
    simp only [levelAction_apply]
    rfl
  rw [hidx] at hdim
  exact (congrArg (fun A ↦ n * finrank K A.fixedSubmodule) hact.symm).trans hdim

/-- For translations with the same least positive period `n` modulo the level, the common
kernel of their cyclic norms loses at most one `1/n` share per translation, provided each
single cyclic enlargement has trivial stabilizers. No freeness of the joint enlargement
or commutativity of the translations is required. -/
theorem mul_finrank_iInf_ker_sum_pow_levelFormsAction_ge
    [FiniteDimensional K M] [Finite (DoubleCoset.Quotient (Γ : Set G) J₀)]
    {ι : Type*} [Fintype ι] (z : ι → J) {n : ℕ}
    (hz : ∀ i, IsLeast {k : ℕ | 0 < k ∧ (z i : G) ^ k ∈ J₀} n)
    (hfree : ∀ i g, mackeySubgroup g (J₀ ⊔ zpowers (z i : G)) Γ = ⊥) :
    (n - Fintype.card ι) * finrank K (levelForms (ρ.comp (MonoidHom.op (inclusion h))) Γ) ≤
      n * finrank K (↥(⨅ i, LinearMap.ker
        (∑ j ∈ Finset.range n, (ρ.levelFormsAction Γ h hn (z i)) ^ j)) : Type _) := by
  refine LinearMap.mul_finrank_iInf_ker_sum_pow_ge _ (fun i ↦ ?_) fun i ↦ ?_
  · rw [← map_pow]
    exact LinearMap.ext fun f ↦
      ρ.levelFormsAction_apply_inclusion Γ h hn ⟨(z i : G) ^ n, (hz i).1.2⟩ f
  · exact (ρ.mul_finrank_fixedSubmodule_levelFormsAction_eq_of_isLeast Γ h hn
      (z i) (hz i) (hfree i)).le

end Representation
