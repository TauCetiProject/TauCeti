module

public import TauCeti.GroupTheory.Elementary
public import TauCeti.RepresentationTheory.Induction.ClassFunction
-- Non-public: the fixed-coset criterion is used only inside proofs.
import TauCeti.GroupTheory.QuotientGroup.Basic

/-!
# The class function induced from a `p`-elementary subgroup

Fix a prime `p`, an element `s` of a finite group `G` whose order is prime to `p`, and a Sylow
`p`-subgroup `P` of the centraliser `C_G(s)`.  The subgroup `H = TauCeti.pElementaryOfSylow s P`
generated by `s` and `P` is `p`-elementary, and the **`p`-section of `s` in `H`** is the set of
elements of `H` whose `p`-free part is `s`.  Because `H` centralises `s`, that set is stable under
conjugation in `H`, so its indicator `TauCeti.pSectionIndicator` is a class function of `H`.

This file computes the class function of `G` induced from that indicator.  Its value is the number
`TauCeti.pSectionCosetCard` of left cosets of `H` that conjugate the argument into the `p`-section,
and that count is

* zero unless the `p`-free part of the argument is conjugate to `s`;
* the relative index `[C_G(s) : H]`, which is prime to `p`, at `s` itself; and
* congruent to that relative index modulo `p` at every element whose `p`-free part is `s`, because
  the contributing cosets are the fixed points of the `p`-element `s⁻¹x` acting on the cosets of
  `H` in `C_G(s)`.

So `TauCeti.pSectionCosetCard` is prime to `p` on the whole `p`-section of `s`, and the induced
class function's value there is the cast of this count into the coefficient semiring.  It vanishes
off the conjugates of that section.  This is the local computation behind Brauer's induction
theorem, which writes every character as an integral combination of characters induced from
elementary subgroups: one such class function is attached to each `p`-regular class, and their
values modulo `p` are what an integral combination is assembled from.

## Main definitions

* `TauCeti.pSectionIndicator`: the indicator of the `p`-section of `s` in `H`.
* `TauCeti.indPSectionIndicator`: the class function of `G` induced from it.
* `TauCeti.pSectionCosetCard`: the number of cosets of `H` contributing to that induced value.

## Main statements

* `TauCeti.pSectionIndicator_mem_classFunction` and
  `TauCeti.indPSectionIndicator_mem_classFunction`: both functions are class functions.
* `TauCeti.conj_mem_pElementaryOfSylow_and_pFreePart_eq_iff`: a conjugate of `x` lies in the
  `p`-section of `s` exactly when the two factors of `x` are carried to `s` and into `H`.
* `TauCeti.indPSectionIndicator_eq_pSectionCosetCard`: the induced class function is the coset
  count, read in the coefficient ring.
* `TauCeti.pSectionCosetCard_eq_zero_of_not_isConj` and
  `TauCeti.indPSectionIndicator_eq_zero_of_not_isConj`: the count vanishes off the conjugates of
  the `p`-section.
* `TauCeti.pSectionCosetCard_self` and `TauCeti.indPSectionIndicator_self`: at `s` the count is the
  relative index of `H` in `C_G(s)`.
* `TauCeti.pSectionCosetCard_modEq`: on the `p`-section of `s` the count is that relative index
  modulo `p`.
* `TauCeti.not_dvd_pSectionCosetCard`: hence the count is prime to `p` on the whole `p`-section,
  and by conjugation invariance (`TauCeti.pSectionCosetCard_conj`) on every conjugate of it,
  `TauCeti.not_dvd_pSectionCosetCard_of_isConj`.

## References

* J.-P. Serre, *Linear Representations of Finite Groups*, Springer GTM 42 (1977), Part II, §10.3.
* I. M. Isaacs, *Character Theory of Finite Groups*, AMS Chelsea (1976), Chapter 8.
-/

public section

namespace TauCeti

open _root_.Subgroup

universe u v

variable {k : Type u} {G : Type v} [Group G] {p : ℕ} {s : G}
  {P : Sylow p (centralizer ({s} : Set G))}

/-! ### The indicator of a `p`-section and the class function it induces -/

section Indicator

variable [Zero k] [One k]

open scoped Classical in
/-- **The indicator of the `p`-section of `s`** inside the `p`-elementary subgroup attached to `s`
and a Sylow `p`-subgroup `P` of the centraliser of `s`: it is `1` on the elements whose `p`-free
part is `s`, and `0` elsewhere. -/
noncomputable def pSectionIndicator (k : Type u) [Zero k] [One k] (s : G)
    (P : Sylow p (centralizer ({s} : Set G))) : ↥(pElementaryOfSylow s P) → k :=
  fun x => if pFreePart p (x : G) = s then 1 else 0

open scoped Classical in
/-- The defining case split of `TauCeti.pSectionIndicator`. -/
@[simp]
theorem pSectionIndicator_apply (x : ↥(pElementaryOfSylow s P)) :
    pSectionIndicator k s P x = if pFreePart p (x : G) = s then 1 else 0 :=
  (rfl)

end Indicator

variable [Semiring k]

/-- **The `p`-section indicator is a class function.**  Conjugation transports the `p`-free part,
and the `p`-elementary subgroup centralises `s`, so conjugating inside it does not move the
condition `pFreePart p x = s`. -/
theorem pSectionIndicator_mem_classFunction :
    pSectionIndicator k s P ∈ ClassFunction k ↥(pElementaryOfSylow s P) := by
  classical
  refine ClassFunction.mem_iff.mpr fun x c => ?_
  have hcom : (c : G) * s = s * (c : G) :=
    mem_centralizer_singleton_iff.1 (pElementaryOfSylow_le_centralizer s P c.2)
  have hc : (c : G) * s * (c : G)⁻¹ = s := by rw [hcom, mul_inv_cancel_right]
  have hc' : (c : G)⁻¹ * s * (c : G) = s := by
    rw [mul_assoc, ← hcom, inv_mul_cancel_left]
  simp only [pSectionIndicator_apply, Subgroup.coe_mul, Subgroup.coe_inv, pFreePart_conj]
  refine if_congr ⟨fun h => ?_, fun h => ?_⟩ rfl rfl
  · calc pFreePart p (x : G)
        = (c : G)⁻¹ * ((c : G) * pFreePart p (x : G) * (c : G)⁻¹) * (c : G) := by group
      _ = (c : G)⁻¹ * s * (c : G) := by rw [h]
      _ = s := hc'
  · rw [h]
    exact hc

/-- **The class function of `G` induced from the `p`-section indicator.**  Its values are computed
by `TauCeti.indPSectionIndicator_eq_pSectionCosetCard`. -/
noncomputable def indPSectionIndicator (k : Type u) [Semiring k] [Finite G] (s : G)
    (P : Sylow p (centralizer ({s} : Set G))) : G → k :=
  indClassFun (pElementaryOfSylow s P) (pSectionIndicator k s P)

/-- The induced `p`-section indicator is the induction of the `p`-section indicator. -/
theorem indPSectionIndicator_def [Finite G] :
    indPSectionIndicator k s P = indClassFun (pElementaryOfSylow s P) (pSectionIndicator k s P) :=
  (rfl)

/-- The induced `p`-section indicator is a class function of `G`. -/
theorem indPSectionIndicator_mem_classFunction [Finite G] :
    indPSectionIndicator k s P ∈ ClassFunction k G :=
  indClassFun_mem_classFunction pSectionIndicator_mem_classFunction

/-! ### The contributing cosets -/

/-- **The number of cosets contributing to the induced `p`-section indicator**: those left cosets
of the `p`-elementary subgroup whose representatives conjugate the `p`-free part of `x` to `s` and
the `p`-part of `x` into the subgroup.  By
`TauCeti.conj_mem_pElementaryOfSylow_and_pFreePart_eq_iff` this says exactly that the conjugate of
`x` lies in the `p`-section of `s`. -/
noncomputable def pSectionCosetCard (s : G)
    (P : Sylow p (centralizer ({s} : Set G))) (x : G) : ℕ :=
  Nat.card {t : G ⧸ pElementaryOfSylow s P //
    (Quotient.out t)⁻¹ * pFreePart p x * Quotient.out t = s ∧
      (Quotient.out t)⁻¹ * pPart p x * Quotient.out t ∈ pElementaryOfSylow s P}

/-- **A conjugate of `x` lies in the `p`-section of `s`** exactly when the conjugating element
carries the `p`-free part of `x` to `s` and the `p`-part of `x` into the subgroup.  The two
factorisations `x = pFreePart · pPart` and `y = s · pPart y` correspond term by term. -/
theorem conj_mem_pElementaryOfSylow_and_pFreePart_eq_iff [Fact p.Prime] (hs : ¬ p ∣ orderOf s)
    (x g : G) :
    (g⁻¹ * x * g ∈ pElementaryOfSylow s P ∧ pFreePart p (g⁻¹ * x * g) = s) ↔
      (g⁻¹ * pFreePart p x * g = s ∧ g⁻¹ * pPart p x * g ∈ pElementaryOfSylow s P) := by
  have hfree : pFreePart p (g⁻¹ * x * g) = g⁻¹ * pFreePart p x * g := by
    simpa using pFreePart_conj p g⁻¹ x
  have hpart : pPart p (g⁻¹ * x * g) = g⁻¹ * pPart p x * g := by
    simpa using pPart_conj p g⁻¹ x
  constructor
  · rintro ⟨hmem, heq⟩
    refine ⟨hfree ▸ heq, ?_⟩
    rw [← hpart]
    exact map_sylow_le_pElementaryOfSylow s P
      (pPart_mem_map_sylow_of_mem_pElementaryOfSylow s P hs hmem)
  · rintro ⟨heq, hmem⟩
    refine ⟨?_, hfree.trans heq⟩
    have hx : g⁻¹ * x * g = (g⁻¹ * pFreePart p x * g) * (g⁻¹ * pPart p x * g) :=
      calc g⁻¹ * x * g = g⁻¹ * (pFreePart p x * pPart p x) * g := by rw [pFreePart_mul_pPart]
        _ = (g⁻¹ * pFreePart p x * g) * (g⁻¹ * pPart p x * g) := by group
    rw [hx, heq]
    exact mul_mem (self_mem_pElementaryOfSylow s P) hmem

/-- **The induced `p`-section indicator counts cosets.** -/
theorem indPSectionIndicator_eq_pSectionCosetCard [Finite G] [Fact p.Prime]
    (hs : ¬ p ∣ orderOf s) (x : G) :
    indPSectionIndicator k s P x = (pSectionCosetCard s P x : k) := by
  classical
  let := Fintype.ofFinite (G ⧸ pElementaryOfSylow s P)
  rw [indPSectionIndicator, indClassFun_apply, pSectionCosetCard, Nat.card_eq_fintype_card,
    Fintype.card_subtype, ← Finset.sum_boole]
  refine Finset.sum_congr rfl fun t _ => ?_
  by_cases hmem : (Quotient.out t)⁻¹ * x * Quotient.out t ∈ pElementaryOfSylow s P
  · rw [dite_eq_left hmem, pSectionIndicator_apply]
    by_cases hfree : pFreePart p ((Quotient.out t)⁻¹ * x * Quotient.out t) = s
    · rw [ite_eq_left hfree, ite_eq_left
        ((conj_mem_pElementaryOfSylow_and_pFreePart_eq_iff hs x _).1 ⟨hmem, hfree⟩)]
    · rw [ite_eq_right hfree, ite_eq_right fun hcond =>
        hfree ((conj_mem_pElementaryOfSylow_and_pFreePart_eq_iff hs x _).2 hcond).2]
  · rw [dite_eq_right hmem, ite_eq_right fun hcond =>
      hmem ((conj_mem_pElementaryOfSylow_and_pFreePart_eq_iff hs x _).2 hcond).1]

/-! ### Vanishing off the conjugates of the `p`-section -/

/-- **The count vanishes unless the `p`-free part of `x` is conjugate to `s`.** -/
theorem pSectionCosetCard_eq_zero_of_not_isConj {x : G}
    (hx : ¬ IsConj (pFreePart p x) s) : pSectionCosetCard s P x = 0 := by
  have : IsEmpty {t : G ⧸ pElementaryOfSylow s P //
      (Quotient.out t)⁻¹ * pFreePart p x * Quotient.out t = s ∧
        (Quotient.out t)⁻¹ * pPart p x * Quotient.out t ∈ pElementaryOfSylow s P} :=
    ⟨fun t => hx (isConj_iff.2 ⟨(Quotient.out t)⁻¹, by simpa using t.2.1⟩)⟩
  rw [pSectionCosetCard, Nat.card_of_isEmpty]

/-- **The induced `p`-section indicator vanishes off the conjugates of the `p`-section.** -/
theorem indPSectionIndicator_eq_zero_of_not_isConj [Finite G] [Fact p.Prime]
    (hs : ¬ p ∣ orderOf s) {x : G} (hx : ¬ IsConj (pFreePart p x) s) :
    indPSectionIndicator k s P x = 0 := by
  rw [indPSectionIndicator_eq_pSectionCosetCard hs, pSectionCosetCard_eq_zero_of_not_isConj hx,
    Nat.cast_zero]

/-! ### The count on the `p`-section of `s` -/

/-- Centralising `s` depends only on the coset of the element, since the `p`-elementary subgroup
centralises `s`. -/
private theorem mem_centralizer_of_mk_eq {g g' : G}
    (hgg : (g : G ⧸ pElementaryOfSylow s P) = (g' : G ⧸ pElementaryOfSylow s P))
    (h : g ∈ centralizer ({s} : Set G)) : g' ∈ centralizer ({s} : Set G) := by
  have hg' : g' = g * (g⁻¹ * g') := by group
  rw [hg']
  exact mul_mem h (pElementaryOfSylow_le_centralizer s P (QuotientGroup.eq.1 hgg))

/-- A coset of the `p`-elementary subgroup inside the centraliser of `s` is fixed by an element
`a` of that centraliser exactly when a representative conjugates `a` into the subgroup. -/
private theorem smul_mk_eq_self_iff (a : G) (ha : a ∈ centralizer ({s} : Set G))
    (z : ↥(centralizer ({s} : Set G))) :
    (⟨a, ha⟩ : ↥(centralizer ({s} : Set G))) •
        (z : ↥(centralizer ({s} : Set G)) ⧸
          (pElementaryOfSylow s P).subgroupOf (centralizer ({s} : Set G))) = z ↔
      (z : G)⁻¹ * a * (z : G) ∈ pElementaryOfSylow s P := by
  rw [smul_quotientGroup_mk_eq_self_iff]
  simp [mem_subgroupOf]

/-- The chosen representative of the coset of an element of the centraliser again centralises `s`
and conjugates `a` the same way. -/
private theorem out_mk_conj_mem (a : G) {z : ↥(centralizer ({s} : Set G))}
    (hz : (z : G)⁻¹ * a * (z : G) ∈ pElementaryOfSylow s P) :
    (Quotient.out ((z : G) : G ⧸ pElementaryOfSylow s P))⁻¹ * s *
          Quotient.out ((z : G) : G ⧸ pElementaryOfSylow s P) = s ∧
        (Quotient.out ((z : G) : G ⧸ pElementaryOfSylow s P))⁻¹ * a *
          Quotient.out ((z : G) : G ⧸ pElementaryOfSylow s P) ∈ pElementaryOfSylow s P := by
  have hmk : ((z : G) : G ⧸ pElementaryOfSylow s P) =
      ((Quotient.out ((z : G) : G ⧸ pElementaryOfSylow s P) : G) :
        G ⧸ pElementaryOfSylow s P) :=
    (QuotientGroup.out_eq' _).symm
  refine ⟨?_, ?_⟩
  · rw [mul_assoc, inv_mul_eq_iff_eq_mul, eq_comm]
    exact mem_centralizer_singleton_iff.1 (mem_centralizer_of_mk_eq hmk z.2)
  rw [← smul_quotientGroup_mk_eq_self_iff, ← hmk, smul_quotientGroup_mk_eq_self_iff]
  exact hz

/-- **The contributing cosets are the cosets fixed inside the centraliser.**  A representative
contributes exactly when it centralises `s` and conjugates `a` into the `p`-elementary subgroup,
and passing to the centraliser turns the second condition into fixing the coset. -/
private theorem card_cosets_eq (a : G) (ha : a ∈ centralizer ({s} : Set G)) :
    Nat.card {t : G ⧸ pElementaryOfSylow s P //
        (Quotient.out t)⁻¹ * s * Quotient.out t = s ∧
          (Quotient.out t)⁻¹ * a * Quotient.out t ∈ pElementaryOfSylow s P} =
      Nat.card {q : ↥(centralizer ({s} : Set G)) ⧸
          (pElementaryOfSylow s P).subgroupOf (centralizer ({s} : Set G)) //
        (⟨a, ha⟩ : ↥(centralizer ({s} : Set G))) • q = q} := by
  refine (Nat.card_eq_of_bijective
    (fun q => ⟨(((Quotient.out q.1 : ↥(centralizer ({s} : Set G))) : G) :
        G ⧸ pElementaryOfSylow s P),
      out_mk_conj_mem a ((smul_mk_eq_self_iff a ha _).1
        (by rw [QuotientGroup.out_eq']; exact q.2))⟩) ⟨?_, ?_⟩).symm
  · intro q₁ q₂ h
    have h' := QuotientGroup.eq.1 (congrArg Subtype.val h)
    refine Subtype.ext ?_
    rw [← QuotientGroup.out_eq' q₁.1, ← QuotientGroup.out_eq' q₂.1]
    exact QuotientGroup.eq.2 (mem_subgroupOf.2 (by simpa using h'))
  · rintro ⟨t, ht⟩
    have hZ : Quotient.out t ∈ centralizer ({s} : Set G) := by
      rw [mem_centralizer_singleton_iff]
      have h := ht.1
      rwa [mul_assoc, inv_mul_eq_iff_eq_mul, eq_comm] at h
    refine ⟨⟨((⟨Quotient.out t, hZ⟩ : ↥(centralizer ({s} : Set G))) :
      ↥(centralizer ({s} : Set G)) ⧸
        (pElementaryOfSylow s P).subgroupOf (centralizer ({s} : Set G))),
      (smul_mk_eq_self_iff a ha _).2 ht.2⟩, Subtype.ext ?_⟩
    have h1 := QuotientGroup.eq.1 (QuotientGroup.out_eq'
      ((⟨Quotient.out t, hZ⟩ : ↥(centralizer ({s} : Set G))) :
        ↥(centralizer ({s} : Set G)) ⧸
          (pElementaryOfSylow s P).subgroupOf (centralizer ({s} : Set G))))
    exact (QuotientGroup.eq.2 (by simpa using mem_subgroupOf.1 h1)).trans (QuotientGroup.out_eq' t)

/-- **On the `p`-section of `s` the contributing cosets are the cosets of the `p`-elementary
subgroup in the centraliser of `s` that the `p`-part of `x` fixes.** -/
private theorem pSectionCosetCard_eq_card_fixed {x : G} (hx : pFreePart p x = s)
    (hu : pPart p x ∈ centralizer ({s} : Set G)) :
    pSectionCosetCard s P x =
      Nat.card {q : ↥(centralizer ({s} : Set G)) ⧸
          (pElementaryOfSylow s P).subgroupOf (centralizer ({s} : Set G)) //
        (⟨pPart p x, hu⟩ : ↥(centralizer ({s} : Set G))) • q = q} := by
  rw [pSectionCosetCard, hx, card_cosets_eq]

/-- **At `s` itself the count is the relative index of the `p`-elementary subgroup in the
centraliser of `s`**, which is prime to `p` by
`TauCeti.not_dvd_relIndex_pElementaryOfSylow`: the `p`-part of `s` is trivial, so every coset of
the subgroup in the centraliser contributes. -/
@[simp]
theorem pSectionCosetCard_self [Fact p.Prime] (hs : ¬ p ∣ orderOf s) :
    pSectionCosetCard s P s =
      (pElementaryOfSylow s P).relIndex (centralizer ({s} : Set G)) := by
  have hx : pFreePart p s = s :=
    (eq_pFreePart Fact.out (Commute.one_right s) (mul_one s) hs (k := 0) (by simp)).symm
  have hu : pPart p s ∈ centralizer ({pFreePart p s} : Set G) :=
    mem_centralizer_singleton_iff.2 (commute_pFreePart_pPart p s).symm.eq
  rw [hx] at hu
  have hpart : pPart p s = 1 := by
    have h := pFreePart_mul_pPart p s
    rw [hx] at h
    exact mul_left_cancel (h.trans (mul_one s).symm)
  have hone : (⟨pPart p s, hu⟩ : ↥(centralizer ({s} : Set G))) = 1 :=
    Subtype.ext hpart
  have hall : ∀ q : ↥(centralizer ({s} : Set G)) ⧸
      (pElementaryOfSylow s P).subgroupOf (centralizer ({s} : Set G)),
      (⟨pPart p s, hu⟩ : ↥(centralizer ({s} : Set G))) • q = q := by
    intro q
    rw [hone, one_smul]
  rw [pSectionCosetCard_eq_card_fixed hx hu, Nat.card_congr (Equiv.subtypeUnivEquiv hall),
    Subgroup.relIndex, Subgroup.index_eq_card]

/-- **The count is constant modulo `p` along the `p`-section of `s`.**  The contributing cosets
are the fixed points of the `p`-element `pPart p x` acting by translation on the cosets of the
`p`-elementary subgroup in the centraliser of `s`, and a `p`-group has as many fixed points as
points modulo `p`. -/
theorem pSectionCosetCard_modEq [Finite G] [Fact p.Prime] {x : G}
    (hx : pFreePart p x = s) :
    pSectionCosetCard s P x ≡ pSectionCosetCard s P s [MOD p] := by
  have hs : ¬ p ∣ orderOf s := by
    rw [← hx]
    exact not_dvd_orderOf_pFreePart Fact.out (orderOf_pos x).ne'
  have hu : pPart p x ∈ centralizer ({pFreePart p x} : Set G) :=
    mem_centralizer_singleton_iff.2 (commute_pFreePart_pPart p x).symm.eq
  rw [hx] at hu
  have hpg : IsPGroup p (zpowers (⟨pPart p x, hu⟩ : ↥(centralizer ({s} : Set G)))) := by
    refine IsPGroup.of_card_dvd_pow (n := (orderOf x).factorization p) ?_
    rw [Nat.card_zpowers, orderOf_mk, orderOf_pPart Fact.out (orderOf_pos x).ne']
  have hmem : ∀ q : ↥(centralizer ({s} : Set G)) ⧸
      (pElementaryOfSylow s P).subgroupOf (centralizer ({s} : Set G)),
      ((⟨pPart p x, hu⟩ : ↥(centralizer ({s} : Set G))) • q = q) ↔
        q ∈ MulAction.fixedPoints
          (zpowers (⟨pPart p x, hu⟩ : ↥(centralizer ({s} : Set G)))) _ := by
    intro q
    constructor
    · rintro h ⟨g, hg⟩
      have hle : zpowers (⟨pPart p x, hu⟩ : ↥(centralizer ({s} : Set G))) ≤
          MulAction.stabilizer _ q := zpowers_le.2 (MulAction.mem_stabilizer_iff.2 h)
      simpa using MulAction.mem_stabilizer_iff.1 (hle hg)
    · intro h
      simpa using h ⟨_, mem_zpowers _⟩
  rw [pSectionCosetCard_eq_card_fixed hx hu, pSectionCosetCard_self hs, Subgroup.relIndex,
    Subgroup.index_eq_card, Nat.card_congr (Equiv.subtypeEquivRight hmem)]
  exact (hpg.card_modEq_card_fixedPoints _).symm

/-- **The count is prime to `p` everywhere on the `p`-section of `s`.** -/
theorem not_dvd_pSectionCosetCard [Finite G] [Fact p.Prime] {x : G}
    (hx : pFreePart p x = s) : ¬ p ∣ pSectionCosetCard s P x := by
  have hs : ¬ p ∣ orderOf s := by
    rw [← hx]
    exact not_dvd_orderOf_pFreePart Fact.out (orderOf_pos x).ne'
  intro hdvd
  refine not_dvd_relIndex_pElementaryOfSylow s P ?_
  rw [← pSectionCosetCard_self hs]
  exact Nat.modEq_zero_iff_dvd.1
    ((pSectionCosetCard_modEq hx).symm.trans (Nat.modEq_zero_iff_dvd.2 hdvd))

/-- **The count is a class function of `x`**: it is the induced `p`-section indicator read with
natural-number coefficients, and induced class functions are class functions. -/
theorem pSectionCosetCard_conj [Finite G] [Fact p.Prime] (hs : ¬ p ∣ orderOf s) (c x : G) :
    pSectionCosetCard s P (c * x * c⁻¹) = pSectionCosetCard s P x := by
  have h := ClassFunction.mem_iff.1
    (indPSectionIndicator_mem_classFunction (k := ℕ) (s := s) (P := P)) x c
  simpa only [indPSectionIndicator_eq_pSectionCosetCard hs, Nat.cast_id] using h

/-- **The count is prime to `p` on every conjugate of the `p`-section of `s`**: the class-function
form of `TauCeti.not_dvd_pSectionCosetCard`. -/
theorem not_dvd_pSectionCosetCard_of_isConj [Finite G] [Fact p.Prime] (hs : ¬ p ∣ orderOf s)
    {x : G} (hx : IsConj (pFreePart p x) s) : ¬ p ∣ pSectionCosetCard s P x := by
  obtain ⟨c, hc⟩ := isConj_iff.1 hx
  rw [← pSectionCosetCard_conj hs c x]
  exact not_dvd_pSectionCosetCard (by rw [pFreePart_conj, hc])

/-- **The value of the induced `p`-section indicator at `s`.** -/
@[simp]
theorem indPSectionIndicator_self [Finite G] [Fact p.Prime] (hs : ¬ p ∣ orderOf s) :
    indPSectionIndicator k s P s =
      ((pElementaryOfSylow s P).relIndex (centralizer ({s} : Set G)) : k) := by
  rw [indPSectionIndicator_eq_pSectionCosetCard hs, pSectionCosetCard_self hs]

end TauCeti
