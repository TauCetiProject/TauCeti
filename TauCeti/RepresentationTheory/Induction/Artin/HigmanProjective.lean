/-!
# Multiplicative functions of finite modules that are trivial on projective modules

Let `Δ` be a finite group, `z` a central element of `Δ`, `ℓ` a prime and `R` a ring,
and consider the finite `R[Δ]`-modules killed by `ℓ` on which `z` fixes no nonzero vector. This
file proves that a function `φ` on modules with values in `ℚ≥0`, multiplicative in the short exact
sequences whose middle term is such a module, is identically `1` on these modules as soon as it is
`1` on those that satisfy Higman's criterion: some additive `τ : P → P` has `∑ g, g τ g⁻¹ = 1`.
Over `ZMod ℓ`, Higman's criterion characterizes the projective modules of a group algebra, so this
says that such an invariant is determined by its values on projective modules; it is a form of the
finiteness of the cokernel of the Cartan map.

Such invariants arise as ratios of numbers of cocycles to powers of the order of the module,
which are multiplicative in exact sequences and computed directly on projective modules.

## Implementation notes

Write `C` for the subgroup generated by the prime-to-`ℓ` part of `z`, a normal subgroup of order
prime to `ℓ`. Some power `z ^ ℓ ^ a` lies in `C`, and as `M` is killed by `ℓ`, the identity
`z ^ ℓ ^ a - 1 = (z - 1) ^ ℓ ^ a` on `M` shows that `z ^ ℓ ^ a` fixes no nonzero vector. For a
finite representation `V` of `Δ ⧸ C` over `ZMod ℓ`, the diagonal tensor product `V ⊗ M`
(`Representation.diagonalTensor`) is then again a module of the class, and `V ↦ φ (V ⊗ M)` is
additive in short exact sequences, so it descends to the Grothendieck group `G₀(ZMod ℓ[Δ ⧸ C])`
with values in the torsion-free group of positive rationals. By the modular Artin induction theorem
(`TauCeti.exists_linearCombination_indK0_resK0_eq_natCard_nsmul`), `|Δ ⧸ C|` times the class of
the trivial representation is an integral combination of permutation classes `[ZMod ℓ[(Δ ⧸ C) ⧸ D]]`
for subgroups `D` of order prime to `ℓ`. The modules `ZMod ℓ[(Δ ⧸ C) ⧸ D] ⊗ M` satisfy Higman's
criterion, because the stabilizers in `Δ` of the cosets have order `|C| |D|`, prime to `ℓ`; so
`φ (M) ^ |Δ ⧸ C| = 1`, and `φ M = 1`.

## Main results

* `TauCeti.eq_one_of_multiplicative_of_eq_one_of_higman`: `φ = 1` on the class.

## References

* J.-P. Serre, *Linear Representations of Finite Groups*, Springer GTM 42 (1977), Theorem 35
  (finiteness of the cokernel of the Cartan homomorphism).
* J. S. Milne, *Arithmetic Duality Theorems*, second edition, Chapter I, Lemma 2.10 and the proof of
  Theorem 2.8, for the same use of modular Artin induction on Euler characteristics.
* D. G. Higman, *Modules with a group of operators*, Duke Math. J. 21 (1954), 369–376, for the
  criterion.
* The formal proof of the generalized Riemann hypothesis at <https://github.com/lsernau/grh-lean>,
  file `grh/src/Lib/General/Algebra/CartanMap.lean`, for this form of the statement, there for
  discrete modules over a compact group and proved by a dévissage through permutation modules.
-/

public section

open CategoryTheory TensorProduct
open scoped MonoidAlgebra

namespace TauCeti

universe u v w

section Core

variable {R : Type u} [Ring R] {Δ : Type} [Group Δ] {ℓ : ℕ} [Fact ℓ.Prime]

section Higman

open Finset

variable (N : ModuleCat.{v} R[Δ]) [Module (ZMod ℓ) N] [SMulCommClass R[Δ] (ZMod ℓ) N]
  [Fintype Δ] (C : Subgroup Δ) [C.Normal] (D : Subgroup (Δ ⧸ C))

/-- The permutation representation of `Δ` on the cosets of `D` in the quotient `Δ ⧸ C`. -/
private noncomputable abbrev cosetRep : Representation (ZMod ℓ) Δ (ZMod ℓ)[(Δ ⧸ C) ⧸ D] :=
  (Representation.ofMulAction (ZMod ℓ) (Δ ⧸ C) ((Δ ⧸ C) ⧸ D)).comp (QuotientGroup.mk' C)

variable {C} in
/-- **Higman's criterion for permutation modules.** If `C` and `D` have order prime to `ℓ`, the
diagonal tensor product of `N` with the permutation module of `(Δ ⧸ C) ⧸ D` satisfies Higman's
criterion: some additive `τ` has `∑ g, g τ g⁻¹ = 1`. -/
private theorem exists_sum_smul_inv_smul_eq_diagonalTensor_cosetRep (hC : ¬ ℓ ∣ Nat.card C)
    (hD : ¬ ℓ ∣ Nat.card D) :
    ∃ τ : (cosetRep (ℓ := ℓ) C D).diagonalTensor N →+ (cosetRep (ℓ := ℓ) C D).diagonalTensor N,
      ∀ x, ∑ g : Δ, MonoidAlgebra.of R Δ g • τ (MonoidAlgebra.of R Δ g⁻¹ • x) = x := by
  classical
  set x₀ : (Δ ⧸ C) ⧸ D := QuotientGroup.mk 1
  set c : ZMod ℓ := ((Nat.card C * Nat.card D : ℕ) : ZMod ℓ)
  have hc : c ≠ 0 := by
    rw [Ne, ZMod.natCast_eq_zero_iff, (Fact.out : ℓ.Prime).dvd_mul]
    tauto
  let proj : (ZMod ℓ)[(Δ ⧸ C) ⧸ D] →ₗ[ZMod ℓ] (ZMod ℓ)[(Δ ⧸ C) ⧸ D] :=
    MonoidAlgebra.lsingle x₀ ∘ₗ Finsupp.lapply x₀ ∘ₗ
      (MonoidAlgebra.coeffLinearEquiv (ZMod ℓ)).toLinearMap
  have hproj (y : (Δ ⧸ C) ⧸ D) (r : ZMod ℓ) :
      proj (MonoidAlgebra.single y r) = if y = x₀ then MonoidAlgebra.single y r else 0 := by
    split_ifs with h
    · simp [proj, h]
    · simp [proj, h]
  set A := (cosetRep (ℓ := ℓ) C D).diagonalTensorAction (R := R) N
  have hterm (g : Δ) (y : (Δ ⧸ C) ⧸ D) (r : ZMod ℓ) (n : N) :
      A (MonoidAlgebra.of R Δ g) ((c⁻¹ • proj.rTensor N)
        (A (MonoidAlgebra.of R Δ g⁻¹) (MonoidAlgebra.single y r ⊗ₜ n))) =
        if (QuotientGroup.mk' C g)⁻¹ • y = x₀ then c⁻¹ • (MonoidAlgebra.single y r ⊗ₜ n)
        else 0 := by
    simp only [A, MonoidAlgebra.of_apply, Representation.diagonalTensorAction_single_tmul,
      MonoidHom.comp_apply, Representation.ofMulAction_single, LinearMap.smul_apply,
      LinearMap.rTensor_tmul, map_inv, hproj]
    split_ifs with h
    · simp [MonoidAlgebra.single_mul_single, smul_smul, ← MonoidAlgebra.one_def]
    · simp
  have hF : ∑ g : Δ, A (MonoidAlgebra.of R Δ g) * (c⁻¹ • proj.rTensor N) *
      A (MonoidAlgebra.of R Δ g⁻¹) = 1 := by
    refine TensorProduct.ext' fun v n ↦ ?_
    induction v using MonoidAlgebra.induction_linear with
    | zero => simp
    | add v v' hv hv' => simp only [TensorProduct.add_tmul, map_add, hv, hv']
    | single y r =>
      rw [LinearMap.sum_apply]
      have hcard : #{g : Δ | (QuotientGroup.mk' C g)⁻¹ • y = x₀} = Nat.card C * Nat.card D := by
        rw [← QuotientGroup.natCard_inv_smul_eq_mk_one C D y, Nat.card_eq_fintype_card,
          Fintype.card_subtype]
      simp only [mul_apply_eq_comp, hterm, Finset.sum_ite, Finset.sum_const_zero, add_zero,
        Finset.sum_const, hcard, ← Nat.cast_smul_eq_nsmul (ZMod ℓ), smul_smul]
      rw [mul_inv_cancel₀ hc, one_smul, one_apply_eq_self]
  refine ⟨AddMonoidHom.mk' (fun x ↦ (c⁻¹ • proj.rTensor N) x) (map_add _), fun x ↦ ?_⟩
  -- The identity `hF` of endomorphisms of `W ⊗ N`, evaluated at `x`.
  exact (LinearMap.sum_apply _ _ x).symm.trans (LinearMap.congr_fun hF x)

end Higman

section Main

open Finset

variable [Fintype Δ] {z : Δ} {φ : ModuleCat.{v} R[Δ] → ℚ≥0}
  (h_mul : ∀ S : ShortComplex (ModuleCat.{v} R[Δ]), S.ShortExact → Finite S.X₂ →
    (∀ m : S.X₂, ℓ • m = 0) → (∀ m : S.X₂, MonoidAlgebra.of R Δ z • m = m → m = 0) →
    φ S.X₂ = φ S.X₁ * φ S.X₃)
  (h_higman : ∀ P : ModuleCat.{v} R[Δ], Finite P → (∀ m : P, ℓ • m = 0) →
    (∀ m : P, MonoidAlgebra.of R Δ z • m = m → m = 0) →
    (∃ τ : P →+ P, ∀ x : P,
      ∑ g : Δ, MonoidAlgebra.of R Δ g • τ (MonoidAlgebra.of R Δ g⁻¹ • x) = x) →
    φ P = 1)

omit [Fact ℓ.Prime] in
include h_mul h_higman in
/-- `φ` takes the same value on linearly equivalent modules. -/
private theorem phi_eq_of_linearEquiv {X Y : ModuleCat.{v} R[Δ]} (e : X ≃ₗ[R[Δ]] Y) [Finite Y]
    (hY : ∀ y : Y, ℓ • y = 0) (hzY : ∀ y : Y, MonoidAlgebra.of R Δ z • y = y → y = 0) :
    φ Y = φ X := by
  have h0 : φ (ModuleCat.of R[Δ] PUnit.{v + 1}) = 1 :=
    h_higman _ inferInstance (fun _ ↦ Subsingleton.elim _ _) (fun _ _ ↦ Subsingleton.elim _ _)
      ⟨0, fun _ ↦ Subsingleton.elim _ _⟩
  have hS : (ShortComplex.mk (ModuleCat.ofHom e.toLinearMap)
      (0 : Y ⟶ ModuleCat.of R[Δ] PUnit.{v + 1}) (by simp)).ShortExact := by
    refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
    · rw [ShortComplex.ShortExact.moduleCat_exact_iff_function_exact]
      exact fun y ↦ ⟨fun _ ↦ ⟨e.symm y, e.apply_symm_apply y⟩, fun _ ↦ Subsingleton.elim _ _⟩
    · exact (ModuleCat.mono_iff_injective _).2 e.injective
    · exact (ModuleCat.epi_iff_surjective _).2 fun _ ↦ ⟨0, Subsingleton.elim _ _⟩
  rw [h_mul _ hS ‹_› hY hzY, h0, mul_one]

include h_mul h_higman in
/-- `φ` does not vanish on the modules of the class: such a module `N` is a quotient of the
module `ZMod ℓ[Δ ⧸ C] ⊗ N`, which satisfies Higman's criterion, by the augmentation. -/
private theorem phi_ne_zero {C : Subgroup Δ} [C.Normal] (hC : ¬ ℓ ∣ Nat.card C) {a : ℕ}
    (hw : z ^ ℓ ^ a ∈ C) (N : ModuleCat.{v} R[Δ]) [Module (ZMod ℓ) N]
    [SMulCommClass R[Δ] (ZMod ℓ) N] [Finite N]
    (hzN : ∀ n : N, MonoidAlgebra.of R Δ z • n = n → n = 0) : φ N ≠ 0 := by
  set X := (Δ ⧸ C) ⧸ (⊥ : Subgroup (Δ ⧸ C))
  -- The augmentation, which is invariant under the permutation action.
  let aug : (ZMod ℓ)[X] →ₗ[ZMod ℓ] ZMod ℓ := (MonoidAlgebra.basis X (ZMod ℓ)).sumCoords
  have heq (g : Δ) : aug ∘ₗ cosetRep (ℓ := ℓ) C ⊥ g =
      Representation.trivial (ZMod ℓ) Δ (ZMod ℓ) g ∘ₗ aug :=
    LinearMap.ext fun v ↦ by
      simp only [aug, LinearMap.comp_apply, MonoidHom.comp_apply, Representation.trivial_apply]
      exact sumCoords_basis_ofMulAction (ZMod ℓ) (Δ ⧸ C) X (QuotientGroup.mk' C g) v
  let e : (cosetRep (ℓ := ℓ) C ⊥).diagonalTensor N →ₗ[R[Δ]] N :=
    (Representation.diagonalTensorTrivialEquiv N fun _ ↦ rfl).toLinearMap ∘ₗ
      (Representation.diagonalTensorMap N aug heq).hom
  have he : Function.Surjective e := fun n ↦ by
    obtain ⟨x, hx⟩ : ∃ x : (cosetRep (ℓ := ℓ) C ⊥).diagonalTensor N, aug.rTensor N x = _ :=
      LinearMap.rTensor_surjective N (MonoidAlgebra.basis X (ZMod ℓ)).sumCoords_surjective
        ((Representation.diagonalTensorTrivialEquiv N
          (τ := Representation.trivial (ZMod ℓ) Δ (ZMod ℓ)) fun _ ↦ rfl).symm n)
    have hx' : (Representation.diagonalTensorMap N aug heq).hom x = _ :=
      (Representation.diagonalTensorMap_hom_apply ..).trans hx
    exact ⟨x, by rw [LinearMap.comp_apply, hx', LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply]⟩
  have hS : (ShortComplex.mk (ModuleCat.ofHom (LinearMap.ker e).subtype) (ModuleCat.ofHom e)
      (by ext x; exact x.property)).ShortExact := by
    refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
    · rw [ShortComplex.ShortExact.moduleCat_exact_iff_function_exact]
      exact LinearMap.exact_subtype_ker_map e
    · exact (ModuleCat.mono_iff_injective _).2 Subtype.val_injective
    · exact (ModuleCat.epi_iff_surjective _).2 he
  have : Finite (ZMod ℓ)[X] := Module.finite_of_finite (ZMod ℓ)
  have hP : Finite ((cosetRep (ℓ := ℓ) C ⊥).diagonalTensor N) := inferInstance
  have hσ : cosetRep (ℓ := ℓ) C ⊥ (z ^ ℓ ^ a) = 1 := by
    simp [cosetRep, (QuotientGroup.eq_one_iff _).2 hw]
  have h1 := h_higman _ hP (ZModModule.char_nsmul_eq_zero ℓ)
    (Representation.eq_zero_of_smul_eq_self_diagonalTensor _ N hzN hσ)
    (exists_sum_smul_inv_smul_eq_diagonalTensor_cosetRep N ⊥ hC
      (by simpa using (Fact.out : ℓ.Prime).ne_one))
  have h2 := h_mul _ hS hP (ZModModule.char_nsmul_eq_zero ℓ)
    (Representation.eq_zero_of_smul_eq_self_diagonalTensor _ N hzN hσ)
  intro h
  simp only [h, mul_zero] at h2
  exact one_ne_zero (h1.symm.trans h2)

variable (C : Subgroup Δ) [C.Normal] (N : ModuleCat.{v} R[Δ]) [Module (ZMod ℓ) N]
  [SMulCommClass R[Δ] (ZMod ℓ) N]

/-- The diagonal tensor product of `N` with a finite representation of `Δ ⧸ C`, inflated to `Δ`. -/
private noncomputable abbrev inflTensor (V : FDRep (ZMod ℓ) (Δ ⧸ C)) : ModuleCat.{v} R[Δ] :=
  Representation.diagonalTensor
    (((forget₂ (FDRep (ZMod ℓ) (Δ ⧸ C)) (Rep (ZMod ℓ) (Δ ⧸ C))).obj V).ρ.comp
      (QuotientGroup.mk' C)) N

omit [Fintype Δ] in
/-- The inflated tensor product of a finite module with a finite representation is finite. -/
private theorem finite_inflTensor [Finite N] (V : FDRep (ZMod ℓ) (Δ ⧸ C)) :
    Finite (inflTensor C N V) :=
  have : Finite ((forget₂ (FDRep (ZMod ℓ) (Δ ⧸ C)) (Rep (ZMod ℓ) (Δ ⧸ C))).obj V).V :=
    Module.finite_of_finite (ZMod ℓ) (M := V)
  inferInstance

omit [Fintype Δ] in
/-- `z` fixes no nonzero vector of an inflated tensor product. -/
private theorem eq_zero_of_of_smul_inflTensor_eq {a : ℕ} (hw : z ^ ℓ ^ a ∈ C)
    (hzN : ∀ n : N, MonoidAlgebra.of R Δ z • n = n → n = 0) (V : FDRep (ZMod ℓ) (Δ ⧸ C))
    (x : inflTensor C N V) (hx : MonoidAlgebra.of R Δ z • x = x) : x = 0 :=
  Representation.eq_zero_of_smul_eq_self_diagonalTensor _ N hzN (a := a)
    (by rw [MonoidHom.comp_apply, QuotientGroup.mk'_apply, (QuotientGroup.eq_one_iff _).2 hw,
      map_one]) x hx

omit [Fintype Δ] [SMulCommClass R[Δ] (ZMod ℓ) N] [Module (ZMod ℓ) N] in
/-- The equivariant linear map underlying a morphism of finite representations, inflated. -/
private theorem inflTensor_intertwining {V V' : FDRep (ZMod ℓ) (Δ ⧸ C)} (f : V ⟶ V') (g : Δ) :
    ((forget₂ (FDRep (ZMod ℓ) (Δ ⧸ C)) (Rep (ZMod ℓ) (Δ ⧸ C))).map f).hom.toLinearMap ∘ₗ
        ((forget₂ (FDRep (ZMod ℓ) (Δ ⧸ C)) (Rep (ZMod ℓ) (Δ ⧸ C))).obj V).ρ.comp
          (QuotientGroup.mk' C) g =
      ((forget₂ (FDRep (ZMod ℓ) (Δ ⧸ C)) (Rep (ZMod ℓ) (Δ ⧸ C))).obj V').ρ.comp
          (QuotientGroup.mk' C) g ∘ₗ
        ((forget₂ (FDRep (ZMod ℓ) (Δ ⧸ C)) (Rep (ZMod ℓ) (Δ ⧸ C))).map f).hom.toLinearMap :=
  ((forget₂ (FDRep (ZMod ℓ) (Δ ⧸ C)) (Rep (ZMod ℓ) (Δ ⧸ C))).map f).hom.isIntertwining' _

omit [Fintype Δ] in
include h_mul in
/-- `φ` is multiplicative on the inflated tensor products of a short exact sequence of finite
representations of `Δ ⧸ C`. -/
private theorem phi_inflTensor_mul {a : ℕ} (hw : z ^ ℓ ^ a ∈ C) [Finite N]
    (hzN : ∀ n : N, MonoidAlgebra.of R Δ z • n = n → n = 0)
    {S : ShortComplex (FDRep (ZMod ℓ) (Δ ⧸ C))} (hS : S.ShortExact) :
    φ (inflTensor C N S.X₂) = φ (inflTensor C N S.X₁) * φ (inflTensor C N S.X₃) := by
  have h := hS.map_of_exact (forget₂ (FDRep (ZMod ℓ) (Δ ⧸ C)) (Rep (ZMod ℓ) (Δ ⧸ C)) ⋙
    forget₂ (Rep (ZMod ℓ) (Δ ⧸ C)) (ModuleCat (ZMod ℓ)))
  have hS' := Representation.shortExact_diagonalTensorMap N (inflTensor_intertwining C S.f)
    (inflTensor_intertwining C S.g) h.moduleCat_injective_f
    ((ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).1 h.exact)
    h.moduleCat_surjective_g
  exact h_mul _ hS' (finite_inflTensor C N _) (ZModModule.char_nsmul_eq_zero ℓ)
    (eq_zero_of_of_smul_inflTensor_eq C N hw hzN _)

include h_mul h_higman in
/-- The core of `TauCeti.eq_one_of_multiplicative_of_eq_one_of_higman`, for a normal subgroup `C`
of order prime to `ℓ` containing a power `z ^ ℓ ^ a`. -/
private theorem phi_eq_one_of_quotient {a : ℕ} (hC : ¬ ℓ ∣ Nat.card C) (hw : z ^ ℓ ^ a ∈ C)
    [Finite N] (hzM : ∀ m : N, MonoidAlgebra.of R Δ z • m = m → m = 0) : φ N = 1 := by
  -- The invariant `V ↦ φ (V ⊗ N)` of finite representations of `Δ ⧸ C`, as a homomorphism on
  -- the Grothendieck group `G₀(ZMod ℓ[Δ ⧸ C])` with torsion-free values.
  have hne (V : FDRep (ZMod ℓ) (Δ ⧸ C)) : (φ (inflTensor C N V) : ℚ) ≠ 0 := by
    have : Finite (inflTensor C N V) := finite_inflTensor C N V
    exact_mod_cast phi_ne_zero h_mul h_higman hC hw (inflTensor C N V)
      (eq_zero_of_of_smul_inflTensor_eq C N hw hzM V)
  let f (V : FDRep (ZMod ℓ) (Δ ⧸ C)) : Additive (Units.posSubgroup ℚ) :=
    .ofMul ⟨Units.mk0 _ (hne V), by simpa using (hne V).symm.lt_of_le (by positivity)⟩
  have hf : ∀ ⦃S : ShortComplex (FDRep (ZMod ℓ) (Δ ⧸ C))⦄, S.ShortExact →
      f S.X₂ = f S.X₁ + f S.X₃ := fun S hS ↦ by
    refine Additive.ofMul.symm.injective (Subtype.ext (Units.ext ?_))
    simp [f, phi_inflTensor_mul h_mul C N hw hzM hS]
  have hf0 (V : FDRep (ZMod ℓ) (Δ ⧸ C)) (hV : φ (inflTensor C N V) = 1) : f V = 0 := by
    refine Additive.ofMul.symm.injective (Subtype.ext (Units.ext ?_))
    simp [f, hV]
  -- By modular Artin induction, `|Δ ⧸ C| • 1` is a combination of permutation classes of cosets
  -- of subgroups of order prime to `ℓ`; on these the invariant vanishes by Higman's criterion.
  let Φ := liftFDRepK0 f hf
  obtain ⟨c, hc⟩ :=
    exists_linearCombination_indK0_resK0_eq_natCard_nsmul (k := ZMod ℓ) (G := Δ ⧸ C) ℓ
  have hperm (D : {D : Subgroup (Δ ⧸ C) // IsCyclic D ∧ ¬ ℓ ∣ Nat.card D}) :
      Φ (indK0 (ZMod ℓ) D.val (resK0 (ZMod ℓ) D.val.subtype 1)) = 0 := by
    rw [resK0_one, indK0_one, permK0_def]
    refine (liftFDRepK0_of f hf (FDRep.of (Representation.ofMulAction (ZMod ℓ) (Δ ⧸ C)
      ((Δ ⧸ C) ⧸ D.val)))).trans (hf0 _ ?_)
    exact h_higman _ (finite_inflTensor C N _) (ZModModule.char_nsmul_eq_zero ℓ)
      (eq_zero_of_of_smul_inflTensor_eq C N hw hzM _)
      (exists_sum_smul_inv_smul_eq_diagonalTensor_cosetRep N D.val hC D.property.2)
  have h1 : Nat.card (Δ ⧸ C) • Φ 1 = 0 := by
    rw [← map_nsmul, ← hc 1, Finsupp.linearCombination_apply, map_finsuppSum]
    exact Finset.sum_eq_zero fun D _ ↦ by simp only [map_zsmul, hperm, zsmul_zero]
  have h2 : Φ 1 = 0 := nsmul_right_injective Nat.card_pos.ne' (h1.trans (nsmul_zero _).symm)
  rw [exactK0_one_eq_of_trivial] at h2
  have h3 := congrArg (fun x ↦ (((Additive.toMul x : Units.posSubgroup ℚ) : ℚˣ) : ℚ))
    ((liftFDRepK0_of f hf (FDRep.of (Representation.trivial (ZMod ℓ) (Δ ⧸ C) (ZMod ℓ)))).symm.trans
      h2)
  simp only [f, toMul_ofMul, Units.val_mk0, toMul_zero, OneMemClass.coe_one, Units.val_one] at h3
  exact (phi_eq_of_linearEquiv h_mul h_higman
    (Representation.diagonalTensorTrivialEquiv N (k := ZMod ℓ)
      (τ := (Representation.trivial (ZMod ℓ) Δ (ZMod ℓ))) fun _ ↦ rfl)
    (ZModModule.char_nsmul_eq_zero ℓ) hzM).trans (by exact_mod_cast h3)

end Main

end Core

/-- **Multiplicative functions of finite modules that are trivial on projective modules.**

Let `Δ` be a finite group, `z` a central element of `Δ`, `ℓ` a prime and `R` a ring.
Consider the finite `R[Δ]`-modules killed by `ℓ` on which `z` fixes no nonzero vector. Let `φ`
assign to every `R[Δ]`-module a nonnegative rational number, multiplicative in the short exact
sequences `0 → M' → M → M'' → 0` whose middle term `M` is such a module, and equal to `1` on
those such modules `P` that satisfy Higman's criterion: some additive `τ : P → P` has
`∑ g, g ∘ τ ∘ g⁻¹ = 1`. Then `φ M = 1` for every such module `M`.

Over `ZMod ℓ` Higman's criterion characterizes the projective `ZMod ℓ[Δ]`-modules, so this is the
statement that such an invariant is determined by its values on projective modules. -/
theorem eq_one_of_multiplicative_of_eq_one_of_higman {R : Type u} [Ring R] {Δ : Type}
    [Group Δ] [Fintype Δ] {z : Δ} (hz : ∀ g : Δ, z * g = g * z) {ℓ : ℕ} (hℓ : ℓ.Prime)
    (φ : ModuleCat.{v} R[Δ] → ℚ≥0)
    (h_mul : ∀ S : ShortComplex (ModuleCat.{v} R[Δ]), S.ShortExact → Finite S.X₂ →
      (∀ m : S.X₂, ℓ • m = 0) → (∀ m : S.X₂, MonoidAlgebra.of R Δ z • m = m → m = 0) →
      φ S.X₂ = φ S.X₁ * φ S.X₃)
    (h_higman : ∀ P : ModuleCat.{v} R[Δ], Finite P → (∀ m : P, ℓ • m = 0) →
      (∀ m : P, MonoidAlgebra.of R Δ z • m = m → m = 0) →
      (∃ τ : P →+ P, ∀ x : P,
        ∑ g : Δ, MonoidAlgebra.of R Δ g • τ (MonoidAlgebra.of R Δ g⁻¹ • x) = x) → φ P = 1)
    (M : ModuleCat.{v} R[Δ]) [Finite M] (hℓM : ∀ m : M, ℓ • m = 0)
    (hzM : ∀ m : M, MonoidAlgebra.of R Δ z • m = m → m = 0) : φ M = 1 := by
  have := Fact.mk hℓ
  let : Module (ZMod ℓ) M := AddCommGroup.zmodModule hℓM
  have : SMulCommClass R[Δ] (ZMod ℓ) M :=
    ⟨fun a c m ↦ ZMod.map_smul (DistribSMul.toAddMonoidHom M a) c m⟩
  -- Pass to the quotient `Δ ⧸ C` by the prime-to-`ℓ` part `C` of the cyclic group of `z`.
  let C := Subgroup.zpowers (z ^ ℓ ^ (orderOf z).factorization ℓ)
  have : C.Normal := ⟨fun n hn g ↦ by
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hn
    rw [(((Commute.pow_left (hz g) _).zpow_left k).symm).mul_inv_cancel]
    exact Subgroup.zpow_mem_zpowers _ k⟩
  have hC : ¬ ℓ ∣ Nat.card C := by
    rw [Nat.card_zpowers, orderOf_pow_of_dvd (pow_ne_zero _ hℓ.ne_zero) (Nat.ordProj_dvd _ _)]
    exact Nat.not_dvd_ordCompl hℓ (orderOf_pos z).ne'
  have hw : z ^ ℓ ^ (orderOf z).factorization ℓ ∈ C := Subgroup.mem_zpowers _
  exact phi_eq_one_of_quotient h_mul h_higman C M hC hw hzM

end TauCeti
