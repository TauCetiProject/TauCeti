module

public import Mathlib.LinearAlgebra.Transvection.Basic
public import TauCeti.LinearAlgebra.SymmetricAlgebra.Functoriality
public import TauCeti.LinearAlgebra.SymmetricAlgebra.Semilinear
public import TauCeti.RepresentationTheory.Augmentation.Projection
public import TauCeti.RepresentationTheory.Intertwining
public import TauCeti.RepresentationTheory.Symmetric.Standard
public import TauCeti.RepresentationTheory.SymmetricAlgebra.Permutation

/-!
# Invariants of the reflection representation of the symmetric group

Let `σ` be a finite set with `n + 1` elements, and let `K[σ]` be the permutation representation of
the symmetric group `S_σ`. Its reflection representation is the standard representation
`TauCeti.standardRepresentation` on the trace-zero hyperplane `V₀ ⊆ K[σ]` of vectors whose
coefficients sum to zero. This file computes the invariant polynomial functions on `V₀`, that
is the invariants of `Sym(V₀*)` under the contragredient action.

Polynomial functions on `V₀` are restrictions of polynomial functions on `K[σ]`: restriction of
linear forms `K[σ]* → V₀*` induces a map of symmetric algebras whose kernel, over every
commutative ring, is the ideal generated by the invariant linear form `e₁ = ∑ᵢ xᵢ`, the
coefficient sum (`TauCeti.ker_map_dualRestrict_augmentation`). When `n + 1` is invertible in `K`,
`K[σ]` is the direct sum of `V₀` and the invariant line spanned by `∑ᵢ i`, so this restriction has
an equivariant section, and every invariant on `V₀` is the restriction of an invariant on `K[σ]`
(`TauCeti.map_symmetricAlgebraInvariants_dualRestrict_augmentation`). The invariants on `K[σ]`
form a polynomial algebra on the elementary symmetric invariants `e₁, …, e_(n+1)`
(`Representation.esymmSymmetricAlgebraInvariantsEquiv`); restriction kills `e₁`, and the
restrictions of `e₂, …, e_(n+1)` are algebraically independent over any commutative ring. So
whenever `n + 1` is invertible in `K`, the invariant algebra `Sym(V₀*)^(S_σ)` is a polynomial
algebra on `n` homogeneous invariants of degrees `2, …, n + 1`
(`TauCeti.esymmStandardInvariantsEquiv`).

This is the exact difference from the full permutation representation, whose basic invariants
have degrees `1, 2, …, n + 1`: the degree-one invariant `e₁` spans the dual of the trivial
summand of `K[σ] = K ⊕ V₀` and is lost on restriction to `V₀`, while the other basic invariants
restrict to basic invariants. For `n = 0` the trace-zero hyperplane is zero and the invariant
algebra is `K`.

The hypothesis that `n + 1` is invertible cannot be dropped from the description of the
invariant algebra, which uses it only to lift invariants from `V₀` to `K[σ]`: if `K` has
characteristic `2` and `σ` has two elements, then `V₀` is the invariant line spanned by `x - y`,
and its invariant polynomial functions form a polynomial algebra on a generator of degree one.

## Main results

* `TauCeti.ker_map_dualRestrict_augmentation`: polynomial functions on `V₀` are polynomial
  functions on `K[σ]` modulo `e₁`.
* `TauCeti.map_symmetricAlgebraInvariants_dualRestrict_augmentation`: the invariants on `V₀` are
  the restrictions of the invariants on `K[σ]`.
* `TauCeti.esymmStandardInvariantsEquiv`: **the invariant algebra of the reflection
  representation of `S_σ` is a polynomial algebra** on the restrictions of `e₂, …, e_(n+1)`, with
  `TauCeti.coe_esymmStandardInvariantsEquiv_X` and
  `TauCeti.coe_esymmStandardInvariantsEquiv_X_eq_sum` computing the generators and
  `TauCeti.esymmStandardInvariantsEquiv_X_mem_homogeneousSubmodule` giving their degrees
  `2, …, n + 1`.

## References

* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press (1990),
  Chapter 3.
-/

public section

open MvPolynomial MonoidAlgebra Representation

namespace TauCeti

variable (K : Type*) [CommRing K] (σ : Type*)

/-- Restricting linear forms on `K[σ]` to the trace-zero hyperplane intertwines the
contragredient of the permutation representation with that of the standard representation. -/
private theorem isIntertwiningMap_dualRestrict_augmentation :
    IsIntertwiningMap (ofMulAction K (Equiv.Perm σ) σ).dual (standardRepresentation K σ).dual
      (augmentationSubrepresentation K (Equiv.Perm σ) σ).toSubmodule.dualRestrict :=
  toRepresentation_augmentationSubrepresentation K σ ▸
    (augmentationSubrepresentation K (Equiv.Perm σ) σ).isIntertwiningMap_dualRestrict

variable {σ} in
/-- Restriction to the trace-zero hyperplane, as a map of invariant algebras. -/
private noncomputable def restrictInvariants :
    (ofMulAction K (Equiv.Perm σ) σ).dual.symmetricAlgebraInvariants →ₐ[K]
      (standardRepresentation K σ).dual.symmetricAlgebraInvariants :=
  ((SymmetricAlgebra.map K
      (augmentationSubrepresentation K (Equiv.Perm σ) σ).toSubmodule.dualRestrict).comp
    (Subalgebra.val _)).codRestrict _ fun p ↦
      map_mem_symmetricAlgebraInvariants (isIntertwiningMap_dualRestrict_augmentation K σ) p.2

variable {σ} in
private theorem coe_restrictInvariants
    (p : (ofMulAction K (Equiv.Perm σ) σ).dual.symmetricAlgebraInvariants) :
    (restrictInvariants K p : SymmetricAlgebra K _) =
      SymmetricAlgebra.map K
        (augmentationSubrepresentation K (Equiv.Perm σ) σ).toSubmodule.dualRestrict p :=
  (rfl)

/-- **Polynomial functions on the trace-zero hyperplane** `V₀ ⊆ K[σ]` are the polynomial
functions on `K[σ]` modulo the coefficient sum `e₁ = ∑ᵢ xᵢ`: the kernel of restriction
`Sym(K[σ]*) → Sym(V₀*)` is the ideal generated by `e₁`. This holds over every commutative ring. -/
theorem ker_map_dualRestrict_augmentation :
    RingHom.ker (SymmetricAlgebra.map K
        (augmentationSubrepresentation K (Equiv.Perm σ) σ).toSubmodule.dualRestrict) =
      Ideal.span {SymmetricAlgebra.ι K _ (MonoidAlgebra.basis σ K).sumCoords} := by
  rw [SymmetricAlgebra.ker_map_of_surjective _
    (dualRestrict_augmentationSubrepresentation_surjective K)]
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · rintro _ ⟨φ, hφ, rfl⟩
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1
      (dualRestrict_augmentationSubrepresentation_eq_zero_iff.1 hφ)
    rw [map_smul, SetLike.mem_coe, Algebra.smul_def]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  · rintro _ rfl
    exact Ideal.subset_span ⟨_, dualRestrict_augmentationSubrepresentation_sumCoords, rfl⟩

variable [Fintype σ]

/-- **The invariant polynomial functions on the trace-zero hyperplane** `V₀ ⊆ K[σ]` are the
restrictions of the invariant polynomial functions on `K[σ]`, when the cardinality of `σ` is
invertible, so that `V₀` is an invariant direct summand of `K[σ]`. -/
theorem map_symmetricAlgebraInvariants_dualRestrict_augmentation
    (h : IsUnit (Fintype.card σ : K)) :
    (ofMulAction K (Equiv.Perm σ) σ).dual.symmetricAlgebraInvariants.map
        (SymmetricAlgebra.map K
          (augmentationSubrepresentation K (Equiv.Perm σ) σ).toSubmodule.dualRestrict) =
      (standardRepresentation K σ).dual.symmetricAlgebraInvariants :=
  map_symmetricAlgebraInvariants_of_leftInverse (isIntertwiningMap_dualRestrict_augmentation K σ)
    (toRepresentation_augmentationSubrepresentation K σ ▸
      isIntertwiningMap_augmentationProjectionOfIsUnit K (Equiv.Perm σ) σ h).dualMap
    fun ψ ↦ LinearMap.ext fun v ↦ by
      rw [Submodule.dualRestrict_apply, LinearMap.dualMap_apply,
        augmentationProjectionOfIsUnit_coe]

variable {σ} [DecidableEq σ] {n : ℕ}

/-- The map sending `Xᵢ` to the restriction of the elementary symmetric invariant of degree
`i + 2` to the trace-zero hyperplane. -/
private noncomputable def esymmStandardAlgHom (hn : Fintype.card σ = n + 1) :
    MvPolynomial (Fin n) K →ₐ[K] (standardRepresentation K σ).dual.symmetricAlgebraInvariants :=
  aeval fun i ↦ restrictInvariants K (esymmSymmetricAlgebraInvariantsEquiv K σ hn (X i.succ))

private theorem killCompl_succ_X_zero :
    killCompl (Fin.succ_injective n) (X 0 : MvPolynomial (Fin (n + 1)) K) = 0 := by
  simp [killCompl]

/-- Restricting an invariant of `K[σ]` to the trace-zero hyperplane is the same as killing `e₁`
and mapping the remaining elementary symmetric invariants to their restrictions. -/
private theorem esymmStandardAlgHom_comp_killCompl (hn : Fintype.card σ = n + 1) :
    (esymmStandardAlgHom K hn).comp (killCompl (Fin.succ_injective n)) =
      (restrictInvariants K).comp (esymmSymmetricAlgebraInvariantsEquiv K σ hn).toAlgHom := by
  refine algHom_ext fun i ↦ ?_
  induction i using Fin.cases with
  | zero =>
    refine Subtype.ext ?_
    rw [AlgHom.comp_apply, AlgHom.comp_apply, killCompl_succ_X_zero, map_zero,
      AlgEquiv.coe_toAlgHom, coe_restrictInvariants,
      coe_esymmSymmetricAlgebraInvariantsEquiv_X_zero, SymmetricAlgebra.map_apply_ι,
      dualRestrict_augmentationSubrepresentation_sumCoords, map_zero, ZeroMemClass.coe_zero]
  | succ i =>
    rw [AlgHom.comp_apply, ← rename_X Fin.succ, killCompl_rename_app]
    simp [esymmStandardAlgHom]

private theorem esymmStandardAlgHom_eq_comp_rename (hn : Fintype.card σ = n + 1) :
    esymmStandardAlgHom K hn = ((restrictInvariants K).comp
      (esymmSymmetricAlgebraInvariantsEquiv K σ hn).toAlgHom).comp (rename Fin.succ) := by
  rw [← esymmStandardAlgHom_comp_killCompl, AlgHom.comp_assoc, killCompl_comp_rename,
    AlgHom.comp_id]

private theorem surjective_esymmStandardAlgHom (h : IsUnit (Fintype.card σ : K))
    (hn : Fintype.card σ = n + 1) : Function.Surjective (esymmStandardAlgHom K hn) := by
  rintro ⟨q, hq⟩
  rw [← map_symmetricAlgebraInvariants_dualRestrict_augmentation K σ h] at hq
  obtain ⟨p, hp, rfl⟩ := hq
  obtain ⟨P, hP⟩ := (esymmSymmetricAlgebraInvariantsEquiv K σ hn).surjective ⟨p, hp⟩
  refine ⟨killCompl (Fin.succ_injective n) P, Subtype.ext ?_⟩
  rw [← AlgHom.comp_apply, esymmStandardAlgHom_comp_killCompl, AlgHom.comp_apply,
    AlgEquiv.coe_toAlgHom, hP, coe_restrictInvariants]
  rfl

private theorem injective_esymmStandardAlgHom (hn : Fintype.card σ = n + 1) :
    Function.Injective (esymmStandardAlgHom K hn) := by
  set ψ := esymmSymmetricAlgebraInvariantsEquiv K σ hn
  have he₁ : (ψ (X 0) : SymmetricAlgebra K _) =
      SymmetricAlgebra.ι K _ (MonoidAlgebra.basis σ K).sumCoords :=
    coe_esymmSymmetricAlgebraInvariantsEquiv_X_zero K σ hn
  -- `e₁` is a nonzerodivisor: the transvection `φ ↦ φ + φ(i) • (e₁ - xᵢ)` of the linear forms
  -- sends the coordinate `xᵢ` to `e₁`, so `e₁` is a member of a basis of linear forms.
  have hreg : IsLeftRegular (SymmetricAlgebra.ι K _ (MonoidAlgebra.basis σ K).sumCoords) := by
    obtain ⟨i⟩ : Nonempty σ := Fintype.card_pos_iff.1 (hn ▸ n.succ_pos)
    have hv : Module.Dual.eval K K[σ] (MonoidAlgebra.single i 1)
        ((MonoidAlgebra.basis σ K).sumCoords - (MonoidAlgebra.basis σ K).dualBasis i) = 0 := by
      simp
    have he : LinearEquiv.transvection hv ((MonoidAlgebra.basis σ K).dualBasis i) =
        (MonoidAlgebra.basis σ K).sumCoords := by
      rw [LinearEquiv.transvection.apply]
      simp
    have := (SymmetricAlgebra.isRegular_ι_basis
      ((MonoidAlgebra.basis σ K).dualBasis.map (LinearEquiv.transvection hv)) i).left
    rwa [Module.Basis.map_apply, he] at this
  refine (injective_iff_map_eq_zero _).2 fun P hP ↦ ?_
  -- The invariant `ψ (rename succ P)` restricts to zero, so it is a multiple `a * e₁`.
  rw [esymmStandardAlgHom_eq_comp_rename, AlgHom.comp_apply, AlgHom.comp_apply,
    AlgEquiv.coe_toAlgHom, Subtype.ext_iff, coe_restrictInvariants, ZeroMemClass.coe_zero,
    ← RingHom.mem_ker, ker_map_dualRestrict_augmentation K σ, Ideal.mem_span_singleton'] at hP
  obtain ⟨a, ha⟩ := hP
  -- The cofactor `a` is again invariant, since `e₁` is an invariant nonzerodivisor.
  have hainv : a ∈ (ofMulAction K (Equiv.Perm σ) σ).dual.symmetricAlgebraInvariants := by
    refine ((ofMulAction K (Equiv.Perm σ) σ).dual.mem_symmetricAlgebraInvariants a).2 fun g ↦ ?_
    have hg := ((ofMulAction K (Equiv.Perm σ) σ).dual.mem_symmetricAlgebraInvariants _).1
      (ψ (rename Fin.succ P)).2 g
    have he₁g := ((ofMulAction K (Equiv.Perm σ) σ).dual.mem_symmetricAlgebraInvariants _).1
      (ψ (X 0)).2 g
    rw [he₁, symmetricAlgebra_apply] at he₁g
    rw [← ha, symmetricAlgebra_apply, map_mul, he₁g, mul_comm, mul_comm a] at hg
    rw [symmetricAlgebra_apply]
    exact hreg hg
  -- Hence `rename succ P = Q * X₀`, and killing `X₀` gives `P = 0`.
  obtain ⟨Q, hQ⟩ := ψ.surjective ⟨a, hainv⟩
  have hPQ : rename Fin.succ P = Q * X 0 := by
    refine ψ.injective (Subtype.ext ?_)
    rw [map_mul, Subalgebra.coe_mul, hQ, he₁, ha]
  have := congrArg (killCompl (Fin.succ_injective n)) hPQ
  rwa [killCompl_rename_app, map_mul, killCompl_succ_X_zero, mul_zero] at this

/-- **The invariants of the reflection representation of `S_σ` form a polynomial algebra.** Let
`σ` have `n + 1` elements, with `n + 1` invertible in `K`. The invariant polynomial
functions on the trace-zero hyperplane `V₀ ⊆ K[σ]` form a polynomial algebra on `n` generators:
the variable `Xᵢ` is sent to the restriction to `V₀` of the elementary symmetric invariant
`e_(i + 2)` (`coe_esymmStandardInvariantsEquiv_X`), which is homogeneous of degree `i + 2`
(`esymmStandardInvariantsEquiv_X_mem_homogeneousSubmodule`). So the basic invariants have degrees
`2, …, n + 1`. -/
noncomputable def esymmStandardInvariantsEquiv (h : IsUnit (Fintype.card σ : K))
    (hn : Fintype.card σ = n + 1) :
    MvPolynomial (Fin n) K ≃ₐ[K] (standardRepresentation K σ).dual.symmetricAlgebraInvariants :=
  AlgEquiv.ofBijective (esymmStandardAlgHom K hn)
    ⟨injective_esymmStandardAlgHom K hn, surjective_esymmStandardAlgHom K h hn⟩

/-- The generator `Xᵢ` is sent to the restriction to the trace-zero hyperplane of the elementary
symmetric invariant of degree `i + 2`. -/
theorem coe_esymmStandardInvariantsEquiv_X (h : IsUnit (Fintype.card σ : K))
    (hn : Fintype.card σ = n + 1) (i : Fin n) :
    (esymmStandardInvariantsEquiv K h hn (X i) :
        SymmetricAlgebra K
          (Module.Dual K (augmentationSubrepresentation K (Equiv.Perm σ) σ).toSubmodule)) =
      SymmetricAlgebra.map K
        (augmentationSubrepresentation K (Equiv.Perm σ) σ).toSubmodule.dualRestrict
        (esymmSymmetricAlgebraInvariantsEquiv K σ hn (X i.succ)) := by
  simp [esymmStandardInvariantsEquiv, esymmStandardAlgHom, coe_restrictInvariants]

/-- The generator `Xᵢ` is sent to `∑ ∏_(j ∈ t) xⱼ|V₀`, the sum over the subsets `t` of `σ` with
`i + 2` elements of the products of the restrictions of their coordinates to the trace-zero
hyperplane `V₀`. -/
@[simp]
theorem coe_esymmStandardInvariantsEquiv_X_eq_sum (h : IsUnit (Fintype.card σ : K))
    (hn : Fintype.card σ = n + 1) (i : Fin n) :
    (esymmStandardInvariantsEquiv K h hn (X i) :
        SymmetricAlgebra K
          (Module.Dual K (augmentationSubrepresentation K (Equiv.Perm σ) σ).toSubmodule)) =
      ∑ t ∈ Finset.univ.powersetCard (i + 2), ∏ j ∈ t,
        SymmetricAlgebra.ι K _
          ((augmentationSubrepresentation K (Equiv.Perm σ) σ).toSubmodule.dualRestrict
            ((MonoidAlgebra.basis σ K).dualBasis j)) := by
  simp [coe_esymmStandardInvariantsEquiv_X, map_sum, map_prod]

/-- **The basic invariants of the reflection representation of `S_σ` have degrees `2, …, n + 1`**:
the generator `Xᵢ` is sent to a homogeneous invariant of degree `i + 2`. -/
theorem esymmStandardInvariantsEquiv_X_mem_homogeneousSubmodule
    (h : IsUnit (Fintype.card σ : K)) (hn : Fintype.card σ = n + 1) (i : Fin n) :
    (esymmStandardInvariantsEquiv K h hn (X i) :
        SymmetricAlgebra K
          (Module.Dual K (augmentationSubrepresentation K (Equiv.Perm σ) σ).toSubmodule)) ∈
      SymmetricAlgebra.homogeneousSubmodule K _ (i + 2) := by
  rw [coe_esymmStandardInvariantsEquiv_X]
  exact SymmetricAlgebra.map_mem_homogeneousSubmodule _
    (esymmSymmetricAlgebraInvariantsEquiv_X_mem_homogeneousSubmodule K σ hn i.succ)

end TauCeti
