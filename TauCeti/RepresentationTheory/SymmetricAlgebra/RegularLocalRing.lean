module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import TauCeti.RepresentationTheory.SymmetricAlgebra.KrullDimension
import TauCeti.RingTheory.GradedAlgebra.RegularLocalRing
import TauCeti.RingTheory.GradedAlgebra.Subalgebra

/-!
# Polynomial invariants from regularity at the vertex

Let a finite group `G` act linearly on a finite-dimensional vector space `M` over a field `k`,
and so on the symmetric algebra `S = Sym M`, with invariant subalgebra `A = Sym(M)^G`. Write
`A₊ = S₊ ∩ A` for the ideal of invariants with zero constant term, the vertex of `Spec A`.

If the local ring `A_{A₊}` is regular, then `A` is a polynomial algebra on `finrank k M`
homogeneous invariants of positive degree. The invariant subalgebra is homogeneous, hence graded
by the degrees of `Sym M`, connected since `Sym⁰ M = k`, and its irrelevant ideal is `A₊`; the
general statement for connected graded algebras
(`TauCeti.GradedAlgebra.exists_bijective_aeval_of_isRegularLocalRing`) applies, and the number of
generators is the dimension of `A_{A₊}`, which is `finrank k M`
(`Representation.ringKrullDim_atPrime_under_irrelevant`).

For `M = V*`, polynomial functions on `V`, this is the final step of the homological proof of
the Chevalley–Shephard–Todd theorem: for a group generated by pseudoreflections whose order is
invertible in `k`, `Sym(V*)` is faithfully flat over `A`
(`Representation.faithfullyFlat_symmetricAlgebra_dual_of_finrank_quotient_eq_one`), so regularity
of the polynomial ring descends to `A_{A₊}`, and then `A` is polynomial on `dim V` basic
invariants.

## Main results

* `Representation.exists_bijective_aeval_symmetricAlgebraInvariants_of_isRegularLocalRing`: if
  the invariant ring is regular at its vertex, it is a polynomial algebra on `finrank k M`
  homogeneous invariants of positive degree.

## References

* R. Kane, *Reflection Groups and Invariant Theory*, Springer (2001), § 18.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), § 7.2.
-/

public section

open TauCeti.SymmetricAlgebra

namespace Representation

variable {k G M : Type*} [Field k] [Group G] [Finite G] [AddCommGroup M] [Module k M]
  [FiniteDimensional k M] (ρ : Representation k G M)

/-- **Polynomial invariants from regularity at the vertex.** For a finite group acting linearly on
a finite-dimensional vector space `M`, if the invariant subalgebra `A = Sym(M)^G` is regular at the
ideal `A₊` of invariants with zero constant term, then there are homogeneous invariants
`f₁, …, fₙ` of positive degree, with `n = finrank k M`, such that `k[X₁, …, Xₙ] → A`,
`Xᵢ ↦ fᵢ`, is an isomorphism. -/
theorem exists_bijective_aeval_symmetricAlgebraInvariants_of_isRegularLocalRing
    [IsRegularLocalRing (Localization.AtPrime
      ((HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
        ρ.symmetricAlgebraInvariants))] :
    ∃ f : Fin (Module.finrank k M) → ρ.symmetricAlgebraInvariants,
      (∀ i, ∃ d, 0 < d ∧ (f i : SymmetricAlgebra k M) ∈ homogeneousSubmodule k M d) ∧
        Function.Bijective (MvPolynomial.aeval (R := k) f) := by
  set A := ρ.symmetricAlgebraInvariants
  let := Subalgebra.gradedAlgebra ρ.isHomogeneous_symmetricAlgebraInvariants
  -- The degree-zero invariants are scalars.
  have hA : ∀ x ∈ A.grading (homogeneousSubmodule k M) 0, x ∈ (⊥ : Subalgebra k A) := by
    intro x hx
    rw [Subalgebra.mem_grading_iff] at hx
    refine Algebra.mem_bot.2 ⟨homogeneousSubmoduleZeroEquiv k M ⟨x, hx⟩, Subtype.ext ?_⟩
    exact algebraMap_homogeneousSubmoduleZeroEquiv_apply k M ⟨x, hx⟩
  -- The irrelevant ideal of `A` is `A₊`.
  have hP : (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under A =
      (HomogeneousIdeal.irrelevant (A.grading (homogeneousSubmodule k M))).toIdeal :=
    (A.toIdeal_irrelevant_grading _).symm
  obtain ⟨f, hf, hbij⟩ := TauCeti.GradedAlgebra.exists_bijective_aeval_of_isRegularLocalRing
    (A.grading (homogeneousSubmodule k M)) hA _ hP ρ.ringKrullDim_atPrime_under_irrelevant
  exact ⟨f, fun i ↦ by simpa using hf i, hbij⟩

end Representation
