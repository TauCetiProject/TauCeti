module

public import Mathlib.RingTheory.IntegralDomain
public import Mathlib.RingTheory.SimpleModule.Basic
public import TauCeti.LinearAlgebra.SymmetricAlgebra.Prime
public import TauCeti.RepresentationTheory.Dual
public import TauCeti.RepresentationTheory.SymmetricAlgebra.Basic

/-!
# Inertia groups of codimension-one primes of a symmetric algebra

Let `ρ` be a representation of a group `G` on a module `M`, acting on the symmetric algebra
`Sym M` by `Representation.symmetricAlgebraMulSemiringAction`. The inertia group `P.inertia G` of
an ideal `P` of `Sym M` is the subgroup of elements acting trivially modulo `P` (Mathlib's
`Ideal.inertia`). Since `Sym M` is generated by `M`, an element lies in it exactly when it moves
every vector by an element of `P`. For the prime ideal spanned by a degree-one element `ι ℓ`, this
says that `g` moves every vector by a multiple of `ℓ`.

Over a field `K`, these are the only height-one primes whose inertia group acts nontrivially on
`M`: if `g` acts nontrivially and lies in the inertia group of a height-one prime `P`, then `P`
contains the nonzero degree-one element `ι (ρ g m - m)` for some `m`, which is prime, so `P` is
spanned by it. Conversely, for finite-dimensional `M` each nonzero `ι ℓ` spans a prime of height
one (`SymmetricAlgebra.height_span_singleton_ι`). If moreover `G` is finite of order invertible in
`K` and `ρ` is faithful, the inertia group of `ι ℓ` acts on the line `K ∙ ℓ` through an injective
character, so it is cyclic.

For polynomial functions on a vector space `V`, take `M = V*` with the contragredient action
`ρ.dual`. A nonzero linear form `ℓ` spans the ideal of the hyperplane `ker ℓ`, and the inertia
group of that ideal is the pointwise stabilizer of `ker ℓ`. Thus a height-one prime of `Sym(V*)`
whose inertia group acts nontrivially on `V` is the ideal of a hyperplane `ker ℓ`, its inertia
group is the pointwise stabilizer of `ker ℓ`, and each element of it acting nontrivially on `V` is
a pseudoreflection whose fixed hyperplane is exactly `ker ℓ`. If moreover `G` is finite of order
invertible in `K` and acts faithfully, these inertia groups are cyclic.

## Main results

* `Representation.symmetricAlgebra_mem_inertia_iff`: `g` lies in the inertia group of `P` exactly
  when `ι (ρ g m - m) ∈ P` for every `m`.
* `Representation.symmetricAlgebra_mem_inertia_span_singleton_ι_iff`: the inertia group of
  `ι ℓ` consists of the elements moving every vector by a multiple of `ℓ`.
* `Representation.exists_eq_span_singleton_ι_of_mem_inertia`: a height-one prime whose inertia
  group acts nontrivially is spanned by a nonzero degree-one element.
* `Representation.isCyclic_inertia_span_singleton_ι` and
  `Representation.isCyclic_inertia_of_height_eq_one`: for a faithful representation of a finite
  group of order invertible in `K`, these inertia groups are cyclic.
* `Representation.dual_symmetricAlgebra_mem_inertia_span_singleton_ι_iff`: for polynomial
  functions on `V`, the inertia group of the ideal of `ker ℓ` is its pointwise stabilizer.
* `Representation.exists_eq_span_singleton_ι_and_ker_eq_of_mem_inertia`: an element of the
  inertia group of a height-one prime of `Sym(V*)` acting nontrivially on `V` is a
  pseudoreflection, whose fixed hyperplane cuts out that prime.

## References

* R. Kane, *Reflection Groups and Invariant Theory*, CMS Books in Mathematics, Springer (2001),
  § 18.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), § 7.4.
-/

public section

open SymmetricAlgebra

namespace Representation

section CommRing

variable {R G M : Type*} [CommRing R] [Group G] [AddCommGroup M] [Module R M]
variable (ρ : Representation R G M)

variable {ρ} in
/-- An element `g` lies in the inertia group of an ideal `P` of `Sym M` for the induced action
exactly when it moves every degree-one element by an element of `P`. -/
theorem symmetricAlgebra_mem_inertia_iff {P : Ideal (SymmetricAlgebra R M)} {g : G} :
    letI := ρ.symmetricAlgebraMulSemiringAction
    g ∈ P.inertia G ↔ ∀ m, ι R M (ρ g m - m) ∈ P := by
  let := ρ.symmetricAlgebraMulSemiringAction
  have hι (m : M) : g • ι R M m - ι R M m = ι R M (ρ g m - m) := by
    rw [symmetricAlgebraMulSemiringAction_smul, symmetricAlgebra_ι, map_sub]
  refine ⟨fun h m ↦ hι m ▸ Ideal.mem_inertia.1 h (ι R M m), fun h ↦ Ideal.mem_inertia.2 fun p ↦ ?_⟩
  -- The elements that `g` moves into `P` form a subalgebra containing the generators.
  induction p using SymmetricAlgebra.induction with
  | algebraMap r =>
    rw [symmetricAlgebraMulSemiringAction_smul, symmetricAlgebra_apply, AlgHom.commutes, sub_self]
    exact P.zero_mem
  | ι m => exact hι m ▸ h m
  | mul p q hp hq =>
    rw [smul_mul', show g • p * g • q - p * q = (g • p - p) * g • q + p * (g • q - q) by ring]
    exact P.add_mem (P.mul_mem_right _ hp) (P.mul_mem_left _ hq)
  | add p q hp hq =>
    rw [smul_add, add_sub_add_comm]
    exact P.add_mem hp hq

variable {ρ} in
/-- An element `g` lies in the inertia group of the ideal spanned by a degree-one element `ι ℓ`
exactly when it moves every vector by a multiple of `ℓ`. -/
theorem symmetricAlgebra_mem_inertia_span_singleton_ι_iff {ℓ : M} {g : G} :
    letI := ρ.symmetricAlgebraMulSemiringAction
    g ∈ (Ideal.span {ι R M ℓ}).inertia G ↔ ∀ m, m - ρ g m ∈ R ∙ ℓ := by
  simp only [symmetricAlgebra_mem_inertia_iff, Ideal.mem_span_singleton, ι_dvd_ι_iff]
  exact forall_congr' fun m ↦ by rw [← neg_sub, Submodule.neg_mem_iff]

end CommRing

section Field

variable {K G M : Type*} [Field K] [Group G] [AddCommGroup M] [Module K M]
variable (ρ : Representation K G M)

/-- If an element `g` acting nontrivially on `M` lies in the inertia group of a height-one prime
`P` of `Sym M`, then `P` is spanned by a nonzero degree-one element. -/
theorem exists_eq_span_singleton_ι_of_mem_inertia {P : Ideal (SymmetricAlgebra K M)} [P.IsPrime]
    (hP : P.height = 1) {g : G}
    (hg : letI := ρ.symmetricAlgebraMulSemiringAction; g ∈ P.inertia G) (hρg : ρ g ≠ 1) :
    ∃ ℓ : M, ℓ ≠ 0 ∧ P = Ideal.span {ι K M ℓ} := by
  obtain ⟨m, hm⟩ : ∃ m, ρ g m ≠ m := by
    by_contra! h
    exact hρg (LinearMap.ext h)
  have hℓ : ρ g m - m ≠ 0 := sub_ne_zero.2 hm
  exact ⟨_, hℓ, Ideal.eq_span_singleton_of_height_eq_one hP
    (symmetricAlgebra_mem_inertia_iff.1 hg m) (prime_ι hℓ)⟩

/-- For a faithful representation of a finite group whose order is invertible in `K`, the
inertia group of the ideal spanned by a nonzero degree-one element `ι ℓ` is cyclic: it acts on the
line `K ∙ ℓ` through an injective character. -/
theorem isCyclic_inertia_span_singleton_ι [Finite G] (hG : (Nat.card G : K) ≠ 0)
    (hρ : Function.Injective ρ) {ℓ : M} (hℓ : ℓ ≠ 0) :
    letI := ρ.symmetricAlgebraMulSemiringAction
    IsCyclic ((Ideal.span {ι K M ℓ}).inertia G) := by
  let := ρ.symmetricAlgebraMulSemiringAction
  set I := (Ideal.span {ι K M ℓ}).inertia G
  have hI (g : I) (m : M) : m - ρ g m ∈ K ∙ ℓ :=
    symmetricAlgebra_mem_inertia_span_singleton_ι_iff.1 g.2 m
  obtain ⟨φ, hφ⟩ := Module.Projective.exists_dual_eq_one K hℓ
  -- Each element of `I` multiplies `ℓ` by the scalar `φ (ρ g ℓ)`.
  have hχ (g : I) : ρ g ℓ = φ (ρ g ℓ) • ℓ := by
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.1 (hI g ℓ)
    have hgℓ : ρ g ℓ = (1 - c) • ℓ := by rw [sub_smul, one_smul, hc, sub_sub_cancel]
    rw [hgℓ, map_smul, hφ, smul_eq_mul, mul_one]
  let χ : I →* K :=
    { toFun g := φ (ρ g ℓ)
      map_one' := by rw [OneMemClass.coe_one, map_one, Module.End.one_apply, hφ]
      map_mul' g h := by
        rw [Subgroup.coe_mul, map_mul, Module.End.mul_apply]
        conv_lhs => rw [hχ h, map_smul, map_smul, smul_eq_mul]
        exact mul_comm _ _ }
  refine isCyclic_of_injective_ringHom χ ((injective_iff_map_eq_one χ).2 fun g hg ↦ ?_)
  -- An element of the kernel is `1 + N` with `N ∘ N = 0`; it has finite order, so `N = 0`.
  set N := ρ g - 1 with hN
  have hNℓ : N ℓ = 0 := by
    rw [hN, LinearMap.sub_apply, Module.End.one_apply, sub_eq_zero, hχ g]
    exact (congrArg (· • ℓ) hg).trans (one_smul K ℓ)
  have hNN : N * N = 0 := LinearMap.ext fun m ↦ by
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.1 (hI g m)
    have hNm : N m = -(c • ℓ) := by
      rw [hc, neg_sub, hN, LinearMap.sub_apply, Module.End.one_apply]
    rw [Module.End.mul_apply, hNm, map_neg, map_smul, hNℓ, smul_zero, neg_zero,
      LinearMap.zero_apply]
  have hpow (n : ℕ) : ρ g ^ n = 1 + (n : K) • N := by
    induction n with
    | zero => rw [pow_zero, Nat.cast_zero, zero_smul, add_zero]
    | succ n ih =>
      have hg' : ρ g = 1 + N := by rw [hN, add_sub_cancel]
      rw [pow_succ, ih, hg']
      simp only [mul_add, add_mul, one_mul, mul_one, smul_mul_assoc, hNN, smul_zero, add_zero,
        Nat.cast_succ, add_smul, one_smul]
      abel
  have hcard : ρ g ^ Nat.card G = 1 := by rw [← map_pow, pow_card_eq_one', map_one]
  rw [hpow, add_eq_left, smul_eq_zero] at hcard
  have hρg : ρ g = ρ 1 := by
    rw [map_one, ← sub_eq_zero]
    exact hcard.resolve_left hG
  exact Subtype.ext (hρ hρg)

/-- For a faithful representation of a finite group whose order is invertible in `K`, the inertia
group of every height-one prime of `Sym M` is cyclic. -/
theorem isCyclic_inertia_of_height_eq_one [Finite G] (hG : (Nat.card G : K) ≠ 0)
    (hρ : Function.Injective ρ) {P : Ideal (SymmetricAlgebra K M)} [P.IsPrime]
    (hP : P.height = 1) :
    letI := ρ.symmetricAlgebraMulSemiringAction
    IsCyclic (P.inertia G) := by
  let := ρ.symmetricAlgebraMulSemiringAction
  by_cases h : ∃ g ∈ P.inertia G, ρ g ≠ 1
  · obtain ⟨g, hg, hρg⟩ := h
    obtain ⟨ℓ, hℓ, rfl⟩ := ρ.exists_eq_span_singleton_ι_of_mem_inertia hP hg hρg
    exact ρ.isCyclic_inertia_span_singleton_ι hG hρ hℓ
  · -- Otherwise every element of the inertia group acts trivially, so it is trivial.
    simp only [ne_eq, not_exists, not_and, not_not] at h
    have : Subsingleton (P.inertia G) :=
      ⟨fun g h' ↦ Subtype.ext (hρ ((h g g.2).trans (h h' h'.2).symm))⟩
    infer_instance

end Field

section Dual

variable {K G V : Type*} [Field K] [Group G] [AddCommGroup V] [Module K V]
variable (ρ : Representation K G V)

variable {ρ} in
/-- For polynomial functions on `V`, the inertia group of the ideal spanned by a linear form `ℓ`
is the pointwise stabilizer of the hyperplane `ker ℓ`. -/
theorem dual_symmetricAlgebra_mem_inertia_span_singleton_ι_iff {ℓ : Module.Dual K V} {g : G} :
    letI := ρ.dual.symmetricAlgebraMulSemiringAction
    g ∈ (Ideal.span {ι K (Module.Dual K V) ℓ}).inertia G ↔
      LinearMap.ker ℓ ≤ LinearMap.ker (ρ g - 1) := by
  rw [symmetricAlgebra_mem_inertia_span_singleton_ι_iff,
    forall_sub_dual_apply_mem_span_singleton_iff]

/-- Let `P` be a height-one prime of the polynomial functions `Sym(V*)` on `V`, and let `g` lie in
its inertia group and act nontrivially on `V`. Then `P` is spanned by a nonzero linear form `ℓ`,
and `g` is a pseudoreflection fixing exactly the hyperplane `ker ℓ`. -/
theorem exists_eq_span_singleton_ι_and_ker_eq_of_mem_inertia
    {P : Ideal (SymmetricAlgebra K (Module.Dual K V))} [P.IsPrime] (hP : P.height = 1) {g : G}
    (hg : letI := ρ.dual.symmetricAlgebraMulSemiringAction; g ∈ P.inertia G) (hρg : ρ g ≠ 1) :
    ∃ ℓ : Module.Dual K V, ℓ ≠ 0 ∧ P = Ideal.span {ι K (Module.Dual K V) ℓ} ∧
      LinearMap.ker (ρ g - 1) = LinearMap.ker ℓ := by
  obtain ⟨ℓ, hℓ, rfl⟩ := ρ.dual.exists_eq_span_singleton_ι_of_mem_inertia hP hg
    (dual_apply_eq_one_iff.not.2 hρg)
  refine ⟨ℓ, hℓ, rfl, ?_⟩
  have hle := dual_symmetricAlgebra_mem_inertia_span_singleton_ι_iff.1 hg
  refine ((LinearMap.isCoatom_ker_of_surjective (ℓ.surjective_or_eq_zero.resolve_right hℓ)).le_iff.1
    hle).resolve_left fun htop ↦ hρg ?_
  rw [← sub_eq_zero]
  exact LinearMap.ker_eq_top.1 htop

end Dual

end Representation
