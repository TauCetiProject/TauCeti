module

public import Mathlib.FieldTheory.Galois.IsGaloisGroup
public import TauCeti.RepresentationTheory.SymmetricAlgebra.Basic

/-!
# The Galois group of polynomial invariants

Let `ρ` be a representation of a group `G` on a module `M`, acting on the symmetric algebra
`S = Sym M`, with invariant subalgebra `A = Sym(M)^G`. For `M = V*` with the contragredient
action, `S` is the ring of polynomial functions on `V` and `A` that of the quotient `V/G`.

The induced action of `G` on `S` is faithful exactly when `ρ` is, since `S` is generated by the
degree-one copy of `M`. Hence for a faithful representation `G` is a Galois group of `S` over
`A` in the sense of Mathlib's `IsGaloisGroup`: it acts faithfully, and its fixed points are `A`.
When moreover `G` is finite and `S` is a domain (for instance when `M` is a free module over a
domain, such as a vector space over a field), Mathlib's `IsGaloisGroup.toFractionRing` passes
this to fraction fields: the field of rational functions `Frac S`, which is `K(V)` for `M = V*`
over a field `K`, is a Galois extension of the field `Frac A` of invariant rational functions,
with Galois group `G` and degree `#G`.

The Galois correspondence then identifies the subgroups of `G` from their invariants. For a
subgroup `H`, an element of `G` fixes every `H`-invariant polynomial exactly when it lies in `H`.
When `H` is normal, `G ⧸ H` acts on the `H`-invariants, and this action is faithful. In geometric
terms, the action of `G ⧸ H` on `V/H`, whose quotient is `V/G`, is faithful. This is the input
of the converse of the Shephard–Todd theorem, where `H` is the subgroup generated by the
pseudoreflections of `G`.

## Main results

* `Representation.faithfulSMul_symmetricAlgebra_iff`: the action on `Sym M` is faithful exactly
  when `ρ` is injective.
* `Representation.isGaloisGroup_symmetricAlgebraInvariants_iff`: `G` is a Galois group of `Sym M`
  over `Sym(M)^G` exactly when `ρ` is injective.
* `Representation.isGalois_fractionRing_symmetricAlgebraInvariants` and
  `Representation.finrank_fractionRing_symmetricAlgebraInvariants`: for finite `G` and faithful
  `ρ`, the extension of fraction fields `Frac(Sym M) / Frac(Sym(M)^G)` is Galois of degree `#G`.
* `Representation.forall_symmetricAlgebra_apply_eq_iff_mem`: an element of `G` fixes every
  invariant of a subgroup `H` exactly when it lies in `H`.
* `Representation.faithfulSMul_quotient_symmetricAlgebra`: for a normal subgroup `H`, the
  quotient `G ⧸ H` acts faithfully on the `H`-invariants.

## References

* R. Kane, *Reflection Groups and Invariant Theory*, Springer (2001), § 18.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), § 1.2 and § 7.4.
-/

public section

open TauCeti.SymmetricAlgebra

namespace Representation

variable {R G M : Type*}

section Monoid

variable [CommSemiring R] [Monoid G] [AddCommMonoid M] [Module R M]
variable (ρ : Representation R G M)

/-- The action of `G` on `Sym M` induced by `ρ` is faithful exactly when `ρ` is: an element acts
trivially on `Sym M` if and only if it acts trivially on the degree-one copy of `M`. -/
theorem faithfulSMul_symmetricAlgebra_iff :
    (letI := ρ.symmetricAlgebraMulSemiringAction
    FaithfulSMul G (SymmetricAlgebra R M)) ↔ Function.Injective ρ := by
  let := ρ.symmetricAlgebraMulSemiringAction
  refine ⟨fun h g₁ g₂ hg ↦ h.eq_of_smul_eq_smul fun p ↦ ?_,
    fun hρ ↦ ⟨fun {g₁ g₂} hg ↦ hρ (LinearMap.ext fun m ↦ ι_injective R M ?_)⟩⟩
  · simp only [symmetricAlgebraMulSemiringAction_smul, symmetricAlgebra_apply, hg]
  · simpa only [symmetricAlgebraMulSemiringAction_smul, symmetricAlgebra_ι] using
      hg (SymmetricAlgebra.ι R M m)

end Monoid

section Group

variable [CommSemiring R] [Group G] [AddCommMonoid M] [Module R M]
variable (ρ : Representation R G M)

/-- `G` is a Galois group of `Sym M` over the invariant subalgebra `Sym(M)^G`, in the sense of
`IsGaloisGroup`, exactly when `ρ` is faithful. The invariance condition holds by definition of the
invariant subalgebra, so the content is the faithfulness of the induced action. -/
theorem isGaloisGroup_symmetricAlgebraInvariants_iff :
    (letI := ρ.symmetricAlgebraMulSemiringAction
    IsGaloisGroup G ρ.symmetricAlgebraInvariants (SymmetricAlgebra R M)) ↔
      Function.Injective ρ := by
  let := ρ.symmetricAlgebraMulSemiringAction
  have := ρ.smulCommClass_symmetricAlgebraMulSemiringAction
  rw [← faithfulSMul_symmetricAlgebra_iff]
  exact ⟨fun h ↦ h.faithful, fun h ↦
    { faithful := h
      commutes := ⟨fun g a p ↦ by
        rw [Subalgebra.smul_def, Subalgebra.smul_def, smul_eq_mul, smul_eq_mul, smul_mul',
          symmetricAlgebraMulSemiringAction_smul, (ρ.mem_symmetricAlgebraInvariants a).1 a.2 g]⟩
      isInvariant := ρ.isInvariant_symmetricAlgebraInvariants }⟩

end Group

section Field

variable [CommRing R] [Group G] [AddCommMonoid M] [Module R M]
variable (ρ : Representation R G M) [Finite G] [IsDomain (SymmetricAlgebra R M)]

attribute [local instance] FractionRing.liftAlgebra in
/-- For a faithful representation of a finite group with `Sym M` a domain, the field of rational
functions `Frac(Sym M)` is a Galois extension of the field `Frac(Sym(M)^G)` of invariant rational
functions. -/
theorem isGalois_fractionRing_symmetricAlgebraInvariants (hρ : Function.Injective ρ) :
    IsGalois (FractionRing ρ.symmetricAlgebraInvariants)
      (FractionRing (SymmetricAlgebra R M)) := by
  let := ρ.symmetricAlgebraMulSemiringAction
  let := IsFractionRing.mulSemiringAction G (SymmetricAlgebra R M)
    (FractionRing (SymmetricAlgebra R M))
  have := (ρ.isGaloisGroup_symmetricAlgebraInvariants_iff).2 hρ
  have := IsGaloisGroup.to_isFractionRing G ρ.symmetricAlgebraInvariants (SymmetricAlgebra R M)
    (FractionRing ρ.symmetricAlgebraInvariants) (FractionRing (SymmetricAlgebra R M))
  exact IsGaloisGroup.isGalois G _ _

attribute [local instance] FractionRing.liftAlgebra in
/-- For a faithful representation of a finite group with `Sym M` a domain, the field of rational
functions `Frac(Sym M)` has degree `#G` over the field `Frac(Sym(M)^G)` of invariant rational
functions. -/
theorem finrank_fractionRing_symmetricAlgebraInvariants (hρ : Function.Injective ρ) :
    Module.finrank (FractionRing ρ.symmetricAlgebraInvariants)
      (FractionRing (SymmetricAlgebra R M)) = Nat.card G := by
  let := ρ.symmetricAlgebraMulSemiringAction
  let := IsFractionRing.mulSemiringAction G (SymmetricAlgebra R M)
    (FractionRing (SymmetricAlgebra R M))
  have := (ρ.isGaloisGroup_symmetricAlgebraInvariants_iff).2 hρ
  have := IsGaloisGroup.to_isFractionRing G ρ.symmetricAlgebraInvariants (SymmetricAlgebra R M)
    (FractionRing ρ.symmetricAlgebraInvariants) (FractionRing (SymmetricAlgebra R M))
  exact (IsGaloisGroup.card_eq_finrank G _ _).symm

/-- For a faithful representation of a finite group with `Sym M` a domain, an element `g` of `G`
fixes every polynomial invariant of a subgroup `H` exactly when `g ∈ H`. -/
theorem forall_symmetricAlgebra_apply_eq_iff_mem (hρ : Function.Injective ρ) (H : Subgroup G)
    (g : G) :
    (∀ p, (∀ h ∈ H, ρ.symmetricAlgebra h p = p) → ρ.symmetricAlgebra g p = p) ↔ g ∈ H := by
  let := ρ.symmetricAlgebraMulSemiringAction
  have := ρ.smulCommClass_symmetricAlgebraMulSemiringAction
  have hG := (ρ.isGaloisGroup_symmetricAlgebraInvariants_iff).2 hρ
  have : IsGaloisGroup H (FixedPoints.subalgebra R (SymmetricAlgebra R M) H)
      (SymmetricAlgebra R M) :=
    { faithful := have := hG.faithful; inferInstance
      commutes := inferInstance
      isInvariant := inferInstance }
  refine Iff.trans ?_ (SetLike.ext_iff.1 (IsGaloisGroup.fixingSubgroup_range_algebraMap G
    ρ.symmetricAlgebraInvariants (FixedPoints.subalgebra R (SymmetricAlgebra R M) H)
    (SymmetricAlgebra R M) H) g)
  simp [mem_fixingSubgroup_iff, FixedPoints.mem_subalgebra, Subgroup.smul_def,
    symmetricAlgebraMulSemiringAction_smul]

/-- For a faithful representation of a finite group with `Sym M` a domain and a normal subgroup
`H`, the quotient `G ⧸ H` acts faithfully on the subalgebra of `H`-invariants, with its action
`g • p` through any representative `g`. Here the `H`-invariants are Mathlib's
`FixedPoints.subalgebra` for the restricted action, which carries Mathlib's action of `G ⧸ H`; as a
set it is `symmetricAlgebraInvariants (ρ.comp H.subtype)`. Geometrically, for `M = V*`, the
residual action of `G ⧸ H` on the quotient `V/H` is faithful. -/
theorem faithfulSMul_quotient_symmetricAlgebra (hρ : Function.Injective ρ) (H : Subgroup G)
    [H.Normal] :
    letI := ρ.symmetricAlgebraMulSemiringAction
    haveI := ρ.smulCommClass_symmetricAlgebraMulSemiringAction
    FaithfulSMul (G ⧸ H) (FixedPoints.subalgebra R (SymmetricAlgebra R M) H) := by
  let := ρ.symmetricAlgebraMulSemiringAction
  have := ρ.smulCommClass_symmetricAlgebraMulSemiringAction
  refine ⟨fun {q₁ q₂} hq ↦ ?_⟩
  induction q₁ using QuotientGroup.induction_on with | H g₁ => ?_
  induction q₂ using QuotientGroup.induction_on with | H g₂ => ?_
  rw [QuotientGroup.eq, ← ρ.forall_symmetricAlgebra_apply_eq_iff_mem hρ]
  intro p hp
  replace hp : p ∈ FixedPoints.subalgebra R (SymmetricAlgebra R M) H := fun h ↦ hp h h.2
  -- The class of `g` acts on an `H`-invariant `p` by `g • p`, by definition of Mathlib's action
  -- of `G ⧸ H` on `FixedPoints.subalgebra`.
  have h : g₁ • p = g₂ • p := congrArg Subtype.val (hq ⟨p, hp⟩)
  rw [← symmetricAlgebraMulSemiringAction_smul, mul_smul, ← h, inv_smul_smul]

end Field

end Representation
