module

public import Mathlib.RingTheory.TensorProduct.IsBaseChangeFree
public import TauCeti.RepresentationTheory.SymmetricAlgebra.Free
import Mathlib.LinearAlgebra.Projection
import TauCeti.LinearAlgebra.DirectSum.Basis

/-!
# Multiplication by a homogeneous coinvariant complement

Let a finite group `G` act on a finite-dimensional vector space `M` over a field `k`.
Write `S = Sym M`, `A = S^G`, and `I = A₊ S`. If `S` is flat over `A`, multiplication induces
an `A`-linear isomorphism `A ⊗[k] H ≃ S` for every homogeneous vector-space complement `H` to
`I`. This is the multiplication comparison underlying the coinvariant decomposition of
polynomial functions for a finite pseudoreflection group whose order is invertible in `k`.

The comparison is expressed using Mathlib's `IsBaseChange`: the inclusion `H → S` exhibits
`S` as the extension of scalars of `H` from `k` to `A`. Its `IsBaseChange.equiv` sends
`a ⊗ h` to `a • h`, and `IsBaseChange.basis` turns every basis of `H` into a free `A`-basis
of `S`. No choice of coordinates or of a basis is part of the comparison. Homogeneity of
`H` is essential: an arbitrary vector-space complement need not generate over `A`.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras*, Chapters 4–6, Chapter V, § 5.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Chapter 3.
-/

public section

open TauCeti.SymmetricAlgebra

namespace Representation

variable {k G M : Type*} [Field k] [Group G] [Finite G] [AddCommGroup M] [Module k M]
  [FiniteDimensional k M] (ρ : Representation k G M)

/-- Multiplication identifies the extension of scalars of any homogeneous coinvariant
complement with the symmetric algebra, provided the latter is flat over its invariants.
The induced equivalence is `(ρ.isBaseChange_subtype_of_isHomogeneous_isCompl H hH hI).equiv`;
it sends `a ⊗ h` to `a • h`. -/
theorem isBaseChange_subtype_of_isHomogeneous_isCompl
    [Module.Flat ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M)]
    (H : Submodule k (SymmetricAlgebra k M))
    (hH : H.IsHomogeneous (homogeneousSubmodule k M))
    (hI : IsCompl (ρ.symmetricAlgebraHilbertIdeal.restrictScalars k) H) :
    IsBaseChange ρ.symmetricAlgebraInvariants H.subtype := by
  classical
  obtain ⟨t, b, hb⟩ := H.exists_basis_isHomogeneousElem_of_isHomogeneous _ hH
  let e := (ρ.symmetricAlgebraHilbertIdeal.restrictScalars k).quotientEquivOfIsCompl H hI
  let q := e.symm.trans
    (Submodule.Quotient.restrictScalarsEquiv k ρ.symmetricAlgebraHilbertIdeal)
  have he (x : H) : e.symm x = Submodule.Quotient.mk (x : SymmetricAlgebra k M) :=
    DFunLike.congr_fun (Submodule.toLinearMap_symm_quotientEquivOfIsCompl hI) x
  have hmk : Ideal.Quotient.mkₐ k ρ.symmetricAlgebraHilbertIdeal ∘ (H.subtype ∘ b) =
      b.map q := by
    ext i
    simp only [Function.comp_apply, Module.Basis.map_apply, q, LinearEquiv.trans_apply, he,
      Submodule.Quotient.restrictScalarsEquiv_mk, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.mk_eq_mk, Submodule.subtype_apply]
  have hli : LinearIndependent k
      (Ideal.Quotient.mkₐ k ρ.symmetricAlgebraHilbertIdeal ∘ (H.subtype ∘ b)) := by
    rw [hmk]
    exact (b.map q).linearIndependent
  have hspan : Submodule.span k
      (Set.range (Ideal.Quotient.mkₐ k ρ.symmetricAlgebraHilbertIdeal ∘ (H.subtype ∘ b))) = ⊤ := by
    rw [hmk]
    exact (b.map q).span_eq
  let B : Module.Basis t ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M) :=
    .mk (ρ.linearIndependent_of_linearIndependent_mk _ hb hli hspan)
      (ρ.span_range_eq_top_of_span_range_mk_eq_top _ hb hspan).ge
  have hB (i : t) : B i = (b i : SymmetricAlgebra k M) := Module.Basis.mk_apply _ _ i
  have hcomp : (Finsupp.linearCombination k B).comp b.repr.toLinearMap = H.subtype := by
    apply b.ext
    intro i
    simp [hB]
  rw [← hcomp]
  exact (IsBaseChange.of_basis k B).comp_equiv b.repr _

section Pseudoreflection

variable {K W V : Type*} [Field K] [Group W] [Fintype W] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] (σ : Representation K W V) [Invertible (Fintype.card W : K)]

/-- For a finite group generated by pseudoreflections whose order is invertible in `K`,
multiplication by any homogeneous coinvariant complement gives the free-module decomposition
of polynomial functions on `V`.
No faithfulness assumption is needed. -/
theorem isBaseChange_subtype_dual_of_pseudoreflectionSubgroup_eq_top
    (hW : σ.pseudoreflectionSubgroup = ⊤)
    (H : Submodule K (SymmetricAlgebra K (Module.Dual K V)))
    (hH : H.IsHomogeneous (homogeneousSubmodule K (Module.Dual K V)))
    (hI : IsCompl (σ.dual.symmetricAlgebraHilbertIdeal.restrictScalars K) H) :
    IsBaseChange σ.dual.symmetricAlgebraInvariants H.subtype := by
  have := σ.faithfullyFlat_symmetricAlgebra_dual_of_pseudoreflectionSubgroup_eq_top hW
  exact σ.dual.isBaseChange_subtype_of_isHomogeneous_isCompl H hH hI

end Pseudoreflection

end Representation
