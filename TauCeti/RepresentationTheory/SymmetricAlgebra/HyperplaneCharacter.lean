module

public import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots
public import TauCeti.RepresentationTheory.SymmetricAlgebra.Inertia
import TauCeti.LinearAlgebra.Determinant.FiniteOrder
import TauCeti.LinearAlgebra.Dual.Lemmas

/-!
# The determinant character of hyperplane inertia

Let a finite group act faithfully on a finite-dimensional vector space over a field in
which the group order is invertible. The inertia group of the ideal generated by a nonzero
linear form in `Sym(V*)` is its kernel hyperplane's pointwise stabilizer. Determinant is
injective on this group, so a generator has determinant a primitive root of unity of order
equal to the stabilizer's cardinality.

This identifies the order of the character used in the multiplicity of a reflecting
hyperplane in the invariant Jacobian. The statement includes trivial stabilizers, whose
character has order one, and requires neither algebraic closedness nor characteristic zero.

## References

* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press (1990),
  Chapter 3.
* R. Kane, *Reflection Groups and Invariant Theory*, Springer (2001), §18.
-/

public section

namespace Representation

variable {K G V : Type*} [Field K] [Group G]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  (ρ : Representation K G V)

/-- Determinant is faithful on the pointwise stabilizer of a hyperplane, expressed as the
inertia group of its defining linear form in the polynomial functions `Sym(V*)`. -/
theorem det_injective_on_dual_inertia_span_singleton_ι (hG : (Nat.card G : K) ≠ 0)
    (hρ : Function.Injective ρ) {ℓ : Module.Dual K V} (hℓ : ℓ ≠ 0) :
    letI := ρ.dual.symmetricAlgebraMulSemiringAction
    Function.Injective (fun g : (Ideal.span {SymmetricAlgebra.ι K (Module.Dual K V) ℓ}).inertia G
      ↦ LinearMap.det (ρ g)) := by
  let := ρ.dual.symmetricAlgebraMulSemiringAction
  let I := (Ideal.span {SymmetricAlgebra.ι K (Module.Dual K V) ℓ}).inertia G
  let χ := (LinearMap.det.comp ρ).comp I.subtype
  apply (injective_iff_map_eq_one χ).2
  intro g hg
  apply Subtype.ext
  apply hρ
  rw [OneMemClass.coe_one, map_one]
  apply (ρ g).eq_one_of_det_eq_one_of_pow_eq_one (LinearMap.ker ℓ)
    (ℓ.finrank_quotient_ker_eq_one_of_ne_zero hℓ)
  · intro x hx
    have hfix := dual_symmetricAlgebra_mem_inertia_span_singleton_ι_iff.1 g.2 hx
    simpa only [LinearMap.mem_ker, LinearMap.sub_apply, one_apply_eq_self, sub_eq_zero]
      using hfix
  · exact hg
  · exact hG
  · rw [← map_pow, pow_card_eq_one', map_one]

/-- A hyperplane inertia group has an element whose determinant is a primitive root of
unity of order equal to the group's cardinality. Thus its determinant character has the
full stabilizer order, including order one for a trivial stabilizer. -/
theorem exists_isPrimitiveRoot_det_dual_inertia_span_singleton_ι
    (hG : (Nat.card G : K) ≠ 0) (hρ : Function.Injective ρ)
    {ℓ : Module.Dual K V} (hℓ : ℓ ≠ 0) :
    letI := ρ.dual.symmetricAlgebraMulSemiringAction
    let I := (Ideal.span {SymmetricAlgebra.ι K (Module.Dual K V) ℓ}).inertia G
    ∃ g : I, IsPrimitiveRoot (LinearMap.det (ρ g)) (Nat.card I) := by
  have : Finite G := Nat.finite_of_card_ne_zero fun h ↦ hG (by simp [h])
  let := ρ.dual.symmetricAlgebraMulSemiringAction
  let I := (Ideal.span {SymmetricAlgebra.ι K (Module.Dual K V) ℓ}).inertia G
  let χ := (LinearMap.det.comp ρ).comp I.subtype
  have : IsCyclic I := ρ.dual.isCyclic_inertia_span_singleton_ι hG
    (ρ.dual_injective_iff.2 hρ) hℓ
  obtain ⟨g, hg⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := I)
  refine ⟨g, IsPrimitiveRoot.iff_orderOf.2 ?_⟩
  exact (orderOf_injective χ (ρ.det_injective_on_dual_inertia_span_singleton_ι hG hρ hℓ) g).trans hg

end Representation
