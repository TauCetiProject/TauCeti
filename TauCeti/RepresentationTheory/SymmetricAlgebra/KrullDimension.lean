/-!
# The invariant ring of a finite linear group at its vertex

Let a finite group `G` act linearly on a module `M` over a commutative ring `R`, and so on the
symmetric algebra `S = Sym M`, with invariant subalgebra `A = Sym(M)^G`. Write `S₊` for the
irrelevant ideal of `S` and `A₊ = S₊ ∩ A` for the ideal of invariants with zero constant term, the
*vertex* of the quotient `Spec S → Spec A`. This file compares `A` at `A₊` with `S` at `S₊`.

Over a domain, `S₊` is the only prime of `S` lying over `A₊`: the primes over `A₊` form a
single `G`-orbit, and `S₊` is `G`-stable. Geometrically, the fibre of `Spec S → Spec A` over the
vertex has a single point, the origin.

When `M` is finitely generated, `S` is a finite `A`-module, and `A` is of finite type over a
Noetherian base (Noether's finiteness theorem, see
`TauCeti.RepresentationTheory.SymmetricAlgebra.FiniteType`). Over a field `k` with `M`
finite-dimensional, prime heights are then unchanged under contraction from `S` to `A`, so the
vertex has height
`finrank k M` and the local ring `A_{A₊}` has Krull dimension `finrank k M`, as does `A` itself.
For `M = V*` this says that the quotient `V/G` has dimension `dim V` at its vertex, the
dimension count needed to identify the invariant ring of a group generated by pseudoreflections
with a polynomial ring.

## Main results

* `Representation.ringKrullDim_symmetricAlgebraInvariants`: the invariant subalgebra has the Krull
  dimension of `Sym M`.
* `Representation.primesOver_under_irrelevant_eq_singleton`: over a domain, `S₊` is the only
  prime of `Sym M` lying over `A₊`.
* `Representation.height_under_symmetricAlgebraInvariants`: over a field, contraction to the
  invariants preserves the heights of primes.
* `Representation.height_under_irrelevant` and
  `Representation.ringKrullDim_atPrime_under_irrelevant`: over a field, `A₊` has height
  `finrank k M`, so `A_{A₊}` has Krull dimension `finrank k M`.

## References

* H. Derksen, G. Kemper, *Computational Invariant Theory*, Springer (2002), Chapter 2.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), Chapter 2.
-/

public section

open TauCeti.SymmetricAlgebra
open scoped Pointwise

namespace Representation

variable {R k G M : Type*}

section CommRing

variable [CommRing R] [Group G] [Finite G] [AddCommMonoid M] [Module R M]
variable (ρ : Representation R G M)

/-- For a finite group, the invariant subalgebra has the Krull dimension of the symmetric
algebra, which is integral over it. -/
theorem ringKrullDim_symmetricAlgebraInvariants :
    ringKrullDim ρ.symmetricAlgebraInvariants = ringKrullDim (SymmetricAlgebra R M) :=
  (TauCeti.ringKrullDim_eq_of_isIntegral_of_faithfulSMul ..).symm

/-- Over a domain, the only prime of `Sym M` lying over the ideal `A₊` of invariants with zero
constant term is the irrelevant ideal `S₊`. -/
theorem eq_irrelevant_of_liesOver [IsDomain R] (P : Ideal (SymmetricAlgebra R M)) [P.IsPrime]
    [P.LiesOver ((HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal.under
      ρ.symmetricAlgebraInvariants)] :
    P = (HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal := by
  let := ρ.symmetricAlgebraMulSemiringAction
  have := ρ.smulCommClass_symmetricAlgebraMulSemiringAction
  have := ρ.isInvariant_symmetricAlgebraInvariants
  have : SMulCommClass G ρ.symmetricAlgebraInvariants (SymmetricAlgebra R M) :=
    ρ.symmetricAlgebraInvariants_eq_fixedPoints ▸ inferInstance
  -- The primes over `A₊` form one `G`-orbit, so `P` is a translate of `S₊`.
  obtain ⟨g, hg⟩ := Algebra.IsInvariant.exists_smul_of_under_eq ρ.symmetricAlgebraInvariants
    (SymmetricAlgebra R M) G (HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal P
    Ideal.LiesOver.over
  -- `S₊` is `G`-stable, so every translate of it is `S₊` itself.
  have hmem (g : G) (p : SymmetricAlgebra R M)
      (hp : p ∈ HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)) :
      g • p ∈ HomogeneousIdeal.irrelevant (homogeneousSubmodule R M) :=
    ρ.symmetricAlgebra_mem_irrelevant g hp
  ext p
  rw [hg, Ideal.mem_pointwise_smul_iff_inv_smul_mem]
  exact ⟨fun hp ↦ by simpa using hmem g _ hp, hmem g⁻¹ p⟩

/-- **The fibre over the vertex has a single point.** Over a domain, the irrelevant ideal `S₊` is
the only prime of `Sym M` lying over the ideal `A₊` of invariants with zero constant term. -/
theorem primesOver_under_irrelevant_eq_singleton [IsDomain R] :
    ((HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal.under
        ρ.symmetricAlgebraInvariants).primesOver (SymmetricAlgebra R M) =
      {(HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal} := by
  ext P
  refine ⟨fun ⟨_, _⟩ ↦ ρ.eq_irrelevant_of_liesOver P, ?_⟩
  rintro rfl
  exact ⟨inferInstance, inferInstance⟩

end CommRing

section Field

variable [Field k] [Group G] [Finite G] [AddCommGroup M] [Module k M] [FiniteDimensional k M]
variable (ρ : Representation k G M)

/-- Over a field, for a finite group acting on a finite-dimensional space `M`, contracting a prime
of `Sym M` to the invariant subalgebra preserves its height. -/
theorem height_under_symmetricAlgebraInvariants (P : Ideal (SymmetricAlgebra k M)) [P.IsPrime] :
    (P.under ρ.symmetricAlgebraInvariants).height = P.height :=
  (Ideal.height_eq_height_under_of_finite_of_finiteType k P).symm

/-- **The dimension of the invariant ring at its vertex.** Over a field, for a finite group acting
on a finite-dimensional space `M`, the ideal `A₊` of invariants with zero constant term has height
`finrank k M`. -/
theorem height_under_irrelevant :
    ((HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
      ρ.symmetricAlgebraInvariants).height = Module.finrank k M := by
  rw [height_under_symmetricAlgebraInvariants,
    Ideal.height_symmetricAlgebra_eq_finrank_of_isMaximal]

/-- Over a field, for a finite group acting on a finite-dimensional space `M`, the localization of
the invariant subalgebra at the ideal `A₊` of invariants with zero constant term has Krull dimension
`finrank k M`. -/
theorem ringKrullDim_atPrime_under_irrelevant :
    ringKrullDim (Localization.AtPrime
      ((HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
        ρ.symmetricAlgebraInvariants)) = Module.finrank k M := by
  set I := (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
    ρ.symmetricAlgebraInvariants
  refine (IsLocalization.AtPrime.ringKrullDim_eq_height I (Localization.AtPrime I)).trans ?_
  rw [ρ.height_under_irrelevant]
  norm_cast

end Field

end Representation
