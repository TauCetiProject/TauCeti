/-!
# Weyl invariants on the coroot space

Let `P : RootPairing ι R M N` be a root pairing. Its Weyl group `W` acts on the weight space `M`
through `P.weylGroupRootRep`, hence on the polynomial functions `Sym(M*)` through the contragredient
action, and its opposite group acts on the coroot space `N` through `P.weylGroupCorootRep`, hence on
`Sym N`. The perfect pairing identifies `N` with `M*`,
`P.toLinearMap.flip.toPerfPair : N ≃ M*`, and this identification is Weyl-equivariant once the
opposite of `w` is matched with `w⁻¹`, because `⟨w x, y⟩ = ⟨x, w y⟩` for the two actions
(`RootPairing.toPerfPair_flip_weylGroupCorootRep`).

So the induced graded isomorphism `Sym N ≃ Sym(M*)` carries the coroot invariants `(Sym N)^W` onto
the Weyl invariants `Sym(M*)^W` (`RootPairing.map_symmetricAlgebraInvariants_weylGroupCorootRep`).
Every system of basic invariants of `Sym(M*)^W` therefore gives one of `(Sym N)^W` with the same
degrees, and Chevalley's theorem holds for the coroot representation too
(`RootPairing.exists_bijective_aeval_weylGroupCorootRep_of_base`).

The coroot form is the one met in Lie theory: for a Cartan subalgebra `H` of a Lie algebra with
nondegenerate Killing form, the Weyl group acts on `H` as the coroot space of its root system, and
the Weyl invariants of `S(H)` are the target of Chevalley's restriction theorem.

## Main definitions

* `RootPairing.weylGroupCorootRepInvariantsEquiv`: the algebra isomorphism
  `(Sym N)^W ≃ₐ[R] Sym(M*)^W` induced by the perfect pairing.

## Main results

* `RootPairing.toPerfPair_flip_weylGroupCorootRep`: Weyl-equivariance of `N ≃ M*`.
* `RootPairing.map_mem_symmetricAlgebraInvariants_weylGroupRootRep_dual_iff` and
  `RootPairing.map_symmetricAlgebraInvariants_weylGroupCorootRep`: the identification of the two
  invariant subalgebras.
* `RootPairing.exists_bijective_aeval_weylGroupCorootRep_of_weylGroupRootRep_dual`: a system of
  basic invariants of `Sym(M*)^W` gives one of `(Sym N)^W` with the same degrees.
* `RootPairing.exists_bijective_aeval_weylGroupCorootRep` and
  `RootPairing.exists_bijective_aeval_weylGroupCorootRep_of_base`: **Chevalley's theorem for the
  coroot representation**, when `2` and `|W|` are invertible, and in characteristic zero for a
  finite reduced crystallographic pairing with a base.

## References

* C. Chevalley, *Invariants of finite groups generated by reflections*, Amer. J. Math. **77**
  (1955), 778–782.
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Ch. V, §5, Theorem 3.
-/

public section

open Module TauCeti.SymmetricAlgebra

namespace RootPairing

section CommRing

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N]
  [Module R N] (P : RootPairing ι R M N)

/-- **The pairing identifies the coroot space with the dual of the weight space equivariantly**:
the opposite of a Weyl group element `w`, acting on `N`, corresponds under
`P.toLinearMap.flip.toPerfPair : N ≃ M*` to the contragredient action of `w⁻¹` on `M*`. -/
theorem toPerfPair_flip_weylGroupCorootRep (w : P.weylGroup) (y : N) :
    P.toLinearMap.flip.toPerfPair (P.weylGroupCorootRep (Subgroup.equivOp _ w) y) =
      P.weylGroupRootRep.dual w⁻¹ (P.toLinearMap.flip.toPerfPair y) := by
  ext x
  simp only [LinearMap.toLinearMap_toPerfPair, LinearMap.flip_apply, Representation.dual_apply,
    inv_inv, weylGroupRootRep_apply, weylGroupCorootRep_apply, Module.Dual.transpose_apply,
    LinearMap.comp_apply]
  -- the goal is `⟨x, op w • y⟩ = ⟨w • x, y⟩`: Mathlib acts on weights through `weightEquiv` and
  -- on coweights through `coweightEquiv`, and the pairing makes this their transposition law
  exact (Equiv.toLinearMap_weightEquiv (w : P.Aut) x y).symm

/-- The symmetric-algebra form of `RootPairing.toPerfPair_flip_weylGroupCorootRep`. -/
theorem map_toPerfPair_flip_symmetricAlgebra_weylGroupCorootRep (w : P.weylGroup)
    (p : SymmetricAlgebra R N) :
    SymmetricAlgebra.map R (P.toLinearMap.flip.toPerfPair : N →ₗ[R] Dual R M)
        (P.weylGroupCorootRep.symmetricAlgebra (Subgroup.equivOp _ w) p) =
      P.weylGroupRootRep.dual.symmetricAlgebra w⁻¹
        (SymmetricAlgebra.map R (P.toLinearMap.flip.toPerfPair : N →ₗ[R] Dual R M) p) := by
  rw [Representation.symmetricAlgebra_apply, Representation.symmetricAlgebra_apply,
    ← AlgHom.comp_apply, ← AlgHom.comp_apply, SymmetricAlgebra.map_comp_map,
    SymmetricAlgebra.map_comp_map]
  congr 2
  exact LinearMap.ext (P.toPerfPair_flip_weylGroupCorootRep w)

/-- **A polynomial on `M` is Weyl invariant exactly when the corresponding element of `Sym N` is a
coroot invariant**, under the identification `N ≃ M*` of the perfect pairing. -/
theorem map_mem_symmetricAlgebraInvariants_weylGroupRootRep_dual_iff {p : SymmetricAlgebra R N} :
    SymmetricAlgebra.map R (P.toLinearMap.flip.toPerfPair : N →ₗ[R] Dual R M) p ∈
        P.weylGroupRootRep.dual.symmetricAlgebraInvariants ↔
      p ∈ P.weylGroupCorootRep.symmetricAlgebraInvariants := by
  simp only [Representation.mem_symmetricAlgebraInvariants]
  refine ⟨fun hp g ↦ ?_, fun hp w ↦ ?_⟩
  · obtain ⟨w, rfl⟩ := (Subgroup.equivOp P.weylGroup).surjective g
    refine (SymmetricAlgebra.mapEquiv R P.toLinearMap.flip.toPerfPair).injective ?_
    rw [SymmetricAlgebra.mapEquiv_apply, SymmetricAlgebra.mapEquiv_apply,
      P.map_toPerfPair_flip_symmetricAlgebra_weylGroupCorootRep, hp]
  · have h := P.map_toPerfPair_flip_symmetricAlgebra_weylGroupCorootRep w⁻¹ p
    rw [hp, inv_inv] at h
    exact h.symm

/-- **The coroot invariants are the Weyl invariant polynomials on `M`**: the identification
`Sym N ≃ Sym(M*)` induced by the perfect pairing carries `(Sym N)^W` onto `Sym(M*)^W`. -/
theorem map_symmetricAlgebraInvariants_weylGroupCorootRep :
    P.weylGroupCorootRep.symmetricAlgebraInvariants.map
        (SymmetricAlgebra.map R (P.toLinearMap.flip.toPerfPair : N →ₗ[R] Dual R M)) =
      P.weylGroupRootRep.dual.symmetricAlgebraInvariants := by
  refine le_antisymm (Subalgebra.map_le.mpr fun p hp ↦
    P.map_mem_symmetricAlgebraInvariants_weylGroupRootRep_dual_iff.mpr hp) fun q hq ↦ ?_
  have hq' : SymmetricAlgebra.map R (P.toLinearMap.flip.toPerfPair : N →ₗ[R] Dual R M)
      (SymmetricAlgebra.mapEquiv R P.toLinearMap.flip.toPerfPair.symm q) = q := by
    rw [← SymmetricAlgebra.mapEquiv_apply, ← SymmetricAlgebra.mapEquiv_symm,
      AlgEquiv.apply_symm_apply]
  exact ⟨_, P.map_mem_symmetricAlgebraInvariants_weylGroupRootRep_dual_iff.mp (by rwa [hq']), hq'⟩

/-- **The coroot invariants and the Weyl invariant polynomials on `M` are isomorphic**: the algebra
isomorphism `(Sym N)^W ≃ₐ[R] Sym(M*)^W` induced by the perfect pairing `N ≃ M*`. -/
noncomputable def weylGroupCorootRepInvariantsEquiv :
    P.weylGroupCorootRep.symmetricAlgebraInvariants ≃ₐ[R]
      P.weylGroupRootRep.dual.symmetricAlgebraInvariants :=
  ((SymmetricAlgebra.mapEquiv R P.toLinearMap.flip.toPerfPair).subalgebraMap _).trans
    (Subalgebra.equivOfEq _ _ (by
      rw [SymmetricAlgebra.mapEquiv_toAlgHom]
      exact P.map_symmetricAlgebraInvariants_weylGroupCorootRep))

/-- The isomorphism `RootPairing.weylGroupCorootRepInvariantsEquiv` is the map induced by the
perfect pairing `N ≃ M*`. -/
@[simp]
theorem coe_weylGroupCorootRepInvariantsEquiv_apply
    (p : P.weylGroupCorootRep.symmetricAlgebraInvariants) :
    (P.weylGroupCorootRepInvariantsEquiv p : SymmetricAlgebra R (Dual R M)) =
      SymmetricAlgebra.map R (P.toLinearMap.flip.toPerfPair : N →ₗ[R] Dual R M) p := by
  simp [weylGroupCorootRepInvariantsEquiv, AlgEquiv.subalgebraMap_apply_coe,
    Subalgebra.equivOfEq_apply, SymmetricAlgebra.mapEquiv_apply]

/-- The inverse of `RootPairing.weylGroupCorootRepInvariantsEquiv` is the map induced by the
inverse of the perfect pairing `N ≃ M*`. -/
@[simp]
theorem coe_weylGroupCorootRepInvariantsEquiv_symm_apply
    (q : P.weylGroupRootRep.dual.symmetricAlgebraInvariants) :
    (P.weylGroupCorootRepInvariantsEquiv.symm q : SymmetricAlgebra R N) =
      SymmetricAlgebra.map R (P.toLinearMap.flip.toPerfPair.symm : Dual R M →ₗ[R] N) q := by
  obtain ⟨p, rfl⟩ := P.weylGroupCorootRepInvariantsEquiv.surjective q
  simp [← SymmetricAlgebra.mapEquiv_apply, ← SymmetricAlgebra.mapEquiv_symm]

/-- **The isomorphism of invariants preserves degrees**: a coroot invariant is homogeneous of
degree `n` exactly when the corresponding Weyl invariant polynomial on `M` is. -/
theorem weylGroupCorootRepInvariantsEquiv_mem_homogeneousSubmodule_iff
    {p : P.weylGroupCorootRep.symmetricAlgebraInvariants} {n : ℕ} :
    (P.weylGroupCorootRepInvariantsEquiv p : SymmetricAlgebra R (Dual R M)) ∈
        homogeneousSubmodule R (Dual R M) n ↔
      (p : SymmetricAlgebra R N) ∈ homogeneousSubmodule R N n := by
  refine ⟨fun hp ↦ ?_, fun hp ↦ ?_⟩
  · have h := map_mem_homogeneousSubmodule
      (P.toLinearMap.flip.toPerfPair.symm : Dual R M →ₗ[R] N) hp
    rwa [← coe_weylGroupCorootRepInvariantsEquiv_symm_apply, AlgEquiv.symm_apply_apply] at h
  · rw [coe_weylGroupCorootRepInvariantsEquiv_apply]
    exact map_mem_homogeneousSubmodule _ hp

/-- **Basic invariants on `M` give basic invariants on the coroot space** with the same degrees: if
homogeneous Weyl invariants `f k ∈ Sym(M*)^W` of degrees `d k` are polynomial generators of
`Sym(M*)^W`, the corresponding coroot invariants are homogeneous of the same degrees and are
polynomial generators of `(Sym N)^W`. -/
theorem exists_bijective_aeval_weylGroupCorootRep_of_weylGroupRootRep_dual {κ : Type*}
    {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra R (Dual R M)) ∈ homogeneousSubmodule R (Dual R M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := R) f)) :
    ∃ g : κ → P.weylGroupCorootRep.symmetricAlgebraInvariants,
      (∀ k, (g k : SymmetricAlgebra R N) ∈ homogeneousSubmodule R N (d k)) ∧
        Function.Bijective (MvPolynomial.aeval (R := R) g) := by
  refine ⟨P.weylGroupCorootRepInvariantsEquiv.symm ∘ f, fun k ↦ ?_, ?_⟩
  · rw [Function.comp_apply, ← weylGroupCorootRepInvariantsEquiv_mem_homogeneousSubmodule_iff,
      AlgEquiv.apply_symm_apply]
    exact hf k
  · exact (MvPolynomial.bijective_aeval_algEquiv_comp_iff _).mpr hbij

end CommRing

section Field

variable {ι K M N : Type*} [Field K] [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]
  [FiniteDimensional K N] (P : RootPairing ι K M N)

/-- **Chevalley's theorem for the coroot representation.** If `2 ≠ 0` in `K`, `N` is
finite-dimensional, and `Nat.card P.weylGroup` is nonzero in `K`, then the invariants `(Sym N)^W`
of the Weyl group acting on the coroot space form a polynomial algebra on `finrank K N`
homogeneous invariants of positive degree. -/
theorem exists_bijective_aeval_weylGroupCorootRep [NeZero (2 : K)]
    (hcard : (Nat.card P.weylGroup : K) ≠ 0) :
    ∃ f : Fin (finrank K N) → P.weylGroupCorootRep.symmetricAlgebraInvariants,
      (∀ i, ∃ d, 0 < d ∧ (f i : SymmetricAlgebra K N) ∈ homogeneousSubmodule K N d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  have : FiniteDimensional K M := .equiv P.toLinearMap.toPerfPair.symm
  have hNM : finrank K N = finrank K M :=
    P.toLinearMap.flip.toPerfPair.finrank_eq.trans Subspace.dual_finrank_eq
  obtain ⟨f, hf, hbij⟩ := P.exists_bijective_aeval_weylGroupRootRep_dual hcard
  choose d hd hfd using hf
  obtain ⟨g, hg, hgbij⟩ :=
    P.exists_bijective_aeval_weylGroupCorootRep_of_weylGroupRootRep_dual hfd hbij
  -- Reindex the generators by `Fin (dim N)`, using `dim N = dim M`.
  let e := finCongr hNM
  exact ⟨g ∘ e, fun i ↦ ⟨d (e i), hd (e i), hg (e i)⟩,
    (MvPolynomial.bijective_aeval_comp_equiv_iff e).mpr hgbij⟩

/-- **Chevalley's theorem for the coroot representation in characteristic zero**, for a finite
reduced crystallographic root pairing with a base. -/
theorem exists_bijective_aeval_weylGroupCorootRep_of_base [CharZero K] [Finite ι]
    [P.IsCrystallographic] [P.IsReduced] (b : P.Base) :
    ∃ f : Fin (finrank K N) → P.weylGroupCorootRep.symmetricAlgebraInvariants,
      (∀ i, ∃ d, 0 < d ∧ (f i : SymmetricAlgebra K N) ∈ homogeneousSubmodule K N d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  let _ : Finite P.weylGroup := P.finite_weylGroup_of_base b
  exact P.exists_bijective_aeval_weylGroupCorootRep (Nat.cast_ne_zero.mpr Nat.card_pos.ne')

end Field

end RootPairing
