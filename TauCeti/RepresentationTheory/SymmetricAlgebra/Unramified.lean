module

public import Mathlib.Algebra.Algebra.Subalgebra.Operations
public import TauCeti.RepresentationTheory.SymmetricAlgebra.Inertia
public import TauCeti.RingTheory.Invariant.Unramified

/-!
# Unramifiedness of the residual pseudoreflection quotient

Let `G` act faithfully on a finite-dimensional vector space `V` over an infinite field `K`,
and let `H` be the normal subgroup generated by its pseudoreflections. The intermediate algebra
`Sym(V*)^H` is unramified over `Sym(V*)^G` at every height-one prime. This supplies the
codimension-one unramifiedness of the residual finite quotient `V/H → V/G`.

The inertia computation in `TauCeti.RepresentationTheory.SymmetricAlgebra.Inertia` says that
`G ⧸ H` has trivial inertia at each such prime. Applying
`Ideal.isUnramifiedAt_of_inertia_eq_bot` turns that group-theoretic conclusion into the vanishing
of local Kähler differentials. No polynomiality assumption on either invariant ring is used.

## References

* R. Kane, *Reflection Groups and Invariant Theory*, Springer (2001), § 18.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), § 7.4.
-/

public section

namespace Representation

variable {K G V : Type*} [Field K] [Infinite K] [Group G] [Finite G]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]

/-- The residual quotient by the pseudoreflection subgroup is unramified at every height-one
prime. The base is the full invariant algebra `Sym(V*)^G`, and the source is `Sym(V*)^H`, where
`H` is generated by the pseudoreflections. No polynomial presentation or characteristic-zero
assumption is required. -/
theorem isUnramifiedAt_quotient_pseudoreflectionSubgroup_of_height_eq_one
    (ρ : Representation K G V) (hρ : Function.Injective ρ) :
    letI := ρ.dual.symmetricAlgebraMulSemiringAction
    letI := ρ.dual.smulCommClass_symmetricAlgebraMulSemiringAction
    let A := FixedPoints.subalgebra K (SymmetricAlgebra K (Module.Dual K V)) G
    let : CommRing A := A.toCommRing
    let B := FixedPoints.subalgebra A (SymmetricAlgebra K (Module.Dual K V))
      ρ.pseudoreflectionSubgroup
    let : CommRing B := B.toCommRing
    ∀ (P : Ideal B) [P.IsPrime], P.height = 1 → Algebra.IsUnramifiedAt A P := by
  let := ρ.dual.symmetricAlgebraMulSemiringAction
  have := ρ.dual.smulCommClass_symmetricAlgebraMulSemiringAction
  let A := FixedPoints.subalgebra K (SymmetricAlgebra K (Module.Dual K V)) G
  let : CommRing A := A.toCommRing
  let B := FixedPoints.subalgebra A (SymmetricAlgebra K (Module.Dual K V))
    ρ.pseudoreflectionSubgroup
  let : CommRing B := B.toCommRing
  -- Fix the ring instances explicitly to keep elaboration of the nested fixed algebras small.
  dsimp only
  intro P _ hP
  apply Ideal.isUnramifiedAt_of_inertia_eq_bot (A := B) (R := A) P (k := K)
    (G := G ⧸ ρ.pseudoreflectionSubgroup)
  -- Changing the scalar base of a fixed subalgebra leaves its carrier and ring operations
  -- unchanged; name that ideal to reuse the inertia theorem over the original coefficient field.
  let P' : Ideal (FixedPoints.subalgebra K (SymmetricAlgebra K (Module.Dual K V))
    ρ.pseudoreflectionSubgroup) := P
  have : P'.IsPrime := ‹P.IsPrime›
  exact ρ.inertia_quotient_pseudoreflectionSubgroup_eq_bot hρ P' hP

end Representation
