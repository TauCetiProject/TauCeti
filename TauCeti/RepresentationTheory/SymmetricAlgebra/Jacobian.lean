module

public import Mathlib.LinearAlgebra.FixedSubmodule
public import TauCeti.LinearAlgebra.SymmetricAlgebra.Derivation.Ramification
public import TauCeti.RepresentationTheory.SymmetricAlgebra.Basic
import TauCeti.RepresentationTheory.Dual

/-!
# The Jacobian of a system of invariants

Let a group `G` act linearly on a free module `M` of finite rank over a commutative ring `R`, and
so on the symmetric algebra `Sym M`, with invariant subalgebra `Sym(M)^G`. Fix a basis `b` of `M`
and a family `f` of invariants indexed like `b`, for instance a system of basic invariants. The
Jacobian `J = det (∂ (f i) / ∂ (b j))` (`SymmetricAlgebra.jacobian`) has two basic properties.

* It is a relative invariant: each `g` multiplies it by `det (ρ g)⁻¹`. This is the chain rule,
  since the `f i` are fixed by `g`. For the polynomial functions `Sym(V*)` on a module `V`, acted
  on through the contragredient representation `ρ.dual`, the character is `det (ρ g)` itself:
  `g • J = det (ρ g) • J`. In particular a reflection, of determinant `-1`, negates `J`.
* For a finite group over a domain of characteristic zero, if the `f i` generate the invariant
  subalgebra, then `J ≠ 0`: `Sym M` is integral over its invariants
  (`Representation.isIntegral_symmetricAlgebraInvariants`), so the Jacobian criterion
  `SymmetricAlgebra.jacobian_ne_zero` applies.

For a finite group generated by pseudoreflections, acting on a finite-dimensional vector space
`V` over a field of characteristic zero, the Chevalley–Shephard–Todd theorem
(`exists_bijective_aeval_symmetricAlgebraInvariants_dual_of_pseudoreflectionSubgroup_eq_top`, in
the namespace `Representation`) supplies such generators of `Sym(V*)^G`, homogeneous of degrees
`dᵢ`; their Jacobian is then a nonzero relative invariant of degree `∑ (dᵢ - 1)`
(`SymmetricAlgebra.jacobian_mem_homogeneousSubmodule`). It is the starting point of the
identification of `J` with the product of the linear forms of the reflecting hyperplanes, each
raised to the order of its pointwise stabilizer minus one.

## Main results

* `Representation.symmetricAlgebra_apply_jacobian`: the Jacobian of invariants is a relative
  invariant of character `g ↦ det (ρ g⁻¹)`.
* `Representation.dual_symmetricAlgebra_apply_jacobian`: for polynomial functions on `V`, the
  Jacobian of invariants is a relative invariant of character `g ↦ det (ρ g)`.
* `Representation.dual_ι_pow_sub_one_dvd_jacobian`: if `g` fixes `ker ℓ` pointwise and
  its determinant has order `e`, then `ℓ ^ (e - 1)` divides the Jacobian.
* `Representation.jacobian_ne_zero_of_surjective_aeval`: in characteristic zero, the Jacobian of
  a generating family of the invariants of a finite group is nonzero.

## References

* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press (1990),
  Chapter 3 (the Jacobian criterion, and the Jacobian of a system of basic invariants).
-/

public section

open SymmetricAlgebra

namespace Representation

variable {R G M : Type*} [CommRing R] [Group G] [AddCommGroup M] [Module R M]
variable (ρ : Representation R G M) {n : Type*} [Fintype n] [DecidableEq n]

/-- **The Jacobian of invariants is a relative invariant.** If every `f i` is invariant, then `g`
multiplies the Jacobian of `f` by `det (ρ g⁻¹) = det (ρ g)⁻¹`. -/
theorem symmetricAlgebra_apply_jacobian (b : Module.Basis n R M) {f : n → SymmetricAlgebra R M}
    (hf : ∀ i, f i ∈ ρ.symmetricAlgebraInvariants) (g : G) :
    ρ.symmetricAlgebra g (jacobian b f) =
      algebraMap R _ (LinearMap.det (ρ g⁻¹)) * jacobian b f := by
  have hg (i : n) : map R (ρ g) (f i) = f i := by
    rw [← symmetricAlgebra_apply, (ρ.mem_symmetricAlgebraInvariants _).1 (hf i) g]
  conv_rhs => rw [← algebraMap_det_mul_map_jacobian b hg]
  simp [symmetricAlgebra_apply, ← mul_assoc, ← map_mul]

/-- **The Jacobian of invariant polynomial functions is a relative invariant.** For polynomial
functions `Sym(V*)` on `V`, acted on through the contragredient representation, if every `f i` is
invariant, then `g` multiplies the Jacobian of `f` by `det (ρ g)`. -/
theorem dual_symmetricAlgebra_apply_jacobian [Module.Free R M] [Module.Finite R M]
    (b : Module.Basis n R (Module.Dual R M)) {f : n → SymmetricAlgebra R (Module.Dual R M)}
    (hf : ∀ i, f i ∈ ρ.dual.symmetricAlgebraInvariants) (g : G) :
    ρ.dual.symmetricAlgebra g (jacobian b f) =
      algebraMap R _ (LinearMap.det (ρ g)) * jacobian b f := by
  rw [ρ.dual.symmetricAlgebra_apply_jacobian b hf, dual_apply, inv_inv]
  congr 2
  exact LinearMap.det_dualMap (ρ g)

/-- **The Jacobian of generating invariants is nonzero.** For a finite group acting on a free
module over a domain of characteristic zero, if a family `f` of invariants, indexed like the
basis `b`, generates the invariant subalgebra, then its Jacobian is nonzero. This applies to a
system of basic invariants. -/
theorem jacobian_ne_zero_of_surjective_aeval [IsDomain R] [CharZero R] [Finite G]
    (b : Module.Basis n R M) {f : n → ρ.symmetricAlgebraInvariants}
    (hf : Function.Surjective (MvPolynomial.aeval (R := R) f)) :
    jacobian b (fun i ↦ (f i : SymmetricAlgebra R M)) ≠ 0 := by
  have hA : Algebra.adjoin R (Set.range fun i ↦ (f i : SymmetricAlgebra R M)) =
      ρ.symmetricAlgebraInvariants := by
    refine le_antisymm (Algebra.adjoin_le (Set.range_subset_iff.2 fun i ↦ (f i).2))
      fun x hx ↦ ?_
    obtain ⟨p, hp⟩ := hf ⟨x, hx⟩
    rw [Algebra.adjoin_range_eq_range_aeval]
    exact ⟨p, (DFunLike.congr_fun (MvPolynomial.comp_aeval (f := f)
      ρ.symmetricAlgebraInvariants.val) p).symm.trans (congrArg Subtype.val hp)⟩
  refine jacobian_ne_zero b fun j ↦ ?_
  rw [hA]
  exact (Algebra.IsIntegral.isIntegral _).isAlgebraic

section Field

variable {K G V : Type*} [Field K] [Group G] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] (ρ : Representation K G V)
  {n : Type*} [Fintype n] [DecidableEq n]

/-- **The hyperplane multiplicity in the Jacobian.** If `g` fixes the kernel `ker ℓ`
pointwise and `det (ρ g)` is a primitive `e`-th root of unity, then
`ℓ ^ (e - 1)` divides the Jacobian of every family of invariant polynomial functions.
For `ℓ ≠ 0` the kernel is a hyperplane and this is its multiplicity in the Jacobian; for
`ℓ = 0` the kernel is the whole space, so `g` is the identity, `e = 1`, and the statement is
trivial. This applies to a generator of the cyclic pointwise stabilizer, with `e` the order
of its determinant character; no order-two assumption is made. -/
theorem dual_ι_pow_sub_one_dvd_jacobian (b : Module.Basis n K (Module.Dual K V))
    {g : G} {ℓ : Module.Dual K V}
    (hfix : LinearMap.ker ℓ ≤ (ρ g).fixedSubmodule)
    {e : ℕ} (he : 0 < e) (hζ : IsPrimitiveRoot (LinearMap.det (ρ g)) e)
    {f : n → SymmetricAlgebra K (Module.Dual K V)}
    (hf : ∀ i, f i ∈ ρ.dual.symmetricAlgebraInvariants) :
    ι K (Module.Dual K V) ℓ ^ (e - 1) ∣ jacobian b f := by
  by_cases hℓ : ℓ = 0
  · have hg : ρ g = LinearMap.id := by
      rw [← LinearMap.fixedSubmodule_eq_top_iff, eq_top_iff]
      simpa only [hℓ, LinearMap.ker_zero] using hfix
    rw [hg, LinearMap.det_id] at hζ
    rw [IsPrimitiveRoot.one_left_iff.1 hζ]
    simp
  apply ι_pow_sub_one_dvd_jacobian b hℓ
    (ρ.sub_dual_apply_mem_span_singleton (by
      simpa only [LinearMap.fixedSubmodule_eq_ker, Module.End.one_eq_id] using hfix)) he
  · rw [dual_apply, ← LinearMap.dualMap_def, LinearMap.det_dualMap]
    have hinv : LinearMap.det (ρ g⁻¹) = (LinearMap.det (ρ g))⁻¹ :=
      map_inv (LinearMap.det.comp ρ) g
    rw [hinv]
    exact hζ.inv
  · intro i
    rw [← symmetricAlgebra_apply]
    exact (ρ.dual.mem_symmetricAlgebraInvariants _).1 (hf i) g

end Field

end Representation
