/-!
# The group order and the number of pseudoreflections from the degrees

Let a finite group `G` act faithfully and linearly on a finite-dimensional vector space `M` over a
field `K` of characteristic zero, and suppose that the invariant subalgebra `Sym(M)^G` is a
polynomial algebra on homogeneous invariants `f₁, …, fₙ` of degrees `d₁, …, dₙ`, so that
`n = dim M`. By the Chevalley–Shephard–Todd theorem this is the case whenever `G` is generated by
pseudoreflections. Then

* `∏ᵢ dᵢ = |G|`;
* `∑ᵢ dᵢ = n + N`, where `N` is the number of pseudoreflections of `G`, the elements whose fixed
  space in `M` is a hyperplane. Equivalently, the exponents `dᵢ - 1` add up to `N`.

For a finite real reflection group, `N` is the number of reflections; it is the number of elements
`g ∈ G` that are reflections, not the number of reflecting hyperplanes.

The proof compares two expressions for the Hilbert series of the invariants. By Molien's formula
it is `|G|⁻¹ ∑_g det(1 - t g)⁻¹`, and since the invariants are a polynomial algebra it is
`∏ᵢ (1 - t ^ dᵢ)⁻¹`. In characteristic zero each `g` is semisimple, so `det(1 - t g)` is
`(1 - t) ^ m_g` times a polynomial not vanishing at `t = 1`, where `m_g` is the dimension of the
fixed space of `g`. Multiplying out the denominators gives a polynomial identity which is then
studied at `t = 1`. Only `g = 1` contributes a pole of the maximal order `n`, which gives the
product formula; the pseudoreflections are the elements contributing poles of order `n - 1`, and
comparing the next coefficient gives `∑ᵢ (dᵢ - 1) / 2 = ∑ (1 - det g)⁻¹`, the sum running over the
pseudoreflections. Pairing each pseudoreflection with its inverse, which has the inverse
determinant, shows that the right-hand side is `N / 2`.

Taking `M = V*` with the contragredient representation gives the formulas for the degrees of the
polynomial functions on a representation `V`: the contragredient representation is faithful
exactly when `ρ` is, and it has the same pseudoreflections, so `N` may be counted on `V` itself.

## Main results

* `Representation.prod_eq_card_of_bijective_aeval_symmetricAlgebraInvariants`: the product of the
  degrees of a system of basic invariants is the order of the group.
* `Representation.sum_eq_finrank_add_card_of_bijective_aeval_symmetricAlgebraInvariants`: the sum
  of the degrees is the dimension plus the number of pseudoreflections.
* `Representation.sum_eq_finrank_add_card_of_bijective_aeval_symmetricAlgebraInvariants_dual`: the
  same for the polynomial functions `Sym(M*)`, with the pseudoreflections counted on `M`.

## References

* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press (1990),
  Sections 3.8–3.9.
-/

public section

open TauCeti.SymmetricAlgebra Polynomial Module

namespace Representation

variable {K G M ι : Type*} [Field K] [Group G] [AddCommGroup M] [Module K M]
  [FiniteDimensional K M] (ρ : Representation K G M)

section Cofactor

variable [Fintype G] (hG : (Fintype.card G : K) ≠ 0)
include hG

/-- When `#G` is invertible, `ρ g` is semisimple, so the multiplicity of `1` as a root of its
characteristic polynomial is the dimension of its fixed space. -/
private theorem rootMultiplicity_one_charpoly (g : G) :
    (ρ g).charpoly.rootMultiplicity 1 = finrank K (ρ g).fixedSubmodule := by
  have hss : Module.End.IsSemisimple (ρ g) :=
    Module.End.isSemisimple_of_pow_eq_one hG (by rw [← map_pow, pow_card_eq_one, map_one])
  have hfix : Module.End.eigenspace (ρ g) 1 = (ρ g).fixedSubmodule := by
    ext v
    simp
  rw [← hfix, hss.isFinitelySemisimple.finrank_eigenspace_eq_rootMultiplicity]

omit hG in
/-- The characteristic polynomial of `ρ g` divided by `(X - 1) ^ m`, where `m` is the dimension of
the fixed space of `ρ g`. -/
private noncomputable def cofactor (g : G) : K[X] :=
  (ρ g).charpoly /ₘ (X - C 1) ^ finrank K (ρ g).fixedSubmodule

private theorem charpoly_eq_mul_cofactor (g : G) :
    (ρ g).charpoly = (X - C 1) ^ finrank K (ρ g).fixedSubmodule * ρ.cofactor g := by
  rw [cofactor, ← ρ.rootMultiplicity_one_charpoly hG, pow_mul_divByMonic_rootMultiplicity_eq]

private theorem monic_cofactor (g : G) : (ρ.cofactor g).Monic :=
  ((monic_X_sub_C 1).pow _).of_mul_monic_left <| by
    rw [← ρ.charpoly_eq_mul_cofactor hG]
    exact (ρ g).charpoly_monic

private theorem eval_one_cofactor_ne_zero (g : G) : (ρ.cofactor g).eval 1 ≠ 0 := by
  rw [cofactor, ← ρ.rootMultiplicity_one_charpoly hG]
  exact eval_divByMonic_pow_rootMultiplicity_ne_zero 1 (ρ g).charpoly_monic.ne_zero

/-- The cofactor has degree the codimension of the fixed space. -/
private theorem natDegree_cofactor (g : G) :
    (ρ.cofactor g).natDegree = finrank K (M ⧸ (ρ g).fixedSubmodule) := by
  have h := congrArg natDegree (ρ.charpoly_eq_mul_cofactor hG g)
  rw [((monic_X_sub_C 1).pow _).natDegree_mul (ρ.monic_cofactor hG g), natDegree_pow,
    natDegree_X_sub_C, mul_one, (ρ g).charpoly_natDegree,
    ← (ρ g).fixedSubmodule.finrank_quotient_add_finrank] at h
  omega

omit [Fintype G] hG in
/-- The fixed space of `ρ g` has codimension zero exactly when `ρ g = 1`. -/
private theorem finrank_quotient_fixedSubmodule_eq_zero_iff (g : G) :
    finrank K (M ⧸ (ρ g).fixedSubmodule) = 0 ↔ ρ g = 1 := by
  have h := (ρ g).fixedSubmodule.finrank_quotient_add_finrank
  refine ⟨fun h0 ↦ LinearMap.ext fun v ↦ ?_, fun h1 ↦ ?_⟩
  · rw [h0, zero_add] at h
    exact LinearMap.mem_fixedSubmodule_iff.mp (Submodule.eq_top_of_finrank_eq h ▸ Submodule.mem_top)
  · rw [LinearMap.fixedSubmodule_eq_top_iff.mpr h1]
    exact finrank_zero_of_subsingleton

/-- The cofactor of the identity is `1`. -/
private theorem cofactor_one : ρ.cofactor 1 = 1 :=
  eq_one_of_monic_natDegree_zero (ρ.monic_cofactor hG 1) <| by
    rw [ρ.natDegree_cofactor hG, ρ.finrank_quotient_fixedSubmodule_eq_zero_iff, map_one]

/-- For a pseudoreflection `g`, the cofactor is `X - det (ρ g)`, so its value at `1` is
`1 - det (ρ g)`. -/
private theorem eval_one_cofactor_of_finrank_quotient_eq_one {g : G}
    (hg : finrank K (M ⧸ (ρ g).fixedSubmodule) = 1) :
    (ρ.cofactor g).eval 1 = 1 - LinearMap.det (ρ g) := by
  have hX := (ρ.monic_cofactor hG g).eq_X_add_C ((ρ.natDegree_cofactor hG g).trans hg)
  have hn := (ρ g).fixedSubmodule.finrank_quotient_add_finrank
  have hdet := LinearMap.det_eq_sign_charpoly_coeff (ρ g)
  rw [ρ.charpoly_eq_mul_cofactor hG, hX, coeff_zero_eq_eval_zero, ← hn, hg] at hdet
  have h2 : ((-1 : K) ^ finrank K (ρ g).fixedSubmodule) ^ 2 = 1 := by
    rw [← pow_mul, pow_mul', neg_one_sq, one_pow]
  rw [hX, hdet]
  simp only [eval_mul, eval_pow, eval_sub, eval_add, eval_X, eval_C]
  linear_combination (-(ρ.cofactor g).coeff 0) * h2

end Cofactor

section Identity

variable [Fintype G] [Fintype ι] {f : ι → ρ.symmetricAlgebraInvariants} {d : ι → ℕ}

/-- **Molien's formula with cleared denominators.** If the invariants are a polynomial algebra
on homogeneous invariants of degrees `d i`, then, writing `[d] = 1 + X + ⋯ + X ^ (d - 1)` and
`qₕ` for the reversed cofactor of `ρ h`,
`#G * ∏ₕ qₕ = ∑_g (1 - X) ^ (codim of the fixed space of g) * ∏ᵢ [d i] * ∏_{h ≠ g} qₕ`. -/
private theorem natCast_card_mul_prod_reverse_cofactor [DecidableEq G]
    (hG : (Fintype.card G : K) ≠ 0)
    (hf : ∀ i, (f i : SymmetricAlgebra K M) ∈ homogeneousSubmodule K M (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    (Fintype.card G : K[X]) * ∏ g, (ρ.cofactor g).reverse =
      ∑ g, (1 - X) ^ finrank K (M ⧸ (ρ g).fixedSubmodule) *
        ((∏ i, ∑ j ∈ Finset.range (d i), X ^ j) * ∏ h ∈ Finset.univ.erase g,
          (ρ.cofactor h).reverse) := by
  let := invertibleOfNonzero hG
  set F : K[X] := ∏ i, ∑ j ∈ Finset.range (d i), X ^ j
  have hn : Fintype.card ι = finrank K M := by
    rw [← Nat.card_eq_fintype_card]
    exact ρ.card_eq_finrank_of_bijective_aeval_symmetricAlgebraInvariants hbij
  have hF : ∏ i, (1 - X ^ d i : K[X]) = (1 - X) ^ finrank K M * F := by
    rw [← hn, ← Finset.card_univ, ← Finset.prod_const, ← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl fun i _ ↦ (mul_neg_geom_sum X (d i)).symm
  -- Each reversed characteristic polynomial is the term of `g` times `∏ᵢ (1 - X ^ d i) * Q`.
  have hterm (g : G) : (∏ i, (1 - X ^ d i : K[X])) * ∏ h, (ρ.cofactor h).reverse =
      ((1 - X) ^ finrank K (M ⧸ (ρ g).fixedSubmodule) *
        (F * ∏ h ∈ Finset.univ.erase g, (ρ.cofactor h).reverse)) * (ρ g).charpoly.reverse := by
    rw [hF, ρ.charpoly_eq_mul_cofactor hG, reverse_mul (by
        rw [((monic_X_sub_C (1 : K)).pow _).leadingCoeff, (ρ.monic_cofactor hG g).leadingCoeff,
          one_mul]
        exact one_ne_zero),
      reverse_X_sub_C_pow, C_1, one_mul, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ g),
      ← (ρ g).fixedSubmodule.finrank_quotient_add_finrank]
    ring
  -- In `K⟦X⟧`, Molien's formula and `Hilb * ∏ᵢ (1 - X ^ d i) = 1` give the identity.
  have hdeg :=
    mk_finrank_symmetricAlgebraInvariants_inf_homogeneousSubmodule_mul_prod_one_sub_X_pow ρ K
      hf hbij
  rw [ρ.mk_finrank_symmetricAlgebraInvariants_inf_homogeneousSubmodule_eq_sum_inv_reverse_charpoly]
    at hdeg
  -- Work with the coercion `K[X] → K⟦X⟧` as a ring homomorphism `φ`.
  set φ : K[X] →+* PowerSeries K := Polynomial.coeToPowerSeries.ringHom
  have hφ (p : K[X]) : (p : PowerSeries K) = φ p := coeToPowerSeries.ringHom_apply.symm
  set S := ∑ g, (φ (ρ g).charpoly.reverse)⁻¹
  have hP : φ (∏ i, (1 - X ^ d i)) = ∏ i, (1 - PowerSeries.X ^ d i) := by
    simp [φ, map_prod]
  simp only [hφ] at hdeg
  have hinv (g : G) : (φ (ρ g).charpoly.reverse)⁻¹ * φ (ρ g).charpoly.reverse = 1 :=
    PowerSeries.inv_mul_cancel _ <| by
      simp [φ, Polynomial.coeff_zero_reverse, (LinearMap.charpoly_monic (ρ g)).leadingCoeff]
  have hS : φ (Fintype.card G) * (⅟(Fintype.card G : K) • S) = S := by
    rw [PowerSeries.smul_eq_C_mul, ← mul_assoc, map_natCast, ← map_natCast PowerSeries.C,
      ← map_mul, mul_invOf_self, map_one, one_mul]
  refine Polynomial.coe_injective K ?_
  rw [hφ, hφ, map_mul, ← mul_one (φ _ * _), ← hdeg, ← hP, mul_right_comm, ← mul_assoc, hS,
    mul_assoc, ← map_mul, Finset.sum_mul, map_sum]
  refine Finset.sum_congr rfl fun g _ ↦ ?_
  rw [hterm g, map_mul, mul_comm (φ (_ * _)), ← mul_assoc, hinv, one_mul]

end Identity

section Pseudoreflection

variable [Fintype G]

/-- **Pairing a pseudoreflection with its inverse.** The pseudoreflections are closed under
inversion, and `det (ρ g⁻¹) = (det (ρ g))⁻¹`, so the sum of `(1 - det (ρ g))⁻¹` over the
pseudoreflections is half their number, because `(1 - λ)⁻¹ + (1 - λ⁻¹)⁻¹ = 1` for `λ ≠ 0, 1`. -/
private theorem two_mul_sum_inv_one_sub_det (hG : (Fintype.card G : K) ≠ 0) :
    2 * ∑ g ∈ Finset.univ.filter fun g ↦ finrank K (M ⧸ (ρ g).fixedSubmodule) = 1,
        (1 - LinearMap.det (ρ g))⁻¹ =
      (Finset.univ.filter fun g ↦ finrank K (M ⧸ (ρ g).fixedSubmodule) = 1).card := by
  classical
  set R := Finset.univ.filter fun g ↦ finrank K (M ⧸ (ρ g).fixedSubmodule) = 1
  have hdet (g : G) : LinearMap.det (ρ g⁻¹) * LinearMap.det (ρ g) = 1 := by
    rw [← map_mul, ← map_mul, inv_mul_cancel, map_one, map_one]
  have hinv : ∑ g ∈ R, (1 - LinearMap.det (ρ g))⁻¹ =
      ∑ g ∈ R, (1 - LinearMap.det (ρ g⁻¹))⁻¹ :=
    Finset.sum_equiv (Equiv.inv G) (fun g ↦ by
      simp only [R, Finset.mem_filter, Finset.mem_univ, true_and, Equiv.inv_apply]
      rw [ρ.fixedSubmodule_inv]) (by simp)
  rw [two_mul]
  nth_rw 2 [hinv]
  rw [← Finset.sum_add_distrib, Finset.card_eq_sum_ones, Nat.cast_sum, Nat.cast_one]
  refine Finset.sum_congr rfl fun g hg ↦ ?_
  have h1 : 1 - LinearMap.det (ρ g) ≠ 0 := by
    rw [← ρ.eval_one_cofactor_of_finrank_quotient_eq_one hG (Finset.mem_filter.mp hg).2]
    exact ρ.eval_one_cofactor_ne_zero hG g
  have h0 : LinearMap.det (ρ g) ≠ 0 := right_ne_zero_of_mul_eq_one (hdet g)
  have h2 : LinearMap.det (ρ g) - 1 ≠ 0 := by rwa [← neg_sub, neg_ne_zero]
  rw [eq_inv_of_mul_eq_one_left (hdet g), show 1 - (LinearMap.det (ρ g))⁻¹ =
    (LinearMap.det (ρ g) - 1) / LinearMap.det (ρ g) by field_simp, inv_div]
  field_simp
  ring

end Pseudoreflection

section Private

variable [CharZero K] [Fintype G] [Fintype ι] {f : ι → ρ.symmetricAlgebraInvariants} {d : ι → ℕ}

/-- Evaluation at `1` does not see the reversal of a polynomial. -/
private theorem eval_one_reverse (p : K[X]) : p.reverse.eval 1 = p.eval 1 := by
  simpa using p.eval_reverse_of_ne_zero (one_ne_zero (α := K))

/-- **The product of the degrees, in `K`.** -/
private theorem natCast_card_eq_prod (hρ : Function.Injective ρ)
    (hf : ∀ i, (f i : SymmetricAlgebra K M) ∈ homogeneousSubmodule K M (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    (Fintype.card G : K) = ∏ i, (d i : K) := by
  classical
  have hG : (Fintype.card G : K) ≠ 0 := Nat.cast_ne_zero.2 Fintype.card_ne_zero
  have h := congrArg (eval 1) (ρ.natCast_card_mul_prod_reverse_cofactor hG hf hbij)
  simp only [eval_mul, eval_natCast, eval_prod, eval_finsetSum, eval_pow, eval_sub, eval_one,
    eval_X, sub_self, one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one,
    eval_one_reverse] at h
  rw [Finset.sum_eq_single 1 (fun g _ hg ↦ by
      rw [zero_pow (mt (ρ.finrank_quotient_fixedSubmodule_eq_zero_iff g).mp
        (fun h1 ↦ hg (hρ (h1.trans (map_one ρ).symm)))), zero_mul]) (by simp),
    (ρ.finrank_quotient_fixedSubmodule_eq_zero_iff 1).mpr (map_one ρ), pow_zero, one_mul,
    ← Finset.mul_prod_erase _ _ (Finset.mem_univ 1), ρ.cofactor_one hG, eval_one, one_mul] at h
  exact mul_right_cancel₀ (Finset.prod_ne_zero_iff.mpr fun g _ ↦ ρ.eval_one_cofactor_ne_zero hG g) h

omit [CharZero K] in
/-- The logarithmic derivative at `1` of `∏ᵢ [d i]`, where `[d] = 1 + X + ⋯ + X ^ (d - 1)`:
twice the derivative at `1` is `∏ᵢ d i * ∑ᵢ (d i - 1)`. -/
private theorem two_mul_eval_one_derivative_prod_geom_sum (d : ι → ℕ) :
    2 * (derivative (∏ i, ∑ j ∈ Finset.range (d i), (X : K[X]) ^ j)).eval 1 =
      (∏ i, (d i : K)) * ∑ i, ((d i : K) - 1) := by
  classical
  have hgeom (n : ℕ) :
      2 * (derivative (∑ j ∈ Finset.range n, (X : K[X]) ^ j)).eval 1 = n * (n - 1) := by
    induction n with
    | zero => simp
    | succ n ih =>
      rw [Finset.sum_range_succ, derivative_add, eval_add, mul_add, ih]
      simp only [derivative_X_pow, eval_mul, eval_C, eval_pow, eval_X, one_pow, mul_one]
      push_cast
      ring
  have heval (n : ℕ) : (∑ j ∈ Finset.range n, (X : K[X]) ^ j).eval 1 = n := by
    simp [eval_finsetSum]
  rw [derivative_prod_finset, eval_finsetSum, Finset.mul_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [eval_mul, mul_left_comm, hgeom, eval_prod, ← Finset.mul_prod_erase _ (fun j ↦ (d j : K))
    (Finset.mem_univ i)]
  simp only [heval]
  ring

/-- **The sum of the exponents, in `K`.** -/
private theorem sum_natCast_sub_one_eq (hρ : Function.Injective ρ)
    (hf : ∀ i, (f i : SymmetricAlgebra K M) ∈ homogeneousSubmodule K M (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∑ i, ((d i : K) - 1) =
      (Finset.univ.filter fun g ↦ finrank K (M ⧸ (ρ g).fixedSubmodule) = 1).card := by
  classical
  have hG : (Fintype.card G : K) ≠ 0 := Nat.cast_ne_zero.2 Fintype.card_ne_zero
  set R := Finset.univ.filter fun g ↦ finrank K (M ⧸ (ρ g).fixedSubmodule) = 1
  have hD := ρ.natCast_card_eq_prod hρ hf hbij
  have hP : ∏ g, (ρ.cofactor g).eval 1 ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun g _ ↦ ρ.eval_one_cofactor_ne_zero hG g
  have hk0 (g : G) : finrank K (M ⧸ (ρ g).fixedSubmodule) = 0 ↔ g = 1 :=
    (ρ.finrank_quotient_fixedSubmodule_eq_zero_iff g).trans
      ⟨fun h ↦ hρ (h.trans (map_one ρ).symm), fun h ↦ h ▸ map_one ρ⟩
  -- The derivative at `1` of the term of `g` only sees elements of codimension `0` or `1`.
  have hd (k : ℕ) (W : K[X]) : (derivative ((1 - X) ^ k * W)).eval 1 =
      (if k = 0 then (derivative W).eval 1 else 0) - if k = 1 then W.eval 1 else 0 := by
    rcases k with _ | _ | k <;> simp [derivative_mul, derivative_pow]
  have h := congrArg (fun p ↦ (derivative p).eval 1)
    (ρ.natCast_card_mul_prod_reverse_cofactor hG hf hbij)
  simp only [derivative_natCast_mul, eval_mul, eval_natCast, derivative_sum, eval_finsetSum] at h
  simp only [hd] at h
  simp only [Finset.sum_sub_distrib, hk0, Finset.sum_ite_eq', Finset.mem_univ, ite_true,
    ← Finset.sum_filter] at h
  rw [Finset.prod_erase _ (by rw [ρ.cofactor_one hG, ← C_1, reverse_C])] at h
  simp only [derivative_mul, eval_add, eval_mul, eval_prod, eval_one_reverse, eval_finsetSum,
    eval_pow, eval_X, one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one] at h
  -- `h` reads `#G * Q'(1) = F'(1) Q(1) + F(1) Q'(1) - ∑_{g ∈ R} F(1) ∏_{h ≠ g} e h`, where
  -- `e h` is the value of the cofactor of `h` at `1`, and `F(1) = #G`.
  have hR (g : G) (hg : g ∈ R) : (∏ i, (d i : K)) *
      ∏ h ∈ Finset.univ.erase g, (ρ.cofactor h).eval 1 =
        (∏ i, (d i : K)) * (∏ h, (ρ.cofactor h).eval 1) * (1 - LinearMap.det (ρ g))⁻¹ := by
    rw [← ρ.eval_one_cofactor_of_finrank_quotient_eq_one hG (Finset.mem_filter.mp hg).2,
      ← Finset.mul_prod_erase _ _ (Finset.mem_univ g), mul_assoc, mul_comm ((ρ.cofactor g).eval 1),
      mul_assoc, mul_inv_cancel₀ (ρ.eval_one_cofactor_ne_zero hG g), mul_one]
  rw [Finset.sum_congr rfl hR, ← Finset.mul_sum, ← hD] at h
  have h2 := two_mul_eval_one_derivative_prod_geom_sum (K := K) d
  have h3 := ρ.two_mul_sum_inv_one_sub_det hG
  rw [← hD] at h2
  refine mul_left_cancel₀ (mul_ne_zero hG hP) ?_
  linear_combination (-∏ g, (ρ.cofactor g).eval 1) * h2 - 2 * h +
    ((Fintype.card G : K) * ∏ g, (ρ.cofactor g).eval 1) * h3

end Private

section Main

variable [CharZero K] [Finite G] [Fintype ι] {f : ι → ρ.symmetricAlgebraInvariants} {d : ι → ℕ}

/-- **The product of the degrees is the order of the group.** Let a finite group `G` act faithfully
on a finite-dimensional vector space `M` over a field of characteristic zero. If the invariant
subalgebra `Sym(M)^G` is a polynomial algebra on homogeneous invariants `f i` of degrees `d i`,
then `∏ᵢ d i = |G|`. -/
theorem prod_eq_card_of_bijective_aeval_symmetricAlgebraInvariants (hρ : Function.Injective ρ)
    (hf : ∀ i, (f i : SymmetricAlgebra K M) ∈ homogeneousSubmodule K M (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∏ i, d i = Nat.card G := by
  have := Fintype.ofFinite G
  rw [Nat.card_eq_fintype_card]
  exact_mod_cast (ρ.natCast_card_eq_prod hρ hf hbij).symm

/-- **The sum of the degrees counts the pseudoreflections.** Let a finite group `G` act faithfully
on a finite-dimensional vector space `M` over a field of characteristic zero. If the invariant
subalgebra `Sym(M)^G` is a polynomial algebra on homogeneous invariants `f i` of degrees `d i`,
then `∑ᵢ d i = dim M + N`, where `N` is the number of pseudoreflections, the elements of `G` whose
fixed space in `M` is a hyperplane. Equivalently, `∑ᵢ (d i - 1) = N`. -/
theorem sum_eq_finrank_add_card_of_bijective_aeval_symmetricAlgebraInvariants
    (hρ : Function.Injective ρ)
    (hf : ∀ i, (f i : SymmetricAlgebra K M) ∈ homogeneousSubmodule K M (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∑ i, d i = finrank K M + Nat.card {g : G // finrank K (M ⧸ (ρ g).fixedSubmodule) = 1} := by
  classical
  have := Fintype.ofFinite G
  have h := ρ.sum_natCast_sub_one_eq hρ hf hbij
  rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one,
    sub_eq_iff_eq_add] at h
  have hn : Fintype.card ι = finrank K M := by
    rw [← Nat.card_eq_fintype_card]
    exact ρ.card_eq_finrank_of_bijective_aeval_symmetricAlgebraInvariants hbij
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype, ← hn, add_comm]
  exact_mod_cast h

/-- **The sum of the degrees of polynomial functions counts the pseudoreflections.** Let a finite
group `G` act faithfully on a finite-dimensional vector space `M` over a field of characteristic
zero. If the polynomial functions invariant under the contragredient action, `Sym(M*)^G`, form a
polynomial algebra on homogeneous invariants `f i` of degrees `d i`, then `∑ᵢ d i = dim M + N`,
where `N` is the number of pseudoreflections of `G` on `M`. This is
`Representation.sum_eq_finrank_add_card_of_bijective_aeval_symmetricAlgebraInvariants` for
`ρ.dual`, which has the same pseudoreflections as `ρ`. -/
theorem sum_eq_finrank_add_card_of_bijective_aeval_symmetricAlgebraInvariants_dual
    (hρ : Function.Injective ρ) {f : ι → ρ.dual.symmetricAlgebraInvariants}
    (hf : ∀ i, (f i : SymmetricAlgebra K (Dual K M)) ∈ homogeneousSubmodule K (Dual K M) (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∑ i, d i = finrank K M + Nat.card {g : G // finrank K (M ⧸ (ρ g).fixedSubmodule) = 1} := by
  rw [ρ.dual.sum_eq_finrank_add_card_of_bijective_aeval_symmetricAlgebraInvariants
    (ρ.dual_injective_iff.mpr hρ) hf hbij, Subspace.dual_finrank_eq]
  simp_rw [finrank_quotient_fixedSubmodule_dual]

end Main

end Representation
