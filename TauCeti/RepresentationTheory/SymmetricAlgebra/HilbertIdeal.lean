/-!
# The Hilbert ideal of a linear group action

Let a group `G` act linearly on a module `M` over a commutative ring `R`, and so on the symmetric
algebra `S = Sym M`, with invariant subalgebra `A = Sym(M)^G`. The *Hilbert ideal* is the ideal
`A₊ · S` of `S` generated by the invariants with zero constant term; equivalently, by the
homogeneous invariants of positive degree. The quotient `S ⧸ A₊ · S` is the *coinvariant algebra*
of the action. For `M = V*` with the contragredient action, the zero set of the Hilbert ideal is
the null cone of the action on `V`, and the results below show that for a finite group it is the
origin.

For a finite group `G`, every element `p` of the irrelevant ideal `S₊` (the elements with zero
constant term) satisfies `p ^ #G ∈ A₊ · S`: the lower coefficients of the orbit polynomial
`∏ g, (X - g • p)` are invariants with zero constant term (`Ideal.pow_card_mem_map_under`).
Hence the radical of the Hilbert ideal is the radical of `S₊`, which is `S₊` itself over a reduced
base. In particular the positive-degree elements of the coinvariant algebra are nilpotent, and
when `M` is finitely generated the coinvariant algebra is a finite `R`-module. None of these
results needs `#G` to be invertible in `R`.

## Main definitions

* `Representation.symmetricAlgebraHilbertIdeal`: the Hilbert ideal `A₊ · S`.

## Main results

* `Representation.symmetricAlgebraHilbertIdeal_le_iff`: an ideal contains the Hilbert ideal
  exactly when it contains every invariant with zero constant term.
* `Representation.symmetricAlgebraHilbertIdeal_eq_span`: the Hilbert ideal is generated by the
  homogeneous invariants of positive degree.
* `Representation.isHomogeneous_symmetricAlgebraHilbertIdeal`: it is a homogeneous ideal.
* `Representation.pow_card_mem_symmetricAlgebraHilbertIdeal`: for a finite group, `p ^ #G` lies in
  the Hilbert ideal for every `p` with zero constant term.
* `Representation.radical_symmetricAlgebraHilbertIdeal_of_isReduced`: over a reduced base, the
  radical of the Hilbert ideal is the irrelevant ideal.
* `Representation.moduleFinite_quotient_symmetricAlgebraHilbertIdeal`: for a finite group and a
  finitely generated module, the coinvariant algebra is a finite `R`-module.

## References

* H. Derksen, G. Kemper, *Computational Invariant Theory*, Springer (2002), Chapter 2.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), Chapter 2.
* R. Kane, *Reflection Groups and Invariant Theory*, CMS Books in Mathematics, Springer (2001),
  § 17.
-/

public section

open TauCeti.SymmetricAlgebra

namespace Representation

variable {R G M : Type*}

section CommSemiring

variable [CommSemiring R] [Monoid G] [AddCommMonoid M] [Module R M]
variable (ρ : Representation R G M)

/-- The induced action preserves the irrelevant ideal: it does not change constant terms. -/
theorem symmetricAlgebra_mem_irrelevant (g : G) {p : SymmetricAlgebra R M}
    (hp : p ∈ HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)) :
    ρ.symmetricAlgebra g p ∈ HomogeneousIdeal.irrelevant (homogeneousSubmodule R M) := by
  rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at hp ⊢
  rw [decompose_symmetricAlgebra, hp, map_zero]

/-- The **Hilbert ideal** `A₊ · S` of the induced action on `S = Sym M`: the ideal generated by
the invariants with zero constant term, that is, the extension to `S` of the contraction of the
irrelevant ideal `S₊` to the invariant subalgebra `A`. -/
noncomputable def symmetricAlgebraHilbertIdeal : Ideal (SymmetricAlgebra R M) :=
  ((HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal.under
    ρ.symmetricAlgebraInvariants).map (algebraMap ρ.symmetricAlgebraInvariants _)

/-- An ideal contains the Hilbert ideal exactly when it contains every invariant with zero
constant term. -/
theorem symmetricAlgebraHilbertIdeal_le_iff {J : Ideal (SymmetricAlgebra R M)} :
    ρ.symmetricAlgebraHilbertIdeal ≤ J ↔
      ∀ p ∈ ρ.symmetricAlgebraInvariants,
        p ∈ HomogeneousIdeal.irrelevant (homogeneousSubmodule R M) → p ∈ J := by
  rw [symmetricAlgebraHilbertIdeal, Ideal.map_le_iff_le_comap]
  exact ⟨fun h p hp hp' ↦ h (x := ⟨p, hp⟩) hp', fun h p hp ↦ h p p.2 hp⟩

/-- An invariant with zero constant term lies in the Hilbert ideal. -/
theorem mem_symmetricAlgebraHilbertIdeal_of_mem {p : SymmetricAlgebra R M}
    (hp : p ∈ ρ.symmetricAlgebraInvariants)
    (hp' : p ∈ HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)) :
    p ∈ ρ.symmetricAlgebraHilbertIdeal :=
  ρ.symmetricAlgebraHilbertIdeal_le_iff.1 le_rfl p hp hp'

/-- The Hilbert ideal is contained in the irrelevant ideal. -/
theorem symmetricAlgebraHilbertIdeal_le_irrelevant :
    ρ.symmetricAlgebraHilbertIdeal ≤
      (HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal :=
  ρ.symmetricAlgebraHilbertIdeal_le_iff.2 fun _ _ hp ↦ hp

/-- The Hilbert ideal is generated by the homogeneous invariants of positive degree. -/
theorem symmetricAlgebraHilbertIdeal_eq_span :
    ρ.symmetricAlgebraHilbertIdeal = Ideal.span
      {p | p ∈ ρ.symmetricAlgebraInvariants ∧ ∃ n, 0 < n ∧ p ∈ homogeneousSubmodule R M n} := by
  refine le_antisymm (ρ.symmetricAlgebraHilbertIdeal_le_iff.2 fun p hp hp' ↦ ?_) <|
    Ideal.span_le.2 fun p ⟨hp, n, hn, hpn⟩ ↦ ρ.mem_symmetricAlgebraHilbertIdeal_of_mem hp
      (HomogeneousIdeal.mem_irrelevant_of_mem _ hn hpn)
  classical
  -- Each homogeneous component of `p` is invariant, and the one of degree zero vanishes.
  rw [← DirectSum.sum_support_decompose (homogeneousSubmodule R M) p]
  refine Ideal.sum_mem _ fun n _ ↦ ?_
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at hp'
    rw [hp']
    exact zero_mem _
  · exact Ideal.subset_span ⟨ρ.isHomogeneous_symmetricAlgebraInvariants n hp, n, hn,
      SetLike.coe_mem _⟩

/-- The Hilbert ideal is a homogeneous ideal, so the coinvariant algebra is graded. -/
theorem isHomogeneous_symmetricAlgebraHilbertIdeal :
    ρ.symmetricAlgebraHilbertIdeal.IsHomogeneous (homogeneousSubmodule R M) := by
  rw [symmetricAlgebraHilbertIdeal_eq_span]
  exact Ideal.homogeneous_span _ _ fun _ ⟨_, n, _, hpn⟩ ↦ ⟨n, hpn⟩

end CommSemiring

section Finite

variable [CommRing R] [Group G] [Finite G] [AddCommMonoid M] [Module R M]
variable (ρ : Representation R G M)

/-- **Elements with zero constant term are nilpotent modulo the Hilbert ideal.** For a finite
group `G` and `p` in the irrelevant ideal, `p ^ #G` lies in the Hilbert ideal. -/
theorem pow_card_mem_symmetricAlgebraHilbertIdeal {p : SymmetricAlgebra R M}
    (hp : p ∈ HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)) :
    p ^ Nat.card G ∈ ρ.symmetricAlgebraHilbertIdeal :=
  letI := ρ.symmetricAlgebraMulSemiringAction
  haveI := ρ.isInvariant_symmetricAlgebraInvariants
  Ideal.pow_card_mem_map_under _ G (fun g _ ↦ ρ.symmetricAlgebra_mem_irrelevant g) hp

/-- The image in the coinvariant algebra of an element with zero constant term is nilpotent. -/
theorem isNilpotent_mk_symmetricAlgebraHilbertIdeal {p : SymmetricAlgebra R M}
    (hp : p ∈ HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)) :
    IsNilpotent (Ideal.Quotient.mk ρ.symmetricAlgebraHilbertIdeal p) :=
  ⟨Nat.card G, by
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact ρ.pow_card_mem_symmetricAlgebraHilbertIdeal hp⟩

/-- For a finite group, the Hilbert ideal and the irrelevant ideal have the same radical. -/
theorem radical_symmetricAlgebraHilbertIdeal :
    ρ.symmetricAlgebraHilbertIdeal.radical =
      (HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal.radical :=
  letI := ρ.symmetricAlgebraMulSemiringAction
  haveI := ρ.isInvariant_symmetricAlgebraInvariants
  Ideal.radical_map_under _ G fun g _ ↦ ρ.symmetricAlgebra_mem_irrelevant g

/-- For a finite group over a reduced base, the radical of the Hilbert ideal is the irrelevant
ideal. -/
theorem radical_symmetricAlgebraHilbertIdeal_of_isReduced [IsReduced R] :
    ρ.symmetricAlgebraHilbertIdeal.radical =
      (HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal := by
  rw [radical_symmetricAlgebraHilbertIdeal, (isRadical_toIdeal_irrelevant R M).radical]

/-- **Finiteness of the coinvariant algebra.** For a finite group acting on a finitely generated
module, the coinvariant algebra `Sym M ⧸ A₊ · Sym M` is a finite `R`-module: it is of finite type,
and generated by nilpotent, hence integral, elements. -/
instance moduleFinite_quotient_symmetricAlgebraHilbertIdeal [Module.Finite R M] :
    Module.Finite R (SymmetricAlgebra R M ⧸ ρ.symmetricAlgebraHilbertIdeal) := by
  have : Algebra.FiniteType R (SymmetricAlgebra R M ⧸ ρ.symmetricAlgebraHilbertIdeal) :=
    .of_surjective (Ideal.Quotient.mkₐ R _) (Ideal.Quotient.mkₐ_surjective R _)
  have : Algebra.IsIntegral R (SymmetricAlgebra R M ⧸ ρ.symmetricAlgebraHilbertIdeal) := by
    refine ⟨fun x ↦ ?_⟩
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
    induction p using SymmetricAlgebra.induction with
    | algebraMap r =>
      rw [← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_apply]
      exact isIntegral_algebraMap
    | ι m =>
      refine IsIntegral.of_pow (Nat.card_pos (α := G)) ?_
      rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem.2 (ρ.pow_card_mem_symmetricAlgebraHilbertIdeal
        (HomogeneousIdeal.mem_irrelevant_of_mem _ one_pos (ι_mem_homogeneousSubmodule R M m)))]
      exact isIntegral_zero
    | mul a b ha hb => rw [map_mul]; exact ha.mul hb
    | add a b ha hb => rw [map_add]; exact ha.add hb
  exact Algebra.IsIntegral.finite

end Finite

end Representation
