module

public import TauCeti.RepresentationTheory.SymmetricAlgebra.Hyperplane.Product
public import TauCeti.RepresentationTheory.SymmetricAlgebra.ProductOfDegrees
import TauCeti.RepresentationTheory.SymmetricAlgebra.Degrees
import TauCeti.RingTheory.GradedAlgebra.Basic

/-!
# The exact reflecting-hyperplane Jacobian formula

For a faithful finite linear action in characteristic zero, the Jacobian of homogeneous
basic polynomial invariants is a nonzero scalar times `∏_H ℓ_H^(e_H - 1)`. Here `H` runs over
the distinct reflecting hyperplanes, `ℓ_H` cuts out `H`, and `e_H` is the order of its pointwise
stabilizer, expressed as the inertia group of `(ℓ_H)` in `Sym(V*)`.

Individual hyperplane divisibilities give a divisor of the Jacobian. The degree-sum formula
for basic invariants shows that this divisor has the full degree of the Jacobian, excluding
any further factors. In particular the Jacobian vanishes at a point exactly when the point
lies on a reflecting hyperplane. The result includes dimension zero and fixed directions;
no essentiality or choice of a reflection-generated presentation is required.

This computes the polynomial Jacobian and its zero set. It does not identify local quotient
maps with a cyclic normal-coordinate model or assert a local ramification comparison.

## References

* R. P. Stanley, *Relative invariants of finite groups generated by pseudoreflections*,
  J. Algebra **49** (1977), 134–148, §3, Remark (1), p. 139: the Jacobian is the product
  of defining forms with exponents the pointwise stabilizer orders minus one, up to a scalar.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge (1990), §3.9:
  the degree/reflection count used in the degree comparison (in the real reflection case).
-/

public section

open SymmetricAlgebra TauCeti.SymmetricAlgebra

namespace Representation

variable {K G V : Type*} [Field K] [CharZero K] [Group G] [Finite G]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  (ρ : Representation K G V)
  {n : Type*} [Fintype n] [DecidableEq n]

/-- **The exact Jacobian formula.** For homogeneous basic invariants of a faithful finite
linear action in characteristic zero, the Jacobian is a nonzero scalar times the product
over distinct reflecting hyperplanes, with exponent the pointwise stabilizer order minus
one. Defining forms and the basis of `V*` affect only the nonzero scalar. -/
theorem exists_jacobian_eq_algebraMap_mul_prod_dual_inertia_sub_one
    (hρ : Function.Injective ρ) (b : Module.Basis n K (Module.Dual K V))
    (ℓ : (H : ρ.reflectingHyperplanes) → Module.Dual K V)
    (hker : ∀ H, LinearMap.ker (ℓ H) = H.val)
    {f : n → ρ.dual.symmetricAlgebraInvariants} {d : n → ℕ}
    (hf : ∀ i, (f i : SymmetricAlgebra K (Module.Dual K V)) ∈
      homogeneousSubmodule K (Module.Dual K V) (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    letI := ρ.dual.symmetricAlgebraMulSemiringAction
    ∃ c : K, c ≠ 0 ∧
      jacobian b (fun i ↦ (f i : SymmetricAlgebra K (Module.Dual K V))) =
        algebraMap K _ c * ∏ H : ρ.reflectingHyperplanes,
          ι K (Module.Dual K V) (ℓ H) ^
            (Nat.card ((Ideal.span {ι K (Module.Dual K V) (ℓ H)}).inertia G) - 1) := by
  classical
  let := Fintype.ofFinite G
  let := ρ.dual.symmetricAlgebraMulSemiringAction
  let e (H : ρ.reflectingHyperplanes) :=
    Nat.card ((Ideal.span {ι K (Module.Dual K V) (ℓ H)}).inertia G) - 1
  let P := ∏ H : ρ.reflectingHyperplanes, ι K (Module.Dual K V) (ℓ H) ^ e H
  have hJ := ρ.dual.jacobian_ne_zero_of_surjective_aeval b hbij.2
  obtain ⟨q, hq⟩ := ρ.prod_dual_inertia_sub_one_dvd_jacobian
    (Nat.cast_ne_zero.2 Nat.card_pos.ne') hρ b ℓ hker (fun i ↦ (f i).property)
  have hfactor : jacobian b (fun i ↦ (f i : SymmetricAlgebra K (Module.Dual K V))) = P * q := hq
  have hP : P ≠ 0 := left_ne_zero_of_mul (hfactor ▸ hJ)
  -- The number of pseudoreflections is both the degree of the product and that of the Jacobian.
  have hdeg : ∑ i, (d i - 1) = ∑ H : ρ.reflectingHyperplanes, e H := by
    rw [ρ.sum_sub_one_eq_card_of_bijective_aeval_symmetricAlgebraInvariants_dual hρ hf hbij]
    simpa only [e, Nat.card_eq_fintype_card, Fintype.card_subtype] using
      (ρ.sum_card_dual_inertia_sub_one_eq_card_pseudoreflections hρ ℓ hker).symm
  have hPhom : P ∈ homogeneousSubmodule K (Module.Dual K V) (∑ H, e H) := by
    simpa only [smul_eq_mul, mul_one] using SetLike.prod_mem_graded
      (homogeneousSubmodule K (Module.Dual K V)) (F := Finset.univ) _ _
      (fun H _ ↦ SetLike.pow_mem_graded (e H)
        (ι_mem_homogeneousSubmodule K (Module.Dual K V) (ℓ H)))
  -- Cancelling the homogeneous nonzero divisor leaves a degree-zero factor, hence a scalar.
  have hqhom : q ∈ homogeneousSubmodule K (Module.Dual K V) 0 := by
    apply TauCeti.GradedAlgebra.mem_of_mul_mem_add_of_isLeftRegular _ hPhom
      (isRegular_iff_ne_zero.2 hP).left
    rw [add_zero, ← hdeg, ← hfactor]
    exact jacobian_mem_homogeneousSubmodule b d hf
  let c := homogeneousSubmoduleZeroEquiv K (Module.Dual K V) ⟨q, hqhom⟩
  have hc : algebraMap K (SymmetricAlgebra K (Module.Dual K V)) c = q :=
    algebraMap_homogeneousSubmoduleZeroEquiv_apply K (Module.Dual K V) ⟨q, hqhom⟩
  refine ⟨c, ?_, ?_⟩
  · intro hc0
    apply hJ
    rw [hfactor, ← hc, hc0, map_zero, mul_zero]
  · rw [hfactor, ← hc, mul_comm]

/-- The Jacobian of homogeneous basic invariants vanishes at a point precisely on the
reflecting-hyperplane arrangement. The hyperplanes are those of the original action on `V`,
while the polynomial invariants use the contragredient action on `V*`. -/
theorem lift_jacobian_eq_zero_iff_exists_mem_reflectingHyperplanes
    (hρ : Function.Injective ρ) (b : Module.Basis n K (Module.Dual K V))
    {f : n → ρ.dual.symmetricAlgebraInvariants} {d : n → ℕ}
    (hf : ∀ i, (f i : SymmetricAlgebra K (Module.Dual K V)) ∈
      homogeneousSubmodule K (Module.Dual K V) (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) (v : V) :
    lift (Module.Dual.eval K V v)
        (jacobian b (fun i ↦ (f i : SymmetricAlgebra K (Module.Dual K V)))) = 0 ↔
      ∃ H ∈ ρ.reflectingHyperplanes, v ∈ H := by
  classical
  let := ρ.dual.symmetricAlgebraMulSemiringAction
  choose ℓ _ hker using fun H : ρ.reflectingHyperplanes ↦
    ρ.exists_dual_ker_eq_of_mem_reflectingHyperplanes H.property
  obtain ⟨c, hc, hJ⟩ :=
    ρ.exists_jacobian_eq_algebraMap_mul_prod_dual_inertia_sub_one hρ b ℓ hker hf hbij
  have he (H : ρ.reflectingHyperplanes) :
      Nat.card ((Ideal.span {ι K (Module.Dual K V) (ℓ H)}).inertia G) - 1 ≠ 0 := by
    have := ρ.one_lt_card_dual_inertia H (hker H)
    omega
  simp only [hJ, map_mul, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply,
    map_prod, map_pow, lift_ι_apply, Module.Dual.eval_apply, mul_eq_zero, hc, false_or,
    Finset.prod_eq_zero_iff, pow_eq_zero_iff (he _)]
  constructor
  · rintro ⟨H, _, hH⟩
    exact ⟨H.val, H.property, hker H ▸ LinearMap.mem_ker.2 hH⟩
  · rintro ⟨H, hH, hv⟩
    exact ⟨⟨H, hH⟩, Finset.mem_univ _, LinearMap.mem_ker.1 ((hker ⟨H, hH⟩).symm ▸ hv)⟩

end Representation
