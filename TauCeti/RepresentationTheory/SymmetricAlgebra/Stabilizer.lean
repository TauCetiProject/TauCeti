section EvaluationStabilizer

section CommSemiring

variable {R G M : Type*} [CommSemiring R] [Group G] [AddCommMonoid M] [Module R M]
  (ρ : Representation R G M)

/-- Evaluating `ρ.symmetricAlgebra g p` along `f : M →ₗ[R] R` equals evaluating `p` along
`ρ.dual g⁻¹ f`. -/
theorem lift_symmetricAlgebra_eq_lift_dual_inv (f : M →ₗ[R] R) (g : G) (p : SymmetricAlgebra R M) :
    SymmetricAlgebra.lift f (ρ.symmetricAlgebra g p) = SymmetricAlgebra.lift (ρ.dual g⁻¹ f) p := by
  have h : (SymmetricAlgebra.lift f).comp (SymmetricAlgebra.map R (ρ g)) =
      SymmetricAlgebra.lift (ρ.dual g⁻¹ f) :=
    SymmetricAlgebra.algHom_ext <| LinearMap.ext fun _ ↦ by
      simp [dual_apply, Module.Dual.transpose_apply]
  rw [symmetricAlgebra_apply, ← h, AlgHom.comp_apply]

/-- Restricting `ρ.dual` to `ρ.stabilizer v` leaves `Module.Dual.eval R M v` invariant. -/
theorem eval_comp_dual_stabilizer (v : M) (h : ρ.stabilizer v) :
    Module.Dual.eval R M v ∘ₗ dual (ρ.comp (ρ.stabilizer v).subtype) h =
      Module.Dual.eval R M v := by
  ext φ
  have hinv : ρ (h : G)⁻¹ v = v := by
    rw [← Subgroup.coe_inv]; exact (ρ.stabilizer v).inv_mem h.property
  simp [dual_apply, Module.Dual.transpose_apply, hinv]

/-- Every element fixing `f : M →ₗ[R] R` under `ρ.dual` stabilizes `RingHom.ker (lift f)`. -/
theorem stabilizer_dual_le_stabilizer_ker_lift (f : M →ₗ[R] R) :
    letI := ρ.symmetricAlgebraMulSemiringAction
    ρ.dual.stabilizer f ≤ MulAction.stabilizer G (RingHom.ker (SymmetricAlgebra.lift f)) := by
  let := ρ.symmetricAlgebraMulSemiringAction
  intro g hg; rw [MulAction.mem_stabilizer_iff]; ext p
  rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, RingHom.mem_ker, RingHom.mem_ker,
    symmetricAlgebraMulSemiringAction_smul, ρ.lift_symmetricAlgebra_eq_lift_dual_inv, inv_inv,
    mem_stabilizer.mp hg]

/-- Every element of `ρ.stabilizer v` stabilizes `RingHom.ker (lift (eval v))` in `Sym(M*)`. -/
theorem stabilizer_le_stabilizer_ker_lift_eval (v : M) :
    letI := ρ.dual.symmetricAlgebraMulSemiringAction
    ρ.stabilizer v ≤
      MulAction.stabilizer G (RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval R M v))) := by
  refine le_trans (fun g hg ↦ ?_)
    (ρ.dual.stabilizer_dual_le_stabilizer_ker_lift (Module.Dual.eval R M v))
  rw [mem_stabilizer]; ext φ; simp [dual_apply, Module.Dual.transpose_apply, mem_stabilizer.mp hg]

end CommSemiring

section CommRing

variable {R G M : Type*} [CommRing R] [Group G] [AddCommMonoid M] [Module R M]
  (ρ : Representation R G M)

/-- **Decomposition group of a linear-form augmentation ideal.** Over any commutative ring `R`, the
stabilizer in `G` of `RingHom.ker (SymmetricAlgebra.lift f)` equals `ρ.dual.stabilizer f`. -/
theorem stabilizer_ker_lift (f : M →ₗ[R] R) :
    letI := ρ.symmetricAlgebraMulSemiringAction
    MulAction.stabilizer G (RingHom.ker (SymmetricAlgebra.lift f)) = ρ.dual.stabilizer f := by
  let := ρ.symmetricAlgebraMulSemiringAction
  refine le_antisymm (fun g hg ↦ ?_) (ρ.stabilizer_dual_le_stabilizer_ker_lift f)
  rw [mem_stabilizer]; ext m
  set 𝔪 := RingHom.ker (SymmetricAlgebra.lift f)
  set p : SymmetricAlgebra R M := SymmetricAlgebra.ι R M m - algebraMap R _ (f m)
  have hginv := MulAction.mem_stabilizer_iff.mp ((MulAction.stabilizer G 𝔪).inv_mem hg)
  have hgp : g⁻¹ • p ∈ 𝔪 := hginv ▸ Ideal.smul_mem_pointwise_smul g⁻¹ p 𝔪 (by simp [𝔪, p])
  rwa [RingHom.mem_ker, symmetricAlgebraMulSemiringAction_smul,
    ρ.lift_symmetricAlgebra_eq_lift_dual_inv, inv_inv, map_sub, SymmetricAlgebra.lift_ι_apply,
    AlgHom.commutes, sub_eq_zero] at hgp

end CommRing

section Projective

variable {R G M : Type*} [CommRing R] [Group G] [AddCommGroup M] [Module R M]
  (ρ : Representation R G M)

/-- **Decomposition group of an evaluation ideal.** When `M` is projective over `R` (in particular
for any vector space over a field), the stabilizer in `G` of
`RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval R M v))` equals `ρ.stabilizer v`. -/
theorem stabilizer_ker_lift_eval [Module.Projective R M] (v : M) :
    letI := ρ.dual.symmetricAlgebraMulSemiringAction
    MulAction.stabilizer G (RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval R M v))) =
      ρ.stabilizer v := by
  let := ρ.dual.symmetricAlgebraMulSemiringAction
  rw [ρ.dual.stabilizer_ker_lift (Module.Dual.eval R M v)]; ext g
  simp only [mem_stabilizer, LinearMap.ext_iff, dual_apply, Module.Dual.transpose_apply,
    inv_inv, LinearMap.comp_apply, Module.Dual.eval_apply]
  rw [← sub_eq_zero (a := ρ g v), ← Module.forall_dual_apply_eq_zero_iff R]
  exact forall_congr' fun _ ↦ by rw [map_sub, sub_eq_zero]

end Projective

end EvaluationStabilizer

section CompletedLocalComparison

variable {K G V : Type*} [Field K] [Group G] [Finite G] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] (ρ : Representation K G V)

/-- **Completed-local comparison for an intermediate subgroup containing `G_v`.** If `H ≤ G`
contains `ρ.stabilizer v`, then completing `Sym(V*)^G → Sym(V*)^H` along the contractions of the
evaluation maximal ideal `ker (lift (eval v))` is bijective. -/
theorem mapₐ_inclusion_under_ker_lift_eval_bijective_of_stabilizer_le {v : V} {H : Subgroup G}
    (hH : ρ.stabilizer v ≤ H)
    (hle : (RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
        ρ.dual.symmetricAlgebraInvariants ≤
      ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
        (dual (ρ.comp H.subtype)).symmetricAlgebraInvariants).comap
        (Subalgebra.inclusion (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype H)) :=
      (Ideal.comap_inclusion_under (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype H) _).ge) :
    Function.Bijective
      (AdicCompletion.mapₐ
        (Subalgebra.inclusion (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype H)) hle) := by
  let := ρ.dual.symmetricAlgebraMulSemiringAction
  have := ρ.dual.smulCommClass_symmetricAlgebraMulSemiringAction
  have : SMulCommClass G ρ.dual.symmetricAlgebraInvariants (SymmetricAlgebra K (Module.Dual K V)) :=
    ρ.dual.symmetricAlgebraInvariants_eq_fixedPoints ▸ inferInstance
  have := ρ.dual.isInvariant_symmetricAlgebraInvariants
  have : IsNoetherianRing ρ.dual.symmetricAlgebraInvariants :=
    Algebra.FiniteType.isNoetherianRing K _
  have hB : (dual (ρ.comp H.subtype)).symmetricAlgebraInvariants =
      FixedPoints.subalgebra K (SymmetricAlgebra K (Module.Dual K V)) H := by
    rw [dual_comp, ρ.dual.symmetricAlgebraInvariants_comp_subtype H]
  have : SMulCommClass H (dual (ρ.comp H.subtype)).symmetricAlgebraInvariants
      (SymmetricAlgebra K (Module.Dual K V)) := hB ▸ inferInstance
  have : Algebra.IsInvariant (dual (ρ.comp H.subtype)).symmetricAlgebraInvariants
      (SymmetricAlgebra K (Module.Dual K V)) H := hB ▸ inferInstance
  set S := SymmetricAlgebra K (Module.Dual K V)
  set A := ρ.dual.symmetricAlgebraInvariants
  set B := (dual (ρ.comp H.subtype)).symmetricAlgebraInvariants
  set 𝔪 := RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))
  let : Algebra A B :=
    (Subalgebra.inclusion (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype H)).toRingHom.toAlgebra
  have : IsScalarTower A B S := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hbij := TauCeti.Algebra.IsInvariant.mapₐ_ofId_bijective_of_stabilizer_le
    (A := A) (B := B) (S := S) H (𝔪.under A) (𝔪.under B) 𝔪
    ((ρ.stabilizer_ker_lift_eval v).le.trans hH)
  have heq : ⇑(AdicCompletion.mapₐ
      (Subalgebra.inclusion (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype H)) hle) =
    ⇑(AdicCompletion.mapₐ (Algebra.ofId A B)
      (have := Ideal.LiesOver.tower_bot 𝔪 (𝔪.under B) (𝔪.under A);
        fun a ha ↦ Ideal.mem_comap.mpr (((𝔪.under B).mem_of_liesOver (𝔪.under A) a).mp ha))) :=
    funext fun x ↦ by
      apply AdicCompletion.mapₐ_congr; intro a
      exact (DFunLike.congr_fun (RingHom.algebraMap_toAlgebra _) a).symm
  exact heq ▸ hbij

/-- **Completed-local isomorphism between `Sym(V*)^G` at `v` and `Sym(V*)^{G_v}` at its vertex.**
Composing `Subalgebra.inclusion` on completions with Taylor translation by `v` identifies the
completion of `Sym(V*)^G` at `ker (lift (eval v)) ∩ Sym(V*)^G` with the completion of
`Sym(V*)^{G_v}` at its homogeneous irrelevant ideal. -/
noncomputable def adicCompletionUnderKerLiftEvalEquiv (v : V) :
    AdicCompletion
      ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
        ρ.dual.symmetricAlgebraInvariants) ρ.dual.symmetricAlgebraInvariants ≃ₐ[K]
    AdicCompletion
      ((HomogeneousIdeal.irrelevant (homogeneousSubmodule K (Module.Dual K V))).toIdeal.under
        (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants)
      (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants :=
  (AlgEquiv.ofBijective
    (AdicCompletion.mapₐ
      (Subalgebra.inclusion (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype (ρ.stabilizer v)))
      (Ideal.comap_inclusion_under
        (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype (ρ.stabilizer v)) _).ge)
    (ρ.mapₐ_inclusion_under_ker_lift_eval_bijective_of_stabilizer_le le_rfl)).trans
    (AdicCompletion.congrₐ
      ((dual (ρ.comp (ρ.stabilizer v).subtype)).translationSymmetricAlgebraInvariantsEquiv
        (Module.Dual.eval K V v) (ρ.eval_comp_dual_stabilizer v))
      (map_translationSymmetricAlgebraInvariantsEquiv_under_ker_lift
        (dual (ρ.comp (ρ.stabilizer v).subtype))
        (Module.Dual.eval K V v) (ρ.eval_comp_dual_stabilizer v)))

-- Not `@[simp]`: `HomogeneousIdeal.toIdeal_irrelevant` simplifies the implicit codomain in
-- `DFunLike.coe` (`simpNF`), just as for `adicCompletionUnderKerLiftEvalEquiv_of`.
/-- Applying `adicCompletionUnderKerLiftEvalEquiv` composes `AdicCompletion.mapₐ` of
`Subalgebra.inclusion` with `AdicCompletion.congrₐ` of
`translationSymmetricAlgebraInvariantsEquiv`. -/
theorem adicCompletionUnderKerLiftEvalEquiv_apply (v : V)
    (x : AdicCompletion ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
      ρ.dual.symmetricAlgebraInvariants) ρ.dual.symmetricAlgebraInvariants) :
    ρ.adicCompletionUnderKerLiftEvalEquiv v x =
      AdicCompletion.congrₐ
        ((dual (ρ.comp (ρ.stabilizer v).subtype)).translationSymmetricAlgebraInvariantsEquiv
          (Module.Dual.eval K V v) (ρ.eval_comp_dual_stabilizer v))
        (map_translationSymmetricAlgebraInvariantsEquiv_under_ker_lift
          (dual (ρ.comp (ρ.stabilizer v).subtype))
          (Module.Dual.eval K V v) (ρ.eval_comp_dual_stabilizer v))
        (AdicCompletion.mapₐ
          (Subalgebra.inclusion
            (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype (ρ.stabilizer v)))
          (Ideal.comap_inclusion_under
            (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype (ρ.stabilizer v)) _).ge x) := by
  rw [adicCompletionUnderKerLiftEvalEquiv, AlgEquiv.trans_apply, AlgEquiv.ofBijective_apply]

/-- On an uncompleted `G`-invariant `a ∈ Sym(V*)^G`, `adicCompletionUnderKerLiftEvalEquiv` acts as
Taylor translation `p(x) ↦ p(x + v)` inside `Sym(V*)^{G_v}`. -/
theorem adicCompletionUnderKerLiftEvalEquiv_of (v : V) (a : ρ.dual.symmetricAlgebraInvariants) :
    ρ.adicCompletionUnderKerLiftEvalEquiv v
      (AdicCompletion.of _ ρ.dual.symmetricAlgebraInvariants a) =
      AdicCompletion.of _ _
        ((dual (ρ.comp (ρ.stabilizer v).subtype)).translationSymmetricAlgebraInvariantsEquiv
          (Module.Dual.eval K V v) (ρ.eval_comp_dual_stabilizer v)
          (Subalgebra.inclusion
            (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype (ρ.stabilizer v)) a)) := by
  rw [adicCompletionUnderKerLiftEvalEquiv_apply, AdicCompletion.mapₐ_of, AdicCompletion.congrₐ_of]

/-- **Local regularity comparison between `Sym(V*)^G` at `v` and `Sym(V*)^{G_v}` at the origin.**
For a finite group `G` acting linearly on a finite-dimensional `K`-vector space `V` (in arbitrary
characteristic), `Sym(V*)^G` is locally regular at `v` if and only if `Sym(V*)^{G_v}` is locally
regular at its homogeneous irrelevant ideal. -/
theorem isRegularLocalRing_atPrime_under_ker_lift_eval_iff (v : V) :
    IsRegularLocalRing (Localization.AtPrime
      ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
        ρ.dual.symmetricAlgebraInvariants)) ↔
    IsRegularLocalRing (Localization.AtPrime
      ((HomogeneousIdeal.irrelevant (homogeneousSubmodule K (Module.Dual K V))).toIdeal.under
        (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants)) := by
  let 𝔭 := (RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
    ρ.dual.symmetricAlgebraInvariants
  let 𝔮 := (HomogeneousIdeal.irrelevant (homogeneousSubmodule K (Module.Dual K V))).toIdeal.under
    (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants
  have : 𝔭.IsMaximal := Ideal.isMaximal_under_of_isIntegral_of_isMaximal
    (RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v)))
  have : 𝔮.IsMaximal := Ideal.isMaximal_under_of_isIntegral_of_isMaximal
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule K (Module.Dual K V))).toIdeal
  have : IsNoetherianRing ρ.dual.symmetricAlgebraInvariants :=
    Algebra.FiniteType.isNoetherianRing K _
  have : IsNoetherianRing (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants :=
    Algebra.FiniteType.isNoetherianRing K _
  let e := (ρ.adicCompletionUnderKerLiftEvalEquiv v).toRingEquiv
  rw [← TauCeti.AdicCompletion.isRegularLocalRing_iff_of_isMaximal 𝔭 (Localization.AtPrime 𝔭),
    ← TauCeti.AdicCompletion.isRegularLocalRing_iff_of_isMaximal 𝔮 (Localization.AtPrime 𝔮)]
  exact ⟨fun _ ↦ .of_ringEquiv e, fun _ ↦ .of_ringEquiv e.symm⟩

/-- **Characteristic-free polynomiality of `Sym(V*)^{G_v}` from local regularity at `v`.** Over any
field `K`, if `Sym(V*)^G` is locally regular at `v`, then `Sym(V*)^{G_v}` is a polynomial algebra on
`finrank K V` homogeneous invariants of positive degree. -/
theorem exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularLocalRing
    (v : V) [IsRegularLocalRing (Localization.AtPrime
      ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
        ρ.dual.symmetricAlgebraInvariants))] :
    ∃ f : Fin (Module.finrank K V) →
        (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants,
      (∀ i, ∃ d, 0 < d ∧
        (f i : SymmetricAlgebra K (Module.Dual K V)) ∈ homogeneousSubmodule K (Module.Dual K V) d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  have := (ρ.isRegularLocalRing_atPrime_under_ker_lift_eval_iff v).mp inferInstance
  obtain ⟨f, hf, hbij⟩ := (dual (ρ.comp (ρ.stabilizer v).subtype)
    ).exists_bijective_aeval_symmetricAlgebraInvariants_of_isRegularLocalRing
  let e := finCongr (Subspace.dual_finrank_eq (K := K) (V := V)).symm
  have hcomp : MvPolynomial.aeval (R := K) (f ∘ e) =
      (MvPolynomial.aeval f).comp (MvPolynomial.rename e) := by ext; simp
  exact ⟨f ∘ e, fun i ↦ hf (e i), hcomp ▸ hbij.comp (MvPolynomial.renameEquiv K e).bijective⟩

/-- **Characteristic-free polynomiality of `Sym(V*)^{G_v}` when `Sym(V*)^G` is regular.** Over any
field `K`, if `Sym(V*)^G` is a regular ring, then for every `v : V`, `Sym(V*)^{G_v}` is a polynomial
algebra on `finrank K V` homogeneous invariants of positive degree. -/
theorem exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularRing
    [IsRegularRing ρ.dual.symmetricAlgebraInvariants] (v : V) :
    ∃ f : Fin (Module.finrank K V) →
        (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants,
      (∀ i, ∃ d, 0 < d ∧
        (f i : SymmetricAlgebra K (Module.Dual K V)) ∈ homogeneousSubmodule K (Module.Dual K V) d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  have := IsRegularRing.isRegularLocalRing_localization
    ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
      ρ.dual.symmetricAlgebraInvariants)
  exact ρ.exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularLocalRing v

end CompletedLocalComparison

section Steinberg

variable {K G V : Type*} [Field K] [CharZero K] [Group G] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] (ρ : Representation K G V)

section FiniteGroup

variable [Finite G]

/-- **Local smoothness criterion on `V/G` (Prill–Steinberg).** For a faithful finite linear group
`G` in characteristic zero, `G_v` is generated by pseudoreflections if and only if `Sym(V*)^G` is
locally regular at `v`. -/
theorem pseudoreflectionSubgroup_stabilizer_eq_top_iff_isRegularLocalRing
    (hρ : Function.Injective ρ) (v : V) :
    pseudoreflectionSubgroup (ρ.comp (ρ.stabilizer v).subtype) = ⊤ ↔
      IsRegularLocalRing (Localization.AtPrime
        ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
          ρ.dual.symmetricAlgebraInvariants)) := by
  have hρ_sub : Function.Injective (ρ.comp (ρ.stabilizer v).subtype) :=
    hρ.comp Subtype.val_injective
  refine ⟨fun hstab ↦ ?_, fun _ ↦ ?_⟩
  · obtain ⟨f, _, hbij⟩ :=
      (pseudoreflectionSubgroup_eq_top_iff_exists_bijective_aeval_symmetricAlgebraInvariants_dual
        (ρ.comp (ρ.stabilizer v).subtype) hρ_sub).mp hstab
    have : IsRegularRing (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants :=
      IsRegularRing.of_ringEquiv (AlgEquiv.ofBijective _ hbij).toRingEquiv
    exact (ρ.isRegularLocalRing_atPrime_under_ker_lift_eval_iff v).mpr
      (IsRegularRing.isRegularLocalRing_localization _)
  · obtain ⟨f, hf, hbij⟩ :=
      ρ.exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularLocalRing v
    exact
      (pseudoreflectionSubgroup_eq_top_iff_exists_bijective_aeval_symmetricAlgebraInvariants_dual
        (ρ.comp (ρ.stabilizer v).subtype) hρ_sub).mpr ⟨f, hf, hbij⟩

/-- **Steinberg's theorem.** For a faithful finite linear group `G` over a field of characteristic
zero generated by pseudoreflections, every point stabilizer `ρ.stabilizer v` is generated by its
pseudoreflections on `V`. -/
theorem pseudoreflectionSubgroup_stabilizer_eq_top_of_pseudoreflectionSubgroup_eq_top
    (hρ : Function.Injective ρ) (hG : ρ.pseudoreflectionSubgroup = ⊤) (v : V) :
    pseudoreflectionSubgroup (ρ.comp (ρ.stabilizer v).subtype) = ⊤ := by
  obtain ⟨f, _, hbij⟩ :=
    (ρ.pseudoreflectionSubgroup_eq_top_iff_exists_bijective_aeval_symmetricAlgebraInvariants_dual
      hρ).mp hG
  have : IsRegularRing ρ.dual.symmetricAlgebraInvariants :=
    IsRegularRing.of_ringEquiv (AlgEquiv.ofBijective _ hbij).toRingEquiv
  exact (ρ.pseudoreflectionSubgroup_stabilizer_eq_top_iff_isRegularLocalRing hρ v).mpr
    (IsRegularRing.isRegularLocalRing_localization _)

/-- **Steinberg's theorem (ambient subgroup form).** Under the hypotheses of
`pseudoreflectionSubgroup_stabilizer_eq_top_of_pseudoreflectionSubgroup_eq_top`, `ρ.stabilizer v` is
generated in `G` by the pseudoreflections of `ρ` that fix `v`. -/
theorem closure_pseudoreflections_stabilizer_eq_of_pseudoreflectionSubgroup_eq_top
    (hρ : Function.Injective ρ) (hG : ρ.pseudoreflectionSubgroup = ⊤) (v : V) :
    Subgroup.closure
      {g : G | Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1 ∧ g ∈ ρ.stabilizer v} =
      ρ.stabilizer v := by
  have htop := congrArg (Subgroup.map (ρ.stabilizer v).subtype)
    (ρ.pseudoreflectionSubgroup_stabilizer_eq_top_of_pseudoreflectionSubgroup_eq_top hρ hG v)
  rw [pseudoreflectionSubgroup_def, MonoidHom.map_closure, Subgroup.map_top,
    (ρ.stabilizer v).range_subtype] at htop
  refine Eq.trans (congrArg Subgroup.closure <| Set.ext fun g ↦ ?_) htop
  simp only [Set.mem_ofPred_eq, Set.mem_image, Subgroup.coe_subtype, MonoidHom.coe_comp,
    Function.comp_apply]
  exact ⟨fun ⟨h1, h2⟩ ↦ ⟨⟨g, h2⟩, h1, rfl⟩, by rintro ⟨⟨g, hg⟩, h1, rfl⟩; exact ⟨h1, hg⟩⟩

/-- **Steinberg's theorem for pointwise set stabilizers.** Under the hypotheses of
`pseudoreflectionSubgroup_stabilizer_eq_top_of_pseudoreflectionSubgroup_eq_top`, for any subset
`s : Set V`, `⨅ w ∈ s, ρ.stabilizer w` is generated by its pseudoreflections. -/
theorem pseudoreflectionSubgroup_biInf_stabilizer_eq_top_of_pseudoreflectionSubgroup_eq_top
    (hρ : Function.Injective ρ) (hG : ρ.pseudoreflectionSubgroup = ⊤) (s : Set V) :
    pseudoreflectionSubgroup (ρ.comp (⨅ w ∈ s, ρ.stabilizer w).subtype) = ⊤ := by
  obtain ⟨v, _, hstab⟩ := ρ.exists_mem_span_stabilizer_eq_biInf s
  exact hstab ▸
    ρ.pseudoreflectionSubgroup_stabilizer_eq_top_of_pseudoreflectionSubgroup_eq_top hρ hG v

/-- Ambient subgroup form of
`pseudoreflectionSubgroup_biInf_stabilizer_eq_top_of_pseudoreflectionSubgroup_eq_top`: the pointwise
stabilizer of `s : Set V` is generated in `G` by the pseudoreflections fixing every `w ∈ s`. -/
theorem closure_pseudoreflections_biInf_stabilizer_eq_of_pseudoreflectionSubgroup_eq_top
    (hρ : Function.Injective ρ) (hG : ρ.pseudoreflectionSubgroup = ⊤) (s : Set V) :
    Subgroup.closure
      {g : G | Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1 ∧ ∀ w ∈ s, ρ g w = w} =
      ⨅ w ∈ s, ρ.stabilizer w := by
  obtain ⟨v, _, hstab⟩ := ρ.exists_mem_span_stabilizer_eq_biInf s
  rw [← hstab,
    ← ρ.closure_pseudoreflections_stabilizer_eq_of_pseudoreflectionSubgroup_eq_top hρ hG v]
  congr 1; ext g; simp [hstab, Subgroup.mem_iInf]

end FiniteGroup

/-- **Steinberg's theorem for a finite faithful image.** Assuming only that `G ⧸ ρ.ker` is finite
and `G` is generated by its pseudoreflections together with `ρ.ker`, `ρ.stabilizer v` is generated
by its pseudoreflections together with its action kernel. -/
theorem
    pseudoreflectionSubgroup_stabilizer_sup_ker_eq_top_of_pseudoreflectionSubgroup_sup_ker_eq_top
    [Finite (G ⧸ ρ.ker)] (hG : ρ.pseudoreflectionSubgroup ⊔ ρ.ker = ⊤) (v : V) :
    pseudoreflectionSubgroup (ρ.comp (ρ.stabilizer v).subtype) ⊔
      (ρ.comp (ρ.stabilizer v).subtype).ker = ⊤ := by
  set ρbar := ρ.ofQuotient ρ.ker
  have hstab_bar :=
    ρbar.pseudoreflectionSubgroup_stabilizer_eq_top_of_pseudoreflectionSubgroup_eq_top
      ((ρ.injective_ofQuotient_iff ρ.ker).mpr rfl)
      (ρ.pseudoreflectionSubgroup_ofQuotient_ker_eq_top_iff.mpr hG) v
  rw [← ρ.map_mk'_stabilizer ρ.ker v] at hstab_bar
  let q := (QuotientGroup.mk' ρ.ker).subgroupMap (ρ.stabilizer v)
  have hsub : ((ρ.stabilizer v).map (QuotientGroup.mk' ρ.ker)).subtype.comp q =
      (QuotientGroup.mk' ρ.ker).comp (ρ.stabilizer v).subtype := by ext; simp [q]
  have hcomp : (ρbar.comp ((ρ.stabilizer v).map (QuotientGroup.mk' ρ.ker)).subtype).comp q =
      ρ.comp (ρ.stabilizer v).subtype := by
    rw [MonoidHom.comp_assoc, hsub, ← MonoidHom.comp_assoc, ρ.ofQuotient_comp_mk' ρ.ker]
  have hker : q.ker = (ρ.comp (ρ.stabilizer v).subtype).ker := by
    rw [Subgroup.ker_subgroupMap, QuotientGroup.ker_mk', Subgroup.subgroupOf, MonoidHom.comap_ker]
  have hcomap := congrArg (Subgroup.comap q) hstab_bar
  rwa [Subgroup.comap_top,
    comap_pseudoreflectionSubgroup _ q ((QuotientGroup.mk' ρ.ker).subgroupMap_surjective _),
    hcomp, hker] at hcomap

end Steinberg

end Representation
