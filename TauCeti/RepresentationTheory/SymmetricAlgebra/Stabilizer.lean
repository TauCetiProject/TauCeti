section Translation

variable {R G M : Type*} [CommRing R] [Monoid G] [AddCommMonoid M] [Module R M]
variable (ρ : Representation R G M)

/-- Translating `SymmetricAlgebra R M` by a linear form `f` after applying `ρ.symmetricAlgebra g`
is applying `ρ.symmetricAlgebra g` after translating by `f ∘ₗ ρ g`. -/
theorem translation_symmetricAlgebra (f : M →ₗ[R] R) (g : G) (p : SymmetricAlgebra R M) :
    SymmetricAlgebra.translation f (ρ.symmetricAlgebra g p) =
      ρ.symmetricAlgebra g (SymmetricAlgebra.translation (f ∘ₗ ρ g) p) := by
  have h : (SymmetricAlgebra.translation f).toAlgHom.comp (SymmetricAlgebra.map R (ρ g)) =
      (SymmetricAlgebra.map R (ρ g)).comp
        (SymmetricAlgebra.translation (f ∘ₗ ρ g)).toAlgHom :=
    SymmetricAlgebra.algHom_ext <| LinearMap.ext fun m ↦ by simp
  simpa only [symmetricAlgebra_apply, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom] using
    DFunLike.congr_fun h p

private noncomputable def translationInvariantsAlgHom (f : M →ₗ[R] R)
    (hf : ∀ g : G, f ∘ₗ ρ g = f) :
    ρ.symmetricAlgebraInvariants →ₐ[R] ρ.symmetricAlgebraInvariants :=
  ((SymmetricAlgebra.translation f).toAlgHom.comp ρ.symmetricAlgebraInvariants.val).codRestrict
    ρ.symmetricAlgebraInvariants fun x ↦ (ρ.mem_symmetricAlgebraInvariants _).mpr fun g ↦ by
      simpa [hf g, (ρ.mem_symmetricAlgebraInvariants x.1).mp x.2 g] using
        (ρ.translation_symmetricAlgebra f g x.1).symm

/-- When a linear form `f : M →ₗ[R] R` is `G`-invariant (`∀ g, f ∘ₗ ρ g = f`), translation by `f`
restricts to an `R`-algebra automorphism of `ρ.symmetricAlgebraInvariants`. -/
noncomputable def translationSymmetricAlgebraInvariantsEquiv (f : M →ₗ[R] R)
    (hf : ∀ g : G, f ∘ₗ ρ g = f) :
    ρ.symmetricAlgebraInvariants ≃ₐ[R] ρ.symmetricAlgebraInvariants :=
  AlgEquiv.ofAlgHom (ρ.translationInvariantsAlgHom f hf)
    (ρ.translationInvariantsAlgHom (-f) fun g ↦ by rw [LinearMap.neg_comp, hf g])
    (by ext; simp [translationInvariantsAlgHom])
    (by ext; simp [translationInvariantsAlgHom])

/-- Within `SymmetricAlgebra R M`, `translationSymmetricAlgebraInvariantsEquiv f hf` acts as
`SymmetricAlgebra.translation f`. -/
@[simp]
theorem coe_translationSymmetricAlgebraInvariantsEquiv_apply (f : M →ₗ[R] R)
    (hf : ∀ g : G, f ∘ₗ ρ g = f) (x : ρ.symmetricAlgebraInvariants) :
    (ρ.translationSymmetricAlgebraInvariantsEquiv f hf x : SymmetricAlgebra R M) =
      SymmetricAlgebra.translation f x := by
  rw [translationSymmetricAlgebraInvariantsEquiv, AlgEquiv.ofAlgHom_apply,
    translationInvariantsAlgHom]; rfl

/-- Within `SymmetricAlgebra R M`, `(translationSymmetricAlgebraInvariantsEquiv f hf).symm` acts as
`SymmetricAlgebra.translation (-f)`. -/
@[simp]
theorem coe_translationSymmetricAlgebraInvariantsEquiv_symm_apply (f : M →ₗ[R] R)
    (hf : ∀ g : G, f ∘ₗ ρ g = f) (x : ρ.symmetricAlgebraInvariants) :
    ((ρ.translationSymmetricAlgebraInvariantsEquiv f hf).symm x : SymmetricAlgebra R M) =
      SymmetricAlgebra.translation (-f) x := by
  rw [translationSymmetricAlgebraInvariantsEquiv, AlgEquiv.ofAlgHom_symm_apply,
    translationInvariantsAlgHom]; rfl

private theorem lift_zero_eq_algebraMapInv :
    SymmetricAlgebra.lift (0 : M →ₗ[R] R) = SymmetricAlgebra.algebraMapInv :=
  SymmetricAlgebra.algHom_ext <| LinearMap.ext fun m ↦ by simp [SymmetricAlgebra.algebraMapInv_ι]

/-- Translation by a `G`-invariant linear form `f` carries the contraction of `ker (lift f)` to
`ρ.symmetricAlgebraInvariants` onto the contraction of the homogeneous irrelevant ideal. -/
theorem map_translationSymmetricAlgebraInvariantsEquiv_under_ker_lift
    (f : M →ₗ[R] R) (hf : ∀ g : G, f ∘ₗ ρ g = f) :
    Ideal.map (ρ.translationSymmetricAlgebraInvariantsEquiv f hf)
      ((RingHom.ker (SymmetricAlgebra.lift f)).under ρ.symmetricAlgebraInvariants) =
      (HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal.under
        ρ.symmetricAlgebraInvariants := by
  let e := ρ.translationSymmetricAlgebraInvariantsEquiv f hf
  have hf0 : (0 : M →ₗ[R] R) + Algebra.linearMap R R ∘ₗ f = f := by ext; simp
  have hfn : f + Algebra.linearMap R R ∘ₗ (-f) = 0 := by ext; simp
  rw [toIdeal_irrelevant_eq_ker_algebraMapInv, ← lift_zero_eq_algebraMapInv]
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun x hx ↦ ?_) fun y hy ↦ ?_
  · simpa [Ideal.mem_under, SymmetricAlgebra.lift_translation, hf0] using hx
  · refine e.apply_symm_apply y ▸ Ideal.mem_map_of_mem e ?_
    simpa [e, Ideal.mem_under, SymmetricAlgebra.lift_translation, hfn] using hy

end Translation

section EvaluationStabilizer

variable {R G M : Type*} [CommRing R] [Group G] [AddCommGroup M] [Module R M]
variable (ρ : Representation R G M)

/-- Restricting the contragredient representation to `ρ.stabilizer v` leaves the evaluation form
`Module.Dual.eval R M v` invariant. -/
theorem eval_comp_dual_stabilizer (v : M) (h : ρ.stabilizer v) :
    Module.Dual.eval R M v ∘ₗ dual (ρ.comp (ρ.stabilizer v).subtype) h =
      Module.Dual.eval R M v := by
  ext φ
  have hinv : ρ (h : G)⁻¹ v = v := by rw [← Subgroup.coe_inv]; exact (ρ.stabilizer v).inv_mem h.2
  simp [dual_apply, Module.Dual.transpose_apply, hinv]

/-- Every element of `ρ.stabilizer v` stabilizes the evaluation ideal
`RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval R M v))` under the contragredient action on
`Sym(M*)`. -/
theorem stabilizer_le_stabilizer_ker_lift_eval (v : M) :
    letI := ρ.dual.symmetricAlgebraMulSemiringAction
    ρ.stabilizer v ≤
      MulAction.stabilizer G (RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval R M v))) := by
  let := ρ.dual.symmetricAlgebraMulSemiringAction
  intro g hg
  rw [MulAction.mem_stabilizer_iff]
  ext p
  rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, RingHom.mem_ker, RingHom.mem_ker,
    symmetricAlgebraMulSemiringAction_smul, ρ.lift_eval_symmetricAlgebra_dual, inv_inv,
    mem_stabilizer.mp hg]

/-- **Decomposition group of an evaluation ideal.** When `M` is projective over `R` (in particular
for any vector space over a field), the stabilizer in `G` of the evaluation ideal
`RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval R M v))` equals `ρ.stabilizer v`. -/
theorem stabilizer_ker_lift_eval [Module.Projective R M] (v : M) :
    letI := ρ.dual.symmetricAlgebraMulSemiringAction
    MulAction.stabilizer G (RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval R M v))) =
      ρ.stabilizer v := by
  let := ρ.dual.symmetricAlgebraMulSemiringAction
  refine le_antisymm ?_ (ρ.stabilizer_le_stabilizer_ker_lift_eval v)
  intro g hg
  rw [mem_stabilizer, ← sub_eq_zero, ← Module.forall_dual_apply_eq_zero_iff R]
  intro φ
  set 𝔪 := RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval R M v))
  set p : SymmetricAlgebra R (Module.Dual R M) := SymmetricAlgebra.ι R _ φ - algebraMap R _ (φ v)
  have hginv := MulAction.mem_stabilizer_iff.mp ((MulAction.stabilizer G 𝔪).inv_mem hg)
  have hgp : g⁻¹ • p ∈ 𝔪 := hginv ▸ Ideal.smul_mem_pointwise_smul g⁻¹ p 𝔪 (by simp [𝔪, p])
  rw [RingHom.mem_ker, symmetricAlgebraMulSemiringAction_smul,
    ρ.lift_eval_symmetricAlgebra_dual, inv_inv] at hgp
  simpa [p, map_sub] using hgp

end EvaluationStabilizer

section CompletedLocalComparison

variable {K G V : Type*} [Field K] [Group G] [Finite G] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] (ρ : Representation K G V)

private theorem under_le_comap_inclusion {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    {A B : Subalgebra R S} (hAB : A ≤ B) (I : Ideal S) :
    I.under A ≤ (I.under B).comap (Subalgebra.inclusion hAB) := fun _ ha ↦ by
  rw [Ideal.mem_comap, Ideal.mem_under]; rw [Ideal.mem_under] at ha; simpa using ha

private theorem bijective_mapₐ_of_bijective_toAlgebra {R A B : Type*} [CommRing R] [CommRing A]
    [CommRing B] [Algebra R A] [Algebra R B] (f : A →ₐ[R] B) {I : Ideal A} {J : Ideal B}
    (hf₁ : I ≤ J.comap f)
    (h :
      letI : Algebra A B := f.toRingHom.toAlgebra
      ∃ hf₂ : I ≤ J.comap (Algebra.ofId A B),
        Function.Bijective (AdicCompletion.mapₐ (Algebra.ofId A B) hf₂)) :
    Function.Bijective (AdicCompletion.mapₐ f hf₁) := by
  let : Algebra A B := f.toRingHom.toAlgebra
  obtain ⟨hf₂, hbij⟩ := h
  suffices (AdicCompletion.mapₐ f hf₁ : AdicCompletion I A → AdicCompletion J B) =
      AdicCompletion.mapₐ (Algebra.ofId A B) hf₂ from this ▸ hbij
  funext x
  exact AdicCompletion.ext_evalₐ fun n ↦ by
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n x)
    simp [← ha, RingHom.algebraMap_toAlgebra]

omit [Finite G] [FiniteDimensional K V] in
/-- Invariants of `G` on `Sym(V*)` lie in the invariants of any subgroup `H ≤ G`. -/
theorem symmetricAlgebraInvariants_dual_le_comp_subtype (H : Subgroup G) :
    ρ.dual.symmetricAlgebraInvariants ≤ (dual (ρ.comp H.subtype)).symmetricAlgebraInvariants := by
  intro p hp
  rw [dual_comp]
  refine (mem_symmetricAlgebraInvariants _ p).mpr fun h ↦ ?_
  rw [symmetricAlgebra_comp_apply]
  exact (ρ.dual.mem_symmetricAlgebraInvariants p).mp hp h.1

/-- **Completed-local comparison for an intermediate subgroup containing `G_v`.** If `H ≤ G`
contains `ρ.stabilizer v`, then completing `Sym(V*)^G → Sym(V*)^H` along the contractions of the
evaluation maximal ideal `ker (lift (eval v))` is bijective. -/
theorem bijective_mapₐ_inclusion_under_ker_lift_eval {v : V} {H : Subgroup G}
    (hH : ρ.stabilizer v ≤ H)
    (hle :
      (RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
        ρ.dual.symmetricAlgebraInvariants ≤
        ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
          (dual (ρ.comp H.subtype)).symmetricAlgebraInvariants).comap
          (Subalgebra.inclusion (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype H)) := by
      intro _ ha; rw [Ideal.mem_comap, Ideal.mem_under]; rw [Ideal.mem_under] at ha
      simpa using ha) :
    Function.Bijective
      (AdicCompletion.mapₐ
        (Subalgebra.inclusion (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype H)) hle) := by
  refine bijective_mapₐ_of_bijective_toAlgebra
    (Subalgebra.inclusion (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype H)) hle ?_
  let := ρ.dual.symmetricAlgebraMulSemiringAction
  have := ρ.dual.smulCommClass_symmetricAlgebraMulSemiringAction
  set S := SymmetricAlgebra K (Module.Dual K V)
  have hB_mem (s : S) :
      s ∈ (dual (ρ.comp H.subtype)).symmetricAlgebraInvariants ↔ ∀ h : H, (h : G) • s = s := by
    rw [dual_comp, mem_symmetricAlgebraInvariants]
    exact forall_congr' fun h ↦ by
      rw [symmetricAlgebra_comp_apply, symmetricAlgebraMulSemiringAction_smul]; rfl
  set A := ρ.dual.symmetricAlgebraInvariants
  set B := (dual (ρ.comp H.subtype)).symmetricAlgebraInvariants
  set 𝔪 := RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))
  have : SMulCommClass G A S := ⟨fun g a s ↦ by
    change g • ((a : S) * s) = (a : S) * (g • s)
    rw [MulSemiringAction.smul_mul, symmetricAlgebraMulSemiringAction_smul,
      (ρ.dual.mem_symmetricAlgebraInvariants a.1).mp a.2 g]⟩
  have : Algebra.IsInvariant A S G := ρ.dual.isInvariant_symmetricAlgebraInvariants
  have : FaithfulSMul A S := (faithfulSMul_iff_algebraMap_injective A S).mpr Subtype.val_injective
  have : FaithfulSMul B S := (faithfulSMul_iff_algebraMap_injective B S).mpr Subtype.val_injective
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing K A
  have : SMulCommClass H B S := ⟨fun h b s ↦ by
    change (h : G) • ((b : S) * s) = (b : S) * ((h : G) • s)
    rw [MulSemiringAction.smul_mul, (hB_mem b.1).mp b.2 h]⟩
  have : Algebra.IsInvariant B S H := ⟨fun s hs ↦ ⟨⟨s, (hB_mem s).mpr hs⟩, rfl⟩⟩
  let : Algebra A B :=
    (Subalgebra.inclusion (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype H)).toRingHom.toAlgebra
  have : IsScalarTower A B S := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  exact ⟨_, TauCeti.Algebra.IsInvariant.bijective_mapₐ_of_stabilizer_le
    (A := A) (B := B) (S := S) H (𝔪.under A) (𝔪.under B) 𝔪
    ((ρ.stabilizer_ker_lift_eval v).le.trans hH)⟩

/-- **Completed-local isomorphism between `Sym(V*)^G` at `v` and `Sym(V*)^{G_v}` at its vertex.**
Composing `Subalgebra.inclusion` on completions with Taylor translation by `v` identifies the
completion of `Sym(V*)^G` at `ker (lift (eval v)) ∩ Sym(V*)^G` with the completion of
`Sym(V*)^{G_v}` at its homogeneous irrelevant ideal. -/
noncomputable def adicCompletionUnderKerLiftEvalEquiv (v : V) :
    AdicCompletion
      ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
        ρ.dual.symmetricAlgebraInvariants)
      ρ.dual.symmetricAlgebraInvariants ≃ₐ[K]
    AdicCompletion
      ((HomogeneousIdeal.irrelevant (homogeneousSubmodule K (Module.Dual K V))).toIdeal.under
        (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants)
      (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants :=
  (AlgEquiv.ofBijective
    (AdicCompletion.mapₐ
      (Subalgebra.inclusion (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype (ρ.stabilizer v)))
      (under_le_comap_inclusion
        (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype (ρ.stabilizer v)) _))
    (ρ.bijective_mapₐ_inclusion_under_ker_lift_eval le_rfl
      (under_le_comap_inclusion
        (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype (ρ.stabilizer v)) _))).trans
    (AdicCompletion.congrₐ
      ((dual (ρ.comp (ρ.stabilizer v).subtype)).translationSymmetricAlgebraInvariantsEquiv
        (Module.Dual.eval K V v) (ρ.eval_comp_dual_stabilizer v))
      (map_translationSymmetricAlgebraInvariantsEquiv_under_ker_lift
        (dual (ρ.comp (ρ.stabilizer v).subtype))
        (Module.Dual.eval K V v) (ρ.eval_comp_dual_stabilizer v)))

/-- On an uncompleted `G`-invariant `a ∈ Sym(V*)^G`, `adicCompletionUnderKerLiftEvalEquiv` acts as
Taylor translation `p(x) ↦ p(x + v)` inside `Sym(V*)^{G_v}`. -/
theorem adicCompletionUnderKerLiftEvalEquiv_of (v : V) (a : ρ.dual.symmetricAlgebraInvariants) :
    ρ.adicCompletionUnderKerLiftEvalEquiv v
      (AdicCompletion.of _ ρ.dual.symmetricAlgebraInvariants a) =
      AdicCompletion.of _ _
        ((dual (ρ.comp (ρ.stabilizer v).subtype)).translationSymmetricAlgebraInvariantsEquiv
          (Module.Dual.eval K V v) (ρ.eval_comp_dual_stabilizer v)
          (Subalgebra.inclusion
            (ρ.symmetricAlgebraInvariants_dual_le_comp_subtype (ρ.stabilizer v)) a)) := by
  rw [adicCompletionUnderKerLiftEvalEquiv, AlgEquiv.trans_apply, AlgEquiv.ofBijective_apply,
    AdicCompletion.mapₐ_of, AdicCompletion.congrₐ_of]

/-- **Local regularity comparison between `Sym(V*)^G` at `v` and `Sym(V*)^{G_v}` at the origin.**
For a finite group `G` acting linearly on a finite-dimensional `K`-vector space `V` (in arbitrary
characteristic), `Sym(V*)^G` is locally regular at `v` if and only if `Sym(V*)^{G_v}` is locally
regular at its homogeneous irrelevant ideal. -/
theorem isRegularLocalRing_atPrime_under_ker_lift_eval_iff (v : V) :
    IsRegularLocalRing (Localization.AtPrime
      ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
        ρ.dual.symmetricAlgebraInvariants)) ↔
    IsRegularLocalRing (Localization.AtPrime
      ((HomogeneousIdeal.irrelevant (homogeneousSubmodule K (Module.Dual K V))).toIdeal.under
        (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants)) := by
  set A := ρ.dual.symmetricAlgebraInvariants
  set B := (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants
  set 𝔪 := RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))
  set 𝔭 := 𝔪.under A
  set 𝔮₀ := (HomogeneousIdeal.irrelevant (homogeneousSubmodule K (Module.Dual K V))).toIdeal.under B
  have : 𝔭.IsMaximal := Ideal.isMaximal_under_of_isIntegral_of_isMaximal 𝔪
  have : 𝔮₀.IsMaximal := Ideal.isMaximal_under_of_isIntegral_of_isMaximal
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule K (Module.Dual K V))).toIdeal
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing K A
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing K B
  have : IsNoetherianRing (Localization.AtPrime 𝔭) :=
    IsLocalization.isNoetherianRing 𝔭.primeCompl _ inferInstance
  have : IsNoetherianRing (Localization.AtPrime 𝔮₀) :=
    IsLocalization.isNoetherianRing 𝔮₀.primeCompl _ inferInstance
  let e := (AdicCompletion.equivMaximalIdealOfAtPrime 𝔭 (Localization.AtPrime 𝔭)).symm.toRingEquiv
    |>.trans ((ρ.adicCompletionUnderKerLiftEvalEquiv v).toRingEquiv.trans
      (AdicCompletion.equivMaximalIdealOfAtPrime 𝔮₀ (Localization.AtPrime 𝔮₀)).toRingEquiv)
  rw [← TauCeti.AdicCompletion.isRegularLocalRing_iff (R := Localization.AtPrime 𝔭),
    ← TauCeti.AdicCompletion.isRegularLocalRing_iff (R := Localization.AtPrime 𝔮₀)]
  exact ⟨fun _ ↦ .of_ringEquiv e, fun _ ↦ .of_ringEquiv e.symm⟩

/-- **Characteristic-free polynomiality of `Sym(V*)^{G_v}` from local regularity at `v`.** Over any
field `K`, if `Sym(V*)^G` is locally regular at `v`, then `Sym(V*)^{G_v}` is a polynomial algebra on
`finrank K V` homogeneous invariants of positive degree. -/
theorem exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularLocalRing
    (v : V)
    [IsRegularLocalRing (Localization.AtPrime
      ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
        ρ.dual.symmetricAlgebraInvariants))] :
    ∃ f : Fin (Module.finrank K V) →
        (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants,
      (∀ i, ∃ d, 0 < d ∧
        (f i : SymmetricAlgebra K (Module.Dual K V)) ∈ homogeneousSubmodule K (Module.Dual K V) d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  let ρv := dual (ρ.comp (ρ.stabilizer v).subtype)
  have := (ρ.isRegularLocalRing_atPrime_under_ker_lift_eval_iff v).mp inferInstance
  obtain ⟨f, hf, hbij⟩ := ρv.exists_bijective_aeval_symmetricAlgebraInvariants_of_isRegularLocalRing
  let e := finCongr (Subspace.dual_finrank_eq (K := K) (V := V)).symm
  refine ⟨f ∘ e, fun i ↦ hf (e i), ?_⟩
  have hcomp : MvPolynomial.aeval (R := K) (f ∘ e) =
      (MvPolynomial.aeval f).comp (MvPolynomial.rename e) := by
    ext
    simp
  rw [hcomp]
  exact hbij.comp (MvPolynomial.renameEquiv K e).bijective

/-- **Characteristic-free polynomiality of `Sym(V*)^{G_v}` when `Sym(V*)^G` is regular.** Over any
field `K`, if `Sym(V*)^G` is a regular ring (for example a polynomial algebra), then for every
vector `v : V`, the stabilizer invariant algebra `Sym(V*)^{G_v}` is a polynomial algebra on
`finrank K V` homogeneous invariants of positive degree. -/
theorem exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularRing
    [IsRegularRing ρ.dual.symmetricAlgebraInvariants] (v : V) :
    ∃ f : Fin (Module.finrank K V) →
        (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants,
      (∀ i, ∃ d, 0 < d ∧
        (f i : SymmetricAlgebra K (Module.Dual K V)) ∈ homogeneousSubmodule K (Module.Dual K V) d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  have := IsRegularRing.isRegularLocalRing_localization
    ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
      ρ.dual.symmetricAlgebraInvariants)
  exact ρ.exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularLocalRing v

end CompletedLocalComparison

section Steinberg

variable {K G V : Type*} [Field K] [CharZero K] [Group G] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] (ρ : Representation K G V)

section FiniteGroup

variable [Finite G]

/-- **Local smoothness criterion on `V/G` (Prill–Steinberg).** For a faithful finite linear group
`G` in characteristic zero, the stabilizer `G_v` of `v : V` is generated by pseudoreflections if
and only if `Sym(V*)^G` is locally regular at `v`. -/
theorem pseudoreflectionSubgroup_stabilizer_eq_top_iff_isRegularLocalRing
    (hρ : Function.Injective ρ) (v : V) :
    pseudoreflectionSubgroup (ρ.comp (ρ.stabilizer v).subtype) = ⊤ ↔
      IsRegularLocalRing (Localization.AtPrime
        ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
          ρ.dual.symmetricAlgebraInvariants)) := by
  have hρ_sub : Function.Injective (ρ.comp (ρ.stabilizer v).subtype) :=
    hρ.comp Subtype.val_injective
  constructor
  · intro hstab
    obtain ⟨f, _, hbij⟩ :=
      (pseudoreflectionSubgroup_eq_top_iff_exists_bijective_aeval_symmetricAlgebraInvariants_dual
        (ρ.comp (ρ.stabilizer v).subtype) hρ_sub).mp hstab
    have : IsRegularRing (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants :=
      IsRegularRing.of_ringEquiv (AlgEquiv.ofBijective _ hbij).toRingEquiv
    exact (ρ.isRegularLocalRing_atPrime_under_ker_lift_eval_iff v).mpr
      (IsRegularRing.isRegularLocalRing_localization _)
  · intro hreg
    obtain ⟨f, hf, hbij⟩ :=
      ρ.exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularLocalRing v
    exact
      (pseudoreflectionSubgroup_eq_top_iff_exists_bijective_aeval_symmetricAlgebraInvariants_dual
        (ρ.comp (ρ.stabilizer v).subtype) hρ_sub).mpr ⟨f, hf, hbij⟩

/-- **Steinberg's theorem.** Let a finite group `G` act faithfully and linearly on a
finite-dimensional vector space `V` over a field `K` of characteristic zero, and suppose `G` is
generated by pseudoreflections. Then for every vector `v : V`, the point stabilizer `ρ.stabilizer v`
is generated by its pseudoreflections on `V`. -/
theorem pseudoreflectionSubgroup_stabilizer_eq_top
    (hρ : Function.Injective ρ) (hG : ρ.pseudoreflectionSubgroup = ⊤) (v : V) :
    pseudoreflectionSubgroup (ρ.comp (ρ.stabilizer v).subtype) = ⊤ := by
  obtain ⟨f, _, hbij⟩ :=
    (ρ.pseudoreflectionSubgroup_eq_top_iff_exists_bijective_aeval_symmetricAlgebraInvariants_dual
      hρ).mp hG
  have : IsRegularRing ρ.dual.symmetricAlgebraInvariants :=
    IsRegularRing.of_ringEquiv (AlgEquiv.ofBijective _ hbij).toRingEquiv
  exact (ρ.pseudoreflectionSubgroup_stabilizer_eq_top_iff_isRegularLocalRing hρ v).mpr
    (IsRegularRing.isRegularLocalRing_localization _)

/-- **Steinberg's theorem (ambient subgroup form).** Under the hypotheses of
`pseudoreflectionSubgroup_stabilizer_eq_top`, the subgroup `ρ.stabilizer v` is generated in `G` by
the pseudoreflections of `ρ` that fix `v`. -/
theorem closure_pseudoreflections_inter_stabilizer
    (hρ : Function.Injective ρ) (hG : ρ.pseudoreflectionSubgroup = ⊤) (v : V) :
    Subgroup.closure
      {g : G | Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1 ∧ g ∈ ρ.stabilizer v} =
      ρ.stabilizer v := by
  have htop := congrArg (Subgroup.map (ρ.stabilizer v).subtype)
    (ρ.pseudoreflectionSubgroup_stabilizer_eq_top hρ hG v)
  rw [pseudoreflectionSubgroup_def, MonoidHom.map_closure, Subgroup.map_top,
    (ρ.stabilizer v).range_subtype] at htop
  refine Eq.trans ?_ htop
  congr 1
  ext g
  simp only [Set.mem_ofPred_eq, Set.mem_image, Subgroup.coe_subtype, MonoidHom.coe_comp,
    Function.comp_apply]
  exact ⟨fun ⟨h1, h2⟩ ↦ ⟨⟨g, h2⟩, h1, rfl⟩, by rintro ⟨⟨g, hg⟩, h1, rfl⟩; exact ⟨h1, hg⟩⟩

/-- **Steinberg's theorem for pointwise set stabilizers.** Under the hypotheses of
`pseudoreflectionSubgroup_stabilizer_eq_top`, for any subset `s : Set V` (in particular any linear
subspace), the pointwise stabilizer `⨅ w ∈ s, ρ.stabilizer w` is generated by its
pseudoreflections. -/
theorem pseudoreflectionSubgroup_biInf_stabilizer_eq_top
    (hρ : Function.Injective ρ) (hG : ρ.pseudoreflectionSubgroup = ⊤) (s : Set V) :
    pseudoreflectionSubgroup (ρ.comp (⨅ w ∈ s, ρ.stabilizer w).subtype) = ⊤ := by
  obtain ⟨v, _, hstab⟩ := ρ.exists_mem_span_stabilizer_eq_biInf s
  rw [← hstab]
  exact ρ.pseudoreflectionSubgroup_stabilizer_eq_top hρ hG v

/-- Ambient subgroup form of `pseudoreflectionSubgroup_biInf_stabilizer_eq_top`: the pointwise
stabilizer of any subset `s : Set V` is generated in `G` by the pseudoreflections fixing every
element of `s`. -/
theorem closure_pseudoreflections_inter_biInf_stabilizer
    (hρ : Function.Injective ρ) (hG : ρ.pseudoreflectionSubgroup = ⊤) (s : Set V) :
    Subgroup.closure
      {g : G | Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1 ∧ ∀ w ∈ s, ρ g w = w} =
      ⨅ w ∈ s, ρ.stabilizer w := by
  obtain ⟨v, _, hstab⟩ := ρ.exists_mem_span_stabilizer_eq_biInf s
  rw [← hstab, ← ρ.closure_pseudoreflections_inter_stabilizer hρ hG v]
  congr 1
  ext g
  simp [hstab, Subgroup.mem_iInf]

end FiniteGroup

/-- **Steinberg's theorem for a finite faithful image.** Assuming only that `G ⧸ ρ.ker` is finite
and `G` is generated by its pseudoreflections together with `ρ.ker`, the point stabilizer
`ρ.stabilizer v` is generated by its pseudoreflections together with its action kernel. -/
theorem pseudoreflectionSubgroup_stabilizer_sup_ker_eq_top
    [Finite (G ⧸ ρ.ker)] (hG : ρ.pseudoreflectionSubgroup ⊔ ρ.ker = ⊤) (v : V) :
    pseudoreflectionSubgroup (ρ.comp (ρ.stabilizer v).subtype) ⊔
      (ρ.comp (ρ.stabilizer v).subtype).ker = ⊤ := by
  set ρbar := ρ.ofQuotient ρ.ker
  have hρbar : Function.Injective ρbar := (ρ.injective_ofQuotient_iff ρ.ker).mpr rfl
  have hGbar : ρbar.pseudoreflectionSubgroup = ⊤ :=
    ρ.pseudoreflectionSubgroup_ofQuotient_ker_eq_top_iff.mpr hG
  have hstab_bar := ρbar.pseudoreflectionSubgroup_stabilizer_eq_top hρbar hGbar v
  -- Restrict `QuotientGroup.mk' ρ.ker` to a surjection `ρ.stabilizer v →* ρbar.stabilizer v`.
  let q : ρ.stabilizer v →* ρbar.stabilizer v :=
    ((QuotientGroup.mk' ρ.ker).comp (ρ.stabilizer v).subtype).codRestrict (ρbar.stabilizer v)
      fun h ↦ by
        rw [MonoidHom.comp_apply, Subgroup.coe_subtype, mem_stabilizer, QuotientGroup.mk'_apply,
          ρ.ofQuotient_coe_apply ρ.ker h.1 v, mem_stabilizer.mp h.2]
  have hq_surj : Function.Surjective q := by
    rintro ⟨g, hg⟩
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective ρ.ker g
    have hx : x ∈ ρ.stabilizer v := by
      rw [← ρ.comap_mk'_stabilizer_ofQuotient ρ.ker v]
      exact hg
    exact ⟨⟨x, hx⟩, rfl⟩
  have hcomp :
      (ρbar.comp (ρbar.stabilizer v).subtype).comp q = ρ.comp (ρ.stabilizer v).subtype := by
    ext h w
    simp only [MonoidHom.comp_apply, Subgroup.coe_subtype, q, MonoidHom.codRestrict_apply,
      QuotientGroup.mk'_apply, ρbar]
    exact ρ.ofQuotient_coe_apply ρ.ker h.1 w
  have hker : q.ker = (ρ.comp (ρ.stabilizer v).subtype).ker := by
    ext h
    simp [q, QuotientGroup.eq_one_iff]
  have hcomap := congrArg (Subgroup.comap q) hstab_bar
  rwa [Subgroup.comap_top, comap_pseudoreflectionSubgroup _ q hq_surj, hcomp, hker] at hcomap

end Steinberg

end Representation
