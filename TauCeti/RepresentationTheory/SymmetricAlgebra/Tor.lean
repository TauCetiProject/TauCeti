module

public import Mathlib.Algebra.Category.ModuleCat.Monoidal.Basic
public import Mathlib.Algebra.Category.ModuleCat.Projective
public import TauCeti.CategoryTheory.Monoidal.Tor
public import TauCeti.RepresentationTheory.Invariants
public import TauCeti.RepresentationTheory.SymmetricAlgebra.DividedDifference

/-!
# Invariants of `Tor'` over the polynomial invariants

Let `ρ` be a representation of a group `G` on a module `M` over a commutative ring `R`, and let
`A = Sym(M)^G` be the invariant subalgebra of the symmetric algebra `S = Sym M`. Every `ρ g` acts
on `S` by an `A`-linear map, since it fixes `A` pointwise; this is the representation
`Representation.symmetricAlgebraOverInvariants` of `G` on the `A`-module `S`, whose invariants are
`A` itself (both in `TauCeti.RepresentationTheory.SymmetricAlgebra.Basic`). Every additive
functor `F` on `A`-modules therefore carries an action of `G` on `F(S)`, by
`CategoryTheory.Functor.mapRepresentation`.

The main example is `F = Tor'ₙ^A(N, -)`, Mathlib's `CategoryTheory.Tor'`, which derives the tensor
product in its first variable `N`. When `G` is finite and `#G` is invertible in `R`, the
invariants of `Tor'ₙ^A(N, S)` are `Tor'ₙ^A(N, A)`, which vanishes in positive degrees because `A`
is the tensor unit. So `Tor'ₙ₊₁^A(N, S)` has no nonzero invariant element
(`Representation.invariants_mapRepresentation_Tor'_symmetricAlgebraOverInvariants`).

Divided differences interact with this action. If `m - ρ g m` is a multiple of `ℓ` for every `m`,
and `ℓ` is a nonzerodivisor of `S`, the divided-difference operator `δ_g` is `A`-linear and
satisfies `1 - g = m_ℓ ∘ δ_g` on `S`, so the same identity holds after applying any additive
functor (`Representation.map_symmetricAlgebraDividedDifference_comp_map_mulLeft`, in
`TauCeti.RepresentationTheory.SymmetricAlgebra.DividedDifference`). Combining the
two facts: if `G` is generated by elements `s` of this kind, such as pseudoreflections of a vector
space `V` acting on `Sym(V*)`, then an element of `Tor'ₙ₊₁^A(N, S)` killed by every `δ_s` is
fixed by every generator, hence invariant, hence zero
(`Representation.eq_zero_of_forall_Tor'_map_symmetricAlgebraDividedDifference_eq_zero`).

This is the vanishing mechanism of the homological proof that the invariants of a finite group
generated by pseudoreflections in characteristic zero form a polynomial algebra (Chevalley,
Shephard–Todd). There, `N` is the residue field `A ⧸ A₊`; once `Tor'₁^A(A ⧸ A₊, S)` is graded,
the divided differences lower degrees and so kill a homogeneous element of least degree, which
must therefore vanish. The grading is not constructed in this file.

## Main results

* `Representation.invariants_mapRepresentation_Tor'_symmetricAlgebraOverInvariants`: for finite
  `G` with `#G` invertible, `Tor'ₙ₊₁(N, Sym M)` has no nonzero invariant element.
* `Representation.eq_zero_of_forall_Tor'_map_symmetricAlgebraDividedDifference_eq_zero`: an
  element of `Tor'ₙ₊₁(N, Sym M)` killed by the divided differences of a generating set is zero.

## References

* R. Kane, *Reflection Groups and Invariant Theory*, CMS Books in Mathematics, Springer (2001),
  §§ 17–18.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), § 7.2.
-/

public section

open CategoryTheory MonoidalCategory

namespace Representation

universe u v

variable {R : Type u} {M : Type v} {G : Type*} [CommRing R] [Group G] [AddCommGroup M]
  [Module R M] (ρ : Representation R G M)

/-- The invariants of `Sym M`, as a module over the invariant subalgebra `A`, are isomorphic to
`A`, the tensor unit of `A`-modules. -/
private noncomputable def invariantsSymmetricAlgebraOverInvariantsIso :
    ModuleCat.of ρ.symmetricAlgebraInvariants ρ.symmetricAlgebraOverInvariants.invariants ≅
      ModuleCat.of ρ.symmetricAlgebraInvariants ρ.symmetricAlgebraInvariants :=
  LinearEquiv.toModuleIso
    { toFun p := ⟨p, (ρ.mem_invariants_symmetricAlgebraOverInvariants_iff p).1 p.2⟩
      invFun a := ⟨a, (ρ.mem_invariants_symmetricAlgebraOverInvariants_iff a).2 a.2⟩
      map_add' _ _ := rfl
      map_smul' _ _ := rfl }

variable [Fintype G] [Invertible (Fintype.card G : R)]

/-- **`Tor'ₙ₊₁(N, Sym M)` has no nonzero invariants.** Let `G` be finite with `#G` invertible in
`R`, and let `A = Sym(M)^G`. For every `A`-module `N`, the action of `G` on
`Tor'ₙ₊₁^A(N, Sym M)` induced by its action on `Sym M` has no nonzero invariant element. Indeed
these invariants are `Tor'ₙ₊₁^A(N, A)`, by `CategoryTheory.Functor.invariants_mapRepresentation`,
and this vanishes since `A` is the tensor unit. -/
theorem invariants_mapRepresentation_Tor'_symmetricAlgebraOverInvariants
    (N : ModuleCat.{max u v} ρ.symmetricAlgebraInvariants) (n : ℕ) :
    (((Tor' (ModuleCat.{max u v} ρ.symmetricAlgebraInvariants) (n + 1)).obj N).mapRepresentation
      ρ.symmetricAlgebraOverInvariants).invariants = ⊥ := by
  let : Invertible (Fintype.card G : ρ.symmetricAlgebraInvariants) :=
    (Invertible.map (algebraMap R ρ.symmetricAlgebraInvariants) _).copy _ (map_natCast _ _).symm
  rw [Functor.invariants_mapRepresentation, LinearMap.range_eq_bot]
  have h := (isZero_Tor'_succ_tensorUnit N n).of_iso
    (((Tor' _ (n + 1)).obj N).mapIso ρ.invariantsSymmetricAlgebraOverInvariantsIso)
  rw [h.eq_of_src (((Tor' _ (n + 1)).obj N).map _) 0, ModuleCat.hom_zero]

/-- **Elements of `Tor'ₙ₊₁(N, Sym M)` killed by divided differences vanish.** Let `G` be finite
with `#G` invertible in `R`, generated by a family `s i` such that `m - ρ (s i) m` is a multiple
of `ℓ i` for every `m`, where `ℓ i` is a nonzerodivisor of `Sym M`. Over `A = Sym(M)^G`, if an
element of `Tor'ₙ₊₁^A(N, Sym M)` is killed by the map induced by every divided-difference operator
`δ_(s i)`, then it is zero: it is fixed by every `s i`, by the operator identity
`1 - s i = m_(ℓ i) ∘ δ_(s i)`, hence invariant. -/
theorem eq_zero_of_forall_Tor'_map_symmetricAlgebraDividedDifference_eq_zero {ι : Type*}
    {s : ι → G} (hs : Subgroup.closure (Set.range s) = ⊤) (ℓ : ι → M)
    (hσ : ∀ i m, m - ρ (s i) m ∈ R ∙ ℓ i) (hℓ : ∀ i, IsLeftRegular (SymmetricAlgebra.ι R M (ℓ i)))
    (N : ModuleCat.{max u v} ρ.symmetricAlgebraInvariants) (n : ℕ)
    (x : ((Tor' (ModuleCat.{max u v} ρ.symmetricAlgebraInvariants) (n + 1)).obj N).obj
      (ModuleCat.of ρ.symmetricAlgebraInvariants (SymmetricAlgebra R M)))
    (hx : ∀ i, (((Tor' _ (n + 1)).obj N).map (ModuleCat.ofHom
      (ρ.symmetricAlgebraDividedDifference (s i) (ℓ i) (hσ i) (hℓ i)))).hom x = 0) :
    x = 0 := by
  have hinv : x ∈ (((Tor' _ (n + 1)).obj N).mapRepresentation
      ρ.symmetricAlgebraOverInvariants).invariants := by
    refine (mem_invariants_iff_of_closure_eq_top _ hs x).2 ?_
    rintro _ ⟨i, rfl⟩
    rw [Functor.mapRepresentation_apply]
    have h := congrArg (fun f ↦ f.hom x)
      (ρ.map_symmetricAlgebraDividedDifference_comp_map_mulLeft (s i) (ℓ i) (hσ i) (hℓ i)
        ((Tor' _ (n + 1)).obj N))
    simp only [ModuleCat.comp_apply, hx i, map_zero, ModuleCat.hom_sub, ModuleCat.hom_id,
      LinearMap.sub_apply, LinearMap.id_apply] at h
    exact (sub_eq_zero.1 h.symm).symm
  rwa [invariants_mapRepresentation_Tor'_symmetricAlgebraOverInvariants,
    Submodule.mem_bot] at hinv

end Representation
