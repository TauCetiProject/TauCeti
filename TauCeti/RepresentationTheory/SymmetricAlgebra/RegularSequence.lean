module

public import TauCeti.RepresentationTheory.Pseudoreflection
public import TauCeti.RepresentationTheory.SymmetricAlgebra.Flat
public import TauCeti.LinearAlgebra.SymmetricAlgebra.Grading
public import TauCeti.RingTheory.MvPolynomial.RegularSequence
public import Mathlib.RingTheory.Regular.Flat
import Mathlib.Data.List.FinRange

/-!
# Basic invariants as a regular sequence

A homogeneous polynomial presentation of an invariant algebra gives a regular sequence
in the ambient symmetric algebra whenever that algebra is flat over its invariants.
In particular, the basic invariants of a finite pseudoreflection group of invertible
order form a regular sequence in the polynomial functions on its representation.

Regularity includes properness of the generated ideal: positive-degree invariants lie
in the irrelevant ideal. It is not just the assertion that multiplication is injective
on successive quotients. This is the regular-sequence input for computing the graded
coinvariant algebra from homogeneous basic invariants.

The argument transports the regular sequence of polynomial coordinates to the
invariant algebra, then uses Mathlib's regular-sequence flat-base-change theorem.
The required flatness for pseudoreflection groups is supplied by the divided-difference
and Tor argument, not assumed as a consequence of polynomiality.

## References

* R. Kane, *Reflection Groups and Invariant Theory*, Springer (2001), §§ 17–18.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press
  (1990), Chapter 3.
-/

public section

open RingTheory.Sequence TauCeti.SymmetricAlgebra

namespace Representation

section CommRing

variable {K G M : Type*} [CommRing K] [Nontrivial K] [Monoid G] [AddCommMonoid M]
  [Module K M] (ρ : Representation K G M)

/-- If the symmetric algebra is flat over its invariants, any homogeneous polynomial
presentation by positive-degree invariants gives a regular sequence in the symmetric
algebra. The statement includes the empty sequence. -/
theorem isRegular_symmetricAlgebraInvariants_of_flat
    [Module.Flat ρ.symmetricAlgebraInvariants (SymmetricAlgebra K M)]
    {n : ℕ} (f : Fin n → ρ.symmetricAlgebraInvariants)
    (hf : ∀ i, ∃ d, 0 < d ∧
      (f i : SymmetricAlgebra K M) ∈ homogeneousSubmodule K M d)
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    IsRegular (SymmetricAlgebra K M) (List.ofFn fun i ↦ (f i : SymmetricAlgebra K M)) := by
  let e := AlgEquiv.ofBijective (MvPolynomial.aeval (R := K) f) hbij
  have hA : IsWeaklyRegular ρ.symmetricAlgebraInvariants (List.ofFn f) := by
    have := RingHomInvPair.of_ringEquiv e.toRingEquiv
    have := RingHomInvPair.of_ringEquiv_symm e.toRingEquiv
    have h := (e.toRingEquiv.toSemilinearEquiv.isWeaklyRegular_congr'
      ((List.finRange n).map (MvPolynomial.X (R := K)))).1
        (MvPolynomial.isRegular_map_X (List.finRange n)
          (List.nodup_finRange n)).toIsWeaklyRegular
    simpa [e, List.map_map, ← List.ofFn_eq_map, Function.comp_def] using h
  refine ⟨?_, ?_⟩
  · simpa [List.map_ofFn, Function.comp_def] using hA.of_flat (S := SymmetricAlgebra K M)
  · rw [Ideal.smul_eq_mul, Ideal.mul_top]
    have hle : Ideal.ofList (List.ofFn fun i ↦ (f i : SymmetricAlgebra K M)) ≤
        (HomogeneousIdeal.irrelevant (homogeneousSubmodule K M)).toIdeal := by
      rw [Ideal.ofList, Ideal.span_le]
      intro p hp
      obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hp
      obtain ⟨d, hd, hfd⟩ := hf i
      exact HomogeneousIdeal.mem_irrelevant_of_mem _ hd hfd
    rw [toIdeal_irrelevant_eq_ker_algebraMapInv] at hle
    exact (ne_top_of_le_ne_top (RingHom.ker_ne_top _) hle).symm

end CommRing

section Field

variable {K G V : Type*} [Field K] [Group G] [AddCommGroup V] [Module K V]
  [Fintype G] [Invertible (Fintype.card G : K)]

/-- Homogeneous basic invariants of a finite group generated by pseudoreflections form
a regular sequence in the polynomial functions `Sym(V*)`, provided the group order is
invertible in the field. No faithfulness or algebraic closedness is required. -/
theorem isRegular_symmetricAlgebraInvariants_dual_of_pseudoreflectionSubgroup_eq_top
    (ρ : Representation K G V) (hG : ρ.pseudoreflectionSubgroup = ⊤)
    {n : ℕ} (f : Fin n → ρ.dual.symmetricAlgebraInvariants)
    (hf : ∀ i, ∃ d, 0 < d ∧ (f i : SymmetricAlgebra K (Module.Dual K V)) ∈
      homogeneousSubmodule K (Module.Dual K V) d)
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    IsRegular (SymmetricAlgebra K (Module.Dual K V))
      (List.ofFn fun i ↦ (f i : SymmetricAlgebra K (Module.Dual K V))) := by
  have := ρ.faithfullyFlat_symmetricAlgebra_dual_of_finrank_quotient_eq_one
    (s := ((↑) : {g : G // Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1} → G))
    (by rwa [Subtype.range_coe_subtype, ← pseudoreflectionSubgroup_def]) (fun g ↦ g.2)
  exact ρ.dual.isRegular_symmetricAlgebraInvariants_of_flat f hf hbij

end Field

end Representation
