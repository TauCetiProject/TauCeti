/-!
# The coinvariant algebra is the regular representation

Let a finite group `G` act faithfully on a finite-dimensional vector space `M` over a field `k`,
and so on the symmetric algebra `S = Sym M`, with invariant subalgebra `A = Sym(M)^G` and
coinvariant algebra `C = S ⧸ A₊ · S`. When `S` is flat over `A`, which holds for a group generated
by pseudoreflections whose order is invertible in `k`, the coinvariant algebra has the character
of the regular representation, and over a field of characteristic zero it is isomorphic to the
regular representation `k[G]` as an ungraded representation. For `M = V*` with the contragredient
action this is Chevalley's theorem on the coinvariant algebra of a finite reflection group.

The proof is a trace computation, with no passage to fraction fields and no normal basis theorem.

* Each `g` acts on `S` by an `A`-algebra automorphism. If `g` moves some `y`, then the ideal of `S`
  generated by `g y - y` is nonzero, so it contains a nonzero invariant `a`, as `S` is an integral
  domain integral over `A`. Cyclicity of the trace gives `a * trace_A (g) = 0`
  (`AlgHom.mul_trace_toLinearMap_eq_zero_of_mem_span`), so `g` has trace zero over `A`. This uses
  neither flatness nor freeness, the trace being zero by definition for a non-free module.
* When `S` is flat over `A` it has an `A`-basis lifting a `k`-basis of `C`
  (`Representation.exists_basis_quotient_mk_eq_of_flat`). Every invariant is congruent to its
  constant term modulo `A₊ · S`, so the matrix of `g` on `C` is the matrix of `g` on `S` with its
  entries reduced to their constant terms, and the trace of `g` on `C` is the constant term of
  its trace over `A`.

So `g ≠ 1` has trace zero on `C`, while `1` has trace `dim C = |G|`
(`Representation.finrank_quotient_symmetricAlgebraHilbertIdeal_of_flat`). In characteristic zero
both `C` and `k[G]` are semisimple by Maschke's theorem, and semisimple representations with the
same character are equivalent
(`Representation.nonempty_equiv_of_character_eq_of_isSemisimpleRepresentation`).

This is the ungraded statement only: the coinvariant algebra is graded, and its graded character,
a finer invariant, is computed in
`TauCeti.RepresentationTheory.SymmetricAlgebra.Coinvariant.Character`. The fake-degree
polynomials extracted from it are not computed.

## Main results

* `Representation.trace_symmetricAlgebraOverInvariants_eq_zero`: an element acting nontrivially
  has trace zero on `Sym M` over its invariants, when `Sym M` is a domain.
* `Representation.trace_coinvariantAlgebra`: when `Sym M` is flat over its invariants, the trace
  on the coinvariant algebra is the constant term of the trace over the invariants.
* `Representation.character_coinvariantAlgebra`: for a faithful action, the coinvariant algebra
  has the regular character.
* `Representation.nonempty_equiv_coinvariantAlgebra_leftRegular`: in characteristic zero, it is
  equivalent to the regular representation.
* `character_coinvariantAlgebra_dual_of_pseudoreflectionSubgroup_eq_top` and
  `nonempty_equiv_coinvariantAlgebra_dual_leftRegular_of_pseudoreflectionSubgroup_eq_top`,
  in the namespace `Representation`: the same for the polynomial functions on a representation of
  a finite group generated by pseudoreflections.

## References

* C. Chevalley, *Invariants of finite groups generated by reflections*, Amer. J. Math. 77 (1955).
* N. Bourbaki, *Lie Groups and Lie Algebras*, Chapters 4–6, Springer (2002), Chapter V, § 5.
-/

public section

open TauCeti.SymmetricAlgebra

namespace Representation

section Domain

variable {R G M : Type*} [CommRing R] [Group G] [Finite G] [AddCommMonoid M] [Module R M]
  [IsDomain (SymmetricAlgebra R M)] (ρ : Representation R G M)

/-- **An element acting nontrivially has trace zero over the invariants.** For a finite group
acting on `M` with `Sym M` a domain, if `ρ g ≠ 1` then `g` has trace zero as an endomorphism of
`Sym M` over the invariant subalgebra `Sym(M)^G`. This is only informative when `Sym M` is free
of finite rank over its invariants; otherwise the trace vanishes by definition. -/
theorem trace_symmetricAlgebraOverInvariants_eq_zero {g : G} (hg : ρ g ≠ 1) :
    LinearMap.trace ρ.symmetricAlgebraInvariants (SymmetricAlgebra R M)
      (ρ.symmetricAlgebraOverInvariants g) = 0 := by
  obtain ⟨m, hm⟩ : ∃ m, ρ g m ≠ m := by
    by_contra! h
    exact hg (LinearMap.ext h)
  let σ : SymmetricAlgebra R M →ₐ[ρ.symmetricAlgebraInvariants] SymmetricAlgebra R M :=
    { SymmetricAlgebra.map R (ρ g) with
      commutes' a := by simpa using (ρ.mem_symmetricAlgebraInvariants a).1 a.2 g }
  have hσ : σ.toLinearMap = ρ.symmetricAlgebraOverInvariants g :=
    LinearMap.ext fun _ ↦ by simp [σ]
  -- `g` moves `ι m`, and the nonzero ideal generated by the difference contains a nonzero
  -- invariant `a`, since `Sym M` is a domain integral over the invariants.
  have hd : σ (SymmetricAlgebra.ι R M m) - SymmetricAlgebra.ι R M m ≠ 0 := by
    rw [sub_ne_zero]
    exact fun h ↦ hm (ι_injective R M (by simpa [σ] using h))
  obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot <|
    Ideal.under_ne_bot_of_integral_mem hd (Ideal.mem_span_singleton_self _)
      (Algebra.IsIntegral.isIntegral (R := ρ.symmetricAlgebraInvariants) _)
  have h := σ.mul_trace_toLinearMap_eq_zero_of_mem_span ha
  rw [hσ] at h
  exact (mul_eq_zero.1 h).resolve_left ha0

end Domain

section Field

variable {k G M : Type*} [Field k] [Group G] [Finite G] [AddCommGroup M] [Module k M]
  [FiniteDimensional k M] (ρ : Representation k G M)

/-- **The trace on the coinvariant algebra is the constant term of the trace over the
invariants.** If `Sym M` is flat over its invariants `A`, then for every `g` the trace of `g` on
the coinvariant algebra `Sym M ⧸ A₊ · Sym M` is the constant term of the trace of `g` on `Sym M`
over `A`. -/
theorem trace_coinvariantAlgebra
    [Module.Flat ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M)] (g : G) :
    LinearMap.trace k _ (ρ.coinvariantAlgebra g) =
      SymmetricAlgebra.algebraMapInv (LinearMap.trace ρ.symmetricAlgebraInvariants
        (SymmetricAlgebra k M) (ρ.symmetricAlgebraOverInvariants g) : SymmetricAlgebra k M) := by
  classical
  obtain ⟨t, b, v, -, hbv⟩ := ρ.exists_basis_quotient_mk_eq_of_flat
  have := Module.Finite.finite_basis v
  have : Fintype t := .ofFinite t
  set ε : SymmetricAlgebra k M →ₐ[k] k := SymmetricAlgebra.algebraMapInv
  -- The class of `p` has coordinates the constant terms of the coordinates of `p`.
  have hrepr : ∀ p, v.repr (Ideal.Quotient.mk ρ.symmetricAlgebraHilbertIdeal p) =
      fun i ↦ ε (b.repr p i) := by
    intro p
    suffices Ideal.Quotient.mk ρ.symmetricAlgebraHilbertIdeal p = ∑ i, ε (b.repr p i) • v i by
      rw [this, v.repr_sum_self]
    conv_lhs => rw [← b.sum_repr p]
    rw [map_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [← hbv, ← Ideal.Quotient.mkₐ_eq_mk k,
      ← map_smul (Ideal.Quotient.mkₐ k ρ.symmetricAlgebraHilbertIdeal), Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq, Subalgebra.smul_def, smul_eq_mul, Algebra.smul_def, ← sub_mul]
    exact Ideal.mul_mem_right _ _ <|
      ρ.sub_algebraMap_algebraMapInv_mem_symmetricAlgebraHilbertIdeal (b.repr p i).2
  rw [LinearMap.trace_eq_matrix_trace k v, LinearMap.trace_eq_matrix_trace _ b, Matrix.trace,
    Matrix.trace, AddSubmonoidClass.coe_finsetSum, map_sum]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  simp only [Matrix.diag_apply, LinearMap.toMatrix_apply, ← hbv,
    coinvariantAlgebra_mk, hrepr, symmetricAlgebraOverInvariants_apply]

/-- **The coinvariant algebra has the regular character.** If a finite group `G` acts faithfully
on a finite-dimensional space `M` and `Sym M` is flat over its invariants `A`, then on the
coinvariant algebra `Sym M ⧸ A₊ · Sym M` the identity has trace `|G|` and every other element has
trace zero. -/
theorem character_coinvariantAlgebra [DecidableEq G]
    [Module.Flat ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M)]
    (hρ : Function.Injective ρ) (g : G) :
    ρ.coinvariantAlgebra.character g = if g = 1 then (Nat.card G : k) else 0 := by
  split_ifs with hg
  · rw [hg, character, map_one, LinearMap.trace_one,
      ρ.finrank_quotient_symmetricAlgebraHilbertIdeal_of_flat hρ]
  · rw [character, trace_coinvariantAlgebra,
      trace_symmetricAlgebraOverInvariants_eq_zero _ (by simpa using hρ.ne hg)]
    simp

/-- **The coinvariant algebra is the regular representation.** If a finite group `G` acts
faithfully on a finite-dimensional space `M` over a field of characteristic zero, and `Sym M` is
flat over its invariants `A`, then the coinvariant algebra `Sym M ⧸ A₊ · Sym M`, as an ungraded
representation, is equivalent to the regular representation `k[G]`. -/
theorem nonempty_equiv_coinvariantAlgebra_leftRegular [CharZero k]
    [Module.Flat ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M)]
    (hρ : Function.Injective ρ) :
    Nonempty (ρ.coinvariantAlgebra.Equiv (leftRegular k G)) := by
  classical
  have : NeZero (Nat.card G : k) := ⟨Nat.cast_ne_zero.2 Nat.card_pos.ne'⟩
  refine nonempty_equiv_of_character_eq_of_isSemisimpleRepresentation _ _ <| funext fun g ↦ ?_
  rw [ρ.character_coinvariantAlgebra hρ, TauCeti.char_ofMulAction]
  split_ifs with hg <;> simp [hg]

end Field

section Pseudoreflection

variable {K G V : Type*} [Field K] [Group G] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] (ρ : Representation K G V)

/-- **The coinvariant algebra of a pseudoreflection group has the regular character.** If a
finite group `G`, whose order is invertible in the field `K`, acts faithfully on a
finite-dimensional vector space `V` and is generated by pseudoreflections, then on the coinvariant
algebra of the polynomial functions `Sym(V*)` the identity has trace `|G|` and every other element
has trace zero. -/
theorem character_coinvariantAlgebra_dual_of_pseudoreflectionSubgroup_eq_top [Fintype G]
    [DecidableEq G] [Invertible (Fintype.card G : K)] (hG : ρ.pseudoreflectionSubgroup = ⊤)
    (hρ : Function.Injective ρ) (g : G) :
    ρ.dual.coinvariantAlgebra.character g =
      if g = 1 then (Nat.card G : K) else 0 :=
  have := ρ.faithfullyFlat_symmetricAlgebra_dual_of_pseudoreflectionSubgroup_eq_top hG
  ρ.dual.character_coinvariantAlgebra (ρ.dual_injective_iff.2 hρ) g

/-- **Chevalley's theorem: the coinvariant algebra of a reflection group is the regular
representation.** If a finite group `G` acts faithfully on a finite-dimensional vector space `V`
over a field of characteristic zero and is generated by pseudoreflections, then the coinvariant
algebra of the polynomial functions `Sym(V*)`, as an ungraded representation, is equivalent to the
regular representation `K[G]`. -/
theorem nonempty_equiv_coinvariantAlgebra_dual_leftRegular_of_pseudoreflectionSubgroup_eq_top
    [Finite G] [CharZero K] (hG : ρ.pseudoreflectionSubgroup = ⊤) (hρ : Function.Injective ρ) :
    Nonempty (ρ.dual.coinvariantAlgebra.Equiv (leftRegular K G)) :=
  have := Fintype.ofFinite G
  have : Invertible (Fintype.card G : K) :=
    invertibleOfNonzero (Nat.cast_ne_zero.2 Fintype.card_ne_zero)
  have := ρ.faithfullyFlat_symmetricAlgebra_dual_of_pseudoreflectionSubgroup_eq_top hG
  ρ.dual.nonempty_equiv_coinvariantAlgebra_leftRegular (ρ.dual_injective_iff.2 hρ)

end Pseudoreflection

end Representation
