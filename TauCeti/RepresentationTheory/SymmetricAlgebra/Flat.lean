module

public import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
public import TauCeti.RepresentationTheory.SymmetricAlgebra.Pseudoreflection
public import TauCeti.RepresentationTheory.SymmetricAlgebra.Tor

/-!
# Flatness over polynomial invariants

For a finite group whose order is invertible, divided differences for a generating family
force the symmetric algebra to be faithfully flat over its invariant subalgebra.

In particular, if a finite group acting on a vector space is generated by elements whose fixed
spaces have codimension one, then the polynomial functions `Sym(V*)` are faithfully flat over
their invariants. This supplies the flat extension used in regularity descent for reflection
invariants; it does not require polynomial generators for the invariant algebra.

The flatness statement uses vanishing of Mathlib's `CategoryTheory.Tor'`, which derives the
first tensor factor. Faithfulness follows from the existing integrality of the symmetric
algebra over finite-group invariants.

## References

* R. Kane, *Reflection Groups and Invariant Theory*, Springer (2001), §§ 17–18.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), § 7.2.
-/

public section

namespace Representation

universe u v

variable {R : Type u} {M : Type v} {G : Type*} [CommRing R] [Group G] [AddCommGroup M]
  [Module R M] (ρ : Representation R G M) [Fintype G] [Invertible (Fintype.card G : R)]

/-- A symmetric algebra is flat over its invariants if the group has a generating family
admitting divided differences with nonzerodivisor denominators. -/
theorem flat_symmetricAlgebra {ι : Type*} {s : ι → G}
    (hs : Subgroup.closure (Set.range s) = ⊤) (ℓ : ι → M)
    (hσ : ∀ i m, m - ρ (s i) m ∈ R ∙ ℓ i)
    (hℓ : ∀ i, IsLeftRegular (SymmetricAlgebra.ι R M (ℓ i))) :
    Module.Flat ρ.symmetricAlgebraInvariants (SymmetricAlgebra R M) :=
  ModuleCat.flat_of_isZero_Tor'_one
    (ModuleCat.of ρ.symmetricAlgebraInvariants (SymmetricAlgebra R M))
    (fun N ↦ ρ.isZero_Tor'_succ_symmetricAlgebra hs ℓ hσ hℓ N 0)

/-- A symmetric algebra is faithfully flat over its invariants if the group has a generating
family admitting divided differences with nonzerodivisor denominators. -/
theorem faithfullyFlat_symmetricAlgebra {ι : Type*} {s : ι → G}
    (hs : Subgroup.closure (Set.range s) = ⊤) (ℓ : ι → M)
    (hσ : ∀ i m, m - ρ (s i) m ∈ R ∙ ℓ i)
    (hℓ : ∀ i, IsLeftRegular (SymmetricAlgebra.ι R M (ℓ i))) :
    Module.FaithfullyFlat ρ.symmetricAlgebraInvariants (SymmetricAlgebra R M) := by
  let := ρ.flat_symmetricAlgebra hs ℓ hσ hℓ
  refine ⟨fun {m} hm ↦ ?_⟩
  rw [Ideal.smul_top_eq_map, ne_eq, Submodule.restrictScalars_eq_top_iff]
  exact (Ideal.map_eq_top_iff _
    (FaithfulSMul.algebraMap_injective ρ.symmetricAlgebraInvariants (SymmetricAlgebra R M))
    (fun p ↦ Algebra.IsIntegral.isIntegral p)).not.mpr hm.ne_top

/-- Polynomial functions on a vector space are faithfully flat over their invariants when the
group is generated by elements with codimension-one fixed spaces and its order is invertible
in the field. No assumption of finite-dimensionality or faithfulness of the action is needed. -/
theorem faithfullyFlat_symmetricAlgebra_dual_of_finrank_quotient_eq_one
    {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (ρ : Representation K G V) [Invertible (Fintype.card G : K)] {ι : Type*} {s : ι → G}
    (hs : Subgroup.closure (Set.range s) = ⊤)
    (hcodim : ∀ i, Module.finrank K (V ⧸ (ρ (s i)).fixedSubmodule) = 1) :
    Module.FaithfullyFlat ρ.dual.symmetricAlgebraInvariants
      (SymmetricAlgebra K (Module.Dual K V)) := by
  choose ℓ hℓ hker _ using fun i ↦
    ρ.exists_unique_symmetricAlgebraDividedDifference_of_finrank_quotient_eq_one (s i) (hcodim i)
  refine ρ.dual.faithfullyFlat_symmetricAlgebra hs ℓ (fun i ↦ ?_)
    (fun i ↦ SymmetricAlgebra.isLeftRegular_ι (hℓ i))
  apply ρ.sub_dual_apply_mem_span_singleton
  rw [hker, LinearMap.fixedSubmodule_eq_ker, Module.End.one_eq_id]

end Representation
