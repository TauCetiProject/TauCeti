/-!
# Polynomial functions are free over the invariants of a pseudoreflection group

Let a group `G` act linearly on a module `M`, and so on the symmetric algebra `S = Sym M`, with
invariant subalgebra `A = Sym(M)^G`, the ideal `A₊` of invariants with zero constant term, and
Hilbert ideal `A₊ · S`. The quotient `S ⧸ A₊ · S` is the coinvariant algebra.

Homogeneous elements of `S` whose images span the coinvariant algebra generate `S` as an
`A`-module; this is the graded Nakayama lemma, proved by induction on the degree. Over a field
`k`, for a finite group acting on a finite-dimensional space `M` such that `S` is flat over `A`,
homogeneous lifts of a `k`-basis of the coinvariant algebra are moreover linearly independent
over `A`: a relation among them has all its coefficients in `A₊`, flatness then puts the module
of relations inside `A₊` times itself, and the Nakayama lemma, in the domain `A`, makes it zero.
So `S` is a free `A`-module, of rank the dimension of the coinvariant algebra.

When the action is faithful, the rank of `S` over `A` is `|G|`, the degree of the extension of
fraction fields (`Representation.finrank_symmetricAlgebraInvariants`), so the coinvariant algebra
has dimension `|G|`.

For a finite group generated by pseudoreflections, whose order is invertible in the field, the
polynomial functions `Sym(V*)` are faithfully flat over their invariants
(`Representation.faithfullyFlat_symmetricAlgebra_dual_of_pseudoreflectionSubgroup_eq_top`).
So `Sym(V*)` is a free module over `Sym(V*)^G`, with a basis of homogeneous lifts of any basis
of the coinvariant algebra; for a faithful action its rank and the dimension of the coinvariant
algebra are `|G|`.

## Main results

* `Representation.span_range_eq_top_of_span_range_mk_eq_top`: homogeneous elements spanning the
  coinvariant algebra generate `Sym M` over its invariants.
* `Representation.linearIndependent_of_linearIndependent_mk`: if `Sym M` is flat over its
  invariants, homogeneous lifts of a basis of the coinvariant algebra are linearly independent
  over the invariants, hence a basis.
* `Representation.exists_basis_quotient_mk_eq_of_flat`: so `Sym M` has a homogeneous basis over
  its invariants lifting a basis of the coinvariant algebra.
* `Representation.free_symmetricAlgebra_of_flat`,
  `Representation.finrank_symmetricAlgebraInvariants_eq_finrank_quotient`: then `Sym M` is free
  over its invariants, of rank the dimension of the coinvariant algebra.
* `Representation.finrank_quotient_symmetricAlgebraHilbertIdeal_of_flat`: for a faithful action,
  that dimension is `|G|`.
* `Representation.free_symmetricAlgebra_dual_of_pseudoreflectionSubgroup_eq_top`: for a group
  generated by pseudoreflections whose order is invertible, `Sym(V*)` is free over `Sym(V*)^G`.
* `finrank_quotient_symmetricAlgebraHilbertIdeal_dual_of_pseudoreflectionSubgroup_eq_top`, in
  the namespace `Representation`: for such a group acting faithfully, the coinvariant algebra has
  dimension `|G|`.

## References

* C. Chevalley, *Invariants of finite groups generated by reflections*, Amer. J. Math. 77 (1955).
* N. Bourbaki, *Lie Groups and Lie Algebras*, Chapters 4–6, Springer (2002), Chapter V, § 5.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press (1990),
  Chapter 3.
* R. Kane, *Reflection Groups and Invariant Theory*, CMS Books in Mathematics, Springer (2001),
  §§ 17–18.
-/

public section

open TauCeti.SymmetricAlgebra

namespace Representation

section CommRing

variable {R G M : Type*} [CommRing R] [Monoid G] [AddCommMonoid M] [Module R M]
variable (ρ : Representation R G M)

/-- **Graded Nakayama lemma for the coinvariant algebra.** Homogeneous elements of `Sym M` whose
images span the coinvariant algebra `Sym M ⧸ A₊ · Sym M` over `R` generate `Sym M` as a module
over the invariant subalgebra `A = Sym(M)^G`. -/
theorem span_range_eq_top_of_span_range_mk_eq_top {ι : Type*} (b : ι → SymmetricAlgebra R M)
    (hb : ∀ i, ∃ d, b i ∈ homogeneousSubmodule R M d)
    (hspan : Submodule.span R
      (Set.range (Ideal.Quotient.mkₐ R ρ.symmetricAlgebraHilbertIdeal ∘ b)) = ⊤) :
    Submodule.span ρ.symmetricAlgebraInvariants (Set.range b) = ⊤ := by
  classical
  set U := Submodule.span ρ.symmetricAlgebraInvariants (Set.range b)
  set π := GradedRing.proj (homogeneousSubmodule R M)
  -- Every homogeneous element lies in `U`, by strong induction on its degree. (The graded
  -- Nakayama lemma `TauCeti.InternalGrading.eq_top_of_piece_le_sup_positive_smul_top` is stated
  -- for `ℤ`-graded modules over a `ℤ`-graded algebra; the induction is direct here.)
  have key : ∀ n, ∀ p ∈ homogeneousSubmodule R M n, p ∈ U := by
    intro n
    induction n using Nat.strong_induction_on with
    | ind n ih =>
    -- The degree-`n` component of an element of `A₊ · Sym M` is an `A`-combination of
    -- components of lower degree.
    have hI : ∀ q ∈ ρ.symmetricAlgebraHilbertIdeal, π n q ∈ U := by
      intro q hq
      rw [symmetricAlgebraHilbertIdeal_eq_span] at hq
      obtain ⟨N, f, g, rfl⟩ := Submodule.mem_span_set'.1 hq
      rw [map_sum]
      refine U.sum_mem fun j _ ↦ ?_
      obtain ⟨hgA, m, hm, hgm⟩ := (g j).2
      rw [smul_eq_mul, GradedRing.proj_apply, DirectSum.coe_decompose_mul_of_right_mem _ _ hgm]
      split_ifs with hmn
      · have h := U.smul_mem ⟨_, hgA⟩ (ih (n - m) (by omega) _ (SetLike.coe_mem
          (DirectSum.decompose (homogeneousSubmodule R M) (f j) (n - m))))
        rwa [Subalgebra.smul_def, smul_eq_mul, mul_comm] at h
      · exact U.zero_mem
    intro p hp
    -- Modulo the Hilbert ideal, `p` is an `R`-combination `q` of the `b i`.
    obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.1
      (hspan ▸ Submodule.mem_top (x := Ideal.Quotient.mkₐ R ρ.symmetricAlgebraHilbertIdeal p))
    set q := c.sum fun i a ↦ a • b i
    have hpq : p - q ∈ ρ.symmetricAlgebraHilbertIdeal := by
      rw [← Ideal.Quotient.eq, ← Ideal.Quotient.mkₐ_eq_mk R, ← hc, map_finsuppSum]
      simp [map_smul]
    -- The degree-`n` component of `q` is an `R`-combination of the `b i` of degree `n`.
    have hq : π n q ∈ U := by
      rw [map_finsuppSum]
      refine Submodule.finsuppSum_mem _ _ _ _ fun i _ ↦ ?_
      obtain ⟨d, hd⟩ := hb i
      rw [GradedRing.proj_apply]
      by_cases hdn : d = n
      · subst hdn
        rw [DirectSum.decompose_of_mem_same _ (Submodule.smul_mem _ _ hd)]
        exact Submodule.smul_of_tower_mem U _ (Submodule.subset_span ⟨i, rfl⟩)
      · rw [DirectSum.decompose_of_mem_ne _ (Submodule.smul_mem _ _ hd) hdn]
        exact U.zero_mem
    have := U.add_mem (hI _ hpq) hq
    rwa [← map_add, sub_add_cancel, GradedRing.proj_apply,
      DirectSum.decompose_of_mem_same _ hp] at this
  refine eq_top_iff.2 fun p _ ↦ ?_
  rw [← DirectSum.sum_support_decompose (homogeneousSubmodule R M) p]
  exact U.sum_mem fun n _ ↦ key n _ (SetLike.coe_mem _)

end CommRing

section Field

variable {k G M : Type*} [Field k] [Group G] [Finite G] [AddCommGroup M] [Module k M]
  [FiniteDimensional k M] (ρ : Representation k G M)

/-- **Homogeneous lifts of a basis of the coinvariant algebra are independent.** For a finite group
acting on a finite-dimensional space `M` such that `Sym M` is flat over its invariants `A`,
homogeneous elements of `Sym M` whose images form a `k`-basis of the coinvariant algebra
`Sym M ⧸ A₊ · Sym M` are linearly independent over `A`. With
`Representation.span_range_eq_top_of_span_range_mk_eq_top`, they form an `A`-basis of `Sym M`. -/
theorem linearIndependent_of_linearIndependent_mk
    [Module.Flat ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M)] {ι : Type*}
    (b : ι → SymmetricAlgebra k M) (hb : ∀ i, ∃ d, b i ∈ homogeneousSubmodule k M d)
    (hli : LinearIndependent k (Ideal.Quotient.mkₐ k ρ.symmetricAlgebraHilbertIdeal ∘ b))
    (hspan : Submodule.span k
      (Set.range (Ideal.Quotient.mkₐ k ρ.symmetricAlgebraHilbertIdeal ∘ b)) = ⊤) :
    LinearIndependent ρ.symmetricAlgebraInvariants b := by
  classical
  set A := ρ.symmetricAlgebraInvariants
  set 𝔪 := (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under A
  have := hli.finite
  have : Fintype ι := Fintype.ofFinite ι
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  have : IsNoetherian A (ι →₀ A) := isNoetherian_of_isNoetherianRing_of_finite A (ι →₀ A)
  set f := Finsupp.linearCombination A b
  have hf : Function.Surjective f := by
    rw [← LinearMap.range_eq_top, Finsupp.range_linearCombination]
    exact ρ.span_range_eq_top_of_span_range_mk_eq_top b hb hspan
  -- A relation among the `b i` has its coefficients in `A₊`: their constant terms give a
  -- relation among the images of the `b i` in the coinvariant algebra.
  have hker : LinearMap.ker f ≤ 𝔪 • ⊤ := by
    intro x hx
    set ε : SymmetricAlgebra k M →ₐ[k] k := SymmetricAlgebra.algebraMapInv
    have hε : ∀ a : A, (a : SymmetricAlgebra k M) - algebraMap k _ (ε a) ∈
        ρ.symmetricAlgebraHilbertIdeal := fun a ↦
      ρ.sub_algebraMap_algebraMapInv_mem_symmetricAlgebraHilbertIdeal a.2
    have hc : ∀ i, ε (x i) = 0 := by
      refine Fintype.linearIndependent_iff.1 hli (fun i ↦ ε (x i)) ?_
      have hx : ∑ i, (x i : SymmetricAlgebra k M) * b i = 0 := by
        simpa [f, Finsupp.linearCombination_apply, Finsupp.sum_fintype, Subalgebra.smul_def]
          using hx
      have hmem : ∑ i, ε (x i) • b i - ∑ i, (x i : SymmetricAlgebra k M) * b i ∈
          ρ.symmetricAlgebraHilbertIdeal := by
        rw [← Finset.sum_sub_distrib]
        refine Ideal.sum_mem _ fun i _ ↦ ?_
        rw [Algebra.smul_def, ← sub_mul, ← neg_sub]
        exact Ideal.mul_mem_right _ _ (neg_mem (hε (x i)))
      rw [hx, sub_zero] at hmem
      simp only [Function.comp_apply, ← map_smul, ← map_sum]
      rwa [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    have hx : x = ∑ i, x i • Finsupp.single i 1 := by
      simp [Finsupp.univ_sum_single]
    rw [hx]
    refine Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem_smul ?_ Submodule.mem_top
    rw [Ideal.mem_comap, toIdeal_irrelevant_eq_ker_algebraMapInv, RingHom.mem_ker]
    exact hc i
  -- By flatness, `ker f ⊓ A₊ • A^(ι) = A₊ • ker f`, so `ker f = A₊ • ker f`.
  have hle : LinearMap.ker f ≤ 𝔪 • LinearMap.ker f := by
    have h := LinearMap.ker_inf_smul_top_eq_smul_of_flat (R := A) (M := ι →₀ A)
      (N := SymmetricAlgebra k M) 𝔪 f hf
    exact (le_inf le_rfl hker).trans_eq h
  -- Nakayama: some `r ≡ 1 mod A₊` kills `ker f`; `r ≠ 0`, and `A` is a domain.
  obtain ⟨r, hr, hr0⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul
    (M := ι →₀ A) 𝔪 (LinearMap.ker f) (IsNoetherian.noetherian _) hle
  have hr : r ≠ 0 := by
    rintro rfl
    exact Ideal.IsPrime.ne_top inferInstance
      ((Ideal.eq_top_iff_one _).2 (by simpa using neg_mem hr))
  rw [linearIndependent_iff_ker, eq_bot_iff]
  intro x hx
  exact (smul_eq_zero.1 (hr0 x hx)).resolve_left hr

/-- **Compatible bases.** If `Sym M` is flat over the invariants `A` of a finite group acting on a
finite-dimensional space `M`, it has an `A`-basis `b` of homogeneous elements whose images form a
`k`-basis `v` of the coinvariant algebra `Sym M ⧸ A₊ · Sym M`. -/
theorem exists_basis_quotient_mk_eq_of_flat
    [Module.Flat ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M)] :
    ∃ (t : Set (SymmetricAlgebra k M ⧸ ρ.symmetricAlgebraHilbertIdeal))
      (b : Module.Basis t ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M))
      (v : Module.Basis t k (SymmetricAlgebra k M ⧸ ρ.symmetricAlgebraHilbertIdeal)),
      (∀ i, ∃ n, b i ∈ homogeneousSubmodule k M n) ∧
        ∀ i, Ideal.Quotient.mk ρ.symmetricAlgebraHilbertIdeal (b i) = v i := by
  obtain ⟨t, hts, htspan, htli⟩ := exists_linearIndependent k
    {y : SymmetricAlgebra k M ⧸ ρ.symmetricAlgebraHilbertIdeal |
      ∃ n, ∃ p ∈ homogeneousSubmodule k M n,
        Ideal.Quotient.mkₐ k ρ.symmetricAlgebraHilbertIdeal p = y}
  -- The images of homogeneous elements span the coinvariant algebra.
  replace htspan : Submodule.span k t = ⊤ := by
    classical
    refine htspan.trans (eq_top_iff.2 fun y _ ↦ ?_)
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mkₐ_surjective k _ y
    rw [← DirectSum.sum_support_decompose (homogeneousSubmodule k M) p, map_sum]
    exact Submodule.sum_mem _ fun n _ ↦ Submodule.subset_span ⟨n, _, SetLike.coe_mem _, rfl⟩
  choose n b hb hbt using fun y : t ↦ hts y.2
  have hmk : Ideal.Quotient.mkₐ k ρ.symmetricAlgebraHilbertIdeal ∘ b = (↑) := funext hbt
  have hli : LinearIndependent k (Ideal.Quotient.mkₐ k ρ.symmetricAlgebraHilbertIdeal ∘ b) :=
    hmk ▸ htli
  have hspan : Submodule.span k
      (Set.range (Ideal.Quotient.mkₐ k ρ.symmetricAlgebraHilbertIdeal ∘ b)) = ⊤ := by
    rwa [hmk, Subtype.range_coe]
  refine ⟨t, .mk (ρ.linearIndependent_of_linearIndependent_mk b (fun y ↦ ⟨_, hb y⟩) hli hspan)
    (ρ.span_range_eq_top_of_span_range_mk_eq_top b (fun y ↦ ⟨_, hb y⟩) hspan).ge,
    .mk htli (by rw [Subtype.range_coe, htspan]), fun y ↦ ⟨_, by simpa using hb y⟩,
    fun y ↦ by simpa using hbt y⟩

/-- If `Sym M` is flat over the invariants `A` of a finite group acting on a finite-dimensional
space `M`, then it is a free `A`-module. -/
theorem free_symmetricAlgebra_of_flat
    [Module.Flat ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M)] :
    Module.Free ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M) :=
  have ⟨_, b, _⟩ := ρ.exists_basis_quotient_mk_eq_of_flat
  .of_basis b

/-- If `Sym M` is flat over the invariants `A` of a finite group acting on a finite-dimensional
space `M`, then its rank over `A` is the dimension of the coinvariant algebra
`Sym M ⧸ A₊ · Sym M`. -/
theorem finrank_symmetricAlgebraInvariants_eq_finrank_quotient
    [Module.Flat ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M)] :
    Module.finrank ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M) =
      Module.finrank k (SymmetricAlgebra k M ⧸ ρ.symmetricAlgebraHilbertIdeal) := by
  obtain ⟨_, b, v, -⟩ := ρ.exists_basis_quotient_mk_eq_of_flat
  rw [Module.finrank_eq_nat_card_basis b, Module.finrank_eq_nat_card_basis v]

/-- **The coinvariant algebra has dimension `|G|`.** If a finite group `G` acts faithfully on a
finite-dimensional space `M` and `Sym M` is flat over its invariants `A`, then the coinvariant
algebra `Sym M ⧸ A₊ · Sym M` has dimension `|G|`. -/
theorem finrank_quotient_symmetricAlgebraHilbertIdeal_of_flat
    [Module.Flat ρ.symmetricAlgebraInvariants (SymmetricAlgebra k M)]
    (hρ : Function.Injective ρ) :
    Module.finrank k (SymmetricAlgebra k M ⧸ ρ.symmetricAlgebraHilbertIdeal) = Nat.card G := by
  rw [← finrank_symmetricAlgebraInvariants_eq_finrank_quotient,
    finrank_symmetricAlgebraInvariants _ hρ]

end Field

section Pseudoreflection

variable {K G V : Type*} [Field K] [Group G] [Fintype G] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] (ρ : Representation K G V) [Invertible (Fintype.card G : K)]

/-- **Polynomial functions are free over reflection invariants.** If a finite group `G`, whose
order is invertible in the field `K`, acts linearly on a finite-dimensional vector space `V` and is
generated by pseudoreflections, then `Sym(V*)` is a free module over the invariants `Sym(V*)^G`.
Its rank is `|G|` when the action is faithful (`Representation.finrank_symmetricAlgebraInvariants`),
and homogeneous lifts of any basis of the coinvariant algebra form a basis
(`Representation.linearIndependent_of_linearIndependent_mk`). -/
theorem free_symmetricAlgebra_dual_of_pseudoreflectionSubgroup_eq_top
    (hG : ρ.pseudoreflectionSubgroup = ⊤) :
    Module.Free ρ.dual.symmetricAlgebraInvariants (SymmetricAlgebra K (Module.Dual K V)) :=
  have := ρ.faithfullyFlat_symmetricAlgebra_dual_of_pseudoreflectionSubgroup_eq_top hG
  ρ.dual.free_symmetricAlgebra_of_flat

/-- **The coinvariant algebra of a pseudoreflection group has dimension `|G|`.** If a finite group
`G`, whose order is invertible in the field `K`, acts faithfully and linearly on a
finite-dimensional vector space `V` and is generated by pseudoreflections, then the coinvariant
algebra `Sym(V*) ⧸ A₊ · Sym(V*)`, for `A = Sym(V*)^G`, has dimension `|G|`. -/
theorem finrank_quotient_symmetricAlgebraHilbertIdeal_dual_of_pseudoreflectionSubgroup_eq_top
    (hG : ρ.pseudoreflectionSubgroup = ⊤) (hρ : Function.Injective ρ) :
    Module.finrank K (SymmetricAlgebra K (Module.Dual K V) ⧸ ρ.dual.symmetricAlgebraHilbertIdeal) =
      Nat.card G :=
  have := ρ.faithfullyFlat_symmetricAlgebra_dual_of_pseudoreflectionSubgroup_eq_top hG
  ρ.dual.finrank_quotient_symmetricAlgebraHilbertIdeal_of_flat (ρ.dual_injective_iff.2 hρ)

end Pseudoreflection

end Representation
