module

public import TauCeti.LinearAlgebra.RootSystem.Weyl.Pseudoreflection
public import TauCeti.RepresentationTheory.SymmetricAlgebra.Hyperplane.Jacobian

/-!
# Polynomial invariants of a Weyl group: exponents and the Jacobian

Let `P` be a finite crystallographic reduced root pairing over a linearly ordered field `K`, with a
base `b`, and let its Weyl group `W` act on the weight space `M`, hence on the polynomial functions
`Sym(M*)` through the contragredient action. The Weyl group is generated by pseudoreflections, the
root reflections (`RootPairing.pseudoreflectionSubgroup_weylGroupRootRep`), so by the
Chevalley–Shephard–Todd theorem
(`exists_bijective_aeval_symmetricAlgebraInvariants_dual_of_pseudoreflectionSubgroup_eq_top`,
in the namespace `Representation`) the invariants `Sym(M*)^W` form a polynomial algebra on
homogeneous basic invariants `f₁, …, f_r` of degrees `d₁, …, d_r`, and `∏ dᵢ = |W|` since `W`
acts faithfully (`RootPairing.weylGroupRootRep_injective`,
`Representation.prod_eq_card_of_bijective_aeval_symmetricAlgebraInvariants`).

The pseudoreflections of `W` are exactly the reflections in the positive roots, one for each
positive root (`RootPairing.card_pseudoreflections_weylGroupRootRep_eq_ncard_posRoots`).
This file specializes the two results of the general theory that count or locate the
pseudoreflections.

* **The exponents sum to the number of positive roots**: `∑ (dᵢ - 1) = |Φ⁺|`. Since there are
  `r = dim M` basic invariants, this says `∑ dᵢ = r + |Φ⁺|`.
* **The Jacobian is the product of the positive coroots**: the reflecting hyperplanes of `W` are the
  kernels `ker α^∨` of the positive coroots, each with pointwise stabilizer `{1, s_α}` of order two,
  so the Jacobian `det (∂fᵢ/∂xⱼ)` of the basic invariants is a nonzero scalar times
  `∏_{α ∈ Φ⁺} α^∨`, each linear form `α^∨` read as a degree-one element of `Sym(M*)`.

## Main results

* `RootPairing.sum_sub_one_eq_ncard_posRoots_of_bijective_aeval`: the sum of the exponents
  `dᵢ - 1` of a Weyl group is the number of positive roots.
* `RootPairing.exists_jacobian_eq_algebraMap_mul_prod_posRootsFinset`: the Jacobian of basic
  invariants of a Weyl group is a nonzero scalar times the product of the positive coroots.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4--6*, Ch. V, §5.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press (1990),
  §§ 3.9 and 3.13.
-/

public section

open Module SymmetricAlgebra TauCeti.SymmetricAlgebra

namespace RootPairing

variable {ι K M N : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N] [FiniteDimensional K M]
  (P : RootPairing ι K M N) [Finite ι] [P.IsCrystallographic] [P.IsReduced]
  [Finite P.weylGroup] (b : P.Base)

/-- **The exponents of a Weyl group sum to the number of positive roots.** If homogeneous
invariants `fᵢ` of degrees `dᵢ` form a polynomial basis of the polynomial functions on the weight
space invariant under the Weyl group, then `∑ (dᵢ - 1) = |Φ⁺|`. -/
theorem sum_sub_one_eq_ncard_posRoots_of_bijective_aeval {n : Type*} [Fintype n]
    {f : n → P.weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : n → ℕ}
    (hf : ∀ i, (f i : SymmetricAlgebra K (Dual K M)) ∈ homogeneousSubmodule K (Dual K M) (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∑ i, (d i - 1) = (TauCeti.posRoots P b).ncard := by
  let := Fintype.ofFinite P.weylGroup
  rw [P.weylGroupRootRep.sum_sub_one_eq_card_of_bijective_aeval_symmetricAlgebraInvariants_dual
    P.weylGroupRootRep_injective hf hbij,
    P.card_pseudoreflections_weylGroupRootRep_eq_ncard_posRoots b]

omit [FiniteDimensional K M] in
include b in
/-- The inertia group in `W` of the hyperplane of a root, the ideal of `Sym(M*)` spanned by its
coroot, is `{1, sᵢ}`, of order two. -/
private theorem natCard_inertia_span_coroot' (i : ι) :
    letI := P.weylGroupRootRep.dual.symmetricAlgebraMulSemiringAction
    Nat.card ((Ideal.span {SymmetricAlgebra.ι K (Dual K M) (P.coroot' i)}).inertia P.weylGroup) =
      2 := by
  let := P.weylGroupRootRep.dual.symmetricAlgebraMulSemiringAction
  set ρ := P.weylGroupRootRep
  have hH : LinearMap.ker (P.coroot' i) ∈ ρ.reflectingHyperplanes := by
    rw [← fixedSubmodule_weylGroupRootRep_ofIdx]
    exact ρ.fixedSubmodule_mem_reflectingHyperplanes
      (P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx i)
  have hset : ((Ideal.span {SymmetricAlgebra.ι K (Dual K M) (P.coroot' i)}).inertia P.weylGroup :
      Set P.weylGroup) = {1, weylGroup.ofIdx P i} := by
    ext w
    simp only [SetLike.mem_coe, Set.mem_insert_iff, Set.mem_singleton_iff,
      ρ.mem_dual_inertia_span_singleton_ι_iff_le_fixedSubmodule,
      ρ.le_fixedSubmodule_iff_of_mem_reflectingHyperplanes hH,
      map_eq_one_iff ρ P.weylGroupRootRep_injective]
    refine or_congr_right ⟨fun hfix ↦ ?_, ?_⟩
    swap
    · rintro rfl
      exact fixedSubmodule_weylGroupRootRep_ofIdx P i
    -- A nontrivial element fixing the hyperplane is the reflection of a root with that hyperplane.
    obtain ⟨j, -, rfl⟩ :=
      P.exists_mem_posRoots_eq_ofIdx_of_finrank_quotient_fixedSubmodule_eq_one b
        (by rw [hfix]; exact ρ.finrank_quotient_of_mem_reflectingHyperplanes hH)
    rw [fixedSubmodule_weylGroupRootRep_ofIdx] at hfix
    exact weylGroup.ofIdx_eq_of_ker_coroot'_le P hfix.le
  rw [← SetLike.coe_sort_coe, hset, Nat.card_coe_set_eq,
    Set.ncard_pair (weylGroup.ofIdx_ne_one P i).symm]

/-- **The Jacobian of the basic invariants of a Weyl group is the product of the positive
coroots.** If homogeneous invariants `fᵢ` form a polynomial basis of the polynomial functions on
the weight space invariant under the Weyl group, then their Jacobian with respect to any basis of
the dual space is a nonzero scalar times `∏_{α ∈ Φ⁺} α^∨`. -/
theorem exists_jacobian_eq_algebraMap_mul_prod_posRootsFinset {n : Type*} [Fintype n]
    [DecidableEq n] (B : Basis n K (Dual K M))
    {f : n → P.weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : n → ℕ}
    (hf : ∀ i, (f i : SymmetricAlgebra K (Dual K M)) ∈ homogeneousSubmodule K (Dual K M) (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∃ c : K, c ≠ 0 ∧ jacobian B (fun i ↦ (f i : SymmetricAlgebra K (Dual K M))) =
      algebraMap K _ c *
        ∏ α ∈ TauCeti.posRootsFinset P b, SymmetricAlgebra.ι K (Dual K M) (P.coroot' α) := by
  classical
  set ρ := P.weylGroupRootRep
  -- Each reflecting hyperplane is the hyperplane of a positive root.
  have hH (H : ρ.reflectingHyperplanes) :
      ∃ α ∈ TauCeti.posRoots P b, LinearMap.ker (P.coroot' α) = H.val := by
    obtain ⟨w, hw, hwH⟩ := ρ.mem_reflectingHyperplanes.1 H.2
    obtain ⟨α, hα, rfl⟩ :=
      P.exists_mem_posRoots_eq_ofIdx_of_finrank_quotient_fixedSubmodule_eq_one b hw
    exact ⟨α, hα, by rw [← hwH, fixedSubmodule_weylGroupRootRep_ofIdx]⟩
  choose α hαpos hαker using hH
  obtain ⟨c, hc, hJ⟩ := ρ.exists_jacobian_eq_algebraMap_mul_prod_dual_inertia_sub_one
    P.weylGroupRootRep_injective B (fun H ↦ P.coroot' (α H)) hαker hf hbij
  refine ⟨c, hc, hJ.trans (congrArg _ ?_)⟩
  simp only [natCard_inertia_span_coroot' P b, Nat.add_one_sub_one, pow_one]
  -- Reindex the hyperplanes by their positive roots.
  refine Finset.prod_bij (fun H _ ↦ α H)
    (fun H _ ↦ (TauCeti.mem_posRootsFinset P b _).2 (hαpos H))
    (fun H _ H' _ h ↦ Subtype.ext <| by rw [← hαker, ← hαker, h]) (fun β hβ ↦ ?_)
    (fun _ _ ↦ rfl)
  rw [TauCeti.mem_posRootsFinset] at hβ
  have hmem : LinearMap.ker (P.coroot' β) ∈ ρ.reflectingHyperplanes := by
    rw [← fixedSubmodule_weylGroupRootRep_ofIdx]
    exact ρ.fixedSubmodule_mem_reflectingHyperplanes
      (P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx β)
  exact ⟨⟨_, hmem⟩, Finset.mem_univ _,
    P.eq_of_ker_coroot'_le_of_mem_posRoots b (hαpos _) hβ (hαker ⟨_, hmem⟩).le⟩

end RootPairing
