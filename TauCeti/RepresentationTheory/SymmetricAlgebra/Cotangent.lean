/-!
# The cotangent space of polynomial invariants at the vertex

Let a group `G` act linearly on a module `M`, and so on the symmetric algebra `S = Sym M`, with
invariant subalgebra `A = Sym(M)^G`. Write `A₊` for the ideal of invariants with zero constant
term, the contraction to `A` of the irrelevant ideal `S₊`. Since `A` is a graded subalgebra of `S`,
the ideal `A₊` is generated by the homogeneous invariants of positive degree
(`Representation.under_irrelevant_eq_span`, in
`TauCeti.RepresentationTheory.SymmetricAlgebra.HilbertIdeal`).

Over a field `k`, for a finite group and finite-dimensional `M`, the ideal `A₊` is maximal and the
cotangent space `A₊ ⧸ A₊²` is a finite-dimensional vector space over `A ⧸ A₊`. A basis of it
lifts to homogeneous invariants of positive degree: there are `dim (A₊ ⧸ A₊²)` such invariants
`f₁, f₂, …` with `A₊ ≤ (f₁, f₂, …) + A₊²`
(`Representation.exists_homogeneous_le_span_sup_sq`). Since `A_{A₊}` has Krull dimension
`dim M`, its embedding dimension `dim (A₊ ⧸ A₊²)` is at least `dim M`, and `A_{A₊}` is a regular
local ring exactly when equality holds, that is, exactly when `dim M` homogeneous invariants of
positive degree span `A₊` modulo `A₊²`.

In the homological proof that the invariants of a finite group generated by pseudoreflections,
whose order is invertible in `k`, form a polynomial algebra (Chevalley, Shephard–Todd), regularity
of `A` at its vertex comes from the regularity of `S` by descent along the faithfully flat
extension `A → S`. A family of `dim M` homogeneous invariants as above then generates `A` by the
graded Nakayama lemma and is algebraically independent for dimension reasons.

## Main results

* `Representation.exists_homogeneous_le_span_sup_sq`: a basis of `A₊ ⧸ A₊²` lifts to homogeneous
  invariants of positive degree.
* `Representation.finrank_le_finrank_cotangent_under_irrelevant`: `A₊ ⧸ A₊²` has dimension at
  least `dim M`.
* `Representation.isRegularLocalRing_atPrime_under_irrelevant_iff_finrank_cotangent`: `A_{A₊}` is
  regular if and only if `A₊ ⧸ A₊²` has dimension `dim M`.
* `Representation.isRegularLocalRing_atPrime_under_irrelevant_iff_exists_homogeneous`: `A_{A₊}` is
  regular if and only if `dim M` homogeneous invariants of positive degree span `A₊` modulo `A₊²`.

## References

* R. Kane, *Reflection Groups and Invariant Theory*, CMS Books in Mathematics, Springer (2001),
  §§ 17–18.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), § 7.2.
-/

public section

open TauCeti.SymmetricAlgebra

namespace Representation

variable {k G M : Type*}

section Field

variable [Field k] [Group G] [Finite G] [AddCommGroup M] [Module k M] [FiniteDimensional k M]
variable (ρ : Representation k G M)

/-- **Homogeneous lifts of a basis of the vertex cotangent space.** Over a field, for a finite group
acting on a finite-dimensional space `M`, there are `dim (A₊ ⧸ A₊²)` homogeneous invariants
`f₁, f₂, …` of positive degree with `A₊ ≤ (f₁, f₂, …) + A₊²`, where `A₊` is the ideal of invariants
with zero constant term. -/
theorem exists_homogeneous_le_span_sup_sq :
    ∃ (f : Fin (Module.finrank (ρ.symmetricAlgebraInvariants ⧸
        (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
          ρ.symmetricAlgebraInvariants)
        ((HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
          ρ.symmetricAlgebraInvariants).Cotangent) → ρ.symmetricAlgebraInvariants)
      (d : Fin _ → ℕ), (∀ i, 0 < d i) ∧
      (∀ i, (f i : SymmetricAlgebra k M) ∈ homogeneousSubmodule k M (d i)) ∧
      (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
          ρ.symmetricAlgebraInvariants ≤
        Ideal.span (Set.range f) ⊔
          ((HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
            ρ.symmetricAlgebraInvariants) ^ 2 := by
  set I := (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
    ρ.symmetricAlgebraInvariants
  set T := {f : ρ.symmetricAlgebraInvariants |
    ∃ n, 0 < n ∧ (f : SymmetricAlgebra k M) ∈ homogeneousSubmodule k M n}
  have hT (f : T) : (f : ρ.symmetricAlgebraInvariants) ∈ I :=
    have ⟨_, hn, hf⟩ := f.2
    HomogeneousIdeal.mem_irrelevant_of_mem _ hn hf
  have := Algebra.FiniteType.isNoetherianRing k ρ.symmetricAlgebraInvariants
  let := Ideal.Quotient.field I
  have : Module.Finite (ρ.symmetricAlgebraInvariants ⧸ I) I.Cotangent :=
    .of_restrictScalars_finite ρ.symmetricAlgebraInvariants _ _
  -- The classes of the homogeneous invariants of positive degree span `A₊ ⧸ A₊²`.
  have hspan : ⊤ ≤ Submodule.span (ρ.symmetricAlgebraInvariants ⧸ I)
      (Set.range fun f : T ↦ I.toCotangent ⟨f, hT f⟩) := by
    refine ((Ideal.span_quotient_range_toCotangent_eq_top_iff I _ hT).2 ?_).ge
    rw [Subtype.range_coe]
    exact (under_irrelevant_eq_span ρ).le.trans le_sup_left
  -- Choose a basis among these classes and index it by `Fin (dim (A₊ ⧸ A₊²))`.
  let b := Module.Basis.ofSpan hspan
  have := Module.Finite.finite_basis b
  let b' := b.reindex <|
    (Finite.equivFin _).trans (finCongr (Module.finrank_eq_nat_card_basis b).symm)
  have hb' (i) : ∃ f : T, I.toCotangent ⟨f, hT f⟩ = b' i :=
    Module.Basis.ofSpan_subset hspan ⟨_, (b.reindex_apply _ i).symm⟩
  choose f hf using hb'
  choose d hd hfd using fun i ↦ (f i).2
  refine ⟨fun i ↦ f i, d, hd, hfd, ?_⟩
  rw [← Ideal.span_quotient_range_toCotangent_eq_top_iff I _ fun i ↦ hT (f i)]
  simp_rw [hf]
  exact b'.span_eq

/-- Over a field, for a finite group acting on a finite-dimensional space `M`, the cotangent space
`A₊ ⧸ A₊²` of the invariants at the vertex has dimension at least `dim M`. -/
theorem finrank_le_finrank_cotangent_under_irrelevant :
    Module.finrank k M ≤ Module.finrank (ρ.symmetricAlgebraInvariants ⧸
        (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
          ρ.symmetricAlgebraInvariants)
      ((HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
        ρ.symmetricAlgebraInvariants).Cotangent := by
  set I := (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
    ρ.symmetricAlgebraInvariants
  have := Algebra.FiniteType.isNoetherianRing k ρ.symmetricAlgebraInvariants
  have := IsLocalization.isNoetherianRing I.primeCompl (Localization.AtPrime I) ‹_›
  have h := ringKrullDim_le_spanFinrank_maximalIdeal (Localization.AtPrime I)
  rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace (Localization.AtPrime I),
    ← Ideal.finrank_cotangent_eq_finrank_cotangentSpace I, ringKrullDim_atPrime_under_irrelevant]
    at h
  exact_mod_cast h

/-- Over a field, for a finite group acting on a finite-dimensional space `M`, the local ring
`A_{A₊}` of the invariants at the vertex is regular if and only if the cotangent space `A₊ ⧸ A₊²`
has dimension `dim M`. -/
theorem isRegularLocalRing_atPrime_under_irrelevant_iff_finrank_cotangent :
    IsRegularLocalRing (Localization.AtPrime
        ((HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
          ρ.symmetricAlgebraInvariants)) ↔
      Module.finrank (ρ.symmetricAlgebraInvariants ⧸
          (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
            ρ.symmetricAlgebraInvariants)
        ((HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
          ρ.symmetricAlgebraInvariants).Cotangent = Module.finrank k M := by
  set I := (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
    ρ.symmetricAlgebraInvariants
  have := Algebra.FiniteType.isNoetherianRing k ρ.symmetricAlgebraInvariants
  have := IsLocalization.isNoetherianRing I.primeCompl (Localization.AtPrime I) ‹_›
  rw [Ideal.isRegularLocalRing_iff_finrank_cotangent I, ringKrullDim_atPrime_under_irrelevant]
  exact_mod_cast Iff.rfl

/-- **Regularity of the invariants at the vertex.** Over a field, for a finite group acting on a
finite-dimensional space `M`, the local ring `A_{A₊}` of the invariants at the vertex is regular if
and only if there are `dim M` homogeneous invariants `f₁, …, f_{dim M}` of positive degree with
`A₊ ≤ (f₁, …, f_{dim M}) + A₊²`, where `A₊` is the ideal of invariants with zero constant term. -/
theorem isRegularLocalRing_atPrime_under_irrelevant_iff_exists_homogeneous :
    IsRegularLocalRing (Localization.AtPrime
        ((HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
          ρ.symmetricAlgebraInvariants)) ↔
      ∃ (f : Fin (Module.finrank k M) → ρ.symmetricAlgebraInvariants) (d : Fin _ → ℕ),
        (∀ i, 0 < d i) ∧ (∀ i, (f i : SymmetricAlgebra k M) ∈ homogeneousSubmodule k M (d i)) ∧
        (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
            ρ.symmetricAlgebraInvariants ≤
          Ideal.span (Set.range f) ⊔
            ((HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
              ρ.symmetricAlgebraInvariants) ^ 2 := by
  set I := (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
    ρ.symmetricAlgebraInvariants
  rw [isRegularLocalRing_atPrime_under_irrelevant_iff_finrank_cotangent]
  refine ⟨fun h ↦ h ▸ ρ.exists_homogeneous_le_span_sup_sq, fun ⟨f, d, hd, hf, hspan⟩ ↦ ?_⟩
  -- The classes of the `fᵢ` span `A₊ ⧸ A₊²`, so its dimension is at most `dim M`.
  have hfI (i) : f i ∈ I := HomogeneousIdeal.mem_irrelevant_of_mem _ (hd i) (hf i)
  refine le_antisymm ?_ ρ.finrank_le_finrank_cotangent_under_irrelevant
  let := Ideal.Quotient.field I
  have := finrank_range_le_card (R := ρ.symmetricAlgebraInvariants ⧸ I)
    (b := fun i ↦ I.toCotangent ⟨f i, hfI i⟩)
  rwa [Set.finrank, (Ideal.span_quotient_range_toCotangent_eq_top_iff I f hfI).2 hspan, finrank_top,
    Fintype.card_fin] at this

end Field

end Representation
