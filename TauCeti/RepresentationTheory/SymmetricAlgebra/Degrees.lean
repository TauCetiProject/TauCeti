/-!
# Degrees of basic invariants

Let a group `G` act linearly on a module `M`, and so on the symmetric algebra `S = Sym M`, with
invariant subalgebra `A = Sym(M)^G`. A *system of basic invariants* is a family of homogeneous
invariants `f i ∈ A ∩ Sym^{d i} M` such that `R[Xᵢ] → A`, `Xᵢ ↦ f i`, is bijective: the `f i`
are algebraically independent and generate `A`. Over a field, for a finite group generated by
pseudoreflections whose order is invertible, such systems exist by the classical theorem of
Chevalley and Shephard–Todd; for the symmetric group they are the elementary symmetric invariants
(`Representation.esymmSymmetricAlgebraInvariantsEquiv`, `TauCeti.esymmStandardInvariantsEquiv`).
Such systems are not unique, and this file proves that their numerical invariants are.

* Every basic invariant has positive degree, since the invariants of degree zero are the scalars.
* For a finite group acting on a finite-dimensional vector space `M` over a field, a system of basic
  invariants has exactly `finrank M` members: the invariant ring has the Krull dimension of `Sym M`,
  which is integral over it.
* The Hilbert series of the invariant algebra is
  `∑ₙ dim (A ∩ Symⁿ M) tⁿ = ∏ᵢ (1 - t ^ d i)⁻¹`.
* Consequently the multiset of degrees `d i` does not depend on the system of basic invariants.
  These are the *degrees* of the group; for the reflection representation of the symmetric group
  `S_{n+1}`, with `n + 1` invertible, they are `2, 3, …, n + 1`
  (`TauCeti.map_univ_eq_of_bijective_aeval_standardRepresentation_dual`).
* The degrees of a subgroup `H` are smaller than those of `G`: since `Sym(M)^G ⊆ Sym(M)^H`, for
  every `n` there are at most as many basic invariants of `G` of degree at most `n` as there are
  basic invariants of `H` of degree at most `n`.

These statements are specializations of the corresponding facts for graded polynomial algebras
(`TauCeti.RingTheory.GradedAlgebra.HilbertSeries`) to the grading of the invariant subalgebra by
the degrees of `Sym M`. Combined with Molien's formula
(`TauCeti.RepresentationTheory.SymmetricAlgebra.Molien`), the Hilbert series formula expresses the
average over `G` of `det(1 - t g)⁻¹` through the degrees.

## Main results

* `Representation.ne_zero_of_injective_aeval_symmetricAlgebraInvariants`: algebraically
  independent homogeneous invariants have positive degrees.
* `Representation.card_eq_finrank_of_bijective_aeval_symmetricAlgebraInvariants`: a polynomial
  generating system of the invariants of a finite group has `finrank M` members.
* `mk_finrank_symmetricAlgebraInvariants_inf_homogeneousSubmodule_mul_prod_one_sub_X_pow` (in the
  namespace `Representation`): the Hilbert series of the invariants is `∏ᵢ (1 - t ^ d i)⁻¹`.
* `Representation.map_univ_eq_of_bijective_aeval_symmetricAlgebraInvariants`: two systems of basic
  invariants have the same multiset of degrees.
* `Representation.map_univ_eq_of_bijective_aeval_of_algEquiv_symmetricAlgebraInvariants`: the
  same, with the second system given by an algebra isomorphism from a polynomial algebra.
* `Representation.card_filter_le_le_card_filter_le_of_comp_subtype`: a system of basic invariants
  of a subgroup has, in each degree range `≤ n`, at least as many members as one of the group.

## References

* C. Chevalley, *Invariants of finite groups generated by reflections*, Amer. J. Math. **77**
  (1955), 778–782.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press (1990),
  Sections 3.5–3.7.
* R. Kane, *Reflection Groups and Invariant Theory*, Springer (2001), § 18.
-/

public section

open TauCeti.SymmetricAlgebra MvPolynomial

namespace Representation

variable {R k G M ι κ : Type*}

section CommRing

variable [CommRing R] [Monoid G] [AddCommMonoid M] [Module R M]
variable (ρ : Representation R G M) {f : ι → ρ.symmetricAlgebraInvariants} {d : ι → ℕ}

/-- The invariants of degree zero are scalars. -/
private theorem mem_bot_of_mem_grading_zero
    (x : ρ.symmetricAlgebraInvariants)
    (hx : x ∈ ρ.symmetricAlgebraInvariants.grading (homogeneousSubmodule R M) 0) :
    x ∈ (⊥ : Subalgebra R ρ.symmetricAlgebraInvariants) := by
  rw [Subalgebra.mem_grading_iff] at hx
  refine Algebra.mem_bot.2 ⟨homogeneousSubmoduleZeroEquiv R M ⟨x, hx⟩, Subtype.ext ?_⟩
  exact algebraMap_homogeneousSubmoduleZeroEquiv_apply R M ⟨x, hx⟩

variable [Nontrivial R]

/-- **Basic invariants have positive degrees.** If invariants `f i` homogeneous of degrees `d i`
are algebraically independent, then every `d i` is nonzero. -/
theorem ne_zero_of_injective_aeval_symmetricAlgebraInvariants
    (hf : ∀ i, (f i : SymmetricAlgebra R M) ∈ homogeneousSubmodule R M (d i))
    (hinj : Function.Injective (aeval (R := R) f)) (i : ι) : d i ≠ 0 :=
  TauCeti.GradedAlgebra.ne_zero_of_injective_aeval _ ρ.mem_bot_of_mem_grading_zero
    (fun i ↦ (Subalgebra.mem_grading_iff _ _).2 (hf i)) hinj i

variable [Fintype ι]

/-- **The Hilbert series of a polynomial invariant algebra.** If the invariant subalgebra is a
polynomial algebra on invariants `f i` homogeneous of degrees `d i`, then its Hilbert series
`∑ₙ dim (Sym(M)^G ∩ Symⁿ M) tⁿ`, with coefficients cast into any commutative ring `S`, is the
inverse of `∏ᵢ (1 - t ^ d i)`. -/
theorem mk_finrank_symmetricAlgebraInvariants_inf_homogeneousSubmodule_mul_prod_one_sub_X_pow
    (S : Type*) [CommRing S]
    (hf : ∀ i, (f i : SymmetricAlgebra R M) ∈ homogeneousSubmodule R M (d i))
    (hbij : Function.Bijective (aeval (R := R) f)) :
    PowerSeries.mk (fun n ↦ (Module.finrank R
        ↥(Subalgebra.toSubmodule ρ.symmetricAlgebraInvariants ⊓ homogeneousSubmodule R M n) : S)) *
      ∏ i, (1 - PowerSeries.X ^ d i) = 1 := by
  let := Subalgebra.gradedAlgebra ρ.isHomogeneous_symmetricAlgebraInvariants
  simp_rw [← Subalgebra.finrank_grading]
  exact TauCeti.GradedAlgebra.mk_finrank_mul_prod_one_sub_X_pow _ S
    (fun i ↦ (Subalgebra.mem_grading_iff _ _).2 (hf i)) hbij
    (ρ.ne_zero_of_injective_aeval_symmetricAlgebraInvariants hf hbij.1)

/-- **The degrees of basic invariants are intrinsic.** Two systems of basic invariants, that is,
two families of homogeneous invariants on which the invariant subalgebra is a polynomial algebra,
have the same multiset of degrees. -/
theorem map_univ_eq_of_bijective_aeval_symmetricAlgebraInvariants [Fintype κ]
    {f' : κ → ρ.symmetricAlgebraInvariants} {d' : κ → ℕ}
    (hf : ∀ i, (f i : SymmetricAlgebra R M) ∈ homogeneousSubmodule R M (d i))
    (hbij : Function.Bijective (aeval (R := R) f))
    (hf' : ∀ j, (f' j : SymmetricAlgebra R M) ∈ homogeneousSubmodule R M (d' j))
    (hbij' : Function.Bijective (aeval (R := R) f')) :
    Finset.univ.val.map d = Finset.univ.val.map d' :=
  let := Subalgebra.gradedAlgebra ρ.isHomogeneous_symmetricAlgebraInvariants
  TauCeti.GradedAlgebra.map_univ_eq_of_bijective_aeval
    (ρ.symmetricAlgebraInvariants.grading (homogeneousSubmodule R M))
    (fun i ↦ (Subalgebra.mem_grading_iff _ _).2 (hf i)) hbij
    (ρ.ne_zero_of_injective_aeval_symmetricAlgebraInvariants hf hbij.1)
    (fun j ↦ (Subalgebra.mem_grading_iff _ _).2 (hf' j)) hbij'
    (ρ.ne_zero_of_injective_aeval_symmetricAlgebraInvariants hf' hbij'.1)

/-- **The degrees of basic invariants are intrinsic**, comparing with a system of basic invariants
given by an algebra isomorphism `e : R[Xⱼ] ≃ₐ[R] Sym(M)^G` that sends each `Xⱼ` to an invariant
homogeneous of degree `d' j`. -/
theorem map_univ_eq_of_bijective_aeval_of_algEquiv_symmetricAlgebraInvariants [Fintype κ]
    {d' : κ → ℕ} (hf : ∀ i, (f i : SymmetricAlgebra R M) ∈ homogeneousSubmodule R M (d i))
    (hbij : Function.Bijective (aeval (R := R) f))
    (e : MvPolynomial κ R ≃ₐ[R] ρ.symmetricAlgebraInvariants)
    (he : ∀ j, (e (X j) : SymmetricAlgebra R M) ∈ homogeneousSubmodule R M (d' j)) :
    Finset.univ.val.map d = Finset.univ.val.map d' := by
  refine ρ.map_univ_eq_of_bijective_aeval_symmetricAlgebraInvariants hf hbij he ?_
  rw [(algHom_ext fun j ↦ by simp : aeval (fun j ↦ e (X j)) = e.toAlgHom)]
  exact e.bijective

end CommRing

section Subgroup

variable [CommRing R] [IsDomain R] [Group G] [AddCommMonoid M] [Module R M]
  (ρ : Representation R G M) [Fintype ι] [Fintype κ] {f : ι → ρ.symmetricAlgebraInvariants}
  {d : ι → ℕ}

/-- **Degrees of the invariants of a subgroup.** Let `H` be a subgroup of `G`. If invariants `f i`
of `G`, homogeneous of degrees `d i`, are algebraically independent, and invariants `g j` of `H`,
homogeneous of degrees `e j`, generate the invariants of `H`, then for every `n` there are at most
as many `f i` of degree at most `n` as there are `g j` of degree at most `n`. -/
theorem card_filter_le_le_card_filter_le_of_comp_subtype {H : Subgroup G}
    (hf : ∀ i, (f i : SymmetricAlgebra R M) ∈ homogeneousSubmodule R M (d i))
    (hinj : Function.Injective (aeval (R := R) f))
    {g : κ → symmetricAlgebraInvariants (ρ.comp H.subtype)} {e : κ → ℕ}
    (hg : ∀ j, (g j : SymmetricAlgebra R M) ∈ homogeneousSubmodule R M (e j))
    (hsurj : Function.Surjective (aeval (R := R) g)) (n : ℕ) :
    Finset.card {i | d i ≤ n} ≤ Finset.card {j | e j ≤ n} := by
  refine TauCeti.GradedAlgebra.card_filter_le_le_card_filter_le (homogeneousSubmodule R M) hf
    (AlgebraicIndependent.map' (f := ρ.symmetricAlgebraInvariants.val) hinj
      Subtype.val_injective) hg (fun i ↦ ?_) n
  -- An invariant of `G` is an invariant of `H`, so a polynomial in the `g j`.
  have hfi : (f i : SymmetricAlgebra R M) ∈ symmetricAlgebraInvariants (ρ.comp H.subtype) :=
    (mem_symmetricAlgebraInvariants (ρ.comp H.subtype) _).2 fun h ↦ by
      rw [symmetricAlgebra_comp_apply]
      exact (ρ.mem_symmetricAlgebraInvariants _).1 (f i).2 h
  obtain ⟨p, hp⟩ := hsurj ⟨_, hfi⟩
  have hp' := congrArg Subtype.val hp
  rw [← Subalgebra.coe_val, comp_aeval_apply, Subalgebra.coe_val] at hp'
  rw [Algebra.adjoin_range_eq_range_aeval, AlgHom.mem_range]
  exact ⟨p, hp'⟩

end Subgroup

section Field

variable [Field k] [Group G] [Finite G] [AddCommGroup M] [Module k M] [FiniteDimensional k M]
variable (ρ : Representation k G M)

/-- **The number of basic invariants.** For a finite group acting on a finite-dimensional vector
space `M`, if the invariant subalgebra is a polynomial algebra on a finite family of invariants,
then this family has `finrank M` members. -/
theorem card_eq_finrank_of_bijective_aeval_symmetricAlgebraInvariants [Finite ι]
    {f : ι → ρ.symmetricAlgebraInvariants} (hbij : Function.Bijective (aeval (R := k) f)) :
    Nat.card ι = Module.finrank k M := by
  have h := ringKrullDim_eq_of_ringEquiv (AlgEquiv.ofBijective (aeval f) hbij).toRingEquiv
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field,
    zero_add, ρ.ringKrullDim_symmetricAlgebraInvariants, ringKrullDim_eq_finrank] at h
  exact_mod_cast h

end Field

end Representation
