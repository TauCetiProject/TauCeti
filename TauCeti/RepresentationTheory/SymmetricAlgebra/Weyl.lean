section General

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N] (P : RootPairing ι R M N)

/-- The Weyl-group representation `P.weylGroupRootRep` is faithful. -/
theorem weylGroupRootRep_injective : Function.Injective P.weylGroupRootRep := by
  intro v w hvw
  exact weylGroup.ext fun x ↦ LinearMap.congr_fun hvw x

end General

section FieldBasic

variable {ι K M N : Type*} [Field K] [CharZero K] [AddCommGroup M] [Module K M]
  [AddCommGroup N] [Module K N] (P : RootPairing ι K M N)

/-- The fixed space of the root reflection `s_i` is the coroot hyperplane `ker (P.coroot' i)`. -/
@[simp]
theorem fixedSubmodule_weylGroupRootRep_ofIdx (i : ι) :
    (P.weylGroupRootRep (weylGroup.ofIdx P i)).fixedSubmodule = LinearMap.ker (P.coroot' i) := by
  ext x
  rw [LinearMap.mem_fixedSubmodule_iff, LinearMap.mem_ker]
  change weylGroup.ofIdx P i • x = x ↔ P.coroot' i x = 0
  rw [weylGroup.ofIdx_smul, Equiv.reflection_smul, reflection_apply, sub_eq_self, smul_eq_zero]
  simp [P.ne_zero i]

/-- Every root reflection is a pseudoreflection of `P.weylGroupRootRep`. -/
theorem finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx (i : ι) :
    Module.finrank K (M ⧸ (P.weylGroupRootRep (weylGroup.ofIdx P i)).fixedSubmodule) = 1 := by
  rw [fixedSubmodule_weylGroupRootRep_ofIdx]
  have hsurj : Function.Surjective (P.coroot' i) := fun c ↦
    ⟨(c / 2) • P.root i, by simp [P.root_coroot'_eq_pairing]⟩
  have heq : (M ⧸ LinearMap.ker (P.coroot' i)) ≃ₗ[K] K :=
    (P.coroot' i).quotKerEquivOfSurjective hsurj
  rw [heq.finrank_eq, Module.finrank_self]

/-- The Weyl group is generated by its pseudoreflections. -/
@[simp]
theorem pseudoreflectionSubgroup_weylGroupRootRep :
    P.weylGroupRootRep.pseudoreflectionSubgroup = ⊤ := by
  rw [eq_top_iff]
  rintro ⟨w, hw⟩ -
  induction hw using weylGroup.induction with
  | mem i =>
    exact mem_pseudoreflectionSubgroup_of_finrank_quotient_eq_one P.weylGroupRootRep
      (P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx i)
  | one => exact one_mem _
  | mul w₁ w₂ hw₁ hw₂ ih₁ ih₂ =>
    exact Subgroup.mul_mem _ ih₁ ih₂

/-- In a reduced root pairing over a characteristic-zero field, two root reflections coincide
exactly when the roots are equal or opposite. -/
theorem weylGroup_ofIdx_eq_iff [P.IsReduced] (i j : ι) :
    weylGroup.ofIdx P i = weylGroup.ofIdx P j ↔ j = i ∨ j = P.reflectionPerm i i := by
  constructor
  · intro h
    have hsmul : weylGroup.ofIdx P i • P.root i = weylGroup.ofIdx P j • P.root i := by rw [h]
    rw [weylGroup.ofIdx_smul, weylGroup.ofIdx_smul, Equiv.reflection_smul, Equiv.reflection_smul,
      reflection_apply_self, reflection_apply, root_coroot'_eq_pairing] at hsmul
    have hdep : ¬ LinearIndependent K ![P.root i, P.root j] := by
      intro hli
      have h0 : (2 : K) • P.root i + (-P.pairing i j) • P.root j = 0 := by
        rw [two_smul, neg_smul, ← sub_eq_add_neg, add_sub_assoc, ← hsmul, add_neg_cancel]
      have hc := Fintype.linearIndependent_iff.1 hli ![(2 : K), -P.pairing i j] <| by
        simpa [Fin.sum_univ_two] using h0
      exact two_ne_zero (by simpa using hc 0)
    rcases IsReduced.eq_or_eq_neg i j hdep with heq | heq
    · left
      exact (P.root.injective heq).symm
    · right
      apply P.root.injective
      rw [root_reflectionPerm, reflection_apply_self, ← neg_eq_iff_eq_neg.2 heq]
  · rintro (rfl | rfl)
    · rfl
    · apply weylGroup.ext
      intro x
      rw [weylGroup.ofIdx_smul, weylGroup.ofIdx_smul, Equiv.reflection_smul, Equiv.reflection_smul]
      let := P.indexNeg
      simpa only [← indexNeg_neg] using
        (LinearEquiv.congr_fun (P.reflection_indexNeg_neg i) x).symm

/-- **Chevalley's theorem for Weyl groups.** For any finite root system over a field of
characteristic zero, the polynomial invariants `Sym(M*)^W` form a polynomial algebra on `dim M`
homogeneous invariants of positive degree. -/
theorem exists_bijective_aeval_symmetricAlgebraInvariants_weylGroupRootRep_dual
    [Finite ι] [P.IsRootSystem] :
    ∃ f : Fin (Module.finrank K M) → P.weylGroupRootRep.dual.symmetricAlgebraInvariants,
      (∀ i, ∃ d, 0 < d ∧
        (f i : SymmetricAlgebra K (Module.Dual K M)) ∈
          homogeneousSubmodule K (Module.Dual K M) d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  have : FiniteDimensional K M :=
    Module.Finite.of_fg_top <| by
      rw [← IsRootSystem.span_root_eq_top (P := P)]
      exact Submodule.fg_span (Set.finite_range P.root)
  have : Finite P.weylGroup := P.finite_weylGroup
  let := Fintype.ofFinite P.weylGroup
  let : Invertible (Fintype.card P.weylGroup : K) :=
    invertibleOfNonzero (Nat.cast_ne_zero.2 Fintype.card_ne_zero)
  exact exists_bijective_aeval_symmetricAlgebraInvariants_dual_of_pseudoreflectionSubgroup_eq_top
    P.weylGroupRootRep P.pseudoreflectionSubgroup_weylGroupRootRep

/-- **Product of degrees for a Weyl group.** For any finite root system over a field of
characteristic zero, the product of the degrees of homogeneous basic invariants equals `|W|`. -/
theorem prod_eq_natCard_weylGroup_of_bijective_aeval_weylGroupRootRep_dual
    [Finite ι] [P.IsRootSystem] {κ : Type*} [Fintype κ]
    {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : κ → ℕ}
    (hf : ∀ i, (f i : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∏ i, d i = Nat.card P.weylGroup := by
  have : FiniteDimensional K M :=
    Module.Finite.of_fg_top <| by
      rw [← IsRootSystem.span_root_eq_top (P := P)]
      exact Submodule.fg_span (Set.finite_range P.root)
  have : Finite P.weylGroup := P.finite_weylGroup
  let := Fintype.ofFinite P.weylGroup
  rw [Nat.card_eq_fintype_card]
  exact P.weylGroupRootRep.dual.prod_eq_card_of_bijective_aeval_symmetricAlgebraInvariants
    (P.weylGroupRootRep.dual_injective_iff.2 P.weylGroupRootRep_injective) hf hbij

end FieldBasic

section PseudoreflectionClassification

/-- Over a linearly ordered field, every pseudoreflection in the Weyl group of a finite reduced
crystallographic root system is a root reflection. -/
private theorem exists_ofIdx_eq_of_finrank_quotient_fixedSubmodule_eq_one_ordered
    {ι R M N : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [Finite ι] [P.IsCrystallographic] [P.IsReduced] [P.IsRootSystem]
    (b : P.Base) {w : P.weylGroup}
    (hw : Module.finrank R (M ⧸ (P.weylGroupRootRep w).fixedSubmodule) = 1) :
    ∃ i : ι, w = weylGroup.ofIdx P i := by
  let := Fintype.ofFinite ι
  have : FiniteDimensional R M := Module.Finite.of_basis b.toWeightBasis
  have hw1 : w ≠ 1 :=
    P.weylGroupRootRep.ne_one_of_finrank_quotient_fixedSubmodule_eq_one hw
  set H : Submodule R M := (P.weylGroupRootRep w).fixedSubmodule
  -- Step 1: `H` lies inside some coroot hyperplane `ker (P.coroot' i)`, otherwise `H` contains a
  -- regular weight, contradicting freeness of the Weyl-group action on open chambers.
  have hle : ∃ i : ι, H ≤ LinearMap.ker (P.coroot' i) := by
    by_contra hnot
    push Not at hnot
    have hex : ∀ i : ι, ∃ x : H, (P.coroot' i).comp H.subtype x ≠ 0 := fun i ↦ by
      obtain ⟨x, hxH, hxker⟩ := IsConcreteLE.not_le_iff_exists.1 (hnot i)
      exact ⟨⟨x, hxH⟩, by simpa [LinearMap.mem_ker] using hxker⟩
    obtain ⟨x, hx⟩ :=
      Module.Dual.exists_forall_mem_ne_zero_of_forall_exists (⊤ : Submodule R H)
        (fun i : ι ↦ (P.coroot' i).comp H.subtype) fun i ↦ by
          obtain ⟨y, hy⟩ := hex i
          exact ⟨y, trivial, hy⟩
    have hreg : IsRegularWeight P (x : M) := (isRegularWeight_iff P _).2 fun i ↦ hx.2 i
    obtain ⟨u, hu, _⟩ := existsUnique_mem_openWeylChamber P b hreg
    have hfix : (u⁻¹ * w * u) • (u⁻¹ • (x : M)) = u⁻¹ • (x : M) := by
      rw [mul_smul, mul_smul, smul_inv_smul]
      have hwx : w • (x : M) = (x : M) := x.2
      rw [hwx]
    have huwu : u⁻¹ * w * u = 1 :=
      eq_one_of_smul_eq_self_of_mem_openDominantChamber P b _
        ((mem_openWeylChamber P b u (x : M)).1 hu) hfix
    have : w = 1 := by
      have := congrArg (fun g ↦ u * g * u⁻¹) huwu
      simpa [mul_assoc] using this
    exact hw1 this
  obtain ⟨i, hi⟩ := hle
  -- Step 2: Equal codimensions give `H = ker (P.coroot' i)`.
  have hH : H = LinearMap.ker (P.coroot' i) := by
    refine Submodule.eq_of_le_of_finrank_eq hi ?_
    have h1 := Submodule.finrank_quotient_add_finrank H
    have h2 := Submodule.finrank_quotient_add_finrank (LinearMap.ker (P.coroot' i))
    have h3 : Module.finrank R (M ⧸ LinearMap.ker (P.coroot' i)) = 1 := by
      rw [← P.fixedSubmodule_weylGroupRootRep_ofIdx i]
      exact P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx i
    omega
  -- Step 3: Using `P.RootForm`, `w • P.root i` is orthogonal to `H`, hence a scalar multiple of
  -- `P.root i`, and invariance forces `w • P.root i = -P.root i`.
  have hform_pos (z : M) (hz : z ≠ 0) : 0 < P.RootForm z z :=
    P.rootForm_pos_of_ne_zero
      (by rw [rootSpan, IsRootSystem.span_root_eq_top (P := P)]; trivial) hz
  have hroot_orth (z : M) (hz : z ∈ H) : P.RootForm (P.root i) z = 0 := by
    have h2 := P.toInvariantForm.two_mul_apply_root z i
    have hzker : P.coroot' i z = 0 := LinearMap.mem_ker.1 (hH ▸ hz)
    rw [P.toInvariantForm_form, hzker, zero_mul] at h2
    have hsym : P.RootForm (P.root i) z = P.RootForm z (P.root i) := by
      simpa using P.rootForm_symmetric.eq (P.root i) z
    rw [hsym]
    exact (mul_eq_zero.1 h2).resolve_left two_ne_zero
  have horth (z : M) (hz : z ∈ H) : P.RootForm (w • P.root i) z = 0 := by
    have hwz : w • z = z := hz
    have hinv := InvariantForm.apply_weylGroup_smul P (B := P.toInvariantForm) w (P.root i) z
    rw [P.toInvariantForm_form, hwz] at hinv
    exact hinv.trans (hroot_orth z hz)
  set c : R := P.coroot' i (w • P.root i) / 2
  set y : M := w • P.root i - c • P.root i
  have hyH : y ∈ H := by
    rw [hH, LinearMap.mem_ker]
    simp [y, c]
  have hy0 : y = 0 := by
    by_contra hne
    have hpos := hform_pos y hne
    have hzero : P.RootForm y y = 0 := by
      have h1 : P.RootForm (w • P.root i) y = 0 := horth y hyH
      have hdecomp : w • P.root i = y + c • P.root i := by simp [y]
      rw [hdecomp, LinearMap.map_add₂, LinearMap.map_smul₂, smul_eq_mul, hroot_orth y hyH,
        mul_zero, add_zero] at h1
      exact h1
    exact hpos.ne' hzero
  have hwroot : w • P.root i = c • P.root i := sub_eq_zero.1 hy0
  have hc2 : c * c = 1 := by
    have hinv :=
      InvariantForm.apply_weylGroup_smul P (B := P.toInvariantForm) w (P.root i) (P.root i)
    rw [P.toInvariantForm_form, hwroot, LinearMap.map_smul₂, map_smul, smul_eq_mul, smul_eq_mul,
      ← mul_assoc] at hinv
    have hpos : P.RootForm (P.root i) (P.root i) ≠ 0 := (hform_pos _ (P.ne_zero i)).ne'
    exact mul_right_cancel₀ hpos (by simpa using hinv)
  have hc_cases : c = 1 ∨ c = -1 := mul_self_eq_one_iff.1 hc2
  -- Step 4: Every `z : M` decomposes along `P.root i` and `ker (P.coroot' i) = H`.
  have hdecomp (z : M) : z - (P.coroot' i z / 2) • P.root i ∈ H := by
    rw [hH, LinearMap.mem_ker]
    simp
  rcases hc_cases with hc1 | hcm1
  · exfalso
    apply hw1
    refine weylGroup.ext fun z ↦ ?_
    have hzH : P.weylGroupRootRep w (z - (P.coroot' i z / 2) • P.root i) =
        z - (P.coroot' i z / 2) • P.root i := hdecomp z
    rw [map_sub, map_smul] at hzH
    change w • z - (P.coroot' i z / 2) • (w • P.root i) =
      z - (P.coroot' i z / 2) • P.root i at hzH
    rw [hwroot, hc1, one_smul] at hzH
    simpa [sub_eq_iff_eq_add] using hzH
  · refine ⟨i, weylGroup.ext fun z ↦ ?_⟩
    have hzH : P.weylGroupRootRep w (z - (P.coroot' i z / 2) • P.root i) =
        z - (P.coroot' i z / 2) • P.root i := hdecomp z
    rw [map_sub, map_smul] at hzH
    change w • z - (P.coroot' i z / 2) • (w • P.root i) =
      z - (P.coroot' i z / 2) • P.root i at hzH
    rw [hwroot, hcm1, neg_one_smul, smul_neg, sub_neg_eq_add] at hzH
    rw [weylGroup.ofIdx_smul, Equiv.reflection_smul, reflection_apply]
    have h2 : (P.coroot' i z / 2) • P.root i + (P.coroot' i z / 2) • P.root i =
        P.coroot' i z • P.root i := by
      rw [← add_smul, add_halves]
    calc w • z = z - (P.coroot' i z / 2) • P.root i - (P.coroot' i z / 2) • P.root i :=
          eq_sub_of_add_eq hzH
      _ = z - ((P.coroot' i z / 2) • P.root i + (P.coroot' i z / 2) • P.root i) := by abel
      _ = z - P.coroot' i z • P.root i := by rw [h2]

/-- The canonical linear equivalence `S ⊗[ℚ] (σ → ℚ) ≃ₗ[S] (σ → S)` sending `s ⊗ₜ x`
to `s • Pi.algebraMap σ ℚ S x`. -/
private noncomputable def tensorPiEquiv {σ S : Type*} [Fintype σ] [Field S] [CharZero S] :
    S ⊗[ℚ] (σ → ℚ) ≃ₗ[S] (σ → S) := by
  classical
  exact ((Pi.basisFun ℚ σ).baseChange S).equiv (Pi.basisFun S σ) (_root_.Equiv.refl σ)

private lemma tensorPiEquiv_tmul {σ S : Type*} [Fintype σ] [Field S] [CharZero S]
    (s : S) (x : σ → ℚ) :
    tensorPiEquiv (σ := σ) (S := S) (s ⊗ₜ[ℚ] x) = s • Pi.algebraMap σ ℚ S x := by
  classical
  have hx : x = ∑ k : σ, x k • Pi.basisFun ℚ σ k := ((Pi.basisFun ℚ σ).sum_repr x).symm
  conv_lhs => rw [hx]
  rw [TensorProduct.tmul_sum, map_sum]
  ext j
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, piAlgebraMap_apply]
  trans ∑ k : σ, (s * algebraMap ℚ S (x k)) * Pi.basisFun S σ k j
  · refine Finset.sum_congr rfl fun k _ ↦ ?_
    have hterm : s ⊗ₜ[ℚ] (x k • Pi.basisFun ℚ σ k) =
        (s * algebraMap ℚ S (x k)) • ((Pi.basisFun ℚ σ).baseChange S k) := by
      rw [Module.Basis.baseChange_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one,
        ← TensorProduct.smul_tmul, Algebra.smul_def, mul_comm]
    rw [hterm, map_smul, tensorPiEquiv, Module.Basis.equiv_apply]
    simp
  · simp [Pi.basisFun_apply, Pi.single_apply]

/-- Base-changing a rational dot-product root pairing to a characteristic-zero field `S` preserves
the codimension of every Weyl-group element's fixed space. -/
private theorem finrank_quotient_fixedSubmodule_rootPairingBaseChange
    {ι σ S : Type*} [Finite ι] [Fintype σ] [Field S] [CharZero S]
    (Q : RootPairing ι ℚ (σ → ℚ) (σ → ℚ))
    (hQ : ∀ x y, Q.toLinearMap x y = x ⬝ᵥ y)
    [Q.IsRootSystem] (w : Q.weylGroup) :
    Module.finrank S ((σ → S) ⧸
        ((rootPairingBaseChange S Q hQ).weylGroupRootRep
          (weylGroupBaseChangeEquiv S Q hQ w)).fixedSubmodule) =
      Module.finrank ℚ ((σ → ℚ) ⧸ (Q.weylGroupRootRep w).fixedSubmodule) := by
  have : Finite Q.weylGroup := Q.finite_weylGroup
  let := Fintype.ofFinite Q.weylGroup
  let n := Fintype.card Q.weylGroup
  have hn : (Q.weylGroupRootRep w) ^ n = 1 := by
    rw [← map_pow, pow_card_eq_one, map_one]
  let : Invertible (n : S) := invertibleOfNonzero (Nat.cast_ne_zero.2 Fintype.card_ne_zero)
  -- `tensorPiEquiv` intertwines `(Q.weylGroupRootRep w).baseChange S` and the action on `σ → S`.
  have hinter : (tensorPiEquiv (σ := σ) (S := S)).toLinearMap ∘ₗ
      (Q.weylGroupRootRep w).baseChange S =
      (rootPairingBaseChange S Q hQ).weylGroupRootRep (weylGroupBaseChangeEquiv S Q hQ w)
        ∘ₗ (tensorPiEquiv (σ := σ) (S := S)).toLinearMap := by
    refine TensorProduct.AlgebraTensorModule.ext fun s x ↦ ?_
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearMap.baseChange_tmul,
      tensorPiEquiv_tmul, map_smul]
    change s • Pi.algebraMap σ ℚ S (w • x) =
      s • (weylGroupBaseChangeEquiv S Q hQ w • Pi.algebraMap σ ℚ S x)
    rw [weylGroupBaseChangeEquiv_smul]
  have hfin1 : Module.finrank S
      ((rootPairingBaseChange S Q hQ).weylGroupRootRep
        (weylGroupBaseChangeEquiv S Q hQ w)).fixedSubmodule =
      Module.finrank ℚ (Q.weylGroupRootRep w).fixedSubmodule := by
    rw [← (tensorPiEquiv (σ := σ) (S := S)).fixedSubmoduleCongr hinter |>.finrank_eq,
      ← ((Q.weylGroupRootRep w).fixedSubmoduleBaseChangeEquivOfInvertible S hn).finrank_eq]
    have := Module.Free.of_divisionRing ℚ (Q.weylGroupRootRep w).fixedSubmodule
    exact Module.finrank_baseChange
  have h1 := Submodule.finrank_quotient_add_finrank
    ((rootPairingBaseChange S Q hQ).weylGroupRootRep
      (weylGroupBaseChangeEquiv S Q hQ w)).fixedSubmodule
  have h2 := Submodule.finrank_quotient_add_finrank (Q.weylGroupRootRep w).fixedSubmodule
  rw [Module.finrank_pi, hfin1] at h1
  rw [Module.finrank_pi] at h2
  omega

/-- Transporting a root pairing along an equivalence preserves the codimension of every
Weyl-group element's fixed space. -/
private theorem finrank_quotient_fixedSubmodule_equiv
    {ι₁ ι₂ K M₁ N₁ M₂ N₂ : Type*} [Field K]
    [AddCommGroup M₁] [Module K M₁] [AddCommGroup N₁] [Module K N₁]
    [AddCommGroup M₂] [Module K M₂] [AddCommGroup N₂] [Module K N₂]
    {P₁ : RootPairing ι₁ K M₁ N₁} {P₂ : RootPairing ι₂ K M₂ N₂}
    (e : P₁.Equiv P₂) (w : P₁.weylGroup) :
    Module.finrank K (M₂ ⧸ (P₂.weylGroupRootRep (e.weylGroupEquiv w)).fixedSubmodule) =
      Module.finrank K (M₁ ⧸ (P₁.weylGroupRootRep w).fixedSubmodule) := by
  have hinter : e.weightEquiv.toLinearMap ∘ₗ P₁.weylGroupRootRep w =
      P₂.weylGroupRootRep (e.weylGroupEquiv w) ∘ₗ e.weightEquiv.toLinearMap := by
    ext x
    exact (e.weylGroupEquiv_smul w x).symm
  have hmap : (P₁.weylGroupRootRep w).fixedSubmodule.map e.weightEquiv.toLinearMap =
      (P₂.weylGroupRootRep (e.weylGroupEquiv w)).fixedSubmodule :=
    e.weightEquiv.map_fixedSubmodule hinter
  exact (Submodule.Quotient.equiv _ _ e.weightEquiv hmap).finrank_eq.symm

variable {ι K M N : Type*} [Field K] [CharZero K] [AddCommGroup M] [Module K M]
  [AddCommGroup N] [Module K N] (P : RootPairing ι K M N)
  [Finite ι] [P.IsCrystallographic] [P.IsReduced] [P.IsRootSystem]

/-- **Classification of pseudoreflections in a crystallographic Weyl group.** Over any field of
characteristic zero, the pseudoreflections of `P.weylGroupRootRep` are precisely the root
reflections `weylGroup.ofIdx P i`. -/
theorem finrank_quotient_fixedSubmodule_weylGroupRootRep_eq_one_iff (w : P.weylGroup) :
    Module.finrank K (M ⧸ (P.weylGroupRootRep w).fixedSubmodule) = 1 ↔
      ∃ i : ι, w = weylGroup.ofIdx P i := by
  constructor
  · intro hw
    obtain ⟨b⟩ := P.nonempty_base
    let e := b.equivBaseChangeRationalModel
    let eBC := weylGroupBaseChangeEquiv K b.rationalModel b.rationalModel_toLinearMap
    let wQ : b.rationalModel.weylGroup := eBC.symm (e.weylGroupEquiv w)
    have hwQ : Module.finrank ℚ
        ((b.support → ℚ) ⧸ (b.rationalModel.weylGroupRootRep wQ).fixedSubmodule) = 1 := by
      have h1 := finrank_quotient_fixedSubmodule_rootPairingBaseChange b.rationalModel
        b.rationalModel_toLinearMap (S := K) wQ
      have h2 := finrank_quotient_fixedSubmodule_equiv e w
      have hwQ_eq : weylGroupBaseChangeEquiv K b.rationalModel b.rationalModel_toLinearMap wQ =
          e.weylGroupEquiv w := eBC.apply_symm_apply _
      rw [← h1, hwQ_eq, h2, hw]
    obtain ⟨i, hi⟩ := exists_ofIdx_eq_of_finrank_quotient_fixedSubmodule_eq_one_ordered
      b.rationalModel b.rationalModelBase hwQ
    refine ⟨i, e.weylGroupEquiv.injective ?_⟩
    have h1 : e.weylGroupEquiv w = eBC wQ := by simp [wQ]
    rw [h1, hi, weylGroupBaseChangeEquiv_ofIdx, Equiv.weylGroupEquiv_ofIdx]
    simp [e]
  · rintro ⟨i, rfl⟩
    exact P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx i

/-- The number of pseudoreflections in a crystallographic Weyl group equals the number of positive
roots of any base. -/
theorem card_pseudoreflections_weylGroupRootRep_eq_ncard_posRoots (b : P.Base)
    [Fintype P.weylGroup] :
    #{w : P.weylGroup | Module.finrank K (M ⧸ (P.weylGroupRootRep w).fixedSubmodule) = 1} =
      (posRoots P b).ncard := by
  classical
  rw [← card_posRootsFinset P b]
  symm
  refine Finset.card_bij (fun i _ ↦ weylGroup.ofIdx P i) ?_ ?_ ?_
  · intro i _
    exact Finset.mem_filter.2 ⟨Finset.mem_univ _,
      P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx i⟩
  · intro i hi j hj hij
    rw [mem_posRootsFinset] at hi hj
    rcases (P.weylGroup_ofIdx_eq_iff i j).1 hij with rfl | rfl
    · rfl
    · exact ((reflectionPerm_self_notMem_posRoots P b hi) hj).elim
  · intro w hw
    obtain ⟨i, rfl⟩ := (P.finrank_quotient_fixedSubmodule_weylGroupRootRep_eq_one_iff w).1
      (Finset.mem_filter.1 hw).2
    by_cases hi : i ∈ posRoots P b
    · exact ⟨i, (mem_posRootsFinset P b i).2 hi, rfl⟩
    · refine ⟨P.reflectionPerm i i, (mem_posRootsFinset P b _).2 ?_, ?_⟩
      · exact (mem_posRoots P b _).2 ((isPos_reflectionPerm_self_iff_mem_negRoots P b i).2
          ((not_mem_posRoots_iff_mem_negRoots P b i).1 hi))
      · exact ((P.weylGroup_ofIdx_eq_iff i (P.reflectionPerm i i)).2 (.inr rfl)).symm

/-- Twice the number of pseudoreflections in a crystallographic Weyl group equals the number of
roots. -/
theorem two_mul_card_pseudoreflections_weylGroupRootRep [Fintype P.weylGroup] :
    2 * #{w : P.weylGroup | Module.finrank K (M ⧸ (P.weylGroupRootRep w).fixedSubmodule) = 1} =
      Nat.card ι := by
  obtain ⟨b⟩ := P.nonempty_base
  rw [P.card_pseudoreflections_weylGroupRootRep_eq_ncard_posRoots b, two_mul_ncard_posRoots P b]

/-- The reflecting hyperplanes of `P.weylGroupRootRep` are precisely the coroot hyperplanes
`ker (P.coroot' i)`. -/
theorem mem_reflectingHyperplanes_weylGroupRootRep_iff [Finite P.weylGroup] (H : Submodule K M) :
    H ∈ P.weylGroupRootRep.reflectingHyperplanes ↔
      ∃ i : ι, LinearMap.ker (P.coroot' i) = H := by
  rw [P.weylGroupRootRep.mem_reflectingHyperplanes]
  constructor
  · rintro ⟨w, hw, rfl⟩
    obtain ⟨i, rfl⟩ := (P.finrank_quotient_fixedSubmodule_weylGroupRootRep_eq_one_iff w).1 hw
    exact ⟨i, (P.fixedSubmodule_weylGroupRootRep_ofIdx i).symm⟩
  · rintro ⟨i, rfl⟩
    exact ⟨weylGroup.ofIdx P i, P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx i,
      P.fixedSubmodule_weylGroupRootRep_ofIdx i⟩

/-- A weight lies on a reflecting hyperplane of `P.weylGroupRootRep` if and only if it is not
regular. -/
theorem exists_mem_reflectingHyperplanes_weylGroupRootRep_iff [Finite P.weylGroup] (v : M) :
    (∃ H ∈ P.weylGroupRootRep.reflectingHyperplanes, v ∈ H) ↔ ¬ IsRegularWeight P v := by
  simp only [P.mem_reflectingHyperplanes_weylGroupRootRep_iff, isRegularWeight_iff, not_forall,
    not_not]
  constructor
  · rintro ⟨H, ⟨i, rfl⟩, hv⟩
    exact ⟨i, LinearMap.mem_ker.1 hv⟩
  · rintro ⟨i, hi⟩
    exact ⟨LinearMap.ker (P.coroot' i), ⟨i, rfl⟩, LinearMap.mem_ker.2 hi⟩

/-- **Sum of exponents for a crystallographic Weyl group.** For any system of homogeneous basic
invariants `f` of `P.weylGroupRootRep.dual` with degrees `d`, the sum `∑ i, (d i - 1)` equals the
number of positive roots of any base `b`. -/
theorem sum_sub_one_eq_ncard_posRoots_of_bijective_aeval_weylGroupRootRep_dual (b : P.Base)
    {κ : Type*} [Fintype κ] {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    {d : κ → ℕ}
    (hf : ∀ i, (f i : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∑ i, (d i - 1) = (posRoots P b).ncard := by
  have : FiniteDimensional K M := Module.Finite.of_basis b.toWeightBasis
  have : Finite P.weylGroup := P.finite_weylGroup
  let := Fintype.ofFinite P.weylGroup
  rw [P.weylGroupRootRep.sum_sub_one_eq_card_of_bijective_aeval_symmetricAlgebraInvariants_dual
    P.weylGroupRootRep_injective hf hbij,
    P.card_pseudoreflections_weylGroupRootRep_eq_ncard_posRoots b]

/-- Twice the sum of `d i - 1` over basic invariants of a crystallographic Weyl group equals the
number of roots. -/
theorem two_mul_sum_sub_one_eq_natCard_of_bijective_aeval_weylGroupRootRep_dual
    {κ : Type*} [Fintype κ] {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    {d : κ → ℕ}
    (hf : ∀ i, (f i : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    2 * ∑ i, (d i - 1) = Nat.card ι := by
  obtain ⟨b⟩ := P.nonempty_base
  rw [P.sum_sub_one_eq_ncard_posRoots_of_bijective_aeval_weylGroupRootRep_dual b hf hbij,
    two_mul_ncard_posRoots P b]

/-- **Jacobian regularity criterion for Weyl groups.** The Jacobian of a system of homogeneous
basic invariants of a finite reduced crystallographic Weyl group is nonzero at a weight `v` if and
only if `v` is regular. -/
theorem lift_jacobian_ne_zero_iff_isRegularWeight
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    (e : Module.Basis κ K (Module.Dual K M))
    {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : κ → ℕ}
    (hf : ∀ i, (f i : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) (v : M) :
    lift (Module.Dual.eval K M v)
        (jacobian e (fun i ↦ (f i : SymmetricAlgebra K (Module.Dual K M)))) ≠ 0 ↔
      IsRegularWeight P v := by
  obtain ⟨b⟩ := P.nonempty_base
  have : FiniteDimensional K M := Module.Finite.of_basis b.toWeightBasis
  have : Finite P.weylGroup := P.finite_weylGroup
  rw [ne_eq, P.weylGroupRootRep.lift_jacobian_eq_zero_iff_exists_mem_reflectingHyperplanes
    P.weylGroupRootRep_injective e hf hbij v,
    P.exists_mem_reflectingHyperplanes_weylGroupRootRep_iff v, not_not]

end PseudoreflectionClassification

section BaseChangeDegrees

/-- Equivalent representations (up to group isomorphism and linear equivalence) have equal
graded dimensions of polynomial invariants. -/
private theorem finrank_symmetricAlgebraInvariants_inf_homogeneousSubmodule_of_equiv
    {K G₁ G₂ V₁ V₂ : Type*} [Field K] [Group G₁] [Group G₂]
    [AddCommGroup V₁] [Module K V₁] [AddCommGroup V₂] [Module K V₂]
    {ρ₁ : Representation K G₁ V₁} {ρ₂ : Representation K G₂ V₂}
    (eG : G₁ ≃* G₂) (eV : V₁ ≃ₗ[K] V₂)
    (he : ∀ g x, ρ₂ (eG g) (eV x) = eV (ρ₁ g x)) (n : ℕ) :
    Module.finrank K
        ↥(Subalgebra.toSubmodule ρ₁.symmetricAlgebraInvariants ⊓
          homogeneousSubmodule K V₁ n) =
      Module.finrank K
        ↥(Subalgebra.toSubmodule ρ₂.symmetricAlgebraInvariants ⊓
          homogeneousSubmodule K V₂ n) := by
  let ρ₂' : Representation K G₁ V₂ := ρ₂.comp eG.toMonoidHom
  have hinv_eq : ρ₂'.symmetricAlgebraInvariants = ρ₂.symmetricAlgebraInvariants :=
    ρ₂.symmetricAlgebraInvariants_comp_of_surjective eG.toMonoidHom eG.surjective
  have hf : IsIntertwiningMap ρ₁ ρ₂' eV.toLinearMap := ⟨fun g x ↦ (he g x).symm⟩
  have hs : IsIntertwiningMap ρ₂' ρ₁ eV.symm.toLinearMap := ⟨fun g y ↦ by
    apply eV.injective
    have h := he g (eV.symm y)
    simp only [LinearEquiv.apply_symm_apply] at h
    simp only [LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply]
    exact h⟩
  let φ : SymmetricAlgebra K V₁ ≃ₗ[K] SymmetricAlgebra K V₂ :=
    LinearEquiv.ofLinearMap (SymmetricAlgebra.map K eV.toLinearMap).toLinearMap
      (SymmetricAlgebra.map K eV.symm.toLinearMap).toLinearMap
      (LinearMap.ext fun p ↦ SymmetricAlgebra.map_leftInverse K eV.apply_symm_apply p)
      (LinearMap.ext fun p ↦ SymmetricAlgebra.map_leftInverse K eV.symm_apply_apply p)
  have hmap : (Subalgebra.toSubmodule ρ₁.symmetricAlgebraInvariants ⊓
        homogeneousSubmodule K V₁ n).map φ.toLinearMap =
      Subalgebra.toSubmodule ρ₂.symmetricAlgebraInvariants ⊓
        homogeneousSubmodule K V₂ n := by
    rw [← hinv_eq]
    ext q
    simp only [Submodule.mem_map, Submodule.mem_inf, Subalgebra.mem_toSubmodule]
    constructor
    · rintro ⟨p, ⟨hp1, hp2⟩, rfl⟩
      exact ⟨map_mem_symmetricAlgebraInvariants hf hp1, map_mem_homogeneousSubmodule _ hp2⟩
    · rintro ⟨hq1, hq2⟩
      refine ⟨φ.symm q, ⟨map_mem_symmetricAlgebraInvariants hs hq1,
        map_mem_homogeneousSubmodule _ hq2⟩, φ.apply_symm_apply q⟩
  exact (φ.submoduleMap _).trans (LinearEquiv.ofEq _ _ hmap) |>.finrank_eq

/-- Extending a rational dot-product root system to a characteristic-zero field `S` preserves the
graded dimensions of its contragredient polynomial invariants. -/
private theorem finrank_symmetricAlgebraInvariants_weylGroupRootRep_dual_rootPairingBaseChange
    {ι σ S : Type*} [Finite ι] [Fintype σ] [Field S] [CharZero S]
    (Q : RootPairing ι ℚ (σ → ℚ) (σ → ℚ))
    (hQ : ∀ x y, Q.toLinearMap x y = x ⬝ᵥ y)
    [Q.IsRootSystem] (n : ℕ) :
    Module.finrank S
        ↥(Subalgebra.toSubmodule
            (rootPairingBaseChange S Q hQ).weylGroupRootRep.dual.symmetricAlgebraInvariants ⊓
          homogeneousSubmodule S (Module.Dual S (σ → S)) n) =
      Module.finrank ℚ
        ↥(Subalgebra.toSubmodule Q.weylGroupRootRep.dual.symmetricAlgebraInvariants ⊓
          homogeneousSubmodule ℚ (Module.Dual ℚ (σ → ℚ)) n) := by
  have : Finite Q.weylGroup := Q.finite_weylGroup
  let eG := weylGroupBaseChangeEquiv S Q hQ
  let ePi : S ⊗[ℚ] (σ → ℚ) ≃ₗ[S] (σ → S) := tensorPiEquiv
  let eDual : S ⊗[ℚ] Module.Dual ℚ (σ → ℚ) ≃ₗ[S] Module.Dual S (σ → S) :=
    (TauCeti.Module.Dual.baseChangeEvaluationEquiv (R := ℚ) (A := S) (M := σ → ℚ)).trans
      ePi.symm.dualMap
  have hePi (w : Q.weylGroup) (z : S ⊗[ℚ] (σ → ℚ)) :
      eG w • ePi z = ePi ((Q.weylGroupRootRep.baseChange S) w z) := by
    induction z with
    | add x y hx hy => simp [smul_add, map_add, hx, hy]
    | tmul s x =>
      simp only [ePi, tensorPiEquiv_tmul, smul_comm, Representation.baseChange_apply,
        LinearMap.baseChange_tmul]
      change s • (eG w • Pi.algebraMap σ ℚ S x) = s • Pi.algebraMap σ ℚ S (w • x)
      rw [weylGroupBaseChangeEquiv_smul]
  have heDual (w : Q.weylGroup) (ψ : S ⊗[ℚ] Module.Dual ℚ (σ → ℚ)) :
      (rootPairingBaseChange S Q hQ).weylGroupRootRep.dual (eG w) (eDual ψ) =
        eDual ((Q.weylGroupRootRep.dual.baseChange S) w ψ) := by
    induction ψ with
    | add x y hx hy => rw [map_add, map_add, map_add, map_add, hx, hy]
    | tmul s φ =>
      apply LinearMap.ext
      intro y
      obtain ⟨z, rfl⟩ := ePi.surjective y
      induction z with
      | add a b ha hb => rw [map_add, map_add, map_add, ha, hb]
      | tmul t x =>
        have hinv : eG w⁻¹ • ePi (t ⊗ₜ[ℚ] x) =
            ePi (t ⊗ₜ[ℚ] (Q.weylGroupRootRep w⁻¹ x)) := by
          simpa [Representation.baseChange_apply, LinearMap.baseChange_tmul] using
            hePi w⁻¹ (t ⊗ₜ[ℚ] x)
        simp only [eDual, LinearEquiv.trans_apply, LinearEquiv.dualMap_apply,
          TauCeti.Module.Dual.baseChangeEvaluationEquiv_apply, Representation.dual_apply,
          Representation.baseChange_apply, LinearMap.baseChange_tmul, ← map_inv eG]
        change (TauCeti.Module.Dual.baseChangeEvaluation (R := ℚ) (A := S) (s ⊗ₜ[ℚ] φ))
            (ePi.symm (eG w⁻¹ • ePi (t ⊗ₜ[ℚ] x))) =
          (TauCeti.Module.Dual.baseChangeEvaluation (R := ℚ) (A := S)
            (s ⊗ₜ[ℚ] (Q.weylGroupRootRep.dual w φ))) (ePi.symm (ePi (t ⊗ₜ[ℚ] x)))
        rw [hinv, ePi.symm_apply_apply, ePi.symm_apply_apply,
          TauCeti.Module.Dual.baseChangeEvaluation_tmul,
          TauCeti.Module.Dual.baseChangeEvaluation_tmul]
        rfl
  rw [← finrank_symmetricAlgebraInvariants_inf_homogeneousSubmodule_of_equiv eG eDual heDual n]
  exact finrank_symmetricAlgebraInvariants_baseChange_inf_homogeneousSubmodule
    Q.weylGroupRootRep.dual (L := S) n

/-- **Base-change invariance of basic invariant degrees.** For any finite crystallographic root
system `P` over a characteristic-zero field `K` with base `b`, and any other characteristic-zero
field `L`, the basic invariant degrees of `P.weylGroupRootRep.dual` agree (as multisets) with those
of the base change of `b.rationalModel` to `L`. -/
theorem Base.map_univ_eq_of_bijective_aeval_weylGroupRootRep_dual
    {ι K M N : Type*} [Field K] [CharZero K] [AddCommGroup M] [Module K M]
    [AddCommGroup N] [Module K N] {P : RootPairing ι K M N}
    [Finite ι] [P.IsCrystallographic] [P.IsRootSystem] (b : P.Base)
    (L : Type*) [Field L] [CharZero L]
    {κ₁ κ₂ : Type*} [Fintype κ₁] [Fintype κ₂]
    {f : κ₁ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : κ₁ → ℕ}
    (hf : ∀ i, (f i : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f))
    {g : κ₂ → (rootPairingBaseChange L b.rationalModel
        b.rationalModel_toLinearMap).weylGroupRootRep.dual.symmetricAlgebraInvariants}
    {e : κ₂ → ℕ}
    (hg : ∀ j, (g j : SymmetricAlgebra L (Module.Dual L (b.support → L))) ∈
      homogeneousSubmodule L (Module.Dual L (b.support → L)) (e j))
    (hgbij : Function.Bijective (MvPolynomial.aeval (R := L) g)) :
    Finset.univ.val.map d = Finset.univ.val.map e := by
  set PL := rootPairingBaseChange L b.rationalModel b.rationalModel_toLinearMap
  set PK := rootPairingBaseChange K b.rationalModel b.rationalModel_toLinearMap
  have hd : ∀ i, d i ≠ 0 :=
    P.weylGroupRootRep.dual.ne_zero_of_injective_aeval_symmetricAlgebraInvariants hf hbij.1
  have he : ∀ j, e j ≠ 0 :=
    PL.weylGroupRootRep.dual.ne_zero_of_injective_aeval_symmetricAlgebraInvariants hg hgbij.1
  -- Compare Hilbert series in `ℤ⟦X⟧` via `b.rationalModel`.
  have hfin (n : ℕ) :
      Module.finrank K
          ↥(Subalgebra.toSubmodule P.weylGroupRootRep.dual.symmetricAlgebraInvariants ⊓
            homogeneousSubmodule K (Module.Dual K M) n) =
        Module.finrank L
          ↥(Subalgebra.toSubmodule PL.weylGroupRootRep.dual.symmetricAlgebraInvariants ⊓
            homogeneousSubmodule L (Module.Dual L (b.support → L)) n) := by
    let eqv := b.equivBaseChangeRationalModel
    have hdual : ∀ (w : P.weylGroup) (φ : Module.Dual K (b.support → K)),
        P.weylGroupRootRep.dual (eqv.weylGroupEquiv.symm (eqv.weylGroupEquiv w))
            (eqv.weightEquiv.dualMap φ) =
          eqv.weightEquiv.dualMap (PK.weylGroupRootRep.dual (eqv.weylGroupEquiv w) φ) := by
      intro w φ
      ext x
      simp only [MulEquiv.symm_apply_apply, Representation.dual_apply, LinearEquiv.dualMap_apply]
      change φ (eqv.weightEquiv (w⁻¹ • x)) =
        φ ((eqv.weylGroupEquiv w)⁻¹ • eqv.weightEquiv x)
      rw [← map_inv, eqv.weylGroupEquiv_smul]
    have h1 : Module.finrank K
        ↥(Subalgebra.toSubmodule PK.weylGroupRootRep.dual.symmetricAlgebraInvariants ⊓
          homogeneousSubmodule K (Module.Dual K (b.support → K)) n) =
        Module.finrank K
          ↥(Subalgebra.toSubmodule P.weylGroupRootRep.dual.symmetricAlgebraInvariants ⊓
            homogeneousSubmodule K (Module.Dual K M) n) :=
      finrank_symmetricAlgebraInvariants_inf_homogeneousSubmodule_of_equiv eqv.weylGroupEquiv.symm
        eqv.weightEquiv.dualMap (fun w φ ↦ by
          obtain ⟨u, rfl⟩ := eqv.weylGroupEquiv.surjective w
          exact hdual u φ) n
    rw [← h1,
      finrank_symmetricAlgebraInvariants_weylGroupRootRep_dual_rootPairingBaseChange b.rationalModel
        b.rationalModel_toLinearMap n,
      finrank_symmetricAlgebraInvariants_weylGroupRootRep_dual_rootPairingBaseChange b.rationalModel
        b.rationalModel_toLinearMap n]
