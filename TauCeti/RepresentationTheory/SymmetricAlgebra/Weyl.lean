section FieldRootSystem

variable {ι K M N : Type*} [Field K] [AddCommGroup M] [Module K M]
  [AddCommGroup N] [Module K N] (P : RootPairing ι K M N) [Finite ι] [P.IsRootSystem]

/-- On a finite root system over any field, any polynomial generating system of `Sym(M*)^W` has
`finrank K M` members. -/
theorem natCard_eq_finrank_of_bijective_aeval_weylGroupRootRep_dual
    {κ : Type*} {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    Nat.card κ = finrank K M := by
  have := P.finite_weylGroup
  rw [P.weylGroupRootRep.dual.card_eq_finrank_of_bijective_aeval_symmetricAlgebraInvariants hbij,
    Subspace.dual_finrank_eq]

/-- On a finite root system (`P.IsRootSystem`) with base `b` over any field, any polynomial
generating system of `Sym(M*)^W` has `b.support.card` members (the semisimple rank). -/
theorem natCard_eq_card_support_of_bijective_aeval_weylGroupRootRep_dual
    (b : P.Base) {κ : Type*} {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    Nat.card κ = b.support.card := by
  rw [P.natCard_eq_finrank_of_bijective_aeval_weylGroupRootRep_dual hbij,
    Module.finrank_eq_card_basis b.toWeightBasis, Fintype.card_coe]

end FieldRootSystem

section Nonmodular

open Representation

variable {ι K M N : Type*} [Field K] [NeZero (2 : K)] [AddCommGroup M] [Module K M]
  [AddCommGroup N] [Module K N] (P : RootPairing ι K M N)

/-- **Polynomial functions on the weight space are faithfully flat over Weyl invariants.** Only
`char K ≠ 2` and `(Nat.card P.weylGroup : K) ≠ 0` are required; neither finite-dimensionality of
`M` nor spanning of the roots is needed. -/
theorem faithfullyFlat_symmetricAlgebra_weylGroupRootRep_dual
    (hW : (Nat.card P.weylGroup : K) ≠ 0) :
    Module.FaithfullyFlat P.weylGroupRootRep.dual.symmetricAlgebraInvariants
      (SymmetricAlgebra K (Module.Dual K M)) := by
  classical
  have : Finite P.weylGroup := Nat.finite_of_card_ne_zero fun h ↦ hW (by simp [h])
  let := Fintype.ofFinite P.weylGroup
  let : Invertible (Fintype.card P.weylGroup : K) :=
    invertibleOfNonzero (by rwa [← Nat.card_eq_fintype_card])
  exact P.weylGroupRootRep.faithfullyFlat_symmetricAlgebra_dual_of_pseudoreflectionSubgroup_eq_top
    P.pseudoreflectionSubgroup_weylGroupRootRep

/-- **Polynomial functions on the weight space are free over Weyl invariants** whenever `M` is
finite-dimensional, `char K ≠ 2`, and `(Nat.card P.weylGroup : K) ≠ 0`. -/
theorem free_symmetricAlgebra_weylGroupRootRep_dual [FiniteDimensional K M]
    (hW : (Nat.card P.weylGroup : K) ≠ 0) :
    Module.Free P.weylGroupRootRep.dual.symmetricAlgebraInvariants
      (SymmetricAlgebra K (Module.Dual K M)) := by
  classical
  have : Finite P.weylGroup := Nat.finite_of_card_ne_zero fun h ↦ hW (by simp [h])
  let := Fintype.ofFinite P.weylGroup
  let : Invertible (Fintype.card P.weylGroup : K) :=
    invertibleOfNonzero (by rwa [← Nat.card_eq_fintype_card])
  exact P.weylGroupRootRep.free_symmetricAlgebra_dual_of_pseudoreflectionSubgroup_eq_top
    P.pseudoreflectionSubgroup_weylGroupRootRep

/-- **The Weyl coinvariant algebra has dimension `|W|`** whenever `M` is finite-dimensional,
`char K ≠ 2`, and `(Nat.card P.weylGroup : K) ≠ 0`. -/
theorem finrank_quotient_symmetricAlgebraHilbertIdeal_weylGroupRootRep_dual
    [FiniteDimensional K M] (hW : (Nat.card P.weylGroup : K) ≠ 0) :
    finrank K
      (SymmetricAlgebra K (Module.Dual K M) ⧸
        P.weylGroupRootRep.dual.symmetricAlgebraHilbertIdeal) =
      Nat.card P.weylGroup := by
  classical
  have : Finite P.weylGroup := Nat.finite_of_card_ne_zero fun h ↦ hW (by simp [h])
  let := Fintype.ofFinite P.weylGroup
  let : Invertible (Fintype.card P.weylGroup : K) :=
    invertibleOfNonzero (by rwa [← Nat.card_eq_fintype_card])
  exact
    finrank_quotient_symmetricAlgebraHilbertIdeal_dual_of_pseudoreflectionSubgroup_eq_top
      P.weylGroupRootRep P.pseudoreflectionSubgroup_weylGroupRootRep P.weylGroupRootRep_injective

/-- **Chevalley–Shephard–Todd polynomiality for Weyl invariants.** Over a field `K` of
characteristic not `2` in which `Nat.card P.weylGroup` is nonzero, the polynomial invariants
`Sym(M*)^W` of a finite-dimensional weight space `M` form a polynomial algebra on `finrank K M`
homogeneous invariants of positive degree. -/
theorem exists_bijective_aeval_symmetricAlgebraInvariants_weylGroupRootRep_dual
    [FiniteDimensional K M] (hW : (Nat.card P.weylGroup : K) ≠ 0) :
    ∃ f : Fin (finrank K M) → P.weylGroupRootRep.dual.symmetricAlgebraInvariants,
      (∀ k, ∃ d, 0 < d ∧
        (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
          homogeneousSubmodule K (Module.Dual K M) d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  classical
  have : Finite P.weylGroup := Nat.finite_of_card_ne_zero fun h ↦ hW (by simp [h])
  let := Fintype.ofFinite P.weylGroup
  let : Invertible (Fintype.card P.weylGroup : K) :=
    invertibleOfNonzero (by rwa [← Nat.card_eq_fintype_card])
  exact
    exists_bijective_aeval_symmetricAlgebraInvariants_dual_of_pseudoreflectionSubgroup_eq_top
      P.weylGroupRootRep P.pseudoreflectionSubgroup_weylGroupRootRep

/-- **Coinvariant Hilbert series of a Weyl group.** For any homogeneous system of basic invariants
of `P.weylGroupRootRep.dual` in nonmodular characteristic (`char K ≠ 2` and
`(Nat.card P.weylGroup : K) ≠ 0`), the coinvariant Hilbert series with coefficients in any
commutative ring `S` is `(1 - X)^(-dim M) * ∏ k, (1 - X ^ d k)`. -/
theorem mk_finrank_quotientPiece_hilbertIdeal_weylGroupRootRep_dual_eq_invOneSubPow
    [FiniteDimensional K M] (hW : (Nat.card P.weylGroup : K) ≠ 0)
    {S : Type*} [CommRing S] {κ : Type*} [Fintype κ]
    (f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants) (d : κ → ℕ)
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    PowerSeries.mk (fun j ↦ (finrank K
      (quotientPiece (homogeneousSubmodule K (Module.Dual K M))
        P.weylGroupRootRep.dual.symmetricAlgebraHilbertIdeal j) : S)) =
      (PowerSeries.invOneSubPow S (finrank K M) : PowerSeries S) *
        ∏ k, (1 - PowerSeries.X ^ d k) := by
  classical
  have : Finite P.weylGroup := Nat.finite_of_card_ne_zero fun h ↦ hW (by simp [h])
  let := Fintype.ofFinite P.weylGroup
  let : Invertible (Fintype.card P.weylGroup : K) :=
    invertibleOfNonzero (by rwa [← Nat.card_eq_fintype_card])
  exact
    mk_finrank_quotientPiece_hilbertIdeal_dual_eq_invOneSubPow_of_pseudoreflectionSubgroup_eq_top
      P.weylGroupRootRep P.pseudoreflectionSubgroup_weylGroupRootRep f d hf hbij

/-- **Denominator-cleared coinvariant Hilbert series of a Weyl group.** Multiplying the Hilbert
series of `Sym(M*) ⧸ I_W` by `(1 - X)^(dim M)` gives `∏ k, (1 - X ^ d k)`. -/
theorem mk_finrank_quotientPiece_hilbertIdeal_weylGroupRootRep_dual_mul_one_sub_X_pow
    [FiniteDimensional K M] (hW : (Nat.card P.weylGroup : K) ≠ 0)
    {S : Type*} [CommRing S] {κ : Type*} [Fintype κ]
    (f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants) (d : κ → ℕ)
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    PowerSeries.mk (fun j ↦ (finrank K
      (quotientPiece (homogeneousSubmodule K (Module.Dual K M))
        P.weylGroupRootRep.dual.symmetricAlgebraHilbertIdeal j) : S)) *
      (1 - PowerSeries.X) ^ finrank K M =
      ∏ k, (1 - PowerSeries.X ^ d k) := by
  classical
  have : Finite P.weylGroup := Nat.finite_of_card_ne_zero fun h ↦ hW (by simp [h])
  let := Fintype.ofFinite P.weylGroup
  let : Invertible (Fintype.card P.weylGroup : K) :=
    invertibleOfNonzero (by rwa [← Nat.card_eq_fintype_card])
  exact
    mk_finrank_quotientPiece_hilbertIdeal_dual_mul_one_sub_X_pow_of_pseudoreflectionSubgroup_eq_top
      P.weylGroupRootRep P.pseudoreflectionSubgroup_weylGroupRootRep f d hf hbij

end Nonmodular

section CharZero

variable {ι K M N : Type*} [Field K] [CharZero K] [AddCommGroup M] [Module K M]
  [AddCommGroup N] [Module K N] (P : RootPairing ι K M N)

section FiniteRootSystem

variable [Finite ι] [P.IsRootSystem]

/-- Over a field of characteristic zero, polynomial functions on the weight space of any finite
root system are faithfully flat over the Weyl invariants. Neither crystallographicity nor
reducedness is needed. -/
theorem faithfullyFlat_symmetricAlgebra_weylGroupRootRep_dual_of_isRootSystem :
    Module.FaithfullyFlat P.weylGroupRootRep.dual.symmetricAlgebraInvariants
      (SymmetricAlgebra K (Module.Dual K M)) := by
  have := P.finite_weylGroup
  exact P.faithfullyFlat_symmetricAlgebra_weylGroupRootRep_dual
    (Nat.cast_ne_zero.2 (Nat.card_pos (α := P.weylGroup)).ne')

/-- Over a field of characteristic zero, polynomial functions on the weight space of any finite
root system form a free module over the Weyl invariants. -/
theorem free_symmetricAlgebra_weylGroupRootRep_dual_of_isRootSystem :
    Module.Free P.weylGroupRootRep.dual.symmetricAlgebraInvariants
      (SymmetricAlgebra K (Module.Dual K M)) := by
  have : FiniteDimensional K M := P.finite_weight_of_isRootSystem
  have := P.finite_weylGroup
  exact P.free_symmetricAlgebra_weylGroupRootRep_dual
    (Nat.cast_ne_zero.2 (Nat.card_pos (α := P.weylGroup)).ne')

/-- Over a field of characteristic zero, the coinvariant algebra of any finite root system has
dimension `Nat.card P.weylGroup`. -/
theorem finrank_quotient_symmetricAlgebraHilbertIdeal_weylGroupRootRep_dual_of_isRootSystem :
    finrank K
      (SymmetricAlgebra K (Module.Dual K M) ⧸
        P.weylGroupRootRep.dual.symmetricAlgebraHilbertIdeal) =
      Nat.card P.weylGroup := by
  have : FiniteDimensional K M := P.finite_weight_of_isRootSystem
  have := P.finite_weylGroup
  exact P.finrank_quotient_symmetricAlgebraHilbertIdeal_weylGroupRootRep_dual
    (Nat.cast_ne_zero.2 (Nat.card_pos (α := P.weylGroup)).ne')

/-- **Chevalley's theorem for a finite root system in characteristic zero.** Without assuming
crystallographicity, reducedness, or an explicit `FiniteDimensional K M` hypothesis, `Sym(M*)^W`
is a polynomial algebra on `finrank K M` homogeneous invariants of positive degree. -/
theorem exists_bijective_aeval_symmetricAlgebraInvariants_weylGroupRootRep_dual_of_isRootSystem :
    ∃ f : Fin (finrank K M) → P.weylGroupRootRep.dual.symmetricAlgebraInvariants,
      (∀ k, ∃ d, 0 < d ∧
        (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
          homogeneousSubmodule K (Module.Dual K M) d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  have : FiniteDimensional K M := P.finite_weight_of_isRootSystem
  have := P.finite_weylGroup
  exact P.exists_bijective_aeval_symmetricAlgebraInvariants_weylGroupRootRep_dual
    (Nat.cast_ne_zero.2 (Nat.card_pos (α := P.weylGroup)).ne')

/-- **Product of the degrees for a finite root system.** Over a field of characteristic zero, the
product of the degrees of any homogeneous basic invariant system of `P.weylGroupRootRep.dual` is
`Nat.card P.weylGroup`. -/
theorem prod_eq_natCard_of_bijective_aeval_weylGroupRootRep_dual
    {κ : Type*} [Fintype κ] {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∏ k, d k = Nat.card P.weylGroup := by
  classical
  have : FiniteDimensional K M := P.finite_weight_of_isRootSystem
  have := P.finite_weylGroup
  let := Fintype.ofFinite P.weylGroup
  rw [Nat.card_eq_fintype_card]
  exact P.weylGroupRootRep.dual.prod_eq_card_of_bijective_aeval_symmetricAlgebraInvariants
    (P.weylGroupRootRep.dual_injective_iff.mpr P.weylGroupRootRep_injective) hf hbij

/-- Coinvariant Hilbert series of any finite root system in characteristic zero. -/
theorem mk_finrank_quotientPiece_hilbertIdeal_weylGroupRootRep_dual_eq_invOneSubPow_of_isRootSystem
    {S : Type*} [CommRing S] {κ : Type*} [Fintype κ]
    (f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants) (d : κ → ℕ)
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    PowerSeries.mk (fun j ↦ (finrank K
      (quotientPiece (homogeneousSubmodule K (Module.Dual K M))
        P.weylGroupRootRep.dual.symmetricAlgebraHilbertIdeal j) : S)) =
      (PowerSeries.invOneSubPow S (finrank K M) : PowerSeries S) *
        ∏ k, (1 - PowerSeries.X ^ d k) := by
  have : FiniteDimensional K M := P.finite_weight_of_isRootSystem
  have := P.finite_weylGroup
  exact P.mk_finrank_quotientPiece_hilbertIdeal_weylGroupRootRep_dual_eq_invOneSubPow
    (Nat.cast_ne_zero.2 (Nat.card_pos (α := P.weylGroup)).ne') f d hf hbij

/-- Denominator-cleared coinvariant Hilbert series of any finite root system in characteristic
zero. -/
theorem
    mk_finrank_quotientPiece_hilbertIdeal_weylGroupRootRep_dual_mul_one_sub_X_pow_of_isRootSystem
    {S : Type*} [CommRing S] {κ : Type*} [Fintype κ]
    (f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants) (d : κ → ℕ)
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    PowerSeries.mk (fun j ↦ (finrank K
      (quotientPiece (homogeneousSubmodule K (Module.Dual K M))
        P.weylGroupRootRep.dual.symmetricAlgebraHilbertIdeal j) : S)) *
      (1 - PowerSeries.X) ^ finrank K M =
      ∏ k, (1 - PowerSeries.X ^ d k) := by
  have : FiniteDimensional K M := P.finite_weight_of_isRootSystem
  have := P.finite_weylGroup
  exact P.mk_finrank_quotientPiece_hilbertIdeal_weylGroupRootRep_dual_mul_one_sub_X_pow
    (Nat.cast_ne_zero.2 (Nat.card_pos (α := P.weylGroup)).ne') f d hf hbij

end FiniteRootSystem

section ReducedCrystallographic

variable [Finite ι] [P.IsCrystallographic] [P.IsReduced]

/-- **Chevalley's theorem for a reduced crystallographic root pairing with a base.** The roots need
not span `M`, so reductive central fixed directions are included among the `finrank K M` polynomial
generators (contributing degree-one invariants). -/
theorem exists_bijective_aeval_symmetricAlgebraInvariants_weylGroupRootRep_dual_of_base
    [FiniteDimensional K M] (b : P.Base) :
    ∃ f : Fin (finrank K M) → P.weylGroupRootRep.dual.symmetricAlgebraInvariants,
      (∀ k, ∃ d, 0 < d ∧
        (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
          homogeneousSubmodule K (Module.Dual K M) d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  have := P.finite_weylGroup_of_base b
  exact P.exists_bijective_aeval_symmetricAlgebraInvariants_weylGroupRootRep_dual
    (Nat.cast_ne_zero.2 (Nat.card_pos (α := P.weylGroup)).ne')

/-- On a finite reduced crystallographic root pairing with a base `b`, any polynomial generating
system of `Sym(M*)^W` has `finrank K M` members. -/
theorem natCard_eq_finrank_of_bijective_aeval_weylGroupRootRep_dual_of_base (b : P.Base)
    {κ : Type*} {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    Nat.card κ = finrank K M := by
  have := P.finite_weylGroup_of_base b
  rw [P.weylGroupRootRep.dual.card_eq_finrank_of_bijective_aeval_symmetricAlgebraInvariants hbij,
    Subspace.dual_finrank_eq]

/-- On a finite reduced crystallographic root pairing with a base `b` over a field of characteristic
zero, the product of the degrees of any homogeneous basic invariant system is
`Nat.card P.weylGroup`. -/
theorem prod_eq_natCard_of_bijective_aeval_weylGroupRootRep_dual_of_base
    [FiniteDimensional K M] (b : P.Base)
    {κ : Type*} [Fintype κ] {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∏ k, d k = Nat.card P.weylGroup := by
  classical
  have := P.finite_weylGroup_of_base b
  let := Fintype.ofFinite P.weylGroup
  rw [Nat.card_eq_fintype_card]
  exact P.weylGroupRootRep.dual.prod_eq_card_of_bijective_aeval_symmetricAlgebraInvariants
    (P.weylGroupRootRep.dual_injective_iff.mpr P.weylGroupRootRep_injective) hf hbij

/-- **Sum of the Weyl exponents equals the number of positive roots.** For a finite reduced
crystallographic root pairing with a base `b` in characteristic zero, the exponents `d k - 1` of
any homogeneous basic invariant system of `P.weylGroupRootRep.dual` sum to `(posRoots P b).ncard`.
Central fixed directions have `d k = 1` and contribute `0` to both sides. -/
theorem sum_sub_one_eq_ncard_posRoots_of_bijective_aeval_weylGroupRootRep_dual
    [FiniteDimensional K M] (b : P.Base)
    {κ : Type*} [Fintype κ] {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∑ k, (d k - 1) = (posRoots P b).ncard := by
  classical
  have := P.finite_weylGroup_of_base b
  let := Fintype.ofFinite P.weylGroup
  rw [P.weylGroupRootRep.sum_sub_one_eq_card_of_bijective_aeval_symmetricAlgebraInvariants_dual
    P.weylGroupRootRep_injective hf hbij, ← Fintype.card_subtype, ← Nat.card_eq_fintype_card,
    P.natCard_pseudoreflections_weylGroupRootRep_eq_ncard_posRoots b]

/-- **Sum of the Weyl degrees.** For a finite reduced crystallographic root pairing with a base `b`
in characteristic zero, the degrees of any homogeneous basic invariant system satisfy
`∑ k, d k = finrank K M + (posRoots P b).ncard`. -/
theorem sum_eq_finrank_add_ncard_posRoots_of_bijective_aeval_weylGroupRootRep_dual
    [FiniteDimensional K M] (b : P.Base)
    {κ : Type*} [Fintype κ] {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∑ k, d k = finrank K M + (posRoots P b).ncard := by
  classical
  have := P.finite_weylGroup_of_base b
  let := Fintype.ofFinite P.weylGroup
  rw [P.weylGroupRootRep.sum_eq_finrank_add_card_of_bijective_aeval_symmetricAlgebraInvariants_dual
    P.weylGroupRootRep_injective hf hbij, ← Fintype.card_subtype, ← Nat.card_eq_fintype_card,
    P.natCard_pseudoreflections_weylGroupRootRep_eq_ncard_posRoots b]

/-- Twice the sum of the Weyl exponents equals the total number of roots `Nat.card ι`. -/
theorem two_mul_sum_sub_one_eq_natCard_of_bijective_aeval_weylGroupRootRep_dual_of_base
    [FiniteDimensional K M] (b : P.Base)
    {κ : Type*} [Fintype κ] {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    2 * ∑ k, (d k - 1) = Nat.card ι := by
  rw [P.sum_sub_one_eq_ncard_posRoots_of_bijective_aeval_weylGroupRootRep_dual b hf hbij,
    two_mul_ncard_posRoots P b]

/-- On a finite reduced crystallographic root system in characteristic zero, twice the sum of the
Weyl exponents equals `Nat.card ι`. -/
theorem two_mul_sum_sub_one_eq_natCard_of_bijective_aeval_weylGroupRootRep_dual
    [P.IsRootSystem]
    {κ : Type*} [Fintype κ] {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    2 * ∑ k, (d k - 1) = Nat.card ι := by
  have : FiniteDimensional K M := P.finite_weight_of_isRootSystem
  obtain ⟨b⟩ := P.nonempty_base
  exact P.two_mul_sum_sub_one_eq_natCard_of_bijective_aeval_weylGroupRootRep_dual_of_base b hf hbij

/-- **Inertia group of a coroot hyperplane ideal.** For a finite reduced crystallographic root
pairing with a base `b` in characteristic zero, the inertia group in `P.weylGroup` of the height-one
prime `Ideal.span {SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' i)}` of `Sym(M*)` consists
strictly of `1` and `weylGroup.ofIdx P i`. -/
theorem mem_dual_inertia_span_singleton_coroot'_iff_of_base (b : P.Base) (i : ι)
    (w : P.weylGroup) :
    letI := P.weylGroupRootRep.dual.symmetricAlgebraMulSemiringAction
    w ∈ (Ideal.span {SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' i)}).inertia P.weylGroup ↔
      w = 1 ∨ w = weylGroup.ofIdx P i := by
  let := P.weylGroupRootRep.dual.symmetricAlgebraMulSemiringAction
  rw [P.weylGroupRootRep.mem_dual_inertia_span_singleton_ι_iff_le_fixedSubmodule]
  exact P.ker_coroot'_le_fixedSubmodule_weylGroupRootRep_iff b i w

/-- On a finite reduced crystallographic root system in characteristic zero, the inertia group in
`P.weylGroup` of `Ideal.span {SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' i)}` is
`{1, weylGroup.ofIdx P i}`. -/
theorem mem_dual_inertia_span_singleton_coroot'_iff [P.IsRootSystem] (i : ι) (w : P.weylGroup) :
    letI := P.weylGroupRootRep.dual.symmetricAlgebraMulSemiringAction
    w ∈ (Ideal.span {SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' i)}).inertia P.weylGroup ↔
      w = 1 ∨ w = weylGroup.ofIdx P i := by
  obtain ⟨b⟩ := P.nonempty_base
  exact P.mem_dual_inertia_span_singleton_coroot'_iff_of_base b i w

/-- Each coroot hyperplane ideal `Ideal.span {SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' i)}`
has inertia group of order `2` in `P.weylGroup`. -/
theorem natCard_dual_inertia_span_singleton_coroot'_of_base (b : P.Base) (i : ι) :
    letI := P.weylGroupRootRep.dual.symmetricAlgebraMulSemiringAction
    Nat.card
      ((Ideal.span {SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' i)}).inertia P.weylGroup) =
      2 := by
  let := P.weylGroupRootRep.dual.symmetricAlgebraMulSemiringAction
  have hne : (1 : P.weylGroup) ≠ weylGroup.ofIdx P i := by
    intro h
    have h1 := P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx i
    rw [← h, map_one] at h1
    have htop : (1 : Module.End K M).fixedSubmodule = ⊤ :=
      eq_top_iff.mpr fun x _ ↦ LinearMap.mem_fixedSubmodule_iff.mpr rfl
    rw [htop] at h1
    have : Subsingleton (M ⧸ (⊤ : Submodule K M)) := Submodule.Quotient.subsingleton_iff.mpr rfl
    exact zero_ne_one ((finrank_zero_of_subsingleton (R := K)).symm.trans h1)
  have hset :
      (((Ideal.span {SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' i)}).inertia P.weylGroup :
        Subgroup P.weylGroup) : Set P.weylGroup) = {1, weylGroup.ofIdx P i} := by
    ext w
    simp [P.mem_dual_inertia_span_singleton_coroot'_iff_of_base b i w]
  change Nat.card
    (((Ideal.span {SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' i)}).inertia P.weylGroup :
      Subgroup P.weylGroup) : Set P.weylGroup) = 2
  rw [Nat.card_coe_set_eq, hset, Set.ncard_pair hne]

/-- On a finite reduced crystallographic root system in characteristic zero, the inertia group of
each coroot hyperplane ideal in `P.weylGroup` has cardinality `2`. -/
theorem natCard_dual_inertia_span_singleton_coroot' [P.IsRootSystem] (i : ι) :
    letI := P.weylGroupRootRep.dual.symmetricAlgebraMulSemiringAction
    Nat.card
      ((Ideal.span {SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' i)}).inertia P.weylGroup) =
      2 := by
  obtain ⟨b⟩ := P.nonempty_base
  exact P.natCard_dual_inertia_span_singleton_coroot'_of_base b i

/-- **Chevalley–Bourbaki Jacobian formula for a Weyl group.** For any homogeneous system of basic
invariants of `P.weylGroupRootRep.dual` on a finite reduced crystallographic root pairing with base
`b` in characteristic zero, the Jacobian is a nonzero scalar multiple of the product of the positive
coroot linear forms
`∏ i ∈ posRootsFinset P b, SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' i)`. -/
theorem exists_jacobian_weylGroupRootRep_eq_algebraMap_mul_prod_posRootsFinset
    [FiniteDimensional K M] (b : P.Base)
    {κ : Type*} [Fintype κ] [DecidableEq κ] (basis : Module.Basis κ K (Module.Dual K M))
    {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    ∃ c : K, c ≠ 0 ∧
      jacobian basis (fun k ↦ (f k : SymmetricAlgebra K (Module.Dual K M))) =
        algebraMap K _ c *
          ∏ i ∈ posRootsFinset P b, SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' i) := by
  classical
  let := P.finite_weylGroup_of_base b
  let := Fintype.ofFinite (posRoots P b)
  let := P.weylGroupRootRep.dual.symmetricAlgebraMulSemiringAction
  let e : posRoots P b ≃ P.weylGroupRootRep.reflectingHyperplanes :=
    P.posRootsEquivReflectingHyperplanes b
  let ℓ : P.weylGroupRootRep.reflectingHyperplanes → Module.Dual K M :=
    fun H ↦ P.coroot' (e.symm H).1
  have hker (H : P.weylGroupRootRep.reflectingHyperplanes) :
      LinearMap.ker (ℓ H) = H.val := by
    have hH := congrArg Subtype.val (e.apply_symm_apply H)
    rwa [P.coe_posRootsEquivReflectingHyperplanes_apply b (e.symm H)] at hH
  obtain ⟨c, hc, hJ⟩ :=
    P.weylGroupRootRep.exists_jacobian_eq_algebraMap_mul_prod_dual_inertia_sub_one
      P.weylGroupRootRep_injective basis ℓ hker hf hbij
  refine ⟨c, hc, hJ.trans (congrArg (algebraMap K _ c * ·) ?_)⟩
  have hpow :
      (∏ H : P.weylGroupRootRep.reflectingHyperplanes,
        SymmetricAlgebra.ι K (Module.Dual K M) (ℓ H) ^
          (Nat.card
            ((Ideal.span {SymmetricAlgebra.ι K (Module.Dual K M) (ℓ H)}).inertia P.weylGroup) -
            1)) =
      ∏ H : P.weylGroupRootRep.reflectingHyperplanes,
        SymmetricAlgebra.ι K (Module.Dual K M) (ℓ H) := by
    refine Finset.prod_congr rfl fun H _ ↦ ?_
    rw [P.natCard_dual_inertia_span_singleton_coroot'_of_base b (e.symm H).1, pow_one]
  rw [hpow,
    ← Equiv.prod_comp e (fun H ↦ SymmetricAlgebra.ι K (Module.Dual K M) (ℓ H))]
  have heval :
      (∏ j : posRoots P b, SymmetricAlgebra.ι K (Module.Dual K M) (ℓ (e j))) =
        ∏ j : posRoots P b, SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' j.1) := by
    refine Finset.prod_congr rfl fun j _ ↦ ?_
    simp only [ℓ, e.symm_apply_apply]
  rw [heval, ← Finset.prod_coe_sort (posRootsFinset P b)]
  let e' : posRootsFinset P b ≃ posRoots P b := Equiv.subtypeEquivRight (mem_posRootsFinset P b)
  exact (Equiv.prod_comp e'
    (fun j : posRoots P b ↦ SymmetricAlgebra.ι K (Module.Dual K M) (P.coroot' j.1))).symm

/-- Relative to a base `b`, the Jacobian of homogeneous basic Weyl invariants vanishes at a weight
`v : M` if and only if `v` is irregular (`¬ P.IsRegularWeight v`). -/
theorem lift_jacobian_weylGroupRootRep_eq_zero_iff_of_base
    [FiniteDimensional K M] (b : P.Base)
    {κ : Type*} [Fintype κ] [DecidableEq κ] (basis : Module.Basis κ K (Module.Dual K M))
    {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) (v : M) :
    lift (Module.Dual.eval K M v)
      (jacobian basis (fun k ↦ (f k : SymmetricAlgebra K (Module.Dual K M)))) = 0 ↔
      ¬ P.IsRegularWeight v := by
  let := P.finite_weylGroup_of_base b
  rw [P.weylGroupRootRep.lift_jacobian_eq_zero_iff_exists_mem_reflectingHyperplanes
    P.weylGroupRootRep_injective basis hf hbij v,
    P.isRegularWeight_iff_forall_notMem_reflectingHyperplanes_of_base b v]
  push Not
  rfl

/-- **Regular weights are exactly where the Weyl Jacobian is nonzero.** Relative to a base `b`, the
Jacobian of homogeneous basic Weyl invariants is nonzero at `v : M` if and only if
`P.IsRegularWeight v`. -/
theorem lift_jacobian_weylGroupRootRep_ne_zero_iff_of_base
    [FiniteDimensional K M] (b : P.Base)
    {κ : Type*} [Fintype κ] [DecidableEq κ] (basis : Module.Basis κ K (Module.Dual K M))
    {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) (v : M) :
    lift (Module.Dual.eval K M v)
      (jacobian basis (fun k ↦ (f k : SymmetricAlgebra K (Module.Dual K M)))) ≠ 0 ↔
      P.IsRegularWeight v :=
  (P.lift_jacobian_weylGroupRootRep_eq_zero_iff_of_base b basis hf hbij v).not_left

/-- On a finite reduced crystallographic root system in characteristic zero, the Jacobian of
homogeneous basic Weyl invariants vanishes at `v : M` if and only if `¬ P.IsRegularWeight v`. -/
theorem lift_jacobian_weylGroupRootRep_eq_zero_iff [P.IsRootSystem]
    {κ : Type*} [Fintype κ] [DecidableEq κ] (basis : Module.Basis κ K (Module.Dual K M))
    {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) (v : M) :
    lift (Module.Dual.eval K M v)
      (jacobian basis (fun k ↦ (f k : SymmetricAlgebra K (Module.Dual K M)))) = 0 ↔
      ¬ P.IsRegularWeight v := by
  have : FiniteDimensional K M := P.finite_weight_of_isRootSystem
  obtain ⟨b⟩ := P.nonempty_base
  exact P.lift_jacobian_weylGroupRootRep_eq_zero_iff_of_base b basis hf hbij v

/-- On a finite reduced crystallographic root system in characteristic zero, the Jacobian of
homogeneous basic Weyl invariants is nonzero at `v : M` if and only if `P.IsRegularWeight v`. -/
theorem lift_jacobian_weylGroupRootRep_ne_zero_iff [P.IsRootSystem]
    {κ : Type*} [Fintype κ] [DecidableEq κ] (basis : Module.Basis κ K (Module.Dual K M))
    {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) (v : M) :
    lift (Module.Dual.eval K M v)
      (jacobian basis (fun k ↦ (f k : SymmetricAlgebra K (Module.Dual K M)))) ≠ 0 ↔
      P.IsRegularWeight v :=
  (P.lift_jacobian_weylGroupRootRep_eq_zero_iff basis hf hbij v).not_left

/-- Construct a basis of `Module.Dual K M` indexed by `κ` on which the Jacobian of a homogeneous
basic Weyl invariant system is nonzero at a given regular weight `v`. -/
private theorem exists_basis_lift_jacobian_ne_zero_of_isRegularWeight
    [FiniteDimensional K M] (b : P.Base)
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants} {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f))
    {v : M} (hv_reg : P.IsRegularWeight v) :
    ∃ basis : Module.Basis κ K (Module.Dual K M),
      lift (Module.Dual.eval K M v)
        (jacobian basis (fun k ↦ (f k : SymmetricAlgebra K (Module.Dual K M)))) ≠ 0 := by
  have := P.finite_weylGroup_of_base b
  have hcard : Fintype.card κ = finrank K (Module.Dual K M) := by
    rw [← Nat.card_eq_fintype_card,
      P.weylGroupRootRep.dual.card_eq_finrank_of_bijective_aeval_symmetricAlgebraInvariants hbij]
  let eκ : κ ≃ Fin (finrank K (Module.Dual K M)) :=
    Fintype.equivOfCardEq (hcard.trans (Fintype.card_fin _).symm)
  refine ⟨(Module.finBasis K (Module.Dual K M)).reindex eκ.symm, ?_⟩
  exact (P.lift_jacobian_weylGroupRootRep_ne_zero_iff_of_base b _ hf hbij v).mpr hv_reg

/-- **Characteristic polynomial at a regular eigenvector (with base).** If `w ∈ P.weylGroup` has a
regular weight `v : M` as an eigenvector with unit eigenvalue `c`, then the characteristic
polynomial of `P.weylGroupRootRep w` is `∏ k, (X - C (c⁻¹ ^ (d k - 1)))` for the degrees `d k` of
any homogeneous basic invariant system. -/
theorem charpoly_weylGroupRootRep_eq_prod_of_isRegularWeight_of_base
    [FiniteDimensional K M] (b : P.Base)
    {κ : Type*} [Fintype κ] {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f))
    (w : P.weylGroup) (v : M) (c : Kˣ)
    (hv_reg : P.IsRegularWeight v) (hv : w • v = (c : K) • v) :
    (P.weylGroupRootRep w).charpoly = ∏ k, (X - C ((↑(c⁻¹) : K) ^ (d k - 1))) := by
  classical
  obtain ⟨basis, hJ⟩ := P.exists_basis_lift_jacobian_ne_zero_of_isRegularWeight b hf hbij hv_reg
  exact P.weylGroupRootRep.charpoly_eq_prod_of_eigenvector_of_jacobian_ne_zero
    basis d hf (fun k ↦ (f k).2) w v c hv hJ

/-- **Characteristic polynomial at a regular eigenvector.** On a finite reduced crystallographic
root system in characteristic zero, if `w ∈ P.weylGroup` has a regular weight `v` as an eigenvector
with unit eigenvalue `c`, then `(P.weylGroupRootRep w).charpoly` factors as
`∏ k, (X - C (c⁻¹ ^ (d k - 1)))`. -/
theorem charpoly_weylGroupRootRep_eq_prod_of_isRegularWeight
    [P.IsRootSystem] [FiniteDimensional K M]
    {κ : Type*} [Fintype κ] {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f))
    (w : P.weylGroup) (v : M) (c : Kˣ)
    (hv_reg : P.IsRegularWeight v) (hv : w • v = (c : K) • v) :
    (P.weylGroupRootRep w).charpoly = ∏ k, (X - C ((↑(c⁻¹) : K) ^ (d k - 1))) := by
  obtain ⟨b⟩ := P.nonempty_base
  exact P.charpoly_weylGroupRootRep_eq_prod_of_isRegularWeight_of_base b hf hbij w v c hv_reg hv

/-- **Crystallographic coprime-exponent theorem.** On a finite reduced crystallographic root system
over a field `K` of characteristic zero, let `f` be a homogeneous basic invariant system of degrees
`d k`. If `w ∈ P.weylGroup` has a nonzero regular weight `v` as an eigenvector (`w • v = c • v`)
whose eigenvalue `c` is a primitive `h`-th root of unity and every exponent `d k - 1` is strictly
less than `h`, then every `a < h` coprime to `h` occurs among the exponents `d k - 1`. -/
theorem exists_degree_sub_one_eq_of_isRegularWeight [P.IsRootSystem]
    {κ : Type*} [Finite κ] {f : κ → P.weylGroupRootRep.dual.symmetricAlgebraInvariants}
    {d : κ → ℕ}
    (hf : ∀ k, (f k : SymmetricAlgebra K (Module.Dual K M)) ∈
      homogeneousSubmodule K (Module.Dual K M) (d k))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f))
    (w : P.weylGroup) (v : M) (c : Kˣ) {h : ℕ}
    (hc : IsPrimitiveRoot (c : K) h)
    (hv_reg : P.IsRegularWeight v) (hv : w • v = (c : K) • v) (hv0 : v ≠ 0)
    (hd : ∀ k, d k - 1 < h)
    {a : ℕ} (ha : a < h) (hcop : a.Coprime h) :
    ∃ k, d k - 1 = a := by
  classical
  let := Fintype.ofFinite κ
  have : FiniteDimensional K M := P.finite_weight_of_isRootSystem
  obtain ⟨b⟩ := P.nonempty_base
  obtain ⟨basis, hJ⟩ := P.exists_basis_lift_jacobian_ne_zero_of_isRegularWeight b hf hbij hv_reg
  obtain ⟨p, hp⟩ := P.exists_map_rat_eq_charpoly_weylGroupRootRep w
  exact P.weylGroupRootRep.exists_degree_sub_one_eq_of_eigenvector_of_jacobian_ne_zero
    basis d hf (fun k ↦ (f k).2) w v c hc hv hv0 hJ hd hp ha hcop

