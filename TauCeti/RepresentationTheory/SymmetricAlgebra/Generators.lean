/-!
# Generators of polynomial invariants from the vertex

Let a group `G` act linearly on a module `M` over a commutative semiring `R`, and so on the
symmetric algebra `S = Sym M`, with invariant subalgebra `A = Sym(M)^G`. Write `A₊` for the ideal
of invariants with zero constant term, the contraction to `A` of the irrelevant ideal `S₊`.

The algebra `A` is graded by the homogeneous components it inherits from `S`
(`Subalgebra.gradedAlgebra`), its irrelevant ideal for this grading is `A₊`, and its degree-zero
part is `R`. So the graded Nakayama lemma `TauCeti.GradedAlgebra.adjoin_eq_top_of_irrelevant_le`
says that homogeneous invariants of positive degree `f₁, f₂, …` whose classes span the cotangent
space `A₊ ⧸ A₊²`, that is, with `A₊ ≤ (f₁, f₂, …) + A₊²`, generate `A` as an `R`-algebra
(`Representation.adjoin_range_eq_top_of_le_span_sup_sq`).

Over a field `k`, for a finite group and finite-dimensional `M`, the invariant algebra has Krull
dimension `dim M` (`Representation.ringKrullDim_symmetricAlgebraInvariants`). A surjection onto it
from a polynomial ring in at most `dim M` variables is then injective, since a nonzero kernel
element would lower the dimension
(`RingHom.injective_of_surjective_of_natCard_le_ringKrullDim_mvPolynomial`). So if at most
`dim M` homogeneous invariants of positive degree span `A₊ ⧸ A₊²`, they are algebraically
independent (`Representation.algebraicIndependent_of_le_span_sup_sq`) and there are exactly
`dim M` of them (`Representation.natCard_eq_finrank_of_le_span_sup_sq`): `A` is a polynomial
algebra on `dim M` homogeneous generators. The case `dim M = 0` is included, with no generators.

This is the last step of the homological proof that, over a field whose characteristic does not
divide the group order (for example `ℂ`), the invariants of a finite group generated by
pseudoreflections form a polynomial algebra (Chevalley, Shephard–Todd); in modular
characteristic this implication can fail. Regularity of `A` at its vertex bounds the dimension of
`A₊ ⧸ A₊²` by `dim M`, and lifting a homogeneous basis gives such a family.

## Main results

* `Representation.adjoin_range_eq_top_of_le_span_sup_sq`: homogeneous invariants of positive
  degree spanning `A₊` modulo `A₊²` generate the invariant algebra.
* `Representation.algebraicIndependent_of_le_span_sup_sq`: over a field, for a finite group, at
  most `dim M` such invariants are algebraically independent.
* `Representation.natCard_eq_finrank_of_le_span_sup_sq`: there are then exactly `dim M` of them.

## References

* R. Kane, *Reflection Groups and Invariant Theory*, CMS Books in Mathematics, Springer (2001),
  §§ 17–18.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), § 7.2.
-/

public section

open TauCeti.SymmetricAlgebra

namespace Representation

variable {R k G M ι : Type*}

section CommSemiring

variable [CommSemiring R] [Monoid G] [AddCommMonoid M] [Module R M]
variable (ρ : Representation R G M)

/-- **Graded Nakayama lemma for polynomial invariants.** Homogeneous invariants of positive degree
whose classes span `A₊ ⧸ A₊²`, where `A₊` is the ideal of invariants with zero constant term,
generate the invariant algebra `Sym(M)^G` as an `R`-algebra. -/
theorem adjoin_range_eq_top_of_le_span_sup_sq (f : ι → ρ.symmetricAlgebraInvariants)
    (d : ι → ℕ) (hd : ∀ i, 0 < d i)
    (hf : ∀ i, (f i : SymmetricAlgebra R M) ∈ homogeneousSubmodule R M (d i))
    (hspan : (HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal.under
        ρ.symmetricAlgebraInvariants ≤
      Ideal.span (Set.range f) ⊔
        ((HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal.under
          ρ.symmetricAlgebraInvariants) ^ 2) :
    Algebra.adjoin R (Set.range f) = ⊤ := by
  let := Subalgebra.gradedAlgebra ρ.isHomogeneous_symmetricAlgebraInvariants
  set 𝒜 := ρ.symmetricAlgebraInvariants.grading (homogeneousSubmodule R M)
  have h := TauCeti.GradedAlgebra.adjoin_eq_top_of_irrelevant_le 𝒜 (s := Set.range f)
    (by
      rintro _ ⟨i, rfl⟩
      exact ⟨d i, hd i, (Subalgebra.mem_grading_iff _ _).2 (hf i)⟩)
    (ρ.symmetricAlgebraInvariants.toIdeal_irrelevant_grading (homogeneousSubmodule R M) ▸ hspan)
  -- An invariant of degree zero is a scalar, so generation over `𝒜 0` is generation over `R`.
  rw [eq_top_iff]
  rintro p -
  have hp : p ∈ Algebra.adjoin (𝒜 0) (Set.range f) := h ▸ Algebra.mem_top
  induction hp using Algebra.adjoin_induction with
  | mem x hx => exact Algebra.subset_adjoin hx
  | algebraMap r =>
    have hr := (Subalgebra.mem_grading_iff _ _).1 r.2
    have : algebraMap (𝒜 0) ρ.symmetricAlgebraInvariants r =
        algebraMap R _ (homogeneousSubmoduleZeroEquiv R M ⟨_, hr⟩) := by
      ext
      exact (algebraMap_homogeneousSubmoduleZeroEquiv_apply R M ⟨_, hr⟩).symm
    rw [this]
    exact Subalgebra.algebraMap_mem _ _
  | add x y _ _ hx hy => exact add_mem hx hy
  | mul x y _ _ hx hy => exact mul_mem hx hy

/-- The polynomial map `R[Xᵢ | i ∈ ι] → Sym(M)^G` sending `Xᵢ` to `fᵢ` is surjective when the `fᵢ`
are homogeneous invariants of positive degree spanning `A₊ ⧸ A₊²`. -/
private theorem surjective_aeval_of_le_span_sup_sq (f : ι → ρ.symmetricAlgebraInvariants)
    (d : ι → ℕ) (hd : ∀ i, 0 < d i)
    (hf : ∀ i, (f i : SymmetricAlgebra R M) ∈ homogeneousSubmodule R M (d i))
    (hspan : (HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal.under
        ρ.symmetricAlgebraInvariants ≤
      Ideal.span (Set.range f) ⊔
        ((HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal.under
          ρ.symmetricAlgebraInvariants) ^ 2) :
    Function.Surjective (MvPolynomial.aeval (R := R) f) := by
  rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval]
  exact ρ.adjoin_range_eq_top_of_le_span_sup_sq f d hd hf hspan

end CommSemiring

section Field

variable [Field k] [Group G] [Finite G] [AddCommGroup M] [Module k M] [FiniteDimensional k M]
variable (ρ : Representation k G M)

/-- **Polynomial invariants from the vertex.** Over a field, for a finite group acting on a
finite-dimensional space `M`, at most `dim M` homogeneous invariants of positive degree whose
classes span `A₊ ⧸ A₊²` are algebraically independent. Since they also generate the invariant
algebra (`Representation.adjoin_range_eq_top_of_le_span_sup_sq`), `Sym(M)^G` is the polynomial
algebra on them. -/
theorem algebraicIndependent_of_le_span_sup_sq [Finite ι] (f : ι → ρ.symmetricAlgebraInvariants)
    (d : ι → ℕ) (hd : ∀ i, 0 < d i)
    (hf : ∀ i, (f i : SymmetricAlgebra k M) ∈ homogeneousSubmodule k M (d i))
    (hspan : (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
        ρ.symmetricAlgebraInvariants ≤
      Ideal.span (Set.range f) ⊔
        ((HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
          ρ.symmetricAlgebraInvariants) ^ 2)
    (hcard : Nat.card ι ≤ Module.finrank k M) :
    AlgebraicIndependent k f :=
  RingHom.injective_of_surjective_of_natCard_le_ringKrullDim_mvPolynomial
    (MvPolynomial.aeval f).toRingHom (ρ.surjective_aeval_of_le_span_sup_sq f d hd hf hspan) <| by
      rw [ringKrullDim_symmetricAlgebraInvariants, ringKrullDim_eq_finrank]
      exact_mod_cast hcard

/-- Over a field, for a finite group acting on a finite-dimensional space `M`, a family of at most
`dim M` homogeneous invariants of positive degree whose classes span `A₊ ⧸ A₊²` has exactly
`dim M` members. So the polynomial presentation of `Sym(M)^G` by such a family, from
`Representation.algebraicIndependent_of_le_span_sup_sq`, has exactly `dim M` variables. -/
theorem natCard_eq_finrank_of_le_span_sup_sq [Finite ι] (f : ι → ρ.symmetricAlgebraInvariants)
    (d : ι → ℕ) (hd : ∀ i, 0 < d i)
    (hf : ∀ i, (f i : SymmetricAlgebra k M) ∈ homogeneousSubmodule k M (d i))
    (hspan : (HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
        ρ.symmetricAlgebraInvariants ≤
      Ideal.span (Set.range f) ⊔
        ((HomogeneousIdeal.irrelevant (homogeneousSubmodule k M)).toIdeal.under
          ρ.symmetricAlgebraInvariants) ^ 2)
    (hcard : Nat.card ι ≤ Module.finrank k M) :
    Nat.card ι = Module.finrank k M := by
  let e := RingEquiv.ofBijective (MvPolynomial.aeval (R := k) f).toRingHom
    ⟨ρ.algebraicIndependent_of_le_span_sup_sq f d hd hf hspan hcard,
      ρ.surjective_aeval_of_le_span_sup_sq f d hd hf hspan⟩
  have h := ringKrullDim_eq_of_ringEquiv e
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field,
    zero_add, ringKrullDim_symmetricAlgebraInvariants, ringKrullDim_eq_finrank] at h
  exact_mod_cast h

end Field

end Representation
