/-!
# Coinvariant Hilbert series from homogeneous basic invariants

A positive-degree homogeneous regular sequence generating the invariant algebra generates the actual
Hilbert ideal of the action. Consequently the Hilbert series of the coinvariant algebra
is the Hilbert series of the symmetric algebra multiplied by `∏ i, (1 - t^(d i))`.

For polynomial functions on a finite-dimensional representation of a finite group
generated by pseudoreflections, regularity of the basic invariants is supplied by the
flatness theorem, under the hypothesis that the group order is invertible in the field.
No characteristic-zero or faithfulness hypothesis is needed for this product formula.
The coefficients may be taken in `ℤ`, retaining the dimensions in positive characteristic.
The empty basic system is included. This formula does not identify the product with a
Coxeter length sum or compute the Hilbert series of the ambient symmetric algebra.

## References

* R. P. Stanley, *Invariants of finite groups and their applications to combinatorics*,
  Bull. Amer. Math. Soc. (N.S.) **1** (1979), §3.
* R. Kane, *Reflection Groups and Invariant Theory*, Springer (2001), §§17–18.
-/

public section

open TauCeti.SymmetricAlgebra TauCeti.GradedAlgebra

namespace Representation

section Field

variable {K G M S : Type*} [Field K] [Monoid G] [AddCommGroup M] [Module K M]
  [Module.Finite K M] [CommRing S]

/-- The coinvariant Hilbert series for a homogeneous weakly regular generating family
of invariants. The left side uses the actual Hilbert ideal of the representation,
not an independently presented quotient. Surjectivity of evaluation suffices to
identify that ideal; algebraic independence is not required here. -/
theorem mk_finrank_quotientPiece_symmetricAlgebraHilbertIdeal
    (ρ : Representation K G M) {n : ℕ} (f : Fin n → ρ.symmetricAlgebraInvariants)
    (d : Fin n → ℕ) (hd : ∀ i, 0 < d i)
    (hf : ∀ i, (f i : SymmetricAlgebra K M) ∈ homogeneousSubmodule K M (d i))
    (hsurj : Function.Surjective (MvPolynomial.aeval (R := K) f))
    (hreg : RingTheory.Sequence.IsWeaklyRegular (SymmetricAlgebra K M)
      (List.ofFn fun i ↦ (f i : SymmetricAlgebra K M))) :
    PowerSeries.mk (fun j ↦ (Module.finrank K
      (quotientPiece (homogeneousSubmodule K M) ρ.symmetricAlgebraHilbertIdeal j) : S)) =
      PowerSeries.mk (fun j ↦ (Module.finrank K (homogeneousSubmodule K M j) : S)) *
        ∏ i, (1 - PowerSeries.X ^ d i) := by
  have hI : Ideal.ofList ((List.ofFn fun i ↦ ((f i : SymmetricAlgebra K M), d i)).map
      Prod.fst) = ρ.symmetricAlgebraHilbertIdeal := by
    rw [List.map_ofFn, Function.comp_def, Ideal.ofList_ofFn,
      ρ.symmetricAlgebraHilbertIdeal_eq_span_of_surjective f
        (fun i ↦ HomogeneousIdeal.mem_irrelevant_of_mem _ (hd i) (hf i)) hsurj]
  have h := mk_finrank_quotientPiece_of_isWeaklyRegular (S := S)
    (homogeneousSubmodule K M) (List.ofFn fun i ↦ ((f i : SymmetricAlgebra K M), d i))
    (by
      intro p hp
      obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hp
      exact hf i)
    (by simpa only [List.map_ofFn, Function.comp_def] using hreg)
  rw [hI] at h
  simpa only [List.map_ofFn, Function.comp_def, List.prod_ofFn] using h

end Field

section Pseudoreflections

variable {K G V S : Type*} [Field K] [Group G] [AddCommGroup V] [Module K V]
  [Module.Finite K V] [Fintype G] [Invertible (Fintype.card G : K)] [CommRing S]

/-- The coinvariant Hilbert-series product formula for a group generated by
pseudoreflections and any chosen homogeneous polynomial basic invariants. Its regular
sequence hypothesis is proved from the finite group's nonmodular flatness theorem.
Integer power-series coefficients retain the unreduced graded dimensions. -/
theorem
    mk_finrank_quotientPiece_symmetricAlgebraHilbertIdeal_dual_of_pseudoreflectionSubgroup_eq_top
    (ρ : Representation K G V) (hG : ρ.pseudoreflectionSubgroup = ⊤)
    {n : ℕ} (f : Fin n → ρ.dual.symmetricAlgebraInvariants)
    (d : Fin n → ℕ) (hd : ∀ i, 0 < d i)
    (hf : ∀ i, (f i : SymmetricAlgebra K (Module.Dual K V)) ∈
      homogeneousSubmodule K (Module.Dual K V) (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) :
    PowerSeries.mk (fun j ↦ (Module.finrank K
      (quotientPiece (homogeneousSubmodule K (Module.Dual K V))
        ρ.dual.symmetricAlgebraHilbertIdeal j) : S)) =
      PowerSeries.mk (fun j ↦
        (Module.finrank K (homogeneousSubmodule K (Module.Dual K V) j) : S)) *
        ∏ i, (1 - PowerSeries.X ^ d i) :=
  ρ.dual.mk_finrank_quotientPiece_symmetricAlgebraHilbertIdeal f d hd hf hbij.2
    (ρ.isRegular_symmetricAlgebraInvariants_dual_of_pseudoreflectionSubgroup_eq_top hG f
      (fun i ↦ ⟨d i, hd i, hf i⟩) hbij).toIsWeaklyRegular

end Pseudoreflections

end Representation
