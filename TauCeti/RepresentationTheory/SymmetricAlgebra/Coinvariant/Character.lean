/-!
# The graded character of the coinvariant algebra

Let a group `G` act linearly on a finite-dimensional vector space `M` over a field `K`, and so on
the symmetric algebra `S = Sym M`, with invariant subalgebra `A = Sym(M)^G` and coinvariant algebra
`C = S ⧸ A₊ · S`. The coinvariant algebra is graded by the images `Cⱼ` of the homogeneous
components `Symʲ M`, and `G` acts on each of them
(`Representation.coinvariantAlgebraHomogeneous`). Its **graded character** is the power series
`∑ⱼ χ_{Cⱼ}(g) tʲ`, recording the action of each element degree by degree.

If `A` is generated by homogeneous invariants `f₁, …, fₙ` of positive degrees `d₁, …, dₙ` which
form a regular sequence in `S`, then for every `g`

`∑ⱼ χ_{Cⱼ}(g) tʲ = (∑ⱼ χ_{Symʲ M}(g) tʲ) * ∏ᵢ (1 - t ^ dᵢ)`.

Each `g` acts on `S` by an algebra automorphism fixing the invariants `fᵢ`, so this is the
equivariant regular-sequence formula
`TauCeti.GradedAlgebra.mk_trace_quotientPiece_of_isWeaklyRegular`.
When `G` is finite of order invertible in `K`, the graded trace formula on the symmetric algebra
identifies `∑ⱼ χ_{Symʲ M}(g) tʲ` with `det(1 - t g | M)⁻¹`, so that

`∑ⱼ χ_{Cⱼ}(g) tʲ = ∏ᵢ (1 - t ^ dᵢ) / det(1 - t g | M)`.

For a finite group generated by pseudoreflections, of order invertible in `K`, acting on a
finite-dimensional space `V`, any homogeneous basic invariants of the polynomial functions
`Sym(V*)` form such a regular sequence, which gives the graded character of the coinvariant
algebra of `Sym(V*)`. At `g = 1` this is the Hilbert series of the coinvariant algebra
(`TauCeti.RepresentationTheory.SymmetricAlgebra.Coinvariant.HilbertSeries`). This graded character
refines the ungraded statement that the coinvariant algebra has the regular character
(`TauCeti.RepresentationTheory.SymmetricAlgebra.RegularRepresentation`); over a splitting field of
characteristic zero, the orthogonality of characters recovers from it the fake-degree polynomials,
the graded multiplicities of the irreducible representations, which are not computed here.

## Main results

* `Representation.coinvariantAlgebraHomogeneous`: the representation on the degree-`j` piece of
  the coinvariant algebra.
* `Representation.mk_character_coinvariantAlgebraHomogeneous`: the graded character of the
  coinvariant algebra is the graded character of `Sym M` times `∏ᵢ (1 - t ^ dᵢ)`.
* `Representation.mk_character_coinvariantAlgebraHomogeneous_mul_reverse_charpoly`: for a finite
  group of invertible order, its product with `det(1 - t g | M)` is `∏ᵢ (1 - t ^ dᵢ)`.
* `mk_character_coinvariantAlgebraHomogeneous_dual_of_pseudoreflectionSubgroup_eq_top`, in the
  namespace `Representation`: the same for the polynomial functions on a representation of
  a finite group generated by pseudoreflections, with any homogeneous basic invariants.

## References

* R. P. Stanley, *Invariants of finite groups and their applications to combinatorics*,
  Bull. Amer. Math. Soc. (N.S.) **1** (1979), 475–511, §§ 3–4.
* R. Kane, *Reflection Groups and Invariant Theory*, CMS Books in Mathematics, Springer (2001).
-/

public section

open TauCeti.SymmetricAlgebra TauCeti.GradedAlgebra

namespace Representation

section CommRing

variable {R G M : Type*} [CommRing R] [Monoid G] [AddCommMonoid M] [Module R M]
  (ρ : Representation R G M)

/-- The action of `G` on the coinvariant algebra preserves the image of each homogeneous
component `Symⁿ M`. -/
theorem coinvariantAlgebra_mem_quotientPiece (g : G) {n : ℕ}
    {x : SymmetricAlgebra R M ⧸ ρ.symmetricAlgebraHilbertIdeal}
    (hx : x ∈ quotientPiece (homogeneousSubmodule R M) ρ.symmetricAlgebraHilbertIdeal n) :
    ρ.coinvariantAlgebra g x ∈
      quotientPiece (homogeneousSubmodule R M) ρ.symmetricAlgebraHilbertIdeal n :=
  apply_mem_quotientPiece _ _ _ _ (fun _ _ ↦ ρ.symmetricAlgebra_mem_homogeneousSubmodule g)
    (ρ.coinvariantAlgebra_mk g) n x hx

/-- The representation of `G` on the degree-`n` piece of the coinvariant algebra
`Sym M ⧸ A₊ · Sym M`, the image of the homogeneous component `Symⁿ M`: the restriction of
`Representation.coinvariantAlgebra` to this subrepresentation. -/
noncomputable def coinvariantAlgebraHomogeneous (n : ℕ) :
    Representation R G
      (quotientPiece (homogeneousSubmodule R M) ρ.symmetricAlgebraHilbertIdeal n) :=
  Subrepresentation.toRepresentation
    ⟨quotientPiece (homogeneousSubmodule R M) ρ.symmetricAlgebraHilbertIdeal n,
      fun g _ ↦ ρ.coinvariantAlgebra_mem_quotientPiece g⟩

/-- The action on the degree-`n` piece of the coinvariant algebra is computed in the coinvariant
algebra. -/
@[simp]
theorem coe_coinvariantAlgebraHomogeneous_apply (n : ℕ) (g : G)
    (x : quotientPiece (homogeneousSubmodule R M) ρ.symmetricAlgebraHilbertIdeal n) :
    (ρ.coinvariantAlgebraHomogeneous n g x : SymmetricAlgebra R M ⧸ _) =
      ρ.coinvariantAlgebra g x :=
  (rfl)

end CommRing

section Field

variable {K G M : Type*} [Field K] [AddCommGroup M] [Module K M] [Module.Finite K M]

/-- **The graded character of the coinvariant algebra.** If the invariants are generated by
homogeneous invariants `f i` of positive degrees `d i` forming a weakly regular sequence in
`Sym M`, then for every `g` the graded character `∑ⱼ χ_{Cⱼ}(g) tʲ` of the coinvariant algebra is
the graded character of `Sym M` multiplied by `∏ᵢ (1 - t ^ d i)`. Surjectivity of evaluation
suffices; algebraic independence is not required, and neither is any finiteness of `G`. -/
theorem mk_character_coinvariantAlgebraHomogeneous [Monoid G]
    (ρ : Representation K G M) {n : ℕ} (f : Fin n → ρ.symmetricAlgebraInvariants)
    (d : Fin n → ℕ) (hd : ∀ i, 0 < d i)
    (hf : ∀ i, (f i : SymmetricAlgebra K M) ∈ homogeneousSubmodule K M (d i))
    (hsurj : Function.Surjective (MvPolynomial.aeval (R := K) f))
    (hreg : RingTheory.Sequence.IsWeaklyRegular (SymmetricAlgebra K M)
      (List.ofFn fun i ↦ (f i : SymmetricAlgebra K M))) (g : G) :
    PowerSeries.mk (fun j ↦ (ρ.coinvariantAlgebraHomogeneous j).character g) =
      PowerSeries.mk (fun j ↦ (ρ.symmetricAlgebraHomogeneous j).character g) *
        ∏ i, (1 - PowerSeries.X ^ d i) := by
  let fs := List.ofFn fun i ↦ ((f i : SymmetricAlgebra K M), d i)
  have hfs : fs.map Prod.fst = List.ofFn fun i ↦ (f i : SymmetricAlgebra K M) := by
    rw [List.map_ofFn]
    rfl
  have hI : Ideal.ofList (fs.map Prod.fst) = ρ.symmetricAlgebraHilbertIdeal := by
    rw [hfs, Ideal.ofList_ofFn, ρ.symmetricAlgebraHilbertIdeal_eq_span_of_surjective f
      (fun i ↦ HomogeneousIdeal.mem_irrelevant_of_mem _ (hd i) (hf i)) hsurj]
  have h := mk_trace_quotientPiece_of_isWeaklyRegular (homogeneousSubmodule K M)
    (ρ.symmetricAlgebra g) (fun _ _ ↦ ρ.symmetricAlgebra_mem_homogeneousSubmodule g) fs
    (fun p hp ↦ by obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hp; exact hf i) (hfs ▸ hreg)
    (fun p hp x ↦ by
      obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hp
      rw [symmetricAlgebra_apply, map_mul, ← symmetricAlgebra_apply,
        (ρ.mem_symmetricAlgebraInvariants _).1 (f i).2 g, symmetricAlgebra_apply])
    _ hI (ρ.coinvariantAlgebra g) (ρ.coinvariantAlgebra_mk g)
  -- The characters are the traces of the restrictions of the actions on `Sym M` and on the
  -- coinvariant algebra.
  have hS (j : ℕ) : (ρ.symmetricAlgebraHomogeneous j).character g =
      LinearMap.trace K _ ((ρ.symmetricAlgebra g).restrict
        fun _ ↦ ρ.symmetricAlgebra_mem_homogeneousSubmodule g (n := j)) := by
    rw [character]
    congr 1
    ext x
    simp
  have hC (j : ℕ) : (ρ.coinvariantAlgebraHomogeneous j).character g =
      LinearMap.trace K _ ((ρ.coinvariantAlgebra g).restrict
        fun _ ↦ ρ.coinvariantAlgebra_mem_quotientPiece g (n := j)) := by
    rw [character]
    -- `coinvariantAlgebraHomogeneous` is defined in this file as this restriction.
    rfl
  simp only [hS, hC]
  simpa only [fs, List.map_ofFn, Function.comp_def, List.prod_ofFn] using h

/-- **The graded character of the coinvariant algebra, determinant form.** For a finite group
whose order is invertible in `K`, if the invariants are generated by homogeneous invariants `f i`
of positive degrees `d i` forming a weakly regular sequence in `Sym M`, then for every `g`
`(∑ⱼ χ_{Cⱼ}(g) tʲ) * det(1 - t g | M) = ∏ᵢ (1 - t ^ d i)`, where `det(1 - t g | M)` is the
reverse of the characteristic polynomial of `ρ g`. No eigenvalue of `ρ g` need lie in `K`. -/
theorem mk_character_coinvariantAlgebraHomogeneous_mul_reverse_charpoly [Group G] [Fintype G]
    [Invertible (Fintype.card G : K)] (ρ : Representation K G M) {n : ℕ}
    (f : Fin n → ρ.symmetricAlgebraInvariants) (d : Fin n → ℕ) (hd : ∀ i, 0 < d i)
    (hf : ∀ i, (f i : SymmetricAlgebra K M) ∈ homogeneousSubmodule K M (d i))
    (hsurj : Function.Surjective (MvPolynomial.aeval (R := K) f))
    (hreg : RingTheory.Sequence.IsWeaklyRegular (SymmetricAlgebra K M)
      (List.ofFn fun i ↦ (f i : SymmetricAlgebra K M))) (g : G) :
    PowerSeries.mk (fun j ↦ (ρ.coinvariantAlgebraHomogeneous j).character g) *
      ((ρ g).charpoly.reverse : PowerSeries K) = ∏ i, (1 - PowerSeries.X ^ d i) := by
  have htrace := Module.End.mk_trace_homogeneousSubmoduleMapₛₗ_mul_reverse_charpoly_of_pow_eq_one
    (Invertible.ne_zero (Fintype.card G : K)) (f := ρ g) (by rw [← map_pow, pow_card_eq_one,
      map_one])
  simp only [← symmetricAlgebraHomogeneous_apply] at htrace
  rw [ρ.mk_character_coinvariantAlgebraHomogeneous f d hd hf hsurj hreg g, mul_right_comm]
  exact (congrArg (· * _) htrace).trans (one_mul _)

/-- **The graded character of the coinvariant algebra of a pseudoreflection group.** Let a finite
group `G`, whose order is invertible in `K`, act on a finite-dimensional vector space `V` and be
generated by pseudoreflections. For any homogeneous basic invariants `f i` of the polynomial
functions `Sym(V*)`, of degrees `d i`, and every `g`, the graded character of the coinvariant
algebra of `Sym(V*)` satisfies `(∑ⱼ χ_{Cⱼ}(g) tʲ) * det(1 - t g | V*) = ∏ᵢ (1 - t ^ d i)`,
where `det(1 - t g | V*)` is the reverse of the characteristic polynomial of `ρ.dual g`.
No faithfulness assumption is needed. -/
theorem mk_character_coinvariantAlgebraHomogeneous_dual_of_pseudoreflectionSubgroup_eq_top
    {V : Type*} [AddCommGroup V] [Module K V] [FiniteDimensional K V] [Group G] [Fintype G]
    [Invertible (Fintype.card G : K)] (ρ : Representation K G V)
    (hG : ρ.pseudoreflectionSubgroup = ⊤) {n : ℕ} (f : Fin n → ρ.dual.symmetricAlgebraInvariants)
    (d : Fin n → ℕ) (hf : ∀ i, (f i : SymmetricAlgebra K (Module.Dual K V)) ∈
      homogeneousSubmodule K (Module.Dual K V) (d i))
    (hbij : Function.Bijective (MvPolynomial.aeval (R := K) f)) (g : G) :
    PowerSeries.mk (fun j ↦ (ρ.dual.coinvariantAlgebraHomogeneous j).character g) *
      ((ρ.dual g).charpoly.reverse : PowerSeries K) = ∏ i, (1 - PowerSeries.X ^ d i) := by
  have hd (i : Fin n) : 0 < d i :=
    Nat.pos_of_ne_zero (ne_zero_of_injective_aeval_symmetricAlgebraInvariants ρ.dual hf hbij.1 i)
  exact ρ.dual.mk_character_coinvariantAlgebraHomogeneous_mul_reverse_charpoly f d hd hf hbij.2
    (ρ.isRegular_symmetricAlgebraInvariants_dual_of_pseudoreflectionSubgroup_eq_top hG f
      (fun i ↦ ⟨d i, hd i, hf i⟩) hbij).toIsWeaklyRegular g

end Field

end Representation
