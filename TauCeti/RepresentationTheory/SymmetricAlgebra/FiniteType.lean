module

public import Mathlib.RingTheory.FiniteType
public import TauCeti.RepresentationTheory.SymmetricAlgebra.Basic
import TauCeti.LinearAlgebra.SymmetricAlgebra.FiniteType
import TauCeti.RingTheory.Invariant.FiniteType

/-!
# Noether finiteness for the invariants of a finite linear group

Let a finite group `G` act linearly on a finitely generated module `M` over a commutative ring `R`,
and so on the symmetric algebra `S = Sym M`, with invariant subalgebra `A = Sym(M)^G`. Then `S` is
a finite `A`-module, and over a Noetherian base `A` is a finitely generated `R`-algebra (Noether's
finiteness theorem). Both facts are the general results for fixed subalgebras of finite groups,
transported along `Representation.symmetricAlgebraInvariants_eq_fixedPoints`.

Over a commutative rational algebra, the invariants are generated by homogeneous elements of
positive degree at most the group order. The action need not be faithful and the module need not
be free or finite. For a finite module, a finite set of such generators exists even if the
coefficient algebra is not Noetherian. For polynomial functions apply this to the contragredient
representation on the dual space.

The degree bound concerns algebra generators, not a basic-invariant degree list or polynomiality.
The proof specializes `TauCeti.FixedPoints.subalgebra_eq_adjoin_sum_smul_prod_pow`: linearity
makes the orbit sums homogeneous, and degree-zero orbit sums are scalars that can be omitted.

## Main results

* `Representation.moduleFinite_symmetricAlgebraInvariants`: `Sym M` is a finite module over the
  invariant subalgebra.
* `Representation.finiteType_symmetricAlgebraInvariants`: over a Noetherian base, the invariant
  subalgebra is of finite type.
* `Representation.symmetricAlgebraInvariants_eq_adjoin_homogeneous`: over a rational algebra,
  homogeneous invariants of degrees between one and the group order generate the invariants.
* `Representation.exists_finset_adjoin_eq_symmetricAlgebraInvariants`: for a finite module over
  a rational algebra, there is a finite set of such homogeneous generators.

## References

* E. Noether, *Der Endlichkeitssatz der Invarianten endlicher Gruppen*, Math. Ann. **77**
  (1916), 89–92.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), Chapter 2.
* H. Derksen, G. Kemper, *Computational Invariant Theory*, Springer (2002), Chapter 2.
-/

public section

open TauCeti.SymmetricAlgebra

namespace Representation

variable {R G M : Type*} [CommRing R] [Group G] [AddCommMonoid M] [Module R M]
variable (ρ : Representation R G M)

section Finite

variable [Finite G]

/-- For a finite group acting on a finitely generated module `M`, the symmetric algebra `Sym M` is
a finite module over the invariant subalgebra. -/
instance moduleFinite_symmetricAlgebraInvariants [Module.Finite R M] :
    Module.Finite ρ.symmetricAlgebraInvariants (SymmetricAlgebra R M) :=
  letI := ρ.symmetricAlgebraMulSemiringAction
  haveI := ρ.smulCommClass_symmetricAlgebraMulSemiringAction
  ρ.symmetricAlgebraInvariants_eq_fixedPoints ▸
    TauCeti.FixedPoints.moduleFinite_subalgebra R (SymmetricAlgebra R M) G

/-- **Noether's finiteness theorem** for the invariants of a finite group acting on a finitely
generated module over a Noetherian ring: the invariant subalgebra is of finite type. -/
instance finiteType_symmetricAlgebraInvariants [IsNoetherianRing R] [Module.Finite R M] :
    Algebra.FiniteType R ρ.symmetricAlgebraInvariants :=
  letI := ρ.symmetricAlgebraMulSemiringAction
  haveI := ρ.smulCommClass_symmetricAlgebraMulSemiringAction
  ρ.symmetricAlgebraInvariants_eq_fixedPoints ▸
    TauCeti.FixedPoints.finiteType_subalgebra R (SymmetricAlgebra R M) G

end Finite

section Homogeneous

variable [Fintype G]

private theorem orbitSum_mem_invariants_and_homogeneousSubmodule {ι : Type*}
    (x : ι → M) (d : ι →₀ ℕ) :
    letI := ρ.symmetricAlgebraMulSemiringAction
    let p := ∑ g : G, g • d.prod fun i n ↦ SymmetricAlgebra.ι R M (x i) ^ n
    p ∈ ρ.symmetricAlgebraInvariants ∧ p ∈ homogeneousSubmodule R M d.degree := by
  let := ρ.symmetricAlgebraMulSemiringAction
  have := ρ.smulCommClass_symmetricAlgebraMulSemiringAction
  constructor
  · rw [ρ.symmetricAlgebraInvariants_eq_fixedPoints]
    exact FixedPoints.mem_subalgebra.mpr fun g ↦ TauCeti.smul_sum_smul g _
  apply Submodule.sum_mem
  intro g _
  rw [symmetricAlgebraMulSemiringAction_smul]
  apply ρ.symmetricAlgebra_mem_homogeneousSubmodule
  simpa only [Finsupp.prod, Finsupp.degree_apply, nsmul_eq_mul, Nat.cast_id, mul_one] using
    SetLike.prod_pow_mem_graded (homogeneousSubmodule R M) (fun _ : ι ↦ 1)
      (fun i ↦ SymmetricAlgebra.ι R M (x i)) d
      (fun i _ ↦ ι_mem_homogeneousSubmodule R M (x i))

variable [Algebra ℚ R]

private theorem symmetricAlgebraInvariants_eq_adjoin_orbitSums {ι : Type*} (x : ι → M)
    (hx : Submodule.span R (Set.range x) = ⊤) :
    letI := ρ.symmetricAlgebraMulSemiringAction
    ρ.symmetricAlgebraInvariants = Algebra.adjoin R
      ((fun d : ι →₀ ℕ ↦ ∑ g : G, g • d.prod fun i n ↦ SymmetricAlgebra.ι R M (x i) ^ n) ''
        {d | 0 < d.degree ∧ d.degree ≤ Fintype.card G}) := by
  classical
  let := ρ.symmetricAlgebraMulSemiringAction
  have := ρ.smulCommClass_symmetricAlgebraMulSemiringAction
  have hN := TauCeti.FixedPoints.subalgebra_eq_adjoin_sum_smul_prod_pow
    (R := R) (G := G) (SymmetricAlgebra.ι R M ∘ x)
    (adjoin_range_ι_comp_eq_top_of_span_eq_top x hx)
  rw [← ρ.symmetricAlgebraInvariants_eq_fixedPoints] at hN
  refine le_antisymm (hN.le.trans (Algebra.adjoin_le ?_)) (Algebra.adjoin_le ?_)
  · rintro _ ⟨d, hd, rfl⟩
    by_cases hzero : d.degree = 0
    · have : d = 0 := (Finsupp.degree_eq_zero_iff d).mp hzero
      subst d
      simp
    · exact Algebra.subset_adjoin ⟨d, ⟨Nat.pos_of_ne_zero hzero, hd⟩, rfl⟩
  · rintro _ ⟨d, _, rfl⟩
    exact (ρ.orbitSum_mem_invariants_and_homogeneousSubmodule x d).1

/-- **The homogeneous Noether bound.** The invariants of a finite linear group over a rational
algebra are generated by homogeneous invariants of positive degree at most the group order.
This holds without finite generation or freeness of the underlying module. -/
theorem symmetricAlgebraInvariants_eq_adjoin_homogeneous :
    ρ.symmetricAlgebraInvariants = Algebra.adjoin R
      {p | p ∈ ρ.symmetricAlgebraInvariants ∧
        ∃ n, 0 < n ∧ n ≤ Fintype.card G ∧ p ∈ homogeneousSubmodule R M n} := by
  classical
  let := ρ.symmetricAlgebraMulSemiringAction
  refine le_antisymm ?_ (Algebra.adjoin_le fun p hp ↦ hp.1)
  refine (ρ.symmetricAlgebraInvariants_eq_adjoin_orbitSums id (by
    rw [Set.range_id, Submodule.span_univ])).le.trans (Algebra.adjoin_mono ?_)
  rintro _ ⟨d, hd, rfl⟩
  exact ⟨(ρ.orbitSum_mem_invariants_and_homogeneousSubmodule id d).1,
    d.degree, hd.1, hd.2,
    (ρ.orbitSum_mem_invariants_and_homogeneousSubmodule id d).2⟩

/-- **Finite homogeneous Noether generators.** If the module is finite, its polynomial
invariants admit a finite generating set of homogeneous elements with degrees between one
and the group order. No Noetherian hypothesis on the rational coefficient algebra is needed. -/
theorem exists_finset_adjoin_eq_symmetricAlgebraInvariants [Module.Finite R M] :
    ∃ s : Finset (SymmetricAlgebra R M),
      (∀ p ∈ s, p ∈ ρ.symmetricAlgebraInvariants ∧
        ∃ n, 0 < n ∧ n ≤ Fintype.card G ∧ p ∈ homogeneousSubmodule R M n) ∧
      Algebra.adjoin R (s : Set (SymmetricAlgebra R M)) = ρ.symmetricAlgebraInvariants := by
  classical
  obtain ⟨k, x, hx⟩ := Module.Finite.exists_fin (R := R) (M := M)
  let := ρ.symmetricAlgebraMulSemiringAction
  let q (d : Fin k →₀ ℕ) : SymmetricAlgebra R M :=
    ∑ g : G, g • d.prod fun i n ↦ SymmetricAlgebra.ι R M (x i) ^ n
  let D : Set (Fin k →₀ ℕ) := {d | 0 < d.degree ∧ d.degree ≤ Fintype.card G}
  have hD : D.Finite := (Finsupp.finite_of_degree_le (Fintype.card G)).subset fun _ hd ↦ hd.2
  have hq (d : Fin k →₀ ℕ) :
      q d ∈ ρ.symmetricAlgebraInvariants ∧ q d ∈ homogeneousSubmodule R M d.degree :=
    ρ.orbitSum_mem_invariants_and_homogeneousSubmodule x d
  refine ⟨(hD.image q).toFinset, ?_, ?_⟩
  · intro p hp
    obtain ⟨d, hd, rfl⟩ := (hD.image q).mem_toFinset.mp hp
    exact ⟨(hq d).1, d.degree, hd.1, hd.2, (hq d).2⟩
  · simpa only [Set.Finite.coe_toFinset] using
      (ρ.symmetricAlgebraInvariants_eq_adjoin_orbitSums x hx).symm

end Homogeneous

end Representation
