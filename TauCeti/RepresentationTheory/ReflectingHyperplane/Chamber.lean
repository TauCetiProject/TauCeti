/-!
# Chambers of a finite orthogonal group

Let `ρ` be a representation of a finite group `G` on a finite-dimensional real inner product
space `V` by linear maps preserving the inner product. Its reflecting hyperplanes
(`Representation.reflectingHyperplanes`) cut `V` into open chambers. The chamber of a point `x`
(`Representation.chamber`) is the set of points `y` lying strictly on the same side as `x` of every
reflecting hyperplane `H`. Writing `P` for the orthogonal projection onto the normal line `Hᗮ`,
this is the condition `0 < ⟪P x, y⟫`, which needs no choice of a normal vector. The chamber of `x`
is empty exactly when `x` lies on a reflecting hyperplane, and otherwise it is an open convex cone
containing `x`. Two chambers are equal or disjoint.

Every pseudoreflection preserving the inner product is the orthogonal reflection in its fixed
hyperplane (`LinearMap.reflection_fixedSubmodule_apply`), so the reflection in each reflecting
hyperplane belongs to the group. The group permutes the reflecting hyperplanes and hence the
chambers (`Representation.image_chamber`). The main results are that the closure of a chamber
meets every orbit of the subgroup generated by the pseudoreflections, and that this subgroup acts
transitively on the chambers. No hypothesis that `G` is generated by reflections is needed: the
proof only uses the reflections in the reflecting hyperplanes. Choose `g` in that subgroup with
`ρ g x` nearest to `y`. If a reflecting hyperplane `H` separated `ρ g x` from `y`, then reflecting
`ρ g x` across `H` would bring it nearer to `y`, since the squared distance changes by
`4 ⟪P (ρ g x), y⟫` (`Submodule.norm_reflection_sub_sq`).

## Main definitions

* `Representation.chamber`: the open chamber of a point.

## Main results

* `Representation.mem_chamber_self`: a point lies in its own chamber exactly when it lies on no
  reflecting hyperplane.
* `Representation.chamber_eq_of_mem`: the chambers partition the complement of the reflecting
  hyperplanes.
* `Representation.isOpen_chamber`, `Representation.convex_chamber`,
  `Representation.smul_mem_chamber` and `Representation.closure_chamber`: chambers are open convex
  cones, and the closure of a nonempty chamber is cut out by the corresponding weak inequalities.
* `Representation.exists_reflection_eq_of_mem_reflectingHyperplanes`: the reflection in each
  reflecting hyperplane is realised by a pseudoreflection.
* `Representation.image_chamber`: the group permutes the chambers.
* `Representation.exists_mem_pseudoreflectionSubgroup_apply_mem_closure_chamber`: the closure of a
  chamber meets every orbit of the pseudoreflection subgroup.
* `Representation.exists_mem_pseudoreflectionSubgroup_image_chamber_eq`: the pseudoreflection
  subgroup acts transitively on the chambers.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Springer (2002), Ch. V, § 3.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press (1990),
  § 1.12.
-/

public section

open scoped InnerProductSpace

namespace Representation

variable {G V : Type*} [Group G] [Finite G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [FiniteDimensional ℝ V] (ρ : Representation ℝ G V)

/-- The normal line of a reflecting hyperplane is one-dimensional. -/
theorem finrank_orthogonal_of_mem_reflectingHyperplanes {H : Submodule ℝ V}
    (hH : H ∈ ρ.reflectingHyperplanes) : Module.finrank ℝ Hᗮ = 1 :=
  H.finrank_orthogonal_eq_finrank_quotient.trans
    (ρ.finrank_quotient_of_mem_reflectingHyperplanes hH)

/-- The open chamber of `x`: the points `y` lying strictly on the same side as `x` of every
reflecting hyperplane `H`, that is, with `0 < ⟪P x, y⟫` for the orthogonal projection `P` onto the
normal line `Hᗮ`. It is empty when `x` lies on a reflecting hyperplane. -/
def chamber (x : V) : Set V :=
  {y | ∀ H ∈ ρ.reflectingHyperplanes, 0 < ⟪Hᗮ.starProjection x, y⟫_ℝ}

/-- Membership in a chamber, unfolded. -/
@[simp]
theorem mem_chamber {x y : V} :
    y ∈ ρ.chamber x ↔ ∀ H ∈ ρ.reflectingHyperplanes, 0 < ⟪Hᗮ.starProjection x, y⟫_ℝ :=
  Iff.rfl

/-- `y` lies in the chamber of `x` exactly when `x` lies in the chamber of `y`. -/
theorem mem_chamber_comm {x y : V} : y ∈ ρ.chamber x ↔ x ∈ ρ.chamber y := by
  simp only [mem_chamber, Submodule.inner_starProjection_left_eq_right, real_inner_comm x]

/-- A point lies in its own chamber exactly when it lies on no reflecting hyperplane. -/
theorem mem_chamber_self {x : V} :
    x ∈ ρ.chamber x ↔ ∀ H ∈ ρ.reflectingHyperplanes, x ∉ H := by
  refine forall₂_congr fun H _ ↦ ?_
  have h := Hᗮ.re_inner_starProjection_eq_normSq x
  rw [RCLike.re_to_real] at h
  rw [h, sq_pos_iff, norm_ne_zero_iff, ne_eq, Submodule.orthogonalProjectionOnto_eq_zero_iff,
    Submodule.orthogonal_orthogonal]

/-- Chambers of points of a chamber are that chamber: the chambers partition the points lying on
no reflecting hyperplane. -/
theorem chamber_eq_of_mem {x y : V} (hy : y ∈ ρ.chamber x) : ρ.chamber y = ρ.chamber x := by
  ext z
  refine forall₂_congr fun H hH ↦ ?_
  have hxy := hy H hH
  have hL := ρ.finrank_orthogonal_of_mem_reflectingHyperplanes hH
  have hyy : 0 < ⟪Hᗮ.starProjection y, y⟫_ℝ := by
    have h₀ : 0 ≤ ⟪Hᗮ.starProjection y, y⟫_ℝ := by
      simpa using Hᗮ.re_inner_starProjection_nonneg y
    refine h₀.lt_of_ne fun h ↦ ?_
    have := Hᗮ.inner_starProjection_sq_of_finrank_eq_one hL x y
    rw [← h, mul_zero] at this
    exact (pow_pos hxy 2).ne' this
  have := Hᗮ.inner_starProjection_mul_inner_starProjection_of_finrank_eq_one hL x y z
  constructor <;> intro h <;> nlinarith

/-- A chamber is nonempty exactly when it contains the point defining it. -/
theorem nonempty_chamber_iff {x : V} : (ρ.chamber x).Nonempty ↔ x ∈ ρ.chamber x := by
  refine ⟨fun ⟨y, hy⟩ ↦ ?_, fun hx ↦ ⟨x, hx⟩⟩
  rw [← ρ.chamber_eq_of_mem hy]
  exact ρ.mem_chamber_comm.1 hy

/-- A chamber is a cone. -/
theorem smul_mem_chamber {x y : V} (hy : y ∈ ρ.chamber x) {t : ℝ} (ht : 0 < t) :
    t • y ∈ ρ.chamber x := fun H hH ↦ by
  rw [real_inner_smul_right]
  exact mul_pos ht (hy H hH)

private theorem chamber_eq_biInter (x : V) : ρ.chamber x =
    ⋂ H ∈ ρ.reflectingHyperplanes, {y | 0 < ⟪Hᗮ.starProjection x, y⟫_ℝ} := by
  ext
  simp [mem_chamber]

/-- A chamber is open. -/
theorem isOpen_chamber (x : V) : IsOpen (ρ.chamber x) := by
  rw [chamber_eq_biInter]
  exact ρ.reflectingHyperplanes.finite_toSet.isOpen_biInter fun H _ ↦
    isOpen_lt continuous_const (by fun_prop)

/-- A chamber is convex. -/
theorem convex_chamber (x : V) : Convex ℝ (ρ.chamber x) :=
  ρ.chamber_eq_biInter x ▸ convex_iInter₂ fun (H : Submodule ℝ V) _ ↦
    convex_halfSpace_gt (innerₗ V (Hᗮ.starProjection x)).isLinear 0

/-- The closure of a nonempty chamber is cut out by the weak inequalities defining it. -/
theorem closure_chamber {y : V} (hy : y ∈ ρ.chamber y) :
    closure (ρ.chamber y) =
      {z | ∀ H ∈ ρ.reflectingHyperplanes, 0 ≤ ⟪Hᗮ.starProjection y, z⟫_ℝ} := by
  refine (closure_minimal ?_ ?_).antisymm fun z hz ↦ ?_
  · exact fun z hz H hH ↦ (hz H hH).le
  · have : {z | ∀ H ∈ ρ.reflectingHyperplanes, 0 ≤ ⟪Hᗮ.starProjection y, z⟫_ℝ} =
        ⋂ H ∈ ρ.reflectingHyperplanes, {z | 0 ≤ ⟪Hᗮ.starProjection y, z⟫_ℝ} := by
      ext
      simp
    rw [this]
    exact isClosed_biInter fun H _ ↦ isClosed_le continuous_const (by fun_prop)
  · -- The open segment from `z` to `y` lies in the chamber, and `z` is in its closure.
    refine closure_mono ?_ (segment_subset_closure_openSegment (left_mem_segment ℝ z y))
    rintro _ ⟨a, b, ha, hb, -, rfl⟩ H hH
    rw [inner_add_right, real_inner_smul_right, real_inner_smul_right]
    have := hy H hH
    have := hz H hH
    positivity

variable {ρ}

/-- The orthogonal reflection in a reflecting hyperplane of a representation preserving the inner
product is realised by a pseudoreflection. -/
theorem exists_reflection_eq_of_mem_reflectingHyperplanes
    (hρ : ∀ g v w, ⟪ρ g v, ρ g w⟫_ℝ = ⟪v, w⟫_ℝ) {H : Submodule ℝ V}
    (hH : H ∈ ρ.reflectingHyperplanes) :
    ∃ g, Module.finrank ℝ (V ⧸ (ρ g).fixedSubmodule) = 1 ∧ ∀ v, H.reflection v = ρ g v := by
  obtain ⟨g, hg, rfl⟩ := ρ.mem_reflectingHyperplanes.1 hH
  exact ⟨g, hg, LinearMap.reflection_fixedSubmodule_apply (hρ g) hg⟩

omit [Finite G] in
/-- An inner-product-preserving `ρ g` transports orthogonal projections onto normal spaces:
projecting `ρ g x` onto the orthogonal complement of the image of `H` and pairing with `ρ g y`
gives the inner product of the projection of `x` onto `Hᗮ` with `y`. -/
theorem inner_starProjection_orthogonal_map_apply (hρ : ∀ g v w, ⟪ρ g v, ρ g w⟫_ℝ = ⟪v, w⟫_ℝ)
    (H : Submodule ℝ V) (g : G) (x y : V) :
    ⟪(H.map (ρ g))ᗮ.starProjection (ρ g x), ρ g y⟫_ℝ = ⟪Hᗮ.starProjection x, y⟫_ℝ := by
  let e : V ≃ₗᵢ[ℝ] V := ((ρ g).isometryOfInner (hρ g)).toLinearIsometryEquiv rfl
  have he' (v : V) : e v = ρ g v := by
    rw [LinearIsometry.coe_toLinearIsometryEquiv, LinearMap.coe_isometryOfInner]
  have he : (e.toLinearEquiv : V →ₗ[ℝ] V) = ρ g := LinearMap.ext he'
  have h := Hᗮ.inner_starProjection_map_apply e x y
  -- The rewrites are separate: `he` would destroy the pattern of `map_orthogonal_equiv`.
  simp only [Submodule.map_orthogonal_equiv] at h
  simp only [he, he'] at h
  exact h

private theorem mem_chamber_of_apply_mem_chamber_apply
    (hρ : ∀ g v w, ⟪ρ g v, ρ g w⟫_ℝ = ⟪v, w⟫_ℝ) (g : G) {x y : V}
    (h : ρ g y ∈ ρ.chamber (ρ g x)) : y ∈ ρ.chamber x := fun H hH ↦ by
  rw [← inner_starProjection_orthogonal_map_apply hρ H g]
  exact h _ (ρ.map_mem_reflectingHyperplanes hH g)

/-- `ρ g` maps the chamber of `x` into the chamber of `ρ g x`, and only points of the chamber of
`x` land there. -/
theorem apply_mem_chamber_apply_iff (hρ : ∀ g v w, ⟪ρ g v, ρ g w⟫_ℝ = ⟪v, w⟫_ℝ) (g : G)
    {x y : V} : ρ g y ∈ ρ.chamber (ρ g x) ↔ y ∈ ρ.chamber x := by
  refine ⟨mem_chamber_of_apply_mem_chamber_apply hρ g, fun h ↦ ?_⟩
  refine mem_chamber_of_apply_mem_chamber_apply hρ g⁻¹ ?_
  simpa using h

/-- The group permutes the chambers: `ρ g` maps the chamber of `x` onto the chamber of `ρ g x`. -/
theorem image_chamber (hρ : ∀ g v w, ⟪ρ g v, ρ g w⟫_ℝ = ⟪v, w⟫_ℝ) (g : G) (x : V) :
    ρ g '' ρ.chamber x = ρ.chamber (ρ g x) := by
  ext z
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact (apply_mem_chamber_apply_iff hρ g).2 hy
  · intro hz
    exact ⟨ρ g⁻¹ z, (apply_mem_chamber_apply_iff hρ g).1 (by simpa using hz), by simp⟩

/-- The closure of a nonempty chamber meets the orbit of every point under the subgroup generated
by the pseudoreflections. -/
theorem exists_mem_pseudoreflectionSubgroup_apply_mem_closure_chamber
    (hρ : ∀ g v w, ⟪ρ g v, ρ g w⟫_ℝ = ⟪v, w⟫_ℝ) (x : V) {y : V} (hy : y ∈ ρ.chamber y) :
    ∃ g ∈ ρ.pseudoreflectionSubgroup, ρ g x ∈ closure (ρ.chamber y) := by
  obtain ⟨g, hg, hmin⟩ := Set.exists_min_image (ρ.pseudoreflectionSubgroup : Set G)
    (fun g ↦ ‖ρ g x - y‖) (Set.toFinite _) ⟨1, one_mem _⟩
  refine ⟨g, hg, (closure_chamber ρ hy).symm ▸ fun H hH ↦ ?_⟩
  -- Reflecting `ρ g x` across `H` does not bring it nearer to `y`.
  obtain ⟨k, hk, hkH⟩ := exists_reflection_eq_of_mem_reflectingHyperplanes hρ hH
  have hle := hmin (k * g)
    (mul_mem (ρ.mem_pseudoreflectionSubgroup_of_finrank_quotient_eq_one hk) hg)
  simp only [map_mul, mul_apply_eq_comp, ← hkH] at hle
  have hsq := pow_le_pow_left₀ (norm_nonneg _) hle 2
  rw [H.norm_reflection_sub_sq, Submodule.inner_starProjection_left_eq_right,
    real_inner_comm] at hsq
  linarith

/-- **The pseudoreflection subgroup acts transitively on the chambers.** -/
theorem exists_mem_pseudoreflectionSubgroup_image_chamber_eq
    (hρ : ∀ g v w, ⟪ρ g v, ρ g w⟫_ℝ = ⟪v, w⟫_ℝ) {x y : V} (hx : x ∈ ρ.chamber x)
    (hy : y ∈ ρ.chamber y) :
    ∃ g ∈ ρ.pseudoreflectionSubgroup, ρ g '' ρ.chamber x = ρ.chamber y := by
  obtain ⟨g, hg, hgx⟩ := exists_mem_pseudoreflectionSubgroup_apply_mem_closure_chamber hρ x hy
  refine ⟨g, hg, ?_⟩
  rw [image_chamber hρ, ρ.chamber_eq_of_mem]
  -- `ρ g x` lies in the closure of the chamber of `y` and on no reflecting hyperplane.
  have hgx' := (apply_mem_chamber_apply_iff hρ g).2 hx
  rw [closure_chamber ρ hy] at hgx
  intro H hH
  have hsq := Hᗮ.inner_starProjection_sq_of_finrank_eq_one
    (ρ.finrank_orthogonal_of_mem_reflectingHyperplanes hH) y (ρ g x)
  refine (hgx H hH).lt_of_ne fun h ↦ ?_
  rw [← h, zero_pow two_ne_zero] at hsq
  exact (mul_pos (hy H hH) (hgx' H hH)).ne' hsq.symm

end Representation
