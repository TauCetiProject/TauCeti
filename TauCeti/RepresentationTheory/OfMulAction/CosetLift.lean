module

public import Mathlib.GroupTheory.GroupAction.Quotient
public import Mathlib.RepresentationTheory.Intertwining
public import Mathlib.RepresentationTheory.Invariants
public import Mathlib.RepresentationTheory.Stabilizer
import TauCeti.Algebra.MonoidAlgebra.Basis
import TauCeti.RepresentationTheory.Stabilizer

/-!
# Intertwining maps out of permutation representations on cosets

For a subgroup `U` of a group `G`, the permutation representation `A[G ⧸ U]` is generated by the
basis vector of the coset `U`, which is fixed by `U`. This file proves the universal property: for
a vector `v` of a representation `ρ` fixed by `U`, there is a unique intertwining map
`A[G ⧸ U] → V` sending the coset `U` to `v`, namely `g U ↦ ρ g v`.

## Main definitions

* `Representation.cosetLift ρ U v hU`: for `U` fixing `v`, the intertwining map
  `A[G ⧸ U] → V`, `g U ↦ ρ g v`. It is the linear extension of the orbit map
  `Representation.orbitMap` composed with `G ⧸ U → G ⧸ ρ.stabilizer v`.
* `Representation.ofMulActionQuotientMapEquiv ρ U`: over a commutative ring, the linear
  equivalence between intertwining maps `A[G ⧸ U] → V` and the `U`-invariant vectors of `V`,
  given by evaluation at the coset `U` and inverted by `Representation.cosetLift`.

## Main results

* `Representation.IntertwiningMap.ofMulAction_quotient_ext`: an intertwining map out of `A[G ⧸ U]`
  is determined by its value on the coset `U`.
* `Representation.IntertwiningMap.eq_cosetLift`: every intertwining map out of `A[G ⧸ U]` is a
  `cosetLift`.
-/

public section

open scoped MonoidAlgebra

namespace Representation

section Semiring

variable {A G V : Type*} [Semiring A] [Group G] [AddCommMonoid V] [Module A V]
  {ρ : Representation A G V} {U : Subgroup G}

/-- An intertwining map out of `A[G ⧸ U]` is determined by its value on the basis vector of the
coset `U`. -/
@[ext 1100]
theorem IntertwiningMap.ofMulAction_quotient_ext
    {f f' : IntertwiningMap (ofMulAction A G (G ⧸ U)) ρ}
    (h : f (MonoidAlgebra.single ((1 : G) : G ⧸ U) 1) =
      f' (MonoidAlgebra.single ((1 : G) : G ⧸ U) 1)) : f = f' := by
  refine IntertwiningMap.ext <| (MonoidAlgebra.basis (G ⧸ U) A).ext fun x ↦ ?_
  induction x using QuotientGroup.induction_on with | H g =>
  simpa [← IntertwiningMap.isIntertwining, ofMulAction_single] using congrArg (ρ g) h

/-- The image of the basis vector of the coset `U` under an intertwining map out of `A[G ⧸ U]` is
fixed by `U`. -/
theorem IntertwiningMap.le_stabilizer_apply_single_one
    (f : IntertwiningMap (ofMulAction A G (G ⧸ U)) ρ) :
    U ≤ ρ.stabilizer (f (MonoidAlgebra.single ((1 : G) : G ⧸ U) 1)) := fun u hu ↦ by
  have hu' : u • ((1 : G) : G ⧸ U) = ((1 : G) : G ⧸ U) :=
    QuotientGroup.eq.2 (by simpa using U.inv_mem hu)
  rw [mem_stabilizer, ← f.isIntertwining, ofMulAction_single, hu']

variable (ρ) in
/-- For a subgroup `U` fixing `v`, the intertwining map `A[G ⧸ U] → V` sending the basis vector
of the coset `g U` to `ρ g v`. -/
noncomputable def cosetLift (U : Subgroup G) (v : V) (hU : U ≤ ρ.stabilizer v) :
    IntertwiningMap (ofMulAction A G (G ⧸ U)) ρ :=
  (Finsupp.linearCombination A (ρ.orbitMap v ∘ Subgroup.quotientMapOfLE hU) ∘ₗ
    (MonoidAlgebra.basis (G ⧸ U) A).repr.toLinearMap).intertwiningMap_of_isIntertwiningMap _ _
    fun g x ↦ by
      induction x using MonoidAlgebra.induction_linear with
      | zero => simp
      | add x y hx hy => simp only [map_add, hx, hy]
      | single x c =>
        induction x using QuotientGroup.induction_on with | H h =>
        simp [ofMulAction_single, map_mul]

@[simp]
theorem cosetLift_single (U : Subgroup G) (v : V) (hU : U ≤ ρ.stabilizer v) (g : G) (c : A) :
    ρ.cosetLift U v hU (MonoidAlgebra.single (g : G ⧸ U) c) = c • ρ g v := by
  simp [cosetLift]

/-- **Uniqueness of the coset lift**: every intertwining map out of `A[G ⧸ U]` is the coset lift
of its value on the basis vector of the coset `U`. -/
theorem IntertwiningMap.eq_cosetLift
    (f : IntertwiningMap (ofMulAction A G (G ⧸ U)) ρ) :
    f = ρ.cosetLift U _ f.le_stabilizer_apply_single_one := by
  ext
  simp

end Semiring

section CommRing

variable {A G V : Type*} [CommRing A] [Group G] [AddCommGroup V] [Module A V]

variable (ρ : Representation A G V) (U : Subgroup G)

/-- **The universal property of `A[G ⧸ U]`** (Frobenius reciprocity for a permutation
representation on cosets): intertwining maps `A[G ⧸ U] → V` correspond to the `U`-invariant
vectors of `V`. A map corresponds to its value at the basis vector of the coset `U`, and an
invariant vector `v` to the coset lift `g U ↦ ρ g v`. -/
noncomputable def ofMulActionQuotientMapEquiv :
    IntertwiningMap (ofMulAction A G (G ⧸ U)) ρ ≃ₗ[A] invariants (ρ.comp U.subtype) where
  toFun f := ⟨f (MonoidAlgebra.single ((1 : G) : G ⧸ U) 1),
    fun u ↦ f.le_stabilizer_apply_single_one u.property⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  invFun v := ρ.cosetLift U v fun u hu ↦ v.property ⟨u, hu⟩
  left_inv f := f.eq_cosetLift.symm
  right_inv v := Subtype.ext <| (cosetLift_single ..).trans <| by simp

/-- `Representation.ofMulActionQuotientMapEquiv` evaluates a map at the basis vector of the coset
`U`. -/
@[simp]
theorem coe_ofMulActionQuotientMapEquiv_apply (f : IntertwiningMap (ofMulAction A G (G ⧸ U)) ρ) :
    (ρ.ofMulActionQuotientMapEquiv U f : V) = f (MonoidAlgebra.single ((1 : G) : G ⧸ U) 1) :=
  (rfl)

/-- The intertwining map attached to a `U`-invariant vector `v` sends the coset `g U` to
`ρ g v`. -/
@[simp]
theorem ofMulActionQuotientMapEquiv_symm_apply_single (v : invariants (ρ.comp U.subtype)) (g : G)
    (c : A) :
    (ρ.ofMulActionQuotientMapEquiv U).symm v (MonoidAlgebra.single (g : G ⧸ U) c) =
      c • ρ g v :=
  cosetLift_single ..

end CommRing

end Representation
