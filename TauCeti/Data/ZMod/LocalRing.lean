module

public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
public import Mathlib.RingTheory.ZMod.LocalRing

/-!
# Local rings modulo prime powers

For a positive power of a prime, a residue is a unit exactly when its reduction
modulo the prime is nonzero. Mathlib's instance in `Mathlib.RingTheory.ZMod.LocalRing` makes the
prime-power ring local; in that local ring, equality in the residue field is equality after
reduction modulo the prime. The statements include the prime two and exclude the exponent-zero
trivial ring.

## Main declarations

* `ZMod.isUnit_prime_pow_iff_castHom_ne_zero`: the unit criterion under reduction.
* `ZMod.residue_eq_residue_iff_castHom_eq`: equality in the residue field is equality after
  reduction modulo the prime.
* `ZMod.maximalIdeal_prime_pow_eq_span`: the maximal ideal is generated by the prime.
-/

public section

namespace ZMod

/-- A residue modulo a positive prime power is a unit exactly when its reduction
modulo the prime is nonzero. -/
@[simp]
theorem isUnit_prime_pow_iff_castHom_ne_zero (p k : ℕ) [Fact p.Prime] (hk : k ≠ 0)
    (x : ZMod (p ^ k)) : IsUnit x ↔ castHom (dvd_pow_self p hk) (ZMod p) x ≠ 0 :=
  -- The reduction is a local homomorphism into a field (`ZMod.isLocalHom_castHom_pow`).
  have := isLocalHom_castHom_pow (n := p) hk
  (isUnit_map_iff _ x).symm.trans isUnit_iff_ne_zero

/-- For a positive prime power, two residues have the same image in the local-ring residue field
exactly when their reductions modulo the prime are equal. -/
theorem residue_eq_residue_iff_castHom_eq (p k : ℕ) [Fact p.Prime] [NeZero k]
    (x y : ZMod (p ^ k)) :
    IsLocalRing.residue _ x = IsLocalRing.residue _ y ↔
      castHom (dvd_pow_self p (NeZero.ne k)) (ZMod p) x =
        castHom (dvd_pow_self p (NeZero.ne k)) (ZMod p) y := by
  -- Both maps are surjections onto fields, so both kernels are the maximal ideal.
  rw [← RingHom.sub_mem_ker_iff, ← RingHom.sub_mem_ker_iff, IsLocalRing.ker_residue,
    IsLocalRing.ker_eq_maximalIdeal _ (castHom_surjective _)]

/-- The maximal ideal of the integers modulo a prime power, when local, is generated by the
prime. -/
theorem maximalIdeal_prime_pow_eq_span (p k : ℕ) [Fact p.Prime] [IsLocalRing (ZMod (p ^ k))] :
    IsLocalRing.maximalIdeal (ZMod (p ^ k)) = Ideal.span {(p : ZMod (p ^ k))} := by
  -- A local ring is nontrivial, so the exponent is positive.
  have hk : k ≠ 0 := fun h ↦ (nontrivial_iff (n := p ^ k)).mp inferInstance (by rw [h, pow_zero])
  -- The maximal ideal is the kernel of the reduction onto the field `ZMod p`.
  rw [← IsLocalRing.ker_eq_maximalIdeal _ (castHom_surjective (dvd_pow_self p hk))]
  ext x
  rw [RingHom.mem_ker, Ideal.mem_span_singleton']
  constructor
  · intro hx
    rw [castHom_apply, cast_eq_val, natCast_eq_zero_iff] at hx
    obtain ⟨m, hm⟩ := hx
    exact ⟨m, by rw [← Nat.cast_mul, mul_comm, ← hm, natCast_zmod_val]⟩
  · rintro ⟨a, rfl⟩
    rw [map_mul, map_natCast, natCast_self, mul_zero]

end ZMod
