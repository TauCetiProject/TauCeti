module

public import Mathlib.RingTheory.ZMod.UnitsCyclic
import TauCeti.Algebra.Group.Subgroup.ZPowers
import TauCeti.Data.ZMod.Units

/-!
# Small orders of dyadic units modulo sign

If a positive power of a dyadic unit is a sign, the size of that exponent bounds
how far down the dyadic tower the unit reduces to a sign. This uses the decomposition
of the dyadic unit group into the subgroups generated by `5` and `-1`.
-/

public section

namespace ZMod

/-- If a positive power `r < 2^(k+1)` of a unit modulo `2^(n+k+2)` is a sign, the
unit itself reduces to a sign modulo `2^(n+2)`. -/
theorem unitsMap_eq_one_or_neg_one_of_pow_mem_zpowers_neg_one {n k r : ℕ}
    (u : (ZMod (2 ^ (n + k + 2)))ˣ) (hr : 0 < r) (hrk : r < 2 ^ (k + 1))
    (hu : u ^ r ∈ Subgroup.zpowers (-1 : (ZMod (2 ^ (n + k + 2)))ˣ)) :
    let d : 2 ^ (n + 2) ∣ 2 ^ (n + k + 2) := pow_dvd_pow 2 (by omega)
    unitsMap d u = 1 ∨ unitsMap d u = -1 := by
  let g : (ZMod (2 ^ (n + k + 2)))ˣ := unitFive
  let H := Subgroup.zpowers g
  let K := Subgroup.zpowers (-1 : (ZMod (2 ^ (n + k + 2)))ˣ)
  have hHK : H ⊔ K = ⊤ := (isComplement'_zpowers_unitFive_neg_one _).sup_eq_top
  obtain ⟨a, ha, b, hb, rfl⟩ := Subgroup.mem_sup.mp (hHK ▸ Subgroup.mem_top u)
  have har : a ^ r ∈ K := by
    rw [mul_pow] at hu
    simpa only [mul_inv_cancel_right] using K.mul_mem hu (K.inv_mem (K.pow_mem hb r))
  have hdisj : Disjoint H K := disjoint_zpowers_unitFive_neg_one _
  have ha1 : a ^ r = 1 := Subgroup.disjoint_def.mp hdisj (H.pow_mem ha r) har
  have hg : orderOf g = 2 ^ (n + k) := by simp [g, orderOf_unitFive]
  have hdiv : orderOf a ∣ 2 ^ (n + k) := hg ▸ orderOf_dvd_of_mem_zpowers ha
  obtain ⟨i, -, hi⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdiv
  have hik : i ≤ k := by
    have hle := Nat.le_of_dvd hr (hi ▸ orderOf_dvd_of_pow_eq_one ha1)
    exact Nat.lt_succ_iff.mp ((Nat.pow_lt_pow_iff_right (by decide : 1 < 2)).mp (hle.trans_lt hrk))
  have hak : a ^ 2 ^ k = 1 := orderOf_dvd_iff_pow_eq_one.mp (hi ▸ pow_dvd_pow 2 hik)
  obtain ⟨j, rfl⟩ := mem_powers_iff_mem_zpowers.mpr ha
  have hj : (2 ^ (n + k) : ℕ) ∣ j * 2 ^ k := by
    rw [← hg, orderOf_dvd_iff_pow_eq_one, pow_mul]
    exact hak
  have hj' : (2 ^ n : ℕ) ∣ j := by
    rwa [pow_add, Nat.mul_dvd_mul_iff_right (by positivity : 0 < 2 ^ k)] at hj
  dsimp only
  have hmap : unitsMap (pow_dvd_pow 2 (by omega : n + 2 ≤ n + k + 2)) (g ^ j) = 1 := by
    rw [map_pow, unitsMap_unitFive, ← orderOf_dvd_iff_pow_eq_one, orderOf_unitFive,
      Nat.add_sub_cancel_right]
    exact hj'
  simpa only [map_mul, hmap, one_mul, unitsMap_neg, map_one] using
    (Subgroup.mem_zpowers_neg_one_iff.mp hb).imp
      (congrArg (unitsMap (pow_dvd_pow 2 (by omega : n + 2 ≤ n + k + 2))))
      (congrArg (unitsMap (pow_dvd_pow 2 (by omega : n + 2 ≤ n + k + 2))))

end ZMod
