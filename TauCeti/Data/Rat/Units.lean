module

public import Mathlib.Algebra.Field.Rat
public import Mathlib.Algebra.GroupWithZero.Units.Basic
public import Mathlib.Algebra.Ring.Units
public import Mathlib.Data.Nat.Prime.Defs
import Mathlib.Data.Nat.Factorization.Induction
import Mathlib.Data.Rat.Lemmas

/-!
# Homomorphisms out of the units of `ℚ`

The group `ℚˣ` is generated by `-1` and the prime numbers: a nonzero rational is `±` a quotient
of two positive integers, each a product of primes. So a monoid homomorphism out of `ℚˣ` is
determined by its values at `-1` and at the primes (`MonoidHom.ext_units_rat`), the analogue for
`ℚˣ` of Mathlib's `MonoidHom.ext_int` for `ℤ`. This is how an identity between characters of
`ℚˣ`, such as a product formula for local symbols, reduces to finitely many explicit evaluations.

## Main results

* `MonoidHom.ext_units_rat`: two monoid homomorphisms out of `ℚˣ` that agree at `-1` and at
  every prime are equal.
-/

public section

namespace MonoidHom

variable {M : Type*} [Monoid M]

/-- **Homomorphisms out of `ℚˣ` agreeing at `-1` and at the primes are equal**: `ℚˣ` is generated
by `-1` and the prime numbers. -/
theorem ext_units_rat {f g : ℚˣ →* M} (h_neg_one : f (-1) = g (-1))
    (h_prime : ∀ (q : ℕ) (hq : q.Prime), f (Units.mk0 q (Nat.cast_ne_zero.2 hq.ne_zero)) =
      g (Units.mk0 q (Nat.cast_ne_zero.2 hq.ne_zero))) :
    f = g := by
  -- Positive integers, by induction on their prime factors.
  have hnat (n : ℕ) (hn : (n : ℚ) ≠ 0) : f (Units.mk0 n hn) = g (Units.mk0 n hn) := by
    induction n using induction_on_primes with
    | zero => exact absurd Nat.cast_zero hn
    | one => simp only [Nat.cast_one, Units.mk0_one, map_one]
    | prime_mul q n hq ih => simp only [Nat.cast_mul, Units.mk0_mul, map_mul, h_prime q hq, ih]
  -- Nonzero integers, by their sign, writing `-n` as `-1 * n`.
  have hint (z : ℤ) (hz : (z : ℚ) ≠ 0) : f (Units.mk0 z hz) = g (Units.mk0 z hz) := by
    -- Mathlib has no `Units.mk0_neg_one`.
    have hmk0 (h : (-1 : ℚ) ≠ 0) : Units.mk0 (-1 : ℚ) h = -1 := Units.ext rfl
    obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg z
    · simp only [Int.cast_natCast, hnat]
    · simp only [Int.cast_neg, Int.cast_natCast, neg_eq_neg_one_mul (n : ℚ), Units.mk0_mul, hmk0,
        map_mul, h_neg_one, hnat]
  -- Agreement at a unit gives agreement at its inverse, in any monoid.
  have hinv (d : ℚˣ) (hd : f d = g d) : f d⁻¹ = g d⁻¹ :=
    calc f d⁻¹ = f d⁻¹ * g (d * d⁻¹) := by rw [mul_inv_cancel, map_one, mul_one]
      _ = f d⁻¹ * (f d * g d⁻¹) := by rw [map_mul, ← hd]
      _ = g d⁻¹ := by rw [← mul_assoc, ← map_mul, inv_mul_cancel, map_one, one_mul]
  ext a
  have hnum : ((a : ℚ).num : ℚ) ≠ 0 := Int.cast_ne_zero.2 (Rat.num_ne_zero.2 a.ne_zero)
  have hden : (((a : ℚ).den : ℤ) : ℚ) ≠ 0 := by
    rw [Int.cast_natCast, Nat.cast_ne_zero]
    exact (a : ℚ).den_nz
  have ha : a = Units.mk0 _ hnum * (Units.mk0 _ hden)⁻¹ := Units.ext <| by
    rw [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_mk0, Units.val_mk0, Int.cast_natCast,
      ← div_eq_mul_inv, Rat.num_div_den]
  rw [ha, map_mul, map_mul, hint, hinv _ (hint _ hden)]

end MonoidHom
