module

public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import Mathlib.Algebra.Order.BigOperators.Ring.Finset
public import TauCeti.Data.Rat.NumDenDvd

/-!
# Rationals as integer multiples of `1 / n`

A rational lies in the additive subgroup `zmultiples (1 / n)` generated by `1 / n`, for `n ≠ 0`,
exactly when its denominator divides `n`. In particular finitely many rationals all lie in
`zmultiples (1 / D)` for a common denominator `D > 0`, such as the product of their denominators.
This places any finite family of rational data inside a cyclic subgroup with a positive generator,
where arguments by discreteness of the values apply.

## Main results

* `Rat.mem_zmultiples_inv_natCast_iff`: `r ∈ zmultiples (1 / n)` exactly when `r.den ∣ n`.
* `Rat.exists_forall_mem_zmultiples_inv_natCast`: finitely many rationals lie in
  `zmultiples (1 / D)` for some `D > 0`.
-/

public section

namespace Rat

/-- For `n ≠ 0`, a rational is an integer multiple of `1 / n` exactly when its denominator
divides `n`. -/
theorem mem_zmultiples_inv_natCast_iff {r : ℚ} {n : ℕ} (hn : n ≠ 0) :
    r ∈ AddSubgroup.zmultiples (n : ℚ)⁻¹ ↔ r.den ∣ n := by
  rw [den_dvd_iff_exists_eq_intCast_div hn, AddSubgroup.mem_zmultiples_iff]
  simp [zsmul_eq_mul, div_eq_mul_inv, eq_comm]

/-- **Common denominators.** Finitely many rationals are all integer multiples of `1 / D` for some
`D > 0`. -/
theorem exists_forall_mem_zmultiples_inv_natCast {ι : Type*} [Finite ι] (q : ι → ℚ) :
    ∃ D : ℕ, 0 < D ∧ ∀ i, q i ∈ AddSubgroup.zmultiples (D : ℚ)⁻¹ := by
  have := Fintype.ofFinite ι
  have hD : 0 < ∏ i, (q i).den := Finset.prod_pos fun i _ ↦ (q i).den_pos
  refine ⟨_, hD, fun i ↦ (mem_zmultiples_inv_natCast_iff hD.ne').2 ?_⟩
  exact Finset.dvd_prod_of_mem _ (Finset.mem_univ i)

end Rat
