module

public import Mathlib.MeasureTheory.Constructions.Cylinders
public import Mathlib.Logic.Function.DependsOn
import Mathlib.MeasureTheory.Function.FactorsThrough

/-!
# Events depending on a set of coordinates

Mathlib's `MeasureTheory.cylinderEvents Δ` is the σ-algebra on a product `∀ i, X i` generated by
the coordinates in `Δ`. This file identifies it with the pullback of the product σ-algebra along
the restriction to `Δ`, and deduces that its measurable functions and events depend only on the
coordinates in `Δ`. For a product `ι → S` of copies of one space it computes the pullback of
`cylinderEvents Δ` along a reindexing `ω ↦ ω ∘ σ`: events depending on the coordinates in `Δ` are
pulled back to events depending on the coordinates in `σ '' Δ`. A group acting on the index set
acts on configurations by such reindexings, so this is how the action moves the σ-algebras of
events depending on the coordinates outside a finite set.

## Main results

* `TauCeti.MeasureTheory.cylinderEvents_le_iff`: `cylinderEvents Δ ≤ m` iff every coordinate in
  `Δ` is `m`-measurable.
* `TauCeti.MeasureTheory.cylinderEvents_eq_comap_domRestrict`: `cylinderEvents Δ` is the pullback
  of the product σ-algebra along `Set.domRestrict Δ`.
* `Measurable.dependsOn_of_cylinderEvents`, `MeasurableSet.dependsOn_of_cylinderEvents`: functions
  and events measurable for `cylinderEvents Δ` depend only on the coordinates in `Δ`.
* `TauCeti.MeasureTheory.comap_comp_cylinderEvents`: the pullback of `cylinderEvents Δ` along
  `ω ↦ ω ∘ σ` is `cylinderEvents (σ '' Δ)`.
-/

public section

open MeasureTheory Set

namespace TauCeti

namespace MeasureTheory

variable {ι : Type*} {X : ι → Type*} [∀ i, MeasurableSpace (X i)]

/-- No coordinate generates the trivial σ-algebra. -/
@[simp]
theorem cylinderEvents_empty : cylinderEvents (X := X) ∅ = ⊥ := by
  simp [cylinderEvents]

/-- The σ-algebra generated by the coordinates in `Δ` is below `m` iff every coordinate in `Δ` is
`m`-measurable. -/
theorem cylinderEvents_le_iff {Δ : Set ι} {m : MeasurableSpace (∀ i, X i)} :
    cylinderEvents Δ ≤ m ↔ ∀ i ∈ Δ, Measurable[m] fun ω : ∀ i, X i => ω i := by
  rw [← MeasurableSpace.comap_id (m := cylinderEvents Δ), ← measurable_iff_comap_le,
    measurable_cylinderEvents_iff]
  simp only [id_eq]

/-- The σ-algebra generated by the coordinates in `Δ` is the pullback of the product σ-algebra on
`∀ i : Δ, X i` along the restriction to `Δ`. -/
theorem cylinderEvents_eq_comap_domRestrict (Δ : Set ι) :
    cylinderEvents (X := X) Δ = MeasurableSpace.pi.comap Δ.domRestrict := by
  refine le_antisymm (cylinderEvents_le_iff.2 fun i hi => ?_)
    (measurable_restrict_cylinderEvents Δ).comap_le
  -- The `i`-th coordinate factors through the restriction to `Δ`, as the `⟨i, hi⟩`-th coordinate.
  have hfac : (fun ω : ∀ i, X i => ω i) = (fun ω : ∀ i : Δ, X i => ω ⟨i, hi⟩) ∘ Δ.domRestrict :=
    funext fun ω => (Set.domRestrict_apply ω Δ ⟨i, hi⟩).symm
  rw [hfac]
  exact (measurable_pi_apply (X := fun j : Δ => X j) ⟨i, hi⟩).comp (comap_measurable _)

end MeasureTheory

end TauCeti

open TauCeti.MeasureTheory

variable {ι : Type*} {X : ι → Type*} [∀ i, MeasurableSpace (X i)] {Δ : Set ι}

/-- A function measurable for the σ-algebra generated by the coordinates in `Δ`, with values in a
space whose singletons are measurable, depends only on the coordinates in `Δ`. -/
theorem Measurable.dependsOn_of_cylinderEvents {Z : Type*} [MeasurableSpace Z]
    [MeasurableSingletonClass Z] {f : (∀ i, X i) → Z} (hf : Measurable[cylinderEvents Δ] f) :
    DependsOn f Δ := by
  rw [cylinderEvents_eq_comap_domRestrict] at hf
  exact dependsOn_iff_factorsThrough.2 hf.factorsThrough

/-- An event measurable for the σ-algebra generated by the coordinates in `Δ` depends only on the
coordinates in `Δ`. -/
theorem MeasurableSet.dependsOn_of_cylinderEvents {s : Set (∀ i, X i)}
    (hs : MeasurableSet[cylinderEvents Δ] s) : DependsOn (· ∈ s) Δ :=
  (@measurable_mem _ _ (cylinderEvents Δ) |>.2 hs).dependsOn_of_cylinderEvents

namespace TauCeti

namespace MeasureTheory

/-- Reindexing a product `ι → S` along `σ : ι' → ι` pulls the events depending on the coordinates
in `Δ ⊆ ι'` back to the events depending on the coordinates in `σ '' Δ`. -/
theorem comap_comp_cylinderEvents {ι' S : Type*} [MeasurableSpace S] (σ : ι' → ι) (Δ : Set ι') :
    (cylinderEvents (X := fun _ : ι' => S) Δ).comap (fun ω : ι → S => ω ∘ σ) =
      cylinderEvents (σ '' Δ) := by
  simp only [cylinderEvents, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp,
    Function.comp_def, iSup_image]

end MeasureTheory

end TauCeti
