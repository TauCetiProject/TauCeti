/-!
# The dyadic filtration of the unit interval

The dyadic cells of the unit interval `I` at level `k` are the `2 ^ k` cells
`cellIdx (2 ^ k) ⁻¹' {i}` of its equipartition, the half-open intervals
`[i / 2 ^ k, (i + 1) / 2 ^ k)` with the top one closed at `1`. Number them breadth first, giving
the cell `i` of level `k` the number `2 ^ k + i`. The two halves of the cell numbered `n` are then
numbered `2 * n` and `2 * n + 1` (see `TauCeti.unitInterval.cellIdx_mul_div`).

`TauCeti.unitInterval.dyadicFiltration N` is the σ-algebra generated by the cells numbered below
`2 * N`. Raising `N` by one adds the two halves of the cell numbered `N`, which is the order in
which the Haar system adds its functions, and at `N = 2 ^ k` the filtration is generated by the
cells of level `k`. Conditional expectations with respect to this filtration are contractions on
every `Lᵖ`, `1 ≤ p ≤ ∞`, by Mathlib's `MeasureTheory.eLpNorm_condExp_le_eLpNorm`, and compose by
the tower property `MeasureTheory.condExp_condExp_of_le`. Since the dyadic cells generate the
σ-algebra of `I`, the conditional expectations of a function in `Lᵖ`, `1 ≤ p < ∞`, converge to it
in `Lᵖ`, and those of an integrable function converge to it almost everywhere.

For `0 < N` the atoms of `dyadicFiltration N` are the `N` cells numbered `N, …, 2 * N - 1`, which
partition `I`, and conditioning on it replaces a function on each atom by its average there.

## Main definitions

* `TauCeti.unitInterval.dyadicFiltration`: the dyadic filtration of `I` in Haar order.
* `TauCeti.unitInterval.dyadicNum k x`: the breadth-first number of the cell of level `k`
  containing `x`.
* `TauCeti.unitInterval.dyadicCell n`: the dyadic cell numbered `n`.
* `TauCeti.unitInterval.dyadicAtom N x`: the number of the atom of `dyadicFiltration N` containing
  `x`.

## Main results

* `TauCeti.unitInterval.dyadicFiltration_two_pow_eq_comap`: at `N = 2 ^ k` the filtration is
  generated by the cell index of level `k`.
* `TauCeti.unitInterval.dyadicFiltration_eq_comap_dyadicAtom`: for `0 < N` the filtration is
  generated by `dyadicAtom N`, whose fibres are the cells numbered `N, …, 2 * N - 1`.
* `TauCeti.unitInterval.condExp_dyadicFiltration_ae_eq`: the dyadic conditional expectations are
  the averages over the atoms.
* `TauCeti.unitInterval.iSup_dyadicFiltration`: the dyadic cells generate the σ-algebra of `I`.
* `TauCeti.unitInterval.tendsto_eLpNorm_condExp_dyadicFiltration`: the dyadic conditional
  expectations of `f ∈ Lᵖ` converge to `f` in `Lᵖ` for `1 ≤ p < ∞`.
* `TauCeti.unitInterval.tendsto_ae_condExp_dyadicFiltration`: the dyadic conditional expectations
  of an integrable function converge to it almost everywhere.

## References

* F. Albiac and N. J. Kalton, *Topics in Banach Space Theory*, 2nd ed., Graduate Texts in
  Mathematics 233, Springer (2016), §6.1.
-/

public section

noncomputable section

open MeasureTheory Filter

open scoped ENNReal Topology unitInterval

namespace TauCeti.unitInterval

/-- The dyadic filtration of the unit interval in Haar order: `dyadicFiltration N` is generated by
the dyadic cells `cellIdx (2 ^ k) ⁻¹' {i}` with `2 ^ k + i < 2 * N`, that is, by the cells whose
breadth-first number `2 ^ k + i` is below `2 * N`. Indices `i ≥ 2 ^ k` give empty cells and so do
not contribute. -/
def dyadicFiltration : Filtration ℕ (inferInstance : MeasurableSpace I) where
  seq N := .generateFrom {s | ∃ k i, 2 ^ k + i < 2 * N ∧ s = cellIdx (2 ^ k) ⁻¹' {i}}
  mono' _ _ hNM := MeasurableSpace.generateFrom_mono fun _ ⟨k, i, hN, hs⟩ =>
    ⟨k, i, by omega, hs⟩
  le' _ := MeasurableSpace.generateFrom_le fun _ ⟨_, _, _, hs⟩ =>
    hs ▸ measurableSet_preimage_cellIdx _ _

/-- The dyadic filtration at step `N` is generated by the cells numbered below `2 * N`. -/
theorem dyadicFiltration_eq_generateFrom (N : ℕ) :
    dyadicFiltration N =
      .generateFrom {s | ∃ k i, 2 ^ k + i < 2 * N ∧ s = cellIdx (2 ^ k) ⁻¹' {i}} :=
  (rfl)

/-- The dyadic cell `i` of level `k` is measurable for the dyadic filtration at every step `N`
with `2 ^ k + i < 2 * N`. -/
theorem measurableSet_dyadicFiltration_preimage_cellIdx {N k i : ℕ} (h : 2 ^ k + i < 2 * N) :
    MeasurableSet[dyadicFiltration N] (cellIdx (2 ^ k) ⁻¹' {i}) := by
  rw [dyadicFiltration_eq_generateFrom]
  exact MeasurableSpace.measurableSet_generateFrom ⟨k, i, h, rfl⟩

/-- At step `2 ^ k` the dyadic filtration is generated by the cell index of level `k`: the coarser
cells it is generated by are unions of cells of level `k`. -/
theorem dyadicFiltration_two_pow_eq_comap (k : ℕ) :
    dyadicFiltration (2 ^ k) = MeasurableSpace.comap (cellIdx (2 ^ k)) ⊤ := by
  refine le_antisymm ?_ ?_
  · rw [dyadicFiltration_eq_generateFrom]
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨j, i, h, rfl⟩
    -- A generating cell has level `j ≤ k`, and is the union of the cells of level `k` whose index
    -- divided by `2 ^ (k - j)` is `i`.
    have hjk : j ≤ k := by
      have : 2 ^ j < 2 ^ (k + 1) := by rw [pow_succ]; omega
      exact Nat.lt_succ_iff.1 ((Nat.pow_lt_pow_iff_right (by norm_num)).1 this)
    have hcell : cellIdx (2 ^ j) ⁻¹' {i} =
        cellIdx (2 ^ k) ⁻¹' ((· / 2 ^ (k - j)) ⁻¹' {i}) := by
      ext x
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      rw [← cellIdx_mul_div (n := 2 ^ (k - j)) (by positivity), ← pow_add,
        Nat.add_sub_cancel' hjk]
    rw [hcell]
    exact MeasurableSpace.measurableSet_comap.2 ⟨_, MeasurableSpace.measurableSet_top, rfl⟩
  · refine MeasurableSpace.comap_le_iff_le_map.2 fun s _ => ?_
    rw [MeasurableSpace.map_def, ← Set.biUnion_preimage_singleton]
    refine MeasurableSet.biUnion s.to_countable fun i _ => ?_
    rcases lt_or_ge i (2 ^ k) with hi | hi
    · exact measurableSet_dyadicFiltration_preimage_cellIdx (by omega)
    · convert MeasurableSet.empty
      exact Set.eq_empty_of_forall_notMem fun x hx =>
        (cellIdx_lt (by positivity) x).not_ge (hx.symm ▸ hi)

/-! ### Dyadic cells and the atoms of the filtration -/

/-- The breadth-first number `2 ^ k + cellIdx (2 ^ k) x` of the dyadic cell of level `k` containing
`x`. -/
def dyadicNum (k : ℕ) (x : I) : ℕ := 2 ^ k + cellIdx (2 ^ k) x

/-- The cells of level `k` are numbered from `2 ^ k`. -/
theorem two_pow_le_dyadicNum (k : ℕ) (x : I) : 2 ^ k ≤ dyadicNum k x :=
  Nat.le_add_right _ _

/-- The cells of level `k` are numbered below `2 ^ (k + 1)`. -/
theorem dyadicNum_lt_two_pow_succ (k : ℕ) (x : I) : dyadicNum k x < 2 ^ (k + 1) := by
  have := cellIdx_lt (Nat.two_pow_pos k) x
  rw [dyadicNum, pow_succ]
  omega

/-- The breadth-first number of the cell of level `k` containing `x` has level `k`. -/
theorem log_dyadicNum (k : ℕ) (x : I) : Nat.log 2 (dyadicNum k x) = k :=
  Nat.log_eq_of_pow_le_of_lt_pow (two_pow_le_dyadicNum k x) (dyadicNum_lt_two_pow_succ k x)

/-- Going up `j` levels from the cell of level `k + j` containing `x` divides its number by
`2 ^ j`. -/
theorem dyadicNum_add_div (k j : ℕ) (x : I) : dyadicNum (k + j) x / 2 ^ j = dyadicNum k x := by
  rw [dyadicNum, dyadicNum, pow_add, mul_comm (2 ^ k), Nat.mul_add_div (Nat.two_pow_pos j),
    mul_comm, cellIdx_mul_div (Nat.two_pow_pos j)]

/-- At most one level of the chain of dyadic cells containing `x` has its number in
`[N, 2 * N)`. -/
theorem eq_of_dyadicNum_mem_Ico {N k l : ℕ} {x : I} (hk : dyadicNum k x ∈ Set.Ico N (2 * N))
    (hl : dyadicNum l x ∈ Set.Ico N (2 * N)) : k = l := by
  -- Going up at least one level halves the number at least once, which leaves `[N, 2 * N)`.
  have key {a b : ℕ} (ha : dyadicNum a x ∈ Set.Ico N (2 * N))
      (hb : dyadicNum b x ∈ Set.Ico N (2 * N)) : ¬ a < b := fun hab => by
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_lt hab
    have h := dyadicNum_add_div a (j + 1) x
    have h2 : dyadicNum (a + j + 1) x / 2 ^ (j + 1) ≤ dyadicNum (a + j + 1) x / 2 :=
      Nat.div_le_div_left (Nat.le_self_pow (Nat.succ_ne_zero j) 2) two_pos
    rw [← add_assoc] at h
    have := ha.1
    have := hb.2
    omega
  exact le_antisymm (not_lt.1 (key hl hk)) (not_lt.1 (key hk hl))

/-- The dyadic cell numbered `n` in breadth-first order: for `n = 2 ^ k + i` with `i < 2 ^ k` it
is the cell `cellIdx (2 ^ k) ⁻¹' {i}` of level `k`, the interval `[i / 2 ^ k, (i + 1) / 2 ^ k)`,
closed at `1` for the top one. The number `0` names no cell, and `dyadicCell 0` is empty. -/
def dyadicCell (n : ℕ) : Set I := {x | dyadicNum (Nat.log 2 n) x = n}

theorem mem_dyadicCell {n : ℕ} {x : I} : x ∈ dyadicCell n ↔ dyadicNum (Nat.log 2 n) x = n :=
  Iff.rfl

/-- A point lies in the dyadic cell numbered `n` when `n` numbers its cell at some level. -/
theorem mem_dyadicCell_iff {n : ℕ} {x : I} : x ∈ dyadicCell n ↔ ∃ k, dyadicNum k x = n :=
  ⟨fun h => ⟨_, h⟩, fun ⟨k, hk⟩ => by
    rw [mem_dyadicCell, ← hk, log_dyadicNum]⟩

@[simp]
theorem dyadicCell_zero : dyadicCell 0 = ∅ :=
  Set.eq_empty_of_forall_notMem fun x hx => (two_pow_le_dyadicNum _ x).not_gt (by
    rw [show dyadicNum _ x = 0 from hx]
    positivity)

/-- Distinct dyadic cells of the same level are disjoint. -/
theorem disjoint_dyadicCell {m n : ℕ} (h : Nat.log 2 m = Nat.log 2 n) (hmn : m ≠ n) :
    Disjoint (dyadicCell m) (dyadicCell n) :=
  Set.disjoint_left.2 fun x hm hn => hmn <| by
    rw [mem_dyadicCell] at hm hn
    rw [← hm, ← hn, h]

/-- A positively numbered dyadic cell is a cell of the equipartition of its level. -/
theorem dyadicCell_eq_preimage_cellIdx {n : ℕ} (hn : 0 < n) :
    dyadicCell n = cellIdx (2 ^ Nat.log 2 n) ⁻¹' {n - 2 ^ Nat.log 2 n} := by
  have := Nat.pow_log_le_self 2 hn.ne'
  ext x
  simp only [dyadicCell, dyadicNum, Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_singleton_iff]
  omega

/-- A positively numbered dyadic cell has volume `2 ^ (-k)`, where `k` is its level. -/
theorem volume_dyadicCell {n : ℕ} (hn : 0 < n) :
    volume (dyadicCell n) = ((2 ^ Nat.log 2 n : ℕ) : ℝ≥0∞)⁻¹ := by
  have := Nat.lt_pow_succ_log_self one_lt_two n
  have := Nat.pow_log_le_self 2 hn.ne'
  rw [dyadicCell_eq_preimage_cellIdx hn, volume_preimage_cellIdx (by rw [pow_succ] at *; omega)]

/-- A positively numbered dyadic cell lies in the cell numbered by half its number. -/
theorem mem_dyadicCell_div_two {n : ℕ} {x : I} (hn : 2 ≤ n) (hx : x ∈ dyadicCell n) :
    x ∈ dyadicCell (n / 2) := by
  have hk : Nat.log 2 n = Nat.log 2 n - 1 + 1 := by
    have := Nat.log_pos one_lt_two hn
    omega
  refine mem_dyadicCell_iff.2 ⟨Nat.log 2 n - 1, ?_⟩
  rw [← dyadicNum_add_div _ 1 x, ← hk, pow_one, show dyadicNum _ x = n from hx]

/-- The dyadic cell numbered `n < 2 * N` is measurable for the dyadic filtration at step `N`. -/
theorem measurableSet_dyadicFiltration_dyadicCell {N n : ℕ} (hn : n < 2 * N) :
    MeasurableSet[dyadicFiltration N] (dyadicCell n) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn0
  · rw [dyadicCell_zero]
    exact @MeasurableSet.empty _ (dyadicFiltration N)
  · rw [dyadicCell_eq_preimage_cellIdx hn0]
    exact measurableSet_dyadicFiltration_preimage_cellIdx (by
      have := Nat.pow_log_le_self 2 hn0.ne'
      omega)

@[measurability]
theorem measurableSet_dyadicCell (n : ℕ) : MeasurableSet (dyadicCell n) :=
  dyadicFiltration.le (n + 1) _ (measurableSet_dyadicFiltration_dyadicCell (by omega))

/-- The number of the dyadic cell containing `x` among the `N` cells numbered `N, …, 2 * N - 1`.
For `0 < N` these cells partition the unit interval (`dyadicAtom_mem_Ico`,
`dyadicAtom_eq_iff`) and are the atoms of `dyadicFiltration N`
(`dyadicFiltration_eq_comap_dyadicAtom`). They are the cells of level `k = Nat.log 2 N` numbered
at least `N`, together with the cells of level `k + 1` numbered below `2 * N`. -/
def dyadicAtom (N : ℕ) (x : I) : ℕ :=
  if N ≤ dyadicNum (Nat.log 2 N) x then dyadicNum (Nat.log 2 N) x
  else dyadicNum (Nat.log 2 N + 1) x

/-- For `0 < N`, the atom containing a point is numbered in `[N, 2 * N)`. -/
theorem dyadicAtom_mem_Ico {N : ℕ} (hN : 0 < N) (x : I) :
    dyadicAtom N x ∈ Set.Ico N (2 * N) := by
  have h1 := Nat.pow_log_le_self 2 hN.ne'
  have h2 := Nat.lt_pow_succ_log_self one_lt_two N
  have h3 := dyadicNum_lt_two_pow_succ (Nat.log 2 N) x
  have h4 := two_pow_le_dyadicNum (Nat.log 2 N + 1) x
  have h5 := dyadicNum_add_div (Nat.log 2 N) 1 x
  rw [pow_succ] at h2 h3 h4
  rw [pow_one] at h5
  unfold dyadicAtom
  split_ifs with h <;> constructor <;> omega

/-- Every point lies in the dyadic cell numbered by its atom. -/
theorem mem_dyadicCell_dyadicAtom (N : ℕ) (x : I) : x ∈ dyadicCell (dyadicAtom N x) := by
  refine mem_dyadicCell_iff.2 ?_
  unfold dyadicAtom
  split_ifs
  exacts [⟨_, rfl⟩, ⟨_, rfl⟩]

/-- For `N ≤ n < 2 * N`, the fibre of `dyadicAtom N` over `n` is the dyadic cell numbered `n`. -/
theorem dyadicAtom_eq_iff {N n : ℕ} (hn : n ∈ Set.Ico N (2 * N)) {x : I} :
    dyadicAtom N x = n ↔ x ∈ dyadicCell n := by
  refine ⟨fun h => h ▸ mem_dyadicCell_dyadicAtom N x, fun hx => ?_⟩
  have hN : 0 < N := by have := hn.2; omega
  have ha := mem_dyadicCell_dyadicAtom N x
  rw [mem_dyadicCell] at ha hx
  have hka := dyadicAtom_mem_Ico hN x
  rw [← ha] at hka
  rw [← hx] at hn
  rw [← ha, ← hx, eq_of_dyadicNum_mem_Ico hka hn]

@[fun_prop]
theorem measurable_dyadicAtom (N : ℕ) : Measurable (dyadicAtom N) := by
  unfold dyadicAtom dyadicNum
  refine Measurable.ite ?_ (by fun_prop) (by fun_prop)
  exact measurableSet_le measurable_const (by fun_prop)

/-- Two points with the same atom at step `N` lie in the same dyadic cells numbered below
`2 * N`. -/
theorem dyadicNum_eq_of_dyadicAtom_eq {N k : ℕ} {x y : I} (h : dyadicAtom N x = dyadicAtom N y)
    (hy : dyadicNum k y < 2 * N) : dyadicNum k x = dyadicNum k y := by
  have hN : 0 < N := by have := two_pow_le_dyadicNum k y; omega
  set a := dyadicAtom N y
  have hxa : dyadicNum (Nat.log 2 a) x = a := h ▸ mem_dyadicCell_dyadicAtom N x
  have hya : dyadicNum (Nat.log 2 a) y = a := mem_dyadicCell_dyadicAtom N y
  have haN := (dyadicAtom_mem_Ico hN y).1
  rcases le_or_gt k (Nat.log 2 a) with hk | hk
  · -- The cell of level `k` lies above the common atom.
    obtain ⟨j, hj⟩ := Nat.exists_eq_add_of_le hk
    rw [← dyadicNum_add_div k j x, ← dyadicNum_add_div k j y, ← hj, hxa, hya]
  · -- A cell below the atom has number at least twice that of the atom.
    obtain ⟨j, hj⟩ := Nat.exists_eq_add_of_lt hk
    have h1 := dyadicNum_add_div (Nat.log 2 a) (j + 1) y
    rw [← add_assoc, ← hj, hya] at h1
    have h2 := Nat.div_mul_le_self (dyadicNum k y) (2 ^ (j + 1))
    have h3 : 2 ≤ 2 ^ (j + 1) := Nat.le_self_pow (Nat.succ_ne_zero j) 2
    nlinarith

/-- **The atoms of the dyadic filtration.** For `0 < N`, the dyadic filtration at step `N` is
generated by `dyadicAtom N`: its atoms are the `N` dyadic cells numbered `N, …, 2 * N - 1`. -/
theorem dyadicFiltration_eq_comap_dyadicAtom {N : ℕ} (hN : 0 < N) :
    dyadicFiltration N = MeasurableSpace.comap (dyadicAtom N) ⊤ := by
  refine le_antisymm ?_ ?_
  · rw [dyadicFiltration_eq_generateFrom]
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨k, i, h, rfl⟩
    -- A generating cell is saturated for `dyadicAtom N`.
    refine ⟨dyadicAtom N '' (cellIdx (2 ^ k) ⁻¹' {i}), MeasurableSpace.measurableSet_top, ?_⟩
    refine Set.Subset.antisymm ?_ (Set.subset_preimage_image _ _)
    rintro x ⟨y, hy, hxy⟩
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hy ⊢
    have := dyadicNum_eq_of_dyadicAtom_eq hxy.symm (k := k) (by rw [dyadicNum, hy]; exact h)
    rw [dyadicNum, dyadicNum, hy] at this
    omega
  · refine MeasurableSpace.comap_le_iff_le_map.2 fun s _ => ?_
    rw [MeasurableSpace.map_def, ← Set.biUnion_preimage_singleton]
    refine MeasurableSet.biUnion s.to_countable fun n _ => ?_
    by_cases hn : n ∈ Set.Ico N (2 * N)
    · have : dyadicAtom N ⁻¹' {n} = dyadicCell n := Set.ext fun x => dyadicAtom_eq_iff hn
      rw [this]
      exact measurableSet_dyadicFiltration_dyadicCell hn.2
    · convert @MeasurableSet.empty _ (dyadicFiltration N)
      exact Set.eq_empty_of_forall_notMem fun x hx => hn (hx ▸ dyadicAtom_mem_Ico hN x)

/-- The dyadic cells generate the σ-algebra of the unit interval. -/
theorem iSup_dyadicFiltration :
    ⨆ N, dyadicFiltration N = (inferInstance : MeasurableSpace I) := by
  refine le_antisymm (iSup_le dyadicFiltration.le) ?_
  -- The coordinate is the pointwise limit of the left endpoints of its dyadic cells, which are
  -- measurable for the dyadic filtration.
  have hcell (k : ℕ) : Measurable[⨆ N, dyadicFiltration N] fun x : I =>
      (cellIdx (2 ^ k) x : ℝ) / ((2 ^ k : ℕ) : ℝ) := by
    have hle : MeasurableSpace.comap (cellIdx (2 ^ k)) ⊤ ≤ ⨆ N, dyadicFiltration N :=
      dyadicFiltration_two_pow_eq_comap k ▸ le_iSup _ (2 ^ k)
    exact (measurable_from_top (f := fun i : ℕ => (i : ℝ) / ((2 ^ k : ℕ) : ℝ))).comp
      ((comap_measurable _).mono hle le_rfl)
  -- The σ-algebra on `I` here is not the instance one, so it is supplied explicitly.
  have hval : Measurable[⨆ N, dyadicFiltration N] (Subtype.val : I → ℝ) :=
    @measurable_of_tendsto_metrizable I ℝ (⨆ N, dyadicFiltration N) _ _ _ _ _ _ hcell
      (tendsto_pi_nhds.2 fun x =>
        (tendsto_cellIdx_div x).comp (tendsto_pow_atTop_atTop_of_one_lt one_lt_two))
  exact hval.comap_le

/-- Conditioning an integrable function on the whole dyadic filtration recovers it. -/
private theorem condExp_iSup_dyadicFiltration_ae_eq {f : I → ℝ} (hf : Integrable f) :
    volume[f | ⨆ N, dyadicFiltration N] =ᵐ[volume] f := by
  rw [iSup_dyadicFiltration]
  exact condExp_of_aestronglyMeasurable' le_rfl hf.aestronglyMeasurable hf

/-- **Dyadic conditional expectations converge in `Lᵖ`.** For `1 ≤ p < ∞` and `f ∈ Lᵖ(I)`, the
conditional expectations of `f` with respect to the dyadic filtration converge to `f` in `Lᵖ`. -/
theorem tendsto_eLpNorm_condExp_dyadicFiltration {p : ℝ≥0∞} (hp1 : 1 ≤ p) (hp : p ≠ ∞)
    {f : I → ℝ} (hf : MemLp f p) :
    Tendsto (fun N => eLpNorm (volume[f | dyadicFiltration N] - f) p volume) atTop (𝓝 0) := by
  refine (hf.tendsto_eLpNorm_condExp (ℱ := dyadicFiltration) hp).congr fun N =>
    eLpNorm_congr_ae ?_
  filter_upwards [condExp_iSup_dyadicFiltration_ae_eq (hf.integrable hp1)] with x hx
  simp [hx]

/-- **Dyadic conditional expectations converge almost everywhere.** The conditional expectations
of an integrable function with respect to the dyadic filtration converge to it almost
everywhere. -/
theorem tendsto_ae_condExp_dyadicFiltration {f : I → ℝ} (hf : Integrable f) :
    ∀ᵐ x, Tendsto (fun N => volume[f | dyadicFiltration N] x) atTop (𝓝 (f x)) := by
  filter_upwards [tendsto_ae_condExp (ℱ := dyadicFiltration) f,
    condExp_iSup_dyadicFiltration_ae_eq hf] with x hx hfx
  rwa [hfx] at hx

/-- **Dyadic conditional expectations are averages over the atoms.** For `0 < N`, the conditional
expectation of an integrable function with respect to the dyadic filtration at step `N` is a.e. its
average over the atom containing the point, the dyadic cell numbered `dyadicAtom N x`. -/
theorem condExp_dyadicFiltration_ae_eq {N : ℕ} (hN : 0 < N) {f : I → ℝ} (hf : Integrable f) :
    volume[f | dyadicFiltration N] =ᵐ[volume]
      fun x => ⨍ y in dyadicCell (dyadicAtom N x), f y := by
  have hmeas : Measurable[MeasurableSpace.comap (dyadicAtom N) ⊤]
      fun x => ⨍ y in dyadicCell (dyadicAtom N x), f y :=
    (measurable_from_top (f := fun n => ⨍ y in dyadicCell n, f y)).comp (comap_measurable _)
  -- The average takes only the `N` values of the atoms, so it is bounded.
  have hint : Integrable fun x => ⨍ y in dyadicCell (dyadicAtom N x), f y :=
    Integrable.of_bound (hmeas.mono (measurable_dyadicAtom N).comap_le le_rfl).aestronglyMeasurable
      (∑ n ∈ Finset.Ico N (2 * N), ‖⨍ y in dyadicCell n, f y‖) (ae_of_all _ fun x =>
        Finset.single_le_sum (f := fun n => ‖⨍ y in dyadicCell n, f y‖)
          (fun _ _ => norm_nonneg _) (Finset.mem_Ico.2 (dyadicAtom_mem_Ico hN x)))
  rw [dyadicFiltration_eq_comap_dyadicAtom hN]
  refine (MeasureTheory.ae_eq_condExp_of_forall_setIntegral_fiber_eq (measurable_dyadicAtom N) hf
    hint hmeas.stronglyMeasurable.aestronglyMeasurable fun n => ?_).symm
  by_cases hn : n ∈ Set.Ico N (2 * N)
  · have hfib : dyadicAtom N ⁻¹' {n} = dyadicCell n := Set.ext fun x => dyadicAtom_eq_iff hn
    rw [hfib, setIntegral_congr_fun (measurableSet_dyadicCell n) fun x hx =>
      congrArg (fun m => ⨍ y in dyadicCell m, f y) ((dyadicAtom_eq_iff hn).2 hx),
      setIntegral_const, measure_smul_setAverage _ (measure_ne_top _ _)]
  · have hfib : dyadicAtom N ⁻¹' {n} = ∅ :=
      Set.eq_empty_of_forall_notMem fun x hx => hn (hx ▸ dyadicAtom_mem_Ico hN x)
    simp [hfib]

end TauCeti.unitInterval
