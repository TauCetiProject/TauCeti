module

public import Mathlib.MeasureTheory.Constructions.BorelSpace.Real
public import Mathlib.Topology.ContinuousMap.Basic
public import Mathlib.Topology.Metrizable.Basic
import Mathlib.Topology.MetricSpace.HausdorffDistance
import Mathlib.Topology.Metrizable.Uniformity

/-!
# Generation of the Borel σ-algebra on pseudometrizable spaces by continuous real functions

On a pseudometrizable space `X`, every nonempty closed set `F` is the zero set of the continuous
distance function `x ↦ Metric.infDist x F`. Consequently, the Borel σ-algebra `borel X` coincides
with the Baire σ-algebra `⨆ f : C(X, ℝ), MeasurableSpace.comap f inferInstance`, the coarsest
σ-algebra making all continuous real-valued functions measurable.

Pulling back along any continuous map `q : X → Y` from an arbitrary topological space `X` into a
pseudometrizable space `Y` therefore maps every Borel set of `Y` into the Baire σ-algebra of `X`.

## Main results

* `TauCeti.borel_eq_iSup_comap_continuousMap`: on a pseudometrizable space `X`, `borel X` equals
  `⨆ f : C(X, ℝ), MeasurableSpace.comap f inferInstance`.
* `Continuous.comap_borel_le_iSup_comap_continuousMap`: for a continuous map `q : X → Y` into a
  pseudometrizable space `Y`, `MeasurableSpace.comap q (borel Y)` is bounded by the σ-algebra on
  `X` generated by `C(X, ℝ)`.

## References

* D. H. Fremlin, *Measure Theory*, Vol. 4, Torres Fremlin (2003), §4A3K.
-/

public section

open TopologicalSpace

namespace TauCeti

/-- On a pseudometrizable space, the Borel σ-algebra coincides with the σ-algebra generated by all
continuous real-valued functions. -/
theorem borel_eq_iSup_comap_continuousMap (X : Type*) [TopologicalSpace X]
    [PseudoMetrizableSpace X] :
    borel X = ⨆ f : C(X, ℝ), MeasurableSpace.comap f inferInstance := by
  refine le_antisymm ?_ (iSup_le fun f ↦ ?_)
  · rw [borel_eq_generateFrom_isClosed]
    refine MeasurableSpace.generateFrom_le fun F hF ↦ ?_
    rcases F.eq_empty_or_nonempty with rfl | hne
    · exact @MeasurableSet.empty X (⨆ f : C(X, ℝ), MeasurableSpace.comap f inferInstance)
    · -- A nonempty closed set in a pseudometric space is the zero locus of `infDist · F`.
      let _ : PseudoMetricSpace X := pseudoMetrizableSpacePseudoMetric X
      let f : C(X, ℝ) := ⟨fun x ↦ Metric.infDist x F, Metric.continuous_infDist_pt F⟩
      have hFeq : F = f ⁻¹' {0} := by
        ext x
        simpa [f] using hF.mem_iff_infDist_zero hne
      rw [hFeq]
      exact le_iSup (fun g : C(X, ℝ) ↦ MeasurableSpace.comap g inferInstance) f _
        ⟨{0}, measurableSet_singleton 0, rfl⟩
  · let _ : MeasurableSpace X := borel X
    have : BorelSpace X := ⟨rfl⟩
    exact f.continuous.measurable.comap_le

end TauCeti

/-- Pulling back the Borel σ-algebra along a continuous map into a pseudometrizable space lands in
the σ-algebra generated by continuous real-valued functions on the domain. -/
theorem Continuous.comap_borel_le_iSup_comap_continuousMap {X Y : Type*} [TopologicalSpace X]
    [TopologicalSpace Y] [PseudoMetrizableSpace Y] {q : X → Y} (hq : Continuous q) :
    MeasurableSpace.comap q (borel Y) ≤
      ⨆ f : C(X, ℝ), MeasurableSpace.comap f inferInstance := by
  rw [TauCeti.borel_eq_iSup_comap_continuousMap Y, MeasurableSpace.comap_iSup]
  refine iSup_le fun g ↦ ?_
  rw [MeasurableSpace.comap_comp]
  exact le_iSup (fun f : C(X, ℝ) ↦ MeasurableSpace.comap f inferInstance) (g.comp ⟨q, hq⟩)

end
