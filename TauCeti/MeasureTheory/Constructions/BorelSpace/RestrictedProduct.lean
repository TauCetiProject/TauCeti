/-!
# Borel structure on a restricted product

Every restricted product `Πʳ i, [R i, A i]_[𝓕]` of topological spaces carries its Borel
`MeasurableSpace` (`RestrictedProduct.measurableSpace := borel _`) and `BorelSpace` instance
(`RestrictedProduct.borelSpace`). Coordinate evaluation, coercion to the full product, filter
inclusions, and single-factor insertions are measurable.

Over a countable index type `ι`:
* Any coordinate box `RestrictedProduct.box C` with Borel-measurable factors `C i` is measurable in
  `Πʳ i, [R i, A i]_[𝓕]` with no openness or cofinite-equality hypothesis (`measurableSet_box`);
  consequently principal-stage inclusions (`𝓕 ≤ 𝓟 S`) and `structureMap` are measurable embeddings
  as soon as the constrained reference sets `A i` are measurable.
* When each `R i` is a second-countable Borel space, even though the coercion
  `(↑) : Πʳ i, [R i, A i] → Π i, R i` is in general not a topological embedding
  (`TauCeti.not_isInducing_coe_bot`), the Borel σ-algebra of `Πʳ i, [R i, A i]` unconditionally
  equals the pullback of the product σ-algebra (`comap_coe_eq_measurableSpace`) and is generated by
  the π-system `measurableBoxes R A` (`borel_eq_generateFrom_measurableBoxes`), with no openness or
  measurability assumption on `A i`; measurability of maps into `Πʳ i, [R i, A i]` is therefore
  detected coordinatewise (`measurable_rng_iff`).
* When `A i` is measurable for cofinitely many `i`, the smaller π-system
  `cofiniteMeasurableBoxes R A` also generates the Borel σ-algebra and `(↑)` is a
  `MeasurableEmbedding` (`measurableEmbedding_coe`). When `A i` is open for cofinitely many `i`,
  `openBoxes R A` generates the Borel σ-algebra (`borel_eq_generateFrom_openBoxes`).

Finally, in `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]` (with discrete factors and open reference subgroup `2ℤ/4`),
the singleton `{0}` is neither open nor a cofinitely-`2ℤ/4` box, yet is a countable intersection of
open cofinitely-`2ℤ/4` boxes (hence Borel measurable), and does not belong to the σ-algebra
generated by all cofinite principal stages and their additive cosets
(`TauCeti.not_measurableSet_singleton_zero_generateFrom_cosets_zmod4`).

## Main definitions and results

* `RestrictedProduct.measurableSpace`, `RestrictedProduct.borelSpace`: Borel `MeasurableSpace` and
  `BorelSpace` instances on `Πʳ i, [R i, A i]_[𝓕]`.
* `RestrictedProduct.measurable_eval`, `RestrictedProduct.measurable_coe`,
  `RestrictedProduct.measurable_inclusion`, `RestrictedProduct.measurable_mulSingle`: measurability
  of structural maps.
* `RestrictedProduct.measurableEmbedding_inclusion_principal`,
  `RestrictedProduct.measurableEmbedding_structureMap`: measurable embeddings of principal stages
  and `structureMap` for measurable `A i`.
* `RestrictedProduct.measurableSet_box`: countable intersections make every Borel box measurable.
* `RestrictedProduct.borel_eq_generateFrom_openBoxes`,
  `RestrictedProduct.borel_eq_generateFrom_cofiniteMeasurableBoxes`,
  `RestrictedProduct.borel_eq_generateFrom_measurableBoxes`: generation of the Borel σ-algebra by
  box π-systems.
* `RestrictedProduct.comap_coe_eq_measurableSpace`, `RestrictedProduct.measurable_rng_iff`,
  `RestrictedProduct.measurableEmbedding_coe`: comparison with the product σ-algebra on `Π i, R i`.
* `TauCeti.measurableSet_integralSubgroupOf`, `TauCeti.measurableSet_integralSubgroup`:
  measurability of integral and level subgroups.
* `TauCeti.singleton_zero_eq_iInter_openBox_zmod4`,
  `TauCeti.not_measurableSet_singleton_zero_generateFrom_cosets_zmod4`: explicit separation
  between singletons, open boxes, and the coset-generated σ-algebra on `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]`.

## References

* N. Bourbaki, *General Topology*.
* D. Bump, *Automorphic Forms and Representations*, §3.3.
* R. V. Ramakrishnan and R. J. Valenza, *Fourier Analysis on Number Fields*, Chapter 5.
* A. Weil, *Basic Number Theory*.
-/

public section

open Filter MeasureTheory Set Topology
open scoped RestrictedProduct

namespace RestrictedProduct

section Basic

variable {ι : Type*} {R : ι → Type*} {A : ∀ i, Set (R i)} {𝓕 : Filter ι}
variable [∀ i, TopologicalSpace (R i)]

variable (R A 𝓕) in
/-- Every restricted product of topological spaces carries its Borel σ-algebra. -/
instance measurableSpace : MeasurableSpace (Πʳ i, [R i, A i]_[𝓕]) :=
  borel _

/-- Every restricted product of topological spaces is a `BorelSpace` for its canonical
`MeasurableSpace`. -/
instance borelSpace : BorelSpace (Πʳ i, [R i, A i]_[𝓕]) :=
  ⟨rfl⟩

/-- Coordinate evaluation at `i` on `Πʳ j, [R j, A j]_[𝓕]` is measurable whenever `R i` is a
Borel space. -/
@[fun_prop]
theorem measurable_eval (i : ι) [MeasurableSpace (R i)] [BorelSpace (R i)] :
    Measurable (fun x : Πʳ j, [R j, A j]_[𝓕] ↦ x i) :=
  (continuous_eval i).measurable

/-- Coercion from `Πʳ i, [R i, A i]_[𝓕]` to the full product `Π i, R i` is measurable for the
product σ-algebra whenever every factor `R i` is a Borel space. -/
@[fun_prop]
theorem measurable_coe [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)] :
    Measurable ((↑) : Πʳ i, [R i, A i]_[𝓕] → Π i, R i) :=
  measurable_pi_iff.mpr fun i ↦ measurable_eval i

/-- Filter inclusion `Πʳ i, [R i, A i]_[𝓖] → Πʳ i, [R i, A i]_[𝓕]` (`𝓕 ≤ 𝓖`) is measurable. -/
@[fun_prop]
theorem measurable_inclusion {𝓖 : Filter ι} (h : 𝓕 ≤ 𝓖) :
    Measurable (inclusion R A h) :=
  (continuous_inclusion h).measurable

/-- Over a countable index type with second-countable Borel reference subspaces `A i`,
`structureMap R A 𝓕` from `Π i, A i` into `Πʳ i, [R i, A i]_[𝓕]` is measurable. -/
@[fun_prop]
theorem measurable_structureMap [Countable ι] [∀ i, SecondCountableTopology (A i)]
    [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (A i)] :
    Measurable (structureMap R A 𝓕) :=
  isEmbedding_structureMap.continuous.measurable

/-- On a principal stage `Πʳ i, [R i, A i]_[𝓟 S]` over a countable index type with
second-countable Borel factors, the Borel σ-algebra is the pullback of the product σ-algebra. -/
theorem comap_coe_of_principal [Countable ι] [∀ i, SecondCountableTopology (R i)]
    [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)] {S : Set ι} :
    MeasurableSpace.pi.comap ((↑) : Πʳ i, [R i, A i]_[𝓟 S] → Π i, R i) =
      measurableSpace R A (𝓟 S) := by
  rw [BorelSpace.measurable_eq (α := Π i, R i), isEmbedding_coe_of_principal.isInducing.comap_borel]
  rfl

/-- A map into a principal stage `Πʳ i, [R i, A i]_[𝓟 S]` over a countable index type with
second-countable Borel factors is measurable if and only if all of its coordinate maps are
measurable. -/
theorem measurable_rng_of_principal [Countable ι] [∀ i, SecondCountableTopology (R i)]
    [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)] {S : Set ι} {X : Type*}
    [MeasurableSpace X] {f : X → Πʳ i, [R i, A i]_[𝓟 S]} :
    Measurable f ↔ ∀ i, Measurable (fun x ↦ f x i) := by
  rw [← isEmbedding_coe_of_principal.isInducing.measurable_comp_iff, measurable_pi_iff]
  rfl

end Basic

section MulSingle

variable {ι : Type*} [DecidableEq ι] {G : ι → Type*} {S : ι → Type*}
variable [∀ i, SetLike (S i) (G i)] [∀ i, One (G i)] [∀ i, OneMemClass (S i) (G i)]
variable [∀ i, TopologicalSpace (G i)]

/-- Inserting a single factor at `i` into `Πʳ j, [G j, B j]` is measurable whenever `G i` has
measurable open sets. -/
@[to_additive (attr := fun_prop)
  /-- Inserting a single additive factor at `i` into `Πʳ j, [G j, B j]` is measurable whenever
  `G i` has measurable open sets. -/]
theorem measurable_mulSingle (B : ∀ i, S i) (i : ι) [MeasurableSpace (G i)]
    [OpensMeasurableSpace (G i)] :
    Measurable (mulSingle B i) :=
  (TauCeti.continuous_restrictedProduct_mulSingle B i).measurable

end MulSingle

section Boxes

variable {ι : Type*} {R : ι → Type*} {A : ∀ i, Set (R i)}

/-- Over a countable index type, a coordinate box `box C` with measurable factors `C i` in Borel
spaces `R i` is measurable in `Πʳ i, [R i, A i]_[𝓕]` for every filter `𝓕` and arbitrary reference
sets `A i`. -/
theorem measurableSet_box [Countable ι] [∀ i, TopologicalSpace (R i)]
    [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)] {𝓕 : Filter ι} {C : ∀ i, Set (R i)}
    (hC : ∀ i, MeasurableSet (C i)) :
    MeasurableSet (box C : Set (Πʳ i, [R i, A i]_[𝓕])) := by
  rw [box_eq_iInter]
  exact MeasurableSet.iInter fun i ↦ (hC i).preimage (measurable_eval i)

/-- Over a countable index type with Borel factors, the range of `inclusion R A hS` for a principal
filter `𝓟 S` (`𝓕 ≤ 𝓟 S`) is measurable whenever `A i` is measurable for every `i ∈ S`. -/
theorem measurableSet_range_inclusion_principal [Countable ι] [∀ i, TopologicalSpace (R i)]
    [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)] {𝓕 : Filter ι} {S : Set ι}
    (hS : 𝓕 ≤ 𝓟 S) (hA : ∀ i ∈ S, MeasurableSet (A i)) :
    MeasurableSet (range (inclusion R A hS)) := by
  classical
  rw [range_inclusion_principal_eq_box S hS]
  refine measurableSet_box fun i ↦ ?_
  split_ifs with hi
  · exact hA i hi
  · exact MeasurableSet.univ

/-- Over a countable index type with Borel factors, the range of `structureMap R A 𝓕` (the integral
box `box A`) is measurable whenever every `A i` is measurable. -/
theorem measurableSet_range_structureMap [Countable ι] [∀ i, TopologicalSpace (R i)]
    [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)] {𝓕 : Filter ι}
    (hA : ∀ i, MeasurableSet (A i)) :
    MeasurableSet (range (structureMap R A 𝓕)) := by
  rw [range_structureMap_eq_box]
  exact measurableSet_box hA

/-- Over a countable index type with Borel factors, the inclusion of a principal stage
`Πʳ i, [R i, A i]_[𝓟 S]` into `Πʳ i, [R i, A i]_[𝓕]` (`𝓕 ≤ 𝓟 S`) is a measurable embedding
whenever `A i` is measurable for every `i ∈ S`. -/
theorem measurableEmbedding_inclusion_principal [Countable ι] [∀ i, TopologicalSpace (R i)]
    [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)] {𝓕 : Filter ι} {S : Set ι}
    (hS : 𝓕 ≤ 𝓟 S) (hA : ∀ i ∈ S, MeasurableSet (A i)) :
    MeasurableEmbedding (inclusion R A hS) :=
  (isEmbedding_inclusion_principal hS).measurableEmbedding
    (measurableSet_range_inclusion_principal hS hA)

/-- Over a countable index type with Borel factors and second-countable reference subspaces `A i`,
`structureMap R A 𝓕 : (Π i, A i) → Πʳ i, [R i, A i]_[𝓕]` is a measurable embedding whenever every
`A i` is measurable in `R i`. -/
theorem measurableEmbedding_structureMap [Countable ι] [∀ i, TopologicalSpace (R i)]
    [∀ i, SecondCountableTopology (A i)] [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)]
    {𝓕 : Filter ι} (hA : ∀ i, MeasurableSet (A i)) :
    MeasurableEmbedding (structureMap R A 𝓕) :=
  isEmbedding_structureMap.measurableEmbedding (measurableSet_range_structureMap hA)

/-- `openBoxes R A` is a π-system on `Πʳ i, [R i, A i]`. -/
theorem isPiSystem_openBoxes [∀ i, TopologicalSpace (R i)] :
    IsPiSystem (openBoxes R A) :=
  fun _ hs _ ht _ ↦ inter_mem_openBoxes hs ht

variable (R A) in
/-- Coordinate boxes `box C` in `Πʳ i, [R i, A i]` with measurable factors `C i` satisfying
`C i = A i` for cofinitely many `i`. -/
def cofiniteMeasurableBoxes [∀ i, MeasurableSpace (R i)] : Set (Set (Πʳ i, [R i, A i])) :=
  {s | ∃ C : ∀ i, Set (R i),
    (∀ i, MeasurableSet (C i)) ∧ (∀ᶠ i in cofinite, C i = A i) ∧ s = box C}

/-- Membership in `cofiniteMeasurableBoxes R A`. -/
@[simp]
theorem mem_cofiniteMeasurableBoxes_iff [∀ i, MeasurableSpace (R i)]
    {s : Set (Πʳ i, [R i, A i])} :
    s ∈ cofiniteMeasurableBoxes R A ↔
      ∃ C : ∀ i, Set (R i),
        (∀ i, MeasurableSet (C i)) ∧ (∀ᶠ i in cofinite, C i = A i) ∧ s = box C :=
  Iff.rfl

/-- `cofiniteMeasurableBoxes R A` is a π-system on `Πʳ i, [R i, A i]`. -/
theorem isPiSystem_cofiniteMeasurableBoxes [∀ i, MeasurableSpace (R i)] :
    IsPiSystem (cofiniteMeasurableBoxes R A) := by
  rintro _ ⟨C, hC, hCA, rfl⟩ _ ⟨D, hD, hDA, rfl⟩ _
  refine ⟨fun i ↦ C i ∩ D i, fun i ↦ (hC i).inter (hD i), ?_, (box_inter C D).symm⟩
  exact (hCA.and hDA).mono fun i ⟨hiC, hiD⟩ ↦ by simp [hiC, hiD]

variable (R A) in
/-- All coordinate boxes `box C` in `Πʳ i, [R i, A i]` with measurable factors `C i`. -/
def measurableBoxes [∀ i, MeasurableSpace (R i)] : Set (Set (Πʳ i, [R i, A i])) :=
  {s | ∃ C : ∀ i, Set (R i), (∀ i, MeasurableSet (C i)) ∧ s = box C}

/-- Membership in `measurableBoxes R A`. -/
@[simp]
theorem mem_measurableBoxes_iff [∀ i, MeasurableSpace (R i)] {s : Set (Πʳ i, [R i, A i])} :
    s ∈ measurableBoxes R A ↔ ∃ C : ∀ i, Set (R i), (∀ i, MeasurableSet (C i)) ∧ s = box C :=
  Iff.rfl

/-- `measurableBoxes R A` is a π-system on `Πʳ i, [R i, A i]`. -/
theorem isPiSystem_measurableBoxes [∀ i, MeasurableSpace (R i)] :
    IsPiSystem (measurableBoxes R A) := by
  rintro _ ⟨C, hC, rfl⟩ _ ⟨D, hD, rfl⟩ _
  exact ⟨fun i ↦ C i ∩ D i, fun i ↦ (hC i).inter (hD i), (box_inter C D).symm⟩

/-- Every open cofinitely-`A i` box is a cofinitely-`A i` measurable box when open sets are
measurable in each factor. -/
theorem openBoxes_subset_cofiniteMeasurableBoxes [∀ i, TopologicalSpace (R i)]
    [∀ i, MeasurableSpace (R i)] [∀ i, OpensMeasurableSpace (R i)] :
    openBoxes R A ⊆ cofiniteMeasurableBoxes R A := by
  intro _ hs
  obtain ⟨C, hC, hCA, rfl⟩ := mem_openBoxes_iff.mp hs
  exact ⟨C, fun i ↦ (hC i).measurableSet, hCA, rfl⟩

/-- Every cofinitely-`A i` measurable box belongs to `measurableBoxes R A`. -/
theorem cofiniteMeasurableBoxes_subset_measurableBoxes [∀ i, MeasurableSpace (R i)] :
    cofiniteMeasurableBoxes R A ⊆ measurableBoxes R A := by
  rintro _ ⟨C, hC, -, rfl⟩
  exact ⟨C, hC, rfl⟩

/-- Over a countable index type with second-countable factors and `A i` cofinitely open, the Borel
σ-algebra of `Πʳ i, [R i, A i]` is generated by `openBoxes R A`. -/
theorem borel_eq_generateFrom_openBoxes [Countable ι] [∀ i, TopologicalSpace (R i)]
    [∀ i, SecondCountableTopology (R i)] (hA : ∀ᶠ i in cofinite, IsOpen (A i)) :
    measurableSpace R A cofinite = MeasurableSpace.generateFrom (openBoxes R A) := by
  have := secondCountableTopology_of_cofinite (R := R) hA
  exact (isTopologicalBasis_openBoxes hA).borel_eq_generateFrom

/-- Over a countable index type with second-countable Borel factors, the Borel σ-algebra of
`Πʳ i, [R i, A i]` equals the pullback of the product σ-algebra along the coercion
`(↑) : Πʳ i, [R i, A i] → Π i, R i`, with no openness or measurability assumption on `A i`. -/
theorem comap_coe_eq_measurableSpace [Countable ι] [∀ i, TopologicalSpace (R i)]
    [∀ i, SecondCountableTopology (R i)] [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)] :
    MeasurableSpace.pi.comap ((↑) : Πʳ i, [R i, A i] → Π i, R i) =
      measurableSpace R A cofinite := by
  apply le_antisymm measurable_coe.comap_le
  obtain ⟨e, he⟩ := exists_injective_nat ι
  let S : ℕ → Set ι := fun n ↦ {i | n ≤ e i}
  have hS : ∀ n : ℕ, cofinite ≤ 𝓟 (S n) := fun n ↦ le_principal_iff.mpr <| mem_cofinite.mpr <|
    ((Finset.range n).finite_toSet.preimage he.injOn).subset fun i hi ↦ by
      simp only [S, mem_compl_iff, mem_ofPred_eq, not_le] at hi
      simpa using hi
  refine MeasurableSpace.generateFrom_le fun U hU ↦ ?_
  have hex : ∀ n : ℕ, ∃ W : Set (Π i, R i), MeasurableSet W ∧
      ((↑) : Πʳ i, [R i, A i]_[𝓟 (S n)] → Π i, R i) ⁻¹' W = inclusion R A (hS n) ⁻¹' U := by
    intro n
    rw [← MeasurableSpace.measurableSet_comap, comap_coe_of_principal]
    exact (hU.preimage (continuous_inclusion (hS n))).measurableSet
  choose W hWm hW using hex
  refine ⟨⋂ m : ℕ, ⋃ (n : ℕ) (_ : m ≤ n), W n,
    MeasurableSet.iInter fun m ↦ MeasurableSet.iUnion fun n ↦
      MeasurableSet.iUnion fun _ ↦ hWm n, ?_⟩
  ext x
  have hfin : (e '' {i | x i ∉ A i}).Finite := (mem_cofinite.mp x.2).image e
  let m₀ : ℕ := hfin.toFinset.sup id + 1
  have hm₀ : ∀ n ≥ m₀, (x : Π i, R i) ∈ W n ↔ x ∈ U := fun n hn ↦ by
    have hxS : ∀ᶠ i in 𝓟 (S n), x i ∈ A i := eventually_principal.mpr fun i hi ↦ by
      by_contra hxA
      have hle : e i ≤ hfin.toFinset.sup id :=
        Finset.le_sup (f := id) (hfin.mem_toFinset.mpr ⟨i, hxA, rfl⟩)
      have hni : n ≤ e i := hi
      omega
    obtain ⟨x', hx'⟩ := exists_inclusion_eq_of_eventually R A (hS n) hxS
    have hcoe : (x' : Π i, R i) = (x : Π i, R i) := DFunLike.coe_fn_eq.mpr hx'
    rw [← hcoe, ← mem_preimage, hW n, mem_preimage, hx']
  simp only [mem_preimage, mem_iInter, mem_iUnion, exists_prop]
  exact ⟨fun h ↦ (hm₀ _ (h m₀).choose_spec.1).mp (h m₀).choose_spec.2,
    fun hxU m ↦ ⟨max m m₀, le_max_left _ _, (hm₀ _ (le_max_right _ _)).mpr hxU⟩⟩

/-- Over a countable index type with second-countable Borel factors, a map `f` into
`Πʳ i, [R i, A i]` is measurable if and only if each coordinate `x ↦ f x i` is measurable, with no
openness or measurability assumption on `A i`. -/
theorem measurable_rng_iff [Countable ι] [∀ i, TopologicalSpace (R i)]
    [∀ i, SecondCountableTopology (R i)] [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)]
    {X : Type*} [MeasurableSpace X] {f : X → Πʳ i, [R i, A i]} :
    Measurable f ↔ ∀ i, Measurable (fun x ↦ f x i) := by
  rw [measurable_iff_comap_le, ← comap_coe_eq_measurableSpace, MeasurableSpace.comap_comp,
    ← measurable_iff_comap_le, measurable_pi_iff]
  rfl

/-- Over a countable index type with second-countable Borel factors, the Borel σ-algebra of
`Πʳ i, [R i, A i]` is generated by `measurableBoxes R A`, with no openness or measurability
assumption on `A i`. -/
theorem borel_eq_generateFrom_measurableBoxes [Countable ι] [∀ i, TopologicalSpace (R i)]
    [∀ i, SecondCountableTopology (R i)] [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)] :
    measurableSpace R A cofinite = MeasurableSpace.generateFrom (measurableBoxes R A) := by
  classical
  apply le_antisymm
  · rw [← comap_coe_eq_measurableSpace, MeasurableSpace.pi, MeasurableSpace.comap_iSup]
    refine iSup_le fun i ↦ ?_
    rw [MeasurableSpace.comap_comp]
    rintro _ ⟨B, hB, rfl⟩
    refine MeasurableSpace.measurableSet_generateFrom
      ⟨Function.update (fun _ ↦ univ) i B, fun j ↦ ?_, ?_⟩
    · rcases eq_or_ne j i with rfl | hji
      · simpa using hB
      · simp [hji]
    · ext x
      simp only [Function.comp_apply, mem_preimage, mem_box]
      refine ⟨fun hx j ↦ ?_, fun hx ↦ by simpa using hx i⟩
      rcases eq_or_ne j i with rfl | hji
      · simpa using hx
      · simp [hji]
  · refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨C, hC, rfl⟩
    exact measurableSet_box hC

private theorem preimage_coe_univ_pi_inter_measurableSet_generateFrom
    [∀ i, MeasurableSpace (R i)] {C₀ : ∀ i, Set (R i)}
    (hC₀m : ∀ i, MeasurableSet (C₀ i)) (hC₀A : ∀ᶠ i in cofinite, C₀ i = A i)
    {T : Set (Π i, R i)} (hT : MeasurableSet T) :
    @MeasurableSet (Πʳ i, [R i, A i])
      (MeasurableSpace.generateFrom (cofiniteMeasurableBoxes R A))
      (((↑) : Πʳ i, [R i, A i] → Π i, R i) ⁻¹' (univ.pi C₀ ∩ T)) := by
  classical
  have hM : @MeasurableSet (Πʳ i, [R i, A i])
      (MeasurableSpace.generateFrom (cofiniteMeasurableBoxes R A))
      (((↑) : Πʳ i, [R i, A i] → Π i, R i) ⁻¹' univ.pi C₀) :=
    preimage_coe_univ_pi C₀ ▸ MeasurableSpace.measurableSet_generateFrom ⟨C₀, hC₀m, hC₀A, rfl⟩
  let 𝓜 : MeasurableSpace (Π i, R i) :=
    { MeasurableSet' := fun Q ↦ @MeasurableSet (Πʳ i, [R i, A i])
        (MeasurableSpace.generateFrom (cofiniteMeasurableBoxes R A))
        (((↑) : Πʳ i, [R i, A i] → Π i, R i) ⁻¹' (univ.pi C₀ ∩ Q))
      measurableSet_empty := by simp
      measurableSet_compl := fun Q hQ ↦ by
        have hdiff : ((↑) : Πʳ i, [R i, A i] → Π i, R i) ⁻¹' (univ.pi C₀ ∩ Qᶜ) =
            ((↑) ⁻¹' univ.pi C₀) \ ((↑) ⁻¹' (univ.pi C₀ ∩ Q)) := by
          ext; exact ⟨fun ⟨h1, h2⟩ ↦ ⟨h1, fun ⟨_, h3⟩ ↦ h2 h3⟩,
            fun ⟨h1, h2⟩ ↦ ⟨h1, fun h3 ↦ h2 ⟨h1, h3⟩⟩⟩
        exact hdiff ▸ hM.diff hQ
      measurableSet_iUnion := fun f hf ↦ by
        have hunion : ((↑) : Πʳ i, [R i, A i] → Π i, R i) ⁻¹' (univ.pi C₀ ∩ ⋃ n, f n) =
            ⋃ n, (↑) ⁻¹' (univ.pi C₀ ∩ f n) := by ext; simp [inter_iUnion]
        exact hunion ▸ @MeasurableSet.iUnion _ _
          (MeasurableSpace.generateFrom (cofiniteMeasurableBoxes R A)) _ _ hf }
  refine (iSup_le fun i₀ ↦ ?_ : MeasurableSpace.pi ≤ 𝓜) _ hT
  rintro _ ⟨B, hB, rfl⟩
  change @MeasurableSet _ (MeasurableSpace.generateFrom (cofiniteMeasurableBoxes R A)) _
  have heq : univ.pi C₀ ∩ (fun z : Π i, R i ↦ z i₀) ⁻¹' B =
      univ.pi (Function.update C₀ i₀ (C₀ i₀ ∩ B)) := by
    ext z; simp only [mem_inter_iff, mem_univ_pi, mem_preimage]
    refine ⟨fun ⟨hz, hB₀⟩ i ↦ ?_, fun hz ↦ ⟨fun i ↦ ?_, (by simpa using hz i₀ : _ ∈ _ ∩ B).2⟩⟩
    · rcases eq_or_ne i i₀ with rfl | hi <;> [simpa using ⟨hz i, hB₀⟩; simpa [hi] using hz i]
    · rcases eq_or_ne i i₀ with rfl | hi
      · exact (by simpa using hz i : z i ∈ C₀ i ∩ B).1
      · simpa [hi] using hz i
  rw [heq, preimage_coe_univ_pi]
  refine MeasurableSpace.measurableSet_generateFrom ⟨_, fun i ↦ ?_, ?_, rfl⟩
  · rcases eq_or_ne i i₀ with rfl | hi <;> [simpa using (hC₀m i).inter hB; simpa [hi] using hC₀m i]
  · refine (hC₀A.and (Set.finite_singleton i₀).compl_mem_cofinite).mono fun i ⟨hiA, hi⟩ ↦ ?_
    have hi' : i ≠ i₀ := hi
    simpa [hi'] using hiA

/-- Over a countable index type with second-countable Borel factors and `A i` cofinitely
measurable, the Borel σ-algebra of `Πʳ i, [R i, A i]` is generated by
`cofiniteMeasurableBoxes R A`. -/
theorem borel_eq_generateFrom_cofiniteMeasurableBoxes [Countable ι] [∀ i, TopologicalSpace (R i)]
    [∀ i, SecondCountableTopology (R i)] [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)]
    (hA : ∀ᶠ i in cofinite, MeasurableSet (A i)) :
    measurableSpace R A cofinite = MeasurableSpace.generateFrom (cofiniteMeasurableBoxes R A) := by
  classical
  apply le_antisymm
  · rw [← comap_coe_eq_measurableSpace]
    rintro _ ⟨T, hT, rfl⟩
    let S₀ : Finset ι := (mem_cofinite.mp hA).toFinset
    have hcov : ((↑) : Πʳ i, [R i, A i] → Π i, R i) ⁻¹' T =
        ⋃ E : Finset ι, ((↑) : Πʳ i, [R i, A i] → Π i, R i) ⁻¹'
          (univ.pi (fun i ↦ if i ∈ S₀ ∪ E then univ else A i) ∩ T) := by
      ext x
      simp only [mem_preimage, mem_iUnion, mem_inter_iff, mem_univ_pi]
      refine ⟨fun hxT ↦ ⟨(mem_cofinite.mp x.2).toFinset, fun i ↦ ?_, hxT⟩,
        fun ⟨_, _, hxT⟩ ↦ hxT⟩
      split_ifs with hi
      · exact mem_univ _
      · by_contra hxA
        exact hi (Finset.mem_union_right _ ((mem_cofinite.mp x.2).mem_toFinset.mpr hxA))
    rw [hcov]
    refine @MeasurableSet.iUnion _ _
      (MeasurableSpace.generateFrom (cofiniteMeasurableBoxes R A)) _ _ fun E ↦
        preimage_coe_univ_pi_inter_measurableSet_generateFrom (fun i ↦ ?_) ?_ hT
    · split_ifs with hi
      · exact MeasurableSet.univ
      · by_contra hnot
        exact hi (Finset.mem_union_left _ ((mem_cofinite.mp hA).mem_toFinset.mpr hnot))
    · refine mem_cofinite.mpr ((S₀ ∪ E).finite_toSet.subset fun i hi ↦ ?_)
      rw [Finset.mem_coe]
      by_contra hiE
      exact hi (ite_eq_right_iff.mpr fun h ↦ absurd h hiE)
  · refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨C, hC, -, rfl⟩
    exact measurableSet_box hC

/-- Over a countable index type, the range of `(↑) : Πʳ i, [R i, A i] → Π i, R i` is measurable in
the product σ-algebra whenever `A i` is measurable for cofinitely many `i`. -/
theorem measurableSet_range_coe [Countable ι] [∀ i, MeasurableSpace (R i)]
    (hA : ∀ᶠ i in cofinite, MeasurableSet (A i)) :
    MeasurableSet (range ((↑) : Πʳ i, [R i, A i] → Π i, R i)) := by
  classical
  let S₀ : Finset ι := (mem_cofinite.mp hA).toFinset
  have hcov : range ((↑) : Πʳ i, [R i, A i] → Π i, R i) =
      ⋃ F : Finset ι, univ.pi (fun i ↦ if i ∈ S₀ ∪ F then univ else A i) := by
    ext x
    simp only [mem_range, mem_iUnion, mem_univ_pi]
    refine ⟨fun ⟨y, hy⟩ ↦ ?_, fun ⟨F, hF⟩ ↦ ?_⟩
    · have hfin : {i | y i ∉ A i}.Finite := mem_cofinite.mp y.2
      refine ⟨hfin.toFinset, fun i ↦ ?_⟩
      split_ifs with hi
      · exact mem_univ _
      · rw [← hy]
        by_contra hnot
        exact hi (Finset.mem_union_right _ (hfin.mem_toFinset.mpr hnot))
    · refine ⟨⟨x, mem_cofinite.mpr ((S₀ ∪ F).finite_toSet.subset fun i hi ↦ ?_)⟩, rfl⟩
      rw [Finset.mem_coe]
      by_contra hiF
      exact hi (by simpa [hiF] using hF i)
  rw [hcov]
  refine MeasurableSet.iUnion fun F ↦ MeasurableSet.univ_pi fun i ↦ ?_
  split_ifs with hi
  · exact MeasurableSet.univ
  · by_contra hnot
    exact hi (Finset.mem_union_left _ ((mem_cofinite.mp hA).mem_toFinset.mpr hnot))

/-- Over a countable index type with second-countable Borel factors, `(↑) : Πʳ i, [R i, A i] →
Π i, R i` is a measurable embedding whenever `A i` is measurable for cofinitely many `i`. -/
theorem measurableEmbedding_coe [Countable ι] [∀ i, TopologicalSpace (R i)]
    [∀ i, SecondCountableTopology (R i)] [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)]
    (hA : ∀ᶠ i in cofinite, MeasurableSet (A i)) :
    MeasurableEmbedding ((↑) : Πʳ i, [R i, A i] → Π i, R i) where
  injective := DFunLike.coe_injective
  measurable := measurable_coe
  measurableSet_image' s hs := by
    obtain ⟨t, ht, rfl⟩ := (comap_coe_eq_measurableSpace (R := R) (A := A)).symm ▸ hs
    rw [image_preimage_eq_inter_range]
    exact ht.inter (measurableSet_range_coe hA)

end Boxes

end RestrictedProduct

namespace TauCeti

section IntegralSubgroups

variable {ι : Type*} {G : ι → Type*} [∀ i, Group (G i)]

/-- As a subset of `Πʳ i, [G i, U i]`, `integralSubgroupOf U V` is the coordinate box of `V`. -/
@[to_additive
  /-- As a subset of `Πʳ i, [G i, U i]`, `integralAddSubgroupOf U V` is the coordinate box of
  `V`. -/]
theorem coe_integralSubgroupOf_eq_box (U V : ∀ i, Subgroup (G i)) :
    (integralSubgroupOf U V : Set (Πʳ i, [G i, (U i : Set (G i))])) =
      RestrictedProduct.box (fun i ↦ (V i : Set (G i))) := by
  ext x
  simp

/-- As a subset of `Πʳ i, [G i, U i]`, `integralSubgroup U` is the coordinate box of `U`. -/
@[to_additive
  /-- As a subset of `Πʳ i, [G i, U i]`, `integralAddSubgroup U` is the coordinate box of
  `U`. -/]
theorem coe_integralSubgroup_eq_box (U : ∀ i, Subgroup (G i)) :
    (integralSubgroup U : Set (Πʳ i, [G i, (U i : Set (G i))])) =
      RestrictedProduct.box (fun i ↦ (U i : Set (G i))) := by
  ext x
  simp

/-- Any open level subgroup `integralSubgroupOf U V` (with `V i` open and `U i ≤ V i` cofinitely)
is Borel measurable in `Πʳ i, [G i, U i]`, with no countability assumption on `ι`. -/
@[to_additive
  /-- Any open level additive subgroup `integralAddSubgroupOf U V` (with `V i` open and
  `U i ≤ V i` cofinitely) is Borel measurable in `Πʳ i, [G i, U i]`, with no countability
  assumption on `ι`. -/]
theorem measurableSet_integralSubgroupOf_of_eventually_le [∀ i, TopologicalSpace (G i)]
    (U V : ∀ i, Subgroup (G i)) (hV : ∀ i, IsOpen (V i : Set (G i)))
    (hUV : ∀ᶠ i in cofinite, U i ≤ V i) :
    MeasurableSet (integralSubgroupOf U V : Set (Πʳ i, [G i, (U i : Set (G i))])) :=
  (isOpen_integralSubgroupOf_of_eventually_le U V hV hUV).measurableSet

/-- Over a countable index type with Borel factors, `integralSubgroupOf U V` is measurable whenever
every `V i` is Borel measurable, with no openness or cofinite-inclusion hypothesis. -/
@[to_additive
  /-- Over a countable index type with Borel factors, `integralAddSubgroupOf U V` is measurable
  whenever every `V i` is Borel measurable, with no openness or cofinite-inclusion hypothesis. -/]
theorem measurableSet_integralSubgroupOf [Countable ι] [∀ i, TopologicalSpace (G i)]
    [∀ i, MeasurableSpace (G i)] [∀ i, BorelSpace (G i)] (U V : ∀ i, Subgroup (G i))
    (hV : ∀ i, MeasurableSet (V i : Set (G i))) :
    MeasurableSet (integralSubgroupOf U V : Set (Πʳ i, [G i, (U i : Set (G i))])) := by
  rw [coe_integralSubgroupOf_eq_box]
  exact RestrictedProduct.measurableSet_box hV

/-- Over a countable index type with Borel factors, `integralSubgroup U` is measurable whenever
every `U i` is Borel measurable. -/
@[to_additive
  /-- Over a countable index type with Borel factors, `integralAddSubgroup U` is measurable
  whenever every `U i` is Borel measurable. -/]
theorem measurableSet_integralSubgroup [Countable ι] [∀ i, TopologicalSpace (G i)]
    [∀ i, MeasurableSpace (G i)] [∀ i, BorelSpace (G i)] (U : ∀ i, Subgroup (G i))
    (hU : ∀ i, MeasurableSet (U i : Set (G i))) :
    MeasurableSet (integralSubgroup U : Set (Πʳ i, [G i, (U i : Set (G i))])) := by
  rw [← integralSubgroupOf_self]
  exact measurableSet_integralSubgroupOf U U hU

end IntegralSubgroups

section ZMod4Example

/-- The index-2 additive subgroup `2ℤ/4 = {0, 2}` of `ZMod 4`, used to illustrate singletons and
coset σ-algebras in `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]`. -/
abbrev twoZMod4 : AddSubgroup (ZMod 4) :=
  AddSubgroup.zmultiples (2 : ZMod 4)

/-- In `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]`, the singleton `{0}` is the countable intersection of the open
cofinitely-`2ℤ/4` boxes imposing `x k = 0` for `k < n` and `x k ∈ 2ℤ/4` for `k ≥ n`. -/
theorem singleton_zero_eq_iInter_openBox_zmod4 :
    ({(0 : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])} :
        Set (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])) =
      ⋂ n : ℕ, RestrictedProduct.box
        (fun k ↦ if k < n then ({0} : Set (ZMod 4)) else (twoZMod4 : Set (ZMod 4))) := by
  ext x
  simp only [mem_singleton_iff, mem_iInter, RestrictedProduct.mem_box]
  refine ⟨fun hx n k ↦ ?_, fun hx ↦ ?_⟩
  · subst hx
    split_ifs
    · exact mem_singleton 0
    · exact zero_mem twoZMod4
  · ext k
    exact mem_singleton_iff.mp (by simpa using hx (k + 1) k)

/-- Each approximating box in `singleton_zero_eq_iInter_openBox_zmod4` belongs to
`RestrictedProduct.openBoxes`. -/
theorem approx_mem_openBoxes_zmod4 (n : ℕ) :
    (RestrictedProduct.box
        (fun k ↦ if k < n then ({0} : Set (ZMod 4)) else (twoZMod4 : Set (ZMod 4))) :
      Set (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])) ∈
        RestrictedProduct.openBoxes (fun _ : ℕ ↦ ZMod 4)
          (fun _ : ℕ ↦ (twoZMod4 : Set (ZMod 4))) := by
  rw [RestrictedProduct.mem_openBoxes_iff]
  refine ⟨_, fun _ ↦ isOpen_discrete _, ?_, rfl⟩
  refine mem_cofinite.mpr ((Finset.range n).finite_toSet.subset fun k hk ↦ ?_)
  rw [Finset.mem_coe, Finset.mem_range]
  by_contra hnot
  exact hk (by simp [hnot])

/-- The singleton `{0}` in `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]` is Borel measurable. -/
theorem measurableSet_singleton_zero_zmod4 :
    MeasurableSet ({(0 : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])} :
      Set (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])) := by
  rw [singleton_zero_eq_iInter_openBox_zmod4]
  exact MeasurableSet.iInter fun n ↦
    (RestrictedProduct.isOpen_of_mem_openBoxes (approx_mem_openBoxes_zmod4 n)).measurableSet

/-- The singleton `{0}` in `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]` is not equal to any coordinate box `box C`
whose factors satisfy `C k = 2ℤ/4` for cofinitely many `k`. -/
theorem not_exists_eventually_eq_box_singleton_zero_zmod4 :
    ¬ ∃ C : ℕ → Set (ZMod 4),
      (∀ᶠ k in cofinite, C k = (twoZMod4 : Set (ZMod 4))) ∧
        ({(0 : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])} :
          Set (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])) = RestrictedProduct.box C := by
  rintro ⟨C, hC, heq⟩
  obtain ⟨k, hk⟩ := (hC.frequently).exists
  have h0C : ∀ j, (0 : ZMod 4) ∈ C j :=
    RestrictedProduct.mem_box.mp (heq ▸ mem_singleton _)
  let z : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))] :=
    RestrictedProduct.single (fun _ ↦ twoZMod4) k (2 : ZMod 4)
  have hzC : z ∈ RestrictedProduct.box C := RestrictedProduct.mem_box.mpr fun j ↦ by
    rcases eq_or_ne j k with rfl | hjk
    · rw [hk, RestrictedProduct.single_eq_same]
      exact AddSubgroup.mem_zmultiples (2 : ZMod 4)
    · rw [RestrictedProduct.single_eq_of_ne _ _ hjk]
      exact h0C j
  have hz0 : z = 0 := mem_singleton_iff.mp (heq.symm ▸ hzC)
  have h20 : (2 : ZMod 4) = 0 := by
    simpa [z, RestrictedProduct.single_eq_same] using congr_arg (· k) hz0
  exact absurd h20 (by decide)

/-- The singleton `{0}` is not open in `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]`. -/
theorem not_isOpen_singleton_zero_zmod4 :
    ¬ IsOpen ({(0 : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])} :
      Set (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])) := by
  intro hopen
  obtain ⟨C, h0C, -, hCA, hsub⟩ :=
    RestrictedProduct.exists_open_box_subset_of_isOpen
      (.of_forall fun _ ↦ isOpen_discrete _) (mem_singleton _) hopen
  refine not_exists_eventually_eq_box_singleton_zero_zmod4 ⟨C, hCA, ?_⟩
  exact Subset.antisymm (singleton_subset_iff.mpr (RestrictedProduct.mem_box.mpr h0C)) hsub

/-- In `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]`, the Borel set `{0}` does not belong to the σ-algebra generated
by all cofinite principal stages `range (inclusion _ _ hS)` (`cofinite ≤ 𝓟 S`) and their additive
cosets: the constant sequence `(2, 2, …)` lies in every principal stage, so `0` and `(2, 2, …)`
are inseparable by that σ-algebra. -/
theorem not_measurableSet_singleton_zero_generateFrom_cosets_zmod4 :
    ¬ @MeasurableSet (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])
      (MeasurableSpace.generateFrom
        {s | ∃ (S : Set ℕ) (hS : cofinite ≤ 𝓟 S)
          (g : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))]),
          s = (g + ·) '' range (RestrictedProduct.inclusion _ _ hS)})
      {0} := by
  let Y := Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))]
  let c₂ : Y := ⟨fun _ ↦ 2, .of_forall fun _ ↦ AddSubgroup.mem_zmultiples (2 : ZMod 4)⟩
  let M : MeasurableSpace Y :=
    { MeasurableSet' := fun t ↦ (0 : Y) ∈ t ↔ c₂ ∈ t
      measurableSet_empty := Iff.rfl
      measurableSet_compl := fun _ h ↦ not_congr h
      measurableSet_iUnion := fun f hf ↦ by
        simp only [mem_iUnion]
        exact exists_congr hf }
  have hle : MeasurableSpace.generateFrom
      {s : Set Y | ∃ (S : Set ℕ) (hS : cofinite ≤ 𝓟 S) (g : Y),
        s = (g + ·) '' range (RestrictedProduct.inclusion _ _ hS)} ≤ M := by
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨S, hS, g, rfl⟩
    change (0 : Y) ∈ (g + ·) '' range (RestrictedProduct.inclusion _ _ hS) ↔
      c₂ ∈ (g + ·) '' range (RestrictedProduct.inclusion _ _ hS)
    have hshift : ∀ x y : Y, y - x = c₂ ∨ x - y = c₂ →
        x ∈ (g + ·) '' range (RestrictedProduct.inclusion _ _ hS) →
        y ∈ (g + ·) '' range (RestrictedProduct.inclusion _ _ hS) := by
      rintro x y hxy ⟨w, ⟨z, rfl⟩, rfl⟩
      refine ⟨_, ⟨⟨fun k ↦ z k + 2, z.2.mono fun k hk ↦
        twoZMod4.add_mem hk (AddSubgroup.mem_zmultiples 2)⟩, rfl⟩, ?_⟩
      ext k
      rcases hxy with hxy | hxy
      · have hk : y k - (g k + z k) = 2 := congr_arg (· k) hxy
        calc g k + (z k + 2) = (g k + z k) + (y k - (g k + z k)) := by rw [hk]; ring
        _ = y k := by ring
      · have hk : (g k + z k) - y k = 2 := congr_arg (· k) hxy
        have h22 : (2 : ZMod 4) + 2 = 0 := by decide
        calc g k + (z k + 2) = ((g k + z k) - y k + 2) + y k := by ring
        _ = y k := by rw [hk, h22, zero_add]
    exact ⟨hshift 0 c₂ (Or.inl (sub_zero c₂)), hshift c₂ 0 (Or.inr (sub_zero c₂))⟩
  intro h0
  have hmem : (0 : Y) ∈ ({0} : Set Y) ↔ c₂ ∈ ({0} : Set Y) := hle {0} h0
  have hc₂ : c₂ = 0 := mem_singleton_iff.mp (hmem.mp (mem_singleton 0))
  have h20 : (2 : ZMod 4) = 0 := congr_arg (· 0) hc₂
  exact absurd h20 (by decide)

end ZMod4Example

end TauCeti
