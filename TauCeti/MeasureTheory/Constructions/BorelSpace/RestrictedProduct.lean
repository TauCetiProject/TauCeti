module

public import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic
public import TauCeti.Topology.Algebra.RestrictedProduct.Principal
import Mathlib.Logic.Equiv.List

/-!
# The Borel σ-algebra of a restricted product

Even when all factors are discrete and second countable, the coercion
`((↑) : Πʳ i, [R i, A i] → ∀ i, R i)` from a cofinite restricted product to the full product need
not be a topological embedding (`TauCeti.not_isInducing_coe_bot`). Measurably, however, the
situation is rigid over a countable index type with second-countable factors and cofinitely open
reference sets `A i`:

* The open coordinate boxes agreeing cofinitely with `A i` form a π-system
  (`isPiSystem_openRestrictedProductBoxes`) that generates the Borel σ-algebra of
  `Πʳ i, [R i, A i]` (`borel_restrictedProduct_eq_generateFrom_openBoxes`,
  `measurableSpace_restrictedProduct_eq_generateFrom_openBoxes`).
* Because each open box is the preimage under `(↑)` of a countable cylinder `Set.univ.pi C`, the
  Borel σ-algebra of `Πʳ i, [R i, A i]` coincides with the pullback of `borel (∀ i, R i)` along
  `(↑)` (`comap_coe_borel_restrictedProduct`), and `(↑)` is a Borel `MeasurableEmbedding` into
  `∀ i, R i` (`measurableEmbedding_restrictedProduct_coe`). Neither statement requires any
  assumption on `A i` at the finitely many exceptional indices.

We also record measurable-embedding criteria for principal-stage coercions
(`measurableEmbedding_restrictedProduct_coe_principal`) and principal-stage inclusions
(`measurableEmbedding_restrictedProduct_inclusion_principal`), together with Borel measurability of
coordinate boxes (`measurableSet_restrictedProductBox`,
`measurableSet_restrictedProductBox_of_countable`).
-/

public section

namespace TauCeti

open Filter MeasureTheory Set Topology
open scoped RestrictedProduct

universe u v

section OpenBoxes

variable {ι : Type u} {R : ι → Type v} [∀ i, TopologicalSpace (R i)]

/-- The open coordinate boxes agreeing cofinitely with `A i` form a π-system on
`Πʳ i, [R i, A i]`. -/
theorem isPiSystem_openRestrictedProductBoxes (A : ∀ i, Set (R i)) :
    IsPiSystem (openRestrictedProductBoxes A) := by
  intro B₁ hB₁ B₂ hB₂ _
  obtain ⟨C₁, hC₁, hCA₁, rfl⟩ := mem_openRestrictedProductBoxes.mp hB₁
  obtain ⟨C₂, hC₂, hCA₂, rfl⟩ := mem_openRestrictedProductBoxes.mp hB₂
  refine mem_openRestrictedProductBoxes.mpr
    ⟨fun i ↦ C₁ i ∩ C₂ i, fun i ↦ (hC₁ i).inter (hC₂ i), ?_,
      restrictedProductBox_inter A cofinite C₁ C₂⟩
  filter_upwards [hCA₁, hCA₂] with i h₁ h₂
  simp [h₁, h₂]

/-- Over a countable index type with second-countable factors, if cofinitely many reference sets
`A i` are open, the Borel σ-algebra of `Πʳ i, [R i, A i]` is generated by
`openRestrictedProductBoxes A`. -/
theorem borel_restrictedProduct_eq_generateFrom_openBoxes
    [Countable ι] [∀ i, SecondCountableTopology (R i)]
    {A : ∀ i, Set (R i)} (hA : ∀ᶠ i in cofinite, IsOpen (A i)) :
    borel (Πʳ i, [R i, A i]) = MeasurableSpace.generateFrom (openRestrictedProductBoxes A) := by
  have := secondCountableTopology_restrictedProduct hA
  exact (isTopologicalBasis_openRestrictedProductBoxes hA).borel_eq_generateFrom

/-- Over a countable index type with second-countable factors, if cofinitely many reference sets
`A i` are open, any `BorelSpace` measurable structure on `Πʳ i, [R i, A i]` is generated by
`openRestrictedProductBoxes A`. -/
theorem measurableSpace_restrictedProduct_eq_generateFrom_openBoxes
    [Countable ι] [∀ i, SecondCountableTopology (R i)]
    {A : ∀ i, Set (R i)} [m : MeasurableSpace (Πʳ i, [R i, A i])]
    [BorelSpace (Πʳ i, [R i, A i])] (hA : ∀ᶠ i in cofinite, IsOpen (A i)) :
    m = MeasurableSpace.generateFrom (openRestrictedProductBoxes A) :=
  BorelSpace.measurable_eq.trans (borel_restrictedProduct_eq_generateFrom_openBoxes hA)

end OpenBoxes

section Embeddings

variable {ι : Type u} {R : ι → Type v}

/-- For a cofinite set `S` (`cofinite ≤ 𝓟 S`), the canonical inclusion of the principal stage
`Πʳ i, [R i, A i]_[𝓟 S]` into `Πʳ i, [R i, A i]` is a measurable embedding between Borel spaces
whenever `A i` is open for every `i ∈ S`. -/
theorem measurableEmbedding_restrictedProduct_inclusion_principal
    [∀ i, TopologicalSpace (R i)] {A : ∀ i, Set (R i)} {S : Set ι}
    [MeasurableSpace (Πʳ i, [R i, A i]_[𝓟 S])] [BorelSpace (Πʳ i, [R i, A i]_[𝓟 S])]
    [MeasurableSpace (Πʳ i, [R i, A i])] [BorelSpace (Πʳ i, [R i, A i])]
    (hS : cofinite ≤ 𝓟 S) (hA : ∀ i ∈ S, IsOpen (A i)) :
    MeasurableEmbedding (RestrictedProduct.inclusion R A hS) :=
  (isOpenEmbedding_restrictedProduct_inclusion_principal hS hA).measurableEmbedding

/-- Over a countable index type with second-countable Borel factors, the coercion from a principal
stage `Πʳ i, [R i, A i]_[𝓟 S]` to `∀ i, R i` is a measurable embedding whenever `A i` is measurable
for every `i ∈ S`. -/
theorem measurableEmbedding_restrictedProduct_coe_principal
    [Countable ι] [∀ i, TopologicalSpace (R i)] [∀ i, SecondCountableTopology (R i)]
    [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)]
    {A : ∀ i, Set (R i)} {S : Set ι}
    [MeasurableSpace (Πʳ i, [R i, A i]_[𝓟 S])] [BorelSpace (Πʳ i, [R i, A i]_[𝓟 S])]
    (hA : ∀ i ∈ S, MeasurableSet (A i)) :
    MeasurableEmbedding ((↑) : Πʳ i, [R i, A i]_[𝓟 S] → ∀ i, R i) := by
  refine RestrictedProduct.isEmbedding_coe_of_principal.measurableEmbedding ?_
  rw [RestrictedProduct.range_coe_principal]
  exact MeasurableSet.pi (to_countable S) hA

/-- Over a countable index type, the set of families in `∀ i, R i` that cofinitely belong to `A i`
is measurable in the product σ-algebra as soon as cofinitely many `A i` are measurable; no
assumption is needed on `A i` at the finitely many exceptional indices. -/
theorem measurableSet_range_restrictedProduct_coe
    [Countable ι] [∀ i, MeasurableSpace (R i)] {A : ∀ i, Set (R i)}
    (hA : ∀ᶠ i in cofinite, MeasurableSet (A i)) :
    MeasurableSet (Set.range ((↑) : Πʳ i, [R i, A i] → ∀ i, R i)) := by
  classical
  let hfin : {i | ¬ MeasurableSet (A i)}.Finite := eventually_cofinite.mp hA
  let S₀ : Finset ι := hfin.toFinset
  let Idx := {F : Finset ι // S₀ ⊆ F}
  have hrange : Set.range ((↑) : Πʳ i, [R i, A i] → ∀ i, R i) =
      ⋃ F : Idx, ((F.1 : Set ι)ᶜ).pi A := by
    ext x
    simp only [RestrictedProduct.range_coe, mem_ofPred_eq, eventually_cofinite, mem_iUnion,
      Set.mem_pi, mem_compl_iff, Finset.mem_coe]
    constructor
    · intro hx
      refine ⟨⟨S₀ ∪ hx.toFinset, Finset.subset_union_left⟩, fun i hi ↦ ?_⟩
      by_contra hxi
      exact hi (Finset.mem_union_right _ (hx.mem_toFinset.mpr hxi))
    · rintro ⟨F, hF⟩
      exact F.1.finite_toSet.subset fun i hi ↦ by
        by_contra hiF
        exact hi (hF i hiF)
  rw [hrange]
  refine MeasurableSet.iUnion fun F ↦ MeasurableSet.pi (to_countable _) fun i hi ↦ ?_
  by_contra hnot
  exact hi (Finset.mem_coe.mpr (F.2 (hfin.mem_toFinset.mpr hnot)))

/-- Over a countable index type with second-countable factors, if cofinitely many reference sets
`A i` are open, the Borel σ-algebra of `Πʳ i, [R i, A i]` is the pullback of `borel (∀ i, R i)`
along the coercion `(↑)`, even when `(↑)` is not a topological embedding. -/
theorem comap_coe_borel_restrictedProduct
    [Countable ι] [∀ i, TopologicalSpace (R i)] [∀ i, SecondCountableTopology (R i)]
    {A : ∀ i, Set (R i)} (hA : ∀ᶠ i in cofinite, IsOpen (A i)) :
    (borel (∀ i, R i)).comap ((↑) : Πʳ i, [R i, A i] → ∀ i, R i) =
      borel (Πʳ i, [R i, A i]) := by
  refine le_antisymm RestrictedProduct.continuous_coe.borel_measurable.comap_le ?_
  rw [borel_restrictedProduct_eq_generateFrom_openBoxes hA]
  refine MeasurableSpace.generateFrom_le fun B hB ↦ ?_
  obtain ⟨C, hC, -, rfl⟩ := mem_openRestrictedProductBoxes.mp hB
  refine ⟨Set.univ.pi C, ?_, preimage_coe_univ_pi A cofinite C⟩
  let _ : ∀ i, MeasurableSpace (R i) := fun i ↦ borel (R i)
  have : ∀ i, BorelSpace (R i) := fun _ ↦ ⟨rfl⟩
  rw [← BorelSpace.measurable_eq (α := ∀ i, R i)]
  exact MeasurableSet.univ_pi fun i ↦ (hC i).measurableSet

/-- Over a countable index type with second-countable Borel factors, if cofinitely many reference
sets `A i` are open, the coercion `Πʳ i, [R i, A i] → ∀ i, R i` is a measurable embedding for any
`BorelSpace` structure on `Πʳ i, [R i, A i]`. -/
theorem measurableEmbedding_restrictedProduct_coe
    [Countable ι] [∀ i, TopologicalSpace (R i)] [∀ i, SecondCountableTopology (R i)]
    [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)]
    {A : ∀ i, Set (R i)} [MeasurableSpace (Πʳ i, [R i, A i])] [BorelSpace (Πʳ i, [R i, A i])]
    (hA : ∀ᶠ i in cofinite, IsOpen (A i)) :
    MeasurableEmbedding ((↑) : Πʳ i, [R i, A i] → ∀ i, R i) := by
  rw [MeasurableEmbedding.iff_comap_eq]
  refine ⟨DFunLike.coe_injective, ?_,
    measurableSet_range_restrictedProduct_coe (hA.mono fun _ h ↦ h.measurableSet)⟩
  rw [BorelSpace.measurable_eq (α := ∀ i, R i),
    BorelSpace.measurable_eq (α := Πʳ i, [R i, A i])]
  exact comap_coe_borel_restrictedProduct hA

end Embeddings

section MeasurableBox

variable {ι : Type u} {R : ι → Type v}
variable [∀ i, TopologicalSpace (R i)] [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)]

/-- Over a countable index type, a coordinate box `restrictedProductBox A 𝓕 C` is measurable in
any `OpensMeasurableSpace` structure on `Πʳ i, [R i, A i]_[𝓕]` whenever every factor `C i` is
measurable. -/
theorem measurableSet_restrictedProductBox_of_countable [Countable ι]
    {A : ∀ i, Set (R i)} {𝓕 : Filter ι}
    [MeasurableSpace (Πʳ i, [R i, A i]_[𝓕])] [OpensMeasurableSpace (Πʳ i, [R i, A i]_[𝓕])]
    {C : ∀ i, Set (R i)} (hC : ∀ i, MeasurableSet (C i)) :
    MeasurableSet (restrictedProductBox A 𝓕 C) := by
  have heq : restrictedProductBox A 𝓕 C =
      ⋂ i, (fun x : Πʳ j, [R j, A j]_[𝓕] ↦ x i) ⁻¹' C i := by
    ext x
    simp
  rw [heq]
  exact MeasurableSet.iInter fun i ↦
    (hC i).preimage (RestrictedProduct.continuous_eval i).measurable

/-- Over an arbitrary index type, a coordinate box `restrictedProductBox A cofinite C` is
measurable in any `OpensMeasurableSpace` structure on `Πʳ i, [R i, A i]` whenever cofinitely many
`A i` are open, every `C i` is measurable, and `C i = A i` cofinitely. -/
theorem measurableSet_restrictedProductBox {A C : ∀ i, Set (R i)}
    [MeasurableSpace (Πʳ i, [R i, A i])] [OpensMeasurableSpace (Πʳ i, [R i, A i])]
    (hA : ∀ᶠ i in cofinite, IsOpen (A i)) (hC : ∀ i, MeasurableSet (C i))
    (hCA : ∀ᶠ i in cofinite, C i = A i) :
    MeasurableSet (restrictedProductBox A cofinite C) := by
  classical
  let hfin : {i | ¬ (IsOpen (A i) ∧ C i = A i)}.Finite := eventually_cofinite.mp (hA.and hCA)
  let F : Finset ι := hfin.toFinset
  have hopen : IsOpen {x : Πʳ i, [R i, A i] | ∀ i ∈ (F : Set ι)ᶜ, x i ∈ A i} := by
    refine isOpen_forall_mem_restrictedProduct_of_forall_mem fun i hi ↦ ?_
    by_contra hnot
    exact hi (Finset.mem_coe.mpr (hfin.mem_toFinset.mpr fun h ↦ hnot h.1))
  have heq : restrictedProductBox A cofinite C =
      {x : Πʳ i, [R i, A i] | ∀ i ∈ (F : Set ι)ᶜ, x i ∈ A i} ∩
        ⋂ i ∈ F, (fun x : Πʳ j, [R j, A j] ↦ x i) ⁻¹' C i := by
    ext x
    simp only [mem_restrictedProductBox, mem_inter_iff, mem_ofPred_eq, mem_compl_iff,
      Finset.mem_coe, mem_iInter, mem_preimage]
    refine ⟨fun hx ↦ ⟨fun i hi ↦ ?_, fun i _ ↦ hx i⟩, fun ⟨hxA, hxF⟩ i ↦ ?_⟩
    · have hCAi : C i = A i := by
        by_contra hnot
        exact hi (hfin.mem_toFinset.mpr fun h ↦ hnot h.2)
      rw [← hCAi]
      exact hx i
    · by_cases hi : i ∈ F
      · exact hxF i hi
      · have hCAi : C i = A i := by
          by_contra hnot
          exact hi (hfin.mem_toFinset.mpr fun h ↦ hnot h.2)
        rw [hCAi]
        exact hxA i hi
  rw [heq]
  exact hopen.measurableSet.inter
    (Finset.measurableSet_biInter F fun i _ ↦
      (hC i).preimage (RestrictedProduct.continuous_eval i).measurable)

end MeasurableBox

end TauCeti
