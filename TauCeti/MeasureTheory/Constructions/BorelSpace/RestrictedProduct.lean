module

public import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic
public import TauCeti.Topology.Algebra.RestrictedProduct.SecondCountable

/-!
# Borel measurability on restricted products

Let `R : ι → Type*` be topological spaces with reference sets `A i ⊆ R i`, and equip a restricted
product `Πʳ i, [R i, A i]_[𝓕]` with a measurable space compatible with its topology.

* **Measurability of evaluations, coercions, and inclusions:** Coordinate evaluations `x ↦ x i`,
  the coercion `(↑) : Πʳ i, [R i, A i]_[𝓕] → ∀ i, R i` into the product σ-algebra, and stage
  inclusions `RestrictedProduct.inclusion` are measurable without countability assumptions. When
  every `A i` is open and `S` is cofinite, `RestrictedProduct.inclusion R A hS` is an open
  topological embedding and hence a `MeasurableEmbedding` between Borel spaces; over a countable
  index type with second-countable factors, `RestrictedProduct.structureMap R A cofinite` from
  `∀ i, A i` is likewise a `MeasurableEmbedding`.
* **Measurability of boxes:** Over a countable index type, *every* coordinate box
  `{x : Πʳ i, [R i, A i]_[𝓕] | ∀ i, x i ∈ C i}` with Borel factors `C i` is measurable, being the
  countable intersection of the preimages `(· i) ⁻¹' C i`; over an arbitrary index type, a box on
  `Πʳ i, [R i, A i]` with Borel factors `C i` satisfying `C i = A i` cofinitely is measurable
  whenever every `A i` is open, because it lies inside one open principal stage where only finitely
  many coordinates are constrained beyond `A i`.
* **Generation of the Borel σ-algebra by open boxes:** When `ι` is countable, each `R i` is second
  countable, and each `A i` is open, `Πʳ i, [R i, A i]` is second countable and its Borel σ-algebra
  is generated by the π-system of open cofinite boxes `{x | ∀ i, x i ∈ C i}` with `C i = A i`
  cofinitely (`TauCeti.borel_restrictedProduct_eq_generateFrom_openBox`).

## Main results

* `TauCeti.measurable_restrictedProduct_coe`, `TauCeti.measurable_restrictedProduct_eval`,
  `TauCeti.measurable_restrictedProduct_inclusion`: measurability of structural maps.
* `TauCeti.measurableEmbedding_restrictedProduct_inclusion_principal`,
  `TauCeti.measurableEmbedding_restrictedProduct_structureMap`,
  `TauCeti.measurableEmbedding_restrictedProduct_coe_principal`: measurable-embedding theorems for
  open stages, the integral structure map, and principal-stage coercions.
* `TauCeti.measurableSet_setOf_forall_mem_restrictedProduct_of_countable`,
  `TauCeti.measurableSet_setOf_forall_mem_restrictedProduct`: measurability of Borel coordinate
  boxes.
* `TauCeti.isPiSystem_openBox_restrictedProduct`,
  `TauCeti.borel_restrictedProduct_eq_generateFrom_openBox`,
  `TauCeti.ext_of_openBox_restrictedProduct`: π-system, Borel generation, and measure
  extensionality from open cofinite boxes.

## References

* D. Ramakrishnan and R. J. Valenza, *Fourier Analysis on Number Fields*, Graduate Texts in
  Mathematics 186, Springer (1999), Chapter 5, §5.1.
* J. Tate, *Fourier analysis in number fields and Hecke's zeta-functions*, in J. W. S. Cassels and
  A. Fröhlich (eds.), *Algebraic Number Theory*, Academic Press (1967), §3.3.
-/

public section

open Filter MeasureTheory Set Topology
open scoped ENNReal RestrictedProduct

namespace TauCeti

section FactorMeasurable

variable {ι : Type*} {R : ι → Type*} {A : ∀ i, Set (R i)} {𝓕 : Filter ι}
  [∀ i, TopologicalSpace (R i)] [∀ i, MeasurableSpace (R i)]

/-- Coordinate evaluation `x ↦ x i` on a restricted product is measurable whenever open sets of the
restricted product are measurable and the `i`-th factor is a Borel space. -/
@[fun_prop]
theorem measurable_restrictedProduct_eval [MeasurableSpace (Πʳ i, [R i, A i]_[𝓕])]
    [OpensMeasurableSpace (Πʳ i, [R i, A i]_[𝓕])] (i : ι) [BorelSpace (R i)] :
    Measurable fun x : Πʳ j, [R j, A j]_[𝓕] ↦ x i :=
  (RestrictedProduct.continuous_eval i).measurable

/-- The coercion `(↑) : Πʳ i, [R i, A i]_[𝓕] → ∀ i, R i` into the product σ-algebra is
measurable. -/
@[fun_prop]
theorem measurable_restrictedProduct_coe [MeasurableSpace (Πʳ i, [R i, A i]_[𝓕])]
    [OpensMeasurableSpace (Πʳ i, [R i, A i]_[𝓕])] [∀ i, BorelSpace (R i)] :
    Measurable ((↑) : Πʳ i, [R i, A i]_[𝓕] → ∀ i, R i) :=
  measurable_pi_iff.2 fun i ↦ measurable_restrictedProduct_eval i

/-- Over a countable index type, any coordinate box `{x | ∀ i, x i ∈ C i}` with measurable factors
`C i` is measurable in `Πʳ i, [R i, A i]_[𝓕]`, without requiring `C i = A i` cofinitely. -/
theorem measurableSet_setOf_forall_mem_restrictedProduct_of_countable [Countable ι]
    [MeasurableSpace (Πʳ i, [R i, A i]_[𝓕])] [OpensMeasurableSpace (Πʳ i, [R i, A i]_[𝓕])]
    [∀ i, BorelSpace (R i)] {C : ∀ i, Set (R i)} (hC : ∀ i, MeasurableSet (C i)) :
    MeasurableSet {x : Πʳ i, [R i, A i]_[𝓕] | ∀ i, x i ∈ C i} := by
  have heq : {x : Πʳ i, [R i, A i]_[𝓕] | ∀ i, x i ∈ C i} =
      ⋂ i, (fun x : Πʳ j, [R j, A j]_[𝓕] ↦ x i) ⁻¹' C i := by
    ext x
    simp
  rw [heq]
  exact MeasurableSet.iInter fun i ↦ measurable_restrictedProduct_eval i (hC i)

/-- On a principal stage over a countable index type with second-countable Borel factors, the
coercion `(↑) : Πʳ i, [R i, A i]_[𝓟 S] → ∀ i, R i` is a measurable embedding whenever `A i` is
measurable for every `i ∈ S`. -/
theorem measurableEmbedding_restrictedProduct_coe_principal [Countable ι]
    [∀ i, SecondCountableTopology (R i)] [∀ i, BorelSpace (R i)] {S : Set ι}
    [MeasurableSpace (Πʳ i, [R i, A i]_[𝓟 S])] [BorelSpace (Πʳ i, [R i, A i]_[𝓟 S])]
    (hA : ∀ i ∈ S, MeasurableSet (A i)) :
    MeasurableEmbedding ((↑) : Πʳ i, [R i, A i]_[𝓟 S] → ∀ i, R i) := by
  refine RestrictedProduct.isEmbedding_coe_of_principal.measurableEmbedding ?_
  rw [RestrictedProduct.range_coe_principal]
  exact MeasurableSet.pi S.to_countable hA

/-- When `ι` is countable, each `R i` is second countable, and each `A i` is open, the structure
map `RestrictedProduct.structureMap R A cofinite : (∀ i, A i) → Πʳ i, [R i, A i]` is a measurable
embedding. -/
theorem measurableEmbedding_restrictedProduct_structureMap [Countable ι]
    [∀ i, SecondCountableTopology (R i)] [∀ i, BorelSpace (R i)]
    [MeasurableSpace (Πʳ i, [R i, A i])] [BorelSpace (Πʳ i, [R i, A i])]
    (hA : ∀ i, IsOpen (A i)) :
    MeasurableEmbedding (RestrictedProduct.structureMap R A cofinite) :=
  (RestrictedProduct.isOpenEmbedding_structureMap hA).measurableEmbedding

/-- For an arbitrary (not necessarily countable) index type `ι`, if every `A i` is open and
`C : ∀ i, Set (R i)` consists of Borel sets with `C i = A i` for all but finitely many `i`, then
the box `{x : Πʳ i, [R i, A i] | ∀ i, x i ∈ C i}` is measurable in `Πʳ i, [R i, A i]`. -/
theorem measurableSet_setOf_forall_mem_restrictedProduct [∀ i, BorelSpace (R i)]
    [MeasurableSpace (Πʳ i, [R i, A i])] [BorelSpace (Πʳ i, [R i, A i])]
    (hA : ∀ i, IsOpen (A i)) {C : ∀ i, Set (R i)} (hC : ∀ i, MeasurableSet (C i))
    (hCA : ∀ᶠ i in cofinite, C i = A i) :
    MeasurableSet {x : Πʳ i, [R i, A i] | ∀ i, x i ∈ C i} := by
  set S : Set ι := {i | C i = A i}
  have hfin : Sᶜ.Finite := mem_cofinite.mp hCA
  -- `{x | ∀ i, x i ∈ C i}` is the intersection of the open stage `{x | ∀ i ∈ S, x i ∈ A i}` with
  -- finitely many coordinate preimages over `Sᶜ`.
  have heq : {x : Πʳ i, [R i, A i] | ∀ i, x i ∈ C i} =
      {x : Πʳ i, [R i, A i] | ∀ i ∈ S, x i ∈ A i} ∩
        ⋂ i ∈ Sᶜ, (fun x : Πʳ j, [R j, A j] ↦ x i) ⁻¹' C i := by
    ext x
    simp only [mem_ofPred_eq, mem_inter_iff, mem_iInter, mem_compl_iff, mem_preimage]
    refine ⟨fun hx ↦ ⟨fun i hiS ↦ hiS ▸ hx i, fun i _ ↦ hx i⟩, fun ⟨hxS, hxSc⟩ i ↦ ?_⟩
    by_cases hi : i ∈ S
    · exact hi.symm ▸ hxS i hi
    · exact hxSc i hi
  rw [heq]
  exact (RestrictedProduct.isOpen_forall_imp_mem hA).measurableSet.inter
    (hfin.measurableSet_biInter fun i _ ↦ measurable_restrictedProduct_eval i (hC i))

end FactorMeasurable

section AmbientOnly

variable {ι : Type*} {R : ι → Type*} {A : ∀ i, Set (R i)} [∀ i, TopologicalSpace (R i)]

/-- Inclusion `RestrictedProduct.inclusion R A h : Πʳ i, [R i, A i]_[𝓖] → Πʳ i, [R i, A i]_[𝓕]`
(`h : 𝓕 ≤ 𝓖`) is measurable whenever open sets of the source are measurable and the target is a
Borel space. -/
@[fun_prop]
theorem measurable_restrictedProduct_inclusion {𝓕 𝓖 : Filter ι}
    [MeasurableSpace (Πʳ i, [R i, A i]_[𝓕])] [BorelSpace (Πʳ i, [R i, A i]_[𝓕])]
    [MeasurableSpace (Πʳ i, [R i, A i]_[𝓖])] [OpensMeasurableSpace (Πʳ i, [R i, A i]_[𝓖])]
    (h : 𝓕 ≤ 𝓖) :
    Measurable (RestrictedProduct.inclusion R A h) :=
  (RestrictedProduct.continuous_inclusion h).measurable

/-- When every reference set `A i` is open and `S` is cofinite, the inclusion of the principal
stage `Πʳ i, [R i, A i]_[𝓟 S]` into `Πʳ i, [R i, A i]` is a measurable embedding between Borel
spaces. -/
theorem measurableEmbedding_restrictedProduct_inclusion_principal {S : Set ι}
    [MeasurableSpace (Πʳ i, [R i, A i]_[𝓟 S])] [BorelSpace (Πʳ i, [R i, A i]_[𝓟 S])]
    [MeasurableSpace (Πʳ i, [R i, A i])] [BorelSpace (Πʳ i, [R i, A i])]
    (hA : ∀ i, IsOpen (A i)) (hS : cofinite ≤ 𝓟 S) :
    MeasurableEmbedding (RestrictedProduct.inclusion R A hS) :=
  (RestrictedProduct.isOpenEmbedding_inclusion_principal hA hS).measurableEmbedding

/-- The collection of open cofinite boxes `{x : Πʳ i, [R i, A i] | ∀ i, x i ∈ C i}` with
`C i = A i` cofinitely forms a π-system. -/
theorem isPiSystem_openBox_restrictedProduct :
    IsPiSystem {s : Set (Πʳ i, [R i, A i]) | ∃ C : ∀ i, Set (R i),
      (∀ i, IsOpen (C i)) ∧ (∀ᶠ i in cofinite, C i = A i) ∧ s = {x | ∀ i, x i ∈ C i}} := by
  rintro _ ⟨C₁, hC₁o, hC₁A, rfl⟩ _ ⟨C₂, hC₂o, hC₂A, rfl⟩ _
  refine ⟨fun i ↦ C₁ i ∩ C₂ i, fun i ↦ (hC₁o i).inter (hC₂o i),
    (hC₁A.and hC₂A).mono fun i ⟨h₁, h₂⟩ ↦ by dsimp only; rw [h₁, h₂, inter_self], ?_⟩
  ext x
  exact forall_and.symm

/-- **Borel σ-algebra generated by open cofinite boxes.** When `ι` is countable, each `R i` is
second countable, and every `A i` is open, `borel (Πʳ i, [R i, A i])` is generated by the boxes
`{x | ∀ i, x i ∈ C i}` with open factors `C i` satisfying `C i = A i` cofinitely. -/
theorem borel_restrictedProduct_eq_generateFrom_openBox [Countable ι]
    [∀ i, SecondCountableTopology (R i)] (hA : ∀ i, IsOpen (A i)) :
    borel (Πʳ i, [R i, A i]) = MeasurableSpace.generateFrom
      {s : Set (Πʳ i, [R i, A i]) | ∃ C : ∀ i, Set (R i),
        (∀ i, IsOpen (C i)) ∧ (∀ᶠ i in cofinite, C i = A i) ∧ s = {x | ∀ i, x i ∈ C i}} := by
  have := secondCountableTopology_restrictedProduct_of_isOpen (R := R) hA
  exact (isTopologicalBasis_restrictedProduct hA).borel_eq_generateFrom

/-- **Extensionality of Borel measures from open cofinite boxes.** Over a countable index type with
second-countable weakly locally compact factors and open reference sets `A i` that are compact
cofinitely, two Borel measures on `Πʳ i, [R i, A i]` (the first finite on compact sets) are equal
whenever they agree on every open cofinite box `{x | ∀ i, x i ∈ C i}` (`C i = A i` cofinitely). -/
theorem ext_of_openBox_restrictedProduct [Countable ι] [∀ i, SecondCountableTopology (R i)]
    [∀ i, WeaklyLocallyCompactSpace (R i)] [MeasurableSpace (Πʳ i, [R i, A i])]
    [BorelSpace (Πʳ i, [R i, A i])] (hA : ∀ i, IsOpen (A i))
    (hAcompact : ∀ᶠ i in cofinite, IsCompact (A i))
    {μ ν : Measure (Πʳ i, [R i, A i])} [IsFiniteMeasureOnCompacts μ]
    (h_eq : ∀ C : ∀ i, Set (R i), (∀ i, IsOpen (C i)) → (∀ᶠ i in cofinite, C i = A i) →
      μ {x | ∀ i, x i ∈ C i} = ν {x | ∀ i, x i ∈ C i}) :
    μ = ν := by
  obtain ⟨T, hTcnt, hTcov, hTsub, hTcomp⟩ :=
    exists_countable_openBox_cover_subset_compact hA hAcompact
  refine Measure.ext_of_generateFrom_of_cover_subset
    (BorelSpace.measurable_eq.trans (borel_restrictedProduct_eq_generateFrom_openBox hA))
    isPiSystem_openBox_restrictedProduct hTsub hTcnt hTcov
    (fun s hs ↦ ?_) fun _ ⟨C, hCo, hCA, hs⟩ ↦ hs ▸ h_eq C hCo hCA
  obtain ⟨K, hK, hsK⟩ := hTcomp s hs
  exact ((measure_mono hsK).trans_lt hK.measure_lt_top).ne

end AmbientOnly

end TauCeti
