module

public import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic
public import Mathlib.Topology.Algebra.RestrictedProduct.TopologicalSpace
-- Proof-only: box openness, open-box basis, and second countability for restricted products.
import TauCeti.Topology.Algebra.RestrictedProduct.TopologicalSpace

/-!
# Borel structure of a restricted product

For a family of topological spaces `R i` with reference subsets `A i`, the restricted product
`Πʳ i, [R i, A i]` carries the final topology over its principal stages. This file establishes the
measurability of coordinate boxes `{x | ∀ i, x i ∈ C i}` and identifies the Borel σ-algebra of a
countable restricted product of second-countable spaces with open reference sets.

* For any index type (without countability), a box `{x | ∀ i, x i ∈ C i}` with Borel factors `C i`
  that agree with `A i` at all but finitely many indices is Borel-measurable whenever `A i` is open
  for all but finitely many `i` (`TauCeti.measurableSet_restrictedProduct_box_of_eventually_eq`).
* Over a countable index type (and for any filter `𝓕`), every box `{x | ∀ i, x i ∈ C i}` with Borel
  factors `C i` is measurable (`TauCeti.measurableSet_restrictedProduct_box`), with no eventual
  equality or openness assumption.
* For a countable family of second-countable spaces with open reference sets, the restricted product
  is second countable and its Borel σ-algebra is generated by the boxes with open factors eventually
  equal to `A i` (`TauCeti.borel_restrictedProduct_eq_generateFrom_open_boxes`).

## References

* N. Bourbaki, *General Topology*.
* J. Tate, *Fourier analysis in number fields, and Hecke's zeta-functions*, in *Algebraic Number
  Theory* (Cassels–Fröhlich), §3.3.
-/

public section

namespace TauCeti

open Filter MeasureTheory Topology
open scoped RestrictedProduct

universe u v

variable {ι : Type u} {R : ι → Type v} {A : ∀ i, Set (R i)}
variable [∀ i, TopologicalSpace (R i)]

/-- A box `{x | ∀ i, x i ∈ C i}` in a restricted product over the cofinite filter is measurable
whenever each `C i` is measurable, `C i = A i` for all but finitely many `i`, and `A i` is open
for all but finitely many `i`. No countability hypothesis on `ι` is needed. -/
theorem measurableSet_restrictedProduct_box_of_eventually_eq
    [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)]
    [MeasurableSpace (Πʳ i, [R i, A i])] [OpensMeasurableSpace (Πʳ i, [R i, A i])]
    (hA : ∀ᶠ i in cofinite, IsOpen (A i)) {C : ∀ i, Set (R i)} (hC : ∀ i, MeasurableSet (C i))
    (hCA : ∀ᶠ i in cofinite, C i = A i) :
    MeasurableSet {x : Πʳ i, [R i, A i] | ∀ i, x i ∈ C i} := by
  classical
  let S : Finset ι := (mem_cofinite.mp (hCA.and hA)).toFinset
  have hS : ∀ i ∉ S, C i = A i ∧ IsOpen (A i) := fun i hi ↦ by
    simpa [S, Set.Finite.mem_toFinset] using hi
  -- Outside `S`, both `C i = A i` and `IsOpen (A i)` hold, so the tail constraint is open;
  -- on `S`, only finitely many measurable coordinate preimages remain.
  let D : ∀ i, Set (R i) := fun i ↦ if i ∈ S then Set.univ else A i
  have hD : ∀ i, IsOpen (D i) := fun i ↦ by
    by_cases hi : i ∈ S
    · simp [D, hi]
    · simpa [D, hi] using (hS i hi).2
  have hAD : ∀ᶠ i in cofinite, A i ⊆ D i := by
    filter_upwards [S.finite_toSet.compl_mem_cofinite] with i hi
    have hi' : i ∉ S := hi
    simp [D, hi']
  have hopen : IsOpen {x : Πʳ i, [R i, A i] | ∀ i, x i ∈ D i} :=
    isOpen_restrictedProduct_box hD hAD
  have heq : {x : Πʳ i, [R i, A i] | ∀ i, x i ∈ C i} =
      {x : Πʳ i, [R i, A i] | ∀ i, x i ∈ D i} ∩
        ⋂ i ∈ S, (fun x : Πʳ j, [R j, A j] ↦ x i) ⁻¹' C i := by
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_inter_iff, Set.mem_iInter, Set.mem_preimage, D]
    constructor
    · intro hx
      refine ⟨fun i ↦ ?_, fun i _ ↦ hx i⟩
      by_cases hi : i ∈ S
      · simp [hi]
      · simpa [hi, (hS i hi).1] using hx i
    · rintro ⟨h1, h2⟩ i
      by_cases hi : i ∈ S
      · exact h2 i hi
      · simpa [hi, (hS i hi).1] using h1 i
  rw [heq]
  exact hopen.measurableSet.inter
    (MeasurableSet.biInter S.countable_toSet fun i _ ↦
      (RestrictedProduct.continuous_eval i).measurable (hC i))

/-- Over a countable index type and for any filter `𝓕`, every box `{x | ∀ i, x i ∈ C i}` with
measurable factors `C i` is measurable in `Πʳ i, [R i, A i]_[𝓕]`. -/
theorem measurableSet_restrictedProduct_box {𝓕 : Filter ι} [Countable ι]
    [∀ i, MeasurableSpace (R i)] [∀ i, BorelSpace (R i)]
    [MeasurableSpace (Πʳ i, [R i, A i]_[𝓕])] [OpensMeasurableSpace (Πʳ i, [R i, A i]_[𝓕])]
    {C : ∀ i, Set (R i)} (hC : ∀ i, MeasurableSet (C i)) :
    MeasurableSet {x : Πʳ i, [R i, A i]_[𝓕] | ∀ i, x i ∈ C i} := by
  have heq : {x : Πʳ i, [R i, A i]_[𝓕] | ∀ i, x i ∈ C i} =
      ⋂ i, (fun x : Πʳ j, [R j, A j]_[𝓕] ↦ x i) ⁻¹' C i := by
    ext x
    simp
  rw [heq]
  exact MeasurableSet.iInter fun i ↦ (RestrictedProduct.continuous_eval i).measurable (hC i)

/-- For a countable family of second-countable spaces with open reference sets, the Borel σ-algebra
of the restricted product is generated by the boxes `{x | ∀ i, x i ∈ C i}` with open factors `C i`
eventually equal to `A i`. -/
theorem borel_restrictedProduct_eq_generateFrom_open_boxes [Countable ι]
    [∀ i, SecondCountableTopology (R i)] (hA : ∀ i, IsOpen (A i)) :
    borel (Πʳ i, [R i, A i]) =
      MeasurableSpace.generateFrom
        {s : Set (Πʳ i, [R i, A i]) |
          ∃ C : ∀ i, Set (R i), (∀ i, IsOpen (C i)) ∧
            (∀ᶠ i in cofinite, C i = A i) ∧ s = {x | ∀ i, x i ∈ C i}} := by
  have : SecondCountableTopology (Πʳ i, [R i, A i]) :=
    secondCountableTopology_restrictedProduct hA
  exact (isTopologicalBasis_restrictedProduct_open_boxes hA).borel_eq_generateFrom

end TauCeti
