module

public import Mathlib.MeasureTheory.Constructions.BorelSpace.Metric
import Mathlib.MeasureTheory.Constructions.BorelSpace.Order

/-!
# Borel measurability from distance functions

In a second-countable pseudometric space every open set is a countable union of open balls.
Hence a σ-algebra contains the Borel σ-algebra as soon as each distance function `x ↦ dist x y`
is measurable for it, and a map `g` into such a space is Borel measurable as soon as each
distance function `a ↦ dist (g a) y` is measurable. This is how one recognizes the norm-Borel
σ-algebra of a separable normed space inside a σ-algebra generated by other tests, such as scalar
evaluations that recover the norm.
-/

public section

open MeasureTheory Set Metric TopologicalSpace

namespace TauCeti

variable {α β : Type*} [PseudoMetricSpace β] [SecondCountableTopology β]

/-- On a second-countable pseudometric space, a σ-algebra contains the Borel σ-algebra when all
the distance functions `x ↦ dist x y` are measurable for it. -/
theorem borel_le_of_measurable_dist {m : MeasurableSpace β}
    (h : ∀ y, Measurable[m] fun x ↦ dist x y) : borel β ≤ m := by
  refine MeasurableSpace.generateFrom_le fun U (hU : IsOpen U) ↦ ?_
  -- Write `U` as a countable union of open balls contained in it.
  let s : {p : β × ℝ // ball p.1 p.2 ⊆ U} → Set β := fun p ↦ ball p.val.1 p.val.2
  obtain ⟨T, hTc, hT⟩ := isOpen_iUnion_countable s fun _ ↦ isOpen_ball
  have hU' : U = ⋃ p ∈ T, s p := by
    refine hT.symm ▸ (Subset.antisymm (fun x hx ↦ ?_) (iUnion_subset fun p ↦ p.property))
    obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU x hx
    exact mem_iUnion.2 ⟨⟨(x, ε), hεU⟩, mem_ball_self hε⟩
  rw [hU']
  exact MeasurableSet.biUnion hTc fun p _ ↦ h p.val.1 measurableSet_Iio

/-- A map into a second-countable pseudometric space is measurable when all of its distance
functions `a ↦ dist (g a) y` are measurable. -/
theorem measurable_of_measurable_dist [MeasurableSpace α] [MeasurableSpace β] [BorelSpace β]
    {g : α → β} (h : ∀ y, Measurable fun a ↦ dist (g a) y) : Measurable g := by
  rw [measurable_iff_le_map, BorelSpace.measurable_eq (α := β)]
  refine borel_le_of_measurable_dist fun y ↦ ?_
  simpa only [measurable_iff_comap_le, ← MeasurableSpace.comap_le_iff_le_map,
    MeasurableSpace.comap_comp, Function.comp_def] using h y

end TauCeti
