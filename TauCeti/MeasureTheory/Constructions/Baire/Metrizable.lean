module

public import Mathlib.Topology.Metrizable.Basic
public import TauCeti.MeasureTheory.Constructions.Baire.Basic
import Mathlib.Topology.GDelta.MetrizableSpace
import Mathlib.Topology.Separation.PerfectlyNormal

/-!
# Equality of the Baire and Borel σ-algebras on pseudometrizable spaces

On a pseudometrizable space `X`, every closed set is the zero set of a continuous real-valued
function (`PerfectlyNormalSpace`). Consequently, the Baire σ-algebra `TauCeti.baire X` coincides
with the Borel σ-algebra `borel X`, upgrading `TauCeti.baire_le_borel` to equality.

Pulling back along any continuous map `q : X → Y` from an arbitrary topological space `X` into a
pseudometrizable space `Y` therefore maps every Borel set of `Y` into `TauCeti.baire X`.

## Main results

* `TauCeti.baire_eq_borel`: on a pseudometrizable space `X`, `TauCeti.baire X = borel X`.
* `Continuous.comap_borel_le_baire`: for a continuous map `q : X → Y` into a pseudometrizable
  space `Y`, `MeasurableSpace.comap q (borel Y) ≤ TauCeti.baire X`.

## References

* D. H. Fremlin, *Measure Theory*, Vol. 4, Torres Fremlin (2003), §4A3K.
-/

public section

open MeasureTheory TopologicalSpace

namespace TauCeti

/-- On a pseudometrizable space, the Baire σ-algebra generated by continuous real-valued functions
coincides with the Borel σ-algebra. -/
theorem baire_eq_borel (X : Type*) [TopologicalSpace X] [PseudoMetrizableSpace X] :
    baire X = borel X := by
  refine le_antisymm baire_le_borel ?_
  rw [borel_eq_generateFrom_isClosed]
  refine MeasurableSpace.generateFrom_le fun F hF ↦ ?_
  obtain ⟨f, rfl, -⟩ :=
    perfectlyNormalSpace_iff_forall_isClosed_preimage_zero.mp inferInstance F hF
  exact f.measurable_baire (measurableSet_singleton 0)

end TauCeti

/-- Pulling back the Borel σ-algebra along a continuous map into a pseudometrizable space lands in
the Baire σ-algebra of the domain. -/
theorem Continuous.comap_borel_le_baire {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    [PseudoMetrizableSpace Y] {q : X → Y} (hq : Continuous q) :
    MeasurableSpace.comap q (borel Y) ≤ TauCeti.baire X := by
  rw [← TauCeti.baire_eq_borel Y]
  exact measurable_iff_comap_le.mp hq.measurable_baire

end
