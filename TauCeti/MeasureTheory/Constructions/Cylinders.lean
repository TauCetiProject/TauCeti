module

public import Mathlib.Algebra.Group.Pointwise.Set.Scalar
public import Mathlib.MeasureTheory.Constructions.Cylinders

/-!
# σ-algebras generated by coordinates

For a family of measurable spaces `X i`, `i : ι`, Mathlib's `MeasureTheory.cylinderEvents Δ` is
the σ-algebra on `∀ i, X i` generated by the coordinates in `Δ ⊆ ι`. This file records when it
lies below a given σ-algebra, that its events depend only on the coordinates in `Δ`, and how it
transforms under precomposition with a map of index sets, in particular under the action of a
group on the index set.

## Main results

* `TauCeti.cylinderEvents_le_iff`: `cylinderEvents Δ ≤ m` iff every coordinate in `Δ` is
  `m`-measurable.
* `TauCeti.mem_of_measurableSet_cylinderEvents`: an event measurable with respect to the
  coordinates in `Δ` depends only on those coordinates.
* `TauCeti.comap_comp_cylinderEvents`: pulling back along `ω ↦ ω ∘ f` sends the σ-algebra of the
  coordinates in `Δ` to that of the coordinates in `f '' Δ`.
* `TauCeti.comap_inv_smul_cylinderEvents`: for a group `Γ` acting on the index set, pulling back
  along `ω ↦ γ • ω`, where `(γ • ω) i = ω (γ⁻¹ • i)`, sends the σ-algebra of the coordinates in
  `Δ` to that of the coordinates in `γ⁻¹ • Δ`.
-/

public section

open MeasureTheory Set
open scoped Pointwise

namespace TauCeti

section Coordinates

variable {ι : Type*} {X : ι → Type*} [∀ i, MeasurableSpace (X i)]

/-- The σ-algebra generated by the coordinates in `Δ` is below `m` iff each of these coordinates
is `m`-measurable. -/
theorem cylinderEvents_le_iff {Δ : Set ι} {m : MeasurableSpace (∀ i, X i)} :
    cylinderEvents Δ ≤ m ↔ ∀ i ∈ Δ, Measurable[m] fun ω : ∀ i, X i => ω i := by
  simp [cylinderEvents, measurable_iff_comap_le]

/-- An event measurable with respect to the coordinates in `Δ` depends only on those
coordinates. -/
theorem mem_of_measurableSet_cylinderEvents {Δ : Set ι} {A : Set (∀ i, X i)}
    (hA : MeasurableSet[cylinderEvents Δ] A) {ω ω' : ∀ i, X i} (hω : ω ∈ A)
    (h : ∀ i ∈ Δ, ω' i = ω i) : ω' ∈ A := by
  have hle : cylinderEvents (X := X) Δ ≤ MeasurableSpace.comap Δ.domRestrict MeasurableSpace.pi :=
    cylinderEvents_le_iff.2 fun i hi =>
      (measurable_pi_apply (⟨i, hi⟩ : Δ)).comp (comap_measurable Δ.domRestrict)
  obtain ⟨B, -, rfl⟩ := hle A hA
  have : Δ.domRestrict ω' = Δ.domRestrict ω := funext fun i => h i i.property
  simpa [Set.mem_preimage, this] using hω

end Coordinates

section Action

variable {I J S : Type*} [MeasurableSpace S]

/-- Precomposition with `f : I → J` pulls the σ-algebra of the coordinates in `Δ ⊆ I` back to
the σ-algebra of the coordinates in `f '' Δ`, for a product of possibly different spaces
`X j`. -/
theorem comap_comp_cylinderEvents_pi {X : J → Type*} [∀ j, MeasurableSpace (X j)] (f : I → J)
    (Δ : Set I) :
    MeasurableSpace.comap (fun (ω : ∀ j, X j) i => ω (f i))
        (cylinderEvents (X := fun i => X (f i)) Δ) =
      cylinderEvents (f '' Δ) := by
  simp only [cylinderEvents, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp, iSup_image]
  rfl

/-- Precomposition with `f : I → J` pulls the σ-algebra of the coordinates in `Δ ⊆ I` back to
the σ-algebra of the coordinates in `f '' Δ`. -/
theorem comap_comp_cylinderEvents (f : I → J) (Δ : Set I) :
    MeasurableSpace.comap (fun ω : J → S => ω ∘ f) (cylinderEvents Δ) =
      cylinderEvents (f '' Δ) :=
  comap_comp_cylinderEvents_pi (X := fun _ => S) f Δ

variable {Γ : Type*} [Group Γ] [MulAction Γ I]

/-- Let `Γ` act on configurations by `(γ • ω) i = ω (γ⁻¹ • i)`. Pulling the σ-algebra of the
coordinates in `Δ` back along `ω ↦ γ • ω` gives the σ-algebra of the coordinates in `γ⁻¹ • Δ`:
an event depending on the coordinates in `Δ` has preimage under `ω ↦ γ • ω` depending on the
coordinates in `γ⁻¹ • Δ`. -/
theorem comap_inv_smul_cylinderEvents (γ : Γ) (Δ : Set I) :
    MeasurableSpace.comap (fun (ω : I → S) i => ω (γ⁻¹ • i)) (cylinderEvents Δ) =
      cylinderEvents (γ⁻¹ • Δ) :=
  comap_comp_cylinderEvents (fun i => γ⁻¹ • i) Δ

end Action

end TauCeti
