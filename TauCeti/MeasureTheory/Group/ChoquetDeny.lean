/-!
# The Choquet–Deny lemma and harmonic measures on `ℝ`

Let `μ` be a probability measure on a seminormed additive commutative group `E`. A function
`h : E → ℝ` is `μ`-harmonic if it equals its own average against `μ`,

```text
h x = ∫ t, h (x - t) ∂μ        for every x.
```

This file proves that a bounded, uniformly continuous `μ`-harmonic function is periodic with
period `s` for every point `s` of the support of `μ`
(`TauCeti.periodic_of_forall_eq_integral_sub`). Consequently it is invariant under translation
by the additive subgroup generated by the support of `μ`. If that subgroup is dense, bounded
uniformly continuous `μ`-harmonic functions are constant
(`MeasureTheory.Measure.apply_eq_of_forall_eq_integral_sub`).

On the real line this gives the Choquet–Deny theorem for laws `ν` whose support generates a
dense subgroup of `ℝ`. A measure `η` with `ν ∗ η = η` and `η [a, a + 1] ≤ C` for every `a` is
the multiple `η (0, 1] • volume` of Lebesgue measure
(`MeasureTheory.Measure.eq_smul_volume_of_conv_eq_self`). For a compactly supported continuous
`f`, the function `x ↦ ∫ y, f (y - x) ∂η` is bounded, uniformly continuous and harmonic, hence
constant, so `η` is translation invariant by uniqueness in the Riesz–Markov–Kakutani theorem and
a multiple of Lebesgue measure by uniqueness of Haar measure. This is the rigidity input behind
Blackwell's renewal theorem for nonlattice laws. No moment assumption is made on `ν`, and `η`
may have atoms a priori.

The proof is a maximum argument with no compactness. Fix `s` in the support and consider the
difference `g x = h x - h (x - s)`, which is again bounded and harmonic. If its supremum `M` were
positive, choose `r > 0` so that `h` varies by less than `M / 4` over distance `r`, and let
`p > 0` be the mass of the ball of radius `r` about `s`. A point where `g` is within `δ` of `M`
has, by harmonicity, a translate by some `t` in that ball where `g` is within `δ / p` of `M`, and
the step from the point to its translate decreases `h` by more than `M / 2`. Starting close
enough to the supremum, this step can be repeated arbitrarily often, so `h` decreases without
bound, contradicting boundedness. Hence `g ≤ 0`, and applying this to `-h` gives `g = 0`.

## References

* G. Choquet and J. Deny, *Sur l'équation de convolution μ = μ ⋆ σ*, C. R. Acad. Sci. Paris
  250 (1960), 799–801.
* William Feller, *An Introduction to Probability Theory and Its Applications*, vol. II,
  2nd edition, Wiley, 1971, §XI.2, for the use of this lemma in the renewal theorem.
-/

public section

open MeasureTheory Metric Set
open scoped NNReal CompactlySupported

namespace TauCeti

variable {E : Type*} [SeminormedAddCommGroup E] [MeasurableSpace E] [OpensMeasurableSpace E]
  {μ : Measure E} [IsProbabilityMeasure μ]

/-- One half of the Choquet–Deny lemma: a bounded, uniformly continuous `μ`-harmonic function
does not increase under translation by a point of the support of `μ`. -/
private lemma apply_le_apply_sub_of_mem_support {h : E → ℝ} {C : ℝ} (hC : ∀ x, |h x| ≤ C)
    (hu : UniformContinuous h) (hh : ∀ x, h x = ∫ t, h (x - t) ∂μ) {s : E}
    (hs : s ∈ μ.support) (y : E) : h y ≤ h (y - s) := by
  have hint (x : E) : Integrable (fun t ↦ h (x - t)) μ :=
    .of_bound ((hu.continuous.comp (continuous_const.sub continuous_id)).measurable
      |>.aestronglyMeasurable) C (.of_forall fun t ↦ hC _)
  -- The difference `g` of `h` and its translate is bounded and harmonic.
  set g : E → ℝ := fun x ↦ h x - h (x - s) with hg
  have hgint (z : E) : Integrable (fun t ↦ g (z - t)) μ :=
    ((hint z).sub (hint (z - s))).congr (.of_forall fun t ↦ by simp [hg, sub_right_comm _ _ s])
  have hgh (z : E) : g z = ∫ t, g (z - t) ∂μ := by
    simp only [hg]
    rw [integral_sub (hint z) (by simpa [sub_right_comm _ _ s] using hint (z - s)), ← hh z]
    simp_rw [sub_right_comm _ _ s, ← hh (z - s)]
  have hgbdd : BddAbove (range g) :=
    ⟨2 * C, by
      rintro _ ⟨x, rfl⟩
      linarith [(abs_le.1 (hC x)).2, (abs_le.1 (hC (x - s))).1]⟩
  set M := ⨆ x, g x
  have hgM (x : E) : g x ≤ M := le_ciSup hgbdd x
  suffices hM : M ≤ 0 by linarith [hgM y]
  by_contra! hM
  obtain ⟨r, hr, hr'⟩ := Metric.uniformContinuous_iff.1 hu (M / 4) (by positivity)
  set p := μ.real (ball s r)
  have hp : 0 < p := ENNReal.toReal_pos
    ((Measure.mem_support_iff_forall s).1 hs _ (ball_mem_nhds s hr)).ne' (measure_ne_top _ _)
  have hp1 : p ≤ 1 := measureReal_le_one
  -- Near the supremum of `g`, `h` can be decreased `n` times by more than `M / 2`.
  have key (n : ℕ) (z : E) (hz : M - M / 4 * p ^ n < g z) :
      ∃ w, n * (M / 2) ≤ h z - h w := by
    induction n generalizing z with
    | zero => exact ⟨z, by simp⟩
    | succ n ih =>
      obtain ⟨t, ht, hzt⟩ := TauCeti.MeasureTheory.exists_mem_sub_div_lt_of_sub_lt_integral
        (hgint z) (.of_forall fun t ↦ hgM (z - t)) (hgh z ▸ hz) measurableSet_ball hp
      rw [pow_succ, ← mul_assoc, mul_div_cancel_right₀ _ hp.ne'] at hzt
      obtain ⟨w, hw⟩ := ih (z - t) hzt
      have hzst : dist (z - s) (z - t) < r := by
        rw [dist_sub_left, dist_comm]
        exact mem_ball.1 ht
      have hdist : |h (z - s) - h (z - t)| < M / 4 := by
        simpa [Real.dist_eq] using hr' hzst
      have hpn : M / 4 * p ^ (n + 1) ≤ M / 4 :=
        mul_le_of_le_one_right (by positivity) (pow_le_one₀ hp.le hp1)
      refine ⟨w, ?_⟩
      push_cast
      linarith [(abs_lt.1 hdist).1]
  obtain ⟨n, hn⟩ := exists_nat_gt (2 * C / (M / 2))
  have hδ : 0 < M / 4 * p ^ n := by positivity
  obtain ⟨z, hz⟩ := exists_lt_of_lt_ciSup (f := g) (show M - M / 4 * p ^ n < M by linarith)
  obtain ⟨w, hw⟩ := key n z hz
  rw [div_lt_iff₀ (by positivity)] at hn
  linarith [(abs_le.1 (hC z)).2, (abs_le.1 (hC w)).1]

/-- **Choquet–Deny lemma.** Let `μ` be a probability measure on a seminormed additive group. A
bounded, uniformly continuous function `h : E → ℝ` with `h x = ∫ t, h (x - t) ∂μ` for every `x`
is periodic with period `s` for every point `s` of the support of `μ`. -/
theorem periodic_of_forall_eq_integral_sub {h : E → ℝ} {C : ℝ} (hC : ∀ x, |h x| ≤ C)
    (hu : UniformContinuous h) (hh : ∀ x, h x = ∫ t, h (x - t) ∂μ) {s : E}
    (hs : s ∈ μ.support) : Function.Periodic h s := by
  intro x
  have hle := apply_le_apply_sub_of_mem_support hC hu hh hs (x + s)
  have hge := apply_le_apply_sub_of_mem_support (h := -h) (by simpa using hC) hu.neg
    (fun x ↦ by simp [integral_neg, hh x]) hs (x + s)
  simp only [Pi.neg_apply, add_sub_cancel_right, neg_le_neg_iff] at hle hge
  exact le_antisymm hle hge

end TauCeti

namespace MeasureTheory.Measure

section Harmonic

variable {E : Type*} [SeminormedAddCommGroup E] [MeasurableSpace E] [OpensMeasurableSpace E]
  {ν : Measure E} [IsProbabilityMeasure ν]

/-- **Choquet–Deny theorem, harmonic functions.** Let `ν` be a probability measure on a
seminormed additive group whose support generates a dense additive subgroup. A bounded, uniformly
continuous function `h : E → ℝ` with `h x = ∫ t, h (x - t) ∂ν` for every `x` is constant. -/
theorem apply_eq_of_forall_eq_integral_sub (hν : Dense (AddSubgroup.closure ν.support : Set E))
    {h : E → ℝ} {C : ℝ} (hC : ∀ x, |h x| ≤ C) (hu : UniformContinuous h)
    (hh : ∀ x, h x = ∫ t, h (x - t) ∂ν) (x y : E) : h x = h y := by
  -- The periods of the continuous function `h` form a closed subgroup of `E`.
  let P : AddSubgroup E :=
    { carrier := {c | Function.Periodic h c}
      zero_mem' := fun x ↦ by simp
      add_mem' := fun ha hb ↦ ha.add_period hb
      neg_mem' := fun ha ↦ ha.neg }
  have hP : IsClosed (P : Set E) := by
    have : (P : Set E) = ⋂ z, {c | h (z + c) = h z} := by ext; simp [P, Function.Periodic]
    rw [this]
    exact isClosed_iInter fun z ↦ isClosed_eq
      (hu.continuous.comp (continuous_const.add continuous_id)) continuous_const
  -- It contains the support of `ν`, hence the dense subgroup that the support generates.
  have hle : AddSubgroup.closure ν.support ≤ P :=
    (AddSubgroup.closure_le _).2 fun s hs ↦ TauCeti.periodic_of_forall_eq_integral_sub hC hu hh hs
  have hyx : y - x ∈ (P : Set E) := by
    rw [← hP.closure_eq]
    exact closure_mono hle (hν.closure_eq ▸ mem_univ _)
  simpa using (hyx x).symm

end Harmonic

variable {ν : Measure ℝ} [IsProbabilityMeasure ν]

/-- **Choquet–Deny theorem on `ℝ`, harmonic measures.** Let `ν` be a probability measure on `ℝ`
whose support generates a dense additive subgroup. A measure `η` on `ℝ` with `ν ∗ η = η` and with
uniformly bounded mass on the unit windows `[a, a + 1]` is the multiple `η (0, 1] • volume` of
Lebesgue measure. -/
theorem eq_smul_volume_of_conv_eq_self (hν : Dense (AddSubgroup.closure ν.support : Set ℝ))
    {η : Measure ℝ} {C : ℝ≥0} (hC : ∀ a : ℝ, η (Icc a (a + 1)) ≤ C) (hη : ν ∗ η = η) :
    η = η (Ioc 0 1) • volume := by
  have := isLocallyFiniteMeasure_of_measure_Icc_add_one_le hC
  -- Every compactly supported continuous function has the same integral against all
  -- translates of `η`.
  have htrans (a : ℝ) (f : C_c(ℝ, ℝ)) : ∫ y, f (y + a) ∂η = ∫ y, f y ∂η := by
    obtain ⟨B, hB⟩ := exists_abs_integral_apply_sub_le hC f
    -- The integrals of the translates of `f` form a `ν`-harmonic function, since `ν ∗ η = η`.
    have hh (x : ℝ) : ∫ y, f (y - x) ∂η = ∫ t, (∫ y, f (y - (x - t)) ∂η) ∂ν := by
      calc ∫ y, f (y - x) ∂η = ∫ y, f (y - x) ∂(ν ∗ η) := by rw [hη]
        _ = ∫ t, ∫ y, f (t + y - x) ∂η ∂ν :=
          integral_conv (by rw [hη]; exact f.integrable_apply_sub x)
        _ = _ := by congr with t; congr with y; congr 1; ring
    simpa using ν.apply_eq_of_forall_eq_integral_sub hν hB
      (uniformContinuous_integral_apply_sub hC f) hh (-a) 0
  have hinv : IsAddLeftInvariant η := by
    refine ⟨fun a ↦ ?_⟩
    have : (η.map (a + ·)).Regular := by
      simpa using Regular.map (μ := η) (Homeomorph.addLeft a)
    refine ext_of_integral_eq_on_compactlySupported fun f ↦ ?_
    rw [integral_map (f := fun y ↦ f y) (by fun_prop) f.continuous.aestronglyMeasurable]
    simpa [add_comm] using htrans a f
  have heq := isAddLeftInvariant_eq_smul η volume
  have hc : η (Ioc 0 1) = addHaarScalarFactor η volume := by
    conv_lhs => rw [heq]
    simp
  rw [hc]
  exact heq

end MeasureTheory.Measure
