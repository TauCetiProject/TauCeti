/-!
# Monge's infimum equals Kantorovich's minimum for continuous costs

Let `X` and `Y` be second-countable spaces with standard Borel structures, for instance Polish
spaces, with `Y` nonempty, and let `c : X × Y → [0, ∞]` be continuous, possibly unbounded and
possibly infinite. For a finite atomless source measure `μ`, Pratelli's Theorem B says that the
Monge infimum over transport maps equals the Kantorovich infimum over couplings. Neither a moment
condition nor an integrable envelope of the cost is needed, and the Monge infimum need not be
attained.

## Construction

Fix a coupling `π` of finite cost and `ε > 0`. Enumerate countable bases `tX` and `tY` of the two
topologies. The first `n` basic sets partition each space into finitely many cells, and the
products of these cells are the level-`n` cell rectangles. Call a rectangle good if `c` oscillates
by at most `ε` on it. By continuity, every point where `c` is finite lies in a good rectangle at
some level. Keep each point in the first good rectangle containing it. The source sides of the
kept rectangles form a graded laminar family, so the allocation theorem
`MeasureTheory.Measure.exists_disjoint_subset_measure_eq_of_laminar` gives disjoint source sets
`Z i` with the masses `π` puts on the pieces. Transporting `μ` on `Z i` to the second marginal
of the corresponding piece of `π` produces a map, and inside each good rectangle its cost
exceeds that of `π` by at most `ε` per unit mass.

## Main statements

* `TauCeti.IsCoupling.exists_hasLaw_transportMapCost_le` — for an atomless finite source, a
  nonempty target type and a continuous cost, transport maps approach the cost of every coupling;
* `TauCeti.mongeCost_eq_transportCost_of_continuous` — **Pratelli's theorem**: the Monge and
  Kantorovich values agree for continuous costs, atomless finite sources and a nonempty target
  type.

## References

* A. Pratelli, *On the equality between Monge's infimum and Kantorovich's minimum in optimal mass
  transportation*, Ann. I. H. Poincaré Probab. Statist. 43 (2007), 1--13, Theorem B and §4.
-/

public section

noncomputable section

open Function MeasureTheory Set Topology ProbabilityTheory
open scoped ENNReal

namespace TauCeti

/-! ### Cells generated by a sequence of sets -/

section Code

variable {X : Type*}

open Classical in
/-- The pattern of membership of `x` in the first `n` sets of the sequence `t`. The nonempty
fibres of `code t n` are the nonempty cells of Mathlib's partition `memPartition t n`. The label
is used instead of the cell because it ranges over the finite type `Fin n → Bool`: cells of all
levels are then indexed by a countable type, and every function of the label is measurable. -/
private def code (t : ℕ → Set X) (n : ℕ) (x : X) : Fin n → Bool :=
  fun k ↦ decide (x ∈ t k)

private theorem code_eq_code_of_le {t : ℕ → Set X} {m n : ℕ} (hmn : m ≤ n) {x x' : X}
    (h : code t n x = code t n x') : code t m x = code t m x' :=
  funext fun k ↦ by simpa [code] using congrFun h ⟨k, k.2.trans_le hmn⟩

private theorem measurable_code [MeasurableSpace X] {t : ℕ → Set X}
    (ht : ∀ k, MeasurableSet (t k)) (n : ℕ) : Measurable (code t n) :=
  Measurable.of_eval fun k ↦ measurable_to_bool (by simpa [code, preimage] using ht k)

/-- Two cells of one level are disjoint unless they have the same label. -/
private theorem disjoint_preimage_code {t : ℕ → Set X} {i j : Σ n, Fin n → Bool} (hij : i ≠ j)
    (hn : i.1 = j.1) : Disjoint (code t i.1 ⁻¹' {i.2}) (code t j.1 ⁻¹' {j.2}) := by
  obtain ⟨n, a⟩ := i
  obtain ⟨m, b⟩ := j
  obtain rfl : n = m := hn
  exact (disjoint_singleton.2 fun h ↦ hij (congrArg (Sigma.mk n) h)).preimage _

/-- The cells of all levels form a laminar family: a cell of a deeper level lies inside or is
disjoint from a cell of a shallower level. -/
private theorem preimage_code_subset_or_disjoint {t : ℕ → Set X} {i j : Σ n, Fin n → Bool}
    (hn : i.1 ≤ j.1) :
    code t j.1 ⁻¹' {j.2} ⊆ code t i.1 ⁻¹' {i.2} ∨
      Disjoint (code t i.1 ⁻¹' {i.2}) (code t j.1 ⁻¹' {j.2}) := by
  by_cases h : ∃ x, code t j.1 x = j.2 ∧ code t i.1 x = i.2
  · obtain ⟨x, hxj, hxi⟩ := h
    exact Or.inl fun x' (hx' : code t j.1 x' = j.2) ↦
      (code_eq_code_of_le hn (hx'.trans hxj.symm)).trans hxi
  · exact Or.inr (disjoint_left.2 fun x (hxi : code t i.1 x = i.2)
      (hxj : code t j.1 x = j.2) ↦ h ⟨x, hxj, hxi⟩)

/-- If `t` enumerates a basis of the topology, then every neighbourhood of `x` contains all the
points sharing the membership pattern of `x` in sufficiently many of the sets `t k`. -/
private theorem exists_forall_code_eq_imp_mem [TopologicalSpace X] {t : ℕ → Set X}
    (ht : TopologicalSpace.IsTopologicalBasis (range t)) {x : X} {U : Set X} (hU : U ∈ 𝓝 x) :
    ∃ n, ∀ x', code t n x' = code t n x → x' ∈ U := by
  obtain ⟨_, ⟨k, rfl⟩, hxk, hkU⟩ := ht.mem_nhds_iff.1 hU
  refine ⟨k + 1, fun x' h ↦ hkU ?_⟩
  simpa [code, hxk] using congrFun h ⟨k, k.lt_succ_self⟩

end Code

/-! ### Good cell rectangles and the pieces of the decomposition -/

section Rectangles

variable {X Y : Type*} (c : X × Y → ℝ≥0∞) (tX : ℕ → Set X) (tY : ℕ → Set Y) (ε : ℝ≥0∞)

/-- The pair of membership patterns of the two coordinates of `z`: it determines the level-`n`
cell rectangle containing `z`. -/
private def cellCode (n : ℕ) (z : X × Y) : (Fin n → Bool) × (Fin n → Bool) :=
  (code tX n z.1, code tY n z.2)

/-- The codes of the level-`n` cell rectangles on which `c` oscillates by at most `ε`. -/
private def goodCodes (n : ℕ) : Set ((Fin n → Bool) × (Fin n → Bool)) :=
  {p | ∀ w w', cellCode tX tY n w = p → cellCode tX tY n w' = p → c w ≤ c w' + ε}

/-- The union of the level-`n` cell rectangles on which `c` oscillates by at most `ε`. -/
private def good (n : ℕ) : Set (X × Y) := cellCode tX tY n ⁻¹' goodCodes c tX tY ε n

/-- The piece of the decomposition indexed by a level `i.1` and a source cell code `i.2`: the
points whose source has code `i.2` and whose first good cell rectangle has level `i.1`. -/
private def piece (i : Σ n, Fin n → Bool) : Set (X × Y) :=
  (code tX i.1 ⁻¹' {i.2}) ×ˢ univ ∩ disjointed (good c tX tY ε) i.1

variable {c tX tY ε}

private theorem measurableSet_good [MeasurableSpace X] [MeasurableSpace Y]
    (htX : ∀ k, MeasurableSet (tX k)) (htY : ∀ k, MeasurableSet (tY k)) (n : ℕ) :
    MeasurableSet (good c tX tY ε n) :=
  (((measurable_code htX n).comp measurable_fst).prodMk
    ((measurable_code htY n).comp measurable_snd)) (Set.to_countable _).measurableSet

private theorem measurableSet_piece [MeasurableSpace X] [MeasurableSpace Y]
    (htX : ∀ k, MeasurableSet (tX k)) (htY : ∀ k, MeasurableSet (tY k)) (i : Σ n, Fin n → Bool) :
    MeasurableSet (piece c tX tY ε i) :=
  ((measurable_code htX i.1 (measurableSet_singleton _)).prod MeasurableSet.univ).inter
    (MeasurableSet.disjointed (measurableSet_good htX htY) _)

private theorem pairwise_disjoint_piece : Pairwise (Disjoint on piece c tX tY ε) := by
  intro i j hij
  by_cases hn : i.1 = j.1
  · exact Disjoint.mono inter_subset_left inter_subset_left
      (disjoint_prod.2 (Or.inl (disjoint_preimage_code hij hn)))
  · exact Disjoint.mono inter_subset_right inter_subset_right (disjoint_disjointed _ hn)

private theorem iUnion_piece : ⋃ i, piece c tX tY ε i = ⋃ n, good c tX tY ε n := by
  refine Subset.antisymm (iUnion_subset fun i ↦ (inter_subset_right.trans
    (disjointed_subset _ _)).trans (subset_iUnion _ i.1)) fun z hz ↦ ?_
  rw [← iUnion_disjointed] at hz
  obtain ⟨n, hn⟩ := mem_iUnion.1 hz
  exact mem_iUnion.2 ⟨⟨n, code tX n z.1⟩, ⟨rfl, mem_univ _⟩, hn⟩

/-- By continuity, every point at which the cost is finite lies in a good cell rectangle. -/
private theorem exists_mem_good [TopologicalSpace X] [TopologicalSpace Y] (hc : Continuous c)
    (htX : TopologicalSpace.IsTopologicalBasis (range tX))
    (htY : TopologicalSpace.IsTopologicalBasis (range tY)) (hε : ε ≠ 0) {z : X × Y}
    (hz : c z ≠ ∞) : ∃ n, z ∈ good c tX tY ε n := by
  obtain ⟨x, y⟩ := z
  have hV : c ⁻¹' Icc (c (x, y) - ε / 2) (c (x, y) + ε / 2) ∈ 𝓝 (x, y) :=
    hc.continuousAt.preimage_mem_nhds (ENNReal.Icc_mem_nhds hz (ENNReal.half_pos hε).ne')
  obtain ⟨U, hU, W, hW, hUW⟩ := mem_nhds_prod_iff.1 hV
  obtain ⟨n₁, h₁⟩ := exists_forall_code_eq_imp_mem htX hU
  obtain ⟨n₂, h₂⟩ := exists_forall_code_eq_imp_mem htY hW
  have hmem (w : X × Y)
      (hw : cellCode tX tY (max n₁ n₂) w = cellCode tX tY (max n₁ n₂) (x, y)) :
      c w ∈ Icc (c (x, y) - ε / 2) (c (x, y) + ε / 2) := by
    rw [Prod.ext_iff] at hw
    exact hUW ⟨h₁ _ (code_eq_code_of_le (le_max_left _ _) hw.1),
      h₂ _ (code_eq_code_of_le (le_max_right _ _) hw.2)⟩
  refine ⟨max n₁ n₂, fun w w' hw hw' ↦ ?_⟩
  calc c w ≤ c (x, y) + ε / 2 := (hmem w hw).2
    _ ≤ c w' + ε / 2 + ε / 2 := by gcongr; exact tsub_le_iff_right.1 (hmem w' hw').1
    _ = c w' + ε := by rw [add_assoc, ENNReal.add_halves]

end Rectangles

/-! ### Transport maps approaching a coupling -/

section Approximation

variable {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
  {μ : Measure X} {ν : Measure Y} {π : Measure (X × Y)} {c : X × Y → ℝ≥0∞}

/-- The source sides of the pieces have room for their masses: the pieces whose source cell lies
inside a given one are disjoint subsets of that cell times `Y`. -/
private theorem IsCoupling.measure_piece_add_tsum_le (hπ : IsCoupling π μ ν) {tX : ℕ → Set X}
    {tY : ℕ → Set Y} (htX : ∀ k, MeasurableSet (tX k)) (htY : ∀ k, MeasurableSet (tY k))
    (ε : ℝ≥0∞) (i : Σ n, Fin n → Bool) :
    π (piece c tX tY ε i) + ∑' j : {j : Σ n, Fin n → Bool | i.1 < j.1 ∧
        code tX j.1 ⁻¹' {j.2} ⊆ code tX i.1 ⁻¹' {i.2}}, π (piece c tX tY ε j) ≤
      μ (code tX i.1 ⁻¹' {i.2}) := by
  set J : Set (Σ n, Fin n → Bool) :=
    {j | i.1 < j.1 ∧ code tX j.1 ⁻¹' {j.2} ⊆ code tX i.1 ⁻¹' {i.2}}
  have hm := measurableSet_piece (c := c) (ε := ε) htX htY
  have hd := pairwise_disjoint_piece (c := c) (tX := tX) (tY := tY) (ε := ε)
  have hdJ : Disjoint (piece c tX tY ε i) (⋃ j : J, piece c tX tY ε j) :=
    disjoint_iUnion_right.2 fun j : J ↦ hd fun h ↦ j.2.1.ne (congrArg Sigma.fst h)
  calc _ = π (piece c tX tY ε i ∪ ⋃ j : J, piece c tX tY ε j) := by
        rw [measure_union hdJ (MeasurableSet.iUnion fun j ↦ hm j),
          measure_iUnion (f := fun j : J ↦ piece c tX tY ε j)
            (fun j k hjk ↦ hd (Subtype.coe_injective.ne hjk)) fun j ↦ hm j]
    _ ≤ π ((code tX i.1 ⁻¹' {i.2}) ×ˢ univ) :=
        measure_mono (union_subset inter_subset_left (iUnion_subset fun j : J ↦
          inter_subset_left.trans (prod_mono j.2.2 subset_rfl)))
    _ = μ (code tX i.1 ⁻¹' {i.2}) :=
        hπ.measure_prod_univ (measurable_code htX i.1 (measurableSet_singleton i.2))

/-- On the source set allocated to a piece, the glued map costs at most the cost of `π` on that
piece, plus `ε` per unit mass. -/
private theorem setLIntegral_le_of_measurePreserving (hc : Measurable c) {tX : ℕ → Set X}
    {tY : ℕ → Set Y} (htX : ∀ k, MeasurableSet (tX k)) (htY : ∀ k, MeasurableSet (tY k))
    {ε : ℝ≥0∞} {i : Σ n, Fin n → Bool} {Z : Set X} (hZm : MeasurableSet Z)
    (hZ : Z ⊆ code tX i.1 ⁻¹' {i.2})
    {T : X → Y} (hT : MeasurePreserving T (μ.restrict Z) (π.restrict (piece c tX tY ε i)).snd) :
    ∫⁻ x in Z, c (x, T x) ∂μ ≤
      ∫⁻ z in piece c tX tY ε i, c z ∂π + ε * π (piece c tX tY ε i) := by
  obtain ⟨n, a⟩ := i
  set S := piece c tX tY ε ⟨n, a⟩
  have hSm : MeasurableSet S := measurableSet_piece htX htY _
  -- The least cost on the good rectangle with source cell `a` and target cell `b`.
  let H : (Fin n → Bool) → ℝ≥0∞ := fun b ↦ ⨅ (w : X × Y) (_ : cellCode tX tY n w = (a, b)), c w
  have hH : Measurable fun y ↦ H (code tY n y) :=
    (measurable_of_countable H).comp (measurable_code htY n)
  -- The target of `T` lies in target cells forming a good rectangle with `a`.
  let V : Set Y := {y | (a, code tY n y) ∈ goodCodes c tX tY ε n}
  have hVm : MeasurableSet V := measurable_code htY n
    (Set.to_countable {b | (a, b) ∈ goodCodes c tX tY ε n}).measurableSet
  have hSV : ∀ᵐ y ∂(π.restrict S).snd, y ∈ V := by
    rw [Measure.snd]
    refine (ae_map_iff measurable_snd.aemeasurable hVm).2 ?_
    refine ae_restrict_of_forall_mem hSm fun w hw ↦ ?_
    have hw₁ : code tX n w.1 = a := hw.1.1
    simpa [V, good, cellCode, hw₁] using disjointed_subset _ _ hw.2
  have hTV : ∀ᵐ x ∂μ.restrict Z, T x ∈ V :=
    ae_of_ae_map hT.aemeasurable (by rwa [hT.map_eq])
  have hbound : ∀ᵐ x ∂μ.restrict Z, c (x, T x) ≤ H (code tY n (T x)) + ε := by
    filter_upwards [hTV, ae_restrict_mem hZm] with x hxV hxZ
    have hx : code tX n x = a := hZ hxZ
    refine tsub_le_iff_right.1 (le_iInf₂ fun w hw ↦ tsub_le_iff_right.2 ?_)
    exact hxV (x, T x) w (by simp [cellCode, hx]) hw
  calc ∫⁻ x in Z, c (x, T x) ∂μ ≤ ∫⁻ x in Z, H (code tY n (T x)) + ε ∂μ := lintegral_mono_ae hbound
    _ = ∫⁻ y, H (code tY n y) + ε ∂(π.restrict S).snd :=
        hT.lintegral_comp (hH.add_const ε)
    _ = ∫⁻ w in S, H (code tY n w.2) + ε ∂π := by
        rw [Measure.snd, lintegral_map (hH.add_const ε) measurable_snd]
    _ ≤ ∫⁻ w in S, c w + ε ∂π := by
        refine setLIntegral_mono (hc.add_const ε) fun w hw ↦ ?_
        have hw₁ : code tX n w.1 = a := hw.1.1
        gcongr
        exact iInf₂_le w (by simp [cellCode, hw₁])
    _ = ∫⁻ z in S, c z ∂π + ε * π S := by
        rw [lintegral_add_right _ measurable_const, setLIntegral_const]

end Approximation

section Pratelli

variable {X Y : Type*} [TopologicalSpace X] [SecondCountableTopology X] [MeasurableSpace X]
  [OpensMeasurableSpace X] [StandardBorelSpace X] [TopologicalSpace Y] [SecondCountableTopology Y]
  [MeasurableSpace Y] [OpensMeasurableSpace Y] [StandardBorelSpace Y] [Nonempty Y]
  {μ : Measure X} {ν : Measure Y} {π : Measure (X × Y)} {c : X × Y → ℝ≥0∞}
  [IsFiniteMeasure μ] [NullSingletonClass μ]

/-- For a coupling of finite cost and every `ε > 0`, some transport map costs at most the cost of
the coupling plus `ε` per unit mass. -/
private theorem IsCoupling.exists_hasLaw_transportMapCost_le_add_mul (hπ : IsCoupling π μ ν)
    (hc : Continuous c) (hπc : ∫⁻ z, c z ∂π ≠ ∞) {ε : ℝ≥0∞} (hε : ε ≠ 0) :
    ∃ T : X → Y, HasLaw T ν μ ∧ transportMapCost c μ T ≤ ∫⁻ z, c z ∂π + ε * μ univ := by
  obtain ⟨tX, htX⟩ := TopologicalSpace.exists_seq_basis X
  obtain ⟨tY, htY⟩ := TopologicalSpace.exists_seq_basis Y
  have htXm (k : ℕ) : MeasurableSet (tX k) := (htX.isOpen ⟨k, rfl⟩).measurableSet
  have htYm (k : ℕ) : MeasurableSet (tY k) := (htY.isOpen ⟨k, rfl⟩).measurableSet
  have hcm : Measurable c := hc.measurable
  set S := piece c tX tY ε
  have hSm : ∀ i, MeasurableSet (S i) := measurableSet_piece htXm htYm
  have hSd : Pairwise (Disjoint on S) := pairwise_disjoint_piece
  -- `π`-almost every point has finite cost, so it lies in a good cell rectangle.
  have hScov : ∀ᵐ z ∂π, z ∈ ⋃ i, S i := by
    filter_upwards [ae_lt_top hcm hπc] with z hz
    rw [iUnion_piece]
    exact mem_iUnion.2 (exists_mem_good hc htX htY hε hz.ne)
  -- Allocate disjoint source sets with the masses of the pieces inside their source cells.
  obtain ⟨Z, hZm, hZA, hZd, hZμ⟩ := μ.exists_disjoint_subset_measure_eq_of_laminar
    (fun i ↦ measurable_code htXm i.1 (measurableSet_singleton _)) (fun i ↦ measure_ne_top _ _)
    Sigma.fst (fun _ _ ↦ disjoint_preimage_code)
    (fun _ _ hn ↦ preimage_code_subset_or_disjoint hn.le) (fun i ↦ π (S i))
    (hπ.measure_piece_add_tsum_le htXm htYm ε)
  obtain ⟨T, hT, hTZ, hZcov⟩ := hπ.exists_measurePreserving_restrict hSm hSd hScov hZm hZd hZμ
  refine ⟨T, hT.hasLaw, ?_⟩
  have hμZ : μ.restrict (⋃ i, Z i) = μ := Measure.restrict_eq_self_of_ae_mem (ae_iff.2 hZcov)
  calc transportMapCost c μ T = ∫⁻ x in ⋃ i, Z i, c (x, T x) ∂μ := by
        rw [hμZ, transportMapCost_def]
    _ = ∑' i, ∫⁻ x in Z i, c (x, T x) ∂μ := lintegral_iUnion hZm hZd _
    _ ≤ ∑' i, (∫⁻ z in S i, c z ∂π + ε * π (S i)) := tsum_le_tsum fun i ↦
        setLIntegral_le_of_measurePreserving hcm htXm htYm (hZm i) (hZA i) (hTZ i)
    _ = ∫⁻ z in ⋃ i, S i, c z ∂π + ε * π (⋃ i, S i) := by
        rw [tsum_add, ENNReal.tsum_mul_left, lintegral_iUnion hSm hSd,
          measure_iUnion hSd hSm]
    _ ≤ ∫⁻ z, c z ∂π + ε * μ univ := by
        rw [hπ.measure_univ_left]
        exact add_le_add (setLIntegral_le_lintegral _ _)
          (mul_le_mul' le_rfl (measure_mono (subset_univ _)))

/-- **Transport maps approach every coupling.** For an atomless finite source measure, a nonempty
target type and a continuous cost `c : X × Y → [0, ∞]` on second-countable standard Borel spaces,
the cost of every coupling `π` is approached from above by the costs of transport maps: for every
`η > 0` some transport map costs at most `∫⁻ c ∂π + η`. No integrability of the cost is
assumed. -/
theorem IsCoupling.exists_hasLaw_transportMapCost_le (hπ : IsCoupling π μ ν) (hc : Continuous c)
    {η : ℝ≥0∞} (hη : 0 < η) :
    ∃ T : X → Y, HasLaw T ν μ ∧ transportMapCost c μ T ≤ ∫⁻ z, c z ∂π + η := by
  by_cases hπc : ∫⁻ z, c z ∂π = ∞
  · obtain ⟨T, hT⟩ :=
      μ.exists_measurePreserving_of_nullSingleton_of_measure_univ_eq ν hπ.measure_univ_eq
    exact ⟨T, hT.hasLaw, by simp [hπc]⟩
  by_cases hμ : μ univ = 0
  · obtain ⟨T, hT, hle⟩ := hπ.exists_hasLaw_transportMapCost_le_add_mul hc hπc one_ne_zero
    exact ⟨T, hT, hle.trans (by simp [hμ])⟩
  · obtain ⟨T, hT, hle⟩ := hπ.exists_hasLaw_transportMapCost_le_add_mul hc hπc
      (ε := η / μ univ) (ENNReal.div_pos_iff.2 ⟨hη.ne', measure_ne_top _ _⟩).ne'
    exact ⟨T, hT, hle.trans_eq (by rw [ENNReal.div_mul_cancel hμ (measure_ne_top _ _)])⟩

/-- **Pratelli's theorem.** For an atomless finite source measure, a nonempty target type and a
continuous cost `c : X × Y → [0, ∞]` on second-countable standard Borel spaces, for instance
Polish spaces, the Monge and Kantorovich values agree, whether finite or not. The cost may be
unbounded and take the value `∞`, and the Monge infimum need not be attained. -/
theorem mongeCost_eq_transportCost_of_continuous (hc : Continuous c) :
    mongeCost c μ ν = transportCost c μ ν := by
  refine le_antisymm (le_transportCost fun π hπ ↦ ?_) (transportCost_le_mongeCost c μ ν)
  refine ENNReal.le_of_forall_pos_le_add fun η hη _ ↦ ?_
  obtain ⟨T, hT, hle⟩ := hπ.exists_hasLaw_transportMapCost_le hc (η := η) (by exact_mod_cast hη)
  exact (mongeCost_le_transportMapCost hT c).trans hle

end Pratelli

end TauCeti
