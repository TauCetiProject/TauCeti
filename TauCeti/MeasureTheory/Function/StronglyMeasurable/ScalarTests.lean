/-!
# Pettis measurability by scalar tests

A function `f : S → X` into a normed space is *weakly measurable* when every scalar function
`s ↦ x' (f s)`, for `x'` a continuous linear functional, is measurable. **Pettis' measurability
theorem** says that `f` is strongly measurable exactly when it is weakly measurable and has
separable range. This file proves it on a measurable space, without any measure, in two forms:

* `TauCeti.stronglyMeasurable_iff_scalar_tests`: the criterion with all of `StrongDual 𝕜 X` as
  tests, for an arbitrary normed space `X`;
* `TauCeti.stronglyMeasurable_iff_separating_tests`: when `f` takes values in a complete separable
  subspace `E`, any set of functionals separating the points of `E` suffices as tests.

Both rest on a comparison of σ-algebras. For a set `T` of functionals, `evalMeasurableSpace T` is
the σ-algebra on `X` generated by the evaluations `x ↦ x' x`, `x' ∈ T`; it is a definition, not
an instance. A map is measurable into it exactly when its scalar tests from `T` are measurable
(`measurable_evalMeasurableSpace_iff`), and a bounded linear map whose adjoint carries one family
of tests into another is measurable between the generated σ-algebras
(`measurable_evalMeasurableSpace_of_comp_mem`). On a separable space the generated σ-algebra is
the norm-Borel σ-algebra in two situations:

* `evalMeasurableSpace_eq_borel_of_norming`: `T` is norming, so that the tests recover the
  distances; by the Hahn–Banach theorem this applies to the whole dual
  (`evalMeasurableSpace_univ_eq_borel`);
* `evalMeasurableSpace_eq_borel_of_separating`: the space is complete and `T` separates points.
  A countable subfamily `T₀` still separates points, and the injective continuous map
  `x ↦ (x' x)_{x' ∈ T₀}` is a measurable embedding by the Lusin–Souslin theorem.

The single functional `0` generates the trivial σ-algebra (`evalMeasurableSpace_singleton_zero`),
so the comparison needs some separation of points.

## References

* B. J. Pettis, *On integration in vector spaces*, Trans. Amer. Math. Soc. **44** (1938),
  277–304.
* T. Hytönen, J. van Neerven, M. Veraar, L. Weis, *Analysis in Banach Spaces*, Vol. I,
  Springer, 2016, §1.1.a: Proposition 1.1.1, Corollary 1.1.2, Theorem 1.1.6 and
  Corollary 1.1.10.
-/

public section

open MeasureTheory Set TopologicalSpace

namespace TauCeti

section Field

variable {𝕜 X Z S : Type*} [NontriviallyNormedField 𝕜] [MeasurableSpace 𝕜]
  [NormedAddCommGroup X] [NormedSpace 𝕜 X] [NormedAddCommGroup Z] [NormedSpace 𝕜 Z]

/-- The σ-algebra on `X` generated by the scalar evaluations `x ↦ x' x` for `x'` in a set `T`
of continuous linear functionals: the coarsest σ-algebra for which each of them is measurable
for the given measurable structure on `𝕜` (the Borel one under `[BorelSpace 𝕜]`). -/
@[instance_reducible]
def evalMeasurableSpace (T : Set (StrongDual 𝕜 X)) : MeasurableSpace X :=
  ⨆ x' ∈ T, MeasurableSpace.comap x' inferInstance

/-- A map is measurable into the σ-algebra generated by the evaluations at `T` exactly when
each of its scalar tests `s ↦ x' (f s)`, `x' ∈ T`, is measurable. -/
theorem measurable_evalMeasurableSpace_iff {mS : MeasurableSpace S} {T : Set (StrongDual 𝕜 X)}
    {f : S → X} :
    Measurable[mS, evalMeasurableSpace T] f ↔ ∀ x' ∈ T, Measurable fun s ↦ x' (f s) := by
  simp only [measurable_iff_comap_le, evalMeasurableSpace, MeasurableSpace.comap_iSup,
    iSup_le_iff, MeasurableSpace.comap_comp, Function.comp_def]

/-- Each evaluation at a member of `T` is measurable for the σ-algebra that `T` generates. -/
theorem measurable_evalMeasurableSpace_apply {T : Set (StrongDual 𝕜 X)} {x' : StrongDual 𝕜 X}
    (hx' : x' ∈ T) : Measurable[evalMeasurableSpace T] x' :=
  measurable_evalMeasurableSpace_iff.1 measurable_id x' hx'

/-- Enlarging the set of tests enlarges the σ-algebra that they generate. -/
theorem evalMeasurableSpace_mono {T T' : Set (StrongDual 𝕜 X)} (h : T ⊆ T') :
    evalMeasurableSpace T ≤ evalMeasurableSpace T' :=
  biSup_mono h

/-- The σ-algebra generated by the evaluations at `T` is contained in `m` exactly when each
evaluation at a member of `T` is `m`-measurable. -/
theorem evalMeasurableSpace_le_iff {m : MeasurableSpace X} {T : Set (StrongDual 𝕜 X)} :
    evalMeasurableSpace T ≤ m ↔ ∀ x' ∈ T, Measurable[m] x' := by
  rw [← MeasurableSpace.comap_id (m := evalMeasurableSpace T), ← measurable_iff_comap_le,
    measurable_evalMeasurableSpace_iff]
  simp only [id_eq]

/-- The σ-algebra generated by evaluations is contained in the norm-Borel σ-algebra. -/
theorem evalMeasurableSpace_le_borel [BorelSpace 𝕜] (T : Set (StrongDual 𝕜 X)) :
    evalMeasurableSpace T ≤ borel X := by
  borelize X
  exact evalMeasurableSpace_le_iff.2 fun x' _ ↦ x'.continuous.measurable

/-- Bounded linear maps are measurable between σ-algebras generated by evaluations as soon as
their adjoint maps the tests on the target into the tests on the source. -/
theorem measurable_evalMeasurableSpace_of_comp_mem {T : Set (StrongDual 𝕜 X)}
    {W : Set (StrongDual 𝕜 Z)} {A : X →L[𝕜] Z} (h : ∀ z' ∈ W, z'.comp A ∈ T) :
    Measurable[evalMeasurableSpace T, evalMeasurableSpace W] A :=
  measurable_evalMeasurableSpace_iff.2 fun z' hz' ↦ by
    simpa only [ContinuousLinearMap.coe_comp, Function.comp_def] using
      measurable_evalMeasurableSpace_apply (h z' hz')

/-- The zero functional alone generates the trivial σ-algebra. -/
@[simp]
theorem evalMeasurableSpace_singleton_zero :
    evalMeasurableSpace ({0} : Set (StrongDual 𝕜 X)) = ⊥ := by
  simp only [evalMeasurableSpace, mem_singleton_iff, iSup_iSup_eq_left,
    FunLike.coe_zero, Pi.zero_def, MeasurableSpace.comap_const]

/-! ### Comparison with the norm-Borel σ-algebra -/

/-- On a separable normed space, a set `T` of functionals that is norming, in the sense that
`‖x‖` is the supremum of `‖x' x‖` over the members of `T` of norm at most one, generates the
norm-Borel σ-algebra. -/
theorem evalMeasurableSpace_eq_borel_of_norming [BorelSpace 𝕜] [SeparableSpace X]
    {T : Set (StrongDual 𝕜 X)} (hT : ∀ x : X, ∀ r < ‖x‖, ∃ x' ∈ T, ‖x'‖ ≤ 1 ∧ r < ‖x' x‖) :
    evalMeasurableSpace T = borel X := by
  refine le_antisymm (evalMeasurableSpace_le_borel T) ?_
  obtain ⟨d, hd⟩ := exists_dense_seq X
  -- Countably many tests nearly attain the norms of the points of a dense sequence.
  have hchoice (n k : ℕ) : ∃ x' ∈ T, ‖x'‖ ≤ 1 ∧ ‖d n‖ - 1 / (k + 1) < ‖x' (d n)‖ :=
    hT (d n) _ (sub_lt_self _ Nat.one_div_pos_of_nat)
  choose g hgT hg1 hgd using hchoice
  -- These tests recover the norm of every point.
  have hlub (x : X) : IsLUB {a | ∃ i : ℕ × ℕ, ‖g i.1 i.2 x‖ = a} ‖x‖ := by
    refine ⟨?_, fun b hb ↦ le_of_forall_pos_lt_add fun ε hε ↦ ?_⟩
    · rintro _ ⟨i, rfl⟩
      exact (g i.1 i.2).le_of_opNorm_le (hg1 _ _) x |>.trans_eq (one_mul _)
    obtain ⟨n, hn⟩ := hd.exists_dist_lt x (by positivity : 0 < ε / 3)
    obtain ⟨k, hk⟩ := exists_nat_one_div_lt (by positivity : 0 < ε / 3)
    have h1 : ‖g n k (x - d n)‖ ≤ ‖x - d n‖ :=
      (g n k).le_of_opNorm_le (hg1 _ _) _ |>.trans_eq (one_mul _)
    have h2 : ‖g n k x‖ ≤ b := hb ⟨(n, k), rfl⟩
    have h3 : ‖g n k (d n)‖ ≤ ‖g n k x‖ + ‖g n k (x - d n)‖ := by
      rw [map_sub, norm_sub_rev]
      exact norm_le_insert' _ _
    have h4 : ‖x‖ ≤ ‖d n‖ + ‖x - d n‖ := norm_le_insert' _ _
    rw [dist_eq_norm] at hn
    linarith [hgd n k]
  -- Hence every distance function is measurable for the σ-algebra generated by `T`.
  have hdist (y : X) : Measurable[evalMeasurableSpace T] fun x ↦ dist x y := by
    let _ := evalMeasurableSpace T
    refine Measurable.isLUB (f := fun (i : ℕ × ℕ) x ↦ ‖g i.1 i.2 x - g i.1 i.2 y‖)
      (fun i ↦ ?_) fun x ↦ ?_
    · exact (continuous_norm.comp (continuous_sub_right (g i.1 i.2 y))).measurable.comp
        (measurable_evalMeasurableSpace_apply (hgT i.1 i.2))
    · simpa only [dist_eq_norm, map_sub] using hlub (x - y)
  exact borel_le_of_measurable_dist hdist

/-- On a separable Banach space, a set `T` of functionals separating points generates the
norm-Borel σ-algebra. -/
theorem evalMeasurableSpace_eq_borel_of_separating [SecondCountableTopology 𝕜] [BorelSpace 𝕜]
    [CompleteSpace X] [SeparableSpace X]
    {T : Set (StrongDual 𝕜 X)} (hT : ∀ x : X, (∀ x' ∈ T, x' x = 0) → x = 0) :
    evalMeasurableSpace T = borel X := by
  refine le_antisymm (evalMeasurableSpace_le_borel T) ?_
  -- A countable subfamily `T₀` still separates points, by the Lindelöf property of `X × X`.
  obtain ⟨T₀, hT₀c, hT₀⟩ := isOpen_iUnion_countable
    (fun x' : T ↦ {p : X × X | (x' : StrongDual 𝕜 X) p.1 ≠ (x' : StrongDual 𝕜 X) p.2})
    fun x' ↦ isOpen_ne_fun (x'.val.continuous.comp continuous_fst)
      (x'.val.continuous.comp continuous_snd)
  have : Countable T₀ := hT₀c.to_subtype
  let Φ : X → T₀ → 𝕜 := fun x i ↦ (i.val : StrongDual 𝕜 X) x
  have hΦ : Function.Injective Φ := by
    intro a b hab
    by_contra hne
    obtain ⟨x', hx'T, hx'⟩ : ∃ x' ∈ T, x' (a - b) ≠ 0 := by
      by_contra! h
      exact hne (sub_eq_zero.1 (hT _ h))
    have hmem : (a, b) ∈ ⋃ i ∈ T₀, {p : X × X |
        (i : StrongDual 𝕜 X) p.1 ≠ (i : StrongDual 𝕜 X) p.2} := by
      rw [hT₀]
      exact mem_iUnion.2 ⟨⟨x', hx'T⟩, by simpa [sub_eq_zero] using hx'⟩
    obtain ⟨i, hi, hne'⟩ := mem_iUnion₂.1 hmem
    exact hne' (congrFun hab ⟨i, hi⟩)
  have hΦm : Measurable[evalMeasurableSpace T] Φ := by
    let _ := evalMeasurableSpace T
    exact Measurable.of_eval fun i : T₀ ↦ measurable_evalMeasurableSpace_apply i.val.property
  -- By the Lusin–Souslin theorem, `Φ` is a measurable embedding for the Borel σ-algebra.
  borelize X
  have hemb : MeasurableEmbedding Φ :=
    (continuous_pi fun i : T₀ ↦ (i.val : StrongDual 𝕜 X).continuous).measurableEmbedding hΦ
  intro s hs
  rw [← hΦ.preimage_image s]
  exact hΦm (hemb.measurableSet_image.2 hs)

/-! ### Pettis' measurability theorem -/

/-- A function with values in a separable subspace `E` is strongly measurable when its
corestriction to `E` passes the tests of a set `T` of functionals on `E` generating the
norm-Borel σ-algebra of `E`. -/
private theorem stronglyMeasurable_of_evalMeasurableSpace_eq_borel {mS : MeasurableSpace S}
    (E : Submodule 𝕜 X) [SeparableSpace E] {T : Set (StrongDual 𝕜 E)}
    (hT : evalMeasurableSpace T = borel E) {f : S → X} (hf : ∀ s, f s ∈ E)
    (htest : ∀ y ∈ T, Measurable fun s ↦ y ⟨f s, hf s⟩) : StronglyMeasurable f := by
  borelize ↥E
  have hφ : Measurable fun s ↦ (⟨f s, hf s⟩ : E) := by
    have := measurable_evalMeasurableSpace_iff.2 htest
    rwa [hT] at this
  exact continuous_subtypeVal.comp_stronglyMeasurable hφ.stronglyMeasurable

/-- **Pettis' measurability theorem with separating tests.** For a function with values in a
complete separable subspace `E`, any set `Y` of functionals separating the points of `E` is
enough to test strong measurability: `f` is strongly measurable exactly when each scalar
function `s ↦ x' (f s)`, `x' ∈ Y`, is measurable. -/
theorem stronglyMeasurable_iff_separating_tests [SecondCountableTopology 𝕜] [BorelSpace 𝕜]
    {mS : MeasurableSpace S} (E : Submodule 𝕜 X) [CompleteSpace E] [SeparableSpace E]
    {Y : Set (StrongDual 𝕜 X)} (hsep : ∀ x ∈ E, (∀ x' ∈ Y, x' x = 0) → x = 0) {f : S → X}
    (hf : ∀ s, f s ∈ E) :
    StronglyMeasurable f ↔ ∀ x' ∈ Y, Measurable fun s ↦ x' (f s) := by
  refine ⟨fun h x' _ ↦ (x'.continuous.comp_stronglyMeasurable h).measurable, fun htest ↦ ?_⟩
  refine stronglyMeasurable_of_evalMeasurableSpace_eq_borel E
    (evalMeasurableSpace_eq_borel_of_separating
      (T := (fun x' : StrongDual 𝕜 X ↦ x'.comp E.subtypeL) '' Y) fun x hx ↦ ?_) hf ?_
  · refine Submodule.coe_eq_zero.1 (hsep x x.property fun x' hx' ↦ ?_)
    simpa only [ContinuousLinearMap.comp_apply, Submodule.subtypeL_apply] using
      hx _ (mem_image_of_mem _ hx')
  · rintro _ ⟨x', hx', rfl⟩
    simpa only [ContinuousLinearMap.comp_apply, Submodule.subtypeL_apply] using htest x' hx'

end Field

section RCLike

variable {𝕜 X S : Type*} [RCLike 𝕜] [NormedAddCommGroup X] [NormedSpace 𝕜 X]

/-- On a separable normed space, the evaluations at all continuous linear functionals generate the
norm-Borel σ-algebra. -/
theorem evalMeasurableSpace_univ_eq_borel [SeparableSpace X] :
    evalMeasurableSpace (univ : Set (StrongDual 𝕜 X)) = borel X :=
  evalMeasurableSpace_eq_borel_of_norming fun x r hr ↦
    let ⟨g, hg, hgx⟩ := exists_dual_vector'' 𝕜 x
    ⟨g, mem_univ g, hg, by simpa [hgx] using hr⟩

/-- **Pettis' measurability theorem.** A function into a normed space is strongly measurable
exactly when its values lie in a closed separable subspace and each scalar function
`s ↦ x' (f s)`, for `x'` a continuous linear functional, is measurable. -/
theorem stronglyMeasurable_iff_scalar_tests {mS : MeasurableSpace S} {f : S → X} :
    StronglyMeasurable f ↔
      (∃ E : Submodule 𝕜 X, IsClosed (E : Set X) ∧ IsSeparable (E : Set X) ∧ ∀ s, f s ∈ E) ∧
        ∀ x' : StrongDual 𝕜 X, Measurable fun s ↦ x' (f s) := by
  refine ⟨fun hf ↦ ⟨⟨(Submodule.span 𝕜 (range f)).topologicalClosure,
    Submodule.isClosed_topologicalClosure _, ?_, fun s ↦ ?_⟩,
    fun x' ↦ (x'.continuous.comp_stronglyMeasurable hf).measurable⟩, ?_⟩
  · rw [Submodule.topologicalClosure_coe]
    exact hf.isSeparable_range.span.closure
  · exact Submodule.le_topologicalClosure _ (Submodule.subset_span (mem_range_self s))
  rintro ⟨⟨E, -, hEsep, hfE⟩, htest⟩
  have : SeparableSpace E := hEsep.separableSpace
  refine stronglyMeasurable_of_evalMeasurableSpace_eq_borel E evalMeasurableSpace_univ_eq_borel
    hfE fun y _ ↦ ?_
  -- Each functional on `E` extends to `X`, by the Hahn–Banach theorem.
  obtain ⟨g, hg, -⟩ := exists_extension_norm_eq E y
  simpa only [← hg] using htest g

end RCLike

end TauCeti
