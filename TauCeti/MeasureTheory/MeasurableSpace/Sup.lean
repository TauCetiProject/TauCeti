module

public import Mathlib.MeasureTheory.MeasurableSpace.Basic
public import Mathlib.MeasureTheory.PiSystem
import Mathlib.MeasureTheory.MeasurableSpace.Constructions

/-!
# The join of two σ-algebras is generated by intersections

For σ-algebras `mF` and `mG` on the same type, the sets `tF ∩ tG` with `tF` measurable for `mF`
and `tG` measurable for `mG` form a π-system generating the join `mF ⊔ mG`. Statements about a
join, such as independence or conditional independence of `mF ⊔ mG` from a third σ-algebra, are
checked on this π-system.

For a label `a : Ω → ι`, the join `m ⊔ comap a ⊤` of a σ-algebra `m` with the σ-algebra generated
by `a` consists of unions `⋃ i, E i ∩ a ⁻¹' {i}` with every `E i` measurable for `m`
(`MeasurableSpace.exists_eq_iUnion_inter_of_measurableSet_sup_comap`), and for countably many
labels of exactly these unions (`MeasurableSpace.measurableSet_sup_comap_iff`); it is a
sub-σ-algebra of the ambient one when `m` is and `a` takes countably many values on measurable
atoms (`MeasurableSpace.sup_comap_le_of_measurableSet_preimage_singleton`).
-/

public section

open MeasureTheory

namespace MeasurableSpace

variable {Ω : Type*}

/-- The sets `tF ∩ tG`, with `tF` being `mF`-measurable and `tG` being `mG`-measurable, form a
π-system. -/
theorem isPiSystem_inter_measurableSet (mF mG : MeasurableSpace Ω) :
    IsPiSystem
      {s : Set Ω | ∃ tF tG, MeasurableSet[mF] tF ∧ MeasurableSet[mG] tG ∧ s = tF ∩ tG} := by
  rintro s₁ ⟨tF₁, tG₁, htF₁, htG₁, rfl⟩ s₂ ⟨tF₂, tG₂, htF₂, htG₂, rfl⟩ _
  exact ⟨tF₁ ∩ tF₂, tG₁ ∩ tG₂, htF₁.inter htF₂, htG₁.inter htG₂, by
    ext ω; simp only [Set.mem_inter_iff]; tauto⟩

/-- The join `mF ⊔ mG` is generated by the sets `tF ∩ tG` with `tF` being `mF`-measurable and
`tG` being `mG`-measurable. -/
theorem sup_eq_generateFrom_inter_measurableSet (mF mG : MeasurableSpace Ω) :
    mF ⊔ mG = generateFrom
      {s : Set Ω | ∃ tF tG, MeasurableSet[mF] tF ∧ MeasurableSet[mG] tG ∧ s = tF ∩ tG} := by
  refine le_antisymm (sup_le ?_ ?_) (generateFrom_le ?_)
  · intro s hs
    exact measurableSet_generateFrom ⟨s, Set.univ, hs, MeasurableSet.univ, (Set.inter_univ s).symm⟩
  · intro s hs
    exact measurableSet_generateFrom ⟨Set.univ, s, MeasurableSet.univ, hs, (Set.univ_inter s).symm⟩
  · rintro s ⟨tF, tG, htF, htG, rfl⟩
    exact ((le_sup_left : mF ≤ mF ⊔ mG) _ htF).inter ((le_sup_right : mG ≤ mF ⊔ mG) _ htG)

variable {ι α : Type*} [MeasurableSpace α]

/-- A cylinder of the block over `S` is the preimage, under the map `ω ↦ (X p ω)ₚ`, of a
measurable cylinder over a finite subset of `S`: this describes the members of `piiUnionInter` of
the comap σ-algebras. -/
theorem exists_eq_preimage_pi_of_mem_piiUnionInter {X : ι → Ω → α} {S : Set ι} {A : Set Ω}
    (hA : A ∈ piiUnionInter
      (fun p ↦ {s | MeasurableSet[MeasurableSpace.comap (X p) inferInstance] s}) S) :
    ∃ (t : Finset ι) (C : ι → Set α), ↑t ⊆ S ∧ (∀ p ∈ t, MeasurableSet (C p)) ∧
      A = (fun ω p ↦ X p ω) ⁻¹' Set.pi (↑t) C := by
  classical
  obtain ⟨t, ht, f, hf, rfl⟩ := hA
  choose! C hC hCeq using fun p hp ↦ MeasurableSpace.measurableSet_comap.1 (hf p hp)
  refine ⟨t, C, ht, hC, ?_⟩
  ext ω
  simp only [Set.mem_iInter, Set.mem_preimage, Set.mem_pi, Finset.mem_coe]
  exact forall₂_congr fun p hp ↦ by rw [← hCeq p hp, Set.mem_preimage]

section Label

variable {ι : Type*} {m : MeasurableSpace Ω}

/-- Every set measurable for `m ⊔ comap a ⊤`, the join of `m` with the σ-algebra generated by the
label `a`, is a union `⋃ i, E i ∩ a ⁻¹' {i}` with every `E i` measurable for `m`. -/
theorem exists_eq_iUnion_inter_of_measurableSet_sup_comap {a : Ω → ι} {s : Set Ω}
    (hs : MeasurableSet[m ⊔ MeasurableSpace.comap a ⊤] s) :
    ∃ E : ι → Set Ω, (∀ i, MeasurableSet[m] (E i)) ∧ s = ⋃ i, E i ∩ a ⁻¹' {i} := by
  let M : MeasurableSpace Ω :=
    { MeasurableSet' := fun s ↦ ∃ E : ι → Set Ω, (∀ i, MeasurableSet[m] (E i)) ∧
        s = ⋃ i, E i ∩ a ⁻¹' {i}
      measurableSet_empty := ⟨fun _ ↦ ∅, fun _ ↦ MeasurableSet.empty, by simp⟩
      measurableSet_compl := by
        rintro s ⟨E, hE, rfl⟩
        refine ⟨fun i ↦ (E i)ᶜ, fun i ↦ (hE i).compl, ?_⟩
        ext x
        simp only [Set.mem_compl_iff, Set.mem_iUnion, Set.mem_inter_iff, Set.mem_preimage,
          Set.mem_singleton_iff, not_exists, not_and]
        constructor
        · intro h
          exact ⟨a x, fun hx ↦ h (a x) hx rfl, rfl⟩
        · rintro ⟨i, hi, rfl⟩ j hj hji
          rw [hji] at hi
          exact hi hj
      measurableSet_iUnion := by
        intro f hf
        choose E hE hfE using hf
        refine ⟨fun i ↦ ⋃ n, E n i, fun i ↦ MeasurableSet.iUnion fun n ↦ hE n i, ?_⟩
        ext x
        simp [hfE] }
  have hM : m ⊔ MeasurableSpace.comap a ⊤ ≤ M := by
    refine sup_le (fun s hs ↦ ⟨fun _ ↦ s, fun _ ↦ hs, by ext x; simp⟩) ?_
    rintro s ⟨t, -, rfl⟩
    classical
    refine ⟨fun i ↦ if i ∈ t then Set.univ else ∅, fun i ↦ ?_, ?_⟩
    · by_cases hi : i ∈ t
      · simp only [hi, ite_true]
        exact @MeasurableSet.univ Ω m
      · simp only [hi, ite_false]
        exact @MeasurableSet.empty Ω m
    · ext x
      simp
  exact hM s hs

/-- For a label into a countable type with measurable atoms, the join of a sub-σ-algebra `m` with
the σ-algebra generated by the label is a sub-σ-algebra of the ambient one. -/
theorem sup_comap_le_of_measurableSet_preimage_singleton [Countable ι] {mΩ : MeasurableSpace Ω}
    (hm : m ≤ mΩ) {a : Ω → ι} (ha : ∀ i, MeasurableSet (a ⁻¹' {i})) :
    m ⊔ MeasurableSpace.comap a ⊤ ≤ mΩ :=
  letI : MeasurableSpace ι := ⊤
  sup_le hm (measurable_to_countable' ha).comap_le

/-- The atom `a ⁻¹' {i}` of a label is measurable for the join `m ⊔ comap a ⊤`. -/
theorem measurableSet_preimage_singleton_sup_comap (a : Ω → ι) (i : ι) :
    MeasurableSet[m ⊔ MeasurableSpace.comap a ⊤] (a ⁻¹' {i}) :=
  le_sup_right (a := m) _ ⟨{i}, trivial, rfl⟩

/-- For a label into a countable type, the sets measurable for `m ⊔ comap a ⊤` are exactly the
unions `⋃ i, E i ∩ a ⁻¹' {i}` with every `E i` measurable for `m`. -/
theorem measurableSet_sup_comap_iff [Countable ι] {a : Ω → ι} {s : Set Ω} :
    MeasurableSet[m ⊔ MeasurableSpace.comap a ⊤] s ↔
      ∃ E : ι → Set Ω, (∀ i, MeasurableSet[m] (E i)) ∧ s = ⋃ i, E i ∩ a ⁻¹' {i} := by
  refine ⟨exists_eq_iUnion_inter_of_measurableSet_sup_comap, ?_⟩
  rintro ⟨E, hE, rfl⟩
  exact .iUnion fun i ↦ (le_sup_left (b := MeasurableSpace.comap a ⊤) _ (hE i)).inter
    (measurableSet_preimage_singleton_sup_comap a i)

end Label

end MeasurableSpace
