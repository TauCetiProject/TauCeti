module

public import Mathlib.MeasureTheory.MeasurableSpace.Basic
public import Mathlib.MeasureTheory.PiSystem

/-!
# The join of two σ-algebras is generated by intersections

For σ-algebras `mF` and `mG` on the same type, the sets `tF ∩ tG` with `tF` measurable for `mF`
and `tG` measurable for `mG` form a π-system generating the join `mF ⊔ mG`. Statements about a
join, such as independence or conditional independence of `mF ⊔ mG` from a third σ-algebra, are
checked on this π-system.
-/

public section

open MeasureTheory

namespace MeasurableSpace

variable {Ω : Type*}

/-- The sets `tF ∩ tG`, with `tF` being `mF`-measurable and `tG` being `mG`-measurable, form a
π-system. -/
theorem isPiSystem_inter_measurableSet (mF mG : MeasurableSpace Ω) :
    IsPiSystem
      {s : Set Ω | ∃ tF tG, MeasurableSet[mF] tF ∧ MeasurableSet[mG] tG ∧ s = tF ∩ tG} := by
  rintro s₁ ⟨tF₁, tG₁, htF₁, htG₁, rfl⟩ s₂ ⟨tF₂, tG₂, htF₂, htG₂, rfl⟩ _
  exact ⟨tF₁ ∩ tF₂, tG₁ ∩ tG₂, htF₁.inter htF₂, htG₁.inter htG₂, by
    ext ω; simp only [Set.mem_inter_iff]; tauto⟩

/-- The join `mF ⊔ mG` is generated by the sets `tF ∩ tG` with `tF` being `mF`-measurable and
`tG` being `mG`-measurable. -/
theorem sup_eq_generateFrom_inter_measurableSet (mF mG : MeasurableSpace Ω) :
    mF ⊔ mG = generateFrom
      {s : Set Ω | ∃ tF tG, MeasurableSet[mF] tF ∧ MeasurableSet[mG] tG ∧ s = tF ∩ tG} := by
  refine le_antisymm (sup_le ?_ ?_) (generateFrom_le ?_)
  · intro s hs
    exact measurableSet_generateFrom ⟨s, Set.univ, hs, MeasurableSet.univ, (Set.inter_univ s).symm⟩
  · intro s hs
    exact measurableSet_generateFrom ⟨Set.univ, s, MeasurableSet.univ, hs, (Set.univ_inter s).symm⟩
  · rintro s ⟨tF, tG, htF, htG, rfl⟩
    exact ((le_sup_left : mF ≤ mF ⊔ mG) _ htF).inter ((le_sup_right : mG ≤ mF ⊔ mG) _ htG)

variable {ι α : Type*} [MeasurableSpace α]

/-- A cylinder of the block over `S` is the preimage, under the map `ω ↦ (X p ω)ₚ`, of a
measurable cylinder over a finite subset of `S`: this describes the members of `piiUnionInter` of
the comap σ-algebras. -/
theorem exists_eq_preimage_pi_of_mem_piiUnionInter {X : ι → Ω → α} {S : Set ι} {A : Set Ω}
    (hA : A ∈ piiUnionInter
      (fun p ↦ {s | MeasurableSet[MeasurableSpace.comap (X p) inferInstance] s}) S) :
    ∃ (t : Finset ι) (C : ι → Set α), ↑t ⊆ S ∧ (∀ p ∈ t, MeasurableSet (C p)) ∧
      A = (fun ω p ↦ X p ω) ⁻¹' Set.pi (↑t) C := by
  classical
  obtain ⟨t, ht, f, hf, rfl⟩ := hA
  choose! C hC hCeq using fun p hp ↦ MeasurableSpace.measurableSet_comap.1 (hf p hp)
  refine ⟨t, C, ht, hC, ?_⟩
  ext ω
  simp only [Set.mem_iInter, Set.mem_preimage, Set.mem_pi, Finset.mem_coe]
  exact forall₂_congr fun p hp ↦ by rw [← hCeq p hp, Set.mem_preimage]

end MeasurableSpace
