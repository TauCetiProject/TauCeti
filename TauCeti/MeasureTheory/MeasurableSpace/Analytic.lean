namespace MeasureTheory

/-- Let `f` take values in a complete linear order. If its strict sublevel is measurable on the
product of a standard Borel space and a Polish Borel space, then the corresponding strict sublevel
of the pointwise infimum over the first factor is analytic. This is the measurable-projection
principle used by infimal transforms. -/
theorem analyticSet_setOf_iInf_lt
    {X Y A : Type*} [MeasurableSpace X] [StandardBorelSpace X]
    [TopologicalSpace Y] [PolishSpace Y] [MeasurableSpace Y] [BorelSpace Y]
    [CompleteLinearOrder A] (f : X × Y → A) (a : A)
    (h : MeasurableSet {z | f z < a}) :
    AnalyticSet {y | (⨅ x, f (x, y)) < a} := by
  have himage : AnalyticSet (Prod.snd '' {z : X × Y | f z < a}) :=
    h.analyticSet_image measurable_snd
  convert himage using 1
  ext y
  simp only [mem_ofPred_eq, mem_image, Prod.exists, iInf_lt_iff]
  constructor
  · rintro ⟨x, hx⟩
    exact ⟨x, y, hx, rfl⟩
  · rintro ⟨x, y', hxy, rfl⟩
    exact ⟨x, hxy⟩

/-- A set with inner compact approximations of arbitrary outer-measure accuracy contains a
measurable subset whose complement within it is null. -/
private lemma exists_measurableSet_subset_measure_sdiff_eq_zero_of_forall_exists_isCompact
    {X : Type*} [TopologicalSpace X] [T2Space X] [MeasurableSpace X] [OpensMeasurableSpace X]
    {μ : Measure X} [IsFiniteMeasure μ] {S : Set X}
    (h : ∀ ε : ℝ≥0∞, ε ≠ 0 →
      ∃ K : Set X, IsCompact K ∧ K ⊆ S ∧ μ S ≤ μ K + ε) :
    ∃ G : Set X, MeasurableSet G ∧ G ⊆ S ∧ μ (S \ G) = 0 := by
  have hKs : ∀ n : ℕ, ∃ K : Set X, IsCompact K ∧ K ⊆ S ∧
      μ S ≤ μ K + ((n : ℝ≥0∞) + 1)⁻¹ := fun n => h _ (by simp)
  choose K hK_compact hK_sub hK_le using hKs
  set G : Set X := ⋃ n, K n
  have hG_meas : MeasurableSet G :=
    MeasurableSet.iUnion fun n => (hK_compact n).isClosed.measurableSet
  have hG_sub : G ⊆ S := Set.iUnion_subset hK_sub
  have hμSG : μ S ≤ μ G := by
    refine ENNReal.le_of_forall_pos_le_add fun δ hδ _ => ?_
    have hδ_ne : (δ : ℝ≥0∞) ≠ 0 := by exact_mod_cast hδ.ne'
    obtain ⟨n, hn⟩ := ENNReal.exists_inv_nat_lt hδ_ne
    have hn' : ((n : ℝ≥0∞) + 1)⁻¹ ≤ (δ : ℝ≥0∞) := by
      refine le_trans ?_ hn.le
      gcongr
      exact le_self_add
    calc
      μ S ≤ μ (K n) + ((n : ℝ≥0∞) + 1)⁻¹ := hK_le n
      _ ≤ μ G + δ := add_le_add (measure_mono (Set.subset_iUnion K n)) hn'
  have hS_sub_H : S ⊆ toMeasurable μ S := subset_toMeasurable μ S
  have hHG_null : μ (toMeasurable μ S \ G) = 0 := by
    have hG_in_H : G ⊆ toMeasurable μ S := hG_sub.trans hS_sub_H
    rw [measure_sdiff hG_in_H hG_meas.nullMeasurableSet (measure_ne_top μ G),
      measure_toMeasurable]
    exact tsub_eq_zero_of_le hμSG
  have hSG_null : μ (S \ G) = 0 :=
    measure_mono_null (Set.sdiff_subset_sdiff_left hS_sub_H) hHG_null
  exact ⟨G, hG_meas, hG_sub, hSG_null⟩

section UniversalMeasurability

variable {X : Type*} [TopologicalSpace X] [TopologicalSpace.MetrizableSpace X]
  [MeasurableSpace X] [OpensMeasurableSpace X]

/-- **Lusin's universal-measurability theorem.** An analytic subset of a metrizable space is
null-measurable with respect to every s-finite measure on a measurable space containing the Borel
sets, equivalently measurable in the completion of that measure. -/
theorem AnalyticSet.nullMeasurableSet
    {S : Set X} (hS : AnalyticSet S) (μ : Measure X) [SFinite μ] :
    NullMeasurableSet S μ := by
  have hG : ∀ n : ℕ, ∃ G : Set X, MeasurableSet G ∧ G ⊆ S ∧
      sfiniteSeq μ n (S \ G) = 0 := fun n =>
    exists_measurableSet_subset_measure_sdiff_eq_zero_of_forall_exists_isCompact fun _ hε =>
      (IsChoquetCapacity.measure (sfiniteSeq μ n)).exists_isCompact_subset_le_add hS
        (measure_ne_top _ _) hε
  choose G hG_meas hG_sub hG_null using hG
  set B : Set X := ⋃ n, G n
  have hB_meas : MeasurableSet B := MeasurableSet.iUnion hG_meas
  have hB_sub : B ⊆ S := Set.iUnion_subset hG_sub
  have hSB_null : μ (S \ B) = 0 := by
    rw [← sum_sfiniteSeq μ, Measure.sum_apply_eq_zero]
    intro n
    exact measure_mono_null (Set.sdiff_subset_sdiff_right (Set.subset_iUnion G n)) (hG_null n)
  have hS_eq : S = B ∪ (S \ B) := by rw [Set.union_sdiff_cancel hB_sub]
  rw [hS_eq]
  exact hB_meas.nullMeasurableSet.union (NullMeasurableSet.of_null hSB_null)

/-- Every set in the measurable space generated by the analytic subsets of a metrizable space is
null-measurable for every s-finite measure on a measurable space containing the Borel sets. -/
theorem NullMeasurableSet.of_generateFrom_analyticSet
    {S : Set X} (μ : Measure X) [SFinite μ]
    (hS : MeasurableSet[MeasurableSpace.generateFrom {T : Set X | AnalyticSet T}] S) :
    NullMeasurableSet S μ := by
  refine MeasurableSpace.generateFrom_induction {T : Set X | AnalyticSet T}
    (fun T _ => NullMeasurableSet T μ)
    (fun T hT _ => AnalyticSet.nullMeasurableSet hT μ)
    MeasurableSet.empty.nullMeasurableSet (fun _ _ hT => hT.compl)
    (fun _ _ hT => NullMeasurableSet.iUnion hT) S hS

/-- A function measurable for the measurable space generated by analytic sets is
null-measurable for every s-finite measure on a measurable space containing the Borel sets. -/
theorem nullMeasurable_of_measurable_generateFrom_analyticSet
    {A : Type*} [MeasurableSpace A] {g : X → A} (μ : Measure X) [SFinite μ]
    (hg : Measurable[MeasurableSpace.generateFrom {T : Set X | AnalyticSet T}] g) :
    NullMeasurable g μ :=
  fun _ hs => NullMeasurableSet.of_generateFrom_analyticSet μ (hg hs)

end UniversalMeasurability

end MeasureTheory

