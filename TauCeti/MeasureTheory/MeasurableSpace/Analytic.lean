namespace TauCeti

open _root_.MeasureTheory

namespace MeasureTheory

/-- Let `f` take values in a complete linear order. If its strict sublevel is measurable on the
product of two standard Borel spaces, the second carrying a second-countable topology whose open
sets are measurable, then the corresponding strict sublevel of the pointwise infimum over the first
factor is analytic. This is the measurable-projection principle used by infimal transforms. -/
theorem analyticSet_setOf_iInf_lt
    {X Y A : Type*} [MeasurableSpace X] [StandardBorelSpace X]
    [TopologicalSpace Y] [SecondCountableTopology Y] [MeasurableSpace Y] [StandardBorelSpace Y]
    [OpensMeasurableSpace Y] [CompleteLinearOrder A] (f : X × Y → A) (a : A)
    (h : MeasurableSet {z | f z < a}) :
    AnalyticSet {y | (⨅ x, f (x, y)) < a} := by
  convert h.analyticSet_image measurable_snd using 1
  ext y
  simp [iInf_lt_iff]

/-- For continuous `f` on Baire space and coordinate bounds `N`, a point in all the finite-stage
image closures is already the image of a point satisfying every coordinate bound. -/
private theorem iInter_closure_image_subset_image_Iic
    {X : Type*} [TopologicalSpace X] [T2Space X] {f : (ℕ → ℕ) → X} (hf : Continuous f)
    (N : ℕ → ℕ) :
    ⋂ n, closure (f '' {β | ∀ k < n, β k ≤ N k}) ⊆ f '' Iic N := by
  intro x hx
  -- Points whose first `n` coordinates are bounded and whose images approach `x` form a
  -- decreasing family of nontrivial filters; refine its infimum to an ultrafilter `𝓤`.
  set 𝓕 : ℕ → Filter (ℕ → ℕ) := fun n => comap f (𝓝 x) ⊓ 𝓟 {β | ∀ k < n, β k ≤ N k}
  have hne : (⨅ n, 𝓕 n).NeBot := by
    refine iInf_neBot_of_directed' (Antitone.directed_ge fun m n hmn => ?_) fun n => ?_
    · exact inf_le_inf_left _ (principal_mono.2 fun β hβ k hk => hβ k (hk.trans_le hmn))
    · have := mem_closure_iff_clusterPt.1 (mem_iInter.1 hx n)
      exact (comap_inf_principal_neBot_of_image_mem this
        (mem_inf_of_right (mem_principal_self _))).mono
        (inf_le_inf_right _ (comap_mono inf_le_left))
  let 𝓤 := Ultrafilter.of (⨅ n, 𝓕 n)
  have h𝓤 : ∀ n, (𝓤 : Filter (ℕ → ℕ)) ≤ 𝓕 n := fun n => (Ultrafilter.of_le _).trans (iInf_le _ n)
  -- Each coordinate eventually lies in a finite set, so it converges along `𝓤`.
  have hcoord : ∀ k, ∃ b ∈ Iic (N k), ↑(𝓤.map fun β => β k) ≤ 𝓝 b := fun k =>
    (finite_Iic (N k)).isCompact.ultrafilter_le_nhds _ <| le_principal_iff.2 <| mem_map.2 <|
      mem_of_superset (le_principal_iff.1 ((h𝓤 (k + 1)).trans inf_le_right))
        fun β hβ => hβ k k.lt_succ_self
  choose b hb hlim using hcoord
  have hb_lim : Tendsto id (𝓤 : Filter (ℕ → ℕ)) (𝓝 b) := tendsto_pi_nhds.2 hlim
  exact ⟨b, hb, tendsto_nhds_unique ((hf.tendsto b).comp hb_lim)
    (tendsto_iff_comap.2 ((h𝓤 0).trans inf_le_left))⟩

/-- The range of a continuous map from Baire space admits inner compact approximations in outer
measure. -/
private lemma exists_isCompact_subset_range_measure_le
    {X : Type*} [TopologicalSpace X] [T2Space X] [MeasurableSpace X] [OpensMeasurableSpace X]
    {μ : Measure X} [IsFiniteMeasure μ] {f : (ℕ → ℕ) → X} (hf : Continuous f)
    {ε : ℝ≥0∞} (hε : ε ≠ 0) :
    ∃ K : Set X, IsCompact K ∧ K ⊆ range f ∧ μ (range f) ≤ μ K + ε := by
  obtain ⟨δ, hδ_pos, hδ_sum⟩ := ENNReal.exists_pos_sum_of_countable' hε ℕ
  -- At stage `n`, bound one more Baire-space coordinate while losing at most `δ n`.
  have hstep : ∀ (n : ℕ) (T : Set (ℕ → ℕ)),
      ∃ M : ℕ, μ (f '' T) ≤ μ (f '' (T ∩ {β | β n ≤ M})) + δ n := by
    intro n T
    have hmono : Monotone fun M : ℕ => f '' (T ∩ {β | β n ≤ M}) := fun M M' hMM' =>
      image_mono (inter_subset_inter_right _ fun _ hβ => hβ.trans hMM')
    have hunion : ⋃ M : ℕ, f '' (T ∩ {β | β n ≤ M}) = f '' T := by
      rw [← image_iUnion, ← inter_iUnion, iUnion_eq_univ_iff.2 fun β => ⟨β n, le_refl (β n)⟩,
        inter_univ]
    have hsup : μ (f '' T) + δ n = ⨆ M : ℕ, μ (f '' (T ∩ {β | β n ≤ M})) + δ n := by
      rw [← ENNReal.iSup_add, ← hmono.measure_iUnion, hunion]
    obtain ⟨M, hM⟩ := lt_iSup_iff.1 <|
      (ENNReal.lt_add_right (measure_ne_top μ (f '' T)) (hδ_pos n).ne').trans_eq hsup
    exact ⟨M, hM.le⟩
  choose Mof hMof using hstep
  -- Recursively choose the coordinate bounds and identify the resulting finite-stage sets.
  set F : ℕ → Set (ℕ → ℕ) :=
    fun n => Nat.rec univ (fun n Fn => Fn ∩ {β | β n ≤ Mof n Fn}) n
  set N : ℕ → ℕ := fun n => Mof n (F n)
  have hF_succ : ∀ n, F (n + 1) = F n ∩ {β | β n ≤ N n} := fun _ => rfl
  have hF_eq : ∀ n, F n = {β | ∀ k < n, β k ≤ N k} := by
    intro n
    induction n with
    | zero => simp [F]
    | succ n ih =>
      ext β
      simp [hF_succ, ih, Nat.le_iff_lt_or_eq, or_imp, forall_and]
  -- The accumulated loss stays within the error budget.
  have hinv : ∀ n, μ (range f) ≤ μ (f '' F n) + ∑ k ∈ Finset.range n, δ k := by
    intro n
    induction n with
    | zero => simp [F]
    | succ n ih =>
      calc
        μ (range f) ≤ μ (f '' F n) + ∑ k ∈ Finset.range n, δ k := ih
        _ ≤ μ (f '' F (n + 1)) + δ n + ∑ k ∈ Finset.range n, δ k := by
          gcongr
          exact hMof n (F n)
        _ = μ (f '' F (n + 1)) + ∑ k ∈ Finset.range (n + 1), δ k := by
          rw [Finset.sum_range_succ, add_right_comm, add_assoc]
  -- Continuity from above and the closure lemma finish the approximation.
  have hD_anti : Antitone fun n => closure (f '' F n) :=
    antitone_nat_of_succ_le fun n =>
      closure_mono (image_mono (by rw [hF_succ]; exact inter_subset_left))
  have hsubset : ⋂ n, closure (f '' F n) ⊆ f '' Iic N := by
    simpa only [← hF_eq] using iInter_closure_image_subset_image_Iic hf N
  have hC : IsCompact (Iic N) := by simpa using isCompact_Icc (a := (⊥ : ℕ → ℕ)) (b := N)
  refine ⟨f '' Iic N, hC.image hf, image_subset_range f _, ?_⟩
  calc
    μ (range f) ≤ (⨅ n, μ (closure (f '' F n))) + ε := by
      rw [ENNReal.iInf_add]
      refine le_iInf fun n => (hinv n).trans ?_
      gcongr
      · exact subset_closure
      · exact (_root_.sum_le_tsum _).trans hδ_sum.le
    _ = μ (⋂ n, closure (f '' F n)) + ε := by
      rw [hD_anti.measure_iInter (fun _ => isClosed_closure.measurableSet.nullMeasurableSet)
        ⟨0, measure_ne_top μ _⟩]
    _ ≤ μ (f '' Iic N) + ε := by gcongr

end MeasureTheory

end TauCeti

namespace MeasureTheory

variable {X : Type*} [TopologicalSpace X] [T2Space X] [MeasurableSpace X] [OpensMeasurableSpace X]

/-- **Lusin's universal-measurability theorem.** An analytic subset of a Hausdorff space is
null-measurable with respect to every s-finite measure on a measurable space containing the Borel
sets, equivalently measurable in the completion of that measure. -/
theorem AnalyticSet.nullMeasurableSet
    {S : Set X} (hS : AnalyticSet S) (μ : Measure X) [SFinite μ] :
    NullMeasurableSet S μ := by
  -- Pass to an equivalent finite measure.
  obtain ⟨ν, _, hμν, -⟩ := exists_isFiniteMeasure_absolutelyContinuous (μ := μ)
  refine NullMeasurableSet.mono_ac ?_ hμν
  -- `S` has compact subsets of arbitrarily close outer measure.
  have happrox : ∀ ε : ℝ≥0∞, ε ≠ 0 → ∃ K, IsCompact K ∧ K ⊆ S ∧ ν S ≤ ν K + ε := by
    intro ε hε
    obtain ⟨Z, _, _, f, hf, rfl⟩ := analyticSet_iff_exists_polishSpace_range.1 hS
    rcases isEmpty_or_nonempty Z with _ | _
    · exact ⟨∅, isCompact_empty, empty_subset _, by simp [range_eq_empty f]⟩
    · obtain ⟨g, hg, hsurj⟩ := PolishSpace.exists_nat_nat_continuous_surjective Z
      rw [← hsurj.range_comp f]
      exact TauCeti.MeasureTheory.exists_isCompact_subset_range_measure_le (hf.comp hg) hε
  -- The union of a sequence of such approximations is a measurable subset of full measure.
  choose K hK hKS hνK using fun n : ℕ => happrox (n : ℝ≥0∞)⁻¹ (by simp)
  have hG : MeasurableSet (⋃ n, K n) := .iUnion fun n => (hK n).isClosed.measurableSet
  have hle : ν S ≤ ν (⋃ n, K n) :=
    ge_of_tendsto' (by simpa using tendsto_const_nhds.add ENNReal.tendsto_inv_nat_nhds_zero)
      fun n => (hνK n).trans (by gcongr; exact subset_iUnion K n)
  exact hG.nullMeasurableSet.congr (ae_eq_of_subset_of_measure_ge (iUnion_subset hKS) hle
    hG.nullMeasurableSet (measure_ne_top ν S))

/-- Every set in the measurable space generated by the analytic subsets of a Hausdorff space is
null-measurable for every s-finite measure on a measurable space containing the Borel sets. -/
theorem NullMeasurableSet.of_generateFrom_analyticSet
    {S : Set X} (μ : Measure X) [SFinite μ]
    (hS : MeasurableSet[MeasurableSpace.generateFrom {T : Set X | AnalyticSet T}] S) :
    NullMeasurableSet S μ :=
  MeasurableSpace.generateFrom_induction {T : Set X | AnalyticSet T}
    (fun T _ => NullMeasurableSet T μ) (fun _ hT _ => hT.nullMeasurableSet μ)
    MeasurableSet.empty.nullMeasurableSet (fun _ _ hT => hT.compl)
    (fun _ _ hT => .iUnion hT) S hS

end MeasureTheory

namespace TauCeti.MeasureTheory

open _root_.MeasureTheory

/-- A function measurable for the measurable space generated by the analytic subsets of a
Hausdorff space is null-measurable for every s-finite measure on a measurable space containing the
Borel sets. -/
theorem nullMeasurable_of_measurable_generateFrom_analyticSet
    {X A : Type*} [TopologicalSpace X] [T2Space X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [MeasurableSpace A] {g : X → A} (μ : Measure X) [SFinite μ]
    (hg : Measurable[MeasurableSpace.generateFrom {T : Set X | AnalyticSet T}] g) :
    NullMeasurable g μ :=
  fun _ hs => NullMeasurableSet.of_generateFrom_analyticSet μ (hg hs)

end TauCeti.MeasureTheory
