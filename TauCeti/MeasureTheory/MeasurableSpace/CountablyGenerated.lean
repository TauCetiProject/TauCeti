module

public import Mathlib.MeasureTheory.Function.FactorsThrough
public import Mathlib.MeasureTheory.MeasurableSpace.CountablyGenerated
public import Mathlib.MeasureTheory.MeasurableSpace.Prod

/-!
# Boolean coordinates for a measurable function on a product

A measurable function `f : α × β → γ` into a nonempty standard Borel space depends on only
countably many measurable sets of each factor, so it factors through a pair of maps into the
Cantor space
`ℕ → Bool`: there are measurable `q : α → ℕ → Bool`, `r : β → ℕ → Bool` and a measurable
`g : (ℕ → Bool) × (ℕ → Bool) → γ` with `f = g ∘ Prod.map q r`
(`Measurable.exists_eq_measurable_comp_prodMap`). When both factors are the same space one
map suffices (`Measurable.exists_eq_measurable_comp_prodMap_self`), which is the form a
symmetric kernel needs.

This is the measure-theoretic half of Janson's Lemma 7.3 for graphons, and the reason no hypothesis
on `α` or `β` is needed anywhere: the two factors are replaced by a standard Borel model *before*
any measure enters.

The argument has three steps. The σ-algebra pulled back along `f` is countably generated, because
the target is; each of its countably many generators lies in the σ-algebra generated by countably
many measurable rectangles (`MeasurableSet.exists_countable_subset_generateFrom`); and a map to
the Cantor space makes all the countably many sides measurable in the pulled-back σ-algebra.
Doob--Dynkin (`Measurable.exists_eq_measurable_comp`) then produces `g`.

This file also records that a countable separating family pulls back along a measurable
injection (`MeasurableSpace.CountablySeparated.of_injective`).

## Main results

* `MeasurableSpace.CountablySeparated.of_injective` — a space with a measurable injection into a
  countably separated space is countably separated;
* `MeasurableSet.exists_countable_subset_generateFrom` — a set measurable for a generated
  σ-algebra is already measurable for the σ-algebra generated by countably many of the generators;
* `Set.Countable.exists_measurable_comap_eq_generateFrom` — the σ-algebra generated by countably
  many measurable sets is pulled back along one measurable map to the Cantor space;
* `Measurable.exists_eq_measurable_comp_prodMap` — the factorization through Boolean
  coordinates of each factor;
* `Measurable.exists_eq_measurable_comp_prodMap_self` — its diagonal form, with a single
  coordinate map.

## References

* S. Janson, *Graphons, cut norm and distance, couplings and rearrangements*, NYJM Monographs 4
  (2013), Lemma 7.3.
-/

public section

open MeasurableSpace MeasureTheory Set

/-- **Countable separation pulls back along a measurable injection.** If `f : α → β` is a
measurable injection into a countably separated space, the preimages of a countable separating
family of `β` separate the points of `α`. -/
theorem MeasurableSpace.CountablySeparated.of_injective {α β : Type*} [MeasurableSpace α]
    [MeasurableSpace β] [CountablySeparated β] {f : α → β} (hf : Measurable f)
    (hinj : Function.Injective f) : CountablySeparated α := by
  obtain ⟨S, hSc, hSm, hS⟩ := exists_countable_separating β MeasurableSet univ
  refine countablySeparated_def.2 ⟨⟨preimage f '' S, hSc.image _, ?_, ?_⟩⟩
  · rintro _ ⟨s, hs, rfl⟩
    exact hf (hSm s hs)
  · intro x _ y _ hxy
    exact hinj <| hS _ (mem_univ _) _ (mem_univ _) fun s hs => hxy _ ⟨s, hs, rfl⟩

variable {α β γ : Type*}

/-- **A generated σ-algebra is exhausted by its countable subfamilies.** A set measurable for
`generateFrom C` is measurable for `generateFrom D` for some countable `D ⊆ C`. -/
theorem MeasurableSet.exists_countable_subset_generateFrom {C : Set (Set α)} {s : Set α}
    (hs : MeasurableSet[generateFrom C] s) :
    ∃ D ⊆ C, D.Countable ∧ MeasurableSet[generateFrom D] s := by
  induction s, hs using MeasurableSpace.generateFrom_induction with
  | hC t ht _ =>
    exact ⟨{t}, singleton_subset_iff.2 ht, countable_singleton t, measurableSet_generateFrom rfl⟩
  | empty => exact ⟨∅, empty_subset C, countable_empty, measurableSet_empty _⟩
  | compl t _ iht =>
    obtain ⟨D, hDC, hD, hts⟩ := iht
    exact ⟨D, hDC, hD, hts.compl⟩
  | iUnion u _ ihu =>
    choose D hDC hD hu using ihu
    exact ⟨⋃ n, D n, iUnion_subset hDC, countable_iUnion hD,
      .iUnion fun n => generateFrom_mono (subset_iUnion D n) _ (hu n)⟩

/-- **A countable family of measurable sets is pulled back from the Cantor space.** The
σ-algebra generated by a countable family of measurable sets is the one pulled back along some
measurable map to the Cantor space `ℕ → Bool`. The map is Mathlib's
`MeasurableSpace.mapNatBool` for the generated σ-algebra. -/
theorem Set.Countable.exists_measurable_comap_eq_generateFrom [MeasurableSpace α]
    {C : Set (Set α)} (hC : C.Countable) (hmeas : ∀ s ∈ C, MeasurableSet s) :
    ∃ q : α → ℕ → Bool, Measurable q ∧
      MeasurableSpace.comap q (inferInstance : MeasurableSpace (ℕ → Bool)) = generateFrom C := by
  have hcg : @CountablyGenerated α (generateFrom C) :=
    @CountablyGenerated.mk α (generateFrom C) ⟨C, hC, rfl⟩
  -- Mathlib's `MeasurableSpace.measurable_mapNatBool` gives the inclusion of the pulled-back
  -- σ-algebra into `generateFrom C`.
  have hq := @measurable_mapNatBool α (generateFrom C) hcg
  refine ⟨@mapNatBool α (generateFrom C) hcg, hq.mono (generateFrom_le hmeas) le_rfl,
    le_antisymm hq.comap_le ?_⟩
  conv_lhs => rw [← @generateFrom_natGeneratingSequence α (generateFrom C) hcg]
  refine generateFrom_le ?_
  rintro s ⟨n, rfl⟩
  exact ⟨(fun b : ℕ → Bool => b n) ⁻¹' {true},
    measurable_pi_apply n (measurableSet_singleton true), by ext x; simp [mapNatBool]⟩

/-- **A measurable function on a product factors through Boolean coordinates.** A measurable
`f : α × β → γ` into a nonempty standard Borel space is a measurable function of countably many
Boolean coordinates of each argument: no hypothesis on `α` or `β` is needed, which is what lets a
kernel on an arbitrary carrier be transported to a standard Borel one. -/
theorem Measurable.exists_eq_measurable_comp_prodMap [MeasurableSpace α]
    [MeasurableSpace β] [MeasurableSpace γ]
    [StandardBorelSpace γ] [Nonempty γ] {f : α × β → γ} (hf : Measurable f) :
    ∃ (q : α → ℕ → Bool) (r : β → ℕ → Bool) (g : (ℕ → Bool) × (ℕ → Bool) → γ),
      Measurable q ∧ Measurable r ∧ Measurable g ∧ f = g ∘ Prod.map q r := by
  -- The σ-algebra pulled back along `f` is countably generated, by countably many sets `C`.
  obtain ⟨C, hCcount, hCgen⟩ :=
    (CountablyGenerated.comap f (m := (inferInstance : MeasurableSpace γ))).isCountablyGenerated
  -- Each generator uses only countably many measurable rectangles.
  choose D hDrect hDcount hD using fun c (hc : c ∈ C) =>
    (generateFrom_prod (α := α) (β := β) ▸
      hf.comap_le c (hCgen ▸ measurableSet_generateFrom hc)).exists_countable_subset_generateFrom
  set R : Set (Set (α × β)) := ⋃ (c : Set (α × β)) (hc : c ∈ C), D c hc
  have hRcount : R.Countable := hCcount.biUnion hDcount
  -- Collect the sides of those rectangles.
  choose! u hu v hv huv using fun w (hw : w ∈ R) => iUnion₂_subset hDrect hw
  obtain ⟨q, hqmeas, hq⟩ := (hRcount.image u).exists_measurable_comap_eq_generateFrom
    (forall_mem_image.2 hu)
  obtain ⟨r, hrmeas, hr⟩ := (hRcount.image v).exists_measurable_comap_eq_generateFrom
    (forall_mem_image.2 hv)
  -- The two coordinate maps already carry `f`: `Prod.map q r` is `fun z => (q z.1, r z.2)`.
  have hstep : generateFrom R ≤ (generateFrom (u '' R)).prod (generateFrom (v '' R)) := by
    refine generateFrom_le fun w hw => ?_
    rw [← huv w hw]
    exact (measurableSet_generateFrom (mem_image_of_mem u hw)).prod
      (measurableSet_generateFrom (mem_image_of_mem v hw))
  have hCR : generateFrom C ≤ generateFrom R :=
    generateFrom_le fun c hc => generateFrom_mono (subset_iUnion₂ c hc) _ (hD c hc)
  have hprod : MeasurableSpace.comap f (inferInstance : MeasurableSpace γ) ≤
      MeasurableSpace.comap (Prod.map q r)
        (inferInstance : MeasurableSpace ((ℕ → Bool) × (ℕ → Bool))) := by
    rw [hCgen, Prod.instMeasurableSpace, MeasurableSpace.comap_prodMap, hq, hr]
    exact hCR.trans hstep
  obtain ⟨g, hgmeas, hgeq⟩ := (measurable_iff_comap_le.2 hprod).exists_eq_measurable_comp
  exact ⟨q, r, g, hqmeas, hrmeas, hgmeas, hgeq⟩

/-- **A measurable function on a square factors through one set of Boolean coordinates.** The
diagonal form of `Measurable.exists_eq_measurable_comp_prodMap`, with a single coordinate map
for both arguments, which is what a symmetric function of two arguments needs. -/
theorem Measurable.exists_eq_measurable_comp_prodMap_self [MeasurableSpace α]
    [MeasurableSpace γ]
    [StandardBorelSpace γ] [Nonempty γ] {f : α × α → γ} (hf : Measurable f) :
    ∃ (q : α → ℕ → Bool) (g : (ℕ → Bool) × (ℕ → Bool) → γ),
      Measurable q ∧ Measurable g ∧ f = g ∘ Prod.map q q := by
  obtain ⟨q, r, g, hq, hr, hg, rfl⟩ := hf.exists_eq_measurable_comp_prodMap
  let e : ((ℕ → Bool) × (ℕ → Bool)) ≃ᵐ (ℕ → Bool) :=
    (MeasurableEquiv.sumPiEquivProdPi (fun _ : ℕ ⊕ ℕ => Bool)).symm.trans
      (MeasurableEquiv.piCongrLeft (fun _ : ℕ => Bool) Equiv.natSumNatEquivNat)
  refine ⟨fun x => e (q x, r x), g ∘ Prod.map (fun a => (e.symm a).1) (fun a => (e.symm a).2),
    e.measurable.comp (hq.prodMk hr),
    hg.comp (e.symm.measurable.fst.prodMap e.symm.measurable.snd), ?_⟩
  ext ⟨x, y⟩
  simp
