module

public import Mathlib.MeasureTheory.Function.FactorsThrough
public import Mathlib.MeasureTheory.MeasurableSpace.CountablyGenerated
public import Mathlib.MeasureTheory.MeasurableSpace.Prod

/-!
# Boolean coordinates for a measurable function on a product

A measurable function `f : α × β → γ` into a standard Borel space depends on only countably many
measurable sets of each factor, so it factors through a pair of maps into the Cantor space
`ℕ → Bool`: there are measurable `q : α → ℕ → Bool`, `r : β → ℕ → Bool` and a measurable
`g : (ℕ → Bool) × (ℕ → Bool) → γ` with `f = g ∘ Prod.map q r`
(`TauCeti.MeasureTheory.exists_measurable_comp_prodMap`). When both factors are the same space one
map suffices (`TauCeti.MeasureTheory.exists_measurable_comp_prodMap_self`), which is the form a
symmetric kernel needs.

This is the measure-theoretic half of Janson's Lemma 7.3 for graphons, and the reason no hypothesis
on `α` or `β` is needed anywhere: the two factors are replaced by a standard Borel model *before*
any measure enters.

The argument has three steps. The σ-algebra pulled back along `f` is countably generated, because
the target is; each of its countably many generators lies in the σ-algebra generated by countably
many measurable rectangles (`TauCeti.MeasureTheory.exists_countable_subset_generateFrom`); and the
countably many sides collected from those rectangles become the Boolean coordinates. Doob--Dynkin
(`Measurable.exists_eq_measurable_comp`) then produces `g`.

## Main results

* `TauCeti.MeasureTheory.exists_countable_subset_generateFrom` — a set measurable for a generated
  σ-algebra is already measurable for the σ-algebra generated by countably many of the generators;
* `TauCeti.MeasureTheory.exists_measurable_generateFrom_le_comap` — countably many measurable sets
  are the Boolean coordinates of a measurable map to the Cantor space;
* `TauCeti.MeasureTheory.exists_measurable_comp_prodMap` — the factorization through Boolean
  coordinates of each factor;
* `TauCeti.MeasureTheory.exists_measurable_comp_prodMap_self` — its diagonal form, with a single
  coordinate map.

## References

* S. Janson, *Graphons, cut norm and distance, couplings and rearrangements*, NYJM Monographs 4
  (2013), Lemma 7.3.
-/

public section

open MeasurableSpace MeasureTheory Set

namespace TauCeti

namespace MeasureTheory

variable {α β γ : Type*}

/-- **A generated σ-algebra is exhausted by its countable subfamilies.** A set measurable for
`generateFrom C` is measurable for `generateFrom D` for some countable `D ⊆ C`: each of the three
constructors of a generated σ-algebra consumes only countably many sets. -/
theorem exists_countable_subset_generateFrom {C : Set (Set α)} {s : Set α}
    (hs : MeasurableSet[generateFrom C] s) :
    ∃ D ⊆ C, D.Countable ∧ MeasurableSet[generateFrom D] s := by
  induction s, hs using MeasurableSpace.generateFrom_induction with
  | hC t ht _ =>
    exact ⟨{t}, singleton_subset_iff.2 ht, countable_singleton t,
      measurableSet_generateFrom rfl⟩
  | empty => exact ⟨∅, empty_subset C, countable_empty, measurableSet_empty _⟩
  | compl t _ iht =>
    obtain ⟨D, hDC, hD, hts⟩ := iht
    exact ⟨D, hDC, hD, hts.compl⟩
  | iUnion u _ ihu =>
    choose D hDC hD hu using ihu
    refine ⟨⋃ n, D n, iUnion_subset hDC, countable_iUnion hD,
      MeasurableSet.iUnion fun n => ?_⟩
    exact generateFrom_mono (subset_iUnion D n) _ (hu n)

/-- **Countably many measurable sets are the Boolean coordinates of a measurable map.** The
σ-algebra a countable family of measurable sets generates is contained in the one pulled back
along a measurable map to the Cantor space: Mathlib's `MeasurableSpace.mapNatBool`, applied to the
generated σ-algebra, records membership in each of the sets as one Boolean coordinate.

`MeasurableSpace.measurable_mapNatBool` gives the other inclusion, for the σ-algebra of the
ambient space; here the family need not generate it. -/
theorem exists_measurable_generateFrom_le_comap [MeasurableSpace α] {C : Set (Set α)}
    (hC : C.Countable) (hmeas : ∀ s ∈ C, MeasurableSet s) :
    ∃ q : α → ℕ → Bool, Measurable q ∧
      generateFrom C ≤ MeasurableSpace.comap q (inferInstance : MeasurableSpace (ℕ → Bool)) := by
  have hcg : @MeasurableSpace.CountablyGenerated α (generateFrom C) :=
    @MeasurableSpace.CountablyGenerated.mk α (generateFrom C) ⟨C, hC, rfl⟩
  refine ⟨@MeasurableSpace.mapNatBool α (generateFrom C) hcg,
    (@MeasurableSpace.measurable_mapNatBool α (generateFrom C) hcg).mono
      (generateFrom_le hmeas) le_rfl, ?_⟩
  conv_lhs => rw [← @generateFrom_natGeneratingSequence α (generateFrom C) hcg]
  refine generateFrom_le ?_
  rintro s ⟨n, rfl⟩
  exact ⟨(fun b : ℕ → Bool => b n) ⁻¹' {true},
    measurable_pi_apply n (measurableSet_singleton true),
    by ext x; simp [MeasurableSpace.mapNatBool]⟩

/-- **A measurable function on a product factors through Boolean coordinates.** A measurable
`f : α × β → γ` into a standard Borel space is a measurable function of countably many Boolean
coordinates of each argument: no hypothesis on `α` or `β` is needed, which is what lets a kernel on
an arbitrary carrier be transported to a standard Borel one. -/
theorem exists_measurable_comp_prodMap [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
    [StandardBorelSpace γ] [Nonempty γ] {f : α × β → γ} (hf : Measurable f) :
    ∃ (q : α → ℕ → Bool) (r : β → ℕ → Bool) (g : (ℕ → Bool) × (ℕ → Bool) → γ),
      Measurable q ∧ Measurable r ∧ Measurable g ∧ f = g ∘ Prod.map q r := by
  -- The σ-algebra pulled back along `f` is countably generated, by countably many sets `C`.
  have hcg : @MeasurableSpace.CountablyGenerated (α × β)
      (MeasurableSpace.comap f (inferInstance : MeasurableSpace γ)) :=
    MeasurableSpace.CountablyGenerated.comap f
  obtain ⟨C, hCcount, hCgen⟩ := hcg.isCountablyGenerated
  have hCmeas : ∀ c ∈ C, MeasurableSet c := by
    intro c hc
    have hc' : MeasurableSet[MeasurableSpace.comap f (inferInstance : MeasurableSpace γ)] c := by
      rw [hCgen]; exact measurableSet_generateFrom hc
    obtain ⟨t, ht, rfl⟩ := hc'
    exact hf ht
  -- Each generator uses only countably many measurable rectangles.
  choose D hDrect hDcount hD using fun c (hc : c ∈ C) =>
    exists_countable_subset_generateFrom (C := image2 (· ×ˢ ·) {s : Set α | MeasurableSet s}
      {t : Set β | MeasurableSet t}) (by rw [generateFrom_prod]; exact hCmeas c hc)
  set R : Set (Set (α × β)) := ⋃ (c : Set (α × β)) (hc : c ∈ C), D c hc
  have hRcount : R.Countable := hCcount.biUnion hDcount
  have hRrect : R ⊆ image2 (· ×ˢ ·) {s : Set α | MeasurableSet s} {t : Set β | MeasurableSet t} :=
    iUnion₂_subset hDrect
  -- Collect the sides of those rectangles.
  choose! u hu v hv huv using fun w (hw : w ∈ R) => hRrect hw
  have hs : ∀ a ∈ u '' R, MeasurableSet a := by rintro _ ⟨w, hw, rfl⟩; exact hu w hw
  have ht : ∀ b ∈ v '' R, MeasurableSet b := by rintro _ ⟨w, hw, rfl⟩; exact hv w hw
  obtain ⟨q, hqmeas, hq⟩ := exists_measurable_generateFrom_le_comap (hRcount.image u) hs
  obtain ⟨r, hrmeas, hr⟩ := exists_measurable_generateFrom_le_comap (hRcount.image v) ht
  -- The two coordinate maps already carry `f`: `Prod.map q r` is `fun z => (q z.1, r z.2)`.
  have hcomap : (MeasurableSpace.comap q (inferInstance : MeasurableSpace (ℕ → Bool))).prod
      (MeasurableSpace.comap r (inferInstance : MeasurableSpace (ℕ → Bool))) =
      MeasurableSpace.comap (Prod.map q r)
        (inferInstance : MeasurableSpace ((ℕ → Bool) × (ℕ → Bool))) := by
    have h := MeasurableSpace.comap_prodMk (mβ := inferInstance) (mγ := inferInstance)
      (q ∘ (Prod.fst : α × β → α)) (r ∘ (Prod.snd : α × β → β))
    rw [← MeasurableSpace.comap_comp, ← MeasurableSpace.comap_comp] at h
    exact h.symm
  have hstep : generateFrom R ≤ (generateFrom (u '' R)).prod (generateFrom (v '' R)) := by
    refine generateFrom_le fun w hw => ?_
    rw [← huv w hw]
    exact (measurableSet_generateFrom (mem_image_of_mem u hw)).prod
      (measurableSet_generateFrom (mem_image_of_mem v hw))
  have hCR : generateFrom C ≤ generateFrom R :=
    generateFrom_le fun c hc => generateFrom_mono (subset_iUnion₂ c hc) _ (hD c hc)
  have hprod : MeasurableSpace.comap f (inferInstance : MeasurableSpace γ) ≤
      MeasurableSpace.comap (Prod.map q r)
        (inferInstance : MeasurableSpace ((ℕ → Bool) × (ℕ → Bool))) := by
    rw [hCgen, ← hcomap]
    exact hCR.trans (hstep.trans (sup_le_sup (MeasurableSpace.comap_mono hq)
      (MeasurableSpace.comap_mono hr)))
  obtain ⟨g, hgmeas, hgeq⟩ := (measurable_iff_comap_le.2 hprod).exists_eq_measurable_comp
  exact ⟨q, r, g, hqmeas, hrmeas, hgmeas, hgeq⟩

/-- **A measurable function on a square factors through one set of Boolean coordinates.** The
diagonal form of `TauCeti.MeasureTheory.exists_measurable_comp_prodMap`: interleaving the two
coordinate maps produces a single one, which is what a symmetric function of two arguments needs. -/
theorem exists_measurable_comp_prodMap_self [MeasurableSpace α] [MeasurableSpace γ]
    [StandardBorelSpace γ] [Nonempty γ] {f : α × α → γ} (hf : Measurable f) :
    ∃ (q : α → ℕ → Bool) (g : (ℕ → Bool) × (ℕ → Bool) → γ),
      Measurable q ∧ Measurable g ∧ f = g ∘ Prod.map q q := by
  obtain ⟨q, r, g, hq, hr, hg, hfeq⟩ := exists_measurable_comp_prodMap hf
  set p : α → ℕ → Bool := fun x n => if n % 2 = 0 then q x (n / 2) else r x (n / 2) with hp
  have hqp : ∀ x, (fun m => p x (2 * m)) = q x := by
    intro x; funext m
    have h₁ : 2 * m % 2 = 0 := by omega
    have h₂ : 2 * m / 2 = m := by omega
    simp [hp, h₁, h₂]
  have hrp : ∀ x, (fun m => p x (2 * m + 1)) = r x := by
    intro x; funext m
    have h₁ : (2 * m + 1) % 2 = 1 := by omega
    have h₂ : (2 * m + 1) / 2 = m := by omega
    simp [hp, h₁, h₂]
  refine ⟨p, g ∘ Prod.map (fun a m => a (2 * m)) (fun b m => b (2 * m + 1)),
    Measurable.of_eval fun n => ?_, hg.comp ((Measurable.of_eval fun m => measurable_pi_apply _
      ).prodMap (Measurable.of_eval fun m => measurable_pi_apply _)), ?_⟩
  · by_cases hn : n % 2 = 0
    · simpa [hp, hn] using hq.eval
    · simpa [hp, hn] using hr.eval
  · have hz : Prod.map (fun a : ℕ → Bool => fun m => a (2 * m))
        (fun b : ℕ → Bool => fun m => b (2 * m + 1)) ∘ Prod.map p p = Prod.map q r :=
      funext fun z => Prod.ext (hqp z.1) (hrp z.2)
    rw [hfeq, Function.comp_assoc, hz]

end MeasureTheory

end TauCeti
