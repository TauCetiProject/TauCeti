/-!
# Measurable selections of closed-valued maps

Let `M` assign to each point `z` of a measurable space a nonempty closed subset `M z` of a Polish
space `X`. The **Kuratowski–Ryll-Nardzewski theorem** says that if `M` is *weakly measurable*,
meaning that `{z | M z ∩ U ≠ ∅}` is measurable for every open `U ⊆ X`, then `M` has a measurable
selection: a measurable map `f` with `f z ∈ M z` for every `z`. Unlike the Jankov–von Neumann
theorem, which gives a selection measurable only for the σ-algebra generated by analytic sets,
this selection is measurable for the given σ-algebra; for a Borel parameter space it is Borel.

The main application here is to minimizers depending continuously on a parameter. If `F z x`
depends jointly continuously on `(z, x)`, the parameter space carries its Borel σ-algebra, `X` is
Polish and locally compact, and `F z` attains its minimum for every `z`, then the minimizers can be
chosen Borel measurably in `z`. Indeed the set of `z` for which `F z` has a minimizer in a fixed
compact set is closed, and every open subset of `X` is a countable union of compact sets.

## Main statements

* `TauCeti.exists_measurable_forall_mem` — the Kuratowski–Ryll-Nardzewski measurable selection
  theorem for weakly measurable maps with nonempty closed values in a Polish space;
* `Continuous.exists_measurable_isMinOn` — a jointly continuous function on a product with a
  locally compact Polish factor, which attains its minimum on each fibre, has a measurable
  selection of minimizers.

## References

* K. Kuratowski and C. Ryll-Nardzewski, *A general theorem on selectors*, Bull. Acad. Polon.
  Sci. 13 (1965), 397–403.
* C. D. Aliprantis and K. C. Border, *Infinite Dimensional Analysis*, 3rd edition, Springer
  2006, Theorem 18.13.
* A. S. Kechris, *Classical Descriptive Set Theory*, Springer-Verlag, 1995, Theorem 12.13.
-/

public section

noncomputable section

open Filter Metric Set Topology

namespace TauCeti

variable {Z X : Type*}

section Selection

variable [MetricSpace X] {M : Z → Set X} {u : ℕ → X}

/-- The admissible indices at the first step of the selection: `k` is admissible at `z` when the
ball of radius `1` about `u k` meets `M z`. -/
private def selectionStartPred (M : Z → Set X) (u : ℕ → X) (z : Z) (k : ℕ) : Prop :=
  (M z ∩ ball (u k) 1).Nonempty

/-- The admissible indices at step `n + 1` of the selection, after the index `j` was chosen at
step `n`: the ball of radius `2⁻¹ ^ (n + 1)` about `u k` meets `M z` inside the ball of radius
`2⁻¹ ^ n` about `u j`. When that larger ball misses `M z`, every index is admissible, so that the
least admissible index always exists. -/
private def selectionStepPred (M : Z → Set X) (u : ℕ → X) (n j : ℕ) (z : Z) (k : ℕ) : Prop :=
  (M z ∩ (ball (u k) (2⁻¹ ^ (n + 1)) ∩ ball (u j) (2⁻¹ ^ n))).Nonempty ∨
    ¬(M z ∩ ball (u j) (2⁻¹ ^ n)).Nonempty

private theorem exists_selectionStartPred (hu : DenseRange u) (hne : ∀ z, (M z).Nonempty)
    (z : Z) : ∃ k, selectionStartPred M u z k := by
  obtain ⟨y, hy⟩ := hne z
  obtain ⟨k, hk⟩ := hu.exists_dist_lt y one_pos
  exact ⟨k, y, hy, mem_ball.2 hk⟩

private theorem exists_selectionStepPred (hu : DenseRange u) (n j : ℕ) (z : Z) :
    ∃ k, selectionStepPred M u n j z k := by
  by_cases h : (M z ∩ ball (u j) (2⁻¹ ^ n)).Nonempty
  · obtain ⟨y, hyM, hyj⟩ := h
    obtain ⟨k, hk⟩ := hu.exists_dist_lt y (pow_pos (inv_pos.2 two_pos) (n + 1))
    exact ⟨k, Or.inl ⟨y, hyM, mem_ball.2 hk, hyj⟩⟩
  · exact ⟨0, Or.inr h⟩

open Classical in
/-- The index chosen at step `n` of the selection: at step `0` the least `k` whose unit ball about
`u k` meets `M z`, and at step `n + 1` the least admissible index after the previous choice. -/
private def selectionIndex (hu : DenseRange u) (hne : ∀ z, (M z).Nonempty) : ℕ → Z → ℕ
  | 0, z => Nat.find (exists_selectionStartPred hu hne z)
  | n + 1, z => Nat.find (exists_selectionStepPred (M := M) hu n (selectionIndex hu hne n z) z)

open Classical in
/-- The ball of radius `2⁻¹ ^ n` about the point chosen at step `n` meets `M z`. -/
private theorem selectionIndex_nonempty (hu : DenseRange u) (hne : ∀ z, (M z).Nonempty)
    (n : ℕ) (z : Z) : (M z ∩ ball (u (selectionIndex hu hne n z)) (2⁻¹ ^ n)).Nonempty := by
  induction n with
  | zero =>
    simpa [selectionIndex, selectionStartPred] using
      Nat.find_spec (exists_selectionStartPred hu hne z)
  | succ n ih =>
    have h := Nat.find_spec (exists_selectionStepPred (M := M) hu n (selectionIndex hu hne n z) z)
    rcases h with ⟨y, hyM, hy, -⟩ | h
    · exact ⟨y, hyM, hy⟩
    · exact absurd ih h

open Classical in
/-- Consecutive chosen points are within `2 / 2 ^ n` of each other. -/
private theorem dist_selectionIndex_succ_le (hu : DenseRange u) (hne : ∀ z, (M z).Nonempty)
    (n : ℕ) (z : Z) :
    dist (u (selectionIndex hu hne n z)) (u (selectionIndex hu hne (n + 1) z)) ≤
      4 / 2 / 2 ^ n := by
  have h := Nat.find_spec (exists_selectionStepPred (M := M) hu n (selectionIndex hu hne n z) z)
  rcases h with ⟨y, -, hy₁, hy₀⟩ | h
  · have hy₁' : dist y (u (selectionIndex hu hne (n + 1) z)) < 2⁻¹ ^ (n + 1) := hy₁
    have hy₀' := mem_ball.1 hy₀
    have htri := dist_triangle_left (u (selectionIndex hu hne n z))
      (u (selectionIndex hu hne (n + 1) z)) y
    have hpow : (2⁻¹ : ℝ) ^ (n + 1) + 2⁻¹ ^ n = 3 / 2 * (2 ^ n)⁻¹ := by
      rw [pow_succ, inv_pow]
      ring
    have hfour : (4 : ℝ) / 2 / 2 ^ n = 2 * (2 ^ n)⁻¹ := by ring
    have hpos : (0 : ℝ) < (2 ^ n)⁻¹ := by positivity
    linarith
  · exact absurd (selectionIndex_nonempty hu hne n z) h

variable [MeasurableSpace Z]

/-- The index chosen at every step depends measurably on the parameter. -/
private theorem measurable_selectionIndex (hu : DenseRange u) (hne : ∀ z, (M z).Nonempty)
    (hM : ∀ U, IsOpen U → MeasurableSet {z | (M z ∩ U).Nonempty}) (n : ℕ) :
    Measurable (selectionIndex hu hne n) := by
  classical
  induction n with
  | zero =>
    exact measurable_find (exists_selectionStartPred hu hne) fun k ↦ hM _ isOpen_ball
  | succ n ih =>
    have hstep : Measurable fun q : Z × ℕ ↦
        Nat.find (exists_selectionStepPred (M := M) hu n q.2 q.1) :=
      measurable_from_prod_countable_left fun j ↦
        measurable_find (exists_selectionStepPred hu n j) fun k ↦
          (hM _ (isOpen_ball.inter isOpen_ball)).union (hM _ isOpen_ball).compl
    exact hstep.comp (measurable_id.prodMk ih)

end Selection

/-- **The Kuratowski–Ryll-Nardzewski measurable selection theorem.** A map `M` from a measurable
space to the nonempty closed subsets of a Polish space, which is weakly measurable in the sense that
`{z | M z ∩ U ≠ ∅}` is measurable for every open `U`, has a measurable selection. -/
theorem exists_measurable_forall_mem [MeasurableSpace Z] [TopologicalSpace X] [PolishSpace X]
    [MeasurableSpace X] [BorelSpace X] {M : Z → Set X} (hclosed : ∀ z, IsClosed (M z))
    (hne : ∀ z, (M z).Nonempty)
    (hM : ∀ U, IsOpen U → MeasurableSet {z | (M z ∩ U).Nonempty}) :
    ∃ f : Z → X, Measurable f ∧ ∀ z, f z ∈ M z := by
  let := TopologicalSpace.upgradeIsCompletelyMetrizable X
  obtain hZ | hZ := isEmpty_or_nonempty Z
  · exact ⟨isEmptyElim, measurable_of_empty _, isEmptyElim⟩
  have : Nonempty X := ⟨(hne (Classical.arbitrary Z)).some⟩
  obtain ⟨u, hu⟩ := TopologicalSpace.exists_dense_seq X
  -- the points chosen at the successive steps form a Cauchy sequence for every parameter
  set f : ℕ → Z → X := fun n z ↦ u (selectionIndex hu hne n z)
  have hcauchy (z : Z) : CauchySeq fun n ↦ f n z :=
    cauchySeq_of_le_geometric_two fun n ↦ dist_selectionIndex_succ_le hu hne n z
  have hlim (z : Z) : Tendsto (fun n ↦ f n z) atTop (𝓝 (limUnder atTop fun n ↦ f n z)) :=
    tendsto_nhds_limUnder (cauchySeq_tendsto_of_complete (hcauchy z))
  refine ⟨fun z ↦ limUnder atTop fun n ↦ f n z, ?_, fun z ↦ ?_⟩
  · exact measurable_of_tendsto_metrizable
      (fun n ↦ measurable_from_nat.comp (measurable_selectionIndex hu hne hM n))
      (tendsto_pi_nhds.2 hlim)
  · -- the limit is at distance `0` from the closed set `M z`
    rw [(hclosed z).mem_iff_infDist_zero (hne z)]
    refine le_antisymm ?_ infDist_nonneg
    have hle (n : ℕ) : infDist (f n z) (M z) ≤ 2⁻¹ ^ n := by
      obtain ⟨y, hyM, hy⟩ := selectionIndex_nonempty hu hne n z
      exact (infDist_le_dist_of_mem hyM).trans (by rw [dist_comm]; exact (mem_ball.1 hy).le)
    exact le_of_tendsto_of_tendsto ((continuous_infDist_pt _).continuousAt.tendsto.comp (hlim z))
      (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num))
      (Eventually.of_forall hle)

/-- **Measurable selection of minimizers.** Let `F z x` depend jointly continuously on a parameter
`z`, in a space whose open sets are measurable, and on `x` in a locally compact Polish space.
If `F z` attains its minimum for every `z`, then a minimizer of `F z` can be chosen measurably
in `z`. -/
theorem _root_.Continuous.exists_measurable_isMinOn [TopologicalSpace Z] [MeasurableSpace Z]
    [OpensMeasurableSpace Z] [TopologicalSpace X] [PolishSpace X] [LocallyCompactSpace X]
    [MeasurableSpace X] [BorelSpace X] {β : Type*} [LinearOrder β] [TopologicalSpace β]
    [OrderClosedTopology β] {F : Z → X → β} (hF : Continuous (Function.uncurry F))
    (hmin : ∀ z, ∃ x, IsMinOn (F z) univ x) :
    ∃ T : Z → X, Measurable T ∧ ∀ z, IsMinOn (F z) univ (T z) := by
  simp only [isMinOn_univ_iff] at hmin ⊢
  set M : Z → Set X := fun z ↦ ⋂ x', {x | F z x ≤ F z x'} with hMdef
  have hmemM {z : Z} {x : X} : x ∈ M z ↔ ∀ x', F z x ≤ F z x' := mem_iInter
  -- the minimizers form a closed subset of the product
  have hS : IsClosed {q : Z × X | q.2 ∈ M q.1} := by
    simp only [hMdef, mem_iInter, ofPred_forall]
    exact isClosed_iInter fun x' ↦ isClosed_le hF
      (hF.comp (continuous_fst.prodMk continuous_const))
  -- the parameters with a minimizer in a fixed compact set form a closed set
  have hK {K : Set X} (hK : IsCompact K) : IsClosed {z | (M z ∩ K).Nonempty} := by
    have : CompactSpace K := isCompact_iff_compactSpace.1 hK
    have hclosed : IsClosed {q : Z × K | (q.2 : X) ∈ M q.1} :=
      hS.preimage (continuous_fst.prodMk (continuous_subtype_val.comp continuous_snd))
    convert isClosedMap_fst_of_compactSpace _ hclosed using 1
    ext z
    simp only [mem_ofPred_eq, mem_image, Prod.exists, exists_and_right, exists_eq_right,
      Subtype.exists, exists_prop]
    exact ⟨fun ⟨x, hxM, hxK⟩ ↦ ⟨x, hxK, hxM⟩, fun ⟨x, hxK, hxM⟩ ↦ ⟨x, hxM, hxK⟩⟩
  -- every open subset of `X` is a countable union of compact sets, so `M` is weakly measurable
  have hMmeas (U : Set X) (hU : IsOpen U) : MeasurableSet {z | (M z ∩ U).Nonempty} := by
    let := TopologicalSpace.pseudoMetrizableSpacePseudoMetric X
    obtain ⟨C, hCc, -, hCU, -⟩ := hU.exists_iUnion_isClosed
    set K : ℕ → ℕ → Set X := fun n m ↦ C n ∩ compactCovering X m
    have hKc (n m : ℕ) : IsCompact (K n m) := (isCompact_compactCovering X m).inter_left (hCc n)
    have hKU : {z | (M z ∩ U).Nonempty} = ⋃ n, ⋃ m, {z | (M z ∩ K n m).Nonempty} := by
      ext z
      simp only [K, mem_ofPred_eq, mem_iUnion, ← nonempty_iUnion, ← inter_iUnion,
        iUnion_compactCovering, inter_univ, ← hCU]
    rw [hKU]
    exact MeasurableSet.iUnion fun n ↦ MeasurableSet.iUnion fun m ↦ (hK (hKc n m)).measurableSet
  obtain ⟨T, hT, hTM⟩ := exists_measurable_forall_mem (M := M)
    (fun z ↦ isClosed_iInter fun x' ↦
      isClosed_le (hF.comp (continuous_const.prodMk continuous_id)) continuous_const)
    (fun z ↦ (hmin z).imp fun _ hx ↦ hmemM.2 hx) hMmeas
  exact ⟨T, hT, fun z ↦ hmemM.1 (hTM z)⟩

end TauCeti
