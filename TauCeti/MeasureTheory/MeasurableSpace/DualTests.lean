/-!
# Measurable structures generated by continuous dual tests

`TauCeti.dualTestMeasurableSpace D` is the smallest σ-algebra making the continuous
linear functionals in `D` measurable. It is an explicit measurable structure, so it
can be compared with the norm-Borel structure without changing instances.
Its generators are finite-dimensional scalar cylinder events, and bounded linear
maps are measurable when their transposes preserve the specified tests.

On a separable Banach space, every point-separating family of continuous linear
functionals generates the norm-Borel σ-algebra. No norming or linearity assumption
on the family is necessary. The countable extraction theorem does not require
completeness; completeness enters the Borel comparison through Lusin–Souslin,
via `TauCeti.measurableSpace_eq_iSup_comap_of_separatesPoints`.

## References

* T. Hytönen, J. van Neerven, M. Veraar and L. Weis, *Analysis in Banach Spaces*,
  Volume I, Theorem 1.1.6 and Corollary 1.1.10.
-/

public section

open MeasurableSpace MeasureTheory Set TopologicalSpace

namespace TauCeti

section MeasurableStructure

variable {𝕜 E F Ω : Type*} [NontriviallyNormedField 𝕜] [MeasurableSpace 𝕜]
  [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  [NormedAddCommGroup F] [NormedSpace 𝕜 F]

/-- The σ-algebra generated by the scalar evaluations in `D`. This definition
does not install a measurable-space instance on the normed space. -/
@[instance_reducible]
def dualTestMeasurableSpace (D : Set (StrongDual 𝕜 E)) : MeasurableSpace E :=
  ⨆ φ : D, MeasurableSpace.comap (φ : StrongDual 𝕜 E) inferInstance

/-- A measurable structure contains the dual-test σ-algebra exactly when it
makes each of the specified tests measurable. -/
@[simp]
theorem dualTestMeasurableSpace_le_iff {D : Set (StrongDual 𝕜 E)}
    {m : MeasurableSpace E} :
    dualTestMeasurableSpace D ≤ m ↔ ∀ φ ∈ D, Measurable[m] φ := by
  simp only [dualTestMeasurableSpace, iSup_le_iff, measurable_iff_comap_le,
    Subtype.forall]

/-- Measurability into the dual-test σ-algebra is precisely scalar measurability
against every member of the chosen family. -/
@[simp]
theorem measurable_dualTestMeasurableSpace_iff [MeasurableSpace Ω]
    {D : Set (StrongDual 𝕜 E)} {f : Ω → E} :
    Measurable[inferInstance, dualTestMeasurableSpace D] f ↔
      ∀ φ ∈ D, Measurable (fun ω ↦ φ (f ω)) := by
  simp only [measurable_iff_comap_le, dualTestMeasurableSpace,
    MeasurableSpace.comap_iSup, iSup_le_iff, MeasurableSpace.comap_comp,
    Function.comp_def, Subtype.forall]

/-- Enlarging the test family enlarges the generated σ-algebra. -/
theorem dualTestMeasurableSpace_mono {D D' : Set (StrongDual 𝕜 E)} (h : D ⊆ D') :
    dualTestMeasurableSpace D ≤ dualTestMeasurableSpace D' := by
  exact iSup_le fun φ ↦ le_iSup_of_le (⟨φ, h φ.property⟩ : D') le_rfl

/-- With no tests, the generated σ-algebra is trivial. -/
@[simp]
theorem dualTestMeasurableSpace_empty :
    dualTestMeasurableSpace (∅ : Set (StrongDual 𝕜 E)) = ⊥ := by
  simp [dualTestMeasurableSpace]

/-- The zero test generates only the trivial σ-algebra, even on a nonzero space. -/
@[simp]
theorem dualTestMeasurableSpace_zero :
    dualTestMeasurableSpace ({0} : Set (StrongDual 𝕜 E)) = ⊥ := by
  apply le_antisymm ?_ bot_le
  apply dualTestMeasurableSpace_le_iff.mpr
  intro φ hφ
  obtain rfl := Set.mem_singleton_iff.mp hφ
  exact measurable_const

/-- A bounded linear map is measurable for the specified dual-test structures
if pulling back a target test gives a source test. -/
theorem measurable_dualTestMeasurableSpace_map {D : Set (StrongDual 𝕜 E)}
    {D' : Set (StrongDual 𝕜 F)} {T : E →L[𝕜] F}
    (hT : ∀ φ ∈ D', φ.comp T ∈ D) :
    Measurable[dualTestMeasurableSpace D, dualTestMeasurableSpace D'] T := by
  let : MeasurableSpace E := dualTestMeasurableSpace D
  apply measurable_dualTestMeasurableSpace_iff.mpr
  intro φ hφ
  exact (dualTestMeasurableSpace_le_iff.mp le_rfl) (φ.comp T) (hT φ hφ)

/-- The dual-test σ-algebra is the pullback of the product σ-algebra by the
map listing all the chosen evaluations. -/
theorem dualTestMeasurableSpace_eq_comap (D : Set (StrongDual 𝕜 E)) :
    dualTestMeasurableSpace D =
      MeasurableSpace.comap (fun x (φ : D) ↦ φ.val x) MeasurableSpace.pi := by
  simp only [MeasurableSpace.pi, MeasurableSpace.comap_iSup,
    MeasurableSpace.comap_comp, Function.comp_def, dualTestMeasurableSpace]

/-- Finite scalar cylinder events generate the dual-test σ-algebra. The scalar
products carry their usual product measurable structures. -/
theorem dualTestMeasurableSpace_eq_generateFrom (D : Set (StrongDual 𝕜 E)) :
    dualTestMeasurableSpace D = MeasurableSpace.generateFrom
      {A | ∃ (s : Finset D) (B : Set (s → 𝕜)), MeasurableSet B ∧
        A = (fun x (φ : s) ↦ φ.val.val x) ⁻¹' B} := by
  rw [dualTestMeasurableSpace_eq_comap, ← generateFrom_measurableCylinders,
    MeasurableSpace.comap_generateFrom]
  congr 1
  ext A
  constructor
  · rintro ⟨C, hC, rfl⟩
    obtain ⟨s, B, hB, rfl⟩ := (mem_measurableCylinders _).mp hC
    exact ⟨s, B, hB, rfl⟩
  · rintro ⟨s, B, hB, rfl⟩
    exact ⟨cylinder s B,
      cylinder_mem_measurableCylinders (α := fun _ : D ↦ 𝕜) s B hB, rfl⟩

end MeasurableStructure

section CountableTests

variable {𝕜 E : Type*} [NontriviallyNormedField 𝕜]
  [NormedAddCommGroup E] [NormedSpace 𝕜 E] [SeparableSpace E]

/-- A point-separating family of continuous dual tests on a separable normed
space contains a countable point-separating subfamily. -/
theorem exists_countable_separating_dual_tests {D : Set (StrongDual 𝕜 E)}
    (hD : ∀ x y : E, (∀ φ ∈ D, φ x = φ y) → x = y) :
    ∃ C ⊆ D, C.Countable ∧ ∀ x y : E, (∀ φ ∈ C, φ x = φ y) → x = y := by
  let U (φ : D) : Set (E × E) := {p | φ.val p.1 ≠ φ.val p.2}
  have hU (φ : D) : IsOpen (U φ) :=
    isOpen_ne_fun (φ.val.continuous.comp continuous_fst)
      (φ.val.continuous.comp continuous_snd)
  obtain ⟨C, hC, hcover⟩ := eq_open_union_countable U hU
  refine ⟨Subtype.val '' C, Subtype.coe_image_subset D C, hC.image _, ?_⟩
  intro x y hxy
  apply hD x y
  intro φ hφ
  by_contra hne
  have hp : (x, y) ∈ ⋃ ψ, U ψ := mem_iUnion.mpr ⟨⟨φ, hφ⟩, hne⟩
  rw [← hcover] at hp
  obtain ⟨ψ, hψ, hp⟩ := mem_iUnion₂.mp hp
  exact hp (hxy ψ (mem_image_of_mem _ hψ))

end CountableTests

section BorelComparison

variable {𝕜 E Ω : Type*} [NontriviallyNormedField 𝕜] [MeasurableSpace 𝕜] [BorelSpace 𝕜]
  [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- Continuous dual tests are norm-Borel measurable, so their generated
σ-algebra is contained in the norm-Borel σ-algebra. -/
theorem dualTestMeasurableSpace_le_borel (D : Set (StrongDual 𝕜 E)) :
    dualTestMeasurableSpace D ≤ borel E := by
  let : MeasurableSpace E := borel E
  let : BorelSpace E := ⟨rfl⟩
  exact dualTestMeasurableSpace_le_iff.mpr fun φ _ ↦ φ.continuous.measurable

/-- On a separable Banach space, any point-separating family of continuous
linear functionals generates the norm-Borel σ-algebra. -/
theorem dualTestMeasurableSpace_eq_borel [SeparableSpace E] [CompleteSpace E]
    [SecondCountableTopology 𝕜]
    {D : Set (StrongDual 𝕜 E)}
    (hD : ∀ x y : E, (∀ φ ∈ D, φ x = φ y) → x = y) :
    dualTestMeasurableSpace D = borel E := by
  let : MeasurableSpace E := borel E
  let : BorelSpace E := ⟨rfl⟩
  obtain ⟨C, hCD, hC, hsep⟩ := exists_countable_separating_dual_tests hD
  let : Countable C := hC.to_subtype
  have hB : borel E = dualTestMeasurableSpace C :=
    measurableSpace_eq_iSup_comap_of_separatesPoints
      (fun φ : C ↦ φ.val.continuous.measurable)
      (fun x y h ↦ hsep x y fun φ hφ ↦ h ⟨φ, hφ⟩)
  exact le_antisymm (dualTestMeasurableSpace_le_borel D)
    (hB ▸ dualTestMeasurableSpace_mono hCD)

/-- Scalar tests from a separating family characterize strong measurability
for functions into a separable Banach space. -/
theorem stronglyMeasurable_iff_separating_dual_tests [MeasurableSpace Ω]
    [SecondCountableTopology 𝕜] [SeparableSpace E] [CompleteSpace E]
    {D : Set (StrongDual 𝕜 E)}
    (hD : ∀ x y : E, (∀ φ ∈ D, φ x = φ y) → x = y) {f : Ω → E} :
    StronglyMeasurable f ↔ ∀ φ ∈ D, Measurable (fun ω ↦ φ (f ω)) := by
  let : MeasurableSpace E := borel E
  let : BorelSpace E := ⟨rfl⟩
  rw [stronglyMeasurable_iff_measurable,
    ← measurable_dualTestMeasurableSpace_iff, dualTestMeasurableSpace_eq_borel hD]

/-- Scalar tests separating a complete separable supporting subspace characterize
strong measurability, even when the ambient normed space is not separable or complete.
The test family need not be linear or norming. -/
theorem stronglyMeasurable_iff_separating_tests [MeasurableSpace Ω]
    [SecondCountableTopology 𝕜]
    {V : Submodule 𝕜 E} [SeparableSpace V] [CompleteSpace V]
    {D : Set (StrongDual 𝕜 E)}
    (hD : ∀ x y : V, (∀ φ ∈ D, φ x = φ y) → x = y)
    {f : Ω → E} (hf : ∀ ω, f ω ∈ V) :
    StronglyMeasurable f ↔ ∀ φ ∈ D, Measurable (fun ω ↦ φ (f ω)) := by
  let g : Ω → V := fun ω ↦ ⟨f ω, hf ω⟩
  let C : Set (StrongDual 𝕜 V) := (fun φ : StrongDual 𝕜 E ↦ φ.comp V.subtypeL) '' D
  have hC : ∀ x y : V, (∀ ψ ∈ C, ψ x = ψ y) → x = y := by
    intro x y hxy
    exact hD x y fun φ hφ ↦ hxy (φ.comp V.subtypeL) (mem_image_of_mem _ hφ)
  have hfg : StronglyMeasurable f ↔ StronglyMeasurable g :=
    Embedding.comp_stronglyMeasurable_iff (f := g) Topology.IsEmbedding.subtypeVal
  rw [hfg, stronglyMeasurable_iff_separating_dual_tests hC]
  constructor
  · intro h φ hφ
    exact h (φ.comp V.subtypeL) (mem_image_of_mem _ hφ)
  · rintro h ψ ⟨φ, hφ, rfl⟩
    exact h φ hφ

end BorelComparison

end TauCeti
