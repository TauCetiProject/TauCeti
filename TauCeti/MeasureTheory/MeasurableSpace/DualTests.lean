module

public import Mathlib.MeasureTheory.Constructions.Cylinders
public import TauCeti.MeasureTheory.Function.StronglyMeasurable.ScalarTests

/-!
# Generators of the σ-algebra of dual tests

`TauCeti.evalMeasurableSpace T` is the smallest σ-algebra making the continuous linear
functionals in `T` measurable. This file records how it is generated:

* `TauCeti.evalMeasurableSpace_eq_comap`: it is the pullback of the product σ-algebra along
  the map listing all the chosen evaluations;
* `TauCeti.evalMeasurableSpace_eq_generateFrom`: it is generated by finite-dimensional scalar
  cylinder events.

With no tests the generated σ-algebra is trivial (`TauCeti.evalMeasurableSpace_empty`). On a
separable Banach space, `TauCeti.stronglyMeasurable_iff_separating_dual_tests` specializes
Pettis' criterion `TauCeti.stronglyMeasurable_iff_separating_tests` to the whole space.

## References

* T. Hytönen, J. van Neerven, M. Veraar and L. Weis, *Analysis in Banach Spaces*,
  Volume I, Theorem 1.1.6 and Corollary 1.1.10.
-/

public section

open MeasurableSpace MeasureTheory Set TopologicalSpace

namespace TauCeti

section MeasurableStructure

variable {𝕜 E : Type*} [NontriviallyNormedField 𝕜] [MeasurableSpace 𝕜]
  [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- With no tests, the generated σ-algebra is trivial. -/
@[simp]
theorem evalMeasurableSpace_empty :
    evalMeasurableSpace (∅ : Set (StrongDual 𝕜 E)) = ⊥ :=
  le_antisymm (evalMeasurableSpace_le_iff.2 fun _ h ↦ h.elim) bot_le

/-- The dual-test σ-algebra is the pullback of the product σ-algebra by the
map listing all the chosen evaluations. -/
theorem evalMeasurableSpace_eq_comap (T : Set (StrongDual 𝕜 E)) :
    evalMeasurableSpace T =
      MeasurableSpace.comap (fun x (φ : T) ↦ φ.val x) MeasurableSpace.pi := by
  refine le_antisymm (evalMeasurableSpace_le_iff.2 fun φ hφ ↦ ?_) ?_
  · exact (measurable_pi_apply (X := fun _ : T ↦ 𝕜) ⟨φ, hφ⟩).comp (comap_measurable _)
  · let : MeasurableSpace E := evalMeasurableSpace T
    exact measurable_iff_comap_le.1 <| measurable_pi_iff.2 fun φ ↦
      measurable_evalMeasurableSpace_apply φ.property

/-- Finite scalar cylinder events generate the dual-test σ-algebra. The scalar
products carry their usual product measurable structures. -/
theorem evalMeasurableSpace_eq_generateFrom (T : Set (StrongDual 𝕜 E)) :
    evalMeasurableSpace T = MeasurableSpace.generateFrom
      {A | ∃ (s : Finset T) (B : Set (s → 𝕜)), MeasurableSet B ∧
        A = (fun x (φ : s) ↦ φ.val.val x) ⁻¹' B} := by
  rw [evalMeasurableSpace_eq_comap, ← generateFrom_measurableCylinders,
    MeasurableSpace.comap_generateFrom]
  congr 1
  ext A
  constructor
  · rintro ⟨C, hC, rfl⟩
    obtain ⟨s, B, hB, rfl⟩ := (mem_measurableCylinders _).mp hC
    exact ⟨s, B, hB, rfl⟩
  · rintro ⟨s, B, hB, rfl⟩
    exact ⟨cylinder s B,
      cylinder_mem_measurableCylinders (α := fun _ : T ↦ 𝕜) s B hB, rfl⟩

end MeasurableStructure

section BorelComparison

variable {𝕜 E Ω : Type*} [NontriviallyNormedField 𝕜] [MeasurableSpace 𝕜] [BorelSpace 𝕜]
  [SecondCountableTopology 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- Scalar tests from a separating family characterize strong measurability
for functions into a separable Banach space. -/
theorem stronglyMeasurable_iff_separating_dual_tests [MeasurableSpace Ω]
    [SeparableSpace E] [CompleteSpace E]
    {T : Set (StrongDual 𝕜 E)} (hT : ∀ x : E, (∀ φ ∈ T, φ x = 0) → x = 0) {f : Ω → E} :
    StronglyMeasurable f ↔ ∀ φ ∈ T, Measurable (fun ω ↦ φ (f ω)) := by
  borelize E
  rw [stronglyMeasurable_iff_measurable, ← measurable_evalMeasurableSpace_iff,
    evalMeasurableSpace_eq_borel_of_separating hT]

end BorelComparison

end TauCeti
