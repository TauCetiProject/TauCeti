module

public import TauCeti.NumberTheory.LFunctions.Zeros.OneSidedBound.Parameters
public import Mathlib.NumberTheory.Cyclotomic.Basic
public import TauCeti.NumberTheory.NumberField.Quadratic.EmbeddingBound
public import TauCeti.NumberTheory.NumberField.InfinitePlace.Basic

import TauCeti.FieldTheory.IntermediateField.Quadratic
import TauCeti.NumberTheory.Multiquadratic.Cyclotomic.FundamentalDiscriminant
import TauCeti.NumberTheory.NumberField.Quadratic.InfinitePlace
import Mathlib.RingTheory.RootsOfUnity.Complex

/-!
# The cyclotomic host of the one-sided prime sum

Over the imaginary quadratic field `ℚ(√-d)`, adjoin a primitive root of unity of order
`q₁(s)`. Realizing both fields inside `ℂ` fixes the embedding to be used when choosing
representatives of the infinite places. The host lies in the rational cyclotomic field of
order `q₁(s) * d`, so it is abelian over `ℚ` as well as over the quadratic base.

This is the field construction in `New.Parameters.E` and `New.Parameters.toCycloField` of
lsernau/grh-lean (`New/Reduction/Data/FieldsAndPlaces.lean`, commit `72fead1`); the inclusion
uses `TauCeti.Multiquadratic.mem_of_sq_eq_of_isFundamentalDiscr` for the quadratic generator.
-/

public section

noncomputable section

open IntermediateField Complex NumberField

namespace TauCeti.OneSidedBound.Parameters

variable (P : Parameters)

/-- The imaginary quadratic base `ℚ(√-d)` inside `ℂ`. -/
def baseField : IntermediateField ℚ ℂ := ℚ⟮QuadraticAlgebra.sqrtRadicand (-(P.d : ℚ))⟯

/-- The base is the subfield generated by the chosen square root of `-d`. -/
theorem baseField_eq_adjoin :
    P.baseField = ℚ⟮QuadraticAlgebra.sqrtRadicand (-(P.d : ℚ))⟯ := (rfl)

/-- The chosen square root of `-d`, viewed as an element of the quadratic base. -/
def baseRoot : P.baseField := ⟨_, mem_adjoin_simple_self ℚ _⟩

/-- The image of the quadratic generator in `ℂ` is the chosen square root. -/
@[simp] theorem coe_baseRoot :
    (P.baseRoot : ℂ) = QuadraticAlgebra.sqrtRadicand (-(P.d : ℚ)) := (rfl)

/-- The square of the quadratic generator in the base field. -/
@[simp] theorem baseRoot_sq : P.baseRoot ^ 2 = -(P.d : P.baseField) := by
  apply (algebraMap P.baseField ℂ).injective
  simp [sq]

/-- The imaginary quadratic base has degree two over `ℚ`. -/
theorem finrank_baseField : Module.finrank ℚ P.baseField = 2 := by
  rw [baseField_eq_adjoin]
  exact TauCeti.IntermediateField.finrank_adjoin_simple_eq_two_of_not_isSquare
    (a := -(P.d : ℚ)) (by simp [sq])
    (not_isSquare_of_neg (neg_neg_of_pos (by exact_mod_cast P.prime_d.pos)))

/-- The base is a number field. -/
instance instNumberFieldBaseField : NumberField P.baseField where
  to_finiteDimensional := Module.finite_of_finrank_pos (by rw [P.finrank_baseField]; decide)

/-- The host field `ℚ(√-d)(ζ)` inside `ℂ`, with `ζ` of order `q₁(s)`. -/
def hostField (s : ℕ) : IntermediateField P.baseField ℂ :=
  P.baseField⟮exp (2 * Real.pi * I / (P.q₁ s : ℂ))⟯

/-- Over the quadratic base, the host is generated by the chosen complex root of unity. -/
theorem hostField_eq_adjoin (s : ℕ) :
    P.hostField s = P.baseField⟮exp (2 * Real.pi * I / (P.q₁ s : ℂ))⟯ := (rfl)

/-- Over `ℚ` the host is the compositum of the quadratic base and the `q₁(s)` cyclotomic field. -/
theorem hostField_restrictScalars (s : ℕ) :
    (P.hostField s).restrictScalars ℚ =
      P.baseField ⊔ ℚ⟮exp (2 * Real.pi * I / (P.q₁ s : ℂ))⟯ := by
  rw [hostField_eq_adjoin, restrictScalars_adjoin_eq_sup]

/-- The chosen cyclotomic generator in the host. -/
def hostRoot (s : ℕ) : P.hostField s := ⟨_, mem_adjoin_simple_self _ _⟩

/-- The host generator maps to `exp(2πi / q₁(s))` under the fixed complex embedding. -/
@[simp] theorem coe_hostRoot (s : ℕ) :
    (P.hostRoot s : ℂ) = exp (2 * Real.pi * I / (P.q₁ s : ℂ)) := (rfl)

/-- The chosen host generator has exact order `q₁(s)`. -/
theorem isPrimitiveRoot_hostRoot (s : ℕ) : IsPrimitiveRoot (P.hostRoot s) (P.q₁ s) :=
  (IsPrimitiveRoot.map_iff_of_injective (algebraMap (P.hostField s) ℂ).injective).mp <| by
    simpa only [IntermediateField.algebraMap_apply, coe_hostRoot] using
      isPrimitiveRoot_exp (P.q₁ s) (NeZero.ne _)

/-- The host is a cyclotomic extension of the quadratic base. -/
instance instIsCyclotomicExtensionHostField (s : ℕ) :
    IsCyclotomicExtension {P.q₁ s} P.baseField (P.hostField s) :=
  (isPrimitiveRoot_exp (P.q₁ s) (NeZero.ne _)).intermediateField_adjoin_isCyclotomicExtension _

/-- Neither embedding of the imaginary quadratic base is real. -/
instance instIsTotallyComplexBaseField : IsTotallyComplex P.baseField :=
  isTotallyComplex_of_sq_ratCast_of_neg (x := P.baseRoot) (r := -(P.d : ℚ))
    (by simp) (neg_neg_of_pos (by exact_mod_cast P.prime_d.pos))

/-- The imaginary quadratic base has a unique infinite place. -/
instance instSubsingletonInfinitePlaceBaseField : Subsingleton (InfinitePlace P.baseField) := by
  have heq := TauCeti.NumberField.infinitePlace_eq_mk_of_finrank_eq_two P.finrank_baseField
    (algebraMap P.baseField ℂ)
  exact ⟨fun v w => (heq v).trans (heq w).symm⟩

/-- Every infinite place of the host is complex. -/
instance instIsTotallyComplexHostField (s : ℕ) : IsTotallyComplex (P.hostField s) :=
  isTotallyComplex_of_algebra P.baseField (P.hostField s)

/-- For the parameter prime `d`, `-d` is a fundamental discriminant. -/
theorem isFundamentalDiscr_neg_d : Int.IsFundamentalDiscr (-(P.d : ℤ)) := by
  have hfour : P.d % 4 = 3 := by have := P.d_mod_eight; omega
  rw [← Multiquadratic.oddPrimeDiscriminant_of_mod_four_eq_three hfour]
  exact (Multiquadratic.isPrimeDiscriminant_oddPrimeDiscriminant P.prime_d
    P.odd_d).isFundamentalDiscr

/-- The complex realization of the host lies in the rational cyclotomic field generated by
any primitive root of order `q₁(s) * d`. -/
theorem hostField_le_cyclotomic (s : ℕ) {ξ : ℂ} (hξ : IsPrimitiveRoot ξ (P.q₁ s * P.d)) :
    (P.hostField s).restrictScalars ℚ ≤ ℚ⟮ξ⟯ := by
  have hn := Nat.mul_pos (P.q₁_pos s) P.prime_d.pos
  let : NeZero (P.q₁ s * P.d) := ⟨hn.ne'⟩
  have hmem : ξ ∈ ℚ⟮ξ⟯ := mem_adjoin_simple_self ℚ ξ
  rw [hostField_restrictScalars, sup_le_iff, baseField_eq_adjoin, adjoin_simple_le_iff,
    adjoin_simple_le_iff]
  constructor
  · apply Multiquadratic.mem_of_sq_eq_of_isFundamentalDiscr hn hξ hmem
      P.isFundamentalDiscr_neg_d (by simp)
    simp [sq]
  · have hpow : exp (2 * Real.pi * I / (P.q₁ s : ℂ)) ^ (P.q₁ s * P.d) = 1 := by
      rw [pow_mul, (isPrimitiveRoot_exp _ (NeZero.ne (P.q₁ s))).pow_eq_one, one_pow]
    obtain ⟨k, -, hk⟩ := hξ.eq_pow_of_pow_eq_one hpow
    exact hk ▸ pow_mem hmem k

/-- The host is a number field. -/
instance instNumberFieldHostField (s : ℕ) : NumberField (P.hostField s) :=
  IsCyclotomicExtension.numberField {P.q₁ s} P.baseField (P.hostField s)

/-- The host is abelian Galois over the rationals. -/
instance instIsAbelianGaloisHostFieldRat (s : ℕ) : IsAbelianGalois ℚ (P.hostField s) := by
  let n := P.q₁ s * P.d
  have hn : 0 < n := Nat.mul_pos (P.q₁_pos s) P.prime_d.pos
  let : NeZero n := ⟨hn.ne'⟩
  let ξ := exp (2 * Real.pi * I / (n : ℂ))
  have hξ : IsPrimitiveRoot ξ n := isPrimitiveRoot_exp n hn.ne'
  let : IsCyclotomicExtension {n} ℚ ℚ⟮ξ⟯ := hξ.intermediateField_adjoin_isCyclotomicExtension ℚ
  let := IsCyclotomicExtension.isAbelianGalois {n} ℚ ℚ⟮ξ⟯
  exact IsAbelianGalois.of_algHom (inclusion (P.hostField_le_cyclotomic s hξ))

/-- The host is abelian Galois over its imaginary quadratic base. -/
instance instIsAbelianGaloisHostField (s : ℕ) : IsAbelianGalois P.baseField (P.hostField s) :=
  IsCyclotomicExtension.isAbelianGalois {P.q₁ s} P.baseField (P.hostField s)

end TauCeti.OneSidedBound.Parameters
