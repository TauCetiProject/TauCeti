/-! ### Rational prime support, ideal weights, and Euler corrections -/

namespace GlobalNumberFields

namespace RayClassCharacter

variable {𝔪 𝔫 : Modulus ℚ}

/-- **At any nonzero integer `m : ℕ`, the ideal weight of a rational ray class character at `(m)`
equals its Dirichlet character at `m`**, including when `m` is not coprime to the modulus. -/
theorem toMultiplicativeIdealWeight_span_natCast (η : RayClassCharacter 𝔪) {m : ℕ} (hm : m ≠ 0) :
    η.toMultiplicativeIdealWeight (Ideal.span {(m : 𝓞 ℚ)}) = η.toDirichletCharacter m := by
  by_cases hcop : m.Coprime (Ideal.absNorm 𝔪.finitePart)
  · have hI : Ideal.IsPrimeTo (Ideal.span {(m : 𝓞 ℚ)}) 𝔪.support :=
      (isPrimeTo_span_natCast_support_iff hm).mpr hcop
    have hnorm : Ideal.absNorm (Ideal.span {(m : 𝓞 ℚ)}) = m := by
      rw [← ratModulus_finitePart m hm, absNorm_ratModulus_finitePart]
    rw [toMultiplicativeIdealWeight_apply_of_isPrimeTo η hI,
      ← η.toDirichletCharacter_absNorm ⟨Ideal.span {(m : 𝓞 ℚ)},
        NumberFieldArithmetic.mem_integralIdealsAway_iff.mpr (Ideal.isPrimeTo_iff.mp hI)⟩,
      hnorm]
  · have hI : ¬ Ideal.IsPrimeTo (Ideal.span {(m : 𝓞 ℚ)}) 𝔪.support :=
      (isPrimeTo_span_natCast_support_iff hm).not.mpr hcop
    rw [toMultiplicativeIdealWeight_apply_of_not_isPrimeTo η hI,
      η.toDirichletCharacter.map_nonunit (by rwa [ZMod.isUnit_iff_coprime])]

/-- **At every nonzero ideal `I` of `𝓞 ℚ`, the ideal weight of `η` equals its Dirichlet character
at `Ideal.absNorm I`**, whether or not `I` is prime to `𝔪`. -/
theorem toMultiplicativeIdealWeight_eq_toDirichletCharacter_absNorm (η : RayClassCharacter 𝔪)
    {I : Ideal (𝓞 ℚ)} (hI : I ≠ ⊥) :
    η.toMultiplicativeIdealWeight I = η.toDirichletCharacter (Ideal.absNorm I) := by
  have hm : Ideal.absNorm I ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hI
  conv_lhs => rw [← Rat.RingOfIntegers.ideal_span_absNorm_eq_self I]
  exact toMultiplicativeIdealWeight_span_natCast η hm

/-- **Regrouping the unitary ideal weight of a rational ray class character by absolute norm gives
the arithmetic function of its Dirichlet character.** -/
@[simp]
theorem normCoeff_toUnitaryIdealWeight (η : RayClassCharacter 𝔪) :
    normCoeff ℚ η.toUnitaryIdealWeight.toIdealArithmeticFunction =
      toArithmeticFunction (η.toDirichletCharacter ·) := by
  have hfun : η.toUnitaryIdealWeight.toIdealArithmeticFunction =
      fun I : (Ideal (𝓞 ℚ))⁰ ↦
        (1 : IdealArithmeticFunction ℚ) I *
          (fun k : ℕ ↦ η.toDirichletCharacter k) (Ideal.absNorm (I : Ideal (𝓞 ℚ))) := by
    ext I
    rw [UnitaryIdealWeight.toIdealArithmeticFunction_eq_val, val_toUnitaryIdealWeight,
      MultiplicativeIdealWeight.toIdealArithmeticFunction_apply, Pi.one_apply, one_mul]
    exact toMultiplicativeIdealWeight_eq_toDirichletCharacter_absNorm η
      (nonZeroDivisors.coe_ne_zero I)
  ext m
  rcases eq_or_ne m 0 with rfl | hm
  · simp
  · rw [hfun, normCoeff_fun_mul_comp_absNorm ℚ 1 (fun k : ℕ ↦ η.toDirichletCharacter k) m,
      normCoeff_one_rat_apply (Nat.pos_of_ne_zero hm), one_mul,
      ← η.toDirichletCharacter.apply_eq_toArithmeticFunction_apply hm]

/-- **The `L`-series of a rational ray class character equals the `L`-series of its Dirichlet
character at every complex point.** -/
theorem LSeries_toUnitaryIdealWeight_eq (η : RayClassCharacter 𝔪) (s : ℂ) :
    LSeries (normCoeff ℚ η.toUnitaryIdealWeight.toIdealArithmeticFunction) s =
      LSeries (η.toDirichletCharacter ·) s := by
  rw [normCoeff_toUnitaryIdealWeight]
  apply LSeries_congr
  intro n hn
  exact (η.toDirichletCharacter.apply_eq_toArithmeticFunction_apply hn).symm

/-- At `(n)·∞`, the `L`-series of `(ratDirichletEquiv n hn).symm χ` equals the `L`-series of `χ`
at every complex point. -/
theorem LSeries_ratDirichletEquiv_symm {n : ℕ} (hn : n ≠ 0) (χ : DirichletCharacter ℂ n) (s : ℂ) :
    LSeries (normCoeff ℚ
      ((ratDirichletEquiv n hn).symm χ).toUnitaryIdealWeight.toIdealArithmeticFunction) s =
      LSeries (χ ·) s := by
  rw [LSeries_toUnitaryIdealWeight_eq]
  apply LSeries_congr
  intro m _
  exact toDirichletCharacter_ratDirichletEquiv_symm_natCast χ m

/-- **Over `ℚ`, the deleted Euler correction of `η` at `𝔫` is the product over all prime factors of
`Ideal.absNorm 𝔫.finitePart`** (primes dividing `𝔪` contribute `1` because `η.toDirichletCharacter`
vanishes there). -/
theorem eulerCorrection_eq_prod_primeFactors (η : RayClassCharacter 𝔪) (𝔫 : Modulus ℚ) (s : ℂ) :
    η.eulerCorrection 𝔫 s = ∏ p ∈ (Ideal.absNorm 𝔫.finitePart).primeFactors,
      (1 - η.toDirichletCharacter p * (p : ℂ) ^ (-s)) := by
  rw [← image_absNorm_support 𝔫,
    Finset.prod_image Rat.HeightOneSpectrum.absNorm_asIdeal_injective.injOn,
    eulerCorrection_eq_prod_support]
  exact Finset.prod_congr rfl fun 𝔭 _ ↦ by
    rw [toMultiplicativeIdealWeight_eq_toDirichletCharacter_absNorm η 𝔭.ne_bot]

/-- **Over `ℚ`, the deleted Euler correction of `η` at `𝔫` is the product over prime factors of
`Ideal.absNorm 𝔫.finitePart` not dividing `Ideal.absNorm 𝔪.finitePart`.** -/
theorem eulerCorrection_eq_prod_sdiff_primeFactors (η : RayClassCharacter 𝔪) (𝔫 : Modulus ℚ)
    (s : ℂ) :
    η.eulerCorrection 𝔫 s =
      ∏ p ∈ (Ideal.absNorm 𝔫.finitePart).primeFactors \ (Ideal.absNorm 𝔪.finitePart).primeFactors,
        (1 - η.toDirichletCharacter p * (p : ℂ) ^ (-s)) := by
  rw [eulerCorrection_eq_prod_primeFactors]
  refine (Finset.prod_subset Finset.sdiff_subset fun p hpN hp ↦ ?_).symm
  have hpM : p ∈ (Ideal.absNorm 𝔪.finitePart).primeFactors := by
    by_contra h
    exact hp (Finset.mem_sdiff.mpr ⟨hpN, h⟩)
  have hzero : η.toDirichletCharacter p = 0 := by
    refine η.toDirichletCharacter.map_nonunit ?_
    rw [ZMod.isUnit_iff_coprime, (Nat.prime_of_mem_primeFactors hpM).coprime_iff_not_dvd, not_not]
    exact Nat.dvd_of_mem_primeFactors hpM
  rw [hzero, zero_mul, sub_zero]

/-- For `χ : DirichletCharacter ℂ m`, the deleted Euler correction of
`(ratDirichletEquiv m hm).symm χ` at `(n)·∞` is
`∏ p ∈ n.primeFactors \ m.primeFactors, (1 - χ p * p ^ (-s))`. -/
theorem eulerCorrection_ratDirichletEquiv_symm {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0)
    (χ : DirichletCharacter ℂ m) (s : ℂ) :
    ((ratDirichletEquiv m hm).symm χ).eulerCorrection (ratModulus n hn) s =
      ∏ p ∈ n.primeFactors \ m.primeFactors, (1 - χ p * (p : ℂ) ^ (-s)) := by
  rw [eulerCorrection_eq_prod_sdiff_primeFactors]
  refine Finset.prod_congr ?_ fun p _ ↦ by simp
  rw [absNorm_ratModulus_finitePart, absNorm_ratModulus_finitePart]

end RayClassCharacter

end GlobalNumberFields

/-! ### Primitive ray class characters of `ℚ` and primitive Dirichlet characters -/

namespace LFunctions

namespace PrimitiveRayClassCharacter

/-- **The primitive Dirichlet character attached to a bundled primitive ray class character of
`ℚ`**, of level `Ideal.absNorm ψ.conductor.finitePart`. -/
def toDirichletCharacter (ψ : PrimitiveRayClassCharacter ℚ) :
    DirichletCharacter ℂ (Ideal.absNorm ψ.conductor.finitePart) :=
  ψ.character.toDirichletCharacter

theorem toDirichletCharacter_def (ψ : PrimitiveRayClassCharacter ℚ) :
    ψ.toDirichletCharacter = ψ.character.toDirichletCharacter := (rfl)

/-- The Dirichlet character of a primitive ray class character of `ℚ` is primitive. -/
theorem isPrimitive_toDirichletCharacter (ψ : PrimitiveRayClassCharacter ℚ) :
    ψ.toDirichletCharacter.IsPrimitive := by
  rw [DirichletCharacter.isPrimitive_def, toDirichletCharacter_def,
    RayClassCharacter.conductor_toDirichletCharacter, ψ.conductor_character]

@[simp]
theorem toDirichletCharacter_eq_one_iff (ψ : PrimitiveRayClassCharacter ℚ) :
    ψ.toDirichletCharacter = 1 ↔ ψ = 1 := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ map_one _⟩
  have hchar : ψ.character = 1 :=
    (RayClassCharacter.toDirichletCharacter_eq_one_iff ψ.character).mp h
  rw [← of_character ψ, hchar, of_one]

/-- Along `Ideal.absNorm (of η).conductor.finitePart = η.toDirichletCharacter.conductor`,
`(of η).toDirichletCharacter` is `η.toDirichletCharacter.primitiveCharacter`. -/
theorem changeLevel_toDirichletCharacter_of {𝔪 : Modulus ℚ} (η : RayClassCharacter 𝔪) :
    changeLevel (dvd_of_eq (by rw [conductor_of, RayClassCharacter.conductor_toDirichletCharacter]))
      (of η).toDirichletCharacter = η.toDirichletCharacter.primitiveCharacter := by
  apply changeLevel_injective η.toDirichletCharacter.conductor_dvd_level
  rw [← changeLevel_trans, changeLevel_primitiveCharacter, toDirichletCharacter_def,
    ← RayClassCharacter.toDirichletCharacter_induced (conductor_of_dvd η), induced_character_of]

@[simp]
theorem toDirichletCharacter_of_intCast {𝔪 : Modulus ℚ} (η : RayClassCharacter 𝔪) (m : ℤ) :
    (of η).toDirichletCharacter m = η.toDirichletCharacter.primitiveCharacter m := by
  have heq : Ideal.absNorm (of η).conductor.finitePart = η.toDirichletCharacter.conductor := by
    rw [conductor_of, RayClassCharacter.conductor_toDirichletCharacter]
  refine apply_intCast_eq_of_forall_isCoprime heq (fun a ha ↦ ?_) m
  have ha' : IsCoprime a η.toDirichletCharacter.conductor := heq ▸ ha
  rw [← changeLevel_toDirichletCharacter_of η, changeLevel_eq_cast_of_dvd' _ _ ha']

@[simp]
theorem toDirichletCharacter_of_natCast {𝔪 : Modulus ℚ} (η : RayClassCharacter 𝔪) (m : ℕ) :
    (of η).toDirichletCharacter m = η.toDirichletCharacter.primitiveCharacter m := by
  simpa only [Int.cast_natCast] using toDirichletCharacter_of_intCast η (m : ℤ)

/-- **The bundled primitive ray class character of `ℚ` underlying a complex Dirichlet character.**
This applies to imprimitive characters as well as primitive ones: it extracts the ray class
conductor (`(f)` if `χ` is even, `(f)·∞` if `χ` is odd, where `f = χ.conductor`) together with its
primitive ray class character. -/
def ofDirichletCharacter {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) :
    PrimitiveRayClassCharacter ℚ :=
  of ((ratDirichletEquiv N (NeZero.ne N)).symm χ)

theorem ofDirichletCharacter_def {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) :
    ofDirichletCharacter χ = of ((ratDirichletEquiv N (NeZero.ne N)).symm χ) := (rfl)

@[simp]
theorem absNorm_conductor_ofDirichletCharacter {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) :
    Ideal.absNorm (ofDirichletCharacter χ).conductor.finitePart = χ.conductor := by
  rw [ofDirichletCharacter_def, conductor_of, RayClassCharacter.absNorm_conductor_finitePart,
    MulEquiv.apply_symm_apply]

/-- For an even Dirichlet character `χ`, the conductor of `ofDirichletCharacter χ` is the finite
modulus `(χ.conductor)` without the real place. -/
theorem conductor_ofDirichletCharacter_of_even {N : ℕ} [NeZero N] {χ : DirichletCharacter ℂ N}
    (hχ : χ.Even) :
    (ofDirichletCharacter χ).conductor = ratFiniteModulus χ.conductor (conductor_ne_zero χ) := by
  have h := RayClassCharacter.conductor_eq_ratFiniteModulus_of_even
    (η := (ratDirichletEquiv N (NeZero.ne N)).symm χ)
    (by simpa only [MulEquiv.apply_symm_apply] using hχ)
  simpa only [ofDirichletCharacter_def, conductor_of, MulEquiv.apply_symm_apply] using h

/-- For an odd Dirichlet character `χ`, the conductor of `ofDirichletCharacter χ` is the modulus
`(χ.conductor)·∞` including the real place. -/
theorem conductor_ofDirichletCharacter_of_not_even {N : ℕ} [NeZero N] {χ : DirichletCharacter ℂ N}
    (hχ : ¬ χ.Even) :
    (ofDirichletCharacter χ).conductor = ratModulus χ.conductor (conductor_ne_zero χ) := by
  have h := RayClassCharacter.conductor_eq_ratModulus_of_not_even
    (η := (ratDirichletEquiv N (NeZero.ne N)).symm χ)
    (by simpa only [MulEquiv.apply_symm_apply] using hχ)
  simpa only [ofDirichletCharacter_def, conductor_of, MulEquiv.apply_symm_apply] using h

@[simp]
theorem ofDirichletCharacter_toDirichletCharacter {𝔪 : Modulus ℚ} (η : RayClassCharacter 𝔪) :
    ofDirichletCharacter η.toDirichletCharacter = of η := by
  rw [ofDirichletCharacter_def, RayClassCharacter.toDirichletCharacter_def,
    MulEquiv.symm_apply_apply, of_induced]

@[simp]
theorem ofDirichletCharacter_primitive_toDirichletCharacter (ψ : PrimitiveRayClassCharacter ℚ) :
    ofDirichletCharacter ψ.toDirichletCharacter = ψ := by
  rw [toDirichletCharacter_def, ofDirichletCharacter_toDirichletCharacter, of_character]

@[simp]
theorem ofDirichletCharacter_changeLevel {M N : ℕ} [NeZero M] [NeZero N] (hMN : M ∣ N)
    (χ : DirichletCharacter ℂ M) :
    ofDirichletCharacter (changeLevel hMN χ) = ofDirichletCharacter χ := by
  have hmod : ratModulus M (NeZero.ne M) ∣ ratModulus N (NeZero.ne N) :=
    ratModulus_dvd_ratModulus_iff.mpr hMN
  have hsymm : (ratDirichletEquiv N (NeZero.ne N)).symm (changeLevel hMN χ) =
      ((ratDirichletEquiv M (NeZero.ne M)).symm χ).induced hmod := by
    apply (ratDirichletEquiv N (NeZero.ne N)).injective
    rw [MulEquiv.apply_symm_apply, ratDirichletEquiv_induced, MulEquiv.apply_symm_apply]
  rw [ofDirichletCharacter_def, hsymm, of_induced, ← ofDirichletCharacter_def]

@[simp]
theorem toDirichletCharacter_inv (ψ : PrimitiveRayClassCharacter ℚ) :
    ψ⁻¹.toDirichletCharacter = ψ.toDirichletCharacter⁻¹ :=
  map_inv RayClassCharacter.toDirichletCharacter ψ.character

@[simp]
theorem ofDirichletCharacter_primitiveCharacter {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N)
    [NeZero χ.conductor] :
    ofDirichletCharacter χ.primitiveCharacter = ofDirichletCharacter χ := by
  rw [← ofDirichletCharacter_changeLevel χ.conductor_dvd_level χ.primitiveCharacter,
    changeLevel_primitiveCharacter]

@[simp]
theorem ofDirichletCharacter_one (N : ℕ) [NeZero N] :
    ofDirichletCharacter (1 : DirichletCharacter ℂ N) = 1 := by
  rw [ofDirichletCharacter_def, map_one, of_one]

@[simp]
theorem ofDirichletCharacter_eq_one_iff {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) :
    ofDirichletCharacter χ = 1 ↔ χ = 1 := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ ofDirichletCharacter_one N⟩
  have hc : χ.conductor = 1 := by
    have := congrArg (fun ψ : PrimitiveRayClassCharacter ℚ ↦ Ideal.absNorm ψ.conductor.finitePart) h
    simpa [absNorm_conductor_ofDirichletCharacter] using this
  exact eq_one_iff_conductor_eq_one.mpr hc

@[simp]
theorem ofDirichletCharacter_inv {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) :
    ofDirichletCharacter χ⁻¹ = (ofDirichletCharacter χ)⁻¹ := by
  rw [ofDirichletCharacter_def, map_inv, of_inv, ← ofDirichletCharacter_def]

/-- Along `Ideal.absNorm (ofDirichletCharacter χ).conductor.finitePart = χ.conductor`,
`(ofDirichletCharacter χ).toDirichletCharacter` is `χ.primitiveCharacter`. -/
theorem changeLevel_toDirichletCharacter_ofDirichletCharacter {N : ℕ} [NeZero N]
    (χ : DirichletCharacter ℂ N) :
    changeLevel (dvd_of_eq (absNorm_conductor_ofDirichletCharacter χ))
      (ofDirichletCharacter χ).toDirichletCharacter = χ.primitiveCharacter := by
  apply changeLevel_injective χ.conductor_dvd_level
  rw [← changeLevel_trans, changeLevel_primitiveCharacter]
  let η₀ := (ratDirichletEquiv N (NeZero.ne N)).symm χ
  have hdvd : Ideal.absNorm (ofDirichletCharacter χ).conductor.finitePart ∣
      Ideal.absNorm (ratModulus N (NeZero.ne N)).finitePart :=
    map_dvd Ideal.absNorm (Modulus.dvd_iff.mp (conductor_of_dvd η₀)).1
  have h1 : changeLevel hdvd (ofDirichletCharacter χ).toDirichletCharacter =
      η₀.toDirichletCharacter :=
    (RayClassCharacter.toDirichletCharacter_induced (conductor_of_dvd η₀)
      (of η₀).character).symm.trans
      (congrArg RayClassCharacter.toDirichletCharacter (induced_character_of η₀))
  rw [changeLevel_trans _ hdvd (dvd_of_eq (absNorm_ratModulus_finitePart N (NeZero.ne N))), h1,
    RayClassCharacter.changeLevel_toDirichletCharacter_ratModulus, MulEquiv.apply_symm_apply]

/-- When `χ` is primitive of level `N`, `(ofDirichletCharacter χ).toDirichletCharacter` agrees with
`χ` along `Ideal.absNorm (ofDirichletCharacter χ).conductor.finitePart = N`. -/
theorem changeLevel_toDirichletCharacter_ofDirichletCharacter_of_isPrimitive {N : ℕ} [NeZero N]
    {χ : DirichletCharacter ℂ N} (hχ : χ.IsPrimitive) :
    changeLevel (dvd_of_eq ((absNorm_conductor_ofDirichletCharacter χ).trans
        ((isPrimitive_def χ).mp hχ)))
      (ofDirichletCharacter χ).toDirichletCharacter = χ := by
  rw [changeLevel_trans _
      (dvd_of_eq (absNorm_conductor_ofDirichletCharacter χ))
      (dvd_of_eq ((isPrimitive_def χ).mp hχ)),
    changeLevel_toDirichletCharacter_ofDirichletCharacter, changeLevel_primitiveCharacter]

@[simp]
theorem toDirichletCharacter_ofDirichletCharacter_intCast {N : ℕ} [NeZero N]
    (χ : DirichletCharacter ℂ N) (m : ℤ) :
    (ofDirichletCharacter χ).toDirichletCharacter m = χ.primitiveCharacter m := by
  have h := primitiveCharacter_changeLevel_apply
    (dvd_of_eq (absNorm_ratModulus_finitePart N (NeZero.ne N)))
    ((ratDirichletEquiv N (NeZero.ne N)).symm χ).toDirichletCharacter m
  rw [RayClassCharacter.changeLevel_toDirichletCharacter_ratModulus,
    MulEquiv.apply_symm_apply] at h
  rw [ofDirichletCharacter_def, toDirichletCharacter_of_intCast, ← h]

@[simp]
theorem toDirichletCharacter_ofDirichletCharacter_natCast {N : ℕ} [NeZero N]
    (χ : DirichletCharacter ℂ N) (m : ℕ) :
    (ofDirichletCharacter χ).toDirichletCharacter m = χ.primitiveCharacter m := by
  simpa only [Int.cast_natCast] using toDirichletCharacter_ofDirichletCharacter_intCast χ (m : ℤ)

theorem toDirichletCharacter_ofDirichletCharacter_intCast_of_isPrimitive {N : ℕ} [NeZero N]
    {χ : DirichletCharacter ℂ N} (hχ : χ.IsPrimitive) (m : ℤ) :
    (ofDirichletCharacter χ).toDirichletCharacter m = χ m := by
  rw [toDirichletCharacter_ofDirichletCharacter_intCast]
  exact apply_intCast_eq_of_forall_isCoprime ((isPrimitive_def χ).mp hχ)
    (fun _ ha ↦ primitiveCharacter_apply_of_isCoprime χ ((isPrimitive_def χ).mp hχ ▸ ha)) m

theorem toDirichletCharacter_ofDirichletCharacter_natCast_of_isPrimitive {N : ℕ} [NeZero N]
    {χ : DirichletCharacter ℂ N} (hχ : χ.IsPrimitive) (m : ℕ) :
    (ofDirichletCharacter χ).toDirichletCharacter m = χ m := by
  simpa only [Int.cast_natCast] using
    toDirichletCharacter_ofDirichletCharacter_intCast_of_isPrimitive hχ (m : ℤ)

/-- **Equivalence between bundled primitive ray class characters of `ℚ` and primitive complex
Dirichlet characters bundled with their positive integer conductor.** Even primitive Dirichlet
characters correspond to finite moduli `(N)` without the real place; odd primitive Dirichlet
characters correspond to moduli `(N)·∞` including the real place. -/
def ratEquiv :
    PrimitiveRayClassCharacter ℚ ≃ (N : ℕ+) × {χ : DirichletCharacter ℂ N // χ.IsPrimitive} where
  toFun ψ :=
    ⟨⟨Ideal.absNorm ψ.conductor.finitePart, Nat.pos_of_ne_zero (NeZero.ne _)⟩,
      ⟨ψ.toDirichletCharacter, ψ.isPrimitive_toDirichletCharacter⟩⟩
  invFun p := ofDirichletCharacter p.snd.val
  left_inv ψ := ofDirichletCharacter_primitive_toDirichletCharacter ψ
  right_inv := by
    rintro ⟨N, ⟨χ, hχ⟩⟩
    have hlevel : Ideal.absNorm (ofDirichletCharacter χ).conductor.finitePart = N :=
      (absNorm_conductor_ofDirichletCharacter χ).trans ((isPrimitive_def χ).mp hχ)
    suffices ∀ (M : ℕ+) (ψ : DirichletCharacter ℂ M) (hψ : ψ.IsPrimitive) (hM : M = N),
        changeLevel (dvd_of_eq (congrArg PNat.val hM)) ψ = χ →
        (⟨M, ⟨ψ, hψ⟩⟩ : (K : ℕ+) × {η : DirichletCharacter ℂ K // η.IsPrimitive}) =
          ⟨N, ⟨χ, hχ⟩⟩ from
      this _ _ _ (PNat.eq hlevel)
        (changeLevel_toDirichletCharacter_ofDirichletCharacter_of_isPrimitive hχ)
    rintro M ψ hψ rfl h
    simpa only [Subtype.mk.injEq, Sigma.mk.inj_iff, heq_eq_eq, true_and, changeLevel_self] using h

theorem ratEquiv_apply (ψ : PrimitiveRayClassCharacter ℚ) :
    ratEquiv ψ =
      ⟨⟨Ideal.absNorm ψ.conductor.finitePart, Nat.pos_of_ne_zero (NeZero.ne _)⟩,
        ⟨ψ.toDirichletCharacter, ψ.isPrimitive_toDirichletCharacter⟩⟩ := (rfl)

@[simp]
theorem ratEquiv_fst_coe (ψ : PrimitiveRayClassCharacter ℚ) :
    ((ratEquiv ψ).fst : ℕ) = Ideal.absNorm ψ.conductor.finitePart := (rfl)

@[simp]
theorem ratEquiv_snd_intCast (ψ : PrimitiveRayClassCharacter ℚ) (m : ℤ) :
    (ratEquiv ψ).snd.val m = ψ.toDirichletCharacter m := (rfl)

@[simp]
theorem ratEquiv_snd_natCast (ψ : PrimitiveRayClassCharacter ℚ) (m : ℕ) :
    (ratEquiv ψ).snd.val m = ψ.toDirichletCharacter m := (rfl)

@[simp]
theorem ratEquiv_symm_apply (p : (N : ℕ+) × {χ : DirichletCharacter ℂ N // χ.IsPrimitive}) :
    ratEquiv.symm p = ofDirichletCharacter p.snd.val := (rfl)

@[simp]
theorem ratEquiv_one : ratEquiv 1 = ⟨1, ⟨1, isPrimitive_one_level_one⟩⟩ := by
  apply ratEquiv.symm.injective
  rw [Equiv.symm_apply_apply, ratEquiv_symm_apply, ofDirichletCharacter_one]

@[simp]
theorem ratEquiv_inv (ψ : PrimitiveRayClassCharacter ℚ) :
    ratEquiv ψ⁻¹ = ⟨(ratEquiv ψ).fst, ⟨(ratEquiv ψ).snd.val⁻¹, (ratEquiv ψ).snd.property.inv⟩⟩ := by
  apply ratEquiv.symm.injective
  rw [Equiv.symm_apply_apply, ratEquiv_symm_apply, ofDirichletCharacter_inv,
    ← ratEquiv_symm_apply, Equiv.symm_apply_apply]

/-- Over `ℚ`, the deleted Euler correction from the primitive character `of η` to `𝔪` is the
product over primes dividing `Ideal.absNorm 𝔪.finitePart` and not dividing the Dirichlet conductor
of `η`. -/
theorem eulerCorrection_character_of {𝔪 : Modulus ℚ} (η : RayClassCharacter 𝔪) (s : ℂ) :
    (of η).character.eulerCorrection 𝔪 s =
      ∏ p ∈ (Ideal.absNorm 𝔪.finitePart).primeFactors \
          η.toDirichletCharacter.conductor.primeFactors,
        (1 - η.toDirichletCharacter.primitiveCharacter p * (p : ℂ) ^ (-s)) := by
  rw [RayClassCharacter.eulerCorrection_eq_prod_sdiff_primeFactors]
  refine Finset.prod_congr ?_ fun p _ ↦ by
    rw [← toDirichletCharacter_def, toDirichletCharacter_of_natCast]
  rw [conductor_of, ← RayClassCharacter.conductor_toDirichletCharacter]

/-- For `χ : DirichletCharacter ℂ N`, the deleted Euler correction from `ofDirichletCharacter χ`
to `(N)·∞` is the product of `1 - χ.primitiveCharacter p * p ^ (-s)` over
`p ∈ N.primeFactors \ χ.conductor.primeFactors`. -/
theorem eulerCorrection_ofDirichletCharacter {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N)
    (s : ℂ) :
    (ofDirichletCharacter χ).character.eulerCorrection (ratModulus N (NeZero.ne N)) s =
      ∏ p ∈ N.primeFactors \ χ.conductor.primeFactors,
        (1 - χ.primitiveCharacter p * (p : ℂ) ^ (-s)) := by
  rw [RayClassCharacter.eulerCorrection_eq_prod_sdiff_primeFactors]
  refine Finset.prod_congr ?_ fun p _ ↦ by
    rw [← toDirichletCharacter_def, toDirichletCharacter_ofDirichletCharacter_natCast]
  rw [absNorm_ratModulus_finitePart, absNorm_conductor_ofDirichletCharacter]

end PrimitiveRayClassCharacter

/-! ### Presented Hecke L-functions over `ℚ` and `DirichletCharacter.LFunction` -/

section HeckeLFunction

variable {𝔪 : Modulus ℚ}

/-- **Over `ℚ`, the presented Hecke L-function of `η` is the meromorphic normal form of
`η.toDirichletCharacter.LFunction`.** -/
theorem heckeLFunctionC_eq_toMeromorphicNFOn_LFunction (η : RayClassCharacter 𝔪) :
    heckeLFunctionC η = toMeromorphicNFOn η.toDirichletCharacter.LFunction univ := by
  rw [heckeLFunctionC_def]
  exact meromorphicContinuation_eq_toMeromorphicNFOn
    η.toDirichletCharacter.meromorphic_LFunction
    (fun _ hs ↦ η.toDirichletCharacter.analyticAt_LFunction
      (.inl (by rintro rfl; simp at hs)))
    fun s hs ↦ (η.toDirichletCharacter.LFunction_eq_LSeries hs).trans
      (η.LSeries_toUnitaryIdealWeight_eq s).symm

/-- **At every complex point `s`, `heckeLFunctionC η` has the same punctured germ as
`η.toDirichletCharacter.LFunction`.** -/
theorem heckeLFunctionC_eventuallyEq_LFunction (η : RayClassCharacter 𝔪) (s : ℂ) :
    heckeLFunctionC η =ᶠ[𝓝[≠] s] η.toDirichletCharacter.LFunction := by
  rw [heckeLFunctionC_eq_toMeromorphicNFOn_LFunction]
  exact η.toDirichletCharacter.meromorphic_LFunction.meromorphicOn
    |>.toMeromorphicNFOn_eq_self_on_nhdsNE (mem_univ s)

/-- **Away from the pole at `1` of the trivial character, `heckeLFunctionC η` agrees pointwise with
`η.toDirichletCharacter.LFunction`.** -/
theorem heckeLFunctionC_eq_LFunction (η : RayClassCharacter 𝔪) {s : ℂ} (hs : s ≠ 1 ∨ η ≠ 1) :
    heckeLFunctionC η s = η.toDirichletCharacter.LFunction s := by
  have hs' : s ≠ 1 ∨ η.toDirichletCharacter ≠ 1 :=
    hs.imp_right (mt (RayClassCharacter.toDirichletCharacter_eq_one_iff η).mp)
  rw [heckeLFunctionC_eq_toMeromorphicNFOn_LFunction,
    toMeromorphicNFOn_apply_of_analyticAt η.toDirichletCharacter.meromorphic_LFunction
      (η.toDirichletCharacter.analyticAt_LFunction hs')]

/-- **For every nontrivial rational ray class character `η ≠ 1`, `heckeLFunctionC η` equals
`η.toDirichletCharacter.LFunction` on the entire complex plane.** -/
theorem heckeLFunctionC_eq_LFunction_of_ne_one {η : RayClassCharacter 𝔪} (hη : η ≠ 1) :
    heckeLFunctionC η = η.toDirichletCharacter.LFunction := by
  ext s
  exact heckeLFunctionC_eq_LFunction η (.inr hη)

/-- On `Re s > 1`, a rational presented Hecke L-function agrees with its defining `LSeries`,
proving unconditionally over `ℚ` that the canonical continuation exists. -/
theorem heckeLFunctionC_rat_eq_LSeries (η : RayClassCharacter 𝔪) {s : ℂ} (hs : 1 < s.re) :
    heckeLFunctionC η s =
      LSeries (normCoeff ℚ η.toUnitaryIdealWeight.toIdealArithmeticFunction) s := by
  rw [heckeLFunctionC_eq_LFunction η (.inl fun h ↦ by simp [h] at hs),
    η.toDirichletCharacter.LFunction_eq_LSeries hs, η.LSeries_toUnitaryIdealWeight_eq]

/-- Away from `s = 1`, the presented Hecke L-function of the trivial character of `𝔪 : Modulus ℚ`
is `riemannZeta s` times the Euler factors at the prime factors of `Ideal.absNorm 𝔪.finitePart`. -/
theorem heckeLFunctionC_one_rat_eq_mul_riemannZeta (𝔪 : Modulus ℚ) {s : ℂ} (hs : s ≠ 1) :
    heckeLFunctionC (1 : RayClassCharacter 𝔪) s =
      (∏ p ∈ (Ideal.absNorm 𝔪.finitePart).primeFactors, (1 - (p : ℂ) ^ (-s))) *
        riemannZeta s := by
  rw [heckeLFunctionC_eq_LFunction 1 (.inl hs), map_one]
  exact LFunctionTrivChar_eq_mul_riemannZeta hs

private theorem LFunction_eq_of_changeLevel_eq {M N : ℕ} [NeZero M] [NeZero N]
    {ψ : DirichletCharacter ℂ M} {χ : DirichletCharacter ℂ N}
    (hMN : M = N) (h : changeLevel (dvd_of_eq hMN) ψ = χ) :
    ψ.LFunction = χ.LFunction := by
  subst hMN
  rw [changeLevel_self] at h
  subst h
  congr 1

private theorem LFunction_toDirichletCharacter_ratDirichletEquiv_symm {N : ℕ} [NeZero N]
    (χ : DirichletCharacter ℂ N) :
    ((ratDirichletEquiv N (NeZero.ne N)).symm χ).toDirichletCharacter.LFunction = χ.LFunction :=
  LFunction_eq_of_changeLevel_eq (absNorm_ratModulus_finitePart N (NeZero.ne N))
    (by rw [RayClassCharacter.changeLevel_toDirichletCharacter_ratModulus,
      MulEquiv.apply_symm_apply])

private theorem LFunction_toDirichletCharacter_ofDirichletCharacter_of_isPrimitive {N : ℕ}
    [NeZero N] {χ : DirichletCharacter ℂ N} (hχ : χ.IsPrimitive) :
    (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character.toDirichletCharacter.LFunction =
      χ.LFunction :=
  LFunction_eq_of_changeLevel_eq
    ((PrimitiveRayClassCharacter.absNorm_conductor_ofDirichletCharacter χ).trans
      ((isPrimitive_def χ).mp hχ))
    (PrimitiveRayClassCharacter.changeLevel_toDirichletCharacter_ofDirichletCharacter_of_isPrimitive
      hχ)

/-- At `(N)·∞`, `heckeLFunctionC ((ratDirichletEquiv N _).symm χ)` is the meromorphic normal form of
`χ.LFunction`. -/
theorem heckeLFunctionC_ratDirichletEquiv_symm_eq_toMeromorphicNFOn {N : ℕ} [NeZero N]
    (χ : DirichletCharacter ℂ N) :
    heckeLFunctionC ((ratDirichletEquiv N (NeZero.ne N)).symm χ) =
      toMeromorphicNFOn χ.LFunction univ := by
  rw [heckeLFunctionC_eq_toMeromorphicNFOn_LFunction,
    LFunction_toDirichletCharacter_ratDirichletEquiv_symm]

/-- At `(N)·∞`, `heckeLFunctionC ((ratDirichletEquiv N _).symm χ)` has the same punctured germ as
`χ.LFunction` at every `s : ℂ`. -/
theorem heckeLFunctionC_ratDirichletEquiv_symm_eventuallyEq {N : ℕ} [NeZero N]
    (χ : DirichletCharacter ℂ N) (s : ℂ) :
    heckeLFunctionC ((ratDirichletEquiv N (NeZero.ne N)).symm χ) =ᶠ[𝓝[≠] s] χ.LFunction := by
  simpa only [LFunction_toDirichletCharacter_ratDirichletEquiv_symm] using
    heckeLFunctionC_eventuallyEq_LFunction ((ratDirichletEquiv N (NeZero.ne N)).symm χ) s

/-- Away from the pole at `1` of the trivial character, the Hecke L-function of
`(ratDirichletEquiv N _).symm χ` agrees pointwise with `χ.LFunction`. -/
theorem heckeLFunctionC_ratDirichletEquiv_symm {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N)
    {s : ℂ} (hs : s ≠ 1 ∨ χ ≠ 1) :
    heckeLFunctionC ((ratDirichletEquiv N (NeZero.ne N)).symm χ) s = χ.LFunction s := by
  rw [heckeLFunctionC_eq_LFunction _
      (hs.imp_right (mt (map_eq_one_iff _ (MulEquiv.injective _)).mp)),
    LFunction_toDirichletCharacter_ratDirichletEquiv_symm]

/-- For `χ ≠ 1`, `heckeLFunctionC ((ratDirichletEquiv N _).symm χ) = χ.LFunction` on `ℂ`. -/
theorem heckeLFunctionC_ratDirichletEquiv_symm_of_ne_one {N : ℕ} [NeZero N]
    {χ : DirichletCharacter ℂ N} (hχ : χ ≠ 1) :
    heckeLFunctionC ((ratDirichletEquiv N (NeZero.ne N)).symm χ) = χ.LFunction := by
  simpa only [LFunction_toDirichletCharacter_ratDirichletEquiv_symm] using
    heckeLFunctionC_eq_LFunction_of_ne_one
      ((map_ne_one_iff (ratDirichletEquiv N (NeZero.ne N)).symm (MulEquiv.injective _)).mpr hχ)

/-- For a primitive Dirichlet character `χ`, the Hecke L-function of `ofDirichletCharacter χ` is
the meromorphic normal form of `χ.LFunction`. -/
theorem heckeLFunctionC_ofDirichletCharacter_eq_toMeromorphicNFOn_of_isPrimitive {N : ℕ} [NeZero N]
    {χ : DirichletCharacter ℂ N} (hχ : χ.IsPrimitive) :
    heckeLFunctionC (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character =
      toMeromorphicNFOn χ.LFunction univ := by
  rw [heckeLFunctionC_eq_toMeromorphicNFOn_LFunction,
    LFunction_toDirichletCharacter_ofDirichletCharacter_of_isPrimitive hχ]

/-- For a primitive Dirichlet character `χ`, `heckeLFunctionC (ofDirichletCharacter χ).character`
has the same punctured germ as `χ.LFunction` at every `s : ℂ`. -/
theorem heckeLFunctionC_ofDirichletCharacter_eventuallyEq_of_isPrimitive {N : ℕ} [NeZero N]
    {χ : DirichletCharacter ℂ N} (hχ : χ.IsPrimitive) (s : ℂ) :
    heckeLFunctionC (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character =ᶠ[𝓝[≠] s]
      χ.LFunction := by
  simpa only [LFunction_toDirichletCharacter_ofDirichletCharacter_of_isPrimitive hχ] using
    heckeLFunctionC_eventuallyEq_LFunction
      (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character s

/-- For a primitive Dirichlet character `χ`, `heckeLFunctionC (ofDirichletCharacter χ).character s`
equals `χ.LFunction s` whenever `s ≠ 1 ∨ χ ≠ 1`. -/
theorem heckeLFunctionC_ofDirichletCharacter_of_isPrimitive {N : ℕ} [NeZero N]
    {χ : DirichletCharacter ℂ N} (hχ : χ.IsPrimitive) {s : ℂ} (hs : s ≠ 1 ∨ χ ≠ 1) :
    heckeLFunctionC (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character s =
      χ.LFunction s := by
  have hne : χ ≠ 1 → (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character ≠ 1 :=
    mt fun h ↦ (PrimitiveRayClassCharacter.ofDirichletCharacter_eq_one_iff χ).mp <| by
      rw [← PrimitiveRayClassCharacter.of_character
        (PrimitiveRayClassCharacter.ofDirichletCharacter χ), h, PrimitiveRayClassCharacter.of_one]
  rw [heckeLFunctionC_eq_LFunction _ (hs.imp_right hne),
    LFunction_toDirichletCharacter_ofDirichletCharacter_of_isPrimitive hχ]

/-- For a nonprincipal primitive Dirichlet character `χ`, the Hecke L-function of
`ofDirichletCharacter χ` equals `χ.LFunction` on the entire complex plane. -/
theorem heckeLFunctionC_ofDirichletCharacter_of_isPrimitive_of_ne_one {N : ℕ} [NeZero N]
    {χ : DirichletCharacter ℂ N} (hχ : χ.IsPrimitive) (hne : χ ≠ 1) :
    heckeLFunctionC (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character =
      χ.LFunction := by
  ext s
  exact heckeLFunctionC_ofDirichletCharacter_of_isPrimitive hχ (.inr hne)

end HeckeLFunction

/-! ### Meromorphic order, divisor, and zero-count transport -/

section ZeroCounting

variable {𝔪 : Modulus ℚ}

@[simp]
theorem meromorphicOrderAt_heckeLFunctionC_eq_LFunction (η : RayClassCharacter 𝔪) (s : ℂ) :
    meromorphicOrderAt (heckeLFunctionC η) s =
      meromorphicOrderAt η.toDirichletCharacter.LFunction s :=
  meromorphicOrderAt_congr (heckeLFunctionC_eventuallyEq_LFunction η s)

@[simp]
theorem divisor_heckeLFunctionC_eq_LFunction (η : RayClassCharacter 𝔪) (U : Set ℂ) :
    MeromorphicOn.divisor (heckeLFunctionC η) U =
      MeromorphicOn.divisor η.toDirichletCharacter.LFunction U :=
  MeromorphicOn.divisor_congr_nhdsNE fun z _ ↦ heckeLFunctionC_eventuallyEq_LFunction η z

@[simp]
theorem divisorCount_heckeLFunctionC_eq_LFunction (η : RayClassCharacter 𝔪) (U R : Set ℂ) :
    divisorCount (heckeLFunctionC η) U R =
      divisorCount η.toDirichletCharacter.LFunction U R :=
  divisorCount_congr_nhdsNE fun z _ ↦ heckeLFunctionC_eventuallyEq_LFunction η z

@[simp]
theorem zeroCount_heckeLFunctionC_eq_LFunction (η : RayClassCharacter 𝔪) (U R : Set ℂ) :
    zeroCount (heckeLFunctionC η) U R =
      zeroCount η.toDirichletCharacter.LFunction U R :=
  zeroCount_congr_nhdsNE fun z _ ↦ heckeLFunctionC_eventuallyEq_LFunction η z

theorem meromorphicOrderAt_heckeLFunctionC_ratDirichletEquiv_symm {N : ℕ} [NeZero N]
    (χ : DirichletCharacter ℂ N) (s : ℂ) :
    meromorphicOrderAt (heckeLFunctionC ((ratDirichletEquiv N (NeZero.ne N)).symm χ)) s =
      meromorphicOrderAt χ.LFunction s := by
  simpa only [LFunction_toDirichletCharacter_ratDirichletEquiv_symm] using
    meromorphicOrderAt_heckeLFunctionC_eq_LFunction ((ratDirichletEquiv N (NeZero.ne N)).symm χ) s

theorem divisor_heckeLFunctionC_ratDirichletEquiv_symm {N : ℕ} [NeZero N]
    (χ : DirichletCharacter ℂ N) (U : Set ℂ) :
    MeromorphicOn.divisor (heckeLFunctionC ((ratDirichletEquiv N (NeZero.ne N)).symm χ)) U =
      MeromorphicOn.divisor χ.LFunction U := by
  simpa only [LFunction_toDirichletCharacter_ratDirichletEquiv_symm] using
    divisor_heckeLFunctionC_eq_LFunction ((ratDirichletEquiv N (NeZero.ne N)).symm χ) U

theorem zeroCount_heckeLFunctionC_ratDirichletEquiv_symm {N : ℕ} [NeZero N]
    (χ : DirichletCharacter ℂ N) (U R : Set ℂ) :
    zeroCount (heckeLFunctionC ((ratDirichletEquiv N (NeZero.ne N)).symm χ)) U R =
      zeroCount χ.LFunction U R := by
  simpa only [LFunction_toDirichletCharacter_ratDirichletEquiv_symm] using
    zeroCount_heckeLFunctionC_eq_LFunction ((ratDirichletEquiv N (NeZero.ne N)).symm χ) U R

theorem meromorphicOrderAt_heckeLFunctionC_ofDirichletCharacter_of_isPrimitive {N : ℕ} [NeZero N]
    {χ : DirichletCharacter ℂ N} (hχ : χ.IsPrimitive) (s : ℂ) :
    meromorphicOrderAt
        (heckeLFunctionC (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character) s =
      meromorphicOrderAt χ.LFunction s := by
  simpa only [LFunction_toDirichletCharacter_ofDirichletCharacter_of_isPrimitive hχ] using
    meromorphicOrderAt_heckeLFunctionC_eq_LFunction
      (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character s

theorem divisor_heckeLFunctionC_ofDirichletCharacter_of_isPrimitive {N : ℕ} [NeZero N]
    {χ : DirichletCharacter ℂ N} (hχ : χ.IsPrimitive) (U : Set ℂ) :
    MeromorphicOn.divisor
        (heckeLFunctionC (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character) U =
      MeromorphicOn.divisor χ.LFunction U := by
  simpa only [LFunction_toDirichletCharacter_ofDirichletCharacter_of_isPrimitive hχ] using
    divisor_heckeLFunctionC_eq_LFunction
      (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character U

theorem zeroCount_heckeLFunctionC_ofDirichletCharacter_of_isPrimitive {N : ℕ} [NeZero N]
    {χ : DirichletCharacter ℂ N} (hχ : χ.IsPrimitive) (U R : Set ℂ) :
    zeroCount (heckeLFunctionC (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character) U R =
      zeroCount χ.LFunction U R := by
  simpa only [LFunction_toDirichletCharacter_ofDirichletCharacter_of_isPrimitive hχ] using
    zeroCount_heckeLFunctionC_eq_LFunction
      (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character U R

/-- **For every primitive ray class character `ψ` of `ℚ` (including `ψ = 1`), the zero count of
its entire Dirichlet completion on any region `R` equals the zero count of
`heckeLFunctionC ψ.character` on the part of `R` in the open critical strip.** -/
theorem zeroCount_dirichletData_entireCompletion_eq_heckeLFunctionC_inter
    (ψ : PrimitiveRayClassCharacter ℚ) (R : Set ℂ) :
    zeroCount
        (dirichletData ψ.toDirichletCharacter ψ.isPrimitive_toDirichletCharacter).entireCompletion
        univ R =
      zeroCount (heckeLFunctionC ψ.character) univ (R ∩ {s | s.re ∈ Ioo 0 1}) := by
  rw [zeroCount_dirichletData_entireCompletion_eq_LFunction_inter
      ψ.toDirichletCharacter ψ.isPrimitive_toDirichletCharacter R,
    PrimitiveRayClassCharacter.toDirichletCharacter_def, ← zeroCount_heckeLFunctionC_eq_LFunction]

/-- **For every primitive Dirichlet character `χ` (including the principal character mod `1`), the
zero count of `(dirichletData χ hχ).entireCompletion` on `R` equals the zero count of the Hecke
L-function of `ofDirichletCharacter χ` on `R ∩ {0 < Re s < 1}`.** -/
theorem zeroCount_dirichletData_entireCompletion_eq_heckeLFunctionC_ofDirichletCharacter_inter
    {N : ℕ} [NeZero N] {χ : DirichletCharacter ℂ N} (hχ : χ.IsPrimitive) (R : Set ℂ) :
    zeroCount (dirichletData χ hχ).entireCompletion univ R =
      zeroCount (heckeLFunctionC (PrimitiveRayClassCharacter.ofDirichletCharacter χ).character)
        univ (R ∩ {s | s.re ∈ Ioo 0 1}) := by
  rw [zeroCount_dirichletData_entireCompletion_eq_LFunction_inter χ hχ R,
    ← zeroCount_heckeLFunctionC_ofDirichletCharacter_of_isPrimitive hχ]

/-- **For the trivial primitive ray class character `1 : PrimitiveRayClassCharacter ℚ`, the zero
count of `zetaEntireCompletion` on `R` equals the zero count of `heckeLFunctionC (1).character` on
`R ∩ {0 < Re s < 1}`.** -/
theorem zeroCount_zetaEntireCompletion_eq_heckeLFunctionC_one_inter (R : Set ℂ) :
    zeroCount zetaEntireCompletion univ R =
      zeroCount (heckeLFunctionC (1 : PrimitiveRayClassCharacter ℚ).character)
        univ (R ∩ {s | s.re ∈ Ioo 0 1}) := by
  rw [PrimitiveRayClassCharacter.character_one, heckeLFunctionC_one_modulus_one,
    zeroCount_zetaEntireCompletion_eq_dedekindZetaC_rat_inter]

end ZeroCounting

end LFunctions

end TauCeti

