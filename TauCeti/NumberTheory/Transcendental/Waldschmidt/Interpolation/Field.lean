module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.NumberTheory.NumberField.Basic
public import TauCeti.NumberTheory.Transcendental.AlgebraicLogs
import TauCeti.FieldTheory.IntermediateField.Adjoin.Finrank

/-!
# The number field of Waldschmidt's linear forms estimate

Waldschmidt's lower bound for linear forms in logarithms concerns a linear form
`c₀ + c₁ λ₁ + ⋯ + cₘ λₘ` in logarithms `λⱼ ∈ 𝓛` of algebraic numbers `αⱼ = exp λⱼ`, with
algebraic coefficients `cᵢ`. All the algebraic data of the proof lie in the field

`K = ℚ(α₁, …, αₘ, c₀, c₁, …, cₘ) ⊆ ℂ`,

whose degree `D = [K : ℚ]` enters the bound. This file defines `K` and shows that it is a number
field. The interpolation data of the proof are then elements of `K`: the `αⱼ`, the normalized
coefficients `βᵢ = -cᵢ / c_k` obtained by dividing by a nonzero coefficient `c_k`
(`TauCeti.waldschmidtNormalize_mem`), and the entries `γ` of the interpolation matrix built from
them (`TauCeti.waldschmidtEntry`, with the inclusion `K → ℂ` as complex embedding). Renumbering
the logarithms, as the normalization at `c_k` does, leaves `K` unchanged.

If the logarithms are fixed and every coefficient has degree at most `d`, then `D` is at most
`[ℚ(α₁, …, αₘ) : ℚ] d^(m+1)`. This makes the exponent of `D` in the measure uniform over such
coefficients, as needed to deduce Baker's theorem from it.

## Main definitions

* `TauCeti.waldschmidtField l c₀ c`: the field `ℚ(exp λ₁, …, exp λₘ, c₀, c₁, …, cₘ) ⊆ ℂ`.

## Main results

* `TauCeti.waldschmidtField_le_iff`: `K` is the smallest intermediate field containing the
  `exp λⱼ` and the `cᵢ`.
* `TauCeti.waldschmidtField_comp_perm`: renumbering the logarithms and their coefficients does not
  change `K`.
* `TauCeti.finiteDimensional_waldschmidtField_iff`, `TauCeti.numberField_waldschmidtField`: `K` is
  a number field exactly when the `λⱼ` lie in `𝓛` and the `cᵢ` are algebraic.
* `TauCeti.finrank_waldschmidtField_le`:
  `[K : ℚ] ≤ [ℚ(α₁, …, αₘ) : ℚ] deg c₀ deg c₁ ⋯ deg cₘ`.
* `TauCeti.finrank_waldschmidtField_le_mul_pow`: `[K : ℚ] ≤ [ℚ(α₁, …, αₘ) : ℚ] d^(m+1)` when every
  `cᵢ` has degree at most `d`.

## References

* M. Waldschmidt, *Diophantine Approximation on Linear Algebraic Groups*, Springer (2000),
  Theorem 9.1, §9.2.1.
-/

public section

open Complex Module IntermediateField

namespace TauCeti

variable {n : ℕ}

/-- The field `ℚ(α₁, …, αₘ, c₀, c₁, …, cₘ) ⊆ ℂ` of Waldschmidt's linear forms estimate, generated by
the exponentials `αⱼ = exp λⱼ` of the logarithms `l = (λ₁, …, λₘ)` and by the coefficients `c₀` and
`c = (c₁, …, cₘ)` of the linear form `c₀ + c₁ λ₁ + ⋯ + cₘ λₘ`. -/
noncomputable def waldschmidtField (l : Fin (n + 1) → ℂ) (c₀ : ℂ) (c : Fin (n + 1) → ℂ) :
    IntermediateField ℚ ℂ :=
  adjoin ℚ (Set.range (cexp ∘ l) ∪ insert c₀ (Set.range c))

variable {l : Fin (n + 1) → ℂ} {c₀ : ℂ} {c : Fin (n + 1) → ℂ}

/-- The defining formula of `waldschmidtField l c₀ c`. -/
theorem waldschmidtField_def (l : Fin (n + 1) → ℂ) (c₀ : ℂ) (c : Fin (n + 1) → ℂ) :
    waldschmidtField l c₀ c = adjoin ℚ (Set.range (cexp ∘ l) ∪ insert c₀ (Set.range c)) :=
  (rfl)

/-- The universal property of `waldschmidtField l c₀ c`: it is contained in an intermediate field
`E` exactly when `E` contains the exponentials `exp λⱼ` and the coefficients `cᵢ`. -/
theorem waldschmidtField_le_iff {E : IntermediateField ℚ ℂ} :
    waldschmidtField l c₀ c ≤ E ↔ (∀ j, cexp (l j) ∈ E) ∧ c₀ ∈ E ∧ ∀ j, c j ∈ E := by
  simp [waldschmidtField_def, adjoin_le_iff, Set.union_subset_iff, Set.insert_subset_iff,
    Set.range_subset_iff, and_left_comm]

/-- The exponential `αⱼ = exp λⱼ` lies in `waldschmidtField l c₀ c`. -/
@[simp]
theorem exp_mem_waldschmidtField (j : Fin (n + 1)) : cexp (l j) ∈ waldschmidtField l c₀ c :=
  (waldschmidtField_le_iff.1 le_rfl).1 j

/-- The constant coefficient `c₀` lies in `waldschmidtField l c₀ c`. -/
@[simp]
theorem const_mem_waldschmidtField : c₀ ∈ waldschmidtField l c₀ c :=
  (waldschmidtField_le_iff.1 le_rfl).2.1

/-- The coefficient `cⱼ` lies in `waldschmidtField l c₀ c`. -/
@[simp]
theorem coeff_mem_waldschmidtField (j : Fin (n + 1)) : c j ∈ waldschmidtField l c₀ c :=
  (waldschmidtField_le_iff.1 le_rfl).2.2 j

/-- Renumbering the logarithms together with their coefficients does not change
`waldschmidtField l c₀ c`. In particular the normalization at an arbitrary nonzero coefficient,
which exchanges it with the last one, keeps the field. -/
theorem waldschmidtField_comp_perm (l : Fin (n + 1) → ℂ) (c₀ : ℂ) (c : Fin (n + 1) → ℂ)
    (e : Equiv.Perm (Fin (n + 1))) :
    waldschmidtField (l ∘ e) c₀ (c ∘ e) = waldschmidtField l c₀ c := by
  rw [waldschmidtField_def, waldschmidtField_def, ← Function.comp_assoc, EquivLike.range_comp,
    EquivLike.range_comp]

/-- `waldschmidtField l c₀ c` is finite-dimensional over `ℚ` exactly when the `λⱼ` are logarithms of
algebraic numbers and the coefficients `cᵢ` are algebraic. -/
theorem finiteDimensional_waldschmidtField_iff :
    FiniteDimensional ℚ (waldschmidtField l c₀ c) ↔
      (∀ j, l j ∈ algebraicLogs) ∧ IsAlgebraic ℚ c₀ ∧ ∀ j, IsAlgebraic ℚ (c j) := by
  refine ⟨fun _ ↦ ?_, fun ⟨hl, hc₀, hc⟩ ↦ ?_⟩
  · -- Every element of a finite-dimensional intermediate field is algebraic.
    have halg {x : ℂ} (hx : x ∈ waldschmidtField l c₀ c) : IsAlgebraic ℚ x := by
      simpa using ((IsIntegral.of_finite ℚ (⟨x, hx⟩ : waldschmidtField l c₀ c)).map
        (waldschmidtField l c₀ c).val).isAlgebraic
    exact ⟨fun j ↦ mem_algebraicLogs.2 (halg (exp_mem_waldschmidtField j)),
      halg const_mem_waldschmidtField, fun j ↦ halg (coeff_mem_waldschmidtField j)⟩
  · rw [waldschmidtField_def]
    refine finiteDimensional_adjoin fun x hx ↦ ?_
    rcases hx with ⟨j, rfl⟩ | rfl | ⟨j, rfl⟩
    exacts [(mem_algebraicLogs.1 (hl j)).isIntegral, hc₀.isIntegral, (hc j).isIntegral]

/-- If the `λⱼ` are logarithms of algebraic numbers and the coefficients `cᵢ` are algebraic, then
`waldschmidtField l c₀ c` is a number field. -/
theorem numberField_waldschmidtField (hl : ∀ j, l j ∈ algebraicLogs) (hc₀ : IsAlgebraic ℚ c₀)
    (hc : ∀ j, IsAlgebraic ℚ (c j)) : NumberField (waldschmidtField l c₀ c) :=
  have := finiteDimensional_waldschmidtField_iff.2 ⟨hl, hc₀, hc⟩
  { }

/-- The degree of `waldschmidtField l c₀ c` is at most the degree of `ℚ(α₁, …, αₘ)` times the
degrees of the coefficients: `[K : ℚ] ≤ [ℚ(α₁, …, αₘ) : ℚ] deg c₀ deg c₁ ⋯ deg cₘ`. When some
generator is transcendental both sides are `0`. -/
theorem finrank_waldschmidtField_le (l : Fin (n + 1) → ℂ) (c₀ : ℂ) (c : Fin (n + 1) → ℂ) :
    finrank ℚ (waldschmidtField l c₀ c) ≤
      finrank ℚ (adjoin ℚ (Set.range (cexp ∘ l))) *
        ((minpoly ℚ c₀).natDegree * ∏ j, (minpoly ℚ (c j)).natDegree) := by
  rw [waldschmidtField_def, adjoin_union, ← Fin.range_cons]
  refine (finrank_sup_le _ _).trans (Nat.mul_le_mul_left _ ?_)
  simpa [Fin.prod_univ_succ] using
    finrank_adjoin_range_le_prod (K := ℚ) (Fin.cons c₀ c : Fin (n + 2) → ℂ)

/-- If every coefficient has degree at most `d`, then the degree of `waldschmidtField l c₀ c` is at
most `[ℚ(α₁, …, αₘ) : ℚ] d^(m+1)`, where `m = n + 1` is the number of logarithms. -/
theorem finrank_waldschmidtField_le_mul_pow {d : ℕ} (hc₀ : (minpoly ℚ c₀).natDegree ≤ d)
    (hc : ∀ j, (minpoly ℚ (c j)).natDegree ≤ d) :
    finrank ℚ (waldschmidtField l c₀ c) ≤
      finrank ℚ (adjoin ℚ (Set.range (cexp ∘ l))) * d ^ (n + 2) := by
  refine (finrank_waldschmidtField_le l c₀ c).trans (Nat.mul_le_mul_left _ ?_)
  calc (minpoly ℚ c₀).natDegree * ∏ j, (minpoly ℚ (c j)).natDegree
      ≤ d * ∏ _j : Fin (n + 1), d := Nat.mul_le_mul hc₀ (Finset.prod_le_prod fun j _ ↦ hc j)
    _ = d ^ (n + 2) := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]; ring

end TauCeti
