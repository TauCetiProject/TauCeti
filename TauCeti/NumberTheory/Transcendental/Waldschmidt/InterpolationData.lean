/-!
# The interpolation data of Waldschmidt's linear forms estimate

Let `λ₁, …, λₘ ∈ ℂ` with `αⱼ = exp λⱼ` algebraic and let `β₀, …, β_{m-1}` be algebraic. In
Waldschmidt's proof of his explicit lower bound for linear forms in logarithms, one nonzero
coefficient of the linear form is normalized to `-1`, so that it reads

`Λ = β₀ + β₁ λ₁ + ⋯ + β_{m-1} λ_{m-1} - λₘ`,

and one works in `ℂᵐ` with coordinates `z = (z₀, z₁, …, z_{m-1})`. The points
`yⱼ = eⱼ` (`1 ≤ j < m`) and `yₘ = (β₀, β₁, …, β_{m-1})` span the grid
`s · y = s₁ y₁ + ⋯ + sₘ yₘ`, `s ∈ ℤᵐ`, and the auxiliary functions are
`F(z) exp(t (z₀ + λ₁ z₁ + ⋯ + λ_{m-1} z_{m-1}))` with `F` a polynomial with algebraic coefficients
(the monomials `z^τ`, or the integer-valued delta polynomials) and `t ∈ ℤ`. On the grid the
exponential factor is

`exp(t ⟨λ, s · y⟩) = α₁^(t s₁) ⋯ αₘ^(t sₘ) exp(t sₘ Λ)`,

so the derivatives in `z₀` of the auxiliary functions at the grid points are algebraic numbers
`γ` times the small perturbation `exp(t sₘ Λ)` of `1`. The interpolation determinant of the
proof is built from these entries: the algebraic numbers `γ` are bounded arithmetically, while
the analytic expression is bounded through Schwarz's lemma when `|Λ|` is small.

Throughout, `m = n + 1`. The logarithms and exponents are indexed by `Fin (n + 1)`, with
`Fin.last n` the index of `λₘ`; the coordinates `z` and the coefficient vector
`b = (β₀, β₁, …, β_{m-1})` are indexed by `Fin (n + 1)`, with `0` the index of `z₀` and `β₀`, so
that `λ_{k+1} = l k.castSucc` multiplies `z_{k+1} = z k.succ`. The coefficient-field data live
in an arbitrary field `K` with a complex embedding `ι : K →+* ℂ`. In the application `K` is the
number field generated by the `αⱼ`, the `βᵢ` and the coefficients of `F`, and then the entries
`γ ∈ K` are algebraic numbers.

The arithmetic estimates of the proof are made in bases adapted to them rather than in the bases
`z^τ` and `∂^σ/∂z₀^σ`: integer-valued polynomials `∏ᵢ Δ_{τᵢ}(zᵢ)` in place of the monomials, and
differential operators `P_σ(∂/∂z₀)` (for instance divided derivatives) in place of the iterated
derivatives. For a polynomial `P` with coefficients in `K`, the operator `P(∂/∂z₀)` applied to the
auxiliary function at `s · y` is again `γ_P exp(t sₘ Λ)`, where by the Leibniz rule
`P(∂)(F e^{tz₀}) = e^{tz₀} P(∂ + t) F` the coefficient-field factor is

`γ_P = (∑ₖ P^{[k]}(t) (∂ᵏF/∂z₀ᵏ)(s · y)) α₁^(t s₁) ⋯ αₘ^(t sₘ)`,

with `P^{[k]}` the `k`-th Hasse derivative of `P`. The entry `γ_P` is bilinear in `F` and `P`,
so a change of basis on either side, between bases of the same span, leaves the spans of the
rows and columns of the interpolation matrix, hence its rank, unchanged.

## Main definitions

* `TauCeti.waldschmidtLinearForm l b`: the normalized linear form `Λ`.
* `TauCeti.waldschmidtNormalize c₀ c`: the coefficients after dividing a linear form
  `c₀ + c₁ λ₁ + ⋯ + cₘ λₘ` by `-cₘ`.
* `TauCeti.waldschmidtPoint b s`: the grid point `s · y`.
* `TauCeti.waldschmidtFunction l F t`: the auxiliary function
  `z ↦ F(z) exp(t (z₀ + λ₁ z₁ + ⋯ + λ_{m-1} z_{m-1}))`.
* `TauCeti.waldschmidtEntry α b F t σ s`: the coefficient-field factor `γ ∈ K` of the `σ`-th
  derivative in `z₀` of the auxiliary function at `s · y`.
* `TauCeti.waldschmidtOperatorEntry α b t s F P`: the coefficient-field factor `γ_P ∈ K` of the
  differential operator `P(∂/∂z₀)` applied to the auxiliary function at `s · y`, bilinear in
  `F` and `P`.

## Main results

* `TauCeti.add_sum_mul_eq_neg_mul_waldschmidtLinearForm`: a linear form with nonzero last
  coefficient `cₘ` is `-cₘ` times the normalized linear form.
* `TauCeti.iteratedDeriv_waldschmidtFunction`: the entry identity
  `∂^σ/∂z₀^σ (F(z) exp(t ⟨λ, z⟩))|_{z = s · y} = γ exp(t sₘ Λ)`.
* `TauCeti.waldschmidtOperatorEntry_eq_sum_hasseDeriv`: the Leibniz formula
  `γ_P = (∑ₖ P^{[k]}(t) (∂ᵏF/∂z₀ᵏ)(s · y)) α^(t s)`.
* `TauCeti.sum_mul_iteratedDeriv_waldschmidtFunction`: the entry identity for the operator
  `P(∂/∂z₀)`.
* `TauCeti.span_image_waldschmidtOperatorEntry_sequence`: on the derivative side, the columns for
  the operators `P₀(∂), …, P_{N-1}(∂)` of a polynomial sequence span the same space as those for
  `1, ∂, …, ∂^{N-1}`.
* `TauCeti.span_image_waldschmidtOperatorEntry_prod_sequence`: on the polynomial side, the rows
  for the products `∏ᵢ Δ_{τᵢ}(zᵢ)` of a polynomial sequence, `τ` of degree at most `T`, span the
  same space as those for the monomials `z^τ`.

## References

* M. Waldschmidt, *Diophantine Approximation on Linear Algebraic Groups*, Springer (2000),
  §9.2.1.
-/

public section

open Complex Finset Function MvPolynomial

namespace TauCeti

variable {n : ℕ}

/-- Waldschmidt's normalized linear form `Λ = β₀ + β₁ λ₁ + ⋯ + β_{m-1} λ_{m-1} - λₘ` in the
logarithms `l = (λ₁, …, λₘ)`, with coefficient vector `b = (β₀, β₁, …, β_{m-1})`. -/
def waldschmidtLinearForm (l b : Fin (n + 1) → ℂ) : ℂ :=
  b 0 + ∑ k : Fin n, b k.succ * l k.castSucc - l (Fin.last n)

/-- The defining formula of `waldschmidtLinearForm l b`. -/
theorem waldschmidtLinearForm_def (l b : Fin (n + 1) → ℂ) :
    waldschmidtLinearForm l b = b 0 + ∑ k : Fin n, b k.succ * l k.castSucc - l (Fin.last n) :=
  (rfl)

/-- The coefficient vector of the linear form `c₀ + c₁ λ₁ + ⋯ + cₘ λₘ` divided by `-cₘ`:
`(-c₀ / cₘ, -c₁ / cₘ, …, -c_{m-1} / cₘ)`. When `cₘ ≠ 0` the divided linear form is the
normalized linear form with these coefficients
(`TauCeti.add_sum_mul_eq_neg_mul_waldschmidtLinearForm`). -/
def waldschmidtNormalize {K : Type*} [Field K] (c₀ : K) (c : Fin (n + 1) → K) :
    Fin (n + 1) → K :=
  Fin.cons (-c₀ / c (Fin.last n)) fun k ↦ -c k.castSucc / c (Fin.last n)

@[simp]
theorem waldschmidtNormalize_zero {K : Type*} [Field K] (c₀ : K) (c : Fin (n + 1) → K) :
    waldschmidtNormalize c₀ c 0 = -c₀ / c (Fin.last n) :=
  (rfl)

@[simp]
theorem waldschmidtNormalize_succ {K : Type*} [Field K] (c₀ : K) (c : Fin (n + 1) → K)
    (k : Fin n) : waldschmidtNormalize c₀ c k.succ = -c k.castSucc / c (Fin.last n) :=
  (rfl)

/-- Normalization of a linear form in logarithms: if the last coefficient `cₘ` is nonzero, then
`c₀ + c₁ λ₁ + ⋯ + cₘ λₘ = -cₘ Λ`, where `Λ` is the normalized linear form whose coefficients
`waldschmidtNormalize c₀ c` lie in the field generated by the `cᵢ`. -/
theorem add_sum_mul_eq_neg_mul_waldschmidtLinearForm {K : Type*} [Field K] (ι : K →+* ℂ)
    (l : Fin (n + 1) → ℂ) (c₀ : K) (c : Fin (n + 1) → K) (hc : c (Fin.last n) ≠ 0) :
    ι c₀ + ∑ j, ι (c j) * l j =
      -ι (c (Fin.last n)) * waldschmidtLinearForm l fun i ↦ ι (waldschmidtNormalize c₀ c i) := by
  have hc' : ι (c (Fin.last n)) ≠ 0 := (map_ne_zero ι).mpr hc
  simp only [waldschmidtLinearForm_def, waldschmidtNormalize_zero, waldschmidtNormalize_succ,
    map_div₀, map_neg, Fin.sum_univ_castSucc, mul_sub, mul_add, mul_sum]
  have hsum : ∑ k : Fin n, -ι (c (Fin.last n)) * (-ι (c k.castSucc) / ι (c (Fin.last n)) *
      l k.castSucc) = ∑ k : Fin n, ι (c k.castSucc) * l k.castSucc :=
    sum_congr rfl fun k _ ↦ by field_simp
  rw [hsum]
  field_simp
  ring

/-- The grid point `s · y = s₁ y₁ + ⋯ + sₘ yₘ` of Waldschmidt's interpolation, where
`yⱼ = e_j` for `1 ≤ j < m` and `yₘ = b = (β₀, β₁, …, β_{m-1})`. Its `z₀`-coordinate is `sₘ β₀`
and its `z_{k+1}`-coordinate is `s_{k+1} + sₘ β_{k+1}`. -/
def waldschmidtPoint {R : Type*} [CommRing R] (b : Fin (n + 1) → R) (s : Fin (n + 1) → ℤ) :
    Fin (n + 1) → R :=
  Fin.cons (s (Fin.last n) * b 0) fun k ↦ s k.castSucc + s (Fin.last n) * b k.succ

section Point

variable {R : Type*} [CommRing R] (b : Fin (n + 1) → R)

@[simp]
theorem waldschmidtPoint_apply_zero (s : Fin (n + 1) → ℤ) :
    waldschmidtPoint b s 0 = s (Fin.last n) * b 0 :=
  (rfl)

@[simp]
theorem waldschmidtPoint_apply_succ (s : Fin (n + 1) → ℤ) (k : Fin n) :
    waldschmidtPoint b s k.succ = s k.castSucc + s (Fin.last n) * b k.succ :=
  (rfl)

/-- The grid point `s · y` depends additively on `s`. -/
theorem waldschmidtPoint_add (s s' : Fin (n + 1) → ℤ) :
    waldschmidtPoint b (s + s') = waldschmidtPoint b s + waldschmidtPoint b s' := by
  ext i
  cases i using Fin.cases <;> simp <;> ring

@[simp]
theorem waldschmidtPoint_zero : waldschmidtPoint b 0 = 0 := by
  ext i
  cases i using Fin.cases <;> simp

/-- The grid points are compatible with ring homomorphisms, such as a complex embedding of the
field containing the coefficients. -/
theorem waldschmidtPoint_map {S : Type*} [CommRing S] (f : R →+* S) (s : Fin (n + 1) → ℤ) :
    waldschmidtPoint (fun i ↦ f (b i)) s = fun i ↦ f (waldschmidtPoint b s i) := by
  ext i
  cases i using Fin.cases <;> simp

end Point

/-- Waldschmidt's auxiliary function `z ↦ F(z) exp(t (z₀ + λ₁ z₁ + ⋯ + λ_{m-1} z_{m-1}))` on
`ℂᵐ`, for a polynomial `F` and an integer `t`; here `l = (λ₁, …, λₘ)`, of which `λₘ` does not
occur. -/
noncomputable def waldschmidtFunction (l : Fin (n + 1) → ℂ) (F : MvPolynomial (Fin (n + 1)) ℂ)
    (t : ℤ) (z : Fin (n + 1) → ℂ) : ℂ :=
  eval z F * cexp (t * (z 0 + ∑ k : Fin n, l k.castSucc * z k.succ))

/-- The defining formula of `waldschmidtFunction l F t`. -/
theorem waldschmidtFunction_def (l : Fin (n + 1) → ℂ) (F : MvPolynomial (Fin (n + 1)) ℂ) (t : ℤ)
    (z : Fin (n + 1) → ℂ) :
    waldschmidtFunction l F t z =
      eval z F * cexp (t * (z 0 + ∑ k : Fin n, l k.castSucc * z k.succ)) :=
  (rfl)

/-- The coefficient-field factor `γ` of the `σ`-th derivative in `z₀` of the auxiliary function
`F(z) exp(t ⟨λ, z⟩)` at the grid point `s · y`:
`γ = (∑_{k ≤ σ} (σ choose k) t^(σ - k) (∂ᵏF/∂z₀ᵏ)(s · y)) α₁^(t s₁) ⋯ αₘ^(t sₘ)`,
computed in the field `K` containing the coefficients of `F`, the `αⱼ` and the `βᵢ`. When these
inputs are algebraic, for instance when `K` is a number field, `γ` is an algebraic number. -/
noncomputable def waldschmidtEntry {K : Type*} [Field K] (α b : Fin (n + 1) → K)
    (F : MvPolynomial (Fin (n + 1)) K) (t : ℤ) (σ : ℕ) (s : Fin (n + 1) → ℤ) : K :=
  (∑ k ∈ range (σ + 1), (σ.choose k : K) * (t : K) ^ (σ - k) *
    eval (waldschmidtPoint b s) ((pderiv 0)^[k] F)) * ∏ j, α j ^ (t * s j)

/-- The defining formula of `waldschmidtEntry α b F t σ s`. -/
theorem waldschmidtEntry_def {K : Type*} [Field K] (α b : Fin (n + 1) → K)
    (F : MvPolynomial (Fin (n + 1)) K) (t : ℤ) (σ : ℕ) (s : Fin (n + 1) → ℤ) :
    waldschmidtEntry α b F t σ s =
      (∑ k ∈ range (σ + 1), (σ.choose k : K) * (t : K) ^ (σ - k) *
        eval (waldschmidtPoint b s) ((pderiv 0)^[k] F)) * ∏ j, α j ^ (t * s j) :=
  (rfl)

/-- Without derivatives the entry is the value of `F` at the grid point times
`α₁^(t s₁) ⋯ αₘ^(t sₘ)`. -/
@[simp]
theorem waldschmidtEntry_zero {K : Type*} [Field K] (α b : Fin (n + 1) → K)
    (F : MvPolynomial (Fin (n + 1)) K) (t : ℤ) (s : Fin (n + 1) → ℤ) :
    waldschmidtEntry α b F t 0 s = eval (waldschmidtPoint b s) F * ∏ j, α j ^ (t * s j) := by
  simp [waldschmidtEntry_def]

/-- On the grid, the exponent of the auxiliary functions splits as
`⟨λ, s · y⟩ = s₁ λ₁ + ⋯ + sₘ λₘ + sₘ Λ`. -/
private theorem waldschmidtPoint_zero_add_sum (l b : Fin (n + 1) → ℂ) (s : Fin (n + 1) → ℤ) :
    waldschmidtPoint b s 0 + ∑ k : Fin n, l k.castSucc * waldschmidtPoint b s k.succ =
      ∑ j, (s j : ℂ) * l j + s (Fin.last n) * waldschmidtLinearForm l b := by
  simp only [waldschmidtPoint_apply_zero, waldschmidtPoint_apply_succ, waldschmidtLinearForm_def,
    Fin.sum_univ_castSucc, mul_add, mul_sub, sum_add_distrib]
  simp only [mul_sum, mul_assoc, mul_comm]
  ring

/-- The entry identity of Waldschmidt's interpolation determinant. Let `ι : K →+* ℂ` with
`ι αⱼ = exp λⱼ` for `1 ≤ j ≤ m`, and let `F` be a polynomial with coefficients in `K`. Then the
`σ`-th derivative in `z₀` of the auxiliary function `F(z) exp(t (z₀ + λ₁ z₁ + ⋯))` at the grid
point `s · y` is the image of the coefficient-field factor `γ = waldschmidtEntry α b F t σ s ∈ K`
times `exp(t sₘ Λ)`, where `Λ` is the normalized linear form; `γ` is algebraic when the inputs
in `K` are. -/
theorem iteratedDeriv_waldschmidtFunction {K : Type*} [Field K] (ι : K →+* ℂ)
    {l : Fin (n + 1) → ℂ} {α : Fin (n + 1) → K} (hα : ∀ j, ι (α j) = cexp (l j))
    (b : Fin (n + 1) → K) (F : MvPolynomial (Fin (n + 1)) K) (t : ℤ) (σ : ℕ)
    (s : Fin (n + 1) → ℤ) :
    iteratedDeriv σ (fun w ↦ waldschmidtFunction l (F.map ι) t
        (update (waldschmidtPoint (fun i ↦ ι (b i)) s) 0 w))
        (waldschmidtPoint (fun i ↦ ι (b i)) s 0) =
      ι (waldschmidtEntry α b F t σ s) *
        cexp (t * s (Fin.last n) * waldschmidtLinearForm l fun i ↦ ι (b i)) := by
  set x := waldschmidtPoint (fun i ↦ ι (b i)) s
  set c := ∑ k : Fin n, l k.castSucc * x k.succ
  -- Along the `z₀`-line through `x` the auxiliary function is `F(…) exp(t w + t c)`.
  have hline : (fun w ↦ waldschmidtFunction l (F.map ι) t (update x 0 w)) =
      fun w ↦ eval (update x 0 w) (F.map ι) * cexp (t * w + t * c) := by
    funext w
    simp [waldschmidtFunction_def, c, mul_add]
  -- Partial derivatives commute with the coefficient map `ι`.
  have hpderiv (k : ℕ) : (pderiv 0)^[k] (F.map ι) = ((pderiv 0)^[k] F).map ι := by
    induction k with
    | zero => rfl
    | succ k ih => rw [iterate_succ_apply', ih, pderiv_map, iterate_succ_apply']
  -- The exponential factor on the grid.
  have hexp : cexp (t * x 0 + t * c) =
      ι (∏ j, α j ^ (t * s j)) * cexp (t * s (Fin.last n) * waldschmidtLinearForm l
        fun i ↦ ι (b i)) := by
    rw [← mul_add, waldschmidtPoint_zero_add_sum, mul_add, exp_add, map_prod, mul_sum, exp_sum]
    congr 1
    · refine prod_congr rfl fun j _ ↦ ?_
      rw [map_zpow₀, hα, ← exp_int_mul]
      congr 1
      push_cast
      ring
    · rw [mul_assoc]
  rw [hline, iteratedDeriv_eval_update_mul_cexp]
  beta_reduce
  rw [update_eq_self, hexp, waldschmidtEntry_def, map_mul, ← mul_assoc]
  congr 1
  simp only [hpderiv, eval_map, x, waldschmidtPoint_map, eval₂_comp, comp_def, map_sum, map_mul,
    map_natCast, map_pow, map_intCast]

/-- The coefficient-field factor `γ_P` of the differential operator `P(∂/∂z₀)` applied to
Waldschmidt's auxiliary function `F(z) exp(t (z₀ + λ₁ z₁ + ⋯))` at the grid point `s · y`
(`TauCeti.sum_mul_iteratedDeriv_waldschmidtFunction`):
`γ_P = ((P(∂/∂z₀ + t) F)(s · y)) α₁^(t s₁) ⋯ αₘ^(t sₘ)`, where `P(X + t)` is the Taylor shift of
`P`. It is bilinear in the polynomial `F` and the operator `P`; for `P = X ^ σ` it is
`TauCeti.waldschmidtEntry α b F t σ s`. -/
noncomputable def waldschmidtOperatorEntry {K : Type*} [Field K] (α b : Fin (n + 1) → K) (t : ℤ)
    (s : Fin (n + 1) → ℤ) : MvPolynomial (Fin (n + 1)) K →ₗ[K] Polynomial K →ₗ[K] K :=
  LinearMap.mk₂ K (fun F P ↦ MvPolynomial.eval (waldschmidtPoint b s)
      (Polynomial.aeval (pderiv (0 : Fin (n + 1)) :
        Derivation K (MvPolynomial (Fin (n + 1)) K) _).toLinearMap
        (Polynomial.taylor (t : K) P) F) * ∏ j, α j ^ (t * s j))
    (fun F G P ↦ by simp [add_mul]) (fun c F P ↦ by simp [mul_assoc])
    (fun F P Q ↦ by simp [add_mul]) (fun c F P ↦ by simp [mul_assoc])

/-- The defining formula of `waldschmidtOperatorEntry α b t s F P`. -/
theorem waldschmidtOperatorEntry_apply {K : Type*} [Field K] (α b : Fin (n + 1) → K) (t : ℤ)
    (s : Fin (n + 1) → ℤ) (F : MvPolynomial (Fin (n + 1)) K) (P : Polynomial K) :
    waldschmidtOperatorEntry α b t s F P = MvPolynomial.eval (waldschmidtPoint b s)
      (Polynomial.aeval (pderiv (0 : Fin (n + 1)) :
        Derivation K (MvPolynomial (Fin (n + 1)) K) _).toLinearMap
        (Polynomial.taylor (t : K) P) F) * ∏ j, α j ^ (t * s j) :=
  (rfl)

/-- **Leibniz formula for the operator entries.** Since
`P(∂)(F e^{tz₀}) = e^{tz₀} P(∂ + t) F`, the entry of `P(∂/∂z₀)` is
`(∑ₖ P^{[k]}(t) (∂ᵏF/∂z₀ᵏ)(s · y)) α₁^(t s₁) ⋯ αₘ^(t sₘ)`, where `P^{[k]}` is the `k`-th Hasse
derivative of `P`. For Baker's binomial polynomials `P = Δ(X; k)ˡ` the denominators of the
numbers `P^{[k]}(t)` at integers `t` are bounded by
`TauCeti.pow_mul_eval_hasseDeriv_multichoose_X_add_one_pow_mem_range_intCast`. -/
theorem waldschmidtOperatorEntry_eq_sum_hasseDeriv {K : Type*} [Field K]
    (α b : Fin (n + 1) → K) (t : ℤ) (s : Fin (n + 1) → ℤ) (F : MvPolynomial (Fin (n + 1)) K)
    (P : Polynomial K) :
    waldschmidtOperatorEntry α b t s F P =
      (∑ k ∈ range (P.natDegree + 1), (Polynomial.hasseDeriv k P).eval (t : K) *
        MvPolynomial.eval (waldschmidtPoint b s) ((pderiv 0)^[k] F)) * ∏ j, α j ^ (t * s j) := by
  rw [waldschmidtOperatorEntry_apply, Polynomial.aeval_eq_sum_range, Polynomial.natDegree_taylor]
  simp only [LinearMap.coe_sum, Finset.sum_apply, map_sum, LinearMap.smul_apply,
    Module.End.pow_apply, smul_eval, Polynomial.taylor_coeff, Derivation.coeFn_coe]

/-- For the operator `∂^σ/∂z₀^σ` the entry is the entry `TauCeti.waldschmidtEntry` of the
iterated derivative. -/
@[simp]
theorem waldschmidtOperatorEntry_X_pow {K : Type*} [Field K] (α b : Fin (n + 1) → K) (t : ℤ)
    (s : Fin (n + 1) → ℤ) (F : MvPolynomial (Fin (n + 1)) K) (σ : ℕ) :
    waldschmidtOperatorEntry α b t s F (Polynomial.X ^ σ) = waldschmidtEntry α b F t σ s := by
  rw [waldschmidtOperatorEntry_eq_sum_hasseDeriv, waldschmidtEntry_def, Polynomial.natDegree_X_pow]
  simp [← Polynomial.monomial_one_right_eq_X_pow, Polynomial.hasseDeriv_monomial]

/-- For the identity operator the entry is the value of `F` at the grid point times
`α₁^(t s₁) ⋯ αₘ^(t sₘ)`. -/
@[simp]
theorem waldschmidtOperatorEntry_one {K : Type*} [Field K] (α b : Fin (n + 1) → K) (t : ℤ)
    (s : Fin (n + 1) → ℤ) (F : MvPolynomial (Fin (n + 1)) K) :
    waldschmidtOperatorEntry α b t s F 1 =
      MvPolynomial.eval (waldschmidtPoint b s) F * ∏ j, α j ^ (t * s j) := by
  simpa using waldschmidtOperatorEntry_X_pow α b t s F 0

/-- The entry identity for a differential operator. Let `ι : K →+* ℂ` with `ι αⱼ = exp λⱼ` for
`1 ≤ j ≤ m`, let `F` be a polynomial and `P = ∑ᵢ cᵢ Xⁱ` a one-variable polynomial with
coefficients in `K`. Then `P(∂/∂z₀)` applied to the auxiliary function
`F(z) exp(t (z₀ + λ₁ z₁ + ⋯))` at the grid point `s · y`, that is
`∑ᵢ ι(cᵢ) ∂ⁱ/∂z₀ⁱ (F(z) exp(t (z₀ + λ₁ z₁ + ⋯)))|_{z = s · y}`, is the image of the entry
`γ_P = waldschmidtOperatorEntry α b t s F P ∈ K` times `exp(t sₘ Λ)`. -/
theorem sum_mul_iteratedDeriv_waldschmidtFunction {K : Type*} [Field K] (ι : K →+* ℂ)
    {l : Fin (n + 1) → ℂ} {α : Fin (n + 1) → K} (hα : ∀ j, ι (α j) = cexp (l j))
    (b : Fin (n + 1) → K) (F : MvPolynomial (Fin (n + 1)) K) (t : ℤ) (P : Polynomial K)
    (s : Fin (n + 1) → ℤ) :
    (P.sum fun k c ↦ ι c * iteratedDeriv k (fun w ↦ waldschmidtFunction l (F.map ι) t
        (update (waldschmidtPoint (fun i ↦ ι (b i)) s) 0 w))
        (waldschmidtPoint (fun i ↦ ι (b i)) s 0)) =
      ι (waldschmidtOperatorEntry α b t s F P) *
        cexp (t * s (Fin.last n) * waldschmidtLinearForm l fun i ↦ ι (b i)) := by
  conv_rhs => rw [P.as_sum_support_C_mul_X_pow]
  simp only [map_sum, Polynomial.C_mul', map_smul, smul_eq_mul, waldschmidtOperatorEntry_X_pow,
    map_mul, Finset.sum_mul, Polynomial.sum_def, mul_assoc,
    iteratedDeriv_waldschmidtFunction ι hα]

/-- **Change of basis on the derivative side.** Fix a family of rows, the `r`-th built from the
polynomial `F r` and the integer `t r`, and a grid point `s`. If `P₀, P₁, …` is a polynomial
sequence (`P_σ` of degree `σ`), then the columns of entries of the operators
`P₀(∂/∂z₀), …, P_{N-1}(∂/∂z₀)` span the same space as the columns of entries of the iterated
derivatives `∂^σ/∂z₀^σ`, `σ < N`. Since the columns at the different grid points are handled one
point at a time, the interpolation matrix keeps its rank when the derivatives are replaced by
divided derivatives or by binomial-polynomial operators. -/
theorem span_image_waldschmidtOperatorEntry_sequence {K : Type*} [Field K] {ι : Type*}
    (α b : Fin (n + 1) → K)
    (F : ι → MvPolynomial (Fin (n + 1)) K) (t : ι → ℤ) (s : Fin (n + 1) → ℤ)
    (S : Polynomial.Sequence K) (N : ℕ) :
    Submodule.span K ((fun σ r ↦ waldschmidtOperatorEntry α b (t r) s (F r) (S σ)) ''
        Set.Iio N) =
      Submodule.span K ((fun σ r ↦ waldschmidtEntry α b (F r) (t r) σ s) '' Set.Iio N) := by
  classical
  let φ : Polynomial K →ₗ[K] ι → K :=
    LinearMap.pi fun r ↦ waldschmidtOperatorEntry α b (t r) s (F r)
  have h₁ : (fun σ r ↦ waldschmidtOperatorEntry α b (t r) s (F r) (S σ)) = φ ∘ S := by
    funext σ r
    simp [φ]
  have h₂ : (fun σ r ↦ waldschmidtEntry α b (F r) (t r) σ s) = φ ∘ (Polynomial.X ^ ·) := by
    funext σ r
    simp [φ, waldschmidtOperatorEntry_X_pow]
  rw [h₁, h₂, Set.image_comp, Set.image_comp, Submodule.span_image, Submodule.span_image,
    S.span_degreeLT fun i _ ↦
      isUnit_iff_ne_zero.2 (Polynomial.leadingCoeff_ne_zero.2 (S.ne_zero i)),
    Polynomial.degreeLT_eq_span_X_pow, Finset.coe_image, Finset.coe_range]

/-- **Change of basis on the polynomial side.** Fix a family of columns, the `c`-th built from the
operator `P c` and the grid point `s c`, and an integer `t`. If `Δ₀, Δ₁, …` is a polynomial
sequence (`Δₖ` of degree `k`), for instance the integer-valued binomial polynomials, then the rows
of entries of the products `∏ᵢ Δ_{τᵢ}(zᵢ)` with `τ` of degree at most `T` span the same space as
the rows of entries of the monomials `z^τ` with `τ` of degree at most `T`. -/
theorem span_image_waldschmidtOperatorEntry_prod_sequence {K : Type*} [Field K] {κ : Type*}
    (α b : Fin (n + 1) → K) (P : κ → Polynomial K)
    (t : ℤ) (s : κ → Fin (n + 1) → ℤ) (S : Polynomial.Sequence K) (T : ℕ) :
    Submodule.span K ((fun (τ : Fin (n + 1) →₀ ℕ) c ↦ waldschmidtOperatorEntry α b t (s c)
        (∏ i, Polynomial.aeval (X i) (S (τ i))) (P c)) '' {τ | τ.degree ≤ T}) =
      Submodule.span K ((fun (τ : Fin (n + 1) →₀ ℕ) c ↦ waldschmidtOperatorEntry α b t (s c)
        (monomial τ 1) (P c)) '' {τ | τ.degree ≤ T}) := by
  let ψ : MvPolynomial (Fin (n + 1)) K →ₗ[K] κ → K :=
    LinearMap.pi fun c ↦ (waldschmidtOperatorEntry α b t (s c)).flip (P c)
  have h₁ : (fun (τ : Fin (n + 1) →₀ ℕ) c ↦ waldschmidtOperatorEntry α b t (s c)
      (∏ i, Polynomial.aeval (X i) (S (τ i))) (P c)) =
      ψ ∘ fun τ ↦ ∏ i, Polynomial.aeval (X i) (S (τ i)) := by
    funext τ c
    simp [ψ]
  have h₂ : (fun (τ : Fin (n + 1) →₀ ℕ) c ↦ waldschmidtOperatorEntry α b t (s c)
      (monomial τ 1) (P c)) = ψ ∘ fun τ ↦ monomial τ 1 := by
    funext τ c
    simp [ψ]
  rw [h₁, h₂, Set.image_comp, Set.image_comp, Submodule.span_image, Submodule.span_image,
    S.span_prod_aeval_X_eq_restrictTotalDegree fun i _ ↦
      isUnit_iff_ne_zero.2 (Polynomial.leadingCoeff_ne_zero.2 (S.ne_zero i)),
    restrictTotalDegree_eq_span]

end TauCeti
