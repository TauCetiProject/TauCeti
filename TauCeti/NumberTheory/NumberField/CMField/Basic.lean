/-!
# CM fields: a Galois-free criterion, Hilbert's Theorem 90 and real-times-power decompositions

This file collects basic facts about a CM field `K`, with maximal real subfield `K⁺` and complex
conjugation `IsCMField.complexConj K`, that do not depend on any particular construction.

Mathlib's criterion `NumberField.IsCMField.of_forall_isConj` (a totally complex field with an
automorphism that is the conjugation of every complex embedding is CM) assumes that the field is
Galois over `ℚ`. Its proof only uses the field fixed by the group generated by that automorphism,
over which the whole field is Galois in any case, so the hypothesis can be dropped:
`TauCeti.NumberField.IsCMField.of_forall_isConj` is the criterion without it, with the same proof.
A CM field need not be Galois over `ℚ`, and this form is needed to recognise extensions of a CM
field as CM, for instance radical extensions
(`TauCeti/NumberTheory/NumberField/CMField/RadicalExtension.lean`).

Since `K / K⁺` is quadratic with Galois group generated by `complexConj K`, the norm from `K` to
`K⁺` is `x ↦ x * conj x` (`Algebra.IsQuadraticExtension.algebraMap_norm_eq_mul`), and Hilbert's
Theorem 90 for this cyclic extension says that the elements with `x * conj x = 1` are exactly the
quotients `conj y / y`.

Consequently a unit `x` is a totally real unit times an `n`-th power exactly when `x / conj x` is
an `n`-th power: an `n`-th root `β` of `x / conj x` satisfies `β * conj β = 1`, since every complex
embedding sends it to a root of unit modulus of an element of unit modulus, so `β = b / conj b` by
Hilbert's Theorem 90, and then `x / bⁿ` is fixed by complex conjugation.

## Main results

* `TauCeti.NumberField.IsCMField.of_forall_isConj`: a totally complex field with an
  automorphism that is the conjugation of every complex embedding is CM, without assuming that
  it is Galois over `ℚ`.
* `NumberField.IsCMField.exists_complexConj_div_eq_iff`: Hilbert's Theorem 90 for `K / K⁺`.
* `NumberField.IsCMField.complexConj_algebraMap`: complex conjugations of CM fields are compatible
  along field extensions.
* `NumberField.IsCMField.div_complexConj_mul_complexConj_div_complexConj_eq_one`: for a unit `x`,
  `u = x / conj x` satisfies `u * conj u = 1`.
* `NumberField.IsCMField.mul_complexConj_eq_one_of_pow_eq`: `n`-th roots of elements with
  `x * conj x = 1` satisfy the same identity.
* `NumberField.IsCMField.exists_mem_maximalRealSubfield_div_eq_pow_iff`: a unit `x` of a CM field
  is a totally real unit times an `n`-th power if and only if `x / conj x` is an `n`-th power.

## References

* J.-P. Serre, *Local Fields*, Chapter X, §1 (Hilbert's Theorem 90).
-/

public section

open NumberField ComplexEmbedding Algebra

namespace TauCeti.NumberField.IsCMField

open _root_.NumberField.IsCMField

variable (K : Type*) [Field K] [CharZero K] [Algebra.IsIntegral ℚ K] [IsTotallyComplex K]

/-- A totally complex field with an automorphism that is the conjugation of every complex
embedding is CM. Unlike `NumberField.IsCMField.of_forall_isConj`, whose proof this follows, the
field need not be Galois over `ℚ`. -/
theorem of_forall_isConj {σ : Gal(K/ℚ)}
    (hσ : ∀ φ : K →+* ℂ, IsConj φ σ) : IsCMField K := by
  let φ : K →+* ℂ := Classical.choice (inferInstance : Nonempty _)
  have hσ' : Nat.card (Subgroup.zpowers σ) = 2 := by
    rw [Nat.card_zpowers, orderOf_isConj_two_of_ne_one (hσ φ)]
    exact (isConj_ne_one_iff (hσ φ)).mpr <| IsTotallyComplex.complexEmbedding_not_isReal φ
  have : Finite (Subgroup.zpowers σ) := Nat.finite_of_card_ne_zero (by positivity)
  let F := FixedPoints.subfield (Subgroup.zpowers σ) K
  have : IsTotallyReal F := ⟨fun w ↦ by
    obtain ⟨W, rfl⟩ := w.comap_surjective (K := K)
    dsimp only
    rw [← InfinitePlace.mk_embedding W, InfinitePlace.comap_mk, InfinitePlace.isReal_mk_iff]
    exact (hσ W.embedding).isReal_comp
      (σ := IsGaloisGroup.mulEquivAlgEquiv (Subgroup.zpowers σ) F K ⟨σ, Subgroup.mem_zpowers σ⟩)⟩
  have : IsQuadraticExtension F K :=
    ⟨by rw [← IsGaloisGroup.card_eq_finrank (Subgroup.zpowers σ) F K, hσ']⟩
  exact ofCMExtension F K

end TauCeti.NumberField.IsCMField

namespace NumberField.IsCMField

variable (K : Type*) [Field K] [CharZero K] [IsCMField K] [Algebra.IsIntegral ℚ K]

local notation3 "K⁺" => maximalRealSubfield K

/-- **Hilbert's Theorem 90 for a CM field.** A unit `x` of a CM field satisfies
`x * conj x = 1` if and only if `x = conj y / y` for a unit `y`. -/
theorem exists_complexConj_div_eq_iff {x : Kˣ} :
    (∃ y : Kˣ, complexConj K (y : K) / y = x) ↔ (x : K) * complexConj K x = 1 := by
  have hg : ∀ σ, σ ∈ Subgroup.zpowers (complexConj K) := by
    simp [zpowers_complexConj_eq_top]
  rw [← IsQuadraticExtension.algebraMap_norm_eq_mul K⁺ K (complexConj_ne_one K),
    ← map_one (algebraMap K⁺ K),
    (algebraMap K⁺ K).injective.eq_iff, ← TauCeti.exists_smul_div_eq_iff_norm_eq_one hg]
  simp [Units.ext_iff, AlgEquiv.smul_units_def]

/-- Complex conjugations of CM fields are compatible along a field extension. -/
@[simp]
theorem complexConj_algebraMap (L : Type*) [Field L] [CharZero L] [IsCMField L]
    [Algebra.IsIntegral ℚ L] [Algebra K L] (x : K) :
    complexConj L (algebraMap K L x) = algebraMap K L (complexConj K x) := by
  let φ : L →+* ℂ := Classical.choice (inferInstance : Nonempty _)
  apply φ.injective
  rw [complexEmbedding_complexConj]
  exact (complexEmbedding_complexConj K (φ.comp (algebraMap K L)) x).symm

section Pow

variable {K}

/-- For a unit `x` of a CM field, `u = x / conj x` satisfies `u * conj u = 1`. -/
theorem div_complexConj_mul_complexConj_div_complexConj_eq_one (x : Kˣ) :
    x / complexConj K x * complexConj K (x / complexConj K x) = 1 := by
  have hcx : complexConj K (x : K) ≠ 0 := by simp
  rw [map_div₀, complexConj_apply_apply]
  field_simp

/-- An `n`-th root `β`, `n ≠ 0`, of an element `x` with `x * conj x = 1` again satisfies
`β * conj β = 1`. -/
theorem mul_complexConj_eq_one_of_pow_eq {β x : K} {n : ℕ} (hn : n ≠ 0) (hβ : β ^ n = x)
    (hx : x * complexConj K x = 1) : β * complexConj K β = 1 := by
  let φ : K →+* ℂ := Classical.choice (inferInstance : Nonempty _)
  have h := Complex.conj_eq_inv_of_pow_eq hn (z := φ β) (w := φ x) (by rw [← map_pow, hβ])
    (by rw [← complexEmbedding_complexConj, ← map_mul, hx, map_one])
  have hβ0 : β ≠ 0 := by
    rintro rfl
    simp [← hβ, zero_pow hn] at hx
  apply φ.injective
  rw [map_mul, complexEmbedding_complexConj, h, map_one,
    mul_inv_cancel₀ ((map_ne_zero φ).2 hβ0)]

/-- **Real-times-power decomposition in a CM field.** A unit `x` of a CM field is a totally real
unit times an `n`-th power if and only if `x / conj x` is an `n`-th power. -/
theorem exists_mem_maximalRealSubfield_div_eq_pow_iff {x : Kˣ} {n : ℕ} :
    (∃ z : Kˣ, (z : K) ∈ K⁺ ∧ ∃ b : Kˣ, (x : K) / z = b ^ n) ↔
      ∃ β : K, β ^ n = x / complexConj K x := by
  have hcx : complexConj K (x : K) ≠ 0 := by simp
  constructor
  · rintro ⟨z, hz, b, hb⟩
    have hcz : complexConj K (z : K) = z := (complexConj_eq_self_iff K _).2 hz
    have hcb : complexConj K (b : K) ≠ 0 := by simp
    have hx : (x : K) = z * b ^ n := by rw [← hb]; field_simp
    refine ⟨b / complexConj K b, ?_⟩
    rw [hx, map_mul, map_pow, hcz, div_pow]
    field_simp
  rintro ⟨β, hβ⟩
  rcases eq_or_ne n 0 with rfl | hn
  · refine ⟨x, (complexConj_eq_self_iff K _).1 ?_, 1, by simp⟩
    rw [pow_zero, eq_comm, div_eq_one_iff_eq hcx] at hβ
    exact hβ.symm
  have hβ1 : β * complexConj K β = 1 := mul_complexConj_eq_one_of_pow_eq hn hβ
    (div_complexConj_mul_complexConj_div_complexConj_eq_one x)
  obtain ⟨y, hy⟩ := (exists_complexConj_div_eq_iff K (x := Units.mk0 β
    (left_ne_zero_of_mul_eq_one hβ1))).2 hβ1
  rw [Units.val_mk0, div_eq_iff y.ne_zero] at hy
  refine ⟨x * y ^ n, (complexConj_eq_self_iff K _).1 ?_, y⁻¹, ?_⟩
  · rw [Units.val_mul, Units.val_pow_eq_pow_val, map_mul, map_pow, hy, mul_pow, hβ]
    field_simp
  · simp only [Units.val_mul, Units.val_pow_eq_pow_val, Units.val_inv_eq_inv_val, inv_pow]
    field_simp

end Pow

end NumberField.IsCMField
