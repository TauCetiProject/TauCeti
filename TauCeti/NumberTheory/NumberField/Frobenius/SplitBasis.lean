/-!
# Frobenius bases at completely split places

Let `M/K` be an abelian extension of number fields whose Galois group has exponent a prime `p`,
for instance the Kummer extension `K(U_S^{1/p})` generated by the `p`-th roots of the `S`-units of
a field containing the `p`-th roots of unity, and let `L` be an intermediate field. An unramified
finite place `v` of `K` has a single Frobenius element `Frob_v ∈ Gal(M/K)`
(`NumberFieldArithmetic.artinElementAway`).

Suppose that the Frobenius elements of `M/L` at the places of `L` above the places of `K` outside a
finite set `S` generate `Gal(M/L)`. This file shows that the Frobenius elements of `M/K` at finitely
many places `v ∉ S` of `K` that have a place of local degree one in `L` already form a basis of
`Gal(M/L)`, viewed as a subgroup of `Gal(M/K)`: there is a finite set `T` of finite places of `K`,
disjoint from `S`, such that

* the elements `Frob_v` for `v ∈ T` generate `Gal(M/L)`, and there are as few of them as
  possible: `p ^ #T = [M : L]`;
* every `v ∈ T` has a place of `L` above it of local degree one.

The point is that a Frobenius element of `M/L` at a place `w` of `L` above `v` is the power
`Frob_v ^ f(w/v)` (`NumberField.restrictScalars_eq_pow_inertiaDeg`), and `f(w/v)` divides the
order of `Frob_v`, which divides `p`. So either `f(w/v) = p` and the Frobenius element of `M/L` at
`w` is trivial, or `f(w/v) = 1` and it is `Frob_v` itself. The Frobenius elements at places of
residue degree one therefore generate `Gal(M/L)` on their own, and an `𝔽_p`-basis of
`Gal(M/L)` can be extracted from them (`TauCeti.exists_finset_subset_closure_eq_natCard_eq_pow`).

This is the choice of the auxiliary set `T` in Milne's Kummer-theoretic proof of the second
fundamental inequality, applied with `M = K(U_S^{1/p})` and `L/K` cyclic of degree `p`. The
generation hypothesis is the conclusion of Milne's Proposition 4.7 for the extension `M/L`, that
the Frobenius elements outside a finite set generate the Galois group of an abelian extension.

## Main results

* `TauCeti.NumberField.exists_finset_closure_artinElementAway_eq_range_restrictScalarsHom`: the
  finite set `T`.

## References

* J. S. Milne, *Class Field Theory*, v4.03, Chapter VII, §6 (the choice of `T` in the proof of
  the second inequality) and Proposition 4.7.
-/

public section

open IsDedekindDomain NumberField TauCeti.NumberFieldArithmetic
open scoped AdicCompletionExtension

namespace TauCeti.NumberField

variable {K L M : Type*} [Field K] [NumberField K] [Field L] [NumberField L] [Field M]
  [NumberField M] [Algebra K L] [Algebra K M] [Algebra L M] [IsScalarTower K L M] [IsGalois K M]
  {p : ℕ} (hp : p.Prime) (hexp : Monoid.exponent (M ≃ₐ[K] M) ∣ p)
  (hab : ∀ σ τ : M ≃ₐ[K] M, Commute σ τ) (S : Finset (HeightOneSpectrum (𝓞 K)))
  (hur : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S →
    ∀ (Q : Ideal (𝓞 M)) [Q.IsPrime] [Q.LiesOver v.asIdeal], Algebra.IsUnramifiedAt (𝓞 K) Q)

include hp hexp in
/-- The Frobenius elements `Frob_v` at the places `v ∉ S` that have a place of `L` of residue
degree one above them generate `Gal(M/L)`, as soon as the Frobenius elements of `M/L` above the
places outside `S` do. A Frobenius element of `M/L` at a place `w` above `v` is
`Frob_v ^ f(w/v)`, and `f(w/v)` divides the order of `Frob_v`, hence `p`: it is either `Frob_v`
itself, at residue degree one, or trivial. -/
private theorem closure_artinElementAway_image_eq_range
    (hgen : Subgroup.closure {τ : M ≃ₐ[L] M | ∃ v ∉ S,
      ∃ Q : {Q : HeightOneSpectrum (𝓞 M) // Q.asIdeal.LiesOver v.asIdeal},
        IsArithFrobAt (𝓞 L) τ Q.1.asIdeal} = ⊤) :
    Subgroup.closure (artinElementAway hab S hur '' {v | v ∉ S ∧ ∃ Q : HeightOneSpectrum (𝓞 M),
      Q.asIdeal.LiesOver v.asIdeal ∧ (Q.asIdeal.under (𝓞 L)).inertiaDeg (𝓞 K) = 1}) =
      (AlgEquiv.restrictScalarsHom K : (M ≃ₐ[L] M) →* (M ≃ₐ[K] M)).range := by
  have : IsGalois L M := IsGalois.tower_top_of_isGalois K L M
  have hpow (σ : M ≃ₐ[K] M) : σ ^ p = 1 := Monoid.exponent_dvd_iff_forall_pow_eq_one.mp hexp σ
  have hfrob {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) (Q : HeightOneSpectrum (𝓞 M))
      [Q.asIdeal.LiesOver v.asIdeal] {τ : M ≃ₐ[L] M} (hτ : IsArithFrobAt (𝓞 L) τ Q.asIdeal) :
      AlgEquiv.restrictScalarsHom K τ =
        artinElementAway hab S hur v ^ (Q.asIdeal.under (𝓞 L)).inertiaDeg (𝓞 K) := by
    have := hur v hv Q.asIdeal
    exact NumberField.restrictScalars_eq_pow_inertiaDeg
      (isArithFrobAt_artinElementAway hab S hur hv Q.asIdeal) hτ
  refine le_antisymm ((Subgroup.closure_le _).mpr ?_) ?_
  · rintro _ ⟨v, ⟨hv, Q, hQ, h1⟩, rfl⟩
    obtain ⟨τ, hτ⟩ := exists_isArithFrobAt L Q.asIdeal Q.ne_bot
    exact ⟨τ, by rw [hfrob hv Q hτ, h1, pow_one]⟩
  · rw [MonoidHom.range_eq_map, ← hgen, MonoidHom.map_closure, Subgroup.closure_le]
    rintro _ ⟨τ, ⟨v, hv, ⟨Q, hQ⟩, hτ⟩, rfl⟩
    rw [SetLike.mem_coe, hfrob hv Q hτ]
    -- `f(w/v)` divides `f(Q/v)`, the order of `Frob_v`, which divides `p`.
    have hdvd : (Q.asIdeal.under (𝓞 L)).inertiaDeg (𝓞 K) ∣ p := by
      have := hur v hv Q.asIdeal
      have horder := Ideal.orderOf_eq_inertiaDeg_of_isArithFrobAt Q.asIdeal Q.ne_bot
        (isArithFrobAt_artinElementAway hab S hur hv Q.asIdeal)
      rw [Ideal.inertiaDeg_tower (Q.asIdeal.under (𝓞 L)) Q.asIdeal] at horder
      exact (Dvd.intro _ horder.symm).trans (orderOf_dvd_of_pow_eq_one (hpow _))
    rcases hp.eq_one_or_self_of_dvd _ hdvd with h1 | hpf
    · rw [h1, pow_one]
      exact Subgroup.subset_closure ⟨v, ⟨hv, Q, hQ, h1⟩, rfl⟩
    · rw [hpf, hpow]
      exact one_mem _

include hp hexp in
/-- **A basis of Frobenius elements at completely split places.** Let `M/K` be an abelian
extension of number fields whose Galois group has exponent dividing a prime `p`, unramified at the
finite places outside a finite set `S`, and let `L` be an intermediate field. Suppose that the
Frobenius elements of `M/L` at the primes of `M` above the places of `K` outside `S` generate
`Gal(M/L)`. Then there is a finite set `T` of finite places of `K`, disjoint from `S`, such that
the Frobenius elements `Frob_v ∈ Gal(M/K)`, `v ∈ T`, generate the subgroup `Gal(M/L)`, with
`p ^ #T = [M : L]`, and every `v ∈ T` has a place of `L` above it of local degree one.

The equation `p ^ #T = [M : L]` says that `T` is as small as possible: the `Frob_v` with `v ∈ T`
form a basis of `Gal(M/L)` as an `𝔽_p`-vector space. -/
theorem exists_finset_closure_artinElementAway_eq_range_restrictScalarsHom
    (hgen : Subgroup.closure {τ : M ≃ₐ[L] M | ∃ v ∉ S,
      ∃ Q : {Q : HeightOneSpectrum (𝓞 M) // Q.asIdeal.LiesOver v.asIdeal},
        IsArithFrobAt (𝓞 L) τ Q.1.asIdeal} = ⊤) :
    ∃ T : Finset (HeightOneSpectrum (𝓞 K)), Disjoint S T ∧
      Subgroup.closure (artinElementAway hab S hur '' T) =
        (AlgEquiv.restrictScalarsHom K : (M ≃ₐ[L] M) →* (M ≃ₐ[K] M)).range ∧
      p ^ T.card = Module.finrank L M ∧
      ∀ v ∈ T, ∃ w : {w : HeightOneSpectrum (𝓞 L) // w.asIdeal.LiesOver v.asIdeal},
        Module.finrank (v.adicCompletion K) (w.1.adicCompletion L) = 1 := by
  classical
  have : IsGalois L M := IsGalois.tower_top_of_isGalois K L M
  have : IsMulCommutative (M ≃ₐ[K] M) := isMulCommutative_galoisGroup_of_commute hab
  set Y : Set (HeightOneSpectrum (𝓞 K)) := {v | v ∉ S ∧ ∃ Q : HeightOneSpectrum (𝓞 M),
    Q.asIdeal.LiesOver v.asIdeal ∧ (Q.asIdeal.under (𝓞 L)).inertiaDeg (𝓞 K) = 1}
  have hY := closure_artinElementAway_image_eq_range hp hexp hab S hur hgen
  -- Extract a basis of `Gal(M/L)` from the Frobenius elements at `Y`, and the places carrying it.
  obtain ⟨B, hBY, hBcl, hcard⟩ :=
    exists_finset_subset_closure_eq_natCard_eq_pow hp hexp (artinElementAway hab S hur '' Y)
  have hBY' (b : B) : ∃ v ∈ Y, artinElementAway hab S hur v = b := hBY b.2
  choose g hgY hgF using hBY'
  have hg : Function.Injective g := fun b b' h ↦ Subtype.ext (by rw [← hgF b, ← hgF b', h])
  set T : Finset (HeightOneSpectrum (𝓞 K)) := Finset.univ.image g
  have hTY {v : HeightOneSpectrum (𝓞 K)} (hv : v ∈ T) : v ∈ Y := by
    obtain ⟨b, -, rfl⟩ := Finset.mem_image.mp hv
    exact hgY b
  have himage : artinElementAway hab S hur '' (T : Set (HeightOneSpectrum (𝓞 K))) = B := by
    ext σ
    constructor
    · rintro ⟨v, hv, rfl⟩
      obtain ⟨b, -, rfl⟩ := Finset.mem_image.mp hv
      rw [hgF]
      exact b.2
    · exact fun hσ ↦ ⟨g ⟨σ, hσ⟩, Finset.mem_image_of_mem _ (Finset.mem_univ _), hgF _⟩
  refine ⟨T, Finset.disjoint_left.mpr fun _ hvS hvT ↦ (hTY hvT).1 hvS, ?_, ?_, ?_⟩
  · rw [himage, hBcl, hY]
  · rw [Finset.card_image_of_injective _ hg, Finset.card_univ, Fintype.card_coe, ← hcard, hY,
      ← Nat.card_congr (MonoidHom.ofInjective (AlgEquiv.restrictScalarsHom_injective K)).toEquiv,
      IsGalois.card_aut_eq_finrank]
  · intro v hvT
    obtain ⟨hvS, Q, hQ, h1⟩ := hTY hvT
    have := hur v hvS Q.asIdeal
    -- The place `w = Q ∩ 𝓞 L` lies over `v`; it is unramified because `Q` is, and has residue
    -- degree one, so its local degree `e(w/v) f(w/v)` is one.
    set w := HeightOneSpectrum.under (𝓞 L) Q
    have hw : w.asIdeal.LiesOver v.asIdeal :=
      ⟨by rw [HeightOneSpectrum.under_asIdeal, Ideal.under_under]; exact hQ.over⟩
    have : Finite (𝓞 L ⧸ w.asIdeal) := Ring.HasFiniteQuotients.finiteQuotient w.ne_bot
    have he := Ideal.ramificationIdx_tower (R := 𝓞 K) (Q.asIdeal.under (𝓞 L)) Q.asIdeal
    rw [Ideal.ramificationIdx_eq_one_of_isUnramifiedAt] at he
    refine ⟨⟨w, hw⟩, ?_⟩
    rw [HeightOneSpectrum.finrank_adicCompletion, HeightOneSpectrum.under_asIdeal, h1, mul_one]
    exact Nat.eq_one_of_mul_eq_one_right he.symm

end TauCeti.NumberField
