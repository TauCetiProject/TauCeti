module

public import Mathlib.FieldTheory.Galois.Basic
public import TauCeti.NumberTheory.NumberField.AutomorphismAction
public import TauCeti.RingTheory.Frobenius.PowerResidue

/-!
# Kummer generators and Frobenius elements

Let `M/K` be a finite Galois extension of number fields, `L` an intermediate field, and suppose
that `Gal(M/L)` is generated by Frobenius elements `σ i` at primes `Q i` of `𝓞 M`. Let `K` contain
a primitive `n`-th root of unity, and let `a ∈ 𝓞 K` have an `n`-th root `α ∈ 𝓞 M`, with `n` and
`a` prime to every `Q i`. Then `a` becomes an `n`-th power in `L` exactly when it is an `n`-th
power modulo every prime `Q i ∩ 𝓞 K` of `K`
(`TauCeti.NumberField.exists_mem_intermediateField_pow_eq_iff_forall_exists_pow_eq_mk`).

This is the residue-field form of Lemma 6.3 of Milne's algebraic proof of the second fundamental
inequality. There `M` is the Kummer extension `K(U(S)^{1/p})`, `L` a cyclic subextension of
degree `p`, and the `Q i` lie over a finite set `T` of primes of `K` whose Frobenius elements form
a basis of `Gal(M/L)`. The lemma identifies the `S`-units that become `p`-th powers in `L` with
those that are `p`-th powers at every place of `T`. Through Hensel's lemma
(`TauCeti.unitsMap_subtype_mem_range_powMonoidHom_iff`), being a `p`-th power modulo a prime
`v ∤ p` is being a `p`-th power in `K_v`, the local condition in Milne's statement.

Since `L` is the fixed field of `Gal(M/L)`, an element of `M` lies in `L` exactly when every
`σ i` fixes it. Both statements are thus the field-theoretic form of the power residue criterion
for the subgroup generated by the `σ i` (`IsArithFrobAt.forall_mem_closure_smul_eq_self_iff`).

## Main results

* `TauCeti.NumberField.coe_mem_intermediateField_iff_forall_exists_pow_eq_mk`: the `n`-th root
  `α` lies in `L` exactly when `a` is an `n`-th power modulo every `Q i ∩ 𝓞 K`.
* `TauCeti.NumberField.exists_mem_intermediateField_pow_eq_iff_forall_exists_pow_eq_mk`: `a` is an
  `n`-th power in `L` exactly when it is one modulo every `Q i ∩ 𝓞 K`.

## References

* J. S. Milne, *Class Field Theory*, v4.03, Chapter VII, Lemma 6.3.
-/

public section

open NumberField

namespace TauCeti.NumberField

variable {K M : Type*} [Field K] [NumberField K] [Field M] [NumberField M] [Algebra K M]
  [IsGalois K M] {L : IntermediateField K M} {ι : Type*} {σ : ι → M ≃ₐ[K] M}
  {Q : ι → Ideal (𝓞 M)} [∀ i, (Q i).IsPrime] {n : ℕ} {ζ a : 𝓞 K} {α : 𝓞 M}

/-- **An `n`-th root lies in a subfield cut out by Frobenius elements exactly at common power
residues.** Let `M/K` be Galois and `L` an intermediate field such that `Gal(M/L)` is generated by
arithmetic Frobenius elements `σ i` at primes `Q i` of `𝓞 M`. Let `ζ ∈ 𝓞 K` be a primitive `n`-th
root of unity, and let `α ^ n = a` with `n` and `a` outside every `Q i`. Then `α ∈ L` exactly when
`a` is an `n`-th power modulo every `Q i ∩ 𝓞 K`. -/
theorem coe_mem_intermediateField_iff_forall_exists_pow_eq_mk
    (hσ : ∀ i, IsArithFrobAt (𝓞 K) (σ i) (Q i))
    (hL : L.fixingSubgroup = Subgroup.closure (Set.range σ)) (hζ : IsPrimitiveRoot ζ n)
    (hn : ∀ i, (n : 𝓞 M) ∉ Q i) (ha : ∀ i, algebraMap (𝓞 K) (𝓞 M) a ∉ Q i)
    (hα : α ^ n = algebraMap (𝓞 K) (𝓞 M) a) :
    (α : M) ∈ L ↔ ∀ i, ∃ b : 𝓞 K ⧸ (Q i).under (𝓞 K), b ^ n = Ideal.Quotient.mk _ a := by
  have hζM : IsPrimitiveRoot (algebraMap (𝓞 K) (𝓞 M) ζ) n :=
    hζ.map_of_injective (FaithfulSMul.algebraMap_injective (𝓞 K) (𝓞 M))
  rw [← IsArithFrobAt.forall_mem_closure_smul_eq_self_iff hσ hζM hn hα ha, ← hL]
  -- `L` is the fixed field of `Gal(M/L)`, and the action on `𝓞 M` is the one on `M`.
  conv_lhs => rw [← IsGalois.fixedField_fixingSubgroup L]
  rw [IntermediateField.mem_fixedField_iff]
  refine forall₂_congr fun g _ ↦ ?_
  rw [← RingOfIntegers.coe_injective.eq_iff, RingOfIntegers.coe_eq_algebraMap,
    algebraMap_smul_eq_apply]

/-- **Residue-field form of Milne's Lemma VII.6.3: power residues detect `n`-th powers in a
subfield cut out by Frobenius elements.** Let `M/K` be Galois and `L` an intermediate field such
that `Gal(M/L)` is generated by arithmetic Frobenius elements `σ i` at primes `Q i` of `𝓞 M`. Let
`ζ ∈ 𝓞 K` be a primitive `n`-th root of unity, and let `a ∈ 𝓞 K` have an `n`-th root `α ∈ 𝓞 M`,
with `n` and `a` outside every `Q i`. Then `a` is an `n`-th power in `L` exactly when it is an
`n`-th power modulo every `Q i ∩ 𝓞 K`. Milne's local form, with `p`-th powers in completions
`K_v`, follows by combining this with `TauCeti.unitsMap_subtype_mem_range_powMonoidHom_iff`. -/
theorem exists_mem_intermediateField_pow_eq_iff_forall_exists_pow_eq_mk [NeZero n]
    (hσ : ∀ i, IsArithFrobAt (𝓞 K) (σ i) (Q i))
    (hL : L.fixingSubgroup = Subgroup.closure (Set.range σ)) (hζ : IsPrimitiveRoot ζ n)
    (hn : ∀ i, (n : 𝓞 M) ∉ Q i) (ha : ∀ i, algebraMap (𝓞 K) (𝓞 M) a ∉ Q i)
    (hα : α ^ n = algebraMap (𝓞 K) (𝓞 M) a) :
    (∃ β ∈ L, β ^ n = algebraMap K M a) ↔
      ∀ i, ∃ b : 𝓞 K ⧸ (Q i).under (𝓞 K), b ^ n = Ideal.Quotient.mk _ a := by
  rw [← coe_mem_intermediateField_iff_forall_exists_pow_eq_mk hσ hL hζ hn ha hα]
  have hαM : (α : M) ^ n = algebraMap K M a := by
    rw [← map_pow, hα, ← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply (𝓞 K) K M]
  refine ⟨fun ⟨β, hβL, hβ⟩ ↦ ?_, fun h ↦ ⟨α, h, hαM⟩⟩
  -- `β` is another `n`-th root of `a`, so it differs from `α` by a power of `ζ`, which lies in `K`.
  have hζM : IsPrimitiveRoot (algebraMap (𝓞 K) M ζ) n :=
    hζ.map_of_injective (FaithfulSMul.algebraMap_injective (𝓞 K) M)
  have hroot : β ∈ Polynomial.nthRoots n (algebraMap K M a) := by
    rw [Polynomial.mem_nthRoots (Nat.pos_of_ne_zero (NeZero.ne n)), hβ]
  rw [hζM.nthRoots_eq hαM, Multiset.mem_map] at hroot
  obtain ⟨i, -, hi⟩ := hroot
  have hζi : algebraMap (𝓞 K) M ζ ^ i ≠ 0 := pow_ne_zero _ (hζM.ne_zero (NeZero.ne n))
  have hαβ : (α : M) = (algebraMap (𝓞 K) M ζ ^ i)⁻¹ * β := by
    rw [← hi, inv_mul_cancel_left₀ hζi]
  rw [hαβ, IsScalarTower.algebraMap_apply (𝓞 K) K M]
  exact L.mul_mem (L.inv_mem (pow_mem (L.algebraMap_mem _) i)) hβL

end TauCeti.NumberField
