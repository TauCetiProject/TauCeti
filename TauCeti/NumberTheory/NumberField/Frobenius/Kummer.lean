module

public import Mathlib.FieldTheory.Galois.Basic
public import TauCeti.NumberTheory.NumberField.AutomorphismAction
public import TauCeti.RingTheory.Frobenius.PowerResidue
public import TauCeti.RingTheory.DedekindDomain.AdicValuation.Power
import TauCeti.FieldTheory.Kummer.Cyclic
import TauCeti.NumberTheory.NumberField.Kummer.IntegralRoot

/-!
# Kummer generators and Frobenius elements

Let `M/K` be a finite Galois extension of number fields, `L` an intermediate field, and suppose
that `Gal(M/L)` is generated by Frobenius elements `σ i` at primes `Q i` of `𝓞 M`. Let `K` contain
a primitive `n`-th root of unity, and let `a ∈ 𝓞 K` have an `n`-th root `α ∈ 𝓞 M`, with `n` and
`a` prime to every `Q i`. Then `a` becomes an `n`-th power in `L` exactly when it is an `n`-th
power modulo every prime `Q i ∩ 𝓞 K` of `K`
(`TauCeti.NumberField.exists_mem_intermediateField_pow_eq_iff_forall_exists_pow_eq_mk`).

For integral radicands, this is the residue-field form of Milne's Lemma VII.6.3. In that
argument, `M` is the Kummer extension `K(U(S)^{1/p})`, `L` is a cyclic subextension of degree
`p`, and the `Q i` lie over a set `T` of primes outside `S` whose Frobenius elements form a basis
of `Gal(M/L)`. The radicands there are the `S`-units, which need not be integral but are units at
every place of `T`. The completion form
`exists_mem_intermediateField_pow_eq_iff_forall_exists_pow_eq_adicCompletion` covers them: an
element `b ∈ K` that is a unit at every `v i` and has an `n`-th root in `M` is an `n`-th power in
`L` exactly when it is one in every `K_{v i}`. It requires no unramifiedness assumption on `M`.

The completion form is proved one Frobenius element at a time. An `n`-th root `β` of a `v`-unit
`b` becomes integral after multiplication by some `d ∈ 𝓞 K` outside `v`, with integral radicand
`dⁿ b` outside `v` (`TauCeti.NumberField.exists_integral_pow_eq_of_valuation_eq_one`). So a
Frobenius element `τ` above `v` fixes `β` exactly when `dⁿ b` is an `n`-th power modulo `v`, that
is, by Hensel's lemma, exactly when `b` is an `n`-th power in `K_v`
(`TauCeti.NumberField.apply_eq_self_iff_exists_pow_eq_adicCompletion`): this is the classical
statement that `v` splits completely in `K(b^{1/n})` exactly when `b` is a local `n`-th power.

Since `L` is the fixed field of `Gal(M/L)`, an element of `M` lies in `L` exactly when every
`σ i` fixes it. All statements are thus field-theoretic forms of the power residue criterion
for the subgroup generated by the `σ i` (`IsArithFrobAt.forall_mem_closure_smul_eq_self_iff`).

## Main results

* `TauCeti.NumberField.coe_mem_intermediateField_iff_forall_exists_pow_eq_mk`: the `n`-th root
  `α` lies in `L` exactly when `a` is an `n`-th power modulo every `Q i ∩ 𝓞 K`.
* `TauCeti.NumberField.exists_mem_intermediateField_pow_eq_iff_forall_exists_pow_eq_mk`: `a` is an
  `n`-th power in `L` exactly when it is one modulo every `Q i ∩ 𝓞 K`.
* `TauCeti.NumberField.apply_eq_self_iff_exists_pow_eq_adicCompletion`: a Frobenius element above
  `v` fixes an `n`-th root of a `v`-unit `b` exactly when `b` is an `n`-th power in `K_v`.
* `TauCeti.NumberField.mem_intermediateField_iff_forall_exists_pow_eq_adicCompletion`: an `n`-th
  root of an element of `K` that is a unit at every `v i` lies in `L` exactly when that element
  is an `n`-th power in every `K_{v i}`.
* `TauCeti.NumberField.exists_mem_intermediateField_pow_eq_iff_forall_exists_pow_eq_adicCompletion`:
  such an element is an `n`-th power in `L` exactly when it is one in every `K_{v i}`.

## References

* J. S. Milne, *Class Field Theory*, v4.03, Chapter VII, Lemma 6.3.
-/

public section

open NumberField

namespace TauCeti.NumberField

variable {K M : Type*} [Field K] [NumberField K] [Field M] [NumberField M] [Algebra K M]
  [IsGalois K M] {L : IntermediateField K M} {ι : Type*} {σ : ι → M ≃ₐ[K] M}
  {Q : ι → Ideal (𝓞 M)} [∀ i, (Q i).IsPrime] {n : ℕ} {ζ a : 𝓞 K} {α : 𝓞 M}

/-- **An `n`-th root lies in a subfield cut out by Frobenius elements exactly at common power
residues.** Let `M/K` be Galois and `L` an intermediate field such that `Gal(M/L)` is generated by
arithmetic Frobenius elements `σ i` at primes `Q i` of `𝓞 M`. Let `ζ ∈ 𝓞 K` be a primitive `n`-th
root of unity, and let `α ^ n = a` with `n` and `a` outside every `Q i`. Then `α ∈ L` exactly when
`a` is an `n`-th power modulo every `Q i ∩ 𝓞 K`. -/
theorem coe_mem_intermediateField_iff_forall_exists_pow_eq_mk
    (hσ : ∀ i, IsArithFrobAt (𝓞 K) (σ i) (Q i))
    (hL : L.fixingSubgroup = Subgroup.closure (Set.range σ)) (hζ : IsPrimitiveRoot ζ n)
    (hn : ∀ i, (n : 𝓞 M) ∉ Q i) (ha : ∀ i, algebraMap (𝓞 K) (𝓞 M) a ∉ Q i)
    (hα : α ^ n = algebraMap (𝓞 K) (𝓞 M) a) :
    (α : M) ∈ L ↔ ∀ i, ∃ b : 𝓞 K ⧸ (Q i).under (𝓞 K), b ^ n = Ideal.Quotient.mk _ a := by
  have hζM : IsPrimitiveRoot (algebraMap (𝓞 K) (𝓞 M) ζ) n :=
    hζ.map_of_injective (FaithfulSMul.algebraMap_injective (𝓞 K) (𝓞 M))
  rw [← IsArithFrobAt.forall_mem_closure_smul_eq_self_iff hσ hζM hn hα ha, ← hL]
  -- `L` is the fixed field of `Gal(M/L)`, and the action on `𝓞 M` is the one on `M`.
  conv_lhs => rw [← IsGalois.fixedField_fixingSubgroup L]
  rw [IntermediateField.mem_fixedField_iff]
  refine forall₂_congr fun g _ ↦ ?_
  rw [← RingOfIntegers.coe_injective.eq_iff, RingOfIntegers.coe_eq_algebraMap,
    algebraMap_smul_eq_apply]

/-- **Residue-field form of Milne's Lemma VII.6.3: power residues detect `n`-th powers in a
subfield cut out by Frobenius elements.** Let `M/K` be Galois and `L` an intermediate field such
that `Gal(M/L)` is generated by arithmetic Frobenius elements `σ i` at primes `Q i` of `𝓞 M`. Let
`ζ ∈ 𝓞 K` be a primitive `n`-th root of unity, and let `a ∈ 𝓞 K` have an `n`-th root `α ∈ 𝓞 M`,
with `n` and `a` outside every `Q i`. Then `a` is an `n`-th power in `L` exactly when it is an
`n`-th power modulo every `Q i ∩ 𝓞 K`. The completion criterion below transports these
residue conditions through Hensel's lemma. -/
theorem exists_mem_intermediateField_pow_eq_iff_forall_exists_pow_eq_mk [NeZero n]
    (hσ : ∀ i, IsArithFrobAt (𝓞 K) (σ i) (Q i))
    (hL : L.fixingSubgroup = Subgroup.closure (Set.range σ)) (hζ : IsPrimitiveRoot ζ n)
    (hn : ∀ i, (n : 𝓞 M) ∉ Q i) (ha : ∀ i, algebraMap (𝓞 K) (𝓞 M) a ∉ Q i)
    (hα : α ^ n = algebraMap (𝓞 K) (𝓞 M) a) :
    (∃ β ∈ L, β ^ n = algebraMap K M a) ↔
      ∀ i, ∃ b : 𝓞 K ⧸ (Q i).under (𝓞 K), b ^ n = Ideal.Quotient.mk _ a := by
  rw [← coe_mem_intermediateField_iff_forall_exists_pow_eq_mk hσ hL hζ hn ha hα]
  have hαM : (α : M) ^ n = algebraMap K M a := by
    rw [← map_pow, hα, ← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply (𝓞 K) K M]
  rw [← hαM, L.exists_mem_pow_eq_pow_iff_mem
    (hζ.map_of_injective (FaithfulSMul.algebraMap_injective (𝓞 K) K))]

omit [NumberField M] [IsGalois K M] in
/-- **A Frobenius element above `v` fixes an `n`-th root of a `v`-unit exactly at a local `n`-th
power.** Let `τ` be an arithmetic Frobenius element at a prime `P` of `𝓞 M` above the finite place
`v` of `K`, let `ζ ∈ 𝓞 K` be a primitive `n`-th root of unity with `n ∉ v`, and let `β ∈ M` be an
`n`-th root of an element `b ∈ K` with `v(b) = 1`. Then `τ β = β` exactly when `b` is an `n`-th
power in the completion `K_v`. -/
theorem apply_eq_self_iff_exists_pow_eq_adicCompletion {τ : M ≃ₐ[K] M} {P : Ideal (𝓞 M)}
    [P.IsPrime] {v : IsDedekindDomain.HeightOneSpectrum (𝓞 K)} [P.LiesOver v.asIdeal]
    (hτ : IsArithFrobAt (𝓞 K) τ P) (hζ : IsPrimitiveRoot ζ n) (hn : (n : 𝓞 K) ∉ v.asIdeal)
    {b : K} (hb : v.valuation K b = 1) {β : M} (hβ : β ^ n = algebraMap K M b) :
    τ β = β ↔ ∃ x : v.adicCompletion K, x ^ n = algebraMap K (v.adicCompletion K) b := by
  have hn0 : n ≠ 0 := by
    rintro rfl
    exact hn (by simp)
  -- `γ = d β` is an integral `n`-th root of `c = dⁿ b`, for some `d, c ∉ v`.
  obtain ⟨d, c, γ, hd, hc, hcb, hγ, hγc⟩ := exists_integral_pow_eq_of_valuation_eq_one hn0 hβ hb
  have hd0 : d ≠ 0 := by
    rintro rfl
    exact hd v.asIdeal.zero_mem
  -- `τ` fixes `β` exactly when it fixes `γ`, since it fixes `d ∈ K`.
  have hfix : τ β = β ↔ τ • γ = γ := by
    rw [← RingOfIntegers.coe_injective.eq_iff, algebraMap_smul_eq_apply, hγ, map_mul,
      IsScalarTower.algebraMap_apply (𝓞 K) K M, AlgEquiv.commutes, mul_right_inj' (by simpa)]
  -- Multiplying by the nonzero element `d` of `K_v` matches the `n`-th roots of `dⁿ b` and `b`.
  have hpow : (∃ x : v.adicCompletion K, x ^ n = algebraMap (𝓞 K) (v.adicCompletion K) c) ↔
      ∃ x : v.adicCompletion K, x ^ n = algebraMap K (v.adicCompletion K) b := by
    set D := algebraMap K (v.adicCompletion K) (algebraMap (𝓞 K) K d)
    have hD : D ≠ 0 := by
      rw [map_ne_zero, map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective (𝓞 K) K)]
      exact hd0
    rw [IsScalarTower.algebraMap_apply (𝓞 K) K (v.adicCompletion K), hcb, map_mul, map_pow]
    refine ⟨fun ⟨x, hx⟩ ↦ ⟨D⁻¹ * x, ?_⟩, fun ⟨x, hx⟩ ↦ ⟨D * x, by rw [mul_pow, hx]⟩⟩
    rw [mul_pow, hx, inv_pow, inv_mul_cancel_left₀ (pow_ne_zero _ hD)]
  have hζM : IsPrimitiveRoot (algebraMap (𝓞 K) (𝓞 M) ζ) n :=
    hζ.map_of_injective (FaithfulSMul.algebraMap_injective (𝓞 K) (𝓞 M))
  rw [hfix, hτ.smul_eq_self_iff hζM
      (fun h ↦ hn ((Ideal.mem_of_liesOver P v.asIdeal _).mpr (by simpa only [map_natCast] using h)))
      hγc (fun h ↦ hc ((Ideal.mem_of_liesOver P v.asIdeal _).mpr h)),
    ← P.over_def v.asIdeal, ← v.exists_pow_eq_adicCompletion_iff (K := K) hn hc]
  exact hpow

/-- **An `n`-th root of a unit at the Frobenius primes lies in the subfield they cut out exactly
at common local `n`-th powers.** Let `M/K` be Galois and `L` an intermediate field such that
`Gal(M/L)` is generated by arithmetic Frobenius elements `σ i` at primes above the finite places
`v i` of `K`. Let `ζ ∈ 𝓞 K` be a primitive `n`-th root of unity, and let `β ∈ M` be an `n`-th root
of an element `b ∈ K` that is a unit at every `v i`, with `n` outside every `v i`. Then `β ∈ L`
exactly when `b` is an `n`-th power in every completion `K_{v i}`. -/
theorem mem_intermediateField_iff_forall_exists_pow_eq_adicCompletion
    {v : ι → IsDedekindDomain.HeightOneSpectrum (𝓞 K)} [∀ i, (Q i).LiesOver (v i).asIdeal]
    (hσ : ∀ i, IsArithFrobAt (𝓞 K) (σ i) (Q i))
    (hL : L.fixingSubgroup = Subgroup.closure (Set.range σ)) (hζ : IsPrimitiveRoot ζ n)
    (hn : ∀ i, (n : 𝓞 K) ∉ (v i).asIdeal) {b : K} (hb : ∀ i, (v i).valuation K b = 1)
    {β : M} (hβ : β ^ n = algebraMap K M b) :
    β ∈ L ↔ ∀ i, ∃ x : (v i).adicCompletion K,
      x ^ n = algebraMap K ((v i).adicCompletion K) b := by
  -- `L` is the fixed field of `Gal(M/L)`, the subgroup generated by the `σ i`.
  conv_lhs => rw [← IsGalois.fixedField_fixingSubgroup L]
  rw [IntermediateField.mem_fixedField_iff, hL]
  refine ⟨fun h i ↦ ?_, fun h g hg ↦ ?_⟩
  · exact (apply_eq_self_iff_exists_pow_eq_adicCompletion (hσ i) hζ (hn i) (hb i) hβ).mp
      (h _ (Subgroup.subset_closure ⟨i, rfl⟩))
  · refine (Subgroup.closure_le (MulAction.stabilizer (M ≃ₐ[K] M) β)).mpr ?_ hg
    rintro _ ⟨i, rfl⟩
    exact (apply_eq_self_iff_exists_pow_eq_adicCompletion (hσ i) hζ (hn i) (hb i) hβ).mpr (h i)

/-- **Completion form of Milne's Lemma VII.6.3: local powers at the Frobenius primes detect
`n`-th powers in the subfield they cut out.** Let `M/K` be Galois and `L` an intermediate field
such that `Gal(M/L)` is generated by arithmetic Frobenius elements `σ i` at primes above the
finite places `v i` of `K`. Let `ζ ∈ 𝓞 K` be a primitive `n`-th root of unity, with `n` outside
every `v i`, and let `b ∈ K` have an `n`-th root in `M` and be a unit at every `v i`. Then `b` is
an `n`-th power in `L` exactly when it is an `n`-th power in each completion `K_{v i}`. This
applies to every `S`-unit `b` when the `v i` lie outside `S`. -/
theorem exists_mem_intermediateField_pow_eq_iff_forall_exists_pow_eq_adicCompletion
    {v : ι → IsDedekindDomain.HeightOneSpectrum (𝓞 K)} [∀ i, (Q i).LiesOver (v i).asIdeal]
    (hσ : ∀ i, IsArithFrobAt (𝓞 K) (σ i) (Q i))
    (hL : L.fixingSubgroup = Subgroup.closure (Set.range σ)) (hζ : IsPrimitiveRoot ζ n)
    (hn : ∀ i, (n : 𝓞 K) ∉ (v i).asIdeal) {b : K} (hb : ∀ i, (v i).valuation K b = 1)
    {β : M} (hβ : β ^ n = algebraMap K M b) :
    (∃ γ ∈ L, γ ^ n = algebraMap K M b) ↔
      ∀ i, ∃ x : (v i).adicCompletion K, x ^ n = algebraMap K ((v i).adicCompletion K) b := by
  rcases eq_or_ne n 0 with rfl | hn0
  · have hb1 : b = 1 := FaithfulSMul.algebraMap_injective K M (by simpa using hβ.symm)
    exact ⟨fun _ _ ↦ ⟨1, by simp [hb1]⟩, fun _ ↦ ⟨1, L.one_mem, by simp [hb1]⟩⟩
  have : NeZero n := ⟨hn0⟩
  rw [← mem_intermediateField_iff_forall_exists_pow_eq_adicCompletion hσ hL hζ hn hb hβ, ← hβ,
    L.exists_mem_pow_eq_pow_iff_mem
      (hζ.map_of_injective (FaithfulSMul.algebraMap_injective (𝓞 K) K))]

end TauCeti.NumberField
