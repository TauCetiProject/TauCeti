/-!
# Frobenius power criteria for local units

Let `M/K` be a Galois extension of number fields containing a primitive `n`-th root of unity
in `K`. An `n`-th root `α ∈ M` of `a ∈ K` is fixed by an arithmetic Frobenius above a finite
place `v` exactly when `a` is an `n`-th power in `K_v`, provided `n` avoids `v` and `a` is a
`v`-unit. Neither `a` nor `α` needs to be integral.

Consequently, if `Gal(M/L)` is generated by a family of these Frobenius elements, then `α`
lies in `L` exactly when `a` is a power in all their base-field completions. This applies to
`S`-units at places outside `S`, including `S`-units with denominators, and supplies the
criterion needed to identify the kernel of their map to the local power classes.

The argument clears a denominator separately at each place and uses the integral power
residue criterion `IsArithFrobAt.smul_eq_self_iff` and the Hensel comparison
`HeightOneSpectrum.exists_pow_eq_adicCompletion_iff`. Comparing different roots uses
`TauCeti.exists_eq_algebraMap_mul_of_pow_eq`.

## References

* J. S. Milne, *Class Field Theory*, v4.03, Chapter VII, Lemma 6.3 and proof of Lemma 6.9.
-/

public section

open NumberField IsDedekindDomain

namespace IsArithFrobAt

variable {K M : Type*} [Field K] [NumberField K] [Field M] [Algebra K M]

/-- A Frobenius fixes a radical of a local unit exactly when its radicand is a power in the
base-field completion. The radicand and its root may have denominators. -/
theorem apply_eq_self_iff_exists_pow_eq_adicCompletion
    {σ : M ≃ₐ[K] M} {Q : Ideal (𝓞 M)} [Q.IsPrime]
    {v : HeightOneSpectrum (𝓞 K)} [Q.LiesOver v.asIdeal]
    (hσ : IsArithFrobAt (𝓞 K) σ Q) {n : ℕ} {ζ : 𝓞 K} (hζ : IsPrimitiveRoot ζ n)
    (hn : (n : 𝓞 K) ∉ v.asIdeal) {a : K} {α : M}
    (ha : v.valuation K a = 1) (hα : α ^ n = algebraMap K M a) :
    σ α = α ↔ ∃ b : v.adicCompletion K, b ^ n = algebraMap K (v.adicCompletion K) a := by
  have hn0 : n ≠ 0 := by
    rintro rfl
    exact hn (by simp)
  obtain ⟨d, c, β, hd, hcunit, hc, hβ, hpow⟩ :=
    v.exists_integral_pow_eq_of_valuation_eq_one hn0 ha hα
  have hdK : algebraMap (𝓞 K) K d ≠ 0 := by
    intro h
    exact hd (by simp [(FaithfulSMul.algebraMap_eq_zero_iff (𝓞 K) K).mp h])
  have hres := hσ.smul_eq_self_iff
    (hζ.map_of_injective (FaithfulSMul.algebraMap_injective (𝓞 K) (𝓞 M)))
    (fun h ↦ hn ((Ideal.mem_of_liesOver Q v.asIdeal _).mpr (by simpa using h)))
    hpow (fun h ↦ hcunit ((Ideal.mem_of_liesOver Q v.asIdeal _).mpr h))
  have hfix : σ • β = β ↔ σ α = α := by
    rw [← RingOfIntegers.coe_injective.eq_iff,
      NumberField.algebraMap_smul_eq_apply, ← RingOfIntegers.coe_eq_algebraMap,
      hβ, map_mul,
      IsScalarTower.algebraMap_apply (𝓞 K) K M, AlgEquiv.commutes]
    exact ⟨mul_left_cancel₀ ((map_ne_zero (algebraMap K M)).mpr hdK),
      congrArg (fun x ↦ algebraMap K M (algebraMap (𝓞 K) K d) * x)⟩
  rw [hfix, ← Q.over_def v.asIdeal, ← v.exists_pow_eq_adicCompletion_iff (K := K) hn hcunit] at hres
  -- The residue comparison uses the completion's direct integer-ring algebra, whereas
  -- the scalar tower uses the induced one. Their named formulas identify both maps.
  have hlocal : σ α = α ↔ ∃ x : v.adicCompletion K,
      x ^ n = algebraMap K (v.adicCompletion K) (algebraMap (𝓞 K) K c) := by
    simpa only [HeightOneSpectrum.algebraMap_adicCompletion, Function.comp_apply,
      Algebra.algebraMap_self, RingHom.id_apply] using hres
  rw [hlocal, hc, map_mul, map_pow]
  -- Multiplication by the nonzero scalar `d` identifies the two sets of local roots.
  constructor
  · rintro ⟨x, hx⟩
    refine ⟨x / algebraMap (𝓞 K) (v.adicCompletion K) d, ?_⟩
    rw [div_pow, IsScalarTower.algebraMap_apply (𝓞 K) K (v.adicCompletion K), hx,
      mul_div_cancel_left₀ _ (pow_ne_zero _ ((map_ne_zero _).mpr hdK))]
  · rintro ⟨x, hx⟩
    refine ⟨algebraMap (𝓞 K) (v.adicCompletion K) d * x, ?_⟩
    rw [mul_pow, hx, IsScalarTower.algebraMap_apply (𝓞 K) K (v.adicCompletion K)]

end IsArithFrobAt

namespace TauCeti.NumberField

variable {K M : Type*} [Field K] [NumberField K] [Field M] [Algebra K M]
  [IsGalois K M] {L : IntermediateField K M} {ι : Type*} {σ : ι → M ≃ₐ[K] M}
  {Q : ι → Ideal (𝓞 M)} [∀ i, (Q i).IsPrime]
  {v : ι → HeightOneSpectrum (𝓞 K)} [∀ i, (Q i).LiesOver (v i).asIdeal]
  {n : ℕ} {ζ : 𝓞 K} {a : K} {α : M}

/-- A radical of a local unit lies in the subfield cut out by Frobenius elements exactly when
its radicand is a power in every corresponding completion. In particular this applies to
`S`-unit radicands at places outside `S`. -/
theorem mem_intermediateField_iff_forall_exists_pow_eq_adicCompletion
    (hσ : ∀ i, IsArithFrobAt (𝓞 K) (σ i) (Q i))
    (hL : L.fixingSubgroup = Subgroup.closure (Set.range σ)) (hζ : IsPrimitiveRoot ζ n)
    (hn : ∀ i, (n : 𝓞 K) ∉ (v i).asIdeal) (ha : ∀ i, (v i).valuation K a = 1)
    (hα : α ^ n = algebraMap K M a) :
    α ∈ L ↔ ∀ i, ∃ b : (v i).adicCompletion K,
      b ^ n = algebraMap K ((v i).adicCompletion K) a := by
  have hfix : α ∈ L ↔ ∀ i, σ i α = α := by
    conv_lhs => rw [← InfiniteGalois.fixedField_fixingSubgroup L]
    rw [IntermediateField.mem_fixedField_iff, hL]
    simpa only [AlgEquiv.smul_def, Set.forall_mem_range] using
      (TauCeti.forall_mem_closure_smul_eq_self_iff (s := Set.range σ) (x := α))
  rw [hfix]
  exact forall_congr' fun i ↦
    (hσ i).apply_eq_self_iff_exists_pow_eq_adicCompletion hζ (hn i) (ha i) hα

/-- Power classes in an intermediate field are detected by local powers at a family of
Frobenius generators, for radicands that are units at those places. -/
theorem exists_mem_intermediateField_pow_eq_iff_forall_exists_pow_eq_adicCompletion
    (hσ : ∀ i, IsArithFrobAt (𝓞 K) (σ i) (Q i))
    (hL : L.fixingSubgroup = Subgroup.closure (Set.range σ)) (hζ : IsPrimitiveRoot ζ n)
    (hn : ∀ i, (n : 𝓞 K) ∉ (v i).asIdeal) (ha : ∀ i, (v i).valuation K a = 1)
    (hα : α ^ n = algebraMap K M a) :
    (∃ β ∈ L, β ^ n = algebraMap K M a) ↔
      ∀ i, ∃ b : (v i).adicCompletion K,
        b ^ n = algebraMap K ((v i).adicCompletion K) a := by
  by_cases hn0 : n = 0
  · have ha1 : a = 1 := (algebraMap K M).injective (by simpa [hn0] using hα.symm)
    have hmem : ∃ β : M, β ∈ L := ⟨0, L.zero_mem⟩
    simpa [hn0, ha1] using hmem
  have : NeZero n := ⟨hn0⟩
  have : HasEnoughRootsOfUnity K n :=
    hasEnoughRootsOfUnity_of_isPrimitiveRoot
      (hζ.map_of_injective (FaithfulSMul.algebraMap_injective (𝓞 K) K))
  rw [L.exists_mem_pow_eq_iff_of_pow_eq hα]
  exact mem_intermediateField_iff_forall_exists_pow_eq_adicCompletion hσ hL hζ hn ha hα

end TauCeti.NumberField
