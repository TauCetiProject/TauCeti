module

public import Mathlib.RingTheory.Frobenius
public import Mathlib.NumberTheory.NumberField.Basic
import TauCeti.NumberTheory.NumberField.PrimeIdeal

/-!
# Iterated Frobenius congruences modulo a rational prime

Powers of an arithmetic Frobenius lift the corresponding iterates of residue-field Frobenius.
At an unramified rational prime the prime ideals above it intersect in the ideal generated by
that rational prime, so congruences at all those primes give a congruence modulo the rational
prime itself.
-/

public section

open scoped NumberField
open Ideal

namespace IsArithFrobAt

/-- The `n`th power of an arithmetic Frobenius acts on the quotient by raising to the `n`th
power of the base residue cardinality. -/
theorem quotient_mk_pow_smul {R S G : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [Monoid G] [MulSemiringAction G S] [SMulCommClass G R S] {Q : Ideal S} {σ : G}
    (hσ : IsArithFrobAt R σ Q) (n : ℕ) (x : S) :
    Ideal.Quotient.mk Q (σ ^ n • x) =
      (Ideal.Quotient.mk Q x) ^ (Nat.card (R ⧸ Q.under R) ^ n) := by
  induction n with
  | zero => simp
  | succ n ih =>
    have h := hσ.mk_apply (σ ^ n • x)
    rw [MulSemiringAction.toAlgHom_apply] at h
    rw [pow_succ', mul_smul, h, ih, ← pow_mul, pow_succ]

end IsArithFrobAt

namespace TauCeti.NumberField

open IsDedekindDomain

/-- At an unramified rational prime, an algebraic integer is divisible by `p` if and only if
it belongs to every prime above `p`. -/
theorem natCast_dvd_iff_forall_mem_primesOver {K : Type*} [Field K] [NumberField K]
    {p : ℕ} [Fact p.Prime]
    (hun : ∀ (Q : Ideal (𝓞 K)) [Q.IsPrime] [Q.LiesOver (span {(p : ℤ)})],
      Algebra.IsUnramifiedAt (𝓞 ℚ) Q) (x : 𝓞 K) :
    (p : 𝓞 K) ∣ x ↔ ∀ Q ∈ (span {(p : ℤ)}).primesOver (𝓞 K), x ∈ Q := by
  have hp0 : (span {(p : ℤ)} : Ideal ℤ) ≠ ⊥ := by
    simpa using (Fact.out : p.Prime).ne_zero
  have hmem {Q : Ideal (𝓞 K)} := mem_primesOverFinset_iff hp0 (𝓞 K) (P := Q)
  rw [← mem_span_singleton, span_natCast_eq_prod_primesOverFinset hun,
    prod_eq_iInf_of_pairwise_isCoprime (J := fun Q ↦ Q)]
  · simp only [mem_iInf, hmem]
  · intro I hI J hJ hne
    obtain ⟨hIp, hIo⟩ := hmem.mp hI
    obtain ⟨hJp, hJo⟩ := hmem.mp hJ
    have hI0 := ne_bot_of_liesOver_of_ne_bot hp0 I
    have hJ0 := ne_bot_of_liesOver_of_ne_bot hp0 J
    exact (HeightOneSpectrum.mk I hIp hI0).isCoprime_of_ne ⟨J, hJp, hJ0⟩
      (fun h ↦ hne (congrArg HeightOneSpectrum.asIdeal h))

end TauCeti.NumberField
