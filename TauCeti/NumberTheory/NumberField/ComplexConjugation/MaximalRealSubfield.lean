public import Mathlib.NumberTheory.NumberField.CMField
public import Mathlib.RingTheory.Norm.Defs
import TauCeti.FieldTheory.Minpoly.Invariant
import TauCeti.RingTheory.Norm.Quadratic

/-!
# Real elements of a CM field

Let `K` be a CM field with maximal real subfield `K⁺`. Mathlib defines `K⁺` by asking that an
element be real under *every* complex embedding (`NumberField.mem_maximalRealSubfield_iff`). Since
every complex embedding `φ` turns the complex conjugation `IsCMField.complexConj K` into complex
conjugation of `ℂ`, a single embedding already decides membership:
`x ∈ K⁺ ↔ star (φ x) = φ x`. The same holds for any abelian Galois extension `K` of `ℚ`, finite or
not: complex conjugation through one embedding `φ` is an automorphism of `K`, every other complex
embedding is `φ ∘ σ` for an automorphism `σ`, and `σ` commutes with that conjugation.

The same intertwining controls minimal polynomials. If `K` is a `ℂ`-subfield (`[Algebra K ℂ]`)
and `x` is a real complex number, then complex conjugation of `ℂ` fixes `x` and lies over
`complexConj K`, so the coefficients of `minpoly K x` are fixed by `complexConj K` and lie in `K⁺`.

If `K / F` is a CM extension, Mathlib identifies `F` with `K⁺`
(`NumberField.CMExtension.equivMaximalRealSubfield`); so `K⁺` is the image of `F` in `K`, and
under any complex embedding `φ` an element of `K` comes from `F` exactly when its image is real.
For an imaginary quadratic field `K⁺ = ℚ`, which is how a real algebraic integer generating an
extension of an imaginary quadratic field acquires a minimal polynomial with rational integer
coefficients in the class number one problem.

Since `K / K⁺` is quadratic with Galois group generated by `complexConj K`, the relative norm
`N_{K/K⁺}(x)` is `x * complexConj K x`; under any complex embedding `φ` it is `|φ x|²`.

In any number field, a root of unity in the maximal real subfield has absolute value `1` and is
real under a complex embedding, so it is `±1`; in particular a primitive `m`-th root of unity
with `m > 2` is not real. Conversely, for every root of unity `x` the element
`x + x⁻¹` is real, since `x⁻¹` is the complex conjugate of `x` under every complex embedding; over
a totally real base `k`, the whole field `k(x + x⁻¹)` is therefore real.

## Main results

* `NumberField.IsCMField.mem_maximalRealSubfield_iff_star_eq`: one complex embedding suffices to
  test membership in `K⁺`.
* `IsAbelianGalois.mem_maximalRealSubfield_iff_star_eq`: the same for an abelian Galois extension
  of `ℚ`.
* `NumberField.IsCMField.coeff_minpoly_mem_maximalRealSubfield`: the minimal polynomial over `K`
  of a real complex number has its coefficients in `K⁺`.
* `NumberField.IsCMField.algebraMap_norm_eq_mul_complexConj`: the norm from `K` to `K⁺` is
  `x * complexConj K x`, and `NumberField.IsCMField.complexEmbedding_algebraMap_norm`: under a
  complex embedding it is `φ x * star (φ x)`.
* `NumberField.comap_subtype_maximalRealSubfield`: if `K` is algebraic over a subfield `E`, the
  maximal real subfield of `E` is `E ∩ K⁺`.
* `NumberField.CMExtension.maximalRealSubfield_eq_fieldRange`: for a CM extension `K / F`, `K⁺`
  is the image of `F` in `K`.
* `NumberField.CMExtension.mem_range_algebraMap_iff_star_eq`: for a CM extension `K / F`, an
  element of `K` comes from `F` exactly when its image under a given complex embedding is real.
* `NumberField.CMExtension.minpoly_eq_map_minpoly_of_star_eq`: for a CM extension `K / F` inside
  `ℂ`, the minimal polynomial over `K` of a real complex number is its minimal polynomial over `F`.
* `NumberField.eq_one_or_eq_neg_one_of_pow_eq_one_of_mem_maximalRealSubfield`: in any number
  field, the roots of unity in the maximal real subfield are `±1`.
* `IsPrimitiveRoot.notMem_maximalRealSubfield`: in a number field, a primitive `m`-th root of
  unity with `m > 2` is not in the maximal real subfield.
* `NumberField.add_inv_mem_maximalRealSubfield_of_pow_eq_one`: for a root of unity `x`, the element
  `x + x⁻¹` lies in the maximal real subfield.
* `NumberField.toSubfield_adjoin_add_inv_le_maximalRealSubfield`: over a totally real base `k`,
  the field `k(x + x⁻¹)` generated by `x + x⁻¹` for a root of unity `x` is real.

## References

* H. M. Stark, *On the “gap” in a theorem of Heegner*, J. Number Theory 1 (1969), 16–27.
-/

public section

open Polynomial

namespace NumberField.IsCMField

variable {K : Type*} [Field K] [CharZero K] [IsCMField K] [Algebra.IsIntegral ℚ K]

/-- **One complex embedding detects the maximal real subfield of a CM field.** An element of a CM
field lies in its maximal real subfield as soon as it is real under one complex embedding. -/
theorem mem_maximalRealSubfield_iff_star_eq (φ : K →+* ℂ) (x : K) :
    x ∈ maximalRealSubfield K ↔ star (φ x) = φ x := by
  rw [← complexConj_eq_self_iff, ← φ.injective.eq_iff, complexEmbedding_complexConj,
    Complex.star_def]

/-- **Minimal polynomials of real numbers over a CM field are real.** For a CM field `K` embedded
in `ℂ` and a real complex number `x`, every coefficient of `minpoly K x` lies in the maximal real
subfield of `K`. -/
theorem coeff_minpoly_mem_maximalRealSubfield [Algebra K ℂ] {x : ℂ} (hx : star x = x) (n : ℕ) :
    (minpoly K x).coeff n ∈ maximalRealSubfield K := by
  have h := minpoly.map_eq_self (σ := (complexConj K : K →+* K)) (τ := starRingEnd ℂ)
    (RingHom.ext fun c ↦ complexEmbedding_complexConj K (algebraMap K ℂ) c) (by simpa using hx)
  rw [← complexConj_eq_self_iff]
  simpa using congrArg (AddMonoidAlgebra.coeff · n) h

/-- **The norm to the maximal real subfield.** For a CM field `K`, the relative norm from `K` to
`K⁺` of `x` is `x` times its complex conjugate. -/
theorem algebraMap_norm_eq_mul_complexConj (x : K) :
    algebraMap (maximalRealSubfield K) K (Algebra.norm (maximalRealSubfield K) x) =
      x * complexConj K x :=
  Algebra.IsQuadraticExtension.algebraMap_norm_eq_mul _ K (complexConj_ne_one K) x

/-- **The norm to the maximal real subfield is a squared absolute value.** Under every complex
embedding `φ` of a CM field `K`, the relative norm from `K` to `K⁺` of `x` becomes
`φ x * star (φ x)`. -/
theorem complexEmbedding_algebraMap_norm (φ : K →+* ℂ) (x : K) :
    φ (algebraMap (maximalRealSubfield K) K (Algebra.norm (maximalRealSubfield K) x)) =
      φ x * star (φ x) := by
  rw [algebraMap_norm_eq_mul_complexConj, map_mul, complexEmbedding_complexConj,
    Complex.star_def]

end NumberField.IsCMField

namespace IsAbelianGalois

open NumberField

variable {K : Type*} [Field K] [CharZero K] [IsAbelianGalois ℚ K]

/-- **One complex embedding detects the maximal real subfield of an abelian extension of `ℚ`.**
An element of an abelian Galois extension `K` of `ℚ`, such as a cyclotomic field, lies in its
maximal real subfield as soon as it is real under one complex embedding `φ`. Complex conjugation
through `φ` is an automorphism `c` of `K`; any other complex embedding is `φ ∘ σ` for an
automorphism `σ`, and `σ` commutes with `c`. -/
theorem mem_maximalRealSubfield_iff_star_eq (φ : K →+* ℂ) (x : K) :
    x ∈ maximalRealSubfield K ↔ star (φ x) = φ x := by
  rw [mem_maximalRealSubfield_iff]
  refine ⟨fun hx ↦ hx φ, fun hx ψ ↦ ?_⟩
  obtain ⟨c, hc⟩ := ComplexEmbedding.exists_comp_symm_eq_of_comp_eq (k := ℚ) φ
    ((starRingEnd ℂ).comp φ) (Subsingleton.elim _ _)
  obtain ⟨σ, rfl⟩ :=
    ComplexEmbedding.exists_comp_symm_eq_of_comp_eq (k := ℚ) φ ψ (Subsingleton.elim _ _)
  have hconj (y : K) : φ (c.symm y) = star (φ y) := by
    simpa only [RingHom.comp_apply, RingHom.coe_coe, starRingEnd_apply] using congr($hc y)
  have hcomm : c.symm (σ.symm x) = σ.symm (c.symm x) := by
    simpa only [AlgEquiv.mul_apply] using congr($(mul_comm' c.symm σ.symm) x)
  simp only [RingHom.comp_apply, RingHom.coe_coe]
  rw [← hconj, hcomm, φ.injective ((hconj x).trans hx)]

end IsAbelianGalois

namespace NumberField

/-- **The maximal real subfield of a subfield over which `K` is algebraic.** If `K` is algebraic
over a subfield `E`, the maximal real subfield of `E` consists of the elements of `E` lying in
`K⁺`: every complex embedding of `E` extends to one of `K`. -/
theorem comap_subtype_maximalRealSubfield {K : Type*} [Field K] (E : Subfield K)
    [Algebra.IsAlgebraic E K] :
    (maximalRealSubfield K).comap E.subtype = maximalRealSubfield E := by
  ext x
  rw [Subfield.mem_comap, mem_maximalRealSubfield_iff, mem_maximalRealSubfield_iff]
  refine ⟨fun h ψ ↦ ?_, fun h φ ↦ by simpa only [RingHom.comp_apply] using h (φ.comp E.subtype)⟩
  rw [← ComplexEmbedding.lift_algebraMap_apply K ψ x]
  exact h (ComplexEmbedding.lift K ψ)

end NumberField

namespace NumberField.CMExtension

variable (F K : Type*) [Field F] [IsTotallyReal F] [Field K] [CharZero K] [Algebra.IsIntegral ℚ K]
  [IsTotallyComplex K] [Algebra F K] [Algebra.IsQuadraticExtension F K]

/-- **The maximal real subfield of a CM extension is the base field.** If `K / F` is a CM
extension, the maximal real subfield of `K` is the image of `F`; this is the set-level form of
Mathlib's `NumberField.CMExtension.equivMaximalRealSubfield`. -/
theorem maximalRealSubfield_eq_fieldRange :
    maximalRealSubfield K = (algebraMap F K).fieldRange := by
  refine le_antisymm (fun x hx ↦ ⟨_,
    algebraMap_equivMaximalRealSubfield_symm_apply F K ⟨x, hx⟩⟩) ?_
  rintro _ ⟨q, rfl⟩
  exact (equivMaximalRealSubfield F K q).prop

variable {K} in
/-- **One complex embedding detects the base field of a CM extension.** If `K / F` is a CM
extension, an element of `K` comes from `F` exactly when its image under a given complex embedding
is real. -/
theorem mem_range_algebraMap_iff_star_eq (φ : K →+* ℂ) (x : K) :
    x ∈ Set.range (algebraMap F K) ↔ star (φ x) = φ x := by
  have := IsCMField.ofCMExtension F K
  rw [← IsCMField.mem_maximalRealSubfield_iff_star_eq, maximalRealSubfield_eq_fieldRange F K,
    RingHom.mem_fieldRange, Set.mem_range]

variable {F K} in
/-- **Minimal polynomials of real numbers over a CM extension.** If `K / F` is a CM extension with
`F ⊆ K ⊆ ℂ` and `x` is a real complex number, the minimal polynomial of `x` over `K` is its
minimal polynomial over `F`. -/
theorem minpoly_eq_map_minpoly_of_star_eq [Algebra F ℂ] [Algebra K ℂ] [IsScalarTower F K ℂ]
    {x : ℂ} (hx : star x = x) : minpoly K x = (minpoly F x).map (algebraMap F K) := by
  have := IsCMField.ofCMExtension F K
  by_cases hint : IsIntegral F x
  · refine (minpoly.map_algebraMap hint ((lifts_iff_coeff_lifts _).mpr fun n ↦ ?_)).symm
    have := IsCMField.coeff_minpoly_mem_maximalRealSubfield (K := K) hx n
    rwa [maximalRealSubfield_eq_fieldRange F K, RingHom.mem_fieldRange, ← Set.mem_range] at this
  · rw [minpoly.eq_zero hint, Polynomial.map_zero,
      minpoly.eq_zero fun h ↦ hint (isIntegral_trans (R := F) x h)]

end NumberField.CMExtension

namespace NumberField

/-- **The real roots of unity are `±1`.** In a number field `K`, a root of unity lying in the
maximal real subfield is `1` or `-1`: under a complex embedding it has absolute value `1` and is
real. -/
theorem eq_one_or_eq_neg_one_of_pow_eq_one_of_mem_maximalRealSubfield {K : Type*} [Field K]
    [NumberField K] {x : K} {n : ℕ} (hn : n ≠ 0) (hx : x ^ n = 1)
    (hreal : x ∈ maximalRealSubfield K) : x = 1 ∨ x = -1 := by
  let φ : K →+* ℂ := Classical.choice inferInstance
  have hφ : φ x ^ n = 1 := by rw [← map_pow, hx, map_one]
  have hinv : (φ x)⁻¹ = φ x := by
    rw [Complex.inv_eq_conj (Complex.norm_eq_one_of_pow_eq_one hφ hn), ← Complex.star_def,
      (mem_maximalRealSubfield_iff x).1 hreal φ]
  have hφ0 : φ x ≠ 0 := fun h ↦ zero_ne_one (by rwa [h, zero_pow hn] at hφ)
  refine mul_self_eq_one_iff.1 (φ.injective ?_)
  calc φ (x * x) = (φ x)⁻¹ * φ x := by rw [map_mul, hinv]
    _ = φ 1 := by rw [inv_mul_cancel₀ hφ0, map_one]

/-- **A primitive root of unity of order `m > 2` is not real.** In a number field, a primitive
`m`-th root of unity with `m > 2` does not lie in the maximal real subfield, since the real roots
of unity are `±1`. -/
theorem _root_.IsPrimitiveRoot.notMem_maximalRealSubfield {K : Type*} [Field K] [NumberField K]
    {η : K} {m : ℕ} (hη : IsPrimitiveRoot η m) (hm : 2 < m) : η ∉ maximalRealSubfield K := by
  intro h
  obtain rfl | rfl :=
    eq_one_or_eq_neg_one_of_pow_eq_one_of_mem_maximalRealSubfield (by omega) hη.pow_eq_one h
  · have := hη.unique IsPrimitiveRoot.one
    omega
  · have := hη.unique (IsPrimitiveRoot.neg_one 0 (by decide))
    omega

/-- **`x + x⁻¹` is real for a root of unity `x`.** In any field `K`, if `x ^ n = 1` with `n ≠ 0`,
then `x + x⁻¹` lies in the maximal real subfield: under every complex embedding `x` has absolute
value `1`, so `x⁻¹` maps to the complex conjugate of the image of `x`. -/
theorem add_inv_mem_maximalRealSubfield_of_pow_eq_one {K : Type*} [Field K] {x : K} {n : ℕ}
    (hn : n ≠ 0) (hx : x ^ n = 1) : x + x⁻¹ ∈ maximalRealSubfield K := by
  intro φ
  have hφ : φ x ^ n = 1 := by rw [← map_pow, hx, map_one]
  rw [map_add, map_inv₀, Complex.inv_eq_conj (Complex.norm_eq_one_of_pow_eq_one hφ hn),
    ← Complex.star_def, star_add, star_star, add_comm]

/-- **`k(x + x⁻¹)` is real over a totally real base.** If `K` is an extension of a totally real
field `k` and `x ∈ K` is a root of unity, the field `k(x + x⁻¹)` lies in the maximal real subfield
of `K`: the image of `k` is totally real, and `x + x⁻¹` is real. -/
theorem toSubfield_adjoin_add_inv_le_maximalRealSubfield {k K : Type*} [Field k]
    [IsTotallyReal k] [Field K] [Algebra k K] {x : K} {n : ℕ} (hn : n ≠ 0) (hx : x ^ n = 1) :
    (IntermediateField.adjoin k {x + x⁻¹}).toSubfield ≤ maximalRealSubfield K := by
  have : IsTotallyReal (algebraMap k K).fieldRange :=
    .ofRingEquiv (algebraMap k K).rangeRestrictFieldEquiv
  have hk := IsTotallyReal.le_maximalRealSubfield (algebraMap k K).fieldRange
  rw [IntermediateField.adjoin_toSubfield, Subfield.closure_le, Set.union_subset_iff,
    Set.range_subset_iff, Set.singleton_subset_iff]
  exact ⟨fun c ↦ hk (RingHom.mem_fieldRange_self _ c),
    add_inv_mem_maximalRealSubfield_of_pow_eq_one hn hx⟩

end NumberField
