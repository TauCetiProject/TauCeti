/-!
# The largest totally real or CM subfield

Every field `K` algebraic over `ℚ` has a largest subfield `E_K` that is totally real or CM,
`TauCeti.NumberField.maximalRealOrCMSubfield K`. It contains Mathlib's maximal real subfield
`K⁺ = NumberField.maximalRealSubfield K`, and it is CM exactly when `K` has a CM subfield (and then
it is the maximal CM subfield of `K`). It is an algebra over `K⁺` through the inclusion, and
`[E_K : K⁺] ≤ 2`.

The construction uses a normal extension `Ω` of `ℚ` containing a copy of `K`, such as an algebraic
closure of `ℚ`, and its complex conjugations. Let `H` be
the subgroup `cmSubgroup Ω` of `Gal(Ω/ℚ)` generated by the products `c₁ c₂` of two complex
conjugations. For any embedding `τ : K →+* Ω`, the field `E_K` is the preimage under `τ` of the
fixed field of `H`; by Milne's criterion
(`TauCeti.NumberField.isTotallyReal_or_isCMField_iff`) this preimage is the largest subfield of
`K` that is totally real or CM. For a number field `K`, two embeddings of `K` into `Ω` agree on
`E_K` exactly when they differ by an element of `H`, or equivalently of its closure.

The last section proves the Artin–Weil factorization. For a number field `K`, a function `m` on
embeddings `K →+* Ω` with `m(c ∘ τ) + m(τ) = w` for every complex conjugation `c` depends only
on the restriction of `τ` to `E_K`, and satisfies `2 • m(τ) = w` when `K` has no CM subfield.

## Main definitions

* `TauCeti.NumberField.maximalRealOrCMSubfield K`: the largest totally real or CM subfield, and
  `TauCeti.NumberField.maximalRealOrCMIntermediateField K`: the same field as an intermediate
  field over `ℚ`.
* `TauCeti.NumberField.cmSubgroup Ω`: the subgroup of `Gal(Ω/ℚ)` generated by products of two
  complex conjugations.

## Main results

* `TauCeti.NumberField.maximalRealOrCMSubfield_eq_comap` and
  `TauCeti.NumberField.maximalRealOrCMIntermediateField_eq_comap`: `E_K` is the preimage of the
  fixed field of `cmSubgroup Ω`.
* `TauCeti.NumberField.mem_maximalRealOrCMSubfield_iff`: the description of `E_K` through the
  complex conjugations of `Ω`.
* `TauCeti.NumberField.le_maximalRealOrCMSubfield_iff`: a subfield lies in `E_K` if and only if
  it is totally real or CM.
* `TauCeti.NumberField.isCMField_maximalRealOrCMSubfield_iff_exists` and
  `TauCeti.NumberField.isCMField_maximalRealOrCMSubfield_iff_ne_maximalRealSubfield`: `E_K` is CM
  if and only if `K`
  has a CM subfield, if and only if `E_K ≠ K⁺`.
* `TauCeti.NumberField.map_maximalRealSubfield_maximalRealOrCMSubfield`: the maximal real
  subfield of `E_K` is `K⁺`, and
  `TauCeti.NumberField.finrank_maximalRealSubfield_maximalRealOrCMSubfield_eq_one_or_eq_two`:
  `[E_K : K⁺]` is `1` or `2`, so
  (`TauCeti.NumberField.finrank_maximalRealOrCMSubfield_eq_or_eq_two_mul`) `[E_K : ℚ]` is
  `[K⁺ : ℚ]` or `2 [K⁺ : ℚ]`.
* `TauCeti.NumberField.maximalRealOrCMSubfield_eq_top_iff`: `E_K = K` if and only if `K` is
  totally real or CM, and
  `TauCeti.NumberField.maximalRealOrCMSubfield_eq_maximalRealSubfield_of_odd`: `E_K = K⁺` in odd
  degree.
* `TauCeti.NumberField.map_maximalRealOrCMSubfield`: `E_K` is preserved by isomorphisms of fields
  algebraic over `ℚ`.
* `TauCeti.NumberField.exists_mem_topologicalClosure_cmSubgroup_iff_eqOn_maximalRealOrCMSubfield`:
  two embeddings agree on `E_K` if and only if they differ by an element of the closure of
  `cmSubgroup Ω`, and
  `TauCeti.NumberField.exists_mem_cmSubgroup_iff_eqOn_maximalRealOrCMSubfield`: for a number field
  the closure is not needed.
* `TauCeti.NumberField.apply_eq_apply_of_eqOn_maximalRealOrCMSubfield` and
  `TauCeti.NumberField.two_nsmul_eq_of_forall_not_isCMField`: the Artin–Weil factorization.

## References

* J. S. Milne, *Complex Multiplication*, Chapter I, Corollary 1.5, Remark 1.7 and the proof of
  Proposition 4.9.
* B. Lawrence and A. Venkatesh, *Diophantine problems and p-adic period mappings*, §2.4,
  Definition 2.7 and the proof of Lemma 2.8.
-/

public section

open NumberField NumberField.InfinitePlace NumberField.ComplexEmbedding IntermediateField
open scoped Pointwise

namespace TauCeti.NumberField

section cmSubgroup

variable (Ω : Type*) [Field Ω] [CharZero Ω]

/-- The subgroup of `Gal(Ω/ℚ)` generated by the products `c₁ c₂` of two complex conjugations.
For `Ω` normal over `ℚ` and an embedding `τ : K →+* Ω`, it fixes `τ x` exactly when
`x` lies in the largest totally real or CM subfield of `K`
(`mem_maximalRealOrCMSubfield_iff_forall_mem_cmSubgroup`). -/
def cmSubgroup : Subgroup Gal(Ω/ℚ) :=
  Subgroup.closure (complexConjugations Ω * complexConjugations Ω)

/-- `cmSubgroup Ω` is normal, since the set of complex conjugations is stable under
conjugation. -/
instance cmSubgroup_normal : (cmSubgroup Ω).Normal := by
  refine Subgroup.closure_normal_of_forall_conj_mem ?_
  rintro g _ ⟨c₁, hc₁, c₂, hc₂, rfl⟩
  exact ⟨_, mul_mul_inv_mem_complexConjugations hc₁ g, _,
    mul_mul_inv_mem_complexConjugations hc₂ g, by group⟩

/-- `cmSubgroup Ω` is the subgroup generated by the products of two complex conjugations. -/
theorem cmSubgroup_def :
    cmSubgroup Ω = Subgroup.closure (complexConjugations Ω * complexConjugations Ω) := by
  rw [cmSubgroup]

variable {Ω}

/-- A product of two complex conjugations lies in `cmSubgroup Ω`. -/
theorem mul_mem_cmSubgroup {c₁ c₂ : Gal(Ω/ℚ)} (hc₁ : c₁ ∈ complexConjugations Ω)
    (hc₂ : c₂ ∈ complexConjugations Ω) : c₁ * c₂ ∈ cmSubgroup Ω :=
  Subgroup.subset_closure ⟨c₁, hc₁, c₂, hc₂, rfl⟩

/-- `cmSubgroup Ω` lies in a subgroup `P` if and only if `P` contains every product of two
complex conjugations. -/
theorem cmSubgroup_le_iff {P : Subgroup Gal(Ω/ℚ)} :
    cmSubgroup Ω ≤ P ↔
      ∀ c₁ ∈ complexConjugations Ω, ∀ c₂ ∈ complexConjugations Ω, c₁ * c₂ ∈ P := by
  rw [cmSubgroup, Subgroup.closure_le, Set.mul_subset_iff]
  simp only [SetLike.mem_coe]

/-- An element of `Ω` is fixed by `cmSubgroup Ω` if and only if every product of two complex
conjugations fixes it. -/
theorem mem_fixedField_cmSubgroup_iff {y : Ω} :
    y ∈ fixedField (cmSubgroup Ω) ↔
      ∀ c₁ ∈ complexConjugations Ω, ∀ c₂ ∈ complexConjugations Ω, c₁ (c₂ y) = y := by
  refine ⟨fun h c₁ hc₁ c₂ hc₂ ↦ (mem_fixedField_iff _ _).mp h _ (mul_mem_cmSubgroup hc₁ hc₂),
    fun h ↦ ?_⟩
  rw [mem_fixedField_iff]
  intro g hg
  rw [← AlgEquiv.smul_def, ← MulAction.mem_stabilizer_iff]
  refine cmSubgroup_le_iff.mpr (fun c₁ hc₁ c₂ hc₂ ↦ ?_) hg
  rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def, AlgEquiv.mul_apply]
  exact h c₁ hc₁ c₂ hc₂

end cmSubgroup

section Def

variable (K : Type*) [Field K] [CharZero K]

/-- The **largest totally real or CM subfield** `E_K` of `K`: the supremum of the subfields of
`K` that are totally real or CM. For `K` algebraic over `ℚ` it is itself totally real or CM
(`isTotallyReal_or_isCMField_maximalRealOrCMSubfield`); it is CM exactly when `K` has a CM
subfield, and is then the maximal CM subfield of `K`. -/
def maximalRealOrCMSubfield : Subfield K :=
  sSup {F : Subfield K | IsTotallyReal F ∨ IsCMField F}

/-- `E_K` as an intermediate field of `K` over `ℚ`, the form used by the Galois correspondence. -/
def maximalRealOrCMIntermediateField : IntermediateField ℚ K :=
  (maximalRealOrCMSubfield K).toIntermediateField fun x ↦ by
    rw [eq_ratCast]
    exact SubfieldClass.ratCast_mem _ x

/-- `E_K` is the supremum of the subfields of `K` that are totally real or CM. -/
theorem maximalRealOrCMSubfield_def :
    maximalRealOrCMSubfield K = sSup {F : Subfield K | IsTotallyReal F ∨ IsCMField F} := by
  rw [maximalRealOrCMSubfield]

variable {K} in
/-- Membership in `maximalRealOrCMIntermediateField K` is membership in `E_K`. -/
@[simp]
theorem mem_maximalRealOrCMIntermediateField {x : K} :
    x ∈ maximalRealOrCMIntermediateField K ↔ x ∈ maximalRealOrCMSubfield K :=
  Iff.rfl

/-- The subfield underlying `maximalRealOrCMIntermediateField K` is `E_K`. -/
@[simp]
theorem toSubfield_maximalRealOrCMIntermediateField :
    (maximalRealOrCMIntermediateField K).toSubfield = maximalRealOrCMSubfield K := by
  rw [maximalRealOrCMIntermediateField, Subfield.toIntermediateField_toSubfield]

end Def

variable {K : Type*} [Field K]

section Algebraic

variable [CharZero K] [Algebra.IsIntegral ℚ K]

section Embedding

variable {Ω : Type*} [Field Ω] [CharZero Ω] [Normal ℚ Ω]

omit [Algebra.IsIntegral ℚ K] in
/-- A subfield of `K` lies in the preimage under `τ` of the fixed field of `cmSubgroup Ω` if and
only if it is totally real or CM. -/
private theorem le_comap_iff (τ : K →+* Ω) (F : Subfield K) :
    F ≤ (fixedField (cmSubgroup Ω)).toSubfield.comap τ ↔ IsTotallyReal F ∨ IsCMField F := by
  rw [isTotallyReal_or_isCMField_iff (τ.comp F.subtype)]
  simp only [RingHom.comp_apply, Subfield.subtype_apply, Subtype.forall]
  refine ⟨fun h c₁ hc₁ c₂ hc₂ x hx ↦ ?_, fun h x hx ↦ ?_⟩
  · have hx := h hx
    rw [Subfield.mem_comap, IntermediateField.mem_toSubfield, mem_fixedField_cmSubgroup_iff] at hx
    exact hx c₁ hc₁ c₂ hc₂
  · rw [Subfield.mem_comap, IntermediateField.mem_toSubfield, mem_fixedField_cmSubgroup_iff]
    exact fun c₁ hc₁ c₂ hc₂ ↦ h c₁ hc₁ c₂ hc₂ x hx

omit [Algebra.IsIntegral ℚ K] in
/-- **`E_K` through an embedding into a normal extension of `ℚ`.** For any embedding
`τ : K →+* Ω`, the field `E_K` is the preimage under `τ` of the fixed field of `cmSubgroup Ω`. -/
theorem maximalRealOrCMSubfield_eq_comap (τ : K →+* Ω) :
    maximalRealOrCMSubfield K = (fixedField (cmSubgroup Ω)).toSubfield.comap τ :=
  le_antisymm (sSup_le fun F hF ↦ (le_comap_iff τ F).mpr hF)
    (le_sSup ((le_comap_iff τ _).mp le_rfl))

omit [Algebra.IsIntegral ℚ K] in
/-- `E_K` as an intermediate field is the preimage under `τ` of the fixed field of
`cmSubgroup Ω`. -/
theorem maximalRealOrCMIntermediateField_eq_comap (τ : K →+* Ω) :
    maximalRealOrCMIntermediateField K = (fixedField (cmSubgroup Ω)).comap τ.toRatAlgHom := by
  ext x
  rw [IntermediateField.mem_comap, mem_maximalRealOrCMIntermediateField,
    maximalRealOrCMSubfield_eq_comap τ, Subfield.mem_comap, RingHom.toRatAlgHom_apply,
    IntermediateField.mem_toSubfield]

omit [Algebra.IsIntegral ℚ K] in
/-- **Membership in `E_K`.** An element `x` of `K` lies in `E_K` if and only if every product of
two complex conjugations of `Ω` fixes `τ x`. -/
theorem mem_maximalRealOrCMSubfield_iff (τ : K →+* Ω) {x : K} :
    x ∈ maximalRealOrCMSubfield K ↔
      ∀ c₁ ∈ complexConjugations Ω, ∀ c₂ ∈ complexConjugations Ω, c₁ (c₂ (τ x)) = τ x := by
  rw [maximalRealOrCMSubfield_eq_comap τ, Subfield.mem_comap]
  exact mem_fixedField_cmSubgroup_iff

omit [Algebra.IsIntegral ℚ K] in
/-- An element `x` of `K` lies in `E_K` if and only if `cmSubgroup Ω` fixes `τ x`. -/
theorem mem_maximalRealOrCMSubfield_iff_forall_mem_cmSubgroup (τ : K →+* Ω) {x : K} :
    x ∈ maximalRealOrCMSubfield K ↔ ∀ h ∈ cmSubgroup Ω, h (τ x) = τ x := by
  rw [maximalRealOrCMSubfield_eq_comap τ, Subfield.mem_comap]
  exact mem_fixedField_iff _ _

end Embedding

/-- A fixed embedding of `K` into `AlgebraicClosure ℚ`, used to state results about `E_K` that do
not mention an algebraic closure. -/
private noncomputable def toAlgebraicClosure (K : Type*) [Field K] [CharZero K]
    [Algebra.IsIntegral ℚ K] : K →+* AlgebraicClosure ℚ :=
  (IsAlgClosed.lift : K →ₐ[ℚ] AlgebraicClosure ℚ).toRingHom

/-- A subfield of `K` lies in `E_K` if and only if it is totally real or CM. -/
theorem le_maximalRealOrCMSubfield_iff {F : Subfield K} :
    F ≤ maximalRealOrCMSubfield K ↔ IsTotallyReal F ∨ IsCMField F := by
  rw [maximalRealOrCMSubfield_eq_comap (toAlgebraicClosure K)]
  exact le_comap_iff _ F

variable (K) in
/-- `E_K` is totally real or CM. -/
theorem isTotallyReal_or_isCMField_maximalRealOrCMSubfield :
    IsTotallyReal (maximalRealOrCMSubfield K) ∨ IsCMField (maximalRealOrCMSubfield K) :=
  le_maximalRealOrCMSubfield_iff.mp le_rfl

variable (K) in
/-- The maximal real subfield `K⁺` lies in `E_K`. -/
theorem maximalRealSubfield_le_maximalRealOrCMSubfield :
    maximalRealSubfield K ≤ maximalRealOrCMSubfield K :=
  le_maximalRealOrCMSubfield_iff.mpr (.inl inferInstance)

/-- `E_K` is all of `K` if and only if `K` is totally real or CM. -/
theorem maximalRealOrCMSubfield_eq_top_iff :
    maximalRealOrCMSubfield K = ⊤ ↔ IsTotallyReal K ∨ IsCMField K := by
  rw [eq_top_iff, isTotallyReal_or_isCMField_iff (toAlgebraicClosure K)]
  exact ⟨fun h c₁ hc₁ c₂ hc₂ x ↦
      (mem_maximalRealOrCMSubfield_iff _).mp (h trivial) c₁ hc₁ c₂ hc₂,
    fun h x _ ↦ (mem_maximalRealOrCMSubfield_iff _).mpr fun c₁ hc₁ c₂ hc₂ ↦ h c₁ hc₁ c₂ hc₂ x⟩

/-- A CM field is its own largest totally real or CM subfield. -/
@[simp]
theorem maximalRealOrCMSubfield_eq_top_of_isCMField [IsCMField K] : maximalRealOrCMSubfield K = ⊤ :=
  maximalRealOrCMSubfield_eq_top_iff.mpr (.inr ‹_›)

omit [Algebra.IsIntegral ℚ K] in
/-- A totally real field is its own largest totally real or CM subfield. -/
@[simp]
theorem maximalRealOrCMSubfield_eq_top_of_isTotallyReal [IsTotallyReal K] :
    maximalRealOrCMSubfield K = ⊤ :=
  top_unique (le_sSup (.inl (isTotallyReal_top_iff.mpr ‹_›)))

/-- **`E_K` is CM if and only if `K` has a CM subfield.** -/
theorem isCMField_maximalRealOrCMSubfield_iff_exists :
    IsCMField (maximalRealOrCMSubfield K) ↔ ∃ F : Subfield K, IsCMField F := by
  refine ⟨fun h ↦ ⟨_, h⟩, fun ⟨F, hF⟩ ↦ ?_⟩
  refine (isTotallyReal_or_isCMField_maximalRealOrCMSubfield K).resolve_left fun hE ↦ ?_
  refine IsTotallyComplex.not_isTotallyReal (K := F)
    (isTotallyReal_iff_le_maximalRealSubfield.mpr ?_)
  exact (le_maximalRealOrCMSubfield_iff.mpr (.inr hF)).trans
    (isTotallyReal_iff_le_maximalRealSubfield.mp hE)

/-- **`E_K` is CM if and only if it is not `K⁺`.** -/
theorem isCMField_maximalRealOrCMSubfield_iff_ne_maximalRealSubfield :
    IsCMField (maximalRealOrCMSubfield K) ↔ maximalRealOrCMSubfield K ≠ maximalRealSubfield K := by
  refine ⟨fun h heq ↦ ?_, fun hne ↦ ?_⟩
  · refine IsTotallyComplex.not_isTotallyReal (K := maximalRealOrCMSubfield K) ?_
    rw [heq]
    infer_instance
  · refine (isTotallyReal_or_isCMField_maximalRealOrCMSubfield K).resolve_left fun hE ↦ hne ?_
    exact le_antisymm (isTotallyReal_iff_le_maximalRealSubfield.mp hE)
      (maximalRealSubfield_le_maximalRealOrCMSubfield K)

/-- **The maximal real subfield of `E_K` is `K⁺`**, by `comap_subtype_maximalRealSubfield` and
`maximalRealSubfield_le_maximalRealOrCMSubfield`. -/
theorem map_maximalRealSubfield_maximalRealOrCMSubfield :
    (maximalRealSubfield (maximalRealOrCMSubfield K)).map (maximalRealOrCMSubfield K).subtype =
      maximalRealSubfield K := by
  have : Algebra.IsAlgebraic (maximalRealOrCMSubfield K) K :=
    Algebra.IsAlgebraic.tower_top (K := ℚ) _
  rw [← comap_subtype_maximalRealSubfield, Subfield.map_comap_subtype,
    inf_eq_right.mpr (maximalRealSubfield_le_maximalRealOrCMSubfield K)]

variable (K) in
/-- `E_K` is an algebra over `K⁺` through the inclusion
`maximalRealSubfield_le_maximalRealOrCMSubfield`. -/
instance algebraMaximalRealSubfieldMaximalRealOrCMSubfield :
    Algebra (maximalRealSubfield K) (maximalRealOrCMSubfield K) :=
  (Subfield.inclusion (maximalRealSubfield_le_maximalRealOrCMSubfield K)).toAlgebra

/-- The algebra map `K⁺ → E_K` is the inclusion. -/
@[simp]
theorem coe_algebraMap_maximalRealSubfield_maximalRealOrCMSubfield
    (x : maximalRealSubfield K) :
    (algebraMap (maximalRealSubfield K) (maximalRealOrCMSubfield K) x : K) = x :=
  rfl

variable (K) in
/-- The inclusions `K⁺ ≤ E_K ≤ K` form a scalar tower. -/
instance isScalarTower_maximalRealSubfield_maximalRealOrCMSubfield :
    IsScalarTower (maximalRealSubfield K) (maximalRealOrCMSubfield K) K :=
  .of_algebraMap_eq fun x ↦ by
    rw [Algebra.algebraMap_ofSubsemiring_apply,
      Algebra.algebraMap_ofSubsemiring_apply,
      coe_algebraMap_maximalRealSubfield_maximalRealOrCMSubfield]

/-- The image of `K⁺` in `E_K` is the maximal real subfield of `E_K`. -/
private theorem fieldRange_algebraMap_maximalRealSubfield :
    (algebraMap (maximalRealSubfield K) (maximalRealOrCMSubfield K)).fieldRange =
      maximalRealSubfield (maximalRealOrCMSubfield K) := by
  have h : (maximalRealOrCMSubfield K).subtype.comp
      (algebraMap (maximalRealSubfield K) (maximalRealOrCMSubfield K)) =
      (maximalRealSubfield K).subtype :=
    RingHom.ext coe_algebraMap_maximalRealSubfield_maximalRealOrCMSubfield
  apply Subfield.map_injective (maximalRealOrCMSubfield K).subtype
  rw [RingHom.map_fieldRange, h, Subfield.fieldRange_subtype,
    map_maximalRealSubfield_maximalRealOrCMSubfield]

/-- **`[E_K : K⁺]` is `1` or `2`**, for the algebra structure given by the inclusion
`K⁺ ≤ E_K`: `E_K` is `K⁺` if it is totally real, and a quadratic extension of its maximal real
subfield, which is `K⁺` (`map_maximalRealSubfield_maximalRealOrCMSubfield`), if it is CM. -/
theorem finrank_maximalRealSubfield_maximalRealOrCMSubfield_eq_one_or_eq_two :
    Module.finrank (maximalRealSubfield K) (maximalRealOrCMSubfield K) = 1 ∨
      Module.finrank (maximalRealSubfield K) (maximalRealOrCMSubfield K) = 2 := by
  set E := maximalRealOrCMSubfield K
  rcases isTotallyReal_or_isCMField_maximalRealOrCMSubfield K with hE | hE
  · -- `E_K = K⁺`, so the algebra map is bijective.
    have hsurj : Function.Surjective (algebraMap (maximalRealSubfield K) E) := fun y ↦
      ⟨⟨y, isTotallyReal_iff_le_maximalRealSubfield.mp hE y.property⟩,
        Subtype.ext (coe_algebraMap_maximalRealSubfield_maximalRealOrCMSubfield _)⟩
    exact .inl (Algebra.finrank_eq_one_iff_bijective_algebraMap.mpr
      ⟨(algebraMap (maximalRealSubfield K) E).injective, hsurj⟩)
  · -- `K⁺` is identified with the maximal real subfield of `E_K`, over which `E_K` is quadratic.
    let i : maximalRealSubfield K ≃+* maximalRealSubfield E :=
      (algebraMap (maximalRealSubfield K) E).rangeRestrictFieldEquiv.trans
        (RingEquiv.subfieldCongr fieldRange_algebraMap_maximalRealSubfield)
    have hc : (algebraMap (maximalRealSubfield E) E).comp i.toRingHom =
        (RingEquiv.refl E).toRingHom.comp (algebraMap (maximalRealSubfield K) E) :=
      RingHom.ext fun x ↦ by
        simp [i, Algebra.algebraMap_ofSubsemiring_apply, RingHom.rangeRestrictFieldEquiv_apply_coe]
    rw [Algebra.finrank_eq_of_equiv_equiv i (RingEquiv.refl E) hc]
    exact .inr (Algebra.IsQuadraticExtension.finrank_eq_two (maximalRealSubfield E) E)

/-- **`[E_K : ℚ]` is `[K⁺ : ℚ]` or `2 [K⁺ : ℚ]`**, by the tower law and
`finrank_maximalRealSubfield_maximalRealOrCMSubfield_eq_one_or_eq_two`. When `K⁺` is infinite over
`ℚ` both degrees are `0`. -/
theorem finrank_maximalRealOrCMSubfield_eq_or_eq_two_mul :
    Module.finrank ℚ (maximalRealOrCMSubfield K) = Module.finrank ℚ (maximalRealSubfield K) ∨
      Module.finrank ℚ (maximalRealOrCMSubfield K) =
        2 * Module.finrank ℚ (maximalRealSubfield K) := by
  rw [← Module.finrank_mul_finrank ℚ (maximalRealSubfield K) (maximalRealOrCMSubfield K)]
  rcases finrank_maximalRealSubfield_maximalRealOrCMSubfield_eq_one_or_eq_two (K := K) with h | h
  · exact .inl (by rw [h, mul_one])
  · exact .inr (by rw [h, mul_comm])

omit [Algebra.IsIntegral ℚ K] in
/-- **`E_K` is preserved by field isomorphisms**, between fields algebraic over `ℚ`. -/
theorem map_maximalRealOrCMSubfield {K' : Type*} [Field K'] [CharZero K']
    [Algebra.IsIntegral ℚ K'] (σ : K ≃+* K') :
    (maximalRealOrCMSubfield K).map (σ : K →+* K') = maximalRealOrCMSubfield K' := by
  ext y
  have : y ∈ (maximalRealOrCMSubfield K).map (σ : K →+* K') ↔
      σ.symm y ∈ maximalRealOrCMSubfield K := by
    -- `Subfield.map` along `σ` has carrier the image of `σ`, which is the image of `σ.toEquiv`.
    rw [← SetLike.mem_coe, Subfield.coe_map]
    exact Set.mem_image_equiv (f := σ.toEquiv)
  rw [this, mem_maximalRealOrCMSubfield_iff
    ((toAlgebraicClosure K').comp (σ : K →+* K')),
    mem_maximalRealOrCMSubfield_iff (toAlgebraicClosure K')]
  simp

section Galois

variable {Ω : Type*} [Field Ω] [CharZero Ω] [Normal ℚ Ω]

omit [Algebra.IsIntegral ℚ K] in
/-- A closed subgroup of `Gal(Ω/ℚ)` containing `cmSubgroup Ω` and the fixing subgroup of `τ(K)`
contains every automorphism fixing `τ(E_K)` pointwise. -/
private theorem mem_of_isClosed {τ : K →+* Ω} {P : Subgroup Gal(Ω/ℚ)}
    (hP : IsClosed (P : Set Gal(Ω/ℚ))) (hH : cmSubgroup Ω ≤ P)
    (hF : τ.toRatAlgHom.fieldRange.fixingSubgroup ≤ P) {g : Gal(Ω/ℚ)}
    (hg : ∀ x ∈ maximalRealOrCMSubfield K, g (τ x) = τ x) : g ∈ P := by
  have : IsGalois ℚ Ω := ⟨⟩
  refine (InfiniteGalois.fixingSubgroup_fixedField ⟨P, hP⟩).le ?_
  rw [IntermediateField.mem_fixingSubgroup_iff]
  intro y hy
  rw [mem_fixedField_iff] at hy
  have hyK : y ∈ τ.toRatAlgHom.fieldRange := by
    rw [← InfiniteGalois.fixedField_fixingSubgroup τ.toRatAlgHom.fieldRange, mem_fixedField_iff]
    exact fun k hk ↦ hy k (hF hk)
  obtain ⟨x, rfl⟩ := AlgHom.mem_fieldRange.mp hyK
  exact hg x ((mem_maximalRealOrCMSubfield_iff_forall_mem_cmSubgroup τ).mpr
    fun h hh ↦ hy h (hH hh))

omit [Algebra.IsIntegral ℚ K] in
/-- If `P ⊔ Gal(Ω/τ(K))` is closed for a normal subgroup `P ⊇ cmSubgroup Ω`, then embeddings
agreeing on `E_K` differ by an element of `P`. -/
private theorem exists_comp_eq_of_eqOn {τ τ' : K →+* Ω} {P : Subgroup Gal(Ω/ℚ)} [P.Normal]
    (hP : IsClosed ((P ⊔ τ.toRatAlgHom.fieldRange.fixingSubgroup : Subgroup Gal(Ω/ℚ)) :
      Set Gal(Ω/ℚ)))
    (hH : cmSubgroup Ω ≤ P) (h : ∀ x ∈ maximalRealOrCMSubfield K, τ x = τ' x) :
    ∃ g ∈ P, (g : Ω →+* Ω).comp τ = τ' := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq Gal(Ω/ℚ) τ.toRatAlgHom τ'.toRatAlgHom
  obtain rfl : (g : Ω →+* Ω).comp τ = τ' := RingHom.ext fun x ↦ by
    simpa only [RingHom.comp_apply, RingHom.coe_coe, AlgEquiv.smul_algHom_apply,
      RingHom.toRatAlgHom_apply] using congr($hg x)
  have hg := mem_of_isClosed hP (hH.trans le_sup_left) le_sup_right fun x hx ↦ (h x hx).symm
  rw [← SetLike.mem_coe, Subgroup.normal_mul] at hg
  obtain ⟨a, ha, b, hb, rfl⟩ := hg
  refine ⟨a, ha, RingHom.ext fun x ↦ ?_⟩
  have hbx : b (τ x) = τ x :=
    (IntermediateField.mem_fixingSubgroup_iff _ _).mp hb _ (AlgHom.mem_fieldRange.mpr ⟨x, rfl⟩)
  simp [hbx]

omit [Algebra.IsIntegral ℚ K] in
/-- **Embeddings agreeing on `E_K`.** Two embeddings `τ, τ' : K →+* Ω` agree on `E_K` if and only if
`τ' = h ∘ τ` for some `h` in the closure of `cmSubgroup Ω`. -/
theorem exists_mem_topologicalClosure_cmSubgroup_iff_eqOn_maximalRealOrCMSubfield
    (τ τ' : K →+* Ω) :
    (∃ h ∈ (cmSubgroup Ω).topologicalClosure, (h : Ω →+* Ω).comp τ = τ') ↔
      ∀ x ∈ maximalRealOrCMSubfield K, τ x = τ' x := by
  have : IsGalois ℚ Ω := ⟨⟩
  constructor
  · rintro ⟨h, hh, rfl⟩ x hx
    let L := (τ.comp (maximalRealOrCMSubfield K).subtype).toRatAlgHom.fieldRange
    have hle : (cmSubgroup Ω).topologicalClosure ≤ L.fixingSubgroup := by
      refine Subgroup.topologicalClosure_minimal _ (fun g hg ↦ ?_)
        (InfiniteGalois.fixingSubgroup_isClosed L)
      rw [IntermediateField.mem_fixingSubgroup_iff]
      rintro _ ⟨⟨y, hy⟩, rfl⟩
      exact (mem_maximalRealOrCMSubfield_iff_forall_mem_cmSubgroup τ).mp hy g hg
    exact ((IntermediateField.mem_fixingSubgroup_iff _ _).mp (hle hh) (τ x) ⟨⟨x, hx⟩, rfl⟩).symm
  · intro h
    have := Subgroup.is_normal_topologicalClosure (cmSubgroup Ω)
    have := krullTopology_t2 (K := ℚ) (L := Ω)
    refine exists_comp_eq_of_eqOn ?_ (Subgroup.le_topologicalClosure _) h
    rw [Subgroup.normal_mul]
    exact ((Subgroup.isClosed_topologicalClosure _).isCompact.mul
      (InfiniteGalois.fixingSubgroup_isClosed _).isCompact).isClosed

end Galois

end Algebraic

section NumberField

variable [NumberField K]

variable {Ω : Type*} [Field Ω] [CharZero Ω] [Normal ℚ Ω]

/-- **Embeddings of a number field agreeing on `E_K`.** Two embeddings `τ, τ' : K →+* Ω` of a
number field agree on `E_K` if and only if `τ' = h ∘ τ` for some `h ∈ cmSubgroup Ω`: the closure
is not needed. -/
theorem exists_mem_cmSubgroup_iff_eqOn_maximalRealOrCMSubfield (τ τ' : K →+* Ω) :
    (∃ h ∈ cmSubgroup Ω, (h : Ω →+* Ω).comp τ = τ') ↔
      ∀ x ∈ maximalRealOrCMSubfield K, τ x = τ' x := by
  refine ⟨fun ⟨h, hh, e⟩ ↦
    (exists_mem_topologicalClosure_cmSubgroup_iff_eqOn_maximalRealOrCMSubfield τ τ').mp
    ⟨h, Subgroup.le_topologicalClosure _ hh, e⟩, fun h ↦ exists_comp_eq_of_eqOn ?_ le_rfl h⟩
  have : FiniteDimensional ℚ τ.toRatAlgHom.fieldRange :=
    τ.toRatAlgHom.equivFieldRange.toLinearEquiv.finiteDimensional
  exact Subgroup.isClosed_of_isOpen _
    (Subgroup.isOpen_mono le_sup_right (fixingSubgroup_isOpen _))

end NumberField

/-- **Odd degree.** A field of odd degree over `ℚ` has no CM subfield, so `E_K = K⁺`. For
instance `E_K = ℚ` for `K = ℚ(2^(1/3))`. -/
theorem maximalRealOrCMSubfield_eq_maximalRealSubfield_of_odd [CharZero K]
    (h : Odd (Module.finrank ℚ K)) : maximalRealOrCMSubfield K = maximalRealSubfield K := by
  have : FiniteDimensional ℚ K := Module.finite_of_finrank_pos h.pos
  refine le_antisymm (isTotallyReal_iff_le_maximalRealSubfield.mp
    ((isTotallyReal_or_isCMField_maximalRealOrCMSubfield K).resolve_right fun hE ↦ ?_))
    (maximalRealSubfield_le_maximalRealOrCMSubfield K)
  set E := maximalRealOrCMSubfield K
  rw [← Module.finrank_mul_finrank ℚ E K, ← Module.finrank_mul_finrank ℚ (maximalRealSubfield E) E,
    Algebra.IsQuadraticExtension.finrank_eq_two (maximalRealSubfield E) E] at h
  simp only [Nat.odd_mul] at h
  exact Nat.not_odd_iff_even.mpr even_two h.1.2

section ArtinWeil

/-! ### The Artin–Weil factorization -/

variable [NumberField K] {Ω : Type*} [Field Ω] [CharZero Ω] [Normal ℚ Ω]
  {A : Type*} {m : (K →+* Ω) → A} {w : A}

omit [NumberField K] [Normal ℚ Ω] in
/-- A function on embeddings with the conjugation relation is invariant under `cmSubgroup Ω`. -/
private theorem apply_comp_eq_of_mem_cmSubgroup [Add A] [IsRightCancelAdd A]
    (hm : ∀ c ∈ complexConjugations Ω, ∀ τ, m ((c : Ω →+* Ω).comp τ) + m τ = w)
    {g : Gal(Ω/ℚ)} (hg : g ∈ cmSubgroup Ω) (τ : K →+* Ω) : m ((g : Ω →+* Ω).comp τ) = m τ := by
  have hmul (x y : Gal(Ω/ℚ)) : ((x * y : Gal(Ω/ℚ)) : Ω →+* Ω) = (x : Ω →+* Ω).comp y :=
    RingHom.ext fun _ ↦ AlgEquiv.mul_apply _ _ _
  have h1 (τ : K →+* Ω) : ((1 : Gal(Ω/ℚ)) : Ω →+* Ω).comp τ = τ := RingHom.ext fun _ ↦ by
    simp only [RingHom.comp_apply, RingHom.coe_coe, AlgEquiv.one_apply]
  induction hg using Subgroup.closure_induction generalizing τ with
  | mem x hx =>
    obtain ⟨c₁, hc₁, c₂, hc₂, rfl⟩ := hx
    -- `m (c₁ c₂ τ) + m (c₂ τ) = w = m (c₂ c₂ τ) + m (c₂ τ)`, and `c₂ c₂ = 1`.
    have h₁ := hm c₁ hc₁ ((c₂ : Ω →+* Ω).comp τ)
    have h₂ := hm c₂ hc₂ ((c₂ : Ω →+* Ω).comp τ)
    rw [← RingHom.comp_assoc] at h₁ h₂
    rw [← hmul, mul_self_eq_one_of_mem_complexConjugations hc₂, h1] at h₂
    rw [hmul]
    exact add_right_cancel (h₁.trans h₂.symm)
  | one => rw [h1]
  | mul x y _ _ hx hy =>
    rw [hmul, RingHom.comp_assoc, hx, hy]
  | inv x _ hx =>
    rw [← hx (((x⁻¹ : Gal(Ω/ℚ)) : Ω →+* Ω).comp τ)]
    congr 1
    ext
    simp

/-- **Artin–Weil factorization (Milne, *Complex Multiplication*, I, proof of Proposition 4.9).**
For a number field `K`, if `m(c ∘ τ) + m(τ) = w` for every complex conjugation `c` and every
embedding `τ : K →+* Ω`, then `m(τ)` depends only on the restriction of `τ` to `E_K`. -/
theorem apply_eq_apply_of_eqOn_maximalRealOrCMSubfield [Add A] [IsRightCancelAdd A]
    (hm : ∀ c ∈ complexConjugations Ω, ∀ τ, m ((c : Ω →+* Ω).comp τ) + m τ = w)
    {τ τ' : K →+* Ω} (h : ∀ x ∈ maximalRealOrCMSubfield K, τ x = τ' x) : m τ = m τ' := by
  obtain ⟨g, hg, rfl⟩ := (exists_mem_cmSubgroup_iff_eqOn_maximalRealOrCMSubfield τ τ').mpr h
  exact (apply_comp_eq_of_mem_cmSubgroup hm hg τ).symm

/-- **Without a CM subfield the conjugation relation forces `2 • m = w`.** If a number field `K`
has no CM subfield and `m(c ∘ τ) + m(τ) = w` for every complex conjugation `c` and every
embedding `τ`, then `2 • m(τ) = w`. -/
theorem two_nsmul_eq_of_forall_not_isCMField [AddRightCancelMonoid A]
    (hK : ∀ F : Subfield K, ¬ IsCMField F)
    (hm : ∀ c ∈ complexConjugations Ω, ∀ τ, m ((c : Ω →+* Ω).comp τ) + m τ = w)
    (τ : K →+* Ω) : 2 • m τ = w := by
  have hE : IsTotallyReal (maximalRealOrCMSubfield K) :=
    (isTotallyReal_or_isCMField_maximalRealOrCMSubfield K).resolve_right
      fun h ↦ hK _ h
  obtain ⟨c, hc⟩ := complexConjugations_nonempty Ω
  have : m ((c : Ω →+* Ω).comp τ) = m τ :=
    apply_eq_apply_of_eqOn_maximalRealOrCMSubfield hm fun x hx ↦ by
      simpa only [RingHom.comp_apply, RingHom.coe_coe, Subfield.subtype_apply] using
        apply_eq_of_isTotallyReal hc (τ.comp (maximalRealOrCMSubfield K).subtype) ⟨x, hx⟩
  rw [two_nsmul, ← hm c hc τ, this]

end ArtinWeil

end TauCeti.NumberField
