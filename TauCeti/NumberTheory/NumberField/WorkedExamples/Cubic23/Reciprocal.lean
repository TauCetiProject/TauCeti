module

public import TauCeti.NumberTheory.NumberField.WorkedExamples.Cubic23.Invariants
import Mathlib.Algebra.Polynomial.SpecificDegree
import Mathlib.RingTheory.Polynomial.GaussLemma

/-!
# The cubic field of discriminant −23 as the field of `X³ - X + 1`

The invariants of the cubic field of discriminant `−23` are computed in
`TauCeti.NumberTheory.NumberField.WorkedExamples.Cubic23.Invariants` from an integral generator
`θ` with minimal polynomial `X³ - X² + 1`. The same field is also presented by the cubic
`X³ - X + 1`, whose roots are the reciprocals of the roots of `X³ - X² + 1`: if `r³ - r + 1 = 0`
then `r (r² - 1) = -1`, so `r⁻¹ = 1 - r²` is an algebraic integer, and it is a root of
`X³ - X² + 1`. This file supplies that generator, so that the invariants of
`Cubic23.Invariants` (discriminant `−23`, signature `(1, 1)`, class number one, unit rank one)
apply to a number field generated by a root of `X³ - X + 1`. This is the field factor of the
étale algebra `ℚ[X] ⧸ (X³ - X + 1)` attached to the elliptic curve `y² = x³ - x + 1`.

## Main results

* `TauCeti.NumberField.Cubic23.irreducible_polynomial`: `X³ - X² + 1` is irreducible over `ℤ`.
* `TauCeti.NumberField.Cubic23.irreducible_X_pow_three_sub_X_add_one`: `X³ - X + 1` is
  irreducible over `ℚ`, so `ℚ[X] ⧸ (X³ - X + 1)` is a field.
* `TauCeti.NumberField.Cubic23.exists_minpoly_eq_and_adjoin_eq_top_of_root`: a number field
  generated by a root of `X³ - X + 1` has an integral generator with minimal polynomial
  `X³ - X² + 1`.
-/

public section

open Polynomial NumberField
open scoped NumberField

namespace TauCeti.NumberField.Cubic23

/-- A monic integer cubic with constant coefficient `1` and no root at `1` or `-1` is
irreducible. -/
private theorem irreducible_of_natDegree_eq_three_of_coeff_zero_eq_one {p : ℤ[X]} (hm : p.Monic)
    (hd : p.natDegree = 3) (h0 : p.coeff 0 = 1) (h1 : p.eval 1 ≠ 0) (hn1 : p.eval (-1) ≠ 0) :
    Irreducible p := by
  rw [Monic.irreducible_iff_roots_eq_zero_of_degree_le_three hm (by lia) hd.le]
  refine Multiset.eq_zero_of_forall_notMem fun n hn ↦ ?_
  have hr : p.IsRoot n := (mem_roots hm.ne_zero).mp hn
  -- an integer root divides the constant coefficient `1`, so it is `1` or `-1`
  rcases Int.isUnit_iff.mp (isUnit_of_dvd_one (h0 ▸ hr.dvd_coeff_zero)) with rfl | rfl
  exacts [h1 hr, hn1 hr]

/-- The defining cubic `X³ - X² + 1` is irreducible over `ℤ`. -/
theorem irreducible_polynomial : Irreducible (X ^ 3 - X ^ 2 + 1 : ℤ[X]) :=
  irreducible_of_natDegree_eq_three_of_coeff_zero_eq_one (by monicity!) (by compute_degree!)
    (by simp) (by norm_num) (by norm_num)

/-- The cubic `X³ - X + 1` is irreducible over `ℚ`. -/
theorem irreducible_X_pow_three_sub_X_add_one : Irreducible (X ^ 3 - X + 1 : ℚ[X]) := by
  have hm : (X ^ 3 - X + 1 : ℤ[X]).Monic := by monicity!
  -- by Gauss's lemma it suffices to work over `ℤ`
  simpa using (hm.irreducible_iff_irreducible_map_fraction_map (K := ℚ)).mp
    (irreducible_of_natDegree_eq_three_of_coeff_zero_eq_one hm (by compute_degree!) (by simp)
      (by norm_num) (by norm_num))

variable {K : Type*} [Field K] [NumberField K]

/-- **A root of `X³ - X + 1` presents the cubic field of discriminant `−23`.** If a root `r` of
`X³ - X + 1` generates the number field `K`, then its reciprocal `r⁻¹ = 1 - r²` is an algebraic
integer of `K` with minimal polynomial `X³ - X² + 1` over `ℤ`, which also generates `K`. -/
theorem exists_minpoly_eq_and_adjoin_eq_top_of_root {r : K} (hr : r ^ 3 - r + 1 = 0)
    (hgen : Algebra.adjoin ℚ {r} = ⊤) :
    ∃ θ : 𝓞 K, minpoly ℤ θ = X ^ 3 - X ^ 2 + 1 ∧ Algebra.adjoin ℚ {(θ : K)} = ⊤ := by
  have hri : IsIntegral ℤ r := ⟨X ^ 3 - X + 1, by monicity!, by simp [hr]⟩
  let θ : 𝓞 K := ⟨1 - r ^ 2, isIntegral_one.sub (hri.pow 2)⟩
  have hθ : (θ : K) = 1 - r ^ 2 := rfl
  refine ⟨θ, ?_, ?_⟩
  · have hroot : aeval (θ : K) (X ^ 3 - X ^ 2 + 1 : ℤ[X]) = 0 := by
      simp only [map_add, map_sub, map_pow, aeval_X, map_one, hθ]
      linear_combination (-r ^ 3 + r + 1) * hr
    rw [← RingOfIntegers.minpoly_coe]
    exact eq_of_monic_of_associated (minpoly.monic (RingOfIntegers.isIntegral_coe θ))
      (by monicity!) ((minpoly.irreducible (RingOfIntegers.isIntegral_coe θ)).associated_of_dvd
        irreducible_polynomial
        (minpoly.isIntegrallyClosed_dvd (RingOfIntegers.isIntegral_coe θ) hroot))
  · -- `r = θ - θ²` lies in the algebra generated by `θ`
    have hrθ : r = (θ : K) - (θ : K) ^ 2 := by
      rw [hθ]
      linear_combination r * hr
    rw [eq_top_iff, ← hgen, Algebra.adjoin_le_iff, Set.singleton_subset_iff, SetLike.mem_coe, hrθ]
    have hmem := Algebra.self_mem_adjoin_singleton ℚ (θ : K)
    exact sub_mem hmem (pow_mem hmem 2)

end TauCeti.NumberField.Cubic23
