/-!
# Splitting of small primes in the cubic field of discriminant −23

For a number field generated by a root of `X³ - X² + 1`, the factor degrees of the defining
polynomial modulo `2`, `3`, `5`, `7`, and `59` give the splitting types `(3)`, `(3)`, `(1,2)`,
`(1,2)`, and `(1,1,1)`. The index of the generator is one, so Kummer–Dedekind identifies
these degrees with the residue degrees of the prime ideals above each rational prime.

The Kummer–Dedekind identification follows Neukirch, *Algebraic Number Theory*, I §8 (8.3).
-/

public section
noncomputable section

open Polynomial NumberField Ideal
open scoped NumberField

namespace TauCeti.NumberField.Cubic23

private theorem monic_polynomial : (X ^ 3 - X ^ 2 + 1 : ℤ[X]).Monic := by monicity!

local instance : Fact (Nat.Prime 5) := ⟨by decide⟩
local instance : Fact (Nat.Prime 7) := ⟨by decide⟩
local instance : Fact (Nat.Prime 59) := ⟨by decide⟩
local instance : (span {(2 : ℤ)} : Ideal ℤ).IsMaximal :=
  Int.ideal_span_isMaximal_of_prime 2
local instance : (span {(3 : ℤ)} : Ideal ℤ).IsMaximal :=
  Int.ideal_span_isMaximal_of_prime 3
local instance : (span {(5 : ℤ)} : Ideal ℤ).IsMaximal :=
  Int.ideal_span_isMaximal_of_prime 5
local instance : (span {(7 : ℤ)} : Ideal ℤ).IsMaximal :=
  Int.ideal_span_isMaximal_of_prime 7
local instance : (span {(59 : ℤ)} : Ideal ℤ).IsMaximal :=
  Int.ideal_span_isMaximal_of_prime 59

/-- The defining cubic is irreducible modulo `2`; its only factor degree is `3`. -/
theorem factorDegrees_two : (X ^ 3 - X ^ 2 + 1 : ℤ[X]).factorDegrees 2 = {3} := by
  rw [factorDegrees_eq_singleton_iff]
  constructor
  · convert Polynomial.irreducible_X_pow_three_add_X_sq_add_one_zmod_two using 1
    simp [Polynomial.map_add, Polynomial.map_sub, Polynomial.map_pow, CharTwo.sub_eq_add]
  · rw [monic_polynomial.natDegree_map]
    compute_degree!

/-- The defining cubic is irreducible modulo `3`; its only factor degree is `3`. -/
theorem factorDegrees_three : (X ^ 3 - X ^ 2 + 1 : ℤ[X]).factorDegrees 3 = {3} := by
  have hirr : Irreducible (X ^ 3 - X ^ 2 + 1 : (ZMod 3)[X]) := by
    apply irreducible_of_degree_le_three_of_not_isRoot
    · have hdeg : (X ^ 3 - X ^ 2 + 1 : (ZMod 3)[X]).natDegree = 3 := by
        compute_degree!
      rw [hdeg]
      decide
    · intro x
      rw [IsRoot.def]
      simp only [eval_add, eval_sub, eval_pow, eval_X, eval_one]
      fin_cases x <;> decide
  rw [factorDegrees_eq_singleton_iff]
  constructor
  · convert hirr using 1
    norm_num [Polynomial.map_add, Polynomial.map_sub, Polynomial.map_pow]
  · rw [monic_polynomial.natDegree_map]
    compute_degree!

/-- Modulo `5`, the cubic factors as `(X - 2)(X² + X + 2)`. -/
theorem factorDegrees_five : (X ^ 3 - X ^ 2 + 1 : ℤ[X]).factorDegrees 5 = {1, 2} := by
  have hquad : Irreducible (X ^ 2 + X + C 2 : (ZMod 5)[X]) := by
    apply irreducible_of_degree_le_three_of_not_isRoot
    · have hdeg : (X ^ 2 + X + C 2 : (ZMod 5)[X]).natDegree = 2 := by
        compute_degree!
      rw [hdeg]
      decide
    · intro x
      rw [IsRoot.def]
      simp only [eval_add, eval_pow, eval_X, eval_C]
      fin_cases x <;> decide
  have hirr : ∀ q ∈ ({X - C 2, X ^ 2 + X + C 2} : Multiset (ZMod 5)[X]),
      Irreducible q := by
    intro q hq
    rcases Multiset.mem_cons.mp hq with rfl | hq
    · exact irreducible_X_sub_C 2
    · rw [Multiset.mem_singleton.mp hq]
      exact hquad
  have hmap : (X ^ 3 - X ^ 2 + 1 : ℤ[X]).map (Int.castRingHom (ZMod 5)) =
      ({X - C 2, X ^ 2 + X + C 2} : Multiset (ZMod 5)[X]).prod := by
    simp only [Multiset.insert_eq_cons, Multiset.prod_cons, Multiset.prod_singleton,
      Polynomial.map_add, Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X,
      Polynomial.map_one]
    simp only [C_ofNat]
    have h5 : (5 : (ZMod 5)[X]) = 0 := by
      exact_mod_cast CharP.cast_eq_zero (ZMod 5)[X] 5
    linear_combination h5
  rw [factorDegrees_eq_map_natDegree_of_map_eq_prod hirr hmap]
  simp only [Multiset.insert_eq_cons, Multiset.map_cons, Multiset.map_singleton,
    natDegree_X_sub_C]
  have hdeg : (X ^ 2 + X + C 2 : (ZMod 5)[X]).natDegree = 2 := by compute_degree!
  rw [hdeg]

/-- Modulo `7`, the cubic factors as `(X - 4)(X² + 3X + 5)`. -/
theorem factorDegrees_seven : (X ^ 3 - X ^ 2 + 1 : ℤ[X]).factorDegrees 7 = {1, 2} := by
  have hquad : Irreducible (X ^ 2 + C 3 * X + C 5 : (ZMod 7)[X]) := by
    apply irreducible_of_degree_le_three_of_not_isRoot
    · have hdeg : (X ^ 2 + C 3 * X + C 5 : (ZMod 7)[X]).natDegree = 2 := by
        compute_degree!
      rw [hdeg]
      decide
    · intro x
      rw [IsRoot.def]
      simp only [eval_add, eval_mul, eval_pow, eval_X, eval_C]
      fin_cases x <;> decide
  have hirr : ∀ q ∈ ({X - C 4, X ^ 2 + C 3 * X + C 5} : Multiset (ZMod 7)[X]),
      Irreducible q := by
    intro q hq
    rcases Multiset.mem_cons.mp hq with rfl | hq
    · exact irreducible_X_sub_C 4
    · rw [Multiset.mem_singleton.mp hq]
      exact hquad
  have hmap : (X ^ 3 - X ^ 2 + 1 : ℤ[X]).map (Int.castRingHom (ZMod 7)) =
      ({X - C 4, X ^ 2 + C 3 * X + C 5} : Multiset (ZMod 7)[X]).prod := by
    simp only [Multiset.insert_eq_cons, Multiset.prod_cons, Multiset.prod_singleton,
      Polynomial.map_add, Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X,
      Polynomial.map_one]
    simp only [C_ofNat]
    have h7 : (7 : (ZMod 7)[X]) = 0 := by
      exact_mod_cast CharP.cast_eq_zero (ZMod 7)[X] 7
    linear_combination (X + 3) * h7
  rw [factorDegrees_eq_map_natDegree_of_map_eq_prod hirr hmap]
  simp only [Multiset.insert_eq_cons, Multiset.map_cons, Multiset.map_singleton,
    natDegree_X_sub_C]
  have hdeg : (X ^ 2 + C 3 * X + C 5 : (ZMod 7)[X]).natDegree = 2 := by compute_degree!
  rw [hdeg]

/-- Modulo `59`, the cubic has the three distinct roots `7`, `9`, and `44`. -/
theorem factorDegrees_fifty_nine :
    (X ^ 3 - X ^ 2 + 1 : ℤ[X]).factorDegrees 59 = {1, 1, 1} := by
  have hirr : ∀ q ∈ ({X - C 7, X - C 9, X - C 44} : Multiset (ZMod 59)[X]),
      Irreducible q := by
    intro q hq
    simp only [Multiset.insert_eq_cons, Multiset.mem_cons, Multiset.mem_singleton] at hq
    rcases hq with rfl | rfl | rfl <;> exact irreducible_X_sub_C _
  have hmap : (X ^ 3 - X ^ 2 + 1 : ℤ[X]).map (Int.castRingHom (ZMod 59)) =
      ({X - C 7, X - C 9, X - C 44} : Multiset (ZMod 59)[X]).prod := by
    simp only [Multiset.insert_eq_cons, Multiset.prod_cons, Multiset.prod_singleton,
      Polynomial.map_add, Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X,
      Polynomial.map_one]
    simp only [C_ofNat]
    have h59 : (59 : (ZMod 59)[X]) = 0 := by
      exact_mod_cast CharP.cast_eq_zero (ZMod 59)[X] 59
    linear_combination (X ^ 2 - 13 * X + 47) * h59
  rw [factorDegrees_eq_map_natDegree_of_map_eq_prod hirr hmap]
  simp

variable {K : Type*} [Field K] [NumberField K] {θ : 𝓞 K}
  (hmin : minpoly ℤ θ = X ^ 3 - X ^ 2 + 1)
  (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤)

include hmin hgen

private theorem inertiaDegrees_eq_factorDegrees (p : ℕ) [Fact p.Prime]
    (hp : ¬ (p : ℤ) ∣ (-23 : ℤ)) :
    (Finset.univ : Finset ((span {(p : ℤ)}).primesOver (𝓞 K))).val.map
        (fun Q => Q.1.inertiaDeg ℤ) = (X ^ 3 - X ^ 2 + 1 : ℤ[X]).factorDegrees p := by
  have hexp : ¬ p ∣ RingOfIntegers.exponent θ := by
    intro h
    have hd := h.trans (IntegralPrimitiveElement.exponent_dvd_index
      (⟨θ, hgen⟩ : IntegralPrimitiveElement K))
    rw [index_eq_one hmin hgen] at hd
    exact (Fact.out : Nat.Prime p).ne_one (Nat.dvd_one.mp hd)
  have hsq : Squarefree ((minpoly ℤ θ).map (Int.castRingHom (ZMod p))) := by
    rw [hmin]
    have hsep : ((X ^ 3 - X ^ 2 + 1 : ℤ[X]).map
        (Int.castRingHom (ZMod p))).Separable :=
      (monic_polynomial.separable_map_zmod_iff_not_dvd_discr p).mpr
        (by simpa only [discr_polynomial] using hp)
    exact hsep.squarefree
  simpa only [hmin] using
    RingOfIntegers.map_inertiaDeg_primesOver_eq_factorDegrees θ hexp hsq

/-- Every rational prime other than `23` is unramified in the cubic field of discriminant
`−23`; in particular every prime ideal above it has ramification index one. -/
theorem ramificationIdx_eq_one_of_ne_twenty_three (p : ℕ) [Fact p.Prime]
    (hp : ¬ (p : ℤ) ∣ (-23 : ℤ)) (Q : Ideal (𝓞 K)) [Q.IsPrime]
    [Q.LiesOver (span {(p : ℤ)})] : Q.ramificationIdx ℤ = 1 := by
  have hur : Algebra.IsUnramifiedIn (𝓞 K) (span {(p : ℤ)}) :=
    (NumberField.not_dvd_discr_iff_isUnramifiedIn K (𝓞 K)
      (Nat.prime_iff_prime_int.mp (Fact.out : Nat.Prime p))).mp (by
      rw [discr_eq_neg_twenty_three hmin hgen]
      exact hp)
  exact (Algebra.isUnramifiedIn_iff_forall_ramificationIdx_eq_one.mp hur) Q inferInstance

/-- The prime `2` is inert: its sole prime ideal has residue degree three. -/
theorem inertiaDegrees_two :
    (Finset.univ : Finset ((span {(2 : ℤ)}).primesOver (𝓞 K))).val.map
        (fun Q => Q.1.inertiaDeg ℤ) = {3} := by
  -- The generic and concrete forms choose extensionally equal finite enumerations of primes.
  convert inertiaDegrees_eq_factorDegrees hmin hgen 2 (by norm_num) using 1
  ext a
  simp only [factorDegrees_two]

/-- The prime `3` is inert: its sole prime ideal has residue degree three. -/
theorem inertiaDegrees_three :
    (Finset.univ : Finset ((span {(3 : ℤ)}).primesOver (𝓞 K))).val.map
        (fun Q => Q.1.inertiaDeg ℤ) = {3} := by
  convert inertiaDegrees_eq_factorDegrees hmin hgen 3 (by norm_num) using 1
  ext a
  simp only [factorDegrees_three]

/-- The prime `5` has two primes above it, of residue degrees one and two. -/
theorem inertiaDegrees_five :
    (Finset.univ : Finset ((span {(5 : ℤ)}).primesOver (𝓞 K))).val.map
        (fun Q => Q.1.inertiaDeg ℤ) = {1, 2} := by
  convert inertiaDegrees_eq_factorDegrees hmin hgen 5 (by norm_num) using 1
  ext a
  simp only [factorDegrees_five]

/-- The prime `7` has two primes above it, of residue degrees one and two. -/
theorem inertiaDegrees_seven :
    (Finset.univ : Finset ((span {(7 : ℤ)}).primesOver (𝓞 K))).val.map
        (fun Q => Q.1.inertiaDeg ℤ) = {1, 2} := by
  convert inertiaDegrees_eq_factorDegrees hmin hgen 7 (by norm_num) using 1
  ext a
  simp only [factorDegrees_seven]

/-- The prime `59` splits completely: three primes above it each have residue degree one. -/
theorem inertiaDegrees_fifty_nine :
    (Finset.univ : Finset ((span {(59 : ℤ)}).primesOver (𝓞 K))).val.map
        (fun Q => Q.1.inertiaDeg ℤ) = {1, 1, 1} := by
  convert inertiaDegrees_eq_factorDegrees hmin hgen 59 (by norm_num) using 1
  ext a
  simp only [factorDegrees_fifty_nine]

/-- The prime `59` splits completely in the cubic field. -/
theorem ncard_primesOver_fifty_nine_eq_finrank :
    (primesOver (span {(59 : ℤ)}) (𝓞 K)).ncard = Module.finrank ℚ K := by
  have h := congrArg Multiset.card (inertiaDegrees_fifty_nine hmin hgen)
  simpa [Nat.card_eq_fintype_card, Nat.card_coe_set_eq,
    finrank_eq_three hmin hgen] using h

end TauCeti.NumberField.Cubic23

end
