/-!
# Projective `K₀` of `ℤ[√-5]` as a ring

Let `A = ℤ[√-5] = QuadraticAlgebra ℤ (-5) 0`, the ring of integers of `ℚ(√-5)` and hence a
Dedekind domain (`TauCeti.NumberField.SqrtNegFive.isDedekindDomain`), and let
`𝔭 = (2, 1 + √-5)`. The class group of `A` has order two and is generated by the class of `𝔭`
(`TauCeti.NumberField.SqrtNegFive.natCard_classGroup_eq_two`,
`TauCeti.NumberField.SqrtNegFive.primeAboveTwo.not_isPrincipal`). Rank and Steinitz class
identify projective `K₀` of a Dedekind domain, as a ring, with the trivial square-zero extension
of `ℤ` by its class group (`TauCeti.FiniteProjectiveModules.rankSteinitzRingEquiv`), so

```text
K₀(ℤ[√-5]) ≃+* ℤ ⋉ ℤ/2,   [A] ↦ (1, 0),   [𝔭] ↦ (1, 1),   [𝔭] - [A] ↦ (0, 1).
```

In particular the reduced class `x = [𝔭] - [A]`, a nonzero class of order two that vanishes in
every prime localization, squares to zero, and `[𝔭] * [𝔭] = [A]`. The torsion subgroup of
`K₀(A)` is `{0, x}`; for any Dedekind domain with torsion (for instance finite) class group the
torsion subgroup is the image of the class group
(`TauCeti.FiniteProjectiveModules.torsion_eq_range_idealClassHom`).

The ring structure of `TrivSqZeroExt ℤ (ZMod 2)` uses the right action of `ℤ` on `ZMod 2` from
the scoped instances of `TauCeti.TrivSqZeroExt` (`TauCeti.TrivSqZeroExt.moduleIntMulOppositeZMod`).

## Main definitions

* `TauCeti.NumberField.SqrtNegFive.classGroupEquiv`: the isomorphism `Cl(ℤ[√-5]) ≃+ ℤ/2`, sending
  the class of `𝔭` to `1`.
* `TauCeti.NumberField.SqrtNegFive.splitK0RingEquiv`: the ring isomorphism
  `K₀(ℤ[√-5]) ≃+* ℤ ⋉ ℤ/2`.

## Main results

* `TauCeti.NumberField.SqrtNegFive.eq_one_or_eq_mk0_primeAboveTwo`: every ideal class of
  `ℤ[√-5]` is trivial or the class of `𝔭`.
* `TauCeti.NumberField.SqrtNegFive.fst_splitK0RingEquiv`,
  `TauCeti.NumberField.SqrtNegFive.snd_splitK0RingEquiv`,
  `TauCeti.NumberField.SqrtNegFive.splitK0RingEquiv_symm_apply`: the coordinates are the rank and
  the Steinitz class, and the inverse.
* `TauCeti.NumberField.SqrtNegFive.primeAboveTwo.splitK0RingEquiv_of`,
  `TauCeti.NumberField.SqrtNegFive.primeAboveTwo.splitK0RingEquiv_classOf`: the normalizations
  `[𝔭] ↦ (1, 1)` and `[𝔭] - [A] ↦ (0, 1)`.
* `TauCeti.NumberField.SqrtNegFive.primeAboveTwo.classOf_mul_classOf`,
  `TauCeti.NumberField.SqrtNegFive.primeAboveTwo.splitK0_of_mul_self_eq_one`: `x ^ 2 = 0` and
  `[𝔭] ^ 2 = [A]` in the ring `K₀(ℤ[√-5])`.
* `TauCeti.NumberField.SqrtNegFive.torsion_splitK0_eq_zmultiples`: the torsion subgroup of
  `K₀(ℤ[√-5])` is generated by `[𝔭] - [A]`.

## References

* C. A. Weibel, *The K-book: An Introduction to Algebraic K-theory*, Chapter II, Corollary 2.6.3
  (p. 75), and Chapter I, Exercise 3.8 (p. 29).
-/

public section

open QuadraticAlgebra TauCeti.FiniteProjectiveModules
open scoped TauCeti.TrivSqZeroExt

namespace TauCeti.NumberField.SqrtNegFive

/-! ### The class group -/

/-- The prime `𝔭 = (2, 1 + √-5)` is a nonzero divisor in the monoid of ideals of `ℤ[√-5]`, so it
has a class in the class group. -/
theorem primeAboveTwo.mem_nonZeroDivisors :
    primeAboveTwo ∈ nonZeroDivisors (Ideal (QuadraticAlgebra ℤ (-5) 0)) :=
  mem_nonZeroDivisors_of_ne_zero primeAboveTwo.ne_bot

/-- The class of `𝔭 = (2, 1 + √-5)` is not trivial in the class group of `ℤ[√-5]`. -/
theorem mk0_primeAboveTwo_ne_one :
    ClassGroup.mk0 ⟨primeAboveTwo, primeAboveTwo.mem_nonZeroDivisors⟩ ≠ 1 := by
  rw [Ne, ClassGroup.mk0_eq_one_iff]
  exact primeAboveTwo.not_isPrincipal

/-- Every ideal class of `ℤ[√-5]` is trivial or the class of `𝔭 = (2, 1 + √-5)`. -/
theorem eq_one_or_eq_mk0_primeAboveTwo (c : ClassGroup (QuadraticAlgebra ℤ (-5) 0)) :
    c = 1 ∨ c = ClassGroup.mk0 ⟨primeAboveTwo, primeAboveTwo.mem_nonZeroDivisors⟩ := by
  obtain ⟨y, -, hy⟩ := (Nat.card_eq_two_iff' 1).1 natCard_classGroup_eq_two
  rw [or_iff_not_imp_left, hy _ mk0_primeAboveTwo_ne_one]
  exact hy c

/-- **The class group of `ℤ[√-5]` is `ℤ/2`**, the class of `𝔭 = (2, 1 + √-5)` going to `1`
(`TauCeti.NumberField.SqrtNegFive.classGroupEquiv_mk0_primeAboveTwo`). -/
noncomputable def classGroupEquiv : Additive (ClassGroup (QuadraticAlgebra ℤ (-5) 0)) ≃+ ZMod 2 :=
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  MulEquiv.toAdditiveLeft (mulEquivOfPrimeCardEq natCard_classGroup_eq_two (by simp))

/-- The isomorphism `Cl(ℤ[√-5]) ≃+ ℤ/2` sends the class of `𝔭 = (2, 1 + √-5)` to `1`. -/
@[simp]
theorem classGroupEquiv_mk0_primeAboveTwo :
    classGroupEquiv (.ofMul (ClassGroup.mk0 ⟨primeAboveTwo, primeAboveTwo.mem_nonZeroDivisors⟩)) =
      1 := by
  have h : classGroupEquiv
      (.ofMul (ClassGroup.mk0 ⟨primeAboveTwo, primeAboveTwo.mem_nonZeroDivisors⟩)) ≠ 0 := by
    rw [Ne, AddEquivClass.map_eq_zero_iff]
    exact mk0_primeAboveTwo_ne_one
  generalize classGroupEquiv _ = a at h
  revert a
  decide

/-- The inverse of `Cl(ℤ[√-5]) ≃+ ℤ/2` sends `1` to the class of `𝔭 = (2, 1 + √-5)`. -/
@[simp]
theorem classGroupEquiv_symm_one :
    classGroupEquiv.symm 1 =
      .ofMul (ClassGroup.mk0 ⟨primeAboveTwo, primeAboveTwo.mem_nonZeroDivisors⟩) := by
  rw [AddEquiv.symm_apply_eq, classGroupEquiv_mk0_primeAboveTwo]

/-! ### The ring `K₀(ℤ[√-5])` -/

/-- **Projective `K₀` of `ℤ[√-5]` as a ring.** Rank and Steinitz class identify projective
`K₀(ℤ[√-5])` with the trivial square-zero extension `ℤ ⋉ ℤ/2`. The class of the ring goes to
`(1, 0)` and the class of `𝔭 = (2, 1 + √-5)` to `(1, 1)`. -/
noncomputable def splitK0RingEquiv :
    SplitK0.{0} (finiteProjectiveModules (QuadraticAlgebra ℤ (-5) 0)).FullSubcategory ≃+*
      TrivSqZeroExt ℤ (ZMod 2) :=
  -- Any central right action of `ℤ` on the class group serves to form the square-zero extension.
  letI := TrivSqZeroExt.moduleMulOpposite ℤ (Additive (ClassGroup (QuadraticAlgebra ℤ (-5) 0)))
  haveI := TrivSqZeroExt.isCentralScalar_moduleMulOpposite ℤ
    (Additive (ClassGroup (QuadraticAlgebra ℤ (-5) 0)))
  (rankSteinitzRingEquiv _).trans classGroupEquiv.toIntLinearEquiv.trivSqZeroExtCongr.toRingEquiv

/-- The first coordinate of `K₀(ℤ[√-5]) ≃+* ℤ ⋉ ℤ/2` is the rank. -/
@[simp]
theorem fst_splitK0RingEquiv
    (x : SplitK0.{0} (finiteProjectiveModules (QuadraticAlgebra ℤ (-5) 0)).FullSubcategory) :
    (splitK0RingEquiv x).fst = (rankSteinitz _ x).1 := by
  simp [splitK0RingEquiv]

/-- The second coordinate of `K₀(ℤ[√-5]) ≃+* ℤ ⋉ ℤ/2` is the Steinitz class, read in `ℤ/2`. -/
@[simp]
theorem snd_splitK0RingEquiv
    (x : SplitK0.{0} (finiteProjectiveModules (QuadraticAlgebra ℤ (-5) 0)).FullSubcategory) :
    (splitK0RingEquiv x).snd = classGroupEquiv (rankSteinitz _ x).2 := by
  simp [splitK0RingEquiv]

/-- The inverse of `K₀(ℤ[√-5]) ≃+* ℤ ⋉ ℤ/2` sends `(n, c)` to `n` plus the reduced ideal class
corresponding to `c`. -/
@[simp]
theorem splitK0RingEquiv_symm_apply (x : TrivSqZeroExt ℤ (ZMod 2)) :
    splitK0RingEquiv.symm x = x.fst + idealClassHom _ (classGroupEquiv.symm x.snd) := by
  simp [splitK0RingEquiv]

namespace primeAboveTwo

/-- The reduced class `[𝔭] - [A]` of `𝔭 = (2, 1 + √-5)` goes to `(0, 1)` in `ℤ ⋉ ℤ/2`. -/
@[simp]
theorem splitK0RingEquiv_classOf :
    splitK0RingEquiv (classOf (QuadraticAlgebra ℤ (-5) 0) primeAboveTwo 1) =
      TrivSqZeroExt.inr 1 := by
  rw [← idealClassHom_mk0 ⟨primeAboveTwo, mem_nonZeroDivisors⟩]
  ext <;> simp [-idealClassHom_mk0]

/-- The class of `𝔭 = (2, 1 + √-5)` goes to `(1, 1)` in `ℤ ⋉ ℤ/2`. -/
@[simp]
theorem splitK0RingEquiv_of :
    splitK0RingEquiv (SplitK0.of.{0} (of (QuadraticAlgebra ℤ (-5) 0) primeAboveTwo)) =
      1 + TrivSqZeroExt.inr 1 := by
  rw [splitK0_of_eq_classOf_add _ 1, Nat.cast_one, map_add, map_one, splitK0RingEquiv_classOf,
    add_comm]

/-- **The reduced class `[𝔭] - [A]` squares to zero** in the ring `K₀(ℤ[√-5])`. -/
theorem classOf_mul_classOf :
    classOf (QuadraticAlgebra ℤ (-5) 0) primeAboveTwo 1 *
      classOf (QuadraticAlgebra ℤ (-5) 0) primeAboveTwo 1 = 0 := by
  rw [← idealClassHom_mk0 ⟨primeAboveTwo, mem_nonZeroDivisors⟩]
  exact idealClassHom_mul_idealClassHom _ _ _

/-- **`[𝔭] * [𝔭] = [A]`** in the ring `K₀(ℤ[√-5])`, for `𝔭 = (2, 1 + √-5)`. -/
theorem splitK0_of_mul_self_eq_one :
    SplitK0.of.{0} (of (QuadraticAlgebra ℤ (-5) 0) primeAboveTwo) *
      SplitK0.of.{0} (of (QuadraticAlgebra ℤ (-5) 0) primeAboveTwo) = 1 := by
  rw [splitK0_of_eq_classOf_add _ 1, Nat.cast_one]
  linear_combination classOf_mul_classOf + two_nsmul_classOf

end primeAboveTwo

/-! ### Torsion -/

/-- **Torsion in `K₀(ℤ[√-5])`.** The torsion subgroup of projective `K₀(ℤ[√-5])` is generated by
the reduced class `[𝔭] - [A]` of `𝔭 = (2, 1 + √-5)`, which has order two
(`TauCeti.NumberField.SqrtNegFive.primeAboveTwo.addOrderOf_classOf`). -/
theorem torsion_splitK0_eq_zmultiples :
    AddCommGroup.torsion
        (SplitK0.{0} (finiteProjectiveModules (QuadraticAlgebra ℤ (-5) 0)).FullSubcategory) =
      AddSubgroup.zmultiples (classOf (QuadraticAlgebra ℤ (-5) 0) primeAboveTwo 1) := by
  rw [torsion_eq_range_idealClassHom _ isAddTorsion_of_finite, AddMonoidHom.range_eq_map,
    ← idealClassHom_mk0 ⟨primeAboveTwo, primeAboveTwo.mem_nonZeroDivisors⟩,
    ← AddMonoidHom.map_zmultiples]
  congr 1
  refine (eq_top_iff.2 fun c _ ↦ ?_).symm
  rcases eq_one_or_eq_mk0_primeAboveTwo c.toMul with h | h
  · rw [← ofMul_toMul c, h, ofMul_one]
    exact zero_mem _
  · rw [← ofMul_toMul c, h]
    exact AddSubgroup.mem_zmultiples _

end TauCeti.NumberField.SqrtNegFive
