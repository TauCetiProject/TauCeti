module

public import Mathlib.RingTheory.Polynomial.Resultant.Basic
import TauCeti.NumberTheory.NumberField.Index.Discriminant
import TauCeti.NumberTheory.NumberField.Minpoly
import TauCeti.NumberTheory.NumberField.InfinitePlace.Basic
public import Mathlib.NumberTheory.NumberField.ClassNumber
import Mathlib.NumberTheory.NumberField.Norm
public import Mathlib.NumberTheory.NumberField.Units.DirichletTheorem

/-!
# The cubic field defined by `X³ - 4X + 2`

For a number field generated by an integral root `θ` of `X³ - 4X + 2`, the class
number is one and the unit rank is two. The index formula bounds the field
discriminant by `148` and shows it is positive. Minkowski's bound is therefore
less than three. Every prime ideal of norm two contains `θ`, whose norm is `-2`,
so that ideal is principal.

This is the cubic algebra used for explicit two-descent on `y² + y = x³ - x`:
completing the square gives `y'² = x³ - x + 1/4`, and `θ = 2x` satisfies
`θ³ - 4θ + 2 = 0`.

## References

* D. A. Marcus, *Number Fields*, Chapters 2–4 (norms, discriminants, and Minkowski's bound).
* J. H. Silverman, *The Arithmetic of Elliptic Curves*, X.1 (two-descent).
-/

public section

open Polynomial NumberField NumberField.InfinitePlace
open scoped NumberField nonZeroDivisors

namespace TauCeti.NumberField.Cubic148

/-- The discriminant of `X³ - 4X + 2` is `148`. -/
@[simp]
theorem discr_polynomial : (X ^ 3 - 4 * X + 2 : ℤ[X]).discr = 148 := by
  rw [Polynomial.discr_of_degree_eq_three (by compute_degree <;> norm_num)]
  norm_num [coeff_add, coeff_sub, coeff_mul, coeff_X_pow, coeff_X]

variable {K : Type*} [Field K] [NumberField K] {θ : 𝓞 K}
  (hmin : minpoly ℤ θ = X ^ 3 - 4 * X + 2)
  (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤)

include hmin hgen

/-- A field generated by a root of the defining cubic has degree three. -/
theorem finrank_eq_three : Module.finrank ℚ K = 3 := by
  let t : IntegralPrimitiveElement K := ⟨θ, hgen⟩
  rw [t.powerBasis.finrank, ← t.powerBasis.natDegree_minpoly, t.powerBasis_gen,
    RingOfIntegers.minpoly_rat_coe,
    Polynomial.natDegree_map_eq_of_injective (Int.cast_injective (α := ℚ)), hmin]
  compute_degree <;> norm_num

/-- The signed field discriminant is positive and at most `148`; no integral basis is assumed. -/
theorem discr_pos_and_le : 0 < discr K ∧ discr K ≤ 148 := by
  let t : IntegralPrimitiveElement K := ⟨θ, hgen⟩
  have hd := t.discr_minpoly_eq_index_sq_mul_discr
  rw [hmin, discr_polynomial] at hd
  have hi : 1 ≤ (t.index : ℤ) := by exact_mod_cast t.index_pos
  constructor <;> nlinarith [sq_nonneg (t.index : ℤ)]

/-- The defining cubic field has no complex infinite places. -/
theorem nrComplexPlaces_eq_zero : nrComplexPlaces K = 0 :=
  InfinitePlace.nrComplexPlaces_eq_zero_of_zero_lt_discr (discr_pos_and_le hmin hgen).1
    (by rw [finrank_eq_three hmin hgen]; decide)

/-- The defining cubic field has three real infinite places. -/
theorem nrRealPlaces_eq_three : nrRealPlaces K = 3 := by
  have h := card_add_two_mul_card_eq_rank K
  rw [finrank_eq_three hmin hgen, nrComplexPlaces_eq_zero hmin hgen] at h
  omega

/-- The integral generator has norm `-2`. -/
theorem norm_generator : Algebra.norm ℤ θ = -2 := by
  let t : IntegralPrimitiveElement K := ⟨θ, hgen⟩
  have hn := Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly t.powerBasis
  rw [t.powerBasis_gen, RingOfIntegers.minpoly_rat_coe, hmin, coeff_map] at hn
  have hdim : t.powerBasis.dim = 3 := by
    rw [← t.powerBasis.finrank, finrank_eq_three hmin hgen]
  rw [hdim] at hn
  rw [← Algebra.coe_norm_int] at hn
  norm_num [coeff_add, coeff_sub, coeff_mul, coeff_X_pow] at hn
  exact_mod_cast hn

/-- Every prime ideal of norm two is generated by the cubic root. -/
theorem eq_span_generator_of_absNorm_eq_two {P : Ideal (𝓞 K)}
    (hN : P.absNorm = 2) : P = Ideal.span {θ} := by
  have hP : P.IsPrime := Ideal.isPrime_of_irreducible_absNorm (by rw [hN]; exact Nat.prime_two)
  have htwo : (2 : 𝓞 K) ∈ P := by simpa only [hN, Nat.cast_ofNat] using P.absNorm_mem
  have heq : θ ^ 3 - 4 * θ + 2 = 0 := by
    have h := minpoly.aeval ℤ θ
    rw [hmin] at h
    have h4 : aeval θ (4 : ℤ[X]) = (4 : 𝓞 K) := map_ofNat _ 4
    have h2 : aeval θ (2 : ℤ[X]) = (2 : 𝓞 K) := map_ofNat _ 2
    simpa only [map_sub, map_add, map_mul, map_pow, aeval_X, h4, h2] using h
  have hfour : (4 : 𝓞 K) * θ ∈ P := by
    convert P.mul_mem_right (2 * θ) htwo using 1
    ring
  have hpow : θ ^ 3 ∈ P := by
    have h := P.sub_mem hfour htwo
    convert h using 1
    linear_combination heq
  have hθ : θ ∈ P := hP.mem_of_pow_mem 3 hpow
  have hnorm : (Ideal.span {θ} : Ideal (𝓞 K)).absNorm = 2 := by
    rw [Ideal.absNorm_span_singleton, norm_generator hmin hgen]
    norm_num
  have hprime : (Ideal.span {θ} : Ideal (𝓞 K)).IsPrime :=
    Ideal.isPrime_of_irreducible_absNorm (by rw [hnorm]; exact Nat.prime_two)
  have hne : (Ideal.span {θ} : Ideal (𝓞 K)) ≠ ⊥ := by
    intro h
    simp [h] at hnorm
  exact (hprime.isMaximal hne).eq_of_le hP.ne_top
    ((Ideal.span_singleton_le_iff_mem P).mpr hθ) |>.symm

/-- The ring of integers of the defining cubic field is a principal ideal domain. -/
theorem isPrincipalIdealRing : IsPrincipalIdealRing (𝓞 K) := by
  apply _root_.NumberField.RingOfIntegers.isPrincipalIdealRing_of_isPrincipal_of_norm_le_of_isPrime
  intro I hP hI
  have hd := discr_pos_and_le hmin hgen
  have hs : Real.sqrt |(discr K : ℝ)| < 27 / 2 := by
    apply (Real.sqrt_lt (by norm_num) (by norm_num)).mpr
    rw [abs_of_pos (by exact_mod_cast hd.1)]
    have hd' : (discr K : ℝ) ≤ 148 := by exact_mod_cast hd.2
    linarith
  rw [nrComplexPlaces_eq_zero hmin hgen, finrank_eq_three hmin hgen] at hI
  norm_num at hI
  have hN : (I : Ideal (𝓞 K)).absNorm ≤ 2 := by
    have : ((I : Ideal (𝓞 K)).absNorm : ℝ) < 3 := by nlinarith
    have : (I : Ideal (𝓞 K)).absNorm < 3 := by exact_mod_cast this
    omega
  have hpos := Ideal.absNorm_pos_of_nonZeroDivisors I
  have hnotone : (I : Ideal (𝓞 K)).absNorm ≠ 1 := by
    exact fun h ↦ hP.ne_top (Ideal.absNorm_eq_one_iff.mp h)
  have htwo : (I : Ideal (𝓞 K)).absNorm = 2 := by omega
  rw [eq_span_generator_of_absNorm_eq_two hmin hgen htwo]
  infer_instance

/-- The class number of the defining cubic field is one. -/
theorem classNumber_eq_one : classNumber K = 1 :=
  classNumber_eq_one_iff.mpr (isPrincipalIdealRing hmin hgen)

/-- The unit group of the defining cubic field has rank two. -/
theorem units_rank_eq_two : NumberField.Units.rank K = 2 := by
  rw [NumberField.Units.rank, card_eq_nrRealPlaces_add_nrComplexPlaces,
    nrRealPlaces_eq_three hmin hgen, nrComplexPlaces_eq_zero hmin hgen]

end TauCeti.NumberField.Cubic148
