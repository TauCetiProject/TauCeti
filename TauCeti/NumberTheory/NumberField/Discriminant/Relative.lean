module

public import Mathlib.NumberTheory.NumberField.Discriminant.Different
public import TauCeti.RingTheory.DedekindDomain.Discriminant.Separable

/-!
# Relative discriminants of number fields

This file specializes the relative discriminant ideal to rings of integers. It identifies the
relative discriminant over `ℤ` with the principal ideal generated by the signed absolute
discriminant, and states transitivity with the field degree as exponent.

## Main results

* `TauCeti.NumberField.relDiscr_int_ringOfIntegers`: the relative discriminant over `ℤ` is
  generated by `NumberField.discr`.
* `TauCeti.NumberField.relDiscr_tower`: the relative discriminant formula in a tower of number
  fields.
-/

public section

open scoped NumberField nonZeroDivisors

namespace TauCeti.NumberField

variable (K : Type*) [Field K] [NumberField K]

/-- The relative discriminant of the ring of integers of a number field over `ℤ` is the ideal
generated by its signed absolute discriminant. -/
@[simp]
theorem relDiscr_int_ringOfIntegers :
    relDiscr ℤ (𝓞 K) = Ideal.span {NumberField.discr K} := by
  rw [relDiscr_def, Ideal.relNorm_int, NumberField.absNorm_differentIdeal K (𝓞 K),
    Int.span_natAbs]

/-- The relative discriminant satisfies the transitivity formula in a tower of number fields. -/
theorem relDiscr_tower {L M : Type*} [Field L] [NumberField L] [Field M] [NumberField M]
    [Algebra K L] [Algebra L M] [Algebra K M] [IsScalarTower K L M] :
    relDiscr (𝓞 K) (𝓞 M) =
      relDiscr (𝓞 K) (𝓞 L) ^ Module.finrank L M *
        Ideal.relNorm (𝓞 K) (relDiscr (𝓞 L) (𝓞 M)) := by
  rw [TauCeti.relDiscr_tower (A := 𝓞 K) (B := 𝓞 L) (C := 𝓞 M),
    ← IsFractionRing.finrank_eq (𝓞 L) L (𝓞 M) M]

end TauCeti.NumberField

end
