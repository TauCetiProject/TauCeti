module

public import Mathlib.NumberTheory.NumberField.Basic
public import Mathlib.RingTheory.Ideal.Norm.AbsNorm
import Mathlib.NumberTheory.NumberField.Norm

/-!
# Norm of the ideal generated by a quadratic radical

The square of the ideal generated by an integral square root of `-p` is `(p)`.
In degree two, taking ideal norms therefore gives norm `p` for the original ideal.
-/

public section

open scoped NumberField

namespace NumberField

/-- In a quadratic number field, the ideal generated by an integral square root of `-p`
has absolute norm `p`. -/
theorem absNorm_span_singleton_of_sq_eq_neg_natCast {K : Type*} [Field K] [NumberField K]
    (hK : Module.finrank ℚ K = 2) {p : ℕ} {π : 𝓞 K} (hπ : π ^ 2 = -(p : 𝓞 K)) :
    Ideal.absNorm (Ideal.span {π}) = p := by
  have hsq : (Ideal.span {π}) ^ 2 = Ideal.span {(p : 𝓞 K)} := by
    rw [Ideal.span_singleton_pow, hπ, Ideal.span_singleton_neg]
  have hnorm := congrArg (fun I : Ideal (𝓞 K) ↦ I.absNorm) hsq
  simp only [map_pow, Ideal.absNorm_span_natCast, RingOfIntegers.rank, hK] at hnorm
  exact Nat.pow_left_injective (by decide : (2 : ℕ) ≠ 0) hnorm

end NumberField
