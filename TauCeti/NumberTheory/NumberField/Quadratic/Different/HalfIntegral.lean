module

public import TauCeti.NumberTheory.NumberField.Quadratic.Model
public import Mathlib.RingTheory.DedekindDomain.Different
import TauCeti.RingTheory.DedekindDomain.Different.Monogenic

/-!
# The different of a quadratic field of odd discriminant

For a squarefree radicand `d ≡ 1 (mod 4)`, the different is generated by `√d`, even though
it is `(1 + √d) / 2` that generates the ring of integers. This identifies the base factor in
the different of a tower over the quadratic field.

The formula is the quadratic case of the monogenic different formula (Neukirch,
*Algebraic Number Theory*, Chapter III, §2).
-/

public section

open Polynomial NumberField
open scoped NumberField

namespace TauCeti.NumberField

/-- If `θ` generates the number field `K` and has minimal polynomial `X² − d` for squarefree
`d ≡ 1 (mod 4)`, the absolute different is generated by `θ`. -/
theorem differentIdeal_eq_span_gen_of_mod_four_eq_one {K : Type*} [Field K] [NumberField K]
    {θ : 𝓞 K} {d : ℤ} (hmin : minpoly ℤ θ = X ^ 2 - C d)
    (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) (hsf : Squarefree d) (hd : d % 4 = 1) :
    differentIdeal ℤ (𝓞 K) = Ideal.span {θ} := by
  have hω : 2 * halfGen hmin hd - 1 = θ := by
    apply RingOfIntegers.coe_injective
    simp only [map_sub, map_mul, map_ofNat, map_one, ← RingOfIntegers.coe_eq_algebraMap,
      coe_halfGen]
    ring
  rw [differentIdeal_eq_span_aeval_derivative_minpoly ℤ ℚ K (𝓞 K) (halfGen hmin hd)
    (adjoin_halfGen_eq_top_of_mod_four_eq_one hmin hgen hsf hd), minpoly_halfGen]
  simpa [map_ofNat] using congrArg (fun x : 𝓞 K ↦ Ideal.span {x}) hω

end TauCeti.NumberField

namespace TauCeti.QuadraticAlgebra

open _root_.QuadraticAlgebra

/-- The different of the model `ℚ(√d)` for squarefree `d ≡ 1 (mod 4)` is the ideal generated
by its distinguished square root `ω`. -/
theorem differentIdeal_eq_span_integralSqrt_of_mod_four_eq_one {d : ℤ} [Fact (¬ IsSquare d)]
    (hsf : Squarefree d) (hd : d % 4 = 1) :
    differentIdeal ℤ (𝓞 (QuadraticAlgebra ℚ (d : ℚ) 0)) =
      Ideal.span {integralSqrt (omega_sq_eq_algebraMap_int (d := d))} :=
  TauCeti.NumberField.differentIdeal_eq_span_gen_of_mod_four_eq_one minpoly_integralSqrt_omega
    adjoin_integralSqrt_omega hsf hd

end TauCeti.QuadraticAlgebra
