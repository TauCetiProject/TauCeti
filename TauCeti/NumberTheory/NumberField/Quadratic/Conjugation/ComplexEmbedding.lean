module

public import Mathlib.NumberTheory.NumberField.InfinitePlace.Embeddings
public import TauCeti.NumberTheory.NumberField.Quadratic.Conjugation.Basic
import TauCeti.FieldTheory.Galois.Basic
import TauCeti.NumberTheory.NumberField.Quadratic.InfinitePlace

/-!
# Complex conjugation in quadratic fields

`NumberField.ComplexEmbedding.isConj_iff_not_isReal` characterizes when the nonidentity
automorphism of a quadratic extension of ℚ induces complex conjugation. It uses
`Algebra.IsQuadraticExtension.algEquiv_eq_one_or_eq` and Mathlib's
`ComplexEmbedding.isConj_ne_one_iff` and `ComplexEmbedding.exists_comp_symm_eq_of_comp_eq`.

`NumberField.ComplexEmbedding.isConj_quadraticConj_iff` identifies complex conjugation with
`NumberField.quadraticConj`, the automorphism taking the generator to its negative, exactly
when the radicand is negative. It combines the characterization with the real and complex
signature criteria for quadratic presentations.
-/

public section

open Polynomial

namespace NumberField.ComplexEmbedding

/-- The nonidentity automorphism of a quadratic extension of ℚ induces complex conjugation
under an embedding into ℂ exactly when the embedding is nonreal. -/
theorem isConj_iff_not_isReal {K : Type*} [Field K] [Algebra ℚ K]
    [Algebra.IsQuadraticExtension ℚ K] {φ : K →+* ℂ} {σ : K ≃ₐ[ℚ] K} (hσ : σ ≠ 1) :
    IsConj φ σ ↔ ¬ IsReal φ := by
  refine ⟨fun h ↦ (isConj_ne_one_iff h).mp hσ, fun hφ ↦ ?_⟩
  have : IsGalois ℚ K := Algebra.IsQuadraticExtension.isGalois_of_algEquiv_ne_one ℚ K hσ
  have hcomp : φ.comp (algebraMap ℚ K) = (conjugate φ).comp (algebraMap ℚ K) :=
    Subsingleton.elim _ _
  obtain ⟨τ, hτ⟩ := exists_comp_symm_eq_of_comp_eq φ (conjugate φ) hcomp
  have hconj : IsConj φ τ.symm := hτ.symm
  have hne : τ.symm ≠ 1 := (isConj_ne_one_iff hconj).mpr hφ
  exact hconj.ext_iff.mp
    ((Algebra.IsQuadraticExtension.algEquiv_eq_one_or_eq ℚ K hσ τ.symm).resolve_left hne)

/-- Under any complex embedding of a number field generated by an algebraic integer with minimal
polynomial `X² - d`, complex conjugation induces quadratic conjugation exactly when `d < 0`. -/
theorem isConj_quadraticConj_iff {K : Type*} [Field K] [NumberField K]
    (φ : K →+* ℂ) {θ : 𝓞 K} {d : ℤ} (hmin : minpoly ℤ θ = X ^ 2 - C d)
    (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) :
    IsConj φ (quadraticConj hmin hgen) ↔ d < 0 := by
  have : Algebra.IsQuadraticExtension ℚ K := ⟨finrank_rat_eq_two hmin hgen⟩
  rw [isConj_iff_not_isReal (quadraticConj_ne_one hmin hgen)]
  refine ⟨fun h ↦ ?_, fun hd ↦ ?_⟩
  · by_contra! hd
    let := isTotallyReal_of_minpoly_eq_X_sq_sub_C_of_nonneg hmin hgen hd
    exact h (IsTotallyReal.complexEmbedding_isReal φ)
  · let := isTotallyComplex_of_minpoly_eq_X_sq_sub_C_of_neg hmin hd
    exact IsTotallyComplex.complexEmbedding_not_isReal φ

end NumberField.ComplexEmbedding
