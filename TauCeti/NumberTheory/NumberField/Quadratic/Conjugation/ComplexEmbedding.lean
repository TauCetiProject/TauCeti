module

public import Mathlib.NumberTheory.NumberField.InfinitePlace.Embeddings
public import TauCeti.NumberTheory.NumberField.Quadratic.Conjugation.Basic
import TauCeti.FieldTheory.Galois.Basic
import TauCeti.NumberTheory.NumberField.Quadratic.InfinitePlace

/-!
# Complex conjugation in presented quadratic fields

`NumberField.ComplexEmbedding.isConj_quadraticConj_iff` identifies complex conjugation with
`NumberField.quadraticConj`, the automorphism taking the generator to its negative, exactly
when the radicand is negative. The result uses the real and complex signature criteria for
quadratic presentations, `Algebra.IsQuadraticExtension.algEquiv_eq_one_or_eq` and Mathlib's
`ComplexEmbedding.IsConj`.
-/

public section

open Polynomial

namespace NumberField.ComplexEmbedding

/-- Under any complex embedding of a number field generated by an algebraic integer with minimal
polynomial `X² - d`, complex conjugation induces quadratic conjugation exactly when `d < 0`. -/
theorem isConj_quadraticConj_iff {K : Type*} [Field K] [NumberField K]
    (φ : K →+* ℂ) {θ : 𝓞 K} {d : ℤ} (hmin : minpoly ℤ θ = X ^ 2 - C d)
    (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) :
    IsConj φ (quadraticConj hmin hgen) ↔ d < 0 := by
  have hne := quadraticConj_ne_one hmin hgen
  refine ⟨fun h ↦ ?_, fun hd ↦ ?_⟩
  · by_contra! hd
    let := isTotallyReal_of_minpoly_eq_X_sq_sub_C_of_nonneg hmin hgen hd
    exact ((isConj_ne_one_iff h).mp hne) (IsTotallyReal.complexEmbedding_isReal φ)
  · let := isTotallyComplex_of_minpoly_eq_X_sq_sub_C_of_neg hmin hd
    have : Algebra.IsQuadraticExtension ℚ K := ⟨finrank_rat_eq_two hmin hgen⟩
    have := Algebra.IsQuadraticExtension.isGalois_of_algEquiv_ne_one ℚ K hne
    obtain ⟨σ, hσ⟩ := exists_comp_symm_eq_of_comp_eq (k := ℚ) φ (conjugate φ)
      (RingHom.ext fun r ↦ by simp [eq_ratCast])
    have hconj : IsConj φ σ.symm := hσ.symm
    rcases Algebra.IsQuadraticExtension.algEquiv_eq_one_or_eq ℚ K hne σ.symm with h | h
    · exact ((isConj_ne_one_iff hconj).mpr
        (IsTotallyComplex.complexEmbedding_not_isReal φ) h).elim
    · exact h ▸ hconj

end NumberField.ComplexEmbedding
