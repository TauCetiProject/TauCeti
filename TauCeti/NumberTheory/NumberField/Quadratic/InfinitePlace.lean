module

public import TauCeti.NumberTheory.NumberField.Quadratic.Basic
public import TauCeti.NumberTheory.NumberField.InfinitePlace.Basic
public import TauCeti.NumberTheory.NumberField.QuadraticAlgebra

/-!
# The infinite places of a quadratic field `ℚ(√d)`

The signature of `ℚ(√d)` is read off the sign of `d`: for `d < 0` the field is totally complex
and for `0 ≤ d` it is totally real. Both are special cases of the generic square-root criteria
`NumberField.isTotallyComplex_of_sq_ratCast_of_neg` and
`NumberField.isTotallyReal_of_sq_ratCast_of_nonneg`, applied to the generator `θ` with `θ² = d`.
Total reality needs the generator hypothesis as well, since a real square root only forces the
embeddings fixed on `ℚ(θ)` to be real. Combining them,
`NumberField.isTotallyComplex_iff_neg_of_sq_ratCast` shows that `ℚ(√d)` is totally complex exactly
when `d < 0`, both for a presented field and for the model `QuadraticAlgebra ℚ a 0` of a nonsquare
rational `a`.

## Main results

* `NumberField.isTotallyComplex_of_minpoly_eq_X_sq_sub_C_of_neg`.
* `NumberField.isTotallyReal_of_minpoly_eq_X_sq_sub_C_of_nonneg`.
* `NumberField.isTotallyComplex_iff_neg_of_minpoly_eq_X_sq_sub_C`: `ℚ(θ)` with `θ² = d` is totally
  complex exactly when `d < 0`.
* `NumberField.exists_minpoly_eq_X_sq_sub_C_and_adjoin_eq_top_of_isTotallyComplex`: an imaginary
  quadratic field has a presentation with negative squarefree radicand.
* `QuadraticAlgebra.isTotallyComplex_iff`: `QuadraticAlgebra ℚ a 0` is totally complex exactly
  when `a < 0`.
-/

public section

open Polynomial NumberField

namespace NumberField

variable {K : Type*} [Field K] [NumberField K] {θ : 𝓞 K} {d : ℤ}

/-- **An imaginary quadratic field is totally complex.** Any number field `K` containing an
algebraic integer `θ` with `minpoly ℤ θ = X² - d` and `d < 0` is totally complex — in particular the
imaginary quadratic field `ℚ(√d)`. -/
theorem isTotallyComplex_of_minpoly_eq_X_sq_sub_C_of_neg (hmin : minpoly ℤ θ = X ^ 2 - C d)
    (hd : d < 0) : IsTotallyComplex K :=
  isTotallyComplex_of_sq_ratCast_of_neg (x := (θ : K)) (r := (d : ℚ))
    (coe_gen_sq_ratCast hmin) (by exact_mod_cast hd)

/-- **A real quadratic field is totally real.** A number field `K` generated over `ℚ` by an
algebraic integer `θ` with `minpoly ℤ θ = X² - d` and `0 ≤ d` is totally real — in particular
the real quadratic field `ℚ(√d)`. -/
theorem isTotallyReal_of_minpoly_eq_X_sq_sub_C_of_nonneg (hmin : minpoly ℤ θ = X ^ 2 - C d)
    (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) (hd : 0 ≤ d) : IsTotallyReal K :=
  isTotallyReal_of_sq_ratCast_of_nonneg (x := (θ : K)) (r := (d : ℚ))
    (coe_gen_sq_ratCast hmin) hgen (by exact_mod_cast hd)

/-- **A quadratic field `ℚ(√d)` is imaginary exactly when `d < 0`.** For a number field generated
by an algebraic integer `θ` with `minpoly ℤ θ = X² - d`, total complexity is equivalent to the
negativity of the radicand. -/
theorem isTotallyComplex_iff_neg_of_minpoly_eq_X_sq_sub_C (hmin : minpoly ℤ θ = X ^ 2 - C d)
    (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) : IsTotallyComplex K ↔ d < 0 := by
  rw [isTotallyComplex_iff_neg_of_sq_ratCast (coe_gen_sq_ratCast hmin) hgen, Int.cast_lt_zero]

/-- **Imaginary quadratic fields have negative squarefree radicands.** A totally complex number
field of degree `2` over `ℚ` is generated by an algebraic integer `θ` with minimal polynomial
`X² - d` for a negative squarefree integer `d`. -/
theorem exists_minpoly_eq_X_sq_sub_C_and_adjoin_eq_top_of_isTotallyComplex [IsTotallyComplex K]
    (hK : Module.finrank ℚ K = 2) :
    ∃ (θ : 𝓞 K) (d : ℤ), minpoly ℤ θ = X ^ 2 - C d ∧ Algebra.adjoin ℚ {(θ : K)} = ⊤ ∧
      Squarefree d ∧ d < 0 := by
  obtain ⟨θ, d, hmin, hgen, hd⟩ := exists_minpoly_eq_X_sq_sub_C_and_adjoin_eq_top hK
  exact ⟨θ, d, hmin, hgen, hd,
    (isTotallyComplex_iff_neg_of_minpoly_eq_X_sq_sub_C hmin hgen).mp inferInstance⟩

end NumberField

namespace QuadraticAlgebra

/-- **The model `ℚ(√a)` is imaginary exactly when `a < 0`.** For a nonsquare rational `a`, the
number field `QuadraticAlgebra ℚ a 0`, generated by `ω` with `ω² = a`, is totally complex exactly
when `a` is negative. -/
@[simp] theorem isTotallyComplex_iff {a : ℚ} [Fact (¬ IsSquare a)] :
    IsTotallyComplex (QuadraticAlgebra ℚ a 0) ↔ a < 0 := by
  have hω : (ω : QuadraticAlgebra ℚ a 0) ^ 2 = algebraMap ℚ _ a := by
    simp [sq, omega_mul_omega_eq_algebraMap]
  exact isTotallyComplex_iff_neg_of_sq_ratCast hω adjoin_omega_eq_top

end QuadraticAlgebra
