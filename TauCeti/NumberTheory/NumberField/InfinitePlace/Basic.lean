/-!
# Totally real and totally complex fields at infinite places

An extension of a totally real field is unramified at every infinite place exactly when it is
itself totally real. Indeed, a complex place above a real place is precisely a ramified infinite
place.

Every infinite place restricts to a real place on the maximal real subfield. Consequently, it
ramifies over that subfield exactly when it is complex, without any algebraicity assumption.

A field containing an element whose square is a negative rational is totally complex: a real
embedding would send that element to a real square root of a negative number. A totally complex
field, having only complex infinite places, is then unramified at every infinite place in any
extension, and in degree `2` it has exactly one such place.

Restricting a real place along a field embedding gives a real place, and the real embedding of the
restriction is the composite of the embeddings. For an extension `L / k`, a place of `L` lies over
a place `v` of `k` exactly when its restriction to `k` is `v`. If `w` lies over `v`, then
`w.embedding` and its conjugate restrict to `v.embedding` and its conjugate, in one order or the
other.

An infinite place is archimedean, since it takes the value `2` at `2`, and is therefore never
equivalent to a nonarchimedean absolute value. In characteristic zero it restricts to the real
absolute value on `ℚ`.

## Main results

* `NumberField.IsTotallyReal.of_isUnramifiedAtInfinitePlaces`: an everywhere-unramified
  extension of a totally real field is totally real.
* `NumberField.isUnramifiedAtInfinitePlaces_iff_isTotallyReal`: the resulting characterization.
* `NumberField.InfinitePlace.isRamified_maximalRealSubfield_iff`: a place ramifies over the
  maximal real subfield exactly when it is complex.
* `NumberField.isTotallyReal_of_sq_ratCast_of_nonneg`: a nonnegative square generating the field
  forces total reality.
* `NumberField.isTotallyComplex_of_sq_ratCast_of_neg`: a negative square forces total
  complexity.
* `NumberField.IsTotallyComplex.isUnramifiedAtInfinitePlaces`: a totally complex base is
  unramified at all infinite places of any extension.
* `NumberField.InfinitePlace.nrComplexPlaces_eq_one_of_finrank_eq_two`: a totally complex
  field of degree `2` — an imaginary quadratic field — has exactly one complex place.
* `NumberField.IsTotallyComplex.not_isTotallyReal`: a field with an infinite place, such as a
  number field, is not both totally complex and totally real.
* `NumberField.isTotallyComplex_iff_neg_of_sq_ratCast`: a field generated by a square root of a
  rational `r` is totally complex exactly when `r < 0`.
* `NumberField.InfinitePlace.even_nrComplexPlaces_iff_zero_lt_discr`: Brill's theorem in parity
  form, the number of complex places is even exactly when the discriminant is positive; hence
  `nrComplexPlaces_eq_zero_of_zero_lt_discr` (degree less than `4`),
  `nrComplexPlaces_eq_one_of_discr_lt_zero` (degree less than `6`) and
  `NumberField.IsTotallyReal.of_zero_lt_discr` read the signature off the sign of the
  discriminant in low degree, and `NumberField.IsTotallyComplex.of_discr_lt_zero` shows that a
  quadratic field of negative discriminant is totally complex, with converse
  `NumberField.IsTotallyComplex.discr_lt_zero`.
* `NumberField.IsTotallyComplex.of_finrank_le_two_mul_nrComplexPlaces`: a field is totally complex
  as soon as its complex places use up the degree.
* `NumberField.IsTotallyReal.nontrivial_ringHom_real`: a totally real field of degree greater
  than one has two distinct real embeddings.
* `NumberField.InfinitePlace.finrank_sub_nrRealPlaces_div_two_eq_nrComplexPlaces`: halving the
  degree less the real places counts the complex places, for any number field.
* `NumberField.InfinitePlace.nrRealPlaces_add_nrComplexPlaces_pos`: a number field has at least
  one infinite place.
* `NumberField.InfinitePlace.embedding_of_isReal_comap`: the real embedding of a restricted real
  place.
* `NumberField.InfinitePlace.liesOver_comap`: a place lies over its restriction.
* `NumberField.InfinitePlace.liesOver_iff_comap_eq`: lying over a place is having it as the
  restriction.
* `NumberField.InfinitePlace.LiesOver.embedding_comp_eq_and_conjugate_embedding_comp_eq_or`: the
  embedding of a place and its conjugate restrict to the embedding of the place below and its
  conjugate, in one order or the other.
* `NumberField.InfinitePlace.mk_eq_mk_iff_of_isUnramified`: embeddings with a common restriction
  and the same unramified infinite place are equal.
* `NumberField.InfinitePlace.not_isNonarchimedean`: an infinite place is archimedean.
* `NumberField.InfinitePlace.under_rat`: an infinite place restricts to the real absolute value
  on `ℚ`.
* `NumberField.InfinitePlace.not_isEquiv_of_isNonarchimedean`: an infinite place is never
  equivalent to a nonarchimedean absolute value.
* `NumberField.IsTotallyReal.instIsEmptyIsComplex`: a totally real field has no complex infinite
  places.
-/

public section

open NumberField NumberField.InfinitePlace
open scoped ComplexOrder

namespace NumberField

variable {K : Type*} [Field K]

/-- A totally real field has no complex infinite places. -/
instance IsTotallyReal.instIsEmptyIsComplex [IsTotallyReal K] :
    IsEmpty {w : InfinitePlace K // w.IsComplex} :=
  ⟨fun w ↦ not_isReal_iff_isComplex.mpr w.property (IsTotallyReal.isReal w.val)⟩

/-- **An extension of a totally real field unramified at infinity is totally real.** If every
infinite place of `K` is unramified over a totally real field `k`, then every infinite place of
`K` is real: the only other alternative in `InfinitePlace.isUnramified_iff` would make its
restriction a complex place of `k`. -/
theorem IsTotallyReal.of_isUnramifiedAtInfinitePlaces {k : Type*} [Field k] [Algebra k K]
    [IsTotallyReal k] [IsUnramifiedAtInfinitePlaces k K] : IsTotallyReal K where
  isReal w := (isUnramified_iff.mp (isUnramified (k := k) w)).resolve_right
    (not_isComplex_iff_isReal.mpr (IsTotallyReal.isReal _))

/-- **A totally real extension is unramified at every infinite place.** Every infinite place of
the extension is real, and real places are unramified (`InfinitePlace.IsReal.isUnramified`). -/
theorem IsTotallyReal.isUnramifiedAtInfinitePlaces {k : Type*} [Field k] [Algebra k K]
    [IsTotallyReal K] : IsUnramifiedAtInfinitePlaces k K where
  isUnramified w := (IsTotallyReal.isReal w).isUnramified k

/-- Over a totally real base, an extension is unramified at every infinite place exactly
when it is totally real. -/
@[simp] theorem isUnramifiedAtInfinitePlaces_iff_isTotallyReal {k : Type*} [Field k] [Algebra k K]
    [IsTotallyReal k] : IsUnramifiedAtInfinitePlaces k K ↔ IsTotallyReal K :=
  ⟨fun _ ↦ IsTotallyReal.of_isUnramifiedAtInfinitePlaces (k := k),
    fun _ ↦ IsTotallyReal.isUnramifiedAtInfinitePlaces⟩

/-- A place ramifies over the maximal real subfield exactly when it is complex. Its restriction
is real because every element of the maximal real subfield is real under every embedding of `K`.
No algebraicity assumption on `K` is needed. -/
@[simp]
theorem InfinitePlace.isRamified_maximalRealSubfield_iff (w : InfinitePlace K) :
    w.IsRamified (maximalRealSubfield K) ↔ w.IsComplex := by
  have hreal : (w.comap (algebraMap (maximalRealSubfield K) K)).IsReal := by
    rw [← mk_embedding w, comap_mk, isReal_mk_iff, ComplexEmbedding.isReal_iff]
    ext x
    exact (mem_maximalRealSubfield_iff (x : K)).mp x.property w.embedding
  simp only [isRamified_iff, hreal, and_true]

/-- **A field generated by a nonnegative rational square root is totally real.** If `K = ℚ(x)`,
`x² = r`, and `r ≥ 0`, then every complex embedding of `K` is real. Each embedding sends `x` to a
complex number whose square is the nonnegative real number `r`, so its imaginary part vanishes;
the generator hypothesis determines the embedding on all of `K`. -/
theorem isTotallyReal_of_sq_ratCast_of_nonneg [Algebra ℚ K] {x : K} {r : ℚ}
    (hx2 : x ^ 2 = algebraMap ℚ K r) (hgen : Algebra.adjoin ℚ {x} = ⊤) (hr : 0 ≤ r) :
    IsTotallyReal K := by
  refine ⟨fun w ↦ InfinitePlace.isReal_iff.mpr (ComplexEmbedding.isReal_iff.mpr ?_)⟩
  -- The embedding and its conjugate agree on the generator `x`, whose image squares to `r ≥ 0`.
  have halg : (ComplexEmbedding.conjugate w.embedding).toRatAlgHom =
      w.embedding.toRatAlgHom := by
    apply AlgHom.ext_of_adjoin_eq_top hgen
    rintro y rfl
    simp only [RingHom.toRatAlgHom_apply]
    rw [ComplexEmbedding.conjugate_coe_eq, Complex.conj_eq_iff_im]
    apply Complex.sq_nonneg_iff.mp
    rw [← map_pow, hx2, eq_ratCast (algebraMap ℚ K), map_ratCast, ← Complex.ofReal_ratCast]
    exact Complex.zero_le_real.mpr (Rat.cast_nonneg.mpr hr)
  exact RingHom.ext (AlgHom.congr_fun halg)

/-- **A field with a negative square is totally complex.** If some `x : K` has `x² = r` for a
negative rational `r`, then every infinite place of `K` is complex. -/
theorem isTotallyComplex_of_sq_ratCast_of_neg [Algebra ℚ K] {x : K} {r : ℚ}
    (hx2 : x ^ 2 = algebraMap ℚ K r)
    (hr : r < 0) : IsTotallyComplex K := by
  -- A real embedding would carry `x` to a real square root of `r < 0`, which is impossible.
  refine ⟨fun w ↦ isComplex_iff.mpr fun hφ ↦ hr.not_ge ?_⟩
  have hsq : hφ.embedding x ^ 2 = (r : ℝ) := by
    rw [← map_pow, hx2, eq_ratCast (algebraMap ℚ K), map_ratCast]
  exact Rat.cast_nonneg.mp (hsq ▸ sq_nonneg _)

/-- **A totally complex base is unramified at all infinite places.** Since a totally complex field
has only complex infinite places and a complex place never ramifies, every infinite place is
unramified in any extension `K` of a totally complex field `k`. -/
theorem IsTotallyComplex.isUnramifiedAtInfinitePlaces {k : Type*} [Field k] [Algebra k K]
    [IsTotallyComplex k] : IsUnramifiedAtInfinitePlaces k K where
  isUnramified _ := isUnramified_iff.mpr (.inr (IsTotallyComplex.isComplex _))

/-- **A field with an infinite place is not both totally complex and totally real.** That place
cannot be both complex and real. Every number field has an infinite place. -/
theorem IsTotallyComplex.not_isTotallyReal [Nonempty (InfinitePlace K)] [IsTotallyComplex K] :
    ¬ IsTotallyReal K := fun _ ↦
  not_isReal_iff_isComplex.mpr (IsTotallyComplex.isComplex (Classical.arbitrary (InfinitePlace K)))
    (IsTotallyReal.isReal _)

/-- **A field generated by a rational square root is totally complex exactly when the square is
negative.** If `K = ℚ(x)` with `x² = r`, then `K` is totally complex exactly when `r < 0`: a
negative square forces total complexity, while a nonnegative one forces total reality, and a number
field is never both. -/
theorem isTotallyComplex_iff_neg_of_sq_ratCast [Algebra ℚ K] {x : K} {r : ℚ}
    (hx2 : x ^ 2 = algebraMap ℚ K r) (hgen : Algebra.adjoin ℚ {x} = ⊤) :
    IsTotallyComplex K ↔ r < 0 := by
  have : CharZero K := charZero_of_injective_algebraMap (algebraMap ℚ K).injective
  obtain rfl : ‹Algebra ℚ K› = DivisionRing.toRatAlgebra := Subsingleton.elim _ _
  have hint : IsIntegral ℚ x := ⟨Polynomial.X ^ 2 - Polynomial.C r,
    Polynomial.monic_X_pow_sub_C _ two_ne_zero, by simp [hx2]⟩
  have := Algebra.finite_adjoin_simple_of_isIntegral hint
  have : NumberField K :=
    { to_finiteDimensional := Module.Finite.equiv
        ((Subalgebra.equivOfEq _ _ hgen).trans Subalgebra.topEquiv).toLinearEquiv }
  refine ⟨fun _ => lt_of_not_ge fun hr => ?_, isTotallyComplex_of_sq_ratCast_of_neg hx2⟩
  exact IsTotallyComplex.not_isTotallyReal (isTotallyReal_of_sq_ratCast_of_nonneg hx2 hgen hr)

section NumberField

variable [NumberField K]

/-- **A totally complex field of degree `2` has exactly one complex place.** Such a field
satisfies `Module.finrank ℚ K = 2 * nrComplexPlaces K`, so degree `2` leaves exactly one
complex place; with `NumberField.IsTotallyComplex.nrRealPlaces_eq_zero` it is the field's only
infinite place. This is the imaginary quadratic case. -/
theorem InfinitePlace.nrComplexPlaces_eq_one_of_finrank_eq_two [IsTotallyComplex K]
    (hK : Module.finrank ℚ K = 2) : InfinitePlace.nrComplexPlaces K = 1 := by
  have := NumberField.IsTotallyComplex.finrank (K := K)
  omega

variable (K) in
/-- **Halving the degree less the real places counts the complex places.** The degree is
`r₁ + 2 r₂`, so subtracting the real places and halving leaves the complex ones. -/
theorem InfinitePlace.finrank_sub_nrRealPlaces_div_two_eq_nrComplexPlaces :
    (Module.finrank ℚ K - nrRealPlaces K) / 2 = nrComplexPlaces K := by
  have key := card_add_two_mul_card_eq_rank K
  omega

variable (K) in
/-- A number field has at least one infinite place: `0 < r₁ + r₂`. -/
theorem InfinitePlace.nrRealPlaces_add_nrComplexPlaces_pos :
    0 < nrRealPlaces K + nrComplexPlaces K := by
  rw [← card_eq_nrRealPlaces_add_nrComplexPlaces]
  exact Fintype.card_pos

variable (K) in
/-- **Brill's theorem, parity form.** The number of complex places is even exactly when the
discriminant is positive. -/
theorem InfinitePlace.even_nrComplexPlaces_iff_zero_lt_discr :
    Even (nrComplexPlaces K) ↔ 0 < discr K := by
  rw [← Int.sign_eq_one_iff_pos, sign_discr, neg_one_pow_eq_one_iff_even (by decide)]

/-- **The signature in degree less than `4`, positive discriminant.** Such a number field has no
complex place. -/
theorem InfinitePlace.nrComplexPlaces_eq_zero_of_zero_lt_discr (hd : 0 < discr K)
    (hK : Module.finrank ℚ K < 4) : nrComplexPlaces K = 0 := by
  have h := card_add_two_mul_card_eq_rank K
  obtain ⟨k, hk⟩ := (InfinitePlace.even_nrComplexPlaces_iff_zero_lt_discr K).mpr hd
  omega

/-- **The signature in degree less than `6`, negative discriminant.** Such a number field has
exactly one complex place: the number of complex places is odd and at most `2`. -/
theorem InfinitePlace.nrComplexPlaces_eq_one_of_discr_lt_zero (hd : discr K < 0)
    (hK : Module.finrank ℚ K < 6) : nrComplexPlaces K = 1 := by
  have h := card_add_two_mul_card_eq_rank K
  obtain ⟨k, hk⟩ := Nat.not_even_iff_odd.mp
    (mt (InfinitePlace.even_nrComplexPlaces_iff_zero_lt_discr K).mp hd.not_gt)
  omega

/-- A number field of degree less than `4` with positive discriminant is totally real. -/
theorem IsTotallyReal.of_zero_lt_discr (hd : 0 < discr K) (hK : Module.finrank ℚ K < 4) :
    IsTotallyReal K :=
  nrComplexPlaces_eq_zero_iff.mp (InfinitePlace.nrComplexPlaces_eq_zero_of_zero_lt_discr hd hK)

/-- A number field whose complex places use up the degree, `[K : ℚ] ≤ 2 r₂`, is totally complex:
the converse of Mathlib's `NumberField.IsTotallyComplex.finrank`. -/
theorem IsTotallyComplex.of_finrank_le_two_mul_nrComplexPlaces
    (h : Module.finrank ℚ K ≤ 2 * nrComplexPlaces K) : IsTotallyComplex K := by
  have h' := card_add_two_mul_card_eq_rank K
  exact nrRealPlaces_eq_zero_iff.mp (by omega)

/-- A number field of degree `2` with negative discriminant, an imaginary quadratic field, is
totally complex: its single complex place uses up the degree. -/
theorem IsTotallyComplex.of_discr_lt_zero (hd : discr K < 0) (hK : Module.finrank ℚ K = 2) :
    IsTotallyComplex K :=
  .of_finrank_le_two_mul_nrComplexPlaces <| by
    rw [hK, InfinitePlace.nrComplexPlaces_eq_one_of_discr_lt_zero hd (by omega)]

/-- A totally complex number field of degree `2`, an imaginary quadratic field, has negative
discriminant: the converse of `NumberField.IsTotallyComplex.of_discr_lt_zero`. Its single complex
place is odd in number, so by Brill's theorem the discriminant is not positive, and it is
nonzero. -/
theorem IsTotallyComplex.discr_lt_zero [IsTotallyComplex K] (hK : Module.finrank ℚ K = 2) :
    discr K < 0 := by
  have h := (InfinitePlace.even_nrComplexPlaces_iff_zero_lt_discr K).not.mp
    (by simp [InfinitePlace.nrComplexPlaces_eq_one_of_finrank_eq_two hK])
  exact lt_of_le_of_ne (not_lt.mp h) (discr_ne_zero K)

/-- A totally real number field of degree greater than one has two distinct real embeddings:
each of its complex embeddings, of which there are as many as the degree, is real. -/
theorem IsTotallyReal.nontrivial_ringHom_real [IsTotallyReal K]
    (hK : 1 < Module.finrank ℚ K) : Nontrivial (K →+* ℝ) := by
  rw [← Embeddings.card K ℂ, Fintype.one_lt_card_iff] at hK
  obtain ⟨φ, ψ, hφψ⟩ := hK
  have hφ := IsTotallyReal.complexEmbedding_isReal φ
  have hψ := IsTotallyReal.complexEmbedding_isReal ψ
  refine ⟨⟨hφ.embedding, hψ.embedding, fun h ↦ hφψ (RingHom.ext fun x ↦ ?_)⟩⟩
  rw [← hφ.coe_embedding_apply, ← hψ.coe_embedding_apply, h]

end NumberField

/-- The real embedding of the restriction of a real place `w` along `f` is the real embedding of
`w` composed with `f`. -/
@[simp]
theorem InfinitePlace.embedding_of_isReal_comap {k : Type*} [Field k] (f : k →+* K)
    {w : InfinitePlace K} (hw : w.IsReal) :
    embedding_of_isReal (hw.comap f) = (embedding_of_isReal hw).comp f :=
  RingHom.ext fun x ↦ Complex.ofReal_injective <| by
    simp [comap_embedding_of_isReal _ (hw.comap f)]

/-- An infinite place of `K` lies over its restriction to `k`.

Mathlib's `AbsoluteValue.LiesOver` instance is this statement for `AbsoluteValue.under`, which is
not the spelling `InfinitePlace.comap` produces, so it is registered here. Constructions indexed by
`w.comap (algebraMap k K)` that consume a `LiesOver` hypothesis, such as
`AbsoluteValue.Completion.map`, need it. -/
instance InfinitePlace.liesOver_comap {k : Type*} [Field k] [Algebra k K]
    (w : InfinitePlace K) : w.LiesOver (w.comap (algebraMap k K)) :=
  ⟨rfl⟩

/-- An infinite place of `K` lies over an infinite place `v` of `k` exactly when its restriction
to `k` is `v`. -/
theorem InfinitePlace.liesOver_iff_comap_eq {k : Type*} [Field k] [Algebra k K]
    {w : InfinitePlace K} {v : InfinitePlace k} :
    w.LiesOver v ↔ w.comap (algebraMap k K) = v :=
  ⟨fun _ ↦ InfinitePlace.LiesOver.comap_eq w v, fun h ↦ h ▸ InfinitePlace.liesOver_comap w⟩

/-- If `w` lies over `v`, the embedding of `w` and its conjugate restrict to the embedding of `v`
and its conjugate, in one order or the other. This pairs the restriction of `w.embedding` given by
`InfinitePlace.LiesOver.embedding_comp_eq_or_conjugate_embedding_comp_eq` with the matching
restriction of its conjugate. -/
theorem InfinitePlace.LiesOver.embedding_comp_eq_and_conjugate_embedding_comp_eq_or
    {k : Type*} [Field k] [Algebra k K]
    (w : InfinitePlace K) (v : InfinitePlace k) [w.LiesOver v] :
    (w.embedding.comp (algebraMap k K) = v.embedding ∧
      (ComplexEmbedding.conjugate w.embedding).comp (algebraMap k K) =
        ComplexEmbedding.conjugate v.embedding) ∨
    (w.embedding.comp (algebraMap k K) = ComplexEmbedding.conjugate v.embedding ∧
      (ComplexEmbedding.conjugate w.embedding).comp (algebraMap k K) = v.embedding) := by
  rcases embedding_comp_eq_or_conjugate_embedding_comp_eq w v with h | h
  · exact .inl ⟨h, by rw [ComplexEmbedding.conjugate_comp, h]⟩
  · refine .inr ⟨?_, h⟩
    rw [← h, ComplexEmbedding.conjugate_comp]
    exact (ComplexEmbedding.involutive_conjugate k _).symm

/-- Two complex embeddings over a common restriction agree if they induce the same infinite
place and that place is unramified over the base. -/
theorem InfinitePlace.mk_eq_mk_iff_of_isUnramified {L : Type*} [Field L] [Algebra K L]
    {φ ψ : L →+* ℂ} (h : φ.comp (algebraMap K L) = ψ.comp (algebraMap K L))
    (hφ : (mk φ).IsUnramified K) : mk φ = mk ψ ↔ φ = ψ := by
  refine ⟨fun he ↦ ?_, congrArg mk⟩
  rcases mk_eq_iff.mp he with he | hc
  · exact he
  have hr : ComplexEmbedding.IsReal (φ.comp (algebraMap K L)) := by
    rw [ComplexEmbedding.isReal_iff, ← ComplexEmbedding.conjugate_comp, hc, h]
  have hφreal := (isUnramified_mk_iff_isUnmixed.mp hφ) hr
  exact (ComplexEmbedding.isReal_iff.mp hφreal).symm.trans hc

/-- An infinite place is archimedean: it takes the value `2` at `2`. -/
theorem InfinitePlace.not_isNonarchimedean (v : InfinitePlace K) : ¬IsNonarchimedean v.val := by
  intro h
  have := h.apply_natCast_le_one (n := 2) (by simp) (by simp)
  rw [← InfinitePlace.coe_apply, v.map_natCast] at this
  norm_num at this

/-- An infinite place of a field of characteristic zero restricts to the real absolute value on
`ℚ`. -/
@[simp]
theorem InfinitePlace.under_rat [CharZero K] (v : InfinitePlace K) :
    v.val.under ℚ = Rat.AbsoluteValue.real := by
  ext q
  rw [AbsoluteValue.under_apply, ← coe_apply, ← v.norm_embedding_eq, eq_ratCast (algebraMap ℚ K),
    map_ratCast, Complex.norm_ratCast]
  rfl

/-- An infinite place is never equivalent to a nonarchimedean absolute value. -/
theorem InfinitePlace.not_isEquiv_of_isNonarchimedean (v : InfinitePlace K)
    {w : AbsoluteValue K ℝ} (hw : IsNonarchimedean w) : ¬ v.val.IsEquiv w := by
  intro h
  obtain ⟨c, hc, hcw⟩ := AbsoluteValue.isEquiv_iff_exists_rpow_eq.mp h.symm
  have hv : v.val = w.nonarchRpow hw hc :=
    AbsoluteValue.ext fun x ↦ by rw [w.nonarchRpow_apply, ← congrFun hcw x]
  exact v.not_isNonarchimedean (hv ▸ w.isNonarchimedean_nonarchRpow hw hc)

end NumberField
