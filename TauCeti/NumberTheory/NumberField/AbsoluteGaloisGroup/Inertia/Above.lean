module

public import Mathlib.NumberTheory.NumberField.Basic
public import Mathlib.RingTheory.Valuation.RamificationGroup
public import TauCeti.RingTheory.Valuation.Center

/-!
# The inertia above a set of finite places

Let `E` be a field (a number field in the case of interest) inside a field `Ω`, and
`Gal(Ω/E) = Ω ≃ₐ[E] Ω`. A *place* of `Ω` is a valuation subring `A` of `Ω`. It lies over the
finite place `v` of `E` when it contains `𝓞 E` and `𝓞 E ∩ 𝔪_A = v`, which is
`ValuationSubring.IsCenteredAt A v`. Its inertia group `I_A ≤ Gal(Ω/E)` is Mathlib's
`ValuationSubring.inertiaSubgroup`, a subgroup of the decomposition group of `A`, read in
`Gal(Ω/E)`. For a set `T` of finite places of `E`, `I_T ⊆ Gal(Ω/E)`
(`TauCeti.GaloisRep.inertiaAbove E Ω T`) is the union of the `I_A` over the places `A` of `Ω` above
the places of `T`. Conditions of being unramified outside a set `S` of finite places are
conditions on `I_{Sᶜ}`: for instance, the Galois cocycles unramified outside `S` are those
vanishing on `I_{Sᶜ}` (`TauCeti/NumberTheory/GaloisRepresentation/SelmerModule.lean`).

For a number field `E` and `Ω = E^alg`, the places of `Ω` above `v` correspond to the maximal ideals
of the algebraic integers over `v`, and their inertia groups are those of
`TauCeti.GaloisRep.inertiaGroup`
(`TauCeti.GaloisRep.inertiaGroup_eq_map_inertiaSubgroup`, in
`TauCeti/NumberTheory/NumberField/AbsoluteGaloisGroup/ValuationSubring.lean`). For `Ω` a
separable closure, the closed subgroup generated by the inertia at the finite places outside `S`,
built from the absolute Galois groups of the completions, is
`TauCeti.RestrictedRamification.inertiaOutsideSubgroup`. The set `I_T` here is the union of the
inertia groups itself, at the places of an arbitrary extension `Ω`, which is the form in which
vanishing conditions on maps out of `Gal(Ω/E)` are stated.

## Main definitions

* `TauCeti.GaloisRep.inertiaAbove E Ω T`: the union `I_T` of the inertia groups at the places of
  `Ω` above the places of `T`.

## Main results

* `TauCeti.GaloisRep.mem_inertiaAbove_iff`: membership in `I_T`.
* `TauCeti.GaloisRep.map_inertiaSubgroup_subset_inertiaAbove`: the inertia group of a place of `Ω`
  above a place of `T` lies in `I_T`.
* `TauCeti.GaloisRep.inertiaAbove_mono`, `TauCeti.GaloisRep.inertiaAbove_empty`,
  `TauCeti.GaloisRep.inertiaAbove_union`: `I_T` is monotone in `T`, and a union over `T`.

## References

* [J. Neukirch, *Algebraic Number Theory*][Neukirch1992], Chapter I, §9, for decomposition and
  inertia groups.

## Provenance

The set `I_T` and its name follow `New.inertiaAbove` (`src/Lib/ClassField/Local/ArtinMap.lean`)
in grh-lean (https://github.com/lsernau/grh-lean, Apache 2.0, Copyright 2026 Anthropic, PBC).
**Adapted, not copied**: it is stated here with Mathlib's `ValuationSubring.inertiaSubgroup` and
Tau Ceti's `ValuationSubring.IsCenteredAt`, for any field extension `Ω` of `E`.
-/

public section

open IsDedekindDomain NumberField

namespace TauCeti.GaloisRep

variable (E Ω : Type*) [Field E] [Field Ω] [Algebra E Ω]

/-- **The inertia above a set of finite places.** For a set `T` of finite places of `E`, the union
`I_T ⊆ Gal(Ω/E)` of the inertia groups `I_A` at the places of `Ω` above the places of `T`: the
valuation subrings `A` of `Ω` that contain `𝓞 E` and meet it in a prime `v ∈ T`. -/
noncomputable def inertiaAbove (T : Set (HeightOneSpectrum (𝓞 E))) : Set (Ω ≃ₐ[E] Ω) :=
  ⋃ v ∈ T, ⋃ (A : ValuationSubring Ω) (_ : A.IsCenteredAt v.asIdeal),
    ((A.inertiaSubgroup E).map (A.decompositionSubgroup E).subtype : Set (Ω ≃ₐ[E] Ω))

variable {E Ω} {T T' : Set (HeightOneSpectrum (𝓞 E))} {σ : Ω ≃ₐ[E] Ω}

/-- `σ` lies in `I_T` exactly when it lies in the inertia group of a place of `Ω` above a place
of `T`. -/
@[simp]
theorem mem_inertiaAbove_iff :
    σ ∈ inertiaAbove E Ω T ↔ ∃ v ∈ T, ∃ A : ValuationSubring Ω, A.IsCenteredAt v.asIdeal ∧
      σ ∈ (A.inertiaSubgroup E).map (A.decompositionSubgroup E).subtype := by
  simp only [inertiaAbove, Set.mem_iUnion, SetLike.mem_coe, exists_prop]

/-- The inertia group of a place of `Ω` above a place of `T` lies in `I_T`. -/
theorem map_inertiaSubgroup_subset_inertiaAbove {v : HeightOneSpectrum (𝓞 E)} (hv : v ∈ T)
    {A : ValuationSubring Ω} (hA : A.IsCenteredAt v.asIdeal) :
    ((A.inertiaSubgroup E).map (A.decompositionSubgroup E).subtype : Set (Ω ≃ₐ[E] Ω)) ⊆
      inertiaAbove E Ω T :=
  fun _ hσ ↦ mem_inertiaAbove_iff.mpr ⟨v, hv, A, hA, hσ⟩

/-- `I_T` is monotone in `T`. -/
theorem inertiaAbove_mono : Monotone (inertiaAbove E Ω) :=
  fun _ _ h ↦ Set.biUnion_subset_biUnion_left h

/-- Above no places there is no inertia. -/
@[simp]
theorem inertiaAbove_empty : inertiaAbove E Ω ∅ = ∅ := by
  simp [inertiaAbove]

/-- `I_{T ∪ T'} = I_T ∪ I_{T'}`. -/
theorem inertiaAbove_union : inertiaAbove E Ω (T ∪ T') = inertiaAbove E Ω T ∪ inertiaAbove E Ω T' :=
  Set.biUnion_union T T' _

end TauCeti.GaloisRep
