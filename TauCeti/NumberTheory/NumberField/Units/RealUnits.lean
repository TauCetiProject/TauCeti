module

public import Mathlib.NumberTheory.NumberField.CMField
import TauCeti.NumberTheory.NumberField.Units.Torsion

/-!
# Real units and unit-subgroup quotient comparisons

For a field `K`, Mathlib defines the subgroup of real units `NumberField.IsCMField.realUnits K`
inside `(𝓞 K)ˣ` and the Hasse unit index `NumberField.IsCMField.indexRealUnits K`, equal to the
index of `realUnits K ⊔ torsion K` in `(𝓞 K)ˣ`.

In any totally real field, every unit is real and `indexRealUnits K = 1`. More generally, whenever
`indexRealUnits K = 1`, any subgroup `D ≤ (𝓞 K)ˣ` containing `torsion K` is generated by
`torsion K` and its preimage `D⁺` in `(𝓞 K⁺)ˣ`, inclusion induces a canonical isomorphism
`(𝓞 K⁺)ˣ ⧸ D⁺ ≃* (𝓞 K)ˣ ⧸ D`, and `D⁺` and `D` have the same index in their respective unit
groups.

## Main definitions

* `TauCeti.realQuotientEquivOfIndexRealUnitsEqOne`: for `indexRealUnits K = 1` and
  `torsion K ≤ D`, the isomorphism `(𝓞 K⁺)ˣ ⧸ D⁺ ≃* (𝓞 K)ˣ ⧸ D` induced by inclusion.

## Main results

* `TauCeti.realUnits_sup_torsion_eq_top_iff`: `realUnits K ⊔ torsion K = ⊤ ↔ indexRealUnits K = 1`.
* `TauCeti.realUnits_eq_top_of_isTotallyReal` and `TauCeti.indexRealUnits_eq_one_of_isTotallyReal`:
  every totally real field satisfies `realUnits K = ⊤` and `indexRealUnits K = 1`.
* `TauCeti.sup_map_comap_realUnits_eq`: for `indexRealUnits K = 1` and `torsion K ≤ D`, `D` is
  generated by `torsion K` and the image of `D⁺`.
* `TauCeti.comap_realUnits_le_of_le_torsion_sup`: if `D ≤ torsion K ⊔ S.map ι` and `-1 ∈ S`, then
  `D⁺ ≤ S`.
* `TauCeti.index_comap_realUnits_eq`: for `indexRealUnits K = 1` and `torsion K ≤ D`, the preimage
  `D⁺` in `(𝓞 K⁺)ˣ` has the same index as `D` in `(𝓞 K)ˣ`.

## References

* L. C. Washington, *Introduction to Cyclotomic Fields*, Chapter 4.
* R. Sharifi, *Iwasawa Theory*, §4.2.
-/

public section

open NumberField NumberField.Units NumberField.IsCMField

open scoped NumberField

namespace TauCeti

section TotallyReal

variable (K : Type*) [Field K]

/-- The Hasse unit index equals `1` if and only if real units and roots of unity generate
`(𝓞 K)ˣ`. -/
theorem realUnits_sup_torsion_eq_top_iff :
    realUnits K ⊔ torsion K = ⊤ ↔ indexRealUnits K = 1 :=
  Subgroup.index_eq_one.symm

/-- In a totally real field, every unit lies in `realUnits K`. -/
theorem realUnits_eq_top_of_isTotallyReal [IsTotallyReal K] : realUnits K = ⊤ := by
  rw [eq_top_iff]
  intro u _
  rw [mem_realUnits_iff]
  have hmem (x : K) : x ∈ maximalRealSubfield K := by
    rw [IsTotallyReal.maximalRealSubfield_eq_top]
    trivial
  let toReal (x : 𝓞 K) : 𝓞 (maximalRealSubfield K) :=
    ⟨⟨(x : K), hmem (x : K)⟩, isIntegral_algebraMap_iff.mp x.isIntegral_coe⟩
  have htoReal_mul (x y : 𝓞 K) : toReal (x * y) = toReal x * toReal y := by ext; rfl
  have htoReal_one : toReal 1 = 1 := by ext; rfl
  exact ⟨⟨toReal (u : 𝓞 K), toReal (↑u⁻¹ : 𝓞 K),
    by rw [← htoReal_mul, Units.mul_inv, htoReal_one],
    by rw [← htoReal_mul, Units.inv_mul, htoReal_one]⟩, rfl⟩

/-- Every totally real field has Hasse unit index `1`. -/
theorem indexRealUnits_eq_one_of_isTotallyReal [IsTotallyReal K] : indexRealUnits K = 1 := by
  rw [indexRealUnits, realUnits_eq_top_of_isTotallyReal K, top_sup_eq, Subgroup.index_top]

end TotallyReal

section QuotientComparison

variable {K : Type*} [Field K]

/-- When `indexRealUnits K = 1`, any subgroup `D ≤ (𝓞 K)ˣ` containing `torsion K` is generated by
`torsion K` and the real units lying in `D`. -/
theorem sup_map_comap_realUnits_eq {D : Subgroup (𝓞 K)ˣ} (hQ : indexRealUnits K = 1)
    (hT : torsion K ≤ D) :
    torsion K ⊔ (D.comap (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom)).map
      (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) = D := by
  set ι : (𝓞 (maximalRealSubfield K))ˣ →* (𝓞 K)ˣ :=
    Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
  refine le_antisymm (sup_le hT (Subgroup.map_comap_le _ _)) ?_
  intro u hu
  have hmem : u ∈ realUnits K ⊔ torsion K :=
    ((realUnits_sup_torsion_eq_top_iff K).mpr hQ).symm ▸ Subgroup.mem_top u
  obtain ⟨r, ⟨v, rfl⟩, t, ht, rfl⟩ := Subgroup.mem_sup.mp hmem
  have hv : v ∈ D.comap ι := by
    rw [Subgroup.mem_comap]
    simpa [ι] using D.mul_mem hu (D.inv_mem (hT ht))
  rw [mul_comm]
  exact Subgroup.mul_mem_sup ht (Subgroup.mem_map_of_mem ι hv)

/-- If `D ≤ torsion K ⊔ S.map ι` and `-1 ∈ S`, then the preimage of `D` in `(𝓞 K⁺)ˣ` is contained
in `S`. -/
theorem comap_realUnits_le_of_le_torsion_sup [NumberField K] {D : Subgroup (𝓞 K)ˣ}
    {S : Subgroup (𝓞 (maximalRealSubfield K))ˣ}
    (hneg : (-1 : (𝓞 (maximalRealSubfield K))ˣ) ∈ S)
    (hle : D ≤ torsion K ⊔
      S.map (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom)) :
    D.comap (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) ≤ S := by
  set ι : (𝓞 (maximalRealSubfield K))ˣ →* (𝓞 K)ˣ :=
    Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
  intro v hv
  obtain ⟨t, ht, -, ⟨s, hs, rfl⟩, hts⟩ := Subgroup.mem_sup.mp (hle hv)
  have hvs_tors : v * s⁻¹ ∈ torsion (maximalRealSubfield K) := by
    have hι_eq : ι (v * s⁻¹) = t := by rw [map_mul, map_inv, ← hts, mul_inv_cancel_right]
    have hinj : Function.Injective ι := fun x y hxy ↦
      Units.ext (RingOfIntegers.coe_injective (Subtype.ext
        (by simpa [ι] using congrArg (fun z : (𝓞 K)ˣ ↦ (z : K)) hxy)))
    exact hinj.isOfFinOrder_iff.mp (hι_eq ▸ ht)
  obtain ⟨w⟩ := (inferInstance : Nonempty (InfinitePlace (maximalRealSubfield K)))
  rcases TauCeti.NumberField.Units.torsion_eq_one_or_neg_one_of_isReal
      (IsTotallyReal.isReal w) ⟨v * s⁻¹, hvs_tors⟩ with h1 | h1
  · exact (mul_inv_eq_one.mp (by simpa using h1)) ▸ hs
  · have hvs : v = (-1 : (𝓞 (maximalRealSubfield K))ˣ) * s := by
      have h1' : v * s⁻¹ = -1 := by simpa using h1
      rw [← h1', mul_assoc, inv_mul_cancel, mul_one]
    exact hvs ▸ S.mul_mem hneg hs

/-- When `indexRealUnits K = 1`, the canonical map from `(𝓞 K⁺)ˣ` into `(𝓞 K)ˣ ⧸ D` is surjective
for every subgroup `D ≤ (𝓞 K)ˣ` containing `torsion K`. -/
theorem surjective_quotientMk_comp_realUnits {D : Subgroup (𝓞 K)ˣ} (hQ : indexRealUnits K = 1)
    (hT : torsion K ≤ D) :
    Function.Surjective ((QuotientGroup.mk' D).comp
      (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom)) := by
  intro q
  obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective D q
  have hmem : u ∈ realUnits K ⊔ torsion K :=
    ((realUnits_sup_torsion_eq_top_iff K).mpr hQ).symm ▸ Subgroup.mem_top u
  obtain ⟨r, ⟨v, rfl⟩, t, ht, rfl⟩ := Subgroup.mem_sup.mp hmem
  refine ⟨v, ?_⟩
  simp only [MonoidHom.comp_apply, QuotientGroup.mk'_apply, QuotientGroup.eq]
  simpa using D.inv_mem (hT ht)

/-- When `indexRealUnits K = 1` and `torsion K ≤ D`, inclusion of real units induces an isomorphism
`(𝓞 K⁺)ˣ ⧸ D⁺ ≃* (𝓞 K)ˣ ⧸ D`. -/
noncomputable def realQuotientEquivOfIndexRealUnitsEqOne {D : Subgroup (𝓞 K)ˣ}
    (hQ : indexRealUnits K = 1) (hT : torsion K ≤ D) :
    (𝓞 (maximalRealSubfield K))ˣ ⧸
      D.comap (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
        𝓞 (maximalRealSubfield K) →* 𝓞 K)) ≃*
      (𝓞 K)ˣ ⧸ D :=
  let ι : (𝓞 (maximalRealSubfield K))ˣ →* (𝓞 K)ˣ :=
    Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) : 𝓞 (maximalRealSubfield K) →* 𝓞 K)
  (QuotientGroup.quotientMulEquivOfEq (by
    ext x
    simp [ι, MonoidHom.mem_ker, QuotientGroup.eq_one_iff])).trans
    (QuotientGroup.quotientKerEquivOfSurjective ((QuotientGroup.mk' D).comp ι)
      (surjective_quotientMk_comp_realUnits hQ hT))

/-- Evaluating `realQuotientEquivOfIndexRealUnitsEqOne` on a coset `QuotientGroup.mk v`. -/
@[simp]
theorem realQuotientEquivOfIndexRealUnitsEqOne_mk {D : Subgroup (𝓞 K)ˣ}
    (hQ : indexRealUnits K = 1) (hT : torsion K ≤ D) (v : (𝓞 (maximalRealSubfield K))ˣ) :
    realQuotientEquivOfIndexRealUnitsEqOne hQ hT (QuotientGroup.mk v) =
      QuotientGroup.mk (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
        𝓞 (maximalRealSubfield K) →* 𝓞 K) v) := by
  rfl

/-- When `indexRealUnits K = 1` and `torsion K ≤ D`, the preimage of `D` in `(𝓞 K⁺)ˣ` has the same
index as `D` in `(𝓞 K)ˣ`. -/
theorem index_comap_realUnits_eq {D : Subgroup (𝓞 K)ˣ} (hQ : indexRealUnits K = 1)
    (hT : torsion K ≤ D) :
    (D.comap (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom)).index =
      D.index := by
  rw [Subgroup.index_eq_card, Subgroup.index_eq_card]
  exact Nat.card_congr (realQuotientEquivOfIndexRealUnitsEqOne hQ hT).toEquiv

end QuotientComparison

end TauCeti
