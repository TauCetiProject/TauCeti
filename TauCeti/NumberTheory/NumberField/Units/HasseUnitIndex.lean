module

public import Mathlib.NumberTheory.NumberField.CMField
import TauCeti.Algebra.Group.Subgroup.Map

/-!
# The Hasse unit index and real-unit quotients

For a CM field `K` with maximal real subfield `K⁺`, the Hasse unit index
`NumberField.IsCMField.indexRealUnits K` is the index in `(𝓞 K)ˣ` of the subgroup generated by
the real units and the roots of unity. Mathlib shows that it is `1` or `2`, and that it is `2`
exactly when some unit `u` has `u / conj u` generating the roots of unity of `K`.

For any field `K` and any subgroup `H ≤ (𝓞 K)ˣ`, let `H⁺` denote its preimage in `(𝓞 K⁺)ˣ`
under the real-unit inclusion `Units.map (algebraMap (𝓞 K⁺) (𝓞 K)).toMonoidHom`. Whenever the
real units and `H` generate `(𝓞 K)ˣ` (`realUnits K ⊔ H = ⊤`) — in particular, when the Hasse
unit index `indexRealUnits K` is `1` and `H` contains the roots of unity `torsion K` — the
real-unit inclusion induces a quotient isomorphism `(𝓞 K⁺)ˣ ⧸ H⁺ ≃* (𝓞 K)ˣ ⧸ H`, so the index
`[(𝓞 K)ˣ : H]` can be computed in the maximal real subfield as `[(𝓞 K⁺)ˣ : H⁺]`.

This file also proves a norm criterion valid in every CM field for `indexRealUnits K = 1`. Let `ζ`
be a root of unity of `K`. If `u / conj u = -ζ` for a unit `u`, then `(ζ - 1) / u` is fixed by
complex conjugation, so it lies in `K⁺`. Its norm to `ℚ` is then the square of its norm from `K⁺`.
So, up to sign, `N_{K/ℚ}(ζ - 1)` is a rational square.

## Main results

* `TauCeti.NumberField.IsCMField.quotientRealUnitsEquiv`: when `realUnits K ⊔ H = ⊤`, the
  real-unit inclusion induces an isomorphism `(𝓞 K⁺)ˣ ⧸ H⁺ ≃* (𝓞 K)ˣ ⧸ H`, where `H⁺` is the
  preimage of `H` in `(𝓞 K⁺)ˣ`.
* `TauCeti.NumberField.IsCMField.index_comap_unitsMap_maximalRealSubfield_eq`: equality of indices
  `[(𝓞 K⁺)ˣ : H⁺] = [(𝓞 K)ˣ : H]` under the same hypothesis.
* `TauCeti.NumberField.IsCMField.indexRealUnits_eq_one_of_not_isSquare_abs_norm`: if `K` is CM
  and `|N_{K/ℚ}(ζ - 1)|` is not a rational square for some root of unity `ζ` of `K`, then the
  Hasse unit index of `K` is `1`.

## References

* L. C. Washington, *Introduction to Cyclotomic Fields*, 2nd ed., Graduate Texts in Mathematics
  83, Springer, 1997, Corollary 4.13.
* R. Sharifi, *Iwasawa theory*, lecture notes, Lemmas 4.2.17 and 4.2.19.
-/

public section

open NumberField NumberField.Units NumberField.IsCMField

namespace TauCeti.NumberField.IsCMField

section Quotient

/-- **Real-to-full unit quotient isomorphism (Sharifi, Lemma 4.2.19).** When `realUnits K` and
`H ≤ (𝓞 K)ˣ` generate `(𝓞 K)ˣ` (in particular, when `indexRealUnits K = 1` and `H` contains the
roots of unity), the inclusion of real units induces an isomorphism `(𝓞 K⁺)ˣ ⧸ H⁺ ≃* (𝓞 K)ˣ ⧸ H`,
where `H⁺` is the preimage of `H` in `(𝓞 K⁺)ˣ`. -/
noncomputable def quotientRealUnitsEquiv (K : Type*) [Field K]
    (H : Subgroup (𝓞 K)ˣ) (h : realUnits K ⊔ H = ⊤) :
    (𝓞 (maximalRealSubfield K))ˣ ⧸
        H.comap (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
          𝓞 (maximalRealSubfield K) →* 𝓞 K)) ≃*
      (𝓞 K)ˣ ⧸ H :=
  QuotientGroup.liftEquiv _
    ((QuotientGroup.surjective_mk'_comp_iff
      (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
        𝓞 (maximalRealSubfield K) →* 𝓞 K))).mpr h)
    (by rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk'])

/-- Applying `quotientRealUnitsEquiv` to a coset of a real unit gives the coset of its image in
`(𝓞 K)ˣ`. -/
@[simp]
theorem quotientRealUnitsEquiv_mk (K : Type*) [Field K]
    (H : Subgroup (𝓞 K)ˣ) (h : realUnits K ⊔ H = ⊤)
    (u : (𝓞 (maximalRealSubfield K))ˣ) :
    quotientRealUnitsEquiv K H h (QuotientGroup.mk u) =
      QuotientGroup.mk
        (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
          𝓞 (maximalRealSubfield K) →* 𝓞 K) u) := by
  rw [quotientRealUnitsEquiv, QuotientGroup.liftEquiv_mk, MonoidHom.comp_apply,
    QuotientGroup.mk'_apply]

/-- Applying the inverse of `quotientRealUnitsEquiv` to the coset of a real unit recovers its
coset in `(𝓞 K⁺)ˣ`. -/
@[simp]
theorem quotientRealUnitsEquiv_symm_mk_map (K : Type*) [Field K]
    (H : Subgroup (𝓞 K)ˣ) (h : realUnits K ⊔ H = ⊤)
    (u : (𝓞 (maximalRealSubfield K))ˣ) :
    (quotientRealUnitsEquiv K H h).symm
        (QuotientGroup.mk
          (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
          𝓞 (maximalRealSubfield K) →* 𝓞 K) u)) =
      QuotientGroup.mk u :=
  (MulEquiv.symm_apply_eq _).mpr (quotientRealUnitsEquiv_mk K H h u).symm

/-- **Real and full unit indices coincide when real units and `H` generate `(𝓞 K)ˣ`.** In
particular, when `indexRealUnits K = 1` and `torsion K ≤ H`, the preimage of `H` in `(𝓞 K⁺)ˣ`
has the same index as `H` in `(𝓞 K)ˣ`. -/
theorem index_comap_unitsMap_maximalRealSubfield_eq (K : Type*) [Field K]
    (H : Subgroup (𝓞 K)ˣ) (h : realUnits K ⊔ H = ⊤) :
    (H.comap (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
          𝓞 (maximalRealSubfield K) →* 𝓞 K))).index =
      H.index :=
  Nat.card_congr (quotientRealUnitsEquiv K H h).toEquiv

end Quotient

section CMField

variable (K : Type*) [Field K] [_root_.NumberField K] [_root_.NumberField.IsCMField K]

/-- If `u / conj u = -ζ` for a unit `u` and a root of unity `ζ`, then `(ζ - 1) / u` lies in the
maximal real subfield, so `|N_{K/ℚ}(ζ - 1)|` is a rational square. -/
private theorem isSquare_abs_norm_of_unitsMulComplexConjInv_eq (ζ : torsion K) (u : (𝓞 K)ˣ)
    (hu : unitsMulComplexConjInv K u = ⟨-1, neg_one_mem_torsion⟩ * ζ) :
    IsSquare |Algebra.norm ℚ (((ζ : (𝓞 K)ˣ) : K) - 1)| := by
  have hc := complexConj_torsion K ζ
  set z : K := ((ζ : (𝓞 K)ˣ) : K)
  set w : K := algebraMap (𝓞 K) K u
  have h : w * (complexConj K w)⁻¹ = -z := by
    simpa [z, w, unitsMulComplexConjInv_apply, RingOfIntegers.coe_eq_algebraMap] using
      congrArg (fun t : torsion K ↦ (((t : (𝓞 K)ˣ) : 𝓞 K) : K)) hu
  have hw : w ≠ 0 := by simp [w]
  have hz : z ≠ 0 := by simp [z]
  have hfix : complexConj K ((z - 1) * w⁻¹) = (z - 1) * w⁻¹ := by
    have hcw : (complexConj K w)⁻¹ = -z * w⁻¹ := by
      rw [← h, mul_comm w, mul_inv_cancel_right₀ hw]
    rw [map_mul, map_inv₀, hcw, map_sub, map_one, hc]
    field_simp
    ring
  let x : maximalRealSubfield K := ⟨_, (complexConj_eq_self_iff K _).mp hfix⟩
  have hzw : z - 1 = algebraMap (maximalRealSubfield K) K x * w :=
    (inv_mul_cancel_right₀ hw _).symm
  refine ⟨Algebra.norm ℚ x, ?_⟩
  rw [hzw, map_mul, ← Algebra.norm_norm (S := maximalRealSubfield K), Algebra.norm_algebraMap,
    Algebra.IsQuadraticExtension.finrank_eq_two]
  simp [w, abs_mul, sq]

/-- **A norm criterion for Hasse unit index one.** If a CM field `K` has a root of unity `ζ` such
that `|N_{K/ℚ}(ζ - 1)|` is not a rational square, then the real units and the roots of unity
generate the units of `K`. -/
theorem indexRealUnits_eq_one_of_not_isSquare_abs_norm (ζ : torsion K)
    (hζ : ¬IsSquare |Algebra.norm ℚ (((ζ : (𝓞 K)ˣ) : K) - 1)|) :
    indexRealUnits K = 1 := by
  refine (indexRealUnits_eq_one_or_two K).resolve_right fun h2 ↦ hζ ?_
  obtain ⟨u, hu⟩ := (indexRealUnits_eq_two_iff K).mp h2
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp
    (hu ▸ Subgroup.mem_top ((⟨-1, neg_one_mem_torsion⟩ : torsion K) * ζ))
  exact isSquare_abs_norm_of_unitsMulComplexConjInv_eq K ζ (u ^ k) (by rw [map_zpow, hk])

end CMField

end TauCeti.NumberField.IsCMField

end
