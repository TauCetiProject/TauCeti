/-!
# The Hasse unit index of prime-power cyclotomic fields

For a CM field `K` with maximal real subfield `K⁺`, the Hasse unit index
`NumberField.IsCMField.indexRealUnits K` is the index in `(𝓞 K)ˣ` of the subgroup generated by
the real units and the roots of unity. Mathlib shows that it is `1` or `2`, and that it is `2`
exactly when some unit `u` has `u / conj u` generating the roots of unity of `K`.

This file proves that the index is `1` for every cyclotomic field of prime-power conductor
`p ^ a`, including the powers of `2`. When `p ^ a ≤ 2` the field is `ℚ`: it is not CM, but every
unit is a root of unity, so the index is again `1`. In other words the full unit group of
`ℚ(ζ_{p^a})` is generated by its roots of unity and its real units. A non-prime-power conductor
behaves differently: in `ℚ(ζ₁₂)` the element `1 - ζ₁₂` is a unit with `u / conj u = -ζ₁₂`, and
the index is `2`.

The prime-power case follows from a criterion valid in every CM field. Let `ζ` be a root of unity
of `K`. If `u / conj u = -ζ` for a unit `u`, then `(ζ - 1) / u` is fixed by complex conjugation,
so it lies in `K⁺`. Its norm to `ℚ` is then the square of its norm from `K⁺`. So, up to sign,
`N_{K/ℚ}(ζ - 1)` is a rational square. When `ζ` is a primitive `p ^ a`-th root of unity with
`p ^ a > 2`, that norm is the prime `p`, which is not a square.

## Main results

* `TauCeti.NumberField.IsCMField.indexRealUnits_eq_one_of_not_isSquare_abs_norm`: if `K` is CM
  and `|N_{K/ℚ}(ζ - 1)|` is not a rational square for some root of unity `ζ` of `K`, then the
  Hasse unit index of `K` is `1`.
* `TauCeti.IsCyclotomicExtension.Rat.indexRealUnits_eq_one_of_prime_pow`: the cyclotomic field of
  conductor `p ^ a` has Hasse unit index `1`, for every prime `p` and every `a`.
* `TauCeti.IsCyclotomicExtension.Rat.realUnits_sup_torsion_eq_top_of_prime_pow`: equivalently,
  its unit group is generated by the real units and the roots of unity.

## References

* L. C. Washington, *Introduction to Cyclotomic Fields*, 2nd ed., Graduate Texts in Mathematics
  83, Springer, 1997, Corollary 4.13.
* R. Sharifi, *Iwasawa theory*, lecture notes, Lemma 4.2.17.
-/

public section

open NumberField NumberField.Units NumberField.IsCMField

namespace TauCeti.NumberField.IsCMField

variable (K : Type*) [Field K] [_root_.NumberField K] [_root_.NumberField.IsCMField K]

/-- If `u / conj u = -ζ` for a unit `u` and a root of unity `ζ`, then `(ζ - 1) / u` lies in the
maximal real subfield, so `|N_{K/ℚ}(ζ - 1)|` is a rational square. -/
private theorem isSquare_abs_norm_of_unitsMulComplexConjInv_eq (ζ : torsion K) (u : (𝓞 K)ˣ)
    (hu : unitsMulComplexConjInv K u = ⟨-1, neg_one_mem_torsion⟩ * ζ) :
    IsSquare |Algebra.norm ℚ (((ζ : (𝓞 K)ˣ) : K) - 1)| := by
  have hc := complexConj_torsion K ζ
  set z : K := ((ζ : (𝓞 K)ˣ) : K)
  set w : K := algebraMap (𝓞 K) K u
  have h : w * (complexConj K w)⁻¹ = -z := by
    simpa [z, w, unitsMulComplexConjInv_apply, RingOfIntegers.coe_eq_algebraMap] using
      congrArg (fun t : torsion K ↦ (((t : (𝓞 K)ˣ) : 𝓞 K) : K)) hu
  have hw : w ≠ 0 := by simp [w]
  have hz : z ≠ 0 := by simp [z]
  have hfix : complexConj K ((z - 1) * w⁻¹) = (z - 1) * w⁻¹ := by
    have hcw : (complexConj K w)⁻¹ = -z * w⁻¹ := by
      rw [← h, mul_comm w, mul_inv_cancel_right₀ hw]
    rw [map_mul, map_inv₀, hcw, map_sub, map_one, hc]
    field_simp
    ring
  let x : maximalRealSubfield K := ⟨_, (complexConj_eq_self_iff K _).mp hfix⟩
  have hzw : z - 1 = algebraMap (maximalRealSubfield K) K x * w :=
    (inv_mul_cancel_right₀ hw _).symm
  refine ⟨Algebra.norm ℚ x, ?_⟩
  rw [hzw, map_mul, ← Algebra.norm_norm (S := maximalRealSubfield K), Algebra.norm_algebraMap,
    Algebra.IsQuadraticExtension.finrank_eq_two]
  simp [w, abs_mul, sq]

/-- **A norm criterion for Hasse unit index one.** If a CM field `K` has a root of unity `ζ` such
that `|N_{K/ℚ}(ζ - 1)|` is not a rational square, then the real units and the roots of unity
generate the units of `K`. -/
theorem indexRealUnits_eq_one_of_not_isSquare_abs_norm (ζ : torsion K)
    (hζ : ¬IsSquare |Algebra.norm ℚ (((ζ : (𝓞 K)ˣ) : K) - 1)|) :
    indexRealUnits K = 1 := by
  refine (indexRealUnits_eq_one_or_two K).resolve_right fun h2 ↦ hζ ?_
  obtain ⟨u, hu⟩ := (indexRealUnits_eq_two_iff K).mp h2
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp
    (hu ▸ Subgroup.mem_top ((⟨-1, neg_one_mem_torsion⟩ : torsion K) * ζ))
  exact isSquare_abs_norm_of_unitsMulComplexConjInv_eq K ζ (u ^ k) (by rw [map_zpow, hk])

end TauCeti.NumberField.IsCMField

namespace TauCeti.IsCyclotomicExtension.Rat

/-- **The Hasse unit index of a prime-power cyclotomic field is one.** For every prime `p` and
every `a`, including `p = 2`, the real units and the roots of unity generate the units of the
cyclotomic field of conductor `p ^ a`. When `p ^ a ≤ 2` the field is `ℚ`, every unit is a root of
unity, and the index is also `1`. -/
theorem indexRealUnits_eq_one_of_prime_pow (p a : ℕ) [hp : Fact p.Prime] (K : Type*) [Field K]
    [CharZero K] [IsCyclotomicExtension {p ^ a} ℚ K] : indexRealUnits K = 1 := by
  have := IsCyclotomicExtension.numberField {p ^ a} ℚ K
  rcases le_or_gt (p ^ a) 2 with h | h
  · -- The field is `ℚ`: it has one infinite place, so every unit is a root of unity.
    have hfin : Module.finrank ℚ K = 1 := by
      rw [IsCyclotomicExtension.finrank K
        (Polynomial.cyclotomic.irreducible_rat (pow_pos hp.out.pos a)), Nat.totient_eq_one_iff]
      have := pow_pos hp.out.pos a
      omega
    rw [indexRealUnits, TauCeti.NumberField.Units.torsion_eq_top_of_rank_eq_zero
      (rank_eq_zero_of_finrank_eq_one K hfin), sup_top_eq, Subgroup.index_top]
  · have := _root_.IsCyclotomicExtension.Rat.isCMField K (S := {p ^ a}) ⟨p ^ a, rfl, h⟩
    have ha : a ≠ 0 := by
      rintro rfl
      simp at h
    have hζ := IsCyclotomicExtension.zeta_spec (p ^ a) ℚ K
    let ζ : torsion K := ⟨(hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne _)).unit, by
      rw [torsion, CommGroup.mem_torsion, isOfFinOrder_iff_pow_eq_one]
      refine ⟨p ^ a, NeZero.pos _, Units.ext ?_⟩
      simpa using hζ.toInteger_isPrimitiveRoot.pow_eq_one⟩
    refine TauCeti.NumberField.IsCMField.indexRealUnits_eq_one_of_not_isSquare_abs_norm K ζ ?_
    have hnorm := hζ.sub_one_norm_isPrimePow (hp.out.isPrimePow.pow ha)
      (Polynomial.cyclotomic.irreducible_rat (NeZero.pos _)) h.ne'
    have hζ' : algebraMap (𝓞 K) K (ζ : (𝓞 K)ˣ) = IsCyclotomicExtension.zeta (p ^ a) ℚ K := by
      rw [← RingOfIntegers.coe_eq_algebraMap, IsUnit.unit_spec]
      exact hζ.coe_toInteger
    rw [hζ', hnorm]
    simpa [Nat.pow_minFac ha, hp.out.minFac_eq, Rat.isSquare_natCast_iff] using
      hp.out.prime.not_isSquare

/-- The units of the cyclotomic field of prime-power conductor `p ^ a` are generated by its real
units and its roots of unity. -/
theorem realUnits_sup_torsion_eq_top_of_prime_pow (p a : ℕ) [Fact p.Prime] (K : Type*) [Field K]
    [CharZero K] [IsCyclotomicExtension {p ^ a} ℚ K] : realUnits K ⊔ torsion K = ⊤ :=
  Subgroup.index_eq_one.mp (indexRealUnits_eq_one_of_prime_pow p a K)

end TauCeti.IsCyclotomicExtension.Rat

end
