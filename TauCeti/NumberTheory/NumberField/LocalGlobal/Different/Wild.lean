module

public import TauCeti.NumberTheory.NumberField.LocalGlobal.Different.Exponent
public import TauCeti.NumberTheory.LocalField.Different.Wild
public import TauCeti.RingTheory.DedekindDomain.AdicValuation.NatCastValuation

/-!
# The wild different bound for number fields

At a prime `w` of a number-field extension `L/K`, the exponent of the different is at most
`e(w/v) - 1 + v_w(e(w/v))`. The local different bound is transported through the canonical
completions at `v` and `w`. Both the different exponent and the valuation of the natural number
`e(w/v)` are expressed as multiplicities of ideals of `𝓞 L`.

In the wild case, the existing lower-bound criterion also gives `e(w/v)` as a lower bound.
Neither bound is always an equality: the dyadic examples `ℚ(i)` and `ℚ(√2)` attain different
endpoints.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter III, Theorem 2.6.
* J.-P. Serre, *Local Fields*, Chapter III, §6, Proposition 13.
-/

public section
noncomputable section

open IsDedekindDomain NumberField
open scoped AdicCompletionExtension NumberField

namespace IsDedekindDomain.HeightOneSpectrum

variable {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L]
  [Algebra K L] (v : HeightOneSpectrum (𝓞 K)) (w : HeightOneSpectrum (𝓞 L))
  [w.asIdeal.LiesOver v.asIdeal]

include v

/-- **The upper bound for the global different exponent.** The multiplicity of `w` in the
different is at most `e(w/v) - 1` plus the multiplicity of `w` in the ideal generated by
`e(w/v)`. -/
theorem multiplicity_differentIdeal_le_ramificationIdx_sub_one_add_multiplicity_span :
    multiplicity w.asIdeal (differentIdeal (𝓞 K) (𝓞 L)) ≤
      w.asIdeal.ramificationIdx (𝓞 K) - 1 +
        multiplicity w.asIdeal
          (Ideal.span {((w.asIdeal.ramificationIdx (𝓞 K) : ℕ) : 𝓞 L)}) := by
  let e := w.asIdeal.ramificationIdx (𝓞 K)
  have he : (e : w.adicCompletion L) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt (Ideal.ramificationIdx_pos (𝓞 K) w.asIdeal))
  have hlocal := TauCeti.differentExponent_le_ramificationIndex_sub_one_add_natCastValuation
    (K := v.adicCompletion K) (L := w.adicCompletion L) (by
      rw [ramificationIndex_adicCompletion v w]
      exact he)
  rw [differentExponent_adicCompletion_eq_multiplicity_differentIdeal v w,
    multiplicity_differentIdeal_adicCompletionIntegers_eq_multiplicity_asIdeal v w] at hlocal
  simpa only [ramificationIndex_adicCompletion,
    natCastValuation_completion_eq_multiplicity_span] using hlocal

end IsDedekindDomain.HeightOneSpectrum

end
