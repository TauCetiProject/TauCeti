/-!
# Stickelberger's relation

Let `K = ℚ(ζ_m)` be the `m`-th cyclotomic field, `m ≥ 2`. For `σ ∈ Gal(K/ℚ)` let
`c(σ) ∈ (ℤ/m)ˣ` be its class, so that `σ ζ = ζ ^ c(σ)` for every `m`-th root of unity `ζ`, and
read `c(σ)` as its representative in `[1, m)`. Let `P` be a prime of `𝓞 K` whose norm is prime
to `m`, and `Φ(P) = g(χ_P, ψ)^m` the Gauss sum power of `Ideal.stickelbergerPhi`. **Stickelberger's
relation** is the prime factorisation

  `(Φ(P)) = P ^ γ = ∏_σ (σ⁻¹ P) ^ c(σ)`, where `γ = ∑_{1 ≤ t < m, (t, m) = 1} t σ_t⁻¹`

is the Stickelberger element of `ℤ[Gal(K/ℚ)]`. By multiplicativity, `(Φ(A)) = A ^ γ` for every
ideal `A` whose norm is prime to `m`, and `(Φ((α))) = (α ^ γ)` for every `α` whose norm is prime
to `m`. The rational prime `p` below `P` is arbitrary: `p = 2` occurs when `m` is odd.

The relation is proved prime by prime. Let `q = p ^ f = N P`, so that `f` is the order of `p`
modulo `m`. In the auxiliary cyclotomic field `L = K(ζ_n)`, `n = p (q - 1)`, the ring of integers
contains a primitive `p`-th root of unity `ζ_p` and the Teichmüller character `ω` of the residue
field `𝓞 K ⧸ P` at a prime `𝔓` of `L` above `P`. Since `p` has ramification index `p - 1` in `L`,
`ζ_p - 1` has valuation one at `𝔓`. Moreover `χ_P = ω^{-(q - 1) / m}`, and
`σ(Φ(P)) = g(χ_P ^ c(σ), ψ)^m`, so Stickelberger's congruence
(`TauCeti.intValuation_gaussSum_inv_pow_div_mul_pow`) gives

  `v_P(σ(Φ(P))) = ∑_{i < f} (p ^ i c(σ) mod m)`.

The decomposition group of `P` corresponds to the subgroup of `(ℤ/m)ˣ` generated by `p`
(`IsCyclotomicExtension.Rat.galEquivZMod_stabilizer`), so the primes above `p` are the conjugates
of `P`, and the multiplicity of each in `P ^ γ` is a sum of the same shape over a coset of `⟨p⟩`.
Away from `p`, `Φ(P)` is a unit because `Φ(P) σ_{-1}(Φ(P)) = N(P)^m`.

## Main results

* `Ideal.intValuation_smul_stickelbergerPhi`: `v_P(σ(Φ(P))) = ∑_{i < f} (p ^ i c(σ) mod m)`.
* `Ideal.span_stickelbergerPhi_of_isMaximal`: `(Φ(P)) = ∏_σ (σ⁻¹ P) ^ c(σ)`.
* `Ideal.span_stickelbergerPhi`: `(Φ(A)) = ∏_σ (σ⁻¹ A) ^ c(σ)` for `A` prime to `m`.
* `Ideal.span_stickelbergerPhi_span_singleton`: `(Φ((α))) = (∏_σ (σ⁻¹ α) ^ c(σ))` for `α` prime
  to `m`.

## References

* S. A. Katre, *Gauss–Jacobi sums and Stickelberger's theorem*, §3, Lemmas 2–3 and
  Propositions 2, 3 and 3′; §4, Lemma 4 and Proposition 4 (i).
* S. D. Adhikari, *The early reciprocity laws: from Gauss to Eisenstein*, §4, Propositions 4.3
  and 4.4 (iii).
* L. C. Washington, *Introduction to Cyclotomic Fields*, 2nd ed., §6.2.
-/

public section

open NumberField

namespace Ideal

open UniqueFactorizationMonoid IsCyclotomicExtension.Rat
open scoped Pointwise

variable {K : Type*} [Field K] [NumberField K] {m : ℕ} [NeZero m]
  [IsCyclotomicExtension {m} ℚ K] [HasEnoughRootsOfUnity (𝓞 K) m]

/-- The valuation of `σ(Φ(P))` at `P`, computed through a prime `w` above `P` of a number field
`L ⊇ K` whose ring of integers contains a primitive `p`-th root of unity `ζ` with
`v_w(ζ - 1) = 1` and the `(N P - 1)`-th roots of unity. -/
private theorem intValuation_smul_stickelbergerPhi_of_liesOver (hm : 2 ≤ m) {p : ℕ}
    [Fact p.Prime] (hpm : ¬ p ∣ m) (v : IsDedekindDomain.HeightOneSpectrum (𝓞 K))
    [v.asIdeal.LiesOver (span {(p : ℤ)})] (σ : Gal(K/ℚ)) {L : Type*} [Field L] [NumberField L]
    [Algebra K L] [HasEnoughRootsOfUnity (𝓞 L) (absNorm v.asIdeal - 1)]
    (w : IsDedekindDomain.HeightOneSpectrum (𝓞 L)) [w.asIdeal.LiesOver v.asIdeal] {ζ : 𝓞 L}
    (hζ : IsPrimitiveRoot ζ p) (hζw : w.intValuation (ζ - 1) = WithZero.exp (-1)) :
    v.intValuation (σ • stickelbergerPhi v.asIdeal m) =
      WithZero.exp (-((∑ i ∈ Finset.range (orderOf (p : ZMod m)),
        p ^ i * (galEquivZMod m K σ : ZMod m).val % m : ℕ) : ℤ)) := by
  set P := v.asIdeal with hPdef
  have hp := (Fact.out : p.Prime)
  have : P.IsMaximal := v.isMaximal
  let _ := Ideal.Quotient.field P
  let _ : Fintype (𝓞 K ⧸ P) := Fintype.ofFinite _
  -- The residue field `𝓞 K ⧸ P` has `q = p ^ f` elements, `f` the order of `p` modulo `m`.
  have : CharP (𝓞 K ⧸ P) p := (CharP.charP_iff_prime_eq_zero hp).mpr <| by
    rw [← map_natCast (Ideal.Quotient.mk P), Ideal.Quotient.eq_zero_iff_mem]
    simpa using (mem_of_liesOver P (span {(p : ℤ)}) (p : ℤ)).1 (mem_span_singleton_self _)
  let _ : Algebra (ZMod p) (𝓞 K ⧸ P) := ZMod.algebra _ p
  have hq : p ^ inertiaDeg P ℤ = absNorm P := pow_inertiaDeg p P
  have hPm : (absNorm P).Coprime m :=
    hq ▸ Nat.Coprime.pow_left _ ((Nat.Prime.coprime_iff_not_dvd hp).2 hpm)
  have hcard : Fintype.card (𝓞 K ⧸ P) = absNorm P := by
    rw [absNorm_eq_natCard, Nat.card_eq_fintype_card]
  have hfin : Module.finrank (ZMod p) (𝓞 K ⧸ P) = orderOf (p : ZMod m) := by
    have h := Module.card_eq_pow_finrank (K := ZMod p) (V := 𝓞 K ⧸ P)
    rw [ZMod.card, hcard, ← hq] at h
    rw [← inertiaDeg_eq_of_not_dvd p K P hpm]
    exact (Nat.pow_right_injective hp.two_le h).symm
  -- The Teichmüller character `ω` at `w`, and `χ_P` through `ω`.
  have : w.asIdeal.LiesOver (span {(p : ℤ)}) := LiesOver.trans w.asIdeal P (span {(p : ℤ)})
  have : HasEnoughRootsOfUnity (𝓞 L) (Fintype.card (𝓞 K ⧸ P) - 1) := hcard ▸ ‹_›
  obtain ⟨ω, hω⟩ := exists_mulChar_mk_eq w.asIdeal (algebraMap (𝓞 K ⧸ P) (𝓞 L ⧸ w.asIdeal))
  have hχ := powerResidueSymbol_ringHomComp_eq_pow P w.asIdeal hPm hω
  -- The additive character `ψ(x) = ζ ^ Tr(x)`.
  let ψ := (AddChar.zmodChar p hζ.pow_eq_one).compAddMonoidHom
    (Algebra.trace (ZMod p) (𝓞 K ⧸ P)).toAddMonoidHom
  have hψ (x : 𝓞 K ⧸ P) : ψ x = ζ ^ (Algebra.trace (ZMod p) (𝓞 K ⧸ P) x).val := by
    simp [ψ, AddChar.zmodChar_apply]
  have hψp : ψ.IsPrimitive := by
    refine AddChar.IsPrimitive.of_ne_one fun h ↦ ?_
    obtain ⟨x, hx⟩ := Algebra.trace_surjective (ZMod p) (𝓞 K ⧸ P) 1
    have := hψ x
    rw [h, one_apply, hx, ZMod.val_one, pow_one] at this
    exact hζ.ne_one hp.one_lt this.symm
  -- `σ(Φ(P)) = g(ω⁻¹ ^ ((q - 1) / m · c), ψ) ^ m` in `𝓞 L`; its valuation at `w` is given by
  -- Stickelberger's congruence.
  have htr := apply_stickelbergerPhi_eq_gaussSum_pow P hPm hm
    (MulSemiringAction.toRingEquiv Gal(K/ℚ) (𝓞 K) σ) (c := (galEquivZMod m K σ : ZMod m).val)
    (fun ζ hζ ↦ galEquivZMod_smul_of_pow_eq m K σ hζ)
    (FaithfulSMul.algebraMap_injective (𝓞 K) (𝓞 L)) hψp
  rw [← MulChar.ringHomComp_pow, ← MulChar.ringHomComp_inv, hχ, inv_pow, ← pow_mul, ← inv_pow,
    ← hcard] at htr
  have hval := TauCeti.intValuation_gaussSum_inv_pow_div_mul_pow (v := w) hω hψ hζw
    (by simpa [hcard] using dvd_absNorm_sub_one hPm) (galEquivZMod m K σ : ZMod m).val
  rw [← htr, hfin] at hval
  -- Descend from `w` to `P`, which is unramified over `p`: `v(p) = exp(-1)`.
  have hvp : v.intValuation (p : 𝓞 K) = WithZero.exp (-1) := by
    rw [v.intValuation_natCast_eq_exp_neg_ramificationIdx, ← hPdef,
      ramificationIdx_eq_of_not_dvd p K P hpm, Nat.cast_one]
  rw [← MulSemiringAction.toRingEquiv_apply_apply]
  refine IsDedekindDomain.HeightOneSpectrum.intValuation_eq_exp_neg_of_intValuation_map_eq
    (w := w) (π := (p : 𝓞 K)) hvp ?_
  rwa [map_natCast (algebraMap (𝓞 K) (𝓞 L))]

/-- **The valuation of the conjugates of `Φ(P)` at `P`.** Let `K` be the `m`-th cyclotomic field,
`m ≥ 2`, and `v` a prime of `K` above a rational prime `p ∤ m`, of residue degree
`f = orderOf (p : ZMod m)`. For `σ ∈ Gal(K/ℚ)` with class `c ∈ (ZMod m)ˣ`, the valuation of
`σ(Φ(v))` at `v` is `∑_{i < f} (p ^ i c mod m)`. -/
theorem intValuation_smul_stickelbergerPhi (hm : 2 ≤ m) {p : ℕ} [Fact p.Prime] (hpm : ¬ p ∣ m)
    (v : IsDedekindDomain.HeightOneSpectrum (𝓞 K)) [v.asIdeal.LiesOver (span {(p : ℤ)})]
    (σ : Gal(K/ℚ)) :
    v.intValuation (σ • stickelbergerPhi v.asIdeal m) =
      WithZero.exp (-((∑ i ∈ Finset.range (orderOf (p : ZMod m)),
        p ^ i * (galEquivZMod m K σ : ZMod m).val % m : ℕ) : ℤ)) := by
  have hp := (Fact.out : p.Prime)
  set q := absNorm v.asIdeal
  have hq : p ^ inertiaDeg v.asIdeal ℤ = q := pow_inertiaDeg p v.asIdeal
  have hq2 : 2 ≤ q := hq ▸ le_trans hp.two_le (Nat.le_self_pow (inertiaDeg_pos _ ℤ).ne' p)
  have hpq : ¬ p ∣ q - 1 := (Nat.Prime.coprime_iff_not_dvd hp).1 <|
    ((Nat.coprime_self_sub_right (by omega)).2 (Nat.coprime_one_right _)).coprime_dvd_left
      (hq ▸ dvd_pow_self p (inertiaDeg_pos _ ℤ).ne')
  have hPm : q.Coprime m := hq ▸ ((Nat.Prime.coprime_iff_not_dvd hp).2 hpm).pow_left _
  -- The auxiliary cyclotomic field `L = K(ζ_n)`, `n = p (q - 1)`, which is `ℚ(ζ_n)` as `m ∣ n`.
  set n := p * (q - 1)
  have : NeZero n := ⟨Nat.mul_ne_zero hp.ne_zero (by omega)⟩
  let L := CyclotomicField n K
  have : IsCyclotomicExtension {n} ℚ L := by
    have := IsCyclotomicExtension.trans ℚ K L (algebraMap K L).injective (S := {m}) (T := {n})
    rw [Set.union_comm] at this
    exact (IsCyclotomicExtension.iff_union_of_dvd ℚ L
      ⟨n, rfl, NeZero.ne n, (dvd_absNorm_sub_one (P := v.asIdeal) hPm).mul_left p⟩).2 this
  -- `𝓞 L` contains a primitive `p`-th root of unity `ζ` and the `(q - 1)`-th roots of unity.
  have hζn := (IsCyclotomicExtension.zeta_spec n ℚ L).toInteger_isPrimitiveRoot
  have : NeZero (q - 1) := ⟨by omega⟩
  have : HasEnoughRootsOfUnity (𝓞 L) (q - 1) :=
    ⟨⟨_, hζn.pow (NeZero.pos n) rfl⟩, rootsOfUnity.isCyclic _ _⟩
  -- A prime `w` of `L` above `v`, where `ζ - 1` has valuation one.
  obtain ⟨𝔓, h𝔓, h𝔓v⟩ := exists_maximal_ideal_liesOver_of_isIntegral v.asIdeal (S := 𝓞 L)
  let w : IsDedekindDomain.HeightOneSpectrum (𝓞 L) :=
    ⟨𝔓, inferInstance, ne_bot_of_liesOver_of_ne_bot v.ne_bot 𝔓⟩
  have : w.asIdeal.LiesOver v.asIdeal := h𝔓v
  have : w.asIdeal.LiesOver (span {(p : ℤ)}) := LiesOver.trans w.asIdeal v.asIdeal _
  have hζ := hζn.pow (NeZero.pos n) (mul_comm _ _)
  exact intValuation_smul_stickelbergerPhi_of_liesOver hm hpm v σ w hζ
    (intValuation_sub_one_eq_exp_neg_one hpq w hζ)

/-- A prime containing `Φ(P)` contains `N P`, since `Φ(P) σ₋₁(Φ(P)) = N(P)^m` for the complex
conjugation `σ₋₁`. -/
private theorem absNorm_mem_of_stickelbergerPhi_mem (hm : 2 ≤ m) (P : Ideal (𝓞 K)) [P.IsMaximal]
    (hP : (absNorm P).Coprime m) {Q : Ideal (𝓞 K)} [Q.IsPrime]
    (hΦQ : stickelbergerPhi P m ∈ Q) : (absNorm P : 𝓞 K) ∈ Q := by
  let τ := MulSemiringAction.toRingEquiv Gal(K/ℚ) (𝓞 K) ((galEquivZMod m K).symm (-1))
  have hτ (ζ : 𝓞 K) (hζ : ζ ^ m = 1) : τ ζ = ζ ^ (m - 1) := by
    rw [MulSemiringAction.toRingEquiv_apply_apply, galEquivZMod_smul_of_pow_eq m K _ hζ,
      MulEquiv.apply_symm_apply, Units.val_neg, Units.val_one]
    obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (NeZero.ne m)
    rw [ZMod.val_neg_one, Nat.succ_sub_one]
  have h := stickelbergerPhi_mul_apply_eq_absNorm_pow P hP hm τ hτ
  exact IsPrime.mem_of_pow_mem ‹_› m (h ▸ Q.mul_mem_right _ hΦQ)

/-- The multiplicity of a nonzero prime `Q` in `(Φ(P))` is the sum of the representatives `c(σ)`
over the `σ` with `σ⁻¹ P = Q`: away from `p` both sides vanish, and above `p` this is
Stickelberger's congruence for the valuation at `Q`. -/
private theorem count_normalizedFactors_stickelbergerPhi [DecidableEq (Ideal (𝓞 K))]
    (hm : 2 ≤ m) (P : Ideal (𝓞 K)) [P.IsMaximal] (hP : (absNorm P).Coprime m) {p : ℕ}
    [Fact p.Prime] [P.LiesOver (span {(p : ℤ)})] (hpm : ¬ p ∣ m) {Q : Ideal (𝓞 K)} [Q.IsPrime]
    (hQ : Q ≠ ⊥) :
    (normalizedFactors (span {stickelbergerPhi P m})).count Q =
      ∑ σ with σ⁻¹ • P = Q, (galEquivZMod m K σ : ZMod m).val := by
  have hpP : (p : 𝓞 K) ∈ P := by
    simpa using (mem_of_liesOver P (span {(p : ℤ)}) (p : ℤ)).1 (mem_span_singleton_self _)
  have hNP : p ^ inertiaDeg P ℤ = absNorm P := pow_inertiaDeg p P
  have hΦ := stickelbergerPhi_ne_zero hP hm
  let v : IsDedekindDomain.HeightOneSpectrum (𝓞 K) := ⟨Q, inferInstance, hQ⟩
  by_cases hpQ : (p : 𝓞 K) ∈ Q
  swap
  · -- Away from `p`: no `σ⁻¹ • P` is `Q`, and `Φ(P) ∉ Q` as `N P = p ^ f ∉ Q`.
    have hne (σ : Gal(K/ℚ)) : σ⁻¹ • P ≠ Q :=
      fun h ↦ hpQ (h ▸ mem_inv_pointwise_smul_iff.2 (by
        rwa [← MulSemiringAction.toRingEquiv_apply_apply, map_natCast]))
    simp only [hne, Finset.filter_false, Finset.sum_empty]
    refine Multiset.count_eq_zero.2 fun h ↦ hpQ ?_
    have hN := absNorm_mem_of_stickelbergerPhi_mem hm P hP
      ((span_singleton_le_iff_mem _).1 (le_of_dvd (dvd_of_mem_normalizedFactors h)))
    rw [← hNP, Nat.cast_pow] at hN
    exact ‹Q.IsPrime›.mem_of_pow_mem _ hN
  -- Above `p`: `Q = τ • P` for some `τ`, and `Φ(P) = τ⁻¹ • Φ(Q)`, whose valuation at `Q` is
  -- `intValuation_smul_stickelbergerPhi`.
  have : Q.LiesOver (span {(p : ℤ)}) := ⟨(Int.ideal_span_isMaximal_of_prime p).eq_of_le
    IsPrime.ne_top' ((span_singleton_le_iff_mem _).2 (by simpa using hpQ))⟩
  have : IsGalois ℚ K := IsCyclotomicExtension.isGalois {m} ℚ K
  obtain ⟨τ, rfl⟩ := exists_smul_eq_of_isGaloisGroup (span {(p : ℤ)}) P Q Gal(K/ℚ)
  have hΦτ : τ⁻¹ • stickelbergerPhi v.asIdeal m = stickelbergerPhi P m := by
    have h := map_stickelbergerPhi (m := m) P (MulSemiringAction.toRingEquiv _ (𝓞 K) τ)
    rw [MulSemiringAction.toRingEquiv_apply_apply] at h
    rw [inv_smul_eq_iff, h]
    -- `v.asIdeal = τ • P` is by definition (`Ideal.pointwise_smul_def`) the image of `P` under `τ`.
    rfl
  have hloc := intValuation_smul_stickelbergerPhi hm hpm v τ⁻¹
  rw [hΦτ, v.intValuation_eq_exp_neg_multiplicity hΦ, multiplicity_eq_count_normalizedFactors
    v.irreducible (by simpa using hΦ), normalize_eq] at hloc
  rw [Nat.cast_injective (neg_injective (WithZero.exp_injective hloc)),
    TauCeti.NumberField.sum_val_galEquivZMod_filter_inv_smul_eq_smul hpm P τ]

/-- **Stickelberger's relation at a prime.** Let `K` be the `m`-th cyclotomic field, `m ≥ 2`, and
`P` a prime of `K` whose norm is prime to `m`. Then the principal ideal generated by
`Φ(P) = g(P)^m` is `P ^ γ = ∏_σ (σ⁻¹ P) ^ c(σ)`, the product over `σ ∈ Gal(K/ℚ)` with `c(σ)` the
representative in `[1, m)` of the class of `σ` in `(ZMod m)ˣ`. -/
theorem span_stickelbergerPhi_of_isMaximal (hm : 2 ≤ m) (P : Ideal (𝓞 K)) [P.IsMaximal]
    (hP : (absNorm P).Coprime m) :
    span {stickelbergerPhi P m} =
      ∏ σ : Gal(K/ℚ), (σ⁻¹ • P) ^ (galEquivZMod m K σ : ZMod m).val := by
  classical
  -- The rational prime `p` below `P`.
  obtain ⟨p, hp, hPp⟩ : ∃ p : ℕ, p.Prime ∧ P.LiesOver (span {(p : ℤ)}) :=
    ⟨absNorm (under ℤ P), Nat.absNorm_under_prime P, inferInstance⟩
  have := Fact.mk hp
  have hNP : p ^ inertiaDeg P ℤ = absNorm P := pow_inertiaDeg p P
  have hpm : ¬ p ∣ m := (Nat.Prime.coprime_iff_not_dvd hp).1 <|
    hP.coprime_dvd_left (hNP ▸ dvd_pow_self p (inertiaDeg_pos P ℤ).ne')
  set c : Gal(K/ℚ) → ℕ := fun σ ↦ (galEquivZMod m K σ : ZMod m).val
  have hσP (σ : Gal(K/ℚ)) : (σ • P).IsMaximal := by
    rw [pointwise_smul_eq_comap]
    exact comap_isMaximal_of_surjective _ (RingEquiv.surjective _)
  -- The right side is the product of the multiset `M` of primes, its normalized factors.
  set M : Multiset (Ideal (𝓞 K)) := ∑ σ, c σ • {σ⁻¹ • P} with hM
  have hMprod : M.prod = ∏ σ : Gal(K/ℚ), (σ⁻¹ • P) ^ c σ := by
    simp [hM, Multiset.prod_sum, Multiset.prod_nsmul]
  have hMprime : ∀ Q ∈ M, Prime Q := by
    intro Q hQ
    obtain ⟨σ, -, hσ⟩ := Multiset.mem_sum.1 hQ
    rw [Multiset.mem_nsmul, Multiset.mem_singleton] at hσ
    rw [hσ.2]
    exact prime_of_isPrime (Ring.ne_bot_of_isMaximal_of_not_isField (hσP σ⁻¹)
      (RingOfIntegers.not_isField K)) (hσP σ⁻¹).isPrime
  have hΦ := stickelbergerPhi_ne_zero hP hm
  suffices h : normalizedFactors (span {stickelbergerPhi P m}) = M by
    rw [← hMprod, ← h, prod_normalizedFactors_eq_self (by simpa using hΦ)]
  ext Q
  by_cases hQ : Q ≠ ⊥ ∧ Q.IsPrime
  swap
  · have hQ' : ∀ {S : Multiset (Ideal (𝓞 K))}, (∀ Q ∈ S, Prime Q) → S.count Q = 0 :=
      fun hS ↦ Multiset.count_eq_zero.2 fun h ↦ hQ ⟨(hS Q h).ne_zero, isPrime_of_prime (hS Q h)⟩
    rw [hQ' fun _ h ↦ prime_of_normalized_factor _ h, hQ' hMprime]
  have : Q.IsPrime := hQ.2
  let v : IsDedekindDomain.HeightOneSpectrum (𝓞 K) := ⟨Q, hQ.2, hQ.1⟩
  -- The multiplicity of `Q` on the right is the sum of the `c σ` with `σ⁻¹ • P = Q`.
  have hcount : M.count Q = ∑ σ with σ⁻¹ • P = Q, c σ := by
    simp [hM, Multiset.count_sum', Multiset.count_singleton, Finset.sum_filter, eq_comm]
  rw [hcount]
  exact count_normalizedFactors_stickelbergerPhi hm P hP hpm hQ.1

/-- **Stickelberger's relation.** Let `K` be the `m`-th cyclotomic field, `m ≥ 2`, and `A` an
ideal of `𝓞 K` whose norm is prime to `m`. Then the principal ideal generated by `Φ(A)` is
`A ^ γ = ∏_σ (σ⁻¹ A) ^ c(σ)`, the product over `σ ∈ Gal(K/ℚ)` with `c(σ)` the representative in
`[1, m)` of the class of `σ` in `(ZMod m)ˣ`. Here `γ = ∑_{1 ≤ t < m, (t, m) = 1} t σ_t⁻¹`. -/
theorem span_stickelbergerPhi (hm : 2 ≤ m) {A : Ideal (𝓞 K)} (hA : (absNorm A).Coprime m) :
    span {stickelbergerPhi A m} =
      ∏ σ : Gal(K/ℚ), (σ⁻¹ • A) ^ (galEquivZMod m K σ : ZMod m).val := by
  induction A using induction_on_prime with
  | h₁ =>
    rw [zero_eq_bot, absNorm_bot, Nat.coprime_zero_left] at hA
    omega
  | h₂ A hA' =>
    rw [isUnit_iff.mp hA', stickelbergerPhi_top, span_singleton_one, ← one_eq_top]
    simp only [smul_one, one_pow, Finset.prod_const_one]
  | h₃ A P hA₀ hP ih =>
    have : P.IsMaximal := (isPrime_of_prime hP).isMaximal hP.ne_zero
    rw [map_mul, Nat.coprime_mul_iff_left] at hA
    rw [stickelbergerPhi_mul hP.ne_zero hA₀, ← span_singleton_mul_span_singleton,
      span_stickelbergerPhi_of_isMaximal hm P hA.1, ih hA.2, ← Finset.prod_mul_distrib]
    simp only [smul_mul', mul_pow]

/-- **Stickelberger's relation for elements.** Let `K` be the `m`-th cyclotomic field, `m ≥ 2`,
and `α ∈ 𝓞 K` with norm prime to `m`. Then `Φ((α))` and `α ^ γ = ∏_σ (σ⁻¹ α) ^ c(σ)` generate the
same ideal, with `c(σ)` as in `Ideal.span_stickelbergerPhi`. -/
theorem span_stickelbergerPhi_span_singleton (hm : 2 ≤ m) {α : 𝓞 K}
    (hα : (absNorm (span {α})).Coprime m) :
    span {stickelbergerPhi (span {α}) m} =
      span {∏ σ : Gal(K/ℚ), (σ⁻¹ • α) ^ (galEquivZMod m K σ : ZMod m).val} := by
  rw [span_stickelbergerPhi hm hα, ← prod_span_singleton]
  simp only [smul_closure, Set.smul_set_singleton, span_singleton_pow]

end Ideal
