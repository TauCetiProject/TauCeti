module

public import Mathlib.NumberTheory.NumberField.Cyclotomic.Galois
public import TauCeti.NumberTheory.NumberField.Cyclotomic.RootsOfUnity
public import TauCeti.NumberTheory.NumberField.PowerResidueSymbol.Ideal

/-!
# Power residue symbols in cyclotomic fields

Let `K` be the `n`-th cyclotomic field over `ℚ`, and let `σ` be complex conjugation, the
automorphism acting on the `n`-th roots of unity by `ζ ↦ ζ⁻¹`. Since `σ` fixes every rational
integer `m`, Galois equivariance of the power residue symbol shows that, for `m` prime to an
ideal `𝔞`, the symbol of `m` at the conjugate ideal `σ 𝔞` is the inverse of its symbol at `𝔞`:
`(m / σ 𝔞)_n (m / 𝔞)_n = 1`. This is how conjugate ideals are paired off in the reciprocity laws
involving rational integers: for instance, the symbol of an integer `m` prime to `p` at a rational
prime that splits as `p = π (σ π)` is `1`.

When `n = p` is prime and `ζ` is a primitive `p`-th root of unity in `K`, the `p`-th power residue
symbol of `ζ` at the principal ideal generated by an integer `a` not divisible by `p` is governed
by the Fermat quotient of `|a|` base `p`: `(ζ / a 𝓞 K)_p = ζ ^ ((|a| ^ (p - 1) - 1) / p)`
(`IsPrimitiveRoot.powerResidueSymbolIdeal_span_intCast_toInteger`), as `N(a 𝓞 K) = |a| ^ (p - 1)`.

## Main results

* `Ideal.powerResidueSymbolIdeal_map_intCast_mul_eq_one`: `(m / σ 𝔞)_n (m / 𝔞)_n = 1` for complex
  conjugation `σ` and an integer `m` prime to `𝔞`.
* `IsPrimitiveRoot.powerResidueSymbolIdeal_span_intCast_toInteger`: for a prime `p` and `p ∤ a`,
  `(ζ / a)_p = ζ ^ ((|a| ^ (p - 1) - 1) / p)`.

## References

* N. Xu, *Reciprocity Laws*, §5, proof of Proposition 5.10.
* S. D. Adhikari, *The early reciprocity laws: from Gauss to Eisenstein*, §4, Proposition 4.1.
* K. Ireland and M. Rosen, *A Classical Introduction to Modern Number Theory*, Chapter 14, §2.
-/

public section

open NumberField IsCyclotomicExtension.Rat

namespace Ideal

variable {n : ℕ} [NeZero n] {K : Type*} [Field K] [NumberField K] [IsCyclotomicExtension {n} ℚ K]
  [HasEnoughRootsOfUnity (𝓞 K) n]

/-- **Complex conjugation inverts the symbol of a rational integer.** In the `n`-th cyclotomic
field, let `σ` be complex conjugation, the automorphism corresponding to `-1 ∈ (ZMod n)ˣ`. For an
integer `m` prime to an ideal `𝔞` of `𝓞 K`, the symbols of `m` at `𝔞` and at its conjugate `σ 𝔞`
are inverse `n`-th roots of unity: `(m / σ 𝔞)_n (m / 𝔞)_n = 1`. -/
theorem powerResidueSymbolIdeal_map_intCast_mul_eq_one {σ : Gal(K/ℚ)}
    (hσ : galEquivZMod n K σ = -1) (𝔞 : Ideal (𝓞 K)) {m : ℤ} (hm : IsUnit (m : 𝓞 K ⧸ 𝔞)) :
    powerResidueSymbolIdeal (𝔞.map (MulSemiringAction.toRingEquiv Gal(K/ℚ) (𝓞 K) σ)) n m *
      powerResidueSymbolIdeal 𝔞 n m = 1 := by
  set τ := MulSemiringAction.toRingEquiv Gal(K/ℚ) (𝓞 K) σ
  have hx : powerResidueSymbolIdeal 𝔞 n m ^ n = 1 := powerResidueSymbolIdeal_pow_eq_one hm
  -- Galois equivariance, with `σ m = m`.
  have hmap := map_powerResidueSymbolIdeal (n := n) 𝔞 τ m
  rw [map_intCast τ, map_intCast (Quotient.mk 𝔞), map_intCast (Quotient.mk (𝔞.map τ))] at hmap
  -- `σ` raises every `n`-th root of unity to the power `n - 1`.
  have hτ : τ (powerResidueSymbolIdeal 𝔞 n m) = powerResidueSymbolIdeal 𝔞 n m ^ (n - 1) := by
    obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (NeZero.ne n)
    have h := galEquivZMod_smul_of_pow_eq (k + 1) K σ hx
    rw [hσ, Units.val_neg, Units.val_one, ZMod.val_neg_one] at h
    exact h
  rw [← hmap, hτ, ← pow_succ, Nat.sub_add_cancel NeZero.one_le, hx]

end Ideal

namespace IsPrimitiveRoot

open Ideal

/-- **The `p`-th power residue symbol of a primitive `p`-th root of unity at a rational integer.**
In `K = ℚ(ζ_p)` for a prime `p`, if `p ∤ a`, then `(ζ / a 𝓞 K)_p = ζ ^ ((|a| ^ (p - 1) - 1) / p)`.
This holds for `p = 2` as well as odd `p`. -/
theorem powerResidueSymbolIdeal_span_intCast_toInteger {p : ℕ} [Fact p.Prime] {K : Type*} [Field K]
    [NumberField K] [IsCyclotomicExtension {p} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ p) {a : ℤ}
    (ha : ¬ (p : ℤ) ∣ a) :
    powerResidueSymbolIdeal (span {(a : 𝓞 K)}) p
        (Ideal.Quotient.mk (span {(a : 𝓞 K)}) hζ.toInteger) =
      hζ.toInteger ^ ((a.natAbs ^ (p - 1) - 1) / p) := by
  have hp : p.Prime := Fact.out
  have hnorm : absNorm (span {(a : 𝓞 K)}) = a.natAbs ^ (p - 1) := by
    rw [absNorm_span_singleton, ← eq_intCast (algebraMap ℤ (𝓞 K)), Algebra.norm_algebraMap,
      Int.natAbs_pow, RingOfIntegers.rank, IsCyclotomicExtension.Rat.finrank p K,
      Nat.totient_prime hp]
  have ha' : ¬ p ∣ a.natAbs := fun h ↦ ha (Int.dvd_natAbs.mp (Int.natCast_dvd_natCast.mpr h))
  have hcop : (absNorm (span {(a : 𝓞 K)})).Coprime p := by
    rw [hnorm]
    exact ((hp.coprime_iff_not_dvd.mpr ha').symm).pow_left (p - 1)
  rw [powerResidueSymbolIdeal_mk_of_pow_eq_one hcop hζ.toInteger_isPrimitiveRoot.pow_eq_one, hnorm]

end IsPrimitiveRoot

end
