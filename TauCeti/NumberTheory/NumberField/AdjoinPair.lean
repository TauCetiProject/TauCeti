module

public import Mathlib.Algebra.Algebra.Hom.Rat
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.NumberTheory.NumberField.Basic

/-!
# Algebraic elements lie in a common number field

Two elements of a field of characteristic zero that are algebraic over `ℚ` generate a finite
extension `ℚ⟮x, y⟯` of `ℚ`, which is a number field; more generally, so do the coordinates of a
finite tuple of algebraic elements. This reduces statements about pairs and tuples of algebraic
numbers in an arbitrary characteristic-zero field to the number-field API.
The generated fields are transported along field homomorphisms by `TauCeti.adjoinRangeMapEquiv`.

## Main results

* `TauCeti.exists_numberField_mem`: two algebraic elements of `F` lie in a common intermediate
  number field.
* `TauCeti.exists_numberField_comp`: a finite tuple of algebraic elements of `F` is the image of a
  tuple in an intermediate number field.
* `TauCeti.adjoinRangeMapEquiv`: transport of a tuple's generated field along a
  homomorphism of characteristic-zero fields.
-/

public section

open IntermediateField

namespace TauCeti

section Transport

variable {F F' ι : Type*} [Field F] [CharZero F] [Field F'] [CharZero F']

/-- A field homomorphism restricts to a `ℚ`-algebra isomorphism between the fields generated by
a tuple and its image. No finiteness or algebraicity assumption on the tuple is needed. -/
noncomputable def adjoinRangeMapEquiv (x : ι → F) (f : F →+* F') :
    adjoin ℚ (Set.range x) ≃ₐ[ℚ] adjoin ℚ (Set.range (f ∘ x)) :=
  (equivMap (adjoin ℚ (Set.range x)) f.toRatAlgHom).trans (equivOfEq (by
    simp only [adjoin_map, ← Set.range_comp, Function.comp_def, RingHom.toRatAlgHom_apply]))

/-- The restricted isomorphism acts on elements by the original field homomorphism. -/
@[simp]
theorem coe_adjoinRangeMapEquiv_apply (x : ι → F) (f : F →+* F')
    (y : adjoin ℚ (Set.range x)) :
    (adjoinRangeMapEquiv x f y : F') = f y := by
  simp [adjoinRangeMapEquiv]

end Transport

variable {F : Type*} [Field F] [CharZero F]

/-- Two algebraic elements of `F` lie in a common intermediate number field. -/
theorem exists_numberField_mem {x y : F} (hx : IsAlgebraic ℚ x) (hy : IsAlgebraic ℚ y) :
    ∃ (K : IntermediateField ℚ F) (_ : NumberField K) (a b : K), (a : F) = x ∧ (b : F) = y := by
  have := finiteDimensional_adjoin_pair hx.isIntegral hy.isIntegral
  exact ⟨ℚ⟮x, y⟯, {}, ⟨x, mem_adjoin_pair_left ℚ x y⟩, ⟨y, mem_adjoin_pair_right ℚ x y⟩, rfl, rfl⟩

/-- A finite tuple of algebraic elements of `F` is the image of a tuple in an intermediate number
field, namely the field generated by its coordinates. -/
theorem exists_numberField_comp {ι : Type*} [Finite ι] {x : ι → F}
    (hx : ∀ i, IsAlgebraic ℚ (x i)) :
    ∃ (E : IntermediateField ℚ F) (_ : NumberField E) (y : ι → E), algebraMap E F ∘ y = x := by
  have : FiniteDimensional ℚ (adjoin ℚ (Set.range x)) :=
    finiteDimensional_adjoin (by rintro _ ⟨i, rfl⟩; exact (hx i).isIntegral)
  refine ⟨adjoin ℚ (Set.range x), {}, fun i ↦ ⟨x i, subset_adjoin ℚ _ (Set.mem_range_self i)⟩, ?_⟩
  funext i
  simp

end TauCeti
