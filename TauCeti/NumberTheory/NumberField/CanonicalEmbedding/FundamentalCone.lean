module

public import Mathlib.NumberTheory.NumberField.CanonicalEmbedding.FundamentalCone

/-!
# The points of an ideal in the fundamental cone, as principal ideals

Let `J` be a nonzero integral ideal of a number field `K`. Mathlib's
`NumberField.mixedEmbedding.fundamentalCone.idealSet K J` is the set of points of the fundamental
cone that are images of elements of `J`. Every nonzero principal ideal `(a)` divisible by `J` has
exactly `w = #μ(K)` generators whose images lie in the cone, one for each root of unity, because
the cone is a fundamental domain for the units of `𝓞 K` modulo torsion. Mathlib records this
fibre by fibre of the norm (`NumberField.mixedEmbedding.fundamentalCone.idealSetEquivNorm`), which
is the form needed to count points of bounded norm.

This file records it without the norm condition, as a single equivalence

`idealSet K J ≃ {I : (Ideal (𝓞 K))⁰ // J ∣ I ∧ I.IsPrincipal} × torsion K`

(`idealSetEquivPrincipal`), whose first component sends a point to the ideal generated by the
algebraic integer it is the image of (`idealSetEquivPrincipal_apply_fst`), so that the norm of the
point is the absolute norm of that ideal (`absNorm_idealSetEquivPrincipal_fst`). This is the form in
which a series over the points of the cone, rather than a count, is rewritten as a series over
ideals: the sum of `|N(x)|^(-s)` over the points of `J` in the fundamental cone is `w` times the sum
of `N(I)^(-s)` over the principal ideals `I` divisible by `J`.

## Main declarations

* `NumberField.mixedEmbedding.fundamentalCone.idealSetEquivPrincipal`: the equivalence.
* `NumberField.mixedEmbedding.fundamentalCone.idealSetEquivPrincipal_apply_fst`: its first
  component is the ideal generated by the preimage of the point.
* `NumberField.mixedEmbedding.fundamentalCone.absNorm_idealSetEquivPrincipal_fst`: it
  carries the norm of a point to the absolute norm of the ideal.
* `NumberField.mixedEmbedding.fundamentalCone.interIdealLatticeEquiv`: scaling by a positive
  natural number `m` with `(m) * I = J` maps `fundamentalCone K ∩ idealLattice K I` bijectively
  onto `idealSet K J`.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter VII, (5.3).
* The equivalence is assembled from Mathlib's `idealSetEquiv` and `integerSetEquiv`, following the
  construction of Mathlib's `idealSetEquivNorm` (X. Roblot).
-/

public section

open NumberField NumberField.mixedEmbedding NumberField.mixedEmbedding.fundamentalCone
  NumberField.Units Ideal Submodule
open scoped nonZeroDivisors

namespace NumberField.mixedEmbedding.fundamentalCone

variable (K : Type*) [Field K] [NumberField K] (J : (Ideal (𝓞 K))⁰)

/-- **The points of `J` in the fundamental cone are the principal multiples of `J`, times the
torsion.** The first component sends a point to the ideal generated by the algebraic integer it is
the image of (`idealSetEquivPrincipal_apply_fst`); the torsion component records which of the `w`
generators of that ideal lying in the cone the point is. This is Mathlib's `idealSetEquivNorm`
without the norm condition. -/
noncomputable def idealSetEquivPrincipal :
    idealSet K J ≃ {I : (Ideal (𝓞 K))⁰ // (J : Ideal (𝓞 K)) ∣ I ∧
      IsPrincipal (I : Ideal (𝓞 K))} × torsion K :=
  calc idealSet K J
      ≃ {a : integerSet K // (preimageOfMemIntegerSet a : 𝓞 K) ∈ (J : Set (𝓞 K))} :=
        idealSetEquiv K J
    _ ≃ {p : {I : (Ideal (𝓞 K))⁰ // IsPrincipal I.1} × torsion K //
          (J : Ideal (𝓞 K)) ∣ p.1.1} :=
        Equiv.subtypeEquiv (integerSetEquiv K) fun a ↦ by
          rw [integerSetEquiv_apply_fst, dvd_span_singleton, SetLike.mem_coe]
    _ ≃ {I : {I : (Ideal (𝓞 K))⁰ // IsPrincipal I.1} // (J : Ideal (𝓞 K)) ∣ I.1} × torsion K :=
        Equiv.prodSubtypeFstEquivSubtypeProd
          (p := fun I : {I : (Ideal (𝓞 K))⁰ // IsPrincipal I.1} ↦ (J : Ideal (𝓞 K)) ∣ I.1)
    _ ≃ {I : (Ideal (𝓞 K))⁰ // (J : Ideal (𝓞 K)) ∣ I ∧ IsPrincipal (I : Ideal (𝓞 K))} ×
          torsion K :=
        Equiv.prodCongrLeft fun _ ↦ (Equiv.subtypeSubtypeEquivSubtypeInter
          (fun I : (Ideal (𝓞 K))⁰ ↦ IsPrincipal I.1) (fun I ↦ (J : Ideal (𝓞 K)) ∣ I.1)).trans
          (Equiv.subtypeEquivRight fun _ ↦ and_comm)

variable {K J}

/-- The first component of `idealSetEquivPrincipal` at a point `a` is the ideal generated by the
algebraic integer whose image is `a`. -/
theorem idealSetEquivPrincipal_apply_fst (a : idealSet K J) {x : 𝓞 K}
    (hx : mixedEmbedding K (x : K) = a) :
    ((idealSetEquivPrincipal K J a).1 : Ideal (𝓞 K)) = span {x} := by
  have h : (preimageOfMemIntegerSet (idealSetEquiv K J a).1 : 𝓞 K) = x := by
    refine RingOfIntegers.ext (mixedEmbedding_injective K ?_)
    rw [mixedEmbedding_preimageOfMemIntegerSet, idealSetEquiv_apply, hx]
  rw [← h]
  exact integerSetEquiv_apply_fst _

/-- **The norm of a point is the absolute norm of the ideal it generates.** -/
@[simp]
theorem absNorm_idealSetEquivPrincipal_fst (a : idealSet K J) :
    (absNorm ((idealSetEquivPrincipal K J a).1 : Ideal (𝓞 K)) : ℝ) =
      mixedEmbedding.norm (a : mixedSpace K) := by
  rw [idealSetEquivPrincipal_apply_fst a (mixedEmbedding_preimageOfMemIntegerSet
    (idealSetEquiv K J a).1), ← intNorm_idealSetEquiv_apply, intNorm, absNorm_span_singleton,
    Nat.cast_natAbs, Int.cast_abs]

omit [NumberField K] in
/-- Scaling by a positive natural number `m` with `(m) * I = J` maps the fundamental-cone points of
`idealLattice K I` bijectively onto `idealSet K J`. -/
noncomputable def interIdealLatticeEquiv {I : (FractionalIdeal (𝓞 K)⁰ K)ˣ} {m : ℕ} (hm : m ≠ 0)
    (hJ : FractionalIdeal.mk0 K J =
      toPrincipalIdeal (𝓞 K) K (Units.mk0 (m : K) (Nat.cast_ne_zero.mpr hm)) * I) :
    (fundamentalCone K ∩ idealLattice K I : Set (mixedSpace K)) ≃ idealSet K J :=
  Equiv.subtypeEquiv (MulAction.toPerm (Units.mk0 (m : ℝ) (Nat.cast_ne_zero.mpr hm))) fun x ↦ by
    have hmR : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hm
    have hval : (FractionalIdeal.mk0 K J : FractionalIdeal (𝓞 K)⁰ K) =
        FractionalIdeal.spanSingleton (𝓞 K)⁰ (m : K) * (I : FractionalIdeal (𝓞 K)⁰ K) := by
      simpa [coe_toPrincipalIdeal] using congrArg Units.val hJ
    simp only [idealSet, Set.mem_inter_iff, SetLike.mem_coe, MulAction.toPerm_apply,
      Units.smul_def, Units.val_mk0, mem_idealLattice]
    refine and_congr (smul_mem_iff_mem hmR).symm
      ⟨fun ⟨b, hb, hbx⟩ ↦ ⟨(m : K) * b, ?_, ?_⟩, fun ⟨y, hy, hyx⟩ ↦ ?_⟩
    · rw [hval]
      exact FractionalIdeal.mem_singleton_mul.mpr ⟨b, hb, rfl⟩
    · rw [← hbx, map_mul, map_natCast, Nat.cast_smul_eq_nsmul, nsmul_eq_mul]
    · rw [hval, FractionalIdeal.mem_singleton_mul] at hy
      obtain ⟨b, hb, rfl⟩ := hy
      refine ⟨b, hb, smul_right_injective (mixedSpace K) hmR ?_⟩
      dsimp only
      rwa [map_mul, map_natCast, ← nsmul_eq_mul, ← Nat.cast_smul_eq_nsmul ℝ] at hyx

/-- Underlying mixed-space point of `interIdealLatticeEquiv`. -/
@[simp]
theorem interIdealLatticeEquiv_apply_coe {I : (FractionalIdeal (𝓞 K)⁰ K)ˣ} {m : ℕ} (hm : m ≠ 0)
    (hJ : FractionalIdeal.mk0 K J =
      toPrincipalIdeal (𝓞 K) K (Units.mk0 (m : K) (Nat.cast_ne_zero.mpr hm)) * I)
    (a : (fundamentalCone K ∩ idealLattice K I : Set (mixedSpace K))) :
    (interIdealLatticeEquiv hm hJ a : mixedSpace K) = (m : ℝ) • (a : mixedSpace K) := by
  simp [interIdealLatticeEquiv]

end NumberField.mixedEmbedding.fundamentalCone
