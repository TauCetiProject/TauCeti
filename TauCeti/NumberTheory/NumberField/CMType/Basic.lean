/-!
# CM types and their reflex fields

A *CM type* on a commutative ring `E` is a set `Φ` of ring maps `E → ℂ` containing exactly one
of each conjugate pair: for every `φ : E →+* ℂ`, the conjugate `star φ = conj ∘ φ` lies in `Φ`
exactly when `φ` does not. For a CM field, or a finite product of CM fields, this is Milne's
CM type: a choice of one complex embedding over each real embedding of the maximal totally real
subalgebra. The definition imposes only the partition condition, for any commutative ring, so that
products of CM fields are covered on their native carrier.

The *type trace* of `Φ` is `a ↦ ∑_{φ ∈ Φ} φ a`, and the *reflex field* `E* ⊆ ℂ` is the subfield
generated over `ℚ` by its values. The sum is a finite-support sum (`finsum`), which is `0` when
infinitely many `φ ∈ Φ` have `φ a ≠ 0`; when `E` has finitely many embeddings into `ℂ`, as for a
number field or a finite product of number fields, it is the ordinary sum, and the type trace and
reflex field are Milne's.

## Main definitions

* `TauCeti.CMType E`: a CM type on `E`, with its `SetLike` structure.
* `TauCeti.CMType.conjugate`: the complementary type `ιΦ = {conj ∘ φ | φ ∈ Φ}`.
* `TauCeti.CMType.induced`: the type `{φ | φ ∘ f ∈ Φ₀}` induced along a ring map `f : E₀ → E`.
* `TauCeti.CMType.StarCompCommute E`: complex conjugation commutes with every ring endomorphism
  of `ℂ` on the embeddings of `E`, as for a CM field.
* `TauCeti.CMType.instMulActionRingAut`: the action `σΦ = {σ ∘ φ | φ ∈ Φ}` of `Aut(ℂ)` on the
  CM types of such an `E`.
* `TauCeti.CMType.typeTrace`: the type trace `a ↦ ∑_{φ ∈ Φ} φ a`, a finite-support sum, and
  `TauCeti.CMType.typeTraceLinearMap`, the same as a `ℚ`-linear map when `E` is a `ℚ`-algebra
  with finitely many embeddings.
* `TauCeti.CMType.reflexField`: the reflex field, the subfield of `ℂ` generated by the type
  traces.

## Main results

* `TauCeti.CMType.mem_conjugate_iff_notMem`: `ιΦ` is the complement of `Φ`.
* `TauCeti.CMType.star_ne_self`: an embedding with real image admits no CM type, so in
  particular `ℚ` has none (`TauCeti.CMType.instIsEmptyRat`).
* `TauCeti.CMType.two_mul_ncard` and `TauCeti.CMType.two_mul_ncard_eq_finrank`:
  `2 |Φ| = |Hom(E, ℂ)|` (both sides are `0` when there are infinitely many embeddings), which is
  `[E : ℚ]` for a number field.
* `TauCeti.CMType.induced_comp`: inducing in two steps equals inducing directly.
* `TauCeti.CMType.conjugate_smul`: when every `σ ∈ Aut(ℂ)` commutes with complex conjugation on
  embeddings (on a CM field, `RingHom.star_comp`), `ι(σΦ) = σ(ιΦ)`.
* `TauCeti.CMType.typeTrace_conjugate`: `typeTrace_{ιΦ} = conj ∘ typeTrace_Φ`, and
  `TauCeti.CMType.typeTrace_smul_ringAut`: `typeTrace_{σΦ} = σ ∘ typeTrace_Φ`.
* `TauCeti.CMType.reflexField_le_iff`: `E* ≤ F` iff every type trace lies in `F`.
* `TauCeti.CMType.reflexField_conjugate`: `ιΦ` has the same reflex field as `Φ`, because the
  sum of `φ a` over all embeddings `φ` is fixed by `Aut(ℂ)`, hence rational
  (`TauCeti.IsAlgClosed.finsum_apply_mem_range_algebraMap`).

## References

* J. S. Milne, *Complex Multiplication*, Definition 1.8, p.11; Proposition 1.16 and
  Definition 1.17, p.13, and footnote 3.
-/

public section

open NumberField

namespace TauCeti

/-- A CM type on a commutative ring `E`: a set of ring maps `E → ℂ` containing exactly one of
each conjugate pair `φ, conj ∘ φ` (Milne, *Complex Multiplication*, Definition 1.8). -/
structure CMType (E : Type*) [CommRing E] where
  /-- The selected complex embeddings. -/
  toSet : Set (E →+* ℂ)
  /-- The conjugate `star φ` of an embedding lies in the type exactly when `φ` does not. -/
  star_mem_iff' : ∀ φ : E →+* ℂ, star φ ∈ toSet ↔ φ ∉ toSet

namespace CMType

section CommRing

variable {E : Type*} [CommRing E]

/-- A CM type is determined by its set of embeddings. -/
instance instSetLike : SetLike (CMType E) (E →+* ℂ) where
  coe := toSet
  coe_injective Φ Ψ h := by
    cases Φ
    cases Ψ
    congr

/-- Membership in the underlying set is membership in the type. -/
@[simp]
theorem mem_toSet {Φ : CMType E} {φ : E →+* ℂ} : φ ∈ Φ.toSet ↔ φ ∈ Φ :=
  Iff.rfl

/-- The embeddings of a type built from a set `s` are `s`. -/
@[simp]
theorem coe_mk (s : Set (E →+* ℂ)) (h : ∀ φ : E →+* ℂ, star φ ∈ s ↔ φ ∉ s) :
    ((⟨s, h⟩ : CMType E) : Set (E →+* ℂ)) = s :=
  rfl

/-- Membership in a type built from a set `s` is membership in `s`. -/
@[simp]
theorem mem_mk (s : Set (E →+* ℂ)) (h : ∀ φ : E →+* ℂ, star φ ∈ s ↔ φ ∉ s) {φ : E →+* ℂ} :
    φ ∈ (⟨s, h⟩ : CMType E) ↔ φ ∈ s :=
  Iff.rfl

/-- Two CM types with the same embeddings are equal. -/
@[ext]
theorem ext {Φ Ψ : CMType E} (h : ∀ φ, φ ∈ Φ ↔ φ ∈ Ψ) : Φ = Ψ :=
  SetLike.ext h

/-- The conjugate of an embedding lies in a CM type exactly when the embedding does not. -/
@[simp]
theorem star_mem_iff (Φ : CMType E) (φ : E →+* ℂ) : star φ ∈ Φ ↔ φ ∉ Φ :=
  Φ.star_mem_iff' φ

/-- No embedding admitting a CM type is real: it differs from its conjugate. -/
theorem star_ne_self (Φ : CMType E) (φ : E →+* ℂ) : star φ ≠ φ := fun h =>
  iff_not_self (h ▸ Φ.star_mem_iff φ)

/-- A ring with an embedding into `ℂ` fixed by complex conjugation has no CM type. -/
theorem isEmpty_of_star_eq (φ : E →+* ℂ) (h : star φ = φ) : IsEmpty (CMType E) :=
  ⟨fun Φ => Φ.star_ne_self φ h⟩

/-- `ℚ` has no CM type: its only embedding into `ℂ` is real. -/
instance instIsEmptyRat : IsEmpty (CMType ℚ) :=
  isEmpty_of_star_eq (Rat.castHom ℂ) (Subsingleton.elim _ _)

/-! ### The conjugate type -/

/-- The conjugate CM type `ιΦ = {conj ∘ φ | φ ∈ Φ}`, the complement of `Φ`. -/
def conjugate (Φ : CMType E) : CMType E where
  toSet := {φ | star φ ∈ Φ}
  star_mem_iff' φ := by simp

/-- `φ ∈ ιΦ` exactly when `conj ∘ φ ∈ Φ`. -/
@[simp]
theorem mem_conjugate {Φ : CMType E} {φ : E →+* ℂ} : φ ∈ Φ.conjugate ↔ star φ ∈ Φ :=
  Iff.rfl

/-- An embedding lies in `ιΦ` exactly when it does not lie in `Φ`. -/
theorem mem_conjugate_iff_notMem {Φ : CMType E} {φ : E →+* ℂ} : φ ∈ Φ.conjugate ↔ φ ∉ Φ :=
  Φ.star_mem_iff φ

/-- As a set, `ιΦ` is the complement of `Φ`. -/
theorem coe_conjugate (Φ : CMType E) :
    (Φ.conjugate : Set (E →+* ℂ)) = (Φ : Set (E →+* ℂ))ᶜ :=
  Set.ext fun _ => mem_conjugate_iff_notMem

/-- `ι(ιΦ) = Φ`. -/
@[simp]
theorem conjugate_conjugate (Φ : CMType E) : Φ.conjugate.conjugate = Φ :=
  ext fun φ => by simp

/-- Conjugation of CM types is injective. -/
theorem conjugate_injective : Function.Injective (conjugate : CMType E → CMType E) :=
  Function.LeftInverse.injective conjugate_conjugate

/-- `ιΦ` is never `Φ` once `E` has an embedding into `ℂ`. -/
theorem conjugate_ne_self [Nonempty (E →+* ℂ)] (Φ : CMType E) : Φ.conjugate ≠ Φ := fun h => by
  obtain ⟨φ⟩ := ‹Nonempty (E →+* ℂ)›
  exact iff_not_self (h ▸ (mem_conjugate_iff_notMem (Φ := Φ) (φ := φ)))

/-- The image of `Φ` under complex conjugation of embeddings is `ιΦ`. -/
theorem image_star_coe (Φ : CMType E) :
    star '' (Φ : Set (E →+* ℂ)) = (Φ.conjugate : Set (E →+* ℂ)) := by
  ext φ
  rw [Set.image_star, Set.mem_star, SetLike.mem_coe, SetLike.mem_coe, mem_conjugate]

/-! ### Cardinality -/

/-- When `E` has finitely many embeddings into `ℂ`, a CM type contains exactly half of them:
`2 |Φ| = |Hom(E, ℂ)|`. With infinitely many embeddings both sides are `0`, since `Set.ncard` and
`Nat.card` of an infinite type are `0`. -/
theorem two_mul_ncard (Φ : CMType E) :
    2 * (Φ : Set (E →+* ℂ)).ncard = Nat.card (E →+* ℂ) := by
  have hstar : ((Φ : Set (E →+* ℂ)))ᶜ = star '' (Φ : Set (E →+* ℂ)) := by
    rw [image_star_coe, coe_conjugate]
  have hcompl : ((Φ : Set (E →+* ℂ))ᶜ).ncard = (Φ : Set (E →+* ℂ)).ncard := by
    rw [hstar, Set.ncard_image_of_injective _ star_injective]
  rcases finite_or_infinite (E →+* ℂ) with h | h
  · rw [← Set.ncard_add_ncard_compl (Φ : Set (E →+* ℂ)), hcompl, two_mul]
  · rw [Nat.card_eq_zero_of_infinite, mul_eq_zero, or_iff_right two_ne_zero]
    by_contra hne
    have hfin := Set.finite_of_ncard_ne_zero hne
    have hfin' := Set.finite_of_ncard_ne_zero (hcompl ▸ hne)
    exact Set.infinite_univ (by simpa using hfin.union hfin')

/-! ### Induced types -/

variable {E₀ E₁ : Type*} [CommRing E₀] [CommRing E₁]

/-- The CM type on `E` induced from a CM type `Φ₀` on `E₀` along `f : E₀ →+* E`:
the embeddings `φ` with `φ ∘ f ∈ Φ₀`. For `f` the inclusion of a CM subalgebra this is the
induced type of Milne, *Complex Multiplication*, p.11. -/
def induced (f : E₀ →+* E) (Φ₀ : CMType E₀) : CMType E where
  toSet := {φ | φ.comp f ∈ Φ₀}
  star_mem_iff' φ := by
    rw [Set.mem_ofPred_eq, Set.mem_ofPred_eq, RingHom.star_def, RingHom.comp_assoc,
      ← RingHom.star_def, star_mem_iff]

/-- `φ` lies in the type induced from `Φ₀` exactly when `φ ∘ f ∈ Φ₀`. -/
@[simp]
theorem mem_induced {f : E₀ →+* E} {Φ₀ : CMType E₀} {φ : E →+* ℂ} :
    φ ∈ induced f Φ₀ ↔ φ.comp f ∈ Φ₀ :=
  Iff.rfl

/-- Inducing along the identity does nothing. -/
@[simp]
theorem induced_id (Φ : CMType E) : induced (RingHom.id E) Φ = Φ :=
  ext fun φ => by rw [mem_induced, RingHom.comp_id]

/-- Inducing along `E₀ → E₁ → E` in two steps equals inducing directly. -/
theorem induced_comp (g : E₁ →+* E) (f : E₀ →+* E₁) (Φ₀ : CMType E₀) :
    induced (g.comp f) Φ₀ = induced g (induced f Φ₀) :=
  ext fun φ => by simp only [mem_induced, RingHom.comp_assoc]

/-- Inducing commutes with conjugation of types. -/
theorem induced_conjugate (f : E₀ →+* E) (Φ₀ : CMType E₀) :
    induced f Φ₀.conjugate = (induced f Φ₀).conjugate :=
  ext fun φ => by simp only [mem_conjugate_iff_notMem, mem_induced]

/-! ### The type trace -/

/-- The type trace `a ↦ ∑_{φ ∈ Φ} φ a` of a CM type, as a finite-support sum: it is `0` when
infinitely many `φ ∈ Φ` have `φ a ≠ 0`, and the ordinary sum when `E` has finitely many
embeddings into `ℂ`. -/
noncomputable def typeTrace (Φ : CMType E) (a : E) : ℂ :=
  ∑ᶠ φ ∈ (Φ : Set (E →+* ℂ)), φ a

/-- The type trace is the finite-support sum `∑ᶠ φ ∈ Φ, φ a`. -/
theorem typeTrace_def (Φ : CMType E) (a : E) :
    Φ.typeTrace a = ∑ᶠ φ ∈ (Φ : Set (E →+* ℂ)), φ a :=
  (rfl)

/-- The type trace of `0` is `0`. -/
@[simp]
theorem typeTrace_zero (Φ : CMType E) : Φ.typeTrace 0 = 0 := by
  simp [typeTrace]

/-- A finite-support sum over a set commutes with an additive equivalence. -/
private theorem map_finsum_mem {α : Type*} (e : ℂ ≃+ ℂ) (s : Set α) (g : α → ℂ) :
    e (∑ᶠ φ ∈ s, g φ) = ∑ᶠ φ ∈ s, e (g φ) := by
  rw [AddEquiv.map_finsum]
  exact finsum_congr fun φ => AddEquiv.map_finsum e _

/-- The type trace is additive on elements with finitely many nonzero values on `Φ`. -/
theorem typeTrace_add_of_finite (Φ : CMType E) {a b : E}
    (ha : ((Φ : Set (E →+* ℂ)) ∩ Function.support fun φ : E →+* ℂ => φ a).Finite)
    (hb : ((Φ : Set (E →+* ℂ)) ∩ Function.support fun φ : E →+* ℂ => φ b).Finite) :
    Φ.typeTrace (a + b) = Φ.typeTrace a + Φ.typeTrace b := by
  simp only [typeTrace, map_add]
  exact finsum_mem_add_distrib' ha hb

/-- The type trace is additive when `E` has finitely many embeddings. -/
@[simp]
theorem typeTrace_add [Finite (E →+* ℂ)] (Φ : CMType E) (a b : E) :
    Φ.typeTrace (a + b) = Φ.typeTrace a + Φ.typeTrace b :=
  Φ.typeTrace_add_of_finite (Set.toFinite _) (Set.toFinite _)

/-- The type trace commutes with negation. -/
@[simp]
theorem typeTrace_neg (Φ : CMType E) (a : E) : Φ.typeTrace (-a) = -Φ.typeTrace a := by
  simp only [typeTrace, map_neg]
  rw [← AddEquiv.neg_apply, map_finsum_mem]
  simp only [AddEquiv.neg_apply]

/-- The type trace commutes with subtraction of elements with finitely many nonzero values on
`Φ`. -/
theorem typeTrace_sub_of_finite (Φ : CMType E) {a b : E}
    (ha : ((Φ : Set (E →+* ℂ)) ∩ Function.support fun φ : E →+* ℂ => φ a).Finite)
    (hb : ((Φ : Set (E →+* ℂ)) ∩ Function.support fun φ : E →+* ℂ => φ b).Finite) :
    Φ.typeTrace (a - b) = Φ.typeTrace a - Φ.typeTrace b := by
  have hb' : ((Φ : Set (E →+* ℂ)) ∩ Function.support fun φ : E →+* ℂ => φ (-b)).Finite := by
    simpa only [map_neg, Function.support_fun_neg]
  rw [sub_eq_add_neg, Φ.typeTrace_add_of_finite ha hb', typeTrace_neg, sub_eq_add_neg]

/-- The type trace commutes with subtraction when `E` has finitely many embeddings. -/
@[simp]
theorem typeTrace_sub [Finite (E →+* ℂ)] (Φ : CMType E) (a b : E) :
    Φ.typeTrace (a - b) = Φ.typeTrace a - Φ.typeTrace b :=
  Φ.typeTrace_sub_of_finite (Set.toFinite _) (Set.toFinite _)

/-- The type trace of a finite sum of elements, each with finitely many nonzero values on `Φ`,
is the sum of the type traces. -/
theorem typeTrace_sum_of_finite (Φ : CMType E) {ι : Type*} (s : Finset ι) (f : ι → E)
    (hf : ∀ i ∈ s, ((Φ : Set (E →+* ℂ)) ∩ Function.support fun φ : E →+* ℂ => φ (f i)).Finite) :
    Φ.typeTrace (∑ i ∈ s, f i) = ∑ i ∈ s, Φ.typeTrace (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi ih =>
    have hs : ∀ j ∈ s,
        ((Φ : Set (E →+* ℂ)) ∩ Function.support fun φ : E →+* ℂ => φ (f j)).Finite :=
      fun j hj => hf j (Finset.mem_insert_of_mem hj)
    -- The partial sum has finitely many nonzero values on `Φ`, since each summand does.
    have hsum : ((Φ : Set (E →+* ℂ)) ∩
        Function.support fun φ : E →+* ℂ => φ (∑ j ∈ s, f j)).Finite := by
      refine (s.finite_toSet.biUnion hs).subset ?_
      rintro φ ⟨hφ, h⟩
      rw [Function.mem_support, map_sum] at h
      obtain ⟨j, hj, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero h
      exact Set.mem_biUnion hj ⟨hφ, hne⟩
    rw [Finset.sum_insert hi, Finset.sum_insert hi,
      Φ.typeTrace_add_of_finite (hf i (s.mem_insert_self i)) hsum, ih hs]

/-- The type trace of a finite sum is the sum of the type traces when `E` has finitely many
embeddings. -/
theorem typeTrace_sum [Finite (E →+* ℂ)] (Φ : CMType E) {ι : Type*} (s : Finset ι) (f : ι → E) :
    Φ.typeTrace (∑ i ∈ s, f i) = ∑ i ∈ s, Φ.typeTrace (f i) :=
  Φ.typeTrace_sum_of_finite s f fun _ _ => Set.toFinite _

/-- The type trace is `ℚ`-homogeneous. -/
@[simp]
theorem typeTrace_smul [Module ℚ E] (Φ : CMType E) (q : ℚ) (a : E) :
    Φ.typeTrace (q • a) = q * Φ.typeTrace a := by
  simp only [typeTrace, map_rat_smul, Rat.smul_def]
  exact (mul_finsum_mem _ _).symm

/-- The type trace as a `ℚ`-linear map, for a `ℚ`-algebra `E` with finitely many embeddings into
`ℂ`. -/
noncomputable def typeTraceLinearMap [Module ℚ E] [Finite (E →+* ℂ)] (Φ : CMType E) :
    E →ₗ[ℚ] ℂ where
  toFun := Φ.typeTrace
  map_add' := Φ.typeTrace_add
  map_smul' q a := by rw [typeTrace_smul, RingHom.id_apply, Rat.smul_def]

/-- The `ℚ`-linear type trace is the type trace. -/
@[simp]
theorem typeTraceLinearMap_apply [Module ℚ E] [Finite (E →+* ℂ)] (Φ : CMType E) (a : E) :
    Φ.typeTraceLinearMap a = Φ.typeTrace a :=
  (rfl)

/-- The type trace of `ιΦ` is the complex conjugate of the type trace of `Φ`. -/
@[simp]
theorem typeTrace_conjugate (Φ : CMType E) (a : E) :
    Φ.conjugate.typeTrace a = star (Φ.typeTrace a) := by
  have h : star (Φ.typeTrace a) = ∑ᶠ φ ∈ (Φ : Set (E →+* ℂ)), star (φ a) := by
    rw [typeTrace, ← starAddEquiv_apply, map_finsum_mem]
    simp only [starAddEquiv_apply]
  rw [h, typeTrace]
  refine finsum_mem_eq_of_bijOn star ⟨fun _ hφ => mem_conjugate.mp hφ, star_injective.injOn,
    fun φ hφ => ⟨star φ, ?_, star_star φ⟩⟩ fun φ _ => (star_star (φ a)).symm
  simpa using hφ

private theorem finite_inter_support_conjugate {Φ : CMType E} {a : E}
    (h : ((Φ : Set (E →+* ℂ)) ∩ Function.support fun φ : E →+* ℂ => φ a).Finite) :
    ((Φ.conjugate : Set (E →+* ℂ)) ∩ Function.support fun φ : E →+* ℂ => φ a).Finite := by
  refine (h.image star).subset ?_
  rintro φ ⟨h1, h2⟩
  refine ⟨star φ, ⟨mem_conjugate.mp h1, ?_⟩, star_star φ⟩
  simpa [Function.mem_support, RingHom.star_apply] using h2

/-- The type traces of `Φ` and `ιΦ` add up to the sum over all embeddings. -/
theorem typeTrace_add_typeTrace_conjugate (Φ : CMType E) (a : E) :
    Φ.typeTrace a + Φ.conjugate.typeTrace a = ∑ᶠ φ : E →+* ℂ, φ a := by
  by_cases hfin : ((Φ : Set (E →+* ℂ)) ∩ Function.support fun φ : E →+* ℂ => φ a).Finite
  · have hfin' := finite_inter_support_conjugate hfin
    rw [coe_conjugate] at hfin'
    rw [typeTrace, typeTrace, coe_conjugate, ← finsum_mem_union' disjoint_compl_right hfin hfin',
      Set.union_compl_self, finsum_mem_univ]
  · have hinf : ((Φ.conjugate : Set (E →+* ℂ)) ∩
        Function.support fun φ : E →+* ℂ => φ a).Infinite := fun h =>
      hfin (by simpa using finite_inter_support_conjugate h)
    rw [typeTrace, typeTrace, finsum_mem_eq_zero_of_infinite hfin,
      finsum_mem_eq_zero_of_infinite hinf, finsum_of_infinite_support
        ((Set.not_finite.mp hfin).mono Set.inter_subset_right), add_zero]

/-! ### The reflex field -/

/-- The reflex field `E* ⊆ ℂ` of a CM type: the subfield generated over `ℚ` by its type traces.
When `E` has finitely many embeddings into `ℂ` (for example a CM field) this is the reflex field of
Milne, *Complex Multiplication*, Proposition 1.16 and Definition 1.17. -/
noncomputable def reflexField (Φ : CMType E) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ (Set.range Φ.typeTrace)

/-- The reflex field is the subfield of `ℂ` generated over `ℚ` by the type traces. -/
theorem reflexField_def (Φ : CMType E) :
    Φ.reflexField = IntermediateField.adjoin ℚ (Set.range Φ.typeTrace) :=
  (rfl)

/-- Every type trace lies in the reflex field. -/
theorem typeTrace_mem_reflexField (Φ : CMType E) (a : E) : Φ.typeTrace a ∈ Φ.reflexField :=
  IntermediateField.subset_adjoin ℚ _ ⟨a, rfl⟩

/-- The reflex field lies in `F` exactly when every type trace does. -/
theorem reflexField_le_iff {Φ : CMType E} {F : IntermediateField ℚ ℂ} :
    Φ.reflexField ≤ F ↔ ∀ a, Φ.typeTrace a ∈ F := by
  rw [reflexField, IntermediateField.adjoin_le_iff, Set.range_subset_iff]
  rfl

/-- The reflex field of `ιΦ` lies in that of `Φ`. -/
private theorem conjugate_reflexField_le (Φ : CMType E) : Φ.conjugate.reflexField ≤ Φ.reflexField :=
  reflexField_le_iff.mpr fun a => by
    rw [← add_sub_cancel_left (Φ.typeTrace a) (Φ.conjugate.typeTrace a),
      typeTrace_add_typeTrace_conjugate]
    obtain ⟨q, hq⟩ := TauCeti.IsAlgClosed.finsum_apply_mem_range_algebraMap (Ω := ℂ) a
    rw [← hq]
    exact sub_mem (IntermediateField.algebraMap_mem _ _) (typeTrace_mem_reflexField Φ a)

/-- `ιΦ` has the same reflex field as `Φ`. -/
@[simp]
theorem reflexField_conjugate (Φ : CMType E) : Φ.conjugate.reflexField = Φ.reflexField :=
  le_antisymm Φ.conjugate_reflexField_le (by
    simpa using Φ.conjugate.conjugate_reflexField_le)

end CommRing

/-! ### CM types on a number field -/

section NumberField

variable {K : Type*} [Field K] [NumberField K]

/-- A CM type on a number field `K` has `[K : ℚ] / 2` embeddings. -/
theorem two_mul_ncard_eq_finrank (Φ : CMType K) :
    2 * (Φ : Set (K →+* ℂ)).ncard = Module.finrank ℚ K := by
  rw [two_mul_ncard, Nat.card_eq_fintype_card, Embeddings.card]

/-- On a number field, the sum of a type trace and its conjugate is the trace of `K / ℚ`. -/
theorem typeTrace_add_typeTrace_conjugate_eq_trace (Φ : CMType K) (a : K) :
    Φ.typeTrace a + Φ.conjugate.typeTrace a = algebraMap ℚ ℂ (Algebra.trace ℚ K a) := by
  rw [typeTrace_add_typeTrace_conjugate, finsum_eq_sum_of_fintype,
    trace_eq_sum_embeddings (E := ℂ)]
  exact Fintype.sum_equiv (RingHom.equivRatAlgHom K ℂ) _ _ fun _ => by
    simp [RingHom.equivRatAlgHom_apply]

end NumberField

/-! ### The action of `Aut(ℂ)` on CM types -/

/-- The complex embeddings of `E` are compatible with complex conjugation under every ring
endomorphism `σ` of `ℂ`: `conj ∘ σ ∘ φ = σ ∘ conj ∘ φ`. This holds for CM fields
(`TauCeti.CMType.instStarCompCommuteOfIsCMField`) and is what makes `Aut(ℂ)` act on CM types. -/
class StarCompCommute (E : Type*) [CommRing E] : Prop where
  /-- Complex conjugation commutes with `σ` on embeddings. -/
  star_comp (σ : ℂ →+* ℂ) (φ : E →+* ℂ) : star (σ.comp φ) = σ.comp (star φ)

/-- On a CM field, complex conjugation commutes with every ring endomorphism of `ℂ` on
embeddings (`RingHom.star_comp`). -/
instance instStarCompCommuteOfIsCMField {K : Type*} [Field K] [CharZero K]
    [Algebra.IsIntegral ℚ K] [IsCMField K] : StarCompCommute K :=
  ⟨RingHom.star_comp⟩

section StarCompCommute

variable {E : Type*} [CommRing E] [StarCompCommute E]

/-- `σ ∈ Aut(ℂ)` sends a CM type `Φ` to `σΦ = {σ ∘ φ | φ ∈ Φ}`, written as
`{ψ | σ⁻¹ ∘ ψ ∈ Φ}`. -/
instance instSMulRingAut : SMul (RingAut ℂ) (CMType E) where
  smul σ Φ :=
    { toSet := {ψ | (σ.symm : ℂ →+* ℂ).comp ψ ∈ Φ}
      star_mem_iff' ψ := by
        rw [Set.mem_ofPred_eq, Set.mem_ofPred_eq, ← StarCompCommute.star_comp, star_mem_iff] }

/-- `ψ ∈ σΦ` exactly when `σ⁻¹ ∘ ψ ∈ Φ`. -/
theorem mem_smul {σ : RingAut ℂ} {Φ : CMType E} {ψ : E →+* ℂ} :
    ψ ∈ σ • Φ ↔ (σ.symm : ℂ →+* ℂ).comp ψ ∈ Φ :=
  Iff.rfl

/-- The action `σΦ = {σ ∘ φ | φ ∈ Φ}` of `Aut(ℂ)` on CM types. -/
instance instMulActionRingAut : MulAction (RingAut ℂ) (CMType E) where
  one_smul Φ := ext fun ψ => by
    have h : ((1 : RingAut ℂ).symm : ℂ →+* ℂ).comp ψ = ψ := RingHom.ext fun x => by
      rw [RingHom.comp_apply, RingEquiv.coe_toRingHom, ← RingAut.inv_apply, inv_one,
        RingAut.one_apply]
    rw [mem_smul, h]
  mul_smul σ τ Φ := ext fun ψ => by
    have h : ((σ * τ).symm : ℂ →+* ℂ).comp ψ =
        (τ.symm : ℂ →+* ℂ).comp ((σ.symm : ℂ →+* ℂ).comp ψ) := RingHom.ext fun x => by
      simp only [RingHom.comp_apply, RingEquiv.coe_toRingHom, ← RingAut.inv_apply, mul_inv_rev,
        RingAut.mul_apply]
    rw [mem_smul, mem_smul, mem_smul, h]

/-- `σ ∘ φ ∈ σΦ` exactly when `φ ∈ Φ`. -/
@[simp]
theorem comp_mem_smul_iff {σ : RingAut ℂ} {Φ : CMType E} {φ : E →+* ℂ} :
    (σ : ℂ →+* ℂ).comp φ ∈ σ • Φ ↔ φ ∈ Φ := by
  rw [mem_smul, ← RingHom.comp_assoc]
  simp

/-- As a set, `σΦ` is the image of `Φ` under `φ ↦ σ ∘ φ`. -/
theorem coe_smul (σ : RingAut ℂ) (Φ : CMType E) :
    ((σ • Φ : CMType E) : Set (E →+* ℂ)) = RingHom.comp (σ : ℂ →+* ℂ) '' (Φ : Set (E →+* ℂ)) := by
  ext ψ
  refine ⟨fun h => ⟨(σ.symm : ℂ →+* ℂ).comp ψ, mem_smul.mp h, RingHom.ext fun x => by simp⟩, ?_⟩
  rintro ⟨φ, hφ, rfl⟩
  exact comp_mem_smul_iff.mpr hφ

/-- The type trace of `σΦ` is `σ` applied to the type trace of `Φ`. -/
@[simp]
theorem typeTrace_smul_ringAut (σ : RingAut ℂ) (Φ : CMType E) (a : E) :
    (σ • Φ).typeTrace a = σ (Φ.typeTrace a) := by
  have hinj : Set.InjOn (RingHom.comp (σ : ℂ →+* ℂ)) (Φ : Set (E →+* ℂ)) := fun φ _ ψ _ h =>
    RingHom.ext fun x => σ.injective (RingHom.congr_fun h x)
  rw [typeTrace, typeTrace, coe_smul, finsum_mem_image hinj, ← RingEquiv.coe_toAddEquiv,
    map_finsum_mem]
  simp only [RingHom.comp_apply, RingEquiv.coe_toRingHom, RingEquiv.coe_toAddEquiv]

/-- Conjugating a type commutes with the action of `Aut(ℂ)`: `ι(σΦ) = σ(ιΦ)`. -/
theorem conjugate_smul (σ : RingAut ℂ) (Φ : CMType E) :
    (σ • Φ).conjugate = σ • Φ.conjugate :=
  ext fun ψ => by simp only [mem_conjugate, mem_smul, StarCompCommute.star_comp]

end StarCompCommute

end CMType

end TauCeti
