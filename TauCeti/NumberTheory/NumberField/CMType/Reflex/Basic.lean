/-!
# The type trace and the reflex field of a CM type

For a CM type `Φ` on a commutative ring `E` with finitely many complex embeddings, the **type
trace** is the additive map `typeTrace_Φ : E → ℂ`, `a ↦ ∑_{φ ∈ Φ} φ a`, and the **reflex field**
`E* ⊆ ℂ` of `(E, Φ)` is the subfield generated over `ℚ` by its values. The reflex field is the
field of definition of the CM type: an automorphism `σ` of `ℂ` fixes `E*` pointwise exactly when
it preserves `Φ`, `σ ∘ φ ∈ Φ ↔ φ ∈ Φ` (Dedekind's independence of characters). The reflex norm
of `Φ` is defined on the idèles of `E*`, and the main theorem of complex multiplication describes
the action of the automorphisms of `ℂ` fixing `E*` on abelian varieties of CM type `(E, Φ)`.

The complementary type has the conjugate type trace, `typeTrace_{ιΦ} = conj ∘ typeTrace_Φ`.
Their sum is the full sum over all embeddings, the trace `Tr_{E/ℚ}` when `E` is a number field.
This sum is fixed by every automorphism of `ℂ`, hence rational; so `Φ` and `ιΦ` have the same
reflex field. An automorphism `σ` of `ℂ` sends the type trace of `Φ` to that of `σΦ`. Inducing a
type from a subfield `K ⊆ L` composes the type trace with the trace `Tr_{L/K}`, so it does not
change the reflex field.

Both constructions assume finitely many complex embeddings. This holds for every
finite-dimensional `ℚ`-algebra, such as a finite product of CM fields, by the instance
`Finite.ringHom_of_rat`.

## Main definitions

* `TauCeti.CMType.typeTrace Φ`: the additive map `a ↦ ∑_{φ ∈ Φ} φ a`.
* `TauCeti.CMType.reflexField Φ`: the subfield of `ℂ` generated by the type traces.

## Main results

* `TauCeti.CMType.reflexField_le_iff`: `E* ⊆ F` iff every type trace lies in `F`.
* `TauCeti.CMType.mem_fixingSubgroup_reflexField_iff`: `σ ∈ Aut(ℂ)` fixes `E*` pointwise iff
  `σ ∘ φ ∈ Φ ↔ φ ∈ Φ` for every embedding `φ`, that is, iff `σΦ = Φ`.
* `TauCeti.CMType.typeTrace_star`: `typeTrace_{ιΦ} a = conj (typeTrace_Φ a)`.
* `TauCeti.CMType.typeTrace_add_typeTrace_star_eq_trace`: for a number field,
  `typeTrace_Φ + typeTrace_{ιΦ} = Tr_{E/ℚ}`.
* `TauCeti.CMType.reflexField_eq_adjoin_of_span_eq_top`: `E*` is generated by the type traces
  of any `ℚ`-spanning set of `E`.
* `TauCeti.CMType.reflexField_star`: `Φ` and `ιΦ` have the same reflex field.
* `TauCeti.CMType.typeTrace_smul_ringAut`: `typeTrace_{σΦ} = σ ∘ typeTrace_Φ` for `σ ∈ Aut(ℂ)`.
* `TauCeti.CMType.finiteDimensional_reflexField`: for a CM type on a finite-dimensional
  `ℚ`-algebra, the reflex field has finite degree, so it is a number field.
* `TauCeti.CMType.typeTrace_induced`, `TauCeti.CMType.reflexField_induced`: for number fields
  `K ⊆ L`, the type induced on `L` by `Φ₀` has type trace `typeTrace_{Φ₀} ∘ Tr_{L/K}` and the
  reflex field of `Φ₀`.
* `TauCeti.CMType.finrank_reflexField_of_finrank_eq_two`: a CM type on a quadratic number field
  has a quadratic reflex field.

## References

* J. S. Milne, *Complex Multiplication*, §1, Proposition 1.16 and Definition 1.17, p.13, and
  Proposition 1.18, p.14.
-/

public section

open NumberField ComplexConjugate Finset

namespace TauCeti.CMType

section FiniteEmbeddings

variable {E : Type*} [CommRing E] [Finite (E →+* ℂ)]

/-- The **type trace** `a ↦ ∑_{φ ∈ Φ} φ a` of a CM type `Φ`, an additive map `E → ℂ`. -/
noncomputable def typeTrace (Φ : CMType E) : E →+ ℂ where
  toFun a := ∑ᶠ φ ∈ (Φ : Set (E →+* ℂ)), φ a
  map_zero' := by simp
  map_add' a b := by
    simp only [map_add]
    exact finsum_mem_add_distrib (Set.toFinite _)

theorem typeTrace_apply (Φ : CMType E) (a : E) :
    Φ.typeTrace a = ∑ᶠ φ ∈ (Φ : Set (E →+* ℂ)), φ a :=
  (rfl)

/-- For a CM type consisting of the single embedding `φ`, the type trace is `φ`. -/
theorem typeTrace_eq_of_coe_eq_singleton {Φ : CMType E} {φ : E →+* ℂ}
    (hΦ : (Φ : Set (E →+* ℂ)) = {φ}) (a : E) : Φ.typeTrace a = φ a := by
  rw [typeTrace_apply, hΦ, finsum_mem_singleton]

/-- The type trace as a finite sum over the embeddings in the type. -/
theorem typeTrace_eq_sum [Fintype (E →+* ℂ)] (Φ : CMType E) [DecidablePred (· ∈ Φ)] (a : E) :
    Φ.typeTrace a = ∑ φ with φ ∈ Φ, φ a := by
  rw [typeTrace_apply, finsum_mem_eq_toFinset_sum]
  congr 1
  ext
  simp

/-- The type trace of the complementary type is the complex conjugate of the type trace. -/
@[simp]
theorem typeTrace_star (Φ : CMType E) (a : E) :
    (star Φ).typeTrace a = conj (Φ.typeTrace a) := by
  rw [typeTrace_apply, coe_star_eq_image, finsum_mem_image star_injective.injOn, typeTrace_apply]
  -- `star φ a` is `conj (φ a)`, and `conj` commutes with the finite sum.
  simp_rw [RingHom.star_apply]
  exact ((starRingEnd ℂ : ℂ →+ ℂ).map_finsum_mem _ (Set.toFinite _)).symm

/-- The type traces of `Φ` and of its complementary type add up to the sum over all complex
embeddings. -/
theorem typeTrace_add_typeTrace_star (Φ : CMType E) (a : E) :
    Φ.typeTrace a + (star Φ).typeTrace a = ∑ᶠ φ : E →+* ℂ, φ a := by
  rw [typeTrace_apply, typeTrace_apply, coe_star,
    ← finsum_mem_union disjoint_compl_right (Set.toFinite _) (Set.toFinite _),
    Set.union_compl_self, finsum_mem_univ]

/-- On a number field, the type traces of `Φ` and of its complementary type add up to the trace
`Tr_{K/ℚ}`. -/
theorem typeTrace_add_typeTrace_star_eq_trace {K : Type*} [Field K] [NumberField K]
    (Φ : CMType K) (a : K) :
    Φ.typeTrace a + (star Φ).typeTrace a = algebraMap ℚ ℂ (Algebra.trace ℚ K a) := by
  rw [typeTrace_add_typeTrace_star, finsum_eq_sum_of_fintype,
    NumberField.algebraMap_trace_eq_sum_embeddings]

/-! ### The reflex field -/

/-- The **reflex field** `E* ⊆ ℂ` of a CM type `Φ`: the subfield generated over `ℚ` by the type
traces `∑_{φ ∈ Φ} φ a`, `a ∈ E`. -/
noncomputable def reflexField (Φ : CMType E) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ (Set.range Φ.typeTrace)

theorem reflexField_def (Φ : CMType E) :
    Φ.reflexField = IntermediateField.adjoin ℚ (Set.range Φ.typeTrace) :=
  (rfl)

theorem typeTrace_mem_reflexField (Φ : CMType E) (a : E) : Φ.typeTrace a ∈ Φ.reflexField :=
  IntermediateField.subset_adjoin ℚ _ ⟨a, rfl⟩

/-- The reflex field lies in `F` exactly when every type trace does. -/
theorem reflexField_le_iff {Φ : CMType E} {F : IntermediateField ℚ ℂ} :
    Φ.reflexField ≤ F ↔ ∀ a, Φ.typeTrace a ∈ F := by
  rw [reflexField_def, IntermediateField.adjoin_le_iff, Set.range_subset_iff]
  simp only [SetLike.mem_coe]

/-- **The reflex field is the field of definition of the type.** An automorphism `σ` of `ℂ` fixes
the reflex field pointwise exactly when it preserves `Φ`, that is, `σ ∘ φ ∈ Φ ↔ φ ∈ Φ` for every
embedding `φ`. The forward direction is Dedekind's independence of the characters `E → ℂ`. -/
theorem mem_fixingSubgroup_reflexField_iff (Φ : CMType E) (σ : ℂ ≃ₐ[ℚ] ℂ) :
    σ ∈ Φ.reflexField.fixingSubgroup ↔ ∀ φ : E →+* ℂ, (σ : ℂ →+* ℂ).comp φ ∈ Φ ↔ φ ∈ Φ := by
  classical
  have := Fintype.ofFinite (E →+* ℂ)
  -- Composition with `σ` permutes the embeddings.
  let e : (E →+* ℂ) ≃ (E →+* ℂ) :=
    { toFun := (σ : ℂ →+* ℂ).comp
      invFun := (σ.symm : ℂ →+* ℂ).comp
      left_inv φ := RingHom.ext fun _ ↦ σ.symm_apply_apply _
      right_inv φ := RingHom.ext fun _ ↦ σ.apply_symm_apply _ }
  have he (φ : E →+* ℂ) : e φ = (σ : ℂ →+* ℂ).comp φ := rfl
  -- Applying `σ` to a type trace sums over the transported type `σΦ = {ψ | σ⁻¹ ∘ ψ ∈ Φ}`.
  have key (a : E) : σ (Φ.typeTrace a) = ∑ ψ with e.symm ψ ∈ Φ, ψ a := by
    rw [typeTrace_eq_sum, map_sum]
    exact Finset.sum_equiv e (by simp) fun _ _ ↦ rfl
  rw [IntermediateField.mem_fixingSubgroup_iff]
  refine ⟨fun h ↦ ?_, fun h x hx ↦ ?_⟩
  · -- The sums over `σΦ` and `Φ` agree as functions of `a`, so `σΦ = Φ` by Dedekind.
    let m : (E →+* ℂ) ↪ (E →* ℂ) := ⟨_, RingHom.toMonoidHom_injective⟩
    have hsum (a : E) : ∑ ψ with e.symm ψ ∈ Φ, ψ a = ∑ ψ with ψ ∈ Φ, ψ a := by
      rw [← key, ← typeTrace_eq_sum]
      exact h _ (typeTrace_mem_reflexField Φ a)
    have hst : ({ψ | e.symm ψ ∈ Φ} : Finset _).map m = ({ψ | ψ ∈ Φ} : Finset _).map m :=
      MonoidHom.finset_eq_of_forall_sum_apply_eq fun a ↦ by simpa [m] using hsum a
    intro φ
    have := Finset.ext_iff.mp (Finset.map_inj.mp hst) (e φ)
    rw [mem_filter, mem_filter, e.symm_apply_apply] at this
    simpa [e] using this.symm
  · -- `σ` fixes the generators of the reflex field, hence the whole field.
    induction hx using IntermediateField.adjoin_induction with
    | mem x hx =>
      obtain ⟨a, rfl⟩ := hx
      rw [key, typeTrace_eq_sum]
      refine Finset.sum_congr (Finset.filter_congr fun ψ _ ↦ ?_) fun _ _ ↦ rfl
      have := h (e.symm ψ)
      rwa [← he, e.apply_symm_apply, Iff.comm] at this
    | algebraMap r => exact σ.commutes r
    | add x y _ _ hx hy => rw [map_add, hx, hy]
    | inv x _ hx => rw [map_inv₀, hx]
    | mul x y _ _ hx hy => rw [map_mul, hx, hy]

/-- The reflex field is generated by the type traces of any `ℚ`-spanning set of `E`, such as a
basis, since the type trace is `ℚ`-linear. -/
theorem reflexField_eq_adjoin_of_span_eq_top [Module ℚ E] (Φ : CMType E) {s : Set E}
    (hs : Submodule.span ℚ s = ⊤) :
    Φ.reflexField = IntermediateField.adjoin ℚ (Φ.typeTrace '' s) := by
  refine le_antisymm (reflexField_le_iff.mpr fun a ↦ ?_)
    (IntermediateField.adjoin_le_iff.mpr ?_)
  · have ha : a ∈ Submodule.span ℚ s := hs ▸ Submodule.mem_top
    induction ha using Submodule.span_induction with
    | mem x hx => exact IntermediateField.subset_adjoin ℚ _ ⟨x, hx, rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | smul r x _ hx => rw [map_rat_smul]; exact IntermediateField.smul_mem _ hx
  · rintro _ ⟨a, -, rfl⟩
    exact typeTrace_mem_reflexField Φ a

/-- A CM type and its complementary type have the same reflex field, since their type traces add
up to the sum over all embeddings, which is rational. -/
@[simp]
theorem reflexField_star (Φ : CMType E) : (star Φ).reflexField = Φ.reflexField := by
  have key (Ψ : CMType E) : (star Ψ).reflexField ≤ Ψ.reflexField :=
    reflexField_le_iff.mpr fun a ↦ by
      obtain ⟨q, hq⟩ := IsAlgClosed.finsum_apply_mem_range_algebraMap (Ω := ℂ) a
      rw [eq_sub_of_add_eq' (Ψ.typeTrace_add_typeTrace_star a), ← hq]
      exact sub_mem (IntermediateField.algebraMap_mem _ _) (typeTrace_mem_reflexField Ψ a)
  exact le_antisymm (key Φ) (by simpa using key (star Φ))

/-- The type trace of `σΦ` is `σ` applied to the type trace of `Φ`. -/
@[simp]
theorem typeTrace_smul_ringAut [StarCompCommute E] (σ : RingAut ℂ) (Φ : CMType E) (a : E) :
    (σ • Φ).typeTrace a = σ (Φ.typeTrace a) := by
  have hinj : Set.InjOn (RingHom.comp (σ : ℂ →+* ℂ)) (Φ : Set (E →+* ℂ)) := fun _ _ _ _ h ↦
    RingHom.ext fun x ↦ σ.injective (RingHom.congr_fun h x)
  rw [typeTrace_apply, coe_smul, finsum_mem_image hinj, typeTrace_apply]
  simp [AddEquivClass.map_finsum]

end FiniteEmbeddings

/-! ### Finite-dimensional algebras

A finite-dimensional `ℚ`-algebra has finitely many complex embeddings by `Finite.ringHom_of_rat`,
so the results below do not assume it. -/

section FiniteDimensional

variable {E : Type*} [CommRing E]

/-- **The reflex field has finite degree.** For a CM type on a finite-dimensional `ℚ`-algebra,
such as a finite product of CM fields, the reflex field is generated by the type traces of a
basis, each a finite sum of algebraic numbers. -/
theorem finiteDimensional_reflexField [Algebra ℚ E] [FiniteDimensional ℚ E] (Φ : CMType E) :
    FiniteDimensional ℚ Φ.reflexField := by
  classical
  have := Fintype.ofFinite (E →+* ℂ)
  rw [Φ.reflexField_eq_adjoin_of_span_eq_top (Module.finBasis ℚ E).span_eq]
  refine IntermediateField.finiteDimensional_adjoin ?_
  rintro _ ⟨a, -, rfl⟩
  rw [typeTrace_eq_sum]
  exact IsIntegral.sum _ fun φ _ ↦
    (Algebra.IsIntegral.isIntegral (R := ℚ) a).map φ.toRatAlgHom

/-- The reflex field of a CM type on a finite-dimensional `ℚ`-algebra is a number field. -/
instance instNumberFieldReflexField [Algebra ℚ E] [FiniteDimensional ℚ E] (Φ : CMType E) :
    NumberField Φ.reflexField where
  to_finiteDimensional := finiteDimensional_reflexField Φ

end FiniteDimensional

/-! ### Induced types -/

section Induced

variable {K L : Type*} [Field K] [Field L] [NumberField K] [NumberField L] [Algebra K L]

/-- The type trace of an induced type is the type trace of the inducing type composed with the
trace: `typeTrace_Φ b = typeTrace_{Φ₀} (Tr_{L/K} b)` for the type `Φ` induced on `L` by `Φ₀`. -/
theorem typeTrace_induced (Φ₀ : CMType K) (b : L) :
    (Φ₀.induced (algebraMap K L)).typeTrace b = Φ₀.typeTrace (Algebra.trace K L b) := by
  -- Group the embeddings of `L` in the induced type by their restriction to `K`.
  have hfib : ((Φ₀.induced (algebraMap K L) : CMType L) : Set (L →+* ℂ)) =
      ⋃ φ₀ ∈ (Φ₀ : Set (K →+* ℂ)), (fun φ : L →+* ℂ ↦ φ.comp (algebraMap K L)) ⁻¹' {φ₀} := by
    ext; simp
  rw [typeTrace_apply, typeTrace_apply, hfib, finsum_mem_biUnion
    (Set.pairwiseDisjoint_fiber (fun φ : L →+* ℂ ↦ φ.comp (algebraMap K L)) _) (Set.toFinite _)
    fun _ _ ↦ Set.toFinite _]
  exact finsum_mem_congr rfl fun φ₀ _ ↦ (RingHom.apply_trace_eq_finsum φ₀ b).symm

/-- **An induced type has the reflex field of the type it is induced from.** -/
@[simp]
theorem reflexField_induced (Φ₀ : CMType K) :
    (Φ₀.induced (algebraMap K L)).reflexField = Φ₀.reflexField := by
  refine le_antisymm (reflexField_le_iff.mpr fun b ↦ ?_) (reflexField_le_iff.mpr fun a ↦ ?_)
  · rw [typeTrace_induced]
    exact typeTrace_mem_reflexField Φ₀ _
  · -- On `K`, the induced type trace is `[L : K]` times the original one.
    have h : (Φ₀.induced (algebraMap K L)).typeTrace (algebraMap K L a) =
        (Module.finrank K L : ℂ) * Φ₀.typeTrace a := by
      rw [typeTrace_induced, Algebra.trace_algebraMap, map_nsmul, nsmul_eq_mul]
    have hn : (Module.finrank K L : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Module.finrank_pos.ne'
    rw [← inv_mul_cancel_left₀ hn (Φ₀.typeTrace a), ← h]
    exact mul_mem (inv_mem (IntermediateField.natCast_mem _ _)) (typeTrace_mem_reflexField _ _)

end Induced

/-! ### Quadratic fields -/

section Quadratic

variable {K : Type*} [Field K] [NumberField K]

/-- **A CM type on a quadratic field has a quadratic reflex field**: the type is a single
embedding `φ`, and its reflex field is the image `φ(K)`. -/
theorem finrank_reflexField_of_finrank_eq_two (Φ : CMType K) (h : Module.finrank ℚ K = 2) :
    Module.finrank ℚ Φ.reflexField = 2 := by
  have hcard : Nat.card Φ = 1 := by
    have := Φ.two_mul_card_eq_finrank
    omega
  obtain ⟨⟨φ, hmem⟩, huniq⟩ := Nat.card_eq_one_iff_exists.1 hcard
  have hΦ : (Φ : Set (K →+* ℂ)) = {φ} := Set.eq_singleton_iff_unique_mem.2
    ⟨hmem, fun ψ hψ ↦ congrArg Subtype.val (huniq ⟨ψ, hψ⟩)⟩
  have htrace (x : K) : Φ.typeTrace x = φ.toRatAlgHom x :=
    typeTrace_eq_of_coe_eq_singleton hΦ x
  have hrange : Φ.reflexField = φ.toRatAlgHom.fieldRange := by
    refine le_antisymm (reflexField_le_iff.2 fun x ↦ ⟨x, (htrace x).symm⟩) ?_
    rintro _ ⟨x, rfl⟩
    exact htrace x ▸ typeTrace_mem_reflexField Φ x
  rw [hrange, ← h]
  exact (AlgEquiv.ofInjectiveField φ.toRatAlgHom).toLinearEquiv.finrank_eq.symm

end Quadratic

end TauCeti.CMType
