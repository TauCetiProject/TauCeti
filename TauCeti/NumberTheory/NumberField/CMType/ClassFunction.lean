/-!
# CM class functions and the span of the overlap characters

Colmez's conjectural formula for the Faltings height of an abelian variety with complex
multiplication is a linear functional on a space of rational class functions on `Aut(ℂ)`, and
the heights themselves only see the subspace spanned by the averaged overlap characters `a⁰_Φ`
(`TauCeti.CMType.averageOverlap`). This file introduces both spaces.

* The space `CM⁰` of **CM class functions** (`TauCeti.CMType.classFunctions`) consists of the
  rational functions `a` on `Aut(ℂ)` which are locally constant, in the sense that `a(στ) = a(σ)`
  for all `τ` fixing some number field `K ⊆ ℂ` pointwise, which are class functions, and for which
  `a(σ) + a(cσ)` is constant, `c` being complex conjugation. Pulling back a class function with
  this constant-sum property along a finite Galois quotient of `Aut(ℂ)` gives a CM class function
  (`TauCeti.CMType.comp_mem_classFunctions`).
* The space `H_CM` (`TauCeti.CMType.overlapSpan`) is the `ℚ`-span of the averaged overlaps `a⁰_Φ`
  of all CM types `Φ` on CM fields. It is the domain on which the Faltings heights of CM abelian
  varieties determine a linear functional: two linear maps on `H_CM` agree as soon as they agree on
  every `a⁰_Φ` (`TauCeti.CMType.linearMap_ext_overlapSpan`).

Every member of `H_CM` is invariant under `σ ↦ σ⁻¹` and vanishes at `c`. The constant function
`1` lies in `CM⁰` but not in `H_CM`, so `H_CM` is a proper subspace of `CM⁰`; in particular a
linear functional on `H_CM` does not determine one on `CM⁰`.

The averaged overlap of a product type on `E₁ × E₂` is the sum of the averaged overlaps of its
factors (`TauCeti.CMType.averageOverlap_prod`), so the averaged overlaps of CM types on iterated
products of CM fields lie in `H_CM` as well.

## Main definitions

* `TauCeti.CMType.classFunctions`: the `ℚ`-subspace `CM⁰` of CM class functions on `Aut(ℂ)`.
* `TauCeti.CMType.overlapSpan`: the `ℚ`-span `H_CM` of the averaged overlap characters of the CM
  types on CM fields in a fixed universe.

## Main results

* `TauCeti.exists_finiteDimensional_forall_mem_fixingSubgroup_comp_eq`: the complex embeddings of a
  finite-dimensional `ℚ`-algebra are fixed by the automorphisms of `ℂ` fixing a number field.
* `TauCeti.CMType.averageOverlap_mem_classFunctions`: `a⁰_Φ ∈ CM⁰` for every CM type on a
  finite-dimensional `ℚ`-algebra, such as a CM field or a finite product of CM fields.
* `TauCeti.CMType.comp_mem_classFunctions`: a class function on a group `G` with constant
  `f(g) + f(π(c) g)` pulls back to `CM⁰` along any homomorphism `π : Aut(ℂ) → G` that is trivial
  on the automorphisms fixing a number field.
* `TauCeti.CMType.overlapSpan_le_classFunctions`: `H_CM ⊆ CM⁰`.
* `TauCeti.CMType.apply_inv_of_mem_overlapSpan`,
  `TauCeti.CMType.apply_starRingAut_of_mem_overlapSpan`: members of `H_CM` are inversion invariant
  and vanish at `c`; consequently
  `a(σ) + a(cσ) = a(1)` on `H_CM` (`TauCeti.CMType.add_apply_starRingAut_mul_of_mem_overlapSpan`).
* `TauCeti.CMType.one_notMem_overlapSpan`, `TauCeti.CMType.overlapSpan_lt_classFunctions`:
  `H_CM` is a proper subspace of `CM⁰`.
* `TauCeti.CMType.linearMap_ext_overlapSpan`: linear maps on `H_CM` are determined by their values
  at the averaged overlaps.
* `TauCeti.CMType.overlap_prod`, `TauCeti.CMType.averageOverlap_prod`: additivity of the overlap
  and of the averaged overlap on product types.

## References

* F. Andreatta, E. Z. Goren, B. Howard, K. Madapusi Pera, *Faltings heights of abelian varieties
  with complex multiplication*, Ann. of Math. 187 (2018), §9.1, Definitions 9.1.1 and 9.1.3.
* P. Colmez, *Périodes des variétés abéliennes à multiplication complexe*, Ann. of Math. 138
  (1993), §0.
-/

public section

open NumberField

namespace TauCeti

/-- The complex embeddings of a finite-dimensional `ℚ`-algebra `E` are fixed by every automorphism
of `ℂ` fixing a suitable number field `K ⊆ ℂ`, namely the field generated by the images of a basis
of `E` under all embeddings. -/
theorem exists_finiteDimensional_forall_mem_fixingSubgroup_comp_eq (E : Type*) [Ring E]
    [Algebra ℚ E] [Module.Finite ℚ E] :
    ∃ K : IntermediateField ℚ ℂ, FiniteDimensional ℚ K ∧
      ∀ τ ∈ fixingSubgroup (RingAut ℂ) (K : Set ℂ), ∀ φ : E →+* ℂ,
        (τ : ℂ →+* ℂ).comp φ = φ := by
  let b := Module.finBasis ℚ E
  let S : Set ℂ := Set.range fun p : (E →+* ℂ) × Fin (Module.finrank ℚ E) ↦ p.1 (b p.2)
  refine ⟨IntermediateField.adjoin ℚ S, IntermediateField.finiteDimensional_adjoin ?_,
    fun τ hτ φ ↦ ?_⟩
  · rintro _ ⟨⟨φ, i⟩, rfl⟩
    exact (Algebra.IsIntegral.isIntegral (b i)).map φ.toRatAlgHom
  · -- `τ ∘ φ` and `φ` are `ℚ`-linear and agree on the basis `b`.
    have h : ((τ : ℂ →+* ℂ).comp φ).toRatAlgHom.toLinearMap = φ.toRatAlgHom.toLinearMap :=
      b.ext fun i ↦ by
        simpa using (mem_fixingSubgroup_iff (RingAut ℂ)).mp hτ (φ (b i))
          (IntermediateField.subset_adjoin ℚ S ⟨(φ, i), rfl⟩)
    exact RingHom.ext fun x ↦ LinearMap.congr_fun h x

namespace CMType

universe u

/-! ### CM class functions -/

/-- **The CM class functions** `CM⁰`: the rational functions `a` on `Aut(ℂ)` such that
* `a` is locally constant: there is a number field `K ⊆ ℂ` with `a(στ) = a(σ)` for every `τ` fixing
  `K` pointwise, so that `a` factors through the finite set of embeddings of `K`;
* `a` is a class function: `a(τστ⁻¹) = a(σ)`;
* `a(σ) + a(cσ)` does not depend on `σ`, where `c` is complex conjugation. -/
def classFunctions : Submodule ℚ (RingAut ℂ → ℚ) where
  carrier := {a | (∃ K : IntermediateField ℚ ℂ, FiniteDimensional ℚ K ∧
      ∀ σ, ∀ τ ∈ fixingSubgroup (RingAut ℂ) (K : Set ℂ), a (σ * τ) = a σ) ∧
    (∀ σ τ : RingAut ℂ, a (τ * σ * τ⁻¹) = a σ) ∧
    ∃ d : ℚ, ∀ σ : RingAut ℂ, a σ + a (starRingAut * σ) = d}
  add_mem' := by
    rintro a b ⟨⟨K, hK, ha⟩, ha', d, hd⟩ ⟨⟨L, hL, hb⟩, hb', e, he⟩
    refine ⟨⟨K ⊔ L, inferInstance, fun σ τ hτ ↦ ?_⟩, fun σ τ ↦ ?_, d + e, fun σ ↦ ?_⟩
    · have hτK := fixingSubgroup_antitone (RingAut ℂ) ℂ
        (SetLike.coe_subset_coe.mpr le_sup_left) hτ
      have hτL := fixingSubgroup_antitone (RingAut ℂ) ℂ
        (SetLike.coe_subset_coe.mpr le_sup_right) hτ
      simp only [Pi.add_apply, ha σ τ hτK, hb σ τ hτL]
    · simp only [Pi.add_apply, ha', hb']
    · simp only [Pi.add_apply, ← hd σ, ← he σ]
      ring
  zero_mem' := ⟨⟨⊥, inferInstance, fun _ _ _ ↦ rfl⟩, fun _ _ ↦ rfl, 0, fun _ ↦ add_zero 0⟩
  smul_mem' := by
    rintro q a ⟨⟨K, hK, ha⟩, ha', d, hd⟩
    refine ⟨⟨K, hK, fun σ τ hτ ↦ ?_⟩, fun σ τ ↦ ?_, q * d, fun σ ↦ ?_⟩
    · simp only [Pi.smul_apply, ha σ τ hτ]
    · simp only [Pi.smul_apply, ha']
    · simp only [Pi.smul_apply, smul_eq_mul, ← mul_add, hd σ]

/-- Membership in `CM⁰`: local constancy, conjugation invariance and constant complementary sums. -/
theorem mem_classFunctions_iff {a : RingAut ℂ → ℚ} :
    a ∈ classFunctions ↔ (∃ K : IntermediateField ℚ ℂ, FiniteDimensional ℚ K ∧
      ∀ σ, ∀ τ ∈ fixingSubgroup (RingAut ℂ) (K : Set ℂ), a (σ * τ) = a σ) ∧
    (∀ σ τ : RingAut ℂ, a (τ * σ * τ⁻¹) = a σ) ∧
    ∃ d : ℚ, ∀ σ : RingAut ℂ, a σ + a (starRingAut * σ) = d :=
  Iff.rfl

/-- **Pulling back class functions from a finite Galois quotient.** Let `π : Aut(ℂ) → G` be a
group homomorphism that is trivial on the automorphisms fixing a number field `K ⊆ ℂ`, so that `π`
factors through the finite Galois group of the normal closure of `K`. If `f` is a rational class
function on `G` with `f(g) + f(π(c) g)` constant, then `f ∘ π` is a CM class function. -/
theorem comp_mem_classFunctions {G : Type*} [Group G] (π : RingAut ℂ →* G)
    (K : IntermediateField ℚ ℂ) [FiniteDimensional ℚ K]
    (hπ : fixingSubgroup (RingAut ℂ) (K : Set ℂ) ≤ π.ker) {f : G → ℚ}
    (hf : ∀ g h, f (h * g * h⁻¹) = f g) {d : ℚ} (hd : ∀ g, f g + f (π starRingAut * g) = d) :
    f ∘ π ∈ classFunctions :=
  ⟨⟨K, inferInstance, fun σ τ hτ ↦ by simp [MonoidHom.mem_ker.mp (hπ hτ)]⟩,
    fun σ τ ↦ by simp [hf], d, fun σ ↦ by simpa using hd (π σ)⟩

/-- Every constant function is a CM class function. -/
theorem const_mem_classFunctions (q : ℚ) : Function.const (RingAut ℂ) q ∈ classFunctions :=
  ⟨⟨⊥, inferInstance, fun _ _ _ ↦ rfl⟩, fun _ _ ↦ rfl, q + q, fun _ ↦ rfl⟩

/-- **The averaged overlap is a CM class function.** For a CM type `Φ` on a finite-dimensional
`ℚ`-algebra `E`, such as a CM field or a finite product of CM fields, `a⁰_Φ ∈ CM⁰`. -/
theorem averageOverlap_mem_classFunctions {E : Type*} [CommRing E] [Algebra ℚ E]
    [Module.Finite ℚ E] [StarCompCommute E] (Φ : CMType E) :
    averageOverlap Φ ∈ classFunctions := by
  have : Finite (E →+* ℂ) := .of_equiv _ (RingHom.equivRatAlgHom (R := E) (S := ℂ)).symm
  obtain ⟨K, hK, hfix⟩ := exists_finiteDimensional_forall_mem_fixingSubgroup_comp_eq E
  exact ⟨⟨K, hK, fun σ τ hτ ↦ averageOverlap_mul_of_forall_comp_eq Φ σ (hfix τ hτ)⟩,
    fun σ τ ↦ averageOverlap_conj τ σ Φ, Nat.card Φ,
    averageOverlap_add_averageOverlap_starRingAut_mul Φ⟩

/-! ### The span of the overlap characters -/

/-- **The overlap span** `H_CM`: the `ℚ`-span of the averaged overlaps `a⁰_Φ` of all CM types `Φ`
on CM fields `E` in the universe `u`. By `TauCeti.CMType.averageOverlap_prod` it also contains the
averaged overlaps of the CM types on iterated products of CM fields. -/
def overlapSpan : Submodule ℚ (RingAut ℂ → ℚ) :=
  Submodule.span ℚ {a | ∃ (E : Type u) (_ : Field E) (_ : NumberField E) (_ : IsCMField E)
    (Φ : CMType E), averageOverlap Φ = a}

/-- The averaged overlap of a CM type on a CM field lies in `H_CM`. -/
theorem averageOverlap_mem_overlapSpan {E : Type u} [Field E] [NumberField E] [IsCMField E]
    (Φ : CMType E) : averageOverlap Φ ∈ overlapSpan.{u} :=
  Submodule.subset_span ⟨E, inferInstance, inferInstance, inferInstance, Φ, rfl⟩

/-- `H_CM ⊆ CM⁰`. -/
theorem overlapSpan_le_classFunctions : overlapSpan.{u} ≤ classFunctions :=
  Submodule.span_le.mpr <| by
    rintro _ ⟨E, _, _, _, Φ, rfl⟩
    exact averageOverlap_mem_classFunctions Φ

/-- Every member of `H_CM` is invariant under `σ ↦ σ⁻¹`. -/
theorem apply_inv_of_mem_overlapSpan {a : RingAut ℂ → ℚ} (ha : a ∈ overlapSpan.{u})
    (σ : RingAut ℂ) : a σ⁻¹ = a σ := by
  induction ha using Submodule.span_induction with
  | mem _ h =>
    obtain ⟨E, _, _, _, Φ, rfl⟩ := h
    exact averageOverlap_inv Φ σ
  | zero => rfl
  | add _ _ _ _ h₁ h₂ => simp only [Pi.add_apply, h₁, h₂]
  | smul _ _ _ h => simp only [Pi.smul_apply, h]

/-- Every member of `H_CM` vanishes at complex conjugation. -/
theorem apply_starRingAut_of_mem_overlapSpan {a : RingAut ℂ → ℚ} (ha : a ∈ overlapSpan.{u}) :
    a starRingAut = 0 := by
  induction ha using Submodule.span_induction with
  | mem _ h =>
    obtain ⟨E, _, _, _, Φ, rfl⟩ := h
    exact averageOverlap_starRingAut Φ
  | zero => rfl
  | add _ _ _ _ h₁ h₂ => simp only [Pi.add_apply, h₁, h₂, add_zero]
  | smul _ _ _ h => simp only [Pi.smul_apply, h, smul_zero]

/-- **The complement identity on `H_CM`.** Every member of `H_CM` satisfies
`a(σ) + a(cσ) = a(1)`. -/
theorem add_apply_starRingAut_mul_of_mem_overlapSpan {a : RingAut ℂ → ℚ}
    (ha : a ∈ overlapSpan.{u}) (σ : RingAut ℂ) : a σ + a (starRingAut * σ) = a 1 := by
  obtain ⟨-, -, d, hd⟩ := overlapSpan_le_classFunctions ha
  have h1 := hd 1
  rw [mul_one, apply_starRingAut_of_mem_overlapSpan ha, add_zero] at h1
  rw [hd σ, h1]

/-- The constant function `1` does not lie in `H_CM`, since it does not vanish at complex
conjugation. -/
theorem one_notMem_overlapSpan : (1 : RingAut ℂ → ℚ) ∉ overlapSpan.{u} := fun h ↦
  one_ne_zero (apply_starRingAut_of_mem_overlapSpan h)

/-- **`H_CM` is a proper subspace of `CM⁰`**: the constant function `1` lies in `CM⁰` but not in
`H_CM`. -/
theorem overlapSpan_lt_classFunctions : overlapSpan.{u} < classFunctions := by
  refine IsConcreteLE.lt_iff_le_and_exists.mpr
    ⟨overlapSpan_le_classFunctions, 1, ?_, one_notMem_overlapSpan⟩
  rw [← Function.const_one]
  exact const_mem_classFunctions 1

/-- **Linear maps on `H_CM` are determined by the overlap characters.** Two `ℚ`-linear maps on
`H_CM` agreeing at the averaged overlap `a⁰_Φ` of every CM type `Φ` on a CM field are equal. -/
theorem linearMap_ext_overlapSpan {M : Type*} [AddCommMonoid M] [Module ℚ M]
    {f g : overlapSpan.{u} →ₗ[ℚ] M}
    (h : ∀ (E : Type u) [Field E] [NumberField E] [IsCMField E] (Φ : CMType E),
      f ⟨averageOverlap Φ, averageOverlap_mem_overlapSpan Φ⟩ =
        g ⟨averageOverlap Φ, averageOverlap_mem_overlapSpan Φ⟩) :
    f = g := by
  refine LinearMap.ext_on Submodule.span_span_coe_preimage ?_
  rintro ⟨_, ha⟩ ⟨E, _, _, _, Φ, rfl⟩
  exact h E Φ

/-! ### Product types -/

section Prod

variable {E₁ E₂ : Type*} [CommRing E₁] [CommRing E₂]

/-- The overlap of two product types splits over the factors. -/
private theorem ncard_coe_prod_inter_coe_prod [Finite (E₁ →+* ℂ)] [Finite (E₂ →+* ℂ)]
    (Φ₁ Ψ₁ : CMType E₁) (Φ₂ Ψ₂ : CMType E₂) :
    ((prod Φ₁ Φ₂ : Set (E₁ × E₂ →+* ℂ)) ∩ prod Ψ₁ Ψ₂).ncard =
      ((Φ₁ : Set (E₁ →+* ℂ)) ∩ Ψ₁).ncard + ((Φ₂ : Set (E₂ →+* ℂ)) ∩ Ψ₂).ncard := by
  have h : ((prod Φ₁ Φ₂ : Set (E₁ × E₂ →+* ℂ)) ∩ prod Ψ₁ Ψ₂) =
      (fun ψ : E₁ →+* ℂ ↦ ψ.comp (RingHom.fst E₁ E₂)) '' ((Φ₁ : Set (E₁ →+* ℂ)) ∩ Ψ₁) ∪
        (fun ψ : E₂ →+* ℂ ↦ ψ.comp (RingHom.snd E₁ E₂)) '' ((Φ₂ : Set (E₂ →+* ℂ)) ∩ Ψ₂) := by
    ext φ
    rcases φ.exists_eq_comp_fst_or_snd with ⟨ψ, rfl⟩ | ⟨ψ, rfl⟩ <;>
      simp only [Set.mem_inter_iff, SetLike.mem_coe, comp_fst_mem_prod, comp_snd_mem_prod,
        RingHom.comp_fst_mem_union_iff, RingHom.comp_snd_mem_union_iff]
  rw [h, Set.ncard_union_eq (RingHom.disjoint_image_comp_fst_image_comp_snd _ _)
    (Set.toFinite _) (Set.toFinite _), Set.ncard_image_of_injective _ RingHom.comp_fst_injective,
    Set.ncard_image_of_injective _ RingHom.comp_snd_injective]

variable [StarCompCommute E₁] [StarCompCommute E₂]

/-- **The overlap is additive on product types**: `a_{Φ₁ × Φ₂}(σ) = a_{Φ₁}(σ) + a_{Φ₂}(σ)`. -/
@[simp]
theorem overlap_prod [Finite (E₁ →+* ℂ)] [Finite (E₂ →+* ℂ)] (Φ₁ : CMType E₁) (Φ₂ : CMType E₂)
    (σ : RingAut ℂ) :
    overlap (prod Φ₁ Φ₂) σ = overlap Φ₁ σ + overlap Φ₂ σ := by
  rw [overlap_def, smul_prod, ncard_coe_prod_inter_coe_prod, overlap_def, overlap_def]

/-- `Aut(ℂ)` permutes the complex embeddings of `E` by composition. -/
private def compPerm (E : Type*) [CommRing E] : RingAut ℂ →* Equiv.Perm (E →+* ℂ) where
  toFun σ :=
    { toFun := ((σ : ℂ →+* ℂ).comp ·)
      invFun := ((σ.symm : ℂ →+* ℂ).comp ·)
      left_inv φ := RingHom.ext fun x ↦ by simp
      right_inv φ := RingHom.ext fun x ↦ by simp }
  map_one' := Equiv.ext fun φ ↦ RingHom.ext fun x ↦ by simp
  map_mul' σ τ := Equiv.ext fun φ ↦ RingHom.ext fun x ↦ by simp

private theorem compPerm_apply (E : Type*) [CommRing E] (σ : RingAut ℂ) (φ : E →+* ℂ) :
    compPerm E σ φ = (σ : ℂ →+* ℂ).comp φ :=
  rfl

/-- **The averaged overlap is additive on product types**: `a⁰_{Φ₁ × Φ₂} = a⁰_{Φ₁} + a⁰_{Φ₂}`. -/
@[simp]
theorem averageOverlap_prod [Finite (E₁ →+* ℂ)] [Finite (E₂ →+* ℂ)] (Φ₁ : CMType E₁)
    (Φ₂ : CMType E₂) : averageOverlap (prod Φ₁ Φ₂) = averageOverlap Φ₁ + averageOverlap Φ₂ := by
  -- Compute all three averages over the finite image `G` of `Aut(ℂ)` in the permutations of the
  -- embeddings of `E₁` and of `E₂`.
  let π := ((compPerm E₁).prod (compPerm E₂)).rangeRestrict
  have := Fintype.ofFinite ((compPerm E₁).prod (compPerm E₂)).range
  have hs (g : ((compPerm E₁).prod (compPerm E₂)).range) :
      π (((compPerm E₁).prod (compPerm E₂)).rangeRestrict_surjective g).choose = g :=
    (((compPerm E₁).prod (compPerm E₂)).rangeRestrict_surjective g).choose_spec
  have h₁ (τ : RingAut ℂ) (hτ : π τ = 1) (φ : E₁ →+* ℂ) : (τ : ℂ →+* ℂ).comp φ = φ := by
    simpa [π, compPerm_apply] using congrArg (fun g ↦ g.val.fst φ) hτ
  have h₂ (τ : RingAut ℂ) (hτ : π τ = 1) (φ : E₂ →+* ℂ) : (τ : ℂ →+* ℂ).comp φ = φ := by
    simpa [π, compPerm_apply] using congrArg (fun g ↦ g.val.snd φ) hτ
  have h (τ : RingAut ℂ) (hτ : π τ = 1) (φ : E₁ × E₂ →+* ℂ) : (τ : ℂ →+* ℂ).comp φ = φ := by
    rcases φ.exists_eq_comp_fst_or_snd with ⟨ψ, rfl⟩ | ⟨ψ, rfl⟩
    · rw [← RingHom.comp_assoc, h₁ τ hτ]
    · rw [← RingHom.comp_assoc, h₂ τ hτ]
  ext σ
  rw [Pi.add_apply, averageOverlap_eq_inv_card_mul_sum π h hs,
    averageOverlap_eq_inv_card_mul_sum π h₁ hs, averageOverlap_eq_inv_card_mul_sum π h₂ hs,
    ← mul_add, ← Finset.sum_add_distrib]
  simp only [overlap_prod, Nat.cast_add]

end Prod

end CMType

end TauCeti
