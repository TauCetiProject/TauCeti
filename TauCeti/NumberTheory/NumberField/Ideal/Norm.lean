module

public import Mathlib.NumberTheory.NumberField.Norm
public import Mathlib.RingTheory.Ideal.Norm.RelNorm
public import Mathlib.Analysis.Complex.Norm
import TauCeti.NumberTheory.DedekindDomain.RelNorm
