module

public import Mathlib.Analysis.Complex.Norm
public import Mathlib.NumberTheory.NumberField.Norm
public import Mathlib.RingTheory.Ideal.Norm.AbsNorm
public import Mathlib.RingTheory.Ideal.Norm.RelNorm
public import Mathlib.RingTheory.Ideal.Pointwise
import TauCeti.NumberTheory.DedekindDomain.RelNorm
import TauCeti.NumberTheory.NumberField.AutomorphismAction
import TauCeti.NumberTheory.NumberField.Ideal.IntegersRat

/-!
# Ideal norms from Galois conjugates

In a Galois extension of number fields, the norm of an element or an ideal is recovered from the
product of its Galois conjugates.

## Main results

* `RingHom.prod_norm_automorphisms_eq_absNorm`: over `ℚ`, the product of the complex absolute
  values of the conjugates of an algebraic integer is the absolute norm of its principal ideal.
* `Ideal.prod_smul_eq_map_relNorm`: for a Galois extension `K / F` of number fields, the product of
  the Galois conjugates of an ideal `I` of `𝓞 K` is the extension `(N_{K/F} I) 𝓞 K` of its
  relative norm.
* `Ideal.prod_smul_eq_span_absNorm`: over `ℚ`, the product of the Galois conjugates of `I` is the
  principal ideal generated by `N I`.
-/

public section

open NumberField
open scoped Pointwise

namespace RingHom

/-- In a Galois number field, the product of the absolute values of the conjugates of an
algebraic integer is the absolute norm of its principal ideal, at any complex embedding. -/
theorem prod_norm_automorphisms_eq_absNorm {K : Type*} [Field K] [NumberField K]
    [IsGalois ℚ K] (φ : K →+* ℂ) (α : 𝓞 K) :
    (∏ σ : Gal(K/ℚ), ‖φ (σ (α : K))‖) = (Ideal.absNorm (Ideal.span {α}) : ℝ) := by
  classical
  calc
    _ = ‖φ (algebraMap ℚ K (Algebra.norm ℚ (α : K)))‖ := by
      rw [Algebra.norm_eq_prod_automorphisms, map_prod, Complex.norm_prod]
    _ = ‖(Algebra.norm ℤ α : ℂ)‖ := by
      rw [← Algebra.coe_norm_int]
      simp
    _ = (Ideal.absNorm (Ideal.span {α}) : ℝ) := by
      rw [Ideal.absNorm_span_singleton, Complex.norm_intCast, Nat.cast_natAbs, Int.cast_abs]

end RingHom

namespace Ideal

/-- **The product of the Galois conjugates of an ideal is the extension of its relative norm.**
For a Galois extension `K / F` of number fields and an ideal `I` of `𝓞 K`,
`∏ σ : Gal(K/F), σ • I = (N_{K/F} I) 𝓞 K`. -/
theorem prod_smul_eq_map_relNorm {F K : Type*} [Field F] [NumberField F] [Field K] [NumberField K]
    [Algebra F K] [IsGalois F K] (I : Ideal (𝓞 K)) :
    ∏ σ : Gal(K/F), σ • I = (relNorm (𝓞 F) I).map (algebraMap (𝓞 F) (𝓞 K)) := by
  -- Every generator `N_{K/F}(x)` (`x ∈ I`) factors as `∏ σ, σ • x ∈ ∏ σ, σ • I`.
  have hle : (relNorm (𝓞 F) I).map (algebraMap (𝓞 F) (𝓞 K)) ≤ ∏ σ : Gal(K/F), σ • I := by
    rw [map_relNorm, span_le]
    rintro _ ⟨x, hx, rfl⟩
    have hnorm : algebraMap (𝓞 F) (𝓞 K) (Algebra.intNorm (𝓞 F) (𝓞 K) x) =
        ∏ σ : Gal(K/F), σ • x := by
      apply FaithfulSMul.algebraMap_injective (𝓞 K) K
      rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply (𝓞 F) F K,
        Algebra.algebraMap_intNorm (L := K), Algebra.norm_eq_prod_automorphisms, map_prod]
      exact Finset.prod_congr rfl fun σ _ ↦ (algebraMap_smul_eq_apply σ x).symm
    rw [Function.comp_apply, hnorm]
    exact prod_mem_prod fun σ _ ↦ smul_mem_pointwise_smul σ x I hx
  -- Both sides have relative norm `(N_{K/F} I) ^ [K : F]`, so containment is equality.
  have hnorm : relNorm (𝓞 F) ((relNorm (𝓞 F) I).map (algebraMap (𝓞 F) (𝓞 K))) =
      relNorm (𝓞 F) (∏ σ : Gal(K/F), σ • I) := by
    rw [relNorm_algebraMap, map_prod, Finset.prod_congr rfl fun σ _ ↦ relNorm_smul (𝓞 F) σ I,
      Finset.prod_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
      IsGalois.card_aut_eq_finrank, IsFractionRing.finrank_eq (𝓞 F) F (𝓞 K) K]
  exact (eq_of_le_of_relNorm_eq hle hnorm).symm

/-- **The product of the Galois conjugates of an ideal over `ℚ` is generated by its absolute
norm.** For a Galois number field `K` and an ideal `I` of `𝓞 K`,
`∏ σ : Gal(K/ℚ), σ • I = (N I) 𝓞 K`. -/
theorem prod_smul_eq_span_absNorm {K : Type*} [Field K] [NumberField K] [IsGalois ℚ K]
    (I : Ideal (𝓞 K)) :
    ∏ σ : Gal(K/ℚ), σ • I = span {(absNorm I : 𝓞 K)} := by
  rw [prod_smul_eq_map_relNorm, ← Rat.RingOfIntegers.ideal_span_absNorm_eq_self (relNorm (𝓞 ℚ) I),
    absNorm_relNorm, map_span, Set.image_singleton, map_natCast]

end Ideal
