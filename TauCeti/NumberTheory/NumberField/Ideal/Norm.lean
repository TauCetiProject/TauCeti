module

public import Mathlib.NumberTheory.NumberField.Norm
public import Mathlib.RingTheory.Ideal.Norm.AbsNorm
public import Mathlib.RingTheory.Ideal.Pointwise
public import Mathlib.Analysis.Complex.Norm
import Mathlib.RingTheory.Ideal.Norm.RelNorm
import TauCeti.NumberTheory.DedekindDomain.RelNorm

/-!
# Ideal norms from Galois conjugates

In a Galois number field `K / ℚ`, the absolute norm of an ideal can be read off from its Galois
conjugates in two ways:

* `RingHom.prod_norm_automorphisms_eq_absNorm`: the product of the complex absolute values of the
  conjugates of an algebraic integer `α` is the absolute norm of `Ideal.span {α}`.
* `Ideal.prod_smul_eq_span_absNorm`: for every ideal `I` of `𝓞 K`, the product `∏ σ, σ • I` over
  `Gal(K/ℚ)` is the principal ideal `Ideal.span {(Ideal.absNorm I : 𝓞 K)}`.
-/

public section

open NumberField
open scoped Pointwise

namespace RingHom

/-- In a Galois number field, the product of the absolute values of the conjugates of an
algebraic integer is the absolute norm of its principal ideal, at any complex embedding. -/
theorem prod_norm_automorphisms_eq_absNorm {K : Type*} [Field K] [NumberField K]
    [IsGalois ℚ K] (φ : K →+* ℂ) (α : 𝓞 K) :
    (∏ σ : Gal(K/ℚ), ‖φ (σ (α : K))‖) = (Ideal.absNorm (Ideal.span {α}) : ℝ) := by
  classical
  calc
    _ = ‖φ (algebraMap ℚ K (Algebra.norm ℚ (α : K)))‖ := by
      rw [Algebra.norm_eq_prod_automorphisms, map_prod, Complex.norm_prod]
    _ = ‖(Algebra.norm ℤ α : ℂ)‖ := by
      rw [← Algebra.coe_norm_int]
      simp
    _ = (Ideal.absNorm (Ideal.span {α}) : ℝ) := by
      rw [Ideal.absNorm_span_singleton, Complex.norm_intCast, Nat.cast_natAbs, Int.cast_abs]

end RingHom

namespace Ideal

/-- **The product of the Galois conjugates of an ideal is generated by its absolute norm.**
In a Galois number field `K`, for every ideal `I` of `𝓞 K`, `∏ σ : Gal(K/ℚ), σ • I` equals
`Ideal.span {(Ideal.absNorm I : 𝓞 K)}`. -/
theorem prod_smul_eq_span_absNorm {K : Type*} [Field K] [NumberField K] [IsGalois ℚ K]
    (I : Ideal (𝓞 K)) :
    (∏ σ : Gal(K/ℚ), σ • I) = Ideal.span {(Ideal.absNorm I : 𝓞 K)} := by
  classical
  have hsmul (σ : Gal(K/ℚ)) : σ • I = I.map (galRestrict ℤ ℚ K (𝓞 K) σ) := by
    refine congr_arg (I.map ·) (RingHom.ext fun x ↦ RingOfIntegers.coe_injective ?_)
    change algebraMap (𝓞 K) K (σ • x) = algebraMap (𝓞 K) K (galRestrict ℤ ℚ K (𝓞 K) σ x)
    rw [algebraMap_galRestrict_apply ℤ σ x]
    rfl
  simp_rw [hsmul]
  rw [prod_map_galRestrict_eq_map_relNorm (A := ℤ) ℚ K I, relNorm_int, map_span,
    Set.image_singleton, map_natCast]

end Ideal
