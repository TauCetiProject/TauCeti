/-!
# Element and ideal norms from Galois conjugates

In a Galois extension `L / K` of number fields, the product of the Galois conjugates of an
algebraic integer of `L` is its integral norm to `𝓞 K`, and the product of the Galois conjugates
of an ideal of `𝓞 L` is the extension to `𝓞 L` of its relative norm to `𝓞 K`. Over `ℚ`, this
identifies the product of the conjugates of an ideal `I` of `𝓞 K` with the principal ideal
generated by `Ideal.absNorm I`, and the product of the complex absolute values of the conjugates
of an algebraic integer with the absolute norm of its principal ideal.

## Main results

* `NumberField.RingOfIntegers.prod_automorphisms_smul_eq_intNorm`: in a Galois extension `L / K`
  of number fields,
  `∏ σ : Gal(L/K), σ • α = algebraMap (𝓞 K) (𝓞 L) (Algebra.intNorm (𝓞 K) (𝓞 L) α)`.
* `NumberField.RingOfIntegers.prod_automorphisms_smul_eq_norm`: over `ℚ`,
  `∏ σ : Gal(K/ℚ), σ • α = (Algebra.norm ℤ α : 𝓞 K)`.
* `Ideal.prod_automorphisms_smul_eq_map_relNorm`: in a Galois extension `L / K` of number fields,
  `∏ σ : Gal(L/K), σ • I = (I.relNorm (𝓞 K)).map (algebraMap (𝓞 K) (𝓞 L))`.
* `Ideal.prod_automorphisms_smul_eq_span_absNorm`: over `ℚ`,
  `∏ σ : Gal(K/ℚ), σ • I = Ideal.span {(Ideal.absNorm I : 𝓞 K)}`.
* `RingHom.prod_norm_automorphisms_eq_absNorm`: at any complex embedding `φ : K →+* ℂ`,
  `∏ σ : Gal(K/ℚ), ‖φ (σ α)‖ = Ideal.absNorm (Ideal.span {α})`.
-/

public section

open NumberField
open scoped Pointwise

namespace NumberField.RingOfIntegers

/-- In a Galois extension `L / K` of number fields, the product of the Galois conjugates of an
algebraic integer of `L` is its integral norm to `𝓞 K`, viewed in `𝓞 L`. -/
theorem prod_automorphisms_smul_eq_intNorm (K : Type*) {L : Type*} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [IsGalois K L] (α : 𝓞 L) :
    ∏ σ : Gal(L/K), σ • α = algebraMap (𝓞 K) (𝓞 L) (Algebra.intNorm (𝓞 K) (𝓞 L) α) := by
  classical
  apply FaithfulSMul.algebraMap_injective (𝓞 L) L
  rw [← IsScalarTower.algebraMap_apply (𝓞 K) (𝓞 L) L,
    IsScalarTower.algebraMap_apply (𝓞 K) K L, Algebra.algebraMap_intNorm (L := L),
    Algebra.norm_eq_prod_automorphisms, map_prod]
  simp

/-- In a Galois number field, the product of the Galois conjugates of an algebraic integer is its
norm over `ℤ`, viewed in `𝓞 K`. -/
theorem prod_automorphisms_smul_eq_norm {K : Type*} [Field K] [NumberField K] [IsGalois ℚ K]
    (α : 𝓞 K) :
    ∏ σ : Gal(K/ℚ), σ • α = (Algebra.norm ℤ α : 𝓞 K) := by
  classical
  apply FaithfulSMul.algebraMap_injective (𝓞 K) K
  rw [map_prod, map_intCast, ← Rat.cast_intCast (α := K), Algebra.coe_norm_int]
  simpa using (Algebra.norm_eq_prod_automorphisms ℚ (α : K)).symm

end NumberField.RingOfIntegers

namespace Ideal

/-- **The product of the Galois conjugates of an ideal is its extended relative norm.** In a Galois
extension `L / K` of number fields, `∏ σ : Gal(L/K), σ • I` equals the extension of
`I.relNorm (𝓞 K)` to `𝓞 L`: the generators `Algebra.intNorm (𝓞 K) (𝓞 L) x` for `x ∈ I` lie in the
product of conjugates, and both ideals have the same relative norm `(I.relNorm (𝓞 K)) ^ [L : K]`. -/
theorem prod_automorphisms_smul_eq_map_relNorm (K : Type*) {L : Type*} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [IsGalois K L] (I : Ideal (𝓞 L)) :
    ∏ σ : Gal(L/K), σ • I = (I.relNorm (𝓞 K)).map (algebraMap (𝓞 K) (𝓞 L)) := by
  classical
  refine (eq_of_le_of_relNorm_eq (A := 𝓞 K) ?_ ?_).symm
  · rw [map_relNorm, span_le]
    rintro _ ⟨x, hx, rfl⟩
    rw [Function.comp_apply, ← RingOfIntegers.prod_automorphisms_smul_eq_intNorm K x]
    exact prod_mem_prod fun σ _ ↦ smul_mem_pointwise_smul σ x I hx
  · rw [relNorm_algebraMap, map_prod]
    simp only [relNorm_smul, Finset.prod_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
      IsGalois.card_aut_eq_finrank, IsFractionRing.finrank_eq (𝓞 K) K (𝓞 L) L]

/-- **The product of the Galois conjugates of an ideal over `ℚ` is generated by its absolute norm.**
In a Galois number field `K`, `∏ σ : Gal(K/ℚ), σ • I = (Ideal.absNorm I)`. -/
theorem prod_automorphisms_smul_eq_span_absNorm {K : Type*} [Field K] [NumberField K]
    [IsGalois ℚ K] (I : Ideal (𝓞 K)) :
    ∏ σ : Gal(K/ℚ), σ • I = span {(absNorm I : 𝓞 K)} := by
  classical
  rw [prod_automorphisms_smul_eq_map_relNorm ℚ I,
    ← Rat.RingOfIntegers.ideal_span_absNorm_eq_self (I.relNorm (𝓞 ℚ)),
    absNorm_relNorm, map_span, Set.image_singleton, map_natCast]

end Ideal

namespace RingHom

/-- In a Galois number field, the product of the absolute values of the conjugates of an
algebraic integer is the absolute norm of its principal ideal, at any complex embedding. -/
theorem prod_norm_automorphisms_eq_absNorm {K : Type*} [Field K] [NumberField K]
    [IsGalois ℚ K] (φ : K →+* ℂ) (α : 𝓞 K) :
    (∏ σ : Gal(K/ℚ), ‖φ (σ (α : K))‖) = (Ideal.absNorm (Ideal.span {α}) : ℝ) := by
  classical
  calc
    _ = ‖φ (algebraMap ℚ K (Algebra.norm ℚ (α : K)))‖ := by
      rw [Algebra.norm_eq_prod_automorphisms, map_prod, Complex.norm_prod]
    _ = ‖(Algebra.norm ℤ α : ℂ)‖ := by
      rw [← Algebra.coe_norm_int]
      simp
    _ = (Ideal.absNorm (Ideal.span {α}) : ℝ) := by
      rw [Ideal.absNorm_span_singleton, Complex.norm_intCast, Nat.cast_natAbs, Int.cast_abs]

end RingHom
