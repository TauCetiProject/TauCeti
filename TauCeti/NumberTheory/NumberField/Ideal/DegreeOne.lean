module

public import Mathlib.NumberTheory.NumberField.Basic
public import Mathlib.RingTheory.Ideal.Norm.AbsNorm
import Mathlib.LinearAlgebra.Trace
import TauCeti.RingTheory.Ideal.Norm.AbsNorm

/-!
# Rings of integers and ideals in degree one over `ℚ`

When a field `K` of characteristic zero satisfies `Module.finrank ℚ K = 1` — without `K` being
syntactically `ℚ` — the canonical map `ℤ →+* 𝓞 K` is a ring isomorphism. Transporting along this
isomorphism identifies the ideals of `𝓞 K` with those of `ℤ`: `𝓞 K` is a principal ideal ring,
every ideal of `𝓞 K` is generated by its absolute norm, and the ideal generated by `(n : 𝓞 K)` has
absolute norm `n`.

Case splits between `Module.finrank ℚ K = 1` and `1 < Module.finrank ℚ K` arise in analytic
estimates over a general number field `K` whose exponent `1 - 1 / [K : ℚ]` vanishes in degree one;
the results here let the degree-one branch identify `𝓞 K` with `ℤ` without transporting the entire
problem to `ℚ`.

## Main definitions

* `NumberField.RingOfIntegers.intRingEquivOfFinrankEqOne`: the canonical ring isomorphism
  `ℤ ≃+* 𝓞 K` when `Module.finrank ℚ K = 1`.

## Main results

* `IsIntegralClosure.bijective_algebraMap_int_of_finrank_eq_one` and
  `NumberField.RingOfIntegers.bijective_algebraMap_int_of_finrank_eq_one`: `algebraMap ℤ 𝒪` is
  bijective when `𝒪` is an integral closure of `ℤ` in a degree-one extension `K / ℚ`.
* `NumberField.RingOfIntegers.isPrincipalIdealRing_of_finrank_eq_one`: `𝓞 K` is a principal ideal
  ring in degree one.
* `NumberField.RingOfIntegers.ideal_span_absNorm_eq_self_of_finrank_eq_one`: every ideal `J` of
  `𝓞 K` satisfies `Ideal.span {(Ideal.absNorm J : 𝓞 K)} = J`.
* `NumberField.RingOfIntegers.absNorm_span_natCast_of_finrank_eq_one` and
  `NumberField.RingOfIntegers.absNorm_span_intCast_of_finrank_eq_one`: the absolute norm of `(n)`
  in `𝓞 K` is `n` (for `n : ℕ`) and `|n|` (for `n : ℤ`).
-/

public section

open scoped NumberField

/-- If `K` is a characteristic-zero field of degree one over `ℚ` and `𝒪` is an integral closure of
`ℤ` in `K`, the canonical map `ℤ →+* 𝒪` is bijective. -/
theorem IsIntegralClosure.bijective_algebraMap_int_of_finrank_eq_one {K : Type*} (𝒪 : Type*)
    [Field K] [CharZero K] [CommRing 𝒪] [Algebra 𝒪 K] [IsIntegralClosure 𝒪 ℤ K]
    (hK : Module.finrank ℚ K = 1) : Function.Bijective (algebraMap ℤ 𝒪) := by
  have : NumberField K := { to_finiteDimensional := Module.finite_of_finrank_eq_succ hK }
  have := IsIntegralClosure.module_free ℤ ℚ K 𝒪
  exact Module.Free.bijective_algebraMap_of_finrank_eq_one
    ((IsIntegralClosure.rank ℤ ℚ K 𝒪).trans hK)

namespace NumberField.RingOfIntegers

section CharZero

variable {K : Type*} [Field K] [CharZero K]

/-- In degree one over `ℚ`, the canonical map `ℤ →+* 𝓞 K` is bijective. -/
theorem bijective_algebraMap_int_of_finrank_eq_one (hK : Module.finrank ℚ K = 1) :
    Function.Bijective (algebraMap ℤ (𝓞 K)) :=
  IsIntegralClosure.bijective_algebraMap_int_of_finrank_eq_one (𝓞 K) hK

/-- The canonical ring isomorphism `ℤ ≃+* 𝓞 K` when `Module.finrank ℚ K = 1`. -/
noncomputable def intRingEquivOfFinrankEqOne (hK : Module.finrank ℚ K = 1) : ℤ ≃+* 𝓞 K :=
  RingEquiv.ofBijective (algebraMap ℤ (𝓞 K)) (bijective_algebraMap_int_of_finrank_eq_one hK)

/-- In degree one over `ℚ`, `𝓞 K` is a principal ideal ring. -/
theorem isPrincipalIdealRing_of_finrank_eq_one (hK : Module.finrank ℚ K = 1) :
    IsPrincipalIdealRing (𝓞 K) :=
  IsPrincipalIdealRing.of_surjective (algebraMap ℤ (𝓞 K))
    (bijective_algebraMap_int_of_finrank_eq_one hK).surjective

end CharZero

section NumberField

-- `[NumberField K]` supplies `IsDedekindDomain (𝓞 K)` and `Module.Free ℤ (𝓞 K)` in `Ideal.absNorm`.
variable {K : Type*} [Field K] [NumberField K]

/-- **Every ideal in degree one is generated by its absolute norm.** This generalizes
`Int.ideal_span_absNorm_eq_self` and `Rat.RingOfIntegers.ideal_span_absNorm_eq_self` to any number
field `K` with `Module.finrank ℚ K = 1`. -/
theorem ideal_span_absNorm_eq_self_of_finrank_eq_one (hK : Module.finrank ℚ K = 1)
    (J : Ideal (𝓞 K)) : Ideal.span {(Ideal.absNorm J : 𝓞 K)} = J := by
  let e := intRingEquivOfFinrankEqOne hK
  have h := Int.ideal_span_absNorm_eq_self (J.comap e)
  rw [Ideal.absNorm_comap_of_ringEquiv] at h
  have h' := congrArg (Ideal.map e) h
  rwa [Ideal.map_span, Set.image_singleton, map_natCast,
    Ideal.map_comap_of_surjective _ e.surjective] at h'

/-- In degree one over `ℚ`, the principal ideal generated by `(n : 𝓞 K)` has absolute norm `|n|`. -/
theorem absNorm_span_intCast_of_finrank_eq_one (hK : Module.finrank ℚ K = 1) (n : ℤ) :
    Ideal.absNorm (Ideal.span {(n : 𝓞 K)}) = n.natAbs := by
  rw [Ideal.absNorm_span_singleton, ← eq_intCast (algebraMap ℤ (𝓞 K)), Algebra.norm_algebraMap,
    RingOfIntegers.rank, hK, pow_one]

/-- In degree one over `ℚ`, the principal ideal generated by `(n : 𝓞 K)` has absolute norm `n`. -/
theorem absNorm_span_natCast_of_finrank_eq_one (hK : Module.finrank ℚ K = 1) (n : ℕ) :
    Ideal.absNorm (Ideal.span {(n : 𝓞 K)}) = n := by
  rw [Ideal.absNorm_span_natCast, RingOfIntegers.rank, hK, pow_one]

end NumberField

end NumberField.RingOfIntegers
