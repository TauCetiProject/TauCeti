module

public import Mathlib.NumberTheory.NumberField.Units.DirichletTheorem
public import TauCeti.RingTheory.DedekindDomain.Ideal.DvdAway
import Mathlib.NumberTheory.NumberField.ClassNumber
import TauCeti.RingTheory.ClassGroup.Basic

/-!
# Divisors of `m` away from finitely many primes of a number field

Let `K` be a number field, `P` a finite set of nonzero primes of `𝓞 K` and `m ∈ 𝓞 K` nonzero.
This file shows that the nonzero `β ∈ 𝓞 K` with `ord_v(β) ≤ ord_v(m)` at every prime `v ∉ P`
lie in finitely many cosets `μ Γ` of a finitely generated subgroup `Γ` of `Kˣ` containing the
units of `𝓞 K`.

With `h` the class number of `K`, each `v ^ h` for `v ∈ P` is principal, generated by some
`π v` (`Ideal.isPrincipal_pow_natCard_classGroup`). The group `Γ` is generated by the units of
`𝓞 K` and the `π v`, and is finitely generated by Dirichlet's unit theorem. The cosets come from
the Dedekind-domain result `TauCeti.exists_finset_forall_eq_unit_mul_mul_prod_pow`.

## Main results

* `TauCeti.NumberField.exists_finset_subgroup_forall_eq_mul`: the finitely many cosets above.

## References

* N. Tzanakis and B. M. M. de Weger, *How to explicitly solve a Thue–Mahler equation*,
  Compositio Math. **84** (1992), 223–288, §§5–6.
* [J.-H. Evertse, *Diophantine Approximation*, lecture notes, Leiden/Mastermath, 2019],
  Chapter 5, Corollary 5.11.
-/

public section

open IsDedekindDomain NumberField

namespace TauCeti.NumberField

variable {K : Type*} [Field K] [NumberField K]

/-- Let `P` be a finite set of nonzero primes of `𝓞 K` and `m ≠ 0`. There are a finite set `M`
and a finitely generated subgroup `Γ` of `Kˣ` containing the units of `𝓞 K` such that every
nonzero `β ∈ 𝓞 K` vanishing to order at most `ord_v(m)` at each prime `v ∉ P` is `μ * g` with
`μ ∈ M` and `g ∈ Γ`. -/
theorem exists_finset_subgroup_forall_eq_mul (P : Finset (HeightOneSpectrum (𝓞 K))) {m : 𝓞 K}
    (hm : m ≠ 0) :
    ∃ (M : Finset (𝓞 K)) (Γ : Subgroup Kˣ), Γ.FG ∧
      (∀ ε : (𝓞 K)ˣ, Units.map (algebraMap (𝓞 K) K : 𝓞 K →* K) ε ∈ Γ) ∧
      ∀ β : 𝓞 K, β ≠ 0 → (∀ v ∉ P, v.intValuation m ≤ v.intValuation β) →
        ∃ μ ∈ M, ∃ g ∈ Γ, (β : K) = μ * (g : K) := by
  classical
  -- `π v` generates `v ^ h`, where `h` is the class number.
  have hgen (v : HeightOneSpectrum (𝓞 K)) :=
    (Ideal.isPrincipal_pow_natCard_classGroup v.asIdeal).1
  set π : HeightOneSpectrum (𝓞 K) → 𝓞 K := fun v ↦ (hgen v).choose
  have hπ (v : HeightOneSpectrum (𝓞 K)) :
      Ideal.span {π v} = v.asIdeal ^ Nat.card (ClassGroup (𝓞 K)) :=
    (hgen v).choose_spec.symm
  have hπ0 (v : HeightOneSpectrum (𝓞 K)) : (π v : K) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective (𝓞 K) K)).mpr
      (v.ne_zero_of_span_singleton_eq_pow (hπ v))
  obtain ⟨M, -, hM⟩ :=
    exists_finset_forall_eq_unit_mul_mul_prod_pow Nat.card_pos (fun v _ ↦ hπ v) hm
  -- `Γ` is generated by the units of `𝓞 K` and the `π v` for `v ∈ P`.
  let u : HeightOneSpectrum (𝓞 K) → Kˣ := fun v ↦ Units.mk0 (π v : K) (hπ0 v)
  let Γ : Subgroup Kˣ := (Units.map (algebraMap (𝓞 K) K : 𝓞 K →* K)).range ⊔
    Subgroup.closure ↑(P.image u)
  refine ⟨M, Γ, .sup inferInstance (Subgroup.isMulFG_iff.mpr ⟨_, rfl⟩),
    fun ε ↦ Subgroup.mem_sup_left ⟨ε, rfl⟩, fun β hβ hmβ ↦ ?_⟩
  obtain ⟨μ, hμ, ε, k, rfl⟩ := hM β hβ hmβ
  refine ⟨μ, hμ, Units.map (algebraMap (𝓞 K) K : 𝓞 K →* K) ε * ∏ v ∈ P, u v ^ k v,
    mul_mem (Subgroup.mem_sup_left ⟨ε, rfl⟩) (Subgroup.mem_sup_right (prod_mem fun v hv ↦
      pow_mem (Subgroup.subset_closure (Finset.mem_coe.mpr (Finset.mem_image_of_mem u hv))) _)),
    ?_⟩
  simp only [Units.val_mul, Units.coe_prod, Units.val_pow_eq_pow_val, Units.val_mk0, u,
    Units.coe_map, MonoidHom.coe_ofClass, map_mul, map_prod, map_pow]
  ring

end TauCeti.NumberField
