module

public import Mathlib.NumberTheory.NumberField.Cyclotomic.Ideal
public import TauCeti.RingTheory.DedekindDomain.AdicValuation.LocalDegree
import TauCeti.Data.ZMod.OrderOf
import TauCeti.NumberTheory.NumberField.ResidueDegree
import TauCeti.NumberTheory.RamificationInertia.Tower

/-!
# Local degrees in the cyclotomic towers of prime-power level

Let `K` be a number field, `ℓ` a prime and `v` a finite place of `K`. Along the tower of
cyclotomic extensions `K(μ_{ℓ ^ r})` the local degrees at `v` become divisible by every power of
`ℓ`: for each `j`, for all large `r` and every place `w` above `v` of an extension `F/K` of level
`ℓ ^ r`, the power `ℓ ^ j` divides `e(w ∣ v) f(w ∣ v) = [F_w : K_v]`
(`IsCyclotomicExtension.eventually_pow_dvd_ramificationIdx_mul_inertiaDeg`,
`IsCyclotomicExtension.eventually_pow_dvd_finrank_adicCompletion`). The bound on `r` depends on
`v` and `j` only, not on `F`.

The computation happens in the rational cyclotomic field `ℚ(ζ) ⊆ F` generated by a primitive
`ℓ ^ r`-th root of unity `ζ`. Let `p` be the rational prime below `v`. If `p = ℓ` the prime `ℓ` is
totally ramified in `ℚ(ζ)`, with ramification index `φ(ℓ ^ r)`; if `p ≠ ℓ` the residue degree of
`p` in `ℚ(ζ)` is the order of `p` modulo `ℓ ^ r`, which is divisible by any given power of `ℓ` for
large `r` (`ZMod.eventually_pow_dvd_orderOf_natCast`). Ramification indices and residue degrees
are multiplicative in towers, so `e(w ∣ p) f(w ∣ p)` is a multiple of the corresponding product
for `ℚ(ζ)` and equals `[F_w : K_v] · e(v ∣ p) f(v ∣ p)`, where the last factor does not depend on
`r`. An intermediate field `E` with `[F : E] ≤ d` inherits the divisibility, with `j` lowered by
at most `d`: a prime of `F` contributes at most `[F : E]` to the fundamental identity of `F/E`.

This is the local input to the classical fact that a global Brauer class is split everywhere
locally by a cyclic cyclotomic extension (Milne, Lemma VII.7.3). For `ℓ` odd the Galois group of
`K(μ_{ℓ ^ r})/K` is cyclic; for `ℓ = 2` the cyclic extension is a subfield of index at most two.

## Main results

* `IsCyclotomicExtension.eventually_pow_dvd_ramificationIdx_mul_inertiaDeg`: `ℓ ^ j` divides
  `e(w ∣ v) f(w ∣ v)` at every prime `w` above `v` of every cyclotomic extension of level `ℓ ^ r`,
  for all large `r`.
* `IsCyclotomicExtension.eventually_pow_dvd_finrank_adicCompletion`: the same for the local
  degree `[F_w : K_v]` of the completions.
* `IsCyclotomicExtension.eventually_pow_dvd_finrank_adicCompletion_of_finrank_le`: the same for
  the local degrees of the intermediate fields `E` of `F/K` of bounded relative degree `[F : E]`.

## References

* J. S. Milne, *Class Field Theory*, Chapter VII, Lemma 7.3.
* J. Neukirch, *Algebraic Number Theory*, Chapter I, §10.
-/

public section

universe u

open IsDedekindDomain NumberField
open scoped AdicCompletionExtension IntermediateField

namespace IsCyclotomicExtension

variable {K : Type*} [Field K] [NumberField K]

/-- **Ramification in the cyclotomic towers of prime-power level.** Let `v` be a finite place of a
number field `K` and `ℓ` a prime. For every `j`, the power `ℓ ^ j` divides the product
`e(w ∣ v) f(w ∣ v)` of the ramification index and the residue degree at every prime `w` above `v`
of every cyclotomic extension `F/K` of level `ℓ ^ r`, for all large `r`. -/
theorem eventually_pow_dvd_ramificationIdx_mul_inertiaDeg {ℓ : ℕ} (hℓ : ℓ.Prime) (j : ℕ)
    (v : HeightOneSpectrum (𝓞 K)) :
    ∀ᶠ r in Filter.atTop, ∀ (F : Type u) [Field F] [NumberField F] [Algebra K F]
      [IsCyclotomicExtension {ℓ ^ r} K F] (w : Ideal (𝓞 F)) [w.IsPrime] [w.LiesOver v.asIdeal],
      ℓ ^ j ∣ w.ramificationIdx (𝓞 K) * w.inertiaDeg (𝓞 K) := by
  have : Fact ℓ.Prime := ⟨hℓ⟩
  -- The rational prime `p` below `v`, and the part of `e(v ∣ p) f(v ∣ p)` that is a power of `ℓ`.
  set p := TauCeti.rationalPrimeBelow v
  have hp : p.Prime := TauCeti.prime_rationalPrimeBelow v
  have : Fact p.Prime := ⟨hp⟩
  have : v.asIdeal.LiesOver (Ideal.span {(p : ℤ)}) :=
    ⟨(TauCeti.under_eq_span_rationalPrimeBelow v).symm⟩
  set d := v.asIdeal.ramificationIdx ℤ * v.asIdeal.inertiaDeg ℤ
  have hd : d ≠ 0 := Nat.mul_ne_zero (Ideal.ramificationIdx_pos (R := ℤ) (q := v.asIdeal)).ne'
    (Ideal.inertiaDeg_pos v.asIdeal ℤ).ne'
  set N := j + d.factorization ℓ
  filter_upwards [Filter.eventually_ge_atTop (N + 1),
    ZMod.eventually_pow_dvd_orderOf_natCast hℓ hp.one_lt N] with r hr hord F _ _ _ _ w _ _
  obtain ⟨k, rfl⟩ : ∃ k, r = k + 1 := ⟨r - 1, by omega⟩
  -- The rational cyclotomic field `ℚ(ζ) ⊆ F` and the prime `u` of its integers below `w`.
  have hζ := zeta_spec (ℓ ^ (k + 1)) K F
  let Q := ℚ⟮zeta (ℓ ^ (k + 1)) K F⟯
  have : IsCyclotomicExtension {ℓ ^ (k + 1)} ℚ Q :=
    hζ.intermediateField_adjoin_isCyclotomicExtension ℚ
  have : w.LiesOver (Ideal.span {(p : ℤ)}) := Ideal.LiesOver.trans w v.asIdeal _
  let u := w.under (𝓞 Q)
  -- `ℓ ^ N` divides `e(u ∣ p) f(u ∣ p)`.
  have hu : ℓ ^ N ∣ u.ramificationIdx ℤ * u.inertiaDeg ℤ := by
    by_cases hpℓ : p = ℓ
    · have : u.LiesOver (Ideal.span {(ℓ : ℤ)}) := hpℓ ▸ inferInstance
      rw [Rat.ramificationIdx_eq_of_prime_pow ℓ k Q u]
      exact (pow_dvd_pow ℓ (by omega)).trans ((dvd_mul_right _ _).trans (dvd_mul_right _ _))
    · have hdvd : ¬ p ∣ ℓ ^ (k + 1) := fun h =>
        hpℓ ((Nat.prime_dvd_prime_iff_eq hp hℓ).1 (hp.dvd_of_dvd_pow h))
      rw [Rat.inertiaDeg_eq_of_not_dvd p Q u hdvd]
      exact hord.trans (dvd_mul_left _ _)
  -- Multiplicativity in the towers `ℤ ⊆ 𝓞 Q ⊆ 𝓞 F` and `ℤ ⊆ 𝓞 K ⊆ 𝓞 F`.
  have hdiv : ℓ ^ N ∣ (w.ramificationIdx (𝓞 K) * w.inertiaDeg (𝓞 K)) * d := by
    refine hu.trans ((mul_dvd_mul (Ideal.ramificationIdx_below_dvd u w)
      (Ideal.inertiaDeg_below_dvd u w)).trans (dvd_of_eq ?_))
    rw [Ideal.ramificationIdx_tower v.asIdeal w, Ideal.inertiaDeg_tower v.asIdeal w]
    ring
  -- Cancel the `ℓ`-part `ℓ ^ (d.factorization ℓ)` of `d`; the rest of `d` is prime to `ℓ`.
  rw [← Nat.ordProj_mul_ordCompl_eq_self d ℓ, ← mul_assoc, pow_add] at hdiv
  refine (Nat.Coprime.pow_left j (Nat.coprime_ordCompl hℓ hd)).dvd_of_dvd_mul_right
    (Nat.dvd_of_mul_dvd_mul_right (pow_pos hℓ.pos (d.factorization ℓ)) ?_)
  convert hdiv using 1
  ring

/-- **Local degrees in the cyclotomic towers of prime-power level.** Let `v` be a finite place of
a number field `K` and `ℓ` a prime. For every `j`, the power `ℓ ^ j` divides the local degree
`[F_w : K_v]` at every place `w` above `v` of every cyclotomic extension `F/K` of level `ℓ ^ r`,
for all large `r`. -/
theorem eventually_pow_dvd_finrank_adicCompletion {ℓ : ℕ} (hℓ : ℓ.Prime) (j : ℕ)
    (v : HeightOneSpectrum (𝓞 K)) :
    ∀ᶠ r in Filter.atTop, ∀ (F : Type u) [Field F] [NumberField F] [Algebra K F]
      [IsCyclotomicExtension {ℓ ^ r} K F] (w : HeightOneSpectrum (𝓞 F))
      [w.asIdeal.LiesOver v.asIdeal],
      ℓ ^ j ∣ Module.finrank (v.adicCompletion K) (w.adicCompletion F) := by
  filter_upwards [eventually_pow_dvd_ramificationIdx_mul_inertiaDeg.{u} hℓ j v] with r hr F _ _ _ _
    w _
  have : Finite (𝓞 F ⧸ w.asIdeal) := Ring.HasFiniteQuotients.finiteQuotient w.ne_bot
  rw [HeightOneSpectrum.finrank_adicCompletion]
  exact hr F w.asIdeal

/-- **Local degrees of subextensions of bounded index in the cyclotomic towers.** Let `v` be a
finite place of a number field `K`, `ℓ` a prime and `d` a natural number. For every `j`, the power
`ℓ ^ j` divides the local degree `[E_w : K_v]` at every place `w` above `v` of every intermediate
field `E` of relative degree `[F : E] ≤ d` in a cyclotomic extension `F/K` of level `ℓ ^ r`, for all
large `r`. -/
theorem eventually_pow_dvd_finrank_adicCompletion_of_finrank_le {ℓ : ℕ} (hℓ : ℓ.Prime)
    (j d : ℕ) (v : HeightOneSpectrum (𝓞 K)) :
    ∀ᶠ r in Filter.atTop, ∀ (F : Type u) [Field F] [NumberField F] [Algebra K F]
      [IsCyclotomicExtension {ℓ ^ r} K F] (E : IntermediateField K F),
      Module.finrank E F ≤ d → ∀ (w : HeightOneSpectrum (𝓞 E)) [w.asIdeal.LiesOver v.asIdeal],
      ℓ ^ j ∣ Module.finrank (v.adicCompletion K) (w.adicCompletion E) := by
  filter_upwards [eventually_pow_dvd_ramificationIdx_mul_inertiaDeg.{u} hℓ (j + d) v] with r hr F
    _ _ _ _ E hE w _
  have : Finite (𝓞 E ⧸ w.asIdeal) := Ring.HasFiniteQuotients.finiteQuotient w.ne_bot
  rw [HeightOneSpectrum.finrank_adicCompletion]
  -- A prime `P` of `𝓞 F` above `w`; its contribution `a = e(P ∣ w) f(P ∣ w)` is at most `d`.
  obtain ⟨P, hP, hPw⟩ := Ideal.exists_maximal_ideal_liesOver_of_isIntegral (S := 𝓞 F) w.asIdeal
  have : P.LiesOver v.asIdeal := Ideal.LiesOver.trans P w.asIdeal v.asIdeal
  set a := P.ramificationIdx (𝓞 E) * P.inertiaDeg (𝓞 E)
  set b := w.asIdeal.ramificationIdx (𝓞 K) * w.asIdeal.inertiaDeg (𝓞 K)
  have ha : 0 < a := Nat.mul_pos (Ideal.ramificationIdx_pos (R := 𝓞 E) (q := P))
    (Ideal.inertiaDeg_pos P (𝓞 E))
  have had : a ≤ d := by
    refine (TauCeti.RamificationInertia.ramificationIdx_mul_inertiaDeg_le_finrank
      w.asIdeal P).trans ?_
    rwa [← IsFractionRing.finrank_eq (𝓞 E) E (𝓞 F) F]
  -- Multiplicativity in the tower `𝓞 K ⊆ 𝓞 E ⊆ 𝓞 F` gives `ℓ ^ (j + d) ∣ a * b`; as `a < ℓ ^ d`,
  -- at most `d` factors `ℓ` lie in `a`.
  have hab : ℓ ^ (j + d) ∣ a * b := by
    have := hr F P
    rw [Ideal.ramificationIdx_tower w.asIdeal P, Ideal.inertiaDeg_tower w.asIdeal P] at this
    convert this using 1
    ring
  rcases eq_or_ne b 0 with hb | hb
  · rw [hb]
    exact dvd_zero _
  have : Fact ℓ.Prime := ⟨hℓ⟩
  rw [padicValNat_dvd_iff_le hb]
  rw [padicValNat_dvd_iff_le (mul_ne_zero ha.ne' hb), padicValNat.mul ha.ne' hb] at hab
  have hlt : padicValNat ℓ a < d :=
    (Nat.pow_lt_pow_iff_right hℓ.one_lt).mp <|
      (Nat.le_of_dvd ha pow_padicValNat_dvd).trans_lt (had.trans_lt (Nat.lt_pow_self hℓ.one_lt))
  omega

end IsCyclotomicExtension
