/-!
# Frobenius at a ramified prime of the quadratic base

In a cyclotomic extension of a quadratic number field, suppose the rational prime `p`
ramifies in the base but does not divide the cyclotomic level. Inertia then accounts for
exactly the ambiguity in the action on the quadratic base: the action on a primitive
root of unity determines the residue action. We obtain a congruence modulo the radical
of `(p)` simultaneously at all primes above `p`. If the base contains a square root of
`-p`, this radical is generated by that square root. This is the modulus needed for
the Frobenius comparison of the conjugate arguments of CM theta products.

The signed exponent in the CM comparison is the ramified case of
`New.Parameters.norm_pow_sub_conj_partner_le` in [lsernau/grh-lean][short-proof].
The inertia argument uses the usual finite Galois decomposition theory (Neukirch,
*Algebraic Number Theory*, Chapter I, §9).

[short-proof]: https://github.com/lsernau/grh-lean/tree/72fead102f663d5c7a407964a13dc0cf9d977207/grh
-/

public section

open NumberField Ideal IsCyclotomicExtension

namespace NumberField

variable {K E : Type*} [Field K] [NumberField K] [Field E] [NumberField E]
  [Algebra K E] [IsScalarTower ℚ K E] {p m : ℕ} [NeZero m]
  [IsCyclotomicExtension {m} K E]

omit [IsScalarTower ℚ K E] [NeZero m] in
/-- A rational prime ramified in the quadratic base and prime to the cyclotomic level has
absolute ramification index two. -/
theorem ramificationIdx_eq_two_of_ramified_of_cyclotomic (hK : Module.finrank ℚ K = 2)
    (hp : p ∈ ramifiedPrimes K) (hm : ¬ p ∣ m)
    (Q : Ideal (𝓞 E)) [Q.IsPrime] [Q.LiesOver (span {(p : ℤ)})] : Q.ramificationIdx ℤ = 2 := by
  let P := Q.under (𝓞 K)
  have : P.LiesOver (span {(p : ℤ)}) := Ideal.under_liesOver_of_liesOver (𝓞 K) Q _
  have hnQ : (m : 𝓞 E) ∉ Q := by
    simpa using mt (Ideal.algebraMap_mem_iff_dvd_of_liesOver Q (m : ℤ)).mp
      (mt Int.natCast_dvd_natCast.mp hm)
  have hrel : Q.ramificationIdx (𝓞 K) = 1 :=
    Ideal.ramificationIdx_eq_one_iff.mpr
      (isUnramifiedAt_of_natCast_notMem E m (p := Q.under (𝓞 K)) (by simpa using hnQ) Q)
  rw [Ideal.ramificationIdx_tower P Q, ramificationIdx_eq_two_of_mem_ramifiedPrimes hK hp P,
    hrel, mul_one]

/-- Above a prime ramified in the quadratic base and prime to the level, inertia is
exactly the subgroup fixing the primitive root of unity. -/
theorem inertia_eq_ker_autToPow_of_ramified (hK : Module.finrank ℚ K = 2)
    (hp : p ∈ ramifiedPrimes K) (hm : ¬ p ∣ m) {ζ : E} (hζ : IsPrimitiveRoot ζ m)
    (Q : Ideal (𝓞 E)) [Q.IsPrime] [Q.LiesOver (span {(p : ℤ)})] :
    Q.inertia (E ≃ₐ[ℚ] E) = (hζ.autToPow ℚ).ker := by
  let : Algebra.IsQuadraticExtension ℚ K := ⟨hK⟩
  let : IsGalois ℚ E := isGalois_of_isGalois_of_isCyclotomicExtension ℚ K E {m}
  have hp' := prime_of_mem_ramifiedPrimes hp
  have hidx := ramificationIdx_eq_two_of_ramified_of_cyclotomic hK hp hm Q
  have hred := hζ.toInteger_isPrimitiveRoot.idealQuotient_mk
    (mt Ideal.absNorm_eq_one_iff.mp Ideal.IsPrime.ne_top')
    (by rw [← Ideal.pow_inertiaDeg p Q]; exact (hp'.coprime_iff_not_dvd.mpr hm).pow_left _)
  refine Subgroup.eq_of_le_of_card_ge (fun σ hσ ↦ ?_) ?_
  · -- The reduction of the primitive root still has order `m`.
    rw [MonoidHom.mem_ker, hζ.autToPow_eq_one_iff]
    have hpow : (σ • hζ.toInteger) ^ m = 1 := by
      rw [← smul_pow', hζ.toInteger_isPrimitiveRoot.pow_eq_one, smul_one]
    obtain ⟨i, -, hi⟩ := hζ.toInteger_isPrimitiveRoot.eq_pow_of_pow_eq_one hpow
    have heq := Ideal.Quotient.eq.mpr (Ideal.mem_inertia.mp hσ hζ.toInteger)
    have hredpow : (Ideal.Quotient.mk Q hζ.toInteger) ^ i =
        (Ideal.Quotient.mk Q hζ.toInteger) ^ 1 := by simpa [← hi] using heq
    have hmod : i ≡ 1 [MOD m] := by
      rwa [(hred.isOfFinOrder (NeZero.ne m)).pow_eq_pow_iff_modEq, ← hred.eq_orderOf] at hredpow
    have hfix : hζ.toInteger ^ i = hζ.toInteger ^ 1 := by
      rwa [(hζ.toInteger_isPrimitiveRoot.isOfFinOrder (NeZero.ne m)).pow_eq_pow_iff_modEq,
        ← hζ.toInteger_isPrimitiveRoot.eq_orderOf]
    have he : σ • hζ.toInteger = hζ.toInteger := by simpa [hfix] using hi.symm
    simpa only [algebraMap_smul_eq_apply, IsPrimitiveRoot.coe_toInteger] using
      congrArg (algebraMap (𝓞 E) E) he
  · -- An automorphism fixing the root is determined by its restriction to the base.
    rw [Ideal.card_inertia_eq_ramificationIdx ℤ (E ≃ₐ[ℚ] E) Q, hidx, ← hK,
      ← IsGalois.card_aut_eq_finrank]
    refine Nat.card_le_card_of_injective (fun σ : (hζ.autToPow ℚ).ker ↦ σ.val.restrictNormal K) ?_
    intro σ τ h
    apply Subtype.ext
    apply restrictNormalHom_prod_autToPow_injective ℚ K E m hζ
    exact Prod.ext h ((MonoidHom.mem_ker.mp σ.prop).trans (MonoidHom.mem_ker.mp τ.prop).symm)

omit [NeZero m] in
/-- At a prime over `p`, raising the primitive root to `p ^ n` characterizes the automorphisms
that act as the `n`-th power of arithmetic Frobenius on the residue field. Here `p` ramifies in
the quadratic base, and does not divide the cyclotomic level. -/
theorem quotient_mk_smul_eq_pow_iff_of_ramified (hK : Module.finrank ℚ K = 2)
    (hp : p ∈ ramifiedPrimes K) (hm : ¬ p ∣ m) {ζ : E} (hζ : IsPrimitiveRoot ζ m)
    (Q : Ideal (𝓞 E)) [Q.IsPrime] [Q.LiesOver (span {(p : ℤ)})] (σ : E ≃ₐ[ℚ] E) (n : ℕ) :
    (∀ x : 𝓞 E, Ideal.Quotient.mk Q (σ • x) = Ideal.Quotient.mk Q x ^ (p ^ n)) ↔
      σ ζ = ζ ^ (p ^ n) := by
  let : NeZero m := ⟨by rintro rfl; exact hm (dvd_zero p)⟩
  let : Algebra.IsQuadraticExtension ℚ K := ⟨hK⟩
  let : IsGalois ℚ E := isGalois_of_isGalois_of_isCyclotomicExtension ℚ K E {m}
  let : Fact p.Prime := ⟨prime_of_mem_ramifiedPrimes hp⟩
  obtain ⟨τ, hτ⟩ := exists_isArithFrobAt_int_of_liesOver (p := p) Q
  have hpQ : (m : 𝓞 E) ∉ Q := by
    simpa using mt (Ideal.algebraMap_mem_iff_dvd_of_liesOver Q (m : ℤ)).mp
      (mt Int.natCast_dvd_natCast.mp hm)
  have hτζ : τ • hζ.toInteger = hζ.toInteger ^ p := by
    simpa only [MulSemiringAction.toAlgHom_apply,
      Ideal.natCard_quotient_under_of_liesOver (n := p) Q] using
      hτ.apply_of_pow_eq_one hζ.toInteger_isPrimitiveRoot.pow_eq_one hpQ
  have hτpow (i : ℕ) : (τ ^ i) • hζ.toInteger = hζ.toInteger ^ (p ^ i) := by
    induction i with
    | zero => simp
    | succ i hi => simp [pow_succ', mul_smul, hi, smul_pow', hτζ, pow_mul]
  have hres (x : 𝓞 E) := hτ.mk_pow_smul n x
  simp only [Ideal.natCard_quotient_under_of_liesOver (n := p) Q] at hres
  have hcoset : (∀ x : 𝓞 E, Ideal.Quotient.mk Q (σ • x) = Ideal.Quotient.mk Q x ^ (p ^ n)) ↔
      σ * (τ ^ n)⁻¹ ∈ Q.inertia (E ≃ₐ[ℚ] E) := by
    rw [Ideal.mem_inertia]
    constructor
    · intro h x
      simpa [Ideal.Quotient.eq, mul_smul] using (h ((τ ^ n)⁻¹ • x)).trans
        (hres ((τ ^ n)⁻¹ • x)).symm
    · intro h x
      simpa [mul_smul, hres x] using Ideal.Quotient.eq.mpr (h ((τ ^ n) • x))
  have hker : σ * (τ ^ n)⁻¹ ∈ (hζ.autToPow ℚ).ker ↔
      (τ ^ n)⁻¹ * σ ∈ (hζ.autToPow ℚ).ker := by
    simpa only [MonoidHom.mem_ker, map_mul, map_inv, mul_inv_eq_one, inv_mul_eq_one] using eq_comm
  have he : (τ ^ n) ζ = ζ ^ (p ^ n) := by
    simpa only [algebraMap_smul_eq_apply, map_pow, IsPrimitiveRoot.coe_toInteger] using
      congrArg (algebraMap (𝓞 E) E) (hτpow n)
  rw [hcoset, inertia_eq_ker_autToPow_of_ramified hK hp hm hζ Q, hker, MonoidHom.mem_ker,
    hζ.autToPow_eq_one_iff, ← he]
  simpa only [AlgEquiv.mul_apply, AlgEquiv.coe_inv] using
    (τ ^ n).symm_apply_eq (x := σ ζ) (y := ζ)

omit [IsScalarTower ℚ K E] [NeZero m] in
/-- If `p` ramifies in the quadratic base but does not divide the level, and `θ² = -p`,
the ideal `(θ)` is the intersection of all primes over `p` in the cyclotomic extension. -/
theorem span_eq_iInf_primesOver_of_sq_eq_neg (hK : Module.finrank ℚ K = 2)
    (hp : p ∈ ramifiedPrimes K) (hm : ¬ p ∣ m) {θ : 𝓞 E} (hθ : θ ^ 2 = -(p : 𝓞 E)) :
    Ideal.span {θ} = ⨅ Q : (Ideal.span {(p : ℤ)}).primesOver (𝓞 E), (Q : Ideal (𝓞 E)) := by
  classical
  let : Fact p.Prime := ⟨prime_of_mem_ramifiedPrimes hp⟩
  let P : Ideal ℤ := span {(p : ℤ)}
  have hP : P ≠ ⊥ := by simp [P, (Fact.out : p.Prime).ne_zero]
  have : P.IsMaximal := inferInstanceAs (Ideal.span {(p : ℤ)}).IsMaximal
  have hQmax (Q : Ideal (𝓞 E)) (hQ : Q ∈ P.primesOver (𝓞 E)) : Q.IsMaximal := by
    let : Q.IsPrime := hQ.1
    let : Q.LiesOver P := hQ.2
    exact Ideal.IsPrime.isMaximal inferInstance (Ideal.ne_bot_of_mem_primesOver hP hQ)
  have hprod : P.map (algebraMap ℤ (𝓞 E)) = (∏ Q ∈ (P.primesOver (𝓞 E)).toFinset, Q) ^ 2 := by
    rw [Ideal.map_algebraMap_eq_finsetProd_pow hP, ← Finset.prod_pow]
    refine Finset.prod_congr rfl fun Q hQ ↦ ?_
    have hQ' := Set.mem_toFinset.mp hQ
    let : Q.IsPrime := hQ'.1
    let : Q.LiesOver (span {(p : ℤ)}) := hQ'.2
    rw [ramificationIdx_eq_two_of_ramified_of_cyclotomic hK hp hm Q]
  -- Both the principal ideal and the product of the primes square to `(p)`.
  have hsq : (span {θ}) ^ 2 = (∏ Q ∈ (P.primesOver (𝓞 E)).toFinset, Q) ^ 2 := by
    rw [← hprod, Ideal.span_singleton_pow, hθ, Ideal.span_singleton_neg]
    simp [P, Ideal.map_span]
  have heq : span {θ} = ∏ Q ∈ (P.primesOver (𝓞 E)).toFinset, Q := by
    apply dvd_antisymm
    · exact (UniqueFactorizationMonoid.pow_dvd_pow_iff_dvd two_ne_zero).mp hsq.dvd
    · exact (UniqueFactorizationMonoid.pow_dvd_pow_iff_dvd two_ne_zero).mp hsq.symm.dvd
  rw [heq, Ideal.prod_eq_iInf_of_pairwise_isCoprime]
  · exact le_antisymm
      (le_iInf fun Q ↦ iInf_le_of_le Q.val <| iInf_le _ (Set.mem_toFinset.mpr Q.prop))
      (le_iInf fun Q ↦ le_iInf fun hQ ↦ iInf_le (fun R : P.primesOver (𝓞 E) ↦ R.val)
        ⟨Q, Set.mem_toFinset.mp hQ⟩)
  · intro Q hQ R hR hne
    exact Ideal.isCoprime_iff_sup_eq.mpr (Ideal.IsMaximal.coprime_of_ne
      (hQmax Q (Set.mem_toFinset.mp hQ)) (hQmax R (Set.mem_toFinset.mp hR)) hne)

omit [NeZero m] in
/-- For a CM cyclotomic extension of a quadratic field, the signed action on the primitive
root gives the conjugate Frobenius congruence at a ramified prime, modulo its square root.
The exponent `n` is arbitrary, including zero. -/
theorem dvd_pow_sub_complexConj_of_ramified [IsCMField E] (hK : Module.finrank ℚ K = 2)
    (hp : p ∈ ramifiedPrimes K) (hm : ¬ p ∣ m) {θ : 𝓞 E} (hθ : θ ^ 2 = -(p : 𝓞 E))
    {ζ : E} (hζ : IsPrimitiveRoot ζ m) (σ : E ≃ₐ[ℚ] E) (n : ℕ)
    (hσ : σ ζ = ζ ^ (-(p ^ n : ℕ) : ℤ)) (x : 𝓞 E) :
    θ ∣ x ^ (p ^ n) - ((IsCMField.complexConj E).restrictScalars ℚ * σ) • x := by
  let c := (IsCMField.complexConj E).restrictScalars ℚ
  have hm₀ : m ≠ 0 := by rintro rfl; exact hm (dvd_zero p)
  have hc : c ζ = ζ⁻¹ := by
    have h := IsCMField.mul_complexConj_eq_one_of_pow_eq hm₀ hζ.pow_eq_one (by simp)
    exact eq_inv_of_mul_eq_one_right h
  have ha : (c * σ) ζ = ζ ^ (p ^ n) := by
    rw [AlgEquiv.mul_apply, hσ, map_zpow₀, hc, inv_zpow, zpow_neg, inv_inv, zpow_natCast]
  rw [← Ideal.mem_span_singleton, span_eq_iInf_primesOver_of_sq_eq_neg hK hp hm hθ, Ideal.mem_iInf]
  intro Q
  let : Q.val.IsPrime := Q.prop.1
  let : Q.val.LiesOver (span {(p : ℤ)}) := Q.prop.2
  exact Ideal.Quotient.eq.mp (by
    rw [map_pow, (quotient_mk_smul_eq_pow_iff_of_ramified hK hp hm hζ Q.val _ n).mpr ha x])

end NumberField
