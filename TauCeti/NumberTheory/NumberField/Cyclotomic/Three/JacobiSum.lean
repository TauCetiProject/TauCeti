module

public import TauCeti.NumberTheory.JacobiSum.Cubic
public import TauCeti.NumberTheory.NumberField.Cyclotomic.Three.Primary
public import TauCeti.NumberTheory.NumberField.PowerResidueSymbol.JacobiSum
import TauCeti.NumberTheory.NumberField.InfinitePlace.Norm

/-!
# The Jacobi sum of the cubic residue symbol

Let `χ` be a multiplicative character of order `3` on a finite field `F`, with values in an
integral domain `R`. Then the Jacobi sum `J(χ, χ)` is *primary*: `J(χ, χ) ≡ 2 (mod 3)` in `R`.
The proof rewrites `J(χ, χ) - 2` as `(J(χ, χ) + 1) - 3` and uses the congruence
`TauCeti.three_dvd_jacobiSum_add_one`.

For the cubic residue symbol `χ = (· / P)_3` at a prime `P = (π)` of `ℤ[ω]` of norm prime to `3`,
with `π` primary, this identifies the Jacobi sum: `J(χ, χ) = π`. Indeed `P` divides `J(χ, χ)`
(`Ideal.jacobiSum_powerResidueSymbol_mem`), and `J(χ, χ)` has absolute value `√(N P)` under
both complex embeddings (`Ideal.norm_jacobiSum_powerResidueSymbol`), hence norm `N P`. So
`J(χ, χ)` generates `P`, and since it is primary it is the unique primary generator `π`. This is
the identification on which the proof of cubic reciprocity through Jacobi sums rests.

## Main results

* `TauCeti.isPrimaryEisenstein_jacobiSum`: `J(χ, χ)` is primary for every character `χ` of
  order `3` with values in an integral domain.
* `Ideal.isPrimaryEisenstein_jacobiSum_powerResidueSymbol`: the case of the cubic residue symbol
  `(· / P)_3` at a prime `P` of the ring of integers of a number field, whose norm is prime
  to `3`.
* `Ideal.jacobiSum_powerResidueSymbol_eq_of_isPrimaryEisenstein`: `J(χ, χ) = π` for the cubic
  residue symbol at a prime `P = (π)` of `ℤ[ω]` with `π` primary.

## References

* K. Ireland and M. Rosen, *A Classical Introduction to Modern Number Theory*, Chapter 8, §3,
  Proposition 8.3.4, and Chapter 9, §4, Lemma 1.
* N. Xu, *Reciprocity Laws*, Proposition 4.8.
* S. D. Adhikari, *The early reciprocity laws: from Gauss to Eisenstein*, §3, Lemma 3.2.
* M. C. Relyea, *On finite fields and higher reciprocity*, Proposition 3.19.
-/

public section

open NumberField

namespace TauCeti

variable {F R : Type*} [Field F] [Fintype F] [CommRing R] [IsDomain R]

/-- **The Jacobi sum of a cubic character is primary.** If `χ` is a multiplicative character of
order `3` on a finite field, with values in an integral domain `R`, then `J(χ, χ) ≡ 2 (mod 3)`
in `R`. -/
theorem isPrimaryEisenstein_jacobiSum {χ : MulChar F R} (hχ : orderOf χ = 3) :
    IsPrimaryEisenstein (jacobiSum χ χ) := by
  rw [isPrimaryEisenstein_iff, show jacobiSum χ χ - 2 = jacobiSum χ χ + 1 - 3 by ring]
  exact dvd_sub (three_dvd_jacobiSum_add_one hχ) dvd_rfl

end TauCeti

namespace Ideal

variable {K : Type*} [Field K] [NumberField K] [HasEnoughRootsOfUnity (𝓞 K) 3]
  {P : Ideal (𝓞 K)} [P.IsMaximal] [Fintype (𝓞 K ⧸ P)]

/-- **The Jacobi sum of the cubic residue symbol is primary.** If `P` is a prime of `𝓞 K` whose
norm is prime to `3`, and `χ = (· / P)_3` is the cubic residue symbol at `P`, then
`J(χ, χ) ≡ 2 (mod 3)` in `𝓞 K`. -/
theorem isPrimaryEisenstein_jacobiSum_powerResidueSymbol (hP : (absNorm P).Coprime 3) :
    TauCeti.IsPrimaryEisenstein
      (jacobiSum (powerResidueSymbol P 3) (powerResidueSymbol P 3)) := by
  let _ := Ideal.Quotient.field P
  exact TauCeti.isPrimaryEisenstein_jacobiSum (orderOf_powerResidueSymbol hP)

/-- **The Jacobi sum of the cubic residue symbol of a primary prime.** Let `K = ℚ(ω)` and let
`P = (π)` be a prime of `𝓞 K = ℤ[ω]` whose norm is prime to `3`, generated by a primary element
`π`. Then the Jacobi sum of the cubic residue symbol `χ = (· / P)_3` is `J(χ, χ) = π`. -/
theorem jacobiSum_powerResidueSymbol_eq_of_isPrimaryEisenstein [IsCyclotomicExtension {3} ℚ K]
    (hP : (absNorm P).Coprime 3) {π : 𝓞 K} (hπP : P = span {π})
    (hπ : TauCeti.IsPrimaryEisenstein π) :
    jacobiSum (powerResidueSymbol P 3) (powerResidueSymbol P 3) = π := by
  set J := jacobiSum (powerResidueSymbol P 3) (powerResidueSymbol P 3)
  have hP0 : absNorm P ≠ 0 := by
    rintro h
    rw [h, Nat.coprime_zero_left] at hP
    lia
  -- `|N(J)| = N P`: both complex embeddings send `J` to a number of absolute value `√(N P)`.
  have hnorm : absNorm (span {J}) = absNorm P := by
    have h := InfinitePlace.abs_norm_eq_pow_finrank (x := (J : K)) (r := √(absNorm P))
      fun w ↦ by
        rw [← w.norm_embedding_eq]
        exact norm_jacobiSum_powerResidueSymbol hP (by norm_num) _
    rw [← RingOfIntegers.rank, TauCeti.finrank_ringOfIntegers_three,
      Real.sq_sqrt (Nat.cast_nonneg _), ← Algebra.coe_norm_int] at h
    rw [absNorm_span_singleton, ← Int.natCast_inj, Int.natCast_natAbs]
    exact_mod_cast h
  -- `P` divides `(J)` and both have the same norm, so `(J) = P`.
  have hspan : span {J} = P := by
    obtain ⟨I, hI⟩ := dvd_iff_le.mpr ((span_singleton_le_iff_mem _).mpr
      (jacobiSum_powerResidueSymbol_mem hP (by norm_num)))
    rw [hI, map_mul, Nat.mul_eq_left hP0, absNorm_eq_one_iff] at hnorm
    rw [hI, hnorm, mul_top]
  have hπ0 : π ≠ 0 := by
    rintro rfl
    exact hP0 (by rw [hπP, span_singleton_eq_bot.mpr rfl, absNorm_bot])
  have hπprime : Prime π := (span_singleton_prime hπ0).mp (hπP ▸ inferInstance)
  have hN : Algebra.norm ℤ π ≠ 3 := by
    intro h
    rw [hπP, absNorm_span_singleton, h] at hP
    norm_num at hP
  -- `J` and `π` are primary associates of the same prime, hence equal.
  rw [hπP, span_singleton_eq_span_singleton] at hspan
  obtain ⟨ρ, -, huniq⟩ := hπprime.existsUnique_associated_isPrimaryEisenstein hN
  exact (huniq J ⟨hspan.symm, isPrimaryEisenstein_jacobiSum_powerResidueSymbol hP⟩).trans
    (huniq π ⟨Associated.refl π, hπ⟩).symm

end Ideal

section Examples

open Ideal

variable {K : Type*} [Field K] [NumberField K] [IsCyclotomicExtension {3} ℚ K]
  [HasEnoughRootsOfUnity (𝓞 K) 3]

/- The primary element `π = -1 - 3ω` generates a prime of norm `7`, and the Jacobi sum of the
cubic residue symbol at that prime is `π` itself. The norm is read off from `π ^ 2 - π + 7 = 0`,
which forces trace `1` and norm `7`. -/
example {ζ : K} (hζ : IsPrimitiveRoot ζ 3) {P : Ideal (𝓞 K)} [P.IsMaximal] [Fintype (𝓞 K ⧸ P)]
    (hP : P = span {((-1 : ℤ) : 𝓞 K) + (-3 : ℤ) * hζ.toInteger}) :
    jacobiSum (powerResidueSymbol P 3) (powerResidueSymbol P 3) =
      ((-1 : ℤ) : 𝓞 K) + (-3 : ℤ) * hζ.toInteger := by
  refine jacobiSum_powerResidueSymbol_eq_of_isPrimaryEisenstein ?_ hP
    (by rw [hζ.isPrimaryEisenstein_add_mul_iff]; decide)
  have : Algebra.IsQuadraticExtension ℤ (𝓞 K) := ⟨TauCeti.finrank_ringOfIntegers_three⟩
  have hω := IsCyclotomicExtension.Rat.Three.eta_sq hζ
  rw [IsCyclotomicExtension.Rat.Three.coe_eta] at hω
  have h := Algebra.IsQuadraticExtension.sq_sub_trace_smul_add_norm_eq_zero ℤ
    (((-1 : ℤ) : 𝓞 K) + (-3 : ℤ) * hζ.toInteger)
  generalize Algebra.trace ℤ (𝓞 K) (((-1 : ℤ) : 𝓞 K) + (-3 : ℤ) * hζ.toInteger) = T at h
  generalize hN : Algebra.norm ℤ (((-1 : ℤ) : 𝓞 K) + (-3 : ℤ) * hζ.toInteger) = N at h
  have h0 : (((T + N - 8 : ℤ) : 𝓞 K) + ((3 * T - 3 : ℤ) : 𝓞 K) * hζ.toInteger) = 0 := by
    rw [zsmul_eq_mul, algebraMap_int_eq, eq_intCast] at h
    push_cast at h ⊢
    linear_combination h - 9 * hω
  -- Both coordinates of `h0` vanish, so `T = 1` and `N = 7`.
  obtain ⟨h1, h2⟩ := (hζ.intCast_dvd_intCast_add_intCast_mul_toInteger_iff
    (by rw [Nat.totient_prime Nat.prime_three]) (m := 0) (a := T + N - 8) (b := 3 * T - 3)).mp
      (by rw [Int.cast_zero, h0])
  rw [zero_dvd_iff] at h1 h2
  rw [hP, absNorm_span_singleton, hN, show N = 7 by omega]
  decide

end Examples
