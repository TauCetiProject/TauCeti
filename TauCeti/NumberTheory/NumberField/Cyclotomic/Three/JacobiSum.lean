public import Mathlib.NumberTheory.NumberField.Cyclotomic.Galois
public import TauCeti.NumberTheory.JacobiSum.Cubic
public import TauCeti.NumberTheory.NumberField.Cyclotomic.RootsOfUnity
public import TauCeti.NumberTheory.NumberField.Cyclotomic.Three.Primary
public import TauCeti.NumberTheory.NumberField.PowerResidueSymbol.JacobiSum

/-!
# The Jacobi sum of the cubic residue symbol

Let `χ` be a multiplicative character of order `3` on a finite field `F`, with values in an
integral domain `R`. Then the Jacobi sum `J(χ, χ)` is *primary*: `J(χ, χ) ≡ 2 (mod 3)` in `R`.

For `K = ℚ(ζ₃)`, so that `𝓞 K = ℤ[ω]`, and the cubic residue symbol `χ = (· / P)_3` at a prime
`P` of `𝓞 K` whose norm is prime to `3`, this identifies `J(χ, χ)` with the primary generator of
`P`, on which the proof of cubic reciprocity rests:

* `J(χ, χ) J(χ⁻¹, χ⁻¹) = N P`, and the automorphism of `K` with `ζ₃ ↦ ζ₃ ^ 2` maps `J(χ, χ)` to
  `J(χ⁻¹, χ⁻¹)`, so `J(χ, χ)` and its conjugate have the same norm and `J(χ, χ)` has norm `N P`;
* `J(χ, χ) ∈ P` (`Ideal.jacobiSum_powerResidueSymbol_pow_mem`), so `J(χ, χ)` generates `P`;
* a generator of `P` that is primary is unique
  (`Prime.existsUnique_associated_isPrimaryEisenstein`), so `J(χ, χ) = π` whenever `P = (π)` with
  `π` primary.

## Main results

* `TauCeti.isPrimaryEisenstein_jacobiSum`: `J(χ, χ)` is primary for every character `χ` of
  order `3` with values in an integral domain.
* `Ideal.isPrimaryEisenstein_jacobiSum_powerResidueSymbol`: the case of the cubic residue symbol
  `(· / P)_3` at a prime `P` of the ring of integers of a number field, whose norm is prime
  to `3`.
* `Ideal.absNorm_span_singleton_jacobiSum_powerResidueSymbol_three`: for `K = ℚ(ζ₃)`, the ideal
  generated by `J(χ, χ)` has norm `N P`.
* `Ideal.span_singleton_jacobiSum_powerResidueSymbol_three`: for `K = ℚ(ζ₃)`, `J(χ, χ)`
  generates `P`.
* `Ideal.jacobiSum_powerResidueSymbol_three_eq`: for `K = ℚ(ζ₃)` and `P = (π)` with `π` primary,
  `J(χ, χ) = π`.

## References

* K. Ireland and M. Rosen, *A Classical Introduction to Modern Number Theory*, Chapter 8, §3,
  Proposition 8.3.4, and Chapter 9, §4.
* N. Xu, *Reciprocity Laws*, Proposition 4.8.
* S. D. Adhikari, *The early reciprocity laws: from Gauss to Eisenstein*, §3, Lemma 3.2 and its
  proof.
-/

public section

open NumberField

namespace TauCeti

variable {F R : Type*} [Field F] [Fintype F] [CommRing R] [IsDomain R]

/-- **The Jacobi sum of a cubic character is primary.** If `χ` is a multiplicative character of
order `3` on a finite field, with values in an integral domain `R`, then `J(χ, χ) ≡ 2 (mod 3)`
in `R`. -/
theorem isPrimaryEisenstein_jacobiSum {χ : MulChar F R} (hχ : orderOf χ = 3) :
    IsPrimaryEisenstein (jacobiSum χ χ) := by
  rw [isPrimaryEisenstein_iff, show jacobiSum χ χ - 2 = jacobiSum χ χ + 1 - 3 by ring]
  exact dvd_sub (three_dvd_jacobiSum_add_one hχ) dvd_rfl

end TauCeti

namespace Ideal

section NumberField

variable {K : Type*} [Field K] [NumberField K] [HasEnoughRootsOfUnity (𝓞 K) 3]
  {P : Ideal (𝓞 K)} [P.IsMaximal] [Fintype (𝓞 K ⧸ P)]

/-- **The Jacobi sum of the cubic residue symbol is primary.** If `P` is a prime of `𝓞 K` whose
norm is prime to `3`, and `χ = (· / P)_3` is the cubic residue symbol at `P`, then
`J(χ, χ) ≡ 2 (mod 3)` in `𝓞 K`. -/
theorem isPrimaryEisenstein_jacobiSum_powerResidueSymbol (hP : (absNorm P).Coprime 3) :
    TauCeti.IsPrimaryEisenstein
      (jacobiSum (powerResidueSymbol P 3) (powerResidueSymbol P 3)) := by
  let _ := Ideal.Quotient.field P
  exact TauCeti.isPrimaryEisenstein_jacobiSum (orderOf_powerResidueSymbol hP)

end NumberField

section Eisenstein

open IsCyclotomicExtension.Rat

variable {K : Type*} [Field K] [NumberField K] [IsCyclotomicExtension {3} ℚ K]
  {P : Ideal (𝓞 K)} [P.IsMaximal] [Fintype (𝓞 K ⧸ P)]

/-- **The cubic Jacobi sum has norm `N P`.** If `K = ℚ(ζ₃)`, `P` is a prime of `𝓞 K` whose norm is
prime to `3`, and `χ = (· / P)_3`, then the ideal generated by `J(χ, χ)` has norm `N P`. -/
theorem absNorm_span_singleton_jacobiSum_powerResidueSymbol_three (hP : (absNorm P).Coprime 3) :
    absNorm (span {jacobiSum (powerResidueSymbol P 3) (powerResidueSymbol P 3)}) =
      absNorm P := by
  -- The automorphism `σ` of `𝓞 K` with `σ ζ = ζ ^ 2` squares every cube root of unity.
  let σ : 𝓞 K ≃+* 𝓞 K :=
    MulSemiringAction.toRingEquiv Gal(K/ℚ) (𝓞 K) ((galEquivZMod 3 K).symm (-1))
  have hσ (x : 𝓞 K) (hx : x ^ 3 = 1) : σ x = x ^ 2 := by
    rw [MulSemiringAction.toRingEquiv_apply_apply, galEquivZMod_smul_of_pow_eq 3 K _ hx,
      MulEquiv.apply_symm_apply]
    -- The representative of `-1` in `ZMod 3` is `2`.
    rfl
  -- So `σ` maps `J(χ, χ)` to `J(χ⁻¹, χ⁻¹)`, since `χ⁻¹ = χ ^ 2`.
  have h3 : powerResidueSymbol P 3 ^ 3 = 1 := by
    simpa only [orderOf_powerResidueSymbol hP] using pow_orderOf_eq_one (powerResidueSymbol P 3)
  have hχ : (powerResidueSymbol P 3)⁻¹ = (powerResidueSymbol P 3).ringHomComp σ := by
    refine MulChar.ext fun u ↦ ?_
    rw [MulChar.ringHomComp_apply, RingEquiv.coe_toRingHom,
      hσ _ (powerResidueSymbol_pow_eq_one hP u.ne_zero),
      inv_eq_of_mul_eq_one_right (b := powerResidueSymbol P 3 ^ 2) (by rwa [← pow_succ']),
      MulChar.pow_apply_coe]
  have hprod := jacobiSum_powerResidueSymbol_mul_jacobiSum_inv hP le_rfl
  rw [hχ, jacobiSum_ringHomComp, RingEquiv.coe_toRingHom] at hprod
  -- Taking norms, `N(J) ^ 2 = N(N P) = (N P) ^ 2`.
  have hσN := Algebra.norm_eq_of_algEquiv σ.toIntAlgEquiv
    (jacobiSum (powerResidueSymbol P 3) (powerResidueSymbol P 3))
  rw [RingEquiv.coe_toIntAlgEquiv] at hσN
  have hnorm := congrArg (Algebra.norm ℤ) hprod
  rw [map_mul, hσN, ← map_natCast (algebraMap ℤ (𝓞 K)), Algebra.norm_algebraMap,
    TauCeti.finrank_ringOfIntegers_three] at hnorm
  rw [absNorm_span_singleton, ← Int.natAbs_natCast (absNorm P)]
  exact Int.natAbs_eq_natAbs_iff.mpr (mul_self_eq_mul_self_iff.mp (by rw [hnorm, sq]))

/-- **The cubic Jacobi sum generates the prime.** If `K = ℚ(ζ₃)`, `P` is a prime of `𝓞 K` whose
norm is prime to `3`, and `χ = (· / P)_3`, then `J(χ, χ)` generates `P`. -/
theorem span_singleton_jacobiSum_powerResidueSymbol_three (hP : (absNorm P).Coprime 3) :
    span {jacobiSum (powerResidueSymbol P 3) (powerResidueSymbol P 3)} = P := by
  have hle : span {jacobiSum (powerResidueSymbol P 3) (powerResidueSymbol P 3)} ≤ P := by
    rw [span_singleton_le_iff_mem]
    simpa only [pow_one] using
      jacobiSum_powerResidueSymbol_pow_mem hP one_ne_zero one_ne_zero (by norm_num)
  obtain ⟨M, hM⟩ := dvd_iff_le.mpr hle
  have hP0 : absNorm P ≠ 0 := fun h ↦ by simp [h] at hP
  have hN := absNorm_span_singleton_jacobiSum_powerResidueSymbol_three hP
  rw [hM, map_mul, Nat.mul_eq_left hP0, absNorm_eq_one_iff] at hN
  rw [hM, hN, mul_top]

/-- **The cubic Jacobi sum is the primary generator.** If `K = ℚ(ζ₃)`, `P = (π)` is a prime of
`𝓞 K` whose norm is prime to `3`, with `π` primary, and `χ = (· / P)_3`, then `J(χ, χ) = π`. -/
theorem jacobiSum_powerResidueSymbol_three_eq (hP : (absNorm P).Coprime 3) {π : 𝓞 K}
    (hπ : P = span {π}) (hπ' : TauCeti.IsPrimaryEisenstein π) :
    jacobiSum (powerResidueSymbol P 3) (powerResidueSymbol P 3) = π := by
  have hJ := (span_singleton_jacobiSum_powerResidueSymbol_three hP).trans hπ
  rw [span_singleton_eq_span_singleton] at hJ
  have hπ0 : π ≠ 0 := by
    rintro rfl
    rw [span_singleton_zero] at hπ
    simp [hπ] at hP
  have hprime : Prime π := by
    rw [← span_singleton_prime hπ0, ← hπ]
    infer_instance
  have hN : Algebra.norm ℤ π ≠ 3 := by
    intro h
    have h3 := absNorm_span_singleton π
    rw [← hπ, h] at h3
    rw [h3] at hP
    norm_num at hP
  exact (hprime.existsUnique_associated_isPrimaryEisenstein hN).unique
    ⟨hJ.symm, isPrimaryEisenstein_jacobiSum_powerResidueSymbol hP⟩ ⟨Associated.refl π, hπ'⟩

end Eisenstein

end Ideal
