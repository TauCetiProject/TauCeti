/-!
# The Stickelberger element, denominator ideal, and integral Stickelberger ideal

For a positive integer `m`, let `G_m = (ZMod m)ˣ` be the unit group modulo `m`, identified with
`Gal(ℚ(ζ_m) / ℚ)` via the cyclotomic character. The **rational Stickelberger element** is

  `θ_m = ∑ a : (ZMod m)ˣ, (a₀ / m) · [a⁻¹] ∈ ℚ[G_m]`,

where `a₀ = (a : ZMod m).val` is the least nonnegative representative of `a` modulo `m` (so
`1 ≤ a₀ < m` when `m ≥ 2`). Placing the inverse on the group-ring basis matches the covariant
Galois action on ideal classes so that evaluating `θ_m` at a nontrivial Dirichlet character `χ`
yields the first generalized Bernoulli number `B₁,χ⁻¹`.

Let `ι : ℤ[G_m] →+* ℚ[G_m]` be the coefficient-extension map `TauCeti.integralGroupRingCast m`.
The **Stickelberger denominator ideal** and the **integral Stickelberger ideal** are the ideals
of `ℤ[G_m]` defined by

  `J_m = {x ∈ ℤ[G_m] : ι(x) θ_m ∈ im ι}`,
  `I_m = {y ∈ ℤ[G_m] : ∃ x ∈ ℤ[G_m], ι(y) = ι(x) θ_m} = (ℤ[G_m] θ_m) ∩ ℤ[G_m]`.

Every multiplier `x = ∑ nₐ [a] ∈ ℤ[G_m]` belongs to `J_m` if and only if
`∑ nₐ a ≡ 0 (mod m)`. Equivalently, `J_m` is generated by `[b] - b` for positive integers `b`
coprime to `m` (including `b = 1 + m`, which yields `-m`). Multiplying `θ_m` by `b - [b]` gives
the **positive smoothed Stickelberger element**

  `s_{m, b} = ∑ a : (ZMod m)ˣ, ⌊b a₀ / m⌋ · [a⁻¹] ∈ I_m`,

whose nonnegative floor coefficients satisfy `s_{m, 1} = 0`, `s_{m, b + m} = s_{m, b} + m θ_m`,
and `s_{m, b d} = b s_{m, d} + [d] s_{m, b}` for `b, d` coprime to `m`, and which generate `I_m`.

## Main definitions

* `TauCeti.stickelberger`: the rational Stickelberger element `θ_m ∈ ℚ[(ZMod m)ˣ]`.
* `TauCeti.stickelbergerScaled`: the scaled integral element `m θ_m ∈ ℤ[(ZMod m)ˣ]`.
* `TauCeti.integralGroupRingCast`: the injective coefficient-extension ring homomorphism
  `ℤ[(ZMod m)ˣ] →+* ℚ[(ZMod m)ˣ]`.
* `TauCeti.stickelbergerDenominatorIdeal`: the denominator ideal `J_m` of multipliers `x ∈ ℤ[G_m]`
  whose product with `θ_m` has integral coefficients.
* `TauCeti.stickelbergerIdeal`: the integral Stickelberger ideal `I_m = ℤ[G_m] θ_m ∩ ℤ[G_m]`.
* `TauCeti.stickelbergerMul`: the `ℤ[G_m]`-linear map `J_m →ₗ ℤ[G_m]` sending `x` to the unique
  integral element representing `x θ_m`, with range `I_m`.
* `TauCeti.stickelbergerSmoothing`: the positive smoothed element `s_{m, b} ∈ ℤ[G_m]` with floor
  coefficients `⌊b a₀ / m⌋`.

## Main results

* `TauCeti.coeff_stickelberger`: `(θ_m).coeff b = (b⁻¹)₀ / m`.
* `TauCeti.one_add_single_neg_one_mul_stickelberger`: `(1 + [-1]) θ_m = ∑ [a]` for `m ≥ 2`.
* `TauCeti.sum_coeff_stickelberger`: the augmentation `∑ (θ_m).coeff a = φ(m) / 2` for `m ≥ 2`.
* `TauCeti.lift_stickelberger_dirichletCharacter`: evaluating `θ_m` at a nontrivial Dirichlet
  character `χ` gives `B₁,χ⁻¹`.
* `TauCeti.mem_stickelbergerDenominatorIdeal_iff_sum_eq_zero`:
  `x ∈ J_m ↔ ∑ (x.coeff a : ZMod m) * a = 0`.
* `TauCeti.stickelbergerDenominatorIdeal_eq_span`: `J_m` is generated by `[b] - b` for `0 < b`
  coprime to `m`.
* `TauCeti.integralGroupRingCast_stickelbergerSmoothing`: `ι(s_{m, b}) = (b - [b]) θ_m` for
  `b.Coprime m`.
* `TauCeti.stickelbergerIdeal_eq_span_stickelbergerSmoothing`: `I_m` is generated by the
  elements `s_{m, b}` for `0 < b` coprime to `m`.
* `TauCeti.stickelbergerIdeal_two` and `TauCeti.stickelbergerIdeal_three`: `I_2 = ⊤` and
  `I_3 = ⊤`.

## References

* R. Sharifi, *Iwasawa Theory* (lecture notes), §4.5 (Definition 4.5.1, Lemma 4.5.2,
  Theorem 4.5.7).
* L. C. Washington, *Introduction to Cyclotomic Fields*, 2nd ed., §6.2.
-/

public section

namespace TauCeti

/-! ### The rational Stickelberger element and coefficient extension -/

/-- The rational Stickelberger element `θ_m = ∑ a : (ZMod m)ˣ, (a₀ / m) [a⁻¹]`, with the
inverse on the group-ring basis matching the covariant Galois action on ideal classes. -/
noncomputable def stickelberger (m : ℕ) [NeZero m] : MonoidAlgebra ℚ (ZMod m)ˣ :=
  ∑ a : (ZMod m)ˣ, MonoidAlgebra.single a⁻¹ ((a.val.val : ℚ) / m)

/-- The defining finite-sum formula for `TauCeti.stickelberger`. -/
theorem stickelberger_def (m : ℕ) [NeZero m] :
    stickelberger m = ∑ a : (ZMod m)ˣ, MonoidAlgebra.single a⁻¹ ((a.val.val : ℚ) / m) := by
  rw [stickelberger]

/-- The scaled integral Stickelberger element `m θ_m = ∑ a : (ZMod m)ˣ, a₀ [a⁻¹]` in
`ℤ[(ZMod m)ˣ]`. -/
noncomputable def stickelbergerScaled (m : ℕ) [NeZero m] : MonoidAlgebra ℤ (ZMod m)ˣ :=
  ∑ a : (ZMod m)ˣ, MonoidAlgebra.single a⁻¹ (a.val.val : ℤ)

/-- The defining finite-sum formula for `TauCeti.stickelbergerScaled`. -/
theorem stickelbergerScaled_def (m : ℕ) [NeZero m] :
    stickelbergerScaled m = ∑ a : (ZMod m)ˣ, MonoidAlgebra.single a⁻¹ (a.val.val : ℤ) := by
  rw [stickelbergerScaled]

/-- The coefficient-extension ring homomorphism `ℤ[(ZMod m)ˣ] →+* ℚ[(ZMod m)ˣ]`. -/
noncomputable def integralGroupRingCast (m : ℕ) :
    MonoidAlgebra ℤ (ZMod m)ˣ →+* MonoidAlgebra ℚ (ZMod m)ˣ :=
  MonoidAlgebra.mapRingHom (ZMod m)ˣ (Int.castRingHom ℚ)

/-- Characterization of `TauCeti.integralGroupRingCast` as `MonoidAlgebra.mapRingHom`. -/
theorem integralGroupRingCast_def (m : ℕ) :
    integralGroupRingCast m = MonoidAlgebra.mapRingHom (ZMod m)ˣ (Int.castRingHom ℚ) := by
  rw [integralGroupRingCast]

/-- `integralGroupRingCast` acts coefficientwise by the integer-to-rational cast. -/
@[simp]
theorem coeff_integralGroupRingCast (m : ℕ) (x : MonoidAlgebra ℤ (ZMod m)ˣ) (a : (ZMod m)ˣ) :
    (integralGroupRingCast m x).coeff a = (x.coeff a : ℚ) := by
  rw [integralGroupRingCast_def, MonoidAlgebra.coeff_mapRingHom, Int.coe_castRingHom]

/-- `integralGroupRingCast` preserves basis indices and casts scalar coefficients. -/
@[simp]
theorem integralGroupRingCast_single (m : ℕ) (a : (ZMod m)ˣ) (r : ℤ) :
    integralGroupRingCast m (MonoidAlgebra.single a r) = MonoidAlgebra.single a (r : ℚ) := by
  rw [integralGroupRingCast_def, MonoidAlgebra.mapRingHom_single, Int.coe_castRingHom]

/-- Coefficient extension from `ℤ[(ZMod m)ˣ]` to `ℚ[(ZMod m)ˣ]` is injective. -/
theorem integralGroupRingCast_injective (m : ℕ) :
    Function.Injective (integralGroupRingCast m) := by
  rw [integralGroupRingCast_def, MonoidAlgebra.coe_mapRingHom]
  exact MonoidAlgebra.map_injective _ Int.cast_injective

/-- The coefficient of `stickelberger m` at `b` is `(b⁻¹)₀ / m`. -/
@[simp]
theorem coeff_stickelberger (m : ℕ) [NeZero m] (b : (ZMod m)ˣ) :
    (stickelberger m).coeff b = (((b⁻¹ : (ZMod m)ˣ).val.val : ℚ) / m) := by
  classical
  rw [stickelberger_def, MonoidAlgebra.coeff_sum, Finset.sum_apply']
  simp only [MonoidAlgebra.coeff_single, Finsupp.single_apply, inv_eq_iff_eq_inv]
  rw [Finset.sum_ite_eq' Finset.univ b⁻¹]
  simp

/-- The coefficient of `stickelbergerScaled m` at `b` is `(b⁻¹)₀`. -/
@[simp]
theorem coeff_stickelbergerScaled (m : ℕ) [NeZero m] (b : (ZMod m)ˣ) :
    (stickelbergerScaled m).coeff b = ((b⁻¹ : (ZMod m)ˣ).val.val : ℤ) := by
  classical
  rw [stickelbergerScaled_def, MonoidAlgebra.coeff_sum, Finset.sum_apply']
  simp only [MonoidAlgebra.coeff_single, Finsupp.single_apply, inv_eq_iff_eq_inv]
  rw [Finset.sum_ite_eq' Finset.univ b⁻¹]
  simp

/-- At conductor `1`, the rational Stickelberger element vanishes. -/
@[simp]
theorem stickelberger_one : stickelberger 1 = 0 := by
  refine MonoidAlgebra.ext (Finsupp.ext fun b ↦ ?_)
  simp [Subsingleton.elim (b⁻¹ : (ZMod 1)ˣ).val 0]

/-- At conductor `1`, the scaled integral Stickelberger element vanishes. -/
@[simp]
theorem stickelbergerScaled_one : stickelbergerScaled 1 = 0 := by
  refine MonoidAlgebra.ext (Finsupp.ext fun b ↦ ?_)
  simp [Subsingleton.elim (b⁻¹ : (ZMod 1)ˣ).val 0]

/-- Clearing the denominator: `ι(m θ_m) = m · θ_m` in `ℚ[(ZMod m)ˣ]`. -/
theorem integralGroupRingCast_stickelbergerScaled (m : ℕ) [NeZero m] :
    integralGroupRingCast m (stickelbergerScaled m) =
      (m : MonoidAlgebra ℚ (ZMod m)ˣ) * stickelberger m := by
  refine MonoidAlgebra.ext (Finsupp.ext fun b ↦ ?_)
  rw [coeff_integralGroupRingCast, coeff_stickelbergerScaled, MonoidAlgebra.natCast_def,
    MonoidAlgebra.coeff_single_mul_apply, inv_one, one_mul, coeff_stickelberger, Int.cast_natCast,
    mul_div_cancel₀ _ (Nat.cast_ne_zero.mpr (NeZero.ne m))]

/-- Scalar form of clearing the denominator: `m • θ_m = ι(m θ_m)`. -/
theorem smul_stickelberger (m : ℕ) [NeZero m] :
    (m : ℚ) • stickelberger m = integralGroupRingCast m (stickelbergerScaled m) := by
  refine MonoidAlgebra.ext (Finsupp.ext fun b ↦ ?_)
  rw [integralGroupRingCast_stickelbergerScaled, MonoidAlgebra.coeff_smul_apply, smul_eq_mul,
    MonoidAlgebra.natCast_def, MonoidAlgebra.coeff_single_mul_apply, inv_one, one_mul]

/-- **Conjugation formula for the Stickelberger element.** For every `m ≥ 2` (including `m = 2`),
`(1 + [-1]) θ_m = ∑ a : (ZMod m)ˣ, [a]`. -/
theorem one_add_single_neg_one_mul_stickelberger {m : ℕ} [NeZero m] (hm : 2 ≤ m) :
    (1 + MonoidAlgebra.single (-1 : (ZMod m)ˣ) 1) * stickelberger m =
      ∑ a : (ZMod m)ˣ, MonoidAlgebra.single a (1 : ℚ) := by
  classical
  have : Nontrivial (ZMod m) := (ZMod.nontrivial_iff).mpr (by omega)
  have hm0 : (m : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne m)
  refine MonoidAlgebra.ext (Finsupp.ext fun b ↦ ?_)
  rw [add_mul, one_mul, MonoidAlgebra.coeff_add, Finsupp.add_apply,
    MonoidAlgebra.coeff_single_mul_apply, one_mul, inv_neg, inv_one, neg_one_mul,
    coeff_stickelberger, coeff_stickelberger, inv_neg]
  have hu : ((b⁻¹ : (ZMod m)ˣ) : ZMod m) ≠ 0 := Units.ne_zero _
  have hlt : ((b⁻¹ : (ZMod m)ˣ) : ZMod m).val ≤ m := (ZMod.val_lt _).le
  have hneg : ((-b⁻¹ : (ZMod m)ˣ) : ZMod m).val = m - ((b⁻¹ : (ZMod m)ˣ) : ZMod m).val := by
    simp [Units.val_neg, ZMod.neg_val, hu]
  rw [hneg, Nat.cast_sub hlt, ← add_div, add_sub_cancel, div_self hm0,
    MonoidAlgebra.coeff_sum, Finset.sum_apply']
  simp

/-- **Augmentation of the Stickelberger element.** For every `m ≥ 2`, the sum of the coefficients
of `θ_m` is `φ(m) / 2`. -/
theorem sum_coeff_stickelberger {m : ℕ} [NeZero m] (hm : 2 ≤ m) :
    ∑ a : (ZMod m)ˣ, (stickelberger m).coeff a = (Nat.totient m : ℚ) / 2 := by
  have hpair (a : (ZMod m)ˣ) :
      (stickelberger m).coeff a + (stickelberger m).coeff (-a) = 1 := by
    have h := congrArg (fun f : MonoidAlgebra ℚ (ZMod m)ˣ ↦ f.coeff a)
      (one_add_single_neg_one_mul_stickelberger hm)
    classical
    simp only [add_mul, one_mul, MonoidAlgebra.coeff_add, Finsupp.add_apply,
      MonoidAlgebra.coeff_single_mul_apply, inv_neg, inv_one, neg_one_mul,
      MonoidAlgebra.coeff_sum, Finset.sum_apply', MonoidAlgebra.coeff_single,
      Finsupp.single_apply, Finset.sum_ite_eq' Finset.univ a, Finset.mem_univ, ↓reduceIte] at h
    exact h
  have hdouble : 2 * ∑ a : (ZMod m)ˣ, (stickelberger m).coeff a = (Nat.totient m : ℚ) := by
    have hneg : ∑ a : (ZMod m)ˣ, (stickelberger m).coeff (-a) =
        ∑ a : (ZMod m)ˣ, (stickelberger m).coeff a :=
      Fintype.sum_equiv (Equiv.neg (ZMod m)ˣ) _ _ fun _ ↦ rfl
    calc
      2 * ∑ a : (ZMod m)ˣ, (stickelberger m).coeff a
          = (∑ a : (ZMod m)ˣ, (stickelberger m).coeff a) +
              ∑ a : (ZMod m)ˣ, (stickelberger m).coeff (-a) := by rw [two_mul, hneg]
      _ = ∑ a : (ZMod m)ˣ, ((stickelberger m).coeff a + (stickelberger m).coeff (-a)) := by
          rw [Finset.sum_add_distrib]
      _ = ∑ _a : (ZMod m)ˣ, (1 : ℚ) := Finset.sum_congr rfl fun a _ ↦ hpair a
      _ = (Nat.totient m : ℚ) := by
          rw [Finset.sum_const, Finset.card_univ, ZMod.card_units_eq_totient, nsmul_eq_mul,
            mul_one]
  linarith

/-- **Character evaluation of the Stickelberger element (sum form).** Evaluating `θ_m` at a
nontrivial Dirichlet character `χ` over a commutative `ℚ`-algebra domain gives the first
generalized Bernoulli number `B₁,χ⁻¹`. -/
theorem sum_coeff_stickelberger_mul_dirichletCharacter {m : ℕ} [NeZero m]
    {R : Type*} [CommRing R] [IsDomain R] [Algebra ℚ R]
    {χ : DirichletCharacter R m} (hχ : χ ≠ 1) :
    ∑ a : (ZMod m)ˣ, algebraMap ℚ R ((stickelberger m).coeff a) * χ (a : ZMod m) =
      χ⁻¹.generalizedBernoulli 1 := by
  have hχinv : χ⁻¹ ≠ 1 := by simpa using hχ
  rw [DirichletCharacter.generalizedBernoulli_one_of_ne_one hχinv]
  -- Drop non-unit residues where `χ⁻¹` vanishes, then reindex `a ↦ a⁻¹`.
  have hunit : ∑ a : ZMod m, χ⁻¹ a * algebraMap ℚ R ((a.val : ℚ) / m) =
      ∑ a : (ZMod m)ˣ, χ⁻¹ (a : ZMod m) * algebraMap ℚ R ((a.val.val : ℚ) / m) := by
    classical
    rw [← Finset.sum_subset (s₁ := (Finset.univ : Finset (ZMod m)ˣ).image Units.val)
      (Finset.subset_univ _)]
    · rw [Finset.sum_image (fun _ _ _ _ h ↦ Units.ext h)]
    · intro x _ hx
      have hnu : ¬ IsUnit x := fun ⟨u, hu⟩ ↦ hx (Finset.mem_image.mpr ⟨u, Finset.mem_univ u, hu⟩)
      rw [MulChar.map_nonunit _ hnu, zero_mul]
  rw [hunit]
  refine Fintype.sum_equiv (Equiv.inv (ZMod m)ˣ) _ _ fun a ↦ ?_
  simp only [Equiv.inv_apply, coeff_stickelberger, mul_comm (algebraMap ℚ R _)]
  congr 1
  rw [MulChar.inv_apply, Ring.inverse_unit, inv_inv]

/-- **Character evaluation of the Stickelberger element (algebra-homomorphism form).** Lifting a
nontrivial Dirichlet character `χ` to `ℚ[(ZMod m)ˣ] →ₐ[ℚ] R` sends `θ_m` to `B₁,χ⁻¹`. -/
theorem lift_stickelberger_dirichletCharacter {m : ℕ} [NeZero m]
    {R : Type*} [CommRing R] [IsDomain R] [Algebra ℚ R]
    {χ : DirichletCharacter R m} (hχ : χ ≠ 1) :
    MonoidAlgebra.lift ℚ R (ZMod m)ˣ (χ.toMonoidHom.comp (Units.coeHom (ZMod m)))
      (stickelberger m) = χ⁻¹.generalizedBernoulli 1 := by
  rw [MonoidAlgebra.lift_apply', Finsupp.sum_fintype _ _ (fun _ ↦ by simp)]
  exact sum_coeff_stickelberger_mul_dirichletCharacter hχ

/-! ### The denominator ideal and the integral Stickelberger ideal -/

/-- Helper computing `((ι x) * θ_m).coeff c` directly as a rational sum divided by `m`. -/
theorem coeff_integralGroupRingCast_mul_stickelberger {m : ℕ} [NeZero m]
    (x : MonoidAlgebra ℤ (ZMod m)ˣ) (c : (ZMod m)ˣ) :
    (integralGroupRingCast m x * stickelberger m).coeff c =
      ((∑ a : (ZMod m)ˣ, x.coeff a * ((a * c⁻¹ : (ZMod m)ˣ).val.val : ℤ) : ℤ) : ℚ) / m := by
  rw [MonoidAlgebra.coeff_mul_apply_left, Finsupp.sum_fintype _ _ (fun _ ↦ by simp)]
  simp only [coeff_integralGroupRingCast, coeff_stickelberger, mul_inv_rev, inv_inv,
    mul_div_assoc', ← Finset.sum_div, Int.cast_sum, Int.cast_mul, Int.cast_natCast]
  congr 2
  ext a
  rw [mul_comm c⁻¹ a]

/-- The **Stickelberger denominator ideal** `J_m ⊆ ℤ[(ZMod m)ˣ]`, consisting of integral
multipliers `x` such that `ι(x) θ_m` has integral coefficients. -/
noncomputable def stickelbergerDenominatorIdeal (m : ℕ) [NeZero m] :
    Ideal (MonoidAlgebra ℤ (ZMod m)ˣ) where
  carrier := {x | ∃ y, integralGroupRingCast m y = integralGroupRingCast m x * stickelberger m}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro x₁ x₂ ⟨y₁, hy₁⟩ ⟨y₂, hy₂⟩
    exact ⟨y₁ + y₂, by simp only [map_add, hy₁, hy₂, add_mul]⟩
  smul_mem' := by
    rintro r x ⟨y, hy⟩
    exact ⟨r * y, by simp only [smul_eq_mul, map_mul, hy, mul_assoc]⟩

/-- Membership characterization of `TauCeti.stickelbergerDenominatorIdeal`. -/
@[simp]
theorem mem_stickelbergerDenominatorIdeal {m : ℕ} [NeZero m] {x : MonoidAlgebra ℤ (ZMod m)ˣ} :
    x ∈ stickelbergerDenominatorIdeal m ↔
      ∃ y, integralGroupRingCast m y = integralGroupRingCast m x * stickelberger m :=
  Iff.rfl

/-- At conductor `1`, every element lies in the denominator ideal. -/
@[simp]
theorem stickelbergerDenominatorIdeal_one : stickelbergerDenominatorIdeal 1 = ⊤ := by
  ext x
  simp only [mem_stickelbergerDenominatorIdeal, stickelberger_one, mul_zero, Submodule.mem_top,
    iff_true]
  exact ⟨0, map_zero _⟩

/-- An element `x ∈ ℤ[(ZMod m)ˣ]` lies in the denominator ideal `J_m` if and only if every
coefficient of `ι(x) θ_m` is an integer. -/
theorem mem_stickelbergerDenominatorIdeal_iff_forall_exists_int {m : ℕ} [NeZero m]
    {x : MonoidAlgebra ℤ (ZMod m)ˣ} :
    x ∈ stickelbergerDenominatorIdeal m ↔
      ∀ c : (ZMod m)ˣ, ∃ n : ℤ,
        (n : ℚ) = (integralGroupRingCast m x * stickelberger m).coeff c := by
  rw [mem_stickelbergerDenominatorIdeal, ← Set.mem_range, integralGroupRingCast_def,
    MonoidAlgebra.coe_mapRingHom, MonoidAlgebra.range_map]
  simp [Set.mem_range]

/-- **Congruence criterion for the denominator ideal.** An element `x = ∑ nₐ [a] ∈ ℤ[(ZMod m)ˣ]`
belongs to `J_m` if and only if `∑ nₐ a = 0` in `ZMod m`. -/
theorem mem_stickelbergerDenominatorIdeal_iff_sum_eq_zero {m : ℕ} [NeZero m]
    {x : MonoidAlgebra ℤ (ZMod m)ˣ} :
    x ∈ stickelbergerDenominatorIdeal m ↔
      ∑ a : (ZMod m)ˣ, (x.coeff a : ZMod m) * (a : ZMod m) = 0 := by
  have hm0 : (m : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne m)
  rw [mem_stickelbergerDenominatorIdeal_iff_forall_exists_int]
  have hcoeff (c : (ZMod m)ˣ) :
      (∃ n : ℤ, (n : ℚ) = (integralGroupRingCast m x * stickelberger m).coeff c) ↔
        ((c⁻¹ : (ZMod m)ˣ) : ZMod m) *
          ∑ a : (ZMod m)ˣ, (x.coeff a : ZMod m) * (a : ZMod m) = 0 := by
    rw [coeff_integralGroupRingCast_mul_stickelberger]
    set N : ℤ := ∑ a : (ZMod m)ˣ, x.coeff a * ((a * c⁻¹ : (ZMod m)ˣ).val.val : ℤ) with hN
    have hdiv : (∃ n : ℤ, (n : ℚ) = (N : ℚ) / m) ↔ (m : ℤ) ∣ N := by
      constructor
      · rintro ⟨n, hn⟩
        refine ⟨n, Int.cast_injective (α := ℚ) ?_⟩
        push_cast
        exact ((eq_div_iff hm0).mp hn).symm.trans (mul_comm _ _)
      · rintro ⟨n, hn⟩
        refine ⟨n, ?_⟩
        rw [hn]
        push_cast
        rw [mul_div_cancel_left₀ _ hm0]
    rw [hdiv, ← ZMod.intCast_zmod_eq_zero_iff_dvd]
    have hNmod : (N : ZMod m) =
        ((c⁻¹ : (ZMod m)ˣ) : ZMod m) *
          ∑ a : (ZMod m)ˣ, (x.coeff a : ZMod m) * (a : ZMod m) := by
      rw [hN, Finset.mul_sum]
      push_cast
      refine Finset.sum_congr rfl fun a _ ↦ ?_
      rw [ZMod.natCast_zmod_val]
      ring
    rw [hNmod]
  constructor
  · intro h
    have h1 := (hcoeff 1).mp (h 1)
    rwa [inv_one, Units.val_one, one_mul] at h1
  · intro h c
    exact (hcoeff c).mpr (by rw [h, mul_zero])

/-- Integer-divisibility form of the denominator congruence criterion: `x ∈ J_m` if and only if
`m ∣ ∑ a, x.coeff a * a₀` in `ℤ`. -/
theorem mem_stickelbergerDenominatorIdeal_iff_dvd {m : ℕ} [NeZero m]
    {x : MonoidAlgebra ℤ (ZMod m)ˣ} :
    x ∈ stickelbergerDenominatorIdeal m ↔
      (m : ℤ) ∣ ∑ a : (ZMod m)ˣ, x.coeff a * (a.val.val : ℤ) := by
  rw [mem_stickelbergerDenominatorIdeal_iff_sum_eq_zero, ← ZMod.intCast_zmod_eq_zero_iff_dvd]
  push_cast
  simp

/-- The integer `m` lies in the denominator ideal `J_m`. -/
theorem natCast_mem_stickelbergerDenominatorIdeal (m : ℕ) [NeZero m] :
    (m : MonoidAlgebra ℤ (ZMod m)ˣ) ∈ stickelbergerDenominatorIdeal m :=
  ⟨stickelbergerScaled m, by
    rw [integralGroupRingCast_stickelbergerScaled, map_natCast]⟩

/-- For every `b` coprime to `m`, `[b] - b` belongs to the denominator ideal `J_m`. -/
theorem single_sub_natCast_mem_stickelbergerDenominatorIdeal {m : ℕ} [NeZero m]
    {b : ℕ} (hb : b.Coprime m) :
    MonoidAlgebra.single (ZMod.unitOfCoprime b hb) (1 : ℤ) - (b : MonoidAlgebra ℤ (ZMod m)ˣ) ∈
      stickelbergerDenominatorIdeal m := by
  classical
  rw [mem_stickelbergerDenominatorIdeal_iff_sum_eq_zero]
  simp only [MonoidAlgebra.coeff_sub, Finsupp.sub_apply, MonoidAlgebra.natCast_def,
    MonoidAlgebra.coeff_single, Finsupp.single_apply, Int.cast_sub, sub_mul,
    Finset.sum_sub_distrib, apply_ite Int.cast, Int.cast_one, Int.cast_zero, Int.cast_natCast,
    ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte,
    ZMod.coe_unitOfCoprime, Units.val_one, mul_one, sub_self]

/-- For every `b` coprime to `m`, `b - [b]` belongs to the denominator ideal `J_m`. -/
theorem natCast_sub_single_mem_stickelbergerDenominatorIdeal {m : ℕ} [NeZero m]
    {b : ℕ} (hb : b.Coprime m) :
    (b : MonoidAlgebra ℤ (ZMod m)ˣ) - MonoidAlgebra.single (ZMod.unitOfCoprime b hb) (1 : ℤ) ∈
      stickelbergerDenominatorIdeal m := by
  rw [← neg_sub]
  exact Submodule.neg_mem _ (single_sub_natCast_mem_stickelbergerDenominatorIdeal hb)

/-- **Generators of the denominator ideal.** `J_m` is generated by the elements `[b] - b` for
positive integers `b` coprime to `m`. Taking `b = 1 + m` produces `-m`. -/
theorem stickelbergerDenominatorIdeal_eq_span (m : ℕ) [NeZero m] :
    stickelbergerDenominatorIdeal m =
      Ideal.span {z : MonoidAlgebra ℤ (ZMod m)ˣ |
        ∃ (b : ℕ) (hb : b.Coprime m), 0 < b ∧
          z = MonoidAlgebra.single (ZMod.unitOfCoprime b hb) (1 : ℤ) -
            (b : MonoidAlgebra ℤ (ZMod m)ˣ)} := by
  set S : Set (MonoidAlgebra ℤ (ZMod m)ˣ) :=
    {z | ∃ (b : ℕ) (hb : b.Coprime m), 0 < b ∧
      z = MonoidAlgebra.single (ZMod.unitOfCoprime b hb) (1 : ℤ) -
        (b : MonoidAlgebra ℤ (ZMod m)ˣ)}
  apply le_antisymm
  · -- First show `(m : ℤ[G_m]) ∈ span S` using `b = 1 + m`.
    have hm_pos : 0 < m := NeZero.pos m
    have h1m_cop : (1 + m).Coprime m := by simp
    have h1m_unit : ZMod.unitOfCoprime (1 + m) h1m_cop = 1 :=
      Units.ext (by simp [ZMod.coe_unitOfCoprime])
    have hm_mem : (m : MonoidAlgebra ℤ (ZMod m)ˣ) ∈ Ideal.span S := by
      have hgen : MonoidAlgebra.single (ZMod.unitOfCoprime (1 + m) h1m_cop) (1 : ℤ) -
          ((1 + m : ℕ) : MonoidAlgebra ℤ (ZMod m)ˣ) ∈ Ideal.span S :=
        Ideal.subset_span ⟨1 + m, h1m_cop, by omega, rfl⟩
      rw [h1m_unit, ← MonoidAlgebra.one_def, Nat.cast_add, Nat.cast_one,
        sub_add_eq_sub_sub, sub_self, zero_sub] at hgen
      exact neg_neg (m : MonoidAlgebra ℤ (ZMod m)ˣ) ▸ Submodule.neg_mem _ hgen
    -- Next show `[a] - a₀ ∈ span S` for every `a : (ZMod m)ˣ`, using `b = a₀ + m`.
    have ha_mem (a : (ZMod m)ˣ) :
        MonoidAlgebra.single a (1 : ℤ) - (a.val.val : MonoidAlgebra ℤ (ZMod m)ˣ) ∈
          Ideal.span S := by
      have hb_cop : (a.val.val + m).Coprime m := by
        rw [Nat.coprime_add_self_left]
        exact ZMod.val_coe_unit_coprime a
      have hb_unit : ZMod.unitOfCoprime (a.val.val + m) hb_cop = a :=
        Units.ext (by simp [ZMod.coe_unitOfCoprime])
      have hgen : MonoidAlgebra.single (ZMod.unitOfCoprime (a.val.val + m) hb_cop) (1 : ℤ) -
          ((a.val.val + m : ℕ) : MonoidAlgebra ℤ (ZMod m)ˣ) ∈ Ideal.span S :=
        Ideal.subset_span ⟨a.val.val + m, hb_cop, by omega, rfl⟩
      rw [hb_unit, Nat.cast_add] at hgen
      have hadd := Ideal.add_mem _ hgen hm_mem
      rwa [sub_add_eq_sub_sub, sub_add_cancel] at hadd
    -- Decompose any `x ∈ J_m` as `∑ xₐ ([a] - a₀) + k · m`.
    intro x hx
    obtain ⟨k, hk⟩ := mem_stickelbergerDenominatorIdeal_iff_dvd.mp hx
    have hdecomp : x =
        (∑ a : (ZMod m)ˣ,
          (x.coeff a : MonoidAlgebra ℤ (ZMod m)ˣ) *
            (MonoidAlgebra.single a (1 : ℤ) - (a.val.val : MonoidAlgebra ℤ (ZMod m)ˣ))) +
        ((k : MonoidAlgebra ℤ (ZMod m)ˣ) * (m : MonoidAlgebra ℤ (ZMod m)ˣ)) := by
      have hsum : x = ∑ a : (ZMod m)ˣ,
          (x.coeff a : MonoidAlgebra ℤ (ZMod m)ˣ) * MonoidAlgebra.single a (1 : ℤ) := by
        refine MonoidAlgebra.ext (Finsupp.ext fun c ↦ ?_)
        classical
        simp [MonoidAlgebra.intCast_def]
      have hkcast : ∑ a : (ZMod m)ˣ,
            (x.coeff a : MonoidAlgebra ℤ (ZMod m)ˣ) * (a.val.val : MonoidAlgebra ℤ (ZMod m)ˣ) =
          (k : MonoidAlgebra ℤ (ZMod m)ˣ) * (m : MonoidAlgebra ℤ (ZMod m)ˣ) := by
        have h := congrArg (Int.cast (R := MonoidAlgebra ℤ (ZMod m)ˣ)) hk
        simp only [Int.cast_sum, Int.cast_mul, Int.cast_natCast] at h
        rw [h, mul_comm]
      rw [← hkcast, ← Finset.sum_add_distrib]
      conv_lhs => rw [hsum]
      exact Finset.sum_congr rfl fun a _ ↦ by ring
    rw [hdecomp]
    refine Ideal.add_mem _ (Ideal.sum_mem _ fun a _ ↦ Ideal.mul_mem_left _ _ (ha_mem a))
      (Ideal.mul_mem_left _ _ hm_mem)
  · rw [Ideal.span_le]
    rintro z ⟨b, hb, -, rfl⟩
    exact single_sub_natCast_mem_stickelbergerDenominatorIdeal hb

/-- The **integral Stickelberger ideal** `I_m = ℤ[(ZMod m)ˣ] θ_m ∩ ℤ[(ZMod m)ˣ]` of integral
group-ring multiples of `θ_m` whose coefficients are integers. -/
noncomputable def stickelbergerIdeal (m : ℕ) [NeZero m] :
    Ideal (MonoidAlgebra ℤ (ZMod m)ˣ) where
  carrier := {y | ∃ x, integralGroupRingCast m y = integralGroupRingCast m x * stickelberger m}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro u v ⟨x, hx⟩ ⟨y, hy⟩
    exact ⟨x + y, by simp only [map_add, hx, hy, add_mul]⟩
  smul_mem' := by
    rintro r u ⟨x, hx⟩
    exact ⟨r * x, by simp only [smul_eq_mul, map_mul, hx, mul_assoc]⟩

/-- Membership characterization of `TauCeti.stickelbergerIdeal`. -/
@[simp]
theorem mem_stickelbergerIdeal {m : ℕ} [NeZero m] {y : MonoidAlgebra ℤ (ZMod m)ˣ} :
    y ∈ stickelbergerIdeal m ↔
      ∃ x, integralGroupRingCast m y = integralGroupRingCast m x * stickelberger m :=
  Iff.rfl

/-- At conductor `1`, the integral Stickelberger ideal is `⊥`. -/
@[simp]
theorem stickelbergerIdeal_one : stickelbergerIdeal 1 = ⊥ := by
  ext y
  simp only [mem_stickelbergerIdeal, stickelberger_one, mul_zero, Submodule.mem_bot]
  constructor
  · rintro ⟨-, hy⟩
    exact integralGroupRingCast_injective 1 (hy.trans (map_zero _).symm)
  · rintro rfl
    exact ⟨0, map_zero _⟩

/-- The scaled Stickelberger element `m θ_m` belongs to `stickelbergerIdeal m`. -/
theorem stickelbergerScaled_mem_stickelbergerIdeal (m : ℕ) [NeZero m] :
    stickelbergerScaled m ∈ stickelbergerIdeal m :=
  ⟨m, by rw [integralGroupRingCast_stickelbergerScaled, map_natCast]⟩

/-- The integral Stickelberger multiplication map `J_m →ₗ[ℤ[G_m]] ℤ[G_m]`, sending a denominator
multiplier `x ∈ J_m` to the unique integral element `y` satisfying `ι(y) = ι(x) θ_m`. -/
noncomputable def stickelbergerMul (m : ℕ) [NeZero m] :
    stickelbergerDenominatorIdeal m →ₗ[MonoidAlgebra ℤ (ZMod m)ˣ] MonoidAlgebra ℤ (ZMod m)ˣ where
  toFun x := Classical.choose (mem_stickelbergerDenominatorIdeal.mp x.property)
  map_add' x₁ x₂ := integralGroupRingCast_injective m <| by
    rw [map_add, Classical.choose_spec (mem_stickelbergerDenominatorIdeal.mp (x₁ + x₂).property),
      Classical.choose_spec (mem_stickelbergerDenominatorIdeal.mp x₁.property),
      Classical.choose_spec (mem_stickelbergerDenominatorIdeal.mp x₂.property)]
    simp [add_mul]
  map_smul' r x := integralGroupRingCast_injective m <| by
    simp only [smul_eq_mul, RingHom.id_apply, map_mul,
      Classical.choose_spec (mem_stickelbergerDenominatorIdeal.mp (r • x).property),
      Classical.choose_spec (mem_stickelbergerDenominatorIdeal.mp x.property)]
    rw [Submodule.coe_smul_of_tower, smul_eq_mul, map_mul, mul_assoc]

/-- `stickelbergerMul` represents multiplication by `θ_m` after extending scalars to `ℚ`. -/
@[simp]
theorem integralGroupRingCast_stickelbergerMul {m : ℕ} [NeZero m]
    (x : stickelbergerDenominatorIdeal m) :
    integralGroupRingCast m (stickelbergerMul m x) =
      integralGroupRingCast m x * stickelberger m :=
  Classical.choose_spec (mem_stickelbergerDenominatorIdeal.mp x.property)

/-- Uniqueness characterization of `TauCeti.stickelbergerMul`. -/
theorem stickelbergerMul_eq_iff {m : ℕ} [NeZero m]
    {x : stickelbergerDenominatorIdeal m} {y : MonoidAlgebra ℤ (ZMod m)ˣ} :
    stickelbergerMul m x = y ↔
      integralGroupRingCast m y = integralGroupRingCast m x * stickelberger m := by
  constructor
  · rintro rfl
    exact integralGroupRingCast_stickelbergerMul x
  · intro hy
    exact integralGroupRingCast_injective m
      ((integralGroupRingCast_stickelbergerMul x).trans hy.symm)

/-- Every value of `stickelbergerMul` lies in `stickelbergerIdeal m`. -/
theorem stickelbergerMul_mem_stickelbergerIdeal {m : ℕ} [NeZero m]
    (x : stickelbergerDenominatorIdeal m) :
    stickelbergerMul m x ∈ stickelbergerIdeal m :=
  ⟨x, integralGroupRingCast_stickelbergerMul x⟩

/-- The range of `stickelbergerMul m` is precisely `stickelbergerIdeal m`. -/
@[simp]
theorem range_stickelbergerMul (m : ℕ) [NeZero m] :
    LinearMap.range (stickelbergerMul m) = stickelbergerIdeal m := by
  ext y
  simp only [LinearMap.mem_range, mem_stickelbergerIdeal]
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨x, integralGroupRingCast_stickelbergerMul x⟩
  · rintro ⟨x, hx⟩
    exact ⟨⟨x, ⟨y, hx⟩⟩, stickelbergerMul_eq_iff.mpr hx⟩

/-- Integral coefficient formula linking a denominator multiplier `x` and `y = x θ_m`:
`m * y.coeff c = ∑ a, x.coeff a * (a c⁻¹)₀`. -/
theorem natCast_mul_coeff_of_integralGroupRingCast_eq {m : ℕ} [NeZero m]
    {x y : MonoidAlgebra ℤ (ZMod m)ˣ}
    (hxy : integralGroupRingCast m y = integralGroupRingCast m x * stickelberger m)
    (c : (ZMod m)ˣ) :
    (m : ℤ) * y.coeff c =
      ∑ a : (ZMod m)ˣ, x.coeff a * ((a * c⁻¹ : (ZMod m)ˣ).val.val : ℤ) := by
  have h := congrArg (fun f : MonoidAlgebra ℚ (ZMod m)ˣ ↦ f.coeff c) hxy
  rw [coeff_integralGroupRingCast, coeff_integralGroupRingCast_mul_stickelberger] at h
  have hm0 : (m : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne m)
  refine Int.cast_injective (α := ℚ) ?_
  rw [Int.cast_mul, Int.cast_natCast, mul_comm]
  exact (eq_div_iff hm0).mp h

/-! ### Positive smoothing and floor coefficients -/

/-- The **positive smoothed Stickelberger element** `s_{m, b} = ∑ a, ⌊b a₀ / m⌋ [a⁻¹]` in
`ℤ[(ZMod m)ˣ]`. For `b` coprime to `m`, it represents `(b - [b]) θ_m` in `stickelbergerIdeal m`. -/
noncomputable def stickelbergerSmoothing (m : ℕ) [NeZero m] (b : ℕ) :
    MonoidAlgebra ℤ (ZMod m)ˣ :=
  ∑ a : (ZMod m)ˣ, MonoidAlgebra.single a⁻¹ (((b * a.val.val) / m : ℕ) : ℤ)

/-- The defining finite-sum formula for `TauCeti.stickelbergerSmoothing`. -/
theorem stickelbergerSmoothing_def (m : ℕ) [NeZero m] (b : ℕ) :
    stickelbergerSmoothing m b =
      ∑ a : (ZMod m)ˣ, MonoidAlgebra.single a⁻¹ (((b * a.val.val) / m : ℕ) : ℤ) := by
  rw [stickelbergerSmoothing]

/-- The coefficient of `stickelbergerSmoothing m b` at `a` is `⌊b (a⁻¹)₀ / m⌋`. -/
@[simp]
theorem coeff_stickelbergerSmoothing (m : ℕ) [NeZero m] (b : ℕ) (a : (ZMod m)ˣ) :
    (stickelbergerSmoothing m b).coeff a = (((b * (a⁻¹ : (ZMod m)ˣ).val.val) / m : ℕ) : ℤ) := by
  classical
  rw [stickelbergerSmoothing_def, MonoidAlgebra.coeff_sum, Finset.sum_apply']
  simp only [MonoidAlgebra.coeff_single, Finsupp.single_apply, inv_eq_iff_eq_inv]
  rw [Finset.sum_ite_eq' Finset.univ a⁻¹]
  simp

/-- **Rational smoothing identity.** For every `b` coprime to `m`,
`ι(s_{m, b}) = (b - [b]) θ_m` in `ℚ[(ZMod m)ˣ]`. -/
theorem integralGroupRingCast_stickelbergerSmoothing {m : ℕ} [NeZero m]
    {b : ℕ} (hb : b.Coprime m) :
    integralGroupRingCast m (stickelbergerSmoothing m b) =
      ((b : MonoidAlgebra ℚ (ZMod m)ˣ) -
        MonoidAlgebra.single (ZMod.unitOfCoprime b hb) (1 : ℚ)) * stickelberger m := by
  have hm0 : (m : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne m)
  refine MonoidAlgebra.ext (Finsupp.ext fun c ↦ ?_)
  rw [coeff_integralGroupRingCast, coeff_stickelbergerSmoothing, sub_mul, MonoidAlgebra.coeff_sub,
    Finsupp.sub_apply, MonoidAlgebra.natCast_def, MonoidAlgebra.coeff_single_mul_apply, inv_one,
    one_mul, MonoidAlgebra.coeff_single_mul_apply, one_mul, coeff_stickelberger,
    coeff_stickelberger]
  have hval : (((ZMod.unitOfCoprime b hb)⁻¹ * c)⁻¹ : (ZMod m)ˣ).val.val =
      (b * (c⁻¹ : (ZMod m)ˣ).val.val) % m := by
    rw [mul_inv_rev, inv_inv, mul_comm c⁻¹ _, ← ZMod.val_natCast]
    congr 1
    rw [Units.val_mul, ZMod.coe_unitOfCoprime, Nat.cast_mul, ZMod.natCast_zmod_val]
  rw [hval, Int.cast_natCast, mul_div_assoc', ← sub_div, eq_div_iff hm0]
  have hdm := Nat.div_add_mod (b * (c⁻¹ : (ZMod m)ˣ).val.val) m
  have hdmq : ((b * (c⁻¹ : (ZMod m)ˣ).val.val / m : ℕ) : ℚ) * m +
      ((b * (c⁻¹ : (ZMod m)ˣ).val.val % m : ℕ) : ℚ) =
      (b : ℚ) * ((c⁻¹ : (ZMod m)ˣ).val.val : ℚ) := by
    have hq := congrArg (Nat.cast (R := ℚ)) hdm
    push_cast at hq
    linarith
  linarith

/-- For every `b` coprime to `m`, the positive smoothing `s_{m, b}` belongs to
`stickelbergerIdeal m`. -/
theorem stickelbergerSmoothing_mem_stickelbergerIdeal {m : ℕ} [NeZero m]
    {b : ℕ} (hb : b.Coprime m) :
    stickelbergerSmoothing m b ∈ stickelbergerIdeal m :=
  ⟨(b : MonoidAlgebra ℤ (ZMod m)ˣ) - MonoidAlgebra.single (ZMod.unitOfCoprime b hb) (1 : ℤ), by
    rw [integralGroupRingCast_stickelbergerSmoothing hb, map_sub, map_natCast,
      integralGroupRingCast_single, Int.cast_one]⟩

/-- `stickelbergerMul` sends `b - [b]` to the positive smoothing `s_{m, b}`. -/
theorem stickelbergerMul_natCast_sub_single {m : ℕ} [NeZero m] {b : ℕ} (hb : b.Coprime m) :
    stickelbergerMul m
        ⟨(b : MonoidAlgebra ℤ (ZMod m)ˣ) - MonoidAlgebra.single (ZMod.unitOfCoprime b hb) (1 : ℤ),
          natCast_sub_single_mem_stickelbergerDenominatorIdeal hb⟩ =
      stickelbergerSmoothing m b := by
  rw [stickelbergerMul_eq_iff, integralGroupRingCast_stickelbergerSmoothing hb, map_sub,
    map_natCast, integralGroupRingCast_single, Int.cast_one]

/-- At `b = 0`, the positive smoothing vanishes. -/
@[simp]
theorem stickelbergerSmoothing_zero (m : ℕ) [NeZero m] :
    stickelbergerSmoothing m 0 = 0 := by
  refine MonoidAlgebra.ext (Finsupp.ext fun a ↦ ?_)
  simp

/-- At `b = 1`, the positive smoothing vanishes because every representative satisfies `a₀ < m`. -/
@[simp]
theorem stickelbergerSmoothing_one (m : ℕ) [NeZero m] :
    stickelbergerSmoothing m 1 = 0 := by
  refine MonoidAlgebra.ext (Finsupp.ext fun a ↦ ?_)
  simp [Nat.div_eq_of_lt (ZMod.val_lt _)]

/-- Shifting `b` by `m` adds the scaled Stickelberger element `m θ_m`. -/
theorem stickelbergerSmoothing_add_self (m : ℕ) [NeZero m] (b : ℕ) :
    stickelbergerSmoothing m (b + m) = stickelbergerSmoothing m b + stickelbergerScaled m := by
  refine MonoidAlgebra.ext (Finsupp.ext fun a ↦ ?_)
  rw [MonoidAlgebra.coeff_add, Finsupp.add_apply, coeff_stickelbergerSmoothing,
    coeff_stickelbergerSmoothing, coeff_stickelbergerScaled, add_mul, mul_comm m _,
    Nat.add_mul_div_right _ _ (NeZero.pos m), Nat.cast_add]

/-- **Product law for positive smoothing.** For `b` and `d` coprime to `m`,
`s_{m, b d} = b s_{m, d} + [d] s_{m, b}`. -/
theorem stickelbergerSmoothing_mul {m : ℕ} [NeZero m] {b d : ℕ}
    (hb : b.Coprime m) (hd : d.Coprime m) :
    stickelbergerSmoothing m (b * d) =
      (b : MonoidAlgebra ℤ (ZMod m)ˣ) * stickelbergerSmoothing m d +
        MonoidAlgebra.single (ZMod.unitOfCoprime d hd) (1 : ℤ) * stickelbergerSmoothing m b := by
  apply integralGroupRingCast_injective m
  have hbd : (b * d).Coprime m := hb.mul_left hd
  have hunit : ZMod.unitOfCoprime (b * d) hbd =
      ZMod.unitOfCoprime b hb * ZMod.unitOfCoprime d hd := by
    apply Units.ext
    simp [ZMod.coe_unitOfCoprime]
  have hsingle : MonoidAlgebra.single (ZMod.unitOfCoprime (b * d) hbd) (1 : ℚ) =
      MonoidAlgebra.single (ZMod.unitOfCoprime d hd) (1 : ℚ) *
        MonoidAlgebra.single (ZMod.unitOfCoprime b hb) (1 : ℚ) := by
    rw [MonoidAlgebra.single_mul_single, one_mul, hunit, mul_comm]
  rw [integralGroupRingCast_stickelbergerSmoothing hbd, map_add, map_mul, map_mul, map_natCast,
    integralGroupRingCast_single, Int.cast_one, integralGroupRingCast_stickelbergerSmoothing hd,
    integralGroupRingCast_stickelbergerSmoothing hb, hsingle, Nat.cast_mul]
  ring

/-- **Generators of the integral Stickelberger ideal.** `I_m` is generated by the positive
smoothed elements `s_{m, b}` for positive integers `b` coprime to `m`. -/
theorem stickelbergerIdeal_eq_span_stickelbergerSmoothing (m : ℕ) [NeZero m] :
    stickelbergerIdeal m =
      Ideal.span {z : MonoidAlgebra ℤ (ZMod m)ˣ |
        ∃ b : ℕ, 0 < b ∧ b.Coprime m ∧ z = stickelbergerSmoothing m b} := by
  set T : Set (MonoidAlgebra ℤ (ZMod m)ˣ) :=
    {z | ∃ b : ℕ, 0 < b ∧ b.Coprime m ∧ z = stickelbergerSmoothing m b}
  apply le_antisymm
  · intro y hy
    obtain ⟨x, hx⟩ := mem_stickelbergerIdeal.mp hy
    have hxJ : x ∈ stickelbergerDenominatorIdeal m := ⟨y, hx⟩
    rw [stickelbergerDenominatorIdeal_eq_span] at hxJ
    have hmul : ∃ y' ∈ Ideal.span T,
        integralGroupRingCast m y' = integralGroupRingCast m x * stickelberger m := by
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hxJ
      · rintro _ ⟨b, hb, hb0, rfl⟩
        refine ⟨-stickelbergerSmoothing m b,
          Submodule.neg_mem _ (Ideal.subset_span ⟨b, hb0, hb, rfl⟩), ?_⟩
        rw [map_neg, integralGroupRingCast_stickelbergerSmoothing hb, map_sub, map_natCast,
          integralGroupRingCast_single, Int.cast_one]
        ring
      · exact ⟨0, Ideal.zero_mem _, by simp⟩
      · rintro u v - - ⟨y₁, hy₁, h₁⟩ ⟨y₂, hy₂, h₂⟩
        exact ⟨y₁ + y₂, Ideal.add_mem _ hy₁ hy₂, by simp only [map_add, h₁, h₂, add_mul]⟩
      · rintro r u - ⟨y₁, hy₁, h₁⟩
        exact ⟨r * y₁, Ideal.mul_mem_left _ r hy₁, by
          simp only [smul_eq_mul, map_mul, h₁, mul_assoc]⟩
    obtain ⟨y', hy'T, hy'eq⟩ := hmul
    rwa [integralGroupRingCast_injective m (hx.trans hy'eq.symm)]
  · rw [Ideal.span_le]
    rintro z ⟨b, -, hb, rfl⟩
    exact stickelbergerSmoothing_mem_stickelbergerIdeal hb

/-! ### Small conductors `m = 2` and `m = 3` -/

/-- At conductor `2`, `1 ∈ I_2` (witnessed by `2 · θ_2 = 1`). -/
theorem one_mem_stickelbergerIdeal_two :
    (1 : MonoidAlgebra ℤ (ZMod 2)ˣ) ∈ stickelbergerIdeal 2 := by
  refine ⟨2, MonoidAlgebra.ext (Finsupp.ext fun b ↦ ?_)⟩
  have hb : b = 1 := Subsingleton.elim b 1
  subst hb
  simp only [map_one, MonoidAlgebra.coeff_one_one, MonoidAlgebra.ofNat_def,
    integralGroupRingCast_single, Int.cast_ofNat, MonoidAlgebra.coeff_single_mul_apply, inv_one,
    one_mul, coeff_stickelberger, Units.val_one, ZMod.val_one]
  norm_num

/-- At conductor `2`, the integral Stickelberger ideal is the whole group ring. -/
@[simp]
theorem stickelbergerIdeal_two : stickelbergerIdeal 2 = ⊤ :=
  Ideal.eq_top_of_isUnit_mem _ one_mem_stickelbergerIdeal_two isUnit_one

/-- At conductor `3`, `1 ∈ I_3` (witnessed by `(2 [-1] - 1) θ_3 = 1`). -/
theorem one_mem_stickelbergerIdeal_three :
    (1 : MonoidAlgebra ℤ (ZMod 3)ˣ) ∈ stickelbergerIdeal 3 := by
  refine ⟨2 * MonoidAlgebra.single (-1 : (ZMod 3)ˣ) (1 : ℤ) - 1,
    MonoidAlgebra.ext (Finsupp.ext fun b ↦ ?_)⟩
  have hb : b = 1 ∨ b = -1 := by
    fin_cases b
    · left; decide
    · right; decide
  have hne : (-1 : (ZMod 3)ˣ) ≠ 1 := by decide
  have h2 : ((-1 : ZMod 3).val : ℚ) = 2 := by decide
  rcases hb with rfl | rfl
  · simp only [map_one, map_sub, map_mul, integralGroupRingCast_single, Int.cast_one,
      MonoidAlgebra.coeff_one_one, MonoidAlgebra.ofNat_def, sub_mul, one_mul, mul_assoc,
      MonoidAlgebra.coeff_sub, Finsupp.sub_apply, MonoidAlgebra.coeff_single_mul_apply,
      inv_one, inv_neg, neg_one_mul, coeff_stickelberger, Units.val_neg, Units.val_one,
      ZMod.val_one, h2]
    norm_num
  · simp only [map_sub, map_mul, integralGroupRingCast_single, Int.cast_one,
      MonoidAlgebra.one_def, MonoidAlgebra.coeff_single, Finsupp.single_apply,
      hne.symm, ↓reduceIte, MonoidAlgebra.ofNat_def, sub_mul, one_mul, mul_assoc,
      MonoidAlgebra.coeff_sub, Finsupp.sub_apply, MonoidAlgebra.coeff_single_mul_apply,
      inv_one, inv_neg, neg_one_mul, neg_neg, coeff_stickelberger, Units.val_neg, Units.val_one,
      ZMod.val_one, h2]
    norm_num

/-- At conductor `3`, the integral Stickelberger ideal is the whole group ring. -/
@[simp]
theorem stickelbergerIdeal_three : stickelbergerIdeal 3 = ⊤ :=
  Ideal.eq_top_of_isUnit_mem _ one_mem_stickelbergerIdeal_three isUnit_one

private theorem unitOfCoprime_three_inv_five :
    (ZMod.unitOfCoprime 3 (by decide) : (ZMod 5)ˣ)⁻¹ = ZMod.unitOfCoprime 2 (by decide) :=
  inv_eq_of_mul_eq_one_right (Units.ext (by
    rw [Units.val_mul, ZMod.coe_unitOfCoprime, ZMod.coe_unitOfCoprime, Units.val_one]
    decide))

private theorem unitOfCoprime_two_inv_five :
    (ZMod.unitOfCoprime 2 (by decide) : (ZMod 5)ˣ)⁻¹ = ZMod.unitOfCoprime 3 (by decide) :=
  inv_eq_iff_eq_inv.mpr unitOfCoprime_three_inv_five.symm

/- Sanity checks at conductor `5`: the coefficients of `θ_5` at `[3]` and `[2]` are `2 / 5` and
`3 / 5`, and those of the positive smoothing `s_{5, 2}` are `0` and `1`. -/
example : (stickelberger 5).coeff (ZMod.unitOfCoprime 3 (by decide)) = 2 / 5 := by
  rw [coeff_stickelberger, unitOfCoprime_three_inv_five, ZMod.coe_unitOfCoprime,
    ZMod.val_natCast_of_lt (by decide)]
  norm_num

example : (stickelberger 5).coeff (ZMod.unitOfCoprime 2 (by decide)) = 3 / 5 := by
  rw [coeff_stickelberger, unitOfCoprime_two_inv_five, ZMod.coe_unitOfCoprime,
    ZMod.val_natCast_of_lt (by decide)]
  norm_num

example : (stickelbergerSmoothing 5 2).coeff (ZMod.unitOfCoprime 3 (by decide)) = 0 := by
  rw [coeff_stickelbergerSmoothing, unitOfCoprime_three_inv_five, ZMod.coe_unitOfCoprime]
  decide

example : (stickelbergerSmoothing 5 2).coeff (ZMod.unitOfCoprime 2 (by decide)) = 1 := by
  rw [coeff_stickelbergerSmoothing, unitOfCoprime_two_inv_five, ZMod.coe_unitOfCoprime]
  decide

end TauCeti
