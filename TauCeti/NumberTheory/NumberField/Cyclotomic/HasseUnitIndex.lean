/-!
# The Hasse unit index of prime-power cyclotomic fields

This file proves that the Hasse unit index `NumberField.IsCMField.indexRealUnits K` is `1` for
every cyclotomic field of prime-power conductor `p ^ a`, including the powers of `2`. When
`p ^ a ≤ 2` the field is `ℚ`: it is not CM, but every unit is a root of unity, so the index is
again `1`. In other words, the full unit group of `ℚ(ζ_{p^a})` is generated by its roots of
unity and its real units. A non-prime-power conductor behaves differently: in `ℚ(ζ₁₂)` the element
`1 - ζ₁₂` is a unit with `u / conj u = -ζ₁₂`, and the index is `2`.

The prime-power proof applies the general CM norm criterion
`TauCeti.NumberField.IsCMField.indexRealUnits_eq_one_of_not_isSquare_abs_norm`: for a primitive
`p ^ a`-th root of unity `ζ` with `p ^ a > 2`, the norm `|N_{K/ℚ}(ζ - 1)|` is the prime `p`,
which is not a rational square.

In addition, every root of unity of the `n`-th cyclotomic field lies in `cyclotomicUnits K ζ n`,
so for prime powers `p ^ a` the real units and circular units generate `(𝓞 K)ˣ`. Specializing
`TauCeti.NumberField.IsCMField.quotientRealUnitsEquiv` then gives the quotient isomorphism
`(𝓞 K⁺)ˣ ⧸ realCyclotomicUnits K ζ (p ^ a) ≃* (𝓞 K)ˣ ⧸ cyclotomicUnits K ζ (p ^ a)` and the
equality of indices between the real circular units and the full circular units.

## Main results

* `TauCeti.IsCyclotomicExtension.Rat.indexRealUnits_eq_one_of_prime_pow`: the cyclotomic field of
  conductor `p ^ a` has Hasse unit index `1`, for every prime `p` and every `a`.
* `TauCeti.IsCyclotomicExtension.Rat.realUnits_sup_torsion_eq_top_of_prime_pow`: equivalently,
  its unit group is generated by the real units and the roots of unity.
* `TauCeti.IsCyclotomicExtension.Rat.torsion_le_cyclotomicUnits`: every root of unity of `ℚ(ζ_n)`
  is a circular unit.
* `TauCeti.IsCyclotomicExtension.Rat.realUnits_sup_cyclotomicUnits_eq_top_of_prime_pow`: for
  prime-power conductor `p ^ a`, the real units and circular units generate `(𝓞 K)ˣ`.
* `TauCeti.IsCyclotomicExtension.Rat.quotientRealCyclotomicUnitsEquiv`: the real-unit inclusion
  induces `(𝓞 K⁺)ˣ ⧸ realCyclotomicUnits K ζ (p ^ a) ≃* (𝓞 K)ˣ ⧸ cyclotomicUnits K ζ (p ^ a)`.
* `TauCeti.IsCyclotomicExtension.Rat.index_realCyclotomicUnits_eq`: the real circular units and
  full circular units have the same index in prime-power cyclotomic fields.

## References

* L. C. Washington, *Introduction to Cyclotomic Fields*, 2nd ed., Graduate Texts in Mathematics
  83, Springer, 1997, Corollary 4.13.
* R. Sharifi, *Iwasawa theory*, lecture notes, Lemmas 4.2.17 and 4.2.19.
-/

public section

open NumberField NumberField.Units NumberField.IsCMField

namespace TauCeti.IsCyclotomicExtension.Rat

/-- **The Hasse unit index of a prime-power cyclotomic field is one.** For every prime `p` and
every `a`, including `p = 2`, the real units and the roots of unity generate the units of the
cyclotomic field of conductor `p ^ a`. When `p ^ a ≤ 2` the field is `ℚ`, every unit is a root of
unity, and the index is also `1`. -/
theorem indexRealUnits_eq_one_of_prime_pow (p a : ℕ) [hp : Fact p.Prime] (K : Type*) [Field K]
    [CharZero K] [IsCyclotomicExtension {p ^ a} ℚ K] : indexRealUnits K = 1 := by
  have := IsCyclotomicExtension.numberField {p ^ a} ℚ K
  rcases le_or_gt (p ^ a) 2 with h | h
  · -- The field is `ℚ`: it has one infinite place, so every unit is a root of unity.
    have hfin : Module.finrank ℚ K = 1 := by
      rw [IsCyclotomicExtension.finrank K
        (Polynomial.cyclotomic.irreducible_rat (pow_pos hp.out.pos a)), Nat.totient_eq_one_iff]
      have := pow_pos hp.out.pos a
      omega
    rw [indexRealUnits, TauCeti.NumberField.Units.torsion_eq_top_of_rank_eq_zero
      (rank_eq_zero_of_finrank_eq_one K hfin), sup_top_eq, Subgroup.index_top]
  · have := _root_.IsCyclotomicExtension.Rat.isCMField K (S := {p ^ a}) ⟨p ^ a, rfl, h⟩
    have ha : a ≠ 0 := by
      rintro rfl
      simp at h
    have hζ := IsCyclotomicExtension.zeta_spec (p ^ a) ℚ K
    let ζ : torsion K := ⟨(hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne _)).unit, by
      rw [torsion, CommGroup.mem_torsion, isOfFinOrder_iff_pow_eq_one]
      refine ⟨p ^ a, NeZero.pos _, Units.ext ?_⟩
      simpa using hζ.toInteger_isPrimitiveRoot.pow_eq_one⟩
    refine TauCeti.NumberField.IsCMField.indexRealUnits_eq_one_of_not_isSquare_abs_norm K ζ ?_
    have hnorm := hζ.sub_one_norm_isPrimePow (hp.out.isPrimePow.pow ha)
      (Polynomial.cyclotomic.irreducible_rat (NeZero.pos _)) h.ne'
    have hζ' : algebraMap (𝓞 K) K (ζ : (𝓞 K)ˣ) = IsCyclotomicExtension.zeta (p ^ a) ℚ K := by
      rw [← RingOfIntegers.coe_eq_algebraMap, IsUnit.unit_spec]
      exact hζ.coe_toInteger
    rw [hζ', hnorm]
    simpa [Nat.pow_minFac ha, hp.out.minFac_eq, Rat.isSquare_natCast_iff] using
      hp.out.prime.not_isSquare

/-- The units of the cyclotomic field of prime-power conductor `p ^ a` are generated by its real
units and its roots of unity. -/
theorem realUnits_sup_torsion_eq_top_of_prime_pow (p a : ℕ) [Fact p.Prime] (K : Type*) [Field K]
    [CharZero K] [IsCyclotomicExtension {p ^ a} ℚ K] : realUnits K ⊔ torsion K = ⊤ :=
  Subgroup.index_eq_one.mp (indexRealUnits_eq_one_of_prime_pow p a K)

/-- Every root of unity of the `n`-th cyclotomic field over `ℚ` lies in `cyclotomicUnits K ζ n`
for any primitive `n`-th root of unity `ζ`. -/
theorem torsion_le_cyclotomicUnits {n : ℕ} [NeZero n] {K : Type*} [Field K] [CharZero K]
    [IsCyclotomicExtension {n} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ n) :
    torsion K ≤ cyclotomicUnits K ζ n := by
  have := IsCyclotomicExtension.numberField {n} ℚ K
  let z : (𝓞 K)ˣ := (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne n)).unit
  have hz_prim : IsPrimitiveRoot z n := by
    rw [← IsPrimitiveRoot.coe_units_iff, IsUnit.unit_spec]
    exact hζ.toInteger_isPrimitiveRoot
  have hz_tors : z ∈ torsion K :=
    (CommGroup.mem_torsion _).mpr ⟨n, NeZero.pos n, by
      simpa [isPeriodicPt_mul_iff_pow_eq_one] using hz_prim.pow_eq_one⟩
  have hz_circ : z ∈ cyclotomicUnits K ζ n :=
    mem_cyclotomicUnits_of_val_eq_zpow n (k := 1) (by
      rw [zpow_one, IsUnit.unit_spec, hζ.coe_toInteger])
  have hz_ord : orderOf (⟨z, hz_tors⟩ : torsion K) = n := by
    rw [Subgroup.orderOf_mk]
    exact hz_prim.eq_orderOf.symm
  have hcard : Nat.card (torsion K) = if Even n then n else 2 * n :=
    _root_.IsCyclotomicExtension.Rat.torsionOrder_eq (n := n) (K := K)
  intro u hu
  rcases Nat.even_or_odd n with hn | hn
  · have htop : Subgroup.zpowers (⟨z, hz_tors⟩ : torsion K) = ⊤ :=
      Subgroup.eq_top_of_card_eq _ (by rw [Nat.card_zpowers, hz_ord, hcard, ite_eq_left hn])
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp
      (htop.symm ▸ Subgroup.mem_top (⟨u, hu⟩ : torsion K))
    have hzk : z ^ k = u := congrArg Subtype.val hk
    exact hzk ▸ zpow_mem hz_circ k
  · let negOne : torsion K := ⟨-1, neg_one_mem_torsion⟩
    have hneg_ord : orderOf negOne = 2 := by
      refine orderOf_eq_prime (Subtype.ext (by simp [negOne])) ?_
      intro h
      have h1 : (-1 : K) = 1 := congrArg (fun x : torsion K ↦ (((x : (𝓞 K)ˣ) : 𝓞 K) : K)) h
      norm_num at h1
    have hord : orderOf (negOne * ⟨z, hz_tors⟩) = 2 * n := by
      rw [(Commute.all _ _).orderOf_mul_eq_mul_orderOf_of_coprime
        (by rw [hneg_ord, hz_ord]; exact Nat.coprime_two_left.mpr hn), hneg_ord, hz_ord]
    have htop : Subgroup.zpowers (negOne * ⟨z, hz_tors⟩) = ⊤ :=
      Subgroup.eq_top_of_card_eq _
        (by rw [Nat.card_zpowers, hord, hcard, ite_eq_right (Nat.not_even_iff_odd.mpr hn)])
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp
      (htop.symm ▸ Subgroup.mem_top (⟨u, hu⟩ : torsion K))
    have hzk : (-1 * z) ^ k = u := congrArg Subtype.val hk
    exact hzk ▸ zpow_mem (mul_mem (neg_one_mem_cyclotomicUnits ζ n) hz_circ) k

/-- In a prime-power cyclotomic field, the real units and circular units generate `(𝓞 K)ˣ`. -/
theorem realUnits_sup_cyclotomicUnits_eq_top_of_prime_pow (p a : ℕ) [Fact p.Prime] {K : Type*}
    [Field K] [CharZero K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    realUnits K ⊔ cyclotomicUnits K ζ (p ^ a) = ⊤ := by
  have : NeZero (p ^ a) := ⟨pow_ne_zero a (Fact.out : p.Prime).ne_zero⟩
  exact top_le_iff.mp ((realUnits_sup_torsion_eq_top_of_prime_pow p a K).symm.trans_le
    (sup_le_sup_left (torsion_le_cyclotomicUnits hζ) (realUnits K)))

/-- **Real-to-full circular unit quotient isomorphism (Sharifi, Lemma 4.2.19).** In a
prime-power cyclotomic field `ℚ(ζ_{p^a})`, the real-unit inclusion induces an isomorphism
`(𝓞 K⁺)ˣ ⧸ realCyclotomicUnits K ζ (p ^ a) ≃* (𝓞 K)ˣ ⧸ cyclotomicUnits K ζ (p ^ a)`. -/
noncomputable def quotientRealCyclotomicUnitsEquiv (p a : ℕ) [Fact p.Prime] {K : Type*} [Field K]
    [CharZero K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    (𝓞 (maximalRealSubfield K))ˣ ⧸ realCyclotomicUnits K ζ (p ^ a) ≃*
      (𝓞 K)ˣ ⧸ cyclotomicUnits K ζ (p ^ a) :=
  let hcomap : realCyclotomicUnits K ζ (p ^ a) =
      (cyclotomicUnits K ζ (p ^ a)).comap
        (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
          𝓞 (maximalRealSubfield K) →* 𝓞 K)) := by
    ext u
    rw [mem_realCyclotomicUnits_iff, Subgroup.mem_comap, mem_cyclotomicUnits_iff]
    congr! 1
  (QuotientGroup.quotientMulEquivOfEq hcomap).trans
    (TauCeti.NumberField.IsCMField.quotientRealUnitsEquiv K (cyclotomicUnits K ζ (p ^ a))
      (realUnits_sup_cyclotomicUnits_eq_top_of_prime_pow p a hζ))

/-- Applying `quotientRealCyclotomicUnitsEquiv` to a coset of a real unit gives the coset of its
image in `(𝓞 K)ˣ`. -/
@[simp]
theorem quotientRealCyclotomicUnitsEquiv_mk (p a : ℕ) [Fact p.Prime] {K : Type*} [Field K]
    [CharZero K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) (u : (𝓞 (maximalRealSubfield K))ˣ) :
    quotientRealCyclotomicUnitsEquiv p a hζ (QuotientGroup.mk u) =
      QuotientGroup.mk
        (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
          𝓞 (maximalRealSubfield K) →* 𝓞 K) u) := by
  rw [quotientRealCyclotomicUnitsEquiv, MulEquiv.trans_apply,
    QuotientGroup.quotientMulEquivOfEq_mk,
    TauCeti.NumberField.IsCMField.quotientRealUnitsEquiv_mk]

/-- Applying the inverse of `quotientRealCyclotomicUnitsEquiv` to the coset of a real unit
recovers its coset in `(𝓞 K⁺)ˣ`. -/
@[simp]
theorem quotientRealCyclotomicUnitsEquiv_symm_mk_map (p a : ℕ) [Fact p.Prime] {K : Type*} [Field K]
    [CharZero K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) (u : (𝓞 (maximalRealSubfield K))ˣ) :
    (quotientRealCyclotomicUnitsEquiv p a hζ).symm
        (QuotientGroup.mk
          (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
          𝓞 (maximalRealSubfield K) →* 𝓞 K) u)) =
      QuotientGroup.mk u :=
  (MulEquiv.symm_apply_eq _).mpr (quotientRealCyclotomicUnitsEquiv_mk p a hζ u).symm

/-- **Real and full circular unit indices coincide in prime-power cyclotomic fields.** For a
primitive `p ^ a`-th root of unity `ζ` in `ℚ(ζ_{p^a})`, the real circular units have the same
index in `(𝓞 K⁺)ˣ` as the circular units in `(𝓞 K)ˣ`. -/
theorem index_realCyclotomicUnits_eq (p a : ℕ) [Fact p.Prime] {K : Type*} [Field K]
    [CharZero K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    (realCyclotomicUnits K ζ (p ^ a)).index = (cyclotomicUnits K ζ (p ^ a)).index :=
  Nat.card_congr (quotientRealCyclotomicUnitsEquiv p a hζ).toEquiv

end TauCeti.IsCyclotomicExtension.Rat

end
