/-!
# The Hasse unit index of prime-power cyclotomic fields

For a number field `K`, the Hasse unit index is the index
`Q_K = [(𝓞 K)ˣ : (𝓞 K⁺)ˣ · μ(K)]` of the subgroup generated by the real units and the roots of
unity inside the full unit group, written `NumberField.IsCMField.indexRealUnits K` in Mathlib.
When `K` is a CM-field, `Q_K` is either `1` or `2`, and `Q_K = 2` holds precisely when there is a
unit `u ∈ (𝓞 K)ˣ` whose quotient `u / conj(u)` generates the full torsion subgroup `μ(K)`.

For every prime `p` and exponent `a : ℕ`, the `p ^ a`-th cyclotomic field `K` over `ℚ` has Hasse
unit index `1`, including all powers of `2` as well as the degenerate levels `a = 0` and `p ^ a = 2`
where `K` is `ℚ` itself. In the nondegenerate case `2 < p ^ a`, if `u / conj(u) = η` generated
`μ(K)` then `ζ := -η` would be a primitive `p ^ a`-th root of unity; the integral element
`(1 - ζ) * u⁻¹` is fixed by complex conjugation, hence lies in `𝓞 K⁺`, while it generates the
unique prime ideal `𝔓 = (ζ - 1)` of `𝓞 K` above `p`. This contradicts the fact that `𝔓` has
ramification index `2` over `𝔓 ∩ 𝓞 K⁺`, which forces `𝔓 ^ 2 ∣ (𝔓 ∩ 𝓞 K⁺) · 𝓞 K`.

When `Q_K = 1`, any subgroup `D ≤ (𝓞 K)ˣ` containing `μ(K)` splits as `μ(K) ⊔ D⁺` where `D⁺` is
the preimage of `D` in `(𝓞 K⁺)ˣ`, and inclusion induces an isomorphism
`(𝓞 K⁺)ˣ ⧸ D⁺ ≃* (𝓞 K)ˣ ⧸ D` preserving the subgroup index.

## Main results

* `TauCeti.realUnits_eq_top_of_isTotallyReal` and `TauCeti.indexRealUnits_eq_one_of_isTotallyReal`:
  every totally real algebraic extension of `ℚ` has `realUnits K = ⊤` and `indexRealUnits K = 1`.
* `TauCeti.realQuotientEquivOfIndexRealUnitsEqOne` and `TauCeti.index_comap_realUnits_eq`:
  whenever `indexRealUnits K = 1` and `torsion K ≤ D`, the quotient `(𝓞 K⁺)ˣ ⧸ D⁺` is isomorphic
  to `(𝓞 K)ˣ ⧸ D` and the two subgroups have the same index.
* `TauCeti.ramificationIdx_span_zeta_sub_one_maximalRealSubfield`: for `2 < p ^ (k + 1)`, the
  prime `(ζ - 1)` has ramification index `2` over the maximal real subfield `K⁺`.
* `TauCeti.primePowerHasseUnitIndex_one`: for every prime `p` and every `a : ℕ`, a `p ^ a`-th
  cyclotomic field `K` over `ℚ` has `NumberField.IsCMField.indexRealUnits K = 1`.

## References

* L. C. Washington, *Introduction to Cyclotomic Fields*, Corollary 4.13.
* R. Sharifi, *Iwasawa Theory*, Lemma 4.2.17.
-/

public section

open NumberField NumberField.Units NumberField.IsCMField Ideal

open scoped NumberField

namespace TauCeti

section TotallyReal

variable (K : Type*) [Field K]

/-- The Hasse unit index equals `1` if and only if real units and roots of unity generate
`(𝓞 K)ˣ`. -/
theorem realUnits_sup_torsion_eq_top_iff :
    realUnits K ⊔ torsion K = ⊤ ↔ indexRealUnits K = 1 :=
  Subgroup.index_eq_one.symm

/-- In a totally real field, every unit lies in `realUnits K`. -/
theorem realUnits_eq_top_of_isTotallyReal [IsTotallyReal K] : realUnits K = ⊤ := by
  rw [eq_top_iff]
  intro u _
  rw [mem_realUnits_iff]
  have hmem (x : K) : x ∈ maximalRealSubfield K := by
    rw [IsTotallyReal.maximalRealSubfield_eq_top]
    trivial
  let toReal (x : 𝓞 K) : 𝓞 (maximalRealSubfield K) :=
    ⟨⟨(x : K), hmem (x : K)⟩, isIntegral_algebraMap_iff.mp x.isIntegral_coe⟩
  have htoReal_mul (x y : 𝓞 K) : toReal (x * y) = toReal x * toReal y := by ext; rfl
  have htoReal_one : toReal 1 = 1 := by ext; rfl
  exact ⟨⟨toReal (u : 𝓞 K), toReal (↑u⁻¹ : 𝓞 K),
    by rw [← htoReal_mul, Units.mul_inv, htoReal_one],
    by rw [← htoReal_mul, Units.inv_mul, htoReal_one]⟩, rfl⟩

/-- Every totally real field has Hasse unit index `1`. -/
theorem indexRealUnits_eq_one_of_isTotallyReal [IsTotallyReal K] : indexRealUnits K = 1 := by
  rw [indexRealUnits, realUnits_eq_top_of_isTotallyReal K, top_sup_eq, Subgroup.index_top]

/-- An `n`-th cyclotomic field over `ℚ` with `n ≤ 2` has degree `1` and is therefore totally
real. -/
theorem isTotallyReal_of_le_two [NumberField K] {n : ℕ} [NeZero n] (hle : n ≤ 2)
    [IsCyclotomicExtension {n} ℚ K] : IsTotallyReal K := by
  have hfin : Module.finrank ℚ K = 1 := by
    rw [IsCyclotomicExtension.Rat.finrank n K]
    have hpos : 0 < n := NeZero.pos n
    interval_cases n <;> decide
  exact nrComplexPlaces_eq_zero_iff.mp (by
    have := InfinitePlace.card_add_two_mul_card_eq_rank K; omega)

end TotallyReal

section QuotientComparison

variable {K : Type*} [Field K]

/-- When `indexRealUnits K = 1`, any subgroup `D ≤ (𝓞 K)ˣ` containing `torsion K` is generated by
`torsion K` and the real units lying in `D`. -/
theorem sup_map_comap_realUnits_eq {D : Subgroup (𝓞 K)ˣ} (hQ : indexRealUnits K = 1)
    (hT : torsion K ≤ D) :
    torsion K ⊔ (D.comap (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom)).map
      (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) = D := by
  set ι : (𝓞 (maximalRealSubfield K))ˣ →* (𝓞 K)ˣ :=
    Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
  refine le_antisymm (sup_le hT (Subgroup.map_comap_le _ _)) ?_
  intro u hu
  have hmem : u ∈ realUnits K ⊔ torsion K :=
    ((realUnits_sup_torsion_eq_top_iff K).mpr hQ).symm ▸ Subgroup.mem_top u
  obtain ⟨r, ⟨v, rfl⟩, t, ht, rfl⟩ := Subgroup.mem_sup.mp hmem
  have hv : v ∈ D.comap ι := by
    rw [Subgroup.mem_comap]
    simpa [ι] using D.mul_mem hu (D.inv_mem (hT ht))
  rw [mul_comm]
  exact Subgroup.mul_mem_sup ht (Subgroup.mem_map_of_mem ι hv)

/-- If `D ≤ torsion K ⊔ S.map ι` and `-1 ∈ S`, then the preimage of `D` in `(𝓞 K⁺)ˣ` is contained
in `S`. -/
theorem comap_realUnits_le_of_le_torsion_sup [NumberField K] {D : Subgroup (𝓞 K)ˣ}
    {S : Subgroup (𝓞 (maximalRealSubfield K))ˣ}
    (hneg : (-1 : (𝓞 (maximalRealSubfield K))ˣ) ∈ S)
    (hle : D ≤ torsion K ⊔
      S.map (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom)) :
    D.comap (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) ≤ S := by
  set ι : (𝓞 (maximalRealSubfield K))ˣ →* (𝓞 K)ˣ :=
    Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
  intro v hv
  obtain ⟨t, ht, -, ⟨s, hs, rfl⟩, hts⟩ := Subgroup.mem_sup.mp (hle hv)
  have hvs_tors : v * s⁻¹ ∈ torsion (maximalRealSubfield K) := by
    have hι_eq : ι (v * s⁻¹) = t := by rw [map_mul, map_inv, ← hts, mul_inv_cancel_right]
    have hinj : Function.Injective ι := fun x y hxy ↦
      Units.ext (RingOfIntegers.coe_injective (Subtype.ext
        (by simpa [ι] using congrArg (fun z : (𝓞 K)ˣ ↦ (z : K)) hxy)))
    exact hinj.isOfFinOrder_iff.mp (hι_eq ▸ ht)
  obtain ⟨w⟩ := (inferInstance : Nonempty (InfinitePlace (maximalRealSubfield K)))
  rcases TauCeti.NumberField.Units.torsion_eq_one_or_neg_one_of_isReal
      (IsTotallyReal.isReal w) ⟨v * s⁻¹, hvs_tors⟩ with h1 | h1
  · exact (mul_inv_eq_one.mp (by simpa using h1)) ▸ hs
  · have hvs : v = (-1 : (𝓞 (maximalRealSubfield K))ˣ) * s := by
      have h1' : v * s⁻¹ = -1 := by simpa using h1
      rw [← h1', mul_assoc, inv_mul_cancel, mul_one]
    exact hvs ▸ S.mul_mem hneg hs

/-- When `indexRealUnits K = 1`, the canonical map from `(𝓞 K⁺)ˣ` into `(𝓞 K)ˣ ⧸ D` is surjective
for every subgroup `D ≤ (𝓞 K)ˣ` containing `torsion K`. -/
theorem surjective_quotientMk_comp_realUnits {D : Subgroup (𝓞 K)ˣ} (hQ : indexRealUnits K = 1)
    (hT : torsion K ≤ D) :
    Function.Surjective ((QuotientGroup.mk' D).comp
      (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom)) := by
  intro q
  obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective D q
  have hmem : u ∈ realUnits K ⊔ torsion K :=
    ((realUnits_sup_torsion_eq_top_iff K).mpr hQ).symm ▸ Subgroup.mem_top u
  obtain ⟨r, ⟨v, rfl⟩, t, ht, rfl⟩ := Subgroup.mem_sup.mp hmem
  refine ⟨v, ?_⟩
  simp only [MonoidHom.comp_apply, QuotientGroup.mk'_apply, QuotientGroup.eq]
  simpa using D.inv_mem (hT ht)

/-- When `indexRealUnits K = 1` and `torsion K ≤ D`, inclusion of real units induces an isomorphism
`(𝓞 K⁺)ˣ ⧸ D⁺ ≃* (𝓞 K)ˣ ⧸ D`. -/
noncomputable def realQuotientEquivOfIndexRealUnitsEqOne {D : Subgroup (𝓞 K)ˣ}
    (hQ : indexRealUnits K = 1) (hT : torsion K ≤ D) :
    (𝓞 (maximalRealSubfield K))ˣ ⧸
      D.comap (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
        𝓞 (maximalRealSubfield K) →* 𝓞 K)) ≃*
      (𝓞 K)ˣ ⧸ D :=
  let ι : (𝓞 (maximalRealSubfield K))ˣ →* (𝓞 K)ˣ :=
    Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) : 𝓞 (maximalRealSubfield K) →* 𝓞 K)
  (QuotientGroup.quotientMulEquivOfEq (by
    ext x
    simp [ι, MonoidHom.mem_ker, QuotientGroup.eq_one_iff])).trans
    (QuotientGroup.quotientKerEquivOfSurjective ((QuotientGroup.mk' D).comp ι)
      (surjective_quotientMk_comp_realUnits hQ hT))

/-- Evaluating `realQuotientEquivOfIndexRealUnitsEqOne` on a coset `QuotientGroup.mk v`. -/
@[simp]
theorem realQuotientEquivOfIndexRealUnitsEqOne_mk {D : Subgroup (𝓞 K)ˣ}
    (hQ : indexRealUnits K = 1) (hT : torsion K ≤ D) (v : (𝓞 (maximalRealSubfield K))ˣ) :
    realQuotientEquivOfIndexRealUnitsEqOne hQ hT (QuotientGroup.mk v) =
      QuotientGroup.mk (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
        𝓞 (maximalRealSubfield K) →* 𝓞 K) v) := by
  rfl

/-- When `indexRealUnits K = 1` and `torsion K ≤ D`, the preimage of `D` in `(𝓞 K⁺)ˣ` has the same
index as `D` in `(𝓞 K)ˣ`. -/
theorem index_comap_realUnits_eq {D : Subgroup (𝓞 K)ˣ} (hQ : indexRealUnits K = 1)
    (hT : torsion K ≤ D) :
    (D.comap (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom)).index =
      D.index := by
  rw [Subgroup.index_eq_card, Subgroup.index_eq_card]
  exact Nat.card_congr (realQuotientEquivOfIndexRealUnitsEqOne hQ hT).toEquiv

end QuotientComparison

section PrimePowerRamification

variable {p k : ℕ} [hp : Fact p.Prime] {K : Type*} [Field K] [NumberField K]
  [hK : IsCyclotomicExtension {p ^ (k + 1)} ℚ K]

/-- For `2 < p ^ (k + 1)` and a primitive `p ^ (k + 1)`-th root of unity `ζ`, the unique prime
`𝔓 = (ζ - 1)` above `p` has ramification index `2` over `K⁺`. -/
theorem ramificationIdx_span_zeta_sub_one_maximalRealSubfield (hgt : 2 < p ^ (k + 1))
    {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) :
    (span {hζ.toInteger - 1}).ramificationIdx (𝓞 (maximalRealSubfield K)) = 2 := by
  have : IsCMField K := IsCyclotomicExtension.Rat.isCMField K (S := {p ^ (k + 1)})
    ⟨p ^ (k + 1), Set.mem_singleton _, hgt⟩
  set P : Ideal (𝓞 K) := span {hζ.toInteger - 1}
  set Kplus := maximalRealSubfield K
  set Pplus : Ideal (𝓞 Kplus) := P.under (𝓞 Kplus)
  have hP_prime : P.IsPrime := IsCyclotomicExtension.Rat.isPrime_span_zeta_sub_one p k hζ
  have hP_over_Pplus : P.LiesOver Pplus := ⟨rfl⟩
  have hPplus_prime : Pplus.IsPrime := Ideal.isPrime_of_liesOver P Pplus
  have htower : P.ramificationIdx ℤ = Pplus.ramificationIdx ℤ * P.ramificationIdx (𝓞 Kplus) :=
    Ideal.ramificationIdx_tower (R := ℤ) (S := 𝓞 Kplus) (T := 𝓞 K) (q := Pplus) (r := P)
  have htot : P.ramificationIdx ℤ = Module.finrank ℚ Kplus * 2 := by
    rw [IsCyclotomicExtension.Rat.ramificationIdx_span_zeta_sub_one p k hζ,
      ← Nat.totient_prime_pow_succ hp.out, ← IsCyclotomicExtension.Rat.finrank (p ^ (k + 1)) K,
      ← Module.finrank_mul_finrank ℚ Kplus K, Algebra.IsQuadraticExtension.finrank_eq_two Kplus K]
  have hle₁ : Pplus.ramificationIdx ℤ ≤ Module.finrank ℚ Kplus :=
    (TauCeti.RamificationInertia.ramificationIdx_le_finrank ℤ Pplus).trans_eq
      (NumberField.RingOfIntegers.rank Kplus)
  have hle₂ : P.ramificationIdx (𝓞 Kplus) ≤ 2 :=
    (Ideal.ramificationIdx_le_finrank_of_numberField (K := Kplus) (F := K) P).trans_eq
      (Algebra.IsQuadraticExtension.finrank_eq_two Kplus K)
  have hpos : 0 < Module.finrank ℚ Kplus := Module.finrank_pos
  nlinarith

end PrimePowerRamification

/-- In a CM-field `K`, the element `(1 - (-η)) * u⁻¹` is fixed by complex conjugation whenever
`η = u / conj(u)`. -/
private theorem complexConj_sub_neg_mul_inv_eq {K : Type*} [Field K] [NumberField K] [IsCMField K]
    (u : (𝓞 K)ˣ) :
    let η := NumberField.IsCMField.unitsMulComplexConjInv K u
    IsCMField.complexConj K ((1 - -((η : (𝓞 K)ˣ) : K)) * ((u⁻¹ : (𝓞 K)ˣ) : K)) =
      (1 - -((η : (𝓞 K)ˣ) : K)) * ((u⁻¹ : (𝓞 K)ˣ) : K) := by
  intro η
  set ζ : K := -((η : (𝓞 K)ˣ) : K)
  have hη_ne : ((η : (𝓞 K)ˣ) : K) ≠ 0 := by simp
  have hζ_ne : ζ ≠ 0 := neg_ne_zero.mpr hη_ne
  have hη_eq : ((η : (𝓞 K)ˣ) : K) = (u : K) * (IsCMField.complexConj K (u : K))⁻¹ := by
    have hcoe := congrArg (fun x : (𝓞 K)ˣ ↦ (x : K))
      (IsCMField.unitsMulComplexConjInv_apply K u)
    simpa [η, map_units_inv] using hcoe
  have hconj_u_inv : IsCMField.complexConj K ((u⁻¹ : (𝓞 K)ˣ) : K) =
      ((η : (𝓞 K)ˣ) : K) * ((u⁻¹ : (𝓞 K)ˣ) : K) := by
    have hu_ne : (u : K) ≠ 0 := by simp
    have hcu_ne : IsCMField.complexConj K (u : K) ≠ 0 := (map_ne_zero _).mpr hu_ne
    have hu_inv : ((u⁻¹ : (𝓞 K)ˣ) : K) = (u : K)⁻¹ := by simp
    rw [hu_inv, map_inv₀, hη_eq]
    field_simp
  have hconj_ζ : IsCMField.complexConj K ζ = ζ⁻¹ := by
    simp only [ζ, map_neg, IsCMField.complexConj_torsion, neg_inv]
  have hconj_sub : IsCMField.complexConj K (1 - ζ) = -ζ⁻¹ * (1 - ζ) := by
    rw [map_sub, map_one, hconj_ζ]
    field_simp
    ring
  have hη_neg : ((η : (𝓞 K)ˣ) : K) = -ζ := by simp [ζ]
  rw [map_mul, hconj_sub, hconj_u_inv, hη_neg]
  field_simp

/-- If `η` generates the torsion subgroup of a nondegenerate prime-power cyclotomic field
(`2 < p ^ (k + 1)`), then `-η` is a primitive `p ^ (k + 1)`-th root of unity. -/
private theorem isPrimitiveRoot_neg_of_torsionOrder_eq {p k : ℕ} [hp : Fact p.Prime]
    {K : Type*} [Field K] (hgt : 2 < p ^ (k + 1)) {η : K}
    (hη : IsPrimitiveRoot η (if Even (p ^ (k + 1)) then p ^ (k + 1) else 2 * p ^ (k + 1))) :
    IsPrimitiveRoot (-η) (p ^ (k + 1)) := by
  by_cases hp2 : p = 2
  · subst hp2
    obtain ⟨m, rfl⟩ : ∃ m, k = m + 1 := Nat.exists_eq_succ_of_ne_zero (by rintro rfl; simp at hgt)
    have he : Even (2 ^ (m + 2)) := even_two.pow_of_ne_zero (by omega)
    simp only [he, ↓reduceIte] at hη
    have hneg1 : η ^ (2 ^ (m + 1)) = -1 :=
      (hη.pow (by positivity) (by ring : 2 ^ (m + 2) = 2 ^ (m + 1) * 2)).eq_neg_one_of_two_right
    have heq : -η = η ^ (1 + 2 ^ (m + 1)) := by rw [pow_add, pow_one, hneg1, mul_neg_one]
    rw [heq]
    exact hη.pow_of_coprime _ ((Nat.coprime_two_right.mpr ⟨2 ^ m, by ring⟩).pow_right (m + 2))
  · have hodd : Odd (p ^ (k + 1)) := (hp.out.odd_of_ne_two hp2).pow
    have he : ¬ Even (p ^ (k + 1)) := Nat.not_even_iff_odd.mpr hodd
    simp only [he, ↓reduceIte] at hη
    have hneg1 : η ^ (p ^ (k + 1)) = -1 :=
      (hη.pow (by positivity) (by ring : 2 * p ^ (k + 1) = p ^ (k + 1) * 2)).eq_neg_one_of_two_right
    rw [IsPrimitiveRoot.iff_def]
    refine ⟨by rw [neg_pow, hodd.neg_one_pow, hneg1, neg_one_mul, neg_neg], fun l hl ↦ ?_⟩
    have h2l : η ^ (2 * l) = 1 := by
      calc η ^ (2 * l) = (-η) ^ (2 * l) := by
            rw [neg_pow, Even.neg_one_pow ⟨l, by ring⟩, one_mul]
        _ = ((-η) ^ l) ^ 2 := by rw [mul_comm, pow_mul]
        _ = 1 := by rw [hl, one_pow]
    exact (Nat.mul_dvd_mul_iff_left two_pos).mp (hη.dvd_of_pow_eq_one (2 * l) h2l)

/-- Helper excluding `indexRealUnits K = 2` for a prime-power cyclotomic field with
`2 < p ^ (k + 1)`. -/
private theorem not_indexRealUnits_eq_two_of_prime_pow {p k : ℕ} [hp : Fact p.Prime]
    {K : Type*} [Field K] [NumberField K] [IsCyclotomicExtension {p ^ (k + 1)} ℚ K]
    (hgt : 2 < p ^ (k + 1)) :
    NumberField.IsCMField.indexRealUnits K ≠ 2 := by
  have : IsCMField K := IsCyclotomicExtension.Rat.isCMField K (S := {p ^ (k + 1)})
    ⟨p ^ (k + 1), Set.mem_singleton _, hgt⟩
  intro h2
  obtain ⟨u, hu⟩ := (NumberField.IsCMField.indexRealUnits_eq_two_iff K).mp h2
  set η := NumberField.IsCMField.unitsMulComplexConjInv K u
  have hη_prim : IsPrimitiveRoot ((η : (𝓞 K)ˣ) : K) (torsionOrder K) := by
    have h1 : orderOf η = torsionOrder K := by
      rw [torsionOrder, ← Nat.card_zpowers, hu, Subgroup.card_top]
    rw [← IsPrimitiveRoot.iff_orderOf, ← IsPrimitiveRoot.coe_submonoidClass_iff,
      ← IsPrimitiveRoot.coe_units_iff] at h1
    exact h1.map_of_injective (FaithfulSMul.algebraMap_injective (𝓞 K) K)
  rw [IsCyclotomicExtension.Rat.torsionOrder_eq (n := p ^ (k + 1)) (K := K)] at hη_prim
  set ζ : K := -((η : (𝓞 K)ˣ) : K)
  have hζ : IsPrimitiveRoot ζ (p ^ (k + 1)) := isPrimitiveRoot_neg_of_torsionOrder_eq hgt hη_prim
  set z : 𝓞 K := (1 - hζ.toInteger) * (u⁻¹ : (𝓞 K)ˣ)
  have hz_coe : (z : K) = (1 - -((η : (𝓞 K)ˣ) : K)) * ((u⁻¹ : (𝓞 K)ˣ) : K) := by
    have hcoe : (hζ.toInteger : K) = ζ := hζ.coe_toInteger
    simp [z, ← RingOfIntegers.coe_eq_algebraMap, hcoe, ζ]
  have hconj_z : IsCMField.complexConj K (z : K) = (z : K) :=
    hz_coe ▸ complexConj_sub_neg_mul_inv_eq u
  set Kplus := maximalRealSubfield K
  obtain ⟨y, hy⟩ := (IsCMField.RingOfIntegers.complexConj_eq_self_iff K z).mp hconj_z
  have hy' : algebraMap (𝓞 Kplus) (𝓞 K) y = z := RingOfIntegers.ext hy
  set P : Ideal (𝓞 K) := span {hζ.toInteger - 1}
  set Pplus : Ideal (𝓞 Kplus) := P.under (𝓞 Kplus)
  have hP_prime : P.IsPrime := IsCyclotomicExtension.Rat.isPrime_span_zeta_sub_one p k hζ
  have hP_ne_bot : P ≠ ⊥ := IsCyclotomicExtension.Rat.span_zeta_sub_one_ne_bot p k hζ
  have hP_span_z : span {z} = P := by
    refine Ideal.span_singleton_eq_span_singleton.mpr ⟨-u, ?_⟩
    simp only [z, Units.val_neg]
    calc (1 - hζ.toInteger) * (↑u⁻¹ : 𝓞 K) * -(u : 𝓞 K)
        = -(1 - hζ.toInteger) * ((↑u⁻¹ : 𝓞 K) * (u : 𝓞 K)) := by ring
      _ = hζ.toInteger - 1 := by rw [← Units.val_mul, inv_mul_cancel, Units.val_one]; ring
  have hy_mem : y ∈ Pplus := by
    rw [Ideal.mem_comap, hy', ← hP_span_z]
    exact Ideal.subset_span (Set.mem_singleton z)
  have hP_le_map : P ≤ Pplus.map (algebraMap (𝓞 Kplus) (𝓞 K)) := by
    rw [← hP_span_z, ← hy', ← Set.image_singleton, ← Ideal.map_span]
    exact Ideal.map_mono ((Ideal.span_singleton_le_iff_mem Pplus).mpr hy_mem)
  have hPplus_ne_bot : Pplus ≠ ⊥ := fun hbot ↦ by
    rw [hbot, Ideal.mem_bot] at hy_mem
    have hz0 : z = 0 := by rw [← hy', hy_mem, map_zero]
    exact hP_ne_bot (by rw [← hP_span_z, hz0, Ideal.span_singleton_eq_bot])
  have he : P.ramificationIdx (𝓞 Kplus) = 2 :=
    ramificationIdx_span_zeta_sub_one_maximalRealSubfield hgt hζ
  have hP_over_Pplus : P.LiesOver Pplus := ⟨rfl⟩
  have hdvd : P ^ 2 ∣ Pplus.map (algebraMap (𝓞 Kplus) (𝓞 K)) := by
    rw [← he, IsDedekindDomain.ramificationIdx_eq_multiplicity Pplus P
      (Ideal.map_ne_bot_of_ne_bot hPplus_ne_bot)]
    exact pow_multiplicity_dvd P (Pplus.map (algebraMap (𝓞 Kplus) (𝓞 K)))
  have hdvd_self : P ^ 2 ∣ P := Ideal.dvd_iff_le.mpr (hP_le_map.trans (Ideal.le_of_dvd hdvd))
  rw [sq] at hdvd_self
  obtain ⟨I, hI⟩ := hdvd_self
  have h1 : P * I = 1 := mul_left_cancel₀ hP_ne_bot (by rw [← mul_assoc, ← hI, mul_one])
  exact hP_prime.ne_top (Ideal.isUnit_iff.mp (isUnit_iff_exists_inv.mpr ⟨I, h1⟩))

/-- **Prime-power cyclotomic fields have Hasse unit index one.** For every prime `p` and exponent
`a : ℕ`, a `p ^ a`-th cyclotomic field `K` over `ℚ` satisfies
`NumberField.IsCMField.indexRealUnits K = 1`. This includes powers of `2` as well as the degenerate
cases `a = 0` and `p ^ a = 2`, where `K` is totally real (`K ≃ ℚ`). -/
theorem primePowerHasseUnitIndex_one (p a : ℕ) [hp : Fact p.Prime]
    (K : Type*) [Field K] [NumberField K]
    [hK : IsCyclotomicExtension {p ^ a} ℚ K] :
    NumberField.IsCMField.indexRealUnits K = 1 := by
  by_cases hgt : 2 < p ^ a
  · obtain ⟨k, rfl⟩ : ∃ k, a = k + 1 := Nat.exists_eq_succ_of_ne_zero (by
      rintro rfl; simp at hgt)
    have : IsCMField K := IsCyclotomicExtension.Rat.isCMField K (S := {p ^ (k + 1)})
      ⟨p ^ (k + 1), Set.mem_singleton _, hgt⟩
    exact (NumberField.IsCMField.indexRealUnits_eq_one_or_two K).resolve_right
      (not_indexRealUnits_eq_two_of_prime_pow hgt)
  · have : NeZero (p ^ a) := ⟨pow_ne_zero a hp.out.ne_zero⟩
    have : IsTotallyReal K := isTotallyReal_of_le_two K (Nat.le_of_not_lt hgt)
    exact indexRealUnits_eq_one_of_isTotallyReal K

/-- In a prime-power cyclotomic field over `ℚ`, the real units and the roots of unity generate the
entire unit group `(𝓞 K)ˣ`. -/
theorem primePower_realUnits_sup_torsion_eq_top (p a : ℕ) [Fact p.Prime]
    (K : Type*) [Field K] [NumberField K]
    [IsCyclotomicExtension {p ^ a} ℚ K] :
    NumberField.IsCMField.realUnits K ⊔ NumberField.Units.torsion K = ⊤ :=
  (realUnits_sup_torsion_eq_top_iff K).mpr (primePowerHasseUnitIndex_one p a K)

end TauCeti
