module

public import TauCeti.RingTheory.Trace.EmbeddingsMatrix
public import Mathlib.Analysis.Complex.Basic

/-!
# Replacing cyclotomic frame vectors using trace duality

In a power basis generated by a root of unity, the inverse powers and the scaled trace-dual
vectors can be paired and replaced by their sums. This changes the sum of the two frame
operators by a scalar operator. This permits a change in the length of a cyclotomic tight frame
without rescaling its vectors.

The construction is the trace-dual replacement in `New.Parameters.exists_isTightFrame_coprime`
in `grh/src/New/Derivatives/Vacuum/ShortVectors.lean` of lsernau/grh-lean (commit `72fead1`).
-/

public section

open Algebra Matrix

namespace PowerBasis

open Classical in
/-- Replacing the inverse powers in a cyclotomic power basis and the scaled trace-dual
vectors by their pairwise sums adds twice the real part of the scale to the frame operator.
Here rows of each embeddings matrix are the embedded frame vectors. -/
theorem conjTranspose_mul_self_embeddingsMatrix_inv_add_traceDual
    {K L : Type*} [Field K] [Field L] [Algebra K L] [Algebra K ℂ]
    [FiniteDimensional K L] [Algebra.IsSeparable K L]
    (pb : PowerBasis K L) (hgen : IsOfFinOrder pb.gen) (a : K) :
    let A := embeddingsMatrix K ℂ (fun i ↦ (pb.basis i)⁻¹)
    let B := embeddingsMatrix K ℂ (fun i ↦ algebraMap K L a * pb.basis.traceDual i)
    (A + B)ᴴ * (A + B) = Aᴴ * A + Bᴴ * B +
      (algebraMap K ℂ a + star (algebraMap K ℂ a)) • 1 := by
  intro A B
  have hA : Aᴴ = (embeddingsMatrix K ℂ pb.basis)ᵀ := by
    ext σ i
    have hgen' : ‖σ pb.gen‖ = 1 := (σ.toMonoidHom.isOfFinOrder hgen).norm_eq_one
    have hnorm : ‖σ (pb.basis i)‖ = 1 := by
      simp [pb.basis_eq_pow, norm_pow, hgen']
    simp only [A, conjTranspose_apply, embeddingsMatrix_apply, map_inv₀, Complex.inv_eq_conj hnorm,
      Complex.star_def, starRingEnd_self_apply, transpose_apply]
  have hB : B = (algebraMap K ℂ a) • embeddingsMatrix K ℂ pb.basis.traceDual := by
    ext i σ
    simp [B, smul_eq_mul]
  have hAB : Aᴴ * B = (algebraMap K ℂ a) • 1 := by
    rw [hA, hB, Matrix.mul_smul, pb.basis.transpose_embeddingsMatrix_mul_traceDual ℂ]
  have hBA : Bᴴ * A = star (algebraMap K ℂ a) • 1 := by
    simpa only [conjTranspose_mul, conjTranspose_conjTranspose, conjTranspose_smul,
      conjTranspose_one] using congrArg conjTranspose hAB
  simp only [conjTranspose_add, Matrix.add_mul, Matrix.mul_add, hAB, hBA, add_smul]
  abel

end PowerBasis
