/-!
# Cyclotomic polynomial expansion and norm-one primitive roots

When every prime factor of a positive integer `m` divides `n`, the cyclotomic polynomial
satisfies `Φ_{n * m}(X) = Φ_n(X ^ m)` over any commutative ring. Moreover, in any field
extension `E / K` generated by a primitive `n`-th root of unity `ζ` with `3 ≤ n` and
`Φ_n` irreducible over `K`, the relative norm `Algebra.norm K ζ` equals `1` (and hence
`Algebra.norm K (ζ ^ k) = 1` for every `k : ℕ`).

## Provenance

Adapted from `grh-lean` (<https://github.com/lsernau/grh-lean>, Apache 2.0, Copyright 2026
Anthropic, PBC), commit `72fead102f663d5c7a407964a13dc0cf9d977207`, specifically
`New.Parameters.expand_pow_cyclotomic` and `New.Parameters.norm_zeta_eq_one` in
`grh/src/New/Reduction/Data/FieldsAndPlaces.lean`.
-/

public section

open Polynomial

namespace TauCeti

/-- If `m ≠ 0` and every prime dividing `m` also divides `n`, then
`cyclotomic (n * m) R = expand R m (cyclotomic n R)` over any commutative ring `R`. -/
theorem cyclotomic_mul_eq_expand {R : Type*} [CommRing R] {n m : ℕ} (hm : m ≠ 0)
    (hsub : ∀ p : ℕ, p.Prime → p ∣ m → p ∣ n) :
    cyclotomic (n * m) R = expand R m (cyclotomic n R) := by
  induction m using Nat.recOnPosPrimePosCoprime generalizing n with
  | zero => exact (hm rfl).elim
  | one => simp
  | prime_pow p k hp hk =>
    induction k with
    | zero => simp
    | succ k ih =>
      have hp_dvd : p ∣ n := hsub p hp (dvd_pow_self p (Nat.succ_ne_zero k))
      have hp_dvd' : p ∣ n * p ^ k := dvd_mul_of_dvd_left hp_dvd _
      rw [pow_succ, ← mul_assoc, ← cyclotomic_expand_eq_cyclotomic hp hp_dvd' R]
      rcases k.eq_zero_or_pos with rfl | hk'
      · simp
      · rw [ih hk' (pow_ne_zero k hp.ne_zero)
          (fun q hq hqd ↦ hsub q hq (hqd.trans (pow_dvd_pow p (Nat.le_succ k))))]
        simp [← expand_mul, mul_comm p]
  | coprime a b ha hb _ iha ihb =>
    have ha0 : a ≠ 0 := by omega
    have hb0 : b ≠ 0 := by omega
    have hsuba : ∀ p, p.Prime → p ∣ a → p ∣ n :=
      fun p hp hpa ↦ hsub p hp (hpa.trans (dvd_mul_right a b))
    have hsubb : ∀ p, p.Prime → p ∣ b → p ∣ n * a := fun p hp hpb ↦
      dvd_mul_of_dvd_left (hsub p hp (hpb.trans (dvd_mul_left b a))) a
    rw [← mul_assoc, ihb hb0 hsubb, iha ha0 hsuba, ← expand_mul, mul_comm b a]

/-- In a field extension `E / K` generated by a primitive `n`-th root of unity `ζ` with
`3 ≤ n` and `cyclotomic n K` irreducible over `K`, the relative norm `Algebra.norm K ζ` is `1`. -/
theorem algebra_norm_eq_one_of_isPrimitiveRoot {K E : Type*} [Field K] [Field E] [Algebra K E]
    {n : ℕ} {ζ : E} (hn : 3 ≤ n) (hζ : IsPrimitiveRoot ζ n)
    (hirr : Irreducible (cyclotomic n K)) (hgen : Algebra.adjoin K ({ζ} : Set E) = ⊤) :
    Algebra.norm K ζ = 1 := by
  have hint : IsIntegral K ζ :=
    ⟨X ^ n - 1, monic_X_pow_sub_C 1 (by omega), by simp [hζ.pow_eq_one]⟩
  have hroot : aeval ζ (cyclotomic n K) = 0 := by
    have := hζ.isRoot_cyclotomic (by omega : 0 < n)
    simpa [Polynomial.IsRoot, aeval_def, eval₂_eq_eval_map] using this
  have hmin : minpoly K ζ = cyclotomic n K :=
    (minpoly.eq_of_irreducible_of_monic hirr hroot (cyclotomic.monic n K)).symm
  let pb : PowerBasis K E := (Algebra.adjoin.powerBasis' hint).map
    ((Subalgebra.equivOfEq _ _ hgen).trans Subalgebra.topEquiv)
  have hgen_pb : pb.gen = ζ := by simp [pb]
  have hnorm : Algebra.norm K pb.gen = (-1 : K) ^ pb.dim * (minpoly K pb.gen).coeff 0 :=
    Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
  rw [hgen_pb, hmin, ← pb.natDegree_minpoly, hgen_pb, hmin, natDegree_cyclotomic,
    cyclotomic_coeff_zero K (by omega : 1 < n), (Nat.totient_even (by omega : 2 < n)).neg_one_pow,
    one_mul] at hnorm
  exact hnorm

/-- Under the hypotheses of `algebra_norm_eq_one_of_isPrimitiveRoot`, every natural power
`ζ ^ k` has relative norm `1`. -/
theorem algebra_norm_pow_eq_one_of_isPrimitiveRoot {K E : Type*} [Field K] [Field E] [Algebra K E]
    {n : ℕ} {ζ : E} (hn : 3 ≤ n) (hζ : IsPrimitiveRoot ζ n)
    (hirr : Irreducible (cyclotomic n K)) (hgen : Algebra.adjoin K ({ζ} : Set E) = ⊤) (k : ℕ) :
    Algebra.norm K (ζ ^ k) = 1 := by
  rw [map_pow, algebra_norm_eq_one_of_isPrimitiveRoot hn hζ hirr hgen, one_pow]

end TauCeti
