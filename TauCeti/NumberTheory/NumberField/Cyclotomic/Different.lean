module

public import Mathlib.NumberTheory.NumberField.Cyclotomic.Basic
public import Mathlib.NumberTheory.NumberField.CMField
import Mathlib.NumberTheory.NumberField.Discriminant.Different
import TauCeti.RingTheory.DedekindDomain.Different.Monogenic

/-!
# Different generators of cyclotomic composita

A cyclotomic field has different generated by the derivative of its cyclotomic polynomial
at a primitive root. In a compositum with coprime discriminants, multiply this derivative
by a generator of the other field's different. If the latter generator is a square root of
`-d`, making the derivative real by a norm-one integral factor gives an imaginary generator
and an explicit archimedean size.

The calculation uses the transitivity and coprime base-change formulas for differents
(Neukirch, *Algebraic Number Theory*, Chapter III §2). The CM normalization follows
`New.Parameters.differentIdeal_eq_span_deltaE` in `New/Derivatives/Field/PrimeDecomposition.lean`
of [lsernau/grh-lean](https://github.com/lsernau/grh-lean) (revision `72fead1`).
-/

public section

open Polynomial NumberField NumberField.IsCMField
open scoped NumberField

/-- In an absolute cyclotomic field, the derivative of the cyclotomic polynomial
at an integral primitive root generates the different. -/
theorem IsPrimitiveRoot.differentIdeal_eq_span_aeval_cyclotomic_derivative
    {F : Type*} [Field F] [NumberField F] {n : ℕ} [NeZero n]
    [IsCyclotomicExtension {n} ℚ F] {ζ : F} (hζ : IsPrimitiveRoot ζ n) :
    differentIdeal ℤ (𝓞 F) = Ideal.span {aeval hζ.toInteger (cyclotomic n ℤ).derivative} := by
  rw [TauCeti.differentIdeal_eq_span_aeval_derivative_minpoly ℤ ℚ F (𝓞 F) hζ.toInteger
      (IsCyclotomicExtension.Rat.adjoin_singleton_eq_top hζ), ← RingOfIntegers.minpoly_coe,
    hζ.coe_toInteger, ← cyclotomic_eq_minpoly hζ (NeZero.pos n)]

namespace IsPrimitiveRoot

/-- For a compositum of fields of coprime discriminant, adjoining a primitive root from the
cyclotomic factor multiplies the different generator of the base by the cyclotomic derivative. -/
theorem differentIdeal_eq_span_cyclotomic_derivative_mul
    {E : Type*} [Field E] [NumberField E] {F K : IntermediateField ℚ E}
    {n : ℕ} [NeZero n] [IsCyclotomicExtension {n} ℚ F] {ζ : F} (hζ : IsPrimitiveRoot ζ n)
    (hsup : F ⊔ K = ⊤) (hcop : IsCoprime (discr F) (discr K)) {b : 𝓞 K}
    (hb : differentIdeal ℤ (𝓞 K) = Ideal.span {b}) :
    differentIdeal ℤ (𝓞 E) = Ideal.span
      {aeval (algebraMap (𝓞 F) (𝓞 E) hζ.toInteger) (cyclotomic n ℤ).derivative *
        algebraMap (𝓞 K) (𝓞 E) b} := by
  let : IsGalois ℚ F := IsCyclotomicExtension.isGalois {n} ℚ F
  let : Algebra (FractionRing (𝓞 F)) (FractionRing (𝓞 E)) := FractionRing.liftAlgebra _ _
  let : Algebra (FractionRing (𝓞 K)) (FractionRing (𝓞 E)) := FractionRing.liftAlgebra _ _
  have hld := linearDisjoint_of_isGalois_isCoprime_discr (L := E) F K hcop
  have hrel := IsDedekindDomain.differentIdeal_eq_map_differentIdeal ℤ (𝓞 E)
    (𝓞 K) (𝓞 F) (F₁ := K) (F₂ := F) hld.symm (by rwa [sup_comm])
    (isCoprime_differentIdeal_of_isCoprime_discr E hcop.symm)
  rw [differentIdeal_eq_differentIdeal_mul_differentIdeal ℤ (𝓞 K) (𝓞 E), hrel,
    hζ.differentIdeal_eq_span_aeval_cyclotomic_derivative, hb, Ideal.map_span, Ideal.map_span,
    Set.image_singleton, Set.image_singleton, Ideal.span_singleton_mul_span_singleton,
    aeval_algebraMap_apply]

/-- Given a norm-one integral correction making the cyclotomic derivative real, the
corrected product with the quadratic different generator is purely imaginary. It generates
the absolute different, and its value at each infinite place is the value of the
uncorrected derivative times `√d`. -/
theorem differentIdeal_eq_span_of_real_cyclotomic_derivative_mul
    {E : Type*} [Field E] [NumberField E] [IsCMField E] {F K : IntermediateField ℚ E}
    {n : ℕ} [NeZero n] [IsCyclotomicExtension {n} ℚ F] {ζ : F} (hζ : IsPrimitiveRoot ζ n)
    (hsup : F ⊔ K = ⊤) (hcop : IsCoprime (discr F) (discr K)) {b : 𝓞 K} {d : ℕ}
    (hb : differentIdeal ℤ (𝓞 K) = Ideal.span {b}) (hb_sq : b ^ 2 = -(d : 𝓞 K))
    (c : 𝓞 E) (hc : ringOfIntegersComplexConj E c * c = 1) :
    let a := aeval (algebraMap (𝓞 F) (𝓞 E) hζ.toInteger) (cyclotomic n ℤ).derivative
    let b' := algebraMap (𝓞 K) (𝓞 E) b
    let δ := (c * a) * b'
    ringOfIntegersComplexConj E (c * a) = c * a →
      differentIdeal ℤ (𝓞 E) = Ideal.span {δ} ∧ ringOfIntegersComplexConj E δ = -δ ∧
        ∀ v : InfinitePlace E, v (δ : E) = v (a : E) * Real.sqrt d := by
  intro a b' δ hreal
  have hb'_sq : b' ^ 2 = -(d : 𝓞 E) := by
    simpa only [b', map_pow, map_neg, map_natCast] using
      congrArg (algebraMap (𝓞 K) (𝓞 E)) hb_sq
  have hbs (φ : E →+* ℂ) : (φ (b' : E)) ^ 2 = -(d : ℂ) := by
    simpa only [map_pow, map_neg, map_natCast, RingHom.comp_apply,
      RingOfIntegers.coe_eq_algebraMap] using congrArg (φ.comp (algebraMap (𝓞 E) E)) hb'_sq
  have hbnorm (φ : E →+* ℂ) : ‖φ (b' : E)‖ ^ 2 = d := by
    rw [← norm_pow, hbs φ, norm_neg, Complex.norm_natCast]
  have hbconj : ringOfIntegersComplexConj E b' = -b' := by
    let φ := (Classical.choice (inferInstance : Nonempty (E →+* ℂ)))
    apply RingOfIntegers.ext
    apply φ.injective
    rw [coe_ringOfIntegersComplexConj, complexEmbedding_complexConj]
    simp only [RingOfIntegers.coe_eq_algebraMap, map_neg]
    by_cases hz : φ (b' : E) = 0
    · simp [hz]
    · apply mul_left_cancel₀ hz
      rw [Complex.mul_conj', mul_neg, ← pow_two, hbs, neg_neg]
      exact_mod_cast hbnorm φ
  refine ⟨?_, ?_, ?_⟩
  · have hunit : IsUnit c := ⟨⟨c, ringOfIntegersComplexConj E c, mul_comm c _ ▸ hc, hc⟩, rfl⟩
    rw [hζ.differentIdeal_eq_span_cyclotomic_derivative_mul hsup hcop hb]
    -- Remove the correction only after collecting the two factors of the different.
    simp only [δ, a, b', mul_assoc, Ideal.span_singleton_mul_left_unit hunit]
  · dsimp only [δ]
    rw [map_mul, hreal, hbconj, mul_neg]
  · intro v
    have hc' : (starRingEnd ℂ) (v.embedding (c : E)) * v.embedding (c : E) = 1 := by
      simpa only [map_mul, map_one, RingHom.comp_apply, ← RingOfIntegers.coe_eq_algebraMap,
        coe_ringOfIntegersComplexConj, complexEmbedding_complexConj] using
        congrArg (v.embedding.comp (algebraMap (𝓞 E) E)) hc
    have hcn : ‖v.embedding (c : E)‖ = 1 := by
      have h := congrArg norm hc'
      rw [norm_mul, Complex.norm_conj, norm_one, ← sq] at h
      exact (sq_eq_sq₀ (norm_nonneg _) zero_le_one).mp (by simpa using h)
    have hbn : ‖v.embedding (b' : E)‖ = Real.sqrt d := by
      rw [← hbnorm v.embedding, Real.sqrt_sq (norm_nonneg _)]
    simp only [δ, ← v.norm_embedding_eq, ← RingOfIntegers.coe_eq_algebraMap, map_mul, norm_mul,
      hcn, hbn, one_mul]

end IsPrimitiveRoot
