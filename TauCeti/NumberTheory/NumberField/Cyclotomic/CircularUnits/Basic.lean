/-!
# Circular numbers and circular units

Circular numbers form a subgroup of the multiplicative group of a field, generated by a
root of unity, the sign, and its nonzero differences from 1. Circular units are the
preimage of this group in the integral units. Inverses are taken before this preimage:
ratios of nonunit differences can be units.

We prove independence of the primitive root, stability under field automorphisms, and
membership of the integral cyclotomic ratios. The real circular units here are the
intersection with the maximal real subfield, not the group generated by norms into it.

The convention follows Rodrigues Jacinto–Williams, *An introduction to p-adic L-functions*,
Definition 11.6 and Lemma 12.18.
-/

public section

noncomputable section

open NumberField

namespace TauCeti

section Field

variable {K L : Type*} [Field K] [Field L] {ζ η : K} {N : ℕ}

/-- Circular numbers: the subgroup generated by the sign, the root, and all its
nonzero differences from 1. The definition also makes sense for an arbitrary element. -/
def cyclotomicNumbers (ζ : K) (N : ℕ) : Subgroup Kˣ :=
  Subgroup.closure {u | (u : K) = -1 ∨ (u : K) = ζ ∨
    ∃ b : ℕ, 0 < b ∧ b < N ∧ (u : K) = 1 - ζ ^ b}

/-- To contain all circular numbers, it is necessary and sufficient to contain their
sign, root and nonzero-difference generators. -/
theorem cyclotomicNumbers_le_iff (H : Subgroup Kˣ) :
    cyclotomicNumbers ζ N ≤ H ↔
      (∀ u : Kˣ, (u : K) = -1 → u ∈ H) ∧
      (∀ u : Kˣ, (u : K) = ζ → u ∈ H) ∧
      (∀ (b : ℕ), 0 < b → b < N → ∀ u : Kˣ, (u : K) = 1 - ζ ^ b → u ∈ H) := by
  rw [cyclotomicNumbers, Subgroup.closure_le]
  constructor
  · intro h
    exact ⟨fun u hu ↦ h (Or.inl hu), fun u hu ↦ h (Or.inr (Or.inl hu)),
      fun b hb hbN u hu ↦ h (Or.inr (Or.inr ⟨b, hb, hbN, hu⟩))⟩
  · rintro ⟨hs, hr, hd⟩ u (hu | hu | ⟨b, hb, hbN, hu⟩)
    · exact hs u hu
    · exact hr u hu
    · exact hd b hb hbN u hu

/-- The sign is a circular number, including at conductors 1 and 2. -/
@[simp] theorem neg_one_mem_cyclotomicNumbers (ζ : K) (N : ℕ) :
    -1 ∈ cyclotomicNumbers ζ N :=
  Subgroup.subset_closure (Or.inl (by simp))

/-- The root is a circular number whenever it is represented by a unit. -/
theorem mem_cyclotomicNumbers_of_coe_eq {u : Kˣ} (hu : (u : K) = ζ) :
    u ∈ cyclotomicNumbers ζ N :=
  Subgroup.subset_closure (Or.inr (Or.inl hu))

/-- Every nonzero difference in the defining exponent range is a circular number. -/
theorem mem_cyclotomicNumbers_of_coe_eq_one_sub_pow {u : Kˣ} {b : ℕ}
    (hb : 0 < b) (hbN : b < N) (hu : (u : K) = 1 - ζ ^ b) :
    u ∈ cyclotomicNumbers ζ N :=
  Subgroup.subset_closure (Or.inr (Or.inr ⟨b, hb, hbN, hu⟩))

/-- Exponents may be reduced modulo the order before testing a nonzero difference. -/
theorem mem_cyclotomicNumbers_of_coe_eq_one_sub_pow_of_pow_eq_one
    (hζ : ζ ^ N = 1) (hN : 0 < N) {u : Kˣ} (b : ℕ)
    (hu : (u : K) = 1 - ζ ^ b) : u ∈ cyclotomicNumbers ζ N := by
  have hp : ζ ^ (b % N) = ζ ^ b :=
    pow_eq_pow_of_modEq (Nat.mod_modEq b N) hζ
  have hb : 0 < b % N := by
    by_contra h
    have hz : b % N = 0 := by omega
    have : (u : K) = 0 := by simpa [hz] using hu.trans (congrArg (1 - ·) hp.symm)
    exact u.ne_zero this
  exact mem_cyclotomicNumbers_of_coe_eq_one_sub_pow hb (Nat.mod_lt b hN) (hu.trans
    (congrArg (1 - ·) hp.symm))

/-- Any other `N`-th root generates a subgroup of the circular numbers of a primitive root. -/
theorem _root_.IsPrimitiveRoot.cyclotomicNumbers_le_of_pow_eq_one [NeZero N]
    (hζ : IsPrimitiveRoot ζ N)
    (hη : η ^ N = 1) : cyclotomicNumbers η N ≤ cyclotomicNumbers ζ N := by
  obtain ⟨a, -, ha⟩ := hζ.eq_pow_of_pow_eq_one hη
  let z : Kˣ := (hζ.isUnit (NeZero.ne N)).unit
  have hz : (z : K) = ζ := IsUnit.unit_spec _
  have hzmem : z ∈ cyclotomicNumbers ζ N := mem_cyclotomicNumbers_of_coe_eq hz
  refine (Subgroup.closure_le _).mpr ?_
  intro u hu
  rcases hu with hu | hu | ⟨b, _, _, hu⟩
  · have : u = -1 := Units.ext (by simpa using hu)
    simp [this]
  · have : u = z ^ a := Units.ext (by simpa [hz, ha] using hu)
    simpa [this] using (cyclotomicNumbers ζ N).pow_mem hzmem a
  · apply mem_cyclotomicNumbers_of_coe_eq_one_sub_pow_of_pow_eq_one
      hζ.pow_eq_one (NeZero.pos N) (a * b)
    simpa [ha, pow_mul] using hu

/-- The circular-number subgroup is independent of the primitive root chosen. -/
theorem _root_.IsPrimitiveRoot.cyclotomicNumbers_eq [NeZero N] (hζ : IsPrimitiveRoot ζ N)
    (hη : IsPrimitiveRoot η N) : cyclotomicNumbers ζ N = cyclotomicNumbers η N :=
  le_antisymm (hη.cyclotomicNumbers_le_of_pow_eq_one hζ.pow_eq_one)
    (hζ.cyclotomicNumbers_le_of_pow_eq_one hη.pow_eq_one)

/-- A field embedding maps circular numbers into the circular numbers of the image root. -/
theorem _root_.RingHom.map_mem_cyclotomicNumbers (f : K →+* L) {u : Kˣ}
    (hu : u ∈ cyclotomicNumbers ζ N) :
    Units.map f.toMonoidHom u ∈ cyclotomicNumbers (f ζ) N := by
  refine ((Subgroup.closure_le _).mpr ?_ : cyclotomicNumbers ζ N ≤
    (cyclotomicNumbers (f ζ) N).comap (Units.map f.toMonoidHom)) hu
  intro v hv
  apply Subgroup.subset_closure
  rcases hv with hv | hv | ⟨b, hb, hbN, hv⟩
  · exact Or.inl (by simpa using congrArg f hv)
  · exact Or.inr (Or.inl (by simpa using congrArg f hv))
  · exact Or.inr (Or.inr ⟨b, hb, hbN, by simpa using congrArg f hv⟩)

/-- Circular numbers are stable under every field automorphism. -/
theorem _root_.IsPrimitiveRoot.map_mem_cyclotomicNumbers_iff [NeZero N] (hζ : IsPrimitiveRoot ζ N)
    (σ : K ≃+* K) (u : Kˣ) :
    Units.map σ.toMonoidHom u ∈ cyclotomicNumbers ζ N ↔
      u ∈ cyclotomicNumbers ζ N := by
  have hm (σ : K ≃+* K) {u : Kˣ} (hu : u ∈ cyclotomicNumbers ζ N) :
      Units.map σ.toMonoidHom u ∈ cyclotomicNumbers ζ N := by
    have he := hζ.cyclotomicNumbers_eq (hζ.map_of_injective σ.injective)
    rw [he]
    exact σ.toRingHom.map_mem_cyclotomicNumbers hu
  refine ⟨fun hu ↦ ?_, hm σ⟩
  have he : Units.map σ.symm.toMonoidHom (Units.map σ.toMonoidHom u) = u := by
    ext
    exact σ.symm_apply_apply _
  simpa only [he] using hm σ.symm hu

/-- A nonzero cyclotomic ratio is a circular number. No integrality is asserted here. -/
theorem mem_cyclotomicNumbers_of_coe_eq_div (hζ : ζ ^ N = 1) (hN : 0 < N)
    {b : ℕ} {u : Kˣ} (hu : (u : K) = (ζ ^ b - 1) / (ζ - 1)) :
    u ∈ cyclotomicNumbers ζ N := by
  have hne : (ζ ^ b - 1) / (ζ - 1) ≠ 0 := hu ▸ u.ne_zero
  obtain ⟨hb, hζ1⟩ := div_ne_zero_iff.mp hne
  let v := Units.mk0 (1 - ζ ^ b) (sub_ne_zero.mpr (sub_ne_zero.mp hb).symm)
  let w := Units.mk0 (1 - ζ) (sub_ne_zero.mpr (sub_ne_zero.mp hζ1).symm)
  have hv : v ∈ cyclotomicNumbers ζ N :=
    mem_cyclotomicNumbers_of_coe_eq_one_sub_pow_of_pow_eq_one hζ hN b rfl
  have hw : w ∈ cyclotomicNumbers ζ N :=
    mem_cyclotomicNumbers_of_coe_eq_one_sub_pow_of_pow_eq_one hζ hN 1 (by simp [w])
  have he : u = v / w := by
    ext
    simp only [Units.val_div_eq_div_val, v, w, Units.val_mk0, hu]
    simpa only [neg_sub] using (neg_div_neg_eq (1 - ζ ^ b) (1 - ζ))
  rw [he]
  exact (cyclotomicNumbers ζ N).div_mem hv hw

end Field

section Units

variable (K : Type*) [Field K]

/-- Integral circular units, obtained by intersecting circular numbers with integral units. -/
def cyclotomicUnits (ζ : K) (N : ℕ) : Subgroup (𝓞 K)ˣ :=
  (cyclotomicNumbers ζ N).comap (Units.map (algebraMap (𝓞 K) K).toMonoidHom)

/-- The real intersection of the full circular-unit group. This is not the norm-generated
circular-unit group of a real abelian field. -/
def realCyclotomicUnits (ζ : K) (N : ℕ) :
    Subgroup (𝓞 (NumberField.maximalRealSubfield K))ˣ :=
  (cyclotomicUnits K ζ N).comap
    (Units.map (algebraMap (𝓞 (NumberField.maximalRealSubfield K)) (𝓞 K)).toMonoidHom)

variable {K} {ζ η : K} {N : ℕ}

/-- An integral unit is circular exactly when its field image is a circular number. -/
@[simp] theorem mem_cyclotomicUnits_iff (u : (𝓞 K)ˣ) :
    u ∈ cyclotomicUnits K ζ N ↔
      Units.map (algebraMap (𝓞 K) K).toMonoidHom u ∈ cyclotomicNumbers ζ N := Iff.rfl

/-- Real circular units are tested by their images among full-field integral units. -/
@[simp] theorem mem_realCyclotomicUnits_iff
    (u : (𝓞 (NumberField.maximalRealSubfield K))ˣ) :
    u ∈ realCyclotomicUnits K ζ N ↔
      Units.map (algebraMap (𝓞 (NumberField.maximalRealSubfield K)) (𝓞 K)).toMonoidHom u ∈
        cyclotomicUnits K ζ N := Iff.rfl

/-- The integral subgroup does not depend on the choice of primitive root. -/
theorem _root_.IsPrimitiveRoot.cyclotomicUnits_eq [NeZero N] (hζ : IsPrimitiveRoot ζ N)
    (hη : IsPrimitiveRoot η N) : cyclotomicUnits K ζ N = cyclotomicUnits K η N := by
  simp only [cyclotomicUnits, hζ.cyclotomicNumbers_eq hη]

/-- The real intersection does not depend on the choice of primitive root. -/
theorem _root_.IsPrimitiveRoot.realCyclotomicUnits_eq [NeZero N] (hζ : IsPrimitiveRoot ζ N)
    (hη : IsPrimitiveRoot η N) : realCyclotomicUnits K ζ N = realCyclotomicUnits K η N := by
  simp only [realCyclotomicUnits, hζ.cyclotomicUnits_eq hη]

/-- Galois stability of the integral circular units. -/
theorem _root_.IsPrimitiveRoot.map_mem_cyclotomicUnits_iff [NeZero N] (hζ : IsPrimitiveRoot ζ N)
    (σ : K ≃+* K) (u : (𝓞 K)ˣ) :
    Units.map (RingOfIntegers.mapRingHom σ.toRingHom).toMonoidHom u ∈
      cyclotomicUnits K ζ N ↔ u ∈ cyclotomicUnits K ζ N := by
  rw [mem_cyclotomicUnits_iff, mem_cyclotomicUnits_iff]
  have he : Units.map (algebraMap (𝓞 K) K).toMonoidHom
      (Units.map (RingOfIntegers.mapRingHom σ.toRingHom).toMonoidHom u) =
      Units.map σ.toMonoidHom (Units.map (algebraMap (𝓞 K) K).toMonoidHom u) := by
    ext
    simp [RingOfIntegers.mapRingHom_apply]
  rw [he, hζ.map_mem_cyclotomicNumbers_iff]

/-- For a primitive root of order at least two and an exponent coprime to its order,
the cyclotomic ratio is the image of an integral circular unit. -/
theorem _root_.IsPrimitiveRoot.exists_mem_cyclotomicUnits_coe_eq_div (hζ : IsPrimitiveRoot ζ N)
    (hN : 2 ≤ N) {b : ℕ} (hb : b.Coprime N) :
    ∃ u ∈ cyclotomicUnits K ζ N,
      algebraMap (𝓞 K) K (u : 𝓞 K) = (ζ ^ b - 1) / (ζ - 1) := by
  let z : 𝓞 K := ⟨ζ, hζ.isIntegral (by omega)⟩
  have hz : IsPrimitiveRoot z N :=
    hζ.of_map_of_injective (f := algebraMap (𝓞 K) K) RingOfIntegers.coe_injective
  let u : (𝓞 K)ˣ := (hz.geom_sum_isUnit hN hb).unit
  have hu : algebraMap (𝓞 K) K (u : 𝓞 K) = ∑ i ∈ Finset.range b, ζ ^ i := by
    rw [IsUnit.unit_spec, map_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [map_pow]
    rfl
  have hratio : algebraMap (𝓞 K) K (u : 𝓞 K) = (ζ ^ b - 1) / (ζ - 1) := by
    rw [hu, eq_div_iff (hζ.sub_one_ne_zero (by omega))]
    exact geom_sum_mul ζ b
  refine ⟨u, ?_, hratio⟩
  rw [mem_cyclotomicUnits_iff]
  exact mem_cyclotomicNumbers_of_coe_eq_div hζ.pow_eq_one (by omega) hratio

end Units

end TauCeti
