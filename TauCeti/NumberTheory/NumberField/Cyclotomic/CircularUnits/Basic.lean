/-!
# Cyclotomic numbers and circular units

Let `ζ` be an `N`-th root of unity in a ring `R` or number field `K`. This file defines the group of
cyclotomic numbers `TauCeti.cyclotomicNumbers ζ N ≤ Rˣ`, the full circular unit group
`TauCeti.cyclotomicUnits K ζ N ≤ (𝓞 K)ˣ`, and its real intersection
`TauCeti.realCyclotomicUnits K ζ N ≤ (𝓞 K⁺)ˣ`.

We establish the basic structural properties needed throughout the theory of circular units:
equational characterizations, independence of the choice of primitive `N`-th root of unity,
functoriality of the maximal real subfield `K⁺` and its unit group `(𝓞 K⁺)ˣ` under ring
isomorphisms, Galois stability of all three groups, and the degree-`1` base case where every
integral unit is circular.

## Main definitions

* `TauCeti.cyclotomicNumbers`: subgroup of `Rˣ` generated by `-1`, `ζ`, and `1 - ζ ^ b` for
  `0 < b < N`.
* `TauCeti.cyclotomicUnits`: preimage of `cyclotomicNumbers ζ N` in `(𝓞 K)ˣ`.
* `TauCeti.realCyclotomicUnits`: preimage of `cyclotomicUnits K ζ N` in `(𝓞 K⁺)ˣ`.
* `TauCeti.maximalRealSubfieldRingEquiv`: restriction of a ring isomorphism `K ≃+* L` to
  `K⁺ ≃+* L⁺`.
* `TauCeti.realUnitsMapEquiv`: induced group isomorphism `(𝓞 K⁺)ˣ ≃* (𝓞 L⁺)ˣ`.

## Main results

* `TauCeti.cyclotomicNumbers_eq_of_isPrimitiveRoot`,
  `TauCeti.cyclotomicUnits_eq_of_isPrimitiveRoot`,
  `TauCeti.realCyclotomicUnits_eq_of_isPrimitiveRoot`: independence of the choice of primitive
  `N`-th root of unity (`0 < N`).
* `TauCeti.cyclotomicNumbers_comap_ringAut`, `TauCeti.cyclotomicUnits_comap_ringAut`,
  `TauCeti.realCyclotomicUnits_comap_ringAut`: stability under every ring automorphism
  `σ : K ≃+* K`.
* `TauCeti.map_realCyclotomicUnits_eq_inf_realUnits`: the image of `realCyclotomicUnits K ζ N` in
  `(𝓞 K)ˣ` is `cyclotomicUnits K ζ N ⊓ realUnits K`.
* `TauCeti.cyclotomicUnits_eq_top_of_finrank_eq_one` and
  `TauCeti.realCyclotomicUnits_eq_top_of_finrank_eq_one`: when `[K : ℚ] = 1`, all integral units
  are circular.

## References

* L. C. Washington, *Introduction to Cyclotomic Fields*, 2nd ed., Springer (1997), Chapter 8.
* R. Sharifi, *Iwasawa Theory*, Chapter 4.
-/

public section

open NumberField NumberField.IsCMField

open scoped NumberField

namespace TauCeti

/-! ### Cyclotomic numbers, circular units, and real circular units -/

/-- The subgroup of `Rˣ` generated by `-1`, `ζ`, and all units of the form `1 - ζ ^ b` for
`0 < b < N`. Taking the subgroup inside `Rˣ` permits inverses before intersecting with integral
units. -/
def cyclotomicNumbers {R : Type*} [Ring R] (ζ : R) (N : ℕ) : Subgroup Rˣ :=
  Subgroup.closure {u : Rˣ | (u : R) = -1 ∨ (u : R) = ζ ∨
    ∃ b : ℕ, 0 < b ∧ b < N ∧ (u : R) = 1 - ζ ^ b}

/-- The integral units of `K` whose images in `Kˣ` belong to `cyclotomicNumbers ζ N`. -/
def cyclotomicUnits (K : Type*) [Field K] (ζ : K) (N : ℕ) : Subgroup (𝓞 K)ˣ :=
  (cyclotomicNumbers ζ N).comap (Units.map (algebraMap (𝓞 K) K).toMonoidHom)

/-- The preimage of `cyclotomicUnits K ζ N` in the unit group `(𝓞 K⁺)ˣ` of the maximal real
subfield `K⁺`. -/
def realCyclotomicUnits (K : Type*) [Field K] (ζ : K) (N : ℕ) :
    Subgroup (𝓞 (maximalRealSubfield K))ˣ :=
  (cyclotomicUnits K ζ N).comap
    (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom)

theorem cyclotomicNumbers_eq_closure {R : Type*} [Ring R] (ζ : R) (N : ℕ) :
    cyclotomicNumbers ζ N =
      Subgroup.closure {u : Rˣ | (u : R) = -1 ∨ (u : R) = ζ ∨
        ∃ b : ℕ, 0 < b ∧ b < N ∧ (u : R) = 1 - ζ ^ b} := by
  rfl

theorem cyclotomicUnits_eq_comap (K : Type*) [Field K] (ζ : K) (N : ℕ) :
    cyclotomicUnits K ζ N =
      (cyclotomicNumbers ζ N).comap (Units.map (algebraMap (𝓞 K) K).toMonoidHom) := by
  rfl

theorem realCyclotomicUnits_eq_comap (K : Type*) [Field K] (ζ : K) (N : ℕ) :
    realCyclotomicUnits K ζ N =
      (cyclotomicUnits K ζ N).comap
        (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) := by
  rfl

section CyclotomicNumbers

variable {R : Type*} [Ring R]

theorem neg_one_mem_cyclotomicNumbers (ζ : R) (N : ℕ) :
    (-1 : Rˣ) ∈ cyclotomicNumbers ζ N :=
  Subgroup.subset_closure (Or.inl (by simp))

theorem mem_cyclotomicNumbers_of_eq {ζ : R} {N : ℕ} {u : Rˣ} (hu : (u : R) = ζ) :
    u ∈ cyclotomicNumbers ζ N :=
  Subgroup.subset_closure (Or.inr (Or.inl hu))

theorem one_sub_pow_mem_cyclotomicNumbers {ζ : R} {N b : ℕ} (hb0 : 0 < b) (hbN : b < N)
    {u : Rˣ} (hu : (u : R) = 1 - ζ ^ b) : u ∈ cyclotomicNumbers ζ N :=
  Subgroup.subset_closure (Or.inr (Or.inr ⟨b, hb0, hbN, hu⟩))

theorem pow_sub_one_mem_cyclotomicNumbers {ζ : R} {N b : ℕ} (hb0 : 0 < b) (hbN : b < N)
    {u : Rˣ} (hu : (u : R) = ζ ^ b - 1) : u ∈ cyclotomicNumbers ζ N := by
  have hneg : (-u : Rˣ) ∈ cyclotomicNumbers ζ N :=
    one_sub_pow_mem_cyclotomicNumbers hb0 hbN (by simp [hu])
  have : u = (-1 : Rˣ) * (-u) := by ext; simp
  rw [this]
  exact mul_mem (neg_one_mem_cyclotomicNumbers ζ N) hneg

/-- For conductor `N = 1` and `ζ = 1`, `cyclotomicNumbers 1 1` is generated by `-1`. -/
theorem cyclotomicNumbers_one :
    cyclotomicNumbers (1 : R) 1 = Subgroup.closure {(-1 : Rˣ)} := by
  apply le_antisymm
  · rw [cyclotomicNumbers, Subgroup.closure_le]
    rintro u (hu | hu | ⟨b, hb0, hb1, _⟩)
    · have : u = -1 := Units.ext (by simpa using hu)
      rw [this]
      exact Subgroup.subset_closure rfl
    · have : u = 1 := Units.ext hu
      rw [this]
      exact one_mem _
    · omega
  · rw [Subgroup.closure_le, Set.singleton_subset_iff]
    exact neg_one_mem_cyclotomicNumbers 1 1

/-- Any ring isomorphism transports `cyclotomicNumbers ζ N` to `cyclotomicNumbers (σ ζ) N`. -/
theorem cyclotomicNumbers_map_ringEquiv {S : Type*} [Ring S] (σ : R ≃+* S) (ζ : R) (N : ℕ) :
    (cyclotomicNumbers ζ N).map (Units.mapEquiv σ.toMulEquiv).toMonoidHom =
      cyclotomicNumbers (σ ζ) N := by
  rw [cyclotomicNumbers, cyclotomicNumbers, MonoidHom.map_closure]
  congr 1
  ext v
  simp only [Set.mem_image, Set.mem_ofPred_eq, MulEquiv.coe_toMonoidHom]
  constructor
  · rintro ⟨u, hu | hu | ⟨b, hb0, hbN, hu⟩, rfl⟩
    · left
      simp [hu]
    · right; left
      simp [hu]
    · right; right
      exact ⟨b, hb0, hbN, by simp [hu]⟩
  · intro hv
    refine ⟨(Units.mapEquiv σ.toMulEquiv).symm v, ?_, MulEquiv.apply_symm_apply _ v⟩
    rcases hv with hv | hv | ⟨b, hb0, hbN, hv⟩
    · left
      apply σ.injective
      simpa using hv
    · right; left
      apply σ.injective
      simpa using hv
    · right; right
      refine ⟨b, hb0, hbN, σ.injective ?_⟩
      simpa using hv

end CyclotomicNumbers

section CyclotomicNumbersField

variable {K : Type*} [Field K]

/-- For conductor `N = 2` and `ζ = -1` (when `2 ≠ 0` in `K`), `cyclotomicNumbers (-1) 2` is
generated by `-1` and `2`. -/
theorem cyclotomicNumbers_two_neg_one (h2 : (2 : K) ≠ 0) :
    cyclotomicNumbers (-1 : K) 2 = Subgroup.closure {(-1 : Kˣ), Units.mk0 (2 : K) h2} := by
  apply le_antisymm
  · rw [cyclotomicNumbers, Subgroup.closure_le]
    rintro u (hu | hu | ⟨b, hb0, hb2, hu⟩)
    · exact Subgroup.subset_closure (Or.inl (Units.ext (by simpa using hu)))
    · exact Subgroup.subset_closure (Or.inl (Units.ext (by simpa using hu)))
    · have hb : b = 1 := by omega
      subst hb
      have hu2 : (u : K) = 2 := by rw [hu]; ring
      exact Subgroup.subset_closure (Or.inr (Units.ext (by simpa using hu2)))
  · rw [Subgroup.closure_le]
    rintro u (rfl | rfl)
    · exact neg_one_mem_cyclotomicNumbers (-1) 2
    · exact one_sub_pow_mem_cyclotomicNumbers (b := 1) (by omega) (by omega) (by norm_num)

theorem zpow_mem_cyclotomicNumbers {ζ : K} {N : ℕ} (hζ0 : ζ ≠ 0) (b : ℤ) :
    Units.mk0 (ζ ^ b) (zpow_ne_zero b hζ0) ∈ cyclotomicNumbers ζ N := by
  have hζ : Units.mk0 ζ hζ0 ∈ cyclotomicNumbers ζ N := mem_cyclotomicNumbers_of_eq rfl
  have hpow : (Units.mk0 ζ hζ0) ^ b ∈ cyclotomicNumbers ζ N := zpow_mem hζ b
  convert hpow using 1
  ext
  simp

theorem one_sub_zpow_mem_cyclotomicNumbers {ζ : K} {N : ℕ} (hζN : ζ ^ N = 1) (hN : 0 < N)
    {b : ℤ} (hb : ¬ (N : ℤ) ∣ b) (hne : 1 - ζ ^ b ≠ 0) :
    Units.mk0 (1 - ζ ^ b) hne ∈ cyclotomicNumbers ζ N := by
  set r : ℕ := (b % (N : ℤ)).toNat
  have hnn : 0 ≤ b % (N : ℤ) := Int.emod_nonneg b (by positivity)
  have hcast : (r : ℤ) = b % (N : ℤ) := Int.toNat_of_nonneg hnn
  have hrlt : r < N := by
    have hlt : b % (N : ℤ) < N := Int.emod_lt_of_pos b (by positivity)
    omega
  have hrpos : 0 < r := by
    by_contra h0
    have hmod : b % (N : ℤ) = 0 := by omega
    exact hb (Int.dvd_of_emod_eq_zero hmod)
  have hpow : ζ ^ b = ζ ^ r := by
    have hζ0 : ζ ≠ 0 := fun h0 ↦ by simp [h0, zero_pow hN.ne'] at hζN
    have huN : (Units.mk0 ζ hζ0) ^ N = 1 := Units.ext (by simp [hζN])
    have hmod := congrArg Units.val (zpow_eq_zpow_emod' b huN)
    simpa [← hcast] using hmod
  exact one_sub_pow_mem_cyclotomicNumbers hrpos hrlt (by simp [hpow])

theorem zpow_sub_one_mem_cyclotomicNumbers {ζ : K} {N : ℕ} (hζN : ζ ^ N = 1) (hN : 0 < N)
    {b : ℤ} (hb : ¬ (N : ℤ) ∣ b) (hne : ζ ^ b - 1 ≠ 0) :
    Units.mk0 (ζ ^ b - 1) hne ∈ cyclotomicNumbers ζ N := by
  have hne' : 1 - ζ ^ b ≠ 0 := sub_ne_zero.mpr (sub_ne_zero.mp hne).symm
  have h1 := one_sub_zpow_mem_cyclotomicNumbers hζN hN hb hne'
  have hEq : Units.mk0 (ζ ^ b - 1) hne = (-1 : Kˣ) * Units.mk0 (1 - ζ ^ b) hne' := by
    ext
    simp
  rw [hEq]
  exact mul_mem (neg_one_mem_cyclotomicNumbers ζ N) h1

/-- **Independence of primitive root**: for `0 < N`, `cyclotomicNumbers ζ N` does not depend on the
choice of primitive `N`-th root of unity `ζ`. -/
theorem cyclotomicNumbers_eq_of_isPrimitiveRoot {ζ η : K} {N : ℕ} (hN : 0 < N)
    (hζ : IsPrimitiveRoot ζ N) (hη : IsPrimitiveRoot η N) :
    cyclotomicNumbers ζ N = cyclotomicNumbers η N := by
  have : NeZero N := ⟨hN.ne'⟩
  suffices hle : ∀ {α β : K}, IsPrimitiveRoot α N → IsPrimitiveRoot β N →
      cyclotomicNumbers α N ≤ cyclotomicNumbers β N from
    le_antisymm (hle hζ hη) (hle hη hζ)
  intro α β hα hβ
  rw [cyclotomicNumbers, Subgroup.closure_le]
  have hβ0 : β ≠ 0 := hβ.ne_zero hN.ne'
  obtain ⟨k, _, hk⟩ := hβ.eq_pow_of_pow_eq_one hα.pow_eq_one
  rintro u (hu | hu | ⟨b, hb0, hbN, hu⟩)
  · have : u = -1 := Units.ext (by simpa using hu)
    rw [this]
    exact neg_one_mem_cyclotomicNumbers β N
  · have hEq : u = Units.mk0 (β ^ (k : ℤ)) (zpow_ne_zero k hβ0) := Units.ext (by simp [hu, hk])
    rw [hEq]
    exact zpow_mem_cyclotomicNumbers hβ0 k
  · have hpow : α ^ b = β ^ ((k * b : ℕ) : ℤ) := by
      rw [← hk, ← pow_mul, zpow_natCast]
    have hndvd : ¬ (N : ℤ) ∣ ((k * b : ℕ) : ℤ) := by
      intro hdvd
      have h1 : α ^ b = 1 := by
        rw [hpow]
        exact (hβ.zpow_eq_one_iff_dvd _).mpr hdvd
      have hNdvd : N ∣ b := hα.dvd_of_pow_eq_one b h1
      have := Nat.le_of_dvd hb0 hNdvd
      omega
    have hne : 1 - β ^ ((k * b : ℕ) : ℤ) ≠ 0 := by
      rw [← hpow, ← hu]
      exact u.ne_zero
    have hEq : u = Units.mk0 (1 - β ^ ((k * b : ℕ) : ℤ)) hne := Units.ext (by simp [hu, hpow])
    rw [hEq]
    exact one_sub_zpow_mem_cyclotomicNumbers hβ.pow_eq_one hN hndvd hne

/-- Every ring automorphism of `K` stabilizes `cyclotomicNumbers ζ N` when `ζ` is a primitive
`N`-th root of unity (`0 < N`). -/
theorem cyclotomicNumbers_comap_ringAut {ζ : K} {N : ℕ} (hN : 0 < N)
    (hζ : IsPrimitiveRoot ζ N) (σ : K ≃+* K) :
    (cyclotomicNumbers ζ N).comap (Units.mapEquiv σ.toMulEquiv).toMonoidHom =
      cyclotomicNumbers ζ N := by
  have hσζ : IsPrimitiveRoot (σ ζ) N := hζ.map_of_injective σ.injective
  have hmap : (cyclotomicNumbers ζ N).map (Units.mapEquiv σ.toMulEquiv).toMonoidHom =
      cyclotomicNumbers ζ N := by
    rw [cyclotomicNumbers_map_ringEquiv, cyclotomicNumbers_eq_of_isPrimitiveRoot hN hσζ hζ]
  ext u
  rw [Subgroup.mem_comap]
  constructor
  · intro hu
    rw [← hmap] at hu
    obtain ⟨v, hv, hvu⟩ := hu
    have : v = u := (Units.mapEquiv σ.toMulEquiv).injective hvu
    rwa [← this]
  · intro hu
    rw [← hmap]
    exact ⟨u, hu, rfl⟩

end CyclotomicNumbersField

section CyclotomicUnits

variable {K : Type*} [Field K]

theorem mem_cyclotomicUnits_iff {ζ : K} {N : ℕ} {u : (𝓞 K)ˣ} :
    u ∈ cyclotomicUnits K ζ N ↔
      Units.map (algebraMap (𝓞 K) K).toMonoidHom u ∈ cyclotomicNumbers ζ N :=
  Iff.rfl

theorem mem_realCyclotomicUnits_iff {ζ : K} {N : ℕ}
    {u : (𝓞 (maximalRealSubfield K))ˣ} :
    u ∈ realCyclotomicUnits K ζ N ↔
      Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom u ∈
        cyclotomicUnits K ζ N :=
  Iff.rfl

theorem neg_one_mem_cyclotomicUnits (ζ : K) (N : ℕ) :
    (-1 : (𝓞 K)ˣ) ∈ cyclotomicUnits K ζ N := by
  rw [mem_cyclotomicUnits_iff]
  have hEq : Units.map (algebraMap (𝓞 K) K).toMonoidHom (-1 : (𝓞 K)ˣ) = (-1 : Kˣ) := by
    ext
    simp
  rw [hEq]
  exact neg_one_mem_cyclotomicNumbers ζ N

theorem neg_one_mem_realCyclotomicUnits (ζ : K) (N : ℕ) :
    (-1 : (𝓞 (maximalRealSubfield K))ˣ) ∈ realCyclotomicUnits K ζ N := by
  rw [mem_realCyclotomicUnits_iff]
  have hEq : Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
      (-1 : (𝓞 (maximalRealSubfield K))ˣ) = (-1 : (𝓞 K)ˣ) := by
    ext
    simp
  rw [hEq]
  exact neg_one_mem_cyclotomicUnits ζ N

/-- The image of `realCyclotomicUnits K ζ N` in `(𝓞 K)ˣ` is
`cyclotomicUnits K ζ N ⊓ realUnits K`. -/
theorem map_realCyclotomicUnits_eq_inf_realUnits (ζ : K) (N : ℕ) :
    (realCyclotomicUnits K ζ N).map
        (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) =
      cyclotomicUnits K ζ N ⊓ realUnits K := by
  rw [realCyclotomicUnits, Subgroup.map_comap_eq, inf_comm]
  rfl

/-- `cyclotomicUnits K ζ N` is independent of the choice of primitive `N`-th root of unity `ζ`. -/
theorem cyclotomicUnits_eq_of_isPrimitiveRoot {ζ η : K} {N : ℕ} (hN : 0 < N)
    (hζ : IsPrimitiveRoot ζ N) (hη : IsPrimitiveRoot η N) :
    cyclotomicUnits K ζ N = cyclotomicUnits K η N := by
  rw [cyclotomicUnits, cyclotomicUnits, cyclotomicNumbers_eq_of_isPrimitiveRoot hN hζ hη]

/-- `realCyclotomicUnits K ζ N` is independent of the choice of primitive `N`-th root of unity. -/
theorem realCyclotomicUnits_eq_of_isPrimitiveRoot {ζ η : K} {N : ℕ} (hN : 0 < N)
    (hζ : IsPrimitiveRoot ζ N) (hη : IsPrimitiveRoot η N) :
    realCyclotomicUnits K ζ N = realCyclotomicUnits K η N := by
  rw [realCyclotomicUnits, realCyclotomicUnits, cyclotomicUnits_eq_of_isPrimitiveRoot hN hζ hη]

/-- Every ring automorphism `σ : K ≃+* K` stabilizes `cyclotomicUnits K ζ N` when `ζ` is a
primitive `N`-th root of unity (`0 < N`). -/
theorem cyclotomicUnits_comap_ringAut {ζ : K} {N : ℕ} (hN : 0 < N)
    (hζ : IsPrimitiveRoot ζ N) (σ : K ≃+* K) :
    (cyclotomicUnits K ζ N).comap
        (Units.mapEquiv (RingOfIntegers.mapRingEquiv σ).toMulEquiv).toMonoidHom =
      cyclotomicUnits K ζ N := by
  ext u
  simp only [Subgroup.mem_comap, mem_cyclotomicUnits_iff]
  have hcomm :
      Units.map (algebraMap (𝓞 K) K).toMonoidHom
        ((Units.mapEquiv (RingOfIntegers.mapRingEquiv σ).toMulEquiv) u) =
      Units.mapEquiv σ.toMulEquiv (Units.map (algebraMap (𝓞 K) K).toMonoidHom u) := by
    ext
    simp
  rw [MulEquiv.coe_toMonoidHom, hcomm]
  exact SetLike.ext_iff.mp (cyclotomicNumbers_comap_ringAut hN hζ σ) _

/-- Any ring isomorphism `e : K ≃+* L` restricts to a ring isomorphism between the maximal real
subfields `K⁺ ≃+* L⁺`. -/
def maximalRealSubfieldRingEquiv {L : Type*} [Field L] (e : K ≃+* L) :
    maximalRealSubfield K ≃+* maximalRealSubfield L where
  toFun x := ⟨e x, fun φ ↦ x.2 (φ.comp e.toRingHom)⟩
  invFun y := ⟨e.symm y, fun φ ↦ y.2 (φ.comp e.symm.toRingHom)⟩
  left_inv x := Subtype.ext (e.symm_apply_apply x)
  right_inv y := Subtype.ext (e.apply_symm_apply y)
  map_mul' x y := Subtype.ext (map_mul e x.1 y.1)
  map_add' x y := Subtype.ext (map_add e x.1 y.1)

@[simp]
theorem coe_maximalRealSubfieldRingEquiv {L : Type*} [Field L] (e : K ≃+* L)
    (x : maximalRealSubfield K) :
    (maximalRealSubfieldRingEquiv e x : L) = e x := by
  rfl

@[simp]
theorem coe_maximalRealSubfieldRingEquiv_symm {L : Type*} [Field L] (e : K ≃+* L)
    (y : maximalRealSubfield L) :
    ((maximalRealSubfieldRingEquiv e).symm y : K) = e.symm y := by
  rfl

/-- Any ring isomorphism `e : K ≃+* L` induces a group isomorphism `(𝓞 K⁺)ˣ ≃* (𝓞 L⁺)ˣ` on the
integral units of the maximal real subfields. -/
def realUnitsMapEquiv {L : Type*} [Field L] (e : K ≃+* L) :
    (𝓞 (maximalRealSubfield K))ˣ ≃* (𝓞 (maximalRealSubfield L))ˣ :=
  Units.mapEquiv (RingOfIntegers.mapRingEquiv (maximalRealSubfieldRingEquiv e)).toMulEquiv

@[simp]
theorem coe_realUnitsMapEquiv {L : Type*} [Field L] (e : K ≃+* L)
    (u : (𝓞 (maximalRealSubfield K))ˣ) :
    (((realUnitsMapEquiv e u : 𝓞 (maximalRealSubfield L)) : maximalRealSubfield L) : L) =
      e (((u : 𝓞 (maximalRealSubfield K)) : maximalRealSubfield K) : K) := by
  rfl

@[simp]
theorem coe_realUnitsMapEquiv_symm {L : Type*} [Field L] (e : K ≃+* L)
    (u : (𝓞 (maximalRealSubfield L))ˣ) :
    ((((realUnitsMapEquiv e).symm u : 𝓞 (maximalRealSubfield K)) : maximalRealSubfield K) : K) =
      e.symm (((u : 𝓞 (maximalRealSubfield L)) : maximalRealSubfield L) : L) := by
  rfl

@[simp]
theorem realUnitsMapEquiv_refl :
    realUnitsMapEquiv (RingEquiv.refl K) = MulEquiv.refl _ := by
  ext u
  rfl

theorem realUnitsMapEquiv_trans {L M : Type*} [Field L] [Field M]
    (e₁ : K ≃+* L) (e₂ : L ≃+* M) :
    realUnitsMapEquiv (e₁.trans e₂) =
      (realUnitsMapEquiv e₁).trans (realUnitsMapEquiv e₂) := by
  ext u
  rfl

/-- Every ring automorphism `σ : K ≃+* K` stabilizes `realCyclotomicUnits K ζ N` when `ζ` is a
primitive `N`-th root of unity (`0 < N`). -/
theorem realCyclotomicUnits_comap_ringAut {ζ : K} {N : ℕ} (hN : 0 < N)
    (hζ : IsPrimitiveRoot ζ N) (σ : K ≃+* K) :
    (realCyclotomicUnits K ζ N).comap (realUnitsMapEquiv σ).toMonoidHom =
      realCyclotomicUnits K ζ N := by
  ext u
  simp only [Subgroup.mem_comap, mem_realCyclotomicUnits_iff]
  have hcomm :
      Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
        (realUnitsMapEquiv σ u) =
      Units.mapEquiv (RingOfIntegers.mapRingEquiv σ).toMulEquiv
        (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom u) := by
    apply Units.ext
    apply RingOfIntegers.ext
    rfl
  rw [MulEquiv.coe_toMonoidHom, hcomm]
  exact SetLike.ext_iff.mp (cyclotomicUnits_comap_ringAut hN hζ σ) _

/-- When `[K : ℚ] = 1` (so `𝓞 K ≃+* ℤ` and `(𝓞 K)ˣ = {±1}`), every integral unit is circular. -/
theorem cyclotomicUnits_eq_top_of_finrank_eq_one [NumberField K]
    (hfin : Module.finrank ℚ K = 1) (ζ : K) (N : ℕ) :
    cyclotomicUnits K ζ N = ⊤ := by
  have hbij : Function.Bijective (algebraMap ℚ K) :=
    Algebra.finrank_eq_one_iff_bijective_algebraMap.mp hfin
  let e : ℚ ≃+* K := RingEquiv.ofBijective (algebraMap ℚ K) hbij
  let eO : ℤ ≃+* 𝓞 K :=
    Rat.ringOfIntegersEquiv.symm.trans (RingOfIntegers.mapRingEquiv e)
  ext u
  simp only [Subgroup.mem_top, iff_true]
  set z : ℤˣ := (Units.mapEquiv eO.toMulEquiv).symm u
  have hz : z = 1 ∨ z = -1 := Int.units_eq_one_or z
  have hu : u = Units.mapEquiv eO.toMulEquiv z :=
    ((Units.mapEquiv eO.toMulEquiv).apply_symm_apply u).symm
  rcases hz with h1 | hneg
  · rw [hu, h1, map_one]
    exact one_mem _
  · rw [hu, hneg]
    have hEq : Units.mapEquiv eO.toMulEquiv (-1 : ℤˣ) = (-1 : (𝓞 K)ˣ) := by
      ext
      simp
    rw [hEq]
    exact neg_one_mem_cyclotomicUnits ζ N

/-- When `[K : ℚ] = 1`, every unit of `𝓞 K⁺` is a real circular unit. -/
theorem realCyclotomicUnits_eq_top_of_finrank_eq_one [NumberField K]
    (hfin : Module.finrank ℚ K = 1) (ζ : K) (N : ℕ) :
    realCyclotomicUnits K ζ N = ⊤ := by
  rw [realCyclotomicUnits, cyclotomicUnits_eq_top_of_finrank_eq_one hfin, Subgroup.comap_top]

end CyclotomicUnits

end TauCeti
