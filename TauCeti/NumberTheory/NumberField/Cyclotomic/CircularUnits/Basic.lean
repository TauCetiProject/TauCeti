/-!
# Circular numbers and circular units in cyclotomic fields

For a field `K`, an element `ζ : K`, and a modulus `N : ℕ`, the subgroup `cyclotomicNumbers ζ N`
of `Kˣ` is generated by the nonzero elements among `-1`, `ζ`, and `1 - ζ ^ b` for `0 < b < N`
(in particular, all of `-1`, `ζ`, and `1 - ζ ^ b` occur as generators whenever `ζ` is a primitive
`N`-th root of unity). Taking the preimage inside the integral units `(𝓞 K)ˣ` gives the circular
units `cyclotomicUnits K ζ N`, and intersecting further with the maximal real subfield `K⁺` gives
the real circular units `realCyclotomicUnits K ζ N`.

Allowing non-unit generators `1 - ζ ^ b` and their inverses in `Kˣ` before intersecting with
`(𝓞 K)ˣ` is essential: at prime-power level `N = p ^ a`, individual differences `1 - ζ ^ b` are
not units, whereas their ratios `cyclotomicRatio ζ b = (ζ ^ b - 1) / (ζ - 1)` for `gcd(b, N) = 1`
are integral units.

For every prime `p`, exponent `a : ℕ`, `p ^ a`-th cyclotomic field `K / ℚ`, and chosen primitive
`p ^ a`-th root of unity `ζ : K`, the field `K` has Hasse unit index `1`
(`TauCeti.primePowerHasseUnitIndex_one`) and its full root-of-unity subgroup `torsion K` is
contained in `cyclotomicUnits K ζ (p ^ a)`. Consequently, `cyclotomicUnits K ζ (p ^ a)` is
generated by `torsion K` and `realCyclotomicUnits K ζ (p ^ a)`, inclusion induces a canonical
isomorphism `(𝓞 K⁺)ˣ ⧸ realCyclotomicUnits K ζ (p ^ a) ≃* (𝓞 K)ˣ ⧸ cyclotomicUnits K ζ (p ^ a)`,
and the two circular-unit subgroups have equal index in their respective unit groups.

## Main definitions

* `TauCeti.cyclotomicNumbers`: subgroup of `Kˣ` generated by the nonzero elements among `-1`, `ζ`,
  and `1 - ζ ^ b` (`0 < b < N`).
* `TauCeti.cyclotomicUnits`: preimage of `cyclotomicNumbers ζ N` in `(𝓞 K)ˣ`.
* `TauCeti.realCyclotomicUnits`: preimage of `cyclotomicUnits K ζ N` in `(𝓞 K⁺)ˣ`.
* `TauCeti.cyclotomicRatio`: the field ratio `(ζ ^ b - 1) / (ζ - 1)` for `b : ℤ`.
* `TauCeti.cyclotomicRatioUnit`: the integral unit in `(𝓞 K)ˣ` representing `cyclotomicRatio ζ b`
  when `ζ` is a primitive `N`-th root of unity (`2 ≤ N`) and `gcd(b, N) = 1`.
* `TauCeti.fullRealCircularQuotientEquiv`: for a primitive `p ^ a`-th root of unity `ζ`, the
  isomorphism `(𝓞 K⁺)ˣ ⧸ realCyclotomicUnits K ζ (p ^ a) ≃* (𝓞 K)ˣ ⧸ cyclotomicUnits K ζ (p ^ a)`.

## Main results

* `TauCeti.cyclotomicNumbers_eq_of_isPrimitiveRoot`: invariance under the choice of primitive
  `N`-th root of unity.
* `RingEquiv.map_cyclotomicNumbers`, `AlgEquiv.map_cyclotomicUnits`, and
  `AlgEquiv.map_realCyclotomicUnits`: Galois stability of circular numbers, circular units, and
  real circular units for a primitive `N`-th root of unity.
* `TauCeti.cyclotomicRatio_mul`: the ratio cocycle law
  `cyclotomicRatio ζ (a * b) = cyclotomicRatio (ζ ^ b) a * cyclotomicRatio ζ b`.
* `TauCeti.torsion_le_cyclotomicUnits`: for a primitive `p ^ a`-th root of unity `ζ`, every root of
  unity in a `p ^ a`-th cyclotomic field lies in `cyclotomicUnits K ζ (p ^ a)`.
* `TauCeti.index_cyclotomicUnits_eq_index_realCyclotomicUnits`: for a primitive `p ^ a`-th root of
  unity `ζ`, equality of the full and real prime-power circular-unit indices for every prime `p`
  and `a : ℕ`.

## References

* L. C. Washington, *Introduction to Cyclotomic Fields*, Chapter 8.
* R. Sharifi, *Iwasawa Theory*, §§4.2–4.3.
-/

public section

open NumberField NumberField.Units NumberField.IsCMField

open scoped NumberField

namespace TauCeti

section Definitions

/-- Circular numbers generated in `Kˣ` by the nonzero elements among `-1`, `ζ`, and `1 - ζ ^ b` for
`0 < b < N`. Taking the subgroup in `Kˣ` allows inverses before intersecting with integral units. -/
def cyclotomicNumbers {K : Type*} [Field K] (ζ : K) (N : ℕ) : Subgroup Kˣ :=
  Subgroup.closure {u | (u : K) = -1 ∨ (u : K) = ζ ∨
    ∃ b : ℕ, 0 < b ∧ b < N ∧ (u : K) = 1 - ζ ^ b}

/-- The integral units of `K` whose field images lie in `cyclotomicNumbers ζ N`. -/
def cyclotomicUnits (K : Type*) [Field K] (ζ : K) (N : ℕ) : Subgroup (𝓞 K)ˣ :=
  (cyclotomicNumbers ζ N).comap (Units.map (algebraMap (𝓞 K) K).toMonoidHom)

/-- The real circular units: integral units of the maximal real subfield `K⁺` whose images in
`(𝓞 K)ˣ` lie in `cyclotomicUnits K ζ N`. -/
def realCyclotomicUnits (K : Type*) [Field K] (ζ : K) (N : ℕ) :
    Subgroup (𝓞 (maximalRealSubfield K))ˣ :=
  (cyclotomicUnits K ζ N).comap
    (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom)

/-- Definitional characterization of `cyclotomicNumbers`. -/
theorem cyclotomicNumbers_def {K : Type*} [Field K] (ζ : K) (N : ℕ) :
    cyclotomicNumbers ζ N = Subgroup.closure {u : Kˣ | (u : K) = -1 ∨ (u : K) = ζ ∨
      ∃ b : ℕ, 0 < b ∧ b < N ∧ (u : K) = 1 - ζ ^ b} :=
  (rfl)

/-- Definitional characterization of `cyclotomicUnits`. -/
theorem cyclotomicUnits_def (K : Type*) [Field K] (ζ : K) (N : ℕ) :
    cyclotomicUnits K ζ N =
      (cyclotomicNumbers ζ N).comap (Units.map (algebraMap (𝓞 K) K).toMonoidHom) :=
  (rfl)

/-- Definitional characterization of `realCyclotomicUnits`. -/
theorem realCyclotomicUnits_def (K : Type*) [Field K] (ζ : K) (N : ℕ) :
    realCyclotomicUnits K ζ N =
      (cyclotomicUnits K ζ N).comap
        (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) :=
  (rfl)

end Definitions

section Membership

variable {K : Type*} [Field K] {ζ : K} {N : ℕ}

/-- `-1` belongs to `cyclotomicNumbers ζ N`. -/
theorem neg_one_mem_cyclotomicNumbers : (-1 : Kˣ) ∈ cyclotomicNumbers ζ N :=
  Subgroup.subset_closure (Or.inl (by simp))

/-- Any unit of `Kˣ` with value `ζ` belongs to `cyclotomicNumbers ζ N`. -/
theorem mem_cyclotomicNumbers_of_val_eq_self {u : Kˣ} (hu : (u : K) = ζ) :
    u ∈ cyclotomicNumbers ζ N :=
  Subgroup.subset_closure (Or.inr (Or.inl hu))

/-- Any unit of `Kˣ` with value `1 - ζ ^ b` (`0 < b < N`) belongs to `cyclotomicNumbers ζ N`. -/
theorem mem_cyclotomicNumbers_of_val_eq_one_sub_pow {u : Kˣ} {b : ℕ} (hb0 : 0 < b) (hbN : b < N)
    (hu : (u : K) = 1 - ζ ^ b) : u ∈ cyclotomicNumbers ζ N :=
  Subgroup.subset_closure (Or.inr (Or.inr ⟨b, hb0, hbN, hu⟩))

/-- Any unit of `Kˣ` with value `ζ ^ b - 1` (`0 < b < N`) belongs to `cyclotomicNumbers ζ N`. -/
theorem mem_cyclotomicNumbers_of_val_eq_pow_sub_one {u : Kˣ} {b : ℕ} (hb0 : 0 < b) (hbN : b < N)
    (hu : (u : K) = ζ ^ b - 1) : u ∈ cyclotomicNumbers ζ N := by
  have hneg : (-u : Kˣ) ∈ cyclotomicNumbers ζ N :=
    mem_cyclotomicNumbers_of_val_eq_one_sub_pow hb0 hbN (by simp [hu])
  simpa using mul_mem neg_one_mem_cyclotomicNumbers hneg

/-- For a primitive `N`-th root of unity `ζ` and any integer `b` not divisible by `N`, the nonzero
element `1 - ζ ^ b` belongs to `cyclotomicNumbers ζ N`. -/
theorem mem_cyclotomicNumbers_of_val_eq_one_sub_zpow (hζ : IsPrimitiveRoot ζ N) (hN : 0 < N)
    {b : ℤ} (hb : ¬ (N : ℤ) ∣ b) {u : Kˣ} (hu : (u : K) = 1 - ζ ^ b) :
    u ∈ cyclotomicNumbers ζ N := by
  set r : ℕ := (b % (N : ℤ)).toNat
  have hr_cast : (r : ℤ) = b % (N : ℤ) := Int.toNat_of_nonneg (Int.emod_nonneg b (by omega))
  have hr0 : 0 < r := Nat.pos_of_ne_zero fun hr ↦
    hb (Int.dvd_of_emod_eq_zero (by rw [← hr_cast, hr, Nat.cast_zero]))
  have hrN : r < N := by have := Int.emod_lt_of_pos b (by omega : (0 : ℤ) < N); omega
  refine mem_cyclotomicNumbers_of_val_eq_one_sub_pow hr0 hrN ?_
  have hq : b = (N : ℤ) * (b / (N : ℤ)) + r := by rw [hr_cast, Int.mul_ediv_add_emod]
  rw [hu, hq, zpow_add₀ (hζ.ne_zero hN.ne'), zpow_mul, zpow_natCast, hζ.pow_eq_one, one_zpow,
    one_mul, zpow_natCast]

/-- For a primitive `N`-th root of unity `ζ` and any integer `b` not divisible by `N`, the nonzero
element `ζ ^ b - 1` belongs to `cyclotomicNumbers ζ N`. -/
theorem mem_cyclotomicNumbers_of_val_eq_zpow_sub_one (hζ : IsPrimitiveRoot ζ N) (hN : 0 < N)
    {b : ℤ} (hb : ¬ (N : ℤ) ∣ b) {u : Kˣ} (hu : (u : K) = ζ ^ b - 1) :
    u ∈ cyclotomicNumbers ζ N := by
  have hneg : (-u : Kˣ) ∈ cyclotomicNumbers ζ N :=
    mem_cyclotomicNumbers_of_val_eq_one_sub_zpow hζ hN hb (by simp [hu])
  simpa using mul_mem neg_one_mem_cyclotomicNumbers hneg

/-- Unit-membership criterion: an integral unit lies in `cyclotomicUnits K ζ N` if and only if its
image in `Kˣ` lies in `cyclotomicNumbers ζ N`. -/
@[simp]
theorem mem_cyclotomicUnits_iff (u : (𝓞 K)ˣ) :
    u ∈ cyclotomicUnits K ζ N ↔
      Units.map (algebraMap (𝓞 K) K).toMonoidHom u ∈ cyclotomicNumbers ζ N :=
  (Iff.rfl)

/-- Real-field preimage criterion: an integral unit of `K⁺` lies in `realCyclotomicUnits K ζ N` if
and only if its image in `(𝓞 K)ˣ` lies in `cyclotomicUnits K ζ N`. -/
@[simp]
theorem mem_realCyclotomicUnits_iff (v : (𝓞 (maximalRealSubfield K))ˣ) :
    v ∈ realCyclotomicUnits K ζ N ↔
      Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom v ∈
        cyclotomicUnits K ζ N :=
  (Iff.rfl)

/-- `-1` belongs to `cyclotomicUnits K ζ N`. -/
theorem neg_one_mem_cyclotomicUnits : (-1 : (𝓞 K)ˣ) ∈ cyclotomicUnits K ζ N := by
  rw [mem_cyclotomicUnits_iff]
  exact (Units.ext (by simp) :
    Units.map (algebraMap (𝓞 K) K).toMonoidHom (-1 : (𝓞 K)ˣ) = (-1 : Kˣ)) ▸
    neg_one_mem_cyclotomicNumbers

/-- `-1` belongs to `realCyclotomicUnits K ζ N`. -/
theorem neg_one_mem_realCyclotomicUnits :
    (-1 : (𝓞 (maximalRealSubfield K))ˣ) ∈ realCyclotomicUnits K ζ N := by
  rw [mem_realCyclotomicUnits_iff]
  exact (Units.ext (by simp) :
    Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
      (-1 : (𝓞 (maximalRealSubfield K))ˣ) = (-1 : (𝓞 K)ˣ)) ▸
    neg_one_mem_cyclotomicUnits

/-- The integral unit given by a primitive `N`-th root of unity lies in `cyclotomicUnits K ζ N`. -/
theorem toInteger_unit_mem_cyclotomicUnits [NeZero N] (hζ : IsPrimitiveRoot ζ N) :
    (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne N)).unit ∈ cyclotomicUnits K ζ N := by
  have hcoe : (hζ.toInteger : K) = ζ := hζ.coe_toInteger
  exact mem_cyclotomicNumbers_of_val_eq_self (by simp [hcoe])

end Membership

section InvarianceAndGalois

variable {K : Type*} [Field K] {N : ℕ}

/-- The circular-number subgroup depends only on the level `N`, not on the chosen primitive `N`-th
root of unity. -/
theorem cyclotomicNumbers_eq_of_isPrimitiveRoot {ζ η : K} (hN : 0 < N)
    (hζ : IsPrimitiveRoot ζ N) (hη : IsPrimitiveRoot η N) :
    cyclotomicNumbers ζ N = cyclotomicNumbers η N := by
  suffices hle : ∀ {ζ₁ ζ₂ : K}, IsPrimitiveRoot ζ₁ N → IsPrimitiveRoot ζ₂ N →
      cyclotomicNumbers ζ₁ N ≤ cyclotomicNumbers ζ₂ N from
    le_antisymm (hle hζ hη) (hle hη hζ)
  intro ζ₁ ζ₂ h₁ h₂
  have : NeZero N := ⟨hN.ne'⟩
  obtain ⟨c, -, hc_cop, hc_eq⟩ := h₂.isPrimitiveRoot_iff.mp h₁
  rw [cyclotomicNumbers, Subgroup.closure_le]
  rintro u (hu | hu | ⟨b, hb0, hbN, hu⟩)
  · exact (Units.ext hu : u = -1) ▸ neg_one_mem_cyclotomicNumbers
  · have hζ₂ : Units.mk0 ζ₂ (h₂.ne_zero hN.ne') ∈ cyclotomicNumbers ζ₂ N :=
      mem_cyclotomicNumbers_of_val_eq_self rfl
    exact (Units.ext (by simp [hu, hc_eq]) : u = Units.mk0 ζ₂ (h₂.ne_zero hN.ne') ^ c) ▸
      pow_mem hζ₂ c
  · have hndvd : ¬ (N : ℤ) ∣ ((c * b : ℕ) : ℤ) := fun hdvd ↦
      absurd (Nat.le_of_dvd hb0 (hc_cop.symm.dvd_of_dvd_mul_left (Int.natCast_dvd_natCast.mp hdvd)))
        (not_le.mpr hbN)
    exact mem_cyclotomicNumbers_of_val_eq_one_sub_zpow h₂ hN hndvd
      (by rw [hu, ← hc_eq, ← pow_mul, zpow_natCast])

/-- The circular-unit subgroup depends only on the level `N`, not on the chosen primitive `N`-th
root of unity. -/
theorem cyclotomicUnits_eq_of_isPrimitiveRoot {ζ η : K} (hN : 0 < N)
    (hζ : IsPrimitiveRoot ζ N) (hη : IsPrimitiveRoot η N) :
    cyclotomicUnits K ζ N = cyclotomicUnits K η N := by
  simp only [cyclotomicUnits, cyclotomicNumbers_eq_of_isPrimitiveRoot hN hζ hη]

/-- The real circular-unit subgroup depends only on the level `N`, not on the chosen primitive
`N`-th root of unity. -/
theorem realCyclotomicUnits_eq_of_isPrimitiveRoot {ζ η : K} (hN : 0 < N)
    (hζ : IsPrimitiveRoot ζ N) (hη : IsPrimitiveRoot η N) :
    realCyclotomicUnits K ζ N = realCyclotomicUnits K η N := by
  simp only [realCyclotomicUnits, cyclotomicUnits_eq_of_isPrimitiveRoot hN hζ hη]

end InvarianceAndGalois

end TauCeti

namespace RingEquiv

open TauCeti

/-- Every ring isomorphism maps `cyclotomicNumbers ζ N` onto `cyclotomicNumbers (σ ζ) N`. -/
theorem map_cyclotomicNumbers_eq {K L : Type*} [Field K] [Field L] (σ : K ≃+* L) (ζ : K) (N : ℕ) :
    (cyclotomicNumbers ζ N).map (Units.map σ.toMonoidHom) = cyclotomicNumbers (σ ζ) N := by
  rw [cyclotomicNumbers_def, cyclotomicNumbers_def, MonoidHom.map_closure]
  congr 1
  ext u
  constructor
  · rintro ⟨v, (hv | hv | ⟨b, hb0, hbN, hv⟩), rfl⟩
    · exact Or.inl (by simp [hv])
    · exact Or.inr (Or.inl (by simp [hv]))
    · exact Or.inr (Or.inr ⟨b, hb0, hbN, by simp [hv]⟩)
  · intro hu
    refine ⟨Units.map σ.symm.toMonoidHom u, ?_, by ext; simp⟩
    rcases hu with hu | hu | ⟨b, hb0, hbN, hu⟩
    · exact Or.inl (by simp [hu])
    · exact Or.inr (Or.inl (by simp [hu]))
    · exact Or.inr (Or.inr ⟨b, hb0, hbN, by simp [hu]⟩)

/-- Galois stability of `cyclotomicNumbers`: every ring automorphism of `K` preserves
`cyclotomicNumbers ζ N` whenever `ζ` is a primitive `N`-th root of unity (`0 < N`). -/
theorem map_cyclotomicNumbers {K : Type*} [Field K] {N : ℕ} (σ : K ≃+* K) {ζ : K} (hN : 0 < N)
    (hζ : IsPrimitiveRoot ζ N) :
    (cyclotomicNumbers ζ N).map (Units.map σ.toMonoidHom) = cyclotomicNumbers ζ N := by
  rw [σ.map_cyclotomicNumbers_eq,
    cyclotomicNumbers_eq_of_isPrimitiveRoot hN (hζ.map_of_injective σ.injective) hζ]

end RingEquiv

namespace AlgEquiv

open TauCeti

/-- Galois stability of `cyclotomicUnits`: every `ℚ`-automorphism of `K` preserves
`cyclotomicUnits K ζ N` whenever `ζ` is a primitive `N`-th root of unity (`0 < N`). -/
theorem map_cyclotomicUnits {K : Type*} [Field K] [CharZero K] {N : ℕ} (σ : K ≃ₐ[ℚ] K) {ζ : K}
    (hN : 0 < N) (hζ : IsPrimitiveRoot ζ N) :
    (cyclotomicUnits K ζ N).map
      (Units.map (RingOfIntegers.mapRingEquiv σ.toRingEquiv).toMonoidHom) =
        cyclotomicUnits K ζ N := by
  have hcomm (τ : K ≃ₐ[ℚ] K) (w : (𝓞 K)ˣ) :
      Units.map (algebraMap (𝓞 K) K).toMonoidHom
        (Units.map (RingOfIntegers.mapRingEquiv τ.toRingEquiv).toMonoidHom w) =
      Units.map τ.toRingEquiv.toMonoidHom
        (Units.map (algebraMap (𝓞 K) K).toMonoidHom w) := by
    ext; simp [← RingOfIntegers.coe_eq_algebraMap]
  ext u
  constructor
  · rintro ⟨w, hw, rfl⟩
    rw [mem_cyclotomicUnits_iff, hcomm σ, ← σ.toRingEquiv.map_cyclotomicNumbers hN hζ]
    exact Subgroup.mem_map_of_mem _ hw
  · intro hu
    refine ⟨Units.map (RingOfIntegers.mapRingEquiv σ.symm.toRingEquiv).toMonoidHom u, ?_,
      by ext; simp⟩
    rw [SetLike.mem_coe, mem_cyclotomicUnits_iff, hcomm σ.symm,
      ← σ.symm.toRingEquiv.map_cyclotomicNumbers hN hζ]
    exact Subgroup.mem_map_of_mem _ hu

/-- Galois stability of `realCyclotomicUnits`: when `K / ℚ` is normal, every `ℚ`-automorphism of
`K⁺` preserves `realCyclotomicUnits K ζ N` whenever `ζ` is a primitive `N`-th root of unity
(`0 < N`). -/
theorem map_realCyclotomicUnits {K : Type*} [Field K] [CharZero K] [Normal ℚ K] {N : ℕ}
    (τ : maximalRealSubfield K ≃ₐ[ℚ] maximalRealSubfield K) {ζ : K} (hN : 0 < N)
    (hζ : IsPrimitiveRoot ζ N) :
    (realCyclotomicUnits K ζ N).map
      (Units.map (RingOfIntegers.mapRingEquiv τ.toRingEquiv).toMonoidHom) =
        realCyclotomicUnits K ζ N := by
  set σ : K ≃ₐ[ℚ] K := τ.liftNormal K
  have hcomm (τ' : maximalRealSubfield K ≃ₐ[ℚ] maximalRealSubfield K) (σ' : K ≃ₐ[ℚ] K)
      (h : ∀ x : maximalRealSubfield K, σ' (algebraMap _ K x) = algebraMap _ K (τ' x))
      (v : (𝓞 (maximalRealSubfield K))ˣ) :
      Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
        (Units.map (RingOfIntegers.mapRingEquiv τ'.toRingEquiv).toMonoidHom v) =
      Units.map (RingOfIntegers.mapRingEquiv σ'.toRingEquiv).toMonoidHom
        (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom v) := by
    refine Units.ext (RingOfIntegers.coe_injective ?_)
    have hcoe (x : 𝓞 (maximalRealSubfield K)) :
        algebraMap (𝓞 K) K (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) x) =
          algebraMap (maximalRealSubfield K) K (x : maximalRealSubfield K) := by
      rw [← IsScalarTower.algebraMap_apply,
        IsScalarTower.algebraMap_apply (𝓞 (maximalRealSubfield K)) (maximalRealSubfield K) K,
        ← RingOfIntegers.coe_eq_algebraMap]
    simpa [hcoe] using (h (v : 𝓞 (maximalRealSubfield K))).symm
  have hlift : ∀ x : maximalRealSubfield K, σ (algebraMap _ K x) = algebraMap _ K (τ x) :=
    AlgEquiv.liftNormal_commutes τ K
  have hlift_symm : ∀ x : maximalRealSubfield K,
      σ.symm (algebraMap _ K x) = algebraMap _ K (τ.symm x) := fun x ↦ by
    rw [AlgEquiv.symm_apply_eq, hlift, AlgEquiv.apply_symm_apply]
  ext v
  constructor
  · rintro ⟨w, hw, rfl⟩
    rw [mem_realCyclotomicUnits_iff, hcomm τ σ hlift, ← σ.map_cyclotomicUnits hN hζ]
    exact Subgroup.mem_map_of_mem _ ((mem_realCyclotomicUnits_iff w).mp hw)
  · intro hv
    refine ⟨Units.map (RingOfIntegers.mapRingEquiv τ.symm.toRingEquiv).toMonoidHom v, ?_,
      by ext; simp [RingOfIntegers.mapRingEquiv_apply]⟩
    rw [SetLike.mem_coe, mem_realCyclotomicUnits_iff, hcomm τ.symm σ.symm hlift_symm,
      ← σ.symm.map_cyclotomicUnits hN hζ]
    exact Subgroup.mem_map_of_mem _ ((mem_realCyclotomicUnits_iff v).mp hv)

end AlgEquiv

namespace TauCeti

section CyclotomicRatio

variable {K : Type*} [Field K]

/-- The field-valued cyclotomic ratio `(ζ ^ b - 1) / (ζ - 1)` for `b : ℤ`. -/
def cyclotomicRatio (ζ : K) (b : ℤ) : K :=
  (ζ ^ b - 1) / (ζ - 1)

/-- Definitional characterization of `cyclotomicRatio`. -/
theorem cyclotomicRatio_def (ζ : K) (b : ℤ) :
    cyclotomicRatio ζ b = (ζ ^ b - 1) / (ζ - 1) :=
  (rfl)

/-- At `b = 0`, the cyclotomic ratio vanishes. -/
@[simp]
theorem cyclotomicRatio_zero (ζ : K) : cyclotomicRatio ζ 0 = 0 := by
  simp [cyclotomicRatio]

/-- At `b = 1`, the cyclotomic ratio is `1` whenever `ζ ≠ 1`. -/
@[simp]
theorem cyclotomicRatio_one {ζ : K} (hζ : ζ ≠ 1) : cyclotomicRatio ζ 1 = 1 := by
  simp [cyclotomicRatio, div_self (sub_ne_zero.mpr hζ)]

/-- At `b = -1`, the cyclotomic ratio is `-ζ⁻¹` whenever `ζ ≠ 0` and `ζ ≠ 1`. -/
theorem cyclotomicRatio_neg_one {ζ : K} (hζ0 : ζ ≠ 0) (hζ1 : ζ ≠ 1) :
    cyclotomicRatio ζ (-1) = -ζ⁻¹ := by
  have hsub : ζ - 1 ≠ 0 := sub_ne_zero.mpr hζ1
  rw [cyclotomicRatio, zpow_neg_one]
  field_simp
  ring

/-- **The ratio cocycle law.** Whenever `ζ ≠ 1` and `ζ ^ b ≠ 1`,
`cyclotomicRatio ζ (a * b) = cyclotomicRatio (ζ ^ b) a * cyclotomicRatio ζ b`. -/
theorem cyclotomicRatio_mul {ζ : K} {a b : ℤ} (hζ1 : ζ ≠ 1) (hζb : ζ ^ b ≠ 1) :
    cyclotomicRatio ζ (a * b) = cyclotomicRatio (ζ ^ b) a * cyclotomicRatio ζ b := by
  have h1 : ζ - 1 ≠ 0 := sub_ne_zero.mpr hζ1
  have h2 : ζ ^ b - 1 ≠ 0 := sub_ne_zero.mpr hζb
  simp only [cyclotomicRatio, mul_comm a b, zpow_mul]
  field_simp

/-- For a natural number `b`, `cyclotomicRatio ζ b` equals the geometric sum `∑ i < b, ζ ^ i`. -/
theorem cyclotomicRatio_natCast_eq_geom_sum {ζ : K} (hζ1 : ζ ≠ 1) (b : ℕ) :
    cyclotomicRatio ζ b = ∑ i ∈ Finset.range b, ζ ^ i := by
  rw [cyclotomicRatio, zpow_natCast, div_eq_iff (sub_ne_zero.mpr hζ1), mul_comm, mul_geom_sum]

/-- For an `N`-th root of unity `ζ`, `cyclotomicRatio ζ b` depends only on `b` modulo `N`. -/
theorem cyclotomicRatio_modEq {ζ : K} {N : ℕ} (hN : 0 < N) (hζ : ζ ^ N = 1) {a b : ℤ}
    (hab : a ≡ b [ZMOD N]) : cyclotomicRatio ζ a = cyclotomicRatio ζ b := by
  have hζ0 : ζ ≠ 0 := by
    rintro rfl
    rw [zero_pow hN.ne'] at hζ
    exact zero_ne_one hζ
  obtain ⟨k, hk⟩ := Int.modEq_iff_dvd.mp hab.symm
  have hpow : ζ ^ a = ζ ^ b := by
    have ha : a = b + (N : ℤ) * k := by linarith
    rw [ha, zpow_add₀ hζ0, zpow_mul, zpow_natCast, hζ, one_zpow, mul_one]
  simp [cyclotomicRatio, hpow]

/-- When `ζ` is a primitive `N`-th root of unity (`2 ≤ N`) and `gcd(b, N) = 1`, the ratio
`(ζ ^ b - 1) / (ζ - 1)` is an integral unit of `𝓞 K`. -/
noncomputable def cyclotomicRatioUnit {N : ℕ} (hN : 2 ≤ N) {ζ : K} (hζ : IsPrimitiveRoot ζ N)
    {b : ℤ} (hb : Int.gcd b N = 1) : (𝓞 K)ˣ :=
  letI : NeZero N := ⟨by omega⟩
  let r : ℕ := (b % (N : ℤ)).toNat
  have hr_cop : r.Coprime N := by
    have hr_cast : (r : ℤ) = b % (N : ℤ) := Int.toNat_of_nonneg (Int.emod_nonneg b (by omega))
    refine Nat.coprime_iff_gcd_eq_one.mpr (Nat.dvd_one.mp ?_)
    rw [← hb]
    refine Int.dvd_gcd ?_ (Int.natCast_dvd_natCast.mpr (Nat.gcd_dvd_right r N))
    have hq : b = (N : ℤ) * (b / (N : ℤ)) + r := by rw [hr_cast, Int.mul_ediv_add_emod]
    rw [hq]
    exact dvd_add (dvd_mul_of_dvd_left (Int.natCast_dvd_natCast.mpr (Nat.gcd_dvd_right r N)) _)
      (Int.natCast_dvd_natCast.mpr (Nat.gcd_dvd_left r N))
  (hζ.toInteger_isPrimitiveRoot.geom_sum_isUnit hN hr_cop).unit

/-- The field value of `cyclotomicRatioUnit` is `cyclotomicRatio ζ b`. -/
@[simp]
theorem coe_cyclotomicRatioUnit {N : ℕ} (hN : 2 ≤ N) {ζ : K} (hζ : IsPrimitiveRoot ζ N)
    {b : ℤ} (hb : Int.gcd b N = 1) :
    ((cyclotomicRatioUnit hN hζ hb : 𝓞 K) : K) = cyclotomicRatio ζ b := by
  have : NeZero N := ⟨by omega⟩
  set r : ℕ := (b % (N : ℤ)).toNat
  have hr_cast : (r : ℤ) = b % (N : ℤ) := Int.toNat_of_nonneg (Int.emod_nonneg b (by omega))
  have hcoe : (hζ.toInteger : K) = ζ := hζ.coe_toInteger
  have hval : ((cyclotomicRatioUnit hN hζ hb : 𝓞 K) : K) = ∑ i ∈ Finset.range r, ζ ^ i := by
    simp only [cyclotomicRatioUnit, IsUnit.unit_spec, map_sum, map_pow, hcoe]
    rfl
  rw [hval, ← cyclotomicRatio_natCast_eq_geom_sum (hζ.ne_one (by omega)) r]
  exact cyclotomicRatio_modEq (by omega) hζ.pow_eq_one (hr_cast ▸ Int.mod_modEq b (N : ℤ))

/-- Every `cyclotomicRatioUnit` lies in `cyclotomicUnits K ζ N`. -/
theorem cyclotomicRatioUnit_mem_cyclotomicUnits {N : ℕ} (hN : 2 ≤ N) {ζ : K}
    (hζ : IsPrimitiveRoot ζ N) {b : ℤ} (hb : Int.gcd b N = 1) :
    cyclotomicRatioUnit hN hζ hb ∈ cyclotomicUnits K ζ N := by
  rw [mem_cyclotomicUnits_iff]
  have hndvd_b : ¬ (N : ℤ) ∣ b := fun hdvd ↦ by
    have hgcd : N ∣ Int.gcd b N := Int.dvd_gcd hdvd (dvd_refl _)
    rw [hb] at hgcd
    exact absurd (Nat.le_of_dvd one_pos hgcd) (by omega)
  have hndvd_1 : ¬ (N : ℤ) ∣ (1 : ℤ) := fun hdvd ↦ by have := Int.le_of_dvd one_pos hdvd; omega
  have hζb_ne : ζ ^ b - 1 ≠ 0 := fun h0 ↦
    hndvd_b ((hζ.zpow_eq_one_iff_dvd b).mp (sub_eq_zero.mp h0))
  have hζ1_ne : ζ - 1 ≠ 0 := hζ.sub_one_ne_zero (by omega)
  have hnum : Units.mk0 (ζ ^ b - 1) hζb_ne ∈ cyclotomicNumbers ζ N :=
    mem_cyclotomicNumbers_of_val_eq_zpow_sub_one hζ (by omega) hndvd_b rfl
  have hden : Units.mk0 (ζ - 1) hζ1_ne ∈ cyclotomicNumbers ζ N :=
    mem_cyclotomicNumbers_of_val_eq_zpow_sub_one hζ (by omega) hndvd_1 (by simp)
  have heq : Units.map (algebraMap (𝓞 K) K).toMonoidHom (cyclotomicRatioUnit hN hζ hb) =
      Units.mk0 (ζ ^ b - 1) hζb_ne * (Units.mk0 (ζ - 1) hζ1_ne)⁻¹ := by
    ext; simp [← RingOfIntegers.coe_eq_algebraMap, cyclotomicRatio, div_eq_mul_inv]
  exact heq ▸ mul_mem hnum (inv_mem hden)

end CyclotomicRatio

section PrimePowerTorsionAndIndex

variable (p a : ℕ) [hp : Fact p.Prime] {K : Type*} [Field K] [NumberField K]
  [hK : IsCyclotomicExtension {p ^ a} ℚ K]

/-- In a prime-power cyclotomic field `K` of level `p ^ a`, the torsion subgroup of `(𝓞 K)ˣ` is
generated by `-1` and the integral unit `ζ`. -/
theorem torsion_eq_closure_neg_one_zeta [NeZero (p ^ a)] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    torsion K = Subgroup.closure {(-1 : (𝓞 K)ˣ),
      (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne (p ^ a))).unit} := by
  set ζu : (𝓞 K)ˣ := (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne (p ^ a))).unit
  have hζu_mem : ζu ∈ torsion K := isOfFinOrder_iff_pow_eq_one.mpr
    ⟨p ^ a, pow_pos hp.out.pos a,
      Units.ext (by simpa [ζu] using hζ.toInteger_isPrimitiveRoot.pow_eq_one)⟩
  have hle : Subgroup.closure {(-1 : (𝓞 K)ˣ), ζu} ≤ torsion K := by
    rw [Subgroup.closure_le]; rintro x (rfl | rfl); exacts [neg_one_mem_torsion, hζu_mem]
  refine le_antisymm ?_ hle
  by_cases hgt : 2 < p ^ a
  · have hfin_cl : Finite (Subgroup.closure {(-1 : (𝓞 K)ˣ), ζu}) :=
      Finite.of_injective (Subgroup.inclusion hle) (Subgroup.inclusion_injective hle)
    have hζu_ord : orderOf ζu = p ^ a := by
      rw [← orderOf_units]; exact hζ.toInteger_isPrimitiveRoot.eq_orderOf.symm
    have hgen : ∃ g ∈ Subgroup.closure {(-1 : (𝓞 K)ˣ), ζu},
        orderOf g = if Even (p ^ a) then p ^ a else 2 * p ^ a := by
      by_cases he : Even (p ^ a)
      · exact ⟨ζu, Subgroup.subset_closure (Or.inr rfl), by simp [he, hζu_ord]⟩
      · have hord_neg : orderOf (-1 : (𝓞 K)ˣ) = 2 := orderOf_eq_prime_iff.mpr ⟨by simp, fun h ↦ by
          have h1 : ((-1 : (𝓞 K)ˣ) : K) = 1 := congrArg (fun x : (𝓞 K)ˣ ↦ (x : K)) h
          norm_num at h1⟩
        have hcop : Nat.Coprime (orderOf (-1 : (𝓞 K)ˣ)) (orderOf ζu) := by
          rw [hord_neg, hζu_ord, Nat.coprime_two_left]; exact Nat.not_even_iff_odd.mp he
        refine ⟨(-1 : (𝓞 K)ˣ) * ζu,
          mul_mem (Subgroup.subset_closure (Or.inl rfl)) (Subgroup.subset_closure (Or.inr rfl)), ?_⟩
        simp only [he, ↓reduceIte]
        rw [(Commute.all _ _).orderOf_mul_eq_mul_orderOf_of_coprime hcop, hord_neg, hζu_ord]
    obtain ⟨g, hg_mem, hg_ord⟩ := hgen
    have hcard_le : Nat.card (torsion K) ≤ Nat.card (Subgroup.closure {(-1 : (𝓞 K)ˣ), ζu}) := by
      have htors_card : Nat.card (torsion K) = if Even (p ^ a) then p ^ a else 2 * p ^ a := by
        simpa [torsionOrder] using IsCyclotomicExtension.Rat.torsionOrder_eq (n := p ^ a) (K := K)
      rw [htors_card, ← hg_ord, ← Nat.card_zpowers]
      exact Nat.card_le_card_of_injective (Subgroup.inclusion (Subgroup.zpowers_le.mpr hg_mem))
        (Subgroup.inclusion_injective _)
    exact (Subgroup.eq_of_le_of_card_ge hle hcard_le).symm.le
  · have htr : IsTotallyReal K := isTotallyReal_of_le_two K (Nat.le_of_not_lt hgt)
    obtain ⟨w⟩ := (inferInstance : Nonempty (InfinitePlace K))
    intro u hu
    rcases TauCeti.NumberField.Units.torsion_eq_one_or_neg_one_of_isReal
      (IsTotallyReal.isReal w) ⟨u, hu⟩ with h1 | h1
    · have hu1 : u = 1 := by simpa using h1
      rw [hu1]; exact one_mem _
    · have hu1 : u = -1 := by simpa using h1
      rw [hu1]; exact Subgroup.subset_closure (Or.inl rfl)

/-- Every root of unity in a prime-power cyclotomic field is a circular unit. -/
theorem torsion_le_cyclotomicUnits {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    torsion K ≤ cyclotomicUnits K ζ (p ^ a) := by
  have : NeZero (p ^ a) := ⟨pow_ne_zero a hp.out.ne_zero⟩
  rw [torsion_eq_closure_neg_one_zeta p a hζ, Subgroup.closure_le]
  rintro x (rfl | rfl)
  · exact neg_one_mem_cyclotomicUnits
  · exact toInteger_unit_mem_cyclotomicUnits hζ

/-- Every torsion unit of `K⁺` (namely `±1`) lies in `realCyclotomicUnits K ζ (p ^ a)`. -/
theorem torsion_maximalRealSubfield_le_realCyclotomicUnits {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    torsion (maximalRealSubfield K) ≤ realCyclotomicUnits K ζ (p ^ a) := fun _ hv ↦
  torsion_le_cyclotomicUnits p a hζ (MonoidHom.isOfFinOrder _ hv)

/-- In every prime-power cyclotomic field, `cyclotomicUnits K ζ (p ^ a)` is generated by the roots
of unity `torsion K` and the real circular units `realCyclotomicUnits K ζ (p ^ a)`. -/
theorem cyclotomicUnits_eq_torsion_sup_map_realCyclotomicUnits {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    torsion K ⊔ (realCyclotomicUnits K ζ (p ^ a)).map
      (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) =
        cyclotomicUnits K ζ (p ^ a) :=
  sup_map_comap_realUnits_eq (primePowerHasseUnitIndex_one p a K)
    (torsion_le_cyclotomicUnits p a hζ)

/-- **Comparison of full and real prime-power circular-unit quotients.** Inclusion of real units
induces a canonical isomorphism
`(𝓞 K⁺)ˣ ⧸ realCyclotomicUnits K ζ (p ^ a) ≃* (𝓞 K)ˣ ⧸ cyclotomicUnits K ζ (p ^ a)`. -/
noncomputable def fullRealCircularQuotientEquiv {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    (𝓞 (maximalRealSubfield K))ˣ ⧸ realCyclotomicUnits K ζ (p ^ a) ≃*
      (𝓞 K)ˣ ⧸ cyclotomicUnits K ζ (p ^ a) :=
  realQuotientEquivOfIndexRealUnitsEqOne (primePowerHasseUnitIndex_one p a K)
    (torsion_le_cyclotomicUnits p a hζ)

/-- Evaluating `fullRealCircularQuotientEquiv` on a coset `QuotientGroup.mk v`. -/
@[simp]
theorem fullRealCircularQuotientEquiv_mk {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ a))
    (v : (𝓞 (maximalRealSubfield K))ˣ) :
    fullRealCircularQuotientEquiv p a hζ (QuotientGroup.mk v) =
      QuotientGroup.mk (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K) :
        𝓞 (maximalRealSubfield K) →* 𝓞 K) v) :=
  realQuotientEquivOfIndexRealUnitsEqOne_mk _ _ v

/-- **Equality of full and real prime-power circular-unit indices.** For every prime `p` and
exponent `a : ℕ`, the full and real circular-unit subgroups have the same index in their respective
unit groups. -/
theorem index_cyclotomicUnits_eq_index_realCyclotomicUnits {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    (cyclotomicUnits K ζ (p ^ a)).index = (realCyclotomicUnits K ζ (p ^ a)).index :=
  (index_comap_realUnits_eq (primePowerHasseUnitIndex_one p a K)
    (torsion_le_cyclotomicUnits p a hζ)).symm

/-- At degenerate levels `p ^ a ≤ 2` (`a = 0` or `p ^ a = 2`), every integral unit of `K` is a
circular unit (`{±1}`). -/
theorem cyclotomicUnits_eq_top_of_le_two (hle : p ^ a ≤ 2) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    cyclotomicUnits K ζ (p ^ a) = ⊤ := by
  have : NeZero (p ^ a) := ⟨pow_ne_zero a hp.out.ne_zero⟩
  have htr : IsTotallyReal K := isTotallyReal_of_le_two K hle
  have hfin : Module.finrank ℚ K = 1 := by
    rw [IsCyclotomicExtension.Rat.finrank (p ^ a) K]
    have hpos : 0 < p ^ a := pow_pos hp.out.pos a
    generalize p ^ a = m at hpos hle
    interval_cases m <;> decide
  have hrank : NumberField.Units.rank K = 0 := by
    rw [NumberField.Units.rank, InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces,
      IsTotallyReal.nrComplexPlaces_eq_zero, add_zero, ← IsTotallyReal.finrank, hfin]
  rw [eq_top_iff, ← TauCeti.NumberField.Units.torsion_eq_top_of_rank_eq_zero hrank]
  exact torsion_le_cyclotomicUnits p a hζ

/-- At degenerate levels `p ^ a ≤ 2` (`a = 0` or `p ^ a = 2`), every integral unit of `K⁺` is a
real circular unit. -/
theorem realCyclotomicUnits_eq_top_of_le_two (hle : p ^ a ≤ 2) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    realCyclotomicUnits K ζ (p ^ a) = ⊤ := by
  rw [realCyclotomicUnits, cyclotomicUnits_eq_top_of_le_two p a hle hζ, Subgroup.comap_top]

end PrimePowerTorsionAndIndex

end TauCeti
