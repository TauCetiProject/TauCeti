section Factorization

/-- **Prime-power difference factorization.** If `ζ` is a primitive `p ^ a`-th root of unity in a
domain `R` and `r ≤ a`, then `1 - ζ ^ (b * p ^ r)` factors as the product of
`1 - ζ ^ (b + j * p ^ (a - r))` over `0 ≤ j < p ^ r`. -/
theorem primePowerDifference_factorization {R : Type*} [CommRing R] [IsDomain R]
    {p a r : ℕ} [hp : Fact p.Prime] {ζ : R} (hζ : IsPrimitiveRoot ζ (p ^ a)) (hr : r ≤ a)
    (b : ℕ) :
    1 - ζ ^ (b * p ^ r) =
      ∏ j ∈ Finset.range (p ^ r), (1 - ζ ^ (b + j * p ^ (a - r))) := by
  have hξ : IsPrimitiveRoot (ζ ^ (p ^ (a - r))) (p ^ r) :=
    IsPrimitiveRoot.pow (pow_pos hp.out.pos a) hζ (by rw [← pow_add, Nat.sub_add_cancel hr])
  have heval := congrArg (Polynomial.eval 1)
    (X_pow_sub_C_eq_prod hξ (pow_pos hp.out.pos r) (rfl : (ζ ^ b) ^ (p ^ r) = _))
  simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
    one_pow, Polynomial.eval_prod] at heval
  rw [← pow_mul] at heval
  rw [heval]
  refine Finset.prod_congr rfl fun j _ ↦ ?_
  rw [← pow_mul, ← pow_add, mul_comm (p ^ (a - r)) j, add_comm]

/-- For an odd prime `p`, the prime-power difference factorization also holds with reversed signs
`ζ ^ (b * p ^ r) - 1 = ∏ j < p ^ r, (ζ ^ (b + j * p ^ (a - r)) - 1)`. -/
theorem primePowerDifference_factorization_sub_one {R : Type*} [CommRing R] [IsDomain R]
    {p a r : ℕ} [hp : Fact p.Prime] (hodd : Odd p) {ζ : R} (hζ : IsPrimitiveRoot ζ (p ^ a))
    (hr : r ≤ a) (b : ℕ) :
    ζ ^ (b * p ^ r) - 1 =
      ∏ j ∈ Finset.range (p ^ r), (ζ ^ (b + j * p ^ (a - r)) - 1) := by
  calc ζ ^ (b * p ^ r) - 1 = -(1 - ζ ^ (b * p ^ r)) := by ring
    _ = (-1 : R) ^ (p ^ r) *
          ∏ j ∈ Finset.range (p ^ r), (1 - ζ ^ (b + j * p ^ (a - r))) := by
        rw [primePowerDifference_factorization hζ hr b, hodd.pow.neg_one_pow, neg_one_mul]
    _ = (∏ _j ∈ Finset.range (p ^ r), (-1 : R)) *
          ∏ j ∈ Finset.range (p ^ r), (1 - ζ ^ (b + j * p ^ (a - r))) := by
        rw [Finset.prod_const, Finset.card_range]
    _ = ∏ j ∈ Finset.range (p ^ r), (ζ ^ (b + j * p ^ (a - r)) - 1) := by
        rw [← Finset.prod_mul_distrib]
        exact Finset.prod_congr rfl fun j _ ↦ by ring

end Factorization

section ValuationAndRatios

variable {p k : ℕ} [hp : Fact p.Prime] {K : Type*} [Field K] [NumberField K]
  [hK : IsCyclotomicExtension {p ^ (k + 1)} ℚ K]

/-- **Valuation of primitive differences.** In a `p ^ (k + 1)`-th cyclotomic field, for every
prime `w` of `𝓞 K` lying over `(p)` and every `b : ℕ` coprime to `p ^ (k + 1)`, the primitive
difference `ζ ^ b - 1` has `w`-adic valuation `WithZero.exp (-1)`. -/
theorem primitiveDifference_primeValuation {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1)))
    (w : HeightOneSpectrum (𝓞 K)) [w.asIdeal.LiesOver (Ideal.span {(p : ℤ)})]
    {b : ℕ} (hb : b.Coprime (p ^ (k + 1))) :
    w.intValuation (hζ.toInteger ^ b - 1) = WithZero.exp (-1) := by
  have : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero (k + 1) hp.out.ne_zero⟩
  have hP : w.asIdeal = Ideal.span {hζ.toInteger - 1} :=
    IsCyclotomicExtension.Rat.eq_span_zeta_sub_one_of_liesOver p k K hζ w.asIdeal
  have hspan : w.asIdeal = Ideal.span {hζ.toInteger ^ b - 1} :=
    hP.trans (Ideal.span_singleton_eq_span_singleton.mpr
      (hζ.toInteger_isPrimitiveRoot.associated_sub_one_pow_sub_one_of_coprime hb))
  have hne : hζ.toInteger ^ b - 1 ≠ 0 := fun h0 ↦
    w.ne_bot (hspan.trans (by rw [h0, Ideal.span_singleton_zero]))
  exact w.intValuation_singleton hne hspan

omit [NumberField K] hK in
/-- Every primitive difference `1 - ζ ^ c` (`¬ p ∣ c`) belongs to the subgroup generated by
`torsion K`, `cyclotomicRatioUnit`s, and `1 - ζ`. -/
private theorem exists_mem_ratios_sup_zpowers_val_eq_one_sub_pow {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) (hζ1 : 1 - ζ ≠ 0) {c : ℕ} (hp_ndvd : ¬ p ∣ c) :
    let h2 : 2 ≤ p ^ (k + 1) := le_trans hp.out.two_le (Nat.le_self_pow (Nat.succ_ne_zero k) p)
    let R : Subgroup (𝓞 K)ˣ := torsion K ⊔ Subgroup.closure
      {u | ∃ (b : ℤ) (hb : Int.gcd b (p ^ (k + 1)) = 1), u = cyclotomicRatioUnit h2 hζ hb}
    ∃ w : Kˣ,
      w ∈ R.map (Units.map (algebraMap (𝓞 K) K).toMonoidHom) ⊔
        Subgroup.zpowers (Units.mk0 (1 - ζ) hζ1) ∧
      (w : K) = 1 - ζ ^ c := by
  intro h2 R
  set ιK : (𝓞 K)ˣ →* Kˣ := Units.map (algebraMap (𝓞 K) K).toMonoidHom
  set π : Kˣ := Units.mk0 (1 - ζ) hζ1
  set M : Subgroup Kˣ := R.map ιK ⊔ Subgroup.zpowers π
  have hc_gcd : Int.gcd (c : ℤ) (p ^ (k + 1)) = 1 := by
    simpa [Int.gcd] using
      ((hp.out.coprime_iff_not_dvd.mpr hp_ndvd).symm.pow_right (k + 1)).gcd_eq_one
  set q : (𝓞 K)ˣ := cyclotomicRatioUnit h2 hζ hc_gcd
  have hq_mem : q ∈ R := Subgroup.mem_sup_right (Subgroup.subset_closure ⟨(c : ℤ), hc_gcd, rfl⟩)
  refine ⟨π * ιK q, M.mul_mem (Subgroup.mem_sup_right (Subgroup.mem_zpowers π))
    (Subgroup.mem_sup_left (Subgroup.mem_map_of_mem _ hq_mem)), ?_⟩
  have hζ_ne1 : ζ - 1 ≠ 0 := hζ.sub_one_ne_zero (by omega)
  have hq_coe : ((ιK q : Kˣ) : K) = cyclotomicRatio ζ (c : ℤ) := by
    simp [ιK, q, ← RingOfIntegers.coe_eq_algebraMap]
  simp only [π, Units.val_mul, Units.val_mk0, hq_coe, cyclotomicRatio_def, zpow_natCast]
  field_simp [hζ_ne1]; ring

omit [NumberField K] hK in
/-- Prime-power circular numbers lie in the subgroup generated by roots of unity, cyclotomic ratio
units, and the uniformizer `1 - ζ`. -/
private theorem cyclotomicNumbers_le_ratios_sup_zpowers {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) (hζ1 : 1 - ζ ≠ 0) :
    let h2 : 2 ≤ p ^ (k + 1) := le_trans hp.out.two_le (Nat.le_self_pow (Nat.succ_ne_zero k) p)
    let R : Subgroup (𝓞 K)ˣ := torsion K ⊔ Subgroup.closure
      {u | ∃ (b : ℤ) (hb : Int.gcd b (p ^ (k + 1)) = 1), u = cyclotomicRatioUnit h2 hζ hb}
    cyclotomicNumbers ζ (p ^ (k + 1)) ≤
      R.map (Units.map (algebraMap (𝓞 K) K).toMonoidHom) ⊔
        Subgroup.zpowers (Units.mk0 (1 - ζ) hζ1) := by
  have : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero (k + 1) hp.out.ne_zero⟩
  intro h2 R
  set ιK : (𝓞 K)ˣ →* Kˣ := Units.map (algebraMap (𝓞 K) K).toMonoidHom
  set M : Subgroup Kˣ := R.map ιK ⊔ Subgroup.zpowers (Units.mk0 (1 - ζ) hζ1)
  rw [cyclotomicNumbers_def, Subgroup.closure_le]
  -- Check membership on each of the three generator families: `-1`, `ζ`, and `1 - ζ ^ m`.
  rintro u (hu | hu | ⟨m, hm0, hm_lt, hu⟩)
  · -- Case 1: `u = -1`, which comes from `torsion K`.
    exact (Units.ext (by simpa [ιK] using hu) : u = ιK (-1)) ▸
      Subgroup.mem_sup_left (Subgroup.mem_map_of_mem _ (Subgroup.mem_sup_left neg_one_mem_torsion))
  · -- Case 2: `u = ζ`, which also comes from `torsion K`.
    set ζu : (𝓞 K)ˣ :=
      (hζ.toInteger_isPrimitiveRoot.isUnit (pow_ne_zero (k + 1) hp.out.ne_zero)).unit
    have hζu_tors : ζu ∈ torsion K := isOfFinOrder_iff_pow_eq_one.mpr
      ⟨p ^ (k + 1), pow_pos hp.out.pos _,
        Units.ext (by simpa [ζu] using hζ.toInteger_isPrimitiveRoot.pow_eq_one)⟩
    have hζeq : u = ιK ζu := Units.ext (by
      have hcoe : (hζ.toInteger : K) = ζ := hζ.coe_toInteger
      simp [ιK, ζu, hu, hcoe])
    exact hζeq ▸ Subgroup.mem_sup_left (Subgroup.mem_map_of_mem _ (Subgroup.mem_sup_left hζu_tors))
  · -- Case 3: `u = 1 - ζ ^ m`; write `m = b * p ^ r` with `p ∤ b` and factor into primitive terms.
    set r : ℕ := m.factorization p
    set b : ℕ := m / p ^ r
    have hpr_dvd : p ^ r ∣ m := Nat.ordProj_dvd m p
    have hm_eq : m = b * p ^ r := by
      rw [mul_comm]; exact (Nat.ordProj_mul_ordCompl_eq_self m p).symm
    have hr_lt : r < k + 1 := by
      by_contra hge
      have hle : p ^ (k + 1) ≤ m :=
        (Nat.pow_le_pow_right hp.out.pos (by omega)).trans (Nat.le_of_dvd hm0 hpr_dvd)
      omega
    have hp_ndvd_b : ¬ p ∣ b := Nat.not_dvd_ordCompl hp.out hm0.ne'
    have hterm (j : ℕ) : ∃ w : Kˣ, w ∈ M ∧ (w : K) = 1 - ζ ^ (b + j * p ^ (k + 1 - r)) :=
      exists_mem_ratios_sup_zpowers_val_eq_one_sub_pow hζ hζ1 fun hpc ↦
        hp_ndvd_b ((Nat.dvd_add_left (dvd_mul_of_dvd_right (dvd_pow_self p (by omega)) j)).mp hpc)
    choose w hw_mem hw_val using hterm
    have hu_eq : u = ∏ j ∈ Finset.range (p ^ r), w j := by
      ext
      rw [hu, hm_eq, primePowerDifference_factorization hζ (le_of_lt hr_lt) b, Units.coe_prod]
      exact Finset.prod_congr rfl fun j _ ↦ (hw_val j).symm
    exact hu_eq ▸ M.prod_mem fun j _ ↦ hw_mem j

/-- **Generation of prime-power circular units by roots of unity and ratios.** For every prime `p`
and `k : ℕ`, `cyclotomicUnits K ζ (p ^ (k + 1))` is generated by `torsion K` and the ratio units
`cyclotomicRatioUnit` for `gcd(b, p ^ (k + 1)) = 1`. -/
theorem cyclotomicUnits_eq_torsion_sup_closure_ratios {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) :
    cyclotomicUnits K ζ (p ^ (k + 1)) =
      torsion K ⊔ Subgroup.closure
        {u | ∃ (b : ℤ) (hb : Int.gcd b (p ^ (k + 1)) = 1),
          u = cyclotomicRatioUnit
            (le_trans hp.out.two_le (Nat.le_self_pow (Nat.succ_ne_zero k) p)) hζ hb} := by
  have : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero (k + 1) hp.out.ne_zero⟩
  have h2 : 2 ≤ p ^ (k + 1) := le_trans hp.out.two_le (Nat.le_self_pow (Nat.succ_ne_zero k) p)
  set R : Subgroup (𝓞 K)ˣ :=
    torsion K ⊔ Subgroup.closure
      {u | ∃ (b : ℤ) (hb : Int.gcd b (p ^ (k + 1)) = 1), u = cyclotomicRatioUnit h2 hζ hb}
  refine le_antisymm ?_ ?_
  · -- Write an integral circular unit `u` as `r * (1 - ζ) ^ n` with `r ∈ R`.
    have hζ1 : 1 - ζ ≠ 0 := sub_ne_zero.mpr (hζ.ne_one (by omega)).symm
    have hnum_le := cyclotomicNumbers_le_ratios_sup_zpowers hζ hζ1
    intro u hu
    obtain ⟨_, ⟨r, hr, rfl⟩, _, ⟨n, rfl⟩, hab⟩ :=
      Subgroup.mem_sup.mp (hnum_le ((mem_cyclotomicUnits_iff u).mp hu))
    -- Take the valuation at `w = (ζ - 1)` to force `n = 0`.
    let w : HeightOneSpectrum (𝓞 K) :=
      ⟨Ideal.span {hζ.toInteger - 1},
        IsCyclotomicExtension.Rat.isPrime_span_zeta_sub_one p k hζ,
        IsCyclotomicExtension.Rat.span_zeta_sub_one_ne_bot p k hζ⟩
    have hw_val_unit (v : (𝓞 K)ˣ) :
        w.valuation K ((Units.map (algebraMap (𝓞 K) K).toMonoidHom v : Kˣ) : K) = 1 := by
      have h1 : w.intValuation (v : 𝓞 K) = 1 :=
        HeightOneSpectrum.intValuation_eq_one_iff.mpr fun hmem ↦
          w.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem v.isUnit)
      simpa using (w.valuation_of_algebraMap (K := K) (v : 𝓞 K)).trans h1
    have hw_val_π : w.valuation K (Units.mk0 (1 - ζ) hζ1 : K) = WithZero.exp (-1) := by
      have hcoe : algebraMap (𝓞 K) K (1 - hζ.toInteger) = (Units.mk0 (1 - ζ) hζ1 : K) := by
        have hc : (hζ.toInteger : K) = ζ := hζ.coe_toInteger
        simp [← RingOfIntegers.coe_eq_algebraMap, hc]
      rw [← hcoe, w.valuation_of_algebraMap (K := K)]
      have hspan : w.asIdeal = Ideal.span {1 - hζ.toInteger} :=
        Ideal.span_singleton_eq_span_singleton.mpr ⟨-1, by simp⟩
      have hne : (1 - hζ.toInteger : 𝓞 K) ≠ 0 := fun h0 ↦
        hζ1 (by simpa [hcoe] using congrArg (algebraMap (𝓞 K) K) h0)
      exact w.intValuation_singleton hne hspan
    have hval_eq := congrArg (fun x : Kˣ ↦ w.valuation K (x : K)) hab
    simp only [Units.val_mul, map_mul, Units.val_zpow_eq_zpow_val, map_zpow₀, hw_val_unit,
      hw_val_π, one_mul] at hval_eq
    have hn0 : n = 0 := by
      have hexp : WithZero.exp (-n) = WithZero.exp (0 : ℤ) := by
        rw [← WithZero.exp_zsmul] at hval_eq; simpa using hval_eq
      have hneg : -n = 0 := WithZero.exp_injective hexp
      omega
    subst hn0
    simp only [zpow_zero, mul_one] at hab
    exact (Units.ext (RingOfIntegers.coe_injective (congrArg Units.val hab)) : r = u) ▸ hr
  · refine sup_le (torsion_le_cyclotomicUnits p (k + 1) hζ) ?_
    rw [Subgroup.closure_le]
    rintro u ⟨b, hb, rfl⟩
    exact cyclotomicRatioUnit_mem_cyclotomicUnits h2 hζ hb

end ValuationAndRatios

section PhaseRealHelpers

private theorem coe_phase_mul_ratio {K : Type*} [Field K] {n : ℕ} [NeZero n] (hn : 2 ≤ n)
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) {b : ℤ} (hb : Int.gcd b n = 1) (e : ℤ) :
    algebraMap (𝓞 K) K
      (((hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne n)).unit ^ e *
        cyclotomicRatioUnit hn hζ hb : (𝓞 K)ˣ) : 𝓞 K) =
      ζ ^ e * cyclotomicRatio ζ b := by
  set ζu : (𝓞 K)ˣ := (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne n)).unit
  have hzpow : algebraMap (𝓞 K) K ((ζu ^ e : (𝓞 K)ˣ) : 𝓞 K) = ζ ^ e := by
    have hmap := ((algebraMap (𝓞 K) K).toMonoidHom.comp (Units.coeHom (𝓞 K))).map_zpow ζu e
    have hcoe : ((ζu : 𝓞 K) : K) = ζ := hζ.coe_toInteger
    simpa [RingOfIntegers.coe_eq_algebraMap, Units.coeHom_apply, hcoe] using hmap
  rw [Units.val_mul, map_mul, hzpow, ← RingOfIntegers.coe_eq_algebraMap, coe_cyclotomicRatioUnit]

private theorem complexConj_phase_mul_ratio {K : Type*} [Field K] [NumberField K] [IsCMField K]
    {n : ℕ} [NeZero n] (hn : 2 < n) {ζ : K} (hζ : IsPrimitiveRoot ζ n)
    {b : ℤ} (hb : Int.gcd b n = 1) {e : ℤ} (he : 2 * e ≡ 1 - b [ZMOD (n : ℕ)]) :
    let u : (𝓞 K)ˣ :=
      (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne n)).unit ^ e *
        cyclotomicRatioUnit (le_of_lt hn) hζ hb
    IsCMField.complexConj K (u : K) = (u : K) := by
  intro u
  have hζ0 : ζ ≠ 0 := hζ.ne_zero (by omega)
  have hζ1 : ζ ≠ 1 := hζ.ne_one (by omega)
  have hconj_ζ : IsCMField.complexConj K ζ = ζ⁻¹ := by
    set ζu : (𝓞 K)ˣ := (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne n)).unit
    have hζu_mem : ζu ∈ torsion K := isOfFinOrder_iff_pow_eq_one.mpr
      ⟨n, by omega, Units.ext (by simpa [ζu] using hζ.toInteger_isPrimitiveRoot.pow_eq_one)⟩
    have hcoe : ((ζu : 𝓞 K) : K) = ζ := hζ.coe_toInteger
    simpa [hcoe] using IsCMField.complexConj_torsion K ⟨ζu, hζu_mem⟩
  have hconj_ratio : IsCMField.complexConj K (cyclotomicRatio ζ b) =
      ζ ^ (1 - b) * cyclotomicRatio ζ b := by
    have hsub : ζ - 1 ≠ 0 := sub_ne_zero.mpr hζ1
    have hinv_sub : ζ⁻¹ - 1 ≠ 0 := sub_ne_zero.mpr fun h ↦ hζ1 (inv_eq_one.mp h)
    have hzb0 : ζ ^ b ≠ 0 := zpow_ne_zero b hζ0
    rw [cyclotomicRatio_def, map_div₀, map_sub, map_sub, map_one, map_zpow₀,
      hconj_ζ, inv_zpow', zpow_sub₀ hζ0, zpow_one, zpow_neg]
    field_simp [hζ0, hsub, hinv_sub, hzb0]; ring
  have hpow : ζ ^ (-e + (1 - b)) = ζ ^ e :=
    (div_eq_one_iff_eq (zpow_ne_zero e hζ0)).mp (by
      rw [← zpow_sub₀ hζ0, hζ.zpow_eq_one_iff_dvd]
      have hdvd : ((n : ℕ) : ℤ) ∣ 1 - b - 2 * e := Int.modEq_iff_dvd.mp he
      have heq : -e + (1 - b) - e = 1 - b - 2 * e := by ring
      rwa [heq])
  rw [coe_phase_mul_ratio (le_of_lt hn) hζ hb e, map_mul, map_zpow₀, hconj_ζ, hconj_ratio,
    inv_zpow', ← mul_assoc, ← zpow_add₀ hζ0, hpow]

/-- Shared real-unit constructor for both odd-prime and dyadic smoothed circular units: given
`2 * e ≡ 1 - b [ZMOD n]`, returns the unique unit in `(𝓞 K⁺)ˣ` with image
`ζ ^ e * cyclotomicRatio ζ b`. -/
private noncomputable def phaseRealUnit {K : Type*} [Field K] [NumberField K] [IsCMField K]
    {n : ℕ} (hn : 2 < n) {ζ : K} (hζ : IsPrimitiveRoot ζ n) {b : ℤ} (hb : Int.gcd b n = 1)
    (e : ℤ) (he : 2 * e ≡ 1 - b [ZMOD (n : ℕ)]) : (𝓞 (maximalRealSubfield K))ˣ :=
  letI : NeZero n := ⟨by omega⟩
  let u : (𝓞 K)ˣ :=
    (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne n)).unit ^ e *
      cyclotomicRatioUnit (le_of_lt hn) hζ hb
  ((IsCMField.Units.complexConj_eq_self_iff K u).mp
    (complexConj_phase_mul_ratio hn hζ hb he)).choose

private theorem coe_phaseRealUnit {K : Type*} [Field K] [NumberField K] [IsCMField K]
    {n : ℕ} (hn : 2 < n) {ζ : K} (hζ : IsPrimitiveRoot ζ n) {b : ℤ} (hb : Int.gcd b n = 1)
    (e : ℤ) (he : 2 * e ≡ 1 - b [ZMOD (n : ℕ)]) :
    (((phaseRealUnit hn hζ hb e he : 𝓞 (maximalRealSubfield K)) : maximalRealSubfield K) : K) =
      ζ ^ e * cyclotomicRatio ζ b := by
  have : NeZero n := ⟨by omega⟩
  set u : (𝓞 K)ˣ :=
    (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne n)).unit ^ e *
      cyclotomicRatioUnit (le_of_lt hn) hζ hb
  have hspec : algebraMap (𝓞 (maximalRealSubfield K)) K (phaseRealUnit hn hζ hb e he) = u :=
    ((IsCMField.Units.complexConj_eq_self_iff K u).mp
      (complexConj_phase_mul_ratio hn hζ hb he)).choose_spec
  exact hspec.trans (coe_phase_mul_ratio (le_of_lt hn) hζ hb e)

private theorem phaseRealUnit_mem_realCyclotomicUnits {K : Type*} [Field K] [NumberField K]
    [IsCMField K] {n : ℕ} (hn : 2 < n) {ζ : K} (hζ : IsPrimitiveRoot ζ n) {b : ℤ}
    (hb : Int.gcd b n = 1) (e : ℤ) (he : 2 * e ≡ 1 - b [ZMOD (n : ℕ)]) :
    phaseRealUnit hn hζ hb e he ∈ realCyclotomicUnits K ζ n := by
  have : NeZero n := ⟨by omega⟩
  set ζu : (𝓞 K)ˣ := (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne n)).unit
  rw [mem_realCyclotomicUnits_iff]
  have heq : Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
      (phaseRealUnit hn hζ hb e he) = ζu ^ e * cyclotomicRatioUnit (le_of_lt hn) hζ hb := by
    refine Units.ext (RingOfIntegers.coe_injective ?_)
    rw [coe_phase_mul_ratio (le_of_lt hn) hζ hb e]
    exact coe_phaseRealUnit hn hζ hb e he
  exact heq ▸ mul_mem (zpow_mem (toInteger_unit_mem_cyclotomicUnits hζ) e)
    (cyclotomicRatioUnit_mem_cyclotomicUnits (le_of_lt hn) hζ hb)

private theorem cyclotomicRatioUnit_mem_torsion_sup_phaseRealUnit {K : Type*} [Field K]
    [NumberField K] [IsCMField K] {n : ℕ} (hn : 2 < n) {ζ : K} (hζ : IsPrimitiveRoot ζ n)
    {b : ℤ} (hb : Int.gcd b n = 1) (e : ℤ) (he : 2 * e ≡ 1 - b [ZMOD (n : ℕ)])
    {S : Subgroup (𝓞 (maximalRealSubfield K))ˣ} (hmem : phaseRealUnit hn hζ hb e he ∈ S) :
    cyclotomicRatioUnit (le_of_lt hn) hζ hb ∈
      torsion K ⊔ S.map (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) := by
  have : NeZero n := ⟨by omega⟩
  set ζu : (𝓞 K)ˣ := (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne n)).unit
  have hζu_tors : ζu ∈ torsion K := isOfFinOrder_iff_pow_eq_one.mpr
    ⟨n, by omega, Units.ext (by simpa [ζu] using hζ.toInteger_isPrimitiveRoot.pow_eq_one)⟩
  have hmul : cyclotomicRatioUnit (le_of_lt hn) hζ hb =
      ζu ^ (-e) * Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
        (phaseRealUnit hn hζ hb e he) := by
    refine Units.ext (RingOfIntegers.coe_injective ?_)
    have hmap := ((algebraMap (𝓞 K) K).toMonoidHom.comp (Units.coeHom (𝓞 K))).map_zpow ζu (-e)
    have hcoe : ((ζu : 𝓞 K) : K) = ζ := hζ.coe_toInteger
    have hzpow : algebraMap (𝓞 K) K ((ζu ^ (-e) : (𝓞 K)ˣ) : 𝓞 K) = ζ ^ (-e) := by
      simpa [RingOfIntegers.coe_eq_algebraMap, Units.coeHom_apply, hcoe] using hmap
    have hreal : algebraMap (𝓞 K) K
        ((Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
          (phaseRealUnit hn hζ hb e he) : (𝓞 K)ˣ) : 𝓞 K) = ζ ^ e * cyclotomicRatio ζ b :=
      coe_phaseRealUnit hn hζ hb e he
    rw [Units.val_mul, map_mul, hzpow, hreal, ← RingOfIntegers.coe_eq_algebraMap,
      coe_cyclotomicRatioUnit, ← mul_assoc, ← zpow_add₀ (hζ.ne_zero (by omega)), neg_add_cancel,
      zpow_zero, one_mul]
  exact hmul ▸ Subgroup.mul_mem_sup (zpow_mem hζu_tors (-e)) (Subgroup.mem_map_of_mem _ hmem)

end PhaseRealHelpers

private theorem odd_prime_pow_half_modEq {p k : ℕ} (hodd : Odd p) :
    2 * (((p ^ (k + 1) + 1) / 2 : ℕ) : ℤ) ≡ 1 [ZMOD (p ^ (k + 1) : ℕ)] := by
  obtain ⟨m, hm⟩ := hodd.pow (n := k + 1)
  have hnat : 2 * ((p ^ (k + 1) + 1) / 2) = p ^ (k + 1) + 1 := by omega
  have hint : 2 * (((p ^ (k + 1) + 1) / 2 : ℕ) : ℤ) = ((p ^ (k + 1) : ℕ) : ℤ) + 1 := by
    exact_mod_cast hnat
  exact Int.modEq_iff_dvd.mpr ⟨-1, by linarith⟩

section OddSmoothedUnits

variable {p k : ℕ} [hp : Fact p.Prime] {K : Type*} [Field K] [NumberField K]
  [hK : IsCyclotomicExtension {p ^ (k + 1)} ℚ K]

private theorem odd_prime_pow_gt_two (hodd : Odd p) : 2 < p ^ (k + 1) := by
  have hp3 : 3 ≤ p := by have := hp.out.two_le; obtain ⟨m, hm⟩ := hodd; omega
  exact lt_of_lt_of_le (by omega) (le_trans hp3 (Nat.le_self_pow (Nat.succ_ne_zero k) p))

/-- **Smoothed real circular units (odd prime).** For an odd prime `p`, a primitive `p ^ (k + 1)`-th
root of unity `ζ`, and `b : ℤ` coprime to `p ^ (k + 1)`, `smoothedCyclotomicUnit hodd hζ hb` is the
unique integral unit of `K⁺` whose image in `K` equals
`ζ ^ (h * (1 - b)) * (ζ ^ b - 1) / (ζ - 1)` for any integer `h` with
`2 * h ≡ 1 [ZMOD p ^ (k + 1)]`. -/
noncomputable def smoothedCyclotomicUnit (hodd : Odd p) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) {b : ℤ} (hb : Int.gcd b (p ^ (k + 1)) = 1) :
    (𝓞 (maximalRealSubfield K))ˣ :=
  letI : IsCMField K := IsCyclotomicExtension.Rat.isCMField K (S := {p ^ (k + 1)})
    ⟨p ^ (k + 1), Set.mem_singleton _, odd_prime_pow_gt_two hodd⟩
  phaseRealUnit (odd_prime_pow_gt_two hodd) hζ hb
    ((((p ^ (k + 1) + 1) / 2 : ℕ) : ℤ) * (1 - b))
    (by simpa [mul_assoc] using (odd_prime_pow_half_modEq (k := k) hodd).mul_right (1 - b))

/-- **Value and representative independence of `smoothedCyclotomicUnit`.** For ANY integer `h`
satisfying `2 * h ≡ 1 [ZMOD p ^ (k + 1)]`, the image in `K` of `smoothedCyclotomicUnit hodd hζ hb`
is `ζ ^ (h * (1 - b)) * cyclotomicRatio ζ b`. -/
theorem coe_smoothedCyclotomicUnit (hodd : Odd p) {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1)))
    {b : ℤ} (hb : Int.gcd b (p ^ (k + 1)) = 1) {h : ℤ}
    (hh : 2 * h ≡ 1 [ZMOD (p ^ (k + 1) : ℕ)]) :
    (((smoothedCyclotomicUnit hodd hζ hb : 𝓞 (maximalRealSubfield K)) :
        maximalRealSubfield K) : K) =
      ζ ^ (h * (1 - b)) * cyclotomicRatio ζ b := by
  have : IsCMField K := IsCyclotomicExtension.Rat.isCMField K (S := {p ^ (k + 1)})
    ⟨p ^ (k + 1), Set.mem_singleton _, odd_prime_pow_gt_two hodd⟩
  rw [smoothedCyclotomicUnit, coe_phaseRealUnit]
  congr 1
  set h₀ : ℤ := (((p ^ (k + 1) + 1) / 2 : ℕ) : ℤ)
  have hdvd2 : ((p ^ (k + 1) : ℕ) : ℤ) ∣ 2 * (h - h₀) := by
    simpa [h₀, mul_sub] using
      Int.modEq_iff_dvd.mp ((odd_prime_pow_half_modEq (k := k) hodd).trans hh.symm)
  have hcop2 : IsCoprime ((p ^ (k + 1) : ℕ) : ℤ) 2 :=
    Nat.isCoprime_iff_coprime.mpr (Nat.coprime_two_right.mpr hodd.pow)
  have hmod : h₀ * (1 - b) ≡ h * (1 - b) [ZMOD (p ^ (k + 1) : ℕ)] :=
    (Int.modEq_iff_dvd.mpr (hcop2.dvd_of_dvd_mul_left hdvd2)).mul_right (1 - b)
  have hζ0 : ζ ≠ 0 := hζ.ne_zero (pow_ne_zero _ hp.out.ne_zero)
  exact (div_eq_one_iff_eq (zpow_ne_zero _ hζ0)).mp
    (by rw [← zpow_sub₀ hζ0, hζ.zpow_eq_one_iff_dvd]; exact Int.modEq_iff_dvd.mp hmod.symm)

/-- Every `smoothedCyclotomicUnit` belongs to `realCyclotomicUnits K ζ (p ^ (k + 1))`. -/
theorem smoothedCyclotomicUnit_mem_realCyclotomicUnits (hodd : Odd p) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) {b : ℤ} (hb : Int.gcd b (p ^ (k + 1)) = 1) :
    smoothedCyclotomicUnit hodd hζ hb ∈ realCyclotomicUnits K ζ (p ^ (k + 1)) := by
  have : IsCMField K := IsCyclotomicExtension.Rat.isCMField K (S := {p ^ (k + 1)})
    ⟨p ^ (k + 1), Set.mem_singleton _, odd_prime_pow_gt_two hodd⟩
  exact phaseRealUnit_mem_realCyclotomicUnits (odd_prime_pow_gt_two hodd) hζ hb _ _

/-- At `b = 1`, `smoothedCyclotomicUnit` equals `1`. -/
@[simp]
theorem smoothedCyclotomicUnit_one (hodd : Odd p) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) (hb : Int.gcd (1 : ℤ) (p ^ (k + 1)) = 1) :
    smoothedCyclotomicUnit hodd hζ hb = 1 := by
  have hgt : 2 < p ^ (k + 1) := odd_prime_pow_gt_two hodd
  refine Units.ext (RingOfIntegers.coe_injective (Subtype.ext ?_))
  simpa [cyclotomicRatio_one (hζ.ne_one (by omega))] using
    coe_smoothedCyclotomicUnit hodd hζ hb (odd_prime_pow_half_modEq (k := k) hodd)

/-- At `b = -1`, `smoothedCyclotomicUnit` equals `-1`. -/
@[simp]
theorem smoothedCyclotomicUnit_neg_one (hodd : Odd p) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) (hb : Int.gcd (-1 : ℤ) (p ^ (k + 1)) = 1) :
    smoothedCyclotomicUnit hodd hζ hb = -1 := by
  have hgt : 2 < p ^ (k + 1) := odd_prime_pow_gt_two hodd
  have hζ0 : ζ ≠ 0 := hζ.ne_zero (by omega)
  refine Units.ext (RingOfIntegers.coe_injective (Subtype.ext ?_))
  have hval := coe_smoothedCyclotomicUnit hodd hζ hb (odd_prime_pow_half_modEq (k := k) hodd)
  have hpow : ζ ^ ((((p ^ (k + 1) + 1) / 2 : ℕ) : ℤ) * (1 - -1)) = ζ := by
    have h2 : (1 - -1 : ℤ) = 2 := by norm_num
    have hmod : (((p ^ (k + 1) + 1) / 2 : ℕ) : ℤ) * (1 - -1) ≡ 1 [ZMOD (p ^ (k + 1) : ℕ)] := by
      simpa [h2, mul_comm] using odd_prime_pow_half_modEq (k := k) hodd
    have heq := (div_eq_one_iff_eq (zpow_ne_zero 1 hζ0)).mp
      (by rw [← zpow_sub₀ hζ0, hζ.zpow_eq_one_iff_dvd]; exact Int.modEq_iff_dvd.mp hmod.symm)
    simpa using heq
  rw [hpow, cyclotomicRatio_neg_one hζ0 (hζ.ne_one (by omega))] at hval
  simpa [mul_inv_cancel₀ hζ0] using hval

/-- `smoothedCyclotomicUnit` depends only on `b` modulo `p ^ (k + 1)`. -/
theorem smoothedCyclotomicUnit_modEq (hodd : Odd p) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) {a b : ℤ}
    (ha : Int.gcd a (p ^ (k + 1)) = 1) (hb : Int.gcd b (p ^ (k + 1)) = 1)
    (hab : a ≡ b [ZMOD (p ^ (k + 1) : ℕ)]) :
    smoothedCyclotomicUnit hodd hζ ha = smoothedCyclotomicUnit hodd hζ hb := by
  have h2h := odd_prime_pow_half_modEq (p := p) (k := k) hodd
  have hζ0 : ζ ≠ 0 := hζ.ne_zero (pow_ne_zero _ hp.out.ne_zero)
  refine Units.ext (RingOfIntegers.coe_injective (Subtype.ext ?_))
  rw [coe_smoothedCyclotomicUnit hodd hζ ha h2h, coe_smoothedCyclotomicUnit hodd hζ hb h2h,
    cyclotomicRatio_modEq (pow_pos hp.out.pos _) hζ.pow_eq_one hab]
  congr 1
  exact (div_eq_one_iff_eq (zpow_ne_zero _ hζ0)).mp (by
    rw [← zpow_sub₀ hζ0, hζ.zpow_eq_one_iff_dvd]
    exact Int.modEq_iff_dvd.mp (((Int.ModEq.refl 1).sub hab).mul_left _).symm)

/-- **Galois cocycle law for smoothed circular units.** If `σ : K ≃ₐ[ℚ] K` sends `ζ` to `ζ ^ c`,
then its restriction `σ⁺` to `K⁺` satisfies `σ⁺(γ(b)) * γ(c) = γ(b * c)`. -/
theorem smoothedCyclotomicUnit_mul [Normal ℚ (maximalRealSubfield K)] (hodd : Odd p) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) {b c : ℤ}
    (hb : Int.gcd b (p ^ (k + 1)) = 1) (hc : Int.gcd c (p ^ (k + 1)) = 1)
    (hbc : Int.gcd (b * c) (p ^ (k + 1)) = 1)
    (σ : K ≃ₐ[ℚ] K) (hσ : σ ζ = ζ ^ c) :
    Units.map (RingOfIntegers.mapRingEquiv
        (σ.restrictNormal (maximalRealSubfield K)).toRingEquiv).toMonoidHom
      (smoothedCyclotomicUnit hodd hζ hb) * smoothedCyclotomicUnit hodd hζ hc =
        smoothedCyclotomicUnit hodd hζ hbc := by
  have hgt : 2 < p ^ (k + 1) := odd_prime_pow_gt_two hodd
  set h₀ : ℤ := (((p ^ (k + 1) + 1) / 2 : ℕ) : ℤ)
  have h2h := odd_prime_pow_half_modEq (p := p) (k := k) hodd
  have hζ0 : ζ ≠ 0 := hζ.ne_zero (by omega)
  have hζ1 : ζ ≠ 1 := hζ.ne_one (by omega)
  have hζc1 : ζ ^ c ≠ 1 := fun h1 ↦ by
    have hgcd : p ^ (k + 1) ∣ Int.gcd c (p ^ (k + 1)) :=
      Int.dvd_gcd ((hζ.zpow_eq_one_iff_dvd c).mp h1) (dvd_refl _)
    rw [hc] at hgcd
    exact absurd (Nat.le_of_dvd one_pos hgcd) (by omega)
  have hσ_ratio : σ (cyclotomicRatio ζ b) = cyclotomicRatio (ζ ^ c) b := by
    simp only [cyclotomicRatio_def, map_div₀, map_sub, map_one, map_zpow₀, hσ]
  have hcomm : (((σ.restrictNormal (maximalRealSubfield K))
      ((smoothedCyclotomicUnit hodd hζ hb : 𝓞 (maximalRealSubfield K)) :
        maximalRealSubfield K) : maximalRealSubfield K) : K) =
      σ (((smoothedCyclotomicUnit hodd hζ hb : 𝓞 (maximalRealSubfield K)) :
        maximalRealSubfield K) : K) :=
    AlgEquiv.restrictNormal_commutes σ (maximalRealSubfield K) _
  refine Units.ext (RingOfIntegers.coe_injective (Subtype.ext ?_))
  calc (((Units.map (RingOfIntegers.mapRingEquiv
            (σ.restrictNormal (maximalRealSubfield K)).toRingEquiv).toMonoidHom
          (smoothedCyclotomicUnit hodd hζ hb) * smoothedCyclotomicUnit hodd hζ hc :
          𝓞 (maximalRealSubfield K)) : maximalRealSubfield K) : K)
      = σ (((smoothedCyclotomicUnit hodd hζ hb : 𝓞 (maximalRealSubfield K)) :
            maximalRealSubfield K) : K) *
        (((smoothedCyclotomicUnit hodd hζ hc : 𝓞 (maximalRealSubfield K)) :
            maximalRealSubfield K) : K) := by
        simp [RingOfIntegers.mapRingEquiv_apply, hcomm]
    _ = (ζ ^ (c * (h₀ * (1 - b))) * ζ ^ (h₀ * (1 - c))) *
        (cyclotomicRatio (ζ ^ c) b * cyclotomicRatio ζ c) := by
        rw [coe_smoothedCyclotomicUnit hodd hζ hb h2h, coe_smoothedCyclotomicUnit hodd hζ hc h2h,
          map_mul, map_zpow₀, hσ, ← zpow_mul, hσ_ratio]; ring
    _ = ζ ^ (h₀ * (1 - b * c)) * cyclotomicRatio ζ (b * c) := by
        rw [← zpow_add₀ hζ0, ← cyclotomicRatio_mul hζ1 hζc1]; congr 2; ring
    _ = (((smoothedCyclotomicUnit hodd hζ hbc : 𝓞 (maximalRealSubfield K)) :
          maximalRealSubfield K) : K) := (coe_smoothedCyclotomicUnit hodd hζ hbc h2h).symm

/-- **Generation of real circular units (odd prime).** For an odd prime `p`,
`realCyclotomicUnits K ζ (p ^ (k + 1))` is generated by `-1` and the smoothed real generators
`smoothedCyclotomicUnit hodd hζ hb`. -/
theorem realCyclotomicUnits_eq_closure_smoothed (hodd : Odd p) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) :
    realCyclotomicUnits K ζ (p ^ (k + 1)) =
      Subgroup.closure ({(-1 : (𝓞 (maximalRealSubfield K))ˣ)} ∪
        {v | ∃ (b : ℤ) (hb : Int.gcd b (p ^ (k + 1)) = 1),
          v = smoothedCyclotomicUnit hodd hζ hb}) := by
  have : IsCMField K := IsCyclotomicExtension.Rat.isCMField K (S := {p ^ (k + 1)})
    ⟨p ^ (k + 1), Set.mem_singleton _, odd_prime_pow_gt_two hodd⟩
  set S : Subgroup (𝓞 (maximalRealSubfield K))ˣ :=
    Subgroup.closure ({(-1 : (𝓞 (maximalRealSubfield K))ˣ)} ∪
      {v | ∃ (b : ℤ) (hb : Int.gcd b (p ^ (k + 1)) = 1), v = smoothedCyclotomicUnit hodd hζ hb})
  refine le_antisymm ?_ ?_
  · rw [realCyclotomicUnits_def]
    refine comap_realUnits_le_of_le_torsion_sup (S := S) (Subgroup.subset_closure (Or.inl rfl)) ?_
    rw [cyclotomicUnits_eq_torsion_sup_closure_ratios hζ]
    refine sup_le le_sup_left ?_
    rw [Subgroup.closure_le]
    rintro u ⟨b, hb, rfl⟩
    exact cyclotomicRatioUnit_mem_torsion_sup_phaseRealUnit (odd_prime_pow_gt_two hodd) hζ hb _ _
      (Subgroup.subset_closure (Or.inr ⟨b, hb, rfl⟩))
  · rw [Subgroup.closure_le]
    rintro v (rfl | ⟨b, hb, rfl⟩)
    · exact neg_one_mem_realCyclotomicUnits
    · exact smoothedCyclotomicUnit_mem_realCyclotomicUnits hodd hζ hb

private theorem smoothedCyclotomicUnit_pow_mem_galoisOrbit (hodd : Odd p) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) {g : (ZMod (p ^ (k + 1)))ˣ}
    {b : ℤ} (hb_cast : (b : ZMod (p ^ (k + 1))) = (g : ZMod _))
    (hb : Int.gcd b (p ^ (k + 1)) = 1) (n : ℕ)
    (hpow : Int.gcd (b ^ n) (p ^ (k + 1)) = 1) :
    smoothedCyclotomicUnit hodd hζ hpow ∈
      Subgroup.closure
        {v | ∃ τ : maximalRealSubfield K ≃ₐ[ℚ] maximalRealSubfield K,
          v = Units.map (RingOfIntegers.mapRingEquiv τ.toRingEquiv).toMonoidHom
            (smoothedCyclotomicUnit hodd hζ hb)} := by
  have : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero (k + 1) hp.out.ne_zero⟩
  have : IsAbelianGalois ℚ K := IsCyclotomicExtension.isAbelianGalois {p ^ (k + 1)} ℚ K
  have : IsAbelianGalois ℚ (maximalRealSubfield K) :=
    IsAbelianGalois.tower_bot ℚ (maximalRealSubfield K) K
  have hζ0 : ζ ≠ 0 := hζ.ne_zero (pow_ne_zero _ hp.out.ne_zero)
  induction n with
  | zero =>
    simp only [pow_zero, smoothedCyclotomicUnit_one]
    exact Subgroup.one_mem _
  | succ n ih =>
    have hpow_n : Int.gcd (b ^ n) (p ^ (k + 1)) = 1 := by
      rw [Int.gcd, Int.natAbs_pow]
      exact (Nat.Coprime.pow_left n hb).gcd_eq_one
    set u : (ZMod (p ^ (k + 1)))ˣ := g ^ n
    set σ : K ≃ₐ[ℚ] K := (IsCyclotomicExtension.Rat.galEquivZMod (p ^ (k + 1)) K).symm u
    have hσ_ζ : σ ζ = ζ ^ (b ^ n) := by
      have h1 := IsCyclotomicExtension.Rat.galEquivZMod_apply_of_pow_eq (p ^ (k + 1)) K σ
        hζ.pow_eq_one
      simp only [σ, MulEquiv.apply_symm_apply] at h1
      rw [h1, ← zpow_natCast]
      have hmod : (((u : ZMod (p ^ (k + 1))).val : ℕ) : ℤ) ≡ b ^ n [ZMOD (p ^ (k + 1) : ℕ)] :=
        (ZMod.intCast_eq_intCast_iff _ _ _).mp (by simp [u, hb_cast])
      exact (div_eq_one_iff_eq (zpow_ne_zero _ hζ0)).mp (by
        rw [← zpow_sub₀ hζ0, hζ.zpow_eq_one_iff_dvd]
        exact Int.modEq_iff_dvd.mp hmod.symm)
    have hmul_gcd : Int.gcd (b * b ^ n) (p ^ (k + 1)) = 1 := by
      rw [← pow_succ']
      exact hpow
    have hsucc := smoothedCyclotomicUnit_modEq hodd hζ hpow hmul_gcd (by rw [pow_succ' b n])
    rw [hsucc, ← smoothedCyclotomicUnit_mul hodd hζ hb hpow_n hmul_gcd σ hσ_ζ]
    exact Subgroup.mul_mem _
      (Subgroup.subset_closure ⟨σ.restrictNormal (maximalRealSubfield K), rfl⟩) (ih hpow_n)

private theorem smoothedCyclotomicUnit_mem_galoisOrbit_of_zpowers_eq_top (hodd : Odd p) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) {g : (ZMod (p ^ (k + 1)))ˣ}
    (hg : Subgroup.zpowers g = ⊤) {b : ℤ} (hb_cast : (b : ZMod (p ^ (k + 1))) = (g : ZMod _))
    (hb : Int.gcd b (p ^ (k + 1)) = 1) {c : ℤ} (hc : Int.gcd c (p ^ (k + 1)) = 1) :
    smoothedCyclotomicUnit hodd hζ hc ∈
      Subgroup.closure
        {v | ∃ τ : maximalRealSubfield K ≃ₐ[ℚ] maximalRealSubfield K,
          v = Units.map (RingOfIntegers.mapRingEquiv τ.toRingEquiv).toMonoidHom
            (smoothedCyclotomicUnit hodd hζ hb)} := by
  have : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero (k + 1) hp.out.ne_zero⟩
  have hunit : IsUnit (c : ZMod (p ^ (k + 1))) := by
    rcases Int.natAbs_eq c with heq | heq
    · rw [heq, Int.cast_natCast]
      exact (ZMod.isUnit_iff_coprime _ _).mpr hc
    · rw [heq, Int.cast_neg, Int.cast_natCast]
      exact ((ZMod.isUnit_iff_coprime _ _).mpr hc).neg
  obtain ⟨n, hn⟩ := mem_powers_iff_mem_zpowers.mpr (hg.symm ▸ Subgroup.mem_top hunit.unit)
  have hpow : Int.gcd (b ^ n) (p ^ (k + 1)) = 1 := by
    rw [Int.gcd, Int.natAbs_pow]
    exact (Nat.Coprime.pow_left n hb).gcd_eq_one
  have hmod : c ≡ b ^ n [ZMOD (p ^ (k + 1) : ℕ)] := by
    rw [← ZMod.intCast_eq_intCast_iff]
    have hval := congrArg (fun u : (ZMod (p ^ (k + 1)))ˣ ↦ (u : ZMod (p ^ (k + 1)))) hn
    simpa [hb_cast] using hval.symm
  rw [smoothedCyclotomicUnit_modEq hodd hζ hc hpow hmod]
  exact smoothedCyclotomicUnit_pow_mem_galoisOrbit hodd hζ hb_cast hb n hpow

/-- **Cyclic Galois generation of real circular units (odd prime).** If `g` generates
`(ZMod (p ^ (k + 1)))ˣ` and `b : ℤ` lifts `g`, then the Galois orbit of
`smoothedCyclotomicUnit hodd hζ hb` generates `realCyclotomicUnits K ζ (p ^ (k + 1))` as a
subgroup (including `-1`). -/
theorem realCyclotomicUnits_eq_closure_galoisOrbit (hodd : Odd p) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) {g : (ZMod (p ^ (k + 1)))ˣ}
    (hg : Subgroup.zpowers g = ⊤) {b : ℤ} (hb_cast : (b : ZMod (p ^ (k + 1))) = (g : ZMod _))
    (hb : Int.gcd b (p ^ (k + 1)) = 1) :
    realCyclotomicUnits K ζ (p ^ (k + 1)) =
      Subgroup.closure
        {v | ∃ τ : maximalRealSubfield K ≃ₐ[ℚ] maximalRealSubfield K,
          v = Units.map (RingOfIntegers.mapRingEquiv τ.toRingEquiv).toMonoidHom
            (smoothedCyclotomicUnit hodd hζ hb)} := by
  have : IsAbelianGalois ℚ K := IsCyclotomicExtension.isAbelianGalois {p ^ (k + 1)} ℚ K
  refine le_antisymm ?_ ?_
  · rw [realCyclotomicUnits_eq_closure_smoothed hodd hζ, Subgroup.closure_le]
    rintro v (rfl | ⟨c, hc, rfl⟩)
    · have hneg_gcd : Int.gcd (-1 : ℤ) (p ^ (k + 1)) = 1 := by simp
      rw [← smoothedCyclotomicUnit_neg_one hodd hζ hneg_gcd]
      exact smoothedCyclotomicUnit_mem_galoisOrbit_of_zpowers_eq_top hodd hζ hg hb_cast hb hneg_gcd
    · exact smoothedCyclotomicUnit_mem_galoisOrbit_of_zpowers_eq_top hodd hζ hg hb_cast hb hc
  · rw [Subgroup.closure_le]
    rintro v ⟨τ, rfl⟩
    rw [← τ.map_realCyclotomicUnits (pow_pos hp.out.pos _) hζ]
    exact Subgroup.mem_map_of_mem _ (smoothedCyclotomicUnit_mem_realCyclotomicUnits hodd hζ hb)

/-- **Existence of a cyclic Galois generator of `realCyclotomicUnits` for odd primes.** -/
theorem exists_cyclic_generator_realCyclotomicUnits (hodd : Odd p) {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) :
    ∃ v ∈ realCyclotomicUnits K ζ (p ^ (k + 1)),
      realCyclotomicUnits K ζ (p ^ (k + 1)) =
        Subgroup.closure
          {w | ∃ τ : maximalRealSubfield K ≃ₐ[ℚ] maximalRealSubfield K,
            w = Units.map (RingOfIntegers.mapRingEquiv τ.toRingEquiv).toMonoidHom v} := by
  have : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero (k + 1) hp.out.ne_zero⟩
  have hp2 : p ≠ 2 := by obtain ⟨m, hm⟩ := hodd; omega
  obtain ⟨g, hg⟩ := (ZMod.isCyclic_units_of_prime_pow p hp.out hp2 (k + 1)).exists_generator
  have htop : Subgroup.zpowers g = ⊤ := eq_top_iff.mpr fun x _ ↦ hg x
  set b : ℤ := ((g : ZMod (p ^ (k + 1))).val : ℤ)
  have hb_cast : (b : ZMod (p ^ (k + 1))) = (g : ZMod (p ^ (k + 1))) := by simp [b]
  have hb_gcd : Int.gcd b (p ^ (k + 1)) = 1 := by
    have hcop : ((g : ZMod (p ^ (k + 1))).val).Coprime (p ^ (k + 1)) :=
      (ZMod.isUnit_iff_coprime _ _).mp (by simp)
    rw [Int.gcd, Int.natAbs_natCast]
    exact hcop.gcd_eq_one
  exact ⟨smoothedCyclotomicUnit hodd hζ hb_gcd,
    smoothedCyclotomicUnit_mem_realCyclotomicUnits hodd hζ hb_gcd,
    realCyclotomicUnits_eq_closure_galoisOrbit hodd hζ htop hb_cast hb_gcd⟩

end OddSmoothedUnits

section DyadicSmoothedUnits

variable {k : ℕ} {K : Type*} [Field K] [NumberField K]
  [hK : IsCyclotomicExtension {2 ^ (k + 2)} ℚ K]

private theorem two_pow_gt_two : 2 < 2 ^ (k + 2) :=
  lt_of_lt_of_le (by decide : 2 < 2 ^ 2) (Nat.pow_le_pow_right two_pos (by omega))

private theorem int_gcd_two_pow_of_odd {b : ℤ} (hb : Odd b) (n : ℕ) : Int.gcd b (2 ^ n) = 1 :=
  ((Nat.prime_two.coprime_iff_not_dvd.mpr fun h ↦ by
    obtain ⟨m, rfl⟩ := hb; have := Int.natCast_dvd.mpr h; omega).symm.pow_right n).gcd_eq_one

/-- **Smoothed real circular units (dyadic prime power `2 ^ (k + 2)`).** For `a = k + 2 ≥ 2` and
odd `b : ℤ`, `dyadicSmoothedCyclotomicUnit hζ hb` is the unique integral unit of `K⁺` whose image
in `K` equals `ζ ^ ((1 - b) / 2) * (ζ ^ b - 1) / (ζ - 1)`. -/
noncomputable def dyadicSmoothedCyclotomicUnit {ζ : K}
    (hζ : IsPrimitiveRoot ζ (2 ^ (k + 2))) {b : ℤ} (hb : Odd b) :
    (𝓞 (maximalRealSubfield K))ˣ :=
  letI : IsCMField K := IsCyclotomicExtension.Rat.isCMField K (S := {2 ^ (k + 2)})
    ⟨2 ^ (k + 2), Set.mem_singleton _, two_pow_gt_two⟩
  phaseRealUnit two_pow_gt_two hζ (int_gcd_two_pow_of_odd hb (k + 2)) ((1 - b) / 2)
    (Int.modEq_iff_dvd.mpr ⟨0, by obtain ⟨m, rfl⟩ := hb; omega⟩)

/-- The field image of `dyadicSmoothedCyclotomicUnit hζ hb` is
`ζ ^ ((1 - b) / 2) * cyclotomicRatio ζ b`. -/
@[simp]
theorem coe_dyadicSmoothedCyclotomicUnit {ζ : K} (hζ : IsPrimitiveRoot ζ (2 ^ (k + 2)))
    {b : ℤ} (hb : Odd b) :
    (((dyadicSmoothedCyclotomicUnit hζ hb : 𝓞 (maximalRealSubfield K)) :
        maximalRealSubfield K) : K) =
      ζ ^ ((1 - b) / 2) * cyclotomicRatio ζ b := by
  have : IsCMField K := IsCyclotomicExtension.Rat.isCMField K (S := {2 ^ (k + 2)})
    ⟨2 ^ (k + 2), Set.mem_singleton _, two_pow_gt_two⟩
  exact coe_phaseRealUnit two_pow_gt_two hζ (int_gcd_two_pow_of_odd hb (k + 2)) _ _

/-- Every `dyadicSmoothedCyclotomicUnit` belongs to `realCyclotomicUnits K ζ (2 ^ (k + 2))`. -/
theorem dyadicSmoothedCyclotomicUnit_mem_realCyclotomicUnits {ζ : K}
    (hζ : IsPrimitiveRoot ζ (2 ^ (k + 2))) {b : ℤ} (hb : Odd b) :
    dyadicSmoothedCyclotomicUnit hζ hb ∈ realCyclotomicUnits K ζ (2 ^ (k + 2)) := by
  have : IsCMField K := IsCyclotomicExtension.Rat.isCMField K (S := {2 ^ (k + 2)})
    ⟨2 ^ (k + 2), Set.mem_singleton _, two_pow_gt_two⟩
  exact phaseRealUnit_mem_realCyclotomicUnits two_pow_gt_two hζ
    (int_gcd_two_pow_of_odd hb (k + 2)) _ _

/-- At `b = 1`, `dyadicSmoothedCyclotomicUnit` equals `1`. -/
@[simp]
theorem dyadicSmoothedCyclotomicUnit_one {ζ : K} (hζ : IsPrimitiveRoot ζ (2 ^ (k + 2))) :
    dyadicSmoothedCyclotomicUnit hζ odd_one = 1 := by
  have hgt : 2 < 2 ^ (k + 2) := two_pow_gt_two
  refine Units.ext (RingOfIntegers.coe_injective (Subtype.ext ?_))
  simp [cyclotomicRatio_one (hζ.ne_one (by omega))]

/-- At `b = -1`, `dyadicSmoothedCyclotomicUnit` equals `-1`. -/
@[simp]
theorem dyadicSmoothedCyclotomicUnit_neg_one {ζ : K} (hζ : IsPrimitiveRoot ζ (2 ^ (k + 2))) :
    dyadicSmoothedCyclotomicUnit hζ odd_one.neg = -1 := by
  have hgt : 2 < 2 ^ (k + 2) := two_pow_gt_two
  have hζ0 : ζ ≠ 0 := hζ.ne_zero (by omega)
  refine Units.ext (RingOfIntegers.coe_injective (Subtype.ext ?_))
  simp [cyclotomicRatio_neg_one hζ0 (hζ.ne_one (by omega)), mul_inv_cancel₀ hζ0]

/-- **Generation of dyadic real circular units.** For `a = k + 2 ≥ 2`,
`realCyclotomicUnits K ζ (2 ^ (k + 2))` is generated by `-1` and the dyadic real generators
`dyadicSmoothedCyclotomicUnit hζ hb` for odd `b`. -/
theorem realCyclotomicUnits_eq_closure_dyadicSmoothed {ζ : K}
    (hζ : IsPrimitiveRoot ζ (2 ^ (k + 2))) :
    realCyclotomicUnits K ζ (2 ^ (k + 2)) =
      Subgroup.closure ({(-1 : (𝓞 (maximalRealSubfield K))ˣ)} ∪
        {v | ∃ (b : ℤ) (hb : Odd b), v = dyadicSmoothedCyclotomicUnit hζ hb}) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : IsCMField K := IsCyclotomicExtension.Rat.isCMField K (S := {2 ^ (k + 2)})
    ⟨2 ^ (k + 2), Set.mem_singleton _, two_pow_gt_two⟩
  set S : Subgroup (𝓞 (maximalRealSubfield K))ˣ :=
    Subgroup.closure ({(-1 : (𝓞 (maximalRealSubfield K))ˣ)} ∪
      {v | ∃ (b : ℤ) (hb : Odd b), v = dyadicSmoothedCyclotomicUnit hζ hb})
  refine le_antisymm ?_ ?_
  · rw [realCyclotomicUnits_def]
    refine comap_realUnits_le_of_le_torsion_sup (S := S) (Subgroup.subset_closure (Or.inl rfl)) ?_
    rw [cyclotomicUnits_eq_torsion_sup_closure_ratios (p := 2) (k := k + 1) hζ]
    refine sup_le le_sup_left ?_
    rw [Subgroup.closure_le]
    rintro u ⟨b, hb, rfl⟩
    have hodd_b : Odd b := (Int.even_or_odd b).resolve_left fun ⟨m, hm⟩ ↦ by
      have hgcd : 2 ∣ Int.gcd b ((2 ^ (k + 1 + 1) : ℕ) : ℤ) :=
        Int.dvd_gcd ⟨m, by omega⟩ (Int.natCast_dvd_natCast.mpr (dvd_pow_self 2 (by omega)))
      norm_cast at hb; rw [hb] at hgcd; exact absurd (Nat.le_of_dvd one_pos hgcd) (by omega)
    exact cyclotomicRatioUnit_mem_torsion_sup_phaseRealUnit two_pow_gt_two hζ
      (int_gcd_two_pow_of_odd hodd_b (k + 2)) ((1 - b) / 2)
      (Int.modEq_iff_dvd.mpr ⟨0, by obtain ⟨m, rfl⟩ := hodd_b; omega⟩)
      (Subgroup.subset_closure (Or.inr ⟨b, hodd_b, rfl⟩))
  · rw [Subgroup.closure_le]
    rintro v (rfl | ⟨b, hb, rfl⟩)
    · exact neg_one_mem_realCyclotomicUnits
    · exact dyadicSmoothedCyclotomicUnit_mem_realCyclotomicUnits hζ hb

end DyadicSmoothedUnits

end TauCeti
