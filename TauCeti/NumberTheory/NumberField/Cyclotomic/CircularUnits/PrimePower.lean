/-!
# Prime-power circular units: structure, Galois generation, and quotient comparison

For a prime-power cyclotomic field `K / ℚ` of conductor `p ^ a` with primitive `p ^ a`-th root of
unity `ζ`, we establish:
1. Root-of-unity factorization identities for `1 - ζ ^ (b * d)` and the `(ζ - 1)`-adic valuation of
   `1 - ζ ^ b` for `b.Coprime N`.
2. Torsion containment `μ(K) ≤ cyclotomicUnits K ζ (p ^ a)`, valuation elimination giving
   `cyclotomicUnits = realCyclotomicUnits.map i ⊔ torsion K`, and explicit real generators via
   `smoothedCyclotomicUnit` (odd `p`) and `oddSmoothedCyclotomicUnit` (`p = 2`).
3. Cyclic Galois generation of `realCyclotomicUnits` for odd prime powers `p ^ (k + 1)`.
4. The full/real quotient isomorphism `(𝓞 K⁺)ˣ ⧸ realCyclotomicUnits ≃* (𝓞 K)ˣ ⧸ cyclotomicUnits`,
   index equality, and the rational boundary cases `p ^ a ≤ 2`.

## References

* L. C. Washington, *Introduction to Cyclotomic Fields*, 2nd ed., Springer (1997), Chapter 8.
* R. Sharifi, *Iwasawa Theory*, Chapter 4.
-/

public section

open NumberField NumberField.Units NumberField.IsCMField IsDedekindDomain Finset

open scoped NumberField

/-! ### Root-of-unity factorization identities -/

namespace IsPrimitiveRoot

/-- For a primitive `n`-th root of unity `ζ` in an integral domain `R` with `n = m * d` and `0 < n`,
`1 - ζ ^ (b * d) = ∏ j ∈ Finset.range d, (1 - ζ ^ (b + j * m))` for every `b : ℕ`. -/
theorem one_sub_pow_mul_eq_prod {R : Type*} [CommRing R] [IsDomain R] {ζ : R} {n m d : ℕ}
    (hζ : IsPrimitiveRoot ζ n) (hn : 0 < n) (hprod : n = m * d) (b : ℕ) :
    1 - ζ ^ (b * d) = ∏ j ∈ Finset.range d, (1 - ζ ^ (b + j * m)) := by
  have hd : 0 < d := Nat.pos_of_ne_zero fun hd0 ↦ by simp [hd0] at hprod; omega
  have hpoly := X_pow_sub_C_eq_prod (hζ.pow hn hprod) hd (α := ζ ^ b) (a := ζ ^ (b * d))
    (by rw [← pow_mul])
  have heval := congrArg (Polynomial.eval (1 : R)) hpoly
  simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, one_pow,
    Polynomial.eval_C, Polynomial.eval_prod] at heval
  rw [heval]
  exact Finset.prod_congr rfl fun j _ ↦ by rw [← pow_mul, ← pow_add, add_comm, mul_comm]

/-- Prime-power / general-power specialization of `IsPrimitiveRoot.one_sub_pow_mul_eq_prod`:
for `0 < q`, `r ≤ a`, and a primitive `q ^ a`-th root of unity `ζ`,
`1 - ζ ^ (b * q ^ r) = ∏ j ∈ Finset.range (q ^ r), (1 - ζ ^ (b + j * q ^ (a - r)))`. -/
theorem one_sub_pow_mul_pow_eq_prod {R : Type*} [CommRing R] [IsDomain R] {ζ : R}
    {q a r : ℕ} (hq : 0 < q) (hr : r ≤ a) (hζ : IsPrimitiveRoot ζ (q ^ a)) (b : ℕ) :
    1 - ζ ^ (b * q ^ r) = ∏ j ∈ Finset.range (q ^ r), (1 - ζ ^ (b + j * q ^ (a - r))) :=
  hζ.one_sub_pow_mul_eq_prod (pow_pos hq a) (by rw [← pow_add, Nat.sub_add_cancel hr]) b

/-- Sign-reversed factorization for odd factor `d`:
`ζ ^ (b * d) - 1 = ∏ j ∈ Finset.range d, (ζ ^ (b + j * m) - 1)`. -/
theorem pow_mul_sub_one_eq_prod {R : Type*} [CommRing R] [IsDomain R] {ζ : R} {n m d : ℕ}
    (hζ : IsPrimitiveRoot ζ n) (hn : 0 < n) (hprod : n = m * d) (hd : Odd d) (b : ℕ) :
    ζ ^ (b * d) - 1 = ∏ j ∈ Finset.range d, (ζ ^ (b + j * m) - 1) := by
  rw [show ζ ^ (b * d) - 1 = (-1 : R) ^ d * (1 - ζ ^ (b * d)) by rw [hd.neg_one_pow]; ring,
    hζ.one_sub_pow_mul_eq_prod hn hprod b,
    show (-1 : R) ^ d = ∏ _j ∈ Finset.range d, (-1 : R) by simp, ← Finset.prod_mul_distrib]
  exact Finset.prod_congr rfl fun j _ ↦ by ring

end IsPrimitiveRoot

namespace TauCeti

/-! ### Valuation of `1 - ζ ^ b` at the prime ideal `(ζ - 1)` -/

section Valuation

variable {K : Type*} [Field K] [NumberField K]

/-- For a height-one prime `v` of `𝓞 K` generated by `ζ - 1` (with `ζ` a primitive `N`-th root of
unity) and any `b` coprime to `N`, `1 - ζ ^ b` is a uniformizer at `v`. -/
theorem intValuation_one_sub_pow_of_coprime {N : ℕ} [NeZero N] {ζ : K} (hζ : IsPrimitiveRoot ζ N)
    (v : HeightOneSpectrum (𝓞 K)) (hv : v.asIdeal = Ideal.span {hζ.toInteger - 1})
    {b : ℕ} (hb : b.Coprime N) :
    v.intValuation (1 - hζ.toInteger ^ b) = WithZero.exp (-1 : ℤ) := by
  have hv' : v.asIdeal = Ideal.span {1 - hζ.toInteger ^ b} := by
    rw [hv, Ideal.span_singleton_eq_span_singleton]
    exact (hζ.toInteger_isPrimitiveRoot.associated_sub_one_pow_sub_one_of_coprime hb).trans
      ⟨-1, by simp⟩
  have hne : 1 - hζ.toInteger ^ b ≠ 0 := fun h0 ↦
    v.ne_bot (by rwa [h0, Ideal.span_singleton_zero] at hv')
  exact v.intValuation_singleton hne hv'

/-- Field-level version of `intValuation_one_sub_pow_of_coprime`: `v.valuation K (1 - ζ ^ b)`
equals `WithZero.exp (-1 : ℤ)` whenever `v.asIdeal = Ideal.span {ζ - 1}` and `b.Coprime N`. -/
theorem valuation_one_sub_pow_of_coprime {N : ℕ} [NeZero N] {ζ : K} (hζ : IsPrimitiveRoot ζ N)
    (v : HeightOneSpectrum (𝓞 K)) (hv : v.asIdeal = Ideal.span {hζ.toInteger - 1})
    {b : ℕ} (hb : b.Coprime N) :
    v.valuation K (1 - ζ ^ b) = WithZero.exp (-1 : ℤ) := by
  have hcoe : (1 - ζ ^ b : K) = algebraMap (𝓞 K) K (1 - hζ.toInteger ^ b) := by
    rw [map_sub, map_one, map_pow]; rfl
  rw [hcoe, v.valuation_of_algebraMap]
  exact intValuation_one_sub_pow_of_coprime hζ v hv hb

end Valuation

/-! ### Prime-power circular units: torsion containment and real decomposition -/

section PrimePowerDecomposition

private theorem two_le_prime_pow {p : ℕ} (hp : p.Prime) (k : ℕ) : 2 ≤ p ^ (k + 1) :=
  le_trans hp.two_le (Nat.le_self_pow (Nat.succ_ne_zero k) p)

private theorem finrank_eq_one_of_pow_le_two {p a : ℕ} [hp : Fact p.Prime] {K : Type*} [Field K]
    [NumberField K] [IsCyclotomicExtension {p ^ a} ℚ K] (hle : p ^ a ≤ 2) :
    Module.finrank ℚ K = 1 := by
  have hpos : 0 < p ^ a := pow_pos hp.out.pos a
  have : NeZero (p ^ a) := ⟨hpos.ne'⟩
  rw [IsCyclotomicExtension.finrank K (Polynomial.cyclotomic.irreducible_rat hpos)]
  rcases (by omega : p ^ a = 1 ∨ p ^ a = 2) with h | h <;> simp [h]

private theorem toInteger_unit_mem_torsion {K : Type*} [Field K] {N : ℕ} [NeZero N] {ζ : K}
    (hζ : IsPrimitiveRoot ζ N) :
    (hζ.toInteger_isPrimitiveRoot.isUnit (NeZero.ne N)).unit ∈ torsion K := by
  rw [NumberField.Units.torsion, CommGroup.mem_torsion, isOfFinOrder_iff_pow_eq_one]
  exact ⟨N, NeZero.pos N,
    (IsPrimitiveRoot.coe_units_iff.mp hζ.toInteger_isPrimitiveRoot).pow_eq_one⟩

/-- In any prime-power cyclotomic field over `ℚ` (for any prime `p` and any `a : ℕ`), all roots
of unity lie in the circular unit group `cyclotomicUnits K ζ (p ^ a)`. -/
theorem torsion_le_cyclotomicUnits (p a : ℕ) [hp : Fact p.Prime] (K : Type*) [Field K]
    [NumberField K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    torsion K ≤ cyclotomicUnits K ζ (p ^ a) := by
  rcases a with _ | k
  · rw [cyclotomicUnits_eq_top_of_finrank_eq_one
      (finrank_eq_one_of_pow_le_two (p := p) (a := 0) (by simp))]
    exact le_top
  · set N := p ^ (k + 1)
    have hNpos : 0 < N := pow_pos hp.out.pos (k + 1)
    have : NeZero N := ⟨hNpos.ne'⟩
    let uζ : (𝓞 K)ˣ := (hζ.toInteger_isPrimitiveRoot.isUnit hNpos.ne').unit
    have huζ_circ : uζ ∈ cyclotomicUnits K ζ N :=
      mem_cyclotomicUnits_iff.mpr (mem_cyclotomicNumbers_of_eq rfl)
    have huζ_ord : orderOf uζ = N :=
      (IsPrimitiveRoot.coe_units_iff.mp hζ.toInteger_isPrimitiveRoot).eq_orderOf.symm
    suffices ∃ g : (𝓞 K)ˣ, g ∈ cyclotomicUnits K ζ N ∧ g ∈ torsion K ∧
        orderOf g = torsionOrder K by
      obtain ⟨g, hg_circ, hg_tors, hg_ord⟩ := this
      have hzpow : Subgroup.zpowers (⟨g, hg_tors⟩ : torsion K) = ⊤ :=
        Subgroup.eq_top_of_card_eq _ <| by
          rw [Nat.card_zpowers, ← orderOf_injective (torsion K).subtype Subtype.val_injective,
            Subgroup.coe_subtype, hg_ord, torsionOrder]
      intro u hu
      obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp
        (hzpow.symm ▸ Subgroup.mem_top (⟨u, hu⟩ : torsion K))
      exact (by simpa using (congrArg Subtype.val hm).symm : u = g ^ m) ▸ zpow_mem hg_circ m
    by_cases hp2 : p = 2
    · refine ⟨uζ, huζ_circ, toInteger_unit_mem_torsion hζ, ?_⟩
      rw [IsCyclotomicExtension.Rat.torsionOrder_eq (n := N) (K := K)]
      have hEven : Even N := by
        simpa [N, hp2] using Even.pow_of_ne_zero (even_two (α := ℕ)) (by omega : k + 1 ≠ 0)
      simp [hEven, huζ_ord]
    · have hNodd : Odd N := (hp.out.odd_of_ne_two hp2).pow
      have hneg_ord : orderOf (-1 : (𝓞 K)ˣ) = 2 := by
        refine (orderOf_eq_iff (by omega)).mpr ⟨by simp, fun m hm hm0 h1 ↦ ?_⟩
        obtain rfl : m = 1 := by omega
        have hK : (-1 : K) = 1 := by
          rw [pow_one] at h1; simpa using congrArg (fun u : (𝓞 K)ˣ ↦ ((u : 𝓞 K) : K)) h1
        exact two_ne_zero (by linear_combination -hK : (2 : K) = 0)
      have hord_mul : orderOf ((-1 : (𝓞 K)ˣ) * uζ) = 2 * N := by
        rw [(Commute.all (-1 : (𝓞 K)ˣ) uζ).orderOf_mul_eq_mul_orderOf_of_coprime
          (by rw [hneg_ord, huζ_ord]; exact Nat.coprime_two_left.mpr hNodd),
          hneg_ord, huζ_ord]
      refine ⟨(-1 : (𝓞 K)ˣ) * uζ, mul_mem (neg_one_mem_cyclotomicUnits ζ N) huζ_circ,
        isOfFinOrder_iff_pow_eq_one.mpr ⟨2 * N, by positivity, hord_mul ▸ pow_orderOf_eq_one _⟩,
        ?_⟩
      rw [IsCyclotomicExtension.Rat.torsionOrder_eq (n := N) (K := K)]
      simpa [Nat.not_even_iff_odd.mpr hNodd] using hord_mul

section RealGenerators

variable {K : Type*} [Field K]

local notation3 "K⁺" => maximalRealSubfield K

/-- Every cyclotomic number in a prime-power cyclotomic field lies in the subgroup generated by
`1 - ζ`, `torsion K`, and any real subgroup `G` expressing `(1 - ζ ^ m) / (1 - ζ)` for
`p ∤ m`. -/
private theorem cyclotomicNumbers_le_of_real_generators (p k : ℕ) [hp : Fact p.Prime] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) (h1ζ : 1 - ζ ≠ 0) (G : Subgroup (𝓞 K⁺)ˣ)
    (hG_ratio : ∀ m : ℕ, ¬ p ∣ m →
      ∃ μ ∈ torsion K, ∃ y ∈ G,
        1 - ζ ^ m = (1 - ζ) * ((μ : 𝓞 K) : K) * (((y : 𝓞 K⁺) : K⁺) : K)) :
    cyclotomicNumbers ζ (p ^ (k + 1)) ≤
      Subgroup.zpowers (Units.mk0 (1 - ζ) h1ζ) ⊔
        (G.map (Units.map (algebraMap (𝓞 K⁺) (𝓞 K)).toMonoidHom) ⊔
          torsion K).map (Units.map (algebraMap (𝓞 K) K).toMonoidHom) := by
  set N := p ^ (k + 1)
  have hNpos : 0 < N := pow_pos hp.out.pos (k + 1)
  have : NeZero N := ⟨hNpos.ne'⟩
  let iO : (𝓞 K)ˣ →* Kˣ := Units.map (algebraMap (𝓞 K) K).toMonoidHom
  let iR : (𝓞 K⁺)ˣ →* (𝓞 K)ˣ := Units.map (algebraMap (𝓞 K⁺) (𝓞 K)).toMonoidHom
  set U₁ : Kˣ := Units.mk0 (1 - ζ) h1ζ
  set S : Subgroup Kˣ := Subgroup.zpowers U₁ ⊔ (G.map iR ⊔ torsion K).map iO
  have hmemT : ∀ {μ : (𝓞 K)ˣ}, μ ∈ torsion K → iO μ ∈ S := fun hμ ↦
    Subgroup.mem_sup_right (Subgroup.mem_map_of_mem iO (Subgroup.mem_sup_right hμ))
  rw [cyclotomicNumbers_eq_closure, Subgroup.closure_le]
  rintro u (hu | hu | ⟨c, hc0, hcN, hu⟩)
  · have hEq : u = iO (-1 : (𝓞 K)ˣ) := Units.ext (by simpa [iO] using hu)
    exact hEq ▸ hmemT (isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by omega, by simp⟩)
  · have hEq : u = iO (hζ.toInteger_isPrimitiveRoot.isUnit hNpos.ne').unit := Units.ext hu
    exact hEq ▸ hmemT (toInteger_unit_mem_torsion hζ)
  · set r := c.factorization p
    set b := c / p ^ r
    have hcb : b * p ^ r = c := by rw [mul_comm]; exact Nat.ordProj_mul_ordCompl_eq_self c p
    have hr_lt : r < k + 1 := by
      by_contra hge; push Not at hge
      have := Nat.le_of_dvd hc0 ((Nat.pow_dvd_pow p hge).trans ⟨b, by rw [← hcb, mul_comm]⟩)
      omega
    have hnb : ¬ p ∣ b := Nat.not_dvd_ordCompl hp.out hc0.ne'
    have hfac := hcb ▸ hζ.one_sub_pow_mul_pow_eq_prod hp.out.pos (le_of_lt hr_lt) b
    have hterm : ∀ j : ℕ, ∃ w : Kˣ, w ∈ S ∧
        (w : K) = 1 - ζ ^ (b + j * p ^ (k + 1 - r)) := fun j ↦ by
      have hndvd : ¬ p ∣ b + j * p ^ (k + 1 - r) := fun hdiv ↦
        hnb ((Nat.dvd_add_left (dvd_mul_of_dvd_right (dvd_pow_self p (by omega)) j)).mp hdiv)
      obtain ⟨μ, hμ, y, hy, hval⟩ := hG_ratio (b + j * p ^ (k + 1 - r)) hndvd
      refine ⟨U₁ * iO (iR y * μ),
        mul_mem (Subgroup.mem_sup_left (Subgroup.mem_zpowers U₁))
          (Subgroup.mem_sup_right (Subgroup.mem_map_of_mem iO
            (mul_mem (Subgroup.mem_sup_left (Subgroup.mem_map_of_mem iR hy))
              (Subgroup.mem_sup_right hμ)))), ?_⟩
      have hmulK : ((iO (iR y * μ) : Kˣ) : K) =
          (((y : 𝓞 K⁺) : K⁺) : K) * ((μ : 𝓞 K) : K) := by rw [map_mul, Units.val_mul]; rfl
      rw [hval, Units.val_mul, hmulK]; simp only [U₁, Units.val_mk0]; ring
    choose w hwS hwval using hterm
    have huEq : u = ∏ j ∈ Finset.range (p ^ r), w j := Units.ext <| by
      rw [hu, hfac, ← Units.coeHom_apply, map_prod]
      exact Finset.prod_congr rfl fun j _ ↦ (hwval j).symm
    exact huEq ▸ Subgroup.prod_mem S fun j _ ↦ hwS j

/-- Unified valuation-elimination lemma for prime-power cyclotomic fields: if a subgroup
`G ≤ realCyclotomicUnits K ζ (p ^ (k + 1))` contains `-1` and expresses `(1 - ζ ^ m) / (1 - ζ)`
up to roots of unity for every `m` not divisible by `p`, then
`cyclotomicUnits = G.map i ⊔ torsion K` and `realCyclotomicUnits = G`. -/
private theorem decomposition_of_real_generators (p k : ℕ) [hp : Fact p.Prime] [NumberField K]
    [IsCyclotomicExtension {p ^ (k + 1)} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1)))
    (G : Subgroup (𝓞 K⁺)ˣ) (hG_neg : (-1 : (𝓞 K⁺)ˣ) ∈ G)
    (hG_le : G ≤ realCyclotomicUnits K ζ (p ^ (k + 1)))
    (hG_ratio : ∀ m : ℕ, ¬ p ∣ m →
      ∃ μ ∈ torsion K, ∃ y ∈ G,
        1 - ζ ^ m = (1 - ζ) * ((μ : 𝓞 K) : K) * (((y : 𝓞 K⁺) : K⁺) : K)) :
    cyclotomicUnits K ζ (p ^ (k + 1)) =
        G.map (Units.map (algebraMap (𝓞 K⁺) (𝓞 K)).toMonoidHom) ⊔ torsion K ∧
      realCyclotomicUnits K ζ (p ^ (k + 1)) = G := by
  set N := p ^ (k + 1)
  have : NeZero N := ⟨(pow_pos hp.out.pos (k + 1)).ne'⟩
  have h1ζ : 1 - ζ ≠ 0 :=
    sub_ne_zero.mpr (hζ.ne_one (by have := two_le_prime_pow hp.out k; omega)).symm
  let iO : (𝓞 K)ˣ →* Kˣ := Units.map (algebraMap (𝓞 K) K).toMonoidHom
  let iR : (𝓞 K⁺)ˣ →* (𝓞 K)ˣ := Units.map (algebraMap (𝓞 K⁺) (𝓞 K)).toMonoidHom
  set T : Subgroup (𝓞 K)ˣ := G.map iR ⊔ torsion K
  set U₁ : Kˣ := Units.mk0 (1 - ζ) h1ζ
  have hnum_le := cyclotomicNumbers_le_of_real_generators p k hζ h1ζ G hG_ratio
  have hle_T : cyclotomicUnits K ζ N ≤ T := fun u hu ↦ by
    obtain ⟨x, hx, z, hz, hxz⟩ := Subgroup.mem_sup.mp (hnum_le (mem_cyclotomicUnits_iff.mp hu))
    obtain ⟨e, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
    obtain ⟨t, ht, rfl⟩ := Subgroup.mem_map.mp hz
    let v : HeightOneSpectrum (𝓞 K) :=
      { asIdeal := Ideal.span {hζ.toInteger - 1}
        isPrime := IsCyclotomicExtension.Rat.isPrime_span_zeta_sub_one p k hζ
        ne_bot := IsCyclotomicExtension.Rat.span_zeta_sub_one_ne_bot p k hζ }
    have hvU₁ : v.valuation K (U₁ : K) = WithZero.exp (-1 : ℤ) := by
      simpa [U₁] using valuation_one_sub_pow_of_coprime hζ v rfl (Nat.coprime_one_left N)
    have hv_unit : ∀ w : (𝓞 K)ˣ, v.valuation K ((iO w : Kˣ) : K) = 1 := fun w ↦ by
      rw [show ((iO w : Kˣ) : K) = algebraMap (𝓞 K) K (w : 𝓞 K) from rfl,
        v.valuation_of_algebraMap, v.intValuation_eq_one_iff]
      exact fun hmem ↦ v.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem w.isUnit)
    have hvEq : v.valuation K ((iO u : Kˣ) : K) =
        v.valuation K (((U₁ ^ e : Kˣ) : K) * ((iO t : Kˣ) : K)) := by rw [← Units.val_mul, hxz]
    rw [map_mul, hv_unit u, hv_unit t, mul_one, Units.val_zpow_eq_zpow_val, map_zpow₀, hvU₁,
      ← WithZero.exp_zsmul, smul_eq_mul, mul_neg_one] at hvEq
    obtain rfl : e = 0 := by
      have := WithZero.exp_injective (by simpa [← WithZero.exp_zero] using hvEq); omega
    rw [zpow_zero, one_mul] at hxz
    exact Units.map_injective (FaithfulSMul.algebraMap_injective (𝓞 K) K) hxz ▸ ht
  have hfull : cyclotomicUnits K ζ N = T := le_antisymm hle_T <| sup_le
    (fun _ ⟨y, hy, hyEq⟩ ↦ hyEq ▸ mem_realCyclotomicUnits_iff.mp (hG_le hy))
    (torsion_le_cyclotomicUnits p (k + 1) K hζ)
  refine ⟨hfull, le_antisymm (fun u hu ↦ ?_) hG_le⟩
  obtain ⟨_, ⟨g, hg, rfl⟩, μ, hμ, hmul⟩ :=
    Subgroup.mem_sup.mp (hfull ▸ mem_realCyclotomicUnits_iff.mp hu)
  have hμ_real : μ ∈ realUnits K := (mem_realUnits_iff K μ).mpr
    ⟨g⁻¹ * u, by simpa [iR] using congrArg Units.val (eq_inv_mul_of_mul_eq hmul).symm⟩
  have h_inj := Units.map_injective (FaithfulSMul.algebraMap_injective (𝓞 K⁺) (𝓞 K))
  rcases TauCeti.NumberField.eq_one_or_neg_one_of_mem_torsion_of_mem_realUnits hμ hμ_real with
      rfl | rfl
  · exact h_inj (by simpa [iR] using hmul) ▸ hg
  · have hEq : iR (-g) = iR u := by
      rw [← hmul]; apply Units.ext; apply RingOfIntegers.ext; simp [iR]
    rw [← h_inj hEq, ← neg_one_mul]; exact mul_mem hG_neg hg

/-- Factor `1 - ζ ^ m` into `(1 - ζ) * μ * y` given a real unit `y` with value
`ζ ^ e * cyclotomicRatio ζ m`. -/
private theorem one_sub_pow_eq_mul_torsion_real {N : ℕ} (hN2 : 2 ≤ N) {ζ : K}
    (hζ : IsPrimitiveRoot ζ N) (m : ℕ) (e : ℤ) (y : (𝓞 K⁺)ˣ)
    (hy : (((y : 𝓞 K⁺) : K⁺) : K) = ζ ^ e * cyclotomicRatio ζ m) :
    ∃ μ ∈ torsion K, 1 - ζ ^ m = (1 - ζ) * ((μ : 𝓞 K) : K) * (((y : 𝓞 K⁺) : K⁺) : K) := by
  have : NeZero N := ⟨by omega⟩
  let uζ : (𝓞 K)ˣ := (hζ.toInteger_isPrimitiveRoot.isUnit (by omega)).unit
  refine ⟨uζ ^ (-e), zpow_mem (toInteger_unit_mem_torsion hζ) (-e), ?_⟩
  have hcoe_uζ : (((uζ ^ (-e) : (𝓞 K)ˣ) : 𝓞 K) : K) = ζ ^ (-e) := by
    change ((Units.map (algebraMap (𝓞 K) K).toMonoidHom (uζ ^ (-e)) : Kˣ) : K) = ζ ^ (-e)
    rw [map_zpow, Units.val_zpow_eq_zpow_val]; rfl
  have hζ1 : ζ - 1 ≠ 0 := sub_ne_zero.mpr (hζ.ne_one (by omega))
  have hmul_zpow : ζ ^ (-e) * ζ ^ e = 1 := by
    rw [← zpow_add₀ (hζ.ne_zero (by omega)), neg_add_cancel, zpow_zero]
  rw [hcoe_uζ, hy, cyclotomicRatio_eq, zpow_natCast]
  calc 1 - ζ ^ m = (1 - ζ) * ((ζ ^ m - 1) / (ζ - 1)) := by field_simp; ring
    _ = (1 - ζ) * (ζ ^ (-e) * ζ ^ e) * ((ζ ^ m - 1) / (ζ - 1)) := by rw [hmul_zpow, mul_one]
    _ = (1 - ζ) * ζ ^ (-e) * (ζ ^ e * ((ζ ^ m - 1) / (ζ - 1))) := by ring

private theorem odd_real_generators_decomp (p k : ℕ) [hp : Fact p.Prime] (hp2 : p ≠ 2)
    [NumberField K] [IsCyclotomicExtension {p ^ (k + 1)} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) :
    let hodd : Odd (p ^ (k + 1)) := (hp.out.odd_of_ne_two hp2).pow
    let hN2 : 2 ≤ p ^ (k + 1) := two_le_prime_pow hp.out k
    let G : Subgroup (𝓞 K⁺)ˣ := Subgroup.closure {u | ∃ (b : ℤ) (hb : b.gcd (p ^ (k + 1)) = 1),
      u = smoothedCyclotomicUnit hζ hodd hN2 hb}
    cyclotomicUnits K ζ (p ^ (k + 1)) =
        G.map (Units.map (algebraMap (𝓞 K⁺) (𝓞 K)).toMonoidHom) ⊔ torsion K ∧
      realCyclotomicUnits K ζ (p ^ (k + 1)) = G := by
  intro hodd hN2 G
  refine decomposition_of_real_generators p k hζ G
    (Subgroup.subset_closure ⟨-1, by simp, (smoothedCyclotomicUnit_neg_one hζ hodd hN2).symm⟩)
    (by rw [Subgroup.closure_le]; rintro _ ⟨_, hb, rfl⟩
        exact smoothedCyclotomicUnit_mem_realCyclotomicUnits hζ hodd hN2 hb)
    fun m hm ↦ ?_
  have hgcd : ((m : ℤ)).gcd (p ^ (k + 1)) = 1 := by
    rw [← Nat.cast_pow, Int.gcd_natCast_natCast]
    exact (hp.out.coprime_iff_not_dvd.mpr hm).symm.pow_right (k + 1)
  obtain ⟨μ, hμ, hval⟩ := one_sub_pow_eq_mul_torsion_real hN2 hζ m _
    (smoothedCyclotomicUnit hζ hodd hN2 hgcd)
    ((coe_smoothedCyclotomicUnit hζ hodd hN2 hgcd).trans (smoothedCyclotomicRatio_eq _ _ _))
  exact ⟨μ, hμ, _, Subgroup.subset_closure ⟨(m : ℤ), hgcd, rfl⟩, hval⟩

private theorem two_real_generators_decomp (k : ℕ) [NumberField K]
    [IsCyclotomicExtension {2 ^ (k + 1)} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ (2 ^ (k + 1))) :
    let hN2 : 2 ≤ 2 ^ (k + 1) := two_le_prime_pow Nat.prime_two k
    let G : Subgroup (𝓞 K⁺)ˣ :=
      Subgroup.closure {u | ∃ (b : ℤ) (hodd : Odd b) (hb : b.gcd (2 ^ (k + 1)) = 1),
        u = oddSmoothedCyclotomicUnit hζ hN2 hodd hb}
    cyclotomicUnits K ζ (2 ^ (k + 1)) =
        G.map (Units.map (algebraMap (𝓞 K⁺) (𝓞 K)).toMonoidHom) ⊔ torsion K ∧
      realCyclotomicUnits K ζ (2 ^ (k + 1)) = G := by
  intro hN2 G
  refine decomposition_of_real_generators 2 k hζ G
    (Subgroup.subset_closure
      ⟨-1, odd_one.neg, by simp, (oddSmoothedCyclotomicUnit_neg_one hζ hN2).symm⟩)
    (by rw [Subgroup.closure_le]; rintro _ ⟨_, ho, hb, rfl⟩
        exact oddSmoothedCyclotomicUnit_mem_realCyclotomicUnits hζ hN2 ho hb)
    fun m hm ↦ ?_
  have hm_odd : Odd (m : ℤ) := by
    obtain ⟨t, rfl⟩ := Nat.not_even_iff_odd.mp (by rwa [even_iff_two_dvd])
    exact ⟨(t : ℤ), by push_cast; ring⟩
  have hgcd : ((m : ℤ)).gcd (2 ^ (k + 1)) = 1 := by
    rw [← Nat.cast_ofNat (n := 2), ← Nat.cast_pow, Int.gcd_natCast_natCast]
    exact (Nat.prime_two.coprime_iff_not_dvd.mpr hm).symm.pow_right (k + 1)
  obtain ⟨μ, hμ, hval⟩ := one_sub_pow_eq_mul_torsion_real hN2 hζ m _
    (oddSmoothedCyclotomicUnit hζ hN2 hm_odd hgcd)
    ((coe_oddSmoothedCyclotomicUnit hζ hN2 hm_odd hgcd).trans (oddSmoothedCyclotomicRatio_eq _ _))
  exact ⟨μ, hμ, _, Subgroup.subset_closure ⟨(m : ℤ), hm_odd, hgcd, rfl⟩, hval⟩

end RealGenerators

/-- **Real circular-unit generators for odd prime powers**: for an odd prime `p` and `k : ℕ`,
`realCyclotomicUnits K ζ (p ^ (k + 1))` is generated by the smoothed circular units
`smoothedCyclotomicUnit` for integers `b` coprime to `p ^ (k + 1)`. -/
theorem realCyclotomicUnits_eq_closure_smoothed (p k : ℕ) [hp : Fact p.Prime] (hp2 : p ≠ 2)
    (K : Type*) [Field K] [NumberField K] [IsCyclotomicExtension {p ^ (k + 1)} ℚ K]
    {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) :
    let hodd : Odd (p ^ (k + 1)) := (hp.out.odd_of_ne_two hp2).pow
    let hN2 : 2 ≤ p ^ (k + 1) := le_trans hp.out.two_le (Nat.le_self_pow (Nat.succ_ne_zero k) p)
    realCyclotomicUnits K ζ (p ^ (k + 1)) =
      Subgroup.closure {u | ∃ (b : ℤ) (hb : b.gcd (p ^ (k + 1)) = 1),
        u = smoothedCyclotomicUnit hζ hodd hN2 hb} :=
  (odd_real_generators_decomp p k hp2 hζ).2

/-- **Real circular-unit generators for powers of `2`**: for any `k : ℕ`,
`realCyclotomicUnits K ζ (2 ^ (k + 1))` is generated by the odd-smoothed circular units
`oddSmoothedCyclotomicUnit` for odd integers `b` coprime to `2 ^ (k + 1)`. -/
theorem realCyclotomicUnits_eq_closure_oddSmoothed (k : ℕ) (K : Type*) [Field K] [NumberField K]
    [IsCyclotomicExtension {2 ^ (k + 1)} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ (2 ^ (k + 1))) :
    let hN2 : 2 ≤ 2 ^ (k + 1) :=
      le_trans (by decide : 2 ≤ 2) (Nat.le_self_pow (Nat.succ_ne_zero k) 2)
    realCyclotomicUnits K ζ (2 ^ (k + 1)) =
      Subgroup.closure {u | ∃ (b : ℤ) (hodd : Odd b) (hb : b.gcd (2 ^ (k + 1)) = 1),
        u = oddSmoothedCyclotomicUnit hζ hN2 hodd hb} :=
  (two_real_generators_decomp k hζ).2

/-- **Decomposition of full circular units into real circular units and roots of unity**:
for every prime `p` and every `a : ℕ`,
`cyclotomicUnits K ζ (p ^ a) = (realCyclotomicUnits K ζ (p ^ a)).map i ⊔ torsion K`. -/
theorem cyclotomicUnits_eq_map_realCyclotomicUnits_sup_torsion (p a : ℕ) [hp : Fact p.Prime]
    (K : Type*) [Field K] [NumberField K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    cyclotomicUnits K ζ (p ^ a) =
      (realCyclotomicUnits K ζ (p ^ a)).map
        (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) ⊔
      torsion K := by
  rcases a with _ | k
  · have hfin := finrank_eq_one_of_pow_le_two (p := p) (a := 0) (K := K) (by simp)
    have hreal_top : (realCyclotomicUnits K ζ (p ^ 0)).map
        (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) =
        realUnits K := by
      rw [realCyclotomicUnits_eq_top_of_finrank_eq_one hfin, Subgroup.map_top]; rfl
    rw [cyclotomicUnits_eq_top_of_finrank_eq_one hfin, hreal_top,
      TauCeti.IsCyclotomicExtension.Rat.realUnits_sup_torsion_eq_top p 0 K]
  · by_cases hp2 : p = 2
    · subst hp2; have h := two_real_generators_decomp k hζ; rw [h.2, h.1]
    · have h := odd_real_generators_decomp p k hp2 hζ; rw [h.2, h.1]

end PrimePowerDecomposition

/-! ### Cyclic Galois generation for odd prime powers -/

section CyclicGaloisGeneration

/-- Cocycle product identity for smoothed circular units under powers of an automorphism `τ`
acting on `ζ` by `τ ζ = ζ ^ c`. -/
theorem prod_realUnitsMapEquiv_smoothedCyclotomicUnit {K : Type*} [Field K] [Algebra ℚ K]
    {N : ℕ} (hodd : Odd N) (hN : 2 ≤ N) {ζ : K} (hζ : IsPrimitiveRoot ζ N)
    {τ : Gal(K/ℚ)} {c : ℤ} (hc : c.gcd N = 1) (hτ : τ ζ = ζ ^ c) (n : ℕ) :
    ∏ i ∈ Finset.range n,
      realUnitsMapEquiv (τ ^ i).toRingEquiv (smoothedCyclotomicUnit hζ hodd hN hc) =
    smoothedCyclotomicUnit hζ hodd hN
      (by rw [← Int.isCoprime_iff_gcd_eq_one] at hc ⊢; exact hc.pow_left :
        (c ^ n).gcd N = 1) := by
  have hpow_gal : ∀ m : ℕ, (τ ^ m) ζ = ζ ^ (c ^ m) := fun m ↦ by
    induction m with
    | zero => simp
    | succ m ih => rw [pow_succ, AlgEquiv.mul_apply, hτ, map_zpow₀, ih, ← zpow_mul, pow_succ]
  induction n with
  | zero => simp [smoothedCyclotomicUnit_one]
  | succ n ih =>
    rw [Finset.prod_range_succ, ih]
    apply Units.ext; apply RingOfIntegers.ext; apply Subtype.ext
    have hcn : (c ^ n).gcd N = 1 := by
      rw [← Int.isCoprime_iff_gcd_eq_one] at hc ⊢; exact hc.pow_left
    have hζcn : ζ ^ (c ^ n) ≠ 1 := (hζ.zpow_of_gcd_eq_one (c ^ n) hcn).ne_one (by omega)
    have hlhs :
        (((smoothedCyclotomicUnit hζ hodd hN hcn *
            realUnitsMapEquiv (τ ^ n).toRingEquiv (smoothedCyclotomicUnit hζ hodd hN hc) :
              (𝓞 (maximalRealSubfield K))ˣ) : 𝓞 (maximalRealSubfield K)) : K) =
        smoothedCyclotomicRatio ζ N (c ^ n) * (τ ^ n) (smoothedCyclotomicRatio ζ N c) := by
      rw [Units.val_mul]
      exact (map_mul (algebraMap (𝓞 (maximalRealSubfield K)) K) _ _).trans <|
        congrArg₂ (· * ·) (coe_smoothedCyclotomicUnit hζ hodd hN hcn)
          ((coe_realUnitsMapEquiv _ _).trans (congrArg (τ ^ n) (coe_smoothedCyclotomicUnit hζ hodd
            hN hc)))
    have hmap : (τ ^ n) (smoothedCyclotomicRatio ζ N c) =
        smoothedCyclotomicRatio ((τ ^ n) ζ) N c :=
      smoothedCyclotomicRatio_map (τ ^ n).toRingHom ζ N c
    rw [coe_smoothedCyclotomicUnit, hlhs, hmap, hpow_gal n, mul_comm,
      ← smoothedCyclotomicRatio_mul hζ.pow_eq_one hodd hζcn, pow_succ']

private theorem galEquivZMod_symm_apply_zeta {N : ℕ} [NeZero N] {K : Type*} [Field K]
    [NumberField K] [IsCyclotomicExtension {N} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ N)
    (g : (ZMod N)ˣ) :
    ((IsCyclotomicExtension.Rat.galEquivZMod N K).symm g) ζ = ζ ^ (g.val.val : ℤ) := by
  rw [zpow_natCast]
  simpa using IsCyclotomicExtension.Rat.galEquivZMod_apply_of_pow_eq N K
    ((IsCyclotomicExtension.Rat.galEquivZMod N K).symm g) hζ.pow_eq_one

private theorem intCast_zmod_val_pow {N : ℕ} [NeZero N] (g : (ZMod N)ˣ) (n : ℕ) :
    (((g.val.val : ℤ) ^ n : ℤ) : ZMod N) = ((g ^ n : (ZMod N)ˣ) : ZMod N) := by
  push_cast; rw [ZMod.natCast_zmod_val]

section OddPrimePower

variable (p k : ℕ) [hp : Fact p.Prime] (hp2 : p ≠ 2) (K : Type*) [Field K] [NumberField K]
  [IsCyclotomicExtension {p ^ (k + 1)} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1)))

local notation3 "K⁺" => maximalRealSubfield K

/-- For an odd prime power `p ^ (k + 1)` and any generator `g` of `(ZMod (p ^ (k + 1)))ˣ`, the
product of the first `φ(p ^ (k + 1)) / 2` Galois conjugates of the smoothed unit attached to `g`
equals `-1`. -/
theorem prod_half_totient_realUnitsMapEquiv_smoothedCyclotomicUnit
    {g : (ZMod (p ^ (k + 1)))ˣ} (hg : Subgroup.zpowers g = ⊤) :
    let N := p ^ (k + 1)
    let hodd : Odd N := (hp.out.odd_of_ne_two hp2).pow
    let hN2 : 2 ≤ N := le_trans hp.out.two_le (Nat.le_self_pow (Nat.succ_ne_zero k) p)
    let hc : ((g.val.val : ℤ)).gcd N = 1 := by
      rw [Int.gcd_natCast_natCast]; exact ZMod.val_coe_unit_coprime g
    let τ : Gal(K/ℚ) :=
      have : NeZero N := ⟨(pow_pos hp.out.pos (k + 1)).ne'⟩
      (IsCyclotomicExtension.Rat.galEquivZMod N K).symm g
    ∏ i ∈ Finset.range (N.totient / 2),
      realUnitsMapEquiv (τ ^ i).toRingEquiv (smoothedCyclotomicUnit hζ hodd hN2 hc) = -1 := by
  intro N hodd hN2 hc τ
  have : NeZero N := ⟨(pow_pos hp.out.pos (k + 1)).ne'⟩
  have hNgt2 : 2 < N := lt_of_lt_of_le (lt_of_le_of_ne hp.out.two_le (Ne.symm hp2))
    (Nat.le_self_pow (Nat.succ_ne_zero k) p)
  rw [prod_realUnitsMapEquiv_smoothedCyclotomicUnit hodd hN2 hζ hc
    (galEquivZMod_symm_apply_zeta hζ g)]
  have hhalf : g ^ (N.totient / 2) = -1 := by
    have hord : orderOf g = N.totient := by
      rw [← Nat.card_zpowers, hg, Subgroup.card_top, Nat.card_eq_fintype_card,
        ZMod.card_units_eq_totient N]
    obtain ⟨m, hm⟩ := Nat.totient_even hNgt2
    rw [show N.totient / 2 = m by omega]
    obtain ⟨r, hr⟩ := mem_powers_iff_mem_zpowers.mpr (hg.symm ▸ Subgroup.mem_top (-1))
    dsimp only at hr
    have hmr : m ∣ r := (Nat.mul_dvd_mul_iff_left (by omega : 0 < 2)).mp <| by
      rw [two_mul, ← hm, ← hord]
      exact orderOf_dvd_of_pow_eq_one (by rw [mul_comm, pow_mul, hr]; simp)
    obtain ⟨q, rfl⟩ := hmr
    have hneg_ne : (-1 : (ZMod N)ˣ) ≠ 1 := fun h1 ↦ by
      have := ZMod.neg_one_eq_one_iff.mp (congrArg Units.val h1); omega
    rcases Nat.even_or_odd q with ⟨s, rfl⟩ | ⟨s, rfl⟩
    · exfalso; apply hneg_ne
      rw [← hr, show m * (s + s) = (m + m) * s by ring, pow_mul, ← hm, ← hord,
        pow_orderOf_eq_one, one_pow]
    · rw [← hr, show m * (2 * s + 1) = (m + m) * s + m by ring, pow_add g, pow_mul, ← hm,
        ← hord, pow_orderOf_eq_one, one_pow, one_mul]
  have hmod : ((g.val.val : ℤ) ^ (N.totient / 2)) ≡ (-1 : ℤ) [ZMOD N] := by
    rw [← ZMod.intCast_eq_intCast_iff, intCast_zmod_val_pow, hhalf]; simp
  rw [smoothedCyclotomicUnit_eq_of_modeq hζ hodd hN2 _ (by simp : (-1 : ℤ).gcd N = 1) hmod,
    smoothedCyclotomicUnit_neg_one]

/-- **Cyclic Galois generation of real circular units for odd prime powers**: if `g` generates
`(ZMod (p ^ (k + 1)))ˣ`, then the Galois orbit of the single smoothed circular unit attached to `g`
generates `realCyclotomicUnits K ζ (p ^ (k + 1))`. -/
theorem realCyclotomicUnits_eq_closure_galois_orbit
    {g : (ZMod (p ^ (k + 1)))ˣ} (hg : Subgroup.zpowers g = ⊤) :
    let N := p ^ (k + 1)
    let hodd : Odd N := (hp.out.odd_of_ne_two hp2).pow
    let hN2 : 2 ≤ N := le_trans hp.out.two_le (Nat.le_self_pow (Nat.succ_ne_zero k) p)
    let hc : ((g.val.val : ℤ)).gcd N = 1 := by
      rw [Int.gcd_natCast_natCast]; exact ZMod.val_coe_unit_coprime g
    realCyclotomicUnits K ζ N =
      Subgroup.closure (Set.range fun σ : Gal(K/ℚ) ↦
        realUnitsMapEquiv σ.toRingEquiv (smoothedCyclotomicUnit hζ hodd hN2 hc)) := by
  intro N hodd hN2 hc
  have hNpos : 0 < N := pow_pos hp.out.pos (k + 1)
  have : NeZero N := ⟨hNpos.ne'⟩
  set u₀ := smoothedCyclotomicUnit hζ hodd hN2 hc
  set O : Subgroup (𝓞 K⁺)ˣ :=
    Subgroup.closure (Set.range fun σ : Gal(K/ℚ) ↦ realUnitsMapEquiv σ.toRingEquiv u₀)
  let τ : Gal(K/ℚ) := (IsCyclotomicExtension.Rat.galEquivZMod N K).symm g
  refine le_antisymm ?_ (by
    rw [Subgroup.closure_le]; rintro _ ⟨σ, rfl⟩
    exact (SetLike.ext_iff.mp (realCyclotomicUnits_comap_ringAut hNpos hζ σ.toRingEquiv) u₀).mpr
      (smoothedCyclotomicUnit_mem_realCyclotomicUnits hζ hodd hN2 hc))
  rw [realCyclotomicUnits_eq_closure_smoothed p k hp2 K hζ, Subgroup.closure_le]
  rintro _ ⟨b, hb, rfl⟩
  have hbN : b.gcd N = 1 := by simpa [N] using hb
  set r : ℕ := (b % (N : ℤ)).toNat
  have hcast : (r : ℤ) = b % (N : ℤ) := Int.toNat_of_nonneg (Int.emod_nonneg b (by positivity))
  have hrcop : r.Coprime N := by
    rw [Nat.Coprime, ← Int.gcd_natCast_natCast, hcast, Int.gcd_emod, hbN]
  let x : (ZMod N)ˣ := ZMod.unitOfCoprime r hrcop
  obtain ⟨n, hn⟩ := mem_powers_iff_mem_zpowers.mpr (hg.symm ▸ Subgroup.mem_top x)
  dsimp only at hn
  have hmod : ((g.val.val : ℤ) ^ n) ≡ b [ZMOD N] := by
    rw [← ZMod.intCast_eq_intCast_iff, intCast_zmod_val_pow, hn]
    rw [show (b : ZMod N) = ((r : ℤ) : ZMod N) from
      (ZMod.intCast_eq_intCast_iff _ _ _).mpr (by rw [hcast, Int.ModEq, Int.emod_emod])]
    simp [x]
  have hcn : ((g.val.val : ℤ) ^ n).gcd N = 1 := by
    rw [← Int.isCoprime_iff_gcd_eq_one] at hc ⊢; exact hc.pow_left
  rw [← smoothedCyclotomicUnit_eq_of_modeq hζ hodd hN2 hcn hbN hmod,
    ← prod_realUnitsMapEquiv_smoothedCyclotomicUnit hodd hN2 hζ hc
      (galEquivZMod_symm_apply_zeta hζ g) n]
  exact Subgroup.prod_mem O fun i _ ↦ Subgroup.subset_closure ⟨τ ^ i, rfl⟩

include hp2 hζ in
/-- For an odd prime `p` and `k : ℕ`, there exists a single real circular unit whose
`Gal(K/ℚ)`-orbit generates `realCyclotomicUnits K ζ (p ^ (k + 1))`. -/
theorem exists_cyclic_generator_realCyclotomicUnits :
    ∃ u₀ ∈ realCyclotomicUnits K ζ (p ^ (k + 1)),
      realCyclotomicUnits K ζ (p ^ (k + 1)) =
        Subgroup.closure (Set.range fun σ : Gal(K/ℚ) ↦
          realUnitsMapEquiv σ.toRingEquiv u₀) := by
  have : IsCyclic (ZMod (p ^ (k + 1)))ˣ := ZMod.isCyclic_units_of_prime_pow p hp.out hp2 (k + 1)
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := (ZMod (p ^ (k + 1)))ˣ)
  have hodd : Odd (p ^ (k + 1)) := (hp.out.odd_of_ne_two hp2).pow
  have hN2 : 2 ≤ p ^ (k + 1) := two_le_prime_pow hp.out k
  have hc : ((g.val.val : ℤ)).gcd (p ^ (k + 1)) = 1 := by
    rw [← Nat.cast_pow, Int.gcd_natCast_natCast]; exact ZMod.val_coe_unit_coprime g
  exact ⟨smoothedCyclotomicUnit hζ hodd hN2 hc,
    smoothedCyclotomicUnit_mem_realCyclotomicUnits hζ hodd hN2 hc,
    realCyclotomicUnits_eq_closure_galois_orbit p k hp2 K hζ (eq_top_iff.mpr fun x _ ↦ hg x)⟩

end OddPrimePower

end CyclicGaloisGeneration

/-! ### Full/real circular-unit quotient isomorphism and index equality -/

section QuotientComparison

variable (p a : ℕ) [hp : Fact p.Prime] (K : Type*) [Field K] [NumberField K]
  [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}

local notation3 "K⁺" => maximalRealSubfield K

private theorem realUnits_sup_cyclotomicUnits_eq_top (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    realUnits K ⊔ cyclotomicUnits K ζ (p ^ a) = ⊤ :=
  eq_top_iff.mpr <|
    (TauCeti.IsCyclotomicExtension.Rat.realUnits_sup_torsion_eq_top p a K).ge.trans
      (sup_le_sup_left (torsion_le_cyclotomicUnits p a K hζ) _)

/-- **Full/real circular-unit quotient isomorphism**: for every prime `p` and every `a : ℕ`, the
inclusion `(𝓞 K⁺)ˣ →* (𝓞 K)ˣ` induces a group isomorphism
`(𝓞 K⁺)ˣ ⧸ realCyclotomicUnits K ζ (p ^ a) ≃* (𝓞 K)ˣ ⧸ cyclotomicUnits K ζ (p ^ a)`. -/
noncomputable def fullRealCircularQuotientEquiv (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    (𝓞 K⁺)ˣ ⧸ realCyclotomicUnits K ζ (p ^ a) ≃* (𝓞 K)ˣ ⧸ cyclotomicUnits K ζ (p ^ a) :=
  (QuotientGroup.congr (realCyclotomicUnits K ζ (p ^ a))
    ((cyclotomicUnits K ζ (p ^ a)).comap (Units.map (↑(algebraMap (𝓞 K⁺) (𝓞 K)))))
    (MulEquiv.refl _) (by simp [realCyclotomicUnits_eq_comap])).trans <|
  TauCeti.NumberField.quotientRealUnitsEquiv (H := cyclotomicUnits K ζ (p ^ a))
    (realUnits_sup_cyclotomicUnits_eq_top p a K hζ)

@[simp]
theorem fullRealCircularQuotientEquiv_mk (hζ : IsPrimitiveRoot ζ (p ^ a)) (u : (𝓞 K⁺)ˣ) :
    fullRealCircularQuotientEquiv p a K hζ (QuotientGroup.mk u) =
      QuotientGroup.mk (Units.map (↑(algebraMap (𝓞 K⁺) (𝓞 K))) u) := by
  rw [fullRealCircularQuotientEquiv, MulEquiv.trans_apply, QuotientGroup.congr_mk]
  exact TauCeti.NumberField.quotientRealUnitsEquiv_mk _ u

/-- **Equality of full and real circular-unit indices**: for every prime `p` and every `a : ℕ`,
`[(𝓞 K)ˣ : cyclotomicUnits K ζ (p ^ a)] = [(𝓞 K⁺)ˣ : realCyclotomicUnits K ζ (p ^ a)]`. -/
theorem index_cyclotomicUnits_eq_index_realCyclotomicUnits (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    (cyclotomicUnits K ζ (p ^ a)).index = (realCyclotomicUnits K ζ (p ^ a)).index := by
  rw [realCyclotomicUnits_eq_comap]
  exact TauCeti.NumberField.index_eq_index_comap_realUnits (H := cyclotomicUnits K ζ (p ^ a))
    (realUnits_sup_cyclotomicUnits_eq_top p a K hζ)

/-- **Circular-unit index formula in the rational boundary cases `p ^ a ≤ 2`** (covering `a = 0`
and `p ^ a = 2`): both circular-unit indices equal `NumberField.classNumber K⁺`
(and both equal `1`). -/
theorem index_cyclotomicUnits_eq_classNumber_of_pow_le_two (hle : p ^ a ≤ 2) :
    (cyclotomicUnits K ζ (p ^ a)).index = NumberField.classNumber K⁺ ∧
      (realCyclotomicUnits K ζ (p ^ a)).index = NumberField.classNumber K⁺ := by
  have hfin := finrank_eq_one_of_pow_le_two (p := p) (a := a) (K := K) hle
  have hbijK := Algebra.finrank_eq_one_iff_bijective_algebraMap.mp hfin
  let e : ℚ ≃+* K⁺ := RingEquiv.ofBijective (algebraMap ℚ K⁺)
    ⟨(algebraMap ℚ K⁺).injective, fun x ↦ let ⟨q, hq⟩ := hbijK.2 (x : K); ⟨q, Subtype.ext hq⟩⟩
  let eO : ℤ ≃+* 𝓞 K⁺ := Rat.ringOfIntegersEquiv.symm.trans (RingOfIntegers.mapRingEquiv e)
  have hcl : NumberField.classNumber K⁺ = 1 :=
    NumberField.classNumber_eq_one_iff.mpr
      (IsPrincipalIdealRing.of_surjective eO.toRingHom eO.surjective)
  simp [hcl, cyclotomicUnits_eq_top_of_finrank_eq_one hfin,
    realCyclotomicUnits_eq_top_of_finrank_eq_one hfin]

end QuotientComparison

end TauCeti
