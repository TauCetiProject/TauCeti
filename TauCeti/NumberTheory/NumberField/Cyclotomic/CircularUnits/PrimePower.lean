/-!
# Prime-power circular units: structure, Galois generation, and quotient comparison

For a prime-power cyclotomic field `K / ℚ` of conductor `p ^ a` (any prime `p`, any `a : ℕ`) with
primitive `p ^ a`-th root of unity `ζ`, this file establishes the structure of the circular unit
groups `cyclotomicUnits K ζ (p ^ a)` and `realCyclotomicUnits K ζ (p ^ a)`:

1. **Root-of-unity factorization** (`IsPrimitiveRoot.one_sub_pow_mul_eq_prod`,
   `IsPrimitiveRoot.one_sub_pow_mul_pow_eq_prod`, `IsPrimitiveRoot.pow_mul_sub_one_eq_prod`):
   for `n = m * d` (`0 < n`), `1 - ζ ^ (b * d) = ∏ j ∈ range d, (1 - ζ ^ (b + j * m))`.
   When `n = p ^ a` and `c = b * p ^ r < p ^ a` with `p ∤ b`, every factor
   `1 - ζ ^ (b + j * p ^ (a - r))` has exponent prime to `p` and generates the prime ideal
   `(ζ - 1)` above `p`.
2. **Valuation elimination and real generators**: evaluating the unique prime ideal above `p`
   eliminates powers of `1 - ζ` from every integral circular unit, showing simultaneously that:
   * `cyclotomicUnits K ζ (p ^ a) = (realCyclotomicUnits K ζ (p ^ a)).map i ⊔ torsion K`
     for every prime `p` and every `a : ℕ`;
   * for odd `p` and `a = k + 1`, `realCyclotomicUnits K ζ (p ^ (k + 1))` is generated by the
     smoothed circular units `smoothedCyclotomicUnit`;
   * for `p = 2` and `a = k + 1`, `realCyclotomicUnits K ζ (2 ^ (k + 1))` is generated by the
     odd-smoothed circular units `oddSmoothedCyclotomicUnit`.
3. **Cyclic Galois generation for odd prime powers**: since `(ZMod (p ^ (k + 1)))ˣ` is cyclic for
   odd `p`, choosing a primitive root `g` gives an automorphism `τ ∈ Gal(K/ℚ)` whose cocycle
   product over `0 ≤ i < φ(p ^ (k + 1)) / 2` equals `-1` and whose Galois orbit of a single
   smoothed unit generates `realCyclotomicUnits K ζ (p ^ (k + 1))`.
4. **Full/real quotient isomorphism and index equality**: combining `torsion K ≤ cyclotomicUnits`
   with the prime-power Hasse unit index `indexRealUnits K = 1` gives
   `(𝓞 K⁺)ˣ ⧸ realCyclotomicUnits ≃* (𝓞 K)ˣ ⧸ cyclotomicUnits` and equal indices for every prime `p`
   and every `a : ℕ`, together with the rational boundary cases `p ^ a ≤ 2` where both indices
   equal `NumberField.classNumber K⁺ = 1`.

## Main results

* `IsPrimitiveRoot.one_sub_pow_mul_eq_prod`, `IsPrimitiveRoot.one_sub_pow_mul_pow_eq_prod`,
  `IsPrimitiveRoot.pow_mul_sub_one_eq_prod`: factorization of `1 - ζ ^ (b * d)` over `d`-th roots.
* `TauCeti.intValuation_one_sub_pow_of_coprime` and `TauCeti.valuation_one_sub_pow_of_coprime`:
  `P`-adic valuation of `1 - ζ ^ b` for `b.Coprime N` at `P = (ζ - 1)`.
* `TauCeti.torsion_le_cyclotomicUnits`: `μ(K) ≤ cyclotomicUnits K ζ (p ^ a)` for all `p, a`.
* `TauCeti.cyclotomicUnits_eq_map_realCyclotomicUnits_sup_torsion`:
  `cyclotomicUnits K ζ (p ^ a) = realCyclotomicUnits.map i ⊔ torsion K` for all `p, a`.
* `TauCeti.realCyclotomicUnits_eq_closure_smoothed` and
  `TauCeti.realCyclotomicUnits_eq_closure_oddSmoothed`: explicit real generators for odd `p` and
  for `p = 2`.
* `TauCeti.prod_realUnitsMapEquiv_smoothedCyclotomicUnit`,
  `TauCeti.prod_half_totient_realUnitsMapEquiv_smoothedCyclotomicUnit`,
  `TauCeti.realCyclotomicUnits_eq_closure_galois_orbit`, and
  `TauCeti.exists_cyclic_generator_realCyclotomicUnits`: cyclic Galois generation for odd `p`.
* `TauCeti.fullRealCircularQuotientEquiv`,
  `TauCeti.index_cyclotomicUnits_eq_index_realCyclotomicUnits`, and
  `TauCeti.index_cyclotomicUnits_eq_classNumber_of_pow_le_two`: full/real quotient comparison.

## References

* L. C. Washington, *Introduction to Cyclotomic Fields*, 2nd ed., Springer (1997), Chapter 8.
* R. Sharifi, *Iwasawa Theory*, Chapter 4.
-/

public section

open NumberField NumberField.Units NumberField.IsCMField IsDedekindDomain Finset

open scoped NumberField

/-! ### Root-of-unity factorization identities -/

namespace IsPrimitiveRoot

/-- For a primitive `n`-th root of unity `ζ` in an integral domain `R` with `n = m * d` and `0 < n`,
`1 - ζ ^ (b * d) = ∏ j ∈ Finset.range d, (1 - ζ ^ (b + j * m))` for every `b : ℕ`. -/
theorem one_sub_pow_mul_eq_prod {R : Type*} [CommRing R] [IsDomain R] {ζ : R} {n m d : ℕ}
    (hζ : IsPrimitiveRoot ζ n) (hn : 0 < n) (hprod : n = m * d) (b : ℕ) :
    1 - ζ ^ (b * d) = ∏ j ∈ Finset.range d, (1 - ζ ^ (b + j * m)) := by
  have hd : 0 < d := Nat.pos_of_ne_zero fun hd0 ↦ by simp [hd0] at hprod; omega
  have hζm : IsPrimitiveRoot (ζ ^ m) d := hζ.pow hn hprod
  have hpoly := X_pow_sub_C_eq_prod hζm hd (α := ζ ^ b) (a := ζ ^ (b * d))
    (by rw [← pow_mul])
  have heval := congrArg (Polynomial.eval (1 : R)) hpoly
  simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, one_pow,
    Polynomial.eval_C, Polynomial.eval_prod] at heval
  rw [heval]
  refine Finset.prod_congr rfl fun j _ ↦ ?_
  rw [← pow_mul, ← pow_add, add_comm, mul_comm]

/-- Prime-power / general-power specialization of `IsPrimitiveRoot.one_sub_pow_mul_eq_prod`:
for `0 < q`, `r ≤ a`, and a primitive `q ^ a`-th root of unity `ζ`,
`1 - ζ ^ (b * q ^ r) = ∏ j ∈ Finset.range (q ^ r), (1 - ζ ^ (b + j * q ^ (a - r)))`. -/
theorem one_sub_pow_mul_pow_eq_prod {R : Type*} [CommRing R] [IsDomain R] {ζ : R}
    {q a r : ℕ} (hq : 0 < q) (hr : r ≤ a) (hζ : IsPrimitiveRoot ζ (q ^ a)) (b : ℕ) :
    1 - ζ ^ (b * q ^ r) = ∏ j ∈ Finset.range (q ^ r), (1 - ζ ^ (b + j * q ^ (a - r))) :=
  hζ.one_sub_pow_mul_eq_prod (pow_pos hq a) (by rw [← pow_add, Nat.sub_add_cancel hr]) b

/-- Sign-reversed factorization for odd factor `d`:
`ζ ^ (b * d) - 1 = ∏ j ∈ Finset.range d, (ζ ^ (b + j * m) - 1)`. -/
theorem pow_mul_sub_one_eq_prod {R : Type*} [CommRing R] [IsDomain R] {ζ : R} {n m d : ℕ}
    (hζ : IsPrimitiveRoot ζ n) (hn : 0 < n) (hprod : n = m * d) (hd : Odd d) (b : ℕ) :
    ζ ^ (b * d) - 1 = ∏ j ∈ Finset.range d, (ζ ^ (b + j * m) - 1) := by
  calc ζ ^ (b * d) - 1
      = (-1 : R) ^ d * (1 - ζ ^ (b * d)) := by rw [hd.neg_one_pow]; ring
    _ = (-1 : R) ^ d * ∏ j ∈ Finset.range d, (1 - ζ ^ (b + j * m)) := by
        rw [hζ.one_sub_pow_mul_eq_prod hn hprod b]
    _ = (∏ _ ∈ Finset.range d, (-1 : R)) * ∏ j ∈ Finset.range d, (1 - ζ ^ (b + j * m)) := by
        rw [Finset.prod_const, Finset.card_range]
    _ = ∏ j ∈ Finset.range d, ((-1 : R) * (1 - ζ ^ (b + j * m))) := by
        rw [Finset.prod_mul_distrib]
    _ = ∏ j ∈ Finset.range d, (ζ ^ (b + j * m) - 1) := by
        refine Finset.prod_congr rfl fun j _ ↦ by ring

end IsPrimitiveRoot

namespace TauCeti

/-! ### Valuation of `1 - ζ ^ b` at the prime ideal `(ζ - 1)` -/

section Valuation

variable {K : Type*} [Field K] [NumberField K]

/-- For a height-one prime `v` of `𝓞 K` generated by `ζ - 1` (with `ζ` a primitive `N`-th root of
unity) and any `b` coprime to `N`, `1 - ζ ^ b` is a uniformizer at `v`. -/
theorem intValuation_one_sub_pow_of_coprime {N : ℕ} [NeZero N] {ζ : K} (hζ : IsPrimitiveRoot ζ N)
    (v : HeightOneSpectrum (𝓞 K)) (hv : v.asIdeal = Ideal.span {hζ.toInteger - 1})
    {b : ℕ} (hb : b.Coprime N) :
    v.intValuation (1 - hζ.toInteger ^ b) = WithZero.exp (-1 : ℤ) := by
  have hassoc1 : Associated (hζ.toInteger - 1) (hζ.toInteger ^ b - 1) :=
    hζ.toInteger_isPrimitiveRoot.associated_sub_one_pow_sub_one_of_coprime hb
  have hassoc2 : Associated (hζ.toInteger - 1) (1 - hζ.toInteger ^ b) := by
    refine hassoc1.trans ⟨-1, ?_⟩
    simp
  have hv' : v.asIdeal = Ideal.span {1 - hζ.toInteger ^ b} := by
    rw [hv, Ideal.span_singleton_eq_span_singleton]
    exact hassoc2
  have hne : 1 - hζ.toInteger ^ b ≠ 0 := by
    intro h0
    rw [h0, Ideal.span_singleton_zero] at hv'
    exact v.ne_bot hv'
  exact v.intValuation_singleton hne hv'

/-- Field-level version of `intValuation_one_sub_pow_of_coprime`: `v.valuation K (1 - ζ ^ b)` equals
`WithZero.exp (-1 : ℤ)` whenever `v.asIdeal = Ideal.span {ζ - 1}` and `b.Coprime N`. -/
theorem valuation_one_sub_pow_of_coprime {N : ℕ} [NeZero N] {ζ : K} (hζ : IsPrimitiveRoot ζ N)
    (v : HeightOneSpectrum (𝓞 K)) (hv : v.asIdeal = Ideal.span {hζ.toInteger - 1})
    {b : ℕ} (hb : b.Coprime N) :
    v.valuation K (1 - ζ ^ b) = WithZero.exp (-1 : ℤ) := by
  have hcoe : (1 - ζ ^ b : K) = algebraMap (𝓞 K) K (1 - hζ.toInteger ^ b) := by
    rw [map_sub, map_one, map_pow]
    rfl
  rw [hcoe, v.valuation_of_algebraMap]
  exact intValuation_one_sub_pow_of_coprime hζ v hv hb

end Valuation

/-! ### Prime-power circular units: torsion containment and real decomposition -/

section PrimePowerDecomposition

/-- In any prime-power cyclotomic field over `ℚ` (for any prime `p` and any `a : ℕ`), all roots
of unity lie in the circular unit group `cyclotomicUnits K ζ (p ^ a)`. -/
theorem torsion_le_cyclotomicUnits (p a : ℕ) [hp : Fact p.Prime] (K : Type*) [Field K]
    [NumberField K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    torsion K ≤ cyclotomicUnits K ζ (p ^ a) := by
  rcases a with _ | k
  · have hfin : Module.finrank ℚ K = 1 := by
      have hpos : 0 < p ^ 0 := pow_pos hp.out.pos 0
      have : NeZero (p ^ 0) := ⟨hpos.ne'⟩
      rw [IsCyclotomicExtension.finrank K (Polynomial.cyclotomic.irreducible_rat hpos)]
      simp
    rw [cyclotomicUnits_eq_top_of_finrank_eq_one hfin]
    exact le_top
  · set N := p ^ (k + 1)
    have hNpos : 0 < N := pow_pos hp.out.pos (k + 1)
    have : NeZero N := ⟨hNpos.ne'⟩
    let uζ : (𝓞 K)ˣ := (hζ.toInteger_isPrimitiveRoot.isUnit hNpos.ne').unit
    have huζ_val : ((uζ : 𝓞 K) : K) = ζ := rfl
    have huζ_circ : uζ ∈ cyclotomicUnits K ζ N := by
      rw [mem_cyclotomicUnits_iff]
      exact mem_cyclotomicNumbers_of_eq huζ_val
    have huζ_prim : IsPrimitiveRoot uζ N :=
      IsPrimitiveRoot.coe_units_iff.mp hζ.toInteger_isPrimitiveRoot
    have huζ_ord : orderOf uζ = N := huζ_prim.eq_orderOf.symm
    -- Exhibit a generator `g` of `torsion K` lying inside `cyclotomicUnits K ζ N`.
    suffices ∃ g : (𝓞 K)ˣ, g ∈ cyclotomicUnits K ζ N ∧ g ∈ torsion K ∧
        orderOf g = torsionOrder K by
      obtain ⟨g, hg_circ, hg_tors, hg_ord⟩ := this
      let g' : torsion K := ⟨g, hg_tors⟩
      have hg'_ord : orderOf g' = Nat.card (torsion K) := by
        rw [← torsionOrder, ← hg_ord]
        exact (orderOf_injective (torsion K).subtype Subtype.val_injective g').symm
      have hzpow : Subgroup.zpowers g' = ⊤ :=
        Subgroup.eq_top_of_card_eq _ (by rw [Nat.card_zpowers, hg'_ord])
      intro u hu
      have hmem : (⟨u, hu⟩ : torsion K) ∈ Subgroup.zpowers g' := by
        rw [hzpow]
        trivial
      obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hmem
      have hu_eq : u = g ^ m := by
        have := congrArg (Subtype.val : torsion K → (𝓞 K)ˣ) hm
        simpa [g'] using this.symm
      rw [hu_eq]
      exact zpow_mem hg_circ m
    by_cases hp2 : p = 2
    · refine ⟨uζ, huζ_circ, ?_, ?_⟩
      · rw [NumberField.Units.torsion, CommGroup.mem_torsion, isOfFinOrder_iff_pow_eq_one]
        exact ⟨N, hNpos, huζ_prim.pow_eq_one⟩
      · rw [IsCyclotomicExtension.Rat.torsionOrder_eq (n := N) (K := K)]
        have hEven : Even N := by
          simp only [N, hp2]
          exact Even.pow_of_ne_zero even_two (by omega)
        simp [hEven, huζ_ord]
    · have hNodd : Odd N := (hp.out.odd_of_ne_two hp2).pow
      have hneg_ne_one : (-1 : (𝓞 K)ˣ) ≠ 1 := by
        intro h1
        have hK : (-1 : K) = 1 := congrArg (fun u : (𝓞 K)ˣ ↦ ((u : 𝓞 K) : K)) h1
        have h2 : (2 : K) = 0 := by linear_combination -hK
        exact two_ne_zero h2
      have hneg_ord : orderOf (-1 : (𝓞 K)ˣ) = 2 := by
        rw [orderOf_eq_iff (by omega)]
        refine ⟨by simp, fun m hm hm0 ↦ ?_⟩
        have hm1 : m = 1 := by omega
        subst hm1
        rw [pow_one]
        exact hneg_ne_one
      have hord_mul : orderOf ((-1 : (𝓞 K)ˣ) * uζ) = 2 * N := by
        rw [(Commute.all (-1 : (𝓞 K)ˣ) uζ).orderOf_mul_eq_mul_orderOf_of_coprime
          (by rw [hneg_ord, huζ_ord]; exact Nat.coprime_two_left.mpr hNodd),
          hneg_ord, huζ_ord]
      refine ⟨(-1 : (𝓞 K)ˣ) * uζ, mul_mem (neg_one_mem_cyclotomicUnits ζ N) huζ_circ, ?_, ?_⟩
      · rw [NumberField.Units.torsion, CommGroup.mem_torsion, isOfFinOrder_iff_pow_eq_one]
        refine ⟨2 * N, by positivity, ?_⟩
        rw [← hord_mul, pow_orderOf_eq_one]
      · rw [IsCyclotomicExtension.Rat.torsionOrder_eq (n := N) (K := K)]
        have hNotEven : ¬ Even N := Nat.not_even_iff_odd.mpr hNodd
        simp only [hNotEven, ↓reduceIte]
        exact hord_mul

/-- Every cyclotomic number in a prime-power cyclotomic field lies in the subgroup generated by
`1 - ζ`, `torsion K`, and any real subgroup `G` expressing `(1 - ζ ^ m) / (1 - ζ)` for `p ∤ m`. -/
private theorem cyclotomicNumbers_le_of_real_generators (p k : ℕ) [hp : Fact p.Prime]
    {K : Type*} [Field K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) (h1ζ : 1 - ζ ≠ 0)
    (G : Subgroup (𝓞 (maximalRealSubfield K))ˣ)
    (hG_ratio : ∀ m : ℕ, ¬ p ∣ m →
      ∃ μ ∈ torsion K, ∃ y ∈ G,
        1 - ζ ^ m = (1 - ζ) * ((μ : 𝓞 K) : K) *
          (((y : 𝓞 (maximalRealSubfield K)) : maximalRealSubfield K) : K)) :
    cyclotomicNumbers ζ (p ^ (k + 1)) ≤
      Subgroup.zpowers (Units.mk0 (1 - ζ) h1ζ) ⊔
        (G.map (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) ⊔
          torsion K).map (Units.map (algebraMap (𝓞 K) K).toMonoidHom) := by
  set N := p ^ (k + 1)
  have hNpos : 0 < N := pow_pos hp.out.pos (k + 1)
  have : NeZero N := ⟨hNpos.ne'⟩
  let iO : (𝓞 K)ˣ →* Kˣ := Units.map (algebraMap (𝓞 K) K).toMonoidHom
  let iR : (𝓞 (maximalRealSubfield K))ˣ →* (𝓞 K)ˣ :=
    Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
  set U₁ : Kˣ := Units.mk0 (1 - ζ) h1ζ
  set S : Subgroup Kˣ := Subgroup.zpowers U₁ ⊔ (G.map iR ⊔ torsion K).map iO
  let uζ : (𝓞 K)ˣ := (hζ.toInteger_isPrimitiveRoot.isUnit hNpos.ne').unit
  have huζ_tors : uζ ∈ torsion K := by
    rw [NumberField.Units.torsion, CommGroup.mem_torsion, isOfFinOrder_iff_pow_eq_one]
    exact ⟨N, hNpos, (IsPrimitiveRoot.coe_units_iff.mp hζ.toInteger_isPrimitiveRoot).pow_eq_one⟩
  have hneg_tors : (-1 : (𝓞 K)ˣ) ∈ torsion K := by
    rw [NumberField.Units.torsion, CommGroup.mem_torsion, isOfFinOrder_iff_pow_eq_one]
    exact ⟨2, by omega, by simp⟩
  rw [cyclotomicNumbers_eq_closure, Subgroup.closure_le]
  rintro u (hu | hu | ⟨c, hc0, hcN, hu⟩)
  · have hEq : u = iO (-1 : (𝓞 K)ˣ) := Units.ext (by simpa [iO] using hu)
    rw [hEq]
    exact Subgroup.mem_sup_right (Subgroup.mem_map_of_mem iO (Subgroup.mem_sup_right hneg_tors))
  · have hEq : u = iO uζ := Units.ext hu
    rw [hEq]
    exact Subgroup.mem_sup_right (Subgroup.mem_map_of_mem iO (Subgroup.mem_sup_right huζ_tors))
  · set r := c.factorization p
    set b := c / p ^ r
    have hcb : b * p ^ r = c := by
      rw [mul_comm]
      exact Nat.ordProj_mul_ordCompl_eq_self c p
    have hr_lt : r < k + 1 := by
      by_contra hge
      push Not at hge
      have hdvd1 : p ^ (k + 1) ∣ p ^ r := Nat.pow_dvd_pow p hge
      have hdvd2 : p ^ r ∣ c := ⟨b, by rw [← hcb, mul_comm]⟩
      have hle := Nat.le_of_dvd hc0 (hdvd1.trans hdvd2)
      omega
    have hnb : ¬ p ∣ b := Nat.not_dvd_ordCompl hp.out hc0.ne'
    have hfac := hζ.one_sub_pow_mul_pow_eq_prod hp.out.pos (le_of_lt hr_lt) b
    rw [hcb] at hfac
    have hterm : ∀ j : ℕ, ∃ w : Kˣ, w ∈ S ∧ (w : K) = 1 - ζ ^ (b + j * p ^ (k + 1 - r)) := by
      intro j
      have hndvd : ¬ p ∣ b + j * p ^ (k + 1 - r) := by
        intro hdiv
        have hp_pow : p ∣ p ^ (k + 1 - r) := dvd_pow_self p (by omega)
        exact hnb ((Nat.dvd_add_left (dvd_mul_of_dvd_right hp_pow j)).mp hdiv)
      obtain ⟨μ, hμ, y, hy, hval⟩ := hG_ratio (b + j * p ^ (k + 1 - r)) hndvd
      refine ⟨U₁ * iO (iR y * μ), ?_, ?_⟩
      · exact mul_mem (Subgroup.mem_sup_left (Subgroup.mem_zpowers U₁))
          (Subgroup.mem_sup_right (Subgroup.mem_map_of_mem iO
            (mul_mem (Subgroup.mem_sup_left (Subgroup.mem_map_of_mem iR hy))
              (Subgroup.mem_sup_right hμ))))
      · rw [hval]
        have hmulK : ((iO (iR y * μ) : Kˣ) : K) =
            (((y : 𝓞 (maximalRealSubfield K)) : maximalRealSubfield K) : K) *
              ((μ : 𝓞 K) : K) := by
          rw [map_mul, Units.val_mul]
          rfl
        rw [Units.val_mul, hmulK]
        simp only [U₁, Units.val_mk0]
        ring
    choose w hwS hwval using hterm
    have hprodS : (∏ j ∈ Finset.range (p ^ r), w j) ∈ S :=
      Subgroup.prod_mem S fun j _ ↦ hwS j
    have huEq : u = ∏ j ∈ Finset.range (p ^ r), w j := by
      apply Units.ext
      rw [hu, hfac, ← Units.coeHom_apply, map_prod]
      exact Finset.prod_congr rfl fun j _ ↦ (hwval j).symm
    rw [huEq]
    exact hprodS

/-- Unified valuation-elimination lemma for prime-power cyclotomic fields: if a subgroup
`G ≤ realCyclotomicUnits K ζ (p ^ (k + 1))` contains `-1` and expresses `(1 - ζ ^ m) / (1 - ζ)`
up to roots of unity for every `m` not divisible by `p`, then
`cyclotomicUnits = G.map i ⊔ torsion K` and `realCyclotomicUnits = G`. -/
private theorem decomposition_of_real_generators (p k : ℕ) [hp : Fact p.Prime] {K : Type*} [Field K]
    [NumberField K] [IsCyclotomicExtension {p ^ (k + 1)} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1)))
    (G : Subgroup (𝓞 (maximalRealSubfield K))ˣ)
    (hG_neg : (-1 : (𝓞 (maximalRealSubfield K))ˣ) ∈ G)
    (hG_le : G ≤ realCyclotomicUnits K ζ (p ^ (k + 1)))
    (hG_ratio : ∀ m : ℕ, ¬ p ∣ m →
      ∃ μ ∈ torsion K, ∃ y ∈ G,
        1 - ζ ^ m = (1 - ζ) * ((μ : 𝓞 K) : K) *
          (((y : 𝓞 (maximalRealSubfield K)) : maximalRealSubfield K) : K)) :
    cyclotomicUnits K ζ (p ^ (k + 1)) =
        G.map (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) ⊔
          torsion K ∧
      realCyclotomicUnits K ζ (p ^ (k + 1)) = G := by
  set N := p ^ (k + 1)
  have hNpos : 0 < N := pow_pos hp.out.pos (k + 1)
  have : NeZero N := ⟨hNpos.ne'⟩
  have hN2 : 2 ≤ N := by
    calc 2 ≤ p := hp.out.two_le
      _ = p ^ 1 := (pow_one p).symm
      _ ≤ p ^ (k + 1) := Nat.pow_le_pow_right hp.out.pos (by omega)
  have h1ζ : 1 - ζ ≠ 0 := sub_ne_zero.mpr (hζ.ne_one (by omega)).symm
  let iO : (𝓞 K)ˣ →* Kˣ := Units.map (algebraMap (𝓞 K) K).toMonoidHom
  let iR : (𝓞 (maximalRealSubfield K))ˣ →* (𝓞 K)ˣ :=
    Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
  set T : Subgroup (𝓞 K)ˣ := G.map iR ⊔ torsion K
  set U₁ : Kˣ := Units.mk0 (1 - ζ) h1ζ
  have hnum_le := cyclotomicNumbers_le_of_real_generators p k hζ h1ζ G hG_ratio
  -- Evaluate the unique prime `v = (ζ - 1)` above `p` to kill the power of `1 - ζ`.
  have hle_T : cyclotomicUnits K ζ N ≤ T := by
    intro u hu
    have hmemS := hnum_le (mem_cyclotomicUnits_iff.mp hu)
    rw [Subgroup.mem_sup] at hmemS
    obtain ⟨x, hx, z, hz, hxz⟩ := hmemS
    obtain ⟨e, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
    obtain ⟨t, ht, rfl⟩ := Subgroup.mem_map.mp hz
    let v : HeightOneSpectrum (𝓞 K) :=
      { asIdeal := Ideal.span {hζ.toInteger - 1}
        isPrime := IsCyclotomicExtension.Rat.isPrime_span_zeta_sub_one p k hζ
        ne_bot := IsCyclotomicExtension.Rat.span_zeta_sub_one_ne_bot p k hζ }
    have hvU₁ : v.valuation K (U₁ : K) = WithZero.exp (-1 : ℤ) := by
      have h1 : (U₁ : K) = 1 - ζ ^ 1 := by simp [U₁]
      rw [h1]
      exact valuation_one_sub_pow_of_coprime hζ v rfl (Nat.coprime_one_left N)
    have hv_unit : ∀ w : (𝓞 K)ˣ, v.valuation K ((iO w : Kˣ) : K) = 1 := fun w ↦ by
      have hcoe : ((iO w : Kˣ) : K) = algebraMap (𝓞 K) K (w : 𝓞 K) := rfl
      rw [hcoe, v.valuation_of_algebraMap, v.intValuation_eq_one_iff]
      exact fun hmem ↦ v.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem w.isUnit)
    have hvEq : v.valuation K ((iO u : Kˣ) : K) =
        v.valuation K (((U₁ ^ e : Kˣ) : K) * ((iO t : Kˣ) : K)) := by
      rw [← Units.val_mul, hxz]
    rw [map_mul, hv_unit u, hv_unit t, mul_one, Units.val_zpow_eq_zpow_val, map_zpow₀, hvU₁,
      ← WithZero.exp_zsmul, smul_eq_mul, mul_neg_one] at hvEq
    have he0 : e = 0 := by
      have : (0 : ℤ) = -e := WithZero.exp_injective (by simpa using hvEq)
      omega
    subst he0
    rw [zpow_zero, one_mul] at hxz
    have hut : t = u := Units.map_injective (FaithfulSMul.algebraMap_injective (𝓞 K) K) hxz
    rwa [← hut]
  -- Deduce both `cyclotomicUnits = G.map iR ⊔ torsion K` and `realCyclotomicUnits = G`.
  have hT_le : T ≤ cyclotomicUnits K ζ N := by
    refine sup_le ?_ (torsion_le_cyclotomicUnits p (k + 1) K hζ)
    rintro _ ⟨y, hy, rfl⟩
    exact mem_realCyclotomicUnits_iff.mp (hG_le hy)
  have hfull : cyclotomicUnits K ζ N = T := le_antisymm hle_T hT_le
  refine ⟨hfull, le_antisymm ?_ hG_le⟩
  intro u hu
  have hiRu : iR u ∈ T := hfull ▸ (mem_realCyclotomicUnits_iff.mp hu)
  rw [Subgroup.mem_sup] at hiRu
  obtain ⟨x, hx, μ, hμ, hmul⟩ := hiRu
  obtain ⟨g, hg, rfl⟩ := Subgroup.mem_map.mp hx
  have hμ_eq : μ = iR (g⁻¹ * u) := by
    rw [map_mul, map_inv]
    exact eq_inv_mul_of_mul_eq hmul
  have hμ_real : μ ∈ realUnits K := by
    rw [mem_realUnits_iff]
    exact ⟨g⁻¹ * u, by simpa [iR] using congrArg Units.val hμ_eq.symm⟩
  rcases TauCeti.NumberField.eq_one_or_neg_one_of_mem_torsion_of_mem_realUnits hμ hμ_real with
      rfl | rfl
  · rw [mul_one] at hmul
    have hgu : g = u :=
      Units.map_injective (FaithfulSMul.algebraMap_injective (𝓞 (maximalRealSubfield K)) (𝓞 K)) hmul
    rwa [← hgu]
  · have hEq : iR (-g) = iR u := by
      rw [← hmul]
      apply Units.ext
      apply RingOfIntegers.ext
      simp [iR]
    have hgu : -g = u :=
      Units.map_injective (FaithfulSMul.algebraMap_injective (𝓞 (maximalRealSubfield K)) (𝓞 K)) hEq
    rw [← hgu, ← neg_one_mul]
    exact mul_mem hG_neg hg

private theorem odd_real_generators_decomp (p k : ℕ) [hp : Fact p.Prime] (hp2 : p ≠ 2)
    (K : Type*) [Field K] [NumberField K] [IsCyclotomicExtension {p ^ (k + 1)} ℚ K]
    {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) :
    let hodd : Odd (p ^ (k + 1)) := (hp.out.odd_of_ne_two hp2).pow
    let hN2 : 2 ≤ p ^ (k + 1) := by
      calc 2 ≤ p := hp.out.two_le
        _ = p ^ 1 := (pow_one p).symm
        _ ≤ p ^ (k + 1) := Nat.pow_le_pow_right hp.out.pos (by omega)
    let G : Subgroup (𝓞 (maximalRealSubfield K))ˣ :=
      Subgroup.closure {u | ∃ (b : ℤ) (hb : b.gcd (p ^ (k + 1)) = 1),
        u = smoothedCyclotomicUnit hζ hodd hN2 hb}
    cyclotomicUnits K ζ (p ^ (k + 1)) =
        G.map (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) ⊔
          torsion K ∧
      realCyclotomicUnits K ζ (p ^ (k + 1)) = G := by
  intro hodd hN2 G
  set N := p ^ (k + 1)
  have hNpos : 0 < N := pow_pos hp.out.pos (k + 1)
  have : NeZero N := ⟨hNpos.ne'⟩
  refine decomposition_of_real_generators p k hζ G ?_ ?_ ?_
  · exact Subgroup.subset_closure
      ⟨-1, by simp, (smoothedCyclotomicUnit_neg_one hζ hodd hN2).symm⟩
  · rw [Subgroup.closure_le]
    rintro u ⟨b, hb, rfl⟩
    exact smoothedCyclotomicUnit_mem_realCyclotomicUnits hζ hodd hN2 hb
  · intro m hm
    have hcop : m.Coprime N := (hp.out.coprime_iff_not_dvd.mpr hm).symm.pow_right (k + 1)
    have hgcd : ((m : ℤ)).gcd (p ^ (k + 1)) = 1 := by
      rw [← Nat.cast_pow, Int.gcd_natCast_natCast]
      exact hcop
    let uζ : (𝓞 K)ˣ := (hζ.toInteger_isPrimitiveRoot.isUnit hNpos.ne').unit
    have huζ_tors : uζ ∈ torsion K := by
      rw [NumberField.Units.torsion, CommGroup.mem_torsion, isOfFinOrder_iff_pow_eq_one]
      exact ⟨N, hNpos, (IsPrimitiveRoot.coe_units_iff.mp hζ.toInteger_isPrimitiveRoot).pow_eq_one⟩
    set e : ℤ := (((N + 1) / 2 : ℕ) : ℤ) * (1 - (m : ℤ))
    refine ⟨uζ ^ (-e), zpow_mem huζ_tors (-e), smoothedCyclotomicUnit hζ hodd hN2 hgcd,
      Subgroup.subset_closure ⟨(m : ℤ), hgcd, rfl⟩, ?_⟩
    have hcoe_uζ : (((uζ ^ (-e) : (𝓞 K)ˣ) : 𝓞 K) : K) = ζ ^ (-e) := by
      have h1 : (((uζ ^ (-e) : (𝓞 K)ˣ) : 𝓞 K) : K) =
          ((Units.map (algebraMap (𝓞 K) K).toMonoidHom uζ ^ (-e) : Kˣ) : K) := by
        rw [← map_zpow]
        rfl
      rw [h1, Units.val_zpow_eq_zpow_val]
      rfl
    rw [hcoe_uζ, coe_smoothedCyclotomicUnit, smoothedCyclotomicRatio_eq, cyclotomicRatio_eq]
    have hζ0 : ζ ≠ 0 := hζ.ne_zero hNpos.ne'
    have hζ1 : ζ - 1 ≠ 0 := sub_ne_zero.mpr (hζ.ne_one (by omega))
    have hmul_zpow : ζ ^ (-e) * ζ ^ e = 1 := by
      rw [← zpow_add₀ hζ0, neg_add_cancel, zpow_zero]
    rw [zpow_natCast]
    calc 1 - ζ ^ m
        = -(ζ ^ m - 1) := by ring
      _ = (1 - ζ) * ((ζ ^ m - 1) / (ζ - 1)) := by field_simp; ring
      _ = (1 - ζ) * (ζ ^ (-e) * ζ ^ e) * ((ζ ^ m - 1) / (ζ - 1)) := by rw [hmul_zpow, mul_one]
      _ = (1 - ζ) * ζ ^ (-e) * (ζ ^ e * ((ζ ^ m - 1) / (ζ - 1))) := by ring

private theorem two_real_generators_decomp (k : ℕ) (K : Type*) [Field K] [NumberField K]
    [IsCyclotomicExtension {2 ^ (k + 1)} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ (2 ^ (k + 1))) :
    let hN2 : 2 ≤ 2 ^ (k + 1) := by
      calc 2 = 2 ^ 1 := (pow_one 2).symm
        _ ≤ 2 ^ (k + 1) := Nat.pow_le_pow_right (by omega) (by omega)
    let G : Subgroup (𝓞 (maximalRealSubfield K))ˣ :=
      Subgroup.closure {u | ∃ (b : ℤ) (hodd : Odd b) (hb : b.gcd (2 ^ (k + 1)) = 1),
        u = oddSmoothedCyclotomicUnit hζ hN2 hodd hb}
    cyclotomicUnits K ζ (2 ^ (k + 1)) =
        G.map (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) ⊔
          torsion K ∧
      realCyclotomicUnits K ζ (2 ^ (k + 1)) = G := by
  intro hN2 G
  set N := 2 ^ (k + 1)
  have hNpos : 0 < N := pow_pos (by omega) (k + 1)
  have : NeZero N := ⟨hNpos.ne'⟩
  refine decomposition_of_real_generators 2 k hζ G ?_ ?_ ?_
  · exact Subgroup.subset_closure
      ⟨-1, odd_one.neg, by simp, (oddSmoothedCyclotomicUnit_neg_one hζ hN2).symm⟩
  · rw [Subgroup.closure_le]
    rintro u ⟨b, hodd, hb, rfl⟩
    exact oddSmoothedCyclotomicUnit_mem_realCyclotomicUnits hζ hN2 hodd hb
  · intro m hm
    have hm_odd_nat : Odd m := Nat.not_even_iff_odd.mp (by rwa [even_iff_two_dvd])
    have hm_odd : Odd (m : ℤ) := by
      obtain ⟨t, rfl⟩ := hm_odd_nat
      exact ⟨(t : ℤ), by push_cast; ring⟩
    have hcop : m.Coprime N := (Nat.prime_two.coprime_iff_not_dvd.mpr hm).symm.pow_right (k + 1)
    have hgcd : ((m : ℤ)).gcd (2 ^ (k + 1)) = 1 := by
      rw [← Nat.cast_ofNat (n := 2), ← Nat.cast_pow, Int.gcd_natCast_natCast]
      exact hcop
    let uζ : (𝓞 K)ˣ := (hζ.toInteger_isPrimitiveRoot.isUnit hNpos.ne').unit
    have huζ_tors : uζ ∈ torsion K := by
      rw [NumberField.Units.torsion, CommGroup.mem_torsion, isOfFinOrder_iff_pow_eq_one]
      exact ⟨N, hNpos, (IsPrimitiveRoot.coe_units_iff.mp hζ.toInteger_isPrimitiveRoot).pow_eq_one⟩
    set e : ℤ := (1 - (m : ℤ)) / 2
    refine ⟨uζ ^ (-e), zpow_mem huζ_tors (-e), oddSmoothedCyclotomicUnit hζ hN2 hm_odd hgcd,
      Subgroup.subset_closure ⟨(m : ℤ), hm_odd, hgcd, rfl⟩, ?_⟩
    have hcoe_uζ : (((uζ ^ (-e) : (𝓞 K)ˣ) : 𝓞 K) : K) = ζ ^ (-e) := by
      have h1 : (((uζ ^ (-e) : (𝓞 K)ˣ) : 𝓞 K) : K) =
          ((Units.map (algebraMap (𝓞 K) K).toMonoidHom uζ ^ (-e) : Kˣ) : K) := by
        rw [← map_zpow]
        rfl
      rw [h1, Units.val_zpow_eq_zpow_val]
      rfl
    rw [hcoe_uζ, coe_oddSmoothedCyclotomicUnit, oddSmoothedCyclotomicRatio_eq, cyclotomicRatio_eq]
    have hζ0 : ζ ≠ 0 := hζ.ne_zero hNpos.ne'
    have hζ1 : ζ - 1 ≠ 0 := sub_ne_zero.mpr (hζ.ne_one (by omega))
    have hmul_zpow : ζ ^ (-e) * ζ ^ e = 1 := by
      rw [← zpow_add₀ hζ0, neg_add_cancel, zpow_zero]
    rw [zpow_natCast]
    calc 1 - ζ ^ m
        = -(ζ ^ m - 1) := by ring
      _ = (1 - ζ) * ((ζ ^ m - 1) / (ζ - 1)) := by field_simp; ring
      _ = (1 - ζ) * (ζ ^ (-e) * ζ ^ e) * ((ζ ^ m - 1) / (ζ - 1)) := by rw [hmul_zpow, mul_one]
      _ = (1 - ζ) * ζ ^ (-e) * (ζ ^ e * ((ζ ^ m - 1) / (ζ - 1))) := by ring

/-- **Real circular-unit generators for odd prime powers**: for an odd prime `p` and `k : ℕ`,
`realCyclotomicUnits K ζ (p ^ (k + 1))` is generated by the smoothed circular units
`smoothedCyclotomicUnit` for integers `b` coprime to `p ^ (k + 1)`. -/
theorem realCyclotomicUnits_eq_closure_smoothed (p k : ℕ) [hp : Fact p.Prime] (hp2 : p ≠ 2)
    (K : Type*) [Field K] [NumberField K] [IsCyclotomicExtension {p ^ (k + 1)} ℚ K]
    {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) :
    let hodd : Odd (p ^ (k + 1)) := (hp.out.odd_of_ne_two hp2).pow
    let hN2 : 2 ≤ p ^ (k + 1) := by
      calc 2 ≤ p := hp.out.two_le
        _ = p ^ 1 := (pow_one p).symm
        _ ≤ p ^ (k + 1) := Nat.pow_le_pow_right hp.out.pos (by omega)
    realCyclotomicUnits K ζ (p ^ (k + 1)) =
      Subgroup.closure {u | ∃ (b : ℤ) (hb : b.gcd (p ^ (k + 1)) = 1),
        u = smoothedCyclotomicUnit hζ hodd hN2 hb} :=
  (odd_real_generators_decomp p k hp2 K hζ).2

/-- **Real circular-unit generators for powers of `2`**: for any `k : ℕ`,
`realCyclotomicUnits K ζ (2 ^ (k + 1))` is generated by the odd-smoothed circular units
`oddSmoothedCyclotomicUnit` for odd integers `b` coprime to `2 ^ (k + 1)`. -/
theorem realCyclotomicUnits_eq_closure_oddSmoothed (k : ℕ) (K : Type*) [Field K] [NumberField K]
    [IsCyclotomicExtension {2 ^ (k + 1)} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ (2 ^ (k + 1))) :
    let hN2 : 2 ≤ 2 ^ (k + 1) := by
      calc 2 = 2 ^ 1 := (pow_one 2).symm
        _ ≤ 2 ^ (k + 1) := Nat.pow_le_pow_right (by omega) (by omega)
    realCyclotomicUnits K ζ (2 ^ (k + 1)) =
      Subgroup.closure {u | ∃ (b : ℤ) (hodd : Odd b) (hb : b.gcd (2 ^ (k + 1)) = 1),
        u = oddSmoothedCyclotomicUnit hζ hN2 hodd hb} :=
  (two_real_generators_decomp k K hζ).2

/-- **Decomposition of full circular units into real circular units and roots of unity**:
for every prime `p` and every `a : ℕ`,
`cyclotomicUnits K ζ (p ^ a) = (realCyclotomicUnits K ζ (p ^ a)).map i ⊔ torsion K`. -/
theorem cyclotomicUnits_eq_map_realCyclotomicUnits_sup_torsion (p a : ℕ) [hp : Fact p.Prime]
    (K : Type*) [Field K] [NumberField K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    cyclotomicUnits K ζ (p ^ a) =
      (realCyclotomicUnits K ζ (p ^ a)).map
        (Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom) ⊔
      torsion K := by
  let iR : (𝓞 (maximalRealSubfield K))ˣ →* (𝓞 K)ˣ :=
    Units.map (algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)).toMonoidHom
  rcases a with _ | k
  · have hfin : Module.finrank ℚ K = 1 := by
      have hpos : 0 < p ^ 0 := pow_pos hp.out.pos 0
      have : NeZero (p ^ 0) := ⟨hpos.ne'⟩
      rw [IsCyclotomicExtension.finrank K (Polynomial.cyclotomic.irreducible_rat hpos)]
      simp
    have hreal_top : (realCyclotomicUnits K ζ (p ^ 0)).map iR = realUnits K := by
      rw [realCyclotomicUnits_eq_top_of_finrank_eq_one hfin, Subgroup.map_top]
      rfl
    rw [cyclotomicUnits_eq_top_of_finrank_eq_one hfin, hreal_top,
      TauCeti.IsCyclotomicExtension.Rat.realUnits_sup_torsion_eq_top p 0 K]
  · by_cases hp2 : p = 2
    · subst hp2
      have hdecomp := two_real_generators_decomp k K hζ
      rw [hdecomp.2, hdecomp.1]
    · have hdecomp := odd_real_generators_decomp p k hp2 K hζ
      rw [hdecomp.2, hdecomp.1]

end PrimePowerDecomposition

/-! ### Cyclic Galois generation for odd prime powers -/

section CyclicGaloisGeneration

/-- Cocycle product identity for smoothed circular units under powers of an automorphism `τ`
acting on `ζ` by `τ ζ = ζ ^ c`. -/
theorem prod_realUnitsMapEquiv_smoothedCyclotomicUnit {K : Type*} [Field K] [Algebra ℚ K]
    {N : ℕ} (hodd : Odd N) (hN : 2 ≤ N) {ζ : K} (hζ : IsPrimitiveRoot ζ N)
    {τ : Gal(K/ℚ)} {c : ℤ} (hc : c.gcd N = 1) (hτ : τ ζ = ζ ^ c) (n : ℕ) :
    ∏ i ∈ Finset.range n,
      realUnitsMapEquiv (τ ^ i).toRingEquiv (smoothedCyclotomicUnit hζ hodd hN hc) =
    smoothedCyclotomicUnit hζ hodd hN
      (by rw [← Int.isCoprime_iff_gcd_eq_one] at hc ⊢; exact hc.pow_left : (c ^ n).gcd N = 1) := by
  have hpow_gal : ∀ m : ℕ, (τ ^ m) ζ = ζ ^ (c ^ m) := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      rw [pow_succ, AlgEquiv.mul_apply, hτ, map_zpow₀, ih, ← zpow_mul, pow_succ]
  induction n with
  | zero =>
    simp [smoothedCyclotomicUnit_one]
  | succ n ih =>
    rw [Finset.prod_range_succ, ih]
    apply Units.ext
    apply RingOfIntegers.ext
    apply Subtype.ext
    have hcn : (c ^ n).gcd N = 1 := by
      rw [← Int.isCoprime_iff_gcd_eq_one] at hc ⊢
      exact hc.pow_left
    have hζcn : ζ ^ (c ^ n) ≠ 1 := (hζ.zpow_of_gcd_eq_one (c ^ n) hcn).ne_one (by omega)
    have hlhs :
        (((smoothedCyclotomicUnit hζ hodd hN hcn *
            realUnitsMapEquiv (τ ^ n).toRingEquiv (smoothedCyclotomicUnit hζ hodd hN hc) :
              (𝓞 (maximalRealSubfield K))ˣ) : 𝓞 (maximalRealSubfield K)) : K) =
        smoothedCyclotomicRatio ζ N (c ^ n) * (τ ^ n) (smoothedCyclotomicRatio ζ N c) := by
      have hmul :
          (((smoothedCyclotomicUnit hζ hodd hN hcn *
              realUnitsMapEquiv (τ ^ n).toRingEquiv (smoothedCyclotomicUnit hζ hodd hN hc) :
                (𝓞 (maximalRealSubfield K))ˣ) : 𝓞 (maximalRealSubfield K)) : K) =
          (((smoothedCyclotomicUnit hζ hodd hN hcn : 𝓞 (maximalRealSubfield K)) :
              maximalRealSubfield K) : K) *
            (((realUnitsMapEquiv (τ ^ n).toRingEquiv (smoothedCyclotomicUnit hζ hodd hN hc) :
              𝓞 (maximalRealSubfield K)) : maximalRealSubfield K) : K) := by
        rw [Units.val_mul]
        exact map_mul (algebraMap (𝓞 (maximalRealSubfield K)) K) _ _
      rw [hmul, coe_smoothedCyclotomicUnit, coe_realUnitsMapEquiv, coe_smoothedCyclotomicUnit]
      rfl
    have hmap : (τ ^ n) (smoothedCyclotomicRatio ζ N c) =
        smoothedCyclotomicRatio ((τ ^ n) ζ) N c :=
      smoothedCyclotomicRatio_map (τ ^ n).toRingHom ζ N c
    rw [coe_smoothedCyclotomicUnit, hlhs, hmap, hpow_gal n, mul_comm,
      ← smoothedCyclotomicRatio_mul hζ.pow_eq_one hodd hζcn, pow_succ']

/-- For an odd prime power `p ^ (k + 1)` and any generator `g` of `(ZMod (p ^ (k + 1)))ˣ`, the
product of the first `φ(p ^ (k + 1)) / 2` Galois conjugates of the smoothed unit attached to `g`
equals `-1`. -/
theorem prod_half_totient_realUnitsMapEquiv_smoothedCyclotomicUnit (p k : ℕ) [hp : Fact p.Prime]
    (hp2 : p ≠ 2) (K : Type*) [Field K] [NumberField K]
    [IsCyclotomicExtension {p ^ (k + 1)} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1)))
    {g : (ZMod (p ^ (k + 1)))ˣ} (hg : Subgroup.zpowers g = ⊤) :
    let N := p ^ (k + 1)
    let hodd : Odd N := (hp.out.odd_of_ne_two hp2).pow
    let hN2 : 2 ≤ N := by
      calc 2 ≤ p := hp.out.two_le
        _ = p ^ 1 := (pow_one p).symm
        _ ≤ p ^ (k + 1) := Nat.pow_le_pow_right hp.out.pos (by omega)
    let hc : ((g.val.val : ℤ)).gcd N = 1 := by
      rw [Int.gcd_natCast_natCast]
      exact ZMod.val_coe_unit_coprime g
    let τ : Gal(K/ℚ) :=
      have : NeZero N := ⟨(pow_pos hp.out.pos (k + 1)).ne'⟩
      (IsCyclotomicExtension.Rat.galEquivZMod N K).symm g
    ∏ i ∈ Finset.range (N.totient / 2),
      realUnitsMapEquiv (τ ^ i).toRingEquiv (smoothedCyclotomicUnit hζ hodd hN2 hc) = -1 := by
  intro N hodd hN2 hc τ
  have hNpos : 0 < N := pow_pos hp.out.pos (k + 1)
  have : NeZero N := ⟨hNpos.ne'⟩
  have hNgt2 : 2 < N := by
    have hp3 : 3 ≤ p := by
      have := hp.out.two_le
      omega
    calc 2 < 3 := by omega
      _ ≤ p := hp3
      _ = p ^ 1 := (pow_one p).symm
      _ ≤ p ^ (k + 1) := Nat.pow_le_pow_right hp.out.pos (by omega)
  have hτ : τ ζ = ζ ^ (g.val.val : ℤ) := by
    rw [zpow_natCast]
    have h1 := IsCyclotomicExtension.Rat.galEquivZMod_apply_of_pow_eq N K τ hζ.pow_eq_one
    simpa [τ] using h1
  rw [prod_realUnitsMapEquiv_smoothedCyclotomicUnit hodd hN2 hζ hc hτ]
  -- Since `g` generates `(ZMod N)ˣ` and `2 < N`, `g ^ (φ(N) / 2) = -1`.
  have hhalf : g ^ (N.totient / 2) = -1 := by
    have hord : orderOf g = N.totient := by
      rw [← Nat.card_zpowers, hg, Subgroup.card_top, Nat.card_eq_fintype_card,
        ZMod.card_units_eq_totient N]
    obtain ⟨m, hm⟩ := Nat.totient_even hNgt2
    have hdiv : N.totient / 2 = m := by omega
    rw [hdiv]
    have hmem : (-1 : (ZMod N)ˣ) ∈ Submonoid.powers g := by
      rw [mem_powers_iff_mem_zpowers, hg]
      trivial
    obtain ⟨r, hr⟩ := hmem
    dsimp only at hr
    have h2r : g ^ (2 * r) = 1 := by
      rw [mul_comm, pow_mul, hr]
      simp
    have hmr : m ∣ r := by
      have hdvd : 2 * m ∣ 2 * r := by
        rw [two_mul, ← hm, ← hord]
        exact orderOf_dvd_of_pow_eq_one h2r
      exact (Nat.mul_dvd_mul_iff_left (by omega : 0 < 2)).mp hdvd
    obtain ⟨q, rfl⟩ := hmr
    have hneg_ne : (-1 : (ZMod N)ˣ) ≠ 1 := fun h1 ↦ by
      have := ZMod.neg_one_eq_one_iff.mp (congrArg Units.val h1)
      omega
    rcases Nat.even_or_odd q with ⟨s, rfl⟩ | ⟨s, rfl⟩
    · exfalso
      apply hneg_ne
      have hmul_eq : m * (s + s) = (m + m) * s := by ring
      rw [← hr, hmul_eq, pow_mul, ← hm, ← hord, pow_orderOf_eq_one, one_pow]
    · have hmul_eq : m * (2 * s + 1) = (m + m) * s + m := by ring
      rw [← hr, hmul_eq, pow_add g, pow_mul, ← hm, ← hord, pow_orderOf_eq_one, one_pow, one_mul]
  have hmod : ((g.val.val : ℤ) ^ (N.totient / 2)) ≡ (-1 : ℤ) [ZMOD N] := by
    rw [← ZMod.intCast_eq_intCast_iff]
    have hcast : (((g.val.val : ℤ) ^ (N.totient / 2) : ℤ) : ZMod N) =
        ((g ^ (N.totient / 2) : (ZMod N)ˣ) : ZMod N) := by
      push_cast
      rw [ZMod.natCast_zmod_val]
    rw [hcast, hhalf]
    simp
  rw [smoothedCyclotomicUnit_eq_of_modeq hζ hodd hN2 _ (by simp : (-1 : ℤ).gcd N = 1) hmod,
    smoothedCyclotomicUnit_neg_one]

/-- **Cyclic Galois generation of real circular units for odd prime powers**: if `g` generates
`(ZMod (p ^ (k + 1)))ˣ`, then the Galois orbit of the single smoothed circular unit attached to `g`
generates `realCyclotomicUnits K ζ (p ^ (k + 1))`. -/
theorem realCyclotomicUnits_eq_closure_galois_orbit (p k : ℕ) [hp : Fact p.Prime]
    (hp2 : p ≠ 2) (K : Type*) [Field K] [NumberField K]
    [IsCyclotomicExtension {p ^ (k + 1)} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1)))
    {g : (ZMod (p ^ (k + 1)))ˣ} (hg : Subgroup.zpowers g = ⊤) :
    let N := p ^ (k + 1)
    let hodd : Odd N := (hp.out.odd_of_ne_two hp2).pow
    let hN2 : 2 ≤ N := by
      calc 2 ≤ p := hp.out.two_le
        _ = p ^ 1 := (pow_one p).symm
        _ ≤ p ^ (k + 1) := Nat.pow_le_pow_right hp.out.pos (by omega)
    let hc : ((g.val.val : ℤ)).gcd N = 1 := by
      rw [Int.gcd_natCast_natCast]
      exact ZMod.val_coe_unit_coprime g
    realCyclotomicUnits K ζ N =
      Subgroup.closure (Set.range fun σ : Gal(K/ℚ) ↦
        realUnitsMapEquiv σ.toRingEquiv (smoothedCyclotomicUnit hζ hodd hN2 hc)) := by
  intro N hodd hN2 hc
  have hNpos : 0 < N := pow_pos hp.out.pos (k + 1)
  have : NeZero N := ⟨hNpos.ne'⟩
  set u₀ := smoothedCyclotomicUnit hζ hodd hN2 hc
  set O : Subgroup (𝓞 (maximalRealSubfield K))ˣ :=
    Subgroup.closure (Set.range fun σ : Gal(K/ℚ) ↦ realUnitsMapEquiv σ.toRingEquiv u₀)
  let τ : Gal(K/ℚ) := (IsCyclotomicExtension.Rat.galEquivZMod N K).symm g
  have hτ : τ ζ = ζ ^ (g.val.val : ℤ) := by
    rw [zpow_natCast]
    have h1 := IsCyclotomicExtension.Rat.galEquivZMod_apply_of_pow_eq N K τ hζ.pow_eq_one
    simpa [τ] using h1
  refine le_antisymm ?_ ?_
  · rw [realCyclotomicUnits_eq_closure_smoothed p k hp2 K hζ, Subgroup.closure_le]
    rintro _ ⟨b, hb, rfl⟩
    have hbN : b.gcd N = 1 := by simpa [N] using hb
    set r : ℕ := (b % (N : ℤ)).toNat
    have hnn : 0 ≤ b % (N : ℤ) := Int.emod_nonneg b (by positivity)
    have hcast : (r : ℤ) = b % (N : ℤ) := Int.toNat_of_nonneg hnn
    have hrcop : r.Coprime N := by
      rw [Nat.Coprime]
      have : r.gcd N = (b % (N : ℤ)).gcd N := by
        rw [← hcast, Int.gcd_natCast_natCast]
      rw [this, Int.gcd_emod, hbN]
    let x : (ZMod N)ˣ := ZMod.unitOfCoprime r hrcop
    have hx_mem : x ∈ Submonoid.powers g := by
      rw [mem_powers_iff_mem_zpowers, hg]
      trivial
    obtain ⟨n, hn⟩ := hx_mem
    dsimp only at hn
    have hmod : ((g.val.val : ℤ) ^ n) ≡ b [ZMOD N] := by
      rw [← ZMod.intCast_eq_intCast_iff]
      have hlhs : (((g.val.val : ℤ) ^ n : ℤ) : ZMod N) = ((g ^ n : (ZMod N)ˣ) : ZMod N) := by
        push_cast
        rw [ZMod.natCast_zmod_val]
      have hrhs : (b : ZMod N) = (x : ZMod N) := by
        have hbmod : (b : ZMod N) = ((r : ℤ) : ZMod N) := by
          rw [ZMod.intCast_eq_intCast_iff, hcast, Int.ModEq, Int.emod_emod]
        rw [hbmod]
        simp [x]
      rw [hlhs, hn, hrhs]
    have hcn : ((g.val.val : ℤ) ^ n).gcd N = 1 := by
      rw [← Int.isCoprime_iff_gcd_eq_one] at hc ⊢
      exact hc.pow_left
    rw [← smoothedCyclotomicUnit_eq_of_modeq hζ hodd hN2 hcn hbN hmod,
      ← prod_realUnitsMapEquiv_smoothedCyclotomicUnit hodd hN2 hζ hc hτ n]
    exact Subgroup.prod_mem O fun i _ ↦ Subgroup.subset_closure ⟨τ ^ i, rfl⟩
  · rw [Subgroup.closure_le]
    rintro _ ⟨σ, rfl⟩
    have hu₀ : u₀ ∈ realCyclotomicUnits K ζ N :=
      smoothedCyclotomicUnit_mem_realCyclotomicUnits hζ hodd hN2 hc
    exact (SetLike.ext_iff.mp (realCyclotomicUnits_comap_ringAut hNpos hζ σ.toRingEquiv) u₀).mpr hu₀

/-- For an odd prime `p` and `k : ℕ`, there exists a single real circular unit whose
`Gal(K/ℚ)`-orbit generates `realCyclotomicUnits K ζ (p ^ (k + 1))`. -/
theorem exists_cyclic_generator_realCyclotomicUnits (p k : ℕ) [hp : Fact p.Prime] (hp2 : p ≠ 2)
    (K : Type*) [Field K] [NumberField K] [IsCyclotomicExtension {p ^ (k + 1)} ℚ K]
    {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) :
    ∃ u₀ ∈ realCyclotomicUnits K ζ (p ^ (k + 1)),
      realCyclotomicUnits K ζ (p ^ (k + 1)) =
        Subgroup.closure (Set.range fun σ : Gal(K/ℚ) ↦ realUnitsMapEquiv σ.toRingEquiv u₀) := by
  have : IsCyclic (ZMod (p ^ (k + 1)))ˣ := ZMod.isCyclic_units_of_prime_pow p hp.out hp2 (k + 1)
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := (ZMod (p ^ (k + 1)))ˣ)
  have htop : Subgroup.zpowers g = ⊤ := eq_top_iff.mpr fun x _ ↦ hg x
  have hodd : Odd (p ^ (k + 1)) := (hp.out.odd_of_ne_two hp2).pow
  have hN2 : 2 ≤ p ^ (k + 1) := by
    calc 2 ≤ p := hp.out.two_le
      _ = p ^ 1 := (pow_one p).symm
      _ ≤ p ^ (k + 1) := Nat.pow_le_pow_right hp.out.pos (by omega)
  have hc : ((g.val.val : ℤ)).gcd (p ^ (k + 1)) = 1 := by
    rw [← Nat.cast_pow, Int.gcd_natCast_natCast]
    exact ZMod.val_coe_unit_coprime g
  exact ⟨smoothedCyclotomicUnit hζ hodd hN2 hc,
    smoothedCyclotomicUnit_mem_realCyclotomicUnits hζ hodd hN2 hc,
    realCyclotomicUnits_eq_closure_galois_orbit p k hp2 K hζ htop⟩

end CyclicGaloisGeneration

/-! ### Full/real circular-unit quotient isomorphism and index equality -/

section QuotientComparison

/-- **Full/real circular-unit quotient isomorphism**: for every prime `p` and every `a : ℕ`, the
inclusion `(𝓞 K⁺)ˣ →* (𝓞 K)ˣ` induces a group isomorphism
`(𝓞 K⁺)ˣ ⧸ realCyclotomicUnits K ζ (p ^ a) ≃* (𝓞 K)ˣ ⧸ cyclotomicUnits K ζ (p ^ a)`. -/
noncomputable def fullRealCircularQuotientEquiv (p a : ℕ) [Fact p.Prime] (K : Type*) [Field K]
    [NumberField K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    (𝓞 (maximalRealSubfield K))ˣ ⧸ realCyclotomicUnits K ζ (p ^ a) ≃*
      (𝓞 K)ˣ ⧸ cyclotomicUnits K ζ (p ^ a) :=
  (QuotientGroup.congr (realCyclotomicUnits K ζ (p ^ a))
    ((cyclotomicUnits K ζ (p ^ a)).comap
      (Units.map (↑(algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K)))))
    (MulEquiv.refl _) (by simp [realCyclotomicUnits_eq_comap])).trans <|
  TauCeti.NumberField.quotientRealUnitsEquiv (H := cyclotomicUnits K ζ (p ^ a))
    (eq_top_iff.mpr <|
      (TauCeti.IsCyclotomicExtension.Rat.realUnits_sup_torsion_eq_top p a K).ge.trans
        (sup_le_sup_left (torsion_le_cyclotomicUnits p a K hζ) _))

@[simp]
theorem fullRealCircularQuotientEquiv_mk (p a : ℕ) [Fact p.Prime] (K : Type*) [Field K]
    [NumberField K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) (u : (𝓞 (maximalRealSubfield K))ˣ) :
    fullRealCircularQuotientEquiv p a K hζ (QuotientGroup.mk u) =
      QuotientGroup.mk
        (Units.map (↑(algebraMap (𝓞 (maximalRealSubfield K)) (𝓞 K))) u) := by
  rw [fullRealCircularQuotientEquiv, MulEquiv.trans_apply, QuotientGroup.congr_mk]
  exact TauCeti.NumberField.quotientRealUnitsEquiv_mk _ u

/-- **Equality of full and real circular-unit indices**: for every prime `p` and every `a : ℕ`,
`[(𝓞 K)ˣ : cyclotomicUnits K ζ (p ^ a)] = [(𝓞 K⁺)ˣ : realCyclotomicUnits K ζ (p ^ a)]`. -/
theorem index_cyclotomicUnits_eq_index_realCyclotomicUnits (p a : ℕ) [Fact p.Prime] (K : Type*)
    [Field K] [NumberField K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ (p ^ a)) :
    (cyclotomicUnits K ζ (p ^ a)).index = (realCyclotomicUnits K ζ (p ^ a)).index := by
  rw [realCyclotomicUnits_eq_comap]
  exact TauCeti.NumberField.index_eq_index_comap_realUnits (H := cyclotomicUnits K ζ (p ^ a))
    (eq_top_iff.mpr <|
      (TauCeti.IsCyclotomicExtension.Rat.realUnits_sup_torsion_eq_top p a K).ge.trans
        (sup_le_sup_left (torsion_le_cyclotomicUnits p a K hζ) _))

/-- **Circular-unit index formula in the rational boundary cases `p ^ a ≤ 2`** (covering `a = 0`
and `p ^ a = 2`): both circular-unit indices equal `NumberField.classNumber (maximalRealSubfield K)`
(and both equal `1`). -/
theorem index_cyclotomicUnits_eq_classNumber_of_pow_le_two (p a : ℕ) [hp : Fact p.Prime]
    (K : Type*) [Field K] [NumberField K] [IsCyclotomicExtension {p ^ a} ℚ K] {ζ : K}
    (hle : p ^ a ≤ 2) :
    (cyclotomicUnits K ζ (p ^ a)).index = NumberField.classNumber (maximalRealSubfield K) ∧
      (realCyclotomicUnits K ζ (p ^ a)).index =
        NumberField.classNumber (maximalRealSubfield K) := by
  have hfin : Module.finrank ℚ K = 1 := by
    have hpos : 0 < p ^ a := pow_pos hp.out.pos a
    have : NeZero (p ^ a) := ⟨hpos.ne'⟩
    rw [IsCyclotomicExtension.finrank K (Polynomial.cyclotomic.irreducible_rat hpos)]
    rcases (by omega : p ^ a = 1 ∨ p ^ a = 2) with h | h <;> simp [h]
  have hbijK : Function.Bijective (algebraMap ℚ K) :=
    Algebra.finrank_eq_one_iff_bijective_algebraMap.mp hfin
  have hbijReal : Function.Bijective (algebraMap ℚ (maximalRealSubfield K)) := by
    refine ⟨(algebraMap ℚ (maximalRealSubfield K)).injective, fun x ↦ ?_⟩
    obtain ⟨q, hq⟩ := hbijK.2 (x : K)
    exact ⟨q, Subtype.ext hq⟩
  let e : ℚ ≃+* maximalRealSubfield K :=
    RingEquiv.ofBijective (algebraMap ℚ (maximalRealSubfield K)) hbijReal
  let eO : ℤ ≃+* 𝓞 (maximalRealSubfield K) :=
    Rat.ringOfIntegersEquiv.symm.trans (RingOfIntegers.mapRingEquiv e)
  have hpir : IsPrincipalIdealRing (𝓞 (maximalRealSubfield K)) :=
    IsPrincipalIdealRing.of_surjective eO.toRingHom eO.surjective
  have hcl : NumberField.classNumber (maximalRealSubfield K) = 1 :=
    NumberField.classNumber_eq_one_iff.mpr hpir
  simp [hcl, cyclotomicUnits_eq_top_of_finrank_eq_one hfin,
    realCyclotomicUnits_eq_top_of_finrank_eq_one hfin]

end QuotientComparison

end TauCeti
