module

public import Mathlib.NumberTheory.NumberField.Cyclotomic.Basic

/-!
# Root discriminants from prime-power roots of unity

The exact root discriminant of a prime-power cyclotomic field gives a lower bound for
that of any number field containing a primitive root of that order. In particular, the
bound at dyadic orders depends only on the order, not on the other ramified primes.

We use `IsCyclotomicExtension.Rat.discr_prime_pow_succ` for the cyclotomic discriminant
and `NumberField.natAbs_discr_eq_absNorm_differentIdeal_mul_natAbs_discr_pow` in the
extension containing the root of unity. For the cyclotomic formula, see Washington,
*Introduction to Cyclotomic Fields*, 2nd ed., Chapter 2.
-/

public section

open NumberField

namespace IsCyclotomicExtension.Rat

/-- The root discriminant of a `p ^ (k + 1)`-th cyclotomic number field is
`p ^ (k + 1 - 1 / (p - 1))`. This includes the field of second roots of unity. -/
theorem rootDiscr_prime_pow_succ (p k : ℕ) (K : Type*) [Fact p.Prime] [Field K] [NumberField K]
    [IsCyclotomicExtension {p ^ (k + 1)} ℚ K] :
    rootDiscr K = (p : ℝ) ^ ((k : ℝ) + 1 - ((p : ℝ) - 1)⁻¹) := by
  have hp : p.Prime := Fact.out
  have hp' : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
  have ha : 1 ≤ (p - 1) * (k + 1) := Nat.mul_pos (Nat.sub_pos_of_lt hp.one_lt) (by omega)
  have hcast : ((p - 1 : ℕ) : ℝ) = (p : ℝ) - 1 := by simpa using Nat.cast_sub hp.one_lt.le
  have habs : (NumberField.discr K).natAbs = p ^ (p ^ k * ((p - 1) * (k + 1) - 1)) := by
    rw [discr_prime_pow_succ p k K]
    simp only [Int.natAbs_mul, Int.natAbs_pow, Int.natAbs_neg, Int.natAbs_one, one_pow, one_mul,
      Int.natAbs_natCast]
  have hdegree : Module.finrank ℚ K = p ^ k * (p - 1) := by
    rw [finrank (p ^ (k + 1)) K, Nat.totient_prime_pow hp (Nat.succ_pos k), Nat.succ_sub_one]
  rw [rootDiscr_def, ← Int.natCast_natAbs, Int.cast_natCast, habs, hdegree, Nat.cast_pow,
    ← Real.rpow_natCast_mul (by positivity : 0 ≤ (p : ℝ))]
  congr 1
  push_cast [Nat.cast_sub ha, hcast]
  field_simp [ne_of_gt (sub_pos.mpr hp'), ne_of_gt (pow_pos (by positivity : 0 < (p : ℝ)) k)]

end IsCyclotomicExtension.Rat

namespace IsPrimitiveRoot

/-- A number field containing a primitive `p ^ (k + 1)`-th root of unity has root
    discriminant at least that of the cyclotomic subfield generated by the root. -/
theorem rpow_le_rootDiscr {K : Type*} [Field K] [NumberField K] {p k : ℕ}
    {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) (hp : p.Prime) :
    (p : ℝ) ^ ((k : ℝ) + 1 - ((p : ℝ) - 1)⁻¹) ≤ rootDiscr K := by
  let F := IntermediateField.adjoin ℚ ({ζ} : Set K)
  let : Fact p.Prime := ⟨hp⟩
  have : IsCyclotomicExtension {p ^ (k + 1)} ℚ F :=
    hζ.intermediateField_adjoin_isCyclotomicExtension ℚ
  rw [← IsCyclotomicExtension.Rat.rootDiscr_prime_pow_succ p k F]
  have hdvd : (NumberField.discr F).natAbs ^ Module.finrank F K ∣
      (NumberField.discr K).natAbs := by
    rw [natAbs_discr_eq_absNorm_differentIdeal_mul_natAbs_discr_pow F (𝓞 F) K (𝓞 K)]
    exact dvd_mul_left _ _
  have hdiscr := Nat.le_of_dvd (Int.natAbs_pos.mpr (discr_ne_zero K)) hdvd
  have hd : (Module.finrank F K : ℝ) ≠ 0 := by exact_mod_cast Module.finrank_pos.ne'
  simp only [rootDiscr_def, ← Int.natCast_natAbs, Int.cast_natCast]
  calc
    _ = (((NumberField.discr F).natAbs : ℝ) ^ Module.finrank F K) ^
        (Module.finrank ℚ K : ℝ)⁻¹ := by
      rw [← Real.rpow_natCast_mul (by positivity), ← Module.finrank_mul_finrank ℚ F K]
      push_cast
      congr 1
      field_simp
    _ ≤ _ := Real.rpow_le_rpow (by positivity) (by exact_mod_cast hdiscr) (by positivity)

end IsPrimitiveRoot
