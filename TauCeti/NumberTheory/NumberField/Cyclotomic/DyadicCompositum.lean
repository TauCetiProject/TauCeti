module

public import TauCeti.NumberTheory.Cyclotomic.CompatibleTower
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
import Mathlib.Algebra.Order.Archimedean.Basic
import TauCeti.FieldTheory.IntermediateField.Adjoin.Finrank
import TauCeti.NumberTheory.NumberField.Cyclotomic.MaximalRealSubfield

/-!
# Degrees of composita with real dyadic cyclotomic layers

The maximal real subfield of the `2 ^ (n + 2)`-th cyclotomic field has degree `2 ^ n`
and is generated by `ζ + ζ⁻¹`. For a fixed finite extension `M/ℚ`, the compositum degree
with this layer is eventually `c * 2 ^ n`, where `1 ≤ c ≤ [M : ℚ]`. These degrees can therefore
be chosen in a prescribed interval `[X, 2X]` for all sufficiently large `X`.

For the maximal real cyclotomic subfield, see L. C. Washington, *Introduction to
Cyclotomic Fields*, 2nd ed., Chapter 2.
-/

public section

open IntermediateField

namespace TauCeti.CompatibleCyclotomicTower

variable {L : Type*} [Field L] [CharZero L] (T : CompatibleCyclotomicTower L)

/-- For a fixed finite extension `M` of `ℚ`, the degrees of its composita with the real
cyclotomic layers at levels `2 ^ (n + 2)` are eventually `c * 2 ^ n`. -/
theorem exists_finrank_sup_adjoin_add_inv_two_pow_eq (M : IntermediateField ℚ L)
    [FiniteDimensional ℚ M] :
    ∃ c : ℕ, 1 ≤ c ∧ c ≤ Module.finrank ℚ M ∧ ∃ n₀ : ℕ, ∀ n ≥ n₀,
      Module.finrank ℚ ↥(ℚ⟮T.root (2 ^ (n + 2)) + (T.root (2 ^ (n + 2)))⁻¹⟯ ⊔ M) =
        c * 2 ^ n := by
  let E (n : ℕ) := ℚ⟮T.root (2 ^ (n + 2)) + (T.root (2 ^ (n + 2)))⁻¹⟯
  have hdeg (n : ℕ) : Module.finrank ℚ (E n) = 2 ^ n := by
    have hm : 2 < 2 ^ (n + 2) := by
      rw [pow_add]
      have : 0 < 2 ^ n := by positivity
      omega
    rw [(T.isPrimitiveRoot_root _).finrank_adjoin_add_inv_rat hm,
      Nat.totient_prime_pow_succ Nat.prime_two]
    simp [pow_succ]
  obtain ⟨c, hc, hc', n₀, h⟩ :=
    exists_finrank_sup_eq_mul_finrank M E (T.monotone_adjoin_add_inv_two_pow ℚ)
  exact ⟨c, hc, hc', n₀, fun n hn ↦ by rw [h n hn, hdeg]⟩

/-- The compositum degree can be placed within a factor of two of any sufficiently large real
size, using a layer above any prescribed cutoff. The underlying layer degree `2 ^ n` also
lies below the upper endpoint. -/
theorem exists_finrank_sup_adjoin_add_inv_two_pow_mem_Icc (M : IntermediateField ℚ L)
    [FiniteDimensional ℚ M] (N : ℕ) :
    ∃ X₀ : ℝ, ∀ X ≥ X₀, ∃ n ≥ N,
      (Module.finrank ℚ ↥(ℚ⟮T.root (2 ^ (n + 2)) + (T.root (2 ^ (n + 2)))⁻¹⟯ ⊔ M) : ℝ) ∈
        Set.Icc X (2 * X) ∧ (2 : ℝ) ^ n ≤ 2 * X := by
  obtain ⟨c, hc, -, n₀, h⟩ := T.exists_finrank_sup_adjoin_add_inv_two_pow_eq M
  let k := max N n₀
  have hc₁ : (1 : ℝ) ≤ c := by exact_mod_cast hc
  refine ⟨(c : ℝ) * 2 ^ k, fun X hX ↦ ?_⟩
  have hy : (1 : ℝ) ≤ X / (c * 2 ^ k) := (le_div_iff₀ (by positivity)).mpr (by simpa using hX)
  obtain ⟨j, hj, hj'⟩ := exists_nat_pow_near hy (one_lt_two : (1 : ℝ) < 2)
  have hj₁ := (le_div_iff₀ (by positivity : (0 : ℝ) < (c : ℝ) * 2 ^ k)).mp hj
  have hj₂ := (div_lt_iff₀ (by positivity : (0 : ℝ) < (c : ℝ) * 2 ^ k)).mp hj'
  refine ⟨k + j + 1, by dsimp [k]; omega, ?_⟩
  rw [h _ (by dsimp [k]; omega), Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat, Set.mem_Icc]
  have hsize : (c : ℝ) * 2 ^ (k + j + 1) ∈ Set.Icc X (2 * X) := by
    simp only [Set.mem_Icc, pow_succ, pow_add] at hj₂ ⊢
    constructor <;> nlinarith only [hj₁, hj₂]
  refine ⟨hsize, le_trans ?_ hsize.2⟩
  simpa only [one_mul] using
    mul_le_mul_of_nonneg_right hc₁ (by positivity : (0 : ℝ) ≤ 2 ^ (k + j + 1))

end TauCeti.CompatibleCyclotomicTower
