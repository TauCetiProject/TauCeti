module

public import Mathlib.NumberTheory.NumberField.Discriminant.Basic
public import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots
import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots
import Mathlib.RingTheory.Norm.Transitivity
import TauCeti.NumberTheory.Cyclotomic.Irreducible
import TauCeti.NumberTheory.NumberField.Cyclotomic.Finrank

/-!
# Relative norms of cyclotomic torsion

If `n ≠ 2` is positive and coprime to the discriminant of a number field `K`, every
`n`-th root of unity in an extension containing a primitive `n`-th root has field norm
one over `K`. In particular the relative norm is trivial on the cyclic group of roots
of unity generated by the cyclotomic generator. In a cyclotomic CM compositum, this
removes the infinity-type factor on these roots when the weights are congruent modulo `n`
across the embeddings extending one embedding of the quadratic base.

The generator norm is the computation `New.Parameters.norm_zeta_eq_one` in
`New/Reduction/Data/FieldsAndPlaces.lean` of [lsernau/grh-lean](https://github.com/lsernau/grh-lean)
at `72fead1`. Here the arithmetic condition gives the cyclotomic degree by
`IsCyclotomicExtension.finrank_eq_totient`, after which the generator computation uses
Mathlib's `IsPrimitiveRoot.norm_eq_one` in the field generated by the root.
-/

public section

open IntermediateField

namespace IsPrimitiveRoot

/-- When the cyclotomic order `n` is coprime to the absolute discriminant of `K` and is
not `2`, the relative field norm of any `n`-th root of unity is one in an extension
containing a primitive `n`-th root. The ambient field need not be generated by that root. -/
theorem norm_eq_one_of_pow_eq_one_of_coprime_discr
    {K E : Type*} [Field K] [NumberField K] [Field E] [Algebra K E]
    {n : ℕ} [NeZero n] {ζ z : E} (hζ : IsPrimitiveRoot ζ n) (hn : n ≠ 2)
    (hcop : (NumberField.discr K).natAbs.Coprime n) (hz : z ^ n = 1) :
    Algebra.norm K z = 1 := by
  obtain ⟨j, -, rfl⟩ := hζ.eq_pow_of_pow_eq_one hz
  let F := K⟮ζ⟯
  let ζF : F := AdjoinSimple.gen K ζ
  have hζF : IsPrimitiveRoot ζF n := hζ.of_map_of_injective (f := F.val) F.val.injective
  have : IsCyclotomicExtension {n} K F := hζ.intermediateField_adjoin_isCyclotomicExtension K
  have hdeg := IsCyclotomicExtension.finrank_eq_totient K F n hcop
  have hirr := IsCyclotomicExtension.irreducible_cyclotomic_of_totient_le_finrank K F hdeg.ge
  rw [map_pow, Algebra.norm_eq_norm_adjoin K ζ, hζF.norm_eq_one hn hirr, one_pow, one_pow]

end IsPrimitiveRoot
