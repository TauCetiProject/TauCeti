module

public import Mathlib.NumberTheory.NumberField.Cyclotomic.Basic
import TauCeti.NumberTheory.Cyclotomic.Irreducible
import TauCeti.NumberTheory.NumberField.Cyclotomic.Finrank
import TauCeti.RingTheory.DedekindDomain.Different.Monogenic

/-!
# Rings of integers and differents after cyclotomic base change

If the cyclotomic level is coprime to the discriminant of a number field, adjoining a
primitive root of unity to the ring of integers gives the full ring of integers of the
cyclotomic extension. The relative different is generated by the derivative of the
cyclotomic polynomial evaluated at that root.

The integral base change uses Mathlib's
`IsDedekindDomain.adjoin_union_eq_top_of_isCoprime_differentialIdeal`.
The formulas are instances of the coprime-discriminant and monogenic different computations
in Neukirch, *Algebraic Number Theory*, Chapter I §10 and Chapter III §2.
See also `New.Parameters.relDifferent_spec` in
`grh/src/New/Derivatives/Field/PrimeDecomposition.lean` of lsernau/grh-lean at commit
`72fead102f663d5c7a407964a13dc0cf9d977207`.
-/

public section

open NumberField Polynomial
open scoped NumberField

namespace IsPrimitiveRoot

variable {K E : Type*} [Field K] [NumberField K] [Field E] [Algebra K E]
  {n : ℕ} [NeZero n] [IsCyclotomicExtension {n} K E] {ζ : E}

/-- If the cyclotomic level is coprime to the base discriminant, a primitive root of unity
integrally generates the cyclotomic extension over the base ring of integers. -/
theorem adjoin_toInteger_eq_top_of_coprime_discr (hζ : IsPrimitiveRoot ζ n)
    (hcop : (discr K).natAbs.Coprime n) :
    Algebra.adjoin (𝓞 K) {hζ.toInteger} = ⊤ := by
  have : FiniteDimensional K E := IsCyclotomicExtension.finiteDimensional {n} K E
  have : NumberField E := NumberField.of_module_finite K E
  let C : IntermediateField ℚ E := IntermediateField.adjoin ℚ {ζ}
  let F : IntermediateField ℚ E := (IsScalarTower.toAlgHom ℚ K E).fieldRange
  let e : K ≃+* F := ((IsScalarTower.toAlgHom ℚ K E : K →+* E)).rangeRestrictFieldEquiv
  have : IsCyclotomicExtension {n} ℚ C := hζ.intermediateField_adjoin_isCyclotomicExtension ℚ
  have : IsGalois ℚ C := IsCyclotomicExtension.isGalois {n} ℚ C
  have hdiscr := hζ.isCoprime_discr_adjoin_fieldRange K hcop
  have htop : C ⊔ F = ⊤ :=
    TauCeti.IntermediateField.adjoin_sup_fieldRange_eq_top ℚ K E
      (IntermediateField.adjoin_eq_top_of_algebra _ _
        (IsCyclotomicExtension.adjoin_primitive_root_eq_top hζ))
  have hCS : C.toSubalgebra ⊔ F.toSubalgebra = ⊤ := by
    simpa [C, F, IntermediateField.sup_toSubalgebra_of_isAlgebraic_right] using
      congr(IntermediateField.toSubalgebra $htop)
  have hzC : IsPrimitiveRoot (IntermediateField.AdjoinSimple.gen ℚ ζ) n :=
    hζ.of_map_of_injective (f := C.val.toMonoidHom) C.val.injective
  have hgen := IsDedekindDomain.adjoin_union_eq_top_of_isCoprime_differentialIdeal
    ℤ (𝓞 E) (𝓞 C) (𝓞 F) (linearDisjoint_of_isGalois_isCoprime_discr E C F hdiscr) hCS
    (isCoprime_differentIdeal_of_isCoprime_discr E hdiscr)
    (IsCyclotomicExtension.Rat.adjoin_singleton_eq_top hzC) (Algebra.adjoin_univ ℤ (𝓞 F))
  -- The rational cyclotomic ring supplies the root; the other factor supplies the base integers.
  let A := Algebra.adjoin (𝓞 K) {hζ.toInteger}
  suffices hle : (⊤ : Subalgebra ℤ (𝓞 E)) ≤ A.restrictScalars ℤ from
    Algebra.eq_top_iff.mpr fun _ ↦ hle Algebra.mem_top
  have hmap : algebraMap (𝓞 C) (𝓞 E) hzC.toInteger = hζ.toInteger := by
    -- The integer algebra map is `RingOfIntegers.mapRingHom` viewed as an algebra.
    apply RingOfIntegers.ext
    simp only [RingHom.algebraMap_toAlgebra, RingOfIntegers.mapRingHom_apply,
      IntermediateField.algebraMap_apply, coe_toInteger, IntermediateField.AdjoinSimple.coe_gen]
  rw [← hgen, Set.image_singleton, hmap]
  apply Algebra.adjoin_le
  rintro _ (hx | ⟨x, _, rfl⟩)
  · exact Algebra.subset_adjoin hx
  obtain ⟨y, rfl⟩ := (RingOfIntegers.mapRingEquiv e).surjective x
  have hy : algebraMap (𝓞 F) (𝓞 E) (RingOfIntegers.mapRingEquiv e y) =
      algebraMap (𝓞 K) (𝓞 E) y := by
    apply RingOfIntegers.ext
    simp only [RingHom.algebraMap_toAlgebra, RingOfIntegers.mapRingHom_apply,
      RingOfIntegers.mapRingEquiv_apply, IntermediateField.algebraMap_apply]
    -- The equivalence `e` is the base embedding with codomain restricted to its range.
    exact RingHom.rangeRestrictFieldEquiv_apply_coe (IsScalarTower.toAlgHom ℚ K E : K →+* E) _
  exact hy.symm ▸ A.algebraMap_mem y

/-- The relative different of a cyclotomic extension of level coprime to the base discriminant
is generated by the derivative of the cyclotomic polynomial at any primitive root. -/
theorem differentIdeal_eq_span_derivative_cyclotomic_of_coprime_discr [NumberField E]
    (hζ : IsPrimitiveRoot ζ n) (hcop : (discr K).natAbs.Coprime n) :
    differentIdeal (𝓞 K) (𝓞 E) = Ideal.span {aeval hζ.toInteger (cyclotomic n ℤ).derivative} := by
  have hdeg := IsCyclotomicExtension.finrank_eq_totient K E n hcop
  have hirr := IsCyclotomicExtension.irreducible_cyclotomic_of_totient_le_finrank K E hdeg.ge
  have hmin : minpoly (𝓞 K) hζ.toInteger = cyclotomic n (𝓞 K) := by
    apply map_injective (algebraMap (𝓞 K) K) RingOfIntegers.coe_injective
    rw [← minpoly.isIntegrallyClosed_eq_field_fractions K E
      (Algebra.IsIntegral.isIntegral (R := 𝓞 K) hζ.toInteger), map_cyclotomic]
    exact (hζ.minpoly_eq_cyclotomic_of_irreducible hirr).symm
  rw [TauCeti.differentIdeal_eq_span_aeval_derivative_minpoly (𝓞 K) K E (𝓞 E) _
    (hζ.adjoin_toInteger_eq_top_of_coprime_discr hcop), hmin,
    ← map_cyclotomic n (algebraMap ℤ (𝓞 K)), derivative_map, aeval_map_algebraMap]

end IsPrimitiveRoot
