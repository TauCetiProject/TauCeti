module

public import TauCeti.NumberTheory.NumberField.Global.HeckeCharacter.FiniteOrder

/-!
# The conductor of a finite-order Hecke character

A finite-order Hecke character `χ` of a number field `K` is the pullback of a ray class character
of some modulus (`HeckeCharacter.isFiniteOrder_iff_exists_rayClassCharacter`), and the moduli
that occur are closed under taking multiples.  They are also closed under greatest common
divisors: `χ` comes from `𝔪` exactly when it is trivial on `raySubgroup 𝔪`, and the ray subgroup
of `𝔪.gcd 𝔫` is generated by those of `𝔪` and `𝔫` (`raySubgroup_gcd`).  Hence there is a least
such modulus, the **conductor** of `χ`: `χ` comes from a ray class character of `𝔪` exactly when
the conductor divides `𝔪`.

Since the characters coming from a fixed modulus form a subgroup, the conductor is unchanged by
inversion, the conductor of a power divides the conductor, and the conductor of a product divides
the least common multiple of the conductors.

The conductor of a ray class character, and the primitive character inducing it, are built from
this one in `TauCeti.NumberTheory.NumberField.Global.RayClass.Character.Conductor`.

## Main definitions

* `TauCeti.GlobalNumberFields.HeckeCharacter.conductor`: the least modulus from which a
  finite-order Hecke character comes.

## Main results

* `TauCeti.GlobalNumberFields.HeckeCharacter.conductor_dvd_iff`: a finite-order Hecke character
  comes from a ray class character of `𝔪` exactly when its conductor divides `𝔪`.
* `TauCeti.GlobalNumberFields.HeckeCharacter.conductor_inv`,
  `TauCeti.GlobalNumberFields.HeckeCharacter.conductor_zpow_dvd`, and
  `TauCeti.GlobalNumberFields.HeckeCharacter.conductor_mul_dvd_lcm`: the conductor and the group
  operations.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter VI, §1 and Chapter VII, §6.
* The API follows Mathlib's conductor of Dirichlet characters,
  `Mathlib.NumberTheory.DirichletCharacter.Basic` (`DirichletCharacter.conductor`,
  `DirichletCharacter.primitiveCharacter`).
-/

public section
noncomputable section

open IsDedekindDomain NumberField
open scoped NumberField

namespace TauCeti.GlobalNumberFields

variable {K : Type*} [Field K] [NumberField K]

namespace HeckeCharacter

variable {𝔪 𝔫 : Modulus K}

/-- The moduli from which a finite-order Hecke character comes form a nonempty set. -/
private theorem nonempty_setOf_mem_range {χ : HeckeCharacter K} (hχ : χ.IsFiniteOrder) :
    {𝔪 : Modulus K | χ ∈ (ofRayClassCharacter 𝔪).range}.Nonempty := by
  obtain ⟨𝔪, η, hη⟩ := (isFiniteOrder_iff_exists_rayClassCharacter χ).mp hχ
  exact ⟨𝔪, η, hη⟩

/-- **The conductor of a finite-order Hecke character**: the least modulus `𝔣` such that the
character is the pullback of a ray class character of `𝔣`.  It is least for divisibility: the
character comes from a ray class character of `𝔪` exactly when its conductor divides `𝔪`
(`HeckeCharacter.conductor_dvd_iff`). -/
def conductor (χ : HeckeCharacter K) (hχ : χ.IsFiniteOrder) : Modulus K :=
  Modulus.wellFounded_dvd_and_ne.min {𝔪 : Modulus K | χ ∈ (ofRayClassCharacter 𝔪).range}
    (nonempty_setOf_mem_range hχ)

/-- **A finite-order Hecke character comes from a ray class character of its conductor.** -/
theorem mem_range_ofRayClassCharacter_conductor {χ : HeckeCharacter K} (hχ : χ.IsFiniteOrder) :
    χ ∈ (ofRayClassCharacter (χ.conductor hχ)).range :=
  WellFounded.min_mem _ _ (nonempty_setOf_mem_range hχ)

/-- **The conductor is the least modulus from which a finite-order Hecke character comes**: the
character is the pullback of a ray class character of `𝔪` exactly when its conductor divides
`𝔪`. -/
theorem conductor_dvd_iff {χ : HeckeCharacter K} (hχ : χ.IsFiniteOrder) :
    χ.conductor hχ ∣ 𝔪 ↔ χ ∈ (ofRayClassCharacter 𝔪).range := by
  refine ⟨fun h ↦ range_ofRayClassCharacter_le h (mem_range_ofRayClassCharacter_conductor hχ),
    fun h ↦ ?_⟩
  -- The greatest common divisor of the conductor and `𝔪` is again a modulus from which `χ` comes,
  -- and it divides the conductor, so by minimality it is the conductor.
  have hgcd := mem_range_ofRayClassCharacter_gcd (mem_range_ofRayClassCharacter_conductor hχ) h
  have hmin := Modulus.wellFounded_dvd_and_ne.not_lt_min
    {𝔫 : Modulus K | χ ∈ (ofRayClassCharacter 𝔫).range} hgcd
  have heq : (χ.conductor hχ).gcd 𝔪 = χ.conductor hχ :=
    not_not.mp fun hne ↦ hmin ⟨Modulus.gcd_dvd_left _ _, hne⟩
  exact heq ▸ Modulus.gcd_dvd_right _ _

/-- The conductor of a finite-order Hecke character is characterized by the moduli from which the
character comes. -/
theorem conductor_eq_iff {χ : HeckeCharacter K} (hχ : χ.IsFiniteOrder) :
    χ.conductor hχ = 𝔪 ↔
      χ ∈ (ofRayClassCharacter 𝔪).range ∧
        ∀ 𝔫 : Modulus K, χ ∈ (ofRayClassCharacter 𝔫).range → 𝔪 ∣ 𝔫 := by
  refine ⟨?_, fun ⟨h𝔪, hmin⟩ ↦ Modulus.dvd_antisymm ((conductor_dvd_iff hχ).mpr h𝔪)
    (hmin _ (mem_range_ofRayClassCharacter_conductor hχ))⟩
  rintro rfl
  exact ⟨mem_range_ofRayClassCharacter_conductor hχ, fun 𝔫 ↦ (conductor_dvd_iff hχ).mpr⟩

/-- The trivial Hecke character has the trivial conductor. -/
@[simp]
theorem conductor_one (h : (1 : HeckeCharacter K).IsFiniteOrder) :
    (1 : HeckeCharacter K).conductor h = Modulus.one K :=
  Modulus.eq_one_of_dvd_one ((conductor_dvd_iff h).mpr (one_mem _))

/-- **Inverting a finite-order Hecke character does not change its conductor.** -/
@[simp]
theorem conductor_inv {χ : HeckeCharacter K} (hχ : χ⁻¹.IsFiniteOrder) :
    χ⁻¹.conductor hχ = χ.conductor (isOfFinOrder_inv_iff.mp hχ) := by
  rw [conductor_eq_iff]
  refine ⟨inv_mem (mem_range_ofRayClassCharacter_conductor _), fun 𝔫 h𝔫 ↦ ?_⟩
  exact (conductor_dvd_iff _).mpr (inv_inv χ ▸ inv_mem h𝔫)

/-- The conductor of a power of a finite-order Hecke character divides its conductor. -/
theorem conductor_pow_dvd {χ : HeckeCharacter K} (hχ : χ.IsFiniteOrder) (n : ℕ) :
    (χ ^ n).conductor hχ.pow ∣ χ.conductor hχ :=
  (conductor_dvd_iff _).mpr (pow_mem (mem_range_ofRayClassCharacter_conductor hχ) n)

/-- The conductor of an integer power of a finite-order Hecke character divides its conductor. -/
theorem conductor_zpow_dvd {χ : HeckeCharacter K} (hχ : χ.IsFiniteOrder) (n : ℤ) :
    (χ ^ n).conductor hχ.zpow ∣ χ.conductor hχ :=
  (conductor_dvd_iff _).mpr (zpow_mem (mem_range_ofRayClassCharacter_conductor hχ) n)

/-- The conductor of a product of finite-order Hecke characters divides the least common multiple
of their conductors. -/
theorem conductor_mul_dvd_lcm {χ ψ : HeckeCharacter K} (hχ : χ.IsFiniteOrder)
    (hψ : ψ.IsFiniteOrder) :
    (χ * ψ).conductor (hχ.mul hψ) ∣ (χ.conductor hχ).lcm (ψ.conductor hψ) :=
  (conductor_dvd_iff _).mpr (mul_mem
    (range_ofRayClassCharacter_le (Modulus.dvd_lcm_left _ _)
      (mem_range_ofRayClassCharacter_conductor hχ))
    (range_ofRayClassCharacter_le (Modulus.dvd_lcm_right _ _)
      (mem_range_ofRayClassCharacter_conductor hψ)))

end HeckeCharacter

end TauCeti.GlobalNumberFields
