module

public import Mathlib.NumberTheory.NumberField.Cyclotomic.Galois
public import TauCeti.NumberTheory.NumberField.Global.RayClass.Rat
public import TauCeti.NumberTheory.NumberField.Ideal.ArtinMap

import TauCeti.NumberTheory.NumberField.Cyclotomic.Frobenius

/-!
# The ray class group of `ℚ` modulo `(n)·∞` and the Galois group of `ℚ(ζ_n)`

Let `F` be the `n`-th cyclotomic field over `ℚ`. Both `RayClassGroup (ratModulus n _)` and
`Gal(F/ℚ)` are identified with `(ZMod n)ˣ`: the first by `ratModulusEquivZMod`, which sends the
class of an ideal prime to `n` to its absolute norm modulo `n`, and the second by Mathlib's
`IsCyclotomicExtension.Rat.galEquivZMod`, which records the exponent by which an automorphism
acts on the `n`-th roots of unity. Composing them gives

`ratModulusEquivGal n F : RayClassGroup (ratModulus n _) ≃* Gal(F/ℚ)`.

This file shows that the identification is the arithmetic one. An arithmetic Frobenius at a prime
of `𝓞 F` above `p ∤ n` acts on `ζ_n` by `ζ_n ↦ ζ_n ^ p`, and the ray class of `(p)` is `p mod n`,
so `ratModulusEquivGal` sends the class of `(p)` to the Frobenius at `p`. Since the ideals prime
to `n` are generated by such primes, the ideal-theoretic Artin map of `F/ℚ` away from `n` factors
through the ray class group of `(n)·∞`, and the induced map is `ratModulusEquivGal`. The
identification is also compatible with lowering the level: for `d ∣ n`, the transition map
`classMap` corresponds to restricting automorphisms to the `d`-th cyclotomic field.

The orientation is the arithmetic one: the class of `(p)` goes to the automorphism raising roots of
unity to the `p`-th power, not to its inverse.

## Main definitions

* `TauCeti.GlobalNumberFields.ratModulusEquivGal`: the identification of the ray class group of
  `ℚ` modulo `(n)·∞` with `Gal(ℚ(ζ_n)/ℚ)`.

## Main results

* `TauCeti.GlobalNumberFields.isArithFrobAt_iff_eq_ratModulusEquivGal_idealClass`: an
  automorphism of `ℚ(ζ_n)` is an arithmetic Frobenius at a prime above `p ∤ n` exactly when it
  is the image of the ray class of `(p)`.
* `TauCeti.GlobalNumberFields.ratModulusEquivGal_comp_rayClassMk`: the Artin map of `ℚ(ζ_n)/ℚ`
  on the fractional ideals prime to `n` is the ray class map followed by `ratModulusEquivGal`.
* `TauCeti.GlobalNumberFields.restrictNormal_ratModulusEquivGal`: for `d ∣ n`, restriction to
  `ℚ(ζ_d)` corresponds to the transition map from `(n)·∞` to `(d)·∞`.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter I, §10 and Chapter VI, §1.
-/

public section

open IsDedekindDomain NumberField IsCyclotomicExtension.Rat
open scoped NumberField

namespace TauCeti.GlobalNumberFields

open NumberFieldArithmetic

variable (n : ℕ) [NeZero n] (F : Type*) [Field F] [NumberField F] [IsCyclotomicExtension {n} ℚ F]

/-- **The ray class group of `ℚ` modulo `(n)·∞` is the Galois group of `ℚ(ζ_n)`.** The
composite of `ratModulusEquivZMod` with the inverse of Mathlib's `galEquivZMod`: a ray class with
residue `a ∈ (ZMod n)ˣ` goes to the automorphism acting on the `n`-th roots of unity by
`ζ ↦ ζ ^ a`. It sends the ray class of a prime `p ∤ n` to the arithmetic Frobenius at `p`
(`isArithFrobAt_iff_eq_ratModulusEquivGal_idealClass`). -/
noncomputable def ratModulusEquivGal : RayClassGroup (ratModulus n (NeZero.ne n)) ≃* Gal(F/ℚ) :=
  (ratModulusEquivZMod n (NeZero.ne n)).trans (galEquivZMod n F).symm

/-- The image of a ray class is the automorphism whose `galEquivZMod` exponent is the residue of
the class. -/
theorem ratModulusEquivGal_apply (c : RayClassGroup (ratModulus n (NeZero.ne n))) :
    ratModulusEquivGal n F c = (galEquivZMod n F).symm (ratModulusEquivZMod n (NeZero.ne n) c) :=
  (rfl)

/-- `galEquivZMod` undoes `ratModulusEquivGal` down to `ratModulusEquivZMod`. This is not a
`simp` lemma: `galEquivZMod` is a reducible abbreviation, which `simp` unfolds first. -/
theorem galEquivZMod_ratModulusEquivGal (c : RayClassGroup (ratModulus n (NeZero.ne n))) :
    galEquivZMod n F (ratModulusEquivGal n F c) = ratModulusEquivZMod n (NeZero.ne n) c :=
  MulEquiv.apply_symm_apply _ _

/-- The inverse of `ratModulusEquivGal` reads an automorphism through `galEquivZMod`. -/
@[simp]
theorem ratModulusEquivGal_symm_apply (σ : Gal(F/ℚ)) :
    (ratModulusEquivGal n F).symm σ = (ratModulusEquivZMod n (NeZero.ne n)).symm
      (galEquivZMod n F σ) :=
  (rfl)

/-! ### Frobenius elements -/

/-- **The ray class of a prime is its Frobenius.** For a height-one prime `v = (p)` of `𝓞 ℚ` with
`p ∤ n` and a prime `Q` of `𝓞 F` above it, an automorphism of `F = ℚ(ζ_n)` is an arithmetic
Frobenius at `Q` exactly when it is the image under `ratModulusEquivGal` of the ray class of
`(p)`. -/
theorem isArithFrobAt_iff_eq_ratModulusEquivGal_idealClass (v : HeightOneSpectrum (𝓞 ℚ))
    (hv : v.asIdeal ∈ integralIdealsPrimeTo (ratModulus n (NeZero.ne n)))
    (Q : Ideal (𝓞 F)) [Q.IsPrime] [Q.LiesOver v.asIdeal] (σ : Gal(F/ℚ)) :
    IsArithFrobAt (𝓞 ℚ) σ Q ↔
      σ = ratModulusEquivGal n F (idealClass _ ⟨v.asIdeal, hv⟩) := by
  rw [TauCeti.NumberField.isArithFrobAt_iff_galEquivZMod_eq_absNorm v
      (asIdeal_mem_integralIdealsPrimeTo_ratModulus_iff.mp hv) Q σ,
    ← (galEquivZMod n F).injective.eq_iff, galEquivZMod_ratModulusEquivGal, Units.ext_iff,
    coe_ratModulusEquivZMod_idealClass]

/-- The image under `ratModulusEquivGal` of the ray class of a prime `p ∤ n` is an arithmetic
Frobenius at every prime of `𝓞 F` above `p`. -/
theorem isArithFrobAt_ratModulusEquivGal_idealClass (v : HeightOneSpectrum (𝓞 ℚ))
    (hv : v.asIdeal ∈ integralIdealsPrimeTo (ratModulus n (NeZero.ne n)))
    (Q : Ideal (𝓞 F)) [Q.IsPrime] [Q.LiesOver v.asIdeal] :
    IsArithFrobAt (𝓞 ℚ) (ratModulusEquivGal n F (idealClass _ ⟨v.asIdeal, hv⟩)) Q :=
  (isArithFrobAt_iff_eq_ratModulusEquivGal_idealClass n F v hv Q _).mpr rfl

/-! ### Lowering the level -/

/-- **Restriction to `ℚ(ζ_d)` is the transition map from `(n)·∞` to `(d)·∞`.** For `d ∣ n` and
`F'` the `d`-th cyclotomic field inside `F`, restricting the image of a ray class to `F'` gives
the image of its class modulo `(d)·∞`. -/
theorem restrictNormal_ratModulusEquivGal {d : ℕ} [NeZero d] (F' : Type*) [Field F']
    [NumberField F'] [IsCyclotomicExtension {d} ℚ F'] [Algebra F' F] [IsGalois ℚ F']
    (h : ratModulus d (NeZero.ne d) ∣ ratModulus n (NeZero.ne n))
    (c : RayClassGroup (ratModulus n (NeZero.ne n))) :
    (ratModulusEquivGal n F c).restrictNormal F' = ratModulusEquivGal d F' (classMap h c) := by
  refine (galEquivZMod d F').injective ?_
  rw [galEquivZMod_restrictNormal_apply n F F' (ratModulus_dvd_ratModulus_iff.mp h),
    galEquivZMod_ratModulusEquivGal, galEquivZMod_ratModulusEquivGal,
    ratModulusEquivZMod_classMap]

/-! ### The Artin map -/

variable [IsGalois ℚ F] (hab : ∀ σ τ : Gal(F/ℚ), Commute σ τ)
  (hur : ∀ v : HeightOneSpectrum (𝓞 ℚ), v ∉ (ratModulus n (NeZero.ne n)).support →
    ∀ (Q : Ideal (𝓞 F)) [Q.IsPrime] [Q.LiesOver v.asIdeal], Algebra.IsUnramifiedAt (𝓞 ℚ) Q)

/-- **The Artin map of `ℚ(ζ_n)/ℚ` factors through the ray class group of `(n)·∞`, and the
induced map is `ratModulusEquivGal`.** On the fractional ideals of `ℚ` prime to `n`, the
ideal-theoretic Artin map `artinHomAway` is the ray class map `rayClassMk` followed by
`ratModulusEquivGal`. Thus the Artin map is trivial on the ray of `(n)·∞` and induces an
isomorphism of the ray class group with `Gal(F/ℚ)`. -/
theorem ratModulusEquivGal_comp_rayClassMk :
    (ratModulusEquivGal n F : RayClassGroup (ratModulus n (NeZero.ne n)) →* Gal(F/ℚ)).comp
        (rayClassMk (ratModulus n (NeZero.ne n))) =
      artinHomAway hab (ratModulus n (NeZero.ne n)).support hur := by
  -- Both sides take the Frobenius value at every prime not dividing `n`.
  refine artinHomAway_eq_of_apply_prime hab _ hur _ fun I v hv hI Q _ _ σ hσ ↦ ?_
  have hmem : v.asIdeal ∈ integralIdealsPrimeTo (ratModulus n (NeZero.ne n)) :=
    asIdeal_mem_integralIdealsPrimeTo_ratModulus_iff.mpr (mem_ratModulus_support_iff.not.mp hv)
  have hIv : I = integralIdealsAwayHom _ ⟨v.asIdeal, hmem⟩ :=
    Subtype.ext (Units.ext (by rw [coe_integralIdealsAwayHom]; exact hI))
  rw [MonoidHom.comp_apply, hIv, ← idealClass_apply, MonoidHom.coe_ofClass,
    ← (isArithFrobAt_iff_eq_ratModulusEquivGal_idealClass n F v hmem Q σ).mp hσ]

/-- **The Artin automorphism of an integral ideal prime to `n` is the image of its ray class.**
This is `ratModulusEquivGal_comp_rayClassMk` read on the integral ideals prime to `n`. -/
theorem ratModulusEquivGal_idealClass (I : integralIdealsPrimeTo (ratModulus n (NeZero.ne n))) :
    ratModulusEquivGal n F (idealClass _ I) =
      artinHomAwayIntegral hab (ratModulus n (NeZero.ne n)).support hur I := by
  rw [artinHomAwayIntegral_apply, ← ratModulusEquivGal_comp_rayClassMk n F hab hur,
    MonoidHom.comp_apply, idealClass_apply, MonoidHom.coe_ofClass]

end TauCeti.GlobalNumberFields
