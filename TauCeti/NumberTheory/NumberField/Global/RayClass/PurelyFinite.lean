module

public import TauCeti.GroupTheory.QuotientGroup.KerEquiv
public import TauCeti.NumberTheory.NumberField.Global.RayClass.ClassNumber
public import TauCeti.NumberTheory.NumberField.RingOfIntegers.Norm

/-!
# Moduli without archimedean conditions and their residue-unit quotients

When the infinite part of a modulus `𝔪` of a number field `K` is empty — as is automatic for every
modulus of a totally complex number field (`Modulus.infinitePart_eq_empty`) — no archimedean sign
conditions appear in `IsCongrOne 𝔪`. The ray class exact sequence of
`TauCeti.NumberTheory.NumberField.Global.RayClass.Exact` then simplifies to

```text
1 → unitsCongruenceSubgroup 𝔪 → (𝓞 K)ˣ → (𝓞 K ⧸ 𝔪.finitePart)ˣ
  → RayClassGroup 𝔪 → ClassGroup (𝓞 K) → 1.
```

This file constructs the purely finite moduli `Modulus.ofIdeal` and `Modulus.spanNat` attached to a
nonzero integral ideal and to a nonzero natural number (with `Modulus.spanNat_dvd_spanNat_iff`),
characterizes `unitsCongruenceSubgroup` when `𝔪.infinitePart = ∅`
(`unitsCongruenceSubgroup_eq_ker_of_infinitePart_eq_empty`,
`mem_unitsCongruenceSubgroup_iff_of_infinitePart_eq_empty`), and establishes the group isomorphism
`residueUnitsQuotientEquivKerRayClassToClassGroup` between `(𝓞 K ⧸ 𝔪.finitePart)ˣ` modulo the image
of `(𝓞 K)ˣ` and `(rayClassToClassGroup 𝔪).ker` via `residueRayClass`.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter VI, §1.
-/

public section

open IsDedekindDomain NumberField
open scoped nonZeroDivisors NumberField

namespace TauCeti.GlobalNumberFields

variable {K : Type*} [Field K] [NumberField K]

namespace Modulus

/-- Over a totally complex number field, every modulus has empty infinite part because there are no
real places. -/
@[simp]
theorem infinitePart_eq_empty [IsTotallyComplex K] (𝔪 : Modulus K) :
    𝔪.infinitePart = ∅ := by
  ext w
  exact (not_isReal_of_isTotallyComplex w.1 w.2).elim

/-- The modulus of `K` with prescribed nonzero finite part `I` and empty infinite part.
Exposed so `(ofIdeal I hI).finitePart` reduces in dependent carriers `(𝓞 K ⧸ 𝔪.finitePart)ˣ`. -/
@[expose] def ofIdeal (I : Ideal (𝓞 K)) (hI : I ≠ ⊥) : Modulus K where
  finitePart := I
  finitePart_ne_bot := hI
  infinitePart := ∅

/-- The finite part of `ofIdeal I hI` is `I`. -/
@[simp]
theorem ofIdeal_finitePart (I : Ideal (𝓞 K)) (hI : I ≠ ⊥) : (ofIdeal I hI).finitePart = I := (rfl)

/-- The infinite part of `ofIdeal I hI` is empty. -/
@[simp]
theorem ofIdeal_infinitePart (I : Ideal (𝓞 K)) (hI : I ≠ ⊥) :
    (ofIdeal I hI).infinitePart = ∅ := (rfl)

/-- The purely finite modulus attached to the unit ideal `⊤` is `Modulus.one K`. -/
@[simp]
theorem ofIdeal_top : ofIdeal (⊤ : Ideal (𝓞 K)) top_ne_bot = one K := by ext <;> simp

/-- Divisibility between purely finite moduli is divisibility of their underlying ideals. -/
theorem ofIdeal_dvd_ofIdeal_iff {I J : Ideal (𝓞 K)} (hI : I ≠ ⊥) (hJ : J ≠ ⊥) :
    ofIdeal I hI ∣ ofIdeal J hJ ↔ I ∣ J := by simp [dvd_iff]

variable (K) in
/-- The modulus `(n)` of `K` generated by a nonzero natural number `n`, with empty infinite part.
Exposed so `(spanNat K n).finitePart` reduces to `Ideal.span {(n : 𝓞 K)}` in dependent types. -/
@[expose] def spanNat (n : ℕ) [NeZero n] : Modulus K :=
  ofIdeal (Ideal.span {(n : 𝓞 K)}) <| by
    rw [Ne, Ideal.span_singleton_eq_bot, Nat.cast_eq_zero]; exact NeZero.ne n

/-- Unfolding lemma for `Modulus.spanNat`. -/
theorem spanNat_def (n : ℕ) [NeZero n] :
    spanNat K n = ofIdeal (Ideal.span {(n : 𝓞 K)}) (by
      rw [Ne, Ideal.span_singleton_eq_bot, Nat.cast_eq_zero]; exact NeZero.ne n) := (rfl)

/-- The finite part of `spanNat K n` is the principal ideal `(n)`. -/
@[simp]
theorem spanNat_finitePart (n : ℕ) [NeZero n] :
    (spanNat K n).finitePart = Ideal.span {(n : 𝓞 K)} := (rfl)

/-- The infinite part of `spanNat K n` is empty. -/
@[simp]
theorem spanNat_infinitePart (n : ℕ) [NeZero n] : (spanNat K n).infinitePart = ∅ := (rfl)

/-- At `n = 1`, `spanNat K 1` is the trivial modulus `Modulus.one K`. -/
@[simp]
theorem spanNat_one : spanNat K 1 = one K := by ext <;> simp

/-- Divisibility of natural-number moduli `(m)` and `(n)` in `K` is `m ∣ n`. -/
theorem spanNat_dvd_spanNat_iff {m n : ℕ} [NeZero m] [NeZero n] :
    spanNat K m ∣ spanNat K n ↔ m ∣ n := by
  rw [dvd_iff, spanNat_finitePart, spanNat_finitePart, spanNat_infinitePart, Ideal.dvd_iff_le,
    Ideal.span_singleton_le_span_singleton, NumberField.RingOfIntegers.natCast_dvd_natCast]
  simp

end Modulus

/-! ### Integer units modulo the finite part -/

/-- The finite component of `unitsResidueSignHom` is the canonical reduction of `(𝓞 K)ˣ` modulo
`𝔪.finitePart`. -/
theorem unitsResidueSignHom_fst (𝔪 : Modulus K) (u : (𝓞 K)ˣ) :
    (unitsResidueSignHom 𝔪 u).1 = Units.map (Ideal.Quotient.mk 𝔪.finitePart) u := by
  rw [unitsResidueSignHom_apply, residueSignHom_fst]
  refine Units.ext ?_
  rw [coe_residueHom, Units.coe_map, MonoidHom.coe_ofClass,
    residue_eq _ (a := (u : 𝓞 K)) (b := 1) (by simp)
      (by simp [coe_unitsToPrimeToSubgroup])]

/-- When `𝔪` has empty infinite part, the sign component of any element of
`𝔪.infinitePart → ℤˣ` is trivial. -/
private theorem eq_one_of_infinitePart_eq_empty {𝔪 : Modulus K} (h : 𝔪.infinitePart = ∅)
    (s : 𝔪.infinitePart → ℤˣ) : s = 1 := by
  ext w
  exact False.elim ((Finset.eq_empty_iff_forall_notMem.mp h) w.1 w.2)

/-- When `𝔪.infinitePart = ∅`, the units congruent to one modulo `𝔪` are the kernel of reduction
modulo `𝔪.finitePart`. -/
theorem unitsCongruenceSubgroup_eq_ker_of_infinitePart_eq_empty {𝔪 : Modulus K}
    (h : 𝔪.infinitePart = ∅) :
    unitsCongruenceSubgroup 𝔪 =
      (Units.map (Ideal.Quotient.mk 𝔪.finitePart : 𝓞 K →* 𝓞 K ⧸ 𝔪.finitePart)).ker := by
  ext u
  rw [← ker_unitsResidueSignHom, MonoidHom.mem_ker, MonoidHom.mem_ker, Prod.ext_iff,
    unitsResidueSignHom_fst]
  simp [eq_one_of_infinitePart_eq_empty h]

/-- When `𝔪.infinitePart = ∅`, an integer unit `u` is congruent to one modulo `𝔪` if and only if
`u - 1 ∈ 𝔪.finitePart`. -/
theorem mem_unitsCongruenceSubgroup_iff_of_infinitePart_eq_empty {𝔪 : Modulus K}
    (h : 𝔪.infinitePart = ∅) {u : (𝓞 K)ˣ} :
    u ∈ unitsCongruenceSubgroup 𝔪 ↔ (u : 𝓞 K) - 1 ∈ 𝔪.finitePart := by
  rw [unitsCongruenceSubgroup_eq_ker_of_infinitePart_eq_empty h, MonoidHom.mem_ker, Units.ext_iff,
    Units.coe_map, MonoidHom.coe_ofClass, Units.val_one,
    ← map_one (Ideal.Quotient.mk 𝔪.finitePart), Ideal.Quotient.eq]

/-- Membership in `unitsCongruenceSubgroup (Modulus.ofIdeal I hI)` is `u - 1 ∈ I`. -/
theorem mem_unitsCongruenceSubgroup_ofIdeal_iff {I : Ideal (𝓞 K)} (hI : I ≠ ⊥) {u : (𝓞 K)ˣ} :
    u ∈ unitsCongruenceSubgroup (Modulus.ofIdeal I hI) ↔ (u : 𝓞 K) - 1 ∈ I :=
  mem_unitsCongruenceSubgroup_iff_of_infinitePart_eq_empty (Modulus.ofIdeal_infinitePart I hI)

/-- Membership in `unitsCongruenceSubgroup (Modulus.spanNat K n)` is `(n : 𝓞 K) ∣ u - 1`. -/
theorem mem_unitsCongruenceSubgroup_spanNat_iff {n : ℕ} [NeZero n] {u : (𝓞 K)ˣ} :
    u ∈ unitsCongruenceSubgroup (Modulus.spanNat K n) ↔
      (n : 𝓞 K) ∣ (u : 𝓞 K) - 1 :=
  (mem_unitsCongruenceSubgroup_iff_of_infinitePart_eq_empty
    (Modulus.spanNat_infinitePart n)).trans Ideal.mem_span_singleton

/-! ### The purely finite residue-unit map to the ray class group -/

/-- The principal ray class attached to a residue unit modulo `𝔪.finitePart` with trivial signs at
the infinite places of `𝔪`. -/
noncomputable def residueRayClass (𝔪 : Modulus K) :
    (𝓞 K ⧸ 𝔪.finitePart)ˣ →* RayClassGroup 𝔪 :=
  (residueSignRayClass 𝔪).comp (MonoidHom.inl _ _)

/-- `residueRayClass 𝔪 u` evaluates `residueSignRayClass 𝔪` at `(u, 1)`. -/
@[simp]
theorem residueRayClass_apply (𝔪 : Modulus K) (u : (𝓞 K ⧸ 𝔪.finitePart)ˣ) :
    residueRayClass 𝔪 u = residueSignRayClass 𝔪 (u, 1) :=
  (rfl)

/-- When `𝔪.infinitePart = ∅`, the kernel of `residueRayClass 𝔪` is the image of `(𝓞 K)ˣ` in
`(𝓞 K ⧸ 𝔪.finitePart)ˣ`. -/
theorem ker_residueRayClass_of_infinitePart_eq_empty {𝔪 : Modulus K} (h : 𝔪.infinitePart = ∅) :
    (residueRayClass 𝔪).ker =
      (Units.map (Ideal.Quotient.mk 𝔪.finitePart : 𝓞 K →* 𝓞 K ⧸ 𝔪.finitePart)).range := by
  ext u
  rw [MonoidHom.mem_ker, residueRayClass_apply, ← MonoidHom.mem_ker, ker_residueSignRayClass,
    MonoidHom.mem_range, MonoidHom.mem_range]
  refine exists_congr fun v ↦ ?_
  rw [Prod.ext_iff, unitsResidueSignHom_fst]
  simp [eq_one_of_infinitePart_eq_empty h]

/-- When `𝔪.infinitePart = ∅`, the image of `residueRayClass 𝔪` is the kernel of
`rayClassToClassGroup 𝔪`. -/
theorem range_residueRayClass_of_infinitePart_eq_empty {𝔪 : Modulus K} (h : 𝔪.infinitePart = ∅) :
    (residueRayClass 𝔪).range = (rayClassToClassGroup 𝔪).ker := by
  rw [← range_residueSignRayClass]
  ext c
  rw [MonoidHom.mem_range, MonoidHom.mem_range]
  refine ⟨fun ⟨u, hu⟩ ↦ ⟨(u, 1), hu⟩, fun ⟨a, ha⟩ ↦ ⟨a.1, ?_⟩⟩
  rw [residueRayClass_apply, ← eq_one_of_infinitePart_eq_empty h a.2, Prod.mk.eta, ha]

/-- **The kernel of `RayClassGroup 𝔪 → ClassGroup (𝓞 K)` when `𝔪.infinitePart = ∅`** is canonically
isomorphic to the quotient of `(𝓞 K ⧸ 𝔪.finitePart)ˣ` by the image of the global integer units. -/
noncomputable def residueUnitsQuotientEquivKerRayClassToClassGroup {𝔪 : Modulus K}
    (h : 𝔪.infinitePart = ∅) :
    (𝓞 K ⧸ 𝔪.finitePart)ˣ ⧸
        (Units.map (Ideal.Quotient.mk 𝔪.finitePart : 𝓞 K →* 𝓞 K ⧸ 𝔪.finitePart)).range ≃*
      (rayClassToClassGroup 𝔪).ker :=
  ((QuotientGroup.quotientMulEquivOfEq
      (ker_residueRayClass_of_infinitePart_eq_empty h).symm).trans
    (QuotientGroup.quotientKerEquivRange (residueRayClass 𝔪))).trans
    (MulEquiv.subgroupCongr (range_residueRayClass_of_infinitePart_eq_empty h))

/-- `residueUnitsQuotientEquivKerRayClassToClassGroup` sends the coset of `u` to
`residueRayClass 𝔪 u`. -/
@[simp]
theorem coe_residueUnitsQuotientEquivKerRayClassToClassGroup_mk {𝔪 : Modulus K}
    (h : 𝔪.infinitePart = ∅) (u : (𝓞 K ⧸ 𝔪.finitePart)ˣ) :
    (residueUnitsQuotientEquivKerRayClassToClassGroup h u : RayClassGroup 𝔪) =
      residueRayClass 𝔪 u := by
  simp [residueUnitsQuotientEquivKerRayClassToClassGroup]

/-- When `𝔪.infinitePart = ∅`, the order of `(rayClassToClassGroup 𝔪).ker` times the index of the
congruent global units equals `#(𝓞 K ⧸ 𝔪.finitePart)ˣ`. -/
theorem card_ker_rayClassToClassGroup_mul_index_of_infinitePart_eq_empty {𝔪 : Modulus K}
    (h : 𝔪.infinitePart = ∅) :
    Nat.card (rayClassToClassGroup 𝔪).ker * (unitsCongruenceSubgroup 𝔪).index =
      Nat.card (𝓞 K ⧸ 𝔪.finitePart)ˣ := by
  simpa [h] using card_ker_rayClassToClassGroup_mul_index 𝔪

/-- When `𝔪.infinitePart = ∅`, the ray class number formula has no archimedean factor `2 ^ #𝔪∞`. -/
theorem card_rayClassGroup_mul_index_of_infinitePart_eq_empty {𝔪 : Modulus K}
    (h : 𝔪.infinitePart = ∅) :
    Nat.card (RayClassGroup 𝔪) * (unitsCongruenceSubgroup 𝔪).index =
      Nat.card (ClassGroup (𝓞 K)) * Nat.card (𝓞 K ⧸ 𝔪.finitePart)ˣ := by
  simpa [h] using card_rayClassGroup_mul_index 𝔪

end TauCeti.GlobalNumberFields
