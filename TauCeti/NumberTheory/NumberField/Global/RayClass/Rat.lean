/-!
# The ray class group of `ℚ` modulo `(n)·∞`

For a positive integer `n`, the modulus `(n)·∞` of `ℚ` has finite part the ideal generated by `n`
and infinite part the unique real place.  Its ray class group is `(ZMod n)ˣ`: a fractional ideal
of `ℚ` prime to `n` has exactly one positive generator, and the class of the ideal is the residue
of that generator modulo `n`.  In particular the ray class of a nonzero integral ideal prime to
`n` is its absolute norm modulo `n`.

The real place is essential.  For the modulus `(n)` without it, both `a` and `-a` generate the
same ideal, so the ray class group is only `(ZMod n)ˣ ⧸ {±1}`.  For `n > 2` this has half the
order of `(ZMod n)ˣ`, so the two moduli give genuinely different ray class groups.

The equivalence is read off from the ray class exact sequence.  The class group of `ℚ` is
trivial, so every ray class is the class of a residue unit modulo `n` and a sign at the real
place.  The only integer units are `±1`, so the sign of a class can be absorbed into its residue
and a class with positive sign is determined by its residue.

## Main definitions

* `TauCeti.GlobalNumberFields.ratModulus`: the modulus `(n)·∞` of `ℚ`.
* `TauCeti.GlobalNumberFields.ratModulusResidueEquiv`: the residue ring of `𝓞 ℚ` modulo the finite
  part of `ratModulus n hn` is `ZMod n`.
* `TauCeti.GlobalNumberFields.ratModulusEquivZMod`: the ray class group of `ratModulus n hn` is
  `(ZMod n)ˣ`.
* `TauCeti.GlobalNumberFields.ratFiniteModulus`: the modulus `(n)` of `ℚ` without the real place.
* `TauCeti.GlobalNumberFields.ratFiniteModulusEquivZMod`: the ray class group of
  `ratFiniteModulus n hn` is `(ZMod n)ˣ ⧸ {±1}`.

## Main results

* `TauCeti.GlobalNumberFields.asIdeal_mem_integralIdealsPrimeTo_ratModulus_iff`: a height-one
  prime is prime to `(n)·∞` exactly when it does not contain `n`.
* `TauCeti.GlobalNumberFields.ratModulusEquivZMod_symm_apply`: a unit `u` modulo `n` corresponds to
  the principal ray class of a positive rational number with residue `u`.
* `TauCeti.GlobalNumberFields.coe_ratModulusEquivZMod_idealClass`: the ray class of a nonzero
  integral ideal prime to `n` is its absolute norm modulo `n`.
* `TauCeti.GlobalNumberFields.ratModulusEquivZMod_classMap`: the transition map from `(n)·∞` to
  `(d)·∞` is reduction modulo `d`.
* `TauCeti.GlobalNumberFields.ratModulusEquivZMod_residueSignRayClass_neg_one`: the class of the
  sign `-1` at the real place is `-1 ∈ (ZMod n)ˣ`.
* `TauCeti.GlobalNumberFields.ratModulus_dvd_ratModulus_iff` and
  `TauCeti.GlobalNumberFields.ratFiniteModulus_dvd_ratModulus_iff`: divisibility of the moduli
  `(d)·∞` and `(d)` into `(n)·∞` is `d ∣ n`.
* `TauCeti.GlobalNumberFields.ratFiniteModulusEquivZMod_classMap`: the transition map from
  `(n)·∞` to `(d)` is reduction modulo `d` followed by the quotient by `±1`.
* `TauCeti.GlobalNumberFields.ratFiniteModulusEquivZMod_idealClass`: the ray class modulo `(n)` of
  a nonzero integral ideal prime to `n` is its absolute norm modulo `n`, up to sign.
* `TauCeti.GlobalNumberFields.two_mul_card_rayClassGroup_ratFiniteModulus`: for `n > 2`, the ray
  class group modulo `(n)` has order `φ(n) / 2`.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter VI, §1.
-/

public section

open IsDedekindDomain NumberField
open scoped nonZeroDivisors NumberField

namespace TauCeti.GlobalNumberFields

/-- **The modulus `(n)·∞` of `ℚ`**: its finite part is the ideal of `𝓞 ℚ` generated by `n`, and
its infinite part is the real place of `ℚ`. -/
noncomputable def ratModulus (n : ℕ) (hn : n ≠ 0) : Modulus ℚ where
  finitePart := Ideal.span {(n : 𝓞 ℚ)}
  finitePart_ne_bot := by
    rw [Ne, Ideal.span_singleton_eq_bot]
    exact_mod_cast hn
  infinitePart := {⟨Rat.infinitePlace, Rat.isReal_infinitePlace⟩}

variable (n : ℕ) (hn : n ≠ 0)

@[simp] theorem ratModulus_finitePart :
    (ratModulus n hn).finitePart = Ideal.span {(n : 𝓞 ℚ)} := (rfl)

@[simp] theorem ratModulus_infinitePart :
    (ratModulus n hn).infinitePart = {⟨Rat.infinitePlace, Rat.isReal_infinitePlace⟩} := (rfl)

variable {n hn} in
/-- A prime lies in the support of `ratModulus n hn` exactly when it contains `n`. -/
theorem mem_ratModulus_support_iff {v : HeightOneSpectrum (𝓞 ℚ)} :
    v ∈ (ratModulus n hn).support ↔ (n : 𝓞 ℚ) ∈ v.asIdeal := by
  rw [Modulus.mem_support_iff, ratModulus_finitePart, Ideal.dvd_span_singleton]

variable {n hn} in
/-- A height-one prime is prime to `ratModulus n hn` exactly when it does not contain `n`. -/
theorem asIdeal_mem_integralIdealsPrimeTo_ratModulus_iff {v : HeightOneSpectrum (𝓞 ℚ)} :
    v.asIdeal ∈ integralIdealsPrimeTo (ratModulus n hn) ↔ (n : 𝓞 ℚ) ∉ v.asIdeal :=
  Modulus.mem_integralIdealsPrimeTo.trans <|
    (Modulus.isCoprimeTo_iff.trans Ideal.isPrimeTo_iff.symm).trans <|
      Ideal.isPrimeTo_asIdeal_iff.trans mem_ratModulus_support_iff.not

/-- **Reduction modulo the finite part of `ratModulus n hn` is reduction modulo `n`**, transported
along `Rat.ringOfIntegersEquiv : 𝓞 ℚ ≃+* ℤ`. -/
noncomputable def ratModulusResidueEquiv : 𝓞 ℚ ⧸ (ratModulus n hn).finitePart ≃+* ZMod n :=
  (Ideal.quotientEquiv _ (Ideal.span {(n : ℤ)}) Rat.ringOfIntegersEquiv (by
      rw [ratModulus_finitePart, Ideal.map_span, Set.image_singleton, map_natCast])).trans
    (Int.quotientSpanNatEquivZMod n)

@[simp] theorem ratModulusResidueEquiv_mk (a : 𝓞 ℚ) :
    ratModulusResidueEquiv n hn (Ideal.Quotient.mk _ a) = (Rat.ringOfIntegersEquiv a : ZMod n) := by
  rw [ratModulusResidueEquiv, RingEquiv.trans_apply, Ideal.quotientEquiv_mk]
  exact RingHom.congr_fun (Int.quotientSpanNatEquivZMod_comp_Quotient_mk n) _

/-- The ray class of a unit modulo `n`: the principal ray class of an element with that residue
and positive sign. -/
private noncomputable def zmodUnitsToRayClass : (ZMod n)ˣ →* RayClassGroup (ratModulus n hn) :=
  (residueSignRayClass (ratModulus n hn)).comp <| (MonoidHom.inl _ _).comp
    (Units.mapEquiv (ratModulusResidueEquiv n hn).symm.toMulEquiv).toMonoidHom

private theorem zmodUnitsToRayClass_apply (u : (ZMod n)ˣ) :
    zmodUnitsToRayClass n hn u = residueSignRayClass (ratModulus n hn)
      (Units.mapEquiv (ratModulusResidueEquiv n hn).symm.toMulEquiv u, 1) :=
  (rfl)

variable {n hn}

/-- **The ray class of an integral ideal of `𝓞 ℚ` prime to `n`.**  Its absolute norm is a positive
generator, so the class is that of the residue of the norm together with the trivial sign. -/
private theorem exists_zmodUnitsToRayClass_eq_idealClass
    (I : integralIdealsPrimeTo (ratModulus n hn)) :
    ∃ u : (ZMod n)ˣ, (u : ZMod n) = Ideal.absNorm (I : Ideal (𝓞 ℚ)) ∧
      zmodUnitsToRayClass n hn u = idealClass (ratModulus n hn) I := by
  set a := Ideal.absNorm (I : Ideal (𝓞 ℚ)) with ha_def
  have ha : a ≠ 0 := by
    rw [ha_def, Ne, Ideal.absNorm_eq_zero_iff]
    exact (Modulus.isCoprimeTo_iff.mp (Modulus.mem_integralIdealsPrimeTo.mp I.2)).1
  -- The norm generates `I`, so the ray class of `I` is the principal ray class of the norm.
  obtain ⟨x, hxa, hIx⟩ := exists_idealClass_eq_principalRayClass
    (Rat.RingOfIntegers.ideal_span_absNorm_eq_self (I : Ideal (𝓞 ℚ))).symm
  push_cast [← ha_def] at hxa
  set r := residueHom (ratModulus n hn) x
  refine ⟨Units.mapEquiv (ratModulusResidueEquiv n hn).toMulEquiv r, ?_, ?_⟩
  · rw [Units.coe_mapEquiv, RingEquiv.toMulEquiv_eq_coe, RingEquiv.coe_toMulEquiv, coe_residueHom,
      residue_eq (a := (a : 𝓞 ℚ)) (b := 1) _ (by simp) (by simp [hxa]),
      ratModulusResidueEquiv_mk, map_natCast, Int.cast_natCast]
  · -- The norm is positive at the real place, so the class is that of its residue alone.
    have hsign : modulusSignHom (ratModulus n hn) (x : ℚˣ) = 1 :=
      (modulusSignHom_eq_one_iff (x : ℚˣ)).mpr fun w _ ↦ by
        rw [hxa, map_natCast]
        exact Nat.cast_pos.mpr (Nat.pos_of_ne_zero ha)
    rw [hIx, ← residueSignRayClass_residueSignHom, zmodUnitsToRayClass_apply]
    refine congrArg _ (Prod.ext (Units.ext ?_) ((residueSignHom_snd _ _).trans hsign).symm)
    simp [r]

private theorem zmodUnitsToRayClass_injective : Function.Injective (zmodUnitsToRayClass n hn) := by
  rw [injective_iff_map_eq_one]
  intro u hu
  -- A residue with positive sign and trivial ray class comes from a positive integer unit.
  have hmem : (Units.mapEquiv (ratModulusResidueEquiv n hn).symm.toMulEquiv u,
      (1 : (ratModulus n hn).infinitePart → ℤˣ)) ∈ (residueSignRayClass (ratModulus n hn)).ker :=
    hu
  rw [ker_residueSignRayClass] at hmem
  obtain ⟨v, hv⟩ := hmem
  rw [unitsResidueSignHom_apply, Prod.ext_iff, residueSignHom_fst, residueSignHom_snd,
    coe_unitsToPrimeToSubgroup] at hv
  have hpos := (modulusSignHom_eq_one_iff _).mp hv.2 ⟨Rat.infinitePlace, Rat.isReal_infinitePlace⟩
    (by rw [ratModulus_infinitePart]; exact Finset.mem_singleton_self _)
  -- The only positive integer unit of `ℚ` is `1`.
  have hv1 : v = 1 := by
    rcases Rat.RingOfIntegers.isUnit_iff.mp v.isUnit with h | h
    · exact Units.ext (RingOfIntegers.ext h)
    · -- The real embedding of `ℚ` is the identity on rationals, so `hpos` reads `0 < v`.
      rw [RingOfIntegers.coe_eq_algebraMap] at h
      norm_num at hpos
      linarith
  rw [hv1, map_one, map_one] at hv
  exact (Units.mapEquiv _).injective (hv.1.symm.trans (map_one _).symm)

private theorem zmodUnitsToRayClass_surjective :
    Function.Surjective (zmodUnitsToRayClass n hn) := by
  intro c
  obtain ⟨I, rfl⟩ := idealClass_surjective _ c
  obtain ⟨u, -, hu⟩ := exists_zmodUnitsToRayClass_eq_idealClass I
  exact ⟨u, hu⟩

variable (n hn)

/-- **The ray class group of `ℚ` modulo `(n)·∞` is `(ZMod n)ˣ`.**  A ray class corresponds to the
residue modulo `n` of the positive generator of any fractional ideal in it. -/
noncomputable def ratModulusEquivZMod : RayClassGroup (ratModulus n hn) ≃* (ZMod n)ˣ :=
  (MulEquiv.ofBijective (zmodUnitsToRayClass n hn)
    ⟨zmodUnitsToRayClass_injective, zmodUnitsToRayClass_surjective⟩).symm

/-- A unit `u` modulo `n` corresponds to the principal ray class of an element with residue `u`
and positive sign at the real place. -/
theorem ratModulusEquivZMod_symm_apply (u : (ZMod n)ˣ) :
    (ratModulusEquivZMod n hn).symm u = residueSignRayClass (ratModulus n hn)
      (Units.mapEquiv (ratModulusResidueEquiv n hn).symm.toMulEquiv u, 1) := by
  rfl

/-- **The ray class of a nonzero integral ideal prime to `n` is its absolute norm modulo `n`.**
Since `idealClass` is surjective, this characterizes `ratModulusEquivZMod`. -/
@[simp]
theorem coe_ratModulusEquivZMod_idealClass (I : integralIdealsPrimeTo (ratModulus n hn)) :
    ((ratModulusEquivZMod n hn (idealClass (ratModulus n hn) I) : (ZMod n)ˣ) : ZMod n) =
      Ideal.absNorm (I : Ideal (𝓞 ℚ)) := by
  obtain ⟨u, hu, hcl⟩ := exists_zmodUnitsToRayClass_eq_idealClass I
  have h : (ratModulusEquivZMod n hn).symm u = idealClass (ratModulus n hn) I := by
    rw [ratModulusEquivZMod_symm_apply, ← zmodUnitsToRayClass_apply, hcl]
  rw [← hu, ← h, MulEquiv.apply_symm_apply]

/-! ### Divisibility of the moduli `(n)·∞` and compatibility of the identification -/

variable {n hn}

/-- **The moduli `(d)·∞` and `(n)·∞` of `ℚ` divide each other as `d` and `n` do.** -/
theorem ratModulus_dvd_ratModulus_iff {d : ℕ} {hd : d ≠ 0} :
    ratModulus d hd ∣ ratModulus n hn ↔ d ∣ n := by
  rw [Modulus.dvd_iff, ratModulus_finitePart, ratModulus_finitePart, ratModulus_infinitePart,
    ratModulus_infinitePart, Ideal.span_singleton_dvd_span_singleton_iff_dvd,
    NumberField.RingOfIntegers.natCast_dvd_natCast, and_iff_left (Finset.Subset.refl _)]

/-- **The transition map from `(n)·∞` to `(d)·∞` is reduction modulo `d` on `(ZMod n)ˣ`.** -/
theorem ratModulusEquivZMod_classMap {d : ℕ} {hd : d ≠ 0} (h : ratModulus d hd ∣ ratModulus n hn)
    (c : RayClassGroup (ratModulus n hn)) :
    ratModulusEquivZMod d hd (classMap h c) =
      ZMod.unitsMap (ratModulus_dvd_ratModulus_iff.mp h) (ratModulusEquivZMod n hn c) := by
  obtain ⟨I, rfl⟩ := idealClass_surjective _ c
  refine Units.ext ?_
  rw [classMap_idealClass, coe_ratModulusEquivZMod_idealClass, ZMod.unitsMap_val,
    coe_ratModulusEquivZMod_idealClass, coe_integralIdealsPrimeToInclusion,
    ZMod.cast_natCast (ratModulus_dvd_ratModulus_iff.mp h)]

/-- **The class of the sign `-1` at the real place corresponds to `-1 ∈ (ZMod n)ˣ`.**  The ray
class of a negative rational with residue `1` modulo `n` is the ray class of a positive rational
with residue `-1`: the two differ by the unit `-1`. -/
theorem ratModulusEquivZMod_residueSignRayClass_neg_one :
    ratModulusEquivZMod n hn (residueSignRayClass (ratModulus n hn) (1, fun _ ↦ -1)) = -1 := by
  have hker : residueSignRayClass (ratModulus n hn)
      (unitsResidueSignHom (ratModulus n hn) (-1)) = 1 := by
    rw [← MonoidHom.mem_ker, ker_residueSignRayClass]
    exact ⟨-1, rfl⟩
  have hunit : Units.mapEquiv (ratModulusResidueEquiv n hn).symm.toMulEquiv (-1) = -1 := by
    ext
    simp
  have hmul : ((1, fun _ ↦ -1) :
      (𝓞 ℚ ⧸ (ratModulus n hn).finitePart)ˣ × ((ratModulus n hn).infinitePart → ℤˣ)) =
        (-1, 1) * unitsResidueSignHom (ratModulus n hn) (-1) := by
    rw [unitsResidueSignHom_neg_one, Prod.mk_mul_mk, neg_one_mul, neg_neg, one_mul]
  rw [hmul, map_mul, hker, mul_one]
  refine (MulEquiv.eq_symm_apply _).mp ?_
  rw [ratModulusEquivZMod_symm_apply, hunit]

/-! ### The modulus `(n)` without the real place -/

variable (n hn)

/-- **The modulus `(n)` of `ℚ` without the real place.**  A ray class character of `(n)·∞` is
induced from it exactly when the corresponding Dirichlet character is even. -/
noncomputable def ratFiniteModulus : Modulus ℚ where
  finitePart := Ideal.span {(n : 𝓞 ℚ)}
  finitePart_ne_bot := by
    rw [Ne, Ideal.span_singleton_eq_bot]
    exact_mod_cast hn
  infinitePart := ∅

@[simp] theorem ratFiniteModulus_finitePart :
    (ratFiniteModulus n hn).finitePart = Ideal.span {(n : 𝓞 ℚ)} := (rfl)

@[simp] theorem ratFiniteModulus_infinitePart : (ratFiniteModulus n hn).infinitePart = ∅ := (rfl)

variable {n hn}

/-- **The modulus `(d)` divides `(n)·∞` exactly when `d ∣ n`.** -/
theorem ratFiniteModulus_dvd_ratModulus_iff {d : ℕ} {hd : d ≠ 0} :
    ratFiniteModulus d hd ∣ ratModulus n hn ↔ d ∣ n := by
  rw [Modulus.dvd_iff, ratFiniteModulus_finitePart, ratModulus_finitePart,
    ratFiniteModulus_infinitePart, Ideal.span_singleton_dvd_span_singleton_iff_dvd,
    NumberField.RingOfIntegers.natCast_dvd_natCast, and_iff_left (Finset.empty_subset _)]

/-- The modulus `(n)` divides `(n)·∞`. -/
theorem ratFiniteModulus_dvd_ratModulus : ratFiniteModulus n hn ∣ ratModulus n hn :=
  ratFiniteModulus_dvd_ratModulus_iff.mpr dvd_rfl

/-! ### The ray class group of `ℚ` modulo `(n)` -/

/-- The ray class modulo `(n)` of a positive rational with residue `u` modulo `n`: the class
modulo `(n)·∞` attached to `u` by `ratModulusEquivZMod`, with the real place forgotten. -/
private noncomputable def zmodUnitsToFiniteRayClass :
    (ZMod n)ˣ →* RayClassGroup (ratFiniteModulus n hn) :=
  (classMap ratFiniteModulus_dvd_ratModulus).comp (ratModulusEquivZMod n hn).symm.toMonoidHom

private theorem zmodUnitsToFiniteRayClass_surjective :
    Function.Surjective (zmodUnitsToFiniteRayClass (n := n) (hn := hn)) :=
  (classMap_surjective _).comp (ratModulusEquivZMod n hn).symm.surjective

/-- A unit modulo `n` has trivial ray class modulo `(n)` exactly when it is `±1`: forgetting the
real place kills precisely the class of the sign `-1`, which is `-1 ∈ (ZMod n)ˣ`. -/
private theorem ker_zmodUnitsToFiniteRayClass :
    (zmodUnitsToFiniteRayClass (n := n) (hn := hn)).ker = Subgroup.zpowers (-1) := by
  ext u
  rw [Subgroup.mem_zpowers_iff_of_sq_eq_one neg_one_sq, MonoidHom.mem_ker,
    zmodUnitsToFiniteRayClass, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    classMap_eq_one_iff_of_finitePart_eq _ (by simp)]
  -- The modulus `(n)` has no real place, so the sign pattern is unconstrained; since the real
  -- place is the only element of the infinite part of `(n)·∞`, the pattern is `1` or `-1`.
  let w₀ : (ratModulus n hn).infinitePart :=
    ⟨⟨Rat.infinitePlace, Rat.isReal_infinitePlace⟩, by simp⟩
  constructor
  · rintro ⟨s, -, hs⟩
    rw [MulEquiv.eq_symm_apply] at hs
    rcases Int.units_eq_one_or (s w₀) with h | h
    · have hs' : s = 1 := funext fun w ↦ by rw [Subsingleton.elim w w₀, h, Pi.one_apply]
      rw [← hs, hs', Prod.mk_one_one, map_one, map_one]
      exact Or.inl rfl
    · have hs' : s = fun _ ↦ -1 := funext fun w ↦ by rw [Subsingleton.elim w w₀, h]
      rw [← hs, hs', ratModulusEquivZMod_residueSignRayClass_neg_one]
      exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact ⟨1, fun _ _ ↦ rfl, by rw [Prod.mk_one_one, map_one, map_one]⟩
    · refine ⟨fun _ ↦ -1, fun w hw ↦ by simp at hw, ?_⟩
      rw [MulEquiv.eq_symm_apply, ratModulusEquivZMod_residueSignRayClass_neg_one]

variable (n hn)

/-- **The ray class group of `ℚ` modulo `(n)` is `(ZMod n)ˣ ⧸ {±1}`.**  Without the real place, a
fractional ideal of `ℚ` prime to `n` has the two generators `±a` on an equal footing, so its ray
class is the residue of a generator modulo `n`, up to sign. -/
noncomputable def ratFiniteModulusEquivZMod :
    RayClassGroup (ratFiniteModulus n hn) ≃* (ZMod n)ˣ ⧸ Subgroup.zpowers (-1) :=
  ((QuotientGroup.quotientMulEquivOfEq ker_zmodUnitsToFiniteRayClass).symm.trans
    (QuotientGroup.quotientKerEquivOfSurjective _ zmodUnitsToFiniteRayClass_surjective)).symm

variable {n hn}

private theorem ratFiniteModulusEquivZMod_zmodUnitsToFiniteRayClass (u : (ZMod n)ˣ) :
    ratFiniteModulusEquivZMod n hn (zmodUnitsToFiniteRayClass u) = u := by
  rw [ratFiniteModulusEquivZMod, MulEquiv.symm_apply_eq, MulEquiv.trans_apply,
    (MulEquiv.symm_apply_eq _).mpr (QuotientGroup.quotientMulEquivOfEq_mk _ u).symm,
    TauCeti.QuotientGroup.quotientKerEquivOfSurjective_apply_mk]

/-- **Forgetting the real place is reduction modulo `±1`.**  For `d ∣ n`, the transition map from
`(n)·∞` to `(d)` sends the class of `u ∈ (ZMod n)ˣ` to the class of its reduction modulo `d`, up to
sign. -/
theorem ratFiniteModulusEquivZMod_classMap {d : ℕ} {hd : d ≠ 0}
    (h : ratFiniteModulus d hd ∣ ratModulus n hn) (c : RayClassGroup (ratModulus n hn)) :
    ratFiniteModulusEquivZMod d hd (classMap h c) =
      ZMod.unitsMap (ratFiniteModulus_dvd_ratModulus_iff.mp h) (ratModulusEquivZMod n hn c) := by
  have hdn := ratFiniteModulus_dvd_ratModulus_iff.mp h
  have h₂ : ratModulus d hd ∣ ratModulus n hn := ratModulus_dvd_ratModulus_iff.mpr hdn
  rw [← classMap_classMap ratFiniteModulus_dvd_ratModulus h₂, ← ratModulusEquivZMod_classMap h₂,
    ← ratFiniteModulusEquivZMod_zmodUnitsToFiniteRayClass]
  refine congrArg (ratFiniteModulusEquivZMod d hd) ?_
  rw [zmodUnitsToFiniteRayClass, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.symm_apply_apply]

/-- **The ray class modulo `(n)` of a nonzero integral ideal prime to `n` is its absolute norm
modulo `n`, up to sign.** -/
theorem ratFiniteModulusEquivZMod_idealClass (I : integralIdealsPrimeTo (ratFiniteModulus n hn))
    {u : (ZMod n)ˣ} (hu : (u : ZMod n) = Ideal.absNorm (I : Ideal (𝓞 ℚ))) :
    ratFiniteModulusEquivZMod n hn (idealClass (ratFiniteModulus n hn) I) = u := by
  -- The two moduli have the same finite part, hence the same integral ideals prime to them.
  have hI : (I : Ideal (𝓞 ℚ)) ∈ integralIdealsPrimeTo (ratModulus n hn) := by
    have := Modulus.mem_integralIdealsPrimeTo.mp I.2
    rw [Modulus.isCoprimeTo_iff_sup_eq_top, ratFiniteModulus_finitePart] at this
    rwa [Modulus.mem_integralIdealsPrimeTo, Modulus.isCoprimeTo_iff_sup_eq_top,
      ratModulus_finitePart]
  have hincl : integralIdealsPrimeToInclusion ratFiniteModulus_dvd_ratModulus ⟨_, hI⟩ = I :=
    Subtype.ext (coe_integralIdealsPrimeToInclusion _ _)
  rw [← hincl, ← classMap_idealClass, ratFiniteModulusEquivZMod_classMap, ZMod.unitsMap_self]
  congr 1
  exact Units.ext ((coe_ratModulusEquivZMod_idealClass n hn _).trans hu.symm)

/-- **The ray class group of `ℚ` modulo `(n)` has half the order of the one modulo `(n)·∞`** once
`n > 2`, so that `-1 ≠ 1` modulo `n`: its order is `φ(n) / 2`, while
`RayClassGroup (ratModulus n hn)` has order `φ(n)`.  The real place therefore genuinely enlarges
the ray class group. -/
theorem two_mul_card_rayClassGroup_ratFiniteModulus (h2 : 2 < n) :
    2 * Nat.card (RayClassGroup (ratFiniteModulus n hn)) = n.totient := by
  have : NeZero n := ⟨hn⟩
  have : Fact (2 < n) := ⟨h2⟩
  have hne : (-1 : (ZMod n)ˣ) ≠ 1 := fun h ↦ ZMod.neg_one_ne_one (congrArg Units.val h)
  rw [Nat.card_congr (ratFiniteModulusEquivZMod n hn).toEquiv, ← Subgroup.index,
    ← orderOf_eq_prime neg_one_sq hne, ← Nat.card_zpowers, Subgroup.card_mul_index,
    Nat.card_eq_fintype_card, ZMod.card_units_eq_totient]

end TauCeti.GlobalNumberFields
