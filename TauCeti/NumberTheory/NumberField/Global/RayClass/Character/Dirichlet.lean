/-!
# Ray class characters of `ℚ` and Dirichlet characters

A ray class character of the modulus `(n)·∞` of `ℚ` is the same thing as a Dirichlet character
modulo `n` with complex values: the ray class group of `(n)·∞` is `(ZMod n)ˣ`
(`ratModulusEquivZMod`), and a character of `(ZMod n)ˣ` is a Dirichlet character.  Under this
dictionary the value of the ray class character at a nonzero integral ideal prime to `n` is the
value of the Dirichlet character at the absolute norm of the ideal.

The dictionary is compatible with the two notions of conductor.  Inducing a ray class character
from `(d)·∞` to `(n)·∞` is `DirichletCharacter.changeLevel`, so a Dirichlet character factors
through `d` exactly when the ray class character is induced from `(d)·∞`.  Omitting the real place
is a parity condition: the ray class character is induced from the modulus `(d)` without the real
place exactly when the Dirichlet character factors through `d` and is even.  Consequently the finite
part of the conductor of the ray class character is generated by the conductor of the Dirichlet
character, and its infinite part is empty exactly when the Dirichlet character is even.

## Main definitions

* `TauCeti.GlobalNumberFields.ratDirichletEquiv`: ray class characters of `(n)·∞` are Dirichlet
  characters modulo `n`.
* `TauCeti.GlobalNumberFields.RayClassCharacter.toDirichletCharacter`: the Dirichlet character of
  level `Ideal.absNorm 𝔪.finitePart` attached to a ray class character of an arbitrary modulus `𝔪`
  of `ℚ` via `dvd_ratModulus_absNorm`.

## Main results

* `TauCeti.GlobalNumberFields.ratDirichletEquiv_absNorm` and
  `TauCeti.GlobalNumberFields.RayClassCharacter.toDirichletCharacter_absNorm`: a ray class
  character at an integral ideal prime to its modulus is its Dirichlet character at the absolute
  norm of the ideal.
* `TauCeti.GlobalNumberFields.ratDirichletEquiv_induced` and
  `TauCeti.GlobalNumberFields.RayClassCharacter.toDirichletCharacter_induced`: inducing to a
  multiple modulus is changing the level of the Dirichlet character.
* `TauCeti.GlobalNumberFields.factorsThrough_ratDirichletEquiv_iff`: a Dirichlet character factors
  through `d` exactly when its ray class character is induced from `(d)·∞`.
* `TauCeti.GlobalNumberFields.even_ratDirichletEquiv_iff_exists_induced` and
  `TauCeti.GlobalNumberFields.factorsThrough_and_even_ratDirichletEquiv_iff`: a Dirichlet
  character is even exactly when its ray class character is induced from the modulus without the
  real place.
* `TauCeti.GlobalNumberFields.RayClassCharacter.mem_range_toDirichletCharacter_iff`: at level
  `Ideal.absNorm 𝔪.finitePart`, a Dirichlet character is in the image of `toDirichletCharacter`
  iff `𝔪` contains the real place or the character is even.
* `TauCeti.GlobalNumberFields.RayClassCharacter.conductor_finitePart_eq_span`,
  `TauCeti.GlobalNumberFields.RayClassCharacter.conductor_infinitePart_eq_empty_iff_even`,
  `TauCeti.GlobalNumberFields.RayClassCharacter.conductor_toDirichletCharacter`,
  `TauCeti.GlobalNumberFields.RayClassCharacter.conductor_eq_ratFiniteModulus_of_even`, and
  `TauCeti.GlobalNumberFields.RayClassCharacter.conductor_eq_ratModulus_of_not_even`: the
  conductor of a ray class character of `ℚ` is the conductor of its Dirichlet character, with the
  real place included exactly for an odd character.
* `TauCeti.GlobalNumberFields.RayClassCharacter.isPrimitive_iff_of_infinitePart_eq_empty` and
  `TauCeti.GlobalNumberFields.RayClassCharacter.isPrimitive_iff_of_infinitePart_ne_empty`:
  primitivity of a ray class character of `ℚ` in terms of primitivity and parity of its Dirichlet
  character.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter VI, §1 and Chapter VII, §6.
* The Dirichlet-character side is Mathlib's `Mathlib.NumberTheory.DirichletCharacter.Basic`
  (`DirichletCharacter.changeLevel`, `DirichletCharacter.FactorsThrough`,
  `DirichletCharacter.conductor`, `DirichletCharacter.Even`).
-/

public section

open DirichletCharacter IsDedekindDomain NumberField
open scoped NumberField

namespace TauCeti.GlobalNumberFields

variable (n : ℕ) (hn : n ≠ 0)

/-- **Ray class characters of `(n)·∞` are Dirichlet characters modulo `n`.**  A ray class character
is transported along `ratModulusEquivZMod` to a character of `(ZMod n)ˣ`, which is a Dirichlet
character of level `n` with complex values. -/
noncomputable def ratDirichletEquiv :
    RayClassCharacter (ratModulus n hn) ≃* DirichletCharacter ℂ n :=
  (MulEquiv.monoidHomCongrLeft (ratModulusEquivZMod n hn)).trans MulChar.mulEquivToUnitHom.symm

variable {n hn}

/-- The Dirichlet character of a ray class character, evaluated at a unit modulo `n`. -/
@[simp]
theorem ratDirichletEquiv_apply_coe (η : RayClassCharacter (ratModulus n hn)) (u : (ZMod n)ˣ) :
    ratDirichletEquiv n hn η u = η ((ratModulusEquivZMod n hn).symm u) := by
  simp [ratDirichletEquiv]

/-- The ray class character of a Dirichlet character, evaluated at a ray class. -/
@[simp]
theorem ratDirichletEquiv_symm_apply (ψ : DirichletCharacter ℂ n)
    (c : RayClassGroup (ratModulus n hn)) :
    (ratDirichletEquiv n hn).symm ψ c = ψ.toUnitHom (ratModulusEquivZMod n hn c) := by
  simp [ratDirichletEquiv]

/-- **A ray class character at an integral ideal is its Dirichlet character at the norm.** -/
theorem ratDirichletEquiv_absNorm (η : RayClassCharacter (ratModulus n hn))
    (I : integralIdealsPrimeTo (ratModulus n hn)) :
    ratDirichletEquiv n hn η (Ideal.absNorm (I : Ideal (𝓞 ℚ)) : ZMod n) = (η.onIdeals I : ℂ) := by
  rw [← coe_ratModulusEquivZMod_idealClass, ratDirichletEquiv_apply_coe,
    MulEquiv.symm_apply_apply, RayClassCharacter.onIdeals_apply]

/-- **The ray class character of a Dirichlet character at an integral ideal is the Dirichlet
character at the norm.** -/
theorem onIdeals_ratDirichletEquiv_symm (ψ : DirichletCharacter ℂ n)
    (I : integralIdealsPrimeTo (ratModulus n hn)) :
    (((ratDirichletEquiv n hn).symm ψ).onIdeals I : ℂ) = ψ (Ideal.absNorm (I : Ideal (𝓞 ℚ))) := by
  rw [← ratDirichletEquiv_absNorm, MulEquiv.apply_symm_apply]

/-! ### Changing the modulus -/

/-- **Inducing from `(d)·∞` to `(n)·∞` is changing the level from `d` to `n`.** -/
@[simp]
theorem ratDirichletEquiv_induced {d : ℕ} {hd : d ≠ 0}
    (h : ratModulus d hd ∣ ratModulus n hn) (η : RayClassCharacter (ratModulus d hd)) :
    ratDirichletEquiv n hn (η.induced h) =
      changeLevel (ratModulus_dvd_ratModulus_iff.mp h) (ratDirichletEquiv d hd η) := by
  refine MulChar.ext fun u ↦ ?_
  have hc : classMap h ((ratModulusEquivZMod n hn).symm u) =
      (ratModulusEquivZMod d hd).symm
        (ZMod.unitsMap (ratModulus_dvd_ratModulus_iff.mp h) u) := by
    rw [MulEquiv.eq_symm_apply, ratModulusEquivZMod_classMap, MulEquiv.apply_symm_apply]
  rw [ratDirichletEquiv_apply_coe, RayClassCharacter.induced_apply, hc,
    changeLevel_eq_cast_of_dvd, ← ZMod.unitsMap_val, ratDirichletEquiv_apply_coe]

/-- **A Dirichlet character factors through `d` exactly when its ray class character is induced
from `(d)·∞`.** -/
theorem factorsThrough_ratDirichletEquiv_iff {d : ℕ} {hd : d ≠ 0}
    (h : ratModulus d hd ∣ ratModulus n hn) (η : RayClassCharacter (ratModulus n hn)) :
    (ratDirichletEquiv n hn η).FactorsThrough d ↔
      ∃ ψ : RayClassCharacter (ratModulus d hd), ψ.induced h = η := by
  constructor
  · rintro ⟨hdn, ψ₀, hψ₀⟩
    refine ⟨(ratDirichletEquiv d hd).symm ψ₀, (ratDirichletEquiv n hn).injective ?_⟩
    rw [ratDirichletEquiv_induced, MulEquiv.apply_symm_apply]
    exact hψ₀.symm
  · rintro ⟨ψ, rfl⟩
    exact ⟨ratModulus_dvd_ratModulus_iff.mp h, ratDirichletEquiv d hd ψ,
      ratDirichletEquiv_induced h ψ⟩

/-! ### Parity -/

/-- **The Dirichlet character at `-1` is the ray class character at the class of the sign `-1`.** -/
theorem ratDirichletEquiv_neg_one (η : RayClassCharacter (ratModulus n hn)) :
    ratDirichletEquiv n hn η (-1) =
      η (residueSignRayClass (ratModulus n hn) (1, fun _ ↦ -1)) := by
  have h := ratDirichletEquiv_apply_coe η (-1)
  rw [Units.val_neg, Units.val_one] at h
  rw [h, (MulEquiv.symm_apply_eq _).mpr ratModulusEquivZMod_residueSignRayClass_neg_one.symm]

/-- **A Dirichlet character is even exactly when its ray class character is trivial on the class of
the sign `-1` at the real place.** -/
theorem even_ratDirichletEquiv_iff (η : RayClassCharacter (ratModulus n hn)) :
    (ratDirichletEquiv n hn η).Even ↔
      η (residueSignRayClass (ratModulus n hn) (1, fun _ ↦ -1)) = 1 := by
  rw [DirichletCharacter.Even, ratDirichletEquiv_neg_one, Units.val_eq_one]

/-- **A Dirichlet character is even exactly when its ray class character is induced from the
modulus `(n)` without the real place.** -/
theorem even_ratDirichletEquiv_iff_exists_induced (h : ratFiniteModulus n hn ∣ ratModulus n hn)
    (η : RayClassCharacter (ratModulus n hn)) :
    (ratDirichletEquiv n hn η).Even ↔
      ∃ ψ : RayClassCharacter (ratFiniteModulus n hn), ψ.induced h = η := by
  rw [RayClassCharacter.exists_induced_eq_iff_of_finitePart_eq h (by simp),
    even_ratDirichletEquiv_iff]
  refine ⟨fun hη s _ ↦ ?_, fun hη ↦ hη _ fun w hw ↦ by simp at hw⟩
  -- The real place is the only element of the infinite part, so `s` is `1` or `-1` there.
  let w₀ : (ratModulus n hn).infinitePart :=
    ⟨⟨Rat.infinitePlace, Rat.isReal_infinitePlace⟩, by simp⟩
  rcases Int.units_eq_one_or (s w₀) with hs | hs
  · have hs' : s = 1 := funext fun w ↦ by rw [Subsingleton.elim w w₀, hs, Pi.one_apply]
    rw [hs', Prod.mk_one_one, map_one, map_one]
  · have hs' : s = fun _ ↦ -1 := funext fun w ↦ by rw [Subsingleton.elim w w₀, hs]
    rw [hs']
    exact hη

/-- **A Dirichlet character factors through `d` and is even exactly when its ray class character is
induced from the modulus `(d)` without the real place.** -/
theorem factorsThrough_and_even_ratDirichletEquiv_iff {d : ℕ} {hd : d ≠ 0}
    (h : ratFiniteModulus d hd ∣ ratModulus n hn) (η : RayClassCharacter (ratModulus n hn)) :
    (ratDirichletEquiv n hn η).FactorsThrough d ∧ (ratDirichletEquiv n hn η).Even ↔
      ∃ ψ : RayClassCharacter (ratFiniteModulus d hd), ψ.induced h = η := by
  have h₁ : ratFiniteModulus d hd ∣ ratModulus d hd := ratFiniteModulus_dvd_ratModulus
  have h₂ : ratModulus d hd ∣ ratModulus n hn :=
    ratModulus_dvd_ratModulus_iff.mpr (ratFiniteModulus_dvd_ratModulus_iff.mp h)
  rw [factorsThrough_ratDirichletEquiv_iff h₂]
  constructor
  · rintro ⟨⟨η', rfl⟩, heven⟩
    rw [ratDirichletEquiv_induced, even_changeLevel_iff,
      even_ratDirichletEquiv_iff_exists_induced h₁] at heven
    obtain ⟨ψ, rfl⟩ := heven
    exact ⟨ψ, (RayClassCharacter.induced_trans h₁ h₂ ψ).symm⟩
  · rintro ⟨ψ, rfl⟩
    have htrans : ψ.induced h = (ψ.induced h₁).induced h₂ :=
      (RayClassCharacter.induced_trans h₁ h₂ ψ).symm
    rw [htrans]
    refine ⟨⟨_, rfl⟩, ?_⟩
    rw [ratDirichletEquiv_induced, even_changeLevel_iff,
      even_ratDirichletEquiv_iff_exists_induced h₁]
    exact ⟨ψ, rfl⟩

/-! ### The conductor -/

namespace RayClassCharacter

variable (η : RayClassCharacter (ratModulus n hn))

/-- **The finite part of the conductor of a ray class character of `(n)·∞` has absolute norm the
conductor of its Dirichlet character.** -/
theorem absNorm_conductor_finitePart :
    Ideal.absNorm η.conductor.finitePart = (ratDirichletEquiv n hn η).conductor := by
  have : NeZero n := ⟨hn⟩
  have hspan : Ideal.span {(Ideal.absNorm η.conductor.finitePart : 𝓞 ℚ)} =
      η.conductor.finitePart := Rat.RingOfIntegers.ideal_span_absNorm_eq_self _
  have hd : Ideal.absNorm η.conductor.finitePart ≠ 0 := by
    rw [Ne, Ideal.absNorm_eq_zero_iff]
    exact η.conductor.finitePart_ne_bot
  generalize Ideal.absNorm η.conductor.finitePart = d at hspan hd ⊢
  -- The conductor divides `(m)·∞` exactly when the Dirichlet character factors through `m`.
  have hcond : ∀ {m : ℕ} (hm : m ≠ 0) (_ : ratModulus m hm ∣ ratModulus n hn),
      η.conductor ∣ ratModulus m hm ↔ (ratDirichletEquiv n hn η).FactorsThrough m :=
    fun _ h ↦ by rw [conductor_dvd_iff h, factorsThrough_ratDirichletEquiv_iff h]
  have hspan_dvd : ∀ {m : ℕ}, η.conductor.finitePart ∣ Ideal.span {(m : 𝓞 ℚ)} ↔ d ∣ m :=
    fun {m} ↦ by
      rw [← hspan, Ideal.span_singleton_dvd_span_singleton_iff_dvd,
        NumberField.RingOfIntegers.natCast_dvd_natCast]
  have hdn : d ∣ n := by
    have := (Modulus.dvd_iff.mp η.conductor_dvd).1
    rwa [ratModulus_finitePart, hspan_dvd] at this
  have hcd : η.conductor ∣ ratModulus d hd := by
    refine Modulus.dvd_iff.mpr ⟨by rw [ratModulus_finitePart, hspan_dvd], ?_⟩
    have := (Modulus.dvd_iff.mp η.conductor_dvd).2
    simpa only [ratModulus_infinitePart] using this
  refine Nat.dvd_antisymm ?_ ?_
  · -- The Dirichlet character factors through its conductor `f`, so the conductor of `η` divides
    -- `(f)·∞` and `d ∣ f`.
    have h := (hcond (conductor_ne_zero _)
      (ratModulus_dvd_ratModulus_iff.mpr (conductor_dvd_level _))).mpr
        (factorsThrough_conductor (ratDirichletEquiv n hn η))
    have := (Modulus.dvd_iff.mp h).1
    rwa [ratModulus_finitePart, hspan_dvd] at this
  · -- The conductor of `η` divides `(d)·∞`, so the Dirichlet character factors through `d`.
    exact conductor_dvd_of_mem_conductorSet _
      ((mem_conductorSet_iff _).mpr ((hcond hd (ratModulus_dvd_ratModulus_iff.mpr hdn)).mp hcd))

/-- **The finite part of the conductor of a ray class character of `(n)·∞` is generated by the
conductor of its Dirichlet character.** -/
theorem conductor_finitePart_eq_span :
    η.conductor.finitePart = Ideal.span {((ratDirichletEquiv n hn η).conductor : 𝓞 ℚ)} := by
  rw [← absNorm_conductor_finitePart, Rat.RingOfIntegers.ideal_span_absNorm_eq_self]

/-- **The conductor of a ray class character of `(n)·∞` omits the real place exactly when its
Dirichlet character is even.** -/
theorem conductor_infinitePart_eq_empty_iff_even :
    η.conductor.infinitePart = ∅ ↔ (ratDirichletEquiv n hn η).Even := by
  have : NeZero n := ⟨hn⟩
  have hf : ratFiniteModulus (ratDirichletEquiv n hn η).conductor (conductor_ne_zero _) ∣
      ratModulus n hn :=
    ratFiniteModulus_dvd_ratModulus_iff.mpr (conductor_dvd_level _)
  -- The conductor of `η` divides the finite modulus `(f)` exactly when the character is even.
  have key : η.conductor ∣ ratFiniteModulus _ (conductor_ne_zero (ratDirichletEquiv n hn η)) ↔
      (ratDirichletEquiv n hn η).Even := by
    rw [conductor_dvd_iff hf, ← factorsThrough_and_even_ratDirichletEquiv_iff hf,
      and_iff_right (factorsThrough_conductor _)]
  rw [← key, Modulus.dvd_iff, ratFiniteModulus_finitePart, ← conductor_finitePart_eq_span,
    ratFiniteModulus_infinitePart, Finset.subset_empty, and_iff_right dvd_rfl]

/-! ### Arbitrary moduli of `ℚ` -/

section ArbitraryModulus

variable {𝔪 𝔫 : Modulus ℚ}

/-- **The Dirichlet character of a ray class character of an arbitrary modulus of `ℚ`.** Every
modulus `𝔪` of `ℚ` divides `(N)·∞`, where `N = Ideal.absNorm 𝔪.finitePart`
(`dvd_ratModulus_absNorm`); inducing `ψ` to `(N)·∞` and applying `ratDirichletEquiv` produces a
complex Dirichlet character of level `N`. -/
noncomputable def toDirichletCharacter :
    RayClassCharacter 𝔪 →* DirichletCharacter ℂ (Ideal.absNorm 𝔪.finitePart) :=
  (ratDirichletEquiv (Ideal.absNorm 𝔪.finitePart) (NeZero.ne _)).toMonoidHom.comp
    (induced (dvd_ratModulus_absNorm 𝔪))

theorem toDirichletCharacter_def (ψ : RayClassCharacter 𝔪) :
    ψ.toDirichletCharacter = ratDirichletEquiv (Ideal.absNorm 𝔪.finitePart) (NeZero.ne _)
      (ψ.induced (dvd_ratModulus_absNorm 𝔪)) := (rfl)

/-- `toDirichletCharacter` is injective at every modulus of `ℚ`, including finite moduli without
the real place. -/
theorem toDirichletCharacter_injective :
    Function.Injective (toDirichletCharacter (𝔪 := 𝔪)) :=
  (ratDirichletEquiv _ _).injective.comp (induced_injective (dvd_ratModulus_absNorm 𝔪))

@[simp]
theorem toDirichletCharacter_eq_one_iff (ψ : RayClassCharacter 𝔪) :
    ψ.toDirichletCharacter = 1 ↔ ψ = 1 :=
  ⟨fun h ↦ toDirichletCharacter_injective (h.trans (map_one _).symm), fun h ↦ h ▸ map_one _⟩

/-- **At any modulus of `ℚ`, a ray class character at an integral ideal prime to the modulus is its
Dirichlet character at the absolute norm of the ideal.** -/
theorem toDirichletCharacter_absNorm (ψ : RayClassCharacter 𝔪) (I : integralIdealsPrimeTo 𝔪) :
    ψ.toDirichletCharacter (Ideal.absNorm (I : Ideal (𝓞 ℚ))) = (ψ.onIdeals I : ℂ) := by
  have hI : (I : Ideal (𝓞 ℚ)) ∈
      integralIdealsPrimeTo (ratModulus (Ideal.absNorm 𝔪.finitePart) (NeZero.ne _)) := by
    rw [NumberFieldArithmetic.mem_integralIdealsAway_iff, ratModulus_absNorm_support]
    exact NumberFieldArithmetic.mem_integralIdealsAway_iff.mp I.property
  have hincl : integralIdealsPrimeToInclusion (dvd_ratModulus_absNorm 𝔪) ⟨I, hI⟩ = I :=
    Subtype.ext (coe_integralIdealsPrimeToInclusion _ _)
  rw [toDirichletCharacter_def,
    ratDirichletEquiv_absNorm _ (⟨I, hI⟩ : integralIdealsPrimeTo _),
    onIdeals_induced, hincl]

/-- **Inducing between arbitrary moduli of `ℚ` is changing the level of `toDirichletCharacter`.** -/
theorem toDirichletCharacter_induced (h : 𝔪 ∣ 𝔫) (ψ : RayClassCharacter 𝔪) :
    (ψ.induced h).toDirichletCharacter =
      changeLevel (map_dvd Ideal.absNorm (Modulus.dvd_iff.mp h).1) ψ.toDirichletCharacter := by
  have h₁₂ : ratModulus (Ideal.absNorm 𝔪.finitePart) (NeZero.ne _) ∣
      ratModulus (Ideal.absNorm 𝔫.finitePart) (NeZero.ne _) :=
    ratModulus_dvd_ratModulus_iff.mpr (map_dvd Ideal.absNorm (Modulus.dvd_iff.mp h).1)
  have htrans : (ψ.induced h).induced (dvd_ratModulus_absNorm 𝔫) =
      (ψ.induced (dvd_ratModulus_absNorm 𝔪)).induced h₁₂ := by
    rw [induced_trans, induced_trans]
  rw [toDirichletCharacter_def, htrans, ratDirichletEquiv_induced, ← toDirichletCharacter_def]

/-- At `(n)·∞`, `toDirichletCharacter` agrees with `ratDirichletEquiv` along the canonical equality
`Ideal.absNorm (ratModulus n hn).finitePart = n`. -/
theorem changeLevel_toDirichletCharacter_ratModulus :
    changeLevel (dvd_of_eq (absNorm_ratModulus_finitePart n hn)) η.toDirichletCharacter =
      ratDirichletEquiv n hn η := by
  have h₁ : ratModulus (Ideal.absNorm (ratModulus n hn).finitePart) (NeZero.ne _) ∣
      ratModulus n hn :=
    ratModulus_dvd_ratModulus_iff.mpr (dvd_of_eq (absNorm_ratModulus_finitePart n hn))
  rw [toDirichletCharacter_def, ← ratDirichletEquiv_induced h₁, induced_trans, induced_refl]

@[simp]
theorem toDirichletCharacter_ratModulus_intCast (m : ℤ) :
    η.toDirichletCharacter m = ratDirichletEquiv n hn η m := by
  refine apply_intCast_eq_of_forall_isCoprime (absNorm_ratModulus_finitePart n hn)
    (fun a ha ↦ ?_) m
  have ha' : IsCoprime a n := by rwa [absNorm_ratModulus_finitePart] at ha
  rw [← changeLevel_toDirichletCharacter_ratModulus (η := η),
    changeLevel_eq_cast_of_dvd' _ _ ha']

@[simp]
theorem toDirichletCharacter_ratModulus_natCast (m : ℕ) :
    η.toDirichletCharacter m = ratDirichletEquiv n hn η m := by
  simpa only [Int.cast_natCast] using toDirichletCharacter_ratModulus_intCast η (m : ℤ)

theorem toDirichletCharacter_ratDirichletEquiv_symm_intCast (χ : DirichletCharacter ℂ n) (m : ℤ) :
    ((ratDirichletEquiv n hn).symm χ).toDirichletCharacter m = χ m := by
  rw [toDirichletCharacter_ratModulus_intCast, MulEquiv.apply_symm_apply]

theorem toDirichletCharacter_ratDirichletEquiv_symm_natCast (χ : DirichletCharacter ℂ n) (m : ℕ) :
    ((ratDirichletEquiv n hn).symm χ).toDirichletCharacter m = χ m := by
  rw [toDirichletCharacter_ratModulus_natCast, MulEquiv.apply_symm_apply]

/-- **The conductor of `ψ.toDirichletCharacter` is the absolute norm of the finite part of
`ψ.conductor`**, for every modulus `𝔪` of `ℚ`. -/
@[simp]
theorem conductor_toDirichletCharacter (ψ : RayClassCharacter 𝔪) :
    ψ.toDirichletCharacter.conductor = Ideal.absNorm ψ.conductor.finitePart := by
  rw [toDirichletCharacter_def, ← absNorm_conductor_finitePart, conductor_induced]

/-- **The conductor of `ψ` omits the real place exactly when `ψ.toDirichletCharacter` is even.** -/
theorem conductor_infinitePart_eq_empty_iff_even_toDirichletCharacter (ψ : RayClassCharacter 𝔪) :
    ψ.conductor.infinitePart = ∅ ↔ ψ.toDirichletCharacter.Even := by
  rw [toDirichletCharacter_def, ← conductor_infinitePart_eq_empty_iff_even, conductor_induced]

/-- Every ray class character of a modulus of `ℚ` without the real place corresponds to an even
Dirichlet character. -/
theorem even_toDirichletCharacter_of_infinitePart_eq_empty (h : 𝔪.infinitePart = ∅)
    (ψ : RayClassCharacter 𝔪) : ψ.toDirichletCharacter.Even := by
  rw [← conductor_infinitePart_eq_empty_iff_even_toDirichletCharacter, ← Finset.subset_empty, ← h]
  exact (Modulus.dvd_iff.mp ψ.conductor_dvd).2

/-- When the Dirichlet character of `ψ : RayClassCharacter 𝔪` is even, the conductor of `ψ` is
the finite modulus `(ψ.toDirichletCharacter.conductor)` without the real place. -/
theorem conductor_eq_ratFiniteModulus_of_even (ψ : RayClassCharacter 𝔪)
    (h : ψ.toDirichletCharacter.Even) :
    ψ.conductor = ratFiniteModulus ψ.toDirichletCharacter.conductor (conductor_ne_zero _) :=
  Modulus.ext
    (by rw [ratFiniteModulus_finitePart, conductor_toDirichletCharacter,
      Rat.RingOfIntegers.ideal_span_absNorm_eq_self])
    ((ψ.conductor_infinitePart_eq_empty_iff_even_toDirichletCharacter.mpr h).trans
      (ratFiniteModulus_infinitePart _ _).symm)

/-- When the Dirichlet character of `ψ : RayClassCharacter 𝔪` is odd, the conductor of `ψ` is the
modulus `(ψ.toDirichletCharacter.conductor)·∞` including the real place. -/
theorem conductor_eq_ratModulus_of_not_even (ψ : RayClassCharacter 𝔪)
    (h : ¬ ψ.toDirichletCharacter.Even) :
    ψ.conductor = ratModulus ψ.toDirichletCharacter.conductor (conductor_ne_zero _) := by
  have hne : ψ.conductor.infinitePart ≠ ∅ :=
    ψ.conductor_infinitePart_eq_empty_iff_even_toDirichletCharacter.not.mpr h
  refine Modulus.ext
    (by rw [ratModulus_finitePart, conductor_toDirichletCharacter,
      Rat.RingOfIntegers.ideal_span_absNorm_eq_self]) ?_
  simpa only [ratModulus_infinitePart] using
    (congrArg Modulus.infinitePart (eq_ratModulus_of_infinitePart_ne_empty hne)).trans
      (ratModulus_infinitePart _ _)

/-- **The image of `toDirichletCharacter`**: at level `Ideal.absNorm 𝔪.finitePart`, a Dirichlet
character lies in the range of `toDirichletCharacter` exactly when `𝔪` contains the real place or
the Dirichlet character is even. -/
theorem mem_range_toDirichletCharacter_iff
    (χ : DirichletCharacter ℂ (Ideal.absNorm 𝔪.finitePart)) :
    χ ∈ (toDirichletCharacter (𝔪 := 𝔪)).range ↔ 𝔪.infinitePart ≠ ∅ ∨ χ.Even := by
  constructor
  · rintro ⟨ψ, rfl⟩
    by_cases h0 : 𝔪.infinitePart = ∅
    · exact Or.inr (even_toDirichletCharacter_of_infinitePart_eq_empty h0 ψ)
    · exact Or.inl h0
  · intro h
    by_cases h0 : 𝔪.infinitePart = ∅
    · have heven : χ.Even := h.resolve_left (not_not.mpr h0)
      have hfin : ratFiniteModulus (Ideal.absNorm 𝔪.finitePart) (NeZero.ne _) ∣
          ratModulus (Ideal.absNorm 𝔪.finitePart) (NeZero.ne _) :=
        ratFiniteModulus_dvd_ratModulus
      have hmod : ratFiniteModulus (Ideal.absNorm 𝔪.finitePart) (NeZero.ne _) ∣ 𝔪 := by
        conv_rhs => rw [eq_ratFiniteModulus_of_infinitePart_eq_empty h0]
      have hχ : (ratDirichletEquiv _ (NeZero.ne _)
          ((ratDirichletEquiv _ (NeZero.ne _)).symm χ)).Even := by
        simpa only [MulEquiv.apply_symm_apply] using heven
      obtain ⟨ψ₀, hψ₀⟩ := (even_ratDirichletEquiv_iff_exists_induced hfin _).mp hχ
      refine ⟨ψ₀.induced hmod, ?_⟩
      rw [toDirichletCharacter_def, induced_trans, hψ₀, MulEquiv.apply_symm_apply]
    · have hmod : ratModulus (Ideal.absNorm 𝔪.finitePart) (NeZero.ne _) ∣ 𝔪 := by
        conv_rhs => rw [eq_ratModulus_of_infinitePart_ne_empty h0]
      refine ⟨((ratDirichletEquiv _ (NeZero.ne _)).symm χ).induced hmod, ?_⟩
      rw [toDirichletCharacter_def, induced_trans, induced_refl, MulEquiv.apply_symm_apply]

/-- **At a modulus of `ℚ` without the real place, a ray class character is primitive exactly when
its Dirichlet character is primitive.** -/
theorem isPrimitive_iff_of_infinitePart_eq_empty (h : 𝔪.infinitePart = ∅)
    (ψ : RayClassCharacter 𝔪) :
    ψ.IsPrimitive ↔ ψ.toDirichletCharacter.IsPrimitive := by
  have hinf : ψ.conductor.infinitePart = 𝔪.infinitePart := by
    rw [h, ← Finset.subset_empty, ← h]
    exact (Modulus.dvd_iff.mp ψ.conductor_dvd).2
  rw [isPrimitive_iff_conductor_eq, Modulus.ext_iff, and_iff_left hinf, isPrimitive_def,
    conductor_toDirichletCharacter]
  refine ⟨fun hfin ↦ congrArg Ideal.absNorm hfin, fun hnorm ↦ ?_⟩
  rw [← Rat.RingOfIntegers.ideal_span_absNorm_eq_self ψ.conductor.finitePart,
    ← Rat.RingOfIntegers.ideal_span_absNorm_eq_self 𝔪.finitePart, hnorm]

/-- **At a modulus of `ℚ` containing the real place, a ray class character is primitive exactly
when its Dirichlet character is primitive and odd.** -/
theorem isPrimitive_iff_of_infinitePart_ne_empty (h : 𝔪.infinitePart ≠ ∅)
    (ψ : RayClassCharacter 𝔪) :
    ψ.IsPrimitive ↔ ψ.toDirichletCharacter.IsPrimitive ∧ ¬ ψ.toDirichletCharacter.Even := by
  rw [isPrimitive_iff_conductor_eq, Modulus.ext_iff, isPrimitive_def,
    conductor_toDirichletCharacter, ← conductor_infinitePart_eq_empty_iff_even_toDirichletCharacter]
  refine and_congr ?_ ?_
  · refine ⟨fun hfin ↦ congrArg Ideal.absNorm hfin, fun hnorm ↦ ?_⟩
    rw [← Rat.RingOfIntegers.ideal_span_absNorm_eq_self ψ.conductor.finitePart,
      ← Rat.RingOfIntegers.ideal_span_absNorm_eq_self 𝔪.finitePart, hnorm]
  · refine ⟨fun hinf h0 ↦ h (hinf ▸ h0), fun hne ↦ ?_⟩
    obtain ⟨w, hw⟩ := Finset.ne_empty_iff_nonempty.mp hne
    obtain ⟨v, hv⟩ := Finset.ne_empty_iff_nonempty.mp h
    ext u
    exact ⟨fun _ ↦ Subtype.ext (Subsingleton.elim u.val v.val) ▸ hv,
      fun _ ↦ Subtype.ext (Subsingleton.elim u.val w.val) ▸ hw⟩

end ArbitraryModulus

