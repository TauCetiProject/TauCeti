/-!
# The narrow Picard group of an order as a quotient of a ray class group

Let `O` be an order in a number field `K` with conductor `𝔣`, and let `𝔣∞` be the modulus with
finite part `𝔣` and every real place (`NumberFieldOrder.narrowConductorModulus`). Taking the
narrow Picard class of the contraction `J ∩ O` of an ideal `J` of `𝓞 K` prime to `𝔣` gives a
monoid homomorphism `NumberFieldOrder.narrowPicClass` to `NarrowPic O`.

Its kernel consists of the principal ideals `β 𝓞 K` with a totally positive generator `β ∈ O`. In
particular the ideals with a totally positive generator `β ≡ 1 mod 𝔣` die in `NarrowPic O`, so
`narrowPicClass` factors through the ray class group of `𝔣∞`. The result is the **congruence
description** of the narrow Picard group of an order:

`NarrowPic O ≃ I_K(𝔣) / P⁺_{K,O}(𝔣)`,

where `I_K(𝔣)` is the group of fractional ideals of `𝓞 K` prime to `𝔣` and `P⁺_{K,O}(𝔣)` is its
subgroup generated by the principal ideals `β 𝓞 K` with `β ∈ O` totally positive and coprime to
`𝔣`. Here it is stated as the surjective homomorphism `NumberFieldOrder.rayClassToNarrowPic` from
the ray class group of `𝔣∞`, whose kernel is the image of `P⁺_{K,O}(𝔣)`. Since that ray class
group is finite, so is `NarrowPic O`.

Forgetting positivity, `rayClassToNarrowPic` lies over `NumberFieldOrder.rayClassToPic`, the
corresponding description of the wide Picard group. Surjectivity reduces to that of the wide map
and to realizing every principal narrow class, which depends only on the signs of a generator at
the real places, by a nonzero algebraic integer congruent to one modulo `𝔣`. The latter is weak
approximation at the primes dividing `𝔣` together with all real places.

## Main definitions

* `TauCeti.GlobalNumberFields.NumberFieldOrder.narrowConductorModulus`: the conductor of an order
  together with every real place, as a modulus.
* `TauCeti.GlobalNumberFields.NumberFieldOrder.narrowPicClass`: the narrow Picard class of the
  contraction of an ideal of `𝓞 K` prime to the conductor.
* `TauCeti.GlobalNumberFields.NumberFieldOrder.rayClassToNarrowPic`: the surjection from the ray
  class group of the narrow conductor modulus onto `NarrowPic O`.

## Main results

* `TauCeti.GlobalNumberFields.NumberFieldOrder.narrowPicClass_eq_one_iff`: an ideal of `𝓞 K` prime
  to the conductor has trivial narrow Picard class exactly when it is generated by a totally
  positive element of the order.
* `TauCeti.GlobalNumberFields.NumberFieldOrder.rayClassToNarrowPic_surjective`: every narrow
  Picard class comes from a ray class of the narrow conductor modulus.
* `TauCeti.GlobalNumberFields.NumberFieldOrder.mem_ker_rayClassToNarrowPic`: the kernel of
  `rayClassToNarrowPic` consists of the ray classes of the ideals generated by totally positive
  elements of `O`.
* `TauCeti.GlobalNumberFields.NumberFieldOrder.narrowToPic_comp_rayClassToNarrowPic`: forgetting
  positivity, `rayClassToNarrowPic` lies over `rayClassToPic`.
* `TauCeti.GlobalNumberFields.NumberFieldOrder.finite_narrowPic`: the narrow Picard group of an
  order is finite.

## References

* G. S. Kopp and J. C. Lagarias, *Class Field Theory for Orders of Number Fields*, §2.
* D. A. Cox, *Primes of the Form x² + ny²*, §7 (the quadratic case).
-/

public section
noncomputable section

open NumberField
open scoped nonZeroDivisors

namespace TauCeti.GlobalNumberFields

namespace NumberFieldOrder

variable {K : Type*} [Field K] [NumberField K] (O : NumberFieldOrder K)

/-! ### The narrow conductor modulus -/

/-- The conductor of an order as a modulus of `K` together with **every** real place. Its ray
class group surjects onto the narrow Picard group of the order. -/
def narrowConductorModulus : Modulus K where
  finitePart := O.conductor
  finitePart_ne_bot := O.conductor_ne_bot
  infinitePart := (narrowModulus K).infinitePart

@[simp]
theorem narrowConductorModulus_finitePart : O.narrowConductorModulus.finitePart = O.conductor :=
  (rfl)

@[simp]
theorem mem_narrowConductorModulus_infinitePart (w : {w : InfinitePlace K // w.IsReal}) :
    w ∈ O.narrowConductorModulus.infinitePart :=
  mem_narrowModulus_infinitePart w

/-- The conductor modulus divides the narrow conductor modulus: they have the same finite part,
and the latter has more real places. -/
theorem conductorModulus_dvd_narrowConductorModulus :
    O.conductorModulus ∣ O.narrowConductorModulus :=
  Modulus.dvd_iff.mpr ⟨by simp, by simp⟩

/-- The narrow conductor modulus of the maximal order is the narrow modulus. -/
@[simp]
theorem narrowConductorModulus_maximalNumberFieldOrder :
    (maximalNumberFieldOrder K).narrowConductorModulus = narrowModulus K :=
  Modulus.ext (by simp) (rfl)

/-! ### Narrow Picard classes of ideals prime to the conductor -/

/-- The narrow Picard class of an ideal `J` of `𝓞 K` prime to the conductor: the class in
`NarrowPic O` of its contraction `J ∩ O`, an invertible ideal of `O`. -/
def narrowPicClass : integralIdealsPrimeTo O.narrowConductorModulus →* NarrowPic O :=
  (NarrowPic.mk O).comp (O.integralIdealsAwayConductorToInvertible.comp
    (O.integralIdealsAwayConductorEquiv.symm.toMonoidHom.comp
      (integralIdealsPrimeToInclusion O.conductorModulus_dvd_narrowConductorModulus)))

/-- The narrow Picard class of `J` is the narrow class of its contraction to the order. -/
theorem narrowPicClass_apply (J : integralIdealsPrimeTo O.narrowConductorModulus) :
    O.narrowPicClass J = NarrowPic.mk O (O.integralIdealsAwayConductorToInvertible
      (O.integralIdealsAwayConductorEquiv.symm
        (integralIdealsPrimeToInclusion O.conductorModulus_dvd_narrowConductorModulus J))) :=
  (rfl)

/-- Forgetting positivity, the narrow Picard class of `J` is its Picard class. -/
@[simp]
theorem narrowToPic_narrowPicClass (J : integralIdealsPrimeTo O.narrowConductorModulus) :
    O.narrowToPic (O.narrowPicClass J) = O.picClass
      (integralIdealsPrimeToInclusion O.conductorModulus_dvd_narrowConductorModulus J) := by
  rw [narrowPicClass_apply, narrowToPic_mk, picClass_apply]

/-- An ideal of `𝓞 K` prime to the conductor and generated by an element `β` of the order has the
narrow Picard class of the principal ideal `β O`. -/
theorem narrowPicClass_eq_mkPrincipal {J : integralIdealsPrimeTo O.narrowConductorModulus}
    {β : 𝓞 K} (hβ : β ∈ O.toRingOfIntegers) {x : Kˣ} (hx : (x : K) = β)
    (hJ : (J : Ideal (𝓞 K)) = Ideal.span {β}) :
    O.narrowPicClass J = NarrowPic.mkPrincipal O x := by
  rw [narrowPicClass_apply, NarrowPic.mkPrincipal_apply]
  congr 1
  refine Units.ext ?_
  rw [O.coe_integralIdealsAwayConductorToInvertible_eq_spanSingleton hβ
    (by rw [MulEquiv.apply_symm_apply, coe_integralIdealsPrimeToInclusion, hJ]),
    coe_toPrincipalIdeal, hx]

/-- **The kernel of the narrow Picard class map.** An ideal of `𝓞 K` prime to the conductor has
trivial narrow Picard class exactly when it is generated by a totally positive element of the
order. -/
theorem narrowPicClass_eq_one_iff (J : integralIdealsPrimeTo O.narrowConductorModulus) :
    O.narrowPicClass J = 1 ↔
      ∃ β ∈ O.toRingOfIntegers, IsTotallyPositive (β : K) ∧ (J : Ideal (𝓞 K)) = Ideal.span {β} := by
  constructor
  · intro h
    -- Forgetting positivity, `J` is generated by an element `β` of the order.
    have hpic := congrArg O.narrowToPic h
    rw [narrowToPic_narrowPicClass, map_one, picClass_eq_one_iff,
      coe_integralIdealsPrimeToInclusion] at hpic
    obtain ⟨β, hβ, hJ⟩ := hpic
    obtain ⟨x, hx⟩ : ∃ x : Kˣ, (x : K) = β := ⟨Units.mk0 _
      (RingOfIntegers.coe_ne_zero_iff.mpr (ne_zero_of_coe_eq_span_singleton hJ)), rfl⟩
    -- An order unit `w` makes the generator totally positive.
    rw [O.narrowPicClass_eq_mkPrincipal hβ hx hJ, NarrowPic.mkPrincipal_eq_one_iff] at h
    obtain ⟨w, hw⟩ := h
    let u : (𝓞 K)ˣ := Units.map ((O.toRingOfIntegers.val : O.toRingOfIntegers →+* 𝓞 K).comp
      O.toRingOfIntegersEquiv.symm.toRingHom).toMonoidHom w
    have hu : ((u : 𝓞 K) : K) = (w : K) := by
      simp [u, Units.coe_map, O.coe_toRingOfIntegersEquiv_symm]
    refine ⟨u * β, O.toRingOfIntegers.mul_mem (O.toRingOfIntegersEquiv.symm w).2 hβ, ?_, ?_⟩
    · have huβ : (((u * β : 𝓞 K)) : K) = (w : K) * (x : K) := by simp [hx, hu]
      simpa only [huβ, Units.smul_def, Subalgebra.smul_def, smul_eq_mul] using hw
    · rw [hJ, Ideal.span_singleton_mul_left_unit u.isUnit]
  · rintro ⟨β, hβ, hpos, hJ⟩
    obtain ⟨x, hx⟩ : ∃ x : Kˣ, (x : K) = β := ⟨Units.mk0 _
      (RingOfIntegers.coe_ne_zero_iff.mpr (ne_zero_of_coe_eq_span_singleton hJ)), rfl⟩
    rw [O.narrowPicClass_eq_mkPrincipal hβ hx hJ]
    exact NarrowPic.mkPrincipal_eq_one_of_isTotallyPositive O (hx ▸ hpos)

/-- An ideal of `𝓞 K` with trivial ray class modulo the narrow conductor modulus has trivial narrow
Picard class: it is generated by a totally positive element congruent to one modulo the conductor,
and such an element lies in the order. -/
theorem narrowPicClass_eq_one_of_idealClass_eq_one
    (J : integralIdealsPrimeTo O.narrowConductorModulus)
    (hJ : idealClass O.narrowConductorModulus J = 1) : O.narrowPicClass J = 1 := by
  obtain ⟨α, hα, hpos, hJα⟩ := (idealClass_eq_one_iff_exists_generator J).mp hJ
  rw [narrowConductorModulus_finitePart] at hα
  exact (O.narrowPicClass_eq_one_iff J).mpr ⟨α, O.mem_toRingOfIntegers_of_sub_one_mem_conductor hα,
    isTotallyPositive_iff.mpr fun w hw ↦ hpos ⟨w, hw⟩ (O.mem_narrowConductorModulus_infinitePart _),
    hJα⟩

/-! ### The narrow Picard group as a quotient of a ray class group -/

/-- **The narrow Picard group of an order as a quotient of a ray class group.** The homomorphism
from the ray class group of the narrow conductor modulus onto `NarrowPic O` sending the ray class
of an ideal `J` of `𝓞 K` prime to the conductor to the narrow Picard class of its contraction
`J ∩ O`. -/
def rayClassToNarrowPic : RayClassGroup O.narrowConductorModulus →* NarrowPic O :=
  idealClassLift O.narrowPicClass O.narrowPicClass_eq_one_of_idealClass_eq_one

/-- The ray class of `J` maps to the narrow Picard class of its contraction to the order. -/
@[simp]
theorem rayClassToNarrowPic_idealClass (J : integralIdealsPrimeTo O.narrowConductorModulus) :
    O.rayClassToNarrowPic (idealClass O.narrowConductorModulus J) = O.narrowPicClass J :=
  idealClassLift_idealClass _ _ J

/-- Composing `rayClassToNarrowPic` with the ray class map gives the narrow Picard class map. -/
theorem rayClassToNarrowPic_comp_idealClass :
    O.rayClassToNarrowPic.comp (idealClass O.narrowConductorModulus) = O.narrowPicClass :=
  idealClassLift_comp_idealClass _ _

/-- **Forgetting positivity.** The narrow description of `NarrowPic O` lies over the description
of `Pic O`: the square formed with `narrowToPic` and the transition map `classMap` commutes. -/
theorem narrowToPic_comp_rayClassToNarrowPic :
    O.narrowToPic.comp O.rayClassToNarrowPic =
      O.rayClassToPic.comp (classMap O.conductorModulus_dvd_narrowConductorModulus) := by
  ext J
  simp

/-- Every principal narrow Picard class is the narrow Picard class of a principal ideal of `𝓞 K`
with a generator congruent to one modulo the conductor. -/
private theorem exists_narrowPicClass_eq_mkPrincipal (y : Kˣ) :
    ∃ J, O.narrowPicClass J = NarrowPic.mkPrincipal O y := by
  -- Weak approximation: an element congruent to one modulo the conductor with the signs of `y`.
  obtain ⟨x, hx1, hxy⟩ := exists_fieldUnit_valuation_sub_lt_and_signHom_eq
    (S := O.conductorModulus.support) (fun _ ↦ 1)
    (fun v ↦ WithZero.exp (-(O.conductorModulus.exponent v : ℤ)))
    (fun _ _ ↦ WithZero.exp_ne_zero) (signHom y)
  have hx : IsCongrOne O.conductorModulus x := isCongrOne_iff.mpr
    ⟨fun v hv ↦ (hx1 v ((Modulus.mem_support_iff _ v).mpr hv)).le, by simp⟩
  -- Clear its denominator by a totally positive algebraic integer.
  obtain ⟨a, b, ha, -, hb0, hbpos, hab⟩ :=
    hx.exists_sub_one_mem_and_ne_zero_and_isTotallyPositive_and_algebraMap_eq_mul
  have hb : (b : K) ≠ 0 := RingOfIntegers.coe_ne_zero_iff.mpr hb0
  have ha0 : (a : K) ≠ 0 := by
    rw [RingOfIntegers.coe_eq_algebraMap, hab]
    exact mul_ne_zero hb x.ne_zero
  rw [conductorModulus_finitePart] at ha
  -- The class of `y` is that of `a`, since `a / y` is totally positive.
  have hya : NarrowPic.mkPrincipal O y = NarrowPic.mkPrincipal O (Units.mk0 _ ha0) := by
    have hpos : IsTotallyPositive (((Units.mk0 _ ha0 * y⁻¹ : Kˣ)) : K) := by
      have hsign : signHom (Units.mk0 _ ha0 * y⁻¹) = 1 := by
        have hax : Units.mk0 _ ha0 = Units.mk0 _ hb * x :=
          Units.ext (by
            simpa only [Units.val_mul, Units.val_mk0, RingOfIntegers.coe_eq_algebraMap] using hab)
        rw [hax, map_mul, map_mul, hxy, (signHom_eq_one_iff _).mpr hbpos, map_inv, one_mul,
          mul_inv_cancel]
      exact (signHom_eq_one_iff _).mp hsign
    rw [eq_comm, ← mul_inv_eq_one, ← map_inv, ← map_mul]
    exact NarrowPic.mkPrincipal_eq_one_of_isTotallyPositive O hpos
  -- The ideal `(a)` is prime to the conductor, and `a` lies in the order.
  have hJ : Ideal.span {a} ∈ integralIdealsPrimeTo O.narrowConductorModulus := by
    refine Modulus.mem_integralIdealsPrimeTo.mpr (Modulus.isCoprimeTo_iff_sup_eq_top.mpr
      ⟨fun h ↦ RingOfIntegers.coe_ne_zero_iff.mp ha0 (Ideal.span_singleton_eq_bot.mp h), ?_⟩)
    rw [narrowConductorModulus_finitePart, Ideal.eq_top_iff_one]
    simpa using Ideal.sub_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton_self a))
      (Ideal.mem_sup_right ha)
  exact ⟨⟨_, hJ⟩, hya ▸ O.narrowPicClass_eq_mkPrincipal
    (O.mem_toRingOfIntegers_of_sub_one_mem_conductor ha) rfl rfl⟩

/-- **Every narrow Picard class comes from a ray class of the narrow conductor modulus.** -/
theorem rayClassToNarrowPic_surjective : Function.Surjective O.rayClassToNarrowPic := by
  intro c
  -- Match the wide class of `c` by a ray class `d`; the quotient lies in the kernel of
  -- `narrowToPic`, which consists of principal classes.
  obtain ⟨p, hp⟩ := O.rayClassToPic_surjective (O.narrowToPic c)
  obtain ⟨d, rfl⟩ := classMap_surjective O.conductorModulus_dvd_narrowConductorModulus p
  have hk : c * (O.rayClassToNarrowPic d)⁻¹ ∈ O.narrowToPic.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, ← MonoidHom.comp_apply,
      narrowToPic_comp_rayClassToNarrowPic, MonoidHom.comp_apply, hp, mul_inv_cancel]
  rw [narrowToPic_ker] at hk
  obtain ⟨y, hy⟩ := hk
  obtain ⟨J, hJ⟩ := O.exists_narrowPicClass_eq_mkPrincipal y
  refine ⟨idealClass O.narrowConductorModulus J * d, ?_⟩
  rw [map_mul, rayClassToNarrowPic_idealClass, hJ, hy, inv_mul_cancel_right]

/-- Every class of `NarrowPic O` is the narrow Picard class of an ideal of `𝓞 K` prime to the
conductor. -/
theorem narrowPicClass_surjective : Function.Surjective O.narrowPicClass := by
  rw [← rayClassToNarrowPic_comp_idealClass, MonoidHom.coe_comp]
  exact O.rayClassToNarrowPic_surjective.comp (idealClass_surjective _)

/-- **The congruence description of the narrow Picard group.** A ray class of the narrow conductor
modulus maps to the trivial narrow Picard class exactly when it is the ray class of an ideal of
`𝓞 K` generated by a totally positive element of the order. -/
theorem mem_ker_rayClassToNarrowPic {c : RayClassGroup O.narrowConductorModulus} :
    c ∈ O.rayClassToNarrowPic.ker ↔ ∃ J : integralIdealsPrimeTo O.narrowConductorModulus,
      idealClass O.narrowConductorModulus J = c ∧
        ∃ β ∈ O.toRingOfIntegers, IsTotallyPositive (β : K) ∧
          (J : Ideal (𝓞 K)) = Ideal.span {β} := by
  simp only [rayClassToNarrowPic, mem_ker_idealClassLift, narrowPicClass_eq_one_iff]

/-- **The narrow Picard group of an order is finite**, being a quotient of the finite ray class
group of its narrow conductor modulus. -/
instance finite_narrowPic : Finite (NarrowPic O) :=
  Finite.of_surjective _ O.rayClassToNarrowPic_surjective

end NumberFieldOrder

end TauCeti.GlobalNumberFields
