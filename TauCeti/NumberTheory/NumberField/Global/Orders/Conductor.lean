module

public import TauCeti.NumberTheory.NumberField.Global.Orders.Basic
public import TauCeti.RingTheory.Conductor

/-!
# The conductor of a number-field order

The conductor of an order `O` is the largest ideal of the maximal order contained in `O`.
Equivalently, it consists of the algebraic integers `x` for which `x * y` belongs to `O` for
every algebraic integer `y`. This ideal controls the primes where extension and contraction of
ideals between `O` and the maximal order can fail to be inverse.

The conductor here belongs to an arbitrary order. Mathlib's `conductor ℤ x` describes only the
monogenic order generated by one element. It is defined as the general conductor
`Subring.conductor` of the copy of `O` inside the maximal order, and its basic laws are
specializations of that API.

## References

* G. S. Kopp and J. C. Lagarias, *Class Field Theory for Orders of Number Fields*, §2.
-/

public section
noncomputable section

open NumberField

namespace TauCeti.GlobalNumberFields

namespace NumberFieldOrder

variable {K : Type*} [Field K] [NumberField K]

/-- The largest ideal of `𝓞 K` whose elements all lie in the order `O`: the conductor
`Subring.conductor` of the copy `O.toRingOfIntegers` of `O` inside `𝓞 K`. -/
def conductor (O : NumberFieldOrder K) : Ideal (𝓞 K) :=
  O.toRingOfIntegers.toSubring.conductor

/-- The conductor of an order is the conductor of its copy inside `𝓞 K`. Under the module system
the body of `conductor` is not exported, so this is how importers unfold it. -/
theorem conductor_eq_conductor_toRingOfIntegers (O : NumberFieldOrder K) :
    O.conductor = O.toRingOfIntegers.toSubring.conductor :=
  (rfl)

/-- An algebraic integer is in the conductor exactly when all of its multiples by algebraic
integers lie in the order. -/
@[simp]
theorem mem_conductor_iff (O : NumberFieldOrder K) (x : 𝓞 K) :
    x ∈ O.conductor ↔ ∀ y : 𝓞 K, (x : K) * (y : K) ∈ O.toSubalgebra := by
  simp [conductor_eq_conductor_toRingOfIntegers]

/-- The conductor is contained in the order. -/
theorem conductor_le_order (O : NumberFieldOrder K) {x : 𝓞 K}
    (hx : x ∈ O.conductor) : (x : K) ∈ O.toSubalgebra :=
  O.mem_toRingOfIntegers.mp (Subring.mem_of_mem_conductor hx)

/-- The conductor, as a set of algebraic integers, is contained in the order. -/
theorem conductor_le_toRingOfIntegers (O : NumberFieldOrder K) :
    (O.conductor : Set (𝓞 K)) ⊆ O.toRingOfIntegers :=
  Subring.coe_conductor_subset _

/-- An algebraic integer congruent to one modulo the conductor lies in the order. -/
theorem mem_toRingOfIntegers_of_sub_one_mem_conductor (O : NumberFieldOrder K) {α : 𝓞 K}
    (hα : α - 1 ∈ O.conductor) : α ∈ O.toRingOfIntegers := by
  simpa using O.toRingOfIntegers.add_mem (O.conductor_le_toRingOfIntegers hα)
    O.toRingOfIntegers.one_mem

/-- An algebraic integer congruent to an element of the order modulo the conductor lies in the
order. -/
theorem mem_toRingOfIntegers_of_mk_eq (O : NumberFieldOrder K) {α β : 𝓞 K}
    (hβ : β ∈ O.toRingOfIntegers)
    (h : Ideal.Quotient.mk O.conductor α = Ideal.Quotient.mk O.conductor β) :
    α ∈ O.toRingOfIntegers := by
  simpa using O.toRingOfIntegers.add_mem
    (O.conductor_le_toRingOfIntegers (Ideal.Quotient.eq.mp h)) hβ

/-- Every maximal-order ideal contained in an order lies in its conductor. -/
theorem le_conductor_iff (O : NumberFieldOrder K) (I : Ideal (𝓞 K)) :
    I ≤ O.conductor ↔ ∀ x : 𝓞 K, x ∈ I → (x : K) ∈ O.toSubalgebra := by
  simp [conductor_eq_conductor_toRingOfIntegers, Subring.le_conductor_iff, Set.subset_def]

/-- Enlarging an order enlarges its conductor ideal in the maximal order. -/
theorem conductor_mono {O O' : NumberFieldOrder K}
    (h : O.toSubalgebra ≤ O'.toSubalgebra) : O.conductor ≤ O'.conductor :=
  Subring.conductor_mono (toRingOfIntegers_le_toRingOfIntegers_iff.mpr h)

/-- The conductor of an order is the unit ideal exactly when its copy inside `𝓞 K` is all of
`𝓞 K`. -/
theorem conductor_eq_top_iff_toRingOfIntegers_eq_top (O : NumberFieldOrder K) :
    O.conductor = ⊤ ↔ O.toRingOfIntegers = ⊤ := by
  rw [conductor_eq_conductor_toRingOfIntegers, Subring.conductor_eq_top_iff,
    Algebra.toSubring_eq_top]

/-- The conductor of the maximal order is the unit ideal. -/
@[simp]
theorem conductor_maximal : (maximalNumberFieldOrder K).conductor = ⊤ :=
  (conductor_eq_top_iff_toRingOfIntegers_eq_top _).mpr <|
    eq_top_iff.mpr fun y _ ↦ by
      rw [mem_toRingOfIntegers, maximalNumberFieldOrder_toSubalgebra]
      exact y.isIntegral_coe

/-- An order is maximal exactly when its conductor is the unit ideal. -/
@[simp]
theorem conductor_eq_top_iff (O : NumberFieldOrder K) :
    O.conductor = ⊤ ↔ O = maximalNumberFieldOrder K := by
  refine ⟨fun h ↦ toRingOfIntegers_injective ?_, by rintro rfl; exact conductor_maximal⟩
  rw [(conductor_eq_top_iff_toRingOfIntegers_eq_top _).mp h,
    (conductor_eq_top_iff_toRingOfIntegers_eq_top _).mp conductor_maximal]

end NumberFieldOrder

end TauCeti.GlobalNumberFields
