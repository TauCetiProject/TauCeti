/-!
# Gorenstein orders

For a nonzero fractional ideal `I` of an order `O` in a number field `K`, the trace dual
`Iᵛ = {x ∈ K | Tr_{K/ℚ}(x I) ⊆ ℤ}` is again a nonzero fractional ideal of `O`, and `Iᵛᵛ = I`.
The multiplier ring of `I` is the trace dual of `I Iᵛ`, so `I` is proper exactly when
`I Iᵛ = Oᵛ`. The trace dual of the zero ideal is all of `K`, which is not fractional, so the
packaged dual `NumberFieldOrder.dual` assigns the junk value `0` to the zero ideal.

The order `O` is *Gorenstein* when its trace dual `Oᵛ`, the codifferent, is an invertible
fractional ideal. The criterion above then shows that a fractional ideal of a Gorenstein order is
proper if and only if it is invertible. Conversely `Oᵛ` is always proper, so this equivalence
characterizes Gorenstein orders.

The maximal order is Gorenstein, since all its nonzero fractional ideals are invertible. So is
every monogenic order `ℤ[x]`: by Euler's formula its trace dual is generated by `f'(x)⁻¹`, where `f`
is the minimal polynomial of `x`.

## Main definitions

* `TauCeti.GlobalNumberFields.NumberFieldOrder.dual`: the trace dual of a fractional ideal of an
  order, as a fractional ideal.
* `TauCeti.GlobalNumberFields.NumberFieldOrder.IsGorenstein`: an order is Gorenstein when its
  trace dual is invertible.

## Main results

* `TauCeti.GlobalNumberFields.NumberFieldOrder.dual_dual`: the trace dual is an involution.
* `TauCeti.GlobalNumberFields.NumberFieldOrder.isProperFractionalIdeal_iff_mul_dual_eq_dual_one`:
  a nonzero fractional ideal `I` is proper if and only if `I Iᵛ = Oᵛ`.
* `TauCeti.GlobalNumberFields.NumberFieldOrder.isProperFractionalIdeal_iff_isUnit_of_isGorenstein`:
  in a Gorenstein order, proper fractional ideals are exactly the invertible ones.
* `TauCeti.GlobalNumberFields.NumberFieldOrder.isGorenstein_iff`: an order is Gorenstein if and
  only if each of its proper fractional ideals is invertible.
* `TauCeti.GlobalNumberFields.NumberFieldOrder.isGorenstein_maximal`: the maximal order is
  Gorenstein.
* `TauCeti.GlobalNumberFields.NumberFieldOrder.isGorenstein_of_toSubalgebra_eq_adjoin`: a
  monogenic order is Gorenstein.

## References

* J. Buchmann and H. W. Lenstra, Jr., *Approximating rings of integers in number fields*,
  J. Théor. Nombres Bordeaux 6 (1994), §2.
* G. S. Kopp and J. C. Lagarias, *Class Field Theory for Orders of Number Fields*, §2.
* J.-P. Serre, *Local Fields*, Chapter III, §6, Lemma 2 (Euler's formula, available in Mathlib as
  `traceForm_dualSubmodule_adjoin`).
-/

public section
noncomputable section

open Module NumberField Submodule
open scoped nonZeroDivisors

namespace TauCeti.GlobalNumberFields

namespace NumberFieldOrder

universe u

variable {K : Type u} [Field K] [NumberField K] (O : NumberFieldOrder K)

/-- The trace dual of a nonzero fractional ideal is the `ℤ`-span of the trace-dual basis of a
`ℚ`-basis spanning the ideal over `ℤ`. -/
private theorem exists_basis_traceDual
    {I : FractionalIdeal O.toSubalgebra⁰ K} (hI : I ≠ 0) :
    ∃ b : Basis (Fin (finrank ℚ K)) ℚ K,
      (I : Submodule O.toSubalgebra K).restrictScalars ℤ = span ℤ (Set.range b) ∧
      (traceDual ℤ ℚ (I : Submodule O.toSubalgebra K)).restrictScalars ℤ =
        span ℤ (Set.range b.traceDual) := by
  obtain ⟨b, hb⟩ := O.exists_basis_restrictScalars_eq_span hI
  exact ⟨b, hb, traceDual_span_of_basis ℤ _ b hb⟩

/-- The trace dual of a nonzero fractional ideal of an order is a fractional ideal. -/
theorem isFractional_traceDual {I : FractionalIdeal O.toSubalgebra⁰ K} (hI : I ≠ 0) :
    IsFractional O.toSubalgebra⁰ (traceDual ℤ ℚ (I : Submodule O.toSubalgebra K)) := by
  obtain ⟨b, -, hb⟩ := O.exists_basis_traceDual hI
  refine FractionalIdeal.isFractional_of_fg (FG.of_restrictScalars ℤ ?_)
  rw [hb]
  exact fg_span (Set.finite_range _)

/-- The trace dual of a nonzero fractional ideal of an order is not zero. -/
private theorem traceDual_ne_bot {I : FractionalIdeal O.toSubalgebra⁰ K} (hI : I ≠ 0) :
    traceDual ℤ ℚ (I : Submodule O.toSubalgebra K) ≠ ⊥ := by
  obtain ⟨b, -, hb⟩ := O.exists_basis_traceDual hI
  obtain ⟨i⟩ := b.index_nonempty
  intro h
  have hi : b.traceDual i ∈ (traceDual ℤ ℚ (I : Submodule O.toSubalgebra K)).restrictScalars ℤ :=
    hb ▸ subset_span ⟨i, rfl⟩
  rw [h, restrictScalars_bot, mem_bot] at hi
  exact b.traceDual.ne_zero i hi

/-- Taking the trace dual twice returns a nonzero fractional ideal of an order. -/
private theorem traceDual_traceDual {I : FractionalIdeal O.toSubalgebra⁰ K} (hI : I ≠ 0) :
    traceDual ℤ ℚ (traceDual ℤ ℚ (I : Submodule O.toSubalgebra K)) = I := by
  obtain ⟨b, hI', hb⟩ := O.exists_basis_traceDual hI
  apply restrictScalars_injective ℤ
  rw [traceDual_span_of_basis ℤ _ b.traceDual hb, Basis.traceDual_traceDual, hI']

/-! ### The trace dual of a fractional ideal -/

/-- The trace dual `Iᵛ = {x ∈ K | Tr_{K/ℚ}(x I) ⊆ ℤ}` of a fractional ideal `I` of an order, as a
fractional ideal. For `I = 0` the trace dual is all of `K`, which is not fractional, and the
junk value `0` is used instead. -/
def dual (I : FractionalIdeal O.toSubalgebra⁰ K) : FractionalIdeal O.toSubalgebra⁰ K :=
  open scoped Classical in
  if hI : I = 0 then 0 else
    (⟨traceDual ℤ ℚ (I : Submodule O.toSubalgebra K), O.isFractional_traceDual hI⟩ :
      FractionalIdeal O.toSubalgebra⁰ K)

variable {O}

/-- The trace dual of a nonzero fractional ideal is Mathlib's `Submodule.traceDual` over
`ℤ ⊆ ℚ`. -/
theorem coe_dual {I : FractionalIdeal O.toSubalgebra⁰ K} (hI : I ≠ 0) :
    (O.dual I : Submodule O.toSubalgebra K) = traceDual ℤ ℚ (I : Submodule O.toSubalgebra K) := by
  simp [dual, hI]

/-- An element lies in the trace dual of a nonzero fractional ideal `I` exactly when its products
with the elements of `I` have integral trace. -/
theorem mem_dual {I : FractionalIdeal O.toSubalgebra⁰ K} (hI : I ≠ 0) {x : K} :
    x ∈ O.dual I ↔ ∀ y ∈ I, Algebra.trace ℚ K (x * y) ∈ (algebraMap ℤ ℚ).range := by
  simp only [← FractionalIdeal.mem_coe, coe_dual hI, mem_traceDual, Algebra.traceForm_apply]

variable (O) in
/-- The junk value of the trace dual at the zero ideal is zero. -/
@[simp]
theorem dual_zero : O.dual 0 = 0 := by
  simp [dual]

/-- The trace dual of a nonzero fractional ideal is nonzero. -/
theorem dual_ne_zero {I : FractionalIdeal O.toSubalgebra⁰ K} (hI : I ≠ 0) : O.dual I ≠ 0 := by
  rw [ne_eq, ← FractionalIdeal.coeToSubmodule_inj, coe_dual hI, FractionalIdeal.coe_zero]
  exact O.traceDual_ne_bot hI

/-- The trace dual of a fractional ideal vanishes exactly when the ideal does. -/
@[simp]
theorem dual_eq_zero_iff {I : FractionalIdeal O.toSubalgebra⁰ K} : O.dual I = 0 ↔ I = 0 :=
  ⟨not_imp_not.mp dual_ne_zero, fun h ↦ h ▸ O.dual_zero⟩

/-- **Trace duality is perfect:** the trace dual of the trace dual of a fractional ideal of an
order is the ideal itself. -/
@[simp]
theorem dual_dual (I : FractionalIdeal O.toSubalgebra⁰ K) : O.dual (O.dual I) = I := by
  rcases eq_or_ne I 0 with rfl | hI
  · simp
  rw [← FractionalIdeal.coeToSubmodule_inj, coe_dual (dual_ne_zero hI), coe_dual hI,
    O.traceDual_traceDual hI]

variable (O) in
/-- The trace dual is an involution on the fractional ideals of an order. -/
theorem dual_involutive : Function.Involutive O.dual :=
  dual_dual

variable (O) in
/-- The trace dual is injective on the fractional ideals of an order. -/
theorem dual_injective : Function.Injective O.dual :=
  (dual_involutive O).injective

/-! ### Proper ideals and the trace dual -/

/-- The product of a nonzero fractional ideal with its trace dual is nonzero. -/
private theorem mul_dual_ne_zero {I : FractionalIdeal O.toSubalgebra⁰ K} (hI : I ≠ 0) :
    I * O.dual I ≠ 0 := by
  obtain ⟨x, hxI, hx⟩ := exists_mem_ne_zero_of_ne_bot
    (FractionalIdeal.coeToSubmodule_ne_bot.mpr hI)
  obtain ⟨y, hyI, hy⟩ := exists_mem_ne_zero_of_ne_bot
    (FractionalIdeal.coeToSubmodule_ne_bot.mpr (dual_ne_zero hI))
  intro h
  have hxy := FractionalIdeal.mul_mem_mul hxI hyI
  rw [h, FractionalIdeal.mem_zero_iff] at hxy
  exact mul_ne_zero hx hy hxy

/-- **The multiplier ring of a nonzero fractional ideal `I` is the trace dual of `I Iᵛ`.** -/
theorem mem_multiplierRing_iff_mem_dual {I : FractionalIdeal O.toSubalgebra⁰ K} (hI : I ≠ 0)
    {x : K} : x ∈ O.multiplierRing I ↔ x ∈ O.dual (I * O.dual I) := by
  let J := (I : Submodule O.toSubalgebra K)
  -- Trace duality: `x` lies in `(I Iᵛ)ᵛ` exactly when `x I ⊆ Iᵛᵛ = I`.
  have hdual : x ∈ traceDual ℤ ℚ (J * traceDual ℤ ℚ J) ↔ span O.toSubalgebra {x} * J ≤ J := by
    rw [← span_singleton_le_iff_mem, le_traceDual_mul_iff, O.traceDual_traceDual hI]
  -- `x I ⊆ I` says that `x` lies in the multiplier ring `(I : I)`.
  have hmul : span O.toSubalgebra {x} * J ≤ J ↔ x ∈ O.multiplierRing I := by
    rw [← Submodule.le_div_iff_mul_le, span_singleton_le_iff_mem, mem_div_iff_forall_mul_mem,
      mem_multiplierRing_iff]
    simp [J]
  rw [← hmul, ← hdual, ← FractionalIdeal.mem_coe, coe_dual (mul_dual_ne_zero hI),
    FractionalIdeal.coe_mul, coe_dual hI]

/-- **A nonzero fractional ideal `I` is proper exactly when `I Iᵛ = Oᵛ`.** -/
theorem isProperFractionalIdeal_iff_mul_dual_eq_dual_one {I : FractionalIdeal O.toSubalgebra⁰ K}
    (hI : I ≠ 0) : O.IsProperFractionalIdeal I ↔ I * O.dual I = O.dual 1 := by
  rw [← (dual_injective O).eq_iff, dual_dual, isProperFractionalIdeal_def, SetLike.ext_iff,
    FractionalIdeal.ext_iff]
  refine forall_congr' fun x ↦ ?_
  rw [mem_multiplierRing_iff_mem_dual hI, FractionalIdeal.mem_one_iff]
  exact iff_congr Iff.rfl ⟨fun h ↦ ⟨⟨x, h⟩, rfl⟩, fun ⟨y, hy⟩ ↦ hy ▸ y.2⟩

variable (O) in
/-- The trace dual `Oᵛ` of an order, its codifferent, is a proper fractional ideal. -/
theorem isProperFractionalIdeal_dual_one : O.IsProperFractionalIdeal (O.dual 1) := by
  rw [isProperFractionalIdeal_iff_mul_dual_eq_dual_one (dual_ne_zero one_ne_zero), dual_dual,
    mul_one]

/-! ### Gorenstein orders -/

variable (O) in
/-- An order is **Gorenstein** when its trace dual `Oᵛ`, the codifferent, is an invertible
fractional ideal. By `NumberFieldOrder.isGorenstein_iff`, these are exactly the orders whose proper
fractional ideals are all invertible. -/
def IsGorenstein : Prop :=
  IsUnit (O.dual 1)

variable (O) in
/-- An order is Gorenstein exactly when its trace dual is invertible. -/
theorem isGorenstein_def : O.IsGorenstein ↔ IsUnit (O.dual 1) :=
  Iff.rfl

/-- **In a Gorenstein order every proper fractional ideal is invertible.** -/
theorem IsGorenstein.isUnit_of_isProperFractionalIdeal (hO : O.IsGorenstein)
    {I : FractionalIdeal O.toSubalgebra⁰ K} (hI : O.IsProperFractionalIdeal I) : IsUnit I := by
  have h := (isProperFractionalIdeal_iff_mul_dual_eq_dual_one hI.ne_zero).mp hI
  exact isUnit_of_mul_isUnit_left (h ▸ hO : IsUnit (I * O.dual I))

/-- **In a Gorenstein order a fractional ideal is proper exactly when it is invertible.** -/
theorem isProperFractionalIdeal_iff_isUnit_of_isGorenstein (hO : O.IsGorenstein)
    (I : FractionalIdeal O.toSubalgebra⁰ K) : O.IsProperFractionalIdeal I ↔ IsUnit I :=
  ⟨hO.isUnit_of_isProperFractionalIdeal, O.isProperFractionalIdeal_of_isUnit⟩

variable (O) in
/-- **An order is Gorenstein exactly when all of its proper fractional ideals are invertible.** -/
theorem isGorenstein_iff :
    O.IsGorenstein ↔ ∀ I : FractionalIdeal O.toSubalgebra⁰ K,
      O.IsProperFractionalIdeal I → IsUnit I :=
  ⟨fun hO _ ↦ hO.isUnit_of_isProperFractionalIdeal,
    fun h ↦ h _ (isProperFractionalIdeal_dual_one O)⟩

variable (K) in
/-- **The maximal order is Gorenstein**: it is a Dedekind domain, so all of its nonzero fractional
ideals are invertible. -/
theorem isGorenstein_maximal : (maximalNumberFieldOrder K).IsGorenstein := by
  have : IsDedekindDomain (maximalNumberFieldOrder K).toSubalgebra :=
    maximalNumberFieldOrder_toSubalgebra K ▸ integralClosure.isDedekindDomain ℤ ℚ K
  exact isUnit_iff_ne_zero.mpr (dual_ne_zero one_ne_zero)

/-- **Euler's formula**: the trace dual of a monogenic order `ℤ[x]` is generated by the inverse of
the derivative of the minimal polynomial of `x`, evaluated at `x`. -/
theorem dual_one_eq_spanSingleton_of_toSubalgebra_eq_adjoin {x : K}
    (hx : O.toSubalgebra = Algebra.adjoin ℤ {x}) :
    O.dual 1 = FractionalIdeal.spanSingleton _
      (Polynomial.aeval x (Polynomial.derivative (minpoly ℚ x)))⁻¹ := by
  have hxint : IsIntegral ℤ x := O.isIntegral ⟨x, hx ▸ Algebra.self_mem_adjoin_singleton ℤ x⟩
  have htop : Algebra.adjoin ℚ {x} = ⊤ := by
    refine Subalgebra.toSubmodule_injective (eq_top_iff.mpr ?_)
    rw [← O.spans, span_le, hx]
    exact Algebra.adjoin_le (S := (Algebra.adjoin ℚ {x}).restrictScalars ℤ)
      (Set.singleton_subset_iff.mpr (Algebra.self_mem_adjoin_singleton ℚ x))
  have h1 : (1 : Submodule O.toSubalgebra K).restrictScalars ℤ =
      Subalgebra.toSubmodule (Algebra.adjoin ℤ {x}) := by
    ext y
    simp [← hx]
  rw [← FractionalIdeal.coeToSubmodule_inj, coe_dual one_ne_zero, FractionalIdeal.coe_one]
  apply restrictScalars_injective ℤ
  rw [restrictScalars_traceDual, h1, traceForm_dualSubmodule_adjoin ℤ ℚ htop hxint]
  ext y
  rw [mem_smul_pointwise_iff_exists, restrictScalars_mem, FractionalIdeal.mem_coe,
    FractionalIdeal.mem_spanSingleton, ← hx]
  exact ⟨fun ⟨b, hb, hby⟩ ↦ ⟨⟨b, hb⟩, by simp [← hby, Subalgebra.smul_def, mul_comm]⟩,
    fun ⟨b, hby⟩ ↦ ⟨b, b.2, by simp [← hby, Subalgebra.smul_def, mul_comm]⟩⟩

/-- **A monogenic order `ℤ[x]` is Gorenstein**, since by Euler's formula its trace dual is
principal. -/
theorem isGorenstein_of_toSubalgebra_eq_adjoin {x : K}
    (hx : O.toSubalgebra = Algebra.adjoin ℤ {x}) : O.IsGorenstein := by
  rw [isGorenstein_def, dual_one_eq_spanSingleton_of_toSubalgebra_eq_adjoin hx]
  exact FractionalIdeal.isUnit_spanSingleton (isUnit_iff_ne_zero.mpr (inv_ne_zero
    ((Algebra.IsSeparable.isSeparable ℚ x).aeval_derivative_ne_zero (minpoly.aeval ℚ x))))

end NumberFieldOrder

end TauCeti.GlobalNumberFields
