module

public import TauCeti.NumberTheory.NumberField.Global.Orders.Picard
public import TauCeti.NumberTheory.NumberField.TotallyPositive

/-!
# The narrow Picard group of a number-field order

The narrow Picard group identifies invertible fractional ideals only when they differ by a
principal ideal with a totally positive generator. Forgetting positivity gives a canonical
surjection onto the wide Picard group. The same construction for the maximal order is the narrow
class group; here the fractional ideals belong to an arbitrary order and only its invertible
ideals enter the quotient.

## References

* G. S. Kopp and J. C. Lagarias, *Class Field Theory for Orders of Number Fields*, §2.
* `TauCeti/NumberTheory/NumberField/NarrowClassGroup/Basic.lean`, for the maximal-order quotient
  and its forgetful map; the construction here adapts that API to arbitrary orders.
-/

public section
noncomputable section

open NumberField

namespace TauCeti.GlobalNumberFields

variable {K : Type*} [Field K] [NumberField K]

namespace NumberFieldOrder

/-- The subgroup of invertible fractional ideals generated by totally positive field elements. -/
def narrowPrincipal (O : NumberFieldOrder K) : Subgroup O.invertibleProperFractionalIdeals :=
  Subgroup.map (toPrincipalIdeal O.toSubalgebra K) totallyPositiveUnits

/-- An invertible fractional ideal is narrowly principal precisely when it has a totally positive
generator in the ambient field. -/
@[simp]
theorem mem_narrowPrincipal_iff (O : NumberFieldOrder K)
    {I : O.invertibleProperFractionalIdeals} :
    I ∈ O.narrowPrincipal ↔
      ∃ x : Kˣ, IsTotallyPositive (x : K) ∧ toPrincipalIdeal O.toSubalgebra K x = I := by
  simp only [narrowPrincipal, Subgroup.mem_map, mem_totallyPositiveUnits]

end NumberFieldOrder

/-- The narrow Picard group of an order: invertible fractional ideals modulo those with a totally
positive principal generator. -/
def NarrowPic (O : NumberFieldOrder K) : Type _ :=
  O.invertibleProperFractionalIdeals ⧸ O.narrowPrincipal

instance (O : NumberFieldOrder K) : CommGroup (NarrowPic O) :=
  inferInstanceAs (CommGroup (O.invertibleProperFractionalIdeals ⧸ O.narrowPrincipal))

namespace NarrowPic

/-- The narrow Picard class of an invertible fractional ideal. -/
def mk (O : NumberFieldOrder K) : O.invertibleProperFractionalIdeals →* NarrowPic O :=
  QuotientGroup.mk' O.narrowPrincipal

/-- Every narrow Picard class has an invertible fractional-ideal representative. -/
theorem mk_surjective (O : NumberFieldOrder K) : Function.Surjective (mk O) :=
  QuotientGroup.mk'_surjective _

/-- An invertible fractional ideal has trivial narrow class exactly when it has a totally positive
principal generator. -/
@[simp]
theorem mk_eq_one_iff (O : NumberFieldOrder K) {I : O.invertibleProperFractionalIdeals} :
    mk O I = 1 ↔ I ∈ O.narrowPrincipal :=
  QuotientGroup.eq_one_iff I

/-- Two invertible fractional ideals have the same narrow Picard class exactly when they differ
by a principal ideal with a totally positive generator. -/
@[simp]
theorem mk_eq_mk_iff (O : NumberFieldOrder K) {I J : O.invertibleProperFractionalIdeals} :
    mk O I = mk O J ↔ ∃ P ∈ O.narrowPrincipal, I * P = J :=
  QuotientGroup.mk'_eq_mk' O.narrowPrincipal

variable {M : Type*} [Monoid M]

/-- A homomorphism on invertible ideals that kills the narrowly principal ideals descends to the
narrow Picard group. -/
def lift (O : NumberFieldOrder K) (φ : O.invertibleProperFractionalIdeals →* M)
    (h : O.narrowPrincipal ≤ MonoidHom.ker φ) : NarrowPic O →* M :=
  QuotientGroup.lift O.narrowPrincipal φ h

/-- The descended homomorphism agrees with the original one on ideal classes. -/
@[simp]
theorem lift_mk (O : NumberFieldOrder K) (φ : O.invertibleProperFractionalIdeals →* M)
    (h : O.narrowPrincipal ≤ MonoidHom.ker φ) (I : O.invertibleProperFractionalIdeals) :
    lift O φ h (mk O I) = φ I :=
  QuotientGroup.lift_mk' _ h I

/-- A homomorphism out of the narrow Picard group is determined by its values on the classes of
invertible fractional ideals. -/
theorem lift_unique (O : NumberFieldOrder K) (φ : O.invertibleProperFractionalIdeals →* M)
    (h : O.narrowPrincipal ≤ MonoidHom.ker φ) (ψ : NarrowPic O →* M)
    (hψ : ∀ I, ψ (mk O I) = φ I) : ψ = lift O φ h :=
  MonoidHom.ext fun x => QuotientGroup.induction_on x fun I =>
    (hψ I).trans (lift_mk O φ h I).symm

/-- The narrow class of the principal fractional ideal generated by a nonzero field element. -/
def mkPrincipal (O : NumberFieldOrder K) : Kˣ →* NarrowPic O :=
  (mk O).comp (toPrincipalIdeal O.toSubalgebra K)

/-- The narrow principal class is the class of the corresponding principal fractional ideal. -/
@[simp]
theorem mkPrincipal_apply (O : NumberFieldOrder K) (x : Kˣ) :
    mkPrincipal O x = mk O (toPrincipalIdeal O.toSubalgebra K x) :=
  by simp only [mkPrincipal, MonoidHom.comp_apply]

/-- A principal narrow Picard class is trivial exactly when an order unit rescales its
generator to a totally positive element. -/
theorem mkPrincipal_eq_one_iff (O : NumberFieldOrder K) {x : Kˣ} :
    mkPrincipal O x = 1 ↔ ∃ w : O.toSubalgebraˣ, IsTotallyPositive (w • (x : K)) := by
  rw [mkPrincipal_apply, mk_eq_one_iff, O.mem_narrowPrincipal_iff]
  constructor
  · rintro ⟨y, hy, hyx⟩
    have hspan : FractionalIdeal.spanSingleton (nonZeroDivisors O.toSubalgebra) (y : K) =
        FractionalIdeal.spanSingleton (nonZeroDivisors O.toSubalgebra) (x : K) := by
      rw [← coe_toPrincipalIdeal y, ← coe_toPrincipalIdeal x, hyx]
    obtain ⟨z, hz⟩ := FractionalIdeal.spanSingleton_eq_spanSingleton.mp hspan
    exact ⟨z⁻¹, by rw [← hz, inv_smul_smul]; exact hy⟩
  · rintro ⟨w, hw⟩
    refine ⟨Units.map (algebraMap O.toSubalgebra K : O.toSubalgebra →* K) w * x, ?_, ?_⟩
    · simpa only [Units.val_mul, Units.coe_map, MonoidHom.coe_ofClass, Units.smul_def,
        Algebra.smul_def] using hw
    · rw [← Units.val_inj, coe_toPrincipalIdeal, coe_toPrincipalIdeal]
      refine FractionalIdeal.spanSingleton_eq_spanSingleton.mpr ⟨w⁻¹, ?_⟩
      simp [Units.smul_def, Algebra.smul_def]

/-- A totally positive element generates the trivial narrow Picard class. -/
theorem mkPrincipal_eq_one_of_isTotallyPositive (O : NumberFieldOrder K) {x : Kˣ}
    (hx : IsTotallyPositive (x : K)) : mkPrincipal O x = 1 :=
  (mkPrincipal_eq_one_iff O).mpr ⟨1, by simpa using hx⟩

/-- Every principal narrow Picard class has order dividing two, since a square is totally
positive at every real place. -/
theorem mkPrincipal_sq (O : NumberFieldOrder K) (x : Kˣ) :
    mkPrincipal O x ^ 2 = 1 := by
  rw [← map_pow]
  exact mkPrincipal_eq_one_of_isTotallyPositive O
    (mem_totallyPositiveUnits.mp (sq_mem_totallyPositiveUnits x))

end NarrowPic

namespace NumberFieldOrder

private theorem narrowPrincipal_le_ker_pic (O : NumberFieldOrder K) :
    O.narrowPrincipal ≤ MonoidHom.ker (ClassGroup.mk (R := O.toSubalgebra) K) := by
  rintro _ ⟨x, -, rfl⟩
  exact ClassGroup.mk_toPrincipalIdeal x

/-- Forgetting the positivity condition gives the canonical map from the narrow to the wide
Picard group of an order. -/
def narrowToPic (O : NumberFieldOrder K) : NarrowPic O →* Pic O :=
  NarrowPic.lift O O.mkPic O.narrowPrincipal_le_ker_pic

/-- On an invertible fractional ideal, the forgetful map gives its wide Picard class. -/
@[simp]
theorem narrowToPic_mk (O : NumberFieldOrder K) (I : O.invertibleProperFractionalIdeals) :
    O.narrowToPic (NarrowPic.mk O I) = O.mkPic I :=
  NarrowPic.lift_mk O O.mkPic O.narrowPrincipal_le_ker_pic I

/-- Every wide Picard class has a narrow Picard preimage. -/
theorem narrowToPic_surjective (O : NumberFieldOrder K) :
    Function.Surjective O.narrowToPic := by
  intro c
  obtain ⟨I, rfl⟩ := O.mkPic_surjective c
  exact ⟨NarrowPic.mk O I, O.narrowToPic_mk I⟩

/-- The narrow class of a principal ideal maps to the trivial wide Picard class. -/
theorem narrowToPic_mkPrincipal (O : NumberFieldOrder K) (x : Kˣ) :
    O.narrowToPic (NarrowPic.mkPrincipal O x) = 1 := by
  rw [NarrowPic.mkPrincipal_apply, O.narrowToPic_mk]
  exact ClassGroup.mk_toPrincipalIdeal x

/-- A representative maps to the trivial wide Picard class precisely when it is principal. -/
theorem narrowToPic_mk_eq_one_iff (O : NumberFieldOrder K)
    {I : O.invertibleProperFractionalIdeals} :
    O.narrowToPic (NarrowPic.mk O I) = 1 ↔
      ∃ x : Kˣ, toPrincipalIdeal O.toSubalgebra K x = I := by
  rw [O.narrowToPic_mk, ClassGroup.mk_eq_one_iff_exists]

/-- The kernel of the forgetful map consists exactly of narrow classes of principal ideals. -/
theorem narrowToPic_ker (O : NumberFieldOrder K) :
    MonoidHom.ker O.narrowToPic = (NarrowPic.mkPrincipal O).range := by
  have hker : MonoidHom.ker O.narrowToPic =
      Subgroup.map (NarrowPic.mk O) (MonoidHom.ker O.mkPic) :=
    QuotientGroup.ker_lift O.narrowPrincipal O.mkPic O.narrowPrincipal_le_ker_pic
  have hpic : MonoidHom.ker O.mkPic = (toPrincipalIdeal O.toSubalgebra K).range := by
    ext I
    exact ClassGroup.mk_eq_one_iff_exists
  rw [hker, hpic, ← MonoidHom.range_comp]
  rfl

end NumberFieldOrder

end TauCeti.GlobalNumberFields
