module

public import TauCeti.NumberTheory.NumberField.Global.Ideles.Norm.CM
public import TauCeti.NumberTheory.NumberField.Global.Ideles.Ray.Subgroup
public import Mathlib.GroupTheory.Index
import TauCeti.NumberTheory.NumberField.Global.Ideles.Ray.ClassQuotient
import TauCeti.NumberTheory.NumberField.Global.Ideles.Ray.OpenSubgroup

/-!
# Ray quotients of CM norm-one ideles

The adelic norm-one torus of a CM field has a finite quotient by its rational points and
any open congruence subgroup. Pulling back along the surjection `y ↦ y / conj(y)` makes
this a consequence of the finiteness of ordinary ray class groups.

The norm-one class group is that of `New.finite_u1_classGroup` in
`Lib/ClassField/HeckeCharacter/Basic.lean` of lsernau/grh-lean (revision `72fead1`).
-/

public section

open NumberField NumberField.IsCMField
open scoped AdeleGaloisAction

namespace TauCeti.GlobalNumberFields

variable {E : Type} [Field E] [NumberField E]

/-- The subgroup generated by the rational norm-one points and the norm-one ideles
satisfying the local congruence conditions of `𝔪`. Its quotient is the norm-one ray
class group. -/
noncomputable def cmNormOneRaySubgroup (𝔪 : Modulus E) : Subgroup (cmNormOneIdeles E) :=
  (ideleCongruenceSubgroup 𝔪).subgroupOf (cmNormOneIdeles E) ⊔
    (IdeleGroup.principalSubgroup (𝓞 E) E).subgroupOf (cmNormOneIdeles E)

/-- A norm-one idele represents the trivial ray class exactly when it is the product
of a norm-one congruence idele and a principal norm-one idele. -/
theorem mem_cmNormOneRaySubgroup_iff {𝔪 : Modulus E} {x : cmNormOneIdeles E} :
    x ∈ cmNormOneRaySubgroup 𝔪 ↔
      ∃ a : cmNormOneIdeles E, (a : IdeleGroup (𝓞 E) E) ∈ ideleCongruenceSubgroup 𝔪 ∧
        ∃ b : cmNormOneIdeles E,
          (b : IdeleGroup (𝓞 E) E) ∈ IdeleGroup.principalSubgroup (𝓞 E) E ∧ a * b = x :=
  Subgroup.mem_sup

/-- A subgroup contains the norm-one ray subgroup exactly when it contains both the
norm-one congruence ideles and the rational norm-one points. -/
theorem cmNormOneRaySubgroup_le_iff {𝔪 : Modulus E} {U : Subgroup (cmNormOneIdeles E)} :
    cmNormOneRaySubgroup 𝔪 ≤ U ↔
      (ideleCongruenceSubgroup 𝔪).subgroupOf (cmNormOneIdeles E) ≤ U ∧
      (IdeleGroup.principalSubgroup (𝓞 E) E).subgroupOf (cmNormOneIdeles E) ≤ U :=
  sup_le_iff

/-- The norm-one ray subgroup is open since it contains the restriction of the open
idele congruence subgroup. -/
theorem isOpen_cmNormOneRaySubgroup (𝔪 : Modulus E) :
    IsOpen (cmNormOneRaySubgroup 𝔪 : Set (cmNormOneIdeles E)) :=
  Subgroup.isOpen_mono le_sup_left
    ((isOpen_ideleCongruenceSubgroup 𝔪).preimage continuous_subtypeVal)

variable [IsCMField E]

/-- An open subgroup of the CM norm-one ideles that contains the rational norm-one points
has finite index. Its pullback under division by conjugation contains an ordinary ray
congruence subgroup and all principal ideles. -/
theorem finiteIndex_cmNormOneIdeles_of_isOpen {U : Subgroup (cmNormOneIdeles E)}
    (hU : IsOpen (U : Set (cmNormOneIdeles E)))
    (hP : (IdeleGroup.principalSubgroup (𝓞 E) E).subgroupOf (cmNormOneIdeles E) ≤ U) :
    U.FiniteIndex := by
  let f := (ideleDivConj (E := E)).toMonoidHom
  obtain ⟨𝔫, h𝔫⟩ := exists_ideleCongruenceSubgroup_le_of_isOpen (U.comap f)
    (hU.preimage ideleDivConj.continuous)
  have hprincipal : IdeleGroup.principalSubgroup (𝓞 E) E ≤ U.comap f := by
    rintro _ ⟨a, rfl⟩
    apply hP
    refine ⟨a / (complexConj E • a), ?_⟩
    rw [map_div, ← smul_unitEmbedding]
    exact (coe_ideleDivConj_apply (IdeleGroup.unitEmbedding (𝓞 E) E a)).symm
  have : (U.comap f).FiniteIndex := Subgroup.finiteIndex_of_le
    ((comap_raySubgroup 𝔫).trans_le (sup_le h𝔫 hprincipal))
  refine ⟨?_⟩
  rw [← U.index_comap_of_surjective (f := f) ideleDivConj_surjective]
  exact (U.comap f).index_ne_zero

/-- The CM norm-one ray class group is finite at every modulus. -/
instance finiteIndex_cmNormOneRaySubgroup (𝔪 : Modulus E) : (cmNormOneRaySubgroup 𝔪).FiniteIndex :=
  finiteIndex_cmNormOneIdeles_of_isOpen (isOpen_cmNormOneRaySubgroup 𝔪) le_sup_right

end TauCeti.GlobalNumberFields
