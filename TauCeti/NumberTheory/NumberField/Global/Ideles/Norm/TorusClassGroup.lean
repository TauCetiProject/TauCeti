/-!
# Unramified classes of norm-one ideles in a quadratic extension

The unramified class group of the norm-one torus is a quotient of the ordinary ideal
class group of the quadratic field. The needed surjectivity modulo integral ideles
can be seen directly on divisors: the norm-one condition pairs opposite valuations
at conjugate places, and the positive part of the divisor gives a preimage.

The class-group comparison is that of `New.card_u1_classGroup_dvd_classNumber` in
`Lib/ClassField/HeckeCharacter/Basic` of [grh-lean](https://github.com/lsernau/grh-lean)
at revision `72fead1`. The proof here uses valuations in place of idelic Hilbert 90.
-/

public section

open NumberField IsDedekindDomain IsDedekindDomain.HeightOneSpectrum
  IsDedekindDomain.FiniteAdeleRing
open scoped AdeleGaloisAction NumberField Pointwise

namespace TauCeti.GlobalNumberFields

variable {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]

local notation "I" => IdeleGroup (𝓞 L) L
local notation "U" => sIdeles L (∅ : Set (HeightOneSpectrum (𝓞 K)))
local notation "N" => MonoidHom.ker (ContinuousMonoidHom.toMonoidHom (ideleNormMap K L))
local notation "P" => IdeleGroup.principalSubgroup (𝓞 L) L
local notation "ord" => fun x w ↦ adicOrd (IdeleGroup.toFiniteIdele (𝓞 L) L x) w

/-- Opposite valuations at conjugate places are realized by dividing an idele by its Galois
translate, up to a unit at every finite place. -/
theorem exists_div_smul_div_mem_sIdeles_empty (σ : L ≃ₐ[K] L)
    (x : I) (hx : x * σ • x = 1) :
    ∃ y : I, x / (y / σ • y) ∈ U := by
  obtain ⟨y, hy⟩ := x.exists_adicOrd_toFiniteIdele_eq_max
  refine ⟨y, mem_sIdeles_iff.mpr fun w _ ↦ ?_⟩
  have he := congrArg (ord · w) hx
  simp only [map_mul, adicOrd_mul, adicOrd_toFiniteIdele_smul, map_one, adicOrd_one] at he
  have hz : ord (x / (y / σ • y)) w = 0 := by
    simp only [div_eq_mul_inv, map_mul, map_inv, adicOrd_mul, adicOrd_inv,
      adicOrd_toFiniteIdele_smul, hy]
    omega
  simpa only [adicOrd_eq_zero_iff, IdeleGroup.coe_toFiniteIdele, coe_ideleFiniteCoord] using hz

section Quadratic

variable (K L)

/-- The subgroup of norm-one ideles generated by the rational norm-one points and the
norm-one ideles that are units at every finite place. Its quotient is the unramified
class group of the norm-one torus. -/
noncomputable def normOneClassSubgroup : Subgroup N :=
  Subgroup.comap (Subgroup.subtype N) P ⊔ Subgroup.comap (Subgroup.subtype N) U

/-- The two subgroups used to form the unramified norm-one class group. -/
theorem normOneClassSubgroup_def : normOneClassSubgroup K L =
    Subgroup.comap (Subgroup.subtype N) P ⊔ Subgroup.comap (Subgroup.subtype N) U := (rfl)

variable {K L} [Algebra.IsQuadraticExtension K L]

private theorem ideleNormMap_eq_one_iff_mul_smul (σ : L ≃ₐ[K] L) (hσ : σ ≠ 1) (x : I) :
    ideleNormMap K L x = 1 ↔ x * σ • x = 1 := by
  classical
  have hgal : (Finset.univ : Finset (L ≃ₐ[K] L)) = {1, σ} := by
    apply (Finset.eq_of_subset_of_card_le (Finset.subset_univ _ ) ?_).symm
    rw [Finset.card_univ, ← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank,
      Algebra.IsQuadraticExtension.finrank_eq_two, Finset.card_pair hσ.symm]
  rw [← (ideleExtension_injective (K := K) (L := L)).eq_iff, map_one,
    ideleExtension_ideleNormMap, hgal, Finset.prod_pair hσ.symm, ← idele_smul_def,
    ← idele_smul_def, one_smul]

private theorem div_smul_mem_ker_ideleNormMap (σ : L ≃ₐ[K] L) (hσ : σ ≠ 1) :
    ∀ x : I, x / σ • x ∈ N := by
  have hcard : Nat.card (L ≃ₐ[K] L) = 2 :=
    (IsGalois.card_aut_eq_finrank K L).trans (Algebra.IsQuadraticExtension.finrank_eq_two K L)
  have hsq : σ * σ = 1 := by rw [← sq, ← hcard]; exact pow_card_eq_one'
  intro x
  apply (ideleNormMap_eq_one_iff_mul_smul σ hσ _).mpr
  rw [smul_div', smul_smul, hsq, one_smul]
  simp

/-- The ideal class group surjects onto the unramified class group of the norm-one torus of a
quadratic extension. The map is induced by `x ↦ x / σ(x)` for the nontrivial automorphism. -/
theorem exists_surjective_normOneClassGroupHom :
    ∃ f : ClassGroup (𝓞 L) →* (N ⧸ normOneClassSubgroup K L), Function.Surjective f := by
  classical
  obtain ⟨σ, hσ, _⟩ := (Nat.card_eq_two_iff' (1 : L ≃ₐ[K] L)).mp
    ((IsGalois.card_aut_eq_finrank K L).trans (Algebra.IsQuadraticExtension.finrank_eq_two K L))
  let f : I →* N := (MonoidHom.id I / (MulDistribMulAction.toMonoidHom I σ)).codRestrict N
    (div_smul_mem_ker_ideleNormMap σ hσ)
  let g := (QuotientGroup.mk' (normOneClassSubgroup K L)).comp f
  have hsurj : Function.Surjective g := by
    intro q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective q
    have hx := (ideleNormMap_eq_one_iff_mul_smul σ hσ x).mp x.property
    obtain ⟨y, hy⟩ := exists_div_smul_div_mem_sIdeles_empty σ x hx
    refine ⟨y, QuotientGroup.eq.mpr ?_⟩
    rw [normOneClassSubgroup_def]
    apply Subgroup.mem_sup_right
    rw [Subgroup.mem_comap, Subgroup.coe_subtype, Subgroup.coe_mul, Subgroup.coe_inv]
    convert hy using 1
    rw [div_eq_mul_inv, mul_comm]
    rfl
  let c := (toClassGroup (𝓞 L) L).comp (IdeleGroup.toFiniteIdele (𝓞 L) L)
  have hcs : Function.Surjective c := fun a ↦ by
    obtain ⟨u, hu⟩ := toClassGroup_surjective (K := L) a
    exact ⟨IdeleGroup.ofFiniteIdele (𝓞 L) L u, by simpa [c] using hu⟩
  have hk : c.ker ≤ g.ker := by
    intro x hx
    have hx' : toClassGroup (𝓞 L) L (IdeleGroup.toFiniteIdele (𝓞 L) L x) ∈
        Subgroup.closure (HeightOneSpectrum.classGroupMk '' (∅ : Set (HeightOneSpectrum (𝓞 L)))) :=
      hx ▸ one_mem _
    obtain ⟨a, ha⟩ := (toClassGroup_mem_closure_iff _).mp hx'
    have ha' : x * IdeleGroup.unitEmbedding (𝓞 L) L a ∈ U := by
      refine mem_sIdeles_iff.mpr fun w _ ↦ ?_
      rw [coe_ideleFiniteCoord, ← IdeleGroup.coe_toFiniteIdele, map_mul,
        IdeleGroup.toFiniteIdele_unitEmbedding]
      exact ha w (Set.notMem_empty w)
    have hp : f (IdeleGroup.unitEmbedding (𝓞 L) L a⁻¹) ∈ Subgroup.comap (Subgroup.subtype N) P := by
      exact Subgroup.div_mem P ⟨a⁻¹, rfl⟩ (smul_mem_principalSubgroup σ ⟨a⁻¹, rfl⟩)
    have hu : f (x * IdeleGroup.unitEmbedding (𝓞 L) L a) ∈ Subgroup.comap (Subgroup.subtype N) U :=
      Subgroup.div_mem U ha' (smul_mem_sIdeles σ ha')
    have h := (normOneClassSubgroup K L).mul_mem
      (normOneClassSubgroup_def K L ▸ Subgroup.mem_sup_right hu)
      (normOneClassSubgroup_def K L ▸ Subgroup.mem_sup_left hp)
    rw [← map_mul, map_inv, mul_inv_cancel_right] at h
    exact (QuotientGroup.eq_one_iff _).mpr h
  let e := QuotientGroup.quotientKerEquivOfSurjective c hcs
  exact ⟨(QuotientGroup.lift c.ker g hk).comp e.symm.toMonoidHom,
    (QuotientGroup.lift_surjective_of_surjective c.ker g hsurj hk).comp e.symm.surjective⟩

/-- The unramified norm-one class group is finite, and its order divides the ideal class
number of the quadratic field. -/
theorem finite_and_card_dvd_normOneClassGroup :
    Finite (N ⧸ normOneClassSubgroup K L) ∧
      Nat.card (N ⧸ normOneClassSubgroup K L) ∣ classNumber L := by
  obtain ⟨f, hf⟩ := exists_surjective_normOneClassGroupHom (K := K) (L := L)
  exact ⟨Finite.of_surjective f hf, by
    rw [classNumber, ← Nat.card_eq_fintype_card]
    exact Subgroup.card_dvd_of_surjective hf⟩

end Quadratic

end TauCeti.GlobalNumberFields
