module

public import TauCeti.FieldTheory.Kummer.Degree
public import TauCeti.NumberTheory.NumberField.Kummer.Ramification
public import TauCeti.NumberTheory.NumberField.Discriminant.RamifiedSupport.Basic
public import TauCeti.NumberTheory.NumberField.Units.SUnit.Basic
public import Mathlib.NumberTheory.NumberField.ClassNumber
import TauCeti.NumberTheory.NumberField.SplitsCompletely.GaloisClosure
import TauCeti.NumberTheory.RamificationInertia.Unramified

/-!
# Unramified primes in Kummer fields

The finite Kummer field generated by roots of a subgroup of local units is unramified at every
prime avoiding the exponent. The ambient field containing the roots need not itself be a number
field: in particular, it can be the separable closure. This gives the ramification input for
norm computations in extensions generated by roots of S-units.

In particular, `ramifiedSupport_kummerField_sUnits_subset` shows that the field generated by
`n`-th roots of the S-units has its ramified support contained in `S`, when `S` contains the
primes dividing `n`. This is the ramification hypothesis in the placewise proof that Kummer
ideles are norms from that field.

## References

* J. S. Milne, *Class Field Theory*, v4.03, Chapter VII, Appendix, Proposition A.5,
  and §9, Lemma 9.3.
* J. Neukirch, *Algebraic Number Theory*, Chapter III, §2.
-/

public noncomputable section

open IsDedekindDomain NumberField IntermediateField

namespace TauCeti.NumberField

variable {K E : Type*} [Field K] [NumberField K] [Field E] [Algebra K E]
  {n : ℕ} [NeZero n] [HasEnoughRootsOfUnity K n] {Δ : Subgroup Kˣ}
  [(powMonoidHom n : Kˣ →* Kˣ).range.IsFiniteRelIndex Δ]

/-- A finite Kummer extension of a number field is a number field, even when its ambient field
is infinite over the base. The base need not contain the `n`-th roots of unity. -/
instance : NumberField (kummerField E n Δ) :=
  NumberField.of_module_finite K _

/-- A finite Kummer field generated by roots of `v`-units is unramified at `v`, provided `v`
does not divide the exponent. The ambient field `E` may be infinite over `K`. -/
theorem isUnramifiedIn_kummerField_of_valuation_eq_one
    {v : HeightOneSpectrum (𝓞 K)} (hn : (n : 𝓞 K) ∉ v.asIdeal)
    (hΔ : ∀ a ∈ Δ, v.valuation K (a : K) = 1) :
    Algebra.IsUnramifiedIn (𝓞 (kummerField E n Δ)) v.asIdeal := by
  let M := kummerField E n Δ
  rw [Ideal.isUnramifiedIn_iff_forall_inertia_eq_bot (G := M ≃ₐ[K] M)]
  intro Q hQ
  apply eq_bot_iff.mpr
  intro σ hσ
  rw [Subgroup.mem_bot]
  apply AlgEquiv.coe_toAlgHom_injective
  refine algHom_ext_of_eq_adjoin K kummerField_def fun x ⟨a, ha, hx⟩ ↦ ?_
  let y : M := ⟨x, mem_kummerField_of_pow_eq ha hx⟩
  have hy : y ^ n = algebraMap K M a := Subtype.ext (by simpa using hx)
  have hur := isUnramifiedIn_adjoin_of_pow_eq_of_valuation_eq_one
    (M := M) (s := {y}) (v := v)
    (fun z hz ↦ by
      obtain rfl := Set.mem_singleton_iff.mp hz
      exact ⟨a, hy, hΔ a ha⟩) hn
  have hfix := (Ideal.isUnramifiedIn_iff_forall_inertia_le
    v.asIdeal (adjoin K {y})).mp hur Q hQ hσ
  exact (mem_fixingSubgroup_iff (M ≃ₐ[K] M)).mp hfix y
    (mem_adjoin_simple_self K y)

/-- The ramified support of a finite Kummer field of a subgroup of the S-units is contained
in `S`, when `S` contains the primes dividing the exponent. -/
theorem ramifiedSupport_kummerField_subset
    (S : Finset (HeightOneSpectrum (𝓞 K)))
    (hS : ∀ v : HeightOneSpectrum (𝓞 K), (n : 𝓞 K) ∈ v.asIdeal → v ∈ S)
    (hΔ : Δ ≤ (S : Set (HeightOneSpectrum (𝓞 K))).unit K) :
    ramifiedSupport K (kummerField E n Δ) ⊆ S := by
  intro v hv
  by_contra hvS
  have hur := isUnramifiedIn_kummerField_of_valuation_eq_one
    (E := E) (n := n) (Δ := Δ) (fun hn ↦ hvS (hS v hn))
    (fun a ha ↦ (Set.mem_unit_iff _ K).mp (hΔ ha) v hvS)
  rw [mem_ramifiedSupport, dvd_relDiscr_iff_exists_not_isUnramifiedAt v.ne_bot] at hv
  obtain ⟨P, hP⟩ := hv
  exact hP (hur P P.2.1 P.2.2)

/-- The field generated by the `n`-th roots of the S-units is unramified outside `S`, provided
`S` contains every prime dividing `n`. The roots may be taken in the separable closure. -/
theorem ramifiedSupport_kummerField_sUnits_subset
    (S : Finset (HeightOneSpectrum (𝓞 K)))
    (hS : ∀ v : HeightOneSpectrum (𝓞 K), (n : 𝓞 K) ∈ v.asIdeal → v ∈ S) :
    ramifiedSupport K
      (kummerField E n ((S : Set (HeightOneSpectrum (𝓞 K))).unit K)) ⊆ S :=
  ramifiedSupport_kummerField_subset S hS le_rfl

end TauCeti.NumberField
