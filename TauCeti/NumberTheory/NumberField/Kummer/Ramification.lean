module

public import Mathlib.NumberTheory.RamificationInertia.Unramified
public import TauCeti.NumberTheory.NumberField.Kummer.LocalUnit
import TauCeti.NumberTheory.NumberField.SplitsCompletely.GaloisClosure
import TauCeti.RingTheory.DedekindDomain.Different.Derivative

/-!
# Radical extensions of number fields are unramified away from `n a`

Let `L = K(α)` be an extension of number fields generated by an `n`-th root `α` of `a ∈ K`. A
finite place `v` of `K` at which both `n` and `a` are units is unramified in `L`. When `α` is
integral, the radical generator puts `n a` in the different of `L/K`
(`TauCeti.natCast_mul_mem_differentIdeal_of_pow_eq`), and a prime ramified over `K` divides the
different, so it contains `n a`. A `v`-unit `a` is reduced to the integral case by a denominator
prime to `v`. A field generated by several such radicals is the compositum of the fields generated
by each, and is unramified at `v` as well. That statement is made inside a Galois extension `M/K`,
where ramification of a compositum is read off inertia groups; this costs nothing, since the normal
closure of a field generated by `n`-th roots of elements of `K` is generated by `n`-th roots of the
same elements.

This is the ramification statement of Kummer theory over a number field (Milne, VII, A.5): if `S`
is a finite set of finite places containing those above `n`, the field generated by the `n`-th
roots of the `S`-units is unramified at every finite place outside `S`. No roots of unity are
needed for this.

The two conditions are needed separately; asking only that `n a` be a `v`-unit is not enough. Over
`ℚ`, `n = p` and `a = 1 / p` make `n a = 1`, yet `ℚ(p^{-1/p}) = ℚ(p^{1/p})` is totally ramified at
`p`.

## Main results

* `TauCeti.NumberField.isUnramifiedIn_of_pow_eq`: if `L = K(α)` with `α ∈ 𝓞 L`, `αⁿ = a ∈ 𝓞 K`,
  and `n a ∉ p`, then `p` is unramified in `L`.
* `TauCeti.NumberField.isUnramifiedIn_of_pow_eq_of_valuation_eq_one`: if `L = K(α)` with
  `αⁿ = a ∈ K`, `n ∉ v` and `v(a) = 1`, then `v` is unramified in `L`.
* `TauCeti.NumberField.isUnramifiedIn_adjoin_of_pow_eq_of_valuation_eq_one`: inside a Galois
  extension `M/K`, a field `K(s)` generated by `n`-th roots of `v`-units is unramified at `v` when
  `n ∉ v`.

## References

* J. S. Milne, *Class Field Theory*, v4.03, Chapter VII, Appendix, Proposition A.5.
* J. Neukirch, *Algebraic Number Theory*, Chapter III, §2.
-/

public section

open IsDedekindDomain NumberField

namespace TauCeti.NumberField

variable {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]

/-- **A radical extension is unramified away from `n a`.** If `L = K(α)` for an integral `α` with
`αⁿ = a ∈ 𝓞 K`, then every prime `p` of `𝓞 K` not containing `n a` is unramified in `L`. -/
theorem isUnramifiedIn_of_pow_eq {α : 𝓞 L} (hα : IntermediateField.adjoin K {(α : L)} = ⊤)
    {n : ℕ} {a : 𝓞 K} (hαa : α ^ n = algebraMap (𝓞 K) (𝓞 L) a) {p : Ideal (𝓞 K)}
    (hp : (n : 𝓞 K) * a ∉ p) : Algebra.IsUnramifiedIn (𝓞 L) p := by
  have hα' : Algebra.adjoin K {algebraMap (𝓞 L) L α} = ⊤ := by
    rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (Algebra.IsAlgebraic.isAlgebraic _)]
    exact congrArg IntermediateField.toSubalgebra hα
  intro Q _ _
  by_contra hQ
  -- A ramified prime divides the different, which contains `n a`.
  have hmem := Ideal.le_of_dvd (dvd_differentIdeal_iff.mpr hQ)
    (natCast_mul_mem_differentIdeal_of_pow_eq (K := K) (L := L) hα' hαa)
  exact hp ((Ideal.mem_of_liesOver Q p _).mpr (by simpa using hmem))

/-- **A radical of a `v`-unit is unramified at `v`** (Milne, *Class Field Theory*, VII, A.5). If
`L = K(α)` with `αⁿ = a ∈ K`, and `n` and `a` are units at the finite place `v` of `K`, then `v` is
unramified in `L`. -/
theorem isUnramifiedIn_of_pow_eq_of_valuation_eq_one {α : L}
    (hα : IntermediateField.adjoin K {α} = ⊤) {n : ℕ} {a : K} (hαa : α ^ n = algebraMap K L a)
    {v : HeightOneSpectrum (𝓞 K)} (hn : (n : 𝓞 K) ∉ v.asIdeal) (ha : v.valuation K a = 1) :
    Algebra.IsUnramifiedIn (𝓞 L) v.asIdeal := by
  have hn0 : n ≠ 0 := by
    rintro rfl
    exact hn (by simp)
  obtain ⟨d, c, β, hd, hcunit, _, hβ, hpow⟩ :=
    v.exists_integral_pow_eq_of_valuation_eq_one hn0 ha hαa
  have hdK : algebraMap (𝓞 K) K d ≠ 0 := by
    intro h
    exact hd (by simp [(FaithfulSMul.algebraMap_eq_zero_iff (𝓞 K) K).mp h])
  have hβL : algebraMap (𝓞 L) L β = algebraMap (𝓞 K) L d * α := by
    rw [← RingOfIntegers.coe_eq_algebraMap, hβ]
  have hβgen : IntermediateField.adjoin K {algebraMap (𝓞 L) L β} = ⊤ := by
    rw [eq_top_iff, ← hα, IntermediateField.adjoin_simple_le_iff]
    have hdL : algebraMap (𝓞 K) L d ≠ 0 := by
      rwa [IsScalarTower.algebraMap_apply (𝓞 K) K L, map_ne_zero]
    rw [← inv_mul_cancel_left₀ hdL α, ← hβL]
    refine mul_mem (inv_mem ?_) (IntermediateField.mem_adjoin_simple_self K _)
    rw [IsScalarTower.algebraMap_apply (𝓞 K) K L]
    exact IntermediateField.algebraMap_mem _ _
  exact isUnramifiedIn_of_pow_eq hβgen hpow (v.isPrime.mul_notMem hn hcunit)

/-- **A field generated by radicals of `v`-units is unramified at `v`** (Milne, *Class Field
Theory*, VII, A.5). Let `M/K` be a Galois extension of number fields and `s` a set of elements of
`M`, each an `n`-th root of a `v`-unit of `K`, for a finite place `v` of `K` not dividing `n`. Then
`v` is unramified in the intermediate field `K(s)`. -/
theorem isUnramifiedIn_adjoin_of_pow_eq_of_valuation_eq_one {M : Type*} [Field M] [NumberField M]
    [Algebra K M] [IsGalois K M] {n : ℕ} {s : Set M} {v : HeightOneSpectrum (𝓞 K)}
    (hs : ∀ α ∈ s, ∃ a : K, α ^ n = algebraMap K M a ∧ v.valuation K a = 1)
    (hn : (n : 𝓞 K) ∉ v.asIdeal) :
    Algebra.IsUnramifiedIn (𝓞 (IntermediateField.adjoin K s)) v.asIdeal := by
  -- `K(s)` is the compositum of the fields `K(α)`, `α ∈ s`, each generated by one radical.
  rw [← IntermediateField.biSup_adjoin_simple, Ideal.isUnramifiedIn_iSup_iff]
  intro α
  rw [Ideal.isUnramifiedIn_iSup_iff]
  intro hα
  obtain ⟨a, hαa, ha⟩ := hs α hα
  set E := IntermediateField.adjoin K {α}
  have hgen : IntermediateField.adjoin K {IntermediateField.AdjoinSimple.gen K α} =
      (⊤ : IntermediateField K E) := by
    apply IntermediateField.map_injective E.val
    rw [IntermediateField.adjoin_map, Set.image_singleton, ← AlgHom.fieldRange_eq_map,
      IntermediateField.fieldRange_val, IntermediateField.coe_val,
      IntermediateField.AdjoinSimple.coe_gen]
  refine isUnramifiedIn_of_pow_eq_of_valuation_eq_one hgen (a := a) ?_ hn ha
  apply Subtype.val_injective
  simpa using hαa

end TauCeti.NumberField

end
