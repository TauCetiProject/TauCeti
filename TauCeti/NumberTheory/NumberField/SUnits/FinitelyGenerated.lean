module

public import TauCeti.NumberTheory.NumberField.AdjoinPair
public import TauCeti.RingTheory.DedekindDomain.SInteger.Unit.FiniteSupport

/-!
# S-unit models of finitely generated groups of algebraic tuples

A finitely generated subgroup of a finite product of multiplicative groups of algebraic
numbers has an exact model over one number field and one finite set of finite places.
First descend its generators to a common number field, then collect the finite-place supports
of their coordinates. Taking the subgroup generated by the lifts preserves the original group,
rather than replacing it by the larger product of S-unit groups. In particular its rank and
multiplicative relations can be transported along the resulting injective map.

Finitely many elements of an arbitrary group of tuples, finitely generated or not, together with
finitely many further tuples, descend in the same way when their coordinates are algebraic: the
finitely generated subgroup generated by the lifted elements consists of S-unit tuples over one
number field and has rank at most that of the original group.

These reductions allow height and lattice arguments for S-units to apply to arbitrary finitely
generated groups of algebraic tuples, and to finite subsets of groups of algebraic tuples of finite
rank. No bound for solutions of a unit equation is asserted.

## References

* J.-H. Evertse, H. P. Schlickewei and W. M. Schmidt, *Linear equations in variables which lie
  in a multiplicative group*, Annals of Mathematics **155** (2002), §6 and §7.
-/

public section

open IsDedekindDomain
open scoped NumberField

namespace Subgroup.FG

variable {ι F : Type*} [Finite ι] [Field F] [CharZero F]

/-- A finitely generated group of algebraic tuples is isomorphic to a subgroup of a finite
product of S-unit groups over one intermediate number field. As a group isomorphism, `e`
preserves rank, torsion and multiplicative relations; in addition, each coordinate of `e x` maps
to the corresponding coordinate of `x` under the field inclusion `E → F`, so quantities defined
from the coordinates in `F`, such as heights, are unchanged. -/
theorem exists_numberField_subgroup_pi_unit_mulEquiv {Γ : Subgroup (ι → Fˣ)} (hΓ : Γ.FG)
    (hΓalg : ∀ x ∈ Γ, ∀ i, IsAlgebraic ℚ ((x i : Fˣ) : F)) :
    ∃ (E : IntermediateField ℚ F) (_ : NumberField E)
      (S : Finset (HeightOneSpectrum (𝓞 E)))
      (Δ : Subgroup (ι → (S : Set (HeightOneSpectrum (𝓞 E))).unit E)) (e : Γ ≃* Δ),
      ∀ (x : Γ) (i : ι), algebraMap E F (((e x).val i : Eˣ) : E) = (x.val i : F) := by
  obtain ⟨E, hE, ΓE, hΓE, hmap⟩ :=
    exists_numberField_map_eq (Γ := Γ) hΓ hΓalg
  let f := (Units.map (algebraMap E F).toMonoidHom).compLeft ι
  have hf_apply (y : ι → Eˣ) (i : ι) : ((f y i : Fˣ) : F) = algebraMap E F (y i : E) := by
    simp [f]
  have hf : Function.Injective f := by
    intro x y h
    funext i
    exact Units.ext ((algebraMap E F).injective <| by rw [← hf_apply, ← hf_apply, h])
  let e : Γ ≃* ΓE :=
    ((ΓE.equivMapOfInjective f hf).trans (MulEquiv.subgroupCongr hmap)).symm
  obtain ⟨S, hS⟩ := exists_finset_le_pi_unit (𝓞 E) hΓE
  let g : ΓE →* (ι → (S : Set (HeightOneSpectrum (𝓞 E))).unit E) :=
    MonoidHom.pi fun i ↦ ((Pi.evalMonoidHom (fun _ : ι ↦ Eˣ) i).comp ΓE.subtype).codRestrict
      ((S : Set (HeightOneSpectrum (𝓞 E))).unit E) fun x ↦ by
        simpa using (Subgroup.mem_pi _).mp (hS x.property) i (Set.mem_univ i)
  have hg_apply (y : ΓE) (i : ι) : (g y i : Eˣ) = y.val i := by
    simp [g]
  have hg : Function.Injective g := by
    intro x y h
    apply Subtype.ext
    funext i
    rw [← hg_apply, ← hg_apply, h]
  refine ⟨E, hE, S, g.range, e.trans (MonoidHom.ofInjective hg), ?_⟩
  intro x i
  have he (y : ΓE) : (e.symm y).val = f y.val := by
    simp [e, Subgroup.coe_equivMapOfInjective_apply]
  have hx : f (e x).val = x.val := (he (e x)).symm.trans
    (congrArg Subtype.val (e.symm_apply_apply x))
  rw [MulEquiv.trans_apply, MonoidHom.ofInjective_apply, hg_apply, ← hf_apply, hx]

end Subgroup.FG

namespace Subgroup

variable {ι F : Type*} [Finite ι] [Field F] [CharZero F]

/-- Finitely many tuples `x j` of a group `Γ ≤ (Fˣ)^ι` and finitely many further tuples `z k`, all
with algebraic coordinates, descend to one intermediate number field `E`. The `x j` descend to
tuples `x' j` of `S`-units of `E`, for a finite set `S` of finite places, generating a group `Δ` of
rank at most that of `Γ`, and the `z k` descend to tuples `z' k` of `S`-units of `E`. Here `Γ`
need not be finitely generated, and its other elements need not be algebraic. -/
theorem exists_numberField_subgroup_pi_unit_rank_le {J K : Type*} [Finite J] [Finite K]
    (Γ : Subgroup (ι → Fˣ)) {x : J → ι → Fˣ} {z : K → ι → Fˣ} (hxΓ : ∀ j, x j ∈ Γ)
    (hxalg : ∀ j i, IsAlgebraic ℚ (x j i : F)) (hzalg : ∀ k i, IsAlgebraic ℚ (z k i : F)) :
    ∃ (E : IntermediateField ℚ F) (_ : NumberField E) (S : Finset (HeightOneSpectrum (𝓞 E)))
      (Δ : Subgroup (ι → (S : Set (HeightOneSpectrum (𝓞 E))).unit E))
      (x' : J → ι → (S : Set (HeightOneSpectrum (𝓞 E))).unit E)
      (z' : K → ι → (S : Set (HeightOneSpectrum (𝓞 E))).unit E),
      Δ.FG ∧ Module.rank ℤ (Additive Δ) ≤ Module.rank ℤ (Additive Γ) ∧ (∀ j, x' j ∈ Δ) ∧
        (∀ j i, algebraMap E F ((x' j i : Eˣ) : E) = x j i) ∧
        ∀ k i, algebraMap E F ((z' k i : Eˣ) : E) = z k i := by
  -- Descend the group generated by both families with the finitely generated descent.
  let Γ' := closure (Set.range (Sum.elim x z))
  have hΓ'alg (y : ι → Fˣ) (hy : y ∈ Γ') (i : ι) : IsAlgebraic ℚ ((y i : Fˣ) : F) := by
    induction hy using closure_induction with
    | mem y hy =>
      obtain ⟨j | k, rfl⟩ := hy
      exacts [hxalg j i, hzalg k i]
    | one => simpa using isAlgebraic_one
    | mul a b _ _ ha hb => simpa using ha.mul hb
    | inv a _ ha => simpa using ha.inv
  obtain ⟨E, hE, S, Δ', e, he⟩ := FG.exists_numberField_subgroup_pi_unit_mulEquiv
    ((fg_iff _).mpr ⟨_, rfl, Set.finite_range _⟩) hΓ'alg
  let φ : Γ' →* (ι → (S : Set (HeightOneSpectrum (𝓞 E))).unit E) := Δ'.subtype.comp e.toMonoidHom
  have hφ : Function.Injective φ := Subtype.val_injective.comp e.injective
  let xΓ' : J → Γ' := fun j ↦ ⟨x j, subset_closure ⟨.inl j, rfl⟩⟩
  let zΓ' : K → Γ' := fun k ↦ ⟨z k, subset_closure ⟨.inr k, rfl⟩⟩
  -- Only the group `H` generated by the `x j` is transported; it lies in `Γ`.
  let H := closure (Set.range xΓ')
  have hH : H.map φ = closure (Set.range (φ ∘ xΓ')) := by
    rw [MonoidHom.map_closure, Set.range_comp]
  have hHΓ : H ≤ Γ.comap Γ'.subtype := (closure_le _).mpr fun _ ⟨j, hj⟩ ↦ hj ▸ hxΓ j
  let ε : closure (Set.range (φ ∘ xΓ')) ≃* H :=
    ((H.equivMapOfInjective φ hφ).trans (MulEquiv.subgroupCongr hH)).symm
  have hHΓ' (u : H) : Γ'.subtype.comp H.subtype u ∈ Γ := hHΓ u.property
  let κ : closure (Set.range (φ ∘ xΓ')) →* Γ :=
    ((Γ'.subtype.comp H.subtype).codRestrict Γ hHΓ').comp ε.toMonoidHom
  have hκ : Function.Injective κ :=
    ((MonoidHom.injective_codRestrict _ Γ hHΓ').mpr
      (Γ'.subtype_injective.comp H.subtype_injective)).comp ε.injective
  exact ⟨E, hE, S, closure (Set.range (φ ∘ xΓ')), φ ∘ xΓ', fun k ↦ φ (zΓ' k),
    (fg_iff _).mpr ⟨_, rfl, Set.finite_range _⟩,
    LinearMap.rank_le_of_injective κ.toAdditive.toIntLinearMap hκ,
    fun j ↦ subset_closure (Set.mem_range_self j), fun j ↦ he (xΓ' j), fun k ↦ he (zΓ' k)⟩

end Subgroup
