namespace TauCeti.RestrictedRamification

variable (K : Type*) [Field K] [NumberField K]

/-- **The local-to-global decomposition map into `G_{K,S}`.** Given a finite place `v` of `K` and
an embedding `τ : Kˢ →ₐ[K] K_vˢ`, composing `absoluteGaloisGroupMap τ : G_{K_v} → G_K` with
restriction to `K_S` gives a continuous homomorphism `G_{K_v} →ₜ* G_{K,S}`. -/
def localToGaloisGroupS (S : Set (HeightOneSpectrum (𝓞 K))) (v : HeightOneSpectrum (𝓞 K))
    (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K)) :
    AbsoluteGaloisGroup (v.adicCompletion K) →ₜ* galoisGroupS K (SeparableClosure K) S :=
  (restrictionS K (SeparableClosure K) S).comp (absoluteGaloisGroupMap τ)

/-- Evaluating `localToGaloisGroupS` applies `absoluteGaloisGroupMap τ` and restricts to `K_S`. -/
@[simp]
theorem localToGaloisGroupS_apply (S : Set (HeightOneSpectrum (𝓞 K)))
    (v : HeightOneSpectrum (𝓞 K))
    (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K))
    (g : AbsoluteGaloisGroup (v.adicCompletion K)) :
    localToGaloisGroupS K S v τ g =
      restrictionS K (SeparableClosure K) S (absoluteGaloisGroupMap τ g) :=
  (rfl)

/-- Transition maps `G_{K,T} → G_{K,S}` are compatible with `localToGaloisGroupS`. -/
@[simp]
theorem galoisGroupSMap_comp_localToGaloisGroupS {S T : Set (HeightOneSpectrum (𝓞 K))}
    (h : S ⊆ T) (v : HeightOneSpectrum (𝓞 K))
    (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K)) :
    (galoisGroupSMap K (SeparableClosure K) h).comp (localToGaloisGroupS K T v τ) =
      localToGaloisGroupS K S v τ := by
  ext g x
  simp

/-- **The closed subgroup generated by inertia outside `S`.** Inside `G_K = Gal(Kˢ / K)`, this is
the topological closure of the subgroup generated by the images of local inertia subgroups at all
finite places `v ∉ S` along all embeddings `τ : Kˢ →ₐ[K] K_vˢ`. -/
def inertiaOutsideSubgroup (S : Set (HeightOneSpectrum (𝓞 K))) :
    Subgroup (AbsoluteGaloisGroup K) :=
  (⨆ (v : HeightOneSpectrum (𝓞 K)) (_ : v ∉ S)
    (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K)),
      (separableClosureInertiaSubgroup (v.adicCompletion K)).map
        (absoluteGaloisGroupMap τ :
          AbsoluteGaloisGroup (v.adicCompletion K) →* AbsoluteGaloisGroup K)).topologicalClosure

/-- The inertia subgroup outside `S` is the closure of the supremum of the local inertia
images at places outside `S`. -/
theorem inertiaOutsideSubgroup_def (S : Set (HeightOneSpectrum (𝓞 K))) :
    inertiaOutsideSubgroup K S =
    (⨆ (v : HeightOneSpectrum (𝓞 K)) (_ : v ∉ S)
      (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K)),
        (separableClosureInertiaSubgroup (v.adicCompletion K)).map
          (absoluteGaloisGroupMap τ :
            AbsoluteGaloisGroup (v.adicCompletion K) →*
              AbsoluteGaloisGroup K)).topologicalClosure :=
  (rfl)

/-- `inertiaOutsideSubgroup K S` is a closed subgroup of `G_K`. -/
theorem isClosed_inertiaOutsideSubgroup (S : Set (HeightOneSpectrum (𝓞 K))) :
    IsClosed (inertiaOutsideSubgroup K S : Set (AbsoluteGaloisGroup K)) := by
  rw [inertiaOutsideSubgroup_def]
  exact Subgroup.isClosed_topologicalClosure _

/-- Every local inertia element at `v ∉ S` lies in `inertiaOutsideSubgroup K S` along every
embedding `τ : Kˢ →ₐ[K] K_vˢ`. -/
theorem absoluteGaloisGroupMap_mem_inertiaOutsideSubgroup {S : Set (HeightOneSpectrum (𝓞 K))}
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S)
    (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K))
    {g : AbsoluteGaloisGroup (v.adicCompletion K)}
    (hg : g ∈ separableClosureInertiaSubgroup (v.adicCompletion K)) :
    absoluteGaloisGroupMap τ g ∈ inertiaOutsideSubgroup K S := by
  rw [inertiaOutsideSubgroup_def]
  refine Subgroup.le_topologicalClosure _ ?_
  have hle : (separableClosureInertiaSubgroup (v.adicCompletion K)).map
      (absoluteGaloisGroupMap τ :
        AbsoluteGaloisGroup (v.adicCompletion K) →* AbsoluteGaloisGroup K) ≤
      ⨆ (v' : HeightOneSpectrum (𝓞 K)) (_ : v' ∉ S)
        (τ' : SeparableClosure K →ₐ[K] SeparableClosure (v'.adicCompletion K)),
          (separableClosureInertiaSubgroup (v'.adicCompletion K)).map
            (absoluteGaloisGroupMap τ' :
              AbsoluteGaloisGroup (v'.adicCompletion K) →* AbsoluteGaloisGroup K) :=
    le_iSup₂_of_le v hv (le_iSup_of_le τ le_rfl)
  exact hle ⟨g, hg, rfl⟩

/-- A closed subgroup of `G_K` contains `inertiaOutsideSubgroup K S` if and only if it contains
every local inertia image at every finite place outside `S`. -/
theorem inertiaOutsideSubgroup_le_iff_of_isClosed {S : Set (HeightOneSpectrum (𝓞 K))}
    {H : Subgroup (AbsoluteGaloisGroup K)} (hH : IsClosed (H : Set (AbsoluteGaloisGroup K))) :
    inertiaOutsideSubgroup K S ≤ H ↔
      ∀ (v : HeightOneSpectrum (𝓞 K)), v ∉ S →
        ∀ (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K))
          (g : AbsoluteGaloisGroup (v.adicCompletion K)),
          g ∈ separableClosureInertiaSubgroup (v.adicCompletion K) →
          absoluteGaloisGroupMap τ g ∈ H := by
  refine ⟨fun hle v hv τ g hg ↦ hle (absoluteGaloisGroupMap_mem_inertiaOutsideSubgroup K hv τ hg),
    fun h ↦ ?_⟩
  rw [inertiaOutsideSubgroup_def]
  refine Subgroup.topologicalClosure_minimal _ ?_ hH
  refine iSup_le fun v ↦ iSup_le fun hv ↦ iSup_le fun τ ↦ ?_
  rintro _ ⟨g, hg, rfl⟩
  exact h v hv τ g hg

/-- **Local inertia outside `S` fixes `K_S`.** For `v ∉ S`, every local inertia element at `v`
maps into the fixing subgroup of `K_S` along every embedding `τ : Kˢ →ₐ[K] K_vˢ`. -/
theorem absoluteGaloisGroupMap_mem_fixingSubgroup_maxUnramifiedOutside
    {S : Set (HeightOneSpectrum (𝓞 K))} {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S)
    (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K))
    {g : AbsoluteGaloisGroup (v.adicCompletion K)}
    (hg : g ∈ separableClosureInertiaSubgroup (v.adicCompletion K)) :
    absoluteGaloisGroupMap τ g ∈
      (maxUnramifiedOutside K (SeparableClosure K) S).fixingSubgroup := by
  intro ⟨x, hx⟩
  obtain ⟨E, hxE, hEfin, hEunr⟩ := mem_maxUnramifiedOutside_iff.1 hx
  have : NumberField E := NumberField.of_module_finite K E
  have hvE : v ∉ TauCeti.NumberField.ramifiedSupport K E :=
    TauCeti.NumberField.notMem_ramifiedSupport_of_isUnramifiedIn (hEunr v hv)
  exact E.absoluteGaloisGroupMap_mem_fixingSubgroup_of_notMem_ramifiedSupport v hvE τ hg ⟨x, hxE⟩

/-- **Local inertia outside `S` vanishes in `G_{K,S}`.** For `v ∉ S`, the decomposition map
`G_{K_v} → G_{K,S}` kills the local inertia subgroup. -/
theorem localToGaloisGroupS_eq_one_of_mem_inertia {S : Set (HeightOneSpectrum (𝓞 K))}
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S)
    (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K))
    {g : AbsoluteGaloisGroup (v.adicCompletion K)}
    (hg : g ∈ separableClosureInertiaSubgroup (v.adicCompletion K)) :
    localToGaloisGroupS K S v τ g = 1 := by
  rw [localToGaloisGroupS_apply]
  exact (restrictionS_eq_one_iff K (SeparableClosure K) S).2
    (absoluteGaloisGroupMap_mem_fixingSubgroup_maxUnramifiedOutside K hv τ hg)

private theorem ramificationIdx_eq_one_of_inertia_le_fixingSubgroup
    {S : Set (HeightOneSpectrum (𝓞 K))} {L : IntermediateField K (SeparableClosure K)}
    [NumberField L] (hL : inertiaOutsideSubgroup K S ≤ L.fixingSubgroup)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) (w : HeightOneSpectrum (𝓞 L))
    [w.asIdeal.LiesOver v.asIdeal] :
    w.asIdeal.ramificationIdx (𝓞 K) = 1 := by
  have : Finite (𝓞 K ⧸ v.asIdeal) := Ring.HasFiniteQuotients.finiteQuotient v.ne_bot
  have : Finite (𝓞 L ⧸ w.asIdeal) := Ring.HasFiniteQuotients.finiteQuotient w.ne_bot
  have := HeightOneSpectrum.isSeparable_adicCompletion_of_isSeparable (K := K) (L := L) v w
  let τ' : w.adicCompletion L →ₐ[v.adicCompletion K] SeparableClosure (v.adicCompletion K) :=
    IsSepClosed.lift
  let j : L →ₐ[K] SeparableClosure (v.adicCompletion K) :=
    (τ'.restrictScalars K).comp (IsScalarTower.toAlgHom K L (w.adicCompletion L))
  obtain ⟨τ, hτ⟩ := IsSepClosed.surjective_domRestrict_of_isSeparable (K := K) L
    (E := SeparableClosure K) (M := SeparableClosure (v.adicCompletion K)) j
  -- `hτ : τ.domRestrict L = j`; evaluating both sides at `a`, the left side is `τ a` and the
  -- right side is `τ' (algebraMap L _ a)` by unfolding `domRestrict`, `comp`, `restrictScalars`
  -- and `toAlgHom`, all of which are definitional.
  have hτL (a : L) : τ a = τ' (algebraMap L (w.adicCompletion L) a) :=
    congrArg (fun φ : L →ₐ[K] _ ↦ φ a) hτ
  have hfix : separableClosureInertiaSubgroup (v.adicCompletion K) ≤
      τ'.fieldRange.fixingSubgroup := fun g hg ↦
    τ'.mem_fixingSubgroup_fieldRange_of_forall_apply_algebraMap w fun a ↦ by
      rw [← hτL, ← absoluteGaloisGroupMap_commutes]
      have hfa := hL (absoluteGaloisGroupMap_mem_inertiaOutsideSubgroup K hv τ hg)
      rw [IntermediateField.mem_fixingSubgroup_iff] at hfa
      exact congrArg τ (hfa a.val a.property)
  have : Module.Finite (v.adicCompletion K) τ'.fieldRange :=
    τ'.equivFieldRange.toLinearEquiv.finiteDimensional
  let _ := finiteIntermediateFieldValuativeRel (v.adicCompletion K) _ τ'.fieldRange
  let _ := finiteIntermediateFieldTopology (v.adicCompletion K) _ τ'.fieldRange
  have := finiteIntermediateField_isNonarchimedeanLocalField (v.adicCompletion K) _ τ'.fieldRange
  have := finiteIntermediateField_valuativeExtension (v.adicCompletion K) _ τ'.fieldRange
  have : IsUnramified (v.adicCompletion K) τ'.fieldRange :=
    (separableClosureInertiaSubgroup_le_fixingSubgroup_iff τ'.fieldRange).1 hfix
  exact (HeightOneSpectrum.isUnramified_adicCompletion_iff (K := K) (L := L) v w).1
    (IsUnramified.of_algEquiv τ'.equivFieldRange.symm)

/-- **Inertia characterization of `ker (G_K → G_{K,S})`.** The fixing subgroup of `K_S` inside the
absolute Galois group `G_K` is the closed subgroup generated by all local inertia subgroups at
finite places outside `S`. -/
theorem fixingSubgroup_maxUnramifiedOutside_eq_inertiaOutsideSubgroup
    (S : Set (HeightOneSpectrum (𝓞 K))) :
    (maxUnramifiedOutside K (SeparableClosure K) S).fixingSubgroup =
      inertiaOutsideSubgroup K S := by
  refine le_antisymm ?_ ?_
  · rw [← fixingSubgroup_fixedField (isClosed_inertiaOutsideSubgroup K S)]
    refine fixingSubgroup_antitone fun x hx ↦ mem_maxUnramifiedOutside_iff.2 ?_
    have hfin : FiniteDimensional K (adjoin K {x}) :=
      adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral x)
    refine ⟨adjoin K {x}, mem_adjoin_simple_self K x, hfin, fun v hv ↦ ?_⟩
    have : NumberField (adjoin K {x}) := NumberField.of_module_finite K _
    have hle : inertiaOutsideSubgroup K S ≤ (adjoin K {x}).fixingSubgroup := by
      rw [← le_fixedField_iff_le_fixingSubgroup, adjoin_simple_le_iff]
      exact hx
    have hv_not_mem : v ∉ TauCeti.NumberField.ramifiedSupport K (adjoin K {x}) := by
      refine TauCeti.NumberField.notMem_ramifiedSupport_of_forall_ramificationIdx_eq_one fun P ↦ ?_
      let w : HeightOneSpectrum (𝓞 (adjoin K {x})) :=
        ⟨P.val, P.property.1, Ideal.ne_bot_of_liesOver_of_ne_bot v.ne_bot P.val⟩
      have : w.asIdeal.LiesOver v.asIdeal := P.property.2
      exact ramificationIdx_eq_one_of_inertia_le_fixingSubgroup K hle hv w
    exact fun P _ _ ↦ TauCeti.NumberField.isUnramifiedAway_ramifiedSupport v hv_not_mem P
  · exact (inertiaOutsideSubgroup_le_iff_of_isClosed K
      (InfiniteGalois.fixingSubgroup_isClosed _)).2 fun v hv τ g hg ↦
        absoluteGaloisGroupMap_mem_fixingSubgroup_maxUnramifiedOutside K hv τ hg

/-- An absolute Galois automorphism lies in the inertia subgroup outside `S` exactly when it
fixes every element of `K_S`. -/
@[simp]
theorem mem_inertiaOutsideSubgroup_iff {S : Set (HeightOneSpectrum (𝓞 K))}
    {g : AbsoluteGaloisGroup K} :
    g ∈ inertiaOutsideSubgroup K S ↔
      ∀ x ∈ maxUnramifiedOutside K (SeparableClosure K) S, g x = x := by
  rw [← fixingSubgroup_maxUnramifiedOutside_eq_inertiaOutsideSubgroup,
    IntermediateField.mem_fixingSubgroup_iff]

/-- The fixed field of `inertiaOutsideSubgroup K S` is `K_S`. -/
theorem fixedField_inertiaOutsideSubgroup (S : Set (HeightOneSpectrum (𝓞 K))) :
    fixedField (inertiaOutsideSubgroup K S) = maxUnramifiedOutside K (SeparableClosure K) S := by
  rw [← fixingSubgroup_maxUnramifiedOutside_eq_inertiaOutsideSubgroup K S]
  exact fixedField_fixingSubgroup _

/-- The kernel of `G_K → G_{K,S}` is `inertiaOutsideSubgroup K S`. -/
theorem ker_restrictionS_eq_inertiaOutsideSubgroup
    (S : Set (HeightOneSpectrum (𝓞 K))) :
    (restrictionS K (SeparableClosure K) S).toMonoidHom.ker =
      inertiaOutsideSubgroup K S :=
  (ker_restrictionS K (SeparableClosure K) S).trans
    (fixingSubgroup_maxUnramifiedOutside_eq_inertiaOutsideSubgroup K S)

/-- `inertiaOutsideSubgroup K S` is a normal subgroup of `G_K`. -/
instance instNormal_inertiaOutsideSubgroup (S : Set (HeightOneSpectrum (𝓞 K))) :
    (inertiaOutsideSubgroup K S).Normal := by
  rw [← ker_restrictionS_eq_inertiaOutsideSubgroup K S]
  exact MonoidHom.normal_ker _

/-- A continuous homomorphism `φ : G_K →ₜ* H` into a `T₁` topological monoid killing local inertia
at every finite place outside `S` kills the fixing subgroup of `K_S`. -/
theorem fixingSubgroup_maxUnramifiedOutside_le_ker {S : Set (HeightOneSpectrum (𝓞 K))}
    {H : Type*} [Monoid H] [TopologicalSpace H] [T1Space H]
    (φ : AbsoluteGaloisGroup K →ₜ* H)
    (hφ : ∀ (v : HeightOneSpectrum (𝓞 K)), v ∉ S →
      ∀ (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K))
        (g : AbsoluteGaloisGroup (v.adicCompletion K)),
        g ∈ separableClosureInertiaSubgroup (v.adicCompletion K) →
        φ (absoluteGaloisGroupMap τ g) = 1) :
    (maxUnramifiedOutside K (SeparableClosure K) S).fixingSubgroup ≤ φ.toMonoidHom.ker := by
  rw [fixingSubgroup_maxUnramifiedOutside_eq_inertiaOutsideSubgroup]
  exact (inertiaOutsideSubgroup_le_iff_of_isClosed K
    (isClosed_singleton.preimage φ.continuous)).2 hφ

/-- **Universal lift through `G_{K,S}`.** A continuous homomorphism `φ : G_K →ₜ* H` into a `T₁`
topological monoid killing local inertia at every finite place outside `S` factors through
`restrictionS : G_K →ₜ* G_{K,S}`. -/
def liftGaloisGroupS {S : Set (HeightOneSpectrum (𝓞 K))}
    {H : Type*} [Monoid H] [TopologicalSpace H] [T1Space H]
    (φ : AbsoluteGaloisGroup K →ₜ* H)
    (hφ : ∀ (v : HeightOneSpectrum (𝓞 K)), v ∉ S →
      ∀ (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K))
        (g : AbsoluteGaloisGroup (v.adicCompletion K)),
        g ∈ separableClosureInertiaSubgroup (v.adicCompletion K) →
        φ (absoluteGaloisGroupMap τ g) = 1) :
    galoisGroupS K (SeparableClosure K) S →ₜ* H :=
  ContinuousMonoidHom.liftOfIsQuotientMap
    (restrictionS K (SeparableClosure K) S)
    (isQuotientMap_restrictionS K (SeparableClosure K) S)
    φ ((ker_restrictionS K (SeparableClosure K) S).le.trans
      (fixingSubgroup_maxUnramifiedOutside_le_ker K φ hφ))

/-- Evaluating `liftGaloisGroupS φ hφ` on `restrictionS σ` recovers `φ σ`. -/
@[simp]
theorem liftGaloisGroupS_apply_restrict {S : Set (HeightOneSpectrum (𝓞 K))}
    {H : Type*} [Monoid H] [TopologicalSpace H] [T1Space H]
    (φ : AbsoluteGaloisGroup K →ₜ* H)
    (hφ : ∀ (v : HeightOneSpectrum (𝓞 K)), v ∉ S →
      ∀ (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K))
        (g : AbsoluteGaloisGroup (v.adicCompletion K)),
        g ∈ separableClosureInertiaSubgroup (v.adicCompletion K) →
        φ (absoluteGaloisGroupMap τ g) = 1)
    (σ : AbsoluteGaloisGroup K) :
    liftGaloisGroupS K φ hφ (restrictionS K (SeparableClosure K) S σ) = φ σ :=
  ContinuousMonoidHom.liftOfIsQuotientMap_comp_apply _ _ _ _ σ

/-- `liftGaloisGroupS φ hφ` composed with `restrictionS` equals `φ`. -/
@[simp]
theorem liftGaloisGroupS_comp_restrictionS {S : Set (HeightOneSpectrum (𝓞 K))}
    {H : Type*} [Monoid H] [TopologicalSpace H] [T1Space H]
    (φ : AbsoluteGaloisGroup K →ₜ* H)
    (hφ : ∀ (v : HeightOneSpectrum (𝓞 K)), v ∉ S →
      ∀ (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K))
        (g : AbsoluteGaloisGroup (v.adicCompletion K)),
        g ∈ separableClosureInertiaSubgroup (v.adicCompletion K) →
        φ (absoluteGaloisGroupMap τ g) = 1) :
    (liftGaloisGroupS K φ hφ).comp (restrictionS K (SeparableClosure K) S) = φ :=
  ContinuousMonoidHom.liftOfIsQuotientMap_comp _ _ _ _

/-- **Universal property of `G_{K,S}`.** A continuous homomorphism `φ : G_K →ₜ* H` into a `T₁`
topological monoid factors uniquely through `restrictionS : G_K →ₜ* G_{K,S}` whenever it
kills local inertia at every finite place outside `S`. -/
theorem existsUnique_comp_restrictionS_eq {S : Set (HeightOneSpectrum (𝓞 K))}
    {H : Type*} [Monoid H] [TopologicalSpace H] [T1Space H]
    (φ : AbsoluteGaloisGroup K →ₜ* H)
    (hφ : ∀ (v : HeightOneSpectrum (𝓞 K)), v ∉ S →
      ∀ (τ : SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K))
        (g : AbsoluteGaloisGroup (v.adicCompletion K)),
        g ∈ separableClosureInertiaSubgroup (v.adicCompletion K) →
        φ (absoluteGaloisGroupMap τ g) = 1) :
    ∃! ψ : galoisGroupS K (SeparableClosure K) S →ₜ* H,
      ψ.comp (restrictionS K (SeparableClosure K) S) = φ :=
  ⟨liftGaloisGroupS K φ hφ, liftGaloisGroupS_comp_restrictionS K φ hφ, fun _ hψ ↦
    ext_restrictionS K (SeparableClosure K)
      (hψ.trans (liftGaloisGroupS_comp_restrictionS K φ hφ).symm)⟩

section AlgebraicClosure

variable {F : Type*} [Field F] [NumberField F]

/-- **Inertia outside `S` fixes `K_S`.** For a finite place `v ∉ S` and a maximal ideal `Q` of the
integral closure of `𝓞 F` in `F^alg` above `v`, the inertia group `I_Q` fixes the maximal extension
`K_S` unramified outside `S` pointwise. -/
theorem inertiaGroup_le_fixingSubgroup_maxUnramifiedOutside {S : Set (HeightOneSpectrum (𝓞 F))}
    {v : HeightOneSpectrum (𝓞 F)} (hv : v ∉ S)
    (Q : Ideal (integralClosure (𝓞 F) (AlgebraicClosure F))) [Q.IsPrime]
    (hQv : Q.under (𝓞 F) = v.asIdeal) :
    GaloisRep.inertiaGroup F Q ≤
      (maxUnramifiedOutside F (AlgebraicClosure F) S).fixingSubgroup := by
  refine fun σ hσ ↦ (IntermediateField.mem_fixingSubgroup_iff _ σ).2 fun x hx ↦ ?_
  -- `x` lies in a finite subextension unramified outside `S`, hence in its normal closure
  obtain ⟨E, hxE, _, hE⟩ := mem_maxUnramifiedOutside_iff.1 hx
  set E' := normalClosure F E (AlgebraicClosure F)
  have hEE' : E ≤ E' := le_normalClosure E
  have hE'S : E' ≤ maxUnramifiedOutside F (AlgebraicClosure F) S :=
    normalClosure_le_iff_of_normal.2 (le_maxUnramifiedOutside hE)
  have : NumberField E' := NumberField.of_module_finite F E'
  have hv' : v ∉ Chebotarev.ramifiedPrimes F E' :=
    (Chebotarev.notMem_ramifiedPrimes_iff_isUnramifiedIn v).2
      (le_maxUnramifiedOutside_iff.1 hE'S v hv)
  exact (IntermediateField.mem_fixingSubgroup_iff E' σ).1
    (GaloisRep.inertiaGroup_le_fixingSubgroup E' hQv hv' hσ) x (hEE' hxE)

/-- **`H_S` is the smallest closed normal subgroup containing the inertia outside `S`.** If a
closed normal subgroup `H` of `G_F` contains the inertia group `I_Q` at every maximal ideal `Q`
above every finite place `v ∉ S`, then `H` contains `Gal(F^alg / K_S)`. -/
theorem fixingSubgroup_maxUnramifiedOutside_le {S : Set (HeightOneSpectrum (𝓞 F))}
    {H : Subgroup (Field.absoluteGaloisGroup F)} [H.Normal]
    (hH : IsClosed (H : Set (Field.absoluteGaloisGroup F)))
    (hI : ∀ v ∉ S, ∀ Q : Ideal (integralClosure (𝓞 F) (AlgebraicClosure F)), Q.IsMaximal →
      Q.under (𝓞 F) = v.asIdeal → GaloisRep.inertiaGroup F Q ≤ H) :
    (maxUnramifiedOutside F (AlgebraicClosure F) S).fixingSubgroup ≤ H := by
  set E := fixedField H
  have hfix : E.fixingSubgroup = H := TauCeti.fixingSubgroup_fixedField hH
  -- the fixed field of the normal subgroup `H` is normal over `F`
  have : E.fixingSubgroup.Normal := hfix ▸ ‹H.Normal›
  have hEn : Normal F E := ((InfiniteGalois.normal_iff_isGalois E).1 this).to_normal
  -- the fixed field lies in `K_S`
  have hE : E ≤ maxUnramifiedOutside F (AlgebraicClosure F) S := by
    intro x hx
    set L := normalClosure F F⟮x⟯ (AlgebraicClosure F)
    have hxL : F⟮x⟯ ≤ L := le_normalClosure _
    have hLE : L ≤ E := normalClosure_le_iff_of_normal.2 (adjoin_simple_le_iff.2 hx)
    have : FiniteDimensional F F⟮x⟯ :=
      adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral x)
    have : NumberField L := NumberField.of_module_finite F L
    refine le_maxUnramifiedOutside (L := L) (fun v hv ↦ ?_) (hxL (mem_adjoin_simple_self F x))
    refine (Chebotarev.notMem_ramifiedPrimes_iff_isUnramifiedIn v).1
      ((GaloisRep.forall_inertiaGroup_le_fixingSubgroup_iff L v).1 fun Q hQ hQv ↦ ?_)
    exact (hI v hv Q hQ hQv).trans (hfix ▸ fixingSubgroup_antitone hLE)
  rw [← hfix]
  exact fixingSubgroup_antitone hE

end AlgebraicClosure

end TauCeti.RestrictedRamification
