/-!
# The index of an integral primitive element

An integral primitive element `θ` of a number field `K` generates a full-rank subring
`ℤ[θ]` of the ring of integers `𝓞 K`. Its *index* is the finite cardinality

`[𝓞 K : ℤ[θ]] = #(𝓞 K / ℤ[θ])`.

This file defines integral primitive elements and their index, shows that every number field
has one, proves that the defining quotient is finite (and hence that the index is positive), and
establishes the exact invariances under translating the generator by an integer and negating it.

## Main definitions

* `TauCeti.NumberField.IntegralPrimitiveElement K`: integral elements generating `K` over `ℚ`.
* `TauCeti.NumberField.IntegralPrimitiveElement.index`: the index of `ℤ[θ]` in `𝓞 K`.
* `TauCeti.NumberField.IntegralPrimitiveElement.ofAdjoinEqTop`: an element generating `𝓞 K` as a
  `ℤ`-algebra, as an integral primitive element.

## Main results

* `TauCeti.NumberField.IntegralPrimitiveElement.natDegree_minpoly`: the minimal polynomial of
  `θ` over `ℤ` has degree `[K : ℚ]`.
* `TauCeti.NumberField.IntegralPrimitiveElement.finrank_adjoin`: `ℤ[θ]` has full rank in `𝓞 K`.
* `TauCeti.NumberField.IntegralPrimitiveElement.index_pos`: the index is positive.
* `TauCeti.NumberField.IntegralPrimitiveElement.index_eq_one_iff`: the index is `1` exactly when
  `ℤ[θ]` is all of `𝓞 K`.
* `TauCeti.NumberField.IntegralPrimitiveElement.index_eq_one_of_finrank_eq_one`: in a number field
  of degree one, in particular in `ℚ` (`IntegralPrimitiveElement.index_rat`), every index is `1`.
* `TauCeti.NumberField.adjoin_rat_eq_top_of_adjoin_int_eq_top`: an element generating `𝓞 K` over
  `ℤ` generates `K` over `ℚ`.
* `TauCeti.NumberField.IntegralPrimitiveElement.index_addIntCast`: integer translation preserves
  the index.
* `TauCeti.NumberField.IntegralPrimitiveElement.index_neg`: negation preserves the index.
* `TauCeti.NumberField.IntegralPrimitiveElement.mem_adjoin_iff`: the elements of `ℤ[θ]` are the
  polynomial expressions in `θ`.
* `TauCeti.NumberField.IntegralPrimitiveElement.mkQ_eq_zero_iff`: an element vanishes in
  `𝓞 K / ℤ[θ]` exactly when it lies in `ℤ[θ]`.
* `TauCeti.NumberField.IntegralPrimitiveElement.dvd_index_of_natCast_mul_mem_adjoin`: if some
  `β ∉ ℤ[θ]` has `p β ∈ ℤ[θ]` for a prime `p`, then `p` divides the index.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter I, §2.
-/

public section

open scoped NumberField

namespace TauCeti.NumberField

variable {K : Type*} [Field K] [NumberField K]

/-- An integral primitive element of a number field `K`: an element of `𝓞 K` whose image in
`K` generates `K` as a `ℚ`-algebra. -/
@[expose]
def IntegralPrimitiveElement (K : Type*) [Field K] [NumberField K] : Type _ :=
  {θ : 𝓞 K // Algebra.adjoin ℚ {(θ : K)} = ⊤}

/-- An element whose order `ℤ[θ]` is all of `𝓞 K` generates `K` over `ℚ`. -/
theorem adjoin_rat_eq_top_of_adjoin_int_eq_top {θ : 𝓞 K}
    (h : Algebra.adjoin ℤ {θ} = (⊤ : Subalgebra ℤ (𝓞 K))) :
    Algebra.adjoin ℚ {(θ : K)} = ⊤ := by
  rw [← IntermediateField.adjoin_eq_top_iff_of_isAlgebraic (fun x _ ↦ IsAlgebraic.of_finite ℚ x)]
  exact TauCeti.IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top (K := ℚ) (L := K) h

namespace IntegralPrimitiveElement

instance : Coe (IntegralPrimitiveElement K) (𝓞 K) :=
  ⟨Subtype.val⟩

/-- Every number field has an integral primitive element: an integer multiple of a primitive
element is integral and still generates `K`. -/
instance : Nonempty (IntegralPrimitiveElement K) := by
  obtain ⟨x, hx⟩ := Field.exists_primitive_element ℚ K
  obtain ⟨y, hy0, hy⟩ := exists_integral_multiples ℤ ℚ {x}
  obtain ⟨θ, hθ⟩ : ∃ θ : 𝓞 K, (θ : K) = y • x :=
    ⟨⟨y • x, hy x (Finset.mem_singleton_self x)⟩, rfl⟩
  refine ⟨⟨θ, ?_⟩⟩
  rw [hθ, zsmul_eq_mul, ← map_intCast (algebraMap ℚ K), mul_comm,
    ← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic (IsAlgebraic.of_finite ℚ _),
    IntermediateField.adjoin_simple_mul_algebraMap _ _ (Int.cast_ne_zero.mpr hy0), hx,
    IntermediateField.top_toSubalgebra]

/-- The `ℤ`-subalgebra of `𝓞 K` generated by an integral primitive element. -/
def adjoin (θ : IntegralPrimitiveElement K) : Subalgebra ℤ (𝓞 K) :=
  Algebra.adjoin ℤ {θ.val}

/-- The generated order is the `ℤ`-subalgebra generated by the underlying ring integer. -/
theorem adjoin_def (θ : IntegralPrimitiveElement K) :
    θ.adjoin = Algebra.adjoin ℤ {θ.val} :=
  (rfl)

/-- The elements of `ℤ[θ]` are the polynomial expressions in `θ`. -/
theorem mem_adjoin_iff (θ : IntegralPrimitiveElement K) (x : 𝓞 K) :
    x ∈ θ.adjoin ↔ ∃ G : Polynomial ℤ, Polynomial.aeval θ.val G = x := by
  rw [adjoin_def, Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range]

/-- Every polynomial expression in `θ` lies in `ℤ[θ]`. -/
@[simp]
theorem aeval_mem_adjoin (θ : IntegralPrimitiveElement K) (G : Polynomial ℤ) :
    Polynomial.aeval θ.val G ∈ θ.adjoin :=
  (θ.mem_adjoin_iff _).mpr ⟨G, rfl⟩

/-- The additive quotient of `𝓞 K` by the order `ℤ[θ]`. -/
abbrev Quotient (θ : IntegralPrimitiveElement K) :=
  𝓞 K ⧸ θ.adjoin.toSubmodule

/-- The index `[𝓞 K : ℤ[θ]]`, defined as the cardinality of the additive quotient. -/
noncomputable def index (θ : IntegralPrimitiveElement K) : ℕ :=
  θ.adjoin.toSubmodule.cardQuot

/-- The index is the cardinality of the additive quotient by the generated order. -/
theorem index_def (θ : IntegralPrimitiveElement K) :
    θ.index = Nat.card (𝓞 K ⧸ θ.adjoin.toSubmodule) :=
  Submodule.cardQuot_apply θ.adjoin.toSubmodule

/-- An element vanishes in the quotient `𝓞 K / ℤ[θ]` exactly when it lies in the order `ℤ[θ]`. -/
-- Not a `simp` lemma: `simp` already proves it from `Submodule.mkQ_apply`,
-- `Submodule.Quotient.mk_eq_zero` and `Subalgebra.mem_toSubmodule`, so `simpNF` rejects the tag.
theorem mkQ_eq_zero_iff (θ : IntegralPrimitiveElement K) (b : 𝓞 K) :
    (θ.adjoin.toSubmodule.mkQ b : θ.Quotient) = 0 ↔ b ∈ θ.adjoin := by
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Subalgebra.mem_toSubmodule]

/-- A multiple `n • b` vanishes in the quotient `𝓞 K / ℤ[θ]` exactly when `n * b` lies in the
order `ℤ[θ]`. -/
theorem nsmul_mkQ_eq_zero_iff (θ : IntegralPrimitiveElement K) (n : ℕ) (b : 𝓞 K) :
    (n • θ.adjoin.toSubmodule.mkQ b : θ.Quotient) = 0 ↔ (n : 𝓞 K) * b ∈ θ.adjoin := by
  rw [← map_nsmul, mkQ_eq_zero_iff, nsmul_eq_mul]

/-- For a prime `p`, if some `β ∈ 𝓞 K` outside `ℤ[θ]` has `p β ∈ ℤ[θ]`, then `p` divides the index
of `ℤ[θ]`. -/
theorem dvd_index_of_natCast_mul_mem_adjoin (θ : IntegralPrimitiveElement K) {p : ℕ}
    [Fact p.Prime] {β : 𝓞 K} (hβ : β ∉ θ.adjoin) (hpβ : (p : 𝓞 K) * β ∈ θ.adjoin) :
    p ∣ θ.index := by
  have hq0 : θ.adjoin.toSubmodule.mkQ β ≠ 0 := by
    rw [Ne, mkQ_eq_zero_iff]
    exact hβ
  have hpq : p • θ.adjoin.toSubmodule.mkQ β = 0 := by
    rw [nsmul_mkQ_eq_zero_iff]
    exact hpβ
  rw [index_def, ← addOrderOf_eq_prime hpq hq0]
  exact addOrderOf_dvd_natCard _

/-- The minimal polynomial over `ℤ` of an integral primitive element has degree `[K : ℚ]`. -/
theorem natDegree_minpoly (θ : IntegralPrimitiveElement K) :
    (minpoly ℤ θ.val).natDegree = Module.finrank ℚ K := by
  have hθ : IntermediateField.adjoin ℚ {(θ.val : K)} = ⊤ := by
    apply (IntermediateField.adjoin_eq_top_iff_of_isAlgebraic ?_).mpr θ.property
    exact fun x _ ↦ IsAlgebraic.of_finite ℚ x
  rw [← (minpoly.monic θ.val.isIntegral).natDegree_map (algebraMap ℤ ℚ),
    ← _root_.NumberField.RingOfIntegers.minpoly_rat_coe]
  exact (Field.primitive_element_iff_minpoly_natDegree_eq ℚ (θ.val : K)).mp hθ

/-- The order `ℤ[θ]` generated by an integral primitive element has full rank in `𝓞 K`. -/
theorem finrank_adjoin (θ : IntegralPrimitiveElement K) :
    Module.finrank ℤ θ.adjoin = Module.finrank ℤ (𝓞 K) := by
  rw [adjoin_def, (Algebra.adjoin.powerBasis' θ.val.isIntegral).finrank,
    Algebra.adjoin.powerBasis'_dim, natDegree_minpoly,
    _root_.NumberField.RingOfIntegers.rank]

/-- The quotient `𝓞 K / ℤ[θ]` is finite. -/
instance finite_quotient (θ : IntegralPrimitiveElement K) : Finite θ.Quotient :=
  Submodule.finiteQuotientOfFreeOfRankEq θ.adjoin.toSubmodule θ.finrank_adjoin

/-- The index of an integral primitive element is positive. -/
theorem index_pos (θ : IntegralPrimitiveElement K) : 0 < θ.index := by
  rw [index, Submodule.cardQuot_apply]
  exact Nat.card_pos

/-- The index of an integral primitive element `θ` is `1` exactly when the order `ℤ[θ]` is all of
`𝓞 K`. -/
@[simp]
theorem index_eq_one_iff (θ : IntegralPrimitiveElement K) : θ.index = 1 ↔ θ.adjoin = ⊤ := by
  rw [index, Submodule.cardQuot_eq_one_iff, Algebra.toSubmodule_eq_top]

/-- An element generating `𝓞 K` as a `ℤ`-algebra, as an integral primitive element. -/
def ofAdjoinEqTop {θ : 𝓞 K} (h : Algebra.adjoin ℤ {θ} = (⊤ : Subalgebra ℤ (𝓞 K))) :
    IntegralPrimitiveElement K :=
  ⟨θ, adjoin_rat_eq_top_of_adjoin_int_eq_top h⟩

@[simp]
theorem coe_ofAdjoinEqTop {θ : 𝓞 K} (h : Algebra.adjoin ℤ {θ} = (⊤ : Subalgebra ℤ (𝓞 K))) :
    (ofAdjoinEqTop h : 𝓞 K) = θ :=
  (rfl)

/-- The order generated by `ofAdjoinEqTop h` is all of `𝓞 K`, by construction. -/
@[simp]
theorem adjoin_ofAdjoinEqTop {θ : 𝓞 K} (h : Algebra.adjoin ℤ {θ} = (⊤ : Subalgebra ℤ (𝓞 K))) :
    (ofAdjoinEqTop h).adjoin = ⊤ :=
  h

/-- An element generating `𝓞 K` as a `ℤ`-algebra has index `1`. -/
@[simp]
theorem index_ofAdjoinEqTop {θ : 𝓞 K} (h : Algebra.adjoin ℤ {θ} = (⊤ : Subalgebra ℤ (𝓞 K))) :
    (ofAdjoinEqTop h).index = 1 :=
  (index_eq_one_iff _).mpr (adjoin_ofAdjoinEqTop h)

/-- In a number field of degree one over `ℚ`, every integral primitive element has index `1`. -/
theorem index_eq_one_of_finrank_eq_one (h : Module.finrank ℚ K = 1)
    (θ : IntegralPrimitiveElement K) : θ.index = 1 := by
  have hbij : Function.Bijective (algebraMap ℤ (𝓞 K)) :=
    Module.Free.bijective_algebraMap_of_finrank_eq_one
      ((_root_.NumberField.RingOfIntegers.rank K).trans h)
  refine (index_eq_one_iff θ).mpr (eq_top_iff.mpr fun x _ ↦ ?_)
  obtain ⟨n, rfl⟩ := hbij.2 x
  exact Subalgebra.algebraMap_mem _ n

/-- Every integral primitive element of `ℚ` has index `1`. -/
@[simp]
theorem index_rat (θ : IntegralPrimitiveElement ℚ) : θ.index = 1 :=
  index_eq_one_of_finrank_eq_one (Module.finrank_self ℚ) θ

/-! ### Changing the generator -/

/-- Translating an integral primitive element by an integer gives another integral primitive
element. -/
def addIntCast (θ : IntegralPrimitiveElement K) (n : ℤ) : IntegralPrimitiveElement K :=
  ⟨θ.val + algebraMap ℤ (𝓞 K) n, by
    have h : Algebra.adjoin ℚ {(θ.val : K) + (n : K)} =
        Algebra.adjoin ℚ {(θ.val : K)} := by
      have hn : ((n : K)) = algebraMap ℚ K (n : ℚ) := (map_intCast (algebraMap ℚ K) n).symm
      rw [hn, ← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
          (IsAlgebraic.of_finite ℚ ((θ.val : K) + algebraMap ℚ K (n : ℚ))),
        IntermediateField.adjoin_simple_add_algebraMap,
        IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
          (IsAlgebraic.of_finite ℚ (θ.val : K))]
    have hcoe : ((θ.val + algebraMap ℤ (𝓞 K) n : 𝓞 K) : K) =
        (θ.val : K) + (n : K) := by
      calc
        _ = algebraMap (𝓞 K) K θ.val +
            algebraMap (𝓞 K) K (algebraMap ℤ (𝓞 K) n) :=
          map_add (algebraMap (𝓞 K) K) _ _
        _ = (θ.val : K) + (n : K) := by
          rw [← IsScalarTower.algebraMap_apply ℤ (𝓞 K) K]
          rw [_root_.NumberField.RingOfIntegers.coe_eq_algebraMap]
          rfl
    rw [hcoe]
    exact h.trans θ.property⟩

@[simp]
theorem coe_addIntCast (θ : IntegralPrimitiveElement K) (n : ℤ) :
    (θ.addIntCast n : 𝓞 K) = θ.val + algebraMap ℤ (𝓞 K) n :=
  (rfl)

/-- Integer translation does not change the generated `ℤ`-subalgebra. -/
@[simp]
theorem adjoin_addIntCast (θ : IntegralPrimitiveElement K) (n : ℤ) :
    (θ.addIntCast n).adjoin = θ.adjoin := by
  simp only [adjoin_def, coe_addIntCast]
  apply le_antisymm
  · rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
    exact (Algebra.adjoin ℤ {θ.val}).add_mem
      (Algebra.subset_adjoin (Set.mem_singleton θ.val))
      ((Algebra.adjoin ℤ {θ.val}).algebraMap_mem n)
  · rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
    simpa using (Algebra.adjoin ℤ {θ.val + algebraMap ℤ (𝓞 K) n}).sub_mem
      (Algebra.subset_adjoin (Set.mem_singleton (θ.val + algebraMap ℤ (𝓞 K) n)))
      ((Algebra.adjoin ℤ {θ.val + algebraMap ℤ (𝓞 K) n}).algebraMap_mem n)

/-- Translating an integral primitive element by an integer preserves its index. -/
@[simp]
theorem index_addIntCast (θ : IntegralPrimitiveElement K) (n : ℤ) :
    (θ.addIntCast n).index = θ.index := by
  rw [index, index, adjoin_addIntCast]

/-- Negating an integral primitive element gives another integral primitive element. -/
protected def neg (θ : IntegralPrimitiveElement K) : IntegralPrimitiveElement K :=
  ⟨-θ.val, by
    have h : Algebra.adjoin ℚ {-((θ.val : K))} = Algebra.adjoin ℚ {(θ.val : K)} := by
      have hmul : -((θ.val : K)) = (θ.val : K) * algebraMap ℚ K (-1 : ℚ) := by
        rw [map_neg, map_one, mul_neg_one]
      rw [hmul, ← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
          (IsAlgebraic.of_finite ℚ ((θ.val : K) * algebraMap ℚ K (-1 : ℚ))),
        IntermediateField.adjoin_simple_mul_algebraMap _ _ (neg_ne_zero.mpr one_ne_zero),
        IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
          (IsAlgebraic.of_finite ℚ (θ.val : K))]
    have hcoe : ((-θ.val : 𝓞 K) : K) = -(θ.val : K) := by
      exact map_neg (algebraMap (𝓞 K) K) θ.val
    rw [hcoe]
    exact h.trans θ.property⟩

instance : Neg (IntegralPrimitiveElement K) :=
  ⟨IntegralPrimitiveElement.neg⟩

@[simp]
theorem coe_neg (θ : IntegralPrimitiveElement K) :
    ((-θ : IntegralPrimitiveElement K) : 𝓞 K) = -θ.val :=
  (rfl)

/-- Negation does not change the generated `ℤ`-subalgebra. -/
@[simp]
theorem adjoin_neg (θ : IntegralPrimitiveElement K) : (-θ).adjoin = θ.adjoin := by
  simp only [adjoin_def, coe_neg]
  apply le_antisymm
  · rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
    exact (Algebra.adjoin ℤ {θ.val}).neg_mem
      (Algebra.subset_adjoin (Set.mem_singleton θ.val))
  · rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
    simpa using (Algebra.adjoin ℤ {-θ.val}).neg_mem
      (Algebra.subset_adjoin (Set.mem_singleton (-θ.val)))

/-- Negating an integral primitive element preserves its index. -/
@[simp]
theorem index_neg (θ : IntegralPrimitiveElement K) : (-θ).index = θ.index := by
  rw [index, index, adjoin_neg]

end IntegralPrimitiveElement

end TauCeti.NumberField
