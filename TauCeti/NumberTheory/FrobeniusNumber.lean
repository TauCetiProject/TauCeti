module

public import Mathlib.NumberTheory.FrobeniusNumber
public import Mathlib.Order.Filter.AtTopBot.Basic

/-!
# Additively closed sets of natural numbers

A set `s` of natural numbers that is closed under addition contains every sufficiently large
multiple of its gcd `Nat.setGcd s`. In particular, if `Nat.setGcd s = 1` then `s` contains every
sufficiently large natural number. This is the number-theoretic input to the eventual positivity
of the return probabilities of an aperiodic state of a Markov chain.

The proof reads the statement off Mathlib's `Nat.exists_mem_closure_of_ge`, which says the same
thing for the additive submonoid generated by `s`: an additively closed set differs from the
submonoid it generates at most by the element `0`.

For its use in the theory of aperiodic chains, see J. R. Norris, *Markov Chains* (1997), §1.8.
-/

public section

open Filter

namespace Nat

variable {s : Set ℕ}

/-- Taking the additive submonoid closure does not change the gcd of a set. -/
@[simp]
theorem setGcd_closure (s : Set ℕ) : setGcd (AddSubmonoid.closure s) = setGcd s :=
  dvd_antisymm (setGcd_mono AddSubmonoid.subset_closure)
    (dvd_setGcd_iff.mpr fun _ hn ↦ setGcd_dvd_of_mem_closure hn)

/-- The gcd of a two-element set is the gcd of its elements. -/
@[simp]
theorem setGcd_pair (a b : ℕ) : setGcd ({a, b} : Set ℕ) = a.gcd b := by
  apply dvd_antisymm
  · exact dvd_gcd (setGcd_dvd_of_mem (by simp)) (setGcd_dvd_of_mem (by simp))
  · exact dvd_setGcd_iff.mpr (by simp [gcd_dvd_left, gcd_dvd_right])

/-- A set of natural numbers closed under addition contains every sufficiently large multiple
of its gcd. When `s` has no nonzero element, `Nat.setGcd s = 0` and the statement is vacuous. -/
theorem eventually_mem_of_setGcd_dvd (hs : ∀ a ∈ s, ∀ b ∈ s, a + b ∈ s) :
    ∀ᶠ m in atTop, setGcd s ∣ m → m ∈ s := by
  obtain ⟨n, hn⟩ := exists_mem_closure_of_ge s
  filter_upwards [eventually_ge_atTop (max n 1)] with m hm hdvd
  -- The additive submonoid generated by `s` is `s` together with `0`, and `m ≠ 0`.
  let S : AddSubsemigroup ℕ := ⟨s, fun ha hb ↦ hs _ ha _ hb⟩
  have key : (AddSubmonoid.closure s : Set ℕ) = {0} ∪ s := by
    rw [AddSubmonoid.closure_eq_zero_union, show s = S from rfl, AddSubsemigroup.closure_eq]
  have hm' := hn m (le_of_max_le_left hm) hdvd
  rw [← SetLike.mem_coe, key] at hm'
  exact hm'.resolve_left (by grind)

/-- **The additive-semigroup lemma.** A set of natural numbers that is closed under addition
and has gcd one contains every sufficiently large natural number. -/
theorem eventually_mem_of_setGcd_eq_one (hs : ∀ a ∈ s, ∀ b ∈ s, a + b ∈ s)
    (h : setGcd s = 1) : ∀ᶠ m in atTop, m ∈ s := by
  filter_upwards [eventually_mem_of_setGcd_dvd hs] with m hm
  exact hm (h ▸ one_dvd m)

end Nat
