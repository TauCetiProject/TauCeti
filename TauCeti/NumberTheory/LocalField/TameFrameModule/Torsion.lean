module

public import TauCeti.Algebra.Module.Torsion.PrimaryComponent
public import TauCeti.Algebra.MonoidAlgebra.Basic
public import TauCeti.NumberTheory.LocalField.TameFrameModule.Rational
public import TauCeti.NumberTheory.Padics.MultiplicativeCompletion.TameFrameExponents

/-!
# Torsion of the tame-frame module

Let `G` be a finite group generated by `σ, τ`, let `a, b` be scalars of a commutative ring `R`,
and let `J = R[G]·(σ - a) + R[G]·(τ - b)` be the left ideal of the two eigenvalue relations. This
file computes the `p`-power torsion of the tame-frame module

`M₀ = R[G]² / R[G]·(σ - a, τ - b)`

when the relation map `x ↦ x · (σ - a, τ - b)` is injective, multiplication by `p` is injective
on `R`, and the scalars in `J` are exactly the multiples of `p ^ k`: the torsion is `R[G] ⧸ J`,
as a left `R[G]`-module.

Modulo `J` every group element `g` is a scalar `c(g)`, and `c` is multiplicative modulo `p ^ k`.
The twisted norm `x = ∑_g c(g) g⁻¹` then satisfies `x (σ - a) ≡ 0` and `x (τ - b) ≡ 0` modulo
`p ^ k`, so `x · (σ - a, τ - b) = p ^ k y₀` for some `y₀ ∈ R[G]²`. The class `t₀` of `y₀` is killed
by `p ^ k`, its annihilator is exactly `J`, and every `p`-power torsion element of `M₀` is a scalar
multiple of `t₀`. The last point rests on the fact that, since `σ, τ` generate `G`, a `w` with
`w (σ - a)` and `w (τ - b)` divisible by `p ^ n` has `w J` divisible by `p ^ n`.

For `R = ℤ_p` and natural-number exponents, finiteness of `ℤ_p[G] ⧸ J` is enough: the scalars in
`J` then form a nonzero ideal of `ℤ_p`, a power of `(p)`. With the sharp exponents of a tame frame
on a layer `L/K` (`TauCeti.exists_tameFrame_exponents`), `ℤ_p[G] ⧸ J` is the `p`-power torsion
of the `p`-adic completion `A(L)` of `Lˣ`, that is `μ_{p^∞}(L)` with its Galois action. So the
tame-frame module has the same `p`-power torsion as `A(L)`, the arithmetic input of the comparison
of the Tate module of the layer with `M₀ ⊕ ℤ_p[G]^N` in the proof of NSW (7.4.1).

## Main results

* `TauCeti.nonempty_tameFrameModule_torsion_linearEquiv_of_relationMap_injective`: the
  `p`-power torsion of `M₀` is `R[G] ⧸ J`, for an injective relation map and an ideal `J`
  whose scalars are the multiples of `p ^ k`.
* `TauCeti.nonempty_tameFrameModule_torsion_linearEquiv`: the same over `ℤ_p`, when
  `ℤ_p[G] ⧸ J` is finite.
* `TauCeti.tameFrameModule_torsion_linearEquiv`: for supplied sharp exponents of a tame frame,
  the `p`-power torsion of `M₀` is that of `A(L)`.
* `TauCeti.exists_tameFrameModule_torsion_linearEquiv`: for a tame frame of `L/K`, there are
  sharp exponents for which the `p`-power torsion of `M₀` is that of `A(L)`.

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, proof of (7.4.1).
-/

public section

namespace TauCeti

open _root_.MonoidAlgebra

universe u v

variable {R : Type u} [CommRing R] {G : Type v} [Group G]

section TwistedNorm

variable [Finite G]

/-- The twisted norm element `∑_g c(g) g⁻¹` of a function `c : G → R`. When `g ≡ c(g)` modulo
`J = (σ - a, τ - b)` for every `g`, its image `x · (σ - a, τ - b)` under the tame-frame relation
map is `p ^ k y₀`, where `p ^ k` generates the scalars in `J`, and the class of `y₀` generates the
`p`-power torsion of the tame-frame module. -/
private noncomputable def twistedNorm (c : G → R) : MonoidAlgebra R G :=
  ofCoeff (Finsupp.equivFunOnFinite.symm fun h ↦ c h⁻¹)

private theorem coeff_twistedNorm (c : G → R) (h : G) : (twistedNorm c).coeff h = c h⁻¹ := by
  simp [twistedNorm]

end TwistedNorm

section Lifts

variable {J : Ideal (MonoidAlgebra R G)} {q : R}

/-- A scalar lies in `J` exactly when the generator of the scalars in `J` divides it. -/
private theorem single_one_mem_iff_dvd
    (hJ : Ideal.comap (algebraMap R (MonoidAlgebra R G)) J = Ideal.span {q}) (r : R) :
    single 1 r ∈ J ↔ q ∣ r := by
  rw [← Ideal.mem_span_singleton, ← hJ, Ideal.mem_comap, coe_algebraMap, Function.comp_apply,
    Algebra.algebraMap_self, RingHom.id_apply]

variable {c : G → R} (hJ : Ideal.comap (algebraMap R (MonoidAlgebra R G)) J = Ideal.span {q})
  (hc : ∀ g, single g (1 : R) - single 1 (c g) ∈ J)
include hJ hc

/-- If `s` acts as the scalar `e` modulo `J`, then `e ≡ c(s)` modulo the scalars in `J`. -/
private theorem dvd_sub_of_single_sub_mem {s : G} {e : R} (hs : single s (1 : R) - single 1 e ∈ J) :
    q ∣ c s - e := by
  rw [← single_one_mem_iff_dvd hJ, single_sub]
  convert J.sub_mem hs (hc s) using 1
  abel

/-- The scalars `c(g)` through which `G` acts modulo `J` are multiplicative modulo `q`. -/
private theorem dvd_mul_sub_mul (g h : G) : q ∣ c (g * h) - c g * c h := by
  rw [← single_one_mem_iff_dvd hJ, single_sub]
  convert J.sub_mem (J.add_mem (J.mul_mem_left (single g 1) (hc h))
    (J.mul_mem_left (single 1 (c h)) (hc g))) (hc (g * h)) using 1
  simp only [mul_sub, single_mul_single, one_mul, mul_one, mul_comm (c h)]
  abel

variable [Finite G]

/-- The twisted norm is an eigenvector for left multiplication modulo `q`. -/
private theorem dvd_coeff_mul_twistedNorm {s : G} {e : R}
    (hs : single s (1 : R) - single 1 e ∈ J) (h : G) :
    q ∣ ((single s (1 : R) - single 1 e) * twistedNorm c).coeff h := by
  simp only [sub_mul, coeff_sub, Finsupp.sub_apply, coeff_single_mul_apply, coeff_twistedNorm,
    one_mul, inv_one, mul_inv_rev, inv_inv]
  have : c (h⁻¹ * s) - e * c h⁻¹ = (c (h⁻¹ * s) - c h⁻¹ * c s) + c h⁻¹ * (c s - e) := by ring
  rw [this]
  exact dvd_add (dvd_mul_sub_mul hJ hc _ _)
    (dvd_mul_of_dvd_right (dvd_sub_of_single_sub_mem hJ hc hs) _)

/-- The twisted norm is an eigenvector for right multiplication modulo `q`. -/
private theorem dvd_coeff_twistedNorm_mul {s : G} {e : R}
    (hs : single s (1 : R) - single 1 e ∈ J) (h : G) :
    q ∣ (twistedNorm c * (single s (1 : R) - single 1 e)).coeff h := by
  simp only [mul_sub, coeff_sub, Finsupp.sub_apply, coeff_mul_single_apply, coeff_twistedNorm,
    mul_one, inv_one, mul_inv_rev, inv_inv]
  have : c (s * h⁻¹) - c h⁻¹ * e = (c (s * h⁻¹) - c s * c h⁻¹) + c h⁻¹ * (c s - e) := by ring
  rw [this]
  exact dvd_add (dvd_mul_sub_mul hJ hc _ _)
    (dvd_mul_of_dvd_right (dvd_sub_of_single_sub_mem hJ hc hs) _)

end Lifts

omit [Group G] in
private theorem coeff_nsmul (n : ℕ) (u : MonoidAlgebra R G) (g : G) :
    (n • u).coeff g = n * u.coeff g := by
  rw [coeff_smul_apply, nsmul_eq_mul]

private theorem isSMulRegular_relationModule {n : ℕ} (hn : IsSMulRegular R n) :
    IsSMulRegular (Fin 2 →₀ MonoidAlgebra R G) n :=
  (hn.finsupp.of_injective
    MonoidAlgebra.coeffAddEquiv.toAddMonoidHom.toNatLinearMap
    MonoidAlgebra.coeff_injective).finsupp

section RightMultiple

variable {σ τ : G} {a b : R}

/-- When `σ, τ` generate `G`, every element of `R[G]` is a scalar modulo the left ideal
`(σ - a, τ - b)`. -/
private theorem exists_sub_single_one_mem (hgen : Submonoid.closure {σ, τ} = ⊤)
    (x : MonoidAlgebra R G) : ∃ e : R,
      x - single 1 e ∈ Ideal.span {single σ (1 : R) - single 1 a, single τ 1 - single 1 b} := by
  obtain ⟨e, he⟩ := MonoidAlgebra.toSpanSingleton_mk_one_surjective (a := a) (b := b) hgen
    (Submodule.Quotient.mk x)
  refine ⟨e, ?_⟩
  rw [LinearMap.toSpanSingleton_apply, ← Submodule.Quotient.mk_smul, Submodule.Quotient.eq,
    one_def, smul_single', mul_one] at he
  have := neg_mem he
  rwa [neg_sub] at this

/-- If `w (σ - a)` and `w (τ - b)` are divisible by `n` and `σ, τ` generate `G`, then `w x` is
divisible by `n` for every `x` in the left ideal `(σ - a, τ - b)`. -/
private theorem exists_mul_eq_nsmul_of_mem (hgen : Submonoid.closure {σ, τ} = ⊤) {n : ℕ}
    {w : MonoidAlgebra R G} (hσ : ∃ v, w * (single σ (1 : R) - single 1 a) = n • v)
    (hτ : ∃ v, w * (single τ (1 : R) - single 1 b) = n • v) {x : MonoidAlgebra R G}
    (hx : x ∈ Ideal.span {single σ (1 : R) - single 1 a, single τ 1 - single 1 b}) :
    ∃ u, w * x = n • u := by
  -- Modulo `n`, every right multiple of `w` is a scalar multiple of `w`.
  have hsingle (g : G) : ∃ e : R, ∃ u, w * single g 1 - e • w = n • u := by
    have hg : g ∈ Submonoid.closure {σ, τ} := hgen ▸ Submonoid.mem_top g
    induction hg using Submonoid.closure_induction_left with
    | one => exact ⟨1, 0, by simp [← one_def]⟩
    | mul_left s hs h _ ih =>
      obtain ⟨e, u, hu⟩ := ih
      obtain ⟨e', v, hv⟩ : ∃ e' : R, ∃ v, w * (single s (1 : R) - single 1 e') = n • v := by
        rcases hs with rfl | rfl
        exacts [⟨a, hσ⟩, ⟨b, hτ⟩]
      refine ⟨e' * e, v * single h 1 + e' • u, ?_⟩
      have he' : w * single 1 e' = e' • w := by
        ext
        simp [mul_comm]
      have hs' : w * single s 1 = n • v + e' • w := by
        rw [← hv, mul_sub, he', sub_add_cancel]
      -- Expose the two basis factors so the induction hypothesis rewrites the right factor.
      rw [show single (s * h) (1 : R) = single s 1 * single h 1 by simp, ← mul_assoc, hs', add_mul,
        smul_mul_assoc, smul_mul_assoc, smul_add, ← smul_comm e' n u, ← hu, smul_sub, smul_smul]
      abel
  have hall (y : MonoidAlgebra R G) : ∃ e : R, ∃ u, w * y - e • w = n • u := by
    induction y using induction_linear with
    | zero => exact ⟨0, 0, by simp⟩
    | add y z hy hz =>
      obtain ⟨e, u, hu⟩ := hy
      obtain ⟨e', u', hu'⟩ := hz
      exact ⟨e + e', u + u', by rw [mul_add, add_smul, smul_add, ← hu, ← hu']; abel⟩
    | single g r =>
      obtain ⟨e, u, hu⟩ := hsingle g
      refine ⟨r * e, r • u, ?_⟩
      -- Express the coefficient-`r` basis term as a scalar multiple of the normalized one.
      rw [← smul_comm r n u, ← hu, smul_sub, smul_smul,
        show single g r = r • single g (1 : R) by rw [smul_single', mul_one], mul_smul_comm]
  obtain ⟨y, z, rfl⟩ := Submodule.mem_span_pair.mp hx
  obtain ⟨e, u, hu⟩ := hall y
  obtain ⟨e', u', hu'⟩ := hall z
  obtain ⟨v, hv⟩ := hσ
  obtain ⟨v', hv'⟩ := hτ
  have hy : w * y = n • u + e • w := by rw [← hu]; abel
  have hz : w * z = n • u' + e' • w := by rw [← hu']; abel
  refine ⟨u * (single σ 1 - single 1 a) + e • v + u' * (single τ 1 - single 1 b) + e' • v', ?_⟩
  rw [smul_eq_mul, smul_eq_mul, mul_add, ← mul_assoc, ← mul_assoc, hy, hz, add_mul, add_mul,
    smul_mul_assoc, smul_mul_assoc, smul_mul_assoc, smul_mul_assoc, hv, hv', smul_comm e n v,
    smul_comm e' n v']
  simp only [smul_add]
  abel

end RightMultiple

section Torsion

variable {σ τ : G} {a b : R}

/-- Divisibility of the two coordinates of the relation map. -/
private theorem exists_tameFrameRelationMap_eq_nsmul {n : ℕ} {x : MonoidAlgebra R G}
    (h₀ : ∀ g, (n : R) ∣ (x * (single σ (1 : R) - single 1 a)).coeff g)
    (h₁ : ∀ g, (n : R) ∣ (x * (single τ (1 : R) - single 1 b)).coeff g) :
    ∃ y, tameFrameRelationMap R G σ τ a b x = n • y := by
  obtain ⟨u₀, hu₀⟩ := MonoidAlgebra.exists_eq_nsmul_of_dvd_coeff h₀
  obtain ⟨u₁, hu₁⟩ := MonoidAlgebra.exists_eq_nsmul_of_dvd_coeff h₁
  refine ⟨Finsupp.single 0 u₀ + Finsupp.single 1 u₁, ?_⟩
  ext i : 1
  fin_cases i <;> simp [hu₀, hu₁]

/-- If the relation map sends `w` to `n • y`, then `x` kills the class of `y` in the tame-frame
module exactly when `x w` is divisible by `n`. -/
private theorem smul_toQuotient_eq_zero_iff {n : ℕ} (hn : IsSMulRegular R n)
    (hinj : Function.Injective (tameFrameRelationMap R G σ τ a b)) {w : MonoidAlgebra R G}
    {y : Fin 2 →₀ MonoidAlgebra R G} (hy : tameFrameRelationMap R G σ τ a b w = n • y)
    (x : MonoidAlgebra R G) :
    x • (tameFrameRelations R G σ τ a b).toQuotient y = 0 ↔ ∃ u, x * w = n • u := by
  rw [← map_smul, ← LinearMap.mem_ker, Module.Relations.ker_toQuotient,
    ← range_tameFrameRelationMap, LinearMap.mem_range]
  constructor
  · rintro ⟨u, hu⟩
    refine ⟨u, hinj ?_⟩
    rw [map_nsmul, hu, ← smul_eq_mul, map_smul, hy, smul_comm]
  · rintro ⟨u, hu⟩
    exact ⟨u, isSMulRegular_relationModule hn (by
      -- Applying the injectivity of `(n • ·)` leaves its lambda unreduced.
      beta_reduce
      rw [← map_nsmul, ← hu, ← smul_eq_mul, map_smul, hy, smul_comm])⟩

variable [Finite G] {p k : ℕ} {c : G → R} {y₀ : Fin 2 →₀ MonoidAlgebra R G}
  (hp : IsSMulRegular R p) (hinj : Function.Injective (tameFrameRelationMap R G σ τ a b))
  (hJ : Ideal.comap (algebraMap R (MonoidAlgebra R G))
    (Ideal.span {single σ (1 : R) - single 1 a, single τ 1 - single 1 b}) =
      Ideal.span {(p : R) ^ k})
  (hc : ∀ g, single g (1 : R) - single 1 (c g) ∈
    Ideal.span {single σ (1 : R) - single 1 a, single τ 1 - single 1 b})
include hp hinj hJ hc

/-- The left ideal `(σ - a, τ - b)` kills the class `t₀` of `y₀`. -/
private theorem smul_toQuotient_eq_zero_of_mem
    (hy₀ : tameFrameRelationMap R G σ τ a b (twistedNorm c) = p ^ k • y₀) {x : MonoidAlgebra R G}
    (hx : x ∈ Ideal.span {single σ (1 : R) - single 1 a, single τ 1 - single 1 b}) :
    x • (tameFrameRelations R G σ τ a b).toQuotient y₀ = 0 := by
  have hpk : ((p ^ k : ℕ) : R) = (p : R) ^ k := Nat.cast_pow p k
  have hle : Ideal.span {single σ (1 : R) - single 1 a, single τ 1 - single 1 b} ≤
      LinearMap.ker (LinearMap.toSpanSingleton (MonoidAlgebra R G) _
        ((tameFrameRelations R G σ τ a b).toQuotient y₀)) := by
    rw [Ideal.span, Submodule.span_le]
    rintro x (rfl | rfl) <;>
      exact (smul_toQuotient_eq_zero_iff (hp.pow k) hinj hy₀ _).2
        (MonoidAlgebra.exists_eq_nsmul_of_dvd_coeff fun g ↦
          hpk ▸ dvd_coeff_mul_twistedNorm hJ hc (Ideal.subset_span (by simp)) g)
  exact hle hx

/-- Only the left ideal `(σ - a, τ - b)` kills the class `t₀` of `y₀`. -/
private theorem mem_of_smul_toQuotient_eq_zero
    (hy₀ : tameFrameRelationMap R G σ τ a b (twistedNorm c) = p ^ k • y₀)
    (hgen : Submonoid.closure {σ, τ} = ⊤)
    {x : MonoidAlgebra R G} (hx : x • (tameFrameRelations R G σ τ a b).toQuotient y₀ = 0) :
    x ∈ Ideal.span {single σ (1 : R) - single 1 a, single τ 1 - single 1 b} := by
  have hpk : ((p ^ k : ℕ) : R) = (p : R) ^ k := Nat.cast_pow p k
  -- Modulo the ideal, `x` is a scalar `e`, which then kills `t₀`.
  obtain ⟨e, he⟩ := exists_sub_single_one_mem hgen x
  have he₀ : (single (1 : G) e : MonoidAlgebra R G) •
      (tameFrameRelations R G σ τ a b).toQuotient y₀ = 0 := by
    have := smul_toQuotient_eq_zero_of_mem hp hinj hJ hc hy₀ he
    rwa [sub_smul, hx, zero_sub, neg_eq_zero] at this
  -- Comparing coefficients at `1` shows that `p ^ k` divides `e`.
  obtain ⟨u, hu⟩ := (smul_toQuotient_eq_zero_iff (hp.pow k) hinj hy₀ _).1 he₀
  have hu₁ := congrArg (fun y ↦ y.coeff 1) hu
  simp only [coeff_single_mul_apply, inv_one, one_mul, coeff_twistedNorm, coeff_nsmul] at hu₁
  have hc₁ : (p : R) ^ k ∣ c 1 - 1 := dvd_sub_of_single_sub_mem hJ hc (by simp)
  have hdvd : (p : R) ^ k ∣ e := by
    -- Split `e` into the two terms whose divisibility is supplied by `hu₁` and `hc₁`.
    rw [show e = e * c 1 - e * (c 1 - 1) by ring, hu₁, ← hpk]
    exact dvd_sub (dvd_mul_right _ _) (dvd_mul_of_dvd_right (hpk ▸ hc₁) _)
  simpa using Ideal.add_mem _ he ((single_one_mem_iff_dvd hJ e).2 hdvd)

omit hinj in
/-- Every `p`-power torsion element of the tame-frame module is a scalar multiple of the class
`t₀` of `y₀`. -/
private theorem exists_smul_toQuotient_eq
    (hy₀ : tameFrameRelationMap R G σ τ a b (twistedNorm c) = p ^ k • y₀)
    (hgen : Submonoid.closure {σ, τ} = ⊤)
    {y : Fin 2 →₀ MonoidAlgebra R G}
    (hy : (tameFrameRelations R G σ τ a b).toQuotient y ∈
      pPowerTorsion p (MonoidAlgebra R G) (TameFrameModule R G σ τ a b)) :
    ∃ d : R, (single (1 : G) d : MonoidAlgebra R G) •
      (tameFrameRelations R G σ τ a b).toQuotient y₀ =
        (tameFrameRelations R G σ τ a b).toQuotient y := by
  obtain ⟨n, hn⟩ := mem_pPowerTorsion_iff.mp hy
  -- Write `p ^ (n + k) y` as the relation applied to some `w`.
  have hnk : p ^ (n + k) • (tameFrameRelations R G σ τ a b).toQuotient y = 0 := by
    rw [pow_add, mul_comm, mul_smul, hn, smul_zero]
  rw [← map_nsmul, ← LinearMap.mem_ker, Module.Relations.ker_toQuotient,
    ← range_tameFrameRelationMap] at hnk
  obtain ⟨w, hw⟩ := hnk
  have hwJ {x : MonoidAlgebra R G}
      (hx : x ∈ Ideal.span {single σ (1 : R) - single 1 a, single τ 1 - single 1 b}) :
      ∃ u, w * x = p ^ (n + k) • u :=
    exists_mul_eq_nsmul_of_mem hgen ⟨y 0, by simpa using congrArg (· 0) hw⟩
      ⟨y 1, by simpa using congrArg (· 1) hw⟩ hx
  -- The coefficient of `w` at `1` is `p ^ n d`, since `w p ^ k` is divisible by `p ^ (n + k)`.
  obtain ⟨u, hu⟩ := hwJ ((single_one_mem_iff_dvd hJ _).2 dvd_rfl)
  have hu₁ := congrArg (fun y ↦ y.coeff 1) hu
  simp only [coeff_mul_single_apply, inv_one, mul_one, coeff_nsmul] at hu₁
  have hd : w.coeff 1 = p ^ n * u.coeff 1 := by
    refine hp.pow k ?_
    simp only [nsmul_eq_mul]
    push_cast at hu₁ ⊢
    rw [mul_comm, hu₁]
    ring
  -- Hence `w ≡ p ^ n d · twistedNorm c` modulo `p ^ (n + k)`.
  have hcoeff (g : G) : ((p ^ (n + k) : ℕ) : R) ∣
      (w - p ^ n • (single (1 : G) (u.coeff 1) * twistedNorm c)).coeff g := by
    obtain ⟨u', hu'⟩ := hwJ (hc g⁻¹)
    have hu'₁ := congrArg (fun y ↦ y.coeff 1) hu'
    simp only [mul_sub, coeff_sub, Finsupp.sub_apply, coeff_mul_single_apply, one_mul, inv_inv,
      mul_one, inv_one, coeff_nsmul] at hu'₁
    simp only [coeff_sub, Finsupp.sub_apply, coeff_nsmul, coeff_single_mul_apply, inv_one,
      one_mul, coeff_twistedNorm]
    refine ⟨u'.coeff 1, ?_⟩
    rw [← hu'₁, hd]
    push_cast
    ring
  obtain ⟨v, hv⟩ := MonoidAlgebra.exists_eq_nsmul_of_dvd_coeff hcoeff
  refine ⟨u.coeff 1, ?_⟩
  -- Dividing by `p ^ (n + k)`, `y = d y₀` modulo the relation.
  have hy : y = single (1 : G) (u.coeff 1) • y₀ + tameFrameRelationMap R G σ τ a b v := by
    exact isSMulRegular_relationModule (hp.pow (n + k)) (by
      -- Applying the injectivity of `(p ^ (n + k) • ·)` leaves its lambda unreduced.
      beta_reduce
      rw [← hw, smul_add, ← map_nsmul, ← hv, pow_add, mul_smul, smul_comm (p ^ k), ← hy₀,
        ← map_smul, ← map_nsmul, ← map_add, smul_eq_mul, add_sub_cancel])
  rw [hy, map_add, map_smul, tameFrameRelationMap_apply, map_smul,
    Module.Relations.toQuotient_relation, smul_zero, add_zero]

omit hp hinj hJ hc

/-- **The torsion of the tame-frame module.** Let `G` be a finite group generated by `σ, τ`, and
let `R` be a commutative ring on which multiplication by `p` is injective, such as `ℤ_p`.
Suppose that the tame-frame relation `x ↦ x · (σ - a, τ - b)` is injective and that the scalars in
the left ideal
`J = (σ - a, τ - b)` of `R[G]` are exactly the multiples of `p ^ k`. Then the `p`-power
torsion of the tame-frame module `M₀ = R[G]² / R[G]·(σ - a, τ - b)` is isomorphic to `R[G] ⧸ J` as
a left `R[G]`-module. -/
theorem nonempty_tameFrameModule_torsion_linearEquiv_of_relationMap_injective
    (hgen : Subgroup.closure {σ, τ} = ⊤) (hp : IsSMulRegular R p)
    (hinj : Function.Injective (tameFrameRelationMap R G σ τ a b))
    (hJ : Ideal.comap (algebraMap R (MonoidAlgebra R G))
      (Ideal.span {single σ (1 : R) - single 1 a, single τ 1 - single 1 b}) =
        Ideal.span {(p : R) ^ k}) :
    Nonempty (pPowerTorsion p (MonoidAlgebra R G) (TameFrameModule R G σ τ a b)
      ≃ₗ[MonoidAlgebra R G]
      MonoidAlgebra R G ⧸ Ideal.span {single σ (1 : R) - single 1 a, single τ 1 - single 1 b}) := by
  have hgen' : Submonoid.closure {σ, τ} = ⊤ := by
    rw [← Subgroup.closure_toSubmonoid_of_finite, hgen, Subgroup.top_toSubmonoid]
  have hpk : ((p ^ k : ℕ) : R) = (p : R) ^ k := Nat.cast_pow p k
  choose c hc using fun g : G ↦ exists_sub_single_one_mem hgen' (single g (1 : R))
  -- The generator `t₀` of the torsion: `p ^ k t₀` is the relation applied to `twistedNorm c`.
  obtain ⟨y₀, hy₀⟩ : ∃ y₀, tameFrameRelationMap R G σ τ a b (twistedNorm c) = p ^ k • y₀ :=
    exists_tameFrameRelationMap_eq_nsmul
      (fun g ↦ hpk ▸ dvd_coeff_twistedNorm_mul hJ hc (Ideal.subset_span (by simp)) g)
      (fun g ↦ hpk ▸ dvd_coeff_twistedNorm_mul hJ hc (Ideal.subset_span (by simp)) g)
  let t₀ := (tameFrameRelations R G σ τ a b).toQuotient y₀
  -- The class of `x` maps to `x t₀`.
  let φ := Submodule.liftQ _ (LinearMap.toSpanSingleton (MonoidAlgebra R G) _ t₀)
    fun x hx ↦ smul_toQuotient_eq_zero_of_mem hp hinj hJ hc hy₀ hx
  have hφ (x : MonoidAlgebra R G) : φ (Submodule.Quotient.mk x) = x • t₀ := rfl
  have hφT (z) : φ z ∈ pPowerTorsion p (MonoidAlgebra R G) (TameFrameModule R G σ τ a b) := by
    induction z using Submodule.Quotient.induction_on with
    | H x =>
      refine mem_pPowerTorsion_iff.mpr ⟨k, ?_⟩
      rw [hφ, smul_comm, ← Nat.cast_smul_eq_nsmul (MonoidAlgebra R G),
        (smul_toQuotient_eq_zero_iff (hp.pow k) hinj hy₀ _).2 ⟨_, (nsmul_eq_mul _ _).symm⟩,
        smul_zero]
  have hinjφ : Function.Injective φ := by
    rw [← LinearMap.ker_eq_bot, eq_bot_iff]
    intro z hz
    induction z using Submodule.Quotient.induction_on with
    | H x =>
      exact (Submodule.mem_bot _).2 ((Submodule.Quotient.mk_eq_zero _).2
        (mem_of_smul_toQuotient_eq_zero hp hinj hJ hc hy₀ hgen' hz))
  refine ⟨(LinearEquiv.ofBijective (φ.codRestrict _ hφT)
    ⟨fun z z' h ↦ hinjφ (congrArg Subtype.val h), fun s ↦ ?_⟩).symm⟩
  obtain ⟨y, hy⟩ := (tameFrameRelations R G σ τ a b).surjective_toQuotient s.1
  obtain ⟨d, hd⟩ := exists_smul_toQuotient_eq hp hJ hc hy₀ hgen' (hy ▸ s.2)
  exact ⟨Submodule.Quotient.mk (single 1 d), Subtype.ext (hd.trans hy)⟩

end Torsion

section Padic

variable {p : ℕ} [Fact p.Prime]

/-- **The torsion of the tame-frame module with sharp exponents.** Let `G` be a finite group
generated by `σ, τ`, and let `a, b` be natural numbers for which the quotient `ℤ_p[G] ⧸ J` by the
left ideal `J = (σ - a, τ - b)` is finite, as the sharp exponents of a tame frame provide. Then
the `p`-power torsion of the tame-frame module `M₀ = ℤ_p[G]² / ℤ_p[G]·(σ - a, τ - b)` is
isomorphic to `ℤ_p[G] ⧸ J` as a left `ℤ_p[G]`-module. -/
theorem nonempty_tameFrameModule_torsion_linearEquiv [Finite G] {σ τ : G}
    (hgen : Subgroup.closure {σ, τ} = ⊤) (a b : ℕ)
    (hcard : Nat.card (MonoidAlgebra ℤ_[p] G ⧸ Ideal.span
      {single σ (1 : ℤ_[p]) - a, single τ (1 : ℤ_[p]) - b}) ≠ 0) :
    Nonempty (pPowerTorsion p (MonoidAlgebra ℤ_[p] G)
        (TameFrameModule ℤ_[p] G σ τ (a : ℤ_[p]) (b : ℤ_[p])) ≃ₗ[MonoidAlgebra ℤ_[p] G]
      MonoidAlgebra ℤ_[p] G ⧸ Ideal.span {single σ (1 : ℤ_[p]) - a, single τ (1 : ℤ_[p]) - b}) := by
  simp only [natCast_def] at hcard ⊢
  have hgen' : Submonoid.closure {σ, τ} = ⊤ := by
    rw [← Subgroup.closure_toSubmonoid_of_finite, hgen, Subgroup.top_toSubmonoid]
  -- The scalars in the ideal form a nonzero ideal of `ℤ_p`, since the quotient is finite.
  have hne : Ideal.comap (algebraMap ℤ_[p] (MonoidAlgebra ℤ_[p] G)) (Ideal.span
      {single σ (1 : ℤ_[p]) - single 1 (a : ℤ_[p]), single τ 1 - single 1 (b : ℤ_[p])}) ≠ ⊥ := by
    intro hbot
    have hinj : Function.Injective (LinearMap.toSpanSingleton ℤ_[p] _
        (Submodule.Quotient.mk (p := Ideal.span {single σ (1 : ℤ_[p]) - single 1 (a : ℤ_[p]),
          single τ 1 - single 1 (b : ℤ_[p])}) 1)) := by
      rw [← LinearMap.ker_eq_bot, eq_bot_iff, ← hbot]
      intro r hr
      rwa [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, ← Submodule.Quotient.mk_smul,
        Submodule.Quotient.mk_eq_zero, ← Algebra.algebraMap_eq_smul_one] at hr
    exact hcard (Nat.card_eq_zero_of_infinite.symm.trans (Nat.card_eq_of_bijective _
      ⟨hinj, MonoidAlgebra.toSpanSingleton_mk_one_surjective hgen'⟩)).symm
  obtain ⟨k, hk⟩ := PadicInt.ideal_eq_span_pow_p hne
  exact nonempty_tameFrameModule_torsion_linearEquiv_of_relationMap_injective hgen
    (IsSMulRegular.nat_of_isAddTorsionFree (M := ℤ_[p]) (Fact.out : p.Prime).ne_zero)
    (tameFrameRelationMap_injective_of_card_ne_zero (isOfFinOrder_of_finite σ)
      (isOfFinOrder_of_finite τ) hcard) hk

/-- **The torsion of the tame-frame module for supplied sharp exponents.** Let `σ, τ` generate
the finite automorphism group of `L/K`. If `a, b` describe their action on the `p`-power roots of
unity and the quotient `ℤ_p[G] ⧸ (σ - a, τ - b)` has the sharp cardinality `q(L)`, then the
`p`-power torsion of the tame-frame module is isomorphic to that of the `p`-adic completion `A(L)`
as a left `ℤ_p[G]`-module. -/
theorem tameFrameModule_torsion_linearEquiv {L : Type*} [Field L] {K : Type*} [Field K]
    [Algebra K L] [Finite (L ≃ₐ[K] L)] (h : Finite (pPowerRootsOfUnity p L)) (σ τ : L ≃ₐ[K] L)
    (hgen : Subgroup.closure {σ, τ} = ⊤) (a b : ℕ)
    (ha : ∀ ζ ∈ pPowerRootsOfUnity p L, Units.map (σ : L →* L) ζ = ζ ^ a)
    (hb : ∀ ζ ∈ pPowerRootsOfUnity p L, Units.map (τ : L →* L) ζ = ζ ^ b)
    (hcard : Nat.card (MonoidAlgebra ℤ_[p] (L ≃ₐ[K] L) ⧸ Ideal.span
      {single σ (1 : ℤ_[p]) - a, single τ (1 : ℤ_[p]) - b}) = localRootOfUnityOrder p L h) :
    Nonempty (pPowerTorsion p (MonoidAlgebra ℤ_[p] (L ≃ₐ[K] L))
        (TameFrameModule ℤ_[p] (L ≃ₐ[K] L) σ τ (a : ℤ_[p]) (b : ℤ_[p]))
      ≃ₗ[MonoidAlgebra ℤ_[p] (L ≃ₐ[K] L)]
      pPowerTorsion p (MonoidAlgebra ℤ_[p] (L ≃ₐ[K] L))
        (Additive ↑(padicCompletionUnits p L))) := by
  obtain ⟨f⟩ := nonempty_tameFrameModule_torsion_linearEquiv hgen a b
    (hcard ▸ (localRootOfUnityOrder_pos p L h).ne')
  obtain ⟨g⟩ := nonempty_quotient_tameFrameExponents_linearEquiv h σ τ a b ha hb hcard
  exact ⟨f.trans g⟩

/-- **The torsion of the tame-frame module of a tame frame is `μ_{p^∞}(L)`.** Let `σ, τ` generate
the finite automorphism group `G` of `L/K`, with `τ` of order prime to `p`, and suppose `L` has
finitely many `p`-power roots of unity. Then there are natural numbers `a, b` through which `σ, τ`
act on `μ_{p^∞}(L)` such that the quotient `ℤ_p[G] ⧸ (σ - a, τ - b)` has order
`q(L) = #μ_{p^∞}(L)`, and the `p`-power torsion of the tame-frame module
`M₀ = ℤ_p[G]² / ℤ_p[G]·(σ - a, τ - b)` is isomorphic as a left `ℤ_p[G]`-module to the `p`-power
torsion of the `p`-adic completion `A(L)` of `Lˣ`, which is `μ_{p^∞}(L)` with its Galois action.
For the same exponents, `nonempty_tameFrameModule_tensorRat_linearEquiv` identifies
`M₀ ⊗[ℤ_p] ℚ_p` with `ℤ_p[G] ⊗[ℤ_p] ℚ_p`. -/
theorem exists_tameFrameModule_torsion_linearEquiv {L : Type*} [Field L] {K : Type*} [Field K]
    [Algebra K L] [Finite (L ≃ₐ[K] L)] (h : Finite (pPowerRootsOfUnity p L)) (σ τ : L ≃ₐ[K] L)
    (hgen : Subgroup.closure {σ, τ} = ⊤) (hτ : ¬ p ∣ orderOf τ) :
    ∃ a b : ℕ,
      (∀ ζ ∈ pPowerRootsOfUnity p L, Units.map (σ : L →* L) ζ = ζ ^ a) ∧
      (∀ ζ ∈ pPowerRootsOfUnity p L, Units.map (τ : L →* L) ζ = ζ ^ b) ∧
      Nat.card (MonoidAlgebra ℤ_[p] (L ≃ₐ[K] L) ⧸ Ideal.span
        {single σ (1 : ℤ_[p]) - a, single τ (1 : ℤ_[p]) - b}) = localRootOfUnityOrder p L h ∧
      Nonempty (pPowerTorsion p (MonoidAlgebra ℤ_[p] (L ≃ₐ[K] L))
          (TameFrameModule ℤ_[p] (L ≃ₐ[K] L) σ τ (a : ℤ_[p]) (b : ℤ_[p]))
        ≃ₗ[MonoidAlgebra ℤ_[p] (L ≃ₐ[K] L)]
        pPowerTorsion p (MonoidAlgebra ℤ_[p] (L ≃ₐ[K] L))
          (Additive ↑(padicCompletionUnits p L))) := by
  obtain ⟨a, b, ha, hb, hcard, -⟩ := exists_tameFrame_exponents h σ τ hgen hτ
  exact ⟨a, b, ha, hb, hcard,
    tameFrameModule_torsion_linearEquiv h σ τ hgen a b ha hb hcard⟩

end Padic

end TauCeti
