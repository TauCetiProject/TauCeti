module

public import TauCeti.NumberTheory.LocalField.Tame.Character
public import TauCeti.Topology.Algebra.Group.Profinite.Rank
import TauCeti.Algebra.CharP.LocalRing

/-!
# The tame quotient is generated by a Frobenius lift and a tame inertia generator

Let `K` be a nonarchimedean local field with residue characteristic `p`, let `G_K` be its absolute
Galois group, `I_K` its inertia subgroup and `P_K` its wild inertia subgroup. The **tame quotient**
is `G_K^t = G_K / P_K`. This file proves that it is topologically generated by two elements: the
image of an arithmetic Frobenius lift `σ` and the image of an element `τ` of inertia whose tame
character topologically generates `ℤ̂^{(p')}(1)`.

* The tame character identifies `I_K / P_K` with the prime-to-`p` Tate module `ℤ̂^{(p')}(1)`, which
  is procyclic: a compactness argument on `I_K` produces `τ ∈ I_K` whose tame character has a
  primitive `m`-th root of unity as its level-`m` component for every `m` prime to `p`, and such
  a point generates a dense subgroup of the Tate module. Hence `τ` and `P_K` topologically
  generate `I_K`.
* A Frobenius lift and `I_K` topologically generate `G_K`, so `σ`, `τ` and `P_K` do. Thus
  `G_K^t` is topologically generated by the images of `σ` and `τ`, and its topological generator
  rank is at most `2`.
* The same pair generates every finite quotient `G_K / U` through which wild inertia dies, and
  there the image of `τ` has order prime to `p`: since `P_K` is the Sylow pro-`p` subgroup of
  `I_K`, the image of `I_K` in `G_K / U` has order prime to `p`.

This is the generation half of Iwasawa's presentation of `G_K^t` by `σ τ σ⁻¹ = τ ^ q`. The finite
form is the input to the count of generators of the absolute Galois group of a `p`-adic field.

## Main definitions

* `TauCeti.tameQuotient K`: the tame quotient `G_K / P_K`.

## Main results

* `TauCeti.exists_topologicalClosure_zpowers_inertiaTameCharacter_eq_top`: some element of inertia
  has a tame character that topologically generates `ℤ̂^{(p')}(1)`.
* `TauCeti.topologicalClosure_zpowers_sup_wildInertiaSubgroup`: such an element and wild inertia
  topologically generate inertia.
* `TauCeti.IsArithFrobeniusLift.topologicalClosure_closure_sup_wildInertiaSubgroup`,
  `TauCeti.IsArithFrobeniusLift.topologicalClosure_closure_tameQuotient_eq_top`: together with a
  Frobenius lift, it generates `G_K` modulo wild inertia.
* `TauCeti.isTopologicallyFinitelyGenerated_tameQuotient`,
  `TauCeti.topologicalGeneratorRankNat_tameQuotient_le_two`: the tame quotient is topologically
  generated by two elements.
* `TauCeti.not_dvd_orderOf_mk_of_mem_inertiaSubgroup`: in a finite quotient of `G_K` through
  which wild inertia dies, elements of inertia have order prime to `p`.
* `TauCeti.exists_tameFrame_quotient`: a Frobenius lift `σ` and an element `τ` of inertia whose
  images generate every finite quotient of `G_K` through which wild inertia dies, with the image
  of `τ` of order prime to `p`.

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, (7.5.2) and (7.5.3).
* [J.-P. Serre, *Corps Locaux*][serre1968], Chapter IV, §2.
-/

public section

open ValuativeRel

namespace TauCeti

variable (K : Type*) [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

/-- The **tame quotient** `G_K^t = G_K / P_K` of the absolute Galois group of `K`: the quotient by
the wild inertia subgroup, which fixes the maximal tamely ramified extension of `K`. -/
abbrev tameQuotient : Type _ :=
  Field.absoluteGaloisGroup K ⧸ wildInertiaSubgroup K

/-! ### A topological generator of tame inertia -/

/-- **Tame inertia is procyclic**: some element `τ` of the inertia subgroup has a tame character
that topologically generates `ℤ̂^{(p')}(1)`. -/
theorem exists_topologicalClosure_zpowers_inertiaTameCharacter_eq_top :
    ∃ τ : inertiaSubgroup K,
      (Subgroup.zpowers (inertiaTameCharacter K τ)).topologicalClosure = ⊤ := by
  have : CompactSpace (inertiaSubgroup K) :=
    isCompact_iff_compactSpace.1 (isClosed_inertiaSubgroup K).isCompact
  have hp := CharP.prime_ringChar 𝓀[K]
  -- `K^{alg}` has a primitive `m`-th root of unity for each `m` prime to `p`, as `m ≠ 0` in `K`.
  obtain ⟨τ, hτ⟩ := PrimeToPTateModule.exists_forall_isPrimitiveRoot_proj
    (inertiaTameCharacter K).continuous (proj_inertiaTameCharacter_surjective K) fun m ↦ by
      have : NeZero ((m : ℕ) : K) := ⟨natCast_ne_zero_of_isUnit
        (IsLocalRing.isUnit_natCast_iff_not_dvd.2 (hp.coprime_iff_not_dvd.1 m.2.2.symm))⟩
      exact HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure K) m
  exact ⟨τ, PrimeToPTateModule.topologicalClosure_zpowers_eq_top hτ⟩

variable {K} in
/-- **A tame inertia generator and wild inertia generate inertia.** If the tame character of
`τ ∈ I_K` topologically generates `ℤ̂^{(p')}(1)`, then the closed subgroup generated by `τ` and
`P_K` is `I_K`. -/
theorem topologicalClosure_zpowers_sup_wildInertiaSubgroup {τ : inertiaSubgroup K}
    (hτ : (Subgroup.zpowers (inertiaTameCharacter K τ)).topologicalClosure = ⊤) :
    (Subgroup.zpowers (τ : Field.absoluteGaloisGroup K) ⊔
      wildInertiaSubgroup K).topologicalClosure = inertiaSubgroup K := by
  have : CompactSpace (inertiaSubgroup K) :=
    isCompact_iff_compactSpace.1 (isClosed_inertiaSubgroup K).isCompact
  refine le_antisymm (Subgroup.topologicalClosure_minimal _
    (sup_le (Subgroup.zpowers_le.2 τ.2) (wildInertiaSubgroup_le_inertiaSubgroup K))
    (isClosed_inertiaSubgroup K)) fun σ hσ ↦ ?_
  -- The tame character maps the compact closure `S` of the powers of `τ` in `I_K` onto
  -- `ℤ̂^{(p')}(1)`, so `σ` agrees with some `c ∈ S` modulo the kernel `P_K`.
  set S := (Subgroup.zpowers τ).topologicalClosure
  have hS : S.map (inertiaTameCharacter K).toMonoidHom = ⊤ := by
    rw [MonoidHom.map_topologicalClosure _ (inertiaTameCharacter K).continuous _
      (Subgroup.zpowers τ).isClosed_topologicalClosure.isCompact, MonoidHom.map_zpowers]
    exact hτ
  obtain ⟨c, hcS, hc⟩ : inertiaTameCharacter K ⟨σ, hσ⟩ ∈
      S.map (inertiaTameCharacter K).toMonoidHom := hS ▸ Subgroup.mem_top _
  have hwild : c⁻¹ * ⟨σ, hσ⟩ ∈ (wildInertiaSubgroup K).subgroupOf (inertiaSubgroup K) := by
    rw [← ker_inertiaTameCharacter, MonoidHom.mem_ker, map_mul, map_inv]
    exact inv_mul_eq_one.2 hc
  have hcσ : (c : Field.absoluteGaloisGroup K) ∈ (Subgroup.zpowers
      (τ : Field.absoluteGaloisGroup K)).topologicalClosure := by
    have := (inertiaSubgroup K).subtype.map_topologicalClosure_le continuous_subtype_val _
      ⟨c, hcS, rfl⟩
    rwa [MonoidHom.map_zpowers] at this
  rw [← mul_inv_cancel_left (c : Field.absoluteGaloisGroup K) σ]
  exact mul_mem (Subgroup.topologicalClosure_mono le_sup_left hcσ)
    (Subgroup.le_topologicalClosure _ (Subgroup.mem_sup_right (Subgroup.mem_subgroupOf.1 hwild)))

namespace IsArithFrobeniusLift

variable {K} {σ : Field.absoluteGaloisGroup K}

/-- **The tame frame generates `G_K` modulo wild inertia.** An arithmetic Frobenius lift `σ`, an
element `τ ∈ I_K` whose tame character topologically generates `ℤ̂^{(p')}(1)`, and the wild
inertia subgroup `P_K` together topologically generate the absolute Galois group. -/
theorem topologicalClosure_closure_sup_wildInertiaSubgroup (hσ : IsArithFrobeniusLift K σ)
    {τ : inertiaSubgroup K}
    (hτ : (Subgroup.zpowers (inertiaTameCharacter K τ)).topologicalClosure = ⊤) :
    (Subgroup.closure {σ, (τ : Field.absoluteGaloisGroup K)} ⊔
      wildInertiaSubgroup K).topologicalClosure = ⊤ := by
  set D := (Subgroup.closure {σ, (τ : Field.absoluteGaloisGroup K)} ⊔
    wildInertiaSubgroup K).topologicalClosure
  -- `D` contains `I_K`, generated by `τ` and `P_K`, and `σ`, which with `I_K` generates `G_K`.
  have hI : inertiaSubgroup K ≤ D := by
    rw [← topologicalClosure_zpowers_sup_wildInertiaSubgroup hτ]
    refine Subgroup.topologicalClosure_mono (sup_le_sup_right ?_ _)
    exact Subgroup.zpowers_le.2 (Subgroup.subset_closure (by simp))
  have hσD : Subgroup.zpowers σ ≤ D :=
    Subgroup.zpowers_le.2 (Subgroup.le_topologicalClosure _
      (Subgroup.mem_sup_left (Subgroup.subset_closure (by simp))))
  rw [eq_top_iff, ← hσ.topologicalClosure_zpowers_sup_inertiaSubgroup]
  exact Subgroup.topologicalClosure_minimal _ (sup_le hσD hI)
    (Subgroup.isClosed_topologicalClosure _)

/-- **The tame frame generates the tame quotient.** The images in `G_K / P_K` of an arithmetic
Frobenius lift `σ` and of an element `τ ∈ I_K` whose tame character topologically generates
`ℤ̂^{(p')}(1)` topologically generate the tame quotient. -/
theorem topologicalClosure_closure_tameQuotient_eq_top (hσ : IsArithFrobeniusLift K σ)
    {τ : inertiaSubgroup K}
    (hτ : (Subgroup.zpowers (inertiaTameCharacter K τ)).topologicalClosure = ⊤) :
    (Subgroup.closure {(σ : tameQuotient K),
      ((τ : Field.absoluteGaloisGroup K) : tameQuotient K)}).topologicalClosure = ⊤ := by
  have h := topologicalClosure_closure_sup_eq_top_iff.1
    (hσ.topologicalClosure_closure_sup_wildInertiaSubgroup hτ)
  rwa [Set.image_pair] at h

end IsArithFrobeniusLift

/-! ### The tame quotient -/

/-- **The tame quotient is topologically finitely generated**, by the images of a Frobenius lift
and of a tame inertia generator. -/
theorem isTopologicallyFinitelyGenerated_tameQuotient :
    IsTopologicallyFinitelyGenerated (tameQuotient K) := by
  obtain ⟨σ, hσ⟩ := exists_isArithFrobeniusLift K
  obtain ⟨τ, hτ⟩ := exists_topologicalClosure_zpowers_inertiaTameCharacter_eq_top K
  exact (Set.toFinite _).isTopologicallyFinitelyGenerated
    (hσ.topologicalClosure_closure_tameQuotient_eq_top hτ)

/-- **The tame quotient is topologically generated by two elements.** -/
theorem topologicalGeneratorRankNat_tameQuotient_le_two :
    topologicalGeneratorRankNat (tameQuotient K) (isTopologicallyFinitelyGenerated_tameQuotient K)
      ≤ 2 := by
  classical
  obtain ⟨σ, hσ⟩ := exists_isArithFrobeniusLift K
  obtain ⟨τ, hτ⟩ := exists_topologicalClosure_zpowers_inertiaTameCharacter_eq_top K
  refine (topologicalGeneratorRankNat_le _ (s := {(σ : tameQuotient K),
    ((τ : Field.absoluteGaloisGroup K) : tameQuotient K)}) ?_).trans Finset.card_le_two
  rw [Finset.coe_pair]
  exact hσ.topologicalClosure_closure_tameQuotient_eq_top hτ

/-! ### The tame frame on finite quotients -/

variable (p : ℕ) [CharP 𝓀[K] p]

variable {K} in
/-- **Inertia has order prime to `p` on a finite tame layer.** In a finite quotient `G_K / U`
through which wild inertia dies, the image of every element of inertia has order prime to the
residue characteristic `p`: the image of `I_K` there is a quotient of `I_K` by an open subgroup
containing its Sylow pro-`p` subgroup `P_K`, so its order is prime to `p`. -/
theorem not_dvd_orderOf_mk_of_mem_inertiaSubgroup
    (U : OpenNormalSubgroup (Field.absoluteGaloisGroup K))
    (hU : wildInertiaSubgroup K ≤ U.toSubgroup) {τ : Field.absoluteGaloisGroup K}
    (hτ : τ ∈ inertiaSubgroup K) :
    ¬ p ∣ orderOf (τ : Field.absoluteGaloisGroup K ⧸ U.toSubgroup) := by
  have : CompactSpace (inertiaSubgroup K) :=
    isCompact_iff_compactSpace.1 (isClosed_inertiaSubgroup K).isCompact
  set V := U.comap (inertiaSubgroup K).subtype continuous_subtype_val
  have hV := (isProPSylow_wildInertiaSubgroup K p).not_dvd_index_of_le V.toOpenSubgroup
    fun σ hσ ↦ OpenNormalSubgroup.mem_comap.2 (hU (Subgroup.mem_subgroupOf.1 hσ))
  -- `τ ^ [I_K : V]` lies in `V`, so the order of the image of `τ` divides `[I_K : V]`.
  have hpow := V.toSubgroup.pow_index_mem (⟨τ, hτ⟩ : inertiaSubgroup K)
  refine fun hdvd ↦ hV (hdvd.trans (orderOf_dvd_of_pow_eq_one ?_))
  rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
  exact OpenNormalSubgroup.mem_comap.1 hpow

/-- **The tame frame on the finite tame layers.** There are an arithmetic Frobenius lift `σ` and
an element `τ` of inertia such that for every open normal subgroup `U` of `G_K` containing wild
inertia, the images of `σ` and `τ` generate the finite group `G_K / U` and the image of `τ` has
order prime to the residue characteristic `p`. -/
theorem exists_tameFrame_quotient :
    ∃ σ τ : Field.absoluteGaloisGroup K, IsArithFrobeniusLift K σ ∧ τ ∈ inertiaSubgroup K ∧
      ∀ U : OpenNormalSubgroup (Field.absoluteGaloisGroup K),
        wildInertiaSubgroup K ≤ U.toSubgroup →
          Subgroup.closure {(σ : Field.absoluteGaloisGroup K ⧸ U.toSubgroup),
            (τ : Field.absoluteGaloisGroup K ⧸ U.toSubgroup)} = ⊤ ∧
          ¬ p ∣ orderOf (τ : Field.absoluteGaloisGroup K ⧸ U.toSubgroup) := by
  obtain ⟨σ, hσ⟩ := exists_isArithFrobeniusLift K
  obtain ⟨τ, hτ⟩ := exists_topologicalClosure_zpowers_inertiaTameCharacter_eq_top K
  refine ⟨σ, τ, hσ, τ.2, fun U hU ↦ ⟨?_, not_dvd_orderOf_mk_of_mem_inertiaSubgroup p U hU τ.2⟩⟩
  -- The frame generates `G_K` modulo `P_K ≤ U`, hence topologically generates the discrete
  -- quotient `G_K / U`, where every subgroup is closed.
  have : DiscreteTopology (Field.absoluteGaloisGroup K ⧸ U.toSubgroup) :=
    QuotientGroup.discreteTopology U.isOpen
  have h := topologicalClosure_closure_sup_eq_top_iff.1 (top_le_iff.1 <|
    (hσ.topologicalClosure_closure_sup_wildInertiaSubgroup hτ).ge.trans
      (Subgroup.topologicalClosure_mono (sup_le_sup_left hU _)))
  rwa [Set.image_pair, (isClosed_discrete _).subgroup_topologicalClosure_eq] at h

end TauCeti
