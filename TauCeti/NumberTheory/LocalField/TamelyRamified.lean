/-!
# Totally and tamely ramified extensions of local fields

Let `L/K` be an extension of nonarchimedean local fields which is totally ramified,
`e(L/K) = [L : K]`, and tamely ramified, so that the residue characteristic does not divide
`e = e(L/K)`. This file proves the structure theorem for such extensions: `L` is obtained from `K`
by adjoining an `e`-th root of a uniformizer of `K`,

`L = K(α)` with `α ^ e = π` for a uniformizer `π` of `K`,

and the root `α` is then a uniformizer of `L`. Tameness cannot be dropped: `ℚ₂(√-1)/ℚ₂` is
totally ramified of degree `2`, but contains no square root of a uniformizer of `ℚ₂`, since `-1`
has even valuation and lies in a different square class from every uniformizer.

## Main results

* `TauCeti.IsTotallyRamified.exists_eq_algebraMap_mul_pow`: in a totally ramified extension,
  every unit of `𝒪[L]` is a unit of `𝒪[K]` times the `n`-th power of a unit of `𝒪[L]`, for every
  `n` invertible in `𝒪[L]`.
* `TauCeti.IsTotallyRamified.exists_pow_eq_uniformizer_of_isTamelyRamified`: a totally and tamely
  ramified extension of degree `e` is generated by an `e`-th root of a uniformizer of `K`, and that
  root is a uniformizer of `L`.

## References

* [J.-P. Serre, *Corps Locaux*][serre1968], Chapter IV, §2.
* J. Neukirch, *Algebraic Number Theory*, Chapter II, §7.
-/

public section

open ValuativeRel IsLocalRing IsNonarchimedeanLocalField Polynomial
open scoped IntermediateField

namespace TauCeti

variable {K L : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

variable [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
  [Algebra K L] [ValuativeExtension K L]

/-- In a totally ramified extension of nonarchimedean local fields, every unit of `𝒪[L]` is the
image of a unit of `𝒪[K]` times the `n`-th power of a unit of `𝒪[L]`, for every `n` invertible
in `𝒪[L]`. -/
theorem IsTotallyRamified.exists_eq_algebraMap_mul_pow (h : IsTotallyRamified K L) {n : ℕ}
    (hn : IsUnit (n : 𝒪[L])) (u : 𝒪[L]ˣ) :
    ∃ (a : 𝒪[K]ˣ) (w : 𝒪[L]ˣ), (u : 𝒪[L]) = algebraMap 𝒪[K] 𝒪[L] a * w ^ n := by
  -- the residue of `u` comes from a unit `a` of `𝒪[K]`, since the residue fields agree
  obtain ⟨c, hc⟩ :=
    (isTotallyRamified_iff_surjective_algebraMap_residueField K L).1 h (residue 𝒪[L] u)
  obtain ⟨a, rfl⟩ := residue_surjective c
  rw [ResidueField.algebraMap_residue] at hc
  have ha : IsUnit (algebraMap 𝒪[K] 𝒪[L] a) := by
    rw [← notMem_maximalIdeal, ← residue_eq_zero_iff, hc, residue_eq_zero_iff,
      notMem_maximalIdeal]
    exact u.isUnit
  -- the quotient `y = u / a` is a principal unit, hence the `n`-th power of a principal unit
  set y : 𝒪[L]ˣ := u * ha.unit⁻¹ with hy
  have hy1 : Units.map (Subring.subtype 𝒪[L] : 𝒪[L] →* L) y ∈ unitFiltration L 1 := by
    rw [mem_unitFiltration_one_iff_residue_eq_one]
    simp [hy, ← hc, (ha.map (residue 𝒪[L])).ne_zero]
  obtain ⟨⟨w, hw⟩, hwy⟩ := (powMonoidHom_unitFiltration_succ_bijective_of_isUnit hn 0).2 ⟨_, hy1⟩
  let w' := unitFiltrationToIntegerUnits 1 ⟨w, hw⟩
  refine ⟨(isUnit_of_map_unit _ _ ha).unit, w', ?_⟩
  have hwy' : w' ^ n = y := by
    apply Units.map_injective (f := (Subring.subtype 𝒪[L] : 𝒪[L] →* L)) Subtype.coe_injective
    rw [map_pow, unitsMap_subtype_unitFiltrationToIntegerUnits]
    exact Subtype.ext_iff.1 hwy
  rw [← Units.val_pow_eq_pow_val, hwy', IsUnit.unit_spec, ← ha.unit_spec, ← Units.val_mul, hy,
    mul_comm, inv_mul_cancel_right]

/-- **Totally and tamely ramified extensions are radical.** If `L/K` is a totally and tamely
ramified extension of nonarchimedean local fields, of degree `e = e(L/K)`, then there are a
uniformizer `π` of `K` and a uniformizer `α` of `L` with `α ^ e = π` and `L = K(α)`. -/
theorem IsTotallyRamified.exists_pow_eq_uniformizer_of_isTamelyRamified (h : IsTotallyRamified K L)
    (ht : IsTamelyRamified K L) :
    ∃ (π : Kˣ) (α : Lˣ), IsUniformizer K π ∧ IsUniformizer L α ∧
      (α : L) ^ ramificationIndex K L = algebraMap K L π ∧ K⟮(α : L)⟯ = ⊤ := by
  set e := ramificationIndex K L
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[K]
  obtain ⟨ϖL, hϖL⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[L]
  -- the image of `ϖ` in `𝒪[L]` is `u * ϖL ^ e`, with `u = a * w ^ e`
  obtain ⟨m, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible
    ((map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective 𝒪[K] 𝒪[L])).2 hϖ.ne_zero) hϖL
  have hm : m = e := by
    have := addVal_algebraMap (L := L) ϖ
    rw [hu, IsDiscreteValuationRing.addVal_def' u hϖL,
      IsDiscreteValuationRing.addVal_uniformizer hϖ, nsmul_one] at this
    exact_mod_cast this
  subst hm
  obtain ⟨a, w, hua⟩ :=
    h.exists_eq_algebraMap_mul_pow ((isTamelyRamified_iff_isUnit_natCast K L).1 ht) u
  -- `ϖK := ϖ / a` is a uniformizer of `K`, and `ϖα := w * ϖL` is a uniformizer of `L` and an
  -- `e`-th root of it
  set ϖK : 𝒪[K] := ϖ * ↑a⁻¹ with hϖK_def
  set ϖα : 𝒪[L] := w * ϖL with hϖα_def
  have hϖK : Irreducible ϖK := (associated_mul_unit_right ϖ _ a⁻¹.isUnit).irreducible_iff.1 hϖ
  have hϖα : Irreducible ϖα := (associated_unit_mul_left ϖL _ w.isUnit).irreducible_iff.2 hϖL
  have hpow : ϖα ^ e = algebraMap 𝒪[K] 𝒪[L] ϖK := by
    have hinv : algebraMap 𝒪[K] 𝒪[L] a * algebraMap 𝒪[K] 𝒪[L] ↑a⁻¹ = 1 := by
      rw [← map_mul, Units.mul_inv, map_one]
    rw [hϖα_def, hϖK_def, map_mul]
    linear_combination (-algebraMap 𝒪[K] 𝒪[L] ↑a⁻¹) * hu -
      (algebraMap 𝒪[K] 𝒪[L] ↑a⁻¹ * ϖL ^ e) * hua - ((w : 𝒪[L]) ^ e * ϖL ^ e) * hinv
  have hϖK0 : (ϖK : K) ≠ 0 := fun h0 ↦ hϖK.ne_zero (Subtype.ext h0)
  have hϖα0 : (ϖα : L) ≠ 0 := fun h0 ↦ hϖα.ne_zero (Subtype.ext h0)
  have hαpow : (ϖα : L) ^ e = algebraMap K L (ϖK : K) := by
    rw [← coe_algebraMap_integerRing, ← hpow, SubmonoidClass.coe_pow]
  refine ⟨Units.mk0 (ϖK : K) hϖK0, Units.mk0 (ϖα : L) hϖα0,
    (isUniformizer_iff_exists_irreducible K _).2 ⟨ϖK, hϖK, rfl⟩,
    (isUniformizer_iff_exists_irreducible L _).2 ⟨ϖα, hϖα, rfl⟩, hαpow, ?_⟩
  -- `ϖα` generates the maximal ideal of `𝒪[L]` and the residue fields agree, so `ϖα` generates
  -- `𝒪[L]` over `𝒪[K]`, hence `L` over `K`
  have hadj := h.adjoin_eq_top_of_irreducible hϖα
  have := IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top (K := K) (L := L) hadj
  rwa [Units.val_mk0]

end TauCeti
