import TauCeti.RingTheory.Valuation.Irreducible

/-!
# Eisenstein unit-norm polynomials and their square-class composition law

In a ramified quadratic extension generated by a root `ω` of an Eisenstein quadratic polynomial
`X² + t X + c` (`t ∈ 𝓂[K]`, `c` irreducible), the field norms of valuation one have the integral
normal form `u² (1 - t v + c v²)` with `u ∈ 𝒪[K]ˣ` and `v ∈ 𝒪[K]`
(`TauCeti.exists_norm_eq_iff_of_eisensteinQuadraticBasis`). Modulo squares in `Kˣ`, these unit norms
are parametrized by `v ↦ [1 - t v + c v²]`.

Unlike the uniformizer family `1 - π v²`, the linear term `-t v` cannot be removed by completing the
square when `valuation K 2 ≤ valuation K t < 1`. Instead, values of `1 - t X + c X²` satisfy
`(1 - t v + c v²)(1 - t s + c s²) = (1 - t s + c v s)² (1 - t r + c r²)` with
`r = (v - s) / (1 - t s + c v s)`. For any `t, c ∈ 𝓂[K]` over a valued field `K`,
`1 - t s + c v s ∈ 𝒪[K]ˣ` and `v ↦ r` (`TauCeti.eisensteinNormCompose`) is a bijection on `𝒪[K]`
(`TauCeti.eisensteinNormComposeEquiv`) descending to every `𝒪[K] ⧸ I`
(`TauCeti.eisensteinNormComposeQuotientEquiv`), making the image of
`TauCeti.eisensteinNormSquareClass` (`TauCeti.eisensteinNormUnit`) a subgroup
`TauCeti.eisensteinNormSquareSubgroup ≤ TauCeti.unitSquareClasses K`
(`TauCeti.eisensteinNormSquareClass_mul`, `TauCeti.eisensteinNormSquareClass_eq_iff`,
`TauCeti.eisensteinNormSquareSubgroup_le_unitSquareClasses`). For irreducible `c`, we also compute
the valuation of `x² - t x y + c y²` (`TauCeti.valuation_sq_sub_mul_add_mul_sq`,
`TauCeti.valuation_sq_sub_mul_add_mul_sq_eq_one_iff`) and identify `eisensteinNormSquareSubgroup`
with valuation-one norms (`TauCeti.mem_eisensteinNormSquareSubgroup_iff_of_forall`,
`TauCeti.mem_eisensteinNormSquareSubgroup_iff_exists_norm_eq`).

## References

* O. T. O'Meara, *Introduction to Quadratic Forms*, §63A.
* J.-P. Serre, *Local Fields*, Chapter V, §3.
-/

public section

noncomputable section

open ValuativeRel IsLocalRing IsNonarchimedeanLocalField

namespace TauCeti

section ValuedField

variable {K : Type*} [Field K] [ValuativeRel K]

/-- Over any valued field, if `t ∈ 𝓂[K]` and `c` is irreducible in `𝒪[K]`, the cross term `-t x y`
is strictly smaller in valuation than `max (v(x²)) (v(c y²))`, so the Eisenstein norm form
`x² - t x y + c y²` has valuation `max (v(x²)) (v(c y²))`. -/
theorem valuation_sq_sub_mul_add_mul_sq {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : Irreducible c)
    (x y : K) :
    valuation K (x ^ 2 - (t : K) * x * y + (c : K) * y ^ 2) =
      max (valuation K (x ^ 2)) (valuation K ((c : K) * y ^ 2)) := by
  rcases eq_or_ne y 0 with rfl | hy; · simp
  rcases eq_or_ne x 0 with rfl | hx; · simp
  have hc1 : valuation K (c : K) < 1 := Valuation.integer.v_irreducible_lt_one hc
  have hc0 : 0 < valuation K (c : K) := Valuation.integer.v_irreducible_pos hc
  have htc : valuation K (t : K) ≤ valuation K (c : K) := valuation_le_of_mem_maximalIdeal hc ht
  have hx0 : 0 < valuation K x := (Valuation.pos_iff _).mpr hx
  have hy0 : 0 < valuation K y := (Valuation.pos_iff _).mpr hy
  rcases (valuation_sq_ne_valuation_mul_sq hc hy).lt_or_gt with hlt | hgt
  · have hxy1 : valuation K (x / y) < 1 := not_le.mp fun hge ↦
      (hlt.trans (by rw [map_mul, map_pow]; exact mul_lt_of_lt_one_left (pow_pos hy0 2) hc1)).not_ge
        (by rw [map_pow, ← one_le_div₀ (pow_pos hy0 2), ← div_pow, ← map_div₀]
            exact one_le_pow₀ hge)
    have hmid : valuation K ((t : K) * x * y) < valuation K ((c : K) * y ^ 2) := by
      rw [map_mul, map_mul, map_mul, map_pow, sq]
      exact (mul_le_mul' (mul_le_mul' htc (valuation_le_mul_of_div_lt_one hc hy0 hxy1))
        le_rfl).trans_lt (by simpa only [one_mul, mul_assoc, mul_left_comm] using
          mul_lt_mul_of_pos_right hc1 (mul_pos hc0 (mul_pos hy0 hy0)))
    rw [(valuation K).map_add_eq_of_lt_right
      (((valuation K).map_sub _ _).trans_lt (max_lt hlt hmid)), max_eq_right hlt.le]
  · have hyx : valuation K y ≤ valuation K x := not_lt.mp fun hlt' ↦ hgt.not_ge <| by
      rw [map_pow, sq, map_mul, map_pow, sq]
      exact (mul_le_mul' (valuation_le_mul_of_div_lt_one hc hy0
        (by rwa [map_div₀, div_lt_one₀ hy0])) hlt'.le).trans_eq (by ac_rfl)
    have hsub : valuation K (x ^ 2 - (t : K) * x * y) = valuation K (x ^ 2) :=
      (valuation K).map_sub_eq_of_lt_left <| by
        rw [map_mul, map_mul, map_pow, sq, mul_assoc]
        exact (mul_le_mul' htc (mul_le_mul' le_rfl hyx)).trans_lt
          (by simpa only [one_mul] using mul_lt_mul_of_pos_right hc1 (mul_pos hx0 hx0))
    rw [(valuation K).map_add_eq_of_lt_left (hsub.symm ▸ hgt), hsub, max_eq_left hgt.le]

/-- An Eisenstein quadratic norm form `x² - t x y + c y²` has valuation `1` if and only if `x` has
valuation `1` and `y` is integral. -/
theorem valuation_sq_sub_mul_add_mul_sq_eq_one_iff {t c : 𝒪[K]} (ht : t ∈ 𝓂[K])
    (hc : Irreducible c) (x y : K) :
    valuation K (x ^ 2 - (t : K) * x * y + (c : K) * y ^ 2) = 1 ↔
      valuation K x = 1 ∧ valuation K y ≤ 1 := by
  have hc1 : valuation K (c : K) < 1 := Valuation.integer.v_irreducible_lt_one hc
  have hc0 : 0 < valuation K (c : K) := Valuation.integer.v_irreducible_pos hc
  rw [valuation_sq_sub_mul_add_mul_sq ht hc]
  constructor
  · intro h
    have hcy_le : valuation K ((c : K) * y ^ 2) ≤ 1 := (le_max_right _ _).trans_eq h
    have hy1 : valuation K y ≤ 1 := not_lt.mp fun hygt ↦ by
      have hy0 : y ≠ 0 := by rintro rfl; simp at hygt
      have hcy1 : valuation K ((c : K) * y) < 1 := by
        refine (?_ : _ < valuation K ((c : K) * y ^ 2)).trans_le hcy_le
        rw [map_mul, map_mul, map_pow, sq, ← mul_assoc]
        simpa only [mul_one] using
          mul_lt_mul_of_pos_left hygt (mul_pos hc0 (zero_le.trans_lt hygt))
      exact valuation_lt_one_mul_ne_irreducible (y := 1 / y) hc hcy1
        (by rwa [map_div₀, map_one, div_lt_one₀ (zero_le.trans_lt hygt)]) (by field_simp)
    have hcy_lt : valuation K ((c : K) * y ^ 2) < 1 := by
      rw [map_mul, map_pow]
      exact (mul_le_mul' le_rfl (pow_le_one₀ zero_le hy1)).trans_lt (by simpa using hc1)
    have hx2 : valuation K (x ^ 2) = 1 :=
      ((max_eq_iff.mp h).resolve_right fun h' ↦ hcy_lt.ne h'.1).1
    exact ⟨by simpa only [map_pow, pow_eq_one_iff_left (by decide : 2 ≠ 0)] using hx2, hy1⟩
  · rintro ⟨hx, hy⟩
    rw [map_pow, hx, one_pow]
    refine max_eq_left ?_
    rw [map_mul, map_pow]
    exact (mul_le_mul' hc1.le (pow_le_one₀ zero_le hy)).trans (by simp)

/-- For `t, c ∈ 𝓂[K]` and `v ∈ 𝒪[K]`, the polynomial value `1 - t v + c v²` has valuation `1`. -/
theorem valuation_one_sub_mul_add_mul_sq {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (v : 𝒪[K]) :
    valuation K (1 - (t : K) * (v : K) + (c : K) * (v : K) ^ 2) = 1 := by
  have hlt : valuation K (((-(t * v) + c * v ^ 2 : 𝒪[K]) : K)) < 1 :=
    (valuation K).mem_maximalIdeal_iff.mp
      (add_mem (neg_mem (Ideal.mul_mem_right v _ ht)) (Ideal.mul_mem_right (v ^ 2) _ hc))
  rw [show 1 - (t : K) * (v : K) + (c : K) * (v : K) ^ 2 =
    1 + ((-(t * v) + c * v ^ 2 : 𝒪[K]) : K) by push_cast; ring,
    (valuation K).map_one_add_of_lt hlt]

/-- For `t, c ∈ 𝓂[K]` and `v ∈ 𝒪[K]`, the value `1 - t v + c v²` is nonzero in `K`. -/
theorem one_sub_mul_add_mul_sq_ne_zero {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K]) (v : 𝒪[K]) :
    1 - (t : K) * (v : K) + (c : K) * (v : K) ^ 2 ≠ 0 := fun h ↦ by
  simpa [h] using valuation_one_sub_mul_add_mul_sq ht hc v

/-- For `t, c ∈ 𝓂[K]` and `v, s ∈ 𝒪[K]`, the composition denominator `1 - t s + c v s` is a unit of
`𝒪[K]`. -/
theorem isUnit_one_sub_mul_add_mul_mul {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (v s : 𝒪[K]) : IsUnit (1 - t * s + c * v * s) := by
  rw [show 1 - t * s + c * v * s = 1 - (t * s - c * v * s) by ring]
  exact IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ ((IsLocalRing.mem_maximalIdeal _).mp
    (sub_mem (Ideal.mul_mem_right s _ ht) (mul_assoc c v s ▸ Ideal.mul_mem_right (v * s) _ hc)))

/-- For `c ∈ 𝓂[K]` and `s, r ∈ 𝒪[K]`, the inverse-composition denominator `1 - c s r` is a unit of
`𝒪[K]`. -/
theorem isUnit_one_sub_mul_mul {c : 𝒪[K]} (hc : c ∈ 𝓂[K]) (s r : 𝒪[K]) :
    IsUnit (1 - c * s * r) :=
  IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _
    ((IsLocalRing.mem_maximalIdeal _).mp (mul_assoc c s r ▸ Ideal.mul_mem_right (s * r) _ hc))

/-- The integral composition parameter `(v - s) / (1 - t s + c v s)` for Eisenstein unit norms. -/
def eisensteinNormCompose {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K]) (v s : 𝒪[K]) : 𝒪[K] :=
  (v - s) * ↑(isUnit_one_sub_mul_add_mul_mul ht hc v s).unit⁻¹

/-- Characteristic equation of `eisensteinNormCompose`: multiplying by `1 - t s + c v s` recovers
`v - s`. -/
@[simp]
theorem eisensteinNormCompose_mul {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K]) (v s : 𝒪[K]) :
    eisensteinNormCompose ht hc v s * (1 - t * s + c * v * s) = v - s := by
  rw [eisensteinNormCompose, mul_assoc,
    IsUnit.val_inv_mul (isUnit_one_sub_mul_add_mul_mul ht hc v s), mul_one]

/-- Composing a parameter `s` with itself gives `0`. -/
@[simp]
theorem eisensteinNormCompose_self {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K]) (s : 𝒪[K]) :
    eisensteinNormCompose ht hc s s = 0 := by simp [eisensteinNormCompose]

/-- Composing `v` with `0` returns `v`. -/
@[simp]
theorem eisensteinNormCompose_zero_right {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (v : 𝒪[K]) : eisensteinNormCompose ht hc v 0 = v := by
  simpa using eisensteinNormCompose_mul ht hc v 0

/-- For fixed `s ∈ 𝒪[K]`, the composition map `v ↦ (v - s) / (1 - t s + c v s)` is a bijection on
`𝒪[K]`, with inverse `r ↦ (s + r (1 - t s)) / (1 - c s r)`. -/
def eisensteinNormComposeEquiv {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K]) (s : 𝒪[K]) :
    𝒪[K] ≃ 𝒪[K] where
  toFun v := eisensteinNormCompose ht hc v s
  invFun r := (s + r * (1 - t * s)) * ↑(isUnit_one_sub_mul_mul hc s r).unit⁻¹
  left_inv v := by
    have hr := eisensteinNormCompose_mul ht hc v s
    have h1 : s + eisensteinNormCompose ht hc v s * (1 - t * s) =
        v * (1 - c * s * eisensteinNormCompose ht hc v s) :=
      (isUnit_one_sub_mul_add_mul_mul ht hc v s).mul_left_cancel
        (by linear_combination (1 - t * s + c * v * s) * hr)
    dsimp only; rw [h1, mul_assoc, (isUnit_one_sub_mul_mul hc s _).mul_val_inv, mul_one]
  right_inv r := by
    have huy := isUnit_one_sub_mul_mul hc s r
    set v := (s + r * (1 - t * s)) * (↑huy.unit⁻¹ : 𝒪[K])
    have hv : v * (1 - c * s * r) = s + r * (1 - t * s) := by
      dsimp only [v]; rw [mul_assoc, huy.val_inv_mul, mul_one]
    have h1 : v - s = r * (1 - t * s + c * v * s) :=
      huy.mul_left_cancel (by linear_combination (1 - c * s * r) * hv)
    dsimp only [eisensteinNormCompose]
    rw [h1, mul_assoc, (isUnit_one_sub_mul_add_mul_mul ht hc v s).mul_val_inv, mul_one]

/-- Applying `eisensteinNormComposeEquiv` evaluates `eisensteinNormCompose`. -/
@[simp]
theorem eisensteinNormComposeEquiv_apply {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (s v : 𝒪[K]) :
    eisensteinNormComposeEquiv ht hc s v = eisensteinNormCompose ht hc v s := by
  simp only [eisensteinNormComposeEquiv, Equiv.coe_fn_mk]

/-- Characteristic equation of `(eisensteinNormComposeEquiv ht hc s).symm`: multiplying by
`1 - c s r` recovers `s + r (1 - t s)`. -/
@[simp]
theorem eisensteinNormComposeEquiv_symm_mul {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (s r : 𝒪[K]) :
    (eisensteinNormComposeEquiv ht hc s).symm r * (1 - c * s * r) = s + r * (1 - t * s) := by
  unfold eisensteinNormComposeEquiv; dsimp only [Equiv.coe_fn_symm_mk]
  rw [mul_assoc, IsUnit.val_inv_mul, mul_one]

/-- The composition map preserves congruence modulo every ideal of `𝒪[K]`. -/
theorem eisensteinNormCompose_sub_mem_iff {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (I : Ideal 𝒪[K]) (v₁ v₂ s : 𝒪[K]) :
    eisensteinNormCompose ht hc v₁ s - eisensteinNormCompose ht hc v₂ s ∈ I ↔ v₁ - v₂ ∈ I := by
  have h1 := eisensteinNormCompose_mul ht hc v₁ s
  have h2 := eisensteinNormCompose_mul ht hc v₂ s
  rw [← I.mul_unit_mem_iff_mem (isUnit_one_sub_mul_add_mul_mul ht hc v₁ s),
    ← I.mul_unit_mem_iff_mem (isUnit_one_sub_mul_add_mul_mul ht hc v₂ s),
    show (eisensteinNormCompose ht hc v₁ s - eisensteinNormCompose ht hc v₂ s) *
      (1 - t * s + c * v₁ * s) * (1 - t * s + c * v₂ * s) = (v₁ - v₂) * (1 - t * s + c * s * s) by
      linear_combination (1 - t * s + c * v₂ * s) * h1 - (1 - t * s + c * v₁ * s) * h2,
    I.mul_unit_mem_iff_mem (isUnit_one_sub_mul_add_mul_mul ht hc s s)]

/-- The composition equivalence descended to any quotient ring `𝒪[K] ⧸ I`. -/
def eisensteinNormComposeQuotientEquiv {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (I : Ideal 𝒪[K]) (s : 𝒪[K]) : (𝒪[K] ⧸ I) ≃ (𝒪[K] ⧸ I) :=
  Quotient.congr (eisensteinNormComposeEquiv ht hc s) fun v₁ v₂ ↦ by
    simp only [Submodule.quotientRel_def, eisensteinNormComposeEquiv_apply]
    exact (eisensteinNormCompose_sub_mem_iff ht hc I v₁ v₂ s).symm

/-- `eisensteinNormComposeQuotientEquiv` acts on residue classes via `eisensteinNormCompose`. -/
@[simp]
theorem eisensteinNormComposeQuotientEquiv_mk {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (I : Ideal 𝒪[K]) (v s : 𝒪[K]) :
    eisensteinNormComposeQuotientEquiv ht hc I s (Ideal.Quotient.mk I v) =
      Ideal.Quotient.mk I (eisensteinNormCompose ht hc v s) := by
  rw [eisensteinNormComposeQuotientEquiv]; rfl

/-- For `t, c ∈ 𝓂[K]`, the unit-norm polynomial `1 - t v + c v²`, packaged as a unit of `K`. -/
def eisensteinNormUnit (K : Type*) [Field K] [ValuativeRel K] {t c : 𝒪[K]}
    (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K]) (v : 𝒪[K]) : Kˣ :=
  Units.mk0 (1 - (t : K) * (v : K) + (c : K) * (v : K) ^ 2)
    (one_sub_mul_add_mul_sq_ne_zero ht hc v)

/-- Coercing `eisensteinNormUnit K ht hc v` to `K` gives `1 - t v + c v²`. -/
@[simp]
theorem coe_eisensteinNormUnit {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K]) (v : 𝒪[K]) :
    (eisensteinNormUnit K ht hc v : K) = 1 - (t : K) * (v : K) + (c : K) * (v : K) ^ 2 := by
  simp only [eisensteinNormUnit, Units.val_mk0]

/-- At `v = 0`, `eisensteinNormUnit` is `1`. -/
@[simp]
theorem eisensteinNormUnit_zero {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K]) :
    eisensteinNormUnit K ht hc 0 = 1 := by ext; simp

/-- Every `eisensteinNormUnit` has valuation `1`. -/
theorem valuation_eisensteinNormUnit {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (v : 𝒪[K]) : valuation K (eisensteinNormUnit K ht hc v : K) = 1 :=
  valuation_one_sub_mul_add_mul_sq ht hc v

/-- For `t, c ∈ 𝓂[K]`, the multiplicative square class of `1 - t v + c v²` in `Kˣ ⧸ (Kˣ)²`. -/
def eisensteinNormSquareClass (K : Type*) [Field K] [ValuativeRel K] {t c : 𝒪[K]}
    (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K]) (v : 𝒪[K]) : Kˣ ⧸ Subgroup.square Kˣ :=
  squareClassHom (eisensteinNormUnit K ht hc v)

/-- Defining equation for `eisensteinNormSquareClass` in terms of `squareClassHom`. -/
theorem eisensteinNormSquareClass_def {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (v : 𝒪[K]) :
    eisensteinNormSquareClass K ht hc v = squareClassHom (eisensteinNormUnit K ht hc v) := by
  rw [eisensteinNormSquareClass]

/-- If `(b : K) = u² (1 - t v + c v²)` with `u ∈ 𝒪[K]ˣ` and `v ∈ 𝒪[K]`, then `b` has square class
`eisensteinNormSquareClass K ht hc v`. -/
theorem squareClassHom_eq_eisensteinNormSquareClass_of_eq {t c : 𝒪[K]} (ht : t ∈ 𝓂[K])
    (hc : c ∈ 𝓂[K]) {b : Kˣ} {u : 𝒪[K]ˣ} {v : 𝒪[K]}
    (h : (b : K) = (u : K) ^ 2 * (1 - (t : K) * (v : K) + (c : K) * (v : K) ^ 2)) :
    squareClassHom b = eisensteinNormSquareClass K ht hc v := by
  have hbu : b = (Units.map (Subring.subtype 𝒪[K] : 𝒪[K] →* K) u) ^ 2 *
      eisensteinNormUnit K ht hc v := Units.ext (by simpa [coe_eisensteinNormUnit] using h)
  rw [hbu, squareClassHom_sq_mul, eisensteinNormSquareClass_def]

/-- At `v = 0`, `eisensteinNormSquareClass` is the trivial square class `1`. -/
@[simp]
theorem eisensteinNormSquareClass_zero {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K]) :
    eisensteinNormSquareClass K ht hc 0 = 1 := by simp [eisensteinNormSquareClass_def]

/-- `eisensteinNormSquareClass K ht hc v = 1` if and only if `1 - t v + c v²` is a square in `K`. -/
theorem eisensteinNormSquareClass_eq_one_iff {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (v : 𝒪[K]) :
    eisensteinNormSquareClass K ht hc v = 1 ↔
      IsSquare (1 - (t : K) * (v : K) + (c : K) * (v : K) ^ 2) := by
  rw [eisensteinNormSquareClass_def, squareClassHom_eq_one_iff, ← Units.isSquare_coe_iff,
    coe_eisensteinNormUnit]

/-- **Composition law for Eisenstein unit-norm square classes.** Multiplying the square classes at
`v` and `s` gives the square class at `(v - s) / (1 - t s + c v s)`. -/
theorem eisensteinNormSquareClass_mul {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (v s : 𝒪[K]) :
    eisensteinNormSquareClass K ht hc v * eisensteinNormSquareClass K ht hc s =
      eisensteinNormSquareClass K ht hc (eisensteinNormCompose ht hc v s) := by
  set r := eisensteinNormCompose ht hc v s
  set u₀ : 𝒪[K]ˣ := (isUnit_one_sub_mul_add_mul_mul ht hc v s).unit
  have hr : r * (u₀ : 𝒪[K]) = v - s := by
    rw [IsUnit.unit_spec]; exact eisensteinNormCompose_mul ht hc v s
  have hid : (1 - t * v + c * v ^ 2) * (1 - t * s + c * s ^ 2) =
      (u₀ : 𝒪[K]) ^ 2 * (1 - t * r + c * r ^ 2) := by
    calc (1 - t * v + c * v ^ 2) * (1 - t * s + c * s ^ 2)
        = (u₀ : 𝒪[K]) ^ 2 - t * (u₀ : 𝒪[K]) * (v - s) + c * (v - s) ^ 2 := by
          rw [show (u₀ : 𝒪[K]) = 1 - t * s + c * v * s from IsUnit.unit_spec _]; ring
      _ = (u₀ : 𝒪[K]) ^ 2 * (1 - t * r + c * r ^ 2) := by rw [← hr]; ring
  rw [eisensteinNormSquareClass_def, eisensteinNormSquareClass_def, ← map_mul]
  exact squareClassHom_eq_eisensteinNormSquareClass_of_eq ht hc (u := u₀)
    (by simpa [coe_eisensteinNormUnit] using congrArg ((↑) : 𝒪[K] → K) hid)

/-- Two Eisenstein norm square classes are equal if and only if the quotient of their representing
polynomial values is a square in `K`. -/
theorem eisensteinNormSquareClass_eq_iff_isSquare_div {t c : 𝒪[K]} (ht : t ∈ 𝓂[K])
    (hc : c ∈ 𝓂[K]) (v s : 𝒪[K]) :
    eisensteinNormSquareClass K ht hc v = eisensteinNormSquareClass K ht hc s ↔
      IsSquare ((1 - (t : K) * (v : K) + (c : K) * (v : K) ^ 2) /
        (1 - (t : K) * (s : K) + (c : K) * (s : K) ^ 2)) := by
  rw [eisensteinNormSquareClass_def, eisensteinNormSquareClass_def, ← div_eq_one, ← map_div,
    squareClassHom_eq_one_iff, ← Units.isSquare_coe_iff, Units.val_div_eq_div_val,
    coe_eisensteinNormUnit, coe_eisensteinNormUnit]

/-- **Equality criterion for `eisensteinNormSquareClass`.** Two parameters `v` and `s` determine the
same square class if and only if `1 - t r + c r²` is a square at `r = (v - s)/(1 - t s + c v s)`. -/
theorem eisensteinNormSquareClass_eq_iff {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (v s : 𝒪[K]) :
    eisensteinNormSquareClass K ht hc v = eisensteinNormSquareClass K ht hc s ↔
      IsSquare (1 - (t : K) * (eisensteinNormCompose ht hc v s : K) +
        (c : K) * (eisensteinNormCompose ht hc v s : K) ^ 2) := by
  have hsq : ∀ u : 𝒪[K], eisensteinNormSquareClass K ht hc u *
      eisensteinNormSquareClass K ht hc u = 1 := fun u ↦ by
    rw [eisensteinNormSquareClass_mul, eisensteinNormCompose_self, eisensteinNormSquareClass_zero]
  rw [show eisensteinNormSquareClass K ht hc v = eisensteinNormSquareClass K ht hc s ↔
      eisensteinNormSquareClass K ht hc v * eisensteinNormSquareClass K ht hc s = 1 from
    ⟨fun h ↦ h ▸ hsq s, fun h ↦ by
      simpa only [mul_assoc, hsq, mul_one, one_mul] using
        congrArg (· * eisensteinNormSquareClass K ht hc s) h⟩,
    eisensteinNormSquareClass_mul, eisensteinNormSquareClass_eq_one_iff]

/-- For `t, c ∈ 𝓂[K]`, the subgroup of `Kˣ ⧸ (Kˣ)²` formed by the square classes
`[1 - t v + c v²]`. -/
def eisensteinNormSquareSubgroup (K : Type*) [Field K] [ValuativeRel K] {t c : 𝒪[K]}
    (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K]) : Subgroup (Kˣ ⧸ Subgroup.square Kˣ) where
  carrier := Set.range (eisensteinNormSquareClass K ht hc)
  one_mem' := ⟨0, eisensteinNormSquareClass_zero ht hc⟩
  mul_mem' := by
    rintro _ _ ⟨v, rfl⟩ ⟨s, rfl⟩
    exact ⟨_, (eisensteinNormSquareClass_mul ht hc v s).symm⟩
  inv_mem' := by
    rintro _ ⟨v, rfl⟩
    refine ⟨v, (inv_eq_of_mul_eq_one_right ?_).symm⟩
    rw [eisensteinNormSquareClass_mul, eisensteinNormCompose_self, eisensteinNormSquareClass_zero]

/-- The underlying set of `eisensteinNormSquareSubgroup` is the range of
`eisensteinNormSquareClass`. -/
@[simp]
theorem coe_eisensteinNormSquareSubgroup {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K]) :
    (eisensteinNormSquareSubgroup K ht hc : Set (Kˣ ⧸ Subgroup.square Kˣ)) =
      Set.range (eisensteinNormSquareClass K ht hc) := by
  rw [eisensteinNormSquareSubgroup]; rfl

/-- Membership in `eisensteinNormSquareSubgroup` means belonging to the range of
`eisensteinNormSquareClass`. -/
@[simp]
theorem mem_eisensteinNormSquareSubgroup_iff {t c : 𝒪[K]} (ht : t ∈ 𝓂[K]) (hc : c ∈ 𝓂[K])
    (q : Kˣ ⧸ Subgroup.square Kˣ) :
    q ∈ eisensteinNormSquareSubgroup K ht hc ↔
      ∃ v : 𝒪[K], eisensteinNormSquareClass K ht hc v = q := by
  rw [← SetLike.mem_coe, coe_eisensteinNormSquareSubgroup, Set.mem_range]

/-- Every Eisenstein unit-norm square class is a unit square class of `K`. -/
theorem eisensteinNormSquareSubgroup_le_unitSquareClasses {t c : 𝒪[K]} (ht : t ∈ 𝓂[K])
    (hc : c ∈ 𝓂[K]) :
    eisensteinNormSquareSubgroup K ht hc ≤ unitSquareClasses K := by
  rintro _ ⟨v, rfl⟩
  have hv := valuation_eisensteinNormUnit ht hc v
  refine (mem_unitSquareClasses_iff K _).mpr ⟨((Valuation.integer.integers
    (valuation K)).isUnit_of_one' (x := ⟨_, hv.le⟩) hv).unit, ?_⟩
  rw [eisensteinNormSquareClass_def, squareClassHom_apply, QuotientGroup.mk'_apply]
  congr 1; ext; simp

/-- If a predicate `P` on valuation-one units is equivalent to the normal form
`u² (1 - t v + c v²)`, then `eisensteinNormSquareSubgroup K ht hc` consists of the square classes of
valuation-one units satisfying `P`. -/
theorem mem_eisensteinNormSquareSubgroup_iff_of_forall {t c : 𝒪[K]} (ht : t ∈ 𝓂[K])
    (hc : c ∈ 𝓂[K]) {P : Kˣ → Prop}
    (hP : ∀ b : Kˣ, valuation K (b : K) = 1 →
      (P b ↔ ∃ (u : 𝒪[K]ˣ) (v : 𝒪[K]),
        (b : K) = (u : K) ^ 2 * (1 - (t : K) * (v : K) + (c : K) * (v : K) ^ 2)))
    (q : Kˣ ⧸ Subgroup.square Kˣ) :
    q ∈ eisensteinNormSquareSubgroup K ht hc ↔
      ∃ b : Kˣ, valuation K (b : K) = 1 ∧ P b ∧ squareClassHom b = q := by
  rw [mem_eisensteinNormSquareSubgroup_iff]
  refine ⟨fun ⟨v, hv⟩ ↦ hv ▸ ⟨eisensteinNormUnit K ht hc v, valuation_eisensteinNormUnit ht hc v,
    (hP _ (valuation_eisensteinNormUnit ht hc v)).mpr ⟨1, v, by simp [coe_eisensteinNormUnit]⟩,
    (eisensteinNormSquareClass_def ht hc v).symm⟩, fun ⟨b, hbv, hbP, hbq⟩ ↦ ?_⟩
  obtain ⟨u, v, hbuv⟩ := (hP b hbv).mp hbP
  exact ⟨v, hbq ▸ (squareClassHom_eq_eisensteinNormSquareClass_of_eq ht hc hbuv).symm⟩

end ValuedField

section EisensteinExtension

variable {K L : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L]
  [Algebra.IsQuadraticExtension K L]

/-- In an Eisenstein quadratic extension `L/K` generated by `ω² + t ω + c = 0`,
`eisensteinNormSquareSubgroup K ht hc.mem_maximalIdeal` consists of the square classes of norms of
valuation one from `L`. -/
theorem mem_eisensteinNormSquareSubgroup_iff_exists_norm_eq {t c : 𝒪[K]} {ω : 𝒪[L]}
    (ht : t ∈ 𝓂[K]) (hc : Irreducible c)
    (hω : ω ^ 2 + algebraMap 𝒪[K] 𝒪[L] t * ω + algebraMap 𝒪[K] 𝒪[L] c = 0)
    (q : Kˣ ⧸ Subgroup.square Kˣ) :
    q ∈ eisensteinNormSquareSubgroup K ht hc.mem_maximalIdeal ↔
      ∃ b : Kˣ, valuation K (b : K) = 1 ∧ (∃ z : L, Algebra.norm K z = b) ∧
        squareClassHom b = q :=
  mem_eisensteinNormSquareSubgroup_iff_of_forall ht hc.mem_maximalIdeal
    (fun _ ↦ exists_norm_eq_iff_of_eisensteinQuadraticBasis ht hc hω) q

end EisensteinExtension

