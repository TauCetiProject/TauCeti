module

public import TauCeti.NumberTheory.LocalField.QuadraticForm.Ramification.Dictionary
public import TauCeti.NumberTheory.LocalField.Norm.Unramified.Basic
public import TauCeti.RingTheory.Norm.Quadratic

/-!
# Ramification of quadratic extensions from the quadratic defect

For a quadratic extension `L/K` of nonarchimedean local fields generated by a square root
of `a ∈ Kˣ`, the quadratic defect of `a` detects actual ramification: a finite defect
exponent is even exactly when `L/K` is unramified, and odd exactly when its ramification
index is two. Both residue characteristics are included when `2 ≠ 0` in `K`.

The norm-equation characterization of the unramified square class is connected here to
the field norm. In the converse direction, the norm of a uniformizer has valuation equal
to the residue degree; its evenness forces that degree to be two.

## References

* O. T. O'Meara, *Introduction to Quadratic Forms*, §63A.
-/

public section

open ValuativeRel

namespace TauCeti

variable {K L : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L]
  [Algebra.IsQuadraticExtension K L]

/-- A quadratic local-field extension generated by `√a` is unramified exactly when
its finite defect exponent is even. The exponent is finite precisely for nonsquare `a`. -/
theorem isUnramified_iff_even_defectExponent (h2 : (2 : K) ≠ 0) {a : Kˣ} {x : L}
    (hx : x ∉ Set.range (algebraMap K L)) (hx2 : x ^ 2 = algebraMap K L (a : K))
    {d : ℤ} (hd : defectExponent a = d) :
    IsUnramified K L ↔ Even d := by
  rw [← unramified_class_iff_even_defectExponent h2 hd]
  constructor
  · intro h b
    let := h
    rw [← mem_normGroup_iff_exists_sq_sub_mul_sq L hx hx2,
      mem_normGroup_iff_dvd_normalizedValuation,
      IsUnramified.inertiaDegree_eq_finrank,
      Algebra.IsQuadraticExtension.finrank_eq_two K L]
    exact even_iff_two_dvd.symm
  · intro h
    obtain ⟨π, hπ⟩ := normalizedValuation_surjective (K := L) (Multiplicative.ofAdd 1)
    have hn : Algebra.normUnits K π ∈ normGroup K L :=
      mem_normGroup_iff.mpr ⟨π, by simp⟩
    have heven := (h (Algebra.normUnits K π)).mp
      ((mem_normGroup_iff_exists_sq_sub_mul_sq L hx hx2 _).mp hn)
    rw [toAdd_normalizedValuation_norm, hπ, toAdd_ofAdd, mul_one] at heven
    have hef := ramificationIndex_mul_inertiaDegree (K := K) (L := L)
    rw [Algebra.IsQuadraticExtension.finrank_eq_two K L] at hef
    have hfpos := inertiaDegree_pos (K := K) (L := L)
    have hepos := ramificationIndex_pos (K := K) (L := L)
    have hf : inertiaDegree K L = 2 := by
      have hfle : inertiaDegree K L ≤ 2 := by nlinarith
      obtain ⟨n, hn⟩ := heven
      omega
    rw [isUnramified_iff_inertiaDegree_eq_finrank,
      Algebra.IsQuadraticExtension.finrank_eq_two K L]
    exact hf

/-- A quadratic local-field extension generated by `√a` has ramification index two
exactly when the finite defect exponent of `a` is odd. -/
theorem ramificationIndex_eq_two_iff_odd_defectExponent (h2 : (2 : K) ≠ 0) {a : Kˣ} {x : L}
    (hx : x ∉ Set.range (algebraMap K L)) (hx2 : x ^ 2 = algebraMap K L (a : K))
    {d : ℤ} (hd : defectExponent a = d) :
    ramificationIndex K L = 2 ↔ Odd d := by
  have hef := ramificationIndex_mul_inertiaDegree (K := K) (L := L)
  rw [Algebra.IsQuadraticExtension.finrank_eq_two K L] at hef
  have hfpos := inertiaDegree_pos (K := K) (L := L)
  have hepos := ramificationIndex_pos (K := K) (L := L)
  have hele : ramificationIndex K L ≤ 2 := by nlinarith
  rw [← Int.not_even_iff_odd, ← isUnramified_iff_even_defectExponent h2 hx hx2 hd,
    isUnramified_iff_ramificationIndex_eq_one]
  omega

end TauCeti
