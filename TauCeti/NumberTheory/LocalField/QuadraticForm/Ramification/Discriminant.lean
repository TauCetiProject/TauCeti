module

public import TauCeti.NumberTheory.LocalField.QuadraticForm.Ramification.Basic
public import TauCeti.NumberTheory.LocalField.QuadraticForm.Norm.Sharpness
public import TauCeti.NumberTheory.LocalField.Norm.Conductor
public import TauCeti.NumberTheory.LocalField.Different.Hilbert
public import TauCeti.NumberTheory.LocalField.Discriminant.Basic
import TauCeti.FieldTheory.Separable.Quadratic

/-!
# Quadratic discriminants from the defect

Let `L = K(√a)` be a quadratic extension of nonarchimedean local fields with `2 ≠ 0` in
`K`. If `a` is a unit of odd defect exponent `d`, its unique upper ramification break is
`2 v_K(2) - d`. Its different and discriminant exponents are both `2 v_K(2) - d + 1`.

The sharp norm-filtration criterion
`unitFiltration_le_quadraticNormSubgroup_iff_of_odd_defectExponent` identifies the break
through the prime-degree norm-conductor theorem. Hilbert's formula then computes the
different. Thus the defect, defined by square approximation in `K`, determines the actual
discriminant ideal of the extension, without choosing an integral basis.

## References

* O. T. O'Meara, *Introduction to Quadratic Forms*, §63A.
* J.-P. Serre, *Local Fields*, Chapter IV, §1, Proposition 4, and Chapter V, §3.
-/

public section
noncomputable section

open ValuativeRel

namespace TauCeti

open LocalFieldsRamification

variable {K L : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L]
  [Algebra.IsQuadraticExtension K L]

/-- A unit of odd defect exponent `d` defines a quadratic extension whose upper break is
`2 v_K(2) - d`. The subtraction is in `ℕ`; the unit-defect bound ensures that `d < 2 v_K(2)`.
-/
theorem upperJump_of_odd_defectExponent [Algebra.IsSeparable K L]
    (h2 : (2 : K) ≠ 0) {a : Kˣ} {x : L}
    (hx : x ∉ Set.range (algebraMap K L)) (hx2 : x ^ 2 = algebraMap K L (a : K))
    (ha : valuation K (a : K) = 1) {d : ℕ} (hd : defectExponent a = (d : ℤ))
    (hodd : Odd d) :
    UpperJump K L ⟨(2 * dyadicLevel K h2 - d : ℕ), Nat.cast_mem_ramificationIndexDomain _⟩ := by
  have hprime : (Module.finrank K L).Prime := by
    rw [Algebra.IsQuadraticExtension.finrank_eq_two K L]
    exact Nat.prime_two
  have he : ramificationIndex K L = 2 :=
    (ramificationIndex_eq_two_iff_odd_defectExponent h2 hx hx2 hd).2
      (by exact_mod_cast hodd)
  have h0 : lowerRamificationGroup K L 0 ≠ ⊥ := by
    intro h
    have hcard := natCard_lowerRamificationGroup_zero K L
    rw [h, Subgroup.card_bot, he] at hcard
    norm_num at hcard
  obtain ⟨N, hN⟩ := exists_forall_lowerRamificationGroup_eq_bot K L
  have hv : lowerRamificationGroup K L (psiNat K L N.toNat) = ⊥ :=
    hN _ ((Int.self_le_toNat N).trans (by exact_mod_cast self_le_psiNat K L N.toNat))
  obtain ⟨t, -, ht⟩ := exists_lt_upperJump_of_finrank_prime hprime hv h0
  have hnorm : normGroup K L = quadraticNormSubgroup (a : K) := by
    ext b
    rw [mem_normGroup_iff_exists_sq_sub_mul_sq L hx hx2,
      ← hilbertSymbol_eq_one_iff a b, hilbertSymbol_eq_one_iff_mem_quadraticNormSubgroup]
  have hthreshold (n : ℕ) : t < n ↔ 2 * dyadicLevel K h2 - d < n := by
    rw [← Nat.cast_lt (α := ℝ), ← ht.unitFiltration_le_normGroup_iff_of_finrank_prime hprime n,
      hnorm, unitFiltration_le_quadraticNormSubgroup_iff_of_odd_defectExponent h2 ha hd hodd]
  have hle := (hthreshold (t + 1)).1 (by omega)
  have hge := (hthreshold (2 * dyadicLevel K h2 - d + 1)).2 (by omega)
  have ht_eq : t = 2 * dyadicLevel K h2 - d := by omega
  simpa only [ht_eq] using ht

/-- The different exponent of a quadratic extension generated by the square root of a unit
of odd defect exponent `d` is `2 v_K(2) - d + 1`. -/
theorem differentExponent_eq_of_odd_defectExponent (h2 : (2 : K) ≠ 0) {a : Kˣ} {x : L}
    (hx : x ∉ Set.range (algebraMap K L)) (hx2 : x ^ 2 = algebraMap K L (a : K))
    (ha : valuation K (a : K) = 1) {d : ℕ} (hd : defectExponent a = (d : ℤ))
    (hodd : Odd d) :
    differentExponent K L = 2 * dyadicLevel K h2 - d + 1 := by
  have := Algebra.isSeparable_of_finrank_eq_two h2
    (Algebra.IsQuadraticExtension.finrank_eq_two K L)
  have hprime : (Module.finrank K L).Prime := by
    rw [Algebra.IsQuadraticExtension.finrank_eq_two K L]
    exact Nat.prime_two
  have ht := upperJump_of_odd_defectExponent h2 hx hx2 ha hd hodd
  have htop := lowerRamificationGroup_natCast_eq_top_of_upperJump K L hprime ht
  have hzero : lowerRamificationGroup K L 0 = ⊤ :=
    top_le_iff.1 (htop ▸ lowerRamificationGroup_antitone K L (by positivity))
  have hbot := lowerRamificationGroup_natCast_add_one_eq_bot_of_upperJump K L hprime ht
  rw [differentExponent_eq_of_lowerRamificationGroup_eq_at_zero_eq_bot K L
    (htop.trans hzero.symm) hbot, natCard_lowerRamificationGroup_zero,
    (ramificationIndex_eq_two_iff_odd_defectExponent h2 hx hx2 hd).2
      (by exact_mod_cast hodd)]
  simp

/-- The discriminant exponent of a quadratic extension generated by the square root of a
unit of odd defect exponent `d` is `2 v_K(2) - d + 1`. Separability is an instance parameter
because it is required to form `discriminantExponent`. -/
theorem discriminantExponent_eq_of_odd_defectExponent [Algebra.IsSeparable K L]
    (h2 : (2 : K) ≠ 0) {a : Kˣ} {x : L}
    (hx : x ∉ Set.range (algebraMap K L)) (hx2 : x ^ 2 = algebraMap K L (a : K))
    (ha : valuation K (a : K) = 1) {d : ℕ} (hd : defectExponent a = (d : ℤ))
    (hodd : Odd d) :
    discriminantExponent K L = 2 * dyadicLevel K h2 - d + 1 := by
  have he := (ramificationIndex_eq_two_iff_odd_defectExponent h2 hx hx2 hd).2
    (by exact_mod_cast hodd)
  have hf := ramificationIndex_mul_inertiaDegree (K := K) (L := L)
  rw [he, Algebra.IsQuadraticExtension.finrank_eq_two K L] at hf
  have hf1 : inertiaDegree K L = 1 := by omega
  rw [discriminantExponent_eq_inertiaDegree_mul_differentExponent, hf1, one_mul]
  exact differentExponent_eq_of_odd_defectExponent h2 hx hx2 ha hd hodd

/-- The discriminant ideal of a quadratic extension generated by the square root of a
unit of odd defect exponent `d` is `𝓂[K]^(2 v_K(2) - d + 1)`. -/
theorem discriminantIdeal_eq_of_odd_defectExponent (h2 : (2 : K) ≠ 0) {a : Kˣ} {x : L}
    (hx : x ∉ Set.range (algebraMap K L)) (hx2 : x ^ 2 = algebraMap K L (a : K))
    (ha : valuation K (a : K) = 1) {d : ℕ} (hd : defectExponent a = (d : ℤ))
    (hodd : Odd d) :
    discriminantIdeal K L = 𝓂[K] ^ (2 * dyadicLevel K h2 - d + 1) := by
  have := Algebra.isSeparable_of_finrank_eq_two h2
    (Algebra.IsQuadraticExtension.finrank_eq_two K L)
  rw [discriminantIdeal_eq_maximalIdeal_pow,
    discriminantExponent_eq_of_odd_defectExponent h2 hx hx2 ha hd hodd]

end TauCeti
