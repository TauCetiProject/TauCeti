/-!
# Ramification of the dyadic eighth-root cyclotomic extension

The local field `ℚ₂(ζ₈)` is totally ramified of degree four, and `ζ₈ - 1` generates its
integer ring and is a uniformizer. The lower index of an automorphism is two when its
cyclotomic exponent is three or seven, and four when that exponent is five. Thus the lower
ramification groups are the whole group through index one, the subgroup generated by
`ζ₈ ↦ -ζ₈` at indices two and three, and trivial from index four.

Hilbert's formula then gives different and discriminant exponents equal to eight.

These computations supply the cyclotomic side of the comparison of lower numbering with
the quadratic subextension `ℚ₂(√2)`.

## References

* J.-P. Serre, *Local Fields*, Chapter IV, §§1 and 4.

The local-field construction follows the other modules in
`TauCeti.NumberTheory.LocalField.WorkedExamples`. The norm computations reuse Mathlib's
`IsPrimitiveRoot.norm_sub_one_two` and `norm_pow_sub_one_of_prime_pow_ne_two`.
-/

public section
noncomputable section

open Polynomial ValuativeRel IsLocalRing

namespace TauCeti

/-- The dyadic cyclotomic field generated by a primitive eighth root of unity. -/
abbrev DyadicCyclotomicEight : Type := CyclotomicField 8 ℚ_[2]

namespace DyadicCyclotomicEight

instance : FiniteDimensional ℚ_[2] DyadicCyclotomicEight :=
  IsCyclotomicExtension.finiteDimensional {8} ℚ_[2] DyadicCyclotomicEight

instance : IsGalois ℚ_[2] DyadicCyclotomicEight :=
  IsCyclotomicExtension.isGalois {8} ℚ_[2] DyadicCyclotomicEight

instance : ValuativeRel DyadicCyclotomicEight :=
  finiteExtensionValuativeRel ℚ_[2] DyadicCyclotomicEight

instance : TopologicalSpace DyadicCyclotomicEight :=
  finiteExtensionNormedFieldTopology ℚ_[2] DyadicCyclotomicEight

instance : ValuativeExtension ℚ_[2] DyadicCyclotomicEight :=
  finiteExtension_valuativeExtension ℚ_[2] DyadicCyclotomicEight

instance : IsNonarchimedeanLocalField DyadicCyclotomicEight :=
  finiteExtension_isNonarchimedeanLocalField ℚ_[2] DyadicCyclotomicEight

/-- A distinguished primitive eighth root of unity. -/
def zetaEight : DyadicCyclotomicEight :=
  IsCyclotomicExtension.zeta 8 ℚ_[2] DyadicCyclotomicEight

/-- Identify the distinguished root with Mathlib's cyclotomic generator. -/
theorem zetaEight_def : zetaEight = IsCyclotomicExtension.zeta 8 ℚ_[2] DyadicCyclotomicEight :=
  (rfl)

/-- The distinguished root has order eight. -/
theorem isPrimitiveRoot_zetaEight : IsPrimitiveRoot zetaEight 8 :=
  IsCyclotomicExtension.zeta_spec 8 ℚ_[2] DyadicCyclotomicEight

private theorem irreducible_cyclotomic_eight : Irreducible (cyclotomic 8 ℚ_[2]) :=
  irreducible_cyclotomic_prime_pow_ratPadic 2 3

/-- The degree of the eighth-root cyclotomic extension is four. -/
@[simp]
theorem finrank_eq_four : Module.finrank ℚ_[2] DyadicCyclotomicEight = 4 := by
  rw [IsCyclotomicExtension.finrank DyadicCyclotomicEight irreducible_cyclotomic_eight]
  decide

/-- The fourth power of the distinguished root is minus one. -/
@[simp]
theorem zetaEight_pow_four : zetaEight ^ 4 = -1 := by
  have h := isPrimitiveRoot_zetaEight.pow_of_dvd (by decide : (4 : ℕ) ≠ 0) (by decide)
  exact h.eq_neg_one_of_two_right

private theorem integral_zetaEight : IsIntegral 𝒪[ℚ_[2]] zetaEight :=
  ⟨X ^ 8 - 1, by monicity!, by simp [isPrimitiveRoot_zetaEight.pow_eq_one]⟩

/-- The distinguished root as an integer of the cyclotomic field. -/
def integerZetaEight : 𝒪[DyadicCyclotomicEight] :=
  ⟨zetaEight, (Valuation.Integers.isIntegral_iff_valuation_le_one
    (Valuation.integer.integers (valuation ℚ_[2])) _).1 integral_zetaEight⟩

@[simp]
theorem coe_integerZetaEight : (integerZetaEight : DyadicCyclotomicEight) = zetaEight := (rfl)

@[simp]
private theorem coe_ofNat_two : ((2 : 𝒪[DyadicCyclotomicEight]) : DyadicCyclotomicEight) = 2 :=
  map_ofNat 𝒪[DyadicCyclotomicEight].subtype 2

@[simp]
private theorem coe_base_ofNat_two : ((2 : 𝒪[ℚ_[2]]) : ℚ_[2]) = 2 :=
  map_ofNat 𝒪[ℚ_[2]].subtype 2

/-- The norm of `ζ₈ - 1` is two. -/
@[simp]
private theorem norm_integerZetaEight_sub_one :
    Algebra.norm 𝒪[ℚ_[2]] (integerZetaEight - 1) = 2 := by
  apply Subtype.ext
  rw [coe_norm_integerRing, AddSubgroupClass.coe_sub, coe_integerZetaEight, Subring.coe_one]
  exact (isPrimitiveRoot_zetaEight.norm_sub_one_two (by decide : 2 ≤ 3)
    irreducible_cyclotomic_eight).trans (map_ofNat 𝒪[ℚ_[2]].subtype 2).symm

private theorem inertiaDegree_and_addVal :
    inertiaDegree ℚ_[2] DyadicCyclotomicEight = 1 ∧
      IsDiscreteValuationRing.addVal 𝒪[DyadicCyclotomicEight] (integerZetaEight - 1) = 1 := by
  have h := addVal_norm (K := ℚ_[2]) (integerZetaEight - 1)
  rw [norm_integerZetaEight_sub_one,
    ← Nat.cast_ofNat (R := 𝒪[ℚ_[2]]),
    IsDiscreteValuationRing.addVal_uniformizer (Padic.irreducible_natCast_self 2),
    nsmul_eq_mul] at h
  obtain ⟨hf, hval⟩ := mul_eq_one.1 h.symm
  exact ⟨by exact_mod_cast hf, hval⟩

/-- The residue degree of `ℚ₂(ζ₈)/ℚ₂` is one. -/
@[simp]
theorem inertiaDegree_eq_one : inertiaDegree ℚ_[2] DyadicCyclotomicEight = 1 :=
  inertiaDegree_and_addVal.1

/-- The ramification index of `ℚ₂(ζ₈)/ℚ₂` is four. -/
@[simp]
theorem ramificationIndex_eq_four : ramificationIndex ℚ_[2] DyadicCyclotomicEight = 4 := by
  simpa using ramificationIndex_mul_inertiaDegree ℚ_[2] DyadicCyclotomicEight

/-- The cyclotomic extension is totally ramified. -/
theorem isTotallyRamified : IsTotallyRamified ℚ_[2] DyadicCyclotomicEight :=
  (isTotallyRamified_iff_inertiaDegree_eq_one _ _).2 inertiaDegree_eq_one

/-- `ζ₈ - 1` is a uniformizer in the cyclotomic integer ring. -/
theorem irreducible_integerZetaEight_sub_one : Irreducible (integerZetaEight - 1) := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[DyadicCyclotomicEight]
  have hassoc := (IsDiscreteValuationRing.addVal_eq_iff_associated _ _).1
    ((IsDiscreteValuationRing.addVal_uniformizer hπ).trans inertiaDegree_and_addVal.2.symm)
  exact hassoc.irreducible hπ

/-- The ring of integers is generated by `ζ₈ - 1` over the integers of `ℚ₂`. -/
theorem adjoin_integerZetaEight_sub_one_eq_top :
    Algebra.adjoin 𝒪[ℚ_[2]] {integerZetaEight - 1} = ⊤ :=
  isTotallyRamified.adjoin_eq_top_of_irreducible irreducible_integerZetaEight_sub_one

/-- The fourth power of the integral root is minus one. -/
@[simp]
private theorem integerZetaEight_pow_four : integerZetaEight ^ 4 = -1 := by
  apply Subtype.ext
  simp

/-- The integral root of unity has valuation zero. -/
@[simp]
private theorem addVal_integerZetaEight :
    IsDiscreteValuationRing.addVal 𝒪[DyadicCyclotomicEight] integerZetaEight = 0 := by
  have h := congrArg (IsDiscreteValuationRing.addVal 𝒪[DyadicCyclotomicEight])
    integerZetaEight_pow_four
  rw [IsDiscreteValuationRing.addVal_pow, AddValuation.map_neg, AddValuation.map_one] at h
  simpa using h

/-- Two has valuation four in the cyclotomic extension. -/
@[simp]
private theorem addVal_two : IsDiscreteValuationRing.addVal 𝒪[DyadicCyclotomicEight] 2 = 4 := by
  rw [← map_ofNat (algebraMap 𝒪[ℚ_[2]] 𝒪[DyadicCyclotomicEight]) 2, addVal_algebraMap,
    ← Nat.cast_ofNat (R := 𝒪[ℚ_[2]]),
    IsDiscreteValuationRing.addVal_uniformizer (Padic.irreducible_natCast_self 2),
    ramificationIndex_eq_four]
  norm_num

/-- The difference `ζ₈² - 1` has valuation two. -/
@[simp]
private theorem addVal_integerZetaEight_sq_sub_one :
    IsDiscreteValuationRing.addVal 𝒪[DyadicCyclotomicEight] (integerZetaEight ^ 2 - 1) = 2 := by
  have hnorm : Algebra.norm 𝒪[ℚ_[2]] (integerZetaEight ^ 2 - 1) = 2 ^ 2 := by
    apply Subtype.ext
    rw [coe_norm_integerRing, AddSubgroupClass.coe_sub, Subring.coe_pow,
      coe_integerZetaEight, Subring.coe_one]
    exact (isPrimitiveRoot_zetaEight.norm_pow_sub_one_of_prime_pow_ne_two
      (p := 2) (k := 2) (s := 1) irreducible_cyclotomic_eight (by decide) (by decide)).trans
        (by simp only [Subring.coe_pow, coe_base_ofNat_two, pow_one, Nat.cast_ofNat])
  have h := addVal_norm (K := ℚ_[2]) (integerZetaEight ^ 2 - 1)
  rw [hnorm, IsDiscreteValuationRing.addVal_pow,
    ← Nat.cast_ofNat (R := 𝒪[ℚ_[2]]),
    IsDiscreteValuationRing.addVal_uniformizer (Padic.irreducible_natCast_self 2),
    inertiaDegree_eq_one, one_smul, nsmul_one] at h
  exact h.symm

private theorem addVal_integerZetaEight_sq_add_one :
    IsDiscreteValuationRing.addVal 𝒪[DyadicCyclotomicEight] (integerZetaEight ^ 2 + 1) = 2 := by
  have heq : (integerZetaEight ^ 2 - 1) * (integerZetaEight ^ 2 + 1) = -2 := by
    linear_combination integerZetaEight_pow_four
  have h := congrArg (IsDiscreteValuationRing.addVal 𝒪[DyadicCyclotomicEight]) heq
  rw [IsDiscreteValuationRing.addVal_mul, addVal_integerZetaEight_sq_sub_one,
    AddValuation.map_neg, addVal_two] at h
  have h' : (2 : ℕ∞) +
      IsDiscreteValuationRing.addVal 𝒪[DyadicCyclotomicEight] (integerZetaEight ^ 2 + 1) = 2 + 2 :=
    h.trans (by norm_num)
  exact le_antisymm ((ENat.add_le_add_iff_left (by simp)).1 h'.le)
    ((ENat.add_le_add_iff_left (by simp)).1 h'.ge)

private theorem apply_zetaEight_cases (σ : DyadicCyclotomicEight ≃ₐ[ℚ_[2]] DyadicCyclotomicEight) :
    σ zetaEight = zetaEight ∨ σ zetaEight = zetaEight ^ 3 ∨
      σ zetaEight = -zetaEight ∨ σ zetaEight = -zetaEight ^ 3 := by
  have h := isPrimitiveRoot_zetaEight.autToPow_spec ℚ_[2] σ
  generalize hu : isPrimitiveRoot_zetaEight.autToPow ℚ_[2] σ = u at h
  fin_cases u
  all_goals norm_num [ZMod.val] at h
  · exact Or.inl (by simpa using h.symm)
  · exact Or.inr (Or.inl (by simpa using h.symm))
  · exact Or.inr (Or.inr (Or.inl (by
      rw [show (5 : ℕ) = 4 + 1 by decide, pow_add, zetaEight_pow_four] at h
      simpa using h.symm)))
  · exact Or.inr (Or.inr (Or.inr (by
      rw [show (7 : ℕ) = 4 + 3 by decide, pow_add, zetaEight_pow_four] at h
      simpa using h.symm)))

open Classical in
private theorem addVal_smul_sub_integerZetaEight_of_ne_one
    {σ : DyadicCyclotomicEight ≃ₐ[ℚ_[2]] DyadicCyclotomicEight} (hσ : σ ≠ 1) :
    IsDiscreteValuationRing.addVal 𝒪[DyadicCyclotomicEight]
      (σ • integerZetaEight - integerZetaEight) =
        if σ zetaEight = -zetaEight then 4 else 2 := by
  -- Split by the three nonidentity cyclotomic exponents. Factor the displacement into
  -- a root of unity times `ζ² - 1`, `-2`, or `-(ζ² + 1)`, respectively.
  have hid : σ zetaEight ≠ zetaEight := fun h ↦ hσ <|
    AlgEquiv.coe_toAlgHom_injective ((isPrimitiveRoot_zetaEight.powerBasis ℚ_[2]).algHom_ext
      (by simpa using h))
  rcases (apply_zetaEight_cases σ).resolve_left hid with h3 | h5 | h7
  · have heq : σ • integerZetaEight - integerZetaEight =
        integerZetaEight * (integerZetaEight ^ 2 - 1) := by
      apply Subtype.ext
      simp only [AddSubgroupClass.coe_sub, AlgEquiv.coe_smul_integerRing,
        coe_integerZetaEight, h3, Subring.coe_mul, Subring.coe_pow, Subring.coe_one]
      ring
    have hne : σ zetaEight ≠ -zetaEight := by
      intro h
      have hz : zetaEight ≠ 0 := isPrimitiveRoot_zetaEight.ne_zero (by decide)
      have h2 : zetaEight ^ 2 = -1 := by
        apply mul_left_cancel₀ hz
        linear_combination -h3 + h
      have h := isPrimitiveRoot_zetaEight.pow_eq_one_iff_dvd 4
      have h4 : zetaEight ^ 4 = 1 := by rw [show (4 : ℕ) = 2 * 2 by decide, pow_mul, h2]; norm_num
      have hdvd := h.1 h4
      norm_num at hdvd
    simp only [ite_eq_right hne, heq, IsDiscreteValuationRing.addVal_mul,
      addVal_integerZetaEight, zero_add, addVal_integerZetaEight_sq_sub_one]
  · have heq : σ • integerZetaEight - integerZetaEight = -(2 * integerZetaEight) := by
      apply Subtype.ext
      simp only [AddSubgroupClass.coe_sub, AlgEquiv.coe_smul_integerRing,
        coe_integerZetaEight, h5, Subring.coe_neg, Subring.coe_mul]
      rw [coe_ofNat_two]
      ring
    simp only [ite_eq_left h5, heq, AddValuation.map_neg, IsDiscreteValuationRing.addVal_mul,
      addVal_two, addVal_integerZetaEight, add_zero]
  · have heq : σ • integerZetaEight - integerZetaEight =
        -(integerZetaEight * (integerZetaEight ^ 2 + 1)) := by
      apply Subtype.ext
      simp only [AddSubgroupClass.coe_sub, AlgEquiv.coe_smul_integerRing,
        coe_integerZetaEight, h7, Subring.coe_neg, Subring.coe_mul, Subring.coe_pow,
        Subring.coe_add, Subring.coe_one]
      ring
    have hne : σ zetaEight ≠ -zetaEight := by
      intro h
      have hz : zetaEight ≠ 0 := isPrimitiveRoot_zetaEight.ne_zero (by decide)
      have h2 : zetaEight ^ 2 = 1 := by
        apply mul_left_cancel₀ hz
        linear_combination h7 - h
      have h := (isPrimitiveRoot_zetaEight.pow_eq_one_iff_dvd 2).1 h2
      norm_num at h
    simp only [ite_eq_right hne, heq, AddValuation.map_neg, IsDiscreteValuationRing.addVal_mul,
      addVal_integerZetaEight, zero_add, addVal_integerZetaEight_sq_add_one]

open Classical in
/-- The lower index is infinite at the identity, four at `ζ₈ ↦ -ζ₈`, and two at each of
`ζ₈ ↦ ζ₈³` and `ζ₈ ↦ ζ₈⁷`. -/
theorem lowerIndex_eq (σ : DyadicCyclotomicEight ≃ₐ[ℚ_[2]] DyadicCyclotomicEight) :
    TauCeti.IsLocalRing.lowerIndex 𝒪[DyadicCyclotomicEight] σ =
      if σ = 1 then (⊤ : ℕ∞) else if σ zetaEight = -zetaEight then 4 else 2 := by
  classical
  by_cases hσ : σ = 1
  · subst σ
    simp
  rw [ite_eq_right hσ, TauCeti.IsLocalRing.lowerIndex_eq_addVal_of_adjoin_singleton_eq_top
    adjoin_integerZetaEight_sub_one_eq_top]
  have hval : σ • (integerZetaEight - 1) - (integerZetaEight - 1) =
      σ • integerZetaEight - integerZetaEight := by
    rw [smul_sub, smul_one]
    ring
  rw [hval, addVal_smul_sub_integerZetaEight_of_ne_one hσ]

/-- The automorphism with cyclotomic exponent five, sending `ζ₈` to `-ζ₈`. -/
def sigmaFive : DyadicCyclotomicEight ≃ₐ[ℚ_[2]] DyadicCyclotomicEight :=
  IsCyclotomicExtension.fromZetaAut
    (isPrimitiveRoot_zetaEight.pow_of_coprime 5 (by decide)) irreducible_cyclotomic_eight

/-- The exponent-five automorphism negates the distinguished root. -/
@[simp]
theorem sigmaFive_zetaEight : sigmaFive zetaEight = -zetaEight := by
  have h : sigmaFive zetaEight = zetaEight ^ 5 :=
    IsCyclotomicExtension.fromZetaAut_spec
      (isPrimitiveRoot_zetaEight.pow_of_coprime 5 (by decide)) irreducible_cyclotomic_eight
  rw [show (5 : ℕ) = 4 + 1 by decide, pow_add, zetaEight_pow_four] at h
  simpa using h

private theorem eq_sigmaFive_iff (σ : DyadicCyclotomicEight ≃ₐ[ℚ_[2]] DyadicCyclotomicEight) :
    σ = sigmaFive ↔ σ zetaEight = -zetaEight := by
  constructor
  · rintro rfl
    exact sigmaFive_zetaEight
  · intro h
    exact AlgEquiv.coe_toAlgHom_injective
      ((isPrimitiveRoot_zetaEight.powerBasis ℚ_[2]).algHom_ext (by simpa using h))

/-- The exponent-five automorphism has order two. -/
@[simp]
theorem orderOf_sigmaFive : orderOf sigmaFive = 2 := by
  apply orderOf_eq_prime
  · apply AlgEquiv.coe_toAlgHom_injective
    apply (isPrimitiveRoot_zetaEight.powerBasis ℚ_[2]).algHom_ext
    simp [pow_two, AlgEquiv.mul_apply]
  · intro h
    have hz := congrArg (fun σ : DyadicCyclotomicEight ≃ₐ[ℚ_[2]] DyadicCyclotomicEight ↦
      σ zetaEight) h
    simp only [sigmaFive_zetaEight, AlgEquiv.one_apply] at hz
    have hzero : zetaEight = 0 := by linear_combination -hz / 2
    exact isPrimitiveRoot_zetaEight.ne_zero (by decide) hzero

private theorem mem_zpowers_sigmaFive_iff
    (σ : DyadicCyclotomicEight ≃ₐ[ℚ_[2]] DyadicCyclotomicEight) :
    σ ∈ Subgroup.zpowers sigmaFive ↔ σ = 1 ∨ σ = sigmaFive := by
  classical
  rw [mem_zpowers_iff_mem_range_orderOf, orderOf_sigmaFive]
  simp only [Finset.mem_image, Finset.mem_range]
  constructor
  · rintro ⟨n, hn, rfl⟩
    interval_cases n <;> simp
  · rintro (rfl | rfl)
    · exact ⟨0, by decide, pow_zero _⟩
    · exact ⟨1, by decide, pow_one _⟩

/-- The complete lower filtration: the whole group through index one, the exponent-five
subgroup at indices two and three, and the trivial group from index four. -/
@[simp]
theorem lowerRamificationGroup_eq (i : ℤ) :
    LocalFieldsRamification.lowerRamificationGroup ℚ_[2] DyadicCyclotomicEight i =
      if i ≤ 1 then ⊤ else if i ≤ 3 then Subgroup.zpowers sigmaFive else ⊥ := by
  ext σ
  rw [LocalFieldsRamification.mem_lowerRamificationGroup_iff_le_lowerIndex, lowerIndex_eq]
  classical
  by_cases hσ : σ = 1
  · subst σ
    simp
  by_cases h5 : σ zetaEight = -zetaEight
  · have heq : σ = sigmaFive := (eq_sigmaFive_iff σ).2 h5
    subst σ
    simp only [ite_eq_right hσ, ite_eq_left h5]
    split_ifs with hi1 hi3
    · simp only [Subgroup.mem_top, iff_true]
      norm_cast
      omega
    · simp only [Subgroup.mem_zpowers, iff_true]
      norm_cast
      omega
    · simp only [Subgroup.mem_bot, hσ, iff_false, not_le]
      norm_cast
      omega
  · have hne : σ ≠ sigmaFive := fun heq ↦ h5 ((eq_sigmaFive_iff σ).1 heq)
    simp only [ite_eq_right hσ, ite_eq_right h5]
    split_ifs <;> simp_all [mem_zpowers_sigmaFive_iff]

/-- The different exponent of `ℚ₂(ζ₈)/ℚ₂` is eight. -/
@[simp]
theorem differentExponent_eq_eight : differentExponent ℚ_[2] DyadicCyclotomicEight = 8 := by
  rw [differentExponent_eq_finsum_lowerRamificationGroup]
  rw [finsum_eq_sum_of_support_subset _ (s := Finset.range 4) (by
    intro i hi
    by_contra h
    have hi4 : 4 ≤ i := by simpa using h
    simp only [Function.mem_support] at hi
    rw [lowerRamificationGroup_eq, ite_eq_right (by omega : ¬(i : ℤ) ≤ 1),
      ite_eq_right (by omega : ¬(i : ℤ) ≤ 3), Subgroup.card_bot] at hi
    exact hi rfl)]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, lowerRamificationGroup_eq]
  norm_num only [Subgroup.card_top, IsGalois.card_aut_eq_finrank, finrank_eq_four,
    Nat.card_zpowers, orderOf_sigmaFive, ite_true, ite_false, zero_add]

/-- The local discriminant exponent of `ℚ₂(ζ₈)/ℚ₂` is eight. -/
@[simp]
theorem discriminantExponent_eq_eight : discriminantExponent ℚ_[2] DyadicCyclotomicEight = 8 := by
  rw [discriminantExponent_eq_inertiaDegree_mul_differentExponent, inertiaDegree_eq_one,
    differentExponent_eq_eight, one_mul]

end DyadicCyclotomicEight
end TauCeti
