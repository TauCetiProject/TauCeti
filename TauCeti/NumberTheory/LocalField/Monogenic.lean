/-!
# Integral generators of finite local-field extensions

The integer ring of a finite extension of nonarchimedean local fields is generated by one
integral element over the base integer ring. An integral power basis can be chosen whose
generator also generates the field extension and whose length is the field degree. These results
let ramification and different computations use a generator without imposing a separate
monogenicity hypothesis. When the extension is totally ramified, every uniformizer `ϖ` of `L` is
such a generator, so `1, ϖ, …, ϖ^{e - 1}` is a basis of `𝒪[L]` over `𝒪[K]`, with `e = [L : K]`.
In that basis the additive valuation of an element of `𝒪[L]` is read off from its coordinates.
For any `K`-embedding `σ : L →ₐ[K] M` into a local field extension `M/L`, an integral generator
minimizes the root-difference valuation `v_M(σ y - y)` across `𝒪[L]`; in a totally ramified
extension this valuation is independent of the choice of uniformizer.

## Main results

* `TauCeti.exists_integerRing_adjoin_eq_top`: `𝒪[L]` is monogenic over `𝒪[K]`.
* `TauCeti.IsTotallyRamified.integralPowerBasis`: the power basis of `𝒪[L]` over `𝒪[K]` generated
  by a uniformizer of a totally ramified extension, of length `e(L/K)`.
* `TauCeti.IsTotallyRamified.exists_sum_algebraMap_mul_pow_eq`: every element of `𝒪[L]` is
  `∑ i < e(L/K), t_i ϖ^i` with coefficients `t_i ∈ 𝒪[K]`.
* `TauCeti.IsTotallyRamified.addVal_eq_iInf_integralPowerBasis_repr`: the additive valuation of
  `x ∈ 𝒪[L]` is the least of `e(L/K) · v_K(a_i) + i` over the coordinates `a_i` of `x` in that
  basis.
* `TauCeti.realAddValuation_sub_algebraMap_le_of_adjoin_eq_top`: an integral generator `x` of
  `𝒪[L]` over `𝒪[K]` minimizes `v_M(σ y - y)` over `y ∈ 𝒪[L]` for every `σ : L →ₐ[K] M`.
* `TauCeti.realAddValuation_sub_algebraMap_eq_of_irreducible`: in a totally ramified extension
  `L/K`, any two uniformizers have equal root-difference valuation at every `σ : L →ₐ[K] M`.

## References

* J.-P. Serre, *Corps Locaux*, Chapter I, §6, Proposition 18.
* J.-P. Serre, *Corps Locaux*, Chapter III, §6, Proposition 12.
-/

public section
noncomputable section

open ValuativeRel IsLocalRing

namespace TauCeti

variable (K L : Type*) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L]

/-- The integer ring of a finite extension of nonarchimedean local fields is generated as an
algebra over the base integer ring by one element. -/
theorem exists_integerRing_adjoin_eq_top :
    ∃ x : 𝒪[L], Algebra.adjoin 𝒪[K] {x} = ⊤ := by
  exact IsDiscreteValuationRing.exists_adjoin_eq_top (R := 𝒪[K]) (S := 𝒪[L])

/-- The integer ring of a finite local-field extension has an integral power basis whose
generator also generates the field extension. Its length is `[L : K]`. -/
theorem exists_integerRing_powerBasis_intermediateField_adjoin_eq_top_and_dim_eq_finrank :
    ∃ pb : PowerBasis 𝒪[K] 𝒪[L],
      IntermediateField.adjoin K {((pb.gen : 𝒪[L]) : L)} = ⊤ ∧
      pb.dim = Module.finrank K L := by
  obtain ⟨pb, hpb⟩ := IsDiscreteValuationRing.exists_powerBasis_intermediateField_adjoin_eq_top
    (R := 𝒪[K]) (S := 𝒪[L]) K L
  refine ⟨pb, hpb, ?_⟩
  rw [← pb.finrank, finrank_integerRing K L]

variable {K L}

/-- In a totally ramified extension of nonarchimedean local fields, every uniformizer of `L`
generates `𝒪[L]` as an `𝒪[K]`-algebra. -/
theorem IsTotallyRamified.adjoin_eq_top_of_irreducible (h : IsTotallyRamified K L) {ϖ : 𝒪[L]}
    (hϖ : Irreducible ϖ) : Algebra.adjoin 𝒪[K] {ϖ} = ⊤ :=
  IsLocalRing.adjoin_eq_top_of_algebraMap_residueField_surjective_of_span_eq_maximalIdeal
    ((isTotallyRamified_iff_surjective_algebraMap_residueField K L).1 h) hϖ.maximalIdeal_eq.symm

/-- **The integral power basis of a totally ramified extension.** In a totally ramified extension
`L/K` of nonarchimedean local fields, the powers `1, ϖ, …, ϖ^{e - 1}` of a uniformizer `ϖ` of `L`
form a basis of `𝒪[L]` over `𝒪[K]`, where `e = e(L/K) = [L : K]`. -/
noncomputable def IsTotallyRamified.integralPowerBasis (h : IsTotallyRamified K L) {ϖ : 𝒪[L]}
    (hϖ : Irreducible ϖ) : PowerBasis 𝒪[K] 𝒪[L] :=
  PowerBasis.ofAdjoinEqTop' (IsIntegral.of_finite 𝒪[K] ϖ) (h.adjoin_eq_top_of_irreducible hϖ)

/-- The integral power basis of a totally ramified extension is generated by the chosen
uniformizer. -/
@[simp]
theorem IsTotallyRamified.integralPowerBasis_gen (h : IsTotallyRamified K L) {ϖ : 𝒪[L]}
    (hϖ : Irreducible ϖ) : (h.integralPowerBasis hϖ).gen = ϖ :=
  PowerBasis.ofAdjoinEqTop'_gen ..

/-- The integral power basis of a totally ramified extension has length `e(L/K)`. -/
@[simp]
theorem IsTotallyRamified.integralPowerBasis_dim (h : IsTotallyRamified K L) {ϖ : 𝒪[L]}
    (hϖ : Irreducible ϖ) : (h.integralPowerBasis hϖ).dim = ramificationIndex K L := by
  rw [← PowerBasis.finrank, finrank_integerRing,
    (isTotallyRamified_iff_ramificationIndex_eq_finrank K L).1 h]

/-- In a totally ramified extension, every element of `𝒪[L]` has coordinates in the powers
`1, ϖ, …, ϖ ^ (n - 1)` of a uniformizer `ϖ` of `L`, where `n = e(L/K)`. -/
theorem IsTotallyRamified.exists_sum_algebraMap_mul_pow_eq (h : IsTotallyRamified K L)
    {ϖ : 𝒪[L]} (hϖ : Irreducible ϖ) {n : ℕ} (hn : ramificationIndex K L = n) (y : 𝒪[L]) :
    ∃ t : Fin n → 𝒪[K], ∑ i, algebraMap 𝒪[K] 𝒪[L] (t i) * ϖ ^ (i : ℕ) = y := by
  let b := (h.integralPowerBasis hϖ).basis.reindex
    (finCongr ((h.integralPowerBasis_dim hϖ).trans hn))
  refine ⟨b.repr y, ?_⟩
  conv_rhs => rw [← b.sum_repr y]
  simp [b, Algebra.smul_def]

/-- **Valuations in the integral power basis.** In a totally ramified extension `L/K` with
uniformizer `ϖ`, the additive valuation of `x ∈ 𝒪[L]` is the least of `e(L/K) · v_K(a_i) + i`,
where `x = ∑ a_i ϖ^i` is the expansion of `x` in the integral power basis. -/
theorem IsTotallyRamified.addVal_eq_iInf_integralPowerBasis_repr (h : IsTotallyRamified K L)
    {ϖ : 𝒪[L]} (hϖ : Irreducible ϖ) (x : 𝒪[L]) :
    IsDiscreteValuationRing.addVal 𝒪[L] x =
      ⨅ i, ramificationIndex K L •
        IsDiscreteValuationRing.addVal 𝒪[K] ((h.integralPowerBasis hϖ).basis.repr x i) +
          (i : ℕ) := by
  conv_lhs =>
    rw [← (h.integralPowerBasis hϖ).basis.sum_repr x]
    simp only [PowerBasis.coe_basis, h.integralPowerBasis_gen, Algebra.smul_def]
  exact addVal_sum_algebraMap_mul_pow_of_irreducible hϖ (h.integralPowerBasis_dim hϖ).le _

section Tower

open Polynomial

variable {M : Type*} [Field M] [ValuativeRel M] [TopologicalSpace M] [IsNonarchimedeanLocalField M]
  [Algebra K M] [Algebra L M] [IsScalarTower K L M] [ValuativeExtension L M]

/-- If `x ∈ 𝒪[L]` generates `𝒪[L]` over `𝒪[K]`, then `v_M(σ x - x) ≤ v_M(σ y - y)` for every
`y ∈ 𝒪[L]` and `σ : L →ₐ[K] M`. -/
theorem realAddValuation_sub_algebraMap_le_of_adjoin_eq_top
    {x : 𝒪[L]} (hx : Algebra.adjoin 𝒪[K] {x} = ⊤) (y : 𝒪[L]) (σ : L →ₐ[K] M) :
    realAddValuation M (σ (x : L) - algebraMap L M (x : L)) ≤
      realAddValuation M (σ (y : L) - algebraMap L M (y : L)) := by
  have : ValuativeExtension K M := ValuativeExtension.trans K L M
  obtain ⟨P, hP⟩ : y ∈ (Polynomial.aeval x : 𝒪[K][X] →ₐ[𝒪[K]] 𝒪[L]).range := by
    rw [← Algebra.adjoin_singleton_eq_range_aeval, hx]; exact Algebra.mem_top
  have hmem (τ : L →ₐ[K] M) : τ (x : L) ∈ 𝒪[M] := by
    rw [mem_integer_iff_realAddValuation_nonneg, τ.realAddValuation_apply,
      ← realAddValuation_algebraMap, ← Valuation.HasExtension.val_algebraMap (vA := valuation M)]
    exact mem_integer_iff_realAddValuation_nonneg.mp (algebraMap 𝒪[L] 𝒪[M] x).property
  let c (τ : L →ₐ[K] M) : 𝒪[M] := ⟨τ (x : L), hmem τ⟩
  have heval (τ : L →ₐ[K] M) :
      algebraMap 𝒪[M] M ((P.map (algebraMap 𝒪[K] 𝒪[M])).eval (c τ)) = τ (y : L) := by
    have hhom : (algebraMap 𝒪[M] M).comp (algebraMap 𝒪[K] 𝒪[M]) =
        τ.toRingHom.comp ((algebraMap 𝒪[L] L).comp (algebraMap 𝒪[K] 𝒪[L])) := by
      rw [algebraMap_comp_algebraMap_integerRing, algebraMap_comp_algebraMap_integerRing]
      exact RingHom.ext fun d ↦ (τ.commutes (algebraMap 𝒪[K] K d)).symm
    have hy : Polynomial.aeval x P = y := hP
    rw [eval_map, hom_eval₂, ← hy, aeval_def,
      ← Algebra.algebraMap_ofSubsemiring_apply (S := 𝒪[L]), ← AlgHom.coe_toRingHom τ,
      hom_eval₂, hom_eval₂, hhom]
    simp [c, Algebra.algebraMap_ofSubsemiring_apply]
  obtain ⟨q, hq⟩ := Polynomial.sub_dvd_eval_sub (c σ) (c (IsScalarTower.toAlgHom K L M))
    (P.map (algebraMap 𝒪[K] 𝒪[M]))
  have hval := congrArg (algebraMap 𝒪[M] M) hq
  rw [map_sub, map_mul, heval, heval, map_sub,
    Algebra.algebraMap_ofSubsemiring_apply, Algebra.algebraMap_ofSubsemiring_apply,
    Algebra.algebraMap_ofSubsemiring_apply] at hval
  simp only [c, IsScalarTower.coe_toAlgHom'] at hval
  rw [hval, (realAddValuation M).map_mul]
  exact le_add_of_nonneg_right (mem_integer_iff_realAddValuation_nonneg.mp q.property)

/-- **Uniformizer invariance of root-difference valuations.** In a totally ramified extension
`L/K`, any two uniformizers of `𝒪[L]` have equal root-difference valuation at `σ : L →ₐ[K] M`. -/
theorem realAddValuation_sub_algebraMap_eq_of_irreducible
    (h : IsTotallyRamified K L) {ξ ξ' : 𝒪[L]} (hξ : Irreducible ξ) (hξ' : Irreducible ξ')
    (σ : L →ₐ[K] M) :
    realAddValuation M (σ (ξ : L) - algebraMap L M (ξ : L)) =
      realAddValuation M (σ (ξ' : L) - algebraMap L M (ξ' : L)) :=
  le_antisymm
    (realAddValuation_sub_algebraMap_le_of_adjoin_eq_top (h.adjoin_eq_top_of_irreducible hξ) ξ' σ)
    (realAddValuation_sub_algebraMap_le_of_adjoin_eq_top (h.adjoin_eq_top_of_irreducible hξ') ξ σ)

end Tower

end TauCeti
