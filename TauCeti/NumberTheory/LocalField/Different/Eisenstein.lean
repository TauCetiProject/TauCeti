module

public import TauCeti.NumberTheory.LocalField.Different.Basic
public import TauCeti.NumberTheory.LocalField.Eisenstein.PowerBasis
public import TauCeti.NumberTheory.LocalField.NatCastValuation
import TauCeti.RingTheory.DedekindDomain.Different.Monogenic
import TauCeti.RingTheory.DiscreteValuationRing.Basic

/-!
# The different of an Eisenstein extension

For an extension whose integer ring is generated by a root of an Eisenstein polynomial, the
leading term of the polynomial derivative bounds the different exponent. The powers of the
root have distinct valuation residues, so the other derivative terms cannot cancel that term.

This is the totally ramified calculation behind the upper bound for the different of a finite
extension of local fields.

## References

* J.-P. Serre, *Local Fields*, Chapter III, §6, Proposition 13.
-/

public section
noncomputable section

open ValuativeRel IsLocalRing Polynomial IsDiscreteValuationRing

namespace TauCeti

variable {K L : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L]
  [Module.Finite K L] [Algebra.IsSeparable K L]

/-- For an Eisenstein integral generator `ξ`, the different exponent is bounded by the
valuation of the leading derivative term. -/
private theorem differentExponent_le_addVal_of_eisenstein (f : Polynomial 𝒪[K])
    (hf : f.IsEisensteinAt 𝓂[K]) (hmonic : f.Monic) (ξ : 𝒪[L])
    (hroot : (f.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ)
    (hgen : Algebra.adjoin 𝒪[K] {ξ} = ⊤) :
    (differentExponent K L : ℕ∞) ≤
      (ramificationIndex K L : ℕ) - 1 +
        ramificationIndex K L • IsDiscreteValuationRing.addVal 𝒪[K] (f.natDegree : 𝒪[K]) := by
  have hdeg : 0 < f.natDegree := by
    by_contra h
    have hdeg0 : f.natDegree = 0 := Nat.eq_zero_of_not_pos h
    have hlc : IsUnit f.leadingCoeff := notMem_maximalIdeal.mp hf.leading
    have hc0 : f.coeff 0 = f.leadingCoeff := by rw [← Polynomial.coeff_natDegree, hdeg0]
    have hmaplc : algebraMap 𝒪[K] 𝒪[L] (f.coeff 0) ≠ 0 :=
      hc0.symm ▸ (hlc.map (algebraMap 𝒪[K] 𝒪[L])).ne_zero
    rw [Polynomial.eq_C_of_natDegree_eq_zero hdeg0, Polynomial.map_C] at hroot
    exact Polynomial.not_isRoot_C _ _ hmaplc hroot
  have hfirr : Irreducible f :=
    hf.irreducible (maximalIdeal.isMaximal 𝒪[K]).isPrime hmonic.isPrimitive hdeg
  have hmin : minpoly 𝒪[K] ξ = f := by
    have haeval : aeval ξ f = 0 := by
      simpa [Polynomial.IsRoot, Polynomial.aeval_def] using hroot
    have hint : IsIntegral 𝒪[K] ξ := IsIntegral.of_finite 𝒪[K] ξ
    have hdvd : minpoly 𝒪[K] ξ ∣ f := minpoly.isIntegrallyClosed_dvd hint haeval
    exact Polynomial.eq_of_monic_of_associated (minpoly.monic hint) hmonic
      ((minpoly.irreducible hint).associated_of_dvd hfirr hdvd)
  have hdifferent : differentIdeal 𝒪[K] 𝒪[L] = Ideal.span {aeval ξ (derivative f)} := by
    rw [← hmin]
    exact differentIdeal_eq_span_aeval_derivative_minpoly 𝒪[K] K L 𝒪[L] ξ hgen
  have hderiv0 : aeval ξ (derivative f) ≠ 0 := by
    intro h
    exact differentIdeal_ne_bot (A := 𝒪[K]) (B := 𝒪[L])
      (by rw [hdifferent, h, Ideal.span_singleton_eq_bot])
  have hval : (differentExponent K L : ℕ∞) = addVal 𝒪[L] (aeval ξ (derivative f)) := by
    rw [differentExponent_def, hdifferent,
      ← TauCeti.IsDiscreteValuationRing.addVal_eq_multiplicity_span_singleton hderiv0]
  let c : Fin f.natDegree → 𝒪[K] := fun i => f.coeff (i + 1) * (i + 1)
  have hsum : aeval ξ (derivative f) =
      ∑ i : Fin f.natDegree, algebraMap 𝒪[K] 𝒪[L] (c i) * ξ ^ (i : ℕ) := by
    rw [Polynomial.aeval_eq_sum_range'
      (Polynomial.natDegree_derivative_lt (Nat.ne_of_gt hdeg)) ξ]
    simp only [← Fin.sum_univ_eq_sum_range, Polynomial.coeff_derivative,
      Algebra.smul_def, c]
  have hbound := addVal_sum_eisenstein_powerBasis f hf ξ hroot hgen c
  rw [← hsum] at hbound
  rw [hval, hbound]
  let j : Fin f.natDegree := ⟨f.natDegree - 1, by omega⟩
  have hc : c j = (f.natDegree : 𝒪[K]) := by
    have hsub : f.natDegree - 1 + 1 = f.natDegree := by omega
    simp only [c, j, hsub, hmonic.coeff_natDegree, one_mul]
    norm_cast
    exact congrArg (fun n : ℕ => (n : 𝒪[K])) hsub
  have he : ramificationIndex K L = f.natDegree :=
    ramificationIndex_eq_natDegree_of_eisenstein_adjoin_eq_top f hf ξ hroot hgen
  convert (iInf_le (fun i : Fin f.natDegree =>
      ramificationIndex K L • addVal 𝒪[K] (c i) + (i : ℕ)) j) using 1;
    simp [j, hc, he, add_comm]

/-- For an extension whose integer ring is generated by an Eisenstein root, the different
exponent is at most `e - 1 + v_L(e)`, provided `e` is nonzero in the extension field. -/
theorem differentExponent_le_of_eisenstein (f : Polynomial 𝒪[K])
    (hf : f.IsEisensteinAt 𝓂[K]) (hmonic : f.Monic) (ξ : 𝒪[L])
    (hroot : (f.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ)
    (hgen : Algebra.adjoin 𝒪[K] {ξ} = ⊤)
    (he0 : (ramificationIndex K L : L) ≠ 0) :
    differentExponent K L ≤ ramificationIndex K L - 1 +
      natCastValuation L (ramificationIndex K L) he0 := by
  have h := differentExponent_le_addVal_of_eisenstein f hf hmonic ξ hroot hgen
  have he : ramificationIndex K L = f.natDegree :=
    ramificationIndex_eq_natDegree_of_eisenstein_adjoin_eq_top f hf ξ hroot hgen
  rw [← he] at h
  have hv : ramificationIndex K L •
      addVal 𝒪[K] (ramificationIndex K L : 𝒪[K]) =
        (natCastValuation L (ramificationIndex K L) he0 : ℕ∞) := by
    rw [← addVal_algebraMap (K := K) (L := L), map_natCast,
      addVal_natCast L (ramificationIndex K L) he0]
  rw [hv] at h
  exact_mod_cast h

end TauCeti

end
