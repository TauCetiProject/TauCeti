/-!
# Ore's conditions on the wild exponent of a totally ramified extension

Let `K` be a nonarchimedean local field and let `σ_K(n) = totallyRamifiedOfDegree K n` be the set
of totally ramified degree-`n` subextensions of `SeparableClosure K`. For `L ∈ σ_K(n)` with
discriminant exponent `d(L)`, the wild exponent is `c(L) = d(L) - n + 1`. Ore's theorem determines
precisely which natural numbers `j` arise as `c(L)` for some `L ∈ σ_K(n)`.

Write `j = a * n + b` with `a = j / n` and `b = j % n`, and write `v_K(m)` for the additive
valuation `IsDiscreteValuationRing.addVal 𝒪[K] (m : 𝒪[K]) ∈ ℕ∞`, which takes the value `⊤` when
`(m : K) = 0`. A pair `(n, j)` is *Ore-admissible* (`TauCeti.IsOreAdmissible K n j`) when `0 < n`
and either `b = 0` with `a = v_K(n)`, or `0 < b` with `v_K(b) ≤ a` and `a + 1 ≤ v_K(n)`.

Every `L ∈ σ_K(n)` is generated by a root of an Eisenstein polynomial `f` of degree `n`, and
`c(L) + n` is the minimum over `1 ≤ h ≤ n` of `n • v_K(f_h * h) + h`. Comparing remainders modulo
`n` shows that this minimum equals `(a + 1) * n + b` if and only if `IsOreAdmissible K n j` holds,
`v_K(f_h) ≥ oreCoefficientDepth K n j h` for `1 ≤ h < n`, and equality holds at `h = b` when
`0 < b`. Conversely, `X ^ n + ϖ` (for `b = 0`) or `X ^ n + ϖ ^ ν_b * X ^ b + ϖ` (for `0 < b`) is
separable over `K` and realizes wild exponent `j` in any characteristic.

## Main definitions

* `TauCeti.IsOreAdmissible K n j`: Ore's admissibility predicate for degree `n` and wild
  exponent `j`.
* `TauCeti.oreCoefficientDepth K n j h`: the valuation lower bound
  `max(1, ⌊j / n⌋ + 1 + [h < j % n] - v_K(h))` imposed on the degree-`h` Eisenstein coefficient.

## Main results

* `TauCeti.isOreAdmissible_one_iff`, `TauCeti.isOreAdmissible_iff_eq_zero_of_not_dvd`,
  `TauCeti.isOreAdmissible_iff_of_natCast_eq_zero`, `TauCeti.isOreAdmissible_padic_iff`:
  specializations to degree `1`, the tame case, equal characteristic `p ∣ n`, and `ℚ_[p]`.
* `TauCeti.wildExponent_adjoin_eq_iff_of_eisenstein`: valuation criterion on Eisenstein
  coefficients for a root to generate an extension of wild exponent `j`.
* `TauCeti.ore_realizability`: `j` is the wild exponent of some `E ∈ σ_K(n)` if and only if
  `IsOreAdmissible K n j`.

## References

* Ø. Ore, *Newtonsche Polygone in der Theorie der algebraischen Körper*, Math. Ann. **99** (1928),
  84–117.
* M. Krasner, *Nombre des extensions d'un degré donné d'un corps p-adique*, Colloques
  Internationaux du CNRS **143**, Paris, 1966, 143–169.
* J.-P. Serre, *Local Fields*, GTM 67, Springer, 1979, Chapter III, §6, Proposition 13.
* S. Pauli and X.-F. Roblot, *On the computation of all extensions of a p-adic field of a given
  degree*, Math. Comp. **70** (2001), 1641–1659, Proposition 3.1.
-/

public section
noncomputable section

open ValuativeRel Polynomial IsDiscreteValuationRing
open scoped IntermediateField

namespace TauCeti

open TauCeti.Polynomial (monicOfCoeff monic_monicOfCoeff natDegree_monicOfCoeff coeff_monicOfCoeff
  map_monicOfCoeff)

section DiscreteValuationRing

variable {K : Type*} [Field K] [ValuativeRel K] [IsDiscreteValuationRing 𝒪[K]]

variable (K) in
/-- **Ore's admissibility conditions** on a degree `n` and wild exponent `j = a * n + b`
(`a = j / n`, `b = j % n`): `0 < n`, and either `b = 0` with `a = v_K(n)`, or `0 < b` with
`v_K(b) ≤ a` and `a + 1 ≤ v_K(n)`, where `v_K(m) = addVal 𝒪[K] (m : 𝒪[K]) ∈ ℕ∞` takes the value `⊤`
when `(m : K) = 0`. -/
def IsOreAdmissible (n j : ℕ) : Prop :=
  0 < n ∧
    ((j % n = 0 ∧ ((j / n : ℕ) : ℕ∞) = addVal 𝒪[K] (n : 𝒪[K])) ∨
      (0 < j % n ∧ addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) ≤ (j / n : ℕ) ∧
        ((j / n : ℕ) : ℕ∞) + 1 ≤ addVal 𝒪[K] (n : 𝒪[K])))

namespace IsOreAdmissible

/-- An Ore-admissible pair has positive degree. -/
theorem pos {n j : ℕ} (h : IsOreAdmissible K n j) : 0 < n :=
  h.1

/-- An Ore-admissible pair satisfies `⌊j / n⌋ ≤ v_K(n)` in `ℕ∞`. -/
theorem div_le_addVal {n j : ℕ} (h : IsOreAdmissible K n j) :
    ((j / n : ℕ) : ℕ∞) ≤ addVal 𝒪[K] (n : 𝒪[K]) :=
  h.2.elim (fun ⟨_, heq⟩ ↦ heq.le) fun ⟨_, _, hle⟩ ↦ le_self_add.trans hle

end IsOreAdmissible

/-- Degree zero has no Ore-admissible wild exponents. -/
@[simp]
theorem not_isOreAdmissible_zero_left (j : ℕ) : ¬ IsOreAdmissible K 0 j :=
  fun h ↦ Nat.lt_irrefl 0 h.pos

/-- When `n ∣ j`, Ore admissibility reduces to `0 < n` and `j / n = v_K(n)`. -/
theorem isOreAdmissible_of_mod_eq_zero {n j : ℕ} (hmod : j % n = 0) :
    IsOreAdmissible K n j ↔ 0 < n ∧ ((j / n : ℕ) : ℕ∞) = addVal 𝒪[K] (n : 𝒪[K]) := by
  simp [IsOreAdmissible, hmod]

/-- When `n ∤ j`, Ore admissibility reduces to `0 < n`, `v_K(j % n) ≤ j / n`, and
`j / n + 1 ≤ v_K(n)`. -/
theorem isOreAdmissible_of_mod_pos {n j : ℕ} (hmod : 0 < j % n) :
    IsOreAdmissible K n j ↔
      0 < n ∧ addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) ≤ (j / n : ℕ) ∧
        ((j / n : ℕ) : ℕ∞) + 1 ≤ addVal 𝒪[K] (n : 𝒪[K]) := by
  simp [IsOreAdmissible, hmod, hmod.ne']

/-- In degree `1`, only `j = 0` is Ore-admissible, corresponding to the base field `K`. -/
@[simp]
theorem isOreAdmissible_one_iff {j : ℕ} : IsOreAdmissible K 1 j ↔ j = 0 := by
  rcases j with _ | j <;> simp [IsOreAdmissible]

/-- Wild exponent `0` is Ore-admissible for degree `n` exactly when `0 < n` and `n` is a unit of
`𝒪[K]`. -/
theorem isOreAdmissible_zero_right_iff {n : ℕ} :
    IsOreAdmissible K n 0 ↔ 0 < n ∧ IsUnit (n : 𝒪[K]) := by
  simp [IsOreAdmissible, eq_comm (a := (0 : ℕ∞)), addVal_eq_zero_iff]

/-- When `n` is a unit of `𝒪[K]` and `0 < n`, the only Ore-admissible wild exponent is `0`. -/
theorem isOreAdmissible_iff_eq_zero_of_isUnit {n j : ℕ} (hn : 0 < n) (hu : IsUnit (n : 𝒪[K])) :
    IsOreAdmissible K n j ↔ j = 0 := by
  rw [IsOreAdmissible, addVal_eq_zero_iff.mpr hu]
  refine ⟨fun ⟨_, h⟩ ↦ ?_, ?_⟩
  · rcases h with ⟨hmod, hdiv⟩ | ⟨-, -, hle⟩
    · have hdiv0 : j / n = 0 := by exact_mod_cast hdiv
      have := Nat.div_add_mod j n
      rw [hdiv0, hmod, Nat.mul_zero] at this
      omega
    · simp at hle
  · rintro rfl; simp [hn]

variable (K) in
/-- The valuation lower bound `ν_h = max(1, ⌊j / n⌋ + 1 + [h < j % n] - v_K(h))` imposed on the
degree-`h` Eisenstein coefficient by wild exponent `j` in degree `n`. -/
def oreCoefficientDepth (n j h : ℕ) : ℕ :=
  max 1 ((((j / n + 1 + if h < j % n then 1 else 0 : ℕ) : ℕ∞) - addVal 𝒪[K] (h : 𝒪[K])).toNat)

variable (K) in
/-- Unfolding `TauCeti.oreCoefficientDepth`. -/
theorem oreCoefficientDepth_def (n j h : ℕ) :
    oreCoefficientDepth K n j h =
      max 1 ((((j / n + 1 + if h < j % n then 1 else 0 : ℕ) : ℕ∞) -
        addVal 𝒪[K] (h : 𝒪[K])).toNat) := by
  rw [oreCoefficientDepth]

variable (K) in
/-- Every Ore coefficient depth is at least `1`, so coefficients satisfying the depth bound lie in
the maximal ideal `𝓂[K]`. -/
theorem one_le_oreCoefficientDepth (n j h : ℕ) : 1 ≤ oreCoefficientDepth K n j h :=
  le_max_left _ _

variable (K) in
/-- Reading `oreCoefficientDepth` in `ℕ∞`: the truncation to `ℕ` is lossless because the numerator
is finite. -/
theorem natCast_oreCoefficientDepth (n j h : ℕ) :
    ((oreCoefficientDepth K n j h : ℕ) : ℕ∞) =
      max 1 (((j / n + 1 + if h < j % n then 1 else 0 : ℕ) : ℕ∞) - addVal 𝒪[K] (h : 𝒪[K])) := by
  rw [oreCoefficientDepth, Nat.mono_cast.map_max, Nat.cast_one, ENat.natCast_toNat]
  exact ne_of_lt (tsub_le_self.trans_lt (ENat.natCast_lt_top _))

variable (K) in
/-- When `(h : K) = 0`, the `h`-th derivative term vanishes identically and the Ore coefficient
depth is `1`. -/
theorem oreCoefficientDepth_of_natCast_eq_zero (n j : ℕ) {h : ℕ} (hh : (h : K) = 0) :
    oreCoefficientDepth K n j h = 1 := by
  have hh𝒪 : (h : 𝒪[K]) = 0 := Subtype.ext (by simpa using hh)
  simp [oreCoefficientDepth, hh𝒪]

/-- Auxiliary arithmetic comparison at a lower Eisenstein index `1 ≤ h < n`: when `1 ≤ m`,
`(j / n + 1) * n + j % n ≤ n • (m + w) + h` in `ℕ∞` holds if and only if
`oreCoefficientDepth K n j h ≤ m` (where `w = addVal 𝒪[K] (h : 𝒪[K])`). -/
private theorem le_nsmul_add_iff_oreCoefficientDepth_le {n j h : ℕ} (hn : 0 < n)
    (hhn : h < n) {m : ℕ∞} (hm1 : 1 ≤ m) :
    (((j / n + 1) * n + j % n : ℕ) : ℕ∞) ≤ n • (m + addVal 𝒪[K] (h : 𝒪[K])) + (h : ℕ∞) ↔
      ((oreCoefficientDepth K n j h : ℕ) : ℕ∞) ≤ m := by
  have hb : j % n < n := Nat.mod_lt j hn
  rw [natCast_oreCoefficientDepth, max_le_iff]
  rcases eq_or_ne m ⊤ with rfl | hmt
  · cases n with | zero => omega | succ _ => simp
  rcases eq_or_ne (addVal 𝒪[K] (h : 𝒪[K])) ⊤ with hwt | hwt
  · rw [hwt]
    cases n with | zero => omega | succ _ => simp [hm1]
  lift m to ℕ using hmt
  lift addVal 𝒪[K] (h : 𝒪[K]) to ℕ using hwt with w hw'
  rw [← ENat.natCast_sub, nsmul_eq_mul]
  norm_cast at hm1 ⊢
  simp only [hm1, true_and, Nat.mul_comm (j / n + 1) n]
  split_ifs with hhb <;> refine ⟨fun hle ↦ ?_, fun hle ↦ ?_⟩
  · by_contra hlt
    have := Nat.mul_le_mul_left n (by omega : m + w ≤ j / n + 1)
    omega
  · have := Nat.mul_le_mul_left n (by omega : j / n + 2 ≤ m + w)
    have : n * (j / n + 2) = n * (j / n + 1) + n := by ring
    omega
  · by_contra hlt
    have := Nat.mul_le_mul_left n (by omega : m + w + 1 ≤ j / n + 1)
    have : n * (m + w + 1) = n * (m + w) + n := by ring
    omega
  · have := Nat.mul_le_mul_left n (by omega : j / n + 1 ≤ m + w)
    omega

/-- Auxiliary arithmetic equality at a lower Eisenstein index `1 ≤ h < n`: when `1 ≤ m`,
`n • (m + w) + h = (j / n + 1) * n + j % n` holds if and only if `h = j % n`, `w ≤ j / n`, and
`m = oreCoefficientDepth K n j h` (where `w = addVal 𝒪[K] (h : 𝒪[K])`). -/
private theorem nsmul_add_eq_iff {n j h : ℕ} (hn : 0 < n) (hhn : h < n)
    {m : ℕ∞} (hm1 : 1 ≤ m) :
    n • (m + addVal 𝒪[K] (h : 𝒪[K])) + (h : ℕ∞) = (((j / n + 1) * n + j % n : ℕ) : ℕ∞) ↔
      h = j % n ∧ addVal 𝒪[K] (h : 𝒪[K]) ≤ (j / n : ℕ) ∧
        m = ((oreCoefficientDepth K n j h : ℕ) : ℕ∞) := by
  have hb : j % n < n := Nat.mod_lt j hn
  constructor
  · intro heq
    have hmt : m ≠ ⊤ := by
      rintro rfl
      cases n with
      | zero => omega
      | succ _ => exact ENat.natCast_ne_top _ (by rw [← heq]; simp)
    have hwt : addVal 𝒪[K] (h : 𝒪[K]) ≠ ⊤ := fun htop ↦ by
      rw [htop] at heq
      cases n with
      | zero => omega
      | succ _ => exact ENat.natCast_ne_top _ (by rw [← heq]; simp)
    lift m to ℕ using hmt
    lift addVal 𝒪[K] (h : 𝒪[K]) to ℕ using hwt with w hw'
    rw [nsmul_eq_mul] at heq
    norm_cast at hm1 heq
    obtain rfl : h = j % n := by
      have h1 : (n * (m + w) + h) % n = h := by rw [Nat.mul_add_mod, Nat.mod_eq_of_lt hhn]
      have h2 : ((j / n + 1) * n + j % n) % n = j % n := by
        rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hb]
      rw [← h1, heq, h2]
    rw [Nat.mul_comm (j / n + 1) n] at heq
    have hsum : m + w = j / n + 1 := Nat.eq_of_mul_eq_mul_left hn (Nat.add_right_cancel heq)
    refine ⟨rfl, by exact_mod_cast (by omega : w ≤ j / n), ?_⟩
    rw [natCast_oreCoefficientDepth, ← hw', ite_eq_right (lt_irrefl _), ← ENat.natCast_sub,
      max_eq_right (by exact_mod_cast (by omega : 1 ≤ j / n + 1 + 0 - w))]
    norm_cast
    omega
  · rintro ⟨rfl, hw, rfl⟩
    rw [natCast_oreCoefficientDepth, ite_eq_right (lt_irrefl _)]
    have hwt : addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) ≠ ⊤ :=
      ne_of_lt (hw.trans_lt (ENat.natCast_lt_top _))
    lift addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) to ℕ using hwt with w hw'
    have hwle : w ≤ j / n := by exact_mod_cast hw
    rw [← ENat.natCast_sub, max_eq_right (by exact_mod_cast (by omega : 1 ≤ j / n + 1 + 0 - w)),
      nsmul_eq_mul]
    norm_cast
    have : j / n + 1 + 0 - w + w = j / n + 1 := by omega
    rw [this, Nat.mul_comm]

/-- Top-index simplification for the Eisenstein derivative valuation term at `i = n - 1`. -/
private theorem addVal_Eisenstein_top {n : ℕ} (hn : 0 < n) {f : 𝒪[K][X]}
    (hf : f.IsEisensteinAt 𝓂[K]) (hdeg : f.natDegree = n) :
    n • addVal 𝒪[K] (f.coeff ((n - 1) + 1) * (((n - 1 : ℕ) : 𝒪[K]) + 1)) +
      (((n - 1) + 1 : ℕ) : ℕ∞) = n • (addVal 𝒪[K] (n : 𝒪[K]) + 1) := by
  have hsub : n - 1 + 1 = n := by omega
  have hcast : (((n - 1 : ℕ) : 𝒪[K]) + 1) = (n : 𝒪[K]) := by rw [← Nat.cast_add_one, hsub]
  have hlc : addVal 𝒪[K] (f.coeff n) = 0 := by
    rw [← hdeg, coeff_natDegree]
    exact addVal_eq_zero_iff.mpr hf.isUnit_leadingCoeff
  rw [hsub, hcast, addVal_mul, hlc, zero_add, nsmul_eq_mul, nsmul_eq_mul, mul_add, mul_one]

/-- Top-index equality condition for the Eisenstein derivative valuation term at `i = n - 1`. -/
private theorem addVal_Eisenstein_top_eq_iff {n j : ℕ} (hn : 0 < n) {f : 𝒪[K][X]}
    (hf : f.IsEisensteinAt 𝓂[K]) (hdeg : f.natDegree = n) :
    n • addVal 𝒪[K] (f.coeff ((n - 1) + 1) * (((n - 1 : ℕ) : 𝒪[K]) + 1)) +
        (((n - 1) + 1 : ℕ) : ℕ∞) = (((j / n + 1) * n + j % n : ℕ) : ℕ∞) ↔
      j % n = 0 ∧ ((j / n : ℕ) : ℕ∞) = addVal 𝒪[K] (n : 𝒪[K]) := by
  have hb_lt : j % n < n := Nat.mod_lt j hn
  rw [addVal_Eisenstein_top hn hf hdeg]
  rcases eq_or_ne (addVal 𝒪[K] (n : 𝒪[K])) ⊤ with hv | hv
  · rw [hv]
    cases n with
    | zero => omega
    | succ _ =>
      exact ⟨fun h ↦ absurd (by rw [← h]; simp) (ENat.natCast_ne_top _),
        fun ⟨_, h⟩ ↦ absurd h (ENat.natCast_ne_top _)⟩
  · lift addVal 𝒪[K] (n : 𝒪[K]) to ℕ using hv with v hv'
    rw [nsmul_eq_mul]
    norm_cast
    refine ⟨fun heq ↦ ?_, fun ⟨h0, heq⟩ ↦ by rw [heq, h0, add_zero, Nat.mul_comm]⟩
    have h1 : (n * (v + 1)) % n = 0 := Nat.mul_mod_right n (v + 1)
    have h2 : ((j / n + 1) * n + j % n) % n = j % n := by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hb_lt]
    have hj0 : j % n = 0 := by rw [← h2, ← heq, h1]
    rw [hj0, add_zero, Nat.mul_comm (j / n + 1) n] at heq
    have := Nat.eq_of_mul_eq_mul_left hn heq
    exact ⟨hj0, by omega⟩

/-- Top-index inequality condition for the Eisenstein derivative valuation term at `i = n - 1`. -/
private theorem le_addVal_Eisenstein_top_iff {n j : ℕ} (hn : 0 < n) {f : 𝒪[K][X]}
    (hf : f.IsEisensteinAt 𝓂[K]) (hdeg : f.natDegree = n) :
    (((j / n + 1) * n + j % n : ℕ) : ℕ∞) ≤
        n • addVal 𝒪[K] (f.coeff ((n - 1) + 1) * (((n - 1 : ℕ) : 𝒪[K]) + 1)) +
          (((n - 1) + 1 : ℕ) : ℕ∞) ↔
      (j % n = 0 ∧ ((j / n : ℕ) : ℕ∞) ≤ addVal 𝒪[K] (n : 𝒪[K])) ∨
        (0 < j % n ∧ ((j / n : ℕ) : ℕ∞) + 1 ≤ addVal 𝒪[K] (n : 𝒪[K])) := by
  have hb_lt : j % n < n := Nat.mod_lt j hn
  rw [addVal_Eisenstein_top hn hf hdeg]
  rcases eq_or_ne (addVal 𝒪[K] (n : 𝒪[K])) ⊤ with hv | hv
  · rw [hv]
    cases n with | zero => omega | succ _ => simp [Nat.eq_zero_or_pos (j % _)]
  · lift addVal 𝒪[K] (n : 𝒪[K]) to ℕ using hv with v hv'
    rw [nsmul_eq_mul]
    norm_cast
    rw [Nat.mul_comm (j / n + 1) n]
    rcases Nat.eq_zero_or_pos (j % n) with h0 | hpos
    · simp only [h0, add_zero, true_and, lt_self_iff_false, false_and, or_false,
        Nat.mul_le_mul_left_iff hn]
      omega
    · simp only [hpos.ne', false_and, hpos, true_and, false_or]
      refine ⟨fun hle ↦ ?_, fun hle ↦ ?_⟩
      · by_contra hgt
        have := Nat.mul_le_mul_left n (by omega : v + 1 ≤ j / n + 1)
        omega
      · have := Nat.mul_le_mul_left n (by omega : j / n + 2 ≤ v + 1)
        have : n * (j / n + 2) = n * (j / n + 1) + n := by ring
        omega

private theorem ciInf_eq_iff_of_nonempty {ι : Type*} [Finite ι] [Nonempty ι]
    (T : ι → ℕ∞) (c : ℕ∞) : (⨅ i, T i) = c ↔ (∀ i, c ≤ T i) ∧ ∃ i, T i = c := by
  cases nonempty_fintype ι
  refine ⟨fun hc ↦ ?_, fun ⟨hle, i, hi⟩ ↦
    le_antisymm (ciInf_le_of_le (OrderBot.bddBelow _) i hi.le) (le_ciInf hle)⟩
  obtain ⟨i, -, hi⟩ := Finset.exists_mem_eq_inf' Finset.univ_nonempty T
  rw [Finset.inf'_univ_eq_ciInf] at hi
  exact ⟨fun k ↦ hc ▸ ciInf_le (OrderBot.bddBelow _) k, i, hi.symm.trans hc⟩

private theorem addVal_Eisenstein_lower {n : ℕ} {f : 𝒪[K][X]}
    (hf : f.IsEisensteinAt 𝓂[K]) {i : Fin n} (hi : (i : ℕ) + 1 < f.natDegree) :
    1 ≤ addVal 𝒪[K] (f.coeff ((i : ℕ) + 1)) ∧
      n • addVal 𝒪[K] (f.coeff (i + 1) * (i + 1)) + ((i : ℕ) + 1 : ℕ∞) =
        n • (addVal 𝒪[K] (f.coeff ((i : ℕ) + 1)) +
          addVal 𝒪[K] (((i : ℕ) + 1 : ℕ) : 𝒪[K])) + (((i : ℕ) + 1 : ℕ) : ℕ∞) := by
  refine ⟨(TauCeti.IsDiscreteValuationRing.mem_maximalIdeal_pow_iff_le_addVal
    (n := 1)).mp (by simpa using hf.mem hi), ?_⟩
  rw [addVal_mul]
  norm_cast

/-- Core algebraic equivalence: for an Eisenstein polynomial `f : 𝒪[K][X]` of positive degree `n`,
the shifted derivative infimum `⨅ i : Fin n, (n • v_K(f_{i+1} * (i+1)) + (i+1))` equals `j + n`
if and only if `IsOreAdmissible K n j` holds and the coefficients of `f` satisfy the Ore depth
bounds (with equality at `j % n` when `0 < j % n`). -/
theorem iInf_addVal_derivative_add_one_eq_iff {n j : ℕ} (hn : 0 < n) {f : 𝒪[K][X]}
    (hf : f.IsEisensteinAt 𝓂[K]) (hdeg : f.natDegree = n) :
    (⨅ i : Fin n, n • addVal 𝒪[K] (f.coeff (i + 1) * (i + 1)) + ((i : ℕ) + 1 : ℕ∞)) =
        ((j + n : ℕ) : ℕ∞) ↔
      IsOreAdmissible K n j ∧
        (∀ h, 1 ≤ h → h < n → (oreCoefficientDepth K n j h : ℕ∞) ≤ addVal 𝒪[K] (f.coeff h)) ∧
        (0 < j % n → addVal 𝒪[K] (f.coeff (j % n)) = oreCoefficientDepth K n j (j % n)) := by
  have : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
  have hlt_b := Nat.mod_lt j hn
  have hj_decomp : j + n = (j / n + 1) * n + j % n := by
    have := Nat.div_add_mod j n; rw [Nat.mul_comm (j / n + 1) n, Nat.mul_add_one]; omega
  let T (i : Fin n) : ℕ∞ := n • addVal 𝒪[K] (f.coeff (i + 1) * (i + 1)) + ((i : ℕ) + 1 : ℕ∞)
  let iTop : Fin n := ⟨n - 1, by omega⟩
  have hTop_eq := addVal_Eisenstein_top_eq_iff (j := j) hn hf hdeg
  have hTop_le := le_addVal_Eisenstein_top_iff (j := j) hn hf hdeg
  rw [hj_decomp]
  refine (ciInf_eq_iff_of_nonempty T _).trans
    ⟨fun ⟨hle, i, hi⟩ ↦ ?_, fun ⟨hadm, hcoeff, hcrit⟩ ↦ ?_⟩
  · have hcoeff : ∀ h, 1 ≤ h → h < n →
        (oreCoefficientDepth K n j h : ℕ∞) ≤ addVal 𝒪[K] (f.coeff h) := fun h hh1 hhn ↦ by
      let k : Fin n := ⟨h - 1, by omega⟩
      have hk : (k : ℕ) + 1 = h := by dsimp [k]; omega
      obtain ⟨hm1, hTk⟩ := addVal_Eisenstein_lower (n := n) (i := k) hf (by omega)
      have hkle := hle k
      dsimp only [T] at hkle; rw [hTk, hk] at hkle
      exact (le_nsmul_add_iff_oreCoefficientDepth_le (j := j) hn hhn (hk ▸ hm1)).mp hkle
    rcases eq_or_lt_of_le (Nat.succ_le_of_lt i.isLt) with hiTop | hiLow
    · rw [(Fin.ext (by dsimp [iTop]; omega) : i = iTop)] at hi
      have hi' := hTop_eq.mp (by simpa only [T, iTop, Nat.cast_add, Nat.cast_one] using hi)
      exact ⟨⟨hn, .inl hi'⟩, hcoeff, fun hb ↦ absurd hi'.1 hb.ne'⟩
    · obtain ⟨hm1, hTi⟩ := addVal_Eisenstein_lower (n := n) (i := i) hf (hdeg ▸ hiLow)
      dsimp only [T] at hi
      obtain ⟨hmod, hvb, heq_m⟩ := (nsmul_add_eq_iff (j := j) hn hiLow hm1).mp (hTi ▸ hi)
      have hb_pos : 0 < j % n := by omega
      rcases hTop_le.mp (by simpa only [T, iTop, Nat.cast_add, Nat.cast_one] using hle iTop) with
        ⟨h0, -⟩ | ⟨-, hvn⟩
      · exact absurd h0 hb_pos.ne'
      · exact ⟨⟨hn, .inr ⟨hb_pos, hmod ▸ hvb, hvn⟩⟩, hcoeff, fun _ ↦ hmod ▸ heq_m⟩
  · refine ⟨fun i ↦ ?_, ?_⟩
    · rcases eq_or_lt_of_le (Nat.succ_le_of_lt i.isLt) with hiTop | hiLow
      · rw [(Fin.ext (by dsimp [iTop]; omega) : i = iTop)]
        simpa only [T, iTop, Nat.cast_add, Nat.cast_one] using hTop_le.mpr
          (hadm.2.imp (fun ⟨h0, heq⟩ ↦ ⟨h0, heq.le⟩) fun ⟨hp, _, hvn⟩ ↦ ⟨hp, hvn⟩)
      · obtain ⟨hm1, hTi⟩ := addVal_Eisenstein_lower (n := n) (i := i) hf (hdeg ▸ hiLow)
        dsimp only [T]
        exact hTi.symm ▸ (le_nsmul_add_iff_oreCoefficientDepth_le (j := j) hn hiLow hm1).mpr
          (hcoeff ((i : ℕ) + 1) (Nat.succ_pos _) hiLow)
    · rcases hadm.2 with ⟨h0, heq⟩ | ⟨hb_pos, hvb, -⟩
      · exact ⟨iTop,
          by simpa only [T, iTop, Nat.cast_add, Nat.cast_one] using hTop_eq.mpr ⟨h0, heq⟩⟩
      · let ib : Fin n := ⟨j % n - 1, by omega⟩
        have hib : (ib : ℕ) + 1 = j % n := by dsimp [ib]; omega
        obtain ⟨hm1, hTib⟩ := addVal_Eisenstein_lower (n := n) (i := ib) hf (by omega)
        refine ⟨ib, ?_⟩
        dsimp only [T]
        rw [hTib, hib]
        exact (nsmul_add_eq_iff (j := j) hn hlt_b (hib ▸ hm1)).mpr ⟨rfl, hvb, hcrit hb_pos⟩

/-- Any Eisenstein polynomial `f : 𝒪[K][X]` of degree `n` witnessing an Ore-admissible wild
exponent `j` has nonzero derivative over `K`. -/
theorem IsOreAdmissible.derivative_map_ne_zero_of_isEisensteinAt {n j : ℕ}
    (hadm : IsOreAdmissible K n j) {f : 𝒪[K][X]} (hf : f.IsEisensteinAt 𝓂[K])
    (hdeg : f.natDegree = n)
    (hcrit : 0 < j % n → addVal 𝒪[K] (f.coeff (j % n)) = oreCoefficientDepth K n j (j % n)) :
    (f.map (algebraMap 𝒪[K] K)).derivative ≠ 0 := by
  have hn : 0 < n := hadm.pos
  have hexists : ∃ k : ℕ, 0 < k ∧ f.coeff k ≠ 0 ∧ (k : 𝒪[K]) ≠ 0 := by
    rcases hadm.2 with ⟨_, heq⟩ | ⟨hb_pos, hvb, -⟩
    · refine ⟨n, hn, hdeg ▸ hf.isUnit_leadingCoeff.ne_zero, fun h0 ↦ ?_⟩
      exact ENat.natCast_ne_top _ (by rwa [h0, addVal_zero] at heq)
    · refine ⟨j % n, hb_pos, fun h0 ↦ ?_, fun h0 ↦ ?_⟩
      · have hc := hcrit hb_pos
        rw [h0, addVal_zero] at hc
        exact ENat.natCast_ne_top _ hc.symm
      · exact ENat.natCast_ne_top _ (top_le_iff.mp (by rwa [h0, addVal_zero] at hvb))
  obtain ⟨k, hk, hfk, hk0⟩ := hexists
  intro hzero
  rw [derivative_map] at hzero
  have hm := congrArg (fun p : K[X] ↦ p.coeff (k - 1)) hzero
  simp only [coeff_map, coeff_zero] at hm
  have hm0 : f.derivative.coeff (k - 1) = 0 :=
    FaithfulSMul.algebraMap_injective 𝒪[K] K (hm.trans (map_zero _).symm)
  have hsub : k - 1 + 1 = k := by omega
  have hcast : (((k - 1 : ℕ) : 𝒪[K]) + 1) = (k : 𝒪[K]) := by rw [← Nat.cast_add_one, hsub]
  rw [coeff_derivative, hsub, hcast] at hm0
  exact mul_ne_zero hfk hk0 hm0

/-- Over any field `K` whose valuation ring `𝒪[K]` is a discrete valuation ring, every
Ore-admissible pair `(n, j)` is realized on the coefficient level by an explicit monic Eisenstein
polynomial `monicOfCoeff c` (`X ^ n + ϖ` when `j % n = 0`, and `X ^ n + ϖ ^ ν_b * X ^ b + ϖ` when
`0 < j % n`). -/
theorem IsOreAdmissible.exists_monic_isEisensteinAt {n j : ℕ} (hadm : IsOreAdmissible K n j) :
    ∃ c : Fin n → 𝒪[K],
      (monicOfCoeff c).IsEisensteinAt 𝓂[K] ∧
      (∀ h, 1 ≤ h → h < n →
        (oreCoefficientDepth K n j h : ℕ∞) ≤ addVal 𝒪[K] ((monicOfCoeff c).coeff h)) ∧
      (0 < j % n →
        addVal 𝒪[K] ((monicOfCoeff c).coeff (j % n)) = oreCoefficientDepth K n j (j % n)) := by
  have hn : 0 < n := hadm.pos
  obtain ⟨ϖ, hϖ⟩ := exists_irreducible 𝒪[K]
  have hϖ_mem : ϖ ∈ 𝓂[K] := hϖ.not_isUnit
  have hϖ_notMem : ϖ ∉ 𝓂[K] ^ 2 := by
    rw [TauCeti.IsDiscreteValuationRing.mem_maximalIdeal_pow_iff_le_addVal, addVal_uniformizer hϖ]
    decide
  let ν := oreCoefficientDepth K n j (j % n)
  let c : Fin n → 𝒪[K] := fun i ↦
    if (i : ℕ) = 0 then ϖ else if (i : ℕ) = j % n then ϖ ^ ν else 0
  refine ⟨c, ?_, fun h hh1 hhn ↦ ?_, fun hb_pos ↦ ?_⟩
  · refine (monic_monicOfCoeff c).isEisensteinAt_of_mem_of_notMem
      (IsLocalRing.maximalIdeal.isMaximal 𝒪[K]).ne_top (fun {k} hk ↦ ?_) ?_
    · rw [natDegree_monicOfCoeff] at hk
      rw [coeff_monicOfCoeff c ⟨k, hk⟩]
      dsimp [c]
      split_ifs
      · exact hϖ_mem
      · exact Ideal.pow_mem_of_mem _ hϖ_mem ν (one_le_oreCoefficientDepth K n j (j % n))
      · exact 𝓂[K].zero_mem
    · rw [coeff_monicOfCoeff c ⟨0, hn⟩]
      simpa [c] using hϖ_notMem
  · rw [coeff_monicOfCoeff c ⟨h, hhn⟩]
    dsimp [c]
    rw [ite_eq_right (by omega : h ≠ 0)]
    split_ifs with hhb
    · subst hhb; rw [hϖ.addVal_pow]
    · simp
  · rw [coeff_monicOfCoeff c ⟨j % n, Nat.mod_lt j hn⟩]
    simp [c, hb_pos.ne', hϖ.addVal_pow, ν]

end DiscreteValuationRing

section LocalField

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

/-- **The tame case of Ore's conditions**: when `0 < n` and the residue characteristic of `K` does
not divide `n`, the unique Ore-admissible wild exponent is `0`. -/
theorem isOreAdmissible_iff_eq_zero_of_not_dvd {n j : ℕ} (hn : 0 < n)
    (hp : ¬ ringChar 𝓀[K] ∣ n) : IsOreAdmissible K n j ↔ j = 0 :=
  isOreAdmissible_iff_eq_zero_of_isUnit hn (IsLocalRing.isUnit_natCast_iff_not_dvd.mpr hp)

/-- **Upper bound on Ore-admissible wild exponents**: if `(n : K) ≠ 0`, every `j` satisfying
`IsOreAdmissible K n j` obeys `j ≤ n * natCastValuation K n hnK`. -/
theorem IsOreAdmissible.le_mul_natCastValuation {n j : ℕ} (h : IsOreAdmissible K n j)
    (hnK : (n : K) ≠ 0) : j ≤ n * natCastValuation K n hnK := by
  have hmod := Nat.div_add_mod j n
  have hlt := Nat.mod_lt j h.pos
  rcases h.2 with ⟨h0, heq⟩ | ⟨-, -, hle⟩
  · rw [TauCeti.IsDiscreteValuationRing.addVal_natCast K n hnK] at heq
    have hdiv : j / n = natCastValuation K n hnK := by exact_mod_cast heq
    rw [hdiv, h0, add_zero] at hmod
    exact hmod.symm.le
  · rw [TauCeti.IsDiscreteValuationRing.addVal_natCast K n hnK] at hle
    have hdiv : j / n + 1 ≤ natCastValuation K n hnK := by exact_mod_cast hle
    have hmul := Nat.mul_le_mul_left n hdiv
    rw [Nat.mul_add_one] at hmul
    omega

/-- **The equal-characteristic wild case of Ore's conditions**: when `(n : K) = 0`, `(n, j)` is
Ore-admissible if and only if `0 < n` and `(j % n : K) ≠ 0` (equivalently, `ringChar K ∤ j`). -/
theorem isOreAdmissible_iff_of_natCast_eq_zero {n j : ℕ} (hnK : (n : K) = 0) :
    IsOreAdmissible K n j ↔ 0 < n ∧ ((j % n : ℕ) : K) ≠ 0 := by
  have hn𝒪 : (n : 𝒪[K]) = 0 := Subtype.ext (by simpa using hnK)
  rw [IsOreAdmissible, hn𝒪, addVal_zero]
  refine and_congr_right fun hn ↦ ⟨?_, fun hbK ↦ ?_⟩
  · rintro (⟨-, htop⟩ | ⟨-, hvb, -⟩)
    · simp at htop
    · intro hb0
      have hb𝒪 : ((j % n : ℕ) : 𝒪[K]) = 0 := Subtype.ext (by simpa using hb0)
      exact ENat.natCast_ne_top _ (top_le_iff.mp (by rwa [hb𝒪, addVal_zero] at hvb))
  · have hchar : ringChar K ≠ 0 := fun h0 ↦
      hn.ne' (zero_dvd_iff.mp (h0 ▸ (ringChar.spec K n).mp hnK))
    refine .inr ⟨Nat.pos_of_ne_zero fun h ↦ hbK (by simp [h]), ?_, le_top⟩
    rw [TauCeti.IsDiscreteValuationRing.addVal_natCast K (j % n) hbK,
      natCastValuation_eq_zero_of_ringChar_ne_zero K hchar (j % n) hbK]
    simp

variable (K) in
/-- When `(h : K) ≠ 0`, `oreCoefficientDepth` is expressed in terms of `natCastValuation`. -/
theorem oreCoefficientDepth_of_natCast_ne_zero (n j : ℕ) {h : ℕ} (hh : (h : K) ≠ 0) :
    oreCoefficientDepth K n j h =
      max 1 (j / n + 1 + (if h < j % n then 1 else 0) - natCastValuation K h hh) := by
  rw [oreCoefficientDepth, TauCeti.IsDiscreteValuationRing.addVal_natCast K h hh,
    ← ENat.natCast_sub, ENat.toNat_natCast]

/-- **Ore's inequality over `ℚ_[p]`** (Pauli–Roblot, Proposition 3.1): a wild exponent `j` is
Ore-admissible for degree `n` over `ℚ_[p]` if and only if `0 < n` and
`min(v_p(j % n) * n, v_p(n) * n) ≤ j ≤ v_p(n) * n`, with `v_p(0)` read as `∞` so that `n ∣ j`
requires `j = v_p(n) * n`. -/
theorem isOreAdmissible_padic_iff (p : ℕ) [Fact p.Prime] {n j : ℕ} :
    IsOreAdmissible ℚ_[p] n j ↔
      0 < n ∧
        (if j % n = 0 then padicValNat p n * n
          else min (padicValNat p (j % n) * n) (padicValNat p n * n)) ≤ j ∧
          j ≤ padicValNat p n * n := by
  rcases n.eq_zero_or_pos with rfl | hn
  · simp
  have hn0 : (n : ℚ_[p]) ≠ 0 := Nat.cast_ne_zero.mpr hn.ne'
  have hvn : addVal 𝒪[ℚ_[p]] (n : 𝒪[ℚ_[p]]) = (padicValNat p n : ℕ∞) := by
    rw [TauCeti.IsDiscreteValuationRing.addVal_natCast ℚ_[p] n hn0,
      _root_.Padic.natCastValuation_eq_padicValNat]
  have hdiv := Nat.div_add_mod j n
  have hlt := Nat.mod_lt j hn
  rcases Nat.eq_zero_or_pos (j % n) with hmod | hmod
  · rw [isOreAdmissible_of_mod_eq_zero hmod, ite_eq_left hmod, hvn]
    simp only [hn, true_and, ENat.natCast_inj]
    rw [hmod, add_zero, Nat.mul_comm n (j / n)] at hdiv
    rw [← hdiv, ← le_antisymm_iff, Nat.mul_div_cancel _ hn, Nat.mul_left_inj hn.ne', eq_comm]
  · have hb0 : ((j % n : ℕ) : ℚ_[p]) ≠ 0 := Nat.cast_ne_zero.mpr hmod.ne'
    have hvb : addVal 𝒪[ℚ_[p]] ((j % n : ℕ) : 𝒪[ℚ_[p]]) = (padicValNat p (j % n) : ℕ∞) := by
      rw [TauCeti.IsDiscreteValuationRing.addVal_natCast ℚ_[p] (j % n) hb0,
        _root_.Padic.natCastValuation_eq_padicValNat]
    rw [isOreAdmissible_of_mod_pos hmod, ite_eq_right hmod.ne', hvn, hvb]
    simp only [hn, true_and]
    norm_cast
    rw [Nat.mul_comm n (j / n)] at hdiv
    refine ⟨fun ⟨h1, h2⟩ ↦ ?_, fun ⟨h1, h2⟩ ↦ ?_⟩
    · have hm1 := Nat.mul_le_mul_right n h1
      have hm2 := Nat.mul_le_mul_right n h2
      rw [Nat.add_one_mul] at hm2
      exact ⟨(min_le_left _ _).trans (by omega), by omega⟩
    · have hj_ne : j ≠ padicValNat p n * n := fun heq ↦ hmod.ne' (by rw [heq, Nat.mul_mod_left])
      have hdiv_lt : j / n + 1 ≤ padicValNat p n :=
        Nat.lt_of_mul_lt_mul_right (by omega : (j / n) * n < padicValNat p n * n)
      rcases min_le_iff.mp h1 with hmin | hmin
      · have hm_lt : padicValNat p (j % n) * n < (j / n + 1) * n := by rw [Nat.add_one_mul]; omega
        exact ⟨Nat.lt_succ_iff.mp (Nat.lt_of_mul_lt_mul_right hm_lt), hdiv_lt⟩
      · exact absurd (le_antisymm h2 hmin) hj_ne

/-- **The Eisenstein derivative criterion for wild exponents.** Let `x : SeparableClosure K` be a
root of an Eisenstein polynomial `f : 𝒪[K][X]` of degree `n`. Then `K⟮x⟯` has wild exponent `j` if
and only if `IsOreAdmissible K n j` holds, every lower coefficient `f.coeff h` (`1 ≤ h < n`) has
valuation at least `oreCoefficientDepth K n j h`, and when `0 < j % n` the coefficient
`f.coeff (j % n)` has valuation equal to `oreCoefficientDepth K n j (j % n)`. -/
theorem wildExponent_adjoin_eq_iff_of_eisenstein {n j : ℕ} {f : 𝒪[K][X]}
    (hf : f.IsEisensteinAt 𝓂[K]) (hdeg : f.natDegree = n) {x : SeparableClosure K}
    (hx : aeval x (f.map (algebraMap 𝒪[K] K)) = 0) :
    (K⟮x⟯).wildExponent = j ↔
      IsOreAdmissible K n j ∧
        (∀ h, 1 ≤ h → h < n → (oreCoefficientDepth K n j h : ℕ∞) ≤ addVal 𝒪[K] (f.coeff h)) ∧
        (0 < j % n → addVal 𝒪[K] (f.coeff (j % n)) = oreCoefficientDepth K n j (j % n)) := by
  have hmem := adjoin_mem_totallyRamifiedOfDegree_of_eisenstein hf hdeg hx
  have hn : 0 < n := Nat.pos_of_ne_zero fun h0 ↦ by simp [h0, totallyRamifiedOfDegree_zero] at hmem
  have : Nonempty (Fin f.natDegree) := ⟨⟨0, hdeg ▸ hn⟩⟩
  have hd := natCast_discriminantExponent_adjoin_eq_iInf_of_eisenstein hf hx
  have hrel := IntermediateField.wildExponent_add_eq_discriminantExponent_add_one hmem
  have hshift :
      (((K⟮x⟯).wildExponent + n : ℕ) : ℕ∞) =
        ⨅ i : Fin f.natDegree,
          f.natDegree • addVal 𝒪[K] (f.coeff (i + 1) * (i + 1)) + ((i : ℕ) + 1 : ℕ∞) := by
    rw [hrel, Nat.cast_add, Nat.cast_one, hd]
    obtain ⟨i₀, -, hi₀⟩ := Finset.exists_mem_eq_inf' Finset.univ_nonempty fun i : Fin f.natDegree ↦
      f.natDegree • addVal 𝒪[K] (f.coeff (i + 1) * (i + 1)) + (i : ℕ)
    rw [Finset.inf'_univ_eq_ciInf] at hi₀
    refine le_antisymm (le_ciInf fun i ↦ ?_) ?_
    · rw [← add_assoc]
      gcongr
      exact ciInf_le (OrderBot.bddBelow _) i
    · rw [hi₀, add_assoc]
      exact ciInf_le (OrderBot.bddBelow _) i₀
  subst hdeg
  rw [← iInf_addVal_derivative_add_one_eq_iff hn hf rfl, eq_comm, ← hshift]
  norm_cast
  omega

/-- **Ore's realizability theorem**: for every nonarchimedean local field `K` (in either
characteristic) and all `n, j : ℕ`, some totally ramified extension `E ∈ σ_K(n)` inside
`SeparableClosure K` has wild exponent `j` if and only if `IsOreAdmissible K n j`. -/
theorem ore_realizability {n j : ℕ} :
    (∃ E ∈ totallyRamifiedOfDegree K n, E.wildExponent = j) ↔ IsOreAdmissible K n j := by
  constructor
  · rintro ⟨E, hE, rfl⟩
    obtain ⟨f, x, -, hf, hdeg, hx, rfl⟩ :=
      exists_eisenstein_generator_of_mem_totallyRamifiedOfDegree hE
    exact ((wildExponent_adjoin_eq_iff_of_eisenstein hf hdeg hx).mp rfl).1
  · intro hadm
    have hn : 0 < n := hadm.pos
    obtain ⟨c, hf, hcoeff, hcrit⟩ := hadm.exists_monic_isEisensteinAt
    let f : 𝒪[K][X] := monicOfCoeff c
    have hdeg : f.natDegree = n := natDegree_monicOfCoeff c
    have ha_eis : (fun i : Fin n ↦ (c i : K)) ∈ eisensteinSet K n :=
      mem_eisensteinSet_iff_exists_isEisensteinAt.mpr
        ⟨f, by rw [map_monicOfCoeff, Algebra.coe_algebraMap_ofSubsemiring], hf⟩
    have hirr : Irreducible (f.map (algebraMap 𝒪[K] K)) := by
      rw [map_monicOfCoeff, Algebra.coe_algebraMap_ofSubsemiring]
      exact irreducible_monicOfCoeff_of_mem_eisensteinSet hn ha_eis
    have hsep : (f.map (algebraMap 𝒪[K] K)).Separable :=
      (separable_iff_derivative_ne_zero hirr).mpr
        (hadm.derivative_map_ne_zero_of_isEisensteinAt hf hdeg hcrit)
    have hdeg_map : (f.map (algebraMap 𝒪[K] K)).degree ≠ 0 := by
      rw [degree_eq_natDegree ((monic_monicOfCoeff c).map (algebraMap 𝒪[K] K)).ne_zero,
        natDegree_map_eq_of_injective (FaithfulSMul.algebraMap_injective 𝒪[K] K), hdeg]
      exact mod_cast hn.ne'
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root ((f.map (algebraMap 𝒪[K] K)).map
      (algebraMap K (SeparableClosure K)))
      (by rwa [degree_map_eq_of_injective (algebraMap K (SeparableClosure K)).injective])
      hsep.map
    have hxf : aeval x (f.map (algebraMap 𝒪[K] K)) = 0 := by
      simpa only [IsRoot, eval_map, ← aeval_def] using hx
    exact ⟨K⟮x⟯, adjoin_mem_totallyRamifiedOfDegree_of_eisenstein hf hdeg hxf,
      (wildExponent_adjoin_eq_iff_of_eisenstein hf hdeg hxf).mpr ⟨hadm, hcoeff, hcrit⟩⟩

end LocalField

end TauCeti
