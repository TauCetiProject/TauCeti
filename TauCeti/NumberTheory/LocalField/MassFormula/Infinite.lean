module

public import TauCeti.NumberTheory.LocalField.MassFormula.Eisenstein.Basic
import Mathlib.FieldTheory.IsSepClosed
import TauCeti.Algebra.Polynomial.Degree.Operations
import TauCeti.RingTheory.DiscreteValuationRing.Basic
import TauCeti.RingTheory.Polynomial.Eisenstein.Basic

/-!
# Infinitely many totally ramified extensions in equal characteristic

Let `K` be a nonarchimedean local field and `0 < n` with `(n : K) = 0`, that is, `K` has
characteristic `p > 0` and `p ∣ n`. Then `σ_K(n) = totallyRamifiedOfDegree K n` is infinite. This
is the converse half of Serre's finiteness dichotomy: outside this case the discriminant exponents
of the members of `σ_K(n)` are bounded, and the mass formula forces `σ_K(n)` to be finite.

The witnesses are Serre's explicit family. For a uniformizer `π` of `K` and `m ≥ 1`, the polynomial
`X ^ n + π ^ m X + π` is Eisenstein, and it has a root in `SeparableClosure K` because its
derivative is the nonzero constant `π ^ m`. The root generates a member of `σ_K(n)` whose
discriminant exponent is `n * m`, so these members are pairwise distinct.

The discriminant exponent is computed by
`natCast_discriminantExponent_adjoin_eq_iInf_of_eisenstein`, the Eisenstein formula for a
subextension of `SeparableClosure K` generated by a root of an Eisenstein polynomial.

## Main results

* `TauCeti.exists_mem_totallyRamifiedOfDegree_discriminantExponent_eq`: if `0 < n` and
  `(n : K) = 0`, then every multiple `n * m` with `0 < m` is the discriminant exponent of a member
  of `σ_K(n)`.
* `TauCeti.infinite_totallyRamifiedOfDegree`: if `0 < n` and `(n : K) = 0`, then `σ_K(n)` is
  infinite.

## References

* J.-P. Serre, *Une « formule de masse » pour les extensions totalement ramifiées de degré donné
  d'un corps local*, C. R. Acad. Sci. Paris Sér. A **286** (1978), 1031–1036, Remarque 1°.
* J.-P. Serre, *Local Fields*, Chapter III, §6, Proposition 13.
-/

public section
noncomputable section

open ValuativeRel Polynomial IsDiscreteValuationRing
open scoped IntermediateField

namespace TauCeti

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

/-- **Serre's family of wild extensions.** If `0 < n` and `(n : K) = 0`, then for every `0 < m`
some member of `σ_K(n)` has discriminant exponent `n * m`: it is generated by a root of
`X ^ n + π ^ m X + π` for a uniformizer `π` of `K`. -/
theorem exists_mem_totallyRamifiedOfDegree_discriminantExponent_eq {n : ℕ} (hn : 0 < n)
    (hnK : (n : K) = 0) {m : ℕ} (hm : 0 < m) :
    ∃ L ∈ totallyRamifiedOfDegree K n, L.discriminantExponent = n * m := by
  -- `(1 : K) ≠ 0`, so `n ≠ 1`.
  have hn2 : 2 ≤ n := by
    by_contra h
    obtain rfl : n = 1 := by omega
    exact one_ne_zero (by exact_mod_cast hnK : (1 : K) = 0)
  obtain ⟨π, hπ⟩ := exists_irreducible 𝒪[K]
  let f : 𝒪[K][X] := X ^ n + C (π ^ m) * X + C π
  have hπ𝓂 : π ∈ 𝓂[K] := hπ.not_isUnit
  have hf : f.IsEisensteinAt 𝓂[K] := by
    refine isEisensteinAt_X_pow_add_C_mul_X_add_C (Ideal.pow_mem_of_mem _ hπ𝓂 m hm) hπ𝓂 ?_ hn2
    rw [IsDiscreteValuationRing.mem_maximalIdeal_pow_iff_le_addVal, addVal_uniformizer hπ]
    simp
  have hdeg : f.natDegree = n := natDegree_X_pow_add_C_mul_X_add_C _ _ hn2
  -- The derivative of `f` is the nonzero constant `π ^ m`, so `f` has a root in the separable
  -- closure.
  have hπ0 : algebraMap K (SeparableClosure K) π ≠ 0 :=
    (_root_.map_ne_zero _).2 (Subtype.coe_ne_coe.2 hπ.ne_zero)
  obtain ⟨x, hx⟩ := IsSepClosed.exists_root_C_mul_X_pow_add_C_mul_X_add_C 1
    (algebraMap K (SeparableClosure K) (π ^ m)) (algebraMap K (SeparableClosure K) π)
    (by rw [← map_natCast (algebraMap K (SeparableClosure K)), hnK, map_zero]) hn2
    (by simpa using pow_ne_zero m hπ0)
  have hxf : aeval x (f.map (algebraMap 𝒪[K] K)) = 0 := by
    simpa [f, Algebra.algebraMap_ofSubsemiring_apply] using hx
  refine ⟨K⟮x⟯, adjoin_mem_totallyRamifiedOfDegree_of_eisenstein hf hdeg hxf, ?_⟩
  -- Only the term of index `0` of the derivative is nonzero: it is `π ^ m`, of valuation `m`.
  have hd := natCast_discriminantExponent_adjoin_eq_iInf_of_eisenstein hf hxf
  have hn𝒪 : (n : 𝒪[K]) = 0 := Subtype.ext (by simpa using hnK)
  have hcoeff (i : ℕ) : f.coeff i =
      (if i = n then 1 else 0) + (if i = 1 then π ^ m else 0) + (if i = 0 then π else 0) := by
    simp only [f, coeff_add, coeff_X_pow, coeff_C_mul_X, coeff_C]
  rw [hdeg] at hd
  -- The term of index `0` is `n • v_K(π ^ m) = n * m`.
  have h0 : n • addVal 𝒪[K] (f.coeff (0 + 1) * (0 + 1)) + ((0 : ℕ) : ℕ∞) =
      ((n * m : ℕ) : ℕ∞) := by
    have h1n : 1 ≠ n := by omega
    simp [hcoeff, h1n, addVal_uniformizer hπ]
  -- Every other term is `⊤`: its coefficient vanishes, or it is the leading one, times `n = 0`.
  have hi (i : ℕ) (hi0 : i ≠ 0) (hin : i < n) : f.coeff (i + 1) * (i + 1) = 0 := by
    rcases (Nat.succ_le_of_lt hin).lt_or_eq with h | h
    · simp [hcoeff, h.ne, hi0]
    · rw [← Nat.cast_succ, h, hn𝒪, mul_zero]
  have hiInf : (⨅ i : Fin n, n • addVal 𝒪[K] (f.coeff (i + 1) * (i + 1)) + (i : ℕ)) =
      ((n * m : ℕ) : ℕ∞) := by
    refine le_antisymm (iInf_le_of_le ⟨0, hn⟩ (by simpa using h0.le)) (le_iInf fun i ↦ ?_)
    by_cases hi0 : (i : ℕ) = 0
    · simpa [hi0] using h0.ge
    · simp [hi i hi0 i.isLt, hn.ne']
  exact_mod_cast hd.trans hiInf

/-- **Infinitely many totally ramified extensions in equal characteristic.** If `0 < n` and
`(n : K) = 0`, that is, `K` has characteristic `p > 0` with `p ∣ n`, then `σ_K(n)` is infinite:
its discriminant exponents are unbounded. -/
theorem infinite_totallyRamifiedOfDegree {n : ℕ} (hn : 0 < n) (hnK : (n : K) = 0) :
    (totallyRamifiedOfDegree K n).Infinite := by
  intro hfin
  obtain ⟨B, hB⟩ := (hfin.image IntermediateField.discriminantExponent).bddAbove
  obtain ⟨L, hL, hLd⟩ :=
    exists_mem_totallyRamifiedOfDegree_discriminantExponent_eq hn hnK (by omega : 0 < B + 1)
  have := hB ⟨L, hL, hLd⟩
  have := Nat.le_mul_of_pos_left (B + 1) hn
  omega

end TauCeti
