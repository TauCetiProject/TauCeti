/-!
# The totally ramified quadratic extensions of `ℚ_2`

This file determines `σ_{ℚ_2}(2) = totallyRamifiedOfDegree ℚ_[2] 2` explicitly, together with
the wild exponent of each member, independently of Serre's mass formula:

`σ_{ℚ_2}(2) = {ℚ_2(√-1), ℚ_2(√-5), ℚ_2(√2), ℚ_2(√-2), ℚ_2(√10), ℚ_2(√-10)}`.

These six fields are distinct. The first two have discriminant exponent `2`, hence wild
exponent `c = 1`, and the other four have discriminant exponent `3`, hence `c = 2`, so Serre's
mass formula reads `2 · 2⁻¹ + 4 · 2⁻² = 2`. This is the smallest wildly ramified instance of the
mass formula, and it distinguishes `c(L) = d(L) - n + 1` from its neighbours `d(L) - n` and
`d(L) - n + 2`, which give the sums `4` and `1`.

The proof runs through the eight square classes `1, -1, 5, -5, 2, -2, 10, -10` of `ℚ_2`
(`TauCeti.squareClass_padicTwoSquareClassRep_bijective`). A quadratic subextension is `ℚ_2(√a)`
for some `a ∈ ℚ_2ˣ`, and it depends only on the square class of `a`. The class `1` gives `ℚ_2`
itself. The class `5` is also the class of `-3`, since `-15` is `1` modulo `8`, and `ℚ_2(√-3)` is
generated by a primitive cube root of unity, so it is unramified
(`TauCeti.mem_maximalUnramifiedExtension_of_sq_eq_neg_three`). The classes `2u`, for `u` a unit,
give the fields `ℚ_2(√c)` for the uniformizers `c = 2u`, and the classes `-1` and `-5` give the
fields `ℚ_2(√(1 - c))` for the uniformizers `c = 2` and `c = 6`. Their membership in `σ_{ℚ_2}(2)`
and their discriminant exponents `2 v(2) + 1 = 3` and `2 v(2) = 2` are the specializations to `ℚ_2`
of `TauCeti.natCast_discriminantExponent_adjoin_of_sq_eq_of_irreducible`,
`TauCeti.adjoin_mem_totallyRamifiedOfDegree_two_of_sq_eq_one_sub` and
`TauCeti.natCast_discriminantExponent_adjoin_of_sq_eq_one_sub_of_irreducible`.

## Main results

* `TauCeti.totallyRamifiedOfDegree_two_eq_padicTwo`: the six fields above are `σ_{ℚ_2}(2)`.
* `TauCeti.encard_totallyRamifiedOfDegree_two_padicTwo`: `σ_{ℚ_2}(2)` has exactly six elements.
* `TauCeti.tsum_one_div_pow_wildExponent_two_padicTwo`: Serre's mass formula
  `∑_{L ∈ σ_{ℚ_2}(2)} 2 ^ (-c(L)) = 2`.

## References

* J.-P. Serre, *Une « formule de masse » pour les extensions totalement ramifiées de degré donné
  d'un corps local*, C. R. Acad. Sci. Paris Sér. A **286** (1978), 1031–1036.
* J.-P. Serre, *A Course in Arithmetic*, Chapter II, §3, for the square classes of `ℚ_2`.
-/

public section
noncomputable section

open ValuativeRel Polynomial IsDiscreteValuationRing
open scoped IntermediateField ENNReal

namespace TauCeti

/-! ### Uniformizers of `ℚ_2` -/

/-- `2` is a uniformizer of `ℚ_2`. -/
private theorem irreducible_two_padicTwo : Irreducible (2 : 𝒪[ℚ_[2]]) := by
  exact_mod_cast Padic.irreducible_natCast_self 2

/-- The element `2` of the ring of integers of `ℚ_2`, read in `ℚ_2`. -/
private theorem coe_two_integerRing_padicTwo : ((2 : 𝒪[ℚ_[2]]) : ℚ_[2]) = 2 := by
  exact_mod_cast SubringClass.coe_natCast 𝒪[ℚ_[2]] 2

/-- The element `m * 2` of the ring of integers of `ℚ_2`, read in `ℚ_2`. -/
private theorem coe_intCast_mul_two_padicTwo (m : ℤ) :
    (((m : 𝒪[ℚ_[2]]) * 2 : 𝒪[ℚ_[2]]) : ℚ_[2]) = m * 2 := by
  rw [MulMemClass.coe_mul, SubringClass.coe_intCast, coe_two_integerRing_padicTwo]

/-! ### The two families of ramified quadratic extensions -/

/-- The wild exponent of `ℚ_2(√c)` for a uniformizer `c` of `ℚ_2` is `2`: its discriminant
exponent is `2 v(2) + 1 = 3`. -/
private theorem wildExponent_adjoin_of_sq_eq_of_irreducible_padicTwo {c : 𝒪[ℚ_[2]]}
    (hc : Irreducible c) {x : SeparableClosure ℚ_[2]}
    (hx : x ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) c) :
    (ℚ_[2]⟮x⟯).wildExponent = 2 := by
  have h := natCast_discriminantExponent_adjoin_of_sq_eq_of_irreducible hc hx
  rw [addVal_uniformizer irreducible_two_padicTwo] at h
  have hd : (ℚ_[2]⟮x⟯).discriminantExponent = 3 := by exact_mod_cast h
  simp [IntermediateField.wildExponent_def, hd,
    (mem_totallyRamifiedOfDegree_iff.1
      (adjoin_mem_totallyRamifiedOfDegree_of_pow_eq hc two_pos hx)).1]

/-- `ℚ_2(√(1 - c))` lies in `σ_{ℚ_2}(2)` and has wild exponent `1` for a uniformizer `c` of
`ℚ_2`: its discriminant exponent is `2 v(2) = 2`. -/
private theorem adjoin_mem_and_wildExponent_of_sq_eq_one_sub_padicTwo {c : 𝒪[ℚ_[2]]}
    (hc : Irreducible c) {x : SeparableClosure ℚ_[2]}
    (hx : x ^ 2 = 1 - algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) c) :
    ℚ_[2]⟮x⟯ ∈ totallyRamifiedOfDegree ℚ_[2] 2 ∧ (ℚ_[2]⟮x⟯).wildExponent = 1 := by
  have h2 : (2 : 𝒪[ℚ_[2]]) ∈ 𝓂[ℚ_[2]] :=
    (IsLocalRing.mem_maximalIdeal _).2 irreducible_two_padicTwo.not_isUnit
  have hmem := adjoin_mem_totallyRamifiedOfDegree_two_of_sq_eq_one_sub h2 hc hx
  have h := natCast_discriminantExponent_adjoin_of_sq_eq_one_sub_of_irreducible h2 hc hx
  rw [addVal_uniformizer irreducible_two_padicTwo] at h
  have hd : (ℚ_[2]⟮x⟯).discriminantExponent = 2 := by exact_mod_cast h
  refine ⟨hmem, ?_⟩
  simp [IntermediateField.wildExponent_def, hd, (mem_totallyRamifiedOfDegree_iff.1 hmem).1]

/-- Every member of `σ_{ℚ_2}(2)` is generated by a square root of one of the representatives
`-1, -5, 2, -2, 10, -10` of the square classes of `ℚ_2`: the classes `1` and `5` give no member. -/
private theorem exists_eq_adjoin_of_mem_padicTwo
    {L : IntermediateField ℚ_[2] (SeparableClosure ℚ_[2])}
    (hL : L ∈ totallyRamifiedOfDegree ℚ_[2] 2) :
    ∃ i : Fin 8, i ≠ 0 ∧ i ≠ 2 ∧ ∀ w : SeparableClosure ℚ_[2],
      w ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (padicTwoSquareClassRep i) →
        L = ℚ_[2]⟮w⟯ := by
  -- `L = ℚ_2(z)` with `z ^ 2 = a` for some nonzero `a ∈ ℚ_2`.
  obtain ⟨z, -, hzb, ⟨a, hz⟩, hLz⟩ :=
    IntermediateField.exists_sq_mem_range_adjoin_simple_eq_of_finrank_eq_two
      (mem_totallyRamifiedOfDegree_iff.1 hL).1
  have ha : a ≠ 0 := by
    rintro rfl
    have hz0 : z = 0 := by simpa using hz
    exact hzb (hz0 ▸ zero_mem _)
  -- The square class of `a` is that of one of the eight representatives.
  obtain ⟨i, hi⟩ := squareClass_padicTwoSquareClassRep_bijective.2 (squareClass (Units.mk0 a ha))
  have hsq : IsSquare (a * padicTwoSquareClassRep i) := by
    rw [eq_comm, squareClass_eq_iff_isSquare_mul] at hi
    simpa using hi.map (Units.coeHom ℚ_[2])
  have hL_eq {w : SeparableClosure ℚ_[2]} {r : ℚ_[2]}
      (hw : w ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) r) (hr : r ≠ 0)
      (har : IsSquare (a * r)) : L = ℚ_[2]⟮w⟯ :=
    hLz.symm.trans (IntermediateField.adjoin_simple_eq_of_isSquare_mul hz hw ha hr har)
  refine ⟨i, ?_, ?_, fun w hw ↦ hL_eq hw (Units.ne_zero _) hsq⟩
  · -- The class of `1` gives `ℚ_2` itself, which has degree one.
    rintro rfl
    have h := (mem_totallyRamifiedOfDegree_iff.1 hL).1
    rw [hL_eq (w := 1) (r := 1) (by simp) one_ne_zero (by simpa using hsq),
      IntermediateField.adjoin_one, IntermediateField.finrank_bot] at h
    omega
  · -- The class of `5` is that of `-3`, which gives an unramified field.
    rintro rfl
    obtain ⟨w, hw⟩ := IsSepClosed.exists_pow_nat_eq (-3 : SeparableClosure ℚ_[2]) 2
    have hw' : w ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (-3) := by
      rw [hw, map_neg, map_ofNat]
    have h3 : IsSquare (a * -3) := by
      obtain ⟨s, hs⟩ := hsq
      obtain ⟨t, ht⟩ := isSquare_neg_fifteen_padicTwo
      refine ⟨s * t / 5, ?_⟩
      simp only [coe_padicTwoSquareClassRep] at hs
      norm_num at hs
      field_simp
      linear_combination t ^ 2 * hs + 5 * a * ht
    -- The residue characteristic `2` does not divide `3`.
    have hp : ¬ ringChar 𝓀[ℚ_[2]] ∣ 3 := IsLocalRing.isUnit_natCast_iff_not_dvd.1 <| by
      exact_mod_cast Padic.isUnit_intCast_integerRing (p := 2) (m := 3) (by norm_num)
    have h := eq_one_of_mem_totallyRamifiedOfDegree_of_le_maximalUnramifiedExtension hL
      ((hL_eq hw' (by norm_num) h3).symm ▸ IntermediateField.adjoin_simple_le_iff.2
        (mem_maximalUnramifiedExtension_of_sq_eq_neg_three hp hw))
    omega

/-! ### The six totally ramified quadratic extensions -/

/-- The indices `1, 3, 4, 5, 6, 7` of the representatives `-1, -5, 2, -2, 10, -10` of the
square classes of `ℚ_2` whose square roots generate totally ramified quadratic extensions. -/
private def ramifiedIndices : Finset (Fin 8) := {1, 3, 4, 5, 6, 7}

/-- Square roots of the representatives `-1, -5` generate members of `σ_{ℚ_2}(2)` of wild
exponent `1`, and those of `2, -2, 10, -10` members of wild exponent `2`. -/
private theorem adjoin_mem_and_wildExponent_eq_padicTwo {i : Fin 8} (hi : i ∈ ramifiedIndices)
    {y : SeparableClosure ℚ_[2]}
    (hy : y ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (padicTwoSquareClassRep i)) :
    ℚ_[2]⟮y⟯ ∈ totallyRamifiedOfDegree ℚ_[2] 2 ∧
      (ℚ_[2]⟮y⟯).wildExponent = if i = 1 ∨ i = 3 then 1 else 2 := by
  -- The representatives are `1 - 2 m` or `2 m` for an odd integer `m`, and `2 m` is a uniformizer.
  have hirr {m : ℤ} (hm : ¬ 2 ∣ m) : Irreducible ((m : 𝒪[ℚ_[2]]) * 2) := by
    exact_mod_cast Padic.irreducible_intCast_mul_natCast_self (p := 2) (m := m)
      (by exact_mod_cast hm)
  have hone {m : ℤ} (hm : ¬ 2 ∣ m)
      (h : y ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (1 - m * 2)) :
      ℚ_[2]⟮y⟯ ∈ totallyRamifiedOfDegree ℚ_[2] 2 ∧ (ℚ_[2]⟮y⟯).wildExponent = 1 := by
    rw [map_sub, map_one, ← coe_intCast_mul_two_padicTwo] at h
    exact adjoin_mem_and_wildExponent_of_sq_eq_one_sub_padicTwo (hirr hm) h
  have htwo {m : ℤ} (hm : ¬ 2 ∣ m)
      (h : y ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (m * 2)) :
      ℚ_[2]⟮y⟯ ∈ totallyRamifiedOfDegree ℚ_[2] 2 ∧ (ℚ_[2]⟮y⟯).wildExponent = 2 := by
    rw [← coe_intCast_mul_two_padicTwo] at h
    exact ⟨adjoin_mem_totallyRamifiedOfDegree_of_pow_eq (hirr hm) two_pos h,
      wildExponent_adjoin_of_sq_eq_of_irreducible_padicTwo (hirr hm) h⟩
  simp only [ramifiedIndices, Finset.mem_insert, Finset.mem_singleton] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl | rfl
  · simpa using hone (m := 1) (by decide) (by rw [hy]; norm_num)
  · simpa using hone (m := 3) (by decide) (by rw [hy]; norm_num)
  · simpa using htwo (m := 1) (by decide) (by rw [hy]; norm_num)
  · simpa using htwo (m := -1) (by decide) (by rw [hy]; norm_num)
  · simpa using htwo (m := 5) (by decide) (by rw [hy]; norm_num)
  · simpa using htwo (m := -5) (by decide) (by rw [hy]; norm_num)

/-- Square roots of representatives of distinct square classes of `ℚ_2` generate distinct
fields, unless they lie in `ℚ_2`. -/
private theorem adjoin_ne_adjoin_padicTwo {i j : Fin 8} (hij : i ≠ j)
    {x y : SeparableClosure ℚ_[2]}
    (hx : x ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (padicTwoSquareClassRep i))
    (hy : y ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (padicTwoSquareClassRep j))
    (hxb : x ∉ (⊥ : IntermediateField ℚ_[2] (SeparableClosure ℚ_[2]))) :
    ℚ_[2]⟮x⟯ ≠ ℚ_[2]⟮y⟯ := fun hxy ↦ by
  have h := IntermediateField.isSquare_mul_of_adjoin_simple_eq hx hy hxb hxy
  rw [← Units.val_mul, isSquare_units_val_iff, ← squareClass_eq_iff_isSquare_mul] at h
  exact hij (squareClass_padicTwoSquareClassRep_bijective.1 h)

/-- `σ_{ℚ_2}(2)` consists of the fields generated by square roots of the representatives
`-1, -5, 2, -2, 10, -10` of the square classes of `ℚ_2`. -/
private theorem totallyRamifiedOfDegree_two_eq_image_padicTwo
    {y : Fin 8 → SeparableClosure ℚ_[2]}
    (hy : ∀ i, y i ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (padicTwoSquareClassRep i)) :
    totallyRamifiedOfDegree ℚ_[2] 2 = (fun i ↦ ℚ_[2]⟮y i⟯) '' ramifiedIndices := by
  refine Set.Subset.antisymm (fun L hL ↦ ?_) ?_
  · obtain ⟨i, h0, h2, hL⟩ := exists_eq_adjoin_of_mem_padicTwo hL
    refine ⟨i, ?_, (hL _ (hy i)).symm⟩
    fin_cases i <;> simp_all [ramifiedIndices]
  · rintro _ ⟨i, hi, rfl⟩
    exact (adjoin_mem_and_wildExponent_eq_padicTwo hi (hy i)).1

/-- The six fields of `TauCeti.totallyRamifiedOfDegree_two_eq_image_padicTwo` are pairwise
distinct. -/
private theorem injOn_adjoin_padicTwo {y : Fin 8 → SeparableClosure ℚ_[2]}
    (hy : ∀ i, y i ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (padicTwoSquareClassRep i)) :
    Set.InjOn (fun i ↦ ℚ_[2]⟮y i⟯) ramifiedIndices := by
  intro i hi j _ hij
  by_contra hne
  refine adjoin_ne_adjoin_padicTwo hne (hy i) (hy j) ?_ hij
  -- `y i ∉ ℚ_2`, since `ℚ_2(y i)` has degree two.
  rw [← IntermediateField.adjoin_simple_eq_bot_iff]
  intro hbot
  have h := (mem_totallyRamifiedOfDegree_iff.1
    (adjoin_mem_and_wildExponent_eq_padicTwo hi (hy i)).1).1
  rw [hbot, IntermediateField.finrank_bot] at h
  omega

/-- **The totally ramified quadratic extensions of `ℚ_2`.** If `x₁, …, x₆` are square roots of
`-1, -5, 2, -2, 10, -10` in the separable closure of `ℚ_2`, then
`σ_{ℚ_2}(2) = {ℚ_2(x₁), ℚ_2(x₂), ℚ_2(x₃), ℚ_2(x₄), ℚ_2(x₅), ℚ_2(x₆)}`. -/
theorem totallyRamifiedOfDegree_two_eq_padicTwo {x₁ x₂ x₃ x₄ x₅ x₆ : SeparableClosure ℚ_[2]}
    (h₁ : x₁ ^ 2 = -1) (h₂ : x₂ ^ 2 = -5) (h₃ : x₃ ^ 2 = 2) (h₄ : x₄ ^ 2 = -2)
    (h₅ : x₅ ^ 2 = 10) (h₆ : x₆ ^ 2 = -10) :
    totallyRamifiedOfDegree ℚ_[2] 2 =
      {ℚ_[2]⟮x₁⟯, ℚ_[2]⟮x₂⟯, ℚ_[2]⟮x₃⟯, ℚ_[2]⟮x₄⟯, ℚ_[2]⟮x₅⟯, ℚ_[2]⟮x₆⟯} := by
  obtain ⟨w, hw⟩ := IsSepClosed.exists_pow_nat_eq (5 : SeparableClosure ℚ_[2]) 2
  rw [totallyRamifiedOfDegree_two_eq_image_padicTwo (y := ![1, x₁, w, x₂, x₃, x₄, x₅, x₆])]
  · simp [ramifiedIndices, Set.image_insert_eq]
  · intro i
    fin_cases i <;>
      simp [h₁, h₂, h₃, h₄, h₅, h₆, hw, map_ofNat (algebraMap ℚ_[2] (SeparableClosure ℚ_[2]))]

/-- **`σ_{ℚ_2}(2)` has exactly six elements.** -/
theorem encard_totallyRamifiedOfDegree_two_padicTwo :
    (totallyRamifiedOfDegree ℚ_[2] 2).encard = 6 := by
  choose y hy using fun i : Fin 8 ↦ IsSepClosed.exists_pow_nat_eq
    (algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (padicTwoSquareClassRep i)) 2
  rw [totallyRamifiedOfDegree_two_eq_image_padicTwo hy, (injOn_adjoin_padicTwo hy).encard_image,
    Set.encard_coe_eq_coe_finsetCard]
  simp [ramifiedIndices]

/-- **Serre's mass formula for the quadratic extensions of `ℚ_2`**:
`∑_{L ∈ σ_{ℚ_2}(2)} 2 ^ (-c(L)) = 2 · 2⁻¹ + 4 · 2⁻² = 2`. -/
theorem tsum_one_div_pow_wildExponent_two_padicTwo :
    ∑' L : totallyRamifiedOfDegree ℚ_[2] 2, 1 / (2 : ℝ≥0∞) ^ L.1.wildExponent = 2 := by
  classical
  choose y hy using fun i : Fin 8 ↦ IsSepClosed.exists_pow_nat_eq
    (algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (padicTwoSquareClassRep i)) 2
  rw [totallyRamifiedOfDegree_two_eq_image_padicTwo hy, ← Finset.coe_image,
    Finset.tsum_subtype' (ramifiedIndices.image fun i ↦ ℚ_[2]⟮y i⟯)
      fun L : IntermediateField ℚ_[2] (SeparableClosure ℚ_[2]) ↦ 1 / (2 : ℝ≥0∞) ^ L.wildExponent,
    Finset.sum_image (injOn_adjoin_padicTwo hy),
    Finset.sum_congr rfl fun i hi ↦ by rw [(adjoin_mem_and_wildExponent_eq_padicTwo hi (hy i)).2]]
  -- The weights are `2⁻¹` twice and `2⁻²` four times; compare real parts.
  simp only [ramifiedIndices]
  rw [← ENNReal.toReal_eq_toReal_iff' (by simp) (by simp)]
  simp [ENNReal.toReal_add]
  norm_num

end TauCeti
