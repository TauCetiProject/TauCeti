/-!
# The totally ramified quadratic extensions of `ℚ₂`

This file determines `σ_{ℚ₂}(2) = totallyRamifiedOfDegree ℚ_[2] 2` explicitly, together with the
discriminant and wild exponents of its members, independently of Serre's mass formula:

`σ_{ℚ₂}(2) = {ℚ₂(√-1), ℚ₂(√-5), ℚ₂(√2), ℚ₂(√-2), ℚ₂(√10), ℚ₂(√-10)}`,

the six fields being distinct. The first two have discriminant exponent `2`, hence wild exponent
`c = 1`, and the other four have discriminant exponent `3`, hence `c = 2`. Serre's mass formula
`∑_{L ∈ σ_{ℚ₂}(2)} 2 ^ (-c(L)) = 2` then reads `2 · 2⁻¹ + 4 · 2⁻² = 2`. This is the smallest
wild case of the formula, and it pins down the normalization of `c = d - n + 1`: an exponent off
by one would give a different sum.

The proof runs through the eight square classes of `ℚ₂`, those of `±1`, `±5`, `±2`, `±10`, read off
the basis `-1`, `2`, `5` of `TauCeti.padicTwoSquareClassBasis`. A quadratic subextension is `ℚ₂(√a)`
for some `a ∈ ℚ₂ˣ`, and it depends only on the square class of `a`. The class `1` gives `ℚ₂`
itself. The class `5` gives the unramified quadratic extension: `-15` is a square in `ℚ₂`, so
`ℚ₂(√5) = ℚ₂(√-3)` is generated by a primitive cube root of unity. The classes of `2 m` with `m`
odd are those of `±2`, `±10`, generated by roots of the Eisenstein polynomials `X ^ 2 - 2 m`;
those of `1 - 2 m` with `m` odd are those of `-1`, `-5`, generated by square roots of `1 - ϖ` for
the uniformizer `ϖ = 2 m`. Two of the six fields coincide only if the product of their radicands
is a square, which is excluded by reducing modulo `32`.

## Main results

* `TauCeti.totallyRamifiedOfDegree_two_eq_padicTwo`: the list of the six members of
  `σ_{ℚ₂}(2)`.
* `TauCeti.encard_totallyRamifiedOfDegree_two_padicTwo`: `σ_{ℚ₂}(2)` has exactly six elements.
* `TauCeti.discriminantExponent_adjoin_of_sq_eq_padicTwo` and
  `TauCeti.wildExponent_adjoin_of_sq_eq_padicTwo`: `d = 3` and `c = 2` for `ℚ₂(√ϖ)`, `ϖ` a
  uniformizer.
* `TauCeti.discriminantExponent_adjoin_of_sq_eq_one_sub_padicTwo` and
  `TauCeti.wildExponent_adjoin_of_sq_eq_one_sub_padicTwo`: `d = 2` and `c = 1` for
  `ℚ₂(√(1 - ϖ))`, `ϖ` a uniformizer.
* `TauCeti.tsum_one_div_two_pow_wildExponent_two_padicTwo`: Serre's mass formula for quadratic
  extensions of `ℚ₂`.

## References

* J.-P. Serre, *Une « formule de masse » pour les extensions totalement ramifiées de degré donné
  d'un corps local*, C. R. Acad. Sci. Paris Sér. A **286** (1978), 1031–1036.
* J.-P. Serre, *A Course in Arithmetic*, Chapter II, §3, for the square classes of `ℚ₂`.
-/

public section

open ValuativeRel Polynomial
open scoped IntermediateField ENNReal

namespace TauCeti

/-! ### Uniformizers and units of `ℤ₂` -/

private theorem coe_two_padicTwo : ((2 : 𝒪[ℚ_[2]]) : ℚ_[2]) = 2 :=
  map_ofNat (Subring.subtype 𝒪[ℚ_[2]]) 2

/-! ### The discriminant and wild exponents -/

/-- **`ℚ₂(√ϖ)` has discriminant exponent `3`** for every uniformizer `ϖ` of `ℚ₂`. -/
theorem discriminantExponent_adjoin_of_sq_eq_padicTwo {ϖ : 𝒪[ℚ_[2]]} (hϖ : Irreducible ϖ)
    {x : SeparableClosure ℚ_[2]} (hx : x ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) ϖ) :
    (ℚ_[2]⟮x⟯).discriminantExponent = 3 := by
  have h := natCast_discriminantExponent_adjoin_of_pow_eq hϖ two_pos hx
  simp only [Padic.addVal_natCast_self 2] at h
  exact_mod_cast h

/-- **`ℚ₂(√(1 - ϖ))` has discriminant exponent `2`** for every uniformizer `ϖ` of `ℚ₂`. -/
theorem discriminantExponent_adjoin_of_sq_eq_one_sub_padicTwo {ϖ : 𝒪[ℚ_[2]]}
    (hϖ : Irreducible ϖ) {x : SeparableClosure ℚ_[2]}
    (hx : x ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (1 - ϖ)) :
    (ℚ_[2]⟮x⟯).discriminantExponent = 2 := by
  have h := natCast_discriminantExponent_adjoin_of_sq_eq_one_sub
    (Padic.ringChar_residueField 2).dvd hϖ hx
  rw [← Nat.cast_ofNat (R := 𝒪[ℚ_[2]]) (n := 2), Padic.addVal_natCast_self] at h
  exact_mod_cast h

/-- **`ℚ₂(√ϖ)` has wild exponent `2`** for every uniformizer `ϖ` of `ℚ₂`. -/
theorem wildExponent_adjoin_of_sq_eq_padicTwo {ϖ : 𝒪[ℚ_[2]]} (hϖ : Irreducible ϖ)
    {x : SeparableClosure ℚ_[2]} (hx : x ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) ϖ) :
    (ℚ_[2]⟮x⟯).wildExponent = 2 := by
  rw [IntermediateField.wildExponent_def, discriminantExponent_adjoin_of_sq_eq_padicTwo hϖ hx,
    (mem_totallyRamifiedOfDegree_iff.1
      (adjoin_mem_totallyRamifiedOfDegree_of_pow_eq hϖ two_pos hx)).1]
  rfl

/-- **`ℚ₂(√(1 - ϖ))` has wild exponent `1`** for every uniformizer `ϖ` of `ℚ₂`. -/
theorem wildExponent_adjoin_of_sq_eq_one_sub_padicTwo {ϖ : 𝒪[ℚ_[2]]} (hϖ : Irreducible ϖ)
    {x : SeparableClosure ℚ_[2]}
    (hx : x ^ 2 = algebraMap ℚ_[2] (SeparableClosure ℚ_[2]) (1 - ϖ)) :
    (ℚ_[2]⟮x⟯).wildExponent = 1 := by
  rw [IntermediateField.wildExponent_def,
    discriminantExponent_adjoin_of_sq_eq_one_sub_padicTwo hϖ hx,
    (mem_totallyRamifiedOfDegree_iff.1 (adjoin_mem_totallyRamifiedOfDegree_two_of_sq_eq_one_sub
      (Padic.ringChar_residueField 2).dvd hϖ hx)).1]

/-! ### The classification -/

/-- A square root of `5` generates an unramified extension of `ℚ₂`: since `-15` is a square,
it lies in `ℚ₂(√-3)`, which is generated by a primitive cube root of unity. -/
private theorem adjoin_le_maximalUnramifiedExtension_of_sq_eq_five {w : SeparableClosure ℚ_[2]}
    (hw : w ^ 2 = 5) :
    ℚ_[2]⟮w⟯ ≤ maximalUnramifiedExtension ℚ_[2] (SeparableClosure ℚ_[2]) := by
  have : NeZero ((2 : ℕ) : SeparableClosure ℚ_[2]) :=
    NeZero.nat_of_injective (algebraMap ℚ_[2] (SeparableClosure ℚ_[2])).injective
  obtain ⟨v, hv⟩ := IsSepClosed.exists_pow_nat_eq (-3 : SeparableClosure ℚ_[2]) 2
  have h2 : (2 : SeparableClosure ℚ_[2]) ≠ 0 := by simp
  have h3 : ¬ ringChar 𝓀[ℚ_[2]] ∣ 3 := by
    rw [← IsLocalRing.isUnit_natCast_iff_not_dvd]
    exact_mod_cast Padic.isUnit_intCast_integerRing (p := 2) (m := 3) (by decide)
  -- `(v - 1) / 2` is a cube root of unity, hence unramified, and so is `v`.
  have hζ : ((v - 1) / 2) ^ 3 = 1 := by
    field_simp
    linear_combination (v - 3) * hv
  have hvM : v ∈ maximalUnramifiedExtension ℚ_[2] (SeparableClosure ℚ_[2]) := by
    rw [show v = 2 * ((v - 1) / 2) + 1 by field_simp; ring]
    exact add_mem (mul_mem (by simp) (mem_maximalUnramifiedExtension_of_pow_eq_one h3 hζ))
      (one_mem _)
  -- `-3 · 5 = -15` is a square, so `w ∈ ℚ₂(v)`.
  have hwv : w ∈ ℚ_[2]⟮v⟯ :=
    IntermediateField.mem_adjoin_simple_of_isSquare_mul (a := -3) (c := 5)
      (by simp [hv, map_ofNat]) (by simp [hw, map_ofNat]) (by norm_num)
      (by norm_num [Padic.isSquare_neg_fifteen])
  exact IntermediateField.adjoin_simple_le_iff.2
    (IntermediateField.adjoin_simple_le_iff.2 hvM hwv)

/-- Square roots of integers `m` and `n` generate distinct quadratic extensions of `ℚ₂` when
`m n` is not a square modulo `32`. -/
private theorem adjoin_ne_adjoin_padicTwo {m n : ℤ} {x y : SeparableClosure ℚ_[2]}
    (hx : x ^ 2 = m) (hy : y ^ 2 = n)
    (hxb : x ∉ (⊥ : IntermediateField ℚ_[2] (SeparableClosure ℚ_[2])))
    (hmn : ¬ IsSquare ((m * n : ℤ) : ZMod (2 ^ 5))) : ℚ_[2]⟮x⟯ ≠ ℚ_[2]⟮y⟯ := fun h ↦
  Padic.not_isSquare_intCast_of_not_isSquare_zmod hmn (by
    simpa using IntermediateField.isSquare_mul_of_adjoin_simple_eq (a := (m : ℚ_[2]))
      (c := (n : ℚ_[2])) (by simpa using hx) (by simpa using hy) hxb h)

/-- **The totally ramified quadratic extensions of `ℚ₂`.** If `x₁, …, x₆` are square roots of
`-1`, `-5`, `2`, `-2`, `10` and `-10` in the separable closure of `ℚ₂`, then
`σ_{ℚ₂}(2) = {ℚ₂(x₁), …, ℚ₂(x₆)}`. -/
theorem totallyRamifiedOfDegree_two_eq_padicTwo {x₁ x₂ x₃ x₄ x₅ x₆ : SeparableClosure ℚ_[2]}
    (h₁ : x₁ ^ 2 = -1) (h₂ : x₂ ^ 2 = -5) (h₃ : x₃ ^ 2 = 2) (h₄ : x₄ ^ 2 = -2)
    (h₅ : x₅ ^ 2 = 10) (h₆ : x₆ ^ 2 = -10) :
    totallyRamifiedOfDegree ℚ_[2] 2 =
      {ℚ_[2]⟮x₁⟯, ℚ_[2]⟮x₂⟯, ℚ_[2]⟮x₃⟯, ℚ_[2]⟮x₄⟯, ℚ_[2]⟮x₅⟯, ℚ_[2]⟮x₆⟯} := by
  refine Set.Subset.antisymm (fun L hL ↦ ?_) ?_
  · -- `L = ℚ₂(z)` with `z ^ 2 = a` for some nonzero `a ∈ ℚ₂`.
    obtain ⟨z, -, hzb, ⟨a, hz⟩, hLz⟩ :=
      IntermediateField.exists_sq_mem_range_adjoin_simple_eq_of_finrank_eq_two
        (mem_totallyRamifiedOfDegree_iff.1 hL).1
    have ha : a ≠ 0 := by
      rintro rfl
      have hz0 : z = 0 := by simpa using hz
      exact hzb (hz0 ▸ zero_mem _)
    -- A square root `w` of a unit `r` in the square class of `a` generates `L`.
    have hL_eq {r : ℚ_[2]ˣ} (hr : squareClass r = squareClass (Units.mk0 a ha))
        {w : SeparableClosure ℚ_[2]} (hw : w ^ 2 = algebraMap ℚ_[2] _ r) : L = ℚ_[2]⟮w⟯ := by
      have hsq : IsSquare (a * r) := by
        simpa [mul_comm] using ((squareClass_eq_iff_isSquare_mul _ _).1 hr).map (Units.coeHom _)
      exact hLz.symm.trans
        (IntermediateField.adjoin_simple_eq_of_isSquare_mul hz hw ha r.ne_zero hsq)
    -- The square class of `a` is a sum of the classes of `-1`, `2` and `5`.
    have hc := padicTwoSquareClassBasis.sum_repr (squareClass (Units.mk0 a ha))
    rw [Fin.sum_univ_three, coe_padicTwoSquareClassBasis] at hc
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
      Matrix.tail_cons] at hc
    have h01 : ∀ t : ZMod 2, t = 0 ∨ t = 1 := by decide
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    rcases h01 (padicTwoSquareClassBasis.repr (squareClass (Units.mk0 a ha)) 0) with e₀ | e₀ <;>
    rcases h01 (padicTwoSquareClassBasis.repr (squareClass (Units.mk0 a ha)) 1) with e₁ | e₁ <;>
    rcases h01 (padicTwoSquareClassBasis.repr (squareClass (Units.mk0 a ha)) 2) with e₂ | e₂ <;>
    simp only [e₀, e₁, e₂, zero_smul, one_smul, zero_add, add_zero, ← squareClass_mul] at hc
    · -- The class of `1` gives `ℚ₂` itself, which has degree one.
      have h := (mem_totallyRamifiedOfDegree_iff.1 hL).1
      rw [← squareClass_one] at hc
      rw [hL_eq hc (w := 1) (by simp), IntermediateField.adjoin_one,
        IntermediateField.finrank_bot] at h
      omega
    · -- The class of `5` gives the unramified quadratic extension.
      obtain ⟨w, hw⟩ := IsSepClosed.exists_pow_nat_eq (5 : SeparableClosure ℚ_[2]) 2
      have h := eq_one_of_mem_totallyRamifiedOfDegree_of_le_maximalUnramifiedExtension hL
        ((hL_eq hc (w := w) (by simp [hw, map_ofNat])) ▸
          adjoin_le_maximalUnramifiedExtension_of_sq_eq_five hw)
      omega
    -- The classes of `2`, `10`, `-1`, `-5`, `-2` and `-10`.
    · rw [hL_eq hc (w := x₃) (by norm_num [h₃, map_ofNat])]; simp
    · rw [hL_eq hc (w := x₅) (by norm_num [h₅, map_ofNat])]; simp
    · rw [hL_eq hc (w := x₁) (by norm_num [h₁, map_ofNat])]; simp
    · rw [hL_eq hc (w := x₂) (by norm_num [h₂, map_ofNat])]; simp
    · rw [hL_eq hc (w := x₄) (by norm_num [h₄, map_ofNat])]; simp
    · rw [hL_eq hc (w := x₆) (by norm_num [h₆, map_ofNat])]; simp
  · have hu {x : SeparableClosure ℚ_[2]} {m : ℤ} (hm : ¬ (2 : ℤ) ∣ m) (hx : x ^ 2 = 1 - 2 * m) :
        ℚ_[2]⟮x⟯ ∈ totallyRamifiedOfDegree ℚ_[2] 2 :=
      adjoin_mem_totallyRamifiedOfDegree_two_of_sq_eq_one_sub
        (Padic.ringChar_residueField 2).dvd
        (Padic.irreducible_natCast_self_mul_intCast (p := 2) hm)
        (by simp [hx, coe_two_padicTwo, map_ofNat])
    have hr {x : SeparableClosure ℚ_[2]} {m : ℤ} (hm : ¬ (2 : ℤ) ∣ m) (hx : x ^ 2 = 2 * m) :
        ℚ_[2]⟮x⟯ ∈ totallyRamifiedOfDegree ℚ_[2] 2 :=
      adjoin_mem_totallyRamifiedOfDegree_of_pow_eq
        (Padic.irreducible_natCast_self_mul_intCast (p := 2) hm) two_pos
        (by simp [hx, coe_two_padicTwo, map_ofNat])
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨hu (m := 1) (by decide) (by rw [h₁]; norm_num),
      hu (m := 3) (by decide) (by rw [h₂]; norm_num),
      hr (m := 1) (by decide) (by rw [h₃]; norm_num),
      hr (m := -1) (by decide) (by rw [h₄]; norm_num),
      hr (m := 5) (by decide) (by rw [h₅]; norm_num),
      hr (m := -5) (by decide) (by rw [h₆]; norm_num)⟩

/-! ### The count and the mass formula -/

/-- The six members of `σ_{ℚ₂}(2)`, split into the two of wild exponent `1` and the four of wild
exponent `2`. -/
private theorem totallyRamifiedOfDegree_two_eq_union_padicTwo
    {x₁ x₂ x₃ x₄ x₅ x₆ : SeparableClosure ℚ_[2]}
    (h₁ : x₁ ^ 2 = -1) (h₂ : x₂ ^ 2 = -5) (h₃ : x₃ ^ 2 = 2) (h₄ : x₄ ^ 2 = -2)
    (h₅ : x₅ ^ 2 = 10) (h₆ : x₆ ^ 2 = -10) :
    totallyRamifiedOfDegree ℚ_[2] 2 =
      {ℚ_[2]⟮x₁⟯, ℚ_[2]⟮x₂⟯} ∪ {ℚ_[2]⟮x₃⟯, ℚ_[2]⟮x₄⟯, ℚ_[2]⟮x₅⟯, ℚ_[2]⟮x₆⟯} := by
  rw [totallyRamifiedOfDegree_two_eq_padicTwo h₁ h₂ h₃ h₄ h₅ h₆, Set.insert_union,
    Set.singleton_union]

/-- The six members of `σ_{ℚ₂}(2)` are pairwise distinct. -/
private theorem encard_pair_and_encard_four_and_disjoint_padicTwo
    {x₁ x₂ x₃ x₄ x₅ x₆ : SeparableClosure ℚ_[2]}
    (h₁ : x₁ ^ 2 = -1) (h₂ : x₂ ^ 2 = -5) (h₃ : x₃ ^ 2 = 2) (h₄ : x₄ ^ 2 = -2)
    (h₅ : x₅ ^ 2 = 10) (h₆ : x₆ ^ 2 = -10) :
    ({ℚ_[2]⟮x₁⟯, ℚ_[2]⟮x₂⟯} : Set (IntermediateField ℚ_[2] (SeparableClosure ℚ_[2]))).encard = 2 ∧
      ({ℚ_[2]⟮x₃⟯, ℚ_[2]⟮x₄⟯, ℚ_[2]⟮x₅⟯, ℚ_[2]⟮x₆⟯} :
        Set (IntermediateField ℚ_[2] (SeparableClosure ℚ_[2]))).encard = 4 ∧
      Disjoint ({ℚ_[2]⟮x₁⟯, ℚ_[2]⟮x₂⟯} : Set (IntermediateField ℚ_[2] (SeparableClosure ℚ_[2])))
        {ℚ_[2]⟮x₃⟯, ℚ_[2]⟮x₄⟯, ℚ_[2]⟮x₅⟯, ℚ_[2]⟮x₆⟯} := by
  have hσ := totallyRamifiedOfDegree_two_eq_padicTwo h₁ h₂ h₃ h₄ h₅ h₆
  have hb {x : SeparableClosure ℚ_[2]} (hx : ℚ_[2]⟮x⟯ ∈ totallyRamifiedOfDegree ℚ_[2] 2) :=
    notMem_bot_of_adjoin_mem_totallyRamifiedOfDegree (by decide) hx
  have h₁' : x₁ ^ 2 = ((-1 : ℤ) : SeparableClosure ℚ_[2]) := by rw [h₁]; norm_num
  have h₂' : x₂ ^ 2 = ((-5 : ℤ) : SeparableClosure ℚ_[2]) := by rw [h₂]; norm_num
  have h₃' : x₃ ^ 2 = ((2 : ℤ) : SeparableClosure ℚ_[2]) := by rw [h₃]; norm_num
  have h₄' : x₄ ^ 2 = ((-2 : ℤ) : SeparableClosure ℚ_[2]) := by rw [h₄]; norm_num
  have h₅' : x₅ ^ 2 = ((10 : ℤ) : SeparableClosure ℚ_[2]) := by rw [h₅]; norm_num
  have h₆' : x₆ ^ 2 = ((-10 : ℤ) : SeparableClosure ℚ_[2]) := by rw [h₆]; norm_num
  have h₁b := hb (x := x₁) (by rw [hσ]; simp)
  have h₂b := hb (x := x₂) (by rw [hσ]; simp)
  have h₃b := hb (x := x₃) (by rw [hσ]; simp)
  have h₄b := hb (x := x₄) (by rw [hσ]; simp)
  have h₅b := hb (x := x₅) (by rw [hσ]; simp)
  -- Every product of two of the radicands `-1, -5, 2, -2, 10, -10` is a nonsquare modulo `32`.
  have n12 := adjoin_ne_adjoin_padicTwo h₁' h₂' h₁b (by decide)
  have n13 := adjoin_ne_adjoin_padicTwo h₁' h₃' h₁b (by decide)
  have n14 := adjoin_ne_adjoin_padicTwo h₁' h₄' h₁b (by decide)
  have n15 := adjoin_ne_adjoin_padicTwo h₁' h₅' h₁b (by decide)
  have n16 := adjoin_ne_adjoin_padicTwo h₁' h₆' h₁b (by decide)
  have n23 := adjoin_ne_adjoin_padicTwo h₂' h₃' h₂b (by decide)
  have n24 := adjoin_ne_adjoin_padicTwo h₂' h₄' h₂b (by decide)
  have n25 := adjoin_ne_adjoin_padicTwo h₂' h₅' h₂b (by decide)
  have n26 := adjoin_ne_adjoin_padicTwo h₂' h₆' h₂b (by decide)
  have n34 := adjoin_ne_adjoin_padicTwo h₃' h₄' h₃b (by decide)
  have n35 := adjoin_ne_adjoin_padicTwo h₃' h₅' h₃b (by decide)
  have n36 := adjoin_ne_adjoin_padicTwo h₃' h₆' h₃b (by decide)
  have n45 := adjoin_ne_adjoin_padicTwo h₄' h₅' h₄b (by decide)
  have n46 := adjoin_ne_adjoin_padicTwo h₄' h₆' h₄b (by decide)
  have n56 := adjoin_ne_adjoin_padicTwo h₅' h₆' h₅b (by decide)
  refine ⟨Set.encard_pair n12, ?_, ?_⟩
  · rw [Set.encard_insert_of_notMem (by simp [n34, n35, n36]),
      Set.encard_insert_of_notMem (by simp [n45, n46]), Set.encard_pair n56]
    rfl
  · simp [n13.symm, n14.symm, n15.symm, n16.symm, n23.symm, n24.symm, n25.symm, n26.symm]

/-- Square roots of `-1`, `-5`, `2`, `-2`, `10` and `-10` in the separable closure of `ℚ₂`. -/
private theorem exists_sq_eq_padicTwo :
    ∃ x₁ x₂ x₃ x₄ x₅ x₆ : SeparableClosure ℚ_[2], x₁ ^ 2 = -1 ∧ x₂ ^ 2 = -5 ∧ x₃ ^ 2 = 2 ∧
      x₄ ^ 2 = -2 ∧ x₅ ^ 2 = 10 ∧ x₆ ^ 2 = -10 := by
  have : NeZero ((2 : ℕ) : SeparableClosure ℚ_[2]) :=
    NeZero.nat_of_injective (algebraMap ℚ_[2] (SeparableClosure ℚ_[2])).injective
  obtain ⟨x₁, h₁⟩ := IsSepClosed.exists_pow_nat_eq (-1 : SeparableClosure ℚ_[2]) 2
  obtain ⟨x₂, h₂⟩ := IsSepClosed.exists_pow_nat_eq (-5 : SeparableClosure ℚ_[2]) 2
  obtain ⟨x₃, h₃⟩ := IsSepClosed.exists_pow_nat_eq (2 : SeparableClosure ℚ_[2]) 2
  obtain ⟨x₄, h₄⟩ := IsSepClosed.exists_pow_nat_eq (-2 : SeparableClosure ℚ_[2]) 2
  obtain ⟨x₅, h₅⟩ := IsSepClosed.exists_pow_nat_eq (10 : SeparableClosure ℚ_[2]) 2
  obtain ⟨x₆, h₆⟩ := IsSepClosed.exists_pow_nat_eq (-10 : SeparableClosure ℚ_[2]) 2
  exact ⟨x₁, x₂, x₃, x₄, x₅, x₆, h₁, h₂, h₃, h₄, h₅, h₆⟩

/-- **`σ_{ℚ₂}(2)` has exactly six elements.** -/
theorem encard_totallyRamifiedOfDegree_two_padicTwo :
    (totallyRamifiedOfDegree ℚ_[2] 2).encard = 6 := by
  obtain ⟨x₁, x₂, x₃, x₄, x₅, x₆, h₁, h₂, h₃, h₄, h₅, h₆⟩ := exists_sq_eq_padicTwo
  obtain ⟨hA, hB, hd⟩ := encard_pair_and_encard_four_and_disjoint_padicTwo h₁ h₂ h₃ h₄ h₅ h₆
  rw [totallyRamifiedOfDegree_two_eq_union_padicTwo h₁ h₂ h₃ h₄ h₅ h₆, Set.encard_union_eq hd,
    hA, hB]
  rfl

/-- **Serre's mass formula for quadratic extensions of `ℚ₂`**:
`∑_{L ∈ σ_{ℚ₂}(2)} 2 ^ (-c(L)) = 2`. Two members have wild exponent `1` and four have wild
exponent `2`, so the sum is `2 · 2⁻¹ + 4 · 2⁻²`. -/
theorem tsum_one_div_two_pow_wildExponent_two_padicTwo :
    ∑' L : totallyRamifiedOfDegree ℚ_[2] 2, 1 / (2 : ℝ≥0∞) ^ L.1.wildExponent = 2 := by
  obtain ⟨x₁, x₂, x₃, x₄, x₅, x₆, h₁, h₂, h₃, h₄, h₅, h₆⟩ := exists_sq_eq_padicTwo
  obtain ⟨hA, hB, hd⟩ := encard_pair_and_encard_four_and_disjoint_padicTwo h₁ h₂ h₃ h₄ h₅ h₆
  have hu {x : SeparableClosure ℚ_[2]} {m : ℤ} (hm : ¬ (2 : ℤ) ∣ m) (hx : x ^ 2 = 1 - 2 * m) :
      (ℚ_[2]⟮x⟯).wildExponent = 1 :=
    wildExponent_adjoin_of_sq_eq_one_sub_padicTwo
      (Padic.irreducible_natCast_self_mul_intCast (p := 2) hm)
      (by simp [hx, coe_two_padicTwo, map_ofNat])
  have hr {x : SeparableClosure ℚ_[2]} {m : ℤ} (hm : ¬ (2 : ℤ) ∣ m) (hx : x ^ 2 = 2 * m) :
      (ℚ_[2]⟮x⟯).wildExponent = 2 :=
    wildExponent_adjoin_of_sq_eq_padicTwo (Padic.irreducible_natCast_self_mul_intCast (p := 2) hm)
      (by simp [hx, coe_two_padicTwo, map_ofNat])
  rw [totallyRamifiedOfDegree_two_eq_union_padicTwo h₁ h₂ h₃ h₄ h₅ h₆,
    Summable.tsum_union_disjoint (f := fun L ↦ 1 / (2 : ℝ≥0∞) ^ L.wildExponent) hd
      ENNReal.summable ENNReal.summable]
  -- The weight is constant on each of the two pieces.
  rw [tsum_congr (β := ↥({ℚ_[2]⟮x₁⟯, ℚ_[2]⟮x₂⟯} : Set (IntermediateField ℚ_[2] _)))
      (g := fun _ ↦ (1 / 2 ^ 1 : ℝ≥0∞)) ?_,
    tsum_congr (β := ↥({ℚ_[2]⟮x₃⟯, ℚ_[2]⟮x₄⟯, ℚ_[2]⟮x₅⟯, ℚ_[2]⟮x₆⟯} :
      Set (IntermediateField ℚ_[2] _))) (g := fun _ ↦ (1 / 2 ^ 2 : ℝ≥0∞)) ?_,
    ENNReal.tsum_set_const, ENNReal.tsum_set_const, hA, hB]
  · have h4 : (4 : ℝ≥0∞) = 2 ^ 2 := by norm_num
    simp only [ENat.toENNReal_ofNat, pow_one, h4, one_div]
    rw [ENNReal.mul_inv_cancel (by norm_num) (by norm_num),
      ENNReal.mul_inv_cancel (by simp) (by simp)]
    norm_num
  · rintro ⟨L, hL⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hL
    rcases hL with rfl | rfl | rfl | rfl
    · rw [hr (m := 1) (by decide) (by rw [h₃]; norm_num)]
    · rw [hr (m := -1) (by decide) (by rw [h₄]; norm_num)]
    · rw [hr (m := 5) (by decide) (by rw [h₅]; norm_num)]
    · rw [hr (m := -5) (by decide) (by rw [h₆]; norm_num)]
  · rintro ⟨L, hL⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hL
    rcases hL with rfl | rfl
    · rw [hu (m := 1) (by decide) (by rw [h₁]; norm_num)]
    · rw [hu (m := 3) (by decide) (by rw [h₂]; norm_num)]

end TauCeti
