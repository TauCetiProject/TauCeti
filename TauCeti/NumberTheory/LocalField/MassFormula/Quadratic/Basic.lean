/-!
# The totally ramified quadratic extensions in odd residue characteristic

Let `K` be a nonarchimedean local field whose residue characteristic is not `2`. This file
determines `σ_K(2) = totallyRamifiedOfDegree K 2` explicitly, independently of Serre's mass
formula: for a uniformizer `ϖ` of `K` and a unit `u` of `𝒪[K]` that is not a square,

`σ_K(2) = {K(√ϖ), K(√(u ϖ))}`,

and these two fields are distinct. Both have wild exponent `0`, so the mass formula
`∑_{L ∈ σ_K(2)} q ^ (-c(L)) = 2` holds in this case. This is the smallest instance of the tame
count `#σ_K(n) = n`, and for `K = ℚ_p` with `p` odd it is the classical list `ℚ_p(√p)`,
`ℚ_p(√(u p))`.

The proof runs through the four square classes `1`, `u`, `ϖ`, `u ϖ` of `K`. A quadratic
subextension is `K(√a)` for some `a ∈ Kˣ`, and it depends only on the square class of `a`. The
class `1` gives `K` itself. The class `u` gives a subfield of the maximal unramified extension,
since square roots of units are unramified away from residue characteristic two, and an unramified
member of `σ_K(n)` has `n = 1`. The classes `ϖ` and `u ϖ` give the two fields above, generated by
roots of the Eisenstein polynomials `X ^ 2 - ϖ` and `X ^ 2 - u ϖ`.

## Main results

* `TauCeti.totallyRamifiedOfDegree_two_eq`: `σ_K(2) = {K(√ϖ), K(√(u ϖ))}` in odd residue
  characteristic.
* `TauCeti.adjoin_ne_adjoin_of_sq_eq_of_sq_eq_mul`: the two fields are distinct whenever
  `2 ≠ 0` in `K`.
* `TauCeti.encard_totallyRamifiedOfDegree_two`: `σ_K(2)` has exactly two elements.
* `TauCeti.tsum_one_div_natCard_residueField_pow_wildExponent_two`: Serre's mass formula for
  `n = 2` in odd residue characteristic.
* `TauCeti.Padic.totallyRamifiedOfDegree_two_eq` and
  `TauCeti.Padic.tsum_one_div_pow_wildExponent_two`: the same for `ℚ_p` with `p` odd, where
  `σ_{ℚ_p}(2) = {ℚ_p(√p), ℚ_p(√(u p))}`.

## References

* J.-P. Serre, *Une « formule de masse » pour les extensions totalement ramifiées de degré donné
  d'un corps local*, C. R. Acad. Sci. Paris Sér. A **286** (1978), 1031–1036.
* J.-P. Serre, *A Course in Arithmetic*, Chapter II, §3, for the square classes of `ℚ_p`.
-/

public section
noncomputable section

open ValuativeRel Polynomial
open scoped IntermediateField ENNReal

namespace TauCeti

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

/-- **The two fields `K(√ϖ)` and `K(√(u ϖ))` are distinct** when `2 ≠ 0` in `K` and `u` is a unit
of `𝒪[K]` that is not a square: equality would make `ϖ · u ϖ`, hence `u`, a square. -/
theorem adjoin_ne_adjoin_of_sq_eq_of_sq_eq_mul [NeZero (2 : K)] {ϖ : 𝒪[K]}
    (hϖ : Irreducible ϖ) (u : 𝒪[K]ˣ) (hu : ¬ IsSquare ((u : 𝒪[K]) : K))
    {x y : SeparableClosure K} (hx : x ^ 2 = algebraMap K (SeparableClosure K) ϖ)
    (hy : y ^ 2 = algebraMap K (SeparableClosure K) ((u : 𝒪[K]) * ϖ : 𝒪[K])) :
    K⟮x⟯ ≠ K⟮y⟯ := by
  intro hxy
  -- `x ∉ K`, since `K(x)` has degree two.
  have hxb : x ∉ (⊥ : IntermediateField K (SeparableClosure K)) := by
    rw [← IntermediateField.adjoin_simple_eq_bot_iff]
    intro hbot
    have h := (mem_totallyRamifiedOfDegree_iff.1
      (adjoin_mem_totallyRamifiedOfDegree_of_pow_eq hϖ two_pos hx)).1
    rw [hbot, IntermediateField.finrank_bot] at h
    omega
  obtain ⟨t, ht⟩ := IntermediateField.isSquare_mul_of_adjoin_simple_eq hx hy hxb hxy
  have hϖ0 : (ϖ : K) ≠ 0 := fun h ↦ hϖ.ne_zero (Subtype.ext h)
  refine hu ⟨t / ϖ, ?_⟩
  field_simp
  push_cast at ht
  linear_combination ht

/-- **The totally ramified quadratic extensions in odd residue characteristic.** Let `ϖ` be a
uniformizer of `K` and `u` a unit of `𝒪[K]` that is not a square, and let `x` and `y` be square
roots of `ϖ` and `u ϖ` in the separable closure. If the residue characteristic of `K` is not `2`,
then `σ_K(2) = {K(x), K(y)}`. -/
theorem totallyRamifiedOfDegree_two_eq (h2 : ¬ ringChar 𝓀[K] ∣ 2) {ϖ : 𝒪[K]}
    (hϖ : Irreducible ϖ) (u : 𝒪[K]ˣ) (hu : ¬ IsSquare ((u : 𝒪[K]) : K))
    {x y : SeparableClosure K} (hx : x ^ 2 = algebraMap K (SeparableClosure K) ϖ)
    (hy : y ^ 2 = algebraMap K (SeparableClosure K) ((u : 𝒪[K]) * ϖ : 𝒪[K])) :
    totallyRamifiedOfDegree K 2 = {K⟮x⟯, K⟮y⟯} := by
  have huϖ : Irreducible ((u : 𝒪[K]) * ϖ) := (Associated.irreducible ⟨u, mul_comm _ _⟩ hϖ)
  refine Set.Subset.antisymm (fun L hL ↦ ?_) (Set.insert_subset
    (adjoin_mem_totallyRamifiedOfDegree_of_pow_eq hϖ two_pos hx)
    (Set.singleton_subset_iff.2 (adjoin_mem_totallyRamifiedOfDegree_of_pow_eq huϖ two_pos hy)))
  have h2' : IsUnit (2 : 𝒪[K]) := by simpa using IsLocalRing.isUnit_natCast_iff_not_dvd.2 h2
  have : NeZero (2 : K) := ⟨two_ne_zero_of_isUnit_two h2'⟩
  have : NeZero ((2 : ℕ) : SeparableClosure K) :=
    NeZero.nat_of_injective (algebraMap K (SeparableClosure K)).injective
  -- `L = K(z)` with `z ^ 2 = a` for some nonzero `a ∈ K`.
  obtain ⟨z, -, hzb, ⟨a, hz⟩, hLz⟩ :=
    IntermediateField.exists_sq_mem_range_adjoin_simple_eq_of_finrank_eq_two
      (mem_totallyRamifiedOfDegree_iff.1 hL).1
  have ha : a ≠ 0 := by
    rintro rfl
    have hz0 : z = 0 := by simpa using hz
    exact hzb (hz0 ▸ zero_mem _)
  -- The square class of `a` is that of `1`, `u`, `ϖ` or `u ϖ`.
  let π : Kˣ := Units.mk0 (ϖ : K) fun h ↦ hϖ.ne_zero (Subtype.ext h)
  have hπ : IsUniformizer K π := (isUniformizer_iff_exists_irreducible K π).2 ⟨ϖ, hϖ, rfl⟩
  let uK : Kˣ := Units.map (Subring.subtype 𝒪[K] : 𝒪[K] →* K) u
  have huK : Even (normalizedValuation K uK).toAdd := by
    rw [normalizedValuation_integerUnits]
    exact ⟨0, by simp⟩
  have huK' : ¬ IsSquare uK := fun h ↦ hu (isSquare_units_val_iff.2 h)
  obtain ⟨r, hr, hsq⟩ := exists_isSquare_mul_of_isUnit_two h2' hπ huK huK'
    (Units.mk0 a ha)
  have hsq' : IsSquare (a * (r : K)) := by simpa using hsq.map (Units.coeHom K)
  -- A square root `w` of `r` generates the same field as `z`.
  have hL_eq {w : SeparableClosure K} (hw : w ^ 2 = algebraMap K (SeparableClosure K) r) :
      L = K⟮w⟯ :=
    hLz.symm.trans (IntermediateField.adjoin_simple_eq_of_isSquare_mul hz hw ha r.ne_zero hsq')
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hr ⊢
  rcases hr with rfl | rfl | rfl | rfl
  · -- The class of `1` gives `K` itself, which has degree one.
    have h := (mem_totallyRamifiedOfDegree_iff.1 hL).1
    rw [hL_eq (w := 1) (by simp), IntermediateField.adjoin_one, IntermediateField.finrank_bot] at h
    omega
  · -- The class of `u` gives an unramified field.
    obtain ⟨w, hw⟩ := IsSepClosed.exists_pow_nat_eq (algebraMap K (SeparableClosure K) uK) 2
    have hwu : w ∈ maximalUnramifiedExtension K (SeparableClosure K) :=
      mem_maximalUnramifiedExtension_of_pow_eq (by exact_mod_cast h2)
        (mem_unitFiltration_iff_exists.2 ⟨u, by simp, rfl⟩) hw
    have h := eq_one_of_mem_totallyRamifiedOfDegree_of_le_maximalUnramifiedExtension hL
      (hL_eq hw ▸ IntermediateField.adjoin_simple_le_iff.2 hwu)
    omega
  · exact Or.inl (hL_eq hx)
  · exact Or.inr (hL_eq (by rw [hy]; simp [uK, π, mul_comm]))

/-- **`σ_K(2)` has exactly two elements** when the residue characteristic of `K` is not `2`. -/
theorem encard_totallyRamifiedOfDegree_two (h2 : ¬ ringChar 𝓀[K] ∣ 2) :
    (totallyRamifiedOfDegree K 2).encard = 2 := by
  have h2' : IsUnit (2 : 𝒪[K]) := by simpa using IsLocalRing.isUnit_natCast_iff_not_dvd.2 h2
  have : NeZero (2 : K) := ⟨two_ne_zero_of_isUnit_two h2'⟩
  have : NeZero ((2 : ℕ) : SeparableClosure K) :=
    NeZero.nat_of_injective (algebraMap K (SeparableClosure K)).injective
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[K]
  obtain ⟨u, hu⟩ := exists_integerUnit_not_isSquare_residue h2'
  have hu' : ¬ IsSquare ((u : 𝒪[K]) : K) := fun h ↦
    hu ((isSquare_unitsMap_subtype_iff h2' u).1 (isSquare_units_val_iff.1 h))
  obtain ⟨x, hx⟩ := IsSepClosed.exists_pow_nat_eq (algebraMap K (SeparableClosure K) ϖ) 2
  obtain ⟨y, hy⟩ := IsSepClosed.exists_pow_nat_eq
    (algebraMap K (SeparableClosure K) ((u : 𝒪[K]) * ϖ : 𝒪[K])) 2
  rw [totallyRamifiedOfDegree_two_eq h2 hϖ u hu' hx hy,
    Set.encard_pair (adjoin_ne_adjoin_of_sq_eq_of_sq_eq_mul hϖ u hu' hx hy)]

/-- **Serre's mass formula for quadratic extensions in odd residue characteristic**:
`∑_{L ∈ σ_K(2)} q ^ (-c(L)) = 2`, where `q` is the cardinality of the residue field of `K`. Both
members of `σ_K(2)` are tamely ramified, with weight `1`. -/
theorem tsum_one_div_natCard_residueField_pow_wildExponent_two (h2 : ¬ ringChar 𝓀[K] ∣ 2) :
    ∑' L : totallyRamifiedOfDegree K 2, 1 / (Nat.card 𝓀[K] : ℝ≥0∞) ^ L.1.wildExponent = 2 := by
  rw [tsum_one_div_natCard_residueField_pow_wildExponent_eq_encard h2,
    encard_totallyRamifiedOfDegree_two h2]
  norm_num

namespace Padic

variable {p : ℕ} [Fact p.Prime]

/-- **The totally ramified quadratic extensions of `ℚ_p`** for an odd prime `p`: if `u` is a unit
of the ring of integers of `ℚ_p` that is not a square, and `x` and `y` are square roots of `p` and
`u p` in the separable closure, then `σ_{ℚ_p}(2) = {ℚ_p(x), ℚ_p(y)}`. -/
theorem totallyRamifiedOfDegree_two_eq (hp : p ≠ 2) (u : 𝒪[ℚ_[p]]ˣ)
    (hu : ¬ IsSquare ((u : 𝒪[ℚ_[p]]) : ℚ_[p])) {x y : SeparableClosure ℚ_[p]}
    (hx : x ^ 2 = p) (hy : y ^ 2 = algebraMap ℚ_[p] (SeparableClosure ℚ_[p]) (u * p)) :
    totallyRamifiedOfDegree ℚ_[p] 2 = {ℚ_[p]⟮x⟯, ℚ_[p]⟮y⟯} := by
  have h2 : ¬ ringChar 𝓀[ℚ_[p]] ∣ 2 := IsLocalRing.isUnit_natCast_iff_not_dvd.1
    (by exact_mod_cast _root_.Padic.isUnit_two_integerRing hp)
  exact TauCeti.totallyRamifiedOfDegree_two_eq h2 (irreducible_natCast_self p) u hu
    (by simp [hx]) (by simp [hy])

/-- **Serre's mass formula for quadratic extensions of `ℚ_p`** for an odd prime `p`:
`∑_{L ∈ σ_{ℚ_p}(2)} p ^ (-c(L)) = 2`. -/
theorem tsum_one_div_pow_wildExponent_two (hp : p ≠ 2) :
    ∑' L : totallyRamifiedOfDegree ℚ_[p] 2, 1 / (p : ℝ≥0∞) ^ L.1.wildExponent = 2 := by
  have h2 : ¬ ringChar 𝓀[ℚ_[p]] ∣ 2 := IsLocalRing.isUnit_natCast_iff_not_dvd.1
    (by exact_mod_cast _root_.Padic.isUnit_two_integerRing hp)
  simpa using TauCeti.tsum_one_div_natCard_residueField_pow_wildExponent_two h2

end Padic

end TauCeti
