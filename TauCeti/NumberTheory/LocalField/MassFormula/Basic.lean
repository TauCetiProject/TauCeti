module

public import Mathlib.FieldTheory.SeparableClosure
public import TauCeti.NumberTheory.LocalField.Discriminant.Basic
public import TauCeti.NumberTheory.LocalField.FiniteExtension.IntermediateField
public import TauCeti.NumberTheory.LocalField.Unramified.Maximal

/-!
# The totally ramified extensions of given degree and their wild exponents

Let `K` be a nonarchimedean local field with residue field `𝓀[K]`. Serre's mass formula counts the
totally ramified extensions of `K` of degree `n` inside a fixed separable closure, each weighted by
`q ^ (-c(L))`, where `q = Nat.card 𝓀[K]`, `d(L)` is the discriminant exponent of `L / K` and
`c(L) = d(L) - n + 1` is its *wild exponent*. This file sets up the objects being counted.

A subextension `L` of `SeparableClosure K` carries no topology or valuation of its own. When `L / K`
is finite, the structures `finiteIntermediateFieldValuativeRel` and
`finiteIntermediateFieldTopology` make it a nonarchimedean local field extending `K`, and
`IsTotallyRamified` and `discriminantExponent` apply. The two wrappers below install these
structures and extend total ramification and the discriminant exponent to arbitrary subextensions,
taking junk values (`False` and `0`) when `L / K` is infinite; the comparison theorems
`IntermediateField.isTotallyRamified_iff` and `IntermediateField.discriminantExponent_eq` identify
them with the canonical invariants on finite subextensions. The wrappers and the wild exponent live
in the `IntermediateField` namespace, so that they are available as `L.IsTotallyRamified`,
`L.discriminantExponent` and `L.wildExponent`.

Working inside `SeparableClosure K` matters in equal characteristic `p`: it excludes inseparable
extensions such as those generated by a root of `X ^ p - π`.

## Main definitions

* `IntermediateField.IsTotallyRamified L`: `L / K` is finite and totally ramified.
* `TauCeti.totallyRamifiedOfDegree K n`: Serre's `σ_K(n)`, the subextensions of
  `SeparableClosure K` that are totally ramified of degree `n` over `K`.
* `IntermediateField.discriminantExponent L`: the discriminant exponent `d(L)` of a finite
  subextension, `0` for an infinite one.
* `IntermediateField.wildExponent L`: the wild exponent `c(L) = d(L) + 1 - [L : K]`.

## Main results

* `TauCeti.totallyRamifiedOfDegree_zero` and `TauCeti.totallyRamifiedOfDegree_one`:
  `σ_K(0) = ∅` and `σ_K(1) = {K}`, where `K` has `d = c = 0`.
* `TauCeti.eq_one_of_mem_totallyRamifiedOfDegree_of_le_maximalUnramifiedExtension`: a member of
  `σ_K(n)` inside the maximal unramified extension has `n = 1`.
* `IntermediateField.sub_one_le_discriminantExponent`: `n - 1 ≤ d(L)` for `L ∈ σ_K(n)`, so the
  truncated subtraction in `wildExponent` is faithful: `IntermediateField.natCast_wildExponent`
  reads `c(L) = d(L) - n + 1` in `ℤ`.
* `IntermediateField.wildExponent_eq_zero_iff`: for `L ∈ σ_K(n)`, `c(L) = 0` exactly when the
  residue characteristic does not divide `n`, the tame criterion.
* `IntermediateField.discriminantExponent_eq_of_algEquiv` and
  `IntermediateField.wildExponent_eq_of_algEquiv`: `d` and `c` are invariants of the
  `K`-isomorphism class.

## References

* J.-P. Serre, *Une « formule de masse » pour les extensions totalement ramifiées de degré donné
  d'un corps local*, C. R. Acad. Sci. Paris Sér. A **286** (1978), 1031–1036.
* J.-P. Serre, *Local Fields*, Chapter III, §§3 and 6.
-/

public section
noncomputable section

open ValuativeRel

namespace TauCeti

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

/-- A subextension `L` of `SeparableClosure K` is totally ramified over `K` when it is finite over
`K` and, with the local-field structure `finiteIntermediateFieldValuativeRel` and
`finiteIntermediateFieldTopology`, it satisfies `IsTotallyRamified K L`. For `L` infinite over `K`
this is `False`. -/
def _root_.IntermediateField.IsTotallyRamified (L : IntermediateField K (SeparableClosure K)) :
    Prop :=
  ∃ _ : Module.Finite K L,
    letI := finiteIntermediateFieldValuativeRel K (SeparableClosure K) L
    letI := finiteIntermediateFieldTopology K (SeparableClosure K) L
    haveI := finiteIntermediateField_isNonarchimedeanLocalField K (SeparableClosure K) L
    TauCeti.IsTotallyRamified K L

/-- On a finite subextension, `IntermediateField.IsTotallyRamified` is `IsTotallyRamified` for the
local-field structure `finiteIntermediateFieldValuativeRel` and
`finiteIntermediateFieldTopology`. -/
theorem _root_.IntermediateField.isTotallyRamified_iff
    (L : IntermediateField K (SeparableClosure K)) [hfin : Module.Finite K L] :
    L.IsTotallyRamified ↔
      (letI := finiteIntermediateFieldValuativeRel K (SeparableClosure K) L
      letI := finiteIntermediateFieldTopology K (SeparableClosure K) L
      haveI := finiteIntermediateField_isNonarchimedeanLocalField K (SeparableClosure K) L
      TauCeti.IsTotallyRamified K L) :=
  ⟨fun ⟨_, h⟩ ↦ h, fun h ↦ ⟨hfin, h⟩⟩

/-- A totally ramified subextension is finite over `K`. -/
theorem _root_.IntermediateField.IsTotallyRamified.finite
    {L : IntermediateField K (SeparableClosure K)} (h : L.IsTotallyRamified) :
    Module.Finite K L :=
  h.1

variable (K) in
/-- Serre's `σ_K(n)`: the subextensions of `SeparableClosure K` that are totally ramified of
degree `n` over `K`. -/
def totallyRamifiedOfDegree (n : ℕ) : Set (IntermediateField K (SeparableClosure K)) :=
  {L | Module.finrank K L = n ∧ L.IsTotallyRamified}

/-- Membership in `σ_K(n)`: degree `n` and totally ramified over `K`. -/
@[simp]
theorem mem_totallyRamifiedOfDegree_iff {n : ℕ} {L : IntermediateField K (SeparableClosure K)} :
    L ∈ totallyRamifiedOfDegree K n ↔
      Module.finrank K L = n ∧ L.IsTotallyRamified :=
  Iff.rfl

/-- `σ_K(0)` is empty: a finite extension has positive degree. -/
@[simp]
theorem totallyRamifiedOfDegree_zero : totallyRamifiedOfDegree K 0 = ∅ := by
  refine Set.eq_empty_of_forall_notMem fun L ⟨hn, h⟩ ↦ ?_
  have := h.finite
  exact Module.finrank_pos.ne' hn

/-- `σ_K(1) = {K}`: the only subextension of degree one is the bottom one, and it is totally
ramified. -/
@[simp]
theorem totallyRamifiedOfDegree_one : totallyRamifiedOfDegree K 1 = {⊥} := by
  ext L
  rw [mem_totallyRamifiedOfDegree_iff, Set.mem_singleton_iff, IntermediateField.finrank_eq_one_iff]
  refine ⟨And.left, ?_⟩
  rintro rfl
  refine ⟨rfl, (IntermediateField.isTotallyRamified_iff _).2 ?_⟩
  let _ := finiteIntermediateFieldValuativeRel K (SeparableClosure K) ⊥
  let _ := finiteIntermediateFieldTopology K (SeparableClosure K) ⊥
  have := finiteIntermediateField_isNonarchimedeanLocalField K (SeparableClosure K) ⊥
  have := finiteIntermediateField_valuativeExtension K (SeparableClosure K) ⊥
  have h := ramificationIndex_mul_inertiaDegree K (⊥ : IntermediateField K (SeparableClosure K))
  rw [IntermediateField.finrank_bot] at h
  rw [isTotallyRamified_iff_ramificationIndex_eq_finrank, IntermediateField.finrank_bot]
  exact Nat.eq_one_of_mul_eq_one_right h

/-- **An unramified member of `σ_K(n)` has degree one.** A member of `σ_K(n)` contained in the
maximal unramified extension of `K` is both unramified and totally ramified over `K`, so its
degree `n` is its ramification index `1`. -/
theorem eq_one_of_mem_totallyRamifiedOfDegree_of_le_maximalUnramifiedExtension {n : ℕ}
    {L : IntermediateField K (SeparableClosure K)} (hL : L ∈ totallyRamifiedOfDegree K n)
    (hle : L ≤ maximalUnramifiedExtension K (SeparableClosure K)) : n = 1 := by
  obtain ⟨rfl, htr⟩ := mem_totallyRamifiedOfDegree_iff.1 hL
  have := htr.finite
  let _ := finiteIntermediateFieldValuativeRel K (SeparableClosure K) L
  let _ := finiteIntermediateFieldTopology K (SeparableClosure K) L
  have := finiteIntermediateField_isNonarchimedeanLocalField K (SeparableClosure K) L
  have := finiteIntermediateField_valuativeExtension K (SeparableClosure K) L
  rw [← (isTotallyRamified_iff_ramificationIndex_eq_finrank K L).1
    (L.isTotallyRamified_iff.1 htr)]
  exact (isUnramified_iff_ramificationIndex_eq_one K L).1
    (L.le_maximalUnramifiedExtension_iff.1 hle)

open Classical in
/-- The discriminant exponent `d(L)` of a subextension `L` of `SeparableClosure K`: for `L / K`
finite, `discriminantExponent K L` for the local-field structure
`finiteIntermediateFieldValuativeRel` and `finiteIntermediateFieldTopology`; for `L / K` infinite,
the junk value `0`. -/
def _root_.IntermediateField.discriminantExponent
    (L : IntermediateField K (SeparableClosure K)) : ℕ :=
  if _ : Module.Finite K L then
    letI := finiteIntermediateFieldValuativeRel K (SeparableClosure K) L
    letI := finiteIntermediateFieldTopology K (SeparableClosure K) L
    haveI := finiteIntermediateField_isNonarchimedeanLocalField K (SeparableClosure K) L
    haveI := finiteIntermediateField_valuativeExtension K (SeparableClosure K) L
    TauCeti.discriminantExponent K L
  else 0

/-- On a finite subextension, `IntermediateField.discriminantExponent` is `discriminantExponent`
for the local-field structure `finiteIntermediateFieldValuativeRel` and
`finiteIntermediateFieldTopology`. -/
theorem _root_.IntermediateField.discriminantExponent_eq
    (L : IntermediateField K (SeparableClosure K)) [hfin : Module.Finite K L] :
    L.discriminantExponent =
      (letI := finiteIntermediateFieldValuativeRel K (SeparableClosure K) L
      letI := finiteIntermediateFieldTopology K (SeparableClosure K) L
      haveI := finiteIntermediateField_isNonarchimedeanLocalField K (SeparableClosure K) L
      haveI := finiteIntermediateField_valuativeExtension K (SeparableClosure K) L
      TauCeti.discriminantExponent K L) :=
  dite_eq_left hfin

/-- On an infinite subextension, `IntermediateField.discriminantExponent` takes the junk value
`0`. -/
theorem _root_.IntermediateField.discriminantExponent_of_not_finite
    {L : IntermediateField K (SeparableClosure K)} (h : ¬ Module.Finite K L) :
    L.discriminantExponent = 0 :=
  dite_eq_right h

/-- The wild exponent `c(L) = d(L) - [L : K] + 1` of a subextension `L` of `SeparableClosure K`,
written `d(L) + 1 - [L : K]` in truncated subtraction. For `L ∈ σ_K(n)` the truncation is
faithful by `IntermediateField.sub_one_le_discriminantExponent`, and `c(L)` is Serre's nonnegative
integer `d(L) - n + 1`. -/
def _root_.IntermediateField.wildExponent (L : IntermediateField K (SeparableClosure K)) : ℕ :=
  L.discriminantExponent + 1 - Module.finrank K L

/-- The defining equation of `wildExponent`, valid for every subextension: `c(L)` is
`d(L) + 1 - [L : K]` in truncated subtraction. -/
theorem _root_.IntermediateField.wildExponent_def (L : IntermediateField K (SeparableClosure K)) :
    L.wildExponent = L.discriminantExponent + 1 - Module.finrank K L := by
  rw [IntermediateField.wildExponent]

/-- **The discriminant bound for `σ_K(n)`**: the discriminant exponent of a totally ramified
extension of degree `n` is at least `n - 1`. This is
`ramificationIndex_sub_one_le_discriminantExponent` with `e(L / K) = n`. -/
theorem _root_.IntermediateField.sub_one_le_discriminantExponent {n : ℕ}
    {L : IntermediateField K (SeparableClosure K)} (hL : L ∈ totallyRamifiedOfDegree K n) :
    n - 1 ≤ L.discriminantExponent := by
  obtain ⟨rfl, hfin, htr⟩ := hL
  rw [IntermediateField.discriminantExponent_eq]
  let _ := finiteIntermediateFieldValuativeRel K (SeparableClosure K) L
  let _ := finiteIntermediateFieldTopology K (SeparableClosure K) L
  have := finiteIntermediateField_isNonarchimedeanLocalField K (SeparableClosure K) L
  have := finiteIntermediateField_valuativeExtension K (SeparableClosure K) L
  rw [← (isTotallyRamified_iff_ramificationIndex_eq_finrank K L).1 htr]
  exact ramificationIndex_sub_one_le_discriminantExponent K L

/-- For `L ∈ σ_K(n)`, the wild exponent is `d(L) - n + 1` in `ℤ`. -/
theorem _root_.IntermediateField.natCast_wildExponent {n : ℕ}
    {L : IntermediateField K (SeparableClosure K)} (hL : L ∈ totallyRamifiedOfDegree K n) :
    (L.wildExponent : ℤ) = L.discriminantExponent - n + 1 := by
  have := IntermediateField.sub_one_le_discriminantExponent hL
  rw [IntermediateField.wildExponent, hL.1]
  omega

/-- **The tame criterion for `σ_K(n)`**: for `L ∈ σ_K(n)`, the wild exponent vanishes exactly when
the residue characteristic of `K` does not divide `n`. Since `L / K` is totally ramified, `d(L)` is
the different exponent, so this is `differentExponent_eq_ramificationIndex_sub_one_iff`. -/
theorem _root_.IntermediateField.wildExponent_eq_zero_iff {n : ℕ}
    {L : IntermediateField K (SeparableClosure K)} (hL : L ∈ totallyRamifiedOfDegree K n) :
    L.wildExponent = 0 ↔ ¬ ringChar 𝓀[K] ∣ n := by
  have hle := IntermediateField.sub_one_le_discriminantExponent hL
  obtain ⟨rfl, hfin, htr⟩ := hL
  rw [IntermediateField.wildExponent, Nat.sub_eq_zero_iff_le]
  rw [IntermediateField.discriminantExponent_eq] at hle ⊢
  let _ := finiteIntermediateFieldValuativeRel K (SeparableClosure K) L
  let _ := finiteIntermediateFieldTopology K (SeparableClosure K) L
  have := finiteIntermediateField_isNonarchimedeanLocalField K (SeparableClosure K) L
  have := finiteIntermediateField_valuativeExtension K (SeparableClosure K) L
  have he := (isTotallyRamified_iff_ramificationIndex_eq_finrank K L).1 htr
  rw [discriminantExponent_eq_inertiaDegree_mul_differentExponent,
    htr.inertiaDegree_eq_one, one_mul] at hle ⊢
  rw [← he, ← isTamelyRamified_iff, ← differentExponent_eq_ramificationIndex_sub_one_iff]
  rw [← he] at hle
  have hpos : 0 < ramificationIndex K L := ramificationIndex_pos
  constructor <;> intro <;> omega

/-- The bottom subextension has wild exponent `0`. -/
@[simp]
theorem _root_.IntermediateField.wildExponent_bot :
    (⊥ : IntermediateField K (SeparableClosure K)).wildExponent = 0 :=
  (IntermediateField.wildExponent_eq_zero_iff (n := 1) (by simp)).2 <| by
    rw [Nat.dvd_one]
    exact CharP.ringChar_ne_one

/-- The bottom subextension has discriminant exponent `0`. -/
@[simp]
theorem _root_.IntermediateField.discriminantExponent_bot :
    (⊥ : IntermediateField K (SeparableClosure K)).discriminantExponent = 0 := by
  have h := IntermediateField.wildExponent_bot (K := K)
  rwa [IntermediateField.wildExponent, IntermediateField.finrank_bot, Nat.add_sub_cancel] at h

/-- **The discriminant exponent is an invariant of the `K`-isomorphism class**, junk case
included: this is `discriminantExponent_eq_of_algEquiv` when `L / K` is finite, and both sides are
`0` otherwise. -/
theorem _root_.IntermediateField.discriminantExponent_eq_of_algEquiv
    {L M : IntermediateField K (SeparableClosure K)} (e : L ≃ₐ[K] M) :
    L.discriminantExponent = M.discriminantExponent := by
  by_cases hL : Module.Finite K L
  · have : Module.Finite K M := Module.Finite.equiv e.toLinearEquiv
    rw [IntermediateField.discriminantExponent_eq, IntermediateField.discriminantExponent_eq]
    let _ := finiteIntermediateFieldValuativeRel K (SeparableClosure K) L
    let _ := finiteIntermediateFieldTopology K (SeparableClosure K) L
    have := finiteIntermediateField_isNonarchimedeanLocalField K (SeparableClosure K) L
    have := finiteIntermediateField_valuativeExtension K (SeparableClosure K) L
    let _ := finiteIntermediateFieldValuativeRel K (SeparableClosure K) M
    let _ := finiteIntermediateFieldTopology K (SeparableClosure K) M
    have := finiteIntermediateField_isNonarchimedeanLocalField K (SeparableClosure K) M
    have := finiteIntermediateField_valuativeExtension K (SeparableClosure K) M
    exact TauCeti.discriminantExponent_eq_of_algEquiv K L M e
  · rw [IntermediateField.discriminantExponent_of_not_finite hL,
      IntermediateField.discriminantExponent_of_not_finite
        fun h ↦ hL (Module.Finite.equiv e.symm.toLinearEquiv)]

/-- **The wild exponent is an invariant of the `K`-isomorphism class**, junk case included. -/
theorem _root_.IntermediateField.wildExponent_eq_of_algEquiv
    {L M : IntermediateField K (SeparableClosure K)} (e : L ≃ₐ[K] M) :
    L.wildExponent = M.wildExponent := by
  rw [IntermediateField.wildExponent, IntermediateField.wildExponent,
    IntermediateField.discriminantExponent_eq_of_algEquiv e,
    e.toLinearEquiv.finrank_eq]

end TauCeti
