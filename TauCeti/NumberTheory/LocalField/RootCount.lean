/-!
# Local constancy of root counts over a nonarchimedean local field

Let `K` be a nonarchimedean local field and `f` a monic polynomial over `𝒪[K]` that is separable
over `K`. This file proves that the number of roots of `f` in a finite extension `L` of `K` does
not change when the coefficients of `f` are perturbed slightly, and that one threshold for the
size of the perturbation works for all finite extensions at once: there is `T > 0` such that every
monic `g` over `𝒪[K]` with `g.coeff i - f.coeff i ∈ 𝓂[K] ^ T` for all `i` has exactly as many roots
as `f`, counted with multiplicity, in every finite intermediate field of a fixed extension `Ω / K`
(for instance a separable closure of `K`).

This is the form of continuity of roots needed to count extensions by integrating over coefficient
space, as in Serre's mass formula: the root count is then a locally constant function of the
coefficients near a separable polynomial. It is a statement about counts, uniform over all finite
extensions; Krasner's lemma, by contrast, compares the fields generated by single roots.

## Main results

* `TauCeti.card_aroots_eq_of_addVal_lt_coeff_sub`: for an extension `L / K` of nonarchimedean
  local fields and a Bézout certificate `U f + V f' = β`, a monic `g` whose coefficients differ
  from those of `f` by elements of order larger than `2 v(β)` has as many roots as `f` in `L`.
* `TauCeti.exists_card_aroots_eq`: one threshold `T > 0` makes the root counts of `f` and of every
  coefficientwise `𝓂[K] ^ T`-close monic `g` agree in every finite intermediate field of a fixed
  extension of `K`.

## Implementation notes

The threshold comes from a Bézout certificate `U f + V f' = β` over `𝒪[K]`, which exists since `f`
and `f'` are coprime over `K`: the resultant of `f` and `f'` is such a `β`. A coefficientwise
perturbation of order larger than `2 v(β)` stays larger than twice the order of `β` in the ring of
integers of every finite extension, so `Polynomial.card_roots_eq_of_addVal_lt_coeff_sub` applies
there; the roots in `L` of a monic polynomial over `𝒪[K]` are integral, hence lie in `𝒪[L]`
(`TauCeti.aroots_eq_map_roots_integerRing`).

## References

* J.-P. Serre, *Une « formule de masse » pour les extensions totalement ramifiées de degré donné
  d'un corps local*, C. R. Acad. Sci. Paris Sér. A **286** (1978), 1031–1036.
-/

public section

open IsDiscreteValuationRing Polynomial ValuativeRel

namespace TauCeti

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

section Extension

variable (L : Type*) [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L]

/-- **Nearby monic polynomials have equally many roots in `L`.** Let `L / K` be an extension of
nonarchimedean local fields, `f` and `g` monic over `𝒪[K]`, and `U f + V f' = β` a Bézout
certificate for `f` and its derivative. If every coefficient of `g - f` has order larger than
`2 v(β)`, then `g` and `f` have the same number of roots in `L`, counted with multiplicity. -/
theorem card_aroots_eq_of_addVal_lt_coeff_sub {f g U V : 𝒪[K][X]} {β : 𝒪[K]} (hf : f.Monic)
    (hg : g.Monic) (hβ : U * f + V * derivative f = C β)
    (hfg : ∀ i, addVal 𝒪[K] β + addVal 𝒪[K] β < addVal 𝒪[K] ((g - f).coeff i)) :
    ((g.map (algebraMap 𝒪[K] K)).aroots L).card =
      ((f.map (algebraMap 𝒪[K] K)).aroots L).card := by
  set φ := algebraMap 𝒪[K] 𝒪[L]
  have hφ : Function.Injective φ := FaithfulSMul.algebraMap_injective _ _
  rw [aroots_eq_map_roots_integerRing L hf, aroots_eq_map_roots_integerRing L hg,
    Multiset.card_map, Multiset.card_map]
  refine card_roots_eq_of_addVal_lt_coeff_sub (U := U.map φ) (V := V.map φ) (β := φ β) ?_
    fun i ↦ ?_
  · rw [derivative_map, ← Polynomial.map_mul, ← Polynomial.map_mul, ← Polynomial.map_add, hβ,
      map_C]
  -- `2 v(β) < v(c)` means that `β² ϖ ∣ c`, which survives the passage to `𝒪[L]`, where `φ ϖ` is
  -- not a unit.
  have hβ0 : β ≠ 0 := by
    rintro rfl
    have := hfg 0
    rw [addVal_zero, top_add] at this
    exact not_top_lt this
  obtain ⟨ϖ, hϖ⟩ := exists_irreducible 𝒪[K]
  have hdvd : β * β * ϖ ∣ (g - f).coeff i := by
    rw [← addVal_le_iff_dvd, addVal_mul, addVal_mul, addVal_uniformizer hϖ]
    exact Order.add_one_le_of_lt (hfg i)
  have h := addVal_le_iff_dvd.2 (map_dvd φ hdvd)
  rw [map_mul φ, map_mul φ, addVal_mul, addVal_mul] at h
  rw [← Polynomial.map_sub, coeff_map]
  refine lt_of_lt_of_le ?_ h
  have hβ' : addVal 𝒪[L] (φ β) + addVal 𝒪[L] (φ β) ≠ ⊤ := by
    simpa [addVal_eq_top_iff, map_eq_zero_iff φ hφ] using hβ0
  have hϖ' : 0 < addVal 𝒪[L] (φ ϖ) := by
    rw [pos_iff_ne_zero, Ne, addVal_eq_zero_iff]
    exact fun h ↦ hϖ.not_isUnit (h.of_map φ ϖ)
  simpa [add_comm] using ENat.lt_add_left hβ' hϖ'

end Extension

variable (Ω : Type*) [Field Ω] [Algebra K Ω]

/-- **Local constancy of the root count.** For a monic `f` over `𝒪[K]` that is separable over
`K`, there is a threshold `T > 0` such that every monic `g` over `𝒪[K]` with
`g.coeff i - f.coeff i ∈ 𝓂[K] ^ T` for all `i` has as many roots as `f`, counted with
multiplicity, in every finite intermediate field of `Ω / K`. The threshold depends only on `f`. -/
theorem exists_card_aroots_eq {f : 𝒪[K][X]} (hf : f.Monic)
    (hfsep : (f.map (algebraMap 𝒪[K] K)).Separable) :
    ∃ T : ℕ, 0 < T ∧ ∀ (M : IntermediateField K Ω) [Module.Finite K M] (g : 𝒪[K][X]),
      g.Monic → (∀ i, g.coeff i - f.coeff i ∈ 𝓂[K] ^ T) →
      ((g.map (algebraMap 𝒪[K] K)).aroots M).card =
        ((f.map (algebraMap 𝒪[K] K)).aroots M).card := by
  -- A Bézout certificate `U f + V f' = β` with `β ≠ 0`: the resultant of `f` and `f'`.
  obtain ⟨U, V, β, hβ0, hβ⟩ :
      ∃ U V : 𝒪[K][X], ∃ β : 𝒪[K], β ≠ 0 ∧ U * f + V * derivative f = C β := by
    rcases eq_or_ne f.natDegree 0 with h0 | h0
    · exact ⟨1, 0, 1, one_ne_zero, by simp [eq_one_of_monic_natDegree_zero hf h0]⟩
    obtain ⟨p, q, -, -, e⟩ :=
      exists_mul_add_mul_eq_C_resultant f (derivative f) le_rfl le_rfl (.inl h0)
    refine ⟨p, q, resultant f (derivative f), fun h ↦ ?_, by rw [← e]; ring⟩
    have hK : Function.Injective (algebraMap 𝒪[K] K) := FaithfulSMul.algebraMap_injective _ _
    have := resultant_ne_zero _ _ hfsep
    rw [derivative_map, natDegree_map_eq_of_injective hK, natDegree_map_eq_of_injective hK,
      resultant_map_map, h, map_zero] at this
    exact this rfl
  obtain ⟨m, hm⟩ : ∃ m : ℕ, (m : ℕ∞) = addVal 𝒪[K] β :=
    ENat.ne_top_iff_exists.1 (by rwa [Ne, addVal_eq_top_iff])
  refine ⟨2 * m + 1, Nat.succ_pos _, fun M _ g hg hfg ↦ ?_⟩
  let _ := finiteIntermediateFieldValuativeRel K Ω M
  let _ := finiteIntermediateFieldTopology K Ω M
  have := finiteIntermediateField_isNonarchimedeanLocalField K Ω M
  have := finiteIntermediateField_valuativeExtension K Ω M
  refine card_aroots_eq_of_addVal_lt_coeff_sub M hf hg hβ fun i ↦ ?_
  have hi := IsDiscreteValuationRing.mem_maximalIdeal_pow_iff_le_addVal.1 (hfg i)
  rw [← coeff_sub] at hi
  refine lt_of_lt_of_le ?_ hi
  rw [← hm]
  exact_mod_cast (by omega : m + m < 2 * m + 1)

end TauCeti
