module

public import TauCeti.NumberTheory.Cyclotomic.Irreducible
public import TauCeti.NumberTheory.LocalField.RootsOfUnity.Basic

/-!
# Roots of unity in local cyclotomic extensions

The extension `ℚ_p(μ_{p^(n+1)})` has degree `p^n (p - 1)` and its `p`-power roots of unity
are exactly `μ_{p^(n+1)}`. In particular `q(ℚ_p(μ_p)) = p`, including at `p = 2`.
These arithmetic invariants determine the rank and torsion parameter of its maximal pro-`p`
Galois group.

The statements use `IsCyclotomicExtension`, so they apply to any field model of the extension.
They need no choice of valuation or topology. The positive exponent is essential: `ℚ₂` itself
already contains `μ₂`, although it is the cyclotomic extension generated by `μ₁`.

## References

* J.-P. Serre, *Local Fields*, Chapter IV, §4.
* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, (7.5.12).
-/

public section

open Polynomial

namespace TauCeti

variable (p : ℕ) [Fact p.Prime] (K : Type*) [Field K] [Algebra ℚ_[p] K]

variable (n : ℕ) [IsCyclotomicExtension {p ^ (n + 1)} ℚ_[p] K]

/-- The degree of `ℚ_p(μ_{p^(n+1)})` is `p^n (p - 1)`. -/
theorem finrank_cyclotomic_prime_pow_ratPadic :
    Module.finrank ℚ_[p] K = p ^ n * (p - 1) := by
  rw [IsCyclotomicExtension.finrank K (irreducible_cyclotomic_prime_pow_ratPadic p (n + 1)),
    Nat.totient_prime_pow (Fact.out : p.Prime) (Nat.succ_pos n), Nat.succ_sub_one]

/-- There are no additional `p`-power roots of unity in `ℚ_p(μ_{p^(n+1)})`. -/
theorem pPowerRootsOfUnity_eq_rootsOfUnity_cyclotomic_prime_pow_ratPadic :
    pPowerRootsOfUnity p K = rootsOfUnity (p ^ (n + 1)) K := by
  have : Module.Finite ℚ_[p] K := IsCyclotomicExtension.finiteDimensional {p ^ (n + 1)} ℚ_[p] K
  have : CharZero K := charZero_of_injective_algebraMap (algebraMap ℚ_[p] K).injective
  ext x
  constructor
  · intro hx
    obtain ⟨m, hm⟩ := (mem_pPowerRootsOfUnity_iff p K x).mp hx
    obtain ⟨k, -, hk⟩ := (Nat.dvd_prime_pow (Fact.out : p.Prime)).mp
      (orderOf_dvd_of_pow_eq_one hm)
    have hkn : k ≤ n + 1 := by
      by_contra h
      have hkpos : 0 < k := by omega
      have hζ : IsPrimitiveRoot (x : K) (p ^ k) := by
        rw [IsPrimitiveRoot.iff_orderOf, orderOf_units, hk]
      have hdeg : (p ^ k).totient ≤ Module.finrank ℚ_[p] K := by
        simpa only [Nat.lcm_self] using hζ.lcm_totient_le_finrank hζ
          (by simpa only [Nat.lcm_self] using irreducible_cyclotomic_prime_pow_ratPadic p k)
      rw [finrank_cyclotomic_prime_pow_ratPadic p K n,
        Nat.totient_prime_pow (Fact.out : p.Prime) hkpos] at hdeg
      have hexp : p ^ (k - 1) ≤ p ^ n :=
        (mul_le_mul_iff_left₀ (Nat.sub_pos_of_lt (Fact.out : p.Prime).one_lt)).mp hdeg
      have := (Nat.pow_le_pow_iff_right (Fact.out : p.Prime).one_lt).mp hexp
      omega
    rw [mem_rootsOfUnity, ← orderOf_dvd_iff_pow_eq_one, hk]
    exact pow_dvd_pow p hkn
  · intro hx
    exact (mem_pPowerRootsOfUnity_iff p K x).mpr ⟨n + 1, (mem_rootsOfUnity _ x).mp hx⟩

include n in
/-- The `p`-power roots of unity in a positive level of the local cyclotomic tower are finite. -/
theorem finite_pPowerRootsOfUnity_cyclotomic_prime_pow_ratPadic :
    Finite (pPowerRootsOfUnity p K) := by
  rw [pPowerRootsOfUnity_eq_rootsOfUnity_cyclotomic_prime_pow_ratPadic p K n]
  have : NeZero (p ^ (n + 1) : ℕ) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
  infer_instance

/-- The root-of-unity invariant of `ℚ_p(μ_{p^(n+1)})` is `p^(n+1)`. The formula holds for any
finiteness witness, in particular the finiteness theorem for this cyclotomic tower. -/
theorem localRootOfUnityOrder_cyclotomic_prime_pow_ratPadic
    (h : Finite (pPowerRootsOfUnity p K)) : localRootOfUnityOrder p K h = p ^ (n + 1) := by
  have : NeZero (p ^ (n + 1) : ℕ) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
  rw [localRootOfUnityOrder_def,
    pPowerRootsOfUnity_eq_rootsOfUnity_cyclotomic_prime_pow_ratPadic p K n]
  exact (IsCyclotomicExtension.zeta_spec (p ^ (n + 1)) ℚ_[p] K).card_rootsOfUnity

end TauCeti
