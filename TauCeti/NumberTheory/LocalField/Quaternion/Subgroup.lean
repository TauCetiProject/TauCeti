module

public import TauCeti.Algebra.Quaternion.Subgroup
public import TauCeti.NumberTheory.LocalField.QuadraticForm.AnisotropicQuaternary
import TauCeti.GroupTheory.Index.Indicator

/-!
# The quaternion subgroup over a local field

Over a nonarchimedean local field in which two is invertible, the subgroup of the Brauer group
generated by quaternion classes has exactly two elements: the split class and the unique
quaternion division class. Its canonical isomorphism with `ℤˣ` sends the split class to `1`
and the division class to `-1`. On quaternion symbols it is the norm-equation Hilbert symbol.

## Main results

* `TauCeti.BrauerGroup.natCard_quaternionSubgroup`: the quaternion subgroup has two elements.
* `TauCeti.BrauerGroup.quaternionSubgroupSignEquiv`: the canonical sign isomorphism.
* `TauCeti.BrauerGroup.quaternionSubgroupSignEquiv_apply_quaternionClass`: its value on a symbol.

## References

* T. Y. Lam, *Introduction to Quadratic Forms over Fields*, Chapters V, §3 and VI, §2.
* J.-P. Serre, *A Course in Arithmetic*, Chapter IV, §2.
-/

public section

noncomputable section

namespace TauCeti

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Invertible (2 : K)]

namespace BrauerGroup

/-- Fixing any quaternion division class identifies the quaternion subgroup with the two
classes `1` and that division class. -/
theorem mem_quaternionSubgroup_iff_of_hilbertSymbol_eq_neg_one {a b : Kˣ}
    (hab : hilbertSymbol a b = -1) (x : BrauerGroup K) :
    x ∈ quaternionSubgroup K ↔ x = 1 ∨ x = quaternionClass a b := by
  constructor
  · intro hx
    rw [quaternionSubgroup] at hx
    induction hx using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨⟨c, d⟩, rfl⟩ := hx
      rcases Int.units_eq_one_or (hilbertSymbol c d) with h | h
      · left
        exact (quaternionClass_eq_one_iff c d).2
          ((hilbertSymbol_eq_one_iff_nonempty_algEquiv_matrix c d).1 h)
      · right
        exact (quaternionClass_eq_iff_hilbertSymbol_eq c d a b).2 (h.trans hab.symm)
    | one => exact Or.inl rfl
    | mul x y _ _ hx hy =>
      rcases hx with rfl | rfl <;> rcases hy with rfl | rfl
      · simp
      · simp
      · simp
      · exact Or.inl (by rw [← pow_two, quaternionClass_sq])
    | inv x _ hx =>
      rcases hx with rfl | rfl
      · simp
      · exact Or.inr (inv_quaternionClass a b)
  · rintro (rfl | rfl)
    · exact Subgroup.one_mem _
    · exact quaternionClass_mem_quaternionSubgroup K a b

/-- Over a local field every product of quaternion classes is itself a quaternion class. -/
@[simp]
theorem mem_quaternionSubgroup_iff (x : BrauerGroup K) :
    x ∈ quaternionSubgroup K ↔ ∃ a b : Kˣ, quaternionClass a b = x := by
  obtain ⟨⟨a, b⟩, hab⟩ := uncurry_hilbertSymbol_surjective (Invertible.ne_zero (2 : K)) (-1)
  rw [mem_quaternionSubgroup_iff_of_hilbertSymbol_eq_neg_one hab]
  constructor
  · rintro (rfl | rfl)
    · exact ⟨1, 1, quaternionClass_one_left 1⟩
    · exact ⟨a, b, rfl⟩
  · rintro ⟨c, d, rfl⟩
    exact (mem_quaternionSubgroup_iff_of_hilbertSymbol_eq_neg_one hab _).1
      (quaternionClass_mem_quaternionSubgroup K c d)

/-- The quaternion subgroup of a local field has exactly two elements. -/
theorem natCard_quaternionSubgroup : Nat.card (quaternionSubgroup K) = 2 := by
  obtain ⟨⟨a, b⟩, hab⟩ := uncurry_hilbertSymbol_surjective (Invertible.ne_zero (2 : K)) (-1)
  simp only [Function.uncurry_apply_pair] at hab
  let d : quaternionSubgroup K := ⟨quaternionClass a b,
    quaternionClass_mem_quaternionSubgroup K a b⟩
  have hd : d ≠ 1 := by
    intro h
    have heq : quaternionClass a b = 1 := congrArg Subtype.val h
    have hs := (hilbertSymbol_eq_one_iff_nonempty_algEquiv_matrix a b).2
      ((quaternionClass_eq_one_iff a b).1 heq)
    rw [hab] at hs
    exact Int.units_ne_iff_eq_neg.mpr rfl hs
  rw [Nat.card_eq_two_iff' (1 : quaternionSubgroup K)]
  refine ⟨d, hd, ?_⟩
  intro x hx
  rcases (mem_quaternionSubgroup_iff_of_hilbertSymbol_eq_neg_one hab x.val).1 x.property with h | h
  · exact (hx (Subtype.ext h)).elim
  · exact Subtype.ext h

private theorem bottom_index_dvd_two : (⊥ : Subgroup (quaternionSubgroup K)).index ∣ 2 := by
  rw [Subgroup.index_bot, natCard_quaternionSubgroup]

/-- The canonical sign isomorphism on quaternion Brauer classes: it sends the split class to
`1` and the quaternion division class to `-1`. -/
def quaternionSubgroupSignEquiv : quaternionSubgroup K ≃* ℤˣ :=
  MulEquiv.ofBijective ((⊥ : Subgroup (quaternionSubgroup K)).signIndicatorHom
    bottom_index_dvd_two) <| by
    constructor
    · apply (MonoidHom.ker_eq_bot_iff _).1
      exact Subgroup.ker_signIndicatorHom _ _
    · rw [Subgroup.signIndicatorHom_surjective_iff_index_eq_two]
      rw [Subgroup.index_bot, natCard_quaternionSubgroup]

/-- On a quaternion class the sign isomorphism is the norm-equation Hilbert symbol. -/
@[simp]
theorem quaternionSubgroupSignEquiv_apply_quaternionClass (a b : Kˣ) :
    quaternionSubgroupSignEquiv
      ⟨quaternionClass a b, quaternionClass_mem_quaternionSubgroup K a b⟩ = hilbertSymbol a b := by
  -- Expose the homomorphism application hidden by `MulEquiv.ofBijective` so its evaluation
  -- lemma applies; rewriting the equivalence definition alone leaves the bundling in place.
  change (⊥ : Subgroup (quaternionSubgroup K)).signIndicatorHom
    bottom_index_dvd_two _ = _
  rw [Subgroup.signIndicatorHom_apply]
  by_cases h : hilbertSymbol a b = 1
  · have hc := (quaternionClass_eq_one_iff a b).2
      ((hilbertSymbol_eq_one_iff_nonempty_algEquiv_matrix a b).1 h)
    have hx : (⟨quaternionClass a b, quaternionClass_mem_quaternionSubgroup K a b⟩ :
        quaternionSubgroup K) = 1 := Subtype.ext hc
    rw [hx, Subgroup.signIndicator_of_mem _ (Subgroup.one_mem _), h]
  · rw [Subgroup.signIndicator_of_notMem]
    · exact (Int.units_eq_one_or (hilbertSymbol a b)).resolve_left h |>.symm
    · intro hx
      have hc : quaternionClass a b = 1 := congrArg Subtype.val (Subgroup.mem_bot.1 hx)
      exact h ((hilbertSymbol_eq_one_iff_nonempty_algEquiv_matrix a b).2
        ((quaternionClass_eq_one_iff a b).1 hc))

end BrauerGroup

end TauCeti
