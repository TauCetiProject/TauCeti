/-!
# Totally ramified extensions of local fields are Eisenstein

Let `L/K` be a totally ramified extension of nonarchimedean local fields, `e(L/K) = [L : K]`.
Every uniformizer `ϖ` of `L` then generates `𝒪[L]` as an `𝒪[K]`-algebra, hence `L` over `K`, and
its minimal polynomial over `𝒪[K]` is Eisenstein. Together with the converse in
`TauCeti.NumberTheory.LocalField.Eisenstein.PowerBasis`, this characterizes the totally ramified
extensions as those whose integer ring is generated by a root of an Eisenstein polynomial over
`𝒪[K]`.

The Eisenstein property of the minimal polynomial is an instance of a criterion that needs no
total ramification: a polynomial of degree `e(L/K)` over `𝒪[K]` with unit leading coefficient
that has a uniformizer of `L` as a root is Eisenstein.

## Main results

* `TauCeti.isEisensteinAt_of_isRoot_of_irreducible`: a polynomial of degree `e(L/K)` over `𝒪[K]`
  with unit leading coefficient and a uniformizer of `L` as a root is Eisenstein.
* `TauCeti.IsTotallyRamified.isEisensteinAt_minpoly`: in a totally ramified extension, the
  minimal polynomial over `𝒪[K]` of a uniformizer of `L` is Eisenstein.
* `TauCeti.IsTotallyRamified.exists_eisenstein_adjoin_eq_top`: a totally ramified extension is
  generated, over `𝒪[K]` and over `K`, by a root of an Eisenstein polynomial over `𝒪[K]`.
* `TauCeti.isTotallyRamified_iff_exists_eisenstein_generator`: an extension is totally ramified
  if and only if `𝒪[L]` is generated over `𝒪[K]` by a root of an Eisenstein polynomial.

## References

* J.-P. Serre, *Local Fields*, Chapter I, §6, Proposition 18.
-/

public section

open ValuativeRel IsLocalRing IsNonarchimedeanLocalField Polynomial
open scoped IntermediateField

namespace TauCeti

variable {K L : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L]

/-- A polynomial over `𝒪[K]` of degree `e(L/K)` with unit leading coefficient that has a
uniformizer of `L` as a root is Eisenstein at the maximal ideal of `𝒪[K]`. -/
theorem isEisensteinAt_of_isRoot_of_irreducible {g : 𝒪[K][X]} (hg : g.leadingCoeff ∉ 𝓂[K])
    (hdeg : g.natDegree = ramificationIndex K L) {ϖ : 𝒪[L]} (hϖ : Irreducible ϖ)
    (hroot : (g.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ϖ) : g.IsEisensteinAt 𝓂[K] := by
  set n := g.natDegree
  let c : Fin n → 𝒪[K] := fun i ↦ g.coeff i
  have hn : 0 < n := hdeg ▸ ramificationIndex_pos
  -- The root equation, as `∑_{i < n} c_i ϖ ^ i = -u ϖ ^ n` with `u` the leading coefficient.
  have hsum : ∑ i, algebraMap 𝒪[K] 𝒪[L] (c i) * ϖ ^ (i : ℕ) =
      -(algebraMap 𝒪[K] 𝒪[L] g.leadingCoeff * ϖ ^ n) := by
    have h0 : eval₂ (algebraMap 𝒪[K] 𝒪[L]) ϖ g = 0 := by
      rwa [IsRoot, eval_map] at hroot
    rw [eval₂_eq_sum_range, Finset.sum_range_succ, coeff_natDegree] at h0
    rw [Fin.sum_univ_eq_sum_range (fun i ↦ algebraMap 𝒪[K] 𝒪[L] (g.coeff i) * ϖ ^ i)]
    linear_combination h0
  -- Hence the least term valuation `e v_K(c_i) + i` is `v_L(u ϖ ^ n) = e`.
  set e := ramificationIndex K L
  have hval : ⨅ i, e • IsDiscreteValuationRing.addVal 𝒪[K] (c i) + (i : ℕ) = e := by
    rw [← addVal_sum_algebraMap_mul_pow_of_irreducible hϖ hdeg.le c, hsum,
      AddValuation.map_neg, IsDiscreteValuationRing.addVal_mul, addVal_algebraMap,
      IsDiscreteValuationRing.addVal_eq_zero_iff.mpr (notMem_maximalIdeal.mp hg), smul_zero,
      zero_add, hϖ.addVal_pow, hdeg]
  have hle (i : Fin n) : (e : ℕ∞) ≤ e • IsDiscreteValuationRing.addVal 𝒪[K] (c i) + (i : ℕ) :=
    hval ▸ iInf_le _ i
  have hmem (i : Fin n) : c i ∈ 𝓂[K] := by
    by_contra hi
    have h := hle i
    rw [IsDiscreteValuationRing.addVal_eq_zero_iff.mpr (notMem_maximalIdeal.mp hi), smul_zero,
      zero_add, Nat.cast_le] at h
    exact (i.isLt.trans_eq hdeg).not_ge h
  refine ⟨hg, fun hi ↦ hmem ⟨_, hi⟩, ?_⟩
  -- The minimum `e` is attained, and only at `i = 0`, where `v_K(c_0) = 1`.
  have : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
  obtain ⟨j, hj⟩ := ENat.exists_eq_iInf
    fun i : Fin n ↦ e • IsDiscreteValuationRing.addVal 𝒪[K] (c i) + (i : ℕ)
  rw [hval] at hj
  have hcj : 1 ≤ IsDiscreteValuationRing.addVal 𝒪[K] (c j) := by
    simpa using (TauCeti.IsDiscreteValuationRing.mem_maximalIdeal_pow_iff_le_addVal
      (n := 1)).mp (by simpa using hmem j)
  obtain ⟨k, hk⟩ : ∃ k : ℕ, (k : ℕ∞) = IsDiscreteValuationRing.addVal 𝒪[K] (c j) :=
    ENat.ne_top_iff_exists.mp fun htop ↦ by simp [htop, e, ramificationIndex_pos.ne'] at hj
  rw [← hk, nsmul_eq_mul] at hj
  rw [← hk] at hcj
  have hj' : e * k + (j : ℕ) = e := by exact_mod_cast hj
  have hk1 : 1 ≤ k := by exact_mod_cast hcj
  have hj0 : (j : ℕ) = 0 := by nlinarith
  have hkn : k = 1 := by
    rw [hj0, add_zero] at hj'
    exact (Nat.mul_eq_left (hdeg ▸ hn).ne').mp hj'
  have hc0 : g.coeff 0 = c j := by simp [c, hj0]
  rw [hc0, TauCeti.IsDiscreteValuationRing.mem_maximalIdeal_pow_iff_le_addVal, ← hk, hkn]
  simp

/-- In a totally ramified extension of nonarchimedean local fields, the minimal polynomial over
`𝒪[K]` of any uniformizer of `L` is Eisenstein at the maximal ideal of `𝒪[K]`. -/
theorem IsTotallyRamified.isEisensteinAt_minpoly (h : IsTotallyRamified K L) {ϖ : 𝒪[L]}
    (hϖ : Irreducible ϖ) : (minpoly 𝒪[K] ϖ).IsEisensteinAt 𝓂[K] := by
  have hint : IsIntegral 𝒪[K] ϖ := IsIntegral.of_finite 𝒪[K] ϖ
  have hgen := h.adjoin_eq_top_of_irreducible hϖ
  refine isEisensteinAt_of_isRoot_of_irreducible (by simp [(minpoly.monic hint).leadingCoeff]) ?_
    hϖ ?_
  · rw [← PowerBasis.ofAdjoinEqTop'_dim hint hgen, ← PowerBasis.finrank, finrank_integerRing,
      ← (isTotallyRamified_iff_ramificationIndex_eq_finrank K L).mp h]
  · rw [IsRoot, eval_map, ← aeval_def, minpoly.aeval]

/-- **Totally ramified extensions are Eisenstein.** A totally ramified extension `L/K` of
nonarchimedean local fields is generated, both as an extension of integer rings and as a field
extension, by a root of an Eisenstein polynomial over `𝒪[K]`: namely by any uniformizer of `L`,
a root of its minimal polynomial. -/
theorem IsTotallyRamified.exists_eisenstein_adjoin_eq_top (h : IsTotallyRamified K L) :
    ∃ (f : 𝒪[K][X]) (π : 𝒪[L]), f.IsEisensteinAt 𝓂[K] ∧
      (f.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot π ∧ Algebra.adjoin 𝒪[K] {π} = ⊤ ∧
        K⟮(π : L)⟯ = ⊤ := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[L]
  have hgen := h.adjoin_eq_top_of_irreducible hϖ
  have hK : K⟮algebraMap 𝒪[L] L ϖ⟯ = ⊤ :=
    IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top hgen
  rw [Algebra.algebraMap_ofSubsemiring_apply] at hK
  refine ⟨minpoly 𝒪[K] ϖ, ϖ, h.isEisensteinAt_minpoly hϖ, ?_, hgen, hK⟩
  rw [IsRoot, eval_map, ← aeval_def, minpoly.aeval]

variable (K L) in
/-- **Totally ramified is equivalent to Eisenstein.** An extension `L/K` of nonarchimedean local
fields is totally ramified if and only if `𝒪[L]` is generated as an `𝒪[K]`-algebra by a root of an
Eisenstein polynomial over `𝒪[K]`. -/
theorem isTotallyRamified_iff_exists_eisenstein_generator :
    IsTotallyRamified K L ↔ ∃ (f : 𝒪[K][X]) (π : 𝒪[L]), f.IsEisensteinAt 𝓂[K] ∧
      (f.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot π ∧ Algebra.adjoin 𝒪[K] {π} = ⊤ := by
  refine ⟨fun h ↦ ?_, fun ⟨f, π, hf, hroot, hgen⟩ ↦ ?_⟩
  · obtain ⟨f, π, hf, hroot, hgen, -⟩ := h.exists_eisenstein_adjoin_eq_top
    exact ⟨f, π, hf, hroot, hgen⟩
  · have : Module.Finite K L := finite_of_valuativeExtension K L
    exact (isTotallyRamified_iff_inertiaDegree_eq_one K L).2
      (inertiaDegree_eq_one_of_eisenstein_adjoin_eq_top f hf π hroot hgen)

end TauCeti
