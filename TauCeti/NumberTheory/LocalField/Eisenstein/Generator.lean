module

public import TauCeti.NumberTheory.LocalField.Eisenstein.PowerBasis
import TauCeti.RingTheory.DiscreteValuationRing.Basic
import TauCeti.RingTheory.DiscreteValuationRing.Monogenic

/-!
# Eisenstein generators of totally ramified local extensions

A finite extension of nonarchimedean local fields is totally ramified exactly when its ring of
integers is generated by a uniformizer whose minimal polynomial is Eisenstein.  More precisely,
when `e(L/K) = [L : K]`, every uniformizer of `L` generates both `𝒪[L]` over `𝒪[K]` and
`L` over `K`, and its minimal polynomial over `𝒪[K]` is Eisenstein at the maximal ideal.

The converse uses the total-ramification consequences of an Eisenstein integral power basis from
`TauCeti.NumberTheory.LocalField.Eisenstein.PowerBasis`.

## Main results

* `TauCeti.adjoin_eq_top_of_isTotallyRamified_of_irreducible`: every uniformizer
  integrally generates a totally ramified extension.
* `TauCeti.isEisensteinAt_minpoly_of_isTotallyRamified_of_irreducible`: the minimal
  polynomial of every uniformizer in a totally ramified extension is Eisenstein.
* `TauCeti.isTotallyRamified_iff_exists_eisenstein_generator`: total ramification is
  equivalent to the existence of an Eisenstein integral generator.

## References

* [J.-P. Serre, *Local Fields*][serre1968], Chapter I, §6, Proposition 18.
* J. Neukirch, *Algebraic Number Theory*, Chapter II, §6.
-/

public section
noncomputable section

open ValuativeRel IsLocalRing IsNonarchimedeanLocalField

namespace TauCeti

variable {K L : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L]

/-- In a totally ramified extension of nonarchimedean local fields, every uniformizer of the
extension integer ring generates that integer ring over the base integer ring. -/
theorem adjoin_eq_top_of_isTotallyRamified_of_irreducible
    (h : IsTotallyRamified K L) {ξ : 𝒪[L]} (hξ : Irreducible ξ) :
    Algebra.adjoin 𝒪[K] {ξ} = ⊤ := by
  have hf : inertiaDegree K L = 1 :=
    (isTotallyRamified_iff_inertiaDegree_eq_one K L).mp h
  have hsurj : Function.Surjective
      (algebraMap (ResidueField 𝒪[K]) (ResidueField 𝒪[L])) :=
    (Algebra.finrank_eq_one_iff_bijective_algebraMap.mp (inertiaDegree_def K L ▸ hf)).surjective
  exact IsLocalRing.adjoin_eq_top_of_algebraMap_residueField_surjective_of_span_eq_maximalIdeal
    hsurj hξ.maximalIdeal_eq.symm

private theorem irreducible_norm_of_irreducible_of_inertiaDegree_eq_one
    (hf : inertiaDegree K L = 1) {ξ : 𝒪[L]} (hξ : Irreducible ξ) :
    Irreducible (Algebra.norm 𝒪[K] ξ) := by
  let _ : Module.Finite K L := finite_of_valuativeExtension K L
  have hξL : (ξ : L) ≠ 0 := fun h ↦ hξ.ne_zero (Subtype.ext h)
  let x : Lˣ := Units.mk0 (ξ : L) hξL
  have hnorm0 : ((Algebra.norm 𝒪[K] ξ : 𝒪[K]) : K) ≠ 0 := by
    rw [coe_norm_integerRing]
    exact Algebra.norm_ne_zero_iff.mpr hξL
  have heq : Algebra.normUnits K x =
      Units.mk0 ((Algebra.norm 𝒪[K] ξ : 𝒪[K]) : K) hnorm0 := by
    apply Units.ext
    simp [x]
  have hx : IsUniformizer L x :=
    (isUniformizer_def _).mpr (by simpa [x] using normalizedValuation_irreducible hξ)
  have hnorm : IsUniformizer K (Algebra.normUnits K x) :=
    (isUniformizer_normUnits_iff hx).mpr hf
  rw [heq] at hnorm
  obtain ⟨π, hπ, hπeq⟩ := (isUniformizer_iff_exists_irreducible K _).mp hnorm
  have hπnorm : π = Algebra.norm 𝒪[K] ξ := by
    apply Subtype.ext
    simpa using hπeq
  rwa [← hπnorm]

/-- The minimal polynomial over `𝒪[K]` of every uniformizer in a totally ramified extension
`L/K` is Eisenstein at the maximal ideal of `𝒪[K]`. -/
theorem isEisensteinAt_minpoly_of_isTotallyRamified_of_irreducible
    (h : IsTotallyRamified K L) (ξ : 𝒪[L]) (hξ : Irreducible ξ) :
    (minpoly 𝒪[K] ξ).IsEisensteinAt 𝓂[K] := by
  let _ : Module.Finite K L := finite_of_valuativeExtension K L
  have hf : inertiaDegree K L = 1 :=
    (isTotallyRamified_iff_inertiaDegree_eq_one K L).mp h
  have hgen : Algebra.adjoin 𝒪[K] {ξ} = ⊤ :=
    adjoin_eq_top_of_isTotallyRamified_of_irreducible h hξ
  have hint : IsIntegral 𝒪[K] ξ := IsIntegral.of_finite 𝒪[K] ξ
  have hc0 : Irreducible ((minpoly 𝒪[K] ξ).coeff 0) := by
    have hn := irreducible_norm_of_irreducible_of_inertiaDegree_eq_one hf hξ
    rw [← PowerBasis.ofAdjoinEqTop'_gen hint hgen,
      Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly] at hn
    simpa only [PowerBasis.ofAdjoinEqTop'_gen] using
      (irreducible_units_mul
        ((-1 : 𝒪[K]ˣ) ^ (PowerBasis.ofAdjoinEqTop' hint hgen).dim)).mp hn
  refine (minpoly.monic hint).isEisensteinAt_of_mem_of_notMem
    (IsLocalRing.maximalIdeal.isMaximal 𝒪[K]).ne_top ?_ ?_
  · intro i hi
    let _ := normalizedNontriviallyNormedField K
    let _ := finiteExtensionNormedField K L
    have hw := ValuativeRel.isEquiv ((valuation L).comap (algebraMap K L)) (valuation K)
    have hξval : valuation L (ξ : L) < 1 :=
      Valuation.Integer.not_isUnit_iff_valuation_lt_one.mp hξ.not_isUnit
    have hξnorm : ‖(ξ : L)‖ < 1 := by
      rw [← norm_one (α := L), lt_iff_not_ge,
        finiteExtensionNormedField_norm_le_norm_iff hw]
      simpa using not_le_of_gt hξval
    have hspectral : spectralValue (minpoly K (ξ : L)) < 1 := by
      rw [finiteExtensionNormedField_norm_def] at hξnorm
      exact hξnorm
    have hmap : minpoly K (ξ : L) = (minpoly 𝒪[K] ξ).map (algebraMap 𝒪[K] K) :=
      minpoly.isIntegrallyClosed_eq_field_fractions K L hint
    have hi' : i < (minpoly K (ξ : L)).natDegree := by
      rwa [hmap, (minpoly.monic hint).natDegree_map]
    have hterm : spectralValueTerms (minpoly K (ξ : L)) i < 1 :=
      (le_ciSup (spectralValueTerms_bddAbove _) i).trans_lt hspectral
    rw [spectralValueTerms_of_lt_natDegree _ hi', Real.rpow_lt_one_iff'
      (norm_nonneg _) (one_div_pos.mpr (sub_pos.mpr (by exact_mod_cast hi')))] at hterm
    apply (Valuation.mem_maximalIdeal_iff (v := valuation K)).mpr
    apply (normalizedAbsoluteValue_lt_one_iff _).mp
    rw [hmap, Polynomial.coeff_map] at hterm
    rw [normalizedNormedField_norm_def] at hterm
    rw [Algebra.coe_algebraMap_ofSubsemiring 𝒪[K]] at hterm
    exact_mod_cast hterm
  · rw [TauCeti.IsDiscreteValuationRing.mem_maximalIdeal_pow_iff_le_addVal,
      IsDiscreteValuationRing.addVal_uniformizer hc0]
    norm_num

/-- A finite extension of nonarchimedean local fields is totally ramified if and only if its
integer ring is generated by a root of an Eisenstein polynomial over the base integer ring. Such a
root is a uniformizer by `irreducible_of_eisenstein_adjoin_eq_top`. -/
theorem isTotallyRamified_iff_exists_eisenstein_generator :
    IsTotallyRamified K L ↔
      ∃ (f : Polynomial 𝒪[K]) (ξ : 𝒪[L]),
        f.IsEisensteinAt 𝓂[K] ∧
          (f.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ ∧ Algebra.adjoin 𝒪[K] {ξ} = ⊤ := by
  let _ : Module.Finite K L := finite_of_valuativeExtension K L
  constructor
  · intro h
    obtain ⟨ξ, hξ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[L]
    refine ⟨minpoly 𝒪[K] ξ, ξ,
      isEisensteinAt_minpoly_of_isTotallyRamified_of_irreducible h ξ hξ, ?_,
      adjoin_eq_top_of_isTotallyRamified_of_irreducible h hξ⟩
    simp [Polynomial.IsRoot]
  · rintro ⟨f, ξ, heis, hroot, hgen⟩
    have hf := inertiaDegree_eq_one_of_eisenstein_adjoin_eq_top
      f heis ξ hroot hgen
    exact (isTotallyRamified_iff_inertiaDegree_eq_one K L).mpr hf

end TauCeti
