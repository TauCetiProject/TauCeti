module

public import TauCeti.NumberTheory.LocalField.Unramified.Inertia.Basic
import TauCeti.NumberTheory.LocalField.FiniteExtension.Basic
import TauCeti.NumberTheory.LocalField.Unramified.Quadratic

/-!
# Inertia and quadratic subextensions

Let `K` be a nonarchimedean local field and `E` a separable quadratic subextension of `Kᵃˡᵍ/K`.
The inertia subgroup `I_K` fixes `E` exactly when `E/K` is unramified
(`TauCeti.inertiaSubgroup_le_fixingSubgroup_iff`), and an unramified quadratic extension is
generated by a root of a monic quadratic `X² + t X + n` with `t, n ∈ 𝒪[K]` and unit discriminant
`t² - 4n` (`TauCeti.isUnramified_iff_exists_sq_add_mul_add_eq_zero`). This file combines the two
on the subfields of `Kᵃˡᵍ`, with no local field structure on `E` in the statement: `I_K` fixes `E`
exactly when `E` contains such a root outside `K`.

This is the form in which a quadratic character of `G_K` is tested for being unramified: the
character of a square root `a` is trivial on `I_K` exactly when `I_K` fixes `K(a)`.

## Main results

* `TauCeti.inertiaSubgroup_le_fixingSubgroup_iff_exists_sq_add_mul_add_eq_zero`: inertia fixes a
  separable quadratic subextension `E` exactly when `E` contains a root `θ ∉ K` of a monic
  quadratic over `𝒪[K]` of unit discriminant.

## References

* [J.-P. Serre, *Corps Locaux*][serre1968], Chapter III, §5.
-/

public section

open ValuativeRel

namespace TauCeti

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

/-- **Inertia fixes a quadratic subextension exactly when it is generated by a root of a
unit-discriminant quadratic.** A separable quadratic subextension `E` of `Kᵃˡᵍ/K` is fixed by the
inertia subgroup, that is `E/K` is unramified, exactly when `E` contains a root `θ ∉ K` of a monic
quadratic `X² + t X + n` with `t, n ∈ 𝒪[K]` and `t² - 4n` a unit. -/
theorem inertiaSubgroup_le_fixingSubgroup_iff_exists_sq_add_mul_add_eq_zero
    (E : IntermediateField K (AlgebraicClosure K)) (hE : Module.finrank K E = 2)
    [Algebra.IsSeparable K E] :
    inertiaSubgroup K ≤ E.fixingSubgroup ↔
      ∃ t n : 𝒪[K], IsUnit (t ^ 2 - 4 * n) ∧ ∃ θ ∈ E,
        θ ∉ Set.range (algebraMap K (AlgebraicClosure K)) ∧
          θ ^ 2 + algebraMap K _ (t : K) * θ + algebraMap K _ (n : K) = 0 := by
  have : FiniteDimensional K E := Module.finite_of_finrank_eq_succ hE
  have : Algebra.IsQuadraticExtension K E := ⟨hE⟩
  -- the local field structure on `E` extending that of `K`
  let := algebraicExtensionValuativeRel K E
  let := algebraicExtensionNormedFieldTopology K E
  have := finiteExtension_isNonarchimedeanLocalField K E
  have := algebraicExtension_valuativeExtension K E
  rw [inertiaSubgroup_le_fixingSubgroup_iff, isUnramified_iff_exists_sq_add_mul_add_eq_zero]
  refine exists₂_congr fun t n ↦ and_congr_right fun _ ↦ ⟨?_, ?_⟩
  · rintro ⟨θ, hθ, hroot⟩
    exact ⟨θ, θ.property, fun ⟨x, hx⟩ ↦ hθ ⟨x, Subtype.ext hx⟩,
      by simpa using congrArg Subtype.val hroot⟩
  · rintro ⟨θ, hθE, hθ, hroot⟩
    exact ⟨⟨θ, hθE⟩, fun ⟨x, hx⟩ ↦ hθ ⟨x, congrArg Subtype.val hx⟩,
      Subtype.ext (by simpa using hroot)⟩

end TauCeti
