module

public import TauCeti.NumberTheory.LocalField.UnitFiltration.Pow.Basic

import TauCeti.NumberTheory.LocalField.UnitFiltration.Graded
import TauCeti.RingTheory.Valuation.Irreducible

/-!
# Squaring on steps of the unit filtration at or below `v_K(2)`

Above the dyadic threshold `v_K(2)`, squaring shifts the unit filtration additively from `U(K, i)`
onto `U(K, i + v_K(2))` (`TauCeti.map_powMonoidHom_unitFiltration_of_prime`). At or below `v_K(2)`,
`(z - 1)²` dominates `2 (z - 1)`, so squaring doubles the filtration depth: `z² ∈ U(K, 2i)` iff
`z ∈ U(K, i)` (`TauCeti.sq_mem_unitFiltration_two_mul_iff`).

Combining `U(K, e - k) → U(K, 2e - 2k)` (`k < e = v_K(2)`) with the sharp square depth
`U(K, 2e + 1)` yields `TauCeti.unitFiltrationSquareCosetHom` onto the square cosets in
`U(K, 2e - 2k) ⧸ U(K, 2e + 1)`. Its kernel contains `U(K, e + 1)` with index `2` generated by `-1`
(`TauCeti.mem_or_neg_mem_unitFiltration_succ_of_sq_mem`,
`TauCeti.relIndex_unitFiltration_ker_unitFiltrationSquareCosetHom`), so twice the number of square
cosets is `#𝓀[K] ^ (k + 1)` (`TauCeti.two_mul_natCard_squareCosets_unitFiltration`).

## References

* O. T. O'Meara, *Introduction to Quadratic Forms*, §63A.
* J.-P. Serre, *Local Fields*, Chapter IV, §2 and Chapter V, §3.
-/

public section

noncomputable section

open ValuativeRel IsNonarchimedeanLocalField

namespace TauCeti

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
private theorem coe_neg_one_sub_one : ((-1 : Kˣ) : K) - 1 = -(2 : K) := by push_cast; ring

/-- At or below depth `v_K(2)`, squaring carries `U(K, i)` into `U(K, 2 * i)`. -/
theorem sq_mem_unitFiltration_two_mul (h2 : (2 : K) ≠ 0) {i : ℕ}
    (hi : i ≤ natCastValuation K 2 h2) {z : Kˣ} (hz : z ∈ unitFiltration K i) :
    z ^ 2 ∈ unitFiltration K (2 * i) := by
  rcases eq_or_ne i 0 with rfl | hi0
  · rw [Nat.mul_zero]; rw [mem_unitFiltration_zero] at hz ⊢
    rw [Units.val_pow_eq_pow_val, map_pow, hz, one_pow]
  · obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[K]
    have hπ1 : valuation K (π : K) < 1 := Valuation.integer.v_irreducible_lt_one hπ
    rw [mem_unitFiltration_iff_valuation_sub_one_le hi0 hπ] at hz
    rw [mem_unitFiltration_iff_valuation_sub_one_le (by omega) hπ,
      show ((z ^ 2 : Kˣ) : K) - 1 = 2 * ((z : K) - 1) + ((z : K) - 1) ^ 2 by push_cast; ring]
    refine ((valuation K).map_add _ _).trans (max_le ?_ ?_)
    · rw [map_mul, show valuation K (2 : K) = _ from valuation_natCast_eq_pow hπ 2 h2]
      exact (mul_le_mul' le_rfl hz).trans <| (pow_add _ _ _).symm.trans_le <|
        pow_le_pow_right_of_le_one' hπ1.le (by omega)
    · rw [map_pow, show 2 * i = i * 2 by ring, pow_mul]
      exact pow_le_pow_left₀ zero_le hz 2

/-- Conversely, at or below depth `v_K(2)`, any unit whose square lies in `U(K, 2 * i)` already
lies in `U(K, i)`. -/
theorem mem_unitFiltration_of_sq_mem_two_mul (h2 : (2 : K) ≠ 0) {i : ℕ}
    (hi : i ≤ natCastValuation K 2 h2) {z : Kˣ} (hz2 : z ^ 2 ∈ unitFiltration K (2 * i)) :
    z ∈ unitFiltration K i := by
  rcases eq_or_ne i 0 with rfl | hi0
  · rw [Nat.mul_zero, mem_unitFiltration_zero, Units.val_pow_eq_pow_val, map_pow,
      pow_eq_one_iff_left (by decide : 2 ≠ 0)] at hz2
    exact (mem_unitFiltration_zero z).mpr hz2
  · obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[K]
    rw [mem_unitFiltration_iff_valuation_sub_one_le (by omega) hπ] at hz2
    rw [mem_unitFiltration_iff_valuation_sub_one_le hi0 hπ]
    by_contra! hgt
    have hlt2 : valuation K (2 : K) < valuation K ((z : K) - 1) := by
      rw [show valuation K (2 : K) = _ from valuation_natCast_eq_pow hπ 2 h2]
      exact (pow_le_pow_right_of_le_one' (Valuation.integer.v_irreducible_lt_one hπ).le hi).trans_lt
        hgt
    have hplus : valuation K ((z : K) + 1) = valuation K ((z : K) - 1) := by
      rw [show (z : K) + 1 = ((z : K) - 1) + 2 by ring, (valuation K).map_add_eq_of_lt_left hlt2]
    rw [show ((z ^ 2 : Kˣ) : K) - 1 = ((z : K) - 1) * ((z : K) + 1) by push_cast; ring,
      map_mul, hplus, ← sq, show 2 * i = i * 2 by ring, pow_mul] at hz2
    exact hz2.not_gt (pow_lt_pow_left₀ hgt zero_le (by decide))

/-- At or below depth `v_K(2)`, `z ^ 2 ∈ U(K, 2 * i)` if and only if `z ∈ U(K, i)`. -/
theorem sq_mem_unitFiltration_two_mul_iff (h2 : (2 : K) ≠ 0) {i : ℕ}
    (hi : i ≤ natCastValuation K 2 h2) (z : Kˣ) :
    z ^ 2 ∈ unitFiltration K (2 * i) ↔ z ∈ unitFiltration K i :=
  ⟨mem_unitFiltration_of_sq_mem_two_mul h2 hi, sq_mem_unitFiltration_two_mul h2 hi⟩

/-- If `w ^ 2 ∈ U(K, 2 v_K(2) + 1)`, then either `w` or `-w` lies in `U(K, v_K(2) + 1)`. -/
theorem mem_or_neg_mem_unitFiltration_succ_of_sq_mem (h2 : (2 : K) ≠ 0) {w : Kˣ}
    (hw : w ^ 2 ∈ unitFiltration K (2 * natCastValuation K 2 h2 + 1)) :
    w ∈ unitFiltration K (natCastValuation K 2 h2 + 1) ∨
      -w ∈ unitFiltration K (natCastValuation K 2 h2 + 1) := by
  set e := natCastValuation K 2 h2
  refine or_iff_not_imp_left.mpr fun hw_in ↦ ?_
  have hw0 : w ∈ unitFiltration K 0 := unitFiltration_antitone (Nat.zero_le _)
    (mem_unitFiltration_of_sq_mem_two_mul h2 le_rfl
      (unitFiltration_antitone (Nat.le_succ (2 * e)) hw))
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[K]
  have hπ1 : valuation K (π : K) < 1 := Valuation.integer.v_irreducible_lt_one hπ
  rw [mem_unitFiltration_iff_valuation_sub_one_le (by omega) hπ] at hw ⊢
  have hwnot : ¬ valuation K ((w : K) - 1) ≤ valuation K (π : K) ^ (e + 1) := fun hle ↦
    hw_in ((mem_unitFiltration_iff_valuation_sub_one_le (by omega) hπ).mpr hle)
  let δ : 𝒪[K] := ⟨(w : K) - 1,
    sub_mem ((Valuation.mem_integer_iff _ _).mpr ((mem_unitFiltration_zero w).mp hw0).le)
      (one_mem _)⟩
  have hδ0 : δ ≠ 0 := fun h0 ↦ hwnot (by simp [show (w : K) - 1 = 0 from congrArg Subtype.val h0])
  obtain ⟨ρ, hδv⟩ := exists_valuation_eq_pow_irreducible (valuation K) hδ0 hπ
  dsimp only [δ] at hδv
  have hρle : ρ ≤ e := not_lt.mp fun hρgt ↦ hwnot (hδv ▸ pow_le_pow_right_of_le_one' hπ1.le hρgt)
  have hw_ge_e : valuation K (π : K) ^ e ≤ valuation K ((w : K) - 1) :=
    hδv ▸ pow_le_pow_right_of_le_one' hπ1.le hρle
  rw [show ((w ^ 2 : Kˣ) : K) - 1 = ((w : K) - 1) * ((w : K) + 1) by push_cast; ring, map_mul]
    at hw
  rw [show ((-w : Kˣ) : K) - 1 = -((w : K) + 1) by push_cast; ring, Valuation.map_neg]
  refine le_of_mul_le_mul_left ?_ (pow_pos (Valuation.integer.v_irreducible_pos hπ) e)
  exact (mul_le_mul' hw_ge_e le_rfl).trans (hw.trans_eq (by rw [← pow_add]; congr 1; omega))

/-- For `e = v_K(2)`, the squaring homomorphism
`U(K, e - k) →* U(K, 2e - 2k) ⧸ U(K, 2e + 1)`. -/
def unitFiltrationSquareCosetHom (h2 : (2 : K) ≠ 0) (k : ℕ) :
    unitFiltration K (natCastValuation K 2 h2 - k) →*
      unitFiltration K (2 * natCastValuation K 2 h2 - 2 * k) ⧸
        (unitFiltration K (2 * natCastValuation K 2 h2 + 1)).subgroupOf
          (unitFiltration K (2 * natCastValuation K 2 h2 - 2 * k)) :=
  (QuotientGroup.mk' _).comp
    { toFun := fun z ↦ ⟨(z : Kˣ) ^ 2,
        Nat.mul_sub 2 _ k ▸ sq_mem_unitFiltration_two_mul h2 (Nat.sub_le _ _) z.2⟩
      map_one' := by ext; simp
      map_mul' := fun x y ↦ by ext; simp [mul_pow] }

/-- `unitFiltrationSquareCosetHom` sends `z` to the coset of `z ^ 2`. -/
@[simp]
theorem unitFiltrationSquareCosetHom_apply (h2 : (2 : K) ≠ 0) (k : ℕ)
    (z : unitFiltration K (natCastValuation K 2 h2 - k)) :
    unitFiltrationSquareCosetHom h2 k z =
      QuotientGroup.mk ⟨(z : Kˣ) ^ 2,
        Nat.mul_sub 2 _ k ▸ sq_mem_unitFiltration_two_mul h2 (Nat.sub_le _ _) z.2⟩ := by
  rw [unitFiltrationSquareCosetHom, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
    MonoidHom.coe_mk, OneHom.coe_mk]

/-- The range of `unitFiltrationSquareCosetHom` consists of the cosets represented by squares in
`Kˣ`. -/
theorem range_unitFiltrationSquareCosetHom (h2 : (2 : K) ≠ 0) (k : ℕ) :
    ((unitFiltrationSquareCosetHom h2 k).range :
        Set (unitFiltration K (2 * natCastValuation K 2 h2 - 2 * k) ⧸
          (unitFiltration K (2 * natCastValuation K 2 h2 + 1)).subgroupOf
            (unitFiltration K (2 * natCastValuation K 2 h2 - 2 * k)))) =
      {q | ∃ u : unitFiltration K (2 * natCastValuation K 2 h2 - 2 * k),
        QuotientGroup.mk u = q ∧ IsSquare (u : Kˣ)} := by
  ext q
  refine ⟨fun ⟨z, hz⟩ ↦ hz ▸ ⟨_, (unitFiltrationSquareCosetHom_apply h2 k z).symm, ⟨z.1, sq z.1⟩⟩,
    ?_⟩
  rintro ⟨u, rfl, ⟨z, hz⟩⟩
  have hz2 : z ^ 2 = u.1 := by simpa only [sq] using hz.symm
  refine ⟨⟨z, mem_unitFiltration_of_sq_mem_two_mul h2 (Nat.sub_le _ _)
    (by rw [Nat.mul_sub, hz2]; exact u.2)⟩, ?_⟩
  rw [unitFiltrationSquareCosetHom_apply]
  exact congrArg QuotientGroup.mk (Subtype.ext hz2)

/-- `U(K, v_K(2) + 1)` lies in the kernel of `unitFiltrationSquareCosetHom`. -/
theorem unitFiltration_succ_le_ker_unitFiltrationSquareCosetHom (h2 : (2 : K) ≠ 0) (k : ℕ) :
    (unitFiltration K (natCastValuation K 2 h2 + 1)).subgroupOf
        (unitFiltration K (natCastValuation K 2 h2 - k)) ≤
      (unitFiltrationSquareCosetHom h2 k).ker := by
  set e := natCastValuation K 2 h2
  intro z hz
  have hz2 : (z : Kˣ) ^ 2 ∈ unitFiltration K (e + 1 + e) := by
    rw [← map_powMonoidHom_unitFiltration_of_prime Nat.prime_two h2 (i := e + 1) (by omega)]
    exact ⟨(z : Kˣ), Subgroup.mem_subgroupOf.mp hz, rfl⟩
  rw [MonoidHom.mem_ker, unitFiltrationSquareCosetHom_apply, QuotientGroup.eq_one_iff,
    Subgroup.mem_subgroupOf]
  rwa [show 2 * natCastValuation K 2 h2 + 1 = e + 1 + e by omega]

/-- `U(K, v_K(2) + 1)` has relative index `2` inside the kernel of
`unitFiltrationSquareCosetHom` when `k < v_K(2)`. -/
theorem relIndex_unitFiltration_ker_unitFiltrationSquareCosetHom (h2 : (2 : K) ≠ 0) {k : ℕ}
    (hk : k < natCastValuation K 2 h2) :
    ((unitFiltration K (natCastValuation K 2 h2 + 1)).subgroupOf
        (unitFiltration K (natCastValuation K 2 h2 - k))).relIndex
      (unitFiltrationSquareCosetHom h2 k).ker = 2 := by
  set e := natCastValuation K 2 h2
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[K]
  have hπ1 : valuation K (π : K) < 1 := Valuation.integer.v_irreducible_lt_one hπ
  have hv2 : valuation K (2 : K) = valuation K (π : K) ^ e := valuation_natCast_eq_pow hπ 2 h2
  have hneg1_mem : (-1 : Kˣ) ∈ unitFiltration K (e - k) := by
    rw [mem_unitFiltration_iff_valuation_sub_one_le (by omega) hπ, coe_neg_one_sub_one,
      Valuation.map_neg, hv2]
    exact pow_le_pow_right_of_le_one' hπ1.le (Nat.sub_le e k)
  let negOne : (unitFiltrationSquareCosetHom h2 k).ker := ⟨⟨-1, hneg1_mem⟩, by
    simp [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]⟩
  rw [Subgroup.relIndex, Subgroup.index_eq_two_iff_exists_notMem_and]
  refine ⟨negOne, fun hmem ↦ ?_, fun w ↦ ?_⟩
  · have h1 := Subgroup.mem_subgroupOf.mp (Subgroup.mem_subgroupOf.mp hmem)
    rw [mem_unitFiltration_iff_valuation_sub_one_le (by omega) hπ, coe_neg_one_sub_one,
      Valuation.map_neg, hv2] at h1
    exact (pow_lt_pow_right_of_lt_one₀ (Valuation.integer.v_irreducible_pos hπ) hπ1
      (Nat.lt_succ_self e)).not_ge h1
  · have hw2 : (w.1.1 : Kˣ) ^ 2 ∈ unitFiltration K (2 * e + 1) := by
      have hw_ker := MonoidHom.mem_ker.mp w.2
      rwa [unitFiltrationSquareCosetHom_apply, QuotientGroup.eq_one_iff,
        Subgroup.mem_subgroupOf] at hw_ker
    refine (mem_or_neg_mem_unitFiltration_succ_of_sq_mem h2 hw2).symm.imp
      (fun hw_neg ↦ ?_) id
    simpa only [Subgroup.mem_subgroupOf, negOne, Subgroup.coe_mul, mul_neg, mul_one] using hw_neg

/-- Below the threshold `v_K(2)`, twice the number of square cosets in
`U(K, 2e - 2k) ⧸ U(K, 2e + 1)` (`k < e = v_K(2)`) equals `#𝓀[K] ^ (k + 1)`. -/
theorem two_mul_natCard_squareCosets_unitFiltration (h2 : (2 : K) ≠ 0) {k : ℕ}
    (hk : k < natCastValuation K 2 h2) :
    2 * Nat.card {q : unitFiltration K (2 * natCastValuation K 2 h2 - 2 * k) ⧸
        (unitFiltration K (2 * natCastValuation K 2 h2 + 1)).subgroupOf
          (unitFiltration K (2 * natCastValuation K 2 h2 - 2 * k)) //
        ∃ u : unitFiltration K (2 * natCastValuation K 2 h2 - 2 * k),
          QuotientGroup.mk u = q ∧ IsSquare (u : Kˣ)} =
      Nat.card 𝓀[K] ^ (k + 1) := by
  set e := natCastValuation K 2 h2
  have hmul_idx := Subgroup.relIndex_mul_index
    (unitFiltration_succ_le_ker_unitFiltrationSquareCosetHom h2 k)
  have hindex_H : ((unitFiltration K (e + 1)).subgroupOf (unitFiltration K (e - k))).index =
      Nat.card 𝓀[K] ^ (k + 1) := by
    rw [← Subgroup.relIndex]
    simpa only [show (e - k - 1) + (k + 1) + 1 = e + 1 by omega,
      show (e - k - 1) + 1 = e - k by omega] using
      relIndex_unitFiltration_add_succ_succ (K := K) (e - k - 1) (k + 1)
  have hcard : Nat.card (unitFiltrationSquareCosetHom h2 k).range = _ :=
    Nat.card_congr (Equiv.subtypeEquivRight fun q ↦ by
      simpa only [SetLike.mem_coe, Set.mem_ofPred_eq] using
        Set.ext_iff.mp (range_unitFiltrationSquareCosetHom h2 k) q)
  rw [relIndex_unitFiltration_ker_unitFiltrationSquareCosetHom h2 hk, Subgroup.index_ker,
    hindex_H, hcard] at hmul_idx
  exact hmul_idx

end TauCeti
