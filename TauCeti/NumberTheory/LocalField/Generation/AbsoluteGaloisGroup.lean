module

public import TauCeti.NumberTheory.LocalField.Generation.FiniteQuotient
public import TauCeti.Topology.Algebra.Group.Generation
import TauCeti.Topology.Algebra.Group.Profinite.Generation

/-!
# Topological finite generation of a local absolute Galois group

Let `K` be a finite extension of `ℚ_p`, `N = [K : ℚ_p]`, and `P_K` the wild inertia subgroup of
the absolute Galois group `G_K`. Every finite quotient of `G_K` through which `⁅P_K, P_K⁆` dies
is generated by an `(N + 2)`-tuple (`TauCeti.exists_generating_tuple_quotient`). Since `G_K` is
compact, one `(N + 2)`-tuple of `G_K` generates all of these quotients at once, and so it
topologically generates `G_K` modulo `⁅P_K, P_K⁆`. As `P_K` is pro-`p`, the Frattini argument
along `P_K` removes the commutator, so `G_K` is topologically finitely generated.

This is the passage from the finite quotients to the profinite group in the proof of NSW (7.4.1).
Finite generation is recorded on its own, so that the natural-valued generator rank of `G_K` is
only ever read once its hypothesis is available.

The statement of finite generation mentions neither `p` nor the `ℚ_p`-algebra structure of `K`,
but it is false without them: the absolute Galois group of `𝔽_q((t))` is not topologically
finitely generated. So `p` is included explicitly, together with the instances depending on it.

## Main results

* `TauCeti.exists_tuple_generating_mod_wildInertiaCommutator`: some `(N + 2)`-tuple of `G_K`
  topologically generates `G_K` together with `⁅P_K, P_K⁆`.
* `TauCeti.isTopologicallyFinitelyGenerated_absoluteGaloisGroup`: `G_K` is topologically finitely
  generated.

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, 2nd ed., (3.9.1) and
  (7.4.1).
-/

public section

namespace TauCeti

variable (p : ℕ) [Fact p.Prime] (K : Type) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Algebra ℚ_[p] K] [Module.Finite ℚ_[p] K]
  [ValuativeExtension ℚ_[p] K]

/-- **Passage to the profinite group** (NSW (7.4.1)). For a finite extension `K` of `ℚ_p`, some
`([K : ℚ_p] + 2)`-tuple of `G_K` topologically generates `G_K` together with the commutator
subgroup `⁅P_K, P_K⁆` of wild inertia: by compactness, a single tuple generates every finite
quotient of `G_K` through which `⁅P_K, P_K⁆` dies. -/
theorem exists_tuple_generating_mod_wildInertiaCommutator :
    ∃ x : Fin (Module.finrank ℚ_[p] K + 2) → Field.absoluteGaloisGroup K,
      (Subgroup.closure (Set.range x) ⊔
        ⁅wildInertiaSubgroup K, wildInertiaSubgroup K⁆).topologicalClosure = ⊤ :=
  Subgroup.exists_topologicalClosure_closure_range_sup_eq_top _
    (exists_generating_tuple_quotient p K)

include p in
/-- **The absolute Galois group of a finite extension of `ℚ_p` is topologically finitely
generated**, by a `([K : ℚ_p] + 2)`-tuple: the tuple of
`TauCeti.exists_tuple_generating_mod_wildInertiaCommutator` already generates `G_K` by the
Frattini argument along wild inertia. -/
theorem isTopologicallyFinitelyGenerated_absoluteGaloisGroup :
    IsTopologicallyFinitelyGenerated (Field.absoluteGaloisGroup K) := by
  obtain ⟨x, hx⟩ := exists_tuple_generating_mod_wildInertiaCommutator p K
  exact (Set.finite_range x).isTopologicallyFinitelyGenerated
    (topologicalClosure_eq_top_of_sup_wildInertiaCommutator hx)

end TauCeti
