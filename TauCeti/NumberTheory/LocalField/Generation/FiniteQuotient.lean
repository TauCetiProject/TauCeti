module

public import TauCeti.NumberTheory.LocalField.AbsoluteRamificationIndex
public import TauCeti.NumberTheory.LocalField.Generation.Layer
import TauCeti.Algebra.Group.Subgroup.Closure
import TauCeti.NumberTheory.LocalField.FiniteExtension.IntermediateField
import TauCeti.NumberTheory.Padics.MultiplicativeCompletion.LayerTateModule.Decomposition
import TauCeti.NumberTheory.Padics.MultiplicativeCompletion.RelationModule.Cohomology

/-!
# Generators of finite quotients of a local absolute Galois group

Let `K` be a finite extension of `ℚ_p` and `N = [K : ℚ_p]`. Every finite quotient `G_K ⧸ U` of
the absolute Galois group through which the commutator `⁅P_K, P_K⁆` of wild inertia dies is
generated by an `(N + 2)`-tuple. This is the finite level of the generator theorem for `G_K`,
from which topological generation of `G_K` itself follows by compactness.

The proof is that of NSW (7.4.1). Let `L` be the tame layer of `U`, the fixed field of `P_K U`.
Its Galois group is generated by a tame frame `σ, τ` (`TauCeti.exists_tameFrame_tameLayer`), so
padding the frame to an `(N + 2)`-tuple `g`, the relation module of `g` surjects onto the
completed multiplicative group `A(L)` with kernel free of rank one
(`TauCeti.exists_relationModule_surjective_of_tameFrame`). Read through Lyndon's isomorphism and
local reciprocity, this is a continuous equivariant surjection of pro-`p` relation groups which
is bijective on second cohomology, because its kernel is projective
(`TauCeti.bijective_explicitCoeff2_relationModuleToAbelianizationProPEquivariant`). The extension
dictionary then lifts `g` to generators of `G_K ⧸ U`
(`TauCeti.exists_generating_tuple_quotient_of_galoisClassModuleMap`).

## Main results

* `TauCeti.exists_generating_tuple_quotient`: every finite quotient of `G_K` killing
  `⁅P_K, P_K⁆` is generated by `[K : ℚ_p] + 2` elements, given as a tuple.

## References

* J. Neukirch, A. Schmidt and K. Wingberg, *Cohomology of Number Fields*, 2nd ed., proof of
  (7.4.1).
* Tau Ceti lookahead branch `lookahead/LocalGaloisGroups/exists-generating-tuple-quotient`, split 5:
  source of the final proof structure and of the helper lemmas
  `Subgroup.exists_closure_range_eq_top_of_closure_pair_eq_top` and
  `TauCeti.charP_residueField`.
-/

public section

open _root_.ValuativeRel

namespace TauCeti

variable (p : ℕ) [Fact p.Prime] (K : Type) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Algebra ℚ_[p] K] [Module.Finite ℚ_[p] K]
  [ValuativeExtension ℚ_[p] K]

/-- **The finite level of the generator theorem** (NSW, proof of (7.4.1)). For a finite
extension `K` of `ℚ_p`, every finite quotient of `G_K` through which the commutator subgroup of
wild inertia dies is generated by `[K : ℚ_p] + 2` elements. The generators form a tuple, in which
repetitions are allowed: the quotient may have fewer than `[K : ℚ_p] + 2` elements. -/
theorem exists_generating_tuple_quotient (U : OpenNormalSubgroup (Field.absoluteGaloisGroup K))
    (hU : ⁅wildInertiaSubgroup K, wildInertiaSubgroup K⁆ ≤ U.toSubgroup) :
    ∃ x : Fin (Module.finrank ℚ_[p] K + 2) → Field.absoluteGaloisGroup K ⧸ U.toSubgroup,
      Subgroup.closure (Set.range x) = ⊤ := by
  have := charP_residueField K p
  have := FinitePadicExtension.charZero K p
  have hp : IsUnit (p : K) := (NeZero.ne (p : K)).isUnit
  -- The tame layer `L`, with the local-field structure extending that of `K`.
  let L := tameLayer K U
  let _ := finiteIntermediateFieldValuativeRel K (AlgebraicClosure K) L
  let _ := finiteIntermediateFieldTopology K (AlgebraicClosure K) L
  have := finiteIntermediateField_isNonarchimedeanLocalField K (AlgebraicClosure K) L
  have := finiteIntermediateField_valuativeExtension K (AlgebraicClosure K) L
  have : Module.Finite ℚ_[p] L := Module.Finite.trans K L
  have := ValuativeExtension.trans ℚ_[p] K L
  have : CharZero L := charZero_of_injective_algebraMap (algebraMap ℚ_[p] L).injective
  -- The relation-module surjection of a padded tame frame, with projective kernel.
  obtain ⟨σ, τ, hστ, hτ⟩ := exists_tameFrame_tameLayer K p U
  obtain ⟨g, hg⟩ := Subgroup.exists_closure_range_eq_top_of_closure_pair_eq_top
    (Module.finrank ℚ_[p] K) hστ
  obtain ⟨β, hβ, ⟨e⟩⟩ := exists_relationModule_surjective_of_tameFrame σ τ hστ hτ hg
  have := Module.Projective.of_equiv e.symm
  -- Its transport to the pro-`p` relation groups lifts `g` to generators of `G_K ⧸ U`.
  let j := tameLayerEmbedding K U
  obtain ⟨x, hx, -⟩ := exists_generating_tuple_quotient_of_galoisClassModuleMap K hp U hU g hg
    (relationModuleToAbelianizationProPEquivariant p K L hg β j)
    (continuous_relationModuleToAbelianizationProPEquivariant p K L hg β j)
    ((relationModuleToAbelianizationProPEquivariant_surjective_iff p K L hg β j).mpr hβ)
    (bijective_explicitCoeff2_relationModuleToAbelianizationProPEquivariant p K L hg β j hβ)
  exact ⟨x, hx⟩

end TauCeti
