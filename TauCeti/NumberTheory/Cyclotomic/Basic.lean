module

public import Mathlib.NumberTheory.Cyclotomic.Basic

/-!
# Cyclotomic extensions in towers

If `C` is generated over `A` by roots of unity of orders in `S`, then it is also generated by them
over any intermediate algebra `B`: `IsCyclotomicExtension.tower_top`. This is how a cyclotomic
field `ℚ(μ_n)` becomes a cyclotomic extension of each of its cyclotomic subfields `ℚ(μ_m)`,
`m ∣ n`, so that Mathlib's power basis `IsPrimitiveRoot.powerBasis` applies to the relative
extension `ℚ(μ_n) / ℚ(μ_m)`. Mathlib's degree formula `IsCyclotomicExtension.finrank` does not
apply there, since `Φ_n` need not be irreducible over `ℚ(μ_m)`.

An intermediate field that is a `{1}`-cyclotomic extension of the base is `⊥`:
`IntermediateField.eq_bot_of_isCyclotomicExtension_one`.
-/

public section

namespace IsCyclotomicExtension

/-- **Cyclotomic extensions pass to the top of a tower.** If `C` is an `S`-cyclotomic extension
of `A`, it is an `S`-cyclotomic extension of every intermediate `A`-algebra `B`. -/
theorem tower_top {S : Set ℕ} (A B C : Type*) [CommRing A] [CommRing B] [CommRing C]
    [Algebra A B] [Algebra A C] [Algebra B C] [IsScalarTower A B C]
    [h : IsCyclotomicExtension S A C] : IsCyclotomicExtension S B C := by
  rw [isCyclotomicExtension_iff] at h ⊢
  refine ⟨h.1, fun x ↦ ?_⟩
  have hle : Algebra.adjoin A {b : C | ∃ n ∈ S, n ≠ 0 ∧ b ^ n = 1} ≤
      (Algebra.adjoin B {b : C | ∃ n ∈ S, n ≠ 0 ∧ b ^ n = 1}).restrictScalars A :=
    Algebra.adjoin_le Algebra.subset_adjoin
  exact hle (h.2 x)

end IsCyclotomicExtension

/-- An intermediate field that is a `{1}`-cyclotomic extension of the base field is `⊥`. -/
theorem IntermediateField.eq_bot_of_isCyclotomicExtension_one {F E : Type*} [Field F] [Field E]
    [Algebra F E] (K : IntermediateField F E) [IsCyclotomicExtension {1} F K] : K = ⊥ :=
  eq_bot_iff.mpr fun x hx ↦ by
    obtain ⟨a, ha⟩ : (⟨x, hx⟩ : K) ∈ (⊥ : Subalgebra F K) :=
      IsCyclotomicExtension.singleton_one F K ▸ Algebra.mem_top
    exact ⟨a, congrArg Subtype.val ha⟩
