module

import Mathlib.Data.Nat.Factorization.Induction
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.Coprime.Lemmas

/-!
# Cyclotomic fields lie in finite composita of prime-power towers

The field generated by the `m`-th roots of unity lies in the compositum of the prime-power
cyclotomic towers for the primes dividing `m`. No primitive root or separability hypothesis
is needed. This lets statements about finite composita of towers apply to a cyclotomic
extension with arbitrary nonzero conductor.

## References

* J. S. Milne, *Class Field Theory*, v4.03, Chapter VII, Lemma 8.4.
-/

public section

namespace IntermediateField

open _root_.IntermediateField

/-- The field generated by the `m`-th roots of unity lies in the compositum of the prime-power
cyclotomic towers at the prime divisors of `m`. -/
theorem adjoin_nth_roots_le_iSup_adjoin_prime_pow {K L : Type*} [Field K] [Field L]
    [Algebra K L] {m : ℕ} (hm : m ≠ 0) :
    adjoin K {ζ : L | ζ ^ m = 1} ≤
      ⨆ q : ↥m.primeFactors, adjoin K {ζ : L | ∃ r : ℕ, ζ ^ q.1 ^ r = 1} := by
  let F := ⨆ q : ↥m.primeFactors, adjoin K {ζ : L | ∃ r : ℕ, ζ ^ q.1 ^ r = 1}
  have hroot (n : ℕ) : n ≠ 0 → n ∣ m → ∀ ζ : L, ζ ^ n = 1 → ζ ∈ F := by
    induction n using Nat.recOnPrimeCoprime with
    | zero => simp
    | prime_pow p r hp =>
      intro hn hd ζ hζ
      by_cases hr : r = 0
      · simp only [hr, pow_zero, pow_one] at hζ
        rw [hζ]
        exact one_mem F
      · have hpm : p ∣ m := (dvd_pow_self p hr).trans hd
        have hq : p ∈ m.primeFactors := (Nat.mem_primeFactors_of_ne_zero hm).2 ⟨hp, hpm⟩
        exact (le_iSup (fun q : ↥m.primeFactors ↦
          adjoin K {ζ : L | ∃ r : ℕ, ζ ^ q.1 ^ r = 1}) ⟨p, hq⟩)
            (subset_adjoin K _ ⟨r, hζ⟩)
    | coprime a b ha hb hab ihA ihB =>
      intro hn hd ζ hζ
      have hζ0 : ζ ≠ 0 := by
        intro h
        simp [h, hn] at hζ
      have hA : ζ ^ b ∈ F := ihA (by omega) ((dvd_mul_right a b).trans hd) (ζ ^ b) (by
        simpa only [← pow_mul, mul_comm b a] using hζ)
      have hB : ζ ^ a ∈ F := ihB (by omega) ((dvd_mul_left b a).trans hd) (ζ ^ a) (by
        simpa only [← pow_mul] using hζ)
      obtain ⟨u, v, huv⟩ := hab.isCoprime
      have heq : (ζ ^ a) ^ u * (ζ ^ b) ^ v = ζ := by
        rw [← zpow_natCast, ← zpow_mul, ← zpow_natCast, ← zpow_mul, ← zpow_add₀ hζ0]
        simp only [mul_comm, huv, zpow_one]
      exact heq ▸ mul_mem (zpow_mem hB u) (zpow_mem hA v)
  exact adjoin_le_iff.2 fun ζ hζ ↦ hroot m hm dvd_rfl ζ hζ

end IntermediateField
