/-!
# Compatible cyclotomic towers

Arithmetic with cyclotomic units, such as the distribution relations of the numbers `1 - ζ_m` and
the Euler system they generate, works with one fixed choice of primitive roots of unity
`ζ_m` for all `m ≥ 1`, normalized by `ζ_n ^ (n / m) = ζ_m` whenever `m ∣ n`, and with the
cyclotomic fields `ℚ(ζ_m)` they generate inside one common field. This file packages that choice.

A `TauCeti.CompatibleCyclotomicTower Ω` is a point of the Tate module
`TauCeti.PrimeToPTateModule 1 Ω = lim_m μ_m(Ω)` all of whose components are primitive roots of
unity. Its `m`-th root is `T.root m`. Such a tower exists in every separably closed field of
characteristic zero, and `ℂ` carries the standard one, `ζ_m = exp(2πi / m)`.

Over a subfield `K` of a field `Ω`, the fields of the tower are the intermediate fields
`T.field K m = K(ζ_m)` of `Ω / K`. Each is an `m`-th cyclotomic extension of `K`, generated by
`T.zeta K m`, and equal to `K(μ_m)`, so it does not depend on the tower. For `m ∣ n` the field
`K(ζ_m)` lies in `K(ζ_n)`, and the inclusion `K(ζ_m) → K(ζ_n)` is the unique `K`-embedding sending
`ζ_m` to `ζ_n ^ (n / m)`. Since the fields are intermediate fields of one `Ω`, these inclusions
compose (`IntermediateField.inclusion_inclusion`). The relative norms and Galois groups between
levels are those of the algebras `(IntermediateField.inclusion (T.field_le K h)).toAlgebra`; along
them, restricting an automorphism of `K(ζ_n)` to `K(ζ_m)` reduces its exponent on the roots modulo
`m`.

## Main definitions

* `TauCeti.CompatibleCyclotomicTower Ω`: a compatible family of primitive roots of unity of every
  order in `Ω`.
* `TauCeti.CompatibleCyclotomicTower.root`: its primitive `m`-th root of unity `ζ_m`.
* `TauCeti.CompatibleCyclotomicTower.complex`: the tower `ζ_m = exp(2πi / m)` in `ℂ`.
* `TauCeti.CompatibleCyclotomicTower.field`: the field `K(ζ_m)` as an intermediate field of
  `Ω / K`.
* `TauCeti.CompatibleCyclotomicTower.zeta`: the generator `ζ_m` as an element of `K(ζ_m)`.

## Main results

* `TauCeti.CompatibleCyclotomicTower.root_pow_div`: `ζ_n ^ (n / m) = ζ_m` for `m ∣ n`.
* `TauCeti.CompatibleCyclotomicTower.nonempty_of_forall_exists_isPrimitiveRoot`: a domain with
  primitive roots of unity of every order carries a compatible cyclotomic tower.
* `TauCeti.CompatibleCyclotomicTower.field_eq_adjoin_nth_roots`: `K(ζ_m) = K(μ_m)`.
* The instances `IsCyclotomicExtension {m} K (T.field K m)` and `IsGalois K (T.field K m)`.
* `TauCeti.CompatibleCyclotomicTower.field_le`: `K(ζ_m) ≤ K(ζ_n)` for `m ∣ n`.
* `TauCeti.CompatibleCyclotomicTower.inclusion_zeta` and
  `TauCeti.CompatibleCyclotomicTower.eq_inclusion_of_apply_zeta`: the inclusion `K(ζ_m) → K(ζ_n)`
  sends `ζ_m` to `ζ_n ^ (n / m)`, and is the only `K`-algebra map doing so.
* `TauCeti.CompatibleCyclotomicTower.autToPow_restrictNormal`: if `σ ∈ Gal(K(ζ_n) / K)` sends `ζ_n`
  to `ζ_n ^ a`, its restriction to `K(ζ_m)` sends `ζ_m` to `ζ_m ^ (a mod m)`.

## References

* J. Rodrigues Jacinto, C. Williams, *An introduction to p-adic L-functions*, arXiv:2309.15692,
  §9.
* K. Rubin, *Euler Systems*, Annals of Mathematics Studies 147, Chapter III, §2.1.
-/

public section

noncomputable section

open IntermediateField

namespace TauCeti

/-- A **compatible cyclotomic tower** in `Ω`: primitive `m`-th roots of unity `ζ_m ∈ Ω` for every
`m ≥ 1`, compatible in the sense that `ζ_n ^ (n / m) = ζ_m` whenever `m ∣ n`. It is recorded as a
point `(ζ_m)_m` of the Tate module `lim_m μ_m(Ω)` all of whose components are primitive. -/
structure CompatibleCyclotomicTower (Ω : Type*) [CommMonoid Ω] where
  /-- The compatible family `(ζ_m)_m`, as a point of the Tate module `lim_m μ_m(Ω)`. -/
  point : PrimeToPTateModule 1 Ω
  /-- Each component `ζ_m` of the family is a primitive `m`-th root of unity. -/
  isPrimitiveRoot_proj (m : {m : ℕ // m ≠ 0 ∧ m.Coprime 1}) :
    IsPrimitiveRoot (PrimeToPTateModule.proj m point : Ωˣ) m

namespace CompatibleCyclotomicTower

section Roots

variable {Ω : Type*} [CommMonoid Ω] (T : CompatibleCyclotomicTower Ω)

/-- The primitive `m`-th root of unity `ζ_m` of a compatible cyclotomic tower, for `m ≠ 0`. -/
def root (m : ℕ) [NeZero m] : Ω :=
  (PrimeToPTateModule.proj ⟨m, NeZero.ne m, Nat.coprime_one_right m⟩ T.point : Ωˣ)

/-- The components of the point of the Tate module underlying a tower are its roots. -/
theorem coe_proj_point (m : {m : ℕ // m ≠ 0 ∧ m.Coprime 1}) [NeZero (m : ℕ)] :
    ((PrimeToPTateModule.proj m T.point : Ωˣ) : Ω) = T.root m :=
  (rfl)

/-- `ζ_m` is a primitive `m`-th root of unity. -/
theorem isPrimitiveRoot_root (m : ℕ) [NeZero m] : IsPrimitiveRoot (T.root m) m :=
  IsPrimitiveRoot.coe_units_iff.2 (T.isPrimitiveRoot_proj _)

/-- **Compatibility of the roots**: `ζ_n ^ (n / m) = ζ_m` whenever `m ∣ n`. -/
theorem root_pow_div {m n : ℕ} [NeZero m] [NeZero n] (h : m ∣ n) :
    T.root n ^ (n / m) = T.root m := by
  rw [root, root, ← Units.val_pow_eq_pow_val]
  exact congrArg Units.val (PrimeToPTateModule.proj_pow_div T.point
    (m := ⟨n, NeZero.ne n, Nat.coprime_one_right n⟩)
    (n := ⟨m, NeZero.ne m, Nat.coprime_one_right m⟩) h)

/-- **Compatibility of the roots** in multiplicative form: `ζ_{mk} ^ k = ζ_m`. -/
theorem root_mul_pow (m k : ℕ) [NeZero m] [NeZero k] : T.root (m * k) ^ k = T.root m := by
  simpa [Nat.mul_div_cancel_left k (NeZero.pos m)] using T.root_pow_div (dvd_mul_right m k)

/-- The first root of a tower is `ζ_1 = 1`. -/
@[simp]
theorem root_one : T.root 1 = 1 :=
  IsPrimitiveRoot.one_right_iff.1 (T.isPrimitiveRoot_root 1)

/-- A compatible cyclotomic tower is determined by its roots. -/
@[ext]
theorem ext {T T' : CompatibleCyclotomicTower Ω} (h : ∀ (m : ℕ) [NeZero m], T.root m = T'.root m) :
    T = T' := by
  obtain ⟨x, hx⟩ := T
  obtain ⟨y, hy⟩ := T'
  congr 1
  refine PrimeToPTateModule.ext fun m ↦ ?_
  have : NeZero (m : ℕ) := ⟨m.property.1⟩
  exact Subtype.ext (Units.ext (h m))

end Roots

section Existence

/-- **Compatible cyclotomic towers exist** in every domain `R` with a primitive `m`-th root of unity
for every `m ≠ 0`: the primitive roots can be chosen with `ζ_n ^ (n / m) = ζ_m` for all `m ∣ n`. -/
theorem nonempty_of_forall_exists_isPrimitiveRoot {R : Type*} [CommRing R] [IsDomain R]
    (h : ∀ m : ℕ, m ≠ 0 → ∃ ζ : R, IsPrimitiveRoot ζ m) :
    Nonempty (CompatibleCyclotomicTower R) :=
  have ⟨ζ, hζ⟩ := PrimeToPTateModule.exists_forall_isPrimitiveRoot (p := 1) fun m ↦ h m m.property.1
  ⟨⟨ζ, hζ⟩⟩

/-- A separably closed field of characteristic zero, such as an algebraic closure of `ℚ` or of
`ℚ_p`, carries a compatible cyclotomic tower. -/
instance {Ω : Type*} [Field Ω] [IsSepClosed Ω] [CharZero Ω] :
    Nonempty (CompatibleCyclotomicTower Ω) :=
  nonempty_of_forall_exists_isPrimitiveRoot fun m hm ↦
    have : NeZero m := ⟨hm⟩
    HasEnoughRootsOfUnity.exists_isPrimitiveRoot Ω m

open Complex Real in
/-- The **standard compatible cyclotomic tower** in `ℂ`, with roots `ζ_m = exp(2πi / m)`. -/
def complex : CompatibleCyclotomicTower ℂ :=
  ⟨PrimeToPTateModule.complexExp 1, PrimeToPTateModule.isPrimitiveRoot_proj_complexExp 1⟩

open Complex Real in
/-- The roots of the standard tower in `ℂ` are `ζ_m = exp(2πi / m)`. -/
@[simp]
theorem root_complex (m : ℕ) [NeZero m] : complex.root m = exp (2 * π * I / m) :=
  PrimeToPTateModule.coe_proj_complexExp 1 _

end Existence

/-- The second root of a tower is `ζ_2 = -1`. -/
@[simp]
theorem root_two {Ω : Type*} [CommRing Ω] [NoZeroDivisors Ω] (T : CompatibleCyclotomicTower Ω) :
    T.root 2 = -1 :=
  (T.isPrimitiveRoot_root 2).eq_neg_one_of_two_right

section Field

variable {Ω : Type*} [Field Ω] (T : CompatibleCyclotomicTower Ω)
variable (K : Type*) [Field K] [Algebra K Ω]

/-- The `m`-th field `K(ζ_m)` of a compatible cyclotomic tower, an intermediate field of `Ω / K`.
It is `K(μ_m)` (`TauCeti.CompatibleCyclotomicTower.field_eq_adjoin_nth_roots`), so it does not
depend on the tower. -/
def field (m : ℕ) [NeZero m] : IntermediateField K Ω :=
  K⟮T.root m⟯

theorem field_def (m : ℕ) [NeZero m] : T.field K m = K⟮T.root m⟯ :=
  (rfl)

theorem root_mem_field (m : ℕ) [NeZero m] : T.root m ∈ T.field K m :=
  mem_adjoin_simple_self K _

/-- `K(ζ_m) = K(μ_m)`: the `m`-th field of a tower is generated over `K` by all the `m`-th roots of
unity of `Ω`, independently of the tower. -/
theorem field_eq_adjoin_nth_roots (m : ℕ) [NeZero m] :
    T.field K m = adjoin K {x : Ω | x ^ m = 1} :=
  (T.isPrimitiveRoot_root m).adjoin_singleton_eq_adjoin_nth_roots

/-- The first field of a tower is `K(ζ_1) = K`. -/
@[simp]
theorem field_one : T.field K 1 = ⊥ := by
  rw [field_def, root_one, adjoin_simple_eq_bot_iff]
  exact one_mem _

/-- The second field of a tower is `K(ζ_2) = K`. -/
@[simp]
theorem field_two : T.field K 2 = ⊥ := by
  rw [field_def, root_two, adjoin_simple_eq_bot_iff]
  exact neg_mem (one_mem _)

/-- The generator `ζ_m` of the `m`-th field `K(ζ_m)` of a tower. -/
def zeta (m : ℕ) [NeZero m] : T.field K m :=
  ⟨T.root m, T.root_mem_field K m⟩

@[simp]
theorem coe_zeta (m : ℕ) [NeZero m] : (T.zeta K m : Ω) = T.root m :=
  (rfl)

/-- The generator `ζ_m` of `K(ζ_m)` is a primitive `m`-th root of unity. -/
theorem isPrimitiveRoot_zeta (m : ℕ) [NeZero m] : IsPrimitiveRoot (T.zeta K m) m :=
  IsPrimitiveRoot.coe_submonoidClass_iff.1 (T.isPrimitiveRoot_root m)

/-- `K(ζ_m)` is an `m`-th cyclotomic extension of `K`. -/
instance (m : ℕ) [NeZero m] : IsCyclotomicExtension {m} K (T.field K m) :=
  (T.isPrimitiveRoot_root m).isCyclotomicExtension_adjoin_singleton

instance (m : ℕ) [NeZero m] : FiniteDimensional K (T.field K m) :=
  IsCyclotomicExtension.finiteDimensional {m} K _

instance (m : ℕ) [NeZero m] : IsGalois K (T.field K m) :=
  IsCyclotomicExtension.isGalois {m} K _

/-- The fields of a tower increase along divisibility: `K(ζ_m) ≤ K(ζ_n)` when `m ∣ n`. -/
theorem field_le {m n : ℕ} [NeZero m] [NeZero n] (h : m ∣ n) : T.field K m ≤ T.field K n :=
  adjoin_simple_le_iff.2 (T.root_pow_div h ▸ pow_mem (T.root_mem_field K n) _)

/-- The inclusion `K(ζ_m) → K(ζ_n)`, for `m ∣ n`, sends `ζ_m` to `ζ_n ^ (n / m)`. -/
@[simp]
theorem inclusion_zeta {m n : ℕ} [NeZero m] [NeZero n] (h : m ∣ n) :
    inclusion (T.field_le K h) (T.zeta K m) = T.zeta K n ^ (n / m) :=
  Subtype.ext (by simp [T.root_pow_div h])

/-- **The inclusion is specified by the compatibility of the roots**: a `K`-algebra map
`K(ζ_m) → K(ζ_n)` sending `ζ_m` to `ζ_n ^ (n / m)` is the inclusion. -/
theorem eq_inclusion_of_apply_zeta {m n : ℕ} [NeZero m] [NeZero n] (h : m ∣ n)
    {f : T.field K m →ₐ[K] T.field K n} (hf : f (T.zeta K m) = T.zeta K n ^ (n / m)) :
    f = inclusion (T.field_le K h) :=
  adjoin_algHom_ext K fun x hx ↦ by
    obtain rfl : x = T.root m := hx
    exact hf.trans (T.inclusion_zeta K h).symm

/-- **The Galois actions are compatible along the tower.** For `m ∣ n`, if an automorphism of
`K(ζ_n) / K` raises `ζ_n` to the power `a`, then its restriction to `K(ζ_m)` raises `ζ_m` to the
power `a` modulo `m`; here `K(ζ_n)` is a `K(ζ_m)`-algebra through the inclusion. -/
theorem autToPow_restrictNormal {m n : ℕ} [NeZero m] [NeZero n] (h : m ∣ n)
    (σ : T.field K n ≃ₐ[K] T.field K n) :
    letI := (inclusion (T.field_le K h)).toAlgebra
    haveI : IsScalarTower K (T.field K m) (T.field K n) := IsScalarTower.of_algebraMap_eq' rfl
    (T.isPrimitiveRoot_zeta K m).autToPow K (σ.restrictNormal (T.field K m)) =
      ZMod.unitsMap h ((T.isPrimitiveRoot_zeta K n).autToPow K σ) :=
  letI := (inclusion (T.field_le K h)).toAlgebra
  haveI : IsScalarTower K (T.field K m) (T.field K n) := IsScalarTower.of_algebraMap_eq' rfl
  (T.isPrimitiveRoot_zeta K n).autToPow_restrictNormal h (T.isPrimitiveRoot_zeta K m)
    (T.inclusion_zeta K h) σ

end Field

end CompatibleCyclotomicTower

end TauCeti
