/-!
# The Stickelberger element and the integral Stickelberger ideal

Let `m` be a positive integer and `G = (ZMod m)ˣ`, which Mathlib identifies with the Galois group
of the `m`-th cyclotomic field through `σ_a ζ = ζ ^ a`. For a unit `a` write `a₀ ∈ {0, …, m - 1}`
for its least nonnegative representative (`ZMod.val`) and `[a]` for the basis element
`MonoidAlgebra.single a 1` of a group ring. The **rational Stickelberger element** is

  `θ_m = ∑_a (a₀ / m) [a⁻¹] ∈ ℚ[G]`,

with the inverse on the group-ring basis, so that its coefficient at `[b]` is `(b⁻¹)₀ / m`.
Stickelberger's theorem states that the integral elements of `ℤ[G] θ_m` annihilate the ideal class
group of the `m`-th cyclotomic field, on which `G` acts covariantly. This file develops the
group-ring side of that statement at every conductor.

The **denominator ideal** `J_m` consists of the integral multipliers `x ∈ ℤ[G]` for which `x θ_m`
has integral coefficients, and the **integral Stickelberger ideal** `I_m` consists of the resulting
products, `I_m = ℤ[G] θ_m ∩ ℤ[G]` inside `ℚ[G]`; the multipliers range over `ℤ[G]`, not `ℚ[G]`.
The two ideals differ in general: at `m = 2` the group is trivial, `θ_2 = 1 / 2`, `J_2 = 2ℤ` and
`I_2 = ℤ`. For `b` prime to `m`, the **positive smoothing** `(b - [b]) θ_m` is the explicit integral
element `∑_a ⌊b a₀ / m⌋ [a⁻¹]` of `I_m`.

## Main definitions

* `TauCeti.stickelberger m`: the rational Stickelberger element `θ_m ∈ ℚ[(ZMod m)ˣ]`.
* `TauCeti.stickelbergerDenominatorIdeal m`: the denominator ideal `J_m` of `ℤ[(ZMod m)ˣ]`.
* `TauCeti.stickelbergerIdeal m`: the integral Stickelberger ideal `I_m` of `ℤ[(ZMod m)ˣ]`.
* `TauCeti.stickelbergerMul m`: the surjective `ℤ[G]`-linear map `J_m → I_m`, `x ↦ x θ_m`.
* `TauCeti.smoothedStickelberger m b`: the integral element `∑_a ⌊b a₀ / m⌋ [a⁻¹]`.

## Main results

* `TauCeti.coeff_stickelberger`: the coefficient of `θ_m` at `[b]` is `(b⁻¹)₀ / m`.
* `TauCeti.one_add_single_neg_one_mul_stickelberger`: `(1 + [-1]) θ_m = ∑_a [a]` for `m ≥ 2`.
* `TauCeti.lift_one_stickelberger`: the augmentation of `θ_m` is `φ(m) / 2` for `m ≥ 2`.
* `TauCeti.lift_stickelberger_eq_generalizedBernoulli`: a nontrivial Dirichlet character `χ`
  modulo `m` evaluates `θ_m` to `B_{1, χ⁻¹}`.
* `TauCeti.mem_stickelbergerDenominatorIdeal_iff_dvd`: `∑ nₐ [a] ∈ J_m ↔ m ∣ ∑ nₐ a₀`.
* `TauCeti.stickelbergerDenominatorIdeal_eq_span`: `J_m` is generated by the `[b] - b` for the
  natural numbers `b` prime to `m`.
* `TauCeti.mapRingHom_smoothedStickelberger`: `∑_a ⌊b a₀ / m⌋ [a⁻¹] = (b - [b]) θ_m` for `b` prime
  to `m`, so `TauCeti.smoothedStickelberger_mem_stickelbergerIdeal`.
* `TauCeti.smoothedStickelberger_mul`: `s_{bd} = b s_d + [d] s_b` for `d` prime to `m`.

## Implementation notes

The coefficient extension `ℤ[G] → ℚ[G]` is `MonoidAlgebra.mapRingHom (ZMod m)ˣ (Int.castRingHom ℚ)`,
which is injective by `MonoidAlgebra.map_injective`; both ideals are defined through it. Since the
multiplier `[b] - b` depends on the integer `b` and not only on its residue, the generating set of
`J_m` is indexed by natural numbers: `b = 1 + m` gives the generator `-m`.

## References

* R. Sharifi, *Iwasawa theory*, Definition 4.5.1 and Lemma 4.5.2.
* L. C. Washington, *Introduction to Cyclotomic Fields*, 2nd ed., §6.2.
* The prime-conductor element, with the same inverse-basis convention, appears in the AINTLIB
  project (Chris Birkbeck, `github.com/CBirkbeck/AINTLIB`) as
  `BernoulliRegular.stickelbergerElement`.
-/

public section

open MonoidAlgebra

namespace TauCeti

variable (m : ℕ) [NeZero m]

/-- **The rational Stickelberger element** `θ_m = ∑_a (a₀ / m) [a⁻¹]` in the rational group ring
of `(ZMod m)ˣ`, where `a₀ = (a : ZMod m).val ∈ {0, …, m - 1}`. The basis element carries the inverse
`a⁻¹`. -/
noncomputable def stickelberger : MonoidAlgebra ℚ (ZMod m)ˣ :=
  ∑ a : (ZMod m)ˣ, single a⁻¹ (((a : ZMod m).val : ℚ) / m)

/-- The defining finite sum of the Stickelberger element. -/
theorem stickelberger_def :
    stickelberger m = ∑ a : (ZMod m)ˣ, single a⁻¹ (((a : ZMod m).val : ℚ) / m) :=
  (rfl)

variable {m}

/-- The coefficient of `θ_m` at `[b]` is `(b⁻¹)₀ / m`. -/
@[simp]
theorem coeff_stickelberger (b : (ZMod m)ˣ) :
    (stickelberger m).coeff b = ((((b⁻¹ : (ZMod m)ˣ) : ZMod m).val : ℚ) / m) := by
  classical
  rw [stickelberger_def, coeff_sum]
  simp [Finsupp.single_apply, inv_eq_iff_eq_inv]

/-- **The conjugation formula.** For `m ≥ 2`, `(1 + [-1]) θ_m` is the norm element `∑_a [a]` of the
group ring: the representatives of `a` and `-a` add up to `m`. At `m = 2` the unit `-1` is `1`. -/
theorem one_add_single_neg_one_mul_stickelberger (hm : 2 ≤ m) :
    (1 + single (-1) 1) * stickelberger m = ∑ a : (ZMod m)ˣ, single a 1 := by
  classical
  have : Fact (1 < m) := ⟨hm⟩
  ext b
  have hb : (((b⁻¹ : (ZMod m)ˣ) : ZMod m)).val + (-((b⁻¹ : (ZMod m)ˣ) : ZMod m)).val = m := by
    have : NeZero ((b⁻¹ : (ZMod m)ˣ) : ZMod m) := ⟨Units.ne_zero _⟩
    rw [ZMod.val_neg_of_ne_zero]
    have := ZMod.val_lt ((b⁻¹ : (ZMod m)ˣ) : ZMod m)
    omega
  rw [add_mul, one_mul, coeff_add, Finsupp.add_apply, coeff_single_mul_apply, coeff_stickelberger,
    coeff_stickelberger, coeff_sum]
  simp only [mul_inv_rev, inv_inv, mul_neg_one, Units.val_neg, one_mul, coeff_single,
    Finsupp.finsetSum_apply, Finsupp.single_apply, Finset.sum_ite_eq',
    Finset.mem_univ, ite_true]
  rw [← add_div, ← Nat.cast_add, hb, div_self (by exact_mod_cast NeZero.ne m)]

/-- The value of `θ_m` under the algebra map `ℚ[G] → R` extending a monoid homomorphism
`ψ : G →* R`. -/
theorem lift_stickelberger {R : Type*} [Semiring R] [Algebra ℚ R] (ψ : (ZMod m)ˣ →* R) :
    lift ℚ R (ZMod m)ˣ ψ (stickelberger m) =
      ∑ a : (ZMod m)ˣ, (((a : ZMod m).val : ℚ) / m) • ψ a⁻¹ := by
  simp [stickelberger_def, lift_single]

/-- **The augmentation formula.** For `m ≥ 2` the sum of the coefficients of `θ_m` is `φ(m) / 2`.
At `m = 1` it is `0`, since then `θ_1 = 0`. -/
theorem lift_one_stickelberger (hm : 2 ≤ m) :
    lift ℚ ℚ (ZMod m)ˣ 1 (stickelberger m) = m.totient / 2 := by
  have h := congrArg (lift ℚ ℚ (ZMod m)ˣ 1) (one_add_single_neg_one_mul_stickelberger hm)
  simp only [map_mul, map_add, map_one, map_sum, lift_single, MonoidHom.one_apply, smul_eq_mul,
    mul_one, Finset.sum_const, Finset.card_univ, ZMod.card_units_eq_totient, nsmul_eq_mul] at h
  linarith

/-- **The character evaluation.** A nontrivial Dirichlet character `χ` modulo `m`, restricted to
`(ZMod m)ˣ`, sends `θ_m` to the generalized Bernoulli number `B_{1, χ⁻¹} = m⁻¹ ∑_a a₀ χ⁻¹(a)` at
modulus `m`. The character need not be primitive. -/
theorem lift_stickelberger_eq_generalizedBernoulli {R : Type*} [CommRing R] [IsDomain R]
    [Algebra ℚ R] {χ : DirichletCharacter R m} (hχ : χ ≠ 1) :
    lift ℚ R (ZMod m)ˣ (χ.toMonoidHom.comp (Units.coeHom (ZMod m))) (stickelberger m) =
      χ⁻¹.generalizedBernoulli 1 := by
  rw [lift_stickelberger, DirichletCharacter.generalizedBernoulli_one_of_ne_one (inv_ne_one.mpr hχ)]
  refine Fintype.sum_of_injective (fun a : (ZMod m)ˣ ↦ (a : ZMod m)) Units.val_injective _ _
    (fun x hx ↦ ?_) (fun a ↦ ?_)
  · rw [MulChar.map_nonunit _ (fun hu ↦ hx ⟨hu.unit, rfl⟩), zero_mul]
  · simp [MulChar.inv_apply, Algebra.smul_def, mul_comm]

variable (m) in
/-- **The denominator ideal** `J_m`: the integral multipliers `x ∈ ℤ[(ZMod m)ˣ]` for which `x θ_m`
has integral coefficients, that is, is the image of an element of the integral group ring. -/
noncomputable def stickelbergerDenominatorIdeal : Ideal (MonoidAlgebra ℤ (ZMod m)ˣ) where
  carrier := {x | ∃ y, mapRingHom _ (Int.castRingHom ℚ) y =
    mapRingHom _ (Int.castRingHom ℚ) x * stickelberger m}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro x x' ⟨y, hy⟩ ⟨y', hy'⟩
    exact ⟨y + y', by simp only [map_add, hy, hy', add_mul]⟩
  smul_mem' := by
    rintro r x ⟨y, hy⟩
    exact ⟨r * y, by simp only [smul_eq_mul, map_mul, hy, mul_assoc]⟩

/-- The membership criterion of the denominator ideal. -/
theorem mem_stickelbergerDenominatorIdeal_iff {x : MonoidAlgebra ℤ (ZMod m)ˣ} :
    x ∈ stickelbergerDenominatorIdeal m ↔ ∃ y, mapRingHom _ (Int.castRingHom ℚ) y =
      mapRingHom _ (Int.castRingHom ℚ) x * stickelberger m :=
  Iff.rfl

variable (m) in
/-- **The integral Stickelberger ideal** `I_m = ℤ[G] θ_m ∩ ℤ[G]`: the elements `y` of the integral
group ring of `G = (ZMod m)ˣ` whose image in `ℚ[G]` is `x θ_m` for an integral multiplier
`x ∈ ℤ[G]`. -/
noncomputable def stickelbergerIdeal : Ideal (MonoidAlgebra ℤ (ZMod m)ˣ) where
  carrier := {y | ∃ x, mapRingHom _ (Int.castRingHom ℚ) y =
    mapRingHom _ (Int.castRingHom ℚ) x * stickelberger m}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro y y' ⟨x, hx⟩ ⟨x', hx'⟩
    exact ⟨x + x', by simp only [map_add, hx, hx', add_mul]⟩
  smul_mem' := by
    rintro r y ⟨x, hx⟩
    exact ⟨r * x, by simp only [smul_eq_mul, map_mul, hx, mul_assoc]⟩

/-- The membership criterion of the integral Stickelberger ideal. -/
theorem mem_stickelbergerIdeal_iff {y : MonoidAlgebra ℤ (ZMod m)ˣ} :
    y ∈ stickelbergerIdeal m ↔ ∃ x, mapRingHom _ (Int.castRingHom ℚ) y =
      mapRingHom _ (Int.castRingHom ℚ) x * stickelberger m :=
  Iff.rfl

omit [NeZero m] in
/-- Coefficient extension from `ℤ[G]` to `ℚ[G]` is injective. -/
private theorem mapRingHom_intCast_injective :
    Function.Injective (mapRingHom (ZMod m)ˣ (Int.castRingHom ℚ)) := by
  rw [coe_mapRingHom]
  exact map_injective (Int.castRingHom ℚ : ℤ →+ ℚ) Int.cast_injective

variable (m) in
/-- **The integral Stickelberger multiplication map** `J_m → I_m`, sending a multiplier `x` to the
unique integral element whose image in `ℚ[G]` is `x θ_m`. -/
noncomputable def stickelbergerMul :
    stickelbergerDenominatorIdeal m →ₗ[MonoidAlgebra ℤ (ZMod m)ˣ] stickelbergerIdeal m where
  toFun x := ⟨x.property.choose, x.val, x.property.choose_spec⟩
  map_add' x x' := Subtype.ext <| mapRingHom_intCast_injective <|
    (x + x').property.choose_spec.trans <| by
      simp only [Submodule.coe_add, map_add, x.property.choose_spec, x'.property.choose_spec,
        add_mul]
  map_smul' r x := Subtype.ext <| mapRingHom_intCast_injective <|
    (r • x).property.choose_spec.trans <| by
      simp only [SetLike.val_smul, smul_eq_mul, RingHom.id_apply, map_mul, x.property.choose_spec,
        mul_assoc]

/-- The integral Stickelberger multiplication map is multiplication by `θ_m`. -/
@[simp]
theorem mapRingHom_stickelbergerMul (x : stickelbergerDenominatorIdeal m) :
    mapRingHom _ (Int.castRingHom ℚ) (stickelbergerMul m x : MonoidAlgebra ℤ (ZMod m)ˣ) =
      mapRingHom _ (Int.castRingHom ℚ) (x : MonoidAlgebra ℤ (ZMod m)ˣ) * stickelberger m :=
  x.property.choose_spec

/-- Multiplication by `θ_m` maps the denominator ideal onto the integral Stickelberger ideal. -/
theorem stickelbergerMul_surjective : Function.Surjective (stickelbergerMul m) := by
  rintro ⟨y, x, hx⟩
  exact ⟨⟨x, y, hx⟩, Subtype.ext <| mapRingHom_intCast_injective <|
    (mapRingHom_stickelbergerMul _).trans hx.symm⟩

/-- The coefficients of `x θ_m` for an integral multiplier `x`. -/
private theorem coeff_mapRingHom_mul_stickelberger (x : MonoidAlgebra ℤ (ZMod m)ˣ)
    (b : (ZMod m)ˣ) : (mapRingHom _ (Int.castRingHom ℚ) x * stickelberger m).coeff b =
      ((∑ a : (ZMod m)ˣ, x.coeff a * (((b⁻¹ * a : (ZMod m)ˣ) : ZMod m).val : ℤ) : ℤ) : ℚ) / m := by
  rw [coeff_mul_apply_left, Finsupp.sum_fintype _ _ (by simp)]
  simp [Finset.sum_div, mul_div_assoc]

/-- **The denominator congruence.** A multiplier `x = ∑ nₐ [a]` lies in the denominator ideal
exactly when `∑ nₐ a = 0` in `ZMod m`. -/
theorem mem_stickelbergerDenominatorIdeal_iff_sum_eq_zero {x : MonoidAlgebra ℤ (ZMod m)ˣ} :
    x ∈ stickelbergerDenominatorIdeal m ↔ ∑ a : (ZMod m)ˣ, (x.coeff a : ZMod m) * a = 0 := by
  have hrange (z : MonoidAlgebra ℚ (ZMod m)ˣ) :
      (∃ y, mapRingHom _ (Int.castRingHom ℚ) y = z) ↔ ∀ b, ∃ n : ℤ, (n : ℚ) = z.coeff b := by
    have := Set.ext_iff.mp (range_map (M := (ZMod m)ˣ) (Int.castRingHom ℚ : ℤ →+ ℚ)) z
    simpa [coe_mapRingHom] using this
  have key (b : (ZMod m)ˣ) :
      ((∑ a : (ZMod m)ˣ, x.coeff a * (((b⁻¹ * a : (ZMod m)ˣ) : ZMod m).val : ℤ) : ℤ) : ZMod m) =
        (b⁻¹ : (ZMod m)ˣ) * ∑ a : (ZMod m)ˣ, (x.coeff a : ZMod m) * a := by
    push_cast
    rw [Finset.mul_sum]
    simp [ZMod.natCast_val, mul_left_comm]
  have hint (z : ℤ) : (∃ n : ℤ, (n : ℚ) = z / m) ↔ (z : ZMod m) = 0 := by
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd, ← Rat.den_div_intCast_eq_one_iff z m
      (by exact_mod_cast NeZero.ne m), Int.cast_natCast, Rat.den_eq_one_iff]
    exact ⟨fun ⟨n, hn⟩ ↦ hn ▸ Rat.num_intCast n ▸ rfl, fun h ↦ ⟨_, h⟩⟩
  rw [mem_stickelbergerDenominatorIdeal_iff, hrange]
  simp only [coeff_mapRingHom_mul_stickelberger, hint, key,
    Units.mul_right_eq_zero]
  exact ⟨fun h ↦ h 1, fun h _ ↦ h⟩

/-- **The denominator congruence**, as a divisibility of integers: `x = ∑ nₐ [a]` lies in the
denominator ideal exactly when `m ∣ ∑ nₐ a₀`, where `a₀ ∈ {0, …, m - 1}` represents `a`. -/
theorem mem_stickelbergerDenominatorIdeal_iff_dvd {x : MonoidAlgebra ℤ (ZMod m)ˣ} :
    x ∈ stickelbergerDenominatorIdeal m ↔
      (m : ℤ) ∣ ∑ a : (ZMod m)ˣ, x.coeff a * ((a : ZMod m).val : ℤ) := by
  rw [mem_stickelbergerDenominatorIdeal_iff_sum_eq_zero, ← ZMod.intCast_zmod_eq_zero_iff_dvd]
  push_cast
  simp [ZMod.natCast_val]

/-- The conductor `m` lies in the denominator ideal: `m θ_m = ∑_a a₀ [a⁻¹]` is integral. -/
theorem natCast_mem_stickelbergerDenominatorIdeal :
    (m : MonoidAlgebra ℤ (ZMod m)ˣ) ∈ stickelbergerDenominatorIdeal m := by
  classical
  rw [mem_stickelbergerDenominatorIdeal_iff_sum_eq_zero]
  simp [natCast_def, Finsupp.single_apply]

variable (m) in
/-- **Generators of the denominator ideal.** It is spanned by the elements `[b] - b` for the
natural numbers `b` prime to `m`. -/
theorem stickelbergerDenominatorIdeal_eq_span :
    stickelbergerDenominatorIdeal m = Ideal.span (Set.range fun b : {b : ℕ // b.Coprime m} ↦
      single (ZMod.unitOfCoprime b.val b.property) 1 - (b.val : MonoidAlgebra ℤ (ZMod m)ˣ)) := by
  classical
  set g : {b : ℕ // b.Coprime m} → MonoidAlgebra ℤ (ZMod m)ˣ := fun b ↦
    single (ZMod.unitOfCoprime b.val b.property) 1 - (b.val : MonoidAlgebra ℤ (ZMod m)ˣ) with hg
  refine le_antisymm (fun x hx ↦ ?_) (Ideal.span_le.mpr ?_)
  · obtain ⟨k, hk⟩ := mem_stickelbergerDenominatorIdeal_iff_dvd.mp hx
    -- Each `[a] - a₀` is a generator, and `m = -([1] - (1 + m))` is one up to sign.
    have hga (a : (ZMod m)ˣ) : single a 1 - (((a : ZMod m).val : ℕ) : MonoidAlgebra ℤ (ZMod m)ˣ) =
        g ⟨_, ZMod.val_coe_unit_coprime a⟩ := by
      simp only [hg]
      congr
      ext
      simp
    have hgm : g ⟨1 + m, Nat.coprime_add_self_left.mpr (Nat.coprime_one_left m)⟩ =
        -(m : MonoidAlgebra ℤ (ZMod m)ˣ) := by
      have : ZMod.unitOfCoprime (1 + m) (Nat.coprime_add_self_left.mpr (Nat.coprime_one_left m)) =
          1 := by
        ext
        simp
      simp only [hg, this, ← one_def]
      push_cast
      ring
    have hx' : x = ∑ a : (ZMod m)ˣ, x.coeff a • g ⟨_, ZMod.val_coe_unit_coprime a⟩ -
        k • g ⟨1 + m, Nat.coprime_add_self_left.mpr (Nat.coprime_one_left m)⟩ := by
      have hsum : ∑ a : (ZMod m)ˣ, x.coeff a • (single a 1 -
          (((a : ZMod m).val : ℕ) : MonoidAlgebra ℤ (ZMod m)ˣ)) =
            x - ((m * k : ℤ) : MonoidAlgebra ℤ (ZMod m)ˣ) := by
        rw [← hk, Int.cast_sum]
        simp only [smul_sub, Finset.sum_sub_distrib, smul_single, smul_eq_mul, mul_one]
        simp only [zsmul_eq_mul, Int.cast_mul, Int.cast_natCast]
        congr 1
        conv_rhs => rw [← sum_coeff_single x, Finsupp.sum_fintype _ _ (by simp)]
      simp only [← hga, hgm, hsum]
      push_cast
      ring
    rw [hx']
    exact sub_mem (Ideal.sum_mem _ fun a _ ↦ zsmul_mem (Ideal.subset_span (Set.mem_range_self _)) _)
      (zsmul_mem (Ideal.subset_span (Set.mem_range_self _)) _)
  · rintro _ ⟨b, rfl⟩
    rw [SetLike.mem_coe, mem_stickelbergerDenominatorIdeal_iff_sum_eq_zero]
    simp [hg, natCast_def, Finsupp.single_apply, sub_mul]

variable (m) in
/-- **The positive smoothed Stickelberger element** `s_{m,b} = ∑_a ⌊b a₀ / m⌋ [a⁻¹]` in the integral
group ring of `(ZMod m)ˣ`, the floor being the natural-number quotient. For `b` prime to `m` it is
`(b - [b]) θ_m` (`mapRingHom_smoothedStickelberger`); the definition makes sense for every `b`, and
`b` is not reduced modulo `m`. -/
noncomputable def smoothedStickelberger (b : ℕ) : MonoidAlgebra ℤ (ZMod m)ˣ :=
  ∑ a : (ZMod m)ˣ, single a⁻¹ ((b * (a : ZMod m).val / m : ℕ) : ℤ)

variable (m) in
/-- The defining finite sum of the positive smoothed Stickelberger element. -/
theorem smoothedStickelberger_def (b : ℕ) :
    smoothedStickelberger m b = ∑ a : (ZMod m)ˣ, single a⁻¹ ((b * (a : ZMod m).val / m : ℕ) : ℤ) :=
  (rfl)

/-- The coefficient of `s_{m,b}` at `[c]` is `⌊b (c⁻¹)₀ / m⌋`. -/
@[simp]
theorem coeff_smoothedStickelberger (b : ℕ) (c : (ZMod m)ˣ) :
    (smoothedStickelberger m b).coeff c =
      ((b * ((c⁻¹ : (ZMod m)ˣ) : ZMod m).val / m : ℕ) : ℤ) := by
  classical
  rw [smoothedStickelberger_def, coeff_sum]
  simp [Finsupp.single_apply, inv_eq_iff_eq_inv]

/-- **The rational smoothing identity.** For `b` prime to `m`,
`∑_a ⌊b a₀ / m⌋ [a⁻¹] = (b - [b]) θ_m` in `ℚ[(ZMod m)ˣ]`. -/
theorem mapRingHom_smoothedStickelberger {b : ℕ} (hb : b.Coprime m) :
    mapRingHom _ (Int.castRingHom ℚ) (smoothedStickelberger m b) =
      ((b : MonoidAlgebra ℚ (ZMod m)ˣ) - single (ZMod.unitOfCoprime b hb) 1) * stickelberger m := by
  ext c
  have hmod : ((c⁻¹ * ZMod.unitOfCoprime b hb : (ZMod m)ˣ) : ZMod m).val =
      b * ((c⁻¹ : (ZMod m)ˣ) : ZMod m).val % m := by
    rw [Units.val_mul, ZMod.coe_unitOfCoprime, ZMod.val_mul, ZMod.val_natCast, Nat.mul_mod_mod,
      mul_comm]
  have hdiv : ((b * ((c⁻¹ : (ZMod m)ˣ) : ZMod m).val / m : ℕ) : ℚ) * m +
      ((b * ((c⁻¹ : (ZMod m)ˣ) : ZMod m).val % m : ℕ) : ℚ) =
        b * ((c⁻¹ : (ZMod m)ˣ) : ZMod m).val := by
    exact_mod_cast (by rw [mul_comm _ m]; exact Nat.div_add_mod _ _)
  have hm : (m : ℚ) ≠ 0 := by exact_mod_cast NeZero.ne m
  rw [coeff_mapRingHom, coeff_smoothedStickelberger, sub_mul, coeff_sub, Finsupp.sub_apply,
    coeff_natCast_mul, coeff_single_mul_apply, coeff_stickelberger, coeff_stickelberger,
    mul_inv_rev, inv_inv, hmod, one_mul, eq_intCast, Int.cast_natCast]
  field_simp
  linarith

/-- **Positive smoothing lies in the integral Stickelberger ideal**, with multiplier `b - [b]`. -/
theorem smoothedStickelberger_mem_stickelbergerIdeal {b : ℕ} (hb : b.Coprime m) :
    smoothedStickelberger m b ∈ stickelbergerIdeal m :=
  ⟨(b : MonoidAlgebra ℤ (ZMod m)ˣ) - single (ZMod.unitOfCoprime b hb) 1, by
    simp [mapRingHom_smoothedStickelberger hb]⟩

/-- Smoothing with `b = 1` gives zero. -/
@[simp]
theorem smoothedStickelberger_one : smoothedStickelberger m 1 = 0 := by
  ext c
  simp [Nat.div_eq_of_lt (ZMod.val_lt _)]

/-- Shifting `b` by the conductor adds `s_{m,m} = ∑_a a₀ [a⁻¹]`, the integral element `m θ_m`
(`mapRingHom_smoothedStickelberger_self`). -/
theorem smoothedStickelberger_add_self (b : ℕ) :
    smoothedStickelberger m (b + m) = smoothedStickelberger m b + smoothedStickelberger m m := by
  ext c
  simp [add_mul, Nat.add_mul_div_left _ _ (Nat.pos_of_neZero m),
    Nat.mul_div_cancel_left _ (Nat.pos_of_neZero m)]

/-- The smoothing with `b = m` is `m θ_m`. -/
theorem mapRingHom_smoothedStickelberger_self :
    mapRingHom _ (Int.castRingHom ℚ) (smoothedStickelberger m m) =
      (m : MonoidAlgebra ℚ (ZMod m)ˣ) * stickelberger m := by
  ext c
  have hm : (m : ℚ) ≠ 0 := by exact_mod_cast NeZero.ne m
  simp [coeff_natCast_mul, Nat.mul_div_cancel_left _ (Nat.pos_of_neZero m), mul_div_cancel₀ _ hm]

/-- **The product relation.** For `d` prime to `m` and every natural number `b`,
`s_{m,bd} = b s_{m,d} + [d] s_{m,b}`. -/
theorem smoothedStickelberger_mul (b : ℕ) {d : ℕ} (hd : d.Coprime m) :
    smoothedStickelberger m (b * d) = (b : MonoidAlgebra ℤ (ZMod m)ˣ) * smoothedStickelberger m d +
      single (ZMod.unitOfCoprime d hd) 1 * smoothedStickelberger m b := by
  ext c
  set n := d * ((c⁻¹ : (ZMod m)ˣ) : ZMod m).val
  have hmod : ((c⁻¹ * ZMod.unitOfCoprime d hd : (ZMod m)ˣ) : ZMod m).val = n % m := by
    rw [Units.val_mul, ZMod.coe_unitOfCoprime, ZMod.val_mul, ZMod.val_natCast, Nat.mul_mod_mod,
      mul_comm]
  -- `⌊b n / m⌋ = b ⌊n / m⌋ + ⌊b (n mod m) / m⌋`, from `b n = b (n mod m) + m (b ⌊n / m⌋)`.
  have hdiv : b * n / m = b * (n / m) + b * (n % m) / m := by
    conv_lhs => rw [← Nat.mod_add_div n m, mul_add, mul_left_comm,
      Nat.add_mul_div_left _ _ (Nat.pos_of_neZero m)]
    ring
  rw [coeff_add, Finsupp.add_apply, coeff_natCast_mul, coeff_single_mul_apply,
    coeff_smoothedStickelberger, coeff_smoothedStickelberger, coeff_smoothedStickelberger,
    mul_inv_rev, inv_inv, hmod, one_mul, mul_assoc, hdiv, Nat.cast_add, Nat.cast_mul]

end TauCeti
