/-!
# The local cyclotomic tower over `ℚ_p`

Fix a prime `p` and an algebraically closed field `Ω` containing `ℚ_p`. With the chosen
compatible system `ρ n = compatibleCyclotomicRoot p Ω n` of primitive `p ^ (n + 1)`-th roots of
unity, the `n`-th level of the local cyclotomic tower is the intermediate field
`K n = ℚ_p(ρ n)` of `Ω`. Because the roots are compatible, `ρ n = ρ (n + 1) ^ p` lies in
`K (n + 1)`, so the levels are nested inside the common field `Ω`, and consecutive levels carry the
algebra structure given by inclusion.

The absolute degree `[K n : ℚ_p] = p ^ n * (p - 1)` gives the relative degree
`[K (n + 1) : K n] = p`. The relative extension is generated by `ζ (n + 1)`, the root `ρ (n + 1)`
viewed in `K (n + 1)`, with minimal polynomial `X ^ p - ζ n`. Its relative norms are
`N(ζ (n + 1)) = (-1) ^ (p + 1) * ζ n` and `N(ζ (n + 1) - 1) = (-1) ^ (p + 1) * (ζ n - 1)`: for
odd `p` the generators `ζ n` and the differences `ζ n - 1` are norm compatible, while for `p = 2`
a sign appears (`N(ζ 1 - 1) = 2` while `ζ 0 - 1 = -2`). These are the norm relations on which
norm-compatible systems of cyclotomic units and their Coleman power series are built.

## Main definitions

* `TauCeti.padicCyclotomicField p Ω n`: the intermediate field `ℚ_p(ρ n)` of `Ω`.
* `TauCeti.padicCyclotomicField.root p Ω n`: the root `ρ n` as an element of this field.
* `TauCeti.padicCyclotomicField.relativePowerBasis p Ω n`: the power basis of `K (n + 1)` over
  `K n` with generator `ζ (n + 1)` and dimension `p`.

## Main results

* `TauCeti.padicCyclotomicField.finrank`: `[K n : ℚ_p] = p ^ n * (p - 1)`.
* `TauCeti.padicCyclotomicField.finrank_succ`: `[K (n + 1) : K n] = p`.
* `TauCeti.padicCyclotomicField.minpoly_root_succ`: the minimal polynomial of `ζ (n + 1)` over
  `K n` is `X ^ p - ζ n`.
* `TauCeti.padicCyclotomicField.norm_root_succ` and
  `TauCeti.padicCyclotomicField.norm_root_succ_sub_one`: the relative norms of `ζ (n + 1)` and
  `ζ (n + 1) - 1`.

## References

* J. Rodrigues Jacinto and C. Williams, *An introduction to p-adic L-functions*, Essential Number
  Theory 4 (2025), §9 and Lemma 10.9.
* R. Coleman, *Division values in local fields*, Invent. Math. 53 (1979).
-/

public section

open Polynomial

namespace TauCeti

variable (p : ℕ) [Fact p.Prime] (Ω : Type*) [Field Ω] [Algebra ℚ_[p] Ω]

/-- The `n`-th level `ℚ_p(ρ n)` of the local cyclotomic tower: the intermediate field of `Ω`
generated over `ℚ_p` by the chosen primitive `p ^ (n + 1)`-th root of unity
`ρ n = compatibleCyclotomicRoot p Ω n`. -/
noncomputable def padicCyclotomicField (n : ℕ) : IntermediateField ℚ_[p] Ω :=
  IntermediateField.adjoin ℚ_[p] {compatibleCyclotomicRoot p Ω n}

theorem padicCyclotomicField_def (n : ℕ) :
    padicCyclotomicField p Ω n = IntermediateField.adjoin ℚ_[p] {compatibleCyclotomicRoot p Ω n} :=
  (rfl)

/-- The level `ℚ_p(ρ n)` is the smallest intermediate field containing `ρ n`. -/
theorem padicCyclotomicField_le_iff {n : ℕ} {F : IntermediateField ℚ_[p] Ω} :
    padicCyclotomicField p Ω n ≤ F ↔ compatibleCyclotomicRoot p Ω n ∈ F :=
  IntermediateField.adjoin_simple_le_iff

namespace padicCyclotomicField

/-- The chosen root `ρ n` lies in the level `ℚ_p(ρ n)`. -/
theorem compatibleCyclotomicRoot_mem (n : ℕ) :
    compatibleCyclotomicRoot p Ω n ∈ padicCyclotomicField p Ω n :=
  IntermediateField.mem_adjoin_simple_self _ _

/-- The chosen root `ρ n` as an element of the level `ℚ_p(ρ n)`. -/
noncomputable def root (n : ℕ) : padicCyclotomicField p Ω n :=
  ⟨compatibleCyclotomicRoot p Ω n, compatibleCyclotomicRoot_mem p Ω n⟩

@[simp]
theorem coe_root (n : ℕ) : (root p Ω n : Ω) = compatibleCyclotomicRoot p Ω n := (rfl)

local instance : NeZero (p : Ω) := NeZero.nat_of_injective (algebraMap ℚ_[p] Ω).injective

variable [IsAlgClosed Ω]

/-- The chosen root `ζ n` is a primitive `p ^ (n + 1)`-th root of unity in `ℚ_p(ρ n)`. -/
theorem isPrimitiveRoot_root (n : ℕ) : IsPrimitiveRoot (root p Ω n) (p ^ (n + 1)) :=
  (isPrimitiveRoot_compatibleCyclotomicRoot n).of_map_of_injective
    (f := (padicCyclotomicField p Ω n).val) Subtype.val_injective

/-- The level `ℚ_p(ρ n)` is a `p ^ (n + 1)`-th cyclotomic extension of `ℚ_p`. -/
instance isCyclotomicExtension (n : ℕ) :
    IsCyclotomicExtension {p ^ (n + 1)} ℚ_[p] (padicCyclotomicField p Ω n) :=
  (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin _ _ _ _
    (isPrimitiveRoot_compatibleCyclotomicRoot (K := Ω) n)).mpr
    (padicCyclotomicField_def p Ω n)

instance finiteDimensional (n : ℕ) : FiniteDimensional ℚ_[p] (padicCyclotomicField p Ω n) :=
  IsCyclotomicExtension.finiteDimensional {p ^ (n + 1)} ℚ_[p] _

/-- The absolute degree `[ℚ_p(ρ n) : ℚ_p] = p ^ n * (p - 1)`. -/
theorem finrank (n : ℕ) : Module.finrank ℚ_[p] (padicCyclotomicField p Ω n) = p ^ n * (p - 1) :=
  finrank_cyclotomic_prime_pow_ratPadic p _ n

/-- Consecutive levels are nested: `ℚ_p(ρ n) ≤ ℚ_p(ρ (n + 1))`, because
`ρ n = ρ (n + 1) ^ p`. -/
theorem le_succ (n : ℕ) : padicCyclotomicField p Ω n ≤ padicCyclotomicField p Ω (n + 1) := by
  rw [padicCyclotomicField_le_iff, ← compatibleCyclotomicRoot_succ_pow n]
  exact pow_mem (compatibleCyclotomicRoot_mem p Ω (n + 1)) p

/-- The levels of the tower increase with `n`. -/
theorem monotone : Monotone (padicCyclotomicField p Ω) :=
  monotone_nat_of_le_succ (le_succ p Ω)

/-- Consecutive levels carry the algebra structure given by the inclusion
`ℚ_p(ρ n) ≤ ℚ_p(ρ (n + 1))` inside `Ω`. -/
noncomputable instance algebraSucc (n : ℕ) :
    Algebra (padicCyclotomicField p Ω n) (padicCyclotomicField p Ω (n + 1)) :=
  (IntermediateField.inclusion (le_succ p Ω n)).toRingHom.toAlgebra

@[simp]
theorem coe_algebraMap_succ (n : ℕ) (x : padicCyclotomicField p Ω n) :
    (algebraMap (padicCyclotomicField p Ω n) (padicCyclotomicField p Ω (n + 1)) x : Ω) = x :=
  (rfl)

instance isScalarTower_succ (n : ℕ) :
    IsScalarTower ℚ_[p] (padicCyclotomicField p Ω n) (padicCyclotomicField p Ω (n + 1)) :=
  IsScalarTower.of_algebraMap_eq fun _ ↦ Subtype.ext (by simp)

instance isScalarTower_succ_top (n : ℕ) :
    IsScalarTower (padicCyclotomicField p Ω n) (padicCyclotomicField p Ω (n + 1)) Ω :=
  IsScalarTower.of_algebraMap_eq fun _ ↦ by simp

instance finiteDimensional_succ (n : ℕ) :
    FiniteDimensional (padicCyclotomicField p Ω n) (padicCyclotomicField p Ω (n + 1)) :=
  Module.Finite.of_restrictScalars_finite ℚ_[p] _ _

/-- The image of `ζ n` in the next level is `ζ (n + 1) ^ p`. -/
@[simp]
theorem algebraMap_root (n : ℕ) :
    algebraMap (padicCyclotomicField p Ω n) (padicCyclotomicField p Ω (n + 1)) (root p Ω n) =
      root p Ω (n + 1) ^ p := by
  ext
  simp

/-- The relative degree `[ℚ_p(ρ (n + 1)) : ℚ_p(ρ n)] = p`. -/
theorem finrank_succ (n : ℕ) :
    Module.finrank (padicCyclotomicField p Ω n) (padicCyclotomicField p Ω (n + 1)) = p := by
  have h := Module.finrank_mul_finrank ℚ_[p] (padicCyclotomicField p Ω n)
    (padicCyclotomicField p Ω (n + 1))
  rw [finrank, finrank] at h
  have hpos : 0 < p ^ n * (p - 1) :=
    Nat.mul_pos (pow_pos (Fact.out : p.Prime).pos n) (Nat.sub_pos_of_lt (Fact.out : p.Prime).one_lt)
  exact Nat.eq_of_mul_eq_mul_left hpos (by rw [h]; ring)

/-- The next root `ζ (n + 1)` generates `ℚ_p(ρ (n + 1))` as an algebra over `ℚ_p(ρ n)`. -/
theorem adjoin_root_succ_eq_top (n : ℕ) :
    Algebra.adjoin (padicCyclotomicField p Ω n) {root p Ω (n + 1)} = ⊤ := by
  rw [← Algebra.adjoin_adjoin_of_tower ℚ_[p], IsCyclotomicExtension.adjoin_primitive_root_eq_top
    (isPrimitiveRoot_root p Ω (n + 1)), Algebra.coe_top, Algebra.adjoin_univ]

/-- The power basis `1, ζ (n + 1), …, ζ (n + 1) ^ (p - 1)` of `ℚ_p(ρ (n + 1))` over
`ℚ_p(ρ n)`. -/
noncomputable def relativePowerBasis (n : ℕ) :
    PowerBasis (padicCyclotomicField p Ω n) (padicCyclotomicField p Ω (n + 1)) :=
  PowerBasis.ofAdjoinEqTop (Algebra.IsIntegral.isIntegral _) (adjoin_root_succ_eq_top p Ω n)

@[simp]
theorem relativePowerBasis_gen (n : ℕ) : (relativePowerBasis p Ω n).gen = root p Ω (n + 1) :=
  PowerBasis.ofAdjoinEqTop_gen _ _

@[simp]
theorem relativePowerBasis_dim (n : ℕ) : (relativePowerBasis p Ω n).dim = p := by
  rw [← PowerBasis.finrank, finrank_succ]

/-- The minimal polynomial of `ζ (n + 1)` over `ℚ_p(ρ n)` is `X ^ p - ζ n`. -/
theorem minpoly_root_succ (n : ℕ) :
    minpoly (padicCyclotomicField p Ω n) (root p Ω (n + 1)) = X ^ p - C (root p Ω n) :=
  TauCeti.Algebra.minpoly_eq_X_pow_sub_C_of_pow_eq_of_natDegree_eq (Fact.out : p.Prime).ne_zero
    (algebraMap_root p Ω n).symm
    (by rw [← relativePowerBasis_gen, PowerBasis.natDegree_minpoly, relativePowerBasis_dim])

/-- The relative norm `N(ζ (n + 1)) = (-1) ^ (p + 1) * ζ n`. For odd `p` this is `ζ n`. -/
theorem norm_root_succ (n : ℕ) :
    Algebra.norm (padicCyclotomicField p Ω n) (root p Ω (n + 1)) =
      (-1) ^ (p + 1) * root p Ω n := by
  rw [← relativePowerBasis_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly,
    relativePowerBasis_gen, minpoly_root_succ, relativePowerBasis_dim]
  simp [coeff_X_pow, (Fact.out : p.Prime).ne_zero.symm, pow_succ]

/-- The relative norm `N(ζ (n + 1) - 1) = (-1) ^ (p + 1) * (ζ n - 1)`. For odd `p` this is
`ζ n - 1`; for `p = 2` and `n = 0` it is `2`, while `ζ 0 - 1 = -2`. -/
theorem norm_root_succ_sub_one (n : ℕ) :
    Algebra.norm (padicCyclotomicField p Ω n) (root p Ω (n + 1) - 1) =
      (-1) ^ (p + 1) * (root p Ω n - 1) := by
  have h := (relativePowerBasis p Ω n).norm_gen_sub_algebraMap 1
  rw [relativePowerBasis_gen, map_one, minpoly_root_succ, relativePowerBasis_dim] at h
  rw [h, eval_sub, eval_pow, eval_X, eval_C, one_pow]
  ring

end padicCyclotomicField

end TauCeti
