module

public import Mathlib.NumberTheory.NumberField.Completion.FinitePlace
public import TauCeti.NumberTheory.Padics.HeightOneSpectrum
public import TauCeti.RingTheory.Cyclotomic.ComplexField
public import TauCeti.RingTheory.DedekindDomain.AdicValuation.Completion
public import TauCeti.RingTheory.DedekindDomain.AdicValuation.LocalDegree

import Mathlib.NumberTheory.NumberField.Cyclotomic.Ideal

/-!
# Completions of a cyclotomic field at a place over `p`

Let `F = ℚ⟮complexRoot e⟯ ⊆ ℂ` (`TauCeti.Cyclotomic.complexField e`), and let `v` be a finite place
of `F` over the prime `p`, that is a height-one prime of `𝓞 F` containing `p`. Write `K = F_v` for
the completion, `O` for its valuation ring and `k` for the residue field of `O`. Then `(K, O, k)` is
a `p`-modular system: `O` is a complete discrete valuation ring (Mathlib's
`IsDiscreteValuationRing` instance and Tau Ceti's `IsAdicComplete` instance) with fraction field
`K`, which has characteristic zero, and `k` has characteristic `p`
(`IsDedekindDomain.HeightOneSpectrum.charP_residueField_adicCompletionIntegers`). The field `K`
contains the primitive `e`-th root of unity `complexRoot e`
(`TauCeti.Cyclotomic.isPrimitiveRoot_embedding_zeta`).

Let `e'` be the part of `e` prime to `p`. This file also proves that `k` is generated over its
prime field by the reduction of `complexRoot e'`
(`TauCeti.Cyclotomic.closure_residue_zetaInteger_pow_ordProj_eq_top`). The reduction of
`complexRoot e` generates `k` because `𝓞 F = ℤ[complexRoot e]`, and `complexRoot e'` is its
`p ^ a`-th power, where `p ^ a` is the `p`-part of `e`; the `p ^ a`-th power map is an
automorphism of the finite field `k`. Consequently, when the reduction of `complexRoot e'` lies
in the prime field, `k` has `p` elements
(`TauCeti.Cyclotomic.natCard_residueField_of_residue_zetaInteger_pow_ordProj_eq_natCast`).

Since `K` contains a primitive `e`-th root of unity, Mathlib's `rootsOfUnityEquivOfPrimitiveRoots`
applied to the canonical map `F → K` is an isomorphism from the `e`-th roots of unity of `F` onto
those of `K`. Reduction from the `e'`-th roots of unity of `O` onto those of `k` is the
isomorphism `TauCeti.rootsOfUnityEquivResidueField`, since `e'` is a unit of `O`
(`IsDedekindDomain.HeightOneSpectrum.isUnit_algebraMap_adicCompletionIntegers_iff`).

When `p` does not divide `e`, the local degree `[K : ℚ_p]` is the order of `p` modulo `e`
(`TauCeti.Cyclotomic.finrank_adicCompletion_eq_orderOf`): `p` is unramified in `F` and its residue
degree is that order. In particular, when `p ≡ 1 mod e` the local degree is `1`
(`TauCeti.Cyclotomic.finrank_adicCompletion_eq_one`), the completion map from the `p`-adic
completion of `ℚ` to `K` is bijective (`TauCeti.Cyclotomic.adicCompletionExtension_bijective`), and
so `K ≃A[ℚ] ℚ_[p]` by `IsDedekindDomain.HeightOneSpectrum.adicCompletionEquivPadic`, which applies
to every number field of local degree `1`.

## References

* Peter Webb, *A Course in Finite Group Representation Theory*, Section 9.4, p. 148, for
  `p`-modular systems and splitting systems, and Lemma 10.1.1, p. 170, for the bijection of roots
  of unity.
-/

public section

noncomputable section

open IsDedekindDomain NumberField IsLocalRing HeightOneSpectrum
open scoped AdicCompletionExtension

namespace TauCeti.Cyclotomic

variable {e : ℕ} [NeZero e] (v : HeightOneSpectrum (𝓞 (complexField e)))

local notation "F" => complexField e
local notation "O" => v.adicCompletionIntegers (complexField e)

/-- The reduction of `complexRoot e` at `v`, an element of the residue field of `F_v`. -/
local notation "ρ" => residue O (algebraMap (𝓞 F) O (complexField.zetaInteger e))

/-- The completed integers `O` of `F_v` contain the primitive `e`-th root of unity
`complexRoot e`. -/
theorem isPrimitiveRoot_algebraMap_zetaInteger :
    IsPrimitiveRoot (algebraMap (𝓞 F) O (complexField.zetaInteger e)) e :=
  (complexField.isPrimitiveRoot_zetaInteger e).map_of_injective
    (FaithfulSMul.algebraMap_injective _ _)

/-- The completion `F_v` contains the primitive `e`-th root of unity `complexRoot e`. -/
theorem isPrimitiveRoot_embedding_zeta :
    IsPrimitiveRoot (FinitePlace.embedding (K := F) v (complexField.zeta e)) e :=
  (complexField.isPrimitiveRoot_zeta e).map_of_injective
    (FinitePlace.embedding (K := F) v).injective

/-- The residue field of `F_v` is generated by the reduction of `complexRoot e`: the ring of
integers of `F` is `ℤ[complexRoot e]`, and it maps onto the residue field. -/
theorem closure_residue_zetaInteger_eq_top : Subring.closure {ρ} = ⊤ := by
  refine eq_top_iff.2 fun y _ ↦ ?_
  obtain ⟨a, rfl⟩ := v.residue_algebraMap_adicCompletionIntegers_surjective (K := F) y
  have ha : a ∈ Subring.closure {complexField.zetaInteger e} := by
    have h := IsCyclotomicExtension.Rat.adjoin_singleton_eq_top
      (complexField.isPrimitiveRoot_zeta e)
    rw [← complexField.zetaInteger_eq_toInteger] at h
    have : a ∈ Algebra.adjoin ℤ {complexField.zetaInteger e} := h ▸ Algebra.mem_top
    rwa [Algebra.adjoin_int] at this
  have : (residue O).comp (algebraMap (𝓞 F) O) a ∈
      (Subring.closure {complexField.zetaInteger e}).map ((residue O).comp (algebraMap (𝓞 F) O)) :=
    Subring.mem_map.2 ⟨a, ha, rfl⟩
  rwa [RingHom.map_closure, Set.image_singleton] at this

/-- **The residue field of `F_v` is generated by the reduction of `complexRoot e'`**, where `v`
lies over the prime `p` and `e'` is the part of `e` prime to `p`. Here `complexRoot e'` is the
algebraic integer `complexField.zetaInteger e ^ ordProj[p] e` (`complexRoot_pow_ordProj`;
`complexField.zetaInteger_pow_ordProj_eq_of_coe_eq` identifies any other algebraic integer with this
value). -/
theorem closure_residue_zetaInteger_pow_ordProj_eq_top (p : ℕ) [Fact p.Prime]
    (hp : (p : 𝓞 F) ∈ v.asIdeal) :
    Subring.closure
      {residue O (algebraMap (𝓞 F) O (complexField.zetaInteger e ^ ordProj[p] e))} = ⊤ := by
  have := v.charP_residueField_adicCompletionIntegers (K := F) p hp
  set φ := iterateFrobenius (ResidueField O) p (e.factorization p)
  have hφ : Function.Surjective φ := Finite.surjective_of_injective φ.injective
  simp only [map_pow, ← iterateFrobenius_def]
  calc Subring.closure {φ ρ} = (Subring.closure {ρ}).map φ := by
        rw [RingHom.map_closure, Set.image_singleton]
    _ = ⊤ := by
        rw [closure_residue_zetaInteger_eq_top, ← RingHom.range_eq_map, RingHom.range_eq_top.2 hφ]

/-- At a place over `p`, if the reduction of `complexRoot e'` is the image of a natural number,
where `e'` is the part of `e` prime to `p`, then the residue field of `F_v` is the prime field: it
has `p` elements. -/
theorem natCard_residueField_of_residue_zetaInteger_pow_ordProj_eq_natCast (p : ℕ)
    [Fact p.Prime] (hp : (p : 𝓞 F) ∈ v.asIdeal) {n : ℕ}
    (hn : residue O (algebraMap (𝓞 F) O (complexField.zetaInteger e ^ ordProj[p] e)) = n) :
    Nat.card (ResidueField O) = p := by
  have := v.charP_residueField_adicCompletionIntegers (K := F) p hp
  let χ := ZMod.castHom (dvd_refl p) (ResidueField O)
  have hχ : Function.Bijective χ := by
    refine ⟨χ.injective, RingHom.range_eq_top.1 (eq_top_iff.2 ?_)⟩
    rw [← closure_residue_zetaInteger_pow_ordProj_eq_top v p hp, Subring.closure_le,
      Set.singleton_subset_iff, hn]
    exact ⟨n, map_natCast χ n⟩
  rw [← Nat.card_eq_of_bijective χ hχ, Nat.card_zmod]

/-- When `e` is a power of `p`, so that `e' = 1`, the residue field of `F_v` at a place over `p`
is the prime field: it has `p` elements. -/
theorem natCard_residueField_of_ordCompl_eq_one (p : ℕ) [Fact p.Prime]
    (hp : (p : 𝓞 F) ∈ v.asIdeal) (he : ordCompl[p] e = 1) :
    Nat.card (ResidueField O) = p := by
  have hpe : ordProj[p] e = e := by
    simpa [he] using Nat.ordProj_mul_ordCompl_eq_self e p
  refine natCard_residueField_of_residue_zetaInteger_pow_ordProj_eq_natCast v p hp (n := 1) ?_
  rw [hpe, (complexField.isPrimitiveRoot_zetaInteger e).pow_eq_one, map_one, map_one, Nat.cast_one]

/-- **The local degree of `F` at an unramified prime.** If the prime `p` does not divide `e`, then
at each place `v` of `F` over `p` the degree `[F_v : ℚ_p]` is the order of `p` modulo `e`. -/
theorem finrank_adicCompletion_eq_orderOf (p : ℕ) [Fact p.Prime]
    [v.asIdeal.LiesOver ((Rat.HeightOneSpectrum.primesEquiv (R := ℤ)).symm ⟨p, Fact.out⟩).asIdeal]
    (hpe : ¬ p ∣ e) :
    Module.finrank
      (((Rat.HeightOneSpectrum.primesEquiv (R := ℤ)).symm ⟨p, Fact.out⟩).adicCompletion ℚ)
      (v.adicCompletion F) = orderOf (p : ZMod e) := by
  have : v.asIdeal.LiesOver (Ideal.span {(p : ℤ)}) :=
    Rat.HeightOneSpectrum.asIdeal_primesEquiv_symm (R := ℤ) ⟨p, Fact.out⟩ ▸ inferInstance
  have : Finite (𝓞 F ⧸ v.asIdeal) := Ring.HasFiniteQuotients.finiteQuotient v.ne_bot
  rw [finrank_adicCompletion, IsCyclotomicExtension.Rat.ramificationIdx_eq_of_not_dvd p F _ hpe,
    IsCyclotomicExtension.Rat.inertiaDeg_eq_of_not_dvd p F _ hpe, one_mul]

/-- **The local degree of `F` at a prime `p ≡ 1 mod e` is `1`.** If `p ≡ 1 mod e`, then at each
place `v` of `F` over `p` the degree `[F_v : ℚ_p]` is `1`: `p` does not divide `e`, and the order of
`p` modulo `e` is `1`. -/
theorem finrank_adicCompletion_eq_one (p : ℕ) [Fact p.Prime]
    [v.asIdeal.LiesOver ((Rat.HeightOneSpectrum.primesEquiv (R := ℤ)).symm ⟨p, Fact.out⟩).asIdeal]
    (hp : (p : ZMod e) = 1) :
    Module.finrank
      (((Rat.HeightOneSpectrum.primesEquiv (R := ℤ)).symm ⟨p, Fact.out⟩).adicCompletion ℚ)
      (v.adicCompletion F) = 1 := by
  rw [finrank_adicCompletion_eq_orderOf v p
    ((ZMod.isUnit_prime_iff_not_dvd Fact.out).1 (hp ▸ isUnit_one)), hp, orderOf_one]

/-- **The completion map at a prime `p ≡ 1 mod e` is bijective.** If `p ≡ 1 mod e`, then at each
place `v` of `F` over `p` the completion map from the `p`-adic completion of `ℚ` to `F_v` is
bijective. -/
theorem adicCompletionExtension_bijective (p : ℕ) [Fact p.Prime]
    [v.asIdeal.LiesOver ((Rat.HeightOneSpectrum.primesEquiv (R := ℤ)).symm ⟨p, Fact.out⟩).asIdeal]
    (hp : (p : ZMod e) = 1) :
    Function.Bijective (adicCompletionExtension ℚ F
      ((Rat.HeightOneSpectrum.primesEquiv (R := ℤ)).symm ⟨p, Fact.out⟩) v) :=
  adicCompletionExtension_bijective_of_finrank_eq_one _ v (finrank_adicCompletion_eq_one v p hp)

end TauCeti.Cyclotomic
