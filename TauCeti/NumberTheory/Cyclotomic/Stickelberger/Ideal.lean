import TauCeti.Algebra.MonoidAlgebra.Basic
import TauCeti.Data.Rat.Lemmas

/-!
# The denominator ideal and the integral Stickelberger ideal

Let `θ_m ∈ ℚ[(ZMod m)ˣ]` be the rational Stickelberger element and let
`φ : ℤ[(ZMod m)ˣ] → ℚ[(ZMod m)ˣ]` be the coefficient extension along `ℤ → ℚ`, which is injective.
This file defines two ideals of the integral group ring:

* the **denominator ideal** `J_m = {x | φ(x) θ_m has integral coefficients}`;
* the **integral Stickelberger ideal** `I_m = {y | φ(y) = φ(x) θ_m for some x ∈ ℤ[(ZMod m)ˣ]}`,
  that is `ℤ[G] θ_m ∩ ℤ[G]` inside `ℚ[G]`.

Integral (rather than rational) multiples of `θ_m` are used: `ℚ[G] θ_m ∩ ℤ[G]` can be strictly
larger. Stickelberger's theorem says that `I_m` annihilates the ideal class group of `ℚ(ζ_m)`.

The denominator ideal has a simple description: writing `x = ∑_a n_a [a]`, the coefficient of
`φ(x) θ_m` at `[c]` is `m⁻¹ ∑_a n_a (c⁻¹ a)₀`, and `(c⁻¹ a)₀ ≡ c⁻¹ a₀ (mod m)`. Since `c⁻¹` is a
unit modulo `m`, all these coefficients are integral exactly when `∑_a n_a a₀ ≡ 0 (mod m)`. So
`J_m` is the kernel of the ring homomorphism `ℤ[(ZMod m)ˣ] → ZMod m` induced by the inclusion
`(ZMod m)ˣ → ZMod m`, and it is generated by the elements `[b] - b` for natural numbers `b` prime
to `m`. Integers representing the same residue must all be allowed: `b = 1 + m` gives the
generator `-m`.

## Main definitions

* `TauCeti.stickelbergerDenominatorIdeal m`: the denominator ideal `J_m`.
* `TauCeti.stickelbergerIdeal m`: the integral Stickelberger ideal `I_m`.
* `TauCeti.stickelbergerMul m`: the `ℤ[(ZMod m)ˣ]`-linear map `J_m → I_m`, `x ↦ x θ_m`.

## Main results

* `TauCeti.coeff_mapRingHom_mul_stickelberger`: the coefficients of `x θ_m`.
* `TauCeti.stickelbergerDenominatorIdeal_eq_ker`: `J_m` is the kernel of `ℤ[(ZMod m)ˣ] → ZMod m`.
* `TauCeti.mem_stickelbergerDenominatorIdeal_iff_dvd`: the congruence criterion
  `∑_a n_a [a] ∈ J_m ↔ m ∣ ∑_a n_a a₀`.
* `TauCeti.stickelbergerDenominatorIdeal_eq_span`: `J_m` is generated by the `[b] - b`.
* `TauCeti.stickelbergerDenominatorIdeal_ne_top`: for `m ≠ 1`, `J_m` is a proper ideal.
* `TauCeti.stickelbergerMul_surjective`: multiplication by `θ_m` maps `J_m` onto `I_m`.

## References

* R. Sharifi, *Iwasawa theory* (lecture notes), Definition 4.5.1(b) and Lemma 4.5.2.
* L. C. Washington, *Introduction to Cyclotomic Fields*, §6.2, Lemma 6.9.
-/

public section

open MonoidAlgebra

namespace TauCeti

variable (m : ℕ) [NeZero m]

/-- The **denominator ideal** `J_m` of the Stickelberger element: the integral group-ring elements
`x` whose product `x θ_m` with the rational Stickelberger element has integral coefficients. -/
noncomputable def stickelbergerDenominatorIdeal : Ideal (MonoidAlgebra ℤ (ZMod m)ˣ) where
  carrier := {x | mapRingHom _ (Int.castRingHom ℚ) x * stickelberger m ∈
    (mapRingHom (ZMod m)ˣ (Int.castRingHom ℚ)).range}
  zero_mem' := ⟨0, by simp⟩
  add_mem' {x y} hx hy := by
    simpa only [Set.mem_ofPred_eq, map_add, add_mul] using add_mem (S := Subring _) hx hy
  smul_mem' r x hx := by
    simpa only [Set.mem_ofPred_eq, smul_eq_mul, map_mul, mul_assoc] using
      mul_mem (S := Subring _) (RingHom.mem_range_self _ r) hx

/-- The **integral Stickelberger ideal** `I_m`: the elements of `ℤ[(ZMod m)ˣ]` which, viewed in
`ℚ[(ZMod m)ˣ]`, are integral multiples `x θ_m` of the rational Stickelberger element. -/
noncomputable def stickelbergerIdeal : Ideal (MonoidAlgebra ℤ (ZMod m)ˣ) where
  carrier := {y | ∃ x, mapRingHom _ (Int.castRingHom ℚ) y =
    mapRingHom _ (Int.castRingHom ℚ) x * stickelberger m}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro u v ⟨x, hx⟩ ⟨y, hy⟩
    exact ⟨x + y, by simp only [map_add, hx, hy, add_mul]⟩
  smul_mem' := by
    rintro r u ⟨x, hx⟩
    exact ⟨r * x, by simp only [smul_eq_mul, map_mul, hx, mul_assoc]⟩

variable {m}

/-- Membership in the denominator ideal: `x θ_m` lies in the image of `ℤ[(ZMod m)ˣ]`. -/
theorem mem_stickelbergerDenominatorIdeal {x : MonoidAlgebra ℤ (ZMod m)ˣ} :
    x ∈ stickelbergerDenominatorIdeal m ↔
      mapRingHom _ (Int.castRingHom ℚ) x * stickelberger m ∈
        (mapRingHom (ZMod m)ˣ (Int.castRingHom ℚ)).range :=
  Iff.rfl

/-- Membership in the integral Stickelberger ideal: `y = x θ_m` in `ℚ[(ZMod m)ˣ]` for some
integral `x`. -/
theorem mem_stickelbergerIdeal {y : MonoidAlgebra ℤ (ZMod m)ˣ} :
    y ∈ stickelbergerIdeal m ↔
      ∃ x, mapRingHom _ (Int.castRingHom ℚ) y =
        mapRingHom _ (Int.castRingHom ℚ) x * stickelberger m :=
  Iff.rfl

/-- Every element of the integral Stickelberger ideal is `x θ_m` for some `x` in the denominator
ideal. -/
theorem exists_mem_stickelbergerDenominatorIdeal_of_mem_stickelbergerIdeal
    {y : MonoidAlgebra ℤ (ZMod m)ˣ} (hy : y ∈ stickelbergerIdeal m) :
    ∃ x ∈ stickelbergerDenominatorIdeal m,
      mapRingHom _ (Int.castRingHom ℚ) y = mapRingHom _ (Int.castRingHom ℚ) x * stickelberger m :=
  let ⟨x, hx⟩ := hy
  ⟨x, ⟨y, hx⟩, hx⟩

/-- **The coefficients of `x θ_m`.** For `x = ∑_a n_a [a]` in the integral group ring, the
coefficient of `x θ_m` at `[c]` is `m⁻¹ ∑_a n_a (c⁻¹ a)₀`. -/
theorem coeff_mapRingHom_mul_stickelberger (x : MonoidAlgebra ℤ (ZMod m)ˣ) (c : (ZMod m)ˣ) :
    (mapRingHom _ (Int.castRingHom ℚ) x * stickelberger m).coeff c =
      ((∑ a : (ZMod m)ˣ, x.coeff a * ((c⁻¹ * a : (ZMod m)ˣ) : ZMod m).val : ℤ) : ℚ) / m := by
  rw [coeff_mul_apply_left, Finsupp.sum_fintype _ _ fun _ ↦ zero_mul _, Int.cast_sum,
    Finset.sum_div]
  refine Finset.sum_congr rfl fun a _ ↦ ?_
  simp [mul_div_assoc]

/-- **The denominator ideal is a kernel.** `J_m` is the kernel of the ring homomorphism
`ℤ[(ZMod m)ˣ] → ZMod m`, `∑_a n_a [a] ↦ ∑_a n_a a`, induced by the inclusion of the units. -/
theorem stickelbergerDenominatorIdeal_eq_ker :
    stickelbergerDenominatorIdeal m =
      RingHom.ker (lift ℤ (ZMod m) (ZMod m)ˣ (Units.coeHom (ZMod m))) := by
  ext x
  rw [mem_stickelbergerDenominatorIdeal, RingHom.mem_ker, lift_apply_eq_sum]
  rw [← SetLike.mem_coe, RingHom.coe_range, coe_mapRingHom, range_map, Set.mem_ofPred_eq]
  simp only [← coe_mapRingHom, coeff_mapRingHom_mul_stickelberger]
  -- Each coefficient condition is the vanishing of `c⁻¹ ∑_a n_a a` in `ZMod m`.
  have key : ∀ c : (ZMod m)ˣ, ((m : ℤ) ∣ ∑ a : (ZMod m)ˣ,
      x.coeff a * ((c⁻¹ * a : (ZMod m)ˣ) : ZMod m).val) ↔
        ∑ a : (ZMod m)ˣ, x.coeff a • (Units.coeHom (ZMod m) a) = 0 := fun c ↦ by
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
    push_cast
    simp only [ZMod.natCast_val, ZMod.cast_id', id, Units.coeHom_apply, zsmul_eq_mul]
    conv_rhs => rw [← (c⁻¹).isUnit.mul_right_eq_zero, Finset.mul_sum]
    exact Iff.of_eq (congrArg (· = 0) (Finset.sum_congr rfl fun a _ ↦ by ring))
  have hdiv (n : ℤ) : (n : ℚ) / m ∈ Set.range ((↑) : ℤ → ℚ) ↔ (m : ℤ) ∣ n := by
    exact_mod_cast Rat.intCast_div_intCast_mem_range_iff (Int.natCast_ne_zero.2 (NeZero.ne m)) n
  simp only [AddMonoidHom.coe_ofClass, Int.coe_castRingHom, hdiv, key]
  exact ⟨fun h ↦ h 1, fun h _ ↦ h⟩

/-- **Congruence criterion for the denominator ideal.** `∑_a n_a [a] ∈ J_m` exactly when
`∑_a n_a a₀ ≡ 0 (mod m)`, where `a₀` is the least nonnegative representative of `a`. -/
theorem mem_stickelbergerDenominatorIdeal_iff_dvd {x : MonoidAlgebra ℤ (ZMod m)ˣ} :
    x ∈ stickelbergerDenominatorIdeal m ↔
      (m : ℤ) ∣ ∑ a : (ZMod m)ˣ, x.coeff a * (a : ZMod m).val := by
  rw [stickelbergerDenominatorIdeal_eq_ker, RingHom.mem_ker, lift_apply_eq_sum,
    ← ZMod.intCast_zmod_eq_zero_iff_dvd]
  push_cast
  simp [ZMod.natCast_val, zsmul_eq_mul]

/-- For `m ≠ 1` the denominator ideal `J_m` is a proper ideal. -/
theorem stickelbergerDenominatorIdeal_ne_top (hm : m ≠ 1) :
    stickelbergerDenominatorIdeal m ≠ ⊤ := by
  have : Nontrivial (ZMod m) := ZMod.nontrivial_iff.2 hm
  rw [Ne, Ideal.eq_top_iff_one, stickelbergerDenominatorIdeal_eq_ker, RingHom.mem_ker, map_one]
  exact one_ne_zero

/-- For a natural number `b` prime to `m`, the element `[b] - b` lies in the denominator ideal. -/
theorem single_unitOfCoprime_sub_mem_stickelbergerDenominatorIdeal {b : ℕ} (hb : b.Coprime m) :
    single (ZMod.unitOfCoprime b hb) 1 - (b : MonoidAlgebra ℤ (ZMod m)ˣ) ∈
      stickelbergerDenominatorIdeal m := by
  rw [stickelbergerDenominatorIdeal_eq_ker, RingHom.mem_ker]
  simp [ZMod.coe_unitOfCoprime]

/-- **Generators of the denominator ideal.** `J_m` is generated by the elements `[b] - b` for the
natural numbers `b` prime to `m`. For `m ≥ 2` these `b` are positive. Different integers
representing the same residue give different generators: `b = 1` gives `0` and `b = 1 + m` gives
`-m`. -/
theorem stickelbergerDenominatorIdeal_eq_span :
    stickelbergerDenominatorIdeal m = Ideal.span (Set.range fun b : {b : ℕ // b.Coprime m} ↦
      single (ZMod.unitOfCoprime b.1 b.2) 1 - (b.1 : MonoidAlgebra ℤ (ZMod m)ˣ)) := by
  set g : {b : ℕ // b.Coprime m} → MonoidAlgebra ℤ (ZMod m)ˣ :=
    fun b ↦ single (ZMod.unitOfCoprime b.1 b.2) 1 - (b.1 : MonoidAlgebra ℤ (ZMod m)ˣ) with hg
  refine le_antisymm (fun x hx ↦ ?_) (Ideal.span_le.2 ?_)
  · obtain ⟨k, hk⟩ := mem_stickelbergerDenominatorIdeal_iff_dvd.1 hx
    have hcop : (1 + m).Coprime m := by simp
    have hunit : ∀ a : (ZMod m)ˣ,
        ZMod.unitOfCoprime (a : ZMod m).val (ZMod.val_coe_unit_coprime a) = a :=
      fun a ↦ Units.ext (by simp [ZMod.coe_unitOfCoprime])
    have hone : ZMod.unitOfCoprime (1 + m) hcop = 1 := Units.ext (by simp [ZMod.coe_unitOfCoprime])
    -- `x = ∑_a n_a ([a] - a₀) + ∑_a n_a a₀`, and `∑_a n_a a₀ = m k = -k ([1 + m] - (1 + m))`.
    have hx' : x = ∑ a : (ZMod m)ˣ, x.coeff a • g ⟨_, ZMod.val_coe_unit_coprime a⟩ +
        (-k) • g ⟨1 + m, hcop⟩ := by
      have h1 : ∑ a : (ZMod m)ˣ, x.coeff a • single a (1 : ℤ) = x := by
        simp_rw [smul_single, smul_eq_mul, mul_one]
        conv_rhs => rw [← sum_coeff_single x]
        rw [Finsupp.sum_fintype _ _ (by simp)]
      have h2 : ∑ a : (ZMod m)ˣ, x.coeff a • ((a : ZMod m).val : MonoidAlgebra ℤ (ZMod m)ˣ) =
          ((m * k : ℤ) : MonoidAlgebra ℤ (ZMod m)ˣ) := by
        rw [← hk]
        push_cast
        simp [zsmul_eq_mul]
      simp only [hg, hunit, hone, smul_sub, Finset.sum_sub_distrib, h1, h2, ← one_def]
      push_cast
      ring
    rw [hx']
    exact add_mem (Ideal.sum_mem _ fun a _ ↦
      zsmul_mem (Ideal.subset_span (Set.mem_range_self _)) _)
      (zsmul_mem (Ideal.subset_span (Set.mem_range_self _)) _)
  · rintro _ ⟨b, rfl⟩
    exact single_unitOfCoprime_sub_mem_stickelbergerDenominatorIdeal b.2

variable (m)

/-- The integral element `x θ_m` attached to `x` in the denominator ideal. -/
private noncomputable def stickelbergerMulFun (x : stickelbergerDenominatorIdeal m) :
    MonoidAlgebra ℤ (ZMod m)ˣ :=
  (mem_stickelbergerDenominatorIdeal.1 x.2).choose

private theorem mapRingHom_stickelbergerMulFun (x : stickelbergerDenominatorIdeal m) :
    mapRingHom _ (Int.castRingHom ℚ) (stickelbergerMulFun m x) =
      mapRingHom _ (Int.castRingHom ℚ) (x : MonoidAlgebra ℤ (ZMod m)ˣ) * stickelberger m :=
  (mem_stickelbergerDenominatorIdeal.1 x.2).choose_spec

/-- **Integral Stickelberger multiplication.** Multiplication by `θ_m`, as a
`ℤ[(ZMod m)ˣ]`-linear map from the denominator ideal `J_m` to the integral Stickelberger ideal
`I_m`. The value at `x` is the unique integral element whose image in `ℚ[(ZMod m)ˣ]` is `x θ_m`,
see `mapRingHom_stickelbergerMul`. -/
noncomputable def stickelbergerMul :
    stickelbergerDenominatorIdeal m →ₗ[MonoidAlgebra ℤ (ZMod m)ˣ] stickelbergerIdeal m where
  toFun x := ⟨stickelbergerMulFun m x, x, mapRingHom_stickelbergerMulFun m x⟩
  map_add' x y := Subtype.ext <| mapRingHom_injective (Int.castRingHom ℚ) Int.cast_injective <| by
    simp only [Submodule.coe_add, map_add, mapRingHom_stickelbergerMulFun, add_mul]
  map_smul' r x := Subtype.ext <| mapRingHom_injective (Int.castRingHom ℚ) Int.cast_injective <| by
    simp only [SetLike.val_smul, smul_eq_mul, map_mul, mapRingHom_stickelbergerMulFun, mul_assoc,
      RingHom.id_apply]

variable {m}

/-- The image of `stickelbergerMul m x` in the rational group ring is `x θ_m`. -/
@[simp]
theorem mapRingHom_stickelbergerMul (x : stickelbergerDenominatorIdeal m) :
    mapRingHom _ (Int.castRingHom ℚ) (stickelbergerMul m x : MonoidAlgebra ℤ (ZMod m)ˣ) =
      mapRingHom _ (Int.castRingHom ℚ) (x : MonoidAlgebra ℤ (ZMod m)ˣ) * stickelberger m :=
  mapRingHom_stickelbergerMulFun m x

/-- Multiplication by `θ_m` maps the denominator ideal onto the integral Stickelberger ideal. -/
theorem stickelbergerMul_surjective : Function.Surjective (stickelbergerMul m) := by
  rintro ⟨y, hy⟩
  obtain ⟨x, hxJ, hx⟩ := exists_mem_stickelbergerDenominatorIdeal_of_mem_stickelbergerIdeal hy
  refine ⟨⟨x, hxJ⟩, Subtype.ext <| mapRingHom_injective (Int.castRingHom ℚ) Int.cast_injective ?_⟩
  rw [mapRingHom_stickelbergerMul, hx]

end TauCeti
