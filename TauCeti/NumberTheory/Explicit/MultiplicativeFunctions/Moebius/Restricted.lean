module

public import TauCeti.NumberTheory.Explicit.MultiplicativeFunctions.Moebius.Basic
import TauCeti.Data.Nat.Prime.Basic
import TauCeti.NumberTheory.AbelSummation

/-!
# Möbius sums restricted to a multiplicative semigroup

For a set `S` of natural numbers, say that `n` is `S`-factored when `n ≠ 0` and every prime factor
of `n` lies in `S`; the `S`-factored numbers form the multiplicative semigroup `⟨S⟩` generated by
the primes in `S`. For finite `S` these are Mathlib's `Nat.factoredNumbers S`. This file restricts
the three summatory functions of the Möbius function to `⟨S⟩`:

* `M_S(x) = ∑_{n ≤ x, n ∈ ⟨S⟩} μ(n)` (`TauCeti.moebiusSumIn`);
* `m_S(x) = ∑_{n ≤ x, n ∈ ⟨S⟩} μ(n) / n` (`TauCeti.moebiusDivSumIn`);
* `ℓ_S(x) = ∑_{n ≤ x, n ∈ ⟨S⟩} μ(n) log (x / n) / n` (`TauCeti.moebiusLogSumIn`).

As for the unrestricted sums, `n` runs over `Finset.Icc 1 ⌊x⌋₊`, so the restriction to `n ≠ 0` is
automatic and every restricted sum vanishes for `x < 1`. Elements of `S` that are not prime play no
role. When `S` contains every prime the restriction is vacuous; for `S = ∅` only `n = 1` remains.
For a modulus `q`, the set `S_q = {p | ¬ p ∣ q}` gives the sums over the `n` coprime to `q`, which
are the coprime sums `M_q`, `m_q` and `ℓ_q` of explicit bounds for the Möbius function.

## Main declarations

* `TauCeti.moebiusSumIn`, `TauCeti.moebiusDivSumIn`, `TauCeti.moebiusLogSumIn`: `M_S`, `m_S` and
  `ℓ_S`.
* `TauCeti.moebiusSumIn_natFloor`, `TauCeti.moebiusDivSumIn_natFloor`: `M_S` and `m_S` are
  constant on each `[N, N + 1)`.
* `TauCeti.moebiusSumIn_of_setOf_prime_subset` and its analogues: if `S` contains every prime, the
  restricted sums are `M`, `m` and `ℓ`.
* `TauCeti.moebiusSumIn_empty` and its analogues: `M_∅(x) = m_∅(x) = 1` and `ℓ_∅(x) = log x` for
  `x ≥ 1`.
* `TauCeti.moebiusSumIn_setOf_not_dvd` and its analogues: for `S_q = {p | ¬ p ∣ q}` the restricted
  sums run over the `n` coprime to `q`.

## References

* T. Tao, *A remark on partial sums involving the Möbius function*, Bull. Aust. Math. Soc. 81
  (2010), 343–349.
* O. Ramaré, *Explicit estimates on several summatory functions involving the Moebius function*,
  Math. Comp. 84 (2015), 1359–1387.
-/

public section

open Finset
open scoped ArithmeticFunction.Moebius

namespace TauCeti

variable {S : Set ℕ} {x : ℝ}

/-! ### The restricted sums -/

open Classical in
/-- The Mertens function restricted to `⟨S⟩`: `M_S(x) = ∑ μ(n)` over the `n ∈ Finset.Icc 1 ⌊x⌋₊`
all of whose prime factors lie in `S`. -/
noncomputable def moebiusSumIn (S : Set ℕ) (x : ℝ) : ℝ :=
  ∑ n ∈ (Icc 1 ⌊x⌋₊).filter (fun n ↦ ∀ p ∈ n.primeFactors, p ∈ S), (μ n : ℝ)

open Classical in
/-- The logarithmic Möbius sum restricted to `⟨S⟩`: `m_S(x) = ∑ μ(n) / n` over the
`n ∈ Finset.Icc 1 ⌊x⌋₊` all of whose prime factors lie in `S`. -/
noncomputable def moebiusDivSumIn (S : Set ℕ) (x : ℝ) : ℝ :=
  ∑ n ∈ (Icc 1 ⌊x⌋₊).filter (fun n ↦ ∀ p ∈ n.primeFactors, p ∈ S), (μ n : ℝ) / n

open Classical in
/-- The logarithmically weighted Möbius sum restricted to `⟨S⟩`:
`ℓ_S(x) = ∑ μ(n) log (x / n) / n` over the `n ∈ Finset.Icc 1 ⌊x⌋₊` all of whose prime factors lie
in `S`. -/
noncomputable def moebiusLogSumIn (S : Set ℕ) (x : ℝ) : ℝ :=
  ∑ n ∈ (Icc 1 ⌊x⌋₊).filter (fun n ↦ ∀ p ∈ n.primeFactors, p ∈ S),
    (μ n : ℝ) * Real.log (x / n) / n

open Classical in
/-- The defining sum of `M_S(x)`. -/
theorem moebiusSumIn_def (S : Set ℕ) (x : ℝ) :
    moebiusSumIn S x =
      ∑ n ∈ (Icc 1 ⌊x⌋₊).filter (fun n ↦ ∀ p ∈ n.primeFactors, p ∈ S), (μ n : ℝ) := (rfl)

open Classical in
/-- The defining sum of `m_S(x)`. -/
theorem moebiusDivSumIn_def (S : Set ℕ) (x : ℝ) :
    moebiusDivSumIn S x =
      ∑ n ∈ (Icc 1 ⌊x⌋₊).filter (fun n ↦ ∀ p ∈ n.primeFactors, p ∈ S), (μ n : ℝ) / n := (rfl)

open Classical in
/-- The defining sum of `ℓ_S(x)`. -/
theorem moebiusLogSumIn_def (S : Set ℕ) (x : ℝ) :
    moebiusLogSumIn S x =
      ∑ n ∈ (Icc 1 ⌊x⌋₊).filter (fun n ↦ ∀ p ∈ n.primeFactors, p ∈ S),
        (μ n : ℝ) * Real.log (x / n) / n := (rfl)

/-- `M_S(x) = 0` for `x < 1`: the sum is empty. -/
theorem moebiusSumIn_of_lt_one (hx : x < 1) : moebiusSumIn S x = 0 := by
  rw [moebiusSumIn, sum_filter]
  exact sum_Icc_one_natFloor_eq_zero _ hx

/-- `m_S(x) = 0` for `x < 1`: the sum is empty. -/
theorem moebiusDivSumIn_of_lt_one (hx : x < 1) : moebiusDivSumIn S x = 0 := by
  rw [moebiusDivSumIn, sum_filter]
  exact sum_Icc_one_natFloor_eq_zero _ hx

/-- `ℓ_S(x) = 0` for `x < 1`: the sum is empty. -/
theorem moebiusLogSumIn_of_lt_one (hx : x < 1) : moebiusLogSumIn S x = 0 := by
  rw [moebiusLogSumIn, sum_filter]
  exact sum_Icc_one_natFloor_eq_zero _ hx

/-- `M_S` is constant on each interval `[N, N + 1)`: `M_S(x) = M_S(⌊x⌋₊)`. -/
@[simp]
theorem moebiusSumIn_natFloor (S : Set ℕ) (x : ℝ) : moebiusSumIn S ⌊x⌋₊ = moebiusSumIn S x := by
  simp [moebiusSumIn]

/-- `m_S` is constant on each interval `[N, N + 1)`: `m_S(x) = m_S(⌊x⌋₊)`. -/
@[simp]
theorem moebiusDivSumIn_natFloor (S : Set ℕ) (x : ℝ) :
    moebiusDivSumIn S ⌊x⌋₊ = moebiusDivSumIn S x := by
  simp [moebiusDivSumIn]

/-! ### Sets containing every prime -/

/-- If `S` contains every prime, the restriction to `⟨S⟩` is vacuous on `n ≥ 1`. -/
private theorem filter_primeFactors_mem_eq_self (hS : {p : ℕ | p.Prime} ⊆ S) (N : ℕ)
    {_ : DecidablePred fun n : ℕ ↦ ∀ p ∈ n.primeFactors, p ∈ S} :
    (Icc 1 N).filter (fun n ↦ ∀ p ∈ n.primeFactors, p ∈ S) = Icc 1 N :=
  filter_true_of_mem fun _ _ _ hp ↦ hS (Nat.prime_of_mem_primeFactors hp)

/-- If `S` contains every prime, `M_S = M`. -/
theorem moebiusSumIn_of_setOf_prime_subset (hS : {p : ℕ | p.Prime} ⊆ S) (x : ℝ) :
    moebiusSumIn S x = moebiusSum x := by
  rw [moebiusSumIn, filter_primeFactors_mem_eq_self hS, moebiusSum_def]

/-- If `S` contains every prime, `m_S = m`. -/
theorem moebiusDivSumIn_of_setOf_prime_subset (hS : {p : ℕ | p.Prime} ⊆ S) (x : ℝ) :
    moebiusDivSumIn S x = moebiusDivSum x := by
  rw [moebiusDivSumIn, filter_primeFactors_mem_eq_self hS, moebiusDivSum_def]

/-- If `S` contains every prime, `ℓ_S = ℓ`. -/
theorem moebiusLogSumIn_of_setOf_prime_subset (hS : {p : ℕ | p.Prime} ⊆ S) (x : ℝ) :
    moebiusLogSumIn S x = moebiusLogSum x := by
  rw [moebiusLogSumIn, filter_primeFactors_mem_eq_self hS, moebiusLogSum_def]

/-! ### The empty set -/

/-- For `S = ∅` and `N ≥ 1`, only `n = 1` is `S`-factored in `[1, N]`. -/
private theorem filter_primeFactors_mem_empty {N : ℕ} (hN : 1 ≤ N)
    {_ : DecidablePred fun n : ℕ ↦ ∀ p ∈ n.primeFactors, p ∈ (∅ : Set ℕ)} :
    (Icc 1 N).filter (fun n ↦ ∀ p ∈ n.primeFactors, p ∈ (∅ : Set ℕ)) = {1} := by
  ext n
  simp only [mem_filter, mem_Icc, Set.mem_empty_iff_false, imp_false, mem_singleton]
  rw [← Finset.eq_empty_iff_forall_notMem, Nat.primeFactors_eq_empty]
  omega

/-- `M_∅(x) = 1` for `x ≥ 1`: only `n = 1` contributes. -/
theorem moebiusSumIn_empty (hx : 1 ≤ x) : moebiusSumIn ∅ x = 1 := by
  rw [moebiusSumIn, filter_primeFactors_mem_empty (Nat.one_le_floor_iff x |>.mpr hx)]
  simp

/-- `m_∅(x) = 1` for `x ≥ 1`: only `n = 1` contributes. -/
theorem moebiusDivSumIn_empty (hx : 1 ≤ x) : moebiusDivSumIn ∅ x = 1 := by
  rw [moebiusDivSumIn, filter_primeFactors_mem_empty (Nat.one_le_floor_iff x |>.mpr hx)]
  simp

/-- `ℓ_∅(x) = log x` for `x ≥ 1`: only `n = 1` contributes. -/
theorem moebiusLogSumIn_empty (hx : 1 ≤ x) : moebiusLogSumIn ∅ x = Real.log x := by
  rw [moebiusLogSumIn, filter_primeFactors_mem_empty (Nat.one_le_floor_iff x |>.mpr hx)]
  simp

/-! ### The coprime sums -/

/-- For `S_q = {p | ¬ p ∣ q}`, the `S_q`-factored `n ≥ 1` are those coprime to `q`. -/
private theorem filter_primeFactors_mem_setOf_not_dvd (q N : ℕ)
    {_ : DecidablePred fun n : ℕ ↦ ∀ p ∈ n.primeFactors, p ∈ {p : ℕ | ¬ p ∣ q}} :
    (Icc 1 N).filter (fun n ↦ ∀ p ∈ n.primeFactors, p ∈ {p : ℕ | ¬ p ∣ q}) =
      (Icc 1 N).filter (·.Coprime q) :=
  filter_congr fun _ hn ↦
    (Nat.coprime_iff_forall_mem_primeFactors_not_dvd (by grind)).symm

/-- The coprime Mertens function: `M_q(x) = ∑_{n ≤ x, (n, q) = 1} μ(n)`. -/
theorem moebiusSumIn_setOf_not_dvd (q : ℕ) (x : ℝ) :
    moebiusSumIn {p | ¬ p ∣ q} x = ∑ n ∈ Icc 1 ⌊x⌋₊ with n.Coprime q, (μ n : ℝ) := by
  rw [moebiusSumIn, filter_primeFactors_mem_setOf_not_dvd]

/-- The coprime logarithmic sum: `m_q(x) = ∑_{n ≤ x, (n, q) = 1} μ(n) / n`. -/
theorem moebiusDivSumIn_setOf_not_dvd (q : ℕ) (x : ℝ) :
    moebiusDivSumIn {p | ¬ p ∣ q} x = ∑ n ∈ Icc 1 ⌊x⌋₊ with n.Coprime q, (μ n : ℝ) / n := by
  rw [moebiusDivSumIn, filter_primeFactors_mem_setOf_not_dvd]

/-- The coprime weighted sum: `ℓ_q(x) = ∑_{n ≤ x, (n, q) = 1} μ(n) log (x / n) / n`. -/
theorem moebiusLogSumIn_setOf_not_dvd (q : ℕ) (x : ℝ) :
    moebiusLogSumIn {p | ¬ p ∣ q} x =
      ∑ n ∈ Icc 1 ⌊x⌋₊ with n.Coprime q, (μ n : ℝ) * Real.log (x / n) / n := by
  rw [moebiusLogSumIn, filter_primeFactors_mem_setOf_not_dvd]

end TauCeti
