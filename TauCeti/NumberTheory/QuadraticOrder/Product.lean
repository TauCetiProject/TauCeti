module
public import Mathlib.Algebra.QuadraticAlgebra.Basic
public import Mathlib.Algebra.Group.Prod
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Algebra.GroupWithZero.Units.Fintype
public import Mathlib.RingTheory.Conductor
public import Mathlib.RingTheory.Ideal.Prod
public import Mathlib.LinearAlgebra.FreeModule.PID
import Mathlib.Tactic.NormNum

/-!
# Congruence orders in the integer product ring

The subalgebra `productSubalgebra s` consists of pairs of integers whose difference is
divisible by `s`. It is generated by `(s, 0)`. For nonzero `s`, evaluation identifies it
with `QuadraticAlgebra ℤ 0 s`, giving the basis `(1, 1), (s, 0)`. The subalgebra is finite
as an integer module, and Mathlib's PID instance supplies freeness.

The conductor in `ℤ × ℤ` is the product of the two ideals generated by `s`. This also
characterizes the ideals of the full product ring that lie in the congruence order.
Units are exactly the contained pairs of integer units. There are four when `s` divides
`2` and two otherwise; modulus `1` gives the full product ring and its four units.
-/

public section

namespace TauCeti.QuadraticOrder

/-- The integer product subalgebra with coordinates congruent modulo `s`. -/
def productSubalgebra (s : ℤ) : Subalgebra ℤ (ℤ × ℤ) :=
  AlgHom.equalizer
    ((Ideal.Quotient.mkₐ ℤ (Ideal.span {s})).comp (AlgHom.fst ℤ ℤ ℤ))
    ((Ideal.Quotient.mkₐ ℤ (Ideal.span {s})).comp (AlgHom.snd ℤ ℤ ℤ))

/-- Membership is divisibility of the difference of the two integer coordinates. -/
@[simp]
theorem mem_productSubalgebra (s : ℤ) (z : ℤ × ℤ) :
    z ∈ productSubalgebra s ↔ s ∣ z.1 - z.2 := by
  simp only [productSubalgebra, AlgHom.mem_equalizer, AlgHom.comp_apply,
    AlgHom.fst_apply, AlgHom.snd_apply, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.eq, Ideal.mem_span_singleton]

/-- Evaluation of the integral model at the roots `s` and `0`. -/
def productLift (s : ℤ) : QuadraticAlgebra ℤ 0 s →ₐ[ℤ] ℤ × ℤ :=
  QuadraticAlgebra.lift ⟨(s, 0), by ext <;> simp [Algebra.smul_def]⟩

/-- The integral evaluation map in coordinates. -/
@[simp]
theorem productLift_apply (s : ℤ) (z : QuadraticAlgebra ℤ 0 s) :
    productLift s z = (z.re + s * z.im, z.re) := by
  ext <;> simp [productLift, QuadraticAlgebra.lift_apply_apply, Algebra.smul_def, mul_comm]

/-- The integral model maps onto the congruence subalgebra. -/
theorem range_productLift (s : ℤ) : (productLift s).range = productSubalgebra s := by
  ext z
  rw [AlgHom.mem_range, mem_productSubalgebra]
  constructor
  · rintro ⟨w, rfl⟩
    exact ⟨w.im, by simp⟩
  · rintro ⟨n, hn⟩
    refine ⟨⟨z.2, n⟩, ?_⟩
    ext <;> simp
    omega

/-- The congruence order is generated by `(s, 0)`. -/
theorem productSubalgebra_eq_adjoin (s : ℤ) :
    productSubalgebra s = Algebra.adjoin ℤ {(s, 0)} := by
  rw [← range_productLift, productLift, QuadraticAlgebra.range_lift]

/-- Nonzero congruence modulus makes the integral evaluation map injective. -/
theorem productLift_injective (s : ℤ) (hs : s ≠ 0) :
    Function.Injective (productLift s) := by
  intro z w h
  have hre : z.re = w.re := by simpa using congrArg Prod.snd h
  have him : s * z.im = s * w.im := by
    simpa [hre] using congrArg Prod.fst h
  ext
  · exact hre
  · exact mul_left_cancel₀ hs him

/-- The congruence subalgebra is finite as an integer module. -/
instance instFiniteProductSubalgebra (s : ℤ) : Module.Finite ℤ (productSubalgebra s) := by
  have h := Module.Finite.of_surjective (productLift s).rangeRestrict.toLinearMap
    (productLift s).rangeRestrict_surjective
  rw [range_productLift] at h
  exact h

/-- The integral model is isomorphic to the congruence product order. -/
noncomputable def equivProductSubalgebra (s : ℤ) (hs : s ≠ 0) :
    QuadraticAlgebra ℤ 0 s ≃ₐ[ℤ] productSubalgebra s :=
  (AlgEquiv.ofInjective (productLift s) (productLift_injective s hs)).trans
    (Subalgebra.equivOfEq _ _ (range_productLift s))

/-- The equivalence retains the evaluated pair. -/
@[simp]
theorem coe_equivProductSubalgebra_apply (s : ℤ) (hs : s ≠ 0)
    (z : QuadraticAlgebra ℤ 0 s) :
    (equivProductSubalgebra s hs z : ℤ × ℤ) = productLift s z := by
  simp [equivProductSubalgebra, AlgEquiv.ofInjective_apply]

/-- The basis consists of the diagonal unit and `(s, 0)`. -/
noncomputable def productBasis (s : ℤ) (hs : s ≠ 0) :
    Module.Basis (Fin 2) ℤ (productSubalgebra s) :=
  (QuadraticAlgebra.basis 0 s).map (equivProductSubalgebra s hs).toLinearEquiv

/-- The first basis vector is the diagonal unit. -/
@[simp]
theorem coe_productBasis_zero (s : ℤ) (hs : s ≠ 0) :
    (productBasis s hs 0 : ℤ × ℤ) = (1, 1) := by
  simp [productBasis, Module.Basis.map_apply]
  rfl

/-- The second basis vector is `(s, 0)`. -/
@[simp]
theorem coe_productBasis_one (s : ℤ) (hs : s ≠ 0) :
    (productBasis s hs 1 : ℤ × ℤ) = (s, 0) := by
  simp [productBasis, Module.Basis.map_apply]

/-- The conductor is the product of the two principal ideals generated by `s`. -/
theorem conductor_eq_prod_span (s : ℤ) :
    conductor ℤ (s, 0) = (Ideal.span {s}).prod (Ideal.span {s}) := by
  ext z
  rw [mem_conductor_iff]
  simp only [← productSubalgebra_eq_adjoin, mem_productSubalgebra,
    Ideal.mem_prod, Ideal.mem_span_singleton]
  constructor
  · intro h
    exact ⟨by simpa using h (1, 0), by simpa using h (0, 1)⟩
  · rintro ⟨h₁, h₂⟩ w
    exact dvd_sub (dvd_mul_of_dvd_left h₁ w.1) (dvd_mul_of_dvd_left h₂ w.2)

/-- The full product order is the congruence order of modulus one. -/
@[simp]
theorem productSubalgebra_one : productSubalgebra 1 = ⊤ := by
  ext z
  simp

/-- Units of the congruence order are exactly the pairs of integer units it contains. -/
theorem isUnit_productSubalgebra_iff (s : ℤ) (z : productSubalgebra s) :
    IsUnit z ↔ IsUnit z.val.1 ∧ IsUnit z.val.2 := by
  constructor
  · intro hz
    exact Prod.isUnit_iff.mp (hz.map (productSubalgebra s).val)
  · rintro ⟨h₁, h₂⟩
    have hz : z * z = 1 := by
      apply Subtype.ext
      apply Prod.ext
      · rcases Int.isUnit_iff.mp h₁ with h | h <;> simp [h]
      · rcases Int.isUnit_iff.mp h₂ with h | h <;> simp [h]
    exact ⟨⟨z, z, hz, hz⟩, rfl⟩

/-- An ideal of the full product ring lies in the congruence order exactly when both its
coordinates are divisible by the modulus. -/
theorem ideal_le_productSubalgebra_iff (s : ℤ) (I : Ideal (ℤ × ℤ)) :
    (∀ z ∈ I, z ∈ productSubalgebra s) ↔ I ≤ (Ideal.span {s}).prod (Ideal.span {s}) := by
  rw [← conductor_eq_prod_span]
  constructor
  · intro h z hz
    rw [mem_conductor_iff, ← productSubalgebra_eq_adjoin]
    intro w
    exact h (z * w) (I.mul_mem_right w hz)
  · intro h z hz
    rw [productSubalgebra_eq_adjoin]
    exact conductor_subset_adjoin (h hz)

/-- Unless the modulus divides two, every unit is the diagonal unit or its negative. -/
theorem units_eq_one_or_neg_one_of_not_dvd_two (s : ℤ) (hs : ¬ s ∣ 2)
    (u : (productSubalgebra s)ˣ) : u = 1 ∨ u = -1 := by
  have hu := (isUnit_productSubalgebra_iff s u).mp u.isUnit
  have hm := (mem_productSubalgebra s _).mp u.val.property
  rcases Int.isUnit_iff.mp hu.1 with h₁ | h₁ <;>
    rcases Int.isUnit_iff.mp hu.2 with h₂ | h₂
  · left
    apply Units.ext
    apply Subtype.ext
    exact Prod.ext h₁ h₂
  · exact (hs (by simpa [h₁, h₂] using hm)).elim
  · exact (hs (by simpa [h₁, h₂] using hm)).elim
  · right
    apply Units.ext
    apply Subtype.ext
    exact Prod.ext h₁ h₂

private theorem card_units_productSubalgebra_of_not_dvd_two (s : ℤ) (hs : ¬ s ∣ 2) :
    Nat.card (productSubalgebra s)ˣ = 2 := by
  apply (Nat.card_eq_two_iff' (1 : (productSubalgebra s)ˣ)).mpr
  refine ⟨-1, ?_, ?_⟩
  · intro h
    have he := congrArg (fun u : (productSubalgebra s)ˣ ↦ u.val.val.1) h
    norm_num at he
  · intro u hu
    exact (units_eq_one_or_neg_one_of_not_dvd_two s hs u).resolve_left hu

private theorem card_units_productSubalgebra_of_dvd_two (s : ℤ) (hs : s ∣ 2) :
    Nat.card (productSubalgebra s)ˣ = 4 := by
  let f := Units.map (productSubalgebra s).val.toMonoidHom
  have hi : Function.Injective f := Units.map_injective (fun _ _ h ↦ Subtype.ext h)
  have hf : Function.Surjective f := by
    intro u
    have hu := Prod.isUnit_iff.mp u.isUnit
    have hm : (u : ℤ × ℤ) ∈ productSubalgebra s := by
      rw [mem_productSubalgebra]
      rcases Int.isUnit_iff.mp hu.1 with h₁ | h₁ <;>
        rcases Int.isUnit_iff.mp hu.2 with h₂ | h₂ <;> norm_num [h₁, h₂, hs]
    let z : productSubalgebra s := ⟨u, hm⟩
    obtain ⟨v, hv⟩ := (isUnit_productSubalgebra_iff s z).mpr hu
    refine ⟨v, Units.ext ?_⟩
    exact congrArg Subtype.val hv
  rw [Nat.card_congr (Equiv.ofBijective f ⟨hi, hf⟩),
    Nat.card_congr (MulEquiv.prodUnits (M := ℤ) (N := ℤ)).toEquiv, Nat.card_prod]
  norm_num [Nat.card_eq_fintype_card]

/-- A congruence product order has four units when its modulus divides two, and two otherwise. -/
theorem card_units_productSubalgebra (s : ℤ) :
    Nat.card (productSubalgebra s)ˣ = if s ∣ 2 then 4 else 2 := by
  by_cases hs : s ∣ 2
  · simpa [hs] using card_units_productSubalgebra_of_dvd_two s hs
  · simpa [hs] using card_units_productSubalgebra_of_not_dvd_two s hs

end TauCeti.QuadraticOrder
