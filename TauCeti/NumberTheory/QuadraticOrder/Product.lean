/-!
# Congruence subalgebras of a product ring

For a commutative ring `R` and `s : R`, the subalgebra `productSubalgebra s` of `R × R` consists
of the pairs whose difference is divisible by `s`. It is generated by `(s, 0)` and is the image
of `QuadraticAlgebra R 0 s` under evaluation at the roots `s` and `0`. This evaluation is
injective when `R` has no zero divisors and `s` is nonzero, giving the basis `(1, 1), (s, 0)`.
The subalgebra is a finite `R`-module; over `ℤ`, Mathlib's PID instance supplies freeness.

The conductor of `(s, 0)` in `R × R` is the product of the two ideals generated by `s`. This also
characterizes the ideals of the full product ring that lie in the congruence subalgebra.
Units are exactly the contained pairs of units. Over `ℤ` there are four when `s` divides `2` and
two otherwise; modulus `1` gives the full product ring.
-/

public section

namespace TauCeti.QuadraticOrder

section CommRing

variable {R : Type*} [CommRing R]

/-- The product subalgebra with coordinates congruent modulo `s`. -/
def productSubalgebra (s : R) : Subalgebra R (R × R) :=
  AlgHom.equalizer
    ((Ideal.Quotient.mkₐ R (Ideal.span {s})).comp (AlgHom.fst R R R))
    ((Ideal.Quotient.mkₐ R (Ideal.span {s})).comp (AlgHom.snd R R R))

/-- Membership is divisibility of the difference of the two coordinates. -/
@[simp]
theorem mem_productSubalgebra (s : R) (z : R × R) :
    z ∈ productSubalgebra s ↔ s ∣ z.1 - z.2 := by
  simp only [productSubalgebra, AlgHom.mem_equalizer, AlgHom.comp_apply,
    AlgHom.fst_apply, AlgHom.snd_apply, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.eq, Ideal.mem_span_singleton]

/-- Evaluation of the quadratic model at the roots `s` and `0`. -/
def productLift (s : R) : QuadraticAlgebra R 0 s →ₐ[R] R × R :=
  QuadraticAlgebra.lift ⟨(s, 0), by ext <;> simp [Algebra.smul_def]⟩

/-- The evaluation map in coordinates. -/
@[simp]
theorem productLift_apply (s : R) (z : QuadraticAlgebra R 0 s) :
    productLift s z = (z.re + s * z.im, z.re) := by
  ext <;> simp [productLift, QuadraticAlgebra.lift_apply_apply, Algebra.smul_def, mul_comm]

/-- The quadratic model maps onto the congruence subalgebra. -/
theorem range_productLift (s : R) : (productLift s).range = productSubalgebra s := by
  ext z
  rw [AlgHom.mem_range, mem_productSubalgebra]
  constructor
  · rintro ⟨w, rfl⟩
    exact ⟨w.im, by simp⟩
  · rintro ⟨n, hn⟩
    exact ⟨⟨z.2, n⟩, by ext <;> simp [← hn]⟩

/-- The congruence subalgebra is generated by `(s, 0)`. -/
theorem productSubalgebra_eq_adjoin (s : R) :
    productSubalgebra s = Algebra.adjoin R {(s, 0)} := by
  rw [← range_productLift, productLift, QuadraticAlgebra.range_lift]

/-- A nonzero congruence modulus makes the evaluation map injective. -/
theorem productLift_injective [NoZeroDivisors R] (s : R) (hs : s ≠ 0) :
    Function.Injective (productLift s) := by
  intro z w h
  have hre : z.re = w.re := by simpa using congrArg Prod.snd h
  ext
  · exact hre
  · exact mul_left_cancel₀ hs (by simpa [hre] using congrArg Prod.fst h)

/-- The congruence subalgebra is a finite module. -/
instance instFiniteProductSubalgebra (s : R) : Module.Finite R (productSubalgebra s) := by
  have h := Module.Finite.of_surjective (productLift s).rangeRestrict.toLinearMap
    (productLift s).rangeRestrict_surjective
  rw [range_productLift] at h
  exact h

/-- The quadratic model is isomorphic to the congruence product subalgebra. -/
noncomputable def equivProductSubalgebra [NoZeroDivisors R] (s : R) (hs : s ≠ 0) :
    QuadraticAlgebra R 0 s ≃ₐ[R] productSubalgebra s :=
  (AlgEquiv.ofInjective (productLift s) (productLift_injective s hs)).trans
    (Subalgebra.equivOfEq _ _ (range_productLift s))

/-- The equivalence retains the evaluated pair. -/
@[simp]
theorem coe_equivProductSubalgebra_apply [NoZeroDivisors R] (s : R) (hs : s ≠ 0)
    (z : QuadraticAlgebra R 0 s) :
    (equivProductSubalgebra s hs z : R × R) = productLift s z := by
  simp [equivProductSubalgebra, AlgEquiv.ofInjective_apply]

/-- The basis consists of the diagonal unit and `(s, 0)`. -/
noncomputable def productBasis [NoZeroDivisors R] (s : R) (hs : s ≠ 0) :
    Module.Basis (Fin 2) R (productSubalgebra s) :=
  (QuadraticAlgebra.basis 0 s).map (equivProductSubalgebra s hs).toLinearEquiv

/-- The first basis vector is the diagonal unit. -/
@[simp]
theorem coe_productBasis_zero [NoZeroDivisors R] (s : R) (hs : s ≠ 0) :
    (productBasis s hs 0 : R × R) = (1, 1) := by
  simp [productBasis, Module.Basis.map_apply, Prod.ext_iff]

/-- The second basis vector is `(s, 0)`. -/
@[simp]
theorem coe_productBasis_one [NoZeroDivisors R] (s : R) (hs : s ≠ 0) :
    (productBasis s hs 1 : R × R) = (s, 0) := by
  simp [productBasis, Module.Basis.map_apply]

/-- The conductor is the product of the two principal ideals generated by `s`. -/
theorem conductor_eq_prod_span (s : R) :
    conductor R (s, 0) = (Ideal.span {s}).prod (Ideal.span {s}) := by
  ext z
  rw [mem_conductor_iff]
  simp only [← productSubalgebra_eq_adjoin, mem_productSubalgebra,
    Ideal.mem_prod, Ideal.mem_span_singleton]
  constructor
  · intro h
    exact ⟨by simpa using h (1, 0), by simpa using h (0, 1)⟩
  · rintro ⟨h₁, h₂⟩ w
    exact dvd_sub (dvd_mul_of_dvd_left h₁ w.1) (dvd_mul_of_dvd_left h₂ w.2)

/-- The full product algebra is the congruence subalgebra of modulus one. -/
@[simp]
theorem productSubalgebra_one : productSubalgebra (1 : R) = ⊤ := by
  ext z
  simp

/-- Units of the congruence subalgebra are exactly the pairs of units it contains. -/
theorem isUnit_productSubalgebra_iff (s : R) (z : productSubalgebra s) :
    IsUnit z ↔ IsUnit z.val.1 ∧ IsUnit z.val.2 := by
  refine ⟨fun hz ↦ Prod.isUnit_iff.mp (hz.map (productSubalgebra s).val), ?_⟩
  rintro ⟨⟨u₁, hu₁⟩, ⟨u₂, hu₂⟩⟩
  have hz := (mem_productSubalgebra s z).mp z.property
  rw [← hu₁, ← hu₂] at hz
  have hm : s ∣ (↑u₁⁻¹ : R) - ↑u₂⁻¹ := by
    have he : (↑u₁⁻¹ : R) - ↑u₂⁻¹ = ↑u₁⁻¹ * ↑u₂⁻¹ * -(↑u₁ - ↑u₂) := by
      linear_combination (-↑u₁⁻¹ : R) * u₂.inv_mul + ↑u₂⁻¹ * u₁.inv_mul
    exact he ▸ hz.neg_right.mul_left _
  refine isUnit_iff_exists_inv.mpr
    ⟨⟨(↑u₁⁻¹, ↑u₂⁻¹), (mem_productSubalgebra s _).mpr hm⟩, ?_⟩
  ext <;> simp [← hu₁, ← hu₂]

/-- An ideal of the full product ring lies in the congruence subalgebra exactly when both its
coordinates are divisible by the modulus. -/
theorem ideal_le_productSubalgebra_iff (s : R) (I : Ideal (R × R)) :
    (∀ z ∈ I, z ∈ productSubalgebra s) ↔ I ≤ (Ideal.span {s}).prod (Ideal.span {s}) := by
  rw [← conductor_eq_prod_span]
  constructor
  · intro h z hz
    rw [mem_conductor_iff, ← productSubalgebra_eq_adjoin]
    intro w
    exact h (z * w) (I.mul_mem_right w hz)
  · intro h z hz
    rw [productSubalgebra_eq_adjoin]
    exact conductor_subset_adjoin (h hz)

end CommRing

/-- Unless the modulus divides two, every unit is the diagonal unit or its negative. -/
theorem units_eq_one_or_neg_one_of_not_dvd_two (s : ℤ) (hs : ¬ s ∣ 2)
    (u : (productSubalgebra s)ˣ) : u = 1 ∨ u = -1 := by
  have hu := (isUnit_productSubalgebra_iff s u).mp u.isUnit
  have hm := (mem_productSubalgebra s _).mp u.val.property
  rcases Int.isUnit_iff.mp hu.1 with h₁ | h₁ <;> rcases Int.isUnit_iff.mp hu.2 with h₂ | h₂
  · exact .inl (Units.ext (Subtype.ext (Prod.ext h₁ h₂)))
  · exact (hs (by simpa [h₁, h₂] using hm)).elim
  · exact (hs (by simpa [h₁, h₂] using hm)).elim
  · exact .inr (Units.ext (Subtype.ext (Prod.ext h₁ h₂)))

private theorem card_units_productSubalgebra_of_not_dvd_two (s : ℤ) (hs : ¬ s ∣ 2) :
    Nat.card (productSubalgebra s)ˣ = 2 :=
  (Nat.card_eq_two_iff' 1).mpr ⟨-1, by simp [Units.ext_iff, Subtype.ext_iff, Prod.ext_iff],
    fun u hu ↦ (units_eq_one_or_neg_one_of_not_dvd_two s hs u).resolve_left hu⟩

private theorem card_units_productSubalgebra_of_dvd_two (s : ℤ) (hs : s ∣ 2) :
    Nat.card (productSubalgebra s)ˣ = 4 := by
  let f := Units.map (productSubalgebra s).val.toMonoidHom
  have hf : Function.Surjective f := by
    intro u
    have hu := Prod.isUnit_iff.mp u.isUnit
    have hm : (u : ℤ × ℤ) ∈ productSubalgebra s := by
      rw [mem_productSubalgebra]
      rcases Int.isUnit_iff.mp hu.1 with h₁ | h₁ <;>
        rcases Int.isUnit_iff.mp hu.2 with h₂ | h₂ <;> norm_num [h₁, h₂, hs]
    obtain ⟨v, hv⟩ := (isUnit_productSubalgebra_iff s ⟨u, hm⟩).mpr hu
    exact ⟨v, Units.ext (congrArg Subtype.val hv)⟩
  rw [Nat.card_congr (Equiv.ofBijective f ⟨Units.map_injective Subtype.val_injective, hf⟩),
    Nat.card_congr MulEquiv.prodUnits.toEquiv, Nat.card_prod]
  norm_num [Nat.card_eq_fintype_card]

/-- An integer congruence subalgebra has four units when its modulus divides two, and two
otherwise. -/
theorem card_units_productSubalgebra (s : ℤ) :
    Nat.card (productSubalgebra s)ˣ = if s ∣ 2 then 4 else 2 := by
  split_ifs with hs
  · exact card_units_productSubalgebra_of_dvd_two s hs
  · exact card_units_productSubalgebra_of_not_dvd_two s hs

end TauCeti.QuadraticOrder
