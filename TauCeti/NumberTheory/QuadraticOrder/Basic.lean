module
public import TauCeti.Algebra.QuadraticAlgebra.Discriminant
public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic

/-!
# Integral orders in rational quadratic algebras

For an integer `D ≡ 0, 1 mod 4`, the element `(D + ω)/2` in
`QuadraticAlgebra ℚ D 0` satisfies an integral quadratic relation. Its generated subalgebra
has the integral basis `1, (D + ω)/2`, whose trace-pairing discriminant is `D`. The basis
spans the rational quadratic algebra. This construction applies to both square and nonsquare
parameters; it does not require an ambient field.

The embedding uses the integral model `QuadraticAlgebra ℤ ((D - D²)/4) D` and Mathlib's
universal algebra homomorphism. The range description characterizes every order element
by its two integral coefficients.

## References

* D. A. Cox, *Primes of the Form x² + ny²*, §7.
-/

public section

open QuadraticAlgebra

namespace TauCeti.QuadraticOrder

/-- The integral generator `(D + √D)/2` in the rational quadratic algebra. -/
def generator (D : ℤ) : QuadraticAlgebra ℚ (D : ℚ) 0 :=
  ⟨(D : ℚ) / 2, 1 / 2⟩

/-- The rational coefficient of the half-integral generator. -/
@[simp] theorem generator_re (D : ℤ) : (generator D).re = (D : ℚ) / 2 := (rfl)

/-- The square-root coefficient of the half-integral generator. -/
@[simp] theorem generator_im (D : ℤ) : (generator D).im = 1 / 2 := (rfl)

/-- The integral parameter has quadratic discriminant `D` for a valid discriminant. -/
theorem parameter_discr (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    QuadraticAlgebra.discr ((D - D ^ 2) / 4) D = D := by
  have hdiv : (4 : ℤ) ∣ D - D ^ 2 := by
    rw [Int.dvd_iff_emod_eq_zero, Int.sub_emod, pow_two, Int.mul_emod]
    rcases hD with hD | hD <;> simp [hD]
  have hmul := Int.mul_ediv_cancel' hdiv
  rw [QuadraticAlgebra.discr_def]
  omega

/-- The half-integral generator satisfies the defining integral relation. -/
theorem generator_mul_generator (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    generator D * generator D = ((D - D ^ 2) / 4) • 1 + D • generator D := by
  have hd : (D : ℚ) ^ 2 + 4 * (((D - D ^ 2) / 4 : ℤ) : ℚ) = D := by
    have hd := parameter_discr D hD
    rw [QuadraticAlgebra.discr_def] at hd
    exact_mod_cast hd
  ext <;> simp [generator]
  · linarith
  · ring

/-- Embedding the integral quadratic algebra generated by `(D + √D)/2`. -/
def lift (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    QuadraticAlgebra ℤ ((D - D ^ 2) / 4) D →ₐ[ℤ] QuadraticAlgebra ℚ (D : ℚ) 0 :=
  QuadraticAlgebra.lift ⟨generator D, generator_mul_generator D hD⟩

/-- Evaluation of the integral-model embedding in its two coefficients. -/
theorem lift_apply (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1)
    (z : QuadraticAlgebra ℤ ((D - D ^ 2) / 4) D) :
    lift D hD z = z.re • 1 + z.im • generator D := by
  simp only [lift, QuadraticAlgebra.lift_apply_apply]

/-- The integral-model generator maps to the half-integral generator. -/
@[simp] theorem lift_omega (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    lift D hD ω = generator D := by
  simp only [lift_apply, re_omega, im_omega, zero_smul, one_smul, zero_add]

/-- The two integral generators are linearly independent. -/
theorem lift_injective (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    Function.Injective (lift D hD) := by
  rw [lift, QuadraticAlgebra.lift_injective_iff, LinearIndependent.pair_iff]
  intro m n h
  have hi := congrArg QuadraticAlgebra.im h
  have hn : n = 0 := by
    have hnQ : (n : ℚ) = 0 := by simpa [generator] using hi
    exact_mod_cast hnQ
  subst n
  have hr := congrArg QuadraticAlgebra.re h
  have hmQ : (m : ℚ) = 0 := by simpa using hr
  exact ⟨by exact_mod_cast hmQ, rfl⟩

/-- The actual integral order as a subalgebra of the quadratic algebra. -/
def toSubalgebra (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    Subalgebra ℤ (QuadraticAlgebra ℚ (D : ℚ) 0) := (lift D hD).range

/-- Every element of the order has two integral coefficients in the basis `1, (D + √D)/2`. -/
theorem mem_toSubalgebra_iff (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1)
    (z : QuadraticAlgebra ℚ (D : ℚ) 0) :
    z ∈ toSubalgebra D hD ↔ ∃ m n : ℤ, z = m • 1 + n • generator D := by
  rw [toSubalgebra, AlgHom.mem_range]
  constructor
  · rintro ⟨w, rfl⟩
    exact ⟨w.re, w.im, lift_apply D hD w⟩
  · rintro ⟨m, n, rfl⟩
    exact ⟨⟨m, n⟩, lift_apply D hD ⟨m, n⟩⟩

/-- The order is generated by `(D + √D)/2`. -/
theorem toSubalgebra_eq_adjoin (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    toSubalgebra D hD = Algebra.adjoin ℤ {generator D} :=
  QuadraticAlgebra.range_lift (generator_mul_generator D hD)

/-- The integral model is algebra-isomorphic to the embedded order. -/
noncomputable def equivToSubalgebra (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    QuadraticAlgebra ℤ ((D - D ^ 2) / 4) D ≃ₐ[ℤ] toSubalgebra D hD :=
  AlgEquiv.ofInjective (lift D hD) (lift_injective D hD)

/-- The integral-model equivalence preserves its image in the quadratic algebra. -/
@[simp] theorem coe_equivToSubalgebra_apply (D : ℤ)
    (hD : D % 4 = 0 ∨ D % 4 = 1) (z : QuadraticAlgebra ℤ ((D - D ^ 2) / 4) D) :
    (equivToSubalgebra D hD z : QuadraticAlgebra ℚ (D : ℚ) 0) = lift D hD z := by
  unfold toSubalgebra equivToSubalgebra
  exact AlgEquiv.ofInjective_apply _ _ _

/-- The embedded order is finite over the integers. -/
instance instFinite (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    Module.Finite ℤ (toSubalgebra D hD) :=
  Module.Finite.of_surjective (equivToSubalgebra D hD).toLinearEquiv.toLinearMap
    (equivToSubalgebra D hD).surjective

/-- Every element of the embedded order is integral over the integers. -/
theorem isIntegral (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) (z : toSubalgebra D hD) :
    IsIntegral ℤ (z : QuadraticAlgebra ℚ (D : ℚ) 0) :=
  (IsIntegral.of_finite ℤ z).map (toSubalgebra D hD).val

/-- The integral basis `1, (D + √D)/2` of the order. -/
noncomputable def basis (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    Module.Basis (Fin 2) ℤ (toSubalgebra D hD) :=
  (QuadraticAlgebra.basis ((D - D ^ 2) / 4) D).map
    (equivToSubalgebra D hD).toLinearEquiv

/-- The embedded order is free over the integers. -/
instance instFree (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    Module.Free ℤ (toSubalgebra D hD) := Module.Free.of_basis (basis D hD)

/-- The trace-pairing discriminant of the order basis is `D`. -/
theorem discr_basis (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    Algebra.discr ℤ (basis D hD) = D := by
  calc
    Algebra.discr ℤ (basis D hD) =
        Algebra.discr ℤ (QuadraticAlgebra.basis ((D - D ^ 2) / 4) D) := by
      simpa only [basis, Module.Basis.coe_map, AlgEquiv.coe_toLinearEquiv] using
        (Algebra.discr_eq_discr_of_algEquiv
          (QuadraticAlgebra.basis ((D - D ^ 2) / 4) D) (equivToSubalgebra D hD)).symm
    _ = D := by rw [QuadraticAlgebra.algebraDiscr_basis, parameter_discr D hD]

/-- The embedded order spans the rational quadratic algebra. -/
theorem span_toSubalgebra_eq_top (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    Submodule.span ℚ (toSubalgebra D hD : Set (QuadraticAlgebra ℚ (D : ℚ) 0)) = ⊤ := by
  let S := Submodule.span ℚ (toSubalgebra D hD : Set (QuadraticAlgebra ℚ (D : ℚ) 0))
  have h1 : (1 : QuadraticAlgebra ℚ (D : ℚ) 0) ∈ S :=
    Submodule.subset_span (toSubalgebra D hD).one_mem
  have hw : generator D ∈ S := by
    apply Submodule.subset_span
    rw [toSubalgebra_eq_adjoin]
    exact Algebra.subset_adjoin (Set.mem_singleton _)
  have hom : (ω : QuadraticAlgebra ℚ (D : ℚ) 0) =
      (2 : ℚ) • generator D - (D : ℚ) • 1 := by
    ext <;> simp [generator, smul_eq_mul]
    ring
  have ho : (ω : QuadraticAlgebra ℚ (D : ℚ) 0) ∈ S := by
    rw [hom]
    exact S.sub_mem (S.smul_mem _ hw) (S.smul_mem _ h1)
  apply top_unique
  intro z _
  rw [← QuadraticAlgebra.re_smul_add_im_smul z]
  exact S.add_mem (S.smul_mem _ h1) (S.smul_mem _ ho)

/-- The first order basis vector is one. -/
@[simp] theorem coe_basis_zero (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    (basis D hD 0 : QuadraticAlgebra ℚ (D : ℚ) 0) = 1 := by
  rw [basis, Module.Basis.map_apply, QuadraticAlgebra.basis_apply_zero]
  rw [AlgEquiv.coe_toLinearEquiv, coe_equivToSubalgebra_apply]
  exact map_one _

/-- The second order basis vector is the half-integral generator. -/
@[simp] theorem coe_basis_one (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) :
    (basis D hD 1 : QuadraticAlgebra ℚ (D : ℚ) 0) = generator D := by
  rw [basis, Module.Basis.map_apply, QuadraticAlgebra.basis_apply_one]
  rw [AlgEquiv.coe_toLinearEquiv, coe_equivToSubalgebra_apply]
  simp [lift]

end TauCeti.QuadraticOrder
