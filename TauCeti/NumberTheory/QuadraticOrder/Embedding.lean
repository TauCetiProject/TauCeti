module
public import TauCeti.NumberTheory.QuadraticOrder.Field
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Canonical orders in a supplied quadratic number field

A square root of a nonsquare integer `D` in a number field of rational degree two
identifies the field with the rational quadratic algebra of `D`. Evaluation transports
the canonical integral order to the subalgebra generated by `(D + √D)/2` in that field.

The construction returns an actual `GlobalNumberFields.NumberFieldOrder`. Its integral
basis has vectors `1` and `(D + √D)/2`, its discriminant is `D`, and it is maximal exactly
when `D` is fundamental.

## References

* D. A. Cox, *Primes of the Form x² + ny²*, §7.
-/

public section

open QuadraticAlgebra

namespace TauCeti.QuadraticOrder
open TauCeti.GlobalNumberFields

variable {K : Type*} [Field K] [NumberField K]

/-- Evaluation at a square root identifies the rational model with the given quadratic field. -/
noncomputable def algEquivOfSqrt (D : ℤ) [Fact (¬ IsSquare D)] (δ : K)
    (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) :
    QuadraticAlgebra ℚ (D : ℚ) 0 ≃ₐ[ℚ] K := by
  let f : QuadraticAlgebra ℚ (D : ℚ) 0 →ₐ[ℚ] K :=
    QuadraticAlgebra.lift ⟨δ, by simpa [Algebra.smul_def, ← sq] using hδ⟩
  exact AlgEquiv.ofBijective f ⟨f.injective,
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (f := f.toLinearMap)
      (by rw [QuadraticAlgebra.finrank_eq_two, hK])).mp f.injective⟩

/-- The field identification is evaluation at the chosen square root. -/
@[simp] theorem algEquivOfSqrt_apply (D : ℤ) [Fact (¬ IsSquare D)] (δ : K)
    (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2)
    (z : QuadraticAlgebra ℚ (D : ℚ) 0) :
    algEquivOfSqrt D δ hδ hK z = z.re • (1 : K) + z.im • δ := by
  unfold algEquivOfSqrt
  exact AlgEquiv.ofBijective_apply _ _ _

/-- The same canonical order, embedded in a supplied quadratic number field. -/
noncomputable def numberFieldOrderOfSqrt (D : ℤ)
    (hD : D % 4 = 0 ∨ D % 4 = 1) [Fact (¬ IsSquare D)] (δ : K)
    (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) : NumberFieldOrder K where
  toSubalgebra := (toSubalgebra D hD).map ((algEquivOfSqrt D δ hδ hK).toAlgHom.restrictScalars ℤ)
  finite := by
    let f := (algEquivOfSqrt D δ hδ hK).toAlgHom.restrictScalars ℤ
    exact Module.Finite.of_surjective (f.subalgebraMap (toSubalgebra D hD)).toLinearMap
      (f.subalgebraMap_surjective _)
  spans := by
    simp only [Subalgebra.coe_map]
    -- Both scalar restrictions have the same underlying evaluation map.
    change Submodule.span ℚ ((algEquivOfSqrt D δ hδ hK).toLinearEquiv.toLinearMap ''
      (toSubalgebra D hD : Set (QuadraticAlgebra ℚ (D : ℚ) 0))) = ⊤
    rw [Submodule.span_image, span_toSubalgebra_eq_top, Submodule.map_top]
    exact LinearMap.range_eq_top.mpr (algEquivOfSqrt D δ hδ hK).surjective

/-- The field order's carrier is the image of the canonical integral order. -/
@[simp] theorem numberFieldOrderOfSqrt_toSubalgebra (D : ℤ)
    (hD : D % 4 = 0 ∨ D % 4 = 1) [Fact (¬ IsSquare D)] (δ : K)
    (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) :
    (numberFieldOrderOfSqrt D hD δ hδ hK).toSubalgebra =
      (toSubalgebra D hD).map ((algEquivOfSqrt D δ hδ hK).toAlgHom.restrictScalars ℤ) := (rfl)

/-- Evaluation identifies the integral canonical order with its image in the supplied field. -/
noncomputable def equivNumberFieldOrderOfSqrt (D : ℤ)
    (hD : D % 4 = 0 ∨ D % 4 = 1) [Fact (¬ IsSquare D)] (δ : K)
    (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) :
    toSubalgebra D hD ≃ₐ[ℤ] (numberFieldOrderOfSqrt D hD δ hδ hK).toSubalgebra :=
  (toSubalgebra D hD).equivMapOfInjective
    ((algEquivOfSqrt D δ hδ hK).toAlgHom.restrictScalars ℤ)
    (algEquivOfSqrt D δ hδ hK).injective

/-- The integral basis after embedding in the chosen quadratic number field. -/
noncomputable def basisOfSqrt (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1)
    [Fact (¬ IsSquare D)] (δ : K) (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) :
    Module.Basis (Fin 2) ℤ (numberFieldOrderOfSqrt D hD δ hδ hK).toSubalgebra :=
  (basis D hD).map (equivNumberFieldOrderOfSqrt D hD δ hδ hK).toLinearEquiv

/-- Embedding preserves the discriminant of the canonical basis. -/
theorem discr_basisOfSqrt (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1)
    [Fact (¬ IsSquare D)] (δ : K) (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) :
    Algebra.discr ℤ (basisOfSqrt D hD δ hδ hK) = D := by
  calc
    Algebra.discr ℤ (basisOfSqrt D hD δ hδ hK) = Algebra.discr ℤ (basis D hD) := by
      simpa only [basisOfSqrt, Module.Basis.coe_map, AlgEquiv.coe_toLinearEquiv] using
        (Algebra.discr_eq_discr_of_algEquiv
          (basis D hD) (equivNumberFieldOrderOfSqrt D hD δ hδ hK)).symm
    _ = D := discr_basis D hD

/-- The embedded canonical order has the original integral discriminant. -/
@[simp] theorem numberFieldOrderOfSqrt_discr (D : ℤ)
    (hD : D % 4 = 0 ∨ D % 4 = 1) [Fact (¬ IsSquare D)] (δ : K)
    (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) :
    (numberFieldOrderOfSqrt D hD δ hδ hK).discr = D := by
  rw [← (numberFieldOrderOfSqrt D hD δ hδ hK).discr_eq_discr
    (basisOfSqrt D hD δ hδ hK), discr_basisOfSqrt]

/-- The embedded canonical order is maximal exactly at fundamental discriminants. -/
@[simp] theorem numberFieldOrderOfSqrt_eq_maximal_iff (D : ℤ)
    (hD : D % 4 = 0 ∨ D % 4 = 1) [Fact (¬ IsSquare D)] (δ : K)
    (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) :
    numberFieldOrderOfSqrt D hD δ hδ hK = maximalNumberFieldOrder K ↔
      Int.IsFundamentalDiscr D := by
  let e := (algEquivOfSqrt D δ hδ hK).restrictScalars ℤ
  have hm : (maximalNumberFieldOrder (QuadraticAlgebra ℚ (D : ℚ) 0)).toSubalgebra.map e.toAlgHom =
      (maximalNumberFieldOrder K).toSubalgebra := by
    rw [maximalNumberFieldOrder_toSubalgebra, maximalNumberFieldOrder_toSubalgebra]
    exact integralClosure_map_algEquiv e
  rw [← numberFieldOrder_eq_maximal_iff D hD]
  constructor
  · intro h
    apply NumberFieldOrder.ext
    apply Subalgebra.map_injective (f := e.toAlgHom) e.injective
    rw [hm]
    have hh := congrArg NumberFieldOrder.toSubalgebra h
    rw [numberFieldOrderOfSqrt_toSubalgebra] at hh
    simpa only [e, AlgEquiv.toAlgHom_restrictScalars, numberFieldOrder_toSubalgebra] using hh
  · intro h
    apply NumberFieldOrder.ext
    rw [numberFieldOrderOfSqrt_toSubalgebra]
    rw [← numberFieldOrder_toSubalgebra D hD, h]
    exact hm

/-- Evaluation sends the canonical half-integral generator to `(D + δ)/2`. -/
theorem algEquivOfSqrt_apply_generator (D : ℤ) [Fact (¬ IsSquare D)] (δ : K)
    (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) :
    algEquivOfSqrt D δ hδ hK (generator D) = ((D : K) + δ) / 2 := by
  rw [algEquivOfSqrt_apply]
  simp [Algebra.smul_def]
  ring

/-- Membership in the embedded order is an integral linear combination of its two generators. -/
theorem mem_numberFieldOrderOfSqrt_iff (D : ℤ)
    (hD : D % 4 = 0 ∨ D % 4 = 1) [Fact (¬ IsSquare D)] (δ : K)
    (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) (x : K) :
    x ∈ (numberFieldOrderOfSqrt D hD δ hδ hK).toSubalgebra ↔
      ∃ m n : ℤ, x = m • (1 : K) + n • (((D : K) + δ) / 2) := by
  rw [numberFieldOrderOfSqrt_toSubalgebra, Subalgebra.mem_map]
  constructor
  · rintro ⟨z, hz, rfl⟩
    obtain ⟨m, n, rfl⟩ := (mem_toSubalgebra_iff D hD z).mp hz
    refine ⟨m, n, ?_⟩
    simp only [AlgHom.restrictScalars_apply, AlgEquiv.toAlgHom_apply, map_add,
      map_zsmul, map_one, algEquivOfSqrt_apply_generator]
  · rintro ⟨m, n, rfl⟩
    refine ⟨m • 1 + n • generator D, (mem_toSubalgebra_iff D hD _).mpr ⟨m, n, rfl⟩, ?_⟩
    simp only [AlgHom.restrictScalars_apply, AlgEquiv.toAlgHom_apply, map_add,
      map_zsmul, map_one, algEquivOfSqrt_apply_generator]

/-- The order equivalence evaluates its embedded elements at the chosen square root. -/
@[simp] theorem coe_equivNumberFieldOrderOfSqrt_apply (D : ℤ)
    (hD : D % 4 = 0 ∨ D % 4 = 1) [Fact (¬ IsSquare D)] (δ : K)
    (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) (z : toSubalgebra D hD) :
    (equivNumberFieldOrderOfSqrt D hD δ hδ hK z : K) =
      algEquivOfSqrt D δ hδ hK (z : QuadraticAlgebra ℚ (D : ℚ) 0) := by
  unfold equivNumberFieldOrderOfSqrt numberFieldOrderOfSqrt
  exact Subalgebra.coe_equivMapOfInjective_apply _ _ _ _

/-- The embedded integral basis starts with one. -/
@[simp] theorem coe_basisOfSqrt_zero (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1)
    [Fact (¬ IsSquare D)] (δ : K) (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) :
    (basisOfSqrt D hD δ hδ hK 0 : K) = 1 := by
  rw [basisOfSqrt, Module.Basis.map_apply, AlgEquiv.coe_toLinearEquiv,
    coe_equivNumberFieldOrderOfSqrt_apply, coe_basis_zero]
  exact map_one _

/-- The second embedded basis vector is the half-integral generator. -/
@[simp] theorem coe_basisOfSqrt_one (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1)
    [Fact (¬ IsSquare D)] (δ : K) (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) :
    (basisOfSqrt D hD δ hδ hK 1 : K) = ((D : K) + δ) / 2 := by
  rw [basisOfSqrt, Module.Basis.map_apply, AlgEquiv.coe_toLinearEquiv,
    coe_equivNumberFieldOrderOfSqrt_apply, coe_basis_one, algEquivOfSqrt_apply_generator]

/-- The order in the supplied field is generated by `(D + δ)/2`. -/
theorem numberFieldOrderOfSqrt_toSubalgebra_eq_adjoin (D : ℤ)
    (hD : D % 4 = 0 ∨ D % 4 = 1) [Fact (¬ IsSquare D)] (δ : K)
    (hδ : δ ^ 2 = (D : K)) (hK : Module.finrank ℚ K = 2) :
    (numberFieldOrderOfSqrt D hD δ hδ hK).toSubalgebra =
      Algebra.adjoin ℤ {((D : K) + δ) / 2} := by
  rw [numberFieldOrderOfSqrt_toSubalgebra, toSubalgebra_eq_adjoin,
    AlgHom.map_adjoin, Set.image_singleton]
  exact congrArg (fun x : K ↦ Algebra.adjoin ℤ {x})
    (algEquivOfSqrt_apply_generator D δ hδ hK)

end TauCeti.QuadraticOrder
