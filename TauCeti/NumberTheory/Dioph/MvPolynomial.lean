module

public import Mathlib.Algebra.MvPolynomial.Funext
public import Mathlib.NumberTheory.Dioph

/-!
# Native Diophantine polynomials are integer multivariate polynomials

Mathlib's `Poly α` is the ring of functions `(α → ℕ) → ℤ` generated by the coordinate
projections and the integer constants; it is the polynomial carrier of `Dioph`. Its module
docstring records the comparison with `MvPolynomial α ℤ` as missing. This file supplies it.

`MvPolynomial.toPoly` evaluates an integer polynomial on natural assignments, cast to the
integers. It is a ring homomorphism, and it is bijective for every type of variables `α`:
surjectivity is an induction over the constructors of `Poly`, and injectivity holds because an
integer polynomial is determined by its values on the infinite box `ℕ^α ⊆ ℤ^α`
(`MvPolynomial.funext_set`). Hence `Poly α` and `MvPolynomial α ℤ` are isomorphic rings, by
`MvPolynomial.polyEquiv`. The inverse is classical: a bare `Poly` carries no syntax, so this
file asserts the existence of a polynomial representative, not a computable way to find one.

## Main definitions

* `MvPolynomial.toPoly`: an integer polynomial as a native polynomial function on `ℕ^α`.
* `MvPolynomial.polyEquiv`: the ring equivalence `MvPolynomial α ℤ ≃+* Poly α`.

## Main results

* `MvPolynomial.toPoly_apply`: `toPoly p` is evaluation of `p` at the integer casts of a
  natural assignment.
* `MvPolynomial.toPoly_injective`, `MvPolynomial.toPoly_surjective`.
* `MvPolynomial.toPoly_rename`: renaming variables corresponds to `Poly.map`.
* `MvPolynomial.eval_polyEquiv_symm`: the polynomial representative of `f : Poly α` evaluates
  to `f` on natural assignments.

## References

* B. Poonen, *Undecidability in number theory*, Notices Amer. Math. Soc. 55 (2008),
  Definition 1 and footnote 4.
* The comparison follows C. Freer's Lean development *hilbert10*, file `PolyBridge.lean`
  (`toDiophPoly` and `exists_mvPolynomial`).
-/

public section

namespace MvPolynomial

variable {α β : Type*}

/-- An integer polynomial as a native Diophantine polynomial function: the function
`(α → ℕ) → ℤ` evaluating it at the integer casts of a natural assignment
(`MvPolynomial.toPoly_apply`). -/
def toPoly : MvPolynomial α ℤ →+* Poly α :=
  eval₂Hom (Int.castRingHom (Poly α)) Poly.proj

theorem toPoly_C (c : ℤ) : toPoly (C c : MvPolynomial α ℤ) = Poly.const c := by
  ext x
  simp [toPoly]

@[simp]
theorem toPoly_X (i : α) : toPoly (X i : MvPolynomial α ℤ) = Poly.proj i :=
  eval₂Hom_X' _ _ i

/-- `toPoly p` evaluates `p` at the integer casts of a natural assignment; negative
coefficients keep their integer values, with no truncated subtraction. -/
@[simp]
theorem toPoly_apply (p : MvPolynomial α ℤ) (x : α → ℕ) :
    toPoly p x = eval (Nat.cast ∘ x) p := by
  induction p using MvPolynomial.induction_on with
  | C c => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp => simp [hp]

/-- An integer polynomial is determined by its values on natural assignments. -/
theorem toPoly_injective : Function.Injective (toPoly : MvPolynomial α ℤ →+* Poly α) := by
  intro p q hpq
  refine funext_set (fun _ ↦ Set.range ((↑) : ℕ → ℤ))
    (fun _ ↦ Set.infinite_range_of_injective Nat.cast_injective) fun y hy ↦ ?_
  choose x hx using fun i ↦ hy i (Set.mem_univ i)
  obtain rfl : Nat.cast ∘ x = y := _root_.funext hx
  rw [← toPoly_apply, ← toPoly_apply, hpq]

/-- Every native Diophantine polynomial function is given by an integer polynomial. -/
theorem toPoly_surjective : Function.Surjective (toPoly : MvPolynomial α ℤ →+* Poly α) := by
  intro f
  induction f using Poly.induction with
  | H1 i => exact ⟨X i, toPoly_X i⟩
  | H2 n => exact ⟨C n, toPoly_C n⟩
  | H3 f g hf hg =>
    obtain ⟨p, rfl⟩ := hf
    obtain ⟨q, rfl⟩ := hg
    exact ⟨p - q, map_sub _ _ _⟩
  | H4 f g hf hg =>
    obtain ⟨p, rfl⟩ := hf
    obtain ⟨q, rfl⟩ := hg
    exact ⟨p * q, map_mul _ _ _⟩

/-- Renaming variables along any map `h : α → β`, injective or not, corresponds to
`Poly.map h`. -/
@[simp]
theorem toPoly_rename (h : α → β) (p : MvPolynomial α ℤ) :
    toPoly (rename h p) = (toPoly p).map h := by
  ext x
  simp [eval_rename, Function.comp_def]

variable (α) in
/-- Integer polynomials in the variables `α` and native Diophantine polynomial functions on
`ℕ^α` are isomorphic rings, by `MvPolynomial.toPoly`. The inverse sends a polynomial function
to its unique integer polynomial representative; it is classical. -/
noncomputable def polyEquiv : MvPolynomial α ℤ ≃+* Poly α :=
  RingEquiv.ofBijective toPoly ⟨toPoly_injective, toPoly_surjective⟩

@[simp]
theorem polyEquiv_apply (p : MvPolynomial α ℤ) : polyEquiv α p = toPoly p :=
  RingEquiv.ofBijective_apply _ _ _

/-- The integer polynomial representing `f : Poly α` evaluates to `f` on natural
assignments. -/
@[simp]
theorem eval_polyEquiv_symm (f : Poly α) (x : α → ℕ) :
    eval (Nat.cast ∘ x) ((polyEquiv α).symm f) = f x := by
  rw [← toPoly_apply, ← polyEquiv_apply, RingEquiv.apply_symm_apply]

@[simp]
theorem polyEquiv_symm_const (c : ℤ) : (polyEquiv α).symm (Poly.const c) = C c := by
  rw [RingEquiv.symm_apply_eq, polyEquiv_apply, toPoly_C]

@[simp]
theorem polyEquiv_symm_proj (i : α) : (polyEquiv α).symm (Poly.proj i) = X i := by
  rw [RingEquiv.symm_apply_eq, polyEquiv_apply, toPoly_X]

/-- The polynomial representative of `Poly.map h f` is the renaming of that of `f`. -/
@[simp]
theorem polyEquiv_symm_map (h : α → β) (f : Poly α) :
    (polyEquiv β).symm (f.map h) = rename h ((polyEquiv α).symm f) := by
  rw [RingEquiv.symm_apply_eq, polyEquiv_apply, toPoly_rename, ← polyEquiv_apply,
    RingEquiv.apply_symm_apply]

end MvPolynomial
