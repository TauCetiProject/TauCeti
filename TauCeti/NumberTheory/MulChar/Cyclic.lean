module

public import Mathlib.NumberTheory.MulChar.Lemmas
import Mathlib.Algebra.Ring.GeomSum
import Mathlib.RingTheory.IntegralDomain

/-!
# Generators of the character group of a monoid with cyclic unit group

Let `M` be a commutative monoid whose unit group is generated by `g`. A character is determined by
its value at `g`, and the value has the order of the character. With values in a domain and `Mˣ`
finite of order `n`, the values at `g` are `n`-th roots of unity, so the characters form a cyclic
group with at most `n` elements.

For `M` finite, for instance a finite field, where `n = q - 1`, Mathlib's `MulChar.ofRootOfUnity`
sends an `n`-th root of unity `ζ` to the character that maps `g` to `ζ`. Its order is the order of
`ζ`, so a primitive `n`-th root of unity gives a character of order `n`. With values in a domain,
a character `ω` of order `n` generates the character group: every character is `ω ^ m` for exactly
one `m < n`. The order of `ω ^ m` is then `n / gcd(n, m)` by Mathlib's `orderOf_pow`. For a finite
field `F`, the order of every character divides `#F - 1` (Mathlib's
`MulChar.orderOf_dvd_card_sub_one`). Conversely, for `d ∣ #F - 1` there is a character of order
`d` if the target ring has a primitive `d`-th root of unity (Mathlib's
`MulChar.exists_mulChar_orderOf`). For complex values this holds for every such `d`, so `F` has
complex characters of order `d` exactly for `d ∣ #F - 1`.

## Main results

* `MulChar.mulEquivRootsOfUnityOfGenerator`: if `g` generates `Mˣ`, evaluation at `g` identifies
  the characters with the `#Mˣ`-th roots of unity of `R`.
* `MulChar.orderOf_apply_eq_orderOf`: if `g` generates `Mˣ`, then `χ g` has the order of `χ`.
* `MulChar.isCyclic`: with values in a domain, the characters of a monoid with a finite cyclic unit
  group form a cyclic group.
* `TauCeti.orderOf_ofRootOfUnity`: the character `ofRootOfUnity hζ hg` has the order of `ζ`.
* `TauCeti.orderOf_ofRootOfUnity_of_isPrimitiveRoot`: for a primitive `n`-th root of unity `ζ`,
  it has order `n`.
* `MulChar.existsUnique_lt_and_pow_eq`: with values in a domain, every character is `ω ^ m` for
  exactly one `m < n`, for any character `ω` of order `n`.
* `MulChar.injective_toUnitHom_of_orderOf_eq_card`: with values in a domain, a character of
  order `#Mˣ` is injective on units.
* `MulChar.sum_range_pow_apply_eq_ite`: `∑_{m < #Mˣ} (ω ^ m) x` is `#Mˣ` at `x = 1` and `0`
  elsewhere, for `ω` of order `#Mˣ` with values in a domain. This is the column orthogonality
  relation written over the powers of a generating character, the form in which the indicator of
  `x = y` is expanded in the finite hypergeometric sums of Beukers, Cohen and Mellit.
-/

public section

namespace MulChar

section CommMonoidWithZero

variable {M : Type*} [CommMonoid M] {R : Type*} [CommMonoidWithZero R]

/-- If `g` generates `Mˣ`, evaluation at `g` identifies the characters with the `#Mˣ`-th roots of
unity of `R`. This is Mathlib's `IsCyclic.monoidHomMulEquivRootsOfUnityOfGenerator`, transported
along `MulChar.mulEquivToUnitHom` and `rootsOfUnityUnitsMulEquiv`. -/
noncomputable def mulEquivRootsOfUnityOfGenerator {g : Mˣ} (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    MulChar M R ≃* rootsOfUnity (Nat.card Mˣ) R :=
  mulEquivToUnitHom.trans ((IsCyclic.monoidHomMulEquivRootsOfUnityOfGenerator hg Rˣ).trans
    (rootsOfUnityUnitsMulEquiv R _))

/-- The root of unity attached to a character is its value at the generator. -/
@[simp]
theorem mulEquivRootsOfUnityOfGenerator_apply {g : Mˣ} (hg : ∀ x, x ∈ Subgroup.zpowers g)
    (χ : MulChar M R) : ((mulEquivRootsOfUnityOfGenerator hg χ : Rˣ) : R) = χ g := by
  simp [mulEquivRootsOfUnityOfGenerator, IsCyclic.monoidHomMulEquivRootsOfUnityOfGenerator,
    rootsOfUnityUnitsMulEquiv]

/-- The character attached to a root of unity `ζ` takes the value `ζ` at the generator. -/
@[simp]
theorem mulEquivRootsOfUnityOfGenerator_symm_apply {g : Mˣ} (hg : ∀ x, x ∈ Subgroup.zpowers g)
    (ζ : rootsOfUnity (Nat.card Mˣ) R) :
    (mulEquivRootsOfUnityOfGenerator hg).symm ζ g = ((ζ : Rˣ) : R) := by
  rw [← mulEquivRootsOfUnityOfGenerator_apply hg, MulEquiv.apply_symm_apply]

/-- If `g` generates `Mˣ`, then the value of a character at `g` has the order of the
character. -/
theorem orderOf_apply_eq_orderOf (χ : MulChar M R) {g : Mˣ}
    (hg : ∀ x, x ∈ Subgroup.zpowers g) : orderOf (χ g) = orderOf χ := by
  rw [← (mulEquivRootsOfUnityOfGenerator (R := R) hg).orderOf_eq χ, ← Subgroup.orderOf_coe,
    ← orderOf_units, mulEquivRootsOfUnityOfGenerator_apply]

end CommMonoidWithZero

section Domain

variable {M : Type*} [CommMonoid M] {R : Type*} [CommRing R] [IsDomain R]

/-- With values in a domain, the characters of a monoid with a finite cyclic unit group form a
cyclic group: they are the `#Mˣ`-th roots of unity of `R`, which form a cyclic group. -/
instance isCyclic [Finite Mˣ] [IsCyclic Mˣ] : IsCyclic (MulChar M R) := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Mˣ)
  exact isCyclic_of_injective (mulEquivRootsOfUnityOfGenerator (R := R) hg).toMonoidHom
    (mulEquivRootsOfUnityOfGenerator hg).injective

/-- For a monoid with finitely many units and characters valued in a domain, a character `ω`
whose order is `#Mˣ` generates the character group: every character is `ω ^ m` for exactly one
`m < #Mˣ`. Such an `ω` exists only if `Mˣ` is cyclic, so this is not a hypothesis. -/
theorem existsUnique_lt_and_pow_eq [Finite Mˣ] (ω : MulChar M R) (hω : orderOf ω = Nat.card Mˣ)
    (χ : MulChar M R) : ∃! m : ℕ, m < Nat.card Mˣ ∧ ω ^ m = χ := by
  -- The exponent of `Mˣ` kills every unit, so it kills `ω`; hence `Mˣ` is cyclic.
  have hexp : orderOf ω ∣ Monoid.exponent Mˣ := orderOf_dvd_of_pow_eq_one <| eq_one_iff.2 fun u ↦ by
    rw [pow_apply_coe, ← map_pow, ← Units.val_pow_eq_pow_val, Monoid.pow_exponent_eq_one,
      Units.val_one, map_one]
  obtain ⟨g, hg⟩ := (IsCyclic.of_exponent_eq_card
    (Nat.dvd_antisymm Group.exponent_dvd_nat_card (hω ▸ hexp))).exists_generator
  -- The characters are the `#Mˣ`-th roots of unity, and there are at most `#Mˣ` of these.
  let e := mulEquivRootsOfUnityOfGenerator (R := R) hg
  have : Finite (MulChar M R) := Finite.of_equiv _ e.symm.toEquiv
  have : NeZero (Nat.card Mˣ) := ⟨Nat.card_pos.ne'⟩
  have hχ : χ ∈ Subgroup.zpowers ω := by
    rw [Subgroup.eq_top_of_le_card (Subgroup.zpowers ω) (by
      rw [Nat.card_zpowers, hω, Nat.card_congr e.toEquiv]
      exact card_rootsOfUnity R _)]
    exact Subgroup.mem_top χ
  -- The powers `ω ^ m` with `m < orderOf ω` list the elements of `zpowers ω`, without repetition.
  have hfin : IsOfFinOrder ω := orderOf_pos_iff.mp (hω ▸ Nat.card_pos)
  obtain ⟨i, hi, huniq⟩ := (finEquivZPowers hfin).bijective.existsUnique ⟨χ, hχ⟩
  have hi' : ω ^ (i : ℕ) = χ := by
    simpa only [finEquivZPowers_apply] using congrArg Subtype.val hi
  refine ⟨i, ⟨hω ▸ i.isLt, hi'⟩, fun j hj ↦ ?_⟩
  exact congrArg Fin.val (huniq ⟨j, hω ▸ hj.1⟩ (Subtype.ext (by
    simpa only [finEquivZPowers_apply] using hj.2)))

/-- With values in a domain, a character `ω` of order `#Mˣ` is injective on units. The image of
`ω` on `Mˣ` is cyclic, so its order is its exponent, which `orderOf ω` divides; hence the image has
`#Mˣ` elements. -/
theorem injective_toUnitHom_of_orderOf_eq_card [Finite Mˣ] {ω : MulChar M R}
    (hω : orderOf ω = Nat.card Mˣ) : Function.Injective ω.toUnitHom := by
  have : Finite ω.toUnitHom.range := .of_surjective _ ω.toUnitHom.rangeRestrict_surjective
  have hdvd : orderOf ω ∣ Nat.card ω.toUnitHom.range := by
    rw [← IsCyclic.exponent_eq_card]
    refine orderOf_dvd_of_pow_eq_one (MulChar.ext fun v ↦ ?_)
    have h := congrArg (fun w : ω.toUnitHom.range ↦ ((w : Rˣ) : R))
      (Monoid.pow_exponent_eq_one (⟨ω.toUnitHom v, v, rfl⟩ : ω.toUnitHom.range))
    simp only [SubgroupClass.coe_pow, Units.val_pow_eq_pow_val, coe_toUnitHom,
      OneMemClass.coe_one, Units.val_one] at h
    rw [pow_apply_coe, h, one_apply_coe]
  exact MonoidHom.rangeRestrict_injective_iff.mp
    (ω.toUnitHom.rangeRestrict_surjective.bijective_of_nat_card_le <| by
      rw [← hω]
      exact Nat.le_of_dvd Nat.card_pos hdvd).1

/-- **Orthogonality over the powers of a generating character.** If `ω` has order `#Mˣ`, then
`∑_{m < #Mˣ} (ω ^ m) x` is `#Mˣ` when `x = 1` and `0` otherwise. -/
theorem sum_range_pow_apply_eq_ite [Fintype Mˣ] [DecidableEq M] {ω : MulChar M R}
    (hω : orderOf ω = Fintype.card Mˣ) (x : M) :
    ∑ m ∈ Finset.range (Fintype.card Mˣ), (ω ^ m) x =
      if x = 1 then (Fintype.card Mˣ : R) else 0 := by
  split_ifs with hx
  · simp [hx]
  by_cases hu : IsUnit x
  swap
  · simp [map_nonunit _ hu]
  obtain ⟨u, rfl⟩ := hu
  simp_rw [pow_apply_coe]
  have hinj := injective_toUnitHom_of_orderOf_eq_card (hω.trans (Nat.card_eq_fintype_card).symm)
  have hne : ω u ≠ 1 := fun h ↦ hx <| Units.val_eq_one.mpr <| hinj <| Units.ext <| by
    rw [coe_toUnitHom, h, map_one, Units.val_one]
  have hpow : ω u ^ Fintype.card Mˣ = 1 := by
    rw [← pow_apply_coe, ω.pow_card_eq_one, one_apply_coe]
  have hgeom := geom_sum_mul (ω u) (Fintype.card Mˣ)
  rw [hpow, sub_self] at hgeom
  exact (mul_eq_zero.mp hgeom).resolve_right (sub_ne_zero.mpr hne)

end Domain

end MulChar

namespace TauCeti

open MulChar

variable {M : Type*} [CommMonoid M] [Fintype M] [DecidableEq M] {R : Type*} [CommMonoidWithZero R]

/-- The character that sends a generator of `Mˣ` to a root of unity `ζ` has the order of `ζ`. -/
@[simp]
theorem orderOf_ofRootOfUnity {ζ : Rˣ} (hζ : ζ ∈ rootsOfUnity (Fintype.card Mˣ) R) {g : Mˣ}
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    orderOf (ofRootOfUnity hζ hg) = orderOf ζ := by
  rw [← orderOf_apply_eq_orderOf _ hg, ofRootOfUnity_spec, orderOf_units]

/-- The character that sends a generator of `Mˣ` to a primitive `#Mˣ`-th root of unity has order
`#Mˣ`. -/
theorem orderOf_ofRootOfUnity_of_isPrimitiveRoot {ζ : Rˣ}
    (hprim : IsPrimitiveRoot (ζ : R) (Fintype.card Mˣ)) {g : Mˣ}
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    orderOf (ofRootOfUnity ((mem_rootsOfUnity' _ ζ).2 hprim.pow_eq_one) hg) =
      Fintype.card Mˣ := by
  rw [orderOf_ofRootOfUnity, (IsPrimitiveRoot.coe_units_iff.mp hprim).eq_orderOf]

end TauCeti
