/-!
# Galois orbits of multiplicative characters

Let `χ` be a multiplicative character of order `m` with values in a field `K` of characteristic
zero, for instance a Dirichlet character. Its values on units are `m`-th roots of unity, one of
them primitive, so they generate the cyclotomic field `ℚ(μ_m)`. An embedding of this field into
`K` raises every `m`-th root of unity to a fixed power `a` prime to `m`, and every such `a` occurs.
Hence the Galois conjugates `σ ∘ χ` of `χ` are exactly the powers `χ ^ a` with `a` prime to `m`,
and these are exactly the characters that generate the same cyclic subgroup as `χ`.

We take the last description as the definition of `MulChar.galoisOrbit`; it makes sense for every
coefficient ring. The other two descriptions are theorems. The Galois orbit is the equivalence
class used to group Dirichlet characters, and the nebentypus of a newform, into orbits, as in the
labels of the LMFDB. All characters in an orbit have the same order and the same parity, and the
orbit of a character of order `m` has `φ(m)` elements.

## Main definitions

* `MulChar.galoisOrbit χ`: the characters `ψ` with `zpowers ψ = zpowers χ`.

## Main results

* `MulChar.mem_galoisOrbit_iff_exists_pow`: on a monoid with finitely many units, `ψ` lies in
  the Galois orbit of `χ` if and only if `ψ = χ ^ a` for some `a` prime to the order of `χ`.
* `MulChar.mem_galoisOrbit_iff_exists_algHom`: for values in a field of characteristic zero,
  `ψ` lies in the Galois orbit of `χ` if and only if `ψ = σ ∘ χ` for a `ℚ`-algebra embedding
  `σ` of the field generated by the values of `χ`.
* `MulChar.ncard_galoisOrbit`: the Galois orbit of `χ` has `φ(orderOf χ)` elements.
* `MulChar.ringHomComp_mem_galoisOrbit`: composing with an injective ring endomorphism of a
  domain, such as an automorphism of `ℂ`, stays in the Galois orbit.
* `MulChar.apply_neg_one_eq_of_mem_galoisOrbit`: characters in one Galois orbit have the same
  parity.
* `MulChar.exists_isPrimitiveRoot_apply`: a character of order `m` with values in a domain takes
  a primitive `m`-th root of unity as a value.
* `MulChar.adjoin_range_eq_adjoin_simple`: the field generated by the values of `χ` is generated
  by one value that is a primitive root of unity.

## References

* The LMFDB Collaboration, *Dirichlet characters: Galois orbits*,
  <https://www.lmfdb.org/knowledge/show/character.dirichlet.galois_orbit>.
-/

public section

open Subgroup

namespace MulChar

variable {M : Type*} [CommMonoid M]

section CommMonoidWithZero

variable {R : Type*} [CommMonoidWithZero R]

/-- The Galois orbit of a multiplicative character `χ`: the characters generating the same cyclic
subgroup of characters as `χ`. When `χ` has finite order these are the powers `χ ^ a` with `a`
prime to its order (`MulChar.mem_galoisOrbit_iff_exists_pow`). For values in a field of
characteristic zero they are the conjugates `σ ∘ χ` under the embeddings `σ` of the field
generated by the values of `χ` (`MulChar.mem_galoisOrbit_iff_exists_algHom`). -/
def galoisOrbit (χ : MulChar M R) : Set (MulChar M R) :=
  {ψ | zpowers ψ = zpowers χ}

/-- Membership in the Galois orbit, by definition. -/
theorem mem_galoisOrbit_iff {χ ψ : MulChar M R} : ψ ∈ χ.galoisOrbit ↔ zpowers ψ = zpowers χ :=
  Iff.rfl

/-- A character lies in its own Galois orbit. -/
@[simp]
theorem mem_galoisOrbit_self (χ : MulChar M R) : χ ∈ χ.galoisOrbit :=
  mem_galoisOrbit_iff.mpr rfl

/-- Lying in the same Galois orbit is a symmetric relation. -/
theorem mem_galoisOrbit_comm {χ ψ : MulChar M R} : ψ ∈ χ.galoisOrbit ↔ χ ∈ ψ.galoisOrbit :=
  eq_comm

/-- Two Galois orbits are equal exactly when they meet; the Galois orbits partition the
characters. -/
theorem galoisOrbit_eq_galoisOrbit_iff {χ ψ : MulChar M R} :
    ψ.galoisOrbit = χ.galoisOrbit ↔ ψ ∈ χ.galoisOrbit := by
  refine ⟨fun h ↦ h ▸ mem_galoisOrbit_self ψ, fun h ↦ Set.ext fun φ ↦ ?_⟩
  rw [mem_galoisOrbit_iff, mem_galoisOrbit_iff, mem_galoisOrbit_iff.mp h]

/-- Characters in one Galois orbit have the same order. -/
theorem orderOf_eq_of_mem_galoisOrbit {χ ψ : MulChar M R} (h : ψ ∈ χ.galoisOrbit) :
    orderOf ψ = orderOf χ := by
  rw [← Nat.card_zpowers, ← Nat.card_zpowers, mem_galoisOrbit_iff.mp h]

/-- A power `χ ^ a` lies in the Galois orbit of `χ` exactly when `a` is prime to the order
of `χ`. -/
theorem pow_mem_galoisOrbit_iff (χ : MulChar M R) (a : ℕ) :
    χ ^ a ∈ χ.galoisOrbit ↔ a.Coprime (orderOf χ) := by
  have h := zpowers_eq_zpowers_iff' χ a 1
  rw [zpow_natCast, zpow_one] at h
  rw [mem_galoisOrbit_iff, h, Int.gcd_natCast_natCast, Int.gcd_one_left, Nat.Coprime]

variable [Finite Mˣ]

/-- On a monoid with finitely many units, the Galois orbit of `χ` consists of the powers
`χ ^ a` with `a` prime to the order of `χ`. -/
theorem mem_galoisOrbit_iff_exists_pow {χ ψ : MulChar M R} :
    ψ ∈ χ.galoisOrbit ↔ ∃ a : ℕ, a.Coprime (orderOf χ) ∧ χ ^ a = ψ := by
  refine ⟨fun h ↦ ?_, fun ⟨a, ha, hψ⟩ ↦ hψ ▸ (pow_mem_galoisOrbit_iff χ a).mpr ha⟩
  have hfin : IsOfFinOrder χ := orderOf_pos_iff.mp χ.orderOf_pos
  obtain ⟨a, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp <|
    hfin.mem_powers_iff_mem_zpowers.mpr (mem_galoisOrbit_iff.mp h ▸ mem_zpowers ψ)
  exact ⟨a, (pow_mem_galoisOrbit_iff χ a).mp h, rfl⟩

/-- The Galois orbit of `χ` is the image of the residues prime to the order of `χ` under
`a ↦ χ ^ a`. -/
private theorem galoisOrbit_eq_image (χ : MulChar M R) :
    χ.galoisOrbit = (χ ^ ·) '' {a | a < orderOf χ ∧ (orderOf χ).Coprime a} := by
  ext ψ
  rw [mem_galoisOrbit_iff_exists_pow]
  constructor
  · rintro ⟨a, ha, rfl⟩
    refine ⟨a % orderOf χ, ⟨Nat.mod_lt _ χ.orderOf_pos, ?_⟩, pow_mod_orderOf χ a⟩
    rw [Nat.Coprime, Nat.gcd_comm, ← Nat.gcd_rec]
    exact ha.symm
  · rintro ⟨a, ⟨-, ha⟩, rfl⟩
    exact ⟨a, ha.symm, rfl⟩

/-- The Galois orbit of a character of order `m` has `φ(m)` elements. -/
theorem ncard_galoisOrbit (χ : MulChar M R) : χ.galoisOrbit.ncard = (orderOf χ).totient := by
  classical
  have h : {a | a < orderOf χ ∧ (orderOf χ).Coprime a} =
      ↑({a ∈ Finset.range (orderOf χ) | (orderOf χ).Coprime a}) := by
    ext a
    simp
  rw [galoisOrbit_eq_image, (pow_injOn_Iio_orderOf.mono fun a ha ↦ ha.1).ncard_image,
    h, Set.ncard_coe_finset, Nat.totient]

/-- On a monoid with finitely many units, every Galois orbit is finite. -/
theorem finite_galoisOrbit (χ : MulChar M R) : χ.galoisOrbit.Finite :=
  Set.finite_of_ncard_pos <| χ.ncard_galoisOrbit ▸ Nat.totient_pos.mpr χ.orderOf_pos

end CommMonoidWithZero

section Parity

variable {M R : Type*} [CommRing M] [Finite Mˣ] [CommMonoidWithZero R]

/-- Characters in one Galois orbit have the same parity: they agree at `-1`. -/
theorem apply_neg_one_eq_of_mem_galoisOrbit {χ ψ : MulChar M R} (h : ψ ∈ χ.galoisOrbit) :
    ψ (-1) = χ (-1) := by
  obtain ⟨a, ha, rfl⟩ := mem_galoisOrbit_iff_exists_pow.mp h
  rcases Nat.even_or_odd (orderOf χ) with hm | hm
  · -- The exponent `a` is prime to the even order of `χ`, hence odd, and `χ (-1) ^ 2 = 1`.
    obtain ⟨b, rfl⟩ : Odd a := Nat.odd_iff.mpr <| Nat.two_dvd_ne_zero.mp fun h2 ↦
      Nat.not_coprime_of_dvd_of_dvd one_lt_two h2 (even_iff_two_dvd.mp hm) ha
    rw [pow_apply' χ (by omega), pow_succ, pow_mul, ← map_pow, neg_one_sq, map_one, one_pow,
      one_mul]
  · -- A character of odd order is trivial at `-1`.
    rw [val_neg_one_eq_one_of_odd_order hm (pow_orderOf_eq_one χ),
      val_neg_one_eq_one_of_odd_order hm (by rw [← pow_mul, mul_comm, pow_mul,
        pow_orderOf_eq_one, one_pow])]

end Parity

section IsDomain

variable {R : Type*} [CommRing R] [IsDomain R] [Finite Mˣ]

/-- A character of order `m` with values in a domain takes a primitive `m`-th root of unity
as a value. -/
theorem exists_isPrimitiveRoot_apply (χ : MulChar M R) :
    ∃ u : Mˣ, IsPrimitiveRoot (χ u) (orderOf χ) := by
  -- The values on units form a finite, hence cyclic, subgroup of `Rˣ`; take a generator.
  have : Finite χ.toUnitHom.range := .of_surjective _ χ.toUnitHom.rangeRestrict_surjective
  obtain ⟨⟨_, u, rfl⟩, hg⟩ := IsCyclic.exists_generator (α := χ.toUnitHom.range)
  refine ⟨u, ?_⟩
  rw [← coe_toUnitHom, IsPrimitiveRoot.coe_units_iff, IsPrimitiveRoot.iff_orderOf]
  refine Nat.dvd_antisymm (orderOf_dvd_of_pow_eq_one ?_) (orderOf_dvd_of_pow_eq_one ?_)
  · ext
    rw [Units.val_pow_eq_pow_val, coe_toUnitHom, ← pow_apply_coe, pow_orderOf_eq_one,
      one_apply_coe, Units.val_one]
  · refine MulChar.ext fun v ↦ ?_
    obtain ⟨k, hk⟩ := mem_zpowers_iff.mp (hg ⟨χ.toUnitHom v, v, rfl⟩)
    have hv : χ.toUnitHom u ^ k = χ.toUnitHom v := congrArg Subtype.val hk
    rw [pow_apply_coe, one_apply_coe, ← coe_toUnitHom, ← hv, ← Units.val_pow_eq_pow_val,
      ← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, pow_orderOf_eq_one,
      one_zpow, Units.val_one]

/-- If `χ u` is a primitive root of unity of order `orderOf χ`, every value of `χ` on a unit is
a power of `χ u`. -/
private theorem exists_pow_eq_apply {χ : MulChar M R} {u : Mˣ}
    (hu : IsPrimitiveRoot (χ u) (orderOf χ)) (v : Mˣ) : ∃ j : ℕ, χ u ^ j = χ v := by
  have : NeZero (orderOf χ) := ⟨χ.orderOf_pos.ne'⟩
  obtain ⟨j, -, hj⟩ := hu.eq_pow_of_pow_eq_one (ξ := χ v) <| by
    rw [← pow_apply_coe, pow_orderOf_eq_one, one_apply_coe]
  exact ⟨j, hj⟩

/-- Composing with an injective ring endomorphism of a domain, such as an automorphism of `ℂ`,
keeps a character in its Galois orbit. -/
theorem ringHomComp_mem_galoisOrbit (χ : MulChar M R) {σ : R →+* R}
    (hσ : Function.Injective σ) : χ.ringHomComp σ ∈ χ.galoisOrbit := by
  obtain ⟨u, hu⟩ := χ.exists_isPrimitiveRoot_apply
  have : NeZero (orderOf χ) := ⟨χ.orderOf_pos.ne'⟩
  obtain ⟨a, -, ha⟩ := hu.eq_pow_of_pow_eq_one (ξ := σ (χ u)) <| by
    rw [← map_pow, hu.pow_eq_one, map_one]
  refine mem_galoisOrbit_iff_exists_pow.mpr
    ⟨a, (hu.pow_iff_coprime χ.orderOf_pos a).mp (ha ▸ hu.map_of_injective hσ), ext fun v ↦ ?_⟩
  obtain ⟨j, hj⟩ := exists_pow_eq_apply hu v
  rw [pow_apply_coe, ringHomComp_apply, ← hj, map_pow, ← ha, ← pow_mul, ← pow_mul, mul_comm]

end IsDomain

section Field

open IntermediateField

variable {K : Type*} [Field K] [CharZero K] [Finite Mˣ]

/-- The field generated by the values of a character of order `m` is generated by any single
value that is a primitive `m`-th root of unity; such a value exists by
`MulChar.exists_isPrimitiveRoot_apply`. -/
theorem adjoin_range_eq_adjoin_simple {χ : MulChar M K} {u : Mˣ}
    (hu : IsPrimitiveRoot (χ u) (orderOf χ)) : adjoin ℚ (Set.range χ) = ℚ⟮χ u⟯ := by
  refine le_antisymm (adjoin_le_iff.mpr ?_) (adjoin_simple_le_iff.mpr (subset_adjoin _ _ ⟨u, rfl⟩))
  rintro _ ⟨x, rfl⟩
  by_cases hx : IsUnit x
  · obtain ⟨j, hj⟩ := exists_pow_eq_apply hu hx.unit
    rw [← hx.unit_spec, ← hj]
    exact pow_mem (mem_adjoin_simple_self ℚ _) j
  · rw [map_nonunit χ hx]
    exact zero_mem _

/-- For values in a field of characteristic zero, the Galois orbit of `χ` consists of the
conjugates `σ ∘ χ`, where `σ` runs over the `ℚ`-algebra embeddings of the field generated by the
values of `χ`. -/
theorem mem_galoisOrbit_iff_exists_algHom {χ ψ : MulChar M K} :
    ψ ∈ χ.galoisOrbit ↔ ∃ σ : adjoin ℚ (Set.range χ) →ₐ[ℚ] K,
      ∀ x, ψ x = σ ⟨χ x, subset_adjoin ℚ _ (Set.mem_range_self x)⟩ := by
  have : NeZero (orderOf χ) := ⟨χ.orderOf_pos.ne'⟩
  obtain ⟨u, hu⟩ := χ.exists_isPrimitiveRoot_apply
  have hF := adjoin_range_eq_adjoin_simple hu
  -- The value `χ u`, a primitive root of unity, as an element of the field of values.
  set μ : adjoin ℚ (Set.range χ) := ⟨χ u, subset_adjoin ℚ _ (Set.mem_range_self _)⟩
  constructor
  · rintro h
    obtain ⟨a, ha, rfl⟩ := mem_galoisOrbit_iff_exists_pow.mp h
    -- Send the generator `χ u` to the root `χ u ^ a` of its minimal polynomial `Φ_m`.
    have hint : IsIntegral ℚ (χ u) := (hu.isIntegral χ.orderOf_pos).tower_top
    have hroot : χ u ^ a ∈ (minpoly ℚ (χ u)).aroots K := by
      rw [← Polynomial.cyclotomic_eq_minpoly_rat hu χ.orderOf_pos, Polynomial.mem_aroots,
        Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map, Polynomial.map_cyclotomic]
      exact ⟨Polynomial.cyclotomic_ne_zero _ _,
        (Polynomial.isRoot_cyclotomic_iff.mpr (hu.pow_of_coprime a ha))⟩
    let τ := (algHomAdjoinIntegralEquiv ℚ hint).symm ⟨_, hroot⟩
    have hτ : τ (AdjoinSimple.gen ℚ (χ u)) = χ u ^ a :=
      algHomAdjoinIntegralEquiv_symm_apply_gen ℚ hint _
    refine ⟨τ.comp (equivOfEq hF).toAlgHom, fun x ↦ ?_⟩
    by_cases hx : IsUnit x
    · obtain ⟨v, rfl⟩ := hx
      obtain ⟨j, hj⟩ := exists_pow_eq_apply hu v
      have hgen : equivOfEq hF ⟨χ v, subset_adjoin ℚ _ (Set.mem_range_self _)⟩ =
          AdjoinSimple.gen ℚ (χ u) ^ j :=
        Subtype.ext (by simp [hj])
      rw [pow_apply_coe, AlgHom.comp_apply, AlgEquiv.toAlgHom_apply, hgen, map_pow, hτ, ← hj,
        ← pow_mul, ← pow_mul, mul_comm]
    · have hzero : (⟨χ x, subset_adjoin ℚ _ (Set.mem_range_self x)⟩ : adjoin ℚ (Set.range χ)) = 0 :=
        Subtype.ext (map_nonunit χ hx)
      rw [map_nonunit _ hx, hzero, map_zero]
  · rintro ⟨σ, hσ⟩
    have hμ' : IsPrimitiveRoot μ (orderOf χ) :=
      IsPrimitiveRoot.of_map_of_injective (f := (adjoin ℚ (Set.range χ)).val) hu
        Subtype.val_injective
    obtain ⟨a, -, ha⟩ := hu.eq_pow_of_pow_eq_one (ξ := σ μ) <| by
      rw [← map_pow, hμ'.pow_eq_one, map_one]
    refine mem_galoisOrbit_iff_exists_pow.mpr
      ⟨a, (hu.pow_iff_coprime χ.orderOf_pos a).mp (ha ▸ hμ'.map_of_injective σ.injective),
        ext fun v ↦ ?_⟩
    obtain ⟨j, hj⟩ := exists_pow_eq_apply hu v
    have hjμ : (⟨χ v, subset_adjoin ℚ _ (Set.mem_range_self _)⟩ : adjoin ℚ (Set.range χ)) =
        μ ^ j :=
      Subtype.ext (by simp [μ, hj])
    rw [hσ, pow_apply_coe, hjμ, map_pow, ← ha, ← hj, ← pow_mul, ← pow_mul, mul_comm]

end Field

end MulChar
