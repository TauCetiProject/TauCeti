module

public import TauCeti.NumberTheory.Padics.MultiplicativeCompletion.Decomposition
public import TauCeti.NumberTheory.Padics.MultiplicativeCompletion.LayerTateModule.Basic
import Mathlib.RingTheory.Noetherian.Basic
import TauCeti.NumberTheory.LocalField.FiniteExtension.Basic
import TauCeti.NumberTheory.LocalField.RootsOfUnity.Basic
import TauCeti.NumberTheory.Padics.MultiplicativeCompletion.LayerTateModule.Cohomology

/-!
# The integral decomposition of a Tate module of a local field layer

For a finite Galois layer, a Tate module is an extension of the augmentation ideal by the
completed multiplicative group, with projective dimension at most one. This file applies the
integral decomposition theorem to that bundled data, giving the module decomposition that yields
the generator bound in the proof of the full local absolute Galois group rank.

Since a Tate module of every finite Galois layer of `p`-adic fields exists
(`TauCeti.nonempty_layerTateModule`), the relation-module surjection derived from the
decomposition holds on every layer with a generating tame frame, with no module `Y` as input.

## Main results

* `TauCeti.LayerTateModule.nonempty_linearEquiv_tameFrameModule_prod`: a Tate module of the layer
  is isomorphic to `M₀ ⊕ ℤ_p[G]^N`, for `M₀` the tame-frame module of a generating pair with sharp
  exponents and `N = [K : ℚ_p]`.
* `TauCeti.exists_relationModule_surjective_of_tameFrame`: on a layer whose Galois group `G` is
  generated by a pair `σ, τ` with `τ` of order prime to `p`, the relation module of every
  generating family of `G` of size `N + 2` maps `ℤ_p[G]`-linearly onto `A(L)` with kernel
  isomorphic to `ℤ_p[G]`.

## References

* J. Neukirch, A. Schmidt and K. Wingberg, *Cohomology of Number Fields*, 2nd ed., proof of
  (7.4.1).
-/

public section

namespace TauCeti

open _root_.MonoidAlgebra

universe u

variable {p : ℕ} [Fact p.Prime] {L K : Type u} [Field L] [Field K] [Algebra K L]

local notation "Λ" => MonoidAlgebra ℤ_[p] (L ≃ₐ[K] L)

namespace LayerTateModule

/-- **The integral decomposition of a Tate module.** For a finite Galois extension of `p`-adic
fields `L/K`, a Tate module of the layer is isomorphic to the tame-frame module of any generating
pair with sharp exponents, together with `N = [K : ℚ_p]` copies of the group algebra. -/
theorem nonempty_linearEquiv_tameFrameModule_prod
    [Algebra ℚ_[p] L] [Module.Finite ℚ_[p] L] [Algebra ℚ_[p] K]
    [IsScalarTower ℚ_[p] K L] [IsGalois K L]
    (Y : LayerTateModule p L K) (h : Finite (pPowerRootsOfUnity p L))
    (σ τ : L ≃ₐ[K] L) (hgen : Subgroup.closure {σ, τ} = ⊤) (a b : ℕ)
    (ha : ∀ ζ ∈ pPowerRootsOfUnity p L, Units.map (σ : L →* L) ζ = ζ ^ a)
    (hb : ∀ ζ ∈ pPowerRootsOfUnity p L, Units.map (τ : L →* L) ζ = ζ ^ b)
    (hcard : Nat.card (Λ ⧸ Ideal.span {single σ (1 : ℤ_[p]) - a,
      single τ (1 : ℤ_[p]) - b}) = localRootOfUnityOrder p L h) :
    Nonempty (Y.carrier ≃ₗ[Λ]
      (TameFrameModule ℤ_[p] (L ≃ₐ[K] L) σ τ (a : ℤ_[p]) (b : ℤ_[p]) ×
        (Fin (Module.finrank ℚ_[p] K) → Λ))) := by
  have := Module.Finite.right ℚ_[p] K L
  obtain ⟨n, f, hf, hker⟩ := Y.projdim
  let P₀ := Fin n → Λ
  let P₁ := LinearMap.ker f
  let d : P₁ →ₗ[Λ] P₀ := (LinearMap.ker f).subtype
  let ρ : P₀ →ₗ[Λ] Y.carrier := f
  have hdρ : Function.Exact d ρ := LinearMap.exact_subtype_ker_map f
  have hd : Function.Injective d := (LinearMap.ker f).subtype_injective
  have hρ : Function.Surjective ρ := hf
  let : IsNoetherianRing Λ := IsNoetherianRing.of_finite ℤ_[p] Λ
  let : Module.Projective Λ P₁ := hker
  exact TauCeti.nonempty_linearEquiv_tameFrameModule_prod
    hdρ hd hρ Y.exact_ι_π Y.ι_injective Y.π_surjective h σ τ hgen a b ha hb hcard

end LayerTateModule

/-- **The relation-module surjection on a tame layer** (the first half of the proof of
NSW (7.4.1)). Let `L/K` be a finite Galois extension of `p`-adic fields with group `G`, and
`N = [K : ℚ_p]`. Let `σ, τ` generate `G`, with the order of `τ` prime to `p`. Then for every
generating family `g` of `G` of size `N + 2`, the relation module `R^ab_{N+2}(p)` of `g` maps
`ℤ_p[G]`-linearly onto the `p`-adic completion `A(L)` of `Lˣ`, with kernel isomorphic to
`ℤ_p[G]`. -/
theorem exists_relationModule_surjective_of_tameFrame
    [Algebra ℚ_[p] L] [Module.Finite ℚ_[p] L] [Algebra ℚ_[p] K]
    [IsScalarTower ℚ_[p] K L] [IsGalois K L]
    (σ τ : L ≃ₐ[K] L) (hgen : Subgroup.closure {σ, τ} = ⊤) (hτ : ¬ p ∣ orderOf τ)
    {g : Fin (Module.finrank ℚ_[p] K + 2) → L ≃ₐ[K] L}
    (hg : Subgroup.closure (Set.range g) = ⊤) :
    ∃ β : MonoidAlgebra.relationModule ℤ_[p] (L ≃ₐ[K] L) g →ₗ[Λ]
        Additive (padicCompletionUnits p L),
      Function.Surjective β ∧ Nonempty (LinearMap.ker β ≃ₗ[Λ] Λ) := by
  have := Module.Finite.right ℚ_[p] K L
  -- The `p`-power roots of unity of the local field `L` form a finite group.
  let _ := finiteExtensionValuativeRel ℚ_[p] L
  let _ := finiteExtensionNormedFieldTopology ℚ_[p] L
  have := finiteExtension_isNonarchimedeanLocalField ℚ_[p] L
  have hpL : (p : L) ≠ 0 := by
    rw [← map_natCast (algebraMap ℚ_[p] L)]
    exact (map_ne_zero _).mpr (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero)
  -- A Tate module of the layer is an extension of `I_G` by `A(L)` with a projective resolution
  -- `0 → ker f → ℤ_p[G]^n → Y → 0`.
  obtain ⟨Y⟩ := nonempty_layerTateModule p K L
  obtain ⟨n, f, hf, hker⟩ := Y.projdim
  have : IsNoetherianRing Λ := IsNoetherianRing.of_finite ℤ_[p] Λ
  have : Module.Finite Λ (LinearMap.ker f) := .of_fg (IsNoetherian.noetherian _)
  have : Module.Projective Λ (LinearMap.ker f) := hker
  exact exists_relationModule_surjective_of_tameFrame_of_exact
    (LinearMap.exact_subtype_ker_map f) (LinearMap.ker f).subtype_injective hf Y.exact_ι_π
    Y.ι_injective Y.π_surjective (finite_pPowerRootsOfUnity hpL) σ τ hgen hτ hg

end TauCeti
