/-!
# Algebraic functions on an open subgroup of `SL₂(ℤ_p)`

Let `G` be a subgroup of `SL_n(ℤ_p)` and `K` a topological commutative ring over `ℚ_p`, typically
a finite extension of `ℚ_p`. A polynomial in the `n²` matrix entries with coefficients in `K`
restricts to a continuous function on `G` (`TauCeti.polynomialRestriction`); the image is the
algebra `C^alg(G, K)` of **algebraic functions** (`TauCeti.algebraicFunctions`), filtered by the
images `C^alg_{≤m}` of the polynomials of total degree at most `m`
(`TauCeti.algebraicFunctionsDegreeLE`). The filtration is exhaustive and multiplicative, and each
`C^alg_{≤m}` is stable under the two-sided translation action `f ↦ (g ↦ f (g₁ * g * g₂))` of
`G × G`.

For `n = 2`, `K` an integral domain and `G` open, restriction identifies `C^alg(G, K)` with the
coordinate ring `K[SL₂] = K[x, y, z, w] / (xw - yz - 1)`
(`TauCeti.ker_polynomialRestriction_fin_two`, `TauCeti.algebraicFunctionsEquiv`): an open subgroup
is Zariski dense in `SL₂`. Since a nonzero multiple of `xw - yz - 1` has degree two more than its
cofactor, for `K` a field the filtration is then computed degree by degree:
`dim C^alg_{≤m} = C(m + 4, 4) - C(m + 2, 4)` (`TauCeti.finrank_algebraicFunctionsDegreeLE`),
and the graded pieces have dimension
`dim C^alg_{≤m+1} / C^alg_{≤m} = C(m + 4, 3) - C(m + 2, 3) = (m + 2)²`
(`TauCeti.finrank_algebraicFunctionsDegreeLE_quotient`). This is the dimension of `W ⊗ W^*` for
`W = Sym^{m+1}(K²)`, the count behind the algebraic Peter–Weyl theorem for open subgroups of
`SL₂(ℤ_p)`, in which the graded pieces are identified with these representations.

## Main definitions

* `TauCeti.entryFunction`: the matrix entry `g ↦ gᵢⱼ` as a continuous function on `G`.
* `TauCeti.polynomialRestriction`: restriction `K[Xᵢⱼ] → C(G, K)` of polynomials in the entries.
* `TauCeti.algebraicFunctions`: the algebraic functions `C^alg(G, K) ≤ C(G, K)`.
* `TauCeti.algebraicFunctionsDegreeLE`: the degree filtration `C^alg_{≤m}`.
* `TauCeti.algebraicFunctionsEquiv`: for open `G ≤ SL₂(ℤ_p)`, `K[SL₂] ≃ₐ[K] C^alg(G, K)`.

## Main results

* `TauCeti.comp_mul_mul_mem_algebraicFunctionsDegreeLE`: `C^alg_{≤m}` is stable under
  `f ↦ (g ↦ f (g₁ * g * g₂))` for `g₁, g₂ ∈ G`.
* `TauCeti.ker_polynomialRestriction_fin_two`: for open `G ≤ SL₂(ℤ_p)`, the kernel of restriction
  is the ideal generated by `det - 1`.
* `TauCeti.finrank_algebraicFunctionsDegreeLE`: `dim C^alg_{≤m} = C(m + 4, 4) - C(m + 2, 4)`.
* `TauCeti.finrank_algebraicFunctionsDegreeLE_quotient`: `dim C^alg_{≤m+1} / C^alg_{≤m}` is
  `(m + 2)²`.

## Implementation notes

The kernel of restriction is computed by eliminating `w` with `xw = 1 + yz`: for every polynomial
`f`, some `x ^ N * f` is congruent modulo `xw - yz - 1` to a polynomial `r` in `x, y, z` alone. On
`G` the entries `(x, y, z)` take every value in a box `(1 + p^m ℤ_p) × p^m ℤ_p × p^m ℤ_p`, since `G`
contains a congruence neighbourhood (`TauCeti.exists_setOf_pow_dvd_sub_one_subset`), so `r`
vanishes there and is zero; and `x` is a nonzerodivisor modulo `xw - yz - 1`, being prime and not
dividing `xw - yz - 1`.

## References

* W. Fu, *Sharp bounds for multiplicities of Bianchi modular forms*, Ann. of Math. (2) 200
  (2024), §6, the definition of `C^alg(G, K)` and its degree filtration, pp. 21–22.
-/

public section

open MvPolynomial Matrix

namespace TauCeti

variable {p : ℕ} [Fact p.Prime]

/-! ### Restriction of polynomials in the matrix entries -/

section Restriction

variable (K : Type*) [CommRing K] [Algebra ℚ_[p] K] [TopologicalSpace K] [IsTopologicalRing K]
  [ContinuousSMul ℚ_[p] K] {n : Type*} [Fintype n] [DecidableEq n]
  (G : Subgroup (SpecialLinearGroup n ℤ_[p]))

omit [IsTopologicalRing K] in
/-- The matrix entry `g ↦ gᵢⱼ` on a subgroup `G` of `SL_n(ℤ_p)`, as a continuous function with
values in a topological ring `K` over `ℚ_p`. -/
noncomputable def entryFunction (i j : n) : C(G, K) where
  toFun g := algebraMap ℚ_[p] K ((g : SpecialLinearGroup n ℤ_[p]) i j : ℚ_[p])
  continuous_toFun := by
    have h : Continuous fun g : G ↦ ((g : SpecialLinearGroup n ℤ_[p]) : Matrix n n ℤ_[p]) :=
      continuous_subtypeVal.comp continuous_subtypeVal
    exact (continuous_algebraMap ℚ_[p] K).comp <| continuous_subtypeVal.comp <|
      (continuous_apply j).comp <| (continuous_apply i).comp h

omit [IsTopologicalRing K] in
/-- The value of `entryFunction K G i j` at `g` is the entry `gᵢⱼ`, mapped to `K`. -/
@[simp]
theorem entryFunction_apply (i j : n) (g : G) :
    entryFunction K G i j g = algebraMap ℚ_[p] K ((g : SpecialLinearGroup n ℤ_[p]) i j : ℚ_[p]) :=
  (rfl)

/-- Restriction of polynomials in the matrix entries to continuous functions on a subgroup `G` of
`SL_n(ℤ_p)`: the variable `Xᵢⱼ` goes to the entry `g ↦ gᵢⱼ`. -/
noncomputable def polynomialRestriction : MvPolynomial (n × n) K →ₐ[K] C(G, K) :=
  aeval fun ij ↦ entryFunction K G ij.1 ij.2

/-- The variable `Xᵢⱼ` restricts to the matrix entry `g ↦ gᵢⱼ`. -/
@[simp]
theorem polynomialRestriction_X (i j : n) :
    polynomialRestriction K G (X (i, j)) = entryFunction K G i j :=
  aeval_X _ _

/-- The restriction of `f` takes at `g` the value of `f` at the entries of `g`. -/
@[simp]
theorem polynomialRestriction_apply (f : MvPolynomial (n × n) K) (g : G) :
    polynomialRestriction K G f g =
      eval (fun ij ↦ algebraMap ℚ_[p] K ((g : SpecialLinearGroup n ℤ_[p]) ij.1 ij.2 : ℚ_[p]))
        f := by
  have h := congr($(comp_aeval (R := K) (fun ij : n × n ↦ entryFunction K G ij.1 ij.2)
    (ContinuousMap.evalAlgHom K K g)) f)
  simpa [polynomialRestriction, coe_aeval_eq_eval] using h

/-- The restriction of `f` takes at `g` the value of `f` at the entries of the image of `g` under
the ring homomorphism `ℤ_p → ℚ_p → K`, applied entrywise. -/
theorem polynomialRestriction_apply_eq_eval_mapMatrix (f : MvPolynomial (n × n) K) (g : G) :
    polynomialRestriction K G f g = eval (fun ij ↦ ((algebraMap ℚ_[p] K).comp
      PadicInt.Coe.ringHom).mapMatrix (g : SpecialLinearGroup n ℤ_[p]) ij.1 ij.2) f :=
  polynomialRestriction_apply K G f g

/-- The generic determinant minus one restricts to zero on every subgroup of `SL_n(ℤ_p)`. -/
@[simp]
theorem polynomialRestriction_det_sub_one :
    polynomialRestriction K G ((mvPolynomialX n n K).det - 1) = 0 := by
  ext g
  rw [polynomialRestriction_apply_eq_eval_mapMatrix, map_sub, map_one, RingHom.map_det,
    mvPolynomialX_mapMatrix_eval, ← RingHom.map_det, SpecialLinearGroup.det_coe, map_one,
    sub_self, ContinuousMap.zero_apply]

/-- The ideal generated by `det - 1` lies in the kernel of restriction. -/
theorem span_det_sub_one_le_ker_polynomialRestriction :
    Ideal.span {(mvPolynomialX n n K).det - 1} ≤ RingHom.ker (polynomialRestriction K G) := by
  rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
  exact polynomialRestriction_det_sub_one K G

/-! ### Algebraic functions and the degree filtration -/

/-- The algebra `C^alg(G, K)` of algebraic functions on a subgroup `G` of `SL_n(ℤ_p)`: the
restrictions to `G` of polynomials in the matrix entries. -/
noncomputable def algebraicFunctions : Subalgebra K C(G, K) :=
  (polynomialRestriction K G).range

/-- A continuous function is algebraic exactly when it is the restriction of a polynomial. -/
theorem mem_algebraicFunctions_iff {f : C(G, K)} :
    f ∈ algebraicFunctions K G ↔ ∃ P, polynomialRestriction K G P = f :=
  AlgHom.mem_range _

/-- The degree filtration `C^alg_{≤m}` of the algebraic functions: the restrictions of the
polynomials of total degree at most `m`. -/
noncomputable def algebraicFunctionsDegreeLE (m : ℕ) : Submodule K C(G, K) :=
  (restrictTotalDegree (n × n) K m).map (polynomialRestriction K G).toLinearMap

instance (m : ℕ) : Module.Finite K (algebraicFunctionsDegreeLE K G m) := by
  unfold algebraicFunctionsDegreeLE
  infer_instance

/-- A continuous function lies in `C^alg_{≤m}` exactly when it is the restriction of a
polynomial of total degree at most `m`. -/
theorem mem_algebraicFunctionsDegreeLE_iff {m : ℕ} {f : C(G, K)} :
    f ∈ algebraicFunctionsDegreeLE K G m ↔
      ∃ P : MvPolynomial (n × n) K, P.totalDegree ≤ m ∧ polynomialRestriction K G P = f := by
  simp [algebraicFunctionsDegreeLE, mem_restrictTotalDegree]

/-- The degree filtration is increasing. -/
theorem algebraicFunctionsDegreeLE_mono : Monotone (algebraicFunctionsDegreeLE K G) :=
  fun _ _ hmm' ↦ Submodule.map_mono fun _ hP ↦
    (mem_restrictTotalDegree _ _ _).mpr (((mem_restrictTotalDegree _ _ _).mp hP).trans hmm')

/-- The degree filtration is exhaustive: its union is `C^alg(G, K)`. -/
theorem iSup_algebraicFunctionsDegreeLE :
    ⨆ m, algebraicFunctionsDegreeLE K G m = Subalgebra.toSubmodule (algebraicFunctions K G) := by
  refine le_antisymm (iSup_le fun m f hf ↦ ?_) fun f hf ↦ ?_
  · obtain ⟨P, -, rfl⟩ := (mem_algebraicFunctionsDegreeLE_iff K G).mp hf
    exact ⟨P, rfl⟩
  · obtain ⟨P, rfl⟩ := hf
    exact Submodule.mem_iSup_of_mem P.totalDegree
      ((mem_algebraicFunctionsDegreeLE_iff K G).mpr ⟨P, le_rfl, rfl⟩)

/-- The degree filtration is multiplicative. -/
theorem mul_mem_algebraicFunctionsDegreeLE {a b : ℕ} {f₁ f₂ : C(G, K)}
    (h₁ : f₁ ∈ algebraicFunctionsDegreeLE K G a) (h₂ : f₂ ∈ algebraicFunctionsDegreeLE K G b) :
    f₁ * f₂ ∈ algebraicFunctionsDegreeLE K G (a + b) := by
  obtain ⟨P₁, hP₁, rfl⟩ := (mem_algebraicFunctionsDegreeLE_iff K G).mp h₁
  obtain ⟨P₂, hP₂, rfl⟩ := (mem_algebraicFunctionsDegreeLE_iff K G).mp h₂
  exact (mem_algebraicFunctionsDegreeLE_iff K G).mpr
    ⟨P₁ * P₂, (totalDegree_mul _ _).trans (add_le_add hP₁ hP₂), map_mul _ _ _⟩

/-- Each step `C^alg_{≤m}` of the degree filtration is stable under the two-sided translation
action `f ↦ (g ↦ f (g₁ * g * g₂))` of `G × G`. -/
theorem comp_mul_mul_mem_algebraicFunctionsDegreeLE (g₁ g₂ : G) {m : ℕ} {f : C(G, K)}
    (hf : f ∈ algebraicFunctionsDegreeLE K G m) :
    f.comp ⟨fun g ↦ g₁ * g * g₂, (continuous_const.mul continuous_id).mul continuous_const⟩ ∈
      algebraicFunctionsDegreeLE K G m := by
  obtain ⟨P, hP, rfl⟩ := (mem_algebraicFunctionsDegreeLE_iff K G).mp hf
  -- `f (g₁ * g * g₂)` is the restriction of the substitution `P (g₁ * X * g₂)`, whose variables
  -- are replaced by linear forms.
  let ι : ℤ_[p] →+* K := (algebraMap ℚ_[p] K).comp PadicInt.Coe.ringHom
  refine (mem_algebraicFunctionsDegreeLE_iff K G).mpr ⟨mvPolynomialSubst
    (ι.mapMatrix (g₁ : SpecialLinearGroup n ℤ_[p])) (ι.mapMatrix (g₂ : SpecialLinearGroup n ℤ_[p]))
      P, ?_, ?_⟩
  · rw [mvPolynomialSubst_apply]
    exact (totalDegree_aeval_le (D := 1) P fun _ _ ↦
      (isHomogeneous_map_mul_mvPolynomialX_mul_map_apply _ _ _ _).totalDegree_le).trans
        (by simpa using hP)
  · ext g
    have hm : (ι.mapMatrix (g₁ : SpecialLinearGroup n ℤ_[p])).map (algebraMap K K) *
        ι.mapMatrix (g : SpecialLinearGroup n ℤ_[p]) *
          (ι.mapMatrix (g₂ : SpecialLinearGroup n ℤ_[p])).map (algebraMap K K) =
        ι.mapMatrix (((g₁ * g * g₂ : G) : SpecialLinearGroup n ℤ_[p]) :
          Matrix n n ℤ_[p]) := by
      rw [Subgroup.coe_mul, Subgroup.coe_mul, SpecialLinearGroup.coe_mul,
        SpecialLinearGroup.coe_mul, map_mul, map_mul, Algebra.algebraMap_self, RingHom.coe_id,
        Matrix.map_id, Matrix.map_id]
    simp only [ContinuousMap.comp_apply, ContinuousMap.coe_mk]
    rw [polynomialRestriction_apply_eq_eval_mapMatrix,
      polynomialRestriction_apply_eq_eval_mapMatrix, ← aeval_eq_eval, ← aeval_eq_eval,
      aeval_mvPolynomialSubst, hm]

/-- `C^alg(G, K)` is stable under the two-sided translation action of `G × G`. -/
theorem comp_mul_mul_mem_algebraicFunctions (g₁ g₂ : G) {f : C(G, K)}
    (hf : f ∈ algebraicFunctions K G) :
    f.comp ⟨fun g ↦ g₁ * g * g₂, (continuous_const.mul continuous_id).mul continuous_const⟩ ∈
      algebraicFunctions K G := by
  obtain ⟨P, rfl⟩ := hf
  obtain ⟨Q, -, hQ⟩ := (mem_algebraicFunctionsDegreeLE_iff K G).mp
    (comp_mul_mul_mem_algebraicFunctionsDegreeLE K G g₁ g₂
      ((mem_algebraicFunctionsDegreeLE_iff K G).mpr ⟨P, le_rfl, rfl⟩))
  exact ⟨Q, hQ⟩

end Restriction

/-! ### The kernel of restriction to an open subgroup of `SL₂(ℤ_p)` -/

section FinTwo

variable {K : Type*} [CommRing K] [IsDomain K] [Algebra ℚ_[p] K] [TopologicalSpace K]
  [IsTopologicalRing K] [ContinuousSMul ℚ_[p] K]

omit [TopologicalSpace K] [IsTopologicalRing K] [ContinuousSMul ℚ_[p] K] in
/-- Modulo `xw - yz - 1`, the relation `xw = 1 + yz` eliminates `w`: some `x ^ N * f` is congruent
to a polynomial in `x, y, z` alone. -/
private theorem exists_X_pow_mul_sub_mem (f : MvPolynomial (Fin 2 × Fin 2) K) :
    ∃ N : ℕ, ∃ r ∈ supported K {(0, 0), (0, 1), (1, 0)},
      X (0, 0) ^ N * f - r ∈ Ideal.span {(mvPolynomialX (Fin 2) (Fin 2) K).det - 1} := by
  set I := Ideal.span {(mvPolynomialX (Fin 2) (Fin 2) K).det - 1}
  have hX : ∀ i ∈ ({(0, 0), (0, 1), (1, 0)} : Set (Fin 2 × Fin 2)),
      (X i : MvPolynomial (Fin 2 × Fin 2) K) ∈ supported K {(0, 0), (0, 1), (1, 0)} :=
    fun i hi ↦ X_mem_supported.mpr hi
  induction f using MvPolynomial.induction_on with
  | C c => exact ⟨0, C c, (supported K _).algebraMap_mem c, by simp⟩
  | add f₁ f₂ h₁ h₂ =>
    obtain ⟨N₁, r₁, hr₁, h₁⟩ := h₁
    obtain ⟨N₂, r₂, hr₂, h₂⟩ := h₂
    have hx := hX (0, 0) (by simp)
    refine ⟨N₁ + N₂, X (0, 0) ^ N₂ * r₁ + X (0, 0) ^ N₁ * r₂,
      add_mem (mul_mem (pow_mem hx _) hr₁) (mul_mem (pow_mem hx _) hr₂), ?_⟩
    convert I.add_mem (I.mul_mem_left (X (0, 0) ^ N₂) h₁) (I.mul_mem_left (X (0, 0) ^ N₁) h₂)
      using 1
    ring
  | mul_X f i h =>
    obtain ⟨N, r, hr, h⟩ := h
    by_cases hi : i = (1, 1)
    · subst hi
      refine ⟨N + 1, r * (1 + X (0, 1) * X (1, 0)),
        mul_mem hr (add_mem (one_mem _) (mul_mem (hX _ (by simp)) (hX _ (by simp)))), ?_⟩
      convert I.add_mem (I.mul_mem_left (X (0, 0) * X (1, 1)) h)
        (I.mul_mem_left r (Ideal.mem_span_singleton_self _)) using 1
      simp only [det_fin_two, mvPolynomialX_apply]
      ring
    · refine ⟨N, r * X i, mul_mem hr (hX i ?_), ?_⟩
      · fin_cases i <;> simp_all
      · convert I.mul_mem_right (X i) h using 1
        ring

omit [TopologicalSpace K] [IsTopologicalRing K] [ContinuousSMul ℚ_[p] K] in
/-- `x` is a nonzerodivisor modulo `xw - yz - 1`: it is prime and does not divide `xw - yz - 1`. -/
private theorem mem_span_of_X_mul_mem {h : MvPolynomial (Fin 2 × Fin 2) K}
    (hh : X (0, 0) * h ∈ Ideal.span {(mvPolynomialX (Fin 2) (Fin 2) K).det - 1}) :
    h ∈ Ideal.span {(mvPolynomialX (Fin 2) (Fin 2) K).det - 1} := by
  obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.mp hh
  have hnd : ¬ (X (0, 0) : MvPolynomial (Fin 2 × Fin 2) K) ∣
      (mvPolynomialX (Fin 2) (Fin 2) K).det - 1 := by
    rintro ⟨s, hs⟩
    simpa [det_fin_two] using congr(eval 0 $hs)
  obtain ⟨q', rfl⟩ := (prime_X.dvd_or_dvd ⟨h, hq⟩).resolve_right hnd
  refine Ideal.mem_span_singleton'.mpr ⟨q', mul_left_cancel₀ (X_ne_zero (0, 0)) ?_⟩
  rw [← hq, mul_assoc]

omit [TopologicalSpace K] [IsTopologicalRing K] [ContinuousSMul ℚ_[p] K] in
private theorem mem_span_of_X_pow_mul_mem {h : MvPolynomial (Fin 2 × Fin 2) K} (N : ℕ)
    (hh : X (0, 0) ^ N * h ∈ Ideal.span {(mvPolynomialX (Fin 2) (Fin 2) K).det - 1}) :
    h ∈ Ideal.span {(mvPolynomialX (Fin 2) (Fin 2) K).det - 1} := by
  induction N with
  | zero => simpa using hh
  | succ N ih => exact ih (mem_span_of_X_mul_mem (by rwa [pow_succ', mul_assoc] at hh))

/-- For every `m` and `s, t, u ∈ ℤ_p`, some matrix of `SL₂(ℤ_p)` congruent to the identity modulo
`p ^ (m + 1)` has first row `(1 + p ^ (m + 1) s, p ^ (m + 1) t)` and lower left entry
`p ^ (m + 1) u`. -/
private theorem exists_specialLinearGroup_fin_two (m : ℕ) (s t u : ℤ_[p]) :
    ∃ g : SpecialLinearGroup (Fin 2) ℤ_[p],
      g 0 0 = 1 + (p : ℤ_[p]) ^ (m + 1) * s ∧ g 0 1 = (p : ℤ_[p]) ^ (m + 1) * t ∧
        g 1 0 = (p : ℤ_[p]) ^ (m + 1) * u ∧
          ∀ i j, (p : ℤ_[p]) ^ (m + 1) ∣ ((g : Matrix (Fin 2) (Fin 2) ℤ_[p]) - 1) i j := by
  set q : ℤ_[p] := (p : ℤ_[p]) ^ (m + 1)
  have hq : ¬ IsUnit q := by
    rw [isUnit_pow_iff m.succ_ne_zero]
    exact PadicInt.p_nonunit
  obtain ⟨v, hv⟩ : IsUnit (1 + q * s) := by
    have h := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits (-(q * s))
      (by simpa using fun h ↦ hq (isUnit_of_mul_isUnit_left h))
    rwa [sub_neg_eq_add] at h
  have hvi : (↑v⁻¹ : ℤ_[p]) * v = 1 := v.inv_mul
  refine ⟨⟨!![1 + q * s, q * t; q * u, ↑v⁻¹ * (1 + q * t * (q * u))], ?_⟩, rfl, rfl, rfl, ?_⟩
  · rw [det_fin_two_of]
    linear_combination (1 + q * t * (q * u)) * hvi - (↑v⁻¹ * (1 + q * t * (q * u))) * hv
  · suffices q ∣ ↑v⁻¹ * (1 + q * t * (q * u)) - 1 by simpa [Fin.forall_fin_two]
    refine ⟨↑v⁻¹ * (q * t * u - s), ?_⟩
    linear_combination hvi - (↑v⁻¹ : ℤ_[p]) * hv

variable (K) in
/-- **Algebraic functions on an open subgroup of `SL₂(ℤ_p)`.** A polynomial in the four matrix
entries vanishes on an open subgroup `G` of `SL₂(ℤ_p)` exactly when it lies in the ideal generated
by `det - 1 = xw - yz - 1`: open subgroups are Zariski dense in `SL₂`. -/
theorem ker_polynomialRestriction_fin_two {G : Subgroup (SpecialLinearGroup (Fin 2) ℤ_[p])}
    (hG : IsOpen (G : Set (SpecialLinearGroup (Fin 2) ℤ_[p]))) :
    RingHom.ker (polynomialRestriction K G) =
      Ideal.span {(mvPolynomialX (Fin 2) (Fin 2) K).det - 1} := by
  refine le_antisymm (fun f hf ↦ ?_) (span_det_sub_one_le_ker_polynomialRestriction K G)
  obtain ⟨m, hm⟩ := exists_setOf_pow_dvd_sub_one_subset (hG.mem_nhds G.one_mem)
  obtain ⟨N, r, hr, hfr⟩ := exists_X_pow_mul_sub_mem f
  have hrker : polynomialRestriction K G r = 0 := by
    have h := span_det_sub_one_le_ker_polynomialRestriction K G hfr
    rw [RingHom.mem_ker] at hf h
    simpa [hf] using h
  suffices r = 0 by
    subst this
    exact mem_span_of_X_pow_mul_mem N (by simpa using hfr)
  -- `r` involves only `x, y, z`, and vanishes on the box `(1 + q ℤ_p) × q ℤ_p × q ℤ_p` of values
  -- of these entries on `G`, where `q = p ^ (m + 1)`.
  set q : ℤ_[p] := (p : ℤ_[p]) ^ (m + 1)
  let ι : ℤ_[p] → K := fun x ↦ algebraMap ℚ_[p] K (x : ℚ_[p])
  have hι : Function.Injective ι :=
    (algebraMap ℚ_[p] K).injective.comp Subtype.val_injective
  have hq : q ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero)
  have : Infinite ℤ_[p] := Infinite.of_injective _ (Nat.cast_injective (R := ℤ_[p]))
  have : Infinite K := Infinite.of_injective ι hι
  let S₀ : Set K := Set.range fun t ↦ ι (1 + q * t)
  let S : Set K := Set.range fun t ↦ ι (q * t)
  have hS₀ : S₀.Infinite := Set.infinite_range_of_injective <|
    hι.comp ((add_right_injective 1).comp (mul_right_injective₀ hq))
  have hS : S.Infinite := Set.infinite_range_of_injective <| hι.comp (mul_right_injective₀ hq)
  refine funext_set (fun i ↦ if i = (0, 0) then S₀ else if i = (1, 1) then Set.univ else S)
    (fun i ↦ by split_ifs <;> first | exact hS₀ | exact Set.infinite_univ | exact hS)
    fun x hx ↦ ?_
  obtain ⟨s, hs⟩ : x (0, 0) ∈ S₀ := by simpa using hx (0, 0) trivial
  obtain ⟨t, ht⟩ : x (0, 1) ∈ S := by simpa using hx (0, 1) trivial
  obtain ⟨u, hu⟩ : x (1, 0) ∈ S := by simpa using hx (1, 0) trivial
  obtain ⟨g, hg₀₀, hg₀₁, hg₁₀, hgq⟩ := exists_specialLinearGroup_fin_two m s t u
  have hgG : g ∈ G := hm fun i j ↦ (pow_dvd_pow _ m.le_succ).trans (hgq i j)
  have hrg := congr($hrker ⟨g, hgG⟩)
  rw [polynomialRestriction_apply, ContinuousMap.zero_apply] at hrg
  rw [map_zero, ← hrg]
  refine hom_congr_vars (by ext; simp) (fun i hi _ ↦ ?_) rfl
  have hi' : i ∈ ({(0, 0), (0, 1), (1, 0)} : Set (Fin 2 × Fin 2)) := mem_supported.mp hr hi
  have hιg : ∀ {y : ℤ_[p]} {i j : Fin 2}, g i j = y →
      algebraMap ℚ_[p] K (((⟨g, hgG⟩ : G) : SpecialLinearGroup (Fin 2) ℤ_[p]) i j : ℚ_[p]) =
        ι y :=
    fun h ↦ congrArg ι h
  rcases hi' with rfl | rfl | rfl <;> simp only [eval_X]
  · rw [← hs, hιg hg₀₀]
  · rw [← ht, hιg hg₀₁]
  · rw [← hu, hιg hg₁₀]

variable (K) in
/-- **The coordinate ring of `SL₂` as algebraic functions.** Restriction to an open subgroup `G` of
`SL₂(ℤ_p)` identifies `K[SL₂] = K[x, y, z, w] / (xw - yz - 1)` with `C^alg(G, K)`. -/
noncomputable def algebraicFunctionsEquiv {G : Subgroup (SpecialLinearGroup (Fin 2) ℤ_[p])}
    (hG : IsOpen (G : Set (SpecialLinearGroup (Fin 2) ℤ_[p]))) :
    (MvPolynomial (Fin 2 × Fin 2) K ⧸
      Ideal.span {(mvPolynomialX (Fin 2) (Fin 2) K).det - 1}) ≃ₐ[K] algebraicFunctions K G :=
  (Ideal.quotientEquivAlgOfEq K (ker_polynomialRestriction_fin_two K hG).symm).trans
    (Ideal.quotientKerEquivRange (polynomialRestriction K G))

/-- `algebraicFunctionsEquiv` sends the class of a polynomial to its restriction. -/
@[simp]
theorem coe_algebraicFunctionsEquiv_mk {G : Subgroup (SpecialLinearGroup (Fin 2) ℤ_[p])}
    (hG : IsOpen (G : Set (SpecialLinearGroup (Fin 2) ℤ_[p])))
    (f : MvPolynomial (Fin 2 × Fin 2) K) :
    (algebraicFunctionsEquiv K hG (Ideal.Quotient.mk _ f) : C(G, K)) =
      polynomialRestriction K G f :=
  (rfl)

end FinTwo

/-! ### Dimensions of the degree filtration -/

section Finrank

variable {K : Type*} [Field K] [Algebra ℚ_[p] K] [TopologicalSpace K] [IsTopologicalRing K]
  [ContinuousSMul ℚ_[p] K]

omit [TopologicalSpace K] [IsTopologicalRing K] [ContinuousSMul ℚ_[p] K] in
/-- The polynomial `xw - yz - 1` has total degree two. -/
private theorem totalDegree_det_sub_one_fin_two :
    ((mvPolynomialX (Fin 2) (Fin 2) K).det - 1).totalDegree = 2 := by
  simpa using totalDegree_det_mvPolynomialX_sub_one (R := K) (n := Fin 2) (by simp)

omit [TopologicalSpace K] [IsTopologicalRing K] [ContinuousSMul ℚ_[p] K] in
/-- The polynomial `xw - yz - 1` is nonzero. -/
private theorem det_sub_one_ne_zero_fin_two : (mvPolynomialX (Fin 2) (Fin 2) K).det - 1 ≠ 0 :=
  fun h ↦ by simpa [h] using (totalDegree_det_sub_one_fin_two (K := K))

/-- A polynomial vanishing on an open subgroup of `SL₂(ℤ_p)` is `(det - 1) * q` with `q = 0` or
of total degree two less. -/
private theorem exists_eq_det_sub_one_mul {G : Subgroup (SpecialLinearGroup (Fin 2) ℤ_[p])}
    (hG : IsOpen (G : Set (SpecialLinearGroup (Fin 2) ℤ_[p])))
    {x : MvPolynomial (Fin 2 × Fin 2) K} (hx : polynomialRestriction K G x = 0) :
    ∃ q, x = ((mvPolynomialX (Fin 2) (Fin 2) K).det - 1) * q ∧
      (q = 0 ∨ q.totalDegree + 2 = x.totalDegree) := by
  rw [← RingHom.mem_ker, ker_polynomialRestriction_fin_two K hG, Ideal.mem_span_singleton'] at hx
  obtain ⟨q, rfl⟩ := hx
  refine ⟨q, mul_comm _ _, or_iff_not_imp_left.mpr fun hq ↦ ?_⟩
  rw [totalDegree_mul_of_isDomain hq det_sub_one_ne_zero_fin_two,
    totalDegree_det_sub_one_fin_two]

/-- The polynomials of total degree at most `m` vanishing on an open subgroup of `SL₂(ℤ_p)` are
`(det - 1)` times those of total degree at most `m - 2`, a space of dimension `C(m + 2, 4)`. -/
private theorem finrank_restrictTotalDegree_inf_ker
    {G : Subgroup (SpecialLinearGroup (Fin 2) ℤ_[p])}
    (hG : IsOpen (G : Set (SpecialLinearGroup (Fin 2) ℤ_[p]))) (m : ℕ) :
    Module.finrank K ↥(restrictTotalDegree (Fin 2 × Fin 2) K m ⊓
      LinearMap.ker (polynomialRestriction K G).toLinearMap) = (m + 2).choose 4 := by
  have hmem : ∀ {m} x, x ∈ restrictTotalDegree (Fin 2 × Fin 2) K m ⊓
      LinearMap.ker (polynomialRestriction K G).toLinearMap ↔
        x.totalDegree ≤ m ∧ polynomialRestriction K G x = 0 := fun x ↦ by
    simp [mem_restrictTotalDegree]
  have hbot : ∀ m ≤ 1, restrictTotalDegree (Fin 2 × Fin 2) K m ⊓
      LinearMap.ker (polynomialRestriction K G).toLinearMap = ⊥ := fun m hm ↦
    (Submodule.eq_bot_iff _).mpr fun x hx ↦ by
      obtain ⟨hxm, hx⟩ := (hmem x).mp hx
      obtain ⟨q, rfl, hq | hq⟩ := exists_eq_det_sub_one_mul hG hx
      · simp [hq]
      · omega
  match m with
  | 0 | 1 =>
    rw [hbot _ (by norm_num), finrank_bot]
    rfl
  | k + 2 =>
    have hmap : restrictTotalDegree (Fin 2 × Fin 2) K (k + 2) ⊓
        LinearMap.ker (polynomialRestriction K G).toLinearMap =
        (restrictTotalDegree (Fin 2 × Fin 2) K k).map
          (LinearMap.mulLeft K ((mvPolynomialX (Fin 2) (Fin 2) K).det - 1)) := by
      ext x
      rw [hmem, Submodule.mem_map]
      constructor
      · rintro ⟨hxm, hx⟩
        obtain ⟨q, rfl, hq | hq⟩ := exists_eq_det_sub_one_mul hG hx
        · exact ⟨0, zero_mem _, by simp [hq]⟩
        · exact ⟨q, (mem_restrictTotalDegree _ _ _).mpr (by omega), rfl⟩
      · rintro ⟨q, hq, rfl⟩
        refine ⟨(totalDegree_mul _ _).trans ?_, by simp⟩
        rw [totalDegree_det_sub_one_fin_two]
        have := (mem_restrictTotalDegree _ _ _).mp hq
        omega
    rw [hmap, ← (Submodule.equivMapOfInjective _
      (mul_right_injective₀ det_sub_one_ne_zero_fin_two) _).finrank_eq,
      finrank_restrictTotalDegree]
    simp

/-- Rank–nullity for restriction on the polynomials of total degree at most `m`. -/
private theorem finrank_algebraicFunctionsDegreeLE_add
    {G : Subgroup (SpecialLinearGroup (Fin 2) ℤ_[p])}
    (hG : IsOpen (G : Set (SpecialLinearGroup (Fin 2) ℤ_[p]))) (m : ℕ) :
    Module.finrank K (algebraicFunctionsDegreeLE K G m) + (m + 2).choose 4 =
      (m + 4).choose 4 := by
  set L := (polynomialRestriction K G).toLinearMap ∘ₗ
    (restrictTotalDegree (Fin 2 × Fin 2) K m).subtype
  have h := L.finrank_range_add_finrank_ker
  rw [LinearMap.range_comp, Submodule.range_subtype, finrank_restrictTotalDegree,
    (Submodule.equivMapOfInjective _ (Submodule.injective_subtype _) L.ker).finrank_eq] at h
  have hker : L.ker.map (restrictTotalDegree (Fin 2 × Fin 2) K m).subtype =
      restrictTotalDegree (Fin 2 × Fin 2) K m ⊓
        LinearMap.ker (polynomialRestriction K G).toLinearMap := by
    ext x
    simp [L, mem_restrictTotalDegree, and_comm]
  rw [hker, finrank_restrictTotalDegree_inf_ker hG] at h
  rw [algebraicFunctionsDegreeLE]
  convert h using 2 <;> simp

variable (K) in
/-- **The dimension of the degree filtration.** On an open subgroup `G` of `SL₂(ℤ_p)`, the
algebraic functions of degree at most `m` form a space of dimension `C(m + 4, 4) - C(m + 2, 4)`:
the polynomials of degree at most `m` in four variables, modulo `(xw - yz - 1)` times those of
degree at most `m - 2`. -/
theorem finrank_algebraicFunctionsDegreeLE {G : Subgroup (SpecialLinearGroup (Fin 2) ℤ_[p])}
    (hG : IsOpen (G : Set (SpecialLinearGroup (Fin 2) ℤ_[p]))) (m : ℕ) :
    Module.finrank K (algebraicFunctionsDegreeLE K G m) =
      (m + 4).choose 4 - (m + 2).choose 4 := by
  have := finrank_algebraicFunctionsDegreeLE_add (K := K) hG m
  omega

variable (K) in
/-- **The graded pieces of the degree filtration.** On an open subgroup `G` of `SL₂(ℤ_p)`,
`dim C^alg_{≤m+1} / C^alg_{≤m} = C(m + 4, 3) - C(m + 2, 3) = (m + 2)²`, the dimension of
`W ⊗ W^*` for the irreducible algebraic representation `W = Sym^{m+1}(K²)` of dimension `m + 2`. -/
theorem finrank_algebraicFunctionsDegreeLE_quotient
    {G : Subgroup (SpecialLinearGroup (Fin 2) ℤ_[p])}
    (hG : IsOpen (G : Set (SpecialLinearGroup (Fin 2) ℤ_[p]))) (m : ℕ) :
    Module.finrank K (algebraicFunctionsDegreeLE K G (m + 1) ⧸
      (algebraicFunctionsDegreeLE K G m).comap (algebraicFunctionsDegreeLE K G (m + 1)).subtype) =
        (m + 2) ^ 2 := by
  have h := Submodule.finrank_quotient_add_finrank
    ((algebraicFunctionsDegreeLE K G m).comap (algebraicFunctionsDegreeLE K G (m + 1)).subtype)
  rw [(Submodule.comapSubtypeEquivOfLe
    (algebraicFunctionsDegreeLE_mono K G m.le_succ)).finrank_eq] at h
  have h₁ := finrank_algebraicFunctionsDegreeLE_add (K := K) hG m
  have h₂ := finrank_algebraicFunctionsDegreeLE_add (K := K) hG (m + 1)
  have h₃ := Nat.add_three_choose_three (m + 1)
  have h₄ := Nat.choose_succ_succ' (m + 4) 3
  have h₅ := Nat.choose_succ_succ' (m + 2) 3
  simp only [add_assoc, Nat.reduceAdd] at h₂ h₃ h₄ h₅
  generalize (m + 2) ^ 2 = s at h₃ ⊢
  omega

end Finrank

end TauCeti
