/-!
# Procyclic closed subgroups of the dyadic units

A closed subgroup of `ℤ₂ˣ` is topologically generated by one element exactly when it does not
contain both `-1` and a nonidentity principal unit of level at least two. Equivalently, the
nonprocyclic closed subgroups are precisely Labute's groups `V^(f) = {±1} × U^(f)` for finite
`f ≥ 2`. This distinguishes the two possible shapes of the image of a Demushkin orientation.

The subgroup classification and the nonprocyclicity of `V^(f)` are proved in
`TauCeti.NumberTheory.Padics.DyadicUnits`.

## References

* J. Labute, *Classification of Demushkin groups*, Canad. J. Math. 19 (1967), the remark
  following the corollary to Theorem 4.
-/

public section

namespace TauCeti

/-- A closed subgroup of `ℤ₂ˣ` is procyclic exactly when either it does not contain `-1`, or its
intersection with `1 + 4ℤ₂` is trivial. The latter case includes `{±1}`. -/
theorem exists_topologicalClosure_zpowers_eq_iff_of_isClosed
    {A : Subgroup ℤ_[2]ˣ} (hA : IsClosed (A : Set ℤ_[2]ˣ)) :
    (∃ u : ℤ_[2]ˣ, (Subgroup.zpowers u).topologicalClosure = A) ↔
      (-1 : ℤ_[2]ˣ) ∉ A ∨ A ⊓ unitsPrincipal 2 2 = ⊥ := by
  constructor
  · rintro ⟨u, hu⟩
    by_cases hneg : (-1 : ℤ_[2]ˣ) ∈ A
    · right
      by_contra hbot
      have hA' : A ≠ ⊥ := by
        intro h
        exact PadicInt.units_neg_one_ne_one (Subgroup.mem_bot.mp (h ▸ hneg))
      rcases closedSubgroup_units_two_classification hA hA' with
        ⟨f, hf, h⟩ | ⟨f, hf, h⟩ | h | ⟨f, v, hf, hv, h⟩
      · rw [h] at hneg
        have hle := neg_one_mem_unitsPrincipal_two_iff.mp hneg
        omega
      · exact not_exists_topologicalClosure_zpowers_eq_unitsPlusMinus hf ⟨u, hu.trans h⟩
      · exact hbot (by rw [h, inf_comm]; exact
          (disjoint_unitsPrincipal_zpowers_neg_one (by omega : 2 ≤ 2)).eq_bot)
      · rw [h] at hneg
        exact neg_one_notMem_topologicalClosure_zpowers_two hf
          (neg_mem_unitsPrincipal_two_of_val_eq hv)
          (neg_notMem_unitsPrincipal_two_succ_of_val_eq hv) hneg
    · exact Or.inl hneg
  · rintro (hneg | hbot)
    · exact exists_topologicalClosure_zpowers_eq_of_isClosed_of_neg_one_notMem hA hneg
    · by_cases hA' : A = ⊥
      · subst A
        exact exists_topologicalClosure_zpowers_eq_of_isClosed_of_neg_one_notMem hA
          (by simp)
      · refine ⟨-1, ?_⟩
        rw [topologicalClosure_zpowers_neg_one]
        exact (eq_zpowers_neg_one_of_inf_unitsPrincipal_two_eq_bot hA' hbot).symm

end TauCeti
