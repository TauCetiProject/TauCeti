module

public import TauCeti.FieldTheory.SquareClassGroup.Multiplicative
public import TauCeti.NumberTheory.LocalField.QuadraticForm.PadicTwo
public import Mathlib.RingTheory.Localization.Away.Basic
import TauCeti.RingTheory.Localization.Away.PrimeUnits

/-!
# Removing the ramified part of a dyadic square class by a global twist

The units of `ℤ[1/2]` give the four classes generated by `-1` and `2` in the square-class group
of `ℚ_[2]`. They complement the order-two subgroup generated by the unramified class `5`.
Consequently every dyadic square class has a unique global unit twist modulo squares that makes
it either trivial or unramified.

This is the square-class comparison for the canonical-cover argument in S. Schröer,
*There is no Enriques surface over the integers*, Proposition 5.5. The coordinates used here
are those of `TauCeti.padicTwoSquareClassBasis`.
-/

public section
noncomputable section

namespace TauCeti

local notation "R" => Localization.Away (2 : ℤ)

/-- The canonical map from `ℤ[1/2]` to the dyadic field. -/
def dyadicLocalization : R →+* ℚ_[2] :=
  Localization.awayLift (Int.castRingHom ℚ_[2]) (2 : ℤ) (by simp)

/-- Localization of unit square classes from `ℤ[1/2]` to `ℚ_[2]`. -/
def dyadicGlobalSquareClass : ElementaryTwoQuotient Rˣ →ₗ[ZMod 2] SquareClassGroup ℚ_[2] :=
  elementaryTwoQuotientEquivSquareClassGroup.toLinearMap.comp
    (elementaryTwoQuotientMap (Units.map dyadicLocalization.toMonoidHom))

/-- Localization sends the square class of a global unit to the class of its dyadic image. -/
@[simp]
theorem dyadicGlobalSquareClass_mk (u : Rˣ) :
    dyadicGlobalSquareClass (elementaryTwoQuotientMk u) =
      squareClass (Units.map dyadicLocalization.toMonoidHom u) := by
  simp [dyadicGlobalSquareClass]

private abbrev twoUnit : Rˣ := (IsLocalization.Away.algebraMap_isUnit (S := R) (2 : ℤ)).unit
local notation "P" => twoUnit
local notation "B" => padicTwoSquareClassBasis

/-- The global twist `(-1)^e 2^a` is an actual unit of `ℤ[1/2]`. -/
def dyadicGlobalTwist (e a : ZMod 2) : Rˣ := (-1) ^ e.val * P ^ a.val

/-- The global twist has the stated signed-power value in the localization. -/
@[simp]
theorem coe_dyadicGlobalTwist (e a : ZMod 2) :
    (dyadicGlobalTwist e a : R) = (-1) ^ e.val * (2 : R) ^ a.val := by
  simp [dyadicGlobalTwist]

private theorem mk_dyadicGlobalTwist (e a : ZMod 2) :
    elementaryTwoQuotientMk (dyadicGlobalTwist e a) =
      e • elementaryTwoQuotientMk (-1 : Rˣ) + a • elementaryTwoQuotientMk P := by
  simp [dyadicGlobalTwist, ← Nat.cast_smul_eq_nsmul (ZMod 2)]

/-- The four signed powers represent all unit square classes of `ℤ[1/2]`. -/
theorem exists_eq_dyadicGlobalTwist (q : ElementaryTwoQuotient Rˣ) :
    ∃ e a : ZMod 2, q = elementaryTwoQuotientMk (dyadicGlobalTwist e a) := by
  obtain ⟨u, rfl⟩ := elementaryTwoQuotientMk_surjective q
  obtain ⟨v, n, rfl⟩ := Int.prime_two.exists_units_mul_zpow_of_away u
  have hn : elementaryTwoQuotientMk (P ^ n) = (n : ZMod 2) • elementaryTwoQuotientMk P := by
    rw [Int.cast_smul_eq_zsmul]
    simp only [elementaryTwoQuotientMk_eq_mkQ, ofMul_zpow, Submodule.Quotient.mk_smul]
  rw [elementaryTwoQuotientMk_mul, hn]
  rcases Int.units_eq_one_or v with rfl | rfl
  · exact ⟨0, n, by simp [mk_dyadicGlobalTwist]⟩
  · exact ⟨1, n, by simp [mk_dyadicGlobalTwist]⟩

private theorem dyadicGlobalSquareClass_mk_neg_one :
    dyadicGlobalSquareClass (elementaryTwoQuotientMk (-1 : Rˣ)) = B 0 := by
  simp

private theorem dyadicGlobalSquareClass_mk_two :
    dyadicGlobalSquareClass (elementaryTwoQuotientMk P) = B 1 := by
  have h : Units.map dyadicLocalization.toMonoidHom P = Units.mk0 2 two_ne_zero := by
    apply Units.ext
    simp only [twoUnit, Units.coe_map, IsUnit.unit_spec, Units.val_mk0, map_ofNat]
    exact map_ofNat dyadicLocalization 2
  rw [dyadicGlobalSquareClass_mk, h]
  simp

/-- The local square class of the global twist has coordinates `(e,a,0)` in the basis
`(-1,2,5)`. -/
theorem repr_dyadicGlobalSquareClass_mk_twist (e a : ZMod 2) :
    ⇑((B).repr (dyadicGlobalSquareClass (elementaryTwoQuotientMk (dyadicGlobalTwist e a)))) =
      ![e, a, 0] := by
  rw [mk_dyadicGlobalTwist, map_add, map_smul, map_smul, dyadicGlobalSquareClass_mk_neg_one,
    dyadicGlobalSquareClass_mk_two]
  ext i
  fin_cases i <;> simp [-coe_padicTwoSquareClassBasis, Module.Basis.repr_self]

/-- No nonsquare unit of `ℤ[1/2]` becomes a square in `ℚ_[2]`. -/
theorem dyadicGlobalSquareClass_injective : Function.Injective dyadicGlobalSquareClass := by
  intro x y h
  obtain ⟨e, a, rfl⟩ := exists_eq_dyadicGlobalTwist x
  obtain ⟨f, b, rfl⟩ := exists_eq_dyadicGlobalTwist y
  have hrepr := congrArg (fun z => ((B).repr z : Fin 3 → ZMod 2)) h
  rw [repr_dyadicGlobalSquareClass_mk_twist, repr_dyadicGlobalSquareClass_mk_twist] at hrepr
  have he : e = f := congrFun hrepr 0
  have ha : a = b := congrFun hrepr 1
  rw [he, ha]

/-- The dyadic image of global unit square classes consists exactly of the classes with
zero `5`-coordinate. -/
theorem mem_range_dyadicGlobalSquareClass (c : SquareClassGroup ℚ_[2]) :
    c ∈ LinearMap.range dyadicGlobalSquareClass ↔ (B).repr c 2 = 0 := by
  constructor
  · rintro ⟨q, rfl⟩
    obtain ⟨e, a, rfl⟩ := exists_eq_dyadicGlobalTwist q
    exact congrFun (repr_dyadicGlobalSquareClass_mk_twist e a) 2
  · intro hc
    refine ⟨elementaryTwoQuotientMk (dyadicGlobalTwist ((B).repr c 0) ((B).repr c 1)), ?_⟩
    apply (B).repr.injective
    ext i
    rw [congrFun (repr_dyadicGlobalSquareClass_mk_twist _ _) i]
    fin_cases i <;> simp [hc]

/-- Twisting by the sign and valuation coordinates cancels them and leaves the `5`-coordinate. -/
theorem add_dyadicGlobalSquareClass_mk_twist (c : SquareClassGroup ℚ_[2]) :
    c + dyadicGlobalSquareClass (elementaryTwoQuotientMk
      (dyadicGlobalTwist ((B).repr c 0) ((B).repr c 1))) = (B).repr c 2 • B 2 := by
  apply (B).repr.injective
  ext i
  simp only [map_add, Finsupp.add_apply, map_smul, Finsupp.smul_apply,
    Module.Basis.repr_self]
  rw [congrFun (repr_dyadicGlobalSquareClass_mk_twist _ _) i]
  fin_cases i <;> simp [add_eq_zero_iff_eq_neg, ZMod.neg_eq_self_mod_two]

/-- Exactly one unit square class of `ℤ[1/2]` twists a given dyadic class into the trivial
class or the class of `5`. -/
theorem existsUnique_dyadicGlobalTwist (c : SquareClassGroup ℚ_[2]) :
    ∃! q : ElementaryTwoQuotient Rˣ,
      c + dyadicGlobalSquareClass q = 0 ∨
        c + dyadicGlobalSquareClass q = squareClass (Units.mk0 (5 : ℚ_[2]) (by norm_num)) := by
  have h5 : B 2 = squareClass (Units.mk0 (5 : ℚ_[2]) (by norm_num)) := by simp
  rw [← h5]
  refine ⟨elementaryTwoQuotientMk (dyadicGlobalTwist ((B).repr c 0) ((B).repr c 1)), ?_, ?_⟩
  · dsimp only
    rw [add_dyadicGlobalSquareClass_mk_twist]
    have cases : ∀ b : ZMod 2, b = 0 ∨ b = 1 := by decide
    rcases cases ((B).repr c 2) with h0 | h1
    · simp [h0]
    · simp [h1]
  · intro q hq
    apply dyadicGlobalSquareClass_injective
    let _ : AddCommGroup (SquareClassGroup ℚ_[2]) := inferInstanceAs
      (AddCommGroup (Additive ℚ_[2]ˣ ⧸ (Subgroup.square ℚ_[2]ˣ).toAddSubgroup))
    apply add_left_cancel (a := c)
    rw [add_dyadicGlobalSquareClass_mk_twist]
    have hzero : (B).repr (dyadicGlobalSquareClass q) 2 = 0 :=
      (mem_range_dyadicGlobalSquareClass _).mp (LinearMap.mem_range_self _ _)
    rcases hq with h | h
    · have hc : (B).repr c 2 = 0 := by
        simpa [hzero] using congrArg (fun z => (B).repr z 2) h
      simpa [hc] using h
    · have hc : (B).repr c 2 = 1 := by
        simpa [hzero, -coe_padicTwoSquareClassBasis, Module.Basis.repr_self] using
          congrArg (fun z => (B).repr z 2) h
      simpa [hc] using h

end TauCeti
