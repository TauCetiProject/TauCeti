/-!
# The presentation `ℤ_p⟦T, U⟧ / (TU - p)` of the annular coefficient ring

The annular coefficient ring `H = TauCeti.AnnularRing p` of two-sided series
`∑_{m ∈ ℤ} d_m T ^ m` with `v_p(d_m) ≥ max(0, -m)` is the quotient of the two-variable power series
ring `ℤ_p⟦T, U⟧` by the ideal generated by `TU - p`. The comparison map sends `T` to `T` and `U` to
`U = p / T`: a series `f = ∑ a_(i,j) T ^ i U ^ j` goes to the element with normal-form coefficients

`d_m = ∑_{i - j = m} a_(i,j) p ^ j`,

a `p`-adically convergent sum along the diagonal `i - j = m`. Since the coefficients of `f` are
arbitrary, so are the formal tails in `U`; this is why `H` is larger than the `p`-adic completion
of `ℤ_p⟦T⟧[p/T]`.

## Main definitions

* `TauCeti.AnnularRing.ofMvPowerSeries`: the `ℤ_p`-algebra map `ℤ_p⟦T, U⟧ → H` with `T ↦ T` and
  `U ↦ U`.
* `TauCeti.AnnularRing.quotientEquiv`: the `ℤ_p`-algebra isomorphism
  `ℤ_p⟦T, U⟧ / (TU - p) ≃ H`.

## Main results

* `TauCeti.AnnularRing.coeff_ofMvPowerSeries`: the normal-form coefficients
  `d_m = ∑_{i - j = m} a_(i,j) p ^ j` of the image of a series.
* `TauCeti.AnnularRing.ofMvPowerSeries_surjective`: every element of `H` comes from a series.
* `TauCeti.AnnularRing.ker_ofMvPowerSeries`: the kernel is the ideal generated by `TU - p`.

## Implementation notes

The variables `T` and `U` of `ℤ_p⟦T, U⟧` are `MvPowerSeries.X 0` and `MvPowerSeries.X 1`.
Multiplicativity of the comparison map is a rearrangement of `p`-adically convergent double
series. The kernel is computed diagonal by diagonal: multiplication by `TU - p` acts on the
coefficients along a diagonal `n, n + (1,1), n + (2,2), …` as `q ↦ (q_{k-1} - p q_k)_k`. A series
whose image vanishes has `∑_l p ^ l a_{n + l(1,1)} = 0` at the start `n` of every diagonal, and
its quotient by `TU - p` is the series of diagonal tails `q_n = ∑_l p ^ l a_{n + (l+1)(1,1)}`.

## References

* R. Liu, D. Wan and L. Xiao, *The eigencurve over the boundary of weight space*, Duke Math. J.
  166 (2017), §§2–3.
-/

public noncomputable section

open Filter MvPowerSeries

namespace TauCeti.AnnularRing

variable {p : ℕ} [Fact p.Prime]

private theorem one_lt_p : (1 : ℝ) < p := mod_cast (Fact.out : p.Prime).one_lt

/-! ### Convergence of the coefficient series -/

/-- Exponents bounded in both variables leave finitely many monomials. -/
private theorem finite_setOf_apply_le (A B : ℕ) :
    {n : Fin 2 →₀ ℕ | n 0 ≤ A ∧ n 1 ≤ B}.Finite :=
  (Set.finite_Iic (Finsupp.single 0 A + Finsupp.single 1 B)).subset fun n hn ↦
    Set.mem_Iic.2 <| Finsupp.le_def.2 fun i ↦ by fin_cases i <;> simp [hn.1, hn.2]

private theorem eq_sub_of_coeff_T_pow_mul_U_pow_ne_zero {n : Fin 2 →₀ ℕ} {m : ℤ}
    (h : ((T : AnnularRing p) ^ n 0 * U ^ n 1).coeff m ≠ 0) : m = n 0 - n 1 := by
  by_contra hm
  exact h (by rw [coeff_T_pow_mul_U_pow, ite_eq_right hm])

/-- The coefficient of `T ^ m` in `c T ^ n₀ U ^ n₁` vanishes unless `m = n₀ - n₁`, when it is
`c p ^ n₁`; either way its norm is at most `p ^ min (m - n₀) (-n₁)`. -/
private theorem norm_mul_coeff_T_pow_mul_U_pow_le (c : ℤ_[p]) (n : Fin 2 →₀ ℕ) (m : ℤ) :
    ‖c * ((T : AnnularRing p) ^ n 0 * U ^ n 1).coeff m‖ ≤
      (p : ℝ) ^ min (m - n 0) (-(n 1 : ℤ)) := by
  rw [coeff_T_pow_mul_U_pow]
  split_ifs with hm
  · rw [show min (m - n 0) (-(n 1 : ℤ)) = -(n 1 : ℤ) by omega, ← PadicInt.norm_p_pow]
    exact (norm_mul_le _ _).trans (mul_le_of_le_one_left (norm_nonneg _) (PadicInt.norm_le_one c))
  · rw [mul_zero, norm_zero]
    exact zpow_nonneg (Nat.cast_nonneg _) _

/-- The exponent `min (m - n₀) (-n₁)` tends to `-∞` along the cofinite filter. -/
private theorem tendsto_min_sub_apply_neg_apply (m : ℤ) :
    Tendsto (fun n : Fin 2 →₀ ℕ ↦ min (m - n 0) (-(n 1 : ℤ))) cofinite atBot :=
  tendsto_atBot.2 fun N ↦ eventually_cofinite.2 <|
    (finite_setOf_apply_le (m - N).toNat (-N).toNat).subset fun n hn ↦ by
      simp only [Set.mem_ofPred_eq, not_le, lt_min_iff] at hn
      constructor <;> omega

/-- The series `∑_n a_n (T ^ n₀ U ^ n₁)_m` converges: its nonzero terms lie on the diagonal
`n₀ - n₁ = m` and have norm at most `p ^ (-n₁)`. -/
private theorem summable_coeff_mul_coeff_T_pow_mul_U_pow (F : MvPowerSeries (Fin 2) ℤ_[p])
    (m : ℤ) :
    Summable fun n : Fin 2 →₀ ℕ ↦
      MvPowerSeries.coeff n F * ((T : AnnularRing p) ^ n 0 * U ^ n 1).coeff m :=
  NonarchimedeanAddGroup.summable_of_tendsto_cofinite_zero <| tendsto_zero_of_norm_le_zpow one_lt_p
    (fun n ↦ norm_mul_coeff_T_pow_mul_U_pow_le _ n m) (tendsto_min_sub_apply_neg_apply m)

/-! ### The comparison map -/

/-- The element `∑_n a_n T ^ n₀ U ^ n₁` of `H`, defined coefficientwise. -/
private def toFun (F : MvPowerSeries (Fin 2) ℤ_[p]) : AnnularRing p :=
  ⟨fun m ↦ ∑' n : Fin 2 →₀ ℕ,
      MvPowerSeries.coeff n F * ((T : AnnularRing p) ^ n 0 * U ^ n 1).coeff m,
    fun m ↦ IsUltrametricDist.norm_tsum_le_of_forall_le_of_nonneg
      (zpow_nonneg (Nat.cast_nonneg _) _) fun n ↦
      (norm_mul_le _ _).trans <|
        (mul_le_of_le_one_left (norm_nonneg _) (PadicInt.norm_le_one _)).trans
          ((T ^ n 0 * U ^ n 1 : AnnularRing p).norm_coeff_le m)⟩

private theorem coeff_toFun (F : MvPowerSeries (Fin 2) ℤ_[p]) (m : ℤ) :
    (toFun F).coeff m =
      ∑' n : Fin 2 →₀ ℕ, MvPowerSeries.coeff n F * ((T : AnnularRing p) ^ n 0 * U ^ n 1).coeff m :=
  (rfl)

private theorem toFun_monomial (n : Fin 2 →₀ ℕ) (c : ℤ_[p]) :
    toFun (monomial n c) = c • ((T : AnnularRing p) ^ n 0 * U ^ n 1) := by
  classical
  ext m : 2
  rw [coeff_toFun, tsum_eq_single n fun k hk ↦ by
    rw [MvPowerSeries.coeff_monomial, ite_eq_right hk, zero_mul],
    MvPowerSeries.coeff_monomial_same, coeff_smul]

private theorem toFun_add (F G : MvPowerSeries (Fin 2) ℤ_[p]) :
    toFun (F + G) = toFun F + toFun G := by
  ext m : 2
  simp only [coeff_toFun, coeff_add, map_add, add_mul]
  exact (summable_coeff_mul_coeff_T_pow_mul_U_pow F m).tsum_add
    (summable_coeff_mul_coeff_T_pow_mul_U_pow G m)

private theorem toFun_smul (c : ℤ_[p]) (F : MvPowerSeries (Fin 2) ℤ_[p]) :
    toFun (c • F) = c • toFun F := by
  ext m : 2
  simp only [coeff_toFun, coeff_smul, map_smul, smul_eq_mul, mul_assoc]
  exact (summable_coeff_mul_coeff_T_pow_mul_U_pow F m).tsum_mul_left c

/-! ### Multiplicativity -/

private theorem T_pow_mul_U_pow_add (a b : Fin 2 →₀ ℕ) :
    (T : AnnularRing p) ^ (a + b) 0 * U ^ (a + b) 1 =
      (T ^ a 0 * U ^ a 1) * (T ^ b 0 * U ^ b 1) := by
  simp only [Finsupp.add_apply, pow_add]
  ring

/-- The term `a_a b_b (T ^ (a + b)₀ U ^ (a + b)₁)_m` of the coefficient of `T ^ m` in the image
of a product, indexed by pairs of monomials. -/
private def pairTerm (F G : MvPowerSeries (Fin 2) ℤ_[p]) (m : ℤ)
    (x : (Fin 2 →₀ ℕ) × (Fin 2 →₀ ℕ)) : ℤ_[p] :=
  MvPowerSeries.coeff x.1 F * MvPowerSeries.coeff x.2 G *
    ((T : AnnularRing p) ^ (x.1 + x.2) 0 * U ^ (x.1 + x.2) 1).coeff m

/-- The double series `∑_{a, b} a_a b_b (T ^ (a + b)₀ U ^ (a + b)₁)_m` converges. -/
private theorem summable_pairTerm (F G : MvPowerSeries (Fin 2) ℤ_[p]) (m : ℤ) :
    Summable (pairTerm F G m) :=
  NonarchimedeanAddGroup.summable_of_tendsto_cofinite_zero <| tendsto_zero_of_norm_le_zpow one_lt_p
    (fun x ↦ norm_mul_coeff_T_pow_mul_U_pow_le _ (x.1 + x.2) m) <|
    tendsto_atBot.2 fun N ↦ eventually_cofinite.2 <|
      ((finite_setOf_apply_le (m - N).toNat (-N).toNat).prod
        (finite_setOf_apply_le (m - N).toNat (-N).toNat)).subset fun x hx ↦ by
        simp only [Set.mem_ofPred_eq, not_le, lt_min_iff, Finsupp.add_apply, Nat.cast_add] at hx
        simp only [Set.mem_prod, Set.mem_ofPred_eq]
        omega

/-- The coefficients of the image of a product, as a sum over pairs of monomials. -/
private theorem coeff_toFun_mul (F G : MvPowerSeries (Fin 2) ℤ_[p]) (m : ℤ) :
    (toFun (F * G)).coeff m = ∑' x, pairTerm F G m x := by
  classical
  let e := Finset.HasAntidiagonal.sigmaAntidiagonalEquivProd (A := Fin 2 →₀ ℕ)
  have hs : Summable fun c ↦ pairTerm F G m (e c) := e.summable_iff.2 (summable_pairTerm F G m)
  rw [← e.tsum_eq, hs.tsum_sigma' fun n ↦ (hasSum_fintype _).summable, coeff_toFun]
  refine tsum_congr fun n ↦ ?_
  rw [tsum_fintype, MvPowerSeries.coeff_mul, Finset.sum_mul, ← Finset.sum_finset_coe]
  refine Finset.sum_congr rfl fun x _ ↦ ?_
  simp only [pairTerm, e, Finset.HasAntidiagonal.sigmaAntidiagonalEquivProd_apply,
    Finset.mem_antidiagonal.1 x.property]

/-- The term `a_a (T ^ a₀ U ^ a₁)_i b_b (T ^ b₀ U ^ b₁)_{m - i}` of the coefficient of `T ^ m` in
a product of images. -/
private def tripleTerm (F G : MvPowerSeries (Fin 2) ℤ_[p]) (m : ℤ)
    (y : ℤ × (Fin 2 →₀ ℕ) × (Fin 2 →₀ ℕ)) : ℤ_[p] :=
  MvPowerSeries.coeff y.2.1 F * ((T : AnnularRing p) ^ y.2.1 0 * U ^ y.2.1 1).coeff y.1 *
    (MvPowerSeries.coeff y.2.2 G * ((T : AnnularRing p) ^ y.2.2 0 * U ^ y.2.2 1).coeff (m - y.1))

private theorem summable_tripleTerm (F G : MvPowerSeries (Fin 2) ℤ_[p]) (m : ℤ) :
    Summable (tripleTerm F G m) := by
  refine NonarchimedeanAddGroup.summable_of_tendsto_cofinite_zero <|
    tendsto_zero_of_norm_le_zpow (g := fun y : ℤ × (Fin 2 →₀ ℕ) × (Fin 2 →₀ ℕ) ↦
      min (y.1 - y.2.1 0) (-(y.2.1 1 : ℤ)) + min (m - y.1 - y.2.2 0) (-(y.2.2 1 : ℤ)))
      (one_lt_p (p := p)) (fun y ↦ ?_) ?_
  · rw [zpow_add₀ (zero_lt_one.trans one_lt_p).ne']
    exact (norm_mul_le _ _).trans (mul_le_mul (norm_mul_coeff_T_pow_mul_U_pow_le _ _ _)
      (norm_mul_coeff_T_pow_mul_U_pow_le _ _ _) (norm_nonneg _) (zpow_nonneg (Nat.cast_nonneg _) _))
  · -- Both summands of the exponent are nonpositive, so if it exceeds `N` each of them does,
    -- which bounds `i` and the four exponents of `(a, b)`.
    refine tendsto_atBot.2 fun N ↦ eventually_cofinite.2 <|
      ((Set.finite_Icc N (m - N)).prod ((finite_setOf_apply_le (m - 2 * N).toNat (-N).toNat).prod
        (finite_setOf_apply_le (m - 2 * N).toNat (-N).toNat))).subset fun y hy ↦ ?_
    simp only [Set.mem_ofPred_eq, not_le] at hy
    simp only [Set.mem_prod, Set.mem_Icc, Set.mem_ofPred_eq]
    omega

/-- The coefficients of a product of images, as a sum over pairs of monomials. -/
private theorem coeff_toFun_mul_toFun (F G : MvPowerSeries (Fin 2) ℤ_[p]) (m : ℤ) :
    (toFun F * toFun G).coeff m = ∑' x, pairTerm F G m x := by
  have hs : Summable (Function.uncurry fun i x ↦ tripleTerm F G m (i, x)) :=
    summable_tripleTerm F G m
  calc (toFun F * toFun G).coeff m
      = ∑' (i : ℤ) (x : (Fin 2 →₀ ℕ) × (Fin 2 →₀ ℕ)), tripleTerm F G m (i, x) := by
        rw [AnnularRing.coeff_mul]
        exact tsum_congr fun i ↦ (summable_coeff_mul_coeff_T_pow_mul_U_pow F i).tsum_mul_tsum
          (summable_coeff_mul_coeff_T_pow_mul_U_pow G (m - i))
          ((summable_tripleTerm F G m).prod_factor i)
    _ = ∑' (x : (Fin 2 →₀ ℕ) × (Fin 2 →₀ ℕ)) (i : ℤ), tripleTerm F G m (i, x) :=
        hs.tsum_comm.symm
    _ = ∑' x, pairTerm F G m x := tsum_congr fun x ↦ by
        rw [pairTerm, T_pow_mul_U_pow_add, AnnularRing.coeff_mul,
          ← (summable_coeff_mul_coeff _ _ m).tsum_mul_left]
        exact tsum_congr fun i ↦ by simp only [tripleTerm]; ring

private theorem toFun_mul (F G : MvPowerSeries (Fin 2) ℤ_[p]) :
    toFun (F * G) = toFun F * toFun G := by
  ext m : 2
  rw [coeff_toFun_mul, coeff_toFun_mul_toFun]

/-- **The comparison map `ℤ_p⟦T, U⟧ → H`**, sending `T` to `T` and `U` to `U = p / T`. The image
of `∑ a_(i,j) T ^ i U ^ j` has normal-form coefficients `d_m = ∑_{i - j = m} a_(i,j) p ^ j`
(`TauCeti.AnnularRing.coeff_ofMvPowerSeries`). -/
def ofMvPowerSeries : MvPowerSeries (Fin 2) ℤ_[p] →ₐ[ℤ_[p]] AnnularRing p where
  toFun := toFun
  map_one' := by
    simpa [monomial_zero_eq_C_apply] using toFun_monomial (p := p) 0 1
  map_mul' := toFun_mul
  map_zero' := by simpa using toFun_smul 0 0
  map_add' := toFun_add
  commutes' c := by
    simpa [algebraMap_apply, monomial_zero_eq_C_apply, Algebra.smul_def] using
      toFun_monomial (p := p) 0 c

private theorem ofMvPowerSeries_apply (F : MvPowerSeries (Fin 2) ℤ_[p]) :
    ofMvPowerSeries F = toFun F :=
  (rfl)

/-- The image of `∑ a_n T ^ n₀ U ^ n₁` is the convergent sum of the images of its monomials,
coefficientwise. -/
theorem hasSum_coeff_ofMvPowerSeries (F : MvPowerSeries (Fin 2) ℤ_[p]) (m : ℤ) :
    HasSum (fun n : Fin 2 →₀ ℕ ↦
        MvPowerSeries.coeff n F * ((T : AnnularRing p) ^ n 0 * U ^ n 1).coeff m)
      ((ofMvPowerSeries F).coeff m) :=
  (summable_coeff_mul_coeff_T_pow_mul_U_pow F m).hasSum

/-- The monomial `c T ^ n₀ U ^ n₁` goes to `c T ^ n₀ U ^ n₁`. -/
@[simp] theorem ofMvPowerSeries_monomial (n : Fin 2 →₀ ℕ) (c : ℤ_[p]) :
    ofMvPowerSeries (monomial n c) = c • ((T : AnnularRing p) ^ n 0 * U ^ n 1) :=
  toFun_monomial n c

@[simp] theorem ofMvPowerSeries_X_zero :
    ofMvPowerSeries (X 0 : MvPowerSeries (Fin 2) ℤ_[p]) = T := by
  simp [X_def]

@[simp] theorem ofMvPowerSeries_X_one :
    ofMvPowerSeries (X 1 : MvPowerSeries (Fin 2) ℤ_[p]) = U := by
  simp [X_def]

@[simp] theorem ofMvPowerSeries_C (c : ℤ_[p]) :
    ofMvPowerSeries (C c : MvPowerSeries (Fin 2) ℤ_[p]) = algebraMap ℤ_[p] (AnnularRing p) c :=
  ofMvPowerSeries.commutes c

/-! ### Diagonal sums -/

/-- The diagonal step `(1, 1)`, the exponent of `TU`. -/
private abbrev diag : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1

/-- The weighted diagonal sum `∑_l p ^ l a_{n + l(1,1)}` from the monomial `n`. -/
private def diagSum (F : MvPowerSeries (Fin 2) ℤ_[p]) (n : Fin 2 →₀ ℕ) : ℤ_[p] :=
  ∑' l : ℕ, (p : ℤ_[p]) ^ l * MvPowerSeries.coeff (n + l • diag) F

private theorem diagSum_eq_add (F : MvPowerSeries (Fin 2) ℤ_[p]) (n : Fin 2 →₀ ℕ) :
    diagSum F n = MvPowerSeries.coeff n F + p * diagSum F (n + diag) := by
  rw [diagSum, (PadicInt.summable_pow_mul _).tsum_eq_zero_add, diagSum,
    ← (PadicInt.summable_pow_mul _).tsum_mul_left]
  simp only [pow_zero, zero_smul, add_zero, one_mul, pow_succ', mul_assoc, succ_nsmul',
    add_assoc]

/-- On a diagonal starting at `n`, with `n₀ = 0` or `n₁ = 0`, the coefficient of the image is
`p ^ n₁` times the weighted diagonal sum. -/
private theorem coeff_toFun_eq_pow_mul_diagSum (F : MvPowerSeries (Fin 2) ℤ_[p])
    {n : Fin 2 →₀ ℕ} (hn : n 0 = 0 ∨ n 1 = 0) {m : ℤ} (hm : m = n 0 - n 1) :
    (toFun F).coeff m = (p : ℤ_[p]) ^ n 1 * diagSum F n := by
  have hinj : Function.Injective fun l : ℕ ↦ n + l • diag := fun l l' h ↦ by
    simpa using congr_arg (· 0) h
  rw [coeff_toFun, ← hinj.tsum_eq, diagSum,
    ← (PadicInt.summable_pow_mul _).tsum_mul_left]
  · refine tsum_congr fun l ↦ ?_
    simp only [coeff_T_pow_mul_U_pow, Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul,
      Finsupp.add_apply, Finsupp.single_apply]
    rw [ite_eq_left (by simp; omega)]
    simp only [Fin.isValue, ↓reduceIte, mul_one, zero_ne_one, zero_add, pow_add]
    ring
  · intro k hk
    have hk_sub := eq_sub_of_coeff_T_pow_mul_U_pow_ne_zero (right_ne_zero_of_mul hk)
    refine ⟨min (k 0) (k 1), Finsupp.finTwoSubMinEquiv.injective ?_⟩
    simp [diag]; omega

/-- The coefficient of `T ^ m` in the image of `∑ a_(i,j) T ^ i U ^ j` is
`d_m = ∑_{i - j = m} a_(i,j) p ^ j`, the diagonal `i - j = m` being parametrised as
`(m⁺ + j, m⁻ + j)`. -/
theorem coeff_ofMvPowerSeries (F : MvPowerSeries (Fin 2) ℤ_[p]) (m : ℤ) :
    (ofMvPowerSeries F).coeff m = ∑' j : ℕ, (p : ℤ_[p]) ^ ((-m).toNat + j) *
      MvPowerSeries.coeff (Finsupp.finTwoSubMinEquiv.symm (m, j)) F := by
  rw [ofMvPowerSeries_apply,
    coeff_toFun_eq_pow_mul_diagSum F (n := Finsupp.finTwoSubMinEquiv.symm (m, 0))
      (by simp; omega) (by simp), diagSum,
    ← (PadicInt.summable_pow_mul _).tsum_mul_left]
  refine tsum_congr fun j ↦ ?_
  have hidx : Finsupp.finTwoSubMinEquiv.symm (m, 0) + j • diag =
      Finsupp.finTwoSubMinEquiv.symm (m, j) :=
    Finsupp.finTwoSubMinEquiv.injective (by simp [diag]; omega)
  rw [hidx, pow_add, mul_assoc]
  simp

/-! ### Surjectivity -/

/-- The series `f(T) + U g(U)` lifting the normal form `(f, g)` of `x`. -/
private def lift (x : AnnularRing p) : MvPowerSeries (Fin 2) ℤ_[p] := fun n ↦
  if n 1 = 0 then PowerSeries.coeff (n 0) (normalForm.symm x).1
  else if n 0 = 0 then PowerSeries.coeff (n 1 - 1) (normalForm.symm x).2 else 0

private theorem coeff_lift (x : AnnularRing p) (n : Fin 2 →₀ ℕ) :
    MvPowerSeries.coeff n (lift x) = if n 1 = 0 then PowerSeries.coeff (n 0) (normalForm.symm x).1
      else if n 0 = 0 then PowerSeries.coeff (n 1 - 1) (normalForm.symm x).2 else 0 :=
  (rfl)

/-- Off the axes the lift has no terms, so its weighted diagonal sums reduce to their first
term. -/
private theorem diagSum_lift (x : AnnularRing p) (n : Fin 2 →₀ ℕ) :
    diagSum (lift x) n = MvPowerSeries.coeff n (lift x) := by
  rw [diagSum, tsum_eq_single 0 fun l hl ↦ ?_]
  · simp
  · rw [coeff_lift, ite_eq_right (by simp; omega), ite_eq_right (by simp; omega), mul_zero]

/-- Every element of `H` is the image of a series: `f(T) + U g(U)` for its normal form
`(f, g)`. -/
theorem ofMvPowerSeries_surjective :
    Function.Surjective (ofMvPowerSeries : MvPowerSeries (Fin 2) ℤ_[p] → AnnularRing p) := by
  intro x
  refine ⟨lift x, AnnularRing.ext (funext fun m ↦ ?_)⟩
  rw [ofMvPowerSeries_apply]
  cases m with
  | ofNat k =>
    rw [coeff_toFun_eq_pow_mul_diagSum _ (n := Finsupp.single 0 k) (by simp) (by simp),
      diagSum_lift, coeff_lift]
    simp
  | negSucc k =>
    rw [coeff_toFun_eq_pow_mul_diagSum _ (n := Finsupp.single 1 (k + 1)) (by simp)
      (by simp [Int.negSucc_eq]), diagSum_lift, coeff_lift, Int.negSucc_eq]
    simpa using pow_mul_coeff_normalForm_symm_snd x k

/-! ### The kernel -/

/-- The quotient of a series in the kernel by `TU - p`: the diagonal tails
`q_n = ∑_l p ^ l a_{n + (l+1)(1,1)}`. -/
private def divTUSubP (F : MvPowerSeries (Fin 2) ℤ_[p]) : MvPowerSeries (Fin 2) ℤ_[p] :=
  fun n ↦ diagSum F (n + diag)

private theorem coeff_divTUSubP (F : MvPowerSeries (Fin 2) ℤ_[p]) (n : Fin 2 →₀ ℕ) :
    MvPowerSeries.coeff n (divTUSubP F) = diagSum F (n + diag) :=
  (rfl)

private theorem X_zero_mul_X_one :
    (X 0 * X 1 : MvPowerSeries (Fin 2) ℤ_[p]) = monomial diag 1 := by
  rw [X_def, X_def, monomial_mul_monomial, mul_one]

private theorem divTUSubP_mul (F : MvPowerSeries (Fin 2) ℤ_[p]) (hF : ofMvPowerSeries F = 0) :
    divTUSubP F * (X 0 * X 1 - C (p : ℤ_[p])) = F := by
  refine MvPowerSeries.ext fun n ↦ ?_
  rw [mul_sub, map_sub, X_zero_mul_X_one, MvPowerSeries.coeff_mul_monomial,
    MvPowerSeries.coeff_mul_C]
  simp only [coeff_divTUSubP, mul_one]
  split_ifs with hle
  · rw [tsub_add_cancel_of_le hle, diagSum_eq_add]
    ring
  · -- `n` starts a diagonal, along which the weighted sum of `F` vanishes.
    have hn : n 0 = 0 ∨ n 1 = 0 := by
      by_contra h
      exact hle (Finsupp.le_def.2 fun i ↦ by fin_cases i <;> simp <;> omega)
    have h := coeff_toFun_eq_pow_mul_diagSum F hn rfl
    have hp : (p : ℤ_[p]) ^ n 1 ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.2 (Fact.out : p.Prime).ne_zero)
    have hzero : diagSum F n = 0 := by
      refine (mul_eq_zero.1 ?_).resolve_left hp
      rw [← h, ← ofMvPowerSeries_apply, hF, coeff_zero]
    rw [diagSum_eq_add] at hzero
    rw [zero_sub, eq_neg_of_add_eq_zero_left hzero, mul_comm]

/-- **The presentation of the annular ring.** The kernel of `ℤ_p⟦T, U⟧ → H` is generated by
`TU - p`. -/
theorem ker_ofMvPowerSeries :
    RingHom.ker (ofMvPowerSeries : MvPowerSeries (Fin 2) ℤ_[p] →ₐ[ℤ_[p]] AnnularRing p) =
      Ideal.span {X 0 * X 1 - C (p : ℤ_[p])} := by
  refine le_antisymm (fun F hF ↦ Ideal.mem_span_singleton'.2
    ⟨divTUSubP F, divTUSubP_mul F (RingHom.mem_ker.1 hF)⟩) (Ideal.span_le.2 ?_)
  rintro _ rfl
  simp [RingHom.mem_ker, map_natCast]

/-- **The annular ring is `ℤ_p⟦T, U⟧ / (TU - p)`**, through `T ↦ T` and `U ↦ U = p / T`. -/
def quotientEquiv :
    (MvPowerSeries (Fin 2) ℤ_[p] ⧸ Ideal.span {X 0 * X 1 - C (p : ℤ_[p])}) ≃ₐ[ℤ_[p]]
      AnnularRing p :=
  (Ideal.quotientEquivAlgOfEq ℤ_[p] ker_ofMvPowerSeries).symm.trans
    (Ideal.quotientKerAlgEquivOfSurjective ofMvPowerSeries_surjective)

@[simp] theorem quotientEquiv_mk (F : MvPowerSeries (Fin 2) ℤ_[p]) :
    quotientEquiv (Ideal.Quotient.mk _ F) = ofMvPowerSeries F := by
  rw [quotientEquiv, AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_symm,
    Ideal.quotientEquivAlgOfEq_mk, Ideal.quotientKerAlgEquivOfSurjective_mk]

end TauCeti.AnnularRing
