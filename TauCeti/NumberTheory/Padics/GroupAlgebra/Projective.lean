/-!
# Projective modules over finite `p`-adic group algebras

For a finite monoid `G`, in particular a finite group, multiplication by `p` lies in the Jacobson
radical of the monoid algebra `\mathbb Z_p[G]`.  Consequently, finitely generated projective
`\mathbb Z_p[G]`-modules are determined by their reductions modulo `p`.

The radical statement is valid even when `p` divides the order of `G`: it is the case
`O = \mathbb Z_p` of `TauCeti.span_algebraMap_le_jacobson`, since `\mathbb Z_p[G]` is a
finite `\mathbb Z_p`-module. Likewise the lifting of projective `\mathbb F_p[G]`-modules is the
case of `TauCeti.exists_projective_reduction_of_projective` for coefficient reduction.

The lifting theorem is the integral part of detecting projective lattices by a field or residue
field calculation.  Uniqueness of projective covers supplies an isomorphism between the integral
projective modules; the isomorphism itself is not asserted to be unique.

Since `\mathbb Z_p[G] ⧸ (p) ≃ \mathbb F_p[G]` is finite, so is the radical quotient of
`\mathbb Z_p[G]`. Therefore `TauCeti.nonempty_linearEquiv_of_projective_of_natCard_linearMap_eq`
applies: finitely generated projective `\mathbb Z_p[G]`-modules are also determined by the numbers
of their maps to the simple `\mathbb Z_p[G]`-modules.

## Main results

* `TauCeti.span_p_le_jacobson_padicInt_monoidAlgebra`: the ideal generated by `p` is contained in
  the Jacobson radical of `\mathbb Z_p[G]`.
* `TauCeti.jacobson_padicInt_monoidAlgebra_eq_span_p`: when `p` does not divide the order of the
  finite group `G`, the Jacobson radical of `\mathbb Z_p[G]` is generated by `p`.
* `TauCeti.instFiniteQuotientJacobsonPadicIntMonoidAlgebra`: the radical quotient of
  `\mathbb Z_p[G]` is finite.
* `TauCeti.nonempty_linearEquiv_of_projective_of_reduction`: finitely generated projective
  `\mathbb Z_p[G]`-modules with isomorphic reductions modulo `p` are isomorphic.
* `TauCeti.exists_projective_reduction_bijective_of_projective`: every finitely generated
  projective `\mathbb F_p[G]`-module is the reduction of a finitely generated projective
  `\mathbb Z_p[G]`-module.

## References

See J. Neukirch, A. Schmidt and K. Wingberg, *Cohomology of Number Fields*, second edition,
Proposition (5.6.10)(iii).
-/

public section

namespace TauCeti

universe u v w

section Jacobson

variable (p : ℕ) [Fact p.Prime] (G : Type u) [Monoid G] [Finite G]

/-- In the monoid algebra of a finite monoid (for instance a finite group) over `ℤ_[p]`, the ideal
generated by `p` lies in the Jacobson radical.  No hypothesis relating `p` to the order of `G` is
needed. -/
theorem span_p_le_jacobson_padicInt_monoidAlgebra :
    Ideal.span {(p : MonoidAlgebra ℤ_[p] G)} ≤ Ring.jacobson (MonoidAlgebra ℤ_[p] G) := by
  simpa using span_algebraMap_le_jacobson (A := MonoidAlgebra ℤ_[p] G) (p : ℤ_[p])

/-- **The radical quotient of `ℤ_p[G]` is finite** for a finite monoid `G`. The ideal generated by
`p` lies in the Jacobson radical, and `ℤ_p[G] ⧸ (p) ≃ 𝔽_p[G]` is finite. -/
instance instFiniteQuotientJacobsonPadicIntMonoidAlgebra :
    Finite (MonoidAlgebra ℤ_[p] G ⧸ Ring.jacobson (MonoidAlgebra ℤ_[p] G)) := by
  -- Reduce coefficients modulo `p`: the kernel `p • ℤ_p[G]` lies in the radical, and the
  -- target `𝔽_p[G]` is finite.
  let π := MonoidAlgebra.mapRingHom G (PadicInt.toZMod (p := p))
  have hker : RingHom.ker π ≤ Ring.jacobson (MonoidAlgebra ℤ_[p] G) := by
    rw [ker_padicMonoidAlgebraReduction p G]
    exact span_p_le_jacobson_padicInt_monoidAlgebra p G
  have : Finite (MonoidAlgebra ℤ_[p] G ⧸ RingHom.ker π) :=
    Finite.of_equiv _ (padicMonoidAlgebraQuotientEquiv p G).symm.toEquiv
  exact Finite.of_surjective _ (Ideal.Quotient.factor_surjective hker)

/-- **The Jacobson radical of `ℤ_p[G]` for `p ∤ |G|`.** When the order of the finite group `G` is
prime to `p`, the Jacobson radical of `ℤ_p[G]` is generated by `p`: it contains `p` for every
finite monoid, and conversely the reduction `ℤ_p[G] ⧸ (p) ≃ 𝔽_p[G]` is a semisimple ring by
Maschke's theorem, so it has zero radical. -/
theorem jacobson_padicInt_monoidAlgebra_eq_span_p {G : Type u} [Group G] [Finite G]
    (hG : ¬p ∣ Nat.card G) :
    Ring.jacobson (MonoidAlgebra ℤ_[p] G) = Ideal.span {(p : MonoidAlgebra ℤ_[p] G)} := by
  refine le_antisymm ?_ (span_p_le_jacobson_padicInt_monoidAlgebra p G)
  -- The radical lies in the kernel of the reduction `π : ℤ_p[G] → 𝔽_p[G]`, whose target is
  -- semisimple, and that kernel consists of the multiples of `p`.
  let π := MonoidAlgebra.mapRingHom G (PadicInt.toZMod (p := p))
  have : RingHomSurjective π := ⟨padicMonoidAlgebraReduction_surjective p G⟩
  have : NeZero (Nat.card G : ZMod p) := ⟨fun h ↦ hG ((ZMod.natCast_eq_zero_iff _ _).mp h)⟩
  intro x hx
  have hx : π x = 0 := by
    simpa [IsSemisimpleRing.jacobson_eq_bot] using Ring.le_comap_jacobson π hx
  rwa [← RingHom.mem_ker, ker_padicMonoidAlgebraReduction] at hx

end Jacobson

section Reduction

variable (p : ℕ) [Fact p.Prime] (G : Type u) [Monoid G] [Finite G]

/-- **Projectives over `ℤ_p[G]` are detected modulo `p`** (NSW (5.6.10)(iii)). Two finitely
generated projective modules over the monoid algebra of a finite monoid (in particular the group
algebra of a finite group) are isomorphic when their reductions modulo `p` are isomorphic. -/
theorem nonempty_linearEquiv_of_projective_of_reduction
    (M : Type v) (N : Type w) [AddCommGroup M] [Module (MonoidAlgebra ℤ_[p] G) M]
    [Module.Finite (MonoidAlgebra ℤ_[p] G) M]
    [Module.Projective (MonoidAlgebra ℤ_[p] G) M]
    [AddCommGroup N] [Module (MonoidAlgebra ℤ_[p] G) N]
    [Module.Finite (MonoidAlgebra ℤ_[p] G) N]
    [Module.Projective (MonoidAlgebra ℤ_[p] G) N]
    (h : Nonempty
      ((M ⧸ (Ideal.span {(p : MonoidAlgebra ℤ_[p] G)} •
            (⊤ : Submodule (MonoidAlgebra ℤ_[p] G) M)))
        ≃ₗ[MonoidAlgebra ℤ_[p] G]
        (N ⧸ (Ideal.span {(p : MonoidAlgebra ℤ_[p] G)} •
            (⊤ : Submodule (MonoidAlgebra ℤ_[p] G) N))))) :
    Nonempty (M ≃ₗ[MonoidAlgebra ℤ_[p] G] N) :=
  Ideal.nonempty_linearEquiv_of_quotient_smul_top
    (Ideal.span {(p : MonoidAlgebra ℤ_[p] G)}) M N
    (span_p_le_jacobson_padicInt_monoidAlgebra p G) h

/-- **Projective `𝔽_p[G]`-modules lift to `ℤ_p[G]`.** Every finitely generated projective module
`Y` over the monoid algebra `𝔽_p[G]` of a finite monoid (in particular the group algebra of a
finite group) is the reduction modulo `p` of a finitely generated projective `ℤ_p[G]`-module `X`:
there is a bijection `X ⧸ p • X → Y` which is semilinear along the coefficient reduction
`ℤ_p[G] → 𝔽_p[G]`. The module `X` is realised as a submodule of some `ℤ_p[G]ⁿ`, and it is unique
up to isomorphism by `TauCeti.nonempty_linearEquiv_of_projective_of_reduction`. -/
theorem exists_projective_reduction_bijective_of_projective (Y : Type v) [AddCommGroup Y]
    [Module (MonoidAlgebra (ZMod p) G) Y] [Module.Finite (MonoidAlgebra (ZMod p) G) Y]
    [Module.Projective (MonoidAlgebra (ZMod p) G) Y] :
    ∃ (n : ℕ) (X : Submodule (MonoidAlgebra ℤ_[p] G) (Fin n → MonoidAlgebra ℤ_[p] G)),
      Module.Finite (MonoidAlgebra ℤ_[p] G) X ∧ Module.Projective (MonoidAlgebra ℤ_[p] G) X ∧
      ∃ f : (X ⧸ Ideal.span {(p : MonoidAlgebra ℤ_[p] G)} •
          (⊤ : Submodule (MonoidAlgebra ℤ_[p] G) X)) →ₛₗ[MonoidAlgebra.mapRingHom G
            (PadicInt.toZMod (p := p))] Y,
        Function.Bijective f := by
  have hker := ker_padicMonoidAlgebraReduction p G
  rw [← map_natCast (algebraMap ℤ_[p] (MonoidAlgebra ℤ_[p] G)) p] at hker
  -- The general lift is a surjection with kernel `p • X`; it factors through `X ⧸ p • X`.
  obtain ⟨n, X, hXf, hXp, f, hf, hfker⟩ := exists_projective_reduction_of_projective (Y := Y)
    (padicMonoidAlgebraReduction_surjective p G) (p : ℤ_[p]) hker
  have hk : Ideal.span {(p : MonoidAlgebra ℤ_[p] G)} •
      (⊤ : Submodule (MonoidAlgebra ℤ_[p] G) X) = LinearMap.ker f := by
    ext x
    rw [LinearMap.mem_ker, hfker, hker, map_natCast]
  refine ⟨n, X, hXf, hXp, Submodule.liftQ _ f hk.le,
    LinearMap.ker_eq_bot.mp (Submodule.ker_liftQ_eq_bot _ _ hk.le hk.ge), fun y ↦ ?_⟩
  obtain ⟨x, rfl⟩ := hf y
  exact ⟨Submodule.Quotient.mk x, rfl⟩

end Reduction

end TauCeti
