/-!
# Projective modules over finite `p`-adic group algebras

For a finite monoid `G`, in particular a finite group, multiplication by `p` lies in the Jacobson
radical of the monoid algebra `\mathbb Z_p[G]`.  Consequently, finitely generated projective
`\mathbb Z_p[G]`-modules are determined by their reductions modulo `p`.

The radical statement is valid even when `p` divides the order of `G`.  To prove it, represent
left multiplication on the finite free `\mathbb Z_p`-module `\mathbb Z_p[G]` by a matrix.  Every
entry of the matrix of multiplication by `p x` is topologically nilpotent, so the matrix of
`1 - p x` is invertible.  Faithfulness of the left regular representation then gives invertibility
in the group algebra itself.

The lifting theorem is the integral part of detecting projective lattices by a field or residue
field calculation.  Uniqueness of projective covers supplies an isomorphism between the integral
projective modules; the isomorphism itself is not asserted to be unique.

## Main results

* `TauCeti.span_p_le_jacobson_padicInt_monoidAlgebra`: the ideal generated by `p` is contained in
  the Jacobson radical of `\mathbb Z_p[G]`.
* `TauCeti.nonempty_linearEquiv_of_projective_of_reduction`: finitely generated projective
  `\mathbb Z_p[G]`-modules with isomorphic reductions modulo `p` are isomorphic.

## References

See J. Neukirch, A. Schmidt and K. Wingberg, *Cohomology of Number Fields*, second edition,
Proposition (5.6.10)(iii).
-/

public section

namespace TauCeti

universe u v w

section Jacobson

private theorem isUnit_one_add_mul_padicInt_monoidAlgebra
    (p : ℕ) [Fact p.Prime] (G : Type u) [Monoid G] [Finite G]
    (y : MonoidAlgebra ℤ_[p] G) :
    IsUnit (1 + y * (p : MonoidAlgebra ℤ_[p] G)) := by
  classical
  let _ := Fintype.ofFinite G
  have hp : IsTopologicallyNilpotent (p : ℤ_[p]) :=
    Huber.PadicInt.isTopologicallyNilpotent_iff_dvd.mpr dvd_rfl
  let b := MonoidAlgebra.basis G ℤ_[p]
  let B := -Algebra.leftMulMatrix b ((p : MonoidAlgebra ℤ_[p] G) * y)
  have hmatrix_p : Algebra.leftMulMatrix b ((p : MonoidAlgebra ℤ_[p] G) * y) =
      (p : ℤ_[p]) • Algebra.leftMulMatrix b y := by
    rw [← map_natCast (algebraMap ℤ_[p] (MonoidAlgebra ℤ_[p] G)) p,
      ← Algebra.smul_def, map_smul]
  have hentries : ∀ i j, IsTopologicallyNilpotent (B i j) := by
    intro i j
    have hentry : B i j = (p : ℤ_[p]) * (-(Algebra.leftMulMatrix b y i j)) := by
      simp only [B, hmatrix_p, Matrix.neg_apply, Matrix.smul_apply, smul_eq_mul, mul_neg]
    rw [hentry]
    exact hp.mul_right _
  have hmatrix : IsUnit (Algebra.leftMulMatrix b
      (1 + y * (p : MonoidAlgebra ℤ_[p] G))) := by
    have hunit := Huber.isUnit_one_sub_of_isTopologicallyNilpotent_entries hentries
    simpa only [B, map_add, map_one, sub_neg_eq_add, Nat.cast_comm] using hunit
  have hlmul : IsUnit (Algebra.lmul ℤ_[p] (MonoidAlgebra ℤ_[p] G)
      (1 + y * (p : MonoidAlgebra ℤ_[p] G))) := by
    apply (LinearMap.isUnit_toMatrix_iff (v₁ := b)).mp
    simpa only [Algebra.leftMulMatrix_apply] using hmatrix
  exact Algebra.lmul_isUnit_iff.mp hlmul

variable (p : ℕ) [Fact p.Prime] (G : Type u) [Monoid G] [Finite G]

/-- In the monoid algebra of a finite monoid (for instance a finite group) over `ℤ_[p]`, the ideal
generated by `p` lies in the Jacobson radical.  No hypothesis relating `p` to the order of `G` is
needed. -/
theorem span_p_le_jacobson_padicInt_monoidAlgebra :
    Ideal.span {(p : MonoidAlgebra ℤ_[p] G)} ≤ Ring.jacobson (MonoidAlgebra ℤ_[p] G) := by
  classical
  let _ := Fintype.ofFinite G
  rw [Ideal.span_le]
  rintro x (rfl : x = (p : MonoidAlgebra ℤ_[p] G))
  exact Ring.mem_jacobson_iff_isUnit_one_add_mul_left.mpr fun y ↦
    isUnit_one_add_mul_padicInt_monoidAlgebra p G y

end Jacobson

section Reduction

variable (p : ℕ) [Fact p.Prime] (G : Type u) [Monoid G] [Finite G]

/-- **Projectives over `ℤ_p[G]` are detected modulo `p`** (NSW (5.6.10)(iii)). Two finitely
generated projective modules over the monoid algebra of a finite monoid (in particular the group
algebra of a finite group) are isomorphic when their reductions modulo `p` are isomorphic. -/
theorem nonempty_linearEquiv_of_projective_of_reduction
    (M : Type v) (N : Type w) [AddCommGroup M] [Module (MonoidAlgebra ℤ_[p] G) M]
    [Module.Finite (MonoidAlgebra ℤ_[p] G) M]
    [Module.Projective (MonoidAlgebra ℤ_[p] G) M]
    [AddCommGroup N] [Module (MonoidAlgebra ℤ_[p] G) N]
    [Module.Finite (MonoidAlgebra ℤ_[p] G) N]
    [Module.Projective (MonoidAlgebra ℤ_[p] G) N]
    (h : Nonempty
      ((M ⧸ (Ideal.span {(p : MonoidAlgebra ℤ_[p] G)} •
            (⊤ : Submodule (MonoidAlgebra ℤ_[p] G) M)))
        ≃ₗ[MonoidAlgebra ℤ_[p] G]
        (N ⧸ (Ideal.span {(p : MonoidAlgebra ℤ_[p] G)} •
            (⊤ : Submodule (MonoidAlgebra ℤ_[p] G) N))))) :
    Nonempty (M ≃ₗ[MonoidAlgebra ℤ_[p] G] N) :=
  Ideal.nonempty_linearEquiv_of_quotient_smul_top
    (Ideal.span {(p : MonoidAlgebra ℤ_[p] G)}) M N
    (span_p_le_jacobson_padicInt_monoidAlgebra p G) h

end Reduction

end TauCeti
