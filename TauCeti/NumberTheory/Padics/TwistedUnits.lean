import TauCeti.Topology.Algebra.Group.Subgroup

/-!
# The dyadic twisted subgroups `U^[f]`

For `f ≥ 2`, Labute's **twisted subgroup** `U^[f]` of `ℤ_2ˣ` is the closed subgroup generated by
a dyadic unit `u` whose negative `-u` has exact principal-unit level `f`, the model case being
`u = -1 + 2 ^ f`. The square of the generator has principal-unit depth `f + 1`, so `U^[f]` is
`U^(f+1) ∪ u U^(f+1)`: it meets `1 + 4ℤ₂` in exactly `U^(f+1) = 1 + 2 ^ (f + 1)ℤ₂`, has index
`2 ^ (f - 1)` in `ℤ_2ˣ`, does not contain `-1`, and depends only on `f`, not on the generator.

## Main declarations

* `TauCeti.topologicalClosure_zpowers_inf_unitsPrincipal_two`: `U^[f] ⊓ U^(2) = U^(f+1)`;
  `TauCeti.mem_topologicalClosure_zpowers_two_iff`: `x ∈ U^[f] ↔ x ∈ U^(f+1) ∨ u⁻¹ x ∈ U^(f+1)`.
* `TauCeti.index_topologicalClosure_zpowers_two`: `[ℤ_2ˣ : U^[f]] = 2 ^ (f - 1)`;
  `TauCeti.neg_one_notMem_topologicalClosure_zpowers_two`: `-1 ∉ U^[f]`.
* `TauCeti.topologicalClosure_zpowers_two_eq_iff`: two twisted subgroups agree iff their levels
  do; `TauCeti.exists_val_eq_neg_one_add_two_pow`: the model generator `-1 + 2 ^ f` exists.

## References

* J. Labute, *Classification of Demushkin groups*, Canad. J. Math. 19 (1967), the remark
  following the corollary to Theorem 4.
-/

public section

namespace TauCeti

/-- For `f ≥ 2` and a dyadic unit `u` with `-u` of exact level `f`, that is `-u ∈ U^(f)` but
`-u ∉ U^(f+1)`, the even part of the closed subgroup generated by `u` is `U^(f+1)`. The shift
by one comes from the exact principal-unit depth of `u²`. -/
theorem topologicalClosure_zpowers_inf_unitsPrincipal_two {f : ℕ} (hf : 2 ≤ f) {u : ℤ_[2]ˣ}
    (hneg : -u ∈ unitsPrincipal 2 f) (hneg' : -u ∉ unitsPrincipal 2 (f + 1)) :
    (Subgroup.zpowers u).topologicalClosure ⊓ unitsPrincipal 2 2 =
      unitsPrincipal 2 (f + 1) := by
  have hsq : (-u) ^ 2 = u ^ 2 := by
    apply Units.ext
    simp
  have hsqmem : u ^ 2 ∈ unitsPrincipal 2 (f + 1) := by
    simpa only [pow_one, hsq] using pow_pow_mem_unitsPrincipal (by omega) hneg 1
  have hsqnot : u ^ 2 ∉ unitsPrincipal 2 (f + 1 + 1) := by
    simpa only [pow_one, hsq] using
      pow_pow_notMem_unitsPrincipal (by omega) (fun _ ↦ hf) hneg hneg' 1
  have hclosure : (Subgroup.zpowers (u ^ 2)).topologicalClosure =
      unitsPrincipal 2 (f + 1) :=
    topologicalClosure_zpowers_eq_unitsPrincipal (by omega) (fun _ ↦ by omega) hsqmem hsqnot
  have hle : unitsPrincipal 2 (f + 1) ≤ unitsPrincipal 2 2 :=
    unitsPrincipal_antitone 2 (by omega)
  -- `u ∉ 1 + 4ℤ₂`, since otherwise `-1 = (-u) * u⁻¹ ∈ 1 + 4ℤ₂`
  have hunot : u ∉ unitsPrincipal 2 2 := by
    intro hmem
    have h := (unitsPrincipal 2 2).mul_mem (unitsPrincipal_antitone 2 hf hneg)
      ((unitsPrincipal 2 2).inv_mem hmem)
    rw [neg_mul, mul_inv_cancel, mem_unitsPrincipal_iff, Units.val_neg, Units.val_one,
      show (-1 : ℤ_[2]) - 1 = -(2 : ℤ_[2]) ^ 1 by norm_num, dvd_neg, Nat.cast_ofNat,
      pow_dvd_pow_iff (by norm_num : (2 : ℤ_[2]) ≠ 0) PadicInt.p_nonunit] at h
    omega
  refine le_antisymm ?_ (le_inf ?_ hle)
  · intro x hx
    rcases mem_or_inv_mul_mem_of_mem_topologicalClosure_zpowers u
      (unitsPrincipal 2 (f + 1)) (isClosed_unitsPrincipal 2 (f + 1)) hsqmem hx.1 with h | h
    · exact h
    · exact (hunot (by
        simpa using (unitsPrincipal 2 2).mul_mem hx.2
          ((unitsPrincipal 2 2).inv_mem (hle h)))).elim
  · rw [← hclosure]
    exact Subgroup.topologicalClosure_mono
      (Subgroup.zpowers_le.mpr (Subgroup.npow_mem_zpowers u 2))

/-- `U^(f+1) ≤ U^[f]`: the even part of the twisted subgroup. -/
theorem unitsPrincipal_succ_le_topologicalClosure_zpowers_two {f : ℕ} (hf : 2 ≤ f) {u : ℤ_[2]ˣ}
    (hneg : -u ∈ unitsPrincipal 2 f) (hneg' : -u ∉ unitsPrincipal 2 (f + 1)) :
    unitsPrincipal 2 (f + 1) ≤ (Subgroup.zpowers u).topologicalClosure :=
  (topologicalClosure_zpowers_inf_unitsPrincipal_two hf hneg hneg').symm.le.trans inf_le_left

/-- Membership in the twisted subgroup: for `f ≥ 2` and `-u` of exact level `f`, the closed
subgroup generated by `u` is `U^(f+1) ∪ u U^(f+1)`. -/
theorem mem_topologicalClosure_zpowers_two_iff {f : ℕ} (hf : 2 ≤ f) {u : ℤ_[2]ˣ}
    (hneg : -u ∈ unitsPrincipal 2 f) (hneg' : -u ∉ unitsPrincipal 2 (f + 1)) {x : ℤ_[2]ˣ} :
    x ∈ (Subgroup.zpowers u).topologicalClosure ↔
      x ∈ unitsPrincipal 2 (f + 1) ∨ u⁻¹ * x ∈ unitsPrincipal 2 (f + 1) := by
  have hle := unitsPrincipal_succ_le_topologicalClosure_zpowers_two hf hneg hneg'
  refine ⟨fun hx ↦ mem_or_inv_mul_mem_of_mem_topologicalClosure_zpowers u _
    (isClosed_unitsPrincipal 2 (f + 1)) ?_ hx, ?_⟩
  · simpa only [pow_one, neg_sq] using pow_pow_mem_unitsPrincipal (by omega) hneg 1
  · rintro (hx | hx)
    · exact hle hx
    · have := Subgroup.mul_mem _ (Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers u))
        (hle hx)
      rwa [mul_inv_cancel_left] at this

/-- `-1 ∉ U^[f]`: unlike `{±1} × U^(f+1)`, the twisted subgroup does not contain `-1`. -/
theorem neg_one_notMem_topologicalClosure_zpowers_two {f : ℕ} (hf : 2 ≤ f) {u : ℤ_[2]ˣ}
    (hneg : -u ∈ unitsPrincipal 2 f) (hneg' : -u ∉ unitsPrincipal 2 (f + 1)) :
    (-1 : ℤ_[2]ˣ) ∉ (Subgroup.zpowers u).topologicalClosure := by
  rw [mem_topologicalClosure_zpowers_two_iff hf hneg hneg', neg_one_mem_unitsPrincipal_two_iff,
    mul_neg_one, ← inv_neg, Subgroup.inv_mem_iff]
  exact fun h ↦ h.elim (fun h ↦ by omega) hneg'

/-- `[ℤ_2ˣ : U^[f]] = 2 ^ (f - 1)`: the twisted subgroup contains `U^(f+1)` with index `2`. -/
theorem index_topologicalClosure_zpowers_two {f : ℕ} (hf : 2 ≤ f) {u : ℤ_[2]ˣ}
    (hneg : -u ∈ unitsPrincipal 2 f) (hneg' : -u ∉ unitsPrincipal 2 (f + 1)) :
    (Subgroup.zpowers u).topologicalClosure.index = 2 ^ (f - 1) := by
  have hle := unitsPrincipal_succ_le_topologicalClosure_zpowers_two hf hneg hneg'
  have h2 : (unitsPrincipal 2 (f + 1)).relIndex (Subgroup.zpowers u).topologicalClosure = 2 := by
    refine Subgroup.relIndex_eq_two_iff_exists_notMem_and'.mpr ⟨u⁻¹, Subgroup.inv_mem _
      (Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers u)), fun h ↦ ?_, fun b hb ↦ ?_⟩
    · exact notMem_unitsPrincipal_two_of_neg_mem hf hneg
        (unitsPrincipal_antitone 2 (Nat.le_succ f) ((Subgroup.inv_mem_iff _).mp h))
    · exact ((mem_topologicalClosure_zpowers_two_iff hf hneg hneg').mp hb).symm
  have := Subgroup.relIndex_mul_index hle
  rw [h2, index_unitsPrincipal_two, Nat.add_sub_cancel] at this
  -- `2 * [ℤ_2ˣ : U^[f]] = 2 ^ f = 2 * 2 ^ (f - 1)`
  refine Nat.eq_of_mul_eq_mul_left two_pos (this.trans ?_)
  rw [← pow_succ', Nat.sub_add_cancel (by omega : 1 ≤ f)]

/-- Two twisted subgroups agree iff their levels agree: `U^[f]` depends only on `f`, not on the
choice of generator `u` with `-u` of exact level `f`. -/
theorem topologicalClosure_zpowers_two_eq_iff {f f' : ℕ} (hf : 2 ≤ f) (hf' : 2 ≤ f')
    {u v : ℤ_[2]ˣ} (hu : -u ∈ unitsPrincipal 2 f) (hu' : -u ∉ unitsPrincipal 2 (f + 1))
    (hv : -v ∈ unitsPrincipal 2 f') (hv' : -v ∉ unitsPrincipal 2 (f' + 1)) :
    (Subgroup.zpowers u).topologicalClosure = (Subgroup.zpowers v).topologicalClosure ↔
      f = f' := by
  constructor
  · intro h
    have h' : unitsPrincipal 2 (f + 1) = unitsPrincipal 2 (f' + 1) := by
      rw [← topologicalClosure_zpowers_inf_unitsPrincipal_two hf hu hu',
        ← topologicalClosure_zpowers_inf_unitsPrincipal_two hf' hv hv', h]
    exact Nat.succ_injective ((unitsPrincipal_inj (by omega) (by omega)).mp h')
  · rintro rfl
    -- two generators of the same exact level are congruent modulo `U^(f+1)`, so each lies in
    -- the closed subgroup generated by the other
    have key {u v : ℤ_[2]ˣ} (hu : -u ∈ unitsPrincipal 2 f) (hu' : -u ∉ unitsPrincipal 2 (f + 1))
        (hv : -v ∈ unitsPrincipal 2 f) (hv' : -v ∉ unitsPrincipal 2 (f + 1)) :
        (Subgroup.zpowers u).topologicalClosure ≤ (Subgroup.zpowers v).topologicalClosure := by
      refine Subgroup.topologicalClosure_minimal _ (Subgroup.zpowers_le.mpr ?_)
        (Subgroup.isClosed_topologicalClosure _)
      rw [mem_topologicalClosure_zpowers_two_iff hf hv hv']
      have := inv_mul_mem_unitsPrincipal_two_succ (by omega) hv hv' hu hu'
      rw [inv_neg, neg_mul_neg] at this
      exact Or.inr this
    exact le_antisymm (key hu hu' hv hv') (key hv hv' hu hu')

/-! ### The model generator `-1 + 2 ^ f` -/

/-- For `(u : ℤ_[2]) = -1 + 2 ^ f`, the negative `-u = 1 - 2 ^ f` lies in `U^(f)`. -/
theorem neg_mem_unitsPrincipal_two_of_val_eq {f : ℕ} {u : ℤ_[2]ˣ}
    (hu : (u : ℤ_[2]) = -1 + (2 : ℤ_[2]) ^ f) : -u ∈ unitsPrincipal 2 f := by
  rw [mem_unitsPrincipal_iff, Units.val_neg, hu, Nat.cast_ofNat]
  exact ⟨-1, by ring⟩

/-- For `(u : ℤ_[2]) = -1 + 2 ^ f`, the negative `-u = 1 - 2 ^ f` does not lie in `U^(f+1)`: it
has exact level `f`. -/
theorem neg_notMem_unitsPrincipal_two_succ_of_val_eq {f : ℕ} {u : ℤ_[2]ˣ}
    (hu : (u : ℤ_[2]) = -1 + (2 : ℤ_[2]) ^ f) : -u ∉ unitsPrincipal 2 (f + 1) := by
  rw [mem_unitsPrincipal_iff, Units.val_neg, hu, Nat.cast_ofNat, neg_add, neg_neg,
    add_sub_cancel_left, dvd_neg, pow_dvd_pow_iff (by norm_num : (2 : ℤ_[2]) ≠ 0)
    PadicInt.p_nonunit]
  omega

/-- For `f ≥ 1`, `-1 + 2 ^ f` is a unit of `ℤ_2`, the model generator of `U^[f]`. -/
theorem exists_val_eq_neg_one_add_two_pow {f : ℕ} (hf : 1 ≤ f) :
    ∃ u : ℤ_[2]ˣ, (u : ℤ_[2]) = -1 + (2 : ℤ_[2]) ^ f := by
  have hunit : IsUnit (1 + -(2 : ℤ_[2]) ^ f) :=
    PadicInt.isUnit_one_add_of_dvd (dvd_neg.mpr (dvd_pow_self _ (by omega)))
  exact ⟨-hunit.unit, by rw [Units.val_neg, IsUnit.unit_spec]; ring⟩

/-- The model case `u = -1 + 2 ^ f` of `topologicalClosure_zpowers_inf_unitsPrincipal_two`:
here `-u = 1 - 2 ^ f` has exact level `f`. -/
theorem topologicalClosure_zpowers_inf_unitsPrincipal_two_of_val_eq {f : ℕ} (hf : 2 ≤ f)
    {u : ℤ_[2]ˣ} (hu : (u : ℤ_[2]) = -1 + (2 : ℤ_[2]) ^ f) :
    (Subgroup.zpowers u).topologicalClosure ⊓ unitsPrincipal 2 2 =
      unitsPrincipal 2 (f + 1) :=
  topologicalClosure_zpowers_inf_unitsPrincipal_two hf (neg_mem_unitsPrincipal_two_of_val_eq hu)
    (neg_notMem_unitsPrincipal_two_succ_of_val_eq hu)

end TauCeti
