module

public import Mathlib.NumberTheory.Padics.RingHoms
public import Mathlib.RingTheory.Ideal.Height
public import Mathlib.RingTheory.PowerSeries.Basic

import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.RingTheory.PowerSeries.Ideal
import TauCeti.RingTheory.PowerSeries.Ideal

/-!
# The height-one prime `(p)` of `ℤ_[p]⟦X⟧`

The ideal of `ℤ_[p]⟦X⟧` generated by `p` is the kernel of the coefficientwise reduction
`ℤ_[p]⟦X⟧ → (ℤ/pℤ)⟦X⟧`. Hence it is prime, and by Krull's principal ideal theorem it has
height one.

## Main results

* `PadicInt.ker_map_toZMod`: the kernel of `ℤ_[p]⟦X⟧ → (ℤ/pℤ)⟦X⟧` is `(p)`.
* `PadicInt.isPrime_span_C_p`: `(p)` is a prime ideal of `ℤ_[p]⟦X⟧`.
* `PadicInt.height_span_C_p`: `(p)` has height one in `ℤ_[p]⟦X⟧`.
-/

public section

namespace PadicInt

open PowerSeries

variable {p : ℕ} [Fact p.Prime]

/-- The kernel of the coefficientwise reduction `ℤ_[p]⟦X⟧ → (ℤ/pℤ)⟦X⟧` is the ideal generated by
`p`. -/
theorem ker_map_toZMod :
    RingHom.ker (map (toZMod : ℤ_[p] →+* ZMod p)) = Ideal.span {C (p : ℤ_[p])} := by
  rw [ker_map_of_fg _ (IsNoetherian.noetherian _), ker_toZMod, maximalIdeal_eq_span_p,
    Ideal.map_span, Set.image_singleton]

/-- The ideal of `ℤ_[p]⟦X⟧` generated by `p` is prime. -/
theorem isPrime_span_C_p : (Ideal.span {C (p : ℤ_[p])}).IsPrime :=
  ker_map_toZMod (p := p) ▸ RingHom.ker_isPrime _

/-- The ideal of `ℤ_[p]⟦X⟧` generated by `p` has height one. -/
theorem height_span_C_p : (Ideal.span {C (p : ℤ_[p])}).height = 1 := by
  refine Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_of_ne_zero ?_) fun hu ↦ (irreducible_p (p := p)).not_isUnit ?_
  · rw [Ne, map_eq_zero_iff _ C_injective, Nat.cast_eq_zero]
    exact (Fact.out : p.Prime).ne_zero
  · simpa using hu.map constantCoeff

end PadicInt
