module

public import Mathlib.NumberTheory.Padics.Complex
public import Mathlib.NumberTheory.Padics.LocalField
public import TauCeti.NumberTheory.LocalField.FiniteExtension.Basic

import Mathlib.Topology.Algebra.Module.FiniteDimension
import TauCeti.Analysis.Normed.Field.Krasner
import TauCeti.NumberTheory.LocalField.Padic

/-!
# Finite coefficient fields in `PadicAlgCl p`

Let `p` be a prime and `PadicAlgCl p` the algebraic closure of `ℚ_[p]`, equipped with its spectral
norm. A *coefficient field* is a finite intermediate field
`E : IntermediateField ℚ_[p] (PadicAlgCl p)`. This file establishes the topological, countable,
and local-field properties of these subfields:

* Every finite intermediate field `E` has the form `ℚ_[p]⟮β⟯` with `β` algebraic over `ℚ`
  (`PadicAlgCl.exists_isAlgebraic_adjoin_simple_eq`), by Krasner approximation and density of
  `ℚ` in `ℚ_[p]`.
* Consequently there are only countably many finite intermediate fields
  (`PadicAlgCl.countable_finiteDimensional`).
* Each finite intermediate field is closed in `PadicAlgCl p`
  (`PadicAlgCl.isClosed_of_finiteDimensional`), and their union is all of `PadicAlgCl p`
  (`PadicAlgCl.biUnion_finiteDimensional_eq_univ`).
* On every intermediate field `E`, the spectral-norm construction
  `TauCeti.algebraicExtensionNormedField ℚ_[p] E` agrees pointwise with the norm restricted from
  `PadicAlgCl p` (`PadicAlgCl.algebraicExtensionNormedField_norm_eq`), so its topology coincides
  with the subspace topology (`PadicAlgCl.algebraicExtensionNormedFieldTopology_eq`), its
  valuation ring consists of the elements of norm at most `1`
  (`PadicAlgCl.mem_integerRing_algebraicExtension_iff`), and every finite `E` is a
  nonarchimedean local field for its subspace topology
  (`PadicAlgCl.finiteIntermediateField_isNonarchimedeanLocalField`).

## Main results

* `PadicAlgCl.exists_isAlgebraic_adjoin_simple_eq`
* `PadicAlgCl.countable_finiteDimensional`
* `PadicAlgCl.isClosed_of_finiteDimensional`
* `PadicAlgCl.biUnion_finiteDimensional_eq_univ`
* `PadicAlgCl.algebraicExtensionNormedField_norm_eq`
* `PadicAlgCl.algebraicExtensionNormedFieldTopology_eq`
* `PadicAlgCl.mem_integerRing_algebraicExtension_iff`
* `PadicAlgCl.finiteIntermediateField_isNonarchimedeanLocalField`

## References

* A. M. Robert, *A Course in p-adic Analysis*, Graduate Texts in Mathematics 198, Springer, 2000,
  Chapter 3, §1.5.
* J. Neukirch, *Algebraic Number Theory*, Springer, 1999, Chapter II, §6.
-/

public section

open IntermediateField ValuativeRel

namespace PadicAlgCl

variable (p : ℕ) [Fact p.Prime]

private theorem denseRange_algebraMap_rat : DenseRange (algebraMap ℚ ℚ_[p]) := by
  have h : ⇑(algebraMap ℚ ℚ_[p]) = Rat.cast := funext (eq_ratCast _)
  rw [h]
  exact Padic.denseRange_ratCast p

/-- **Every finite subextension of `PadicAlgCl p / ℚ_[p]` is generated by an algebraic number.** -/
theorem exists_isAlgebraic_adjoin_simple_eq (E : IntermediateField ℚ_[p] (PadicAlgCl p))
    [FiniteDimensional ℚ_[p] E] :
    ∃ β : PadicAlgCl p, IsAlgebraic ℚ β ∧ ℚ_[p]⟮β⟯ = E := by
  have : Algebra.IsAlgebraic ℚ_[p] E := Algebra.IsAlgebraic.of_finite ℚ_[p] E
  exact IntermediateField.exists_isAlgebraic_adjoin_simple_eq E (denseRange_algebraMap_rat p)

/-- **`PadicAlgCl p` has only countably many finite subextensions over `ℚ_[p]`.** -/
theorem countable_finiteDimensional :
    {E : IntermediateField ℚ_[p] (PadicAlgCl p) | FiniteDimensional ℚ_[p] E}.Countable :=
  IntermediateField.countable_finiteDimensional (k := ℚ) (K := ℚ_[p]) (L := PadicAlgCl p)
    (denseRange_algebraMap_rat p)

/-- **Every finite subextension of `PadicAlgCl p / ℚ_[p]` is closed in `PadicAlgCl p`.** -/
theorem isClosed_of_finiteDimensional (E : IntermediateField ℚ_[p] (PadicAlgCl p))
    [FiniteDimensional ℚ_[p] E] :
    IsClosed (E : Set (PadicAlgCl p)) :=
  E.toSubmodule.isClosed_of_finiteDimensional

/-- **`PadicAlgCl p` is the union of its finite subextensions over `ℚ_[p]`.** -/
theorem biUnion_finiteDimensional_eq_univ :
    (⋃ E ∈ {E : IntermediateField ℚ_[p] (PadicAlgCl p) | FiniteDimensional ℚ_[p] E},
      (E : Set (PadicAlgCl p))) = Set.univ := by
  refine Set.eq_univ_iff_forall.mpr fun x ↦ Set.mem_biUnion (x := ℚ_[p]⟮x⟯) ?_ ?_
  · exact IntermediateField.adjoin.finiteDimensional (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
  · exact IntermediateField.mem_adjoin_simple_self ℚ_[p] x

/-- **The spectral norm on any intermediate field of `PadicAlgCl p / ℚ_[p]` agrees with the
ambient norm.** -/
theorem algebraicExtensionNormedField_norm_eq (E : IntermediateField ℚ_[p] (PadicAlgCl p))
    (x : E) :
    @Norm.norm E (TauCeti.algebraicExtensionNormedField ℚ_[p] E).toNorm x =
      ‖(x : PadicAlgCl p)‖ := by
  have h := TauCeti.algebraicExtensionNormedField_norm_unique (K := ℚ_[p]) (M := E)
    (f := NormedField.toAbsoluteValue E) (fun a ↦ ?_) x
  · exact h.symm
  · rw [NormedField.toAbsoluteValue_apply, ← isometry_subtype_coe.norm_map_of_map_zero rfl,
      ← IntermediateField.coe_val, AlgHom.commutes, PadicAlgCl.norm_extends]
    have hq := congrArg NNReal.toRealHom (Padic.normalizedAbsoluteValue_eq_nnnorm p a).symm
    simpa only [map_nnratCast, NNReal.coe_toRealHom, coe_nnNorm] using hq

/-- **The spectral-norm topology on any intermediate field of `PadicAlgCl p / ℚ_[p]` coincides
with its subspace topology from `PadicAlgCl p`.** -/
theorem algebraicExtensionNormedFieldTopology_eq (E : IntermediateField ℚ_[p] (PadicAlgCl p)) :
    TauCeti.algebraicExtensionNormedFieldTopology ℚ_[p] E =
      (inferInstance : TopologicalSpace E) := by
  let nf := TauCeti.algebraicExtensionNormedField ℚ_[p] E
  have hdist (y x : E) : @dist E nf.toDist y x = dist y x := by
    rw [nf.dist_eq, algebraicExtensionNormedField_norm_eq p E (-y + x), Subtype.dist_eq,
      dist_eq_norm, neg_add_eq_sub, ← IntermediateField.coe_val, map_sub]
    exact norm_sub_rev (x : PadicAlgCl p) y
  refine TopologicalSpace.ext_nhds fun x ↦ Filter.ext fun s ↦ ?_
  rw [(@Metric.nhds_basis_ball E nf.toPseudoMetricSpace x).mem_iff,
    Metric.nhds_basis_ball.mem_iff]
  refine exists_congr fun ε ↦ and_congr_right fun _ ↦ ?_
  have hball : @Metric.ball E nf.toPseudoMetricSpace x ε = Metric.ball x ε := by
    ext y
    simp only [Metric.mem_ball, hdist]
  rw [hball]

/-- **Integral elements of an intermediate field of `PadicAlgCl p / ℚ_[p]` are those of norm at
most `1`.** -/
theorem mem_integerRing_algebraicExtension_iff (E : IntermediateField ℚ_[p] (PadicAlgCl p))
    (x : E) :
    letI := TauCeti.algebraicExtensionValuativeRel ℚ_[p] E
    x ∈ 𝒪[E] ↔ ‖(x : PadicAlgCl p)‖ ≤ 1 := by
  let _ := TauCeti.algebraicExtensionValuativeRel ℚ_[p] E
  rw [Valuation.mem_integer_iff, ← map_one (ValuativeRel.valuation E),
    ← (ValuativeRel.valuation E).vle_iff_le,
    TauCeti.algebraicExtensionValuativeRel_vle_iff (K := ℚ_[p]) (M := E),
    algebraicExtensionNormedField_norm_eq p E x,
    algebraicExtensionNormedField_norm_eq p E 1,
    OneMemClass.coe_one, norm_one]

/-- **A finite intermediate field of `PadicAlgCl p / ℚ_[p]` is a nonarchimedean local field for
its subspace topology and spectral-norm valuative relation.** -/
theorem finiteIntermediateField_isNonarchimedeanLocalField
    (E : IntermediateField ℚ_[p] (PadicAlgCl p)) [FiniteDimensional ℚ_[p] E] :
    @IsNonarchimedeanLocalField E _
      (TauCeti.algebraicExtensionValuativeRel ℚ_[p] E)
      (inferInstance : TopologicalSpace E) := by
  rw [← algebraicExtensionNormedFieldTopology_eq p E]
  exact TauCeti.finiteExtension_isNonarchimedeanLocalField ℚ_[p] E

end PadicAlgCl
