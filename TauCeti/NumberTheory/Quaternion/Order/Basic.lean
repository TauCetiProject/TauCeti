/-!
# Orders in a quaternion algebra

Let `R` be an integrally closed domain with fraction field `F`. An `R`-order in a quaternion
algebra `ℍ[F,c₁,c₂,c₃]` is an `R`-subalgebra which is an `R`-lattice
(`TauCeti.IntegralOrder.IsOrder`). Its elements are integral over `R`, so by
`TauCeti.QuaternionAlgebra.isIntegral_iff_mem_range` their reduced trace
`trd(x) = 2 x.re + c₂ x.imI` and reduced norm `nrd(x) = normForm c₁ c₂ c₃ x` lie in `R`.
Consequently every order is stable under the involution `star x = trd(x) - x`. Conversely, in
characteristic zero and when `ℍ[F,c₁,c₂,c₃]` is simple, an `R`-subalgebra spanning the algebra over
`F` whose elements all have reduced trace and norm in `R` is an order, provided `R` is noetherian.

When the parameters `c₁, c₂, c₃` lie in `R`, the subalgebra `R⟨i, j⟩` generated by `i` and `j` is
the `R`-span of the standard basis `1, i, j, k`, and it is an order: the standard order
`TauCeti.QuaternionAlgebra.standardOrder`. For `ℍ[ℚ,-1,-1]` and `R = ℤ` this is the Lipschitz
order, which is not maximal: `(1 + i + j + k) / 2` is integral over `ℤ` but has non-integral
coordinates.

## Main definitions

* `TauCeti.QuaternionAlgebra.standardOrder R c₁ c₂ c₃`: the `R`-subalgebra `R⟨i, j⟩` of
  `ℍ[F,c₁,c₂,c₃]`.

## Main results

* `TauCeti.QuaternionAlgebra.star_mem_of_isIntegral`: an integral element of a subalgebra has its
  conjugate in the subalgebra.
* `TauCeti.IntegralOrder.IsOrder.star_mem`: orders are stable under quaternion conjugation.
* `TauCeti.IntegralOrder.IsOrder.two_mul_re_add_mul_imI_mem_range` and
  `TauCeti.IntegralOrder.IsOrder.normForm_mem_range`: elements of an order have reduced trace and
  reduced norm in `R`.
* `TauCeti.QuaternionAlgebra.isOrder_of_forall_mem_range`: a spanning subalgebra all of whose
  elements have reduced trace and reduced norm in `R` is an order.
* `TauCeti.QuaternionAlgebra.standardOrder_le_iff`: `R⟨i, j⟩` lies in a subalgebra exactly when
  `i` and `j` do.
* `TauCeti.QuaternionAlgebra.mem_standardOrder_iff`: when `c₁, c₂, c₃ ∈ R`, a quaternion lies in
  `R⟨i, j⟩` exactly when its four coordinates lie in `R`.
* `TauCeti.QuaternionAlgebra.toSubmodule_standardOrder`: `R⟨i, j⟩` is the `R`-span of
  `1, i, j, k`.
* `TauCeti.QuaternionAlgebra.isOrder_standardOrder`: `R⟨i, j⟩` is an order.

## References

* J. Voight, *Quaternion algebras*, Example 10.2.4, Lemma 10.3.3, Corollary 10.3.6 and
  Lemma 10.3.7.
-/

public section

open Submodule TauCeti.IntegralOrder QuaternionAlgebra

open scoped Quaternion

namespace TauCeti.QuaternionAlgebra

variable {R F : Type*} [CommRing R] [Field F] [Algebra R F] {c₁ c₂ c₃ : F}

section IsOrder

variable [IsFractionRing R F] [IsIntegrallyClosed R] {Λ : Subalgebra R ℍ[F,c₁,c₂,c₃]}

/-- **Orders are stable under conjugation.** Let `R` be integrally closed with fraction field `F`.
If `x` lies in an `R`-subalgebra `Λ` of `ℍ[F,c₁,c₂,c₃]` and is integral over `R`, then so does
`star x = trd(x) - x`, as the reduced trace of `x` lies in `R`. In particular every `R`-order is
stable under conjugation, since its elements are integral
(`TauCeti.IntegralOrder.IsOrder.star_mem`). -/
theorem star_mem_of_isIntegral {x : ℍ[F,c₁,c₂,c₃]} (hint : IsIntegral R x) (hx : x ∈ Λ) :
    star x ∈ Λ := by
  obtain ⟨⟨t, ht⟩, -⟩ := isIntegral_iff_mem_range.1 hint
  have hstar : star x = algebraMap R ℍ[F,c₁,c₂,c₃] t - x := by
    rw [IsScalarTower.algebraMap_apply R F, ht, coe_algebraMap, ← self_add_star',
      add_sub_cancel_left]
  rw [hstar]
  exact Λ.sub_mem (Λ.algebraMap_mem t) hx

end IsOrder

end TauCeti.QuaternionAlgebra

namespace TauCeti.IntegralOrder.IsOrder

variable {R F : Type*} [CommRing R] [Field F] [Algebra R F] {c₁ c₂ c₃ : F}
  [IsFractionRing R F] [IsIntegrallyClosed R] {Λ : Subalgebra R ℍ[F,c₁,c₂,c₃]}

/-- **Orders are stable under conjugation.** If `R` is integrally closed with fraction field `F`,
every `R`-order in `ℍ[F,c₁,c₂,c₃]` contains the conjugates of its elements. -/
theorem star_mem (h : IsOrder F Λ) {x : ℍ[F,c₁,c₂,c₃]} (hx : x ∈ Λ) : star x ∈ Λ :=
  TauCeti.QuaternionAlgebra.star_mem_of_isIntegral (h.isIntegral hx) hx

/-- If `R` is integrally closed with fraction field `F`, every element of an `R`-order in
`ℍ[F,c₁,c₂,c₃]` has reduced trace `2 x.re + c₂ x.imI` in `R`. -/
theorem two_mul_re_add_mul_imI_mem_range (h : IsOrder F Λ) {x : ℍ[F,c₁,c₂,c₃]} (hx : x ∈ Λ) :
    2 * x.re + c₂ * x.imI ∈ (algebraMap R F).range :=
  (TauCeti.QuaternionAlgebra.isIntegral_iff_mem_range.1 (h.isIntegral hx)).1

/-- If `R` is integrally closed with fraction field `F`, every element of an `R`-order in
`ℍ[F,c₁,c₂,c₃]` has reduced norm `normForm c₁ c₂ c₃ x` in `R`. -/
theorem normForm_mem_range (h : IsOrder F Λ) {x : ℍ[F,c₁,c₂,c₃]} (hx : x ∈ Λ) :
    normForm c₁ c₂ c₃ x ∈ (algebraMap R F).range :=
  (TauCeti.QuaternionAlgebra.isIntegral_iff_mem_range.1 (h.isIntegral hx)).2

end TauCeti.IntegralOrder.IsOrder

namespace TauCeti.QuaternionAlgebra

variable {R F : Type*} [CommRing R] [Field F] [Algebra R F] {c₁ c₂ c₃ : F}

section IsOrder

variable [IsFractionRing R F] [IsIntegrallyClosed R] {Λ : Subalgebra R ℍ[F,c₁,c₂,c₃]}

/-- **Orders from the reduced trace and norm.** Let `R` be an integrally closed noetherian domain
with fraction field `F` of characteristic zero, and let `ℍ[F,c₁,c₂,c₃]` have nonzero `j`-square and
nonzero discriminant, so that it is simple. An `R`-subalgebra spanning `ℍ[F,c₁,c₂,c₃]` over `F`
whose elements all have reduced trace `2 x.re + c₂ x.imI` and reduced norm `normForm c₁ c₂ c₃ x` in
`R` is an `R`-order. -/
theorem isOrder_of_forall_mem_range [IsNoetherianRing R] [CharZero F]
    (hc : c₃ * QuadraticAlgebra.discr c₁ c₂ ≠ 0)
    (hint : ∀ x ∈ Λ, 2 * x.re + c₂ * x.imI ∈ (algebraMap R F).range ∧
      normForm c₁ c₂ c₃ x ∈ (algebraMap R F).range)
    (hspan : span F (Λ : Set ℍ[F,c₁,c₂,c₃]) = ⊤) : IsOrder F Λ :=
  isOrder_of_isIntegral
    (nondegenerate_regularTraceForm_of_j_sq_mul_discr_ne_zero hc)
    (fun x hx => isIntegral_iff_mem_range.2 (hint x hx)) hspan

end IsOrder

section StandardOrder

variable (R) in
/-- The **standard order** `R⟨i, j⟩`: the `R`-subalgebra of `ℍ[F,c₁,c₂,c₃]` generated by `i` and
`j`. When `c₁, c₂, c₃` lie in `R` it is the `R`-span of `1, i, j, k`
(`TauCeti.QuaternionAlgebra.toSubmodule_standardOrder`), and an `R`-order
(`TauCeti.QuaternionAlgebra.isOrder_standardOrder`). -/
def standardOrder (c₁ c₂ c₃ : F) : Subalgebra R ℍ[F,c₁,c₂,c₃] :=
  Algebra.adjoin R {⟨0, 1, 0, 0⟩, ⟨0, 0, 1, 0⟩}

/-- The standard order `R⟨i, j⟩` lies in an `R`-subalgebra `Λ` exactly when `i = ⟨0, 1, 0, 0⟩` and
`j = ⟨0, 0, 1, 0⟩` do. -/
theorem standardOrder_le_iff {Λ : Subalgebra R ℍ[F,c₁,c₂,c₃]} :
    standardOrder R c₁ c₂ c₃ ≤ Λ ↔ ⟨0, 1, 0, 0⟩ ∈ Λ ∧ ⟨0, 0, 1, 0⟩ ∈ Λ := by
  rw [standardOrder, Algebra.adjoin_le_iff, Set.insert_subset_iff, Set.singleton_subset_iff,
    SetLike.mem_coe, SetLike.mem_coe]

/-- The quaternion `i = ⟨0, 1, 0, 0⟩` lies in the standard order `R⟨i, j⟩`. -/
theorem i_mem_standardOrder : (⟨0, 1, 0, 0⟩ : ℍ[F,c₁,c₂,c₃]) ∈ standardOrder R c₁ c₂ c₃ :=
  (standardOrder_le_iff.1 le_rfl).1

/-- The quaternion `j = ⟨0, 0, 1, 0⟩` lies in the standard order `R⟨i, j⟩`. -/
theorem j_mem_standardOrder : (⟨0, 0, 1, 0⟩ : ℍ[F,c₁,c₂,c₃]) ∈ standardOrder R c₁ c₂ c₃ :=
  (standardOrder_le_iff.1 le_rfl).2

/-- A quaternion lies in the standard order `R⟨i, j⟩` exactly when its four coordinates lie in `R`,
provided `c₁, c₂, c₃` do. -/
theorem mem_standardOrder_iff (h₁ : c₁ ∈ (algebraMap R F).range) (h₂ : c₂ ∈ (algebraMap R F).range)
    (h₃ : c₃ ∈ (algebraMap R F).range) {x : ℍ[F,c₁,c₂,c₃]} :
    x ∈ standardOrder R c₁ c₂ c₃ ↔ x.re ∈ (algebraMap R F).range ∧
      x.imI ∈ (algebraMap R F).range ∧ x.imJ ∈ (algebraMap R F).range ∧
        x.imK ∈ (algebraMap R F).range := by
  set A := (algebraMap R F).range
  -- the quaternions with coordinates in `A` are the image of `ℍ[A,c₁,c₂,c₃]`, hence a subring
  let f : ℍ[A,⟨c₁, h₁⟩,⟨c₂, h₂⟩,⟨c₃, h₃⟩] →+* ℍ[F,c₁,c₂,c₃] := map _ _ _ A.subtype rfl rfl rfl
  have hf {y : ℍ[F,c₁,c₂,c₃]} :
      y ∈ f.range ↔ y.re ∈ A ∧ y.imI ∈ A ∧ y.imJ ∈ A ∧ y.imK ∈ A :=
    (mem_range_map ..).trans (by simp only [Subring.range_subtype])
  rw [← hf]
  refine ⟨fun hx => ?_, fun hx => ?_⟩
  · induction hx using Algebra.adjoin_induction with
    | mem y hy =>
      rcases hy with rfl | rfl
      · exact hf.2 ⟨A.zero_mem, A.one_mem, A.zero_mem, A.zero_mem⟩
      · exact hf.2 ⟨A.zero_mem, A.zero_mem, A.one_mem, A.zero_mem⟩
    | algebraMap r =>
      rw [IsScalarTower.algebraMap_apply R F, coe_algebraMap]
      exact hf.2 ⟨⟨r, rfl⟩, A.zero_mem, A.zero_mem, A.zero_mem⟩
    | add y z _ _ hy hz => exact f.range.add_mem hy hz
    | mul y z _ _ hy hz => exact f.range.mul_mem hy hz
  · -- `x = x.re + x.imI • i + x.imJ • j + x.imK • (i * j)` with coefficients in `R`
    obtain ⟨⟨r₀, hr₀⟩, ⟨r₁, hr₁⟩, ⟨r₂, hr₂⟩, ⟨r₃, hr₃⟩⟩ := hf.1 hx
    have hi := i_mem_standardOrder (R := R) (c₁ := c₁) (c₂ := c₂) (c₃ := c₃)
    have hj := j_mem_standardOrder (R := R) (c₁ := c₁) (c₂ := c₂) (c₃ := c₃)
    have hxeq : x = algebraMap R ℍ[F,c₁,c₂,c₃] r₀ + r₁ • ⟨0, 1, 0, 0⟩ + r₂ • ⟨0, 0, 1, 0⟩ +
        r₃ • (⟨0, 1, 0, 0⟩ * ⟨0, 0, 1, 0⟩) := by
      ext <;> simp [IsScalarTower.algebraMap_apply R F ℍ[F,c₁,c₂,c₃], Algebra.smul_def, hr₀, hr₁,
        hr₂, hr₃]
    rw [hxeq]
    exact add_mem (add_mem (add_mem (Subalgebra.algebraMap_mem _ r₀) (Subalgebra.smul_mem _ hi r₁))
      (Subalgebra.smul_mem _ hj r₂)) (Subalgebra.smul_mem _ (mul_mem hi hj) r₃)

/-- When `c₁, c₂, c₃` lie in `R`, the standard order `R⟨i, j⟩` is the `R`-span of the basis
`1, i, j, k` of `ℍ[F,c₁,c₂,c₃]`. -/
theorem toSubmodule_standardOrder (h₁ : c₁ ∈ (algebraMap R F).range)
    (h₂ : c₂ ∈ (algebraMap R F).range) (h₃ : c₃ ∈ (algebraMap R F).range) :
    Subalgebra.toSubmodule (standardOrder R c₁ c₂ c₃) =
      span R (Set.range (basisOneIJK c₁ c₂ c₃)) := by
  set b := basisOneIJK c₁ c₂ c₃
  -- membership in `R⟨i, j⟩` says that the four coordinates `b.repr x k` lie in `R`
  have hmem {x : ℍ[F,c₁,c₂,c₃]} :
      x ∈ standardOrder R c₁ c₂ c₃ ↔ ∀ k, b.repr x k ∈ (algebraMap R F).range := by
    simp [b, mem_standardOrder_iff h₁ h₂ h₃, Fin.forall_fin_succ]
  refine le_antisymm (fun x hx => ?_) (span_le.2 <| Set.range_subset_iff.2 fun i => ?_)
  · choose r hr using hmem.1 hx
    rw [← b.sum_repr x]
    refine sum_mem fun k _ => ?_
    rw [← hr k, algebraMap_smul]
    exact smul_mem _ _ (subset_span ⟨k, rfl⟩)
  · refine hmem.2 fun k => ?_
    rw [b.repr_self, Finsupp.single_apply]
    split_ifs
    exacts [one_mem _, zero_mem _]

/-- **The standard order is an order.** When `c₁, c₂, c₃` lie in `R`, the subalgebra `R⟨i, j⟩` of
`ℍ[F,c₁,c₂,c₃]` is an `R`-order. -/
theorem isOrder_standardOrder (h₁ : c₁ ∈ (algebraMap R F).range)
    (h₂ : c₂ ∈ (algebraMap R F).range) (h₃ : c₃ ∈ (algebraMap R F).range) :
    IsOrder F (standardOrder R c₁ c₂ c₃) := by
  have h := toSubmodule_standardOrder (R := R) h₁ h₂ h₃
  refine isOrder_iff.2 ⟨Module.Finite.iff_fg.2 (h ▸ fg_span (Set.finite_range _)), eq_top_iff.2 ?_⟩
  rw [← (basisOneIJK c₁ c₂ c₃).span_eq]
  refine span_le.2 fun y hy => subset_span ?_
  rw [SetLike.mem_coe, ← Subalgebra.mem_toSubmodule, h]
  exact subset_span hy

end StandardOrder

/-! ### The Lipschitz order -/

section Lipschitz

/-- The Lipschitz order `ℤ⟨i, j⟩` of `ℍ[ℚ,-1,-1]` is a `ℤ`-order. -/
example : IsOrder ℚ (standardOrder ℤ (-1 : ℚ) 0 (-1)) :=
  isOrder_standardOrder ⟨-1, by simp⟩ ⟨0, by simp⟩ ⟨-1, by simp⟩

/-- The Lipschitz order is stable under quaternion conjugation. -/
example {x : ℍ[ℚ,-1,-1]} (hx : x ∈ standardOrder ℤ (-1 : ℚ) 0 (-1)) :
    star x ∈ standardOrder ℤ (-1 : ℚ) 0 (-1) :=
  (isOrder_standardOrder ⟨-1, by simp⟩ ⟨0, by simp⟩ ⟨-1, by simp⟩).star_mem hx

/-- The Hurwitz quaternion `(1 + i + j + k) / 2` has reduced trace `1` and reduced norm `1`, so it
is integral over `ℤ`, although it does not lie in the Lipschitz order. -/
example : IsIntegral ℤ (⟨1 / 2, 1 / 2, 1 / 2, 1 / 2⟩ : ℍ[ℚ,-1,-1]) ∧
    (⟨1 / 2, 1 / 2, 1 / 2, 1 / 2⟩ : ℍ[ℚ,-1,-1]) ∉ standardOrder ℤ (-1 : ℚ) 0 (-1) := by
  refine ⟨isIntegral_iff_mem_range.2 ⟨⟨1, by norm_num⟩, ⟨1, ?_⟩⟩, fun h => ?_⟩
  · rw [normForm_apply_coordinates]
    norm_num
  · obtain ⟨⟨n, hn⟩, -⟩ := (mem_standardOrder_iff ⟨-1, by simp⟩ ⟨0, by simp⟩ ⟨-1, by simp⟩).1 h
    have hden := congrArg Rat.den hn
    simp at hden

end Lipschitz

end TauCeti.QuaternionAlgebra
