module

public import Mathlib.GroupTheory.PresentedGroup
public import TauCeti.NumberTheory.Modular.Generators
import Mathlib.LinearAlgebra.Matrix.FixedDetMatrices
import TauCeti.Analysis.Complex.Fuchsian.LevelOne.TriangleGroup
import TauCeti.LinearAlgebra.Matrix.ProjectiveSpecialLinearGroup.FinTwo
import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.ModularGroup

/-!
# The amalgam presentation of `SL(2, ℤ)`

The integral special linear group is the amalgamated free product `ℤ/4 ∗_{ℤ/2} ℤ/6` of the
cyclic groups generated by `S = [[0, -1], [1, 0]]` and `-U = [[0, 1], [-1, 1]]`, amalgamated
along `S² = (-U)³ = -1`:
`SL(2, ℤ) ≅ ⟨s, v | s⁴ = 1, s² = v³⟩`, with `s ↦ S` and `v ↦ -U`.
Here `U = S T⁻¹`, and `-U = T (S T S⁻¹)` is the product of the two standard unipotent generators
`T = [[1, 1], [0, 1]]` and `S T S⁻¹ = [[1, 0], [-1, 1]]`.

The relations hold in `SL(2, ℤ)`, and `S` and `T = (-U)⁻¹ S⁻¹` generate it, so the presented group
maps onto `SL(2, ℤ)`. For injectivity, `s²` is central in the presented group, and the quotient by
the subgroup it generates is presented by `⟨s, v | s², v³⟩`. The triangle presentation
`TauCeti.ModularGroup.modularEquiv : Δ(3, 2, ∞) ≃* PSL(2, ℤ)` inverts the induced map of this
quotient onto `PSL(2, ℤ)`, so the kernel lies in `{1, s²}`, and `s²` maps to `-1 ≠ 1`.

## Main declarations

* `TauCeti.ModularGroup.sl2zRelators`: the relators `s⁴` and `s² v⁻³` in `FreeGroup (Fin 2)`.
* `TauCeti.ModularGroup.sl2zLift`: the universal property of the presentation.
* `TauCeti.ModularGroup.sl2zPresentationEquiv`: the presentation
  `PresentedGroup sl2zRelators ≃* SL(2, ℤ)`, sending the generators to `S` and `-U`.

## References

* J.-P. Serre, *Trees*, Springer, 1980, Chapter I, §1.5.3 and §4.2, Example (c)
  (the amalgam `SL(2, ℤ) = ℤ/4 ∗_{ℤ/2} ℤ/6`).
-/

public section

open scoped MatrixGroups

namespace TauCeti.ModularGroup

open _root_.ModularGroup

/-- The relators of the amalgam presentation `⟨s, v | s⁴ = 1, s² = v³⟩` of `SL(2, ℤ)`, in
`FreeGroup (Fin 2)`: `s⁴` and `s² v⁻³`, where `s` and `v` are the generators `0` and `1`. -/
def sl2zRelators : Set (FreeGroup (Fin 2)) :=
  {FreeGroup.of 0 ^ 4, FreeGroup.of 0 ^ 2 * (FreeGroup.of 1 ^ 3)⁻¹}

/-- **The universal property of the amalgam presentation.** Elements `p` and `q` of a group with
`p⁴ = 1` and `p² = q³` define a homomorphism out of `⟨s, v | s⁴ = 1, s² = v³⟩` sending `s` and
`v` to `p` and `q`. -/
def sl2zLift {G : Type*} [Group G] (p q : G) (hp : p ^ 4 = 1) (hpq : p ^ 2 = q ^ 3) :
    PresentedGroup sl2zRelators →* G :=
  PresentedGroup.toGroup (f := ![p, q]) <| by
    rintro _ (rfl | rfl) <;> simp [FreeGroup.lift_apply_of, hp, hpq]

/-- The lift of the amalgam presentation sends the first generator to `p`. -/
@[simp]
theorem sl2zLift_of_zero {G : Type*} [Group G] (p q : G) (hp : p ^ 4 = 1)
    (hpq : p ^ 2 = q ^ 3) : sl2zLift p q hp hpq (.of 0) = p :=
  PresentedGroup.toGroup.of _

/-- The lift of the amalgam presentation sends the second generator to `q`. -/
@[simp]
theorem sl2zLift_of_one {G : Type*} [Group G] (p q : G) (hp : p ^ 4 = 1)
    (hpq : p ^ 2 = q ^ 3) : sl2zLift p q hp hpq (.of 1) = q :=
  PresentedGroup.toGroup.of _

/-! ### The presentation map -/

/-- The homomorphism from the amalgam to `SL(2, ℤ)` sending `s` and `v` to `S` and `-U`. -/
private def presentationHom : PresentedGroup sl2zRelators →* SL(2, ℤ) :=
  sl2zLift S (-U) S_pow_four (by rw [S_sq, neg_U_pow_three])

private theorem presentationHom_of_zero : presentationHom (.of 0) = S :=
  sl2zLift_of_zero ..

private theorem presentationHom_of_one : presentationHom (.of 1) = -U :=
  sl2zLift_of_one ..

private theorem presentationHom_surjective : Function.Surjective presentationHom := by
  rw [← MonoidHom.range_eq_top, eq_top_iff, ← SpecialLinearGroup.SL2Z_generators,
    Subgroup.closure_le]
  have hS : S ∈ presentationHom.range := ⟨_, presentationHom_of_zero⟩
  have hU : -U ∈ presentationHom.range := ⟨_, presentationHom_of_one⟩
  rintro _ (rfl | rfl)
  · exact hS
  · rw [SetLike.mem_coe, ← neg_U_inv_mul_S_inv]
    exact mul_mem (inv_mem hU) (inv_mem hS)

/-! ### Relations in the amalgam -/

private theorem of_zero_pow_four : (.of 0 : PresentedGroup sl2zRelators) ^ 4 = 1 := by
  rw [PresentedGroup.of, ← map_pow]
  exact PresentedGroup.one_of_mem (by simp [sl2zRelators])

private theorem of_zero_sq : (.of 0 : PresentedGroup sl2zRelators) ^ 2 = .of 1 ^ 3 := by
  have h := PresentedGroup.one_of_mem (rels := sl2zRelators)
    (x := FreeGroup.of 0 ^ 2 * (FreeGroup.of 1 ^ 3)⁻¹) (by simp [sl2zRelators])
  rw [map_mul, map_inv, map_pow, map_pow] at h
  exact mul_inv_eq_one.1 h

/-- The square of `s` is central in the amalgam: it commutes with `s`, and with `v` since it
equals `v³`. -/
private theorem of_zero_sq_mem_center :
    (.of 0 : PresentedGroup sl2zRelators) ^ 2 ∈ Subgroup.center _ := by
  have h : Subgroup.closure (Set.range PresentedGroup.of) ≤
      Subgroup.centralizer {(.of 0 : PresentedGroup sl2zRelators) ^ 2} := by
    rw [Subgroup.closure_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_singleton_iff]
    fin_cases i
    · exact (Commute.refl _).pow_right 2
    · rw [of_zero_sq]
      exact (Commute.refl _).pow_right 3
  rw [PresentedGroup.closure_range_of, top_le_iff] at h
  rw [Subgroup.mem_center_iff]
  intro g
  have hg : g ∈ Subgroup.centralizer {(.of 0 : PresentedGroup sl2zRelators) ^ 2} := h ▸ trivial
  exact Subgroup.mem_centralizer_singleton_iff.1 hg

/-- The central subgroup of the amalgam generated by `s²`, the amalgamated `ℤ/2`. -/
private def centralSq : Subgroup (PresentedGroup sl2zRelators) :=
  Subgroup.zpowers (.of 0 ^ 2)

private instance : centralSq.Normal :=
  Subgroup.normal_of_le_center (Subgroup.zpowers_le.2 of_zero_sq_mem_center)

/-- The map of the amalgam modulo `s²` onto `PSL(2, ℤ)`. -/
private def quotientToPSL : PresentedGroup sl2zRelators ⧸ centralSq →* PSL(2, ℤ) :=
  QuotientGroup.lift _ ((QuotientGroup.mk' _).comp presentationHom) <| by
    rw [centralSq, Subgroup.zpowers_le, MonoidHom.mem_ker, MonoidHom.comp_apply, map_pow,
      presentationHom_of_zero, QuotientGroup.mk'_apply, QuotientGroup.mk_pow, coe_S_sq]

/-- The triangle group `Δ(3, 2, ∞)` maps to the amalgam modulo `s²`, sending `x` and `y` to the
classes of `v` and `s`. -/
private def triangleToQuotient : TriangleGroup 3 2 0 →* PresentedGroup sl2zRelators ⧸ centralSq :=
  TriangleGroup.lift (.of 1 : PresentedGroup sl2zRelators) (.of 0 : PresentedGroup sl2zRelators)
    ((.of 1 : PresentedGroup sl2zRelators)⁻¹ * (.of 0 : PresentedGroup sl2zRelators)⁻¹ :
      PresentedGroup sl2zRelators)
    (by rw [← QuotientGroup.mk_pow, ← of_zero_sq, QuotientGroup.eq_one_iff]
        exact Subgroup.mem_zpowers _)
    (by rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
        exact Subgroup.mem_zpowers _)
    (pow_zero _)
    (by simp [mul_assoc])

/-- Through `Δ(3, 2, ∞) ≅ PSL(2, ℤ)`, the triangle map inverts `quotientToPSL`. -/
private theorem triangleToQuotient_comp_quotientToPSL :
    (triangleToQuotient.comp modularEquiv.symm.toMonoidHom).comp quotientToPSL =
      MonoidHom.id _ := by
  refine QuotientGroup.monoidHom_ext _ (PresentedGroup.ext fun i ↦ ?_)
  have hy : modularEquiv.symm (S : PSL(2, ℤ)) = TriangleGroup.y 3 2 0 :=
    (MulEquiv.symm_apply_eq _).2 modularEquiv_y.symm
  have hx : modularEquiv.symm (U : PSL(2, ℤ)) = TriangleGroup.x 3 2 0 :=
    (MulEquiv.symm_apply_eq _).2 modularEquiv_x.symm
  fin_cases i
  · simp [quotientToPSL, triangleToQuotient, presentationHom_of_zero, hy]
  · simp [quotientToPSL, triangleToQuotient, presentationHom_of_one, hx]

private theorem presentationHom_injective : Function.Injective presentationHom := by
  refine (injective_iff_map_eq_one _).2 fun p hp ↦ ?_
  -- the class of `p` modulo `s²` is trivial, since its image in `PSL(2, ℤ)` is
  have hq : (p : PresentedGroup sl2zRelators ⧸ centralSq) = 1 := by
    have h := DFunLike.congr_fun triangleToQuotient_comp_quotientToPSL
      (p : PresentedGroup sl2zRelators ⧸ centralSq)
    simp only [MonoidHom.comp_apply, quotientToPSL, QuotientGroup.lift_mk, hp, map_one,
      MonoidHom.id_apply] at h
    exact h.symm
  -- so `p` is a power of `s²`, which is `1` or `s²`; the latter maps to `-1 ≠ 1`
  have hp' : p ∈ centralSq := (QuotientGroup.eq_one_iff p).1 hq
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hp'
  have h4 : ((.of 0 : PresentedGroup sl2zRelators) ^ 2) ^ (2 : ℤ) = 1 := by
    rw [zpow_ofNat, ← pow_mul, of_zero_pow_four]
  obtain ⟨m, rfl | rfl⟩ := Int.even_or_odd' k
  · rw [_root_.zpow_mul, h4, one_zpow]
  · rw [_root_.zpow_add_one, _root_.zpow_mul, h4, one_zpow, one_mul, map_pow,
      presentationHom_of_zero, S_sq] at hp
    exact absurd hp (by decide)

/-- **The amalgam presentation of `SL(2, ℤ)`**: `SL(2, ℤ) ≅ ℤ/4 ∗_{ℤ/2} ℤ/6`, presented as
`⟨s, v | s⁴ = 1, s² = v³⟩` with `s ↦ S` and `v ↦ -U = [[0, 1], [-1, 1]]`. -/
noncomputable def sl2zPresentationEquiv : PresentedGroup sl2zRelators ≃* SL(2, ℤ) :=
  MulEquiv.ofBijective presentationHom ⟨presentationHom_injective, presentationHom_surjective⟩

/-- The amalgam presentation sends the first generator to `S`. -/
@[simp]
theorem sl2zPresentationEquiv_of_zero : sl2zPresentationEquiv (.of 0) = S :=
  presentationHom_of_zero

/-- The amalgam presentation sends the second generator to `-U = [[0, 1], [-1, 1]]`. -/
@[simp]
theorem sl2zPresentationEquiv_of_one : sl2zPresentationEquiv (.of 1) = -U :=
  presentationHom_of_one

/-- The inverse of the amalgam presentation sends `S` to the first generator. -/
@[simp]
theorem sl2zPresentationEquiv_symm_S : sl2zPresentationEquiv.symm S = .of 0 :=
  (MulEquiv.symm_apply_eq _).2 sl2zPresentationEquiv_of_zero.symm

/-- The inverse of the amalgam presentation sends `-U` to the second generator. -/
@[simp]
theorem sl2zPresentationEquiv_symm_neg_U : sl2zPresentationEquiv.symm (-U) = .of 1 :=
  (MulEquiv.symm_apply_eq _).2 sl2zPresentationEquiv_of_one.symm

end TauCeti.ModularGroup
