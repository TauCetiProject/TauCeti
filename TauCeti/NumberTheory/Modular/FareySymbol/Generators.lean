/-!
# Modular generators attached to a Farey symbol

To each side `(a / b, c / d)` of a Farey symbol `F` (`c * b - a * d = 1`) and each free-paired
couple of sides `(a / b, c / d)`, `(a' / b', c' / d')`, Kulkarni attaches determinant-one integral
matrices `evenGenerator`, `oddGenerator`, and `freeGenerator`, obtained from the
negative-determinant endpoint matrices `M = !![a, c; b, d]` as `M · S · M⁻¹`,
`M · !![1, -1; 1, 0] · M⁻¹`, and `M' · S · M⁻¹`. Equivalently, in terms of the positive-determinant
side lift `sideSL = !![-a, c; -b, d] ∈ SL(2, ℤ)` carrying `(∞, 0)` to `(a / b, c / d)`, they
equal `sideSL · S⁻¹ · sideSL⁻¹`, `sideSL · R⁻¹ · sideSL⁻¹`, and `sideSL' · S⁻¹ · sideSL⁻¹`.

This file defines these matrices and their `SL(2, ℤ)` lifts, establishes their traces,
determinants, projective orders (`2` and `3`), boundary Möbius actions on `OnePoint ℚ` (including
the signed representatives `(-1, 0)` and `(1, 0)` of `∞`), elliptic fixed points `M · (-i)` and
`M · e^{-πi/3}` in `ℍ`, and the hyperbolic/parabolic dichotomy for free-pair generators (parabolic
if and only if the two paired sides share a cusp). It then defines `FareySymbol.group`, proves its
conjugation covariance under integer translation and reflection, and computes the generated
subgroups on the worked Farey symbols for `PSL(2, ℤ)`, `Γ₀(2)`, `Γ(2)`, and the index-`7`
noncongruence class `{4, 3}`.

## Main definitions and results

* `TauCeti.FareySymbol.evenGenerator`, `TauCeti.FareySymbol.oddGenerator`,
  `TauCeti.FareySymbol.freeGenerator`: the integral `2 × 2` generator matrices and their traces,
  determinants, and `M · _ · (-adjugate M)` factorizations.
* `TauCeti.FareySymbol.sideSL`, `TauCeti.FareySymbol.evenSL`, `TauCeti.FareySymbol.oddSL`,
  `TauCeti.FareySymbol.freeSL`: `SL(2, ℤ)` lifts for unimodular endpoints (`c * b - a * d = 1`),
  with projective orders `orderOf_coe_evenSL` (`= 2`), `orderOf_coe_oddSL` (`= 3`), and
  orientation inversion `coe_freeSL_swap`.
* `TauCeti.FareySymbol.cuspOfEndpoint`: homogeneous endpoint evaluation `ℤ × ℤ → OnePoint ℚ`,
  with the Möbius endpoint actions of `evenSL`, `oddSL`, and `freeSL`.
* `TauCeti.FareySymbol.evenFixedPoint`, `TauCeti.FareySymbol.oddFixedPoint`: fixed points in `ℍ`
  of `evenSL` and `oddSL`, with complex coordinate formulas `M · (-i)` and `M · e^{-πi/3}`.
* `TauCeti.FareySymbol.freeSideSL_isParabolic_iff` and
  `TauCeti.FareySymbol.freeSideSL_isHyperbolic_iff`: on distinct sides of a Farey symbol with
  `1 < xs.length` (in particular on every free pair), `freeSideSL` is parabolic when the two sides
  share a cusp and hyperbolic otherwise, and always has infinite projective order.
* `TauCeti.FareySymbol.group`: the subgroup of `PSL(2, ℤ)` generated by the side matrices of `F`,
  its conjugation laws `translate_group` and `reflect_group`, and the identifications
  `group_levelOne`, `comap_group_gamma0Two`, and `comap_group_gammaTwo`.

## References

* R. S. Kulkarni, *An arithmetic-geometric method in the study of the subgroups of the modular
  group*, Amer. J. Math. **113** (1991), no. 6, 1053–1133, §§2–3.
* C. A. Kurth and L. Long, *Computations with finite index subgroups of `PSL₂(ℤ)` using Farey
  symbols*, J. Number Theory **128** (2008), no. 7, 1862–1888, §3.3, Theorem 3.
-/

public section

open Matrix OnePoint
open scoped MatrixGroups UpperHalfPlane

namespace TauCeti.FareySymbol

/-! ### Integral side generator matrices -/

/-- The even generator matrix of a side `(a / b, c / d)`:
`M · S · M⁻¹` for `M = !![a, c; b, d]`. -/
@[expose]
def evenGenerator (a b c d : ℤ) : Matrix (Fin 2) (Fin 2) ℤ :=
  !![-(a * b + c * d), a ^ 2 + c ^ 2; -(b ^ 2 + d ^ 2), a * b + c * d]

/-- The odd generator matrix of a side `(a / b, c / d)`:
`M · !![1, -1; 1, 0] · M⁻¹` for `M = !![a, c; b, d]`. -/
@[expose]
def oddGenerator (a b c d : ℤ) : Matrix (Fin 2) (Fin 2) ℤ :=
  !![-(a * b + a * d + c * d), a ^ 2 + a * c + c ^ 2;
     -(b ^ 2 + b * d + d ^ 2), a * b + b * c + c * d]

/-- The free-pair generator matrix pairing `(a / b, c / d)` with `(a' / b', c' / d')`:
`M' · S · M⁻¹` for `M = !![a, c; b, d]` and `M' = !![a', c'; b', d']`. -/
@[expose]
def freeGenerator (a b c d a' b' c' d' : ℤ) : Matrix (Fin 2) (Fin 2) ℤ :=
  !![-(a' * b + c' * d), a * a' + c * c'; -(b * b' + d * d'), a * b' + c * d']

@[simp]
theorem trace_evenGenerator (a b c d : ℤ) : (evenGenerator a b c d).trace = 0 := by
  simp [evenGenerator, Matrix.trace_fin_two]

theorem det_evenGenerator (a b c d : ℤ) :
    (evenGenerator a b c d).det = (c * b - a * d) ^ 2 := by
  simp [evenGenerator, Matrix.det_fin_two]
  ring

theorem trace_oddGenerator (a b c d : ℤ) :
    (oddGenerator a b c d).trace = c * b - a * d := by
  simp [oddGenerator, Matrix.trace_fin_two]
  ring

theorem det_oddGenerator (a b c d : ℤ) :
    (oddGenerator a b c d).det = (c * b - a * d) ^ 2 := by
  simp [oddGenerator, Matrix.det_fin_two]
  ring

theorem trace_freeGenerator (a b c d a' b' c' d' : ℤ) :
    (freeGenerator a b c d a' b' c' d').trace = a * b' + c * d' - a' * b - c' * d := by
  simp [freeGenerator, Matrix.trace_fin_two]
  ring

theorem det_freeGenerator (a b c d a' b' c' d' : ℤ) :
    (freeGenerator a b c d a' b' c' d').det = (c * b - a * d) * (c' * b' - a' * d') := by
  simp [freeGenerator, Matrix.det_fin_two]
  ring

@[simp]
theorem freeGenerator_self (a b c d : ℤ) :
    freeGenerator a b c d a b c d = evenGenerator a b c d := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [freeGenerator, evenGenerator, sq]

/-- Factorization `M · S · (-adjugate M) = evenGenerator a b c d` for `M = !![a, c; b, d]`
(when `c * b - a * d = 1`, `det M = -1` so `-adjugate M = M⁻¹`). -/
theorem evenGenerator_eq_mul_S_mul_neg_adjugate (a b c d : ℤ) :
    evenGenerator a b c d =
      !![a, c; b, d] * (ModularGroup.S : Matrix (Fin 2) (Fin 2) ℤ) * -adjugate !![a, c; b, d] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [evenGenerator, ModularGroup.coe_S, Matrix.adjugate_fin_two] <;> ring

/-- Factorization `M · !![1, -1; 1, 0] · (-adjugate M) = oddGenerator a b c d` for
`M = !![a, c; b, d]`. -/
theorem oddGenerator_eq_mul_mul_neg_adjugate (a b c d : ℤ) :
    oddGenerator a b c d = !![a, c; b, d] * !![1, -1; 1, 0] * -adjugate !![a, c; b, d] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [oddGenerator, Matrix.adjugate_fin_two] <;> ring

/-- Factorization `M' · S · (-adjugate M) = freeGenerator a b c d a' b' c' d'`. -/
theorem freeGenerator_eq_mul_S_mul_neg_adjugate (a b c d a' b' c' d' : ℤ) :
    freeGenerator a b c d a' b' c' d' =
      !![a', c'; b', d'] * (ModularGroup.S : Matrix (Fin 2) (Fin 2) ℤ) *
        -adjugate !![a, c; b, d] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [freeGenerator, ModularGroup.coe_S, Matrix.adjugate_fin_two] <;> ring

/-! ### Unimodular `SL(2, ℤ)` lifts and projective orders -/

/-- Positive-determinant lift `!![-a, c; -b, d] ∈ SL(2, ℤ)` of a unimodular endpoint pair
`c * b - a * d = 1`, carrying `(∞, 0)` to `(a / b, c / d)`. -/
@[expose]
def sideSL {a b c d : ℤ} (h : c * b - a * d = 1) : SL(2, ℤ) :=
  ⟨!![-a, c; -b, d], by simp [Matrix.det_fin_two]; linarith⟩

@[simp]
theorem coe_sideSL {a b c d : ℤ} (h : c * b - a * d = 1) :
    (sideSL h : Matrix (Fin 2) (Fin 2) ℤ) = !![-a, c; -b, d] := (rfl)

/-- `S⁻¹` is the positive-determinant lift `sideSL` of the side `(0 / 1, 1 / 0)`. -/
theorem S_inv_eq_sideSL :
    ModularGroup.S⁻¹ = sideSL (a := 0) (b := 1) (c := 1) (d := 0) (by ring) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [sideSL, ModularGroup.coe_S]

/-- `R⁻¹` is the positive-determinant lift `sideSL` of the side `(-1 / 1, 1 / 0)`. -/
theorem R_inv_eq_sideSL :
    TauCeti.ModularGroup.R⁻¹ = sideSL (a := -1) (b := 1) (c := 1) (d := 0) (by ring) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [sideSL, TauCeti.ModularGroup.coe_R]

/-- The `SL(2, ℤ)` lift of `evenGenerator` on a unimodular side `c * b - a * d = 1`. -/
@[expose]
def evenSL {a b c d : ℤ} (h : c * b - a * d = 1) : SL(2, ℤ) :=
  ⟨evenGenerator a b c d, by rw [det_evenGenerator, h, one_pow]⟩

@[simp]
theorem coe_evenSL {a b c d : ℤ} (h : c * b - a * d = 1) :
    (evenSL h : Matrix (Fin 2) (Fin 2) ℤ) = evenGenerator a b c d := (rfl)

/-- The `SL(2, ℤ)` lift of `oddGenerator` on a unimodular side `c * b - a * d = 1`. -/
@[expose]
def oddSL {a b c d : ℤ} (h : c * b - a * d = 1) : SL(2, ℤ) :=
  ⟨oddGenerator a b c d, by rw [det_oddGenerator, h, one_pow]⟩

@[simp]
theorem coe_oddSL {a b c d : ℤ} (h : c * b - a * d = 1) :
    (oddSL h : Matrix (Fin 2) (Fin 2) ℤ) = oddGenerator a b c d := (rfl)

/-- The `SL(2, ℤ)` lift of `freeGenerator` on two unimodular sides. -/
@[expose]
def freeSL {a b c d a' b' c' d' : ℤ} (h : c * b - a * d = 1) (h' : c' * b' - a' * d' = 1) :
    SL(2, ℤ) :=
  ⟨freeGenerator a b c d a' b' c' d', by rw [det_freeGenerator, h, h', mul_one]⟩

@[simp]
theorem coe_freeSL {a b c d a' b' c' d' : ℤ} (h : c * b - a * d = 1)
    (h' : c' * b' - a' * d' = 1) :
    (freeSL h h' : Matrix (Fin 2) (Fin 2) ℤ) = freeGenerator a b c d a' b' c' d' := (rfl)

/-- Conjugation factorization `evenSL h = sideSL h · S⁻¹ · (sideSL h)⁻¹` in `SL(2, ℤ)`. -/
theorem evenSL_eq_conj_S_inv {a b c d : ℤ} (h : c * b - a * d = 1) :
    evenSL h = sideSL h * ModularGroup.S⁻¹ * (sideSL h)⁻¹ := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [evenGenerator, ModularGroup.coe_S, Matrix.adjugate_fin_two] <;> ring

/-- Conjugation factorization `oddSL h = sideSL h · R⁻¹ · (sideSL h)⁻¹` in `SL(2, ℤ)`. -/
theorem oddSL_eq_conj_R_inv {a b c d : ℤ} (h : c * b - a * d = 1) :
    oddSL h = sideSL h * TauCeti.ModularGroup.R⁻¹ * (sideSL h)⁻¹ := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [oddGenerator, TauCeti.ModularGroup.coe_R, Matrix.adjugate_fin_two] <;> ring

/-- Factorization `freeSL h h' = sideSL h' · S⁻¹ · (sideSL h)⁻¹` in `SL(2, ℤ)`. -/
theorem freeSL_eq_sideSL_mul_S_inv_mul_inv {a b c d a' b' c' d' : ℤ}
    (h : c * b - a * d = 1) (h' : c' * b' - a' * d' = 1) :
    freeSL h h' = sideSL h' * ModularGroup.S⁻¹ * (sideSL h)⁻¹ := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [freeGenerator, ModularGroup.coe_S, Matrix.adjugate_fin_two] <;> ring

@[simp]
theorem evenSL_sq {a b c d : ℤ} (h : c * b - a * d = 1) :
    evenSL h ^ 2 = (-1 : SL(2, ℤ)) := by
  have hS : ModularGroup.S⁻¹ ^ 2 = (-1 : SL(2, ℤ)) := by decide
  rw [evenSL_eq_conj_S_inv, ← MulAut.conj_apply, ← map_pow]
  ext i j
  rw [hS]
  fin_cases i <;> fin_cases j <;> simp

@[simp]
theorem oddSL_pow_three {a b c d : ℤ} (h : c * b - a * d = 1) :
    oddSL h ^ 3 = (-1 : SL(2, ℤ)) := by
  have hR : TauCeti.ModularGroup.R⁻¹ ^ 3 = (-1 : SL(2, ℤ)) := by
    rw [inv_pow, TauCeti.ModularGroup.R_pow_three]
    decide
  rw [oddSL_eq_conj_R_inv, ← MulAut.conj_apply, ← map_pow, hR]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

/-- Reversing the order of a free pair replaces `freeSL` by `-freeSL⁻¹` in `SL(2, ℤ)`. -/
@[simp]
theorem freeSL_inv {a b c d a' b' c' d' : ℤ}
    (h : c * b - a * d = 1) (h' : c' * b' - a' * d' = 1) :
    (freeSL h h')⁻¹ = -freeSL h' h := by
  have hS : (ModularGroup.S⁻¹ : SL(2, ℤ))⁻¹ = -ModularGroup.S⁻¹ := by decide
  rw [freeSL_eq_sideSL_mul_S_inv_mul_inv h h', freeSL_eq_sideSL_mul_S_inv_mul_inv h' h]
  simp [mul_assoc, hS]

/-- In `PSL(2, ℤ)`, swapping the order of a free pair inverts the generator. -/
theorem coe_freeSL_swap {a b c d a' b' c' d' : ℤ}
    (h : c * b - a * d = 1) (h' : c' * b' - a' * d' = 1) :
    (freeSL h' h : PSL(2, ℤ)) = (freeSL h h' : PSL(2, ℤ))⁻¹ := by
  rw [← QuotientGroup.mk_inv, freeSL_inv]
  exact Matrix.ProjectiveSpecialLinearGroup.mk_eq_mk_iff.mpr (Or.inr rfl)

/-- Every even side generator has exact order `2` in `PSL(2, ℤ)`. -/
@[simp]
theorem orderOf_coe_evenSL {a b c d : ℤ} (h : c * b - a * d = 1) :
    orderOf (evenSL h : PSL(2, ℤ)) = 2 := by
  have hconj : (evenSL h : PSL(2, ℤ)) =
      MulAut.conj (sideSL h : PSL(2, ℤ)) (ModularGroup.S : PSL(2, ℤ))⁻¹ := by
    rw [evenSL_eq_conj_S_inv, QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv,
      QuotientGroup.mk_inv, MulAut.conj_apply]
  rw [hconj, MulEquiv.orderOf_eq, orderOf_inv, TauCeti.ModularGroup.orderOf_coe_S]

/-- Every odd side generator has exact order `3` in `PSL(2, ℤ)`. -/
@[simp]
theorem orderOf_coe_oddSL {a b c d : ℤ} (h : c * b - a * d = 1) :
    orderOf (oddSL h : PSL(2, ℤ)) = 3 := by
  have hconj : (oddSL h : PSL(2, ℤ)) =
      MulAut.conj (sideSL h : PSL(2, ℤ)) (TauCeti.ModularGroup.R : PSL(2, ℤ))⁻¹ := by
    rw [oddSL_eq_conj_R_inv, QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv,
      QuotientGroup.mk_inv, MulAut.conj_apply]
  rw [hconj, MulEquiv.orderOf_eq, orderOf_inv, TauCeti.ModularGroup.orderOf_coe_R]

/-! ### Möbius action on rational cusps and `∞` -/

/-- The cusp in `OnePoint ℚ` represented by a homogeneous pair `(a, b) ∈ ℤ × ℤ`: `∞` when `b = 0`
and `a / b` otherwise. -/
@[expose]
def cuspOfEndpoint (p : ℤ × ℤ) : OnePoint ℚ :=
  if p.2 = 0 then ∞ else ((p.1 : ℚ) / (p.2 : ℚ))

@[simp]
theorem cuspOfEndpoint_zero_right (a : ℤ) : cuspOfEndpoint (a, 0) = ∞ := (rfl)

theorem cuspOfEndpoint_of_ne_zero {a b : ℤ} (hb : b ≠ 0) :
    cuspOfEndpoint (a, b) = (((a : ℚ) / (b : ℚ) : ℚ) : OnePoint ℚ) :=
  ite_eq_right hb

/-- Two nonzero homogeneous pairs `(a, b)` and `(c, d)` represent the same cusp in `OnePoint ℚ` if
and only if `c * b - a * d = 0`. -/
theorem cuspOfEndpoint_eq_iff {p q : ℤ × ℤ} (hp : p ≠ (0, 0)) (hq : q ≠ (0, 0)) :
    cuspOfEndpoint p = cuspOfEndpoint q ↔ q.1 * p.2 - p.1 * q.2 = 0 := by
  rcases p with ⟨a, b⟩
  rcases q with ⟨c, d⟩
  by_cases hb : b = 0 <;> by_cases hd : d = 0
  · simp [cuspOfEndpoint, hb, hd]
  · have ha : a ≠ 0 := fun ha ↦ hp (Prod.ext ha hb)
    simp [cuspOfEndpoint, hb, hd, ha]
  · have hc : c ≠ 0 := fun hc ↦ hq (Prod.ext hc hd)
    simp [cuspOfEndpoint, hb, hd, hc]
  · simp only [cuspOfEndpoint_of_ne_zero hb, cuspOfEndpoint_of_ne_zero hd, OnePoint.coe_eq_coe]
    rw [div_eq_div_iff (Int.cast_ne_zero.mpr hb) (Int.cast_ne_zero.mpr hd)]
    norm_cast
    omega

/-- `sideSL h` maps `∞ ∈ OnePoint ℚ` to the left endpoint `a / b`. -/
@[simp]
theorem sideSL_smul_infty {a b c d : ℤ} (h : c * b - a * d = 1) :
    SpecialLinearGroup.mapGL ℚ (sideSL h) • (∞ : OnePoint ℚ) = cuspOfEndpoint (a, b) := by
  rw [OnePoint.smul_infty_eq_ite, SpecialLinearGroup.coe_mapGL_int_rat_fin_two]
  simp only [coe_sideSL, of_apply, cons_val_zero, cons_val_one, cons_val_fin_one, Int.cast_neg]
  rcases eq_or_ne b 0 with rfl | hb
  · simp [cuspOfEndpoint]
  · simp [cuspOfEndpoint, hb, neg_div_neg_eq]

/-- `sideSL h` maps `0 ∈ OnePoint ℚ` to the right endpoint `c / d`. -/
@[simp]
theorem sideSL_smul_zero {a b c d : ℤ} (h : c * b - a * d = 1) :
    SpecialLinearGroup.mapGL ℚ (sideSL h) • ((0 : ℚ) : OnePoint ℚ) = cuspOfEndpoint (c, d) := by
  rw [OnePoint.smul_some_eq_ite, SpecialLinearGroup.coe_mapGL_int_rat_fin_two]
  simp only [coe_sideSL, of_apply, cons_val_zero, cons_val_one, cons_val_fin_one, mul_zero,
    zero_add]
  rcases eq_or_ne d 0 with rfl | hd <;> simp [cuspOfEndpoint, *]

/-- `sideSL h` maps `-1 ∈ OnePoint ℚ` to the mediant `(a + c) / (b + d)`. -/
@[simp]
theorem sideSL_smul_neg_one {a b c d : ℤ} (h : c * b - a * d = 1) :
    SpecialLinearGroup.mapGL ℚ (sideSL h) • ((-1 : ℚ) : OnePoint ℚ) =
      cuspOfEndpoint (a + c, b + d) := by
  rw [OnePoint.smul_some_eq_ite, SpecialLinearGroup.coe_mapGL_int_rat_fin_two]
  simp only [coe_sideSL, of_apply, cons_val_zero, cons_val_one, cons_val_fin_one, Int.cast_neg,
    neg_mul_neg, mul_one]
  rcases eq_or_ne (b + d) 0 with hbd | hbd
  · have hbdQ : (b : ℚ) + d = 0 := by exact_mod_cast hbd
    simp [cuspOfEndpoint, hbd, hbdQ]
  · have hbdQ : (b : ℚ) + d ≠ 0 := by exact_mod_cast hbd
    simp [cuspOfEndpoint, hbd, hbdQ]

/-- `evenSL` carries the left endpoint `a / b` to the right endpoint `c / d`. -/
theorem evenSL_smul_left {a b c d : ℤ} (h : c * b - a * d = 1) :
    SpecialLinearGroup.mapGL ℚ (evenSL h) • cuspOfEndpoint (a, b) = cuspOfEndpoint (c, d) := by
  have hS : SpecialLinearGroup.mapGL ℚ ModularGroup.S⁻¹ • (∞ : OnePoint ℚ) = ((0 : ℚ) : _) := by
    rw [S_inv_eq_sideSL, sideSL_smul_infty]; simp [cuspOfEndpoint]
  rw [← sideSL_smul_infty h, ← mul_smul, ← map_mul, evenSL_eq_conj_S_inv, mul_assoc,
    inv_mul_cancel, mul_one, map_mul, mul_smul, hS, sideSL_smul_zero]

/-- `evenSL` carries the right endpoint `c / d` back to the left endpoint `a / b`. -/
theorem evenSL_smul_right {a b c d : ℤ} (h : c * b - a * d = 1) :
    SpecialLinearGroup.mapGL ℚ (evenSL h) • cuspOfEndpoint (c, d) = cuspOfEndpoint (a, b) := by
  have hS : SpecialLinearGroup.mapGL ℚ ModularGroup.S⁻¹ • ((0 : ℚ) : OnePoint ℚ) = ∞ := by
    rw [S_inv_eq_sideSL, sideSL_smul_zero]; rfl
  rw [← sideSL_smul_zero h, ← mul_smul, ← map_mul, evenSL_eq_conj_S_inv, mul_assoc,
    inv_mul_cancel, mul_one, map_mul, mul_smul, hS, sideSL_smul_infty]

/-- `oddSL` carries `a / b` to the mediant `(a + c) / (b + d)`. -/
theorem oddSL_smul_left {a b c d : ℤ} (h : c * b - a * d = 1) :
    SpecialLinearGroup.mapGL ℚ (oddSL h) • cuspOfEndpoint (a, b) =
      cuspOfEndpoint (a + c, b + d) := by
  have hR : SpecialLinearGroup.mapGL ℚ TauCeti.ModularGroup.R⁻¹ • (∞ : OnePoint ℚ) =
      ((-1 : ℚ) : OnePoint ℚ) := by
    rw [R_inv_eq_sideSL, sideSL_smul_infty]; simp [cuspOfEndpoint]
  rw [← sideSL_smul_infty h, ← mul_smul, ← map_mul, oddSL_eq_conj_R_inv, mul_assoc,
    inv_mul_cancel, mul_one, map_mul, mul_smul, hR, sideSL_smul_neg_one]

/-- `oddSL` carries the mediant `(a + c) / (b + d)` to `c / d`. -/
theorem oddSL_smul_mediant {a b c d : ℤ} (h : c * b - a * d = 1) :
    SpecialLinearGroup.mapGL ℚ (oddSL h) • cuspOfEndpoint (a + c, b + d) =
      cuspOfEndpoint (c, d) := by
  have hR : SpecialLinearGroup.mapGL ℚ TauCeti.ModularGroup.R⁻¹ • ((-1 : ℚ) : OnePoint ℚ) =
      ((0 : ℚ) : OnePoint ℚ) := by
    rw [R_inv_eq_sideSL, sideSL_smul_neg_one]; simp [cuspOfEndpoint]
  rw [← sideSL_smul_neg_one h, ← mul_smul, ← map_mul, oddSL_eq_conj_R_inv, mul_assoc,
    inv_mul_cancel, mul_one, map_mul, mul_smul, hR, sideSL_smul_zero]

/-- `oddSL` carries `c / d` back to `a / b`. -/
theorem oddSL_smul_right {a b c d : ℤ} (h : c * b - a * d = 1) :
    SpecialLinearGroup.mapGL ℚ (oddSL h) • cuspOfEndpoint (c, d) = cuspOfEndpoint (a, b) := by
  have hR : SpecialLinearGroup.mapGL ℚ TauCeti.ModularGroup.R⁻¹ • ((0 : ℚ) : OnePoint ℚ) = ∞ := by
    rw [R_inv_eq_sideSL, sideSL_smul_zero]; rfl
  rw [← sideSL_smul_zero h, ← mul_smul, ← map_mul, oddSL_eq_conj_R_inv, mul_assoc,
    inv_mul_cancel, mul_one, map_mul, mul_smul, hR, sideSL_smul_infty]

/-- `freeSL` carries `a / b` to `c' / d'`. -/
theorem freeSL_smul_left {a b c d a' b' c' d' : ℤ}
    (h : c * b - a * d = 1) (h' : c' * b' - a' * d' = 1) :
    SpecialLinearGroup.mapGL ℚ (freeSL h h') • cuspOfEndpoint (a, b) = cuspOfEndpoint (c', d') := by
  have hS : SpecialLinearGroup.mapGL ℚ ModularGroup.S⁻¹ • (∞ : OnePoint ℚ) = ((0 : ℚ) : _) := by
    rw [S_inv_eq_sideSL, sideSL_smul_infty]; simp [cuspOfEndpoint]
  rw [← sideSL_smul_infty h, ← mul_smul, ← map_mul, freeSL_eq_sideSL_mul_S_inv_mul_inv, mul_assoc,
    inv_mul_cancel, mul_one, map_mul, mul_smul, hS, sideSL_smul_zero]

/-- `freeSL` carries `c / d` to `a' / b'`. -/
theorem freeSL_smul_right {a b c d a' b' c' d' : ℤ}
    (h : c * b - a * d = 1) (h' : c' * b' - a' * d' = 1) :
    SpecialLinearGroup.mapGL ℚ (freeSL h h') • cuspOfEndpoint (c, d) = cuspOfEndpoint (a', b') := by
  have hS : SpecialLinearGroup.mapGL ℚ ModularGroup.S⁻¹ • ((0 : ℚ) : OnePoint ℚ) = ∞ := by
    rw [S_inv_eq_sideSL, sideSL_smul_zero]; rfl
  rw [← sideSL_smul_zero h, ← mul_smul, ← map_mul, freeSL_eq_sideSL_mul_S_inv_mul_inv, mul_assoc,
    inv_mul_cancel, mul_one, map_mul, mul_smul, hS, sideSL_smul_infty]

/-! ### Elliptic fixed points in `ℍ` -/

/-- The fixed point `M · (-i) ∈ ℍ` of `evenSL h` on the geodesic `(a / b, c / d)`. -/
noncomputable def evenFixedPoint {a b c d : ℤ} (h : c * b - a * d = 1) : ℍ :=
  sideSL h • UpperHalfPlane.I

/-- Complex coordinate `M · (-i)` of `evenFixedPoint h` (`M = !![a, c; b, d]`). -/
theorem coe_evenFixedPoint {a b c d : ℤ} (h : c * b - a * d = 1) :
    (evenFixedPoint h : ℂ) =
      ((a : ℂ) * (-Complex.I) + c) / ((b : ℂ) * (-Complex.I) + d) := by
  rw [evenFixedPoint, UpperHalfPlane.coe_specialLinearGroup_apply]
  simp [sideSL, mul_neg, neg_mul]

/-- On the side `(-1 / 0, 0 / 1)`, `evenFixedPoint` is `i ∈ ℍ`. -/
@[simp]
theorem evenFixedPoint_neg_one_zero_zero_one :
    evenFixedPoint (a := -1) (b := 0) (c := 0) (d := 1) (by ring) = UpperHalfPlane.I := by
  apply UpperHalfPlane.ext
  simp [coe_evenFixedPoint]

/-- `evenSL h` fixes `evenFixedPoint h` in `ℍ`. -/
theorem evenSL_smul_evenFixedPoint {a b c d : ℤ} (h : c * b - a * d = 1) :
    evenSL h • evenFixedPoint h = evenFixedPoint h := by
  have hSI : ModularGroup.S⁻¹ • UpperHalfPlane.I = UpperHalfPlane.I := by
    apply UpperHalfPlane.ext
    rw [S_inv_eq_sideSL, UpperHalfPlane.coe_specialLinearGroup_apply]
    simp [sideSL]
  rw [evenFixedPoint, evenSL_eq_conj_S_inv, mul_smul, mul_smul, inv_smul_smul, hSI]

/-- The fixed point `M · e^{-πi/3} ∈ ℍ` of `oddSL h` associated to an odd side `(a / b, c / d)`. -/
noncomputable def oddFixedPoint {a b c d : ℤ} (h : c * b - a * d = 1) : ℍ :=
  sideSL h • UpperHalfPlane.ρ

/-- Complex coordinate `M · e^{-πi/3}` of `oddFixedPoint h` (`M = !![a, c; b, d]`). -/
theorem coe_oddFixedPoint {a b c d : ℤ} (h : c * b - a * d = 1) :
    (oddFixedPoint h : ℂ) =
      ((a : ℂ) * Complex.exp (-((Real.pi / 3 : ℝ) : ℂ) * Complex.I) + c) /
        ((b : ℂ) * Complex.exp (-((Real.pi / 3 : ℝ) : ℂ) * Complex.I) + d) := by
  have hρ : -(UpperHalfPlane.ρ : ℂ) = Complex.exp (-((Real.pi / 3 : ℝ) : ℂ) * Complex.I) := by
    have hexp : Complex.exp (-((Real.pi / 3 : ℝ) : ℂ) * Complex.I) =
        Complex.exp (((-(Real.pi / 3) : ℝ) : ℂ) * Complex.I) := by push_cast; rfl
    rw [hexp]
    refine Complex.ext ?_ ?_
    · rw [Complex.exp_ofReal_mul_I_re, Real.cos_neg, Real.cos_pi_div_three]
      norm_num [UpperHalfPlane.ρ]
    · rw [Complex.exp_ofReal_mul_I_im, Real.sin_neg, Real.sin_pi_div_three]
      norm_num [UpperHalfPlane.ρ]
  rw [oddFixedPoint, UpperHalfPlane.coe_specialLinearGroup_apply]
  simp only [coe_sideSL, of_apply, cons_val_zero, cons_val_one, cons_val_fin_one,
    algebraMap_int_eq, Int.coe_castRingHom, Int.cast_neg, Complex.ofReal_neg,
    Complex.ofReal_intCast]
  rw [← hρ]
  ring

/-- `oddSL h` fixes `oddFixedPoint h` in `ℍ`. -/
theorem oddSL_smul_oddFixedPoint {a b c d : ℤ} (h : c * b - a * d = 1) :
    oddSL h • oddFixedPoint h = oddFixedPoint h := by
  have hRρ : TauCeti.ModularGroup.R⁻¹ • UpperHalfPlane.ρ = UpperHalfPlane.ρ := by
    apply UpperHalfPlane.ext
    rw [R_inv_eq_sideSL, UpperHalfPlane.coe_specialLinearGroup_apply]
    simp only [coe_sideSL, of_apply, cons_val_zero, cons_val_one, cons_val_fin_one, neg_neg,
      algebraMap_int_eq, Int.coe_castRingHom, Int.cast_one, Int.cast_neg, Int.cast_zero,
      Complex.ofReal_one, one_mul, Complex.ofReal_neg, neg_mul, Complex.ofReal_zero, add_zero]
    rw [div_eq_iff (neg_ne_zero.mpr (UpperHalfPlane.ne_zero UpperHalfPlane.ρ))]
    linear_combination UpperHalfPlane.ρ_sq
  rw [oddFixedPoint, oddSL_eq_conj_R_inv, mul_smul, mul_smul, inv_smul_smul, hRρ]

/-! ### Side-indexed generators and the hyperbolic/parabolic dichotomy -/

/-- The `SL(2, ℤ)` lift carrying `(∞, 0)` to side `i` of `F`. -/
@[expose]
def sideLiftSL (F : FareySymbol) (i : Fin F.labels.length) : SL(2, ℤ) :=
  sideSL (F.unimodular_endpoints i)

theorem sideLiftSL_def (F : FareySymbol) (i : Fin F.labels.length) :
    F.sideLiftSL i = sideSL (F.unimodular_endpoints i) := (rfl)

/-- The even generator in `SL(2, ℤ)` attached to side `i` of `F`. -/
@[expose]
def evenSideSL (F : FareySymbol) (i : Fin F.labels.length) : SL(2, ℤ) :=
  evenSL (F.unimodular_endpoints i)

/-- The odd generator in `SL(2, ℤ)` attached to side `i` of `F`. -/
@[expose]
def oddSideSL (F : FareySymbol) (i : Fin F.labels.length) : SL(2, ℤ) :=
  oddSL (F.unimodular_endpoints i)

/-- The free generator in `SL(2, ℤ)` pairing side `i` with side `j` of `F`. -/
@[expose]
def freeSideSL (F : FareySymbol) (i j : Fin F.labels.length) : SL(2, ℤ) :=
  freeSL (F.unimodular_endpoints i) (F.unimodular_endpoints j)

/-- The left cusp in `OnePoint ℚ` of side `i` of `F`. -/
def leftCusp (F : FareySymbol) (i : Fin F.labels.length) : OnePoint ℚ :=
  cuspOfEndpoint (F.leftEndpoint i)

/-- The right cusp in `OnePoint ℚ` of side `i` of `F`. -/
def rightCusp (F : FareySymbol) (i : Fin F.labels.length) : OnePoint ℚ :=
  cuspOfEndpoint (F.rightEndpoint i)

/-- Two sides `i` and `j` of `F` share a cusp in `OnePoint ℚ`. -/
def SharesCusp (F : FareySymbol) (i j : Fin F.labels.length) : Prop :=
  F.leftCusp i = F.leftCusp j ∨ F.leftCusp i = F.rightCusp j ∨
    F.rightCusp i = F.leftCusp j ∨ F.rightCusp i = F.rightCusp j

theorem SharesCusp.symm {F : FareySymbol} {i j : Fin F.labels.length}
    (h : F.SharesCusp i j) : F.SharesCusp j i := by
  rcases h with h | h | h | h
  · exact Or.inl h.symm
  · exact Or.inr (Or.inr (Or.inl h.symm))
  · exact Or.inr (Or.inl h.symm)
  · exact Or.inr (Or.inr (Or.inr h.symm))

theorem sharesCusp_comm {F : FareySymbol} {i j : Fin F.labels.length} :
    F.SharesCusp i j ↔ F.SharesCusp j i :=
  ⟨SharesCusp.symm, SharesCusp.symm⟩

/-- For ordered sides `i < j`, `F.SharesCusp i j` holds precisely when `i` and `j` are adjacent
(`i + 1 = j`) or are the two extreme sides `(0, F.xs.length)` meeting at `∞`. -/
theorem sharesCusp_iff_of_lt {F : FareySymbol} {i j : Fin F.labels.length} (hij : i < j) :
    F.SharesCusp i j ↔ i.val + 1 = j.val ∨ (i.val = 0 ∧ j.val = F.xs.length) := by
  have hlen := F.labels_length
  have helen := F.endpoints_length
  have hne_ep : ∀ k (hk : k < F.endpoints.length), F.endpoints[k]'hk ≠ (0, 0) :=
    F.endpoints_ne_zero
  have h1 : F.leftCusp i ≠ F.leftCusp j := by
    rw [leftCusp, leftCusp, leftEndpoint_def, leftEndpoint_def, ne_eq,
      cuspOfEndpoint_eq_iff (hne_ep _ _) (hne_ep _ _),
      F.det_endpoints_eq_zero_iff (k := i.val) (l := j.val) hij.le (by omega)]
    omega
  have h4 : F.rightCusp i ≠ F.rightCusp j := by
    rw [rightCusp, rightCusp, rightEndpoint_def, rightEndpoint_def, ne_eq,
      cuspOfEndpoint_eq_iff (hne_ep _ _) (hne_ep _ _),
      F.det_endpoints_eq_zero_iff (k := i.val + 1) (l := j.val + 1)
        (Nat.add_le_add_right hij.le 1) (by omega)]
    omega
  have h2 : F.leftCusp i = F.rightCusp j ↔ i.val = 0 ∧ j.val = F.xs.length := by
    rw [leftCusp, rightCusp, leftEndpoint_def, rightEndpoint_def,
      cuspOfEndpoint_eq_iff (hne_ep _ _) (hne_ep _ _),
      F.det_endpoints_eq_zero_iff (k := i.val) (l := j.val + 1) (by omega) (by omega)]
    omega
  have h3 : F.rightCusp i = F.leftCusp j ↔ i.val + 1 = j.val := by
    rw [rightCusp, leftCusp, rightEndpoint_def, leftEndpoint_def,
      cuspOfEndpoint_eq_iff (hne_ep _ _) (hne_ep _ _),
      F.det_endpoints_eq_zero_iff (k := i.val + 1) (l := j.val) (by omega) (by omega)]
    omega
  simp [SharesCusp, h1, h2, h3, h4, or_comm]

/-- For ordered sides `i < j` of `F` with `1 < F.xs.length`, the lift `F.freeSideSL i j` is never
`-1` in `SL(2, ℤ)`. -/
theorem freeSideSL_ne_neg_one {F : FareySymbol} {i j : Fin F.labels.length}
    (hxs : 1 < F.xs.length) (hij : i < j) : F.freeSideSL i j ≠ -1 := by
  intro hneg
  have hlen := F.labels_length
  have helen := F.endpoints_length
  set u := F.leftEndpoint i; set v := F.rightEndpoint i
  set u' := F.leftEndpoint j; set v' := F.rightEndpoint j
  have h10 : -(u.2 * u'.2 + v.2 * v'.2) = 0 := by
    simpa [u, v, u', v', freeSideSL, freeGenerator] using
      congrArg (fun g : SL(2, ℤ) ↦ (g : Matrix (Fin 2) (Fin 2) ℤ) 1 0) hneg
  have hb0 : 0 ≤ u.2 := F.snd_endpoints_nonneg i.val (by omega)
  have hd0 : 0 < v.2 := lt_of_le_of_ne (F.snd_endpoints_nonneg (i.val + 1) (by omega))
    (Ne.symm fun hz ↦ by have := (F.snd_endpoints_eq_zero_iff (i.val + 1) (by omega)).mp hz; omega)
  have hb'0 : 0 < u'.2 := lt_of_le_of_ne (F.snd_endpoints_nonneg j.val (by omega))
    (Ne.symm fun hz ↦ by have := (F.snd_endpoints_eq_zero_iff j.val (by omega)).mp hz; omega)
  have hd'0 : 0 ≤ v'.2 := F.snd_endpoints_nonneg (j.val + 1) (by omega)
  have hu2 : u.2 = 0 := (mul_eq_zero.mp (by
    have := mul_nonneg hb0 hb'0.le; have := mul_nonneg hd0.le hd'0; omega :
      u.2 * u'.2 = 0)).resolve_right hb'0.ne'
  have hv'2 : v'.2 = 0 := (mul_eq_zero.mp (by
    have := mul_nonneg hb0 hb'0.le; have := mul_nonneg hd0.le hd'0; omega :
      v.2 * v'.2 = 0)).resolve_left hd0.ne'
  have hi0 : i.val = 0 := by
    have := (F.snd_endpoints_eq_zero_iff i.val (by omega)).mp hu2; omega
  have hjlast : j.val = F.xs.length := by
    have := (F.snd_endpoints_eq_zero_iff (j.val + 1) (by omega)).mp hv'2; omega
  have h01 : u.1 * u'.1 + v.1 * v'.1 = 0 := by
    simpa [u, v, u', v', freeSideSL, freeGenerator] using
      congrArg (fun g : SL(2, ℤ) ↦ (g : Matrix (Fin 2) (Fin 2) ℤ) 0 1) hneg
  have hu_eq : u = (-1, 0) := by simp [u, leftEndpoint_def, hi0]
  have hv_eq : v = ((F.xs[0]'F.xs_length_pos).num, 1) := by
    simp [v, rightEndpoint_def, hi0, endpoints_succ F 0 F.xs_length_pos, F.den_xs_zero]
  have hu'_eq : u' = ((F.xs[F.xs.length - 1]'(by omega)).num, 1) := by
    have hsub : j.val = F.xs.length - 1 + 1 := by omega
    simp [u', leftEndpoint_def, hsub, endpoints_succ F (F.xs.length - 1) (by omega),
      F.den_xs_pred_length]
  have hv'_eq : v' = (1, 0) := by simp [v', rightEndpoint_def, hjlast]
  rw [hu_eq, hv_eq, hu'_eq, hv'_eq] at h01
  have hlt_xs : F.xs[0]'F.xs_length_pos < F.xs[F.xs.length - 1]'(by omega) :=
    F.strictMono_xs F.xs_length_pos (by omega) (by omega)
  rw [← Rat.intCast_num_of_den_eq_one F.den_xs_zero,
    ← Rat.intCast_num_of_den_eq_one F.den_xs_pred_length, Int.cast_lt] at hlt_xs
  omega

/-- When ordered sides `i < j` of `F` (`1 < F.xs.length`) share a cusp, `F.freeSideSL i j` has
trace `-2` and is non-scalar, hence parabolic in `PSL(2, ℤ)`. -/
theorem freeSideSL_isParabolic_of_lt_of_sharesCusp {F : FareySymbol}
    {i j : Fin F.labels.length} (hxs : 1 < F.xs.length) (hij : i < j)
    (hsc : F.SharesCusp i j) :
    Matrix.ProjectiveSpecialLinearGroup.IsParabolic (F.freeSideSL i j : PSL(2, ℤ)) := by
  have hlen := F.labels_length
  have helen := F.endpoints_length
  set u := F.leftEndpoint i; set v := F.rightEndpoint i
  set u' := F.leftEndpoint j; set v' := F.rightEndpoint j
  set X := u'.1 * u.2 - u.1 * u'.2; set Y := v'.1 * v.2 - v.1 * v'.2
  set P := v'.1 * u.2 - u.1 * v'.2; set N := u'.1 * v.2 - v.1 * u'.2
  have hX : 1 ≤ X := by
    have := F.det_endpoints_pos (k := i.val) (l := j.val) hij (by omega) (by omega)
    simp only [X, u, u', leftEndpoint_def] at *; omega
  have hY : 1 ≤ Y := by
    have := F.det_endpoints_pos (k := i.val + 1) (l := j.val + 1)
      (Nat.add_lt_add_right hij 1) (by omega) (by omega)
    simp only [Y, v, v', rightEndpoint_def] at *; omega
  have hPN : P * N = 0 := by
    rcases (F.sharesCusp_iff_of_lt hij).mp hsc with hadj | hinf
    · have hN0 : N = 0 := (F.det_endpoints_eq_zero_iff (k := i.val + 1) (l := j.val)
        (by omega) (by omega)).mpr (Or.inl hadj)
      rw [hN0, mul_zero]
    · have hP0 : P = 0 := (F.det_endpoints_eq_zero_iff (k := i.val) (l := j.val + 1)
        (by omega) (by omega)).mpr (Or.inr ⟨hinf.1, by omega⟩)
      rw [hP0, zero_mul]
  have hXY : X * Y = 1 := by
    have hid : X * Y - P * N = (v.1 * u.2 - u.1 * v.2) * (v'.1 * u'.2 - u'.1 * v'.2) := by ring
    rw [F.unimodular_endpoints i, F.unimodular_endpoints j, hPN] at hid; linarith
  have hX1 : X = 1 := le_antisymm (by
    by_contra!; have := Int.mul_le_mul_of_nonneg_left hY (by omega : 0 ≤ X); omega) hX
  have hY1 : Y = 1 := by rw [hX1, one_mul] at hXY; exact hXY
  have htr2 : (F.freeSideSL i j : Matrix (Fin 2) (Fin 2) ℤ).trace = -2 := by
    rw [freeSideSL, coe_freeSL, trace_freeGenerator]
    linear_combination -hX1 - hY1
  refine (Matrix.ProjectiveSpecialLinearGroup.eq_one_or_isParabolic_of_trace_sq_eq_four
    (by rw [htr2]; ring)).resolve_left ?_
  rw [QuotientGroup.eq_one_iff, SpecialLinearGroup.mem_center_iff_eq_one_or_eq_neg_one]
  rintro (hone | hneg)
  · simpa [htr2] using congrArg (fun g : SL(2, ℤ) ↦ (g : Matrix (Fin 2) (Fin 2) ℤ).trace) hone
  · exact F.freeSideSL_ne_neg_one hxs hij hneg

/-- When ordered sides `i < j` of `F` do not share a cusp, `F.freeSideSL i j` has `|trace| ≥ 3`
and is therefore hyperbolic. -/
theorem freeSideSL_isHyperbolic_of_lt_of_not_sharesCusp {F : FareySymbol}
    {i j : Fin F.labels.length} (hij : i < j) (hnsc : ¬ F.SharesCusp i j) :
    (F.freeSideSL i j : Matrix (Fin 2) (Fin 2) ℤ).IsHyperbolic := by
  have hlen := F.labels_length
  have helen := F.endpoints_length
  have hnot : ¬ (i.val + 1 = j.val ∨ (i.val = 0 ∧ j.val = F.xs.length)) :=
    mt (F.sharesCusp_iff_of_lt hij).mpr hnsc
  set u := F.leftEndpoint i; set v := F.rightEndpoint i
  set u' := F.leftEndpoint j; set v' := F.rightEndpoint j
  set X := u'.1 * u.2 - u.1 * u'.2; set Y := v'.1 * v.2 - v.1 * v'.2
  set P := v'.1 * u.2 - u.1 * v'.2; set N := u'.1 * v.2 - v.1 * u'.2
  have hX : 1 ≤ X := F.det_endpoints_pos (k := i.val) (l := j.val) hij (by omega) (by omega)
  have hY : 1 ≤ Y := F.det_endpoints_pos (k := i.val + 1) (l := j.val + 1)
    (Nat.add_lt_add_right hij 1) (by omega) (by omega)
  have hP1 : 1 ≤ P := F.det_endpoints_pos (k := i.val) (l := j.val + 1)
    (by omega) (by omega) (by omega)
  have hN1 : 1 ≤ N := F.det_endpoints_pos (k := i.val + 1) (l := j.val)
    (by omega) (by omega) (by omega)
  have hXY2 : 2 ≤ X * Y := by
    have hid : X * Y - P * N = (v.1 * u.2 - u.1 * v.2) * (v'.1 * u'.2 - u'.1 * v'.2) := by ring
    have hPN1 : 1 ≤ P * N := by simpa using mul_le_mul hP1 hN1 zero_le_one (by omega)
    rw [F.unimodular_endpoints i, F.unimodular_endpoints j] at hid; linarith
  have hsum3 : 3 ≤ X + Y := by
    rcases eq_or_ne X 1 with hX1 | hX1
    · rw [hX1, one_mul] at hXY2; omega
    · omega
  have htr : (F.freeSideSL i j : Matrix (Fin 2) (Fin 2) ℤ).trace = -(X + Y) := by
    rw [freeSideSL, coe_freeSL, trace_freeGenerator]; ring
  rw [isHyperbolic_iff_two_lt_abs_trace (F.freeSideSL i j).det_coe, htr, abs_neg,
    abs_of_nonneg (by omega)]
  omega

/-- On distinct sides `i ≠ j` of `F` with `1 < F.xs.length`, `F.freeSideSL i j` is parabolic in
`PSL(2, ℤ)` if and only if sides `i` and `j` share a cusp. -/
theorem freeSideSL_isParabolic_iff {F : FareySymbol} {i j : Fin F.labels.length}
    (hxs : 1 < F.xs.length) (hne : i ≠ j) :
    Matrix.ProjectiveSpecialLinearGroup.IsParabolic (F.freeSideSL i j : PSL(2, ℤ)) ↔
      F.SharesCusp i j := by
  suffices ∀ {i j : Fin F.labels.length}, i < j →
      (Matrix.ProjectiveSpecialLinearGroup.IsParabolic (F.freeSideSL i j : PSL(2, ℤ)) ↔
        F.SharesCusp i j) by
    rcases lt_or_gt_of_ne hne with hij | hji
    · exact this hij
    · rw [freeSideSL, coe_freeSL_swap, Matrix.ProjectiveSpecialLinearGroup.isParabolic_inv_iff,
        sharesCusp_comm]
      exact this hji
  intro i j hij
  by_cases hsc : F.SharesCusp i j
  · exact ⟨fun _ ↦ hsc, fun _ ↦ F.freeSideSL_isParabolic_of_lt_of_sharesCusp hxs hij hsc⟩
  · refine ⟨fun hpar ↦ False.elim ?_, fun h ↦ False.elim (hsc h)⟩
    have hhyp := F.freeSideSL_isHyperbolic_of_lt_of_not_sharesCusp hij hsc
    rw [Matrix.ProjectiveSpecialLinearGroup.isParabolic_mk_iff,
      GeneralLinearGroup.IsParabolic, SpecialLinearGroup.coe_GL_coe_matrix] at hpar
    exact hhyp.ne hpar.2.symm

/-- On distinct sides `i ≠ j` of `F` with `1 < F.xs.length`, `F.freeSideSL i j` is hyperbolic if
and only if sides `i` and `j` do not share a cusp. -/
theorem freeSideSL_isHyperbolic_iff {F : FareySymbol} {i j : Fin F.labels.length}
    (hxs : 1 < F.xs.length) (hne : i ≠ j) :
    (F.freeSideSL i j : Matrix (Fin 2) (Fin 2) ℤ).IsHyperbolic ↔ ¬ F.SharesCusp i j := by
  suffices ∀ {i j : Fin F.labels.length}, i < j →
      ((F.freeSideSL i j : Matrix (Fin 2) (Fin 2) ℤ).IsHyperbolic ↔ ¬ F.SharesCusp i j) by
    rcases lt_or_gt_of_ne hne with hij | hji
    · exact this hij
    · have htr : |(F.freeSideSL i j : Matrix (Fin 2) (Fin 2) ℤ).trace| =
          |(F.freeSideSL j i : Matrix (Fin 2) (Fin 2) ℤ).trace| := by
        rw [freeSideSL, freeSideSL, coe_freeSL, coe_freeSL, trace_freeGenerator,
          trace_freeGenerator, ← abs_neg]
        congr 1; ring
      rw [isHyperbolic_iff_two_lt_abs_trace (F.freeSideSL i j).det_coe, htr,
        ← isHyperbolic_iff_two_lt_abs_trace (F.freeSideSL j i).det_coe, sharesCusp_comm]
      exact this hji
  intro i j hij
  by_cases hsc : F.SharesCusp i j
  · refine ⟨fun hhyp ↦ False.elim ?_, fun hnsc ↦ False.elim (hnsc hsc)⟩
    have hpar := F.freeSideSL_isParabolic_of_lt_of_sharesCusp hxs hij hsc
    rw [Matrix.ProjectiveSpecialLinearGroup.isParabolic_mk_iff,
      GeneralLinearGroup.IsParabolic, SpecialLinearGroup.coe_GL_coe_matrix] at hpar
    exact hhyp.ne hpar.2.symm
  · exact ⟨fun _ ↦ hsc, fun _ ↦ F.freeSideSL_isHyperbolic_of_lt_of_not_sharesCusp hij hsc⟩

/-- Every free-pair generator of a Farey symbol `F` is either hyperbolic or parabolic (with no
auxiliary length hypothesis, since the presence of a free label implies `1 < F.xs.length`). -/
theorem freeSideSL_isHyperbolic_or_isParabolic_of_free_pair {F : FareySymbol}
    {i j : Fin F.labels.length} {l : ℕ} (hne : i ≠ j) (hi : F.labels[i] = .free l) :
    (F.freeSideSL i j : Matrix (Fin 2) (Fin 2) ℤ).IsHyperbolic ∨
      Matrix.ProjectiveSpecialLinearGroup.IsParabolic (F.freeSideSL i j : PSL(2, ℤ)) := by
  have hxs : 1 < F.xs.length := F.one_lt_xs_length_of_free_mem (hi ▸ List.getElem_mem ..)
  by_cases hsc : F.SharesCusp i j
  · exact Or.inr ((F.freeSideSL_isParabolic_iff hxs hne).mpr hsc)
  · exact Or.inl ((F.freeSideSL_isHyperbolic_iff hxs hne).mpr hsc)

private theorem isParabolic_map_rat {A : SL(2, ℤ)}
    (hpar : Matrix.ProjectiveSpecialLinearGroup.IsParabolic (A : PSL(2, ℤ))) :
    Matrix.ProjectiveSpecialLinearGroup.IsParabolic
      (SpecialLinearGroup.map (Int.castRingHom ℚ) A : PSL(2, ℚ)) := by
  rw [Matrix.ProjectiveSpecialLinearGroup.isParabolic_mk_iff] at hpar ⊢
  rcases hpar with ⟨hns, hdisc⟩
  refine ⟨fun ⟨r, hr⟩ ↦ hns ?_, ?_⟩
  · rw [Matrix.scalar_apply] at hr
    have h00 : ((A 0 0 : ℤ) : ℚ) = r := by
      simpa [SpecialLinearGroup.map_apply_coe] using (congr_fun (congr_fun hr 0) 0).symm
    refine ⟨A 0 0, ?_⟩
    rw [Matrix.scalar_apply]
    ext p q
    have hpq := congr_fun (congr_fun hr p) q
    fin_cases p <;> fin_cases q
    · simp
    · have hpq' : A 0 1 = 0 := by simpa [SpecialLinearGroup.map_apply_coe] using hpq.symm
      simpa using hpq'.symm
    · have hpq' : A 1 0 = 0 := by simpa [SpecialLinearGroup.map_apply_coe] using hpq.symm
      simpa using hpq'.symm
    · have hpq' : r = ((A 1 1 : ℤ) : ℚ) := by
        simpa [SpecialLinearGroup.map_apply_coe] using hpq
      simpa using Int.cast_injective (α := ℚ) (h00.trans hpq')
  · simp only [SpecialLinearGroup.coe_GL_coe_matrix, SpecialLinearGroup.map_apply_coe,
      RingHom.mapMatrix_apply, Matrix.map_apply, Int.coe_castRingHom, Matrix.discr_fin_two,
      Matrix.trace_fin_two, Matrix.det_fin_two] at hdisc ⊢
    exact_mod_cast hdisc

/-- On distinct sides `i ≠ j` of `F` with `1 < F.xs.length`, `(F.freeSideSL i j : PSL(2, ℤ))` has
infinite order. -/
theorem not_isOfFinOrder_coe_freeSideSL {F : FareySymbol} {i j : Fin F.labels.length}
    (hxs : 1 < F.xs.length) (hne : i ≠ j) :
    ¬ IsOfFinOrder (F.freeSideSL i j : PSL(2, ℤ)) := by
  by_cases hsc : F.SharesCusp i j
  · have hparQ := isParabolic_map_rat ((F.freeSideSL_isParabolic_iff hxs hne).mpr hsc)
    set AQ : SL(2, ℚ) := SpecialLinearGroup.map (Int.castRingHom ℚ) (F.freeSideSL i j)
    rw [isOfFinOrder_iff_pow_eq_one]
    rintro ⟨n, hn, hpow⟩
    rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff,
      SpecialLinearGroup.mem_center_iff_eq_one_or_eq_neg_one] at hpow
    have hpowQ : (AQ : PSL(2, ℚ)) ^ n = 1 := by
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff,
        SpecialLinearGroup.mem_center_iff_eq_one_or_eq_neg_one]
      rcases hpow with h1 | hneg1
      · left; simpa [AQ, ← map_pow] using congrArg (SpecialLinearGroup.map (Int.castRingHom ℚ)) h1
      · right
        have hm := congrArg (SpecialLinearGroup.map (Int.castRingHom ℚ)) hneg1
        rw [map_pow] at hm
        refine hm.trans ?_
        ext p q; fin_cases p <;> fin_cases q <;> simp
    exact (hparQ.pow hn.ne').ne_one hpowQ
  · exact Matrix.ProjectiveSpecialLinearGroup.not_isOfFinOrder_mk_of_isHyperbolic
      ((F.freeSideSL_isHyperbolic_iff hxs hne).mpr hsc)

/-! ### The generated modular subgroup and its symmetries -/

/-- The generating set of `F` in `PSL(2, ℤ)`: the classes of `evenSideSL` on even sides,
`oddSideSL` on odd sides, and `freeSideSL` on distinct free-paired sides. -/
def generatorSet (F : FareySymbol) : Set PSL(2, ℤ) :=
  {g : PSL(2, ℤ) | ∃ i : Fin F.labels.length,
    (F.labels[i] = .even ∧ g = (F.evenSideSL i : PSL(2, ℤ))) ∨
    (F.labels[i] = .odd ∧ g = (F.oddSideSL i : PSL(2, ℤ))) ∨
    (∃ j : Fin F.labels.length, ∃ l : ℕ, i ≠ j ∧
      F.labels[i] = .free l ∧ F.labels[j] = .free l ∧
      g = (F.freeSideSL i j : PSL(2, ℤ)))}

/-- The oriented generating set of `F` in `PSL(2, ℤ)`, taking only `i < j` for each free pair. -/
def orderedGeneratorSet (F : FareySymbol) : Set PSL(2, ℤ) :=
  {g : PSL(2, ℤ) | ∃ i : Fin F.labels.length,
    (F.labels[i] = .even ∧ g = (F.evenSideSL i : PSL(2, ℤ))) ∨
    (F.labels[i] = .odd ∧ g = (F.oddSideSL i : PSL(2, ℤ))) ∨
    (∃ j : Fin F.labels.length, ∃ l : ℕ, i < j ∧
      F.labels[i] = .free l ∧ F.labels[j] = .free l ∧
      g = (F.freeSideSL i j : PSL(2, ℤ)))}

/-- **The modular subgroup generated by a Farey symbol `F`** inside `PSL(2, ℤ)`. -/
def group (F : FareySymbol) : Subgroup PSL(2, ℤ) :=
  Subgroup.closure F.generatorSet

theorem group_def (F : FareySymbol) : F.group = Subgroup.closure F.generatorSet := (rfl)

/-- Keeping only the `i < j` orientation of each free pair generates the same subgroup `F.group`,
since reversing the order inverts the projective generator (`coe_freeSL_swap`). -/
theorem group_eq_closure_orderedGeneratorSet (F : FareySymbol) :
    F.group = Subgroup.closure F.orderedGeneratorSet := by
  apply le_antisymm
  · rw [group_def, Subgroup.closure_le]
    rintro g ⟨i, ⟨hi, rfl⟩ | ⟨hi, rfl⟩ | ⟨j, l, hne, hi, hj, rfl⟩⟩
    · exact Subgroup.subset_closure ⟨i, Or.inl ⟨hi, rfl⟩⟩
    · exact Subgroup.subset_closure ⟨i, Or.inr (Or.inl ⟨hi, rfl⟩)⟩
    · rcases lt_or_gt_of_ne hne with hij | hji
      · exact Subgroup.subset_closure ⟨i, Or.inr (Or.inr ⟨j, l, hij, hi, hj, rfl⟩)⟩
      · rw [freeSideSL, coe_freeSL_swap]
        exact inv_mem (Subgroup.subset_closure ⟨j, Or.inr (Or.inr ⟨i, l, hji, hj, hi, rfl⟩)⟩)
  · exact Subgroup.closure_mono fun g ⟨i, h⟩ ↦ ⟨i, h.imp id (Or.imp id fun ⟨j, l, hij, hi, hj, hg⟩ ↦
      ⟨j, l, hij.ne, hi, hj, hg⟩)⟩

/-- Agreement of `F.group` with closure of the matrix-equality specification in `SL(2, ℤ)`. -/
theorem group_eq_closure_matrix (F : FareySymbol) :
    F.group = Subgroup.closure (((↑) : SL(2, ℤ) → PSL(2, ℤ)) '' {g : SL(2, ℤ) |
      ∃ i : Fin F.labels.length,
        let a := F.leftEndpoint i
        let b := F.rightEndpoint i
        (F.labels[i] = .even ∧ (g : Matrix (Fin 2) (Fin 2) ℤ) = evenGenerator a.1 a.2 b.1 b.2) ∨
        (F.labels[i] = .odd ∧ (g : Matrix (Fin 2) (Fin 2) ℤ) = oddGenerator a.1 a.2 b.1 b.2) ∨
        (∃ j : Fin F.labels.length, ∃ l : ℕ, i ≠ j ∧
          F.labels[i] = .free l ∧ F.labels[j] = .free l ∧
          (g : Matrix (Fin 2) (Fin 2) ℤ) =
            freeGenerator a.1 a.2 b.1 b.2
              (F.leftEndpoint j).1 (F.leftEndpoint j).2
              (F.rightEndpoint j).1 (F.rightEndpoint j).2)}) := by
  rw [group_def]
  refine congrArg Subgroup.closure (Set.ext fun x ↦ ⟨?_, ?_⟩)
  · rintro ⟨i, ⟨hi, rfl⟩ | ⟨hi, rfl⟩ | ⟨j, l, hne, hi, hj, rfl⟩⟩
    · exact ⟨F.evenSideSL i, ⟨i, Or.inl ⟨hi, rfl⟩⟩, rfl⟩
    · exact ⟨F.oddSideSL i, ⟨i, Or.inr (Or.inl ⟨hi, rfl⟩)⟩, rfl⟩
    · exact ⟨F.freeSideSL i j, ⟨i, Or.inr (Or.inr ⟨j, l, hne, hi, hj, rfl⟩)⟩, rfl⟩
  · rintro ⟨g, ⟨i, ⟨hi, hg⟩ | ⟨hi, hg⟩ | ⟨j, l, hne, hi, hj, hg⟩⟩, rfl⟩
    · exact ⟨i, Or.inl ⟨hi, congrArg _ (Subtype.ext hg)⟩⟩
    · exact ⟨i, Or.inr (Or.inl ⟨hi, congrArg _ (Subtype.ext hg)⟩)⟩
    · exact ⟨i, Or.inr (Or.inr ⟨j, l, hne, hi, hj, congrArg _ (Subtype.ext hg)⟩)⟩

/-- Translating a Farey symbol `F` by `k ∈ ℤ` multiplies every `sideLiftSL` on the left by
`T ^ k`. -/
theorem sideLiftSL_translate (k : ℤ) (F : FareySymbol) (i : Fin (F.translate k).labels.length) :
    (F.translate k).sideLiftSL i = ModularGroup.T ^ k * F.sideLiftSL (i.cast (by simp)) := by
  ext p q
  fin_cases p <;> fin_cases q <;>
    simp [sideLiftSL, ModularGroup.coe_T_zpow, leftEndpoint_translate, rightEndpoint_translate]
  ring

theorem evenSideSL_translate (k : ℤ) (F : FareySymbol) (i : Fin (F.translate k).labels.length) :
    (F.translate k).evenSideSL i =
      ModularGroup.T ^ k * F.evenSideSL (i.cast (by simp)) * (ModularGroup.T ^ k)⁻¹ := by
  rw [evenSideSL, evenSideSL, evenSL_eq_conj_S_inv, evenSL_eq_conj_S_inv, ← sideLiftSL_def,
    sideLiftSL_translate, _root_.mul_inv_rev]
  simp [sideLiftSL_def, mul_assoc]

theorem oddSideSL_translate (k : ℤ) (F : FareySymbol) (i : Fin (F.translate k).labels.length) :
    (F.translate k).oddSideSL i =
      ModularGroup.T ^ k * F.oddSideSL (i.cast (by simp)) * (ModularGroup.T ^ k)⁻¹ := by
  rw [oddSideSL, oddSideSL, oddSL_eq_conj_R_inv, oddSL_eq_conj_R_inv, ← sideLiftSL_def,
    sideLiftSL_translate, _root_.mul_inv_rev]
  simp [sideLiftSL_def, mul_assoc]

theorem freeSideSL_translate (k : ℤ) (F : FareySymbol)
    (i j : Fin (F.translate k).labels.length) :
    (F.translate k).freeSideSL i j =
      ModularGroup.T ^ k * F.freeSideSL (i.cast (by simp)) (j.cast (by simp)) *
        (ModularGroup.T ^ k)⁻¹ := by
  rw [freeSideSL, freeSideSL, freeSL_eq_sideSL_mul_S_inv_mul_inv,
    freeSL_eq_sideSL_mul_S_inv_mul_inv, ← sideLiftSL_def, ← sideLiftSL_def,
    sideLiftSL_translate, sideLiftSL_translate, _root_.mul_inv_rev]
  simp [sideLiftSL_def, mul_assoc]

/-- **Translation covariance of `FareySymbol.group`**: translating `F` by `k ∈ ℤ` conjugates
`F.group` by `(T : PSL(2, ℤ)) ^ k`. -/
theorem translate_group (k : ℤ) (F : FareySymbol) :
    (F.translate k).group =
      F.group.map (MulAut.conj ((ModularGroup.T : PSL(2, ℤ)) ^ k)).toMonoidHom := by
  suffices hle : ∀ (m : ℤ) (G : FareySymbol),
      (G.translate m).group ≤
        G.group.map (MulAut.conj ((ModularGroup.T : PSL(2, ℤ)) ^ m)).toMonoidHom by
    refine le_antisymm (hle k F) ?_
    have h := Subgroup.map_mono
      (f := (MulAut.conj ((ModularGroup.T : PSL(2, ℤ)) ^ k)).toMonoidHom) (hle (-k) (F.translate k))
    rw [← translate_add, neg_add_cancel, translate_zero, Subgroup.map_map] at h
    have hid : (MulAut.conj ((ModularGroup.T : PSL(2, ℤ)) ^ k)).toMonoidHom.comp
        (MulAut.conj ((ModularGroup.T : PSL(2, ℤ)) ^ (-k))).toMonoidHom = MonoidHom.id _ := by
      refine MonoidHom.ext fun x ↦ ?_
      rw [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.coe_toMonoidHom,
        ← MulAut.mul_apply, ← map_mul, ← _root_.zpow_add, add_neg_cancel, _root_.zpow_zero, map_one]
      rfl
    rwa [hid, Subgroup.map_id] at h
  intro m G
  rw [group_def, Subgroup.closure_le]
  rintro x ⟨i, ⟨hi, rfl⟩ | ⟨hi, rfl⟩ | ⟨j, l, hne, hi, hj, rfl⟩⟩
  · let i' : Fin G.labels.length := i.cast (by simp)
    refine ⟨(G.evenSideSL i' : PSL(2, ℤ)),
      Subgroup.subset_closure ⟨i', Or.inl ⟨by simpa [i'] using hi, rfl⟩⟩, ?_⟩
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, evenSideSL_translate, QuotientGroup.mk_mul,
      QuotientGroup.mk_mul, QuotientGroup.mk_inv, QuotientGroup.mk_zpow]
  · let i' : Fin G.labels.length := i.cast (by simp)
    refine ⟨(G.oddSideSL i' : PSL(2, ℤ)),
      Subgroup.subset_closure ⟨i', Or.inr (Or.inl ⟨by simpa [i'] using hi, rfl⟩)⟩, ?_⟩
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, oddSideSL_translate, QuotientGroup.mk_mul,
      QuotientGroup.mk_mul, QuotientGroup.mk_inv, QuotientGroup.mk_zpow]
  · let i' : Fin G.labels.length := i.cast (by simp)
    let j' : Fin G.labels.length := j.cast (by simp)
    have hne' : i' ≠ j' := fun h ↦ hne (Fin.ext (by simpa [i', j'] using congrArg Fin.val h))
    refine ⟨(G.freeSideSL i' j' : PSL(2, ℤ)),
      Subgroup.subset_closure
        ⟨i', Or.inr (Or.inr ⟨j', l, hne', by simpa [i'] using hi, by simpa [j'] using hj, rfl⟩)⟩,
      ?_⟩
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, freeSideSL_translate, QuotientGroup.mk_mul,
      QuotientGroup.mk_mul, QuotientGroup.mk_inv, QuotientGroup.mk_zpow]

/-- Reflecting a Farey symbol `F` replaces side `i`'s positive-determinant lift by
`conjJ (F.sideLiftSL i.rev) * S⁻¹`. -/
theorem sideLiftSL_reflect (F : FareySymbol) (i : Fin F.reflect.labels.length) :
    F.reflect.sideLiftSL i =
      SpecialLinearGroup.conjJ (F.sideLiftSL (i.rev.cast (by simp))) * ModularGroup.S⁻¹ := by
  ext p q
  fin_cases p <;> fin_cases q <;>
    simp [sideLiftSL, S_inv_eq_sideSL, F.leftEndpoint_reflect i, F.rightEndpoint_reflect i]

private theorem conjJ_S :
    SpecialLinearGroup.conjJ ModularGroup.S = -ModularGroup.S := by
  ext p q
  fin_cases p <;> fin_cases q <;> simp [ModularGroup.coe_S]

private theorem S_inv_mul_R_inv_mul_S :
    ModularGroup.S⁻¹ * (TauCeti.ModularGroup.R⁻¹ * ModularGroup.S) =
      SpecialLinearGroup.conjJ TauCeti.ModularGroup.R := by
  ext p q
  fin_cases p <;> fin_cases q <;>
    simp [S_inv_eq_sideSL, R_inv_eq_sideSL, ModularGroup.coe_S, TauCeti.ModularGroup.coe_R,
      Matrix.mul_apply, Fin.sum_univ_two]

theorem evenSideSL_reflect (F : FareySymbol) (i : Fin F.reflect.labels.length) :
    F.reflect.evenSideSL i = -SpecialLinearGroup.conjJ (F.evenSideSL (i.rev.cast (by simp))) := by
  rw [evenSideSL, evenSideSL, evenSL_eq_conj_S_inv, evenSL_eq_conj_S_inv, ← sideLiftSL_def,
    ← sideLiftSL_def, sideLiftSL_reflect]
  simp [_root_.mul_inv_rev, mul_assoc, conjJ_S]

theorem oddSideSL_reflect (F : FareySymbol) (i : Fin F.reflect.labels.length) :
    F.reflect.oddSideSL i =
      SpecialLinearGroup.conjJ (F.oddSideSL (i.rev.cast (by simp)))⁻¹ := by
  rw [oddSideSL, oddSideSL, oddSL_eq_conj_R_inv, oddSL_eq_conj_R_inv, ← sideLiftSL_def,
    ← sideLiftSL_def, sideLiftSL_reflect]
  simp only [_root_.mul_inv_rev, inv_inv, SpecialLinearGroup.conjJ_mul,
    SpecialLinearGroup.conjJ_inv, ← S_inv_mul_R_inv_mul_S, mul_assoc]

theorem freeSideSL_reflect (F : FareySymbol) (i j : Fin F.reflect.labels.length) :
    F.reflect.freeSideSL i j =
      -SpecialLinearGroup.conjJ (F.freeSideSL (i.rev.cast (by simp)) (j.rev.cast (by simp))) := by
  rw [freeSideSL, freeSideSL, freeSL_eq_sideSL_mul_S_inv_mul_inv,
    freeSL_eq_sideSL_mul_S_inv_mul_inv, ← sideLiftSL_def, ← sideLiftSL_def,
    ← sideLiftSL_def, ← sideLiftSL_def, sideLiftSL_reflect, sideLiftSL_reflect]
  simp [_root_.mul_inv_rev, mul_assoc, conjJ_S]

/-- **Reflection covariance of `FareySymbol.group`**: reflecting `F` maps `F.group` by the
coordinate reflection `conjJ` (`diag(-1, 1)`) descended to `PSL(2, ℤ)`. -/
theorem reflect_group (F : FareySymbol) :
    F.reflect.group =
      F.group.map
        (QuotientGroup.congr _ _ SpecialLinearGroup.conjJMulAut
          (Subgroup.characteristic_iff_map_eq.1 inferInstance _)).toMonoidHom := by
  let φ : PSL(2, ℤ) ≃* PSL(2, ℤ) :=
    QuotientGroup.congr _ _ SpecialLinearGroup.conjJMulAut
      (Subgroup.characteristic_iff_map_eq.1 inferInstance _)
  have hφ_mk : ∀ A : SL(2, ℤ), φ (A : PSL(2, ℤ)) = (SpecialLinearGroup.conjJ A : PSL(2, ℤ)) :=
    fun A ↦ (QuotientGroup.congr_mk (x := A) ..).trans
      (congrArg _ (SpecialLinearGroup.conjJMulAut_apply A))
  have hmk_neg : ∀ A : SL(2, ℤ), ((-A : SL(2, ℤ)) : PSL(2, ℤ)) = (A : PSL(2, ℤ)) := fun A ↦
    (Matrix.ProjectiveSpecialLinearGroup.mk_eq_mk_iff.mpr (Or.inr rfl)).symm
  suffices hle : ∀ G : FareySymbol, G.reflect.group ≤ G.group.map φ.toMonoidHom by
    refine le_antisymm (hle F) ?_
    have h := Subgroup.map_mono (f := φ.toMonoidHom) (hle F.reflect)
    rw [reflect_reflect, Subgroup.map_map] at h
    have hφ2 : φ.toMonoidHom.comp φ.toMonoidHom = MonoidHom.id _ := by
      ext A
      simp [QuotientGroup.mk'_apply, hφ_mk]
    rwa [hφ2, Subgroup.map_id] at h
  intro G
  rw [group_def, Subgroup.closure_le]
  rintro x ⟨i, ⟨hi, rfl⟩ | ⟨hi, rfl⟩ | ⟨j, l, hne, hi, hj, rfl⟩⟩
  · rw [evenSideSL_reflect, hmk_neg, ← hφ_mk]
    rw [G.getElem_reflect_labels] at hi
    exact Subgroup.mem_map_of_mem _ (Subgroup.subset_closure ⟨_, Or.inl ⟨hi, rfl⟩⟩)
  · rw [oddSideSL_reflect, ← hφ_mk, QuotientGroup.mk_inv, map_inv]
    rw [G.getElem_reflect_labels] at hi
    exact inv_mem (Subgroup.mem_map_of_mem _
      (Subgroup.subset_closure ⟨_, Or.inr (Or.inl ⟨hi, rfl⟩)⟩))
  · rw [freeSideSL_reflect, hmk_neg, ← hφ_mk]
    rw [G.getElem_reflect_labels] at hi hj
    have hne' : (i.rev.cast (by simp) : Fin G.labels.length) ≠ j.rev.cast (by simp) :=
      fun h ↦ hne (Fin.rev_injective (Fin.ext (by simpa using congrArg Fin.val h)))
    exact Subgroup.mem_map_of_mem _
      (Subgroup.subset_closure ⟨_, Or.inr (Or.inr ⟨_, l, hne', hi, hj, rfl⟩)⟩)

/-! ### Concrete subgroup identifications -/

/-- Coset-transversal criterion on `SL(2, ℤ)`: if `R : Fin n → SL(2, ℤ)` satisfies `R 0 = 1` and
both `S` and `T` permute the translates `R i` modulo left multiplication by `H`, then every element
of `SL(2, ℤ)` lies in one of the cosets `R i * H`. -/
private theorem exists_inv_mul_mem_of_perm_S_T {n : ℕ} [NeZero n] {H : Subgroup SL(2, ℤ)}
    (R : Fin n → SL(2, ℤ)) (hR0 : R 0 = 1)
    (hS : ∃ σ : Equiv.Perm (Fin n), ∀ i, (R (σ i))⁻¹ * ModularGroup.S * R i ∈ H)
    (hT : ∃ σ : Equiv.Perm (Fin n), ∀ i, (R (σ i))⁻¹ * ModularGroup.T * R i ∈ H)
    (k : SL(2, ℤ)) : ∃ i : Fin n, (R i)⁻¹ * k ∈ H := by
  let M : Subgroup SL(2, ℤ) :=
    { carrier := {g | ∃ σ : Equiv.Perm (Fin n), ∀ i, (R (σ i))⁻¹ * g * R i ∈ H}
      one_mem' := ⟨1, fun i ↦ by simp [one_mem]⟩
      mul_mem' := fun ⟨σ₁, h₁⟩ ⟨σ₂, h₂⟩ ↦
        ⟨σ₁ * σ₂, fun i ↦ by simpa [mul_assoc] using mul_mem (h₁ (σ₂ i)) (h₂ i)⟩
      inv_mem' := fun ⟨σ, h⟩ ↦
        ⟨σ⁻¹, fun i ↦ by simpa [mul_assoc] using inv_mem (h (σ⁻¹ i))⟩ }
  have hMtop : M = ⊤ := by
    rw [eq_top_iff, ← _root_.SpecialLinearGroup.SL2Z_generators, Subgroup.closure_le]
    exact Set.pair_subset hS hT
  obtain ⟨σ, hσ⟩ : k ∈ M := hMtop.symm ▸ Subgroup.mem_top k
  exact ⟨σ 0, by simpa [hR0] using hσ 0⟩

/-- The even generator on side `0` of `levelOne` (`(-1 / 0, 0 / 1)`) is `S⁻¹`. -/
theorem evenSideSL_levelOne_zero :
    levelOne.evenSideSL ⟨0, by decide⟩ = ModularGroup.S⁻¹ := by
  decide

/-- The odd generator on side `1` of `levelOne` (`(0 / 1, 1 / 0)`) is `-U`. -/
theorem oddSideSL_levelOne_one :
    levelOne.oddSideSL ⟨1, by decide⟩ = -TauCeti.ModularGroup.U := by
  ext p q
  fin_cases p <;> fin_cases q <;>
    simp [oddSideSL, oddSL, oddGenerator, levelOne, leftEndpoint, rightEndpoint, endpoints,
      TauCeti.ModularGroup.coe_U]

/-- The level-one Farey symbol generates the full modular group `PSL(2, ℤ)`. -/
@[simp]
theorem group_levelOne : levelOne.group = ⊤ := by
  rw [eq_top_iff, ← TauCeti.ModularGroup.closure_coe_S_coe_T, Subgroup.closure_le]
  have hS : (ModularGroup.S : PSL(2, ℤ)) ∈ levelOne.group := by
    rw [← TauCeti.ModularGroup.coe_S_inv, ← QuotientGroup.mk_inv, ← evenSideSL_levelOne_zero]
    exact Subgroup.subset_closure ⟨⟨0, by decide⟩, Or.inl ⟨rfl, rfl⟩⟩
  have hU : (TauCeti.ModularGroup.U : PSL(2, ℤ)) ∈ levelOne.group := by
    have hneg : ((-TauCeti.ModularGroup.U : SL(2, ℤ)) : PSL(2, ℤ)) = TauCeti.ModularGroup.U :=
      (Matrix.ProjectiveSpecialLinearGroup.mk_eq_mk_iff.mpr (Or.inr rfl)).symm
    rw [← hneg, ← oddSideSL_levelOne_one]
    exact Subgroup.subset_closure ⟨⟨1, by decide⟩, Or.inr (Or.inl ⟨rfl, rfl⟩)⟩
  have hT : (ModularGroup.T : PSL(2, ℤ)) ∈ levelOne.group := by
    have hinv : ((ModularGroup.T : PSL(2, ℤ)))⁻¹ =
        (ModularGroup.S : PSL(2, ℤ))⁻¹ * TauCeti.ModularGroup.U := by
      rw [← QuotientGroup.mk_inv, ← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul,
        TauCeti.ModularGroup.S_inv_mul_U]
    rw [← inv_inv (ModularGroup.T : PSL(2, ℤ)), hinv]
    exact inv_mem (mul_mem (inv_mem hS) hU)
  exact Set.pair_subset hS hT

/-- The free generator pairing sides `0` and `2` of `gamma0Two` is `-T`. -/
theorem freeSideSL_gamma0Two :
    gamma0Two.freeSideSL ⟨0, by decide⟩ ⟨2, by decide⟩ = -ModularGroup.T := by
  decide

/-- The even generator on side `1` (`(0 / 1, 1 / 1)`) of `gamma0Two` is `!![-1, 1; -2, 1]`. -/
theorem evenSideSL_gamma0Two :
    (gamma0Two.evenSideSL ⟨1, by decide⟩ : Matrix (Fin 2) (Fin 2) ℤ) = !![-1, 1; -2, 1] := by
