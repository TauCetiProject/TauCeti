/-- Every element in the preimage of `gamma0Two.group` in `SL(2, ℤ)` belongs to `Γ₀(2)`. -/
theorem comap_group_gamma0Two_le :
    gamma0Two.group.comap (QuotientGroup.mk' (Subgroup.center SL(2, ℤ))) ≤
      CongruenceSubgroup.Gamma0 2 := by
  set π := QuotientGroup.mk' (Subgroup.center SL(2, ℤ))
  have hfin : ∀ k : Fin gamma0Two.labels.length,
      k = ⟨0, by decide⟩ ∨ k = ⟨1, by decide⟩ ∨ k = ⟨2, by decide⟩ := by decide
  have hsub : gamma0Two.group ≤ (CongruenceSubgroup.Gamma0 2).map π := by
    rw [group_eq_closure_orderedGeneratorSet, Subgroup.closure_le]
    rintro x ⟨i, ⟨hi, rfl⟩ | ⟨hi, rfl⟩ | ⟨j, l, hij, hi, hj, rfl⟩⟩
    · rcases hfin i with rfl | rfl | rfl
      · exact absurd hi (by decide)
      · refine ⟨gamma0Two.evenSideSL ⟨1, by decide⟩,
          CongruenceSubgroup.mem_Gamma0_iff_dvd.mpr ?_, rfl⟩
        have he : (gamma0Two.evenSideSL ⟨1, by decide⟩ : Matrix (Fin 2) (Fin 2) ℤ) 1 0 = -2 := by
          rw [evenSideSL_gamma0Two]; rfl
        rw [he]
        decide
      · exact absurd hi (by decide)
    · rcases hfin i with rfl | rfl | rfl <;> exact absurd hi (by decide)
    · rcases hfin i with rfl | rfl | rfl <;> rcases hfin j with rfl | rfl | rfl
      all_goals
        try first
          | exact absurd hij (by decide)
          | exact absurd (hi.trans hj.symm) (by decide)
      refine ⟨gamma0Two.freeSideSL ⟨0, by decide⟩ ⟨2, by decide⟩,
        CongruenceSubgroup.mem_Gamma0_iff_dvd.mpr ?_, rfl⟩
      rw [freeSideSL_gamma0Two]
      simp [ModularGroup.coe_T]
  intro g hg
  obtain ⟨u, hu, hug⟩ := hsub hg
  have hcent : u⁻¹ * g ∈ Subgroup.center SL(2, ℤ) := QuotientGroup.eq.mp hug
  rw [SpecialLinearGroup.mem_center_iff_eq_one_or_eq_neg_one] at hcent
  rcases hcent with h1 | hneg
  · rwa [← inv_mul_eq_one.mp h1]
  · rw [inv_mul_eq_iff_eq_mul.mp hneg, mul_neg_one]
    exact neg_eq_neg_one_mul u ▸ mul_mem CongruenceSubgroup.neg_one_mem_Gamma0 hu

/-- The preimage of `gamma0Two.group` in `SL(2, ℤ)` is `CongruenceSubgroup.Gamma0 2`. -/
theorem comap_group_gamma0Two :
    gamma0Two.group.comap (QuotientGroup.mk' (Subgroup.center SL(2, ℤ))) =
      CongruenceSubgroup.Gamma0 2 := by
  set π := QuotientGroup.mk' (Subgroup.center SL(2, ℤ))
  set H := gamma0Two.group.comap π
  refine le_antisymm comap_group_gamma0Two_le ?_
  let a : SL(2, ℤ) := gamma0Two.freeSideSL ⟨0, by decide⟩ ⟨2, by decide⟩
  let b : SL(2, ℤ) := gamma0Two.evenSideSL ⟨1, by decide⟩
  have ha : a ∈ H := Subgroup.subset_closure ⟨⟨0, by decide⟩,
    Or.inr (Or.inr ⟨⟨2, by decide⟩, 1, by decide, rfl, rfl, rfl⟩)⟩
  have hb : b ∈ H := Subgroup.subset_closure ⟨⟨1, by decide⟩, Or.inl ⟨rfl, rfl⟩⟩
  have hneg1 : (-1 : SL(2, ℤ)) ∈ H := Subgroup.mem_comap.mpr <| by
    rw [QuotientGroup.mk'_apply,
      (Matrix.ProjectiveSpecialLinearGroup.mk_eq_mk_iff.mpr (Or.inr rfl)).symm,
      QuotientGroup.mk_one]
    exact one_mem _
  have mem_eq {x y : SL(2, ℤ)} (hxy : x = y) (hy : y ∈ H) : x ∈ H := hxy ▸ hy
  let R : Fin 3 → SL(2, ℤ) := ![1, ModularGroup.S, ModularGroup.T * ModularGroup.S]
  have hSM : ∃ σ : Equiv.Perm (Fin 3), ∀ i, (R (σ i))⁻¹ * ModularGroup.S * R i ∈ H :=
    ⟨Equiv.swap 0 1, fun i ↦ by
      fin_cases i
      · exact mem_eq (by decide) (one_mem H)
      · exact mem_eq (by decide) hneg1
      · exact mem_eq (by decide) (inv_mem hb)⟩
  have hTM : ∃ σ : Equiv.Perm (Fin 3), ∀ i, (R (σ i))⁻¹ * ModularGroup.T * R i ∈ H :=
    ⟨Equiv.swap 1 2, fun i ↦ by
      fin_cases i
      · exact mem_eq (by decide) (mul_mem hneg1 ha)
      · exact mem_eq (by decide) (one_mem H)
      · exact mem_eq (by decide) (mul_mem (inv_mem ha) (inv_mem hb))⟩
  intro k hk
  obtain ⟨idx, h0⟩ := exists_inv_mul_mem_of_perm_S_T R rfl hSM hTM k
  have hk' : (2 : ℤ) ∣ ((R idx)⁻¹ * k) 1 0 :=
    CongruenceSubgroup.mem_Gamma0_iff_dvd.mp (comap_group_gamma0Two_le h0)
  have hk10 : (2 : ℤ) ∣ k 1 0 := CongruenceSubgroup.mem_Gamma0_iff_dvd.mp hk
  have hk00 : ¬ (2 : ℤ) ∣ k 0 0 := by
    rintro ⟨m, hm⟩
    rcases hk10 with ⟨n, hn⟩
    have hdet : k 0 0 * k 1 1 - k 0 1 * k 1 0 = 1 := by
      rw [← Matrix.det_fin_two]
      exact k.det_coe
    have h2 : 2 * (m * k 1 1 - k 0 1 * n) = 1 :=
      (by rw [hm, hn]; ring :
        2 * (m * k 1 1 - k 0 1 * n) = k 0 0 * k 1 1 - k 0 1 * k 1 0).trans hdet
    omega
  rcases (by decide : ∀ i : Fin 3, i = 0 ∨ i = 1 ∨ i = 2) idx with rfl | rfl | rfl
  · simpa [R] using h0
  · exfalso
    have hentry : ((R 1)⁻¹ * k) 1 0 = -k 0 0 := by
      simp [R, S_inv_eq_sideSL, Matrix.mul_apply, Fin.sum_univ_two]
    rw [hentry, dvd_neg] at hk'
    exact hk00 hk'
  · exfalso
    have hTS : (ModularGroup.T * ModularGroup.S)⁻¹ =
        sideSL (a := 0) (b := 1) (c := 1) (d := 1) (by ring) := by decide
    have hentry : ((R 2)⁻¹ * k) 1 0 = -k 0 0 + k 1 0 := by
      simp [R, hTS, Matrix.mul_apply, Fin.sum_univ_two]
    rw [hentry] at hk'
    rcases hk10 with ⟨n, hn⟩
    rcases hk' with ⟨m, hm⟩
    exact hk00 ⟨n - m, by omega⟩

/-- The index of `gamma0Two.group` in `PSL(2, ℤ)` is `3`. -/
@[simp]
theorem index_group_gamma0Two : gamma0Two.group.index = 3 := by
  rw [← Subgroup.index_comap_of_surjective _ (QuotientGroup.mk'_surjective _),
    comap_group_gamma0Two]
  exact CongruenceSubgroup.Gamma0_prime_index 2 Nat.prime_two

private theorem intCast_zmod_two_eq_one_iff (z : ℤ) :
    (z : ZMod 2) = 1 ↔ (2 : ℤ) ∣ z - 1 := by
  rw [← sub_eq_zero, ← Int.cast_one, ← Int.cast_sub, ZMod.intCast_zmod_eq_zero_iff_dvd]
  rfl

private theorem mem_Gamma_two_iff {A : SL(2, ℤ)} :
    A ∈ CongruenceSubgroup.Gamma 2 ↔
      (2 : ℤ) ∣ A 0 0 - 1 ∧ (2 : ℤ) ∣ A 0 1 ∧ (2 : ℤ) ∣ A 1 0 ∧ (2 : ℤ) ∣ A 1 1 - 1 :=
  CongruenceSubgroup.Gamma_mem.trans <| and_congr (intCast_zmod_two_eq_one_iff _) <|
    and_congr (ZMod.intCast_zmod_eq_zero_iff_dvd _ 2) <|
    and_congr (ZMod.intCast_zmod_eq_zero_iff_dvd _ 2) (intCast_zmod_two_eq_one_iff _)

/-- The outer free generator pairing sides `0` and `3` of `gammaTwo` is `-T²`. -/
theorem freeSideSL_gammaTwo_outer :
    gammaTwo.freeSideSL ⟨0, by decide⟩ ⟨3, by decide⟩ = -(ModularGroup.T ^ 2) := by
  decide

/-- The inner free generator pairing sides `1` and `2` of `gammaTwo` is `-!![3, -2; 2, -1]`. -/
theorem freeSideSL_gammaTwo_inner :
    (gammaTwo.freeSideSL ⟨1, by decide⟩ ⟨2, by decide⟩ : Matrix (Fin 2) (Fin 2) ℤ) =
      -!![3, -2; 2, -1] := by
  decide

/-- Every element in the preimage of `gammaTwo.group` in `SL(2, ℤ)` belongs to `Γ(2)`. -/
theorem comap_group_gammaTwo_le :
    gammaTwo.group.comap (QuotientGroup.mk' (Subgroup.center SL(2, ℤ))) ≤
      CongruenceSubgroup.Gamma 2 := by
  set π := QuotientGroup.mk' (Subgroup.center SL(2, ℤ))
  have hfin : ∀ k : Fin gammaTwo.labels.length,
      k = ⟨0, by decide⟩ ∨ k = ⟨1, by decide⟩ ∨ k = ⟨2, by decide⟩ ∨ k = ⟨3, by decide⟩ := by
    decide
  have hsub : gammaTwo.group ≤ (CongruenceSubgroup.Gamma 2).map π := by
    rw [group_eq_closure_orderedGeneratorSet, Subgroup.closure_le]
    rintro x ⟨i, ⟨hi, rfl⟩ | ⟨hi, rfl⟩ | ⟨j, l, hij, hi, hj, rfl⟩⟩
    · rcases hfin i with rfl | rfl | rfl | rfl <;> exact absurd hi (by decide)
    · rcases hfin i with rfl | rfl | rfl | rfl <;> exact absurd hi (by decide)
    · rcases hfin i with rfl | rfl | rfl | rfl <;> rcases hfin j with rfl | rfl | rfl | rfl
      all_goals
        try first
          | exact absurd hij (by decide)
          | exact absurd (hi.trans hj.symm) (by decide)
      · refine ⟨gammaTwo.freeSideSL ⟨0, by decide⟩ ⟨3, by decide⟩,
          mem_Gamma_two_iff.mpr ?_, rfl⟩
        rw [freeSideSL_gammaTwo_outer]
        norm_num [ModularGroup.coe_T, sq]
      · refine ⟨gammaTwo.freeSideSL ⟨1, by decide⟩ ⟨2, by decide⟩,
          mem_Gamma_two_iff.mpr ?_, rfl⟩
        have hM := freeSideSL_gammaTwo_inner
        have h00 : (gammaTwo.freeSideSL ⟨1, by decide⟩ ⟨2, by decide⟩ : SL(2, ℤ)) 0 0 = -3 := by
          rw [hM]; rfl
        have h01 : (gammaTwo.freeSideSL ⟨1, by decide⟩ ⟨2, by decide⟩ : SL(2, ℤ)) 0 1 = 2 := by
          rw [hM]; rfl
        have h10 : (gammaTwo.freeSideSL ⟨1, by decide⟩ ⟨2, by decide⟩ : SL(2, ℤ)) 1 0 = -2 := by
          rw [hM]; rfl
        have h11 : (gammaTwo.freeSideSL ⟨1, by decide⟩ ⟨2, by decide⟩ : SL(2, ℤ)) 1 1 = 1 := by
          rw [hM]; rfl
        rw [h00, h01, h10, h11]
        norm_num
  intro g hg
  obtain ⟨u, hu, hug⟩ := hsub hg
  have hcent : u⁻¹ * g ∈ Subgroup.center SL(2, ℤ) := QuotientGroup.eq.mp hug
  rw [SpecialLinearGroup.mem_center_iff_eq_one_or_eq_neg_one] at hcent
  rcases hcent with h1 | hneg
  · rwa [← inv_mul_eq_one.mp h1]
  · rw [inv_mul_eq_iff_eq_mul.mp hneg, mul_neg_one]
    have hneg1G : (-1 : SL(2, ℤ)) ∈ CongruenceSubgroup.Gamma 2 := by
      rw [mem_Gamma_two_iff]; norm_num
    exact neg_eq_neg_one_mul u ▸ mul_mem hneg1G hu

/-- The preimage of `gammaTwo.group` in `SL(2, ℤ)` is the principal congruence subgroup
`CongruenceSubgroup.Gamma 2`. -/
theorem comap_group_gammaTwo :
    gammaTwo.group.comap (QuotientGroup.mk' (Subgroup.center SL(2, ℤ))) =
      CongruenceSubgroup.Gamma 2 := by
  set π := QuotientGroup.mk' (Subgroup.center SL(2, ℤ))
  set H := gammaTwo.group.comap π
  refine le_antisymm comap_group_gammaTwo_le ?_
  let a : SL(2, ℤ) := gammaTwo.freeSideSL ⟨0, by decide⟩ ⟨3, by decide⟩
  let b : SL(2, ℤ) := gammaTwo.freeSideSL ⟨1, by decide⟩ ⟨2, by decide⟩
  have ha : a ∈ H := Subgroup.subset_closure ⟨⟨0, by decide⟩,
    Or.inr (Or.inr ⟨⟨3, by decide⟩, 2, by decide, rfl, rfl, rfl⟩)⟩
  have hb : b ∈ H := Subgroup.subset_closure ⟨⟨1, by decide⟩,
    Or.inr (Or.inr ⟨⟨2, by decide⟩, 1, by decide, rfl, rfl, rfl⟩)⟩
  have hneg1 : (-1 : SL(2, ℤ)) ∈ H := Subgroup.mem_comap.mpr <| by
    rw [QuotientGroup.mk'_apply,
      (Matrix.ProjectiveSpecialLinearGroup.mk_eq_mk_iff.mpr (Or.inr rfl)).symm,
      QuotientGroup.mk_one]
    exact one_mem _
  have mem_eq {x y : SL(2, ℤ)} (hxy : x = y) (hy : y ∈ H) : x ∈ H := hxy ▸ hy
  let R : Fin 6 → SL(2, ℤ) :=
    ![1, ModularGroup.S, ModularGroup.T, ModularGroup.S * ModularGroup.T,
      ModularGroup.T * ModularGroup.S, ModularGroup.S * ModularGroup.T * ModularGroup.S]
  let σS : Equiv.Perm (Fin 6) := Equiv.swap 0 1 * Equiv.swap 2 3 * Equiv.swap 4 5
  have hSM : ∃ σ : Equiv.Perm (Fin 6), ∀ i, (R (σ i))⁻¹ * ModularGroup.S * R i ∈ H :=
    ⟨σS, fun i ↦ by
      fin_cases i
      · exact mem_eq (by decide) (one_mem H)
      · exact mem_eq (by decide) hneg1
      · exact mem_eq (by decide) (one_mem H)
      · exact mem_eq (by decide) hneg1
      · exact mem_eq (by decide) (one_mem H)
      · exact mem_eq (by decide) hneg1⟩
  let σT : Equiv.Perm (Fin 6) := Equiv.swap 0 2 * Equiv.swap 1 4 * Equiv.swap 3 5
  have hTM : ∃ σ : Equiv.Perm (Fin 6), ∀ i, (R (σ i))⁻¹ * ModularGroup.T * R i ∈ H :=
    ⟨σT, fun i ↦ by
      fin_cases i
      · exact mem_eq (by decide) (one_mem H)
      · exact mem_eq (by decide) (one_mem H)
      · exact mem_eq (by decide) (mul_mem hneg1 ha)
      · exact mem_eq (by decide) (mul_mem (inv_mem hb) ha)
      · exact mem_eq (by decide) (mul_mem (mul_mem hneg1 (inv_mem ha)) hb)
      · exact mem_eq (by decide) (mul_mem hneg1 (inv_mem ha))⟩
  intro k hk
  obtain ⟨idx, h0⟩ := exists_inv_mul_mem_of_perm_S_T R rfl hSM hTM k
  have hk' : (R idx)⁻¹ * k ∈ CongruenceSubgroup.Gamma 2 := comap_group_gammaTwo_le h0
  have hRidx : R idx ∈ CongruenceSubgroup.Gamma 2 := by
    have hinv : (R idx)⁻¹ ∈ CongruenceSubgroup.Gamma 2 := by
      simpa using mul_mem hk' (inv_mem hk)
    simpa using inv_mem hinv
  rw [mem_Gamma_two_iff] at hRidx
  have hidx0 : idx = 0 := by
    fin_cases idx <;> first | rfl | exact absurd hRidx (by decide)
  simpa [hidx0, R] using h0

