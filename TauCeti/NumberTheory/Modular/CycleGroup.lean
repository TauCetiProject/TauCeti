/-!
# Quadratic cycle groups

Duke, Imamoglu and Tóth attach to a list of naturals `n = [n₁, …, n_ℓ]` the subgroup `Γ(n)` of
`PSL(2, ℤ)` generated by the translation `z ↦ z + m`, where `m = n₁ + ⋯ + n_ℓ`, and by the
half-turns about the points `N_k + i`, where `N_k = n₁ + ⋯ + n_k` are the prefix sums
(`0 ≤ k < ℓ`). When `n` is the primitive reduced minus period of a narrow ideal class of a real
quadratic field, Duke, Imamoglu and Tóth show that the quotient by `Γ(n)` of the convex hull of
its limit set is the surface they attach to that class.

The geometric theory of these groups (their Ford polygon, their free-product presentation and
their infinite index) assumes that `n` is *admissible*: nonempty, with every entry at least `2`
and some entry greater than `2`. This file sets up the raw construction and its elementary
algebra, which holds for every list:

* the half-turn `halfTurn c = Tᶜ S T⁻ᶜ` about `c + i`, its action `z ↦ c - 1 / (z - c)`, its
  fixed point `c + i` and its exact order two in `PSL(2, ℤ)`;
* the cycle group `cycleGroup n`, with membership of its generators and its universal property,
  and the fact that the half-turn about the final centre `N_ℓ + i = m + i` may replace the one
  about `i`;
* the set `cycleCenters n = {N_k + j m}` of integer centres: every half-turn about a centre lies
  in `Γ(n)`, and `Γ(n)` is generated by `Tᵐ` and these half-turns;
* rotation invariance: rotating the list by `r` conjugates the group by the translation
  `z ↦ z - N_r`, so lists that are cyclic rotations of each other give conjugate groups, both in
  `PSL(2, ℤ)` and, through the embedding `psl2zToPSL2R`, in `PSL(2, ℝ)`.

Admissibility is invariant under every permutation of the list, in particular under rotation.

## Main definitions

* `TauCeti.AdmissibleCycle`: a list of naturals is nonempty, has every entry at least `2` and
  some entry greater than `2`.
* `TauCeti.ModularGroup.halfTurn`: the half-turn `Tᶜ S T⁻ᶜ ∈ PSL(2, ℤ)` about `c + i`.
* `TauCeti.ModularGroup.cycleGroup`: the subgroup `Γ(n) ≤ PSL(2, ℤ)` generated by `Tᵐ` and the
  half-turns about the prefix-sum centres `N_k + i`, `0 ≤ k < ℓ`.
* `TauCeti.ModularGroup.cycleCenters`: the integer centres `N_k + j m`, `0 ≤ k < ℓ`, `j ∈ ℤ`.

## Main results

* `TauCeti.AdmissibleCycle.three_le_sum`: an admissible list has digit sum at least `3`.
* `List.Perm.admissibleCycle_iff`, `List.IsRotated.admissibleCycle_iff`: admissibility is
  invariant under permutation and rotation.
* `TauCeti.ModularGroup.coe_halfTurn_smul`, `TauCeti.ModularGroup.halfTurn_smul_vadd_I`,
  `TauCeti.ModularGroup.orderOf_halfTurn`: the action, fixed point and order of a half-turn.
* `TauCeti.ModularGroup.cycleGroup_le_iff`: the universal property of the cycle group.
* `TauCeti.ModularGroup.cycleGroup_singleton`: `Γ([a]) = ⟨Tᵃ, S⟩`.
* `TauCeti.ModularGroup.cycleGroup_eq_closure_succ`: the generating set with the centres
  `N₁, …, N_ℓ` gives the same group.
* `TauCeti.ModularGroup.cycleGroup_eq_closure_cycleCenters`: `Γ(n)` is generated by `Tᵐ` and the
  half-turns about all its centres.
* `TauCeti.ModularGroup.mem_cycleCenters_rotate_iff`: rotating the list by `r` shifts the centres
  by `-N_r`.
* `TauCeti.ModularGroup.map_conj_cycleGroup_rotate`: `Γ(n.rotate r) = T^(-N_r) Γ(n) T^(N_r)`.
* `List.IsRotated.exists_cycleGroup_eq_map_conj`: cyclic rotations give subgroups conjugate by an
  integral translation.
* `List.IsRotated.exists_map_conj_cycleGroup_eq`,
  `List.IsRotated.exists_map_conj_map_cycleGroup_eq`: cyclic rotations give subgroups conjugate
  in `PSL(2, ℤ)` and in `PSL(2, ℝ)`.

## References

* [W. Duke, Ö. Imamoglu and Á. Tóth, *Geometric invariants for real quadratic fields*,
  Ann. of Math. 184 (2016), 949–990](https://doi.org/10.4007/annals.2016.184.3.8), §3,
  (3.1)–(3.2) and the paragraph after (3.2).
-/

public section

open scoped MatrixGroups
open UpperHalfPlane

namespace TauCeti

/-- A list of naturals is an *admissible cycle* if it is nonempty, every entry is at least `2`
and some entry is greater than `2`. These are the digit lists whose cycle groups have a Ford
polygon with a nonempty free interval; repeated lists such as `[4, 4]` are allowed, and
primitivity is a separate condition. -/
def AdmissibleCycle (n : List ℕ) : Prop :=
  n ≠ [] ∧ (∀ a ∈ n, 2 ≤ a) ∧ ∃ a ∈ n, 2 < a

/-- The defining property of an admissible cycle. -/
theorem admissibleCycle_iff {n : List ℕ} :
    AdmissibleCycle n ↔ n ≠ [] ∧ (∀ a ∈ n, 2 ≤ a) ∧ ∃ a ∈ n, 2 < a :=
  Iff.rfl

instance : DecidablePred AdmissibleCycle := fun _ ↦ decidable_of_iff _ admissibleCycle_iff.symm

namespace AdmissibleCycle

variable {n : List ℕ}

theorem ne_nil (h : AdmissibleCycle n) : n ≠ [] :=
  h.1

theorem two_le (h : AdmissibleCycle n) {a : ℕ} (ha : a ∈ n) : 2 ≤ a :=
  h.2.1 a ha

theorem exists_two_lt (h : AdmissibleCycle n) : ∃ a ∈ n, 2 < a :=
  h.2.2

/-- An admissible list has digit sum at least `3`. -/
theorem three_le_sum (h : AdmissibleCycle n) : 3 ≤ n.sum := by
  obtain ⟨a, ha, h2⟩ := h.exists_two_lt
  exact h2.trans_le (List.le_sum_of_mem ha)

end AdmissibleCycle

/-- The empty list is not admissible. -/
@[simp]
theorem not_admissibleCycle_nil : ¬AdmissibleCycle [] := fun h ↦ h.ne_nil rfl

/-- A one-digit list `[a]` is admissible exactly when `a > 2`; for instance `[4]` is. -/
@[simp]
theorem admissibleCycle_singleton_iff {a : ℕ} : AdmissibleCycle [a] ↔ 2 < a := by
  simp only [admissibleCycle_iff, ne_eq, List.cons_ne_nil, not_false_eq_true,
    List.mem_singleton, forall_eq, exists_eq_left, true_and]
  exact ⟨And.right, fun h ↦ ⟨h.le, h⟩⟩

/-- A list all of whose entries are `2` is not admissible: it gives a parabolic, not a
hyperbolic, boundary word. -/
theorem not_admissibleCycle_replicate_two (k : ℕ) : ¬AdmissibleCycle (List.replicate k 2) := by
  rintro ⟨-, -, a, ha, h⟩
  rw [List.eq_of_mem_replicate ha] at h
  exact lt_irrefl _ h

end TauCeti

/-- Admissibility only depends on the multiset of entries. -/
theorem List.Perm.admissibleCycle_iff {n n' : List ℕ} (h : List.Perm n n') :
    TauCeti.AdmissibleCycle n ↔ TauCeti.AdmissibleCycle n' := by
  simp only [TauCeti.admissibleCycle_iff, ← List.length_pos_iff, h.length_eq, h.mem_iff]

/-- Cyclic rotation preserves admissibility in both directions. -/
theorem List.IsRotated.admissibleCycle_iff {n n' : List ℕ} (h : n ~r n') :
    TauCeti.AdmissibleCycle n ↔ TauCeti.AdmissibleCycle n' :=
  h.perm.admissibleCycle_iff

@[simp]
theorem TauCeti.admissibleCycle_rotate_iff (n : List ℕ) (r : ℕ) :
    AdmissibleCycle (n.rotate r) ↔ AdmissibleCycle n :=
  (List.IsRotated.forall n r).admissibleCycle_iff

namespace TauCeti.ModularGroup

open _root_.ModularGroup

/-! ### Half-turns -/

/-- The half-turn about `c + i`: the class in `PSL(2, ℤ)` of `Tᶜ S T⁻ᶜ`, acting on `ℍ` by
`z ↦ c - 1 / (z - c)` (`coe_halfTurn_smul`). -/
def halfTurn (c : ℤ) : PSL(2, ℤ) :=
  (T : PSL(2, ℤ)) ^ c * S * (T : PSL(2, ℤ)) ^ (-c)

theorem halfTurn_def (c : ℤ) :
    halfTurn c = (T : PSL(2, ℤ)) ^ c * S * (T : PSL(2, ℤ)) ^ (-c) :=
  (rfl)

@[simp]
theorem halfTurn_zero : halfTurn 0 = S := by
  simp [halfTurn_def]

/-- The half-turn about `c + i` is the conjugate of `S` by `Tᶜ`. -/
theorem halfTurn_eq_conj (c : ℤ) : halfTurn c = MulAut.conj ((T : PSL(2, ℤ)) ^ c) S := by
  rw [halfTurn_def, MulAut.conj_apply, zpow_neg]

/-- Conjugating by a translation moves the centre of a half-turn. -/
-- not `@[simp]`: `map_zpow` rewrites `MulAut.conj (T ^ a)` out of simp normal form
theorem conj_T_zpow_halfTurn (a c : ℤ) :
    MulAut.conj ((T : PSL(2, ℤ)) ^ a) (halfTurn c) = halfTurn (a + c) := by
  simp only [halfTurn_def, MulAut.conj_apply]
  group

/-- Conjugating by the translation `Tᵃ` moves the centre of a half-turn by `a`. -/
theorem halfTurn_add (a c : ℤ) :
    halfTurn (a + c) = (T : PSL(2, ℤ)) ^ a * halfTurn c * (T : PSL(2, ℤ)) ^ (-a) := by
  simp only [halfTurn_def, zpow_add, zpow_neg, mul_inv_rev, mul_assoc]

/-- A subgroup containing the translation `Tᵃ` and the half-turn about `c + i` contains the
half-turn about `a + c + i`. -/
theorem halfTurn_add_mem {H : Subgroup PSL(2, ℤ)} {a c : ℤ} (ha : (T : PSL(2, ℤ)) ^ a ∈ H)
    (hc : halfTurn c ∈ H) : halfTurn (a + c) ∈ H := by
  rw [← conj_T_zpow_halfTurn, MulAut.conj_apply]
  exact mul_mem (mul_mem ha hc) (inv_mem ha)

@[simp]
theorem halfTurn_mul_self (c : ℤ) : halfTurn c * halfTurn c = 1 := by
  rw [halfTurn_eq_conj, ← map_mul, ← sq, TauCeti.ModularGroup.coe_S_sq, map_one]

/-- A half-turn is an involution of `PSL(2, ℤ)`; its representative in `SL(2, ℤ)` squares
to `-1`, not `1`. -/
@[simp]
theorem halfTurn_sq (c : ℤ) : halfTurn c ^ 2 = 1 := by
  rw [sq, halfTurn_mul_self]

@[simp]
theorem halfTurn_inv (c : ℤ) : (halfTurn c)⁻¹ = halfTurn c :=
  inv_eq_of_mul_eq_one_right (halfTurn_mul_self c)

/-- A half-turn has exact order two in `PSL(2, ℤ)`. -/
@[simp]
theorem orderOf_halfTurn (c : ℤ) : orderOf (halfTurn c) = 2 := by
  rw [halfTurn_eq_conj, MulEquiv.orderOf_eq, TauCeti.ModularGroup.orderOf_coe_S]

theorem halfTurn_ne_one (c : ℤ) : halfTurn c ≠ 1 := by
  rw [ne_eq, ← orderOf_eq_one_iff, orderOf_halfTurn]
  decide

/-- The half-turn about `c + i` acts on `ℍ` by `z ↦ c - 1 / (z - c)`. -/
theorem coe_halfTurn_smul (c : ℤ) (z : ℍ) :
    ((halfTurn c • z : ℍ) : ℂ) = c - 1 / ((z : ℂ) - c) := by
  have h : halfTurn c = ((T ^ c * S * T ^ (-c) : SL(2, ℤ)) : PSL(2, ℤ)) := by
    simp only [halfTurn_def, QuotientGroup.mk_mul, QuotientGroup.mk_zpow]
  rw [h]
  simp only [pslMk_smul, mul_smul, modular_T_zpow_smul, modular_S_smul, coe_vadd]
  push_cast
  rw [neg_add_eq_sub, inv_neg, one_div]
  ring

/-- The half-turn about `c + i` fixes `c + i`. -/
@[simp]
theorem halfTurn_smul_vadd_I (c : ℤ) : halfTurn c • ((c : ℝ) +ᵥ I) = (c : ℝ) +ᵥ I := by
  ext
  rw [coe_halfTurn_smul, coe_vadd, coe_I]
  push_cast
  rw [add_sub_cancel_left, one_div, Complex.inv_I]
  ring

/-! ### The cycle group -/

/-- The *cycle group* `Γ(n) ≤ PSL(2, ℤ)` of a list `n = [n₁, …, n_ℓ]`: the subgroup generated by
the translation `Tᵐ` by the digit sum `m = n₁ + ⋯ + n_ℓ` and by the half-turns about the points
`N_k + i`, where `N_k = n₁ + ⋯ + n_k` for `0 ≤ k < ℓ`. The definition accepts every list; the
geometric theory of `Γ(n)` assumes `AdmissibleCycle n`. -/
def cycleGroup (n : List ℕ) : Subgroup PSL(2, ℤ) :=
  Subgroup.closure
    ({(T : PSL(2, ℤ)) ^ n.sum} ∪ Set.range fun k : Fin n.length ↦ halfTurn (n.take k).sum)

theorem cycleGroup_def (n : List ℕ) :
    cycleGroup n = Subgroup.closure
      ({(T : PSL(2, ℤ)) ^ n.sum} ∪ Set.range fun k : Fin n.length ↦ halfTurn (n.take k).sum) :=
  (rfl)

variable {n : List ℕ}

theorem T_pow_sum_mem_cycleGroup (n : List ℕ) : (T : PSL(2, ℤ)) ^ n.sum ∈ cycleGroup n :=
  Subgroup.subset_closure (Or.inl rfl)

theorem T_zpow_mul_sum_mem_cycleGroup (n : List ℕ) (j : ℤ) :
    (T : PSL(2, ℤ)) ^ (j * n.sum) ∈ cycleGroup n := by
  rw [mul_comm, zpow_mul, zpow_natCast]
  exact zpow_mem (T_pow_sum_mem_cycleGroup n) j

theorem halfTurn_mem_cycleGroup {k : ℕ} (hk : k < n.length) :
    halfTurn (n.take k).sum ∈ cycleGroup n :=
  Subgroup.subset_closure (Or.inr ⟨⟨k, hk⟩, rfl⟩)

/-- The half-turns about all translates `N_k + j m + i` of the generating centres lie in the
cycle group. -/
theorem halfTurn_add_mul_sum_mem_cycleGroup {k : ℕ} (hk : k < n.length) (j : ℤ) :
    halfTurn ((n.take k).sum + j * n.sum) ∈ cycleGroup n := by
  rw [add_comm]
  exact halfTurn_add_mem (T_zpow_mul_sum_mem_cycleGroup n j) (halfTurn_mem_cycleGroup hk)

/-- For a nonempty list, the half-turn about the final centre `N_ℓ + i = m + i` lies in the cycle
group. -/
theorem halfTurn_sum_mem_cycleGroup (hn : n ≠ []) : halfTurn n.sum ∈ cycleGroup n := by
  simpa using halfTurn_add_mul_sum_mem_cycleGroup (List.length_pos_iff.mpr hn) 1

/-- For a nonempty list, the half-turn about every prefix-sum point `N_k + i` lies in the cycle
group, including `N_ℓ + i = m + i` (the prefix sums with `k ≥ ℓ` all equal `m`). -/
theorem halfTurn_sum_take_mem_cycleGroup (hn : n ≠ []) (k : ℕ) :
    halfTurn (n.take k).sum ∈ cycleGroup n := by
  rcases lt_or_ge k n.length with hk | hk
  · exact halfTurn_mem_cycleGroup hk
  · simpa [List.take_of_length_le hk] using halfTurn_sum_mem_cycleGroup hn

/-- The universal property of the cycle group. -/
theorem cycleGroup_le_iff {H : Subgroup PSL(2, ℤ)} :
    cycleGroup n ≤ H ↔
      (T : PSL(2, ℤ)) ^ n.sum ∈ H ∧ ∀ k < n.length, halfTurn (n.take k).sum ∈ H := by
  simp [cycleGroup_def, Subgroup.closure_le, Set.insert_subset_iff, Set.range_subset_iff,
    Fin.forall_iff]

@[simp]
theorem cycleGroup_nil : cycleGroup [] = ⊥ := by
  simp [cycleGroup_def, Subgroup.closure_singleton_one]

/-- The cycle group of a one-digit list `[a]` is generated by `Tᵃ` and `S`, for every `a`.
For `[4]` this is `⟨S, T⁴⟩`. -/
theorem cycleGroup_singleton (a : ℕ) :
    cycleGroup [a] = Subgroup.closure {(T : PSL(2, ℤ)) ^ a, (S : PSL(2, ℤ))} := by
  simp [cycleGroup_def, Set.range_unique, Set.pair_comm]

/-- The half-turn about the final centre `N_ℓ + i` may replace the one about `i`: the centres
`N₁, …, N_ℓ` generate the same cycle group. -/
theorem cycleGroup_eq_closure_succ (n : List ℕ) :
    cycleGroup n = Subgroup.closure
      ({(T : PSL(2, ℤ)) ^ n.sum} ∪
        Set.range fun k : Fin n.length ↦ halfTurn (n.take (k + 1)).sum) := by
  rcases eq_or_ne n [] with rfl | hn
  · simp [Subgroup.closure_singleton_one]
  set H := Subgroup.closure ({(T : PSL(2, ℤ)) ^ n.sum} ∪
    Set.range fun k : Fin n.length ↦ halfTurn (n.take (k + 1)).sum)
  refine le_antisymm (cycleGroup_le_iff.mpr ⟨Subgroup.subset_closure (Or.inl rfl), ?_⟩) ?_
  · rintro (_ | k) hk
    · -- the half-turn about `i` is the conjugate by `T⁻ᵐ` of the one about `m + i = N_ℓ + i`
      have hT : (T : PSL(2, ℤ)) ^ (-(n.sum : ℤ)) ∈ H := by
        rw [zpow_neg, zpow_natCast]
        exact inv_mem (Subgroup.subset_closure (Or.inl rfl))
      have hm : halfTurn n.sum ∈ H :=
        Subgroup.subset_closure (Or.inr ⟨⟨n.length - 1, by omega⟩, by
          simp [Nat.sub_add_cancel hk]⟩)
      simpa using halfTurn_add_mem hT hm
    · exact Subgroup.subset_closure (Or.inr ⟨⟨k, by omega⟩, rfl⟩)
  · rw [Subgroup.closure_le, Set.union_subset_iff, Set.singleton_subset_iff,
      Set.range_subset_iff]
    exact ⟨T_pow_sum_mem_cycleGroup n, fun k ↦ halfTurn_sum_take_mem_cycleGroup hn _⟩

/-! ### The centres of the half-turns -/

/-- The integer centres `N_k + j m`, `0 ≤ k < ℓ`, `j ∈ ℤ`, of the half-turns of the cycle
group, where `N_k` are the prefix sums and `m` is the digit sum. -/
def cycleCenters (n : List ℕ) : Set ℤ :=
  {c | ∃ k < n.length, ∃ j : ℤ, c = (n.take k).sum + j * n.sum}

@[simp]
theorem mem_cycleCenters_iff {c : ℤ} :
    c ∈ cycleCenters n ↔ ∃ k < n.length, ∃ j : ℤ, c = (n.take k).sum + j * n.sum :=
  Iff.rfl

@[simp]
theorem cycleCenters_nil : cycleCenters [] = ∅ := by
  simp [cycleCenters]

/-- For a nonempty list, every prefix sum `N_k` plus a multiple of the digit sum is a centre,
whatever `k`: the prefix sums with `k ≥ ℓ` equal `m = N₀ + m`. -/
theorem sum_take_add_mul_sum_mem_cycleCenters (hn : n ≠ []) (k : ℕ) (j : ℤ) :
    ((n.take k).sum : ℤ) + j * n.sum ∈ cycleCenters n := by
  rcases lt_or_ge k n.length with hk | hk
  · exact ⟨k, hk, j, rfl⟩
  · refine ⟨0, List.length_pos_iff.mpr hn, j + 1, ?_⟩
    simp only [List.take_of_length_le hk, List.take_zero, List.sum_nil, Nat.cast_zero]
    ring

/-- Every half-turn about a centre `N_k + j m + i` lies in the cycle group. -/
theorem halfTurn_mem_cycleGroup_of_mem_cycleCenters {c : ℤ} (hc : c ∈ cycleCenters n) :
    halfTurn c ∈ cycleGroup n := by
  obtain ⟨k, hk, j, rfl⟩ := hc
  exact halfTurn_add_mul_sum_mem_cycleGroup hk j

/-- The cycle group is generated by `Tᵐ` and all half-turns about its centres. -/
theorem cycleGroup_eq_closure_cycleCenters (n : List ℕ) :
    cycleGroup n =
      Subgroup.closure ({(T : PSL(2, ℤ)) ^ n.sum} ∪ halfTurn '' cycleCenters n) := by
  refine le_antisymm (cycleGroup_le_iff.mpr ⟨Subgroup.subset_closure (Or.inl rfl),
    fun k hk ↦ Subgroup.subset_closure (Or.inr ⟨_, ⟨k, hk, 0, by simp⟩, rfl⟩)⟩) ?_
  rw [Subgroup.closure_le, Set.union_subset_iff, Set.singleton_subset_iff, Set.image_subset_iff]
  exact ⟨T_pow_sum_mem_cycleGroup n, fun c hc ↦ halfTurn_mem_cycleGroup_of_mem_cycleCenters hc⟩

/-! ### Rotation of the digit list -/

/-- Translations commute, so conjugating `Tᵐ` by `Tᵃ` fixes it. -/
private theorem conj_T_zpow_T_pow (a : ℤ) (m : ℕ) :
    MulAut.conj ((T : PSL(2, ℤ)) ^ a) ((T : PSL(2, ℤ)) ^ m) = (T : PSL(2, ℤ)) ^ m := by
  rw [MulAut.conj_apply]
  group

/-- Moving the first digit `a` of a list to its end conjugates the cycle group by `T⁻ᵃ`. -/
private theorem map_conj_cycleGroup_cons (a : ℕ) (t : List ℕ) :
    (cycleGroup (a :: t)).map (MulAut.conj ((T : PSL(2, ℤ)) ^ (-(a : ℤ)))).toMonoidHom =
      cycleGroup (t ++ [a]) := by
  have hsum : (t ++ [a]).sum = (a :: t).sum := by simp [add_comm]
  -- the centres of the rotated list are those of `a :: t` after the first, moved by `-a`
  have hcentre : ∀ k ≤ t.length,
      (((t ++ [a]).take k).sum : ℤ) = -a + ((a :: t).take (k + 1)).sum := by
    intro k hk
    rw [List.take_append_of_le_length hk, List.take_succ_cons, List.sum_cons]
    push_cast
    ring
  apply le_antisymm
  · rw [Subgroup.map_le_iff_le_comap, cycleGroup_le_iff]
    refine ⟨?_, ?_⟩
    · rw [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, conj_T_zpow_T_pow, ← hsum]
      exact T_pow_sum_mem_cycleGroup _
    · rintro (_ | k) hk <;>
        rw [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, conj_T_zpow_halfTurn]
      · -- the centre `-a` is the last centre `m - a` of `t ++ [a]`, moved by `-m`
        have h := halfTurn_add_mul_sum_mem_cycleGroup (n := t ++ [a]) (k := t.length)
          (by simp) (-1)
        rw [hcentre t.length le_rfl, hsum, List.take_of_length_le (by simp)] at h
        convert h using 2
        simp only [List.take_zero, List.sum_nil, Nat.cast_zero]
        ring
      · rw [← hcentre k (by simp at hk; omega)]
        exact halfTurn_mem_cycleGroup (by simp at hk ⊢; omega)
  · rw [cycleGroup_le_iff]
    refine ⟨?_, fun k hk ↦ ?_⟩
    · have h := Subgroup.mem_map_of_mem (MulAut.conj ((T : PSL(2, ℤ)) ^ (-(a : ℤ)))).toMonoidHom
        (T_pow_sum_mem_cycleGroup (a :: t))
      rwa [MulEquiv.coe_toMonoidHom, conj_T_zpow_T_pow, ← hsum] at h
    · rw [hcentre k (by simpa using hk), ← conj_T_zpow_halfTurn]
      exact Subgroup.mem_map_of_mem _
        (halfTurn_sum_take_mem_cycleGroup (List.cons_ne_nil a t) _)

/-- `List.sum_take_add_sum_take_rotate` for digit lists, cast to `ℤ`. -/
private theorem cast_sum_take_add_sum_take_rotate {r j : ℕ} (hr : r ≤ n.length)
    (hj : j ≤ n.length) :
    ((n.take r).sum : ℤ) + ((n.rotate r).take j).sum =
      (n.take (r + j)).sum + (n.take (r + j - n.length)).sum := by
  exact_mod_cast List.sum_take_add_sum_take_rotate hr hj

private theorem cycleCenters_rotate_subset {r : ℕ} (hr : r ≤ n.length) {c : ℤ}
    (hc : c ∈ cycleCenters (n.rotate r)) : c + (n.take r).sum ∈ cycleCenters n := by
  obtain ⟨j, hj, t, rfl⟩ := hc
  rw [List.length_rotate] at hj
  have hn : n ≠ [] := List.ne_nil_of_length_pos (by omega)
  have key := cast_sum_take_add_sum_take_rotate hr hj.le
  rw [List.sum_rotate]
  rcases lt_or_ge (r + j) n.length with h | h
  · rw [Nat.sub_eq_zero_of_le h.le, List.take_zero, List.sum_nil, Nat.cast_zero, add_zero] at key
    convert sum_take_add_mul_sum_mem_cycleCenters hn (r + j) t using 1
    linear_combination key
  · rw [List.take_of_length_le h] at key
    convert sum_take_add_mul_sum_mem_cycleCenters hn (r + j - n.length) (t + 1) using 1
    linear_combination key

private theorem cycleCenters_subset_rotate {r : ℕ} (hr : r ≤ n.length) {c : ℤ}
    (hc : c + (n.take r).sum ∈ cycleCenters n) : c ∈ cycleCenters (n.rotate r) := by
  obtain ⟨k, hk, t, hkt⟩ := hc
  have hn : n.rotate r ≠ [] := by
    rw [ne_eq, List.rotate_eq_nil_iff]
    exact List.ne_nil_of_length_pos (by omega)
  rcases le_or_gt r k with h | h
  · have key := cast_sum_take_add_sum_take_rotate hr (j := k - r) (by omega)
    rw [show r + (k - r) = k by omega, Nat.sub_eq_zero_of_le hk.le, List.take_zero,
      List.sum_nil, Nat.cast_zero, add_zero] at key
    convert sum_take_add_mul_sum_mem_cycleCenters hn (k - r) t using 1
    rw [List.sum_rotate]
    linear_combination hkt - key
  · have key := cast_sum_take_add_sum_take_rotate hr (j := n.length - r + k) (by omega)
    rw [show r + (n.length - r + k) = n.length + k by omega, Nat.add_sub_cancel_left,
      List.take_of_length_le (by omega : n.length ≤ n.length + k)] at key
    convert sum_take_add_mul_sum_mem_cycleCenters hn (n.length - r + k) (t - 1) using 1
    rw [List.sum_rotate]
    linear_combination hkt - key

/-- The centres of a rotated cycle are the old centres shifted by `-N_r`. -/
theorem mem_cycleCenters_rotate_iff {r : ℕ} (hr : r ≤ n.length) {c : ℤ} :
    c ∈ cycleCenters (n.rotate r) ↔ c + (n.take r).sum ∈ cycleCenters n :=
  ⟨cycleCenters_rotate_subset hr, cycleCenters_subset_rotate hr⟩

/-- **Rotation invariance.** Rotating the digit list by `r ≤ ℓ` conjugates the cycle group by the
translation `z ↦ z - N_r`: `Γ(n.rotate r) = T^(-N_r) Γ(n) T^(N_r)`. -/
theorem map_conj_cycleGroup_rotate {r : ℕ} (hr : r ≤ n.length) :
    (cycleGroup n).map (MulAut.conj ((T : PSL(2, ℤ)) ^ (-((n.take r).sum : ℤ)))).toMonoidHom =
      cycleGroup (n.rotate r) := by
  induction r with
  | zero =>
    rw [List.rotate_zero]
    convert Subgroup.map_id (cycleGroup n)
    ext g
    simp
  | succ r ih =>
    have hr' : r < n.length := by omega
    obtain ⟨t, ht⟩ : ∃ t, n.rotate r = n[r] :: t :=
      ⟨n.drop (r + 1) ++ n.take r, by
        rw [List.rotate_eq_drop_append_take hr'.le, List.drop_eq_getElem_cons hr',
          List.cons_append]⟩
    rw [← List.rotate_rotate, ht, List.rotate_cons_succ, List.rotate_zero,
      ← map_conj_cycleGroup_cons, ← ht, ← ih hr'.le, Subgroup.map_map, List.sum_take_succ _ _ hr']
    congr 1
    ext g
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    push_cast
    group

/-- Cyclically rotated digit lists have cycle groups conjugate by an integral translation `Tᶜ`.
For `[3, 6]` and `[6, 3]` the conjugator is `T⁻³`. -/
theorem _root_.List.IsRotated.exists_cycleGroup_eq_map_conj {n n' : List ℕ} (h : n ~r n') :
    ∃ c : ℤ, cycleGroup n' =
      (cycleGroup n).map (MulAut.conj ((T : PSL(2, ℤ)) ^ c)).toMonoidHom := by
  obtain ⟨r, hr, rfl⟩ := List.isRotated_iff_mod.mp h
  exact ⟨_, (map_conj_cycleGroup_rotate hr).symm⟩

/-- Lists that are cyclic rotations of each other have cycle groups conjugate in `PSL(2, ℤ)`,
by a translation. -/
theorem _root_.List.IsRotated.exists_map_conj_cycleGroup_eq {n n' : List ℕ} (h : n ~r n') :
    ∃ g : PSL(2, ℤ), (cycleGroup n).map (MulAut.conj g).toMonoidHom = cycleGroup n' := by
  obtain ⟨r, hr, rfl⟩ := List.isRotated_iff_mod.mp h
  exact ⟨_, map_conj_cycleGroup_rotate hr⟩

/-- Lists that are cyclic rotations of each other have cycle groups whose images in `PSL(2, ℝ)`
are conjugate. -/
theorem _root_.List.IsRotated.exists_map_conj_map_cycleGroup_eq {n n' : List ℕ} (h : n ~r n') :
    ∃ φ : PSL(2, ℝ), ((cycleGroup n).map psl2zToPSL2R).map (MulAut.conj φ).toMonoidHom =
      (cycleGroup n').map psl2zToPSL2R := by
  obtain ⟨g, hg⟩ := h.exists_map_conj_cycleGroup_eq
  refine ⟨psl2zToPSL2R g, ?_⟩
  rw [← hg, Subgroup.map_map, Subgroup.map_map]
  congr 1
  ext x
  simp [MulAut.conj_apply]

end TauCeti.ModularGroup
