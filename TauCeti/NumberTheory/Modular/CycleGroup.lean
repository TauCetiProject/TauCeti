import TauCeti.NumberTheory.Modular.Relations

/-!
# Quadratic cycle groups

For a list of natural numbers `n = [n₁, …, n_ℓ]` put `N_k = n₁ + ⋯ + n_k` (so `N₀ = 0`) and
`m = N_ℓ`. The *cycle group* `Γ(n) ≤ PSL(2, ℤ)` is generated by the translation `T ^ m` and the
half-turns `T ^ N_k * S * T ^ (-N_k)` for `0 ≤ k < ℓ`, where the half-turn
`T ^ c * S * T ^ (-c)` acts on the upper half-plane by `z ↦ c - 1 / (z - c)` and fixes `c + i`.

When `n` is the primitive reduced minus period of a narrow ideal class of a real quadratic field,
Duke, Imamoglu and Tóth attach to the class the Nielsen core of `Γ(n)`, a hyperbolic orbifold of
genus zero with `ℓ` cone points of order two, one cusp and one geodesic boundary component.
The geometric theory of `Γ(n)` (its Ford polygon, free-product presentation and infinite index)
needs the digit hypotheses recorded by `AdmissibleCycle`: every digit is at least two, and some
digit exceeds two. The group itself is defined for every list.

## Main declarations

* `TauCeti.ModularGroup.AdmissibleCycle`: the digit hypotheses, with
  `List.Perm.admissibleCycle_iff` (in particular invariance under rotation) and
  `TauCeti.ModularGroup.AdmissibleCycle.three_le_sum`.
* `TauCeti.ModularGroup.halfTurn`: the half-turn about `c + i`, with its action
  `TauCeti.ModularGroup.halfTurn_smul`, its fixed point, exact order two, and conjugation by
  translations `TauCeti.ModularGroup.coe_T_zpow_mul_halfTurn_mul_inv`.
* `TauCeti.ModularGroup.cycleGroup`: the cycle group, with its universal property
  `TauCeti.ModularGroup.cycleGroup_le_iff` and the alternative generating set with centres
  `N₁, …, N_ℓ` (`TauCeti.ModularGroup.cycleGroup_eq_closure_succ`).
* `TauCeti.ModularGroup.cycleGroup_rotate`: rotating the first `r` digits to the end conjugates
  the cycle group by `T ^ (-N_r)`.
* `List.IsRotated.exists_map_conj_map_psl2zToPSL2R_cycleGroup_eq`: cycle groups of rotated
  lists are conjugate in `PSL(2, ℝ)`.

## References

* W. Duke, Ö. Imamoglu and Á. Tóth, *Geometric invariants for real quadratic fields*,
  Ann. of Math. 184 (2016), §3, (3.1)–(3.2) and the paragraph following (3.2).
-/

public section

open scoped MatrixGroups
open UpperHalfPlane

namespace TauCeti.ModularGroup

open _root_.ModularGroup

/-! ### Admissible digit cycles -/

/-- A list of natural numbers is an *admissible cycle* if every entry is at least two and some
entry exceeds two. These are the digit hypotheses of the geometric theory of cycle groups; a
reduced minus continued-fraction period of a real quadratic irrationality is admissible.
Repeated cycles such as `[4, 4]` are admissible, and an admissible list is nonempty
(`TauCeti.ModularGroup.AdmissibleCycle.ne_nil`). -/
@[mk_iff]
structure AdmissibleCycle (n : List ℕ) : Prop where
  /-- Every digit is at least two. -/
  two_le : ∀ a ∈ n, 2 ≤ a
  /-- Some digit exceeds two. -/
  exists_two_lt : ∃ a ∈ n, 2 < a

instance : DecidablePred AdmissibleCycle := fun n ↦ decidable_of_iff _ (admissibleCycle_iff n).symm

namespace AdmissibleCycle

variable {n : List ℕ}

/-- An admissible cycle is nonempty. -/
theorem ne_nil (hn : AdmissibleCycle n) : n ≠ [] := by
  obtain ⟨a, ha, -⟩ := hn.exists_two_lt
  exact List.ne_nil_of_mem ha

/-- The digit sum of an admissible cycle is at least three. -/
theorem three_le_sum (hn : AdmissibleCycle n) : 3 ≤ n.sum := by
  obtain ⟨a, ha, h⟩ := hn.exists_two_lt
  exact h.trans_le (List.le_sum_of_mem ha)

end AdmissibleCycle

/-- Admissibility only depends on the entries of the list, so it is invariant under
permutation, in particular under cyclic rotation. -/
theorem _root_.List.Perm.admissibleCycle_iff {n n' : List ℕ} (h : n.Perm n') :
    AdmissibleCycle n ↔ AdmissibleCycle n' := by
  have hmem : ∀ a, a ∈ n ↔ a ∈ n' := fun _ ↦ h.mem_iff
  simp only [TauCeti.ModularGroup.admissibleCycle_iff, hmem]

/-- A cyclic rotation of a list is admissible exactly when the list is. -/
@[simp]
theorem admissibleCycle_rotate_iff (n : List ℕ) (r : ℕ) :
    AdmissibleCycle (n.rotate r) ↔ AdmissibleCycle n :=
  (List.rotate_perm n r).admissibleCycle_iff

/-! ### Half-turns about the points `c + i` -/

/-- The *half-turn* about `c + i` for an integer `c`: the class of `T ^ c * S * T ^ (-c)` in
`PSL(2, ℤ)`, acting by `z ↦ c - 1 / (z - c)` (`TauCeti.ModularGroup.halfTurn_smul`). -/
noncomputable def halfTurn (c : ℤ) : PSL(2, ℤ) :=
  (T : PSL(2, ℤ)) ^ c * S * (T : PSL(2, ℤ)) ^ (-c)

/-- The defining formula of `TauCeti.ModularGroup.halfTurn`. -/
theorem halfTurn_def (c : ℤ) :
    halfTurn c = (T : PSL(2, ℤ)) ^ c * S * (T : PSL(2, ℤ)) ^ (-c) := (rfl)

/-- The half-turn about `i` is `S`. -/
@[simp]
theorem halfTurn_zero : halfTurn 0 = S := by
  simp [halfTurn_def]

/-- Conjugating the half-turn about `c + i` by the translation `T ^ a` gives the half-turn about
`a + c + i`. -/
@[simp]
theorem coe_T_zpow_mul_halfTurn_mul_inv (a c : ℤ) :
    (T : PSL(2, ℤ)) ^ a * halfTurn c * ((T : PSL(2, ℤ)) ^ a)⁻¹ = halfTurn (a + c) := by
  simp only [halfTurn_def]
  group

/-- The half-turn about `c + i` is the conjugate of `S` by `T ^ c`. -/
theorem halfTurn_eq_conj (c : ℤ) : halfTurn c = MulAut.conj ((T : PSL(2, ℤ)) ^ c) S := by
  rw [MulAut.conj_apply, ← halfTurn_zero, coe_T_zpow_mul_halfTurn_mul_inv, add_zero]

/-- The half-turn about `c + i` is an involution. -/
@[simp]
theorem halfTurn_mul_self (c : ℤ) : halfTurn c * halfTurn c = 1 := by
  rw [halfTurn_eq_conj, ← map_mul, ← sq, coe_S_sq, map_one]

/-- The half-turn about `c + i` is its own inverse. -/
@[simp]
theorem halfTurn_inv (c : ℤ) : (halfTurn c)⁻¹ = halfTurn c :=
  inv_eq_of_mul_eq_one_right (halfTurn_mul_self c)

/-- The half-turn about `c + i` has exact order two in `PSL(2, ℤ)`. -/
@[simp]
theorem orderOf_halfTurn (c : ℤ) : orderOf (halfTurn c) = 2 := by
  rw [halfTurn_eq_conj, MulEquiv.orderOf_eq, orderOf_coe_S]

/-- The half-turn about `c + i` is not the identity of `PSL(2, ℤ)`. -/
theorem halfTurn_ne_one (c : ℤ) : halfTurn c ≠ 1 := by
  intro h
  simpa [h] using orderOf_halfTurn c

/-- The half-turn about `c + i` acts on the upper half-plane by `z ↦ c - 1 / (z - c)`. -/
theorem halfTurn_smul (c : ℤ) (z : ℍ) :
    ((halfTurn c • z : ℍ) : ℂ) = c - ((z : ℂ) - c)⁻¹ := by
  rw [halfTurn_def, mul_smul, mul_smul, ← QuotientGroup.mk_zpow, ← QuotientGroup.mk_zpow,
    pslMk_smul, pslMk_smul, pslMk_smul, modular_T_zpow_smul, modular_S_smul,
    modular_T_zpow_smul, coe_vadd, coe_mk, coe_vadd]
  push_cast
  rw [inv_neg, neg_add_eq_sub, ← sub_eq_add_neg]

/-- The half-turn about `c + i` fixes `c + i`. -/
theorem halfTurn_smul_vadd_I (c : ℤ) : halfTurn c • ((c : ℝ) +ᵥ I) = (c : ℝ) +ᵥ I := by
  ext
  rw [halfTurn_smul, coe_vadd, coe_I]
  push_cast
  simp [Complex.inv_I]

/-- A subgroup containing the translation `T ^ a` contains the half-turn about `a + c + i`
exactly when it contains the half-turn about `c + i`. -/
theorem halfTurn_add_mem_iff {H : Subgroup PSL(2, ℤ)} {a : ℤ} (ha : (T : PSL(2, ℤ)) ^ a ∈ H)
    (c : ℤ) : halfTurn (a + c) ∈ H ↔ halfTurn c ∈ H := by
  rw [← coe_T_zpow_mul_halfTurn_mul_inv, H.mul_mem_cancel_right (H.inv_mem ha),
    H.mul_mem_cancel_left ha]

/-! ### The cycle group -/

/-- The *cycle group* `Γ(n)` of a list `n = [n₁, …, n_ℓ]`: the subgroup of `PSL(2, ℤ)`
generated by the translation `T ^ m`, where `m = n₁ + ⋯ + n_ℓ`, and the half-turns about the
points `N_k + i` for `0 ≤ k < ℓ`, where `N_k = n₁ + ⋯ + n_k`. It is defined for every list;
its geometric theory assumes `TauCeti.ModularGroup.AdmissibleCycle n`. -/
noncomputable def cycleGroup (n : List ℕ) : Subgroup PSL(2, ℤ) :=
  Subgroup.closure (insert ((T : PSL(2, ℤ)) ^ n.sum)
    (Set.range fun k : Fin n.length ↦ halfTurn (n.take k).sum))

/-- The defining generating set of `TauCeti.ModularGroup.cycleGroup`. -/
theorem cycleGroup_def (n : List ℕ) :
    cycleGroup n = Subgroup.closure (insert ((T : PSL(2, ℤ)) ^ n.sum)
      (Set.range fun k : Fin n.length ↦ halfTurn (n.take k).sum)) := (rfl)

variable {n : List ℕ}

/-- **Universal property of the cycle group**: `Γ(n)` lies in a subgroup exactly when the
translation `T ^ m` and the half-turns about `N_k + i`, `k < ℓ`, do. -/
theorem cycleGroup_le_iff {H : Subgroup PSL(2, ℤ)} :
    cycleGroup n ≤ H ↔
      (T : PSL(2, ℤ)) ^ n.sum ∈ H ∧ ∀ k < n.length, halfTurn (n.take k).sum ∈ H := by
  simp [cycleGroup_def, Subgroup.closure_le, Set.insert_subset_iff, Set.range_subset_iff,
    Fin.forall_iff]

variable (n) in
/-- The cycle group contains the translation `T ^ m` by the digit sum. -/
theorem coe_T_pow_sum_mem_cycleGroup : (T : PSL(2, ℤ)) ^ n.sum ∈ cycleGroup n :=
  (cycleGroup_le_iff.1 le_rfl).1

/-- The integer-power form of `TauCeti.ModularGroup.coe_T_pow_sum_mem_cycleGroup`. -/
theorem coe_T_zpow_sum_mem_cycleGroup (n : List ℕ) :
    (T : PSL(2, ℤ)) ^ (n.sum : ℤ) ∈ cycleGroup n := by
  rw [zpow_natCast]
  exact coe_T_pow_sum_mem_cycleGroup n

/-- The cycle group of a nonempty list contains the half-turn about `N_k + i` for every `k`;
for `k ≥ ℓ` this is the half-turn about `m + i`, the conjugate of `S` by `T ^ m`. -/
theorem halfTurn_take_sum_mem_cycleGroup (hn : n ≠ []) (k : ℕ) :
    halfTurn (n.take k).sum ∈ cycleGroup n := by
  rcases lt_or_ge k n.length with hk | hk
  · exact (cycleGroup_le_iff.1 le_rfl).2 k hk
  · have h0 := (cycleGroup_le_iff.1 le_rfl).2 0 (List.length_pos_iff.2 hn)
    rw [List.take_of_length_le hk, ← add_zero (n.sum : ℤ),
      halfTurn_add_mem_iff (coe_T_zpow_sum_mem_cycleGroup n)]
    simpa using h0

/-- **Alternative generators**: `Γ(n)` is also generated by `T ^ m` and the half-turns about
`N_k + i` for `1 ≤ k ≤ ℓ`, since the half-turn about `N_ℓ + i = m + i` is the conjugate by `T ^ m`
of the half-turn about `N₀ + i = i`. -/
theorem cycleGroup_eq_closure_succ (n : List ℕ) :
    cycleGroup n = Subgroup.closure (insert ((T : PSL(2, ℤ)) ^ n.sum)
      (Set.range fun k : Fin n.length ↦ halfTurn (n.take (k + 1)).sum)) := by
  refine le_antisymm (cycleGroup_le_iff.2 ⟨Subgroup.subset_closure (Set.mem_insert _ _),
    fun k hk ↦ ?_⟩) ?_
  · set H := Subgroup.closure (insert ((T : PSL(2, ℤ)) ^ n.sum)
      (Set.range fun k : Fin n.length ↦ halfTurn (n.take (k + 1)).sum))
    have hT : (T : PSL(2, ℤ)) ^ (n.sum : ℤ) ∈ H := by
      rw [zpow_natCast]
      exact Subgroup.subset_closure (Set.mem_insert _ _)
    have hmem : ∀ j : Fin n.length, halfTurn (n.take (j + 1)).sum ∈ H := fun j ↦
      Subgroup.subset_closure (Set.mem_insert_of_mem _ ⟨j, rfl⟩)
    rcases k with _ | k
    · have h := hmem ⟨n.length - 1, by omega⟩
      rw [Nat.sub_add_cancel hk, List.take_length, ← add_zero (n.sum : ℤ),
        halfTurn_add_mem_iff hT] at h
      simpa using h
    · exact hmem ⟨k, by omega⟩
  · rw [Subgroup.closure_le, Set.insert_subset_iff, Set.range_subset_iff]
    refine ⟨coe_T_pow_sum_mem_cycleGroup n, fun k ↦ ?_⟩
    exact halfTurn_take_sum_mem_cycleGroup (List.ne_nil_of_length_pos k.pos) _

/-- The cycle group of the empty list is trivial. -/
@[simp]
theorem cycleGroup_nil : cycleGroup [] = ⊥ := by
  simp [cycleGroup_def]

/-- The cycle group of a one-digit list `[a]` is generated by `T ^ a` and `S`. -/
theorem cycleGroup_singleton (a : ℕ) :
    cycleGroup [a] = Subgroup.closure {(T : PSL(2, ℤ)) ^ a, (S : PSL(2, ℤ))} := by
  simp [cycleGroup_def, Set.range_unique]

/-! ### Cyclic rotation of the digits -/

/-- Rotating a list moves the prefix sums: if `n' = n.rotate r` with `r ≤ ℓ`, then for `k < ℓ`
the centre `N'_k + N_r` is the centre `N_{r+k}` (when `r + k ≤ ℓ`) or `m + N_{r + k - ℓ}`. -/
private theorem halfTurn_take_rotate_sum_add_mem {r k : ℕ} (hr : r ≤ n.length)
    (hk : k < n.length) :
    halfTurn (((n.rotate r).take k).sum + (n.take r).sum : ℤ) ∈ cycleGroup n := by
  have hn : n ≠ [] := List.ne_nil_of_length_pos (by omega)
  have hsplit : (n.take (r + k)).sum = (n.take r).sum + ((n.drop r).take k).sum := by
    rw [List.take_add, List.sum_append]
  have hrot : ((n.rotate r).take k).sum =
      ((n.drop r).take k).sum + (n.take (k - (n.length - r))).sum := by
    rw [List.rotate_eq_drop_append_take hr, List.take_append, List.take_take, List.sum_append,
      List.length_drop, min_eq_left (by omega)]
  rw [← Nat.cast_add, hrot]
  rcases le_or_gt (r + k) n.length with hle | hlt
  · rw [Nat.sub_eq_zero_of_le (by omega), List.take_zero, List.sum_nil, add_zero, add_comm,
      ← hsplit]
    exact halfTurn_take_sum_mem_cycleGroup hn _
  · rw [List.take_of_length_le hlt.le] at hsplit
    rw [show ((n.drop r).take k).sum + (n.take (k - (n.length - r))).sum + (n.take r).sum =
      n.sum + (n.take (k - (n.length - r))).sum by omega, Nat.cast_add,
      halfTurn_add_mem_iff (coe_T_zpow_sum_mem_cycleGroup n)]
    exact halfTurn_take_sum_mem_cycleGroup hn _

/-- Rotating forward by `r ≤ ℓ` carries `Γ(n.rotate r)` into the conjugate of `Γ(n)` by
`T ^ (-N_r)`; `TauCeti.ModularGroup.cycleGroup_rotate` upgrades this to an equality. -/
private theorem cycleGroup_rotate_le {r : ℕ} (hr : r ≤ n.length) :
    cycleGroup (n.rotate r) ≤ (cycleGroup n).map
      (MulAut.conj ((T : PSL(2, ℤ)) ^ (-((n.take r).sum : ℤ)))).toMonoidHom := by
  refine cycleGroup_le_iff.2 ⟨?_, fun k hk ↦ ?_⟩
  · refine ⟨(T : PSL(2, ℤ)) ^ n.sum, coe_T_pow_sum_mem_cycleGroup n, ?_⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, List.sum_rotate]
    group
  · rw [List.length_rotate] at hk
    refine ⟨_, halfTurn_take_rotate_sum_add_mem hr hk, ?_⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, coe_T_zpow_mul_halfTurn_mul_inv]
    congr 1
    ring

/-- **Rotation conjugates cycle groups**: moving the first `r ≤ ℓ` digits of `n` to the end
conjugates `Γ(n)` by the translation `T ^ (-N_r)`. For `r > ℓ` the formula fails in general,
since `n.rotate r = n.rotate (r % ℓ)` while `N_r = m`. -/
theorem cycleGroup_rotate {r : ℕ} (hr : r ≤ n.length) :
    cycleGroup (n.rotate r) = (cycleGroup n).map
      (MulAut.conj ((T : PSL(2, ℤ)) ^ (-((n.take r).sum : ℤ)))).toMonoidHom := by
  refine le_antisymm (cycleGroup_rotate_le hr) ?_
  -- rotating `n.rotate r` by the remaining `ℓ - r` digits returns to `n`
  have hback := cycleGroup_rotate_le (n := n.rotate r) (r := n.length - r)
    (by rw [List.length_rotate]; omega)
  rw [List.rotate_rotate, Nat.add_sub_cancel' hr, List.rotate_length] at hback
  have hsum : (((n.rotate r).take (n.length - r)).sum : ℤ) = n.sum - (n.take r).sum := by
    rw [List.rotate_eq_drop_append_take hr, List.take_append_of_le_length (by simp),
      List.take_of_length_le (by simp), eq_sub_iff_add_eq, ← Nat.cast_add, add_comm,
      List.sum_take_add_sum_drop]
  rw [hsum] at hback
  refine (Subgroup.map_mono hback).trans ?_
  -- the two conjugations compose to conjugation by `T ^ (-m)`, a member of `Γ(n.rotate r)`
  have hT : (T : PSL(2, ℤ)) ^ (n.sum : ℤ) ∈ cycleGroup (n.rotate r) := by
    rw [← List.sum_rotate n r]
    exact coe_T_zpow_sum_mem_cycleGroup _
  rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
  have hconj : MulAut.conj ((T : PSL(2, ℤ)) ^ (-((n.take r).sum : ℤ)))
      (MulAut.conj ((T : PSL(2, ℤ)) ^ (-((n.sum : ℤ) - (n.take r).sum))) x) =
      ((T : PSL(2, ℤ)) ^ (n.sum : ℤ))⁻¹ * x * (T : PSL(2, ℤ)) ^ (n.sum : ℤ) := by
    simp only [MulAut.conj_apply]
    group
  simp only [MulEquiv.coe_toMonoidHom, hconj]
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ hT) hx) hT

/-- Cycle groups of digit lists that are cyclic rotations of each other are conjugate by an
integral translation `T ^ j` (`TauCeti.ModularGroup.cycleGroup_rotate`). -/
theorem _root_.List.IsRotated.exists_map_conj_cycleGroup_eq {n n' : List ℕ} (h : n ~r n') :
    ∃ j : ℤ, (cycleGroup n).map (MulAut.conj ((T : PSL(2, ℤ)) ^ j)).toMonoidHom =
      cycleGroup n' := by
  obtain ⟨r, hr, rfl⟩ := List.isRotated_iff_mod.1 h
  exact ⟨_, (cycleGroup_rotate hr).symm⟩

/-- **Rotated digit lists give conjugate groups in `PSL(2, ℝ)`**: if `n'` is a cyclic rotation
of `n`, the images of `Γ(n)` and `Γ(n')` in `PSL(2, ℝ)` are conjugate. No digit hypothesis is
needed. -/
theorem _root_.List.IsRotated.exists_map_conj_map_psl2zToPSL2R_cycleGroup_eq {n n' : List ℕ}
    (h : n ~r n') :
    ∃ φ : PSL(2, ℝ), ((cycleGroup n).map psl2zToPSL2R).map (MulAut.conj φ).toMonoidHom =
      (cycleGroup n').map psl2zToPSL2R := by
  obtain ⟨j, hj⟩ := h.exists_map_conj_cycleGroup_eq
  refine ⟨psl2zToPSL2R ((T : PSL(2, ℤ)) ^ j), ?_⟩
  rw [← hj, Subgroup.map_map, Subgroup.map_map]
  congr 1
  refine MonoidHom.ext fun x ↦ ?_
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, map_mul,
    map_inv]

end TauCeti.ModularGroup
