/-!
# Congruence subgroups through their coset actions

A subgroup `Γ` of finite index in `SL(2, ℤ)` is a congruence subgroup exactly when it contains
`Γ(M)` for `M` a nonzero multiple of its strict level (the strict form of Wohlfahrt's theorem).
Since `Γ(M)` is normal and is the kernel of reduction modulo `M`, this says that the action of
`SL(2, ℤ)` on the cosets of `Γ` factors, necessarily uniquely, through `SL(2, ℤ/M)`. As `SL(2, ℤ)`
is generated by `T = !![1, 1; 0, 1]` and `T′ = !![1, 0; 1, 1]`, such a factorization is the same
as a homomorphism out of `SL(2, ℤ/M)` sending the reductions of `T` and `T′` to the coset
permutations of `T` and `T′`. Through a presentation of the finite group on these two generators,
the congruence property thus becomes finitely many word identities between two permutations of
the cosets: this is the principle behind Hsu's congruence test.

For `Γ' ≤ PSL(2, ℤ)` with full preimage `±Γ' = Γ'.liftSL`, the modulus is a multiple of the
general level `N` of `Γ'`, the order of `σinf`, and the finite group is
`Q_M = SL(2, ℤ/M) / ⟨-1⟩`. In terms of the modular triple `(σ0, σ1, σinf)`, the coset permutations
of `T` and `T′` are `σinf` and `σ0 * σ1`. Read pointwise, `±Γ'` is noncongruence exactly when
some `γ ∈ Γ(M)` moves the base coset; such a `γ`, with its action, is a finite certificate of
noncongruence.

The certificate is exercised on the connected triple `indexEightTriple` of degree `8`, with
`σ1 = (2 3)(4 5)(6 7)` and `σinf = (0 1 3 5 4 7 6 2)`: the matrix `!![73, -32; 16, -7] ∈ Γ(8)`,
equal in `PSL(2, ℤ)` to `T⁴ S T⁻² S T⁻⁵ S T⁻² S T⁻¹`, sends the coset `0` to the coset `5`. So
every subgroup of `PSL(2, ℤ)` with this modular triple has noncongruence full preimage, although
its index `8` divides the order `192` of `Q_8` and the order obstruction is silent.

## Main results

* `TauCeti.ModularGroup.isCongruenceSubgroup_iff_existsUnique_comp_map_eq`,
  `TauCeti.ModularGroup.isCongruenceSubgroup_iff_exists_map_T_tPrime`: `Γ ≤ SL(2, ℤ)` is a
  congruence subgroup iff its coset action factors through `SL(2, ℤ/M)`, for `M` a nonzero
  multiple of the strict level of `Γ`.
* `TauCeti.ModularGroup.ker_mk'_comp_map_intCast_zmod`: the kernel of `SL(2, ℤ) → Q_M` is
  `Γ(M) ⊔ ⟨-1⟩`.
* `TauCeti.ModularGroup.ker_permutationRepresentation_comp_mk'`: the kernel of the coset action of
  `PSL(2, ℤ)` on `PSL(2, ℤ) ⧸ Γ'`, read on `SL(2, ℤ)`, is the normal core of `±Γ'`.
* `TauCeti.ModularGroup.isCongruenceSubgroup_liftSL_iff_forall_mem_Gamma`,
  `TauCeti.ModularGroup.isCongruenceSubgroup_liftSL_iff_existsUnique_comp_eq`,
  `TauCeti.ModularGroup.isCongruenceSubgroup_liftSL_iff_exists_map_T_tPrime`: `±Γ'` is a
  congruence subgroup iff `Γ(M)` acts trivially on the cosets of `Γ'`, iff the coset action factors
  through `Q_M`, iff some homomorphism `Q_M → Perm (Fin n)` sends `T` and `T′` to `σinf` and
  `σ0 * σ1`, for `M` a nonzero multiple of the general level.
* `TauCeti.ModularGroup.not_isCongruenceSubgroup_liftSL_iff_exists_mem_Gamma`: noncongruence
  witnesses in `Γ(M)` moving the base coset.
* `TauCeti.ModularGroup.not_isCongruenceSubgroup_liftSL_of_modularTriple_eq_indexEightTriple`,
  `TauCeti.ModularGroup.exists_index_eq_eight_not_isCongruenceSubgroup_liftSL`: a noncongruence
  subgroup of index `8`.

## References

* K. Wohlfahrt, *An extension of F. Klein's level concept*, Illinois J. Math. 8 (1964), 529–535.
* T. Hsu, *Identifying congruence subgroups of the modular group*, Proc. Amer. Math. Soc. 124
  (1996), 1351–1359, §3 (the principle of the test) and the index-`8` examples.
-/

open scoped MatrixGroups

public section

namespace TauCeti.ModularGroup

open _root_.ModularGroup _root_.CongruenceSubgroup _root_.Matrix.SpecialLinearGroup Equiv

variable {n M : ℕ} [NeZero M]

/-! ### Subgroups of `SL(2, ℤ)` -/

section SL

variable {Γ : Subgroup SL(2, ℤ)} {β : Type*} (e : SL(2, ℤ) ⧸ Γ ≃ β)

/-- **Congruence as factorization through `SL(2, ℤ/M)`.** For `M ≠ 0` a multiple of the strict
level of `Γ ≤ SL(2, ℤ)`, `Γ` is a congruence subgroup exactly when the action of `SL(2, ℤ)` on the
cosets of `Γ` factors through reduction modulo `M`; the factorization is then unique. -/
theorem isCongruenceSubgroup_iff_existsUnique_comp_map_eq (hM : Γ.strictLevel ∣ M) :
    IsCongruenceSubgroup Γ ↔
      ∃! φ : SL(2, ZMod M) →* Perm β,
        φ.comp (map (Int.castRingHom (ZMod M))) = e.permutationRepresentation := by
  have := Gamma_normal M
  rw [MonoidHom.existsUnique_comp_eq_iff_ker_le _ _ map_intCast_zmod_surjective,
    ker_map_intCast_zmod, Equiv.ker_permutationRepresentation_quotient,
    Subgroup.normal_le_normalCore, isCongruenceSubgroup_iff_Gamma_le_of_dvd hM]

/-- **Congruence through the generators `T` and `T′`.** For `M ≠ 0` a multiple of the strict
level of `Γ ≤ SL(2, ℤ)`, `Γ` is a congruence subgroup exactly when some homomorphism
`SL(2, ℤ/M) → Perm β` sends the reductions of `T` and `T′ = !![1, 0; 1, 1]` to their coset
permutations. -/
theorem isCongruenceSubgroup_iff_exists_map_T_tPrime (hM : Γ.strictLevel ∣ M) :
    IsCongruenceSubgroup Γ ↔
      ∃ φ : SL(2, ZMod M) →* Perm β,
        φ (map (Int.castRingHom (ZMod M)) T) = e.permutationRepresentation T ∧
          φ (map (Int.castRingHom (ZMod M)) tPrime) = e.permutationRepresentation tPrime := by
  rw [isCongruenceSubgroup_iff_existsUnique_comp_map_eq e hM,
    existsUnique_comp_eq_iff_exists_map_T_tPrime map_intCast_zmod_surjective]

end SL

/-! ### Subgroups of `PSL(2, ℤ)` -/

section PSL

variable (Γ' : Subgroup PSL(2, ℤ)) (e : PSL(2, ℤ) ⧸ Γ' ≃ Fin n)

/-- The coset action of `PSL(2, ℤ)` on `PSL(2, ℤ) ⧸ Γ'`, read on `SL(2, ℤ)`, has kernel the normal
core of the full preimage `±Γ' = Γ'.liftSL`. -/
theorem ker_permutationRepresentation_comp_mk' :
    (e.permutationRepresentation.comp (QuotientGroup.mk' (Subgroup.center SL(2, ℤ)))).ker =
      Γ'.liftSL.normalCore := by
  rw [← MonoidHom.comap_ker, Equiv.ker_permutationRepresentation_quotient, Subgroup.liftSL_def,
    Subgroup.normalCore_comap_of_forall_exists_mul_eq]
  exact fun g ↦
    (QuotientGroup.mk'_surjective _ g).imp fun _ hx ↦ ⟨1, one_mem _, by rw [mul_one, hx]⟩

omit [NeZero M] in
/-- `Γ(M)` lies in the full preimage of `Γ'` exactly when it acts trivially on the cosets of
`Γ'`, `Γ(M)` being normal. -/
private theorem Gamma_le_liftSL_iff :
    Gamma M ≤ Γ'.liftSL ↔
      Gamma M ≤ (e.permutationRepresentation.comp
        (QuotientGroup.mk' (Subgroup.center SL(2, ℤ)))).ker := by
  have := Gamma_normal M
  rw [ker_permutationRepresentation_comp_mk', Subgroup.normal_le_normalCore]

variable {Γ' e}

/-- **Congruence as triviality of the action of `Γ(M)`.** For `M ≠ 0` a multiple of the general
level of `Γ' ≤ PSL(2, ℤ)`, the full preimage `±Γ'` is a congruence subgroup exactly when every
element of `Γ(M)` acts trivially on the cosets of `Γ'`. -/
theorem isCongruenceSubgroup_liftSL_iff_forall_mem_Gamma (hM : generalLevel Γ' e ∣ M) :
    IsCongruenceSubgroup Γ'.liftSL ↔
      ∀ γ ∈ Gamma M, e.permutationRepresentation (γ : PSL(2, ℤ)) = 1 := by
  rw [isCongruenceSubgroup_liftSL_iff_Gamma_le_of_dvd hM, Gamma_le_liftSL_iff Γ' e]
  simp only [IsConcreteLE.le_iff, MonoidHom.mem_ker, MonoidHom.comp_apply, QuotientGroup.mk'_apply]

omit [NeZero M] in
/-- Reduction `SL(2, ℤ) → Q_M = SL(2, ℤ/M) / ⟨-1⟩` is surjective. -/
private theorem surjective_mk'_comp_map :
    Function.Surjective ((QuotientGroup.mk' (Subgroup.zpowers (-1 : SL(2, ZMod M)))).comp
      (map (Int.castRingHom (ZMod M)))) :=
  (QuotientGroup.mk'_surjective _).comp map_intCast_zmod_surjective

omit [NeZero M] in
/-- The kernel of the reduction `SL(2, ℤ) → Q_M = SL(2, ℤ/M) / ⟨-1⟩` is `Γ(M) ⊔ ⟨-1⟩`. -/
theorem ker_mk'_comp_map_intCast_zmod :
    ((QuotientGroup.mk' (Subgroup.zpowers (-1 : SL(2, ZMod M)))).comp
      (map (Int.castRingHom (ZMod M)))).ker = Gamma M ⊔ Subgroup.zpowers (-1) := by
  have hneg : map (Int.castRingHom (ZMod M)) (-1 : SL(2, ℤ)) = -1 := by
    ext i j
    simp
  rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk', ← hneg, ← MonoidHom.map_zpowers,
    Subgroup.comap_map_eq, ker_map_intCast_zmod, sup_comm]

/-- **Congruence as factorization through `Q_M = SL(2, ℤ/M) / ⟨-1⟩`.** For `M ≠ 0` a multiple of
the general level of `Γ' ≤ PSL(2, ℤ)`, the full preimage `±Γ'` is a congruence subgroup exactly
when the action of `SL(2, ℤ)` on the cosets of `Γ'` factors through the reduction
`SL(2, ℤ) → Q_M`; the factorization is then unique. -/
theorem isCongruenceSubgroup_liftSL_iff_existsUnique_comp_eq (hM : generalLevel Γ' e ∣ M) :
    IsCongruenceSubgroup Γ'.liftSL ↔
      ∃! φ : SL(2, ZMod M) ⧸ Subgroup.zpowers (-1) →* Perm (Fin n),
        φ.comp ((QuotientGroup.mk' _).comp (map (Int.castRingHom (ZMod M)))) =
          e.permutationRepresentation.comp (QuotientGroup.mk' (Subgroup.center SL(2, ℤ))) := by
  rw [MonoidHom.existsUnique_comp_eq_iff_ker_le _ _ surjective_mk'_comp_map,
    isCongruenceSubgroup_liftSL_iff_Gamma_le_of_dvd hM, Gamma_le_liftSL_iff Γ' e,
    ker_mk'_comp_map_intCast_zmod, sup_le_iff, iff_self_and]
  -- `-1` has trivial class in `PSL(2, ℤ)`, so it acts trivially on the cosets of `Γ'`
  exact fun _ ↦ (Subgroup.zpowers_le).mpr (by simp)

/-- **Congruence through the generators `T` and `T′`**, the form of Hsu's test. For `M ≠ 0` a
multiple of the general level of `Γ' ≤ PSL(2, ℤ)`, the full preimage `±Γ'` is a congruence
subgroup exactly when some homomorphism `Q_M = SL(2, ℤ/M) / ⟨-1⟩ → Perm (Fin n)` sends the classes
of `T` and `T′ = !![1, 0; 1, 1]` to `σinf` and `σ0 * σ1`. -/
theorem isCongruenceSubgroup_liftSL_iff_exists_map_T_tPrime (hM : generalLevel Γ' e ∣ M) :
    IsCongruenceSubgroup Γ'.liftSL ↔
      ∃ φ : SL(2, ZMod M) ⧸ Subgroup.zpowers (-1) →* Perm (Fin n),
        φ (map (Int.castRingHom (ZMod M)) T) = permT Γ' e ∧
          φ (map (Int.castRingHom (ZMod M)) tPrime) =
            (modularTriple Γ' e).σ0 * (modularTriple Γ' e).σ1 := by
  rw [isCongruenceSubgroup_liftSL_iff_existsUnique_comp_eq hM,
    existsUnique_comp_eq_iff_exists_map_T_tPrime surjective_mk'_comp_map,
    ← permutationRepresentation_coe_tPrime, permT, modularTriple_σinf]
  rfl

/-- **Noncongruence witnesses.** For `M ≠ 0` a multiple of the general level of `Γ' ≤ PSL(2, ℤ)`,
the full preimage `±Γ'` is not a congruence subgroup exactly when some `γ ∈ Γ(M)` moves the base
coset `Γ'` of `PSL(2, ℤ) ⧸ Γ'`. -/
theorem not_isCongruenceSubgroup_liftSL_iff_exists_mem_Gamma (hM : generalLevel Γ' e ∣ M) :
    ¬ IsCongruenceSubgroup Γ'.liftSL ↔
      ∃ γ ∈ Gamma M,
        e.permutationRepresentation (γ : PSL(2, ℤ)) (e ((1 : PSL(2, ℤ)) : PSL(2, ℤ) ⧸ Γ')) ≠
          e ((1 : PSL(2, ℤ)) : PSL(2, ℤ) ⧸ Γ') := by
  rw [isCongruenceSubgroup_liftSL_iff_Gamma_le_of_dvd hM, IsConcreteLE.not_le_iff_exists]
  simp [Equiv.permutationRepresentation_apply, QuotientGroup.eq, Subgroup.mem_liftSL]

end PSL

/-! ### A noncongruence subgroup of index `8` -/

/-- The connected permutation triple of degree `8` with `σ1 = (2 3)(4 5)(6 7)`,
`σinf = (0 1 3 5 4 7 6 2)` and `σ0 = σ1 * σinf⁻¹ = (0 3 1)(2 7 5)`. Its subgroups of `PSL(2, ℤ)`
are not congruence (`not_isCongruenceSubgroup_liftSL_of_modularTriple_eq_indexEightTriple`). -/
def indexEightTriple : PermutationTriple 8 where
  σ0 := c[0, 3, 1] * c[2, 7, 5]
  σ1 := c[2, 3] * c[4, 5] * c[6, 7]
  σinf := c[0, 1, 3, 5, 4, 7, 6, 2]
  product_eq_one := by decide +kernel

/-- The triple `indexEightTriple` is connected. -/
theorem isConnected_indexEightTriple : indexEightTriple.IsConnected := by
  decide +kernel

/-- **A noncongruence subgroup of index `8`.** If `Γ' ≤ PSL(2, ℤ)` has modular triple
`indexEightTriple`, then `±Γ'` is not a congruence subgroup: `!![73, -32; 16, -7] ∈ Γ(8)` acts
nontrivially on the cosets of `Γ'`. -/
theorem not_isCongruenceSubgroup_liftSL_of_modularTriple_eq_indexEightTriple
    {Γ' : Subgroup PSL(2, ℤ)} {e : PSL(2, ℤ) ⧸ Γ' ≃ Fin 8}
    (h : modularTriple Γ' e = indexEightTriple) : ¬ IsCongruenceSubgroup Γ'.liftSL := by
  have hS : e.permutationRepresentation (S : PSL(2, ℤ)) = indexEightTriple.σ1 := by
    rw [← h, modularTriple_σ1]
  have hT : e.permutationRepresentation (T : PSL(2, ℤ)) = indexEightTriple.σinf := by
    rw [← h, modularTriple_σinf]
  have hlevel : generalLevel Γ' e ∣ 8 := by
    rw [generalLevel_def, permT, h]
    exact orderOf_dvd_of_pow_eq_one (by decide +kernel)
  let γ : SL(2, ℤ) := ⟨!![73, -32; 16, -7], by decide +kernel⟩
  have hγ : γ ∈ Gamma 8 := mem_Gamma_iff_dvd.mpr (by decide +kernel)
  -- in `PSL(2, ℤ)`, `γ` is the word `T⁴ S T⁻² S T⁻⁵ S T⁻² S T⁻¹`, whose `SL(2, ℤ)` value is `-γ`
  have hword : (γ : PSL(2, ℤ)) =
      ((T ^ 4 * S * T⁻¹ ^ 2 * S * T⁻¹ ^ 5 * S * T⁻¹ ^ 2 * S * T⁻¹ : SL(2, ℤ)) : PSL(2, ℤ)) := by
    rw [show γ = -(T ^ 4 * S * T⁻¹ ^ 2 * S * T⁻¹ ^ 5 * S * T⁻¹ ^ 2 * S * T⁻¹) from
      Subtype.ext (by decide +kernel), Matrix.ProjectiveSpecialLinearGroup.mk_neg]
  have hmove : e.permutationRepresentation (γ : PSL(2, ℤ)) 0 = 5 := by
    simp only [hword, QuotientGroup.mk_mul, QuotientGroup.mk_pow, QuotientGroup.mk_inv, map_mul,
      map_pow, map_inv, hS, hT]
    decide +kernel
  rw [isCongruenceSubgroup_liftSL_iff_forall_mem_Gamma hlevel]
  exact fun hall ↦ absurd (hall γ hγ ▸ hmove) (by decide +kernel)

/-- **There is a subgroup of index `8` in `PSL(2, ℤ)` whose full preimage in `SL(2, ℤ)` is not a
congruence subgroup.** -/
theorem exists_index_eq_eight_not_isCongruenceSubgroup_liftSL :
    ∃ Γ' : Subgroup PSL(2, ℤ), Γ'.index = 8 ∧ ¬ IsCongruenceSubgroup Γ'.liftSL := by
  obtain ⟨Γ', -, e, hindex, -, h⟩ :=
    exists_modularTriple_eq isConnected_indexEightTriple (by decide +kernel) (by decide +kernel) 0
  exact ⟨Γ', hindex, not_isCongruenceSubgroup_liftSL_of_modularTriple_eq_indexEightTriple h⟩

end TauCeti.ModularGroup
