/-!
# The abelianization of the modular group

The modular group `PSL(2, ℤ)` is the triangle group `Δ(3, 2, ∞) = ⟨x, y, z | x³, y², z y x⟩`,
with `x, y, z` sent to `U = S T⁻¹`, `S` and `T` (`TauCeti.ModularGroup.modularEquiv`). In an
abelian quotient the relations say that the class of `T` generates and that `S = T³`, `T⁶ = 1`;
conversely `x ↦ 2`, `y ↦ 3`, `z ↦ 1` satisfies the relations in `ℤ/6`. Hence the abelianization of
`PSL(2, ℤ)` is cyclic of order `6`, generated by the class of `T`.

The resulting character distinguishes conjugacy classes that orders cannot: `R = S T` and its
square both have order three, but their images `4` and `2` in `ℤ/6` differ, so they are not
conjugate in `PSL(2, ℤ)`. This is used in `TauCeti.NumberTheory.Modular.Torsion`.

The integral group `SL(2, ℤ)` is the amalgam `⟨s, v | s⁴ = 1, s² = v³⟩` with `s ↦ S` and
`v ↦ -U` (`TauCeti.ModularGroup.sl2zPresentationEquiv`). In an abelian quotient, `T = (-U)⁻¹ S⁻¹`
gives `T³ S = 1`, so the class of `T` generates and has order dividing `12`; conversely `s ↦ 9`,
`v ↦ 2` satisfies the relations in `ℤ/12`. Hence the abelianization of `SL(2, ℤ)` is cyclic of
order `12`, generated by the class of `T`, and `-1 = S²` goes to `6`. Since every conjugate of `T`
has class `1`, a product of `n` conjugates of `T` equal to `1` forces `12 ∣ n`.

## Main declarations

* `TauCeti.ModularGroup.abelianizationMulEquiv`: the abelianization of `PSL(2, ℤ)` is
  `Multiplicative (ZMod 6)`, with the class of `T` sent to `1`.
* `TauCeti.ModularGroup.abelianizationMulEquiv_of_coe_S`, `_of_coe_T`, `_of_coe_U`,
  `_of_coe_R`: the images `3`, `1`, `2` and `4` of `S`, `T`, `U` and `R = S T`.
* `TauCeti.ModularGroup.sl2zAbelianizationMulEquiv`: the abelianization of `SL(2, ℤ)` is
  `Multiplicative (ZMod 12)`, with the class of `T` sent to `1`.
* `TauCeti.ModularGroup.sl2zAbelianizationMulEquiv_of_S`, `_of_T`, `_of_neg_one`: the images
  `9`, `1` and `6` of `S`, `T` and `-1`.
* `TauCeti.ModularGroup.sl2z_hom_ext_T`: a homomorphism from `SL(2, ℤ)` to a commutative group
  is determined by its value at `T`.
* `TauCeti.ModularGroup.sl2zAbelianizationMulEquiv_of_of_isConj`,
  `sl2zAbelianizationMulEquiv_of_prod`: every conjugate of `T` goes to `1`, so a product of `n`
  conjugates of `T` goes to `n`.
* `TauCeti.ModularGroup.twelve_dvd_length_of_prod_eq_one`: a product of conjugates of `T` equal
  to `1` has length divisible by `12`.

## References

* J.-P. Serre, *Trees*, Springer, 1980, Chapter I, §4.2 (the amalgams `PSL(2, ℤ) = ℤ/2 ∗ ℤ/3` and
  `SL(2, ℤ) = ℤ/4 ∗_{ℤ/2} ℤ/6`).
-/

public section

open scoped MatrixGroups
open ModularGroup

namespace TauCeti.ModularGroup

/-- The character of `PSL(2, ℤ)` with values in `ℤ/6` sending `U`, `S` and `T` to `2`, `3` and
`1`, read off the triangle presentation. -/
private noncomputable def zmodSixChar : PSL(2, ℤ) →* Multiplicative (ZMod 6) :=
  (TriangleGroup.lift (Multiplicative.ofAdd 2) (Multiplicative.ofAdd 3) (Multiplicative.ofAdd 1)
    (by decide) (by decide) (pow_zero _) (by decide)).comp modularEquiv.symm.toMonoidHom

private theorem zmodSixChar_S : zmodSixChar (S : PSL(2, ℤ)) = Multiplicative.ofAdd 3 := by
  simp [zmodSixChar]

private theorem zmodSixChar_T : zmodSixChar (T : PSL(2, ℤ)) = Multiplicative.ofAdd 1 := by
  simp [zmodSixChar]

private theorem zmodSixChar_U : zmodSixChar (U : PSL(2, ℤ)) = Multiplicative.ofAdd 2 := by
  simp [zmodSixChar]

/-- In the abelianization the class of `S` is the cube of the class of `T`: the relation
`U³ = 1` with `U = S T⁻¹` gives `S³ = T³`, and `S² = 1`. -/
private theorem of_coe_S_eq_of_coe_T_pow_three :
    Group.Abelianization.of (S : PSL(2, ℤ)) = Group.Abelianization.of (T : PSL(2, ℤ)) ^ 3 := by
  have hU : (U : PSL(2, ℤ)) = S * (T : PSL(2, ℤ))⁻¹ := by
    rw [U_def, QuotientGroup.mk_mul, QuotientGroup.mk_inv]
  have h3 : Group.Abelianization.of (U : PSL(2, ℤ)) ^ 3 = 1 := by
    rw [← map_pow, coe_U_pow_three, map_one]
  have h2 : Group.Abelianization.of (S : PSL(2, ℤ)) ^ 2 = 1 := by
    rw [← map_pow, coe_S_sq, map_one]
  rw [hU, map_mul, map_inv, mul_pow, inv_pow, mul_inv_eq_one] at h3
  rw [← h3, pow_succ, h2, one_mul]

/-- In the abelianization the class of `T` has order dividing `6`: its cube is the class of `S`,
whose square is `1`. -/
private theorem of_coe_T_pow_six : Group.Abelianization.of (T : PSL(2, ℤ)) ^ 6 = 1 := by
  rw [show 6 = 3 * 2 by norm_num, pow_mul, ← of_coe_S_eq_of_coe_T_pow_three, ← map_pow, coe_S_sq,
    map_one]

/-- Every element of the abelianization of `PSL(2, ℤ)` is a power of the class of `T`. -/
private theorem exists_eq_of_coe_T_zpow (x : Group.Abelianization PSL(2, ℤ)) :
    ∃ k : ℤ, x = Group.Abelianization.of (T : PSL(2, ℤ)) ^ k := by
  obtain ⟨g, rfl⟩ := Group.Abelianization.surjective_of PSL(2, ℤ) x
  have hg : g ∈ Subgroup.closure {(S : PSL(2, ℤ)), (T : PSL(2, ℤ))} := by
    rw [closure_coe_S_coe_T]
    exact Subgroup.mem_top g
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    rcases hg with rfl | rfl
    · exact ⟨3, by rw [of_coe_S_eq_of_coe_T_pow_three, zpow_ofNat]⟩
    · exact ⟨1, by rw [zpow_one]⟩
  | one => exact ⟨0, by rw [map_one, zpow_zero]⟩
  | mul g h _ _ hg hh =>
    obtain ⟨k, hk⟩ := hg
    obtain ⟨l, hl⟩ := hh
    exact ⟨k + l, by rw [map_mul, hk, hl, zpow_add]⟩
  | inv g _ hg =>
    obtain ⟨k, hk⟩ := hg
    exact ⟨-k, by rw [map_inv, hk, zpow_neg]⟩

private theorem abelianization_lift_zmodSixChar_bijective :
    Function.Bijective (Group.Abelianization.lift zmodSixChar) :=
  Group.Abelianization.lift_bijective_of_generator zmodSixChar zmodSixChar_T of_coe_T_pow_six
    fun x ↦ Subgroup.mem_zpowers_iff.2 ((exists_eq_of_coe_T_zpow x).imp fun _ ↦ Eq.symm)

/-- **The abelianization of the modular group is cyclic of order six**, generated by the class
of the translation `T`: `PSL(2, ℤ)ᵃᵇ ≅ ℤ/6`. The classes of `U = S T⁻¹`, `S` and `T` go to `2`, `3`
and `1`. -/
noncomputable def abelianizationMulEquiv :
    Group.Abelianization PSL(2, ℤ) ≃* Multiplicative (ZMod 6) :=
  MulEquiv.ofBijective _ abelianization_lift_zmodSixChar_bijective

/-- The abelianization of `PSL(2, ℤ)` sends the class of `S` to `3 ∈ ℤ/6`. -/
@[simp]
theorem abelianizationMulEquiv_of_coe_S :
    abelianizationMulEquiv (Group.Abelianization.of (S : PSL(2, ℤ))) = Multiplicative.ofAdd 3 :=
  (Group.Abelianization.lift_apply_of _ _).trans zmodSixChar_S

/-- The abelianization of `PSL(2, ℤ)` sends the class of `T` to `1 ∈ ℤ/6`. -/
@[simp]
theorem abelianizationMulEquiv_of_coe_T :
    abelianizationMulEquiv (Group.Abelianization.of (T : PSL(2, ℤ))) = Multiplicative.ofAdd 1 :=
  (Group.Abelianization.lift_apply_of _ _).trans zmodSixChar_T

/-- The abelianization of `PSL(2, ℤ)` sends the class of `U = S T⁻¹` to `2 ∈ ℤ/6`. -/
@[simp]
theorem abelianizationMulEquiv_of_coe_U :
    abelianizationMulEquiv (Group.Abelianization.of (U : PSL(2, ℤ))) = Multiplicative.ofAdd 2 :=
  (Group.Abelianization.lift_apply_of _ _).trans zmodSixChar_U

/-- The abelianization of `PSL(2, ℤ)` sends the class of `R = S T` to `4 ∈ ℤ/6`. -/
@[simp]
theorem abelianizationMulEquiv_of_coe_R :
    abelianizationMulEquiv (Group.Abelianization.of (R : PSL(2, ℤ))) = Multiplicative.ofAdd 4 := by
  rw [R_def, QuotientGroup.mk_mul, map_mul, map_mul, abelianizationMulEquiv_of_coe_S,
    abelianizationMulEquiv_of_coe_T, ← ofAdd_add]
  decide

/-! ### The abelianization of `SL(2, ℤ)` -/

/-- The character of `SL(2, ℤ)` with values in `ℤ/12` sending `S` and `-U` to `9` and `2`, read
off the amalgam presentation. -/
private noncomputable def zmodTwelveChar : SL(2, ℤ) →* Multiplicative (ZMod 12) :=
  (sl2zLift (Multiplicative.ofAdd 9 : Multiplicative (ZMod 12)) (Multiplicative.ofAdd 2)
    (by decide) (by decide)).comp sl2zPresentationEquiv.symm.toMonoidHom

private theorem zmodTwelveChar_S : zmodTwelveChar S = Multiplicative.ofAdd 9 := by
  simp [zmodTwelveChar]

private theorem zmodTwelveChar_neg_U : zmodTwelveChar (-U) = Multiplicative.ofAdd 2 := by
  simp [zmodTwelveChar]

private theorem zmodTwelveChar_T : zmodTwelveChar T = Multiplicative.ofAdd 1 := by
  simp only [← neg_U_inv_mul_S_inv, map_mul, map_inv, zmodTwelveChar_S, zmodTwelveChar_neg_U,
    ← ofAdd_neg, ← ofAdd_add]
  decide

private theorem of_S_pow_four : Group.Abelianization.of S ^ 4 = 1 := by
  rw [← map_pow, S_pow_four, map_one]

/-- In the abelianization of `SL(2, ℤ)`, `T³ S = 1`: with `T = (-U)⁻¹ S⁻¹`, this is
`(-U)⁻³ S⁻² = 1`, from `(-U)³ = -1 = S²` and `S⁴ = 1`. -/
private theorem of_T_pow_three_mul_of_S :
    Group.Abelianization.of T ^ 3 * Group.Abelianization.of S = 1 := by
  have h3 : Group.Abelianization.of (-U) ^ 3 = Group.Abelianization.of S ^ 2 := by
    rw [← map_pow, ← map_pow, neg_U_pow_three, S_sq]
  simp only [← neg_U_inv_mul_S_inv, map_mul, map_inv, mul_pow, inv_pow, h3]
  calc _ = (Group.Abelianization.of S ^ 4)⁻¹ := by group
    _ = 1 := by rw [of_S_pow_four, inv_one]

/-- In the abelianization of `SL(2, ℤ)` the class of `T` has order dividing `12`. -/
private theorem of_T_pow_twelve : Group.Abelianization.of T ^ 12 = 1 := by
  have h4 := of_S_pow_four
  rw [eq_inv_of_mul_eq_one_right of_T_pow_three_mul_of_S, inv_pow, ← pow_mul] at h4
  exact inv_eq_one.1 h4

/-- Every element of the abelianization of `SL(2, ℤ)` is a power of the class of `T`. -/
private theorem mem_zpowers_of_T (x : Group.Abelianization SL(2, ℤ)) :
    x ∈ Subgroup.zpowers (Group.Abelianization.of T) := by
  obtain ⟨g, rfl⟩ := Group.Abelianization.surjective_of SL(2, ℤ) x
  have h : Subgroup.closure {S, T} ≤
      (Subgroup.zpowers (Group.Abelianization.of T)).comap Group.Abelianization.of := by
    rw [Subgroup.closure_le]
    rintro _ (rfl | rfl)
    · refine Subgroup.mem_comap.2 (Subgroup.mem_zpowers_iff.2 ⟨-3, ?_⟩)
      rw [zpow_neg, zpow_ofNat, inv_eq_of_mul_eq_one_right of_T_pow_three_mul_of_S]
    · exact Subgroup.mem_zpowers _
  exact h (SpecialLinearGroup.SL2Z_generators ▸ Subgroup.mem_top g)

private theorem abelianization_lift_zmodTwelveChar_bijective :
    Function.Bijective (Group.Abelianization.lift zmodTwelveChar) :=
  Group.Abelianization.lift_bijective_of_generator zmodTwelveChar zmodTwelveChar_T of_T_pow_twelve
    mem_zpowers_of_T

/-- **The abelianization of `SL(2, ℤ)` is cyclic of order twelve**, generated by the class of the
translation `T`: `SL(2, ℤ)ᵃᵇ ≅ ℤ/12`. The classes of `S`, `T` and `-1` go to `9`, `1` and `6`. -/
noncomputable def sl2zAbelianizationMulEquiv :
    Group.Abelianization SL(2, ℤ) ≃* Multiplicative (ZMod 12) :=
  MulEquiv.ofBijective _ abelianization_lift_zmodTwelveChar_bijective

/-- The abelianization of `SL(2, ℤ)` sends the class of `T` to `1 ∈ ℤ/12`. -/
@[simp]
theorem sl2zAbelianizationMulEquiv_of_T :
    sl2zAbelianizationMulEquiv (Group.Abelianization.of T) = Multiplicative.ofAdd 1 := by
  rw [sl2zAbelianizationMulEquiv, MulEquiv.ofBijective_apply, Group.Abelianization.lift_apply_of,
    zmodTwelveChar_T]

/-- The abelianization of `SL(2, ℤ)` sends the class of `S` to `9 ∈ ℤ/12`. -/
@[simp]
theorem sl2zAbelianizationMulEquiv_of_S :
    sl2zAbelianizationMulEquiv (Group.Abelianization.of S) = Multiplicative.ofAdd 9 := by
  rw [sl2zAbelianizationMulEquiv, MulEquiv.ofBijective_apply, Group.Abelianization.lift_apply_of,
    zmodTwelveChar_S]

/-- The abelianization of `SL(2, ℤ)` sends the class of `-1` to `6 ∈ ℤ/12`. -/
@[simp]
theorem sl2zAbelianizationMulEquiv_of_neg_one :
    sl2zAbelianizationMulEquiv (Group.Abelianization.of (-1)) = Multiplicative.ofAdd 6 := by
  rw [← S_sq, map_pow, map_pow, sl2zAbelianizationMulEquiv_of_S,
    ← ofAdd_nsmul]
  decide

/-- **A character of `SL(2, ℤ)` is determined by its value at `T`.** Two homomorphisms from
`SL(2, ℤ)` to a commutative group that agree on `T` are equal, since the class of `T` generates
the abelianization. -/
theorem sl2z_hom_ext_T {G : Type*} [CommGroup G] {f g : SL(2, ℤ) →* G} (h : f T = g T) :
    f = g := by
  ext γ
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.1 (mem_zpowers_of_T (Group.Abelianization.of γ))
  rw [← Group.Abelianization.lift_apply_of f, ← Group.Abelianization.lift_apply_of g, ← hn,
    map_zpow, map_zpow, Group.Abelianization.lift_apply_of, Group.Abelianization.lift_apply_of, h]

/-- Under the abelianization of `SL(2, ℤ)`, every conjugate of `T` goes to `1`. -/
theorem sl2zAbelianizationMulEquiv_of_of_isConj {g : SL(2, ℤ)} (hg : IsConj T g) :
    sl2zAbelianizationMulEquiv (Group.Abelianization.of g) = Multiplicative.ofAdd 1 := by
  rw [← sl2zAbelianizationMulEquiv_of_T]
  exact (isConj_iff_eq.1 ((sl2zAbelianizationMulEquiv.toMonoidHom.comp
    Group.Abelianization.of).map_isConj hg)).symm

/-- Under the abelianization of `SL(2, ℤ)`, a product of conjugates of `T` goes to the number of
factors. -/
theorem sl2zAbelianizationMulEquiv_of_prod {l : List SL(2, ℤ)} (hl : ∀ g ∈ l, IsConj T g) :
    sl2zAbelianizationMulEquiv (Group.Abelianization.of l.prod) =
      Multiplicative.ofAdd (l.length : ZMod 12) := by
  induction l with
  | nil => simp
  | cons g l ih =>
    simp [sl2zAbelianizationMulEquiv_of_of_isConj (hl g List.mem_cons_self),
      ih fun h hh ↦ hl h (List.mem_cons_of_mem g hh), ← ofAdd_add, add_comm]

/-- **Twelve divides the length of a positive factorization of the identity**: if a product of
conjugates of `T = [[1, 1], [0, 1]]` in `SL(2, ℤ)` is `1`, the number of factors is divisible
by `12`. -/
theorem twelve_dvd_length_of_prod_eq_one {l : List SL(2, ℤ)} (hl : ∀ g ∈ l, IsConj T g)
    (h : l.prod = 1) : 12 ∣ l.length := by
  have := sl2zAbelianizationMulEquiv_of_prod hl
  rw [h, map_one, map_one, eq_comm, ofAdd_eq_one] at this
  exact (ZMod.natCast_eq_zero_iff _ _).1 this

end TauCeti.ModularGroup
