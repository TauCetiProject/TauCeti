/-!
# The subgroup of `PSL(2, ℤ)` attached to a cycle of digits

Let `n = [n₁, …, n_ℓ]` be a list of natural numbers, with prefix sums `N₀ = 0`,
`N_k = n₁ + ⋯ + n_k` and total `m = N_ℓ`. Duke, Imamoglu and Tóth attach to such a list the
subgroup `Γ(n) ≤ PSL(2, ℤ)` generated by the translation `T ^ m` and the half-turns
`S_k = T ^ N_k * S * T ^ (-N_k)` about the points `N_k + i`, for `0 ≤ k < ℓ`. When `n` is the
reduced minus period of a narrow ideal class of a real quadratic field, the quotient of the
convex hull of the limit set of `Γ(n)` is the bordered hyperbolic surface attached to the class.

This file sets up the group-theoretic side of that construction.

* `TauCeti.ModularGroup.AdmissibleCycle n`: `n` is nonempty, every digit is at least `2` and
  some digit exceeds `2`. It is invariant under permutation, hence under rotation.
* `TauCeti.ModularGroup.halfTurn c = T ^ c * S * T ^ (-c)`: the involution
  `z ↦ c - 1 / (z - c)` of `ℍ`, of exact order two in `PSL(2, ℤ)`, fixing `c + i`.
* `TauCeti.ModularGroup.cycleGroup n`: the subgroup `Γ(n)`, defined for every list.
* `TauCeti.ModularGroup.cycleCenters n`: the set `{N_k + j m | 0 ≤ k < ℓ, j ∈ ℤ}` of integer
  centers. Every half-turn about a center lies in `Γ(n)`, and `Γ(n)` is generated by `T ^ m` and
  these half-turns (`cycleGroup_eq_closure_cycleCenters`). In particular the last center `N_ℓ`
  may replace the first center `N₀` (`cycleGroup_eq_closure_succ`).
* `TauCeti.ModularGroup.cycleGroup_rotate`: moving the first `r` digits of `n` to the end
  conjugates `Γ(n)` by `T ^ (-N_r)`. Consequently cyclically rotated lists give subgroups
  conjugate in `PSL(2, ℤ)`, and in `PSL(2, ℝ)` (`List.IsRotated.exists_map_conj_map_cycleGroup`).

The key arithmetic step is that the centers of a rotated list are the old centers shifted by
`-N_r` (`mem_cycleCenters_rotate_iff`): reading the rotated prefix sums inside the doubled list
`n ++ n` exhibits each of them as a difference of two prefix sums of `n`, up to a multiple of `m`.

## References

* W. Duke, Ö. Imamoglu and Á. Tóth, *Geometric invariants for real quadratic fields*,
  Ann. of Math. 184 (2016), 949–990, §3, (3.1)–(3.2) and the paragraph following them.
-/

public section

open UpperHalfPlane
open scoped MatrixGroups

namespace TauCeti.ModularGroup

open _root_.ModularGroup

/-! ### Admissible cycles -/

/-- A list of digits is an *admissible cycle* if it is nonempty, every digit is at least `2`,
and some digit is greater than `2`. The last condition excludes the all-`2` lists, whose boundary
words `∏ T ^ n_k * S` are parabolic. Repeated lists such as `[4, 4]` are admissible. -/
structure AdmissibleCycle (n : List ℕ) : Prop where
  /-- An admissible cycle is nonempty. -/
  ne_nil : n ≠ []
  /-- Every digit of an admissible cycle is at least `2`. -/
  two_le : ∀ a ∈ n, 2 ≤ a
  /-- Some digit of an admissible cycle is greater than `2`. -/
  exists_two_lt : ∃ a ∈ n, 2 < a

/-- Admissibility unfolded into its three conditions. -/
theorem admissibleCycle_iff {n : List ℕ} :
    AdmissibleCycle n ↔ n ≠ [] ∧ (∀ a ∈ n, 2 ≤ a) ∧ ∃ a ∈ n, 2 < a :=
  ⟨fun h ↦ ⟨h.ne_nil, h.two_le, h.exists_two_lt⟩, fun h ↦ ⟨h.1, h.2.1, h.2.2⟩⟩

instance : DecidablePred AdmissibleCycle := fun _ ↦ decidable_of_iff _ admissibleCycle_iff.symm

/-- The empty list is not admissible. -/
@[simp]
theorem not_admissibleCycle_nil : ¬AdmissibleCycle [] := fun h ↦ h.ne_nil rfl

/-- A list all of whose digits are `2` is not admissible. -/
theorem not_admissibleCycle_replicate_two (k : ℕ) : ¬AdmissibleCycle (List.replicate k 2) :=
  fun h ↦ by
    obtain ⟨a, ha, h2⟩ := h.exists_two_lt
    rw [List.eq_of_mem_replicate ha] at h2
    exact lt_irrefl _ h2

/-- A one-digit list `[a]` is admissible exactly when `a > 2`; for instance `[4]` is. -/
@[simp]
theorem admissibleCycle_singleton_iff {a : ℕ} : AdmissibleCycle [a] ↔ 2 < a := by
  simp only [admissibleCycle_iff, ne_eq, List.cons_ne_nil, not_false_eq_true,
    List.mem_singleton, forall_eq, exists_eq_left, true_and]
  exact ⟨And.right, fun h ↦ ⟨h.le, h⟩⟩

/-- The digit sum of an admissible cycle is at least `3`. -/
theorem AdmissibleCycle.three_le_sum {n : List ℕ} (h : AdmissibleCycle n) : 3 ≤ n.sum := by
  obtain ⟨a, ha, h2⟩ := h.exists_two_lt
  exact h2.trans_le (List.le_sum_of_mem ha)

/-- Admissibility only depends on the multiset of digits. -/
theorem _root_.List.Perm.admissibleCycle_iff {n n' : List ℕ} (h : n.Perm n') :
    AdmissibleCycle n ↔ AdmissibleCycle n' := by
  simp only [ModularGroup.admissibleCycle_iff, ne_eq, ← List.length_eq_zero_iff, h.length_eq,
    h.mem_iff]

/-- Cyclic rotation preserves admissibility in both directions. -/
@[simp]
theorem admissibleCycle_rotate {n : List ℕ} {r : ℕ} :
    AdmissibleCycle (n.rotate r) ↔ AdmissibleCycle n :=
  (List.rotate_perm n r).admissibleCycle_iff

/-! ### Half-turns about integral points -/

/-- The half-turn `T ^ c * S * T ^ (-c)` about the point `c + i` of `ℍ`, the involution
`z ↦ c - 1 / (z - c)`. -/
noncomputable def halfTurn (c : ℤ) : PSL(2, ℤ) :=
  (T : PSL(2, ℤ)) ^ c * S * (T : PSL(2, ℤ)) ^ (-c)

/-- Unfolding of `halfTurn`. -/
theorem halfTurn_def (c : ℤ) : halfTurn c = (T : PSL(2, ℤ)) ^ c * S * (T : PSL(2, ℤ)) ^ (-c) :=
  (rfl)

/-- The half-turn about `i` is `S`. -/
@[simp]
theorem halfTurn_zero : halfTurn 0 = S := by
  simp [halfTurn_def]

/-- Conjugating by the translation `T ^ a` moves the center of a half-turn by `a`. -/
theorem halfTurn_add (a c : ℤ) :
    halfTurn (a + c) = (T : PSL(2, ℤ)) ^ a * halfTurn c * (T : PSL(2, ℤ)) ^ (-a) := by
  simp only [halfTurn_def, zpow_add, zpow_neg, mul_inv_rev, mul_assoc]

/-- A half-turn is an involution of `PSL(2, ℤ)`; its representative in `SL(2, ℤ)` squares
to `-1`, not `1`. -/
@[simp]
theorem halfTurn_sq (c : ℤ) : halfTurn c ^ 2 = 1 := by
  rw [halfTurn_def, zpow_neg, ← MulAut.conj_apply, ← map_pow, coe_S_sq, map_one]

/-- A half-turn is its own inverse. -/
@[simp]
theorem halfTurn_inv (c : ℤ) : (halfTurn c)⁻¹ = halfTurn c :=
  inv_eq_of_mul_eq_one_right (by rw [← sq, halfTurn_sq])

/-- A half-turn has exact order two in `PSL(2, ℤ)`. -/
@[simp]
theorem orderOf_halfTurn (c : ℤ) : orderOf (halfTurn c) = 2 := by
  rw [halfTurn_def, zpow_neg, ← MulAut.conj_apply, ← MulEquiv.coe_toMonoidHom,
    orderOf_injective _ (MulEquiv.injective _), orderOf_coe_S]

/-- A half-turn is not the identity of `PSL(2, ℤ)`. -/
theorem halfTurn_ne_one (c : ℤ) : halfTurn c ≠ 1 := by
  intro h
  simpa [h] using orderOf_halfTurn c

/-- The half-turn about `c + i` acts on `ℍ` by `z ↦ c - 1 / (z - c)`. -/
theorem coe_halfTurn_smul (c : ℤ) (z : ℍ) :
    ((halfTurn c • z : ℍ) : ℂ) = c - ((z : ℂ) - c)⁻¹ := by
  simp only [halfTurn_def, mul_smul, ← QuotientGroup.mk_zpow, pslMk_smul, modular_T_zpow_smul,
    modular_S_smul, coe_vadd]
  push_cast
  rw [inv_neg, neg_add_eq_sub]
  ring

/-- The half-turn about `c + i` fixes `c + i`. -/
@[simp]
theorem halfTurn_smul_vadd_I (c : ℤ) : halfTurn c • ((c : ℝ) +ᵥ I) = (c : ℝ) +ᵥ I := by
  ext
  rw [coe_halfTurn_smul, coe_vadd, coe_I]
  push_cast
  rw [add_sub_cancel_left, Complex.inv_I]
  ring

/-! ### Cycle groups -/

/-- The cycle group `Γ(n) ≤ PSL(2, ℤ)` of a list of digits `n`: the subgroup generated by the
translation `T ^ m` by the digit sum `m = n.sum`, and the half-turns about `N_k + i` for the
prefix sums `N_k = (n.take k).sum`, `0 ≤ k < n.length`. -/
noncomputable def cycleGroup (n : List ℕ) : Subgroup PSL(2, ℤ) :=
  Subgroup.closure (insert ((T : PSL(2, ℤ)) ^ (n.sum : ℤ))
    (Set.range fun k : Fin n.length ↦ halfTurn (n.take k).sum))

/-- Unfolding of `cycleGroup`: the closure of `T ^ m` and the half-turns about `N_k + i`,
`0 ≤ k < ℓ`. -/
theorem cycleGroup_def (n : List ℕ) :
    cycleGroup n = Subgroup.closure (insert ((T : PSL(2, ℤ)) ^ (n.sum : ℤ))
      (Set.range fun k : Fin n.length ↦ halfTurn (n.take k).sum)) :=
  (rfl)

/-- The translation `T ^ m` by the digit sum lies in the cycle group. -/
theorem coe_T_zpow_sum_mem_cycleGroup (n : List ℕ) :
    (T : PSL(2, ℤ)) ^ (n.sum : ℤ) ∈ cycleGroup n :=
  Subgroup.subset_closure (Set.mem_insert _ _)

/-- The universal property of the cycle group: it lies in a subgroup `H` exactly when `H`
contains `T ^ m` and each half-turn about a prefix-sum center `N_k + i`, `0 ≤ k < ℓ`. -/
theorem cycleGroup_le_iff {n : List ℕ} {H : Subgroup PSL(2, ℤ)} :
    cycleGroup n ≤ H ↔ (T : PSL(2, ℤ)) ^ (n.sum : ℤ) ∈ H ∧
      ∀ k < n.length, halfTurn (n.take k).sum ∈ H := by
  simp [cycleGroup_def, Subgroup.closure_le, Set.insert_subset_iff, Set.range_subset_iff,
    Fin.forall_iff]

/-- The cycle group of the empty list is trivial. -/
@[simp]
theorem cycleGroup_nil : cycleGroup [] = ⊥ := by
  simp [cycleGroup_def]

/-- The integer centers `N_k + j m`, `0 ≤ k < ℓ`, `j ∈ ℤ`, of the half-turns of the cycle
group, where `N_k` are the prefix sums and `m` is the digit sum. -/
def cycleCenters (n : List ℕ) : Set ℤ :=
  {c | ∃ k < n.length, ∃ j : ℤ, c = (n.take k).sum + j * n.sum}

/-- Membership in `cycleCenters`. -/
@[simp]
theorem mem_cycleCenters_iff {n : List ℕ} {c : ℤ} :
    c ∈ cycleCenters n ↔ ∃ k < n.length, ∃ j : ℤ, c = (n.take k).sum + j * n.sum :=
  Iff.rfl

/-- The empty list has no centers. -/
@[simp]
theorem cycleCenters_nil : cycleCenters [] = ∅ := by
  simp [cycleCenters]

/-- For a nonempty list, every prefix sum `N_k` plus a multiple of the digit sum is a center,
whatever `k`: the prefix sums with `k ≥ ℓ` equal `m = N₀ + m`. -/
theorem take_sum_add_mul_sum_mem_cycleCenters {n : List ℕ} (hn : n ≠ []) (k : ℕ) (j : ℤ) :
    ((n.take k).sum : ℤ) + j * n.sum ∈ cycleCenters n := by
  rcases lt_or_ge k n.length with hk | hk
  · exact ⟨k, hk, j, rfl⟩
  · refine ⟨0, List.length_pos_iff.mpr hn, j + 1, ?_⟩
    simp only [List.take_of_length_le hk, List.take_zero, List.sum_nil, Nat.cast_zero]
    ring

/-- Every half-turn about a center `N_k + j m + i` lies in the cycle group. -/
theorem halfTurn_mem_cycleGroup {n : List ℕ} {c : ℤ} (hc : c ∈ cycleCenters n) :
    halfTurn c ∈ cycleGroup n := by
  obtain ⟨k, hk, j, rfl⟩ := hc
  have hT (i : ℤ) : (T : PSL(2, ℤ)) ^ (i * n.sum) ∈ cycleGroup n := by
    rw [mul_comm, zpow_mul]
    exact zpow_mem (coe_T_zpow_sum_mem_cycleGroup n) i
  rw [add_comm, halfTurn_add, ← neg_mul]
  exact mul_mem (mul_mem (hT j)
    (Subgroup.subset_closure (Set.mem_insert_of_mem _ ⟨⟨k, hk⟩, rfl⟩))) (hT (-j))

/-- For a nonempty list, the half-turn about every prefix-sum point `N_k + i` lies in the cycle
group, including `N_ℓ + i = m + i`. -/
theorem halfTurn_take_sum_mem_cycleGroup {n : List ℕ} (hn : n ≠ []) (k : ℕ) :
    halfTurn (n.take k).sum ∈ cycleGroup n := by
  simpa using halfTurn_mem_cycleGroup (take_sum_add_mul_sum_mem_cycleCenters hn k 0)

/-- The cycle group is generated by `T ^ m` and all half-turns about its centers. -/
theorem cycleGroup_eq_closure_cycleCenters (n : List ℕ) :
    cycleGroup n =
      Subgroup.closure (insert ((T : PSL(2, ℤ)) ^ (n.sum : ℤ)) (halfTurn '' cycleCenters n)) := by
  refine le_antisymm (cycleGroup_le_iff.mpr ⟨Subgroup.subset_closure (Set.mem_insert _ _),
    fun k hk ↦ Subgroup.subset_closure (Set.mem_insert_of_mem _ ⟨_, ⟨k, hk, 0, by simp⟩, rfl⟩)⟩)
    ?_
  rw [Subgroup.closure_le, Set.insert_subset_iff, Set.image_subset_iff]
  exact ⟨coe_T_zpow_sum_mem_cycleGroup n, fun c hc ↦ halfTurn_mem_cycleGroup hc⟩

/-- The cycle group is also generated by `T ^ m` and the half-turns about `N_k + i` for
`1 ≤ k ≤ ℓ`: the last center `N_ℓ = m` may replace the first center `N₀ = 0`. -/
theorem cycleGroup_eq_closure_succ (n : List ℕ) :
    cycleGroup n = Subgroup.closure (insert ((T : PSL(2, ℤ)) ^ (n.sum : ℤ))
      (Set.range fun k : Fin n.length ↦ halfTurn (n.take (k + 1)).sum)) := by
  set K := Subgroup.closure (insert ((T : PSL(2, ℤ)) ^ (n.sum : ℤ))
    (Set.range fun k : Fin n.length ↦ halfTurn (n.take (k + 1)).sum))
  have hm : (T : PSL(2, ℤ)) ^ (n.sum : ℤ) ∈ K := Subgroup.subset_closure (Set.mem_insert _ _)
  refine le_antisymm (cycleGroup_le_iff.mpr ⟨hm, fun k hk ↦ ?_⟩) ?_
  · rcases k with _ | k
    · -- `S = T ^ (-m) * S_ℓ * T ^ m`, where `S_ℓ` is the half-turn about `N_ℓ = m`
      obtain ⟨l, hl⟩ := Nat.exists_eq_add_one_of_ne_zero hk.ne'
      have hS : halfTurn (n.sum : ℤ) ∈ K :=
        Subgroup.subset_closure (Set.mem_insert_of_mem _ ⟨⟨l, by omega⟩, by simp [← hl]⟩)
      have h := halfTurn_add (-(n.sum : ℤ)) n.sum
      rw [neg_add_cancel, neg_neg, zpow_neg] at h
      rw [List.take_zero, List.sum_nil, Nat.cast_zero, h]
      exact mul_mem (mul_mem (inv_mem hm) hS) hm
    · exact Subgroup.subset_closure (Set.mem_insert_of_mem _ ⟨⟨k, by omega⟩, rfl⟩)
  · rw [Subgroup.closure_le, Set.insert_subset_iff, Set.range_subset_iff]
    exact ⟨coe_T_zpow_sum_mem_cycleGroup n,
      fun k ↦ halfTurn_take_sum_mem_cycleGroup (List.ne_nil_of_length_pos k.pos) _⟩

/-! ### Rotation of the digit cycle -/

/-- `List.sum_take_add_sum_take_rotate` for digit lists, cast to `ℤ`. -/
private theorem cast_sum_take_add_sum_take_rotate {n : List ℕ} {r j : ℕ} (hr : r ≤ n.length)
    (hj : j ≤ n.length) :
    ((n.take r).sum : ℤ) + ((n.rotate r).take j).sum =
      (n.take (r + j)).sum + (n.take (r + j - n.length)).sum := by
  exact_mod_cast List.sum_take_add_sum_take_rotate hr hj

private theorem cycleCenters_rotate_subset {n : List ℕ} {r : ℕ} (hr : r ≤ n.length) {c : ℤ}
    (hc : c ∈ cycleCenters (n.rotate r)) : c + (n.take r).sum ∈ cycleCenters n := by
  obtain ⟨j, hj, t, rfl⟩ := hc
  rw [List.length_rotate] at hj
  have hn : n ≠ [] := List.ne_nil_of_length_pos (by omega)
  have key := cast_sum_take_add_sum_take_rotate hr hj.le
  rw [List.sum_rotate]
  rcases lt_or_ge (r + j) n.length with h | h
  · rw [Nat.sub_eq_zero_of_le h.le, List.take_zero, List.sum_nil, Nat.cast_zero, add_zero] at key
    convert take_sum_add_mul_sum_mem_cycleCenters hn (r + j) t using 1
    linear_combination key
  · rw [List.take_of_length_le h] at key
    convert take_sum_add_mul_sum_mem_cycleCenters hn (r + j - n.length) (t + 1) using 1
    linear_combination key

private theorem cycleCenters_subset_rotate {n : List ℕ} {r : ℕ} (hr : r ≤ n.length) {c : ℤ}
    (hc : c + (n.take r).sum ∈ cycleCenters n) : c ∈ cycleCenters (n.rotate r) := by
  obtain ⟨k, hk, t, hkt⟩ := hc
  have hn : n.rotate r ≠ [] := by
    rw [ne_eq, List.rotate_eq_nil_iff]
    exact List.ne_nil_of_length_pos (by omega)
  rcases le_or_gt r k with h | h
  · have key := cast_sum_take_add_sum_take_rotate hr (j := k - r) (by omega)
    rw [show r + (k - r) = k by omega, Nat.sub_eq_zero_of_le hk.le, List.take_zero,
      List.sum_nil, Nat.cast_zero, add_zero] at key
    convert take_sum_add_mul_sum_mem_cycleCenters hn (k - r) t using 1
    rw [List.sum_rotate]
    linear_combination hkt - key
  · have key := cast_sum_take_add_sum_take_rotate hr (j := n.length - r + k) (by omega)
    rw [show r + (n.length - r + k) = n.length + k by omega, Nat.add_sub_cancel_left,
      List.take_of_length_le (by omega : n.length ≤ n.length + k)] at key
    convert take_sum_add_mul_sum_mem_cycleCenters hn (n.length - r + k) (t - 1) using 1
    rw [List.sum_rotate]
    linear_combination hkt - key

/-- The centers of a rotated cycle are the old centers shifted by `-N_r`. -/
theorem mem_cycleCenters_rotate_iff {n : List ℕ} {r : ℕ} (hr : r ≤ n.length) {c : ℤ} :
    c ∈ cycleCenters (n.rotate r) ↔ c + (n.take r).sum ∈ cycleCenters n :=
  ⟨cycleCenters_rotate_subset hr, cycleCenters_subset_rotate hr⟩

/-- **Rotation conjugacy.** Moving the first `r ≤ ℓ` digits of `n` to the end conjugates the
cycle group by the translation `T ^ (-N_r)`. For `[3, 6]` and `r = 1` this says that the cycle
group of `[6, 3]` is the conjugate of that of `[3, 6]` by `T ^ (-3)`. -/
theorem cycleGroup_rotate (n : List ℕ) {r : ℕ} (hr : r ≤ n.length) :
    cycleGroup (n.rotate r) = (cycleGroup n).map
      (MulAut.conj ((T : PSL(2, ℤ)) ^ (-((n.take r).sum : ℤ)))).toMonoidHom := by
  set g := (MulAut.conj ((T : PSL(2, ℤ)) ^ (-((n.take r).sum : ℤ)))).toMonoidHom
  -- the translation `T ^ m` commutes with the conjugator
  have hT : g ((T : PSL(2, ℤ)) ^ (n.sum : ℤ)) = (T : PSL(2, ℤ)) ^ (n.sum : ℤ) := by
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, (Commute.zpow_zpow_self _ _ _).eq,
      mul_inv_cancel_right]
  -- conjugation moves the center of each half-turn by `-N_r`
  have hg (c : ℤ) : g (halfTurn c) = halfTurn (-((n.take r).sum : ℤ) + c) := by
    simp only [g, halfTurn_add, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, zpow_neg, inv_inv]
  have hS : g '' (halfTurn '' cycleCenters n) = halfTurn '' cycleCenters (n.rotate r) := by
    ext x
    constructor
    · rintro ⟨_, ⟨c, hc, rfl⟩, rfl⟩
      exact ⟨_, (mem_cycleCenters_rotate_iff hr).mpr (by simpa using hc), (hg c).symm⟩
    · rintro ⟨c, hc, rfl⟩
      refine ⟨_, ⟨_, (mem_cycleCenters_rotate_iff hr).mp hc, rfl⟩, ?_⟩
      rw [hg]
      congr 1
      ring
  rw [cycleGroup_eq_closure_cycleCenters, cycleGroup_eq_closure_cycleCenters,
    MonoidHom.map_closure, Set.image_insert_eq, hT, hS, List.sum_rotate]

/-- Cyclically rotated digit lists have cycle groups conjugate by an integral translation. -/
theorem _root_.List.IsRotated.exists_cycleGroup_eq_map_conj {n n' : List ℕ} (h : n ~r n') :
    ∃ c : ℤ, cycleGroup n' =
      (cycleGroup n).map (MulAut.conj ((T : PSL(2, ℤ)) ^ c)).toMonoidHom := by
  obtain ⟨r, rfl⟩ := h
  rcases eq_or_ne n [] with rfl | hn
  · have h := cycleGroup_rotate [] (r := 0) le_rfl
    rw [List.rotate_zero] at h
    exact ⟨_, by rw [List.rotate_nil]; exact h⟩
  · rw [← List.rotate_mod]
    exact ⟨_, cycleGroup_rotate n (Nat.mod_lt _ (List.length_pos_iff.mpr hn)).le⟩

/-- Cyclically rotated digit lists have cycle groups conjugate in `PSL(2, ℝ)`, after embedding
both in `PSL(2, ℝ)`. -/
theorem _root_.List.IsRotated.exists_map_conj_map_cycleGroup {n n' : List ℕ} (h : n ~r n') :
    ∃ φ : PSL(2, ℝ), ((cycleGroup n).map psl2zToPSL2R).map (MulAut.conj φ).toMonoidHom =
      (cycleGroup n').map psl2zToPSL2R := by
  obtain ⟨c, hc⟩ := h.exists_cycleGroup_eq_map_conj
  refine ⟨psl2zToPSL2R ((T : PSL(2, ℤ)) ^ c), ?_⟩
  rw [hc, Subgroup.map_map, Subgroup.map_map]
  congr 1
  refine MonoidHom.ext fun g ↦ ?_
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, map_mul,
    map_inv]

end TauCeti.ModularGroup
