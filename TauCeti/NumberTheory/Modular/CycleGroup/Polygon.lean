/-!
# The Ford polygon of a digit cycle

A list of digits `n = [n₁, …, n_ℓ]` has prefix sums `N₀ = 0`, `N_k = n₁ + ⋯ + n_k` and digit sum
`m = N_ℓ`. Duke, Imamoglu and Tóth attach to it the subgroup of `PSL(2, ℤ)` generated by `z ↦ z + m`
and the half-turns about the points `N_k + i`. Its Ford polygon is the closed strip
`0 ≤ Re z ≤ m` with the open unit discs about the centres `N₀, …, N_ℓ` removed:
`TauCeti.ModularGroup.cyclePolygon n`. This file develops the geometry of this polygon that
depends only on the digits.

When every digit is at least `2`, distinct centres are at least `2` apart, so the closed unit
discs about them do not meet in `ℍ`. Two consecutive discs touch only at a point of the real
axis, when their digit is exactly `2`. Between the discs about `N_k` and `N_{k+1}` the polygon
reaches the real axis along the free interval `(N_k + 1, N_{k+1} - 1)`, which has length
`n_{k+1} - 2`. Over such an interval the polygon contains whole vertical rays, so it has
infinite hyperbolic area as soon as some digit exceeds `2`. Above height `1` the polygon is
the full strip, of area `m / Y` above height `Y ≥ 1`.

Prefix sums are written `(n.take k).sum`, and lists are `0`-indexed: the digit between the
centres `(n.take k).sum` and `(n.take (k + 1)).sum` is `n[k]`.

## Main declarations

* `TauCeti.ModularGroup.cyclePolygon n`: the Ford polygon, with `mem_cyclePolygon` and
  `one_le_normSq_sub_of_mem_cyclePolygon` (every prefix centre, in any position).
* `TauCeti.ModularGroup.isClosed_cyclePolygon`, `measurableSet_cyclePolygon` and
  `geodesicSegment_subset_cyclePolygon`: the polygon is closed, measurable and hyperbolically
  convex.
* `TauCeti.ModularGroup.disjoint_setOf_normSq_sub_take_sum_le_one`: for digits at least `2`,
  distinct centres are at least `2` apart (`List.sum_take_add_le_sum_take`), so their closed unit
  discs are disjoint in `ℍ`.
* `TauCeti.ModularGroup.cyclePolygon_inter_setOf_lt_im` and
  `volume_cyclePolygon_inter_setOf_lt_im`: above height `Y ≥ 1` the polygon is the full strip,
  of area `m / Y`; `take_sum_vadd_I_mem_cyclePolygon`: the points `N_k + i` lie in it.
* `TauCeti.ModularGroup.cycleFreeInterval n k`: the `k`-th free interval, with
  `volume_cycleFreeInterval` (its length is `n[k] - 2`), `cycleFreeInterval_nonempty_iff`, and
  `mem_cyclePolygon_of_re_mem_Icc` (the vertical rays over its closure lie in the polygon).
* `TauCeti.ModularGroup.volume_cyclePolygon_eq_top`: the polygon has infinite area when some
  digit exceeds `2`.

## References

* W. Duke, Ö. Imamoglu and Á. Tóth, *Geometric invariants for real quadratic fields*,
  Ann. of Math. (2) 184 (2016), 949–990, §3: Figures 1, 4 and 7 and the proof of Theorem 1
  (p. 957).
-/

public section

noncomputable section

open UpperHalfPlane MeasureTheory Set
open scoped ENNReal NNReal

namespace TauCeti.ModularGroup

/-- The Ford polygon of a digit list `n = [n₁, …, n_ℓ]`: the closed strip `0 ≤ Re z ≤ m`, where
`m = n.sum`, outside the open unit discs about all prefix sums `N_k = (n.take k).sum`,
`0 ≤ k ≤ ℓ`, including both end centres `0` and `m`. The ideal free intervals on the real axis
are not points of this subset of `ℍ`. -/
def cyclePolygon (n : List ℕ) : Set ℍ :=
  {z | 0 ≤ z.re ∧ z.re ≤ (n.sum : ℝ) ∧
    ∀ k ∈ Finset.range (n.length + 1),
      1 ≤ Complex.normSq ((z : ℂ) - ((n.take k).sum : ℂ))}

variable {n : List ℕ} {z : ℍ}

/-- The squared Euclidean distance from `z` to a natural-number centre `N`, in coordinates. -/
private theorem normSq_coe_sub_natCast (z : ℍ) (N : ℕ) :
    Complex.normSq ((z : ℂ) - N) = (z.re - N) ^ 2 + z.im ^ 2 := by
  rw [← Complex.ofReal_natCast, Complex.normSq_sub_ofReal, coe_re, coe_im]

/-- Membership in the Ford polygon is the strip condition together with the `ℓ + 1`
exterior-disc inequalities. -/
@[simp]
theorem mem_cyclePolygon :
    z ∈ cyclePolygon n ↔ 0 ≤ z.re ∧ z.re ≤ (n.sum : ℝ) ∧
      ∀ k ≤ n.length, 1 ≤ Complex.normSq ((z : ℂ) - ((n.take k).sum : ℂ)) := by
  simp [cyclePolygon]

/-- A point of the Ford polygon lies outside the open unit disc about every prefix sum,
including the prefix sums `(n.take k).sum = n.sum` with `k > ℓ`. -/
theorem one_le_normSq_sub_of_mem_cyclePolygon (hz : z ∈ cyclePolygon n) (k : ℕ) :
    1 ≤ Complex.normSq ((z : ℂ) - ((n.take k).sum : ℂ)) := by
  rw [mem_cyclePolygon] at hz
  rcases le_total k n.length with hk | hk
  · exact hz.2.2 k hk
  · simpa [List.take_of_length_le hk] using hz.2.2 n.length le_rfl

/-- The Ford polygon is closed in `ℍ`. -/
theorem isClosed_cyclePolygon (n : List ℕ) : IsClosed (cyclePolygon n) := by
  have hN (k : ℕ) : Continuous fun z : ℍ ↦ Complex.normSq ((z : ℂ) - ((n.take k).sum : ℂ)) :=
    Complex.continuous_normSq.comp (continuous_coe.sub continuous_const)
  have h : cyclePolygon n = {z : ℍ | 0 ≤ z.re} ∩ {z : ℍ | z.re ≤ (n.sum : ℝ)} ∩
      ⋂ k ∈ Finset.range (n.length + 1),
        {z : ℍ | 1 ≤ Complex.normSq ((z : ℂ) - ((n.take k).sum : ℂ))} := by
    ext z
    simp [cyclePolygon, and_assoc]
  rw [h]
  exact ((isClosed_le continuous_const continuous_re).inter
    (isClosed_le continuous_re continuous_const)).inter
      (isClosed_biInter fun k _ ↦ isClosed_le continuous_const (hN k))

/-- The Ford polygon is measurable. -/
theorem measurableSet_cyclePolygon (n : List ℕ) : MeasurableSet (cyclePolygon n) :=
  (isClosed_cyclePolygon n).measurableSet

/-- The Ford polygon is hyperbolically convex: it contains the geodesic segment joining any two
of its points. It is an intersection of closed hyperbolic half-planes, bounded by the two
vertical sides and by the unit semicircles. -/
theorem geodesicSegment_subset_cyclePolygon {w : ℍ} (hz : z ∈ cyclePolygon n)
    (hw : w ∈ cyclePolygon n) : geodesicSegment z w ⊆ cyclePolygon n := by
  intro u hu
  rw [mem_cyclePolygon] at hz hw ⊢
  refine ⟨UpperHalfPlane.geodesicSegment_subset_setOf_le_re hz.1 hw.1 hu,
    UpperHalfPlane.geodesicSegment_subset_setOf_re_le hz.2.1 hw.2.1 hu, fun k hk ↦ ?_⟩
  have hzk := hz.2.2 k hk
  have hwk := hw.2.2 k hk
  rw [← Complex.ofReal_natCast] at hzk hwk ⊢
  exact UpperHalfPlane.geodesicSegment_subset_setOf_le_normSq_sub hzk hwk hu

/-! ### Separation of the centres -/

/-- If every digit is at least `2`, then the closed unit discs about two distinct prefix sums do
not meet in `ℍ`: their centres are at least `2` apart, so they can only touch on the real
axis. -/
theorem disjoint_setOf_normSq_sub_take_sum_le_one (hn : ∀ a ∈ n, 2 ≤ a) {j k : ℕ} (hjk : j ≠ k)
    (hj : j ≤ n.length) (hk : k ≤ n.length) :
    Disjoint {z : ℍ | Complex.normSq ((z : ℂ) - ((n.take j).sum : ℂ)) ≤ 1}
      {z : ℍ | Complex.normSq ((z : ℂ) - ((n.take k).sum : ℂ)) ≤ 1} := by
  -- Points within distance `1` of two real centres force the centres to be less than `2` apart.
  have key {a b : ℕ} (hab : a + 2 ≤ b) (z : ℍ)
      (ha : Complex.normSq ((z : ℂ) - (a : ℂ)) ≤ 1)
      (hb : Complex.normSq ((z : ℂ) - (b : ℂ)) ≤ 1) : False := by
    have hab' : (a : ℝ) + 2 ≤ b := by exact_mod_cast hab
    rw [normSq_coe_sub_natCast] at ha hb
    nlinarith [z.im_pos, sq_nonneg (z.re - a + (z.re - b))]
  rw [Set.disjoint_left]
  intro z hzj hzk
  rcases hjk.lt_or_gt with h | h
  · exact key (List.sum_take_add_le_sum_take hn h (h.trans_le hk)) z hzj hzk
  · exact key (List.sum_take_add_le_sum_take hn h (h.trans_le hj)) z hzk hzj

/-! ### The cusp strip -/

/-- A point of the closed strip `0 ≤ Re z ≤ m` at height at least `1` lies in the Ford
polygon. -/
theorem mem_cyclePolygon_of_one_le_im (h0 : 0 ≤ z.re) (hm : z.re ≤ (n.sum : ℝ))
    (him : 1 ≤ z.im) : z ∈ cyclePolygon n := by
  refine mem_cyclePolygon.2 ⟨h0, hm, fun k _ ↦ ?_⟩
  rw [normSq_coe_sub_natCast]
  nlinarith [sq_nonneg (z.re - (n.take k).sum)]

/-- The points `N_k + i` lie in the Ford polygon, for every prefix sum `N_k`. -/
theorem take_sum_vadd_I_mem_cyclePolygon (k : ℕ) :
    ((n.take k).sum : ℝ) +ᵥ I ∈ cyclePolygon n := by
  refine mem_cyclePolygon_of_one_le_im ?_ ?_ (by simp)
  · rw [vadd_re, I_re, add_zero]
    positivity
  · rw [vadd_re, I_re, add_zero]
    exact_mod_cast (List.take_sublist k n).sum_le_sum fun _ _ ↦ Nat.zero_le _

/-- Above any height `Y ≥ 1`, the Ford polygon is the full strip `0 ≤ Re z ≤ m`. -/
theorem cyclePolygon_inter_setOf_lt_im {Y : ℝ} (hY : 1 ≤ Y) :
    cyclePolygon n ∩ {z | Y < z.im} = {z | z.re ∈ Icc 0 (n.sum : ℝ) ∧ Y < z.im} := by
  ext z
  refine ⟨fun ⟨hz, hY'⟩ ↦ ⟨⟨(mem_cyclePolygon.1 hz).1, (mem_cyclePolygon.1 hz).2.1⟩, hY'⟩,
    fun ⟨⟨h0, hm⟩, hY'⟩ ↦ ⟨mem_cyclePolygon_of_one_le_im h0 hm (hY.trans hY'.le), hY'⟩⟩

/-- Above any height `Y ≥ 1`, the Ford polygon has hyperbolic area `m / Y`. -/
theorem volume_cyclePolygon_inter_setOf_lt_im {Y : ℝ} (hY : 1 ≤ Y) :
    volume (cyclePolygon n ∩ {z | Y < z.im}) = n.sum * ENNReal.ofReal Y⁻¹ := by
  rw [cyclePolygon_inter_setOf_lt_im hY,
    UpperHalfPlane.volume_setOf_re_mem_and_lt_im _ (zero_lt_one.trans_le hY), Real.volume_Icc,
    sub_zero, ENNReal.ofReal_natCast]

/-! ### Free intervals and infinite area -/

/-- The `k`-th free interval of the digit list `n`: the open interval `(N_k + 1, N_{k+1} - 1)`
of the real axis between the unit discs about the prefix sums `N_k = (n.take k).sum` and
`N_{k+1} = (n.take (k + 1)).sum`. It is not part of the Ford polygon, but the vertical ray over
each of its points lies in the polygon (`mem_cyclePolygon_of_re_mem_Icc`), so it is ideal
boundary of the polygon. It is empty unless the digit `n[k]` exceeds `2`. -/
def cycleFreeInterval (n : List ℕ) (k : ℕ) : Set ℝ :=
  Ioo (((n.take k).sum : ℝ) + 1) ((n.take (k + 1)).sum - 1)

/-- The free interval, unfolded. -/
theorem cycleFreeInterval_def (n : List ℕ) (k : ℕ) :
    cycleFreeInterval n k = Ioo (((n.take k).sum : ℝ) + 1) ((n.take (k + 1)).sum - 1) :=
  (rfl)

/-- Membership in the `k`-th free interval. -/
@[simp]
theorem mem_cycleFreeInterval {k : ℕ} {x : ℝ} :
    x ∈ cycleFreeInterval n k ↔
      ((n.take k).sum : ℝ) + 1 < x ∧ x < ((n.take (k + 1)).sum : ℝ) - 1 := by
  rw [cycleFreeInterval_def, mem_Ioo]

/-- For `k < ℓ`, the real prefix sum `N_{k+1}` equals `N_k + n[k]`. -/
private theorem take_succ_sum_cast {k : ℕ} (hk : k < n.length) :
    ((n.take (k + 1)).sum : ℝ) = (n.take k).sum + n[k] := by
  rw [List.sum_take_succ n k hk, Nat.cast_add]

/-- The `k`-th free interval has length `n[k] - 2`. -/
theorem volume_cycleFreeInterval {k : ℕ} (hk : k < n.length) :
    volume (cycleFreeInterval n k) = ENNReal.ofReal (n[k] - 2) := by
  rw [cycleFreeInterval_def, Real.volume_Ioo, take_succ_sum_cast hk]
  congr 1
  ring

/-- The `k`-th free interval is nonempty exactly when the digit `n[k]` exceeds `2`. -/
theorem cycleFreeInterval_nonempty_iff {k : ℕ} (hk : k < n.length) :
    (cycleFreeInterval n k).Nonempty ↔ 2 < n[k] := by
  rw [cycleFreeInterval_def, nonempty_Ioo, take_succ_sum_cast hk, ← Nat.ofNat_lt_cast (α := ℝ)]
  constructor <;> intro h <;> linarith

/-- Every point of `ℍ` whose real part lies in the closure `[N_k + 1, N_{k+1} - 1]` of the `k`-th
free interval lies in the Ford polygon. So the polygon contains the whole vertical ray over each
point of the free interval, which is therefore ideal boundary of the polygon. -/
theorem mem_cyclePolygon_of_re_mem_Icc {k : ℕ}
    (hz : z.re ∈ Icc (((n.take k).sum : ℝ) + 1) ((n.take (k + 1)).sum - 1)) :
    z ∈ cyclePolygon n := by
  obtain ⟨hl, hr⟩ := hz
  have hsum : ((n.take (k + 1)).sum : ℝ) ≤ n.sum := by
    exact_mod_cast (List.take_sublist (k + 1) n).sum_le_sum fun _ _ ↦ Nat.zero_le _
  refine mem_cyclePolygon.2 ⟨by linarith, by linarith, fun j _ ↦ ?_⟩
  rw [normSq_coe_sub_natCast]
  -- The centre `N_j` lies at or left of `N_k`, or at or right of `N_{k+1}`.
  have hgap : 1 ≤ (z.re - (n.take j).sum) ^ 2 := by
    rcases le_or_gt j k with hjk | hjk
    · have : ((n.take j).sum : ℝ) ≤ (n.take k).sum := by
        exact_mod_cast List.monotone_sum_take n hjk
      nlinarith
    · have : ((n.take (k + 1)).sum : ℝ) ≤ (n.take j).sum := by
        exact_mod_cast List.monotone_sum_take n hjk
      nlinarith
  nlinarith [sq_nonneg z.im]

/-- The Ford polygon has infinite hyperbolic area as soon as some digit exceeds `2`: over a
nonempty free interval it contains the region `{y > ε}` for every `ε > 0`, whose area
`(n[k] - 2) / ε` is unbounded. -/
theorem volume_cyclePolygon_eq_top (h : ∃ a ∈ n, 2 < a) : volume (cyclePolygon n) = ∞ := by
  obtain ⟨a, ha, h2a⟩ := h
  obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.1 ha
  have hlen : (0 : ℝ) < n[k] - 2 := by
    have : (2 : ℝ) < n[k] := by exact_mod_cast h2a
    linarith
  refine ENNReal.eq_top_of_forall_nnreal_le fun r ↦ ?_
  -- Above the height `ε = (n[k] - 2) / (r + 1)` the free interval carries area `r + 1`.
  set ε : ℝ := (n[k] - 2) / (r + 1)
  have hε : 0 < ε := div_pos hlen (by positivity)
  have hsub : {z : ℍ | z.re ∈ cycleFreeInterval n k ∧ ε < z.im} ⊆ cyclePolygon n :=
    fun z hz ↦ mem_cyclePolygon_of_re_mem_Icc (Ioo_subset_Icc_self hz.1)
  calc (r : ℝ≥0∞) ≤ ENNReal.ofReal (r + 1) := by
        rw [← ENNReal.ofReal_coe_nnreal]
        exact ENNReal.ofReal_le_ofReal (by linarith)
    _ = ENNReal.ofReal (n[k] - 2) * ENNReal.ofReal ε⁻¹ := by
        rw [← ENNReal.ofReal_mul hlen.le, inv_div, mul_div_cancel₀ _ hlen.ne']
    _ = volume {z : ℍ | z.re ∈ cycleFreeInterval n k ∧ ε < z.im} := by
        rw [UpperHalfPlane.volume_setOf_re_mem_and_lt_im _ hε, volume_cycleFreeInterval hk]
    _ ≤ volume (cyclePolygon n) := measure_mono hsub

end TauCeti.ModularGroup
