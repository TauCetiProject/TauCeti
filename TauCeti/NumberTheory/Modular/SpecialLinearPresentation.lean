/-!
# The amalgam presentation and the abelianization of `SL(2, ℤ)`

The integral modular group is generated by `S = (0 -1; 1 0)` and `R = S T = (0 -1; 1 1)`,
subject to `S⁴ = 1` and `S² = R³`: both sides of the second relation are the central element
`-1`. This is the presentation of the amalgamated free product `ℤ/4 ∗_{ℤ/2} ℤ/6`, and it is a
presentation of `SL(2, ℤ)`:

`SL(2, ℤ) ≅ ⟨s, r | s⁴, s² r⁻³⟩`.

Comparing universal properties, `SL(2, ℤ)` is then the pushout of `ℤ/4 ← ℤ/2 → ℤ/6` along
`1 ↦ 2` and `1 ↦ 3`, the amalgamated free product `Monoid.PushoutI` of Mathlib.

The proof lifts the presentation `PSL(2, ℤ) ≅ Δ(3, 2, ∞)` of
`TauCeti.ModularGroup.modularEquiv` through the central extension
`1 → {±1} → SL(2, ℤ) → PSL(2, ℤ) → 1`. In the presented group the element `s²` is central and
`s⁴ = 1`, and the triangle presentation gives an inverse of the projection to `PSL(2, ℤ)` modulo
`⟨s²⟩`. So an element of the kernel lies in `{1, s²}`, and `s²` maps to `-1 ≠ 1`.

In an abelian quotient the relations say that the class of `S` is `T⁻³` and that the class of
`T` has order dividing `12`; conversely `s ↦ 9`, `r ↦ 10` respects the relations in `ℤ/12`.
Hence the abelianization of `SL(2, ℤ)` is cyclic of order `12`, generated by the class of
`T = (1 1; 0 1)`, and `-1` has class `6`. Unlike in `PSL(2, ℤ)`, whose abelianization is `ℤ/6`
(`TauCeti.ModularGroup.abelianizationMulEquiv`), the sign `-1` is not a product of commutators.

Every conjugate of `T` has class `1`. Identifying the mapping class group of the torus with
`SL(2, ℤ)` through its action on `H₁(T², ℤ) = ℤ²` with an ordered basis `a · b = 1`, `T` is the
positive Dehn twist along `a`, and `B = S T S⁻¹ = (1 0; -1 1)` the positive Dehn twist along
`b`. A positive factorization of the identity, a list of conjugates of `T` with product `1`,
therefore has length divisible by `12`; conversely `(T B)⁶ = 1` gives one of every length `12 k`.

## Main declarations

* `TauCeti.ModularGroup.slRelators`: the relators `s⁴` and `s² r⁻³`.
* `TauCeti.ModularGroup.slPresentation`: the presentation
  `PresentedGroup slRelators ≃* SL(2, ℤ)`, sending `s` and `r` to `S` and `R`.
* `TauCeti.ModularGroup.slLift`: its universal property, the homomorphism `SL(2, ℤ) →* G`
  sending `S` and `R` to `a` and `b` with `a⁴ = 1` and `a² = b³`.
* `TauCeti.ModularGroup.slAmalgamEquiv`: the amalgamated free product
  `Monoid.PushoutI slAmalgamEmbedding = ℤ/4 ∗_{ℤ/2} ℤ/6` is isomorphic to `SL(2, ℤ)`, with the
  generators of `ℤ/4`, `ℤ/6` and `ℤ/2` sent to `S`, `R` and `-1`.
* `TauCeti.ModularGroup.slAbelianizationMulEquiv`: the abelianization of `SL(2, ℤ)` is
  `Multiplicative (ZMod 12)`, with the class of `T` sent to `1`.
* `TauCeti.ModularGroup.slAbelianizationMulEquiv_of_isConj_T`: every conjugate of `T` has
  class `1`.
* `TauCeti.ModularGroup.exists_list_isConj_T_prod_eq_one_iff`: a list of `n` conjugates of `T`
  with product `1` exists exactly when `12 ∣ n`.

## References

* J.-P. Serre, *Trees*, Springer, 1980, Chapter I, §4.2 (`SL(2, ℤ) = ℤ/4 ∗_{ℤ/2} ℤ/6`).
* R. E. Gompf, A. I. Stipsicz, *4-Manifolds and Kirby Calculus*, Graduate Studies in
  Mathematics 20, American Mathematical Society, 1999, §8.2 (Dehn twists, monodromy of
  Lefschetz fibrations and the relation `(a b)⁶ = 1`).
-/

public section

open scoped MatrixGroups
open ModularGroup

namespace TauCeti.ModularGroup

/-- The relators of the presentation `⟨s, r | s⁴, s² r⁻³⟩` of `SL(2, ℤ)`, in `FreeGroup (Fin 2)`
with `s = of 0` and `r = of 1`. -/
def slRelators : Set (FreeGroup (Fin 2)) :=
  {FreeGroup.of 0 ^ 4, FreeGroup.of 0 ^ 2 * (FreeGroup.of 1 ^ 3)⁻¹}

/-- The relators of `⟨s, r | s⁴, s² r⁻³⟩` are exactly `s⁴` and `s² r⁻³`. -/
theorem mem_slRelators_iff {r : FreeGroup (Fin 2)} :
    r ∈ slRelators ↔ r = FreeGroup.of 0 ^ 4 ∨ r = FreeGroup.of 0 ^ 2 * (FreeGroup.of 1 ^ 3)⁻¹ :=
  Iff.rfl

/-- The first generator of the presented group satisfies `s⁴ = 1`. -/
private theorem of_zero_pow_four : (PresentedGroup.of 0 : PresentedGroup slRelators) ^ 4 = 1 := by
  rw [PresentedGroup.of, ← map_pow]
  exact PresentedGroup.one_of_mem (mem_slRelators_iff.2 (Or.inl rfl))

/-- The generators of the presented group satisfy `s² = r³`. -/
private theorem of_zero_sq : (PresentedGroup.of 0 : PresentedGroup slRelators) ^ 2 =
    PresentedGroup.of 1 ^ 3 := by
  rw [PresentedGroup.of, PresentedGroup.of, ← map_pow, ← map_pow]
  exact PresentedGroup.mk_eq_mk_of_mul_inv_mem (mem_slRelators_iff.2 (Or.inr rfl))

/-- The element `s²` of the presented group is central. -/
private theorem of_zero_sq_mem_center :
    (PresentedGroup.of 0 : PresentedGroup slRelators) ^ 2 ∈ Subgroup.center _ := by
  rw [← Subgroup.centralizer_univ, ← Subgroup.coe_top, ← PresentedGroup.closure_range_of,
    Subgroup.centralizer_closure, Subgroup.mem_centralizer_iff]
  rintro _ ⟨j, rfl⟩
  fin_cases j
  · exact Commute.self_pow _ 2
  · rw [of_zero_sq]
    exact Commute.self_pow _ 3

/-- The subgroup `⟨s²⟩` of the presented group. -/
private abbrev sqSubgroup : Subgroup (PresentedGroup slRelators) :=
  Subgroup.zpowers (PresentedGroup.of 0 ^ 2)

/-- The subgroup `⟨s²⟩` is normal, since `s²` is central. -/
private instance : sqSubgroup.Normal :=
  Subgroup.normal_of_le_center (Subgroup.zpowers_le.2 of_zero_sq_mem_center)

/-- The homomorphism from the presented group to `SL(2, ℤ)` sending `s` and `r` to `S` and
`R = S T`. -/
private def slPresentationHom : PresentedGroup slRelators →* SL(2, ℤ) :=
  PresentedGroup.toGroup (f := ![S, R]) <| by
    rintro _ (rfl | rfl) <;> simp [S_pow_four]

private theorem slPresentationHom_of_zero : slPresentationHom (PresentedGroup.of 0) = S :=
  PresentedGroup.toGroup.of _

private theorem slPresentationHom_of_one : slPresentationHom (PresentedGroup.of 1) = R :=
  PresentedGroup.toGroup.of _

/-- The cube of `s r⁻¹ s⁻¹` is `s⁻²`, which lies in `⟨s²⟩`. -/
private theorem of_zero_mul_of_one_inv_mul_of_zero_inv_pow_three_mem :
    (PresentedGroup.of 0 * (PresentedGroup.of 1)⁻¹ * (PresentedGroup.of 0)⁻¹ :
      PresentedGroup slRelators) ^ 3 ∈ sqSubgroup := by
  rw [conj_pow, inv_pow, ← of_zero_sq,
    show ∀ s : PresentedGroup slRelators, s * (s ^ 2)⁻¹ * s⁻¹ = (s ^ 2)⁻¹ from fun s ↦ by group]
  exact inv_mem (Subgroup.mem_zpowers _)

/-- The product relation `T S U = 1` holds for `s⁻¹ r`, `s` and `s r⁻¹ s⁻¹`, since `s²` is
central. -/
private theorem of_zero_inv_mul_of_one_mul_of_zero_mul_eq_one :
    (PresentedGroup.of 0)⁻¹ * PresentedGroup.of 1 * PresentedGroup.of 0 *
      (PresentedGroup.of 0 * (PresentedGroup.of 1)⁻¹ * (PresentedGroup.of 0)⁻¹ :
        PresentedGroup slRelators) = 1 := by
  set s : PresentedGroup slRelators := PresentedGroup.of 0
  set r : PresentedGroup slRelators := PresentedGroup.of 1
  have hc : r * s ^ 2 = s ^ 2 * r := Subgroup.mem_center_iff.1 of_zero_sq_mem_center r
  calc s⁻¹ * r * s * (s * r⁻¹ * s⁻¹) = s⁻¹ * (r * s ^ 2) * r⁻¹ * s⁻¹ := by
        simp only [pow_two, mul_assoc]
    _ = 1 := by rw [hc]; group

/-- The homomorphism from `PSL(2, ℤ)` to the presented group modulo `⟨s²⟩`, sending `S` and `T`
to the classes of `s` and `s⁻¹ r`. It is read off the triangle presentation `Δ(3, 2, ∞)`, whose
generators `x`, `y`, `z` map to `U = S T⁻¹`, `S` and `T`; the class of `U` is that of
`s r⁻¹ s⁻¹`. -/
private noncomputable def pslToQuotient : PSL(2, ℤ) →* PresentedGroup slRelators ⧸ sqSubgroup :=
  (TriangleGroup.lift
    ((PresentedGroup.of 0 * (PresentedGroup.of 1)⁻¹ * (PresentedGroup.of 0)⁻¹ :
      PresentedGroup slRelators) : PresentedGroup slRelators ⧸ sqSubgroup)
    ((PresentedGroup.of 0 : PresentedGroup slRelators) : PresentedGroup slRelators ⧸ sqSubgroup)
    (((PresentedGroup.of 0)⁻¹ * PresentedGroup.of 1 : PresentedGroup slRelators) :
      PresentedGroup slRelators ⧸ sqSubgroup)
    (by
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
      exact of_zero_mul_of_one_inv_mul_of_zero_inv_pow_three_mem)
    (by
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
      exact Subgroup.mem_zpowers _)
    (pow_zero _)
    (by
      rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul,
        of_zero_inv_mul_of_one_mul_of_zero_mul_eq_one, QuotientGroup.mk_one])).comp
    modularEquiv.symm.toMonoidHom

/-- Modulo `⟨s²⟩`, the presented group maps back to itself through `SL(2, ℤ)` and
`PSL(2, ℤ)`. -/
private theorem pslToQuotient_comp_slPresentationHom :
    (pslToQuotient.comp (QuotientGroup.mk' _)).comp slPresentationHom =
      QuotientGroup.mk' sqSubgroup := by
  refine PresentedGroup.ext fun j ↦ ?_
  fin_cases j
  · simp [pslToQuotient, slPresentationHom_of_zero]
  · simp [pslToQuotient, slPresentationHom_of_one, R_def]

/-- The kernel of `s ↦ S`, `r ↦ R` is trivial: it lies in `⟨s²⟩ = {1, s²}`, and `s²` maps to
`-1`. -/
private theorem slPresentationHom_injective : Function.Injective slPresentationHom := by
  refine (injective_iff_map_eq_one _).2 fun w hw ↦ ?_
  have hmem : w ∈ sqSubgroup := by
    rw [← QuotientGroup.eq_one_iff, ← QuotientGroup.mk'_apply,
      ← pslToQuotient_comp_slPresentationHom, MonoidHom.comp_apply, hw, map_one]
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hmem
  rw [map_zpow, map_pow, slPresentationHom_of_zero, S_sq] at hw
  obtain ⟨m, rfl | rfl⟩ := Int.even_or_odd' k
  · simp [zpow_mul, ← pow_mul, of_zero_pow_four]
  · rw [zpow_add_one, zpow_mul, show (-1 : SL(2, ℤ)) ^ (2 : ℤ) = 1 by decide, one_zpow,
      one_mul] at hw
    exact absurd hw (by decide)

/-- The homomorphism `s ↦ S`, `r ↦ R` is surjective, since `S` and `T = S⁻¹ R` generate
`SL(2, ℤ)`. -/
private theorem slPresentationHom_surjective : Function.Surjective slPresentationHom := by
  rw [← MonoidHom.range_eq_top, eq_top_iff, ← SpecialLinearGroup.SL2Z_generators,
    Subgroup.closure_le]
  rintro _ (rfl | rfl)
  · exact ⟨_, slPresentationHom_of_zero⟩
  · refine ⟨(PresentedGroup.of 0)⁻¹ * PresentedGroup.of 1, ?_⟩
    rw [map_mul, map_inv, slPresentationHom_of_zero, slPresentationHom_of_one, S_inv_mul_R]

/-- **A presentation of the modular group.** `SL(2, ℤ)` is the group `⟨s, r | s⁴, s² r⁻³⟩`, with
`s` and `r` sent to `S` and `R = S T`. These are the relations of the amalgam
`ℤ/4 ∗_{ℤ/2} ℤ/6`; the amalgamated free product itself is identified with `SL(2, ℤ)` by
`TauCeti.ModularGroup.slAmalgamEquiv`. -/
noncomputable def slPresentation : PresentedGroup slRelators ≃* SL(2, ℤ) :=
  MulEquiv.ofBijective slPresentationHom
    ⟨slPresentationHom_injective, slPresentationHom_surjective⟩

/-- The presentation `PresentedGroup slRelators ≃* SL(2, ℤ)` sends `s` to `S`. -/
@[simp]
theorem slPresentation_of_zero : slPresentation (PresentedGroup.of 0) = S :=
  slPresentationHom_of_zero

/-- The presentation `PresentedGroup slRelators ≃* SL(2, ℤ)` sends `r` to `R = S T`. -/
@[simp]
theorem slPresentation_of_one : slPresentation (PresentedGroup.of 1) = R :=
  slPresentationHom_of_one

/-- The inverse of the presentation sends `S` to `s`. -/
@[simp]
theorem slPresentation_symm_S : slPresentation.symm S = PresentedGroup.of 0 :=
  (MulEquiv.symm_apply_eq _).2 slPresentation_of_zero.symm

/-- The inverse of the presentation sends `R = S T` to `r`. -/
@[simp]
theorem slPresentation_symm_R : slPresentation.symm R = PresentedGroup.of 1 :=
  (MulEquiv.symm_apply_eq _).2 slPresentation_of_one.symm

section Lift

variable {G : Type*} [Group G]

/-- **The universal property of the amalgam presentation.** Elements `a` and `b` of a group with
`a⁴ = 1` and `a² = b³` define a homomorphism from `SL(2, ℤ)` sending `S` and `R = S T` to `a`
and `b`. -/
noncomputable def slLift (a b : G) (h4 : a ^ 4 = 1) (h : a ^ 2 = b ^ 3) : SL(2, ℤ) →* G :=
  (PresentedGroup.toGroup (f := ![a, b]) <| by
    rintro _ (rfl | rfl) <;> simp [h4, h]).comp slPresentation.symm.toMonoidHom

variable (a b : G) (h4 : a ^ 4 = 1) (h : a ^ 2 = b ^ 3)

/-- The homomorphism `slLift a b h4 h` sends `S` to `a`. -/
@[simp]
theorem slLift_S : slLift a b h4 h S = a := by
  simp [slLift]

/-- The homomorphism `slLift a b h4 h` sends `R = S T` to `b`. -/
@[simp]
theorem slLift_R : slLift a b h4 h R = b := by
  simp [slLift]

end Lift

/-! ### The amalgamated free product `ℤ/4 ∗_{ℤ/2} ℤ/6` -/

/-- The orders `4` and `6` of the two cyclic factors of the amalgam `ℤ/4 ∗_{ℤ/2} ℤ/6`. -/
def slAmalgamOrder : Fin 2 → ℕ := ![4, 6]

/-- The orders `4` and `6` of the factors of the amalgam are nonzero. -/
instance (i : Fin 2) : NeZero (slAmalgamOrder i) :=
  ⟨by fin_cases i <;> decide⟩

/-- The factors `ℤ/4` (for `i = 0`) and `ℤ/6` (for `i = 1`) of the amalgam
`ℤ/4 ∗_{ℤ/2} ℤ/6`, written multiplicatively. -/
abbrev slAmalgamFactor (i : Fin 2) : Type := Multiplicative (ZMod (slAmalgamOrder i))

/-- The embeddings of `ℤ/2` into `ℤ/4` and `ℤ/6` along which `SL(2, ℤ)` is amalgamated:
multiplication by `2` and by `3` (`ZMod.mulCastHom`), so that the generator `1` goes to
`2 ∈ ℤ/4` and to `3 ∈ ℤ/6`. -/
def slAmalgamEmbedding (i : Fin 2) : Multiplicative (ZMod 2) →* slAmalgamFactor i :=
  (ZMod.mulCastHom (![2, 3] i) (by fin_cases i <;> decide)).toMultiplicative

/-- The embedding `slAmalgamEmbedding i` sends the generator of `ℤ/2` to the square of the
generator of `ℤ/4` (for `i = 0`) or the cube of the generator of `ℤ/6` (for `i = 1`). -/
theorem slAmalgamEmbedding_ofAdd_one (i : Fin 2) :
    slAmalgamEmbedding i (Multiplicative.ofAdd 1) = Multiplicative.ofAdd 1 ^ ![2, 3] i := by
  rw [slAmalgamEmbedding, AddMonoidHom.coe_toMultiplicative, Function.comp_apply,
    Function.comp_apply, toAdd_ofAdd, ← Int.cast_one, ZMod.mulCastHom_intCast, Int.cast_one,
    one_mul, ← ofAdd_nsmul, nsmul_one]

/-- The embedding of `ℤ/2` into `ℤ/4` sends the generator to the square of the generator. -/
@[simp]
theorem slAmalgamEmbedding_zero_ofAdd_one :
    slAmalgamEmbedding 0 (Multiplicative.ofAdd 1) = Multiplicative.ofAdd 1 ^ 2 :=
  slAmalgamEmbedding_ofAdd_one 0

/-- The embedding of `ℤ/2` into `ℤ/6` sends the generator to the cube of the generator. -/
@[simp]
theorem slAmalgamEmbedding_one_ofAdd_one :
    slAmalgamEmbedding 1 (Multiplicative.ofAdd 1) = Multiplicative.ofAdd 1 ^ 3 :=
  slAmalgamEmbedding_ofAdd_one 1

/-- The generator `1` of the factor `ℤ/4` or `ℤ/6` in the amalgam. -/
private def amalgamGen (i : Fin 2) : Monoid.PushoutI slAmalgamEmbedding :=
  Monoid.PushoutI.of (φ := slAmalgamEmbedding) i (Multiplicative.ofAdd 1)

/-- The squared generator of `ℤ/4` and the cubed generator of `ℤ/6` are both the image of the
generator of `ℤ/2`. -/
private theorem amalgamGen_pow (i : Fin 2) :
    amalgamGen i ^ ![2, 3] i = Monoid.PushoutI.base _ (Multiplicative.ofAdd 1) := by
  rw [amalgamGen, ← map_pow, ← slAmalgamEmbedding_ofAdd_one, Monoid.PushoutI.of_apply_eq_base]

/-- The homomorphism from the amalgam to `SL(2, ℤ)` sending the generators to `S` and `R`; the
homomorphisms out of the cyclic factors are given by `TauCeti.zmodMonoidHomEquiv`. -/
private noncomputable def amalgamToSL : Monoid.PushoutI slAmalgamEmbedding →* SL(2, ℤ) :=
  Monoid.PushoutI.lift
    (fun i ↦ (zmodMonoidHomEquiv _ _).symm
      ⟨![S, R] i, by fin_cases i; exacts [S_pow_four, R_pow_six]⟩)
    ((zmodMonoidHomEquiv 2 _).symm ⟨-1, by decide⟩) fun i ↦
      (zmodMonoidHomEquiv 2 _).injective <| Subtype.ext <| by
        rw [coe_zmodMonoidHomEquiv_apply, coe_zmodMonoidHomEquiv_apply, MonoidHom.comp_apply,
          slAmalgamEmbedding_ofAdd_one, map_pow, zmodMonoidHomEquiv_symm_apply_ofAdd_one,
          zmodMonoidHomEquiv_symm_apply_ofAdd_one]
        fin_cases i
        exacts [S_sq, R_pow_three]

private theorem amalgamToSL_of_ofAdd_one (i : Fin 2) :
    amalgamToSL (Monoid.PushoutI.of i (Multiplicative.ofAdd 1)) = ![S, R] i := by
  rw [amalgamToSL, Monoid.PushoutI.lift_of, zmodMonoidHomEquiv_symm_apply_ofAdd_one]

/-- The homomorphism from `SL(2, ℤ)` to the amalgam sending `S` and `R` to the generators. -/
private noncomputable def slToAmalgam : SL(2, ℤ) →* Monoid.PushoutI slAmalgamEmbedding :=
  slLift (amalgamGen 0) (amalgamGen 1)
    (by rw [amalgamGen, ← map_pow,
      (by decide : Multiplicative.ofAdd (1 : ZMod (slAmalgamOrder 0)) ^ 4 = 1), map_one])
    ((amalgamGen_pow 0).trans (amalgamGen_pow 1).symm)

/-- **`SL(2, ℤ)` is the amalgamated free product `ℤ/4 ∗_{ℤ/2} ℤ/6`.** The pushout of
`ℤ/4 ← ℤ/2 → ℤ/6`, along `1 ↦ 2` and `1 ↦ 3`, is isomorphic to `SL(2, ℤ)`, with the generators
of `ℤ/4` and `ℤ/6` sent to `S` and `R = S T`, and the generator of `ℤ/2` to `-1`. -/
noncomputable def slAmalgamEquiv : Monoid.PushoutI slAmalgamEmbedding ≃* SL(2, ℤ) :=
  MonoidHom.toMulEquiv amalgamToSL slToAmalgam
    (Monoid.PushoutI.hom_ext_nonempty fun i ↦
      (zmodMonoidHomEquiv _ _).injective <| Subtype.ext <| by
        rw [coe_zmodMonoidHomEquiv_apply, coe_zmodMonoidHomEquiv_apply]
        simp only [MonoidHom.comp_apply, MonoidHom.id_apply]
        rw [amalgamToSL_of_ofAdd_one]
        fin_cases i
        exacts [slLift_S .., slLift_R ..])
    ((MonoidHom.cancel_right slPresentation.surjective).1 <|
      PresentedGroup.ext <| Fin.forall_fin_two.2 ⟨by
        simp only [MonoidHom.comp_apply, MonoidHom.id_apply, slPresentationHom_of_zero]
        exact (congrArg amalgamToSL (slLift_S ..)).trans (amalgamToSL_of_ofAdd_one 0), by
        simp only [MonoidHom.comp_apply, MonoidHom.id_apply, slPresentationHom_of_one]
        exact (congrArg amalgamToSL (slLift_R ..)).trans (amalgamToSL_of_ofAdd_one 1)⟩)

/-- The isomorphism `ℤ/4 ∗_{ℤ/2} ℤ/6 ≃* SL(2, ℤ)` sends the generator of `ℤ/4` to `S`. -/
@[simp]
theorem slAmalgamEquiv_of_zero :
    slAmalgamEquiv (Monoid.PushoutI.of (φ := slAmalgamEmbedding) 0 (Multiplicative.ofAdd 1)) =
      S :=
  amalgamToSL_of_ofAdd_one 0

/-- The isomorphism `ℤ/4 ∗_{ℤ/2} ℤ/6 ≃* SL(2, ℤ)` sends the generator of `ℤ/6` to `R = S T`. -/
@[simp]
theorem slAmalgamEquiv_of_one :
    slAmalgamEquiv (Monoid.PushoutI.of (φ := slAmalgamEmbedding) 1 (Multiplicative.ofAdd 1)) =
      R :=
  amalgamToSL_of_ofAdd_one 1

/-- The isomorphism `ℤ/4 ∗_{ℤ/2} ℤ/6 ≃* SL(2, ℤ)` sends the generator of `ℤ/2` to `-1`. -/
@[simp]
theorem slAmalgamEquiv_base :
    slAmalgamEquiv (Monoid.PushoutI.base slAmalgamEmbedding (Multiplicative.ofAdd 1)) =
      -1 := by
  rw [← amalgamGen_pow 0, map_pow]
  exact (congrArg (· ^ 2) (amalgamToSL_of_ofAdd_one 0)).trans S_sq

/-! ### The abelianization -/

/-- The character of `SL(2, ℤ)` with values in `ℤ/12` sending `S` and `R` to `9` and `10`, read
off the presentation. -/
private noncomputable def zmodTwelveChar : SL(2, ℤ) →* Multiplicative (ZMod 12) :=
  slLift (Multiplicative.ofAdd 9) (Multiplicative.ofAdd 10) (by decide) (by decide)

private theorem zmodTwelveChar_S : zmodTwelveChar S = Multiplicative.ofAdd 9 :=
  slLift_S ..

private theorem zmodTwelveChar_T : zmodTwelveChar T = Multiplicative.ofAdd 1 := by
  rw [← S_inv_mul_R, map_mul, map_inv, zmodTwelveChar_S, zmodTwelveChar, slLift_R]
  decide

/-- In the abelianization the class of `S` is the inverse cube of the class of `T`: from
`R = S T` and `R³ = -1 = S²`. -/
private theorem of_S_eq_of_T_pow_three_inv :
    Group.Abelianization.of S = (Group.Abelianization.of T ^ 3)⁻¹ := by
  have h : Group.Abelianization.of (R ^ 3) = Group.Abelianization.of (S ^ 2) := by
    rw [R_pow_three, S_sq]
  rw [map_pow, map_pow, R_def, map_mul, mul_pow] at h
  rw [eq_inv_iff_mul_eq_one]
  apply mul_left_cancel (a := Group.Abelianization.of S ^ 2)
  rw [mul_one, ← mul_assoc, ← pow_succ, h]

/-- In the abelianization the class of `T` has order dividing `12`. -/
private theorem of_T_pow_twelve : Group.Abelianization.of T ^ 12 = 1 := by
  have h : Group.Abelianization.of S ^ 4 = 1 := by rw [← map_pow, S_pow_four, map_one]
  rwa [of_S_eq_of_T_pow_three_inv, inv_pow, inv_eq_one, ← pow_mul] at h

/-- Every element of the abelianization of `SL(2, ℤ)` is a power of the class of `T`. -/
private theorem exists_eq_of_T_zpow (x : Group.Abelianization SL(2, ℤ)) :
    ∃ k : ℤ, x = Group.Abelianization.of T ^ k := by
  obtain ⟨g, rfl⟩ := Group.Abelianization.surjective_of SL(2, ℤ) x
  have h : Subgroup.closure {S, T} ≤
      (Subgroup.zpowers (Group.Abelianization.of T)).comap Group.Abelianization.of := by
    rw [Subgroup.closure_le]
    rintro _ (rfl | rfl)
    · exact ⟨-3, by simp only [of_S_eq_of_T_pow_three_inv, zpow_neg, zpow_ofNat]⟩
    · exact Subgroup.mem_zpowers _
  obtain ⟨k, hk⟩ := h (SpecialLinearGroup.SL2Z_generators ▸ Subgroup.mem_top g)
  exact ⟨k, hk.symm⟩

private theorem abelianization_lift_zmodTwelveChar_bijective :
    Function.Bijective (Group.Abelianization.lift zmodTwelveChar) := by
  constructor
  · refine (injective_iff_map_eq_one _).2 fun x hx ↦ ?_
    obtain ⟨k, rfl⟩ := exists_eq_of_T_zpow x
    simp only [map_zpow, Group.Abelianization.lift_apply_of, zmodTwelveChar_T, ← ofAdd_zsmul,
      zsmul_one, ofAdd_eq_one, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
    obtain ⟨m, rfl⟩ := hx
    rw [zpow_mul, zpow_natCast, of_T_pow_twelve, one_zpow]
  · intro y
    refine ⟨Group.Abelianization.of T ^ (Multiplicative.toAdd y).val, ?_⟩
    rw [map_pow, Group.Abelianization.lift_apply_of, zmodTwelveChar_T, ← ofAdd_nsmul, nsmul_one,
      ZMod.natCast_zmod_val, ofAdd_toAdd]

/-- **The abelianization of `SL(2, ℤ)` is cyclic of order twelve**, generated by the class of
the translation `T`: `SL(2, ℤ)ᵃᵇ ≅ ℤ/12`. The classes of `S`, `R = S T` and `-1` go to `9`, `10`
and `6`. -/
noncomputable def slAbelianizationMulEquiv :
    Group.Abelianization SL(2, ℤ) ≃* Multiplicative (ZMod 12) :=
  MulEquiv.ofBijective _ abelianization_lift_zmodTwelveChar_bijective

/-- The abelianization of `SL(2, ℤ)` sends the class of `T` to `1 ∈ ℤ/12`. -/
@[simp]
theorem slAbelianizationMulEquiv_of_T :
    slAbelianizationMulEquiv (Group.Abelianization.of T) = Multiplicative.ofAdd 1 :=
  (Group.Abelianization.lift_apply_of _ _).trans zmodTwelveChar_T

/-- The abelianization of `SL(2, ℤ)` sends the class of `S` to `9 ∈ ℤ/12`. -/
@[simp]
theorem slAbelianizationMulEquiv_of_S :
    slAbelianizationMulEquiv (Group.Abelianization.of S) = Multiplicative.ofAdd 9 :=
  (Group.Abelianization.lift_apply_of _ _).trans zmodTwelveChar_S

/-- The abelianization of `SL(2, ℤ)` sends the class of `R = S T` to `10 ∈ ℤ/12`. -/
@[simp]
theorem slAbelianizationMulEquiv_of_R :
    slAbelianizationMulEquiv (Group.Abelianization.of R) = Multiplicative.ofAdd 10 := by
  rw [R_def, map_mul, map_mul, slAbelianizationMulEquiv_of_S, slAbelianizationMulEquiv_of_T,
    ← ofAdd_add]
  decide

/-- The abelianization of `SL(2, ℤ)` sends the class of `-1` to `6 ∈ ℤ/12`: the central sign is
not a product of commutators. -/
@[simp]
theorem slAbelianizationMulEquiv_of_neg_one :
    slAbelianizationMulEquiv (Group.Abelianization.of (-1 : SL(2, ℤ))) =
      Multiplicative.ofAdd 6 := by
  rw [← S_sq, map_pow, map_pow, slAbelianizationMulEquiv_of_S, ← ofAdd_nsmul]
  decide

/-- Every conjugate of `T` has class `1 ∈ ℤ/12` in the abelianization of `SL(2, ℤ)`. -/
theorem slAbelianizationMulEquiv_of_isConj_T {g : SL(2, ℤ)} (h : IsConj T g) :
    slAbelianizationMulEquiv (Group.Abelianization.of g) = Multiplicative.ofAdd 1 := by
  rw [← isConj_iff_eq.1 (Group.Abelianization.of.map_isConj h), slAbelianizationMulEquiv_of_T]

/-! ### Positive factorizations of the identity -/

/-- `(T B)⁶ = 1` for `B = S T S⁻¹ = (1 0; -1 1)`: the product `T B = (0 1; -1 1)` has
order six. -/
theorem T_mul_S_mul_T_mul_S_inv_pow_six : (T * (S * T * S⁻¹)) ^ 6 = (1 : SL(2, ℤ)) := by
  -- With `T = S⁻¹ R` and `S³ = S⁻¹`, the product `T B = S⁻¹ R² S⁻¹` is the conjugate
  -- `S⁻¹ R⁵ S` of `R² S² = R⁵`, whose sixth power is `(R⁶)⁵ = 1`.
  have hS : S ^ 3 = S⁻¹ := eq_inv_of_mul_eq_one_left (by rw [← pow_succ, S_pow_four])
  have h : T * (S * T * S⁻¹) = S⁻¹ * R ^ 5 * S⁻¹⁻¹ :=
    calc T * (S * T * S⁻¹) = S⁻¹ * R ^ 2 * S⁻¹ := by rw [← S_inv_mul_R, sq]; group
      _ = S⁻¹ * R ^ 2 * S ^ 3 := by rw [hS]
      _ = S⁻¹ * (R ^ 2 * R ^ 3) * S⁻¹⁻¹ := by rw [R_pow_three, ← S_sq]; group
      _ = S⁻¹ * R ^ 5 * S⁻¹⁻¹ := by rw [← pow_add]
  rw [h, conj_pow, ← pow_mul, pow_mul', R_pow_six, one_pow]
  group

/-- **Positive factorizations of the identity in `SL(2, ℤ)`.** A list of `n` conjugates of `T`
with product `1` exists if and only if `12 ∣ n`. Each such element has class `1` in
`SL(2, ℤ)ᵃᵇ ≅ ℤ/12`, and the word `(T B)⁶` with `B = S T S⁻¹` realizes the length `12`. -/
theorem exists_list_isConj_T_prod_eq_one_iff (n : ℕ) :
    (∃ l : List SL(2, ℤ), l.length = n ∧ (∀ g ∈ l, IsConj T g) ∧ l.prod = 1) ↔ 12 ∣ n := by
  constructor
  · rintro ⟨l, rfl, hl, hprod⟩
    let χ := slAbelianizationMulEquiv.toMonoidHom.comp Group.Abelianization.of
    have hχ : l.map χ = List.replicate l.length (Multiplicative.ofAdd 1) :=
      List.map_eq_replicate_iff.2 fun g hg ↦ slAbelianizationMulEquiv_of_isConj_T (hl g hg)
    have h : χ l.prod = 1 := by rw [hprod, map_one]
    rw [map_list_prod, hχ, List.prod_replicate, ← ofAdd_nsmul, nsmul_one,
      ofAdd_eq_one, ZMod.natCast_eq_zero_iff] at h
    exact h
  · rintro ⟨k, rfl⟩
    refine ⟨(List.replicate (6 * k) [T, S * T * S⁻¹]).flatten, ?_, ?_, ?_⟩
    · simp
      omega
    · simp only [List.mem_flatten, List.mem_replicate]
      rintro g ⟨_, ⟨-, rfl⟩, hg⟩
      rcases List.mem_pair.1 hg with rfl | rfl
      · exact IsConj.refl _
      · exact isConj_iff.2 ⟨S, rfl⟩
    · rw [List.prod_flatten, List.map_replicate, List.prod_replicate, List.prod_pair, pow_mul,
        T_mul_S_mul_T_mul_S_inv_pow_six, one_pow]

end TauCeti.ModularGroup
