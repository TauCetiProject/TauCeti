module

public import TauCeti.NumberTheory.DiophantineApproximation.Subspace.ApproximationDomain

/-!
# Spans of approximation domains at bounded levels

The span `TauCeti.NumberField.approxSpan S₀ L c Q` is the vector space generated by the points
of an approximation domain. Its finite-subset membership characterization is
`TauCeti.NumberField.mem_approxSpan_iff`, and its universal property is
`TauCeti.NumberField.approxSpan_le_iff`.

For independent forms, `TauCeti.NumberField.finite_image_approxSpan` shows that only finitely
many spans occur over `Q ∈ [Q₁, Q₂]` when `Q₁ > 0`. It uses the domain finiteness results from
`TauCeti.NumberTheory.DiophantineApproximation.Subspace.ApproximationDomain`:
`TauCeti.NumberField.finite_approxDomain` gives finiteness at a single level `0 ≤ Q`, and
`TauCeti.NumberField.finite_biUnion_approxDomain` gives finiteness over the interval, using
`TauCeti.NumberField.approxDomain_subset_abs` to compare with one fixed domain.
This separates bounded levels from the asymptotic study of exceptional subspaces in the
Subspace Theorem. The final example checks that coordinate forms give the full span at level
one for every exponent system, so properness cannot hold uniformly at all levels.

## References

* E. Bombieri and W. Gubler, *Heights in Diophantine Geometry* (2006), §7.5, in particular
  Definition 7.5.11 and Lemma 7.5.12.
-/

public section

open NumberField Module Set

namespace TauCeti.NumberField

variable {K : Type*} [Field K] [NumberField K] {ι : Type*}

/-- The vector space generated by the points of an approximation domain. -/
noncomputable def approxSpan (S₀ : Finset (FinitePlace K))
    (L : AbsoluteValue K ℝ → ι → Dual K (ι → K)) (c : AbsoluteValue K ℝ → ι → ℝ) (Q : ℝ) :
    Submodule K (ι → K) :=
  Submodule.span K (approxDomain S₀ L c Q)

/-- The span of an approximation domain, expressed as a submodule span. -/
theorem approxSpan_eq_span (S₀ : Finset (FinitePlace K))
    (L : AbsoluteValue K ℝ → ι → Dual K (ι → K)) (c : AbsoluteValue K ℝ → ι → ℝ) (Q : ℝ) :
    approxSpan S₀ L c Q = Submodule.span K (approxDomain S₀ L c Q) := (rfl)

/-- Membership in the span is membership in the span of some finite subset of the domain. -/
theorem mem_approxSpan_iff {S₀ : Finset (FinitePlace K)}
    {L : AbsoluteValue K ℝ → ι → Dual K (ι → K)} {c : AbsoluteValue K ℝ → ι → ℝ} {Q : ℝ}
    {x : ι → K} :
    x ∈ approxSpan S₀ L c Q ↔ ∃ s : Finset (ι → K),
      (↑s : Set (ι → K)) ⊆ approxDomain S₀ L c Q ∧ x ∈ Submodule.span K (↑s : Set (ι → K)) := by
  rw [approxSpan_eq_span]
  exact ⟨Submodule.mem_span_finite_of_mem_span, fun ⟨s, hs, hx⟩ ↦ Submodule.span_mono hs hx⟩

/-- The span is contained in a subspace exactly when the domain is contained in it. -/
@[simp]
theorem approxSpan_le_iff {S₀ : Finset (FinitePlace K)}
    {L : AbsoluteValue K ℝ → ι → Dual K (ι → K)} {c : AbsoluteValue K ℝ → ι → ℝ} {Q : ℝ}
    {W : Submodule K (ι → K)} :
    approxSpan S₀ L c Q ≤ W ↔ approxDomain S₀ L c Q ⊆ W := by
  rw [approxSpan_eq_span, Submodule.span_le]

/-- Every point of an approximation domain belongs to its span. -/
theorem mem_approxSpan_of_mem {S₀ : Finset (FinitePlace K)}
    {L : AbsoluteValue K ℝ → ι → Dual K (ι → K)} {c : AbsoluteValue K ℝ → ι → ℝ} {Q : ℝ}
    {x : ι → K} (hx : x ∈ approxDomain S₀ L c Q) : x ∈ approxSpan S₀ L c Q :=
  (approxSpan_le_iff.mp le_rfl) hx

variable [Finite ι]

/-- Only finitely many vector spaces are generated by domains whose levels lie in an interval
bounded away from zero. -/
theorem finite_image_approxSpan {S₀ : Finset (FinitePlace K)}
    {L : AbsoluteValue K ℝ → ι → Dual K (ι → K)}
    (hLinf : ∀ v : InfinitePlace K, LinearIndependent K (L v.1))
    (hLfin : ∀ v ∈ S₀, LinearIndependent K (L v.1))
    (c : AbsoluteValue K ℝ → ι → ℝ) {Q₁ Q₂ : ℝ} (hQ₁ : 0 < Q₁) :
    (approxSpan S₀ L c '' Icc Q₁ Q₂).Finite := by
  have hfinite := finite_biUnion_approxDomain hLinf hLfin c (Q₂ := Q₂) hQ₁
  refine (hfinite.finite_subsets.image (Submodule.span K)).subset ?_
  rintro _ ⟨Q, hQ, rfl⟩
  refine ⟨approxDomain S₀ L c Q, ?_, (approxSpan_eq_span S₀ L c Q).symm⟩
  exact subset_iUnion₂_of_subset Q hQ Subset.rfl

/- At level one the coordinate forms give a full span, for every exponent system. Thus
properness of the span can only be an eventual assertion, even for negative exponents. -/
example (S₀ : Finset (FinitePlace K)) (c : AbsoluteValue K ℝ → ι → ℝ) :
    approxSpan S₀ (fun _ i ↦ LinearMap.proj i) c 1 = ⊤ := by
  classical
  let : Fintype ι := Fintype.ofFinite ι
  have hcoord (v : AbsoluteValue K ℝ) (j k : ι) : v (Pi.basisFun K ι j k) ≤ 1 := by
    by_cases h : j = k
    · subst k
      simp [Pi.basisFun_apply]
    · simp [Pi.basisFun_apply, h]
  apply top_unique
  rw [← (Pi.basisFun K ι).span_eq, Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  apply mem_approxSpan_of_mem
  refine mem_approxDomain.mpr ⟨?_, ?_, ?_⟩
  · intro v i
    simpa only [LinearMap.proj_apply, Real.one_rpow, InfinitePlace.coe_apply] using hcoord v.1 j i
  · intro v _ i
    simpa only [LinearMap.proj_apply, Real.one_rpow, FinitePlace.coe_apply] using hcoord v.1 j i
  · exact fun v _ k ↦ hcoord v.1 j k

end TauCeti.NumberField
