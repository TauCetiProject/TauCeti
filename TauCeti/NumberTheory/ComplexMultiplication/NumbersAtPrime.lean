/-!
# The numbers attached to a prime in `ℚ(√-d)`

Let `d` be a prime, `K = ℚ(√-d) ⊆ ℂ` with `√-d = i √d`, and `χ_K = (· / d)`, the Legendre symbol
`legendreSym d`. When `d ≡ 3 (mod 4)`, as for the primes `d ≡ 7 (mod 8)` of the applications,
quadratic reciprocity makes `χ_K` the splitting character of `K`: a prime `p` splits in `K` when
`(p / d) = 1`, is inert when `(p / d) = -1`, and ramifies when `p = d`. The Taylor coefficients of
the theta function of an elliptic curve with complex multiplication by the integers of `K`, and
its formal group, are studied at `p` through the following numbers.

* `piPrime d p = π_p`: `√-d` if `p = d` and `p` otherwise, an element of the integers of `K`.
* `piPrimeValuation d p = v(π_p)`: `1 / 2` if `p = d` and `1` otherwise, the valuation of `π_p`
  normalised by `v(p) = 1`.
* `primeNorm d p = q_p`: `p²` if `(p / d) = -1` and `p` otherwise; for `d ≡ 3 (mod 4)` and a prime
  `p`, the norm of a prime of `K` above `p`.
* `rhoPrime d p = ρ_p = v(π_p) / (q_p - 1)`, the valuation of the scale `ϖ` used to rescale the
  Lubin–Tate parameter `T` for `π_p` to `T(ϖz)/ϖ`, where `T` is the part of the formal parameter
  of the curve in degrees `1 mod (q_p - 1)`.
* `gammaPrime d p = γ_p = 1 / (p - 1) - ρ_p`, the leading per-derivative term in the valuation
  estimates at `p` for the factorial-weighted Taylor coefficients of theta functions, subject to
  the deductions made there.
* `partnerExponents d p = I_p°`: all `e ≥ 0` if `p = d`, the odd `e ≥ 0` if `(p / d) = -1`, and no
  `e` otherwise; `positivePartnerExponents d p = I_p` is its subset of positive exponents.

The valuation `v(π_p)` and the exponent sets, which the local prime sums of the Legendre symbol
also use, are defined in `TauCeti.NumberTheory.ComplexMultiplication.PartnerExponents`.

This file computes `ρ_p` and `γ_p` in the three cases and bounds them
(`rhoPrime_of_ne_of_legendreSym_ne_neg_one`, `gammaPrime_of_legendreSym_eq_neg_one`,
`gammaPrime_self`, `gammaPrime_le_one`, …); it expresses `γ_p` as the series
`v(π_p) · ∑_{e ∈ I_p} p ^ (-e)` (`hasSum_gammaPrime`, `hasSum_div_pow_positivePartnerExponents`);
it shows that `q_p` is a positive power of `p`, and that for a prime `p` it is greater than `1`
and `q_p - 1` is prime to `p` (`exists_primeNorm_eq_pow`, `one_lt_primeNorm`,
`coprime_primeNorm_sub_one`); and it proves that `π_p` lies in the order `complexOrder (-d)`,
defined when `-d ≡ 0, 1 (mod 4)` and equal to the integers of `K` for `d ≡ 3 (mod 4)`, that `π_p`
divides `p` in this order, that `π_p · conj π_p = q_p` when `(p / d) ≠ 1` for a prime `p`, and that
`π_p` has absolute value `p ^ (-v(π_p)) < 1` under every ring homomorphism from `ℂ` to a normed
division ring over `ℚ_p`, such as `ℂ_p` (`piPrime_mem_complexOrder`, `piPrime_dvd_natCast`,
`piPrime_mul_conj`, `norm_map_piPrime`, `norm_map_piPrime_lt_one`).

For `d ≡ 3 (mod 4)` and `K` presented as a number field generated by a root of `X² + d`, it
identifies the quadratic character `χ_D` of `K` with `(· / d)`
(`fundamentalDiscriminantChar_discr_eq_legendreSym`), so the decomposition law of `K` in terms of
`χ_D` (`Multiquadratic.fundamentalDiscriminantChar_discr_eq_one_iff`,
`Multiquadratic.fundamentalDiscriminantChar_discr_eq_neg_one_iff`) applies to the Legendre-symbol
cases: `d` is the only ramified prime, `p` splits exactly when `(p / d) = 1`, including `p = 2`,
`p` is inert exactly when `(p / d) = -1`, and every prime of `K` above `p` has absolute norm `q_p`
(`ramifiedPrimes_eq_singleton`, `ncard_primesOver_eq_finrank_iff_legendreSym_eq_one`,
`notMem_ramifiedPrimes_and_ncard_primesOver_eq_one_iff_legendreSym_eq_neg_one`,
`absNorm_eq_primeNorm`).

## Main definitions

* `TauCeti.ComplexMultiplication.piPrime`, `TauCeti.ComplexMultiplication.primeNorm`,
  `TauCeti.ComplexMultiplication.rhoPrime`, `TauCeti.ComplexMultiplication.gammaPrime`.

## References

* J. Lubin, J. Tate, *Formal complex multiplication in local fields*, Ann. of Math. 81 (1965).
* The definitions follow the formal proof in the folder `grh` of
  https://github.com/lsernau/grh-lean at commit 72fead102f663d5c7a407964a13dc0cf9d977207, file
  `src/Lib/CM/FormalGroup/PrimeNotation.lean` (`New.piPrime`, `New.varpiValuation`,
  `New.gammaPrime`); `q_p` is `New.primeNorm` of
  `src/Lib/General/NumberTheory/ImaginaryQuadraticField.lean`.
-/

public section

open Complex
open scoped NumberField

namespace TauCeti.ComplexMultiplication

variable (d p : ℕ)

/-- `π_p`: the square root `√-d = √d · i` of `-d`, `QuadraticAlgebra.sqrtRadicand (-d)`, if
`p = d`, and `p` otherwise. -/
noncomputable def piPrime : ℂ := if p = d then QuadraticAlgebra.sqrtRadicand (-(d : ℚ)) else p

section Basic

variable {d p}

theorem piPrime_def :
    piPrime d p = if p = d then QuadraticAlgebra.sqrtRadicand (-(d : ℚ)) else (p : ℂ) := by
  rw [piPrime]

/-- In the ramified case `π_d = √-d`; `QuadraticAlgebra.sqrtRadicand_of_nonpos` gives the explicit
formula `√d · i`. -/
theorem piPrime_self : piPrime d d = QuadraticAlgebra.sqrtRadicand (-(d : ℚ)) := by
  simp [piPrime]

theorem piPrime_of_ne (h : p ≠ d) : piPrime d p = p := by
  simp [piPrime, h]

/-- The square of `√-d` is `-d`. -/
@[simp] theorem piPrime_self_sq : piPrime d d ^ 2 = -d := by
  rw [piPrime_self, sq, QuadraticAlgebra.sqrtRadicand_mul_self]
  push_cast
  rfl

/-- `π_p ≠ 0` for `p ≠ 0`. -/
theorem piPrime_ne_zero (hp : p ≠ 0) : piPrime d p ≠ 0 := by
  by_cases h : p = d
  · subst h
    rw [piPrime_self, ne_eq, QuadraticAlgebra.sqrtRadicand_eq_zero_iff, neg_eq_zero]
    exact_mod_cast hp
  · rw [piPrime_of_ne h]
    exact_mod_cast hp

/-- `π_p` lies in the order `ℤ[(-d + √-d) / 2] ⊆ ℂ`, which is the ring of integers of `ℚ(√-d)`
when `d` is a prime with `d ≡ 3 (mod 4)`. -/
theorem piPrime_mem_complexOrder (h0 : -(d : ℤ) ≤ 0) (hD : -(d : ℤ) % 4 = 0 ∨ -(d : ℤ) % 4 = 1) :
    piPrime d p ∈ QuadraticOrder.complexOrder (-d) h0 hD := by
  by_cases h : p = d
  · subst h
    rw [QuadraticOrder.mem_complexOrder_iff]
    refine ⟨p, 2, ?_⟩
    rw [piPrime_self, QuadraticAlgebra.sqrtRadicand_of_nonpos (by simp),
      QuadraticOrder.complexGenerator_def]
    push_cast
    rw [neg_neg]
    ring
  · rw [piPrime_of_ne h]
    exact Subalgebra.natCast_mem _ p

/-- `π_p` divides `p` in the order `complexOrder (-d)`: `p = π_p · (-π_p)` if `p = d`, and
`π_p = p` otherwise. -/
theorem piPrime_dvd_natCast (h0 : -(d : ℤ) ≤ 0) (hD : -(d : ℤ) % 4 = 0 ∨ -(d : ℤ) % 4 = 1) :
    (⟨piPrime d p, piPrime_mem_complexOrder h0 hD⟩ : QuadraticOrder.complexOrder (-d) h0 hD) ∣
      (p : QuadraticOrder.complexOrder (-d) h0 hD) := by
  by_cases h : p = d
  · subst h
    refine ⟨-⟨piPrime p p, piPrime_mem_complexOrder h0 hD⟩, Subtype.ext ?_⟩
    rw [Subalgebra.coe_mul, Subalgebra.coe_neg, mul_neg, ← sq, piPrime_self_sq, neg_neg]
    rfl
  · exact ⟨1, Subtype.ext (by rw [mul_one]; exact (piPrime_of_ne h).symm)⟩

/-- Under every ring homomorphism from `ℂ` to a normed division ring over `ℚ_p`, such as `ℂ_p`,
`π_p` has absolute value `p ^ (-v(π_p))`. -/
theorem norm_map_piPrime [Fact p.Prime] {K : Type*} [NormedDivisionRing K]
    [NormedAlgebra ℚ_[p] K] (ι : ℂ →+* K) :
    ‖ι (piPrime d p)‖ = (p : ℝ) ^ (-piPrimeValuation d p) := by
  by_cases h : p = d
  · subst h
    have hsq : ‖ι (piPrime p p)‖ ^ 2 = (p : ℝ)⁻¹ := by
      rw [← norm_pow, ← map_pow, piPrime_self_sq, map_neg, map_natCast, norm_neg,
        norm_natCast_p]
    rw [piPrimeValuation_self, Real.rpow_neg (Nat.cast_nonneg p), ← Real.sqrt_eq_rpow,
      ← Real.sqrt_inv, ← hsq, Real.sqrt_sq (norm_nonneg _)]
  · rw [piPrime_of_ne h, piPrimeValuation_of_ne h, map_natCast, norm_natCast_p, Real.rpow_neg_one]

/-- Under every ring homomorphism from `ℂ` to a normed division ring over `ℚ_p`, `π_p` has
absolute value less than `1`. -/
theorem norm_map_piPrime_lt_one [Fact p.Prime] {K : Type*} [NormedDivisionRing K]
    [NormedAlgebra ℚ_[p] K] (ι : ℂ →+* K) : ‖ι (piPrime d p)‖ < 1 := by
  rw [norm_map_piPrime]
  exact Real.rpow_lt_one_of_one_lt_of_neg (by exact_mod_cast (Fact.out : p.Prime).one_lt)
    (neg_lt_zero.mpr piPrimeValuation_pos)

end Basic

variable [Fact d.Prime]

/-- `q_p`: `p²` if `(p / d) = -1` and `p` otherwise. For `d ≡ 3 (mod 4)` and a prime `p`, it is the
norm of a prime of `ℚ(√-d)` above `p` (`absNorm_eq_primeNorm`). -/
def primeNorm : ℕ := if legendreSym d p = -1 then p ^ 2 else p

/-- `ρ_p = v(π_p) / (q_p - 1)`. -/
noncomputable def rhoPrime : ℝ := piPrimeValuation d p / ((primeNorm d p : ℝ) - 1)

/-- `γ_p = 1 / (p - 1) - ρ_p`. -/
noncomputable def gammaPrime : ℝ := 1 / ((p : ℝ) - 1) - rhoPrime d p

variable {d p}

theorem primeNorm_def : primeNorm d p = if legendreSym d p = -1 then p ^ 2 else p := by
  rw [primeNorm]

theorem rhoPrime_def : rhoPrime d p = piPrimeValuation d p / ((primeNorm d p : ℝ) - 1) := by
  rw [rhoPrime]

theorem gammaPrime_def : gammaPrime d p = 1 / ((p : ℝ) - 1) - rhoPrime d p := by
  rw [gammaPrime]

theorem primeNorm_of_legendreSym_eq_neg_one (h : legendreSym d p = -1) : primeNorm d p = p ^ 2 := by
  simp [primeNorm, h]

theorem primeNorm_of_legendreSym_ne_neg_one (h : legendreSym d p ≠ -1) : primeNorm d p = p := by
  simp [primeNorm, h]

@[simp] theorem primeNorm_self : primeNorm d d = d :=
  primeNorm_of_legendreSym_ne_neg_one fun h ↦ ne_of_legendreSym_eq_neg_one h rfl

/-- `ρ_p = 1 / (p - 1)` when `p ≠ d` and `(p / d) ≠ -1`; for `d ≡ 3 (mod 4)` and a prime `p`,
this is the case of `p` split in `ℚ(√-d)`. -/
theorem rhoPrime_of_ne_of_legendreSym_ne_neg_one (h₁ : p ≠ d) (h₂ : legendreSym d p ≠ -1) :
    rhoPrime d p = 1 / ((p : ℝ) - 1) := by
  rw [rhoPrime, piPrimeValuation_of_ne h₁, primeNorm_of_legendreSym_ne_neg_one h₂]

/-- `ρ_p = 1 / (p² - 1)` when `(p / d) = -1`; for `d ≡ 3 (mod 4)` and a prime `p`, this is the
case of `p` inert in `ℚ(√-d)`. -/
theorem rhoPrime_of_legendreSym_eq_neg_one (h : legendreSym d p = -1) :
    rhoPrime d p = 1 / ((p : ℝ) ^ 2 - 1) := by
  rw [rhoPrime, piPrimeValuation_of_ne (ne_of_legendreSym_eq_neg_one h),
    primeNorm_of_legendreSym_eq_neg_one h, Nat.cast_pow]

/-- `ρ_d = 1 / (2d - 2)` in the ramified case `p = d`. -/
@[simp] theorem rhoPrime_self : rhoPrime d d = 1 / (2 * (d : ℝ) - 2) := by
  rw [rhoPrime, piPrimeValuation_self, primeNorm_self, div_div, mul_sub, mul_one]

/-- `γ_p = 0` when `p ≠ d` and `(p / d) ≠ -1`; for `d ≡ 3 (mod 4)` and a prime `p`, this is the
case of `p` split in `ℚ(√-d)`. -/
theorem gammaPrime_of_ne_of_legendreSym_ne_neg_one (h₁ : p ≠ d) (h₂ : legendreSym d p ≠ -1) :
    gammaPrime d p = 0 := by
  rw [gammaPrime, rhoPrime_of_ne_of_legendreSym_ne_neg_one h₁ h₂, sub_self]

/-- `γ_p = p / (p² - 1)` when `(p / d) = -1`; for `d ≡ 3 (mod 4)` and a prime `p`, this is the
case of `p` inert in `ℚ(√-d)`. -/
theorem gammaPrime_of_legendreSym_eq_neg_one (h : legendreSym d p = -1) :
    gammaPrime d p = p / ((p : ℝ) ^ 2 - 1) := by
  have hp : (2 : ℝ) ≤ p := by exact_mod_cast two_le_of_legendreSym_eq_neg_one h
  have h1 : (p : ℝ) - 1 ≠ 0 := by linarith
  have h2 : (p : ℝ) ^ 2 - 1 ≠ 0 := by nlinarith
  rw [gammaPrime, rhoPrime_of_legendreSym_eq_neg_one h]
  field_simp
  ring

/-- `γ_d = 1 / (2d - 2)` in the ramified case `p = d`. -/
@[simp] theorem gammaPrime_self : gammaPrime d d = 1 / (2 * (d : ℝ) - 2) := by
  have hd : (2 : ℝ) ≤ d := by exact_mod_cast (Fact.out : d.Prime).two_le
  have h1 : (d : ℝ) - 1 ≠ 0 := by linarith
  rw [gammaPrime, rhoPrime_self]
  field_simp
  ring

/-- `q_p` is a positive power of `p`. -/
theorem exists_primeNorm_eq_pow : ∃ k, 0 < k ∧ primeNorm d p = p ^ k := by
  by_cases h : legendreSym d p = -1
  · exact ⟨2, two_pos, primeNorm_of_legendreSym_eq_neg_one h⟩
  · exact ⟨1, one_pos, by rw [primeNorm_of_legendreSym_ne_neg_one h, pow_one]⟩

/-- `0 ≤ ρ_p` for `p ≠ 0`. -/
theorem rhoPrime_nonneg (hp : p ≠ 0) : 0 ≤ rhoPrime d p := by
  obtain ⟨k, -, hq⟩ := exists_primeNorm_eq_pow (d := d) (p := p)
  have : 1 ≤ primeNorm d p := hq ▸ Nat.one_le_pow _ _ (Nat.pos_of_ne_zero hp)
  exact div_nonneg piPrimeValuation_pos.le (by rw [sub_nonneg]; exact_mod_cast this)

/-- `ρ_p ≤ 1 / (p - 1)`, with equality when `p ≠ d` and `(p / d) ≠ -1`. -/
theorem rhoPrime_le_one_div : rhoPrime d p ≤ 1 / ((p : ℝ) - 1) := by
  by_cases h₁ : p = d
  · subst h₁
    have hp : (2 : ℝ) ≤ p := by exact_mod_cast (Fact.out : p.Prime).two_le
    rw [rhoPrime_self]
    exact one_div_le_one_div_of_le (by linarith) (by linarith)
  by_cases h₂ : legendreSym d p = -1
  · have hp : (2 : ℝ) ≤ p := by exact_mod_cast two_le_of_legendreSym_eq_neg_one h₂
    rw [rhoPrime_of_legendreSym_eq_neg_one h₂]
    exact one_div_le_one_div_of_le (by linarith) (by nlinarith)
  · rw [rhoPrime_of_ne_of_legendreSym_ne_neg_one h₁ h₂]

/-- `0 ≤ γ_p`. -/
theorem gammaPrime_nonneg : 0 ≤ gammaPrime d p :=
  sub_nonneg.mpr rhoPrime_le_one_div

/-- `γ_p ≤ 1 / (p - 1)` for `p ≠ 0`. -/
theorem gammaPrime_le_one_div (hp : p ≠ 0) : gammaPrime d p ≤ 1 / ((p : ℝ) - 1) :=
  sub_le_self _ (rhoPrime_nonneg hp)

/-- `γ_p ≤ 1`. -/
theorem gammaPrime_le_one : gammaPrime d p ≤ 1 := by
  rcases Nat.lt_or_ge p 2 with hp | hp
  · -- `p = 0` or `p = 1`: then `p ≠ d` and `(p / d) ≠ -1`, so `γ_p = 0`
    have h₁ : p ≠ d := by have := (Fact.out : d.Prime).two_le; omega
    have h₂ : legendreSym d p ≠ -1 := fun h ↦
      (Nat.not_le_of_gt hp) (two_le_of_legendreSym_eq_neg_one h)
    rw [gammaPrime_of_ne_of_legendreSym_ne_neg_one h₁ h₂]
    exact zero_le_one
  · have hp' : (2 : ℝ) ≤ p := by exact_mod_cast hp
    refine (gammaPrime_le_one_div (by omega)).trans ?_
    rw [div_le_one (by linarith)]
    linarith

/-- `1 < q_p` for `1 < p`. -/
theorem one_lt_primeNorm (hp : 1 < p) : 1 < primeNorm d p := by
  obtain ⟨k, hk, hq⟩ := exists_primeNorm_eq_pow (d := d) (p := p)
  rw [hq]
  exact Nat.one_lt_pow hk.ne' hp

/-- `p` is prime to `q_p - 1` for `p ≠ 0`. -/
theorem coprime_primeNorm_sub_one (hp : p ≠ 0) : p.Coprime (primeNorm d p - 1) := by
  obtain ⟨k, hk, hq⟩ := exists_primeNorm_eq_pow (d := d) (p := p)
  simpa only [hq] using Nat.coprime_pow_sub_one hp hk.ne'

/-- `v(π_p) = (q_p - 1) · ρ_p` for `1 < p`. -/
theorem piPrimeValuation_eq_mul_rhoPrime (hp : 1 < p) :
    piPrimeValuation d p = ((primeNorm d p : ℝ) - 1) * rhoPrime d p := by
  have : (1 : ℝ) < primeNorm d p := by exact_mod_cast one_lt_primeNorm hp
  rw [rhoPrime, mul_div_cancel₀ _ (by linarith)]

/-- If `(p / d) ≠ 1` for a prime `p`, then `π_p · conj π_p = q_p`. For `d ≡ 3 (mod 4)`, the
condition `(p / d) ≠ 1` says that `p` does not split in `ℚ(√-d)`
(`ncard_primesOver_eq_finrank_iff_legendreSym_eq_one`). -/
theorem piPrime_mul_conj (hp : p.Prime) (h : legendreSym d p ≠ 1) :
    piPrime d p * (starRingEnd ℂ) (piPrime d p) = primeNorm d p := by
  by_cases h₁ : p = d
  · subst h₁
    rw [primeNorm_self, piPrime_self, QuadraticAlgebra.conj_sqrtRadicand (by simp), mul_neg,
      QuadraticAlgebra.sqrtRadicand_mul_self]
    push_cast
    exact neg_neg _
  · -- `p ≠ d` is prime, so `(p / d) = ±1`, and it is not `1`
    have h₂ : legendreSym d p = -1 := legendreSym_eq_neg_one_of_ne_one hp h₁ h
    rw [piPrime_of_ne h₁, conj_natCast, primeNorm_of_legendreSym_eq_neg_one h₂]
    push_cast
    ring

/-- `∑_{e ∈ I_p} c · p ^ (-e) = c · γ_p / v(π_p)` for every real `c`. -/
theorem hasSum_div_pow_positivePartnerExponents (c : ℝ) :
    HasSum (fun e : positivePartnerExponents d p ↦ c / (p : ℝ) ^ (e : ℕ))
      (c * gammaPrime d p / piPrimeValuation d p) := by
  by_cases h₁ : p = d
  · -- `p = d`: `∑_{e ≥ 1} c p⁻ᵉ = c / (p - 1)`
    subst h₁
    have hp : (2 : ℝ) ≤ p := by exact_mod_cast (Fact.out : p.Prime).two_le
    rw [positivePartnerExponents_self,
      (add_left_injective 1).hasSum_range_iff (f := fun e ↦ c / (p : ℝ) ^ e)]
    have hg := TauCeti.hasSum_mul_inv_pow_succ_of_one_lt_norm
      (d := (p : ℝ)) (by rw [Real.norm_natCast]; linarith) c
    convert hg using 1
    · ext k
      rw [Function.comp_apply, inv_pow, div_eq_mul_inv]
    · have h1 : (p : ℝ) - 1 ≠ 0 := by linarith
      rw [gammaPrime_self, piPrimeValuation_self]
      field_simp
  by_cases h₂ : legendreSym d p = -1
  · -- `p` inert: `∑_{e odd} c p⁻ᵉ = c p / (p² - 1)`
    have hp : (2 : ℝ) ≤ p := by exact_mod_cast two_le_of_legendreSym_eq_neg_one h₂
    have hinj : Function.Injective (fun k : ℕ ↦ 2 * k + 1) :=
      (add_left_injective 1).comp (mul_right_injective₀ two_ne_zero)
    rw [positivePartnerExponents_of_legendreSym_eq_neg_one h₂,
      hinj.hasSum_range_iff (f := fun e ↦ c / (p : ℝ) ^ e)]
    have hg := TauCeti.hasSum_mul_inv_pow_succ_of_one_lt_norm
      (d := (p : ℝ) ^ 2) (by rw [norm_pow, Real.norm_natCast]; nlinarith) (c * p)
    convert hg using 1
    · ext k
      rw [Function.comp_apply, inv_pow, ← pow_mul]
      field_simp
      ring
    · have h2 : (p : ℝ) ^ 2 - 1 ≠ 0 := by nlinarith
      rw [gammaPrime_of_legendreSym_eq_neg_one h₂, piPrimeValuation_of_ne h₁]
      field_simp
  · -- otherwise the sum is empty and `γ_p = 0`
    rw [gammaPrime_of_ne_of_legendreSym_ne_neg_one h₁ h₂, mul_zero, zero_div,
      positivePartnerExponents_of_ne_of_legendreSym_ne_neg_one h₁ h₂]
    exact hasSum_empty

/-- `γ_p = v(π_p) · ∑_{e ∈ I_p} p ^ (-e)`. -/
theorem hasSum_gammaPrime :
    HasSum (fun e : positivePartnerExponents d p ↦ piPrimeValuation d p / (p : ℝ) ^ (e : ℕ))
      (gammaPrime d p) := by
  convert hasSum_div_pow_positivePartnerExponents (d := d) (p := p) (piPrimeValuation d p) using 1
  rw [mul_div_cancel_left₀ _ piPrimeValuation_pos.ne']

/-! ### The decomposition of `p` in `ℚ(√-d)` -/

section Splitting

variable {K : Type*} [Field K] [NumberField K] {θ : 𝓞 K}

/-- For `d ≡ 3 (mod 4)`, the only prime ramified in `K = ℚ(√-d)`, generated by a root `θ` of
`X² + d`, is `d`: `-d` is the odd prime discriminant of `d`. -/
theorem ramifiedPrimes_eq_singleton
    (hmin : minpoly ℤ θ = Polynomial.X ^ 2 - Polynomial.C (-(d : ℤ)))
    (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) (hd : d % 4 = 3) :
    NumberField.ramifiedPrimes K = {d} := by
  have hodd : Odd d := Nat.odd_iff.mpr (by omega)
  rw [← Multiquadratic.oddPrimeDiscriminant_of_mod_four_ne_one (by omega),
    ← Multiquadratic.primeDiscriminantRadicand_oddPrimeDiscriminant hodd] at hmin
  rw [Multiquadratic.ramifiedPrimes_eq_singleton
      (Multiquadratic.isPrimeDiscriminant_oddPrimeDiscriminant Fact.out hodd) hmin hgen,
    Multiquadratic.primeDiscriminantPrime_oddPrimeDiscriminant hodd]

/-- For `d ≡ 3 (mod 4)` and `K = ℚ(√-d)`, generated by a root `θ` of `X² + d`, the quadratic
character `χ_D` of `K` is the Legendre symbol `(· / d)`: `K` has discriminant `-d`, the odd prime
discriminant of `d`. -/
theorem fundamentalDiscriminantChar_discr_eq_legendreSym
    (hmin : minpoly ℤ θ = Polynomial.X ^ 2 - Polynomial.C (-(d : ℤ)))
    (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) (hd : d % 4 = 3) (n : ℤ) :
    Multiquadratic.fundamentalDiscriminantChar (NumberField.discr K)
        (Multiquadratic.isFundamentalDiscr_discr (NumberField.finrank_rat_eq_two hmin hgen)) n =
      legendreSym d n := by
  have hodd : Odd d := Nat.odd_iff.mpr (by omega)
  refine Multiquadratic.fundamentalDiscriminantChar_discr_eq_legendreSym
    (NumberField.finrank_rat_eq_two hmin hgen) hodd
    (Multiquadratic.discr_eq_primeDiscriminant_of_sq
      (Multiquadratic.isPrimeDiscriminant_oddPrimeDiscriminant Fact.out hodd) ?_ hgen) n
  rw [Multiquadratic.primeDiscriminantRadicand_oddPrimeDiscriminant hodd,
    Multiquadratic.oddPrimeDiscriminant_of_mod_four_ne_one (by omega)]
  exact NumberField.coe_gen_sq hmin

/-- **The splitting law in `ℚ(√-d)`.** For `d ≡ 3 (mod 4)` and `K = ℚ(√-d)`, generated by a root
`θ` of `X² + d`, a prime `p`, including `p = 2`, splits in `K` if and only if `(p / d) = 1`. -/
theorem ncard_primesOver_eq_finrank_iff_legendreSym_eq_one
    (hmin : minpoly ℤ θ = Polynomial.X ^ 2 - Polynomial.C (-(d : ℤ)))
    (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) (hd : d % 4 = 3) [Fact p.Prime] :
    (Ideal.primesOver (Ideal.span {(p : ℤ)}) (𝓞 K)).ncard = Module.finrank ℚ K ↔
      legendreSym d p = 1 := by
  have hK := NumberField.finrank_rat_eq_two hmin hgen
  have hχ := fundamentalDiscriminantChar_discr_eq_legendreSym hmin hgen hd p
  rw [Int.cast_natCast] at hχ
  rw [hK, ← Multiquadratic.fundamentalDiscriminantChar_discr_eq_one_iff hK p, hχ]

/-- **The inert primes of `ℚ(√-d)`.** For `d ≡ 3 (mod 4)` and `K = ℚ(√-d)`, generated by a root
`θ` of `X² + d`, a prime `p` is unramified in `K` with a single prime of `K` above it if and only if
`(p / d) = -1`. -/
theorem notMem_ramifiedPrimes_and_ncard_primesOver_eq_one_iff_legendreSym_eq_neg_one
    (hmin : minpoly ℤ θ = Polynomial.X ^ 2 - Polynomial.C (-(d : ℤ)))
    (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) (hd : d % 4 = 3) [Fact p.Prime] :
    p ∉ NumberField.ramifiedPrimes K ∧
        (Ideal.primesOver (Ideal.span {(p : ℤ)}) (𝓞 K)).ncard = 1 ↔
      legendreSym d p = -1 := by
  have hK := NumberField.finrank_rat_eq_two hmin hgen
  have hχ := fundamentalDiscriminantChar_discr_eq_legendreSym hmin hgen hd p
  rw [Int.cast_natCast] at hχ
  rw [← Multiquadratic.fundamentalDiscriminantChar_discr_eq_neg_one_iff hK p, hχ]

/-- For `d ≡ 3 (mod 4)` and `K = ℚ(√-d)`, generated by a root `θ` of `X² + d`, every prime of `K`
above a prime `p` has absolute norm `q_p`. -/
theorem absNorm_eq_primeNorm (hmin : minpoly ℤ θ = Polynomial.X ^ 2 - Polynomial.C (-(d : ℤ)))
    (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) (hd : d % 4 = 3) [Fact p.Prime] (𝔭 : Ideal (𝓞 K))
    [𝔭.IsPrime] [𝔭.LiesOver (Ideal.span {(p : ℤ)})] : Ideal.absNorm 𝔭 = primeNorm d p := by
  have hK := NumberField.finrank_rat_eq_two hmin hgen
  have hχ := fundamentalDiscriminantChar_discr_eq_legendreSym hmin hgen hd p
  rw [Int.cast_natCast] at hχ
  by_cases h : legendreSym d p = -1
  · rw [primeNorm_of_legendreSym_eq_neg_one h,
      Multiquadratic.absNorm_eq_sq_of_fundamentalDiscriminantChar_discr_eq_neg_one hK p 𝔭
        (hχ.trans h)]
  · rw [primeNorm_of_legendreSym_ne_neg_one h,
      Multiquadratic.absNorm_eq_of_fundamentalDiscriminantChar_discr_ne_neg_one hK p 𝔭
        (hχ ▸ h)]

end Splitting

end TauCeti.ComplexMultiplication
