import Mathlib.Tactic.LinearCombination

/-!
# Zero sets of simple exponential sums

Let `α₁, …, αₙ` be units of a field `K` and `a₁, …, aₙ` nonzero elements of `K`. This file
describes the set of integers `m` with `∑ aᵢ αᵢ ^ m = 0` in terms of nondegenerate solutions of
unit equations in cyclic subgroups of `(Kˣ)ᵏ`, following Evertse–Schlickewei–Schmidt.

At a zero `m`, split `{1, …, n}` into blocks on which the terms `aᵢ αᵢ ^ m` form minimal
vanishing subsums, and choose a base point `b` in each block. Dividing a block by
`-a_b α_b ^ m` gives a nondegenerate solution of `∑ (-aᵢ / a_b) xᵢ = 1`, `i ≠ b` in the block,
with `x = ((αᵢ / α_b) ^ m)ᵢ` in the cyclic group generated by `(αᵢ / α_b)ᵢ`. A choice of blocks
and base points is recorded as an idempotent map `r : ι → ι` sending each index to the base
point of its block. For a fixed `r`, the zeros of this shape are the integers `m` for which
`((αᵢ / α_{r i}) ^ m)ᵢ` lies in a set of size at most the product of the numbers of these
nondegenerate solutions; each of its elements is attained exactly on a residue class modulo the
order of `(αᵢ / α_{r i})ᵢ`.

Hence the zero set is a union of residue classes `{m | m ≡ c [ZMOD d]}` (singletons for `d = 0`,
arithmetic progressions for `d ≥ 1`), whose number is bounded by a sum over `r` of products of
counts of nondegenerate solutions. When no quotient `αᵢ / αⱼ` with `i ≠ j` has finite order,
the residue classes are singletons, and the same sum bounds the number of zeros.

A uniform bound for nondegenerate solutions of unit equations in groups of rank one, such as
the Evertse–Schlickewei–Schmidt bound, then bounds the number of residue classes in terms of
`n` alone. That bound is not proved here.

## Main results

* `TauCeti.exists_setOf_sum_mul_zpow_eq_zero_eq_biUnion_modEq`: the zero set is a union of
  residue classes, with the number of classes bounded by counts of nondegenerate solutions.
* `TauCeti.encard_setOf_sum_mul_zpow_eq_zero_le`: if no quotient `αᵢ / αⱼ` with `i ≠ j` has
  finite order, the same counts bound the number of zeros.

## References

* J.-H. Evertse, H. P. Schlickewei, W. M. Schmidt, *Linear equations in variables which lie in a
  multiplicative group*, Ann. of Math. 155 (2002), 807–836, Theorem 1.2 and §5.
* J.-H. Evertse, *Diophantine Approximation*, lecture notes (2019), Chapter 8, §8.4.
-/

public section

open Finset

namespace TauCeti

variable {K ι : Type*} [Field K] [Fintype ι] [DecidableEq ι] {a : ι → K} {α : ι → Kˣ}

/-- The indices other than `b` that `r` sends to `b`: the unknowns of the block with base
point `b`. -/
private abbrev blockIndices (r : ι → ι) (b : ι) : Finset ι :=
  univ.filter fun i ↦ r i = b ∧ i ≠ b

/-- The quotients `αᵢ / α_{r i}` of each unit by the unit at its base point. -/
private def baseQuotient (α : ι → Kˣ) (r : ι → ι) : ι → Kˣ :=
  fun i ↦ α i / α (r i)

/-- The tuples `v` in the cyclic group generated by `baseQuotient α r` which give, on every block
of the idempotent map `r`, a nondegenerate solution of the block's unit equation. -/
private def blockSolutions (a : ι → K) (α : ι → Kˣ) (r : ι → ι) : Set (ι → Kˣ) :=
  {v | v ∈ Subgroup.zpowers (baseQuotient α r) ∧ (∀ i, r (r i) = r i) ∧
    ∀ b, r b = b →
      IsNondegenerateSolution (fun i : blockIndices r b ↦ -a i / a b) fun i ↦ (v i : K)}

omit [Fintype ι] [DecidableEq ι] in
/-- Dividing a subsum of `∑ aᵢ αᵢ ^ m` by `-a_b α_b ^ m` turns it into a subsum of the unit
equation with coefficients `-aᵢ / a_b` and unknowns `(αᵢ / α_b) ^ m`. -/
private lemma sum_neg_div_mul_zpow {b : ι} (hb : a b ≠ 0) (s : Finset ι) (m : ℤ) :
    ∑ i ∈ s, -a i / a b * (((α i / α b) ^ m : Kˣ) : K) =
      -(∑ i ∈ s, a i * (α i : K) ^ m) / (a b * (α b : K) ^ m) := by
  rw [← sum_neg_distrib, sum_div]
  refine sum_congr rfl fun i _ ↦ ?_
  have hαb : (α b : K) ^ m ≠ 0 := zpow_ne_zero _ (α b).ne_zero
  simp only [Units.val_zpow_eq_zpow_val, Units.val_div_eq_div_val, div_zpow]
  field_simp

omit [Fintype ι] in
/-- The block with base point `b` and unknowns `J` gives a nondegenerate solution of its unit
equation exactly when `insert b J` is a vanishing subsum of `∑ aᵢ αᵢ ^ m` none of whose
nonempty subsums avoiding `b` vanishes. -/
private lemma isNondegenerateSolution_iff_of_forall_mem {b : ι} (hb : a b ≠ 0) {J : Finset ι}
    (hbJ : b ∉ J) {v : ι → Kˣ} {m : ℤ} (hv : ∀ i ∈ J, v i = (α i / α b) ^ m) :
    IsNondegenerateSolution (fun i : J ↦ -a i / a b) (fun i ↦ (v i : K)) ↔
      ∑ i ∈ insert b J, a i * (α i : K) ^ m = 0 ∧
        ∀ s ⊆ J, s.Nonempty → ∑ i ∈ s, a i * (α i : K) ^ m ≠ 0 := by
  have hc : a b * (α b : K) ^ m ≠ 0 := mul_ne_zero hb (zpow_ne_zero _ (α b).ne_zero)
  have key (s : Finset J) : ∑ i ∈ s, -a i / a b * (v i : K) =
      -(∑ i ∈ s.map (Function.Embedding.subtype _), a i * (α i : K) ^ m) /
        (a b * (α b : K) ^ m) := by
    rw [← sum_neg_div_mul_zpow hb, sum_map]
    exact sum_congr rfl fun i _ ↦ by rw [hv i i.property, Function.Embedding.coe_subtype]
  have huniv : (univ : Finset J).map (Function.Embedding.subtype _) = J := by
    rw [univ_eq_attach, attach_map_val]
  have hsubset (s : Finset J) : s.map (Function.Embedding.subtype _) ⊆ J := fun i hi ↦ by
    obtain ⟨j, -, rfl⟩ := mem_map.mp hi
    exact j.property
  rw [sum_insert hbJ]
  constructor
  · intro h
    have h1 := h.sum_eq_one
    rw [key, huniv, div_eq_one_iff_eq hc] at h1
    refine ⟨by linear_combination -h1, fun s hs hne hzero ↦ ?_⟩
    refine h.subsum_ne_zero (I := s.subtype (· ∈ J)) ?_ ?_
    · rw [← map_nonempty (f := Function.Embedding.subtype _), subtype_map_of_mem hs]
      exact hne
    · rw [key, subtype_map_of_mem hs, hzero, neg_zero, zero_div]
  · rintro ⟨h0, hsub⟩
    refine isNondegenerateSolution_iff.mpr ⟨?_, fun s hs ↦ ?_⟩
    · rw [key, huniv, div_eq_one_iff_eq hc]
      linear_combination -h0
    · rw [key]
      exact div_ne_zero (neg_ne_zero.mpr (hsub _ (hsubset s) hs.map)) hc

omit [Fintype ι] [DecidableEq ι] in
/-- On the unknowns of the block with base point `b`, the powers of `baseQuotient α r` are the
powers of `αᵢ / α_b`. -/
private lemma baseQuotient_zpow_apply {r : ι → ι} {b i : ι} (hi : r i = b) (m : ℤ) :
    (baseQuotient α r ^ m) i = (α i / α b) ^ m := by
  rw [Pi.pow_apply, baseQuotient, hi]

/-- Adding a block `I` with base point `b` to a decomposition `r'` of `S \ I` into blocks gives a
decomposition of `S`, in which `I.erase b` are the unknowns of the new block and the blocks with
base points outside `I` are unchanged. -/
private lemma blockIndices_piecewise {S I : Finset ι} {b : ι} (hIS : I ⊆ S) (hb : b ∈ I)
    {r' : ι → ι} (hidem : ∀ i, r' (r' i) = r' i) (hout : ∀ i ∉ S \ I, r' i = i)
    (hin : ∀ i ∈ S \ I, r' i ∈ S \ I) :
    (∀ i, I.piecewise (fun _ ↦ b) r' (I.piecewise (fun _ ↦ b) r' i) =
        I.piecewise (fun _ ↦ b) r' i) ∧
      (∀ i ∉ S, I.piecewise (fun _ ↦ b) r' i = i) ∧
      (∀ i ∈ S, I.piecewise (fun _ ↦ b) r' i ∈ S) ∧
      blockIndices (I.piecewise (fun _ ↦ b) r') b = I.erase b ∧
      ∀ b' ∉ I, blockIndices (I.piecewise (fun _ ↦ b) r') b' = blockIndices r' b' := by
  have hr'I (i : ι) (hi : i ∉ I) : r' i ∉ I := by
    by_cases hiS : i ∈ S \ I
    · exact (mem_sdiff.mp (hin i hiS)).2
    · rwa [hout i hiS]
  have hrI {i : ι} (hi : i ∈ I) : I.piecewise (fun _ ↦ b) r' i = b := piecewise_eq_of_mem _ _ _ hi
  have hrI' {i : ι} (hi : i ∉ I) : I.piecewise (fun _ ↦ b) r' i = r' i :=
    piecewise_eq_of_notMem _ _ _ hi
  refine ⟨fun i ↦ ?_, fun i hi ↦ ?_, fun i hi ↦ ?_, ?_, fun b' hb'I ↦ ?_⟩
  · by_cases hi : i ∈ I
    · rw [hrI hi, hrI hb]
    · rw [hrI' hi, hrI' (hr'I i hi), hidem]
  · rw [hrI' fun h ↦ hi (hIS h), hout i fun h ↦ hi (mem_sdiff.mp h).1]
  · by_cases hiI : i ∈ I
    · rw [hrI hiI]
      exact hIS hb
    · rw [hrI' hiI]
      exact (mem_sdiff.mp (hin i (mem_sdiff.mpr ⟨hi, hiI⟩))).1
  · ext i
    by_cases hi : i ∈ I
    · simp [hi]
    · simp only [mem_filter, mem_univ, true_and, mem_erase, hi, and_false, iff_false]
      rw [hrI' hi]
      exact fun h ↦ hr'I i hi (h.1 ▸ hb)
  · ext i
    by_cases hi : i ∈ I
    · simp only [mem_filter, mem_univ, true_and, hrI hi,
        hout i fun h ↦ (mem_sdiff.mp h).2 hi]
      exact ⟨fun h ↦ absurd (h.1 ▸ hb) hb'I, fun h ↦ absurd (h.1 ▸ hi) hb'I⟩
    · simp [hrI' hi]

/-- Every vanishing subsum of `∑ aᵢ αᵢ ^ m` splits into minimal vanishing subsums: there is an
idempotent map `r`, fixing the indices outside `S` and preserving `S`, such that each block
`insert b (blockIndices r b)` with `b ∈ S` vanishes and has no vanishing nonempty subsum
avoiding `b`. -/
private lemma exists_blocks (m : ℤ) (S : Finset ι) (hS : ∑ i ∈ S, a i * (α i : K) ^ m = 0) :
    ∃ r : ι → ι, (∀ i, r (r i) = r i) ∧ (∀ i ∉ S, r i = i) ∧ (∀ i ∈ S, r i ∈ S) ∧
      ∀ b ∈ S, r b = b → ∑ i ∈ insert b (blockIndices r b), a i * (α i : K) ^ m = 0 ∧
        ∀ s ⊆ blockIndices r b, s.Nonempty → ∑ i ∈ s, a i * (α i : K) ^ m ≠ 0 := by
  classical
  induction S using Finset.strongInduction with
  | H S ih =>
  rcases S.eq_empty_or_nonempty with rfl | hSne
  · exact ⟨id, fun _ ↦ rfl, fun _ _ ↦ rfl, fun _ h ↦ h, fun _ h ↦ absurd h (notMem_empty _)⟩
  -- Take a vanishing nonempty subsum `I ⊆ S` of minimal cardinality and a base point `b ∈ I`.
  set C := S.powerset.filter fun I ↦ I.Nonempty ∧ ∑ i ∈ I, a i * (α i : K) ^ m = 0
  obtain ⟨I, hIC, hImin⟩ := C.exists_min_image card ⟨S, by simp [C, hSne, hS]⟩
  simp only [C, mem_filter, mem_powerset] at hIC hImin
  obtain ⟨hIS, ⟨b, hb⟩, hI⟩ := hIC
  -- Split the rest `S \ I` into blocks by induction, and make `I` one more block.
  have hS' : ∑ i ∈ S \ I, a i * (α i : K) ^ m = 0 := by
    rw [← sum_sdiff hIS, hI, add_zero] at hS
    exact hS
  obtain ⟨r', hidem, hout, hin, hblk⟩ := ih _ (sdiff_ssubset hIS ⟨b, hb⟩) hS'
  obtain ⟨hidem, hout, hin, hnew, hold⟩ := blockIndices_piecewise hIS hb hidem hout hin
  refine ⟨_, hidem, hout, hin, fun b' hb'S hb' ↦ ?_⟩
  by_cases hb'I : b' ∈ I
  · -- The new block: `I` is a vanishing subsum of minimal cardinality.
    have hbb : b' = b := hb'.symm.trans (piecewise_eq_of_mem _ _ _ hb'I)
    subst hbb
    rw [hnew, insert_erase hb]
    refine ⟨hI, fun s hs hne hzero ↦ ?_⟩
    have hcard := hImin s ⟨(hs.trans (erase_subset _ _)).trans hIS, hne, hzero⟩
    have := card_lt_card (hs.trans_ssubset (erase_ssubset hb))
    omega
  · -- An old block, unchanged by adding `I`.
    rw [hold b' hb'I]
    exact hblk b' (mem_sdiff.mpr ⟨hb'S, hb'I⟩)
      (by rwa [piecewise_eq_of_notMem _ _ _ hb'I] at hb')

/-- `m` is a zero of `∑ aᵢ αᵢ ^ m` exactly when, for some idempotent map `r`, the `m`-th power
of `baseQuotient α r` gives nondegenerate solutions on all blocks of `r`. -/
private lemma sum_mul_zpow_eq_zero_iff (ha : ∀ i, a i ≠ 0) (m : ℤ) :
    ∑ i, a i * (α i : K) ^ m = 0 ↔ ∃ r : ι → ι, baseQuotient α r ^ m ∈ blockSolutions a α r := by
  have hiff (r : ι → ι) (b : ι) : IsNondegenerateSolution (fun i : blockIndices r b ↦ -a i / a b)
      (fun i ↦ ((baseQuotient α r ^ m) i : K)) ↔
        ∑ i ∈ insert b (blockIndices r b), a i * (α i : K) ^ m = 0 ∧
          ∀ s ⊆ blockIndices r b, s.Nonempty → ∑ i ∈ s, a i * (α i : K) ^ m ≠ 0 :=
    isNondegenerateSolution_iff_of_forall_mem (ha b) (by simp)
      fun i hi ↦ baseQuotient_zpow_apply (mem_filter.mp hi).2.1 m
  constructor
  · intro h
    obtain ⟨r, hidem, -, -, hblk⟩ := exists_blocks m univ h
    exact ⟨r, ⟨m, rfl⟩, hidem, fun b hb ↦ (hiff r b).mpr (hblk b (mem_univ b) hb)⟩
  · rintro ⟨r, -, hidem, hblk⟩
    -- Sum over the fibres of `r`: each fibre is empty or a vanishing block.
    rw [← sum_fiberwise univ r]
    refine sum_eq_zero fun b _ ↦ ?_
    by_cases hb : r b = b
    · have hfib : univ.filter (fun i ↦ r i = b) = insert b (blockIndices r b) := by
        ext i
        by_cases hib : i = b
        · simp [hib, hb]
        · simp [hib]
      rw [hfib]
      exact ((hiff r b).mp (hblk b hb)).1
    · rw [filter_false_of_mem fun i _ (hi : r i = b) ↦ hb (by rw [← hi, hidem]), sum_empty]

/-- The tuples in `blockSolutions a α r` are at most as many as the families of nondegenerate
solutions of the block equations. -/
private lemma encard_blockSolutions_le (r : ι → ι) :
    (blockSolutions a α r).encard ≤ ∏ b ∈ univ.filter (fun b ↦ r b = b),
      {x | x ∈ Subgroup.zpowers (fun i : blockIndices r b ↦ α i / α b) ∧
        IsNondegenerateSolution (fun i : blockIndices r b ↦ -a i / a b)
          (fun i ↦ (x i : K))}.encard := by
  rw [prod_subtype (p := fun b ↦ r b = b) _ (fun b ↦ by simp) _, ← Set.encard_pi_eq_prod_encard]
  refine Set.encard_le_encard_of_injOn (f := fun v (b : {b // r b = b}) (i : blockIndices r b) ↦
    v i) (fun v hv b _ ↦ ⟨?_, hv.2.2 b b.property⟩) ?_
  · obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hv.1
    exact ⟨k, funext fun i ↦ by
      dsimp only
      rw [Pi.pow_apply, baseQuotient_zpow_apply (mem_filter.mp i.property).2.1]⟩
  · rintro v ⟨⟨k, rfl⟩, hidem, -⟩ v' ⟨⟨k', rfl⟩, -, -⟩ h
    funext i
    dsimp only at h ⊢
    by_cases hi : i = r i
    · rw [baseQuotient_zpow_apply rfl, baseQuotient_zpow_apply rfl, ← hi, div_self', one_zpow,
        one_zpow]
    · exact congrFun (congrFun h ⟨r i, hidem i⟩) ⟨i, by simp [hi]⟩

/-- **Zero sets of simple exponential sums are unions of residue classes.** For units `αᵢ` and
nonzero `aᵢ` in a field, the integers `m` with `∑ aᵢ αᵢ ^ m = 0` form a union of residue classes
`{m | m ≡ c [ZMOD d]}`, which are singletons when `d = 0`. The number of classes is at most the
sum, over maps `r : ι → ι`, of the products over the fixed points `b` of `r` of the numbers of
nondegenerate solutions of `∑ (-aᵢ / a_b) xᵢ = 1`, indexed by the `i ≠ b` with `r i = b`, with
`x` in the cyclic group generated by `(αᵢ / α_b)ᵢ`.

This is the reduction in the proof of Theorem 1.2 of Evertse–Schlickewei–Schmidt. No
characteristic assumption is made. In characteristic zero, their bound for unit equations in
groups of rank one bounds each of these numbers; that bound is not proved here. -/
theorem exists_setOf_sum_mul_zpow_eq_zero_eq_biUnion_modEq (ha : ∀ i, a i ≠ 0) (α : ι → Kˣ) :
    ∃ T : Set (ℤ × ℕ),
      T.encard ≤ ∑ r : ι → ι, ∏ b ∈ univ.filter (fun b ↦ r b = b),
        {x | x ∈ Subgroup.zpowers (fun i : (univ.filter fun j ↦ r j = b ∧ j ≠ b) ↦ α i / α b) ∧
          IsNondegenerateSolution (fun i : (univ.filter fun j ↦ r j = b ∧ j ≠ b) ↦ -a i / a b)
            (fun i ↦ (x i : K))}.encard ∧
      {m : ℤ | ∑ i, a i * (α i : K) ^ m = 0} = ⋃ p ∈ T, {m : ℤ | m ≡ p.1 [ZMOD p.2]} := by
  -- For each `r`, record each tuple of `blockSolutions a α r` by an exponent attaining it and
  -- the order of `baseQuotient α r`.
  let rep (r : ι → ι) (v : ι → Kˣ) : ℤ := Function.invFun (fun m : ℤ ↦ baseQuotient α r ^ m) v
  have hrep {r : ι → ι} {v : ι → Kˣ} (hv : v ∈ blockSolutions a α r) :
      baseQuotient α r ^ rep r v = v :=
    Function.invFun_eq (Subgroup.mem_zpowers_iff.mp hv.1)
  refine ⟨⋃ r, (fun v ↦ (rep r v, orderOf (baseQuotient α r))) '' blockSolutions a α r,
    (Set.encard_iUnion_le_of_fintype _).trans (sum_le_sum fun r _ ↦
      (Set.encard_image_le _ _).trans (encard_blockSolutions_le r)), ?_⟩
  ext m
  simp only [Set.mem_ofPred_eq, sum_mul_zpow_eq_zero_iff ha, Set.mem_iUnion, Set.mem_image,
    exists_prop]
  constructor
  · rintro ⟨r, hr⟩
    refine ⟨_, ⟨r, _, hr, rfl⟩, ?_⟩
    rw [← zpow_eq_zpow_iff_modEq, hrep hr]
  · rintro ⟨_, ⟨r, v, hv, rfl⟩, hm⟩
    rw [← zpow_eq_zpow_iff_modEq, hrep hv] at hm
    exact ⟨r, hm ▸ hv⟩

/-- **Zeros of nondegenerate simple exponential sums are counted by unit equations.** For units
`αᵢ`, no quotient `αᵢ / αⱼ` with `i ≠ j` of finite order, and nonzero `aᵢ` in a field, the
number of integers `m` with `∑ aᵢ αᵢ ^ m = 0` is at most the sum, over maps `r : ι → ι`, of the
products over the fixed points `b` of `r` of the numbers of nondegenerate solutions of
`∑ (-aᵢ / a_b) xᵢ = 1`, indexed by the `i ≠ b` with `r i = b`, with `x` in the cyclic group
generated by `(αᵢ / α_b)ᵢ`.

The zero set is therefore finite whenever these numbers are; this is the reduction in the proof
of Theorem 1.2 of Evertse–Schlickewei–Schmidt. The index type must be nonempty: the empty sum
vanishes for every `m`. -/
theorem encard_setOf_sum_mul_zpow_eq_zero_le [Nonempty ι] (ha : ∀ i, a i ≠ 0)
    (hα : ∀ i j, i ≠ j → ¬IsOfFinOrder (α i / α j)) :
    {m : ℤ | ∑ i, a i * (α i : K) ^ m = 0}.encard ≤ ∑ r : ι → ι,
      ∏ b ∈ univ.filter (fun b ↦ r b = b),
        {x | x ∈ Subgroup.zpowers (fun i : (univ.filter fun j ↦ r j = b ∧ j ≠ b) ↦ α i / α b) ∧
          IsNondegenerateSolution (fun i : (univ.filter fun j ↦ r j = b ∧ j ≠ b) ↦ -a i / a b)
            (fun i ↦ (x i : K))}.encard := by
  have hcover : {m : ℤ | ∑ i, a i * (α i : K) ^ m = 0} =
      ⋃ r : ι → ι, {m : ℤ | baseQuotient α r ^ m ∈ blockSolutions a α r} := by
    ext m
    simp [sum_mul_zpow_eq_zero_iff ha]
  rw [hcover]
  refine (Set.encard_iUnion_le_of_fintype _).trans (sum_le_sum fun r _ ↦ ?_)
  refine le_trans ?_ (encard_blockSolutions_le r)
  refine Set.encard_le_encard_of_injOn (fun m hm ↦ hm) fun m hm m' _ hmm' ↦ ?_
  -- A block with a base point `b` has some unknown `j ≠ b`, and `αⱼ / α_b` has infinite order.
  obtain ⟨-, hidem, hblk⟩ := hm
  obtain ⟨i⟩ := ‹Nonempty ι›
  have hsol := hblk (r i) (hidem i)
  obtain ⟨⟨j, hj⟩⟩ : Nonempty (blockIndices r (r i)) := by
    by_contra hJ
    rw [not_nonempty_iff] at hJ
    simpa using hsol.sum_eq_one
  obtain ⟨hjr, hji⟩ := (mem_filter.mp hj).2
  refine injective_zpow_iff_not_isOfFinOrder.mpr (hα j (r i) hji) ?_
  simpa only [baseQuotient_zpow_apply hjr] using congrFun hmm' j

end TauCeti
