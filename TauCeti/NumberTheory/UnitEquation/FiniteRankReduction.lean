module

public import Mathlib.RingTheory.DedekindDomain.SInteger
public import TauCeti.NumberTheory.Height.ProjectiveTuple

import TauCeti.LinearAlgebra.Dimension.BaseChange
import TauCeti.LinearAlgebra.Submodule.ProperCover
import TauCeti.NumberTheory.NumberField.SUnits.FinitelyGenerated

/-!
# Unit equations in groups of finite rank: reduction to `S`-units of number fields

Evertse, Schlickewei and Schmidt prove their subspace theorem for unit equations for `n ≥ 2` and
an arbitrary group `Γ ≤ (Kˣ)ⁿ` of finite rank `r`, where `K = AlgebraicClosure ℚ`: the solutions
`y = x z` of `y₁ + ⋯ + yₙ = 1` with `x ∈ Γ` and `z` of small height lie in a bounded number of
proper subspaces.
Such a group need not be finitely generated (for instance the group generated by all the real roots
`2 ^ (1 / m)`, of rank one), and its coordinates need not lie in one number field. Their §6 reduces
the theorem to the case where `Γ` is a finitely generated group of tuples of `S`-units of one
number field, which is where the height, packing and Subspace-theorem arguments take place.

This file formalizes that reduction. A finite set of solutions, together with its witnesses `x`
and `z`, has its coordinates in one number field `E`. The finitely many `x` generate a subgroup of
`Γ` of rank at most `r`, which consists of tuples of `S`-units of `E` for a finite set `S` of
places. A cover of its solutions over `E` by proper subspaces extends to a cover over the large
field by the subspaces they span, and these remain proper. The bounded covers of finite sets of
solutions then give one cover of all of them, by the finite character of covers by boundedly many
proper subspaces (`Submodule.exists_subset_biUnion_iff_forall_finite`).

The cover bound over number fields enters as a hypothesis: this file does not prove it. The
condition on `z` is `h_aff(z) ≤ φ(h_aff(x))` for an arbitrary `φ : ℝ → ℝ`, where `h_aff` is the
absolute affine logarithmic height `TauCeti.absoluteLogHeightAff`; this is invariant under field
embeddings. The perturbed theorem of Evertse, Schlickewei and Schmidt takes, for `n ≥ 2`,
`φ(h) = n⁻¹ exp(-(5n)^(3n)) (1 + h)` and the bound `exp((5n)^(3n)(r + 1))`. The reduction itself
holds for every `n`.

## Main results

* `TauCeti.exists_subspaceCover_of_forall_numberField`: if, for every number field `E` inside
  the algebraic extension `L` of `ℚ`, every finitely generated group of `n`-tuples of `S`-units of
  `E` of rank at most `r` has its solutions covered by at most `B` proper subspaces of `Eⁿ`, then
  so does every subgroup of `(Lˣ)ⁿ` of rank at most `r`, by at most `B` proper subspaces of `Lⁿ`.

## References

* J.-H. Evertse, H. P. Schlickewei and W. M. Schmidt, *Linear equations in variables which lie in
  a multiplicative group*, Ann. of Math. 155 (2002), 807–836, Theorem 2.1 and §6.
-/

public section

open IsDedekindDomain NumberField Submodule

namespace TauCeti

variable {L : Type*} [Field L] [CharZero L] [Algebra.IsAlgebraic ℚ L] {n r : ℕ} {B : ℝ}
  {φ : ℝ → ℝ}

/-- The finite step of `TauCeti.exists_subspaceCover_of_forall_numberField`: finitely many
solutions are covered by at most `B` proper subspaces. Their witnesses descend to one number field
`E`, where the hypothesis covers them; the spans over `L` of the subspaces of the cover are proper
since extending scalars preserves dimension. -/
private theorem exists_subspaceCover_of_finite
    (h : ∀ (E : IntermediateField ℚ L) [NumberField E] (S : Finset (HeightOneSpectrum (𝓞 E)))
      (Δ : Subgroup (Fin n → (S : Set (HeightOneSpectrum (𝓞 E))).unit E)),
      Δ.FG → Module.rank ℤ (Additive Δ) ≤ r →
      ∃ T : Finset (Submodule E (Fin n → E)), (T.card : ℝ) ≤ B ∧ (∀ V ∈ T, V ≠ ⊤) ∧
        ∀ x ∈ Δ, ∀ z : Fin n → Eˣ,
          absoluteLogHeightAff (fun i ↦ ((z i : Eˣ) : E)) ≤
            φ (absoluteLogHeightAff (fun i ↦ ((x i : Eˣ) : E))) →
          ∑ i, ((x i : Eˣ) : E) * (z i : E) = 1 →
          ∃ V ∈ T, (fun i ↦ ((x i : Eˣ) : E) * (z i : E)) ∈ V)
    {Γ : Subgroup (Fin n → Lˣ)} (hΓ : Module.rank ℤ (Additive Γ) ≤ r) {J : Type*} [Finite J]
    {x z : J → Fin n → Lˣ} (hxΓ : ∀ j, x j ∈ Γ)
    (hz : ∀ j, absoluteLogHeightAff (fun i ↦ (z j i : L)) ≤
      φ (absoluteLogHeightAff (fun i ↦ (x j i : L))))
    (hsum : ∀ j, ∑ i, (x j i : L) * (z j i : L) = 1) :
    ∃ T : Finset (Submodule L (Fin n → L)), (T.card : ℝ) ≤ B ∧ (∀ V ∈ T, V ≠ ⊤) ∧
      ∀ j, ∃ V ∈ T, (fun i ↦ (x j i : L) * (z j i : L)) ∈ V := by
  obtain ⟨E, hE, S, Δ, x', z', hΔfg, hΔ, hΔx', hx', hz'⟩ :=
    Γ.exists_numberField_subgroup_pi_unit_rank_le (z := z) hxΓ
      (fun _ _ ↦ Algebra.IsAlgebraic.isAlgebraic _) fun _ _ ↦ Algebra.IsAlgebraic.isAlgebraic _
  obtain ⟨T, hTB, hTtop, hTcov⟩ := h E S Δ hΔfg (hΔ.trans hΓ)
  let ε : (Fin n → E) → Fin n → L := fun v ↦ algebraMap E L ∘ v
  refine ⟨T.image fun V : Submodule E (Fin n → E) ↦ span L (ε '' V),
    (Nat.cast_le.mpr Finset.card_image_le).trans hTB, ?_, fun j ↦ ?_⟩
  · simp only [Finset.mem_image, forall_exists_index, and_imp]
    rintro _ V hV rfl htop
    have := V.finrank_span_image_comp (algebraMap E L)
    rw [htop, finrank_top, Module.finrank_fin_fun] at this
    exact (finrank_lt (hTtop V hV)).ne (by rw [← this, Module.finrank_fin_fun])
  have hxz (i : Fin n) : algebraMap E L (((x' j i : Eˣ) : E) * ((z' j i : Eˣ) : E)) =
      (x j i : L) * (z j i : L) := by
    rw [map_mul, hx', hz']
  -- Heights are unchanged by the coordinatewise embedding `E → L`.
  have hh {a : Fin n → E} {b : Fin n → L} (hab : ∀ i, algebraMap E L (a i) = b i) :
      absoluteLogHeightAff a = absoluteLogHeightAff b := by
    rw [← absoluteLogHeightAff_comp (algebraMap E L)]
    exact congrArg _ (funext hab)
  have hsum' : ∑ i, ((x' j i : Eˣ) : E) * ((z' j i : Eˣ) : E) = 1 :=
    (algebraMap E L).injective (by simp only [map_sum, hxz, map_one, hsum j])
  obtain ⟨V, hV, hmem⟩ := hTcov (x' j) (hΔx' ▸ Subgroup.subset_closure (Set.mem_range_self j))
    (fun i ↦ (z' j i : Eˣ))
    (by rw [hh (hx' j), hh (hz' j)]; exact hz j) hsum'
  exact ⟨_, Finset.mem_image_of_mem _ hV, subset_span ⟨_, hmem, funext hxz⟩⟩

/-- **Reduction to `S`-units of number fields.** Let `L` be an algebraic extension of `ℚ`, let
`φ : ℝ → ℝ` and `B : ℝ`. Suppose that, for every number field `E ⊆ L`, every finite set `S` of
finite places of `E` and every finitely generated group `Δ` of `n`-tuples of `S`-units of `E` of
rank at most `r`, at most `B` proper subspaces of `Eⁿ` contain every product `x z` with `x ∈ Δ`,
`z ∈ (Eˣ)ⁿ`, `h_aff(z) ≤ φ(h_aff(x))` and `∑ xᵢ zᵢ = 1`. Then for every group `Γ ≤ (Lˣ)ⁿ` of
rank at most `r`, finitely generated or not, at most `B` proper subspaces of `Lⁿ` contain every
product `x z` with `x ∈ Γ`, `z ∈ (Lˣ)ⁿ`, `h_aff(z) ≤ φ(h_aff(x))` and `∑ xᵢ zᵢ = 1`.

For `n ≥ 2`, `L = AlgebraicClosure ℚ`, `φ(h) = n⁻¹ exp(-(5n)^(3n)) (1 + h)` and
`B = exp((5n)^(3n)(r + 1))` the conclusion is Theorem 2.1 of Evertse, Schlickewei and Schmidt, and
the hypothesis is its case of finitely generated groups of `S`-units over number fields. -/
theorem exists_subspaceCover_of_forall_numberField
    (h : ∀ (E : IntermediateField ℚ L) [NumberField E] (S : Finset (HeightOneSpectrum (𝓞 E)))
      (Δ : Subgroup (Fin n → (S : Set (HeightOneSpectrum (𝓞 E))).unit E)),
      Δ.FG → Module.rank ℤ (Additive Δ) ≤ r →
      ∃ T : Finset (Submodule E (Fin n → E)), (T.card : ℝ) ≤ B ∧ (∀ V ∈ T, V ≠ ⊤) ∧
        ∀ x ∈ Δ, ∀ z : Fin n → Eˣ,
          absoluteLogHeightAff (fun i ↦ ((z i : Eˣ) : E)) ≤
            φ (absoluteLogHeightAff (fun i ↦ ((x i : Eˣ) : E))) →
          ∑ i, ((x i : Eˣ) : E) * (z i : E) = 1 →
          ∃ V ∈ T, (fun i ↦ ((x i : Eˣ) : E) * (z i : E)) ∈ V)
    (Γ : Subgroup (Fin n → Lˣ)) (hΓ : Module.rank ℤ (Additive Γ) ≤ r) :
    ∃ T : Finset (Submodule L (Fin n → L)), (T.card : ℝ) ≤ B ∧ (∀ V ∈ T, V ≠ ⊤) ∧
      ∀ x ∈ Γ, ∀ z : Fin n → Lˣ,
        absoluteLogHeightAff (fun i ↦ (z i : L)) ≤ φ (absoluteLogHeightAff (fun i ↦ (x i : L))) →
        ∑ i, (x i : L) * (z i : L) = 1 →
        ∃ V ∈ T, (fun i ↦ (x i : L) * (z i : L)) ∈ V := by
  let A : Set (Fin n → L) := {y | ∃ x ∈ Γ, ∃ z : Fin n → Lˣ,
    absoluteLogHeightAff (fun i ↦ (z i : L)) ≤ φ (absoluteLogHeightAff (fun i ↦ (x i : L))) ∧
      ∑ i, (x i : L) * (z i : L) = 1 ∧ y = fun i ↦ (x i : L) * (z i : L)}
  -- Each finite subset of `A` is covered by at most `B` proper subspaces.
  have hfin (F : Set (Fin n → L)) (hFA : F ⊆ A) (hF : F.Finite) :
      ∃ T : Finset (Submodule L (Fin n → L)), (T.card : ℝ) ≤ B ∧ (∀ V ∈ T, V ≠ ⊤) ∧
        F ⊆ ⋃ V ∈ T, (V : Set (Fin n → L)) := by
    have := hF.to_subtype
    choose x hxΓ z hz hsum hy using fun y : F ↦ hFA y.property
    obtain ⟨T, hTB, hTtop, hT⟩ := exists_subspaceCover_of_finite h hΓ hxΓ hz hsum
    refine ⟨T, hTB, hTtop, fun y hyF ↦ ?_⟩
    obtain ⟨V, hV, hmem⟩ := hT ⟨y, hyF⟩
    have hmem' := Set.mem_biUnion hV hmem
    rw [← hy ⟨y, hyF⟩] at hmem'
    exact hmem'
  -- `B ≥ 0`, from the cover of the empty set.
  obtain ⟨T₀, hT₀, -⟩ := hfin ∅ (Set.empty_subset A) Set.finite_empty
  have hB : 0 ≤ B := (Nat.cast_nonneg _).trans hT₀
  -- By the finite character of covers, one cover by at most `⌊B⌋₊` subspaces serves for `A`.
  obtain ⟨T, hT, hTtop, hAT⟩ := (exists_subset_biUnion_iff_forall_finite (t := ⌊B⌋₊)).mpr
    fun F hFA hF ↦ by
      obtain ⟨T, hTB, hTtop, hFT⟩ := hfin F hFA hF
      exact ⟨T, Nat.le_floor hTB, hTtop, hFT⟩
  refine ⟨T, (Nat.cast_le.mpr hT).trans (Nat.floor_le hB), hTtop, fun x hx z hz hsum ↦ ?_⟩
  simpa using hAT ⟨x, hx, z, hz, hsum, rfl⟩

end TauCeti
