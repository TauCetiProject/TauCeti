module

public import TauCeti.NumberTheory.UnitEquation.Nondegenerate
public import TauCeti.RingTheory.FiniteType.PointSeparation

/-!
# Specializing finite families of unit-equation solutions

A finite family of nondegenerate solutions over a finite-type domain can be specialized
to an algebraically closed extension of its ground field, without identifying distinct
solutions or creating vanishing subsums. Extra finite data can be kept distinct at the
same time. Coordinates represented by units remain units under the specialization.

The finite-data argument uses one specialization that distinguishes all coordinate values
and all subsums, together with zero. Distinguishing individual coordinates from zero alone
would not suffice to distinguish solutions.

Applied to the subalgebra generated by finitely many solutions in a group `Γ ≤ (Kˣ)ⁿ` over a
domain `K`, their coefficients and the inverses of their coordinates, this transports finite
sets of solutions to an algebraically closed field `L` sharing a subfield with `K`, into a group
of rank at most that of `Γ`. Consequently a uniform bound for the number of nondegenerate
solutions in groups of rank at most `r` over `L` holds over `K` as well: bounds over
`AlgebraicClosure ℚ` hold over every field of characteristic zero. The bound over `L` is a
hypothesis; no finiteness theorem for unit equations is asserted here.

## Main statements

* `TauCeti.exists_algHom_injOn_and_comp_injective_and_isNondegenerateSolution`: specialization
  of distinct nondegenerate solutions over a finite-type domain.
* `TauCeti.exists_lift_rank_le_and_encard_le_isNondegenerateSolution`: a finite set of
  nondegenerate solutions in `Γ ≤ (Kˣ)ⁿ` specializes injectively to nondegenerate solutions over
  `L` in a group of no larger rank.
* `TauCeti.encard_isNondegenerateSolution_le_of_isAlgClosed`: transfer of uniform bounds for the
  number of nondegenerate solutions from `L` to `K`.

## References

* J.-H. Evertse, H. P. Schlickewei and W. M. Schmidt, *Linear equations in variables
  which lie in a multiplicative group*, Annals of Mathematics 155 (2002), §3,
  Lemmas 3.1–3.2, and the deduction of Theorem 1.1 for arbitrary fields of characteristic zero.
-/

public section

namespace TauCeti

variable {k A K ι σ : Type*} [Field k] [CommRing A] [IsDomain A]
  [Algebra k A] [Algebra.FiniteType k A] [Field K] [Algebra k K] [IsAlgClosed K]
  [Fintype ι] [Finite σ]

/-- A finite family of distinct nondegenerate solutions over a finite-type domain has a
specialization to any algebraically closed extension of the ground field that preserves
distinctness and nondegeneracy. The same specialization is injective on any prescribed
additional finite subset of the domain. No characteristic assumption is needed. -/
theorem exists_algHom_injOn_and_comp_injective_and_isNondegenerateSolution (a : ι → A)
    (x : σ → ι → A) (hx : Function.Injective x) (h : ∀ j, IsNondegenerateSolution a (x j))
    {t : Set A} (ht : t.Finite) :
    ∃ f : A →ₐ[k] K, Set.InjOn f t ∧
      Function.Injective (fun j ↦ f ∘ x j) ∧
      ∀ j, IsNondegenerateSolution (f ∘ a) (f ∘ x j) := by
  let c : Set A := Set.range fun p : σ × ι ↦ x p.1 p.2
  let b : Set A := Set.range fun p : σ × Finset ι ↦ ∑ i ∈ p.2, a i * x p.1 i
  have hs : (t ∪ c ∪ b).Finite := (ht.union (Set.finite_range _)).union (Set.finite_range _)
  obtain ⟨f, hf⟩ := hs.exists_algHom_injOn (k := k) (K := K)
  have hc (j : σ) (i : ι) : x j i ∈ t ∪ c ∪ b := Or.inl (Or.inr ⟨(j, i), rfl⟩)
  have hb (j : σ) (I : Finset ι) : ∑ i ∈ I, a i * x j i ∈ t ∪ c ∪ b := Or.inr ⟨(j, I), rfl⟩
  refine ⟨f, hf.mono (Set.subset_union_left.trans Set.subset_union_left), ?_, fun j ↦ ?_⟩
  · intro j l hjl
    apply hx
    exact funext fun i ↦ hf (hc j i) (hc l i) (congrFun hjl i)
  · exact (h j).map f.toRingHom (hf.mono (by rintro z ⟨I, rfl⟩; exact hb j I))

section Transfer

universe u v w

variable {K : Type u} {L : Type w} {ι : Type v} [CommRing K] [IsDomain K] [Field L]
  [IsAlgClosed L] [Fintype ι]

/-- Finitely many distinct nondegenerate solutions of `∑ aᵢxᵢ = 1` in a group `Γ ≤ (Kˣ)ⁿ`
specialize to at least as many distinct nondegenerate solutions of an equation `∑ bᵢyᵢ = 1`
over an algebraically closed field `L`, in a group `Δ ≤ (Lˣ)ⁿ` of rank at most that of `Γ`.
Here `K` is a domain and `L` a field, both algebras over a common field `k`; for a field `K` of
characteristic zero one may take `k = ℚ` and `L = AlgebraicClosure ℚ`. -/
theorem exists_lift_rank_le_and_encard_le_isNondegenerateSolution (k : Type*) [Field k]
    [Algebra k K] [Algebra k L] (a : ι → K)
    (Γ : Subgroup (ι → Kˣ)) {s : Set (ι → Kˣ)} (hs : s.Finite)
    (hsΓ : s ⊆ {x | x ∈ Γ ∧ IsNondegenerateSolution a fun i ↦ (x i : K)}) :
    ∃ (b : ι → L) (Δ : Subgroup (ι → Lˣ)),
      Cardinal.lift.{max u v} (Module.rank ℤ (Additive Δ)) ≤
        Cardinal.lift.{max w v} (Module.rank ℤ (Additive Γ)) ∧
      s.encard ≤ {y | y ∈ Δ ∧ IsNondegenerateSolution b fun i ↦ (y i : L)}.encard := by
  have := hs.to_subtype
  -- The coefficients, and the coordinates of `s` with their inverses, generate a finite-type
  -- subalgebra `A` of `K` over which the solutions in `s` are defined.
  let T : Set K := Set.range a ∪ Set.range (fun p : s × ι ↦ ((p.1 : ι → Kˣ) p.2 : K)) ∪
    Set.range (fun p : s × ι ↦ ((((p.1 : ι → Kˣ) p.2)⁻¹ : Kˣ) : K))
  have hT : T.Finite := ((Set.finite_range _).union (Set.finite_range _)).union
    (Set.finite_range _)
  let A := Algebra.adjoin k T
  have : Algebra.FiniteType k A := Algebra.FiniteType.adjoin_of_finite hT
  have hval (p : s) (i : ι) : ((p : ι → Kˣ) i : K) ∈ A :=
    Algebra.subset_adjoin (Or.inl (Or.inr ⟨(p, i), rfl⟩))
  have hinv (p : s) (i : ι) : ((((p : ι → Kˣ) i)⁻¹ : Kˣ) : K) ∈ A :=
    Algebra.subset_adjoin (Or.inr ⟨(p, i), rfl⟩)
  let aA : ι → A := fun i ↦ ⟨a i, Algebra.subset_adjoin (Or.inl (Or.inl ⟨i, rfl⟩))⟩
  let u : s → ι → Aˣ := fun p i ↦ ⟨⟨_, hval p i⟩, ⟨_, hinv p i⟩,
    Subtype.ext (Units.mul_inv _), Subtype.ext (Units.inv_mul _)⟩
  let ψ : (ι → Aˣ) →* (ι → Kˣ) := MonoidHom.compLeft (Units.map (A.val : A →* K)) ι
  have hψ : Function.Injective ψ := (Units.map_injective Subtype.val_injective).comp_left
  have hψu (p : s) : ψ (u p) = p := funext fun i ↦ Units.ext rfl
  -- Specialize the distinct nondegenerate solutions `u p` over `A` into `L`.
  obtain ⟨f, -, hf, hnd⟩ := exists_algHom_injOn_and_comp_injective_and_isNondegenerateSolution
    (k := k) (K := L) aA (fun p i ↦ (u p i : A))
    (fun p q hpq ↦ Subtype.ext <| hψu p ▸ hψu q ▸ funext fun i ↦ Units.ext <|
      congrArg Subtype.val (congrFun hpq i))
    (fun p ↦ (isNondegenerateSolution_map_iff (φ := A.val.toRingHom)
      Subtype.val_injective).mp (hsΓ p.property).2) Set.finite_empty
  let χ : (ι → Aˣ) →* (ι → Lˣ) := MonoidHom.compLeft (Units.map (f : A →* L)) ι
  refine ⟨f ∘ aA, (Γ.comap ψ).map χ, ?_, ?_⟩
  · -- `Γ.comap ψ` embeds into `Γ` and surjects onto its image under `χ`.
    have h₁ := (ψ.subgroupComap Γ).toAdditive.toIntLinearMap.rank_le_of_injective
      (Additive.ofMul.injective.comp ((ψ.subgroupComap_injective Γ hψ).comp
        Additive.toMul.injective))
    have h₂ := (χ.subgroupMap (Γ.comap ψ)).toAdditive.toIntLinearMap.lift_rank_le_of_surjective
      (Additive.ofMul.surjective.comp ((χ.subgroupMap_surjective _).comp
        Additive.toMul.surjective))
    exact h₂.trans (Cardinal.lift_le.mpr h₁)
  · have hinj : Function.Injective (fun p ↦ χ (u p)) := fun p q hpq ↦
      hf (funext fun i ↦ congrArg Units.val (congrFun hpq i))
    rw [← ENat.card_coe_set_eq, ← hinj.encard_range]
    refine Set.encard_le_encard ?_
    rintro _ ⟨p, rfl⟩
    exact ⟨⟨u p, by simp [hψu, (hsΓ p.property).1], rfl⟩, hnd p⟩

/-- Uniform bounds for nondegenerate solutions of `∑ aᵢxᵢ = 1` in groups of rank at most `r`
transfer from an algebraically closed field `L` to every domain `K`, where `K` and `L` are
algebras over a common field `k`. In particular, with `k = ℚ`, a bound over
`AlgebraicClosure ℚ` holds over every field of characteristic zero. The bound over `L` is a
hypothesis; it is not proved here. -/
theorem encard_isNondegenerateSolution_le_of_isAlgClosed (k : Type*) [Field k] [Algebra k K]
    [Algebra k L] {r : ℕ} {B : ℕ∞}
    (hB : ∀ (b : ι → L) (Δ : Subgroup (ι → Lˣ)), Module.rank ℤ (Additive Δ) ≤ r →
      {y | y ∈ Δ ∧ IsNondegenerateSolution b fun i ↦ (y i : L)}.encard ≤ B)
    (a : ι → K) (Γ : Subgroup (ι → Kˣ)) (hΓ : Module.rank ℤ (Additive Γ) ≤ r) :
    {x | x ∈ Γ ∧ IsNondegenerateSolution a fun i ↦ (x i : K)}.encard ≤ B := by
  -- It suffices to bound the finite subsets of the solution set.
  by_contra! hlt
  lift B to ℕ using hlt.ne_top
  obtain ⟨s, hsS, hs⟩ := Set.exists_subset_encard_eq (Order.add_one_le_of_lt hlt)
  obtain ⟨b, Δ, hΔ, hsΔ⟩ := exists_lift_rank_le_and_encard_le_isNondegenerateSolution k (L := L)
    a Γ (Set.finite_of_encard_eq_coe (by rw [hs]; norm_cast)) hsS
  have hΔr : Module.rank ℤ (Additive Δ) ≤ r :=
    Cardinal.lift_le_nat_iff.mp (hΔ.trans (Cardinal.lift_le_nat_iff.mpr hΓ))
  have := hs.symm.trans_le (hsΔ.trans (hB b Δ hΔr))
  norm_cast at this
  omega

end Transfer

end TauCeti
