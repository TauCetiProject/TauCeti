/-!
# Solutions of homogeneous unit equations lie in finitely many subspaces

Let `K` be a field, `Γ` a subgroup of `Kˣ` and `a₁, …, aₙ` nonzero elements of `K`. The solutions
`x ∈ Γⁿ` of the homogeneous equation `a₁x₁ + ⋯ + aₙxₙ = 0` lie on the hyperplane
`H = {y ∈ Kⁿ | ∑ aᵢyᵢ = 0}`, and they are closed under scaling by `Γ`. When `n ≥ 3` and the unit
equation theorem holds for `Γ` in `n - 1` unknowns, they lie in the union of finitely many proper
subspaces of `H`. This file proves that deduction, which splits the solutions in two classes.

* A *degenerate* solution has a vanishing subsum `∑ i ∈ I, aᵢxᵢ = 0` over a nonempty proper set
  `I` of indices. It lies in the subspace of `H` cut out by this second linear form, which is a
  proper subspace because the two forms are not proportional. There are at most `2 ^ n` such
  subspaces, and this part needs neither `Γ` nor a finiteness theorem.
* A *nondegenerate* solution has no such vanishing subsum. Dividing it by its coordinate `x_{i₀}`
  gives the normalized solution `x / x_{i₀}`, whose other coordinates form a nondegenerate
  solution of the inhomogeneous equation `∑_{i ≠ i₀} (-aᵢ / a_{i₀}) yᵢ = 1` in `n - 1` unknowns.
  If that equation has only finitely many nondegenerate solutions in `Γⁿ⁻¹`, there are finitely
  many normalized solutions, and every nondegenerate solution lies on the line through one of
  them. For `n ≥ 3` such a line is a proper subspace of `H`.

The finiteness of nondegenerate solutions enters as a hypothesis, stated exactly as the unit
equation theorem for `Γ` in `n - 1` unknowns. For a finitely generated `Γ` in characteristic zero
it is the finiteness theorem for nondegenerate solutions of unit equations (Evertse, Theorem 8.13;
made uniform in the rank of `Γ` by Evertse, Schlickewei and Schmidt), which this file does not
prove. It fails in positive characteristic:
over `𝔽_p(t)` with `Γ` generated by `t` and `1 - t`, the equation `x + y = 1` has the infinitely
many solutions `(t ^ (p ^ k), (1 - t) ^ (p ^ k))`.

The bound `n ≥ 3` is necessary: for `n = 2` the hyperplane `H` is a line, its only proper subspace
is `0`, and in `Γ = ⟨2⟩ ≤ ℚˣ` the equation `x₁ - x₂ = 0` has the infinitely many nonzero solutions
`(2 ^ k, 2 ^ k)`.

## Main results

* `TauCeti.exists_finset_submodule_lt_ker_of_not_isNondegenerateHomogeneousSolution`: for nonzero
  coefficients, at most `2 ^ n` proper subspaces of the hyperplane `∑ aᵢyᵢ = 0` contain every
  degenerate solution of `∑ aᵢyᵢ = 0`.
* `TauCeti.finite_setOf_apply_eq_one_and_isNondegenerateHomogeneousSolution`: if the unit equation
  theorem holds for `Γ` in `n - 1` unknowns, there are finitely many nondegenerate solutions
  `y ∈ Γⁿ` of `∑ aᵢyᵢ = 0` with `y_{i₀} = 1`.
* `TauCeti.exists_finset_submodule_lt_ker_of_sum_mul_eq_zero`: under the same hypothesis and for
  `n ≥ 3`, all solutions `x ∈ Γⁿ` of `∑ aᵢxᵢ = 0` lie in finitely many proper subspaces of the
  hyperplane `∑ aᵢyᵢ = 0`.

## References

* J.-H. Evertse, *Diophantine Approximation*, lecture notes (2019), Chapter 8, Theorem 8.13 and
  §8.3.
* J.-H. Evertse, H. P. Schlickewei and W. M. Schmidt, *Linear equations in variables which lie in
  a multiplicative group*, Ann. of Math. 155 (2002), 807–836.
-/

public section

open Finset

namespace TauCeti

variable {ι : Type*} [Fintype ι]

section CommRing

variable {R : Type*} [CommRing R] {a : ι → R}

/-- For indices `j` and `k`, the vector with `a k` at `j`, minus the one with `a j` at `k`, lies
on the hyperplane `∑ aᵢyᵢ = 0`. It witnesses that the subspaces of this hyperplane constructed
below are proper. -/
private theorem single_sub_single_mem_ker [DecidableEq ι] (j k : ι) :
    Pi.single j (a k) - Pi.single k (a j) ∈ LinearMap.ker (Fintype.linearCombination R a) := by
  simp [Fintype.linearCombination_apply, mul_sub, sum_sub_distrib, Pi.single_apply, mul_comm]

variable [NoZeroDivisors R]

/-- **Degenerate solutions lie in boundedly many proper subspaces of the hyperplane.** If all `aᵢ`
are nonzero, there are at most `2 ^ n` proper subspaces of the hyperplane `∑ aᵢyᵢ = 0` in `Rⁿ`,
`n` the number of unknowns, such that every solution of `∑ aᵢyᵢ = 0` that is not nondegenerate
lies in one of them. They are the intersections of the hyperplane with the kernels of the linear
forms `y ↦ ∑ i ∈ I, aᵢyᵢ` for nonempty proper sets `I` of indices. -/
theorem exists_finset_submodule_lt_ker_of_not_isNondegenerateHomogeneousSolution
    (ha : ∀ i, a i ≠ 0) :
    ∃ T : Finset (Submodule R (ι → R)), #T ≤ 2 ^ Fintype.card ι ∧
      (∀ V ∈ T, V < LinearMap.ker (Fintype.linearCombination R a)) ∧
      ∀ y : ι → R, ∑ i, a i * y i = 0 → ¬ IsNondegenerateHomogeneousSolution a y →
        ∃ V ∈ T, y ∈ V := by
  classical
  -- The linear form `y ↦ ∑ i ∈ I, aᵢ yᵢ`.
  let f : Finset ι → (ι → R) →ₗ[R] R := fun I ↦ ∑ i ∈ I, a i • LinearMap.proj i
  have hf : ∀ I y, f I y = ∑ i ∈ I, a i * y i := fun I y ↦ by
    simp [f, LinearMap.sum_apply]
  let s : Finset (Finset ι) := univ.filter fun I ↦ I.Nonempty ∧ I ≠ univ
  refine ⟨s.image fun I ↦ LinearMap.ker (Fintype.linearCombination R a) ⊓ LinearMap.ker (f I),
    ?_, ?_, ?_⟩
  · calc _ ≤ #s := card_image_le
      _ ≤ #(univ : Finset (Finset ι)) := card_filter_le _ _
      _ = 2 ^ Fintype.card ι := by rw [card_univ, Fintype.card_finset]
  · simp only [s, mem_image, mem_filter, mem_univ, true_and]
    rintro _ ⟨I, ⟨⟨j, hj⟩, hIu⟩, rfl⟩
    obtain ⟨k, hk⟩ : ∃ k, k ∉ I := by
      by_contra! hall
      exact hIu (eq_univ_of_forall hall)
    refine IsConcreteLE.lt_iff_le_and_exists.mpr
      ⟨inf_le_left, _, single_sub_single_mem_ker j k, fun hmem ↦ ?_⟩
    -- The form `∑ i ∈ I, aᵢ yᵢ` takes the value `aⱼ aₖ ≠ 0` at the witness.
    have h0 := LinearMap.mem_ker.mp (Submodule.mem_inf.mp hmem).2
    rw [hf] at h0
    simp [mul_sub, Pi.single_apply, hj, hk] at h0
    exact h0.elim (ha j) (ha k)
  · intro y h0 hy
    obtain ⟨I, hI, hIu, hI0⟩ :
        ∃ I : Finset ι, I.Nonempty ∧ I ≠ univ ∧ ∑ i ∈ I, a i * y i = 0 := by
      simpa [isNondegenerateHomogeneousSolution_iff, h0] using hy
    refine ⟨_, mem_image_of_mem _ (mem_filter.mpr ⟨mem_univ I, hI, hIu⟩),
      Submodule.mem_inf.mpr ⟨?_, LinearMap.mem_ker.mpr ((hf I y).trans hI0)⟩⟩
    simpa [Fintype.linearCombination_apply, mul_comm] using h0

end CommRing

section Field

variable {K : Type*} [Field K] {a : ι → K}

/-- **Finiteness of normalized nondegenerate homogeneous solutions.** Let `Γ ≤ Kˣ` satisfy the unit
equation theorem in `n - 1` unknowns: every equation `∑ cₘzₘ = 1` with nonzero coefficients has
only finitely many nondegenerate solutions `z ∈ Γⁿ⁻¹`. Then, for nonzero `aᵢ` and an index `i₀`,
the equation `∑ aᵢyᵢ = 0` has only finitely many nondegenerate solutions `y ∈ Γⁿ` with
`y_{i₀} = 1`. Every nondegenerate solution in `Γⁿ` is a multiple of one of them. -/
theorem finite_setOf_apply_eq_one_and_isNondegenerateHomogeneousSolution (ha : ∀ i, a i ≠ 0)
    (Γ : Subgroup Kˣ)
    (hΓ : ∀ c : Fin (Fintype.card ι - 1) → K, (∀ m, c m ≠ 0) →
      {z : Fin (Fintype.card ι - 1) → Γ |
        IsNondegenerateSolution c fun m ↦ ((z m : Kˣ) : K)}.Finite)
    (i₀ : ι) :
    {y : ι → Γ | y i₀ = 1 ∧
      IsNondegenerateHomogeneousSolution a fun i ↦ ((y i : Kˣ) : K)}.Finite := by
  classical
  -- Index the unknowns other than `i₀` by `Fin (card ι - 1)`.
  let e : Fin (Fintype.card ι - 1) ≃ ↥(univ.erase i₀) := (Fintype.equivFinOfCardEq
    (by rw [Fintype.card_coe, card_erase_of_mem (mem_univ _), card_univ])).symm
  refine Set.Finite.of_injOn (f := fun y m ↦ y (e m)) ?_ ?_
    (hΓ (fun m ↦ -a (e m) / a i₀) fun m ↦ div_ne_zero (neg_ne_zero.mpr (ha _)) (ha i₀))
  · rintro y ⟨hy1, hy⟩
    have h2 : 2 ≤ #(univ : Finset ι) := by
      -- With a single unknown, `a_{i₀} y_{i₀} = a_{i₀} ≠ 0` cannot vanish.
      by_contra! h
      have huniv : (univ : Finset ι) = {i₀} := eq_singleton_iff_unique_mem.mpr
        ⟨mem_univ _, fun j _ ↦ card_le_one.mp (by omega) _ (mem_univ _) _ (mem_univ _)⟩
      have hsum := hy.sum_eq_zero
      rw [huniv, sum_singleton, hy1] at hsum
      simp [ha i₀] at hsum
    -- The whole sum is a minimal vanishing subsum; divide it by its term at `i₀`.
    have := (isNondegenerateSolution_div_of_minimal (mem_univ i₀) h2 hy.sum_eq_zero
      fun J hJ hne ↦ hy.subsum_ne_zero hne hJ.ne).comp_equiv e
    simpa [hy1, Function.comp_def] using this
  · rintro y ⟨hy1, -⟩ y' ⟨hy1', -⟩ h
    funext i
    by_cases hi : i = i₀
    · rw [hi, hy1, hy1']
    · simpa using congrFun h (e.symm ⟨i, mem_erase.mpr ⟨hi, mem_univ i⟩⟩)

/-- **Solutions of a homogeneous unit equation lie in finitely many proper subspaces.** Let
`Γ ≤ Kˣ` satisfy the unit equation theorem in `n - 1` unknowns, `n ≥ 3` the number of unknowns:
every equation `∑ cₘzₘ = 1` with nonzero coefficients has only finitely many nondegenerate
solutions `z ∈ Γⁿ⁻¹`. Then, for nonzero `aᵢ`, finitely many proper subspaces of the hyperplane
`∑ aᵢyᵢ = 0` in `Kⁿ` contain every solution `x ∈ Γⁿ` of `∑ aᵢxᵢ = 0`. -/
theorem exists_finset_submodule_lt_ker_of_sum_mul_eq_zero (ha : ∀ i, a i ≠ 0)
    (hι : 3 ≤ Fintype.card ι) (Γ : Subgroup Kˣ)
    (hΓ : ∀ c : Fin (Fintype.card ι - 1) → K, (∀ m, c m ≠ 0) →
      {z : Fin (Fintype.card ι - 1) → Γ |
        IsNondegenerateSolution c fun m ↦ ((z m : Kˣ) : K)}.Finite) :
    ∃ T : Finset (Submodule K (ι → K)),
      (∀ V ∈ T, V < LinearMap.ker (Fintype.linearCombination K a)) ∧
      ∀ x : ι → Γ, ∑ i, a i * ((x i : Kˣ) : K) = 0 →
        ∃ V ∈ T, (fun i ↦ ((x i : Kˣ) : K)) ∈ V := by
  classical
  obtain ⟨j, k, l, hjk, hjl, hkl⟩ := Fintype.two_lt_card_iff.mp hι
  obtain ⟨T₀, -, hT₀, hcov₀⟩ :=
    exists_finset_submodule_lt_ker_of_not_isNondegenerateHomogeneousSolution ha
  have hfin := finite_setOf_apply_eq_one_and_isNondegenerateHomogeneousSolution ha Γ hΓ j
  refine ⟨T₀ ∪ hfin.toFinset.image fun y ↦ K ∙ fun i ↦ ((y i : Kˣ) : K), fun V hV ↦ ?_,
    fun x hx ↦ ?_⟩
  · rcases mem_union.mp hV with hV | hV
    · exact hT₀ V hV
    -- The line through a normalized nondegenerate solution `y` lies on the hyperplane, and misses
    -- the witness, which vanishes at `l` while `y` does not.
    obtain ⟨y, hy, rfl⟩ := mem_image.mp hV
    obtain ⟨-, hy⟩ := hfin.mem_toFinset.mp hy
    refine IsConcreteLE.lt_iff_le_and_exists.mpr
      ⟨?_, _, single_sub_single_mem_ker j k, fun hmem ↦ ?_⟩
    · rw [Submodule.span_singleton_le_iff_mem, LinearMap.mem_ker]
      simpa [Fintype.linearCombination_apply, mul_comm] using hy.sum_eq_zero
    · obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
      have hl := congrFun hc l
      have hj := congrFun hc j
      simp only [Pi.smul_apply, smul_eq_mul, Pi.sub_apply, Pi.single_apply, hjl.symm, hkl.symm,
        ite_false, sub_zero, mul_eq_zero, Units.ne_zero, or_false] at hl
      exact ha k (by simpa [hl, hjk] using hj.symm)
  · by_cases hnd : IsNondegenerateHomogeneousSolution a fun i ↦ ((x i : Kˣ) : K)
    · -- A nondegenerate solution is a multiple of its normalization `x / x_j`.
      let y : ι → Γ := fun i ↦ x i * (x j)⁻¹
      have hy : (fun i ↦ ((y i : Kˣ) : K)) = ((x j : Kˣ) : K)⁻¹ • fun i ↦ ((x i : Kˣ) : K) := by
        ext i
        simp [y, mul_comm]
      have hmem : y ∈ {y : ι → Γ | y j = 1 ∧
          IsNondegenerateHomogeneousSolution a fun i ↦ ((y i : Kˣ) : K)} :=
        ⟨mul_inv_cancel _, by rw [hy]; exact hnd.smul (inv_ne_zero (Units.ne_zero _))⟩
      refine ⟨_, mem_union_right _ (mem_image_of_mem _ (hfin.mem_toFinset.mpr hmem)), ?_⟩
      refine Submodule.mem_span_singleton.mpr ⟨((x j : Kˣ) : K), ?_⟩
      rw [hy, smul_smul, mul_inv_cancel₀ (Units.ne_zero _), one_smul]
    · obtain ⟨V, hV, hxV⟩ := hcov₀ _ hx hnd
      exact ⟨V, mem_union_left _ hV, hxV⟩

end Field

end TauCeti
