module

public import TauCeti.NumberTheory.Height.Affine
public import TauCeti.NumberTheory.Height.NumberField
import TauCeti.NumberTheory.NumberField.AdjoinPair

/-!
# The absolute projective height of a tuple

Mathlib's multiplicative height `Height.mulHeight x` of a finite tuple `x` over a number field `K`
is relative to `K`, and `NumberField.absMulHeight₁` turns the scalar height into an absolute
quantity by computing it in `ℚ(x)` and taking the `[ℚ(x) : ℚ]`-th root. This file does the same
for tuples: for a finite tuple `x` in a field `F` of characteristic zero whose coordinates are
algebraic, `absoluteProjectiveTupleHeight x` is the relative height of `x` in the number field
`ℚ(x)` generated by the coordinates, raised to the power `1 / [ℚ(x) : ℚ]`. A tuple with a
transcendental coordinate gets the junk value `1`. The zero tuple has value `1`, following the
projective convention of `Height.mulHeight_zero`.

The absolute height is the field-independent height of a point of projective space over an
algebraic closure of `ℚ`: it may be computed in any number field containing the coordinates, it
is invariant under homomorphisms of fields of characteristic zero, and it is unchanged by nonzero
algebraic scalars.
The absolute height of an element `x` is that of the pair `(x, 1)`.

Prepending the coordinate `1` gives the absolute affine logarithmic height
`TauCeti.absoluteLogHeightAff x = log H(1, x)` of a tuple `x : Fin n → F`, the absolute
counterpart of the relative affine height `Height.logHeightAff`. It is not invariant under
scaling, and is the height that measures perturbations in quantitative forms of the subspace
theorem.

## Main definitions

* `TauCeti.absoluteProjectiveTupleHeight`: the absolute multiplicative height of a finite tuple.
* `TauCeti.absoluteLogHeightAff`: the absolute affine logarithmic height of a tuple.

## Main results

* `TauCeti.absoluteProjectiveTupleHeight_eq`: for a tuple `x` in a number field `K`, the absolute
  height is `H_K(x) ^ (1 / [K : ℚ])`.
* `TauCeti.absoluteProjectiveTupleHeight_le_of_forall_le`: a nonzero tuple of algebraic integers
  whose coordinates are at most `c` at every infinite place has absolute height at most `c`.
* `TauCeti.absoluteProjectiveTupleHeight_comp`: invariance under homomorphisms of fields of
  characteristic zero.
* `TauCeti.absoluteProjectiveTupleHeight_smul`: invariance under nonzero algebraic scalars.
* `TauCeti.absoluteProjectiveTupleHeight_pow`: `H(x ^ n) = H(x) ^ n`, coordinatewise.
* `TauCeti.absMulHeight₁_eq_absoluteProjectiveTupleHeight`: `H(x) = H(x, 1)`.
* `TauCeti.absoluteLogHeightAff_eq`: over a number field `K`,
  `h_aff(x) = Height.logHeight (Fin.cons 1 x) / [K : ℚ]`.
* `TauCeti.absoluteLogHeightAff_eq_logHeightAff_div`: over a number field `K`,
  `h_aff(x) = Height.logHeightAff x / [K : ℚ]`.
* `TauCeti.absoluteLogHeightAff_fin_one`: `h_aff(x) = h(x)` for a one-element tuple.

## References

* X. Wu, *Diophantine geometry, week 08: arithmetic heights* (2023), §2, Lemma 2.5 and
  Definition 2.7.
* J.-H. Evertse, H. P. Schlickewei and W. M. Schmidt, *Linear equations in variables which lie
  in a multiplicative group*, Ann. of Math. 155 (2002), §2, for the affine height of a tuple.
-/

public section

open Height IntermediateField Module NumberField

namespace TauCeti

variable {F F' : Type*} [Field F] [CharZero F] [Field F'] [CharZero F']
variable {ι : Type*} [Finite ι]

open Classical in
/-- The absolute multiplicative height of a finite tuple `x` in a field of characteristic zero.
If every coordinate is algebraic, it is the relative height of `x` in the number field `ℚ(x)`
generated by the coordinates, raised to the power `1 / [ℚ(x) : ℚ]`; otherwise it is the junk
value `1`. The zero tuple has value `1`. -/
noncomputable def absoluteProjectiveTupleHeight (x : ι → F) : ℝ :=
  if hx : ∀ i, IsIntegral ℚ (x i) then
    haveI : FiniteDimensional ℚ (adjoin ℚ (Set.range x)) :=
      finiteDimensional_adjoin (by rintro _ ⟨i, rfl⟩; exact hx i)
    haveI : NumberField (adjoin ℚ (Set.range x)) := {}
    mulHeight (fun i ↦ (⟨x i, subset_adjoin ℚ _ (Set.mem_range_self i)⟩ :
        adjoin ℚ (Set.range x))) ^ (finrank ℚ (adjoin ℚ (Set.range x)) : ℝ)⁻¹
  else 1

/-- A tuple with a transcendental coordinate has the junk absolute height `1`. -/
theorem absoluteProjectiveTupleHeight_of_not_isIntegral {x : ι → F} {i : ι}
    (hi : ¬IsIntegral ℚ (x i)) : absoluteProjectiveTupleHeight x = 1 :=
  dite_eq_right fun hx ↦ hi (hx i)

/-- **Computation in a number field.** For a tuple `x` in a number field `K`, the absolute height
of `x` is its height relative to `K` raised to the power `1 / [K : ℚ]`. -/
theorem absoluteProjectiveTupleHeight_eq {K : Type*} [Field K] [NumberField K] (x : ι → K) :
    absoluteProjectiveTupleHeight x = mulHeight x ^ (finrank ℚ K : ℝ)⁻¹ := by
  have hx (i : ι) : IsIntegral ℚ (x i) := .of_finite ℚ (x i)
  have : FiniteDimensional ℚ (adjoin ℚ (Set.range x)) :=
    finiteDimensional_adjoin (by rintro _ ⟨i, rfl⟩; exact hx i)
  have : NumberField (adjoin ℚ (Set.range x)) := {}
  -- `x` is the image of the tuple `y` in `ℚ(x)` under the inclusion `ℚ(x) → K`.
  let y : ι → adjoin ℚ (Set.range x) := fun i ↦ ⟨x i, subset_adjoin ℚ _ (Set.mem_range_self i)⟩
  have hy : mulHeight x = mulHeight y ^ finrank (adjoin ℚ (Set.range x)) K :=
    mulHeight_algebraMap (L := K) y
  rw [absoluteProjectiveTupleHeight, dite_eq_left hx, hy,
    ← finrank_mul_finrank ℚ (adjoin ℚ (Set.range x)) K, ← Real.rpow_natCast,
    ← Real.rpow_mul (mulHeight_pos _).le]
  congr 1
  have : (finrank (adjoin ℚ (Set.range x)) K : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr finrank_pos.ne'
  push_cast
  field_simp

/-- A nonzero tuple of algebraic integers whose coordinates have absolute value at most `c` at
every infinite place has absolute height at most `c`. -/
theorem absoluteProjectiveTupleHeight_le_of_forall_le {K : Type*} [Field K] [NumberField K]
    {y : ι → 𝓞 K} (hy : y ≠ 0) {c : ℝ} (hc : ∀ i (w : InfinitePlace K), w (y i) ≤ c) :
    absoluteProjectiveTupleHeight (fun i ↦ (y i : K)) ≤ c := by
  obtain ⟨i₀, -⟩ := Function.ne_iff.mp hy
  have hc0 : 0 ≤ c := (apply_nonneg _ _).trans (hc i₀ (Classical.arbitrary _))
  rw [absoluteProjectiveTupleHeight_eq]
  calc mulHeight (fun i ↦ (y i : K)) ^ (finrank ℚ K : ℝ)⁻¹
      ≤ (c ^ finrank ℚ K) ^ (finrank ℚ K : ℝ)⁻¹ :=
        Real.rpow_le_rpow (mulHeight_pos _).le (mulHeight_le_pow_finrank_of_forall_le hy hc)
          (by positivity)
    _ = c := Real.pow_rpow_inv_natCast hc0 finrank_pos.ne'

/-- The absolute height is invariant under homomorphisms of fields of characteristic zero. -/
@[simp]
theorem absoluteProjectiveTupleHeight_comp (f : F →+* F') (x : ι → F) :
    absoluteProjectiveTupleHeight (f ∘ x) = absoluteProjectiveTupleHeight x := by
  have hint (i : ι) : IsIntegral ℚ (f (x i)) ↔ IsIntegral ℚ (x i) :=
    isIntegral_algHom_iff f.toRatAlgHom f.injective
  by_cases hx : ∀ i, IsIntegral ℚ (x i)
  · have hfx (i : ι) : IsIntegral ℚ ((f ∘ x) i) := (hint i).mpr (hx i)
    let E := adjoin ℚ (Set.range x)
    let E' := adjoin ℚ (Set.range (f ∘ x))
    have : FiniteDimensional ℚ E := finiteDimensional_adjoin (by rintro _ ⟨i, rfl⟩; exact hx i)
    have : NumberField E := {}
    have : FiniteDimensional ℚ E' := finiteDimensional_adjoin (by rintro _ ⟨i, rfl⟩; exact hfx i)
    have : NumberField E' := {}
    have hE : E.map f.toRatAlgHom = E' := by
      rw [adjoin_map, ← Set.range_comp]
      rfl
    -- `f` restricts to an isomorphism `ℚ(x) ≃ ℚ(f ∘ x)` sending `x` to `f ∘ x`.
    let e : E ≃ₐ[ℚ] E' := (equivMap E f.toRatAlgHom).trans (equivOfEq hE)
    rw [absoluteProjectiveTupleHeight, dite_eq_left hfx, absoluteProjectiveTupleHeight,
      dite_eq_left hx, ← e.toLinearEquiv.finrank_eq, ← mulHeight_ringEquiv e.toRingEquiv]
    -- `e` sends `⟨x i, _⟩` to `⟨f (x i), _⟩`.
    refine congrArg (· ^ _) (congrArg mulHeight (funext fun i ↦ Subtype.ext ?_))
    simp [e]
  · obtain ⟨i, hi⟩ := not_forall.mp hx
    rw [absoluteProjectiveTupleHeight_of_not_isIntegral hi,
      absoluteProjectiveTupleHeight_of_not_isIntegral (i := i) ((hint i).not.mpr hi)]

/-- The zero tuple has absolute height `1`. -/
@[simp]
theorem absoluteProjectiveTupleHeight_zero : absoluteProjectiveTupleHeight (0 : ι → F) = 1 := by
  have h : (0 : ι → F) = algebraMap ℚ F ∘ (0 : ι → ℚ) := by
    ext
    simp
  rw [h, absoluteProjectiveTupleHeight_comp,
    absoluteProjectiveTupleHeight_eq, mulHeight_zero, Real.one_rpow]

/-- The absolute height of a tuple is at least `1`. -/
theorem one_le_absoluteProjectiveTupleHeight (x : ι → F) :
    1 ≤ absoluteProjectiveTupleHeight x := by
  by_cases hx : ∀ i, IsIntegral ℚ (x i)
  · obtain ⟨E, _, y, rfl⟩ := exists_numberField_comp fun i ↦ (hx i).isAlgebraic
    rw [absoluteProjectiveTupleHeight_comp, absoluteProjectiveTupleHeight_eq]
    exact Real.one_le_rpow (one_le_mulHeight y) (inv_nonneg.mpr (Nat.cast_nonneg _))
  · obtain ⟨i, hi⟩ := not_forall.mp hx
    exact (absoluteProjectiveTupleHeight_of_not_isIntegral hi).ge

/-- The absolute height of a tuple is positive. -/
theorem absoluteProjectiveTupleHeight_pos (x : ι → F) : 0 < absoluteProjectiveTupleHeight x :=
  zero_lt_one.trans_le (one_le_absoluteProjectiveTupleHeight x)

/-- The absolute height is invariant under reordering the coordinates. -/
@[simp]
theorem absoluteProjectiveTupleHeight_comp_equiv {ι' : Type*} [Finite ι'] (e : ι ≃ ι')
    (x : ι' → F) : absoluteProjectiveTupleHeight (x ∘ e) = absoluteProjectiveTupleHeight x := by
  by_cases hx : ∀ i, IsIntegral ℚ (x i)
  · obtain ⟨E, _, y, rfl⟩ := exists_numberField_comp fun i ↦ (hx i).isAlgebraic
    simp only [Function.comp_assoc, absoluteProjectiveTupleHeight_comp,
      absoluteProjectiveTupleHeight_eq, mulHeight_comp_equiv]
  · obtain ⟨i, hi⟩ := not_forall.mp hx
    rw [absoluteProjectiveTupleHeight_of_not_isIntegral hi,
      absoluteProjectiveTupleHeight_of_not_isIntegral (i := e.symm i) (by simpa using hi)]

/-- The constant tuple `1` has absolute height `1`. -/
@[simp]
theorem absoluteProjectiveTupleHeight_one : absoluteProjectiveTupleHeight (1 : ι → F) = 1 := by
  have h : (1 : ι → F) = algebraMap ℚ F ∘ (1 : ι → ℚ) := by
    ext
    simp
  rw [h, absoluteProjectiveTupleHeight_comp,
    absoluteProjectiveTupleHeight_eq, mulHeight_one, Real.one_rpow]

/-- Restricting or repeating the coordinates of a tuple with algebraic coordinates along any map
does not increase its absolute height. The algebraicity hypothesis is needed because a tuple with
a transcendental coordinate has the junk height `1`. -/
theorem absoluteProjectiveTupleHeight_comp_le {ι' : Type*} [Finite ι'] {x : ι → F}
    (hx : ∀ i, IsAlgebraic ℚ (x i)) (f : ι' → ι) :
    absoluteProjectiveTupleHeight (x ∘ f) ≤ absoluteProjectiveTupleHeight x := by
  obtain ⟨E, _, y, rfl⟩ := exists_numberField_comp hx
  rw [Function.comp_assoc, absoluteProjectiveTupleHeight_comp, absoluteProjectiveTupleHeight_comp,
    absoluteProjectiveTupleHeight_eq, absoluteProjectiveTupleHeight_eq]
  exact Real.rpow_le_rpow (mulHeight_pos _).le (mulHeight_comp_le f y) (by positivity)

/-- The absolute height of the coordinatewise `n`-th power of a tuple is the `n`-th power of its
absolute height. -/
theorem absoluteProjectiveTupleHeight_pow (x : ι → F) (n : ℕ) :
    absoluteProjectiveTupleHeight (x ^ n) = absoluteProjectiveTupleHeight x ^ n := by
  rcases n.eq_zero_or_pos with rfl | hn
  · simp
  by_cases hx : ∀ i, IsIntegral ℚ (x i)
  · obtain ⟨E, _, y, rfl⟩ := exists_numberField_comp fun i ↦ (hx i).isAlgebraic
    have h : (algebraMap E F ∘ y) ^ n = algebraMap E F ∘ (y ^ n) := by
      ext
      simp
    rw [h, absoluteProjectiveTupleHeight_comp, absoluteProjectiveTupleHeight_comp,
      absoluteProjectiveTupleHeight_eq, absoluteProjectiveTupleHeight_eq, mulHeight_pow,
      Real.rpow_pow_comm (mulHeight_pos _).le]
  · -- A positive power of a transcendental coordinate is transcendental.
    obtain ⟨i, hi⟩ := not_forall.mp hx
    rw [absoluteProjectiveTupleHeight_of_not_isIntegral hi,
      absoluteProjectiveTupleHeight_of_not_isIntegral (i := i) fun h ↦ hi (h.of_pow hn), one_pow]

/-- A nonzero algebraic scalar does not change the absolute height of a tuple. -/
theorem absoluteProjectiveTupleHeight_smul (x : ι → F) {c : F} (hc : c ≠ 0)
    (hcalg : IsAlgebraic ℚ c) :
    absoluteProjectiveTupleHeight (c • x) = absoluteProjectiveTupleHeight x := by
  have hcint := hcalg.isIntegral
  by_cases hx : ∀ i, IsIntegral ℚ (x i)
  · -- Work in a number field containing `c` and the coordinates of `x`.
    let z : Option ι → F := fun o ↦ o.elim c x
    obtain ⟨E, _, y, hy⟩ := exists_numberField_comp (x := z) (by
      rintro (_ | i)
      exacts [hcalg, (hx i).isAlgebraic])
    have hc' : y none ≠ 0 := by
      rintro h
      exact hc (by simpa [z, h] using (congrFun hy none).symm)
    have hxy : algebraMap E F ∘ (fun i ↦ y (some i)) = x := funext fun i ↦ congrFun hy (some i)
    have hcxy : algebraMap E F ∘ (y none • fun i ↦ y (some i)) = c • x := by
      funext i
      simpa [z] using congr_arg₂ (· * ·) (congrFun hy none) (congrFun hy (some i))
    rw [← hcxy, ← hxy]
    simp only [absoluteProjectiveTupleHeight_comp, absoluteProjectiveTupleHeight_eq,
      mulHeight_smul_eq_mulHeight _ hc']
  · -- `c • x` has a transcendental coordinate, since `x i = c⁻¹ * (c * x i)`.
    obtain ⟨i, hi⟩ := not_forall.mp hx
    refine (absoluteProjectiveTupleHeight_of_not_isIntegral (i := i) fun h ↦ hi ?_).trans
      (absoluteProjectiveTupleHeight_of_not_isIntegral hi).symm
    have := hcint.inv.mul h
    rwa [Pi.smul_apply, smul_eq_mul, inv_mul_cancel_left₀ hc] at this

/-- The absolute height of an element `x` is the absolute height of the pair `(x, 1)`. -/
theorem absMulHeight₁_eq_absoluteProjectiveTupleHeight (x : F) :
    absMulHeight₁ x = absoluteProjectiveTupleHeight ![x, 1] := by
  by_cases hx : IsIntegral ℚ x
  · have : FiniteDimensional ℚ ℚ⟮x⟯ := adjoin.finiteDimensional hx
    have : NumberField ℚ⟮x⟯ := {}
    have h : algebraMap ℚ⟮x⟯ F ∘ ![AdjoinSimple.gen ℚ x, 1] = ![x, 1] := by
      ext i
      fin_cases i <;> simp
    rw [← h, absoluteProjectiveTupleHeight_comp, absoluteProjectiveTupleHeight_eq,
      ← mulHeight₁_eq_mulHeight, ← absMulHeight₁_eq_rpow,
      ← absMulHeight₁_map (algebraMap ℚ⟮x⟯ F), AdjoinSimple.algebraMap_gen]
  · rw [absMulHeight₁, dite_eq_right hx,
      absoluteProjectiveTupleHeight_of_not_isIntegral (x := ![x, 1]) (i := 0) hx]

/-! ### The absolute affine logarithmic height -/

section Affine

variable {n : ℕ}

/-- The **absolute affine logarithmic height** `h_aff(x)` of a tuple `x : Fin n → F` in a field of
characteristic zero: the logarithm of the absolute height of the tuple `(1, x)` obtained by
prepending the coordinate `1`. Over a number field `K` containing the coordinates it is
`Height.logHeight (Fin.cons 1 x) / [K : ℚ]` (`TauCeti.absoluteLogHeightAff_eq`).

Unlike the absolute height of `x`, it is not invariant under scaling: `(1/3, 1/3)` has absolute
projective height `1` but absolute affine logarithmic height `log 3`. A tuple with a
transcendental coordinate has the junk value `0`. -/
noncomputable def absoluteLogHeightAff (x : Fin n → F) : ℝ :=
  Real.log (absoluteProjectiveTupleHeight (Fin.cons 1 x : Fin (n + 1) → F))

/-- The defining formula of `TauCeti.absoluteLogHeightAff`. -/
theorem absoluteLogHeightAff_def (x : Fin n → F) :
    absoluteLogHeightAff x =
      Real.log (absoluteProjectiveTupleHeight (Fin.cons 1 x : Fin (n + 1) → F)) :=
  (rfl)

/-- The absolute affine logarithmic height is nonnegative. -/
theorem absoluteLogHeightAff_nonneg (x : Fin n → F) : 0 ≤ absoluteLogHeightAff x :=
  Real.log_nonneg (one_le_absoluteProjectiveTupleHeight _)

/-- The absolute affine logarithmic height is invariant under homomorphisms of fields of
characteristic zero. -/
@[simp]
theorem absoluteLogHeightAff_comp (f : F →+* F') (x : Fin n → F) :
    absoluteLogHeightAff (f ∘ x) = absoluteLogHeightAff x := by
  have h : (Fin.cons 1 (f ∘ x) : Fin (n + 1) → F') = f ∘ Fin.cons 1 x := by
    funext i
    cases i using Fin.cases <;> simp
  rw [absoluteLogHeightAff_def, absoluteLogHeightAff_def, h, absoluteProjectiveTupleHeight_comp]

/-- **Computation in a number field.** For a tuple `x` in a number field `K`, the absolute affine
logarithmic height is the logarithmic height of `(1, x)` relative to `K` divided by `[K : ℚ]`.
With `TauCeti.absoluteLogHeightAff_comp` this computes `absoluteLogHeightAff (f ∘ x)` for every
embedding `f` of `K` into a field of characteristic zero. -/
theorem absoluteLogHeightAff_eq {K : Type*} [Field K] [NumberField K] (x : Fin n → K) :
    absoluteLogHeightAff x = logHeight (Fin.cons 1 x : Fin (n + 1) → K) / finrank ℚ K := by
  rw [absoluteLogHeightAff_def, absoluteProjectiveTupleHeight_eq, Real.log_rpow (mulHeight_pos _),
    logHeight_eq_log_mulHeight, inv_mul_eq_div]

/-- For a tuple `x` in a number field `K`, the absolute affine logarithmic height is the affine
logarithmic height `Height.logHeightAff x` relative to `K` divided by `[K : ℚ]`. The two differ
only in where the coordinate `1` is placed, so this is a re-indexing.
With `TauCeti.absoluteLogHeightAff_comp` it computes `absoluteLogHeightAff (f ∘ x)` for every
embedding `f` of `K` into a field of characteristic zero, such as an algebraic closure of `ℚ`. -/
theorem absoluteLogHeightAff_eq_logHeightAff_div {K : Type*} [Field K] [NumberField K]
    (x : Fin n → K) : absoluteLogHeightAff x = logHeightAff x / finrank ℚ K := by
  rw [absoluteLogHeightAff_eq, logHeight_cons_one]

/-- The zero tuple has absolute affine logarithmic height `0`. -/
@[simp]
theorem absoluteLogHeightAff_zero : absoluteLogHeightAff (0 : Fin n → F) = 0 := by
  have h : (0 : Fin n → F) = algebraMap ℚ F ∘ (0 : Fin n → ℚ) := by
    ext
    simp
  rw [h, absoluteLogHeightAff_comp, absoluteLogHeightAff_eq_logHeightAff_div, logHeightAff_zero,
    zero_div]

/-- The tuple of ones has absolute affine logarithmic height `0`. -/
@[simp]
theorem absoluteLogHeightAff_one : absoluteLogHeightAff (1 : Fin n → F) = 0 := by
  have h : (1 : Fin n → F) = algebraMap ℚ F ∘ (1 : Fin n → ℚ) := by
    ext
    simp
  rw [h, absoluteLogHeightAff_comp, absoluteLogHeightAff_eq_logHeightAff_div, logHeightAff_one,
    zero_div]

/-- The absolute affine logarithmic height of `![x]` is the absolute logarithmic height of `x`:
with the coordinate `1` prepended, the height of a one-element tuple recovers the height of its
entry. -/
@[simp]
theorem absoluteLogHeightAff_fin_one (x : F) : absoluteLogHeightAff ![x] = absLogHeight₁ x := by
  have h : (Fin.cons 1 ![x] : Fin 2 → F) = ![x, 1] ∘ Equiv.swap 0 1 := by
    funext i
    fin_cases i <;> rfl
  rw [absoluteLogHeightAff_def, h, absoluteProjectiveTupleHeight_comp_equiv, absLogHeight₁,
    absMulHeight₁_eq_absoluteProjectiveTupleHeight]

end Affine

/-- The rational pair `(2 / 3, 1)` has absolute height `3`, in agreement with
`NumberField.absMulHeight₁ (2 / 3) = 3`. -/
example : absoluteProjectiveTupleHeight ![(2 / 3 : ℚ), 1] = 3 := by
  rw [← absMulHeight₁_eq_absoluteProjectiveTupleHeight, absMulHeight₁_eq_rpow,
    Rat.mulHeight₁_eq_max, finrank_self]
  norm_num

/-- The tuple `(1 / 3, 1 / 3)` is projectively equal to `(1, 1)` and has absolute height `1`,
while `(1, 1 / 3, 1 / 3)` has absolute height `3`. -/
example : absoluteProjectiveTupleHeight ![(1 / 3 : ℚ), 1 / 3] = 1 ∧
    absoluteProjectiveTupleHeight ![(1 : ℚ), 1 / 3, 1 / 3] = 3 := by
  have h₁ : ![(1 / 3 : ℚ), 1 / 3] = (1 / 3 : ℚ) • ((↑) ∘ ![(1 : ℤ), 1]) := by
    ext i
    fin_cases i <;> simp
  have h₂ : ![(1 : ℚ), 1 / 3, 1 / 3] = (1 / 3 : ℚ) • ((↑) ∘ ![(3 : ℤ), 1, 1]) := by
    ext i
    fin_cases i <;> norm_num
  constructor
  · rw [h₁, absoluteProjectiveTupleHeight_smul _ (by norm_num) (.of_finite ℚ _),
      absoluteProjectiveTupleHeight_eq, finrank_self,
      Rat.mulHeight_eq_max_abs_of_gcd_eq_one (by decide),
      le_antisymm (ciSup_le fun i ↦ by fin_cases i <;> simp) (Finite.le_ciSup_of_le 0 le_rfl)]
    norm_num
  · rw [h₂, absoluteProjectiveTupleHeight_smul _ (by norm_num) (.of_finite ℚ _),
      absoluteProjectiveTupleHeight_eq, finrank_self,
      Rat.mulHeight_eq_max_abs_of_gcd_eq_one (by decide),
      le_antisymm (ciSup_le fun i ↦ by fin_cases i <;> simp) (Finite.le_ciSup_of_le 0 le_rfl)]
    norm_num

/-- The tuple `(1/3, 1/3)` has absolute projective height `1` (above), but absolute affine
logarithmic height `log 3`, the absolute logarithmic height of `1/3`. -/
example : absoluteLogHeightAff ![(1 / 3 : ℚ), 1 / 3] = Real.log 3 := by
  have h : (Fin.cons 1 ![(1 / 3 : ℚ), 1 / 3] : Fin 3 → ℚ) =
      (1 / 3 : ℚ) • ((↑) ∘ ![(3 : ℤ), 1, 1]) := by
    ext i
    fin_cases i <;> norm_num
  rw [absoluteLogHeightAff_def, h,
    absoluteProjectiveTupleHeight_smul _ (by norm_num) (.of_finite ℚ _),
    absoluteProjectiveTupleHeight_eq, finrank_self,
    Rat.mulHeight_eq_max_abs_of_gcd_eq_one (by decide),
    le_antisymm (ciSup_le fun i ↦ by fin_cases i <;> simp) (Finite.le_ciSup_of_le 0 le_rfl)]
  norm_num

end TauCeti
