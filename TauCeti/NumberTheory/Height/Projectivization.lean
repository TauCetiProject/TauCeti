/-!
# Absolute height and bounded-degree Northcott on projective space

For an algebraic extension `F / ℚ`, the absolute tuple height descends to projective space.
Over a number field it is the degree root of the relative projective height. Points of
bounded absolute height and bounded degree of their field of definition form a finite set,
even when `F` has infinite degree over `ℚ`.

The degree bound is on the field generated by coordinate ratios, so multiplying a
representative by an algebraic scalar does not change the degree being bounded. After
normalizing one coordinate to one, the scalar Northcott theorem bounds every coordinate.
The finitely many possible normalized tuples then bound the projective points.

The finite-product argument follows the fixed-field proof in
`TauCeti.NumberTheory.Height.Northcott`, adapted there from Ralf Stephan's
`ArithmeticHeights/Northcott.lean` in
[`rwst/Subspace-Theorems`](https://github.com/rwst/Subspace-Theorems/blob/e443c2479e19f7665b31d8e94e2317c8ced1ca06/ArithmeticHeights/Northcott.lean),
commit `e443c2479e19f7665b31d8e94e2317c8ced1ca06` (Apache 2.0).

## References

* E. Bombieri and W. Gubler, *Heights in Diophantine Geometry* (2006), Theorem 1.6.8.
* M. Hindry and J. H. Silverman, *Diophantine Geometry: An Introduction* (2000), Theorem B.2.3.
-/

public section

namespace Projectivization

open TauCeti NumberField IntermediateField Module

variable {F ι : Type*} [Field F] [CharZero F] [Algebra.IsAlgebraic ℚ F] [Finite ι]

/-- The absolute multiplicative height on projective space over an algebraic extension of `ℚ`.
It is the absolute height of any representative tuple. -/
noncomputable def absMulHeight (p : Projectivization F (ι → F)) : ℝ :=
  p.lift (fun (x : {v : ι → F // v ≠ 0}) ↦ absoluteProjectiveTupleHeight x.1) (by
    intro x y c h
    have hc : c ≠ 0 := by
      intro hc
      exact x.2 (by simpa [hc] using h)
    rw [h]
    exact absoluteProjectiveTupleHeight_smul _ hc (Algebra.IsAlgebraic.isAlgebraic c))

/-- The absolute projective height computed from any nonzero representative. -/
@[simp]
theorem absMulHeight_mk {x : ι → F} (hx : x ≠ 0) :
    absMulHeight (mk F x hx) = absoluteProjectiveTupleHeight x := by
  simp [absMulHeight]

/-- Absolute projective height is at least one. -/
theorem one_le_absMulHeight (p : Projectivization F (ι → F)) : 1 ≤ p.absMulHeight := by
  rw [← p.mk_rep, absMulHeight_mk]
  exact one_le_absoluteProjectiveTupleHeight _

/-- Absolute projective height is positive. -/
theorem absMulHeight_pos (p : Projectivization F (ι → F)) : 0 < p.absMulHeight :=
  zero_lt_one.trans_le p.one_le_absMulHeight

/-- Over a number field the absolute projective height is the degree root of the relative
projective height. -/
theorem absMulHeight_eq_rpow {K : Type*} [Field K] [NumberField K]
    (p : Projectivization K (ι → K)) :
    p.absMulHeight = p.mulHeight ^ (finrank ℚ K : ℝ)⁻¹ := by
  induction p using ind with
  | h x hx => rw [absMulHeight_mk, mulHeight_mk, absoluteProjectiveTupleHeight_eq]

/-- **Northcott's theorem on projective space.** In an arbitrary algebraic extension of `ℚ`,
there are finitely many projective points of absolute height at most `B` whose coordinate-ratio
field has degree at most `d`. The ambient extension need not be finite. -/
theorem finite_setOf_finrank_fieldOfDefinition_le_absMulHeight_le (d : ℕ) (B : ℝ) :
    {p : Projectivization F (ι → F) |
      finrank ℚ (p.fieldOfDefinition ℚ) ≤ d ∧ p.absMulHeight ≤ B}.Finite := by
  have hpi : {v : ι → F | ∀ i,
      IsAlgebraic ℚ (v i) ∧ (minpoly ℚ (v i)).natDegree ≤ d ∧ absMulHeight₁ (v i) ≤ B}.Finite :=
    Set.Finite.pi' fun _ ↦ finite_setOf_absMulHeight₁_le d B
  have hsub : (Subtype.val ⁻¹' {v : ι → F | ∀ i,
      IsAlgebraic ℚ (v i) ∧ (minpoly ℚ (v i)).natDegree ≤ d ∧ absMulHeight₁ (v i) ≤ B} :
        Set {v : ι → F // v ≠ 0}).Finite :=
    hpi.preimage Subtype.val_injective.injOn
  refine (hsub.image (mk' F)).subset ?_
  rintro p ⟨hd, hB⟩
  obtain ⟨v, hv, i, hi, -, hp⟩ := exists_rep_apply_eq_one p
  refine ⟨⟨v, hv⟩, fun j ↦ ⟨Algebra.IsAlgebraic.isAlgebraic _, ?_, ?_⟩, hp⟩
  · have hfield : p.fieldOfDefinition ℚ = adjoin ℚ (Set.range v) := by
      rw [← hp, fieldOfDefinition_mk_eq_adjoin ℚ hv hi]
    have hmem : v j ∈ p.fieldOfDefinition ℚ := by
      rw [hfield]
      exact subset_adjoin ℚ _ (Set.mem_range_self j)
    let a : p.fieldOfDefinition ℚ := ⟨v j, hmem⟩
    have hmin : minpoly ℚ (v j) = minpoly ℚ a :=
      minpoly.algHom_eq (p.fieldOfDefinition ℚ).val
        (p.fieldOfDefinition ℚ).val.injective a
    rw [hmin]
    exact (minpoly.natDegree_le a).trans hd
  · have hpair : v ∘ ![j, i] = ![v j, 1] := by
      ext k
      fin_cases k <;> simp [hi]
    rw [absMulHeight₁_eq_absoluteProjectiveTupleHeight, ← hpair]
    refine (absoluteProjectiveTupleHeight_comp_le
      (fun k ↦ Algebra.IsAlgebraic.isAlgebraic (v k)) ![j, i]).trans ?_
    rwa [← absMulHeight_mk hv, hp]

end Projectivization
