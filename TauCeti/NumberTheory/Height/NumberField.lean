module

public import Mathlib.NumberTheory.Height.NumberField
public import TauCeti.NumberTheory.NumberField.InfinitePlace.Mult
import Mathlib.RingTheory.Ideal.Norm.RelNorm

/-!
# Relative and absolute heights in extensions of number fields

The multiplicative height `Height.mulHeight x` of a tuple `x` over a number field `K` is relative
to `K`: it is computed from the places of `K`. This file compares it across fields.

For an extension of number fields `L / K` and a finite tuple `x` over `K`,
`H_L(x) = H_K(x) ^ [L : K]`, including the zero tuple, where both sides are `1`. Consequently a
ring isomorphism of number fields preserves relative heights, and the absolute height
`NumberField.absMulHeight₁ x`, which Mathlib defines through the number field `ℚ(x)`, may be
computed in any number field `K` containing `x` as `H_K(x) ^ (1 / [K : ℚ])`. Elements of possibly
different characteristic-zero fields with the same rational minimal polynomial have the same
absolute height; in particular the absolute height is invariant under field embeddings.

## Main results

* `NumberField.mulHeight_algebraMap`: `H_L(x) = H_K(x) ^ [L : K]`, together with the scalar and
  logarithmic versions.
* `NumberField.mulHeight_ringEquiv`: a ring isomorphism of number fields preserves relative height,
  together with the scalar and logarithmic versions.
* `NumberField.absMulHeight₁_eq_rpow`: for `x` in a number field `K`, the absolute height of `x` is
  `H_K(x) ^ (1 / [K : ℚ])`.
* `NumberField.absMulHeight₁_eq_of_minpoly_eq`: equal rational minimal polynomials give equal
  absolute heights.

## References

* X. Wu, *Diophantine geometry, week 08: arithmetic heights* (2023), §2, Lemma 2.5 and
  Definition 2.7.
* C. Smyth, *The Mahler measure of algebraic numbers: a survey* (2008), §1.
-/

public section

open Height Ideal IntermediateField Module

namespace NumberField

variable {K L : Type*} [Field K] [Field L] [Algebra K L] [NumberField K] [NumberField L]
variable {ι : Type*} [Finite ι]

/-- For a nonzero tuple `y` of algebraic integers, the multiplicative height times the absolute
norm of the ideal generated by the coordinates is the archimedean part of the height. -/
theorem mulHeight_mul_absNorm_span_range {y : ι → 𝓞 K} (hy : y ≠ 0) :
    mulHeight (fun i ↦ (y i : K)) * (span (Set.range y)).absNorm =
      ∏ v : InfinitePlace K, (⨆ i, v (y i)) ^ v.mult := by
  have hy' : (fun i ↦ (y i : K)) ≠ 0 := by
    contrapose! hy
    ext i
    exact congrFun hy i
  rw [mulHeight_eq hy', mul_assoc, mul_comm (∏ᶠ _, _), absNorm_mul_finprod_finitePlace_eq_one hy,
    mul_one]

/-- The degree formula for a tuple of algebraic integers. -/
private theorem mulHeight_algebraMap_coe (y : ι → 𝓞 K) :
    mulHeight (fun i ↦ algebraMap K L (y i)) = mulHeight (fun i ↦ (y i : K)) ^ finrank K L := by
  rcases eq_or_ne y 0 with rfl | hy
  · simp [← Pi.zero_def]
  set z : ι → 𝓞 L := fun i ↦ algebraMap (𝓞 K) (𝓞 L) (y i)
  have hz : z ≠ 0 := by
    contrapose! hy
    funext i
    exact (map_eq_zero_iff _ (RingOfIntegers.algebraMap.injective K L)).mp (congrFun hy i)
  -- `z` is a local definition, so `rw [Set.range_comp]` cannot see the composition in it.
  have hrange : Set.range z = algebraMap (𝓞 K) (𝓞 L) '' Set.range y := Set.range_comp ..
  have hN : (span (Set.range z)).absNorm = (span (Set.range y)).absNorm ^ finrank K L := by
    rw [hrange, ← Ideal.map_span, Ideal.absNorm_algebraMap,
      ← IsFractionRing.finrank_eq (𝓞 K) K (𝓞 L) L]
  have hN₀ : ((span (Set.range z)).absNorm : ℝ) ≠ 0 := by
    rw [Nat.cast_ne_zero, Ne, absNorm_eq_zero_iff, span_eq_bot]
    simpa [funext_iff] using hz
  refine mul_right_cancel₀ hN₀ ?_
  have hyz (i : ι) : (z i : L) = algebraMap K L (y i) := by
    simp [z, ← IsScalarTower.algebraMap_apply]
  rw [← funext hyz, mulHeight_mul_absNorm_span_range hz, hN, Nat.cast_pow, ← mul_pow,
    mulHeight_mul_absNorm_span_range hy]
  simp_rw [hyz, ← InfinitePlace.comap_apply, InfinitePlace.prod_comap_pow_mult
    (fun v : InfinitePlace K ↦ ⨆ i, v (y i)), pow_mul, Finset.prod_pow]

/-- **Relative heights in an extension.** For an extension of number fields `L / K` and a finite
tuple `x` over `K`, the multiplicative height of `x` over `L` is its height over `K` raised to
the degree `[L : K]`. -/
@[simp]
theorem mulHeight_algebraMap (x : ι → K) :
    mulHeight (algebraMap K L ∘ x) = mulHeight x ^ finrank K L := by
  obtain ⟨⟨b, hb⟩, hbx⟩ :=
    IsLocalization.exist_integer_multiples_of_finite (nonZeroDivisors (𝓞 K)) x
  choose y hy using hbx
  have hb₀ : (b : K) ≠ 0 := by
    simpa using nonZeroDivisors.ne_zero hb
  have hxy : (b : K) • x = fun i ↦ (y i : K) := by
    ext i
    simpa [Algebra.smul_def] using (hy i).symm
  rw [← mulHeight_smul_eq_mulHeight x hb₀, ← mulHeight_smul_eq_mulHeight _
    ((map_ne_zero (algebraMap K L)).mpr hb₀), hxy, ← mulHeight_algebraMap_coe]
  congr 1
  ext i
  simp [← congrFun hxy i]

/-- The logarithmic height of a tuple over `L / K` is `[L : K]` times its height over `K`. -/
@[simp]
theorem logHeight_algebraMap (x : ι → K) :
    logHeight (algebraMap K L ∘ x) = finrank K L * logHeight x := by
  rw [logHeight_eq_log_mulHeight, mulHeight_algebraMap, Real.log_pow, logHeight_eq_log_mulHeight]

/-- The multiplicative height of `x ∈ K` over `L / K` is its height over `K` raised to the degree
`[L : K]`. -/
@[simp]
theorem mulHeight₁_algebraMap (x : K) :
    mulHeight₁ (algebraMap K L x) = mulHeight₁ x ^ finrank K L := by
  rw [mulHeight₁_eq_mulHeight, mulHeight₁_eq_mulHeight, ← mulHeight_algebraMap]
  congr 1
  ext i
  fin_cases i <;> simp

/-- The logarithmic height of `x ∈ K` over `L / K` is `[L : K]` times its height over `K`. -/
@[simp]
theorem logHeight₁_algebraMap (x : K) :
    logHeight₁ (algebraMap K L x) = finrank K L * logHeight₁ x := by
  rw [logHeight₁_eq_log_mulHeight₁, mulHeight₁_algebraMap, Real.log_pow,
    logHeight₁_eq_log_mulHeight₁]

section RingEquiv

variable {K' : Type*} [Field K'] [NumberField K']

omit [Field L] [Algebra K L] [NumberField L] in
/-- A ring isomorphism of number fields preserves the multiplicative height of tuples. -/
@[simp]
theorem mulHeight_ringEquiv (e : K ≃+* K') (x : ι → K) : mulHeight (e ∘ x) = mulHeight x := by
  let _ : Algebra K K' := e.toRingHom.toAlgebra
  have h := mulHeight_algebraMap (L := K') x
  -- `algebraMap K K'` is `e` by `RingHom.algebraMap_toAlgebra`, so `rwa` closes `h` up to `rfl`.
  rwa [← (AlgEquiv.ofRingEquiv (f := e) fun _ ↦ rfl).toLinearEquiv.finrank_eq, finrank_self,
    pow_one] at h

omit [Field L] [Algebra K L] [NumberField L] in
/-- A ring isomorphism of number fields preserves the multiplicative height of elements. -/
@[simp]
theorem mulHeight₁_ringEquiv (e : K ≃+* K') (x : K) : mulHeight₁ (e x) = mulHeight₁ x := by
  rw [mulHeight₁_eq_mulHeight, mulHeight₁_eq_mulHeight, ← mulHeight_ringEquiv e]
  congr 1
  ext i
  fin_cases i <;> simp

omit [Field L] [Algebra K L] [NumberField L] in
/-- A ring isomorphism of number fields preserves the logarithmic height of tuples. -/
@[simp]
theorem logHeight_ringEquiv (e : K ≃+* K') (x : ι → K) : logHeight (e ∘ x) = logHeight x := by
  rw [logHeight_eq_log_mulHeight, mulHeight_ringEquiv, logHeight_eq_log_mulHeight]

omit [Field L] [Algebra K L] [NumberField L] in
/-- A ring isomorphism of number fields preserves the logarithmic height of elements. -/
@[simp]
theorem logHeight₁_ringEquiv (e : K ≃+* K') (x : K) : logHeight₁ (e x) = logHeight₁ x := by
  rw [logHeight₁_eq_log_mulHeight₁, mulHeight₁_ringEquiv, logHeight₁_eq_log_mulHeight₁]

end RingEquiv

omit [Field L] [Algebra K L] [NumberField L] in
/-- The absolute height of an element `x` of a number field `K` is its height relative to `K`
raised to the power `1 / [K : ℚ]`. -/
theorem absMulHeight₁_eq_rpow (x : K) :
    absMulHeight₁ x = mulHeight₁ x ^ (finrank ℚ K : ℝ)⁻¹ := by
  have hx : IsIntegral ℚ x := .of_finite ℚ x
  have : FiniteDimensional ℚ ℚ⟮x⟯ := adjoin.finiteDimensional hx
  have : NumberField ℚ⟮x⟯ := {}
  have h := mulHeight₁_algebraMap (L := K) (AdjoinSimple.gen ℚ x)
  rw [AdjoinSimple.algebraMap_gen] at h
  rw [absMulHeight₁, dite_eq_left hx, h, ← finrank_mul_finrank ℚ ℚ⟮x⟯ K, ← Real.rpow_natCast,
    ← Real.rpow_mul (mulHeight₁_nonneg _)]
  congr 1
  have : (finrank ℚ⟮x⟯ K : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr finrank_pos.ne'
  push_cast
  field_simp

omit [Field L] [Algebra K L] [NumberField L] in
/-- The absolute logarithmic height of an element `x` of a number field `K` is its logarithmic
height relative to `K` divided by `[K : ℚ]`. -/
theorem absLogHeight₁_eq_div (x : K) : absLogHeight₁ x = logHeight₁ x / finrank ℚ K := by
  rw [absLogHeight₁, absMulHeight₁_eq_rpow, Real.log_rpow (mulHeight₁_pos x),
    logHeight₁_eq_log_mulHeight₁, inv_mul_eq_div]

section MinpolyEq

variable {F F' : Type*} [Field F] [CharZero F] [Field F'] [CharZero F']

/-- Elements of characteristic-zero fields with the same minimal polynomial over `ℚ` have the
same absolute height. This includes transcendental elements, whose minimal polynomial is `0` and
whose absolute height is the junk value `1`. -/
theorem absMulHeight₁_eq_of_minpoly_eq {x : F} {y : F'} (h : minpoly ℚ x = minpoly ℚ y) :
    absMulHeight₁ x = absMulHeight₁ y := by
  by_cases hx : IsIntegral ℚ x
  · have hy : IsIntegral ℚ y := by
      by_contra hy
      exact minpoly.ne_zero hx (h.trans (minpoly.eq_zero hy))
    have : FiniteDimensional ℚ ℚ⟮x⟯ := adjoin.finiteDimensional hx
    have : NumberField ℚ⟮x⟯ := {}
    have : FiniteDimensional ℚ ℚ⟮y⟯ := adjoin.finiteDimensional hy
    have : NumberField ℚ⟮y⟯ := {}
    -- `ℚ⟮x⟯ ≃ ℚ[X] / (minpoly ℚ x) = ℚ[X] / (minpoly ℚ y) ≃ ℚ⟮y⟯`, sending `x` to `y`.
    let e : ℚ⟮x⟯ ≃ₐ[ℚ] ℚ⟮y⟯ := (adjoinRootEquivAdjoin ℚ hx).symm.trans <|
      (AdjoinRoot.algEquivOfEq _ _ _ h).trans (adjoinRootEquivAdjoin ℚ hy)
    have he : e (AdjoinSimple.gen ℚ x) = AdjoinSimple.gen ℚ y := by
      simp [e, adjoinRootEquivAdjoin_symm_apply_gen, AdjoinRoot.algEquivOfEq_root,
        adjoinRootEquivAdjoin_apply_root]
    rw [absMulHeight₁, dite_eq_left hx, absMulHeight₁, dite_eq_left hy, ← he,
      ← AlgEquiv.coe_toRingEquiv e, mulHeight₁_ringEquiv, e.toLinearEquiv.finrank_eq]
  · have hy : ¬IsIntegral ℚ y := fun hy ↦ minpoly.ne_zero hy (h.symm.trans (minpoly.eq_zero hx))
    rw [absMulHeight₁, dite_eq_right hx, absMulHeight₁, dite_eq_right hy]

/-- Elements of characteristic-zero fields with the same minimal polynomial over `ℚ` have the
same absolute logarithmic height. -/
theorem absLogHeight₁_eq_of_minpoly_eq {x : F} {y : F'} (h : minpoly ℚ x = minpoly ℚ y) :
    absLogHeight₁ x = absLogHeight₁ y := by
  rw [absLogHeight₁, absLogHeight₁, absMulHeight₁_eq_of_minpoly_eq h]

/-- The absolute height is invariant under ring homomorphisms of characteristic-zero fields. -/
@[simp]
theorem absMulHeight₁_map (f : F →+* F') (x : F) : absMulHeight₁ (f x) = absMulHeight₁ x :=
  absMulHeight₁_eq_of_minpoly_eq (minpoly.algHom_eq f.toRatAlgHom f.injective x)

/-- The absolute logarithmic height is invariant under ring homomorphisms of characteristic-zero
fields. -/
@[simp]
theorem absLogHeight₁_map (f : F →+* F') (x : F) : absLogHeight₁ (f x) = absLogHeight₁ x :=
  absLogHeight₁_eq_of_minpoly_eq (minpoly.algHom_eq f.toRatAlgHom f.injective x)

end MinpolyEq

/-- The rational number `2` has relative height `2 ^ [K : ℚ]` over a number field `K`; for
`K = ℚ(i)` this is `4`. Relative heights are not invariant under extension. -/
example (K : Type*) [Field K] [NumberField K] : mulHeight₁ (2 : K) = 2 ^ finrank ℚ K := by
  rw [← map_ofNat (algebraMap ℚ K) 2, mulHeight₁_algebraMap, Rat.mulHeight₁_eq_max]
  norm_num

/-- The absolute height of `2 / 3` is `3`, computed in `ℂ`. -/
example : absMulHeight₁ ((2 / 3 : ℚ) : ℂ) = 3 := by
  rw [← eq_ratCast (Rat.castHom ℂ), absMulHeight₁_map, absMulHeight₁_eq_rpow, Rat.mulHeight₁_eq_max,
    Module.finrank_self]
  norm_num

end NumberField
