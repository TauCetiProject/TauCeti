module

public import TauCeti.NumberTheory.Height.Arakelov.Comparison
public import TauCeti.NumberTheory.Height.Arakelov.Extension
import TauCeti.NumberTheory.NumberField.AdjoinPair

/-!
# Absolute Euclidean heights of algebraic tuples

`TauCeti.absoluteHeight2` extends the number-field Euclidean height `TauCeti.height2` to finite
tuples in any characteristic-zero field, including an algebraic closure of `ℚ`. For algebraic
coordinates it computes the height in the number field generated by the coordinates. The
extension theorem for `height2` makes this independent of the containing number field.

The value at zero is zero, including on the empty coordinate type. A tuple with a transcendental
coordinate has junk value one. Nonzero algebraic scaling and coordinate equivalences preserve
the height. For a nonzero algebraic tuple, its absolute sup height is at most its Euclidean
height, which is at most `√#ι` times its sup height. These comparisons also hold for the junk
values, with the lower bound excluding zero.

The construction follows `TauCeti.absoluteProjectiveTupleHeight`, retaining the different zero
convention of Euclidean vector height. It allows coefficient and Plücker vectors over algebraic
fields to use the same Euclidean height as vectors over number fields.

## References

* J.-H. Evertse and R. G. Ferretti, *A further improvement of the quantitative Subspace
  Theorem*, Ann. of Math. 177 (2013), §6.1 and §6.3.
-/

public noncomputable section

open Function IntermediateField Module NumberField

namespace TauCeti

variable {F F' : Type*} [Field F] [CharZero F] [Field F'] [CharZero F']
variable {ι : Type*} [Finite ι]

open Classical in
/-- The absolute Euclidean height of a finite tuple in a characteristic-zero field. Algebraic
tuples are measured by `height2` in the number field generated by their coordinates. The zero
tuple has value zero, and a tuple with a transcendental coordinate has junk value one. -/
def absoluteHeight2 (x : ι → F) : ℝ :=
  if hx : ∀ i, IsIntegral ℚ (x i) then
    haveI : FiniteDimensional ℚ (adjoin ℚ (Set.range x)) :=
      finiteDimensional_adjoin (by rintro _ ⟨i, rfl⟩; exact hx i)
    haveI : NumberField (adjoin ℚ (Set.range x)) := {}
    height2 (fun i ↦ (⟨x i, subset_adjoin ℚ _ (Set.mem_range_self i)⟩ :
      adjoin ℚ (Set.range x)))
  else 1

/-- A tuple with a transcendental coordinate has junk Euclidean height one. -/
theorem absoluteHeight2_of_not_isAlgebraic {x : ι → F} {i : ι}
    (hi : ¬IsAlgebraic ℚ (x i)) : absoluteHeight2 x = 1 :=
  dite_eq_right fun hx ↦ hi (hx i).isAlgebraic

/-- Computation in a number field agrees with the degree-normalized Euclidean height. -/
theorem absoluteHeight2_eq {K : Type*} [Field K] [NumberField K] (x : ι → K) :
    absoluteHeight2 x = height2 x := by
  have hx (i : ι) : IsIntegral ℚ (x i) := .of_finite ℚ (x i)
  have : FiniteDimensional ℚ (adjoin ℚ (Set.range x)) :=
    finiteDimensional_adjoin (by rintro _ ⟨i, rfl⟩; exact hx i)
  have : NumberField (adjoin ℚ (Set.range x)) := {}
  let y : ι → adjoin ℚ (Set.range x) :=
    fun i ↦ ⟨x i, subset_adjoin ℚ _ (Set.mem_range_self i)⟩
  -- The inclusion of the generated number field sends `y` to `x`.
  have hy : algebraMap (adjoin ℚ (Set.range x)) K ∘ y = x := by
    ext i
    simp [y]
  rw [absoluteHeight2, dite_eq_left hx]
  exact (height2_algebraMap (L := K) y).symm.trans (congrArg height2 hy)

/-- Absolute Euclidean height is preserved by homomorphisms of characteristic-zero fields. -/
@[simp]
theorem absoluteHeight2_comp (f : F →+* F') (x : ι → F) :
    absoluteHeight2 (f ∘ x) = absoluteHeight2 x := by
  have hint (i : ι) : IsIntegral ℚ (f (x i)) ↔ IsIntegral ℚ (x i) :=
    isIntegral_algHom_iff f.toRatAlgHom f.injective
  by_cases hx : ∀ i, IsIntegral ℚ (x i)
  · have hfx (i : ι) : IsIntegral ℚ ((f ∘ x) i) := (hint i).mpr (hx i)
    let E := adjoin ℚ (Set.range x)
    let E' := adjoin ℚ (Set.range (f ∘ x))
    have : FiniteDimensional ℚ E := finiteDimensional_adjoin (by rintro _ ⟨i, rfl⟩; exact hx i)
    have : NumberField E := {}
    have : FiniteDimensional ℚ E' := finiteDimensional_adjoin (by rintro _ ⟨i, rfl⟩; exact hfx i)
    have : NumberField E' := {}
    have hE : E.map f.toRatAlgHom = E' := by
      rw [adjoin_map, ← Set.range_comp]
      rfl
    let e : E ≃ₐ[ℚ] E' := (equivMap E f.toRatAlgHom).trans (equivOfEq hE)
    rw [absoluteHeight2, dite_eq_left hfx, absoluteHeight2, dite_eq_left hx,
      ← e.toRingEquiv.height2_comp]
    -- The restricted isomorphism sends each coordinate to its image under `f`.
    refine congrArg height2 (funext fun i ↦ Subtype.ext ?_)
    simp [e]
  · obtain ⟨i, hi⟩ := not_forall.mp hx
    have hi' : ¬IsAlgebraic ℚ (x i) := fun h ↦ hi h.isIntegral
    rw [absoluteHeight2_of_not_isAlgebraic hi',
      absoluteHeight2_of_not_isAlgebraic (i := i) fun h ↦ hi ((hint i).mp h.isIntegral)]

/-- The zero tuple, including the empty tuple, has absolute Euclidean height zero. -/
@[simp]
theorem absoluteHeight2_zero : absoluteHeight2 (0 : ι → F) = 0 := by
  have h : (0 : ι → F) = algebraMap ℚ F ∘ (0 : ι → ℚ) := by
    ext i
    simp
  rw [h, absoluteHeight2_comp, absoluteHeight2_eq, height2_zero]

/-- Absolute Euclidean height is nonnegative. -/
theorem absoluteHeight2_nonneg (x : ι → F) : 0 ≤ absoluteHeight2 x := by
  by_cases hx : ∀ i, IsAlgebraic ℚ (x i)
  · obtain ⟨E, _, y, rfl⟩ := exists_numberField_comp hx
    rw [absoluteHeight2_comp, absoluteHeight2_eq]
    exact height2_nonneg y
  · obtain ⟨i, hi⟩ := not_forall.mp hx
    rw [absoluteHeight2_of_not_isAlgebraic hi]
    exact zero_le_one

/-- The absolute sup height of a nonzero tuple is at most its absolute Euclidean height. -/
theorem absoluteProjectiveTupleHeight_le_absoluteHeight2 {x : ι → F} (hx : x ≠ 0) :
    absoluteProjectiveTupleHeight x ≤ absoluteHeight2 x := by
  by_cases halg : ∀ i, IsAlgebraic ℚ (x i)
  · obtain ⟨E, _, y, rfl⟩ := exists_numberField_comp halg
    have hy : y ≠ 0 := by
      rintro rfl
      exact hx (by ext i; simp)
    rw [absoluteProjectiveTupleHeight_comp, absoluteHeight2_comp, absoluteHeight2_eq]
    exact absoluteProjectiveTupleHeight_le_height2 hy
  · obtain ⟨i, hi⟩ := not_forall.mp halg
    rw [absoluteHeight2_of_not_isAlgebraic hi,
      absoluteProjectiveTupleHeight_of_not_isIntegral (fun h ↦ hi h.isAlgebraic)]

/-- The absolute Euclidean height of a nonzero tuple is at least one. -/
theorem one_le_absoluteHeight2_of_ne_zero {x : ι → F} (hx : x ≠ 0) :
    1 ≤ absoluteHeight2 x :=
  (one_le_absoluteProjectiveTupleHeight x).trans
    (absoluteProjectiveTupleHeight_le_absoluteHeight2 hx)

/-- Absolute Euclidean height vanishes exactly at the zero tuple. -/
@[simp]
theorem absoluteHeight2_eq_zero_iff {x : ι → F} : absoluteHeight2 x = 0 ↔ x = 0 := by
  constructor
  · contrapose!
    intro hx
    exact (zero_lt_one.trans_le (one_le_absoluteHeight2_of_ne_zero hx)).ne'
  · rintro rfl
    exact absoluteHeight2_zero

/-- Absolute Euclidean height is positive exactly for nonzero tuples. -/
@[simp]
theorem absoluteHeight2_pos_iff {x : ι → F} : 0 < absoluteHeight2 x ↔ x ≠ 0 := by
  constructor
  · rintro h rfl
    simp at h
  · exact fun hx ↦ zero_lt_one.trans_le (one_le_absoluteHeight2_of_ne_zero hx)

/-- Reindexing by a coordinate equivalence preserves absolute Euclidean height. -/
@[simp]
theorem absoluteHeight2_comp_equiv {ι' : Type*} [Finite ι'] (e : ι ≃ ι') (x : ι' → F) :
    absoluteHeight2 (x ∘ e) = absoluteHeight2 x := by
  by_cases hx : ∀ i, IsAlgebraic ℚ (x i)
  · obtain ⟨E, _, y, rfl⟩ := exists_numberField_comp hx
    simp only [comp_assoc, absoluteHeight2_comp, absoluteHeight2_eq, height2_comp_equiv]
  · obtain ⟨i, hi⟩ := not_forall.mp hx
    rw [absoluteHeight2_of_not_isAlgebraic hi,
      absoluteHeight2_of_not_isAlgebraic (i := e.symm i) (by simpa using hi)]

/-- Nonzero algebraic scaling preserves absolute Euclidean height. The algebraicity hypothesis
is needed because scaling by a transcendental scalar can change a tuple's height to junk. -/
@[simp]
theorem absoluteHeight2_smul (x : ι → F) {c : F} (hc : c ≠ 0) (hcalg : IsAlgebraic ℚ c) :
    absoluteHeight2 (c • x) = absoluteHeight2 x := by
  by_cases hx : ∀ i, IsAlgebraic ℚ (x i)
  · -- Choose one number field containing the scalar and every coordinate.
    let z : Option ι → F := fun o ↦ o.elim c x
    obtain ⟨E, _, y, hy⟩ := exists_numberField_comp (x := z) (by
      rintro (_ | i)
      exacts [hcalg, hx i])
    have hc' : y none ≠ 0 := by
      rintro h
      exact hc (by simpa [z, h] using (congrFun hy none).symm)
    have hxy : algebraMap E F ∘ (fun i ↦ y (some i)) = x := funext fun i ↦ congrFun hy (some i)
    have hcxy : algebraMap E F ∘ (y none • fun i ↦ y (some i)) = c • x := by
      funext i
      simpa [z] using congr_arg₂ (· * ·) (congrFun hy none) (congrFun hy (some i))
    rw [← hcxy, ← hxy]
    simp only [absoluteHeight2_comp, absoluteHeight2_eq, height2_smul _ hc']
  · obtain ⟨i, hi⟩ := not_forall.mp hx
    refine (absoluteHeight2_of_not_isAlgebraic (i := i) fun h ↦ hi ?_).trans
      (absoluteHeight2_of_not_isAlgebraic hi).symm
    have := hcalg.inv.mul h
    rwa [Pi.smul_apply, smul_eq_mul, inv_mul_cancel_left₀ hc] at this

/-- Absolute Euclidean height is at most `√#ι` times absolute sup height, including at zero
and for the empty tuple. -/
theorem absoluteHeight2_le_sqrt_natCard_mul_absoluteProjectiveTupleHeight (x : ι → F) :
    absoluteHeight2 x ≤ √(Nat.card ι) * absoluteProjectiveTupleHeight x := by
  by_cases hx : ∀ i, IsAlgebraic ℚ (x i)
  · obtain ⟨E, _, y, rfl⟩ := exists_numberField_comp hx
    rw [absoluteProjectiveTupleHeight_comp, absoluteHeight2_comp, absoluteHeight2_eq]
    exact height2_le_sqrt_natCard_mul_absoluteProjectiveTupleHeight y
  · obtain ⟨i, hi⟩ := not_forall.mp hx
    have : Nonempty ι := ⟨i⟩
    rw [absoluteHeight2_of_not_isAlgebraic hi,
      absoluteProjectiveTupleHeight_of_not_isIntegral (fun h ↦ hi h.isAlgebraic), mul_one]
    exact Real.one_le_sqrt.mpr (Nat.one_le_cast.mpr Nat.card_pos)

/-- Computation in `ℂ` retains the Euclidean height of the rational pair `(3, 4)`. -/
example : absoluteHeight2 ![(3 : ℂ), 4] = 5 := by
  have h : ![(3 : ℂ), 4] = algebraMap ℚ ℂ ∘ (((↑) : ℤ → ℚ) ∘ ![3, 4]) := by
    ext i
    fin_cases i <;> simp
  rw [h, absoluteHeight2_comp, absoluteHeight2_eq,
    height2_intCast_eq_sqrt_of_gcd_eq_one (by decide)]
  norm_num [Fin.sum_univ_two, Real.sqrt_eq_iff_mul_self_eq]

/-- The zero convention differs from the projective convention even on an empty tuple. -/
example : absoluteHeight2 (0 : Fin 0 → ℂ) = 0 ∧
    absoluteProjectiveTupleHeight (0 : Fin 0 → ℂ) = 1 := by
  exact ⟨absoluteHeight2_zero, absoluteProjectiveTupleHeight_zero⟩

end TauCeti
