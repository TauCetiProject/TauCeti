module

public import Mathlib.NumberTheory.NumberField.House
public import TauCeti.NumberTheory.Height.MahlerMeasure

import Mathlib.Analysis.Complex.IsIntegral

/-!
# The house of an algebraic number

The *house* `⌈x⌉` of an element `x` of a field of characteristic zero is the largest absolute
value of a complex root of `minpoly ℚ x`, that is, the largest modulus of a complex conjugate of
`x`. The value at a transcendental element is `0`.

Mathlib's `NumberField.house` is the same quantity for an element of a fixed number field, computed
through its complex embeddings. The version here needs neither a number field nor a complex
embedding of the ambient field: only `minpoly ℚ x` is mapped to `ℂ`. It is therefore constant on
conjugacy classes and invariant under field embeddings, and it agrees with `NumberField.house` on
number fields (`TauCeti.house_eq_numberField_house`). The sub-multiplicativity and
sub-additivity of the house for algebraic elements are obtained by computing in the number field
generated by the elements involved.

Together with the naive height and the Mahler measure, the house controls the size of the
conjugates of an algebraic number. It enters Liouville-type lower bounds, the bound of the naive
height of an algebraic integer by a power of its house, and the finiteness of algebraic integers
of bounded degree and bounded house.

## Main definitions

* `TauCeti.house x`: the largest modulus of a complex root of `minpoly ℚ x`.

## Main results

* `TauCeti.norm_le_house_of_mem_rootSet`, `TauCeti.house_le_iff`,
  `TauCeti.exists_mem_rootSet_norm_eq_house`: the house is the maximum of the moduli of the
  complex conjugates; in particular `‖x‖ ≤ ⌈x⌉` for algebraic `x ∈ ℂ` (`TauCeti.norm_le_house`).
* `TauCeti.house_eq_numberField_house`: on a number field the house is `NumberField.house`.
* `TauCeti.house_map`, `TauCeti.house_eq_of_minpoly_eq`: invariance under field embeddings and
  conjugation.
* `TauCeti.house_mul_le`, `TauCeti.house_add_le`, `TauCeti.house_pow`: the house is
  sub-multiplicative, sub-additive and multiplicative on powers.
* `TauCeti.one_le_house`, `TauCeti.house_eq_one_iff`: a nonzero algebraic integer has house at
  least `1`, and Kronecker's theorem, an algebraic integer has house `1` exactly when it is a root
  of unity.
* `TauCeti.house_le_mahlerMeasure`,
  `TauCeti.mahlerMeasure_le_leadingCoeff_mul_max_one_house_pow`: the comparisons
  `⌈x⌉ ≤ M(x) ≤ a₀ max(1, ⌈x⌉)ᵈ` with the Mahler measure.

## References

* J.-H. Evertse, *Diophantine Approximation*, lecture notes (2019), ch. 3, §3.4 and
  Exercises 3.5, 3.6.
* C. Smyth, *The Mahler measure of algebraic numbers: a survey* (2008), §3.
-/

public section

open Polynomial IntermediateField

namespace TauCeti

variable {F : Type*} [Field F] [CharZero F] {F' : Type*} [Field F'] [CharZero F']

/-- The *house* `⌈x⌉` of `x`: the largest modulus of a complex root of `minpoly ℚ x`, that is,
of a complex conjugate of `x`. For transcendental `x` the minimal polynomial is `0`, it has no
roots, and the house is `0`. -/
noncomputable def house (x : F) : ℝ :=
  ⨆ z : (minpoly ℚ x).rootSet ℂ, ‖(z : ℂ)‖

/-- The house of `x` is the supremum of the moduli of the complex roots of `minpoly ℚ x`. -/
theorem house_def (x : F) : house x = ⨆ z : (minpoly ℚ x).rootSet ℂ, ‖(z : ℂ)‖ := (rfl)

/-- The house is nonnegative. -/
theorem house_nonneg (x : F) : 0 ≤ house x :=
  Real.iSup_nonneg fun _ ↦ norm_nonneg _

/-- Every complex conjugate of `x` has modulus at most the house of `x`. -/
theorem norm_le_house_of_mem_rootSet {x : F} {z : ℂ} (hz : z ∈ (minpoly ℚ x).rootSet ℂ) :
    ‖z‖ ≤ house x :=
  le_ciSup (f := fun z : (minpoly ℚ x).rootSet ℂ ↦ ‖(z : ℂ)‖) (Set.finite_range _).bddAbove
    ⟨z, hz⟩

/-- An algebraic complex number has modulus at most its house. -/
theorem norm_le_house {x : ℂ} (hx : IsAlgebraic ℚ x) : ‖x‖ ≤ house x :=
  norm_le_house_of_mem_rootSet <|
    (mem_rootSet_of_ne (minpoly.ne_zero hx.isIntegral)).2 (minpoly.aeval ℚ x)

/-- For `C ≥ 0`, the house of `x` is at most `C` exactly when every complex conjugate of `x` has
modulus at most `C`. -/
theorem house_le_iff {x : F} {C : ℝ} (hC : 0 ≤ C) :
    house x ≤ C ↔ ∀ z ∈ (minpoly ℚ x).rootSet ℂ, ‖z‖ ≤ C :=
  ⟨fun h _ hz ↦ (norm_le_house_of_mem_rootSet hz).trans h,
    fun h ↦ Real.iSup_le (fun z ↦ h z z.2) hC⟩

/-- The house of an algebraic element is attained: it is the modulus of some complex conjugate. -/
theorem exists_mem_rootSet_norm_eq_house {x : F} (hx : IsAlgebraic ℚ x) :
    ∃ z ∈ (minpoly ℚ x).rootSet ℂ, ‖z‖ = house x := by
  have hint := hx.isIntegral
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_aeval_eq_zero ℂ (minpoly ℚ x) (minpoly.degree_pos hint).ne'
  have : Nonempty ((minpoly ℚ x).rootSet ℂ) :=
    ⟨⟨z, (mem_rootSet_of_ne (minpoly.ne_zero hint)).2 hz⟩⟩
  obtain ⟨w, hw⟩ := exists_eq_ciSup_of_finite (f := fun z : (minpoly ℚ x).rootSet ℂ ↦ ‖(z : ℂ)‖)
  exact ⟨w, w.2, hw⟩

/-- On a number field, the house is Mathlib's `NumberField.house`: the largest modulus of the
image of `x` under a complex embedding. -/
theorem house_eq_numberField_house {K : Type*} [Field K] [NumberField K] (x : K) :
    house x = NumberField.house x := by
  have hroots := NumberField.Embeddings.range_eval_eq_rootSet_minpoly K ℂ x
  refine le_antisymm ((house_le_iff (NumberField.house_nonneg x)).2 fun z hz ↦ ?_) ?_
  · obtain ⟨φ, rfl⟩ := hroots.symm.subset hz
    exact NumberField.norm_embedding_le_house x φ
  · obtain ⟨φ, -, hφ⟩ := Finset.exists_mem_eq_sup' Finset.univ_nonempty fun φ : K →+* ℂ ↦ ‖φ x‖₊
    rw [NumberField.house_eq_sup', hφ, coe_nnnorm]
    exact norm_le_house_of_mem_rootSet (hroots ▸ ⟨φ, rfl⟩)

/-- The house depends only on `minpoly ℚ x`: conjugates, possibly lying in different fields, have
equal house. -/
theorem house_eq_of_minpoly_eq {x : F} {y : F'} (h : minpoly ℚ x = minpoly ℚ y) :
    house x = house y := by
  rw [house_def, house_def, h]

/-- Field embeddings preserve the house. -/
@[simp]
theorem house_map (f : F →+* F') (x : F) : house (f x) = house x :=
  house_eq_of_minpoly_eq (minpoly.algHom_eq f.toRatAlgHom f.injective x)

/-- Transcendental elements have house `0`. -/
@[simp]
theorem house_of_not_isAlgebraic {x : F} (hx : ¬IsAlgebraic ℚ x) : house x = 0 := by
  rw [house_def, minpoly.eq_zero (isAlgebraic_iff_isIntegral.not.mp hx), rootSet_zero]
  exact Real.iSup_of_isEmpty _

/-- The house of an element of a number field inside `F` is computed in that number field. -/
private lemma house_coe {K : IntermediateField ℚ F} [NumberField K] (a : K) :
    house (a : F) = NumberField.house a := by
  rw [← IntermediateField.algebraMap_apply, house_map, house_eq_numberField_house]

/-- Two algebraic elements of `F` lie in a common intermediate number field. -/
private lemma exists_numberField_mem {x y : F} (hx : IsAlgebraic ℚ x) (hy : IsAlgebraic ℚ y) :
    ∃ (K : IntermediateField ℚ F) (_ : NumberField K) (a b : K), (a : F) = x ∧ (b : F) = y := by
  have := finiteDimensional_adjoin_pair hx.isIntegral hy.isIntegral
  exact ⟨ℚ⟮x, y⟯, {}, ⟨x, subset_adjoin _ _ (by simp)⟩, ⟨y, subset_adjoin _ _ (by simp)⟩, rfl, rfl⟩

/-- The house of a rational number is its absolute value, independently of the field containing
it. -/
@[simp]
theorem house_ratCast (q : ℚ) : house (q : F) = |(q : ℝ)| := by
  classical
  rw [house_def, ← eq_ratCast (algebraMap ℚ F), minpoly.eq_X_sub_C, rootSet_def, aroots_X_sub_C,
    Multiset.toFinset_singleton, Finset.coe_singleton, ciSup_unique]
  simp

/-- The house of an integer is its absolute value. -/
@[simp]
theorem house_intCast (n : ℤ) : house (n : F) = |(n : ℝ)| := by
  simpa using house_ratCast (F := F) n

/-- The house of a natural number is itself. -/
@[simp]
theorem house_natCast (n : ℕ) : house (n : F) = n := by
  simpa using house_ratCast (F := F) n

/-- The house of `0` is `0`. -/
@[simp]
theorem house_zero : house (0 : F) = 0 := by
  simpa using house_natCast (F := F) 0

/-- The house of `1` is `1`. -/
@[simp]
theorem house_one : house (1 : F) = 1 := by
  simpa using house_natCast (F := F) 1

/-- The house of a product of algebraic elements is at most the product of their houses. -/
theorem house_mul_le {x y : F} (hx : IsAlgebraic ℚ x) (hy : IsAlgebraic ℚ y) :
    house (x * y) ≤ house x * house y := by
  obtain ⟨K, _, a, b, rfl, rfl⟩ := exists_numberField_mem hx hy
  rw [← IntermediateField.coe_mul, house_coe, house_coe, house_coe]
  exact NumberField.house_mul_le a b

/-- The house of a sum of algebraic elements is at most the sum of their houses. -/
theorem house_add_le {x y : F} (hx : IsAlgebraic ℚ x) (hy : IsAlgebraic ℚ y) :
    house (x + y) ≤ house x + house y := by
  obtain ⟨K, _, a, b, rfl, rfl⟩ := exists_numberField_mem hx hy
  rw [← IntermediateField.coe_add, house_coe, house_coe, house_coe]
  exact NumberField.house_add_le a b

/-- The house is multiplicative on powers. For transcendental `x` and `n ≠ 0` both sides are
`0`. -/
@[simp]
theorem house_pow (x : F) (n : ℕ) : house (x ^ n) = house x ^ n := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp
  by_cases hx : IsAlgebraic ℚ x
  · obtain ⟨K, _, a, -, rfl, -⟩ := exists_numberField_mem hx hx
    rw [← IntermediateField.coe_pow, house_coe, house_coe, NumberField.house_pow]
  · rw [house_of_not_isAlgebraic hx, house_of_not_isAlgebraic fun h ↦ hx (h.of_pow hn),
      zero_pow hn.ne']

/-- A nonzero algebraic integer has house at least `1`. -/
theorem one_le_house {x : F} (hx : IsIntegral ℤ x) (h0 : x ≠ 0) : 1 ≤ house x := by
  have halg : IsAlgebraic ℚ x := (hx.tower_top (A := ℚ)).isAlgebraic
  obtain ⟨K, _, a, -, rfl, -⟩ := exists_numberField_mem halg halg
  rw [house_coe]
  rw [← IntermediateField.algebraMap_apply, isIntegral_algebraMap_iff] at hx
  exact NumberField.one_le_house_of_isIntegral hx (by simpa using h0)

/-- **Kronecker's theorem.** An algebraic integer has house `1` exactly when it is a root of
unity. -/
theorem house_eq_one_iff {x : F} (hx : IsIntegral ℤ x) :
    house x = 1 ↔ ∃ n : ℕ, 0 < n ∧ x ^ n = 1 := by
  refine ⟨fun h ↦ ?_, fun ⟨n, hn, hxn⟩ ↦ ?_⟩
  · have h0 : x ≠ 0 := by
      rintro rfl
      simp at h
    have halg : IsAlgebraic ℚ x := (hx.tower_top (A := ℚ)).isAlgebraic
    obtain ⟨K, _, a, -, rfl, -⟩ := exists_numberField_mem halg halg
    rw [house_coe] at h
    rw [← IntermediateField.algebraMap_apply, isIntegral_algebraMap_iff] at hx
    obtain ⟨n, hn, han⟩ := NumberField.Embeddings.pow_eq_one_of_norm_le_one K ℂ
      (by simpa using h0) hx fun φ ↦ (NumberField.norm_embedding_le_house a φ).trans h.le
    exact ⟨n, hn, by rw [← IntermediateField.coe_pow, han, IntermediateField.coe_one]⟩
  · have h := house_pow x n
    rw [hxn, house_one] at h
    exact ((pow_eq_one_iff_of_nonneg (house_nonneg x) hn.ne').mp h.symm)

/-- The house is at most the Mahler measure. For an algebraic `x` the largest conjugate modulus is
one factor `max(1, |z|)` of `M(x) = a₀ ∏ max(1, |z|)`; for transcendental `x` this reads
`0 ≤ 1`. -/
theorem house_le_mahlerMeasure (x : F) : house x ≤ mahlerMeasure x := by
  classical
  refine (house_le_iff (zero_le_one.trans (one_le_mahlerMeasure x))).2 fun z hz ↦ ?_
  have hz' : z ∈ (minpoly ℚ x).aroots ℂ := mem_aroots'.2 (mem_rootSet'.1 hz)
  have ha₀ : (1 : ℝ) ≤ (primitiveMinpoly x).leadingCoeff := by
    exact_mod_cast (leadingCoeff_primitiveMinpoly_pos x)
  have hprod : 1 ≤ (((minpoly ℚ x).aroots ℂ).erase z |>.map fun z ↦ max 1 ‖z‖).prod :=
    Multiset.one_le_prod fun _ hw ↦ by
      obtain ⟨w, -, rfl⟩ := Multiset.mem_map.1 hw
      exact le_max_left _ _
  rw [mahlerMeasure_eq_leadingCoeff_mul_prod, ← Multiset.prod_map_erase hz']
  calc ‖z‖ ≤ max 1 ‖z‖ * 1 := by simp
    _ ≤ max 1 ‖z‖ * _ := by gcongr
    _ ≤ _ := le_mul_of_one_le_left (by positivity) ha₀

/-- The Mahler measure is at most `a₀ max(1, ⌈x⌉)ᵈ`, where `a₀` is the leading coefficient of the
primitive minimal polynomial and `d` the degree of `x`. -/
theorem mahlerMeasure_le_leadingCoeff_mul_max_one_house_pow (x : F) :
    mahlerMeasure x ≤
      (primitiveMinpoly x).leadingCoeff * max 1 (house x) ^ (minpoly ℚ x).natDegree := by
  have ha₀ : (0 : ℝ) ≤ (primitiveMinpoly x).leadingCoeff := by
    exact_mod_cast (leadingCoeff_primitiveMinpoly_pos x).le
  rw [mahlerMeasure_eq_leadingCoeff_mul_prod, ← IsAlgClosed.card_aroots_eq_natDegree (B := ℂ),
    ← Multiset.prod_replicate, ← Multiset.map_const']
  gcongr
  refine Multiset.prod_map_le_prod_map₀ _ _ (fun _ _ ↦ by positivity) fun z hz ↦ ?_
  gcongr
  exact norm_le_house_of_mem_rootSet (mem_rootSet'.2 (mem_aroots'.1 hz))

/-! ### Examples -/

/- The house of `-2` is `2`. -/
example : house (-2 : ℂ) = 2 := by
  simpa using house_intCast (F := ℂ) (-2)

/- The house of `i` is `1`: it is an algebraic integer and a root of unity. -/
example : house Complex.I = 1 :=
  (house_eq_one_iff (Complex.isIntegral_I ℤ)).mpr ⟨4, by norm_num, Complex.I_pow_four⟩

/- On `ℚ`, the house agrees with Mathlib's number-field house. -/
example : house (2 : ℚ) = NumberField.house (2 : ℚ) :=
  house_eq_numberField_house 2

end TauCeti
