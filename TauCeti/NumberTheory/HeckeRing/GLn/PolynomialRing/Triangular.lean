module

public import TauCeti.NumberTheory.HeckeRing.GLn.LeadingCoefficient
public import TauCeti.NumberTheory.HeckeRing.GLn.ProductSupport
public import TauCeti.NumberTheory.HeckeRing.GLn.PolynomialRing.Injective
public import TauCeti.NumberTheory.HeckeRing.GLn.PolynomialRing.LeadingExponent
import TauCeti.Algebra.BigOperators.Finset.PartialSum

/-!
# The triangular expansion of Hecke monomials and Shimura's Theorem 3.20

Let `p` be a prime. The `p`-local Hecke ring `pLocalSubring n p` of `GL_n` is generated by the
diagonal cosets `heckeGen k = T(1, …, 1, p, …, p)`, and **Shimura's Theorem 3.20** says that it is
the polynomial ring `ℤ[X₁, …, Xₙ]` on them. This file proves the theorem at every rank `n`.

The proof is a triangular expansion. Order the monotone exponent vectors of a fixed total by
dominance of their leading partial sums: `g` lies below `f` when
`∑_{j < k} f j ≤ ∑_{j < k} g j` for every `k ≤ n`. For a product of two diagonal cosets
`T(p ^ f) · T(p ^ f')`, every coset of the support lies below `f + f'`
(`exists_primePowDiag_of_diagElem_mul_apply_ne_zero`) and `T(p ^ (f + f'))` occurs with
coefficient one (`diagElem_primePowDiag_mul_apply_diagCoset_add`). Extending both
statements to products of arbitrary elements with a leading term shows that the monomial
`∏ k, heckeGen k ^ e k` is `T(p ^ leadingExponent e)` plus cosets lying strictly below it.

* *Injectivity.* The vector `leadingExponent e` determines `e` (`leadingExponent_injective`).
  In a nonzero polynomial, a monomial whose leading vector is maximal for the order contributes
  its coefficient to the coset of that vector, and no other monomial contributes there.
* *Surjectivity.* Every monotone `g` is `leadingExponent e` for some `e`, so `T(p ^ g)` is the
  monomial with exponents `e` minus cosets lying strictly below `g`. These are in the image by
  induction, because the sum of all leading partial sums strictly increases down the order and
  is bounded by `(n + 1)` times the total.

The partial sums are the prefix sums `TauCeti.prefixSum`, and the two order facts used, that
prefix sums determine a vector and that the sum of all prefix sums detects equality along the
order, are `TauCeti.eq_of_forall_prefixSum_eq` and
`TauCeti.eq_of_prefixSum_le_of_sum_range_prefixSum_le`.

## Main results

* `HeckeRing.GLn.prod_heckeGen_pow_apply_diagCoset_leadingExponent`: the coset
  `T(p ^ leadingExponent e)` occurs in `∏ k, heckeGen k ^ e k` with coefficient one.
* `HeckeRing.GLn.exists_primePowDiag_of_prod_heckeGen_pow_apply_ne_zero`: every coset in the
  support of `∏ k, heckeGen k ^ e k` is `T(p ^ g)` for a monotone `g` of the same total whose
  leading partial sums dominate those of `leadingExponent e`.
* `HeckeRing.GLn.evalHom_injective`, `HeckeRing.GLn.evalHomLocal_surjective`: the two halves of
  Theorem 3.20.
* `HeckeRing.GLn.polynomialRingEquiv`: **Shimura, Theorem 3.20**,
  `ℤ[X₁, …, Xₙ] ≃+* pLocalSubring n p`.

## References

* [G. Shimura, *Introduction to the arithmetic theory of automorphic functions*][shimura1971],
  §3.2, Theorem 3.20.
-/

public section

open Finset HeckeRing TauCeti

namespace HeckeRing.GLn

attribute [local instance] commSemiringIntegralHeckeRingLocal

variable {n : ℕ}

/-! ### Elements with a leading term -/

variable [NeZero n]

variable (p : ℕ)

/-- `x` is supported on cosets `T(p ^ g)` with `g` monotone, of the same total as `f`, and lying
below `f`: every prefix sum of `g` is at least that of `f`. -/
private def IsBelow (f : Fin n → ℕ) (x : IntegralHeckeRing n) : Prop :=
  ∀ D, x D ≠ 0 → ∃ g : Fin n → ℕ, Monotone g ∧ D = diagCoset (primePowDiag n p g) ∧
    ∑ i, g i = ∑ i, f i ∧ ∀ k ≤ n, prefixSum k f ≤ prefixSum k g

/-- `x` lies below `f` and has coefficient `1` at `T(p ^ f)`. -/
private def IsLeading (f : Fin n → ℕ) (x : IntegralHeckeRing n) : Prop :=
  IsBelow p f x ∧ x (diagCoset (primePowDiag n p f)) = 1

variable {p}

/-- In a product of an element below `f` and an element below `f'`, only the pair of leading
cosets `T(p ^ f)`, `T(p ^ f')` contributes to the coefficient of `T(p ^ (f + f'))`. -/
private lemma eq_of_structureConstants_apply_ne_zero (hp : p.Prime) {f f' : Fin n → ℕ}
    (hf : Monotone f) (hf' : Monotone f') {x y : IntegralHeckeRing n} (hx : IsBelow p f x)
    (hy : IsBelow p f' y) {D₁ D₂ : HeckeCoset (posDetInt n) (SLnZ n) (SLnZ n)} (h₁ : x D₁ ≠ 0)
    (h₂ : y D₂ ≠ 0)
    (h : HeckeCosetModule.structureConstants ℤ (SLnZ n) (SLnZ n) (SLnZ n) D₁.rep D₂.rep
      (diagCoset (primePowDiag n p (f + f'))) ≠ 0) :
    D₁ = diagCoset (primePowDiag n p f) ∧ D₂ = diagCoset (primePowDiag n p f') := by
  obtain ⟨g, hg, rfl, -, hfg⟩ := hx D₁ h₁
  obtain ⟨g', hg', rfl, -, hfg'⟩ := hy D₂ h₂
  rw [← diagElem_mul_diagElem] at h
  obtain ⟨h', hh', hD, -, hdom⟩ := exists_primePowDiag_of_diagElem_mul_apply_ne_zero hp hg hg' h
  obtain rfl := eq_of_diagCoset_primePowDiag_eq n hp.one_lt (hf.add hf') hh' hD
  -- `f + f'` lies below `g + g'`, while `g` and `g'` lie below `f` and `f'`
  have key (k : ℕ) (hk : k ≤ n) :
      prefixSum k g = prefixSum k f ∧ prefixSum k g' = prefixSum k f' := by
    have := hdom k hk
    have := hfg k hk
    have := hfg' k hk
    simp only [Finset.sum_add_distrib, sum_castLE_eq_prefixSum] at *
    omega
  rw [eq_of_forall_prefixSum_eq fun k hk ↦ (key k hk).1,
    eq_of_forall_prefixSum_eq fun k hk ↦ (key k hk).2]
  exact ⟨rfl, rfl⟩

/-- A product of an element below `f` and an element below `f'` lies below `f + f'`. -/
private lemma IsBelow.mul (hp : p.Prime) {f f' : Fin n → ℕ} {x y : IntegralHeckeRing n}
    (hx : IsBelow p f x) (hy : IsBelow p f' y) : IsBelow p (f + f') (x * y) := by
  intro D hD
  rw [HeckeCosetModule.mul_def, HeckeCosetModule.mul_apply] at hD
  obtain ⟨D₁, hD₁, hD₁'⟩ := Finset.exists_ne_zero_of_sum_ne_zero hD
  obtain ⟨D₂, hD₂, hD₂'⟩ := Finset.exists_ne_zero_of_sum_ne_zero hD₁'
  obtain ⟨g, hg, rfl, hgsum, hfg⟩ := hx D₁ (HeckeCosetModule.mem_support_iff.mp hD₁)
  obtain ⟨g', hg', rfl, hgsum', hfg'⟩ := hy D₂ (HeckeCosetModule.mem_support_iff.mp hD₂)
  have hsc : (diagElem (primePowDiag n p g) * diagElem (primePowDiag n p g')) D ≠ 0 := by
    rw [diagElem_mul_diagElem]
    exact right_ne_zero_of_mul (right_ne_zero_of_mul hD₂')
  obtain ⟨h, hh, rfl, hsum, hdom⟩ :=
    exists_primePowDiag_of_diagElem_mul_apply_ne_zero hp hg hg' hsc
  refine ⟨h, hh, rfl, ?_, fun k hk ↦ ?_⟩
  · simp only [hsum, Finset.sum_add_distrib, hgsum, hgsum', Pi.add_apply]
  · calc prefixSum k (f + f') ≤ prefixSum k (g + g') := by
          rw [prefixSum_add, prefixSum_add]
          exact add_le_add (hfg k hk) (hfg' k hk)
      _ ≤ prefixSum k h := by
          simpa only [← sum_castLE_eq_prefixSum hk, Pi.add_apply] using hdom k hk

/-- The coefficient of `T(p ^ (f + f'))` in a product of an element below `f` and an element
below `f'` is the product of their coefficients at `T(p ^ f)` and `T(p ^ f')`. -/
private lemma IsBelow.mul_apply_diagCoset_add (hp : p.Prime) {f f' : Fin n → ℕ}
    (hf : Monotone f) (hf' : Monotone f') {x y : IntegralHeckeRing n} (hx : IsBelow p f x)
    (hy : IsBelow p f' y) :
    (x * y) (diagCoset (primePowDiag n p (f + f'))) =
      x (diagCoset (primePowDiag n p f)) * y (diagCoset (primePowDiag n p f')) := by
  rw [HeckeCosetModule.mul_def, HeckeCosetModule.mul_apply,
    Finset.sum_eq_single (diagCoset (primePowDiag n p f))]
  · rw [Finset.sum_eq_single (diagCoset (primePowDiag n p f'))]
    · rw [← diagElem_mul_diagElem, diagElem_primePowDiag_mul_apply_diagCoset_add hp.pos hf hf',
        mul_one]
    · intro D₂ hD₂ hne
      by_cases hx₁ : x (diagCoset (primePowDiag n p f)) = 0
      · rw [hx₁, zero_mul]
      by_contra hc
      exact hne (eq_of_structureConstants_apply_ne_zero hp hf hf' hx hy hx₁
        (HeckeCosetModule.mem_support_iff.mp hD₂)
        (right_ne_zero_of_mul (right_ne_zero_of_mul hc))).2
    · intro hD₂
      rw [HeckeCosetModule.notMem_support_iff.mp hD₂, zero_mul, mul_zero]
  · intro D₁ hD₁ hne
    refine Finset.sum_eq_zero fun D₂ hD₂ ↦ ?_
    by_contra hc
    exact hne (eq_of_structureConstants_apply_ne_zero hp hf hf' hx hy
      (HeckeCosetModule.mem_support_iff.mp hD₁) (HeckeCosetModule.mem_support_iff.mp hD₂)
      (right_ne_zero_of_mul (right_ne_zero_of_mul hc))).1
  · intro hD₁
    rw [HeckeCosetModule.notMem_support_iff.mp hD₁]
    exact Finset.sum_eq_zero fun _ _ ↦ zero_mul _

private lemma IsLeading.mul (hp : p.Prime) {f f' : Fin n → ℕ} (hf : Monotone f)
    (hf' : Monotone f') {x y : IntegralHeckeRing n} (hx : IsLeading p f x)
    (hy : IsLeading p f' y) : IsLeading p (f + f') (x * y) :=
  ⟨hx.1.mul hp hy.1, by rw [hx.1.mul_apply_diagCoset_add hp hf hf' hy.1, hx.2, hy.2, mul_one]⟩

omit [NeZero n] in
private lemma isLeading_diagElem {f : Fin n → ℕ} (hf : Monotone f) :
    IsLeading p f (diagElem (primePowDiag n p f)) := by
  classical
  refine ⟨fun D hD ↦ ⟨f, hf, ?_, rfl, fun _ _ ↦ le_rfl⟩, ?_⟩
  · rw [diagElem_def, HeckeCosetModule.single_apply] at hD
    exact (ite_ne_right_iff.mp hD).1.symm
  · rw [diagElem_def, HeckeCosetModule.single_apply, ite_eq_left_iff.mpr fun h ↦ (h rfl).elim]

omit [NeZero n] in
private lemma isLeading_one : IsLeading p (0 : Fin n → ℕ) 1 := by
  have h : primePowDiag n p 0 = fun _ ↦ 1 := funext fun i ↦ by simp [primePowDiag_apply]
  have h1 := isLeading_diagElem (p := p) (f := (0 : Fin n → ℕ)) monotone_const
  rwa [h, diagElem_one] at h1

private lemma isLeading_heckeGen_pow (hp : p.Prime) (k : Fin n) (m : ℕ) :
    IsLeading p (leadingExponent (Pi.single k m)) (heckeGen n p k ^ m) := by
  induction m with
  | zero => simpa using isLeading_one
  | succ m ih =>
    rw [pow_succ, Pi.single_add, map_add]
    refine ih.mul hp (leadingExponent_monotone _) (leadingExponent_monotone _) ?_
    rw [leadingExponent_single, heckeGen_def, heckeGenDiag_eq_primePowDiag]
    exact isLeading_diagElem (heckeGenExponent_monotone n k)

private lemma isLeading_prod_heckeGen_pow (hp : p.Prime) (e : Fin n → ℕ) :
    IsLeading p (leadingExponent e) (∏ k, heckeGen n p k ^ e k) := by
  classical
  suffices h : ∀ s : Finset (Fin n), IsLeading p (leadingExponent (∑ k ∈ s, Pi.single k (e k)))
      (∏ k ∈ s, heckeGen n p k ^ e k) by
    simpa only [Finset.univ_sum_single] using h univ
  intro s
  induction s using Finset.induction_on with
  | empty => simpa using isLeading_one
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.sum_insert ha, map_add]
    exact (isLeading_heckeGen_pow hp a (e a)).mul hp (leadingExponent_monotone _)
      (leadingExponent_monotone _) ih

/-! ### The triangular expansion of a monomial -/

/-- **The leading coefficient of a Hecke monomial.** The coset `T(p ^ leadingExponent e)` occurs
in `∏ k, heckeGen k ^ e k` with coefficient one. -/
theorem prod_heckeGen_pow_apply_diagCoset_leadingExponent (hp : p.Prime) (e : Fin n → ℕ) :
    (∏ k, heckeGen n p k ^ e k) (diagCoset (primePowDiag n p (leadingExponent e))) = 1 :=
  (isLeading_prod_heckeGen_pow hp e).2

/-- **The support of a Hecke monomial lies below its leading coset.** Every double coset
occurring in `∏ k, heckeGen k ^ e k` is `T(p ^ g)` for a monotone exponent vector `g` with the
total of `leadingExponent e`, whose leading partial sums dominate those of `leadingExponent e`. -/
theorem exists_primePowDiag_of_prod_heckeGen_pow_apply_ne_zero (hp : p.Prime) (e : Fin n → ℕ)
    {D : HeckeCoset (posDetInt n) (SLnZ n) (SLnZ n)} (h : (∏ k, heckeGen n p k ^ e k) D ≠ 0) :
    ∃ g : Fin n → ℕ, Monotone g ∧ D = diagCoset (primePowDiag n p g) ∧
      ∑ i, g i = ∑ i, leadingExponent e i ∧
      ∀ (k : ℕ) (hk : k ≤ n), ∑ j : Fin k, leadingExponent e (Fin.castLE hk j) ≤
        ∑ j : Fin k, g (Fin.castLE hk j) := by
  obtain ⟨g, hg, hD, hsum, hdom⟩ := (isLeading_prod_heckeGen_pow hp e).1 D h
  exact ⟨g, hg, hD, hsum, fun k hk ↦ by simpa only [sum_castLE_eq_prefixSum] using hdom k hk⟩

/-! ### Shimura's Theorem 3.20 -/

variable (n p)

/-- **The presentation is injective**: the generators `heckeGen k` of the `p`-local Hecke ring
are algebraically independent over `ℤ`. -/
theorem evalHom_injective (hp : p.Prime) : Function.Injective (evalHom n p) := by
  intro P Q hPQ
  rw [← sub_eq_zero]
  set R := P - Q
  have hR : evalHom n p R = 0 := by simp [R, map_sub, hPQ]
  by_contra hne
  -- a monomial whose leading vector is maximal
  obtain ⟨s, hs, hmin⟩ := Finset.exists_min_image R.support
    (fun d : Fin n →₀ ℕ ↦ ∑ k ∈ range (n + 1), prefixSum k (leadingExponent ⇑d))
    (MvPolynomial.support_nonempty.mpr hne)
  have h0 : evalHom n p R (diagCoset (primePowDiag n p (leadingExponent ⇑s))) = 0 := by
    rw [hR, HeckeCosetModule.zero_apply]
  rw [evalHom_apply, Finset.sum_eq_single s] at h0
  · rw [prod_heckeGen_pow_apply_diagCoset_leadingExponent hp, smul_eq_mul, mul_one] at h0
    exact MvPolynomial.mem_support_iff.mp hs h0
  · intro d hd hds
    rw [smul_eq_mul]
    by_contra hc
    obtain ⟨g, hg, hD, -, hdom⟩ :=
      (isLeading_prod_heckeGen_pow hp d).1 _ (right_ne_zero_of_mul hc)
    obtain rfl := eq_of_diagCoset_primePowDiag_eq n hp.one_lt (leadingExponent_monotone _) hg hD
    exact hds (DFunLike.coe_injective (leadingExponent_injective
      (eq_of_prefixSum_le_of_sum_range_prefixSum_le hdom (hmin d hd))))
  · exact fun hs' ↦ (hs' hs).elim

/-- The `p`-local Hecke ring lies in the image of the presentation: every monotone `p`-power
diagonal coset is a polynomial in the generators `heckeGen k`. -/
theorem pLocalSubring_le_evalHom_range (hp : p.Prime) :
    pLocalSubring n p ≤ (evalHom n p).range := by
  classical
  rw [pLocalSubring_le_iff]
  intro g hg
  induction hN : (n + 1) * ∑ i, g i - ∑ k ∈ range (n + 1), prefixSum k g
    using Nat.strong_induction_on
    generalizing g with
  | _ N ih =>
  -- the monomial whose leading coset is `T(p ^ g)`
  set e := Fin.invAccumulate n n (g ∘ Fin.rev)
  have he : leadingExponent e = g := funext fun i ↦ by
    rw [leadingExponent_apply, Fin.accumulate_invAccumulate le_rfl
      (hg.comp_antitone fun _ _ h ↦ Fin.rev_le_rev.mpr h)]
    simp
  set x := ∏ k, heckeGen n p k ^ e k
  have hx : IsLeading p g x := he ▸ isLeading_prod_heckeGen_pow hp e
  have hxr : x ∈ (evalHom n p).range :=
    ⟨∏ k, MvPolynomial.X k ^ e k, by simp only [map_prod, map_pow, evalHom_X, x]⟩
  -- split off the leading coset of `x`
  set T := diagCoset (primePowDiag n p g)
  have hT : T ∈ x.support :=
    HeckeCosetModule.mem_support_iff.mpr (by rw [hx.2]; exact one_ne_zero)
  have hsplit := ((HeckeCosetModule.sum_single ℤ x).symm.trans
    (HeckeCosetModule.sum_def _ _)).trans (Finset.sum_erase_add _ _ hT).symm
  rw [hx.2, ← diagElem_def] at hsplit
  rw [eq_sub_of_add_eq' hsplit.symm]
  refine Subring.sub_mem _ hxr (Subring.sum_mem _ fun D hD ↦ ?_)
  -- the remaining cosets lie strictly below `g`
  obtain ⟨hDT, hDx⟩ := Finset.mem_erase.mp hD
  obtain ⟨h, hh, rfl, hhsum, hdom⟩ := hx.1 D (HeckeCosetModule.mem_support_iff.mp hDx)
  have hlt : ∑ k ∈ range (n + 1), prefixSum k g < ∑ k ∈ range (n + 1), prefixSum k h :=
    lt_of_le_of_ne (sum_le_sum fun k hk ↦ hdom k (Nat.lt_succ_iff.mp (mem_range.mp hk)))
      fun heq ↦ hDT (by rw [(eq_of_prefixSum_le_of_sum_range_prefixSum_le hdom heq.ge).symm])
  -- every prefix sum is at most the total, which bounds the measure
  have hle : ∑ k ∈ range (n + 1), prefixSum k h ≤ (n + 1) * ∑ i, h i := by
    calc ∑ k ∈ range (n + 1), prefixSum k h ≤ ∑ _k ∈ range (n + 1), ∑ i, h i :=
          sum_le_sum fun k _ ↦ prefixSum_le_sum k fun i ↦ Nat.zero_le (h i)
      _ = (n + 1) * ∑ i, h i := by simp
  have hmem := ih ((n + 1) * ∑ i, h i - ∑ k ∈ range (n + 1), prefixSum k h)
    (by rw [hhsum] at hle ⊢; omega) h hh rfl
  rw [← HeckeCosetModule.smul_single_one, ← diagElem_def]
  exact Subring.zsmul_mem _ hmem _

/-- **The presentation is onto**: `ℤ[X₁, …, Xₙ] ↠ R_p`, the surjectivity half of Shimura's
Theorem 3.20. -/
theorem evalHomLocal_surjective (hp : p.Prime) :
    Function.Surjective (evalHomLocal n p) := by
  rintro ⟨y, hy⟩
  obtain ⟨f, hf⟩ := pLocalSubring_le_evalHom_range n p hp hy
  exact ⟨f, Subtype.ext ((evalHomLocal_coe n p f).trans hf)⟩

/-- **Shimura, Theorem 3.20**: for a prime `p`, the `p`-local Hecke ring of `GL_n` is the
polynomial ring `ℤ[X₁, …, Xₙ]` on the generators `T(1, …, 1, p, …, p)`. -/
noncomputable def polynomialRingEquiv (hp : p.Prime) :
    MvPolynomial (Fin n) ℤ ≃+* pLocalSubring n p :=
  RingEquiv.ofBijective (evalHomLocal n p)
    ⟨evalHomLocal_injective n p (evalHom_injective n p hp), evalHomLocal_surjective n p hp⟩

/-- The presentation isomorphism is the evaluation map. -/
@[simp] lemma polynomialRingEquiv_apply (hp : p.Prime)
    (f : MvPolynomial (Fin n) ℤ) : polynomialRingEquiv n p hp f = evalHomLocal n p f := (rfl)

end HeckeRing.GLn
