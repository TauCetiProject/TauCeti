module

public import Mathlib.RingTheory.Localization.Away.Basic
public import TauCeti.NumberTheory.HeckeRing.GLn.PolynomialRing.Presentation
public import TauCeti.NumberTheory.HeckeRing.GLn.Rational

import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-!
# Laurent presentation of the `p`-local `GL_n` Hecke ring

Following Proposition 3.16 and Theorem 3.20 of [Shimura][shimura1971] together with §2 of
[Rhodes–Shemanske][rhodes1999], adjoining the inverse of `heckeGen n p (Fin.rev 0) = T(p, …, p)` to
`pLocalSubring n p` inside `RationalHeckeRing n` produces `pLocalRationalSubring n p`, generated by
the monotone integer-exponent `p`-power diagonal operators `intPowDiagElem n p e`. The inclusion
`integralToRationalLocal n p : pLocalSubring n p →+* pLocalRationalSubring n p` satisfies the
universal property of localization away from `heckeGen n p (Fin.rev 0)`, presenting
`pLocalRationalSubring n p` for `p` prime as `Localization.Away (X (Fin.rev 0))`.

## Main definitions

* `HeckeRing.GLn.intPowDiagGL`, `HeckeRing.GLn.intPowDiagCoset`, `HeckeRing.GLn.intPowDiagElem`:
  `p`-power diagonal matrices `diag(p ^ e₁, …, p ^ eₙ) ∈ GL_n^+(ℚ)` (`e : Fin n → ℤ`), their
  `SL_n(ℤ)`-double cosets, and the corresponding basis elements of `RationalHeckeRing n`.
* `HeckeRing.GLn.pLocalRationalSubring`: the `p`-local rational Hecke subring of
  `RationalHeckeRing n`.
* `HeckeRing.GLn.integralToRationalLocal`, `HeckeRing.GLn.scalarLocalUnit`,
  `HeckeRing.GLn.pLocalRationalSubringLift`: the restriction `pLocalSubring n p →+*
  pLocalRationalSubring n p`, the bundled unit `T(p, …, p)`, and the universal-property lift.
* `HeckeRing.GLn.laurentEvalHomLocal`, `HeckeRing.GLn.laurentPolynomialRingEquiv`: the localized
  evaluation homomorphism and isomorphism `Localization.Away (X (Fin.rev 0)) ≃+*
  pLocalRationalSubring n p` for `p` prime.

## Main results

* `HeckeRing.GLn.pLocalRationalSubring_eq_closure_image_insert_inv`,
  `HeckeRing.GLn.exists_mul_scalarLocalUnit_pow_eq`: subring generation and denominator clearing in
  `pLocalRationalSubring n p`.
* `HeckeRing.GLn.pLocalRationalSubring_ringHom_ext`,
  `HeckeRing.GLn.eq_pLocalRationalSubringLift_iff`: uniqueness and universal property along
  `integralToRationalLocal n p`.
* `HeckeRing.GLn.laurentEvalHomLocal_injective`, `HeckeRing.GLn.laurentEvalHomLocal_surjective`:
  bijectivity of the localized presentation map for `p` prime.

## References

* [G. Shimura, *Introduction to the arithmetic theory of automorphic functions*][shimura1971],
  Proposition 3.16 and Theorem 3.20.
* [J. A. Rhodes and T. R. Shemanske,
  *Rationality theorems for Hecke operators on GL_n*][rhodes1999], §2.
-/

public section

open Matrix Subgroup DoubleCoset

open scoped Pointwise HeckeCosetModule

namespace HeckeRing.GLn

variable (n : ℕ)

attribute [local instance] commRingRationalHeckeRing

section PLocalRational

/-- The `p`-power diagonal matrix `diag(p ^ e₁, …, p ^ eₙ) ∈ GL_n(ℚ)` with integer exponents
`e : Fin n → ℤ` for `p ≠ 0`, taking the junk value `1` at `p = 0` to match `natDiagGL`. -/
noncomputable def intPowDiagGL (p : ℕ) (e : Fin n → ℤ) : GL (Fin n) ℚ :=
  if hp : p = 0 then 1
  else TauCeti.diagGL fun i ↦ Units.mk0 (p : ℚ) (Nat.cast_ne_zero.mpr hp) ^ e i

/-- Formula for `intPowDiagGL` when `0 < p`. -/
theorem intPowDiagGL_of_pos {p : ℕ} (hp : 0 < p) (e : Fin n → ℤ) :
    intPowDiagGL n p e =
      TauCeti.diagGL fun i ↦ Units.mk0 (p : ℚ) (Nat.cast_ne_zero.mpr hp.ne') ^ e i :=
  dite_eq_right hp.ne'

/-- Matrix coercion of `intPowDiagGL` for `0 < p`. -/
@[simp]
theorem intPowDiagGL_coe {p : ℕ} (hp : 0 < p) (e : Fin n → ℤ) :
    (↑(intPowDiagGL n p e) : Matrix (Fin n) (Fin n) ℚ) =
      Matrix.diagonal fun i ↦ (p : ℚ) ^ e i := by
  rw [intPowDiagGL_of_pos n hp, TauCeti.diagGL_coe]; congr 1; funext i
  rw [Units.val_zpow_eq_zpow_val, Units.val_mk0]

/-- `intPowDiagGL` at the zero exponent vector is `1`. -/
@[simp]
theorem intPowDiagGL_zero (p : ℕ) : intPowDiagGL n p 0 = 1 := by
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · simp [intPowDiagGL]
  · exact Units.ext (by simp [intPowDiagGL_coe n hp])

/-- `intPowDiagGL` converts addition of exponent vectors into matrix multiplication. -/
@[simp]
theorem intPowDiagGL_add (p : ℕ) (e f : Fin n → ℤ) :
    intPowDiagGL n p (e + f) = intPowDiagGL n p e * intPowDiagGL n p f := by
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · simp [intPowDiagGL]
  · exact Units.ext (by
      simp [intPowDiagGL_coe n hp, zpow_add₀ (Nat.cast_ne_zero.mpr hp.ne' : (p : ℚ) ≠ 0)])

/-- `intPowDiagGL` converts negation of exponent vectors into group inversion. -/
@[simp]
theorem intPowDiagGL_neg (p : ℕ) (e : Fin n → ℤ) :
    intPowDiagGL n p (-e) = (intPowDiagGL n p e)⁻¹ :=
  eq_inv_of_mul_eq_one_left (by rw [← intPowDiagGL_add, neg_add_cancel, intPowDiagGL_zero])

/-- Every `p`-power diagonal matrix `intPowDiagGL n p e` has positive rational determinant. -/
theorem intPowDiagGL_mem_glpos (p : ℕ) (e : Fin n → ℤ) :
    intPowDiagGL n p e ∈ Matrix.GLPos (Fin n) ℚ := by
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · simp [intPowDiagGL]
  · rw [Matrix.mem_glpos, Matrix.GeneralLinearGroup.val_det_apply, intPowDiagGL_coe n hp,
      Matrix.det_diagonal]
    exact Finset.prod_pos fun i _ ↦ zpow_pos (Nat.cast_pos.mpr hp) (e i)

/-- On natural exponents, `intPowDiagGL` agrees with `natDiagGL` of `primePowDiag`. -/
theorem intPowDiagGL_natCast (p : ℕ) (e : Fin n → ℕ) :
    intPowDiagGL n p (fun i ↦ (e i : ℤ)) = natDiagGL n (primePowDiag n p e) := by
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · simp only [intPowDiagGL, ↓reduceDIte]
    by_cases he : ∀ i, e i = 0
    · have hpp : primePowDiag n 0 e = fun _ ↦ 1 := funext fun i ↦ by simp [he i]
      rw [hpp, natDiagGL_one]
    · obtain ⟨i, hi⟩ := not_forall.mp he
      exact (natDiagGL_of_not_pos n fun h ↦ absurd (h i)
        (by simp [primePowDiag_apply, Nat.zero_pow (Nat.pos_of_ne_zero hi)])).symm
  · exact Units.ext (by simp [intPowDiagGL_coe n hp, natDiagGL_coe n _ (primePowDiag_pos n p hp e)])

/-- At the constant exponent `-1`, `intPowDiagGL` is the inverse of `diag(p, …, p)`. -/
theorem intPowDiagGL_const_neg_one (p : ℕ) :
    intPowDiagGL n p (fun _ ↦ -1) = (natDiagGL n (fun _ ↦ p))⁻¹ := by
  have hneg : (fun _ : Fin n ↦ (-1 : ℤ)) = -(fun _ ↦ ((1 : ℕ) : ℤ)) := funext fun _ ↦ by simp
  rw [hneg, intPowDiagGL_neg, intPowDiagGL_natCast]
  exact congrArg Inv.inv (congrArg (natDiagGL n)
    (funext fun i ↦ (primePowDiag_apply n p (fun _ ↦ 1) i).trans (pow_one p)))

/-- Multiplying `intPowDiagGL n p e` by `diag(p ^ k, …, p ^ k)` shifts every exponent by `k`. -/
theorem intPowDiagGL_mul_natDiagGL_const (p : ℕ) (e : Fin n → ℤ) (k : ℕ) :
    intPowDiagGL n p e * natDiagGL n (fun _ ↦ p ^ k) =
      intPowDiagGL n p (fun i ↦ e i + (k : ℤ)) := by
  have hpow : (fun _ : Fin n ↦ p ^ k) = primePowDiag n p (fun _ ↦ k) :=
    funext fun i ↦ (primePowDiag_apply n p (fun _ ↦ k) i).symm
  rw [hpow, ← intPowDiagGL_natCast n p (fun _ ↦ k), ← intPowDiagGL_add, Pi.add_def]

/-- The `SL_n(ℤ)`-double coset in `GL_n^+(ℚ)` of `intPowDiagGL n p e`. -/
noncomputable def intPowDiagCoset (p : ℕ) (e : Fin n → ℤ) :
    HeckeCoset (Matrix.GLPos (Fin n) ℚ).toSubmonoid (SLnZ n) (SLnZ n) :=
  HeckeCoset.mk (SLnZ n) (SLnZ n) ⟨intPowDiagGL n p e, intPowDiagGL_mem_glpos n p e⟩

/-- Defining equation for `intPowDiagCoset`. -/
theorem intPowDiagCoset_def (p : ℕ) (e : Fin n → ℤ) :
    intPowDiagCoset n p e =
      HeckeCoset.mk (SLnZ n) (SLnZ n) ⟨intPowDiagGL n p e, intPowDiagGL_mem_glpos n p e⟩ := (rfl)

/-- At the zero exponent vector, `intPowDiagCoset` is the identity double coset `1`. -/
@[simp]
theorem intPowDiagCoset_zero (p : ℕ) : intPowDiagCoset n p 0 = 1 := by
  rw [intPowDiagCoset_def, HeckeCoset.one_def]
  exact HeckeCoset.mk_congr_val (intPowDiagGL_zero n p)

/-- The rational `p`-power diagonal Hecke operator `[SL_n(ℤ) · diag(p ^ e) · SL_n(ℤ)]` in
`RationalHeckeRing n`. -/
noncomputable def intPowDiagElem (p : ℕ) (e : Fin n → ℤ) : RationalHeckeRing n :=
  HeckeCosetModule.single ℤ (intPowDiagCoset n p e) 1

/-- Defining equation for `intPowDiagElem`. -/
theorem intPowDiagElem_def (p : ℕ) (e : Fin n → ℤ) :
    intPowDiagElem n p e = HeckeCosetModule.single ℤ (intPowDiagCoset n p e) 1 := (rfl)

/-- At the zero exponent vector, `intPowDiagElem` is the multiplicative identity `1`. -/
@[simp]
theorem intPowDiagElem_zero (p : ℕ) : intPowDiagElem n p 0 = 1 := by
  rw [intPowDiagElem_def, intPowDiagCoset_zero, HeckeCosetModule.one_def]

/-- The `p`-local rational Hecke subring of `RationalHeckeRing n`, generated by the monotone
integer-exponent `p`-power diagonal operators `intPowDiagElem n p e`. -/
noncomputable def pLocalRationalSubring (p : ℕ) : Subring (RationalHeckeRing n) :=
  Subring.closure {f | ∃ (e : Fin n → ℤ) (_ : Monotone e), f = intPowDiagElem n p e}

/-- Defining equation for `pLocalRationalSubring`. -/
theorem pLocalRationalSubring_def (p : ℕ) :
    pLocalRationalSubring n p =
      Subring.closure {f | ∃ (e : Fin n → ℤ) (_ : Monotone e), f = intPowDiagElem n p e} := (rfl)

/-- Every monotone `p`-power diagonal operator belongs to `pLocalRationalSubring n p`. -/
@[simp]
theorem intPowDiagElem_mem_pLocalRationalSubring (p : ℕ) (e : Fin n → ℤ) (hmono : Monotone e) :
    intPowDiagElem n p e ∈ pLocalRationalSubring n p :=
  Subring.subset_closure ⟨e, hmono, rfl⟩

/-- `pLocalRationalSubring n p` is contained in `S` iff `S` contains all monotone `p`-power diagonal
operators. -/
@[simp]
theorem pLocalRationalSubring_le_iff (p : ℕ) (S : Subring (RationalHeckeRing n)) :
    pLocalRationalSubring n p ≤ S ↔ ∀ e : Fin n → ℤ, Monotone e → intPowDiagElem n p e ∈ S := by
  rw [pLocalRationalSubring_def, Subring.closure_le]
  exact ⟨fun h e he ↦ h ⟨e, he, rfl⟩, fun h _ ⟨e, he, hf⟩ ↦ hf ▸ h e he⟩

/-- At the constant exponent `-1`, `intPowDiagElem` is the inverse of `T(p, …, p)`. -/
theorem intPowDiagElem_const_neg_one (p : ℕ) :
    intPowDiagElem n p (fun _ ↦ -1) = ↑(scalarUnit n p)⁻¹ := by
  rw [intPowDiagElem_def, intPowDiagCoset_def, val_inv_scalarUnit]
  exact congrArg (HeckeCosetModule.single ℤ · 1)
    (HeckeCoset.mk_congr_val (intPowDiagGL_const_neg_one n p))

/-- The inverse of `T(p, …, p)` belongs to `pLocalRationalSubring n p`. -/
theorem inv_scalarUnit_mem_pLocalRationalSubring (p : ℕ) :
    (↑(scalarUnit n p)⁻¹ : RationalHeckeRing n) ∈ pLocalRationalSubring n p :=
  intPowDiagElem_const_neg_one n p ▸ intPowDiagElem_mem_pLocalRationalSubring n p _ monotone_const

/-- Multiplying `intPowDiagElem n p e` by `T(p, …, p) ^ k` shifts every exponent upward by `k`. -/
theorem intPowDiagElem_mul_scalarUnit_pow (p : ℕ) (e : Fin n → ℤ) (k : ℕ) :
    intPowDiagElem n p e * (scalarUnit n p : RationalHeckeRing n) ^ k =
      intPowDiagElem n p (fun i ↦ e i + (k : ℤ)) := by
  rw [← Units.val_pow_eq_pow_val, scalarUnit_pow n p k, val_scalarUnit, integralToRational_diagElem,
    intPowDiagElem_def, intPowDiagElem_def, intPowDiagCoset_def, intPowDiagCoset_def,
    single_mul_natDiagGL_const n _ (p ^ k)]
  exact congrArg (HeckeCosetModule.single ℤ · 1)
    (HeckeCoset.mk_congr_val (intPowDiagGL_mul_natDiagGL_const n p e k))

/-- On natural exponents, `intPowDiagElem` is the image under `integralToRational` of
`diagElem (primePowDiag n p e)`. -/
theorem intPowDiagElem_natCast (p : ℕ) (e : Fin n → ℕ) :
    intPowDiagElem n p (fun i ↦ (e i : ℤ)) =
      integralToRational n (diagElem (primePowDiag n p e)) := by
  rw [intPowDiagElem_def, intPowDiagCoset_def, integralToRational_diagElem]
  exact congrArg (HeckeCosetModule.single ℤ · 1)
    (HeckeCoset.mk_congr_val (intPowDiagGL_natCast n p e))

/-- The integral `p`-local subring maps into `pLocalRationalSubring n p` under
`integralToRational`. -/
theorem integralToRational_mem_pLocalRationalSubring (p : ℕ)
    {x : IntegralHeckeRing n} (hx : x ∈ pLocalSubring n p) :
    integralToRational n x ∈ pLocalRationalSubring n p := by
  suffices pLocalSubring n p ≤ (pLocalRationalSubring n p).comap (integralToRational n) from this hx
  rw [pLocalSubring_def, Subring.closure_le]
  rintro _ ⟨e, he, rfl⟩
  rw [SetLike.mem_coe, Subring.mem_comap, ← intPowDiagElem_natCast n p e]
  exact intPowDiagElem_mem_pLocalRationalSubring n p _ fun _ _ hij ↦ Int.ofNat_le.mpr (he hij)

/-- **Subring presentation of `pLocalRationalSubring`**: `pLocalRationalSubring n p` is generated as
a subring of `RationalHeckeRing n` by the image of `pLocalSubring n p` together with
`T(p, …, p)⁻¹`. -/
theorem pLocalRationalSubring_eq_closure_image_insert_inv (p : ℕ) :
    pLocalRationalSubring n p = Subring.closure
      (insert (↑(scalarUnit n p)⁻¹ : RationalHeckeRing n)
        (integralToRational n '' (pLocalSubring n p : Set (IntegralHeckeRing n)))) := by
  apply le_antisymm
  · refine (pLocalRationalSubring_le_iff n p _).mpr fun e he ↦ ?_
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [Subsingleton.elim e 0, intPowDiagElem_zero]; exact Subring.one_mem _
    · let i₀ : Fin n := ⟨0, hn⟩
      let k : ℕ := (-e i₀).toNat
      let e' : Fin n → ℕ := fun i ↦ (e i + (k : ℤ)).toNat
      have he'_mono : Monotone e' := fun i j hij ↦ by have := he hij; dsimp only [e']; omega
      have he'_cast : (fun i ↦ (e' i : ℤ)) = fun i ↦ e i + (k : ℤ) :=
        funext fun i ↦ Int.toNat_of_nonneg (by
          have hmin : i₀ ≤ i := Fin.le_iff_val_le_val.mpr (Nat.zero_le i.1)
          have := he hmin; omega)
      have hdecomp : intPowDiagElem n p e = integralToRational n (diagElem (primePowDiag n p e')) *
          (↑(scalarUnit n p)⁻¹ : RationalHeckeRing n) ^ k := by
        rw [← intPowDiagElem_natCast n p e', he'_cast, ← intPowDiagElem_mul_scalarUnit_pow n p e k,
          mul_assoc, ← mul_pow, Units.mul_inv, one_pow, mul_one]
      rw [hdecomp]
      exact Subring.mul_mem _
        (Subring.subset_closure (Set.mem_insert_of_mem _
          ⟨_, diagElem_primePowDiag_mem_pLocalSubring n p e' he'_mono, rfl⟩))
        (Subring.pow_mem _ (Subring.subset_closure (Set.mem_insert _ _)) k)
  · rw [Subring.closure_le]
    rintro x (rfl | ⟨y, hy, rfl⟩)
    · exact inv_scalarUnit_mem_pLocalRationalSubring n p
    · exact integralToRational_mem_pLocalRationalSubring n p hy

/-- Restriction of `integralToRational n` to `pLocalSubring n p →+* pLocalRationalSubring n p`. -/
noncomputable def integralToRationalLocal (p : ℕ) :
    pLocalSubring n p →+* pLocalRationalSubring n p :=
  ((integralToRational n).comp (pLocalSubring n p).subtype).codRestrict
    (pLocalRationalSubring n p) fun x ↦ integralToRational_mem_pLocalRationalSubring n p x.2

/-- Coercion of `integralToRationalLocal` to `RationalHeckeRing n` agrees with
`integralToRational`. -/
@[simp]
theorem integralToRationalLocal_coe (p : ℕ) (x : pLocalSubring n p) :
    (integralToRationalLocal n p x : RationalHeckeRing n) = integralToRational n x := (rfl)

/-- `integralToRationalLocal` is injective. -/
theorem integralToRationalLocal_injective (p : ℕ) :
    Function.Injective (integralToRationalLocal n p) :=
  fun _ _ h ↦ Subtype.ext (integralToRational_injective n (congrArg Subtype.val h))

section NeZero

variable [NeZero n]

/-- The last Shimura generator `heckeGen n p (Fin.rev 0) = T(p, …, p)` bundled as a unit of
`pLocalRationalSubring n p`. -/
noncomputable def scalarLocalUnit (p : ℕ) : (pLocalRationalSubring n p)ˣ where
  val := integralToRationalLocal n p
    ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩
  inv := ⟨↑(scalarUnit n p)⁻¹, inv_scalarUnit_mem_pLocalRationalSubring n p⟩
  val_inv := Subtype.ext (by simp [-val_inv_scalarUnit, ← val_scalarUnit])
  inv_val := Subtype.ext (by simp [-val_inv_scalarUnit, ← val_scalarUnit])

/-- Underlying element of `scalarLocalUnit` inside `pLocalRationalSubring n p`. -/
@[simp]
theorem val_scalarLocalUnit (p : ℕ) :
    (scalarLocalUnit n p : pLocalRationalSubring n p) = integralToRationalLocal n p
      ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩ := (rfl)

/-- Ambient coercion of `(scalarLocalUnit n p)⁻¹` to `RationalHeckeRing n`. -/
@[simp]
theorem coe_inv_scalarLocalUnit (p : ℕ) :
    ((↑(scalarLocalUnit n p)⁻¹ : pLocalRationalSubring n p) : RationalHeckeRing n) =
      ↑(scalarUnit n p)⁻¹ := (rfl)

/-- **Denominator clearing in `pLocalRationalSubring`**: every element of
`pLocalRationalSubring n p` multiplies into the image of `pLocalSubring n p` under some power of
`T(p, …, p)`. -/
theorem exists_mul_scalarLocalUnit_pow_eq (p : ℕ) (z : pLocalRationalSubring n p) :
    ∃ (k : ℕ) (a : pLocalSubring n p),
      z * (scalarLocalUnit n p : pLocalRationalSubring n p) ^ k =
        integralToRationalLocal n p a := by
  let g₀ : pLocalSubring n p :=
    ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩
  let f : pLocalSubring n p →+* RationalHeckeRing n :=
    (integralToRational n).comp (pLocalSubring n p).subtype
  have hM : (Submonoid.powers g₀).map f ≤ (subalgebraOfSubring f.range).toSubmonoid := by
    rintro _ ⟨s, _, rfl⟩; exact ⟨s, rfl⟩
  let sat : Subring (RationalHeckeRing n) :=
    ((subalgebraOfSubring f.range).saturation ((Submonoid.powers g₀).map f) hM).toSubring
  have hsub : pLocalRationalSubring n p ≤ sat := by
    rw [pLocalRationalSubring_eq_closure_image_insert_inv, Subring.closure_le]
    rintro _ (rfl | ⟨w, hw, rfl⟩)
    · refine Subalgebra.mem_toSubring.mpr (Subalgebra.mem_saturation_iff.mpr
        ⟨f g₀, ⟨g₀, Submonoid.mem_powers g₀, rfl⟩, 1, ?_⟩)
      simp [f, g₀, -val_inv_scalarUnit, ← val_scalarUnit]
    · exact Subalgebra.mem_toSubring.mpr (Subalgebra.le_saturation (⟨⟨w, hw⟩, rfl⟩ : _ ∈ f.range))
  obtain ⟨_, ⟨_, ⟨k, rfl⟩, rfl⟩, a, hk⟩ :=
    Subalgebra.mem_saturation_iff.mp (Subalgebra.mem_toSubring.mp (hsub z.2))
  refine ⟨k, a, Subtype.ext ?_⟩
  have hk' : (z : RationalHeckeRing n) * f (g₀ ^ k) = f a :=
    (mul_comm (z : RationalHeckeRing n) (f (g₀ ^ k))).trans
      (by simpa only [smul_eq_mul] using hk.symm)
  simpa [f, g₀] using hk'

variable {n} in
omit [NeZero n] in
/-- Ring homomorphisms out of `pLocalRationalSubring n p` are uniquely determined by their
precomposition with `integralToRationalLocal n p`. -/
theorem pLocalRationalSubring_ringHom_ext {p : ℕ} {R : Type*} [Semiring R]
    {f₁ f₂ : pLocalRationalSubring n p →+* R}
    (h : f₁.comp (integralToRationalLocal n p) = f₂.comp (integralToRationalLocal n p)) :
    f₁ = f₂ := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · have hle : pLocalRationalSubring 0 p ≤ (pLocalSubring 0 p).map (integralToRational 0) :=
      (pLocalRationalSubring_le_iff 0 p _).mpr fun e _ ↦ by
        rw [Subsingleton.elim e 0, intPowDiagElem_zero]; exact Subring.one_mem _
    ext z; obtain ⟨a, ha, hza⟩ := Subring.mem_map.mp (hle z.2)
    exact (Subtype.ext hza.symm : z = integralToRationalLocal 0 p ⟨a, ha⟩) ▸
      RingHom.congr_fun h ⟨a, ha⟩
  · have : NeZero n := ⟨hn.ne'⟩
    ext z; obtain ⟨k, a, hk⟩ := exists_mul_scalarLocalUnit_pow_eq n p z
    let u : Rˣ := Units.map (f₁ : pLocalRationalSubring n p →* R) (scalarLocalUnit n p ^ k)
    have hu : (u : R) = f₂ (↑(scalarLocalUnit n p ^ k)) := by
      simpa only [u, Units.coe_map, MonoidHom.coe_ofClass, Units.val_pow_eq_pow_val,
        val_scalarLocalUnit, ← map_pow, RingHom.comp_apply] using RingHom.congr_fun h _
    refine u.mul_left_inj.mp ?_
    calc f₁ z * u = f₁ (integralToRationalLocal n p a) := by simp [u, ← hk]
      _ = f₂ (integralToRationalLocal n p a) := RingHom.congr_fun h a
      _ = f₂ z * u := by rw [← hk, map_mul, hu, Units.val_pow_eq_pow_val]

private noncomputable def pLocalRationalSubringLiftAux {p : ℕ} {R : Type*} [Semiring R]
    (g : pLocalSubring n p →+* R)
    (hg : IsUnit (g ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩)) :
    { f : pLocalRationalSubring n p →+* R // ∀ a, f (integralToRationalLocal n p a) = g a } :=
  let s₀ : pLocalSubring n p :=
    ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩
  have hmul_comm (a b : pLocalSubring n p) : a * b = b * a := Subtype.ext
    (HeckeCosetModule.mul_comm_of_antiInvolution ℤ (transposeAntiInvolution n)
      (transposeAntiInvolution_onHeckeCoset_eq_self n) a.1 b.1)
  letI : CommRing (pLocalSubring n p) := { (inferInstance : Ring _) with mul_comm := hmul_comm }
  letI : Algebra (pLocalSubring n p) (pLocalRationalSubring n p) :=
    (integralToRationalLocal n p).toAlgebra
  have : IsLocalization.Away s₀ (pLocalRationalSubring n p) :=
    IsLocalization.Away.mk s₀ (val_scalarLocalUnit n p ▸ (scalarLocalUnit n p).isUnit)
      (exists_mul_scalarLocalUnit_pow_eq n p)
      (fun _ _ hab ↦ ⟨0, by simp [integralToRationalLocal_injective n p hab]⟩)
  let S : Set R := insert (↑hg.unit⁻¹ : R) (Set.range g)
  have hcommS : S.Pairwise Commute := by
    have hcg (a b : pLocalSubring n p) : Commute (g a) (g b) := by
      rw [Commute, SemiconjBy, ← map_mul, ← map_mul, hmul_comm]
    rintro _ (rfl | ⟨a, rfl⟩) _ (rfl | ⟨b, rfl⟩) _
    · exact Commute.refl _
    · exact Commute.units_inv_left (by simpa only [IsUnit.unit_spec] using hcg s₀ b)
    · exact Commute.units_inv_right (by simpa only [IsUnit.unit_spec] using hcg a s₀)
    · exact hcg a b
  let C : Subsemiring R := Subsemiring.closure S
  letI : CommSemiring C :=
    { C.toSemiring with mul_comm := (Subsemiring.isMulCommutative_closure hcommS).is_comm.comm }
  let g' : pLocalSubring n p →+* C :=
    g.codRestrict C fun a ↦ Subsemiring.subset_closure (Set.mem_insert_of_mem _ ⟨a, rfl⟩)
  have hg' : IsUnit (g' s₀) :=
    ⟨⟨g' s₀, ⟨↑hg.unit⁻¹, Subsemiring.subset_closure (Set.mem_insert _ _)⟩,
      Subtype.ext hg.mul_val_inv, Subtype.ext hg.val_inv_mul⟩, rfl⟩
  ⟨C.subtype.comp (IsLocalization.Away.lift s₀ (g := g') hg'), fun a ↦
    congrArg Subtype.val (IsLocalization.Away.lift_eq s₀ hg' a)⟩

/-- **Universal-property lift for `pLocalRationalSubring`**: any ring homomorphism
`g : pLocalSubring n p →+* R` into a semiring `R` sending `heckeGen n p (Fin.rev 0) = T(p, …, p)`
to a unit extends across `integralToRationalLocal n p` to `pLocalRationalSubring n p →+* R`. -/
noncomputable def pLocalRationalSubringLift {p : ℕ} {R : Type*} [Semiring R]
    (g : pLocalSubring n p →+* R)
    (hg : IsUnit (g ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩)) :
    pLocalRationalSubring n p →+* R :=
  (pLocalRationalSubringLiftAux n g hg).1

/-- `pLocalRationalSubringLift` extends `g` along `integralToRationalLocal`. -/
@[simp]
theorem pLocalRationalSubringLift_integralToRationalLocal {p : ℕ} {R : Type*} [Semiring R]
    (g : pLocalSubring n p →+* R)
    (hg : IsUnit (g ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩))
    (a : pLocalSubring n p) :
    pLocalRationalSubringLift n g hg (integralToRationalLocal n p a) = g a :=
  (pLocalRationalSubringLiftAux n g hg).2 a

/-- Precomposing `pLocalRationalSubringLift` with `integralToRationalLocal` recovers `g`. -/
@[simp]
theorem pLocalRationalSubringLift_comp_integralToRationalLocal {p : ℕ} {R : Type*} [Semiring R]
    (g : pLocalSubring n p →+* R)
    (hg : IsUnit (g ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩)) :
    (pLocalRationalSubringLift n g hg).comp (integralToRationalLocal n p) = g :=
  RingHom.ext (pLocalRationalSubringLift_integralToRationalLocal n g hg)

/-- `pLocalRationalSubringLift` maps `(scalarLocalUnit n p)⁻¹` to the inverse of the unit image of
`heckeGen n p (Fin.rev 0)`. -/
@[simp]
theorem pLocalRationalSubringLift_inv_scalarLocalUnit {p : ℕ} {R : Type*} [Semiring R]
    (g : pLocalSubring n p →+* R)
    (hg : IsUnit (g ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩)) :
    pLocalRationalSubringLift n g hg ↑(scalarLocalUnit n p)⁻¹ = ↑hg.unit⁻¹ := by
  apply hg.unit.mul_right_inj.mp
  rw [Units.mul_inv, IsUnit.unit_spec, ← pLocalRationalSubringLift_integralToRationalLocal n g hg,
    ← val_scalarLocalUnit, ← map_mul, Units.mul_inv, map_one]

/-- **Universal property of `integralToRationalLocal`**: a ring homomorphism out of
`pLocalRationalSubring n p` equals `pLocalRationalSubringLift n g hg` if and only if its
precomposition with `integralToRationalLocal n p` is `g`. -/
theorem eq_pLocalRationalSubringLift_iff {p : ℕ} {R : Type*} [Semiring R]
    (g : pLocalSubring n p →+* R)
    (hg : IsUnit (g ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩))
    (f : pLocalRationalSubring n p →+* R) :
    f = pLocalRationalSubringLift n g hg ↔ f.comp (integralToRationalLocal n p) = g :=
  ⟨fun h ↦ h ▸ pLocalRationalSubringLift_comp_integralToRationalLocal n g hg,
    fun h ↦ pLocalRationalSubring_ringHom_ext
      (h.trans (pLocalRationalSubringLift_comp_integralToRationalLocal n g hg).symm)⟩

end NeZero

end PLocalRational

section LaurentPresentation

variable [NeZero n]

private lemma isUnit_integralToRationalLocal_evalHomLocal_X_rev_zero (p : ℕ) :
    IsUnit (((integralToRationalLocal n p).comp (evalHomLocal n p))
      (MvPolynomial.X (Fin.rev (0 : Fin n)))) := by
  rw [RingHom.comp_apply, evalHomLocal_X, ← val_scalarLocalUnit n p]
  exact (scalarLocalUnit n p).isUnit

/-- Localized evaluation homomorphism from `ℤ[X₀, …, X_{n-1}][X_{n-1}⁻¹]` into
`pLocalRationalSubring n p`, sending `X_k` to `heckeGen n p k` and `X_{n-1}⁻¹` to `T(p, …, p)⁻¹`. -/
noncomputable def laurentEvalHomLocal (p : ℕ) :
    Localization.Away (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ) →+*
      pLocalRationalSubring n p :=
  IsLocalization.Away.lift (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ)
    (isUnit_integralToRationalLocal_evalHomLocal_X_rev_zero n p)

/-- `laurentEvalHomLocal` agrees on polynomials with `evalHomLocal` followed by
`integralToRationalLocal`. -/
@[simp]
theorem laurentEvalHomLocal_algebraMap (p : ℕ) (P : MvPolynomial (Fin n) ℤ) :
    laurentEvalHomLocal n p (algebraMap (MvPolynomial (Fin n) ℤ)
        (Localization.Away (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ)) P) =
      integralToRationalLocal n p (evalHomLocal n p P) :=
  IsLocalization.Away.lift_eq _ _ P

/-- `laurentEvalHomLocal` sends the formal inverse of `X (Fin.rev 0)` to
`(scalarLocalUnit n p)⁻¹`. -/
@[simp]
theorem laurentEvalHomLocal_invSelf (p : ℕ) :
    laurentEvalHomLocal n p (IsLocalization.Away.invSelf
        (S := Localization.Away (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ))
        (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ)) =
      ↑(scalarLocalUnit n p)⁻¹ := by
  let X₀ : MvPolynomial (Fin n) ℤ := MvPolynomial.X (Fin.rev 0)
  apply (scalarLocalUnit n p).mul_right_inj.mp
  have hX : (scalarLocalUnit n p : pLocalRationalSubring n p) =
      laurentEvalHomLocal n p (algebraMap _ (Localization.Away X₀) X₀) := by
    rw [laurentEvalHomLocal_algebraMap, evalHomLocal_X, val_scalarLocalUnit]
  rw [Units.mul_inv, hX, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]

/-- For `p` prime, the localized presentation map `laurentEvalHomLocal` is injective. -/
theorem laurentEvalHomLocal_injective {p : ℕ} (hp : p.Prime) :
    Function.Injective (laurentEvalHomLocal n p) :=
  IsLocalization.injective_of_map_algebraMap_zero
    (M := Submonoid.powers (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ)) _
    (laurentEvalHomLocal n p) fun P hP ↦ by
      rw [laurentEvalHomLocal_algebraMap, map_eq_zero_iff _ (integralToRationalLocal_injective n p),
        map_eq_zero_iff _ (evalHomLocal_injective n hp)] at hP
      exact hP ▸ map_zero _

/-- For `p` prime, the localized presentation map `laurentEvalHomLocal` is surjective. -/
theorem laurentEvalHomLocal_surjective {p : ℕ} (hp : p.Prime) :
    Function.Surjective (laurentEvalHomLocal n p) := by
  let X₀ : MvPolynomial (Fin n) ℤ := MvPolynomial.X (Fin.rev 0)
  intro z
  obtain ⟨k, a, hk⟩ := exists_mul_scalarLocalUnit_pow_eq n p z
  obtain ⟨P, rfl⟩ := evalHomLocal_surjective n hp a
  refine ⟨algebraMap _ (Localization.Away X₀) P *
    IsLocalization.Away.invSelf (S := Localization.Away X₀) X₀ ^ k, ?_⟩
  rw [map_mul, map_pow, laurentEvalHomLocal_algebraMap, laurentEvalHomLocal_invSelf, ← hk,
    mul_assoc, ← mul_pow, Units.mul_inv, one_pow, mul_one]

/-- **Presentation of the `p`-local rational Hecke ring** (`Shimura` Theorem 3.20 combined with
central localization, `Rhodes–Shemanske` §2): for `p` prime, `pLocalRationalSubring n p` is
isomorphic to `Localization.Away (MvPolynomial.X (Fin.rev 0))`. -/
noncomputable def laurentPolynomialRingEquiv {p : ℕ} (hp : p.Prime) :
    Localization.Away (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ) ≃+*
      pLocalRationalSubring n p :=
  RingEquiv.ofBijective (laurentEvalHomLocal n p)
    ⟨laurentEvalHomLocal_injective n hp, laurentEvalHomLocal_surjective n hp⟩

/-- `laurentPolynomialRingEquiv` acts via `laurentEvalHomLocal`. -/
@[simp]
theorem laurentPolynomialRingEquiv_apply {p : ℕ} (hp : p.Prime)
    (z : Localization.Away (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ)) :
    laurentPolynomialRingEquiv n hp z = laurentEvalHomLocal n p z := (rfl)

end LaurentPresentation

end HeckeRing.GLn
