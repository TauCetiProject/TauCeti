module

public import Mathlib.RingTheory.Localization.Away.Basic
public import TauCeti.NumberTheory.HeckeRing.GLn.PolynomialRing.Presentation
public import TauCeti.NumberTheory.HeckeRing.GLn.Rational
public import TauCeti.NumberTheory.HeckeRing.Normalizer

/-!
# Central localization of the integral and `p`-local `GL_n` Hecke rings

Following Proposition 3.16 and Theorem 3.20 of [Shimura][shimura1971] together with §2 of
[Rhodes–Shemanske][rhodes1999], passing from the integral submonoid `posDetInt n` to `GL_n^+(ℚ)`
inverts the central scalar Hecke operators `T(c, …, c)` (`0 < c`). Globally, every element of
`RationalHeckeRing n` clears denominators under multiplication by a positive scalar operator in
`scalarSubmonoid n`. Locally at a prime `p`, adjoining the inverse of the last Shimura generator
`heckeGen n p (Fin.rev 0) = T(p, …, p)` to `pLocalSubring n p` produces the `p`-local rational Hecke
subring `pLocalRationalSubring n p` spanned by the monotone integer-exponent `p`-power diagonal
operators `intPowDiagElem n p e`, and presents it as the localization
`ℤ[X₀, …, X_{n-1}][X_{n-1}⁻¹]` away from `X (Fin.rev 0)`.

## Main definitions

* `HeckeRing.GLn.scalarUnit`: the central unit `[SL_n(ℤ) · diag(c, …, c) · SL_n(ℤ)]` of
  `RationalHeckeRing n` for `0 < c`.
* `HeckeRing.GLn.scalarSubmonoid`: the multiplicative submonoid of positive scalar operators
  `T(c, …, c)` in `IntegralHeckeRing n`.
* `HeckeRing.GLn.intPowDiagGL`, `HeckeRing.GLn.intPowDiagCoset`, `HeckeRing.GLn.intPowDiagElem`:
  rational `p`-power diagonal matrices `diag(p ^ e₁, …, p ^ eₙ) ∈ GL_n^+(ℚ)` (`e : Fin n → ℤ`),
  their `SL_n(ℤ)`-double cosets, and the corresponding basis elements of `RationalHeckeRing n`.
* `HeckeRing.GLn.pLocalRationalSubring`: the `p`-local rational Hecke subring of
  `RationalHeckeRing n` generated by `intPowDiagElem n p e` for monotone `e : Fin n → ℤ`.
* `HeckeRing.GLn.laurentEvalHomLocal`, `HeckeRing.GLn.laurentPolynomialRingEquiv`: the localized
  evaluation homomorphism and ring isomorphism
  `Localization.Away (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ) ≃+*
    pLocalRationalSubring n p` for `p` prime.

## Main results

* `HeckeRing.GLn.isUnit_integralToRational_of_mem_scalarSubmonoid`,
  `HeckeRing.GLn.exists_mul_mem_scalarSubmonoid_eq`: `integralToRational n` inverts
  `scalarSubmonoid n` and clears denominators for every element of `RationalHeckeRing n`.
* `HeckeRing.GLn.pLocalRationalSubring_eq_closure_image_insert_inv`: `pLocalRationalSubring n p` is
  generated as a subring by the image of `pLocalSubring n p` together with `T(p, …, p)⁻¹`.
* `HeckeRing.GLn.laurentEvalHomLocal_injective`, `HeckeRing.GLn.laurentEvalHomLocal_surjective`:
  bijectivity of the localized presentation map for `p` prime.

## References

* [G. Shimura, *Introduction to the arithmetic theory of automorphic functions*][shimura1971],
  Proposition 3.16 and Theorem 3.20.
* [J. A. Rhodes and T. R. Shemanske,
  *Rationality theorems for Hecke operators on GL_n*][rhodes1999], §2.
-/

public section

open Matrix Subgroup DoubleCoset

open scoped Pointwise HeckeCosetModule

namespace HeckeRing.GLn

variable (n : ℕ)

/-- Local `CommRing` instance on `RationalHeckeRing n` extending the ambient `Ring` instance so that
`Subring.toCommRing` on `pLocalRationalSubring n p` is definitionally compatible with its ambient
`Ring` structure (matching `commSemiringIntegralHeckeRingLocal` in `PolynomialRing/Basic.lean`). -/
noncomputable local instance commRingRationalHeckeRingLocal :
    CommRing (RationalHeckeRing n) :=
  { (HeckeCosetModule.instRingHeckeRing : Ring (RationalHeckeRing n)) with
    mul_comm := HeckeCosetModule.mul_comm_of_antiInvolution ℤ
      (transposeRationalAntiInvolution n)
      (transposeRationalAntiInvolution_onHeckeCoset_eq_self n) }

section ScalarUnits

/-- Every scalar matrix `natDiagGL n (fun _ ↦ c)` normalizes `SL_n(ℤ)` in `GL_n(ℚ)` (since it is
central). -/
theorem natDiagGL_const_mem_normalizer_SLnZ (c : ℕ) :
    natDiagGL n (fun _ ↦ c) ∈ Subgroup.normalizer (SLnZ n : Set (GL (Fin n) ℚ)) :=
  Subgroup.mem_normalizer_iff.mpr fun g ↦ by rw [natDiagGL_const_comm n c g, mul_inv_cancel_right]

private lemma single_mul_natDiagGL_const (g : (Matrix.GLPos (Fin n) ℚ).toSubmonoid) (c : ℕ) :
    HeckeCosetModule.single ℤ (HeckeCoset.mk (SLnZ n) (SLnZ n) g) 1 *
        HeckeCosetModule.single ℤ
          (HeckeCoset.mk (SLnZ n) (SLnZ n)
            ⟨natDiagGL n (fun _ ↦ c),
              posDetInt_le_glpos n (natDiagGL_mem_posDetInt n (fun _ ↦ c))⟩) 1 =
      HeckeCosetModule.single ℤ
        (HeckeCoset.mk (SLnZ n) (SLnZ n)
          ⟨(g : GL (Fin n) ℚ) * natDiagGL n (fun _ ↦ c),
            (Matrix.GLPos (Fin n) ℚ).mul_mem g.2
              (posDetInt_le_glpos n (natDiagGL_mem_posDetInt n (fun _ ↦ c)))⟩) 1 :=
  HeckeCosetModule.single_mul_single_of_mem_normalizer_right (x := g)
    (y := ⟨natDiagGL n (fun _ ↦ c),
      posDetInt_le_glpos n (natDiagGL_mem_posDetInt n (fun _ ↦ c))⟩) ℤ
    (natDiagGL_const_mem_normalizer_SLnZ n c)

/-- The positive scalar operator `T(c, …, c)` (`0 < c`) as a central unit of `RationalHeckeRing n`,
with inverse `[SL_n(ℤ) · diag(c⁻¹, …, c⁻¹) · SL_n(ℤ)]`. -/
noncomputable def scalarUnit {c : ℕ} (_hc : 0 < c) : (RationalHeckeRing n)ˣ :=
  HeckeCosetModule.unitOfMemNormalizer ℤ
    (posDetInt_le_glpos n (natDiagGL_mem_posDetInt n (fun _ ↦ c)))
    ((Matrix.GLPos (Fin n) ℚ).inv_mem
      (posDetInt_le_glpos n (natDiagGL_mem_posDetInt n (fun _ ↦ c))))
    (natDiagGL_const_mem_normalizer_SLnZ n c)

/-- The inverse of `scalarUnit` is the single double-coset operator of
`(natDiagGL n (fun _ ↦ c))⁻¹`. -/
theorem val_inv_scalarUnit {c : ℕ} (hc : 0 < c) :
    (↑(scalarUnit n hc)⁻¹ : RationalHeckeRing n) =
      HeckeCosetModule.single ℤ
        (HeckeCoset.mk (SLnZ n) (SLnZ n)
          ⟨(natDiagGL n (fun _ ↦ c))⁻¹,
            (Matrix.GLPos (Fin n) ℚ).inv_mem
              (posDetInt_le_glpos n (natDiagGL_mem_posDetInt n (fun _ ↦ c)))⟩) 1 := by
  rw [scalarUnit, HeckeCosetModule.val_inv_unitOfMemNormalizer]

variable [NeZero n]

/-- The underlying element of `scalarUnit` is the image of `diagElem (fun _ ↦ c)` in
`RationalHeckeRing n`. -/
@[simp]
theorem val_scalarUnit {c : ℕ} (hc : 0 < c) :
    (scalarUnit n hc : RationalHeckeRing n) = integralToRational n (diagElem (fun _ ↦ c)) := by
  rw [scalarUnit, HeckeCosetModule.val_unitOfMemNormalizer, integralToRational_diagElem]

/-- At `c = 1`, `scalarUnit` is the multiplicative identity. -/
@[simp]
theorem scalarUnit_one : scalarUnit n Nat.one_pos = 1 :=
  Units.ext (by simp [diagElem_one])

/-- `scalarUnit` is multiplicative in `c`. -/
theorem scalarUnit_mul {c d : ℕ} (hc : 0 < c) (hd : 0 < d) :
    scalarUnit n (mul_pos hc hd) = scalarUnit n hc * scalarUnit n hd := by
  apply Units.ext
  rw [Units.val_mul, val_scalarUnit, val_scalarUnit, val_scalarUnit, ← map_mul,
    diagElem_const_mul n c hc (fun _ ↦ d) (fun _ ↦ hd)]
  rfl

/-- `scalarUnit` commutes with natural-number powers of `c`. -/
theorem scalarUnit_pow {c : ℕ} (hc : 0 < c) (k : ℕ) :
    scalarUnit n hc ^ k = scalarUnit n (pow_pos hc k) := by
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, val_scalarUnit, val_scalarUnit, ← map_pow,
    diagElem_const_pow n c hc k]

/-- Every positive scalar operator `diagElem (fun _ ↦ c)` becomes a unit in
`RationalHeckeRing n`. -/
theorem isUnit_integralToRational_diagElem_const {c : ℕ} (hc : 0 < c) :
    IsUnit (integralToRational n (diagElem (fun _ ↦ c))) :=
  val_scalarUnit n hc ▸ (scalarUnit n hc).isUnit

/-- The multiplicative submonoid of `IntegralHeckeRing n` consisting of the positive scalar Hecke
operators `T(c, …, c)` (`0 < c`). -/
noncomputable def scalarSubmonoid : Submonoid (IntegralHeckeRing n) where
  carrier := {f | ∃ c : ℕ, 0 < c ∧ f = diagElem (fun _ ↦ c)}
  one_mem' := ⟨1, Nat.one_pos, diagElem_one.symm⟩
  mul_mem' := by
    rintro _ _ ⟨c, hc, rfl⟩ ⟨d, hd, rfl⟩
    refine ⟨c * d, mul_pos hc hd, ?_⟩
    rw [diagElem_const_mul n c hc (fun _ ↦ d) (fun _ ↦ hd)]
    rfl

/-- Membership in `scalarSubmonoid n` by a positive scalar witness `c`. -/
@[simp]
theorem mem_scalarSubmonoid_iff {f : IntegralHeckeRing n} :
    f ∈ scalarSubmonoid n ↔ ∃ c : ℕ, 0 < c ∧ f = diagElem (fun _ ↦ c) :=
  Iff.rfl

/-- Every positive scalar operator `diagElem (fun _ ↦ c)` belongs to `scalarSubmonoid n`. -/
theorem diagElem_const_mem_scalarSubmonoid {c : ℕ} (hc : 0 < c) :
    diagElem (fun _ ↦ c) ∈ scalarSubmonoid n :=
  ⟨c, hc, rfl⟩

/-- Every element of `scalarSubmonoid n` maps to a unit under `integralToRational n`. -/
theorem isUnit_integralToRational_of_mem_scalarSubmonoid {s : IntegralHeckeRing n}
    (hs : s ∈ scalarSubmonoid n) : IsUnit (integralToRational n s) := by
  obtain ⟨c, hc, rfl⟩ := hs
  exact isUnit_integralToRational_diagElem_const n hc

/-- **Global denominator clearing in `RationalHeckeRing n`** (`Shimura`, Proposition 3.16): every
rational Hecke operator `z` becomes integral after multiplying by a positive scalar operator
`s ∈ scalarSubmonoid n`. -/
theorem exists_mul_mem_scalarSubmonoid_eq (z : RationalHeckeRing n) :
    ∃ x : IntegralHeckeRing n, ∃ s ∈ scalarSubmonoid n,
      z * integralToRational n s = integralToRational n x := by
  induction z using HeckeCosetModule.induction_linear with
  | h0 => exact ⟨0, 1, (scalarSubmonoid n).one_mem, by simp⟩
  | hsingle D m =>
    induction D using HeckeCoset.induction with | h g =>
    obtain ⟨c, hc, hcg⟩ := exists_pos_natDiagGL_mul_mem_posDetInt n g.2
    have hgc : (g : GL (Fin n) ℚ) * natDiagGL n (fun _ ↦ c) ∈ posDetInt n :=
      natDiagGL_const_comm n c g ▸ hcg
    refine ⟨HeckeCosetModule.single ℤ (HeckeCoset.mk (SLnZ n) (SLnZ n) ⟨_, hgc⟩) m,
      diagElem (fun _ ↦ c), diagElem_const_mem_scalarSubmonoid n hc, ?_⟩
    have h1 := single_mul_natDiagGL_const n g c
    rw [HeckeCosetModule.single_mul_single] at h1
    rw [integralToRational_diagElem, HeckeCosetModule.single_mul_single,
      integralToRational, integralToRationalRingHom_single, HeckeCoset.map_mk]
    exact (congrArg (m • ·) ((one_smul ℤ _).symm.trans h1)).trans
      (HeckeCosetModule.smul_single_one ℤ _ m)
  | hadd z₁ z₂ ih₁ ih₂ =>
    obtain ⟨x₁, s₁, hs₁, hx₁⟩ := ih₁
    obtain ⟨x₂, s₂, hs₂, hx₂⟩ := ih₂
    refine ⟨x₁ * s₂ + x₂ * s₁, s₁ * s₂, (scalarSubmonoid n).mul_mem hs₁ hs₂, ?_⟩
    calc (z₁ + z₂) * integralToRational n (s₁ * s₂)
        = (z₁ * integralToRational n s₁) * integralToRational n s₂ +
            (z₂ * integralToRational n s₂) * integralToRational n s₁ := by rw [map_mul]; ring
      _ = integralToRational n (x₁ * s₂ + x₂ * s₁) := by rw [hx₁, hx₂, map_add, map_mul, map_mul]

end ScalarUnits

section PLocalRational

/-- At the last generator index `Fin.rev 0 = n - 1`, `heckeGenDiag` is the constant tuple
`(p, …, p)`. -/
@[simp]
theorem heckeGenDiag_rev_zero [NeZero n] (p : ℕ) :
    heckeGenDiag n p (Fin.rev 0) = fun _ ↦ p := by
  funext i; rw [heckeGenDiag_apply, Fin.val_rev, Fin.val_zero, ite_eq_right (by omega)]

/-- The last Shimura generator `heckeGen n p (Fin.rev 0)` is the scalar operator `T(p, …, p)`. -/
@[simp]
theorem heckeGen_rev_zero [NeZero n] (p : ℕ) :
    heckeGen n p (Fin.rev 0) = diagElem (fun _ ↦ p) := by
  rw [heckeGen_def, heckeGenDiag_rev_zero]

/-- The `p`-power diagonal matrix `diag(p ^ e₁, …, p ^ eₙ) ∈ GL_n(ℚ)` with integer exponents
`e : Fin n → ℤ` for `p ≠ 0`, taking the junk value `1` at `p = 0` to match `natDiagGL`. -/
noncomputable def intPowDiagGL (p : ℕ) (e : Fin n → ℤ) : GL (Fin n) ℚ :=
  if hp : p = 0 then 1
  else TauCeti.diagGL fun i ↦ Units.mk0 (p : ℚ) (Nat.cast_ne_zero.mpr hp) ^ e i

/-- Formula for `intPowDiagGL` when `0 < p`. -/
theorem intPowDiagGL_of_pos {p : ℕ} (hp : 0 < p) (e : Fin n → ℤ) :
    intPowDiagGL n p e =
      TauCeti.diagGL fun i ↦ Units.mk0 (p : ℚ) (Nat.cast_ne_zero.mpr hp.ne') ^ e i :=
  dite_eq_right hp.ne'

/-- Matrix coercion of `intPowDiagGL` for `0 < p`. -/
@[simp]
theorem intPowDiagGL_coe {p : ℕ} (hp : 0 < p) (e : Fin n → ℤ) :
    (↑(intPowDiagGL n p e) : Matrix (Fin n) (Fin n) ℚ) =
      Matrix.diagonal fun i ↦ (p : ℚ) ^ e i := by
  rw [intPowDiagGL_of_pos n hp, TauCeti.diagGL_coe]; congr 1; funext i
  rw [Units.val_zpow_eq_zpow_val, Units.val_mk0]

/-- `intPowDiagGL` at the zero exponent vector is `1`. -/
@[simp]
theorem intPowDiagGL_zero (p : ℕ) : intPowDiagGL n p 0 = 1 := by
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · simp [intPowDiagGL]
  · exact Units.ext (by simp [intPowDiagGL_coe n hp])

/-- `intPowDiagGL` converts addition of exponent vectors into matrix multiplication. -/
@[simp]
theorem intPowDiagGL_add (p : ℕ) (e f : Fin n → ℤ) :
    intPowDiagGL n p (e + f) = intPowDiagGL n p e * intPowDiagGL n p f := by
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · simp [intPowDiagGL]
  · exact Units.ext (by
      simp [intPowDiagGL_coe n hp, zpow_add₀ (Nat.cast_ne_zero.mpr hp.ne' : (p : ℚ) ≠ 0)])

/-- `intPowDiagGL` converts negation of exponent vectors into group inversion. -/
@[simp]
theorem intPowDiagGL_neg (p : ℕ) (e : Fin n → ℤ) :
    intPowDiagGL n p (-e) = (intPowDiagGL n p e)⁻¹ :=
  eq_inv_of_mul_eq_one_left (by rw [← intPowDiagGL_add, neg_add_cancel, intPowDiagGL_zero])

/-- Every `p`-power diagonal matrix `intPowDiagGL n p e` has positive rational determinant. -/
theorem intPowDiagGL_mem_glpos (p : ℕ) (e : Fin n → ℤ) :
    intPowDiagGL n p e ∈ Matrix.GLPos (Fin n) ℚ := by
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · simp [intPowDiagGL]
  · rw [Matrix.mem_glpos, Matrix.GeneralLinearGroup.val_det_apply, intPowDiagGL_coe n hp,
      Matrix.det_diagonal]
    exact Finset.prod_pos fun i _ ↦ zpow_pos (Nat.cast_pos.mpr hp) (e i)

/-- On natural exponents, `intPowDiagGL` agrees with `natDiagGL` of `primePowDiag`. -/
theorem intPowDiagGL_natCast {p : ℕ} (hp : 0 < p) (e : Fin n → ℕ) :
    intPowDiagGL n p (fun i ↦ (e i : ℤ)) = natDiagGL n (primePowDiag n p e) :=
  Units.ext (by simp [intPowDiagGL_coe n hp, natDiagGL_coe n _ (primePowDiag_pos n p hp e)])

/-- At the constant exponent `-1`, `intPowDiagGL` is the inverse of `diag(p, …, p)`. -/
theorem intPowDiagGL_const_neg_one {p : ℕ} (hp : 0 < p) :
    intPowDiagGL n p (fun _ ↦ -1) = (natDiagGL n (fun _ ↦ p))⁻¹ := by
  change intPowDiagGL n p (-(fun _ ↦ ((1 : ℕ) : ℤ))) = _
  rw [intPowDiagGL_neg, intPowDiagGL_natCast n hp]
  exact congrArg Inv.inv (congrArg (natDiagGL n) (funext fun _ ↦ by simp))

/-- Multiplying `intPowDiagGL n p e` by `diag(p ^ k, …, p ^ k)` shifts every exponent by `k`. -/
theorem intPowDiagGL_mul_natDiagGL_const {p : ℕ} (hp : 0 < p) (e : Fin n → ℤ) (k : ℕ) :
    intPowDiagGL n p e * natDiagGL n (fun _ ↦ p ^ k) =
      intPowDiagGL n p (fun i ↦ e i + (k : ℤ)) := by
  rw [show (fun _ : Fin n ↦ p ^ k) = primePowDiag n p (fun _ ↦ k) from
      funext fun i ↦ (primePowDiag_apply n p (fun _ ↦ k) i).symm,
    ← intPowDiagGL_natCast n hp (fun _ ↦ k), ← intPowDiagGL_add]; rfl

/-- The `SL_n(ℤ)`-double coset in `GL_n^+(ℚ)` of `intPowDiagGL n p e`. -/
noncomputable def intPowDiagCoset (p : ℕ) (e : Fin n → ℤ) :
    HeckeCoset (Matrix.GLPos (Fin n) ℚ).toSubmonoid (SLnZ n) (SLnZ n) :=
  HeckeCoset.mk (SLnZ n) (SLnZ n) ⟨intPowDiagGL n p e, intPowDiagGL_mem_glpos n p e⟩

/-- Defining equation for `intPowDiagCoset`. -/
theorem intPowDiagCoset_def (p : ℕ) (e : Fin n → ℤ) :
    intPowDiagCoset n p e =
      HeckeCoset.mk (SLnZ n) (SLnZ n) ⟨intPowDiagGL n p e, intPowDiagGL_mem_glpos n p e⟩ :=
  (rfl)

/-- The rational `p`-power diagonal Hecke operator `[SL_n(ℤ) · diag(p ^ e) · SL_n(ℤ)]` in
`RationalHeckeRing n`. -/
noncomputable def intPowDiagElem (p : ℕ) (e : Fin n → ℤ) : RationalHeckeRing n :=
  HeckeCosetModule.single ℤ (intPowDiagCoset n p e) 1

/-- Defining equation for `intPowDiagElem`. -/
theorem intPowDiagElem_def (p : ℕ) (e : Fin n → ℤ) :
    intPowDiagElem n p e = HeckeCosetModule.single ℤ (intPowDiagCoset n p e) 1 :=
  (rfl)

/-- The `p`-local rational Hecke subring of `RationalHeckeRing n`, generated by the monotone
integer-exponent `p`-power diagonal operators `intPowDiagElem n p e`. -/
noncomputable def pLocalRationalSubring (p : ℕ) : Subring (RationalHeckeRing n) :=
  Subring.closure {f | ∃ (e : Fin n → ℤ) (_ : Monotone e), f = intPowDiagElem n p e}

/-- Defining equation for `pLocalRationalSubring`. -/
theorem pLocalRationalSubring_def (p : ℕ) :
    pLocalRationalSubring n p =
      Subring.closure {f | ∃ (e : Fin n → ℤ) (_ : Monotone e), f = intPowDiagElem n p e} :=
  (rfl)

/-- Every monotone `p`-power diagonal operator belongs to `pLocalRationalSubring n p`. -/
@[simp]
theorem intPowDiagElem_mem_pLocalRationalSubring (p : ℕ) (e : Fin n → ℤ) (hmono : Monotone e) :
    intPowDiagElem n p e ∈ pLocalRationalSubring n p :=
  Subring.subset_closure ⟨e, hmono, rfl⟩

/-- `pLocalRationalSubring n p` is contained in `S` iff `S` contains all monotone `p`-power diagonal
operators. -/
@[simp]
theorem pLocalRationalSubring_le_iff (p : ℕ) (S : Subring (RationalHeckeRing n)) :
    pLocalRationalSubring n p ≤ S ↔
      ∀ e : Fin n → ℤ, Monotone e → intPowDiagElem n p e ∈ S := by
  rw [pLocalRationalSubring_def, Subring.closure_le]
  exact ⟨fun h e he ↦ h ⟨e, he, rfl⟩, fun h _ ⟨e, he, hf⟩ ↦ hf ▸ h e he⟩

/-- At the constant exponent `-1`, `intPowDiagElem` is the inverse of the scalar unit
`T(p, …, p)`. -/
theorem intPowDiagElem_const_neg_one {p : ℕ} (hp : 0 < p) :
    intPowDiagElem n p (fun _ ↦ -1) = ↑(scalarUnit n hp)⁻¹ := by
  rw [intPowDiagElem_def, intPowDiagCoset_def, val_inv_scalarUnit]
  exact congrArg (HeckeCosetModule.single ℤ · 1) (congrArg (HeckeCoset.mk (SLnZ n) (SLnZ n))
    (Subtype.ext (intPowDiagGL_const_neg_one n hp)))

/-- The inverse of `T(p, …, p)` belongs to `pLocalRationalSubring n p`. -/
theorem inv_scalarUnit_mem_pLocalRationalSubring {p : ℕ} (hp : 0 < p) :
    (↑(scalarUnit n hp)⁻¹ : RationalHeckeRing n) ∈ pLocalRationalSubring n p :=
  intPowDiagElem_const_neg_one n hp ▸ intPowDiagElem_mem_pLocalRationalSubring n p _ monotone_const

section NeZero

variable [NeZero n]

/-- On natural exponents, `intPowDiagElem` is the image under `integralToRational` of the integral
`p`-power diagonal operator `diagElem (primePowDiag n p e)`. -/
theorem intPowDiagElem_natCast {p : ℕ} (hp : 0 < p) (e : Fin n → ℕ) :
    intPowDiagElem n p (fun i ↦ (e i : ℤ)) =
      integralToRational n (diagElem (primePowDiag n p e)) := by
  rw [intPowDiagElem_def, intPowDiagCoset_def, integralToRational_diagElem]
  exact congrArg (HeckeCosetModule.single ℤ · 1) (congrArg (HeckeCoset.mk (SLnZ n) (SLnZ n))
    (Subtype.ext (intPowDiagGL_natCast n hp e)))

/-- Multiplying `intPowDiagElem n p e` by `T(p, …, p) ^ k` shifts every exponent upward by `k`. -/
theorem intPowDiagElem_mul_scalarUnit_pow {p : ℕ} (hp : 0 < p) (e : Fin n → ℤ) (k : ℕ) :
    intPowDiagElem n p e * (scalarUnit n hp : RationalHeckeRing n) ^ k =
      intPowDiagElem n p (fun i ↦ e i + (k : ℤ)) := by
  rw [← Units.val_pow_eq_pow_val, scalarUnit_pow n hp k, val_scalarUnit,
    integralToRational_diagElem, intPowDiagElem_def, intPowDiagElem_def, intPowDiagCoset_def,
    intPowDiagCoset_def, single_mul_natDiagGL_const n _ (p ^ k)]
  exact congrArg (HeckeCosetModule.single ℤ · 1) (congrArg (HeckeCoset.mk (SLnZ n) (SLnZ n))
    (Subtype.ext (intPowDiagGL_mul_natDiagGL_const n hp e k)))

/-- The integral `p`-local subring maps into `pLocalRationalSubring n p` under
`integralToRational`. -/
theorem integralToRational_mem_pLocalRationalSubring {p : ℕ} (hp : 0 < p)
    {x : IntegralHeckeRing n} (hx : x ∈ pLocalSubring n p) :
    integralToRational n x ∈ pLocalRationalSubring n p := by
  suffices pLocalSubring n p ≤ (pLocalRationalSubring n p).comap (integralToRational n) from this hx
  rw [pLocalSubring_def, Subring.closure_le]
  rintro _ ⟨e, he, rfl⟩
  rw [SetLike.mem_coe, Subring.mem_comap, ← intPowDiagElem_natCast n hp e]
  exact intPowDiagElem_mem_pLocalRationalSubring n p _ fun _ _ hij ↦ Int.ofNat_le.mpr (he hij)

/-- **Subring presentation of `pLocalRationalSubring`**: for `0 < p`, `pLocalRationalSubring n p` is
generated as a subring of `RationalHeckeRing n` by the image of `pLocalSubring n p` together with
the inverse of `T(p, …, p)`. -/
theorem pLocalRationalSubring_eq_closure_image_insert_inv {p : ℕ} (hp : 0 < p) :
    pLocalRationalSubring n p = Subring.closure
      (insert (↑(scalarUnit n hp)⁻¹ : RationalHeckeRing n)
        (integralToRational n '' (pLocalSubring n p : Set (IntegralHeckeRing n)))) := by
  apply le_antisymm
  · refine (pLocalRationalSubring_le_iff n p _).mpr fun e he ↦ ?_
    let k : ℕ := (-e 0).toNat
    let e' : Fin n → ℕ := fun i ↦ (e i + (k : ℤ)).toNat
    have he'_mono : Monotone e' := fun i j hij ↦ by have := he hij; dsimp only [e']; omega
    have he'_cast : (fun i ↦ (e' i : ℤ)) = fun i ↦ e i + (k : ℤ) :=
      funext fun i ↦ Int.toNat_of_nonneg (by have := he (Fin.zero_le i); omega)
    rw [show intPowDiagElem n p e = integralToRational n (diagElem (primePowDiag n p e')) *
          (↑(scalarUnit n hp)⁻¹ : RationalHeckeRing n) ^ k by
      rw [← intPowDiagElem_natCast n hp e', he'_cast, ← intPowDiagElem_mul_scalarUnit_pow n hp e k,
        mul_assoc, ← mul_pow, Units.mul_inv, one_pow, mul_one]]
    exact Subring.mul_mem _
      (Subring.subset_closure (Set.mem_insert_of_mem _
        ⟨_, diagElem_primePowDiag_mem_pLocalSubring n p e' he'_mono, rfl⟩))
      (Subring.pow_mem _ (Subring.subset_closure (Set.mem_insert _ _)) k)
  · rw [Subring.closure_le]
    rintro x (rfl | ⟨y, hy, rfl⟩)
    · exact inv_scalarUnit_mem_pLocalRationalSubring n hp
    · exact integralToRational_mem_pLocalRationalSubring n hp hy

/-- Restriction of `integralToRational n` to a ring homomorphism
`pLocalSubring n p →+* pLocalRationalSubring n p`. -/
noncomputable def integralToRationalLocal (p : ℕ) (hp : 0 < p) :
    pLocalSubring n p →+* pLocalRationalSubring n p :=
  ((integralToRational n).comp (pLocalSubring n p).subtype).codRestrict
    (pLocalRationalSubring n p) fun x ↦ integralToRational_mem_pLocalRationalSubring n hp x.2

/-- Coercion of `integralToRationalLocal` to `RationalHeckeRing n` agrees with
`integralToRational`. -/
@[simp]
theorem integralToRationalLocal_coe (p : ℕ) (hp : 0 < p) (x : pLocalSubring n p) :
    (integralToRationalLocal n p hp x : RationalHeckeRing n) = integralToRational n x :=
  (rfl)

/-- `integralToRationalLocal` is injective. -/
theorem integralToRationalLocal_injective (p : ℕ) (hp : 0 < p) :
    Function.Injective (integralToRationalLocal n p hp) :=
  fun _ _ h ↦ Subtype.ext (integralToRational_injective n (congrArg Subtype.val h))

/-- The last Shimura generator `heckeGen n p (Fin.rev 0) = T(p, …, p)` bundled as a unit of
`pLocalRationalSubring n p`. -/
noncomputable def scalarLocalUnit {p : ℕ} (hp : 0 < p) : (pLocalRationalSubring n p)ˣ where
  val := integralToRationalLocal n p hp
    ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩
  inv := ⟨↑(scalarUnit n hp)⁻¹, inv_scalarUnit_mem_pLocalRationalSubring n hp⟩
  val_inv := Subtype.ext (by
    rw [Subring.coe_mul, integralToRationalLocal_coe, Subtype.coe_mk, Subtype.coe_mk,
      Subring.coe_one, heckeGen_rev_zero, ← val_scalarUnit n hp, Units.mul_inv])
  inv_val := Subtype.ext (by
    rw [Subring.coe_mul, integralToRationalLocal_coe, Subtype.coe_mk, Subtype.coe_mk,
      Subring.coe_one, heckeGen_rev_zero, ← val_scalarUnit n hp, Units.inv_mul])

/-- Underlying element of `scalarLocalUnit` inside `pLocalRationalSubring n p`. -/
@[simp]
theorem val_scalarLocalUnit {p : ℕ} (hp : 0 < p) :
    (scalarLocalUnit n hp : pLocalRationalSubring n p) =
      integralToRationalLocal n p hp
        ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩ :=
  (rfl)

/-- Ambient coercion of `(scalarLocalUnit n hp)⁻¹` to `RationalHeckeRing n`. -/
@[simp]
theorem coe_inv_scalarLocalUnit {p : ℕ} (hp : 0 < p) :
    ((↑(scalarLocalUnit n hp)⁻¹ : pLocalRationalSubring n p) : RationalHeckeRing n) =
      ↑(scalarUnit n hp)⁻¹ :=
  (rfl)

/-- **Denominator clearing in `pLocalRationalSubring`**: every element of
`pLocalRationalSubring n p` multiplies into the image of `pLocalSubring n p` under some power of
`T(p, …, p)`. -/
theorem exists_mul_scalarLocalUnit_pow_eq {p : ℕ} (hp : 0 < p) (z : pLocalRationalSubring n p) :
    ∃ (k : ℕ) (a : pLocalSubring n p),
      z * (scalarLocalUnit n hp : pLocalRationalSubring n p) ^ k =
        integralToRationalLocal n p hp a := by
  let g₀ : pLocalSubring n p :=
    ⟨heckeGen n p (Fin.rev 0), heckeGen_mem_pLocalSubring n p (Fin.rev 0)⟩
  rcases z with ⟨x, hx⟩
  suffices ∃ (k : ℕ) (a : pLocalSubring n p),
      x * (scalarUnit n hp : RationalHeckeRing n) ^ k = integralToRational n a by
    obtain ⟨k, a, hk⟩ := this
    exact ⟨k, a, Subtype.ext (by
      rw [Subring.coe_mul, Subring.coe_pow, val_scalarLocalUnit, integralToRationalLocal_coe,
        integralToRationalLocal_coe]
      dsimp only
      rw [heckeGen_rev_zero, ← val_scalarUnit n hp, hk])⟩
  refine Subring.closure_induction
    (p := fun y _ ↦ ∃ (k : ℕ) (a : pLocalSubring n p),
      y * (scalarUnit n hp : RationalHeckeRing n) ^ k = integralToRational n a)
    (fun y hy ↦ ?_) ⟨0, 0, by simp⟩ ⟨0, 1, by simp⟩
    (fun x₁ x₂ _ _ ⟨k₁, a₁, h₁⟩ ⟨k₂, a₂, h₂⟩ ↦ ?_)
    (fun y _ ⟨k, a, h⟩ ↦ ⟨k, -a, by rw [neg_mul, h, Subring.coe_neg, map_neg]⟩)
    (fun x₁ x₂ _ _ ⟨k₁, a₁, h₁⟩ ⟨k₂, a₂, h₂⟩ ↦ ⟨k₁ + k₂, a₁ * a₂, by
      rw [show (x₁ * x₂) * (scalarUnit n hp : RationalHeckeRing n) ^ (k₁ + k₂) =
            (x₁ * ↑(scalarUnit n hp) ^ k₁) * (x₂ * ↑(scalarUnit n hp) ^ k₂) by rw [pow_add]; ring,
        h₁, h₂, Subring.coe_mul, map_mul]⟩)
    (by rwa [← pLocalRationalSubring_eq_closure_image_insert_inv n hp])
  · rcases hy with rfl | ⟨w, hw, rfl⟩
    · exact ⟨1, 1, by simp⟩
    · exact ⟨0, ⟨w, hw⟩, by simp⟩
  · refine ⟨k₁ + k₂, a₁ * g₀ ^ k₂ + a₂ * g₀ ^ k₁, ?_⟩
    have hg₀ : integralToRational n (g₀ : IntegralHeckeRing n) = scalarUnit n hp := by
      rw [val_scalarUnit, ← heckeGen_rev_zero]
    rw [show (x₁ + x₂) * (scalarUnit n hp : RationalHeckeRing n) ^ (k₁ + k₂) =
          (x₁ * ↑(scalarUnit n hp) ^ k₁) * ↑(scalarUnit n hp) ^ k₂ +
            (x₂ * ↑(scalarUnit n hp) ^ k₂) * ↑(scalarUnit n hp) ^ k₁ by rw [pow_add]; ring,
      h₁, h₂, Subring.coe_add, Subring.coe_mul, Subring.coe_mul, Subring.coe_pow,
      Subring.coe_pow, map_add, map_mul, map_mul, map_pow, map_pow, hg₀]

end NeZero

end PLocalRational

section LaurentPresentation

variable [NeZero n]

private lemma isUnit_integralToRationalLocal_evalHomLocal_X_rev_zero {p : ℕ} (hp : 0 < p) :
    IsUnit (((integralToRationalLocal n p hp).comp (evalHomLocal n p))
      (MvPolynomial.X (Fin.rev (0 : Fin n)))) := by
  rw [RingHom.comp_apply, evalHomLocal_X, ← val_scalarLocalUnit n hp]
  exact (scalarLocalUnit n hp).isUnit

/-- Localized evaluation homomorphism from `ℤ[X₀, …, X_{n-1}][X_{n-1}⁻¹]` into the `p`-local
rational Hecke subring `pLocalRationalSubring n p`, sending `X_k` to `heckeGen n p k` and
`X_{n-1}⁻¹` (`X_{n-1} = X (Fin.rev 0)`) to `T(p, …, p)⁻¹`. -/
noncomputable def laurentEvalHomLocal (p : ℕ) (hp : 0 < p) :
    Localization.Away (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ) →+*
      pLocalRationalSubring n p :=
  IsLocalization.Away.lift (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ)
    (isUnit_integralToRationalLocal_evalHomLocal_X_rev_zero n hp)

/-- `laurentEvalHomLocal` agrees on polynomials with `evalHomLocal` followed by
`integralToRationalLocal`. -/
@[simp]
theorem laurentEvalHomLocal_algebraMap (p : ℕ) (hp : 0 < p) (P : MvPolynomial (Fin n) ℤ) :
    laurentEvalHomLocal n p hp
        (algebraMap (MvPolynomial (Fin n) ℤ)
          (Localization.Away (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ)) P) =
      integralToRationalLocal n p hp (evalHomLocal n p P) :=
  IsLocalization.Away.lift_eq _ _ P

/-- `laurentEvalHomLocal` sends the formal inverse of `X (Fin.rev 0)` to
`(scalarLocalUnit n hp)⁻¹`. -/
@[simp]
theorem laurentEvalHomLocal_invSelf (p : ℕ) (hp : 0 < p) :
    laurentEvalHomLocal n p hp
        (IsLocalization.Away.invSelf
          (S := Localization.Away (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ))
          (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ)) =
      ↑(scalarLocalUnit n hp)⁻¹ := by
  let X₀ : MvPolynomial (Fin n) ℤ := MvPolynomial.X (Fin.rev 0)
  apply (scalarLocalUnit n hp).mul_right_inj.mp
  have hX : (scalarLocalUnit n hp : pLocalRationalSubring n p) =
      laurentEvalHomLocal n p hp (algebraMap _ (Localization.Away X₀) X₀) := by
    rw [laurentEvalHomLocal_algebraMap, evalHomLocal_X, val_scalarLocalUnit]
  rw [Units.mul_inv, hX, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]

/-- For `p` prime, the localized presentation map `laurentEvalHomLocal` is injective. -/
theorem laurentEvalHomLocal_injective {p : ℕ} (hp : p.Prime) :
    Function.Injective (laurentEvalHomLocal n p hp.pos) := by
  let X₀ : MvPolynomial (Fin n) ℤ := MvPolynomial.X (Fin.rev 0)
  refine (injective_iff_map_eq_zero _).mpr fun z hz ↦ ?_
  obtain ⟨k, P, hk⟩ := IsLocalization.Away.surj (S := Localization.Away X₀) X₀ z
  have hP0 : P = 0 := evalHomLocal_injective n hp (integralToRationalLocal_injective n p hp.pos
    (by rw [← laurentEvalHomLocal_algebraMap, ← hk, map_mul, hz, zero_mul, map_zero, map_zero]))
  rw [hP0, map_zero] at hk
  exact (IsUnit.mul_left_eq_zero
    (IsLocalization.Away.algebraMap_pow_isUnit (S := Localization.Away X₀) X₀ k)).mp hk

/-- For `p` prime, the localized presentation map `laurentEvalHomLocal` is surjective. -/
theorem laurentEvalHomLocal_surjective {p : ℕ} (hp : p.Prime) :
    Function.Surjective (laurentEvalHomLocal n p hp.pos) := by
  let X₀ : MvPolynomial (Fin n) ℤ := MvPolynomial.X (Fin.rev 0)
  intro z
  obtain ⟨k, a, hk⟩ := exists_mul_scalarLocalUnit_pow_eq n hp.pos z
  obtain ⟨P, rfl⟩ := evalHomLocal_surjective n hp a
  refine ⟨algebraMap _ (Localization.Away X₀) P *
    IsLocalization.Away.invSelf (S := Localization.Away X₀) X₀ ^ k, ?_⟩
  rw [map_mul, map_pow, laurentEvalHomLocal_algebraMap, laurentEvalHomLocal_invSelf, ← hk,
    mul_assoc, ← mul_pow, Units.mul_inv, one_pow, mul_one]

/-- **Presentation of the `p`-local rational Hecke ring** (`Shimura` Theorem 3.20 combined with
central localization, `Rhodes–Shemanske` §2): for `p` prime, the `p`-local rational Hecke subring
`pLocalRationalSubring n p` of `GL_n` is isomorphic to the localization
`ℤ[X₀, …, X_{n-1}][X_{n-1}⁻¹]` away from the last generator variable `X (Fin.rev 0)`. -/
noncomputable def laurentPolynomialRingEquiv {p : ℕ} (hp : p.Prime) :
    Localization.Away (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ) ≃+*
      pLocalRationalSubring n p :=
  RingEquiv.ofBijective (laurentEvalHomLocal n p hp.pos)
    ⟨laurentEvalHomLocal_injective n hp, laurentEvalHomLocal_surjective n hp⟩

/-- `laurentPolynomialRingEquiv` acts via `laurentEvalHomLocal`. -/
@[simp]
theorem laurentPolynomialRingEquiv_apply {p : ℕ} (hp : p.Prime)
    (z : Localization.Away (MvPolynomial.X (Fin.rev (0 : Fin n)) : MvPolynomial (Fin n) ℤ)) :
    laurentPolynomialRingEquiv n hp z = laurentEvalHomLocal n p hp.pos z :=
  (rfl)

end LaurentPresentation

end HeckeRing.GLn
