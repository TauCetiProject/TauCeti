omit [Fact p.Prime] in
/-- The `p`-primary integral submonoid of `GL_n(ℚ)`: matrices in Shimura's `posDetInt n` whose
determinant is a power of `p`. -/
noncomputable def pPrimaryPosDetInt : Submonoid (GL (Fin n) ℚ) where
  carrier := {g | g ∈ posDetInt n ∧ ∃ m : ℕ, (↑g : Matrix (Fin n) (Fin n) ℚ).det = (p : ℚ) ^ m}
  one_mem' := ⟨(posDetInt n).one_mem, 0, by simp⟩
  mul_mem' := by
    rintro g₁ g₂ ⟨hg₁, m₁, hm₁⟩ ⟨hg₂, m₂, hm₂⟩
    exact ⟨(posDetInt n).mul_mem hg₁ hg₂, m₁ + m₂,
      by rw [Units.val_mul, Matrix.det_mul, hm₁, hm₂, ← pow_add]⟩

omit [Fact p.Prime] in
/-- Membership characterization for `pPrimaryPosDetInt`. -/
@[simp]
theorem mem_pPrimaryPosDetInt_iff {g : GL (Fin n) ℚ} :
    g ∈ pPrimaryPosDetInt n p ↔
      g ∈ posDetInt n ∧ ∃ m : ℕ, (↑g : Matrix (Fin n) (Fin n) ℚ).det = (p : ℚ) ^ m := Iff.rfl

omit [Fact p.Prime] in
/-- `pPrimaryPosDetInt n p` is contained in `posDetInt n`. -/
theorem pPrimaryPosDetInt_le_posDetInt : pPrimaryPosDetInt n p ≤ posDetInt n :=
  fun _ hg ↦ hg.1

omit [Fact p.Prime] in
/-- `SL_n(ℤ)` is contained in `pPrimaryPosDetInt n p` (`m = 0`). -/
theorem SLnZ_le_pPrimaryPosDetInt : (SLnZ n).toSubmonoid ≤ pPrimaryPosDetInt n p :=
  fun _ hg ↦ ⟨SLnZ_le_posDetInt n hg, 0, by rw [det_eq_one_of_mem_SLnZ n hg, pow_zero]⟩

omit [Fact p.Prime] in
/-- Every `p`-power diagonal matrix `natDiagGL n (primePowDiag n p e)` lies in
`pPrimaryPosDetInt n p`. -/
theorem natDiagGL_primePowDiag_mem_pPrimaryPosDetInt (e : Fin n → ℕ) :
    natDiagGL n (primePowDiag n p e) ∈ pPrimaryPosDetInt n p := by
  refine ⟨natDiagGL_mem_posDetInt n _, ?_⟩
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · by_cases he : ∀ i, 0 < primePowDiag n 0 e i
    · refine ⟨0, ?_⟩
      rw [natDiagGL_det n _ he, pow_zero]
      refine Finset.prod_eq_one fun i _ ↦ ?_
      have hi := he i
      rw [primePowDiag_apply] at hi ⊢
      rcases Nat.eq_zero_or_pos (e i) with h0 | hpos
      · simp [h0]
      · simp [Nat.zero_pow hpos] at hi
    · exact ⟨0, by rw [natDiagGL_of_not_pos n he]; simp⟩
  · refine ⟨∑ i, e i, ?_⟩
    rw [natDiagGL_det n _ (primePowDiag_pos n p hp e)]
    simpa [primePowDiag_apply] using Finset.prod_pow_eq_pow_sum Finset.univ e (p : ℚ)

/-- Every `g ∈ pPrimaryPosDetInt n p` lies in the `SL_n(ℤ)` double coset of
`natDiagGL n (primePowDiag n p e)` for a monotone tuple `e : Fin n → ℕ`. -/
theorem exists_primePowDiag_mem_doubleCoset {g : GL (Fin n) ℚ} (hg : g ∈ pPrimaryPosDetInt n p) :
    ∃ e : Fin n → ℕ, Monotone e ∧
      g ∈ doubleCoset (natDiagGL n (primePowDiag n p e)) (SLnZ n) (SLnZ n) := by
  obtain ⟨hg_pos, m, hm⟩ := hg
  let D : HeckeCoset (posDetInt n) (SLnZ n) (SLnZ n) := HeckeCoset.mk _ _ ⟨g, hg_pos⟩
  obtain ⟨a, ha_pos, ha_dvd, hD⟩ := exists_diagonal_representative D
  have hmem : g ∈ doubleCoset (natDiagGL n a) (SLnZ n) (SLnZ n) := by
    have := congrArg HeckeCoset.toSet hD
    rw [HeckeCoset.toSet_mk, diagCoset_toSet] at this
    exact this ▸ DoubleCoset.mem_doubleCoset_self _ _ _
  have hprod : ∏ i, a i = p ^ m := by
    have hdet := (det_eq_of_mem_doubleCoset_SLnZ n hmem).symm.trans hm
    rw [natDiagGL_det n a ha_pos] at hdet
    exact_mod_cast hdet
  have ha_pow : ∀ i, ∃ k ≤ m, a i = p ^ k := fun i ↦
    (Nat.dvd_prime_pow (Fact.out : p.Prime)).mp
      (hprod ▸ Finset.dvd_prod_of_mem a (Finset.mem_univ i))
  choose e _ he using ha_pow
  have ha_eq : a = primePowDiag n p e :=
    funext fun i ↦ (he i).trans (primePowDiag_apply n p e i).symm
  have he_mono : Monotone e := fun i j hij ↦ by
    have hd : p ^ e i ∣ p ^ e j := he i ▸ he j ▸ isDvdChain_iff.mp ha_dvd hij
    exact (Nat.pow_dvd_pow_iff_le_right (Fact.out : p.Prime).one_lt).mp hd
  exact ⟨e, he_mono, ha_eq ▸ hmem⟩

private theorem exists_int_matrix_natDiagGL_mul_inv {g : GL (Fin n) ℚ} {k m : ℕ}
    {A : Matrix (Fin n) (Fin n) ℤ}
    (hA : (↑(natDiagGL n (fun _ ↦ p ^ k) * g) : Matrix (Fin n) (Fin n) ℚ) =
      A.map (Int.cast : ℤ → ℚ))
    (hm : (↑(natDiagGL n (fun _ ↦ p ^ k) * g) : Matrix (Fin n) (Fin n) ℚ).det = (p : ℚ) ^ m) :
    ∃ B : Matrix (Fin n) (Fin n) ℤ,
      B * A = (p : ℤ) ^ (m + k) • 1 ∧
        (↑(natDiagGL n (fun _ ↦ p ^ m) * g⁻¹) : Matrix (Fin n) (Fin n) ℚ) =
          B.map (Int.cast : ℤ → ℚ) := by
  have hp_pos : 0 < p := (Fact.out : p.Prime).pos
  let B : Matrix (Fin n) (Fin n) ℤ := (p : ℤ) ^ k • A.adjugate
  have hAm : A.det = (p : ℤ) ^ m := by
    have h1 : (A.det : ℚ) = (p : ℚ) ^ m := by rw [Int.cast_det, ← hA, hm]
    exact_mod_cast h1
  have hBA : B * A = (p : ℤ) ^ (m + k) • 1 := by
    rw [Matrix.smul_mul, Matrix.adjugate_mul, hAm, smul_smul, ← pow_add, add_comm]
  refine ⟨B, hBA, ?_⟩
  have hpk_ne : (p : ℚ) ^ k ≠ 0 := pow_ne_zero k (Nat.cast_ne_zero.mpr hp_pos.ne')
  have hBA_Q : B.map (Int.cast : ℤ → ℚ) * A.map (Int.cast : ℤ → ℚ) =
      (p : ℚ) ^ k • (↑(natDiagGL n (fun _ ↦ p ^ m)) : Matrix (Fin n) (Fin n) ℚ) := by
    have hmap := congrArg (Matrix.map · (Int.castRingHom ℚ)) hBA
    rw [Matrix.map_mul] at hmap
    simp only [Int.coe_castRingHom] at hmap
    rw [hmap, natDiagGL_coe n _ fun _ ↦ pow_pos hp_pos m]
    ext i j
    simp only [Matrix.map_apply, Matrix.smul_apply, Matrix.one_apply, Matrix.diagonal_apply,
      smul_eq_mul]
    by_cases hij : i = j <;> simp [hij, pow_add, mul_comm]
  have hmulQ : B.map (Int.cast : ℤ → ℚ) * ((p : ℚ) ^ k • (↑g : Matrix (Fin n) (Fin n) ℚ)) =
      (p : ℚ) ^ k • (↑(natDiagGL n (fun _ ↦ p ^ m)) : Matrix (Fin n) (Fin n) ℚ) := by
    have hdiag_smul : (↑(natDiagGL n (fun _ ↦ p ^ k) * g) : Matrix (Fin n) (Fin n) ℚ) =
        (p : ℚ) ^ k • (↑g : Matrix (Fin n) (Fin n) ℚ) := by
      rw [Units.val_mul, natDiagGL_coe n _ fun _ ↦ pow_pos hp_pos k]
      ext i j; simp [Matrix.diagonal_mul]
    rwa [← hdiag_smul, hA]
  rw [Matrix.mul_smul] at hmulQ
  have hBg : B.map (Int.cast : ℤ → ℚ) * (↑g : Matrix (Fin n) (Fin n) ℚ) =
      (↑(natDiagGL n (fun _ ↦ p ^ m)) : Matrix (Fin n) (Fin n) ℚ) := by
    ext i j
    have hij := congr_fun (congr_fun hmulQ i) j
    dsimp only [Matrix.smul_apply, smul_eq_mul] at hij
    exact mul_left_cancel₀ hpk_ne hij
  have hg_inv : (↑g : Matrix (Fin n) (Fin n) ℚ) * (↑(g⁻¹) : Matrix (Fin n) (Fin n) ℚ) = 1 := by
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  rw [Units.val_mul, ← hBg, Matrix.mul_assoc, hg_inv, Matrix.mul_one]

private theorem inv_mem_pLocalPosGL_aux {g : GL (Fin n) ℚ} (hg : g ∈ Matrix.GLPos (Fin n) ℚ)
    {k : ℕ} (hkg : natDiagGL n (fun _ ↦ p ^ k) * g ∈ pPrimaryPosDetInt n p) :
    ∃ k' : ℕ, natDiagGL n (fun _ ↦ p ^ k') * g⁻¹ ∈ pPrimaryPosDetInt n p := by
  obtain ⟨hg_pos, m, hm⟩ := hkg
  obtain ⟨hA_int, -⟩ := (mem_posDetInt_iff n).mp hg_pos
  obtain ⟨A, hA⟩ := (hasIntEntries_iff n).mp hA_int
  obtain ⟨B, hBA, hBmat⟩ := exists_int_matrix_natDiagGL_mul_inv n p hA hm
  have hdet_pos : 0 < (↑(natDiagGL n (fun _ ↦ p ^ m) * g⁻¹) : Matrix (Fin n) (Fin n) ℚ).det := by
    have hmem := (Matrix.GLPos (Fin n) ℚ).mul_mem
      (posDetInt_le_glpos n (natDiagGL_mem_posDetInt n (fun _ ↦ p ^ m)))
      ((Matrix.GLPos (Fin n) ℚ).inv_mem hg)
    rwa [Matrix.mem_glpos, Matrix.GeneralLinearGroup.val_det_apply] at hmem
  have hBdet_Q :
      (B.det : ℚ) = (↑(natDiagGL n (fun _ ↦ p ^ m) * g⁻¹) : Matrix (Fin n) (Fin n) ℚ).det := by
    rw [hBmat, Int.cast_det]
  have hBdet_pos : 0 < B.det := by exact_mod_cast hBdet_Q ▸ hdet_pos
  have hdvd : B.det.natAbs ∣ p ^ ((m + k) * n) := by
    have hdvdZ : B.det ∣ (p : ℤ) ^ ((m + k) * n) := by
      simpa [Fintype.card_fin, pow_mul] using Matrix.det_dvd_pow_card_of_mul_eq_smul_one hBA
    simpa [Int.natAbs_pow, Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr hdvdZ
  obtain ⟨r, -, hr⟩ := (Nat.dvd_prime_pow (Fact.out : p.Prime)).mp hdvd
  refine ⟨m, ⟨(mem_posDetInt_iff n).mpr ⟨(hasIntEntries_iff n).mpr ⟨B, hBmat⟩, hdet_pos⟩, r, ?_⟩⟩
  have hB_pow : B.det = (p : ℤ) ^ r := by
    rw [← Int.natAbs_of_nonneg hBdet_pos.le, hr, Nat.cast_pow]
  rw [← hBdet_Q, hB_pow]; push_cast; rfl

/-- The `p`-local positive-determinant subgroup of `GL_n(ℚ)`: elements of `GL_n^+(ℚ)` whose
entries clear to `pPrimaryPosDetInt n p` under a scalar power of `p`. -/
noncomputable def pLocalPosGL : Subgroup (GL (Fin n) ℚ) where
  carrier := {g | g ∈ Matrix.GLPos (Fin n) ℚ ∧
    ∃ k : ℕ, natDiagGL n (fun _ ↦ p ^ k) * g ∈ pPrimaryPosDetInt n p}
  one_mem' := ⟨(Matrix.GLPos (Fin n) ℚ).one_mem, 0, by simp [pow_zero, natDiagGL_one]⟩
  mul_mem' := by
    rintro g₁ g₂ ⟨hg₁, k₁, hk₁⟩ ⟨hg₂, k₂, hk₂⟩
    refine ⟨(Matrix.GLPos (Fin n) ℚ).mul_mem hg₁ hg₂, k₁ + k₂, ?_⟩
    have hp_pos : 0 < p := (Fact.out : p.Prime).pos
    have hpow : (fun _ : Fin n ↦ p ^ (k₁ + k₂)) =
        (fun _ : Fin n ↦ p ^ k₁) * (fun _ : Fin n ↦ p ^ k₂) :=
      funext fun _ ↦ pow_add p k₁ k₂
    have hmul : natDiagGL n (fun _ ↦ p ^ (k₁ + k₂)) * (g₁ * g₂) =
        (natDiagGL n (fun _ ↦ p ^ k₁) * g₁) * (natDiagGL n (fun _ ↦ p ^ k₂) * g₂) := by
      rw [hpow, ← natDiagGL_mul n _ _ (fun _ ↦ pow_pos hp_pos k₁) (fun _ ↦ pow_pos hp_pos k₂),
        mul_assoc, ← mul_assoc (natDiagGL n (fun _ ↦ p ^ k₂)),
        natDiagGL_const_comm n (p ^ k₂) g₁, mul_assoc, mul_assoc]
    rw [hmul]
    exact (pPrimaryPosDetInt n p).mul_mem hk₁ hk₂
  inv_mem' := fun ⟨hg, k, hk⟩ ↦
    ⟨(Matrix.GLPos (Fin n) ℚ).inv_mem hg, inv_mem_pLocalPosGL_aux n p hg hk⟩

/-- Membership characterization for `pLocalPosGL`. -/
@[simp]
theorem mem_pLocalPosGL_iff {g : GL (Fin n) ℚ} :
    g ∈ pLocalPosGL n p ↔ g ∈ Matrix.GLPos (Fin n) ℚ ∧
      ∃ k : ℕ, natDiagGL n (fun _ ↦ p ^ k) * g ∈ pPrimaryPosDetInt n p := Iff.rfl

/-- `pLocalPosGL n p` is contained in `GL_n^+(ℚ)`. -/
theorem pLocalPosGL_le_glpos : pLocalPosGL n p ≤ Matrix.GLPos (Fin n) ℚ :=
  fun _ hg ↦ hg.1

/-- `pPrimaryPosDetInt n p` is contained in `pLocalPosGL n p`. -/
theorem pPrimaryPosDetInt_le_pLocalPosGL :
    pPrimaryPosDetInt n p ≤ (pLocalPosGL n p).toSubmonoid :=
  fun g hg ↦ ⟨posDetInt_le_glpos n hg.1, 0, by rw [pow_zero, natDiagGL_one, one_mul]; exact hg⟩

/-- `SL_n(ℤ)` is contained in `pLocalPosGL n p`. -/
theorem SLnZ_le_pLocalPosGL : SLnZ n ≤ pLocalPosGL n p :=
  fun _ hg ↦ pPrimaryPosDetInt_le_pLocalPosGL n p (SLnZ_le_pPrimaryPosDetInt n p hg)

/-- Every `intPowDiagGL n p e` belongs to `pLocalPosGL n p`. -/
theorem intPowDiagGL_mem_pLocalPosGL (e : Fin n → ℤ) :
    intPowDiagGL n p e ∈ pLocalPosGL n p := by
  refine ⟨intPowDiagGL_mem_glpos n p e, ?_⟩
  obtain ⟨k, f, hf⟩ := TauCeti.exists_natCast_eq_add_natCast e
  have hf_fun : (fun i ↦ e i + (k : ℤ)) = fun i ↦ (f i : ℤ) := funext fun i ↦ (hf i).symm
  refine ⟨k, ?_⟩
  rw [natDiagGL_const_comm n (p ^ k), intPowDiagGL_mul_natDiagGL_const, hf_fun,
    intPowDiagGL_natCast]
  exact natDiagGL_primePowDiag_mem_pPrimaryPosDetInt n p f

omit [Fact p.Prime] in
/-- The `p`-primary integral Hecke triple `(pPrimaryPosDetInt n p, SL_n(ℤ))`. -/
instance instIsHeckeTriplePPrimaryPosDetInt :
    IsHeckeTriple (pPrimaryPosDetInt n p) (SLnZ n) (SLnZ n) :=
  IsHeckeTriple.of_diagonal (SLnZ_le_pPrimaryPosDetInt n p)
    (by rw [commensurator_SLnZ_eq_top]; exact le_top)

/-- The `p`-local rational Hecke triple `(pLocalPosGL n p, SL_n(ℤ))`. -/
instance instIsHeckeTriplePLocalPosGL :
    IsHeckeTriple (pLocalPosGL n p).toSubmonoid (SLnZ n) (SLnZ n) :=
  IsHeckeTriple.of_diagonal (SLnZ_le_pLocalPosGL n p)
    (by rw [commensurator_SLnZ_eq_top]; exact le_top)

private theorem hasIntEntries_of_mem_pLocalPosGL_of_padicInt {g : GL (Fin n) ℚ}
    (hg : g ∈ pLocalPosGL n p) (hpadic : castGLPadic n p g ∈ padicIntEntries n p) :
    HasIntEntries n g := by
  obtain ⟨-, k, hk_pos, -⟩ := hg
  obtain ⟨hA_int, -⟩ := (mem_posDetInt_iff n).mp hk_pos
  obtain ⟨A, hA⟩ := (hasIntEntries_iff n).mp hA_int
  have hp_pos : 0 < p := (Fact.out : p.Prime).pos
  have hnorm := (hasPadicIntEntries_iff_norm_le_one n p).mp
    ((mem_padicIntEntries_iff n p).mp hpadic)
  have hden : ∀ i j : Fin n, ((↑g : Matrix (Fin n) (Fin n) ℚ) i j).den = 1 := fun i j ↦ by
    have hmul : (p : ℚ) ^ k * (↑g : Matrix (Fin n) (Fin n) ℚ) i j = A i j := by
      have hentry := congr_fun (congr_fun hA i) j
      simpa [Units.val_mul, natDiagGL_coe n _ fun _ ↦ pow_pos hp_pos k, Matrix.diagonal_mul]
        using hentry
    have hle : ‖(((↑g : Matrix (Fin n) (Fin n) ℚ) i j : ℚ) : ℚ_[p])‖ ≤ 1 := by
      simpa [castGLPadic_coe] using hnorm i j
    exact Padic.den_eq_one_of_pow_mul_eq_of_norm_rat_le_one hmul hle
  refine (hasIntEntries_iff n).mpr ⟨Matrix.of fun i j ↦ ((↑g : Matrix (Fin n) (Fin n) ℚ) i j).num,
    ?_⟩
  ext i j
  simpa using ((Rat.den_eq_one_iff _).mp (hden i j)).symm

/-- **Subgroup intersection in `GL_n(ℚ_p)`**: an element of `pLocalPosGL n p` lands in `GL_n(ℤ_p)`
if and only if it already belongs to `SL_n(ℤ)`. -/
theorem map_SLnZ_eq_GLnZp_inf_map_pLocalPosGL :
    (SLnZ n).map (castGLPadic n p) = GLnZp n p ⊓ (pLocalPosGL n p).map (castGLPadic n p) := by
  refine le_antisymm ?_ ?_
  · rintro _ ⟨g, hg, rfl⟩
    exact ⟨castGLPadic_mem_GLnZp_of_mem_SLnZ n p hg, ⟨g, SLnZ_le_pLocalPosGL n p hg, rfl⟩⟩
  · rintro _ ⟨hZp, ⟨g, hg, rfl⟩⟩
    obtain ⟨hpadic, hpadic_inv⟩ := (mem_GLnZp_iff_mem_padicIntEntries_and_inv n p).mp hZp
    rw [← map_inv] at hpadic_inv
    obtain ⟨A, hA⟩ := (hasIntEntries_iff n).mp
      (hasIntEntries_of_mem_pLocalPosGL_of_padicInt n p hg hpadic)
    obtain ⟨B, hB⟩ := (hasIntEntries_iff n).mp
      (hasIntEntries_of_mem_pLocalPosGL_of_padicInt n p
        ((pLocalPosGL n p).inv_mem hg) hpadic_inv)
    have hAB : A * B = 1 := by
      have hg_inv : (↑g : Matrix (Fin n) (Fin n) ℚ) * (↑(g⁻¹) : Matrix (Fin n) (Fin n) ℚ) = 1 := by
        rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
      rw [hA, hB] at hg_inv
      ext i j
      apply Int.cast_injective (α := ℚ)
      simpa [Matrix.mul_apply, Matrix.one_apply] using congr_fun (congr_fun hg_inv i) j
    have hdet : A.det = 1 ∨ A.det = -1 := Int.isUnit_iff.mp
      (IsUnit.of_mul_eq_one B.det (by rw [← Matrix.det_mul, hAB, Matrix.det_one]))
    have hgZ : g ∈ GLnZ n := (mem_GLnZ_iff_hasIntEntries_and_det n).mpr
      ⟨(hasIntEntries_iff n).mpr ⟨A, hA⟩, by
        have h1 : (A.det : ℚ) = (↑g : Matrix (Fin n) (Fin n) ℚ).det := by
          rw [hA, Int.cast_det]
        rcases hdet with h | h <;> [left; right] <;> rw [← h1, h] <;> simp⟩
    exact ⟨g, (SLnZ_eq_GLnZ_inf_glpos n).symm ▸ ⟨hgZ, hg.1⟩, rfl⟩

private theorem exists_mem_pPrimaryPosDetInt_of_int_matrix {D : Matrix (Fin n) (Fin n) ℤ} {m : ℕ}
    (hD : D.det = (p : ℤ) ^ m) :
    ∃ g ∈ pPrimaryPosDetInt n p,
      (↑g : Matrix (Fin n) (Fin n) ℚ) = D.map (Int.cast : ℤ → ℚ) ∧
        (↑(castGLPadic n p g) : Matrix (Fin n) (Fin n) ℚ_[p]) =
          (D.map (Int.castRingHom ℤ_[p])).map (PadicInt.Coe.ringHom (p := p)) := by
  let DQ : Matrix (Fin n) (Fin n) ℚ := D.map (Int.cast : ℤ → ℚ)
  have hdetQ : DQ.det = (p : ℚ) ^ m := by
    rw [← Int.cast_det D, hD]; push_cast; rfl
  have hpos : 0 < DQ.det := hdetQ ▸ pow_pos (Nat.cast_pos.mpr (Fact.out : p.Prime).pos) m
  let g : GL (Fin n) ℚ := Matrix.GeneralLinearGroup.mk'' DQ (isUnit_iff_ne_zero.mpr hpos.ne')
  have hg_coe : (↑g : Matrix (Fin n) (Fin n) ℚ) = DQ := Matrix.GeneralLinearGroup.val_mk'' _ _
  refine ⟨g, ⟨(mem_posDetInt_iff n).mpr ⟨(hasIntEntries_iff n).mpr ⟨D, hg_coe⟩, hg_coe ▸ hpos⟩,
    m, hg_coe ▸ hdetQ⟩, hg_coe, ?_⟩
  rw [castGLPadic_coe, hg_coe]
  ext i j; simp [DQ]

/-- **Left-coset surjectivity (`hsurj`)**: every `δ' ∈ padicIntEntries n p` translates on the left
by `GL_n(ℤ_p)` into `(pPrimaryPosDetInt n p).map (castGLPadic n p)`. -/
theorem exists_mem_GLnZp_mul_mem_map_pPrimaryPosDetInt (δ' : padicIntEntries n p) :
    ∃ u ∈ GLnZp n p,
      u * (δ' : GL (Fin n) ℚ_[p]) ∈ (pPrimaryPosDetInt n p).map (castGLPadic n p) := by
  let B := padicIntMatrix n p δ'
  have hBT : Bᵀ.det ≠ 0 := by rw [Matrix.det_transpose]; exact det_padicIntMatrix_ne_zero n p δ'
  obtain ⟨D, m, U, hDm, hBTU⟩ := TauCeti.exists_det_eq_pow_and_mul_eq_map n p Bᵀ hBT
  have hDTm : Dᵀ.det = (p : ℤ) ^ m := by rw [Matrix.det_transpose, hDm]
  obtain ⟨g, hg, -, hg_padic⟩ := exists_mem_pPrimaryPosDetInt_of_int_matrix n p hDTm
  let UT : GL (Fin n) ℤ_[p] := (Matrix.GeneralLinearGroup.transposeMulEquiv (Fin n) U).unop
  refine ⟨mapGLPadicInt n p UT, mapGLPadicInt_mem_GLnZp n p UT, g, hg, ?_⟩
  apply Units.ext
  have htr := congrArg Matrix.transpose hBTU
  rw [Matrix.transpose_mul, Matrix.transpose_transpose, ← Matrix.transpose_map] at htr
  have hmap := congrArg (Matrix.map · (PadicInt.Coe.ringHom (p := p))) htr
  dsimp only [B] at hmap
  simp only [Matrix.map_mul, map_padicIntMatrix, ← hg_padic] at hmap
  have hUT : (↑UT : Matrix (Fin n) (Fin n) ℤ_[p]).map (PadicInt.Coe.ringHom (p := p)) =
      (↑(mapGLPadicInt n p UT) : Matrix (Fin n) (Fin n) ℚ_[p]) :=
    (mapGLPadicInt_coe n p UT).symm
  have hUT_coe : (↑U : Matrix (Fin n) (Fin n) ℤ_[p])ᵀ = ↑UT :=
    (Matrix.GeneralLinearGroup.coe_unop_transposeMulEquiv (Fin n) U).symm
  rw [hUT_coe, hUT, ← Units.val_mul] at hmap
  exact hmap.symm

private theorem exists_mem_SLnZ_mul_of_padic_mul_eq {g₀ g' : GL (Fin n) ℚ}
    (hg₀ : g₀ ∈ pPrimaryPosDetInt n p) (hg' : g' ∈ pPrimaryPosDetInt n p)
    {u : GL (Fin n) ℚ_[p]} (hu : u ∈ GLnZp n p) (V : GL (Fin n) ℤ_[p])
    (hmul_padic : (u * castGLPadic n p g₀) * mapGLPadicInt n p V = castGLPadic n p g') :
    ∃ x₁ ∈ SLnZ n, ∃ y₁ ∈ SLnZ n, g' = x₁ * g₀ * y₁ := by
  obtain ⟨e₀, he₀, hcos₀⟩ := exists_primePowDiag_mem_doubleCoset n p hg₀
  obtain ⟨e', he', hcos'⟩ := exists_primePowDiag_mem_doubleCoset n p hg'
  obtain ⟨x₀, hx₀, y₀, hy₀, hxy₀⟩ := DoubleCoset.mem_doubleCoset.mp hcos₀
  obtain ⟨x', hx', y', hy', hxy'⟩ := DoubleCoset.mem_doubleCoset.mp hcos'
  have he_eq : e₀ = e' := by
    apply eq_of_padicNatPowDiagGL_mem_doubleCoset n p he₀ he'
    refine DoubleCoset.mem_doubleCoset.mpr
      ⟨castGLPadic n p (x'⁻¹) * u * castGLPadic n p x₀,
        (GLnZp n p).mul_mem ((GLnZp n p).mul_mem
          (castGLPadic_mem_GLnZp_of_mem_SLnZ n p ((SLnZ n).inv_mem hx')) hu)
          (castGLPadic_mem_GLnZp_of_mem_SLnZ n p hx₀),
        castGLPadic n p y₀ * mapGLPadicInt n p V * castGLPadic n p (y'⁻¹),
        (GLnZp n p).mul_mem ((GLnZp n p).mul_mem
          (castGLPadic_mem_GLnZp_of_mem_SLnZ n p hy₀) (mapGLPadicInt_mem_GLnZp n p V))
          (castGLPadic_mem_GLnZp_of_mem_SLnZ n p ((SLnZ n).inv_mem hy')), ?_⟩
    have hcast₀ := congrArg (castGLPadic n p) hxy₀
    have hcast' := congrArg (castGLPadic n p) hxy'
    rw [map_mul, map_mul, ← padicNatPowDiagGL_def] at hcast₀ hcast'
    symm
    calc (castGLPadic n p x'⁻¹ * u * castGLPadic n p x₀) * padicNatPowDiagGL n p e₀ *
            (castGLPadic n p y₀ * mapGLPadicInt n p V * castGLPadic n p y'⁻¹)
        = castGLPadic n p x'⁻¹ *
            ((u * (castGLPadic n p x₀ * padicNatPowDiagGL n p e₀ * castGLPadic n p y₀)) *
              mapGLPadicInt n p V) * castGLPadic n p y'⁻¹ := by simp only [mul_assoc]
      _ = castGLPadic n p x'⁻¹ * (castGLPadic n p x' * padicNatPowDiagGL n p e' *
            castGLPadic n p y') * castGLPadic n p y'⁻¹ := by
          rw [← hcast₀, hmul_padic, ← hcast']
      _ = padicNatPowDiagGL n p e' := by
          simp only [map_inv, mul_assoc, inv_mul_cancel_left, mul_inv_cancel, mul_one]
  subst he_eq
  refine ⟨x' * x₀⁻¹, (SLnZ n).mul_mem hx' ((SLnZ n).inv_mem hx₀),
    y₀⁻¹ * y', (SLnZ n).mul_mem ((SLnZ n).inv_mem hy₀) hy', ?_⟩
  symm
  calc x' * x₀⁻¹ * g₀ * (y₀⁻¹ * y')
      = x' * (x₀⁻¹ * (x₀ * natDiagGL n (primePowDiag n p e₀) * y₀) * y₀⁻¹) * y' := by
        rw [hxy₀]; simp only [mul_assoc]
    _ = x' * natDiagGL n (primePowDiag n p e₀) * y' := by
        simp only [mul_assoc, inv_mul_cancel_left, mul_inv_cancel, mul_one]
    _ = g' := hxy'.symm

/-- **Stabilizer transitivity (`hstab`)**: for every `g` in the image of `pPrimaryPosDetInt n p`
and every `u ∈ GL_n(ℤ_p)`, there exists `x` in the image of `SL_n(ℤ)` with
`x⁻¹ * u ∈ g • GL_n(ℤ_p)`. -/
theorem exists_mem_map_SLnZ_inv_mul_mem_conj_GLnZp
    (g : (pPrimaryPosDetInt n p).map (castGLPadic n p))
    (u : GL (Fin n) ℚ_[p]) (hu : u ∈ GLnZp n p) :
    ∃ x ∈ (SLnZ n).map (castGLPadic n p),
      x⁻¹ * u ∈ ConjAct.toConjAct (g : GL (Fin n) ℚ_[p]) • GLnZp n p := by
  obtain ⟨g₀, hg₀, hg_eq⟩ := g.property
  have hug_mem : u * (g : GL (Fin n) ℚ_[p]) ∈ padicIntEntries n p :=
    (padicIntEntries n p).mul_mem (GLnZp_le_padicIntEntries n p hu)
      (hg_eq ▸ castGLPadic_mem_padicIntEntries_of_mem_posDetInt n p hg₀.1)
  let B := padicIntMatrix n p ⟨u * (g : GL (Fin n) ℚ_[p]), hug_mem⟩
  obtain ⟨D, m, V, hDm, hBV⟩ :=
    TauCeti.exists_det_eq_pow_and_mul_eq_map n p B (det_padicIntMatrix_ne_zero n p _)
  obtain ⟨g', hg', -, hg'_padic⟩ := exists_mem_pPrimaryPosDetInt_of_int_matrix n p hDm
  have hmul_padic : (u * (g : GL (Fin n) ℚ_[p])) * mapGLPadicInt n p V = castGLPadic n p g' := by
    apply Units.ext
    have hmap := congrArg (Matrix.map · (PadicInt.Coe.ringHom (p := p))) hBV
    dsimp only [B] at hmap
    simp only [Matrix.map_mul, map_padicIntMatrix, ← mapGLPadicInt_coe, ← hg'_padic] at hmap
    simpa only [Units.val_mul] using hmap
  obtain ⟨x₁, hx₁, y₁, hy₁, hg'_eq⟩ := exists_mem_SLnZ_mul_of_padic_mul_eq n p hg₀ hg' hu V
    (hg_eq ▸ hmul_padic)
  refine ⟨castGLPadic n p x₁, ⟨x₁, hx₁, rfl⟩, ?_⟩
  rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem, ConjAct.smul_def, ConjAct.ofConjAct_inv,
    ConjAct.ofConjAct_toConjAct, inv_inv]
  have hx₁g : castGLPadic n p g' =
      castGLPadic n p x₁ * (g : GL (Fin n) ℚ_[p]) * castGLPadic n p y₁ := by
    rw [hg'_eq, map_mul, map_mul, hg_eq]
  have hrel : (g : GL (Fin n) ℚ_[p])⁻¹ * ((castGLPadic n p x₁)⁻¹ * u) * (g : GL (Fin n) ℚ_[p]) =
      castGLPadic n p y₁ * (mapGLPadicInt n p V)⁻¹ := by
    apply mul_right_cancel (b := mapGLPadicInt n p V)
    rw [inv_mul_cancel_right]
    calc (g : GL (Fin n) ℚ_[p])⁻¹ * ((castGLPadic n p x₁)⁻¹ * u) *
            (g : GL (Fin n) ℚ_[p]) * mapGLPadicInt n p V
        = (g : GL (Fin n) ℚ_[p])⁻¹ * (castGLPadic n p x₁)⁻¹ *
            ((u * (g : GL (Fin n) ℚ_[p])) * mapGLPadicInt n p V) := by simp only [mul_assoc]
      _ = (g : GL (Fin n) ℚ_[p])⁻¹ * (castGLPadic n p x₁)⁻¹ *
            (castGLPadic n p x₁ * (g : GL (Fin n) ℚ_[p]) * castGLPadic n p y₁) := by
          rw [hmul_padic, hx₁g]
      _ = castGLPadic n p y₁ := by
          simp only [mul_assoc, inv_mul_cancel_left]
  rw [hrel]
  exact (GLnZp n p).mul_mem (castGLPadic_mem_GLnZp_of_mem_SLnZ n p hy₁)
    ((GLnZp n p).inv_mem (mapGLPadicInt_mem_GLnZp n p V))

end PPrimaryAndPLocalGroups

section IntegralPadicComparison

private theorem castGLPadic_pPrimary_le_padicIntEntries :
    (pPrimaryPosDetInt n p).map (castGLPadic n p) ≤ padicIntEntries n p := by
  rintro _ ⟨g, hg, rfl⟩
  exact castGLPadic_mem_padicIntEntries_of_mem_posDetInt n p hg.1

private theorem castGLPadic_pPrimary_le_map_pLocalPosGL :
    (pPrimaryPosDetInt n p).map (castGLPadic n p) ≤
      ((pLocalPosGL n p).map (castGLPadic n p)).toSubmonoid := by
  rintro _ ⟨g, hg, rfl⟩
  exact ⟨g, pPrimaryPosDetInt_le_pLocalPosGL n p hg, rfl⟩

/-- Hecke-triple instance on the `castGLPadic`-image of `(pPrimaryPosDetInt n p, SLnZ n)`. -/
noncomputable instance instIsHeckeTripleMapCastPPrimary :
    IsHeckeTriple ((pPrimaryPosDetInt n p).map (castGLPadic n p))
      ((SLnZ n).map (castGLPadic n p)) ((SLnZ n).map (castGLPadic n p)) :=
  IsHeckeTriple.map (castGLPadic n p)

/-- Bijection between `p`-primary `SL_n(ℤ)` double cosets and integral `p`-adic `GL_n(ℤ_p)` double
cosets. -/
noncomputable def pPrimaryToPadicIntegralCosetEquiv :
    HeckeCoset (pPrimaryPosDetInt n p) (SLnZ n) (SLnZ n) ≃
      HeckeCoset (padicIntEntries n p) (GLnZp n p) (GLnZp n p) :=
  (HeckeCoset.mapEquivOfInjective (castGLPadic n p) (castGLPadic_injective n p)).trans
    (HeckeCoset.mapEquivOfInf (map_SLnZ_eq_GLnZp_inf_map_pLocalPosGL n p)
      (castGLPadic_pPrimary_le_padicIntEntries n p)
      (castGLPadic_pPrimary_le_map_pLocalPosGL n p)
      (exists_mem_GLnZp_mul_mem_map_pPrimaryPosDetInt n p)
      (exists_mem_map_SLnZ_inv_mul_mem_conj_GLnZp n p))

/-- Explicit action of `pPrimaryToPadicIntegralCosetEquiv` on `HeckeCoset.mk`. -/
@[simp]
theorem pPrimaryToPadicIntegralCosetEquiv_mk (g : pPrimaryPosDetInt n p) :
    pPrimaryToPadicIntegralCosetEquiv n p (HeckeCoset.mk (SLnZ n) (SLnZ n) g) =
      HeckeCoset.mk (GLnZp n p) (GLnZp n p)
        ⟨castGLPadic n p g,
          castGLPadic_mem_padicIntEntries_of_mem_posDetInt n p
            (pPrimaryPosDetInt_le_posDetInt n p g.property)⟩ := by
  simp only [pPrimaryToPadicIntegralCosetEquiv, Equiv.trans_apply,
    HeckeCoset.mapEquivOfInjective_apply, HeckeCoset.mapHom_mk, HeckeCoset.mapEquivOfInf_apply,
    HeckeCoset.map_mk]
  exact HeckeCoset.mk_congr_val rfl

/-- `pPrimaryToPadicIntegralCosetEquiv` preserves `HeckeCoset.degree`. -/
@[simp]
theorem degree_pPrimaryToPadicIntegralCosetEquiv
    (D : HeckeCoset (pPrimaryPosDetInt n p) (SLnZ n) (SLnZ n)) :
    (pPrimaryToPadicIntegralCosetEquiv n p D).degree = D.degree := by
  simp only [pPrimaryToPadicIntegralCosetEquiv, Equiv.trans_apply,
    HeckeCoset.mapEquivOfInf_apply, HeckeCoset.mapEquivOfInjective_apply]
  rw [HeckeCoset.degree_map_of_inf (map_SLnZ_eq_GLnZp_inf_map_pLocalPosGL n p)
    (castGLPadic_pPrimary_le_padicIntEntries n p)
    (castGLPadic_pPrimary_le_map_pLocalPosGL n p)
    (exists_mem_map_SLnZ_inv_mul_mem_conj_GLnZp n p),
    HeckeCoset.degree_mapHom_of_injective (castGLPadic_injective n p)]

/-- **Equality of structure constants**
(Rhodes–Shemanske, *Bruhat–Tits buildings and Hecke operators*, §3.2 Lemma 3.3): Shimura's
double-coset multiplicities on `(pPrimaryPosDetInt n p, SL_n(ℤ))` equal the `p`-adic multiplicities
on `(padicIntEntries n p, GL_n(ℤ_p))`. -/
theorem multiplicity_GLnZp_castGLPadic_of_mem_pPrimaryPosDetInt {g₁ g₂ g : GL (Fin n) ℚ}
    (hg₁ : g₁ ∈ pPrimaryPosDetInt n p) (hg₂ : g₂ ∈ pPrimaryPosDetInt n p)
    (hg : g ∈ pPrimaryPosDetInt n p) :
    DoubleCoset.multiplicity (GLnZp n p) (GLnZp n p) (GLnZp n p)
        (castGLPadic n p g₁) (castGLPadic n p g₂) (castGLPadic n p g) =
      DoubleCoset.multiplicity (SLnZ n) (SLnZ n) (SLnZ n) g₁ g₂ g := by
  have hinf := DoubleCoset.multiplicity_eq_of_inf (map_SLnZ_eq_GLnZp_inf_map_pLocalPosGL n p)
    (⟨g₁, pPrimaryPosDetInt_le_pLocalPosGL n p hg₁, rfl⟩ :
      castGLPadic n p g₁ ∈ (pLocalPosGL n p).map (castGLPadic n p))
    ⟨g₂, pPrimaryPosDetInt_le_pLocalPosGL n p hg₂, rfl⟩
    ⟨g, pPrimaryPosDetInt_le_pLocalPosGL n p hg, rfl⟩
    (exists_mem_map_SLnZ_inv_mul_mem_conj_GLnZp n p ⟨castGLPadic n p g₁, ⟨g₁, hg₁, rfl⟩⟩)
    (exists_mem_map_SLnZ_inv_mul_mem_conj_GLnZp n p ⟨castGLPadic n p g₂, ⟨g₂, hg₂, rfl⟩⟩)
  exact hinf.trans (DoubleCoset.multiplicity_map_of_injective (castGLPadic n p)
    (castGLPadic_injective n p) (SLnZ n) (SLnZ n) (SLnZ n) g₁ g₂ g)

/-- **Integral `p`-adic Hecke ring isomorphism on `pPrimaryPosDetInt`** over any coefficient
semiring `R`. -/
noncomputable def pPrimaryToPadicIntegralRingEquiv (R : Type*) [Semiring R] :
    𝕋 (pPrimaryPosDetInt n p) (SLnZ n) R ≃+* 𝕋 (padicIntEntries n p) (GLnZp n p) R :=
  (HeckeCosetModule.mapInjectiveRingEquiv R (castGLPadic n p) (castGLPadic_injective n p)).trans
    (HeckeCosetModule.mapSubgroupRingEquiv R (map_SLnZ_eq_GLnZp_inf_map_pLocalPosGL n p)
      (castGLPadic_pPrimary_le_padicIntEntries n p)
      (castGLPadic_pPrimary_le_map_pLocalPosGL n p)
      (exists_mem_GLnZp_mul_mem_map_pPrimaryPosDetInt n p)
      (exists_mem_map_SLnZ_inv_mul_mem_conj_GLnZp n p))

/-- `pPrimaryToPadicIntegralRingEquiv` sends each basis element along
`pPrimaryToPadicIntegralCosetEquiv`. -/
@[simp]
theorem pPrimaryToPadicIntegralRingEquiv_single (R : Type*) [Semiring R]
    (D : HeckeCoset (pPrimaryPosDetInt n p) (SLnZ n) (SLnZ n)) (b : R) :
    pPrimaryToPadicIntegralRingEquiv n p R (HeckeCosetModule.single R D b) =
      HeckeCosetModule.single R (pPrimaryToPadicIntegralCosetEquiv n p D) b := by
  simp [pPrimaryToPadicIntegralRingEquiv, pPrimaryToPadicIntegralCosetEquiv]

/-- `pPrimaryToPadicIntegralRingEquiv` preserves `LeftCosetModule.deg`. -/
@[simp]
theorem deg_pPrimaryToPadicIntegralRingEquiv (R : Type*) [Semiring R]
    (f : 𝕋 (pPrimaryPosDetInt n p) (SLnZ n) R) :
    LeftCosetModule.deg (padicIntEntries n p) (GLnZp n p) R
        (pPrimaryToPadicIntegralRingEquiv n p R f) =
      LeftCosetModule.deg (pPrimaryPosDetInt n p) (SLnZ n) R f := by
  simp [pPrimaryToPadicIntegralRingEquiv]

/-- The image of `𝕋 (pPrimaryPosDetInt n p) (SLnZ n) ℤ` inside `IntegralHeckeRing n` is precisely
Shimura's `p`-local subring `pLocalSubring n p`. -/
theorem range_mapSubmonoidRingHom_pPrimaryPosDetInt :
    (HeckeCosetModule.mapSubmonoidRingHom (H := SLnZ n) ℤ
        (pPrimaryPosDetInt_le_posDetInt n p)).range =
      pLocalSubring n p := by
  set φ := HeckeCosetModule.mapSubmonoidRingHom (H := SLnZ n) ℤ
    (pPrimaryPosDetInt_le_posDetInt n p)
  refine le_antisymm ?_ ?_
  · rintro _ ⟨f, rfl⟩
    induction f using HeckeCosetModule.induction_linear with
    | h0 => rw [map_zero]; exact (pLocalSubring n p).zero_mem
    | hadd x y ihx ihy => rw [map_add]; exact (pLocalSubring n p).add_mem ihx ihy
    | hsingle D c =>
      rw [HeckeCosetModule.mapSubmonoidRingHom_single, ← HeckeCosetModule.smul_single_one ℤ _ c]
      refine (pLocalSubring n p).zsmul_mem ?_ c
      obtain ⟨e, he, hmem⟩ := exists_primePowDiag_mem_doubleCoset n p D.rep.property
      have hmap : HeckeCosetModule.single ℤ
          (D.map (pPrimaryPosDetInt_le_posDetInt n p) le_rfl le_rfl) 1 =
          diagElem (primePowDiag n p e) := by
        rw [diagElem_def]
        refine congrArg (HeckeCosetModule.single ℤ · 1) ?_
        conv_lhs => rw [← HeckeCoset.mk_rep D, HeckeCoset.map_mk]
        rw [diagCoset_def]
        exact HeckeCoset.mk_eq_mk_of_mem hmem
      rw [hmap]
      exact diagElem_primePowDiag_mem_pLocalSubring n p e he
  · rw [pLocalSubring_le_iff]
    intro e _
    let D₀ : HeckeCoset (pPrimaryPosDetInt n p) (SLnZ n) (SLnZ n) :=
      HeckeCoset.mk _ _
        ⟨natDiagGL n (primePowDiag n p e), natDiagGL_primePowDiag_mem_pPrimaryPosDetInt n p e⟩
    refine ⟨HeckeCosetModule.single ℤ D₀ 1, ?_⟩
    rw [HeckeCosetModule.mapSubmonoidRingHom_single, diagElem_def, diagCoset_def]
    exact congrArg (HeckeCosetModule.single ℤ · 1) (HeckeCoset.map_mk _ _ _ _)

/-- Ring isomorphism between `𝕋 (pPrimaryPosDetInt n p) (SLnZ n) ℤ` and `pLocalSubring n p`. -/
noncomputable def pPrimaryToPLocalRingEquiv :
    𝕋 (pPrimaryPosDetInt n p) (SLnZ n) ℤ ≃+* pLocalSubring n p :=
  HeckeCosetModule.mapSubmonoidSubringEquiv (pPrimaryPosDetInt_le_posDetInt n p)
    (range_mapSubmonoidRingHom_pPrimaryPosDetInt n p)

/-- Coercion of `pPrimaryToPLocalRingEquiv` to `IntegralHeckeRing n`. -/
@[simp]
theorem pPrimaryToPLocalRingEquiv_coe (f : 𝕋 (pPrimaryPosDetInt n p) (SLnZ n) ℤ) :
    (pPrimaryToPLocalRingEquiv n p f : IntegralHeckeRing n) =
      HeckeCosetModule.mapSubmonoidRingHom (H := SLnZ n) ℤ
        (pPrimaryPosDetInt_le_posDetInt n p) f :=
  HeckeCosetModule.coe_mapSubmonoidSubringEquiv_apply _ _ f

/-- **The integral `p`-adic `GL_n` Hecke ring comparison**
(Rhodes–Shemanske 1998, §3.2; [Shimura][shimura1971] §3.2): Shimura's `p`-local Hecke
subring `pLocalSubring n p` is canonically isomorphic to `PadicIntegralHeckeRing n p`. -/
noncomputable def pLocalToPadicIntegralRingEquiv :
    pLocalSubring n p ≃+* PadicIntegralHeckeRing n p :=
  (pPrimaryToPLocalRingEquiv n p).symm.trans (pPrimaryToPadicIntegralRingEquiv n p ℤ)

/-- Defining factorization of `pLocalToPadicIntegralRingEquiv`. -/
theorem pLocalToPadicIntegralRingEquiv_def :
    pLocalToPadicIntegralRingEquiv n p =
      (pPrimaryToPLocalRingEquiv n p).symm.trans (pPrimaryToPadicIntegralRingEquiv n p ℤ) := (rfl)

/-- `pLocalToPadicIntegralRingEquiv` sends each monotone `p`-power diagonal operator
`diagElem (primePowDiag n p e)` to `padicNatPowDiagElem n p e`. -/
@[simp]
theorem pLocalToPadicIntegralRingEquiv_diagElem_primePowDiag (e : Fin n → ℕ) (he : Monotone e) :
    pLocalToPadicIntegralRingEquiv n p
        ⟨diagElem (primePowDiag n p e), diagElem_primePowDiag_mem_pLocalSubring n p e he⟩ =
      padicNatPowDiagElem n p e := by
  let D₀ : HeckeCoset (pPrimaryPosDetInt n p) (SLnZ n) (SLnZ n) :=
    HeckeCoset.mk _ _
      ⟨natDiagGL n (primePowDiag n p e), natDiagGL_primePowDiag_mem_pPrimaryPosDetInt n p e⟩
  have hPLocal : pPrimaryToPLocalRingEquiv n p (HeckeCosetModule.single ℤ D₀ 1) =
      ⟨diagElem (primePowDiag n p e), diagElem_primePowDiag_mem_pLocalSubring n p e he⟩ := by
    apply Subtype.ext
    rw [pPrimaryToPLocalRingEquiv_coe]
    dsimp only
    rw [HeckeCosetModule.mapSubmonoidRingHom_single, diagElem_def, diagCoset_def]
    exact congrArg (HeckeCosetModule.single ℤ · 1) (HeckeCoset.map_mk _ _ _ _)
  rw [pLocalToPadicIntegralRingEquiv, ← hPLocal, RingEquiv.trans_apply,
    RingEquiv.symm_apply_apply, pPrimaryToPadicIntegralRingEquiv_single,
    pPrimaryToPadicIntegralCosetEquiv_mk, padicNatPowDiagElem_def, padicNatPowDiagCoset_def]
  exact congrArg (HeckeCosetModule.single ℤ · 1)
    (HeckeCoset.mk_congr_val (padicNatPowDiagGL_def n p e).symm)

/-- `pLocalToPadicIntegralRingEquiv` sends the `k`-th Shimura generator `heckeGen n p k` to
`padicNatPowDiagElem n p (heckeGenExponent n k)`. -/
@[simp]
theorem pLocalToPadicIntegralRingEquiv_heckeGen (k : Fin n) :
    pLocalToPadicIntegralRingEquiv n p ⟨heckeGen n p k, heckeGen_mem_pLocalSubring n p k⟩ =
      padicNatPowDiagElem n p (heckeGenExponent n k) := by
  have heq : (⟨heckeGen n p k, heckeGen_mem_pLocalSubring n p k⟩ : pLocalSubring n p) =
      ⟨diagElem (primePowDiag n p (heckeGenExponent n k)),
        diagElem_primePowDiag_mem_pLocalSubring n p _ (heckeGenExponent_monotone n k)⟩ :=
    Subtype.ext (by dsimp only; rw [heckeGen_def, heckeGenDiag_eq_primePowDiag])
  rw [heq, pLocalToPadicIntegralRingEquiv_diagElem_primePowDiag n p _
    (heckeGenExponent_monotone n k)]

/-- `pLocalToPadicIntegralRingEquiv` preserves the degree homomorphism `LeftCosetModule.deg`. -/
@[simp]
theorem deg_pLocalToPadicIntegralRingEquiv (x : pLocalSubring n p) :
    LeftCosetModule.deg (padicIntEntries n p) (GLnZp n p) ℤ
        (pLocalToPadicIntegralRingEquiv n p x) =
      LeftCosetModule.deg (posDetInt n) (SLnZ n) ℤ (x : IntegralHeckeRing n) := by
  obtain ⟨f, rfl⟩ := (pPrimaryToPLocalRingEquiv n p).surjective x
  rw [pLocalToPadicIntegralRingEquiv, RingEquiv.trans_apply, RingEquiv.symm_apply_apply,
    deg_pPrimaryToPadicIntegralRingEquiv, pPrimaryToPLocalRingEquiv_coe,
    HeckeCosetModule.deg_mapSubmonoidRingHom]

/-- Every `p`-adic diagonal double coset `padicNatPowDiagCoset n p e` has the same degree as the
global diagonal coset `diagCoset (primePowDiag n p e)`. -/
theorem degree_padicNatPowDiagCoset_eq_degree_diagCoset (e : Fin n → ℕ) :
    (padicNatPowDiagCoset n p e).degree = (diagCoset (primePowDiag n p e)).degree := by
  let D₀ : HeckeCoset (pPrimaryPosDetInt n p) (SLnZ n) (SLnZ n) :=
    HeckeCoset.mk _ _
      ⟨natDiagGL n (primePowDiag n p e), natDiagGL_primePowDiag_mem_pPrimaryPosDetInt n p e⟩
  have hpadic : padicNatPowDiagCoset n p e = pPrimaryToPadicIntegralCosetEquiv n p D₀ := by
    rw [pPrimaryToPadicIntegralCosetEquiv_mk, padicNatPowDiagCoset_def]
    exact HeckeCoset.mk_congr_val (padicNatPowDiagGL_def n p e)
  have hglob : diagCoset (primePowDiag n p e) =
      D₀.map (pPrimaryPosDetInt_le_posDetInt n p) le_rfl le_rfl := by
    rw [diagCoset_def, HeckeCoset.map_mk]
    exact HeckeCoset.mk_congr_val rfl
  rw [hpadic, hglob, degree_pPrimaryToPadicIntegralCosetEquiv, HeckeCoset.degree_map_of_le]

/-- **Polynomial presentation of `PadicIntegralHeckeRing`** ([Shimura][shimura1971] Theorem 3.20
combined with the `p`-adic comparison): `PadicIntegralHeckeRing n p` is isomorphic to
`MvPolynomial (Fin n) ℤ`. -/
noncomputable def padicPolynomialRingEquiv :
    MvPolynomial (Fin n) ℤ ≃+* PadicIntegralHeckeRing n p :=
  (polynomialRingEquiv n (Fact.out : p.Prime)).trans (pLocalToPadicIntegralRingEquiv n p)

/-- `padicPolynomialRingEquiv` acts via `evalHomLocal` followed by
`pLocalToPadicIntegralRingEquiv`. -/
theorem padicPolynomialRingEquiv_apply (P : MvPolynomial (Fin n) ℤ) :
    padicPolynomialRingEquiv n p P =
      pLocalToPadicIntegralRingEquiv n p (evalHomLocal n p P) := by
  rw [padicPolynomialRingEquiv, RingEquiv.trans_apply, polynomialRingEquiv_apply]

/-- `padicPolynomialRingEquiv` sends `X k` to `padicNatPowDiagElem n p (heckeGenExponent n k)`. -/
@[simp]
theorem padicPolynomialRingEquiv_X (k : Fin n) :
    padicPolynomialRingEquiv n p (MvPolynomial.X k) =
      padicNatPowDiagElem n p (heckeGenExponent n k) := by
  rw [padicPolynomialRingEquiv_apply, evalHomLocal_X, pLocalToPadicIntegralRingEquiv_heckeGen]

/-- Every central `p`-adic coset `padicNatPowDiagCoset n p (fun _ ↦ k)` (in particular `pI` at
`k = 1`) has degree `1`. -/
@[simp]
theorem degree_padicNatPowDiagCoset_const (k : ℕ) :
    (padicNatPowDiagCoset n p (fun _ ↦ k)).degree = 1 := by
  have hp : primePowDiag n p (fun _ ↦ k) = fun _ ↦ p ^ k :=
    funext fun i ↦ primePowDiag_apply n p (fun _ ↦ k) i
  rw [degree_padicNatPowDiagCoset_eq_degree_diagCoset, hp]
  exact degree_diagCoset_const n (p ^ k)

end IntegralPadicComparison

end HeckeRing.GLn
