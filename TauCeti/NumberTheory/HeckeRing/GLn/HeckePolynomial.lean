/-!
# The integral Hecke polynomial of `GL n`

At an unramified place of a number field with residue cardinality `q`, the spherical Hecke
algebra of `GL n` is generated by the operators `T₀ = 1, T₁, …, Tₙ`, where `Tᵢ` is the double
coset of `diag(ϖ, …, ϖ, 1, …, 1)` with `ϖ` repeated `i` times.  The **Hecke polynomial**

  `P(X) = ∑_{i=0}^n (-1)^i q^{i(i-1)/2} Tᵢ X^{n-i}`

packages these operators into the polynomial that an attached Galois representation must
reproduce as the characteristic polynomial of (geometric) Frobenius.  This file defines it
for arbitrary `q` and `T₀, …, Tₙ` in a ring, without choosing a square root of `q`, and proves
its basic algebra:

* its coefficients, leading coefficient, constant (determinant) coefficient, degree and
  monicity, the latter even in the zero ring;
* its compatibility with every ring homomorphism, so it can be specialised at an eigensystem;
* the **Satake factorization**: for `q = s²` and Satake parameters `z₁, …, zₙ`, the substitution
  `Tᵢ = s^{i(n-i)} eᵢ(z)` turns `P` into `∏ⱼ (X - s^{n-1} zⱼ)`;
* the **twist formula**: replacing `Tᵢ` by `c^i Tᵢ`, which is the effect on Hecke eigenvalues
  of twisting by an unramified character taking the value `c` at `ϖ`, scales the roots of `P`
  by `c`;
* the **inversion formula**: replacing `Tᵢ` by `T_{n-i}`, which up to the unit `Tₙ` is the
  effect of the inversion `g ↦ g⁻¹` on spherical double cosets, turns `P` into the reflected
  polynomial with roots `q^{n-1}/βⱼ`, matching passage to the contragredient twisted by
  `ε^{1-n}`.

The exponent `i(i-1)/2` is written `Nat.choose i 2`, so no division appears in the definition.

## Main definitions

* `TauCeti.glnHeckePolynomial n q T`: the polynomial `∑ (-1)^i q^{i(i-1)/2} Tᵢ X^{n-i}`.

## Main results

* `TauCeti.coeff_glnHeckePolynomial`: the coefficient of `X^{n-i}` is `(-1)^i q^{i(i-1)/2} Tᵢ`.
* `TauCeti.monic_glnHeckePolynomial` and `TauCeti.natDegree_glnHeckePolynomial`.
* `TauCeti.map_glnHeckePolynomial`: compatibility with ring homomorphisms.
* `TauCeti.glnHeckePolynomial_pow_mul_esymm`: the Satake factorization.
* `TauCeti.glnHeckePolynomial_pow_mul_comp` and
  `TauCeti.glnHeckePolynomial_pow_mul_eq_scaleRoots`: the twist formula, integrally and through
  `Polynomial.scaleRoots`.
* `TauCeti.C_mul_glnHeckePolynomial_rev_comp` and
  `TauCeti.C_coeff_zero_mul_glnHeckePolynomial_rev_mul_comp`: the inversion formula.

## References

* P. Allen, F. Calegari, A. Caraiani, T. Gee, D. Helm, B. Le Hung, J. Newton, P. Scholze,
  R. Taylor and J. Thorne, *Potential automorphy over CM fields*, Ann. of Math. 197 (2023),
  §2.2.5, equation (2.2.6), and §2.2.20.
-/

public section

open Polynomial

namespace TauCeti

section Ring

variable {A : Type*} [Ring A] {n : ℕ}

/-- The **integral Hecke polynomial** of `GL n`,
`∑_{i=0}^n (-1)^i q^{i(i-1)/2} Tᵢ X^{n-i}`, for the residue cardinality `q` and the spherical
Hecke operators `T₀, …, Tₙ` (with `Tᵢ` the double coset of `diag(ϖ, …, ϖ, 1, …, 1)`, `ϖ`
repeated `i` times).  Both are arbitrary ring elements: no square root of `q` is chosen.  When
`T₀ = 1` it is monic of degree `n`, with constant coefficient `(-1)^n q^{n(n-1)/2} Tₙ`. -/
noncomputable def glnHeckePolynomial (n : ℕ) (q : A) (T : Fin (n + 1) → A) : A[X] :=
  ∑ i : Fin (n + 1), C ((-1) ^ (i : ℕ) * q ^ (i : ℕ).choose 2 * T i) * X ^ (n - i)

theorem glnHeckePolynomial_def (q : A) (T : Fin (n + 1) → A) :
    glnHeckePolynomial n q T =
      ∑ i : Fin (n + 1), C ((-1) ^ (i : ℕ) * q ^ (i : ℕ).choose 2 * T i) * X ^ (n - i) :=
  (rfl)

/-- The coefficient of `X^{n-i}` in the Hecke polynomial is `(-1)^i q^{i(i-1)/2} Tᵢ`. -/
theorem coeff_glnHeckePolynomial (q : A) (T : Fin (n + 1) → A) (i : Fin (n + 1)) :
    (glnHeckePolynomial n q T).coeff (n - i) = (-1) ^ (i : ℕ) * q ^ (i : ℕ).choose 2 * T i := by
  rw [glnHeckePolynomial_def, finsetSum_coeff, Finset.sum_eq_single i, coeff_C_mul_X_pow,
    ite_eq_left rfl]
  · intro j _ hji
    simp only [coeff_C_mul_X_pow, ite_eq_right_iff]
    exact fun h => absurd (Fin.ext (by omega)) hji
  · simp

/-- The Hecke polynomial has no coefficients beyond degree `n`. -/
theorem coeff_glnHeckePolynomial_of_lt (q : A) (T : Fin (n + 1) → A) {k : ℕ} (hk : n < k) :
    (glnHeckePolynomial n q T).coeff k = 0 := by
  rw [glnHeckePolynomial_def, finsetSum_coeff]
  refine Finset.sum_eq_zero fun i _ => ?_
  simp only [coeff_C_mul_X_pow, ite_eq_right_iff]
  omega

/-- The coefficient of `X^i` in the Hecke polynomial, read from the other end: it is
`(-1)^{n-i} q^{(n-i)(n-i-1)/2} T_{n-i}`. -/
theorem coeff_glnHeckePolynomial_val (q : A) (T : Fin (n + 1) → A) (i : Fin (n + 1)) :
    (glnHeckePolynomial n q T).coeff i =
      (-1) ^ (n - i : ℕ) * q ^ (n - i : ℕ).choose 2 * T i.rev := by
  simpa [Fin.val_rev, Nat.sub_sub_self i.is_le] using coeff_glnHeckePolynomial q T i.rev

theorem natDegree_glnHeckePolynomial_le (q : A) (T : Fin (n + 1) → A) :
    (glnHeckePolynomial n q T).natDegree ≤ n :=
  natDegree_le_iff_coeff_eq_zero.mpr fun _ hk => coeff_glnHeckePolynomial_of_lt q T hk

theorem degree_glnHeckePolynomial_le (q : A) (T : Fin (n + 1) → A) :
    (glnHeckePolynomial n q T).degree ≤ n :=
  degree_le_of_natDegree_le (natDegree_glnHeckePolynomial_le q T)

/-- Substituting `c X` for `X` keeps the Hecke polynomial in degree at most `n`. -/
theorem natDegree_glnHeckePolynomial_comp_C_mul_X_le (q c : A) (T : Fin (n + 1) → A) :
    ((glnHeckePolynomial n q T).comp (C c * X)).natDegree ≤ n :=
  natDegree_le_iff_coeff_eq_zero.mpr fun _ hk => by
    rw [comp_C_mul_X_coeff, coeff_glnHeckePolynomial_of_lt q T hk, zero_mul]

/-- The coefficient of `X^n` in the Hecke polynomial is `T₀`. -/
@[simp]
theorem coeff_glnHeckePolynomial_self (q : A) (T : Fin (n + 1) → A) :
    (glnHeckePolynomial n q T).coeff n = T 0 := by
  simpa using coeff_glnHeckePolynomial q T 0

/-- The **determinant coefficient**: the constant coefficient of the Hecke polynomial is
`(-1)^n q^{n(n-1)/2} Tₙ`. -/
@[simp]
theorem coeff_zero_glnHeckePolynomial (q : A) (T : Fin (n + 1) → A) :
    (glnHeckePolynomial n q T).coeff 0 = (-1) ^ n * q ^ n.choose 2 * T (Fin.last n) := by
  simpa using coeff_glnHeckePolynomial q T (Fin.last n)

/-- With `T₀ = 1` the Hecke polynomial is monic; this holds in every ring, the zero ring
included. -/
theorem monic_glnHeckePolynomial {q : A} {T : Fin (n + 1) → A} (hT : T 0 = 1) :
    (glnHeckePolynomial n q T).Monic :=
  monic_of_natDegree_le_of_coeff_eq_one n (natDegree_glnHeckePolynomial_le q T)
    (by rw [coeff_glnHeckePolynomial_self, hT])

/-- The Hecke polynomial has degree exactly `n` as soon as `T₀ ≠ 0`, for instance when `T₀ = 1`
in a nonzero ring. -/
theorem natDegree_glnHeckePolynomial {q : A} {T : Fin (n + 1) → A} (hT : T 0 ≠ 0) :
    (glnHeckePolynomial n q T).natDegree = n :=
  natDegree_eq_of_le_of_coeff_ne_zero (natDegree_glnHeckePolynomial_le q T)
    (by rwa [coeff_glnHeckePolynomial_self])

theorem leadingCoeff_glnHeckePolynomial {q : A} {T : Fin (n + 1) → A} (hT : T 0 ≠ 0) :
    (glnHeckePolynomial n q T).leadingCoeff = T 0 := by
  rw [leadingCoeff, natDegree_glnHeckePolynomial hT, coeff_glnHeckePolynomial_self]

/-- The Hecke polynomial is formed coefficientwise, so a ring homomorphism transports it by
transporting `q` and the `Tᵢ`. -/
@[simp]
theorem map_glnHeckePolynomial {B : Type*} [Ring B] (f : A →+* B) (q : A)
    (T : Fin (n + 1) → A) :
    (glnHeckePolynomial n q T).map f = glnHeckePolynomial n (f q) fun i => f (T i) := by
  simp [glnHeckePolynomial_def, Polynomial.map_sum]

/-- The Hecke polynomial is additive in the Hecke operators. -/
theorem glnHeckePolynomial_add (q : A) (T T' : Fin (n + 1) → A) :
    glnHeckePolynomial n q (T + T') = glnHeckePolynomial n q T + glnHeckePolynomial n q T' := by
  simp only [glnHeckePolynomial_def, Pi.add_apply, mul_add, C_add, add_mul,
    Finset.sum_add_distrib]

/-- Scaling all Hecke operators on the right by `c` scales the Hecke polynomial by `c`. -/
theorem glnHeckePolynomial_mul_const (q c : A) (T : Fin (n + 1) → A) :
    glnHeckePolynomial n q (fun i => T i * c) = glnHeckePolynomial n q T * C c := by
  refine (ext_iff_natDegree_le (natDegree_glnHeckePolynomial_le q _)
    ((natDegree_mul_C_le _ c).trans (natDegree_glnHeckePolynomial_le q T))).2 fun k hk => ?_
  obtain ⟨i, rfl⟩ : ∃ i : Fin (n + 1), (i : ℕ) = k := ⟨⟨k, Nat.lt_succ_of_le hk⟩, rfl⟩
  simp only [coeff_mul_C, coeff_glnHeckePolynomial_val, mul_assoc]

/-- At rank zero the Hecke polynomial is the constant `T₀`. -/
@[simp]
theorem glnHeckePolynomial_zero (q : A) (T : Fin 1 → A) : glnHeckePolynomial 0 q T = C (T 0) := by
  simp [glnHeckePolynomial_def]

/-- At rank one the Hecke polynomial is `T₀ X - T₁`: the nontrivial coefficient carries no power
of `q`. -/
@[simp]
theorem glnHeckePolynomial_one (q : A) (T : Fin 2 → A) :
    glnHeckePolynomial 1 q T = C (T 0) * X - C (T 1) := by
  simp [glnHeckePolynomial_def, Fin.sum_univ_two, sub_eq_add_neg]

/-- At rank two the Hecke polynomial is `T₀ X² - T₁ X + q T₂`. -/
@[simp]
theorem glnHeckePolynomial_two (q : A) (T : Fin 3 → A) :
    glnHeckePolynomial 2 q T = C (T 0) * X ^ 2 - C (T 1) * X + C (q * T 2) := by
  simp [glnHeckePolynomial_def, Fin.sum_univ_three, sub_eq_add_neg]

end Ring

section CommRing

variable {A : Type*} [CommRing A] {n : ℕ}

/-- The exponent bookkeeping of the Satake factorization: `i(i-1) + i(n-i) = i(n-1)`. -/
private theorem two_mul_choose_two_add_mul_sub {i : ℕ} (hi : i ≤ n) :
    2 * i.choose 2 + i * (n - i) = (n - 1) * i := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [Nat.le_zero.mp hi]
  qify [hi, hn]
  push_cast [Nat.cast_choose_two]
  ring

/-- **Satake factorization of the Hecke polynomial.**  For `q = s²` and parameters
`z₁, …, zₙ`, the Satake substitution `Tᵢ = s^{i(n-i)} eᵢ(z)` (with `eᵢ` the `i`-th elementary
symmetric function) turns the Hecke polynomial into `∏ⱼ (X - s^{n-1} zⱼ)`.  The identity holds
for every `s` and `z` in every commutative ring. -/
theorem glnHeckePolynomial_pow_mul_esymm (s : A) (z : Fin n → A) :
    glnHeckePolynomial n (s ^ 2)
        (fun i => s ^ ((i : ℕ) * (n - i)) * (Finset.univ.val.map z).esymm i) =
      ∏ j, (X - C (s ^ (n - 1) * z j)) := by
  have hprod : ∏ j, (X - C (s ^ (n - 1) * z j)) =
      ((Finset.univ.val.map fun j => s ^ (n - 1) * z j).map fun t => X - C t).prod := by
    simp only [Multiset.map_map, Function.comp_def, Finset.prod_map_val]
  rw [hprod, Multiset.prod_X_sub_X_eq_sum_esymm, Multiset.card_map, Finset.card_val,
    Finset.card_univ, Fintype.card_fin, Finset.sum_range, glnHeckePolynomial_def]
  refine Fintype.sum_congr _ _ fun i => ?_
  have hexp := two_mul_choose_two_add_mul_sub i.is_le
  rw [show (Finset.univ.val.map fun j => s ^ (n - 1) * z j) =
      (Finset.univ.val.map z).map (s ^ (n - 1) • ·) by
        simp only [Multiset.map_map, Function.comp_def, smul_eq_mul],
    ← Multiset.pow_smul_esymm, smul_eq_mul, ← pow_mul s (n - 1) i, ← hexp, pow_add, pow_mul]
  simp only [C_mul, C_pow, C_neg, C_1]
  ring

/-- **Twisting the Hecke polynomial**, integrally: replacing each `Tᵢ` by `c^i Tᵢ` and
substituting `c X` for `X` multiplies the Hecke polynomial by `c^n`.  For an unramified
character with value `c` at the uniformizer, this is the effect of the twist on the Hecke
polynomial; for the norm twist `‖det‖^t` one has `c = q^{-t}`. -/
theorem glnHeckePolynomial_pow_mul_comp (q c : A) (T : Fin (n + 1) → A) :
    (glnHeckePolynomial n q fun i => c ^ (i : ℕ) * T i).comp (C c * X) =
      C (c ^ n) * glnHeckePolynomial n q T := by
  refine (ext_iff_natDegree_le (natDegree_glnHeckePolynomial_comp_C_mul_X_le q c _)
    ((natDegree_C_mul_le _ _).trans (natDegree_glnHeckePolynomial_le q T))).2 fun k hk => ?_
  obtain ⟨i, rfl⟩ : ∃ i : Fin (n + 1), (i : ℕ) = k := ⟨⟨k, Nat.lt_succ_of_le hk⟩, rfl⟩
  rw [comp_C_mul_X_coeff, coeff_C_mul, coeff_glnHeckePolynomial_val,
    coeff_glnHeckePolynomial_val, Fin.val_rev, Nat.add_sub_add_right, ← pow_mul_pow_sub c i.is_le]
  ring

/-- **Twisting the Hecke polynomial scales its roots**: when `T₀ ≠ 0`, replacing each `Tᵢ` by
`c^i Tᵢ` gives `Polynomial.scaleRoots` of the Hecke polynomial by `c`. -/
theorem glnHeckePolynomial_pow_mul_eq_scaleRoots {q : A} {T : Fin (n + 1) → A} (hT : T 0 ≠ 0)
    (c : A) :
    (glnHeckePolynomial n q fun i => c ^ (i : ℕ) * T i) =
      (glnHeckePolynomial n q T).scaleRoots c := by
  ext k
  rw [coeff_scaleRoots, natDegree_glnHeckePolynomial hT]
  rcases le_or_gt k n with hk | hk
  · obtain ⟨i, rfl⟩ : ∃ i : Fin (n + 1), n - i = k := ⟨⟨n - k, by omega⟩, by simp; omega⟩
    rw [coeff_glnHeckePolynomial, coeff_glnHeckePolynomial, Nat.sub_sub_self i.is_le]
    ring
  · rw [coeff_glnHeckePolynomial_of_lt q _ hk, coeff_glnHeckePolynomial_of_lt q _ hk, zero_mul]

/-- The exponent bookkeeping of the inversion formula, for `i + m = n`:
`n(n-1)/2 + i(i-1)/2 + (n-1)m = n(n-1) + m(m-1)/2`. -/
private theorem choose_two_add_choose_two_add_mul {i m : ℕ} :
    (i + m).choose 2 + i.choose 2 + (i + m - 1) * m = (i + m) * (i + m - 1) + m.choose 2 := by
  rcases Nat.eq_zero_or_pos (i + m) with h | h
  · simp [Nat.eq_zero_of_add_eq_zero_left h, Nat.eq_zero_of_add_eq_zero_right h]
  qify [h]
  push_cast [Nat.cast_choose_two]
  ring

/-- **Inverting the Hecke operators**, integrally: replacing each `Tᵢ` by `T_{n-i}` and
substituting `q^{n-1} X` for `X` turns the Hecke polynomial, after scaling by
`(-1)^n q^{n(n-1)/2}`, into `q^{n(n-1)}` times its reflection `X^n P(1/X)`.  When `Tₙ` is a
unit, `TauCeti.C_coeff_zero_mul_glnHeckePolynomial_rev_mul_comp` gives the normalized form. -/
theorem C_mul_glnHeckePolynomial_rev_comp (q : A) (T : Fin (n + 1) → A) :
    C ((-1) ^ n * q ^ n.choose 2) *
        (glnHeckePolynomial n q fun i => T i.rev).comp (C (q ^ (n - 1)) * X) =
      C (q ^ (n * (n - 1))) * reflect n (glnHeckePolynomial n q T) := by
  refine (ext_iff_natDegree_le
    ((natDegree_C_mul_le _ _).trans (natDegree_glnHeckePolynomial_comp_C_mul_X_le q _ _))
    ((natDegree_C_mul_le _ _).trans
      (natDegree_reflect_le.trans (max_le le_rfl (natDegree_glnHeckePolynomial_le q T))))).2
    fun k hk => ?_
  obtain ⟨i, rfl⟩ : ∃ i : Fin (n + 1), (i : ℕ) = k := ⟨⟨k, Nat.lt_succ_of_le hk⟩, rfl⟩
  obtain ⟨m, hm⟩ : ∃ m, n = m + i := ⟨n - i, by omega⟩
  rw [coeff_C_mul, comp_C_mul_X_coeff, coeff_glnHeckePolynomial_val, Fin.rev_rev, coeff_C_mul,
    coeff_reflect, revAt_le i.is_le, coeff_glnHeckePolynomial,
    show n - i = m by omega]
  have hq : q ^ n.choose 2 * q ^ m.choose 2 * (q ^ (n - 1)) ^ (i : ℕ) =
      q ^ (n * (n - 1)) * q ^ (i : ℕ).choose 2 := by
    generalize (i : ℕ) = j at hm ⊢
    subst hm
    rw [← pow_mul, ← pow_add, ← pow_add, ← pow_add, choose_two_add_choose_two_add_mul]
  have hs : (-1 : A) ^ n * (-1) ^ m = (-1) ^ (i : ℕ) := by
    generalize (i : ℕ) = j at hm ⊢
    subst hm
    rw [← pow_add, show m + j + m = 2 * m + j by ring, pow_add, pow_mul]
    simp
  linear_combination T i * (q ^ n.choose 2 * q ^ m.choose 2 * (q ^ (n - 1)) ^ (i : ℕ) * hs +
    (-1) ^ (i : ℕ) * hq)

/-- **Inverting the Hecke operators**, normalized: if `u` inverts `Tₙ`, the generator rule
`Tᵢ ↦ T_{n-i} / Tₙ` (the effect of `g ↦ g⁻¹` on spherical double cosets) turns the Hecke
polynomial `P` into `ι(P)` with `P(0) · ι(P)(q^{n-1} X) = q^{n(n-1)} X^n P(1/X)`.  Over a
field with `q ≠ 0`, this says that the roots of `ι(P)` are the `q^{n-1}/βⱼ` for the roots `βⱼ`
of `P`, matching the passage from a Galois representation `r` to `r^∨ ⊗ ε^{1-n}`. -/
theorem C_coeff_zero_mul_glnHeckePolynomial_rev_mul_comp (q : A) {T : Fin (n + 1) → A} {u : A}
    (hu : T (Fin.last n) * u = 1) :
    C ((glnHeckePolynomial n q T).coeff 0) *
        (glnHeckePolynomial n q fun i => T i.rev * u).comp (C (q ^ (n - 1)) * X) =
      C (q ^ (n * (n - 1))) * reflect n (glnHeckePolynomial n q T) := by
  rw [← C_mul_glnHeckePolynomial_rev_comp, glnHeckePolynomial_mul_const, mul_comp, C_comp,
    coeff_zero_glnHeckePolynomial]
  have hu' : C (T (Fin.last n)) * C u = 1 := by rw [← C_mul, hu, C_1]
  simp only [C_mul]
  linear_combination ((glnHeckePolynomial n q fun i => T i.rev).comp (C (q ^ (n - 1)) * X)) *
    C ((-1) ^ n) * C (q ^ n.choose 2) * hu'

end CommRing

end TauCeti
