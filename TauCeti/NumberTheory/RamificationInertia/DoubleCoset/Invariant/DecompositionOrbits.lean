module

public import TauCeti.NumberTheory.RamificationInertia.DoubleCoset.Invariant.Basic
import TauCeti.GroupTheory.QuotientGroup.Basic

/-!
# Decomposition-group orbits on cosets and the primes of an invariant ring

Let a finite group `G` act on a commutative ring `B` with invariant ring `A`, let `H` be a
subgroup of `G` with invariant ring `C` between `A` and `B`, and let `Q` be a prime of `B` above
a prime `p` of `A`, with decomposition group `D`. The double coset law
`Ideal.doubleCosetQuotientEquivPrimesOverOfIsInvariant` indexes the primes of `C` above `p` by
`H \ G / D`. This file reads the same law on the left cosets `G ⧸ H`, where `D` acts by
translation: the coset `τ H` is attached to the prime `τ⁻¹ Q ∩ C`
(`Ideal.primesOverOfCoset`), two cosets are attached to the same prime exactly when they lie in
one `D`-orbit, and every prime arises. When `Q` is maximal, `B` is a finite flat `A`-algebra
and a flat `C`-algebra, and `G` and `H` are Galois groups of the domain `B` over `A` and over
`C`, the `D`-orbit of `τ H` has `e · f` elements, where `e` and `f` are the ramification index
and the residue degree of the attached prime over `p`. Altogether, the multiset of the sizes of
the `D`-orbits on `G ⧸ H` is the multiset of the local degrees `e · f` over the primes of `C`
above `p`. No hypothesis on the residue fields is needed.

This is the form of the double coset law that Dedekind's theorem uses: when `M / K` is a finite
Galois extension and `C` is the integral closure of the base in `M ^ H = K(α)`, for a root `α` of
an irreducible polynomial, `G ⧸ H` is the set of roots. If moreover `p` is unramified in `C`, so
that every `e` is `1`, and `D` is generated by a Frobenius element, then the orbit sizes of that
Frobenius on the roots are the residue degrees of the primes of `C` above `p`. Rings of integers
of number fields are the case `A = 𝓞 K`, `B = 𝓞 M`, `C = 𝓞 (M ^ H)`, where every algebraic
hypothesis below is found by instance search.

## Main definitions

* `Ideal.primesOverOfCoset`: the prime `τ⁻¹ Q ∩ C` attached to the coset `τ H`.
* `Ideal.orbitQuotientEquivPrimesOver`: the orbits of the decomposition group on `G ⧸ H` are the
  primes of `C` above `p`.

## Main results

* `Ideal.primesOverOfCoset_eq_iff`: the fibres of `primesOverOfCoset` are the orbits of the
  decomposition group of `Q`.
* `Ideal.primesOverOfCoset_surjective`: every prime of `C` above `p` is attached to a coset.
* `Ideal.card_orbit_stabilizer_coset`: the orbit of a coset under the decomposition group has
  `e · f` elements, for the prime attached to the coset.
* `Ideal.map_card_orbit_stabilizer_eq_map_ramificationIdx_mul_inertiaDeg`: the multiset of orbit
  sizes is the multiset of local degrees over the primes of `C` above `p`.

## References

* [J. Neukirch, *Algebraic Number Theory*][Neukirch1992], Chapter I, §9.
* G. J. Janusz, *Algebraic Number Fields*, Chapter I.
-/

public section

open MulAction
open scoped Pointwise

namespace Ideal

variable {A B G : Type*} [CommRing A] [CommRing B] [Algebra A B]
  [Group G] [MulSemiringAction G B]

section Orbits

variable [SMulCommClass G A B]
  (p : Ideal A) (Q : Ideal B) [Q.IsPrime] [Q.LiesOver p]
  (H : Subgroup G) (C : Type*) [CommRing C] [Algebra A C] [Algebra C B]
  [IsScalarTower A C B] [SMulCommClass H C B]

/-- The prime of the `H`-invariant ring `C` above `p` attached to a coset `τ H`: the contraction
`τ⁻¹ Q ∩ C`. It does not depend on the representative `τ`, because `H` acts `C`-linearly and so
does not move contractions to `C`. -/
noncomputable def primesOverOfCoset : G ⧸ H → p.primesOver C :=
  _root_.Quotient.lift (fun τ => ⟨(τ⁻¹ • Q).under C, inferInstance,
      ⟨by rw [under_under]; exact (inferInstance : (τ⁻¹ • Q).LiesOver p).over⟩⟩) fun τ τ' hτ => by
    apply Subtype.ext
    dsimp only
    obtain ⟨h, rfl⟩ : ∃ h : H, τ' = τ * h :=
      ⟨⟨τ⁻¹ * τ', QuotientGroup.leftRel_apply.mp hτ⟩, by simp⟩
    rw [mul_inv_rev, mul_smul]
    rw [← Subgroup.coe_inv, ← Subgroup.smul_def]
    exact (under_smul (G := H) C (τ⁻¹ • Q) h⁻¹).symm

/-- The prime attached to the coset of `τ` is the contraction of `τ⁻¹ Q`. -/
@[simp]
theorem coe_primesOverOfCoset_mk (τ : G) :
    (primesOverOfCoset p Q H C (τ : G ⧸ H) : Ideal C) = (τ⁻¹ • Q).under C :=
  (rfl)

/-- **The fibres are the orbits of the decomposition group.** Two cosets are attached to the
same prime of `C` exactly when one is a translate of the other by the decomposition group of
`Q`. -/
theorem primesOverOfCoset_eq_iff [Finite H] [Algebra.IsInvariant C B H] (x y : G ⧸ H) :
    primesOverOfCoset p Q H C x = primesOverOfCoset p Q H C y ↔
      x ∈ orbit (stabilizer G Q) y := by
  induction x using QuotientGroup.induction_on with | H τ => ?_
  induction y using QuotientGroup.induction_on with | H τ' => ?_
  rw [Subtype.ext_iff, coe_primesOverOfCoset_mk, coe_primesOverOfCoset_mk,
    under_eq_iff_mem_orbit H C, mem_orbit_iff, mem_orbit_iff]
  constructor
  · rintro ⟨h, hh⟩
    rw [Subgroup.smul_def, smul_smul] at hh
    refine ⟨⟨τ * h * τ'⁻¹, ?_⟩, ?_⟩
    · rw [mem_stabilizer_iff, mul_assoc, mul_smul, hh, smul_smul, mul_inv_cancel, one_smul]
    · rw [Subgroup.smul_def, MulAction.Quotient.smul_mk, QuotientGroup.eq, smul_eq_mul,
        Subgroup.coe_mk]
      convert H.inv_mem h.2 using 1
      group
  · rintro ⟨d, hd⟩
    rw [Subgroup.smul_def, MulAction.Quotient.smul_mk, QuotientGroup.eq] at hd
    have hmem : τ⁻¹ * d * τ' ∈ H := by
      have := H.inv_mem hd
      simpa [mul_inv_rev, mul_assoc] using this
    refine ⟨⟨τ⁻¹ * d * τ', hmem⟩, ?_⟩
    rw [Subgroup.smul_def, smul_smul, mul_inv_cancel_right, mul_smul, mem_stabilizer_iff.mp d.2]

/-- **Every prime of `C` above `p` is attached to a coset.** -/
theorem primesOverOfCoset_surjective [Finite G] [Algebra.IsInvariant A B G] [FaithfulSMul C B] :
    Function.Surjective (primesOverOfCoset p Q H C) := by
  rintro ⟨𝔮, h𝔮, h𝔮p⟩
  obtain ⟨σ, hσ⟩ := Q.exists_smul_under_eq G p C 𝔮
  exact ⟨((σ⁻¹ : G) : G ⧸ H), Subtype.ext (by rw [coe_primesOverOfCoset_mk, inv_inv]; exact hσ)⟩

variable [Finite G] [Algebra.IsInvariant A B G] [FaithfulSMul C B]
  [Algebra.IsInvariant C B H]

/-- **The orbits of the decomposition group on `G ⧸ H` are the primes of `C` above `p`**: the
map `primesOverOfCoset`, which is constant on the orbits of the decomposition group of `Q` and
identifies exactly them, descends to a bijection from the orbit quotient. -/
noncomputable def orbitQuotientEquivPrimesOver :
    orbitRel.Quotient (stabilizer G Q) (G ⧸ H) ≃ p.primesOver C :=
  Equiv.ofBijective
    (_root_.Quotient.lift (primesOverOfCoset p Q H C) fun x y h =>
      (primesOverOfCoset_eq_iff p Q H C x y).mpr (orbitRel_apply.mp h))
    ⟨fun ω ω' h => _root_.Quotient.inductionOn₂' ω ω' (fun x y h => _root_.Quotient.sound'
        (orbitRel_apply.mpr ((primesOverOfCoset_eq_iff p Q H C x y).mp h))) h,
      fun 𝔮 => (primesOverOfCoset_surjective p Q H C 𝔮).elim fun x hx =>
        ⟨_root_.Quotient.mk'' x, hx⟩⟩

/-- The orbit of a coset is sent to the prime attached to the coset. -/
@[simp]
theorem orbitQuotientEquivPrimesOver_mk (x : G ⧸ H) :
    orbitQuotientEquivPrimesOver p Q H C (_root_.Quotient.mk'' x) =
      primesOverOfCoset p Q H C x :=
  (rfl)

end Orbits

section LocalDegree

variable [Finite G] [IsDomain A] [IsDomain B] [Module.Finite A B] [Module.Flat A B]
  [IsGaloisGroup G A B]
  (p : Ideal A) (Q : Ideal B) [Q.IsMaximal] [Q.LiesOver p]
  (H : Subgroup G) (C : Type*) [CommRing C] [IsDomain C] [Algebra A C] [Algebra C B]
  [IsScalarTower A C B] [Module.Flat C B] [IsGaloisGroup H C B]

/-- **Orbit sizes are local degrees.** The orbit of a coset under the decomposition group of `Q`
has as many elements as the ramification index times the residue degree of the prime of `C`
attached to the coset. No hypothesis on the residue fields is needed. -/
theorem card_orbit_stabilizer_coset (x : G ⧸ H) :
    Nat.card (orbit (stabilizer G Q) x) =
      (primesOverOfCoset p Q H C x).1.ramificationIdx A *
        (primesOverOfCoset p Q H C x).1.inertiaDeg A := by
  induction x using QuotientGroup.induction_on with | H τ => ?_
  rw [coe_primesOverOfCoset_mk,
    ramificationIdx_mul_inertiaDeg_under_smul_eq_relIndex (Q := Q) H C τ⁻¹,
    Subgroup.card_orbit_quotientGroup_mk]

variable [FaithfulSMul C B]

/-- **The multiset of orbit sizes is the multiset of local degrees.** The sizes of the orbits of
the decomposition group of `Q` on `G ⧸ H` are, as a multiset, the products `e · f` of the
ramification index and the residue degree over the primes of `C` above `p`. -/
theorem map_card_orbit_stabilizer_eq_map_ramificationIdx_mul_inertiaDeg
    [Fintype (orbitRel.Quotient (stabilizer G Q) (G ⧸ H))] [Fintype (p.primesOver C)] :
    (Finset.univ : Finset (orbitRel.Quotient (stabilizer G Q) (G ⧸ H))).val.map
        (fun ω => Nat.card ω.orbit) =
      (Finset.univ : Finset (p.primesOver C)).val.map
        (fun 𝔮 : p.primesOver C => 𝔮.1.ramificationIdx A * 𝔮.1.inertiaDeg A) := by
  -- The orbit sizes, read through the bijection with the primes above `p`.
  have hcard : ∀ ω : orbitRel.Quotient (stabilizer G Q) (G ⧸ H),
      Nat.card ω.orbit = (orbitQuotientEquivPrimesOver p Q H C ω).1.ramificationIdx A *
        (orbitQuotientEquivPrimesOver p Q H C ω).1.inertiaDeg A := by
    intro ω
    refine _root_.Quotient.inductionOn' ω fun x => ?_
    rw [orbitRel.Quotient.orbit_mk, orbitQuotientEquivPrimesOver_mk p Q H C,
      card_orbit_stabilizer_coset p Q H C]
  calc (Finset.univ : Finset (orbitRel.Quotient (stabilizer G Q) (G ⧸ H))).val.map
          (fun ω => Nat.card ω.orbit)
      = Finset.univ.val.map (fun ω => (orbitQuotientEquivPrimesOver p Q H C ω).1.ramificationIdx
          A * (orbitQuotientEquivPrimesOver p Q H C ω).1.inertiaDeg A) :=
        Multiset.map_congr rfl fun ω _ => hcard ω
    _ = (Finset.univ.val.map (orbitQuotientEquivPrimesOver p Q H C)).map
          (fun 𝔮 : p.primesOver C => 𝔮.1.ramificationIdx A * 𝔮.1.inertiaDeg A) := by
        rw [Multiset.map_map, Function.comp_def]
    _ = _ := by rw [Multiset.map_univ_val_equiv]

end LocalDegree

end Ideal
