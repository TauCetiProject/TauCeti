/-!
# Open subgroups of `GL₂(ℤ̂)` and their levels

Every open subgroup `H` of `GL₂(ℤ̂)` contains some principal congruence subgroup `Gamma N`. The
**level** of `H` (`GL2Zhat.level H`) is the least positive integer `N` with `Gamma N ≤ H`, and it
divides every other modulus `M` with `Gamma M ≤ H`. For any `N` divisible by `level H`, open
subgroups containing `Gamma N` correspond order-isomorphically to subgroups of `GL₂(ℤ / N)`
(`GL2Zhat.orderIsoLevelSubgroup N`), preserving both index and projective index.

Two further invariants of an open subgroup `H` are its determinant subgroup
`detSubgroup H ≤ ℤ̂ˣ` (open, hence of finite determinant level `detLevel H ∣ level H`, with
`IsFullDet H` meaning `det : H → ℤ̂ˣ` is surjective) and its `±`-saturation `pm H` (whose index is
the projective index of `H`). Open subgroups of coprime levels intersect cleanly with multiplicative
index (`index_inf_of_coprime_level`). Conjugation in `GL₂(ℤ̂)` preserves `level`, `index`,
`projectiveIndex`, `detSubgroup`, `detLevel`, `IsFullDet`, and membership of `-1`. Finally, each
`ℓ`-adic projection `projOpenSubgroup H ℓ` is an open subgroup of `GL₂(ℤ_ℓ)` containing the
congruence kernel modulo `ℓ ^ v_ℓ(level H)`, and equals `GL₂(ℤ_ℓ)` whenever `ℓ ∤ level H`.

## Main definitions

* `TauCeti.GL2Zhat.level`: the minimal positive `N` with `Gamma N ≤ H`.
* `TauCeti.GL2Zhat.orderIsoLevelSubgroup`: order isomorphism between `{H // Gamma N ≤ H}` and
  `Subgroup (GL (Fin 2) (ZMod N))`.
* `TauCeti.GL2Zhat.pm`: the open subgroup `±H` generated by `H` and `-1`.
* `TauCeti.GL2Zhat.detGamma`, `TauCeti.GL2Zhat.detSubgroup`, `TauCeti.GL2Zhat.detLevel`,
  `TauCeti.GL2Zhat.IsFullDet`: determinant congruence subgroups, determinant image, determinant
  level, and surjectivity of the determinant on `H`.
* `TauCeti.GL2Zhat.conj`: conjugation of an open subgroup of `GL₂(ℤ̂)`.
* `TauCeti.GL2Zhat.projOpenSubgroup`: the `ℓ`-adic image of `H` as an open subgroup of `GL₂(ℤ_ℓ)`.

## Main results

* `TauCeti.GL2Zhat.Gamma_le_iff`: `Gamma N ≤ H ↔ level H ∣ N`.
* `TauCeti.GL2Zhat.level_inf`: `level (H₁ ⊓ H₂) = Nat.lcm (level H₁) (level H₂)`.
* `TauCeti.GL2Zhat.index_eq_index_map_red`,
  `TauCeti.GL2Zhat.projectiveIndex_eq_projectiveIndex_map_red`: index and projective index agree
  with those of the image in `GL₂(ℤ / N)` whenever `Gamma N ≤ H`.
* `TauCeti.GL2Zhat.index_inf_of_coprime_level`:
  `[GL₂(ℤ̂) : H₁ ⊓ H₂] = [GL₂(ℤ̂) : H₁] · [GL₂(ℤ̂) : H₂]` when `level H₁` and `level H₂` are
  coprime.
* `TauCeti.GL2Zhat.detGamma_le_iff`, `TauCeti.GL2Zhat.detLevel_dvd_level`,
  `TauCeti.GL2Zhat.isFullDet_iff_detLevel_eq_one`, `TauCeti.GL2Zhat.isFullDet_iff_map_red_det`.
* `TauCeti.GL2Zhat.projOpenSubgroup_eq_top_of_not_dvd_level`.

## References

* D. Zywina, *On the possible images of the mod `ℓ` representations associated to elliptic curves
  over `ℚ`*, arXiv:1508.07660, §3.
-/

public section

namespace TauCeti

open Matrix

open scoped Pointwise

namespace GL2Zhat

section Level

private theorem exists_nat_pos_Gamma_le (H : OpenSubgroup GL2Zhat) :
    ∃ n : ℕ, ∃ h : 0 < n, Gamma ⟨n, h⟩ ≤ H := by
  obtain ⟨n, hn⟩ := exists_Gamma_le H
  exact ⟨n, n.pos, hn⟩

/-- The **level** of an open subgroup `H` of `GL₂(ℤ̂)`: the least positive integer `N` such that
`Gamma N ≤ H`. -/
noncomputable def level (H : OpenSubgroup GL2Zhat) : ℕ := by
  classical
  exact Nat.find (exists_nat_pos_Gamma_le H)

/-- The level of an open subgroup of `GL₂(ℤ̂)` is positive. -/
theorem level_pos (H : OpenSubgroup GL2Zhat) : 0 < level H := by
  classical
  exact (Nat.find_spec (exists_nat_pos_Gamma_le H)).1

/-- The level of an open subgroup of `GL₂(ℤ̂)`, bundled as a positive natural number. -/
noncomputable def levelPNat (H : OpenSubgroup GL2Zhat) : ℕ+ :=
  ⟨level H, level_pos H⟩

@[simp]
theorem coe_levelPNat (H : OpenSubgroup GL2Zhat) : (levelPNat H : ℕ) = level H :=
  (rfl)

/-- Every open subgroup of `GL₂(ℤ̂)` contains `Gamma (levelPNat H)`. -/
theorem Gamma_level_le (H : OpenSubgroup GL2Zhat) : Gamma (levelPNat H) ≤ H := by
  classical
  exact (Nat.find_spec (exists_nat_pos_Gamma_le H)).2

/-- `Gamma N ≤ H` if and only if `level H` divides `N`. -/
theorem Gamma_le_iff {H : OpenSubgroup GL2Zhat} {N : ℕ+} :
    Gamma N ≤ H ↔ level H ∣ N := by
  classical
  refine ⟨fun hN ↦ ?_, fun hdiv ↦ (Gamma_le_Gamma_of_dvd hdiv).trans (Gamma_level_le H)⟩
  let d : ℕ+ := ⟨Nat.gcd (levelPNat H) N, Nat.gcd_pos_of_pos_right _ N.pos⟩
  have hd_le : Gamma d ≤ H := by
    have hsup : Gamma (levelPNat H) ⊔ Gamma N ≤ H := sup_le (Gamma_level_le H) hN
    rwa [Gamma_gcd_eq_sup (levelPNat H) N] at hsup
  have hmin : level H ≤ d := Nat.find_min' (exists_nat_pos_Gamma_le H) ⟨d.pos, hd_le⟩
  have hd_eq : (d : ℕ) = level H :=
    Nat.le_antisymm (Nat.le_of_dvd (level_pos H) (Nat.gcd_dvd_left _ _)) hmin
  rw [← hd_eq]
  exact Nat.gcd_dvd_right (levelPNat H : ℕ) N

/-- `level H ≤ N` whenever `Gamma N ≤ H`. -/
theorem level_le_of_Gamma_le {H : OpenSubgroup GL2Zhat} {N : ℕ+} (h : Gamma N ≤ H) :
    level H ≤ N :=
  Nat.le_of_dvd N.pos (Gamma_le_iff.mp h)

/-- The whole group `GL₂(ℤ̂)` has level `1`. -/
@[simp]
theorem level_top : level ⊤ = 1 :=
  Nat.le_antisymm (level_le_of_Gamma_le (N := 1) le_top) (level_pos ⊤)

/-- An open subgroup has level `1` if and only if it is the whole group `GL₂(ℤ̂)`. -/
@[simp]
theorem level_eq_one_iff {H : OpenSubgroup GL2Zhat} : level H = 1 ↔ H = ⊤ := by
  refine ⟨fun h1 ↦ eq_top_iff.mpr ?_, fun htop ↦ htop ▸ level_top⟩
  rw [← Gamma_one]
  exact Gamma_le_iff.mpr (h1 ▸ one_dvd _)

/-- The principal congruence subgroup `Gamma N` has level `N`. -/
@[simp]
theorem level_Gamma (N : ℕ+) : level (Gamma N) = N :=
  Nat.dvd_antisymm (Gamma_le_iff.mp le_rfl)
    (Gamma_le_Gamma_iff.mp (Gamma_level_le (Gamma N)))

/-- Inclusion reverses divisibility of levels: if `H₁ ≤ H₂`, then `level H₂ ∣ level H₁`. -/
theorem level_dvd_of_le {H₁ H₂ : OpenSubgroup GL2Zhat} (h : H₁ ≤ H₂) :
    level H₂ ∣ level H₁ :=
  Gamma_le_iff.mp ((Gamma_level_le H₁).trans h)

/-- The level of the intersection of two open subgroups is the LCM of their levels. -/
theorem level_inf (H₁ H₂ : OpenSubgroup GL2Zhat) :
    level (H₁ ⊓ H₂) = Nat.lcm (level H₁) (level H₂) := by
  let L : ℕ+ := ⟨Nat.lcm (levelPNat H₁) (levelPNat H₂),
    Nat.lcm_pos (levelPNat H₁).pos (levelPNat H₂).pos⟩
  have hL : Gamma L ≤ H₁ ⊓ H₂ := by
    have hinf : Gamma (levelPNat H₁) ⊓ Gamma (levelPNat H₂) ≤ H₁ ⊓ H₂ :=
      inf_le_inf (Gamma_level_le H₁) (Gamma_level_le H₂)
    rwa [← Gamma_lcm_eq_inf (levelPNat H₁) (levelPNat H₂)] at hinf
  have hdvd : level (H₁ ⊓ H₂) ∣ Nat.lcm (level H₁) (level H₂) := Gamma_le_iff.mp hL
  exact Nat.dvd_antisymm hdvd
    (Nat.lcm_dvd (level_dvd_of_le inf_le_left) (level_dvd_of_le inf_le_right))

end Level

section LevelCorrespondence

/-- An open subgroup containing `Gamma N` is determined by its image in `GL₂(ℤ / N)`. -/
theorem comap_map_red_eq_of_Gamma_le {H : OpenSubgroup GL2Zhat} {N : ℕ+}
    (hN : Gamma N ≤ H) :
    (H.toSubgroup.map (red N)).comap (red N) = H.toSubgroup :=
  Subgroup.comap_map_eq_self fun g hg ↦ hN ((mem_Gamma_iff N g).mpr hg)

/-- **Level-`N` correspondence:** open subgroups of `GL₂(ℤ̂)` containing `Gamma N` are in order
isomorphism with subgroups of `GL₂(ℤ / N)`. -/
noncomputable def orderIsoLevelSubgroup (N : ℕ+) :
    {H : OpenSubgroup GL2Zhat // Gamma N ≤ H} ≃o Subgroup (GL (Fin 2) (ZMod N)) where
  toFun H := H.val.toSubgroup.map (red N)
  invFun K :=
    ⟨⟨K.comap (red N),
      Subgroup.isOpen_mono (fun g hg ↦ by
        rw [OpenSubgroup.mem_toSubgroup, mem_Gamma_iff] at hg
        exact Subgroup.mem_comap.mpr (hg ▸ K.one_mem)) (Gamma N).isOpen⟩,
      fun g hg ↦ by
        rw [mem_Gamma_iff] at hg
        exact Subgroup.mem_comap.mpr (hg ▸ K.one_mem)⟩
  left_inv H := Subtype.ext (OpenSubgroup.ext fun _ ↦
    Subgroup.ext_iff.mp (comap_map_red_eq_of_Gamma_le H.property) _)
  right_inv K := Subgroup.map_comap_eq_self_of_surjective (red_surjective N) K
  map_rel_iff' {H₁ H₂} := by
    refine ⟨fun h ↦ Subtype.coe_le_coe.mp (OpenSubgroup.toSubgroup_le.mp ?_),
      fun h ↦ Subgroup.map_mono h⟩
    rw [← comap_map_red_eq_of_Gamma_le H₁.property, ← comap_map_red_eq_of_Gamma_le H₂.property]
    exact Subgroup.comap_mono h

/-- When `Gamma N ≤ H`, the index of `H` in `GL₂(ℤ̂)` equals the index of its image in
`GL₂(ℤ / N)`. -/
theorem index_eq_index_map_red {H : OpenSubgroup GL2Zhat} {N : ℕ+} (hN : Gamma N ≤ H) :
    H.toSubgroup.index = (H.toSubgroup.map (red N)).index := by
  have h : H.toSubgroup = (H.toSubgroup.map (red N)).comap (red N) :=
    (comap_map_red_eq_of_Gamma_le hN).symm
  conv_lhs => rw [h]
  exact Subgroup.index_comap_of_surjective _ (red_surjective N)

/-- When `Gamma N ≤ H`, the index of `H` divides `|GL₂(ℤ / N)|`. -/
theorem index_dvd_natCard_GL_of_Gamma_le {H : OpenSubgroup GL2Zhat} {N : ℕ+}
    (hN : Gamma N ≤ H) :
    H.toSubgroup.index ∣ Nat.card (GL (Fin 2) (ZMod N)) := by
  rw [← index_Gamma N]
  exact Subgroup.index_dvd_of_le hN

/-- Two open subgroups of coprime levels generate `GL₂(ℤ̂)`. -/
theorem sup_eq_top_of_coprime_level {H₁ H₂ : OpenSubgroup GL2Zhat}
    (h : Nat.Coprime (level H₁) (level H₂)) : H₁ ⊔ H₂ = ⊤ := by
  have hd : (⟨Nat.gcd (levelPNat H₁) (levelPNat H₂),
      Nat.gcd_pos_of_pos_left _ (levelPNat H₁).pos⟩ : ℕ+) = 1 :=
    Subtype.ext h
  have hG : Gamma (levelPNat H₁) ⊔ Gamma (levelPNat H₂) = ⊤ :=
    (Gamma_gcd_eq_sup (levelPNat H₁) (levelPNat H₂)).trans ((congrArg Gamma hd).trans Gamma_one)
  exact eq_top_iff.mpr (hG ▸ sup_le ((Gamma_level_le H₁).trans le_sup_left)
    ((Gamma_level_le H₂).trans le_sup_right))

/-- The product of two open subgroups of coprime levels is the whole group `GL₂(ℤ̂)`. -/
theorem mul_eq_univ_of_coprime_level {H₁ H₂ : OpenSubgroup GL2Zhat}
    (h : Nat.Coprime (level H₁) (level H₂)) :
    (H₁.toSubgroup : Set GL2Zhat) * (H₂.toSubgroup : Set GL2Zhat) = Set.univ := by
  rw [Set.eq_univ_iff_forall]
  intro g
  have hd : (⟨Nat.gcd (levelPNat H₁) (levelPNat H₂),
      Nat.gcd_pos_of_pos_left _ (levelPNat H₁).pos⟩ : ℕ+) = 1 :=
    Subtype.ext h
  have hG : Gamma (levelPNat H₁) ⊔ Gamma (levelPNat H₂) = ⊤ :=
    (Gamma_gcd_eq_sup (levelPNat H₁) (levelPNat H₂)).trans ((congrArg Gamma hd).trans Gamma_one)
  have hG_sub : (Gamma (levelPNat H₁)).toSubgroup ⊔ (Gamma (levelPNat H₂)).toSubgroup = ⊤ :=
    congrArg OpenSubgroup.toSubgroup hG
  have hg : g ∈ (Gamma (levelPNat H₁)).toSubgroup ⊔ (Gamma (levelPNat H₂)).toSubgroup := by
    rw [hG_sub]
    trivial
  have hmul : ((Gamma (levelPNat H₁)).toSubgroup : Set GL2Zhat) *
      ((Gamma (levelPNat H₂)).toSubgroup : Set GL2Zhat) =
      ↑((Gamma (levelPNat H₁)).toSubgroup ⊔ (Gamma (levelPNat H₂)).toSubgroup) :=
    (Subgroup.mul_normal (Gamma (levelPNat H₁)).toSubgroup (Gamma (levelPNat H₂)).toSubgroup).symm
  have hmem : g ∈ ((Gamma (levelPNat H₁)).toSubgroup : Set GL2Zhat) *
      ((Gamma (levelPNat H₂)).toSubgroup : Set GL2Zhat) := by
    rw [hmul]
    exact hg
  obtain ⟨a, ha, b, hb, hab⟩ := Set.mem_mul.mp hmem
  exact Set.mem_mul.mpr ⟨a, Gamma_level_le H₁ ha, b, Gamma_level_le H₂ hb, hab⟩

/-- **Multiplicativity of index for coprime levels:** if `level H₁` and `level H₂` are coprime,
then `[GL₂(ℤ̂) : H₁ ⊓ H₂] = [GL₂(ℤ̂) : H₁] · [GL₂(ℤ̂) : H₂]`. -/
theorem index_inf_of_coprime_level {H₁ H₂ : OpenSubgroup GL2Zhat}
    (h : Nat.Coprime (level H₁) (level H₂)) :
    (H₁ ⊓ H₂).toSubgroup.index = H₁.toSubgroup.index * H₂.toSubgroup.index := by
  have hmul := mul_eq_univ_of_coprime_level h
  let φ : GL2Zhat ⧸ (H₁ ⊓ H₂).toSubgroup →
      (GL2Zhat ⧸ H₁.toSubgroup) × (GL2Zhat ⧸ H₂.toSubgroup) :=
    Quotient.lift (fun g ↦ (QuotientGroup.mk g, QuotientGroup.mk g)) fun a b hab ↦ by
      have hab' : a⁻¹ * b ∈ (H₁ ⊓ H₂).toSubgroup := QuotientGroup.leftRel_apply.mp hab
      exact Prod.ext (QuotientGroup.eq.mpr hab'.1) (QuotientGroup.eq.mpr hab'.2)
  have hbij : Function.Bijective φ := by
    refine ⟨?_, ?_⟩
    · rintro ⟨a⟩ ⟨b⟩ hq
      exact QuotientGroup.eq.mpr
        ⟨QuotientGroup.eq.mp (congrArg Prod.fst hq),
          QuotientGroup.eq.mp (congrArg Prod.snd hq)⟩
    · rintro ⟨⟨a⟩, ⟨b⟩⟩
      have hab : a⁻¹ * b ∈ (H₁.toSubgroup : Set GL2Zhat) * (H₂.toSubgroup : Set GL2Zhat) := by
        rw [hmul]
        trivial
      obtain ⟨h₁, hh₁, h₂, hh₂, heq⟩ := Set.mem_mul.mp hab
      refine ⟨QuotientGroup.mk (a * h₁), Prod.ext ?_ ?_⟩
      · exact QuotientGroup.eq.mpr (by simpa [mul_assoc] using H₁.toSubgroup.inv_mem hh₁)
      · have hrel : (a * h₁)⁻¹ * b = h₂ := by
          rw [_root_.mul_inv_rev, mul_assoc, ← heq, inv_mul_cancel_left]
        exact QuotientGroup.eq.mpr (hrel ▸ hh₂)
  rw [Subgroup.index_eq_card, Subgroup.index_eq_card, Subgroup.index_eq_card, ← Nat.card_prod]
  exact Nat.card_congr (Equiv.ofBijective φ hbij)

end LevelCorrespondence

section PlusMinus

/-- The open subgroup `±H` generated by `H` and `-1`. -/
noncomputable def pm (H : OpenSubgroup GL2Zhat) : OpenSubgroup GL2Zhat where
  toSubgroup := H.toSubgroup.adjoinNegOne
  isOpen' := Subgroup.isOpen_mono H.toSubgroup.le_adjoinNegOne H.isOpen

@[simp]
theorem toSubgroup_pm (H : OpenSubgroup GL2Zhat) :
    (pm H).toSubgroup = H.toSubgroup.adjoinNegOne :=
  (rfl)

@[simp]
theorem mem_pm_iff (H : OpenSubgroup GL2Zhat) (g : GL2Zhat) :
    g ∈ pm H ↔ g ∈ H ∨ -g ∈ H :=
  Subgroup.mem_adjoinNegOne_iff

theorem le_pm (H : OpenSubgroup GL2Zhat) : H ≤ pm H :=
  H.toSubgroup.le_adjoinNegOne

theorem neg_one_mem_pm (H : OpenSubgroup GL2Zhat) : -1 ∈ pm H :=
  H.toSubgroup.neg_one_mem_adjoinNegOne

@[simp]
theorem pm_eq_self_iff (H : OpenSubgroup GL2Zhat) : pm H = H ↔ -1 ∈ H := by
  rw [← OpenSubgroup.toSubgroup_injective.eq_iff, toSubgroup_pm]
  exact Subgroup.adjoinNegOne_eq_self_iff

@[simp]
theorem pm_pm (H : OpenSubgroup GL2Zhat) : pm (pm H) = pm H :=
  (pm_eq_self_iff (pm H)).mpr (neg_one_mem_pm H)

/-- When `Gamma N ≤ H`, the projective index of `H` equals the projective index of its image in
`GL₂(ℤ / N)`. -/
theorem projectiveIndex_eq_projectiveIndex_map_red {H : OpenSubgroup GL2Zhat} {N : ℕ+}
    (hN : Gamma N ≤ H) :
    H.toSubgroup.projectiveIndex = (H.toSubgroup.map (red N)).projectiveIndex := by
  have h : H.toSubgroup = (H.toSubgroup.map (red N)).comap (red N) :=
    (comap_map_red_eq_of_Gamma_le hN).symm
  conv_lhs => rw [h]
  exact Subgroup.projectiveIndex_comap_of_surjective _ (red_neg N) (red_surjective N)

/-- The level of `±H` divides the level of `H`. -/
theorem level_pm_dvd (H : OpenSubgroup GL2Zhat) : level (pm H) ∣ level H :=
  level_dvd_of_le (le_pm H)

end PlusMinus

section Determinant

/-- The principal determinant congruence subgroup of level `n : ℕ+`, consisting of units of `ℤ̂`
congruent to `1` modulo `n`. -/
noncomputable def detGamma (n : ℕ+) : OpenSubgroup (Additive zHat.{0})ˣ where
  toSubgroup := (Units.map (zHat.toZMod n : Additive zHat.{0} →* ZMod n)).ker
  isOpen' := by
    have hcont : Continuous (Units.map (zHat.toZMod n : Additive zHat.{0} →* ZMod n)) := by
      rw [Units.continuous_iff]
      exact ⟨(zHat.continuous_toZMod n).comp Units.continuous_val,
        (zHat.continuous_toZMod n).comp Units.continuous_coe_inv⟩
    exact (isOpen_discrete {1}).preimage hcont

@[simp]
theorem mem_detGamma_iff (n : ℕ+) (u : (Additive zHat.{0})ˣ) :
    u ∈ detGamma n ↔ Units.map (zHat.toZMod n : Additive zHat.{0} →* ZMod n) u = 1 :=
  Iff.rfl

@[simp]
theorem detGamma_one : detGamma 1 = ⊤ :=
  OpenSubgroup.ext fun u ↦ by
    simp only [mem_detGamma_iff, OpenSubgroup.mem_top, iff_true]
    apply Units.ext
    simp only [PNat.one_coe]
    exact Subsingleton.elim _ _

/-- `detGamma n` is the determinant image of `Gamma n`. -/
theorem map_det_Gamma (n : ℕ+) :
    (Gamma n).toSubgroup.map (GeneralLinearGroup.det : GL2Zhat →* (Additive zHat.{0})ˣ) =
      (detGamma n).toSubgroup := by
  ext u
  refine ⟨?_, fun hu ↦ ?_⟩
  · rintro ⟨g, hg, rfl⟩
    rw [SetLike.mem_coe, OpenSubgroup.mem_toSubgroup, mem_Gamma_iff] at hg
    rw [OpenSubgroup.mem_toSubgroup, mem_detGamma_iff, map_toZMod_det, hg, map_one]
  · let g : GL2Zhat := GeneralLinearGroup.mk'' !![(u : Additive zHat.{0}), 0; 0, 1]
      (by simp [Matrix.det_fin_two_of])
    refine ⟨g, ?_, ?_⟩
    · rw [SetLike.mem_coe, OpenSubgroup.mem_toSubgroup, mem_Gamma_iff]
      have hu' : zHat.toZMod n (u : Additive zHat.{0}) = 1 := by
        simpa [Units.coe_map] using congrArg Units.val hu
      ext i j
      fin_cases i <;> fin_cases j <;> simp [g, hu']
    · apply Units.ext
      simp [g, Matrix.det_fin_two_of]

/-- `detGamma m ⊔ detGamma n = detGamma (gcd m n)`. -/
theorem detGamma_gcd_eq_sup (m n : ℕ+) :
    detGamma m ⊔ detGamma n = detGamma ⟨Nat.gcd m n, Nat.gcd_pos_of_pos_left n m.pos⟩ := by
  apply OpenSubgroup.toSubgroup_injective
  have h1 : (Gamma m).toSubgroup.map (GeneralLinearGroup.det : GL2Zhat →* (Additive zHat.{0})ˣ) ⊔
      (Gamma n).toSubgroup.map GeneralLinearGroup.det =
      (detGamma ⟨Nat.gcd m n, Nat.gcd_pos_of_pos_left n m.pos⟩).toSubgroup := by
    rw [← Subgroup.map_sup, ← OpenSubgroup.toSubgroup_sup, Gamma_gcd_eq_sup,
      map_det_Gamma ⟨Nat.gcd m n, Nat.gcd_pos_of_pos_left n m.pos⟩]
  rw [OpenSubgroup.toSubgroup_sup, ← map_det_Gamma m, ← map_det_Gamma n]
  exact h1

/-- For every open subgroup `H` of `GL₂(ℤ̂)`, `det H` is open in `ℤ̂ˣ`. -/
theorem isOpen_map_det (H : OpenSubgroup GL2Zhat) :
    IsOpen ((H.toSubgroup.map
      (GeneralLinearGroup.det : GL2Zhat →* (Additive zHat.{0})ˣ) :
        Subgroup (Additive zHat.{0})ˣ) : Set (Additive zHat.{0})ˣ) := by
  have hle : (detGamma (levelPNat H)).toSubgroup ≤
      H.toSubgroup.map (GeneralLinearGroup.det : GL2Zhat →* (Additive zHat.{0})ˣ) := by
    rw [← map_det_Gamma]
    exact Subgroup.map_mono (Gamma_level_le H)
  exact Subgroup.isOpen_mono hle (detGamma (levelPNat H)).isOpen

/-- The determinant image of an open subgroup `H ≤ GL₂(ℤ̂)`, as an open subgroup of `ℤ̂ˣ`. -/
noncomputable def detSubgroup (H : OpenSubgroup GL2Zhat) : OpenSubgroup (Additive zHat.{0})ˣ where
  toSubgroup := H.toSubgroup.map GeneralLinearGroup.det
  isOpen' := isOpen_map_det H

@[simp]
theorem toSubgroup_detSubgroup (H : OpenSubgroup GL2Zhat) :
    (detSubgroup H).toSubgroup = H.toSubgroup.map GeneralLinearGroup.det :=
  (rfl)

theorem detGamma_level_le (H : OpenSubgroup GL2Zhat) :
    detGamma (levelPNat H) ≤ detSubgroup H := by
  rw [← OpenSubgroup.toSubgroup_le, ← map_det_Gamma, toSubgroup_detSubgroup]
  exact Subgroup.map_mono (Gamma_level_le H)

private theorem exists_nat_pos_detGamma_le (H : OpenSubgroup GL2Zhat) :
    ∃ n : ℕ, ∃ h : 0 < n, detGamma ⟨n, h⟩ ≤ detSubgroup H :=
  ⟨level H, level_pos H, detGamma_level_le H⟩

/-- The **determinant level** of an open subgroup `H` of `GL₂(ℤ̂)`: the least positive integer `N`
such that `detGamma N ≤ detSubgroup H`. -/
noncomputable def detLevel (H : OpenSubgroup GL2Zhat) : ℕ := by
  classical
  exact Nat.find (exists_nat_pos_detGamma_le H)

/-- The determinant level of an open subgroup of `GL₂(ℤ̂)` is positive. -/
theorem detLevel_pos (H : OpenSubgroup GL2Zhat) : 0 < detLevel H := by
  classical
  exact (Nat.find_spec (exists_nat_pos_detGamma_le H)).1

/-- The determinant level bundled as a positive natural number. -/
noncomputable def detLevelPNat (H : OpenSubgroup GL2Zhat) : ℕ+ :=
  ⟨detLevel H, detLevel_pos H⟩

@[simp]
theorem coe_detLevelPNat (H : OpenSubgroup GL2Zhat) : (detLevelPNat H : ℕ) = detLevel H :=
  (rfl)

theorem detGamma_detLevel_le (H : OpenSubgroup GL2Zhat) :
    detGamma (detLevelPNat H) ≤ detSubgroup H := by
  classical
  exact (Nat.find_spec (exists_nat_pos_detGamma_le H)).2

/-- `detGamma N ≤ detSubgroup H` if and only if `detLevel H` divides `N`. -/
theorem detGamma_le_iff {H : OpenSubgroup GL2Zhat} {N : ℕ+} :
    detGamma N ≤ detSubgroup H ↔ detLevel H ∣ N := by
  classical
  refine ⟨fun hN ↦ ?_, fun hdiv ↦ ?_⟩
  · let d : ℕ+ := ⟨Nat.gcd (detLevelPNat H) N, Nat.gcd_pos_of_pos_right _ N.pos⟩
    have hd_le : detGamma d ≤ detSubgroup H := by
      have hsup : detGamma (detLevelPNat H) ⊔ detGamma N ≤ detSubgroup H :=
        sup_le (detGamma_detLevel_le H) hN
      rwa [detGamma_gcd_eq_sup (detLevelPNat H) N] at hsup
    have hmin : detLevel H ≤ d := Nat.find_min' (exists_nat_pos_detGamma_le H) ⟨d.pos, hd_le⟩
    have hd_eq : (d : ℕ) = detLevel H :=
      Nat.le_antisymm (Nat.le_of_dvd (detLevel_pos H) (Nat.gcd_dvd_left _ _)) hmin
    rw [← hd_eq]
    exact Nat.gcd_dvd_right (detLevelPNat H : ℕ) N
  · have hsub : detGamma N ≤ detGamma (detLevelPNat H) := by
      rw [← OpenSubgroup.toSubgroup_le, ← map_det_Gamma, ← map_det_Gamma]
      exact Subgroup.map_mono (Gamma_le_Gamma_of_dvd hdiv)
    exact hsub.trans (detGamma_detLevel_le H)

/-- The determinant level of `H` divides the level of `H`. -/
theorem detLevel_dvd_level (H : OpenSubgroup GL2Zhat) : detLevel H ∣ level H := by
  simpa [coe_levelPNat] using (detGamma_le_iff (N := levelPNat H)).mp (detGamma_level_le H)

/-- Predicate asserting that `det : H → ℤ̂ˣ` is surjective. -/
def IsFullDet (H : OpenSubgroup GL2Zhat) : Prop :=
  detSubgroup H = ⊤

theorem isFullDet_iff_detLevel_eq_one {H : OpenSubgroup GL2Zhat} :
    IsFullDet H ↔ detLevel H = 1 := by
  refine ⟨fun hfull ↦ ?_, fun h1 ↦ ?_⟩
  · have hle : detGamma 1 ≤ detSubgroup H := by
      rw [hfull]
      exact le_top
    exact Nat.dvd_one.mp (detGamma_le_iff.mp hle)
  · rw [IsFullDet, eq_top_iff, ← detGamma_one]
    exact detGamma_le_iff.mpr (h1 ▸ one_dvd _)

/-- When `Gamma N ≤ H`, `H` has surjective determinant if and only if its image in `GL₂(ℤ / N)`
has surjective determinant onto `(ℤ / N)ˣ`. -/
theorem isFullDet_iff_map_red_det {H : OpenSubgroup GL2Zhat} {N : ℕ+} (hN : Gamma N ≤ H) :
    IsFullDet H ↔ (H.toSubgroup.map (red N)).map GeneralLinearGroup.det = ⊤ := by
  let φ : (Additive zHat.{0})ˣ →* (ZMod N)ˣ :=
    Units.map (zHat.toZMod N : Additive zHat.{0} →* ZMod N)
  have hcomp : φ.comp (GeneralLinearGroup.det : GL2Zhat →* _) =
      GeneralLinearGroup.det.comp (red N) := by
    ext1 g
    exact map_toZMod_det N g
  have hmap : (H.toSubgroup.map (red N)).map GeneralLinearGroup.det =
      (detSubgroup H).toSubgroup.map φ := by
    rw [Subgroup.map_map, ← hcomp, ← Subgroup.map_map, toSubgroup_detSubgroup]
  rw [hmap, IsFullDet, ← OpenSubgroup.toSubgroup_injective.eq_iff, OpenSubgroup.toSubgroup_top]
  refine ⟨fun htop ↦ ?_, fun htop ↦ ?_⟩
  · rw [htop, Subgroup.map_top_of_surjective φ (zHat.unitsMap_toZMod_surjective.{0} N)]
  · rw [eq_top_iff]
    intro u _
    have hu : φ u ∈ (detSubgroup H).toSubgroup.map φ := by
      rw [htop]
      trivial
    obtain ⟨v, hv, hvu⟩ := Subgroup.mem_map.mp hu
    have hker : v⁻¹ * u ∈ (detGamma N).toSubgroup := by
      rw [OpenSubgroup.mem_toSubgroup, mem_detGamma_iff, map_mul, map_inv, hvu, inv_mul_cancel]
    have hdetN : (detGamma N).toSubgroup ≤ (detSubgroup H).toSubgroup := by
      rw [← map_det_Gamma, toSubgroup_detSubgroup]
      exact Subgroup.map_mono hN
    simpa [mul_assoc] using (detSubgroup H).toSubgroup.mul_mem hv (hdetN hker)

@[simp]
theorem isFullDet_top : IsFullDet ⊤ := by
  rw [isFullDet_iff_detLevel_eq_one, Nat.dvd_one.mp (detLevel_dvd_level ⊤ |>.trans level_top.dvd)]

/-- Adjoining `-1` does not change the determinant image of an open subgroup of `GL₂(ℤ̂)`. -/
@[simp]
theorem detSubgroup_pm (H : OpenSubgroup GL2Zhat) : detSubgroup (pm H) = detSubgroup H := by
  apply OpenSubgroup.ext
  intro u
  rw [← OpenSubgroup.mem_toSubgroup, toSubgroup_detSubgroup, ← OpenSubgroup.mem_toSubgroup,
    toSubgroup_detSubgroup]
  refine ⟨?_, fun hu ↦ Subgroup.map_mono (le_pm H) hu⟩
  rintro ⟨g, hg, rfl⟩
  rcases (mem_pm_iff H g).mp hg with hg | hng
  · exact ⟨g, hg, rfl⟩
  · refine ⟨-g, hng, ?_⟩
    apply Units.ext
    simp [Matrix.det_neg]

@[simp]
theorem detLevel_pm (H : OpenSubgroup GL2Zhat) : detLevel (pm H) = detLevel H := by
  apply Nat.dvd_antisymm
  · rw [← coe_detLevelPNat H]
    refine (detGamma_le_iff (N := detLevelPNat H)).mp ?_
    rw [detSubgroup_pm]
    exact detGamma_detLevel_le H
  · rw [← coe_detLevelPNat (pm H)]
    refine (detGamma_le_iff (N := detLevelPNat (pm H))).mp ?_
    rw [← detSubgroup_pm H]
    exact detGamma_detLevel_le (pm H)

@[simp]
theorem isFullDet_pm_iff (H : OpenSubgroup GL2Zhat) : IsFullDet (pm H) ↔ IsFullDet H := by
  simp [IsFullDet]

end Determinant

section Conjugation

/-- Conjugation of an open subgroup `H ≤ GL₂(ℤ̂)` by `g : GL₂(ℤ̂)`: the subgroup `g H g⁻¹`. -/
noncomputable def conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) : OpenSubgroup GL2Zhat :=
  H.comap (MulAut.conj g⁻¹).toMonoidHom
    ((continuous_const.mul continuous_id).mul continuous_const)

@[simp]
theorem mem_conj_iff {g x : GL2Zhat} {H : OpenSubgroup GL2Zhat} :
    x ∈ conj g H ↔ g⁻¹ * x * g ∈ H :=
  Iff.rfl

@[simp]
theorem conj_one (H : OpenSubgroup GL2Zhat) : conj 1 H = H := by
  ext x
  simp

@[simp]
theorem conj_mul (g₁ g₂ : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    conj (g₁ * g₂) H = conj g₁ (conj g₂ H) := by
  ext x
  simp [mul_assoc]

@[simp]
theorem conj_top (g : GL2Zhat) : conj g ⊤ = ⊤ := by
  ext x
  simp

theorem toSubgroup_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    (conj g H).toSubgroup = ConjAct.toConjAct g • H.toSubgroup := by
  ext x
  rw [OpenSubgroup.mem_toSubgroup, mem_conj_iff, Subgroup.mem_pointwise_smul_iff_inv_smul_mem,
    ← map_inv, ConjAct.smul_def, ConjAct.ofConjAct_toConjAct, inv_inv, mul_assoc]
  rfl

@[simp]
theorem conj_Gamma (g : GL2Zhat) (n : ℕ+) : conj g (Gamma n) = Gamma n := by
  ext x
  rw [mem_conj_iff, mem_Gamma_iff, mem_Gamma_iff, map_mul, map_mul, map_inv]
  refine ⟨fun h ↦ ?_, fun h ↦ by simp [h]⟩
  have h' := congrArg (fun y ↦ red n g * y * (red n g)⁻¹) h
  simpa [mul_assoc] using h'

@[simp]
theorem level_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) : level (conj g H) = level H := by
  apply Nat.dvd_antisymm
  · rw [← coe_levelPNat H]
    refine (Gamma_le_iff (N := levelPNat H)).mp fun x hx ↦ ?_
    rw [mem_conj_iff]
    exact Gamma_level_le H (by simpa [← mem_conj_iff, conj_Gamma] using hx)
  · rw [← coe_levelPNat (conj g H)]
    refine (Gamma_le_iff (N := levelPNat (conj g H))).mp fun x hx ↦ ?_
    have hx' : g * x * g⁻¹ ∈ Gamma (levelPNat (conj g H)) := by
      simpa [← mem_conj_iff, inv_inv, conj_Gamma] using hx
    simpa [mem_conj_iff, mul_assoc] using Gamma_level_le (conj g H) hx'

@[simp]
theorem index_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    (conj g H).toSubgroup.index = H.toSubgroup.index := by
  rw [toSubgroup_conj, Subgroup.index_smul]

@[simp]
theorem projectiveIndex_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    (conj g H).toSubgroup.projectiveIndex = H.toSubgroup.projectiveIndex := by
  rw [toSubgroup_conj, Subgroup.projectiveIndex_pointwise_smul]

@[simp]
theorem detSubgroup_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    detSubgroup (conj g H) = detSubgroup H := by
  ext u
  refine ⟨?_, ?_⟩
  · rintro ⟨x, hx, rfl⟩
    refine ⟨g⁻¹ * x * g, hx, ?_⟩
    simp
  · rintro ⟨x, hx, rfl⟩
    refine ⟨g * x * g⁻¹, ?_, ?_⟩
    · rw [SetLike.mem_coe, OpenSubgroup.mem_toSubgroup, mem_conj_iff]
      simpa [mul_assoc] using hx
    · simp

@[simp]
theorem detLevel_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    detLevel (conj g H) = detLevel H := by
  apply Nat.dvd_antisymm
  · rw [← coe_detLevelPNat H]
    refine (detGamma_le_iff (N := detLevelPNat H)).mp ?_
    rw [detSubgroup_conj]
    exact detGamma_detLevel_le H
  · rw [← coe_detLevelPNat (conj g H)]
    refine (detGamma_le_iff (N := detLevelPNat (conj g H))).mp ?_
    rw [← detSubgroup_conj g H]
    exact detGamma_detLevel_le (conj g H)

@[simp]
theorem isFullDet_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    IsFullDet (conj g H) ↔ IsFullDet H := by
  simp [IsFullDet]

theorem neg_one_mem_conj_iff (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    -1 ∈ conj g H ↔ -1 ∈ H := by
  simp [mem_conj_iff]

end Conjugation

section PadicProjections

/-- The image of an open subgroup `H ≤ GL₂(ℤ̂)` under the `ℓ`-adic projection is open in
`GL₂(ℤ_ℓ)`. -/
theorem isOpen_map_proj (H : OpenSubgroup GL2Zhat) (ℓ : Nat.Primes) :
    IsOpen ((H.toSubgroup.map (proj ℓ) : Subgroup (GL (Fin 2) ℤ_[ℓ])) :
      Set (GL (Fin 2) ℤ_[ℓ])) :=
  isOpenMap_proj ℓ _ H.isOpen

/-- The `ℓ`-adic projection of an open subgroup `H ≤ GL₂(ℤ̂)`, as an open subgroup of
`GL₂(ℤ_ℓ)`. -/
noncomputable def projOpenSubgroup (H : OpenSubgroup GL2Zhat) (ℓ : Nat.Primes) :
    OpenSubgroup (GL (Fin 2) ℤ_[ℓ]) where
  toSubgroup := H.toSubgroup.map (proj ℓ)
  isOpen' := isOpen_map_proj H ℓ

@[simp]
theorem toSubgroup_projOpenSubgroup (H : OpenSubgroup GL2Zhat) (ℓ : Nat.Primes) :
    (projOpenSubgroup H ℓ).toSubgroup = H.toSubgroup.map (proj ℓ) :=
  (rfl)

@[simp]
theorem mem_projOpenSubgroup_iff {H : OpenSubgroup GL2Zhat} {ℓ : Nat.Primes}
    {A : GL (Fin 2) ℤ_[ℓ]} :
    A ∈ projOpenSubgroup H ℓ ↔ ∃ g ∈ H, proj ℓ g = A :=
  Iff.rfl

@[simp]
theorem projOpenSubgroup_top (ℓ : Nat.Primes) : projOpenSubgroup ⊤ ℓ = ⊤ := by
  rw [eq_top_iff]
  intro A _
  obtain ⟨g, hg⟩ := proj_surjective ℓ A
  exact ⟨g, trivial, hg⟩

/-- Reduction modulo `ℓ ^ k` on `GL₂(ℤ_ℓ)`. -/
noncomputable def redPadicPow (ℓ : Nat.Primes) (k : ℕ) :
    GL (Fin 2) ℤ_[ℓ] →* GL (Fin 2) (ZMod ((ℓ : ℕ) ^ k)) :=
  GeneralLinearGroup.map (PadicInt.toZModPow k)

@[simp]
theorem redPadicPow_proj (ℓ : Nat.Primes) (k : ℕ) (g : GL2Zhat) :
    redPadicPow ℓ k (proj ℓ g) = red ⟨(ℓ : ℕ) ^ k, pow_pos ℓ.property.pos k⟩ g :=
  map_toZModPow_proj ℓ k g

private theorem exists_proj_eq_and_mem_Gamma_of_ker {ℓ : Nat.Primes} {N : ℕ+}
    {A : GL (Fin 2) ℤ_[ℓ]} (hA : A ∈ (redPadicPow ℓ ((N : ℕ).factorization ℓ)).ker) :
    ∃ g ∈ Gamma N, proj ℓ g = A := by
  classical
  let f : ∀ q : Nat.Primes, GL (Fin 2) ℤ_[q] := fun q ↦ if h : q = ℓ then h ▸ A else 1
  have hf_self : f ℓ = A := by simp [f]
  have hf_ne : ∀ q, q ≠ ℓ → f q = 1 := fun q hq ↦ by simp [f, hq]
  let g : GL2Zhat := piPadicEquiv.symm f
  refine ⟨g, ?_, ?_⟩
  · rw [mem_Gamma_iff_forall_proj]
    intro q
    rw [proj_piPadicEquiv_symm]
    by_cases hq : q = ℓ
    · subst hq
      rw [hf_self]
      exact hA
    · rw [hf_ne q hq, map_one]
  · rw [← hf_self]
    exact proj_piPadicEquiv_symm f ℓ

/-- Every open subgroup of `GL₂(ℤ_ℓ)` contains the principal congruence kernel
`ker (redPadicPow ℓ k)` for some `k : ℕ`. -/
theorem exists_ker_redPadicPow_le {ℓ : Nat.Primes} (U : OpenSubgroup (GL (Fin 2) ℤ_[ℓ])) :
    ∃ k : ℕ, (redPadicPow ℓ k).ker ≤ U.toSubgroup := by
  obtain ⟨N, hN⟩ := exists_Gamma_le (U.comap (proj ℓ) (continuous_proj ℓ))
  refine ⟨(N : ℕ).factorization ℓ, fun A hA ↦ ?_⟩
  obtain ⟨g, hg_Gamma, hg_proj⟩ := exists_proj_eq_and_mem_Gamma_of_ker hA
  simpa [hg_proj] using hN hg_Gamma

/-- The `ℓ`-adic projection of `H` contains the principal congruence kernel of exponent
`v_ℓ(level H)`. -/
theorem ker_redPadicPow_factorization_le (H : OpenSubgroup GL2Zhat) (ℓ : Nat.Primes) :
    (redPadicPow ℓ ((level H).factorization ℓ)).ker ≤ (projOpenSubgroup H ℓ).toSubgroup := by
  intro A hA
  obtain ⟨g, hg_Gamma, hg_proj⟩ :=
    exists_proj_eq_and_mem_Gamma_of_ker (N := levelPNat H) hA
  exact ⟨g, Gamma_level_le H hg_Gamma, hg_proj⟩

/-- If `ℓ` does not divide `level H`, then the `ℓ`-adic projection of `H` is all of `GL₂(ℤ_ℓ)`. -/
theorem projOpenSubgroup_eq_top_of_not_dvd_level {H : OpenSubgroup GL2Zhat} {ℓ : Nat.Primes}
    (hℓ : ¬ (ℓ : ℕ) ∣ level H) : projOpenSubgroup H ℓ = ⊤ := by
  have hfac : (level H).factorization ℓ = 0 :=
    Nat.factorization_eq_zero_of_not_dvd hℓ
  rw [eq_top_iff]
  intro A _
  have hker : A ∈ (redPadicPow ℓ ((level H).factorization ℓ)).ker := by
    rw [hfac, MonoidHom.mem_ker]
    have : Subsingleton (ZMod ((ℓ : ℕ) ^ 0)) := by
      rw [pow_zero]
      infer_instance
    ext i j
    exact Subsingleton.elim _ _
  exact ker_redPadicPow_factorization_le H ℓ hker

end PadicProjections

end GL2Zhat

