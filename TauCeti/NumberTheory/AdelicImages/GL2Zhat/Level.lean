section Level

private theorem natFind_dvd_of_gcd_closed {P : ℕ → Prop} [DecidablePred P]
    (hne : ∃ n : ℕ, P n) (hpos : ∀ {n}, P n → 0 < n)
    (hgcd : ∀ {m n : ℕ}, P m → P n → P (Nat.gcd m n))
    {n : ℕ} (hPn : P n) :
    Nat.find hne ∣ n := by
  have hm : P (Nat.find hne) := Nat.find_spec hne
  have hd : P (Nat.gcd (Nat.find hne) n) := hgcd hm hPn
  have hmin : Nat.find hne ≤ Nat.gcd (Nat.find hne) n := Nat.find_min' hne hd
  have hd_eq : Nat.gcd (Nat.find hne) n = Nat.find hne :=
    Nat.le_antisymm (Nat.le_of_dvd (hpos hm) (Nat.gcd_dvd_left _ _)) hmin
  rw [← hd_eq]
  exact Nat.gcd_dvd_right _ n

private theorem exists_nat_pos_Gamma_le (H : OpenSubgroup GL2Zhat) :
    ∃ n : ℕ, ∃ h : 0 < n, Gamma ⟨n, h⟩ ≤ H := by
  obtain ⟨n, hn⟩ := H.exists_Gamma_le
  exact ⟨n, n.pos, hn⟩

/-- The **level** of an open subgroup `H` of `GL₂(ℤ̂)`: the least positive integer `N` such that
`Gamma N ≤ H`. -/
noncomputable def _root_.OpenSubgroup.level (H : OpenSubgroup GL2Zhat) : ℕ := by
  classical
  exact Nat.find (exists_nat_pos_Gamma_le H)

/-- The level of an open subgroup of `GL₂(ℤ̂)` is positive. -/
theorem _root_.OpenSubgroup.level_pos (H : OpenSubgroup GL2Zhat) : 0 < H.level := by
  classical
  exact (Nat.find_spec (exists_nat_pos_Gamma_le H)).1

/-- The level of an open subgroup of `GL₂(ℤ̂)`, bundled as a positive natural number. -/
noncomputable def _root_.OpenSubgroup.levelPNat (H : OpenSubgroup GL2Zhat) : ℕ+ :=
  ⟨H.level, H.level_pos⟩

@[simp]
theorem _root_.OpenSubgroup.coe_levelPNat (H : OpenSubgroup GL2Zhat) :
    (H.levelPNat : ℕ) = H.level :=
  (rfl)

/-- Every open subgroup of `GL₂(ℤ̂)` contains `Gamma H.levelPNat`. -/
theorem _root_.OpenSubgroup.Gamma_level_le (H : OpenSubgroup GL2Zhat) :
    Gamma H.levelPNat ≤ H := by
  classical
  exact (Nat.find_spec (exists_nat_pos_Gamma_le H)).2

/-- `Gamma N ≤ H` if and only if `H.level` divides `N`. -/
theorem Gamma_le_iff {H : OpenSubgroup GL2Zhat} {N : ℕ+} :
    Gamma N ≤ H ↔ H.level ∣ N := by
  classical
  refine ⟨fun hN ↦ natFind_dvd_of_gcd_closed (exists_nat_pos_Gamma_le H) (fun h ↦ h.1)
      ?_ ⟨N.pos, hN⟩,
    fun hdiv ↦ (Gamma_le_Gamma_of_dvd hdiv).trans H.Gamma_level_le⟩
  rintro m n ⟨hm, hGm⟩ ⟨hn, hGn⟩
  refine ⟨Nat.gcd_pos_of_pos_left n hm, ?_⟩
  have hsup : Gamma ⟨m, hm⟩ ⊔ Gamma ⟨n, hn⟩ ≤ H := sup_le hGm hGn
  rwa [Gamma_gcd_eq_sup ⟨m, hm⟩ ⟨n, hn⟩] at hsup

/-- `H.level ≤ N` whenever `Gamma N ≤ H`. -/
theorem level_le_of_Gamma_le {H : OpenSubgroup GL2Zhat} {N : ℕ+} (h : Gamma N ≤ H) :
    H.level ≤ N :=
  Nat.le_of_dvd N.pos (Gamma_le_iff.mp h)

/-- The whole group `GL₂(ℤ̂)` has level `1`. -/
@[simp]
theorem _root_.OpenSubgroup.level_top : (⊤ : OpenSubgroup GL2Zhat).level = 1 :=
  Nat.le_antisymm (level_le_of_Gamma_le (N := 1) le_top) (OpenSubgroup.level_pos ⊤)

/-- An open subgroup has level `1` if and only if it is the whole group `GL₂(ℤ̂)`. -/
@[simp]
theorem level_eq_one_iff {H : OpenSubgroup GL2Zhat} : H.level = 1 ↔ H = ⊤ := by
  refine ⟨fun h1 ↦ eq_top_iff.mpr ?_, fun htop ↦ htop ▸ OpenSubgroup.level_top⟩
  rw [← Gamma_one]
  exact Gamma_le_iff.mpr (h1 ▸ one_dvd _)

/-- The principal congruence subgroup `Gamma N` has level `N`. -/
@[simp]
theorem level_Gamma (N : ℕ+) : (Gamma N).level = N :=
  Nat.dvd_antisymm (Gamma_le_iff.mp le_rfl)
    (Gamma_le_Gamma_iff.mp (Gamma N).Gamma_level_le)

/-- Inclusion reverses divisibility of levels: if `H₁ ≤ H₂`, then `H₂.level ∣ H₁.level`. -/
theorem level_dvd_of_le {H₁ H₂ : OpenSubgroup GL2Zhat} (h : H₁ ≤ H₂) :
    H₂.level ∣ H₁.level :=
  Gamma_le_iff.mp (H₁.Gamma_level_le.trans h)

/-- The level of the intersection of two open subgroups is the LCM of their levels. -/
theorem _root_.OpenSubgroup.level_inf (H₁ H₂ : OpenSubgroup GL2Zhat) :
    (H₁ ⊓ H₂).level = Nat.lcm H₁.level H₂.level := by
  let L : ℕ+ := ⟨Nat.lcm H₁.levelPNat H₂.levelPNat,
    Nat.lcm_pos H₁.levelPNat.pos H₂.levelPNat.pos⟩
  have hL : Gamma L ≤ H₁ ⊓ H₂ := by
    have hinf : Gamma H₁.levelPNat ⊓ Gamma H₂.levelPNat ≤ H₁ ⊓ H₂ :=
      inf_le_inf H₁.Gamma_level_le H₂.Gamma_level_le
    rwa [← Gamma_lcm_eq_inf H₁.levelPNat H₂.levelPNat] at hinf
  have hdvd : (H₁ ⊓ H₂).level ∣ Nat.lcm H₁.level H₂.level := Gamma_le_iff.mp hL
  exact Nat.dvd_antisymm hdvd
    (Nat.lcm_dvd (level_dvd_of_le inf_le_left) (level_dvd_of_le inf_le_right))

end Level

section LevelCorrespondence

/-- An open subgroup containing `Gamma N` is determined by its image in `GL₂(ℤ / N)`. -/
theorem comap_map_red_eq_of_Gamma_le {H : OpenSubgroup GL2Zhat} {N : ℕ+}
    (hN : Gamma N ≤ H) :
    (H.toSubgroup.map (red N)).comap (red N) = H.toSubgroup :=
  Subgroup.comap_map_eq_self fun g hg ↦ hN ((mem_Gamma_iff N g).mpr hg)

/-- **Level-`N` correspondence:** open subgroups of `GL₂(ℤ̂)` containing `Gamma N` are in order
isomorphism with subgroups of `GL₂(ℤ / N)`. -/
noncomputable def orderIsoLevelSubgroup (N : ℕ+) :
    {H : OpenSubgroup GL2Zhat // Gamma N ≤ H} ≃o Subgroup (GL (Fin 2) (ZMod N)) :=
  let e₁ : {H : OpenSubgroup GL2Zhat // Gamma N ≤ H} ≃o Set.Ici (Gamma N).toSubgroup :=
    { toFun := fun H ↦ ⟨H.val.toSubgroup, H.property⟩
      invFun := fun K ↦ ⟨⟨K.val, Subgroup.isOpen_mono K.property (Gamma N).isOpen⟩, K.property⟩
      left_inv := fun _ ↦ Subtype.ext (OpenSubgroup.ext fun _ ↦ Iff.rfl)
      right_inv := fun _ ↦ Subtype.ext rfl
      map_rel_iff' := Iff.rfl }
  (e₁.trans (QuotientGroup.comapMk'OrderIso (Gamma N).toSubgroup).symm).trans
    (quotientGammaEquiv N).mapSubgroup

@[simp]
theorem orderIsoLevelSubgroup_apply (N : ℕ+) (H : {H : OpenSubgroup GL2Zhat // Gamma N ≤ H}) :
    orderIsoLevelSubgroup N H = H.val.toSubgroup.map (red N) := by
  change (H.val.toSubgroup.map (QuotientGroup.mk' (Gamma N).toSubgroup)).map
      (quotientGammaEquiv N).toMonoidHom = H.val.toSubgroup.map (red N)
  rw [Subgroup.map_map]
  congr 1
  ext1 g
  exact quotientGammaEquiv_mk N g

@[simp]
theorem toSubgroup_orderIsoLevelSubgroup_symm (N : ℕ+)
    (K : Subgroup (GL (Fin 2) (ZMod N))) :
    ((orderIsoLevelSubgroup N).symm K).val.toSubgroup = K.comap (red N) := by
  change (K.map ((quotientGammaEquiv N).symm : GL (Fin 2) (ZMod N) →* _)).comap
      (QuotientGroup.mk' (Gamma N).toSubgroup) = K.comap (red N)
  rw [← Subgroup.comap_equiv_eq_map_symm, Subgroup.comap_comap]
  congr 1
  ext1 g
  exact quotientGammaEquiv_mk N g

/-- When `Gamma N ≤ H`, the index of `H` in `GL₂(ℤ̂)` equals the index of its image in
`GL₂(ℤ / N)`. -/
theorem index_eq_index_map_red {H : OpenSubgroup GL2Zhat} {N : ℕ+} (hN : Gamma N ≤ H) :
    H.toSubgroup.index = (H.toSubgroup.map (red N)).index := by
  have h : H.toSubgroup = (H.toSubgroup.map (red N)).comap (red N) :=
    (comap_map_red_eq_of_Gamma_le hN).symm
  conv_lhs => rw [h]
  exact Subgroup.index_comap_of_surjective _ (red_surjective N)

/-- When `Gamma N ≤ H`, the index of `H` divides `|GL₂(ℤ / N)|`. -/
theorem index_dvd_natCard_GL_of_Gamma_le {H : OpenSubgroup GL2Zhat} {N : ℕ+}
    (hN : Gamma N ≤ H) :
    H.toSubgroup.index ∣ Nat.card (GL (Fin 2) (ZMod N)) := by
  rw [← index_Gamma N]
  exact Subgroup.index_dvd_of_le hN

/-- The product of two open subgroups of coprime levels is the whole group `GL₂(ℤ̂)`. -/
theorem mul_eq_univ_of_coprime_level {H₁ H₂ : OpenSubgroup GL2Zhat}
    (h : Nat.Coprime H₁.level H₂.level) :
    (H₁.toSubgroup : Set GL2Zhat) * (H₂.toSubgroup : Set GL2Zhat) = Set.univ := by
  rw [Set.eq_univ_iff_forall]
  intro g
  have hG : (Gamma H₁.levelPNat).toSubgroup ⊔ (Gamma H₂.levelPNat).toSubgroup = ⊤ := by
    rw [← OpenSubgroup.toSubgroup_sup,
      Gamma_sup_Gamma_eq_top_of_coprime (m := H₁.levelPNat) (n := H₂.levelPNat) h,
      OpenSubgroup.toSubgroup_top]
  have hmul : ((Gamma H₁.levelPNat).toSubgroup : Set GL2Zhat) *
      ((Gamma H₂.levelPNat).toSubgroup : Set GL2Zhat) =
      ↑((Gamma H₁.levelPNat).toSubgroup ⊔ (Gamma H₂.levelPNat).toSubgroup) :=
    (Subgroup.mul_normal (Gamma H₁.levelPNat).toSubgroup
      (Gamma H₂.levelPNat).toSubgroup).symm
  have hmem : g ∈ ((Gamma H₁.levelPNat).toSubgroup : Set GL2Zhat) *
      ((Gamma H₂.levelPNat).toSubgroup : Set GL2Zhat) := by
    rw [hmul, hG]
    trivial
  obtain ⟨a, ha, b, hb, hab⟩ := Set.mem_mul.mp hmem
  exact Set.mem_mul.mpr ⟨a, H₁.Gamma_level_le ha, b, H₂.Gamma_level_le hb, hab⟩

/-- Two open subgroups of coprime levels generate `GL₂(ℤ̂)`. -/
theorem sup_eq_top_of_coprime_level {H₁ H₂ : OpenSubgroup GL2Zhat}
    (h : Nat.Coprime H₁.level H₂.level) : H₁ ⊔ H₂ = ⊤ := by
  rw [← OpenSubgroup.toSubgroup_injective.eq_iff, OpenSubgroup.toSubgroup_sup,
    OpenSubgroup.toSubgroup_top, eq_top_iff]
  intro g _
  have hg : g ∈ (H₁.toSubgroup : Set GL2Zhat) * (H₂.toSubgroup : Set GL2Zhat) := by
    rw [mul_eq_univ_of_coprime_level h]
    trivial
  obtain ⟨a, ha, b, hb, hab⟩ := Set.mem_mul.mp hg
  rw [← hab]
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_left ha) (Subgroup.mem_sup_right hb)

private theorem index_inf_of_mul_eq_univ {G : Type*} [Group G] {H K : Subgroup G}
    (hmul : (H : Set G) * (K : Set G) = Set.univ) :
    (H ⊓ K).index = H.index * K.index := by
  rw [Subgroup.index_inf]
  congr 1
  rw [← Subgroup.relIndex_top_right]
  refine Nat.card_congr (Equiv.ofBijective
    (Subgroup.quotientSubgroupOfEmbeddingOfLE H (le_top : K ≤ ⊤))
    ⟨(Subgroup.quotientSubgroupOfEmbeddingOfLE H le_top).injective, fun x ↦ ?_⟩)
  refine Quotient.inductionOn' x fun ⟨g, _⟩ ↦ ?_
  have hg : g⁻¹ ∈ (H : Set G) * (K : Set G) := by
    rw [hmul]
    trivial
  obtain ⟨h, hh, k, hk, hhk⟩ := Set.mem_mul.mp hg
  refine ⟨QuotientGroup.mk ⟨k⁻¹, K.inv_mem hk⟩, ?_⟩
  rw [Subgroup.quotientSubgroupOfEmbeddingOfLE_apply_mk, QuotientGroup.eq]
  change (k⁻¹)⁻¹ * g ∈ H
  rw [inv_inv]
  have hkg : k * g = h⁻¹ := by rw [← inv_inv g, ← hhk, _root_.mul_inv_rev, mul_inv_cancel_left]
  exact hkg ▸ H.inv_mem hh

/-- **Multiplicativity of index for coprime levels:** if `H₁.level` and `H₂.level` are coprime,
then `[GL₂(ℤ̂) : H₁ ⊓ H₂] = [GL₂(ℤ̂) : H₁] · [GL₂(ℤ̂) : H₂]`. -/
theorem index_inf_of_coprime_level {H₁ H₂ : OpenSubgroup GL2Zhat}
    (h : Nat.Coprime H₁.level H₂.level) :
    (H₁ ⊓ H₂).toSubgroup.index = H₁.toSubgroup.index * H₂.toSubgroup.index := by
  rw [OpenSubgroup.toSubgroup_inf]
  exact index_inf_of_mul_eq_univ (mul_eq_univ_of_coprime_level h)

end LevelCorrespondence

section PlusMinus

/-- The open subgroup `±H` generated by `H` and `-1`. -/
noncomputable def _root_.OpenSubgroup.pm (H : OpenSubgroup GL2Zhat) : OpenSubgroup GL2Zhat where
  toSubgroup := H.toSubgroup.adjoinNegOne
  isOpen' := Subgroup.isOpen_mono H.toSubgroup.le_adjoinNegOne H.isOpen

@[simp]
theorem _root_.OpenSubgroup.toSubgroup_pm (H : OpenSubgroup GL2Zhat) :
    H.pm.toSubgroup = H.toSubgroup.adjoinNegOne :=
  (rfl)

@[simp]
theorem _root_.OpenSubgroup.mem_pm_iff (H : OpenSubgroup GL2Zhat) (g : GL2Zhat) :
    g ∈ H.pm ↔ g ∈ H ∨ -g ∈ H :=
  Subgroup.mem_adjoinNegOne_iff

theorem _root_.OpenSubgroup.le_pm (H : OpenSubgroup GL2Zhat) : H ≤ H.pm :=
  H.toSubgroup.le_adjoinNegOne

theorem _root_.OpenSubgroup.neg_one_mem_pm (H : OpenSubgroup GL2Zhat) : -1 ∈ H.pm :=
  H.toSubgroup.neg_one_mem_adjoinNegOne

@[simp]
theorem _root_.OpenSubgroup.pm_eq_self_iff (H : OpenSubgroup GL2Zhat) : H.pm = H ↔ -1 ∈ H := by
  rw [← OpenSubgroup.toSubgroup_injective.eq_iff, H.toSubgroup_pm]
  exact Subgroup.adjoinNegOne_eq_self_iff

@[simp]
theorem _root_.OpenSubgroup.pm_pm (H : OpenSubgroup GL2Zhat) : H.pm.pm = H.pm :=
  H.pm.pm_eq_self_iff.mpr H.neg_one_mem_pm

/-- When `Gamma N ≤ H.pm`, the projective index of `H` equals the projective index of its image
in `GL₂(ℤ / N)`. -/
theorem projectiveIndex_eq_projectiveIndex_map_red {H : OpenSubgroup GL2Zhat} {N : ℕ+}
    (hN : Gamma N ≤ H.pm) :
    H.toSubgroup.projectiveIndex = (H.toSubgroup.map (red N)).projectiveIndex := by
  rw [Subgroup.projectiveIndex_def, Subgroup.projectiveIndex_def, ← H.toSubgroup_pm,
    index_eq_index_map_red hN, H.toSubgroup_pm, Subgroup.map_adjoinNegOne _ (red N) (red_neg N)]

/-- The level of `±H` divides the level of `H`. -/
theorem _root_.OpenSubgroup.level_pm_dvd (H : OpenSubgroup GL2Zhat) : H.pm.level ∣ H.level :=
  level_dvd_of_le H.le_pm

end PlusMinus

section Determinant

/-- `zHat.detGamma n` is the determinant image of `Gamma n`. -/
theorem map_det_Gamma (n : ℕ+) :
    (Gamma n).toSubgroup.map (GeneralLinearGroup.det : GL2Zhat →* (Additive zHat.{0})ˣ) =
      (zHat.detGamma.{0} n).toSubgroup := by
  ext u
  refine ⟨?_, fun hu ↦ ?_⟩
  · rintro ⟨g, hg, rfl⟩
    rw [SetLike.mem_coe, OpenSubgroup.mem_toSubgroup, mem_Gamma_iff] at hg
    rw [OpenSubgroup.mem_toSubgroup, zHat.mem_detGamma_iff]
    simp [RingHom.toMonoidHom_eq_coe, hg]
  · rw [OpenSubgroup.mem_toSubgroup, zHat.mem_detGamma_iff] at hu
    let g : GL2Zhat := GeneralLinearGroup.mk'' !![(u : Additive zHat.{0}), 0; 0, 1]
      (by simp [Matrix.det_fin_two_of])
    refine ⟨g, ?_, ?_⟩
    · rw [SetLike.mem_coe, OpenSubgroup.mem_toSubgroup, mem_Gamma_iff]
      have hu' : zHat.toZMod n (u : Additive zHat.{0}) = 1 := by
        simpa [Units.coe_map] using congrArg Units.val hu
      ext i j
      fin_cases i <;> fin_cases j <;> simp [g, hu']
    · apply Units.ext
      simp [g, Matrix.det_fin_two_of]

/-- For every open subgroup `H` of `GL₂(ℤ̂)`, `det H` is open in `ℤ̂ˣ`. -/
theorem _root_.OpenSubgroup.isOpen_map_det (H : OpenSubgroup GL2Zhat) :
    IsOpen ((H.toSubgroup.map
      (GeneralLinearGroup.det : GL2Zhat →* (Additive zHat.{0})ˣ) :
        Subgroup (Additive zHat.{0})ˣ) : Set (Additive zHat.{0})ˣ) := by
  have hle : (zHat.detGamma.{0} H.levelPNat).toSubgroup ≤
      H.toSubgroup.map (GeneralLinearGroup.det : GL2Zhat →* (Additive zHat.{0})ˣ) := by
    rw [← map_det_Gamma]
    exact Subgroup.map_mono H.Gamma_level_le
  exact Subgroup.isOpen_mono hle (zHat.detGamma.{0} H.levelPNat).isOpen

/-- The determinant image of an open subgroup `H ≤ GL₂(ℤ̂)`, as an open subgroup of `ℤ̂ˣ`. -/
noncomputable def _root_.OpenSubgroup.detSubgroup (H : OpenSubgroup GL2Zhat) :
    OpenSubgroup (Additive zHat.{0})ˣ where
  toSubgroup := H.toSubgroup.map GeneralLinearGroup.det
  isOpen' := H.isOpen_map_det

@[simp]
theorem _root_.OpenSubgroup.toSubgroup_detSubgroup (H : OpenSubgroup GL2Zhat) :
    H.detSubgroup.toSubgroup = H.toSubgroup.map GeneralLinearGroup.det :=
  (rfl)

theorem _root_.OpenSubgroup.detGamma_level_le (H : OpenSubgroup GL2Zhat) :
    zHat.detGamma.{0} H.levelPNat ≤ H.detSubgroup := by
  rw [← OpenSubgroup.toSubgroup_le, ← map_det_Gamma, H.toSubgroup_detSubgroup]
  exact Subgroup.map_mono H.Gamma_level_le

private theorem exists_nat_pos_detGamma_le (H : OpenSubgroup GL2Zhat) :
    ∃ n : ℕ, ∃ h : 0 < n, zHat.detGamma.{0} ⟨n, h⟩ ≤ H.detSubgroup :=
  ⟨H.level, H.level_pos, H.detGamma_level_le⟩

/-- The **determinant level** of an open subgroup `H` of `GL₂(ℤ̂)`: the least positive integer `N`
such that `zHat.detGamma N ≤ H.detSubgroup`. -/
noncomputable def _root_.OpenSubgroup.detLevel (H : OpenSubgroup GL2Zhat) : ℕ := by
  classical
  exact Nat.find (exists_nat_pos_detGamma_le H)

/-- The determinant level of an open subgroup of `GL₂(ℤ̂)` is positive. -/
theorem _root_.OpenSubgroup.detLevel_pos (H : OpenSubgroup GL2Zhat) : 0 < H.detLevel := by
  classical
  exact (Nat.find_spec (exists_nat_pos_detGamma_le H)).1

/-- The determinant level bundled as a positive natural number. -/
noncomputable def _root_.OpenSubgroup.detLevelPNat (H : OpenSubgroup GL2Zhat) : ℕ+ :=
  ⟨H.detLevel, H.detLevel_pos⟩

@[simp]
theorem _root_.OpenSubgroup.coe_detLevelPNat (H : OpenSubgroup GL2Zhat) :
    (H.detLevelPNat : ℕ) = H.detLevel :=
  (rfl)

theorem _root_.OpenSubgroup.detGamma_detLevel_le (H : OpenSubgroup GL2Zhat) :
    zHat.detGamma.{0} H.detLevelPNat ≤ H.detSubgroup := by
  classical
  exact (Nat.find_spec (exists_nat_pos_detGamma_le H)).2

/-- `zHat.detGamma N ≤ H.detSubgroup` if and only if `H.detLevel` divides `N`. -/
theorem detGamma_le_iff {H : OpenSubgroup GL2Zhat} {N : ℕ+} :
    zHat.detGamma.{0} N ≤ H.detSubgroup ↔ H.detLevel ∣ N := by
  classical
  refine ⟨fun hN ↦ natFind_dvd_of_gcd_closed (exists_nat_pos_detGamma_le H) (fun h ↦ h.1)
      ?_ ⟨N.pos, hN⟩,
    fun hdiv ↦ (zHat.detGamma_le_detGamma_of_dvd hdiv).trans H.detGamma_detLevel_le⟩
  rintro m n ⟨hm, hGm⟩ ⟨hn, hGn⟩
  refine ⟨Nat.gcd_pos_of_pos_left n hm, ?_⟩
  have hsup : zHat.detGamma.{0} ⟨m, hm⟩ ⊔ zHat.detGamma.{0} ⟨n, hn⟩ ≤ H.detSubgroup :=
    sup_le hGm hGn
  rwa [zHat.detGamma_gcd_eq_sup ⟨m, hm⟩ ⟨n, hn⟩] at hsup

/-- The determinant level of `H` divides the level of `H`. -/
theorem _root_.OpenSubgroup.detLevel_dvd_level (H : OpenSubgroup GL2Zhat) :
    H.detLevel ∣ H.level := by
  simpa [H.coe_levelPNat] using (detGamma_le_iff (N := H.levelPNat)).mp H.detGamma_level_le

/-- Predicate asserting that `det : H → ℤ̂ˣ` is surjective. -/
def _root_.OpenSubgroup.IsFullDet (H : OpenSubgroup GL2Zhat) : Prop :=
  H.detSubgroup = ⊤

/-- `H` has surjective determinant if and only if every unit of `ℤ̂` is realized as `det g` for
some `g ∈ H`. -/
theorem _root_.OpenSubgroup.isFullDet_iff (H : OpenSubgroup GL2Zhat) :
    H.IsFullDet ↔ ∀ u : (Additive zHat.{0})ˣ, ∃ g ∈ H, GeneralLinearGroup.det g = u := by
  rw [OpenSubgroup.IsFullDet, OpenSubgroup.ext_iff]
  refine ⟨fun h u ↦ ?_, fun h u ↦ ?_⟩
  · exact (h u).mpr trivial
  · exact ⟨fun _ ↦ trivial, fun _ ↦ h u⟩

/-- An open subgroup `H ≤ GL₂(ℤ̂)` has full determinant if and only if its determinant level is
`1`. -/
theorem isFullDet_iff_detLevel_eq_one {H : OpenSubgroup GL2Zhat} :
    H.IsFullDet ↔ H.detLevel = 1 := by
  refine ⟨fun hfull ↦ ?_, fun h1 ↦ ?_⟩
  · have hle : zHat.detGamma.{0} 1 ≤ H.detSubgroup := by
      rw [hfull]
      exact le_top
    exact Nat.dvd_one.mp (detGamma_le_iff.mp hle)
  · rw [OpenSubgroup.IsFullDet, eq_top_iff, ← zHat.detGamma_one]
    exact detGamma_le_iff.mpr (h1 ▸ one_dvd _)

/-- When `zHat.detGamma N ≤ H.detSubgroup`, `H` has surjective determinant if and only if its
image in `GL₂(ℤ / N)` has surjective determinant onto `(ℤ / N)ˣ`. -/
theorem isFullDet_iff_map_red_det {H : OpenSubgroup GL2Zhat} {N : ℕ+}
    (hN : zHat.detGamma.{0} N ≤ H.detSubgroup) :
    H.IsFullDet ↔ (H.toSubgroup.map (red N)).map GeneralLinearGroup.det = ⊤ := by
  let φ : (Additive zHat.{0})ˣ →* (ZMod N)ˣ :=
    Units.map (zHat.toZMod N : Additive zHat.{0} →* ZMod N)
  have hcomp : φ.comp (GeneralLinearGroup.det : GL2Zhat →* _) =
      GeneralLinearGroup.det.comp (red N) := by
    ext1 g
    exact map_toZMod_det N g
  have hmap : (H.toSubgroup.map (red N)).map GeneralLinearGroup.det =
      H.detSubgroup.toSubgroup.map φ := by
    rw [Subgroup.map_map, ← hcomp, ← Subgroup.map_map, H.toSubgroup_detSubgroup]
  have htop : (⊤ : Subgroup (Additive zHat.{0})ˣ).map φ = ⊤ :=
    Subgroup.map_top_of_surjective φ (zHat.unitsMap_toZMod_surjective.{0} N)
  have hker_eq : φ.ker = (zHat.detGamma.{0} N).toSubgroup := by
    ext u
    simp [φ, zHat.mem_detGamma_iff]
  rw [hmap, OpenSubgroup.IsFullDet, ← OpenSubgroup.toSubgroup_injective.eq_iff,
    OpenSubgroup.toSubgroup_top]
  refine ⟨fun h ↦ by rw [h, htop], fun h ↦ ?_⟩
  exact Subgroup.map_injective_of_ker_le φ (hker_eq ▸ hN) (hker_eq ▸ le_top) (h.trans htop.symm)

/-- The full group `GL₂(ℤ̂)` has surjective determinant. -/
@[simp]
theorem _root_.OpenSubgroup.isFullDet_top : (⊤ : OpenSubgroup GL2Zhat).IsFullDet := by
  rw [isFullDet_iff_detLevel_eq_one,
    Nat.dvd_one.mp ((⊤ : OpenSubgroup GL2Zhat).detLevel_dvd_level.trans OpenSubgroup.level_top.dvd)]

/-- Adjoining `-1` does not change the determinant image of an open subgroup of `GL₂(ℤ̂)`. -/
@[simp]
theorem _root_.OpenSubgroup.detSubgroup_pm (H : OpenSubgroup GL2Zhat) :
    H.pm.detSubgroup = H.detSubgroup := by
  apply OpenSubgroup.ext
  intro u
  rw [← OpenSubgroup.mem_toSubgroup, H.pm.toSubgroup_detSubgroup,
    ← OpenSubgroup.mem_toSubgroup, H.toSubgroup_detSubgroup]
  refine ⟨?_, fun hu ↦ Subgroup.map_mono H.le_pm hu⟩
  rintro ⟨g, hg, rfl⟩
  rcases (H.mem_pm_iff g).mp hg with hg | hng
  · exact ⟨g, hg, rfl⟩
  · refine ⟨-g, hng, ?_⟩
    apply Units.ext
    simp [Matrix.det_neg]

private theorem detLevel_eq_of_detSubgroup_eq {H₁ H₂ : OpenSubgroup GL2Zhat}
    (h : H₁.detSubgroup = H₂.detSubgroup) : H₁.detLevel = H₂.detLevel := by
  apply Nat.dvd_antisymm
  · rw [← H₂.coe_detLevelPNat]
    exact detGamma_le_iff.mp (h ▸ H₂.detGamma_detLevel_le)
  · rw [← H₁.coe_detLevelPNat]
    exact detGamma_le_iff.mp (h.symm ▸ H₁.detGamma_detLevel_le)

/-- Adjoining `-1` preserves the determinant level of an open subgroup of `GL₂(ℤ̂)`. -/
@[simp]
theorem _root_.OpenSubgroup.detLevel_pm (H : OpenSubgroup GL2Zhat) :
    H.pm.detLevel = H.detLevel :=
  detLevel_eq_of_detSubgroup_eq H.detSubgroup_pm

/-- Adjoining `-1` preserves full determinant for an open subgroup of `GL₂(ℤ̂)`. -/
@[simp]
theorem _root_.OpenSubgroup.isFullDet_pm_iff (H : OpenSubgroup GL2Zhat) :
    H.pm.IsFullDet ↔ H.IsFullDet := by
  simp [OpenSubgroup.IsFullDet]

end Determinant

section Conjugation

/-- Conjugation of an open subgroup `H ≤ GL₂(ℤ̂)` by `g : GL₂(ℤ̂)`: the subgroup `g⁻¹ H g`
(LMFDB's `H^g`). -/
noncomputable def conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) : OpenSubgroup GL2Zhat :=
  H.comap (MulAut.conj g).toMonoidHom
    ((continuous_const.mul continuous_id).mul continuous_const)

/-- Membership in `conj g H` is membership of `g * x * g⁻¹` in `H`. -/
@[simp]
theorem mem_conj_iff {g x : GL2Zhat} {H : OpenSubgroup GL2Zhat} :
    x ∈ conj g H ↔ g * x * g⁻¹ ∈ H :=
  Iff.rfl

/-- Conjugation by `1` acts trivially on open subgroups. -/
@[simp]
theorem conj_one (H : OpenSubgroup GL2Zhat) : conj 1 H = H := by
  ext x
  simp

/-- Conjugation forms a right action of `GL₂(ℤ̂)` on open subgroups:
`H^(g₁ g₂) = (H^g₁)^g₂`. -/
@[simp]
theorem conj_mul (g₁ g₂ : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    conj (g₁ * g₂) H = conj g₂ (conj g₁ H) := by
  ext x
  simp [mul_assoc]

/-- Conjugation preserves the full group `GL₂(ℤ̂)`. -/
@[simp]
theorem conj_top (g : GL2Zhat) : conj g ⊤ = ⊤ := by
  ext x
  simp

/-- The underlying subgroup of `conj g H` is the pointwise `ConjAct` translate by `g⁻¹`. -/
theorem toSubgroup_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    (conj g H).toSubgroup = (ConjAct.toConjAct g)⁻¹ • H.toSubgroup := by
  ext x
  rw [OpenSubgroup.mem_toSubgroup, mem_conj_iff, Subgroup.mem_pointwise_smul_iff_inv_smul_mem,
    inv_inv, ConjAct.smul_def, ConjAct.ofConjAct_toConjAct, mul_assoc]
  rfl

/-- Principal congruence subgroups are invariant under conjugation in `GL₂(ℤ̂)`. -/
@[simp]
theorem conj_Gamma (g : GL2Zhat) (n : ℕ+) : conj g (Gamma n) = Gamma n := by
  apply OpenSubgroup.toSubgroup_injective
  rw [toSubgroup_conj, ← map_inv ConjAct.toConjAct g]
  exact Subgroup.conjAct_pointwise_smul_eq_self
    (Subgroup.le_normalizer_of_normal (Subgroup.mem_top g⁻¹))

/-- Conjugation preserves the level of an open subgroup of `GL₂(ℤ̂)`. -/
@[simp]
theorem level_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) : (conj g H).level = H.level := by
  apply Nat.dvd_antisymm
  · rw [← H.coe_levelPNat]
    refine (Gamma_le_iff (N := H.levelPNat)).mp fun x hx ↦ ?_
    rw [mem_conj_iff]
    exact H.Gamma_level_le (by simpa [← mem_conj_iff, conj_Gamma] using hx)
  · rw [← (conj g H).coe_levelPNat]
    refine (Gamma_le_iff (N := (conj g H).levelPNat)).mp fun x hx ↦ ?_
    have hx' : g⁻¹ * x * g ∈ Gamma (conj g H).levelPNat := by
      have hx'' : x ∈ conj g⁻¹ (Gamma (conj g H).levelPNat) := by
        rw [conj_Gamma]
        exact hx
      simpa using (mem_conj_iff (g := g⁻¹)).mp hx''
    simpa [mem_conj_iff, mul_assoc] using (conj g H).Gamma_level_le hx'

/-- Conjugation preserves the index of an open subgroup of `GL₂(ℤ̂)`. -/
@[simp]
theorem index_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    (conj g H).toSubgroup.index = H.toSubgroup.index := by
  rw [toSubgroup_conj, Subgroup.index_smul]

/-- Conjugation preserves the projective index of an open subgroup of `GL₂(ℤ̂)`. -/
@[simp]
theorem projectiveIndex_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    (conj g H).toSubgroup.projectiveIndex = H.toSubgroup.projectiveIndex := by
  rw [toSubgroup_conj, Subgroup.projectiveIndex_pointwise_smul]

/-- Conjugation preserves the determinant subgroup of an open subgroup of `GL₂(ℤ̂)`. -/
@[simp]
theorem detSubgroup_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    (conj g H).detSubgroup = H.detSubgroup := by
  ext u
  refine ⟨?_, ?_⟩
  · rintro ⟨x, hx, rfl⟩
    refine ⟨g * x * g⁻¹, hx, ?_⟩
    simp
  · rintro ⟨x, hx, rfl⟩
    refine ⟨g⁻¹ * x * g, ?_, ?_⟩
    · rw [SetLike.mem_coe, OpenSubgroup.mem_toSubgroup, mem_conj_iff]
      simpa [mul_assoc] using hx
    · simp

/-- Conjugation preserves the determinant level of an open subgroup of `GL₂(ℤ̂)`. -/
@[simp]
theorem detLevel_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    (conj g H).detLevel = H.detLevel :=
  detLevel_eq_of_detSubgroup_eq (detSubgroup_conj g H)

/-- Conjugation preserves the full-determinant property for open subgroups of `GL₂(ℤ̂)`. -/
@[simp]
theorem isFullDet_conj (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    (conj g H).IsFullDet ↔ H.IsFullDet := by
  simp [OpenSubgroup.IsFullDet]

/-- Conjugation preserves membership of `-1`. -/
theorem neg_one_mem_conj_iff (g : GL2Zhat) (H : OpenSubgroup GL2Zhat) :
    -1 ∈ conj g H ↔ -1 ∈ H := by
  simp [mem_conj_iff]

end Conjugation

section PadicProjections

/-- The image of an open subgroup `H ≤ GL₂(ℤ̂)` under the `ℓ`-adic projection is open in
`GL₂(ℤ_ℓ)`. -/
theorem _root_.OpenSubgroup.isOpen_map_proj (H : OpenSubgroup GL2Zhat) (ℓ : Nat.Primes) :
    IsOpen ((H.toSubgroup.map (proj ℓ) : Subgroup (GL (Fin 2) ℤ_[ℓ])) :
      Set (GL (Fin 2) ℤ_[ℓ])) :=
  isOpenMap_proj ℓ _ H.isOpen

/-- The `ℓ`-adic projection of an open subgroup `H ≤ GL₂(ℤ̂)`, as an open subgroup of
`GL₂(ℤ_ℓ)`. -/
noncomputable def _root_.OpenSubgroup.projOpenSubgroup (H : OpenSubgroup GL2Zhat)
    (ℓ : Nat.Primes) :
    OpenSubgroup (GL (Fin 2) ℤ_[ℓ]) where
  toSubgroup := H.toSubgroup.map (proj ℓ)
  isOpen' := H.isOpen_map_proj ℓ

@[simp]
theorem _root_.OpenSubgroup.toSubgroup_projOpenSubgroup (H : OpenSubgroup GL2Zhat)
    (ℓ : Nat.Primes) :
    (H.projOpenSubgroup ℓ).toSubgroup = H.toSubgroup.map (proj ℓ) :=
  (rfl)

@[simp]
theorem _root_.OpenSubgroup.mem_projOpenSubgroup_iff (H : OpenSubgroup GL2Zhat) (ℓ : Nat.Primes)
    (A : GL (Fin 2) ℤ_[ℓ]) :
    A ∈ H.projOpenSubgroup ℓ ↔ ∃ g ∈ H, proj ℓ g = A :=
  Iff.rfl

@[simp]
theorem _root_.OpenSubgroup.projOpenSubgroup_top (ℓ : Nat.Primes) :
    (⊤ : OpenSubgroup GL2Zhat).projOpenSubgroup ℓ = ⊤ := by
  rw [eq_top_iff]
  intro A _
  obtain ⟨g, hg⟩ := proj_surjective ℓ A
  exact ⟨g, trivial, hg⟩

private theorem exists_proj_eq_and_mem_Gamma_of_ker {ℓ : Nat.Primes} {N : ℕ+}
    {A : GL (Fin 2) ℤ_[ℓ]} (hA : A ∈ (redPadicPow (ℓ : ℕ) ((N : ℕ).factorization ℓ)).ker) :
    ∃ g ∈ Gamma N, proj ℓ g = A := by
  classical
  let g : GL2Zhat := piPadicEquiv.symm (Pi.mulSingle ℓ A)
  refine ⟨g, ?_, ?_⟩
  · rw [mem_Gamma_iff_forall_proj]
    intro q
    rw [proj_piPadicEquiv_symm]
    by_cases hq : q = ℓ
    · subst hq
      simpa using hA
    · simp [hq]
  · simp [g]

/-- The `ℓ`-adic projection of `H` contains the principal congruence kernel of exponent
`v_ℓ(H.level)`. -/
theorem _root_.OpenSubgroup.ker_redPadicPow_factorization_le (H : OpenSubgroup GL2Zhat)
    (ℓ : Nat.Primes) :
    (redPadicPow (ℓ : ℕ) (H.level.factorization ℓ)).ker ≤ (H.projOpenSubgroup ℓ).toSubgroup := by
  intro A hA
  obtain ⟨g, hg_Gamma, hg_proj⟩ :=
    exists_proj_eq_and_mem_Gamma_of_ker (N := H.levelPNat) hA
  exact ⟨g, H.Gamma_level_le hg_Gamma, hg_proj⟩

/-- The local level of the `ℓ`-adic projection of `H` divides `ℓ ^ v_ℓ(H.level)`. -/
theorem _root_.OpenSubgroup.localLevel_projOpenSubgroup_dvd (H : OpenSubgroup GL2Zhat)
    (ℓ : Nat.Primes) :
    (H.projOpenSubgroup ℓ).localLevel ∣ (ℓ : ℕ) ^ H.level.factorization ℓ :=
  (H.projOpenSubgroup ℓ).ker_redPadicPow_le_iff_dvd.mp
    (H.ker_redPadicPow_factorization_le ℓ)

/-- If `ℓ` does not divide `H.level`, then the `ℓ`-adic projection of `H` is all of `GL₂(ℤ_ℓ)`. -/
theorem _root_.OpenSubgroup.projOpenSubgroup_eq_top_of_not_dvd_level (H : OpenSubgroup GL2Zhat)
    {ℓ : Nat.Primes} (hℓ : ¬ (ℓ : ℕ) ∣ H.level) : H.projOpenSubgroup ℓ = ⊤ := by
  have hfac : H.level.factorization ℓ = 0 :=
    Nat.factorization_eq_zero_of_not_dvd hℓ
  rw [eq_top_iff]
  intro A _
  have hker : A ∈ (redPadicPow (ℓ : ℕ) (H.level.factorization ℓ)).ker := by
    rw [hfac, MonoidHom.mem_ker]
    have : Subsingleton (ZMod ((ℓ : ℕ) ^ 0)) := by
      rw [pow_zero]
      infer_instance
    ext i j
    exact Subsingleton.elim _ _
  exact H.ker_redPadicPow_factorization_le ℓ hker

end PadicProjections

end GL2Zhat

end TauCeti
