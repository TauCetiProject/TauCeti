module

public import TauCeti.NumberTheory.DirichletCharacter.Primitive.CyclicFamily.Basic
public import TauCeti.NumberTheory.DirichletCharacter.FrobeniusCoset
public import TauCeti.GroupTheory.FiniteAbelian.QuadraticTwists
import Mathlib.Analysis.Complex.Polynomial.Basic
import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed

/-!
# Recognizing untwisted characters by their primitive conductors

For a cyclotomic quotient with two independent quadratic inertia factors, the characters
trivial on the common kernel give the four twists of a cyclic family. The primitive pullback
belongs to the untwisted family exactly when neither auxiliary prime divides its conductor.
This is the distinction between the kept and discarded terms in Frobenius Riesz averages,
as in Levent Alpöge's `Formalism.HC.HostRaw.Kept`.
-/

public section

namespace MonoidHom

open TauCeti

variable {N : ℕ} [NeZero N] {G : Type*}

/-- Under a surjective cyclotomic quotient, taking the primitive pullback recognizes membership
in the cyclic family without confusing distinct quotient characters. -/
theorem primitive_pullback_mem_cyclicFamily_iff [MulOneClass G] (f : (ZMod N)ˣ →* G)
    (hf : Function.Surjective f) (ψ χ : G →* ℂˣ) :
    PrimitiveDirichletCharacter.of (MulChar.ofUnitHom (χ.comp f)) ∈
      (PrimitiveDirichletCharacter.of (MulChar.ofUnitHom (ψ.comp f))).cyclicFamily ↔
      χ ∈ Subgroup.zpowers ψ := by
  let P : (G →* ℂˣ) →* DirichletCharacter ℂ N :=
    MulChar.mulEquivToUnitHom.symm.toMonoidHom.comp (compHom' f)
  have hP (φ : G →* ℂˣ) : P φ = MulChar.ofUnitHom (φ.comp f) := (rfl)
  have hinj : Function.Injective (PrimitiveDirichletCharacter.of (N := N)) := by
    intro a b he
    obtain ⟨h, hb⟩ := PrimitiveDirichletCharacter.of_eq_iff.mp he
    exact hb.symm.trans (PrimitiveDirichletCharacter.changeLevel_character_of b)
  have hp : Function.Injective P := by
    intro a b hab
    have hab' := MulChar.equivToUnitHom.symm.injective (by simpa only [hP, MulChar.ofUnitHom_eq]
      using hab : MulChar.equivToUnitHom.symm (a.comp f) = MulChar.equivToUnitHom.symm (b.comp f))
    exact MonoidHom.ext fun x ↦ by
      obtain ⟨u, rfl⟩ := hf x
      exact DFunLike.congr_fun hab' u
  have hpow (l : ℤ) : PrimitiveDirichletCharacter.of (P (ψ ^ l)) =
      PrimitiveDirichletCharacter.of ((PrimitiveDirichletCharacter.of (P ψ)).character ^ l) := by
    calc
      _ = PrimitiveDirichletCharacter.of (DirichletCharacter.changeLevel
            (PrimitiveDirichletCharacter.level_of_dvd (P ψ))
            ((PrimitiveDirichletCharacter.of (P ψ)).character ^ l)) := by
        rw [P.map_zpow, MonoidHom.map_zpow, PrimitiveDirichletCharacter.changeLevel_character_of]
      _ = _ := PrimitiveDirichletCharacter.of_changeLevel _ _
  rw [← hP, ← hP, PrimitiveDirichletCharacter.mem_cyclicFamily_iff_exists_zpow]
  simp_rw [← hpow, hinj.eq_iff, hp.eq_iff, Subgroup.mem_zpowers_iff]

/-- Among the surviving characters, the untwisted primitive family consists exactly of those
whose conductor is divisible by neither auxiliary prime. Each inertia group is generated by
the detecting element for its own quadratic factor. -/
theorem primitive_pullback_mem_cyclicFamily_iff_not_dvd_level [CommGroup G]
    (f : (ZMod N)ˣ →* G) (hf : Function.Surjective f) (ψ α β χ : G →* ℂˣ)
    (hα : α ^ 2 = 1) (hβ : β ^ 2 = 1) {q d : ℕ} (hq : q.Prime) (hd : d.Prime)
    {u v : G} (hu : f.cyclotomicInertia q = Subgroup.zpowers u)
    (hv : f.cyclotomicInertia d = Subgroup.zpowers v)
    (huψ : ψ u = 1) (huα : α u ≠ 1) (huβ : β u = 1)
    (hvψ : ψ v = 1) (hvα : α v = 1) (hvβ : β v ≠ 1)
    (hχ : ψ.ker ⊓ α.ker ⊓ β.ker ≤ χ.ker) :
    PrimitiveDirichletCharacter.of (MulChar.ofUnitHom (χ.comp f)) ∈
        (PrimitiveDirichletCharacter.of (MulChar.ofUnitHom (ψ.comp f))).cyclicFamily ↔
      ¬ q ∣ (PrimitiveDirichletCharacter.of (MulChar.ofUnitHom (χ.comp f))).level ∧
      ¬ d ∣ (PrimitiveDirichletCharacter.of (MulChar.ofUnitHom (χ.comp f))).level := by
  let : Finite G := Finite.of_surjective f hf
  have hdual := (CommGroup.mem_subgroupOrderIsoSubgroupMonoidHom_iff (M := ℂ) _ χ).mpr hχ
  rw [f.primitive_pullback_mem_cyclicFamily_iff hf,
    ψ.mem_zpowers_iff_apply_eq_one_of_mem_dual_inf_ker α β χ hα hβ huψ huα huβ hvψ hvα hvβ hdual,
    PrimitiveDirichletCharacter.level_of,
    f.not_dvd_conductor_ofUnitHom_comp_iff χ hq, f.not_dvd_conductor_ofUnitHom_comp_iff χ hd,
    hu, hv, Subgroup.zpowers_le, Subgroup.zpowers_le, mem_ker, mem_ker]

end MonoidHom
