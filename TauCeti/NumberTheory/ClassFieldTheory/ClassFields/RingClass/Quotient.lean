module

public import TauCeti.NumberTheory.NumberField.Global.Ideles.Ray.ClassQuotient
public import TauCeti.NumberTheory.NumberField.Global.Orders.RayClass
import TauCeti.NumberTheory.NumberField.Global.Orders.Quadratic.Conductor
import TauCeti.NumberTheory.NumberField.Global.RayClass.Integral

/-!
# The idelic ring-class quotient of an order

Let `O` be an order in a number field `K` with conductor `𝔣`. The ring class field of `O` is the
abelian extension of `K` whose norm subgroup in the idele class group `C_K` is the kernel of a
surjection `C_K → Pic O`. This file constructs that surjection, `ringClassIdeleQuotient O`, as the
ray class map `C_K → Cl_𝔣` of the conductor followed by the congruence description
`Cl_𝔣 → Pic O` of the Picard group (`NumberFieldOrder.rayClassToPic`), which sends the ray class
of an ideal `J` of `𝓞 K` prime to `𝔣` to the class of its contraction `J ∩ O`.

Its kernel is the arithmetic input the class-field correspondence turns into the ring class field:
it is an open subgroup of finite index, its index is the order of `Pic O`, and it consists of the
idele classes whose ray class modulo `𝔣` is represented by a principal ideal with a generator in
`O`. For the maximal order the conductor is trivial, and the kernel is the ray subgroup of the
trivial modulus, the norm subgroup of the Hilbert class field. The construction needs no
hypothesis on the degree of `K`. In a quadratic field, where `O = ℤ + f 𝓞 K` for the index `f`
of `O`, the elements of `O` are exactly the elements of `𝓞 K` congruent to a rational integer
modulo `f` (`NumberFieldOrder.mem_toRingOfIntegers_iff_exists_int_add_index_mul`), which
recovers the classical description of the kernel by ideals with a rational generator modulo `f`
(`mem_ker_ringClassIdeleQuotient_iff_of_finrank_eq_two`).

## Main definitions

* `TauCeti.ClassFieldTheory.ringClassIdeleQuotient`: the surjection `C_K → Pic O`.

## Main results

* `TauCeti.ClassFieldTheory.ringClassIdeleQuotient_surjective`: the quotient map is surjective.
* `TauCeti.ClassFieldTheory.mem_ker_ringClassIdeleQuotient_iff`: an idele class lies in the kernel
  exactly when its ray class modulo the conductor is the class of an ideal generated by an element
  of `O`; `mem_ker_ringClassIdeleQuotient_iff_of_finrank_eq_two` is the quadratic form, with a
  generator congruent to a rational integer modulo the index of `O`.
* `TauCeti.ClassFieldTheory.isOpen_ker_ringClassIdeleQuotient` and
  `TauCeti.ClassFieldTheory.finiteIndex_ker_ringClassIdeleQuotient`: the kernel is open and of
  finite index, with index `#Pic O` (`index_ker_ringClassIdeleQuotient`).
* `TauCeti.ClassFieldTheory.ker_ringClassIdeleQuotient_maximalNumberFieldOrder`: for the maximal
  order the kernel is the ray subgroup of the trivial modulus.

## References

* D. A. Cox, *Primes of the Form x² + ny²*, §7, Propositions 7.20 and 7.22, and §9.
* G. S. Kopp and J. C. Lagarias, *Class Field Theory for Orders of Number Fields*.
-/

public section
noncomputable section

open NumberField
open TauCeti.GlobalNumberFields TauCeti.GlobalNumberFields.NumberFieldOrder

namespace TauCeti.ClassFieldTheory

variable {K : Type*} [Field K] [NumberField K] (O : NumberFieldOrder K)

/-- **The idelic ring-class quotient of an order.** The ray class modulo the conductor of an idele
class, read in the Picard group `Pic O` through the congruence description
`NumberFieldOrder.rayClassToPic`. -/
def ringClassIdeleQuotient : IdeleClassGroup (𝓞 K) K →* Pic O :=
  O.rayClassToPic.comp (rayClassQuotient O.conductorModulus)

/-- The ring-class quotient of an idele class is the Picard class of its ray class modulo the
conductor. -/
theorem ringClassIdeleQuotient_apply (c : IdeleClassGroup (𝓞 K) K) :
    ringClassIdeleQuotient O c = O.rayClassToPic (rayClassQuotient O.conductorModulus c) :=
  (rfl)

/-- **The ring-class quotient is surjective**: every Picard class is the class of an ideal of
`𝓞 K` prime to the conductor, and every ray class comes from an idele class. -/
theorem ringClassIdeleQuotient_surjective : Function.Surjective (ringClassIdeleQuotient O) :=
  O.rayClassToPic_surjective.comp (rayClassQuotient_surjective O.conductorModulus)

/-- The kernel of the ring-class quotient is the preimage of the kernel of the congruence
description under the ray class map of the conductor. -/
theorem ker_ringClassIdeleQuotient :
    (ringClassIdeleQuotient O).ker =
      O.rayClassToPic.ker.comap (rayClassQuotient O.conductorModulus) :=
  (MonoidHom.comap_ker _ _).symm

/-- **The kernel of the ring-class quotient.** An idele class lies in the kernel exactly when its
ray class modulo the conductor is the ray class of an ideal of `𝓞 K` generated by an element of
the order. -/
theorem mem_ker_ringClassIdeleQuotient_iff {c : IdeleClassGroup (𝓞 K) K} :
    c ∈ (ringClassIdeleQuotient O).ker ↔
      ∃ J : integralIdealsPrimeTo O.conductorModulus,
        idealClass O.conductorModulus J = rayClassQuotient O.conductorModulus c ∧
          ∃ β ∈ O.toRingOfIntegers, (J : Ideal (𝓞 K)) = Ideal.span {β} := by
  rw [ker_ringClassIdeleQuotient, Subgroup.mem_comap, mem_ker_rayClassToPic]

/-- **The kernel of the ring-class quotient in a quadratic field.** There `O = ℤ + f 𝓞 K` for the
index `f` of `O`, so an idele class lies in the kernel exactly when its ray class modulo the
conductor is the ray class of an ideal of `𝓞 K` generated by an element congruent to a rational
integer modulo `f`. -/
theorem mem_ker_ringClassIdeleQuotient_iff_of_finrank_eq_two (hK : Module.finrank ℚ K = 2)
    {c : IdeleClassGroup (𝓞 K) K} :
    c ∈ (ringClassIdeleQuotient O).ker ↔
      ∃ J : integralIdealsPrimeTo O.conductorModulus,
        idealClass O.conductorModulus J = rayClassQuotient O.conductorModulus c ∧
          ∃ (a : ℤ) (y : 𝓞 K), (J : Ideal (𝓞 K)) = Ideal.span {(a : 𝓞 K) + O.index * y} := by
  rw [mem_ker_ringClassIdeleQuotient_iff]
  refine exists_congr fun J ↦ and_congr_right fun _ ↦ ⟨?_, ?_⟩
  · rintro ⟨β, hβ, hJ⟩
    obtain ⟨a, y, rfl⟩ := (O.mem_toRingOfIntegers_iff_exists_int_add_index_mul hK β).mp hβ
    exact ⟨a, y, hJ⟩
  · rintro ⟨a, y, hJ⟩
    exact ⟨_, (O.mem_toRingOfIntegers_iff_exists_int_add_index_mul hK _).mpr ⟨a, y, rfl⟩, hJ⟩

/-- The ray subgroup of the conductor lies in the kernel of the ring-class quotient. -/
theorem raySubgroup_le_ker_ringClassIdeleQuotient :
    raySubgroup O.conductorModulus ≤ (ringClassIdeleQuotient O).ker := by
  rw [ker_ringClassIdeleQuotient, ← ker_rayClassQuotient]
  exact MonoidHom.ker_le_comap _ _

/-- **The kernel of the ring-class quotient is open**: it contains the open ray subgroup of the
conductor. -/
theorem isOpen_ker_ringClassIdeleQuotient :
    IsOpen ((ringClassIdeleQuotient O).ker : Set (IdeleClassGroup (𝓞 K) K)) :=
  Subgroup.isOpen_mono (raySubgroup_le_ker_ringClassIdeleQuotient O)
    (isOpen_raySubgroup O.conductorModulus)

/-- **The kernel of the ring-class quotient has finite index**, the Picard group being finite. -/
instance finiteIndex_ker_ringClassIdeleQuotient : (ringClassIdeleQuotient O).ker.FiniteIndex :=
  Subgroup.finiteIndex_ker _

/-- The index of the kernel of the ring-class quotient is the order of the Picard group. -/
theorem index_ker_ringClassIdeleQuotient :
    (ringClassIdeleQuotient O).ker.index = Nat.card (Pic O) := by
  rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr (ringClassIdeleQuotient_surjective O),
    Subgroup.card_top]

/-- **The ring-class quotient of the maximal order** has kernel the ray subgroup of the trivial
modulus: the conductor is trivial, and every principal ideal has a generator in `𝓞 K`. -/
theorem ker_ringClassIdeleQuotient_maximalNumberFieldOrder :
    (ringClassIdeleQuotient (maximalNumberFieldOrder K)).ker = raySubgroup (Modulus.one K) := by
  -- The congruence description of the maximal order has trivial kernel.
  have hker : (maximalNumberFieldOrder K).rayClassToPic.ker = ⊥ := by
    refine (Subgroup.eq_bot_iff_forall _).mpr fun c hc ↦ ?_
    obtain ⟨J, rfl, β, -, hJ⟩ := (maximalNumberFieldOrder K).mem_ker_rayClassToPic.mp hc
    refine (idealClass_eq_one_iff_exists_generator J).mpr ⟨β, ?_, fun w hw ↦ ?_, hJ⟩
    · simp
    · simp at hw
  rw [ker_ringClassIdeleQuotient, hker, MonoidHom.comap_bot, ker_rayClassQuotient,
    conductorModulus_maximalNumberFieldOrder]

end TauCeti.ClassFieldTheory
