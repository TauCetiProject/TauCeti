public import TauCeti.NumberTheory.ClassFieldTheory.ClassFields.RingClass.Quadratic
public import TauCeti.NumberTheory.NumberField.Cyclotomic.Four.Basic
public import TauCeti.NumberTheory.NumberField.Global.Orders.Discriminant
import TauCeti.NumberTheory.Multiquadratic.FundamentalDiscriminant.Values

/-!
# Ring class field checks on orders of `ℚ(i)`

This file evaluates the ring class field `ringClassField O` and its Artin reciprocity isomorphism
`ringClassArtinEquiv O : Pic O ≃* Gal(ringClassField O / K)` on the orders
`GlobalNumberFields.intAddMulOrder K f = ℤ + f ℤ[i]` of a fourth cyclotomic field `K = ℚ(i)`.

For the nonmaximal order `ℤ + 2ℤ[i]` (`intAddMulOrder K 2`), `discr O = -16` and conductor
`𝔣 = 2 𝓞 K`. Although `#(𝓞 K ⧸ 2 𝓞 K)ˣ = 2` and `#(O ⧸ 2 𝓞 K)ˣ = φ(2) = 1`, the unit-index
correction `[(𝓞 K)ˣ : Oˣ] = 2` (`±i ∉ ℤ + 2ℤ[i]`) cancels the residue-unit factor `2 / (1 · 2) = 1`,
so `Pic (intAddMulOrder K 2)` is trivial. Hence `Gal(ringClassField (intAddMulOrder K 2) / K)` is
trivial and `ringClassField (intAddMulOrder K 2) = ⊥` (`= K`). Every invertible proper fractional
ideal of `ℤ + 2ℤ[i]` is principal, and every integral ideal of `ℤ[i]` prime to `2` is generated by
an element of `ℤ + 2ℤ[i]`. By contrast, the imaginary-quadratic classification
(`ringClassField_intAddMulOrder_eq_bot_iff`) gives `ringClassField (intAddMulOrder K f) ≠ ⊥` for
every conductor `f > 2`.

## Main results

In namespace `TauCeti.ClassFieldTheory`:

* `discr_intAddMulOrder_two_four`, `index_range_unitsMap_intAddMulOrder_two_four`,
  `card_units_quotient_span_two_four`, `card_pic_intAddMulOrder_two_four`: invariants and
  unit-index cancellation `2 / (1 · 2) = 1` for `ℤ + 2ℤ[i]` in `ℚ(i)`.
* `subsingleton_gal_ringClassField_intAddMulOrder_two_four`,
  `ringClassField_intAddMulOrder_two_four`,
  `ringClassField_intAddMulOrder_ne_bot_of_two_lt_of_four`: `Gal(H_O / ℚ(i))` is trivial and
  `H_O = ⊥` at `f = 2`, whereas `H_O ≠ ⊥` for every `f > 2`.
* `isPrincipal_of_invertibleProperFractionalIdeals_intAddMulOrder_two_four` and
  `exists_mem_intAddMulOrder_two_span_eq_of_four`: principality and ideal-generator consequences
  for `ℤ + 2ℤ[i]`.

## References

* D. A. Cox, *Primes of the Form x² + ny²*, §7 (Theorem 7.24) and §9 (Theorem 9.18).
* G. S. Kopp and J. C. Lagarias, *Ray class groups and ray class fields for orders of number
  fields*, Ess. Number Th. 4 (2025), arXiv:2212.09177v3, Theorem 1.1.
-/

public noncomputable section

open NumberField TauCeti.GlobalNumberFields TauCeti.GlobalNumberFields.NumberFieldOrder
  TauCeti.NumberField

namespace TauCeti.ClassFieldTheory

section GaussianOrderTwoOrder

variable (K : Type*) [Field K] [NumberField K] [IsCyclotomicExtension {4} ℚ K]

/-- **The order `ℤ + 2ℤ[i]` in `ℚ(i)` has discriminant `-16`.** -/
@[simp]
theorem discr_intAddMulOrder_two_four : (intAddMulOrder K 2).discr = -16 := by
  rw [discr_intAddMulOrder_of_finrank_eq_two
      (finrank_eq_two_of_isCyclotomicExtension_four (K := K)),
    TauCeti.discr_four K]
  norm_num

/-- The conductor of `ℤ + 2ℤ[i]` in `ℚ(i)` is `2 𝓞 K`. -/
theorem conductor_intAddMulOrder_two_four :
    (intAddMulOrder K 2).conductor = Ideal.span {(2 : 𝓞 K)} :=
  conductor_intAddMulOrder (finrank_eq_two_of_isCyclotomicExtension_four (K := K)) 2

/-- **The unit index `[(𝓞 K)ˣ : (ℤ + 2ℤ[i])ˣ]` in `ℚ(i)` is `2`.** -/
@[simp]
theorem index_range_unitsMap_intAddMulOrder_two_four :
    (Units.map ((intAddMulOrder K 2).toRingOfIntegers.val :
      (intAddMulOrder K 2).toRingOfIntegers →* 𝓞 K)).range.index = 2 := by
  have := IsCyclotomicExtension.Rat.isTotallyComplex (n := 4) K (by decide)
  rw [index_range_unitsMap_intAddMulOrder (finrank_eq_two_of_isCyclotomicExtension_four (K := K)),
    TauCeti.discr_four K]
  decide

/-- **The residue ring `𝓞 K ⧸ 2 𝓞 K` of `ℚ(i)` has `2` units.** -/
@[simp]
theorem card_units_quotient_span_two_four :
    Nat.card (𝓞 K ⧸ Ideal.span {(2 : 𝓞 K)})ˣ = 2 := by
  have hK := finrank_eq_two_of_isCyclotomicExtension_four (K := K)
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h := TauCeti.NumberField.card_units_quotient_span_natCast_of_prime hK 2
  have hχ : ∀ (D : ℤ) (hD : D.IsFundamentalDiscr), D = -4 →
      Multiquadratic.fundamentalDiscriminantChar D hD (2 : ℕ) = 0 := by
    rintro _ hD rfl
    rw [← Int.cast_natCast (R := ZMod _), Multiquadratic.fundamentalDiscriminantChar_neg_four]
    decide
  rw [hχ _ _ (TauCeti.discr_four K)] at h
  norm_num at h
  exact_mod_cast h

/-- The residue ring `(ℤ + 2ℤ[i]) ⧸ 2ℤ[i] ≃ ℤ/2ℤ` has `φ(2) = 1` unit. -/
@[simp]
theorem card_units_quotient_conductor_intAddMulOrder_two_four :
    Nat.card ((intAddMulOrder K 2).toRingOfIntegers ⧸ (intAddMulOrder K 2).conductor.comap
      ((intAddMulOrder K 2).toRingOfIntegers.val :
        (intAddMulOrder K 2).toRingOfIntegers →+* 𝓞 K))ˣ = 1 :=
  card_units_quotient_conductor_intAddMulOrder
    (finrank_eq_two_of_isCyclotomicExtension_four (K := K)) 2

/-- **`Pic (ℤ + 2ℤ[i])` has order `1`.** -/
@[simp]
theorem card_pic_intAddMulOrder_two_four :
    Nat.card (Pic (intAddMulOrder K 2)) = 1 := by
  have := IsCyclotomicExtension.Rat.isTotallyComplex (n := 4) K (by decide)
  have := isPrincipalIdealRing_ringOfIntegers_four K
  exact Nat.card_eq_one_iff_unique.2 ⟨(subsingleton_pic_intAddMulOrder_iff
      (finrank_eq_two_of_isCyclotomicExtension_four (K := K)) 2).2
    ⟨inferInstance, Or.inr (Or.inr (Or.inr ⟨TauCeti.discr_four K, rfl⟩))⟩, inferInstance⟩

/-- `Pic (ℤ + 2ℤ[i])` is a subsingleton. -/
theorem subsingleton_pic_intAddMulOrder_two_four :
    Subsingleton (Pic (intAddMulOrder K 2)) :=
  (Nat.card_eq_one_iff_unique.1 (card_pic_intAddMulOrder_two_four K)).1

/-- **Every invertible proper fractional ideal of `ℤ + 2ℤ[i]` in `ℚ(i)` is principal.** -/
theorem isPrincipal_of_invertibleProperFractionalIdeals_intAddMulOrder_two_four
    (I : (intAddMulOrder K 2).invertibleProperFractionalIdeals) :
    (I : Submodule (intAddMulOrder K 2).toSubalgebra K).IsPrincipal := by
  have := subsingleton_pic_intAddMulOrder_two_four K
  exact ClassGroup.mk_eq_one_iff.mp (Subsingleton.elim ((intAddMulOrder K 2).mkPic I) 1)

/-- **Every integral ideal of `ℤ[i]` prime to `2 ℤ[i]` has a generator in `ℤ + 2ℤ[i]`.** -/
theorem exists_mem_intAddMulOrder_two_span_eq_of_four
    (J : integralIdealsPrimeTo (intAddMulOrder K 2).conductorModulus) :
    ∃ β ∈ (intAddMulOrder K 2).toRingOfIntegers, (J : Ideal (𝓞 K)) = Ideal.span {β} := by
  have := subsingleton_pic_intAddMulOrder_two_four K
  exact (intAddMulOrder K 2).exists_mem_toRingOfIntegers_span_eq_of_subsingleton_pic J

end GaussianOrderTwoOrder

section GaussianOrderTwoField

variable (K : Type) [Field K] [NumberField K] [IsCyclotomicExtension {4} ℚ K]

/-- **The Galois group `Gal(ringClassField (ℤ + 2ℤ[i]) / ℚ(i))` is trivial.** -/
theorem subsingleton_gal_ringClassField_intAddMulOrder_two_four :
    Subsingleton Gal(ringClassField (intAddMulOrder K 2)/K) :=
  have := subsingleton_pic_intAddMulOrder_two_four K
  subsingleton_gal_ringClassField (intAddMulOrder K 2)

/-- **The ring class field of the nonmaximal order `ℤ + 2ℤ[i]` in `ℚ(i)` is `⊥` (`ℚ(i)`).** -/
@[simp]
theorem ringClassField_intAddMulOrder_two_four :
    ringClassField (intAddMulOrder K 2) = ⊥ :=
  have := subsingleton_pic_intAddMulOrder_two_four K
  ringClassField_eq_bot (intAddMulOrder K 2)

/-- **The ring class field of `ℤ + 2ℤ[i]` has degree `1` over `ℚ(i)`.** -/
@[simp]
theorem finrank_ringClassField_intAddMulOrder_two_four :
    Module.finrank K (ringClassField (intAddMulOrder K 2)) = 1 := by
  rw [finrank_ringClassField, card_pic_intAddMulOrder_two_four]

/-- **The Hilbert class field of `ℚ(i)` is `⊥`.** -/
@[simp]
theorem hilbertClassField_four : hilbertClassField K = ⊥ :=
  have := isPrincipalIdealRing_ringOfIntegers_four K
  hilbertClassField_eq_bot K

/-- **Contrast for larger conductors in `ℚ(i)`**: for every `f > 2`, the ring class field of
`ℤ + f ℤ[i]` is a proper extension of `ℚ(i)` (`ringClassField (intAddMulOrder K f) ≠ ⊥`). -/
theorem ringClassField_intAddMulOrder_ne_bot_of_two_lt_of_four {f : ℕ} [NeZero f] (hf : 2 < f) :
    ringClassField (intAddMulOrder K f) ≠ ⊥ := by
  have := IsCyclotomicExtension.Rat.isTotallyComplex (n := 4) K (by decide)
  rw [Ne, ringClassField_intAddMulOrder_eq_bot_iff
    (finrank_eq_two_of_isCyclotomicExtension_four (K := K)) f, TauCeti.discr_four K]
  rintro ⟨_, h⟩
  omega

end GaussianOrderTwoField

end TauCeti.ClassFieldTheory
