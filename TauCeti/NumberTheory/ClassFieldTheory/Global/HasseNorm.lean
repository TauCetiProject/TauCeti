module

public import TauCeti.FieldTheory.GaloisCohomology.Cyclic
public import TauCeti.NumberTheory.ClassFieldTheory.Global.Brauer.LocalizationKernel
public import TauCeti.NumberTheory.ClassFieldTheory.Global.IdeleClass.RepNorm

/-!
# Local norms, global norms and idele-class `H¹` in a cyclic extension

Let `L/K` be a cyclic extension of number fields with Galois group `G` generated by `g`. An
element `a ∈ Kˣ` is a *global norm* if it lies in `N_{L/K}(Lˣ)`, and a *local norm everywhere* if
its principal idele lies in `N_{L/K}(I_L)`. By
`TauCeti.GlobalNumberFields.mem_range_ideleNormMap_iff`, the latter says that `a` is a norm from the
local étale algebra `K_v ⊗_K L` at every place `v`. This file relates the two notions through
idele-class `H¹`.

By two-periodicity of the cohomology of `G`, the class `cyclicClass hg a ∈ H²(G, Lˣ)` of `a`
vanishes exactly when `a` is a global norm (`TauCeti.cyclicClass_eq_zero_iff`). The same
periodicity for the ideles, together with the formula `N_{L/K}(x) = ∏_σ σ x` for the idele norm
(`idelesRep_norm_apply`), shows that the image of this class in `H²(G, I_L)` vanishes exactly
when `a` is a local norm everywhere (`map_unitsToIdeles_cyclicClass_eq_zero_iff`). The long
exact sequence of `0 → Lˣ → I_L → C_L → 0` identifies the kernel of `H²(G, Lˣ) → H²(G, I_L)`
with the image of the injective connecting map `H¹(G, C_L) → H²(G, Lˣ)`. Hence `a` is a local
norm everywhere exactly when its class comes from `H¹(G, C_L)`
(`unitEmbedding_mem_range_ideleNormMap_iff_cyclicClass_mem_range`). Since every class of
`H²(G, Lˣ)` is the class of some `a` (`TauCeti.cyclicClass_surjective`), the local norms everywhere
modulo the global norms thus correspond to `H¹(G, C_L)`.

In particular `H¹(G, C_L)` vanishes exactly when every local norm everywhere is a global norm
(`subsingleton_groupCohomology_one_ideleClassRep_iff_forall_mem_normGroup_of_mem_range`).
Under the hypothesis `H¹(G, C_L) = 0`, `a` is therefore a global norm exactly when it is a local
norm everywhere (`mem_normGroup_iff_unitEmbedding_mem_range_ideleNormMap`). This file reduces the
global half of the cyclic Hasse norm theorem to that hypothesis; it does not prove the vanishing
of `H¹(G, C_L)` itself.

## Main results

* `map_unitsToIdeles_cyclicClass_eq_zero_iff`: the class of `a` dies in
  `H²(G, I_L)` exactly when `a` is a local norm everywhere.
* `unitEmbedding_mem_range_ideleNormMap_iff_cyclicClass_mem_range`: `a`
  is a local norm everywhere exactly when its class comes from `H¹(G, C_L)`.
* `subsingleton_groupCohomology_one_ideleClassRep_iff_forall_mem_normGroup_of_mem_range`:
  `H¹(G, C_L) = 0` exactly when every local norm everywhere is a global norm.
* `mem_normGroup_iff_unitEmbedding_mem_range_ideleNormMap`: if
  `H¹(G, C_L) = 0`, then `a` is a global norm exactly when it is a local norm everywhere.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter VI, §4.
* J. S. Milne, *Class Field Theory*, v4.03, Chapter VII, §2.
-/

public section

noncomputable section

open CategoryTheory groupCohomology NumberField
open scoped AdeleGaloisAction

namespace TauCeti.ClassFieldTheory

open GlobalNumberFields

variable {K : Type} [Field K] [NumberField K] {L : Type} [Field L] [NumberField L] [Algebra K L]
  [IsGalois K L]

variable {g : L ≃ₐ[K] L} (hg : ∀ σ, σ ∈ Subgroup.zpowers g)

/-- **The class of `a` dies in `H²(G, I_L)` exactly when `a` is a local norm everywhere.** For
`L/K` cyclic with generator `g`, the map `H²(Gal(L/K), Lˣ) → H²(Gal(L/K), I_L)` induced by the
principal ideles sends the class of `a ∈ Kˣ` to zero exactly when the principal idele of `a` is an
idele norm from `L`. -/
@[simp]
theorem map_unitsToIdeles_cyclicClass_eq_zero_iff (a : Kˣ) :
    groupCohomology.map (MonoidHom.id _) (unitsToIdeles K L) 2 (cyclicClass hg (Additive.ofMul a))
        = 0 ↔
      IdeleGroup.unitEmbedding (𝓞 K) K a ∈ (ideleNormMap K L).toMonoidHom.range := by
  have : IsCyclic (L ≃ₐ[K] L) := ⟨g, fun σ ↦ Subgroup.mem_zpowers_iff.1 (hg σ)⟩
  let _ : CommGroup (L ≃ₐ[K] L) := IsCyclic.commGroup
  -- The principal idele of `a`, written in `I_L`, is fixed by `g`.
  have hfix : Rep.toAdditive.symm (Additive.ofMul
      (ideleExtension K L (IdeleGroup.unitEmbedding (𝓞 K) K a))) ∈
        LinearMap.ker (Rep.applyAsHom (idelesRep K L) g - 𝟙 _).hom.toLinearMap := by
    rw [LinearMap.mem_ker]
    simp only [Rep.sub_hom, Representation.IntertwiningMap.sub_toLinearMap, LinearMap.sub_apply,
      sub_eq_zero]
    apply Rep.toAdditive.injective
    apply Additive.toMul.injective
    exact (idele_smul_def g _).trans (Units.ext ((mem_range_ideleExtension_iff K L).1 ⟨_, rfl⟩ g))
  -- By naturality of two-periodicity, the image of the class of `a` in `H²(G, I_L)` is the
  -- periodicity class of its principal idele.
  have key : groupCohomology.map (MonoidHom.id _) (unitsToIdeles K L) 2
      (cyclicClass hg (Additive.ofMul a)) =
        Rep.FiniteCyclicGroup.groupCohomologyπEven (idelesRep K L) g hg 2 even_two ⟨_, hfix⟩ := by
    rw [cyclicClass_apply]
    have h2 := Rep.FiniteCyclicGroup.map_groupCohomologyπEven_two (idelesRep K L) g hg
      (B := Rep.ofMulDistribMulAction (L ≃ₐ[K] L) Lˣ)
      (MonoidHom.id _) hg 1 (pow_one g).symm (unitsToIdeles K L) 1 rfl
    refine h2 _ _ (Eq.trans ?_ (one_smul ℤ _).symm)
    exact (congrArg (fun x ↦ Rep.toAdditive.symm (Additive.ofMul x))
      (ideleExtension_unitEmbedding K L a)).trans (unitsToIdeles_hom_apply L _).symm
  rw [key, Rep.FiniteCyclicGroup.groupCohomologyπEven_eq_zero_iff]
  exact ideleExtension_mem_range_idelesRep_norm_iff _

/-- **Local norms are the classes coming from idele-class `H¹`.** For `L/K` cyclic with generator
`g`, the principal idele of `a ∈ Kˣ` is an idele norm from `L` exactly when the class of `a` in
`H²(Gal(L/K), Lˣ)` is the image of a class of `H¹(Gal(L/K), C_L)` under the connecting map of
`0 → Lˣ → I_L → C_L → 0`. -/
theorem unitEmbedding_mem_range_ideleNormMap_iff_cyclicClass_mem_range (a : Kˣ) :
    IdeleGroup.unitEmbedding (𝓞 K) K a ∈ (ideleNormMap K L).toMonoidHom.range ↔
      cyclicClass hg (Additive.ofMul a) ∈ (ideleClassToUnitsH2 K L).range :=
  (map_unitsToIdeles_cyclicClass_eq_zero_iff hg a).symm.trans
    (mem_range_ideleClassToUnitsH2_iff _).symm

/-- **Idele-class `H¹` vanishes exactly when local norms are global norms.** For `L/K` cyclic,
`H¹(Gal(L/K), C_L) = 0` exactly when every `a ∈ Kˣ` whose principal idele is an idele norm from
`L` lies in `N_{L/K}(Lˣ)`. -/
theorem subsingleton_groupCohomology_one_ideleClassRep_iff_forall_mem_normGroup_of_mem_range
    [IsCyclic (L ≃ₐ[K] L)] :
    Subsingleton (groupCohomology (ideleClassRep K L) 1) ↔
      ∀ a : Kˣ, IdeleGroup.unitEmbedding (𝓞 K) K a ∈ (ideleNormMap K L).toMonoidHom.range →
        a ∈ normGroup K L := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := L ≃ₐ[K] L)
  have hg' (σ : L ≃ₐ[K] L) : σ ∈ Subgroup.zpowers g := Subgroup.mem_zpowers_iff.2 (hg σ)
  simp_rw [unitEmbedding_mem_range_ideleNormMap_iff_cyclicClass_mem_range hg', ←
    cyclicClass_eq_zero_iff hg']
  refine ⟨fun _ a ⟨c, hc⟩ ↦ ?_, fun h ↦ ⟨fun c d ↦ ideleClassToUnitsH2_injective ?_⟩⟩
  · rw [← hc, Subsingleton.elim c 0, map_zero]
  · -- Every class of `H²(Gal(L/K), Lˣ)` is the class of some `a ∈ Kˣ`.
    obtain ⟨a, ha⟩ := cyclicClass_surjective hg' (ideleClassToUnitsH2 K L c)
    obtain ⟨b, hb⟩ := cyclicClass_surjective hg' (ideleClassToUnitsH2 K L d)
    have ha0 : cyclicClass hg' a = 0 := h a.toMul ⟨c, ha.symm⟩
    have hb0 : cyclicClass hg' b = 0 := h b.toMul ⟨d, hb.symm⟩
    rw [← ha, ← hb, ha0, hb0]

/-- **The cyclic Hasse norm theorem, from the vanishing of idele-class `H¹`.** For `L/K` cyclic
with `H¹(Gal(L/K), C_L) = 0`, an element `a ∈ Kˣ` lies in `N_{L/K}(Lˣ)` exactly when its principal
idele is an idele norm from `L`. -/
theorem mem_normGroup_iff_unitEmbedding_mem_range_ideleNormMap [IsCyclic (L ≃ₐ[K] L)]
    (h : Subsingleton (groupCohomology (ideleClassRep K L) 1)) (a : Kˣ) :
    a ∈ normGroup K L ↔
      IdeleGroup.unitEmbedding (𝓞 K) K a ∈ (ideleNormMap K L).toMonoidHom.range := by
  refine ⟨fun ha ↦ ?_,
    subsingleton_groupCohomology_one_ideleClassRep_iff_forall_mem_normGroup_of_mem_range.1 h a⟩
  -- A global norm `N(y)` is the idele norm of the principal idele of `y`.
  obtain ⟨y, hy⟩ := mem_normGroup_iff.1 ha
  refine ⟨IdeleGroup.unitEmbedding (𝓞 L) L y, (ideleNormMap_unitEmbedding K L y).trans ?_⟩
  exact congrArg _ (Units.ext ((Algebra.coe_normUnits K y).trans hy))

end TauCeti.ClassFieldTheory
