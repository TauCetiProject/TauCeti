module

public import TauCeti.NumberTheory.ClassFieldTheory.Formation.DescendedInvariant
public import TauCeti.NumberTheory.ClassFieldTheory.Global.IdeleClass.SecondInequality
public import TauCeti.NumberTheory.ClassFieldTheory.Global.LiftIndependence
import TauCeti.NumberTheory.ClassFieldTheory.Formation.InvariantKernel
import TauCeti.NumberTheory.ClassFieldTheory.Formation.PrimeDegree
import TauCeti.NumberTheory.ClassFieldTheory.Global.Brauer.LocalizationKernel
import TauCeti.NumberTheory.ClassFieldTheory.Global.Brauer.SumFormula
import TauCeti.NumberTheory.ClassFieldTheory.Global.PrescribedInvariant

/-!
# The global invariant and the idele-class formation, from two arithmetic inputs

Let `K` be a number field. Tate's construction of the invariant map of the idele classes defines,
on a finite normal layer `L/F` inside `Kˢ`, the invariant of a class of `H²(Gal(L/F), C_L)` as the
sum of the local invariants `ideleSumLocalInv` of a lift of its inflation to the ideles of some
refinement of the layer. This file carries out that construction for the idele-class formation
`globalFormation K`, and shows that it is a class formation with this invariant, assuming two
arithmetic inputs:

* **the Kummer case of the second inequality** (`hK`): for every cyclic extension `L/F` of number
  fields of prime degree `p` with `F ∋ μ_p`, the idele-class norm group `N_{L/F}(C_L)` has index at
  most `p` in `C_F`;
* **generators on layers of prime degree** (`hgen`): every layer of `globalFormation K` of prime
  degree `p` carries a class of `H²(Gal(L/F), I_L)` whose local invariants sum to `1/p`.

From `hK` the fundamental inequalities give `H¹ = 0` and `#H² ∣ [L : F]` on every layer
(`subsingleton_h1_globalFormation_of_forall_index_le`,
`natCard_H2_globalFormation_dvd_degree_of_forall_index_le`), hence the Hasse principle over every
finite extension of `K`, hence the sum formula: the local invariants of a global Brauer class sum
to zero (`sumLocalInv_brLocalization_eq_zero_of_forall_index_le`). Since the kernel of
`H²(Gal(L/F), I_L) → H²(Gal(L/F), C_L)` is the image of `H²(Gal(L/F), Lˣ)`, the sum of the local
invariants vanishes on that kernel (`ideleSumLocalInv_eq_zero_of_ideleToClassH2_eq_zero`), and two
lifts of one class to two refinements have the same sum of local invariants
(`ideleSumLocalInv_eq_of_ideleToClassH2_eq`).

With `hgen`, a class of `H²(Gal(L/F), I_L)` whose local invariants sum to zero dies in the idele
classes, first on layers of prime degree, where `H²(Gal(L/F), C_L)` is cyclic of order `p`
generated by the image of the given class, and then on every layer by the Sylow and tower
reduction `NormalLayer.map_eq_zero_of_prime_degree`
(`ideleToClassH2_eq_zero_iff`). The cyclotomic class of invariant `1/[L : F]` on a refinement
(`exists_refinement_ideleSumLocalInv_eq`) then makes every class of `H²(Gal(L/F), C_L)` lift to the
ideles after inflation to that refinement (`exists_refinement_mem_range_ideleToClassH2`), and the
invariant descends (`globalInv`), with image the `[L : F]`-torsion of `ℚ/ℤ`.

## Main definitions

* `TauCeti.ClassFieldTheory.globalInv`: the invariant of a layer of the idele-class formation, the
  sum of the local invariants of a lift of an inflation.
* `TauCeti.ClassFieldTheory.globalClassFormation`: the idele-class formation as a class formation
  with invariant `globalInv`.

## Main statements

* `TauCeti.ClassFieldTheory.ideleToClassH2_eq_zero_iff`: a class of `H²(Gal(L/F), I_L)` dies in the
  idele classes exactly when its local invariants sum to zero.
* `TauCeti.ClassFieldTheory.exists_refinement_mem_range_ideleToClassH2`: after inflation to a
  refinement, every class of `H²(Gal(L/F), C_L)` lifts to the ideles.
* `TauCeti.ClassFieldTheory.globalInv_ideleToClassH2`, `TauCeti.ClassFieldTheory.globalInv_infl`
  and `TauCeti.ClassFieldTheory.globalInv_unique`: the two equations that pin `globalInv`.
* `TauCeti.ClassFieldTheory.globalInv_injective`, `TauCeti.ClassFieldTheory.range_globalInv`: the
  invariant of a layer of degree `n` is injective with image the `n`-torsion of `ℚ/ℤ`.

## References

* J. S. Milne, *Class Field Theory*, v4.03, Chapter VII, §§5–8, and Chapter VIII, §4
  (Theorem 4.7).
* J. Tate, *Global class field theory*, in J. W. S. Cassels and A. Fröhlich (eds.),
  *Algebraic Number Theory*, Chapter VII, §11.
-/

public noncomputable section

namespace TauCeti.ClassFieldTheory

variable {K : Type} [Field K] [NumberField K]
  (hK : ∀ (F L : Type) [Field F] [NumberField F] [Field L] [NumberField L] [Algebra F L]
    [IsGalois F L] (p : ℕ) [Fact p.Prime] [HasEnoughRootsOfUnity F p],
    Module.finrank F L = p → (GlobalNumberFields.ideleClassNormMap F L).range.index ≤ p)

/-! ### Consequences of the Kummer case -/

include hK in
/-- **The sum formula, from the Kummer case.** If the Kummer case of the second inequality holds,
the local invariants of every Brauer class of `K` sum to zero. -/
theorem sumLocalInv_brLocalization_eq_zero_of_forall_index_le (x : Br K) :
    sumLocalInv K (brLocalization K x) = 0 :=
  sumLocalInv_brLocalization_eq_zero_of_brLocalization_injective K
    (fun E _ _ _ ↦ brLocalization_injective_of_subsingleton_h1_globalFormation E fun _ ↦
      subsingleton_h1_globalFormation_of_forall_index_le hK _) x

include hK in
/-- **The sum of the local invariants vanishes on the classes that die in the idele classes**, if
the Kummer case of the second inequality holds: such a class comes from `H²(Gal(L/F), Lˣ)`, and
its local invariants are those of a global Brauer class. -/
theorem ideleSumLocalInv_eq_zero_of_ideleToClassH2_eq_zero
    {L : NormalLayer (AbsoluteGaloisGroup K)} {y : L.H (ideleFormation K) 2}
    (hy : ideleToClassH2 K L y = 0) : ideleSumLocalInv K L y = 0 := by
  obtain ⟨w, rfl⟩ : y ∈ (multiplicativeToIdeleH2 K L).range := ker_ideleToClassH2 K L ▸ hy
  rw [ideleSumLocalInv_multiplicativeToIdeleH2]
  exact sumLocalInv_brLocalization_eq_zero_of_forall_index_le hK _

include hK in
/-- **Independence of the lift and of the refinement**, if the Kummer case of the second inequality
holds: two lifts to the ideles of the inflations of one class of `H²(Gal(L/F), C_L)`, to two
refinements of the layer, have the same sum of local invariants. -/
theorem ideleSumLocalInv_eq_of_ideleToClassH2_eq
    {Lay Lay₁ Lay₂ : NormalLayer (AbsoluteGaloisGroup K)}
    (T₁ : LayerRefinement Lay Lay₁) (T₂ : LayerRefinement Lay Lay₂)
    (x : Lay.H (globalFormation K) 2)
    (y₁ : Lay₁.H (ideleFormation K) 2) (y₂ : Lay₂.H (ideleFormation K) 2)
    (h₁ : ideleToClassH2 K Lay₁ y₁ = T₁.cohomologyInfl (globalFormation K) 2 x)
    (h₂ : ideleToClassH2 K Lay₂ y₂ = T₂.cohomologyInfl (globalFormation K) 2 x) :
    ideleSumLocalInv K Lay₁ y₁ = ideleSumLocalInv K Lay₂ y₂ := by
  obtain ⟨b, hb⟩ := exists_ideleSumLocalInv_eq_add_sumLocalInv_of_ideleToClassH2_eq K T₁ T₂ x y₁ y₂
    h₁ h₂
  rw [hb, sumLocalInv_brLocalization_eq_zero_of_forall_index_le hK, add_zero]

/-! ### The kernel of the passage to idele classes -/

variable (hgen : ∀ L : NormalLayer (AbsoluteGaloisGroup K), L.degree.Prime →
    ∃ z : L.H (ideleFormation K) 2,
      ideleSumLocalInv K L z = ((1 / L.degree : ℚ) : AddCircle (1 : ℚ)))

include hK hgen in
/-- **A class of the idele layer dies in the idele classes exactly when its local invariants sum to
zero**, if the Kummer case of the second inequality holds and every layer of prime degree `p`
carries a class whose local invariants sum to `1/p`. -/
theorem ideleToClassH2_eq_zero_iff {L : NormalLayer (AbsoluteGaloisGroup K)}
    {y : L.H (ideleFormation K) 2} :
    ideleToClassH2 K L y = 0 ↔ ideleSumLocalInv K L y = 0 := by
  refine ⟨ideleSumLocalInv_eq_zero_of_ideleToClassH2_eq_zero hK, fun hy ↦ ?_⟩
  have hker (L : NormalLayer (AbsoluteGaloisGroup K)) (y : L.H (ideleFormation K) 2)
      (hy : groupCohomology.map (MonoidHom.id L.Gal) (L.repMap (ideleClassHom K)) 2 y = 0) :
      ideleSumLocalInv K L y = 0 :=
    ideleSumLocalInv_eq_zero_of_ideleToClassH2_eq_zero hK ((ideleToClassH2_apply K L y).trans hy)
  -- On a layer of prime degree the image of the given class generates `H²(Gal(L/F), C_L)`; the
  -- Sylow and tower reduction carries the statement to every layer.
  rw [ideleToClassH2_apply]
  refine NormalLayer.map_eq_zero_of_prime_degree (ideleClassHom K) (fun L ↦ ideleSumLocalInv K L)
    (fun T y ↦ ideleSumLocalInv_infl K T y) (fun R y ↦ ideleSumLocalInv_res K R y) hker
    (subsingleton_h1_globalFormation_of_forall_index_le hK) (fun L hp x ↦ ?_)
    (fun L hp y hy ↦ NormalLayer.map_eq_zero_of_natCard_H2_dvd_degree (ideleClassHom K) _ hker
      (natCard_H2_globalFormation_dvd_degree_of_forall_index_le hK L) (hgen L hp) hy) L hy
  have := NormalLayer.isCyclic_gal_of_prime_degree hp
  exact (surjective_ideleToClassH2_of_isCyclic K L x).imp fun y hy ↦
    (ideleToClassH2_apply K L y).symm.trans hy

include hK hgen in
/-- `ideleToClassH2_eq_zero_iff`, for the cohomology map that `ideleToClassH2` applies. -/
private theorem map_ideleClassHom_eq_zero_iff {L : NormalLayer (AbsoluteGaloisGroup K)}
    {y : L.H (ideleFormation K) 2} :
    groupCohomology.map (MonoidHom.id L.Gal) (L.repMap (ideleClassHom K)) 2 y = 0 ↔
      ideleSumLocalInv K L y = 0 := by
  rw [← ideleToClassH2_apply]
  exact ideleToClassH2_eq_zero_iff hK hgen

include hK hgen in
/-- **Killing the obstruction**, if the Kummer case of the second inequality holds and every layer
of prime degree `p` carries a class whose local invariants sum to `1/p`: some refinement of every
layer `L/F` is such that the inflation of every class of `H²(Gal(L/F), C_L)` to it lifts to the
ideles. -/
theorem exists_refinement_mem_range_ideleToClassH2 (Lay : NormalLayer (AbsoluteGaloisGroup K)) :
    ∃ (Lay' : NormalLayer (AbsoluteGaloisGroup K)) (T : LayerRefinement Lay Lay'),
      ∀ x : Lay.H (globalFormation K) 2,
        T.cohomologyInfl (globalFormation K) 2 x ∈ (ideleToClassH2 K Lay').range := by
  obtain ⟨Lay', T, hT⟩ := NormalLayer.exists_refinement_forall_exists_map_eq_cohomologyInfl
    (ideleClassHom K) (fun L ↦ ideleSumLocalInv K L) (fun R y ↦ ideleSumLocalInv_res K R y)
    (fun _ _ ↦ (map_ideleClassHom_eq_zero_iff hK hgen).1)
    (fun _ _ ↦ (map_ideleClassHom_eq_zero_iff hK hgen).2)
    (subsingleton_h1_globalFormation_of_forall_index_le hK)
    (natCard_H2_globalFormation_dvd_degree_of_forall_index_le hK Lay)
    (exists_refinement_ideleSumLocalInv_eq Lay)
  exact ⟨Lay', T, fun x ↦ (hT x).imp fun y hy ↦ (ideleToClassH2_apply K Lay' y).trans hy⟩

/-! ### The global invariant -/

include hK hgen in
/-- `exists_refinement_mem_range_ideleToClassH2`, in the form of the lifting hypothesis of
`descendedInv`. -/
private theorem exists_refinement_map_eq_cohomologyInfl (L : NormalLayer (AbsoluteGaloisGroup K))
    (x : L.H (globalFormation K) 2) :
    ∃ (L' : NormalLayer (AbsoluteGaloisGroup K)) (T : LayerRefinement L L')
      (y : L'.H (ideleFormation K) 2),
      groupCohomology.map (MonoidHom.id L'.Gal) (L'.repMap (ideleClassHom K)) 2 y =
        T.cohomologyInfl (globalFormation K) 2 x :=
  (exists_refinement_mem_range_ideleToClassH2 hK hgen L).imp fun L' ⟨T, hT⟩ ↦
    ⟨T, (hT x).imp fun y hy ↦ (ideleToClassH2_apply K L' y).symm.trans hy⟩

/-- **The invariant of a layer of the idele-class formation**, if the Kummer case of the second
inequality holds and every layer of prime degree `p` carries a class whose local invariants sum to
`1/p`: the invariant of a class of `H²(Gal(L/F), C_L)` is the sum of the local invariants of a
lift to the ideles of its inflation to a refinement of the layer. By `globalInv_eq` it does not
depend on the refinement or on the lift. -/
def globalInv (L : NormalLayer (AbsoluteGaloisGroup K)) :
    L.H (globalFormation K) 2 →+ AddCircle (1 : ℚ) :=
  descendedInv (ideleClassHom K) (fun L ↦ ideleSumLocalInv K L)
    (fun T y ↦ ideleSumLocalInv_infl K T y) (exists_refinement_map_eq_cohomologyInfl hK hgen)
    (fun _ _ ↦ (map_ideleClassHom_eq_zero_iff hK hgen).1) L

/-- **The invariant of a class is the sum of the local invariants of any lift of any inflation of
it**: if the inflation of `x` to a refinement `L'` of `L` is the image of `y ∈ H²(Gal(L'/F), I_L')`,
then `globalInv x` is the sum of the local invariants of `y`. -/
theorem globalInv_eq {L L' : NormalLayer (AbsoluteGaloisGroup K)} (T : LayerRefinement L L')
    {x : L.H (globalFormation K) 2} {y : L'.H (ideleFormation K) 2}
    (h : ideleToClassH2 K L' y = T.cohomologyInfl (globalFormation K) 2 x) :
    globalInv hK hgen L x = ideleSumLocalInv K L' y :=
  descendedInv_eq _ _ _ _ _ T ((ideleToClassH2_apply K L' y).symm.trans h)

/-- **The sum formula, the first defining equation of the global invariant**: on a class that lifts
to the ideles, the invariant is the sum of the local invariants of the lift. -/
@[simp]
theorem globalInv_ideleToClassH2 (L : NormalLayer (AbsoluteGaloisGroup K))
    (y : L.H (ideleFormation K) 2) :
    globalInv hK hgen L (ideleToClassH2 K L y) = ideleSumLocalInv K L y :=
  (congrArg _ (ideleToClassH2_apply K L y)).trans (descendedInv_map _ _ _ _ _ y)

/-- **Inflation invariance, the second defining equation of the global invariant.** -/
@[simp]
theorem globalInv_infl {L L' : NormalLayer (AbsoluteGaloisGroup K)} (T : LayerRefinement L L')
    (x : L.H (globalFormation K) 2) :
    globalInv hK hgen L' (T.cohomologyInfl (globalFormation K) 2 x) = globalInv hK hgen L x :=
  descendedInv_infl _ _ _ _ _ T x

/-- **The global invariant is determined by its two defining equations**: a family of
homomorphisms `H²(Gal(L/F), C_L) → ℚ/ℤ` that is the sum of the local invariants on the classes
lifting to the ideles and does not change under inflation is `globalInv`. -/
theorem globalInv_unique (f : ∀ L : NormalLayer (AbsoluteGaloisGroup K),
      L.H (globalFormation K) 2 →+ AddCircle (1 : ℚ))
    (hdesc : ∀ (L : NormalLayer (AbsoluteGaloisGroup K)) (y : L.H (ideleFormation K) 2),
      f L (ideleToClassH2 K L y) = ideleSumLocalInv K L y)
    (hinfl : ∀ {L L' : NormalLayer (AbsoluteGaloisGroup K)} (T : LayerRefinement L L')
      (x : L.H (globalFormation K) 2), f L' (T.cohomologyInfl (globalFormation K) 2 x) = f L x) :
    f = globalInv hK hgen :=
  descendedInv_unique _ _ _ _ _ f
    (fun L y ↦ (congrArg _ (ideleToClassH2_apply K L y).symm).trans (hdesc L y)) hinfl

/-- **Restriction multiplies the global invariant by the relative degree.** -/
@[simp]
theorem globalInv_res {small big : NormalLayer (AbsoluteGaloisGroup K)}
    (R : LayerRestriction small big) (x : big.H (globalFormation K) 2) :
    globalInv hK hgen small (R.cohomologyRes (globalFormation K) 2 x) =
      R.relativeDegree • globalInv hK hgen big x :=
  descendedInv_res _ _ _ _ _ (fun R y ↦ ideleSumLocalInv_res K R y) R x

/-- **Conjugation preserves the global invariant.** -/
@[simp]
theorem globalInv_conj (L : NormalLayer (AbsoluteGaloisGroup K)) (g : AbsoluteGaloisGroup K)
    (x : L.H (globalFormation K) 2) :
    globalInv hK hgen (L.conjugate g) ((L.conjugateCohomologyIso (globalFormation K) g 2).hom x) =
      globalInv hK hgen L x :=
  descendedInv_conj _ _ _ _ _ (fun L g y ↦ ideleSumLocalInv_conj K L g y) L g x

/-- **The global invariant is injective.** -/
theorem globalInv_injective (L : NormalLayer (AbsoluteGaloisGroup K)) :
    Function.Injective (globalInv hK hgen L) :=
  descendedInv_injective _ _ _ _ _ (subsingleton_h1_globalFormation_of_forall_index_le hK)
    (fun _ _ ↦ (map_ideleClassHom_eq_zero_iff hK hgen).2) L

/-- **The image of the global invariant of a layer of degree `n` is the `n`-torsion of `ℚ/ℤ`.** -/
theorem range_globalInv (L : NormalLayer (AbsoluteGaloisGroup K)) :
    Set.range (globalInv hK hgen L) =
      (AddSubgroup.torsionBy (AddCircle (1 : ℚ)) L.degree : Set (AddCircle (1 : ℚ))) :=
  range_descendedInv _ _ _ _ _ (subsingleton_h1_globalFormation_of_forall_index_le hK)
    (fun _ _ ↦ (map_ideleClassHom_eq_zero_iff hK hgen).2) (fun R y ↦ ideleSumLocalInv_res K R y)
    exists_refinement_ideleSumLocalInv_eq L

/-! ### The global class formation -/

/-- **The idele-class formation is a class formation**, if the Kummer case of the second inequality
holds and every layer of prime degree `p` carries a class whose local invariants sum to `1/p`. Its
invariant is the global invariant `globalInv` (`globalClassFormation_inv`). -/
def globalClassFormation : ClassFormation (globalFormation K) :=
  ClassFormation.ofDescendedInv (ideleClassHom K) (fun L ↦ ideleSumLocalInv K L)
    (fun T y ↦ ideleSumLocalInv_infl K T y) (exists_refinement_map_eq_cohomologyInfl hK hgen)
    (fun _ _ ↦ (map_ideleClassHom_eq_zero_iff hK hgen).1)
    (subsingleton_h1_globalFormation_of_forall_index_le hK)
    (fun _ _ ↦ (map_ideleClassHom_eq_zero_iff hK hgen).2) (fun R y ↦ ideleSumLocalInv_res K R y)
    (fun L g y ↦ ideleSumLocalInv_conj K L g y) exists_refinement_ideleSumLocalInv_eq

/-- **The invariant of the global class formation is the global invariant**, the descended sum of
the local invariants. -/
@[simp]
theorem globalClassFormation_inv : (globalClassFormation hK hgen).inv = globalInv hK hgen :=
  ClassFormation.ofDescendedInv_inv _ _ _ _ _ _ _ _ _ _

end TauCeti.ClassFieldTheory
