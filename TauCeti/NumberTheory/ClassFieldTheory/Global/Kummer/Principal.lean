module

public import TauCeti.NumberTheory.ClassFieldTheory.Global.Kummer.Norm
import TauCeti.NumberTheory.ClassFieldTheory.Global.IdeleClass.FirstInequality
import TauCeti.NumberTheory.NumberField.Units.SUnit
import TauCeti.RingTheory.DedekindDomain.SInteger.Power

/-!
# Principal ideles in the Kummer subgroup

Let `K` contain the `n`-th roots of unity, and let `S` contain the primes above `n` and generate
the ideal class group. The principal ideles in the Kummer subgroup `E_S` are exactly the global
`n`-th powers that are `S`-units. Equivalently, their preimage in `U_S` is `U_Sⁿ`.
This identifies the principal factor removed from the local power-class index when passing from
ideles to idele classes. The auxiliary-set version `le_range_powMonoidHom_of_local_powers`
also allows radicands supported on `S ∪ T`, provided the `S`-units control the local power
classes at `T`; it supplies the corresponding principal-power conclusion in norm-index arguments.

The extension generated by the `n`-th roots of these principal elements has surjective idele-class
norm by `ideleClassNormMap_kummerField_surjective`. It is abelian, so the first fundamental
inequality forces it to be trivial. Kummer theory then makes every radicand a global power.
Neither global reciprocity nor the second fundamental inequality is used.

## References

* J. S. Milne, *Class Field Theory*, v4.03, Chapter VII, Proposition 9.2 and Proposition 6.10.
-/

public section
noncomputable section

open IsDedekindDomain NumberField
open scoped IsMulCommutative

namespace TauCeti.ClassFieldTheory

variable {K : Type} [Field K] [NumberField K]
variable {n : ℕ} [NeZero n] [HasEnoughRootsOfUnity K n]

/-- If the `S`-units control the local power classes at an auxiliary set `T`, then an
`S ∪ T`-unit which is an `n`-th power at `S` and infinity is a global `n`-th power.
The power exponent at `T` is a multiple of the degree of the Kummer field of the radicands. -/
theorem le_range_powMonoidHom_of_local_powers
    (S T : Finset (HeightOneSpectrum (𝓞 K))) (hST : Disjoint S T)
    (hcl : Subgroup.closure
      (HeightOneSpectrum.classGroupMk '' (S : Set (HeightOneSpectrum (𝓞 K)))) = ⊤)
    (hnS : ∀ v : HeightOneSpectrum (𝓞 K), (n : 𝓞 K) ∈ v.asIdeal → v ∈ S)
    {Δ : Subgroup Kˣ} (hΔ : Δ ≤ (S ∪ T : Set (HeightOneSpectrum (𝓞 K))).unit K)
    (hΔS : ∀ v ∈ S, ∀ a ∈ Δ, ∃ c : v.adicCompletion K, c ^ n = algebraMap K _ a)
    (hΔinf : ∀ w : InfinitePlace K, ∀ a ∈ Δ, ∃ c : w.Completion, c ^ n = algebraMap K _ a)
    {m : ℕ} (hm : Module.finrank K (kummerField (SeparableClosure K) n Δ) ∣ m)
    (hT : ∀ y : (v : T) → (v.1.adicCompletion K)ˣ,
      (∀ v, Valued.v (y v : v.1.adicCompletion K) = 1) →
      ∃ u ∈ (S : Set (HeightOneSpectrum (𝓞 K))).unit K, ∀ v : T,
        (Units.map (algebraMap K (v.1.adicCompletion K)).toMonoidHom u)⁻¹ * y v ∈
          (powMonoidHom m).range) :
    Δ ≤ (powMonoidHom n).range := by
  have : (powMonoidHom n : Kˣ →* Kˣ).range.IsFiniteRelIndex
      ((S ∪ T : Set (HeightOneSpectrum (𝓞 K))).unit K) :=
    ⟨by rw [relIndex_range_powMonoidHom_sUnits_numberField]; exact pow_ne_zero _ (NeZero.ne n)⟩
  have : (powMonoidHom n : Kˣ →* Kˣ).range.IsFiniteRelIndex Δ :=
    Subgroup.isFiniteRelIndex_of_le_right _ hΔ
  have hnorm := ideleClassNormMap_kummerField_surjective_of_forall_exists_mem_unit
    (E := SeparableClosure K) S T hST hcl hnS hΔ hΔS hΔinf hm hT
  have : Group.IsSolvable Gal(kummerField (SeparableClosure K) n Δ/K) :=
    Group.isSolvable_of_comm fun a b => mul_comm a b
  apply Subgroup.relIndex_eq_one.mp
  rw [← finrank_kummerField (E := SeparableClosure K)
    (fun a _ => IsSepClosed.exists_pow_nat_eq (algebraMap K _ a) n)]
  exact finrank_eq_one_of_surjective_ideleClassNormMap K _ hnorm

variable (S : Finset (HeightOneSpectrum (𝓞 K))) (n)
variable (hcl : Subgroup.closure
    (HeightOneSpectrum.classGroupMk '' (S : Set (HeightOneSpectrum (𝓞 K)))) = ⊤)
  (hnS : ∀ v : HeightOneSpectrum (𝓞 K), (n : 𝓞 K) ∈ v.asIdeal → v ∈ S)

include hcl hnS

/-- The principal ideles in `E_S` are exactly the global `n`-th powers that are `S`-units,
provided `S` contains the primes above `n` and generates the ideal class group. -/
@[simp]
theorem comap_kummerIdeleSubgroup_unitEmbedding :
    (kummerIdeleSubgroup S n).comap (IdeleGroup.unitEmbedding (𝓞 K) K) =
      (S : Set (HeightOneSpectrum (𝓞 K))).unit K ⊓ (powMonoidHom n).range := by
  let Δ := (kummerIdeleSubgroup S n).comap (IdeleGroup.unitEmbedding (𝓞 K) K)
  have hunit : Δ ≤ (S : Set (HeightOneSpectrum (𝓞 K))).unit K := by
    intro a ha
    exact (IdeleGroup.forall_valued_ideleFiniteCoord_unitEmbedding_eq_one_iff
      (R := 𝓞 K) a).mp ((mem_kummerIdeleSubgroup_iff S n _).mp ha).2.2
  have hpower : Δ ≤ (powMonoidHom n).range := by
    refine le_range_powMonoidHom_of_local_powers S ∅ (Finset.disjoint_empty_right S)
      hcl hnS (by simpa using hunit) (fun v hv a ha => ?_) (fun w a ha => ?_)
      dvd_rfl (fun _ _ => ⟨1, one_mem _, fun v => (Finset.notMem_empty _ v.2).elim⟩)
    · obtain ⟨c, hc⟩ := ((mem_kummerIdeleSubgroup_iff S n _).mp ha).1 v hv
      exact ⟨c, by simpa using congrArg Units.val hc⟩
    · obtain ⟨c, hc⟩ := ((mem_kummerIdeleSubgroup_iff S n _).mp ha).2.1 w
      exact ⟨c, by simpa using congrArg Units.val hc⟩
  apply le_antisymm
  · exact le_inf hunit hpower
  · rintro a ⟨ha, b, rfl⟩
    rw [Subgroup.mem_comap, mem_kummerIdeleSubgroup_iff]
    refine ⟨fun v _ => ⟨v.ideleFiniteCoord (IdeleGroup.unitEmbedding (𝓞 K) K b), ?_⟩,
      fun w => ⟨w.ideleInfiniteCoord (IdeleGroup.unitEmbedding (𝓞 K) K b), ?_⟩, ?_⟩
    · simp only [powMonoidHom_apply, ← map_pow]
    · simp only [powMonoidHom_apply, ← map_pow]
    · exact (IdeleGroup.forall_valued_ideleFiniteCoord_unitEmbedding_eq_one_iff
        (R := 𝓞 K) (b ^ n)).mpr ha

/-- Among `S`-units, the principal ideles in `E_S` are precisely the `n`-th powers of `S`-units.
This is the subgroup whose index gives the principal contribution to the Kummer idele index. -/
@[simp]
theorem comap_kummerIdeleSubgroup_unitEmbedding_unit :
    (kummerIdeleSubgroup S n).comap
        ((IdeleGroup.unitEmbedding (𝓞 K) K).comp
          ((S : Set (HeightOneSpectrum (𝓞 K))).unit K).subtype) =
      (powMonoidHom n).range := by
  rw [← Subgroup.comap_comap, comap_kummerIdeleSubgroup_unitEmbedding (S := S) (n := n) hcl hnS]
  simpa [Subgroup.comap_inf, Subgroup.comap_subtype] using
    Set.range_powMonoidHom_subgroupOf_unit (S : Set (HeightOneSpectrum (𝓞 K))) K n

end TauCeti.ClassFieldTheory
