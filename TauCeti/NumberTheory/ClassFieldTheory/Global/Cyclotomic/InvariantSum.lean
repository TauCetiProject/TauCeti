module

public import TauCeti.NumberTheory.ClassFieldTheory.Global.CharacterCarry
public import TauCeti.NumberTheory.ClassFieldTheory.Global.Cyclotomic.ProductFormula
import TauCeti.Algebra.AddCircle
import TauCeti.FieldTheory.Galois.AbsoluteGaloisGroup.Cyclotomic.Map

/-!
# The sum of the local invariants on classes split by a cyclotomic extension

Let `K` be a number field, `p` a prime, and `E ⊆ Kˢ` a finite Galois extension of `K` contained in
`K(μ_{p^∞})`, the field generated by the roots of unity of `p`-power order. This file proves that
the sum of the local invariants vanishes on every Brauer class of `K` split by `E`, provided
`E/K` is cyclic (`sumLocalInv_brLocalization_relBrInfl_eq_zero_of_le_adjoin`).

The input is the reciprocity law for the local Artin symbols on `E`: for `a ∈ Kˣ` and every
homomorphism `χ` out of `Gal(E/K)` into an abelian group,

```text
∑_v χ (Art_v a) = 0,
```

the sum running over the finite and the infinite places of `K`, with `Art_v a` read in `Gal(E/K)`
through a decomposition map (`finsum_add_sum_apply_restrictNormalHom_eq_zero_of_le_adjoin`). An
automorphism of `Kˢ` with trivial `p`-adic cyclotomic character fixes `K(μ_{p^∞})`, hence `E`, so
the restriction to `E` factors through the cyclotomic character on the image of `G_K`. Along a
decomposition map the cyclotomic character of `G_K` is that of `G_{K_v}`, so the reciprocity law is
the image of the product formula `∏_v χ_p(Art_v a) = 1` for the cyclotomic characters of the local
Artin symbols (`finprod_mul_prod_abelianizedLocalCyclotomicCharacter_artinMap_eq_one`).

For a cyclic `E/K`, every class split by `E` is a cyclic class `a ∪ δχ`, whose local invariants sum
to `∑_v χ (Art_v a)` (`forall_sumLocalInv_brLocalization_relBrInfl_eq_zero_iff`); the reciprocity
law makes this sum vanish.

## Main results

* `TauCeti.ClassFieldTheory.finsum_add_sum_apply_restrictNormalHom_eq_zero_of_le_adjoin`: the
  local Artin symbols of `a ∈ Kˣ` satisfy the product formula on every normal subextension of
  `K(μ_{p^∞})/K`.
* `TauCeti.ClassFieldTheory.sumLocalInv_brLocalization_relBrInfl_eq_zero_of_le_adjoin`: the sum of
  the local invariants vanishes on the Brauer classes split by a cyclic subextension of
  `K(μ_{p^∞})/K`.

## References

* J. S. Milne, *Class Field Theory*, Chapter VII, Lemma 8.4 and Lemma 8.5.
* J. Tate, *Global class field theory*, in J. W. S. Cassels and A. Fröhlich (eds.), *Algebraic
  Number Theory*, Chapter VII, §11.
-/

public section

noncomputable section

namespace TauCeti.ClassFieldTheory

open IsDedekindDomain NumberField _root_.IntermediateField

variable (p : ℕ) [Fact p.Prime] {K : Type} [Field K] [NumberField K]
  (E : IntermediateField K (SeparableClosure K))

variable [Normal K E]
  (τ : ∀ v : HeightOneSpectrum (𝓞 K),
    SeparableClosure K →ₐ[K] SeparableClosure (v.adicCompletion K))
  (τ' : ∀ w : InfinitePlace K, SeparableClosure K →ₐ[K] SeparableClosure w.Completion)
  (σ : ∀ v : HeightOneSpectrum (𝓞 K), Field.absoluteGaloisGroup (v.adicCompletion K))
  (σ' : ∀ w : InfinitePlace K, Field.absoluteGaloisGroup w.Completion)

/-- **Reciprocity for the local Artin symbols on a cyclotomic extension.** Let `E ⊆ Kˢ` be a
normal extension of a number field `K` contained in `K(μ_{p^∞})`, and `χ` a homomorphism from
`Gal(E/K)` to an abelian group. For `a ∈ Kˣ`, choose at every place `v` a representative of the
local Artin symbol of `a` and read it in `Gal(E/K)` through a decomposition map. Then
`∑_v χ (Art_v a) = 0`, the sum running over all places of `K`. -/
theorem finsum_add_sum_apply_restrictNormalHom_eq_zero_of_le_adjoin
    (hE : E ≤ adjoin K {ζ : SeparableClosure K | ∃ n : ℕ, ζ ^ p ^ n = 1})
    {M : Type*} [AddCommGroup M] (χ : Additive Gal(E/K) →+ M) (a : Kˣ)
    (hσ : ∀ v, (σ v : Field.absoluteGaloisGroupAbelianization (v.adicCompletion K)) =
      artinMap (v.adicCompletion K) (Units.map (algebraMap K (v.adicCompletion K)) a))
    (hσ' : ∀ w, (σ' w : Field.absoluteGaloisGroupAbelianization w.Completion) =
      infiniteArtinAt w (Units.map (algebraMap K w.Completion) a)) :
    ∑ᶠ v, χ (.ofMul (AlgEquiv.restrictNormalHom E (absoluteGaloisGroupMap (τ v)
        (absoluteGaloisGroupRestrictEquiv (v.adicCompletion K) (σ v))))) +
      ∑ w, χ (.ofMul (AlgEquiv.restrictNormalHom E (absoluteGaloisGroupMap (τ' w)
        (absoluteGaloisGroupRestrictEquiv w.Completion (σ' w))))) = 0 := by
  have : NeZero (p : K) := ⟨Nat.cast_ne_zero.2 (Fact.out : p.Prime).ne_zero⟩
  -- The cyclotomic character of `G_K`, written additively, and its corestriction to its image.
  let c : Additive (AbsoluteGaloisGroup K) →+ Additive ℤ_[p]ˣ :=
    ((cyclotomicCharacter (SeparableClosure K) p).comp
      (MulSemiringAction.toRingAut (AbsoluteGaloisGroup K) (SeparableClosure K))).toAdditive
  have hc (g : AbsoluteGaloisGroup K) :
      c (.ofMul g) = .ofMul (cyclotomicCharacter (SeparableClosure K) p g.toRingEquiv) := rfl
  -- On the image of `G_K`, `χ` composed with restriction to `E` factors through `c`.
  let φ : {φ : Additive (AbsoluteGaloisGroup K) →+ M // c.rangeRestrict.ker ≤ φ.ker} :=
    ⟨χ.comp (AlgEquiv.restrictNormalHom E).toAdditive, fun g hg ↦ by
      induction g using Additive.rec with | ofMul g => ?_
      simp only [AddMonoidHom.ker_rangeRestrict, AddMonoidHom.mem_ker, hc, ofMul_eq_zero] at hg
      -- An automorphism with trivial cyclotomic character fixes `K(μ_{p^∞})`, hence `E`.
      have hgE : AlgEquiv.restrictNormalHom E g = 1 := by
        rw [← MonoidHom.mem_ker, E.restrictNormalHom_ker]
        exact fixingSubgroup_le hE
          ((mem_fixingSubgroup_adjoin_iff_cyclotomicCharacter_eq_one p).2 hg)
      simp [hgE]⟩
  let ψ : c.range →+ M := c.rangeRestrict.liftOfSurjective c.rangeRestrict_surjective φ
  have hψ (g : AbsoluteGaloisGroup K) :
      χ (.ofMul (AlgEquiv.restrictNormalHom E g)) = ψ (c.rangeRestrict (.ofMul g)) :=
    (c.rangeRestrict.liftOfRightInverse_comp_apply _
      (Function.rightInverse_surjInv c.rangeRestrict_surjective) φ (.ofMul g)).symm
  -- Along a decomposition map, `c` is the cyclotomic character of the local Artin symbol.
  have hloc {L : Type} [Field L] [Algebra K L] (τ : SeparableClosure K →ₐ[K] SeparableClosure L)
      (σ : Field.absoluteGaloisGroup L) :
      (c.rangeRestrict (.ofMul (absoluteGaloisGroupMap τ (absoluteGaloisGroupRestrictEquiv L σ))) :
        Additive ℤ_[p]ˣ) = .ofMul (abelianizedLocalCyclotomicCharacter p L σ) := by
    rw [AddMonoidHom.coe_rangeRestrict, hc, cyclotomicCharacter_absoluteGaloisGroupMap,
      cyclotomicCharacter_absoluteGaloisGroupRestrictEquiv, abelianizedLocalCyclotomicCharacter_mk]
  let f (v : HeightOneSpectrum (𝓞 K)) := abelianizedLocalCyclotomicCharacter p (v.adicCompletion K)
    (artinMap (v.adicCompletion K) (Units.map (algebraMap K (v.adicCompletion K)) a))
  have hf v := (hloc (τ v) (σ v)).trans (congrArg _ (congrArg _ (hσ v)))
  have hf' w := (hloc (τ' w) (σ' w)).trans (congrArg _ (congrArg _ (hσ' w)))
  -- Outside the finite support of `f`, the terms of the finite-place sum vanish.
  have hS : (Function.mulSupport f).Finite :=
    hasFiniteMulSupport_abelianizedLocalCyclotomicCharacter_artinMap p a
  rw [finsum_eq_sum_of_support_subset _ (s := hS.toFinset) fun v hv ↦ by
    rw [Set.Finite.coe_toFinset, Function.mem_mulSupport]
    refine fun hfv ↦ hv ?_
    dsimp only
    rw [hψ, ← map_zero ψ]
    exact congrArg ψ (Subtype.ext ((hf v).trans ((congrArg Additive.ofMul hfv).trans ofMul_one)))]
  simp only [hψ, ← map_sum, ← map_add]
  rw [← map_zero ψ]
  refine congrArg ψ (Subtype.ext ?_)
  simp only [AddSubgroup.coe_add, AddSubgroup.val_finsetSum, hf, hf', ← ofMul_prod, ← ofMul_mul,
    ZeroMemClass.coe_zero]
  rw [← finprod_eq_prod_of_mulSupport_subset f (by simp),
    finprod_mul_prod_abelianizedLocalCyclotomicCharacter_artinMap_eq_one, ofMul_one]

/-- **The sum of the local invariants vanishes on the classes split by a cyclic cyclotomic
extension.** Let `E ⊆ Kˢ` be a finite Galois extension of a number field `K`, contained in
`K(μ_{p^∞})` and with cyclic Galois group. Then the local invariants of every Brauer class of `K`
split by `E` sum to zero. -/
theorem sumLocalInv_brLocalization_relBrInfl_eq_zero_of_le_adjoin [FiniteDimensional K E]
    [IsGalois K E] [IsCyclic Gal(E/K)]
    (hE : E ≤ adjoin K {ζ : SeparableClosure K | ∃ n : ℕ, ζ ^ p ^ n = 1})
    (y : groupCohomology (Rep.ofMulDistribMulAction Gal(E/K) Eˣ) 2) :
    sumLocalInv K (brLocalization K (relBrInfl K E E.val y)) = 0 := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Gal(E/K))
  -- The character of `Gal(E/K)` sending the generator `g` to `1 / [E : K]`.
  let e : Gal(E/K) ≃* Multiplicative (ZMod (Module.finrank K E)) :=
    (zmodMulEquivOfGenerator hg (IsGalois.card_aut_eq_finrank K E)).symm
  let χ : Additive Gal(E/K) →+ AddCircle (1 : ℚ) :=
    (ZMod.toRatAddCircle (Module.finrank K E)).comp (MulEquiv.toAdditiveLeft e).toAddMonoidHom
  have hχ : χ (.ofMul g) = ((1 / Module.finrank K E : ℚ) : AddCircle (1 : ℚ)) := by
    simpa [χ, e] using ZMod.toRatAddCircle_natCast (Module.finrank K E) 1
  -- Representatives of the local Artin symbols, and decomposition maps.
  have hσ (a : Kˣ) (v : HeightOneSpectrum (𝓞 K)) := QuotientGroup.mk_surjective
    (artinMap (v.adicCompletion K) (Units.map (algebraMap K (v.adicCompletion K)) a))
  have hσ' (a : Kˣ) (w : InfinitePlace K) := QuotientGroup.mk_surjective
    (infiniteArtinAt w (Units.map (algebraMap K w.Completion) a))
  refine (forall_sumLocalInv_brLocalization_relBrInfl_eq_zero_iff E hg
    (fun _ ↦ IsSepClosed.lift) (fun _ ↦ IsSepClosed.lift) (fun a v ↦ (hσ a v).choose)
    (fun a w ↦ (hσ' a w).choose) hχ (fun a v ↦ (hσ a v).choose_spec)
    (fun a w ↦ (hσ' a w).choose_spec)).2 (fun a ↦ ?_) y
  exact finsum_add_sum_apply_restrictNormalHom_eq_zero_of_le_adjoin p E _ _ _ _ hE χ a
    (fun v ↦ (hσ a v).choose_spec) (fun w ↦ (hσ' a w).choose_spec)

end TauCeti.ClassFieldTheory
