module

public import TauCeti.FieldTheory.GaloisCohomology.Cyclic
public import TauCeti.FieldTheory.KrullTopology
public import TauCeti.NumberTheory.ClassFieldTheory.Brauer.Basic
public import TauCeti.RepresentationTheory.Homological.ContCohomology.CarryCocycle

/-!
# Brauer classes split by a cyclic extension are carry classes

Let `K` be a field and `E/K` a finite Galois extension inside `Kˢ` whose Galois group is cyclic,
generated by `g`, and let `χ : Gal(E/K) → ℚ/ℤ` be the character with `χ(g) = 1 / [E : K]`. Read on
`G_K` through restriction to `E`, the character has open kernel, and for `a ∈ Kˣ` its carry
cocycle

```text
(σ, τ) ↦ a ^ ⌊χ'(σ|_E) + χ'(τ|_E)⌋
```

represents the Brauer class classically written `a ∪ δχ`. This file identifies these classes with
the cyclic classes: the inflation to `Br K` of the class `cyclicClass hg a` of `a` in
`H²(Gal(E/K), Eˣ)` is the carry class of `χ` and `a` (`relBrInfl_cyclicClass`). Indeed, on
`(gⁱ, gʲ)` with `i, j < [E : K]` the carry of `χ` is `1` if `i + j ≥ [E : K]` and `0` otherwise,
which are the values of the cocycle representing the cyclic class.

Every class of `H²(Gal(E/K), Eˣ)` is a cyclic class, so every Brauer class split by `E` is the
carry class of `χ` and some `a ∈ Kˣ` (`exists_characterCarryCocycle_eq_relBrInfl`), and that carry
class vanishes exactly when `a` is a norm from `E`
(`unitsRepH2Equiv_characterCarryCocycle_eq_zero_iff`). This is how the character formula
`inv (a ∪ δχ) = χ (Art a)` reaches every class split by a cyclic extension: over a number field it
turns a product formula for the local Artin symbols of a cyclic extension into the vanishing of the
sum of the local invariants of the classes it splits.

## Main results

* `TauCeti.ClassFieldTheory.relBrInfl_cyclicClass`: the inflated cyclic class of `a` is the carry
  class of `χ` and `a`.
* `TauCeti.ClassFieldTheory.exists_characterCarryCocycle_eq_relBrInfl`: every Brauer class split
  by `E` is a carry class of `χ`.
* `TauCeti.ClassFieldTheory.unitsRepH2Equiv_characterCarryCocycle_eq_zero_iff`: the carry class of
  `χ` and `a` vanishes exactly when `a` is a norm from `E`.

## References

* J. S. Milne, *Class Field Theory*, Chapter VII, Lemma 8.5.
* J.-P. Serre, *Local Fields*, Chapter XIV, §1.
-/

public section

noncomputable section

namespace TauCeti.ClassFieldTheory

open ContCohomology

variable {K : Type} [Field K] (E : IntermediateField K (SeparableClosure K))
  [FiniteDimensional K E] [IsGalois K E] {g : Gal(E/K)} (hg : ∀ σ, σ ∈ Subgroup.zpowers g)
  {χ : Additive Gal(E/K) →+ AddCircle (1 : ℚ)}

include hg in
/-- **The inflated cyclic class is a carry class.** Let `E/K` be a cyclic Galois extension inside
`Kˢ` with generator `g`, and `χ` the character of `Gal(E/K)` with `χ(g) = 1 / [E : K]`. Then for
`a ∈ Kˣ`, the inflation to `Br K` of the class of `a` in `H²(Gal(E/K), Eˣ)` at `g` is the class of
the carry cocycle of `χ`, read on `G_K`, and `a`: classically, `a ∪ δχ`. -/
theorem relBrInfl_cyclicClass
    (hχ : χ (.ofMul g) = ((1 / Module.finrank K E : ℚ) : AddCircle (1 : ℚ))) (a : Kˣ) :
    relBrInfl K E E.val (cyclicClass hg (.ofMul a)) =
      unitsRepH2Equiv K (characterCarryCocycle
        (χ.comp (AlgEquiv.restrictNormalHom (K₁ := SeparableClosure K) E).toAdditive)
        (E.isOpen_ker_comp_restrictNormalHom χ) (baseUnitsEquivInvariants K (.ofMul a))) := by
  set n := Module.finrank K E
  have horder : orderOf g = n := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hg, IsGalois.card_aut_eq_finrank]
  have hpow (i : ℕ) : χ (.ofMul (g ^ i)) = ((i / n : ℚ) : AddCircle (1 : ℚ)) := by
    rw [ofMul_pow, map_nsmul, hχ, ← AddCircle.coe_nsmul, nsmul_eq_mul, mul_one_div]
  set b : Eˣ := Units.map (algebraMap K E : K →* E) a
  -- The carry cocycle is read off `Gal(E/K)`, with the value `b ^ carry` at `(σ, τ)`.
  obtain ⟨c, hcu, hc⟩ := exists_relBrCocycle_eq K E E.val
    (characterCarryCocycle _ (E.isOpen_ker_comp_restrictNormalHom χ)
      (baseUnitsEquivInvariants K (.ofMul a)))
    (fun p ↦ b ^ characterCarry χ p.1 p.2) fun σ τ ↦ by
      apply Additive.toMul.injective
      apply Units.ext
      simp [characterCarryCocycle_apply, b]
  -- The cocycle `c` takes the values of the carry cocycle of `a` at `g`.
  rw [← hc, ← relBrInfl_H2π, H2π_eq_cyclicClass hg c a fun i j hi hj ↦ ?_]
  rw [horder] at hi hj ⊢
  -- The values of `c` are read in `Eˣ` through `Rep.toAdditive`, which is the identity.
  refine (hcu (g ^ i, g ^ j)).trans ?_
  rw [characterCarry_eq_ite _ hi hj (hpow i) (hpow j)]
  split_ifs <;> simp [b]

include hg in
/-- **Every Brauer class split by a cyclic extension is a carry class.** If `E/K` is cyclic with
generator `g` and `χ(g) = 1 / [E : K]`, every class inflated from `H²(Gal(E/K), Eˣ)` to `Br K` is
the carry class of `χ`, read on `G_K`, and some `a ∈ Kˣ`. -/
theorem exists_characterCarryCocycle_eq_relBrInfl
    (hχ : χ (.ofMul g) = ((1 / Module.finrank K E : ℚ) : AddCircle (1 : ℚ)))
    (y : groupCohomology (Rep.ofMulDistribMulAction Gal(E/K) Eˣ) 2) :
    ∃ a : Kˣ, unitsRepH2Equiv K (characterCarryCocycle
        (χ.comp (AlgEquiv.restrictNormalHom (K₁ := SeparableClosure K) E).toAdditive)
        (E.isOpen_ker_comp_restrictNormalHom χ) (baseUnitsEquivInvariants K (.ofMul a))) =
      relBrInfl K E E.val y := by
  obtain ⟨a, rfl⟩ := cyclicClass_surjective hg y
  exact ⟨a.toMul, (relBrInfl_cyclicClass E hg hχ a.toMul).symm⟩

include hg in
/-- **The carry class of a generating character vanishes exactly on norms.** If `E/K` is cyclic
with generator `g` and `χ(g) = 1 / [E : K]`, the carry class of `χ`, read on `G_K`, and `a ∈ Kˣ`
is zero in `Br K` exactly when `a` is a norm from `E`. -/
theorem unitsRepH2Equiv_characterCarryCocycle_eq_zero_iff
    (hχ : χ (.ofMul g) = ((1 / Module.finrank K E : ℚ) : AddCircle (1 : ℚ))) {a : Kˣ} :
    unitsRepH2Equiv K (characterCarryCocycle
        (χ.comp (AlgEquiv.restrictNormalHom (K₁ := SeparableClosure K) E).toAdditive)
        (E.isOpen_ker_comp_restrictNormalHom χ) (baseUnitsEquivInvariants K (.ofMul a))) = 0 ↔
      a ∈ normGroup K E := by
  rw [← relBrInfl_cyclicClass E hg hχ, map_eq_zero_iff _ (relBrInfl_injective K E E.val),
    cyclicClass_eq_zero_iff]

end TauCeti.ClassFieldTheory
