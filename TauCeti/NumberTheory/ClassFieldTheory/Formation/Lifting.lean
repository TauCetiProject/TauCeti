module

public import TauCeti.Algebra.AddCircle
public import TauCeti.NumberTheory.ClassFieldTheory.Formation.CoefficientMap
public import TauCeti.NumberTheory.ClassFieldTheory.Formation.InflationRestriction

/-!
# Lifting second cohomology along a map of formations after a refinement

Let `φ : A → A'` be an equivariant map between the coefficient modules of two formations `F` and
`F'` on `G`, and let `σ` assign to every finite normal layer `L` a homomorphism
`σ_L : H²(L, A) → ℚ/ℤ` that multiplies by the relative degree under restriction. For the idele
classes of a number field, `A` is the ideles, `A'` the idele classes and `σ` the sum of the local
invariants. A class of `H²(L, A')` need not be the image under `φ` of a class of `H²(L, A)`: for
the idele classes the obstruction lies in `H³(L, Lˣ)`, and it is nonzero for the biquadratic
field `ℚ(√13, √17)`. This file shows that the obstruction disappears after inflation to a
suitable refinement of `L`, once the following hold:

* `σ` vanishes exactly on the classes that `φ` kills;
* `H¹` of every layer of `F'` vanishes;
* the order of `H²(L, A')` divides the degree `n` of `L`, the second inequality of class field
  theory in its cohomological form;
* some refinement `L'` of `L` carries a class `y` with `σ_{L'}(y) = 1/n`.

The argument is Tate's. Restricted to the layer `L'/L`, the class `y` has `σ = n • (1/n) = 0`, so
its image `φ(y)` restricts to zero there, and by the inflation-restriction sequence `φ(y)` is the
inflation of a class `x` of `H²(L, A')`. If `d • x = 0` then `φ(d • y) = 0`, so
`σ(d • y) = d • (1/n) = 0` and `n ∣ d`. Hence `x` has order at least `n`, and since `H²(L, A')` has
at most `n` elements, it is cyclic of order exactly `n` generated by `x`
(`NormalLayer.zmultiples_eq_top_of_cohomologyInfl_eq_map`,
`NormalLayer.natCard_H2_eq_degree_of_natCard_H2_dvd`). Every class is then a multiple `k • x`,
whose inflation to `L'` is `φ(k • y)`: after inflation to the one refinement `L'`, every class of
`H²(L, A')` lifts along `φ`
(`NormalLayer.exists_refinement_forall_exists_map_eq_cohomologyInfl`).

## Main statements

* `TauCeti.ClassFieldTheory.NormalLayer.exists_cohomologyInfl_eq_map`: a class of `H²(L, A')`
  whose inflation is the image of a class with `σ = 1/n`.
* `TauCeti.ClassFieldTheory.NormalLayer.zmultiples_eq_top_of_cohomologyInfl_eq_map`: such a class
  generates `H²(L, A')`.
* `TauCeti.ClassFieldTheory.NormalLayer.natCard_H2_eq_degree_of_natCard_H2_dvd`: `H²(L, A')` has
  exactly `n` elements.
* `TauCeti.ClassFieldTheory.NormalLayer.exists_refinement_forall_exists_map_eq_cohomologyInfl`:
  every class of `H²(L, A')` lifts along `φ` after inflation to one refinement of `L`.

## References

* J. S. Milne, *Class Field Theory*, v4.03, Chapter VIII, §4 (proof of Theorem 4.7).
* J. Tate, *Global class field theory*, in J. W. S. Cassels and A. Fröhlich (eds.),
  *Algebraic Number Theory*, Chapter VII, §11.
-/

public section

open CategoryTheory

namespace TauCeti.ClassFieldTheory

namespace NormalLayer

variable {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [TotallyDisconnectedSpace G] {F F' : Formation G}
  (φ : F.toRep ⟶ F'.toRep) (σ : ∀ L : NormalLayer G, L.H F 2 →+ AddCircle (1 : ℚ))
  (hres : ∀ {small big : NormalLayer G} (R : LayerRestriction small big) (y : big.H F 2),
    σ small (R.cohomologyRes F 2 y) = R.relativeDegree • σ big y)
  (hker : ∀ (L : NormalLayer G) (y : L.H F 2),
    groupCohomology.map (MonoidHom.id L.Gal) (L.repMap φ) 2 y = 0 → σ L y = 0)
  (hσ₀ : ∀ (L : NormalLayer G) (y : L.H F 2), σ L y = 0 →
    groupCohomology.map (MonoidHom.id L.Gal) (L.repMap φ) 2 y = 0)
  (h1 : ∀ L : NormalLayer G, Subsingleton (L.H F' 1))
  {L L' : NormalLayer G}

include hres hσ₀ h1 in
/-- **A class with `σ = 1/n` on a refinement maps to an inflated class.** Let `L` have degree `n`
and let `y` be a class on a refinement `L'` of `L` with `σ_{L'}(y) = 1/n`. If `σ` multiplies by
the relative degree under restriction, vanishes only on classes that `φ` kills, and `H¹` of every
layer of `F'` vanishes, then `φ(y)` is the inflation of a class of `H²(L, A')`. -/
theorem exists_cohomologyInfl_eq_map (T : LayerRefinement L L') {y : L'.H F 2}
    (hy : σ L' y = ((1 / L.degree : ℚ) : AddCircle (1 : ℚ))) :
    ∃ x : L.H F' 2,
      T.cohomologyInfl F' 2 x = groupCohomology.map (MonoidHom.id L'.Gal) (L'.repMap φ) 2 y := by
  set R := L'.subgroupRestriction T.galHom.ker
  -- Restricted to the layer `L'/L`, of relative degree `n`, the class `y` has `σ = n • (1/n) = 0`.
  have hRy : groupCohomology.map (MonoidHom.id (L'.subgroupLayer T.galHom.ker).Gal)
      ((L'.subgroupLayer T.galHom.ker).repMap φ) 2 (R.cohomologyRes F 2 y) = 0 := by
    refine hσ₀ _ _ ?_
    rw [hres, hy, T.relativeDegree_subgroupRestriction_ker]
    exact AddSubgroup.torsionBy.nsmul_iff.1 (AddCircle.coe_period_div_mem_torsionBy (1 : ℚ))
  -- So `φ(y)` restricts to zero on `L'/L` and is inflated from `L`.
  have hres' : R.cohomologyRes F' 2
      (groupCohomology.map (MonoidHom.id L'.Gal) (L'.repMap φ) 2 y) = 0 := by
    rwa [← LayerRestriction.cohomologyRes_comp_map_repMap_apply]
  exact T.exists_cohomologyInfl_eq_of_cohomologyRes_eq_zero F' (h1 _) hres'

include hker in
/-- If the inflation of `x` to a refinement is the image of a class with `σ = 1/n`, `n` the degree
of `L`, then the order of `x` is divisible by `n`: a multiple `d • x = 0` gives `φ(d • y) = 0`,
hence `d • (1/n) = σ(d • y) = 0`. -/
private theorem degree_dvd_addOrderOf (T : LayerRefinement L L') {y : L'.H F 2}
    (hy : σ L' y = ((1 / L.degree : ℚ) : AddCircle (1 : ℚ))) {x : L.H F' 2}
    (hx : T.cohomologyInfl F' 2 x = groupCohomology.map (MonoidHom.id L'.Gal) (L'.repMap φ) 2 y) :
    L.degree ∣ addOrderOf x := by
  have h : groupCohomology.map (MonoidHom.id L'.Gal) (L'.repMap φ) 2 (addOrderOf x • y) = 0 := by
    rw [map_nsmul, ← hx, ← map_nsmul, addOrderOf_nsmul_eq_zero, map_zero]
  have h' := hker L' _ h
  rw [map_nsmul, hy] at h'
  rw [← AddCircle.addOrderOf_period_div (p := (1 : ℚ)) L.degree_pos]
  exact addOrderOf_dvd_of_nsmul_eq_zero h'

include hker in
/-- **`H²(L, A')` has exactly `n` elements** if its order divides the degree `n` of `L` and the
inflation of some class to a refinement is the image of a class with `σ = 1/n`. -/
theorem natCard_H2_eq_degree_of_natCard_H2_dvd (h2 : Nat.card (L.H F' 2) ∣ L.degree)
    (T : LayerRefinement L L') {y : L'.H F 2}
    (hy : σ L' y = ((1 / L.degree : ℚ) : AddCircle (1 : ℚ))) {x : L.H F' 2}
    (hx : T.cohomologyInfl F' 2 x = groupCohomology.map (MonoidHom.id L'.Gal) (L'.repMap φ) 2 y) :
    Nat.card (L.H F' 2) = L.degree :=
  Nat.dvd_antisymm h2 ((degree_dvd_addOrderOf φ σ hker T hy hx).trans (addOrderOf_dvd_natCard x))

include hker in
/-- **A class whose inflation lifts a class with `σ = 1/n` generates `H²(L, A')`**, when the order
of `H²(L, A')` divides the degree `n` of `L`. -/
theorem zmultiples_eq_top_of_cohomologyInfl_eq_map (h2 : Nat.card (L.H F' 2) ∣ L.degree)
    (T : LayerRefinement L L') {y : L'.H F 2}
    (hy : σ L' y = ((1 / L.degree : ℚ) : AddCircle (1 : ℚ))) {x : L.H F' 2}
    (hx : T.cohomologyInfl F' 2 x = groupCohomology.map (MonoidHom.id L'.Gal) (L'.repMap φ) 2 y) :
    AddSubgroup.zmultiples x = ⊤ := by
  have : Finite (L.H F' 2) :=
    Nat.finite_of_card_ne_zero (ne_zero_of_dvd_ne_zero L.degree_pos.ne' h2)
  refine AddSubgroup.eq_top_of_card_eq _ ?_
  rw [Nat.card_zmultiples]
  exact Nat.dvd_antisymm (addOrderOf_dvd_natCard x)
    (h2.trans (degree_dvd_addOrderOf φ σ hker T hy hx))

include hres hker hσ₀ h1 in
/-- **Every class of `H²(L, A')` lifts along `φ` after inflation to one refinement.** Let `L` have
degree `n`, and suppose that `σ` multiplies by the relative degree under restriction and vanishes
exactly on the classes that `φ` kills, that `H¹` of every layer of `F'` vanishes, that the order of
`H²(L, A')` divides `n`, and that some refinement of `L` carries a class with `σ = 1/n`. Then on
that refinement `L'` the inflation of every class of `H²(L, A')` is the image under `φ` of a class
of `H²(L', A)`. -/
theorem exists_refinement_forall_exists_map_eq_cohomologyInfl
    (h2 : Nat.card (L.H F' 2) ∣ L.degree)
    (hgen : ∃ (L' : NormalLayer G) (_ : LayerRefinement L L') (y : L'.H F 2),
      σ L' y = ((1 / L.degree : ℚ) : AddCircle (1 : ℚ))) :
    ∃ (L' : NormalLayer G) (T : LayerRefinement L L'), ∀ x : L.H F' 2, ∃ y : L'.H F 2,
      groupCohomology.map (MonoidHom.id L'.Gal) (L'.repMap φ) 2 y = T.cohomologyInfl F' 2 x := by
  obtain ⟨L', T, y, hy⟩ := hgen
  obtain ⟨x₀, hx₀⟩ := exists_cohomologyInfl_eq_map φ σ hres hσ₀ h1 T hy
  refine ⟨L', T, fun x ↦ ?_⟩
  -- Every class is a multiple of `x₀`, whose inflation is the image of `y`.
  obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1
    ((zmultiples_eq_top_of_cohomologyInfl_eq_map φ σ hker h2 T hy hx₀).ge
      (AddSubgroup.mem_top x))
  exact ⟨k • y, by rw [map_zsmul, map_zsmul, hx₀]⟩

end NormalLayer

end TauCeti.ClassFieldTheory
