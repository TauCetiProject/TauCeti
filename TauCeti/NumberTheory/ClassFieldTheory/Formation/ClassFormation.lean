module

public import TauCeti.Algebra.AddCircle
public import TauCeti.NumberTheory.ClassFieldTheory.Formation.Conjugation
public import TauCeti.NumberTheory.ClassFieldTheory.Formation.Corestriction
public import TauCeti.NumberTheory.ClassFieldTheory.Formation.Refinement

/-!
# Class formations and fundamental classes

A **class formation** in the sense of Artin–Tate is a formation whose finite normal layers
`K/F` (with Galois group `Γ = U ⧸ V` and coefficient module `C = A^V`) satisfy

1. `H¹(Γ, C) = 0`;
2. there is an injective **invariant map** `inv_{K/F} : H²(Γ, C) → ℚ/ℤ`;
3. whose image is the unique subgroup of `ℚ/ℤ` of order `[K : F]`;
4. restriction to an intermediate ground field `E` multiplies invariants by `[E : F]`;
5. inflation to a larger top field does not change invariants;
6. conjugation carries the invariant map of a layer to that of the conjugate layer.

The target `ℚ/ℤ` is the rational circle `AddCircle (1 : ℚ)`, and its subgroup of order `n` is the
`n`-torsion `AddSubgroup.torsionBy (AddCircle (1 : ℚ)) n`, which
`AddCircle.eq_torsionBy_of_natCard_eq` shows is the only subgroup of that order.

The invariant map is **data** of the structure. The **fundamental class** is not: it is derived
below as the unique class `u_{K/F}` of invariant `1 / [K : F]`
(`ClassFormation.fundamentalClass`, `ClassFormation.inv_fundamentalClass`,
`ClassFormation.eq_fundamentalClass_iff`). The axioms force `H²(Γ, C)` to be cyclic of order
`[K : F]`, generated by `u_{K/F}`.

The compatibilities of the fundamental class have three different shapes, and each is stated
separately:

* restriction to an intermediate ground field carries `u_{K/F}` to `u_{K/E}`
  (`ClassFormation.fundamentalClass_restrict`);
* inflation to a larger top field `L` is scaled: `inf u_{K/F} = [L : K] • u_{L/F}`
  (`ClassFormation.fundamentalClass_infl`);
* corestriction preserves invariants (`ClassFormation.inv_cor`, a theorem, not an axiom) and is
  scaled the other way: `cor u_{K/E} = [E : F] • u_{K/F}` (`ClassFormation.fundamentalClass_cor`);

and conjugation carries fundamental classes to fundamental classes
(`ClassFormation.fundamentalClass_conj`).

Finally, the three hypotheses of Tate's theorem are verified, one by one, for the finite quotient
system `H ↦ subgroupLayer H` of a layer: `H¹` of each of its layers vanishes
(`ClassFormation.h1_subgroupLayer`), `H²` of the layer of `H` has `#H` elements
(`ClassFormation.card_H2_subgroupLayer`), and it is generated by the restriction of the
fundamental class (`ClassFormation.fundamentalClass_restrict_generates`).

## Main definitions

* `TauCeti.ClassFieldTheory.ClassFormation`: the class-formation axioms on a formation, with the
  invariant map as data.
* `TauCeti.ClassFieldTheory.ClassFormation.fundamentalClass`: the fundamental class of a finite
  normal layer.

## References

* E. Artin and J. Tate, *Class Field Theory*, Chapter XIV, §§1–4.
* J.-P. Serre, *Local Fields*, Chapter XI, §§1–3.
-/

public noncomputable section

namespace TauCeti.ClassFieldTheory

variable {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [TotallyDisconnectedSpace G]

/-- A **class formation** in the finite-layer form of Artin–Tate: the first cohomology of every
finite normal layer vanishes, and its second cohomology carries an injective invariant map onto
the subgroup of `ℚ/ℤ` of order the degree of the layer, compatible with restriction, inflation and
conjugation.

The invariant map is data. The fundamental class is not a field: it is derived as
`ClassFormation.fundamentalClass`. Since every other field is a proposition, a class formation is
determined by its invariant maps (`ClassFormation.ext`). -/
@[ext]
structure ClassFormation (F : Formation G) where
  /-- `H¹` of every finite normal layer vanishes. -/
  subsingleton_h1 : ∀ L : NormalLayer G, Subsingleton (L.H F 1)
  /-- The invariant map `inv_{K/F} : H²(Gal(K/F), A^V) → ℚ/ℤ` of a layer. -/
  inv : ∀ L : NormalLayer G, L.H F 2 →+ AddCircle (1 : ℚ)
  /-- The invariant map is injective. -/
  inv_injective : ∀ L : NormalLayer G, Function.Injective (inv L)
  /-- The image of the invariant map is the subgroup of `ℚ/ℤ` of order `[K : F]`. -/
  range_inv : ∀ L : NormalLayer G,
    Set.range (inv L) =
      (AddSubgroup.torsionBy (AddCircle (1 : ℚ)) L.degree : Set (AddCircle (1 : ℚ)))
  /-- Restriction to an intermediate ground field `E` multiplies invariants by `[E : F]`. -/
  inv_restrict : ∀ {small big : NormalLayer G} (T : LayerRestriction small big)
    (x : big.H F 2), inv small (T.cohomologyRes F 2 x) = T.relativeDegree • inv big x
  /-- Inflation to a larger top field does not change invariants. -/
  inv_infl : ∀ {old new : NormalLayer G} (T : LayerRefinement old new)
    (x : old.H F 2), inv new (T.cohomologyInfl F 2 x) = inv old x
  /-- Conjugation carries the invariant map of a layer to that of the conjugate layer. -/
  inv_conj : ∀ (L : NormalLayer G) (g : G) (x : L.H F 2),
    inv (L.conjugate g) ((L.conjugateCohomologyIso F g 2).hom x) = inv L x

namespace ClassFormation

variable {F : Formation G}

/-! ### The second cohomology of a layer -/

/-- `H²` of a finite normal layer of a class formation has exactly `[K : F]` elements. -/
theorem natCard_H2 (cf : ClassFormation F) (L : NormalLayer G) :
    Nat.card (L.H F 2) = L.degree :=
  AddCircle.natCard_eq_of_injective_of_range_eq_torsionBy (1 : ℚ) L.degree_pos (cf.inv_injective L)
    (cf.range_inv L)

/-- There is exactly one class of invariant `1 / [K : F]`. -/
theorem existsUnique_inv_eq (cf : ClassFormation F) (L : NormalLayer G) :
    ∃! u : L.H F 2, cf.inv L u = ((1 / L.degree : ℚ) : AddCircle (1 : ℚ)) :=
  AddCircle.existsUnique_apply_eq_coe_period_div (1 : ℚ) L.degree_pos (cf.inv_injective L)
    (cf.range_inv L)

/-- The **fundamental class** `u_{K/F}` of a finite normal layer: the unique class of invariant
`1 / [K : F]`. -/
def fundamentalClass (cf : ClassFormation F) (L : NormalLayer G) : L.H F 2 :=
  (cf.existsUnique_inv_eq L).exists.choose

/-- The fundamental class has invariant `1 / [K : F]`. -/
@[simp]
theorem inv_fundamentalClass (cf : ClassFormation F) (L : NormalLayer G) :
    cf.inv L (cf.fundamentalClass L) = ((1 / L.degree : ℚ) : AddCircle (1 : ℚ)) :=
  (cf.existsUnique_inv_eq L).exists.choose_spec

/-- The fundamental class is characterized by its invariant. -/
theorem eq_fundamentalClass_iff (cf : ClassFormation F) {L : NormalLayer G} (x : L.H F 2) :
    x = cf.fundamentalClass L ↔ cf.inv L x = ((1 / L.degree : ℚ) : AddCircle (1 : ℚ)) :=
  ⟨fun h ↦ h ▸ cf.inv_fundamentalClass L,
    fun h ↦ cf.inv_injective L (h.trans (cf.inv_fundamentalClass L).symm)⟩

/-- Every class in `H²` of a layer is an integer multiple of the fundamental class. -/
theorem fundamentalClass_generates (cf : ClassFormation F) (L : NormalLayer G) (x : L.H F 2) :
    ∃ m : ℤ, x = m • cf.fundamentalClass L := by
  obtain ⟨m, hm⟩ := AddCircle.exists_zsmul_eq_of_apply_eq_coe_period_div (1 : ℚ) L.degree_pos
    (cf.inv_injective L) (cf.range_inv L) (cf.inv_fundamentalClass L) x
  exact ⟨m, hm.symm⟩

/-- The fundamental class generates `H²` of its layer. -/
theorem zmultiples_fundamentalClass (cf : ClassFormation F) (L : NormalLayer G) :
    AddSubgroup.zmultiples (cf.fundamentalClass L) = ⊤ :=
  eq_top_iff.mpr fun x _ ↦ AddSubgroup.mem_zmultiples_iff.mpr
    (((cf.fundamentalClass_generates L x).imp fun _ h ↦ h.symm))

/-- `H²` of a finite normal layer of a class formation is cyclic; by
`ClassFormation.natCard_H2` it is cyclic of order `[K : F]`. -/
theorem isAddCyclic_H2 (cf : ClassFormation F) (L : NormalLayer G) : IsAddCyclic (L.H F 2) :=
  ⟨⟨cf.fundamentalClass L, fun x ↦ AddSubgroup.mem_zmultiples_iff.mpr
    ((cf.fundamentalClass_generates L x).imp fun _ h ↦ h.symm)⟩⟩

/-- The fundamental class has order exactly `[K : F]`. -/
@[simp]
theorem addOrderOf_fundamentalClass (cf : ClassFormation F) (L : NormalLayer G) :
    addOrderOf (cf.fundamentalClass L) = L.degree := by
  rw [← Nat.card_zmultiples, cf.zmultiples_fundamentalClass L, AddSubgroup.card_top,
    cf.natCard_H2 L]

/-! ### Restriction, inflation and conjugation of fundamental classes -/

/-- **Restriction of the fundamental class**: restricting `u_{K/F}` to an intermediate ground
field `E` gives `u_{K/E}`. -/
@[simp]
theorem fundamentalClass_restrict (cf : ClassFormation F)
    {small big : NormalLayer G} (T : LayerRestriction small big) :
    T.cohomologyRes F 2 (cf.fundamentalClass big) = cf.fundamentalClass small := by
  rw [eq_fundamentalClass_iff, cf.inv_restrict, inv_fundamentalClass,
    AddCircle.nsmul_coe_period_div (1 : ℚ) (Dvd.intro_left _ T.degree_mul_relativeDegree),
    ← T.degree_mul_relativeDegree, Nat.mul_div_cancel _ T.relativeDegree_pos]

/-- **Inflation of the fundamental class is scaled**: under a refinement of the top field from
`K` to `L`, `inf u_{K/F} = [L : K] • u_{L/F}`. -/
theorem fundamentalClass_infl (cf : ClassFormation F)
    {old new : NormalLayer G} (T : LayerRefinement old new) :
    T.cohomologyInfl F 2 (cf.fundamentalClass old) =
      T.relativeDegree • cf.fundamentalClass new := by
  refine cf.inv_injective new ?_
  rw [cf.inv_infl, map_nsmul, inv_fundamentalClass, inv_fundamentalClass,
    AddCircle.nsmul_coe_period_div (1 : ℚ) (Dvd.intro_left _ T.degree_mul_relativeDegree),
    ← T.degree_mul_relativeDegree, Nat.mul_div_cancel _ T.relativeDegree_pos]

/-- **Conjugation of the fundamental class**: conjugation by `g` carries `u_{K/F}` to the
fundamental class of the conjugate layer. -/
@[simp]
theorem fundamentalClass_conj (cf : ClassFormation F) (L : NormalLayer G) (g : G) :
    (L.conjugateCohomologyIso F g 2).hom (cf.fundamentalClass L) =
      cf.fundamentalClass (L.conjugate g) := by
  rw [eq_fundamentalClass_iff, cf.inv_conj, inv_fundamentalClass, NormalLayer.degree_conjugate]

/-! ### Corestriction -/

/-- In a class formation, restriction to an intermediate ground field is surjective on `H²`:
every class of the smaller layer is the restriction of an integer multiple of the fundamental
class of the larger one. -/
theorem cohomologyRes_surjective (cf : ClassFormation F)
    {small big : NormalLayer G} (T : LayerRestriction small big) :
    Function.Surjective (T.cohomologyRes F 2) := fun x ↦ by
  obtain ⟨m, rfl⟩ := cf.fundamentalClass_generates small x
  exact ⟨m • cf.fundamentalClass big, by rw [map_zsmul, fundamentalClass_restrict]⟩

/-- **Corestriction preserves invariants.** This is not an axiom of a class formation: it follows
from `inv_restrict`, from the surjectivity of restriction on `H²`, and from the normalization
`cor ∘ res = [E : F]`. -/
@[simp]
theorem inv_cor (cf : ClassFormation F)
    {small big : NormalLayer G} (T : LayerRestriction small big) (x : small.H F 2) :
    cf.inv big (T.cohomologyCor F 2 x) = cf.inv small x := by
  obtain ⟨y, rfl⟩ := cf.cohomologyRes_surjective T x
  rw [LayerRestriction.cohomologyCor_cohomologyRes_apply, cf.inv_restrict,
    LayerRestriction.relativeDegree_def]
  exact map_nsmul (cf.inv big) _ y

/-- **Corestriction of the fundamental class is scaled**: `cor u_{K/E} = [E : F] • u_{K/F}` for an
intermediate ground field `E`. -/
theorem fundamentalClass_cor (cf : ClassFormation F)
    {small big : NormalLayer G} (T : LayerRestriction small big) :
    T.cohomologyCor F 2 (cf.fundamentalClass small) =
      T.relativeDegree • cf.fundamentalClass big := by
  rw [← cf.fundamentalClass_restrict T, LayerRestriction.cohomologyCor_cohomologyRes_apply,
    LayerRestriction.relativeDegree_def]

/-! ### The hypotheses of Tate's theorem

For the finite quotient system `H ↦ subgroupLayer H` of a layer, these are the three hypotheses
of Tate's theorem, stated individually because they are consumed separately downstream. -/

/-- `H¹` vanishes on the layer cut out by every subgroup of the Galois group. -/
theorem h1_subgroupLayer (cf : ClassFormation F) (L : NormalLayer G) (H : Subgroup L.Gal) :
    Subsingleton ((L.subgroupLayer H).H F 1) :=
  cf.subsingleton_h1 _

/-- `H²` of the layer cut out by a subgroup `H` of the Galois group has exactly `#H` elements. -/
theorem card_H2_subgroupLayer (cf : ClassFormation F) (L : NormalLayer G) (H : Subgroup L.Gal) :
    Nat.card ((L.subgroupLayer H).H F 2) = Nat.card H := by
  rw [cf.natCard_H2, NormalLayer.degree_subgroupLayer]

/-- The restriction of the fundamental class to the layer cut out by a subgroup `H` generates
that layer's `H²`. -/
theorem fundamentalClass_restrict_generates (cf : ClassFormation F)
    (L : NormalLayer G) (H : Subgroup L.Gal)
    (x : (L.subgroupLayer H).H F 2) :
    ∃ m : ℤ, x = m • (L.subgroupRestriction H).cohomologyRes F 2 (cf.fundamentalClass L) := by
  rw [fundamentalClass_restrict]
  exact cf.fundamentalClass_generates _ x

end ClassFormation

end TauCeti.ClassFieldTheory
