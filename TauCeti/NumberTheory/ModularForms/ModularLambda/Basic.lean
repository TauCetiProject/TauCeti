/-!
# The modular `λ` function as an eta quotient

The **modular `λ` function** is the eta quotient

  `λ(τ) = 16 (η(τ/2) η(2τ)² / η(τ)³)⁸`,

where `η` is Mathlib's Dedekind eta function `ModularForm.eta`. Classically `λ = (θ₂/θ₃)⁴` in the
Jacobi theta constants, and it is a Hauptmodul for the principal congruence subgroup `Γ(2)`,
identifying `Γ(2)\ℍ` with `ℂ ∖ {0, 1}`. In the nome `q = e^{π i τ}` its expansion
`λ = 16q - 128q² + ⋯` has integer coefficients, which makes `x = λ/16` a natural integral
coordinate near the cusp `i∞`.

This file develops `λ` from the product expansion of `η`, the two generator laws of `η`, and
Weber's identity `g₀⁴ + g₁⁴ + g₂⁴ = 0` for the level-two Siegel functions
(`TauCeti.ModularForm.siegelFunction_pow_four_add_add`):

* `λ` is holomorphic on the upper half-plane and takes neither of the values `0` and `1` there;
* the product formulas, with `q = e^{π i τ}`,
  `λ(τ) = 16 q ∏_{n ≥ 0} (1 - q^{2n+1})⁸ ∏_{n ≥ 1} (1 + q^{2n})¹⁶`
  and, by Euler's identity, `λ(τ) = 16 q (∏_{n ≥ 1} (1 + q^{2n}) / ∏_{n ≥ 1} (1 + q^{2n-1}))⁸`;
* `λ(τ)/q → 16`, hence `λ(τ) → 0`, as `Im τ → ∞`;
* the transformation laws `λ(τ + 2) = λ(τ)`, `λ(τ + 1) = λ(τ)/(λ(τ) - 1)` and
  `λ(-1/τ) = 1 - λ(τ)`, and the value `λ(i) = 1/2`;
* invariance under `Γ(2)`: `λ(γ τ) = λ(τ)` for `γ ∈ Γ(2)`, also in slash form, since `Γ(2)` is
  generated by `-I`, `T²` and `S T⁻² S⁻¹` (`CongruenceSubgroup.Gamma_two_eq_closure`).

In terms of the level-two Siegel functions `g₀ = g_{(0, 1/2)} = 2 i (η(2τ)/η(τ))²` and
`g₁ = g_{(1/2, 0)} = -(η(τ/2)/η(τ))²`, the eta quotients `λ(τ)` and `λ(-1/τ)` are `g₀⁸ g₁⁴ / 16`
and `g₀⁴ g₁⁸ / 16`. With `g₀⁴ g₁⁴ g₂⁴ = -16`, Weber's identity turns their sum into `1`;
the law under `τ ↦ τ + 1` follows in the same way from the action of `T` on `g₀, g₁, g₂`.

## Main results

* `TauCeti.ModularForm.modularLambda`: the modular `λ` function.
* `TauCeti.ModularForm.differentiableAt_modularLambda`,
  `TauCeti.ModularForm.mdifferentiable_modularLambda`: `λ` is holomorphic on `ℍ`.
* `TauCeti.ModularForm.modularLambda_ne_zero`, `TauCeti.ModularForm.modularLambda_ne_one`: `λ`
  omits `0` and `1` on `ℍ`.
* `TauCeti.ModularForm.modularLambda_eq_mul_tprod`,
  `TauCeti.ModularForm.modularLambda_eq_mul_tprod_div_tprod`: the two product formulas.
* `TauCeti.ModularForm.tendsto_modularLambda_div_exp`,
  `TauCeti.ModularForm.tendsto_modularLambda`: the behaviour at the cusp `i∞`.
* `TauCeti.ModularForm.modularLambda_add_two`, `TauCeti.ModularForm.modularLambda_add_one`,
  `TauCeti.ModularForm.modularLambda_neg_one_div`, `TauCeti.ModularForm.modularLambda_I`: the
  transformation laws and `λ(i) = 1/2`.
* `TauCeti.ModularForm.modularLambda_smul`, `TauCeti.ModularForm.modularLambda_slash`:
  invariance under `Γ(2)`.

## References

* F. Calegari, V. Dimitrov and Y. Tang, *The unbounded denominators conjecture*,
  J. Amer. Math. Soc. 38 (2025), (1.0.2) and §1.1.3.
* T. M. Apostol, *Modular Functions and Dirichlet Series in Number Theory*, 2nd ed., §2.3 and
  §4.9 (the eta function).
* H. Weber, *Lehrbuch der Algebra*, Band III, and D. A. Cox, *Primes of the Form x² + ny²*, §12
  (Weber's functions, with `λ = 𝔣₂⁸/𝔣⁸` and `1 - λ = 𝔣₁⁸/𝔣⁸`).
-/

public section

open Complex Filter Topology ModularGroup
open scoped Real ModularForm MatrixGroups UpperHalfPlane Manifold

namespace TauCeti.ModularForm

/-- The **modular `λ` function** `λ(τ) = 16 (η(τ/2) η(2τ)² / η(τ)³)⁸`, an eta quotient. On the
upper half-plane it is holomorphic, omits `0` and `1`, and is invariant under `Γ(2)`; its expansion
in `q = e^{π i τ}` begins with `16q`. -/
noncomputable def modularLambda (τ : ℂ) : ℂ :=
  16 * (η (τ / 2) * η (2 * τ) ^ 2 / η τ ^ 3) ^ 8

theorem modularLambda_def (τ : ℂ) :
    modularLambda τ = 16 * (η (τ / 2) * η (2 * τ) ^ 2 / η τ ^ 3) ^ 8 :=
  (rfl)

private theorem im_div_two_pos {τ : ℂ} (hτ : 0 < τ.im) : 0 < (τ / 2).im := by
  simpa using half_pos hτ

private theorem im_two_mul_pos {τ : ℂ} (hτ : 0 < τ.im) : 0 < (2 * τ).im := by
  simpa using mul_pos two_pos hτ

/-- `λ` does not vanish on the upper half-plane. -/
theorem modularLambda_ne_zero {τ : ℂ} (hτ : 0 < τ.im) : modularLambda τ ≠ 0 := by
  have h₁ := _root_.ModularForm.eta_ne_zero (im_div_two_pos hτ)
  have h₂ := _root_.ModularForm.eta_ne_zero (im_two_mul_pos hτ)
  have h₃ := _root_.ModularForm.eta_ne_zero hτ
  rw [modularLambda_def]
  exact mul_ne_zero (by norm_num) (pow_ne_zero _ (div_ne_zero (mul_ne_zero h₁ (pow_ne_zero _ h₂))
    (pow_ne_zero _ h₃)))

/-- `λ` is complex differentiable at every point of the upper half-plane. -/
theorem differentiableAt_modularLambda {τ : ℂ} (hτ : 0 < τ.im) :
    DifferentiableAt ℂ modularLambda τ := by
  have h₁ : DifferentiableAt ℂ (fun z ↦ η (z / 2)) τ :=
    (_root_.ModularForm.differentiableAt_eta_of_mem_upperHalfPlaneSet (im_div_two_pos hτ)).comp
      (f := fun z : ℂ ↦ z / 2) τ (by fun_prop)
  have h₂ : DifferentiableAt ℂ (fun z ↦ η (2 * z)) τ :=
    (_root_.ModularForm.differentiableAt_eta_of_mem_upperHalfPlaneSet (im_two_mul_pos hτ)).comp
      (f := fun z : ℂ ↦ 2 * z) τ (by fun_prop)
  have h₃ := _root_.ModularForm.differentiableAt_eta_of_mem_upperHalfPlaneSet hτ
  rw [funext modularLambda_def]
  exact (((h₁.mul (h₂.pow 2)).div (h₃.pow 3)
    (pow_ne_zero _ (_root_.ModularForm.eta_ne_zero hτ))).pow 8).const_mul 16

/-- `λ` is holomorphic on the upper half-plane. -/
theorem mdifferentiable_modularLambda :
    MDifferentiable 𝓘(ℂ) 𝓘(ℂ) (fun τ : ℍ ↦ modularLambda τ) := fun τ ↦
  (differentiableAt_modularLambda τ.im_pos).mdifferentiableAt.comp τ τ.mdifferentiable_coe

/-! ### Product formulas -/

/-- **The product formula for `λ`**: with `q = e^{π i τ}`,
`λ(τ) = 16 q ∏_{n ≥ 0} (1 - q^{2n+1})⁸ ∏_{n ≥ 1} (1 + q^{2n})¹⁶` on the upper half-plane. -/
theorem modularLambda_eq_mul_tprod {τ : ℂ} (hτ : 0 < τ.im) :
    modularLambda τ = 16 * cexp (π * I * τ) *
      (∏' n : ℕ, (1 - cexp (π * I * τ) ^ (2 * n + 1))) ^ 8 *
        (∏' n : ℕ, (1 + cexp (π * I * τ) ^ (2 * n + 2))) ^ 16 := by
  have hη := _root_.ModularForm.eta_ne_zero hτ
  have hexp : (cexp (-(π * I * τ / 24)) * cexp (π * I * τ / 12) ^ 2) ^ 8 = cexp (π * I * τ) := by
    rw [← Complex.exp_natCast_mul, ← Complex.exp_add, ← Complex.exp_natCast_mul]
    congr 1
    push_cast
    ring
  have hP : ∏' n : ℕ, (1 + cexp (2 * π * I * τ) ^ (n + 1)) =
      ∏' n : ℕ, (1 + cexp (π * I * τ) ^ (2 * n + 2)) := by
    simp only [UpperHalfPlane.exp_two_pi_I_eq_exp_pi_I_sq, ← pow_mul, mul_add, mul_one]
  have h : modularLambda τ = 16 * (cexp (-(π * I * τ / 24)) * cexp (π * I * τ / 12) ^ 2) ^ 8 *
      (∏' n : ℕ, (1 - cexp (π * I * τ) ^ (2 * n + 1))) ^ 8 *
        (∏' n : ℕ, (1 + cexp (2 * π * I * τ) ^ (n + 1))) ^ 16 := by
    rw [modularLambda_def, eta_div_two hτ, eta_two_mul hτ]
    field_simp
  rw [h, hexp, hP]

/-- **The product formula for `λ` after Euler's identity**: with `q = e^{π i τ}`,
`λ(τ) = 16 q (∏_{n ≥ 1} (1 + q^{2n}) / ∏_{n ≥ 1} (1 + q^{2n-1}))⁸` on the upper half-plane. -/
theorem modularLambda_eq_mul_tprod_div_tprod {τ : ℂ} (hτ : 0 < τ.im) :
    modularLambda τ = 16 * cexp (π * I * τ) *
      ((∏' n : ℕ, (1 + cexp (π * I * τ) ^ (2 * n + 2))) /
        ∏' n : ℕ, (1 + cexp (π * I * τ) ^ (2 * n + 1))) ^ 8 := by
  rw [modularLambda_eq_mul_tprod hτ]
  set q := cexp (π * I * τ)
  have hq : ‖q‖ < 1 := UpperHalfPlane.norm_exp_pi_I_lt_one hτ
  have hq2 : ‖q ^ 2‖ < 1 := by simpa using pow_lt_one₀ (norm_nonneg q) hq two_ne_zero
  have hE : Multipliable fun n : ℕ ↦ 1 + q ^ (2 * n + 2) :=
    (multipliable_one_add_pow hq2).congr fun n ↦ by rw [← pow_mul, mul_add, mul_one]
  -- Euler's identity, with `∏_{n ≥ 1} (1 + qⁿ)` split into its odd and even factors.
  have heuler : ((∏' n : ℕ, (1 + q ^ (2 * n + 1))) * ∏' n : ℕ, (1 + q ^ (2 * n + 2))) *
      ∏' n : ℕ, (1 - q ^ (2 * n + 1)) = 1 := by
    rw [tprod_even_mul_odd (f := fun n ↦ 1 + q ^ (n + 1)) (multipliable_one_add_pow_odd hq) hE]
    exact tprod_one_add_pow_mul_tprod_one_sub_pow_odd hq
  rw [eq_inv_of_mul_eq_one_right heuler]
  field_simp [left_ne_zero_of_mul_eq_one heuler]

/-! ### The cusp `i∞` -/

/-- `λ(τ) / e^{π i τ} → 16` as `Im τ → ∞`: the expansion of `λ` in `q = e^{π i τ}` begins
with `16 q`. -/
theorem tendsto_modularLambda_div_exp :
    Tendsto (fun τ : ℂ ↦ modularLambda τ / cexp (π * I * τ)) (comap im atTop) (𝓝 16) := by
  have hdiv : Tendsto (fun τ : ℂ ↦ τ / 2) (comap im atTop) (comap im atTop) :=
    tendsto_comap_iff.2 <| by
      simpa [Function.comp_def] using tendsto_comap.atTop_div_const (two_pos (α := ℝ))
  have hmul : Tendsto (fun τ : ℂ ↦ 2 * τ) (comap im atTop) (comap im atTop) :=
    tendsto_comap_iff.2 <| by
      simpa [Function.comp_def] using tendsto_comap.const_mul_atTop (two_pos (α := ℝ))
  have h₁ := tendsto_eta_div_exp.comp hdiv
  have h₂ := tendsto_eta_div_exp.comp hmul
  have h₃ := tendsto_eta_div_exp
  have hlim := ((h₁.mul (h₂.pow 2)).div (h₃.pow 3) (by norm_num)).pow 8 |>.const_mul 16
  norm_num at hlim
  refine hlim.congr' ?_
  filter_upwards [tendsto_comap.eventually (eventually_gt_atTop 0)] with τ hτ
  have hη := _root_.ModularForm.eta_ne_zero hτ
  have hexp : cexp (π * I * τ) = (cexp (2 * π * I * (2 * τ) / 24) ^ 2 *
      cexp (2 * π * I * (τ / 2) / 24) / cexp (2 * π * I * τ / 24) ^ 3) ^ 8 := by
    rw [← Complex.exp_natCast_mul, ← Complex.exp_natCast_mul, ← Complex.exp_add, ← Complex.exp_sub,
      ← Complex.exp_natCast_mul]
    congr 1
    push_cast
    ring
  simp only [modularLambda_def, hexp]
  field_simp

/-- `λ(τ) → 0` as `Im τ → ∞`: the cusp `i∞` of `Γ(2)` is a zero of `λ`. -/
theorem tendsto_modularLambda : Tendsto modularLambda (comap im atTop) (𝓝 0) := by
  have hq : Tendsto (fun τ : ℂ ↦ cexp (π * I * τ)) (comap im atTop) (𝓝 0) := by
    refine ((Function.Periodic.qParam_tendsto two_pos).mono_right nhdsWithin_le_nhds).congr
      fun τ ↦ ?_
    simp only [Function.Periodic.qParam]
    congr 1
    push_cast
    ring
  have := tendsto_modularLambda_div_exp.mul hq
  rw [mul_zero] at this
  refine this.congr fun τ ↦ ?_
  rw [div_mul_cancel₀ _ (Complex.exp_ne_zero _)]

/-! ### Transformation laws -/

/-- **The translation law** `λ(τ + 2) = λ(τ)`, valid on all of `ℂ`. -/
@[simp]
theorem modularLambda_add_two (τ : ℂ) : modularLambda (τ + 2) = modularLambda τ := by
  -- With `ζ = e^{π i / 12}`, `η(z + n) = ζⁿ η(z)` (`eta_add_intCast`).
  have h (z : ℂ) (n : ℕ) : η (z + n) = cexp (π * I / 12) ^ n * η z := by
    rw [← Complex.exp_natCast_mul, ← Int.cast_natCast, eta_add_intCast]
    congr 2
    push_cast
    ring
  have h₁ : η ((τ + 2) / 2) = cexp (π * I / 12) * η (τ / 2) := by
    simpa [add_div] using h (τ / 2) 1
  have h₂ : η (2 * (τ + 2)) = cexp (π * I / 12) ^ 4 * η (2 * τ) := by
    simpa [mul_add, show (2 : ℂ) * 2 = (4 : ℕ) by norm_num] using h (2 * τ) 4
  have h₃ : η (τ + 2) = cexp (π * I / 12) ^ 2 * η τ := by simpa using h τ 2
  have hζ : cexp (π * I / 12) ^ 24 = 1 := by
    rw [← Complex.exp_natCast_mul,
      show ((24 : ℕ) : ℂ) * (π * I / 12) = 2 * π * I by push_cast; ring, Complex.exp_two_pi_mul_I]
  rw [modularLambda_def, modularLambda_def, h₁, h₂, h₃]
  -- The eta factors pick up `ζ ζ⁸ / ζ⁶ = ζ³`, whose eighth power is `ζ²⁴ = 1`.
  calc 16 * (cexp (π * I / 12) * η (τ / 2) * (cexp (π * I / 12) ^ 4 * η (2 * τ)) ^ 2 /
          (cexp (π * I / 12) ^ 2 * η τ) ^ 3) ^ 8
      = (cexp (π * I / 12) ^ 24) ^ 3 * ((cexp (π * I / 12) ^ 24) ^ 2)⁻¹ *
          (16 * (η (τ / 2) * η (2 * τ) ^ 2 / η τ ^ 3) ^ 8) := by ring
    _ = _ := by rw [hζ]; ring

/-- `λ(-1/τ)` is the eta quotient `(η(τ/2)² η(2τ) / η(τ)³)⁸`, by the inversion law of `η`. -/
private theorem modularLambda_neg_one_div_eq_eta {τ : ℂ} (hτ : 0 < τ.im) :
    modularLambda (-1 / τ) = (η (τ / 2) ^ 2 * η (2 * τ) / η τ ^ 3) ^ 8 := by
  have hτ0 : τ ≠ 0 := UpperHalfPlane.ne_zero ⟨τ, hτ⟩
  have hη := _root_.ModularForm.eta_ne_zero hτ
  have hA := eta_neg_one_div_sq (im_two_mul_pos hτ)
  have hB := eta_neg_one_div_sq (im_div_two_pos hτ)
  have hC := eta_neg_one_div_sq hτ
  have e₁ : -1 / τ / 2 = -1 / (2 * τ) := by rw [div_div, mul_comm]
  have e₂ : 2 * (-1 / τ) = -1 / (τ / 2) := by field_simp
  -- `λ` is a polynomial in the squares of its three eta values.
  have hsq : ∀ z, modularLambda z =
      16 * (η (z / 2) ^ 2) ^ 4 * (η (2 * z) ^ 2) ^ 8 / (η z ^ 2) ^ 12 := fun z ↦ by
    rw [modularLambda_def]
    ring
  rw [hsq, e₁, e₂, hA, hB, hC]
  field_simp
  ring

/-- In terms of the fourth powers `a = g₀⁴`, `b = g₁⁴` of the level-two Siegel functions
`g₀ = g_{(0, 1/2)} = 2 i (η(2τ)/η(τ))²` and `g₁ = g_{(1/2, 0)} = -(η(τ/2)/η(τ))²`,
`λ = a² b / 16` and `λ(-1/τ) = a b² / 16`. -/
private theorem modularLambda_eq_siegelFunction {τ : ℂ} (hτ : 0 < τ.im) :
    modularLambda τ = (siegelFunction ![0, 1 / 2] τ ^ 4) ^ 2 * siegelFunction ![1 / 2, 0] τ ^ 4 /
        16 ∧
      modularLambda (-1 / τ) =
        siegelFunction ![0, 1 / 2] τ ^ 4 * (siegelFunction ![1 / 2, 0] τ ^ 4) ^ 2 / 16 := by
  have hη := _root_.ModularForm.eta_ne_zero hτ
  have h₀ : siegelFunction ![0, 1 / 2] τ ^ 4 = 16 * (η (2 * τ) / η τ) ^ 8 := by
    rw [siegelFunction_zero_half_eq_eta hτ, mul_pow, mul_pow, I_pow_four]
    ring
  have h₁ : siegelFunction ![1 / 2, 0] τ ^ 4 = (η (τ / 2) / η τ) ^ 8 := by
    rw [siegelFunction_half_zero_eq_eta hτ]
    ring
  rw [modularLambda_neg_one_div_eq_eta hτ, modularLambda_def, h₀, h₁]
  constructor <;> field_simp

/-- **The inversion law** `λ(-1/τ) = 1 - λ(τ)` on the upper half-plane. It amounts to Weber's
identity `g₀⁴ + g₁⁴ + g₂⁴ = 0` for the level-two Siegel functions, the classical `𝔣₁⁸ + 𝔣₂⁸ = 𝔣⁸`
or Jacobi's `θ₃⁴ = θ₂⁴ + θ₄⁴`. -/
theorem modularLambda_neg_one_div {τ : ℂ} (hτ : 0 < τ.im) :
    modularLambda (-1 / τ) = 1 - modularLambda τ := by
  obtain ⟨hL, hLS⟩ := modularLambda_eq_siegelFunction hτ
  have hW := siegelFunction_pow_four_add_add ⟨τ, hτ⟩
  have hP := siegelFunction_pow_four_mul_mul ⟨τ, hτ⟩
  rw [UpperHalfPlane.coe_mk] at hW hP
  rw [hL, hLS]
  linear_combination (siegelFunction ![0, 1 / 2] τ ^ 4 * siegelFunction ![1 / 2, 0] τ ^ 4 / 16) *
    hW - hP / 16

/-- `λ` takes no value `1` on the upper half-plane. -/
theorem modularLambda_ne_one {τ : ℂ} (hτ : 0 < τ.im) : modularLambda τ ≠ 1 := fun h ↦
  modularLambda_ne_zero (im_neg_one_div_pos hτ) (by rw [modularLambda_neg_one_div hτ, h, sub_self])

/-- `λ(i) = 1/2`: the point `i` is fixed by `τ ↦ -1/τ`, which carries `λ` to `1 - λ`. -/
@[simp]
theorem modularLambda_I : modularLambda I = 1 / 2 := by
  have h := modularLambda_neg_one_div (τ := I) (by simp)
  rw [div_I, neg_mul, one_mul, neg_neg] at h
  linear_combination h / 2

/-- **The translation law** `λ(τ + 1) = λ(τ) / (λ(τ) - 1)` on the upper half-plane. -/
theorem modularLambda_add_one {τ : ℂ} (hτ : 0 < τ.im) :
    modularLambda (τ + 1) = modularLambda τ / (modularLambda τ - 1) := by
  have hτ₁ : 0 < (τ + 1).im := by simpa using hτ
  have hne : modularLambda τ - 1 ≠ 0 := sub_ne_zero.2 (modularLambda_ne_one hτ)
  have hW := siegelFunction_pow_four_add_add ⟨τ, hτ⟩
  have hP := siegelFunction_pow_four_mul_mul ⟨τ, hτ⟩
  rw [UpperHalfPlane.coe_mk] at hW hP
  -- Under `τ ↦ τ + 1`, `g₀ ↦ ζ g₀` and `g₁ ↦ ζ g₂` with `ζ = e^{π i / 6}`, and `ζ¹² = 1`.
  rw [eq_div_iff hne, (modularLambda_eq_siegelFunction hτ₁).1,
    (modularLambda_eq_siegelFunction hτ).1, siegelFunction_zero_half_apply_add_one,
    siegelFunction_half_zero_apply_add_one]
  set x := siegelFunction ![0, 1 / 2] τ
  set y := siegelFunction ![1 / 2, 0] τ
  set z := siegelFunction ![1 / 2, 1 / 2] τ
  linear_combination (x ^ 4) ^ 2 * z ^ 4 * ((x ^ 4) ^ 2 * y ^ 4 - 16) / 256 *
    exp_pi_mul_I_div_six_pow_twelve + x ^ 12 / 256 * hP - x ^ 8 / 16 * hW

/-! ### Invariance under `Γ(2)` -/

/-- **`λ` is invariant under `Γ(2)`**: `λ(γ τ) = λ(τ)` for `γ ∈ Γ(2)` and `τ` in the upper
half-plane. -/
theorem modularLambda_smul {γ : SL(2, ℤ)} (hγ : γ ∈ CongruenceSubgroup.Gamma 2) (τ : ℍ) :
    modularLambda (γ • τ : ℍ) = modularLambda τ := by
  have hS (σ : ℍ) : modularLambda (S • σ : ℍ) = 1 - modularLambda σ := by
    rw [ModularGroup.coe_S_smul, modularLambda_neg_one_div σ.im_pos]
  rw [CongruenceSubgroup.Gamma_two_eq_closure] at hγ
  induction hγ using Subgroup.closure_induction generalizing τ with
  | one => rw [one_smul]
  | mem g hg =>
    rcases hg with rfl | rfl | rfl
    · rw [ModularGroup.SL_neg_smul, one_smul]
    · rw [← zpow_natCast, coe_T_zpow_smul_eq]
      exact_mod_cast modularLambda_add_two τ
    · -- `T′² = S T⁻² S⁻¹`, and `S` carries `λ` to `1 - λ`.
      obtain ⟨σ, rfl⟩ : ∃ σ : ℍ, τ = S • σ := ⟨S⁻¹ • τ, (smul_inv_smul S τ).symm⟩
      have h := modularLambda_add_two ((σ : ℂ) + ((-2 : ℤ) : ℂ))
      rw [show (σ : ℂ) + ((-2 : ℤ) : ℂ) + 2 = σ by push_cast; ring] at h
      rw [TauCeti.ModularGroup.tPrime_sq_eq, mul_smul, mul_smul, inv_smul_smul, hS, hS,
        coe_T_zpow_smul_eq, ← h]
  | mul g h _ _ hg hh => rw [mul_smul, hg, hh]
  | inv g _ hg => rw [← hg, smul_inv_smul]

/-- **`λ` is invariant under `Γ(2)`** in the weight-`0` slash action. -/
theorem modularLambda_slash {γ : SL(2, ℤ)} (hγ : γ ∈ CongruenceSubgroup.Gamma 2) :
    (fun τ : ℍ ↦ modularLambda τ) ∣[(0 : ℤ)] γ = fun τ : ℍ ↦ modularLambda τ := by
  ext τ
  rw [_root_.ModularForm.SL_slash_apply, neg_zero, zpow_zero, mul_one, modularLambda_smul hγ]

end TauCeti.ModularForm
