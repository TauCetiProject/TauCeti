module

public import TauCeti.LinearAlgebra.Dual.FiniteAlgebra
public import TauCeti.NumberTheory.ModularForms.ModularSymbols.Period.Hecke
public import TauCeti.NumberTheory.ModularForms.ModularSymbols.Period.Injective
public import Mathlib.RingTheory.IntegralClosure.Algebra.Basic

/-!
# Finiteness of the integral algebra generated by the cusp-form Hecke operators

The `ℤ`-algebra generated by all positive-index `Tₙ` on `S_k(Γ₁(N))` is a finite `ℤ`-module
when `k ≥ 2`. Consequently each of these operators is integral over `ℤ`, including the
operators at primes dividing the level.

The integral object is the finite module of modular symbols, paired with cusp forms through
the injective period map. The free-algebra transfer evaluates the symbol operators in the
opposite endomorphism ring, accounting for the order reversal under precomposition. No
commutativity of the operators and no lattice inside the space of cusp forms are needed.

The algebra here is generated by the `Tₙ` alone. Diamond operators are not included in its
definition.

## References

* [G. Shimura, *Introduction to the arithmetic theory of automorphic functions*][shimura1971],
  Chapter 3, especially Theorems 3.48 and 3.51.
* [T. Miyake, *Modular forms*][miyake1989], Section 4.5.
-/

public noncomputable section

open Matrix.SpecialLinearGroup CongruenceSubgroup HeckeRing.GL2
open scoped MatrixGroups

namespace TauCeti

variable (N : ℕ) [NeZero N] (k : ℤ)

private def heckeTCuspPos (n : ℕ+) :
    Module.End ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k) := by
  letI : NeZero (n : ℕ) := ⟨n.ne_zero⟩
  exact heckeTCuspNat k n

/-- The integral algebra of endomorphisms of `S_k(Γ₁(N))` generated by the Hecke operators
`Tₙ` at every positive index, including indices sharing prime factors with the level. -/
def heckeTCuspAlgebra :
    Subalgebra ℤ (Module.End ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k)) :=
  Algebra.adjoin ℤ (Set.range (heckeTCuspPos N k))

/-- The defining generators of the integral cusp-form Hecke algebra. -/
theorem heckeTCuspAlgebra_def :
    heckeTCuspAlgebra N k =
      Algebra.adjoin ℤ (Set.range fun n : ℕ+ ↦
        @heckeTCuspNat N _ k (n : ℕ) ⟨n.ne_zero⟩) := (rfl)

/-- Each positive-index Hecke operator belongs to the integral cusp-form Hecke algebra. -/
@[simp]
theorem heckeTCuspNat_mem_heckeTCuspAlgebra (n : ℕ) [NeZero n] :
    heckeTCuspNat (N := N) k n ∈ heckeTCuspAlgebra N k :=
  Algebra.subset_adjoin ⟨⟨n, NeZero.pos n⟩, rfl⟩

/-- An integral subalgebra contains the cusp-form Hecke algebra exactly when it contains
`Tₙ` at every positive index. -/
theorem heckeTCuspAlgebra_le_iff
    (A : Subalgebra ℤ (Module.End ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k))) :
    heckeTCuspAlgebra N k ≤ A ↔
      ∀ (n : ℕ) [NeZero n], heckeTCuspNat (N := N) k n ∈ A := by
  constructor
  · intro h n _
    exact h (heckeTCuspNat_mem_heckeTCuspAlgebra N k n)
  · intro h
    apply Algebra.adjoin_le
    rintro _ ⟨n, rfl⟩
    exact @h (n : ℕ) ⟨n.ne_zero⟩

/-- The integral algebra of endomorphisms of `S_k(Γ₁(N))` generated by the prime-index Hecke
operators `Tₚ`. -/
def heckeTCuspPrimeAlgebra :
    Subalgebra ℤ (Module.End ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k)) :=
  Algebra.adjoin ℤ (Set.range fun p : {p : ℕ // p.Prime} ↦
    @heckeTCuspNat N _ k (p : ℕ) ⟨p.2.ne_zero⟩)

/-- The defining generators of the prime-index cusp-form Hecke algebra. -/
theorem heckeTCuspPrimeAlgebra_def :
    heckeTCuspPrimeAlgebra N k =
      Algebra.adjoin ℤ (Set.range fun p : {p : ℕ // p.Prime} ↦
        @heckeTCuspNat N _ k (p : ℕ) ⟨p.2.ne_zero⟩) := (rfl)

/-- Every prime-index Hecke operator belongs to the prime-index cusp-form Hecke algebra. -/
@[simp]
theorem heckeTCuspNat_mem_heckeTCuspPrimeAlgebra {p : ℕ} (hp : p.Prime) :
    @heckeTCuspNat N _ k p ⟨hp.ne_zero⟩ ∈ heckeTCuspPrimeAlgebra N k :=
  Algebra.subset_adjoin ⟨⟨p, hp⟩, rfl⟩

/-- An integral subalgebra contains the prime-index cusp-form Hecke algebra exactly when it
contains `Tₚ` at every prime. -/
theorem heckeTCuspPrimeAlgebra_le_iff
    (A : Subalgebra ℤ (Module.End ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k))) :
    heckeTCuspPrimeAlgebra N k ≤ A ↔
      ∀ (p : ℕ) (hp : p.Prime), @heckeTCuspNat N _ k p ⟨hp.ne_zero⟩ ∈ A := by
  constructor
  · intro h p hp
    exact h (heckeTCuspNat_mem_heckeTCuspPrimeAlgebra N k hp)
  · intro h
    apply Algebra.adjoin_le
    rintro _ ⟨p, rfl⟩
    exact h p p.2

/-- The prime-index cusp-form Hecke algebra is contained in the cusp-form Hecke algebra. -/
theorem heckeTCuspPrimeAlgebra_le_heckeTCuspAlgebra :
    heckeTCuspPrimeAlgebra N k ≤ heckeTCuspAlgebra N k :=
  (heckeTCuspPrimeAlgebra_le_iff N k _).mpr fun p hp ↦
    @heckeTCuspNat_mem_heckeTCuspAlgebra N _ k p ⟨hp.ne_zero⟩

/-- The integral algebra generated by all `Tₙ` on cusp forms is a finite `ℤ`-module in
weight at least two. This includes every bad-prime operator. -/
theorem heckeTCuspAlgebra_finite (hk : 2 ≤ k) : Module.Finite ℤ (heckeTCuspAlgebra N k) := by
  let w := (k - 2).toNat
  have hw : k = (w : ℤ) + 2 := by omega
  let u : ℕ+ → Module.End ℤ (ModularSymbols ℤ (Gamma1 N) w) := fun n ↦ by
    letI : NeZero (n : ℕ) := ⟨n.ne_zero⟩
    exact ModularSymbols.heckeTSymbol ℤ w N n
  apply LinearMap.finite_adjoin_of_injective_pairing
    ((ModularSymbols.periodMap ℤ (Gamma1 N) hw).restrictScalars ℤ)
    (ModularSymbols.periodMap_injective hw) (heckeTCuspPos N k) u
  intro n f x
  let : NeZero (n : ℕ) := ⟨n.ne_zero⟩
  exact LinearMap.congr_fun (ModularSymbols.periodMap_heckeTCuspNat N (n : ℕ) hw f) x

/-- The integral algebra generated by the prime-index Hecke operators on cusp forms is a finite
`ℤ`-module in weight at least two. -/
theorem heckeTCuspPrimeAlgebra_finite (hk : 2 ≤ k) :
    Module.Finite ℤ (heckeTCuspPrimeAlgebra N k) := by
  have := heckeTCuspAlgebra_finite N k hk
  have hle := heckeTCuspPrimeAlgebra_le_heckeTCuspAlgebra N k
  exact Module.Finite.of_injective (Subalgebra.inclusion hle).toLinearMap
    (Subalgebra.inclusion_injective hle)

/-- Every operator in the integral cusp-form Hecke algebra is integral over `ℤ`. -/
theorem isIntegral_of_mem_heckeTCuspAlgebra (hk : 2 ≤ k)
    {T : Module.End ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k)}
    (hT : T ∈ heckeTCuspAlgebra N k) : IsIntegral ℤ T := by
  have := heckeTCuspAlgebra_finite N k hk
  exact (IsIntegral.of_finite ℤ (⟨T, hT⟩ : heckeTCuspAlgebra N k)).map
    (heckeTCuspAlgebra N k).val

/-- Each positive-index `Tₙ` acting on cusp forms of weight at least two is integral over `ℤ`.
At a prime dividing the level this asserts integrality of `Uₚ = Tₚ`. -/
theorem isIntegral_heckeTCuspNat (hk : 2 ≤ k) (n : ℕ) [NeZero n] :
    IsIntegral ℤ (heckeTCuspNat (N := N) k n) :=
  isIntegral_of_mem_heckeTCuspAlgebra N k hk (heckeTCuspNat_mem_heckeTCuspAlgebra N k n)

end TauCeti
