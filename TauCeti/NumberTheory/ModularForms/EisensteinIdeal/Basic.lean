module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic

/-!
# Eisenstein ideals of systems of Hecke eigenvalues

Given operators `t i` in a commutative cuspidal Hecke algebra `T` over `R` and Eisenstein
eigenvalues `a i : R`, the Eisenstein ideal is generated by `t i - algebraMap R T (a i)`.
Its contraction to `R` is the coefficient Eisenstein ideal. The values `a i` may come from
a character on a larger Hecke algebra acting on a space containing the Eisenstein series.

When the operators generate `T` over `R`, the cuspidal Eisenstein quotient is canonically
the quotient by the coefficient Eisenstein ideal. Over local `R`, properness then characterizes
the existence of a residue-field eigensystem with the prescribed eigenvalues.

## References

* C. Skinner and E. Urban, *The Iwasawa Main Conjectures for GL₂*, §6.5.3,
  <https://www.math.columbia.edu/~urban/eurp/MC.pdf>.
* O. Fouquet and X. Wan, *The Iwasawa Main Conjecture for universal families of modular motives*,
  Definition 7.30, <https://arxiv.org/abs/2107.13726v3>.
-/

public section

namespace TauCeti

variable {R T : Type*} [CommRing R] [CommRing T] [Algebra R T]
  {ι : Type*} (t : ι → T) (a : ι → R)

/-- The Eisenstein ideal in the cuspidal algebra, generated by operator minus eigenvalue. -/
def eisensteinIdeal : Ideal T :=
  Ideal.span (Set.range fun i ↦ t i - algebraMap R T (a i))

/-- The generator description of the Eisenstein ideal. -/
theorem eisensteinIdeal_def :
    eisensteinIdeal t a = Ideal.span (Set.range fun i ↦ t i - algebraMap R T (a i)) :=
  (rfl)

/-- The coefficient Eisenstein ideal is the kernel of the scalar map to the cuspidal quotient,
equivalently the contraction of the cuspidal Eisenstein ideal. -/
def coefficientEisensteinIdeal : Ideal R :=
  RingHom.ker (algebraMap R (T ⧸ eisensteinIdeal t a))

/-- The coefficient Eisenstein ideal is the kernel of the scalar map into the cuspidal quotient. -/
theorem coefficientEisensteinIdeal_eq_ker :
    coefficientEisensteinIdeal t a = RingHom.ker (algebraMap R (T ⧸ eisensteinIdeal t a)) :=
  (rfl)

/-- A coefficient belongs to the Eisenstein ideal when its image is in the cuspidal ideal. -/
@[simp]
theorem mem_coefficientEisensteinIdeal_iff {r : R} :
    r ∈ coefficientEisensteinIdeal t a ↔ algebraMap R T r ∈ eisensteinIdeal t a := by
  rw [coefficientEisensteinIdeal_eq_ker, RingHom.mem_ker,
    ← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq_zero_iff_mem]

/-- The coefficient Eisenstein ideal equals the contraction of the cuspidal Eisenstein ideal. -/
theorem coefficientEisensteinIdeal_eq_comap :
    coefficientEisensteinIdeal t a = (eisensteinIdeal t a).comap (algebraMap R T) := by
  ext r
  rw [mem_coefficientEisensteinIdeal_iff, Ideal.mem_comap]

/-- An ideal contains the Eisenstein ideal exactly when it contains every operator difference. -/
theorem eisensteinIdeal_le_iff {J : Ideal T} :
    eisensteinIdeal t a ≤ J ↔ ∀ i, t i - algebraMap R T (a i) ∈ J := by
  simp only [eisensteinIdeal_def, Ideal.span_le, Set.range_subset_iff, SetLike.mem_coe]

/-- The operator differences belong to the Eisenstein ideal. -/
theorem sub_algebraMap_mem_eisensteinIdeal (i : ι) :
    t i - algebraMap R T (a i) ∈ eisensteinIdeal t a :=
  (eisensteinIdeal_le_iff t a).mp le_rfl i

/-- Each operator is equal to its prescribed scalar in the Eisenstein quotient. -/
@[simp]
theorem quotient_mk_eisensteinIdeal (i : ι) :
    Ideal.Quotient.mk (eisensteinIdeal t a) (t i) =
      algebraMap R (T ⧸ eisensteinIdeal t a) (a i) := by
  rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq]
  exact sub_algebraMap_mem_eisensteinIdeal t a i

/-- An algebra homomorphism kills the Eisenstein ideal iff it takes the prescribed values. -/
theorem eisensteinIdeal_le_ker_iff {B : Type*} [Ring B] [Algebra R B] (f : T →ₐ[R] B) :
    eisensteinIdeal t a ≤ RingHom.ker f ↔ ∀ i, f (t i) = algebraMap R B (a i) := by
  rw [eisensteinIdeal_le_iff]
  simp only [RingHom.mem_ker, map_sub, AlgHom.commutes, sub_eq_zero]

/-- The coefficient Eisenstein ideal is proper exactly when the cuspidal ideal is proper. -/
@[simp]
theorem coefficientEisensteinIdeal_eq_top_iff :
    coefficientEisensteinIdeal t a = ⊤ ↔ eisensteinIdeal t a = ⊤ := by
  rw [coefficientEisensteinIdeal_eq_comap, Ideal.comap_eq_top_iff]

/-- Adding operators with compatible values enlarges the Eisenstein ideal. -/
theorem eisensteinIdeal_le_of_reindex {κ : Type*} {u : κ → T} {b : κ → R} (f : ι → κ)
    (ht : ∀ i, u (f i) = t i) (ha : ∀ i, b (f i) = a i) :
    eisensteinIdeal t a ≤ eisensteinIdeal u b := by
  refine (eisensteinIdeal_le_iff t a).mpr fun i ↦ ?_
  simpa only [ht, ha] using sub_algebraMap_mem_eisensteinIdeal u b (f i)

/-- When the prescribed operators generate the algebra, the Eisenstein quotient is generated
by scalars alone. -/
theorem algebraMap_eisensteinQuotient_surjective (hgen : Algebra.adjoin R (Set.range t) = ⊤) :
    Function.Surjective (algebraMap R (T ⧸ eisensteinIdeal t a)) := by
  intro y
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
  let q := Ideal.Quotient.mkₐ R (eisensteinIdeal t a)
  let S := (Algebra.ofId R (T ⧸ eisensteinIdeal t a)).range
  have h : Algebra.adjoin R (Set.range t) ≤ S.comap q := by
    apply Algebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    exact ⟨a i, (quotient_mk_eisensteinIdeal t a i).symm⟩
  have hx : x ∈ Algebra.adjoin R (Set.range t) := by rw [hgen]; trivial
  exact h hx

/-- The coefficient quotient maps isomorphically onto the cuspidal Eisenstein quotient
when the specified operators generate the cuspidal algebra. -/
noncomputable def coefficientEisensteinQuotientEquiv
    (hgen : Algebra.adjoin R (Set.range t) = ⊤) :
    (R ⧸ coefficientEisensteinIdeal t a) ≃ₐ[R] (T ⧸ eisensteinIdeal t a) :=
  Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId R (T ⧸ eisensteinIdeal t a))
    (algebraMap_eisensteinQuotient_surjective t a hgen)

/-- The Eisenstein quotient equivalence takes a coefficient class to that same scalar
in the cuspidal quotient. -/
@[simp]
theorem coefficientEisensteinQuotientEquiv_mk
    (hgen : Algebra.adjoin R (Set.range t) = ⊤) (r : R) :
    coefficientEisensteinQuotientEquiv t a hgen (Ideal.Quotient.mk _ r) =
      algebraMap R (T ⧸ eisensteinIdeal t a) r := by
  unfold coefficientEisensteinQuotientEquiv
  exact Ideal.quotientKerAlgEquivOfSurjective_mk _ r

/-- A scalar-valued Hecke character has kernel generated by its differences on any algebra
generating family. This applies on the algebra acting on the space containing the Eisenstein
family, before taking the image ideal in the cuspidal algebra. -/
theorem eisensteinIdeal_eq_ker (f : T →ₐ[R] R)
    (hgen : Algebra.adjoin R (Set.range t) = ⊤) :
    eisensteinIdeal t (f ∘ t) = RingHom.ker f := by
  have hk : eisensteinIdeal t (f ∘ t) ≤ RingHom.ker f :=
    (eisensteinIdeal_le_ker_iff t (f ∘ t) f).mpr fun i ↦ by simp
  refine hk.antisymm fun x hx ↦ ?_
  let ψ := Ideal.Quotient.liftₐ (eisensteinIdeal t (f ∘ t)) f hk
  obtain ⟨r, hr⟩ := algebraMap_eisensteinQuotient_surjective t (f ∘ t) hgen
    (Ideal.Quotient.mk _ x)
  have hψ : ψ (Ideal.Quotient.mk _ x) = f x := Ideal.Quotient.lift_mk _ _ _
  have hr0 : r = 0 := by
    have hfx : f x = 0 := RingHom.mem_ker.mp hx
    simpa only [AlgHom.commutes, Algebra.algebraMap_self_apply, hψ, hfx] using congrArg ψ hr
  exact Ideal.Quotient.eq_zero_iff_mem.mp (by simpa only [hr0, map_zero] using hr.symm)

/-- Over local coefficients, a proper Eisenstein ideal is equivalent to the existence of a
unique residue-field character taking the prescribed values on the generating operators. -/
theorem eisensteinIdeal_ne_top_iff_existsUnique_residueCharacter [IsLocalRing R]
    (hgen : Algebra.adjoin R (Set.range t) = ⊤) :
    eisensteinIdeal t a ≠ ⊤ ↔
      ∃! f : T →ₐ[R] IsLocalRing.ResidueField R,
        ∀ i, f (t i) = IsLocalRing.residue R (a i) := by
  constructor
  · intro h
    have hmax : coefficientEisensteinIdeal t a ≤ IsLocalRing.maximalIdeal R :=
      IsLocalRing.le_maximalIdeal (fun he ↦ h ((coefficientEisensteinIdeal_eq_top_iff t a).mp he))
    let ψ : (T ⧸ eisensteinIdeal t a) →ₐ[R] IsLocalRing.ResidueField R :=
      (Ideal.Quotient.factorₐ R hmax).comp
        (coefficientEisensteinQuotientEquiv t a hgen).symm.toAlgHom
    let f : T →ₐ[R] IsLocalRing.ResidueField R :=
      ψ.comp (Ideal.Quotient.mkₐ R (eisensteinIdeal t a))
    have hf (i : ι) : f (t i) = IsLocalRing.residue R (a i) := by
      simp only [f, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, quotient_mk_eisensteinIdeal]
      exact ψ.commutes (a i)
    refine ⟨f, hf, fun g hg ↦ AlgHom.ext_of_adjoin_eq_top hgen ?_⟩
    rintro _ ⟨i, rfl⟩
    rw [hg i, hf i]
  · rintro ⟨f, hf, _⟩ h
    have hker := (eisensteinIdeal_le_ker_iff t a f).mpr hf
    exact RingHom.ker_ne_top f (top_le_iff.mp (h ▸ hker))

/-- A proper Eisenstein ideal with local coefficients and a generating operator family is
contained in a unique maximal ideal of the cuspidal algebra. -/
theorem existsUnique_isMaximal_over_eisensteinIdeal [IsLocalRing R]
    (hgen : Algebra.adjoin R (Set.range t) = ⊤) (h : eisensteinIdeal t a ≠ ⊤) :
    ∃! m : Ideal T, m.IsMaximal ∧ eisensteinIdeal t a ≤ m := by
  let J := eisensteinIdeal t a
  let q := Ideal.Quotient.mk J
  let : Nontrivial (T ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr h
  let : IsLocalRing (T ⧸ J) := IsLocalRing.of_surjective' (algebraMap R (T ⧸ J))
    (algebraMap_eisensteinQuotient_surjective t a hgen)
  have hq : Function.Surjective q := Ideal.Quotient.mk_surjective
  have hker : RingHom.ker q = J := Ideal.mk_ker
  refine ⟨(IsLocalRing.maximalIdeal (T ⧸ J)).comap q,
    ⟨Ideal.comap_isMaximal_of_surjective q hq, ?_⟩, ?_⟩
  · refine hker.ge.trans ?_
    rw [RingHom.ker_eq_comap_bot]
    exact Ideal.comap_mono bot_le
  · rintro m ⟨hm, hJm⟩
    let : m.IsMaximal := hm
    have hkm : RingHom.ker q ≤ m := hker.trans_le hJm
    have hm' := Ideal.IsMaximal.map_of_surjective_of_ker_le hq hkm
    rw [← IsLocalRing.eq_maximalIdeal hm', Ideal.comap_map_of_surjective _ hq,
      ← RingHom.ker_eq_comap_bot, sup_eq_left.mpr hkm]

section Map

variable {S U : Type*} [CommRing S] [CommRing U] [Algebra S U]

/-- A commuting coefficient and Hecke algebra square transports the ideal of operator
differences to the ideal of the transported operators and eigenvalues. -/
theorem map_eisensteinIdeal (g : R →+* S) (f : T →+* U)
    (h : f.comp (algebraMap R T) = (algebraMap S U).comp g) :
    (eisensteinIdeal t a).map f = eisensteinIdeal (f ∘ t) (g ∘ a) := by
  simp only [eisensteinIdeal_def, Ideal.map_span, ← Set.range_comp, Function.comp_def, map_sub]
  congr 2
  funext i
  rw [← RingHom.comp_apply, h, RingHom.comp_apply]

/-- Along a commuting square, the extended coefficient Eisenstein ideal is contained in
the coefficient Eisenstein ideal of the transported system. -/
theorem map_coefficientEisensteinIdeal_le (g : R →+* S) (f : T →+* U)
    (h : f.comp (algebraMap R T) = (algebraMap S U).comp g) :
    (coefficientEisensteinIdeal t a).map g ≤ coefficientEisensteinIdeal (f ∘ t) (g ∘ a) := by
  apply Ideal.map_le_iff_le_comap.mpr
  intro r hr
  rw [Ideal.mem_comap, mem_coefficientEisensteinIdeal_iff, ← RingHom.comp_apply, ← h,
    RingHom.comp_apply, ← map_eisensteinIdeal t a g f h]
  exact Ideal.mem_map_of_mem f ((mem_coefficientEisensteinIdeal_iff t a).mp hr)

end Map

end TauCeti
