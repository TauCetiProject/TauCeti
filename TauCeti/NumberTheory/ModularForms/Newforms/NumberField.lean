/-!
# The coefficient field of a newform is a number field

For a newform `f` of weight `k ≥ 2`, every Fourier coefficient `a_n(f)` is an algebraic integer,
and the coefficient field `ℚ(a_n(f) : n ≥ 1)` is a number field.

The integral input is the finiteness over `ℤ` of the algebra generated by the Hecke operators
on `S_k(Γ₁(N))`. A newform is an eigenvector of `T_p` with eigenvalue `a_p` at every prime `p`,
the primes dividing the level included, so it is a joint eigenvector of the `ℤ`-algebra
generated by the prime-index operators. Its eigenvalues form a ring homomorphism from that
algebra to `ℂ`. The image is a finitely generated `ℤ`-module of algebraic integers containing
every `a_p`. The coefficients at the other indices are reached through the Hecke recurrences
from the `a_p` and the nebentypus values, which are roots of unity.

Weight one is not covered: the finiteness of the Hecke algebra comes from modular symbols, which
carry the weight-`k` coefficient system `Sym^{k−2}` and so exist only in weight at least two.

## Main results

* `HeckeRing.GL2.Newform.isIntegral_qExpansion_coeff`: the Fourier coefficients of a newform of
  weight at least two are algebraic integers.
* `TauCeti.numberField_CoefficientField`: the coefficient field of a newform of weight at least
  two is a number field.

## Provenance

The same statements are proved in the AINTLIB `LeanModularForms` project (Chris Birkbeck,
Apache-2.0, <https://github.com/CBirkbeck/AINTLIB>),
`projects/LeanModularForms/LeanModularForms/Labels/NewformOrbit.lean`, as `coeffSeq_isIntegral`
and `coeffField_numberField_of_two_le`, by the same route through the eigenvalue homomorphism
of a `ℤ`-finite Hecke algebra.

## References

* [G. Shimura, *Introduction to the arithmetic theory of automorphic functions*][shimura1971],
  Chapter 3.
* [T. Miyake, *Modular forms*][miyake1989], Section 4.5.
-/

public section

noncomputable section

open Matrix.SpecialLinearGroup UpperHalfPlane CongruenceSubgroup HeckeRing.GL2

open scoped MatrixGroups

namespace TauCeti

variable {N : ℕ} [NeZero N] {k : ℤ}

/-- The integral algebra generated by the prime-index Hecke operators on `S_k(Γ₁(N))`. -/
private def primeHeckeAlgebra (N : ℕ) [NeZero N] (k : ℤ) :
    Subalgebra ℤ (Module.End ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k)) :=
  Algebra.adjoin ℤ (Set.range fun p : {p : ℕ // p.Prime} ↦
    @heckeTCuspNat N _ k (p : ℕ) ⟨p.2.ne_zero⟩)

private theorem heckeTCuspNat_mem_primeHeckeAlgebra {p : ℕ} (hp : p.Prime) :
    @heckeTCuspNat N _ k p ⟨hp.ne_zero⟩ ∈ primeHeckeAlgebra N k :=
  Algebra.subset_adjoin ⟨⟨p, hp⟩, rfl⟩

private theorem primeHeckeAlgebra_finite (hk : 2 ≤ k) :
    Module.Finite ℤ (primeHeckeAlgebra N k) := by
  have := heckeTCuspAlgebra_finite N k hk
  have hle : primeHeckeAlgebra N k ≤ heckeTCuspAlgebra N k := by
    refine Algebra.adjoin_le ?_
    rintro _ ⟨p, rfl⟩
    exact @heckeTCuspNat_mem_heckeTCuspAlgebra N _ k p ⟨p.2.ne_zero⟩
  exact Module.Finite.of_injective (Subalgebra.inclusion hle).toLinearMap
    (Subalgebra.inclusion_injective hle)

private theorem qExpansion_coeff_one_smul (f : Newform N k) (c : ℂ) :
    (qExpansion 1 ⇑(c • f.toCuspForm)).coeff 1 = c := by
  rw [FunLike.coe_smul, ModularForm.qExpansion_smul one_pos
    (one_mem_strictPeriods_Gamma1_map N), PowerSeries.coeff_smul, f.isNorm, smul_eq_mul, mul_one]

/-- A newform is a joint eigenvector of the prime-index Hecke algebra, the eigenvalue of an
operator being the first Fourier coefficient of its image. -/
private theorem apply_eq_qExpansion_coeff_one_smul (f : Newform N k)
    (T : primeHeckeAlgebra N k) :
    T.1 f.toCuspForm = (qExpansion 1 (T.1 f.toCuspForm)).coeff 1 • f.toCuspForm := by
  obtain ⟨T, hT⟩ := T
  suffices ∃ c : ℂ, T f.toCuspForm = c • f.toCuspForm by
    obtain ⟨c, hc⟩ := this
    simp only [hc, qExpansion_coeff_one_smul]
  induction hT using Algebra.adjoin_induction with
  | mem T hT =>
      obtain ⟨⟨p, hp⟩, rfl⟩ := hT
      exact ⟨_, f.heckeTCuspNat_eq_qExpansion_coeff_smul hp⟩
  | algebraMap n =>
      exact ⟨n, by simpa using (Int.cast_smul_eq_zsmul ℂ n f.toCuspForm).symm⟩
  | add T S _ _ hT hS =>
      obtain ⟨c, hc⟩ := hT
      obtain ⟨d, hd⟩ := hS
      exact ⟨c + d, by rw [LinearMap.add_apply, hc, hd, add_smul]⟩
  | mul T S _ _ hT hS =>
      obtain ⟨c, hc⟩ := hT
      obtain ⟨d, hd⟩ := hS
      exact ⟨c * d, by rw [Module.End.mul_apply, hd, map_smul, hc, smul_smul, mul_comm]⟩

/-- The eigenvalue homomorphism of a newform on the prime-index Hecke algebra. -/
private def eigenvalueHom (f : Newform N k) : primeHeckeAlgebra N k →ₐ[ℤ] ℂ :=
  (primeHeckeAlgebra N k).val.eigenvalueHomOfJointEigenvector
    (fun T ↦ (qExpansion 1 (T.1 f.toCuspForm)).coeff 1) f.toCuspForm f.ne_zero fun T ↦
      Module.End.mem_eigenspace_iff.mpr (apply_eq_qExpansion_coeff_one_smul f T)

private theorem eigenvalueHom_heckeTCuspNat (f : Newform N k) {p : ℕ} (hp : p.Prime) :
    eigenvalueHom f ⟨_, heckeTCuspNat_mem_primeHeckeAlgebra hp⟩ =
      (qExpansion 1 f.toCuspForm).coeff p := by
  simp only [eigenvalueHom, AlgHom.eigenvalueHomOfJointEigenvector_apply]
  rw [f.heckeTCuspNat_eq_qExpansion_coeff_smul hp, qExpansion_coeff_one_smul]

private theorem isIntegral_char (f : Newform N k) (u : (ZMod N)ˣ) : IsIntegral ℤ (f.χ u : ℂ) := by
  have hfin : IsOfFinOrder ((f.χ u : ℂˣ) : ℂ) :=
    ((Units.coeHom ℂ).comp f.χ).isOfFinOrder (isOfFinOrder_of_finite u)
  exact (IsPrimitiveRoot.orderOf _).isIntegral hfin.orderOf_pos

/-- **The Fourier coefficients of a newform of weight at least two are algebraic integers.** -/
theorem _root_.HeckeRing.GL2.Newform.isIntegral_qExpansion_coeff (f : Newform N k)
    (hk : 2 ≤ k) (n : ℕ) : IsIntegral ℤ ((qExpansion 1 f.toCuspForm).coeff n) := by
  have := primeHeckeAlgebra_finite (N := N) hk
  have h₁ : (qExpansion 1 f.toEigenform.toCuspForm).coeff 1 = 1 := by
    rw [Newform.toEigenform_toCuspForm]
    exact f.isNorm
  have hn := f.toEigenform.qExpansion_coeff_mem_of_forall_prime h₁ (integralClosure ℤ ℂ)
    (fun p hp ↦ ?_) (fun p hp ↦ mul_mem ?_ ?_) n
  · simpa using (mem_integralClosure_iff ℤ ℂ).mp hn
  · rw [Newform.toEigenform_toCuspForm, mem_integralClosure_iff,
      ← eigenvalueHom_heckeTCuspNat f hp]
    exact (IsIntegral.of_finite ℤ _).map (eigenvalueHom f)
  · by_cases hu : IsUnit (p : ZMod N)
    · rw [Newform.toEigenform_χ, ← hu.unit_spec, MulChar.ofUnitHom_coe]
      exact isIntegral_char f _
    · rw [MulChar.map_nonunit _ hu]
      exact zero_mem _
  · obtain ⟨m, hm⟩ : ∃ m : ℕ, k - 1 = m := ⟨(k - 1).toNat, by omega⟩
    rw [hm, zpow_natCast]
    exact pow_mem (natCast_mem _ p) m

/-- **The coefficient field of a newform of weight at least two is a number field.** -/
theorem numberField_CoefficientField (f : Newform N k) (hk : 2 ≤ k) :
    NumberField (CoefficientField f) := by
  have := primeHeckeAlgebra_finite (N := N) hk
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := ℤ) (M := primeHeckeAlgebra N k)
  let S : Set ℂ := eigenvalueHom f '' s ∪ Set.range fun u : (ZMod N)ˣ ↦ (f.χ u : ℂ)
  have : Finite S := ((s.finite_toSet.image _).union (Set.finite_range _)).to_subtype
  have hS : ∀ x ∈ S, IsIntegral ℚ x := by
    rintro x (⟨T, -, rfl⟩ | ⟨u, rfl⟩)
    · exact ((IsIntegral.of_finite ℤ T).map (eigenvalueHom f)).tower_top
    · exact (isIntegral_char f u).tower_top
  have hle : CoefficientField f ≤ IntermediateField.adjoin ℚ S := by
    refine (CoefficientField_le_iff_forall_prime f _).mpr
      ⟨fun p hp ↦ ?_, fun u ↦ IntermediateField.subset_adjoin ℚ S (Or.inr ⟨u, rfl⟩)⟩
    rw [← eigenvalueHom_heckeTCuspNat f hp]
    suffices ∀ T ∈ Submodule.span ℤ (s : Set (primeHeckeAlgebra N k)),
        eigenvalueHom f T ∈ IntermediateField.adjoin ℚ S from this _ (hs ▸ Submodule.mem_top)
    intro T hT
    induction hT using Submodule.span_induction with
    | mem T hT => exact IntermediateField.subset_adjoin ℚ S (Or.inl ⟨T, hT, rfl⟩)
    | zero => simp
    | add T T' _ _ hT hT' => simpa using add_mem hT hT'
    | smul n T _ hT => simpa using zsmul_mem hT n
  have := IntermediateField.finiteDimensional_adjoin hS
  have := FiniteDimensional.of_injective (IntermediateField.inclusion hle).toLinearMap
    (IntermediateField.inclusion_injective hle)
  exact { }

end TauCeti
