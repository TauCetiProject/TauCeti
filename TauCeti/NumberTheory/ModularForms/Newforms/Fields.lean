module

public import TauCeti.NumberTheory.ModularForms.Newforms.Coefficient
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Data.Nat.Factorization.Induction

/-!
# Fields generated by newform coefficients and nebentypus values

The coefficient field of a newform is the subfield of `ℂ` generated over `ℚ` by its positive
Fourier coefficients. The character field is generated by the values of its nebentypus. The
good-prime Hecke recurrence recovers each character value from two Fourier coefficients,
so the character field lies in the coefficient field. This inclusion supplies the base field
for studying Galois conjugates within a fixed nebentypus space.

The construction follows the coefficient-field convention of Shimura, *Introduction to the
Arithmetic Theory of Automorphic Functions*, §3. The recurrence is Diamond–Shurman,
*A First Course in Modular Forms*, Proposition 5.8.5.
-/

public section

noncomputable section

open UpperHalfPlane

namespace TauCeti

variable {N : ℕ} {k : ℤ}

/-- The subfield of `ℂ` generated over `ℚ` by the positive-index Fourier coefficients of a
newform. -/
def CoefficientField [NeZero N] (f : HeckeRing.GL2.Newform N k) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ
    (Set.range fun n : ℕ+ => (qExpansion 1 f.toCuspForm).coeff (n : ℕ))

/-- The Fourier coefficients generating `CoefficientField` belong to it. -/
theorem coeff_mem_CoefficientField [NeZero N] (f : HeckeRing.GL2.Newform N k) (n : ℕ+) :
    (qExpansion 1 f.toCuspForm).coeff (n : ℕ) ∈ CoefficientField f :=
  IntermediateField.subset_adjoin ℚ _ ⟨n, rfl⟩

/-- A field contains `CoefficientField f` exactly when it contains every positive-index
Fourier coefficient of `f`. -/
theorem CoefficientField_le_iff [NeZero N] (f : HeckeRing.GL2.Newform N k)
    (K : IntermediateField ℚ ℂ) :
    CoefficientField f ≤ K ↔
      ∀ n : ℕ+, (qExpansion 1 f.toCuspForm).coeff (n : ℕ) ∈ K := by
  simp only [CoefficientField, IntermediateField.adjoin_le_iff, Set.range_subset_iff,
    SetLike.mem_coe]

/-- The subfield of `ℂ` generated over `ℚ` by the values of a nebentypus character. -/
def CharacterField (χ : (ZMod N)ˣ →* ℂˣ) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ (Set.range fun u : (ZMod N)ˣ => (χ u : ℂ))

/-- Every value of the nebentypus belongs to its character field. -/
theorem char_mem_CharacterField (χ : (ZMod N)ˣ →* ℂˣ) (u : (ZMod N)ˣ) :
    (χ u : ℂ) ∈ CharacterField χ :=
  IntermediateField.subset_adjoin ℚ _ ⟨u, rfl⟩

/-- A field contains `CharacterField χ` exactly when it contains every value of `χ`. -/
theorem CharacterField_le_iff (χ : (ZMod N)ˣ →* ℂˣ) (K : IntermediateField ℚ ℂ) :
    CharacterField χ ≤ K ↔ ∀ u : (ZMod N)ˣ, (χ u : ℂ) ∈ K := by
  simp only [CharacterField, IntermediateField.adjoin_le_iff, Set.range_subset_iff,
    SetLike.mem_coe]

/-- At a prime `p` coprime to the level, the Hecke recurrence gives
`χ(p) = (a_p^2 - a_{p^2}) / p^(k-1)`. -/
theorem char_prime_eq_coeff [NeZero N] (f : HeckeRing.GL2.Newform N k)
    {p : ℕ} (hp : p.Prime) (hpN : Nat.Coprime p N) :
    (f.χ (ZMod.unitOfCoprime p hpN) : ℂ) =
      ((qExpansion 1 f.toCuspForm).coeff p * (qExpansion 1 f.toCuspForm).coeff p -
        (qExpansion 1 f.toCuspForm).coeff (p ^ 2)) / (p : ℂ) ^ (k - 1) := by
  have hp0 : (p : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hp.ne_zero
  have hpow : (p : ℂ) ^ (k - 1) ≠ 0 := zpow_ne_zero _ hp0
  have hrec := f.toEigenformAwayFromLevel.qExpansion_coeff_prime_pow_add_two f.isNorm
    (p := ⟨p, hp.pos⟩) hp hpN 0
  have hrec' : (qExpansion 1 f.toCuspForm).coeff (p ^ 2) =
      (qExpansion 1 f.toCuspForm).coeff p * (qExpansion 1 f.toCuspForm).coeff p -
        (f.χ (ZMod.unitOfCoprime p hpN) : ℂ) * (p : ℂ) ^ (k - 1) := by
    simpa [f.isNorm] using hrec
  apply (eq_div_iff hpow).mpr
  linear_combination hrec'

/-- The nebentypus value at a good prime belongs to the coefficient field. -/
theorem char_prime_mem_CoefficientField [NeZero N] (f : HeckeRing.GL2.Newform N k)
    {p : ℕ} (hp : p.Prime) (hpN : Nat.Coprime p N) :
    (f.χ (ZMod.unitOfCoprime p hpN) : ℂ) ∈ CoefficientField f := by
  let K := CoefficientField f
  rw [char_prime_eq_coeff f hp hpN]
  exact K.div_mem
    (K.sub_mem (K.mul_mem (coeff_mem_CoefficientField f ⟨p, hp.pos⟩)
      (coeff_mem_CoefficientField f ⟨p, hp.pos⟩))
      (coeff_mem_CoefficientField f ⟨p ^ 2, pow_pos hp.pos _⟩))
    (K.pow_mem (K.natCast_mem p) _)

/-- Every value of the nebentypus of a newform lies in its coefficient field. The
prime-index recurrence proves this at primes; factorization gives all positive indices,
and a unit modulo `N` has a positive representative coprime to `N`. -/
theorem char_mem_CoefficientField [NeZero N] (f : HeckeRing.GL2.Newform N k)
    (u : (ZMod N)ˣ) : (f.χ u : ℂ) ∈ CoefficientField f := by
  let K := CoefficientField f
  have hnat : ∀ n : ℕ, 0 < n → ∀ hn : Nat.Coprime n N,
      (f.χ (ZMod.unitOfCoprime n hn) : ℂ) ∈ K := by
    intro n
    induction n using induction_on_primes with
    | zero =>
        intro hn
        omega
    | one =>
        intro _ hn
        have hu : ZMod.unitOfCoprime 1 hn = (1 : (ZMod N)ˣ) :=
          Units.ext (by simp)
        simp [hu]
    | prime_mul p n hp ih =>
        intro hpos hpn
        obtain ⟨hpN, hnN⟩ := Nat.coprime_mul_iff_left.mp hpn
        have hnpos : 0 < n := by
          by_contra h
          have : n = 0 := Nat.eq_zero_of_not_pos h
          simp [this] at hpos
        have hu : ZMod.unitOfCoprime (p * n) hpn =
            ZMod.unitOfCoprime p hpN * ZMod.unitOfCoprime n hnN :=
          Units.ext (by simp [ZMod.coe_unitOfCoprime])
        rw [hu, map_mul]
        exact K.mul_mem (char_prime_mem_CoefficientField f hp hpN) (ih hnpos hnN)
  let n := (u : ZMod N).val + N
  have hn : Nat.Coprime n N :=
    Nat.coprime_add_self_left.mpr (ZMod.val_coe_unit_coprime u)
  have hnpos : 0 < n := by
    dsimp [n]
    have hN := NeZero.pos N
    omega
  have hu : ZMod.unitOfCoprime n hn = u := by
    apply Units.ext
    simp [n, ZMod.coe_unitOfCoprime]
  rw [← hu]
  exact hnat n hnpos hn

/-- The field generated by the nebentypus values of a newform is a subfield of its
coefficient field. -/
theorem CharacterField_le_CoefficientField [NeZero N] (f : HeckeRing.GL2.Newform N k) :
    CharacterField f.χ ≤ CoefficientField f :=
  (CharacterField_le_iff f.χ (CoefficientField f)).mpr (char_mem_CoefficientField f)

end TauCeti
