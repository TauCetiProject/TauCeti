module

public import TauCeti.NumberTheory.ModularForms.Newforms.Hecke.Integral
import TauCeti.RingTheory.Subring.Basic
import Mathlib.Algebra.Algebra.RestrictScalars

/-!
# The rational Hecke algebra of the newspace

The rational newspace Hecke algebra is generated by the integral Hecke algebra inside the
endomorphisms of the complex newspace. Equivalently, it is the rational span of the integral
algebra. Its complex algebraic span inside the endomorphism algebra is the complex Hecke algebra
generated by the good prime Hecke operators and the diamond operators.

Restriction along the inclusion into the complex Hecke algebra is injective on complex-valued
complex-algebra characters. Thus the rational algebra retains enough information to distinguish
the complex characters, and in particular to distinguish normalized newforms. This is only the
faithfulness direction; it does not assert that every rational character extends to the complex
algebra.

## Main results

* `TauCeti.adjoin_heckeTDiamondCuspNewRationalAlgebra`: the complex span of the rational algebra
  is the complex newspace Hecke algebra.
* `TauCeti.heckeTDiamondCuspNewRationalAlgebra_finite`: the rational algebra is
  finite-dimensional in weight at least two.
* `TauCeti.restrictHeckeTDiamondCuspNewCharacter_injective`: a complex character is determined by
  its restriction to the rational algebra.
* `TauCeti.Newform.heckeTDiamondCuspNewRationalCharacter_injective`: normalized newforms have
  distinct rational Hecke characters.
-/

public noncomputable section

open Matrix.SpecialLinearGroup CongruenceSubgroup HeckeRing.GL2
open scoped MatrixGroups

namespace TauCeti

variable (N : ℕ) [NeZero N] (k : ℤ)

instance instAlgebraRatCuspNewEnd :
    Algebra ℚ (Module.End ℂ (cuspFormsNew N k)) :=
  Algebra.restrictScalars ℚ ℂ _

instance instAlgebraRatHeckeTDiamondCuspNewAlgebra :
    Algebra ℚ (heckeTDiamondCuspNewAlgebra N k) :=
  Algebra.restrictScalars ℚ ℂ _

/-- The rational newspace Hecke algebra, obtained by adjoining the integral Hecke algebra to
`ℚ` inside the endomorphisms of the complex newspace. -/
def heckeTDiamondCuspNewRationalAlgebra :
    Subalgebra ℚ (Module.End ℂ (cuspFormsNew N k)) :=
  Algebra.adjoin ℚ (heckeTDiamondCuspNewIntegralAlgebra N k : Set _)

/-- The rational newspace Hecke algebra is generated by the integral newspace Hecke algebra. -/
theorem heckeTDiamondCuspNewRationalAlgebra_def :
    heckeTDiamondCuspNewRationalAlgebra N k =
      Algebra.adjoin ℚ (heckeTDiamondCuspNewIntegralAlgebra N k : Set _) :=
  (rfl)

/-- A rational algebra contains the rational newspace Hecke algebra exactly when it contains
the integral newspace Hecke algebra. -/
theorem heckeTDiamondCuspNewRationalAlgebra_le_iff
    (A : Subalgebra ℚ (Module.End ℂ (cuspFormsNew N k))) :
    heckeTDiamondCuspNewRationalAlgebra N k ≤ A ↔
      ∀ T ∈ heckeTDiamondCuspNewIntegralAlgebra N k, T ∈ A := by
  rw [heckeTDiamondCuspNewRationalAlgebra_def, Algebra.adjoin_le_iff]
  rfl

/-- The rational newspace Hecke algebra is the rational span of the integral Hecke algebra. -/
theorem heckeTDiamondCuspNewRationalAlgebra_toSubmodule :
    Subalgebra.toSubmodule (heckeTDiamondCuspNewRationalAlgebra N k) =
      Submodule.span ℚ (heckeTDiamondCuspNewIntegralAlgebra N k : Set _) :=
  Subring.toSubmodule_adjoin_coe (heckeTDiamondCuspNewIntegralAlgebra N k).toSubring

/-- Each integral newspace Hecke operator belongs to the rational newspace Hecke algebra. -/
theorem heckeTDiamondCuspNewIntegralAlgebra_le_rational :
    (heckeTDiamondCuspNewIntegralAlgebra N k :
      Set (Module.End ℂ (cuspFormsNew N k))) ⊆
      (heckeTDiamondCuspNewRationalAlgebra N k : Set _) :=
  Algebra.subset_adjoin

/-- Each good prime Hecke operator belongs to the rational newspace Hecke algebra. -/
@[simp]
theorem heckeTCuspNewEnd_mem_heckeTDiamondCuspNewRationalAlgebra {p : ℕ} (hp : p.Prime)
    (hpN : Nat.Coprime p N) :
    heckeTCuspNewEnd N k hp hpN ∈ heckeTDiamondCuspNewRationalAlgebra N k :=
  heckeTDiamondCuspNewIntegralAlgebra_le_rational N k
    (heckeTCuspNewEnd_mem_heckeTDiamondCuspNewIntegralAlgebra N k hp hpN)

/-- Each diamond operator belongs to the rational newspace Hecke algebra. -/
@[simp]
theorem diamondOpCuspNewEnd_mem_heckeTDiamondCuspNewRationalAlgebra (u : (ZMod N)ˣ) :
    diamondOpCuspNewEnd N k u ∈ heckeTDiamondCuspNewRationalAlgebra N k :=
  heckeTDiamondCuspNewIntegralAlgebra_le_rational N k
    (diamondOpCuspNewEnd_mem_heckeTDiamondCuspNewIntegralAlgebra N k u)

/-- The natural inclusion of the integral newspace Hecke algebra into its rational span. -/
def heckeTDiamondCuspNewIntegralAlgebraToRational :
    heckeTDiamondCuspNewIntegralAlgebra N k →ₐ[ℤ] heckeTDiamondCuspNewRationalAlgebra N k :=
  (heckeTDiamondCuspNewIntegralAlgebra N k).inclusion
    (T := (heckeTDiamondCuspNewRationalAlgebra N k).restrictScalars ℤ)
    (heckeTDiamondCuspNewIntegralAlgebra_le_rational N k)

@[simp]
theorem coe_heckeTDiamondCuspNewIntegralAlgebraToRational
    (T : heckeTDiamondCuspNewIntegralAlgebra N k) :
    (heckeTDiamondCuspNewIntegralAlgebraToRational N k T :
      Module.End ℂ (cuspFormsNew N k)) = T :=
  (rfl)

/-- Every rational newspace Hecke operator lies in the complex newspace Hecke algebra. -/
theorem heckeTDiamondCuspNewRationalAlgebra_le :
    heckeTDiamondCuspNewRationalAlgebra N k ≤
      (heckeTDiamondCuspNewAlgebra N k).restrictScalars ℚ :=
  Algebra.adjoin_le (heckeTDiamondCuspNewIntegralAlgebra_le N k)

/-- The natural inclusion of the rational newspace Hecke algebra into its complex algebra. -/
def heckeTDiamondCuspNewRationalAlgebraToComplex :
    heckeTDiamondCuspNewRationalAlgebra N k →ₐ[ℚ] heckeTDiamondCuspNewAlgebra N k :=
  (heckeTDiamondCuspNewRationalAlgebra N k).val.codRestrict _ fun T ↦
    heckeTDiamondCuspNewRationalAlgebra_le N k T.2

@[simp]
theorem coe_heckeTDiamondCuspNewRationalAlgebraToComplex
    (T : heckeTDiamondCuspNewRationalAlgebra N k) :
    (heckeTDiamondCuspNewRationalAlgebraToComplex N k T :
      Module.End ℂ (cuspFormsNew N k)) = T :=
  (rfl)

/-- The inclusion of a rational operator into the complex algebra preserves its representative. -/
theorem heckeTDiamondCuspNewRationalAlgebraToComplex_apply_mk
    (T : Module.End ℂ (cuspFormsNew N k))
    (hT : T ∈ heckeTDiamondCuspNewRationalAlgebra N k) :
    heckeTDiamondCuspNewRationalAlgebraToComplex N k ⟨T, hT⟩ =
      ⟨T, heckeTDiamondCuspNewRationalAlgebra_le N k hT⟩ :=
  (rfl)

/-- The inclusions from the integral algebra through the rational algebra and directly into the
complex algebra agree. -/
@[simp]
theorem heckeTDiamondCuspNewRationalAlgebraToComplex_apply_integral
    (T : heckeTDiamondCuspNewIntegralAlgebra N k) :
    heckeTDiamondCuspNewRationalAlgebraToComplex N k
      (heckeTDiamondCuspNewIntegralAlgebraToRational N k T) =
        heckeTDiamondCuspNewIntegralAlgebraToComplex N k T := by
  apply Subtype.ext
  simp only [coe_heckeTDiamondCuspNewRationalAlgebraToComplex,
    coe_heckeTDiamondCuspNewIntegralAlgebraToRational,
    coe_heckeTDiamondCuspNewIntegralAlgebraToComplex]

/-- The natural inclusion into the complex newspace Hecke algebra is injective. -/
theorem heckeTDiamondCuspNewRationalAlgebraToComplex_injective :
    Function.Injective (heckeTDiamondCuspNewRationalAlgebraToComplex N k) := by
  intro T S h
  apply Subtype.ext
  simpa only [coe_heckeTDiamondCuspNewRationalAlgebraToComplex] using
    congrArg (fun U : heckeTDiamondCuspNewAlgebra N k ↦
      (U : Module.End ℂ (cuspFormsNew N k))) h

/-- The complex algebraic span of the rational newspace Hecke algebra is the complex newspace
Hecke algebra. -/
theorem adjoin_heckeTDiamondCuspNewRationalAlgebra :
    Algebra.adjoin ℂ (heckeTDiamondCuspNewRationalAlgebra N k : Set _) =
      heckeTDiamondCuspNewAlgebra N k := by
  apply le_antisymm
  · exact Algebra.adjoin_le (heckeTDiamondCuspNewRationalAlgebra_le N k)
  · refine (heckeTDiamondCuspNewAlgebra_le_iff N k _).mpr ⟨?_, ?_⟩
    · intro p hp hpN
      exact Algebra.subset_adjoin
        (heckeTCuspNewEnd_mem_heckeTDiamondCuspNewRationalAlgebra N k hp hpN)
    · intro u
      exact Algebra.subset_adjoin
        (diamondOpCuspNewEnd_mem_heckeTDiamondCuspNewRationalAlgebra N k u)

/-- The rational newspace Hecke algebra is finite-dimensional in weight at least two. -/
theorem heckeTDiamondCuspNewRationalAlgebra_finite (hk : 2 ≤ k) :
    Module.Finite ℚ (heckeTDiamondCuspNewRationalAlgebra N k) := by
  have hfg : (heckeTDiamondCuspNewIntegralAlgebra N k).toSubmodule.FG :=
    Module.Finite.iff_fg.mp (heckeTDiamondCuspNewIntegralAlgebra_finite N k hk)
  refine (Module.Finite.iff_fg
    (N := (heckeTDiamondCuspNewRationalAlgebra N k).toSubmodule)).mpr ?_
  rw [heckeTDiamondCuspNewRationalAlgebra_toSubmodule]
  exact hfg.span

/-- The rational newspace Hecke algebra is commutative with its existing operator product. -/
instance instCommRingHeckeTDiamondCuspNewRationalAlgebra :
    CommRing (heckeTDiamondCuspNewRationalAlgebra N k) where
  __ := (heckeTDiamondCuspNewRationalAlgebra N k).toRing
  mul_comm a b := by
    apply Subtype.ext
    exact congrArg (fun T : heckeTDiamondCuspNewAlgebra N k ↦
      (T : Module.End ℂ (cuspFormsNew N k)))
      (mul_comm (heckeTDiamondCuspNewRationalAlgebraToComplex N k a)
        (heckeTDiamondCuspNewRationalAlgebraToComplex N k b))

/-- Restrict a complex-valued complex Hecke character to the rational Hecke algebra. -/
def restrictHeckeTDiamondCuspNewCharacter
    (ψ : heckeTDiamondCuspNewAlgebra N k →ₐ[ℂ] ℂ) :
    heckeTDiamondCuspNewRationalAlgebra N k →ₐ[ℚ] ℂ :=
  (ψ.restrictScalars ℚ).comp (heckeTDiamondCuspNewRationalAlgebraToComplex N k)

@[simp low]
theorem restrictHeckeTDiamondCuspNewCharacter_apply
    (ψ : heckeTDiamondCuspNewAlgebra N k →ₐ[ℂ] ℂ)
    (T : heckeTDiamondCuspNewRationalAlgebra N k) :
    restrictHeckeTDiamondCuspNewCharacter N k ψ T =
      ψ (heckeTDiamondCuspNewRationalAlgebraToComplex N k T) :=
  (rfl)

/-- A complex character of the newspace Hecke algebra is determined by its restriction to the
rational Hecke algebra. -/
theorem restrictHeckeTDiamondCuspNewCharacter_injective :
    Function.Injective (restrictHeckeTDiamondCuspNewCharacter N k) := by
  intro φ ψ h
  apply AlgHom.ext_of_eq_adjoin (adjoin_heckeTDiamondCuspNewRationalAlgebra N k).symm
  intro T hT
  have h' := DFunLike.congr_fun h ⟨T, hT⟩
  simpa only [restrictHeckeTDiamondCuspNewCharacter_apply,
    heckeTDiamondCuspNewRationalAlgebraToComplex_apply_mk] using h'

namespace Newform

variable {N k}

/-- A newform's complex-valued character on the rational newspace Hecke algebra. -/
def heckeTDiamondCuspNewRationalCharacter (f : Newform N k) :
    heckeTDiamondCuspNewRationalAlgebra N k →ₐ[ℚ] ℂ :=
  restrictHeckeTDiamondCuspNewCharacter N k (heckeTDiamondCuspNewCharacter f)

/-- Evaluation of the rational character through the inclusion into the complex algebra. -/
@[simp low]
theorem heckeTDiamondCuspNewRationalCharacter_apply (f : Newform N k)
    (T : heckeTDiamondCuspNewRationalAlgebra N k) :
    heckeTDiamondCuspNewRationalCharacter f T = heckeTDiamondCuspNewCharacter f
      (heckeTDiamondCuspNewRationalAlgebraToComplex N k T) :=
  (rfl)

/-- Restricting the rational character further to the integral algebra gives the integral
character. -/
@[simp]
theorem heckeTDiamondCuspNewRationalCharacter_apply_integral (f : Newform N k)
    (T : heckeTDiamondCuspNewIntegralAlgebra N k) :
    heckeTDiamondCuspNewRationalCharacter f
      (heckeTDiamondCuspNewIntegralAlgebraToRational N k T) =
        heckeTDiamondCuspNewIntegralCharacter f T := by
  rw [heckeTDiamondCuspNewRationalCharacter_apply,
    heckeTDiamondCuspNewIntegralCharacter_apply,
    heckeTDiamondCuspNewRationalAlgebraToComplex_apply_integral]

/-- The rational character on a good prime Hecke operator is its Hecke eigenvalue. -/
@[simp]
theorem heckeTDiamondCuspNewRationalCharacter_apply_heckeTCuspNewEnd (f : Newform N k)
    {p : ℕ} (hp : p.Prime) (hpN : Nat.Coprime p N) :
    heckeTDiamondCuspNewRationalCharacter f ⟨heckeTCuspNewEnd N k hp hpN,
      heckeTCuspNewEnd_mem_heckeTDiamondCuspNewRationalAlgebra N k hp hpN⟩ =
      f.eigenvalue ⟨p, hp.pos⟩ hpN := by
  rw [heckeTDiamondCuspNewRationalCharacter_apply]
  exact heckeTDiamondCuspNewCharacter_apply_heckeTCuspNewEnd f hp hpN

/-- The rational character on a diamond operator is its nebentypus value. -/
@[simp]
theorem heckeTDiamondCuspNewRationalCharacter_apply_diamondOpCuspNewEnd (f : Newform N k)
    (d : (ZMod N)ˣ) :
    heckeTDiamondCuspNewRationalCharacter f ⟨diamondOpCuspNewEnd N k d,
      diamondOpCuspNewEnd_mem_heckeTDiamondCuspNewRationalAlgebra N k d⟩ = (f.χ d : ℂ) := by
  rw [heckeTDiamondCuspNewRationalCharacter_apply]
  exact heckeTDiamondCuspNewCharacter_apply_diamondOpCuspNewEnd f d

/-- Distinct newforms give distinct complex-valued characters of the rational newspace Hecke
algebra. -/
theorem heckeTDiamondCuspNewRationalCharacter_injective :
    Function.Injective (heckeTDiamondCuspNewRationalCharacter (N := N) (k := k)) := by
  intro f g h
  apply heckeTDiamondCuspNewCharacter_injective
  apply restrictHeckeTDiamondCuspNewCharacter_injective N k
  exact h

end Newform

end TauCeti
