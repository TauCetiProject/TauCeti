module

public import TauCeti.NumberTheory.ModularForms.Newforms.Hecke.Charpoly
public import TauCeti.NumberTheory.ModularForms.Newforms.Fields
import TauCeti.LinearAlgebra.End.Adjoin

/-!
# The Hecke algebra of `S_k(N, χ)ⁿᵉʷ` over the character field

For a character `χ` modulo `N`, the Hecke operators `Tₙ` at every positive index `n` act on the
new part `S_k(N, χ)ⁿᵉʷ` of `S_k(N, χ)`. This file studies the algebra they generate over the
character field `ℚ(χ)`, inside the complex endomorphisms of `S_k(N, χ)ⁿᵉʷ`.

Each newform `f` of nebentypus `χ` is a joint eigenvector, so it defines a `ℚ(χ)`-algebra
character of this algebra sending `Tₙ` to the Fourier coefficient `aₙ(f)`. Since the newforms
of nebentypus `χ` form a basis, an element of the algebra is determined by its values at these
characters, and distinct newforms give distinct characters.

The values of the character of `f` lie in the coefficient field `K_f = ℚ(aₙ(f) : n)`, which
contains `ℚ(χ)`. Hence the algebra embeds into the product of the coefficient fields `K_f` over
the newforms of nebentypus `χ`, and it is a finite-dimensional commutative `ℚ(χ)`-algebra in
weight at least two, where each `K_f` is a number field.

Composing the character of `f`, viewed as valued in `K_f`, with an embedding `σ : K_f → ℂ`
fixing `ℚ(χ)` produces another `ℚ(χ)`-algebra character of the same algebra, sending `Tₙ` to
`σ(aₙ(f))`. Distinct embeddings give distinct characters. These conjugate characters are the
candidate eigensystems of the Galois conjugates `f^σ`. Whether each of them is again the
character of a newform is the Galois stability of the newforms, which this file does not
address.

## Main definitions

* `TauCeti.heckeTCuspNewCharFieldAlgebra k χ`: the `ℚ(χ)`-algebra generated by the `Tₙ` on
  `S_k(N, χ)ⁿᵉʷ`.
* `TauCeti.heckeTCuspNewCharFieldCharacter f`: the character of a newform `f` of nebentypus `χ`.
* `TauCeti.heckeTCuspNewCharFieldCoefficientCharacter f`: the same character, valued in the
  coefficient field of `f` viewed over `ℚ(χ)`.
* `TauCeti.conjHeckeTCuspNewCharFieldCharacter f σ`: its conjugate by an embedding `σ` of the
  coefficient field fixing `ℚ(χ)`.

## Main results

* `TauCeti.heckeTCuspNewCharFieldCharacter_injective`: distinct newforms give distinct
  characters.
* `TauCeti.heckeTCuspNewCharFieldAlgebra_finite`: the algebra is finite-dimensional over `ℚ(χ)`
  in weight at least two.
* `TauCeti.conjHeckeTCuspNewCharFieldCharacter_apply_heckeTCuspNewCharEnd`: the conjugate
  character sends `Tₙ` to `σ(aₙ(f))`.
* `TauCeti.conjHeckeTCuspNewCharFieldCharacter_injective`: distinct embeddings give distinct
  conjugate characters.

## References

* [G. Shimura, *Introduction to the arithmetic theory of automorphic functions*][shimura1971],
  Chapter 3, for the Hecke algebra and its eigenvalue characters.
* [F. Diamond and J. Shurman, *A first course in modular forms*][diamondshurman2005],
  §6.5, for the coefficient fields of newforms and the conjugates of their eigenvalue systems.
-/

public noncomputable section

open UpperHalfPlane CongruenceSubgroup HeckeRing.GL2 HeckeRing.GL2.Newform
  Matrix.SpecialLinearGroup
open scoped MatrixGroups

namespace TauCeti

variable {N : ℕ} [NeZero N] (k : ℤ) (χ : (ZMod N)ˣ →* ℂˣ)

/-- The Hecke algebra of `S_k(N, χ)ⁿᵉʷ` over the character field `ℚ(χ)`: the
`ℚ(χ)`-subalgebra of the complex endomorphisms of `S_k(N, χ)ⁿᵉʷ` generated by the Hecke
operators `Tₙ` at every positive index `n`. -/
def heckeTCuspNewCharFieldAlgebra :
    Subalgebra (CharacterField χ)
      (Module.End ℂ ((cuspFormsNew N k).comap (cuspFormCharSpace k χ).subtype)) :=
  Algebra.adjoin (CharacterField χ) (Set.range (heckeTCuspNewCharEnd k χ))

/-- The defining generators of the Hecke algebra of `S_k(N, χ)ⁿᵉʷ` over `ℚ(χ)`. -/
theorem heckeTCuspNewCharFieldAlgebra_def :
    heckeTCuspNewCharFieldAlgebra k χ =
      Algebra.adjoin (CharacterField χ) (Set.range (heckeTCuspNewCharEnd k χ)) :=
  (rfl)

@[simp]
theorem heckeTCuspNewCharEnd_mem_heckeTCuspNewCharFieldAlgebra (n : ℕ+) :
    heckeTCuspNewCharEnd k χ n ∈ heckeTCuspNewCharFieldAlgebra k χ :=
  Algebra.subset_adjoin ⟨n, rfl⟩

/-- A `ℚ(χ)`-algebra of endomorphisms of `S_k(N, χ)ⁿᵉʷ` contains the Hecke algebra exactly
when it contains every `Tₙ`. -/
theorem heckeTCuspNewCharFieldAlgebra_le_iff
    (A : Subalgebra (CharacterField χ)
      (Module.End ℂ ((cuspFormsNew N k).comap (cuspFormCharSpace k χ).subtype))) :
    heckeTCuspNewCharFieldAlgebra k χ ≤ A ↔ ∀ n : ℕ+, heckeTCuspNewCharEnd k χ n ∈ A := by
  rw [heckeTCuspNewCharFieldAlgebra_def, Algebra.adjoin_le_iff, Set.range_subset_iff]
  rfl

variable {k χ}

private theorem basisCharSpace_repr_smul_self (f : {f : Newform N k // f.χ = χ}) (c : ℂ) :
    (basisCharSpace N k χ).repr (c • basisCharSpace N k χ f) f = c := by
  rw [LinearEquiv.map_smul, Finsupp.smul_apply, Module.Basis.repr_self,
    Finsupp.single_eq_same, smul_eq_mul, mul_one]

-- The basis vector `basisCharSpace N k χ f` is itself a coercion application, so rewriting
-- inside `repr` would unify against it; the coordinate is transported along `hc` instead.
private theorem basisCharSpace_repr_apply_of_eq_smul (f : {f : Newform N k // f.χ = χ})
    {T : Module.End ℂ ((cuspFormsNew N k).comap (cuspFormCharSpace k χ).subtype)} {c : ℂ}
    (hc : T (basisCharSpace N k χ f) = c • basisCharSpace N k χ f) :
    (basisCharSpace N k χ).repr (T (basisCharSpace N k χ f)) f = c :=
  (congrArg (fun v ↦ (basisCharSpace N k χ).repr v f) hc).trans
    (basisCharSpace_repr_smul_self f c)

private theorem exists_apply_basisCharSpace_eq_smul (f : {f : Newform N k // f.χ = χ})
    (T : heckeTCuspNewCharFieldAlgebra k χ) :
    ∃ c : ℂ, T.1 (basisCharSpace N k χ f) = c • basisCharSpace N k χ f :=
  exists_smul_eq_of_mem_adjoin (by
    rintro _ ⟨n, rfl⟩
    exact ⟨_, heckeTCuspNewCharEnd_basisCharSpace n f⟩) T.2

private theorem basisCharSpace_repr_mul_apply (f : {f : Newform N k // f.χ = χ})
    (T S : heckeTCuspNewCharFieldAlgebra k χ) :
    (basisCharSpace N k χ).repr ((T * S).1 (basisCharSpace N k χ f)) f =
      (basisCharSpace N k χ).repr (T.1 (basisCharSpace N k χ f)) f *
        (basisCharSpace N k χ).repr (S.1 (basisCharSpace N k χ f)) f := by
  obtain ⟨c, hc⟩ := exists_apply_basisCharSpace_eq_smul f T
  obtain ⟨d, hd⟩ := exists_apply_basisCharSpace_eq_smul f S
  have h : (T * S).1 (basisCharSpace N k χ f) = (c * d) • basisCharSpace N k χ f := by
    rw [Subalgebra.coe_mul, Module.End.mul_apply, hd, LinearMap.map_smul, hc, smul_smul,
      mul_comm]
  exact (basisCharSpace_repr_apply_of_eq_smul f h).trans
    (congrArg₂ (· * ·) (basisCharSpace_repr_apply_of_eq_smul f hc)
      (basisCharSpace_repr_apply_of_eq_smul f hd)).symm

private theorem basisCharSpace_repr_add_apply (f : {f : Newform N k // f.χ = χ})
    (T S : heckeTCuspNewCharFieldAlgebra k χ) :
    (basisCharSpace N k χ).repr ((T + S).1 (basisCharSpace N k χ f)) f =
      (basisCharSpace N k χ).repr (T.1 (basisCharSpace N k χ f)) f +
        (basisCharSpace N k χ).repr (S.1 (basisCharSpace N k χ f)) f := by
  obtain ⟨c, hc⟩ := exists_apply_basisCharSpace_eq_smul f T
  obtain ⟨d, hd⟩ := exists_apply_basisCharSpace_eq_smul f S
  have h : (T + S).1 (basisCharSpace N k χ f) = (c + d) • basisCharSpace N k χ f := by
    rw [Subalgebra.coe_add, LinearMap.add_apply, hc, hd, add_smul]
  exact (basisCharSpace_repr_apply_of_eq_smul f h).trans
    (congrArg₂ (· + ·) (basisCharSpace_repr_apply_of_eq_smul f hc)
      (basisCharSpace_repr_apply_of_eq_smul f hd)).symm

-- Built directly rather than through `AlgHom.eigenvalueHomOfJointEigenvector`: that expects the
-- `ℚ(χ)`-algebra structure of the endomorphisms of a `ℚ(χ)`-module, while the subalgebra carries
-- the one obtained through `ℂ`, and the two agree only after unfolding.
/-- The `ℚ(χ)`-algebra character of the Hecke algebra of `S_k(N, χ)ⁿᵉʷ` associated with a
newform of nebentypus `χ`: the eigenvalue of an operator on that newform, read off as its
coordinate in the newform basis. -/
def heckeTCuspNewCharFieldCharacter (f : {f : Newform N k // f.χ = χ}) :
    heckeTCuspNewCharFieldAlgebra k χ →ₐ[CharacterField χ] ℂ where
  toFun T := (basisCharSpace N k χ).repr (T.1 (basisCharSpace N k χ f)) f
  map_one' := basisCharSpace_repr_apply_of_eq_smul f (one_smul ℂ _).symm
  map_mul' := basisCharSpace_repr_mul_apply f
  map_zero' := basisCharSpace_repr_apply_of_eq_smul f (zero_smul ℂ _).symm
  map_add' := basisCharSpace_repr_add_apply f
  commutes' c := basisCharSpace_repr_apply_of_eq_smul f (by
    rw [Subalgebra.coe_algebraMap, IsScalarTower.algebraMap_apply (CharacterField χ) ℂ,
      Module.algebraMap_end_apply])

/-- The character of a newform at an operator is the coordinate, at that newform, of the
operator applied to it. -/
theorem heckeTCuspNewCharFieldCharacter_apply (f : {f : Newform N k // f.χ = χ})
    (T : heckeTCuspNewCharFieldAlgebra k χ) :
    heckeTCuspNewCharFieldCharacter f T =
      (basisCharSpace N k χ).repr (T.1 (basisCharSpace N k χ f)) f :=
  (rfl)

/-- Every operator in the Hecke algebra of `S_k(N, χ)ⁿᵉʷ` over `ℚ(χ)` acts on a newform of
nebentypus `χ` by the value of its character. -/
@[simp]
theorem apply_basisCharSpace_eq_heckeTCuspNewCharFieldCharacter_smul
    (f : {f : Newform N k // f.χ = χ}) (T : heckeTCuspNewCharFieldAlgebra k χ) :
    T.1 (basisCharSpace N k χ f) =
      heckeTCuspNewCharFieldCharacter f T • basisCharSpace N k χ f := by
  obtain ⟨c, hc⟩ := exists_apply_basisCharSpace_eq_smul f T
  rw [heckeTCuspNewCharFieldCharacter_apply, basisCharSpace_repr_apply_of_eq_smul f hc, hc]

/-- The character of a newform sends `Tₙ` to its `n`th Fourier coefficient `aₙ(f)`. -/
@[simp]
theorem heckeTCuspNewCharFieldCharacter_apply_heckeTCuspNewCharEnd
    (f : {f : Newform N k // f.χ = χ}) (n : ℕ+) :
    heckeTCuspNewCharFieldCharacter f ⟨heckeTCuspNewCharEnd k χ n,
      heckeTCuspNewCharEnd_mem_heckeTCuspNewCharFieldAlgebra k χ n⟩ =
      (qExpansion 1 f.1.toCuspForm).coeff n := by
  apply smul_left_injective ℂ ((basisCharSpace N k χ).ne_zero f)
  exact (apply_basisCharSpace_eq_heckeTCuspNewCharFieldCharacter_smul f _).symm.trans
    (heckeTCuspNewCharEnd_basisCharSpace n f)

/-- An element of the Hecke algebra of `S_k(N, χ)ⁿᵉʷ` over `ℚ(χ)` is determined by its values
at the characters of the newforms of nebentypus `χ`. -/
theorem eq_of_forall_heckeTCuspNewCharFieldCharacter_eq
    {T S : heckeTCuspNewCharFieldAlgebra k χ}
    (h : ∀ f, heckeTCuspNewCharFieldCharacter f T = heckeTCuspNewCharFieldCharacter f S) :
    T = S := by
  apply Subtype.ext
  apply (basisCharSpace N k χ).ext
  intro f
  rw [apply_basisCharSpace_eq_heckeTCuspNewCharFieldCharacter_smul,
    apply_basisCharSpace_eq_heckeTCuspNewCharFieldCharacter_smul, h f]

/-- Distinct newforms of nebentypus `χ` give distinct characters of the Hecke algebra of
`S_k(N, χ)ⁿᵉʷ` over `ℚ(χ)`: the values at the `Tₙ` are the Fourier coefficients. -/
theorem heckeTCuspNewCharFieldCharacter_injective :
    Function.Injective (heckeTCuspNewCharFieldCharacter (k := k) (χ := χ)) := by
  intro f g h
  apply Subtype.ext
  refine Newform.eq_of_forall_notMem_qExpansion_coeff_eq (f.2.trans g.2.symm) (S := ∅) ?_
  intro n _ _
  simpa only [heckeTCuspNewCharFieldCharacter_apply_heckeTCuspNewCharEnd] using
    DFunLike.congr_fun h ⟨heckeTCuspNewCharEnd k χ n,
      heckeTCuspNewCharEnd_mem_heckeTCuspNewCharFieldAlgebra k χ n⟩

/-- The Hecke algebra of `S_k(N, χ)ⁿᵉʷ` over `ℚ(χ)` is commutative, with its existing
operator semiring structure. -/
instance instCommSemiringHeckeTCuspNewCharFieldAlgebra :
    CommSemiring (heckeTCuspNewCharFieldAlgebra k χ) where
  __ := (heckeTCuspNewCharFieldAlgebra k χ).toSemiring
  mul_comm T S := eq_of_forall_heckeTCuspNewCharFieldCharacter_eq fun _ ↦
    (map_mul _ T S).trans ((mul_comm _ _).trans (map_mul _ S T).symm)

private theorem adjoin_coe_preimage_heckeTCuspNewCharEnd :
    Algebra.adjoin (CharacterField χ)
      (((↑) : heckeTCuspNewCharFieldAlgebra k χ → _) ⁻¹' Set.range (heckeTCuspNewCharEnd k χ)) =
      ⊤ :=
  Algebra.adjoin_adjoin_coe_preimage

/-- Every value of the character of a newform lies in its coefficient field. -/
theorem heckeTCuspNewCharFieldCharacter_mem_CoefficientField
    (f : {f : Newform N k // f.χ = χ}) (T : heckeTCuspNewCharFieldAlgebra k χ) :
    heckeTCuspNewCharFieldCharacter f T ∈ CoefficientField f.1 := by
  let F := IntermediateField.extendScalars (CharacterField_le_CoefficientField_of_χ_eq f.1 f.2)
  suffices h : ⊤ ≤ (F.toSubalgebra.comap (heckeTCuspNewCharFieldCharacter f)) from h trivial
  rw [← adjoin_coe_preimage_heckeTCuspNewCharEnd, Algebra.adjoin_le_iff]
  rintro T ⟨n, hn⟩
  obtain rfl : T = ⟨heckeTCuspNewCharEnd k χ n,
      heckeTCuspNewCharEnd_mem_heckeTCuspNewCharFieldAlgebra k χ n⟩ := Subtype.ext hn.symm
  simp [F]

/-- The Hecke algebra of `S_k(N, χ)ⁿᵉʷ` over `ℚ(χ)` is finite-dimensional in weight at least
two: it embeds into the product of the coefficient fields of the newforms of nebentypus `χ`,
each a number field. -/
theorem heckeTCuspNewCharFieldAlgebra_finite (hk : 2 ≤ k) :
    Module.Finite (CharacterField χ) (heckeTCuspNewCharFieldAlgebra k χ) := by
  let M : {f : Newform N k // f.χ = χ} → Submodule (CharacterField χ) ℂ := fun f ↦
    Submodule.span (CharacterField χ) (CoefficientField f.1 : Set ℂ)
  -- The span over `ℚ(χ)` of a number field in `ℂ` is spanned by a `ℚ`-basis of it.
  have hfg : ∀ (E : IntermediateField ℚ ℂ) [FiniteDimensional ℚ E],
      (Submodule.span (CharacterField χ) (E : Set ℂ)).FG := fun E _ ↦ by
    have hE : (Subalgebra.toSubmodule E.toSubalgebra).FG :=
      Module.Finite.iff_fg.mp (inferInstanceAs (Module.Finite ℚ E))
    exact hE.span
  have hM : ∀ f, Module.Finite (CharacterField χ) (M f) := fun f ↦ by
    have := numberField_CoefficientField f.1 hk
    exact Module.Finite.iff_fg.mpr (hfg (CoefficientField f.1))
  let E : heckeTCuspNewCharFieldAlgebra k χ →ₗ[CharacterField χ] ∀ f, M f :=
    LinearMap.pi fun f ↦ (heckeTCuspNewCharFieldCharacter f).toLinearMap.codRestrict (M f)
      fun T ↦ Submodule.subset_span (heckeTCuspNewCharFieldCharacter_mem_CoefficientField f T)
  refine Module.Finite.of_injective E fun T S h ↦
    eq_of_forall_heckeTCuspNewCharFieldCharacter_eq fun f ↦ ?_
  simpa [E] using congrArg Subtype.val (congrFun h f)

/-- The character of a newform of nebentypus `χ`, valued in its coefficient field viewed as an
extension of `ℚ(χ)`. -/
def heckeTCuspNewCharFieldCoefficientCharacter (f : {f : Newform N k // f.χ = χ}) :
    heckeTCuspNewCharFieldAlgebra k χ →ₐ[CharacterField χ]
      IntermediateField.extendScalars (CharacterField_le_CoefficientField_of_χ_eq f.1 f.2) :=
  (heckeTCuspNewCharFieldCharacter f).codRestrict _
    (heckeTCuspNewCharFieldCharacter_mem_CoefficientField f)

@[simp]
theorem coe_heckeTCuspNewCharFieldCoefficientCharacter_apply
    (f : {f : Newform N k // f.χ = χ}) (T : heckeTCuspNewCharFieldAlgebra k χ) :
    (heckeTCuspNewCharFieldCoefficientCharacter f T : ℂ) = heckeTCuspNewCharFieldCharacter f T :=
  (rfl)

/-- The coefficient-field-valued character of a newform sends `Tₙ` to `aₙ(f)`. -/
@[simp]
theorem heckeTCuspNewCharFieldCoefficientCharacter_apply_heckeTCuspNewCharEnd
    (f : {f : Newform N k // f.χ = χ}) (n : ℕ+) :
    heckeTCuspNewCharFieldCoefficientCharacter f ⟨heckeTCuspNewCharEnd k χ n,
      heckeTCuspNewCharEnd_mem_heckeTCuspNewCharFieldAlgebra k χ n⟩ =
      ⟨(qExpansion 1 f.1.toCuspForm).coeff n, coeff_mem_CoefficientField f.1 n⟩ :=
  Subtype.ext (heckeTCuspNewCharFieldCharacter_apply_heckeTCuspNewCharEnd f n)

/-- The conjugate of the character of a newform `f` of nebentypus `χ` by an embedding `σ` of
its coefficient field fixing `ℚ(χ)`: another `ℚ(χ)`-algebra character of the Hecke algebra of
`S_k(N, χ)ⁿᵉʷ`, sending `Tₙ` to `σ(aₙ(f))`. -/
def conjHeckeTCuspNewCharFieldCharacter (f : {f : Newform N k // f.χ = χ})
    (σ : IntermediateField.extendScalars (CharacterField_le_CoefficientField_of_χ_eq f.1 f.2)
      →ₐ[CharacterField χ] ℂ) :
    heckeTCuspNewCharFieldAlgebra k χ →ₐ[CharacterField χ] ℂ :=
  σ.comp (heckeTCuspNewCharFieldCoefficientCharacter f)

@[simp]
theorem conjHeckeTCuspNewCharFieldCharacter_apply (f : {f : Newform N k // f.χ = χ})
    (σ : IntermediateField.extendScalars (CharacterField_le_CoefficientField_of_χ_eq f.1 f.2)
      →ₐ[CharacterField χ] ℂ) (T : heckeTCuspNewCharFieldAlgebra k χ) :
    conjHeckeTCuspNewCharFieldCharacter f σ T =
      σ (heckeTCuspNewCharFieldCoefficientCharacter f T) :=
  (rfl)

/-- The conjugate character sends `Tₙ` to the conjugate `σ(aₙ(f))` of the `n`th Fourier
coefficient. -/
theorem conjHeckeTCuspNewCharFieldCharacter_apply_heckeTCuspNewCharEnd
    (f : {f : Newform N k // f.χ = χ})
    (σ : IntermediateField.extendScalars (CharacterField_le_CoefficientField_of_χ_eq f.1 f.2)
      →ₐ[CharacterField χ] ℂ) (n : ℕ+) :
    conjHeckeTCuspNewCharFieldCharacter f σ ⟨heckeTCuspNewCharEnd k χ n,
      heckeTCuspNewCharEnd_mem_heckeTCuspNewCharFieldAlgebra k χ n⟩ =
      σ ⟨(qExpansion 1 f.1.toCuspForm).coeff n, coeff_mem_CoefficientField f.1 n⟩ := by
  rw [conjHeckeTCuspNewCharFieldCharacter_apply,
    heckeTCuspNewCharFieldCoefficientCharacter_apply_heckeTCuspNewCharEnd]

/-- Conjugating by the inclusion of the coefficient field recovers the character of the
newform. -/
@[simp]
theorem conjHeckeTCuspNewCharFieldCharacter_val (f : {f : Newform N k // f.χ = χ}) :
    conjHeckeTCuspNewCharFieldCharacter f
      (IntermediateField.extendScalars (CharacterField_le_CoefficientField_of_χ_eq f.1 f.2)).val =
      heckeTCuspNewCharFieldCharacter f :=
  (rfl)

/-- Distinct embeddings of the coefficient field fixing `ℚ(χ)` give distinct conjugate
characters, since the coefficient field is generated over `ℚ(χ)` by the Fourier
coefficients. -/
theorem conjHeckeTCuspNewCharFieldCharacter_injective (f : {f : Newform N k // f.χ = χ}) :
    Function.Injective (conjHeckeTCuspNewCharFieldCharacter f) := by
  intro σ τ h
  have h' : CharacterField χ ≤ IntermediateField.adjoin ℚ
      (Set.range fun n : ℕ+ ↦ (qExpansion 1 f.1.toCuspForm).coeff (n : ℕ)) :=
    CoefficientField_def f.1 ▸ CharacterField_le_CoefficientField_of_χ_eq f.1 f.2
  have hS : IntermediateField.extendScalars (CharacterField_le_CoefficientField_of_χ_eq f.1 f.2) =
      IntermediateField.adjoin (CharacterField χ)
        (Set.range fun n : ℕ+ ↦ (qExpansion 1 f.1.toCuspForm).coeff (n : ℕ)) := by
    ext x
    rw [IntermediateField.mem_extendScalars, CoefficientField_def,
      ← IntermediateField.extendScalars_adjoin h', IntermediateField.mem_extendScalars]
  refine IntermediateField.algHom_ext_of_eq_adjoin (CharacterField χ) hS ?_
  rintro _ ⟨n, rfl⟩
  have := DFunLike.congr_fun h ⟨heckeTCuspNewCharEnd k χ n,
    heckeTCuspNewCharEnd_mem_heckeTCuspNewCharFieldAlgebra k χ n⟩
  rwa [conjHeckeTCuspNewCharFieldCharacter_apply_heckeTCuspNewCharEnd,
    conjHeckeTCuspNewCharFieldCharacter_apply_heckeTCuspNewCharEnd] at this

end TauCeti
