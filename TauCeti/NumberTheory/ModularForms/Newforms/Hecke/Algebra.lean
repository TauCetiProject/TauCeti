/-!
# Complex characters of the newspace Hecke algebra

The complex algebra generated on the new subspace by the good prime Hecke operators and the
diamond operators has exactly one character for each normalized newform. Its character on
`T_p` is the Fourier coefficient `a_p`, and its character on `⟨u⟩` is the nebentypus value
`χ(u)`. Including the diamonds distinguishes forms with different nebentypus.

`newHeckeAlgebraEquiv` identifies this algebra with the product of copies of `ℂ` indexed by
newforms. This is the complex character/eigenline correspondence: every character occurs, and
its normalized eigenform is unique. It uses the actual newform basis and strong multiplicity one,
not an assumption that an arbitrary eigenvalue system occurs. It does not construct a rational
structure on the newspace or assert Galois stability of newforms.

## References

* [F. Diamond and J. Shurman, *A first course in modular forms*][diamondshurman2005],
  Theorem 5.8.2.
* [G. Shimura, *Introduction to the arithmetic theory of automorphic functions*][shimura1971],
  Chapter 3, for the Hecke algebra and its eigenvalue characters.
-/

public noncomputable section

open Matrix.SpecialLinearGroup UpperHalfPlane CongruenceSubgroup HeckeRing.GL2
open scoped MatrixGroups

namespace TauCeti

variable (N : ℕ) [NeZero N] (k : ℤ)

/-- The restriction of a good prime Hecke operator to the new subspace. -/
def heckeTNew {p : ℕ} (hp : p.Prime) (hpN : Nat.Coprime p N) :
    Module.End ℂ (cuspFormsNew N k) :=
  (@heckeTCuspNat N _ k p ⟨hp.ne_zero⟩).restrict
    (fun _ hf ↦ heckeTCuspNat_mem_cuspFormsNew hp hpN hf)

/-- The restriction of a diamond operator to the new subspace. -/
def diamondNew (u : (ZMod N)ˣ) : Module.End ℂ (cuspFormsNew N k) :=
  (diamondOpCusp k u).restrict (fun _ hf ↦ diamondOpCusp_mem_cuspFormsNew u hf)

@[simp]
theorem coe_heckeTNew_apply {p : ℕ} (hp : p.Prime) (hpN : Nat.Coprime p N)
    (f : cuspFormsNew N k) :
    (heckeTNew N k hp hpN f : CuspForm ((Gamma1 N).map (mapGL ℝ)) k) =
      @heckeTCuspNat N _ k p ⟨hp.ne_zero⟩ f := (rfl)

@[simp]
theorem coe_diamondNew_apply (u : (ZMod N)ˣ) (f : cuspFormsNew N k) :
    (diamondNew N k u f : CuspForm ((Gamma1 N).map (mapGL ℝ)) k) = diamondOpCusp k u f := (rfl)

/-- The complex Hecke algebra on the new subspace, generated by the good `T_p` and diamonds.
This is an algebra of operators, not an algebra defined from prescribed eigenvalue systems. -/
def newHeckeAlgebra : Subalgebra ℂ (Module.End ℂ (cuspFormsNew N k)) :=
  Algebra.adjoin ℂ
    (Set.range (fun p : {p : ℕ // p.Prime ∧ Nat.Coprime p N} ↦ heckeTNew N k p.2.1 p.2.2) ∪
      Set.range (diamondNew N k))

/-- The defining generators of the complex newspace Hecke algebra. -/
theorem newHeckeAlgebra_def :
    newHeckeAlgebra N k = Algebra.adjoin ℂ
      (Set.range (fun p : {p : ℕ // p.Prime ∧ Nat.Coprime p N} ↦ heckeTNew N k p.2.1 p.2.2) ∪
        Set.range (diamondNew N k)) := (rfl)

@[simp]
theorem heckeTNew_mem_newHeckeAlgebra {p : ℕ} (hp : p.Prime) (hpN : Nat.Coprime p N) :
    heckeTNew N k hp hpN ∈ newHeckeAlgebra N k :=
  Algebra.subset_adjoin (Or.inl ⟨⟨p, hp, hpN⟩, rfl⟩)

@[simp]
theorem diamondNew_mem_newHeckeAlgebra (u : (ZMod N)ˣ) :
    diamondNew N k u ∈ newHeckeAlgebra N k :=
  Algebra.subset_adjoin (Or.inr ⟨u, rfl⟩)

/-- An algebra contains the newspace Hecke algebra exactly when it contains every good prime
Hecke operator and every diamond operator. -/
theorem newHeckeAlgebra_le_iff (A : Subalgebra ℂ (Module.End ℂ (cuspFormsNew N k))) :
    newHeckeAlgebra N k ≤ A ↔
      (∀ (p : ℕ) (hp : p.Prime) (hpN : Nat.Coprime p N), heckeTNew N k hp hpN ∈ A) ∧
        ∀ u : (ZMod N)ˣ, diamondNew N k u ∈ A := by
  rw [newHeckeAlgebra_def, Algebra.adjoin_le_iff, Set.union_subset_iff,
    Set.range_subset_iff, Set.range_subset_iff]
  simp

variable {N k}

private theorem heckeTNew_basis {p : ℕ} (hp : p.Prime) (hpN : Nat.Coprime p N)
    (f : Newform N k) :
    heckeTNew N k hp hpN (Newform.basis N k f) =
      f.eigenvalue ⟨p, hp.pos⟩ hpN • Newform.basis N k f := by
  apply Subtype.ext
  simpa using f.heckeTCuspNat_eq_eigenvalue_smul hp hpN

private theorem diamondNew_basis (u : (ZMod N)ˣ) (f : Newform N k) :
    diamondNew N k u (Newform.basis N k f) = (f.χ u : ℂ) • Newform.basis N k f := by
  apply Subtype.ext
  simpa using diamondOpCusp_apply_of_mem_cuspFormCharSpace k f.χ u f.mem_charSpace

private theorem newHeckeAlgebra_apply_basis (f : Newform N k) (T : newHeckeAlgebra N k) :
    T.1 (Newform.basis N k f) =
      (Newform.basis N k).repr (T.1 (Newform.basis N k f)) f • Newform.basis N k f := by
  obtain ⟨c, hc⟩ := exists_smul_eq_of_mem_adjoin (v := Newform.basis N k f) (by
    rintro _ (⟨p, rfl⟩ | ⟨u, rfl⟩)
    · exact ⟨_, heckeTNew_basis p.2.1 p.2.2 f⟩
    · exact ⟨_, diamondNew_basis u f⟩) T.2
  simp [hc]

end TauCeti

namespace HeckeRing.GL2.Newform

open TauCeti

variable {N : ℕ} [NeZero N] {k : ℤ}

/-- The complex character of the newspace Hecke algebra associated with a normalized newform. -/
def newHeckeCharacter (f : Newform N k) : newHeckeAlgebra N k →ₐ[ℂ] ℂ :=
  (newHeckeAlgebra N k).val.eigenvalueHomOfJointEigenvector
    (fun T ↦ (basis N k).repr (T.1 (basis N k f)) f) (basis N k f) (Module.Basis.ne_zero _ f)
    (fun T ↦ Module.End.mem_eigenspace_iff.mpr (newHeckeAlgebra_apply_basis f T))

/-- The character is the coordinate of the operator's image on its newform basis vector.
This is an explicit rewriting lemma: the character, rather than a basis coordinate, is the
normal form for eigenvalues. -/
theorem newHeckeCharacter_apply (f : Newform N k) (T : newHeckeAlgebra N k) :
    f.newHeckeCharacter T = (basis N k).repr (T.1 (basis N k f)) f := by
  rw [newHeckeCharacter, AlgHom.eigenvalueHomOfJointEigenvector_apply]

/-- Every operator in the newspace Hecke algebra acts on a newform by its character. -/
theorem apply_basis_eq_newHeckeCharacter_smul (f : Newform N k) (T : newHeckeAlgebra N k) :
    T.1 (basis N k f) = f.newHeckeCharacter T • basis N k f := by
  rw [newHeckeCharacter_apply]
  exact newHeckeAlgebra_apply_basis f T

/-- The character on a good `T_p` is the good Hecke eigenvalue, hence the Fourier coefficient
`a_p` of the normalized newform. -/
@[simp]
theorem newHeckeCharacter_apply_heckeTNew (f : Newform N k) {p : ℕ} (hp : p.Prime)
    (hpN : Nat.Coprime p N) :
    f.newHeckeCharacter ⟨heckeTNew N k hp hpN, heckeTNew_mem_newHeckeAlgebra N k hp hpN⟩ =
      f.eigenvalue ⟨p, hp.pos⟩ hpN := by
  apply smul_left_injective ℂ (Module.Basis.ne_zero (basis N k) f)
  exact (f.apply_basis_eq_newHeckeCharacter_smul _).symm.trans (heckeTNew_basis hp hpN f)

/-- The character on a diamond operator is the nebentypus value. -/
@[simp]
theorem newHeckeCharacter_apply_diamondNew (f : Newform N k) (u : (ZMod N)ˣ) :
    f.newHeckeCharacter ⟨diamondNew N k u, diamondNew_mem_newHeckeAlgebra N k u⟩ = (f.χ u : ℂ) := by
  apply smul_left_injective ℂ (Module.Basis.ne_zero (basis N k) f)
  exact (f.apply_basis_eq_newHeckeCharacter_smul _).symm.trans (diamondNew_basis u f)

/-- Distinct newforms give distinct characters of the newspace Hecke algebra. The diamond
values determine the nebentypus, and the good prime values then determine the newform. -/
theorem newHeckeCharacter_injective :
    Function.Injective (newHeckeCharacter (N := N) (k := k)) := by
  intro f g h
  have hχ : f.χ = g.χ := by
    ext u
    simpa only [newHeckeCharacter_apply_diamondNew] using DFunLike.congr_fun h
      ⟨diamondNew N k u, diamondNew_mem_newHeckeAlgebra N k u⟩
  apply eq_of_forall_prime_eigenvalue_eq hχ
  intro p hp hpN
  simpa only [newHeckeCharacter_apply_heckeTNew] using DFunLike.congr_fun h
    ⟨heckeTNew N k hp hpN, heckeTNew_mem_newHeckeAlgebra N k hp hpN⟩

/-- Every complex character of the newspace Hecke algebra belongs to a normalized newform. -/
theorem newHeckeCharacter_surjective :
    Function.Surjective (newHeckeCharacter (N := N) (k := k)) := by
  intro ψ
  obtain ⟨f, hf⟩ := AlgHom.exists_eq_of_apply_basis_eq_smul (newHeckeAlgebra N k).val
    Subtype.val_injective (basis N k) newHeckeCharacter
    (fun T f ↦ f.apply_basis_eq_newHeckeCharacter_smul T) ψ
  exact ⟨f, hf.symm⟩

/-- Evaluation on the newform basis identifies the complex newspace Hecke algebra with the
product of copies of `ℂ` indexed by normalized newforms. In particular it is a split semisimple
commutative algebra. -/
def newHeckeAlgebraEquiv : newHeckeAlgebra N k ≃ₐ[ℂ] (Newform N k → ℂ) :=
  AlgEquiv.ofBijective (AlgHom.pi newHeckeCharacter)
    (AlgHom.pi_bijective_of_apply_basis_eq_smul (newHeckeAlgebra N k).val
      Subtype.val_injective (basis N k) newHeckeCharacter
      (fun T f ↦ f.apply_basis_eq_newHeckeCharacter_smul T) newHeckeCharacter_injective)

@[simp]
theorem newHeckeAlgebraEquiv_apply (T : newHeckeAlgebra N k) (f : Newform N k) :
    newHeckeAlgebraEquiv T f = f.newHeckeCharacter T := (rfl)

/-- The normalized newforms are in bijection with the complex characters of the newspace
Hecke algebra. This statement is over `ℂ`; it supplies no rational descent or Galois action. -/
def newHeckeCharacterEquiv : Newform N k ≃ (newHeckeAlgebra N k →ₐ[ℂ] ℂ) :=
  Equiv.ofBijective newHeckeCharacter ⟨newHeckeCharacter_injective, newHeckeCharacter_surjective⟩

@[simp]
theorem newHeckeCharacterEquiv_apply (f : Newform N k) :
    newHeckeCharacterEquiv f = f.newHeckeCharacter := (rfl)

end HeckeRing.GL2.Newform

namespace TauCeti

/-- The newspace Hecke algebra is commutative, with its existing operator ring structure. -/
instance instCommRingNewHeckeAlgebra {N : ℕ} [NeZero N] {k : ℤ} :
    CommRing (newHeckeAlgebra N k) where
  __ := (newHeckeAlgebra N k).toRing
  mul_comm a b := by
    apply HeckeRing.GL2.Newform.newHeckeAlgebraEquiv.injective
    simp only [map_mul, mul_comm]

end TauCeti
