module

public import TauCeti.NumberTheory.ModularForms.Newforms.Hecke.Algebra
import TauCeti.LinearAlgebra.Dual.FiniteAlgebra
import TauCeti.NumberTheory.ModularForms.ModularSymbols.Period.Hecke
import TauCeti.NumberTheory.ModularForms.ModularSymbols.Period.Injective
import Mathlib.RingTheory.IntegralClosure.Algebra.Basic

/-!
# The integral Hecke algebra of the newspace

The good prime Hecke operators and the diamond operators generate a finite `ℤ`-algebra on
the newspace in weight at least two. Including diamonds retains the nebentypus information
when studying the rational algebra and its characters. Its complex algebraic span is the
complex newspace Hecke algebra.

Restriction of the complex newform characters gives integral-algebra characters. When `2 ≤ k`,
every value of such a character is an algebraic integer; the good-prime values are the Fourier
coefficients, and the diamond values are the nebentypus values.

## Main results

* `TauCeti.heckeTDiamondCuspNewIntegralAlgebra_finite`: finiteness over `ℤ` when `2 ≤ k`.
* `TauCeti.adjoin_heckeTDiamondCuspNewIntegralAlgebra`: recovery of the complex algebra.
* `TauCeti.Newform.isIntegral_heckeTDiamondCuspNewIntegralCharacter`: integrality of the
  restricted `heckeTDiamondCuspNewCharacter` when `2 ≤ k`.

## References

* [G. Shimura, *Introduction to the arithmetic theory of automorphic functions*][shimura1971],
  Chapter 3, especially Theorems 3.48 and 3.51.
* [T. Miyake, *Modular forms*][miyake1989], Section 4.5.
* `LinearMap.finite_adjoin_of_injective_pairing`, the underlying finite-algebra infrastructure.
-/

public noncomputable section

open Matrix.SpecialLinearGroup CongruenceSubgroup HeckeRing.GL2
open scoped MatrixGroups

namespace TauCeti

variable (N : ℕ) [NeZero N] (k : ℤ)

/-- The integral newspace Hecke algebra, generated by the good prime Hecke operators and
all diamond operators. -/
def heckeTDiamondCuspNewIntegralAlgebra :
    Subalgebra ℤ (Module.End ℂ (cuspFormsNew N k)) :=
  Algebra.adjoin ℤ
    (Set.range (fun p : {p : ℕ // p.Prime ∧ Nat.Coprime p N} ↦ heckeTCuspNewEnd N k p.2.1 p.2.2) ∪
      Set.range (diamondOpCuspNewEnd N k))

/-- The defining generators of the integral newspace Hecke algebra. -/
theorem heckeTDiamondCuspNewIntegralAlgebra_def :
    heckeTDiamondCuspNewIntegralAlgebra N k = Algebra.adjoin ℤ
      (Set.range (fun p : {p : ℕ // p.Prime ∧ Nat.Coprime p N} ↦
        heckeTCuspNewEnd N k p.2.1 p.2.2) ∪ Set.range (diamondOpCuspNewEnd N k)) := (rfl)

/-- Each good prime Hecke operator belongs to the integral newspace Hecke algebra. -/
@[simp]
theorem heckeTCuspNewEnd_mem_heckeTDiamondCuspNewIntegralAlgebra {p : ℕ} (hp : p.Prime)
    (hpN : Nat.Coprime p N) :
    heckeTCuspNewEnd N k hp hpN ∈ heckeTDiamondCuspNewIntegralAlgebra N k :=
  Algebra.subset_adjoin (Or.inl ⟨⟨p, hp, hpN⟩, rfl⟩)

/-- Each diamond operator belongs to the integral newspace Hecke algebra. -/
@[simp]
theorem diamondOpCuspNewEnd_mem_heckeTDiamondCuspNewIntegralAlgebra (u : (ZMod N)ˣ) :
    diamondOpCuspNewEnd N k u ∈ heckeTDiamondCuspNewIntegralAlgebra N k :=
  Algebra.subset_adjoin (Or.inr ⟨u, rfl⟩)

/-- An integral algebra contains the newspace Hecke algebra exactly when it contains every
good prime Hecke operator and every diamond operator. -/
theorem heckeTDiamondCuspNewIntegralAlgebra_le_iff
    (A : Subalgebra ℤ (Module.End ℂ (cuspFormsNew N k))) :
    heckeTDiamondCuspNewIntegralAlgebra N k ≤ A ↔
      (∀ (p : ℕ) (hp : p.Prime) (hpN : Nat.Coprime p N), heckeTCuspNewEnd N k hp hpN ∈ A) ∧
        ∀ u : (ZMod N)ˣ, diamondOpCuspNewEnd N k u ∈ A := by
  rw [heckeTDiamondCuspNewIntegralAlgebra_def, Algebra.adjoin_le_iff, Set.union_subset_iff,
    Set.range_subset_iff, Set.range_subset_iff]
  simp

/-- Every integral newspace Hecke operator lies in the complex newspace Hecke algebra. -/
theorem heckeTDiamondCuspNewIntegralAlgebra_le :
    heckeTDiamondCuspNewIntegralAlgebra N k ≤
      (heckeTDiamondCuspNewAlgebra N k).restrictScalars ℤ :=
  (heckeTDiamondCuspNewIntegralAlgebra_le_iff N k _).mpr
    ⟨fun _ hp hpN ↦ heckeTCuspNewEnd_mem_heckeTDiamondCuspNewAlgebra N k hp hpN,
      diamondOpCuspNewEnd_mem_heckeTDiamondCuspNewAlgebra N k⟩

/-- The natural inclusion of the integral newspace Hecke algebra into its complex algebra. -/
def heckeTDiamondCuspNewIntegralAlgebraToComplex :
    heckeTDiamondCuspNewIntegralAlgebra N k →ₐ[ℤ] heckeTDiamondCuspNewAlgebra N k :=
  (heckeTDiamondCuspNewIntegralAlgebra N k).val.codRestrict _ fun T ↦
    heckeTDiamondCuspNewIntegralAlgebra_le N k T.2

@[simp]
theorem coe_heckeTDiamondCuspNewIntegralAlgebraToComplex
    (T : heckeTDiamondCuspNewIntegralAlgebra N k) :
    (heckeTDiamondCuspNewIntegralAlgebraToComplex N k T : Module.End ℂ (cuspFormsNew N k)) = T :=
  (rfl)

/-- The natural inclusion into the complex newspace Hecke algebra is injective. -/
theorem heckeTDiamondCuspNewIntegralAlgebraToComplex_injective :
    Function.Injective (heckeTDiamondCuspNewIntegralAlgebraToComplex N k) := by
  intro T S h
  apply Subtype.ext
  simpa only [coe_heckeTDiamondCuspNewIntegralAlgebraToComplex] using
    congrArg (fun U : heckeTDiamondCuspNewAlgebra N k ↦
      (U : Module.End ℂ (cuspFormsNew N k))) h

/-- The complex algebraic span of the integral newspace Hecke algebra is the complex
newspace Hecke algebra. -/
theorem adjoin_heckeTDiamondCuspNewIntegralAlgebra :
    Algebra.adjoin ℂ (heckeTDiamondCuspNewIntegralAlgebra N k : Set _) =
      heckeTDiamondCuspNewAlgebra N k := by
  apply le_antisymm
  · exact Algebra.adjoin_le (heckeTDiamondCuspNewIntegralAlgebra_le N k)
  · refine (heckeTDiamondCuspNewAlgebra_le_iff N k _).mpr ⟨?_, ?_⟩
    · intro p hp hpN
      exact Algebra.subset_adjoin (heckeTCuspNewEnd_mem_heckeTDiamondCuspNewIntegralAlgebra N k
        hp hpN)
    · intro u
      exact Algebra.subset_adjoin (diamondOpCuspNewEnd_mem_heckeTDiamondCuspNewIntegralAlgebra N k
        u)

/-- The integral newspace Hecke algebra, including diamonds, is finite over `ℤ` in weight
at least two. -/
theorem heckeTDiamondCuspNewIntegralAlgebra_finite (hk : 2 ≤ k) :
    Module.Finite ℤ (heckeTDiamondCuspNewIntegralAlgebra N k) := by
  let w := (k - 2).toNat
  have hw : k = (w : ℤ) + 2 := by omega
  let P := ((ModularSymbols.periodMap ℤ (Gamma1 N) hw).comp
    (cuspFormsNew N k).subtype).restrictScalars ℤ
  let t := Sum.elim
    (fun p : {p : ℕ // p.Prime ∧ Nat.Coprime p N} ↦ heckeTCuspNewEnd N k p.2.1 p.2.2)
    (diamondOpCuspNewEnd N k)
  let u : {p : ℕ // p.Prime ∧ Nat.Coprime p N} ⊕ (ZMod N)ˣ →
      Module.End ℤ (ModularSymbols ℤ (Gamma1 N) w) := Sum.elim
    (fun p ↦ @ModularSymbols.heckeTSymbol ℤ _ w N _ p.1 ⟨p.2.1.ne_zero⟩)
    (fun d ↦
      let γ := (Gamma0Map_toHomUnits_surjective d).choose
      ModularSymbols.heckeSymbol (Gamma1 N) (Gamma1 N) (diamondCosetGamma1 N γ)
        (HeckeRing.GL2.Delta0_le_intEntries N (diamondCosetGamma1 N γ).out.property))
  have hP : Function.Injective P :=
    (ModularSymbols.periodMap_injective hw).comp Subtype.val_injective
  rw [heckeTDiamondCuspNewIntegralAlgebra_def, ← Set.Sum.elim_range]
  apply LinearMap.finite_adjoin_of_injective_pairing P hP t u
  intro i f x
  cases i with
  | inl p =>
      simpa only [P, t, u, Sum.elim, LinearMap.restrictScalars_apply, LinearMap.comp_apply,
        Submodule.subtype_apply, coe_heckeTCuspNewEnd_apply] using LinearMap.congr_fun
        (@ModularSymbols.periodMap_heckeTCuspNat ℤ _ _ k w N _ p.1 ⟨p.2.1.ne_zero⟩ hw f.1) x
  | inr d =>
      have h := ModularSymbols.periodMap_diamondOpCusp (R := ℤ) N
        (Gamma0Map_toHomUnits_surjective d).choose hw f.1
      rw [(Gamma0Map_toHomUnits_surjective d).choose_spec] at h
      simpa only [P, t, u, Sum.elim, LinearMap.restrictScalars_apply, LinearMap.comp_apply,
        Submodule.subtype_apply, coe_diamondOpCuspNewEnd_apply] using LinearMap.congr_fun h x

/-- The integral newspace Hecke algebra is commutative with its existing operator product. -/
instance instCommRingHeckeTDiamondCuspNewIntegralAlgebra :
    CommRing (heckeTDiamondCuspNewIntegralAlgebra N k) where
  __ := (heckeTDiamondCuspNewIntegralAlgebra N k).toRing
  mul_comm a b := by
    apply Subtype.ext
    exact congrArg (fun T : heckeTDiamondCuspNewAlgebra N k ↦
      (T : Module.End ℂ (cuspFormsNew N k)))
      (mul_comm (heckeTDiamondCuspNewIntegralAlgebraToComplex N k a)
        (heckeTDiamondCuspNewIntegralAlgebraToComplex N k b))

namespace Newform

variable {N k}

/-- A newform's eigenvalue character on the integral newspace Hecke algebra, obtained by
restricting its complex character. -/
def heckeTDiamondCuspNewIntegralCharacter (f : Newform N k) :
    heckeTDiamondCuspNewIntegralAlgebra N k →ₐ[ℤ] ℂ :=
  ((heckeTDiamondCuspNewCharacter f).restrictScalars ℤ).comp
    (heckeTDiamondCuspNewIntegralAlgebraToComplex N k)

/-- Evaluation of the integral character through the inclusion into the complex algebra. -/
@[simp low]
theorem heckeTDiamondCuspNewIntegralCharacter_apply (f : Newform N k)
    (T : heckeTDiamondCuspNewIntegralAlgebra N k) :
    heckeTDiamondCuspNewIntegralCharacter f T = heckeTDiamondCuspNewCharacter f
      (heckeTDiamondCuspNewIntegralAlgebraToComplex N k T) := (rfl)

/-- The integral character on a good prime Hecke operator is its Hecke eigenvalue. -/
@[simp]
theorem heckeTDiamondCuspNewIntegralCharacter_apply_heckeTCuspNewEnd (f : Newform N k)
    {p : ℕ} (hp : p.Prime) (hpN : Nat.Coprime p N) :
    heckeTDiamondCuspNewIntegralCharacter f ⟨heckeTCuspNewEnd N k hp hpN,
      heckeTCuspNewEnd_mem_heckeTDiamondCuspNewIntegralAlgebra N k hp hpN⟩ =
      f.eigenvalue ⟨p, hp.pos⟩ hpN := by
  rw [heckeTDiamondCuspNewIntegralCharacter_apply]
  exact heckeTDiamondCuspNewCharacter_apply_heckeTCuspNewEnd f hp hpN

/-- The integral character on a diamond operator is its nebentypus value. -/
@[simp]
theorem heckeTDiamondCuspNewIntegralCharacter_apply_diamondOpCuspNewEnd (f : Newform N k)
    (d : (ZMod N)ˣ) :
    heckeTDiamondCuspNewIntegralCharacter f ⟨diamondOpCuspNewEnd N k d,
      diamondOpCuspNewEnd_mem_heckeTDiamondCuspNewIntegralAlgebra N k d⟩ = (f.χ d : ℂ) := by
  rw [heckeTDiamondCuspNewIntegralCharacter_apply]
  exact heckeTDiamondCuspNewCharacter_apply_diamondOpCuspNewEnd f d

/-- Every value of the integral newform character is an algebraic integer in weight at
least two. -/
theorem isIntegral_heckeTDiamondCuspNewIntegralCharacter (f : Newform N k) (hk : 2 ≤ k)
    (T : heckeTDiamondCuspNewIntegralAlgebra N k) :
    IsIntegral ℤ (heckeTDiamondCuspNewIntegralCharacter f T) := by
  have := heckeTDiamondCuspNewIntegralAlgebra_finite N k hk
  exact (IsIntegral.of_finite ℤ T).map (heckeTDiamondCuspNewIntegralCharacter f)

end Newform

end TauCeti
