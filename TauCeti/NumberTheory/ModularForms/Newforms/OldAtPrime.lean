/-!
# The old and new subspaces at a prime

Fix a prime `q` dividing the level `N`. The **`q`-old subspace** `S_k(Γ₁(N))^{q-old}` is spanned
by the level-raises `V_d f` of the forms `f` of the levels `M` whose `q`-adic valuation is smaller
than that of `N`, that is with `q * M ∣ N`; it is generated by the two degeneracy maps
`V₁, V_q : S_k(Γ₁(N / q)) → S_k(Γ₁(N))`. The **`q`-new subspace** is its Petersson-orthogonal
complement. Every oldform from a level with smaller `q`-part is `q`-old, so the `q`-old subspace
lies in the old subspace and every newform is `q`-new.

The point of the `q`-new subspace is that it is stable under the level-raises `V_d` that do not
raise the `q`-adic valuation of the level: if `G` is `q`-new of level `K`, `d * K ∣ K'` and
`q * K ∤ K'`, then `V_d G` is `q`-new of level `K'`
(`TauCeti.levelRaise_mem_cuspFormsNewAt`). This is what separates two newforms of levels
with different `q`-parts when they are compared at a common level, the step behind strong
multiplicity one across unrelated levels.

## Main definitions

* `TauCeti.cuspFormsOldAt N k q`: the `q`-old subspace of `S_k(Γ₁(N))`.
* `TauCeti.cuspFormsNewAt N k q`: the `q`-new subspace, its Petersson-orthogonal complement;
  `TauCeti.mem_cuspFormsNewAt_iff` tests it on the level-raises.

## Main results

* `TauCeti.levelRaise_mem_cuspFormsOldAt` and `TauCeti.cuspFormsOldAt_le`: the introduction and
  elimination rules of the `q`-old subspace; `TauCeti.cuspFormsOldAt_le_of_prime` is the
  elimination rule through the two degeneracy maps from level `N / q`.
* `TauCeti.cuspFormsOldAt_le_cuspFormsOld`, `TauCeti.cuspFormsNew_le_cuspFormsNewAt`: `q`-old
  forms are old, and newforms are `q`-new; `TauCeti.cuspFormsNewAt_eq_top`: for `q ∤ N` every
  form is `q`-new.
* `TauCeti.levelRaise_mem_cuspFormsOldAt_of_mem`: `V_d` carries `q`-old forms to `q`-old forms.
* `TauCeti.frickeOperatorCusp_mem_cuspFormsNewAt_iff`: the Fricke involution preserves the
  `q`-new subspace.
* `TauCeti.peterssonInnerCosets_levelRaise_eq_zero_iff`: `⟪V_q φ, H⟫` vanishes exactly when the
  pairing of `φ` with `H ∣ diag(q, 1)⁻¹` on `diag(q, 1) Γ₁(N) diag(q, 1)⁻¹` does.
* `TauCeti.restrict_mem_cuspFormsNewAt`, `TauCeti.levelRaise_mem_cuspFormsNewAt`: restriction to
  a level with the same `q`-part, and more generally `V_d` with `q * K ∤ K'`, preserve `q`-newness.

## References

* A. O. L. Atkin and J. Lehner, *Hecke operators on `Γ₀(m)`*, Math. Ann. 185 (1970), 134–160.
* W.-C. W. Li, *Newforms and functional equations*, Math. Ann. 212 (1975), 285–315.
* [T. Miyake, *Modular forms*][miyake1989], Section 4.6.
* [F. Diamond and J. Shurman, *A first course in modular forms*][diamondshurman2005], Section 5.6.
-/

public section

noncomputable section

open Matrix.SpecialLinearGroup UpperHalfPlane CongruenceSubgroup

open scoped MatrixGroups ModularForm Pointwise ComplexConjugate

namespace TauCeti

open _root_.CuspForm

variable {k : ℤ}

/-! ### The `q`-old subspace -/

/-- The **`q`-old subspace** of `S_k(Γ₁(N))`: the span of the level-raises
`V_d : S_k(Γ₁(M)) → S_k(Γ₁(N))` over the pairs `(M, d)` with `d * M ∣ N` and `q * M ∣ N`, that is
from the levels `M` whose `q`-part is a proper divisor of that of `N`. For a prime `q ∣ N` it is
generated by the two degeneracy maps from level `N / q` (`cuspFormsOldAt_le_of_prime`). -/
def cuspFormsOldAt (N : ℕ) [NeZero N] (k : ℤ) (q : ℕ) :
    Submodule ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k) :=
  ⨆ (M : ℕ) (d : ℕ) (h : d * M ∣ N ∧ q * M ∣ N),
    have : NeZero d := NeZero.of_dvd (dvd_of_mul_right_dvd h.1)
    LinearMap.range (CuspForm.levelRaiseₗ (k := k) d (Gamma1_map_le_conjAct_scaleGL_of_dvd h.1))

variable {M d N q : ℕ}

/-- **Introduction rule for the `q`-old subspace**: a level-raise from a level `M` with
`q * M ∣ N` is `q`-old. -/
theorem levelRaise_mem_cuspFormsOldAt [NeZero N] (h : d * M ∣ N) (hq : q * M ∣ N) (k : ℤ)
    (f : CuspForm ((Gamma1 M).map (mapGL ℝ)) k) :
    haveI : NeZero d := NeZero.of_dvd (dvd_of_mul_right_dvd h)
    CuspForm.levelRaise d (Gamma1_map_le_conjAct_scaleGL_of_dvd h) f ∈ cuspFormsOldAt N k q :=
  let _ := NeZero.of_dvd (dvd_of_mul_right_dvd h)
  Submodule.mem_iSup_of_mem M (Submodule.mem_iSup_of_mem d
    (Submodule.mem_iSup_of_mem ⟨h, hq⟩ ⟨f, CuspForm.levelRaiseₗ_apply d _ f⟩))

/-- **Elimination rule for the `q`-old subspace**: a subspace containing every level-raise from a
level `M` with `q * M ∣ N` contains the `q`-old subspace. -/
theorem cuspFormsOldAt_le [NeZero N] {V : Submodule ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k)}
    (hV : ∀ (M d : ℕ) (h : d * M ∣ N), q * M ∣ N →
      ∀ f : CuspForm ((Gamma1 M).map (mapGL ℝ)) k,
        haveI : NeZero d := NeZero.of_dvd (dvd_of_mul_right_dvd h)
        CuspForm.levelRaise d (Gamma1_map_le_conjAct_scaleGL_of_dvd h) f ∈ V) :
    cuspFormsOldAt N k q ≤ V := by
  refine iSup_le fun M ↦ iSup_le fun d ↦ iSup_le fun h ↦ ?_
  have := NeZero.of_dvd (dvd_of_mul_right_dvd h.1)
  rintro _ ⟨f, rfl⟩
  rw [CuspForm.levelRaiseₗ_apply]
  exact hV M d h.1 h.2 f

/-- **The `q`-old subspace is generated by the two degeneracy maps from level `N / q`.** For a
prime `q` and `q * L = N`, a subspace containing the restrictions `V₁ f` and the level-raises
`V_q f` of the forms `f` of level `L` contains the `q`-old subspace. -/
theorem cuspFormsOldAt_le_of_prime [NeZero N] {L : ℕ} (hq : q.Prime) (hL : q * L = N)
    {V : Submodule ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k)}
    (h₁ : ∀ f : CuspForm ((Gamma1 L).map (mapGL ℝ)) k,
      CuspForm.restrict (Gamma1_map_le_Gamma1_map_of_dvd (Dvd.intro_left q hL)) f ∈ V)
    (h₂ : ∀ f : CuspForm ((Gamma1 L).map (mapGL ℝ)) k,
      haveI : NeZero q := ⟨hq.ne_zero⟩
      CuspForm.levelRaise q (Gamma1_map_le_conjAct_scaleGL_of_dvd (dvd_of_eq hL)) f ∈ V) :
    cuspFormsOldAt N k q ≤ V := by
  have : NeZero q := ⟨hq.ne_zero⟩
  have : NeZero L := NeZero.of_dvd (Dvd.intro_left q hL)
  -- a level-raise `V_d f` with `q * M ∣ N` factors as `V_q ∘ V_{d / q}` if `q ∣ d`, and as
  -- `V₁ ∘ V_d` through level `L` otherwise
  refine cuspFormsOldAt_le fun M d hdM hqM f ↦ ?_
  have : NeZero d := NeZero.of_dvd (dvd_of_mul_right_dvd hdM)
  have : NeZero M := NeZero.of_dvd (dvd_of_mul_left_dvd hdM)
  rw [← hL] at hdM hqM
  have hML : M ∣ L := Nat.dvd_of_mul_dvd_mul_left hq.pos hqM
  by_cases hqd : q ∣ d
  · -- `V_d = V_q ∘ V_{d / q}`, the inner raise landing at level `L`
    obtain ⟨e, rfl⟩ := hqd
    have : NeZero e := NeZero.of_dvd (Dvd.intro_left q rfl)
    have heM : e * M ∣ L := Nat.dvd_of_mul_dvd_mul_left hq.pos (by rwa [mul_assoc] at hdM)
    convert h₂ (CuspForm.levelRaise e (Gamma1_map_le_conjAct_scaleGL_of_dvd heM) f) using 1
    ext τ
    simp only [CuspForm.levelRaise_apply, smul_smul, ← scaleGL_mul, mul_comm q e]
  · -- `V_d = V₁ ∘ V_d`, the inner raise landing at level `L`, as `d` is prime to `q`
    have hdL : d * M ∣ L := by
      obtain ⟨t, rfl⟩ := hML
      have h1 : d ∣ q * t := Nat.dvd_of_mul_dvd_mul_right (Nat.pos_of_ne_zero (NeZero.ne M))
        (by rwa [show q * (M * t) = q * t * M by ring] at hdM)
      have h2 : d ∣ t :=
        (Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd hq).mpr hqd)).dvd_of_dvd_mul_left h1
      rw [mul_comm d M]
      exact mul_dvd_mul_left M h2
    convert h₁ (CuspForm.levelRaise d (Gamma1_map_le_conjAct_scaleGL_of_dvd hdL) f) using 1
    ext τ
    simp

/-- **`q`-old forms are old**: for `q ≠ 1`, a level `M` with `q * M ∣ N` is a proper divisor
of `N`. -/
theorem cuspFormsOldAt_le_cuspFormsOld [NeZero N] (hq : q ≠ 1) :
    cuspFormsOldAt N k q ≤ cuspFormsOld N k :=
  cuspFormsOldAt_le fun M d h hqM f ↦ levelRaise_mem_cuspFormsOld h (fun hMN ↦ hq <|
    Nat.dvd_one.mp <| Nat.dvd_of_mul_dvd_mul_right (Nat.pos_of_ne_zero (NeZero.ne N))
      (by rw [one_mul]; exact hMN ▸ hqM)) k f

/-- **`V_d` carries `q`-old forms to `q`-old forms**: if `d * K ∣ K'`, then `V_d` maps
`S_k(Γ₁(K))^{q-old}` into `S_k(Γ₁(K'))^{q-old}`, since `V_d ∘ V_e = V_{e d}`. -/
theorem levelRaise_mem_cuspFormsOldAt_of_mem {K K' : ℕ} [NeZero K] [NeZero K'] [NeZero d]
    (hdK : d * K ∣ K') {G : CuspForm ((Gamma1 K).map (mapGL ℝ)) k}
    (hG : G ∈ cuspFormsOldAt K k q) :
    CuspForm.levelRaise d (Gamma1_map_le_conjAct_scaleGL_of_dvd hdK) G ∈
      cuspFormsOldAt K' k q := by
  rw [← CuspForm.levelRaiseₗ_apply, ← Submodule.mem_comap]
  refine (cuspFormsOldAt_le (V := (cuspFormsOldAt K' k q).comap
    (CuspForm.levelRaiseₗ d (Gamma1_map_le_conjAct_scaleGL_of_dvd hdK)))
    fun M e he hqM f ↦ ?_) hG
  have : NeZero e := NeZero.of_dvd (dvd_of_mul_right_dvd he)
  have hedM : e * d * M ∣ K' :=
    (by rw [mul_right_comm]; exact mul_dvd_mul_right he d : e * d * M ∣ K * d).trans
      (by rw [mul_comm]; exact hdK)
  have hqM' : q * M ∣ K' := hqM.trans ((Dvd.intro_left d rfl).trans hdK)
  rw [Submodule.mem_comap, CuspForm.levelRaiseₗ_apply, CuspForm.levelRaise_levelRaise]
  exact levelRaise_mem_cuspFormsOldAt hedM hqM' k f

/-! ### The `q`-new subspace -/

/-- The **`q`-new subspace** of `S_k(Γ₁(N))`: the Petersson-orthogonal complement of the
`q`-old subspace. -/
def cuspFormsNewAt (N : ℕ) [NeZero N] (k : ℤ) (q : ℕ) :
    Submodule ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k) :=
  CuspForm.peterssonOrthogonal (cuspFormsOldAt N k q)

/-- Defining equation for `cuspFormsNewAt`: it is the Petersson-orthogonal complement of the
`q`-old subspace. -/
lemma cuspFormsNewAt_def (N : ℕ) [NeZero N] (k : ℤ) (q : ℕ) :
    cuspFormsNewAt N k q = CuspForm.peterssonOrthogonal (cuspFormsOldAt N k q) := (rfl)

/-- **`q`-newness is tested on the level-raises.** A cusp form of level `N` is `q`-new exactly
when it is Petersson-orthogonal to `V_d g` for every cusp form `g` of a level `M` with
`q * M ∣ N`. -/
@[simp]
theorem mem_cuspFormsNewAt_iff [NeZero N] {f : CuspForm ((Gamma1 N).map (mapGL ℝ)) k} :
    f ∈ cuspFormsNewAt N k q ↔ ∀ (M d : ℕ) (h : d * M ∣ N), q * M ∣ N →
      ∀ g : CuspForm ((Gamma1 M).map (mapGL ℝ)) k,
        haveI : NeZero d := NeZero.of_dvd (dvd_of_mul_right_dvd h)
        peterssonInnerCosets
          (CuspForm.levelRaise d (Gamma1_map_le_conjAct_scaleGL_of_dvd h) g) f = 0 := by
  rw [cuspFormsNewAt_def]
  refine ⟨fun hf M d h hqM g ↦ CuspForm.mem_peterssonOrthogonal_iff.mp hf _
    (levelRaise_mem_cuspFormsOldAt h hqM k g), fun h ↦ ?_⟩
  rw [CuspForm.mem_peterssonOrthogonal_iff_le_ker]
  refine cuspFormsOldAt_le fun M d hdvd hqM g ↦ ?_
  rw [LinearMap.mem_ker, CuspForm.peterssonInnerCosetsₛₗ_apply_apply,
    ← peterssonInnerCosets_conj_symm, h M d hdvd hqM g, map_zero]

/-- **The `q`-old and `q`-new subspaces are complements**, so every cusp form splits uniquely as
a `q`-old form plus a `q`-new form. -/
theorem isCompl_cuspFormsOldAt_cuspFormsNewAt (N : ℕ) [NeZero N] (k : ℤ) (q : ℕ) :
    IsCompl (cuspFormsOldAt N k q) (cuspFormsNewAt N k q) :=
  CuspForm.isCompl_peterssonOrthogonal _

/-- **Newforms are `q`-new**: for `q ≠ 1` the `q`-old subspace lies in the old subspace, so its
orthogonal complement contains the new subspace. -/
theorem cuspFormsNew_le_cuspFormsNewAt [NeZero N] (hq : q ≠ 1) :
    cuspFormsNew N k ≤ cuspFormsNewAt N k q := by
  rw [cuspFormsNew_def, cuspFormsNewAt_def]
  exact CuspForm.peterssonOrthogonal_le (cuspFormsOldAt_le_cuspFormsOld hq)

/-- **Away from the level there are no `q`-old forms**: if `q ∤ N`, no level `M` has
`q * M ∣ N`. -/
@[simp]
theorem cuspFormsOldAt_eq_bot [NeZero N] (hqN : ¬q ∣ N) : cuspFormsOldAt N k q = ⊥ :=
  le_bot_iff.mp <| cuspFormsOldAt_le fun M _ _ hqM _ ↦ absurd ((Dvd.intro M rfl).trans hqM) hqN

/-- **Away from the level every form is `q`-new.** -/
@[simp]
theorem cuspFormsNewAt_eq_top [NeZero N] (hqN : ¬q ∣ N) : cuspFormsNewAt N k q = ⊤ := by
  rw [cuspFormsNewAt_def, cuspFormsOldAt_eq_bot hqN, CuspForm.peterssonOrthogonal_bot]

/-- **Restriction from a level `M` with `q * M ∣ N` is `q`-old**: it is the level-raise `V₁`. -/
theorem restrict_mem_cuspFormsOldAt [NeZero N] (hq : q * M ∣ N) (k : ℤ)
    (f : CuspForm ((Gamma1 M).map (mapGL ℝ)) k) :
    CuspForm.restrict (Gamma1_map_le_Gamma1_map_of_dvd (dvd_of_mul_left_dvd hq)) f ∈
      cuspFormsOldAt N k q := by
  have := levelRaise_mem_cuspFormsOldAt (d := 1) (by rw [one_mul]; exact dvd_of_mul_left_dvd hq)
    hq k f
  rwa [CuspForm.levelRaise_one] at this

/-! ### The Fricke involution -/

/-- **The Fricke operator preserves the `q`-old subspace.** It carries a level-raise `V_d f` from
a level `M` with `q * M ∣ N` to a multiple of `V_e (W_M f)` for the complementary
`e = N / (d * M)` (`frickeOperatorCusp_levelRaise`), again a level-raise from `M`. -/
theorem frickeOperatorCusp_mem_cuspFormsOldAt [NeZero N]
    {f : CuspForm ((Gamma1 N).map (mapGL ℝ)) k} (hf : f ∈ cuspFormsOldAt N k q) :
    frickeOperatorCusp k f ∈ cuspFormsOldAt N k q := by
  refine (cuspFormsOldAt_le (V := (cuspFormsOldAt N k q).comap (frickeOperatorCusp k))
    fun M d hdM hqM g ↦ ?_) hf
  obtain ⟨e, he⟩ := hdM
  have hN : d * e * M = N := by rw [he]; ring
  have heM : e * M ∣ N := ⟨d, by rw [← hN]; ring⟩
  have : NeZero d := NeZero.of_dvd (dvd_of_mul_right_dvd ⟨e, he⟩)
  have : NeZero M := NeZero.of_dvd (dvd_of_mul_left_dvd ⟨e, he⟩)
  have : NeZero e := NeZero.of_dvd (dvd_of_mul_right_dvd heM)
  rw [Submodule.mem_comap, frickeOperatorCusp_levelRaise hN _
    (Gamma1_map_le_conjAct_scaleGL_of_dvd heM)]
  exact Submodule.smul_mem _ _ (levelRaise_mem_cuspFormsOldAt heM hqM k _)

/-- **The Fricke operator preserves the `q`-new subspace**, in both directions. -/
theorem frickeOperatorCusp_mem_cuspFormsNewAt_iff [NeZero N]
    {f : CuspForm ((Gamma1 N).map (mapGL ℝ)) k} :
    frickeOperatorCusp k f ∈ cuspFormsNewAt N k q ↔ f ∈ cuspFormsNewAt N k q := by
  -- the normalized operator `𝒲_N`, a nonzero multiple of `W_N`, has Petersson adjoint
  -- `(-1) ^ k 𝒲_N`, which preserves the `q`-old subspace; and `W_N ∘ W_N` is a nonzero scalar
  have hW : ∀ {g : CuspForm ((Gamma1 N).map (mapGL ℝ)) k}, g ∈ cuspFormsNewAt N k q →
      frickeOperatorCusp k g ∈ cuspFormsNewAt N k q := by
    intro g hg
    have h := normalizedFrickeOperatorCusp_mem_peterssonOrthogonal (fun x hx ↦ by
      rw [normalizedFrickeOperatorCusp_def, LinearMap.smul_apply]
      exact Submodule.smul_mem _ _ (frickeOperatorCusp_mem_cuspFormsOldAt hx))
      (cuspFormsNewAt_def N k q ▸ hg)
    rw [normalizedFrickeOperatorCusp_def, LinearMap.smul_apply, ← cuspFormsNewAt_def] at h
    have := (cuspFormsNewAt N k q).smul_mem (atkinLehnerNormalizer N k)⁻¹ h
    rwa [smul_smul, inv_mul_cancel₀ (atkinLehnerNormalizer_ne_zero (NeZero.ne N) k),
      one_smul] at this
  refine ⟨fun h ↦ ?_, hW⟩
  have := (cuspFormsNewAt N k q).smul_mem (frickeScalar N k)⁻¹ (hW h)
  rwa [frickeOperatorCusp_frickeOperatorCusp_apply, smul_smul,
    inv_mul_cancel₀ (frickeScalar_ne_zero k), one_smul] at this

/-! ### Conjugating the pairing by `diag(q, 1)` -/

/-- **`⟪V_q φ, H⟫` vanishes exactly when its `diag(q, 1)`-conjugate does**: the pairing on
`Γ₁(N)` of `V_q φ` with `H` vanishes exactly when the pairing on
`diag(q, 1) Γ₁(N) diag(q, 1)⁻¹` of `φ` with `H ∣ diag(q, 1)⁻¹` does. -/
lemma peterssonInnerCosets_levelRaise_eq_zero_iff [NeZero q] [NeZero N]
    {hqM : q * M ∣ N} {φ : CuspForm ((Gamma1 M).map (mapGL ℝ)) k}
    {H : CuspForm ((Gamma1 N).map (mapGL ℝ)) k} :
    peterssonInnerCosets (CuspForm.levelRaise q (Gamma1_map_le_conjAct_scaleGL_of_dvd hqM) φ) H =
        0 ↔
      peterssonInnerCosets
        (CuspForm.restrict (Subgroup.map_mono (gamma1Conj_le_Gamma1 hqM)) φ)
        (CuspForm.restrict map_gamma1Conj_le
          (CuspForm.translate H (scaleGL q)⁻¹)) = 0 := by
  -- conjugating by `diag(q, 1)` carries the first pairing, of `V_q φ`, a multiple of
  -- `φ ∣ diag(q, 1)`, to a nonzero multiple of the second
  have hq0 : (q : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne q)
  have hdet : 0 < ((scaleGL q : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ).det := by
    rw [coe_scaleGL, Matrix.det_fin_two_of]
    simpa using Nat.pos_of_ne_zero (NeZero.ne q)
  have key := TauCeti.CuspForm.peterssonInnerCosets_slash_of_inv_conjAct_eq hdet
    (inv_conjAct_map_gamma1Conj ((Dvd.intro M rfl).trans hqM))
    (f := CuspForm.restrict (Subgroup.map_mono (gamma1Conj_le_Gamma1 hqM)) φ)
    (g := CuspForm.restrict map_gamma1Conj_le
      (CuspForm.translate H (scaleGL q)⁻¹))
    (F := (q : ℂ) ^ (k - 1) • CuspForm.levelRaise q (Gamma1_map_le_conjAct_scaleGL_of_dvd hqM) φ)
    (G := H) (by
      rw [FunLike.coe_smul, CuspForm.coe_levelRaise, CuspForm.coe_restrict, smul_smul,
        ← zpow_add₀ hq0]
      simp)
    (by rw [CuspForm.coe_restrict, CuspForm.coe_translate, ← SlashAction.slash_mul,
      inv_mul_cancel, SlashAction.slash_one])
  rw [peterssonInnerCosets_smul_left] at key
  have hl : conj ((q : ℂ) ^ (k - 1)) ≠ 0 := (map_ne_zero _).mpr (zpow_ne_zero _ hq0)
  have hr : (((scaleGL q : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ).det : ℂ) ^ (k - 2) ≠ 0 :=
    zpow_ne_zero _ (Complex.ofReal_ne_zero.mpr hdet.ne')
  constructor
  · intro h
    rw [h, mul_zero] at key
    exact (mul_eq_zero.mp key.symm).resolve_left hr
  · intro h
    rw [h, mul_zero] at key
    exact (mul_eq_zero.mp key).resolve_left hl

/-! ### Restriction preserves `q`-newness -/

variable {n m K K' : ℕ}

/-- Orthogonality to the restrictions of the forms of level `K' / q`. -/
private lemma peterssonInnerCosets_restrict_restrict_eq_zero_of_mem_cuspFormsNewAt [NeZero n]
    [NeZero m] [NeZero K] [NeZero K'] (hq : q.Prime) (hn : q * n = K) (hm : q * m = K')
    (hnm : n ∣ m) (hqnm : ¬q * n ∣ m) (hKK' : K ∣ K')
    {G : CuspForm ((Gamma1 K).map (mapGL ℝ)) k} (hG : G ∈ cuspFormsNewAt K k q)
    (φ : CuspForm ((Gamma1 m).map (mapGL ℝ)) k) :
    peterssonInnerCosets
      (CuspForm.restrict (Gamma1_map_le_Gamma1_map_of_dvd (Dvd.intro_left q hm)) φ)
      (CuspForm.restrict (Gamma1_map_le_Gamma1_map_of_dvd hKK') G) = 0 := by
  have hlcm := hq.lcm_mul_eq_of_dvd_of_not_mul_dvd hnm hqnm
  have hgcd := hq.gcd_mul_eq_of_dvd_of_not_mul_dvd hnm hqnm
  rw [hn, hm] at hlcm
  rw [hn] at hgcd
  exact CuspForm.peterssonInnerCosets_restrict_restrict_eq_zero (D := Gamma1 n)
    (Gamma1_le_Gamma1_of_dvd hnm) (Gamma1_le_Gamma1_of_dvd (Dvd.intro_left q hn))
    (by rw [← hlcm, Gamma1_lcm_eq_inf]) (fun _ hx ↦ exists_mul_eq_of_mem_Gamma1_gcd (hgcd ▸ hx))
    (fun ψ ↦ (CuspForm.mem_peterssonOrthogonal_iff.mp hG) _
      (restrict_mem_cuspFormsOldAt (dvd_of_eq hn) k ψ)) φ

/-- Orthogonality to the `V_q`-raises of the forms of level `K' / q`. -/
private lemma peterssonInnerCosets_levelRaise_restrict_eq_zero_of_mem_cuspFormsNewAt [NeZero n]
    [NeZero m] [NeZero K] [NeZero K'] (hq : q.Prime) (hn : q * n = K) (hm : q * m = K')
    (hnm : n ∣ m) (hqnm : ¬q * n ∣ m) (hKK' : K ∣ K')
    {G : CuspForm ((Gamma1 K).map (mapGL ℝ)) k} (hG : G ∈ cuspFormsNewAt K k q)
    (φ : CuspForm ((Gamma1 m).map (mapGL ℝ)) k) :
    haveI : NeZero q := ⟨hq.ne_zero⟩
    peterssonInnerCosets
      (CuspForm.levelRaise q (Gamma1_map_le_conjAct_scaleGL_of_dvd (dvd_of_eq hm)) φ)
      (CuspForm.restrict (Gamma1_map_le_Gamma1_map_of_dvd hKK') G) = 0 := by
  have : NeZero q := ⟨hq.ne_zero⟩
  have hlcm := hq.lcm_mul_eq_of_dvd_of_not_mul_dvd hnm hqnm
  have hgcd := hq.gcd_mul_eq_of_dvd_of_not_mul_dvd hnm hqnm
  rw [hn, hm] at hlcm
  rw [hn] at hgcd
  have hqK : q ∣ K := Dvd.intro n hn
  rw [peterssonInnerCosets_levelRaise_eq_zero_iff (hqM := dvd_of_eq hm)]
  -- at level `K`, the conjugate of `G` is orthogonal to the forms of level `n`
  have hF : ∀ ψ : CuspForm ((Gamma1 n).map (mapGL ℝ)) k,
      peterssonInnerCosets
        (CuspForm.restrict (Subgroup.map_mono (gamma1Conj_le_Gamma1 (dvd_of_eq hn))) ψ)
        (CuspForm.restrict map_gamma1Conj_le (CuspForm.translate G (scaleGL q)⁻¹)) = 0 :=
    fun ψ ↦ (peterssonInnerCosets_levelRaise_eq_zero_iff (hqM := dvd_of_eq hn)).mp
      ((CuspForm.mem_peterssonOrthogonal_iff.mp hG) _
        (levelRaise_mem_cuspFormsOldAt (dvd_of_eq hn) (dvd_of_eq hn) k ψ))
  have h := CuspForm.peterssonInnerCosets_restrict_restrict_eq_zero
    (Gamma1_le_Gamma1_of_dvd hnm) (gamma1Conj_le_Gamma1 (dvd_of_eq hn))
    (gamma1Conj_eq_inf hqK hm hlcm)
    (fun _ hx ↦ exists_mul_gamma1Conj_eq_of_mem_Gamma1 hqK hgcd hx) hF φ
  convert h using 2
  refine DFunLike.coe_injective ?_
  simp only [CuspForm.coe_restrict, CuspForm.coe_translate]

/-- **Restriction to a level with the same `q`-part preserves `q`-newness.** If `q` is a prime,
`K ∣ K'` and `q * K ∤ K'`, the restriction to `Γ₁(K')` of a `q`-new form of level `K` is
`q`-new. -/
theorem restrict_mem_cuspFormsNewAt [NeZero K] [NeZero K'] (hq : q.Prime) (hKK' : K ∣ K')
    (hqKK' : ¬q * K ∣ K') {G : CuspForm ((Gamma1 K).map (mapGL ℝ)) k}
    (hG : G ∈ cuspFormsNewAt K k q) :
    CuspForm.restrict (Gamma1_map_le_Gamma1_map_of_dvd hKK') G ∈ cuspFormsNewAt K' k q := by
  by_cases hqK : q ∣ K
  swap
  · -- then `q ∤ K'` as well, and every form of level `K'` is `q`-new
    rw [cuspFormsNewAt_eq_top fun hqK' ↦ hqKK' <| Nat.Coprime.mul_dvd_of_dvd_of_dvd
      ((Nat.Prime.coprime_iff_not_dvd hq).mpr hqK) hqK' hKK']
    exact Submodule.mem_top
  obtain ⟨n, hn⟩ := hqK
  obtain ⟨m, hm⟩ := (Dvd.intro n hn.symm).trans hKK'
  have : NeZero n := NeZero.of_dvd (Dvd.intro_left q hn.symm)
  have : NeZero m := NeZero.of_dvd (Dvd.intro_left q hm.symm)
  have hnm : n ∣ m := Nat.dvd_of_mul_dvd_mul_left hq.pos (hn ▸ hm ▸ hKK')
  have hqnm : ¬q * n ∣ m := fun h ↦ hqKK' (by rw [hn, hm]; exact mul_dvd_mul_left q h)
  rw [cuspFormsNewAt_def, CuspForm.mem_peterssonOrthogonal_iff_le_ker]
  refine cuspFormsOldAt_le_of_prime hq hm.symm (fun φ ↦ ?_) (fun φ ↦ ?_) <;>
    rw [LinearMap.mem_ker, CuspForm.peterssonInnerCosetsₛₗ_apply_apply,
      ← peterssonInnerCosets_conj_symm]
  · rw [peterssonInnerCosets_restrict_restrict_eq_zero_of_mem_cuspFormsNewAt hq hn.symm hm.symm
      hnm hqnm hKK' hG φ, map_zero]
  · rw [peterssonInnerCosets_levelRaise_restrict_eq_zero_of_mem_cuspFormsNewAt hq hn.symm
      hm.symm hnm hqnm hKK' hG φ, map_zero]

/-- **`V_d` preserves `q`-newness when it does not raise the `q`-part of the level.** If `q` is a
prime, `d * K ∣ K'` and `q * K ∤ K'` (so `q ∤ d`), then `V_d` carries `S_k(Γ₁(K))^{q-new}` into
`S_k(Γ₁(K'))^{q-new}`. -/
theorem levelRaise_mem_cuspFormsNewAt [NeZero K] [NeZero K'] [NeZero d] (hq : q.Prime)
    (hdK : d * K ∣ K') (hqKK' : ¬q * K ∣ K')
    {G : CuspForm ((Gamma1 K).map (mapGL ℝ)) k} (hG : G ∈ cuspFormsNewAt K k q) :
    CuspForm.levelRaise d (Gamma1_map_le_conjAct_scaleGL_of_dvd hdK) G ∈
      cuspFormsNewAt K' k q := by
  -- at level `d K` the Fricke involution carries `V_d G` to a multiple of the restriction of
  -- `W_K G`; both Fricke operators preserve `q`-newness, and so does the restriction. From
  -- level `d K` the form is restricted once more to `K'`.
  have h₀ : CuspForm.levelRaise d (Gamma1_map_le_conjAct_scaleGL_of_dvd (dvd_refl (d * K))) G ∈
      cuspFormsNewAt (d * K) k q := by
    have hres := restrict_mem_cuspFormsNewAt hq (Dvd.intro_left d rfl)
      (fun h ↦ hqKK' (h.trans hdK)) (frickeOperatorCusp_mem_cuspFormsNewAt_iff.mpr hG)
    rw [← frickeOperatorCusp_mem_cuspFormsNewAt_iff,
      frickeOperatorCusp_levelRaise (e := 1) (by rw [mul_one]) _
        (Gamma1_map_le_conjAct_scaleGL_of_dvd (by rw [one_mul]; exact Dvd.intro_left d rfl)),
      CuspForm.levelRaise_one]
    exact Submodule.smul_mem _ _ hres
  have h₁ := restrict_mem_cuspFormsNewAt hq hdK
    (fun h ↦ hqKK' ((mul_dvd_mul_left q (Dvd.intro_left d rfl)).trans h)) h₀
  convert h₁ using 1
  ext τ
  simp

end TauCeti
