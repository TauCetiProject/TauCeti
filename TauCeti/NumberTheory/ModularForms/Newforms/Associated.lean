module

public import TauCeti.NumberTheory.ModularForms.Newforms.Decomposition

/-!
# The newform associated with a good Hecke eigenform

Let `F ∈ S_k(N, χ)` be a nonzero simultaneous eigenvector of the Hecke operators `Tₚ` at the
primes `p ∤ N`, for instance a good Hecke eigenform. Then there is exactly one pair `(M, g)`
consisting of a divisor `M` of `N` and a newform `g` of level `M` whose nebentypus induces `χ`
at level `N` and whose eigenvalues at the primes `p ∤ N` are those of `F`; and `F` lies in the
oldspace generated by `g`, the span of the level-raises `V_d g`, `(V_d g)(τ) = g(dτ)`, with
`d * M ∣ N`. This is the newform decomposition of Diamond–Shurman, Theorem 5.8.3 with
Proposition 5.8.4, and Miyake, Corollary 4.6.20. The level `M` is the conductor of the
eigensystem of `F`; the newform `g` is Miyake's primitive form attached to `F`.

The existence of `g` is the theorem
`Newform.exists_newform_comp_unitsMap_eq_and_eigenvalue_eq_of_forall_heckeTCuspNat_eq_smul`
of `Newforms/Decomposition.lean`.
Uniqueness is `HeckeRing.GL2.Newform.level_eq_and_coe_eq_of_comp_unitsMap_eq` of
`Newforms/StrongMultiplicityOne.lean`, a form of cross-level strong multiplicity one (Miyake,
Theorem 4.6.19): two newforms whose nebentypes induce the same character at level `N` induce the
same character at the least common multiple of their levels, since reduction from `N` to that
multiple is onto on units. The span statement then follows from the spanning theorem
`HeckeRing.GL2.Newform.mem_span_levelRaise_of_forall_heckeTCuspNat_eq_smul`: the level-raised
newforms spanning `F` with nebentypus inducing `χ` are level-raises of `g`, and the others lie in
nebentypus spaces meeting `S_k(N, χ)` only in `0`.

The pair is unique, but the eigenform is not determined by it: at level `2M`, every
`g(τ) + c • g(2τ)` with `g` a newform of level `M` is a good Hecke eigenform with the same pair.
So the conclusion is membership in the span of the `V_d g`, not equality with one of them.

## Main results

* `HeckeRing.GL2.Newform.mem_span_levelRaise_of_comp_unitsMap_eq`: a good Hecke eigenvector
  of `S_k(N, χ)` with the eigenvalues of a newform `g` whose nebentypus induces `χ` lies in the
  span of the level-raises `V_d g`.
* `HeckeRing.GL2.Newform.exists_newform_mem_span_levelRaise_of_forall_heckeTCuspNat_eq_smul`
  and `HeckeRing.GL2.EigenformAwayFromLevel.exists_newform_mem_span_levelRaise`: the newform
  decomposition, existence and uniqueness of the pair `(M, g)` together with membership of the
  eigenvector in the oldspace generated by `g`.

## References

* [F. Diamond and J. Shurman, *A first course in modular forms*][diamondshurman2005],
  Theorem 5.8.3 and Proposition 5.8.4.
* [T. Miyake, *Modular forms*][miyake1989], Theorem 4.6.19 and Corollary 4.6.20.
-/

public section

open Matrix.SpecialLinearGroup UpperHalfPlane CongruenceSubgroup

open scoped MatrixGroups

namespace HeckeRing.GL2

open TauCeti _root_.CuspForm

variable {N : ℕ} {k : ℤ}

namespace Newform

/-- **A good Hecke eigenvector lies in the oldspace of its newform.** Let `g` be a newform of
level `M ∣ N` whose nebentypus induces `χ` modulo `N`. If `F ∈ S_k(N, χ)` satisfies
`Tₚ F = aₚ(g) • F` at every prime `p ∤ N`, then `F` is a linear combination of the level-raises
`V_d g`, `(V_d g)(τ) = g(dτ)`, with `d * M ∣ N` (Diamond–Shurman, Theorem 5.8.3 with
Proposition 5.8.4). -/
theorem mem_span_levelRaise_of_comp_unitsMap_eq [NeZero N] {M : ℕ} [NeZero M]
    {χ : (ZMod N)ˣ →* ℂˣ} (g : Newform M k) (hM : M ∣ N) (hgχ : g.χ.comp (ZMod.unitsMap hM) = χ)
    {F : CuspForm ((Gamma1 N).map (mapGL ℝ)) k} (hFχ : F ∈ cuspFormCharSpace k χ)
    (hF : ∀ (p : ℕ) (hp : p.Prime) (hpN : Nat.Coprime p N),
      heckeTCuspNat k p (_hn := ⟨hp.ne_zero⟩) F =
        g.eigenvalue ⟨p, hp.pos⟩ (hpN.coprime_dvd_right hM) • F) :
    F ∈ Submodule.span ℂ {G : CuspForm ((Gamma1 N).map (mapGL ℝ)) k |
      ∃ (d : ℕ) (_ : NeZero d) (h : d * M ∣ N),
        CuspForm.levelRaise d (Gamma1_map_le_conjAct_scaleGL_of_dvd h) g.toCuspForm = G} := by
  set V := Submodule.span ℂ {G : CuspForm ((Gamma1 N).map (mapGL ℝ)) k |
      ∃ (d : ℕ) (_ : NeZero d) (h : d * M ∣ N),
        CuspForm.levelRaise d (Gamma1_map_le_conjAct_scaleGL_of_dvd h) g.toCuspForm = G}
  -- every level-raise `V_d g` lies in `S_k(N, χ)`
  have hVχ : V ≤ cuspFormCharSpace k χ := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨d, _, hdM, rfl⟩
    have := CuspForm.levelRaise_mem_cuspFormCharSpace_of_dvd hdM g.χ g.mem_charSpace
    rwa [hgχ] at this
  -- `F` is a combination of level-raised newforms with the eigenvalues of `g`; each generator is
  -- a level-raise of `g`, or lies in a nebentypus space other than `χ`
  have hFmem : F ∈ V ⊔ ⨆ (ψ : (ZMod N)ˣ →* ℂˣ) (_ : ψ ≠ χ), cuspFormCharSpace k ψ := by
    refine Submodule.span_le.mpr ?_ (mem_span_levelRaise_of_forall_heckeTCuspNat_eq_smul hF)
    rintro _ ⟨M', d, _, _, hdM', g', hg', rfl⟩
    have hM' : M' ∣ N := dvd_of_mul_left_dvd hdM'
    by_cases hg'χ : g'.χ.comp (ZMod.unitsMap hM') = χ
    · -- compatible nebentypus: `g'` is `g`, by uniqueness of the newform
      refine Submodule.mem_sup_left ?_
      obtain ⟨rfl, hcoe⟩ := level_eq_and_coe_eq_of_comp_unitsMap_eq g g' hM hM' hgχ hg'χ
        (S := ∅) fun p hp hpN _ ↦ (hg' p hp hpN).symm
      rw [← DFunLike.coe_injective hcoe]
      exact Submodule.subset_span ⟨d, inferInstance, hdM', rfl⟩
    · -- otherwise the generator lies in the nebentypus space of `g'`, which is not `χ`
      exact Submodule.mem_sup_right (Submodule.mem_iSup_of_mem _ (Submodule.mem_iSup_of_mem hg'χ
        (CuspForm.levelRaise_mem_cuspFormCharSpace_of_dvd hdM' g'.χ g'.mem_charSpace)))
  -- the component in the other nebentypus spaces is `F - s ∈ S_k(N, χ)`, hence zero
  obtain ⟨s, hs, t, ht, rfl⟩ := Submodule.mem_sup.mp hFmem
  have htχ : t ∈ cuspFormCharSpace k χ := by
    simpa using Submodule.sub_mem _ hFχ (hVχ hs)
  rw [(Submodule.disjoint_def.mp (iSupIndep_def.mp (iSupIndep_cuspFormCharSpace k) χ)) t htχ ht,
    add_zero]
  exact hs

/-- **The newform decomposition of a good Hecke eigenvector** (Diamond–Shurman, Theorem 5.8.3
with Proposition 5.8.4; Miyake, Corollary 4.6.20). If a nonzero `F ∈ S_k(N, χ)` satisfies
`Tₚ F = aₚ • F` at every prime `p ∤ N`, then there are a divisor `M` of `N` and a newform `g` of
level `M` such that
* the nebentypus of `g` induces `χ` modulo `N`;
* the eigenvalue of `g` at every prime `p ∤ N` is `aₚ`;
* `F` is a linear combination of the level-raises `V_d g` with `d * M ∣ N`;
* every newform `g'` of level `M' ∣ N` with these first two properties has `M' = M` and is the
  same function as `g`. -/
theorem exists_newform_mem_span_levelRaise_of_forall_heckeTCuspNat_eq_smul [NeZero N]
    {χ : (ZMod N)ˣ →* ℂˣ} {F : CuspForm ((Gamma1 N).map (mapGL ℝ)) k}
    (hFχ : F ∈ cuspFormCharSpace k χ) (hF0 : F ≠ 0)
    {a : ∀ p : ℕ, p.Prime → Nat.Coprime p N → ℂ}
    (hF : ∀ (p : ℕ) (hp : p.Prime) (hpN : Nat.Coprime p N),
      heckeTCuspNat k p (_hn := ⟨hp.ne_zero⟩) F = a p hp hpN • F) :
    ∃ (M : ℕ) (_ : NeZero M) (hM : M ∣ N) (g : Newform M k),
      g.χ.comp (ZMod.unitsMap hM) = χ ∧
      (∀ (p : ℕ) (hp : p.Prime) (hpN : Nat.Coprime p N),
        g.eigenvalue ⟨p, hp.pos⟩ (hpN.coprime_dvd_right hM) = a p hp hpN) ∧
      F ∈ Submodule.span ℂ {G : CuspForm ((Gamma1 N).map (mapGL ℝ)) k |
        ∃ (d : ℕ) (_ : NeZero d) (h : d * M ∣ N),
          CuspForm.levelRaise d (Gamma1_map_le_conjAct_scaleGL_of_dvd h) g.toCuspForm = G} ∧
      ∀ (M' : ℕ) (_ : NeZero M') (hM' : M' ∣ N) (g' : Newform M' k),
        g'.χ.comp (ZMod.unitsMap hM') = χ →
        (∀ (p : ℕ) (hp : p.Prime) (hpN : Nat.Coprime p N),
          g'.eigenvalue ⟨p, hp.pos⟩ (hpN.coprime_dvd_right hM') = a p hp hpN) →
        M' = M ∧ ⇑g'.toCuspForm = ⇑g.toCuspForm := by
  obtain ⟨M, _, hM, g, hgχ, hg⟩ :=
    exists_newform_comp_unitsMap_eq_and_eigenvalue_eq_of_forall_heckeTCuspNat_eq_smul hFχ hF0 hF
  refine ⟨M, inferInstance, hM, g, hgχ, hg, mem_span_levelRaise_of_comp_unitsMap_eq g hM hgχ hFχ
    fun p hp hpN ↦ hg p hp hpN ▸ hF p hp hpN, fun M' _ hM' g' hg'χ hg' ↦ ?_⟩
  exact level_eq_and_coe_eq_of_comp_unitsMap_eq g' g hM' hM hg'χ hgχ (S := ∅)
    fun p hp hpN _ ↦ (hg' p hp hpN).trans (hg p hp hpN).symm

end Newform

/-- **The newform decomposition of a good Hecke eigenform** (Diamond–Shurman, Theorem 5.8.3 with
Proposition 5.8.4; Miyake, Corollary 4.6.20). For a good Hecke eigenform `f` of level `N` and
nebentypus `χ` there are a divisor `M` of `N`, the conductor of the eigensystem of `f`, and a
newform `g` of level `M` such that
* the nebentypus of `g` induces `χ` modulo `N`;
* the eigenvalue of `g` at every prime `p ∤ N` is that of `f`;
* `f` is a linear combination of the level-raises `V_d g` with `d * M ∣ N`;
* every newform `g'` of level `M' ∣ N` with these first two properties has `M' = M` and is the
  same function as `g`. -/
theorem EigenformAwayFromLevel.exists_newform_mem_span_levelRaise [NeZero N]
    (f : EigenformAwayFromLevel N k) :
    ∃ (M : ℕ) (_ : NeZero M) (hM : M ∣ N) (g : Newform M k),
      g.χ.comp (ZMod.unitsMap hM) = f.χ ∧
      (∀ (p : ℕ) (hp : p.Prime) (hpN : Nat.Coprime p N),
        g.eigenvalue ⟨p, hp.pos⟩ (hpN.coprime_dvd_right hM) = f.eigenvalue ⟨p, hp.pos⟩ hpN) ∧
      f.toCuspForm ∈ Submodule.span ℂ {G : CuspForm ((Gamma1 N).map (mapGL ℝ)) k |
        ∃ (d : ℕ) (_ : NeZero d) (h : d * M ∣ N),
          CuspForm.levelRaise d (Gamma1_map_le_conjAct_scaleGL_of_dvd h) g.toCuspForm = G} ∧
      ∀ (M' : ℕ) (_ : NeZero M') (hM' : M' ∣ N) (g' : Newform M' k),
        g'.χ.comp (ZMod.unitsMap hM') = f.χ →
        (∀ (p : ℕ) (hp : p.Prime) (hpN : Nat.Coprime p N),
          g'.eigenvalue ⟨p, hp.pos⟩ (hpN.coprime_dvd_right hM') =
            f.eigenvalue ⟨p, hp.pos⟩ hpN) →
        M' = M ∧ ⇑g'.toCuspForm = ⇑g.toCuspForm :=
  Newform.exists_newform_mem_span_levelRaise_of_forall_heckeTCuspNat_eq_smul f.mem_charSpace
    f.ne_zero fun _ hp hpN ↦ f.heckeTCuspNat_eq_eigenvalue_smul hp hpN

end HeckeRing.GL2
