module

-- `Subgroup.adjoinNegOne` occurs in the statements below.
public import Mathlib.NumberTheory.ModularForms.ArithmeticSubgroups
-- `Subgroup.index_smul`: conjugation preserves the index.
import TauCeti.GroupTheory.Index.Map

/-!
# The projective index of a subgroup

For a subgroup `H` of a group with a compatible negation, such as `GL₂(R)`, write `±H` for the
subgroup generated by `H` and `-1` (Mathlib's `Subgroup.adjoinNegOne`). The **projective index**
of `H` is the index of `±H` (`Subgroup.projectiveIndex`).

For a level subgroup `H` of `GL₂(ℤ/n)` this is the number that matters for the modular curve
`X_H`: the elliptic curves with no automorphisms other than `±1` have `[GL₂(ℤ/n) : ±H]` level-`H`
structures up to isomorphism, so this is the degree of the coarse `j`-map `X_H → ℙ¹`. It agrees
with the index of `H` when `-1 ∈ H` and is half of it otherwise
(`Subgroup.projectiveIndex_eq_index`, `Subgroup.two_mul_projectiveIndex`). It is invariant under
conjugation (`Subgroup.projectiveIndex_pointwise_smul`) and under pulling back along a surjection
that commutes with negation (`Subgroup.projectiveIndex_comap_of_surjective`), such as reduction
from `GL₂(ℤ/m)` to `GL₂(ℤ/n)` for `n ∣ m` and `m ≠ 0`.

## Main definitions

* `Subgroup.projectiveIndex`: the index of `Subgroup.adjoinNegOne H`.

## Main results

* `Subgroup.projectiveIndex_eq_index`: if `-1 ∈ H`, the projective index is the index.
* `Subgroup.two_mul_projectiveIndex`: if `-1 ∉ H`, the index is twice the projective index.
* `Subgroup.comap_adjoinNegOne`: adjoining `-1` commutes with preimages under a homomorphism that
  commutes with negation.
* `Subgroup.projectiveIndex_comap_of_surjective`, `Subgroup.projectiveIndex_pointwise_smul`: the
  projective index is unchanged by surjective pullback and by conjugation.

## References

* F. Diamond and J. Shurman, *A First Course in Modular Forms*, GTM 228, §3.1.
-/

public section

namespace Subgroup

variable {G G' : Type*} [Group G] [HasDistribNeg G] [Group G'] [HasDistribNeg G']

/-- The **projective index** of `H`: the index of the subgroup `±H` generated by `H` and `-1`.
For a level subgroup of `GL₂(ℤ/n)` it is the degree of its modular curve over the `j`-line. -/
noncomputable def projectiveIndex (H : Subgroup G) : ℕ :=
  H.adjoinNegOne.index

theorem projectiveIndex_def (H : Subgroup G) : H.projectiveIndex = H.adjoinNegOne.index :=
  (rfl)

/-- The projective index divides the index. -/
theorem projectiveIndex_dvd_index (H : Subgroup G) : H.projectiveIndex ∣ H.index :=
  index_dvd_of_le H.le_adjoinNegOne

/-- If `-1 ∈ H`, then `±H = H` and the projective index is the index. -/
theorem projectiveIndex_eq_index {H : Subgroup G} (h : -1 ∈ H) : H.projectiveIndex = H.index := by
  rw [projectiveIndex_def, adjoinNegOne_eq_self_iff.mpr h]

/-- If `-1 ∉ H`, then `H` has index `2` in `±H`, so the index of `H` is twice its projective
index. -/
theorem two_mul_projectiveIndex {H : Subgroup G} (h : -1 ∉ H) :
    2 * H.projectiveIndex = H.index := by
  rw [projectiveIndex_def, ← relIndex_adjoinNegOne_eq_two h,
    relIndex_mul_index H.le_adjoinNegOne]

/-- Adjoining `-1` commutes with preimages under a homomorphism that commutes with negation.
This is the preimage counterpart of Mathlib's `Subgroup.map_adjoinNegOne`. -/
theorem comap_adjoinNegOne (H : Subgroup G) (f : G' →* G) (hf : ∀ g, f (-g) = -f g) :
    H.adjoinNegOne.comap f = (H.comap f).adjoinNegOne := by
  ext g
  simp [hf]

/-- Pulling back along a surjective homomorphism that commutes with negation does not change the
projective index. -/
theorem projectiveIndex_comap_of_surjective (H : Subgroup G) {f : G' →* G}
    (hf : ∀ g, f (-g) = -f g) (hs : Function.Surjective f) :
    (H.comap f).projectiveIndex = H.projectiveIndex := by
  rw [projectiveIndex_def, ← comap_adjoinNegOne H f hf, index_comap_of_surjective _ hs,
    projectiveIndex_def]

open scoped Pointwise in
/-- Conjugation does not change the projective index. -/
theorem projectiveIndex_pointwise_smul (H : Subgroup G) (g : ConjAct G) :
    (g • H).projectiveIndex = H.projectiveIndex := by
  rw [projectiveIndex_def, adjoinNegOne_conj, index_smul, projectiveIndex_def]

end Subgroup
