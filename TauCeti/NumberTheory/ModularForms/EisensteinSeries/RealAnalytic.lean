/-! ### The projective parabolic subgroup `⟨T⟩` and `realAnalyticEisenstein` -/

private theorem psl_T_zpow (n : ℤ) :
    (ModularGroup.T : PSL(2, ℤ)) ^ n = ((ModularGroup.T ^ n : SL(2, ℤ)) : PSL(2, ℤ)) :=
  (map_zpow (QuotientGroup.mk' (Subgroup.center SL(2, ℤ))) ModularGroup.T n).symm

/-- The subgroup of `PSL(2, ℤ)` generated by the translation `T`, i.e., the stabilizer of `∞`. -/
def pslTSubgroup : Subgroup PSL(2, ℤ) :=
  Subgroup.zpowers (ModularGroup.T : PSL(2, ℤ))

/-- An element of `SL(2, ℤ)` maps into `pslTSubgroup` exactly when its lower-left entry is `0`. -/
theorem mem_pslTSubgroup_mk_iff (γ : SL(2, ℤ)) :
    (γ : PSL(2, ℤ)) ∈ pslTSubgroup ↔ γ 1 0 = 0 := by
  constructor
  · rintro ⟨n, hn⟩
    obtain ⟨c, hc, hγ⟩ := (QuotientGroup.mk'_eq_mk' (Subgroup.center SL(2, ℤ))).mp
      (by rw [map_zpow]; exact hn.symm :
        QuotientGroup.mk' (Subgroup.center SL(2, ℤ)) γ =
          QuotientGroup.mk' (Subgroup.center SL(2, ℤ)) (ModularGroup.T ^ n))
    have hγ' : γ = ModularGroup.T ^ n * c⁻¹ := eq_mul_inv_of_mul_eq hγ
    rcases mem_center_iff_eq_one_or_eq_neg_one.mp hc with rfl | rfl <;>
      simp [hγ', ModularGroup.coe_T_zpow]
  · intro hc
    obtain ⟨n, hn⟩ := ModularGroup.exists_eq_T_zpow_of_c_eq_zero hc
    refine ⟨n, eq_of_smul_eq_smul fun z : ℍ ↦ ?_⟩
    change ((ModularGroup.T : PSL(2, ℤ)) ^ n) • z = (γ : PSL(2, ℤ)) • z
    rw [psl_T_zpow, UpperHalfPlane.pslMk_smul, UpperHalfPlane.pslMk_smul, hn z]

/-- The parabolic subgroup `⟨T⟩` lies in `Gamma0Projective N` for every level `N`. -/
theorem pslTSubgroup_le_Gamma0Projective (N : ℕ) :
    pslTSubgroup ≤ Gamma0Projective N := by
  rw [pslTSubgroup, Subgroup.zpowers_le, mem_Gamma0Projective_mk,
    CongruenceSubgroup.mem_Gamma0_iff_dvd]
  simp [ModularGroup.coe_T]

/-- Elements of `pslTSubgroup` act on `ℍ` by integer horizontal translations and hence preserve
the imaginary part. -/
theorem im_smul_eq_of_mem_pslTSubgroup {h : PSL(2, ℤ)} (hh : h ∈ pslTSubgroup) (z : ℍ) :
    (h • z).im = z.im := by
  obtain ⟨n, rfl⟩ := hh
  change (((ModularGroup.T : PSL(2, ℤ)) ^ n) • z).im = z.im
  rw [psl_T_zpow, UpperHalfPlane.pslMk_smul, ModularGroup.im_T_zpow_smul]

/-- The summand `q ↦ (Im (q⁻¹ • z)) ^ s` of the level-`N` real-analytic Eisenstein series,
canonically descended to `Gamma0Projective N ⧸ pslTSubgroup`. -/
def realAnalyticEisensteinSummand (N : ℕ) (z : ℍ) (s : ℝ) :
    Gamma0Projective N ⧸ pslTSubgroup.subgroupOf (Gamma0Projective N) → ℝ :=
  Quotient.lift (fun g : Gamma0Projective N ↦ (((g : PSL(2, ℤ))⁻¹ • z).im) ^ s)
    fun g₁ g₂ hrel ↦ by
      have hmem : ((g₁ : PSL(2, ℤ))⁻¹ * (g₂ : PSL(2, ℤ)))⁻¹ ∈ pslTSubgroup :=
        pslTSubgroup.inv_mem (Subgroup.mem_subgroupOf.mp (QuotientGroup.leftRel_apply.mp hrel))
      rw [show (g₂ : PSL(2, ℤ))⁻¹ =
          ((g₁ : PSL(2, ℤ))⁻¹ * (g₂ : PSL(2, ℤ)))⁻¹ * (g₁ : PSL(2, ℤ))⁻¹ by group,
        mul_smul, im_smul_eq_of_mem_pslTSubgroup hmem]

/-- Evaluation of `realAnalyticEisensteinSummand` on a coset representative `QuotientGroup.mk g`. -/
@[simp]
theorem realAnalyticEisensteinSummand_mk (N : ℕ) (z : ℍ) (s : ℝ) (g : Gamma0Projective N) :
    realAnalyticEisensteinSummand N z s (QuotientGroup.mk g) =
      (((g : PSL(2, ℤ))⁻¹ • z).im) ^ s := (rfl)

/-- Evaluation of `realAnalyticEisensteinSummand` on a coset `q` via `Quotient.out q`. -/
theorem realAnalyticEisensteinSummand_eq_out (N : ℕ) (z : ℍ) (s : ℝ)
    (q : Gamma0Projective N ⧸ pslTSubgroup.subgroupOf (Gamma0Projective N)) :
    realAnalyticEisensteinSummand N z s q =
      ((((q.out : Gamma0Projective N) : PSL(2, ℤ))⁻¹ • z).im) ^ s := by
  conv_lhs => rw [← Quotient.out_eq q]
  rfl

/-- **The real-analytic Eisenstein series at the cusp `∞` for `Γ₀(N)`**:
`E_N(z, s) = ∑' q ∈ Γ_∞ \ Γ₀(N), (Im (q • z)) ^ s`. -/
def realAnalyticEisenstein (N : ℕ) (z : ℍ) (s : ℝ) : ℝ :=
  ∑' q, realAnalyticEisensteinSummand N z s q

/-- Unfolding of `realAnalyticEisenstein` as a `tsum` over `Gamma0Projective N ⧸ pslTSubgroup`. -/
theorem realAnalyticEisenstein_def (N : ℕ) (z : ℍ) (s : ℝ) :
    realAnalyticEisenstein N z s = ∑' q, realAnalyticEisensteinSummand N z s q := (rfl)

/-- Every term of `realAnalyticEisenstein` is nonnegative. -/
theorem realAnalyticEisenstein_nonneg (N : ℕ) (z : ℍ) (s : ℝ) :
    0 ≤ realAnalyticEisenstein N z s :=
  tsum_nonneg fun q ↦ by
    rw [realAnalyticEisensteinSummand_eq_out]; exact rpow_nonneg (UpperHalfPlane.im_pos _).le s

/-- **`Γ₀(N)`-invariance of `realAnalyticEisenstein N`**. -/
theorem realAnalyticEisenstein_smul (N : ℕ) {γ : SL(2, ℤ)}
    (hγ : γ ∈ CongruenceSubgroup.Gamma0 N) (z : ℍ) (s : ℝ) :
    realAnalyticEisenstein N (γ • z) s = realAnalyticEisenstein N z s := by
  let g₀ : Gamma0Projective N := ⟨(γ : PSL(2, ℤ)), (mem_Gamma0Projective_mk N γ).mpr hγ⟩
  rw [realAnalyticEisenstein, realAnalyticEisenstein, ← (MulAction.toPerm g₀).tsum_eq]
  refine tsum_congr fun q ↦ ?_
  induction q using QuotientGroup.induction_on with
  | H g =>
    change realAnalyticEisensteinSummand N (γ • z) s (QuotientGroup.mk (g₀ * g)) =
      realAnalyticEisensteinSummand N z s (QuotientGroup.mk g)
    simp only [realAnalyticEisensteinSummand_mk, Subgroup.coe_mul, mul_inv_rev, mul_smul, g₀]
    rw [← UpperHalfPlane.pslMk_smul, inv_smul_smul]

/-- Each summand `z ↦ realAnalyticEisensteinSummand N z s q` is continuous on `ℍ`. -/
theorem continuous_realAnalyticEisensteinSummand (N : ℕ) (s : ℝ)
    (q : Gamma0Projective N ⧸ pslTSubgroup.subgroupOf (Gamma0Projective N)) :
    Continuous fun z : ℍ ↦ realAnalyticEisensteinSummand N z s q := by
  induction q using QuotientGroup.induction_on with
  | H g =>
    simp only [realAnalyticEisensteinSummand_mk]
    obtain ⟨γ, hγ⟩ := QuotientGroup.mk_surjective (g : PSL(2, ℤ))⁻¹
    rw [← hγ]
    exact (UpperHalfPlane.continuous_im.comp (continuous_const_smul (mapGL ℝ γ))).rpow
      continuous_const fun z ↦ Or.inl (UpperHalfPlane.im_pos _).ne'

/-- Measurability of `z ↦ realAnalyticEisenstein N z s` on `ℍ`. -/
theorem measurable_realAnalyticEisenstein (N : ℕ) (s : ℝ) :
    Measurable fun z : ℍ ↦ realAnalyticEisenstein N z s :=
  Measurable.tsum fun q ↦ (continuous_realAnalyticEisensteinSummand N s q).measurable

/-! ### Bijection with coprime bottom rows and Möbius inversion -/

private abbrev G0Quot (N : ℕ) :=
  Gamma0Projective N ⧸ pslTSubgroup.subgroupOf (Gamma0Projective N)

private abbrev CoprimeBottomRow (N : ℕ) := {p : ℤ × ℤ // (N : ℤ) ∣ p.1 ∧ IsCoprime p.1 p.2}

private abbrev epTerm (z : ℍ) (s : ℝ) (p : ℤ × ℤ) : ℝ :=
  z.im ^ s / ‖(p.1 : ℂ) * z + p.2‖ ^ (2 * s)

private abbrev moebSum (N : ℕ) (a : ℝ) : ℝ :=
  ∑ r ∈ N.divisors, (μ r : ℝ) * (r : ℝ) ^ a

private abbrev sgn (b : Bool) : ℤ := if b then -1 else 1

private theorem coprimeBottomRow_ne_zero {N : ℕ} (p : CoprimeBottomRow N) : p.1 ≠ 0 := fun h ↦
  not_isUnit_zero (isCoprime_zero_left.mp (h ▸ p.2.2))

private theorem psl_mk_mul_inv (γ₁ γ₂ : SL(2, ℤ)) :
    ((γ₁ * γ₂⁻¹ : SL(2, ℤ)) : PSL(2, ℤ)) = (γ₁ : PSL(2, ℤ)) * (γ₂ : PSL(2, ℤ))⁻¹ := by
  change QuotientGroup.mk' (Subgroup.center SL(2, ℤ)) (γ₁ * γ₂⁻¹) = _
  rw [map_mul, map_inv]; rfl

private theorem eq_or_eq_neg_of_isCoprime_mul_eq {c₁ d₁ c₂ d₂ : ℤ}
    (h1 : IsCoprime c₁ d₁) (h2 : IsCoprime c₂ d₂) (heq : c₁ * d₂ = d₁ * c₂) :
    (c₂ = c₁ ∧ d₂ = d₁) ∨ (c₂ = -c₁ ∧ d₂ = -d₁) := by
  obtain ⟨a₁, b₁, hab1⟩ := h1
  obtain ⟨a₂, b₂, hab2⟩ := h2
  set u := a₁ * c₂ + b₁ * d₂
  have hc : u * c₁ = c₂ := by linear_combination c₂ * hab1 + b₁ * heq
  have hd : u * d₁ = d₂ := by linear_combination d₂ * hab1 - a₁ * heq
  have hvu : (a₂ * c₁ + b₂ * d₁) * u = 1 := by linear_combination hab2 + a₂ * hc + b₂ * hd
  rcases Int.mul_eq_one_iff_eq_one_or_neg_one.mp hvu with ⟨_, hu⟩ | ⟨_, hu⟩
  · exact Or.inl ⟨by linear_combination -hc + c₁ * hu, by linear_combination -hd + d₁ * hu⟩
  · exact Or.inr ⟨by linear_combination -hc + c₁ * hu, by linear_combination -hd + d₁ * hu⟩

private theorem isCoprime_bottom_row (γ : SL(2, ℤ)) : IsCoprime (γ 1 0) (γ 1 1) :=
  ⟨-(γ 0 1), γ 0 0, by have h := γ.det_coe; rw [Matrix.det_fin_two] at h; linarith⟩

private theorem mul_inv_apply_one_zero (γ₁ γ₂ : SL(2, ℤ)) :
    (γ₁ * γ₂⁻¹) 1 0 = γ₁ 1 0 * γ₂ 1 1 - γ₁ 1 1 * γ₂ 1 0 := by
  rw [coe_mul, Matrix.mul_apply, Fin.sum_univ_two, SL2_inv_expl]; simp; ring

private def gamma0CosetRep (N : ℕ) (q : G0Quot N) : SL(2, ℤ) :=
  ((mem_Gamma0Projective_iff N _).mp ((Gamma0Projective N).inv_mem q.out.2)).choose

private theorem gamma0CosetRep_mk (N : ℕ) (q : G0Quot N) :
    (gamma0CosetRep N q : PSL(2, ℤ)) = ((q.out : Gamma0Projective N) : PSL(2, ℤ))⁻¹ :=
  ((mem_Gamma0Projective_iff N _).mp ((Gamma0Projective N).inv_mem q.out.2)).choose_spec.1

private theorem gamma0CosetRep_mem (N : ℕ) (q : G0Quot N) :
    gamma0CosetRep N q ∈ CongruenceSubgroup.Gamma0 N :=
  ((mem_Gamma0Projective_iff N _).mp ((Gamma0Projective N).inv_mem q.out.2)).choose_spec.2

private def boolProdQuotToBottomRow (N : ℕ) (x : Bool × G0Quot N) : CoprimeBottomRow N :=
  ⟨(sgn x.1 * gamma0CosetRep N x.2 1 0, sgn x.1 * gamma0CosetRep N x.2 1 1), by
    have hc := CongruenceSubgroup.mem_Gamma0_iff_dvd.mp (gamma0CosetRep_mem N x.2)
    have hcop := isCoprime_bottom_row (gamma0CosetRep N x.2)
    refine ⟨dvd_mul_of_dvd_right hc _, ?_⟩
    cases x.1 <;> simp [sgn, hcop, IsCoprime.neg_left_iff, IsCoprime.neg_right_iff]⟩

private def boolProdQuotEquivCoprimeBottomRow (N : ℕ) :
    Bool × G0Quot N ≃ CoprimeBottomRow N := by
  refine Equiv.ofBijective (boolProdQuotToBottomRow N) ⟨?_, ?_⟩
  · rintro ⟨b₁, q₁⟩ ⟨b₂, q₂⟩ heq
    set γ₁ := gamma0CosetRep N q₁; set γ₂ := gamma0CosetRep N q₂
    have hpair := Prod.mk.inj (congrArg Subtype.val heq)
    dsimp only [boolProdQuotToBottomRow] at hpair
    have hmul : γ₁ 1 0 * γ₂ 1 1 - γ₁ 1 1 * γ₂ 1 0 = 0 := by
      have hs1 : sgn b₁ ≠ 0 := by cases b₁ <;> decide
      have h0 : sgn b₁ * (γ₁ 1 0 * γ₂ 1 1 - γ₁ 1 1 * γ₂ 1 0) = 0 := by
        linear_combination γ₂ 1 1 * hpair.1 - γ₂ 1 0 * hpair.2
      exact (mul_eq_zero.mp h0).resolve_left hs1
    have hc0 : (γ₁ * γ₂⁻¹) 1 0 = 0 := by rw [mul_inv_apply_one_zero, hmul]
    have hq : q₁ = q₂ := by
      rw [← Quotient.out_eq q₁, ← Quotient.out_eq q₂, QuotientGroup.eq, Subgroup.mem_subgroupOf]
      have h := (mem_pslTSubgroup_mk_iff _).mpr hc0
      rwa [psl_mk_mul_inv, gamma0CosetRep_mk, gamma0CosetRep_mk, inv_inv] at h
    subst hq
    have hne : (gamma0CosetRep N q₁ 1 0, gamma0CosetRep N q₁ 1 1) ≠ 0 :=
      coprimeBottomRow_ne_zero (N := N) ⟨(gamma0CosetRep N q₁ 1 0, gamma0CosetRep N q₁ 1 1),
        CongruenceSubgroup.mem_Gamma0_iff_dvd.mp (gamma0CosetRep_mem N q₁), isCoprime_bottom_row _⟩
    cases b₁ <;> cases b₂ <;> simp [sgn] at hpair <;> first | rfl |
      exact absurd (Prod.ext (by change _ = 0; omega) (by change _ = 0; omega)) hne
  · intro p
    obtain ⟨a, b, hab⟩ := p.2.2
    let γ : SL(2, ℤ) := ⟨!![b, -a; p.1.1, p.1.2], by rw [Matrix.det_fin_two_of]; linarith⟩
    let q : G0Quot N := QuotientGroup.mk ⟨(γ : PSL(2, ℤ))⁻¹, (Gamma0Projective N).inv_mem
      ((mem_Gamma0Projective_mk N γ).mpr (CongruenceSubgroup.mem_Gamma0_iff_dvd.mpr p.2.1))⟩
    have hc0 : (gamma0CosetRep N q * γ⁻¹) 1 0 = 0 := (mem_pslTSubgroup_mk_iff _).mp <| by
      rw [psl_mk_mul_inv, gamma0CosetRep_mk]
      exact Subgroup.mem_subgroupOf.mp (QuotientGroup.eq.mp (Quotient.out_eq q))
    have hmul : gamma0CosetRep N q 1 0 * p.1.2 = gamma0CosetRep N q 1 1 * p.1.1 := by
      rw [mul_inv_apply_one_zero] at hc0; change _ * p.1.2 - _ * p.1.1 = 0 at hc0; linarith
    rcases eq_or_eq_neg_of_isCoprime_mul_eq (isCoprime_bottom_row (gamma0CosetRep N q))
      p.2.2 hmul with ⟨hc, hd⟩ | ⟨hc, hd⟩
    · exact ⟨(false, q), Subtype.ext (Prod.ext (by simp [boolProdQuotToBottomRow, sgn, hc])
        (by simp [boolProdQuotToBottomRow, sgn, hd]))⟩
    · exact ⟨(true, q), Subtype.ext (Prod.ext (by simp [boolProdQuotToBottomRow, sgn, hc])
        (by simp [boolProdQuotToBottomRow, sgn, hd]))⟩

private theorem realAnalyticEisensteinSummand_eq_coprimeBottomRow (N : ℕ) (z : ℍ) (s : ℝ)
    (b : Bool) (q : G0Quot N) :
    epTerm z s (boolProdQuotEquivCoprimeBottomRow N (b, q)).1 =
      realAnalyticEisensteinSummand N z s q := by
  set γ : SL(2, ℤ) := gamma0CosetRep N q
  have hrow : (((boolProdQuotEquivCoprimeBottomRow N (b, q)).1.1 : ℂ) * z +
      (boolProdQuotEquivCoprimeBottomRow N (b, q)).1.2) =
      (sgn b : ℂ) * ((γ 1 0 : ℂ) * z + γ 1 1) := by
    change (((boolProdQuotToBottomRow N (b, q)).1.1 : ℂ) * z +
      (boolProdQuotToBottomRow N (b, q)).1.2) = _
    cases b <;> simp [boolProdQuotToBottomRow, sgn, γ]
    ring
  rw [epTerm, hrow, norm_mul, show ‖(sgn b : ℂ)‖ = 1 by cases b <;> simp [sgn], one_mul,
    realAnalyticEisensteinSummand_eq_out, ← gamma0CosetRep_mk N q, UpperHalfPlane.pslMk_smul,
    ModularGroup.im_smul_eq_div_normSq, ModularGroup.denom_apply,
    div_rpow z.im_pos.le (Complex.normSq_nonneg _), ← Complex.sq_norm,
    ← rpow_natCast ‖_‖ 2, ← rpow_mul (norm_nonneg _)]
  congr 2

private theorem summable_coprimeBottomRow (N : ℕ) (z : ℍ) {s : ℝ} (hs : 1 < s) :
    Summable fun p : CoprimeBottomRow N ↦ epTerm z s p.1 :=
  ((summable_realAnalyticEpstein_summand z hs).subtype _).congr fun p ↦ by
    simp [coprimeBottomRow_ne_zero p]

/-- Summability of the real-analytic Eisenstein series summand for `s > 1`. -/
theorem summable_realAnalyticEisensteinSummand (N : ℕ) (z : ℍ) {s : ℝ} (hs : 1 < s) :
    Summable (realAnalyticEisensteinSummand N z s) :=
  (((boolProdQuotEquivCoprimeBottomRow N).summable_iff.mpr
    (summable_coprimeBottomRow N z hs)).prod_factor false).congr fun q ↦
      realAnalyticEisensteinSummand_eq_coprimeBottomRow N z s false q

private theorem two_mul_realAnalyticEisenstein_eq_tsum_coprime (N : ℕ) (z : ℍ) {s : ℝ}
    (hs : 1 < s) :
    2 * realAnalyticEisenstein N z s = ∑' p : CoprimeBottomRow N, epTerm z s p.1 := by
  have hval := fun b q ↦ realAnalyticEisensteinSummand_eq_coprimeBottomRow N z s b q
  have hprod : Summable fun c : Bool × G0Quot N ↦
      epTerm z s (boolProdQuotEquivCoprimeBottomRow N c).1 :=
    (boolProdQuotEquivCoprimeBottomRow N).summable_iff.mpr (summable_coprimeBottomRow N z hs)
  have hsum := summable_realAnalyticEisensteinSummand N z hs
  rw [← (boolProdQuotEquivCoprimeBottomRow N).tsum_eq,
    hprod.tsum_prod' fun b ↦ hsum.congr fun q ↦ (hval b q).symm]
  simp_rw [hval, tsum_bool, ← two_mul, realAnalyticEisenstein]

/-- **Comparison across levels**: `E_N(z, s) ≤ E_1(z, s)` for all `N` and `s > 1`. -/
theorem realAnalyticEisenstein_le_one (N : ℕ) (z : ℍ) {s : ℝ} (hs : 1 < s) :
    realAnalyticEisenstein N z s ≤ realAnalyticEisenstein 1 z s := by
  have h2 : 2 * realAnalyticEisenstein N z s ≤ 2 * realAnalyticEisenstein 1 z s := by
    rw [two_mul_realAnalyticEisenstein_eq_tsum_coprime N z hs,
      two_mul_realAnalyticEisenstein_eq_tsum_coprime 1 z hs]
    exact (summable_coprimeBottomRow N z hs).tsum_le_tsum_of_inj
      (fun p : CoprimeBottomRow N ↦ (⟨p.1, ⟨one_dvd _, p.2.2⟩⟩ : CoprimeBottomRow 1))
      (fun _ _ h ↦ Subtype.ext (Subtype.mk.inj h))
      (fun _ _ ↦ by positivity) (fun _ ↦ le_rfl) (summable_coprimeBottomRow 1 z hs)
  linarith

/-- **Comparison with Epstein zeta**: `E_1(z, s) ≤ Z(z, s)` for all `z ∈ ℍ` and `s > 1`. -/
theorem realAnalyticEisenstein_one_le_realAnalyticEpstein (z : ℍ) {s : ℝ} (hs : 1 < s) :
    realAnalyticEisenstein 1 z s ≤ realAnalyticEpstein z s := by
  have h2 : 2 * realAnalyticEisenstein 1 z s ≤ realAnalyticEpstein z s := by
    rw [two_mul_realAnalyticEisenstein_eq_tsum_coprime 1 z hs, realAnalyticEpstein_def]
    exact (summable_coprimeBottomRow 1 z hs).tsum_le_tsum_of_inj Subtype.val Subtype.val_injective
      (fun _ _ ↦ by split_ifs <;> positivity) (fun p ↦ by simp [coprimeBottomRow_ne_zero p])
      (summable_realAnalyticEpstein_summand z hs)
  linarith [realAnalyticEisenstein_nonneg 1 z s]

private theorem sum_moebius_divisors_ite_dvd {N : ℕ} (hN : N ≠ 0) (d : ℤ) :
    (∑ r ∈ N.divisors, if (r : ℤ) ∣ d then (μ r : ℝ) else 0) =
      if IsCoprime (N : ℤ) d then 1 else 0 := by
  have hfilt : (N.divisors.filter fun r : ℕ ↦ (r : ℤ) ∣ d) = (Nat.gcd N d.natAbs).divisors := by
    ext r
    simp only [Finset.mem_filter, Nat.mem_divisors, Nat.dvd_gcd_iff, Int.natCast_dvd]
    have hgcd : Nat.gcd N d.natAbs ≠ 0 := fun h ↦ hN (Nat.gcd_eq_zero_iff.mp h).1
    tauto
  rw [← Finset.sum_filter, hfilt]
  have hmz := congrArg (fun f : ArithmeticFunction ℝ ↦ f (Nat.gcd N d.natAbs))
    (coe_moebius_mul_coe_zeta (R := ℝ))
  simp only [ArithmeticFunction.coe_mul_zeta_apply, ArithmeticFunction.intCoe_apply,
    ArithmeticFunction.one_apply] at hmz
  rw [hmz]
  simp only [show Nat.gcd N d.natAbs = 1 ↔ IsCoprime (N : ℤ) d by
    rw [Int.isCoprime_iff_gcd_eq_one, Int.gcd, Int.natAbs_natCast]]

private def natScaleH (k : ℕ) (z : ℍ) : ℍ :=
  if hk : 0 < k then ⟨(k : ℂ) * z, by simp [mul_im, Nat.cast_pos.mpr hk, z.im_pos]⟩ else z

private theorem abs_cast_moebius_le_one (r : ℕ) : |(μ r : ℝ)| ≤ 1 := by
  exact_mod_cast ArithmeticFunction.abs_moebius_le_one (n := r)

private theorem tendsto_tsum_nat_rpow_neg_two_mul :
    Tendsto (fun s : ℝ ↦ ∑' n : ℕ, (n : ℝ) ^ (-(2 * s))) (𝓝[>] 1) (𝓝 (π ^ 2 / 6)) := by
  rw [← show ∑' n : ℕ, (n : ℝ) ^ (-(2 : ℝ)) = π ^ 2 / 6 by
    simpa [rpow_neg (Nat.cast_nonneg _), one_div] using hasSum_zeta_two.tsum_eq]
  refine tendsto_tsum_of_dominated_convergence
    (Real.summable_nat_rpow.mpr (by norm_num : -(2 : ℝ) < -1)) (fun n ↦ ?_) ?_
  · rcases Nat.eq_zero_or_pos n with rfl | hn
    · refine tendsto_const_nhds.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with s hs
      rw [Nat.cast_zero, zero_rpow (by norm_num), zero_rpow (by linarith [Set.mem_Ioi.mp hs])]
    · have hc : Continuous fun s : ℝ ↦ (n : ℝ) ^ (-(2 * s)) := continuous_const.rpow
        (continuous_const.mul continuous_id).neg fun _ ↦ Or.inl (Nat.cast_pos.mpr hn).ne'
      simpa using (hc.continuousAt (x := (1 : ℝ))).tendsto.mono_left nhdsWithin_le_nhds
  · filter_upwards [self_mem_nhdsWithin] with s hs n
    rw [Real.norm_of_nonneg (rpow_nonneg (Nat.cast_nonneg n) _)]
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [Nat.cast_zero, zero_rpow (by linarith [Set.mem_Ioi.mp hs]), zero_rpow (by norm_num)]
    · exact rpow_le_rpow_of_exponent_le (by exact_mod_cast hn) (by linarith [Set.mem_Ioi.mp hs])

private theorem tsum_coprime_nat_rpow_eq {N : ℕ} (hN : N ≠ 0) {s : ℝ} (hs : 1 < s) :
    (∑' m : {m : ℕ // 0 < m ∧ m.Coprime N}, (m.1 : ℝ) ^ (-(2 * s))) =
      moebSum N (-(2 * s)) * ∑' n : ℕ, (n : ℝ) ^ (-(2 * s)) := by
  have hsum : Summable fun m : ℕ ↦ (m : ℝ) ^ (-(2 * s)) := Real.summable_nat_rpow.mpr (by linarith)
  rw [show (∑' m : {m : ℕ // 0 < m ∧ m.Coprime N}, (m.1 : ℝ) ^ (-(2 * s))) =
      ∑' m : ℕ, (if IsCoprime (N : ℤ) (m : ℤ) then (1 : ℝ) else 0) * (m : ℝ) ^ (-(2 * s)) by
    rw [← tsum_subtype_eq_of_support_subset (s := {m : ℕ | 0 < m ∧ m.Coprime N})]
    · exact tsum_congr fun m ↦ by simp [Nat.isCoprime_iff_coprime.mpr m.2.2.symm]
    · intro m hm; simp only [Function.mem_support, ne_eq, mul_eq_zero, not_or] at hm
      exact ⟨Nat.pos_of_ne_zero fun h ↦ by
          subst h; simp [zero_rpow (by linarith : -(2 * s) ≠ 0)] at hm,
        (Nat.isCoprime_iff_coprime.mp (by by_contra hc; simp [hc] at hm)).symm⟩]
  simp_rw [← sum_moebius_divisors_ite_dvd hN, Finset.sum_mul]
  rw [Summable.tsum_finsetSum fun r _ ↦ hsum.of_norm_bounded fun m ↦ by
    have hnn : 0 ≤ (m : ℝ) ^ (-(2 * s)) := rpow_nonneg (Nat.cast_nonneg m) _
    split_ifs
    · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hnn]
      exact mul_le_of_le_one_left hnn (abs_cast_moebius_le_one r)
    · simp [hnn]]
  refine Finset.sum_congr rfl fun r hr ↦ ?_
  let e : ℕ ≃ ({m : ℕ | (r : ℤ) ∣ (m : ℤ)} : Set ℕ) :=
    ⟨fun k ↦ ⟨r * k, by exact_mod_cast dvd_mul_right r k⟩, fun m ↦ m.1 / r,
      fun k ↦ Nat.mul_div_cancel_left k (Nat.pos_of_mem_divisors hr),
      fun m ↦ Subtype.ext (Nat.mul_div_cancel' (Int.natCast_dvd_natCast.mp m.2))⟩
  rw [← tsum_subtype_eq_of_support_subset (s := {m : ℕ | (r : ℤ) ∣ (m : ℤ)})
    (fun m hm ↦ by by_contra hnd; exact hm (by simp [show ¬ ((r : ℤ) ∣ (m : ℤ)) from hnd])),
    ← e.tsum_eq, ← tsum_mul_left]
  exact tsum_congr fun k ↦ by
    simp only [e, Equiv.coe_fn_mk, dvd_mul_right, ↓reduceIte, Nat.cast_mul,
      mul_rpow (Nat.cast_nonneg r) (Nat.cast_nonneg k), mul_assoc]

private def coprimeMulEquivBottomRow (N : ℕ) :
    {m : ℕ // 0 < m ∧ m.Coprime N} × CoprimeBottomRow N ≃
      {p : ℤ × ℤ // p ≠ 0 ∧ (N : ℤ) ∣ p.1 ∧ IsCoprime (N : ℤ) p.2} where
  toFun x := ⟨((x.1.1 : ℤ) * x.2.1.1, (x.1.1 : ℤ) * x.2.1.2), by
    have hm0 : (x.1.1 : ℤ) ≠ 0 := Int.natCast_ne_zero.mpr x.1.2.1.ne'
    refine ⟨fun h ↦ coprimeBottomRow_ne_zero x.2 (Prod.ext
      ((mul_eq_zero.mp (Prod.ext_iff.mp h).1).resolve_left hm0)
      ((mul_eq_zero.mp (Prod.ext_iff.mp h).2).resolve_left hm0)),
      dvd_mul_of_dvd_right x.2.2.1 _, ?_⟩
    obtain ⟨k, hk⟩ := x.2.2.1; obtain ⟨a, b, hab⟩ := x.2.2.2
    exact (Int.isCoprime_iff_gcd_eq_one.mpr (by simpa [Int.gcd] using x.1.2.2.symm)).mul_right
      ⟨a * k, b, by rw [hk] at hab; linarith⟩⟩
  invFun p :=
    let g := Int.gcd p.1.1 p.1.2
    have hg0 : 0 < g := Nat.pos_of_ne_zero fun h ↦
      p.2.1 (Prod.ext (Int.gcd_eq_zero_iff.mp h).1 (Int.gcd_eq_zero_iff.mp h).2)
    have hg_cop : g.Coprime N := by
      obtain ⟨k, hk⟩ := Int.gcd_dvd_right (a := p.1.1) (b := p.1.2)
      obtain ⟨a, b, hab⟩ := p.2.2.2
      exact (Nat.isCoprime_iff_coprime.mp ⟨a, b * k, by rw [hk] at hab; linarith⟩).symm
    have hc_mul : (g : ℤ) * (p.1.1 / g) = p.1.1 := Int.mul_ediv_cancel' (Int.gcd_dvd_left ..)
    have hd_mul : (g : ℤ) * (p.1.2 / g) = p.1.2 := Int.mul_ediv_cancel' (Int.gcd_dvd_right ..)
    have hcop_cd : IsCoprime (p.1.1 / g) (p.1.2 / g) := by
      rw [Int.isCoprime_iff_gcd_eq_one]
      have h : Int.gcd ((g : ℤ) * (p.1.1 / g)) ((g : ℤ) * (p.1.2 / g)) = g := by rw [hc_mul, hd_mul]
      rw [Int.gcd_mul_left, Int.natAbs_natCast] at h
      exact Nat.eq_of_mul_eq_mul_left hg0 (by simpa using h)
    have hN_dvd : (N : ℤ) ∣ p.1.1 / g :=
      (Int.isCoprime_iff_gcd_eq_one.mpr
        (by rw [Int.gcd, Int.natAbs_natCast, Int.natAbs_natCast]; exact hg_cop.symm)
        ).dvd_of_dvd_mul_left (hc_mul.symm ▸ p.2.2.1)
    (⟨g, hg0, hg_cop⟩, ⟨(p.1.1 / g, p.1.2 / g), hN_dvd, hcop_cd⟩)
  left_inv x := by
    have hgcd : Int.gcd ((x.1.1 : ℤ) * x.2.1.1) ((x.1.1 : ℤ) * x.2.1.2) = x.1.1 := by
      rw [Int.gcd_mul_left, Int.natAbs_natCast, Int.isCoprime_iff_gcd_eq_one.mp x.2.2.2, mul_one]
    have hm0 : (x.1.1 : ℤ) ≠ 0 := Int.natCast_ne_zero.mpr x.1.2.1.ne'
    exact Prod.ext (Subtype.ext hgcd) (Subtype.ext (Prod.ext
      (by simp only [hgcd]; exact Int.mul_ediv_cancel_left _ hm0)
      (by simp only [hgcd]; exact Int.mul_ediv_cancel_left _ hm0)))
  right_inv p := Subtype.ext (Prod.ext
    (Int.mul_ediv_cancel' (Int.gcd_dvd_left ..)) (Int.mul_ediv_cancel' (Int.gcd_dvd_right ..)))

private theorem tsum_sublattice_eq_realAnalyticEpstein {N r : ℕ} (hN : N ≠ 0) (hr : r ∈ N.divisors)
    (z : ℍ) {s : ℝ} :
    (∑' p : ℤ × ℤ, if p = 0 then 0 else if (N : ℤ) ∣ p.1 ∧ (r : ℤ) ∣ p.2 then epTerm z s p else 0) =
      ((N * r : ℕ) : ℝ) ^ (-s) * realAnalyticEpstein (natScaleH (N / r) z) s := by
  have hr0 : 0 < r := Nat.pos_of_mem_divisors hr
  have hrdvd : r ∣ N := Nat.dvd_of_mem_divisors hr
  have hNr0 : 0 < N / r := Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero hN) hrdvd) hr0
  let e : ℤ × ℤ ≃ ({p : ℤ × ℤ | (N : ℤ) ∣ p.1 ∧ (r : ℤ) ∣ p.2} : Set (ℤ × ℤ)) :=
    ⟨fun q ↦ ⟨((N : ℤ) * q.1, (r : ℤ) * q.2), dvd_mul_right _ _, dvd_mul_right _ _⟩,
      fun p ↦ (p.1.1 / N, p.1.2 / r),
      fun q ↦ Prod.ext (Int.mul_ediv_cancel_left _ (Int.natCast_ne_zero.mpr hN))
        (Int.mul_ediv_cancel_left _ (Int.natCast_ne_zero.mpr hr0.ne')),
      fun p ↦ Subtype.ext (Prod.ext (Int.mul_ediv_cancel' p.2.1) (Int.mul_ediv_cancel' p.2.2))⟩
  rw [← tsum_subtype_eq_of_support_subset (s := {p : ℤ × ℤ | (N : ℤ) ∣ p.1 ∧ (r : ℤ) ∣ p.2})
    (fun p hp ↦ by
      simp only [Function.mem_support, ne_eq] at hp
      by_contra hnd; exact hp (by simp [show ¬ ((N : ℤ) ∣ p.1 ∧ (r : ℤ) ∣ p.2) from hnd])),
    ← e.tsum_eq, realAnalyticEpstein_def, ← tsum_mul_left]
  refine tsum_congr fun q ↦ ?_
  by_cases hq : q = 0
  · subst hq; simp [e]
  · have hne : ((N : ℤ) * q.1, (r : ℤ) * q.2) ≠ 0 := fun h ↦ hq (Prod.ext
      ((mul_eq_zero.mp (Prod.ext_iff.mp h).1).resolve_left (Int.natCast_ne_zero.mpr hN))
      ((mul_eq_zero.mp (Prod.ext_iff.mp h).2).resolve_left (Int.natCast_ne_zero.mpr hr0.ne')))
    simp only [e, Equiv.coe_fn_mk, hne, hq, ↓reduceIte, dvd_mul_right, and_self, epTerm]
    have hN_eq : (N : ℂ) = (r : ℂ) * ((N / r : ℕ) : ℂ) := by
      exact_mod_cast (Nat.mul_div_cancel' hrdvd).symm
    have hcoe : (natScaleH (N / r) z : ℂ) = ((N / r : ℕ) : ℂ) * z := by simp [natScaleH, hNr0]
    have him : (natScaleH (N / r) z).im = ((N / r : ℕ) : ℝ) * z.im := by
      simp [natScaleH, hNr0, mul_im]
    rw [show (((N : ℤ) * q.1 : ℤ) : ℂ) * z + ((r : ℤ) * q.2 : ℤ) =
        (r : ℂ) * ((q.1 : ℂ) * natScaleH (N / r) z + q.2) by rw [hcoe]; push_cast; rw [hN_eq]; ring,
      norm_mul, Complex.norm_natCast, mul_rpow (Nat.cast_nonneg r) (norm_nonneg _),
      him, mul_rpow (Nat.cast_nonneg _) z.im_pos.le]
    have hfac : ((N * r : ℕ) : ℝ) ^ (-s) * ((N / r : ℕ) : ℝ) ^ s = ((r : ℝ) ^ (2 * s))⁻¹ := by
      rw [show (N * r : ℕ) = (N / r) * (r * r) by
            conv_lhs => rw [← Nat.mul_div_cancel' hrdvd]
            ring,
        Nat.cast_mul, Nat.cast_mul, mul_rpow (Nat.cast_nonneg _) (by positivity),
        mul_rpow (Nat.cast_nonneg r) (Nat.cast_nonneg r), mul_right_comm,
        ← rpow_add (Nat.cast_pos.mpr hNr0), neg_add_cancel, rpow_zero, one_mul,
        ← rpow_add (Nat.cast_pos.mpr hr0), show -s + -s = -(2 * s) by ring,
        rpow_neg (Nat.cast_nonneg r)]
    calc z.im ^ s / ((r : ℝ) ^ (2 * s) * ‖(q.1 : ℂ) * ↑(natScaleH (N / r) z) + ↑q.2‖ ^ (2 * s))
        = ((r : ℝ) ^ (2 * s))⁻¹ *
            (z.im ^ s / ‖(q.1 : ℂ) * ↑(natScaleH (N / r) z) + ↑q.2‖ ^ (2 * s)) := by ring
      _ = ((N * r : ℕ) : ℝ) ^ (-s) * (((N / r : ℕ) : ℝ) ^ s * z.im ^ s /
            ‖(q.1 : ℂ) * ↑(natScaleH (N / r) z) + ↑q.2‖ ^ (2 * s)) := by rw [← hfac]; ring

private theorem two_mul_moebius_mul_realAnalyticEisenstein {N : ℕ} (hN : N ≠ 0) (z : ℍ)
    {s : ℝ} (hs : 1 < s) :
    2 * (moebSum N (-(2 * s)) * (∑' n : ℕ, (n : ℝ) ^ (-(2 * s)))) * realAnalyticEisenstein N z s =
      ∑ r ∈ N.divisors, (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-s) *
        realAnalyticEpstein (natScaleH (N / r) z) s := by
  have hsum_m : Summable fun m : {m : ℕ // 0 < m ∧ m.Coprime N} ↦ (m.1 : ℝ) ^ (-(2 * s)) :=
    (Real.summable_nat_rpow.mpr (by linarith)).subtype _
  rw [show 2 * (moebSum N (-(2 * s)) * (∑' n : ℕ, (n : ℝ) ^ (-(2 * s)))) *
        realAnalyticEisenstein N z s =
      (moebSum N (-(2 * s)) * (∑' n : ℕ, (n : ℝ) ^ (-(2 * s)))) *
        (2 * realAnalyticEisenstein N z s) by ring,
    ← tsum_coprime_nat_rpow_eq hN hs, two_mul_realAnalyticEisenstein_eq_tsum_coprime N z hs,
    tsum_mul_tsum_of_summable_norm hsum_m.norm (summable_coprimeBottomRow N z hs).norm]
  rw [show (∑' x : {m : ℕ // 0 < m ∧ m.Coprime N} × CoprimeBottomRow N,
        (x.1.1 : ℝ) ^ (-(2 * s)) * epTerm z s x.2.1) =
      ∑' x : {m : ℕ // 0 < m ∧ m.Coprime N} × CoprimeBottomRow N,
        epTerm z s (coprimeMulEquivBottomRow N x).1 from tsum_congr fun ⟨m, p⟩ ↦ by
      simp only [coprimeMulEquivBottomRow, Equiv.coe_fn_mk, epTerm]
      rw [show (((m.1 : ℤ) * p.1.1 : ℤ) : ℂ) * z + ((m.1 : ℤ) * p.1.2 : ℤ) =
          (m.1 : ℂ) * ((p.1.1 : ℂ) * z + p.1.2) by push_cast; ring,
        norm_mul, Complex.norm_natCast, mul_rpow (Nat.cast_nonneg m.1) (norm_nonneg _),
        rpow_neg (Nat.cast_nonneg m.1)]; ring]
  rw [(coprimeMulEquivBottomRow N).tsum_eq
    (fun p : {p : ℤ × ℤ // p ≠ 0 ∧ (N : ℤ) ∣ p.1 ∧ IsCoprime (N : ℤ) p.2} ↦ epTerm z s p.1)]
  rw [show (∑' p : {p : ℤ × ℤ // p ≠ 0 ∧ (N : ℤ) ∣ p.1 ∧ IsCoprime (N : ℤ) p.2}, epTerm z s p.1) =
      ∑' p : ℤ × ℤ, if p = 0 then 0 else if (N : ℤ) ∣ p.1 then
        (if IsCoprime (N : ℤ) p.2 then (1 : ℝ) else 0) * epTerm z s p else 0 by
    rw [← tsum_subtype_eq_of_support_subset
      (s := {p : ℤ × ℤ | p ≠ 0 ∧ (N : ℤ) ∣ p.1 ∧ IsCoprime (N : ℤ) p.2})]
    · exact tsum_congr fun p ↦ by simp [p.2.1, p.2.2.1, p.2.2.2]
    · intro p hp; simp only [Function.mem_support, ne_eq] at hp
      exact ⟨fun h ↦ by simp [h] at hp, by by_contra h; simp [h] at hp,
        by by_contra h; simp [h] at hp⟩]
  simp_rw [show ∀ p : ℤ × ℤ, (if p = 0 then 0 else if (N : ℤ) ∣ p.1 then
        (if IsCoprime (N : ℤ) p.2 then (1 : ℝ) else 0) * epTerm z s p else 0) =
      ∑ r ∈ N.divisors, (μ r : ℝ) * (if p = 0 then 0 else
        if (N : ℤ) ∣ p.1 ∧ (r : ℤ) ∣ p.2 then epTerm z s p else 0) from fun p ↦ by
    by_cases hp0 : p = 0
    · simp [hp0]
    · by_cases hNd : (N : ℤ) ∣ p.1
      · simp only [hp0, hNd, true_and, ↓reduceIte, ← sum_moebius_divisors_ite_dvd hN p.2,
          Finset.sum_mul]
        exact Finset.sum_congr rfl fun r _ ↦ by split_ifs <;> ring
      · simp [hp0, hNd]]
  rw [Summable.tsum_finsetSum fun r _ ↦ (summable_realAnalyticEpstein_summand z hs).of_norm_bounded
    fun p ↦ by
      have hnn : 0 ≤ epTerm z s p := by positivity
      split_ifs
      · simp
      · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hnn]
        exact mul_le_of_le_one_left hnn (abs_cast_moebius_le_one r)
      · simp [hnn]]
  exact Finset.sum_congr rfl fun r hr ↦ by
    rw [tsum_mul_left, tsum_sublattice_eq_realAnalyticEpstein hN hr z, mul_assoc]

private theorem moebius_divisor_sum_inv_pow {N : ℕ} (hN : N ≠ 0) (k : ℕ) :
    (∑ r ∈ N.divisors, (μ r : ℝ) * ((r : ℝ) ^ k)⁻¹) =
      ∏ p ∈ N.primeFactors, (1 - ((p : ℝ) ^ k)⁻¹) := by
  let fk : ArithmeticFunction ℝ := ⟨fun n ↦ if n = 0 then 0 else ((n : ℝ) ^ k)⁻¹, rfl⟩
  have hfk : fk.IsMultiplicative := ⟨by simp [fk], fun {m n} _ ↦ by
    by_cases hm : m = 0 <;> by_cases hn : n = 0 <;>
      simp [fk, hm, hn, mul_pow, mul_inv_rev, mul_comm]⟩
  rw [← Finset.prod_congr rfl fun p hp ↦ (by simp [fk, (Nat.prime_of_mem_primeFactors hp).ne_zero] :
      1 - fk p = 1 - ((p : ℝ) ^ k)⁻¹),
    ArithmeticFunction.IsMultiplicative.prodPrimeFactors_one_sub fk hfk hN]
  exact Finset.sum_congr rfl fun r hr ↦ by simp [fk, (Nat.pos_of_mem_divisors hr).ne']

private theorem moebius_ratio_eq_inv_Gamma0_index {N : ℕ} (hN : N ≠ 0) :
    0 < moebSum N (-2) ∧
      (∑ r ∈ N.divisors, (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-(1 : ℝ))) / moebSum N (-2) =
        ((CongruenceSubgroup.Gamma0 N).index : ℝ)⁻¹ := by
  have hsum1 : (∑ r ∈ N.divisors, (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-(1 : ℝ))) =
      (N : ℝ)⁻¹ * ∏ p ∈ N.primeFactors, (1 - (p : ℝ)⁻¹) := by
    have h1 := moebius_divisor_sum_inv_pow hN 1
    simp only [pow_one] at h1
    rw [← h1, Finset.mul_sum]
    exact Finset.sum_congr rfl fun r _ ↦ by rw [rpow_neg_one, Nat.cast_mul, mul_inv_rev]; ring
  have hsum2 : moebSum N (-2) = ∏ p ∈ N.primeFactors, (1 - ((p : ℝ) ^ 2)⁻¹) := by
    rw [← moebius_divisor_sum_inv_pow hN 2]
    exact Finset.sum_congr rfl fun r _ ↦ by rw [rpow_neg (Nat.cast_nonneg r), rpow_two]
  have hpos (k : ℕ) (hk : 1 ≤ k) : 0 < ∏ p ∈ N.primeFactors, (1 - ((p : ℝ) ^ k)⁻¹) :=
    Finset.prod_pos fun p hp ↦ by
      have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).two_le
      linarith [inv_lt_one_of_one_lt₀ (one_lt_pow₀ (by linarith : (1 : ℝ) < p) (by omega : k ≠ 0))]
  have hpos1 : 0 < ∏ p ∈ N.primeFactors, (1 - (p : ℝ)⁻¹) := by simpa using hpos 1 le_rfl
  have hprod_fact : (∏ p ∈ N.primeFactors, (1 - ((p : ℝ) ^ 2)⁻¹)) =
      (∏ p ∈ N.primeFactors, (1 - (p : ℝ)⁻¹)) * ∏ p ∈ N.primeFactors, (1 + (p : ℝ)⁻¹) := by
    rw [← Finset.prod_mul_distrib]; exact Finset.prod_congr rfl fun p _ ↦ by ring
  have hindex : (N : ℝ) * ∏ p ∈ N.primeFactors, (1 + (p : ℝ)⁻¹) =
      ((CongruenceSubgroup.Gamma0 N).index : ℝ) := by
    apply mul_right_cancel₀ (Finset.prod_ne_zero_iff.mpr fun p hp ↦
      Nat.cast_ne_zero.mpr (Nat.prime_of_mem_primeFactors hp).ne_zero)
    rw [show ((CongruenceSubgroup.Gamma0 N).index : ℝ) * ∏ p ∈ N.primeFactors, (p : ℝ) =
        (N : ℝ) * ∏ p ∈ N.primeFactors, ((p : ℝ) + 1) by
      simpa using congrArg (Nat.cast (R := ℝ))
        (CongruenceSubgroup.Gamma0_index_mul_prod_primeFactors (N := N)),
      mul_assoc, ← Finset.prod_mul_distrib]
    exact congrArg _ (Finset.prod_congr rfl fun p hp ↦ by
      have hp0 : (p : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.prime_of_mem_primeFactors hp).ne_zero
      field_simp)
  refine ⟨hsum2.symm ▸ hpos 2 (by omega), ?_⟩
  rw [hsum1, hsum2, hprod_fact, ← hindex, mul_comm (N : ℝ)⁻¹, mul_div_mul_left _ _ hpos1.ne',
    div_eq_mul_inv, mul_comm (N : ℝ)⁻¹, ← mul_inv_rev]

/-- **Residue of the level-`N` real-analytic Eisenstein series**: for `N ≠ 0` and every `z ∈ ℍ`,
`lim_{s → 1⁺} (s - 1) E_N(z, s) = 3 / (π * [SL(2, ℤ) : Γ₀(N)])`. -/
theorem tendsto_sub_one_mul_realAnalyticEisenstein (N : ℕ) [NeZero N] (z : ℍ) :
    Tendsto (fun s : ℝ ↦ (s - 1) * realAnalyticEisenstein N z s) (𝓝[>] 1)
      (𝓝 (3 / (π * ((CongruenceSubgroup.Gamma0 N).index : ℝ)))) := by
  have hN : N ≠ 0 := NeZero.ne N
  let D : ℝ → ℝ := fun s ↦ 2 * (moebSum N (-(2 * s)) * ∑' n : ℕ, (n : ℝ) ^ (-(2 * s)))
  let A : ℝ := moebSum N (-2)
  let B : ℝ := ∑ r ∈ N.divisors, (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-(1 : ℝ))
  obtain ⟨hApos, hratio⟩ := moebius_ratio_eq_inv_Gamma0_index hN
  have hD_tendsto : Tendsto D (𝓝[>] 1) (𝓝 (2 * (A * (π ^ 2 / 6)))) :=
    tendsto_const_nhds.mul ((tendsto_finsetSum _ fun r hr ↦ by
      have hc : Continuous fun s : ℝ ↦ (μ r : ℝ) * (r : ℝ) ^ (-(2 * s)) :=
        continuous_const.mul (continuous_const.rpow (continuous_const.mul continuous_id).neg
          fun _ ↦ Or.inl (Nat.cast_ne_zero.mpr (Nat.pos_of_mem_divisors hr).ne'))
      simpa using (hc.continuousAt (x := (1 : ℝ))).tendsto.mono_left nhdsWithin_le_nhds).mul
      tendsto_tsum_nat_rpow_neg_two_mul)
  have hnum_tendsto : Tendsto (fun s : ℝ ↦ (s - 1) * ∑ r ∈ N.divisors,
      (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-s) * realAnalyticEpstein (natScaleH (N / r) z) s)
      (𝓝[>] 1) (𝓝 (B * π)) := by
    rw [show (fun s : ℝ ↦ (s - 1) * ∑ r ∈ N.divisors, (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-s) *
          realAnalyticEpstein (natScaleH (N / r) z) s) = fun s : ℝ ↦ ∑ r ∈ N.divisors,
        ((μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-s)) *
          ((s - 1) * realAnalyticEpstein (natScaleH (N / r) z) s) by
      ext s; rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun r _ ↦ by ring,
      show B * π = ∑ r ∈ N.divisors, ((μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-(1 : ℝ))) * π from
        Finset.sum_mul ..]
    refine tendsto_finsetSum _ fun r hr ↦ ?_
    have hc : Continuous fun s : ℝ ↦ (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-s) :=
      continuous_const.mul (continuous_const.rpow continuous_neg fun _ ↦
        Or.inl (Nat.cast_ne_zero.mpr (mul_ne_zero hN (Nat.pos_of_mem_divisors hr).ne')))
    exact ((hc.continuousAt (x := (1 : ℝ))).tendsto.mono_left nhdsWithin_le_nhds).mul
      (tendsto_sub_one_mul_realAnalyticEpstein (natScaleH (N / r) z))
  have hD_pos : 0 < 2 * (A * (π ^ 2 / 6)) := by positivity
  have hdiv := hnum_tendsto.div hD_tendsto hD_pos.ne'
  rw [show (B * π) / (2 * (A * (π ^ 2 / 6))) =
      3 / (π * ((CongruenceSubgroup.Gamma0 N).index : ℝ)) by
    have : (B * π) / (2 * (A * (π ^ 2 / 6))) = (B / A) * (3 / π) := by
      field_simp [hApos.ne', Real.pi_pos.ne']; ring
    rw [this, hratio]; ring] at hdiv
  refine hdiv.congr' ?_
  filter_upwards [self_mem_nhdsWithin, hD_tendsto.eventually (Ioi_mem_nhds hD_pos)] with s hs hDs
  have hDs_ne : D s ≠ 0 := (Set.mem_Ioi.mp hDs).ne'
  have hid : D s * realAnalyticEisenstein N z s = _ :=
    two_mul_moebius_mul_realAnalyticEisenstein hN z (Set.mem_Ioi.mp hs)
  rw [Pi.div_apply, ← hid]
  field_simp [hDs_ne]

end TauCeti.EisensteinSeries
