/-! ### The projective parabolic subgroup `⟨T⟩` and `realAnalyticEisenstein` -/

/-- The subgroup of `PSL(2, ℤ)` generated by the translation `T`, i.e., the stabilizer of `∞`. -/
def pslTSubgroup : Subgroup PSL(2, ℤ) :=
  Subgroup.zpowers (ModularGroup.T : PSL(2, ℤ))

/-- An element of `SL(2, ℤ)` maps into `pslTSubgroup` exactly when its lower-left entry is `0`. -/
theorem mem_pslTSubgroup_mk_iff (γ : SL(2, ℤ)) :
    (γ : PSL(2, ℤ)) ∈ pslTSubgroup ↔ γ 1 0 = 0 := by
  constructor
  · rintro ⟨n, hn⟩
    have hmk : QuotientGroup.mk' (Subgroup.center SL(2, ℤ)) γ =
        QuotientGroup.mk' (Subgroup.center SL(2, ℤ)) (ModularGroup.T ^ n) := by
      rw [map_zpow]; exact hn.symm
    obtain ⟨c, hc, hγ⟩ := (QuotientGroup.mk'_eq_mk' (Subgroup.center SL(2, ℤ))).mp hmk
    have hγ' : γ = ModularGroup.T ^ n * c⁻¹ := eq_mul_inv_of_mul_eq hγ
    rcases Matrix.SpecialLinearGroup.mem_center_iff_eq_one_or_eq_neg_one.mp hc with rfl | rfl
    · rw [hγ', inv_one, mul_one]; simp [ModularGroup.coe_T_zpow]
    · rw [hγ', inv_neg, inv_one, mul_neg, mul_one]; simp [ModularGroup.coe_T_zpow]
  · intro hc
    obtain ⟨n, hn⟩ := ModularGroup.exists_eq_T_zpow_of_c_eq_zero hc
    refine ⟨n, eq_of_smul_eq_smul fun z : ℍ ↦ ?_⟩
    have hpow : (ModularGroup.T : PSL(2, ℤ)) ^ n = ((ModularGroup.T ^ n : SL(2, ℤ)) : PSL(2, ℤ)) :=
      (map_zpow (QuotientGroup.mk' (Subgroup.center SL(2, ℤ))) ModularGroup.T n).symm
    dsimp only
    rw [hpow]
    change ((ModularGroup.T ^ n : SL(2, ℤ)) : PSL(2, ℤ)) • z = (γ : PSL(2, ℤ)) • z
    rw [UpperHalfPlane.pslMk_smul, UpperHalfPlane.pslMk_smul, hn z]

/-- The parabolic subgroup `⟨T⟩` lies in `Gamma0Projective N` for every level `N`. -/
theorem pslTSubgroup_le_Gamma0Projective (N : ℕ) :
    pslTSubgroup ≤ TauCeti.CongruenceSubgroup.Gamma0Projective N := by
  rw [pslTSubgroup, Subgroup.zpowers_le, TauCeti.CongruenceSubgroup.mem_Gamma0Projective_mk,
    CongruenceSubgroup.mem_Gamma0_iff_dvd]
  simp [ModularGroup.coe_T]

/-- Elements of `pslTSubgroup` act on `ℍ` by integer horizontal translations and hence preserve
the imaginary part. -/
theorem im_smul_eq_of_mem_pslTSubgroup {h : PSL(2, ℤ)} (hh : h ∈ pslTSubgroup) (z : ℍ) :
    (h • z).im = z.im := by
  obtain ⟨n, rfl⟩ := hh
  have hpow : (ModularGroup.T : PSL(2, ℤ)) ^ n = ((ModularGroup.T ^ n : SL(2, ℤ)) : PSL(2, ℤ)) :=
    (map_zpow (QuotientGroup.mk' (Subgroup.center SL(2, ℤ))) ModularGroup.T n).symm
  dsimp only
  rw [hpow]
  change (((ModularGroup.T ^ n : SL(2, ℤ)) : PSL(2, ℤ)) • z).im = z.im
  rw [UpperHalfPlane.pslMk_smul, ModularGroup.im_T_zpow_smul]

/-- The summand `q ↦ (Im (q⁻¹ • z)) ^ s` of the level-`N` real-analytic Eisenstein series,
canonically descended to `Gamma0Projective N ⧸ pslTSubgroup`. -/
def realAnalyticEisensteinSummand (N : ℕ) (z : ℍ) (s : ℝ) :
    TauCeti.CongruenceSubgroup.Gamma0Projective N ⧸
        pslTSubgroup.subgroupOf (TauCeti.CongruenceSubgroup.Gamma0Projective N) → ℝ :=
  Quotient.lift
    (fun g : TauCeti.CongruenceSubgroup.Gamma0Projective N ↦ (((g : PSL(2, ℤ))⁻¹ • z).im) ^ s)
    fun g₁ g₂ hrel ↦ by
      have hmem : ((g₁ : PSL(2, ℤ))⁻¹ * (g₂ : PSL(2, ℤ)))⁻¹ ∈ pslTSubgroup :=
        pslTSubgroup.inv_mem (Subgroup.mem_subgroupOf.mp (QuotientGroup.leftRel_apply.mp hrel))
      have heq : (g₂ : PSL(2, ℤ))⁻¹ =
          ((g₁ : PSL(2, ℤ))⁻¹ * (g₂ : PSL(2, ℤ)))⁻¹ * (g₁ : PSL(2, ℤ))⁻¹ := by group
      rw [heq, mul_smul, im_smul_eq_of_mem_pslTSubgroup hmem]

/-- Evaluation of `realAnalyticEisensteinSummand` on a coset representative `QuotientGroup.mk g`. -/
@[simp]
theorem realAnalyticEisensteinSummand_mk (N : ℕ) (z : ℍ) (s : ℝ)
    (g : TauCeti.CongruenceSubgroup.Gamma0Projective N) :
    realAnalyticEisensteinSummand N z s (QuotientGroup.mk g) =
      (((g : PSL(2, ℤ))⁻¹ • z).im) ^ s := (rfl)

/-- Evaluation of `realAnalyticEisensteinSummand` on a coset `q` via `Quotient.out q`. -/
theorem realAnalyticEisensteinSummand_eq_out (N : ℕ) (z : ℍ) (s : ℝ)
    (q : TauCeti.CongruenceSubgroup.Gamma0Projective N ⧸
      pslTSubgroup.subgroupOf (TauCeti.CongruenceSubgroup.Gamma0Projective N)) :
    realAnalyticEisensteinSummand N z s q =
      ((((q.out : TauCeti.CongruenceSubgroup.Gamma0Projective N) : PSL(2, ℤ))⁻¹ • z).im) ^ s := by
  conv_lhs => rw [← Quotient.out_eq q]
  rfl

/-- **The real-analytic Eisenstein series at the cusp `∞` for `Γ₀(N)`**:
`E_N(z, s) = ∑' q ∈ Γ_∞ \ Γ₀(N), (Im (q • z)) ^ s`. -/
def realAnalyticEisenstein (N : ℕ) (z : ℍ) (s : ℝ) : ℝ :=
  ∑' q, realAnalyticEisensteinSummand N z s q

/-- Unfolding of `realAnalyticEisenstein` as a `tsum` over `Gamma0Projective N ⧸ pslTSubgroup`. -/
theorem realAnalyticEisenstein_def (N : ℕ) (z : ℍ) (s : ℝ) :
    realAnalyticEisenstein N z s = ∑' q, realAnalyticEisensteinSummand N z s q := (rfl)

/-- Every term of `realAnalyticEisenstein` is nonnegative. -/
theorem realAnalyticEisenstein_nonneg (N : ℕ) (z : ℍ) (s : ℝ) :
    0 ≤ realAnalyticEisenstein N z s :=
  tsum_nonneg fun q ↦ by
    rw [realAnalyticEisensteinSummand_eq_out]; exact rpow_nonneg (UpperHalfPlane.im_pos _).le s

/-- **`Γ₀(N)`-invariance of `realAnalyticEisenstein N`**. -/
theorem realAnalyticEisenstein_smul (N : ℕ) {γ : SL(2, ℤ)}
    (hγ : γ ∈ CongruenceSubgroup.Gamma0 N) (z : ℍ) (s : ℝ) :
    realAnalyticEisenstein N (γ • z) s = realAnalyticEisenstein N z s := by
  let g₀ : TauCeti.CongruenceSubgroup.Gamma0Projective N :=
    ⟨(γ : PSL(2, ℤ)), (TauCeti.CongruenceSubgroup.mem_Gamma0Projective_mk N γ).mpr hγ⟩
  let e : (TauCeti.CongruenceSubgroup.Gamma0Projective N ⧸
      pslTSubgroup.subgroupOf (TauCeti.CongruenceSubgroup.Gamma0Projective N)) ≃
      (TauCeti.CongruenceSubgroup.Gamma0Projective N ⧸
      pslTSubgroup.subgroupOf (TauCeti.CongruenceSubgroup.Gamma0Projective N)) :=
    MulAction.toPerm (α := TauCeti.CongruenceSubgroup.Gamma0Projective N) g₀
  rw [realAnalyticEisenstein, realAnalyticEisenstein, ← e.tsum_eq]
  refine tsum_congr fun q ↦ ?_
  induction q using QuotientGroup.induction_on with
  | H g =>
    change realAnalyticEisensteinSummand N (γ • z) s (QuotientGroup.mk (g₀ * g)) =
      realAnalyticEisensteinSummand N z s (QuotientGroup.mk g)
    rw [realAnalyticEisensteinSummand_mk, realAnalyticEisensteinSummand_mk]
    simp only [Subgroup.coe_mul, mul_inv_rev, mul_smul, g₀]
    rw [← UpperHalfPlane.pslMk_smul, inv_smul_smul]

/-- Each summand `z ↦ realAnalyticEisensteinSummand N z s q` is continuous on `ℍ`. -/
theorem continuous_realAnalyticEisensteinSummand (N : ℕ) (s : ℝ)
    (q : TauCeti.CongruenceSubgroup.Gamma0Projective N ⧸
      pslTSubgroup.subgroupOf (TauCeti.CongruenceSubgroup.Gamma0Projective N)) :
    Continuous fun z : ℍ ↦ realAnalyticEisensteinSummand N z s q := by
  induction q using QuotientGroup.induction_on with
  | H g =>
    simp only [realAnalyticEisensteinSummand_mk]
    obtain ⟨γ, hγ⟩ := QuotientGroup.mk_surjective (g : PSL(2, ℤ))⁻¹
    rw [← hγ]
    have hsmul : Continuous fun z : ℍ ↦ ((γ : PSL(2, ℤ)) • z).im := by
      have : (fun z : ℍ ↦ ((γ : PSL(2, ℤ)) • z).im) = fun z : ℍ ↦ (mapGL ℝ γ • z).im := by
        ext z; rfl
      rw [this]
      exact UpperHalfPlane.continuous_im.comp (continuous_const_smul (mapGL ℝ γ))
    exact hsmul.rpow continuous_const fun z ↦ Or.inl (UpperHalfPlane.im_pos _).ne'

/-- Measurability of `z ↦ realAnalyticEisenstein N z s` on `ℍ`. -/
theorem measurable_realAnalyticEisenstein (N : ℕ) (s : ℝ) :
    Measurable fun z : ℍ ↦ realAnalyticEisenstein N z s :=
  Measurable.tsum fun q ↦ (continuous_realAnalyticEisensteinSummand N s q).measurable

/-! ### Bijection with coprime bottom rows and Möbius inversion -/

/-- Primitive integer pairs `(c, d)` with `N ∣ c`, i.e., bottom rows of matrices in `Γ₀(N)`. -/
private abbrev CoprimeBottomRow (N : ℕ) := {p : ℤ × ℤ // (N : ℤ) ∣ p.1 ∧ IsCoprime p.1 p.2}

private theorem coprimeBottomRow_ne_zero {N : ℕ} (p : CoprimeBottomRow N) : p.1 ≠ 0 := by
  intro h
  have hcop := p.2.2
  rw [h] at hcop
  exact not_isUnit_zero (isCoprime_zero_left.mp hcop)

/-- Two coprime pairs `(c₁, d₁)` and `(c₂, d₂)` satisfying `c₁ d₂ = d₁ c₂` coincide up to sign. -/
private theorem eq_or_eq_neg_of_isCoprime_mul_eq {c₁ d₁ c₂ d₂ : ℤ}
    (h1 : IsCoprime c₁ d₁) (h2 : IsCoprime c₂ d₂) (heq : c₁ * d₂ = d₁ * c₂) :
    (c₂ = c₁ ∧ d₂ = d₁) ∨ (c₂ = -c₁ ∧ d₂ = -d₁) := by
  have hc12 : c₁ ∣ c₂ := h1.dvd_of_dvd_mul_left ⟨d₂, by linarith⟩
  have hc21 : c₂ ∣ c₁ := h2.dvd_of_dvd_mul_left ⟨d₁, by linarith⟩
  have hd12 : d₁ ∣ d₂ := h1.symm.dvd_of_dvd_mul_left ⟨c₂, by linarith⟩
  have hd21 : d₂ ∣ d₁ := h2.symm.dvd_of_dvd_mul_left ⟨c₁, by linarith⟩
  rcases Int.associated_iff.mp (associated_of_dvd_dvd hc12 hc21) with hc | hc <;>
    rcases Int.associated_iff.mp (associated_of_dvd_dvd hd12 hd21) with hd | hd
  · exact Or.inl ⟨hc.symm, hd.symm⟩
  · by_cases h0 : c₁ = 0
    · exact Or.inr ⟨by omega, by omega⟩
    · by_cases hd0 : d₁ = 0
      · exact Or.inl ⟨hc.symm, by omega⟩
      · exfalso
        have : c₁ * d₁ = 0 := by
          have hc' : c₂ = c₁ := hc.symm
          have hd' : d₂ = -d₁ := by omega
          rw [hc', hd'] at heq; linarith
        exact mul_ne_zero h0 hd0 this
  · by_cases h0 : c₁ = 0
    · exact Or.inl ⟨by omega, hd.symm⟩
    · by_cases hd0 : d₁ = 0
      · exact Or.inr ⟨by omega, by omega⟩
      · exfalso
        have : c₁ * d₁ = 0 := by
          have hc' : c₂ = -c₁ := by omega
          have hd' : d₂ = d₁ := hd.symm
          rw [hc', hd'] at heq; linarith
        exact mul_ne_zero h0 hd0 this
  · exact Or.inr ⟨by omega, by omega⟩

/-- Every matrix in `SL(2, ℤ)` has coprime bottom row. -/
private theorem isCoprime_bottom_row (γ : SL(2, ℤ)) : IsCoprime (γ 1 0) (γ 1 1) :=
  ⟨-(γ 0 1), γ 0 0, by have h := γ.det_coe; rw [Matrix.det_fin_two] at h; linarith⟩

/-- The `(1, 0)` entry of `γ₁ * γ₂⁻¹` in `SL(2, ℤ)` is `c₁ d₂ - d₁ c₂`. -/
private theorem mul_inv_apply_one_zero (γ₁ γ₂ : SL(2, ℤ)) :
    (γ₁ * γ₂⁻¹) 1 0 = γ₁ 1 0 * γ₂ 1 1 - γ₁ 1 1 * γ₂ 1 0 := by
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two,
    Matrix.SpecialLinearGroup.SL2_inv_expl]
  simp; ring

/-- Lift a coprime pair `(c, d)` with `N ∣ c` to a matrix in `Γ₀(N)` with bottom row `(c, d)`. -/
private def liftCoprimeBottomRow (N : ℕ) (p : CoprimeBottomRow N) :
    {γ : SL(2, ℤ) // γ ∈ CongruenceSubgroup.Gamma0 N ∧ γ 1 0 = p.1.1 ∧ γ 1 1 = p.1.2} := by
  classical
  have hex : ∃ a b : ℤ, a * p.1.1 + b * p.1.2 = 1 := p.2.2
  let a := hex.choose
  let b := hex.choose_spec.choose
  have hab : a * p.1.1 + b * p.1.2 = 1 := hex.choose_spec.choose_spec
  let γ : SL(2, ℤ) := ⟨!![b, -a; p.1.1, p.1.2], by rw [Matrix.det_fin_two_of]; linarith⟩
  refine ⟨γ, ?_, rfl, rfl⟩
  rw [CongruenceSubgroup.mem_Gamma0_iff_dvd]
  exact p.2.1

/-- Chosen `Γ₀(N)` representative lifting `(q.out)⁻¹` for a coset `q ∈ Γ_∞ \ Γ₀(N)`. -/
private def gamma0CosetRep (N : ℕ)
    (q : TauCeti.CongruenceSubgroup.Gamma0Projective N ⧸
      pslTSubgroup.subgroupOf (TauCeti.CongruenceSubgroup.Gamma0Projective N)) : SL(2, ℤ) := by
  classical
  exact ((TauCeti.CongruenceSubgroup.mem_Gamma0Projective_iff N _).mp
    ((TauCeti.CongruenceSubgroup.Gamma0Projective N).inv_mem q.out.2)).choose

private theorem gamma0CosetRep_mk (N : ℕ)
    (q : TauCeti.CongruenceSubgroup.Gamma0Projective N ⧸
      pslTSubgroup.subgroupOf (TauCeti.CongruenceSubgroup.Gamma0Projective N)) :
    (gamma0CosetRep N q : PSL(2, ℤ)) =
      ((q.out : TauCeti.CongruenceSubgroup.Gamma0Projective N) : PSL(2, ℤ))⁻¹ := by
  classical
  exact ((TauCeti.CongruenceSubgroup.mem_Gamma0Projective_iff N _).mp
    ((TauCeti.CongruenceSubgroup.Gamma0Projective N).inv_mem q.out.2)).choose_spec.1

private theorem gamma0CosetRep_mem (N : ℕ)
    (q : TauCeti.CongruenceSubgroup.Gamma0Projective N ⧸
      pslTSubgroup.subgroupOf (TauCeti.CongruenceSubgroup.Gamma0Projective N)) :
    gamma0CosetRep N q ∈ CongruenceSubgroup.Gamma0 N := by
  classical
  exact ((TauCeti.CongruenceSubgroup.mem_Gamma0Projective_iff N _).mp
    ((TauCeti.CongruenceSubgroup.Gamma0Projective N).inv_mem q.out.2)).choose_spec.2

/-- Underlying map sending `(b, q)` to the signed bottom row of `gamma0CosetRep N q`. -/
private def boolProdQuotToBottomRow (N : ℕ)
    (x : Bool × (TauCeti.CongruenceSubgroup.Gamma0Projective N ⧸
      pslTSubgroup.subgroupOf (TauCeti.CongruenceSubgroup.Gamma0Projective N))) :
    CoprimeBottomRow N :=
  ⟨(if x.1 then -(gamma0CosetRep N x.2 1 0) else gamma0CosetRep N x.2 1 0,
    if x.1 then -(gamma0CosetRep N x.2 1 1) else gamma0CosetRep N x.2 1 1), by
    have hc := CongruenceSubgroup.mem_Gamma0_iff_dvd.mp (gamma0CosetRep_mem N x.2)
    have hcop := isCoprime_bottom_row (gamma0CosetRep N x.2)
    cases x.1 <;> simp [hc, hcop, dvd_neg, IsCoprime.neg_left_iff, IsCoprime.neg_right_iff]⟩

private theorem boolProdQuotToBottomRow_injective (N : ℕ) :
    Function.Injective (boolProdQuotToBottomRow N) := by
  rintro ⟨b₁, q₁⟩ ⟨b₂, q₂⟩ heq
  have hpair := congrArg Subtype.val heq
  dsimp only [boolProdQuotToBottomRow] at hpair
  have hmul : gamma0CosetRep N q₁ 1 0 * gamma0CosetRep N q₂ 1 1 -
      gamma0CosetRep N q₁ 1 1 * gamma0CosetRep N q₂ 1 0 = 0 := by
    cases b₁ <;> cases b₂ <;> simp only [Bool.false_eq_true, ↓reduceIte, Prod.mk.injEq] at hpair
    · rw [hpair.1, hpair.2]; ring
    · rw [hpair.1, hpair.2]; ring
    · have h1 : gamma0CosetRep N q₁ 1 0 = -gamma0CosetRep N q₂ 1 0 := by omega
      have h2 : gamma0CosetRep N q₁ 1 1 = -gamma0CosetRep N q₂ 1 1 := by omega
      rw [h1, h2]; ring
    · have h1 : gamma0CosetRep N q₁ 1 0 = gamma0CosetRep N q₂ 1 0 := by omega
      have h2 : gamma0CosetRep N q₁ 1 1 = gamma0CosetRep N q₂ 1 1 := by omega
      rw [h1, h2]; ring
  have hc0 : (gamma0CosetRep N q₁ * (gamma0CosetRep N q₂)⁻¹) 1 0 = 0 := by
    rw [mul_inv_apply_one_zero, hmul]
  have hq : q₁ = q₂ := by
    rw [← Quotient.out_eq q₁, ← Quotient.out_eq q₂, QuotientGroup.eq, Subgroup.mem_subgroupOf]
    have hcalc : ((q₁.out : TauCeti.CongruenceSubgroup.Gamma0Projective N) : PSL(2, ℤ))⁻¹ *
        ((q₂.out : TauCeti.CongruenceSubgroup.Gamma0Projective N) : PSL(2, ℤ)) =
        ((gamma0CosetRep N q₁ * (gamma0CosetRep N q₂)⁻¹ : SL(2, ℤ)) : PSL(2, ℤ)) := by
      change _ = QuotientGroup.mk' (Subgroup.center SL(2, ℤ))
        (gamma0CosetRep N q₁ * (gamma0CosetRep N q₂)⁻¹)
      rw [map_mul, map_inv]
      change _ = (gamma0CosetRep N q₁ : PSL(2, ℤ)) * (gamma0CosetRep N q₂ : PSL(2, ℤ))⁻¹
      rw [gamma0CosetRep_mk N q₁, gamma0CosetRep_mk N q₂, inv_inv]
    simpa [hcalc] using
      (mem_pslTSubgroup_mk_iff (gamma0CosetRep N q₁ * (gamma0CosetRep N q₂)⁻¹)).mpr hc0
  subst hq
  have hne : (gamma0CosetRep N q₁ 1 0, gamma0CosetRep N q₁ 1 1) ≠ (0, 0) :=
    coprimeBottomRow_ne_zero (N := N) ⟨_, CongruenceSubgroup.mem_Gamma0_iff_dvd.mp
      (gamma0CosetRep_mem N q₁), isCoprime_bottom_row _⟩
  cases b₁ <;> cases b₂
  · rfl
  · exfalso; simp only [Bool.false_eq_true, ↓reduceIte, Prod.mk.injEq] at hpair
    exact hne (Prod.ext (by omega) (by omega))
  · exfalso; simp only [Bool.false_eq_true, ↓reduceIte, Prod.mk.injEq] at hpair
    exact hne (Prod.ext (by omega) (by omega))
  · rfl

private theorem boolProdQuotToBottomRow_surjective (N : ℕ) :
    Function.Surjective (boolProdQuotToBottomRow N) := by
  intro p
  let γ := liftCoprimeBottomRow N p
  let q : TauCeti.CongruenceSubgroup.Gamma0Projective N ⧸
      pslTSubgroup.subgroupOf (TauCeti.CongruenceSubgroup.Gamma0Projective N) :=
    QuotientGroup.mk ⟨(γ.1 : PSL(2, ℤ))⁻¹,
      (TauCeti.CongruenceSubgroup.Gamma0Projective N).inv_mem
        ((TauCeti.CongruenceSubgroup.mem_Gamma0Projective_mk N γ.1).mpr γ.2.1)⟩
  have hrel : ((q.out : TauCeti.CongruenceSubgroup.Gamma0Projective N) : PSL(2, ℤ))⁻¹ *
      ((γ.1 : PSL(2, ℤ))⁻¹) ∈ pslTSubgroup :=
    Subgroup.mem_subgroupOf.mp (QuotientGroup.eq.mp (Quotient.out_eq q))
  have hcalc : ((gamma0CosetRep N q * γ.1⁻¹ : SL(2, ℤ)) : PSL(2, ℤ)) ∈ pslTSubgroup := by
    change QuotientGroup.mk' (Subgroup.center SL(2, ℤ)) (gamma0CosetRep N q * γ.1⁻¹) ∈ _
    rw [map_mul, map_inv]
    change (gamma0CosetRep N q : PSL(2, ℤ)) * (γ.1 : PSL(2, ℤ))⁻¹ ∈ pslTSubgroup
    rwa [gamma0CosetRep_mk N q]
  have hc0 := (mem_pslTSubgroup_mk_iff (gamma0CosetRep N q * γ.1⁻¹)).mp hcalc
  have hmul : gamma0CosetRep N q 1 0 * p.1.2 = gamma0CosetRep N q 1 1 * p.1.1 := by
    rw [mul_inv_apply_one_zero, γ.2.2.1, γ.2.2.2] at hc0; linarith
  rcases eq_or_eq_neg_of_isCoprime_mul_eq (isCoprime_bottom_row (gamma0CosetRep N q))
    p.2.2 hmul with ⟨hc, hd⟩ | ⟨hc, hd⟩
  · exact ⟨(false, q), Subtype.ext (Prod.ext (by simpa [boolProdQuotToBottomRow] using hc.symm)
      (by simpa [boolProdQuotToBottomRow] using hd.symm))⟩
  · exact ⟨(true, q), Subtype.ext (Prod.ext (by simpa [boolProdQuotToBottomRow] using hc.symm)
      (by simpa [boolProdQuotToBottomRow] using hd.symm))⟩

/-- Explicit 2-to-1 bijection between `Bool × (Γ_∞ \ Γ₀(N))` and `CoprimeBottomRow N`. -/
private def boolProdQuotEquivCoprimeBottomRow (N : ℕ) :
    Bool × (TauCeti.CongruenceSubgroup.Gamma0Projective N ⧸
        pslTSubgroup.subgroupOf (TauCeti.CongruenceSubgroup.Gamma0Projective N)) ≃
      CoprimeBottomRow N :=
  Equiv.ofBijective (boolProdQuotToBottomRow N)
    ⟨boolProdQuotToBottomRow_injective N, boolProdQuotToBottomRow_surjective N⟩

/-- Pointwise evaluation of the Eisenstein summand along `boolProdQuotEquivCoprimeBottomRow`. -/
private theorem realAnalyticEisensteinSummand_eq_coprimeBottomRow (N : ℕ) (z : ℍ) (s : ℝ)
    (b : Bool) (q : TauCeti.CongruenceSubgroup.Gamma0Projective N ⧸
      pslTSubgroup.subgroupOf (TauCeti.CongruenceSubgroup.Gamma0Projective N)) :
    z.im ^ s / ‖(((boolProdQuotEquivCoprimeBottomRow N (b, q)).1.1 : ℂ) * z +
        (boolProdQuotEquivCoprimeBottomRow N (b, q)).1.2)‖ ^ (2 * s) =
      realAnalyticEisensteinSummand N z s q := by
  set γ : SL(2, ℤ) := gamma0CosetRep N q
  have hrow : (((boolProdQuotEquivCoprimeBottomRow N (b, q)).1.1 : ℂ) * z +
      (boolProdQuotEquivCoprimeBottomRow N (b, q)).1.2) =
      if b then -((γ 1 0 : ℂ) * z + γ 1 1) else (γ 1 0 : ℂ) * z + γ 1 1 := by
    change (((boolProdQuotToBottomRow N (b, q)).1.1 : ℂ) * z +
      (boolProdQuotToBottomRow N (b, q)).1.2) = _
    cases b <;> simp [boolProdQuotToBottomRow, γ]
    ring
  rw [hrow, realAnalyticEisensteinSummand_eq_out, ← gamma0CosetRep_mk N q,
    UpperHalfPlane.pslMk_smul, ModularGroup.im_smul_eq_div_normSq, ModularGroup.denom_apply]
  have hnorm : ‖if b then -((γ 1 0 : ℂ) * z + γ 1 1) else (γ 1 0 : ℂ) * z + γ 1 1‖ =
      ‖(γ 1 0 : ℂ) * z + γ 1 1‖ := by
    cases b <;> simp only [↓reduceIte, Bool.false_eq_true, norm_neg]
  rw [hnorm, div_rpow z.im_pos.le (Complex.normSq_nonneg _), ← Complex.sq_norm,
    ← rpow_natCast ‖_‖ 2, ← rpow_mul (norm_nonneg _)]
  congr 2

/-- Express `2 * E_N(z, s)` as the sum over all coprime bottom rows `(c, d)` with `N ∣ c`. -/
private theorem two_mul_realAnalyticEisenstein_eq_tsum_coprime (N : ℕ) (z : ℍ) (s : ℝ) :
    2 * realAnalyticEisenstein N z s =
      ∑' p : CoprimeBottomRow N, z.im ^ s / ‖(p.1.1 : ℂ) * z + p.1.2‖ ^ (2 * s) := by
  rw [← (boolProdQuotEquivCoprimeBottomRow N).tsum_eq]
  have hval := fun b q ↦ realAnalyticEisensteinSummand_eq_coprimeBottomRow N z s b q
  by_cases hsum : Summable fun q ↦ realAnalyticEisensteinSummand N z s q
  · have hprod : Summable fun x : Bool × _ ↦
        z.im ^ s / ‖(((boolProdQuotEquivCoprimeBottomRow N x).1.1 : ℂ) * z +
          (boolProdQuotEquivCoprimeBottomRow N x).1.2)‖ ^ (2 * s) := by
      have hfun : (fun x : Bool × _ ↦ z.im ^ s /
          ‖(((boolProdQuotEquivCoprimeBottomRow N x).1.1 : ℂ) * z +
            (boolProdQuotEquivCoprimeBottomRow N x).1.2)‖ ^ (2 * s)) =
          fun x ↦ realAnalyticEisensteinSummand N z s x.2 := funext fun ⟨b, q⟩ ↦ hval b q
      rw [hfun]
      exact (summable_prod_of_nonneg fun x ↦ by
        rw [realAnalyticEisensteinSummand_eq_out]
        exact rpow_nonneg (UpperHalfPlane.im_pos _).le s).mpr
        ⟨fun _ ↦ hsum, Summable.of_finite⟩
    rw [hprod.tsum_prod' fun b ↦ hsum.congr fun q ↦ (hval b q).symm]
    simp_rw [hval, tsum_bool, ← two_mul, realAnalyticEisenstein]
  · have hnsum : ¬ Summable fun x : Bool × _ ↦
        z.im ^ s / ‖(((boolProdQuotEquivCoprimeBottomRow N x).1.1 : ℂ) * z +
          (boolProdQuotEquivCoprimeBottomRow N x).1.2)‖ ^ (2 * s) := fun hp ↦
      hsum ((hp.prod_factor false).congr fun q ↦ hval false q)
    rw [realAnalyticEisenstein, tsum_eq_zero_of_not_summable hsum,
      tsum_eq_zero_of_not_summable hnsum, mul_zero]

/-- Summability of the real-analytic Eisenstein series summand for `s > 1`. -/
theorem summable_realAnalyticEisensteinSummand (N : ℕ) (z : ℍ) {s : ℝ} (hs : 1 < s) :
    Summable (realAnalyticEisensteinSummand N z s) := by
  have hsub : Summable fun p : CoprimeBottomRow N ↦
      z.im ^ s / ‖(p.1.1 : ℂ) * z + p.1.2‖ ^ (2 * s) :=
    ((summable_realAnalyticEpstein_summand z hs).subtype _).congr fun p ↦ by
      simp [coprimeBottomRow_ne_zero p]
  have hprod := (boolProdQuotEquivCoprimeBottomRow N).summable_iff.mpr hsub
  exact (hprod.prod_factor false).congr fun q ↦
    realAnalyticEisensteinSummand_eq_coprimeBottomRow N z s false q

/-- **Comparison across levels**: `E_N(z, s) ≤ E_1(z, s)` for all `N` and `s > 1`. -/
theorem realAnalyticEisenstein_le_one (N : ℕ) (z : ℍ) {s : ℝ} (hs : 1 < s) :
    realAnalyticEisenstein N z s ≤ realAnalyticEisenstein 1 z s := by
  have hsum (M : ℕ) : Summable fun p : CoprimeBottomRow M ↦
      z.im ^ s / ‖(p.1.1 : ℂ) * z + p.1.2‖ ^ (2 * s) :=
    ((summable_realAnalyticEpstein_summand z hs).subtype _).congr fun p ↦ by
      simp [coprimeBottomRow_ne_zero p]
  have h2 : 2 * realAnalyticEisenstein N z s ≤ 2 * realAnalyticEisenstein 1 z s := by
    rw [two_mul_realAnalyticEisenstein_eq_tsum_coprime,
      two_mul_realAnalyticEisenstein_eq_tsum_coprime]
    let emb : CoprimeBottomRow N → CoprimeBottomRow 1 := fun p ↦ ⟨p.1, ⟨one_dvd _, p.2.2⟩⟩
    exact (hsum N).tsum_le_tsum_of_inj emb
      (fun x y h ↦ Subtype.ext (congrArg (fun a : CoprimeBottomRow 1 ↦ a.1) h))
      (fun _ _ ↦ by positivity) (fun _ ↦ le_rfl) (hsum 1)
  linarith

/-- **Comparison with Epstein zeta**: `E_1(z, s) ≤ Z(z, s)` for all `z ∈ ℍ` and `s > 1`. -/
theorem realAnalyticEisenstein_one_le_realAnalyticEpstein (z : ℍ) {s : ℝ} (hs : 1 < s) :
    realAnalyticEisenstein 1 z s ≤ realAnalyticEpstein z s := by
  have hsum1 : Summable fun p : CoprimeBottomRow 1 ↦
      z.im ^ s / ‖(p.1.1 : ℂ) * z + p.1.2‖ ^ (2 * s) :=
    ((summable_realAnalyticEpstein_summand z hs).subtype _).congr fun p ↦ by
      simp [coprimeBottomRow_ne_zero p]
  have h2 : 2 * realAnalyticEisenstein 1 z s ≤ realAnalyticEpstein z s := by
    rw [two_mul_realAnalyticEisenstein_eq_tsum_coprime, realAnalyticEpstein_def]
    refine hsum1.tsum_le_tsum_of_inj Subtype.val Subtype.val_injective
      (fun _ _ ↦ by split_ifs <;> positivity) (fun p ↦ ?_)
      (summable_realAnalyticEpstein_summand z hs)
    simp [coprimeBottomRow_ne_zero p]
  linarith [realAnalyticEisenstein_nonneg 1 z s]

/-- Möbius indicator for coprimality to `N`: for `N ≠ 0` and `d : ℤ`,
`∑ r ∈ N.divisors, (if (r : ℤ) ∣ d then (μ r : ℝ) else 0) = if IsCoprime N d then 1 else 0`. -/
private theorem sum_moebius_divisors_ite_dvd {N : ℕ} (hN : N ≠ 0) (d : ℤ) :
    (∑ r ∈ N.divisors, if (r : ℤ) ∣ d then (μ r : ℝ) else 0) =
      if IsCoprime (N : ℤ) d then 1 else 0 := by
  have hfilt : (N.divisors.filter fun r : ℕ ↦ (r : ℤ) ∣ d) = (Nat.gcd N d.natAbs).divisors := by
    ext r
    simp only [Finset.mem_filter, Nat.mem_divisors, Nat.dvd_gcd_iff, Int.natCast_dvd]
    have hgcd : Nat.gcd N d.natAbs ≠ 0 := fun h ↦ hN (Nat.gcd_eq_zero_iff.mp h).1
    tauto
  rw [← Finset.sum_filter, hfilt]
  have hmz := congrArg (fun f : ArithmeticFunction ℝ ↦ f (Nat.gcd N d.natAbs))
    (coe_moebius_mul_coe_zeta (R := ℝ))
  simp only [ArithmeticFunction.coe_mul_zeta_apply, ArithmeticFunction.intCoe_apply,
    ArithmeticFunction.one_apply] at hmz
  rw [hmz]
  have hcop : Nat.gcd N d.natAbs = 1 ↔ IsCoprime (N : ℤ) d := by
    rw [Int.isCoprime_iff_gcd_eq_one, Int.gcd, Int.natAbs_natCast]
  by_cases h : Nat.gcd N d.natAbs = 1
  · simp [h, hcop.mp h]
  · simp [h, mt hcop.mpr h]

/-- Scaling a point of `ℍ` by a positive natural number (defaulting to `z` when `k = 0`). -/
private def natScaleH (k : ℕ) (z : ℍ) : ℍ :=
  if hk : 0 < k then
    ⟨(k : ℂ) * z, by simp [mul_im, Nat.cast_pos.mpr hk, z.im_pos]⟩
  else z

private theorem coe_natScaleH {k : ℕ} (hk : 0 < k) (z : ℍ) :
    (natScaleH k z : ℂ) = (k : ℂ) * z := by
  simp [natScaleH, hk]

private theorem im_natScaleH {k : ℕ} (hk : 0 < k) (z : ℍ) :
    (natScaleH k z).im = (k : ℝ) * z.im := by
  simp [natScaleH, hk, mul_im]

private theorem abs_cast_moebius_le_one (r : ℕ) : |(μ r : ℝ)| ≤ 1 := by
  exact_mod_cast ArithmeticFunction.abs_moebius_le_one (n := r)

/-- Right-hand limit of `∑' n : ℕ, n ^ (-2 * s)` as `s → 1⁺` is `ζ(2) = π² / 6`. -/
private theorem tendsto_tsum_nat_rpow_neg_two_mul :
    Tendsto (fun s : ℝ ↦ ∑' n : ℕ, (n : ℝ) ^ (-(2 * s))) (𝓝[>] 1) (𝓝 (π ^ 2 / 6)) := by
  have hzeta : ∑' n : ℕ, (n : ℝ) ^ (-(2 : ℝ)) = π ^ 2 / 6 := by
    simpa [rpow_neg (Nat.cast_nonneg _), one_div] using hasSum_zeta_two.tsum_eq
  rw [← hzeta]
  refine tendsto_tsum_of_dominated_convergence
    (Real.summable_nat_rpow.mpr (by norm_num : -(2 : ℝ) < -1)) (fun n ↦ ?_) ?_
  · rcases Nat.eq_zero_or_pos n with rfl | hn
    · refine tendsto_const_nhds.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with s hs
      have hs' : 1 < s := Set.mem_Ioi.mp hs
      rw [Nat.cast_zero, zero_rpow (by linarith : -(2 * s) ≠ 0),
        zero_rpow (by norm_num : -(2 : ℝ) ≠ 0)]
    · have hpos : (0 : ℝ) < n := Nat.cast_pos.mpr hn
      have hcont : Continuous fun s : ℝ ↦ (n : ℝ) ^ (-(2 * s)) :=
        continuous_const.rpow (continuous_const.mul continuous_id).neg fun _ ↦ Or.inl hpos.ne'
      simpa using (hcont.continuousAt (x := (1 : ℝ))).tendsto.mono_left nhdsWithin_le_nhds
  · filter_upwards [self_mem_nhdsWithin] with s hs n
    have hs' : 1 < s := Set.mem_Ioi.mp hs
    rw [Real.norm_of_nonneg (rpow_nonneg (Nat.cast_nonneg n) _)]
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [Nat.cast_zero, zero_rpow (by linarith : -(2 * s) ≠ 0),
        zero_rpow (by norm_num : -(2 : ℝ) ≠ 0)]
    · exact rpow_le_rpow_of_exponent_le (by exact_mod_cast hn) (by linarith)

/-- The partial zeta series `∑' m, [0 < m ∧ m.Coprime N] m^(-2s)` factors via Möbius inversion as
`(∑ r ∣ N, μ(r) r^(-2s)) * ζ(2s)`. -/
private theorem tsum_coprime_nat_rpow_eq {N : ℕ} (hN : N ≠ 0) {s : ℝ} (hs : 1 < s) :
    (∑' m : {m : ℕ // 0 < m ∧ m.Coprime N}, (m.1 : ℝ) ^ (-(2 * s))) =
      (∑ r ∈ N.divisors, (μ r : ℝ) * (r : ℝ) ^ (-(2 * s))) *
        ∑' n : ℕ, (n : ℝ) ^ (-(2 * s)) := by
  have hsum : Summable fun m : ℕ ↦ (m : ℝ) ^ (-(2 * s)) :=
    Real.summable_nat_rpow.mpr (by linarith)
  have hleft : (∑' m : {m : ℕ // 0 < m ∧ m.Coprime N}, (m.1 : ℝ) ^ (-(2 * s))) =
      ∑' m : ℕ, (if IsCoprime (N : ℤ) (m : ℤ) then (1 : ℝ) else 0) * (m : ℝ) ^ (-(2 * s)) := by
    rw [← tsum_subtype_eq_of_support_subset (s := {m : ℕ | 0 < m ∧ m.Coprime N})]
    · refine tsum_congr fun m ↦ ?_
      have hcop : IsCoprime (N : ℤ) (m.1 : ℤ) :=
        Int.isCoprime_iff_gcd_eq_one.mpr (by simpa [Int.gcd] using m.2.2.symm)
      simp [hcop]
    · intro m hm
      simp only [Function.mem_support, ne_eq, mul_eq_zero, not_or] at hm
      have hm0 : 0 < m := Nat.pos_of_ne_zero fun h ↦ by
        subst h; simp [zero_rpow (by linarith : -(2 * s) ≠ 0)] at hm
      have hcop : IsCoprime (N : ℤ) (m : ℤ) := by by_contra hc; simp [hc] at hm
      exact ⟨hm0, (Nat.isCoprime_iff_coprime.mp hcop).symm⟩
  rw [hleft]
  simp_rw [← sum_moebius_divisors_ite_dvd hN, Finset.sum_mul]
  rw [Summable.tsum_finsetSum fun r _ ↦ hsum.of_norm_bounded fun m ↦ by
    split_ifs
    · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (rpow_nonneg (Nat.cast_nonneg m) _)]
      exact mul_le_of_le_one_left (rpow_nonneg (Nat.cast_nonneg m) _) (abs_cast_moebius_le_one r)
    · simp [rpow_nonneg (Nat.cast_nonneg m) _]]
  refine Finset.sum_congr rfl fun r hr ↦ ?_
  have hr0 : 0 < r := Nat.pos_of_mem_divisors hr
  have hsub : (∑' m : ℕ, (if (r : ℤ) ∣ (m : ℤ) then (μ r : ℝ) else 0) * (m : ℝ) ^ (-(2 * s))) =
      ∑' k : ℕ, (μ r : ℝ) * ((r * k : ℕ) : ℝ) ^ (-(2 * s)) := by
    let e : ℕ ≃ ({m : ℕ | (r : ℤ) ∣ (m : ℤ)} : Set ℕ) :=
      { toFun := fun k ↦ ⟨r * k, by exact_mod_cast dvd_mul_right r k⟩
        invFun := fun m ↦ m.1 / r
        left_inv := fun k ↦ Nat.mul_div_cancel_left k hr0
        right_inv := fun m ↦ Subtype.ext (Nat.mul_div_cancel' (Int.natCast_dvd_natCast.mp m.2)) }
    rw [← tsum_subtype_eq_of_support_subset (s := {m : ℕ | (r : ℤ) ∣ (m : ℤ)})]
    · rw [← e.tsum_eq]; exact tsum_congr fun k ↦ by simp [e]
    · intro m hm; simp only [Function.mem_support, ne_eq] at hm
      by_contra hnd; exact hm (by simp [show ¬ ((r : ℤ) ∣ (m : ℤ)) from hnd])
  rw [hsub]
  calc ∑' k : ℕ, (μ r : ℝ) * ((r * k : ℕ) : ℝ) ^ (-(2 * s))
      = ∑' k : ℕ, ((μ r : ℝ) * (r : ℝ) ^ (-(2 * s))) * (k : ℝ) ^ (-(2 * s)) :=
        tsum_congr fun k ↦ by
          rw [Nat.cast_mul, mul_rpow (Nat.cast_nonneg r) (Nat.cast_nonneg k), mul_assoc]
    _ = (μ r : ℝ) * (r : ℝ) ^ (-(2 * s)) * ∑' k : ℕ, (k : ℝ) ^ (-(2 * s)) := tsum_mul_left

/-- Bijection factoring every nonzero `(c', d') ∈ ℤ²` with `N ∣ c'` and `gcd(N, d') = 1` uniquely
as `(m * c, m * d)` with `m > 0`, `gcd(m, N) = 1`, and `(c, d)` primitive with `N ∣ c`. -/
private def coprimeMulEquivBottomRow (N : ℕ) :
    {m : ℕ // 0 < m ∧ m.Coprime N} × CoprimeBottomRow N ≃
      {p : ℤ × ℤ // p ≠ 0 ∧ (N : ℤ) ∣ p.1 ∧ IsCoprime (N : ℤ) p.2} where
  toFun x :=
    ⟨((x.1.1 : ℤ) * x.2.1.1, (x.1.1 : ℤ) * x.2.1.2), by
      have hm0 : (x.1.1 : ℤ) ≠ 0 := Int.natCast_ne_zero.mpr x.1.2.1.ne'
      have hp0 : x.2.1 ≠ 0 := coprimeBottomRow_ne_zero x.2
      refine ⟨?_, dvd_mul_of_dvd_right x.2.2.1 _, ?_⟩
      · intro h; rw [Prod.ext_iff] at h
        exact hp0 (Prod.ext ((mul_eq_zero.mp h.1).resolve_left hm0)
          ((mul_eq_zero.mp h.2).resolve_left hm0))
      · have hNm : IsCoprime (N : ℤ) (x.1.1 : ℤ) :=
          Int.isCoprime_iff_gcd_eq_one.mpr (by simpa [Int.gcd] using x.1.2.2.symm)
        obtain ⟨k, hk⟩ := x.2.2.1
        obtain ⟨a, b, hab⟩ := x.2.2.2
        exact hNm.mul_right ⟨a * k, b, by rw [hk] at hab; linarith⟩⟩
  invFun p :=
    let g := Int.gcd p.1.1 p.1.2
    have hg0 : 0 < g := Nat.pos_of_ne_zero fun h ↦ by
      have h' := Int.gcd_eq_zero_iff.mp h
      exact p.2.1 (Prod.ext h'.1 h'.2)
    have hg_cop : g.Coprime N := by
      obtain ⟨k, hk⟩ := Int.gcd_dvd_right (a := p.1.1) (b := p.1.2)
      obtain ⟨a, b, hab⟩ := p.2.2.2
      exact (Nat.isCoprime_iff_coprime.mp ⟨a, b * k, by rw [hk] at hab; linarith⟩).symm
    have hc_mul : (g : ℤ) * (p.1.1 / (g : ℤ)) = p.1.1 :=
      Int.mul_ediv_cancel' (Int.gcd_dvd_left p.1.1 p.1.2)
    have hd_mul : (g : ℤ) * (p.1.2 / (g : ℤ)) = p.1.2 :=
      Int.mul_ediv_cancel' (Int.gcd_dvd_right p.1.1 p.1.2)
    have hcop_cd : IsCoprime (p.1.1 / (g : ℤ)) (p.1.2 / (g : ℤ)) := by
      rw [Int.isCoprime_iff_gcd_eq_one]
      have hmul : g * Int.gcd (p.1.1 / (g : ℤ)) (p.1.2 / (g : ℤ)) = g := by
        calc g * Int.gcd (p.1.1 / (g : ℤ)) (p.1.2 / (g : ℤ))
            = (g : ℤ).natAbs * Int.gcd (p.1.1 / (g : ℤ)) (p.1.2 / (g : ℤ)) := by
              rw [Int.natAbs_natCast]
          _ = Int.gcd ((g : ℤ) * (p.1.1 / (g : ℤ))) ((g : ℤ) * (p.1.2 / (g : ℤ))) :=
              (Int.gcd_mul_left (g : ℤ) _ _).symm
          _ = g := by rw [hc_mul, hd_mul]
      exact Nat.eq_of_mul_eq_mul_left hg0 (by simpa using hmul)
    have hN_dvd : (N : ℤ) ∣ p.1.1 / (g : ℤ) := by
      have hcop_Ng : IsCoprime (N : ℤ) (g : ℤ) :=
        Int.isCoprime_iff_gcd_eq_one.mpr
          (by rw [Int.gcd, Int.natAbs_natCast, Int.natAbs_natCast]; exact hg_cop.symm)
      exact hcop_Ng.dvd_of_dvd_mul_left (hc_mul.symm ▸ p.2.2.1)
    (⟨g, hg0, hg_cop⟩, ⟨(p.1.1 / (g : ℤ), p.1.2 / (g : ℤ)), hN_dvd, hcop_cd⟩)
  left_inv x := by
    have hgcd : Int.gcd ((x.1.1 : ℤ) * x.2.1.1) ((x.1.1 : ℤ) * x.2.1.2) = x.1.1 := by
      rw [Int.gcd_mul_left, Int.natAbs_natCast, Int.isCoprime_iff_gcd_eq_one.mp x.2.2.2, mul_one]
    have hm0 : (x.1.1 : ℤ) ≠ 0 := Int.natCast_ne_zero.mpr x.1.2.1.ne'
    refine Prod.ext (Subtype.ext hgcd) (Subtype.ext (Prod.ext ?_ ?_))
    · simp only [hgcd]; exact Int.mul_ediv_cancel_left _ hm0
    · simp only [hgcd]; exact Int.mul_ediv_cancel_left _ hm0
  right_inv p := by
    refine Subtype.ext (Prod.ext ?_ ?_)
    · exact Int.mul_ediv_cancel' (Int.gcd_dvd_left p.1.1 p.1.2)
    · exact Int.mul_ediv_cancel' (Int.gcd_dvd_right p.1.1 p.1.2)

/-- Reindex the sublattice `N ℤ × r ℤ` in terms of `realAnalyticEpstein (natScaleH (N / r) z) s`. -/
private theorem tsum_sublattice_eq_realAnalyticEpstein {N r : ℕ} (hN : N ≠ 0) (hr : r ∈ N.divisors)
    (z : ℍ) {s : ℝ} :
    (∑' p : ℤ × ℤ, if p = 0 then 0 else
      if (N : ℤ) ∣ p.1 ∧ (r : ℤ) ∣ p.2 then z.im ^ s / ‖(p.1 : ℂ) * z + p.2‖ ^ (2 * s) else 0) =
      ((N * r : ℕ) : ℝ) ^ (-s) * realAnalyticEpstein (natScaleH (N / r) z) s := by
  have hr0 : 0 < r := Nat.pos_of_mem_divisors hr
  have hrdvd : r ∣ N := Nat.dvd_of_mem_divisors hr
  have hNr0 : 0 < N / r := Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero hN) hrdvd) hr0
  let e : ℤ × ℤ ≃ ({p : ℤ × ℤ | (N : ℤ) ∣ p.1 ∧ (r : ℤ) ∣ p.2} : Set (ℤ × ℤ)) :=
    { toFun := fun q ↦ ⟨((N : ℤ) * q.1, (r : ℤ) * q.2), dvd_mul_right _ _, dvd_mul_right _ _⟩
      invFun := fun p ↦ (p.1.1 / (N : ℤ), p.1.2 / (r : ℤ))
      left_inv := fun q ↦ Prod.ext (Int.mul_ediv_cancel_left _ (Int.natCast_ne_zero.mpr hN))
        (Int.mul_ediv_cancel_left _ (Int.natCast_ne_zero.mpr hr0.ne'))
      right_inv := fun p ↦ Subtype.ext (Prod.ext (Int.mul_ediv_cancel' p.2.1)
        (Int.mul_ediv_cancel' p.2.2)) }
  rw [← tsum_subtype_eq_of_support_subset (s := {p : ℤ × ℤ | (N : ℤ) ∣ p.1 ∧ (r : ℤ) ∣ p.2})]
  · rw [← e.tsum_eq, realAnalyticEpstein_def, ← tsum_mul_left]
    refine tsum_congr fun q ↦ ?_
    by_cases hq : q = 0
    · subst hq; simp [e]
    · have hne : ((N : ℤ) * q.1, (r : ℤ) * q.2) ≠ 0 := by
        simp only [ne_eq, Prod.ext_iff, Prod.fst_zero, Prod.snd_zero,
          mul_eq_zero, Int.natCast_eq_zero, hN, hr0.ne', false_or]
        exact fun h ↦ hq (Prod.ext h.1 h.2)
      simp only [e, Equiv.coe_fn_mk, hne, hq, ↓reduceIte, dvd_mul_right, and_self]
      have hN_eq : (N : ℂ) = (r : ℂ) * ((N / r : ℕ) : ℂ) := by
        exact_mod_cast (Nat.mul_div_cancel' hrdvd).symm
      have hlin : (((N : ℤ) * q.1 : ℤ) : ℂ) * z + ((r : ℤ) * q.2 : ℤ) =
          (r : ℂ) * ((q.1 : ℂ) * natScaleH (N / r) z + q.2) := by
        rw [coe_natScaleH hNr0]; push_cast; rw [hN_eq]; ring
      rw [hlin, norm_mul, Complex.norm_natCast, mul_rpow (Nat.cast_nonneg r) (norm_nonneg _),
        im_natScaleH hNr0, mul_rpow (Nat.cast_nonneg _) z.im_pos.le]
      have hfac : ((N * r : ℕ) : ℝ) ^ (-s) * ((N / r : ℕ) : ℝ) ^ s = ((r : ℝ) ^ (2 * s))⁻¹ := by
        have hNr : (N * r : ℕ) = (N / r) * (r * r) := by
          calc N * r = (r * (N / r)) * r := by rw [Nat.mul_div_cancel' hrdvd]
            _ = (N / r) * (r * r) := by ring
        rw [hNr, Nat.cast_mul, Nat.cast_mul, mul_rpow (Nat.cast_nonneg _) (by positivity),
          mul_rpow (Nat.cast_nonneg r) (Nat.cast_nonneg r)]
        have h1 : ((N / r : ℕ) : ℝ) ^ (-s) * ((N / r : ℕ) : ℝ) ^ s = 1 := by
          rw [← rpow_add (Nat.cast_pos.mpr hNr0), neg_add_cancel, rpow_zero]
        have h2 : (r : ℝ) ^ (-s) * (r : ℝ) ^ (-s) = ((r : ℝ) ^ (2 * s))⁻¹ := by
          rw [← rpow_add (Nat.cast_pos.mpr hr0), show -s + -s = -(2 * s) by ring,
            rpow_neg (Nat.cast_nonneg r)]
        calc ((N / r : ℕ) : ℝ) ^ (-s) * ((r : ℝ) ^ (-s) * (r : ℝ) ^ (-s)) * ((N / r : ℕ) : ℝ) ^ s
            = (((N / r : ℕ) : ℝ) ^ (-s) * ((N / r : ℕ) : ℝ) ^ s) *
                ((r : ℝ) ^ (-s) * (r : ℝ) ^ (-s)) := by ring
          _ = ((r : ℝ) ^ (2 * s))⁻¹ := by rw [h1, one_mul, h2]
      calc z.im ^ s / ((r : ℝ) ^ (2 * s) * ‖(q.1 : ℂ) * ↑(natScaleH (N / r) z) + ↑q.2‖ ^ (2 * s))
          = ((r : ℝ) ^ (2 * s))⁻¹ *
              (z.im ^ s / ‖(q.1 : ℂ) * ↑(natScaleH (N / r) z) + ↑q.2‖ ^ (2 * s)) := by ring
        _ = ((N * r : ℕ) : ℝ) ^ (-s) * (((N / r : ℕ) : ℝ) ^ s * z.im ^ s /
              ‖(q.1 : ℂ) * ↑(natScaleH (N / r) z) + ↑q.2‖ ^ (2 * s)) := by rw [← hfac]; ring
  · intro p hp
    simp only [Function.mem_support, ne_eq] at hp
    by_contra hnd
    exact hp (by split_ifs <;> first | rfl | exact absurd ‹_› hnd)

/-- Product expansion identifying `2 ζ(2s) (∑ r ∣ N, μ(r) r^(-2s)) E_N(z, s)` with the sum over
all nonzero `(c, d)` satisfying `N ∣ c` and `gcd(N, d) = 1`. -/
private theorem two_mul_moebius_mul_realAnalyticEisenstein_eq_coprime {N : ℕ} (hN : N ≠ 0)
    (z : ℍ) {s : ℝ} (hs : 1 < s) :
    2 * ((∑ r ∈ N.divisors, (μ r : ℝ) * (r : ℝ) ^ (-(2 * s))) *
          (∑' n : ℕ, (n : ℝ) ^ (-(2 * s)))) * realAnalyticEisenstein N z s =
      ∑' p : {p : ℤ × ℤ // p ≠ 0 ∧ (N : ℤ) ∣ p.1 ∧ IsCoprime (N : ℤ) p.2},
        z.im ^ s / ‖(p.1.1 : ℂ) * z + p.1.2‖ ^ (2 * s) := by
  have hsum_m : Summable fun m : {m : ℕ // 0 < m ∧ m.Coprime N} ↦ (m.1 : ℝ) ^ (-(2 * s)) :=
    (Real.summable_nat_rpow.mpr (by linarith)).subtype _
  have hsum_p : Summable fun p : CoprimeBottomRow N ↦
      z.im ^ s / ‖(p.1.1 : ℂ) * z + p.1.2‖ ^ (2 * s) :=
    ((summable_realAnalyticEpstein_summand z hs).subtype _).congr fun p ↦ by
      simp [coprimeBottomRow_ne_zero p]
  rw [show 2 * ((∑ r ∈ N.divisors, (μ r : ℝ) * (r : ℝ) ^ (-(2 * s))) *
          (∑' n : ℕ, (n : ℝ) ^ (-(2 * s)))) * realAnalyticEisenstein N z s =
        ((∑ r ∈ N.divisors, (μ r : ℝ) * (r : ℝ) ^ (-(2 * s))) *
          (∑' n : ℕ, (n : ℝ) ^ (-(2 * s)))) * (2 * realAnalyticEisenstein N z s) by ring,
    ← tsum_coprime_nat_rpow_eq hN hs, two_mul_realAnalyticEisenstein_eq_tsum_coprime,
    ← (coprimeMulEquivBottomRow N).tsum_eq,
    tsum_mul_tsum_of_summable_norm hsum_m.norm hsum_p.norm]
  refine tsum_congr fun ⟨m, p⟩ ↦ ?_
  simp only [coprimeMulEquivBottomRow, Equiv.coe_fn_mk]
  have hlin : (((m.1 : ℤ) * p.1.1 : ℤ) : ℂ) * z + ((m.1 : ℤ) * p.1.2 : ℤ) =
      (m.1 : ℂ) * ((p.1.1 : ℂ) * z + p.1.2) := by push_cast; ring
  rw [hlin, norm_mul, Complex.norm_natCast, mul_rpow (Nat.cast_nonneg m.1) (norm_nonneg _),
    rpow_neg (Nat.cast_nonneg m.1)]
  ring

/-- **Möbius identity for `realAnalyticEisenstein`**: for `N ≠ 0` and `s > 1`,
`2 ζ(2s) (∑ r ∣ N, μ(r) r^(-2s)) E_N(z, s) = ∑ r ∣ N, μ(r) (N r)^(-s) Z((N/r) z, s)`. -/
private theorem two_mul_moebius_mul_realAnalyticEisenstein {N : ℕ} (hN : N ≠ 0) (z : ℍ)
    {s : ℝ} (hs : 1 < s) :
    2 * ((∑ r ∈ N.divisors, (μ r : ℝ) * (r : ℝ) ^ (-(2 * s))) *
          (∑' n : ℕ, (n : ℝ) ^ (-(2 * s)))) * realAnalyticEisenstein N z s =
      ∑ r ∈ N.divisors, (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-s) *
        realAnalyticEpstein (natScaleH (N / r) z) s := by
  rw [two_mul_moebius_mul_realAnalyticEisenstein_eq_coprime hN z hs]
  have hsub_eq :
      (∑' p : {p : ℤ × ℤ // p ≠ 0 ∧ (N : ℤ) ∣ p.1 ∧ IsCoprime (N : ℤ) p.2},
        z.im ^ s / ‖(p.1.1 : ℂ) * z + p.1.2‖ ^ (2 * s)) =
      ∑' p : ℤ × ℤ, if p = 0 then 0 else if (N : ℤ) ∣ p.1 then
        (if IsCoprime (N : ℤ) p.2 then (1 : ℝ) else 0) *
          (z.im ^ s / ‖(p.1 : ℂ) * z + p.2‖ ^ (2 * s)) else 0 := by
    rw [← tsum_subtype_eq_of_support_subset
      (s := {p : ℤ × ℤ | p ≠ 0 ∧ (N : ℤ) ∣ p.1 ∧ IsCoprime (N : ℤ) p.2})]
    · exact tsum_congr fun p ↦ by simp [p.2.1, p.2.2.1, p.2.2.2]
    · intro p hp; simp only [Function.mem_support, ne_eq] at hp
      refine ⟨fun h ↦ by simp [h] at hp, by by_contra hnd; simp [hnd] at hp,
        by by_contra hnc; simp [hnc] at hp⟩
  rw [hsub_eq]
  have hterm_eq : ∀ p : ℤ × ℤ,
      (if p = 0 then 0 else if (N : ℤ) ∣ p.1 then
        (if IsCoprime (N : ℤ) p.2 then (1 : ℝ) else 0) *
          (z.im ^ s / ‖(p.1 : ℂ) * z + p.2‖ ^ (2 * s)) else 0) =
      ∑ r ∈ N.divisors, (μ r : ℝ) * (if p = 0 then 0 else
        if (N : ℤ) ∣ p.1 ∧ (r : ℤ) ∣ p.2 then
          z.im ^ s / ‖(p.1 : ℂ) * z + p.2‖ ^ (2 * s) else 0) := fun p ↦ by
    by_cases hp0 : p = 0
    · simp [hp0]
    · by_cases hNd : (N : ℤ) ∣ p.1
      · simp only [hp0, hNd, true_and, ↓reduceIte, ← sum_moebius_divisors_ite_dvd hN p.2,
          Finset.sum_mul]
        exact Finset.sum_congr rfl fun r _ ↦ by split_ifs <;> ring
      · simp [hp0, hNd]
  simp_rw [hterm_eq]
  rw [Summable.tsum_finsetSum fun r _ ↦ (summable_realAnalyticEpstein_summand z hs).of_norm_bounded
    fun p ↦ by
      have hnn : 0 ≤ z.im ^ s / ‖(p.1 : ℂ) * z + p.2‖ ^ (2 * s) := by positivity
      split_ifs
      · simp
      · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hnn]
        exact mul_le_of_le_one_left hnn (abs_cast_moebius_le_one r)
      · simp [hnn]]
  refine Finset.sum_congr rfl fun r hr ↦ ?_
  rw [tsum_mul_left, tsum_sublattice_eq_realAnalyticEpstein hN hr z, mul_assoc]

/-- Euler product `∑ r ∣ N, μ(r) r^(-k) = ∏ p ∣ N, (1 - p^(-k))` for `k = 1, 2`. -/
private theorem moebius_divisor_sum_inv_pow {N : ℕ} (hN : N ≠ 0) (k : ℕ) :
    (∑ r ∈ N.divisors, (μ r : ℝ) * ((r : ℝ) ^ k)⁻¹) =
      ∏ p ∈ N.primeFactors, (1 - ((p : ℝ) ^ k)⁻¹) := by
  let fk : ArithmeticFunction ℝ := ⟨fun n ↦ if n = 0 then 0 else ((n : ℝ) ^ k)⁻¹, rfl⟩
  have hfk : fk.IsMultiplicative := by
    refine ⟨by simp [fk], fun {m n} _ ↦ ?_⟩
    by_cases hm : m = 0 <;> by_cases hn : n = 0
    · simp [fk, hm, hn]
    · simp [fk, hm, hn]
    · simp [fk, hm, hn]
    · simp only [fk, ArithmeticFunction.coe_mk, mul_eq_zero, hm, hn, or_self, ↓reduceIte,
        Nat.cast_mul, mul_pow, mul_inv_rev]
      ring
  have hprod := ArithmeticFunction.IsMultiplicative.prodPrimeFactors_one_sub fk hfk hN
  have hL : ∏ p ∈ N.primeFactors, (1 - fk p) = ∏ p ∈ N.primeFactors, (1 - ((p : ℝ) ^ k)⁻¹) :=
    Finset.prod_congr rfl fun p hp ↦ by simp [fk, (Nat.prime_of_mem_primeFactors hp).ne_zero]
  rw [← hL, hprod]
  refine Finset.sum_congr rfl fun r hr ↦ ?_
  simp [fk, (Nat.pos_of_mem_divisors hr).ne']

/-- Euler-product evaluation of the ratio of Möbius divisor sums appearing in the residue of
`realAnalyticEisenstein N`:
`(∑ r ∣ N, μ(r) (N r)⁻¹) / (∑ r ∣ N, μ(r) r⁻²) = [SL(2, ℤ) : Γ₀(N)]⁻¹`,
and the denominator is strictly positive. -/
private theorem moebius_ratio_eq_inv_Gamma0_index {N : ℕ} (hN : N ≠ 0) :
    0 < (∑ r ∈ N.divisors, (μ r : ℝ) * (r : ℝ) ^ (-(2 : ℝ))) ∧
      (∑ r ∈ N.divisors, (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-(1 : ℝ))) /
          (∑ r ∈ N.divisors, (μ r : ℝ) * (r : ℝ) ^ (-(2 : ℝ))) =
        ((CongruenceSubgroup.Gamma0 N).index : ℝ)⁻¹ := by
  have hsum1 : (∑ r ∈ N.divisors, (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-(1 : ℝ))) =
      (N : ℝ)⁻¹ * ∏ p ∈ N.primeFactors, (1 - (p : ℝ)⁻¹) := by
    have h1 := moebius_divisor_sum_inv_pow hN 1
    simp only [pow_one] at h1
    rw [← h1, Finset.mul_sum]
    refine Finset.sum_congr rfl fun r _ ↦ ?_
    rw [rpow_neg_one, Nat.cast_mul, mul_inv_rev]; ring
  have hsum2 : (∑ r ∈ N.divisors, (μ r : ℝ) * (r : ℝ) ^ (-(2 : ℝ))) =
      ∏ p ∈ N.primeFactors, (1 - ((p : ℝ) ^ 2)⁻¹) := by
    rw [← moebius_divisor_sum_inv_pow hN 2]
    refine Finset.sum_congr rfl fun r _ ↦ ?_
    rw [rpow_neg (Nat.cast_nonneg r), rpow_two]
  have hpos2 : 0 < ∏ p ∈ N.primeFactors, (1 - ((p : ℝ) ^ 2)⁻¹) := by
    refine Finset.prod_pos fun p hp ↦ ?_
    have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).two_le
    have hlt : ((p : ℝ) ^ 2)⁻¹ < 1 := inv_lt_one_of_one_lt₀ (by nlinarith)
    linarith
  have hpos1 : 0 < ∏ p ∈ N.primeFactors, (1 - (p : ℝ)⁻¹) := by
    refine Finset.prod_pos fun p hp ↦ ?_
    have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).two_le
    have hlt : (p : ℝ)⁻¹ < 1 := inv_lt_one_of_one_lt₀ (by linarith)
    linarith
  have hprod_fact : (∏ p ∈ N.primeFactors, (1 - ((p : ℝ) ^ 2)⁻¹)) =
      (∏ p ∈ N.primeFactors, (1 - (p : ℝ)⁻¹)) * ∏ p ∈ N.primeFactors, (1 + (p : ℝ)⁻¹) := by
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl fun p _ ↦ by ring
  have hindex : (N : ℝ) * ∏ p ∈ N.primeFactors, (1 + (p : ℝ)⁻¹) =
      ((CongruenceSubgroup.Gamma0 N).index : ℝ) := by
    have hidx : ((CongruenceSubgroup.Gamma0 N).index : ℝ) * ∏ p ∈ N.primeFactors, (p : ℝ) =
        (N : ℝ) * ∏ p ∈ N.primeFactors, ((p : ℝ) + 1) := by
      simpa using congrArg (Nat.cast (R := ℝ))
        (CongruenceSubgroup.Gamma0_index_mul_prod_primeFactors (N := N))
    have hp_prod_ne : (∏ p ∈ N.primeFactors, (p : ℝ)) ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr fun p hp ↦
        Nat.cast_ne_zero.mpr (Nat.prime_of_mem_primeFactors hp).ne_zero
    apply mul_right_cancel₀ hp_prod_ne
    rw [hidx, mul_assoc, ← Finset.prod_mul_distrib]
    congr 1
    refine Finset.prod_congr rfl fun p hp ↦ ?_
    have hp0 : (p : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.prime_of_mem_primeFactors hp).ne_zero
    field_simp
  refine ⟨hsum2.symm ▸ hpos2, ?_⟩
  rw [hsum1, hsum2, hprod_fact, ← hindex, mul_inv_rev]
  have h1ne : (∏ p ∈ N.primeFactors, (1 - (p : ℝ)⁻¹)) ≠ 0 := hpos1.ne'
  rw [div_eq_mul_inv, mul_inv_rev]
  calc (N : ℝ)⁻¹ * (∏ p ∈ N.primeFactors, (1 - (p : ℝ)⁻¹)) *
          ((∏ p ∈ N.primeFactors, (1 + (p : ℝ)⁻¹))⁻¹ * (∏ p ∈ N.primeFactors, (1 - (p : ℝ)⁻¹))⁻¹)
      = ((∏ p ∈ N.primeFactors, (1 - (p : ℝ)⁻¹)) * (∏ p ∈ N.primeFactors, (1 - (p : ℝ)⁻¹))⁻¹) *
          ((∏ p ∈ N.primeFactors, (1 + (p : ℝ)⁻¹))⁻¹ * (N : ℝ)⁻¹) := by ring
    _ = (∏ p ∈ N.primeFactors, (1 + (p : ℝ)⁻¹))⁻¹ * (N : ℝ)⁻¹ := by
        rw [mul_inv_cancel₀ h1ne, one_mul]

/-- **Residue of the level-`N` real-analytic Eisenstein series**: for `N ≠ 0` and every `z ∈ ℍ`,
`lim_{s → 1⁺} (s - 1) E_N(z, s) = 3 / (π * [SL(2, ℤ) : Γ₀(N)])`. -/
theorem tendsto_sub_one_mul_realAnalyticEisenstein (N : ℕ) [NeZero N] (z : ℍ) :
    Tendsto (fun s : ℝ ↦ (s - 1) * realAnalyticEisenstein N z s) (𝓝[>] 1)
      (𝓝 (3 / (π * ((CongruenceSubgroup.Gamma0 N).index : ℝ)))) := by
  have hN : N ≠ 0 := NeZero.ne N
  let D : ℝ → ℝ := fun s ↦
    2 * ((∑ r ∈ N.divisors, (μ r : ℝ) * (r : ℝ) ^ (-(2 * s))) *
      ∑' n : ℕ, (n : ℝ) ^ (-(2 * s)))
  let A : ℝ := ∑ r ∈ N.divisors, (μ r : ℝ) * (r : ℝ) ^ (-(2 : ℝ))
  let B : ℝ := ∑ r ∈ N.divisors, (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-(1 : ℝ))
  obtain ⟨hApos, hratio⟩ := moebius_ratio_eq_inv_Gamma0_index hN
  have hD_tendsto : Tendsto D (𝓝[>] 1) (𝓝 (2 * (A * (π ^ 2 / 6)))) := by
    have hmoeb : Tendsto (fun s : ℝ ↦ ∑ r ∈ N.divisors, (μ r : ℝ) * (r : ℝ) ^ (-(2 * s)))
        (𝓝[>] 1) (𝓝 A) := by
      refine tendsto_finsetSum _ fun r hr ↦ ?_
      have hr0 : (r : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.pos_of_mem_divisors hr).ne'
      have hcont : Continuous fun s : ℝ ↦ (μ r : ℝ) * (r : ℝ) ^ (-(2 * s)) :=
        continuous_const.mul (continuous_const.rpow (continuous_const.mul continuous_id).neg
          fun _ ↦ Or.inl hr0)
      simpa using (hcont.continuousAt (x := (1 : ℝ))).tendsto.mono_left nhdsWithin_le_nhds
    exact tendsto_const_nhds.mul (hmoeb.mul tendsto_tsum_nat_rpow_neg_two_mul)
  have hnum_tendsto : Tendsto
      (fun s : ℝ ↦ (s - 1) * ∑ r ∈ N.divisors, (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-s) *
        realAnalyticEpstein (natScaleH (N / r) z) s)
      (𝓝[>] 1) (𝓝 (B * π)) := by
    have heq : (fun s : ℝ ↦ (s - 1) * ∑ r ∈ N.divisors, (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-s) *
        realAnalyticEpstein (natScaleH (N / r) z) s) =
        fun s : ℝ ↦ ∑ r ∈ N.divisors, ((μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-s)) *
          ((s - 1) * realAnalyticEpstein (natScaleH (N / r) z) s) := by
      ext s; rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun r _ ↦ by ring
    rw [heq, show B * π = ∑ r ∈ N.divisors, ((μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-(1 : ℝ))) * π
      from Finset.sum_mul ..]
    refine tendsto_finsetSum _ fun r hr ↦ ?_
    have hNr0 : ((N * r : ℕ) : ℝ) ≠ 0 :=
      Nat.cast_ne_zero.mpr (mul_ne_zero hN (Nat.pos_of_mem_divisors hr).ne')
    have hcoef : Tendsto (fun s : ℝ ↦ (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-s)) (𝓝[>] 1)
        (𝓝 ((μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-(1 : ℝ)))) := by
      have hcont : Continuous fun s : ℝ ↦ (μ r : ℝ) * ((N * r : ℕ) : ℝ) ^ (-s) :=
        continuous_const.mul (continuous_const.rpow continuous_neg fun _ ↦ Or.inl hNr0)
      exact (hcont.continuousAt (x := (1 : ℝ))).tendsto.mono_left nhdsWithin_le_nhds
    exact hcoef.mul (tendsto_sub_one_mul_realAnalyticEpstein (natScaleH (N / r) z))
  have hD_pos : 0 < 2 * (A * (π ^ 2 / 6)) := by positivity
  have hdiv := hnum_tendsto.div hD_tendsto hD_pos.ne'
  have hlim : (B * π) / (2 * (A * (π ^ 2 / 6))) =
      3 / (π * ((CongruenceSubgroup.Gamma0 N).index : ℝ)) := by
    have hA_ne : A ≠ 0 := hApos.ne'
    have hpi_ne : π ≠ 0 := Real.pi_pos.ne'
    calc (B * π) / (2 * (A * (π ^ 2 / 6)))
        = (B / A) * (3 / π) := by field_simp; ring
      _ = ((CongruenceSubgroup.Gamma0 N).index : ℝ)⁻¹ * (3 / π) := by rw [hratio]
      _ = 3 / (π * ((CongruenceSubgroup.Gamma0 N).index : ℝ)) := by ring
  rw [hlim] at hdiv
  refine hdiv.congr' ?_
  filter_upwards [self_mem_nhdsWithin, hD_tendsto.eventually (Ioi_mem_nhds hD_pos)] with s hs hDs
  have hDs_ne : D s ≠ 0 := (Set.mem_Ioi.mp hDs).ne'
  have hid := two_mul_moebius_mul_realAnalyticEisenstein hN z (Set.mem_Ioi.mp hs)
  change D s * realAnalyticEisenstein N z s = _ at hid
  rw [Pi.div_apply, ← hid]
  field_simp

end TauCeti.EisensteinSeries
