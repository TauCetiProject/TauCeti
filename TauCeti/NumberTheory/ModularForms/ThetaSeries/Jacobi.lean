module
public import TauCeti.NumberTheory.ModularForms.ThetaSeries.Basic
public import Mathlib.NumberTheory.ModularForms.JacobiTheta.OneVariable
import Mathlib.LinearAlgebra.Span.Basic

/-!
# Rank-one lattice theta series and the Jacobi theta function

The theta series of the lattice generated by a nonzero real number `r` is the Jacobi
function at `r²τ`. Its positive-index expansion has constant term one and coefficient
two at positive square exponents. This identifies both the exponent normalization and
the factors in the classical Jacobi expansion.
-/

public section

open scoped Real UpperHalfPlane
open Complex

namespace ZLattice

/-- The theta series of a real rank-one lattice is the Jacobi theta function at `r²τ`. -/
theorem thetaSeries_span_singleton {r : ℝ} (hr : r ≠ 0) (τ : ℍ) :
    thetaSeries (Submodule.span ℤ {r}) τ = jacobiTheta ((r : ℂ) ^ 2 * τ) := by
  rw [thetaSeries_apply, jacobiTheta]
  rw [← (LinearEquiv.toSpanNonzeroSingleton ℤ ℝ r hr).toEquiv.tsum_eq]
  apply tsum_congr
  intro n
  congr 1
  simp only [LinearEquiv.coe_toEquiv,
    LinearEquiv.toSpanNonzeroSingleton_apply, zsmul_eq_mul, Real.norm_eq_abs,
    sq_abs, mul_pow, Complex.ofReal_mul, Complex.ofReal_pow, Complex.ofReal_intCast]
  ring

/-- The standard integer lattice has the usual Jacobi theta series. -/
example (τ : ℍ) : thetaSeries (Submodule.span ℤ {(1 : ℝ)}) τ = jacobiTheta τ := by
  simpa using thetaSeries_span_singleton (by norm_num : (1 : ℝ) ≠ 0) τ

/-- Scaling the integer lattice by `√2` doubles the theta argument. -/
example (τ : ℍ) : thetaSeries (Submodule.span ℤ {Real.sqrt 2}) τ = jacobiTheta (2 * τ) := by
  rw [thetaSeries_span_singleton (ne_of_gt (Real.sqrt_pos.2 (by norm_num)))]
  congr 1
  rw [← Complex.ofReal_pow, Real.sq_sqrt (by norm_num)]
  norm_num

/-- The positive-square power series of a rank-one theta series, with its factor of two. -/
theorem hasSum_nat_thetaSeries_span_singleton {r : ℝ} (hr : r ≠ 0) (τ : ℍ) :
    HasSum (fun n : ℕ => cexp (π * I * (r : ℂ) ^ 2 * τ) ^ ((n + 1) ^ 2))
      ((thetaSeries (Submodule.span ℤ {r}) τ - 1) / 2) := by
  rw [thetaSeries_span_singleton hr]
  have him : 0 < ((r : ℂ) ^ 2 * (τ : ℂ)).im := by
    simp only [← Complex.ofReal_pow, Complex.mul_im, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, add_zero]
    exact mul_pos (sq_pos_of_ne_zero hr) τ.im_pos
  convert hasSum_nat_jacobiTheta him using 1
  funext n
  rw [← Complex.exp_nat_mul]
  congr 1
  push_cast
  ring

/-- The standard integer lattice expands in powers of `exp (π i τ)`. -/
example (τ : ℍ) :
    HasSum (fun n : ℕ => cexp (π * I * τ) ^ ((n + 1) ^ 2))
      ((thetaSeries (Submodule.span ℤ {(1 : ℝ)}) τ - 1) / 2) := by
  simpa using hasSum_nat_thetaSeries_span_singleton (by norm_num : (1 : ℝ) ≠ 0) τ

/-- The lattice `√2 ℤ` expands in powers of the usual `q = exp (2π i τ)`. -/
example (τ : ℍ) :
    HasSum (fun n : ℕ => cexp (2 * π * I * τ) ^ ((n + 1) ^ 2))
      ((thetaSeries (Submodule.span ℤ {Real.sqrt 2}) τ - 1) / 2) := by
  have h := hasSum_nat_thetaSeries_span_singleton
    (ne_of_gt (Real.sqrt_pos.2 (by norm_num : (0 : ℝ) < 2))) τ
  rw [← Complex.ofReal_pow, Real.sq_sqrt (by norm_num)] at h
  convert h using 1
  funext n
  congr 2
  push_cast
  ring

end ZLattice
