module

public import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups
-- `ZMod.ker_intCastRingHom` identifies the ideal generated by `N` with the kernel of `ℤ → ZMod N`.
import Mathlib.RingTheory.ZMod
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.UpperTriangular.Congruence

/-!
# `Γ₀(N)` and `Γ₁(N)` as upper-triangular congruence subgroups

The classical congruence subgroups `Γ₀(N)` and `Γ₁(N)` of `SL₂(ℤ)` are the determinant-one parts
of the upper-triangular and upper-unitriangular congruence subgroups of `GL₂(ℤ)` modulo `N`: a
matrix lies in `Γ₀(N)` when it is upper triangular modulo `N`, and in `Γ₁(N)` when it is moreover
upper unitriangular modulo `N`. This identifies Mathlib's `CongruenceSubgroup.Gamma0` and
`CongruenceSubgroup.Gamma1` with the preimages of `TauCeti.upperTriangularCongruenceSubgroup` and
`TauCeti.upperUnitriangularCongruenceSubgroup` under `SL₂(ℤ) → GL₂(ℤ)`, for every natural number
`N`, including `N = 0` (where both are the upper-triangular, respectively upper-unitriangular,
matrices of `SL₂(ℤ)`).

## Main declarations

* `TauCeti.comap_toGL_upperTriangularCongruenceSubgroup_span`: the preimage in `SL₂(ℤ)` of the
  upper-triangular congruence subgroup modulo `N` is `Γ₀(N)`.
* `TauCeti.comap_toGL_upperUnitriangularCongruenceSubgroup_span`: the preimage in `SL₂(ℤ)` of the
  upper-unitriangular congruence subgroup modulo `N` is `Γ₁(N)`.
-/

public section

namespace TauCeti

open Matrix CongruenceSubgroup

/-- The determinant-one matrices that are upper triangular modulo `N` form `Γ₀(N)`. -/
theorem comap_toGL_upperTriangularCongruenceSubgroup_span (N : ℕ) :
    (upperTriangularCongruenceSubgroup (Fin 2) (Ideal.span {(N : ℤ)})).comap
        SpecialLinearGroup.toGL = Gamma0 N := by
  rw [← ZMod.ker_intCastRingHom, ← comap_generalLinearGroupMap_upperTriangularGroup]
  ext g
  simp [Matrix.IsUpperTriangular, Matrix.BlockTriangular, Fin.forall_fin_two, Gamma0_mem]

/-- The determinant-one matrices that are upper unitriangular modulo `N` form `Γ₁(N)`. -/
theorem comap_toGL_upperUnitriangularCongruenceSubgroup_span (N : ℕ) :
    (upperUnitriangularCongruenceSubgroup (Fin 2) (Ideal.span {(N : ℤ)})).comap
        SpecialLinearGroup.toGL = Gamma1 N := by
  rw [← ZMod.ker_intCastRingHom, ← comap_generalLinearGroupMap_upperUnitriangularGroup]
  ext g
  simp [Matrix.isUpperUnitriangular_def, Matrix.IsUpperTriangular, Matrix.BlockTriangular,
    Fin.forall_fin_two, and_comm, and_left_comm]

end TauCeti
