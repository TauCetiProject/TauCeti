module

public import TauCeti.Analysis.Complex.Fuchsian.Arithmetic
public import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups
import TauCeti.Analysis.Complex.UpperHalfPlane.PSL.Translation
public import TauCeti.NumberTheory.ModularForms.CongruenceSubgroups.Cusp.Width
import TauCeti.NumberTheory.Modular.ConjugateTranslation
import TauCeti.NumberTheory.ModularForms.CongruenceSubgroups.Basic

/-!
# Congruence subgroups as cofinite Fuchsian groups

At every positive level, the effective images of `Γ(N)`, `Γ₀(N)`, and `Γ₁(N)` in
`PSL(2, ℝ)` are cofinite. Their cusp points are precisely the rational boundary points.
The existing finiteness
theorem for cusp orbits therefore applies to their compactified analytic modular curves.
Since `Γ(N)` is normal in `SL(2, ℤ)`, its effective image is normalized by the image of every
element of `SL(2, ℤ)` (`TauCeti.conjAct_sl2zToPSL2R_smul_map_Gamma`), and it is a normal subgroup
of the level-one group (`TauCeti.normal_subgroupOf_map_Gamma`).

The cusp `∞` of `Γ(N)` has width `N` in the identity scaling: its stabilizer in the effective
image of `Γ(N)` is generated by the image of `T ^ N`. The resulting normalized cusp datum
`TauCeti.cuspDatumInftyGamma` identifies the cusp coordinate of the compactified modular curve
`X(N)` with the modular parameter `q = exp (2πiτ / N)`.

More generally, the cusp `γ ∞` of `Γ₀(N)`, for `γ ∈ SL(2, ℤ)`, has width
`TauCeti.cuspWidthGamma0 N γ` in the scaling `γ⁻¹`: its stabilizer in the effective image of
`Γ₀(N)` is generated by the image of `TauCeti.cuspGeneratorGamma0 N γ = γ T^w γ⁻¹`. This is the
normalized cusp datum `TauCeti.cuspDatumGamma0 N γ`. The width and the lower-right entry of the
generator modulo `N` depend only on the cusp orbit
(`TauCeti.cuspWidthGamma0_eq_of_cuspOrbitOfSL2Z_eq`,
`TauCeti.Gamma0Map_cuspGeneratorGamma0_eq_of_cuspOrbitOfSL2Z_eq`).

When every unit modulo `N` is `±1`, the effective images of `Γ₁(N)` and `Γ₀(N)` coincide
(`TauCeti.Gamma1_map_eq_Gamma0_map`): an element of `Γ₀(N)` or its negative lies in `Γ₁(N)`.

## References

* Fred Diamond and Jerry Shurman, *A First Course in Modular Forms*, §§2.3–2.4.
* Henryk Iwaniec, *Spectral Methods of Automorphic Forms*, §2.4.
-/

public noncomputable section

open Matrix Matrix.ProjectiveSpecialLinearGroup MulAction OnePoint Subgroup CongruenceSubgroup
open scoped MatrixGroups Pointwise

namespace TauCeti

variable (N : ℕ) [NeZero N]

/-- The effective image of the principal congruence subgroup is cofinite. -/
theorem isCofinite_Gamma :
    ((Gamma N).map sl2zToPSL2R).IsCofinite :=
  Subgroup.isCofinite_map_sl2zToPSL2R (Gamma N)

/-- The effective image of `Γ₀(N)` is cofinite. -/
theorem isCofinite_Gamma0 :
    ((Gamma0 N).map sl2zToPSL2R).IsCofinite :=
  Subgroup.isCofinite_map_sl2zToPSL2R (Gamma0 N)

/-- The effective image of `Γ₁(N)` is cofinite. -/
theorem isCofinite_Gamma1 :
    ((Gamma1 N).map sl2zToPSL2R).IsCofinite :=
  Subgroup.isCofinite_map_sl2zToPSL2R (Gamma1 N)

/-- A boundary point is a cusp of `Γ(N)` exactly when it is rational. -/
theorem isCuspPoint_Gamma_iff_rat (c : OnePoint ℝ) :
    ((Gamma N).map sl2zToPSL2R).IsCuspPoint c ↔
      c ∈ Set.range (OnePoint.map Rat.cast) :=
  Subgroup.isCuspPoint_map_sl2zToPSL2R_iff_rat (Gamma N) c

/-- A boundary point is a cusp of `Γ₀(N)` exactly when it is rational. -/
theorem isCuspPoint_Gamma0_iff_rat (c : OnePoint ℝ) :
    ((Gamma0 N).map sl2zToPSL2R).IsCuspPoint c ↔
      c ∈ Set.range (OnePoint.map Rat.cast) :=
  Subgroup.isCuspPoint_map_sl2zToPSL2R_iff_rat (Gamma0 N) c

/-- A boundary point is a cusp of `Γ₁(N)` exactly when it is rational. -/
theorem isCuspPoint_Gamma1_iff_rat (c : OnePoint ℝ) :
    ((Gamma1 N).map sl2zToPSL2R).IsCuspPoint c ↔
      c ∈ Set.range (OnePoint.map Rat.cast) :=
  Subgroup.isCuspPoint_map_sl2zToPSL2R_iff_rat (Gamma1 N) c

variable {N} in
omit [NeZero N] in
/-- **`Γ₁(N)` and `Γ₀(N)` have the same effective image when every unit modulo `N` is `±1`**,
which happens exactly at the levels `0`, `1`, `2`, `3`, `4` and `6`. The unit label of an element
of `Γ₀(N)`, its lower-right entry modulo `N`, is then `1` or `-1`, so the element or its negative
lies in `Γ₁(N)`, and the two have the same image. -/
theorem Gamma1_map_eq_Gamma0_map (hN : ∀ u : (ZMod N)ˣ, u = 1 ∨ u = -1) :
    (Gamma1 N).map sl2zToPSL2R = (Gamma0 N).map sl2zToPSL2R := by
  refine le_antisymm (Subgroup.map_mono (Gamma1_le_Gamma0 N)) ?_
  rintro _ ⟨γ, hγ, rfl⟩
  rcases hN ((Gamma0Map N).toHomUnits ⟨γ, hγ⟩) with h | h
  · exact ⟨γ, (mem_Gamma1_iff_toHomUnits_eq_one ⟨γ, hγ⟩).mpr h, rfl⟩
  · refine ⟨_, (mem_Gamma1_iff_toHomUnits_eq_one (Gamma0.negOne N * ⟨γ, hγ⟩)).mpr ?_, ?_⟩
    · rw [map_mul, Gamma0Map_toHomUnits_negOne, h, neg_one_mul, neg_neg]
    · simp [Gamma0.coe_negOne]

variable {N} in
omit [NeZero N] in
/-- The image in `PSL(2, ℝ)` of every element of `SL(2, ℤ)` normalizes the effective image of
the normal subgroup `Γ(N)`. -/
theorem conjAct_sl2zToPSL2R_smul_map_Gamma (γ : SL(2, ℤ)) :
    ConjAct.toConjAct (sl2zToPSL2R γ) • (Gamma N).map sl2zToPSL2R = (Gamma N).map sl2zToPSL2R :=
  have := Gamma_normal N
  (Gamma N).conjAct_sl2zToPSL2R_smul_map γ

omit [NeZero N] in
/-- The effective image of `Γ(N)` is normal in the level-one group, as `Γ(N)` is normal in
`SL(2, ℤ)` (`Subgroup.normal_subgroupOf_map_sl2zToPSL2R`). -/
instance normal_subgroupOf_map_Gamma :
    (((Gamma N).map sl2zToPSL2R).subgroupOf psl2zToPSL2R.range).Normal :=
  have := Gamma_normal N
  inferInstance

/-- The normalized cusp datum at `∞` of the effective image of `Γ(N)` in `PSL(2, ℝ)`: identity
scaling, width `N`, and the image of `T ^ N` as generator of the stabilizer of `∞`. -/
def cuspDatumInftyGamma : ((Gamma N).map sl2zToPSL2R).CuspDatum := by
  let γ : (Gamma N).map sl2zToPSL2R := ⟨sl2zToPSL2R (ModularGroup.T ^ (N : ℤ)),
    Subgroup.mem_map_of_mem _ (by simpa using ModularGroup_T_pow_mem_Gamma (N : ℤ) N dvd_rfl)⟩
  have hpow (m : ℤ) :
      ((γ ^ m : (Gamma N).map sl2zToPSL2R) : PSL(2, ℝ)) =
        sl2zToPSL2R (ModularGroup.T ^ ((N : ℤ) * m)) := by
    rw [Subgroup.coe_zpow, _root_.zpow_mul, map_zpow]
  have hγ : (γ : PSL(2, ℝ)) = upperRightHom (N : ℝ) := by
    simpa using (hpow 1).trans (UpperHalfPlane.sl2zToPSL2R_T_zpow _)
  refine ⟨∞, 1, γ, N, Nat.cast_pos.mpr (NeZero.pos N), le_antisymm ?_ ?_, by simpa using hγ⟩
  · rw [zpowers_le, mem_stabilizer_iff, Subgroup.smul_def, hγ]
    exact upperRightHom_smul_infty _
  · rintro ⟨_, a, ha, rfl⟩ hg
    have hc : a 1 0 = 0 :=
      (sl2zToPSL2R_smul_infty_eq_infty_iff a).mp (mem_stabilizer_iff.mp hg)
    obtain ⟨k, hk⟩ : (N : ℤ) ∣ a 0 1 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp (Gamma_mem.mp ha).2.1
    -- `a` is `± T ^ (N * k)`, and the sign dies in `PSL(2, ℝ)`
    refine mem_zpowers_iff.mpr ?_
    rcases ModularGroup.eq_T_zpow_or_eq_neg_T_zpow_of_c_eq_zero hc with ha' | ha'
    · have h : sl2zToPSL2R a = sl2zToPSL2R (ModularGroup.T ^ a 0 1) := by
        conv_lhs => rw [ha']
      exact ⟨k, Subtype.ext ((hpow k).trans (by rw [← hk, ← h]))⟩
    · have h : sl2zToPSL2R a = sl2zToPSL2R (ModularGroup.T ^ (-a 0 1)) := by
        conv_lhs => rw [ha', sl2zToPSL2R_neg]
      exact ⟨-k, Subtype.ext ((hpow (-k)).trans (by rw [mul_neg, ← hk, ← h]))⟩

/-- The cusp of the normalized datum of `Γ(N)` at `∞` is `∞`. -/
@[simp]
theorem cuspDatumInftyGamma_cusp : (cuspDatumInftyGamma N).cusp = (∞ : OnePoint ℝ) := (rfl)

/-- The normalized datum of `Γ(N)` at `∞` has the identity scaling. -/
@[simp]
theorem cuspDatumInftyGamma_scaling : (cuspDatumInftyGamma N).scaling = 1 := (rfl)

/-- The cusp `∞` of `Γ(N)` has width `N` in the identity scaling. -/
@[simp]
theorem cuspDatumInftyGamma_width : (cuspDatumInftyGamma N).width = N := (rfl)

/-- The stabilizer of `∞` in the effective image of `Γ(N)` is generated by the image of
`T ^ N`. -/
@[simp]
theorem cuspDatumInftyGamma_generator :
    ((cuspDatumInftyGamma N).generator : PSL(2, ℝ)) = sl2zToPSL2R (ModularGroup.T ^ (N : ℤ)) :=
  (rfl)

/-- If `γ⁻¹ a γ` fixes `∞` and `a ∈ Γ₀(N)`, then `a` has the same image in `PSL(2, ℝ)` as a power
of the generator `cuspGeneratorGamma0 N γ`. -/
private theorem exists_sl2zToPSL2R_eq_cuspGeneratorGamma0_zpow {γ a : SL(2, ℤ)}
    (ha : a ∈ Gamma0 N) (hc : (γ⁻¹ * a * γ) 1 0 = 0) :
    ∃ k : ℤ, sl2zToPSL2R a = sl2zToPSL2R ((cuspGeneratorGamma0 N γ : SL(2, ℤ)) ^ k) := by
  -- `γ⁻¹ a γ = ± Tᵐ`, and the sign dies in `PSL(2, ℝ)`
  obtain ⟨m, hm⟩ : ∃ m : ℤ, γ⁻¹ * a * γ = ModularGroup.T ^ m ∨
      γ⁻¹ * a * γ = -ModularGroup.T ^ m := by
    rcases ModularGroup.eq_T_zpow_or_eq_neg_T_zpow_of_c_eq_zero hc with h | h
    exacts [⟨_, Or.inl h⟩, ⟨_, Or.inr h⟩]
  have ha' : a = γ * (γ⁻¹ * a * γ) * γ⁻¹ := by group
  replace hm : a = γ * ModularGroup.T ^ m * γ⁻¹ ∨ a = -(γ * ModularGroup.T ^ m * γ⁻¹) := by
    rcases hm with h | h <;> rw [h] at ha'
    · exact Or.inl ha'
    · rw [mul_neg, neg_mul] at ha'
      exact Or.inr ha'
  have hmem : γ * ModularGroup.T ^ m * γ⁻¹ ∈ Gamma0 N := by
    rcases hm with rfl | rfl
    · exact ha
    · simpa [Gamma0_mem] using ha
  obtain ⟨k, rfl⟩ := (conj_T_zpow_mem_Gamma0_iff_cuspWidthGamma0_dvd N γ m).mp hmem
  refine ⟨k, ?_⟩
  rw [coe_cuspGeneratorGamma0, conj_zpow, ← _root_.zpow_mul]
  rcases hm with rfl | rfl
  · rfl
  · rw [sl2zToPSL2R_neg]

/-- **The normalized cusp datum of `Γ₀(N)` at `γ ∞`**: scaling the image of `γ⁻¹`, width
`cuspWidthGamma0 N γ = N / gcd(N, c²)`, and the image of `cuspGeneratorGamma0 N γ = γ T^w γ⁻¹`
as generator of the stabilizer of `γ ∞` in the effective image of `Γ₀(N)`. -/
def cuspDatumGamma0 (γ : SL(2, ℤ)) : ((Gamma0 N).map sl2zToPSL2R).CuspDatum where
  cusp := sl2zToPSL2R γ • ∞
  scaling := (sl2zToPSL2R γ)⁻¹
  generator :=
    ⟨sl2zToPSL2R (cuspGeneratorGamma0 N γ),
      Subgroup.mem_map_of_mem _ (cuspGeneratorGamma0 N γ).property⟩
  width := cuspWidthGamma0 N γ
  width_pos := Nat.cast_pos.mpr (cuspWidthGamma0_pos N γ)
  zpowers_generator := by
    refine le_antisymm ?_ ?_
    · rw [zpowers_le, mem_stabilizer_iff, Subgroup.smul_def, Subgroup.coe_mk,
        coe_cuspGeneratorGamma0, map_mul, map_mul, map_inv, mul_smul, mul_smul, inv_smul_smul,
        UpperHalfPlane.sl2zToPSL2R_T_zpow, upperRightHom_smul_infty]
    · rintro ⟨_, a, ha, rfl⟩ hg
      have hc : (γ⁻¹ * a * γ) 1 0 = 0 := by
        rw [← sl2zToPSL2R_smul_infty_eq_infty_iff, map_mul, map_mul, map_inv, mul_smul, mul_smul,
          inv_smul_eq_iff]
        exact mem_stabilizer_iff.mp hg
      obtain ⟨k, hk⟩ := exists_sl2zToPSL2R_eq_cuspGeneratorGamma0_zpow N ha hc
      exact mem_zpowers_iff.mpr ⟨k, Subtype.ext (by simp [hk])⟩
  scaling_mul_generator_mul_inv := by
    rw [Subgroup.coe_mk, coe_cuspGeneratorGamma0, inv_inv, map_mul, map_mul, map_inv,
      UpperHalfPlane.sl2zToPSL2R_T_zpow]
    simp [mul_assoc]

/-- The cusp of the normalized datum of `Γ₀(N)` at `γ ∞` is `γ ∞`. -/
@[simp]
theorem cuspDatumGamma0_cusp (γ : SL(2, ℤ)) :
    (cuspDatumGamma0 N γ).cusp = sl2zToPSL2R γ • (∞ : OnePoint ℝ) := (rfl)

/-- The normalized datum of `Γ₀(N)` at `γ ∞` has scaling `γ⁻¹`. -/
@[simp]
theorem cuspDatumGamma0_scaling (γ : SL(2, ℤ)) :
    (cuspDatumGamma0 N γ).scaling = (sl2zToPSL2R γ)⁻¹ := (rfl)

/-- The cusp `γ ∞` of `Γ₀(N)` has width `cuspWidthGamma0 N γ = N / gcd(N, c²)` in the scaling
`γ⁻¹`. -/
@[simp]
theorem cuspDatumGamma0_width (γ : SL(2, ℤ)) :
    (cuspDatumGamma0 N γ).width = cuspWidthGamma0 N γ := (rfl)

/-- The stabilizer of `γ ∞` in the effective image of `Γ₀(N)` is generated by the image of
`cuspGeneratorGamma0 N γ = γ T^w γ⁻¹`. -/
@[simp]
theorem cuspDatumGamma0_generator (γ : SL(2, ℤ)) :
    ((cuspDatumGamma0 N γ).generator : PSL(2, ℝ)) = sl2zToPSL2R (cuspGeneratorGamma0 N γ) := (rfl)

/-- Matrices representing the same cusp of `Γ₀(N)` differ by an element of `Γ₀(N)` on the left
and an element fixing `∞` on the right. -/
private theorem exists_eq_mul_mul_of_cuspOrbitOfSL2Z_eq {γ γ' : SL(2, ℤ)}
    (hγ : (Gamma0 N).cuspOrbitOfSL2Z γ = (Gamma0 N).cuspOrbitOfSL2Z γ') :
    ∃ g ∈ Gamma0 N, ∃ M : SL(2, ℤ), M 1 0 = 0 ∧ γ' = g * γ * M := by
  obtain ⟨g, hg, hc⟩ := (Subgroup.cuspOrbitOfSL2Z_eq_iff _ γ γ').mp hγ
  exact ⟨g⁻¹, inv_mem hg, γ⁻¹ * g * γ', hc, by group⟩

/-- Matrices representing the same cusp of `Γ₀(N)` have the same width. -/
theorem cuspWidthGamma0_eq_of_cuspOrbitOfSL2Z_eq {γ γ' : SL(2, ℤ)}
    (hγ : (Gamma0 N).cuspOrbitOfSL2Z γ = (Gamma0 N).cuspOrbitOfSL2Z γ') :
    cuspWidthGamma0 N γ' = cuspWidthGamma0 N γ := by
  obtain ⟨g, hg, M, hM, rfl⟩ := exists_eq_mul_mul_of_cuspOrbitOfSL2Z_eq N hγ
  exact cuspWidthGamma0_mul_mul N hg γ hM

/-- Matrices representing the same cusp of `Γ₀(N)` have generators with the same lower-right
entry modulo `N`. -/
theorem Gamma0Map_cuspGeneratorGamma0_eq_of_cuspOrbitOfSL2Z_eq {γ γ' : SL(2, ℤ)}
    (hγ : (Gamma0 N).cuspOrbitOfSL2Z γ = (Gamma0 N).cuspOrbitOfSL2Z γ') :
    Gamma0Map N (cuspGeneratorGamma0 N γ') = Gamma0Map N (cuspGeneratorGamma0 N γ) := by
  obtain ⟨g, hg, M, hM, rfl⟩ := exists_eq_mul_mul_of_cuspOrbitOfSL2Z_eq N hγ
  exact Gamma0Map_cuspGeneratorGamma0_mul_mul N hg γ hM

end TauCeti
