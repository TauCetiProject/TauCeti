module

public import TauCeti.Analysis.Complex.Fuchsian.Arithmetic
public import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups
import TauCeti.Analysis.Complex.UpperHalfPlane.PSL.Translation
import TauCeti.NumberTheory.Modular.ConjugateTranslation

/-!
# Congruence subgroups as cofinite Fuchsian groups

At every positive level, the effective images of `Γ(N)`, `Γ₀(N)`, and `Γ₁(N)` in
`PSL(2, ℝ)` are cofinite. Their cusp points are precisely the rational boundary points.
The existing finiteness
theorem for cusp orbits therefore applies to their compactified analytic modular curves.

The cusp `∞` of `Γ(N)` has width `N` in the identity scaling: its stabilizer in the effective
image of `Γ(N)` is generated by the image of `T ^ N`. The resulting normalized cusp datum
`TauCeti.cuspDatumInftyGamma` identifies the cusp coordinate of the compactified modular curve
`X(N)` with the modular parameter `q = exp (2πiτ / N)`.

## References

* Fred Diamond and Jerry Shurman, *A First Course in Modular Forms*, §§2.3–2.4.
-/

public noncomputable section

open Matrix Matrix.ProjectiveSpecialLinearGroup MulAction OnePoint Subgroup CongruenceSubgroup
open scoped MatrixGroups

namespace TauCeti

variable (N : ℕ) [NeZero N]

/-- The effective image of the principal congruence subgroup is cofinite. -/
theorem isCofinite_Gamma :
    ((Gamma N).map sl2zToPSL2R).IsCofinite :=
  Subgroup.isCofinite_map_sl2zToPSL2R (Gamma N)

/-- The effective image of `Γ₀(N)` is cofinite. -/
theorem isCofinite_Gamma0 :
    ((Gamma0 N).map sl2zToPSL2R).IsCofinite :=
  Subgroup.isCofinite_map_sl2zToPSL2R (Gamma0 N)

/-- The effective image of `Γ₁(N)` is cofinite. -/
theorem isCofinite_Gamma1 :
    ((Gamma1 N).map sl2zToPSL2R).IsCofinite :=
  Subgroup.isCofinite_map_sl2zToPSL2R (Gamma1 N)

/-- A boundary point is a cusp of `Γ(N)` exactly when it is rational. -/
theorem isCuspPoint_Gamma_iff_rat (c : OnePoint ℝ) :
    ((Gamma N).map sl2zToPSL2R).IsCuspPoint c ↔
      c ∈ Set.range (OnePoint.map Rat.cast) :=
  Subgroup.isCuspPoint_map_sl2zToPSL2R_iff_rat (Gamma N) c

/-- A boundary point is a cusp of `Γ₀(N)` exactly when it is rational. -/
theorem isCuspPoint_Gamma0_iff_rat (c : OnePoint ℝ) :
    ((Gamma0 N).map sl2zToPSL2R).IsCuspPoint c ↔
      c ∈ Set.range (OnePoint.map Rat.cast) :=
  Subgroup.isCuspPoint_map_sl2zToPSL2R_iff_rat (Gamma0 N) c

/-- A boundary point is a cusp of `Γ₁(N)` exactly when it is rational. -/
theorem isCuspPoint_Gamma1_iff_rat (c : OnePoint ℝ) :
    ((Gamma1 N).map sl2zToPSL2R).IsCuspPoint c ↔
      c ∈ Set.range (OnePoint.map Rat.cast) :=
  Subgroup.isCuspPoint_map_sl2zToPSL2R_iff_rat (Gamma1 N) c

/-- The normalized cusp datum at `∞` of the effective image of `Γ(N)` in `PSL(2, ℝ)`: identity
scaling, width `N`, and the image of `T ^ N` as generator of the stabilizer of `∞`. -/
def cuspDatumInftyGamma : ((Gamma N).map sl2zToPSL2R).CuspDatum := by
  let γ : (Gamma N).map sl2zToPSL2R := ⟨sl2zToPSL2R (ModularGroup.T ^ (N : ℤ)),
    Subgroup.mem_map_of_mem _ (by simpa using ModularGroup_T_pow_mem_Gamma (N : ℤ) N dvd_rfl)⟩
  have hpow (m : ℤ) :
      ((γ ^ m : (Gamma N).map sl2zToPSL2R) : PSL(2, ℝ)) =
        sl2zToPSL2R (ModularGroup.T ^ ((N : ℤ) * m)) := by
    rw [Subgroup.coe_zpow, _root_.zpow_mul, map_zpow]
  have hγ : (γ : PSL(2, ℝ)) = upperRightHom (N : ℝ) := by
    simpa using (hpow 1).trans (UpperHalfPlane.sl2zToPSL2R_T_zpow _)
  refine ⟨∞, 1, γ, N, Nat.cast_pos.mpr (NeZero.pos N), le_antisymm ?_ ?_, by simpa using hγ⟩
  · rw [zpowers_le, mem_stabilizer_iff, Subgroup.smul_def, hγ]
    exact upperRightHom_smul_infty _
  · rintro ⟨_, a, ha, rfl⟩ hg
    have hc : a 1 0 = 0 :=
      (sl2zToPSL2R_smul_infty_eq_infty_iff a).mp (mem_stabilizer_iff.mp hg)
    obtain ⟨k, hk⟩ : (N : ℤ) ∣ a 0 1 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp (Gamma_mem.mp ha).2.1
    -- `a` is `± T ^ (N * k)`, and the sign dies in `PSL(2, ℝ)`
    have hneg : sl2zToPSL2R (-1) = 1 := MonoidHom.mem_ker.mp
      (sl2zToPSL2R_ker ▸ Subgroup.mem_center_iff.mpr fun g ↦ by rw [neg_one_mul, mul_neg_one])
    refine mem_zpowers_iff.mpr ?_
    rcases ModularGroup.eq_T_zpow_or_eq_neg_T_zpow_of_c_eq_zero hc with ha' | ha'
    · have h : sl2zToPSL2R a = sl2zToPSL2R (ModularGroup.T ^ a 0 1) := by
        conv_lhs => rw [ha']
      exact ⟨k, Subtype.ext ((hpow k).trans (by rw [← hk, ← h]))⟩
    · have h : sl2zToPSL2R a = sl2zToPSL2R (ModularGroup.T ^ (-a 0 1)) := by
        conv_lhs => rw [ha', ← neg_one_mul, map_mul, hneg, one_mul]
      exact ⟨-k, Subtype.ext ((hpow (-k)).trans (by rw [mul_neg, ← hk, ← h]))⟩

/-- The cusp of the normalized datum of `Γ(N)` at `∞` is `∞`. -/
@[simp]
theorem cuspDatumInftyGamma_cusp : (cuspDatumInftyGamma N).cusp = (∞ : OnePoint ℝ) := (rfl)

/-- The normalized datum of `Γ(N)` at `∞` has the identity scaling. -/
@[simp]
theorem cuspDatumInftyGamma_scaling : (cuspDatumInftyGamma N).scaling = 1 := (rfl)

/-- The cusp `∞` of `Γ(N)` has width `N` in the identity scaling. -/
@[simp]
theorem cuspDatumInftyGamma_width : (cuspDatumInftyGamma N).width = N := (rfl)

/-- The stabilizer of `∞` in the effective image of `Γ(N)` is generated by the image of
`T ^ N`. -/
@[simp]
theorem cuspDatumInftyGamma_generator :
    ((cuspDatumInftyGamma N).generator : PSL(2, ℝ)) = sl2zToPSL2R (ModularGroup.T ^ (N : ℤ)) :=
  (rfl)

end TauCeti
