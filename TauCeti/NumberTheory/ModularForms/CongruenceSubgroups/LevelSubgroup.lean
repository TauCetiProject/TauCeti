module

-- `CongruenceSubgroup.Gamma0`, `Gamma1` and `Gamma` occur in the comparison statements below.
public import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups
-- `Γ₀(N)` of `GL₂(ℤ/N)` is the Borel subgroup `TauCeti.GL2Borel (ZMod N)`.
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Borel
-- Non-public: `ZMod p` is a field, used only in the proof of `index_adjoinNegOne_GL2Borel_zmod`.
import Mathlib.Algebra.Field.ZMod

/-!
# Level subgroups of `GL₂(ℤ/N)` and the standard levels

An open subgroup `H` of `GL₂(ZHat)` containing the principal congruence kernel at `N` is the
preimage of its image in `GL₂(ℤ/N)`, and the invariants of the modular curve `X_H` are read off
that image. This file defines the standard congruence levels as subgroups of `GL₂(R)` over a
commutative ring `R`, the case of interest being `R = ℤ/N`, together with invariants of an arbitrary
level: its projective index and its determinant image.

Matrices act on ordered bases on the right, `(P, Q) · !![a, b; c, d] = (aP + cQ, bP + dQ)`, so the
first basis vector of the transformed basis has coordinates the first column `(a, c)`.

* `Γ₀(N)`, the lower-left entry `c = 0`, is the Borel subgroup `TauCeti.GL2Borel (ZMod N)`.
* `TauCeti.levelGamma1 R`: `a = 1` and `c = 0`. It is the stabiliser of the first basis vector:
  `g *ᵥ e₀ = e₀`.
* `TauCeti.levelGamma1Mu R`: `c = 0` and `d = 1`, the level `Γ₁^μ(N)` whose structures are the
  embeddings `μ_N ↪ E[N]`. It is the stabiliser of the second coordinate form: `e₁ ᵥ* g = e₁`.
* `Γ(N)` is the trivial subgroup.

The projective index of a level `H` is the index of the subgroup `±H` generated by `H` and `-1`,
which is Mathlib's `Subgroup.adjoinNegOne H`. It is the degree of the coarse curve `X_H` over the
`j`-line, and it is half the index of `H` when `-1 ∉ H`, as for `Γ₁(N)` and `Γ(N)` with `N ≥ 3`.

## Main definitions

* `TauCeti.levelGamma1`, `TauCeti.levelGamma1Mu`: the levels `Γ₁` and `Γ₁^μ` of `GL₂(R)`.
* `TauCeti.levelDet`: the image `det(H) ≤ Rˣ`; for a level `H` of `GL₂(ℤ/N)` its fixed field in
  `ℚ(ζ_N)` is the field of definition of the components of `X_H`.

## Main results

* `TauCeti.two_mul_index_adjoinNegOne`: the projective index is half the index when `-1 ∉ H`
  (and equal to it when `-1 ∈ H`, by `Subgroup.adjoinNegOne_eq_self_iff`).
* `TauCeti.comap_mapGL_GL2Borel`, `TauCeti.comap_mapGL_levelGamma1`,
  `TauCeti.comap_mapGL_levelGamma1Mu`, `TauCeti.comap_mapGL_bot`: the preimages in `SL₂(ℤ)` of
  `Γ₀`, `Γ₁`, `Γ₁^μ` and of the trivial subgroup of `GL₂(ℤ/N)` are Mathlib's
  `CongruenceSubgroup.Gamma0 N`, `Gamma1 N`, `Gamma1 N` and `Gamma N`.
* `TauCeti.neg_one_mem_levelGamma1_iff`, `TauCeti.two_mul_index_adjoinNegOne_levelGamma1`: `-1 ∈ Γ₁`
  exactly when `2 = 0`, so for `N ≥ 3` the projective index of `Γ₁(N)` is half its index.
* `TauCeti.levelDet_GL2Borel`, `TauCeti.levelDet_levelGamma1`, `TauCeti.levelDet_levelGamma1Mu`:
  the determinant is surjective on these levels.
* `TauCeti.index_conjAct_smul`, `TauCeti.index_adjoinNegOne_conjAct_smul`,
  `TauCeti.levelDet_conjAct_smul`: conjugation preserves the index, the projective index and the
  determinant image.
* `TauCeti.index_adjoinNegOne_GL2Borel_zmod`: `[GL₂(𝔽_p) : ±Γ₀(p)] = p + 1`.

## References

* K. Česnavičius, *A modular description of `X₀(n)`*, Algebra Number Theory 11 (2017), §4.1.2
  and §4.4.
* D. Zywina, *On the possible images of the mod ℓ representations associated to elliptic curves
  over ℚ*, §1 and §3.2.
-/

public section

namespace TauCeti

open Matrix Matrix.GeneralLinearGroup Pointwise

universe u v

section Projective

variable {G : Type v} [Group G]

/-- Conjugation preserves the index of a subgroup. -/
theorem index_conjAct_smul (g : G) (H : Subgroup G) :
    (ConjAct.toConjAct g • H).index = H.index := by
  simpa using Subgroup.relIndex_pointwise_smul (ConjAct.toConjAct g) H ⊤

variable [HasDistribNeg G]

/-- The index of a subgroup not containing `-1` is twice the projective index, the index of
`±H = Subgroup.adjoinNegOne H`. -/
theorem two_mul_index_adjoinNegOne {H : Subgroup G} (h : -1 ∉ H) :
    2 * H.adjoinNegOne.index = H.index := by
  rw [← Subgroup.relIndex_adjoinNegOne_eq_two h, Subgroup.relIndex_mul_index H.le_adjoinNegOne]

/-- Conjugation preserves the projective index. -/
theorem index_adjoinNegOne_conjAct_smul (g : G) (H : Subgroup G) :
    (ConjAct.toConjAct g • H).adjoinNegOne.index = H.adjoinNegOne.index := by
  rw [Subgroup.adjoinNegOne_conj, index_conjAct_smul]

end Projective

section Det

variable {n : Type v} [Fintype n] [DecidableEq n] {R : Type u} [CommRing R]

/-- The **determinant image** `det(H) ≤ Rˣ` of a subgroup `H` of `GL n R`. For a level `H` of
`GL₂(ℤ/N)`, its fixed field in `ℚ(ζ_N)` is the field of definition of the components of `X_H`. -/
def levelDet (H : Subgroup (GL n R)) : Subgroup Rˣ :=
  H.map det

/-- The determinant image is the image of `H` under the determinant. -/
theorem levelDet_def (H : Subgroup (GL n R)) : levelDet H = H.map det :=
  (rfl)

/-- A unit lies in `det(H)` exactly when it is the determinant of an element of `H`. -/
theorem mem_levelDet_iff {H : Subgroup (GL n R)} {u : Rˣ} :
    u ∈ levelDet H ↔ ∃ g ∈ H, det g = u :=
  Subgroup.mem_map

/-- The trivial level has trivial determinant image. -/
@[simp]
theorem levelDet_bot : levelDet (⊥ : Subgroup (GL n R)) = ⊥ :=
  Subgroup.map_bot _

/-- The determinant image is monotone in the level. -/
theorem levelDet_mono {H K : Subgroup (GL n R)} (h : H ≤ K) : levelDet H ≤ levelDet K :=
  Subgroup.map_mono h

/-- Conjugation preserves the determinant image. -/
@[simp]
theorem levelDet_conjAct_smul (g : GL n R) (H : Subgroup (GL n R)) :
    levelDet (ConjAct.toConjAct g • H) = levelDet H := by
  ext u
  simp only [mem_levelDet_iff, Subgroup.mem_pointwise_smul_iff_inv_smul_mem, ConjAct.smul_def,
    map_inv, ConjAct.ofConjAct_toConjAct, inv_inv]
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨_, hx, by simp⟩
  · rintro ⟨x, hx, rfl⟩
    exact ⟨g * x * g⁻¹, by simpa [mul_assoc] using hx, by simp [mul_comm (det g)]⟩

end Det

section Levels

variable (R : Type u) [CommRing R]

/-- The level `Γ₁` of `GL₂(R)`: the matrices `!![1, b; 0, d]`, the stabiliser of the first basis
vector `e₀`. Under the right action `(P, Q) · g = (aP + cQ, bP + dQ)` on ordered bases these are
the matrices fixing `P`. -/
def levelGamma1 : Subgroup (GL (Fin 2) R) where
  carrier := {g | (g : Matrix (Fin 2) (Fin 2) R) *ᵥ Pi.single 0 1 = Pi.single 0 1}
  one_mem' := one_mulVec _
  mul_mem' {a b} ha hb := by
    simp only [Set.mem_ofPred_eq, Units.val_mul, ← mulVec_mulVec] at ha hb ⊢
    rw [hb, ha]
  inv_mem' {a} ha := by
    simp only [Set.mem_ofPred_eq] at ha ⊢
    conv_lhs => rw [← ha]
    rw [mulVec_mulVec, Units.inv_mul, one_mulVec]

/-- The level `Γ₁^μ` of `GL₂(R)`: the matrices `!![a, b; 0, 1]`, the stabiliser of the second
coordinate form `e₁`. For `R = ℤ/N`, its level structures `(P, Q) ↦ (⟨P⟩, Q mod ⟨P⟩)` are the
embeddings `μ_N ↪ E[N]`, the convention of Calegari and Geraghty. -/
def levelGamma1Mu : Subgroup (GL (Fin 2) R) where
  carrier := {g | Pi.single 1 1 ᵥ* (g : Matrix (Fin 2) (Fin 2) R) = Pi.single 1 1}
  one_mem' := vecMul_one _
  mul_mem' {a b} ha hb := by
    simp only [Set.mem_ofPred_eq, Units.val_mul, ← vecMul_vecMul] at ha hb ⊢
    rw [ha, hb]
  inv_mem' {a} ha := by
    simp only [Set.mem_ofPred_eq] at ha ⊢
    conv_lhs => rw [← ha]
    rw [vecMul_vecMul, Units.mul_inv, vecMul_one]

variable {R}

/-- `Γ₁` is the stabiliser of the first basis vector `e₀`. -/
theorem mem_levelGamma1_iff_mulVec {g : GL (Fin 2) R} :
    g ∈ levelGamma1 R ↔ (g : Matrix (Fin 2) (Fin 2) R) *ᵥ Pi.single 0 1 = Pi.single 0 1 :=
  Iff.rfl

/-- `Γ₁^μ` is the stabiliser of the second coordinate form `e₁`. -/
theorem mem_levelGamma1Mu_iff_vecMul {g : GL (Fin 2) R} :
    g ∈ levelGamma1Mu R ↔ Pi.single 1 1 ᵥ* (g : Matrix (Fin 2) (Fin 2) R) = Pi.single 1 1 :=
  Iff.rfl

/-- `g ∈ Γ₁` exactly when its first column is `(1, 0)`. -/
theorem mem_levelGamma1_iff {g : GL (Fin 2) R} :
    g ∈ levelGamma1 R ↔
      (g : Matrix (Fin 2) (Fin 2) R) 0 0 = 1 ∧ (g : Matrix (Fin 2) (Fin 2) R) 1 0 = 0 := by
  simp only [mem_levelGamma1_iff_mulVec, mulVec_single_one, funext_iff, Fin.forall_fin_two]
  simp

/-- `g ∈ Γ₁^μ` exactly when its second row is `(0, 1)`. -/
theorem mem_levelGamma1Mu_iff {g : GL (Fin 2) R} :
    g ∈ levelGamma1Mu R ↔
      (g : Matrix (Fin 2) (Fin 2) R) 1 0 = 0 ∧ (g : Matrix (Fin 2) (Fin 2) R) 1 1 = 1 := by
  simp only [mem_levelGamma1Mu_iff_vecMul, single_one_vecMul, funext_iff, Fin.forall_fin_two]
  simp

/-- `-1 ∈ Γ₁` exactly when `2 = 0` in `R`; so `-1 ∉ Γ₁(N)` for `N ≥ 3`. -/
theorem neg_one_mem_levelGamma1_iff : (-1 : GL (Fin 2) R) ∈ levelGamma1 R ↔ (2 : R) = 0 := by
  simp [mem_levelGamma1_iff, neg_eq_iff_add_eq_zero, one_add_one_eq_two]

/-- `-1 ∈ Γ₁^μ` exactly when `2 = 0` in `R`. -/
theorem neg_one_mem_levelGamma1Mu_iff : (-1 : GL (Fin 2) R) ∈ levelGamma1Mu R ↔ (2 : R) = 0 := by
  simp [mem_levelGamma1Mu_iff, neg_eq_iff_add_eq_zero, one_add_one_eq_two]

/-- When `2 ≠ 0` in `R`, the index of `Γ₁` is twice its projective index. -/
theorem two_mul_index_adjoinNegOne_levelGamma1 (h : (2 : R) ≠ 0) :
    2 * (levelGamma1 R).adjoinNegOne.index = (levelGamma1 R).index :=
  two_mul_index_adjoinNegOne (mt neg_one_mem_levelGamma1_iff.mp h)

/-- `Γ₁ ≤ Γ₀`. -/
theorem levelGamma1_le_GL2Borel : levelGamma1 R ≤ GL2Borel R :=
  fun _ hg => GL2Borel.mem_iff.mpr (mem_levelGamma1_iff.mp hg).2

/-- `Γ₁^μ ≤ Γ₀`. -/
theorem levelGamma1Mu_le_GL2Borel : levelGamma1Mu R ≤ GL2Borel R :=
  fun _ hg => GL2Borel.mem_iff.mpr (mem_levelGamma1Mu_iff.mp hg).1

/-- The determinant is surjective on `Γ₁`: `det !![1, 0; 0, u] = u`. -/
@[simp]
theorem levelDet_levelGamma1 : levelDet (levelGamma1 R) = ⊤ := by
  refine eq_top_iff.mpr fun u _ => mem_levelDet_iff.mpr ⟨GL2Borel.mk 1 u 0, ?_, ?_⟩
  · simp [mem_levelGamma1_iff]
  · ext
    simp [Matrix.det_fin_two]

/-- The determinant is surjective on `Γ₁^μ`: `det !![u, 0; 0, 1] = u`. -/
@[simp]
theorem levelDet_levelGamma1Mu : levelDet (levelGamma1Mu R) = ⊤ := by
  refine eq_top_iff.mpr fun u _ => mem_levelDet_iff.mpr ⟨GL2Borel.mk u 1 0, ?_, ?_⟩
  · simp [mem_levelGamma1Mu_iff]
  · ext
    simp [Matrix.det_fin_two]

/-- The determinant is surjective on `Γ₀ = GL2Borel`. -/
@[simp]
theorem levelDet_GL2Borel : levelDet (GL2Borel R) = ⊤ :=
  eq_top_iff.mpr (levelDet_levelGamma1 (R := R) ▸ levelDet_mono levelGamma1_le_GL2Borel)

/-- `-1 ∈ Γ₀`, so the projective index of `Γ₀` is its index. -/
@[simp]
theorem adjoinNegOne_GL2Borel : (GL2Borel R).adjoinNegOne = GL2Borel R :=
  Subgroup.adjoinNegOne_eq_self_iff.mpr (GL2Borel.mem_iff.mpr (by simp))

/-- **The projective index of `Γ₀(p)`** in `GL₂(𝔽_p)` is `p + 1`. -/
theorem index_adjoinNegOne_GL2Borel_zmod (p : ℕ) [Fact p.Prime] :
    (GL2Borel (ZMod p)).adjoinNegOne.index = p + 1 := by
  have h := GL2Borel.index_eq (ZMod p)
  rw [ZMod.card] at h
  rw [adjoinNegOne_GL2Borel]
  exact h

end Levels

section Comparison

open CongruenceSubgroup Matrix.SpecialLinearGroup MatrixGroups

variable (N : ℕ)

/-- The entries of the reduction of `g ∈ SL₂(ℤ)` modulo `N` are the reductions of its entries. -/
private theorem mapGL_zmod_apply (g : SL(2, ℤ)) (i j : Fin 2) :
    ((mapGL (ZMod N) g : GL (Fin 2) (ZMod N)) : Matrix (Fin 2) (Fin 2) (ZMod N)) i j =
      ((g i j : ℤ) : ZMod N) :=
  rfl

/-- The determinant identity `ad - bc = 1` of `g ∈ SL₂(ℤ)`, reduced modulo `N`. -/
private theorem det_zmod (g : SL(2, ℤ)) :
    ((g 0 0 : ℤ) : ZMod N) * (g 1 1 : ℤ) - ((g 0 1 : ℤ) : ZMod N) * (g 1 0 : ℤ) = 1 := by
  have h := g.det_coe
  rw [Matrix.det_fin_two] at h
  exact_mod_cast congrArg (Int.cast : ℤ → ZMod N) h

/-- The preimage of `Γ₀ = GL2Borel` of `GL₂(ℤ/N)` in `SL₂(ℤ)` is `Γ₀(N)`. -/
theorem comap_mapGL_GL2Borel :
    (GL2Borel (ZMod N)).comap (mapGL (ZMod N) : SL(2, ℤ) →* GL (Fin 2) (ZMod N)) = Gamma0 N := by
  ext g
  simp [Gamma0_mem]

/-- The preimage of `Γ₁` of `GL₂(ℤ/N)` in `SL₂(ℤ)` is `Γ₁(N)`; the lower-right congruence
`d ≡ 1` is forced by the determinant. -/
theorem comap_mapGL_levelGamma1 :
    (levelGamma1 (ZMod N)).comap (mapGL (ZMod N) : SL(2, ℤ) →* GL (Fin 2) (ZMod N)) =
      Gamma1 N := by
  ext g
  have hdet := det_zmod N g
  simp only [Subgroup.mem_comap, mem_levelGamma1_iff, mapGL_zmod_apply, Gamma1_mem]
  constructor
  · rintro ⟨ha, hc⟩
    exact ⟨ha, by simpa [ha, hc] using hdet, hc⟩
  · rintro ⟨ha, -, hc⟩
    exact ⟨ha, hc⟩

/-- The preimage of `Γ₁^μ` of `GL₂(ℤ/N)` in `SL₂(ℤ)` is `Γ₁(N)`; the upper-left congruence
`a ≡ 1` is forced by the determinant. -/
theorem comap_mapGL_levelGamma1Mu :
    (levelGamma1Mu (ZMod N)).comap (mapGL (ZMod N) : SL(2, ℤ) →* GL (Fin 2) (ZMod N)) =
      Gamma1 N := by
  ext g
  have hdet := det_zmod N g
  simp only [Subgroup.mem_comap, mem_levelGamma1Mu_iff, mapGL_zmod_apply, Gamma1_mem]
  constructor
  · rintro ⟨hc, hd⟩
    exact ⟨by simpa [hd, hc] using hdet, hd, hc⟩
  · rintro ⟨-, hd, hc⟩
    exact ⟨hc, hd⟩

/-- The preimage of the trivial subgroup of `GL₂(ℤ/N)` in `SL₂(ℤ)` is `Γ(N)`. -/
theorem comap_mapGL_bot :
    (⊥ : Subgroup (GL (Fin 2) (ZMod N))).comap
      (mapGL (ZMod N) : SL(2, ℤ) →* GL (Fin 2) (ZMod N)) = Gamma N := by
  ext g
  simp [Gamma_mem, Units.ext_iff, ← Matrix.ext_iff, Fin.forall_fin_two, and_assoc]

end Comparison

end TauCeti
