module

public import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups
public import TauCeti.NumberTheory.Modular.Relations
import TauCeti.NumberTheory.Modular.FareySymbol.Generators

/-!
# Generators of the principal congruence subgroup `Γ(2)`

The principal congruence subgroup `Γ(2)` of `SL(2, ℤ)` is generated by `-I`, `T² = (1 2; 0 1)`
and its lower-triangular counterpart `T′² = (1 0; 2 1)`, where `T′ = (1 0; 1 1)` is
`TauCeti.ModularGroup.tPrime`. Since `T′² = S T⁻² S⁻¹` (`TauCeti.ModularGroup.tPrime_sq_eq`), a
function on the upper half-plane is invariant under `Γ(2)` as soon as it is invariant under
`τ ↦ τ + 2` and under the conjugate of `τ ↦ τ - 2` by `S : τ ↦ -1/τ`.

The proof is read off from the Farey symbol of `Γ(2)`: by
`TauCeti.FareySymbol.comap_group_gammaTwo`, `Γ(2)` is the preimage of the group of
`TauCeti.FareySymbol.gammaTwo`, whose two free generators are `-T²` and `-(3 -2; 2 -1) = T² T′⁻²`,
and `TauCeti.FareySymbol.comap_group_gammaTwo_le` puts that preimage inside any subgroup
containing `-1` and these two generators.

## Main results

* `CongruenceSubgroup.Gamma_two_eq_closure`: `Γ(2) = ⟨-I, T², T′²⟩`.

## References

* R. S. Kulkarni, *An arithmetic-geometric method in the study of the subgroups of the modular
  group*, Amer. J. Math. **113** (1991), no. 6, 1053–1133, §§2–3 (generators of a subgroup read
  off from its Farey symbol).
-/

public section

open ModularGroup TauCeti.ModularGroup TauCeti.FareySymbol
open scoped MatrixGroups

namespace CongruenceSubgroup

/-- `Γ(2)` is generated by `-I`, `T² = (1 2; 0 1)` and `T′² = (1 0; 2 1)`. -/
theorem Gamma_two_eq_closure :
    Gamma 2 = Subgroup.closure {-1, T ^ 2, tPrime ^ 2} := by
  set H := Subgroup.closure ({-1, T ^ 2, tPrime ^ 2} : Set SL(2, ℤ))
  have hle : H ≤ Gamma 2 := by
    rw [Subgroup.closure_le]
    rintro g (rfl | rfl | rfl)
    · exact Gamma_mem.mpr (by decide)
    · exact Gamma_mem.mpr (by decide)
    · rw [SetLike.mem_coe, Gamma_mem, coe_tPrime_sq]
      decide
  have hneg1 : (-1 : SL(2, ℤ)) ∈ H := Subgroup.subset_closure (by simp)
  have hT : T ^ 2 ∈ H := Subgroup.subset_closure (by simp)
  have hT' : tPrime ^ 2 ∈ H := Subgroup.subset_closure (by simp)
  -- The inner free generator `-(3 -2; 2 -1)` of `gammaTwo` is `T² T′⁻²`.
  have hinner : gammaTwo.freeSideSL ⟨1, by simp⟩ ⟨2, by simp⟩ = T ^ 2 * (tPrime ^ 2)⁻¹ := by
    ext i j
    rw [coe_freeSideSL_gammaTwo_inner, Matrix.SpecialLinearGroup.coe_mul,
      Matrix.SpecialLinearGroup.coe_inv, coe_tPrime_sq]
    fin_cases i <;> fin_cases j <;>
      simp [sq, Matrix.mul_apply, Fin.sum_univ_two, ModularGroup.coe_T, Matrix.adjugate_fin_two]
  refine le_antisymm ?_ hle
  rw [← comap_group_gammaTwo]
  exact comap_group_gammaTwo_le hneg1 (neg_eq_neg_one_mul (T ^ 2) ▸ mul_mem hneg1 hT)
    (hinner ▸ mul_mem hT (inv_mem hT'))

end CongruenceSubgroup
