module

public import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups
public import TauCeti.NumberTheory.Modular.Relations
import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.ModularGroup

/-!
# Generators of the principal congruence subgroup `Γ(2)`

The principal congruence subgroup `Γ(2)` of `SL(2, ℤ)` is generated by `-I`, `T² = (1 2; 0 1)`
and its lower-triangular counterpart `T′² = (1 0; 2 1)`, where `T′ = (1 0; 1 1)` is
`TauCeti.ModularGroup.tPrime`. Since `T′² = S T⁻² S⁻¹`, a function on the upper half-plane is
invariant under `Γ(2)` as soon as it is invariant under `τ ↦ τ + 2` and under the conjugate of
`τ ↦ τ - 2` by `S : τ ↦ -1/τ`.

The proof applies `TauCeti.Matrix.SpecialLinearGroup.eq_of_le_of_perm_S_T` to the six cosets of
`Γ(2)` in `SL(2, ℤ)`, represented by `1, S, T, S T, T S, S T S`, with the coset permutations of
`TauCeti.FareySymbol.comap_group_gammaTwo`, which identifies `Γ(2)` with the preimage of the group
of a Farey symbol rather than with an explicit closure.

## Main results

* `CongruenceSubgroup.Gamma_two_eq_closure`: `Γ(2) = ⟨-I, T², T′²⟩`.
* `TauCeti.ModularGroup.tPrime_sq_eq`: `T′² = S T⁻² S⁻¹`.

## References

* T. M. Apostol, *Modular Functions and Dirichlet Series in Number Theory*, 2nd ed., §2.3
  (generators of `Γ(2)`, with the modular `λ` function as its Hauptmodul).
-/

public section

open ModularGroup TauCeti.ModularGroup
open scoped MatrixGroups

namespace TauCeti.ModularGroup

/-- `T′² = (1 0; 2 1)` is the conjugate `S T⁻² S⁻¹` of the translation by `-2`. -/
theorem tPrime_sq_eq : tPrime ^ 2 = S * T ^ (-2 : ℤ) * S⁻¹ := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [sq, Matrix.mul_apply, Fin.sum_univ_two, ModularGroup.coe_S,
      Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]

end TauCeti.ModularGroup

namespace CongruenceSubgroup

/-- `Γ(2)` is generated by `-I`, `T² = (1 2; 0 1)` and `T′² = (1 0; 2 1)`. -/
theorem Gamma_two_eq_closure :
    Gamma 2 = Subgroup.closure {-1, T ^ 2, tPrime ^ 2} := by
  -- `tPrime` is opaque to `decide`, so name the matrix of `T′²` explicitly.
  let L : SL(2, ℤ) := .mk !![1, 0; 2, 1] (by decide)
  have hL : tPrime ^ 2 = L := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [L, sq, Matrix.mul_apply, Fin.sum_univ_two]
  rw [hL]
  set H := Subgroup.closure ({-1, T ^ 2, L} : Set SL(2, ℤ))
  have hle : H ≤ Gamma 2 := by
    rw [Subgroup.closure_le]
    rintro g (rfl | rfl | rfl) <;> exact Gamma_mem.mpr (by decide)
  have hneg1 : (-1 : SL(2, ℤ)) ∈ H := Subgroup.subset_closure (by simp)
  have ha : -(T ^ 2) ∈ H :=
    neg_one_mul (T ^ 2) ▸ mul_mem hneg1 (Subgroup.subset_closure (by simp))
  -- `-(3 -2; 2 -1) = T² T′⁻²`, the second free generator of the Farey symbol of `Γ(2)`.
  have hb : T ^ 2 * L⁻¹ ∈ H :=
    mul_mem (Subgroup.subset_closure (by simp)) (inv_mem (Subgroup.subset_closure (by simp)))
  have e {x y : SL(2, ℤ)} (hxy : x = y) (hy : y ∈ H) : x ∈ H := hxy ▸ hy
  refine (TauCeti.Matrix.SpecialLinearGroup.eq_of_le_of_perm_S_T hle
    ![1, S, T, S * T, T * S, S * T * S] rfl
    (fun i hi ↦ by fin_cases i <;> first | rfl | exact absurd (Gamma_mem.mp hi) (by decide))
    ⟨Equiv.swap 0 1 * Equiv.swap 2 3 * Equiv.swap 4 5, fun i ↦ by fin_cases i <;>
      first | exact e (by decide) (one_mem H) | exact e (by decide) hneg1⟩
    ⟨Equiv.swap 0 2 * Equiv.swap 1 4 * Equiv.swap 3 5, fun i ↦ by fin_cases i <;>
      first | exact e (by decide) (one_mem H) | exact e (by decide) (mul_mem hneg1 ha) |
        exact e (by decide) (mul_mem (inv_mem hb) ha) |
        exact e (by decide) (mul_mem (mul_mem hneg1 (inv_mem ha)) hb) |
        exact e (by decide) (mul_mem hneg1 (inv_mem ha))⟩).symm

end CongruenceSubgroup
