module

public import TauCeti.NumberTheory.ModularForms.CongruenceSubgroups.Basic
public import TauCeti.NumberTheory.ModularForms.CongruenceSubgroups.Fuchsian
public import TauCeti.NumberTheory.ModularForms.LevelOne.FunctionField

/-!
# The field of modular functions of level `N` with cyclotomic Fourier coefficients

Let `X(N)` be the compactified modular curve of level `N`, the compactified quotient of the upper
half-plane by the effective image of the principal congruence subgroup `Γ(N)`. A meromorphic
function on `X(N)` has a Laurent expansion at the cusp `∞` in the parameter
`q = exp (2πiτ / N)`, read through the normalized cusp datum `TauCeti.cuspDatumInftyGamma` of
width `N`. The field `F_N` is the field of meromorphic functions on `X(N)` whose expansion at `∞`
has all its coefficients in the `N`-th cyclotomic field `ℚ(ζ_N)`, here the subfield of `ℂ`
generated by the `N`-th roots of unity (`TauCeti.modularFunctionField`). Its field operations,
values and orders at the cusp, and `q`-expansion principle are those of
`Subgroup.CompactifiedQuotient.coeffSubfield`.

For `M ∣ N` the inclusion `Γ(N) ≤ Γ(M)` induces a map `X(N) → X(M)`, along which meromorphic
functions pull back. The cusp `∞` has width `M` on `X(M)` and `N` on `X(N)` in the same scaling, so
pulling back substitutes `q_M = q_N ^ (N / M)` in the expansion at `∞`. Since moreover
`ℚ(ζ_M) ⊆ ℚ(ζ_N)`, pulling back embeds `F_M` into `F_N`. In the same way pulling back along
`X(N) → X(1)` carries the level-one field `ℚ(j)` of
`TauCeti.ModularGroup.coeffSubfield_cuspDatumInfty_bot` into `F_N`; in particular `j` is a modular
function of every level.

## Main declarations

* `TauCeti.modularFunctionField`: the field `F_N`.
* `TauCeti.mem_modularFunctionField`: membership in `F_N` through the expansion at `∞`.
* `TauCeti.compactifiedQuotientComap_mem_modularFunctionField_iff`: the pullback from `X(M)`,
  for `M ∣ N`, lies in `F_N` exactly when its expansion at `∞` has coefficients in `ℚ(ζ_N)`.
* `TauCeti.compactifiedQuotientComap_mem_modularFunctionField`: the level map `F_M → F_N`.
* `TauCeti.compactifiedQuotientComap_mem_modularFunctionField_of_mem_coeffSubfield_bot`: the level
  map `ℚ(j) = F_1 → F_N` from the level-one curve.
* `TauCeti.modularFunctionFieldMap` and `TauCeti.modularFunctionFieldMapOfLevelOne`: the level maps
  `F_M →+* F_N` and `ℚ(j) →+* F_N`, bundled as ring homomorphisms, with their identity and
  composition laws.

## References

* Goro Shimura, *Introduction to the Arithmetic Theory of Automorphic Functions*, Princeton
  University Press, 1971, §6.1.
* Serge Lang, *Elliptic Functions*, 2nd ed., Graduate Texts in Mathematics 112, Springer, 1987,
  Chapter 6, §3.
-/

public noncomputable section

open CongruenceSubgroup Subgroup.CompactifiedQuotient TauCeti.RiemannSurface
open scoped MatrixGroups

namespace TauCeti

/-- **The field `F_N` of modular functions of level `N` with coefficients in `ℚ(ζ_N)`**: the
meromorphic functions on the compactified modular curve `X(N)` whose Laurent expansion at the cusp
`∞`, in `q = exp (2πiτ / N)`, has all its coefficients in the subfield of `ℂ` generated by the
`N`-th roots of unity. -/
def modularFunctionField (N : ℕ) [NeZero N] :
    Subfield (MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient) :=
  coeffSubfield (cuspDatumInftyGamma N) (Subfield.closure {z : ℂ | z ^ N = 1})

variable {M N : ℕ} [NeZero M] [NeZero N]

/-- `F_N` is the subfield of the meromorphic functions on `X(N)` with coefficients in `ℚ(ζ_N)`
at the normalized cusp datum of `∞`. -/
theorem modularFunctionField_def :
    modularFunctionField N =
      coeffSubfield (cuspDatumInftyGamma N) (Subfield.closure {z : ℂ | z ^ N = 1}) := by
  rw [modularFunctionField]

/-- A meromorphic function on `X(N)` lies in `F_N` exactly when every coefficient of its Laurent
expansion at `∞` lies in `ℚ(ζ_N)`. -/
theorem mem_modularFunctionField
    {F : MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient} :
    F ∈ modularFunctionField N ↔ ∀ n,
      (laurentQExpansion (cuspDatumInftyGamma N) F).coeff n ∈
        Subfield.closure {z : ℂ | z ^ N = 1} :=
  mem_coeffSubfield _

/-- The constants in `F_N` are exactly the elements of `ℚ(ζ_N)`. -/
@[simp]
theorem algebraMap_mem_modularFunctionField {c : ℂ} :
    algebraMap ℂ (MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient) c ∈
      modularFunctionField N ↔ c ∈ Subfield.closure {z : ℂ | z ^ N = 1} :=
  algebraMap_mem_coeffSubfield _

/-- **The pullback from `X(M)` to `X(N)`, for `M ∣ N`.** The pullback of a meromorphic function
`F` on `X(M)` lies in `F_N` exactly when the Laurent expansion of `F` at `∞`, of width `M`, has
its coefficients in `ℚ(ζ_N)`. -/
theorem compactifiedQuotientComap_mem_modularFunctionField_iff (h : M ∣ N)
    {F : MeromorphicFunction ((Gamma M).map sl2zToPSL2R).CompactifiedQuotient} :
    Subgroup.compactifiedQuotientComap (Subgroup.map_mono (Gamma_le_Gamma_of_dvd h)) F ∈
        modularFunctionField N ↔
      F ∈ coeffSubfield (cuspDatumInftyGamma M) (Subfield.closure {z : ℂ | z ^ N = 1}) :=
  compactifiedQuotientComap_mem_coeffSubfield_iff _ (by simp)

/-- **The level map `F_M → F_N`, for `M ∣ N`.** Pulling back along `X(N) → X(M)` carries modular
functions of level `M` with coefficients in `ℚ(ζ_M)` to modular functions of level `N` with
coefficients in `ℚ(ζ_N)`. -/
theorem compactifiedQuotientComap_mem_modularFunctionField (h : M ∣ N)
    {F : MeromorphicFunction ((Gamma M).map sl2zToPSL2R).CompactifiedQuotient}
    (hF : F ∈ modularFunctionField M) :
    Subgroup.compactifiedQuotientComap (Subgroup.map_mono (Gamma_le_Gamma_of_dvd h)) F ∈
      modularFunctionField N := by
  -- the `M`-th roots of unity are `N`-th roots of unity, so `ℚ(ζ_M) ⊆ ℚ(ζ_N)`
  obtain ⟨k, rfl⟩ := h
  refine (compactifiedQuotientComap_mem_modularFunctionField_iff ⟨k, rfl⟩).mpr
    (coeffSubfield_mono _ (Subfield.closure_mono fun z hz ↦ ?_) hF)
  rw [Set.mem_ofPred_eq] at hz ⊢
  rw [pow_mul, hz, one_pow]

/-- **The pullback from `X(1)` to `X(N)`.** The pullback of a meromorphic function `F` on the
level-one curve lies in `F_N` exactly when the `q`-expansion of `F` has its coefficients in
`ℚ(ζ_N)`. -/
theorem compactifiedQuotientComap_levelOne_mem_modularFunctionField_iff
    {F : MeromorphicFunction psl2zToPSL2R.range.CompactifiedQuotient} :
    Subgroup.compactifiedQuotientComap (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R F ∈
        modularFunctionField N ↔
      F ∈ coeffSubfield ModularGroup.cuspDatumInfty (Subfield.closure {z : ℂ | z ^ N = 1}) :=
  compactifiedQuotientComap_mem_coeffSubfield_iff _ (by simp)

/-- **The level map `ℚ(j) → F_N`.** Pulling back along `X(N) → X(1)` carries the level-one
modular functions with rational `q`-expansion, the field
`ℚ(j)` (`TauCeti.ModularGroup.coeffSubfield_cuspDatumInfty_bot`), into `F_N`. -/
theorem compactifiedQuotientComap_mem_modularFunctionField_of_mem_coeffSubfield_bot
    {F : MeromorphicFunction psl2zToPSL2R.range.CompactifiedQuotient}
    (hF : F ∈ coeffSubfield ModularGroup.cuspDatumInfty ⊥) :
    Subgroup.compactifiedQuotientComap (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R F ∈
      modularFunctionField N :=
  compactifiedQuotientComap_levelOne_mem_modularFunctionField_iff.mpr
    (coeffSubfield_mono _ bot_le hF)

/-- The modular invariant `j`, pulled back to `X(N)`, lies in `F_N`. -/
theorem compactifiedQuotientComap_jMeromorphicFunction_mem_modularFunctionField :
    Subgroup.compactifiedQuotientComap (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R
      ModularGroup.jMeromorphicFunction ∈ modularFunctionField N :=
  compactifiedQuotientComap_mem_modularFunctionField_of_mem_coeffSubfield_bot
    (ModularGroup.jMeromorphicFunction_mem_coeffSubfield ⊥)

/-- **The level map `F_M →+* F_N`, for `M ∣ N`**, bundled as a ring homomorphism: the pullback
along `X(N) → X(M)`, restricted to `F_M` and corestricted to `F_N`. -/
def modularFunctionFieldMap (h : M ∣ N) : modularFunctionField M →+* modularFunctionField N :=
  (Subgroup.compactifiedQuotientComap
    (Subgroup.map_mono (Gamma_le_Gamma_of_dvd h))).toRingHom.restrict _ _
    fun _ hF ↦ compactifiedQuotientComap_mem_modularFunctionField h hF

/-- The level map `F_M →+* F_N` is the pullback along `X(N) → X(M)`. -/
@[simp]
theorem coe_modularFunctionFieldMap_apply (h : M ∣ N) (F : modularFunctionField M) :
    (modularFunctionFieldMap h F :
        MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient) =
      Subgroup.compactifiedQuotientComap (Subgroup.map_mono (Gamma_le_Gamma_of_dvd h)) F :=
  RingHom.coe_restrict_apply ..

/-- The level map `F_M →+* F_N` is injective. -/
theorem modularFunctionFieldMap_injective (h : M ∣ N) :
    Function.Injective (modularFunctionFieldMap h) :=
  (modularFunctionFieldMap h).injective

/-- The level map `F_N →+* F_N` is the identity. -/
@[simp]
theorem modularFunctionFieldMap_refl :
    modularFunctionFieldMap (dvd_refl N) = RingHom.id (modularFunctionField N) :=
  RingHom.ext fun _ ↦ Subtype.ext (Subgroup.compactifiedQuotientComap_refl _)

/-- **Functoriality of the level maps.** For `L ∣ M ∣ N`, the level map `F_L →+* F_N` is the
composite of the level maps `F_L →+* F_M` and `F_M →+* F_N`. -/
theorem modularFunctionFieldMap_comp {L : ℕ} [NeZero L] (h : L ∣ M) (k : M ∣ N) :
    (modularFunctionFieldMap k).comp (modularFunctionFieldMap h) =
      modularFunctionFieldMap (h.trans k) :=
  RingHom.ext fun _ ↦ Subtype.ext (Subgroup.compactifiedQuotientComap_trans _ _ _).symm

/-- **The level map `ℚ(j) →+* F_N`**, bundled as a ring homomorphism: the pullback along
`X(N) → X(1)`, restricted to the level-one field `ℚ(j)`
(`TauCeti.ModularGroup.coeffSubfield_cuspDatumInfty_bot`) and corestricted to `F_N`. -/
def modularFunctionFieldMapOfLevelOne (N : ℕ) [NeZero N] :
    coeffSubfield ModularGroup.cuspDatumInfty ⊥ →+* modularFunctionField N :=
  (Subgroup.compactifiedQuotientComap
    (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R).toRingHom.restrict _ _
    fun _ hF ↦ compactifiedQuotientComap_mem_modularFunctionField_of_mem_coeffSubfield_bot hF

/-- The level map `ℚ(j) →+* F_N` is the pullback along `X(N) → X(1)`. -/
@[simp]
theorem coe_modularFunctionFieldMapOfLevelOne_apply
    (F : coeffSubfield ModularGroup.cuspDatumInfty ⊥) :
    (modularFunctionFieldMapOfLevelOne N F :
        MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient) =
      Subgroup.compactifiedQuotientComap (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R F :=
  RingHom.coe_restrict_apply ..

/-- The level map `ℚ(j) →+* F_N` is injective. -/
theorem modularFunctionFieldMapOfLevelOne_injective :
    Function.Injective (modularFunctionFieldMapOfLevelOne N) :=
  (modularFunctionFieldMapOfLevelOne N).injective

/-- For `M ∣ N`, the level map `ℚ(j) →+* F_N` factors through the level map
`ℚ(j) →+* F_M`. -/
theorem modularFunctionFieldMap_comp_modularFunctionFieldMapOfLevelOne (h : M ∣ N) :
    (modularFunctionFieldMap h).comp (modularFunctionFieldMapOfLevelOne M) =
      modularFunctionFieldMapOfLevelOne N :=
  RingHom.ext fun _ ↦ Subtype.ext (Subgroup.compactifiedQuotientComap_trans _ _ _).symm

end TauCeti
