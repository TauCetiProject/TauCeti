module

public import TauCeti.Analysis.Complex.Fuchsian.LevelOne.Basic

/-!
# Elliptic points of subgroups of the modular group

Let `Γ ≤ SL(2, ℤ)`. Its effective image `Γ.map sl2zToPSL2R` in `PSL(2, ℝ)` is the group whose
quotient is the analytic modular curve of `Γ`, and its point stabilizers are the elliptic data
of that curve. They are subgroups of the level-one stabilizers, so every elliptic point of `Γ`
lies in the `SL(2, ℤ)`-orbit of `i` or of `ρ`, and its order divides `2` or `3`.

At the translate `γ • i` the level-one stabilizer is generated by the conjugate `γ S γ⁻¹`, so the
stabilizer in `Γ` has order `2` if `γ S γ⁻¹ ∈ Γ` and is trivial otherwise. At `γ • ρ` the same
holds with order `3` for the conjugate of the order-three element `T⁻¹ S`; the other
noncentral stabilizing matrices are `± S T` and `-T⁻¹ S`, and each has `T⁻¹ S` as a power.
These criteria turn the elliptic-point counts of a congruence subgroup into congruence
conditions on the bottom row of `γ`.

## Main results

* `TauCeti.card_stabilizer_map_smul_I`: the stabilizer order at `γ • i`.
* `TauCeti.card_stabilizer_map_smul_ρ`: the stabilizer order at `γ • ρ`.
* `TauCeti.card_stabilizer_map_eq_one_of_orbit_ne`: off the orbits of `i` and `ρ` the stabilizer
  is trivial.
* `TauCeti.orbitRel_map_sl2zToPSL2R_iff`: the orbits of the effective image are those of `Γ`.

## References

* F. Diamond and J. Shurman, *A First Course in Modular Forms*, §2.3.
-/

public section

open Matrix Matrix.SpecialLinearGroup MulAction UpperHalfPlane ModularGroup TauCeti.ModularGroup
open scoped MatrixGroups

namespace TauCeti

variable (Γ : Subgroup SL(2, ℤ))

/-- The `SL(2, ℤ)`-action on `ℍ` factors through `sl2zToPSL2R`. -/
private theorem sl2zToPSL2R_smul (g : SL(2, ℤ)) (z : ℍ) : sl2zToPSL2R g • z = g • z := by
  rw [← psl2zToPSL2R_mk, psl2zToPSL2R_smul, pslMk_smul]

/-- The image of `Γ` acts inside the effective level-one group. -/
private theorem map_sl2zToPSL2R_le_range : Γ.map sl2zToPSL2R ≤ psl2zToPSL2R.range :=
  range_sl2zToPSL2R_eq_range_psl2zToPSL2R ▸ Subgroup.map_le_range sl2zToPSL2R Γ

/-- **Orbits of the effective image of `Γ`** are the orbits of `Γ` itself: two points are related
exactly when an element of `Γ` carries one to the other. -/
theorem orbitRel_map_sl2zToPSL2R_iff {z w : ℍ} :
    orbitRel (Γ.map sl2zToPSL2R) ℍ z w ↔ ∃ g ∈ Γ, g • w = z := by
  rw [orbitRel_apply, mem_orbit_iff]
  constructor
  · rintro ⟨⟨_, g, hg, rfl⟩, h⟩
    exact ⟨g, hg, by rwa [Subgroup.smul_def, sl2zToPSL2R_smul] at h⟩
  · rintro ⟨g, hg, h⟩
    exact ⟨⟨sl2zToPSL2R g, Subgroup.mem_map_of_mem _ hg⟩,
      by rwa [Subgroup.smul_def, sl2zToPSL2R_smul]⟩

/-- Conjugation by an element of `SL(2, ℤ)` preserves its center. -/
private theorem conj_mem_center_iff (γ s : SL(2, ℤ)) :
    γ * s * γ⁻¹ ∈ Subgroup.center SL(2, ℤ) ↔ s ∈ Subgroup.center SL(2, ℤ) :=
  (Subgroup.mem_normalizer_iff.mp
    ((Subgroup.normalizer_eq_top (H := Subgroup.center SL(2, ℤ))) ▸ Subgroup.mem_top γ) s).symm

open scoped Classical in
/-- **Elliptic stabilizers in `Γ` through a generating conjugate.** Let `z₀` have level-one
elliptic order a prime `p`, and let `E` be a noncentral matrix fixing `z₀` which is a power of
every noncentral matrix fixing `z₀`. Then the stabilizer of `γ • z₀` in the image of `Γ` has
order `p` when `γ E γ⁻¹ ∈ Γ`, and is trivial otherwise. -/
private theorem card_stabilizer_map_smul_of_zpow {z₀ : ℍ} {E : SL(2, ℤ)} {p : ℕ} (hp : p.Prime)
    (horder : ellipticOrder (Quotient.mk'' z₀) = p) (hE : E • z₀ = z₀)
    (hEc : E ∉ Subgroup.center SL(2, ℤ))
    (hgen : ∀ s : SL(2, ℤ), s • z₀ = z₀ → s ∉ Subgroup.center SL(2, ℤ) → ∃ k : ℤ, s ^ k = E)
    (γ : SL(2, ℤ)) :
    Nat.card (stabilizer (Γ.map sl2zToPSL2R) (γ • z₀)) = if γ * E * γ⁻¹ ∈ Γ then p else 1 := by
  have hR : Nat.card (stabilizer psl2zToPSL2R.range (γ • z₀)) = p := by
    rw [card_stabilizer_psl2zToPSL2RRange_eq_card_stabilizer_psl, ← ellipticOrder_mk,
      show (Quotient.mk'' (γ • z₀) : orbitRel.Quotient SL(2, ℤ) ℍ) = Quotient.mk'' z₀ from
        Quotient.sound' ⟨γ, rfl⟩, horder]
  have hdvd := Subgroup.card_stabilizer_dvd_card_stabilizer (map_sl2zToPSL2R_le_range Γ) (γ • z₀)
  rw [hR] at hdvd
  -- the stabilizer is nontrivial exactly when the generating conjugate lies in `Γ`
  have hne : stabilizer (Γ.map sl2zToPSL2R) (γ • z₀) ≠ ⊥ ↔ γ * E * γ⁻¹ ∈ Γ := by
    constructor
    · intro h
      obtain ⟨⟨⟨_, h', hhΓ, rfl⟩, hfix⟩, hne1⟩ := (Subgroup.ne_bot_iff_exists_ne_one).mp h
      rw [mem_stabilizer_iff, Subgroup.smul_def, sl2zToPSL2R_smul] at hfix
      have hs : (γ⁻¹ * h' * γ) • z₀ = z₀ := by
        rw [mul_smul, mul_smul, hfix, inv_smul_smul]
      have hsc : γ⁻¹ * h' * γ ∉ Subgroup.center SL(2, ℤ) := by
        intro hc
        rw [← conj_mem_center_iff γ, show γ * (γ⁻¹ * h' * γ) * γ⁻¹ = h' by group,
          ← sl2zToPSL2R_ker, MonoidHom.mem_ker] at hc
        exact hne1 (Subtype.ext (Subtype.ext hc))
      obtain ⟨k, hk⟩ := hgen _ hs hsc
      rw [← hk, ← conj_zpow, show γ * (γ⁻¹ * h' * γ) * γ⁻¹ = h' by group]
      exact zpow_mem hhΓ k
    · intro h
      refine (Subgroup.ne_bot_iff_exists_ne_one).mpr
        ⟨⟨⟨sl2zToPSL2R (γ * E * γ⁻¹), Subgroup.mem_map_of_mem _ h⟩, ?_⟩, fun h1 ↦ hEc ?_⟩
      · rw [mem_stabilizer_iff, Subgroup.smul_def, sl2zToPSL2R_smul, mul_smul, mul_smul,
          inv_smul_smul, hE]
      · rw [← conj_mem_center_iff γ, ← sl2zToPSL2R_ker, MonoidHom.mem_ker]
        exact congrArg (fun x ↦ x.1.1) h1
  split_ifs with h
  · rcases hp.eq_one_or_self_of_dvd _ hdvd with h1 | hp'
    · exact absurd (Subgroup.card_eq_one.mp h1) (hne.mpr h)
    · exact hp'
  · exact Subgroup.card_eq_one.mpr (not_not.mp (mt hne.mp h))

open scoped Classical in
/-- **The elliptic points of order two.** The stabilizer of `γ • i` in the effective image of `Γ`
has order `2` when `γ S γ⁻¹ ∈ Γ`, and is trivial otherwise. -/
theorem card_stabilizer_map_smul_I (γ : SL(2, ℤ)) :
    Nat.card (stabilizer (Γ.map sl2zToPSL2R) (γ • I)) = if γ * S * γ⁻¹ ∈ Γ then 2 else 1 := by
  refine card_stabilizer_map_smul_of_zpow Γ Nat.prime_two ellipticOrder_I
    (stabilizer_I.mpr (by simp)) ?_ ?_ γ
  · rw [mem_center_iff_eq_one_or_eq_neg_one]
    decide
  · intro s hs hsc
    rw [mem_center_iff_eq_one_or_eq_neg_one] at hsc
    have hmem := stabilizer_I.mp hs
    simp only [Finset.mem_insert, Finset.mem_singleton] at hmem
    rcases hmem with rfl | rfl | rfl | rfl
    · exact absurd (Or.inl rfl) hsc
    · exact absurd (Or.inr rfl) hsc
    · exact ⟨1, zpow_one S⟩
    · exact ⟨-1, by decide⟩

open scoped Classical in
/-- **The elliptic points of order three.** The stabilizer of `γ • ρ` in the effective image of
`Γ` has order `3` when `γ (T⁻¹ S) γ⁻¹ ∈ Γ`, and is trivial otherwise. -/
theorem card_stabilizer_map_smul_ρ (γ : SL(2, ℤ)) :
    Nat.card (stabilizer (Γ.map sl2zToPSL2R) (γ • ρ)) =
      if γ * (T⁻¹ * S) * γ⁻¹ ∈ Γ then 3 else 1 := by
  refine card_stabilizer_map_smul_of_zpow Γ Nat.prime_three ellipticOrder_ρ
    (stabilizer_ρ.mpr (by simp)) ?_ ?_ γ
  · rw [mem_center_iff_eq_one_or_eq_neg_one]
    decide
  · intro s hs hsc
    rw [mem_center_iff_eq_one_or_eq_neg_one] at hsc
    have hmem := stabilizer_ρ.mp hs
    simp only [Finset.mem_insert, Finset.mem_singleton] at hmem
    rcases hmem with rfl | rfl | rfl | rfl | rfl | rfl
    · exact absurd (Or.inl rfl) hsc
    · exact absurd (Or.inr rfl) hsc
    · exact ⟨2, by decide⟩
    · exact ⟨2, by decide⟩
    · exact ⟨1, zpow_one _⟩
    · exact ⟨4, by decide⟩

/-- **Off the two elliptic orbits the stabilizer is trivial**: a point of `ℍ` outside the
`SL(2, ℤ)`-orbits of `i` and `ρ` has trivial stabilizer in the effective image of `Γ`. -/
theorem card_stabilizer_map_eq_one_of_orbit_ne {z : ℍ}
    (hI : (Quotient.mk'' z : orbitRel.Quotient SL(2, ℤ) ℍ) ≠ Quotient.mk'' I)
    (hρ : (Quotient.mk'' z : orbitRel.Quotient SL(2, ℤ) ℍ) ≠ Quotient.mk'' ρ) :
    Nat.card (stabilizer (Γ.map sl2zToPSL2R) z) = 1 := by
  have hdvd := Subgroup.card_stabilizer_dvd_card_stabilizer (map_sl2zToPSL2R_le_range Γ) z
  rwa [card_stabilizer_psl2zToPSL2RRange_eq_card_stabilizer_psl, ← ellipticOrder_mk,
    ellipticOrder_eq_one_of_orbit_ne_I_of_orbit_ne_ρ hI hρ, Nat.dvd_one] at hdvd

end TauCeti
