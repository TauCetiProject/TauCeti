module

public import TauCeti.NumberTheory.ModularForms.CongruenceSubgroups.FunctionField.Basic
public import TauCeti.NumberTheory.ModularForms.QExpansion.LinearDisjoint
import Mathlib.Algebra.Group.Subgroup.Finite
import Mathlib.FieldTheory.RatFunc.IntermediateField
import TauCeti.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Finiteness of arithmetic modular function fields over `K(j)`

For every subfield `K` of `ℂ`, the meromorphic functions on `X(N)` whose Laurent expansion at
`∞` has coefficients in `K` form a finite extension of `K(j)`. Its degree is bounded by the
order of the image of the complex `SL(2, ℤ/Nℤ)` action. In particular this applies to the
arithmetic modular function field `F_N`, by taking `K = ℚ(ζ_N)`.

The upper bound combines two facts: the complex function field is finite over its fixed field
`ℂ(j)` by Artin's theorem, and linear disjointness of the coefficient field from `ℂ` preserves
linear independence after adjoining `j`. This does not require stability of the arithmetic
field under the complex modular action. The bound can therefore be used to identify an
explicit subfield of generators once its degree reaches the complex degree.

## References

* Goro Shimura, *Introduction to the Arithmetic Theory of Automorphic Functions*, Princeton
  University Press, 1971, §6.1.
-/

public noncomputable section

open CongruenceSubgroup MulOpposite Subgroup.CompactifiedQuotient
open TauCeti.RiemannSurface
open scoped MatrixGroups IntermediateField

namespace TauCeti

variable (N : ℕ) [NeZero N] (K : Subfield ℂ)

/-- The modular invariant `j` in the field of level-`N` functions with coefficients in `K`.
Its coefficients are integers, so every subfield of `ℂ` is allowed. -/
def modularFunctionJ : coeffIntermediateField (cuspDatumInftyGamma N) K :=
  ⟨Subgroup.compactifiedQuotientComap (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R
      ModularGroup.jMeromorphicFunction,
    (mem_coeffIntermediateField).mpr <|
      (compactifiedQuotientComap_mem_coeffSubfield_iff
        (D := cuspDatumInftyGamma N) _ (by simp)).mpr
        (ModularGroup.jMeromorphicFunction_mem_coeffSubfield K)⟩

/-- As a complex meromorphic function, `modularFunctionJ` is the pullback of `j` from `X(1)`. -/
@[simp]
theorem coe_modularFunctionJ :
    (modularFunctionJ N K :
        MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient) =
      Subgroup.compactifiedQuotientComap (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R
        ModularGroup.jMeromorphicFunction :=
  (rfl)

/-- The modular invariant is transcendental over the coefficient field. Thus adjoining it
gives a rational function field over `K`. -/
theorem transcendental_modularFunctionJ : Transcendental K (modularFunctionJ N K) := by
  let φ := Subgroup.compactifiedQuotientComap
    (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R
  have h : Transcendental ℂ (φ ModularGroup.jMeromorphicFunction) :=
    fun ha ↦ ModularGroup.transcendental_jMeromorphicFunction
      ((isAlgebraic_algHom_iff φ φ.injective).mp ha)
  have hK := h.restrictScalars (R := K) (algebraMap K ℂ).injective
  intro ha
  apply hK
  simpa only [IntermediateField.coe_val, coe_modularFunctionJ] using ha.algHom
    (coeffIntermediateField (cuspDatumInftyGamma N) K).val

/-- The complex fixed field of the modular action is generated by the pullback of `j`. -/
theorem adjoin_coe_modularFunctionJ_eq_fixedField :
    IntermediateField.adjoin ℂ
        {(modularFunctionJ N K :
          MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient)} =
      IntermediateField.fixedField (modularFunctionActionZMod N).range.unop := by
  let φ := Subgroup.compactifiedQuotientComap
    (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R
  have hφ : (φ.comp ModularGroup.jRatFuncEquiv.toAlgHom).fieldRange =
      IntermediateField.adjoin ℂ {φ ModularGroup.jMeromorphicFunction} := by
    rw [AlgHom.fieldRange_eq_map, ← RatFunc.adjoin_X, IntermediateField.adjoin_map]
    simp
  rw [coe_modularFunctionJ, fixedField_unop_range_modularFunctionActionZMod, ← hφ]
  ext F
  simp only [AlgHom.mem_fieldRange, AlgHom.comp_apply]
  exact ⟨fun ⟨r, hr⟩ ↦ ⟨_, hr⟩, fun ⟨G, hG⟩ ↦
    ⟨ModularGroup.jRatFuncEquiv.symm G, by simpa using hG⟩⟩

/-- The image of the modular action is finite, including after reversing the right action. -/
instance finite_unop_range_modularFunctionActionZMod :
    Finite (modularFunctionActionZMod N).range.unop := by
  classical
  exact Finite.of_injective
    (fun g ↦ (⟨op g.1, g.2⟩ : (modularFunctionActionZMod N).range))
    (fun a b h ↦ Subtype.ext (MulOpposite.op_injective (congrArg Subtype.val h)))

/-- The complex function field is finite over the field generated by `j`. -/
instance finiteDimensional_adjoin_coe_modularFunctionJ :
    FiniteDimensional
      (IntermediateField.adjoin ℂ {(modularFunctionJ N K :
        MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient)})
      (MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient) := by
  rw [adjoin_coe_modularFunctionJ_eq_fixedField]
  exact inferInstanceAs (FiniteDimensional
    (FixedPoints.subfield (modularFunctionActionZMod N).range.unop
      (MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient)) _)

/-- The complex degree of `X(N)` over `ℂ(j)` is the order of the image of its modular action.
The use of the image accounts for the trivial action of `-I`, also when `N = 2`. -/
theorem finrank_adjoin_coe_modularFunctionJ :
    Module.finrank
        (IntermediateField.adjoin ℂ {(modularFunctionJ N K :
          MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient)})
        (MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient) =
      Nat.card (modularFunctionActionZMod N).range.unop := by
  classical
  let : Fintype (modularFunctionActionZMod N).range.unop := Fintype.ofFinite _
  rw [adjoin_coe_modularFunctionJ_eq_fixedField]
  exact FixedPoints.finrank_eq_card _ _ |>.trans (Nat.card_eq_fintype_card.symm)

/-- Extending the constants to `ℂ` bounds the degree over `K(j)` by the complex modular degree. -/
theorem rank_adjoin_modularFunctionJ_le :
    Module.rank (K⟮modularFunctionJ N K⟯)
        (coeffIntermediateField (cuspDatumInftyGamma N) K) ≤
      Nat.card (modularFunctionActionZMod N).range.unop := by
  classical
  let : Fintype (modularFunctionActionZMod N).range.unop := Fintype.ofFinite _
  have h := (linearDisjoint_fieldRange_coeffIntermediateField
    (D := cuspDatumInftyGamma N) (K := K)).lift_rank_le_lift_rank_adjoin_algebraMap
      (K⟮modularFunctionJ N K⟯)
  rw [TauCeti.IntermediateField.range_algebraMap_adjoin_simple,
    IntermediateField.adjoin_adjoin_right, IntermediateField.algebraMap_apply] at h
  have hrank : Module.rank
      (IntermediateField.adjoin ℂ {(modularFunctionJ N K :
        MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient)})
      (MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient) =
      (Nat.card (modularFunctionActionZMod N).range.unop : Cardinal) := by
    rw [← Module.finrank_eq_rank, finrank_adjoin_coe_modularFunctionJ]
  simpa only [hrank, Cardinal.lift_natCast, Cardinal.lift_le_nat_iff] using h

/-- Functions of level `N` with coefficients in `K` form a finite extension of `K(j)`. -/
instance finiteDimensional_adjoin_modularFunctionJ :
    FiniteDimensional (K⟮modularFunctionJ N K⟯)
      (coeffIntermediateField (cuspDatumInftyGamma N) K) :=
  IsNoetherian.iff_fg.mp <| IsNoetherian.iff_rank_lt_aleph0.mpr
    ((rank_adjoin_modularFunctionJ_le N K).trans_lt Cardinal.natCast_lt_aleph0)

/-- The degree of the functions with coefficients in `K` over `K(j)` is at most the complex
modular degree. In particular this bounds `[F_N : ℚ(ζ_N)(j)]` without assuming arithmetic
stability under the modular action. -/
theorem finrank_adjoin_modularFunctionJ_le :
    Module.finrank (K⟮modularFunctionJ N K⟯)
        (coeffIntermediateField (cuspDatumInftyGamma N) K) ≤
      Nat.card (modularFunctionActionZMod N).range.unop := by
  rw [← Nat.cast_le (α := Cardinal), Module.finrank_eq_rank]
  exact rank_adjoin_modularFunctionJ_le N K

end TauCeti
