module

public import TauCeti.NumberTheory.ModularForms.CongruenceSubgroups.FunctionField.QExpansion
public import TauCeti.NumberTheory.ModularForms.CongruenceSubgroups.FunctionField.Degree
import TauCeti.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Arithmetic generation by Fricke functions

For any subfield `K` of `ℂ` containing the `N`-th roots of unity, the functions on `X(N)`
whose Laurent expansion at infinity, in `q = exp(2πiτ/N)`, has coefficients in `K`
are precisely `K(j, f_a : a ≠ 0)`. In particular the
arithmetic modular function field is `F_N = ℚ(ζ_N)(j, f_a : a ≠ 0)`.

The complex generation theorem and linear disjointness from the constants descend the
construction to `K`. This adapts the rank comparison in
`TauCeti.rank_adjoin_modularFunctionJ_le`, comparing ranks over the full Fricke generator
field rather than over `K(j)`. The resulting arithmetic action is constructed in
`TauCeti.NumberTheory.ModularForms.CongruenceSubgroups.FunctionField.Action`.

## References

* Goro Shimura, *Introduction to the Arithmetic Theory of Automorphic Functions*, Princeton
  University Press, 1971, §6.1.
-/

public noncomputable section

open CongruenceSubgroup MulOpposite Subgroup.CompactifiedQuotient
open TauCeti.RiemannSurface
open scoped Matrix MatrixGroups

namespace TauCeti

variable {N : ℕ} [NeZero N]

/-- Over `K`, the modular invariant `j` and the Fricke functions indexed by nonzero residues
generate all the level-`N` functions whose Laurent expansion at infinity, in
`q = exp(2πiτ/N)`, has coefficients in `K`, provided `K` contains the `N`-th roots of unity. -/
theorem adjoin_insert_image_frickeMeromorphicFunction_eq_coeffIntermediateField
    {K : Subfield ℂ} (hK : ∀ ζ : ℂ, ζ ^ N = 1 → ζ ∈ K) :
    IntermediateField.adjoin K (insert (Subgroup.compactifiedQuotientComap
        (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R ModularGroup.jMeromorphicFunction)
      (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0})) =
      coeffIntermediateField (cuspDatumInftyGamma N) K := by
  let B := coeffIntermediateField (cuspDatumInftyGamma N) K
  let S := insert (Subgroup.compactifiedQuotientComap
    (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R ModularGroup.jMeromorphicFunction)
    (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0})
  let A := IntermediateField.adjoin K S
  have hAB : A ≤ B := by
    refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro F (rfl | ⟨a, _, rfl⟩)
    · exact compactifiedQuotientComap_jMeromorphicFunction_mem_coeffIntermediateField N K
    · exact mem_coeffIntermediateField.mpr (frickeMeromorphicFunction_mem_coeffSubfield hK a)
  let T := B.val ⁻¹' S
  let C := IntermediateField.adjoin K T
  have himage : B.val '' T = S := Set.image_preimage_eq_of_subset (by
    intro F hF
    exact ⟨⟨F, hAB (IntermediateField.subset_adjoin K S hF)⟩, rfl⟩)
  have hmap : C.map B.val = A := by
    rw [IntermediateField.adjoin_map, himage]
  have hgen : IntermediateField.adjoin ℂ (Set.range (algebraMap C
      (MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient))) = ⊤ := by
    have hrange : Set.range (algebraMap C
        (MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient)) = A := by
      have himage' : algebraMap B
          (MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient) '' T = S := by
        calc
          _ = B.val '' T := Set.image_congr fun x _ ↦ by
            rw [IntermediateField.algebraMap_apply, IntermediateField.coe_val]
          _ = S := himage
      rw [TauCeti.IntermediateField.range_algebraMap_adjoin, himage']
    rw [hrange, IntermediateField.adjoin_adjoin_right]
    exact adjoin_insert_image_frickeMeromorphicFunction_eq_top
  have hrank := (linearDisjoint_fieldRange_coeffIntermediateField
    (D := cuspDatumInftyGamma N) (K := K)).lift_rank_le_lift_rank_adjoin_algebraMap C
  rw [hgen, IntermediateField.rank_top, Cardinal.lift_one, Cardinal.lift_le_one_iff] at hrank
  have hC : C = ⊤ := IntermediateField.finrank_eq_one_iff_eq_top.mp
    (Module.rank_eq_one_iff_finrank_eq_one.mp (le_antisymm hrank
      (Cardinal.one_le_iff_ne_zero.mpr (rank_pos (R := C) (M := B)).ne')))
  calc
    A = C.map B.val := hmap.symm
    _ = B := by rw [hC, IntermediateField.map_top, IntermediateField.fieldRange_val]

/-- The arithmetic modular function field is generated by `j`, the Fricke functions indexed
by nonzero residues, and the cyclotomic constants. -/
theorem modularFunctionField_eq_closure :
    modularFunctionField N = Subfield.closure
      (Set.range (algebraMap (Subfield.closure {z : ℂ | z ^ N = 1})
          (MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient)) ∪
        insert (Subgroup.compactifiedQuotientComap
          (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R ModularGroup.jMeromorphicFunction)
          (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0})) := by
  rw [modularFunctionField_def, ← toSubfield_coeffIntermediateField,
    ← adjoin_insert_image_frickeMeromorphicFunction_eq_coeffIntermediateField
      (fun _ hζ ↦ Subfield.subset_closure hζ), IntermediateField.adjoin_toSubfield]

/-- The Fricke function with residue index `a`, regarded as an element of `F_N`. -/
def frickeModularFunction (a : Fin 2 → ZMod N) : modularFunctionField N :=
  ⟨frickeMeromorphicFunction a, frickeMeromorphicFunction_mem_modularFunctionField a⟩

/-- The underlying meromorphic function of an arithmetic Fricke function. -/
@[simp]
theorem coe_frickeModularFunction (a : Fin 2 → ZMod N) :
    (frickeModularFunction a :
      MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient) =
        frickeMeromorphicFunction a := by
  rfl

/-- Opposite residues give the same arithmetic Fricke function. -/
@[simp]
theorem frickeModularFunction_neg (a : Fin 2 → ZMod N) :
    frickeModularFunction (-a) = frickeModularFunction a := by
  apply Subtype.ext
  simp only [coe_frickeModularFunction, frickeMeromorphicFunction_neg]

/-- For nonzero residues, arithmetic Fricke functions agree exactly when their indices
agree up to sign. -/
theorem frickeModularFunction_eq_iff {a b : Fin 2 → ZMod N} (ha : a ≠ 0) (hb : b ≠ 0) :
    frickeModularFunction a = frickeModularFunction b ↔ a = b ∨ a = -b := by
  rw [Subtype.ext_iff, coe_frickeModularFunction, coe_frickeModularFunction,
    frickeMeromorphicFunction_eq_iff ha hb]

/-- Inside `F_N`, the cyclotomic constants, `j`, and the Fricke functions indexed by nonzero
residues generate the whole field. Together with
`RingHom.eq_of_eqOn_of_field_closure_eq_top`, this gives extensionality for ring homomorphisms
out of `F_N`. -/
theorem modularFunctionField_closure_eq_top :
    Subfield.closure
      (Set.range (modularFunctionFieldConst N) ∪
        insert (modularFunctionFieldMapOfLevelOne N
          ⟨ModularGroup.jMeromorphicFunction,
            ModularGroup.jMeromorphicFunction_mem_coeffSubfield ⊥⟩)
          (frickeModularFunction '' {a : Fin 2 → ZMod N | a ≠ 0})) = ⊤ := by
  apply Subfield.map_injective (f := (modularFunctionField N).subtype)
  rw [RingHom.map_field_closure, Subfield.map_top, Subfield.fieldRange_subtype]
  conv_rhs => rw [modularFunctionField_eq_closure,
    IsScalarTower.algebraMap_eq (Subfield.closure {z : ℂ | z ^ N = 1}) ℂ
      (MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient),
    Subfield.algebraMap_ofSubfield]
  congr 1
  simp only [Set.image_union, ← Set.range_comp, Set.image_insert_eq, Set.image_image,
    RingHom.coe_comp, Function.comp_def, Subfield.subtype_apply,
    coe_modularFunctionFieldConst_apply,
    coe_modularFunctionFieldMapOfLevelOne_apply, coe_frickeModularFunction]

end TauCeti
