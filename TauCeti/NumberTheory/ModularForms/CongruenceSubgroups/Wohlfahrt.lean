module

public import TauCeti.NumberTheory.ModularForms.CongruenceSubgroups.StrictLevel
import TauCeti.Data.ZMod.Units

/-!
# Wohlfahrt's theorem for the strict level of subgroups of `SL₂(ℤ)`

Wohlfahrt proved that a finite-index subgroup of the modular group is a congruence subgroup if and
only if it contains the principal congruence subgroup of its cusp-width level. For subgroups
`Γ ≤ SL(2, ℤ)` that need not contain `-I`, the signed cusp level of the projective image `±Γ` can
be half the modulus needed on `SL(2, ℤ)` — for `{γ ∈ Γ(2) | γ₀₀ ≡ 1 mod 4}`, the projective image
has level `2` while `-I ∈ Γ(2)` excludes `Γ(2) ≤ Γ`, and the sharp modulus is `Γ.strictLevel = 4`.
Kiming, Schütt and Verrill observed that running the elementary transvection reduction with the
strict translations `σ T^{N_s} σ⁻¹ ∈ Γ` yields the exact criterion on `SL(2, ℤ)` without any
hypothesis on `-I` and without doubling odd levels: a finite-index subgroup `Γ ≤ SL(2, ℤ)` is a
congruence subgroup if and only if `Γ(Γ.strictLevel) ≤ Γ`.

The group-theoretic core behind this criterion is the normal-closure generation identity
`Γ(M) ⊔ normalClosure {T ^ N} = Γ(gcd M N)` for every `M ≠ 0` and every `N : ℕ`. Whereas
`normalClosure {T ^ N}` alone has infinite index in `Γ(N)` for `N ≥ 6` — the classical source of
finite-index noncongruence subgroups — adjoining any nonzero principal congruence subgroup `Γ(M)`
recovers the full congruence subgroup `Γ(gcd M N)`. This file establishes that generation identity
and deduces both the general and finite-index forms of the strict Wohlfahrt criterion, which
underpin congruence testing on coset permutation triples and the congruence closure operator.

## Main results

* `Subgroup.normalClosure_T_pow_strictLevel_le_normalCore`,
  `Subgroup.normalClosure_T_pow_strictLevel_le`: the normal closure of `T ^ Γ.strictLevel` sits
  inside `Γ.normalCore`, hence inside `Γ`.
* `CongruenceSubgroup.normalClosure_T_pow_le_Gamma`: the normal closure of `T ^ N` sits inside
  `Γ(N)`.
* `CongruenceSubgroup.Gamma_le_sup_normalClosure_T_pow`: for `M ≠ 0`, `Γ(N)` is generated by
  `Γ(M)` together with the conjugates of `T ^ N`.
* `CongruenceSubgroup.Gamma_sup_normalClosure_T_pow`: for `M ≠ 0`,
  `Γ(M) ⊔ normalClosure {T ^ N} = Γ(gcd M N)`, with special cases
  `CongruenceSubgroup.Gamma_eq_sup_normalClosure_T_pow_of_dvd` (`N ∣ M`) and
  `CongruenceSubgroup.Gamma_sup_normalClosure_T_pow_eq_top` (`Coprime M N`).
* `CongruenceSubgroup.IsCongruenceSubgroup.Gamma_strictLevel_le`: every congruence subgroup `Γ`
  contains `Γ(Γ.strictLevel)`.
* `CongruenceSubgroup.isCongruenceSubgroup_iff_strictLevel_ne_zero_and_Gamma_strictLevel_le`: for
  an arbitrary subgroup `Γ ≤ SL(2, ℤ)`, `Γ` is congruence iff `Γ.strictLevel ≠ 0` and
  `Γ(Γ.strictLevel) ≤ Γ`.
* `CongruenceSubgroup.isCongruenceSubgroup_iff_Gamma_strictLevel_le`: **Wohlfahrt's theorem
  (strict form)** — a finite-index subgroup `Γ ≤ SL(2, ℤ)` is congruence iff
  `Γ(Γ.strictLevel) ≤ Γ`.

## References

* K. Wohlfahrt, *An extension of F. Klein's level concept*, Illinois J. Math. 8 (1964), 529–535,
  Theorem 2.
* I. Kiming, M. Schütt and H. A. Verrill, *Lifts of projective congruence groups*,
  J. London Math. Soc. (2) 83 (2011), 96–120, §3, Lemma 7, Proposition 3 and Remark 8.
-/

public section

open Matrix Matrix.SpecialLinearGroup
open scoped MatrixGroups

namespace Subgroup

/-- The normal closure of `T ^ Γ.strictLevel` in `SL(2, ℤ)` is contained in `Γ.normalCore`. -/
theorem normalClosure_T_pow_strictLevel_le_normalCore (Γ : Subgroup SL(2, ℤ)) :
    normalClosure ({ModularGroup.T ^ Γ.strictLevel} : Set SL(2, ℤ)) ≤ Γ.normalCore :=
  normalClosure_le_normal
    (Set.singleton_subset_iff.mpr (strictLevel_dvd_iff_T_pow_mem_normalCore.mp dvd_rfl))

/-- The normal closure of `T ^ Γ.strictLevel` in `SL(2, ℤ)` is contained in `Γ`. -/
theorem normalClosure_T_pow_strictLevel_le (Γ : Subgroup SL(2, ℤ)) :
    normalClosure ({ModularGroup.T ^ Γ.strictLevel} : Set SL(2, ℤ)) ≤ Γ :=
  Γ.normalClosure_T_pow_strictLevel_le_normalCore.trans Γ.normalCore_le

end Subgroup

namespace CongruenceSubgroup

/-- The normal closure of `T ^ N` in `SL(2, ℤ)` is contained in `Γ(N)`. -/
theorem normalClosure_T_pow_le_Gamma (N : ℕ) :
    Subgroup.normalClosure ({ModularGroup.T ^ N} : Set SL(2, ℤ)) ≤ Gamma N := by
  have := Gamma_normal N
  refine Subgroup.normalClosure_le_normal (Set.singleton_subset_iff.mpr ?_)
  simpa using ModularGroup_T_pow_mem_Gamma N N dvd_rfl

section MatrixReduction

/-- Lower unitriangular shear `!![1, 0; r, 1]`, written as a conjugate of `T ^ (-r)` by `S`. -/
private def lowerShear (r : ℤ) : SL(2, ℤ) :=
  ModularGroup.S * ModularGroup.T ^ (-r) * ModularGroup.S⁻¹

private lemma coe_lowerShear (r : ℤ) :
    (lowerShear r : Matrix (Fin 2) (Fin 2) ℤ) = !![1, 0; r, 1] := by
  rw [lowerShear, Matrix.SpecialLinearGroup.coe_conj_T_zpow]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [ModularGroup.coe_S]

private lemma T_zpow_mul_mem_normalClosure (N : ℕ) (k : ℤ) :
    ModularGroup.T ^ (k * N) ∈
      Subgroup.normalClosure ({ModularGroup.T ^ N} : Set SL(2, ℤ)) := by
  have heq : (ModularGroup.T ^ N) ^ k = ModularGroup.T ^ (k * N) := by
    rw [← zpow_natCast, ← _root_.zpow_mul, mul_comm]
  exact heq ▸ Subgroup.zpow_mem _ (Subgroup.subset_normalClosure rfl) k

private lemma lowerShear_mul_mem_normalClosure (N : ℕ) (k : ℤ) :
    lowerShear (k * N) ∈ Subgroup.normalClosure ({ModularGroup.T ^ N} : Set SL(2, ℤ)) := by
  have hneg : -(k * (N : ℤ)) = -k * N := by ring
  rw [lowerShear, hneg]
  exact Subgroup.normalClosure_normal.conj_mem _ (T_zpow_mul_mem_normalClosure N (-k))
    ModularGroup.S

/-- Right-multiplying `A ∈ Γ(N)` by a suitable lower shear `!![1, 0; k N, 1]` makes the upper-left
entry a unit modulo `M`. -/
private lemma exists_mul_lowerShear_isUnit_zero_zero {M N : ℕ} [NeZero M] {A : SL(2, ℤ)}
    (hA : A ∈ Gamma N) :
    ∃ k : ℤ, IsUnit (((A * lowerShear (k * N)) 0 0 : ℤ) : ZMod M) := by
  obtain ⟨r, hr⟩ : (N : ℤ) ∣ A 0 0 - 1 := by
    rw [← ZMod.intCast_eq_intCast_iff_dvd_sub, Int.cast_one]
    exact (Gamma_mem.mp hA).1.symm
  have hcopN : IsCoprime (A 0 0) (N : ℤ) := ⟨1, -r, by linear_combination hr⟩
  have hcop01 : IsCoprime (A 0 0) (A 0 1) :=
    ⟨A 1 1, -A 1 0, by linear_combination A.fin_two_mul_sub_mul_eq_one⟩
  have hcop : IsCoprime ((A 0 0 : ℤ) : ZMod M) (((A 0 1 * N : ℤ) : ZMod M)) := by
    simpa using (hcop01.mul_right hcopN).map (Int.castRingHom (ZMod M))
  obtain ⟨kbar, hkbar⟩ := hcop.exists_isUnit_add_mul
  obtain ⟨k, rfl⟩ := ZMod.intCast_surjective kbar
  refine ⟨k, ?_⟩
  have h00 : (A * lowerShear (k * N)) 0 0 = A 0 0 + k * (A 0 1 * N) := by
    simp [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two, coe_lowerShear]
    ring
  rw [h00]
  simpa only [Int.cast_add, Int.cast_mul] using hkbar

/-- Clearing both off-diagonal multiples of `N` modulo `M` once the upper-left entry has inverse
`u` modulo `M`. -/
private lemma shear_offDiag_eq_zero {M N : ℕ} {X : SL(2, ℤ)} {u b c : ℤ}
    (h01 : X 0 1 = b * N) (h10 : X 1 0 = c * N)
    (hu : ((X 0 0 : ℤ) : ZMod M) * (u : ZMod M) = 1) :
    (lowerShear ((-u * c) * N) * X * ModularGroup.T ^ ((-u * b) * N)) 0 0 = X 0 0 ∧
      (((lowerShear ((-u * c) * N) * X * ModularGroup.T ^ ((-u * b) * N)) 0 1 : ℤ) : ZMod M) = 0 ∧
      (((lowerShear ((-u * c) * N) * X * ModularGroup.T ^ ((-u * b) * N)) 1 0 : ℤ) : ZMod M) =
        0 := by
  have h00 : (lowerShear ((-u * c) * N) * X * ModularGroup.T ^ ((-u * b) * N)) 0 0 = X 0 0 := by
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two,
      coe_lowerShear, ModularGroup.coe_T_zpow, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Fin.isValue]
    ring
  have he01 : (lowerShear ((-u * c) * N) * X * ModularGroup.T ^ ((-u * b) * N)) 0 1 =
      (1 - X 0 0 * u) * (b * N) := by
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two,
      coe_lowerShear, ModularGroup.coe_T_zpow, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Fin.isValue]
    rw [h01]
    ring
  have he10 : (lowerShear ((-u * c) * N) * X * ModularGroup.T ^ ((-u * b) * N)) 1 0 =
      (1 - X 0 0 * u) * (c * N) := by
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two,
      coe_lowerShear, ModularGroup.coe_T_zpow, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Fin.isValue]
    rw [h10]
    ring
  refine ⟨h00, ?_, ?_⟩
  · rw [he01]; push_cast; rw [hu, sub_self, zero_mul]
  · rw [he10]; push_cast; rw [hu, sub_self, zero_mul]

/-- Two matrices in `SL(2, ℤ)` whose off-diagonal entries vanish modulo `M` and whose upper-left
entries are equal and invertible modulo `M` are congruent modulo `M`. -/
private lemma mul_inv_mem_Gamma_of_diag_unit {M : ℕ} {X Y : SL(2, ℤ)}
    (hu : IsUnit ((X 0 0 : ℤ) : ZMod M)) (h00 : X 0 0 = Y 0 0)
    (hX01 : ((X 0 1 : ℤ) : ZMod M) = 0) (hX10 : ((X 1 0 : ℤ) : ZMod M) = 0)
    (hY01 : ((Y 0 1 : ℤ) : ZMod M) = 0) (hY10 : ((Y 1 0 : ℤ) : ZMod M) = 0) :
    X * Y⁻¹ ∈ Gamma M := by
  have hXdet := intCast_apply_zero_zero_mul_apply_one_one_of_mem_Gamma0 (Gamma0_mem.mpr hX10)
  have hYdet : ((X 0 0 : ℤ) : ZMod M) * ((Y 1 1 : ℤ) : ZMod M) = 1 := by
    rw [h00]
    exact intCast_apply_zero_zero_mul_apply_one_one_of_mem_Gamma0 (Gamma0_mem.mpr hY10)
  have h11 : ((X 1 1 : ℤ) : ZMod M) = ((Y 1 1 : ℤ) : ZMod M) :=
    hu.mul_left_cancel (hXdet.trans hYdet.symm)
  have hmap : Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod M)) X =
      Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod M)) Y := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [h00, hX01, hY01, hX10, hY10, h11]
  exact Gamma_mem'.mpr (by rw [map_mul, map_inv, hmap, mul_inv_cancel])

/-- **Transvection reduction of `Γ(N)` modulo a nonzero level `M`**: every matrix of `Γ(N)` lies in
`Γ(M) ⊔ normalClosure {T ^ N}`.

Needs `M ≠ 0`: at `M = 0`, `Γ(0) = ⊥` while `normalClosure {T ^ N}` has infinite index in `Γ(N)`
for `N ≥ 6`. -/
theorem Gamma_le_sup_normalClosure_T_pow (M N : ℕ) [NeZero M] :
    Gamma N ≤ Gamma M ⊔ Subgroup.normalClosure ({ModularGroup.T ^ N} : Set SL(2, ℤ)) := by
  let G := Subgroup.normalClosure ({ModularGroup.T ^ N} : Set SL(2, ℤ))
  intro A hA
  -- Step 1: shear `A` on the right inside `G ≤ Γ(N)` so that `A₁ 0 0` is a unit modulo `M`.
  obtain ⟨k, hk⟩ := exists_mul_lowerShear_isUnit_zero_zero (M := M) hA
  set A₁ := A * lowerShear (k * N)
  have hkG : lowerShear (k * N) ∈ G := lowerShear_mul_mem_normalClosure N k
  have hA₁ : A₁ ∈ Gamma N := (Gamma N).mul_mem hA (normalClosure_T_pow_le_Gamma N hkG)
  -- Step 2: write `A₁ 0 0 = 1 + r₁ N`, `A₁ 0 1 = b₁ N`, `A₁ 1 0 = c₁ N` and invert `A₁ 0 0`
  -- modulo `M`.
  obtain ⟨r₁, hr₁⟩ : ∃ r₁ : ℤ, A₁ 0 0 = 1 + r₁ * N := by
    obtain ⟨r, hr⟩ := (ZMod.intCast_eq_intCast_iff_dvd_sub (1 : ℤ) (A₁ 0 0) N).mp
      (by simpa using (Gamma_mem.mp hA₁).1.symm)
    exact ⟨r, by linear_combination hr⟩
  obtain ⟨b₁, hb₁⟩ : ∃ b₁ : ℤ, A₁ 0 1 = b₁ * N := by
    obtain ⟨b, hb⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd (A₁ 0 1) N).mp (Gamma_mem.mp hA₁).2.1
    exact ⟨b, by linear_combination hb⟩
  obtain ⟨c₁, hc₁⟩ : ∃ c₁ : ℤ, A₁ 1 0 = c₁ * N := by
    obtain ⟨c, hc⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd (A₁ 1 0) N).mp (Gamma_mem.mp hA₁).2.2.1
    exact ⟨c, by linear_combination hc⟩
  obtain ⟨u, hu⟩ : ∃ u : ℤ, ((A₁ 0 0 : ℤ) : ZMod M) * (u : ZMod M) = 1 := by
    obtain ⟨u₀, hu₀⟩ := hk
    obtain ⟨u, hu⟩ := ZMod.intCast_surjective (↑u₀⁻¹ : ZMod M)
    exact ⟨u, by rw [hu, ← hu₀, Units.mul_inv]⟩
  -- Step 3: match `A₁ 0 0 = 1 + r₁ N` with the conjugate `C = σ (T ^ N)⁻¹ σ⁻¹ ∈ G` for
  -- `σ = lowerShear r₁`, then clear the off-diagonal entries of both `A₁` and `C` modulo `M`.
  let C : SL(2, ℤ) := lowerShear r₁ * ModularGroup.T ^ (-(N : ℤ)) * (lowerShear r₁)⁻¹
  have hCG : C ∈ G := by
    simpa [C, _root_.zpow_neg, zpow_natCast] using
      Subgroup.normalClosure_normal.conj_mem _ (G.inv_mem (Subgroup.subset_normalClosure rfl))
        (lowerShear r₁)
  have hCcoe := Matrix.SpecialLinearGroup.coe_conj_T_zpow (lowerShear r₁) (-(N : ℤ))
  have hC00 : C 0 0 = A₁ 0 0 := by
    have h := congr_fun₂ hCcoe 0 0
    simp only [coe_lowerShear, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one] at h
    linear_combination h - hr₁
  have hC01 : C 0 1 = (-1 : ℤ) * N := by
    have h := congr_fun₂ hCcoe 0 1
    simp only [coe_lowerShear, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one] at h
    linear_combination h
  have hC10 : C 1 0 = r₁ ^ 2 * N := by
    have h := congr_fun₂ hCcoe 1 0
    simp only [coe_lowerShear, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one] at h
    linear_combination h
  obtain ⟨hA₂00, hA₂01, hA₂10⟩ := shear_offDiag_eq_zero hb₁ hc₁ hu
  obtain ⟨hC₂00, hC₂01, hC₂10⟩ := shear_offDiag_eq_zero hC01 hC10 (hC00.symm ▸ hu)
  set gL := lowerShear ((-u * c₁) * N)
  set gR := ModularGroup.T ^ ((-u * b₁) * N)
  set C₂ := lowerShear ((-u * r₁ ^ 2) * N) * C * ModularGroup.T ^ ((-u * -1) * N)
  -- Step 4: `gL * A₁ * gR` and `C₂` agree modulo `M`, while `gL`, `gR`, `C₂` and `lowerShear (k N)`
  -- all belong to `G`.
  have hdiff : gL * A₁ * gR * C₂⁻¹ ∈ Gamma M :=
    mul_inv_mem_Gamma_of_diag_unit (by rwa [hA₂00]) (hA₂00.trans (hC00.symm.trans hC₂00.symm))
      hA₂01 hA₂10 hC₂01 hC₂10
  have hC₂G : C₂ ∈ G := G.mul_mem
    (G.mul_mem (lowerShear_mul_mem_normalClosure N _) hCG) (T_zpow_mul_mem_normalClosure N _)
  have hA₂mem : gL * A₁ * gR ∈ Gamma M ⊔ G := by
    simpa [mul_assoc] using
      (Gamma M ⊔ G).mul_mem (Subgroup.mem_sup_left hdiff) (Subgroup.mem_sup_right hC₂G)
  have hA₁mem : A₁ ∈ Gamma M ⊔ G := by
    have hgL : gL⁻¹ ∈ Gamma M ⊔ G :=
      Subgroup.mem_sup_right (G.inv_mem (lowerShear_mul_mem_normalClosure N _))
    have hgR : gR⁻¹ ∈ Gamma M ⊔ G :=
      Subgroup.mem_sup_right (G.inv_mem (T_zpow_mul_mem_normalClosure N _))
    simpa [mul_assoc] using (Gamma M ⊔ G).mul_mem ((Gamma M ⊔ G).mul_mem hgL hA₂mem) hgR
  simpa [A₁, mul_assoc] using (Gamma M ⊔ G).mul_mem hA₁mem (Subgroup.mem_sup_right (G.inv_mem hkG))

end MatrixReduction

/-- **Normal-closure generation of principal congruence subgroups** (Wohlfahrt, Theorem 2;
Kiming–Schütt–Verrill, §3, Lemma 7): for `M ≠ 0` and any `N : ℕ`, adjoining the normal closure of
`T ^ N` to `Γ(M)` produces `Γ(gcd M N)`.

Needs `M ≠ 0`: at `M = 0`, `Γ(0) = ⊥`, whereas `normalClosure {T ^ N}` has infinite index in
`Γ(N)` for `N ≥ 6`. -/
theorem Gamma_sup_normalClosure_T_pow (M N : ℕ) [NeZero M] :
    Gamma M ⊔ Subgroup.normalClosure ({ModularGroup.T ^ N} : Set SL(2, ℤ)) =
      Gamma (Nat.gcd M N) := by
  refine le_antisymm (sup_le (Gamma_le_Gamma_of_dvd (Nat.gcd_dvd_left M N))
    ((normalClosure_T_pow_le_Gamma N).trans (Gamma_le_Gamma_of_dvd (Nat.gcd_dvd_right M N)))) ?_
  rw [Gamma_gcd_eq_sup]
  exact sup_le le_sup_left (Gamma_le_sup_normalClosure_T_pow M N)

/-- When `N ∣ M` and `M ≠ 0`, `Γ(N)` is generated by `Γ(M)` and the conjugates of `T ^ N`. -/
theorem Gamma_eq_sup_normalClosure_T_pow_of_dvd {M N : ℕ} [NeZero M] (hNM : N ∣ M) :
    Gamma N = Gamma M ⊔ Subgroup.normalClosure ({ModularGroup.T ^ N} : Set SL(2, ℤ)) := by
  rw [Gamma_sup_normalClosure_T_pow, Nat.gcd_eq_right hNM]

/-- When `M ≠ 0` is coprime to `N`, `Γ(M)` and the conjugates of `T ^ N` generate the full
modular group `SL(2, ℤ)`. -/
theorem Gamma_sup_normalClosure_T_pow_eq_top {M N : ℕ} [NeZero M] (h : M.Coprime N) :
    Gamma M ⊔ Subgroup.normalClosure ({ModularGroup.T ^ N} : Set SL(2, ℤ)) = ⊤ := by
  rw [Gamma_sup_normalClosure_T_pow, h.gcd_eq_one, Gamma_one_top]

/-- Every congruence subgroup `Γ ≤ SL(2, ℤ)` has positive strict level. -/
theorem IsCongruenceSubgroup.strictLevel_pos {Γ : Subgroup SL(2, ℤ)}
    (h : IsCongruenceSubgroup Γ) : 0 < Γ.strictLevel := by
  have := h.finiteIndex
  exact Γ.strictLevel_pos

/-- Every congruence subgroup `Γ ≤ SL(2, ℤ)` has nonzero strict level. -/
theorem IsCongruenceSubgroup.strictLevel_ne_zero {Γ : Subgroup SL(2, ℤ)}
    (h : IsCongruenceSubgroup Γ) : Γ.strictLevel ≠ 0 :=
  h.strictLevel_pos.ne'

/-- **Forward direction of Wohlfahrt's strict theorem**: every congruence subgroup `Γ ≤ SL(2, ℤ)`
contains the principal congruence subgroup of its strict level `Γ(Γ.strictLevel)`. -/
theorem IsCongruenceSubgroup.Gamma_strictLevel_le {Γ : Subgroup SL(2, ℤ)}
    (h : IsCongruenceSubgroup Γ) : Gamma Γ.strictLevel ≤ Γ := by
  obtain ⟨M, hM0, hM⟩ := h
  have : NeZero M := ⟨hM0⟩
  rw [Gamma_eq_sup_normalClosure_T_pow_of_dvd (strictLevel_dvd_of_Gamma_le hM)]
  exact sup_le hM Γ.normalClosure_T_pow_strictLevel_le

/-- **Unconditional strict Wohlfahrt characterization**: an arbitrary subgroup `Γ ≤ SL(2, ℤ)` is a
congruence subgroup if and only if its strict level is nonzero and `Γ(Γ.strictLevel) ≤ Γ`.

Without `Γ.FiniteIndex` the nonvanishing clause is essential: at `Γ = ⊥`, `strictLevel ⊥ = 0` and
`Γ(0) = ⊥ ≤ ⊥`, while `⊥` is not a congruence subgroup. -/
theorem isCongruenceSubgroup_iff_strictLevel_ne_zero_and_Gamma_strictLevel_le
    {Γ : Subgroup SL(2, ℤ)} :
    IsCongruenceSubgroup Γ ↔ Γ.strictLevel ≠ 0 ∧ Gamma Γ.strictLevel ≤ Γ :=
  ⟨fun h ↦ ⟨h.strictLevel_ne_zero, h.Gamma_strictLevel_le⟩,
    fun ⟨h0, hle⟩ ↦ ⟨Γ.strictLevel, h0, hle⟩⟩

/-- **Wohlfahrt's theorem (strict form)** (Wohlfahrt, Theorem 2; Kiming–Schütt–Verrill, §3,
Proposition 3 and Remark 8): a finite-index subgroup `Γ ≤ SL(2, ℤ)`, whether or not it contains
`-I`, is a congruence subgroup if and only if it contains `Γ(Γ.strictLevel)`. -/
theorem isCongruenceSubgroup_iff_Gamma_strictLevel_le {Γ : Subgroup SL(2, ℤ)} [Γ.FiniteIndex] :
    IsCongruenceSubgroup Γ ↔ Gamma Γ.strictLevel ≤ Γ := by
  rw [isCongruenceSubgroup_iff_strictLevel_ne_zero_and_Gamma_strictLevel_le,
    and_iff_right Γ.strictLevel_pos.ne']

end CongruenceSubgroup
