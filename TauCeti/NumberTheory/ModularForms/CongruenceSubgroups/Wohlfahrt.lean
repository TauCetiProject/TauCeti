module

public import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Projective
public import TauCeti.NumberTheory.ModularForms.CongruenceSubgroups.StrictLevel
import Mathlib.LinearAlgebra.Matrix.FixedDetMatrices
import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.NormalClosure
import TauCeti.NumberTheory.ModularForms.WithCenter

/-!
# Wohlfahrt's theorem in strict form

A finite-index subgroup `Γ ≤ SL(2, ℤ)` is a congruence subgroup if and only if it contains the
principal congruence subgroup `Γ(N)` at its strict level `N = Γ.strictLevel`. Because `Γ` need not
contain `-I`, the strict level—defined using unsigned conjugates `σ Tᴺ σ⁻¹ ∈ Γ` rather than
`±σ Tᴺ σ⁻¹ ∈ Γ`—is the sharp modulus: for any congruence subgroup `Γ`, its strict level divides
every `M` with `Γ(M) ≤ Γ`, may equal twice the strict level of `Γ.withCenter`, and always satisfies
`Γ(2 * Γ.withCenter.strictLevel) ≤ Γ`.

The proof pulls back the normal-closure description of modular congruence kernels in `SL(2, ZMod M)`
(`Matrix.SpecialLinearGroup.normalClosure_transvection_natCast_eq_ker_map_castHom`) along the
surjective reduction map `SL(2, ℤ) →* SL(2, ZMod M)`: for every nonzero multiple `M` of `N`,
`Γ(N) = normalClosure {T ^ N} ⊔ Γ(M)`. If `Γ` contains `Γ(M)` for some `M ≠ 0`, then
`N = Γ.strictLevel` divides `M` while `normalClosure {T ^ N} ≤ Γ`, forcing `Γ(N) ≤ Γ`.

## Main results

* `CongruenceSubgroup.Gamma_eq_normalClosure_T_pow_sup_Gamma`: for `M ≠ 0` and `N ∣ M`,
  `Γ(N) = normalClosure {T ^ N} ⊔ Γ(M)`.
* `CongruenceSubgroup.normalClosure_T_eq_top`: `SL(2, ℤ)` is normally generated by `T`.
* `CongruenceSubgroup.IsCongruenceSubgroup.Gamma_strictLevel_le`: every congruence subgroup `Γ`
  contains `Γ(Γ.strictLevel)`.
* `CongruenceSubgroup.isCongruenceSubgroup_iff_Gamma_strictLevel_le`: **Wohlfahrt's theorem in
  strict form** — for finite-index `Γ ≤ SL(2, ℤ)`, `IsCongruenceSubgroup Γ ↔ Γ(Γ.strictLevel) ≤ Γ`.
* `CongruenceSubgroup.isCongruenceSubgroup_iff_strictLevel_ne_zero_and_Gamma_le`: unconditional
  characterization valid without assuming finite index.
* `CongruenceSubgroup.IsCongruenceSubgroup.Gamma_two_mul_strictLevel_withCenter_le`: every
  congruence subgroup `Γ` contains `Γ(2 * Γ.withCenter.strictLevel)`.
* `CongruenceSubgroup.IsCongruenceSubgroup.inf`,
  `CongruenceSubgroup.isCongruenceSubgroup_normalCore_iff`,
  `CongruenceSubgroup.IsCongruenceSubgroup.withCenter`: closure of `IsCongruenceSubgroup` under
  finite intersections, normal cores, and adjoining `{±I}`.

## References

* K. Wohlfahrt, *An extension of F. Klein's level concept*, Illinois J. Math. 8 (1964), 529–535.
* I. Kiming, M. Schütt, and H. A. Verrill, *Lifts of projective congruence groups*,
  J. London Math. Soc. (2) 83 (2011), 96–120, §3, Proposition 3.
-/

public section

open Matrix Matrix.SpecialLinearGroup
open scoped MatrixGroups Pointwise

namespace CongruenceSubgroup

/-- Under reduction modulo `M`, `T ^ N` maps to the upper transvection `1 + N E₀₁`. -/
private lemma map_intCast_T_pow (M N : ℕ) :
    Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod M)) (ModularGroup.T ^ N) =
      Matrix.SpecialLinearGroup.transvection (zero_ne_one : (0 : Fin 2) ≠ 1) (N : ZMod M) := by
  have hT : ModularGroup.T =
      Matrix.SpecialLinearGroup.transvection (zero_ne_one : (0 : Fin 2) ≠ 1) (1 : ℤ) := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [ModularGroup.coe_T, transvection_coe]
  rw [map_pow, hT, map_transvection, map_one, transvection_pow, nsmul_one]

/-- **Normal-closure descent between principal congruence subgroups.** For every `M ≠ 0` and every
divisor `N ∣ M`, `Γ(N)` is generated by `Γ(M)` together with the normal closure in `SL(2, ℤ)` of
`T ^ N`. -/
theorem Gamma_eq_normalClosure_T_pow_sup_Gamma {N M : ℕ} (hM : M ≠ 0) (hNM : N ∣ M) :
    Gamma N = Subgroup.normalClosure {ModularGroup.T ^ N} ⊔ Gamma M := by
  have : NeZero M := ⟨hM⟩
  let φ : SL(2, ℤ) →* SL(2, ZMod M) := Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod M))
  have hker : ((Matrix.SpecialLinearGroup.map (ZMod.castHom hNM (ZMod N))).ker).comap φ =
      Gamma N := by
    ext γ
    simp only [Subgroup.mem_comap, MonoidHom.mem_ker, Gamma_mem', φ,
      ← MonoidHom.comp_apply, Matrix.SpecialLinearGroup.map_comp_map]
    rw [Subsingleton.elim ((ZMod.castHom hNM (ZMod N)).comp (Int.castRingHom (ZMod M)))
      (Int.castRingHom (ZMod N))]
  calc
    Gamma N
      = ((Matrix.SpecialLinearGroup.map (ZMod.castHom hNM (ZMod N))).ker).comap φ := hker.symm
    _ = (Subgroup.normalClosure
          {Matrix.SpecialLinearGroup.transvection (zero_ne_one : (0 : Fin 2) ≠ 1)
            (N : ZMod M)}).comap φ := by
          rw [Matrix.SpecialLinearGroup.normalClosure_transvection_natCast_eq_ker_map_castHom hNM]
    _ = ((Subgroup.normalClosure {ModularGroup.T ^ N}).map φ).comap φ := by
          rw [Subgroup.map_normalClosure _ φ
            Matrix.SpecialLinearGroup.map_intCast_zmod_surjective, Set.image_singleton,
            map_intCast_T_pow]
    _ = Subgroup.normalClosure {ModularGroup.T ^ N} ⊔ Gamma M :=
          Subgroup.comap_map_eq (f := φ) _

/-- `SL(2, ℤ)` is the normal closure of the single translation matrix `T`. -/
@[simp]
theorem normalClosure_T_eq_top : Subgroup.normalClosure {ModularGroup.T} = ⊤ := by
  have hT : ModularGroup.T ∈ Subgroup.normalClosure {ModularGroup.T} :=
    Subgroup.subset_normalClosure rfl
  have hconj : ModularGroup.S * ModularGroup.T * ModularGroup.S⁻¹ ∈
      Subgroup.normalClosure {ModularGroup.T} :=
    (inferInstance : (Subgroup.normalClosure {ModularGroup.T}).Normal).conj_mem _ hT
      ModularGroup.S
  have hrel : ModularGroup.T * (ModularGroup.S * ModularGroup.T * ModularGroup.S⁻¹) *
      ModularGroup.T = ModularGroup.S⁻¹ := by
    decide
  have hS : ModularGroup.S ∈ Subgroup.normalClosure {ModularGroup.T} := by
    rw [← inv_inv ModularGroup.S]
    exact inv_mem (hrel ▸ mul_mem (mul_mem hT hconj) hT)
  rw [eq_top_iff, ← _root_.SpecialLinearGroup.SL2Z_generators, Subgroup.closure_le]
  rintro γ (rfl | rfl)
  · exact hS
  · exact hT

/-- Every congruence subgroup of `SL(2, ℤ)` has positive strict level. -/
theorem IsCongruenceSubgroup.strictLevel_pos {Γ : Subgroup SL(2, ℤ)}
    (h : IsCongruenceSubgroup Γ) : 0 < Γ.strictLevel := by
  have := h.finiteIndex
  exact Γ.strictLevel_pos

/-- Every congruence subgroup of `SL(2, ℤ)` has nonzero strict level. -/
theorem IsCongruenceSubgroup.strictLevel_ne_zero {Γ : Subgroup SL(2, ℤ)}
    (h : IsCongruenceSubgroup Γ) : Γ.strictLevel ≠ 0 :=
  h.strictLevel_pos.ne'

/-- Every congruence subgroup `Γ ≤ SL(2, ℤ)` contains the principal congruence subgroup at its
strict level `Γ.strictLevel`. -/
theorem IsCongruenceSubgroup.Gamma_strictLevel_le {Γ : Subgroup SL(2, ℤ)}
    (h : IsCongruenceSubgroup Γ) : Gamma Γ.strictLevel ≤ Γ := by
  obtain ⟨M, hM, hMΓ⟩ := h
  rw [Gamma_eq_normalClosure_T_pow_sup_Gamma hM (strictLevel_dvd_of_Gamma_le hMΓ)]
  exact sup_le Γ.normalClosure_T_pow_strictLevel_le hMΓ

/-- Unconditional form of **Wohlfahrt's theorem**: an arbitrary subgroup `Γ ≤ SL(2, ℤ)` is a
congruence subgroup if and only if its strict level is nonzero and `Γ(Γ.strictLevel) ≤ Γ`. -/
theorem isCongruenceSubgroup_iff_strictLevel_ne_zero_and_Gamma_le {Γ : Subgroup SL(2, ℤ)} :
    IsCongruenceSubgroup Γ ↔ Γ.strictLevel ≠ 0 ∧ Gamma Γ.strictLevel ≤ Γ :=
  ⟨fun h ↦ ⟨h.strictLevel_ne_zero, h.Gamma_strictLevel_le⟩,
    fun ⟨h0, hle⟩ ↦ ⟨Γ.strictLevel, h0, hle⟩⟩

/-- **Wohlfahrt's theorem in strict form.** A finite-index subgroup `Γ ≤ SL(2, ℤ)` is a congruence
subgroup if and only if it contains `Γ(Γ.strictLevel)`. -/
theorem isCongruenceSubgroup_iff_Gamma_strictLevel_le {Γ : Subgroup SL(2, ℤ)} [Γ.FiniteIndex] :
    IsCongruenceSubgroup Γ ↔ Gamma Γ.strictLevel ≤ Γ :=
  ⟨IsCongruenceSubgroup.Gamma_strictLevel_le, fun h ↦ ⟨Γ.strictLevel, Γ.strictLevel_pos.ne', h⟩⟩

/-- For a congruence subgroup `Γ ≤ SL(2, ℤ)`, `Γ.strictLevel` is the least positive modulus `N`
such that `Γ(N) ≤ Γ`. -/
theorem IsCongruenceSubgroup.strictLevel_eq_sInf_Gamma_le {Γ : Subgroup SL(2, ℤ)}
    (h : IsCongruenceSubgroup Γ) :
    Γ.strictLevel = sInf {N : ℕ | 0 < N ∧ Gamma N ≤ Γ} := by
  refine le_antisymm (le_csInf ⟨Γ.strictLevel, h.strictLevel_pos, h.Gamma_strictLevel_le⟩
    fun N ⟨hN, hNΓ⟩ ↦ Nat.le_of_dvd hN (strictLevel_dvd_of_Gamma_le hNΓ)) ?_
  exact Nat.sInf_le ⟨h.strictLevel_pos, h.Gamma_strictLevel_le⟩

/-- **Kiming–Schütt–Verrill's `2N` bound.** Every congruence subgroup `Γ ≤ SL(2, ℤ)` contains
`Γ(2 * N)`, where `N = Γ.withCenter.strictLevel` is the projective (signed) level of `Γ`. -/
theorem IsCongruenceSubgroup.Gamma_two_mul_strictLevel_withCenter_le {Γ : Subgroup SL(2, ℤ)}
    (h : IsCongruenceSubgroup Γ) : Gamma (2 * Γ.withCenter.strictLevel) ≤ Γ :=
  (Gamma_le_Gamma_of_dvd Γ.strictLevel_dvd_two_mul_strictLevel_withCenter).trans
    h.Gamma_strictLevel_le

/-- **Signed Wohlfahrt's theorem** for subgroups containing `-I`: if `-I ∈ Γ` and `Γ` has finite
index, `Γ` is a congruence subgroup if and only if it contains `Γ(Γ.withCenter.strictLevel)`. -/
theorem isCongruenceSubgroup_iff_Gamma_strictLevel_withCenter_le_of_neg_one_mem
    {Γ : Subgroup SL(2, ℤ)} [Γ.FiniteIndex] (hneg : (-1 : SL(2, ℤ)) ∈ Γ) :
    IsCongruenceSubgroup Γ ↔ Gamma Γ.withCenter.strictLevel ≤ Γ := by
  rw [Γ.strictLevel_withCenter_of_neg_one_mem hneg, isCongruenceSubgroup_iff_Gamma_strictLevel_le]

/-- The full modular group `SL(2, ℤ)` is a congruence subgroup. -/
@[simp]
theorem isCongruenceSubgroup_top : IsCongruenceSubgroup ⊤ :=
  ⟨1, one_ne_zero, le_top⟩

/-- The trivial subgroup of `SL(2, ℤ)` is not a congruence subgroup. -/
@[simp]
theorem not_isCongruenceSubgroup_bot : ¬ IsCongruenceSubgroup ⊥ :=
  fun h ↦ h.strictLevel_ne_zero Subgroup.strictLevel_bot

/-- The intersection of two congruence subgroups is a congruence subgroup. -/
theorem IsCongruenceSubgroup.inf {Γ₁ Γ₂ : Subgroup SL(2, ℤ)}
    (h₁ : IsCongruenceSubgroup Γ₁) (h₂ : IsCongruenceSubgroup Γ₂) :
    IsCongruenceSubgroup (Γ₁ ⊓ Γ₂) := by
  obtain ⟨N₁, hN₁, hle₁⟩ := h₁
  obtain ⟨N₂, hN₂, hle₂⟩ := h₂
  exact ⟨N₁.lcm N₂, Nat.lcm_ne_zero hN₁ hN₂, Gamma_lcm_eq_inf N₁ N₂ ▸ inf_le_inf hle₁ hle₂⟩

/-- The normal core of `Γ` is a congruence subgroup if and only if `Γ` is: `Γ(Γ.strictLevel)` is
already normal in `SL(2, ℤ)`. -/
@[simp]
theorem isCongruenceSubgroup_normalCore_iff {Γ : Subgroup SL(2, ℤ)} :
    IsCongruenceSubgroup Γ.normalCore ↔ IsCongruenceSubgroup Γ := by
  refine ⟨isCongruenceSubgroup_trans _ _ Γ.normalCore_le, fun h ↦ ?_⟩
  have := Gamma_normal Γ.strictLevel
  exact ⟨Γ.strictLevel, h.strictLevel_ne_zero,
    Subgroup.normal_le_normalCore.mpr h.Gamma_strictLevel_le⟩

/-- Conjugating by `SL(2, ℤ)` preserves and reflects congruence subgroups. -/
@[simp]
theorem isCongruenceSubgroup_conjAct_smul_iff (g : ConjAct SL(2, ℤ))
    {Γ : Subgroup SL(2, ℤ)} :
    IsCongruenceSubgroup (g • Γ) ↔ IsCongruenceSubgroup Γ :=
  ⟨fun h ↦ inv_smul_smul g Γ ▸ conj_cong_is_cong g⁻¹ (g • Γ) h, conj_cong_is_cong g Γ⟩

/-- Adjoining `{±I}` to a congruence subgroup yields a congruence subgroup. The converse fails in
general: an odd-index-2 lift `Γ` of `Γ₀(6)` can be noncongruence even though
`Γ.withCenter = Γ₀(6)` is congruence. -/
theorem IsCongruenceSubgroup.withCenter {Γ : Subgroup SL(2, ℤ)}
    (h : IsCongruenceSubgroup Γ) : IsCongruenceSubgroup Γ.withCenter :=
  isCongruenceSubgroup_trans _ _ Γ.le_withCenter h

/-- Lifting the projective image of `Γ ≤ SL(2, ℤ)` back to `SL(2, ℤ)` gives a congruence subgroup
if and only if `Γ.withCenter` is a congruence subgroup. -/
theorem isCongruenceSubgroup_liftSL_map_iff {Γ : Subgroup SL(2, ℤ)} :
    IsCongruenceSubgroup (Γ.map (QuotientGroup.mk' (Subgroup.center SL(2, ℤ)))).liftSL ↔
      IsCongruenceSubgroup Γ.withCenter := by
  rw [Subgroup.liftSL_map]

end CongruenceSubgroup
