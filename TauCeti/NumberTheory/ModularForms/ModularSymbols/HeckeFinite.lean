module

public import TauCeti.NumberTheory.ModularForms.ModularSymbols.Hecke
import Mathlib.RingTheory.Noetherian.Basic

/-!
# The integral algebra generated by Hecke operators on modular symbols

The Hecke operators `Tₙ` act on the integral modular-symbol module. Their generated
`ℤ`-algebra is finite as a `ℤ`-module: modular symbols are finite over `ℤ`, and their
endomorphisms form a Noetherian `ℤ`-module. This is the integral object used when transferring
Hecke finiteness to cusp forms through the period pairing.

The definition includes every positive index, whether or not it is coprime to the level.
It does not require the Hecke operators to commute.

## Main definitions

* `TauCeti.ModularSymbols.heckeTAlgebra`: the `ℤ`-subalgebra of endomorphisms generated by
  all positive-index Hecke operators on `𝕄_w(Γ₁(N); ℤ)`.

## Main results

* `TauCeti.ModularSymbols.heckeTSymbol_mem_heckeTAlgebra`: each `Tₙ` belongs to the algebra.
* `TauCeti.ModularSymbols.heckeTAlgebra_finite`: the algebra is a finite `ℤ`-module.

## References

* W. Stein, *Modular Forms: A Computational Approach*, §8.3.
-/

public noncomputable section

open CongruenceSubgroup

namespace TauCeti.ModularSymbols

variable (N w : ℕ) [NeZero N]

private def heckeTSymbolPos (n : ℕ+) :
    Module.End ℤ (ModularSymbols ℤ (Gamma1 N) w) := by
  letI : NeZero (n : ℕ) := ⟨n.ne_zero⟩
  exact heckeTSymbol ℤ w N n

/-- The integral Hecke algebra acting on the modular symbols of level `Γ₁(N)` and weight
`w + 2`, generated by `Tₙ` for all positive integers `n`. -/
def heckeTAlgebra : Subalgebra ℤ (Module.End ℤ (ModularSymbols ℤ (Gamma1 N) w)) :=
  Algebra.adjoin ℤ (Set.range (heckeTSymbolPos N w))

/-- Each positive-index Hecke operator belongs to the integral Hecke algebra. -/
theorem heckeTSymbol_mem_heckeTAlgebra (n : ℕ) [NeZero n] :
    heckeTSymbol ℤ w N n ∈ heckeTAlgebra N w := by
  let npos : ℕ+ := ⟨n, NeZero.pos n⟩
  exact Algebra.subset_adjoin (Set.mem_range.mpr ⟨npos, rfl⟩)

/-- The integral Hecke algebra acting on modular symbols is finitely generated as a
`ℤ`-module, even though it is generated as an algebra by infinitely many `Tₙ`. -/
theorem heckeTAlgebra_finite : Module.Finite ℤ (heckeTAlgebra N w) := by
  let : IsNoetherian ℤ (ModularSymbols ℤ (Gamma1 N) w) := inferInstance
  let : IsNoetherian ℤ
      (Module.End ℤ (ModularSymbols ℤ (Gamma1 N) w)) := inferInstance
  have : Module.Finite ℤ
      (Module.End ℤ (ModularSymbols ℤ (Gamma1 N) w)) :=
    ⟨IsNoetherian.noetherian ⊤⟩
  exact Module.Finite.of_injective (heckeTAlgebra N w).val.toLinearMap
    (fun _ _ h ↦ Subtype.ext h)

end TauCeti.ModularSymbols

end
