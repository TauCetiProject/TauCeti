module

public import TauCeti.NumberTheory.Multiquadratic.Quadratic.GenusCharacter.OrdinaryTwoRank
public import TauCeti.NumberTheory.Multiquadratic.Three.ClassNumber
import TauCeti.NumberTheory.Multiquadratic.Prime.Discriminants

/-!
# The `2`-ranks of the class groups of `ℚ(√3)`

The real quadratic field `K = ℚ(√3)` separates the two `2`-rank formulas of genus theory. Its
discriminant `12 = (-4) · (-3)` is a product of two prime discriminants, so `t = 2` rational
primes ramify (`2` and `3`), and the narrow formula gives `2-rank Cl⁺(K) = t - 1 = 1`. The
ordinary class group, however, is trivial
(`TauCeti.NumberField.classNumber_eq_one_of_minpoly_eq_X_sq_sub_three`), so
`2-rank Cl(K) = 0 = t - 2`: the formula `t - 1` is **false** for the ordinary class group of a
real quadratic field.

Genus theory gives the drop: both prime discriminants dividing `12` are negative, so
`TauCeti.Multiquadratic.twoRank_eq_ncard_ramifiedPrimes_sub_two_of_neg` already gives
`2-rank Cl(K) = t - 2` and, in particular,
`TauCeti.Multiquadratic.twoRank_eq_zero_of_minpoly_eq_X_sq_sub_three`.

Together with `2-rank Cl⁺(K) = 1` the triviality of `Cl(K)` pins the narrow class group down:
`Cl⁺(K)` is generated by principal classes, hence has exponent dividing `2`, hence is its own
maximal elementary-`2` quotient, of order `2`. So `ℚ(√3)` has class number `1` and narrow class
number `2`.

## References

* F. Lemmermeyer, *Reciprocity Laws: From Euler to Eisenstein*, §2.2.
* D. A. Cox, *Primes of the Form x² + ny²*, §6.A.

## Main results

* `TauCeti.Multiquadratic.ncard_ramifiedPrimes_eq_two_of_minpoly_eq_X_sq_sub_three`: `t = 2`.
* `TauCeti.Multiquadratic.narrowTwoRank_eq_one_of_minpoly_eq_X_sq_sub_three`: the narrow
  `2`-rank is `t - 1 = 1`.
* `TauCeti.Multiquadratic.twoRank_eq_zero_of_minpoly_eq_X_sq_sub_three` and
  `TauCeti.Multiquadratic.twoRank_ne_ncard_ramifiedPrimes_sub_one_of_minpoly_eq_X_sq_sub_three`:
  the ordinary `2`-rank is `0`, so the `t - 1` formula fails for `Cl(K)`.
* `TauCeti.Multiquadratic.natCard_narrowClassGroup_eq_two_of_minpoly_eq_X_sq_sub_three`: the
  narrow class number of `ℚ(√3)` is `2`.
-/

public section

open Polynomial NumberField
open scoped NumberField

namespace TauCeti.Multiquadratic

variable {K : Type*} [Field K] [NumberField K] {θ : 𝓞 K}

/-- `3` is squarefree as an integer, being prime. -/
private theorem squarefree_three : Squarefree (3 : ℤ) :=
  (Int.prime_iff_natAbs_prime.mpr (by decide)).squarefree

/-- **The `2`-rank of the narrow class group of `ℚ(√3)` is `1`.** The genus-theoretic formula
`2-rank Cl⁺(K) = t - 1` at `t = 2`. -/
theorem narrowTwoRank_eq_one_of_minpoly_eq_X_sq_sub_three
    (hmin : minpoly ℤ θ = X ^ 2 - C (3 : ℤ)) (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) :
    NumberField.NarrowClassGroup.twoRank K = 1 := by
  rw [narrowTwoRank_eq_ncard_ramifiedPrimes_sub_one hmin hgen squarefree_three,
    ncard_ramifiedPrimes_eq_two_of_minpoly_eq_X_sq_sub_three hmin hgen]

/-- **The `t - 1` formula fails for the ordinary class group of a real quadratic field.** In
`ℚ(√3)` two rational primes ramify while the class group is trivial, so its `2`-rank is `0`, not
`t - 1 = 1`. This is why `TauCeti.Multiquadratic.twoRank_eq_ncard_ramifiedPrimes_sub_one` is
restricted to imaginary quadratic fields and the unrestricted formula
`TauCeti.Multiquadratic.narrowTwoRank_eq_ncard_ramifiedPrimes_sub_one` is about the narrow class
group. -/
theorem twoRank_ne_ncard_ramifiedPrimes_sub_one_of_minpoly_eq_X_sq_sub_three
    (hmin : minpoly ℤ θ = X ^ 2 - C (3 : ℤ)) (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) :
    TauCeti.ClassGroup.twoRank (𝓞 K) ≠ (ramifiedPrimes K).ncard - 1 := by
  rw [twoRank_eq_zero_of_minpoly_eq_X_sq_sub_three hmin hgen,
    ncard_ramifiedPrimes_eq_two_of_minpoly_eq_X_sq_sub_three hmin hgen]
  decide

/-- **The narrow class number of `ℚ(√3)` is `2`.** Since the ordinary class group is trivial,
every narrow class is a principal class, so `Cl⁺(K)` has exponent dividing `2`
(`NumberField.NarrowClassGroup.mkPrincipal_sq`) and therefore coincides with its own maximal
elementary-`2` quotient, whose order is `2 ^ (t - 1) = 2`. -/
theorem natCard_narrowClassGroup_eq_two_of_minpoly_eq_X_sq_sub_three
    (hmin : minpoly ℤ θ = X ^ 2 - C (3 : ℤ)) (hgen : Algebra.adjoin ℚ {(θ : K)} = ⊤) :
    Nat.card (NumberField.NarrowClassGroup K) = 2 := by
  have hclass := TauCeti.NumberField.classNumber_eq_one_of_minpoly_eq_X_sq_sub_three hmin hgen
  rw [NumberField.NarrowClassGroup.card_eq_two_pow_twoRank_of_classNumber_eq_one K hclass,
    narrowTwoRank_eq_one_of_minpoly_eq_X_sq_sub_three hmin hgen]
  norm_num

/-- **Worked example.** In the concrete number field `AdjoinRoot (X² - 3)`, modelling `ℚ(√3)`,
two rational primes ramify. -/
@[simp]
theorem ncard_ramifiedPrimes_adjoinRoot_sqrt_three_eq_two :
    (ramifiedPrimes (AdjoinRoot (X ^ 2 - C (3 : ℚ)))).ncard = 2 := by
  obtain ⟨θ, hmin, hgen⟩ :=
    TauCeti.NumberField.exists_minpoly_eq_X_sq_sub_three_and_adjoin_eq_top
  exact ncard_ramifiedPrimes_eq_two_of_minpoly_eq_X_sq_sub_three hmin hgen

/-- **Worked example.** The concrete number field `AdjoinRoot (X² - 3)`, modelling `ℚ(√3)`, has
narrow class-group `2`-rank `1`. Not `@[simp]`: the `@[simp]` lemma
`NumberField.NarrowClassGroup.twoRank_def` unfolds the left-hand side, so this closed form is not
in simp-normal form. -/
theorem narrowTwoRank_adjoinRoot_sqrt_three_eq_one :
    NumberField.NarrowClassGroup.twoRank (AdjoinRoot (X ^ 2 - C (3 : ℚ))) = 1 := by
  obtain ⟨θ, hmin, hgen⟩ :=
    TauCeti.NumberField.exists_minpoly_eq_X_sq_sub_three_and_adjoin_eq_top
  exact narrowTwoRank_eq_one_of_minpoly_eq_X_sq_sub_three hmin hgen

/-- **Worked example.** The concrete number field `AdjoinRoot (X² - 3)`, modelling `ℚ(√3)`, has
ordinary class-group `2`-rank `0`, one less than the narrow one. Not `@[simp]`, for the same
reason as `narrowTwoRank_adjoinRoot_sqrt_three_eq_one`. -/
theorem twoRank_adjoinRoot_sqrt_three_eq_zero :
    TauCeti.ClassGroup.twoRank (𝓞 (AdjoinRoot (X ^ 2 - C (3 : ℚ)))) = 0 := by
  obtain ⟨θ, hmin, hgen⟩ :=
    TauCeti.NumberField.exists_minpoly_eq_X_sq_sub_three_and_adjoin_eq_top
  exact twoRank_eq_zero_of_minpoly_eq_X_sq_sub_three hmin hgen

/-- **The `t - 1` formula fails in the concrete model of `ℚ(√3)`.** Its ordinary class-group
`2`-rank is not one less than the number of ramified rational primes. -/
theorem twoRank_ne_ncard_ramifiedPrimes_sub_one_adjoinRoot_sqrt_three :
    TauCeti.ClassGroup.twoRank (𝓞 (AdjoinRoot (X ^ 2 - C (3 : ℚ)))) ≠
      (ramifiedPrimes (AdjoinRoot (X ^ 2 - C (3 : ℚ)))).ncard - 1 := by
  obtain ⟨θ, hmin, hgen⟩ :=
    TauCeti.NumberField.exists_minpoly_eq_X_sq_sub_three_and_adjoin_eq_top
  exact twoRank_ne_ncard_ramifiedPrimes_sub_one_of_minpoly_eq_X_sq_sub_three hmin hgen

/-- **Worked example.** The concrete number field `AdjoinRoot (X² - 3)`, modelling `ℚ(√3)`, has
narrow class number `2`, while its class number is `1`
(`TauCeti.NumberField.classNumber_adjoinRoot_sqrt_three_eq_one`). -/
@[simp]
theorem card_narrowClassGroup_adjoinRoot_sqrt_three_eq_two :
    @Fintype.card (NumberField.NarrowClassGroup (AdjoinRoot (X ^ 2 - C (3 : ℚ))))
      (Fintype.ofFinite _) = 2 := by
  obtain ⟨θ, hmin, hgen⟩ :=
    TauCeti.NumberField.exists_minpoly_eq_X_sq_sub_three_and_adjoin_eq_top
  rw [← @Nat.card_eq_fintype_card _ (Fintype.ofFinite _)]
  exact natCard_narrowClassGroup_eq_two_of_minpoly_eq_X_sq_sub_three hmin hgen

end TauCeti.Multiquadratic
