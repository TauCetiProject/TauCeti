module

public import TauCeti.FieldTheory.Galois.FixedField
public import TauCeti.FieldTheory.IntermediateField.Adjoin.Square
public import TauCeti.NumberTheory.Multiquadratic.Legendre.PrimeDiscriminant.Dirichlet.Group
public import TauCeti.NumberTheory.NumberField.Cyclotomic.CharacterSubfield
public import TauCeti.NumberTheory.NumberField.Cyclotomic.GaussSum
public import Mathlib.Analysis.Complex.Polynomial.Basic
public import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed

/-!
# The cyclotomic subfield cut out by a prime-discriminant character group

Let `s` be a finite family of prime discriminants and `N = |∏ P ∈ s, P|`. Inside the `N`-th
cyclotomic field `K`, Mathlib's character correspondence
`IsCyclotomicExtension.Rat.intermediateFieldEquivSubgroupChar` attaches an intermediate field to
every subgroup of Dirichlet characters of level `N`. This file identifies the field attached to
the prime-discriminant character group `genusCharGroup s hs` (the characters of the subsets of
`s`) with the compositum `ℚ(√P : P ∈ s)`.

The square roots are Gauss sums: for `P ∈ s`, the Gauss sum of the primitive character of `P`,
formed with a primitive `|P|`-th root of unity in `K`, squares to `P`, and its Galois stabilizer
is the kernel of that character lifted to level `N`. Intersecting these kernels and applying the
Galois correspondence gives the compositum.

Together with the conductor criterion `Subgroup.characterSubfield_le_iff_dirichletConductor_dvd`
and the conductor `dirichletConductor_genusCharGroup` of the character group, this determines
exactly which cyclotomic subfields of `K` contain the compositum: the field `ℚ(ζ_m)`, for `m ∣ N`,
contains it exactly when the least common multiple of the `|P|` divides `m`. When `s` has at most
one even member, this least common multiple is `N` itself.

See K. Ireland and M. Rosen, *A Classical Introduction to Modern Number Theory*, Chapter 6, and
D. A. Cox, *Primes of the Form x² + ny²*, §§3.B and 6.A.

## Main results

* `gaussSumOfPrimitiveRoot_primeDiscriminantChar_sq`: the Gauss sum of the character of a prime
  discriminant `P` squares to `P`.
* `characterSubfield_genusCharGroup_eq_adjoin_range`: the prime-discriminant character group cuts
  out the compositum of the fields `ℚ(√P)`.
* `adjoin_range_le_iff_lcm_dvd`: that compositum lies in the `m`-th cyclotomic subfield exactly
  when the least common multiple of the `|P|` divides `m`.
* `adjoin_range_le_iff_eq_natAbs_prod`: with at most one even member, `|∏ P ∈ s, P|` is the only
  such level dividing `|∏ P ∈ s, P|`.
-/

public section

open IntermediateField IsCyclotomicExtension IsCyclotomicExtension.Rat DirichletCharacter

namespace TauCeti.Multiquadratic

/-- **The Gauss sum of a prime discriminant squares to it.** In any field of characteristic zero,
the Gauss sum of the character of the prime discriminant `P`, formed with a primitive `|P|`-th
root of unity, is a square root of `P`. -/
theorem gaussSumOfPrimitiveRoot_primeDiscriminantChar_sq {L : Type*} [Field L] [CharZero L]
    {P : ℤ} (hP : IsPrimeDiscriminant P) [NeZero P.natAbs] {ζ : L}
    (hζ : IsPrimitiveRoot ζ P.natAbs) :
    gaussSumOfPrimitiveRoot (primeDiscriminantChar P hP) hζ ^ 2 = (P : L) := by
  have hneg := primeDiscriminantChar_apply_int P hP (-1)
  rw [Int.cast_neg, Int.cast_one, primeDiscriminantCharFun_neg_one hP] at hneg
  rw [gaussSumOfPrimitiveRoot_sq _ (isPrimitive_primeDiscriminantChar P hP)
    (isQuadratic_primeDiscriminantChar P hP), MulChar.ringHomComp_apply, hneg, ZMod.card,
    eq_intCast, ← Int.cast_natCast, ← Int.cast_mul, Int.sign_mul_natAbs]

variable (s : Finset ℤ) (hs : ∀ P ∈ s, IsPrimeDiscriminant P)

variable {K : Type*} [Field K] [NumberField K] [IsCyclotomicExtension {(∏ P ∈ s, P).natAbs} ℚ K]

/-- **The prime-discriminant character group cuts out the prime-discriminant compositum.** Inside
the `|∏ P ∈ s, P|`-th cyclotomic field `K`, the intermediate field attached to the characters of
the subsets of `s` (with values pushed into any ring `R` of characteristic zero with enough roots
of unity) is generated by square roots of the members of `s`. -/
theorem characterSubfield_genusCharGroup_eq_adjoin_range [NeZero (∏ P ∈ s, P).natAbs]
    [IsAbelianGalois ℚ K] (R : Type*) [CommRing R] [CharZero R]
    [HasEnoughRootsOfUnity R (Monoid.exponent (ZMod (∏ P ∈ s, P).natAbs)ˣ)]
    (r : s → K) (hr : ∀ P, r P ^ 2 = (P : K)) :
    (intermediateFieldEquivSubgroupChar (∏ P ∈ s, P).natAbs K R).symm
        ((genusCharGroup s hs).map (MulChar.ringHomCompHom (Int.castRingHom R))) =
      adjoin ℚ (Set.range r) := by
  set N := (∏ P ∈ s, P).natAbs
  have hdvd (P : s) : P.val.natAbs ∣ N :=
    Int.natAbs_dvd_natAbs.mpr (Finset.dvd_prod_of_mem id P.property)
  have hne (P : s) : NeZero P.val.natAbs := ⟨Int.natAbs_ne_zero.mpr (hs P P.property).ne_zero⟩
  -- A primitive `|P|`-th root of unity in `K`, and the Gauss sum of `P` formed with it.
  have hζ (P : s) : IsPrimitiveRoot (zeta N ℚ K ^ (N / P.val.natAbs)) P.val.natAbs := by
    simpa only [Nat.div_div_self (hdvd P) (NeZero.ne N)] using
      (zeta_spec N ℚ K).pow_of_dvd (Nat.div_ne_zero_iff_of_dvd (hdvd P) |>.mpr
        ⟨NeZero.ne N, (hne P).out⟩) (Nat.div_dvd_of_dvd (hdvd P))
  let g (P : s) : K := gaussSumOfPrimitiveRoot (primeDiscriminantChar P (hs P P.property)) (hζ P)
  -- The automorphisms killed by the character group are the common stabilizer of the `g P`.
  have hker : (subgroupGalEquivSubgroupChar N K R).symm (OrderDual.toDual
      ((genusCharGroup s hs).map (MulChar.ringHomCompHom (Int.castRingHom R)))) =
        ⨅ P, MulAction.stabilizer Gal(K/ℚ) (g P) := by
    ext σ
    rw [mem_subgroupGalEquivSubgroupChar_symm_iff, Subgroup.mem_iInf]
    simp_rw [g, mem_stabilizer_gaussSumOfPrimitiveRoot_iff_changeLevel _
      (isPrimitive_primeDiscriminantChar _ _) (hdvd _)]
    constructor
    · intro h P
      have hP := h _ (Subgroup.mem_map_of_mem _
        ((mem_genusCharGroup_iff s hs).mpr ⟨{P}, genusCharAtLevel_singleton ..⟩))
      rwa [MulChar.ringHomCompHom_apply, MulChar.ringHomComp_apply, eq_intCast,
        Int.cast_eq_one, primeDiscriminantCharAtLevel_def] at hP
    · rintro h _ ⟨χ, hχ, rfl⟩
      obtain ⟨t, rfl⟩ := (mem_genusCharGroup_iff s hs).mp hχ
      -- A product of characters that are all trivial at `galEquivZMod N K σ` is trivial there.
      have ht : genusCharAtLevel s hs t (galEquivZMod N K σ) = 1 := by
        rw [genusCharAtLevel_def]
        exact Finset.prod_induction _ (fun χ : DirichletCharacter ℤ N ↦ χ (galEquivZMod N K σ) = 1)
          (fun a b ha hb ↦ by rw [MulChar.mul_apply, ha, hb, one_mul])
          (MulChar.one_apply_coe _) fun P _ ↦ by rw [primeDiscriminantCharAtLevel_def]; exact h P
      rw [MulChar.ringHomCompHom_apply, MulChar.ringHomComp_apply, ht, map_one]
  rw [intermediateFieldEquivSubgroupChar_symm_apply, hker,
    fixedField_iInf_stabilizer_eq_adjoin_range]
  apply TauCeti.IntermediateField.adjoin_eq_adjoin_of_forall_sq_eq
  · rintro _ ⟨P, rfl⟩
    exact ⟨r P, ⟨P, rfl⟩, by rw [hr, gaussSumOfPrimitiveRoot_primeDiscriminantChar_sq]⟩
  · rintro _ ⟨P, rfl⟩
    exact ⟨g P, ⟨P, rfl⟩, by rw [hr, gaussSumOfPrimitiveRoot_primeDiscriminantChar_sq]⟩

include hs in
/-- **The least cyclotomic level of a prime-discriminant compositum.** Inside the
`|∏ P ∈ s, P|`-th cyclotomic field, the field generated by square roots of the members of `s`
lies in the cyclotomic subfield of level `m` exactly when the least common multiple of the `|P|`
divides `m`. -/
theorem adjoin_range_le_iff_lcm_dvd (r : s → K) (hr : ∀ P, r P ^ 2 = (P : K))
    {m : ℕ} (F : IntermediateField ℚ K) [IsGalois ℚ F] [IsCyclotomicExtension {m} ℚ F]
    (hmN : m ∣ (∏ P ∈ s, P).natAbs) :
    adjoin ℚ (Set.range r) ≤ F ↔ s.lcm Int.natAbs ∣ m := by
  let _ := neZero_natAbs_prod_of_forall_isPrimeDiscriminant hs
  let _ := IsCyclotomicExtension.isAbelianGalois {(∏ P ∈ s, P).natAbs} ℚ K
  rw [← characterSubfield_genusCharGroup_eq_adjoin_range s hs ℂ r hr,
    Subgroup.characterSubfield_le_iff_dirichletConductor_dvd _ F hmN,
    Subgroup.dirichletConductor_map_ringHomComp _ _ Int.cast_injective,
    dirichletConductor_genusCharGroup]

include hs in
/-- **The exact cyclotomic level of a prime-discriminant compositum.** If `s` has at most one even
member, then of the cyclotomic subfields `ℚ(ζ_m)`, `m ∣ |∏ P ∈ s, P|`, of the
`|∏ P ∈ s, P|`-th cyclotomic field, only the whole field contains the square roots of the members
of `s`. -/
theorem adjoin_range_le_iff_eq_natAbs_prod
    (heven : ∀ P ∈ s, ∀ Q ∈ s,
      IsEvenPrimeDiscriminant P → IsEvenPrimeDiscriminant Q → P = Q)
    (r : s → K) (hr : ∀ P, r P ^ 2 = (P : K))
    {m : ℕ} (F : IntermediateField ℚ K) [IsGalois ℚ F] [IsCyclotomicExtension {m} ℚ F]
    (hmN : m ∣ (∏ P ∈ s, P).natAbs) :
    adjoin ℚ (Set.range r) ≤ F ↔ m = (∏ P ∈ s, P).natAbs := by
  rw [adjoin_range_le_iff_lcm_dvd s hs r hr F hmN,
    lcm_natAbs_eq_natAbs_prod_of_forall_isPrimeDiscriminant hs heven]
  exact ⟨Nat.dvd_antisymm hmN, fun h ↦ h ▸ dvd_rfl⟩

end TauCeti.Multiquadratic
