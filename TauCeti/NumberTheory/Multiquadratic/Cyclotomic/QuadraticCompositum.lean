module

public import Mathlib.NumberTheory.FundamentalDiscriminant
public import TauCeti.RingTheory.Cyclotomic.ComplexField
import TauCeti.FieldTheory.IntermediateField.Adjoin.EqTop
import TauCeti.NumberTheory.Cyclotomic.RootsOfUnity
import TauCeti.NumberTheory.Multiquadratic.Cyclotomic.Conductor

/-!
# The quadratic compositum inside a rational cyclotomic field

`AlgHom.fieldRange_le_complexField_iff_of_isCyclotomicExtension` determines when a cyclotomic
extension of a quadratic field embeds into a specified rational cyclotomic field of even level.
It combines `TauCeti.Multiquadratic.mem_adjoin_simple_iff_natAbs_dvd` with the root-of-unity order
criterion `IsPrimitiveRoot.mem_iff_dvd_of_isCyclotomicExtension_even`.

The containment of the compositum in the cyclotomic field of product level is the construction
`New.Parameters.toCycloField` in `New/Reduction/Data/FieldsAndPlaces.lean` of
[lsernau/grh-lean](https://github.com/lsernau/grh-lean) (Apache 2.0, revision `72fead1`).
See also Washington,
*Introduction to Cyclotomic Fields*, Chapter 2.
-/

public section

open IntermediateField IsCyclotomicExtension TauCeti.Cyclotomic TauCeti.Multiquadratic

namespace AlgHom

/-- If `E = K(ζₙ)` and `K` is generated by a square root of a fundamental discriminant `D`,
the image of a complex embedding of `E` lies in the even-level cyclotomic field `ℚ(ζₘ)`
exactly when both `n` and `|D|` divide `m`. -/
theorem fieldRange_le_complexField_iff_of_isCyclotomicExtension
    {K E : Type*} [Field K] [Field E] [Algebra ℚ K] [Algebra ℚ E] [Algebra K E]
    (e : E →ₐ[ℚ] ℂ) {n m : ℕ} [NeZero n] [NeZero m]
    [IsCyclotomicExtension {n} K E] (hm : Even m) {D : ℤ} (hD : Int.IsFundamentalDiscr D)
    {x : K} (hx : x ^ 2 = (D : K)) (hgen : ℚ⟮x⟯ = ⊤) :
    e.fieldRange ≤ complexField m ↔ n ∣ m ∧ D.natAbs ∣ m := by
  let ζ := zeta n K E
  let i := IsScalarTower.toAlgHom ℚ K E
  have hx' : (e (i x)) ^ 2 = (D : ℂ) := by
    rw [← map_pow, ← map_pow, hx, map_intCast, map_intCast]
  have hζ : IsPrimitiveRoot (e ζ) n := (zeta_spec n K E).map_of_injective e.injective
  have hi : i.fieldRange = ℚ⟮i x⟯ := by
    rw [← IntermediateField.map_top, ← hgen, adjoin_map, Set.image_singleton]
  have hE : ℚ⟮ζ⟯ ⊔ ℚ⟮i x⟯ = ⊤ := by
    rw [← hi]
    exact TauCeti.IntermediateField.adjoin_sup_fieldRange_eq_top ℚ K E
      (adjoin_eq_top_of_algebra K _ (adjoin_primitive_root_eq_top (zeta_spec n K E)))
  have hRange : e.fieldRange = ℚ⟮e ζ⟯ ⊔ ℚ⟮e (i x)⟯ := by
    rw [← IntermediateField.map_top, ← hE, IntermediateField.map_sup]
    simp only [adjoin_map, Set.image_singleton]
  have hxmem : e (i x) ∈ complexField m ↔ D.natAbs ∣ m := by
    rw [complexField_def]
    exact mem_adjoin_simple_iff_natAbs_dvd (NeZero.pos m) isPrimitiveRoot_complexRoot hD hx'
  rw [hRange, sup_le_iff]
  simp only [adjoin_simple_le_iff, hxmem,
    hζ.mem_iff_dvd_of_isCyclotomicExtension_even (complexField m) hm]

end AlgHom
