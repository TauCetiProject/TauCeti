module

public import TauCeti.NumberTheory.BinaryQuadraticForm.Ideal.Composition
public import TauCeti.NumberTheory.BinaryQuadraticForm.Ideal.Narrow.Equivalence

/-!
# Dirichlet composition and the principal form in the narrow Picard group

This file computes the narrow Picard product of the oriented classes of primitive binary quadratic
forms presented in Dirichlet shape, and the identity via the principal form. It is the narrow
analogue of `TauCeti.NumberTheory.BinaryQuadraticForm.Ideal.Composition`, and it is what makes the
bijection `properClassEquivNarrowPic` between proper classes of positive nonsquare discriminant and
the narrow Picard group a dictionary of group laws.

*Composition.* For primitive forms `f = (a, B, a'C)` and `g = (a', B, aC)` of nonsquare
discriminant `D` with Dirichlet composition `h = (aa', B, C)`, the form ideals multiply:
`𝔞_f 𝔞_g = 𝔞_h` (`fractionalIdeal_mk_mul_fractionalIdeal_mk`). The oriented class of a form also
carries the correction `√D` when its leading coefficient is negative. These corrections are
compatible with the product: if exactly one of `a` and `a'` is negative then so is `aa'`, and
both sides carry one factor `√D`; if both are negative then `aa'` is positive, and the two factors
on the left multiply to the principal ideal `(√D)² = (D)`, which is narrowly trivial because it is
generated by a square. So the oriented narrow class of `h` is the product of those of `f` and `g`
(`narrowPicClass_mul_narrowPicClass_of_united`), for every nonsquare discriminant and every sign of
the leading coefficients.

*The principal form.* The principal form has leading coefficient `1`, so its oriented ideal is
the unit ideal and its narrow class is trivial (`narrowPicClass_principalForm`).

For positive nonsquare `D`, on proper classes of primitive forms through the bijection
`properClassToNarrowPic`, the class of a Dirichlet composition maps to the product
(`properClassToNarrowPic_mk_mul_of_united`), every pair of proper classes has united
representatives whose composition represents the product
(`exists_properClassToNarrowPic_mul_properClassToNarrowPic_eq`), and a class maps to `1` exactly
when it is the class of the principal form (`properClassToNarrowPic_eq_one_iff`).

## References

* D. A. Cox, *Primes of the Form x² + ny²*, §3, Lemma 3.2 and the definition of Dirichlet
  composition, and §7, Theorem 7.7 and the narrow analogue.
-/

public section

open QuadraticAlgebra FractionalIdeal MulAction
open scoped MatrixGroups nonZeroDivisors

namespace TauCeti.BinaryQuadraticForm

open GlobalNumberFields

/-! ### Oriented classes of forms -/

section Forms

variable {D : ℤ} [Fact (¬ IsSquare D)]

/-- The orientation corrections of forms with nonzero leading coefficients `a` and `a'` multiply,
in the narrow Picard group, to the correction of a form with leading coefficient `aa'`. -/
private theorem mkPrincipal_idealSignFactor_mul_idealSignFactor
    (O : NumberFieldOrder (QuadraticAlgebra ℚ (D : ℚ) 0)) {f g h : BinaryQuadraticForm ℤ}
    (hfa : f.a ≠ 0) (hga : g.a ≠ 0) (hh : h.a = f.a * g.a) :
    NarrowPic.mkPrincipal O (f.idealSignFactor D) * NarrowPic.mkPrincipal O (g.idealSignFactor D) =
      NarrowPic.mkPrincipal O (h.idealSignFactor D) := by
  -- Any two nonpositive leading coefficients carry the same correction `√D`.
  have hω {k l : BinaryQuadraticForm ℤ} (hk : ¬ 0 < k.a) (hl : ¬ 0 < l.a) :
      k.idealSignFactor D = l.idealSignFactor D :=
    Units.ext (by rw [coe_idealSignFactor_of_not_a_pos k D hk,
      coe_idealSignFactor_of_not_a_pos l D hl])
  rcases hfa.lt_or_gt with ha | ha <;> rcases hga.lt_or_gt with hb | hb
  · rw [idealSignFactor_of_a_pos h D (hh ▸ mul_pos_of_neg_of_neg ha hb),
      hω (not_lt.mpr hb.le) (not_lt.mpr ha.le), map_one, ← sq, NarrowPic.mkPrincipal_sq]
  · rw [idealSignFactor_of_a_pos g D hb, map_one, mul_one,
      hω (not_lt.mpr ha.le) (hh ▸ not_lt.mpr (mul_neg_of_neg_of_pos ha hb).le)]
  · rw [idealSignFactor_of_a_pos f D ha, map_one, one_mul,
      hω (not_lt.mpr hb.le) (hh ▸ not_lt.mpr (mul_neg_of_pos_of_neg ha hb).le)]
  · rw [idealSignFactor_of_a_pos f D ha, idealSignFactor_of_a_pos g D hb,
      idealSignFactor_of_a_pos h D (hh ▸ mul_pos ha hb), map_one, mul_one]

/-- **Dirichlet composition multiplies oriented narrow classes.** If primitive forms
`f = (a, B, a'C)` and `g = (a', B, aC)` of nonsquare discriminant `D` have Dirichlet composition
`h = (aa', B, C)`, then the oriented narrow class of `h` is the product of those of `f` and `g`. -/
theorem narrowPicClass_mul_narrowPicClass_of_united {a a' B C : ℤ}
    (hD : (⟨a * a', B, C⟩ : BinaryQuadraticForm ℤ).discrim = D)
    (hfp : (⟨a, B, a' * C⟩ : BinaryQuadraticForm ℤ).IsPrimitive)
    (hgp : (⟨a', B, a * C⟩ : BinaryQuadraticForm ℤ).IsPrimitive) :
    (⟨a, B, a' * C⟩ : BinaryQuadraticForm ℤ).narrowPicClass D
        ((discrim_mk_mul_left a a' B C).trans hD) hfp *
      (⟨a', B, a * C⟩ : BinaryQuadraticForm ℤ).narrowPicClass D
        ((discrim_mk_mul_right a a' B C).trans hD) hgp =
      (⟨a * a', B, C⟩ : BinaryQuadraticForm ℤ).narrowPicClass D hD
        (isPrimitive_mk_mul_of_isPrimitive hfp hgp) := by
  have hf := (discrim_mk_mul_left a a' B C).trans hD
  have hg := (discrim_mk_mul_right a a' B C).trans hD
  have hI := fractionalIdeal_mk_mul_fractionalIdeal_mk hD hfp
  rw [← coe_invertibleFractionalIdeal _ D hf hfp, ← coe_invertibleFractionalIdeal _ D hg hgp,
    ← coe_invertibleFractionalIdeal _ D hD (isPrimitive_mk_mul_of_isPrimitive hfp hgp),
    ← Units.val_mul, Units.val_inj] at hI
  have hsign := mkPrincipal_idealSignFactor_mul_idealSignFactor
    (QuadraticOrder.numberFieldOrder D (hD ▸ discrim_emod_four_eq_zero_or_one _))
    (f := ⟨a, B, a' * C⟩) (g := ⟨a', B, a * C⟩) (h := ⟨a * a', B, C⟩)
    (a_ne_zero_of_not_isSquare_discrim (hf ▸ Fact.out))
    (a_ne_zero_of_not_isSquare_discrim (hg ▸ Fact.out)) rfl
  simp only [NarrowPic.mkPrincipal_apply] at hsign
  simp only [narrowPicClass_def, orientedInvertibleFractionalIdeal_def, map_mul]
  rw [← hsign, ← hI, map_mul]
  exact mul_mul_mul_comm _ _ _ _

/-- **The principal form has trivial oriented narrow class.** -/
@[simp] theorem narrowPicClass_principalForm (hf : (principalForm D).discrim = D)
    (hprim : (principalForm D).IsPrimitive) : (principalForm D).narrowPicClass D hf hprim = 1 := by
  rw [narrowPicClass_def, orientedInvertibleFractionalIdeal_of_a_pos _ _ _ _ (by simp),
    invertibleFractionalIdeal_eq_one_of_isUnit_a _ _ _ _ (by simp), map_one]

end Forms

/-! ### The group law on proper classes of positive discriminant -/

section Classes

variable (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) [Fact (¬ IsSquare D)] (hpos : 0 < D)

/-- **Dirichlet composition of proper classes.** If primitive forms `f = (a, B, a'C)` and
`g = (a', B, aC)` of positive nonsquare discriminant `D` have Dirichlet composition
`h = (aa', B, C)`, then the narrow class of the proper class of `h` is the product of those of `f`
and `g`. -/
theorem properClassToNarrowPic_mk_mul_of_united {a a' B C : ℤ} {f g h : primitiveForms D}
    (hf : (f : BinaryQuadraticForm ℤ) = ⟨a, B, a' * C⟩)
    (hg : (g : BinaryQuadraticForm ℤ) = ⟨a', B, a * C⟩)
    (hh : (h : BinaryQuadraticForm ℤ) = ⟨a * a', B, C⟩) :
    properClassToNarrowPic D hD hpos (Quotient.mk'' f) *
        properClassToNarrowPic D hD hpos (Quotient.mk'' g) =
      properClassToNarrowPic D hD hpos (Quotient.mk'' h) := by
  obtain ⟨f, hfm⟩ := f
  obtain ⟨g, hgm⟩ := g
  obtain ⟨h, hhm⟩ := h
  simp only at hf hg hh
  subst hf hg hh
  obtain ⟨-, hfp⟩ := (mem_primitiveForms D _).mp hfm
  obtain ⟨-, hgp⟩ := (mem_primitiveForms D _).mp hgm
  obtain ⟨hhD, -⟩ := (mem_primitiveForms D _).mp hhm
  simp only [properClassToNarrowPic_mk]
  exact narrowPicClass_mul_narrowPicClass_of_united hhD hfp hgp

/-- **Every product of proper classes is a Dirichlet composition.** Any two proper classes of
primitive forms of positive nonsquare discriminant `D` have representatives `f = (a, B, a'C)` and
`g = (a', B, aC)`; their composition `h = (aa', B, C)` is again primitive of discriminant `D`, and
its proper class maps to the product of the narrow classes. -/
theorem exists_properClassToNarrowPic_mul_properClassToNarrowPic_eq
    (q₁ q₂ : orbitRel.Quotient SL(2, ℤ) (primitiveForms D)) :
    ∃ (a a' B C : ℤ) (f g h : primitiveForms D),
      Quotient.mk'' f = q₁ ∧ Quotient.mk'' g = q₂ ∧
      (f : BinaryQuadraticForm ℤ) = ⟨a, B, a' * C⟩ ∧ (g : BinaryQuadraticForm ℤ) = ⟨a', B, a * C⟩ ∧
      (h : BinaryQuadraticForm ℤ) = ⟨a * a', B, C⟩ ∧
      properClassToNarrowPic D hD hpos q₁ * properClassToNarrowPic D hD hpos q₂ =
        properClassToNarrowPic D hD hpos (Quotient.mk'' h) := by
  induction q₁ using Quotient.inductionOn with | h f₀ => ?_
  induction q₂ using Quotient.inductionOn with | h g₀ => ?_
  obtain ⟨γ, δ, a, a', B, C, h, hf, hg, hh, -⟩ := exists_picClass_mul_picClass_eq D hD f₀ g₀
  refine ⟨a, a', B, C, γ • f₀, δ • g₀, h, orbitRel.Quotient.quotient_smul_eq,
    orbitRel.Quotient.quotient_smul_eq, hf, hg, hh, ?_⟩
  rw [← orbitRel.Quotient.quotient_smul_eq (g := γ) (a := f₀),
    ← orbitRel.Quotient.quotient_smul_eq (g := δ) (a := g₀)]
  exact properClassToNarrowPic_mk_mul_of_united D hD hpos hf hg hh

/-- **The principal proper class has trivial narrow class.** -/
theorem properClassToNarrowPic_principalForm :
    properClassToNarrowPic D hD hpos
      (Quotient.mk'' ⟨principalForm D, principalForm_mem_primitiveForms hD⟩) = 1 := by
  rw [properClassToNarrowPic_mk]
  exact narrowPicClass_principalForm _ _

/-- **The trivial narrow class is the class of the principal form.** A proper class of primitive
forms of positive nonsquare discriminant `D` has trivial narrow class exactly when it is the class
of the principal form. -/
@[simp] theorem properClassToNarrowPic_eq_one_iff
    (q : orbitRel.Quotient SL(2, ℤ) (primitiveForms D)) :
    properClassToNarrowPic D hD hpos q = 1 ↔
      q = Quotient.mk'' ⟨principalForm D, principalForm_mem_primitiveForms hD⟩ := by
  rw [← properClassToNarrowPic_principalForm D hD hpos,
    (properClassToNarrowPic_injective D hD hpos).eq_iff]

end Classes

end TauCeti.BinaryQuadraticForm
