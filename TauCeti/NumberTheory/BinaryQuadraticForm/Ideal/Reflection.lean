module

public import TauCeti.NumberTheory.BinaryQuadraticForm.Ideal.Class
public import TauCeti.NumberTheory.BinaryQuadraticForm.Ideal.Narrow.Equivalence
public import TauCeti.NumberTheory.BinaryQuadraticForm.Reflection
import Mathlib.Tactic.LinearCombination

/-!
# Opposite forms and inverse ideal classes

The opposite of a binary quadratic form `f = (a, b, c)` is its reflection `f⁻ = (a, -b, c)`
(`TauCeti.BinaryQuadraticForm.reflected`). On the ideal side it is the conjugate: the ideal
`aℤ + ((b + √D)/2)ℤ` of `f⁻` is the image of `aℤ + ((-b + √D)/2)ℤ` under `√D ↦ -√D`. For a
primitive form of nonsquare discriminant `D` the product of the two ideals is the principal
ideal `(a)` of the quadratic order of discriminant `D` (`fractionalIdeal_reflected_mul`): the
four products of generators are `a` times `a`, `(-b + √D)/2`, `(b + √D)/2` and `-c`, and these
generate the unit ideal because `gcd(a, b, c) = 1`.

Consequently the opposite form has the inverse class, both in the Picard group
(`picClass_reflected`) and, with the sign correction by `√D` for negative leading coefficient,
in the narrow Picard group (`narrowPicClass_reflected`). Combined with the injectivity of the
form-ideal correspondence this gives the classical criterion for ambiguous classes: a primitive
form is properly equivalent to its opposite exactly when its class has order dividing two, in
`Pic` for positive definite forms (`exists_eq_smul_reflected_iff_picClass_sq_eq_one`) and in
`NarrowPic` for positive nonsquare discriminant
(`exists_eq_smul_reflected_iff_narrowPicClass_sq_eq_one`).

## References

* D. A. Cox, *Primes of the Form x² + ny²*, §3 (opposite forms and ambiguous forms) and §7,
  Theorem 7.7 and the narrow analogue.
-/

public section

open QuadraticAlgebra FractionalIdeal
open scoped MatrixGroups nonZeroDivisors

namespace TauCeti.BinaryQuadraticForm

variable {f : BinaryQuadraticForm ℤ} {D : ℤ}

/-- The product of the second ideal generators of a form and of its opposite is `-a c`:
`((b + √D)/2) ((-b + √D)/2) = (D - b²)/4`. -/
theorem idealGenerator_reflected_mul_idealGenerator (hf : f.discrim = D) :
    f.reflected.idealGenerator D * f.idealGenerator D =
      -((f.a : QuadraticAlgebra ℚ (D : ℚ) 0) * f.c) := by
  have hd : (f.b : ℚ) ^ 2 - 4 * (f.a : ℚ) * (f.c : ℚ) = (D : ℚ) := by
    exact_mod_cast hf
  ext <;> simp
  · linear_combination -hd / 4
  · ring

/-- The second ideal generators of a form and of its opposite differ by the middle coefficient. -/
theorem idealGenerator_reflected_sub_idealGenerator :
    f.reflected.idealGenerator D - f.idealGenerator D =
      (f.b : QuadraticAlgebra ℚ (D : ℚ) 0) := by
  ext <;> simp
  ring

variable [Fact (¬ IsSquare D)]

/-- An element of the form ideal belongs to the quadratic order. -/
private theorem exists_algebraMap_eq_of_mem_fractionalIdeal (hf : f.discrim = D)
    {z : QuadraticAlgebra ℚ (D : ℚ) 0} (hz : z ∈ f.fractionalIdeal D hf) :
    ∃ y : (QuadraticOrder.numberFieldOrder D
      (hf ▸ f.discrim_emod_four_eq_zero_or_one)).toSubalgebra,
      algebraMap _ (QuadraticAlgebra ℚ (D : ℚ) 0) y = z :=
  (mem_one_iff _).mp (fractionalIdeal_le_one f D hf hz)

/-- **A form ideal times the ideal of the opposite form is principal.** For a primitive form
`(a, b, c)` of nonsquare discriminant `D`,
`(aℤ + ((b + √D)/2)ℤ) (aℤ + ((-b + √D)/2)ℤ) = a O_D`. -/
theorem fractionalIdeal_reflected_mul (hf : f.discrim = D) (hprim : f.IsPrimitive) :
    f.reflected.fractionalIdeal D (f.discrim_reflected.trans hf) * f.fractionalIdeal D hf =
      spanSingleton _ (f.a : QuadraticAlgebra ℚ (D : ℚ) 0) := by
  have hf' : f.reflected.discrim = D := f.discrim_reflected.trans hf
  have hα : (f.a : QuadraticAlgebra ℚ (D : ℚ) 0) ∈ f.fractionalIdeal D hf :=
    a_mem_fractionalIdeal f D hf
  have hα' : (f.a : QuadraticAlgebra ℚ (D : ℚ) 0) ∈ f.reflected.fractionalIdeal D hf' := by
    simpa using a_mem_fractionalIdeal f.reflected D hf'
  have hβ : f.idealGenerator D ∈ f.fractionalIdeal D hf :=
    idealGenerator_mem_fractionalIdeal f D hf
  have hβ' : f.reflected.idealGenerator D ∈ f.reflected.fractionalIdeal D hf' :=
    idealGenerator_mem_fractionalIdeal f.reflected D hf'
  have hprod := idealGenerator_reflected_mul_idealGenerator hf
  have hdiff : f.reflected.idealGenerator D - f.idealGenerator D = f.b :=
    idealGenerator_reflected_sub_idealGenerator
  apply le_antisymm
  · -- The product is generated by `a²`, `a β`, `a β'` and `β' β = -a c`, all multiples of `a`
    -- by elements of the order.
    have hαK : (f.a : QuadraticAlgebra ℚ (D : ℚ) 0) ∈ spanSingleton (nonZeroDivisors
        (QuadraticOrder.numberFieldOrder D (hf ▸ f.discrim_emod_four_eq_zero_or_one)).toSubalgebra)
        (f.a : QuadraticAlgebra ℚ (D : ℚ) 0) :=
      mem_spanSingleton_self _ _
    have hmem {z : QuadraticAlgebra ℚ (D : ℚ) 0} (hz : z ∈ f.fractionalIdeal D hf) :
        z * f.a ∈ spanSingleton (nonZeroDivisors (QuadraticOrder.numberFieldOrder D
          (hf ▸ f.discrim_emod_four_eq_zero_or_one)).toSubalgebra)
          (f.a : QuadraticAlgebra ℚ (D : ℚ) 0) := by
      obtain ⟨y, rfl⟩ := exists_algebraMap_eq_of_mem_fractionalIdeal hf hz
      exact (mem_spanSingleton _).mpr ⟨y, Algebra.smul_def y _⟩
    rw [mul_le]
    intro i hi j hj
    obtain ⟨m, n, rfl⟩ := (mem_fractionalIdeal_iff f.reflected D hf' i).mp hi
    obtain ⟨m', n', rfl⟩ := (mem_fractionalIdeal_iff f D hf j).mp hj
    have key : (m • ((f.reflected.a : ℤ) : QuadraticAlgebra ℚ (D : ℚ) 0) +
        n • f.reflected.idealGenerator D) * (m' • (f.a : QuadraticAlgebra ℚ (D : ℚ) 0) +
          n' • f.idealGenerator D) =
        (m * m') • ((f.a : QuadraticAlgebra ℚ (D : ℚ) 0) * f.a) +
          (m * n') • (f.idealGenerator D * f.a) +
          (n * m') • (f.idealGenerator D * f.a + f.b • (f.a : QuadraticAlgebra ℚ (D : ℚ) 0)) +
          (n * n') • ((-f.c) • (f.a : QuadraticAlgebra ℚ (D : ℚ) 0)) := by
      simp only [reflected_a, zsmul_eq_mul]
      push_cast
      linear_combination (n : QuadraticAlgebra ℚ (D : ℚ) 0) * m' * f.a * hdiff +
        (n : QuadraticAlgebra ℚ (D : ℚ) 0) * n' * hprod
    rw [key, ← mem_coe]
    have hαK' := mem_coe.mpr hαK
    exact add_mem (add_mem (add_mem (zsmul_mem (mem_coe.mpr (hmem hα)) _)
      (zsmul_mem (mem_coe.mpr (hmem hβ)) _))
      (zsmul_mem (add_mem (mem_coe.mpr (hmem hβ)) (zsmul_mem hαK' _)) _))
      (zsmul_mem (zsmul_mem hαK' _) _)
  · -- Conversely `a = u a² + v a b + w a c` for a Bézout relation `u a + v b + w c = 1`.
    rw [spanSingleton_le_iff_mem]
    obtain ⟨u, v, w, huvw⟩ := hprim.exists_linearCombination_eq_one
    have h1 : (u : QuadraticAlgebra ℚ (D : ℚ) 0) * f.a + v * f.b + w * f.c = 1 := by
      exact_mod_cast huvw
    have key : (f.a : QuadraticAlgebra ℚ (D : ℚ) 0) =
        u • ((f.a : QuadraticAlgebra ℚ (D : ℚ) 0) * f.a) +
          v • (f.reflected.idealGenerator D * f.a - f.a * f.idealGenerator D) -
          w • (f.reflected.idealGenerator D * f.idealGenerator D) := by
      simp only [zsmul_eq_mul]
      linear_combination -(f.a : QuadraticAlgebra ℚ (D : ℚ) 0) * h1 -
        (v : QuadraticAlgebra ℚ (D : ℚ) 0) * f.a * hdiff +
        (w : QuadraticAlgebra ℚ (D : ℚ) 0) * hprod
    rw [key, ← mem_coe]
    exact sub_mem (add_mem (zsmul_mem (mem_coe.mpr (mul_mem_mul hα' hα)) _)
      (zsmul_mem (sub_mem (mem_coe.mpr (mul_mem_mul hβ' hα))
        (mem_coe.mpr (mul_mem_mul hα' hβ))) _))
      (zsmul_mem (mem_coe.mpr (mul_mem_mul hβ' hβ)) _)

/-- The invertible ideals of a primitive form and of its opposite multiply to the principal
ideal `(a)`. -/
private theorem invertibleFractionalIdeal_reflected_mul (hf : f.discrim = D)
    (hprim : f.IsPrimitive) :
    f.reflected.invertibleFractionalIdeal D (f.discrim_reflected.trans hf)
        (f.isPrimitive_reflected_iff.mpr hprim) * f.invertibleFractionalIdeal D hf hprim =
      toPrincipalIdeal _ _ (Units.mk0 (f.a : QuadraticAlgebra ℚ (D : ℚ) 0)
        (by exact_mod_cast a_ne_zero_of_not_isSquare_discrim (f := f) (hf ▸ Fact.out))) := by
  apply Units.ext
  rw [Units.val_mul, coe_invertibleFractionalIdeal, coe_invertibleFractionalIdeal,
    coe_toPrincipalIdeal, Units.val_mk0]
  exact fractionalIdeal_reflected_mul hf hprim

/-- **The opposite form has the inverse Picard class.** -/
@[simp] theorem picClass_reflected (hD : D % 4 = 0 ∨ D % 4 = 1) (hf : f.discrim = D)
    (hprim : f.IsPrimitive) :
    picClass D hD ⟨f.reflected, (mem_primitiveForms D _).mpr
      ⟨f.discrim_reflected.trans hf, f.isPrimitive_reflected_iff.mpr hprim⟩⟩ =
      (picClass D hD ⟨f, (mem_primitiveForms D f).mpr ⟨hf, hprim⟩⟩)⁻¹ := by
  rw [eq_inv_iff_mul_eq_one, picClass_def, picClass_def, ← map_mul,
    invertibleFractionalIdeal_reflected_mul hf hprim]
  exact ClassGroup.mk_toPrincipalIdeal _

/-- The orientation correction of a form depends only on its leading coefficient, so the opposite
form has the same one. -/
private theorem idealSignFactor_reflected :
    f.reflected.idealSignFactor D = f.idealSignFactor D := by
  by_cases ha : 0 < f.a
  · rw [idealSignFactor_of_a_pos f D ha, idealSignFactor_of_a_pos f.reflected D (by simpa)]
  · exact Units.ext (by rw [coe_idealSignFactor_of_not_a_pos f D ha,
      coe_idealSignFactor_of_not_a_pos f.reflected D (by simpa using ha)])

/-- **The opposite form has the inverse narrow class.** This holds for every nonsquare
discriminant: both sign-corrected ideals carry the same correction `1` or `√D`, and the product
of the two ideals is generated by the square of that correction times `a`, whose norm is
positive. -/
@[simp] theorem narrowPicClass_reflected (hf : f.discrim = D) (hprim : f.IsPrimitive) :
    f.reflected.narrowPicClass D (f.discrim_reflected.trans hf)
        (f.isPrimitive_reflected_iff.mpr hprim) = (f.narrowPicClass D hf hprim)⁻¹ := by
  let O := QuadraticOrder.numberFieldOrder D (hf ▸ f.discrim_emod_four_eq_zero_or_one)
  have ha : (f.a : ℚ) ≠ 0 := by
    exact_mod_cast a_ne_zero_of_not_isSquare_discrim (f := f) (hf ▸ Fact.out)
  have hnorm : 0 < Algebra.norm ℚ (f.a : QuadraticAlgebra ℚ (D : ℚ) 0) := by
    rw [Algebra.norm_quadraticAlgebra_apply]
    simpa [QuadraticAlgebra.norm_def] using mul_self_pos.mpr ha
  rw [eq_inv_iff_mul_eq_one, narrowPicClass_def, narrowPicClass_def, ← map_mul,
    orientedInvertibleFractionalIdeal_def, orientedInvertibleFractionalIdeal_def,
    idealSignFactor_reflected, mul_mul_mul_comm, invertibleFractionalIdeal_reflected_mul hf hprim,
    map_mul, map_mul, ← GlobalNumberFields.NarrowPic.mkPrincipal_apply,
    ← GlobalNumberFields.NarrowPic.mkPrincipal_apply, ← map_mul, ← sq, map_pow,
    GlobalNumberFields.NarrowPic.mkPrincipal_sq, one_mul]
  exact GlobalNumberFields.NarrowPic.mkPrincipal_eq_one_of_norm_pos O
    (QuadraticAlgebra.finrank_eq_two (D : ℚ) 0) hnorm

/-- **Ambiguous positive definite classes.** For negative nonsquare `D`, a primitive form with
positive leading coefficient is properly equivalent to its opposite exactly when its Picard
class has order dividing two. -/
theorem exists_eq_smul_reflected_iff_picClass_sq_eq_one (hD : D % 4 = 0 ∨ D % 4 = 1)
    (hneg : D < 0) (hf : f.discrim = D) (hprim : f.IsPrimitive) (ha : 0 < f.a) :
    (∃ γ : SL(2, ℤ), f = γ • f.reflected) ↔
      picClass D hD ⟨f, (mem_primitiveForms D f).mpr ⟨hf, hprim⟩⟩ ^ 2 = 1 := by
  rw [sq, mul_eq_one_iff_eq_inv, ← picClass_reflected hD hf hprim, eq_comm,
    picClass_eq_picClass_iff_of_neg D hD hneg (by simpa) ha]
  simp only [Subtype.ext_iff, SubMulAction.val_smul, eq_comm]

/-- **Ambiguous classes of positive discriminant.** For positive nonsquare `D`, a primitive form
is properly equivalent to its opposite exactly when its oriented narrow class has order dividing
two. -/
theorem exists_eq_smul_reflected_iff_narrowPicClass_sq_eq_one (hpos : 0 < D)
    (hf : f.discrim = D) (hprim : f.IsPrimitive) :
    (∃ γ : SL(2, ℤ), f = γ • f.reflected) ↔ f.narrowPicClass D hf hprim ^ 2 = 1 := by
  let F : primitiveForms D := ⟨f, (mem_primitiveForms D f).mpr ⟨hf, hprim⟩⟩
  let G : primitiveForms D := ⟨f.reflected, (mem_primitiveForms D _).mpr
    ⟨f.discrim_reflected.trans hf, f.isPrimitive_reflected_iff.mpr hprim⟩⟩
  have hFG : (∃ γ : SL(2, ℤ), f = γ • f.reflected) ↔
      (Quotient.mk'' F : MulAction.orbitRel.Quotient SL(2, ℤ) (primitiveForms D)) =
        Quotient.mk'' G := by
    rw [Quotient.eq'', MulAction.orbitRel_apply, MulAction.mem_orbit_iff]
    simp only [F, G, Subtype.ext_iff, SubMulAction.val_smul, eq_comm]
  rw [hFG, ← (properClassToNarrowPic_injective D (hf ▸ f.discrim_emod_four_eq_zero_or_one)
    hpos).eq_iff, properClassToNarrowPic_mk, properClassToNarrowPic_mk, sq,
    mul_eq_one_iff_eq_inv, narrowPicClass_reflected hf hprim]

end TauCeti.BinaryQuadraticForm
