module

public import TauCeti.NumberTheory.IntegralLattice.Localization.Basic
public import TauCeti.LinearAlgebra.IntegralLattice.Ideals
import TauCeti.NumberTheory.Padics.PadicIntegers

/-!
# Scale and norm ideals of a localized lattice

The scale and norm ideals of the integral form on `ℤ_p ⊗[ℤ] L` are the extensions to `ℤ_p`
of the corresponding ideals of `L`. In particular, their generators can be read directly from
an integral Gram matrix. At an odd prime the ideals coincide, because `2` is a unit; at the
dyadic prime their difference distinguishes the parity types of unimodular Jordan blocks. In
particular a lattice is even exactly when its dyadic localization is
(`TauCeti.IntegralLattice.isEven_iff_forall_two_dvd_localIntegralForm_apply_self`).

These are ideals of the integral localization, not of the completed rational space.

## References

* O. T. O'Meara, *Introduction to Quadratic Forms*, §82E and §93.
-/

public section

namespace TauCeti.IntegralLattice

variable {V : Type*} [AddCommGroup V] [Module ℚ V]
  (L : IntegralLattice V) (p : ℕ) [Fact p.Prime]

/-- The ideal generated by pairings on the integral localization of `L`. -/
noncomputable abbrev localScaleIdeal : Ideal ℤ_[p] := (L.localIntegralForm p).scaleIdeal

/-- The ideal generated by self-pairings on the integral localization of `L`. -/
noncomputable abbrev localNormIdeal : Ideal ℤ_[p] := (L.localIntegralForm p).normIdeal

/-- Localization extends the integral scale ideal. -/
@[simp]
theorem localScaleIdeal_eq_map :
    L.localScaleIdeal p = Ideal.map (algebraMap ℤ ℤ_[p]) L.scaleIdeal := by
  rw [localScaleIdeal, localIntegralForm_def, scaleIdeal]
  exact LinearMap.BilinForm.scaleIdeal_baseChange L.integralForm

/-- Localization extends the integral norm ideal. -/
@[simp]
theorem localNormIdeal_eq_map :
    L.localNormIdeal p = Ideal.map (algebraMap ℤ ℤ_[p]) L.normIdeal := by
  rw [localNormIdeal, localIntegralForm_def, normIdeal]
  exact LinearMap.BilinForm.normIdeal_baseChange L.integralForm

/-- At odd primes the local norm and scale ideals coincide. -/
theorem localNormIdeal_eq_localScaleIdeal {p : ℕ} [Fact p.Prime] (hp : p ≠ 2) :
    L.localNormIdeal p = L.localScaleIdeal p :=
  (L.localIntegralForm p).normIdeal_eq_scaleIdeal_of_isUnit_two
    (L.isSymm_localIntegralForm p) (PadicInt.isUnit_two hp)

/-- Evenness is detected by the norm ideal at the dyadic localization. -/
theorem isEven_iff_localNormIdeal_le_span_two :
    L.IsEven ↔ L.localNormIdeal 2 ≤ Ideal.span {(2 : ℤ_[2])} := by
  have hcomap : Ideal.comap (algebraMap ℤ ℤ_[2]) (Ideal.span {(2 : ℤ_[2])}) =
      Ideal.span {(2 : ℤ)} := by
    ext z
    simp only [Ideal.mem_comap, Ideal.mem_span_singleton]
    simpa using (PadicInt.pow_p_dvd_int_iff (p := 2) 1 z)
  rw [L.isEven_iff_normIdeal_le_span_singleton_two, L.localNormIdeal_eq_map 2,
    Ideal.map_le_iff_le_comap, hcomap]

/-- **Evenness is detected by the dyadic localization.** A lattice is even exactly when every value
`B(x, x)` of its localized integral form at `2` is divisible by `2` in `ℤ_[2]`. -/
theorem isEven_iff_forall_two_dvd_localIntegralForm_apply_self :
    L.IsEven ↔ ∀ x : L.LocalCarrier 2, (2 : ℤ_[2]) ∣ L.localIntegralForm 2 x x := by
  simp only [L.isEven_iff_localNormIdeal_le_span_two, LinearMap.BilinForm.normIdeal_le_iff,
    Ideal.mem_span_singleton]

variable {L p} in
/-- **The localizations of an even lattice are even.** Every value `B(x, x)` of the localized
integral form of an even lattice at a prime `p` is divisible by `2` in `ℤ_[p]`. -/
theorem IsEven.two_dvd_localIntegralForm_apply_self (heven : L.IsEven)
    (x : L.LocalCarrier p) : (2 : ℤ_[p]) ∣ L.localIntegralForm p x x := by
  have h : L.localNormIdeal p ≤ Ideal.span {(2 : ℤ_[p])} := by
    rw [localNormIdeal_eq_map]
    refine (Ideal.map_mono (L.isEven_iff_normIdeal_le_span_singleton_two.mp heven)).trans ?_
    rw [Ideal.map_span, Set.image_singleton, map_ofNat]
  exact Ideal.mem_span_singleton.mp (h ((L.localIntegralForm p).self_mem_normIdeal x))

end TauCeti.IntegralLattice
