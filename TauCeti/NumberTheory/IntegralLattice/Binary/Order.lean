module

public import TauCeti.NumberTheory.IntegralLattice.Binary.NormForm
public import TauCeti.NumberTheory.QuadraticOrder.Field
public import TauCeti.NumberTheory.NumberField.Global.Orders.Quadratic.Conductor
public import TauCeti.NumberTheory.QuadraticOrder.Split
public import TauCeti.Algebra.QuadraticAlgebra.Etale

/-!
# The quadratic order of a binary integral lattice

The primitive norm discriminant `Δ` determines the embedded order `ℤ[(Δ + √Δ)/2]`
in its rational quadratic algebra. This order is free of rank two and has trace-pairing
discriminant `Δ`, with integral basis `1, (Δ + √Δ)/2`.

For a nondegenerate lattice the rational algebra is étale. A nonsquare discriminant
returns the actual number-field order, whose conductor is generated by its index in the
maximal order. It is maximal precisely for fundamental discriminants.
A square discriminant returns an integer congruence product order through the rational
splitting equivalence.

## References

* D. A. Cox, *Primes of the Form x² + ny²*, §7.
-/

public section

open QuadraticAlgebra
open scoped NumberField

namespace TauCeti.IntegralLattice
open Module
variable {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (L : IntegralLattice V) (hV : Module.finrank ℚ V = 2)

/-- The canonical quadratic order of the primitive norm discriminant of the lattice. -/
noncomputable def binaryOrder :
    Subalgebra ℤ (QuadraticAlgebra ℚ (L.binaryDiscriminant hV : ℚ) 0) :=
  QuadraticOrder.toSubalgebra (L.binaryDiscriminant hV)
    (L.binaryDiscriminant_emod_four_eq_zero_or_one hV)

/-- Members of the lattice order have integral coefficients in its two generators. -/
@[grind =] theorem mem_binaryOrder_iff
    (x : QuadraticAlgebra ℚ (L.binaryDiscriminant hV : ℚ) 0) :
    x ∈ L.binaryOrder hV ↔ ∃ a b : ℤ,
      x = (a : QuadraticAlgebra ℚ (L.binaryDiscriminant hV : ℚ) 0) +
        (b : QuadraticAlgebra ℚ (L.binaryDiscriminant hV : ℚ) 0) *
          QuadraticOrder.generator (L.binaryDiscriminant hV) := by
  rw [binaryOrder, QuadraticOrder.mem_toSubalgebra_iff]
  simp only [zsmul_eq_mul, mul_one]

/-- The lattice order is generated by its half-integral square root. -/
theorem binaryOrder_eq_adjoin :
    L.binaryOrder hV = Algebra.adjoin ℤ {QuadraticOrder.generator (L.binaryDiscriminant hV)} :=
  QuadraticOrder.toSubalgebra_eq_adjoin _ _

/-- The lattice order has an integral basis of size two. -/
noncomputable def binaryOrderBasis : Module.Basis (Fin 2) ℤ (L.binaryOrder hV) :=
  QuadraticOrder.basis (L.binaryDiscriminant hV) _

/-- The lattice order is finite over the integers. -/
instance instFiniteBinaryOrder : Module.Finite ℤ (L.binaryOrder hV) := by
  unfold binaryOrder
  infer_instance

/-- The lattice order is free over the integers. -/
instance instFreeBinaryOrder : Module.Free ℤ (L.binaryOrder hV) :=
  Module.Free.of_basis (L.binaryOrderBasis hV)

/-- The first integral basis vector of the lattice order is one. -/
@[simp] theorem coe_binaryOrderBasis_zero :
    (L.binaryOrderBasis hV 0 : QuadraticAlgebra ℚ (L.binaryDiscriminant hV : ℚ) 0) = 1 :=
  QuadraticOrder.coe_basis_zero _ _

/-- The second integral basis vector is the half-integral square root generator. -/
@[simp] theorem coe_binaryOrderBasis_one :
    (L.binaryOrderBasis hV 1 : QuadraticAlgebra ℚ (L.binaryDiscriminant hV : ℚ) 0) =
      QuadraticOrder.generator (L.binaryDiscriminant hV) :=
  QuadraticOrder.coe_basis_one _ _

/-- The primitive lattice discriminant is the actual trace-pairing order discriminant. -/
theorem discr_binaryOrderBasis :
    Algebra.discr ℤ (L.binaryOrderBasis hV) = L.binaryDiscriminant hV :=
  QuadraticOrder.discr_basis _ _

/-- The nondegenerate lattice's rational quadratic algebra is étale. -/
theorem etale_binaryQuadraticAlgebra [L.IsNondegenerate] :
    Algebra.Etale ℚ (QuadraticAlgebra ℚ (L.binaryDiscriminant hV : ℚ) 0) := by
  apply _root_.QuadraticAlgebra.etale_of_discr_ne_zero
  have h : (L.binaryDiscriminant hV : ℚ) ≠ 0 := by
    exact_mod_cast L.binaryDiscriminant_ne_zero hV
  simpa [QuadraticAlgebra.discr_def] using h

/-- A nonsquare primitive discriminant determines the actual number-field order. -/
noncomputable def binaryNumberFieldOrder [Fact (¬ IsSquare (L.binaryDiscriminant hV))] :
    GlobalNumberFields.NumberFieldOrder
      (QuadraticAlgebra ℚ (L.binaryDiscriminant hV : ℚ) 0) :=
  QuadraticOrder.numberFieldOrder _ (L.binaryDiscriminant_emod_four_eq_zero_or_one hV)

/-- The nonsquare field order has the common lattice order as its embedded carrier. -/
@[simp] theorem binaryNumberFieldOrder_toSubalgebra
    [Fact (¬ IsSquare (L.binaryDiscriminant hV))] :
    (L.binaryNumberFieldOrder hV).toSubalgebra = L.binaryOrder hV := by
  unfold binaryNumberFieldOrder binaryOrder
  exact QuadraticOrder.numberFieldOrder_toSubalgebra _ _

/-- The field order's discriminant equals the primitive lattice discriminant. -/
@[simp] theorem binaryNumberFieldOrder_discr [Fact (¬ IsSquare (L.binaryDiscriminant hV))] :
    (L.binaryNumberFieldOrder hV).discr = L.binaryDiscriminant hV := by
  simp [binaryNumberFieldOrder]

/-- The conductor of the nonsquare lattice order is generated by its index in the maximal order. -/
@[simp] theorem binaryNumberFieldOrder_conductor
    [Fact (¬ IsSquare (L.binaryDiscriminant hV))] :
    (L.binaryNumberFieldOrder hV).conductor =
      Ideal.span {((L.binaryNumberFieldOrder hV).index :
        𝓞 (QuadraticAlgebra ℚ (L.binaryDiscriminant hV : ℚ) 0))} :=
  (L.binaryNumberFieldOrder hV).conductor_eq_span_index
    (_root_.QuadraticAlgebra.finrank_eq_two _ _)

/-- In the field branch, maximality is precisely fundamentalness of the primitive discriminant. -/
@[simp] theorem binaryNumberFieldOrder_eq_maximal_iff
    [Fact (¬ IsSquare (L.binaryDiscriminant hV))] :
    L.binaryNumberFieldOrder hV = GlobalNumberFields.maximalNumberFieldOrder _ ↔
      Int.IsFundamentalDiscr (L.binaryDiscriminant hV) := by
  simp [binaryNumberFieldOrder]

/-- A nonzero square primitive discriminant returns an explicit integer congruence product
order, independently of the field-order interface. -/
noncomputable def binaryOrderEquivProductOfSq [L.IsNondegenerate] (s : ℤ)
    (hSq : L.binaryDiscriminant hV = s ^ 2) :
    L.binaryOrder hV ≃ₐ[ℤ] QuadraticOrder.productSubalgebra s := by
  have hs : s ≠ 0 := by
    intro hs
    exact L.binaryDiscriminant_ne_zero hV (by simpa [hs] using hSq)
  have e (D : ℤ) (hD : D % 4 = 0 ∨ D % 4 = 1) (h : D = s ^ 2) :
      QuadraticOrder.toSubalgebra D hD ≃ₐ[ℤ] QuadraticOrder.productSubalgebra s := by
    subst D
    exact QuadraticOrder.equivProductOfSq s hs
  exact e _ (L.binaryDiscriminant_emod_four_eq_zero_or_one hV) hSq

end TauCeti.IntegralLattice
