module

public import Mathlib.LinearAlgebra.Trace
public import Mathlib.RingTheory.Ideal.Span

/-!
# The trace of an algebra endomorphism

Let `S` be a commutative `A`-algebra and `σ : S →ₐ[A] S` an algebra endomorphism, viewed as an
`A`-linear endomorphism of `S`. Twisting `σ` by multiplication gives the linear functional
`z ↦ trace (σ ∘ m_z)` on `S`. Since `σ ∘ m_y = m_{σ y} ∘ σ`, cyclicity of the trace shows that this
functional takes the same value on `x * σ y` and on `x * y`, so it vanishes on the ideal generated
by the elements `σ y - y`.

Evaluating at a scalar `a` lying in that ideal gives `a * trace σ = 0`. For the automorphism `σ ≠ 1`
of a finite Galois extension of fields one may take `a = 1`, recovering the classical fact that
`σ` has trace zero, so the extension is the regular representation of its Galois group on the
level of characters. The point of the statement over a ring is that it applies before passing to
fraction fields: over a domain `A`, any nonzero scalar `a` with `algebraMap A S a` a multiple of
`σ y - y` forces `trace σ = 0`.

## Main statements

* `AlgHom.trace_toLinearMap_comp_mulLeft_mul_sub`: `trace (σ ∘ m_{x (σ y - y)}) = 0`.
* `AlgHom.mul_trace_toLinearMap_eq_zero_of_mem_span`: if `algebraMap A S a` lies in the ideal
  generated by `σ y - y`, then `a * trace σ = 0`.
-/

public section

namespace AlgHom

variable {A S : Type*} [CommRing A] [CommRing S] [Algebra A S]

/-- The functional `z ↦ trace (σ ∘ m_z)` vanishes on multiples of `σ y - y`: cyclicity of the
trace and `σ ∘ m_y = m_{σ y} ∘ σ` give `trace (σ ∘ m_{x σ y}) = trace (σ ∘ m_{x y})`. No
freeness or finiteness of `S` over `A` is needed; otherwise the trace is zero by definition. -/
theorem trace_toLinearMap_comp_mulLeft_mul_sub (σ : S →ₐ[A] S) (x y : S) :
    LinearMap.trace A S (σ.toLinearMap ∘ₗ LinearMap.mulLeft A (x * (σ y - y))) = 0 := by
  by_cases H : ∃ s : Finset S, Nonempty (Module.Basis s A S)
  swap
  · rw [LinearMap.trace, dite_eq_right H, LinearMap.zero_apply]
  obtain ⟨s, ⟨b⟩⟩ := H
  have : Module.Free A S := .of_basis b
  have : Module.Finite A S := .of_basis b
  -- Moving `m_{σ y}` around the trace and past `σ` turns it into `m_y`.
  have hσ : LinearMap.mulLeft A (σ y) ∘ₗ σ.toLinearMap = σ.toLinearMap ∘ₗ LinearMap.mulLeft A y :=
    LinearMap.ext fun z ↦ by simp
  have h : LinearMap.trace A S (σ.toLinearMap ∘ₗ LinearMap.mulLeft A (x * σ y)) =
      LinearMap.trace A S (σ.toLinearMap ∘ₗ LinearMap.mulLeft A (x * y)) := by
    rw [LinearMap.mulLeft_mul, ← LinearMap.comp_assoc,
      LinearMap.trace_comp_comm' (LinearMap.mulLeft A (σ y)), ← LinearMap.comp_assoc, hσ,
      LinearMap.comp_assoc,
      ← LinearMap.mulLeft_mul, mul_comm y]
  rw [mul_sub, ← sub_eq_zero.2 h, ← map_sub, ← LinearMap.comp_sub]
  congr 2
  ext z
  simp [sub_mul, mul_assoc]

/-- If a scalar `a` maps into the ideal generated by `σ y - y`, then `a` annihilates the trace of
the algebra endomorphism `σ`. Over a domain `A`, a nonzero such `a` forces `trace σ = 0`. -/
theorem mul_trace_toLinearMap_eq_zero_of_mem_span (σ : S →ₐ[A] S) {a : A} {y : S}
    (h : algebraMap A S a ∈ Ideal.span {σ y - y}) :
    a * LinearMap.trace A S σ.toLinearMap = 0 := by
  obtain ⟨x, hx⟩ := Ideal.mem_span_singleton'.1 h
  have hσ : σ.toLinearMap ∘ₗ LinearMap.mulLeft A (x * (σ y - y)) = a • σ.toLinearMap :=
    LinearMap.ext fun z ↦ by simp [hx, Algebra.smul_def]
  rw [← smul_eq_mul, ← map_smul, ← hσ, trace_toLinearMap_comp_mulLeft_mul_sub]

end AlgHom
