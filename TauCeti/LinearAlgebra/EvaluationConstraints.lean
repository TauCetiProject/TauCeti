/-!
# Rows constrained by their values at finitely many points

Let `E` be a field, `R` a commutative `E`-algebra and `ev : ι → R →ₐ[E] E` a family of
`E`-algebra evaluations. For subspaces `V j ⊆ κ → E` and a finite set `J` of indices, the
*evaluation constraint module* `TauCeti.evaluationConstraints ev V J` is the `R`-submodule of
rows `F : κ → R` whose specialisation `ev j ∘ F` lies in `V j` for every `j ∈ J`.

In the work of Lei, Loeffler and Zerbes such modules describe the images of Coleman maps
attached to crystalline representations: a row of Iwasawa-algebra elements lies in the image when
its specialisation at each of finitely many characters lies in a prescribed subspace. The results
here assume an element `t : R` and pairwise distinct scalars `x j` such that the kernel of `ev j`
is the principal ideal generated by `q j = t - x j`; the simplest example is `R = E[X]`, `t = X`
and evaluation at the points `x j`.

The main result computes the image of the `k`-th coordinate projection. Call `j ∈ J` *forced*
at `k` if every vector of `V j` has `k`-th coordinate zero, and let
`g_k = ∏_{j ∈ J forced at k} (t - x j)`. Then the `k`-th coordinates of the rows in the constraint
module are exactly the multiples of `g_k`. Unforced constraints impose no condition on a single
coordinate, because Lagrange interpolation in `t` over `E` adjusts the other coordinates. No
integrality is claimed: over `𝒪_E` instead of `E` interpolation fails in general.

## Main definitions

* `TauCeti.evaluationConstraints ev V J`: the rows whose specialisations at `j ∈ J` lie in `V j`.
* `TauCeti.coordinateImageGenerator t x V J k`: the product `g_k` of the factors `t - x j` over the
  indices `j ∈ J` forced at `k`.

## Main results

* `TauCeti.prod_sub_algebraMap_dvd_iff`: an element vanishes under every `ev j`, `j ∈ J`, if and
  only if it is divisible by `∏_{j ∈ J} (t - x j)`.
* `TauCeti.exists_mem_evaluationConstraints_apply_eq_coordinateImageGenerator`: some constrained
  row has `k`-th coordinate `g_k`.
* `TauCeti.exists_mem_evaluationConstraints_apply_eq_iff_dvd`: some constrained row has `k`-th
  coordinate `r` if and only if `g_k ∣ r`.
* `TauCeti.map_proj_evaluationConstraints`: the `k`-th coordinate image is the ideal `(g_k)`.

## References

* A. Lei, D. Loeffler and S. L. Zerbes, *Coleman maps and the p-adic regulator*, Algebra & Number
  Theory 5 (2011), §4A, Lemma 4.1, Proposition 4.2 and Lemma 4.3.
-/

public section

open Finset Polynomial

namespace TauCeti

section Constraints

variable {E R ι κ : Type*} [CommSemiring E] [Semiring R] [Algebra E R]

variable (ev : ι → R →ₐ[E] E) (V : ι → Submodule E (κ → E))

/-- The evaluation constraint module: the rows `F : κ → R` whose specialisation
`ev j ∘ F : κ → E` lies in `V j` for every `j ∈ J`. -/
def evaluationConstraints (J : Finset ι) : Submodule R (κ → R) where
  carrier := {F | ∀ j ∈ J, ev j ∘ F ∈ V j}
  zero_mem' j _ := by
    convert (V j).zero_mem using 1
    ext k
    simp
  add_mem' {F G} hF hG j hj := by
    convert (V j).add_mem (hF j hj) (hG j hj) using 1
    ext k
    simp
  smul_mem' a F hF j hj := by
    convert (V j).smul_mem (ev j a) (hF j hj) using 1
    ext k
    simp

variable {ev V}

@[simp]
theorem mem_evaluationConstraints {J : Finset ι} {F : κ → R} :
    F ∈ evaluationConstraints ev V J ↔ ∀ j ∈ J, ev j ∘ F ∈ V j :=
  Iff.rfl

/-- A row satisfies the constraint at a single index `j` exactly when `ev j ∘ F ∈ V j`. -/
theorem mem_evaluationConstraints_singleton {j : ι} {F : κ → R} :
    F ∈ evaluationConstraints ev V {j} ↔ ev j ∘ F ∈ V j := by
  simp

/-- Imposing one more constraint at `j` adds the condition `ev j ∘ F ∈ V j`. -/
theorem mem_evaluationConstraints_insert [DecidableEq ι] {j : ι} {J : Finset ι} {F : κ → R} :
    F ∈ evaluationConstraints ev V (insert j J) ↔
      ev j ∘ F ∈ V j ∧ F ∈ evaluationConstraints ev V J := by
  simp

variable (ev V)

@[simp]
theorem evaluationConstraints_empty : evaluationConstraints ev V ∅ = ⊤ :=
  eq_top_iff.2 fun F _ => by simp

theorem evaluationConstraints_union [DecidableEq ι] (J J' : Finset ι) :
    evaluationConstraints ev V (J ∪ J') =
      evaluationConstraints ev V J ⊓ evaluationConstraints ev V J' := by
  ext F
  simp only [mem_evaluationConstraints, mem_union, Submodule.mem_inf]
  exact ⟨fun h => ⟨fun j hj => h j (.inl hj), fun j hj => h j (.inr hj)⟩,
    fun h j hj => hj.elim (h.1 j) (h.2 j)⟩

/-- Imposing more evaluation conditions gives a smaller module. -/
theorem evaluationConstraints_antitone : Antitone (evaluationConstraints ev V) :=
  fun _ _ hJ _ hF j hj => hF j (hJ hj)

end Constraints

variable {E R ι κ : Type*} [Field E] [CommRing R] [Algebra E R]

section Division

variable {ev : ι → R →ₐ[E] E} {t : R} {x : ι → E}

/-- **Division by distinct evaluation factors.** If the kernel of each `ev j`, `j ∈ J`, is
generated by `t - x j` and the `x j` are pairwise distinct, then an element is killed by every
`ev j` exactly when it is divisible by `∏_{j ∈ J} (t - x j)`. -/
theorem prod_sub_algebraMap_dvd_iff {J : Finset ι} (hx : Set.InjOn x J)
    (hker : ∀ j ∈ J, RingHom.ker (ev j) = Ideal.span {t - algebraMap E R (x j)}) {f : R} :
    (∏ j ∈ J, (t - algebraMap E R (x j))) ∣ f ↔ ∀ j ∈ J, ev j f = 0 := by
  constructor
  · rintro ⟨g, rfl⟩ j hj
    rw [map_mul, map_prod,
      prod_eq_zero hj (by simp [AlgHom.apply_eq_of_ker_eq_span_sub (hker j hj)]), zero_mul]
  · intro h
    refine prod_dvd_of_coprime (fun i hi j hj hij => ?_) fun j hj => ?_
    · have hne : x i - x j ≠ 0 := sub_ne_zero.2 fun hx' => hij (hx hi hj hx')
      simpa using (isCoprime_X_sub_C_of_isUnit_sub hne.isUnit).map (aeval t).toRingHom
    · rw [← Ideal.mem_span_singleton, ← hker j hj]
      exact h j hj

end Division

section CoordinateImage

variable {ev : ι → R →ₐ[E] E} {t : R} {x : ι → E} {V : ι → Submodule E (κ → E)}

variable (t x V) in
/-- The generator `g_k` of the `k`-th coordinate image of the evaluation constraint module: the
product of the factors `t - x j` over the indices `j ∈ J` at which every vector of `V j` has
vanishing `k`-th coordinate. The empty product is `1`. -/
noncomputable def coordinateImageGenerator (J : Finset ι) (k : κ) : R := by
  classical
  exact ∏ j ∈ J with ∀ v ∈ V j, v k = 0, (t - algebraMap E R (x j))

theorem coordinateImageGenerator_eq_prod_filter {J : Finset ι} {k : κ}
    [DecidablePred fun j => ∀ v ∈ V j, v k = 0] :
    coordinateImageGenerator t x V J k =
      ∏ j ∈ J with ∀ v ∈ V j, v k = 0, (t - algebraMap E R (x j)) := by
  unfold coordinateImageGenerator
  convert rfl

theorem coordinateImageGenerator_eq_prod_ite {J : Finset ι} {k : κ}
    [DecidablePred fun j => ∀ v ∈ V j, v k = 0] :
    coordinateImageGenerator t x V J k =
      ∏ j ∈ J, if ∀ v ∈ V j, v k = 0 then t - algebraMap E R (x j) else 1 := by
  rw [coordinateImageGenerator_eq_prod_filter, prod_filter]

@[simp]
theorem coordinateImageGenerator_empty {k : κ} : coordinateImageGenerator t x V ∅ k = 1 := by
  classical
  simp [coordinateImageGenerator_eq_prod_filter]

/-- If no constraint forces the `k`-th coordinate to vanish, then `g_k = 1`. -/
theorem coordinateImageGenerator_eq_one {J : Finset ι} {k : κ}
    (h : ∀ j ∈ J, ∃ v ∈ V j, v k ≠ 0) : coordinateImageGenerator t x V J k = 1 := by
  classical
  rw [coordinateImageGenerator_eq_prod_filter, filter_false_of_mem, prod_empty]
  intro j hj hforced
  obtain ⟨v, hv, hvk⟩ := h j hj
  exact hvk (hforced v hv)

/-- At a constrained index `j ∈ J` with `ev j t = x j` and distinct points, `ev j` kills `g_k`
exactly when `j` is forced at `k`. -/
theorem map_coordinateImageGenerator_eq_zero_iff {J : Finset ι} {k : κ} (hx : Set.InjOn x J)
    {j : ι} (hj : j ∈ J) (hev : ev j t = x j) :
    ev j (coordinateImageGenerator t x V J k) = 0 ↔ ∀ v ∈ V j, v k = 0 := by
  classical
  rw [coordinateImageGenerator_eq_prod_filter, map_prod, prod_eq_zero_iff]
  simp only [mem_filter, map_sub, AlgHom.commutes, hev, sub_eq_zero]
  refine ⟨fun ⟨i, ⟨hi, hforced⟩, hxi⟩ => ?_, fun hforced => ⟨j, ⟨hj, hforced⟩, rfl⟩⟩
  rwa [hx hj hi hxi]

/-- **Polynomial witness for the coordinate image generator.** If `ev j t = x j` for `j ∈ J` and
the `x j` are pairwise distinct on `J`, some row of the evaluation constraint module has `k`-th
coordinate exactly `g_k`. -/
theorem exists_mem_evaluationConstraints_apply_eq_coordinateImageGenerator {J : Finset ι}
    (hx : Set.InjOn x J) (hev : ∀ j ∈ J, ev j t = x j) (k : κ) :
    ∃ F ∈ evaluationConstraints ev V J, F k = coordinateImageGenerator t x V J k := by
  classical
  obtain ⟨g, hgdef⟩ : ∃ g, g = coordinateImageGenerator t x V J k := ⟨_, rfl⟩
  -- At a forced index the generator specialises to zero.
  have hg : ∀ j ∈ J, (∀ v ∈ V j, v k = 0) → ev j g = 0 := fun j hj hforced =>
    hgdef ▸ (map_coordinateImageGenerator_eq_zero_iff hx hj (hev j hj)).2 hforced
  -- The prescribed specialisation `w j ∈ V j`, with `k`-th coordinate `ev j g`.
  let w : ι → κ → E := fun j =>
    if h : ∃ v ∈ V j, v k ≠ 0 then (ev j g / h.choose k) • h.choose else 0
  have hwV : ∀ j, w j ∈ V j := fun j => by
    by_cases h : ∃ v ∈ V j, v k ≠ 0
    · simpa [w, h] using (V j).smul_mem _ h.choose_spec.1
    · simp [w, h]
  have hwk : ∀ j ∈ J, w j k = ev j g := fun j hj => by
    by_cases h : ∃ v ∈ V j, v k ≠ 0
    · simp [w, h, div_mul_cancel₀ _ h.choose_spec.2]
    · simp only [not_exists, not_and, not_not] at h
      simp [w, h, hg j hj h]
  refine ⟨Function.update (fun l => aeval t (Lagrange.interpolate J x fun j => w j l)) k g,
    fun j hj => ?_, by simp [hgdef]⟩
  convert hwV j using 1
  ext l
  rcases eq_or_ne l k with rfl | hl
  · simp [hwk j hj]
  · simp [Function.update_of_ne hl, ← aeval_algHom_apply, hev j hj,
      Lagrange.eval_interpolate_at_node _ hx hj, -Lagrange.interpolate_apply]

/-- **Exact coordinate image.** If the kernel of each `ev j`, `j ∈ J`, is generated by `t - x j`
and the `x j` are pairwise distinct, then an element `r : R` is the `k`-th coordinate of some row
of the evaluation constraint module exactly when `g_k ∣ r`. -/
theorem exists_mem_evaluationConstraints_apply_eq_iff_dvd {J : Finset ι} (hx : Set.InjOn x J)
    (hker : ∀ j ∈ J, RingHom.ker (ev j) = Ideal.span {t - algebraMap E R (x j)}) (k : κ)
    (r : R) :
    (∃ F ∈ evaluationConstraints ev V J, F k = r) ↔ coordinateImageGenerator t x V J k ∣ r := by
  classical
  constructor
  · rintro ⟨F, hF, rfl⟩
    rw [coordinateImageGenerator_eq_prod_filter, prod_sub_algebraMap_dvd_iff
      (hx.mono (coe_subset.2 (filter_subset _ _))) fun j hj => hker j (mem_filter.1 hj).1]
    intro j hj
    rw [mem_filter] at hj
    exact hj.2 _ (hF j hj.1)
  · rintro ⟨s, rfl⟩
    obtain ⟨F, hF, hFk⟩ := exists_mem_evaluationConstraints_apply_eq_coordinateImageGenerator
      (V := V) hx (fun j hj => AlgHom.apply_eq_of_ker_eq_span_sub (hker j hj)) k
    exact ⟨s • F, Submodule.smul_mem _ s hF, by simp [hFk, mul_comm]⟩

/-- The image of the evaluation constraint module under the `k`-th coordinate projection is the
principal ideal generated by `g_k`. -/
theorem map_proj_evaluationConstraints {J : Finset ι} (hx : Set.InjOn x J)
    (hker : ∀ j ∈ J, RingHom.ker (ev j) = Ideal.span {t - algebraMap E R (x j)}) (k : κ) :
    (evaluationConstraints ev V J).map (LinearMap.proj k) =
      Ideal.span {coordinateImageGenerator t x V J k} := by
  ext r
  simpa [Ideal.mem_span_singleton] using
    exists_mem_evaluationConstraints_apply_eq_iff_dvd (V := V) hx hker k r

end CoordinateImage

end TauCeti
