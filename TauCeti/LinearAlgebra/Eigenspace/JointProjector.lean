module

public import Mathlib.Algebra.Algebra.Subalgebra.Basic
public import Mathlib.LinearAlgebra.Eigenspace.Basic
import Mathlib.Algebra.Algebra.Tower

/-!
# Joint eigenspace projectors and independence

Given a `K`-algebra `A` over a field `K` and a family of elements `T : ι → A`, for any target
eigensystem `q : ι → K` and any finite set `F` of eigensystems, there is a single element `P` in
the subalgebra generated by `Set.range T` that acts uniformly across all `A`-modules as the
identity on the joint `q`-eigenspace and as zero on the joint `d`-eigenspace for every `d ∈ F`
different from `q`.

As a consequence, the joint eigenspaces `⨅ x, (T x).eigenspace (p x)` of any family of
endomorphisms `T : ι → Module.End K M` are independent (`iSupIndep`).

## Main results

* `TauCeti.exists_mem_adjoin_jointEigenspace_apply_eq_ite`: constructs a separating element
  `P ∈ Algebra.adjoin K (Set.range T)` acting as `1` on the `q`-eigenspace and `0` on the
  `d`-eigenspace for `d ∈ F \ {q}`, uniformly over all `A`-modules.
* `TauCeti.exists_subalgebra_jointEigenspace_apply_eq_ite`: specialization for a family `T : ι → S`
  in a subalgebra `S : Subalgebra K A`.
* `TauCeti.iSupIndep_jointEigenspace`: the joint eigenspaces `fun p ↦ ⨅ x, (T x).eigenspace (p x)`
  are independent (`iSupIndep`).

## Provenance

Adapted from `grh-lean` (https://github.com/lsernau/grh-lean at commit
`72fead102f663d5c7a407964a13dc0cf9d977207`, Apache 2.0, Copyright 2026 Anthropic, PBC), file
`src/New/Spanning/Multiplicities/HeckeEigensystems.lean`, declarations
`New.Data.exists_hecke_proj_eigenPart` and `New.Data.iSupIndep_eigenPart`. Here the Lagrange
projector construction is generalized to any family `T : ι → A` in any `K`-algebra over a field `K`
acting uniformly on all `A`-modules.
-/

public section

universe u

namespace TauCeti

open scoped Classical in
/-- **Uniform Lagrange projector onto a joint eigenspace.** Given a family `T : ι → A` in a
`K`-algebra over a field `K`, a target eigensystem `q : ι → K`, and a finite set `F` of
eigensystems, there exists `P ∈ Algebra.adjoin K (Set.range T)` that acts uniformly on every
`A`-module as the identity on the joint `q`-eigenspace and as zero on the joint `d`-eigenspace for
every `d ∈ F` with `d ≠ q`. -/
theorem exists_mem_adjoin_jointEigenspace_apply_eq_ite {K A ι : Type*} [Field K] [Ring A]
    [Algebra K A] (T : ι → A) (q : ι → K) (F : Finset (ι → K)) :
    ∃ P ∈ Algebra.adjoin K (Set.range T),
      ∀ (M : Type u) [AddCommGroup M] [Module K M] [Module A M] [IsScalarTower K A M]
        {d : ι → K}, d ∈ insert q F → ∀ {y : M}, (∀ x : ι, T x • y = d x • y) →
          P • y = if d = q then y else 0 := by
  induction F using Finset.induction with
  | empty =>
    refine ⟨1, one_mem _, fun M _ _ _ _ d hd y _ ↦ ?_⟩
    simp only [Finset.mem_insert, Finset.notMem_empty, or_false] at hd
    simp [hd]
  | insert e F _ ih =>
    obtain ⟨P, hP_mem, hP⟩ := ih
    by_cases heq : e = q
    · exact ⟨P, hP_mem, by rwa [heq, Finset.insert_idem]⟩
    obtain ⟨x, hx⟩ : ∃ x : ι, q x ≠ e x := Function.ne_iff.mp (Ne.symm heq)
    have hP'_mem : (q x - e x)⁻¹ • (P * T x - e x • P) ∈ Algebra.adjoin K (Set.range T) :=
      Subalgebra.smul_mem _ (sub_mem (mul_mem hP_mem (Algebra.subset_adjoin ⟨x, rfl⟩))
        (Subalgebra.smul_mem _ hP_mem _)) _
    refine ⟨(q x - e x)⁻¹ • (P * T x - e x • P), hP'_mem, fun M _ _ _ _ d hd y hy ↦ ?_⟩
    have h_comm : P • (d x • y) = d x • (P • y) := by
      rw [← algebraMap_smul A (d x) y, ← mul_smul, ← Algebra.commutes, mul_smul, algebraMap_smul]
    have h_apply : ((q x - e x)⁻¹ • (P * T x - e x • P)) • y =
        ((q x - e x)⁻¹ * (d x - e x)) • (P • y) := by
      rw [smul_assoc, sub_smul, mul_smul, hy x, h_comm, smul_assoc, ← sub_smul, smul_smul]
    rw [h_apply]
    obtain rfl | hde := eq_or_ne d e
    · simp [heq]
    rw [Finset.insert_comm] at hd
    rw [hP M (Finset.mem_of_mem_insert_of_ne hd hde) hy]
    by_cases hdq : d = q
    · simp [hdq, inv_mul_cancel₀ (sub_ne_zero.mpr hx)]
    · simp [hdq]

open scoped Classical in
/-- Subalgebra form of `TauCeti.exists_mem_adjoin_jointEigenspace_apply_eq_ite`: for a family
`T : ι → S` in a subalgebra `S : Subalgebra K A`, the separating projector `P` lies in `S`. -/
theorem exists_subalgebra_jointEigenspace_apply_eq_ite {K A ι : Type*} [Field K] [Ring A]
    [Algebra K A] (S : Subalgebra K A) (T : ι → S) (q : ι → K) (F : Finset (ι → K)) :
    ∃ P ∈ S,
      ∀ (M : Type u) [AddCommGroup M] [Module K M] [Module A M] [IsScalarTower K A M]
        {d : ι → K}, d ∈ insert q F → ∀ {y : M}, (∀ x : ι, (T x : A) • y = d x • y) →
          P • y = if d = q then y else 0 := by
  obtain ⟨P, hP_mem, hP⟩ := exists_mem_adjoin_jointEigenspace_apply_eq_ite
    (fun x ↦ (T x : A)) q F
  have hle : Algebra.adjoin K (Set.range fun x ↦ (T x : A)) ≤ S :=
    Algebra.adjoin_le (Set.range_subset_iff.mpr fun x ↦ (T x).property)
  exact ⟨P, hle hP_mem, hP⟩

/-- **Independence of joint eigenspaces.** For any family `T : ι → Module.End K M` of endomorphisms
of a vector space over a field `K`, the joint eigenspaces `fun p ↦ ⨅ x, (T x).eigenspace (p x)`
are independent. -/
theorem iSupIndep_jointEigenspace {K M ι : Type*} [Field K] [AddCommGroup M]
    [Module K M] (T : ι → Module.End K M) :
    iSupIndep fun p : ι → K ↦ ⨅ x : ι, (T x).eigenspace (p x) :=
  iSupIndep.iInf _ fun x ↦ Module.End.eigenspaces_iSupIndep (T x)

end TauCeti
