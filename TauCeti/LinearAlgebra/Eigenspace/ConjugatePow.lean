module

public import Mathlib.LinearAlgebra.Charpoly.ToMatrix
public import Mathlib.LinearAlgebra.Eigenspace.Charpoly
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import Mathlib.LinearAlgebra.FreeModule.Finite.Matrix

-- Non-public: the Vandermonde cancellation and the iterated semiconjugation are used in proofs.
import Mathlib.LinearAlgebra.Vandermonde
import TauCeti.Algebra.Group.Semiconj

/-!
# Endomorphisms conjugate to a power of themselves

Let `T` and `F` be endomorphisms of a module `M` over a commutative ring `R` with
`T * F = F * T ^ q`, and `F` injective. Then `F` carries an eigenvector of `T` with eigenvalue
`μ` to an eigenvector with eigenvalue `μ ^ q`, so the vectors `F ^ j v` are eigenvectors of `T`
with the eigenvalues `μ ^ q ^ j`. When `R` is a domain, `M` is torsion-free and the
`μ ^ q ^ i`, `i < d`, are pairwise distinct, these eigenvectors are linearly independent, and a
Vandermonde argument shows that the `d²` endomorphisms `F ^ a * T ^ b`, `a, b < d`, are linearly
independent. Over a field `K`, for `d = dim V` they are a basis of `End K V`; in particular any
family containing them spans `End K V`, so the algebra generated by `T` and `F` is all of
`End K V`.

This is the linear algebra behind a classical criterion for irreducibility of Galois
representations: a tame inertia generator `τ` and a Frobenius element `φ` satisfy
`φ τ φ⁻¹ = τ ^ q`, so `T = ρ τ` and `F = ρ φ⁻¹` satisfy `T * F = F * T ^ q`; if `ρ τ` has an
eigenvalue whose `q`-power orbit has the maximal length `dim V`, the image of `ρ` spans the
endomorphisms, so `ρ` is absolutely irreducible. The group-theoretic statements are
in `TauCeti.RepresentationTheory.Irreducible.ConjugatePow`.

## Main results

* `Module.End.HasEigenvector.hasEigenvector_pow_apply_of_mul_eq_mul_pow`: `F ^ j v` is an
  eigenvector of `T` with eigenvalue `μ ^ q ^ j`.
* `Module.End.linearIndependent_pow_mul_pow_of_mul_eq_mul_pow`: the `F ^ a * T ^ b`,
  `a, b < d`, are linearly independent.
* `Module.End.span_range_pow_mul_pow_eq_top_of_mul_eq_mul_pow`: for `d = dim V` they span
  `End K V`.
* `Matrix.linearIndependent_pow_mul_pow_of_mul_eq_mul_pow`,
  `Matrix.span_range_pow_mul_pow_eq_top_of_mul_eq_mul_pow`: the same for square matrices, with
  the eigenvalue given as a root of the characteristic polynomial.

## Provenance

Adapted from `New.Selmer.IsLatticeIn.span_range_eq_top_of_map_pow_eq_map_conj` in
`src/Lib/GaloisRep/Pseudocharacter/Pseudorepresentations.lean` of grh-lean
(https://github.com/lsernau/grh-lean, Apache 2.0, Copyright 2026 Anthropic, PBC), where the
argument is carried out inline for the reduction of an `ℓ`-adic lattice; here it is isolated as
a statement about two endomorphisms of a vector space.
-/

public section

open Function Module Submodule

namespace Module.End

section CommRing

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] {T F : End R M} {q : ℕ}

/-- **Iterates of `F` move along the `q`-power orbit of eigenvalues.** If `T * F = F * T ^ q`
with `F` injective and `v` is an eigenvector of `T` with eigenvalue `μ`, then `F ^ j v` is an
eigenvector of `T` with eigenvalue `μ ^ q ^ j`. -/
theorem HasEigenvector.hasEigenvector_pow_apply_of_mul_eq_mul_pow
    (hTF : T * F = F * T ^ q) (hF : Injective F) {μ : R} {v : M} (hv : T.HasEigenvector μ v)
    (j : ℕ) :
    T.HasEigenvector (μ ^ q ^ j) ((F ^ j) v) := by
  have h := (SemiconjBy.pow_left_pow_pow (M := End R M) hTF.symm j).eq
  refine hasEigenvector_iff.mpr ⟨mem_eigenspace_iff.mpr ?_, ?_⟩
  · rw [← mul_apply_eq_comp, ← h, mul_apply_eq_comp, hv.pow_apply, map_smul]
  · exact (map_ne_zero_iff _ (iterate_injective hF j)).mpr hv.2

/-- **The monomials `F ^ a * T ^ b` are linearly independent.** Let `T * F = F * T ^ q` with `F`
injective, and let `T` have an eigenvalue `μ` whose iterated powers `μ ^ q ^ i`, `i < d`, are
pairwise distinct. Then the `d²` endomorphisms `F ^ a * T ^ b`, `a, b < d`, are linearly
independent.

Evaluated at the eigenvector `F ^ l v`, a relation `∑ c_{a,b} F ^ a T ^ b = 0` becomes
`F ^ l (∑_a (∑_b c_{a,b} (μ ^ q ^ l) ^ b) F ^ a v) = 0`; the eigenvectors `F ^ a v` are
independent, so each polynomial `∑_b c_{a,b} X ^ b` of degree `< d` vanishes at the `d` distinct
points `μ ^ q ^ l`, hence is zero. -/
theorem linearIndependent_pow_mul_pow_of_mul_eq_mul_pow [IsDomain R] [IsTorsionFree R M]
    (hTF : T * F = F * T ^ q) (hF : Injective F) {μ : R} (hμ : T.HasEigenvalue μ) {d : ℕ}
    (hdist : Injective fun i : Fin d ↦ μ ^ q ^ (i : ℕ)) :
    LinearIndependent R fun p : Fin d × Fin d ↦ F ^ (p.1 : ℕ) * T ^ (p.2 : ℕ) := by
  obtain ⟨v, hv⟩ := hμ.exists_hasEigenvector
  have heig (l : ℕ) := hv.hasEigenvector_pow_apply_of_mul_eq_mul_pow hTF hF l
  have hind : LinearIndependent R fun a : Fin d ↦ (F ^ (a : ℕ)) v :=
    eigenvectors_linearIndependent' T _ hdist _ fun a ↦ heig a
  rw [Fintype.linearIndependent_iff]
  intro c hc ⟨a, b⟩
  -- Evaluate the relation at `F ^ l v` and cancel the injective `F ^ l`.
  have hrel (l : Fin d) :
      ∑ a : Fin d, (∑ b : Fin d, c (a, b) * (μ ^ q ^ (l : ℕ)) ^ (b : ℕ)) • (F ^ (a : ℕ)) v = 0 := by
    refine iterate_injective hF l ?_
    have := LinearMap.congr_fun hc ((F ^ (l : ℕ)) v)
    simp only [LinearMap.sum_apply, LinearMap.smul_apply, mul_apply_eq_comp,
      (heig l).pow_apply, map_smul, Fintype.sum_prod_type, LinearMap.zero_apply] at this
    simp only [map_sum, map_smul, Finset.sum_smul, mul_smul, map_zero]
    have hcomm (a : ℕ) : (F ^ (l : ℕ)) ((F ^ a) v) = (F ^ a) ((F ^ (l : ℕ)) v) := by
      rw [← mul_apply_eq_comp, ← mul_apply_eq_comp, pow_mul_comm]
    simpa only [hcomm] using this
  have hpoly (l : Fin d) : ∑ b : Fin d, c (a, b) * (μ ^ q ^ (l : ℕ)) ^ (b : ℕ) = 0 :=
    Fintype.linearIndependent_iff.mp hind _ (hrel l) a
  exact congrFun (Matrix.eq_zero_of_forall_index_sum_mul_pow_eq_zero hdist hpoly) b

end CommRing

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V] {T F : End K V} {q : ℕ}

/-- **The monomials `F ^ a * T ^ b` span the endomorphisms.** If `T * F = F * T ^ q` with `F`
injective on a finite-dimensional space `V`, and `T` has an eigenvalue `μ` whose powers
`μ ^ q ^ i`, `i < dim V`, are pairwise distinct, then the `F ^ a * T ^ b`, `a, b < dim V`, span
`End K V`: they are `(dim V)²` linearly independent elements. -/
theorem span_range_pow_mul_pow_eq_top_of_mul_eq_mul_pow [FiniteDimensional K V]
    (hTF : T * F = F * T ^ q) (hF : Injective F) {μ : K} (hμ : T.HasEigenvalue μ)
    (hdist : Injective fun i : Fin (finrank K V) ↦ μ ^ q ^ (i : ℕ)) :
    span K (Set.range fun p : Fin (finrank K V) × Fin (finrank K V) ↦
      F ^ (p.1 : ℕ) * T ^ (p.2 : ℕ)) = ⊤ :=
  (linearIndependent_pow_mul_pow_of_mul_eq_mul_pow hTF hF hμ hdist).span_eq_top_of_card_eq_finrank'
    (by simp [Module.finrank_linearMap])

end Module.End

namespace Matrix

variable {K n : Type*} [Field K] [Fintype n] [DecidableEq n] {A B : Matrix n n K} {q : ℕ}

/-- **The monomials `B ^ a * A ^ b` are linearly independent**, for square matrices over a field
with `A * B = B * A ^ q`, `B` invertible, and a root `μ` of the characteristic polynomial of `A`
whose powers `μ ^ q ^ i`, `i < d`, are pairwise distinct. This is
`Module.End.linearIndependent_pow_mul_pow_of_mul_eq_mul_pow` read through `Matrix.toLin'`. -/
theorem linearIndependent_pow_mul_pow_of_mul_eq_mul_pow (hAB : A * B = B * A ^ q)
    (hB : IsUnit B) {μ : K} (hμ : A.charpoly.IsRoot μ) {d : ℕ}
    (hdist : Injective fun i : Fin d ↦ μ ^ q ^ (i : ℕ)) :
    LinearIndependent K fun p : Fin d × Fin d ↦ B ^ (p.1 : ℕ) * A ^ (p.2 : ℕ) := by
  let e := toLinAlgEquiv' (R := K) (n := n)
  have hTF : e A * e B = e B * e A ^ q := by rw [← map_mul, ← map_pow, ← map_mul, hAB]
  have hF : Injective (e B) := (End.isUnit_iff _).mp (hB.map e) |>.injective
  have hμ' : End.HasEigenvalue (e A) μ := by
    have heA : e A = toLin' A := LinearMap.ext fun v ↦ by simp [e, toLin'_apply]
    rwa [End.hasEigenvalue_iff_isRoot_charpoly, heA, charpoly_toLin']
  refine LinearIndependent.of_comp e.toLinearMap ?_
  convert End.linearIndependent_pow_mul_pow_of_mul_eq_mul_pow hTF hF hμ' hdist using 1
  ext1 p
  simp

/-- **The monomials `B ^ a * A ^ b` span the matrix algebra**, for square matrices over a field
with `A * B = B * A ^ q`, `B` invertible, and a root `μ` of the characteristic polynomial of `A`
whose powers `μ ^ q ^ i`, `i < card n`, are pairwise distinct. -/
theorem span_range_pow_mul_pow_eq_top_of_mul_eq_mul_pow (hAB : A * B = B * A ^ q)
    (hB : IsUnit B) {μ : K} (hμ : A.charpoly.IsRoot μ)
    (hdist : Injective fun i : Fin (Fintype.card n) ↦ μ ^ q ^ (i : ℕ)) :
    span K (Set.range fun p : Fin (Fintype.card n) × Fin (Fintype.card n) ↦
      B ^ (p.1 : ℕ) * A ^ (p.2 : ℕ)) = ⊤ :=
  (linearIndependent_pow_mul_pow_of_mul_eq_mul_pow hAB hB hμ hdist).span_eq_top_of_card_eq_finrank'
    (by simp [Module.finrank_matrix])

end Matrix
