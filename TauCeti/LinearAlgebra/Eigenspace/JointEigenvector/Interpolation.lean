public import Mathlib.LinearAlgebra.Eigenspace.Basic
public import Mathlib.LinearAlgebra.Trace
import Mathlib.Algebra.Algebra.Prod
import TauCeti.Algebra.Algebra.Subalgebra.Pi

/-!
# Interpolation on joint eigenspaces

A finite set of joint eigenvalue labels is separated by the coordinate functions. Interpolating
on those coordinates produces a single element of the algebra generated by the operators, with
prescribed scalar action on those eigenspaces in every representation. In particular, when the
joint eigenspaces span, equality of traces on the algebra gives equality of joint multiplicities.

The projector and trace comparison are the algebraic steps of `New.Data.exists_hecke_proj_eigenPart`
and `New.Data.finrank_goodForms_inf_eigenPart_eq` in lsernau/grh-lean (revision `72fead1`,
`grh/src/New/Spanning/Multiplicities/HeckeEigensystems.lean` and `EqualMultiplicities.lean`).
-/

public section

open Module Submodule

namespace TauCeti

universe v

/-- Prescribe the scalar action of one algebra element on a finite set of joint eigenspaces,
independently of the representation. The element belongs to the subalgebra generated by `a`;
neither commutativity of the generators nor a spanning hypothesis is needed. -/
theorem exists_mem_adjoin_apply_eq_smul_of_mem_jointEigenspace
    {K A ι : Type*} [Field K] [Semiring A] [Algebra K A] (a : ι → A)
    (s : Finset (ι → K)) (c : s → K) :
    ∃ p ∈ Algebra.adjoin K (Set.range a),
      ∀ {V : Type v} [AddCommGroup V] [Module K V] (ρ : A →ₐ[K] End K V) (χ : s)
        {x : V}, x ∈ (⨅ i, (ρ (a i)).eigenspace (χ.val i)) → ρ p x = c χ • x := by
  let g (i : ι) : A × (s → K) := (a i, fun χ ↦ χ.val i)
  let B := Algebra.adjoin K (Set.range g)
  let π := AlgHom.snd K A (s → K)
  have hsep : (B.map π : Set (s → K)).SeparatesPoints := by
    intro χ ψ h
    have hne : χ.val ≠ ψ.val := fun he ↦ h (Subtype.ext he)
    obtain ⟨i, hi⟩ : ∃ i, χ.val i ≠ ψ.val i := by
      by_contra! he
      exact hne (funext he)
    exact ⟨π (g i), ⟨g i, Algebra.subset_adjoin (Set.mem_range_self i), rfl⟩, hi⟩
  have hc : c ∈ B.map π := by rw [Subalgebra.eq_top_of_separatesPoints hsep]; trivial
  obtain ⟨⟨p, d⟩, hp, hd⟩ := hc
  have hfst : B ≤ (Algebra.adjoin K (Set.range a)).comap (AlgHom.fst K A (s → K)) :=
    Algebra.adjoin_le (by
      rintro _ ⟨i, rfl⟩
      exact Algebra.subset_adjoin (Set.mem_range_self i))
  refine ⟨p, hfst hp, fun {V} _ _ ρ χ x hx ↦ ?_⟩
  have he (z : A × (s → K)) (hz : z ∈ B) : ρ z.1 x = z.2 χ • x := by
    induction hz using Algebra.adjoin_induction with
    | mem z hz =>
      obtain ⟨i, rfl⟩ := hz
      exact End.mem_eigenspace_iff.mp ((mem_iInf _).mp hx i)
    | algebraMap r => simp [algebraMap_end_apply]
    | add z w _ _ hz hw =>
      simp [hz, hw, add_smul]
    | mul z w _ _ hz hw =>
      simp [hw, map_smul, hz, smul_smul, mul_comm]
  exact (he _ hp).trans (congrArg (fun f : s → K ↦ f χ • x) hd)

open scoped Classical in
private theorem trace_eq_finrank_of_jointEigenprojection
    {K A ι V : Type*} [Field K] [Semiring A] [Algebra K A] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] {a : ι → A} {s : Finset (ι → K)} (ρ : A →ₐ[K] End K V)
    (q : s) {p : A}
    (hspan : (⨆ χ : s, ⨅ i, (ρ (a i)).eigenspace (χ.val i)) = ⊤)
    (hp : ∀ (χ : s) {x : V}, x ∈ (⨅ i, (ρ (a i)).eigenspace (χ.val i)) →
      ρ p x = (Pi.single q 1 : s → K) χ • x) :
    LinearMap.trace K V (ρ p) = (finrank K ↥(⨅ i, (ρ (a i)).eigenspace (q.val i)) : K) := by
  let E (χ : s) := ⨅ i, (ρ (a i)).eigenspace (χ.val i)
  have hle : (⨆ χ, E χ) ≤ (E q).comap (ρ p) := by
    refine iSup_le fun χ x hx ↦ ?_
    rw [mem_comap, hp χ hx]
    by_cases h : χ = q
    · subst χ
      simpa using hx
    · simp [Pi.single_eq_of_ne h]
  have hproj : LinearMap.IsProj (E q) (ρ p) :=
    ⟨fun x ↦ hle (hspan ▸ mem_top), fun x hx ↦ by simpa using hp q hx⟩
  exact hproj.trace

/-- If the joint eigenspaces span each of two finite-dimensional representations, equal traces
on the generated subalgebra imply equal dimensions for each joint eigenspace. The
characteristic-zero assumption lets one recover the dimension from the trace of the projector. -/
theorem finrank_jointEigenspace_eq_of_trace_eq
    {K A ι V W : Type*} [Field K] [CharZero K] [Semiring A] [Algebra K A]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    [AddCommGroup W] [Module K W] [FiniteDimensional K W]
    {a : ι → A} {ρ : A →ₐ[K] End K V} {σ : A →ₐ[K] End K W}
    (hV : (⨆ χ : ι → K, ⨅ i, (ρ (a i)).eigenspace (χ i)) = ⊤)
    (hW : (⨆ χ : ι → K, ⨅ i, (σ (a i)).eigenspace (χ i)) = ⊤)
    (htrace : ∀ p ∈ Algebra.adjoin K (Set.range a),
      LinearMap.trace K V (ρ p) = LinearMap.trace K W (σ p)) (χ₀ : ι → K) :
    finrank K ↥(⨅ i, (ρ (a i)).eigenspace (χ₀ i)) =
      finrank K ↥(⨅ i, (σ (a i)).eigenspace (χ₀ i)) := by
  classical
  let E (χ : ι → K) := ⨅ i, (ρ (a i)).eigenspace (χ i)
  let F (χ : ι → K) := ⨅ i, (σ (a i)).eigenspace (χ i)
  obtain ⟨sV, hsV⟩ := ((fg_iff_compact (⊤ : Submodule K V)).mp Module.Finite.fg_top)
    |>.exists_finset_of_le_iSup E hV.ge
  obtain ⟨sW, hsW⟩ := ((fg_iff_compact (⊤ : Submodule K W)).mp Module.Finite.fg_top)
    |>.exists_finset_of_le_iSup F hW.ge
  let s := insert χ₀ (sV ∪ sW)
  let q : s := ⟨χ₀, Finset.mem_insert_self ..⟩
  have hE : (⨆ χ : s, E χ.val) = ⊤ := by
    rw [iSup_subtype, eq_top_iff]
    exact hsV.trans (iSup₂_le fun χ hχ ↦ le_iSup₂ (f := fun i (_ : i ∈ s) ↦ E i) χ
      (Finset.mem_insert_of_mem (Finset.mem_union_left _ hχ)))
  have hF : (⨆ χ : s, F χ.val) = ⊤ := by
    rw [iSup_subtype, eq_top_iff]
    exact hsW.trans (iSup₂_le fun χ hχ ↦ le_iSup₂ (f := fun i (_ : i ∈ s) ↦ F i) χ
      (Finset.mem_insert_of_mem (Finset.mem_union_right _ hχ)))
  -- Apply the common interpolation element to the direct product to cover both universes.
  let τ := (LinearMap.prodMapAlgHom K V W).comp (ρ.prod σ)
  obtain ⟨p, hp, hproj⟩ :=
    exists_mem_adjoin_apply_eq_smul_of_mem_jointEigenspace a s (Pi.single q 1)
  have hv (χ : s) {x : V} (hx : x ∈ ⨅ i, (ρ (a i)).eigenspace (χ.val i)) :
      ρ p x = (Pi.single q 1 : s → K) χ • x := by
    have hx' : (x, (0 : W)) ∈ ⨅ i, (τ (a i)).eigenspace (χ.val i) := by
      refine (mem_iInf _).mpr fun i ↦ End.mem_eigenspace_iff.mpr ?_
      exact Prod.ext (End.mem_eigenspace_iff.mp ((mem_iInf _).mp hx i)) (by simp [τ])
    exact congrArg Prod.fst (hproj τ χ hx')
  have hw (χ : s) {x : W} (hx : x ∈ ⨅ i, (σ (a i)).eigenspace (χ.val i)) :
      σ p x = (Pi.single q 1 : s → K) χ • x := by
    have hx' : ((0 : V), x) ∈ ⨅ i, (τ (a i)).eigenspace (χ.val i) := by
      refine (mem_iInf _).mpr fun i ↦ End.mem_eigenspace_iff.mpr ?_
      exact Prod.ext (by simp [τ]) (End.mem_eigenspace_iff.mp ((mem_iInf _).mp hx i))
    exact congrArg Prod.snd (hproj τ χ hx')
  exact Nat.cast_injective (R := K) ((trace_eq_finrank_of_jointEigenprojection ρ q hE hv).symm.trans
    ((htrace p hp).trans (trace_eq_finrank_of_jointEigenprojection σ q hF hw)))

end TauCeti
