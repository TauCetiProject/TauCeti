module

public import Mathlib.LinearAlgebra.Pi
public import Mathlib.LinearAlgebra.Quotient.Basic

/-!
# Quotients generated by lifts of the standard basis

Let `N ⊆ R^ι` be a submodule, `ι` finite, and `w : ι → R^ι` with `w i ≡ e_i` modulo `N`. Then
every `y ∈ R^ι` is congruent to `∑ i, y i • w i` modulo `N`. Hence, for a linear map
`Φ : V → R^ι` and `v : ι → V` with `Φ (v i) ≡ e_i` modulo `N`, the classes of the `v i` span
`V ⧸ Φ⁻¹(N)`, and a linear map on `V ⧸ Φ⁻¹(N)` vanishing at them is zero.

## Main results

* `Submodule.sub_sum_smul_mem`: if `w i - e_i ∈ N` for all `i`, then `y - ∑ i, y i • w i ∈ N`.
* `Submodule.span_range_mkQ_comap_eq_top`: if `Φ (v i) - e_i ∈ N` for all `i`, the classes of the
  `v i` span `V ⧸ Φ⁻¹(N)`.
* `Submodule.eq_zero_of_forall_apply_mkQ_comap_eq_zero`: under the same hypothesis, a linear map
  on `V ⧸ Φ⁻¹(N)` vanishing at the classes of the `v i` is zero.
-/

public section

namespace Submodule

variable {R V ι : Type*} [Ring R] [AddCommGroup V] [Module R V] [DecidableEq ι]
  {N : Submodule R (ι → R)}

/-- If `w i ≡ e_i` modulo `N ⊆ R^ι` for every `i`, every `y ∈ R^ι` is congruent to
`∑ i, y i • w i` modulo `N`. -/
theorem sub_sum_smul_mem [Fintype ι] {w : ι → ι → R} (h : ∀ i, w i - Pi.single i 1 ∈ N)
    (y : ι → R) : y - ∑ i, y i • w i ∈ N := by
  have hy : y - ∑ i, y i • w i = ∑ i, y i • (Pi.single i 1 - w i) := by
    simp_rw [smul_sub, Finset.sum_sub_distrib]
    congr 1
    ext j
    simp [Finset.sum_apply, Pi.single_apply]
  rw [hy]
  exact sum_mem fun i _ ↦ smul_mem _ _ (by simpa using neg_mem (h i))

variable {Φ : V →ₗ[R] ι → R} {v : ι → V}

/-- If `Φ (v i) ≡ e_i` modulo `N ⊆ R^ι` for every `i`, the classes of the `v i` span
`V ⧸ Φ⁻¹(N)`. -/
theorem span_range_mkQ_comap_eq_top [Finite ι] (h : ∀ i, Φ (v i) - Pi.single i 1 ∈ N) :
    span R (Set.range fun i ↦ (N.comap Φ).mkQ (v i)) = ⊤ := by
  have := Fintype.ofFinite ι
  refine eq_top_iff.2 fun q _ ↦ ?_
  obtain ⟨x, rfl⟩ := (N.comap Φ).mkQ_surjective q
  have hx : (N.comap Φ).mkQ x = ∑ i, Φ x i • (N.comap Φ).mkQ (v i) := by
    simp_rw [← map_smul, ← map_sum]
    refine (Quotient.eq _).2 ?_
    simpa using sub_sum_smul_mem h (Φ x)
  rw [hx]
  exact sum_mem fun i _ ↦ smul_mem _ _ (subset_span ⟨i, rfl⟩)

/-- If `Φ (v i) ≡ e_i` modulo `N ⊆ R^ι` for every `i`, a linear map on `V ⧸ Φ⁻¹(N)` vanishing at
the classes of the `v i` is zero. -/
theorem eq_zero_of_forall_apply_mkQ_comap_eq_zero [Finite ι] {M : Type*} [AddCommGroup M]
    [Module R M] (h : ∀ i, Φ (v i) - Pi.single i 1 ∈ N) {Ψ : V ⧸ N.comap Φ →ₗ[R] M}
    (hΨ : ∀ i, Ψ ((N.comap Φ).mkQ (v i)) = 0) : Ψ = 0 :=
  LinearMap.ext_on_range (span_range_mkQ_comap_eq_top h) hΨ

end Submodule
