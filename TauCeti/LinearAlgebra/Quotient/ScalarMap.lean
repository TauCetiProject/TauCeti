module

public import Mathlib.LinearAlgebra.FreeModule.Basic
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
public import TauCeti.Algebra.Module.LinearMap.EndQuotient
public import TauCeti.RingTheory.Ideal.Colon
public import TauCeti.RingTheory.LocalRing.MaximalIdeal.Generator
import TauCeti.RingTheory.Ideal.Operations

/-!
# Multiplication by a scalar between quotients by ideals

Let `M` be a module over a commutative ring `R`, and let `I`, `J` be ideals of `R`. If `r ∈ R`
satisfies `r I ⊆ J`, that is `I ≤ (J : r)`, multiplication by `r` on `M` carries `I M` into `J M`
and so induces an `R`-linear map

```text
r : M ⧸ I M → M ⧸ J M.
```

These maps are the morphisms of Mazur and Rubin's category of quotients of `M`: they compose by
multiplying the scalars, the scalar `1` gives the identity, and they commute with the reduction of
every endomorphism of `M`, in particular with a Galois action on `M` by `R`-linear maps.

For a free module `M ≠ 0` such a map is injective exactly when `(J : r) = I`: the kernel of
`r : R ⧸ I → R ⧸ J` is `(J : r) ⧸ I`, and `M ⧸ I M` is a direct sum of copies of `R ⧸ I`. Over a
local ring whose maximal ideal `𝔪` is generated by `ϖ`, this applies to
`ϖ ^ (j - i) : M ⧸ 𝔪 ^ i M → M ⧸ 𝔪 ^ j M` for `i ≤ j` whenever `ϖ ^ (j - 1) ≠ 0`, for instance for
`j` at most the length of a principal Artinian ring. Freeness is needed: over `ℤ ⧸ p ^ 2`, the
map `p : M ⧸ p M → M` is zero on the nonzero module `M = ℤ ⧸ p`.

## Main definitions

* `Ideal.smulMapQ`: multiplication by `r` as an `R`-linear map `M ⧸ I M → M ⧸ J M`, for
  `I ≤ (J : r)`.

## Main results

* `Ideal.smulMapQ_comp_smulMapQ`: the map for `s` after the map for `r` is the map for `s * r`.
* `Ideal.smulMapQ_one_self`: the scalar `1` gives the identity of `M ⧸ I M`.
* `Ideal.smulMapQ_comp_endMapQ`: the maps commute with the reductions of an endomorphism of `M`.
* `Ideal.smulMapQ_injective_iff`: for a free module `M ≠ 0`, the map is injective exactly when
  `(J : r) = I`.
* `Ideal.smulMapQ_injective_pow`: over a local ring with maximal ideal generated by `ϖ`,
  multiplication by `ϖ ^ (j - i)` is injective from `M ⧸ 𝔪 ^ i M` to `M ⧸ 𝔪 ^ j M` for free `M`,
  `i ≤ j` and `ϖ ^ (j - 1) ≠ 0`.

## References

* B. Mazur and K. Rubin, *Kolyvagin systems*, Mem. Amer. Math. Soc. 168 (2004), no. 799,
  Example 1.1.3 and Lemma 1.1.5.
-/

public section

open IsLocalRing Module

namespace Ideal

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
  {I J K : Ideal R} {r s : R}

variable (M) in
/-- If `r I ⊆ J`, multiplication by `r` carries `I M` into `J M`. -/
theorem smul_top_le_comap_smul_top_of_le_colon (h : I ≤ J.colon {r}) :
    I • (⊤ : Submodule R M) ≤ (J • (⊤ : Submodule R M)).comap (r • LinearMap.id) := by
  refine Submodule.smul_le.mpr fun a ha x _ ↦ ?_
  rw [Submodule.mem_comap, LinearMap.smul_apply, LinearMap.id_apply, smul_smul]
  exact Submodule.smul_mem_smul (by simpa [mul_comm] using h ha) Submodule.mem_top

variable (M) in
/-- **Multiplication by a scalar between quotients by ideals.** For `r` with `r I ⊆ J`, that is
`I ≤ (J : r)`, multiplication by `r` on `M` induces the `R`-linear map `M ⧸ I M → M ⧸ J M`. -/
def smulMapQ (r : R) (h : I ≤ J.colon {r}) :
    M ⧸ I • (⊤ : Submodule R M) →ₗ[R] M ⧸ J • (⊤ : Submodule R M) :=
  Submodule.mapQ _ _ (r • LinearMap.id) (smul_top_le_comap_smul_top_of_le_colon M h)

@[simp]
theorem smulMapQ_mk (h : I ≤ J.colon {r}) (x : M) :
    smulMapQ M r h (Submodule.Quotient.mk x) = Submodule.Quotient.mk (r • x) :=
  (rfl)

/-- Multiplication by `r` between the quotients lifts multiplication by `r` on `M`. -/
theorem smulMapQ_comp_mkQ (h : I ≤ J.colon {r}) :
    smulMapQ M r h ∘ₗ (I • (⊤ : Submodule R M)).mkQ =
      (J • (⊤ : Submodule R M)).mkQ ∘ₗ (r • LinearMap.id) := by
  ext x
  simp

/-- Multiplication by `s` after multiplication by `r` is multiplication by `s * r`. -/
@[simp]
theorem smulMapQ_comp_smulMapQ (hIJ : I ≤ J.colon {r}) (hJK : J ≤ K.colon {s}) :
    smulMapQ M s hJK ∘ₗ smulMapQ M r hIJ = smulMapQ M (s * r) (le_colon_singleton_mul hIJ hJK) := by
  ext x
  simp [mul_comm s r, mul_smul]

/-- Multiplication by `1` is the reduction map `M ⧸ I M → M ⧸ J M` for `I ≤ J`. -/
theorem smulMapQ_one (h : I ≤ J.colon {1}) :
    smulMapQ M 1 h =
      Submodule.factor (Submodule.smul_mono_left fun a ha ↦ by simpa using h ha) := by
  ext x
  simp

/-- Multiplication by `1` is the identity of `M ⧸ I M`. -/
@[simp]
theorem smulMapQ_one_self (h : I ≤ I.colon {1}) : smulMapQ M (1 : R) h = LinearMap.id := by
  ext x
  simp

/-- Multiplication by a scalar commutes with the reductions of an endomorphism of `M`; in
particular it is equivariant for any action on `M` by `R`-linear maps. -/
theorem smulMapQ_comp_endMapQ (h : I ≤ J.colon {r}) (f : Module.End R M) :
    smulMapQ M r h ∘ₗ endMapQ I M f = endMapQ J M f ∘ₗ smulMapQ M r h := by
  ext x
  simp

/-- For a free module, multiplication by `r` from `M ⧸ I M` to `M ⧸ J M` is injective as soon as
`(J : r) ≤ I`. -/
theorem smulMapQ_injective_of_colon_le [Module.Free R M] (h : I ≤ J.colon {r})
    (hc : J.colon {r} ≤ I) : Function.Injective (smulMapQ M r h) := by
  let b := Module.Free.chooseBasis R M
  refine (injective_iff_map_eq_zero _).mpr fun x hx ↦ ?_
  induction x using Submodule.Quotient.induction_on with | H x => ?_
  rw [smulMapQ_mk, Submodule.Quotient.mk_eq_zero, b.mem_smul_top_iff] at hx
  rw [Submodule.Quotient.mk_eq_zero, b.mem_smul_top_iff]
  exact fun i ↦ hc (by simpa [mul_comm] using hx i)

/-- **Injectivity of multiplication by a scalar.** For a nonzero free module `M` and `r I ⊆ J`,
multiplication by `r` from `M ⧸ I M` to `M ⧸ J M` is injective exactly when `(J : r) = I`. -/
theorem smulMapQ_injective_iff [Module.Free R M] [Nontrivial M] (h : I ≤ J.colon {r}) :
    Function.Injective (smulMapQ M r h) ↔ J.colon {r} = I := by
  refine ⟨fun hinj ↦ le_antisymm (fun a ha ↦ ?_) h,
    fun hc ↦ smulMapQ_injective_of_colon_le h hc.le⟩
  let b := Module.Free.chooseBasis R M
  obtain ⟨i⟩ := b.index_nonempty
  have hzero : smulMapQ M r h (Submodule.Quotient.mk (a • b i)) = 0 := by
    rw [smulMapQ_mk, Submodule.Quotient.mk_eq_zero, smul_smul]
    exact Submodule.smul_mem_smul (by simpa [mul_comm] using ha) Submodule.mem_top
  have hmem := (Submodule.Quotient.mk_eq_zero _).mp (hinj (hzero.trans (map_zero _).symm))
  simpa using (b.mem_smul_top_iff.mp hmem) i

/-- Over a local ring whose maximal ideal `𝔪` is generated by `ϖ`, multiplication by
`ϖ ^ (j - i)` from `M ⧸ 𝔪 ^ i M` to `M ⧸ 𝔪 ^ j M` is injective for a free module `M`, provided
`i ≤ j` and `ϖ ^ (j - 1) ≠ 0`. -/
theorem smulMapQ_injective_pow [IsLocalRing R] [Module.Free R M] {ϖ : R}
    (hϖ : maximalIdeal R = span {ϖ}) {i j : ℕ} (hij : i ≤ j) (hj : ϖ ^ (j - 1) ≠ 0) :
    Function.Injective (smulMapQ M (ϖ ^ (j - i))
      (pow_le_colon_singleton_pow (TauCeti.IsLocalRing.mem_maximalIdeal_of_eq_span hϖ) hij)) :=
  smulMapQ_injective_of_colon_le _
    (TauCeti.IsLocalRing.maximalIdeal_pow_colon_pow hϖ hij hj).le

end Ideal
