module

public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.RingTheory.Ideal.Span

/-!
# A two-generator quotient of a plane

For any ring `R`, the left `R`-module quotient of `R × R` by the lines generated by
`(1, 0)` and `(1, a)` is `R ⧸ (a)`, where `(a)` denotes the principal left ideal.
This identifies the integral obstruction to splitting two rank-one submodules: the second
coordinate modulo `a` gives the comparison, including when `a` is zero or a zero divisor.
-/

public section

open Submodule

namespace TauCeti

variable {R : Type*} [Ring R]

/-- The sum of the lines generated by `(1, 0)` and `(1, a)` consists exactly of the vectors
whose second coordinate is a left multiple of `a`. -/
theorem span_sup_span_prod_eq_comap_snd (a : R) :
    R ∙ ((1, 0) : R × R) ⊔ R ∙ (1, a) =
      (Ideal.span {a}).comap (LinearMap.snd R R R) := by
  ext x
  rw [← span_insert, mem_span_pair]
  simp only [mem_comap, LinearMap.snd_apply, Ideal.mem_span_singleton']
  constructor
  · rintro ⟨r, s, h⟩
    exact ⟨s, by simpa using congrArg Prod.snd h⟩
  · rintro ⟨s, hs⟩
    refine ⟨x.1 - s, s, ?_⟩
    ext <;> simp [hs]

/-- The left `R`-module quotient by the lines through `(1, 0)` and `(1, a)` is the quotient
of `R` by the principal left ideal `(a)`. The class of `(x, y)` maps to the class of `y`. -/
noncomputable def quotientSpanSupSpanProdEquiv (a : R) :
    ((R × R) ⧸ (R ∙ ((1, 0) : R × R) ⊔ R ∙ (1, a))) ≃ₗ[R] R ⧸ Ideal.span {a} :=
  let f := (Ideal.span {a}).mkQ.comp (LinearMap.snd R R R)
  (quotEquivOfEq _ _ (by
    rw [LinearMap.ker_comp, ker_mkQ]
    exact span_sup_span_prod_eq_comap_snd a)).trans
      (f.quotKerEquivOfSurjective (by
        intro y
        obtain ⟨y, rfl⟩ := (Ideal.span {a}).mkQ_surjective y
        exact ⟨(0, y), rfl⟩))

/-- The comparison is the second coordinate on quotient representatives. -/
@[simp]
theorem quotientSpanSupSpanProdEquiv_apply_mk (a : R) (x : R × R) :
    quotientSpanSupSpanProdEquiv a (Submodule.Quotient.mk x) = Submodule.Quotient.mk x.2 := by
  simp only [quotientSpanSupSpanProdEquiv, LinearEquiv.trans_apply, quotEquivOfEq_mk]
  exact LinearMap.quotKerEquivOfSurjective_apply_mk _ _ x

/-- The inverse comparison sends the class of `y` to the class of `(0, y)`. -/
@[simp]
theorem quotientSpanSupSpanProdEquiv_symm_apply_mk (a y : R) :
    (quotientSpanSupSpanProdEquiv a).symm (Submodule.Quotient.mk y) =
      Submodule.Quotient.mk ((0 : R), y) := by
  apply (quotientSpanSupSpanProdEquiv a).injective
  simp

end TauCeti
