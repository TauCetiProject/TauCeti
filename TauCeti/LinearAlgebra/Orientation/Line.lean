module

public import Mathlib.LinearAlgebra.Orientation
import TauCeti.LinearAlgebra.Orientation.Basic
import TauCeti.LinearAlgebra.Ray

/-!
# The orientation line of a module

For a module `M` over an ordered field `K` and a ring `R`, the **orientation line** of `M` with
coefficients in `R` (`TauCeti.orientationLine K M ι R`) is the `R`-module of the functions `φ`
from the orientations of `M` to `R` that are odd, `φ (-o) = -φ o`. When `M` has dimension the
cardinality of `ι`, it has exactly the two orientations `o` and `-o`, so evaluation at either one is
an isomorphism with `R` (`TauCeti.orientationLineEquiv`), and the two isomorphisms differ by a sign.
For `R = ℤ` this is the free abelian group of rank one generated by the orientations of `M`, modulo
the relation identifying the opposite of an orientation with its negative: a copy of `ℤ` without a
preferred generator. For a real vector bundle, the same modules over every point, presented as
fibres of the orientation double cover (`TauCeti.signFiber`), form the orientation local system
`TauCeti.VectorBundleOrientationCover.signLocalSystem`. This file treats a single module, with the
operations of linear algebra rather than of covering spaces.

Orientation lines are how signs are handled without choosing orientations. A chain complex whose
generators would need an orientation of some space, such as the Morse complex, whose generators
need orientations of the unstable manifolds, has as its coefficient-free version the direct sum of
the orientation lines of these spaces. A linear isomorphism transports orientation lines
(`TauCeti.orientationLineCongr`), and a pairing between orientations of two spaces which changes
sign when either orientation is reversed, such as a signed count of trajectories, induces a linear
map between their orientation lines (`TauCeti.orientationLineHom`) that does not depend on a choice
of orientations (`TauCeti.orientationLineHom_apply`).

## Main definitions

* `TauCeti.orientationLine K M ι R`: the odd functions from the orientations of `M` to `R`.
* `TauCeti.orientationLineEquiv`: in the right dimension, evaluation at an orientation is an
  isomorphism of the orientation line with `R`.
* `TauCeti.orientationLineCongr`: the isomorphism of orientation lines induced by a linear
  isomorphism.
* `TauCeti.orientationLineHom`: the linear map of orientation lines induced by a pairing of
  orientations that is odd in each argument.

## Main results

* `TauCeti.orientationLineEquiv_neg_apply`: evaluation at the opposite orientation is the negative.
* `TauCeti.orientationLineEquiv_symm_apply`: the element with a prescribed value at one
  orientation.
* `TauCeti.orientationLineCongr_refl`, `TauCeti.orientationLineCongr_trans`: transport is
  functorial.
* `TauCeti.orientationLineHom_apply`: the induced map is computed from any orientation of the
  source.
-/

public section

open Module

namespace TauCeti

section CommRing

variable (K : Type*) [CommRing K] [PartialOrder K] [IsStrictOrderedRing K]
  (M : Type*) [AddCommGroup M] [Module K M] (ι : Type*) (R : Type*) [Ring R]

/-- The **orientation line** of `M` with coefficients in `R`: the `R`-module of odd functions from
the orientations of `M` to `R`, those with `φ (-o) = -φ o`. When the dimension of `M` is the
cardinality of `ι`, evaluation at any orientation identifies it with `R`
(`TauCeti.orientationLineEquiv`). -/
def orientationLine : Submodule R (Orientation K M ι → R) where
  carrier := {φ | ∀ o, φ (-o) = -φ o}
  add_mem' {φ ψ} hφ hψ o := by simp [hφ o, hψ o, add_comm]
  zero_mem' _ := by simp
  smul_mem' r φ hφ o := by simp [hφ o]

variable {K M ι R}

theorem mem_orientationLine {φ : Orientation K M ι → R} :
    φ ∈ orientationLine K M ι R ↔ ∀ o, φ (-o) = -φ o :=
  Iff.rfl

/-- An element of the orientation line takes opposite values at opposite orientations. -/
@[simp]
theorem orientationLine_apply_neg (φ : orientationLine K M ι R) (o : Orientation K M ι) :
    (φ : Orientation K M ι → R) (-o) = -(φ : Orientation K M ι → R) o :=
  φ.2 o

/-- Two elements of an orientation line are equal when they agree at every orientation. -/
@[ext]
theorem orientationLine_ext {φ ψ : orientationLine K M ι R}
    (h : ∀ o, (φ : Orientation K M ι → R) o = (ψ : Orientation K M ι → R) o) : φ = ψ :=
  Subtype.ext (funext h)

variable {N : Type*} [AddCommGroup N] [Module K N]

variable (R) in
/-- The isomorphism of orientation lines induced by a linear isomorphism `e : M ≃ₗ[K] N`: an odd
function `φ` on the orientations of `M` is sent to the odd function on the orientations of `N`
whose value at the transported orientation `Orientation.map ι e o` is `φ o`. -/
def orientationLineCongr (e : M ≃ₗ[K] N) :
    orientationLine K M ι R ≃ₗ[R] orientationLine K N ι R where
  toFun φ := ⟨fun o ↦ (φ : Orientation K M ι → R) (Orientation.map ι e.symm o), fun o ↦ by
    simp [Orientation.map_neg]⟩
  invFun ψ := ⟨fun o ↦ (ψ : Orientation K N ι → R) (Orientation.map ι e o), fun o ↦ by
    simp [Orientation.map_neg]⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv φ := orientationLine_ext fun o ↦ by simp [← Orientation.map_trans]
  right_inv ψ := orientationLine_ext fun o ↦ by simp [← Orientation.map_trans]

/-- The value of a transported element at an orientation of `N` is the value of the original one
at the orientation of `M` transported back. -/
theorem orientationLineCongr_apply (e : M ≃ₗ[K] N) (φ : orientationLine K M ι R)
    (o : Orientation K N ι) :
    (orientationLineCongr R e φ : Orientation K N ι → R) o =
      (φ : Orientation K M ι → R) (Orientation.map ι e.symm o) :=
  (rfl)

/-- **The transported element at the transported orientation** takes the original value. -/
@[simp]
theorem orientationLineCongr_apply_map (e : M ≃ₗ[K] N) (φ : orientationLine K M ι R)
    (o : Orientation K M ι) :
    (orientationLineCongr R e φ : Orientation K N ι → R) (Orientation.map ι e o) =
      (φ : Orientation K M ι → R) o := by
  simp [orientationLineCongr_apply, ← Orientation.map_trans]

@[simp]
theorem orientationLineCongr_symm (e : M ≃ₗ[K] N) :
    (orientationLineCongr R e (ι := ι)).symm = orientationLineCongr R e.symm :=
  (rfl)

/-- Transport along the identity is the identity. -/
@[simp]
theorem orientationLineCongr_refl :
    orientationLineCongr R (LinearEquiv.refl K M) (ι := ι) = LinearEquiv.refl R _ := by
  ext φ o
  simp [orientationLineCongr_apply, Orientation.map_refl]

/-- **Transport is functorial**: transporting along a composite is transporting along each
isomorphism in turn. -/
theorem orientationLineCongr_trans {P : Type*} [AddCommGroup P] [Module K P] (e : M ≃ₗ[K] N)
    (e' : N ≃ₗ[K] P) :
    orientationLineCongr R (e.trans e') (ι := ι) =
      (orientationLineCongr R e).trans (orientationLineCongr R e') := by
  ext φ o
  simp [orientationLineCongr_apply, ← Orientation.map_trans]

variable {κ : Type*}

/-- The map of orientation lines induced by a pairing `s` of orientations, read at a fixed
orientation `o` of the source: `φ` is sent to `w ↦ φ o * s o w`. This is an implementation step of
`TauCeti.orientationLineHom`, which does not depend on `o`. -/
private def orientationLineHomAt (s : Orientation K M ι → Orientation K N κ → R)
    (hs : ∀ v w, s v (-w) = -s v w) (o : Orientation K M ι) :
    orientationLine K M ι R →ₗ[R] orientationLine K N κ R where
  toFun φ := ⟨fun w ↦ (φ : Orientation K M ι → R) o * s o w, fun w ↦ by simp [hs]⟩
  map_add' _ _ := orientationLine_ext fun _ ↦ add_mul _ _ _
  map_smul' _ _ := orientationLine_ext fun _ ↦ mul_assoc _ _ _

private theorem orientationLineHomAt_apply {s : Orientation K M ι → Orientation K N κ → R}
    {hs : ∀ v w, s v (-w) = -s v w} (o : Orientation K M ι) (φ : orientationLine K M ι R)
    (w : Orientation K N κ) :
    (orientationLineHomAt s hs o φ : Orientation K N κ → R) w =
      (φ : Orientation K M ι → R) o * s o w :=
  (rfl)

open scoped Classical in
variable (R) in
/-- **The map of orientation lines induced by an odd pairing.** For a pairing `s` of the
orientations of `M` and of `N` with values in `R` which changes sign when either orientation is
reversed, an odd function `φ` on the orientations of `M` is sent to the odd function
`w ↦ φ v * s v w` on the orientations of `N`. In the right dimension this does not depend on the
orientation `v` of `M` (`TauCeti.orientationLineHom_apply`), since `φ` and `s` both change sign
with `v`. The definition reads it at some orientation, if `M` has one; otherwise the orientation
line of `M` is zero. Oddness in the first argument is only needed for the independence. -/
noncomputable def orientationLineHom (s : Orientation K M ι → Orientation K N κ → R)
    (hs : ∀ v w, s v (-w) = -s v w) :
    orientationLine K M ι R →ₗ[R] orientationLine K N κ R :=
  if h : Nonempty (Orientation K M ι) then orientationLineHomAt s hs h.some else 0

end CommRing

section Field

variable {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  {M : Type*} [AddCommGroup M] [Module K M] {ι : Type*} [Fintype ι] {R : Type*} [Ring R]

open scoped Classical in
variable (R) in
/-- **Evaluation at an orientation** identifies the orientation line with `R`, when the dimension
of `M` is the cardinality of `ι`: then every orientation is `o` or `-o`, so an odd function is
determined by its value at `o`. -/
noncomputable def orientationLineEquiv (o : Orientation K M ι) (h : Fintype.card ι = finrank K M) :
    orientationLine K M ι R ≃ₗ[R] R where
  toFun φ := (φ : Orientation K M ι → R) o
  invFun r := ⟨fun o' ↦ if o' = o then r else -r, fun o' ↦ by
    rcases Orientation.eq_or_eq_neg_of_card_eq_finrank o' o h with rfl | rfl
    · simp [(Module.Ray.ne_neg_self o').symm]
    · simp [(Module.Ray.ne_neg_self o).symm, Module.Ray.neg_neg]⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv φ := orientationLine_ext fun o' ↦ by
    rcases Orientation.eq_or_eq_neg_of_card_eq_finrank o' o h with rfl | rfl
    · simp
    · simp [(Module.Ray.ne_neg_self o).symm]
  right_inv _ := by simp

variable {o : Orientation K M ι} {h : Fintype.card ι = finrank K M}

@[simp]
theorem orientationLineEquiv_apply (φ : orientationLine K M ι R) :
    orientationLineEquiv R o h φ = (φ : Orientation K M ι → R) o :=
  (rfl)

open scoped Classical in
/-- The element of the orientation line with value `r` at `o` takes the value `-r` at every other
orientation, which is `-o`. -/
theorem orientationLineEquiv_symm_apply (r : R) (o' : Orientation K M ι) :
    ((orientationLineEquiv R o h).symm r : Orientation K M ι → R) o' =
      if o' = o then r else -r :=
  (rfl)

/-- **Evaluation at the opposite orientation** is the negative of evaluation at `o`. -/
theorem orientationLineEquiv_neg_apply (φ : orientationLine K M ι R) :
    orientationLineEquiv R (-o) h φ = -orientationLineEquiv R o h φ := by
  simp

variable {N : Type*} [AddCommGroup N] [Module K N] {κ : Type*}

/-- **The induced map is computed from any orientation of the source**: its value at `w` on `φ` is
`φ v * s v w`, for every orientation `v` of `M`. -/
theorem orientationLineHom_apply (hι : Fintype.card ι = finrank K M)
    {s : Orientation K M ι → Orientation K N κ → R} (hs₁ : ∀ v w, s (-v) w = -s v w)
    (hs₂ : ∀ v w, s v (-w) = -s v w) (φ : orientationLine K M ι R) (v : Orientation K M ι)
    (w : Orientation K N κ) :
    (orientationLineHom R s hs₂ φ : Orientation K N κ → R) w =
      (φ : Orientation K M ι → R) v * s v w := by
  have h : Nonempty (Orientation K M ι) := ⟨v⟩
  simp only [orientationLineHom, h, ↓reduceDIte, orientationLineHomAt_apply]
  rcases Orientation.eq_or_eq_neg_of_card_eq_finrank h.some v hι with h' | h'
  · rw [h']
  · rw [h', hs₁, orientationLine_apply_neg, neg_mul_neg]

end Field

end TauCeti
