/-!
# The elementary orthogonal group and its transitivity on singular vectors

Let `Q` be a quadratic form with un-halved polar form `B = polar Q`. The **elementary orthogonal
group** `EO(Q)` (`QuadraticMap.elementaryOrthogonalGroup Q`) is the subgroup generated by all
Eichler transvections

`E_{u,w} x = x + B x u • w - B x w • u - (Q w * B x u) • u`,

for `u` singular (`Q u = 0`) and `w` orthogonal to `u`. It lies in the special orthogonal group,
contains the image of every Eichler root-subgroup homomorphism `QuadraticMap.transvectionHom`, and
is normalized by the whole orthogonal group, because an isometry conjugates `E_{u,w}` to
`E_{g u, g w}`. Classically, for Witt index at least two `EO(Q)` is the group usually written
`Ω(Q)`, and in dimension at least five its central quotient is simple (Taylor, Chapter 11);
neither fact is proved here. In Iwasawa's simplicity criterion for that quotient, acting on the
singular points, the abelian subgroups are the root subgroups `{E_{u,w}}` of the singular
vectors `u`, and the action has to be transitive. This file proves that transitivity.

**Transitivity.** Over a field, let `B` be nondegenerate and suppose that `Q` vanishes on some
plane, that is, the Witt index of `Q` (the largest dimension of a subspace on which `Q` vanishes)
is at least two. Then `EO(Q)` acts transitively on the nonzero singular vectors
(`QuadraticMap.exists_mem_elementaryOrthogonalGroup_apply_eq`). Neither the dimension nor the
characteristic is restricted: the hypothesis is the nondegeneracy of the polar form `B` itself.
In odd characteristic this is the nondegeneracy of `Q`; in characteristic two it holds for the
even-dimensional orthogonal geometries of types `Dₙ` and `²Dₙ`, but not in odd dimension, where
`B` always has a radical.

The proof is a chain of single transvections. If `u` and `v` are singular, orthogonal and
linearly independent, then `z = v - u` is singular, and choosing `w` with `B u w = B v w = -1`
gives `E_{z,w} u = v`. A plane `⟨e, e'⟩` on which `Q` vanishes then connects everything to `e`:
a nonzero singular `u` orthogonal to `e` is reached directly or, if it is a multiple of `e`,
through `e'`; if `B e u ≠ 0`, the vector `e' - (B e' u / B e u) • e` of the plane is orthogonal
to both `e` and `u` and serves as a stepping stone. Without the plane the statement fails: on a
hyperbolic plane every Eichler transvection is trivial
(`QuadraticMap.transvection_eq_one_of_finrank_eq_two`), while there are two singular lines.

## Main definitions

* `QuadraticMap.elementaryOrthogonalGroup Q`: the subgroup generated by the Eichler
  transvections of `Q`.

## Main results

* `QuadraticMap.transvection_mem_elementaryOrthogonalGroup`: Eichler transvections lie in it.
* `QuadraticMap.elementaryOrthogonalGroup_le_specialOrthogonalGroup`: it consists of proper
  isometries.
* `QuadraticMap.orthogonalGroup_le_normalizer_elementaryOrthogonalGroup`: the orthogonal group
  normalizes it.
* `QuadraticMap.exists_mem_elementaryOrthogonalGroup_apply_eq_of_polar_eq_zero`: one Eichler
  transvection joins two orthogonal singular vectors that some `w` pairs to `1` with both.
* `QuadraticMap.exists_mem_elementaryOrthogonalGroup_apply_eq`: transitivity on the nonzero
  singular vectors when the polar form is nondegenerate and `Q` vanishes on a plane.

## References

* D. E. Taylor, *The Geometry of the Classical Groups* (1992), Chapter 11.
* L. C. Grove, *Classical Groups and Geometric Algebra* (2002), Chapters 6 and 14.
* M. Eichler, *Quadratische Formen und orthogonale Gruppen*, Springer (1952).
-/

public section

open TauCeti.QuadraticMap Module

namespace QuadraticMap

section CommRing

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] {Q : QuadraticForm R M}

variable (Q) in
/-- **The elementary orthogonal group** `EO(Q)`: the subgroup generated by the Eichler
transvections `E_{u,w}` of `Q`, for all singular `u` and all `w` orthogonal to `u`. -/
def elementaryOrthogonalGroup : Subgroup (M ≃ₗ[R] M) :=
  Subgroup.closure {g | ∃ (u w : M) (hu : Q u = 0) (huw : polar Q u w = 0),
    transvection Q hu huw = g}

/-- The elementary orthogonal group is generated by the Eichler transvections. -/
theorem elementaryOrthogonalGroup_def :
    elementaryOrthogonalGroup Q = Subgroup.closure {g | ∃ (u w : M) (hu : Q u = 0)
      (huw : polar Q u w = 0), transvection Q hu huw = g} := (rfl)

/-- Every Eichler transvection lies in the elementary orthogonal group. -/
@[simp]
theorem transvection_mem_elementaryOrthogonalGroup {u w : M} (hu : Q u = 0)
    (huw : polar Q u w = 0) : transvection Q hu huw ∈ elementaryOrthogonalGroup Q :=
  Subgroup.subset_closure ⟨u, w, hu, huw, rfl⟩

/-- A subgroup contains the elementary orthogonal group if and only if it contains every Eichler
transvection. -/
theorem elementaryOrthogonalGroup_le_iff {H : Subgroup (M ≃ₗ[R] M)} :
    elementaryOrthogonalGroup Q ≤ H ↔
      ∀ (u w : M) (hu : Q u = 0) (huw : polar Q u w = 0), transvection Q hu huw ∈ H := by
  rw [elementaryOrthogonalGroup_def, Subgroup.closure_le]
  exact ⟨fun h u w hu huw => h ⟨u, w, hu, huw, rfl⟩,
    fun h _ ⟨u, w, hu, huw, hg⟩ => hg ▸ h u w hu huw⟩

/-- An element lies in the elementary orthogonal group if and only if it lies in every subgroup
containing all Eichler transvections. -/
theorem mem_elementaryOrthogonalGroup_iff {g : M ≃ₗ[R] M} :
    g ∈ elementaryOrthogonalGroup Q ↔ ∀ H : Subgroup (M ≃ₗ[R] M),
      (∀ (u w : M) (hu : Q u = 0) (huw : polar Q u w = 0), transvection Q hu huw ∈ H) →
        g ∈ H :=
  ⟨fun hg _ hH => elementaryOrthogonalGroup_le_iff.mpr hH hg,
    fun h => h _ fun _ _ => transvection_mem_elementaryOrthogonalGroup⟩

/-- The image of the Eichler root-subgroup homomorphism of a singular vector lies in the elementary
orthogonal group. -/
theorem coe_toMul_transvectionHom_mem_elementaryOrthogonalGroup {u : M} (hu : Q u = 0)
    (x : LinearMap.ker (Q.polarBilin u) ⧸
      (R ∙ u).comap (LinearMap.ker (Q.polarBilin u)).subtype) :
    ((Additive.toMul (transvectionHom Q hu x) : specialOrthogonalGroup Q) : M ≃ₗ[R] M) ∈
      elementaryOrthogonalGroup Q := by
  induction x using Submodule.Quotient.induction_on with | H w =>
    obtain ⟨w, hw⟩ := w
    have huw : polar Q u w = 0 := by simpa using hw
    rw [coe_transvectionHom_mk hu huw]
    exact transvection_mem_elementaryOrthogonalGroup hu huw

/-- The elementary orthogonal group consists of proper isometries. -/
theorem elementaryOrthogonalGroup_le_specialOrthogonalGroup :
    elementaryOrthogonalGroup Q ≤ specialOrthogonalGroup Q :=
  elementaryOrthogonalGroup_le_iff.mpr fun _ _ => transvection_mem_specialOrthogonalGroup

/-- The elementary orthogonal group consists of isometries. -/
theorem elementaryOrthogonalGroup_le_orthogonalGroup :
    elementaryOrthogonalGroup Q ≤ orthogonalGroup Q :=
  elementaryOrthogonalGroup_le_specialOrthogonalGroup.trans
    (specialOrthogonalGroup_le_orthogonalGroup Q)

/-- **The orthogonal group normalizes the elementary orthogonal group**, since an isometry `g`
conjugates `E_{u,w}` to `E_{g u, g w}`. -/
theorem orthogonalGroup_le_normalizer_elementaryOrthogonalGroup :
    orthogonalGroup Q ≤ Subgroup.normalizer (elementaryOrthogonalGroup Q : Set (M ≃ₗ[R] M)) :=
  Subgroup.le_normalizer_closure_iff.mpr fun _ hg _ ⟨_, _, hu, huw, hx⟩ =>
    hx ▸ (transvection_conj hu huw hg).symm ▸ transvection_mem_elementaryOrthogonalGroup _ _

/-- Conjugating an element of the elementary orthogonal group by an isometry stays in it. -/
theorem mul_mul_inv_mem_elementaryOrthogonalGroup {g x : M ≃ₗ[R] M}
    (hg : g ∈ orthogonalGroup Q) (hx : x ∈ elementaryOrthogonalGroup Q) :
    g * x * g⁻¹ ∈ elementaryOrthogonalGroup Q :=
  Subgroup.le_normalizer_iff.mp orthogonalGroup_le_normalizer_elementaryOrthogonalGroup g hg x hx

/-- The elementary orthogonal group is a normal subgroup of the orthogonal group. -/
instance normal_elementaryOrthogonalGroup_subgroupOf_orthogonalGroup :
    ((elementaryOrthogonalGroup Q).subgroupOf (orthogonalGroup Q)).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer elementaryOrthogonalGroup_le_orthogonalGroup).mpr
    orthogonalGroup_le_normalizer_elementaryOrthogonalGroup

/-- **One Eichler transvection joins two orthogonal singular vectors.** If `u` and `v` are singular
and orthogonal, and some `w` satisfies `B u w = B v w = 1`, then the Eichler transvection
`E_{v - u, -w}` sends `u` to `v`. -/
theorem exists_mem_elementaryOrthogonalGroup_apply_eq_of_polar_eq_zero {u v w : M}
    (hu : Q u = 0) (hv : Q v = 0) (huv : polar Q u v = 0) (huw : polar Q u w = 1)
    (hvw : polar Q v w = 1) : ∃ g ∈ elementaryOrthogonalGroup Q, g u = v := by
  have hz : Q (v - u) = 0 := by
    simp [sub_eq_add_neg, QuadraticMap.map_add, polar_comm, huv, hu, hv]
  have hzw : polar Q (v - u) (-w) = 0 := by
    rw [polar_neg_right, polar_sub_left, huw, hvw, sub_self, neg_zero]
  refine ⟨transvection Q hz hzw, transvection_mem_elementaryOrthogonalGroup hz hzw, ?_⟩
  have huz : polar Q u (v - u) = 0 := by
    rw [polar_sub_right, huv, polar_self, hu, smul_zero, sub_zero]
  rw [transvection_apply, huz, polar_neg_right, huw]
  module

end CommRing

section Field

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V] {Q : QuadraticForm K V}

/-- Over a field, if the polar form is nondegenerate, one Eichler transvection joins any two
linearly independent orthogonal singular vectors. -/
theorem exists_mem_elementaryOrthogonalGroup_apply_eq_of_linearIndependent
    (hQ : (polarBilin Q).Nondegenerate) {u v : V} (hu : Q u = 0)
    (hv : Q v = 0) (huv : polar Q u v = 0) (hli : LinearIndependent K ![u, v]) :
    ∃ g ∈ elementaryOrthogonalGroup Q, g u = v := by
  obtain ⟨w, huw, hvw⟩ := hQ.1.exists_apply_eq_and_apply_eq_of_linearIndependent hli 1 1
  exact exists_mem_elementaryOrthogonalGroup_apply_eq_of_polar_eq_zero hu hv huv huw hvw

/-- Under the hypotheses of `exists_mem_elementaryOrthogonalGroup_apply_eq_of_linearIndependent`,
every nonzero singular vector `u` is the image of `e` under the elementary orthogonal group, for a
fixed vector `e` of a plane `⟨e, e'⟩` on which `Q` vanishes. -/
private theorem exists_mem_elementaryOrthogonalGroup_apply_eq_of_mem
    (hQ : (polarBilin Q).Nondegenerate) {W : Submodule K V}
    (hW : Q.IsTotallyIsotropic W) {e e' : V} (he : e ∈ W) (he' : e' ∈ W)
    (hee' : LinearIndependent K ![e, e']) {u : V} (hu : Q u = 0) (hu₀ : u ≠ 0) :
    ∃ g ∈ elementaryOrthogonalGroup Q, g e = u := by
  have hQe := hW.apply_eq_zero he
  -- Composing two steps `e ↦ x ↦ u` of the elementary orthogonal group.
  have step {x : V} (h₁ : ∃ g ∈ elementaryOrthogonalGroup Q, g e = x)
      (h₂ : ∃ g ∈ elementaryOrthogonalGroup Q, g x = u) :
      ∃ g ∈ elementaryOrthogonalGroup Q, g e = u := by
    obtain ⟨g₁, hg₁, rfl⟩ := h₁
    obtain ⟨g₂, hg₂, rfl⟩ := h₂
    exact ⟨g₂ * g₁, mul_mem hg₂ hg₁, rfl⟩
  have he₀ : e ≠ 0 := hee'.ne_zero 0
  by_cases heu : polar Q e u = 0
  · by_cases hli : LinearIndependent K ![e, u]
    · exact exists_mem_elementaryOrthogonalGroup_apply_eq_of_linearIndependent hQ hQe hu heu hli
    -- Here `u = c • e` with `c ≠ 0`; pass through `e'`.
    obtain ⟨c, rfl⟩ : ∃ c : K, c • e = u := by
      simpa [LinearIndependent.pair_iff' he₀] using hli
    have hc : c ≠ 0 := by rintro rfl; simp at hu₀
    refine step (exists_mem_elementaryOrthogonalGroup_apply_eq_of_linearIndependent hQ hQe
      (hW.apply_eq_zero he') (hW.polar_eq_zero he he') hee') ?_
    refine exists_mem_elementaryOrthogonalGroup_apply_eq_of_linearIndependent hQ
      (hW.apply_eq_zero he') hu (by rw [polar_smul_right, hW.polar_eq_zero he' he, smul_zero]) ?_
    rw [← LinearIndependent.pair_symm_iff]
    simpa using (LinearIndependent.pair_smul_smul_iff (x := e) (y := e')
      (isUnit_iff_ne_zero.mpr hc) isUnit_one).mpr hee'
  -- Here `B e u ≠ 0`; the vector `x = e' - (B e' u / B e u) • e` of the plane is orthogonal to
  -- both `e` and `u`, and serves as a stepping stone.
  set x := -(polar Q e' u / polar Q e u) • e + e' with hx
  have hxW : x ∈ W := W.add_mem (W.smul_mem _ he) he'
  have hex : LinearIndependent K ![e, x] := by
    rw [hx, LinearIndependent.pair_add_smul_right_iff]
    exact hee'
  have hxu : polar Q x u = 0 := by
    rw [hx, polar_add_left, polar_smul_left, smul_eq_mul, neg_mul, div_mul_cancel₀ _ heu,
      neg_add_cancel]
  refine step (exists_mem_elementaryOrthogonalGroup_apply_eq_of_linearIndependent hQ hQe
    (hW.apply_eq_zero hxW) (hW.polar_eq_zero he hxW) hex) ?_
  refine exists_mem_elementaryOrthogonalGroup_apply_eq_of_linearIndependent hQ
    (hW.apply_eq_zero hxW) hu hxu ((LinearIndependent.pair_iff' (x := x) (hex.ne_zero 1)).mpr ?_)
  -- A multiple of `x` is orthogonal to `e`, whereas `u` is not.
  intro a hau
  exact heu (by rw [← hau, polar_smul_right, hW.polar_eq_zero he hxW, smul_zero])

/-- **Transitivity of the elementary orthogonal group on singular vectors.** Over a field, let the
polar form of `Q` be nondegenerate, and let `Q` vanish on a subspace of dimension at least two
(that is, `Q` has Witt index at least two). Then the elementary orthogonal group acts transitively
on the nonzero singular vectors: any nonzero `u` and `v` with `Q u = Q v = 0` satisfy `g u = v`
for some `g ∈ EO(Q)`. -/
theorem exists_mem_elementaryOrthogonalGroup_apply_eq
    (hQ : (polarBilin Q).Nondegenerate) {W : Submodule K V} (hW : Q.IsTotallyIsotropic W)
    (hW₂ : 2 ≤ finrank K W) {u v : V} (hu : Q u = 0) (hv : Q v = 0) (hu₀ : u ≠ 0)
    (hv₀ : v ≠ 0) : ∃ g ∈ elementaryOrthogonalGroup Q, g u = v := by
  -- Choose two linearly independent vectors `e`, `e'` of `W`.
  have : FiniteDimensional K W := Module.finite_of_finrank_pos (by omega)
  obtain ⟨e, he₀⟩ : ∃ e : W, e ≠ 0 :=
    (Module.finrank_pos_iff_exists_ne_zero (R := K)).mp (by omega)
  obtain ⟨e', hee'⟩ := exists_linearIndependent_pair_of_one_lt_finrank (R := K) (by omega) he₀
  have hli : LinearIndependent K ![(e : V), (e' : V)] :=
    LinearIndependent.pair_iff.mpr fun s t h =>
      LinearIndependent.pair_iff.mp hee' s t (Subtype.ext (by simpa using h))
  obtain ⟨g, hg, rfl⟩ :=
    exists_mem_elementaryOrthogonalGroup_apply_eq_of_mem hQ hW e.property e'.property hli hu hu₀
  obtain ⟨h, hh, rfl⟩ :=
    exists_mem_elementaryOrthogonalGroup_apply_eq_of_mem hQ hW e.property e'.property hli hv hv₀
  exact ⟨h * g⁻¹, mul_mem hh (inv_mem hg), by simp⟩

end Field

end QuadraticMap
