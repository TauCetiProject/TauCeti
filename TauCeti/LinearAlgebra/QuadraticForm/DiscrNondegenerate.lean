module

public import TauCeti.LinearAlgebra.QuadraticForm.HalfDiscriminant
public import TauCeti.LinearAlgebra.QuadraticForm.Matrix

/-!
# Values of a nondegenerate quadratic form

Let `q` be a quadratic form on a free module of finite rank over a commutative ring `R`, with
basis `b` indexed by a linearly ordered type, and let `M` be its upper triangular coefficient
matrix (`QuadraticForm.coefficientMatrix`). The normalized discriminant of `q`
(`QuadraticForm.normalizedDiscr`) is a polynomial in the entries of `M`: it is
`det (M + Mᵀ)` in even rank and `Matrix.halfDet M` in odd rank
(`QuadraticForm.normalizedDiscr_eq_coefficientMatrix`). In positive rank these polynomials have no
constant term, and the entries of `M` are values `q(bᵢ)` and polar values
`q(bᵢ + bⱼ) - q(bᵢ) - q(bⱼ)`, so the normalized discriminant lies in the ideal generated by the
values of `q`. Hence **the values of a nondegenerate form of positive rank generate the unit
ideal** (`QuadraticForm.span_range_eq_top_of_isDiscrNondegenerate`), and an element `d` with
`d q(x) = 0` for every `x` is zero (`QuadraticForm.eq_zero_of_forall_mul_eq_zero`).

The same description gives the compatibility of nondegeneracy with the form `q_A` on `Aⁿ` with the
coefficients of `q` (`QuadraticForm.IsDiscrNondegenerate.baseChangeForm`), which needs no
invertibility of `2`.

## Main results

* `QuadraticForm.normalizedDiscr_eq_coefficientMatrix`: the normalized discriminant in terms of the
  coefficient matrix.
* `QuadraticForm.map_normalizedDiscr`: its image under a ring homomorphism.
* `QuadraticForm.span_range_eq_top_of_isDiscrNondegenerate`: the values of a nondegenerate form of
  positive rank generate the unit ideal.
* `QuadraticForm.eq_zero_of_forall_mul_eq_zero`: such a form has trivial annihilator.
* `QuadraticForm.IsDiscrNondegenerate.baseChangeForm`: `q_A` is nondegenerate if `q` is.
-/

public section

open Matrix

namespace QuadraticForm

open LinearMap (BilinForm)

variable {R V ι : Type*} [CommRing R] [AddCommGroup V] [Module R V] [Fintype ι] [LinearOrder ι]

/-- The normalized discriminant of `q` in the basis `b` is `det (M + Mᵀ)` in even rank and
`Matrix.halfDet M` in odd rank, for `M` the coefficient matrix of `q` in `b`. -/
theorem normalizedDiscr_eq_coefficientMatrix (q : QuadraticForm R V) (b : Module.Basis ι R V) :
    normalizedDiscr q b =
      if Even (Fintype.card ι) then (coefficientMatrix q b + (coefficientMatrix q b)ᵀ).det
      else (coefficientMatrix q b).halfDet := by
  split_ifs with hι
  · rw [normalizedDiscr_of_even hι, polarDiscr_def,
      toMatrix_polarBilin_eq_coefficientMatrix_add_transpose]
  · rw [normalizedDiscr_of_odd (Nat.not_even_iff_odd.mp hι),
      halfDiscr_eq_halfDet b (QuadraticMap.toQuadraticMap_toBilin q b)]
    congr 1
    ext i j
    rw [LinearMap.BilinForm.toMatrix_apply, coefficientMatrix_apply, QuadraticMap.toBilin_apply]

/-- The entries of the coefficient matrix lie in the ideal generated by the values of `q`. -/
theorem coefficientMatrix_mem_span_range (q : QuadraticForm R V) (b : Module.Basis ι R V)
    (i j : ι) : coefficientMatrix q b i j ∈ Ideal.span (Set.range q) := by
  have hq (x : V) : q x ∈ Ideal.span (Set.range q) := Ideal.subset_span ⟨x, rfl⟩
  rw [coefficientMatrix_apply]
  split_ifs
  · exact hq _
  · exact Ideal.sub_mem _ (Ideal.sub_mem _ (hq _) (hq _)) (hq _)
  · exact zero_mem _

/-- The image of the normalized discriminant under a ring homomorphism `f` is the same polynomial
in the entries of the coefficient matrix mapped by `f`. -/
theorem map_normalizedDiscr {S : Type*} [CommRing S] (f : R →+* S) (q : QuadraticForm R V)
    (b : Module.Basis ι R V) :
    f (normalizedDiscr q b) =
      if Even (Fintype.card ι) then
        ((coefficientMatrix q b).map f + ((coefficientMatrix q b).map f)ᵀ).det
      else ((coefficientMatrix q b).map f).halfDet := by
  rw [normalizedDiscr_eq_coefficientMatrix]
  split_ifs
  · rw [RingHom.map_det, RingHom.mapMatrix_apply, Matrix.map_add _ (map_add _),
      Matrix.transpose_map]
  · exact map_halfDet f _

/-- In positive rank, the normalized discriminant lies in the ideal generated by the values of
`q`. -/
theorem normalizedDiscr_mem_span_range [Nonempty ι] (q : QuadraticForm R V)
    (b : Module.Basis ι R V) : normalizedDiscr q b ∈ Ideal.span (Set.range q) := by
  set J := Ideal.span (Set.range q)
  have hM : (coefficientMatrix q b).map (Ideal.Quotient.mk J) = 0 := by
    ext i j
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (coefficientMatrix_mem_span_range q b i j)
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_normalizedDiscr, hM]
  simp

/-- **The values of a nondegenerate quadratic form of positive rank generate the unit ideal.** -/
theorem span_range_eq_top_of_isDiscrNondegenerate {ι : Type*} [Finite ι] [Nonempty ι]
    {q : QuadraticForm R V} (b : Module.Basis ι R V) (hq : IsDiscrNondegenerate q) :
    Ideal.span (Set.range q) = ⊤ := by
  have := Fintype.ofFinite ι
  let _ : LinearOrder ι := LinearOrder.lift' _ (Fintype.equivFin ι).injective
  exact Ideal.eq_top_of_isUnit_mem _ (normalizedDiscr_mem_span_range q b)
    ((isDiscrNondegenerate_iff b).mp hq)

/-- **A nondegenerate quadratic form of positive rank has trivial annihilator**: if `d q(x) = 0`
for every `x`, then `d = 0`. -/
theorem eq_zero_of_forall_mul_eq_zero {ι : Type*} [Finite ι] [Nonempty ι] {q : QuadraticForm R V}
    (b : Module.Basis ι R V) (hq : IsDiscrNondegenerate q) {d : R} (hd : ∀ x, d * q x = 0) :
    d = 0 := by
  have h : Ideal.span (Set.range q) ≤ LinearMap.ker (LinearMap.mulLeft R d) :=
    Ideal.span_le.mpr fun _ ⟨x, hx⟩ ↦ hx ▸ hd x
  rw [span_range_eq_top_of_isDiscrNondegenerate b hq] at h
  simpa using h (Submodule.mem_top (x := (1 : R)))

/-- **Nondegeneracy passes to the form with the same coefficients over any `R`-algebra**, with no
assumption on `2`. -/
theorem IsDiscrNondegenerate.baseChangeForm {q : QuadraticForm R (ι → R)}
    (hq : IsDiscrNondegenerate q) (A : Type*) [CommRing A] [Algebra R A] :
    IsDiscrNondegenerate (baseChangeForm q A) := by
  have h := ((isDiscrNondegenerate_iff (Pi.basisFun R ι)).mp hq).map (algebraMap R A)
  rwa [map_normalizedDiscr, ← coefficientMatrix_baseChangeForm,
    ← normalizedDiscr_eq_coefficientMatrix, ← isDiscrNondegenerate_iff] at h

end QuadraticForm
