/-!
# The reflection subgroup of an orthogonal group and its behavior on orthogonal sums

For a quadratic form `Q : QuadraticForm R M` over a commutative ring `R`, the reflections
`TauCeti.QuadraticMap.reflectionOrthogonal Q v` in vectors of invertible norm generate a normal
subgroup `QuadraticMap.reflectionSubgroup Q` of `TauCeti.QuadraticMap.orthogonalGroup Q`. Because
each reflection is an involution, the underlying submonoid of `Q.reflectionSubgroup` coincides with
the submonoid generated by reflections, so membership in `Q.reflectionSubgroup` is equivalent to
being a finite list product of reflections. Over a field of characteristic not two, the
Cartan--Dieudonné theorem (`TauCeti.QuadraticMap.subgroup_eq_top_of_reflection_mem`) says that
`Q.reflectionSubgroup = ⊤` for every finite-dimensional nondegenerate space.

Over general rings (and in characteristic two over `𝔽₂`), `Q.reflectionSubgroup` can be a proper
normal subgroup. This file isolates the general orthogonal-sum mechanism behind Dieudonné's
four-dimensional `𝔽₂` exception:

1. For any two forms `Q₁` and `Q₂`, `QuadraticMap.orthogonalGroupProd Q₁ Q₂` carries
   `Q₁.reflectionSubgroup.prod Q₂.reflectionSubgroup` into `(Q₁.prod Q₂).reflectionSubgroup`.
2. Whenever every vector `(x₁, x₂)` of unit norm for `Q₁.prod Q₂` lies in one of the two summands
   (`IsUnit (Q₁ x₁ + Q₂ x₂) → x₁ = 0 ∨ x₂ = 0`), every reflection of `Q₁.prod Q₂` comes from a
   reflection of `Q₁` or `Q₂`, so `(Q₁.prod Q₂).reflectionSubgroup` equals the image of
   `Q₁.reflectionSubgroup.prod Q₂.reflectionSubgroup` under `orthogonalGroupProd Q₁ Q₂`.
3. On a homogeneous orthogonal sum `Q.prod Q` over a nontrivial module `M`, the factor-swapping
   isometry `QuadraticMap.prodCommOrthogonal Q` does not preserve the summands, so it lies outside
   `(orthogonalGroupProd Q Q).range` and therefore outside `(Q.prod Q).reflectionSubgroup`. When
   moreover `Q x₁ + Q x₂ = Q x` for `x ≠ 0` forces `x₁ = 0 ∨ x₂ = 0`, the diagonal block subgroup
   `(orthogonalGroupProd Q Q).range` has index two in `orthogonalGroup (Q.prod Q)` with coset
   representative `Q.prodCommOrthogonal`; if `Q.reflectionSubgroup = ⊤`, then
   `(Q.prod Q).reflectionSubgroup` itself has index two in `orthogonalGroup (Q.prod Q)`.

## Main definitions

* `QuadraticMap.reflectionSubgroup Q`: the normal subgroup of `orthogonalGroup Q` generated by
  reflections in vectors of invertible norm.
* `QuadraticMap.IsometryEquiv.reflectionSubgroupCongr`: isometric quadratic forms have isomorphic
  reflection subgroups.
* `QuadraticMap.prodCommOrthogonal Q`: the involutive orthogonal automorphism of `Q.prod Q`
  swapping the two factors.

## Main results

* `QuadraticMap.reflectionSubgroup_normal`: `Q.reflectionSubgroup` is normal in
  `orthogonalGroup Q`.
* `QuadraticMap.toSubmonoid_reflectionSubgroup` and
  `QuadraticMap.mem_reflectionSubgroup_iff_exists_list_prod`: `Q.reflectionSubgroup` is generated as
  a monoid by reflections.
* `QuadraticMap.reflectionSubgroup_eq_top`: over a field of characteristic not two,
  `Q.reflectionSubgroup = ⊤` for finite-dimensional nondegenerate `Q`.
* `QuadraticMap.reflectionSubgroup_prod_eq_map`: when unit values of `Q₁.prod Q₂` force one
  coordinate to vanish, `(Q₁.prod Q₂).reflectionSubgroup` is the image of
  `Q₁.reflectionSubgroup.prod Q₂.reflectionSubgroup` under `orthogonalGroupProd Q₁ Q₂`.
* `QuadraticMap.index_range_orthogonalGroupProd_eq_two` and
  `QuadraticMap.index_reflectionSubgroup_prod_self_eq_two`: index-two wreath decomposition of
  `orthogonalGroup (Q.prod Q)` and of `(Q.prod Q).reflectionSubgroup`.

## References

* J. Dieudonné, *La géométrie des groupes classiques* (1955), Chapter II, §10.
* M. Kneser, *Quadratische Formen* (2002), §4.
* T. Y. Lam, *Introduction to Quadratic Forms over Fields* (2005), Chapter I, §7.
* R. Elman, N. Karpenko, and A. Merkurjev, *The Algebraic and Geometric Theory of Quadratic Forms*
  (2008), §11.
-/

public section

namespace QuadraticMap

open TauCeti.QuadraticMap

universe u v w

section ReflectionSubgroup

variable {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]

/-- The subgroup of `orthogonalGroup Q` generated by reflections in vectors of invertible norm. -/
def reflectionSubgroup (Q : QuadraticForm R M) : Subgroup (orthogonalGroup Q) :=
  Subgroup.closure {g : orthogonalGroup Q |
    ∃ (v : M) (_ : Invertible (Q v)), reflectionOrthogonal Q v = g}

/-- Unfolds `QuadraticMap.reflectionSubgroup` as `Subgroup.closure` of the set of reflections. -/
theorem reflectionSubgroup_def (Q : QuadraticForm R M) :
    Q.reflectionSubgroup = Subgroup.closure {g : orthogonalGroup Q |
      ∃ (v : M) (_ : Invertible (Q v)), reflectionOrthogonal Q v = g} := by
  rfl

/-- Every reflection in a vector of invertible norm belongs to `Q.reflectionSubgroup`. -/
@[simp]
theorem reflectionOrthogonal_mem_reflectionSubgroup (Q : QuadraticForm R M) (v : M)
    [Invertible (Q v)] :
    reflectionOrthogonal Q v ∈ Q.reflectionSubgroup :=
  Subgroup.subset_closure ⟨v, inferInstance, rfl⟩

/-- `Q.reflectionSubgroup` is contained in a subgroup `H` if and only if `H` contains every
reflection in a vector of invertible norm. -/
theorem reflectionSubgroup_le_iff (Q : QuadraticForm R M) {H : Subgroup (orthogonalGroup Q)} :
    Q.reflectionSubgroup ≤ H ↔
      ∀ (v : M) [Invertible (Q v)], reflectionOrthogonal Q v ∈ H := by
  rw [reflectionSubgroup_def, Subgroup.closure_le]
  constructor
  · intro h v hv
    exact h ⟨v, hv, rfl⟩
  · rintro h _ ⟨v, hv, rfl⟩
    exact h v

/-- Since every orthogonal reflection has order dividing two, the underlying submonoid of
`Q.reflectionSubgroup` coincides with the submonoid generated by reflections. -/
theorem toSubmonoid_reflectionSubgroup (Q : QuadraticForm R M) :
    Q.reflectionSubgroup.toSubmonoid =
      Submonoid.closure {g : orthogonalGroup Q |
        ∃ (v : M) (_ : Invertible (Q v)), reflectionOrthogonal Q v = g} := by
  rw [reflectionSubgroup_def, Subgroup.closure_toSubmonoid_of_isOfFinOrder]
  rintro _ ⟨v, hv, rfl⟩
  exact isOfFinOrder_iff_pow_eq_one.mpr
    ⟨2, by decide, by rw [pow_two, reflectionOrthogonal_mul_self]⟩

/-- An orthogonal transformation belongs to `Q.reflectionSubgroup` if and only if it is a product
of a list of reflections in vectors of invertible norm. -/
theorem mem_reflectionSubgroup_iff_exists_list_prod (Q : QuadraticForm R M)
    {g : orthogonalGroup Q} :
    g ∈ Q.reflectionSubgroup ↔
      ∃ l : List (orthogonalGroup Q),
        (∀ r ∈ l, ∃ (v : M) (_ : Invertible (Q v)), reflectionOrthogonal Q v = r) ∧
        l.prod = g := by
  rw [← Subgroup.mem_toSubmonoid, toSubmonoid_reflectionSubgroup]
  refine ⟨Submonoid.exists_list_of_mem_closure, ?_⟩
  rintro ⟨l, hl, rfl⟩
  exact Submonoid.list_prod_mem _ fun r hr ↦ Submonoid.subset_closure (hl r hr)

/-- **Normality of the reflection subgroup.** Conjugating a reflection `τ_v` by any `k ∈ O(Q)`
produces `τ_{k v}`, so `Q.reflectionSubgroup` is normal in `orthogonalGroup Q`. -/
instance reflectionSubgroup_normal (Q : QuadraticForm R M) : Q.reflectionSubgroup.Normal where
  conj_mem g hg k := by
    induction hg using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨v, hv, rfl⟩ := hx
      let _ : Invertible (Q ((k : M ≃ₗ[R] M) v)) :=
        hv.copy _ (map_app_of_mem_orthogonalGroup k.2 v)
      rw [mul_reflectionOrthogonal_mul_inv Q k v]
      exact reflectionOrthogonal_mem_reflectionSubgroup Q ((k : M ≃ₗ[R] M) v)
    | one => simp
    | mul x y _ _ ihx ihy =>
      have heq : k * (x * y) * k⁻¹ = (k * x * k⁻¹) * (k * y * k⁻¹) := by group
      rw [heq]
      exact mul_mem ihx ihy
    | inv x _ ih =>
      have heq : k * x⁻¹ * k⁻¹ = (k * x * k⁻¹)⁻¹ := by group
      rw [heq]
      exact inv_mem ih

end ReflectionSubgroup

section CartanDieudonne

variable {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] [NeZero (2 : K)]

/-- Over a field of characteristic not two, reflections generate the full orthogonal group of any
finite-dimensional nondegenerate quadratic form. -/
theorem reflectionSubgroup_eq_top (Q : QuadraticForm K V) (hQ : Q.Nondegenerate) :
    Q.reflectionSubgroup = ⊤ :=
  subgroup_eq_top_of_reflection_mem Q hQ Q.reflectionSubgroup fun v _ ↦
    reflectionOrthogonal_mem_reflectionSubgroup Q v

/-- Over a field of characteristic not two, `Q.reflectionSubgroup` has index one in
`orthogonalGroup Q` for any finite-dimensional nondegenerate quadratic form `Q`. -/
theorem index_reflectionSubgroup_eq_one (Q : QuadraticForm K V) (hQ : Q.Nondegenerate) :
    Q.reflectionSubgroup.index = 1 := by
  rw [reflectionSubgroup_eq_top Q hQ, Subgroup.index_top]

end CartanDieudonne

end QuadraticMap

namespace QuadraticMap.IsometryEquiv

open TauCeti.QuadraticMap

variable {R : Type*} {M₁ M₂ : Type*} [CommRing R]
  [AddCommGroup M₁] [Module R M₁] [AddCommGroup M₂] [Module R M₂]
  {Q₁ : QuadraticForm R M₁} {Q₂ : QuadraticForm R M₂}

/-- Transport along an isometric equivalence `e` carries `Q₁.reflectionSubgroup` onto
`Q₂.reflectionSubgroup`. -/
theorem map_reflectionSubgroup (e : Q₁.IsometryEquiv Q₂) :
    Q₁.reflectionSubgroup.map e.orthogonalGroupCongr.toMonoidHom = Q₂.reflectionSubgroup := by
  apply le_antisymm
  · rw [Subgroup.map_le_iff_le_comap, reflectionSubgroup_le_iff]
    intro v hv
    let _ : Invertible (Q₂ (e v)) := hv.copy _ (e.map_app v)
    rw [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, orthogonalGroupCongr_reflectionOrthogonal]
    exact reflectionOrthogonal_mem_reflectionSubgroup Q₂ (e v)
  · rw [reflectionSubgroup_le_iff]
    intro w hw
    let _ : Invertible (Q₁ (e.symm w)) := hw.copy _ (e.symm.map_app w)
    refine ⟨reflectionOrthogonal Q₁ (e.symm w),
      reflectionOrthogonal_mem_reflectionSubgroup Q₁ (e.symm w), ?_⟩
    let _ : Invertible (Q₂ (e (e.symm w))) := hw.copy _ (by rw [e.apply_symm_apply])
    rw [MulEquiv.coe_toMonoidHom, orthogonalGroupCongr_reflectionOrthogonal]
    exact Subtype.ext <| LinearEquiv.ext fun x ↦ by
      simp [reflection_apply, e.apply_symm_apply]

/-- Membership in `reflectionSubgroup` is preserved by `orthogonalGroupCongr`. -/
@[simp]
theorem mem_reflectionSubgroup_orthogonalGroupCongr_iff (e : Q₁.IsometryEquiv Q₂)
    {g : orthogonalGroup Q₁} :
    e.orthogonalGroupCongr g ∈ Q₂.reflectionSubgroup ↔ g ∈ Q₁.reflectionSubgroup := by
  rw [← e.map_reflectionSubgroup, Subgroup.mem_map_equiv]
  simp

/-- Isometric quadratic forms have isomorphic reflection subgroups. -/
noncomputable def reflectionSubgroupCongr (e : Q₁.IsometryEquiv Q₂) :
    Q₁.reflectionSubgroup ≃* Q₂.reflectionSubgroup :=
  TauCeti.Subgroup.congrOfMapEq e.orthogonalGroupCongr e.map_reflectionSubgroup

/-- Evaluating `reflectionSubgroupCongr` in `orthogonalGroup Q₂` agrees with
`orthogonalGroupCongr`. -/
@[simp]
theorem coe_reflectionSubgroupCongr_apply (e : Q₁.IsometryEquiv Q₂) (g : Q₁.reflectionSubgroup) :
    (e.reflectionSubgroupCongr g : orthogonalGroup Q₂) = e.orthogonalGroupCongr g :=
  TauCeti.Subgroup.coe_congrOfMapEq_apply e.orthogonalGroupCongr e.map_reflectionSubgroup g

/-- Evaluating `reflectionSubgroupCongr.symm` in `orthogonalGroup Q₁` agrees with
`orthogonalGroupCongr.symm`. -/
@[simp]
theorem coe_reflectionSubgroupCongr_symm_apply (e : Q₁.IsometryEquiv Q₂)
    (g : Q₂.reflectionSubgroup) :
    (e.reflectionSubgroupCongr.symm g : orthogonalGroup Q₁) = e.orthogonalGroupCongr.symm g :=
  TauCeti.Subgroup.coe_congrOfMapEq_symm_apply e.orthogonalGroupCongr e.map_reflectionSubgroup g

/-- Isometric quadratic forms have the same reflection-subgroup index in their orthogonal
groups. -/
theorem index_reflectionSubgroup_eq (e : Q₁.IsometryEquiv Q₂) :
    Q₁.reflectionSubgroup.index = Q₂.reflectionSubgroup.index := by
  rw [← e.map_reflectionSubgroup]
  exact (Q₁.reflectionSubgroup.index_map_equiv e.orthogonalGroupCongr).symm

end QuadraticMap.IsometryEquiv

namespace QuadraticMap.Equivalent

variable {R : Type*} {M₁ M₂ : Type*} [CommRing R]
  [AddCommGroup M₁] [Module R M₁] [AddCommGroup M₂] [Module R M₂]
  {Q₁ : QuadraticForm R M₁} {Q₂ : QuadraticForm R M₂}

/-- Equivalent quadratic forms have the same reflection-subgroup index in their orthogonal
groups. -/
theorem index_reflectionSubgroup_eq (h : Q₁.Equivalent Q₂) :
    Q₁.reflectionSubgroup.index = Q₂.reflectionSubgroup.index :=
  let ⟨e⟩ := h
  e.index_reflectionSubgroup_eq

end QuadraticMap.Equivalent

namespace QuadraticMap

open TauCeti.QuadraticMap

section ProdSwap

variable {R M N : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M]
  [AddCommMonoid N] [Module R N]

/-- The involutive orthogonal automorphism of `Q.prod Q` that swaps the two summands. -/
def prodCommOrthogonal (Q : QuadraticMap R M N) : orthogonalGroup (Q.prod Q) :=
  (orthogonalGroupEquivIsometryEquiv (Q.prod Q)).symm (IsometryEquiv.prodComm Q Q)

/-- `Q.prodCommOrthogonal` exchanges the two coordinates of `M × M`. -/
@[simp]
theorem prodCommOrthogonal_apply (Q : QuadraticMap R M N) (x : M × M) :
    (Q.prodCommOrthogonal : (M × M) ≃ₗ[R] M × M) x = (x.2, x.1) := by
  simp [prodCommOrthogonal]
  rfl

/-- `Q.prodCommOrthogonal` has order dividing two in `orthogonalGroup (Q.prod Q)`. -/
@[simp]
theorem prodCommOrthogonal_mul_self (Q : QuadraticMap R M N) :
    Q.prodCommOrthogonal * Q.prodCommOrthogonal = 1 := by
  apply Subtype.ext
  ext x <;> simp

/-- `Q.prodCommOrthogonal` is its own inverse in `orthogonalGroup (Q.prod Q)`. -/
@[simp]
theorem prodCommOrthogonal_inv (Q : QuadraticMap R M N) :
    Q.prodCommOrthogonal⁻¹ = Q.prodCommOrthogonal :=
  inv_eq_of_mul_eq_one_left (prodCommOrthogonal_mul_self Q)

/-- The factor-swapping isometry `Q.prodCommOrthogonal` preserves both summands if and only if
`M` is a subsingleton. -/
theorem prodCommOrthogonal_mem_range_orthogonalGroupProd_iff (Q : QuadraticMap R M N) :
    Q.prodCommOrthogonal ∈ (orthogonalGroupProd Q Q).range ↔ Subsingleton M := by
  rw [mem_range_orthogonalGroupProd_iff]
  simp only [prodCommOrthogonal_apply, and_self]
  exact ⟨fun h ↦ subsingleton_of_forall_eq 0 h, fun _ m ↦ Subsingleton.elim m 0⟩

/-- On a nontrivial module `M`, `Q.prodCommOrthogonal` does not lie in the block-diagonal image
of `orthogonalGroupProd Q Q`. -/
theorem prodCommOrthogonal_notMem_range_orthogonalGroupProd [Nontrivial M]
    (Q : QuadraticMap R M N) :
    Q.prodCommOrthogonal ∉ (orthogonalGroupProd Q Q).range := by
  rw [prodCommOrthogonal_mem_range_orthogonalGroupProd_iff]
  exact not_subsingleton M

/-- Under the value-splitting hypothesis on `Q`, any `h ∈ orthogonalGroup (Q.prod Q)` maps the
second summand `(0, y)` wholly into the second summand or wholly into the first summand. -/
private theorem forall_fst_inr_eq_zero_or_forall_snd_inr_eq_zero {Q : QuadraticMap R M N}
    (hsplit : ∀ x x₁ x₂ : M, x ≠ 0 → Q x₁ + Q x₂ = Q x → x₁ = 0 ∨ x₂ = 0)
    (h : orthogonalGroup (Q.prod Q)) :
    (∀ y : M, ((h : (M × M) ≃ₗ[R] M × M) (0, y)).1 = 0) ∨
      (∀ y : M, ((h : (M × M) ≃ₗ[R] M × M) (0, y)).2 = 0) := by
  have hpt (y : M) : ((h : (M × M) ≃ₗ[R] M × M) (0, y)).1 = 0 ∨
      ((h : (M × M) ≃ₗ[R] M × M) (0, y)).2 = 0 := by
    by_cases hy : y = 0
    · refine .inl ?_
      rw [hy, Prod.mk_zero_zero, map_zero]
      rfl
    · have hmap := map_app_of_mem_orthogonalGroup h.2 (0, y)
      simp only [QuadraticMap.prod_apply, map_zero, zero_add] at hmap
      exact hsplit y _ _ hy hmap
  by_contra! hne
  obtain ⟨⟨y₁, hy₁⟩, ⟨y₂, hy₂⟩⟩ := hne
  have hsnd₁ : ((h : (M × M) ≃ₗ[R] M × M) (0, y₁)).2 = 0 := (hpt y₁).resolve_left hy₁
  have hfst₂ : ((h : (M × M) ≃ₗ[R] M × M) (0, y₂)).1 = 0 := (hpt y₂).resolve_right hy₂
  have hsum : (h : (M × M) ≃ₗ[R] M × M) (0, y₁ + y₂) =
      (h : (M × M) ≃ₗ[R] M × M) (0, y₁) + (h : (M × M) ≃ₗ[R] M × M) (0, y₂) := by
    rw [← map_add, Prod.mk_add_mk, add_zero]
  rcases hpt (y₁ + y₂) with h12 | h12
  · rw [hsum, Prod.fst_add, hfst₂, add_zero] at h12
    exact hy₁ h12
  · rw [hsum, Prod.snd_add, hsnd₁, zero_add] at h12
    exact hy₂ h12

/-- If `Q x₁ + Q x₂ = Q x` for `x ≠ 0` forces `x₁ = 0 ∨ x₂ = 0`, then every orthogonal
automorphism of `Q.prod Q` on a nontrivial module either preserves both summands or swaps them
followed by an element preserving both summands. -/
theorem mem_range_orthogonalGroupProd_or_prodCommOrthogonal_mul_mem [Nontrivial M]
    (Q : QuadraticMap R M N)
    (hsplit : ∀ x x₁ x₂ : M, x ≠ 0 → Q x₁ + Q x₂ = Q x → x₁ = 0 ∨ x₂ = 0)
    (g : orthogonalGroup (Q.prod Q)) :
    Q.prodCommOrthogonal * g ∈ (orthogonalGroupProd Q Q).range ∨
      g ∈ (orthogonalGroupProd Q Q).range := by
  let e : (M × M) ≃ₗ[R] M × M := g
  have hAB : (∀ x : M, (e (x, 0)).1 = 0) ∨ (∀ x : M, (e (x, 0)).2 = 0) := by
    simpa [e, mul_apply_eq_comp] using
      forall_fst_inr_eq_zero_or_forall_snd_inr_eq_zero hsplit (g * Q.prodCommOrthogonal)
  have hCD : (∀ y : M, (e (0, y)).1 = 0) ∨ (∀ y : M, (e (0, y)).2 = 0) :=
    forall_fst_inr_eq_zero_or_forall_snd_inr_eq_zero hsplit g
  obtain ⟨m, hm⟩ := exists_ne (0 : M)
  rcases hAB with hA | hB
  · have hD : ∀ y : M, (e (0, y)).2 = 0 := hCD.resolve_left fun hC ↦ hm <| by
      let p := e.symm (m, 0)
      have hp : e (p.1, 0) + e (0, p.2) = (m, 0) := by
        rw [← map_add, Prod.mk_add_mk, add_zero, zero_add, Prod.mk.eta]
        exact e.apply_symm_apply (m, 0)
      have hfst : (e (p.1, 0)).1 + (e (0, p.2)).1 = m := congrArg Prod.fst hp
      rw [hA p.1, hC p.2, add_zero] at hfst
      exact hfst.symm
    refine .inl ((mem_range_orthogonalGroupProd_iff Q Q).mpr ⟨fun x ↦ ?_, fun y ↦ ?_⟩)
    · simpa [e] using hA x
    · simpa [e] using hD y
  · have hC : ∀ y : M, (e (0, y)).1 = 0 := hCD.resolve_right fun hD ↦ hm <| by
      let p := e.symm (0, m)
      have hp : e (p.1, 0) + e (0, p.2) = (0, m) := by
        rw [← map_add, Prod.mk_add_mk, add_zero, zero_add, Prod.mk.eta]
        exact e.apply_symm_apply (0, m)
      have hsnd : (e (p.1, 0)).2 + (e (0, p.2)).2 = m := congrArg Prod.snd hp
      rw [hB p.1, hD p.2, add_zero] at hsnd
      exact hsnd.symm
    exact .inr ((mem_range_orthogonalGroupProd_iff Q Q).mpr ⟨hB, hC⟩)

/-- **Index-two wreath decomposition of `O(Q ⊕ Q)`.** If `Q x₁ + Q x₂ = Q x` for `x ≠ 0` forces
`x₁ = 0 ∨ x₂ = 0` on a nontrivial module `M`, then the diagonal block subgroup
`(orthogonalGroupProd Q Q).range` has index two in `orthogonalGroup (Q.prod Q)`. -/
theorem index_range_orthogonalGroupProd_eq_two [Nontrivial M] (Q : QuadraticMap R M N)
    (hsplit : ∀ x x₁ x₂ : M, x ≠ 0 → Q x₁ + Q x₂ = Q x → x₁ = 0 ∨ x₂ = 0) :
    (orthogonalGroupProd Q Q).range.index = 2 :=
  Subgroup.index_eq_two_iff_exists_notMem_and'.mpr
    ⟨Q.prodCommOrthogonal, Q.prodCommOrthogonal_notMem_range_orthogonalGroupProd,
      Q.mem_range_orthogonalGroupProd_or_prodCommOrthogonal_mul_mem hsplit⟩

end ProdSwap

section ReflectionSubgroupProd

variable {R M₁ M₂ M : Type*} [CommRing R]
  [AddCommGroup M₁] [Module R M₁] [AddCommGroup M₂] [Module R M₂]
  [AddCommGroup M] [Module R M]

/-- The componentwise product of reflection subgroups maps into the reflection subgroup of the
orthogonal sum. -/
theorem map_reflectionSubgroup_prod_le (Q₁ : QuadraticForm R M₁) (Q₂ : QuadraticForm R M₂) :
    (Q₁.reflectionSubgroup.prod Q₂.reflectionSubgroup).map (orthogonalGroupProd Q₁ Q₂) ≤
      (Q₁.prod Q₂).reflectionSubgroup := by
  have hinl : Q₁.reflectionSubgroup ≤
      (Q₁.prod Q₂).reflectionSubgroup.comap
        ((orthogonalGroupProd Q₁ Q₂).comp (MonoidHom.inl _ _)) :=
    (Q₁.reflectionSubgroup_le_iff).mpr fun v hv ↦ by
      let _ : Invertible ((Q₁.prod Q₂) (v, 0)) := hv.copy _ (by simp)
      rw [Subgroup.mem_comap, MonoidHom.comp_apply, MonoidHom.inl_apply,
        orthogonalGroupProd_reflectionOrthogonal_one]
      exact reflectionOrthogonal_mem_reflectionSubgroup (Q₁.prod Q₂) (v, 0)
  have hinr : Q₂.reflectionSubgroup ≤
      (Q₁.prod Q₂).reflectionSubgroup.comap
        ((orthogonalGroupProd Q₁ Q₂).comp (MonoidHom.inr _ _)) :=
    (Q₂.reflectionSubgroup_le_iff).mpr fun w hw ↦ by
      let _ : Invertible ((Q₁.prod Q₂) (0, w)) := hw.copy _ (by simp)
      rw [Subgroup.mem_comap, MonoidHom.comp_apply, MonoidHom.inr_apply,
        orthogonalGroupProd_one_reflectionOrthogonal]
      exact reflectionOrthogonal_mem_reflectionSubgroup (Q₁.prod Q₂) (0, w)
  rw [Subgroup.map_le_iff_le_comap]
  rintro ⟨g₁, g₂⟩ ⟨hg₁, hg₂⟩
  have hmul : (g₁, g₂) = (g₁, 1) * (1, g₂) := by simp
  rw [Subgroup.mem_comap, hmul, map_mul]
  exact mul_mem (hinl hg₁) (hinr hg₂)

/-- **Splitting of the reflection subgroup across an orthogonal sum.** Whenever every vector of
unit norm for `Q₁.prod Q₂` has one of its two components equal to zero, the reflection subgroup
of `Q₁.prod Q₂` is the image of `Q₁.reflectionSubgroup.prod Q₂.reflectionSubgroup` under
`orthogonalGroupProd Q₁ Q₂`. -/
theorem reflectionSubgroup_prod_eq_map (Q₁ : QuadraticForm R M₁) (Q₂ : QuadraticForm R M₂)
    (h : ∀ x₁ x₂, IsUnit (Q₁ x₁ + Q₂ x₂) → x₁ = 0 ∨ x₂ = 0) :
    (Q₁.prod Q₂).reflectionSubgroup =
      (Q₁.reflectionSubgroup.prod Q₂.reflectionSubgroup).map (orthogonalGroupProd Q₁ Q₂) := by
  refine le_antisymm ?_ (map_reflectionSubgroup_prod_le Q₁ Q₂)
  rw [reflectionSubgroup_le_iff]
  rintro ⟨x₁, x₂⟩ hinv
  have hunit : IsUnit (Q₁ x₁ + Q₂ x₂) := by
    simpa only [QuadraticMap.prod_apply] using isUnit_of_invertible ((Q₁.prod Q₂) (x₁, x₂))
  rcases h x₁ x₂ hunit with rfl | rfl
  · let _ : Invertible (Q₂ x₂) := hinv.copy _ (by simp)
    refine ⟨(1, reflectionOrthogonal Q₂ x₂), ⟨one_mem _,
      reflectionOrthogonal_mem_reflectionSubgroup Q₂ x₂⟩, ?_⟩
    exact (orthogonalGroupProd_one_reflectionOrthogonal Q₁ Q₂ x₂).trans <|
      Subtype.ext <| LinearEquiv.ext fun p ↦ by simp [reflection_apply]
  · let _ : Invertible (Q₁ x₁) := hinv.copy _ (by simp)
    refine ⟨(reflectionOrthogonal Q₁ x₁, 1),
      ⟨reflectionOrthogonal_mem_reflectionSubgroup Q₁ x₁, one_mem _⟩, ?_⟩
    exact (orthogonalGroupProd_reflectionOrthogonal_one Q₁ Q₂ x₁).trans <|
      Subtype.ext <| LinearEquiv.ext fun p ↦ by simp [reflection_apply]

/-- Under the unit-sum splitting hypothesis, every element of `(Q₁.prod Q₂).reflectionSubgroup`
preserves both summands. -/
theorem reflectionSubgroup_prod_le_range_orthogonalGroupProd
    (Q₁ : QuadraticForm R M₁) (Q₂ : QuadraticForm R M₂)
    (h : ∀ x₁ x₂, IsUnit (Q₁ x₁ + Q₂ x₂) → x₁ = 0 ∨ x₂ = 0) :
    (Q₁.prod Q₂).reflectionSubgroup ≤ (orthogonalGroupProd Q₁ Q₂).range := by
  rw [reflectionSubgroup_prod_eq_map Q₁ Q₂ h]
  exact Subgroup.map_le_range _ _

/-- On a nontrivial module `M`, if `IsUnit (Q x₁ + Q x₂)` forces `x₁ = 0 ∨ x₂ = 0`, then the
factor-swapping isometry `Q.prodCommOrthogonal` is not generated by reflections. -/
theorem prodCommOrthogonal_notMem_reflectionSubgroup [Nontrivial M] (Q : QuadraticForm R M)
    (h : ∀ x₁ x₂, IsUnit (Q x₁ + Q x₂) → x₁ = 0 ∨ x₂ = 0) :
    Q.prodCommOrthogonal ∉ (Q.prod Q).reflectionSubgroup := fun hmem ↦
  Q.prodCommOrthogonal_notMem_range_orthogonalGroupProd
    (reflectionSubgroup_prod_le_range_orthogonalGroupProd Q Q h hmem)

/-- On a nontrivial module `M`, if `IsUnit (Q x₁ + Q x₂)` forces `x₁ = 0 ∨ x₂ = 0`, then
reflections do not generate `orthogonalGroup (Q.prod Q)`. -/
theorem reflectionSubgroup_prod_self_ne_top [Nontrivial M] (Q : QuadraticForm R M)
    (h : ∀ x₁ x₂, IsUnit (Q x₁ + Q x₂) → x₁ = 0 ∨ x₂ = 0) :
    (Q.prod Q).reflectionSubgroup ≠ ⊤ := fun htop ↦
  Q.prodCommOrthogonal_notMem_reflectionSubgroup h (htop ▸ Subgroup.mem_top _)

/-- If `Q.reflectionSubgroup = ⊤` and `IsUnit (Q x₁ + Q x₂)` forces `x₁ = 0 ∨ x₂ = 0`, then
`(Q.prod Q).reflectionSubgroup` is exactly the diagonal block subgroup
`(orthogonalGroupProd Q Q).range`. -/
theorem reflectionSubgroup_prod_self_eq_range_orthogonalGroupProd (Q : QuadraticForm R M)
    (h : ∀ x₁ x₂, IsUnit (Q x₁ + Q x₂) → x₁ = 0 ∨ x₂ = 0)
    (hrefl : Q.reflectionSubgroup = ⊤) :
    (Q.prod Q).reflectionSubgroup = (orthogonalGroupProd Q Q).range := by
  rw [reflectionSubgroup_prod_eq_map Q Q h, hrefl, Subgroup.top_prod_top, MonoidHom.range_eq_map]

/-- If every nonzero vector of `M` has unit `Q`-norm, `IsUnit (Q x₁ + Q x₂)` forces
`x₁ = 0 ∨ x₂ = 0`, and `Q.reflectionSubgroup = ⊤` on a nontrivial module `M`, then
`(Q.prod Q).reflectionSubgroup` has index two in `orthogonalGroup (Q.prod Q)`. -/
theorem index_reflectionSubgroup_prod_self_eq_two [Nontrivial M] (Q : QuadraticForm R M)
    (haniso : ∀ x : M, x ≠ 0 → IsUnit (Q x))
    (h : ∀ x₁ x₂, IsUnit (Q x₁ + Q x₂) → x₁ = 0 ∨ x₂ = 0)
    (hrefl : Q.reflectionSubgroup = ⊤) :
    (Q.prod Q).reflectionSubgroup.index = 2 := by
  rw [reflectionSubgroup_prod_self_eq_range_orthogonalGroupProd Q h hrefl]
  exact Q.index_range_orthogonalGroupProd_eq_two fun x x₁ x₂ hx heq ↦
    h x₁ x₂ (heq.symm ▸ haniso x hx)

end ReflectionSubgroupProd

end QuadraticMap
