/-!
# Dieudonné's theorem: orthogonal transvections in characteristic two

Over a field of characteristic two, the reflection `reflectionOrthogonal Q v` in a vector `v` of
nonzero norm is the orthogonal transvection `x ↦ x + (polar Q v x / Q v) • v`: it fixes `v` and the
polar orthogonal hyperplane of `v`, which contains `v`. For a quadratic form whose polar form is
nondegenerate, these transvections generate the orthogonal group, the one exception being the
orthogonal sum of two hyperbolic planes over the field with two elements. Together with the
Cartan--Dieudonné theorem in characteristic different from two this gives generation by reflections
over every field. In characteristic two the theorem applies to the quadratic space `M / 2 M` of an
even unimodular lattice `M`, whose polar form is nondegenerate: if `M / 2 M` is not the exceptional
space and every class of norm one contains a root of `M`, then reflections in roots induce every
isometry of `M / 2 M`. This is a step in describing the image of `O(M(2))` in the orthogonal group
of its discriminant form.

## Implementation notes

The proof is by induction on the dimension. Fix a frame `(e, f)` with `Q e ≠ 0` and
`polar Q e f = 1`. Outside the exceptional case the transvections act transitively on the vectors
of norm `Q e`, and those fixing `e` act transitively on the vectors `f'` of norm `Q f` with
`polar Q e f' = 1`. So after composing with transvections an orthogonal map fixes `e` and `f`, and
it is generated by transvections of the polar orthogonal complement of the plane they span. Over
the field with two elements in dimension six this complement may be the exceptional space; the
frame is then changed so that its complement is an anisotropic plane plus a hyperbolic plane.

## Main results

* `TauCeti.QuadraticMap.subgroup_eq_top_of_reflection_mem_of_nondegenerate_polarBilin`: a subgroup
  of the orthogonal group containing every reflection in a vector of invertible norm is the whole
  orthogonal group, for a nondegenerate polar form other than two hyperbolic planes over a field
  with two elements.

## References

* J. Dieudonné, *Sur les groupes classiques*, Actualités Sci. Ind. 1040, Hermann (1948).
* A. Hunnell, J. Hutchens and N. Schwartz, *On involutions of type O(q,k) over a field of
  characteristic two*, arXiv:1903.09904v3, §3.
-/

public section

open QuadraticMap Module

namespace TauCeti.QuadraticMap

universe u v

variable {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V]

section Transvection

variable [CharP K 2] (Q : QuadraticForm K V)

/-- The orthogonal transvection in a vector of nonzero norm. -/
private noncomputable def tv (a : V) (ha : Q a ≠ 0) : orthogonalGroup Q :=
  let _ := invertibleOfNonzero ha
  reflectionOrthogonal Q a

private theorem tv_apply (a : V) (ha : Q a ≠ 0) (x : V) :
    (tv Q a ha : V ≃ₗ[K] V) x = x + ((Q a)⁻¹ * polar Q a x) • a := by
  let _ := invertibleOfNonzero ha
  rw [tv, reflectionOrthogonal_apply_of_charTwo, invOf_eq_inv]

omit [CharP K 2] in
private theorem tv_apply_of_polar_eq_zero (a : V) (ha : Q a ≠ 0) {x : V}
    (hx : polar Q a x = 0) : (tv Q a ha : V ≃ₗ[K] V) x = x := by
  let _ := invertibleOfNonzero ha
  rw [tv, coe_reflectionOrthogonal]
  exact reflection_apply_of_polar_eq_zero Q a hx

private theorem map_add_ne_zero_of_polar_ne_zero {x y : V} (hxy : Q x = Q y)
    (hp : polar Q x y ≠ 0) : Q (x + y) ≠ 0 := by
  rwa [map_add_eq_polar_of_map_eq Q hxy]

/-- The transvection in `x + y` sends `x` to `y` when `x` and `y` have equal norm and nonzero
polar pairing: in characteristic two, `x + y = x - y`, so this is
`reflection_sub_apply_eq_of_map_eq`. -/
private theorem tv_add_apply_left {x y : V} (hxy : Q x = Q y) (hp : polar Q x y ≠ 0) :
    (tv Q (x + y) (map_add_ne_zero_of_polar_ne_zero Q hxy hp) : V ≃ₗ[K] V) x = y := by
  have key (a : V) (ha : Q a ≠ 0) (h : a = x - y) : (tv Q a ha : V ≃ₗ[K] V) x = y := by
    subst h
    let _ := invertibleOfNonzero ha
    rw [tv, coe_reflectionOrthogonal]
    exact reflection_sub_apply_eq_of_map_eq Q x y hxy
  exact key _ _ (by
    rw [sub_eq_add_neg, neg_eq_of_add_eq_zero_left (add_self_eq_zero_of_charTwo K y)])

variable {Q} (H : Subgroup (orthogonalGroup Q))

/-- Vectors of equal norm and nonzero polar pairing are exchanged by a transvection. -/
private theorem exists_mem_apply_eq_of_polar_ne_zero (hH : ∀ a ha, tv Q a ha ∈ H) {x y : V}
    (hxy : Q x = Q y) (hp : polar Q x y ≠ 0) :
    ∃ h ∈ H, (h : V ≃ₗ[K] V) x = y ∧
      ∀ z, polar Q x z = polar Q y z → (h : V ≃ₗ[K] V) z = z :=
  ⟨_, hH _ _, tv_add_apply_left Q hxy hp, fun z hz ↦
    tv_apply_of_polar_eq_zero Q _ _ (by rw [polar_add_left, hz, CharTwo.add_self_eq_zero])⟩

/-- **The stabilizer step.** If `Q e ≠ 0`, the transvections fixing `e` act transitively on the
vectors `f` of a given norm with `polar Q e f = 1`. -/
private theorem exists_mem_fix_apply_eq (hH : ∀ a ha, tv Q a ha ∈ H) {e f f' : V}
    (he : Q e ≠ 0) (hf : polar Q e f = 1) (hf' : polar Q e f' = 1) (hff : Q f' = Q f) :
    ∃ h ∈ H, (h : V ≃ₗ[K] V) e = e ∧ (h : V ≃ₗ[K] V) f' = f := by
  have hfe : polar Q f e = 1 := by rw [polar_comm, hf]
  have hf'e : polar Q f' e = 1 := by rw [polar_comm, hf']
  by_cases hp : polar Q f' f = 0
  · set z := f + (Q e)⁻¹ • e with hz
    have hQz : Q z = Q f := by
      have h : (Q e)⁻¹ * (Q e)⁻¹ * Q e = (Q e)⁻¹ := by field_simp
      simp only [hz, QuadraticMap.map_add (⇑Q), QuadraticMap.map_smul, polar_smul_right, hfe,
        smul_eq_mul, h, mul_one, add_assoc, CharTwo.add_self_eq_zero, add_zero]
    have hze : polar Q z e = 1 := by
      simp only [hz, polar_add_left, polar_smul_left, polar_self_eq_zero_of_charTwo, smul_zero,
        add_zero, hfe]
    have hzf : polar Q z f = (Q e)⁻¹ := by
      simp only [hz, polar_add_left, polar_smul_left, polar_self_eq_zero_of_charTwo, hf,
        smul_eq_mul, mul_one, zero_add]
    have hf'z : polar Q f' z = (Q e)⁻¹ := by
      simp only [hz, polar_add_right, polar_smul_right, hp, hf'e, smul_eq_mul, mul_one, zero_add]
    have hinv : (Q e)⁻¹ ≠ 0 := inv_ne_zero he
    obtain ⟨h₁, hh₁, hh₁f', hh₁e⟩ :=
      exists_mem_apply_eq_of_polar_ne_zero H hH (hff.trans hQz.symm) (hf'z ▸ hinv)
    obtain ⟨h₂, hh₂, hh₂z, hh₂e⟩ :=
      exists_mem_apply_eq_of_polar_ne_zero H hH hQz (hzf ▸ hinv)
    refine ⟨h₂ * h₁, H.mul_mem hh₂ hh₁, ?_, ?_⟩
    · rw [orthogonalGroup.coe_mul_apply, hh₁e e (by rw [hf'e, hze]), hh₂e e (by rw [hze, hfe])]
    · rw [orthogonalGroup.coe_mul_apply, hh₁f', hh₂z]
  · obtain ⟨h, hh, hhf', hhe⟩ := exists_mem_apply_eq_of_polar_ne_zero H hH hff hp
    exact ⟨h, hh, hhe e (by rw [hf'e, hfe]), hhf'⟩

/-- Two vectors of equal nonzero norm are related by a product of at most two transvections, as
long as every pair of such vectors that are polar orthogonal admits a vector of nonzero norm with
nonzero polar pairing with both. -/
private theorem exists_mem_apply_eq (hH : ∀ a ha, tv Q a ha ∈ H)
    (hgood : ∀ x y : V, Q x = Q y → Q x ≠ 0 → polar Q x y = 0 → x ≠ y →
      ∃ w, Q w ≠ 0 ∧ polar Q x w ≠ 0 ∧ polar Q y w ≠ 0)
    {x y : V} (hxy : Q x = Q y) (hx : Q x ≠ 0) : ∃ h ∈ H, (h : V ≃ₗ[K] V) x = y := by
  by_cases hxy' : x = y
  · exact ⟨1, H.one_mem, by rw [hxy', Subgroup.coe_one, one_apply_eq_self]⟩
  by_cases hp : polar Q x y = 0
  · obtain ⟨w, hw, hxw, hyw⟩ := hgood x y hxy hx hp hxy'
    set c := (Q w)⁻¹ * polar Q w x
    have hc0 : c ≠ 0 := mul_ne_zero (inv_ne_zero hw) (by rwa [polar_comm])
    have hz : (tv Q w hw : V ≃ₗ[K] V) x = x + c • w := tv_apply Q w hw x
    set z := (tv Q w hw : V ≃ₗ[K] V) x
    have hQz : Q x = Q z := (map_app_of_mem_orthogonalGroup (tv Q w hw).property x).symm
    have hxz : polar Q x z ≠ 0 := by
      simp only [hz, polar_add_right, polar_smul_right, polar_self_eq_zero_of_charTwo, zero_add,
        smul_eq_mul]
      exact mul_ne_zero hc0 hxw
    have hzy : polar Q z y ≠ 0 := by
      simp only [hz, polar_add_left, polar_smul_left, hp, zero_add, smul_eq_mul,
        polar_comm (⇑Q) w y]
      exact mul_ne_zero hc0 hyw
    obtain ⟨h₁, hh₁, hh₁x, -⟩ := exists_mem_apply_eq_of_polar_ne_zero H hH hQz hxz
    obtain ⟨h₂, hh₂, hh₂z, -⟩ :=
      exists_mem_apply_eq_of_polar_ne_zero H hH (hQz.symm.trans hxy) hzy
    exact ⟨h₂ * h₁, H.mul_mem hh₂ hh₁, by rw [orthogonalGroup.coe_mul_apply, hh₁x, hh₂z]⟩
  · obtain ⟨h, hh, hhx, -⟩ := exists_mem_apply_eq_of_polar_ne_zero H hH hxy hp
    exact ⟨h, hh, hhx⟩

end Transvection

section Nondegenerate

variable {Q : QuadraticForm K V}

/-- A nonzero nondegenerate quadratic space has a vector `e` of nonzero norm and a vector `f`
with `polar Q e f = 1`. -/
private theorem exists_frame [CharP K 2] [Nontrivial V] (hB : Q.polarBilin.Nondegenerate) :
    ∃ e f : V, Q e ≠ 0 ∧ polar Q e f = 1 := by
  obtain ⟨x, hx⟩ := exists_ne (0 : V)
  obtain ⟨u, hu⟩ := LinearMap.BilinForm.Nondegenerate.exists_apply_ne_zero hB hx
  rw [polarBilin_apply_apply] at hu
  set y := (polar Q x u)⁻¹ • u
  have hxy : polar Q x y = 1 := by rw [polar_smul_right, smul_eq_mul, inv_mul_cancel₀ hu]
  by_cases hQx : Q x = 0
  · by_cases hQy : Q y = 0
    · refine ⟨x + y, y, by rw [QuadraticMap.map_add (⇑Q), hQx, hQy, hxy]; simp, ?_⟩
      rw [polar_add_left, hxy, polar_self_eq_zero_of_charTwo, add_zero]
    · exact ⟨y, x, hQy, by rw [polar_comm, hxy]⟩
  · exact ⟨x, y, hQx, hxy⟩

/-- The exceptional quadratic spaces: the orthogonal sums of two hyperbolic planes over a field of
two elements, in the form of four-dimensional spaces with a two-dimensional totally isotropic
subspace. -/
private def Exc (Q : QuadraticForm K V) : Prop :=
  Nat.card K = 2 ∧ finrank K V = 4 ∧
    ∃ U : Submodule K V, Q.IsTotallyIsotropic U ∧ finrank K U = 2

/-- If every `f + c • x` is singular, where `Q x ≠ 0` and `polar Q f x ≠ 0`, then the field has
two elements: the quadratic polynomial `c ↦ Q (f + c • x)` has at most two roots. -/
private theorem eq_zero_or_eq_one_of_forall_map_add_smul_eq_zero [CharP K 2] {x f : V}
    (hx : Q x ≠ 0) (hfx : polar Q f x ≠ 0) (hcand : ∀ c : K, Q (f + c • x) = 0) (d : K) :
    d = 0 ∨ d = 1 := by
  have hQf : Q f = 0 := by simpa using hcand 0
  by_contra! hd
  set c := d * polar Q f x / Q x with hc
  have hc0 : c ≠ 0 := div_ne_zero (mul_ne_zero hd.1 hfx) hx
  have h := hcand c
  rw [QuadraticMap.map_add (⇑Q), QuadraticMap.map_smul, polar_smul_right, hQf, zero_add,
    smul_eq_mul, smul_eq_mul] at h
  have h2 : c * Q x + polar Q f x = 0 :=
    (mul_eq_zero.mp (by linear_combination h)).resolve_left hc0
  have h3 : (d + 1) * polar Q f x = 0 := by
    rw [← h2, hc]; field_simp
  exact hd.2 (by
    have := (mul_eq_zero.mp h3).resolve_right hfx
    rwa [CharTwo.add_eq_zero] at this)

/-- If `f + u` is singular for every `u` polar orthogonal to `x` and `y`, then the polar orthogonal
complement of `x` and `y` is polar-isotropic, so the dimension is at most four. -/
private theorem finrank_le_four_of_map_add_eq_zero [CharP K 2] [FiniteDimensional K V]
    (hB : Q.polarBilin.Nondegenerate) {x y f : V}
    (hf : ∀ u, polar Q x u = 0 → polar Q y u = 0 → Q (f + u) = 0) : finrank K V ≤ 4 := by
  classical
  set U := LinearMap.BilinForm.orthogonal Q.polarBilin (Submodule.span K {x, y})
  have hQf : Q f = 0 := by
    simpa using hf 0 (polar_zero_right (Q := Q) x) (polar_zero_right (Q := Q) y)
  have hQU {u : V} (hu : u ∈ U) : Q u = polar Q f u := by
    obtain ⟨hxu, hyu⟩ := LinearMap.BilinForm.mem_orthogonal_span_pair_iff.mp hu
    rw [polarBilin_apply_apply] at hxu hyu
    have h := hf u hxu hyu
    rw [QuadraticMap.map_add (⇑Q), hQf, zero_add, CharTwo.add_eq_zero] at h
    exact h
  have hUiso : U ≤ LinearMap.BilinForm.orthogonal Q.polarBilin U := by
    intro u hu
    rw [LinearMap.BilinForm.mem_orthogonal_iff]
    intro u' hu'
    rw [polarBilin_apply_apply, polar, hQU (U.add_mem hu' hu), hQU hu', hQU hu, polar_add_right]
    ring
  have hUdim := LinearMap.BilinForm.two_mul_finrank_le_finrank_of_le_orthogonal hB hUiso
  have hspan : finrank K (Submodule.span K {x, y}) ≤ 2 := by
    have := finrank_span_finset_le_card (R := K) ({x, y} : Finset V)
    rw [Set.finrank, Finset.coe_pair] at this
    exact this.trans Finset.card_le_two
  have hUfin : finrank K U = finrank K V - finrank K (Submodule.span K {x, y}) :=
    LinearMap.BilinForm.finrank_orthogonal hB _
  omega

/-- For distinct polar-orthogonal `x` and `y` of equal norm and a singular `f` pairing equally with
them and nontrivially with `x`, the vectors `f` and `x + y` span a totally isotropic plane. -/
private theorem exists_isTotallyIsotropic_finrank_eq_two [CharP K 2] {x y f : V}
    (hxy : Q x = Q y) (hp : polar Q x y = 0) (hne : x ≠ y) (hQf : Q f = 0)
    (hxf : polar Q x f ≠ 0) (hfxy : polar Q f x = polar Q f y) :
    ∃ S : Submodule K V, Q.IsTotallyIsotropic S ∧ finrank K S = 2 := by
  have hpxy : polar Q f (x + y) = 0 := by
    rw [polar_add_right, hfxy, CharTwo.add_self_eq_zero]
  have hQxy : Q (x + y) = 0 := by
    rw [map_add_eq_polar_of_map_eq Q hxy, hp]
  have hxy0 : x + y ≠ 0 := fun h ↦
    hne ((add_eq_zero_iff_eq_of_charTwo K).mp h)
  have hli : LinearIndependent K ![f, x + y] := by
    rw [LinearIndependent.pair_iff]
    intro a b hab
    have h1 := congrArg (polar Q x) hab
    simp only [polar_add_right, polar_smul_right, polar_self_eq_zero_of_charTwo, hp, add_zero,
      mul_zero, polar_zero_right, smul_eq_mul] at h1
    have ha : a = 0 := (mul_eq_zero.mp h1).resolve_right hxf
    refine ⟨ha, ?_⟩
    rw [ha, zero_smul, zero_add] at hab
    exact (smul_eq_zero.mp hab).resolve_right hxy0
  refine ⟨Submodule.span K {f, x + y}, isTotallyIsotropic_iff.mpr fun v hv ↦ ?_, ?_⟩
  · obtain ⟨a, b, rfl⟩ := Submodule.mem_span_pair.mp hv
    rw [QuadraticMap.map_add (⇑Q), QuadraticMap.map_smul, QuadraticMap.map_smul, polar_smul_left,
      polar_smul_right, hQf, hQxy, hpxy]
    simp
  · rw [show ({f, x + y} : Set V) = Set.range ![f, x + y] by simp [Set.pair_comm],
      finrank_span_eq_card hli, Fintype.card_fin]

/-- Outside the exceptional case, two distinct polar-orthogonal vectors `x` and `y` of equal
nonzero norm admit a vector of nonzero norm with nonzero polar pairing with both. If there were
none, then for `f` pairing nontrivially with `x` and `y`, every `f + c • x` and every `f + u` with
`u` polar orthogonal to `x` and `y` would be singular; so the field has two elements, the dimension
is at most four, and `f` and `x + y` span a totally isotropic plane. -/
private theorem exists_good [CharP K 2] [FiniteDimensional K V]
    (hB : Q.polarBilin.Nondegenerate) (hexc : ¬ Exc Q) {x y : V} (hxy : Q x = Q y)
    (hx : Q x ≠ 0) (hp : polar Q x y = 0) (hne : x ≠ y) :
    ∃ w, Q w ≠ 0 ∧ polar Q x w ≠ 0 ∧ polar Q y w ≠ 0 := by
  have hx0 : x ≠ 0 := fun h ↦ hx (by rw [h, map_zero])
  have hy0 : y ≠ 0 := fun h ↦ hx (by rw [hxy, h, map_zero])
  obtain ⟨f, hxf, hyf⟩ :=
    LinearMap.BilinForm.Nondegenerate.exists_apply_ne_zero_and_apply_ne_zero hB hx0 hy0
  rw [polarBilin_apply_apply] at hxf hyf
  by_contra! hno
  have hfx : polar Q f x ≠ 0 := by rwa [polar_comm]
  have hfy : polar Q f y ≠ 0 := by rwa [polar_comm]
  have hcand (c : K) : Q (f + c • x) = 0 := by
    by_contra hc
    have h := hno _ hc (by
      rwa [polar_add_right, polar_smul_right, polar_self_eq_zero_of_charTwo, smul_zero, add_zero])
    rw [polar_add_right, polar_smul_right, polar_comm _ y x, hp, smul_zero, add_zero] at h
    exact hyf h
  have hK := eq_zero_or_eq_one_of_forall_map_add_smul_eq_zero hx hfx hcand
  have hdim : finrank K V ≤ 4 := by
    refine finrank_le_four_of_map_add_eq_zero hB (x := x) (y := y) (f := f) fun u hxu hyu ↦ ?_
    by_contra hfu
    have h := hno _ hfu (by rwa [polar_add_right, hxu, add_zero])
    rw [polar_add_right, hyu, add_zero] at h
    exact hyf h
  obtain ⟨S, hS, hS2⟩ := exists_isTotallyIsotropic_finrank_eq_two hxy hp hne
    (by simpa using hcand 0) hxf (by rw [(hK _).resolve_left hfx, (hK _).resolve_left hfy])
  have hSle := hS.two_mul_finrank_le_finrank hB
  exact hexc ⟨natCard_eq_two_iff_forall_eq_zero_or_eq_one.mpr hK, by omega, S, hS, hS2⟩

omit [AddCommGroup V] [Module K V] in
private theorem polarBilin_apply_eq_one_of_polar_eq_one {M : Type*} [AddCommGroup M] [Module K M]
    {Q : QuadraticForm K M} {e f : M} (hef : polar Q e f = 1) : Q.polarBilin f e = 1 := by
  rw [polarBilin_apply_apply, polar_comm, hef]

end Nondegenerate

section Restriction

variable [CharP K 2] {Q : QuadraticForm K V}

omit [CharP K 2] in
/-- The orthogonal maps of the restriction of `Q` to `W` that extend to an element of `H` fixing
`P` pointwise. -/
private def extensionSubgroup (H : Subgroup (orthogonalGroup Q)) (W P : Submodule K V) :
    Subgroup (orthogonalGroup (Q.restrict W)) where
  carrier := {k | ∃ g ∈ H, (∀ u : W, (g : V ≃ₗ[K] V) u = ((k : W ≃ₗ[K] W) u : V)) ∧
    ∀ z ∈ P, (g : V ≃ₗ[K] V) z = z}
  mul_mem' := by
    rintro k₁ k₂ ⟨g₁, hg₁, hg₁W, hg₁P⟩ ⟨g₂, hg₂, hg₂W, hg₂P⟩
    refine ⟨g₁ * g₂, H.mul_mem hg₁ hg₂, fun u ↦ ?_, fun z hz ↦ ?_⟩
    · rw [orthogonalGroup.coe_mul_apply, hg₂W, hg₁W, orthogonalGroup.coe_mul_apply]
    · rw [orthogonalGroup.coe_mul_apply, hg₂P z hz, hg₁P z hz]
  one_mem' := ⟨1, H.one_mem, fun _ ↦ by simp only [Subgroup.coe_one, one_apply_eq_self],
    fun _ _ ↦ by rw [Subgroup.coe_one, one_apply_eq_self]⟩
  inv_mem' := by
    rintro k ⟨g, hg, hgW, hgP⟩
    refine ⟨g⁻¹, H.inv_mem hg, fun u ↦ orthogonalGroup.inv_apply_eq_of_apply_eq ?_, fun z hz ↦
      orthogonalGroup.inv_apply_eq_of_apply_eq (hgP z hz)⟩
    rw [hgW, ← orthogonalGroup.coe_mul_apply, mul_inv_cancel, Subgroup.coe_one, one_apply_eq_self]

/-- The transvections of the restriction of `Q` to `W` extend to transvections of `Q` fixing every
vector polar orthogonal to `W`. -/
private theorem tv_mem_extensionSubgroup {H : Subgroup (orthogonalGroup Q)}
    (hH : ∀ a ha, tv Q a ha ∈ H) {W P : Submodule K V}
    (hWP : W ≤ LinearMap.BilinForm.orthogonal Q.polarBilin P) (a : W)
    (ha : (Q.restrict W) a ≠ 0) : tv (Q.restrict W) a ha ∈ extensionSubgroup H W P := by
  have ha' : Q a ≠ 0 := by simpa only [QuadraticMap.restrict_apply] using ha
  refine ⟨tv Q a ha', hH a ha', fun u ↦ ?_, fun z hz ↦ ?_⟩
  · have hpolar : polar (Q.restrict W) a u = polar Q a u := by
      simpa only [polarBilin_apply_apply, LinearMap.domRestrict₁₂_apply] using
        LinearMap.congr_fun₂ (polarBilin_restrict Q W) a u
    rw [tv_apply Q (a : V) ha', tv_apply, hpolar, Submodule.coe_add, Submodule.coe_smul,
      QuadraticMap.restrict_apply]
  · refine tv_apply_of_polar_eq_zero Q a ha' ?_
    rw [polar_comm]
    exact (LinearMap.BilinForm.mem_orthogonal_iff.mp (hWP a.property)) z hz

/-- **The restriction step.** If the transvections generate the orthogonal group of the polar
orthogonal complement `W` of a plane spanned by `e` and `f` with `polar Q e f = 1`, then every
orthogonal map fixing `e` and `f` lies in every subgroup containing the transvections. -/
private theorem mem_of_apply_eq_self {e f : V} (hef : polar Q e f = 1)
    (ih : ∀ H' : Subgroup (orthogonalGroup (Q.restrict
        (LinearMap.BilinForm.orthogonal Q.polarBilin (Submodule.span K {e, f})))),
      (∀ a ha, tv _ a ha ∈ H') → H' = ⊤)
    (H : Subgroup (orthogonalGroup Q)) (hH : ∀ a ha, tv Q a ha ∈ H)
    (g : orthogonalGroup Q) (hge : (g : V ≃ₗ[K] V) e = e) (hgf : (g : V ≃ₗ[K] V) f = f) :
    g ∈ H := by
  set P := Submodule.span K {e, f}
  set W := LinearMap.BilinForm.orthogonal Q.polarBilin P
  obtain ⟨g', hg', hg'W, hg'P⟩ :
      orthogonalGroup.restrict g (map_orthogonal_polarBilin_of_mem_orthogonalGroup g.property
        (by rw [Submodule.map_span, Set.image_pair, LinearEquiv.coe_coe, hge, hgf])) ∈
        extensionSubgroup H W P := by
    rw [ih _ (tv_mem_extensionSubgroup hH le_rfl)]
    exact Subgroup.mem_top _
  convert hg'
  refine Subtype.ext (LinearEquiv.toLinearMap_injective (LinearMap.ext_on_codisjoint
    (LinearMap.BilinForm.IsAlt.isCompl_span_pair_orthogonal Q.isAlt_polarBilin
      (polarBilin_apply_eq_one_of_polar_eq_one hef)).symm.codisjoint
    (fun w hw ↦ ?_) (fun z hz ↦ ?_)))
  · simp only [LinearEquiv.coe_coe]
    rw [hg'W ⟨w, hw⟩, orthogonalGroup.coe_restrict_apply]
  · obtain ⟨a, b, rfl⟩ := Submodule.mem_span_pair.mp hz
    simp only [LinearEquiv.coe_coe]
    rw [hg'P _ hz, map_add, map_smul, map_smul, hge, hgf]

end Restriction

section Induction

variable [CharP K 2]

omit [AddCommGroup V] [Module K V] in
/-- Over the field with two elements, the binary form `(p + q)² + q p` is anisotropic. -/
private theorem eq_zero_and_eq_zero_of_natCard_eq_two (hcard : Nat.card K = 2) {p q : K}
    (h : (p + q) * (p + q) + q * p = 0) : p = 0 ∧ q = 0 := by
  have hK := natCard_eq_two_iff_forall_eq_zero_or_eq_one.mp hcard
  have h11 : (1 : K) + 1 = 0 := CharTwo.add_self_eq_zero 1
  rcases hK p with rfl | rfl <;> rcases hK q with rfl | rfl
  · exact ⟨rfl, rfl⟩
  · simp at h
  · simp at h
  · rw [h11] at h
    simp at h

/-- A singular member `v i₀` of a linearly independent family, polar orthogonal to the whole
family, has a singular partner pairing to one with `v i₀` and to zero with the rest. -/
private theorem exists_hyperbolic_partner [FiniteDimensional K V]
    {Q : QuadraticForm K V} (hB : Q.polarBilin.Nondegenerate) {ι : Type*} [Finite ι]
    [DecidableEq ι] {v : ι → V} (hv : LinearIndependent K v) (i₀ : ι) (hQ : Q (v i₀) = 0)
    (hp : ∀ j, polar Q (v j) (v i₀) = 0) :
    ∃ w, Q w = 0 ∧ ∀ j, polar Q (v j) w = if j = i₀ then 1 else 0 := by
  obtain ⟨t, ht⟩ := LinearMap.BilinForm.Nondegenerate.exists_forall_apply_eq hB hv
    fun j ↦ if j = i₀ then 1 else 0
  simp only [polarBilin_apply_apply] at ht
  refine ⟨t + Q t • v i₀, ?_, fun j ↦ ?_⟩
  · have h : polar Q t (v i₀) = 1 := by simpa using ht i₀
    rw [QuadraticMap.map_add (⇑Q), QuadraticMap.map_smul, hQ, polar_smul_right, h]
    simp [CharTwo.add_self_eq_zero]
  · rw [polar_add_right, polar_smul_right, hp j, smul_zero, add_zero, polar_comm, ht j]

omit [CharP K 2] in
/-- Expansion in a symplectic family `x i, y i` spanning the space. -/
private theorem eq_sum_polar_smul_add_polar_smul [FiniteDimensional K V]
    {Q : QuadraticForm K V} (hB : Q.polarBilin.Nondegenerate) {m : ℕ} {x y : Fin m → V}
    (hxy : ∀ i j, polar Q (x i) (y j) = if i = j then 1 else 0)
    (hxx : ∀ i j, polar Q (x i) (x j) = 0) (hyy : ∀ i j, polar Q (y i) (y j) = 0)
    (hn : finrank K V = 2 * m) (u : V) :
    u = ∑ i, (polar Q u (y i) • x i + polar Q u (x i) • y i) := by
  have h := LinearMap.BilinForm.Nondegenerate.eq_sum_apply_smul hB (v := Sum.elim x y)
    (w := Sum.elim y x) (fun a b ↦ by
      rw [polarBilin_apply_apply]
      rcases a with i | i <;> rcases b with j | j
      · simp [hxy]
      · simp [hxx]
      · simp [hyy]
      · rw [Sum.elim_inr, Sum.elim_inr, polar_comm, hxy]
        simp [eq_comm])
    (by simp [hn, two_mul]) u
  simp only [polarBilin_apply_apply] at h
  rwa [Fintype.sum_sum_type, ← Finset.sum_add_distrib] at h

omit [CharP K 2] in
/-- A subspace `W` is not exceptional if each of its singular vectors `u` whose pairings with a
hyperbolic pair `h, h'` have vanishing product is `polar Q u h' • h + polar Q u h • h'`. Indeed, a
totally isotropic plane `U ≤ W` would then map isomorphically onto `K × K` by these two pairings,
so it would contain `h` and `h'`, which pair to one. -/
private theorem not_exc_of_eq_smul_add_smul [FiniteDimensional K V] {Q : QuadraticForm K V}
    {W : Submodule K V}
    {h h' : V} (hh : polar Q h h' = 1)
    (hkey : ∀ u ∈ W, Q u = 0 → polar Q u h' * polar Q u h = 0 →
      u = polar Q u h' • h + polar Q u h • h') :
    ¬ Exc (Q.restrict W) := by
  rintro ⟨-, -, U', hU', hU'2⟩
  set U := U'.map W.subtype
  have hU : Q.IsTotallyIsotropic U := isTotallyIsotropic_restrict_iff.mp hU'
  have hU2 : finrank K U = 2 := by rw [Submodule.finrank_map_subtype_eq, hU'2]
  have hkey' (u : U) (hu : polar Q u h' * polar Q u h = 0) :
      (u : V) = polar Q u h' • h + polar Q u h • h' :=
    hkey u (Submodule.map_subtype_le W U' u.property) (hU.apply_eq_zero u.property) hu
  let L : U →ₗ[K] K × K := LinearMap.prod ((Q.polarBilin.flip h').comp U.subtype)
    ((Q.polarBilin.flip h).comp U.subtype)
  have hL (u : U) : L u = (polar Q u h', polar Q u h) := by
    simp [L, polarBilin_apply_apply]
  have hinj : Function.Injective L := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro u hu
    rw [LinearMap.mem_ker, hL, Prod.mk_eq_zero] at hu
    have := hkey' u (by rw [hu.1, zero_mul])
    rw [hu.1, hu.2, zero_smul, zero_smul, add_zero] at this
    exact Subtype.ext this
  have hsurj := (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
    (by simp [hU2])).mp hinj
  obtain ⟨u₁, hu₁⟩ := hsurj (1, 0)
  obtain ⟨u₂, hu₂⟩ := hsurj (0, 1)
  rw [hL, Prod.mk.injEq] at hu₁ hu₂
  have h₁ := hkey' u₁ (by rw [hu₁.2, mul_zero])
  have h₂ := hkey' u₂ (by rw [hu₂.1, zero_mul])
  rw [hu₁.1, hu₁.2, one_smul, zero_smul, add_zero] at h₁
  rw [hu₂.1, hu₂.2, one_smul, zero_smul, zero_add] at h₂
  have h0 := hU.polar_eq_zero u₁.property u₂.property
  rw [h₁, h₂, hh] at h0
  exact one_ne_zero h0

/-- In a six-dimensional space over the field with two elements with a symplectic basis
`x 0, x 1, x 2, y 0, y 1, y 2` in which `Q (x 0) = 1` and `x 1, x 2, y 1, y 2` are singular, the
polar orthogonal complement of the frame `(x 0, y 0 + x 1 + y 1)` is the orthogonal sum of the
anisotropic plane spanned by `x 1 + x 0` and `y 1 + x 0` and the hyperbolic plane spanned by `x 2`
and `y 2`, so it is not exceptional. -/
private theorem not_exc_orthogonal_span_pair_add [FiniteDimensional K V]
    {Q : QuadraticForm K V} (hB : Q.polarBilin.Nondegenerate) (hcard : Nat.card K = 2)
    (hn : finrank K V = 6) {x y : Fin 3 → V}
    (hxy : ∀ i j, polar Q (x i) (y j) = if i = j then 1 else 0)
    (hxx : ∀ i j, polar Q (x i) (x j) = 0) (hyy : ∀ i j, polar Q (y i) (y j) = 0)
    (hQx₀ : Q (x 0) = 1) (hQx₁ : Q (x 1) = 0) (hQx₂ : Q (x 2) = 0) (hQy₁ : Q (y 1) = 0)
    (hQy₂ : Q (y 2) = 0) :
    ¬ Exc (Q.restrict (LinearMap.BilinForm.orthogonal Q.polarBilin
      (Submodule.span K {x 0, y 0 + x 1 + y 1}))) := by
  refine not_exc_of_eq_smul_add_smul (by simpa using hxy 2 2) fun u hu hQu hCD ↦ ?_
  obtain ⟨hx₀u, hfu⟩ := LinearMap.BilinForm.mem_orthogonal_span_pair_iff.mp hu
  rw [polarBilin_apply_apply] at hx₀u hfu
  rw [polar_add_left, polar_add_left] at hfu
  have hux₀ : polar Q u (x 0) = 0 := by rw [polar_comm, hx₀u]
  have huy₀ : polar Q u (y 0) = polar Q u (x 1) + polar Q u (y 1) := by
    rw [polar_comm _ u (y 0), polar_comm _ u (x 1), polar_comm _ u (y 1)]
    exact (add_eq_zero_iff_eq_of_charTwo K).mp (by rwa [add_assoc] at hfu)
  have hexp := eq_sum_polar_smul_add_polar_smul hB hxy hxx hyy hn u
  rw [Fin.sum_univ_three, hux₀, zero_smul, add_zero] at hexp
  have hyx (i j : Fin 3) : polar Q (y i) (x j) = if j = i then 1 else 0 := by
    rw [polar_comm, hxy]
  have hQ : 0 = polar Q u (y 0) * polar Q u (y 0) + polar Q u (x 1) * polar Q u (y 1) +
      polar Q u (x 2) * polar Q u (y 2) := by
    simpa [QuadraticMap.map_add (⇑Q), QuadraticMap.map_smul, polar_add_left, polar_add_right,
      polar_smul_left, polar_smul_right, hxy, hyx, hxx, hyy, hQx₀, hQx₁, hQx₂, hQy₁, hQy₂,
      hQu] using congrArg Q hexp
  rw [mul_comm] at hCD
  rw [huy₀, hCD, add_zero] at hQ
  obtain ⟨h₁, h₂⟩ := eq_zero_and_eq_zero_of_natCard_eq_two hcard (p := polar Q u (x 1))
    (q := polar Q u (y 1)) (by linear_combination -hQ)
  simpa only [huy₀, h₁, h₂, add_zero, zero_smul, zero_add] using hexp

/-- An exceptional polar orthogonal complement of a frame `(e, f)` contains two mutually
polar-orthogonal singular vectors `s₁, s₂` with `e, f, s₁, s₂` linearly independent. -/
private theorem exists_singular_pair_of_exc [FiniteDimensional K V] {Q : QuadraticForm K V}
    {e f : V}
    (hef : polar Q e f = 1) (hexc : Exc (Q.restrict
      (LinearMap.BilinForm.orthogonal Q.polarBilin (Submodule.span K {e, f})))) :
    ∃ s₁ s₂ : V, polar Q e s₁ = 0 ∧ polar Q f s₁ = 0 ∧ polar Q e s₂ = 0 ∧ polar Q f s₂ = 0 ∧
      Q s₁ = 0 ∧ Q s₂ = 0 ∧ polar Q s₁ s₂ = 0 ∧ LinearIndependent K ![e, f, s₁, s₂] := by
  set W := LinearMap.BilinForm.orthogonal Q.polarBilin (Submodule.span K {e, f})
  obtain ⟨-, -, U', hU', hU'2⟩ := hexc
  set U := U'.map W.subtype
  have hU : Q.IsTotallyIsotropic U := isTotallyIsotropic_restrict_iff.mp hU'
  let b := Module.finBasisOfFinrankEq K U (by rw [Submodule.finrank_map_subtype_eq, hU'2])
  have hUW : U ≤ W := Submodule.map_subtype_le W U'
  obtain ⟨hes₁, hfs₁⟩ := LinearMap.BilinForm.mem_orthogonal_span_pair_iff.mp (hUW (b 0).property)
  obtain ⟨hes₂, hfs₂⟩ := LinearMap.BilinForm.mem_orthogonal_span_pair_iff.mp (hUW (b 1).property)
  rw [polarBilin_apply_apply] at hes₁ hfs₁ hes₂ hfs₂
  have hfe : polar Q f e = 1 := by rw [polar_comm, hef]
  have hli₂ : LinearIndependent K ![(b 0 : V), b 1] := by
    convert b.linearIndependent.map' U.subtype U.ker_subtype using 1
    ext i
    fin_cases i <;> rfl
  refine ⟨b 0, b 1, hes₁, hfs₁, hes₂, hfs₂, hU.apply_eq_zero (b 0).property,
    hU.apply_eq_zero (b 1).property, hU.polar_eq_zero (b 0).property (b 1).property,
    Fintype.linearIndependent_iff.mpr fun g hg ↦ ?_⟩
  simp only [Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons] at hg
  have h1 := congrArg (polar Q e) hg
  have h2 := congrArg (polar Q f) hg
  simp only [polar_add_right, polar_smul_right, polar_self_eq_zero_of_charTwo, hef, hfe, hes₁, hes₂,
    hfs₁, hfs₂, polar_zero_right, smul_eq_mul, mul_zero, mul_one, zero_add, add_zero] at h1 h2
  rw [h1, h2, zero_smul, zero_smul, zero_add, zero_add] at hg
  obtain ⟨h3, h4⟩ := LinearIndependent.pair_iff.mp hli₂ (g 2) (g 3) hg
  intro i
  fin_cases i
  exacts [h2, h1, h3, h4]

/-- Singular hyperbolic partners `s₁', s₂'` of `s₁, s₂` in the polar orthogonal complement of the
frame `(e, f)`, with `s₁'` and `s₂'` polar orthogonal. -/
private theorem exists_hyperbolic_partners [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hB : Q.polarBilin.Nondegenerate) {e f s₁ s₂ : V} (hes₁ : polar Q e s₁ = 0)
    (hfs₁ : polar Q f s₁ = 0) (hes₂ : polar Q e s₂ = 0) (hfs₂ : polar Q f s₂ = 0)
    (hQs₁ : Q s₁ = 0) (hQs₂ : Q s₂ = 0) (hs₁s₂ : polar Q s₁ s₂ = 0)
    (hli : LinearIndependent K ![e, f, s₁, s₂]) :
    ∃ s₁' s₂' : V, Q s₁' = 0 ∧ Q s₂' = 0 ∧ polar Q e s₁' = 0 ∧ polar Q f s₁' = 0 ∧
      polar Q e s₂' = 0 ∧ polar Q f s₂' = 0 ∧ polar Q s₁ s₁' = 1 ∧ polar Q s₂ s₁' = 0 ∧
      polar Q s₁ s₂' = 0 ∧ polar Q s₂ s₂' = 1 ∧ polar Q s₁' s₂' = 0 := by
  obtain ⟨s₁', hQs₁', hs₁'⟩ := exists_hyperbolic_partner hB hli 2 hQs₁ fun j ↦ by
    fin_cases j <;> simp [hes₁, hfs₁, polar_self_eq_zero_of_charTwo Q,
      polar_comm (⇑Q) s₂ s₁, hs₁s₂]
  obtain ⟨t, hQt, ht⟩ := exists_hyperbolic_partner hB hli 3 hQs₂ fun j ↦ by
    fin_cases j <;> simp [hes₂, hfs₂, polar_self_eq_zero_of_charTwo Q, hs₁s₂]
  have hes₁' : polar Q e s₁' = 0 := by simpa using hs₁' 0
  have hfs₁' : polar Q f s₁' = 0 := by simpa using hs₁' 1
  have hs₁s₁' : polar Q s₁ s₁' = 1 := by simpa using hs₁' 2
  have hs₂s₁' : polar Q s₂ s₁' = 0 := by simpa using hs₁' 3
  have het : polar Q e t = 0 := by simpa using ht 0
  have hft : polar Q f t = 0 := by simpa using ht 1
  have hs₁t : polar Q s₁ t = 0 := by simpa using ht 2
  have hs₂t : polar Q s₂ t = 1 := by simpa using ht 3
  refine ⟨s₁', t + polar Q s₁' t • s₁, hQs₁', ?_, hes₁', hfs₁', ?_, ?_, hs₁s₁', hs₂s₁', ?_, ?_,
    ?_⟩
  · rw [QuadraticMap.map_add (⇑Q), QuadraticMap.map_smul, hQt, hQs₁, polar_smul_right,
      polar_comm _ t s₁, hs₁t]
    simp
  · simp [polar_add_right, polar_smul_right, het, hes₁]
  · simp [polar_add_right, polar_smul_right, hft, hfs₁]
  · simp [polar_add_right, polar_smul_right, hs₁t, polar_self_eq_zero_of_charTwo Q]
  · simp [polar_add_right, polar_smul_right, hs₂t, polar_comm (⇑Q) s₂ s₁, hs₁s₂]
  · rw [polar_add_right, polar_smul_right, polar_comm _ s₁' s₁, hs₁s₁', smul_eq_mul, mul_one,
      CharTwo.add_self_eq_zero]

/-- **The frame switch.** If the polar orthogonal complement of a frame `(e, f)` is exceptional,
take singular vectors `s₁, s₂` spanning a totally isotropic plane of it, with hyperbolic partners
`s₁', s₂'`. Then the frame `(e, f + s₁ + s₁')` is not exceptional
(`not_exc_orthogonal_span_pair_add`). -/
private theorem exists_frame_not_exc_of_exc [FiniteDimensional K V]
    {Q : QuadraticForm K V} (hB : Q.polarBilin.Nondegenerate) {e f : V} (he : Q e ≠ 0)
    (hef : polar Q e f = 1)
    (hexc : Exc (Q.restrict
      (LinearMap.BilinForm.orthogonal Q.polarBilin (Submodule.span K {e, f})))) :
    ∃ e' f' : V, Q e' ≠ 0 ∧ polar Q e' f' = 1 ∧
      ¬ Exc (Q.restrict
        (LinearMap.BilinForm.orthogonal Q.polarBilin (Submodule.span K {e', f'}))) := by
  have hcard := hexc.1
  have hn : finrank K V = 6 := by
    have := LinearMap.BilinForm.IsAlt.finrank_orthogonal_span_pair_add_two Q.isAlt_polarBilin
      (polarBilin_apply_eq_one_of_polar_eq_one hef)
    have := hexc.2.1
    omega
  obtain ⟨s₁, s₂, hes₁, hfs₁, hes₂, hfs₂, hQs₁, hQs₂, hs₁s₂, hli⟩ :=
    exists_singular_pair_of_exc hef hexc
  obtain ⟨s₁', s₂', hQs₁', hQs₂', hes₁', hfs₁', hes₂', hfs₂', hs₁s₁', hs₂s₁', hs₁s₂', hs₂s₂',
    hs₁'s₂'⟩ := exists_hyperbolic_partners hB hes₁ hfs₁ hes₂ hfs₂ hQs₁ hQs₂ hs₁s₂ hli
  refine ⟨e, f + s₁ + s₁', he, by rw [polar_add_right, polar_add_right, hef, hes₁, hes₁',
    add_zero, add_zero], ?_⟩
  exact not_exc_orthogonal_span_pair_add hB hcard hn (x := ![e, s₁, s₂])
    (y := ![f, s₁', s₂'])
    (fun i j ↦ by
      fin_cases i <;> fin_cases j <;> simp [hef, hes₁', hes₂', polar_comm (⇑Q) s₁ f, hfs₁,
        hs₁s₁', hs₁s₂', polar_comm (⇑Q) s₂ f, hfs₂, hs₂s₁', hs₂s₂'])
    (fun i j ↦ by
      fin_cases i <;> fin_cases j <;> simp [polar_self_eq_zero_of_charTwo Q, hes₁,
        hes₂, polar_comm (⇑Q) s₁ e, polar_comm (⇑Q) s₂ e, polar_comm (⇑Q) s₂ s₁, hs₁s₂])
    (fun i j ↦ by
      fin_cases i <;> fin_cases j <;> simp [polar_self_eq_zero_of_charTwo Q, hfs₁',
        hfs₂', polar_comm (⇑Q) s₁' f, polar_comm (⇑Q) s₂' f, polar_comm (⇑Q) s₂' s₁', hs₁'s₂'])
    (by simpa using (natCard_eq_two_iff_forall_eq_zero_or_eq_one.mp hcard _).resolve_left he)
    hQs₁ hQs₂ hQs₁' hQs₂'

/-- A frame `(e, f)` whose polar orthogonal complement is not exceptional. -/
private theorem exists_frame_not_exc [FiniteDimensional K V] [Nontrivial V]
    {Q : QuadraticForm K V} (hB : Q.polarBilin.Nondegenerate) :
    ∃ e f : V, Q e ≠ 0 ∧ polar Q e f = 1 ∧
      ¬ Exc (Q.restrict
        (LinearMap.BilinForm.orthogonal Q.polarBilin (Submodule.span K {e, f}))) := by
  obtain ⟨e, f, he, hef⟩ := exists_frame hB
  by_cases hexc : Exc (Q.restrict
      (LinearMap.BilinForm.orthogonal Q.polarBilin (Submodule.span K {e, f})))
  · exact exists_frame_not_exc_of_exc hB he hef hexc
  · exact ⟨e, f, he, hef, hexc⟩

/-- **Dieudonné's theorem in characteristic two**, by induction on the dimension. -/
private theorem eq_top_of_finrank_eq (n : ℕ) :
    ∀ {W : Type v} [AddCommGroup W] [Module K W] [FiniteDimensional K W],
      finrank K W = n → ∀ (Q : QuadraticForm K W), Q.polarBilin.Nondegenerate → ¬ Exc Q →
        ∀ H : Subgroup (orthogonalGroup Q), (∀ a ha, tv Q a ha ∈ H) → H = ⊤ := by
  induction n using Nat.strong_induction_on with
  | ind n ih =>
    intro W _ _ _ hn Q hB hexc H hH
    rw [Subgroup.eq_top_iff']
    intro g
    rcases subsingleton_or_nontrivial W with hW | hW
    · convert H.one_mem
      exact Subtype.ext (LinearEquiv.ext fun x ↦ Subsingleton.elim _ _)
    obtain ⟨e, f, he, hef, hexc'⟩ := exists_frame_not_exc hB
    have hge : Q ((g : W ≃ₗ[K] W) e) = Q e := map_app_of_mem_orthogonalGroup g.property e
    obtain ⟨h₁, hh₁, hh₁e⟩ := exists_mem_apply_eq H hH
      (fun x y hxy hx hp hne ↦ exists_good hB hexc hxy hx hp hne) hge (by rwa [hge])
    have hg₁e : ((h₁ * g : orthogonalGroup Q) : W ≃ₗ[K] W) e = e := by
      rw [orthogonalGroup.coe_mul_apply, hh₁e]
    have hg₁f : polar Q e (((h₁ * g : orthogonalGroup Q) : W ≃ₗ[K] W) f) = 1 := by
      conv_lhs => rw [← hg₁e]
      rw [polar_apply_of_mem_orthogonalGroup (h₁ * g).property, hef]
    obtain ⟨h₂, hh₂, hh₂e, hh₂f⟩ := exists_mem_fix_apply_eq H hH he hef hg₁f
      (map_app_of_mem_orthogonalGroup (h₁ * g).property f)
    have hdim := LinearMap.BilinForm.IsAlt.finrank_orthogonal_span_pair_add_two Q.isAlt_polarBilin
      (polarBilin_apply_eq_one_of_polar_eq_one hef)
    have hnd : (Q.restrict (LinearMap.BilinForm.orthogonal Q.polarBilin
        (Submodule.span K {e, f}))).polarBilin.Nondegenerate := by
      rw [polarBilin_restrict]
      exact LinearMap.BilinForm.IsAlt.restrict_nondegenerate_orthogonal_span_pair
        Q.isAlt_polarBilin (polarBilin_apply_eq_one_of_polar_eq_one hef) hB
    have hmem : h₂ * (h₁ * g) ∈ H := by
      refine mem_of_apply_eq_self hef (fun H' hH' ↦ ih _ (by omega) rfl _ hnd hexc' H' hH') H hH
        _ ?_ ?_
      · rw [orthogonalGroup.coe_mul_apply, hg₁e, hh₂e]
      · rw [orthogonalGroup.coe_mul_apply, hh₂f]
    have hg : g = h₁⁻¹ * (h₂⁻¹ * (h₂ * (h₁ * g))) := by group
    rw [hg]
    exact H.mul_mem (H.inv_mem hh₁) (H.mul_mem (H.inv_mem hh₂) hmem)

end Induction

/-- **Dieudonné's theorem.** Let `Q` be a quadratic form on a finite-dimensional vector space whose
polar form is nondegenerate, and which is not isometric to the orthogonal sum of two hyperbolic
planes over a field with two elements. Then any subgroup of the orthogonal group of `Q` containing
every reflection `reflectionOrthogonal Q v` in a vector of invertible norm is the whole orthogonal
group. In characteristic two these reflections are the orthogonal transvections
`x ↦ x + (polar Q v x / Q v) • v`; in characteristic different from two this is the
Cartan--Dieudonné theorem `subgroup_eq_top_of_reflection_mem`. -/
theorem subgroup_eq_top_of_reflection_mem_of_nondegenerate_polarBilin [FiniteDimensional K V]
    (Q : QuadraticForm K V) (hQ : Q.polarBilin.Nondegenerate)
    (hexc : Nat.card K = 2 →
      ¬ Q.Equivalent (QuadraticMap.pi fun _ : Fin 2 ↦ binaryQuadraticForm K 0 0))
    (H : Subgroup (orthogonalGroup Q))
    (hreflection : ∀ (v : V) [Invertible (Q v)], reflectionOrthogonal Q v ∈ H) :
    H = ⊤ := by
  by_cases h2 : (2 : K) = 0
  · have : CharP K 2 := CharTwo.of_one_ne_zero_of_two_eq_zero one_ne_zero h2
    refine eq_top_of_finrank_eq _ rfl Q hQ ?_ H fun a ha ↦ ?_
    · rintro ⟨hcard, hdim, U, hU, hU2⟩
      exact hexc hcard
        ((equivalent_pi_binaryQuadraticForm_zero_iff_exists_isTotallyIsotropic_finrank_eq hQ
          (by omega)).mpr ⟨U, hU, hU2⟩)
    · let _ := invertibleOfNonzero ha
      exact hreflection a
  · have : NeZero (2 : K) := ⟨h2⟩
    let _ := invertibleOfNonzero h2
    exact subgroup_eq_top_of_reflection_mem Q (nondegenerate_polar_iff.mp hQ) H hreflection

end TauCeti.QuadraticMap
