module

public import Mathlib.LinearAlgebra.QuadraticForm.Radical
public import TauCeti.Algebra.Module.Torsion.Int
import TauCeti.LinearAlgebra.QuadraticForm.Basic
import Mathlib.Algebra.CharP.Two

/-!
# Reduction of integral quadratic forms modulo two

An integral quadratic form `Q` on an abelian group `M` reduces to a quadratic form `Q₂` over the
field `ZMod 2` on the `ZMod 2`-vector space `M ⧸ 2M`, by `Q₂ (x mod 2) = Q x mod 2`. This is well
defined because `Q (x + 2y) = Q x + 2 B(x, y) + 4 Q y`, where `B` is the polar form of `Q`, and
the polar form of `Q₂` is `B` modulo two. Since `Q` is the integral form itself rather than half
of `B(x, x)`, nothing here inverts two: in characteristic two `Q₂` carries information that its
polar form, an alternating form, does not.

When the polar form `B` of `Q` is a perfect pairing, for instance for the half-norm form of an even
unimodular lattice, the polar form of `Q₂` is nondegenerate, so `Q₂` is a nonsingular quadratic
form in characteristic two. Orthogonal groups of such forms are generated by orthogonal
transvections, which is how the isometries of an even unimodular lattice reach the orthogonal
group of its reduction modulo two.

## Main declarations

* `QuadraticForm.reduceModTwo Q`: the reduction `Q₂` of `Q` modulo two, characterized by
  `QuadraticForm.reduceModTwo_mk`.
* `QuadraticForm.polar_reduceModTwo_mk`: the polar form of `Q₂` is the polar form of `Q` modulo
  two.
* `QuadraticForm.nondegenerate_polarBilin_reduceModTwo`: if the polar form of `Q` identifies `M`
  with its dual, then the polar form of `Q₂` is nondegenerate.

## References

* J. Milnor and D. Husemoller, *Symmetric Bilinear Forms*, Chapter II, §5.
* V. V. Nikulin, *Integral symmetric bilinear forms and some of their applications*, §1.
-/

public section

open scoped Pointwise

namespace QuadraticForm

variable {M : Type*} [AddCommGroup M] (Q : QuadraticForm ℤ M)

/-- The integral form `Q` with its values reduced modulo two, before passing to `M ⧸ 2M`. -/
private noncomputable def castModTwo : QuadraticMap ℤ M (ZMod 2) :=
  (Int.castAddHom (ZMod 2)).toIntLinearMap.compQuadraticMap Q

/-- Twice every vector lies in the radical of `Q` modulo two, so `Q` modulo two descends to
`M ⧸ 2M`. -/
private theorem smul_top_le_radical_castModTwo :
    (2 : ℤ) • (⊤ : Submodule ℤ M) ≤ (castModTwo Q).radical := by
  intro z hz
  obtain ⟨w, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hz
  refine ⟨?_, LinearMap.ext fun y ↦ ?_⟩
  · simp only [castModTwo, LinearMap.compQuadraticMap_apply, QuadraticMap.map_smul]
    rw [mul_smul, CharTwo.two_zsmul]
  · simp only [castModTwo, QuadraticMap.polarBilin_apply_apply, LinearMap.zero_apply,
      QuadraticMap.polar_smul_left, CharTwo.two_zsmul]

/-- `Q` modulo two as a `ℤ`-quadratic map on `M ⧸ 2M`. -/
private noncomputable def liftModTwo : QuadraticMap ℤ (QuotSMulTop (2 : ℤ) M) (ZMod 2) :=
  (castModTwo Q).lift _ (smul_top_le_radical_castModTwo Q)

/-- **The reduction of an integral quadratic form modulo two**: the quadratic form
`x mod 2 ↦ Q x mod 2` over `ZMod 2` on `M ⧸ 2M`. -/
noncomputable def reduceModTwo : QuadraticForm (ZMod 2) (QuotSMulTop (2 : ℤ) M) where
  toFun := liftModTwo Q
  toFun_smul a x := by
    obtain ⟨k, rfl⟩ := ZMod.intCast_surjective a
    rw [Int.cast_smul_eq_zsmul, QuadraticMap.map_smul, smul_eq_mul, zsmul_eq_mul, Int.cast_mul]
  exists_companion' := by
    refine ⟨LinearMap.mk₂ (ZMod 2) (QuadraticMap.polar (liftModTwo Q))
      (QuadraticMap.polar_add_left _) (fun a x y ↦ ?_) (QuadraticMap.polar_add_right _)
      (fun a x y ↦ ?_), fun x y ↦ ?_⟩
    · obtain ⟨k, rfl⟩ := ZMod.intCast_surjective a
      rw [Int.cast_smul_eq_zsmul, QuadraticMap.polar_smul_left, smul_eq_mul, zsmul_eq_mul]
    · obtain ⟨k, rfl⟩ := ZMod.intCast_surjective a
      rw [Int.cast_smul_eq_zsmul, QuadraticMap.polar_smul_right, smul_eq_mul, zsmul_eq_mul]
    · rw [LinearMap.mk₂_apply, QuadraticMap.polar]
      abel

/-- The reduction of `Q` modulo two takes the value `Q x mod 2` at the class of `x`. -/
@[simp]
theorem reduceModTwo_mk (x : M) :
    Q.reduceModTwo (Submodule.Quotient.mk x) = (Q x : ZMod 2) :=
  (rfl)

/-- The polar form of the reduction of `Q` modulo two is the polar form of `Q` modulo two. -/
@[simp]
theorem polar_reduceModTwo_mk (x y : M) :
    QuadraticMap.polar Q.reduceModTwo (Submodule.Quotient.mk x) (Submodule.Quotient.mk y) =
      ((QuadraticMap.polar Q x y : ℤ) : ZMod 2) := by
  simp [QuadraticMap.polar, ← Submodule.Quotient.mk_add]

/-- The linear form `y ↦ B(x, y) / 2`, for `x` whose polar pairings `B(x, y)` are all even. -/
private def halfPolar {x : M} (hx : ∀ y, (2 : ℤ) ∣ QuadraticMap.polar Q x y) :
    Module.Dual ℤ M where
  toFun y := QuadraticMap.polar Q x y / 2
  map_add' y z := by
    rw [QuadraticMap.polar_add_right, Int.add_ediv_of_dvd_left (hx y)]
  map_smul' k y := by
    rw [QuadraticMap.polar_smul_right, smul_eq_mul, smul_eq_mul, RingHom.id_apply,
      Int.mul_ediv_assoc _ (hx y)]

/-- **Nonsingularity of the reduction modulo two.** If the polar form of an integral quadratic
form `Q` identifies `M` with its `ℤ`-dual, as for the half-norm form of an even unimodular lattice,
then the polar form of its reduction modulo two is nondegenerate. -/
theorem nondegenerate_polarBilin_reduceModTwo (hQ : Function.Bijective Q.polarBilin) :
    Q.reduceModTwo.polarBilin.Nondegenerate := by
  rw [LinearMap.IsRefl.nondegenerate_iff_separatingLeft (B := Q.reduceModTwo.polarBilin)
    (QuadraticMap.isSymm_polarBilin _).isRefl]
  intro c hc
  induction c using Submodule.Quotient.induction_on with
  | _ x =>
    -- Every pairing `B(x, y)` is even, so `B(x, ·) = 2 B(z, ·)` for some `z`, and `x = 2 z`.
    have hx (y : M) : (2 : ℤ) ∣ QuadraticMap.polar Q x y := by
      have h := (ZMod.intCast_zmod_eq_zero_iff_dvd (QuadraticMap.polar Q x y) 2).mp <| by
        rw [← polar_reduceModTwo_mk]
        exact hc (Submodule.Quotient.mk y)
      exact_mod_cast h
    obtain ⟨z, hz⟩ := hQ.2 (halfPolar Q hx)
    have hxz : x = (2 : ℤ) • z := hQ.1 <| LinearMap.ext fun y ↦ by
      rw [map_smul, hz, LinearMap.smul_apply, QuadraticMap.polarBilin_apply_apply]
      exact (Int.mul_ediv_cancel' (hx y)).symm
    rw [Submodule.Quotient.mk_eq_zero, hxz]
    exact Submodule.smul_mem_pointwise_smul _ _ _ Submodule.mem_top

end QuadraticForm
