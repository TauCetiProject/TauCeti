module

public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.RingTheory.Ideal.Span
public import TauCeti.LinearAlgebra.QuadraticForm.Witt.Ring

/-!
# The fundamental ideal of the Witt ring

The **fundamental ideal** `I(K)` of the Witt ring is the kernel of dimension modulo two. Thus a
Witt class belongs to `I(K)` precisely when it has an even-dimensional representative.

This file also gives the first generation theorem for the fundamental filtration. The additive
group of `I(K)` is generated by the one-fold Pfister classes
`⟨⟨a⟩⟩ = ⟨1, -a⟩`. In particular these classes generate `I(K)` as an ideal.

## Main definitions

* `TauCeti.fundamentalIdeal`: the kernel of `WittRing.dimMod2`.
* `TauCeti.oneFoldPfisterClass`: the Witt class of `⟨1, -a⟩`.

## Main results

* `TauCeti.wittClass_mem_fundamentalIdeal_iff`: a form has class in the fundamental ideal if and
  only if its rank is even.
* `TauCeti.mem_fundamentalIdeal_iff_exists_evenRank`: every element of the fundamental ideal is
  represented by an even-dimensional form.
* `TauCeti.fundamentalIdeal_toAddSubgroup_eq_closure_oneFoldPfisterClass`: the one-fold Pfister
  classes generate the additive group of the fundamental ideal.
* `TauCeti.fundamentalIdeal_eq_span_oneFoldPfisterClass`: the one-fold Pfister classes generate the
  fundamental ideal as an ideal.

## References

* T. Y. Lam, *Introduction to Quadratic Forms over Fields* (2005), Chapter II, §1.
-/

public section

open QuadraticMap QuadraticForm

namespace TauCeti

universe u

variable {K : Type u} [Field K] [Invertible (2 : K)]

/-! ### The fundamental ideal -/

/-- The **fundamental ideal** `I(K)` of the Witt ring: the kernel of dimension modulo two. -/
noncomputable def fundamentalIdeal (K : Type u) [Field K] [Invertible (2 : K)] :
    Ideal (WittRing K) :=
  RingHom.ker (WittRing.dimMod2 (K := K))

/-- Membership in the fundamental ideal means that dimension modulo two vanishes. -/
@[simp]
theorem mem_fundamentalIdeal_iff {x : WittRing K} :
    x ∈ fundamentalIdeal K ↔ WittRing.dimMod2 x = 0 := by
  rw [fundamentalIdeal, RingHom.mem_ker]

/-- The Witt class of a regular form belongs to the fundamental ideal exactly when its rank is
even. -/
theorem wittClass_mem_fundamentalIdeal_iff (x : RegularFormClass K) :
    wittClass x ∈ fundamentalIdeal K ↔ Even (RegularFormClass.rank x) := by
  rw [mem_fundamentalIdeal_iff, WittRing.dimMod2_wittClass,
    ZMod.natCast_eq_zero_iff_even]

/-- Every element of the fundamental ideal has an even-dimensional representative, and every
even-dimensional representative determines an element of the fundamental ideal. -/
theorem mem_fundamentalIdeal_iff_exists_evenRank {x : WittRing K} :
    x ∈ fundamentalIdeal K ↔
      ∃ q : RegularFormClass K, Even (RegularFormClass.rank q) ∧ wittClass q = x := by
  constructor
  · intro hx
    obtain ⟨q, rfl⟩ := wittClass_surjective x
    exact ⟨q, wittClass_mem_fundamentalIdeal_iff q |>.mp hx, rfl⟩
  · rintro ⟨q, hq, rfl⟩
    exact (wittClass_mem_fundamentalIdeal_iff q).mpr hq

/-! ### One-fold Pfister classes -/

/-- The one-fold Pfister class `⟨⟨a⟩⟩ = ⟨1, -a⟩` in the Witt ring. This definition fixes the
minus-sign convention used for Pfister forms. -/
noncomputable def oneFoldPfisterClass (a : Kˣ) : WittRing K :=
  wittClass (1 + Quotient.mk (regularFormSetoid K) ⟨1, fun _ => -a⟩)

/-- A one-fold Pfister class is the sum of the unit class `⟨1⟩` and the rank-one class `⟨-a⟩`. -/
theorem oneFoldPfisterClass_eq (a : Kˣ) :
    oneFoldPfisterClass a =
      1 + wittClass (Quotient.mk (regularFormSetoid K) ⟨1, fun _ => -a⟩) := by
  rw [oneFoldPfisterClass, map_add, map_one]

/-- Every one-fold Pfister class has even dimension. -/
@[simp]
theorem WittRing.dimMod2_oneFoldPfisterClass (a : Kˣ) :
    WittRing.dimMod2 (oneFoldPfisterClass a) = 0 := by
  rw [oneFoldPfisterClass, WittRing.dimMod2_wittClass, RegularFormClass.rank_add,
    RegularFormClass.rank_one, RegularFormClass.rank_mk]
  exact ZMod.natCast_self 2

/-- Every one-fold Pfister class belongs to the fundamental ideal. -/
theorem oneFoldPfisterClass_mem_fundamentalIdeal (a : Kˣ) :
    oneFoldPfisterClass a ∈ fundamentalIdeal K := by
  rw [mem_fundamentalIdeal_iff, WittRing.dimMod2_oneFoldPfisterClass]

/-- A rank-one class is a one-fold Pfister class minus `⟨1⟩`. -/
theorem wittClass_rankOne_eq_oneFoldPfisterClass_sub (a : Kˣ) :
    wittClass (Quotient.mk (regularFormSetoid K) ⟨1, fun _ => a⟩) =
      oneFoldPfisterClass (-a) - 1 := by
  rw [oneFoldPfisterClass_eq]
  simp only [neg_neg]
  abel

/-- In the Witt ring `⟨-a⟩ = -⟨a⟩`, because `⟨a, -a⟩` is a hyperbolic plane. -/
theorem wittClass_rankOne_neg (a : Kˣ) :
    wittClass (Quotient.mk (regularFormSetoid K) ⟨1, fun _ => -a⟩) =
      -wittClass (Quotient.mk (regularFormSetoid K) ⟨1, fun _ => a⟩) := by
  rw [eq_neg_iff_add_eq_zero, add_comm, ← map_add, ← neg_one_mul a,
    ← RegularFormClass.mk_rankOne_mul_mk_rankOne, RegularFormClass.mk_rankOne_add_neg_one_mul,
    wittClass_hyperbolicClass]

/-- **The one-fold Pfister class of a product**: `⟨⟨ab⟩⟩ = ⟨⟨a⟩⟩ + ⟨⟨b⟩⟩ - ⟨⟨a⟩⟩⟨⟨b⟩⟩`, that is
`⟨⟨a⟩⟩ + ⟨⟨b⟩⟩ = ⟨⟨ab⟩⟩ + ⟨⟨a, b⟩⟩` in the Witt ring. -/
theorem oneFoldPfisterClass_mul (a b : Kˣ) :
    oneFoldPfisterClass (a * b) =
      oneFoldPfisterClass a + oneFoldPfisterClass b -
        oneFoldPfisterClass a * oneFoldPfisterClass b := by
  have hab : wittClass (Quotient.mk (regularFormSetoid K) ⟨1, fun _ => -a⟩) *
      wittClass (Quotient.mk (regularFormSetoid K) ⟨1, fun _ => -b⟩) =
        -wittClass (Quotient.mk (regularFormSetoid K) ⟨1, fun _ => -(a * b)⟩) := by
    rw [← map_mul, RegularFormClass.mk_rankOne_mul_mk_rankOne, wittClass_rankOne_neg,
      neg_mul_neg, neg_neg]
  simp only [oneFoldPfisterClass_eq, add_mul, mul_add, one_mul, mul_one, hab]
  abel

/-- The one-fold Pfister class `⟨⟨-1⟩⟩` is two copies of `⟨1⟩`. -/
theorem oneFoldPfisterClass_neg_one :
    oneFoldPfisterClass (-1 : Kˣ) = 2 • (1 : WittRing K) := by
  rw [oneFoldPfisterClass, neg_neg, RegularFormClass.mk_rankOne_one, ← two_nsmul, map_nsmul,
    map_one]

/-- The one-fold Pfister class `⟨⟨1⟩⟩ = ⟨1, -1⟩` is hyperbolic, hence zero in the Witt ring. -/
@[simp]
theorem oneFoldPfisterClass_one : oneFoldPfisterClass (1 : Kˣ) = 0 := by
  have h := RegularFormClass.mk_rankOne_add_neg_one_mul (K := K) (1 : Kˣ)
  rw [RegularFormClass.mk_rankOne_one, mul_one] at h
  rw [oneFoldPfisterClass, h, wittClass_hyperbolicClass]

/-! ### Additive generation -/

private theorem wittClass_sub_rank_smul_mem_closure (q : RegularFormClass K) :
    wittClass q - RegularFormClass.rank q • (1 : WittRing K) ∈
      AddSubgroup.closure (Set.range (oneFoldPfisterClass (K := K))) := by
  induction q using RegularFormClass.induction_on_rankOne with
  | zero => simp
  | add_rankOne q a ih =>
    rw [map_add, RegularFormClass.rank_add, RegularFormClass.rank_mk, add_nsmul, one_nsmul,
      wittClass_rankOne_eq_oneFoldPfisterClass_sub]
    have ha : oneFoldPfisterClass (-a) ∈
        AddSubgroup.closure (Set.range (oneFoldPfisterClass (K := K))) :=
      AddSubgroup.subset_closure (Set.mem_range_self (-a))
    have hone : oneFoldPfisterClass (-1 : Kˣ) ∈
        AddSubgroup.closure (Set.range (oneFoldPfisterClass (K := K))) :=
      AddSubgroup.subset_closure (Set.mem_range_self (-1 : Kˣ))
    rw [oneFoldPfisterClass_neg_one] at hone
    have hmem := sub_mem (add_mem ih ha) hone
    convert hmem using 1
    · abel

private theorem rank_smul_mem_closure_of_even (q : RegularFormClass K)
    (hq : Even (RegularFormClass.rank q)) :
    RegularFormClass.rank q • (1 : WittRing K) ∈
      AddSubgroup.closure (Set.range (oneFoldPfisterClass (K := K))) := by
  obtain ⟨n, hn⟩ := hq
  have hgenerator : oneFoldPfisterClass (-1 : Kˣ) ∈
      AddSubgroup.closure (Set.range (oneFoldPfisterClass (K := K))) :=
    AddSubgroup.subset_closure (Set.mem_range_self (-1 : Kˣ))
  rw [hn, add_nsmul, ← nsmul_add, ← two_nsmul, ← oneFoldPfisterClass_neg_one]
  exact nsmul_mem hgenerator n

/-- The additive group of the fundamental ideal is the subgroup generated by the one-fold Pfister
classes `⟨⟨a⟩⟩`. This is the additive generation statement needed for homomorphisms defined on the
fundamental filtration. -/
theorem fundamentalIdeal_toAddSubgroup_eq_closure_oneFoldPfisterClass :
    (fundamentalIdeal K).toAddSubgroup =
      AddSubgroup.closure (Set.range (oneFoldPfisterClass (K := K))) := by
  ext x
  constructor
  · intro hx
    obtain ⟨q, hq, rfl⟩ := mem_fundamentalIdeal_iff_exists_evenRank.mp hx
    exact sub_add_cancel (wittClass q) (RegularFormClass.rank q • (1 : WittRing K)) ▸
      add_mem (wittClass_sub_rank_smul_mem_closure q)
        (rank_smul_mem_closure_of_even q hq)
  · intro hx
    exact ((AddSubgroup.closure_le (K := (fundamentalIdeal K).toAddSubgroup)).mpr fun _ h => by
      obtain ⟨a, rfl⟩ := h
      exact oneFoldPfisterClass_mem_fundamentalIdeal a) hx

/-- The one-fold Pfister classes generate the fundamental ideal as an ideal. The stronger
additive-generation theorem is
`TauCeti.fundamentalIdeal_toAddSubgroup_eq_closure_oneFoldPfisterClass`. -/
theorem fundamentalIdeal_eq_span_oneFoldPfisterClass :
    fundamentalIdeal K = Ideal.span (Set.range (oneFoldPfisterClass (K := K))) := by
  apply le_antisymm
  · intro x hx
    have hx' : x ∈ AddSubgroup.closure (Set.range (oneFoldPfisterClass (K := K))) := by
      rw [← fundamentalIdeal_toAddSubgroup_eq_closure_oneFoldPfisterClass]
      exact hx
    exact ((AddSubgroup.closure_le
      (K := (Ideal.span (Set.range (oneFoldPfisterClass (K := K)))).toAddSubgroup)).mpr
        fun _ h => Ideal.subset_span h) hx'
  · rw [Ideal.span_le]
    rintro _ ⟨a, rfl⟩
    exact oneFoldPfisterClass_mem_fundamentalIdeal a

end TauCeti
