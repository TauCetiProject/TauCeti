module

public import TauCeti.LinearAlgebra.QuadraticForm.Witt.Discriminant
import Mathlib.Tactic.NormNum.IsSquare

/-!
# Integer multiples of `⟨1⟩` in the Witt ring

The integer multiples of the unit class `⟨1⟩` form the cyclic subgroup of the Witt ring `W(K)`
generated by `1`. A rank-one class `⟨a⟩` lies in it exactly when `a` or `-a` is a square. The
classes `⟨1⟩` and `⟨-1⟩ = -⟨1⟩` lie in it. Conversely, if `⟨a⟩ = n⟨1⟩` then `n` is odd, so
`⟨⟨-a⟩⟩ = ⟨1⟩ - ⟨a⟩` is an integer multiple of `⟨⟨-1⟩⟩ = 2⟨1⟩`. The signed discriminant, which is
semilinear on the fundamental ideal, then puts `-a` in the square class of `1` or of `-1`. As the
rank-one classes generate `W(K)` additively, `W(K)` is generated by `⟨1⟩` as an additive group
exactly when every unit is a square up to sign.

Over `ℚ` neither `2` nor `-2` is a square, so `⟨2⟩` is not an integer multiple of `⟨1⟩` in
`W(ℚ)`. Since `I(K)⁰ = W(K)` and the only zero-fold Pfister class is `⟨1⟩`, this shows that the
additive generation of `I(K)ⁿ` by the `n`-fold Pfister classes,
`TauCeti.fundamentalIdeal_pow_eq_addClosure`, fails at `n = 0`.

## Main results

* `TauCeti.wittClass_rankOne_mem_zmultiples_one_iff`: `⟨a⟩` is an integer multiple of `⟨1⟩`
  exactly when `a` or `-a` is a square.
* `TauCeti.WittRing.zmultiples_one_eq_top_iff`: `W(K)` is generated by `⟨1⟩` as an additive
  group exactly when every unit is a square up to sign.
* `TauCeti.wittClass_rankOne_two_not_mem_zmultiples_one`: `⟨2⟩` is not an integer multiple of
  `⟨1⟩` in `W(ℚ)`.
* `TauCeti.fundamentalIdeal_pow_zero_ne_addClosure`: over `ℚ`, `I⁰` is not additively generated by
  the zero-fold Pfister classes.

## References

* T. Y. Lam, *Introduction to Quadratic Forms over Fields*, Chapter II, §2.
-/

public section

namespace TauCeti

variable {K : Type*} [Field K] [Invertible (2 : K)]

/-- **Rank-one integer multiples of `⟨1⟩`**: in the Witt ring, `⟨a⟩` is an integer multiple of
`⟨1⟩` exactly when `a` or `-a` is a square, that is when `⟨a⟩` is `⟨1⟩` or `⟨-1⟩`. -/
theorem wittClass_rankOne_mem_zmultiples_one_iff (a : Kˣ) :
    wittClass (Quotient.mk (regularFormSetoid K) ⟨1, fun _ => a⟩) ∈
        AddSubgroup.zmultiples (1 : WittRing K) ↔ IsSquare a ∨ IsSquare (-a) := by
  rw [AddSubgroup.mem_zmultiples_iff]
  constructor
  · rintro ⟨n, hn⟩
    rw [wittClass_rankOne_eq_oneFoldPfisterClass_sub] at hn
    have h : oneFoldPfisterClass (-a) = (n + 1) • (1 : WittRing K) := by
      rw [add_zsmul, one_zsmul, hn, sub_add_cancel]
    -- `⟨⟨-a⟩⟩` has even rank, so `n + 1 = 2 m` and `⟨⟨-a⟩⟩ = m ⟨⟨-1⟩⟩`.
    obtain ⟨m, hm⟩ : (2 : ℤ) ∣ n + 1 := by
      have hdim := congrArg WittRing.dimMod2 h
      rw [WittRing.dimMod2_oneFoldPfisterClass, map_zsmul, map_one, zsmul_one] at hdim
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ 2).mp hdim.symm
    have hm' : oneFoldPfisterClass (-a) = (m : WittRing K) * oneFoldPfisterClass (-1 : Kˣ) := by
      rw [h, hm, oneFoldPfisterClass_neg_one, mul_zsmul, zsmul_eq_mul, nsmul_eq_mul]
      push_cast
      ring
    have hd := congrArg WittRing.signedDiscr hm'
    rw [WittRing.signedDiscr_mul_of_mem_fundamentalIdeal _
        (oneFoldPfisterClass_mem_fundamentalIdeal _),
      WittRing.signedDiscr_oneFoldPfisterClass, WittRing.signedDiscr_oneFoldPfisterClass,
      map_intCast] at hd
    rcases (show ∀ t : ZMod 2, t = 0 ∨ t = 1 by decide) (m : ZMod 2) with ht | ht
    · rw [ht, zero_smul, squareClass_eq_zero_iff] at hd
      exact Or.inr hd
    · rw [ht, one_smul, squareClass_eq_iff_isSquare_mul, neg_mul_neg, mul_one] at hd
      exact Or.inl hd
  · rintro (h | h)
    · refine ⟨1, ?_⟩
      rw [one_zsmul, ← neg_neg a, wittClass_rankOne_neg,
        wittClass_rankOne_eq_oneFoldPfisterClass_sub, neg_neg,
        oneFoldPfisterClass_eq_zero_iff.mpr h, zero_sub, neg_neg]
    · refine ⟨-1, ?_⟩
      rw [wittClass_rankOne_eq_oneFoldPfisterClass_sub, oneFoldPfisterClass_eq_zero_iff.mpr h,
        zero_sub, neg_one_zsmul]

/-- **When `⟨1⟩` generates the Witt ring**: `W(K)` is generated by `⟨1⟩` as an additive group
exactly when every unit is a square up to sign. -/
theorem WittRing.zmultiples_one_eq_top_iff :
    AddSubgroup.zmultiples (1 : WittRing K) = ⊤ ↔ ∀ a : Kˣ, IsSquare a ∨ IsSquare (-a) := by
  refine ⟨fun h a => (wittClass_rankOne_mem_zmultiples_one_iff a).mp (h ▸ AddSubgroup.mem_top _),
    fun h => eq_top_iff.mpr ?_⟩
  rintro x -
  obtain ⟨q, rfl⟩ := wittClass_surjective x
  induction q using RegularFormClass.induction_on_rankOne with
  | zero => exact map_zero (wittClass (K := K)) ▸ zero_mem _
  | add_rankOne y a ih =>
    rw [map_add]
    exact add_mem ih ((wittClass_rankOne_mem_zmultiples_one_iff a).mpr (h a))

/-! ### The rational Witt ring -/

/-- **`⟨2⟩` is not an integer multiple of `⟨1⟩` in `W(ℚ)`**, because neither `2` nor `-2` is a
rational square. -/
theorem wittClass_rankOne_two_not_mem_zmultiples_one :
    wittClass (Quotient.mk (regularFormSetoid ℚ) ⟨1, fun _ => Units.mk0 2 two_ne_zero⟩) ∉
      AddSubgroup.zmultiples (1 : WittRing ℚ) := by
  rw [wittClass_rankOne_mem_zmultiples_one_iff, ← Units.isSquare_coe_iff,
    ← Units.isSquare_coe_iff, Units.val_neg, Units.val_mk0]
  norm_num

/-- **Additive generation by Pfister classes fails in degree zero.** Over `ℚ`, `I⁰ = W(ℚ)` is not
generated as an additive group by the zero-fold Pfister classes, all of which equal `⟨1⟩`. So the
hypothesis `0 < n` of `TauCeti.fundamentalIdeal_pow_eq_addClosure` cannot be dropped. -/
theorem fundamentalIdeal_pow_zero_ne_addClosure :
    (fundamentalIdeal ℚ ^ 0).toAddSubgroup ≠
      AddSubgroup.closure (Set.range (pfisterClass (K := ℚ) (n := 0))) := by
  have hr : Set.range (pfisterClass (K := ℚ) (n := 0)) = {1} := by
    simp [pfisterClass_zero]
  rw [hr, ← AddSubgroup.zmultiples_eq_closure, pow_zero, Ideal.one_eq_top,
    Submodule.top_toAddSubgroup]
  exact fun h => wittClass_rankOne_two_not_mem_zmultiples_one (h ▸ AddSubgroup.mem_top _)

end TauCeti
