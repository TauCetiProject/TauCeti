/-!
# Divided-difference operators on a symmetric algebra

Let `σ` be a linear endomorphism of a module `M` over a commutative ring `R`, and let `ℓ ∈ M` be
such that `m - σ m` is a multiple of `ℓ` for every `m ∈ M`. Then for every `p` in the symmetric
algebra `Sym M`, the difference `p - σ p` is divisible by `ℓ`, where `σ` acts on `Sym M` by the
induced algebra endomorphism `SymmetricAlgebra.map R σ`. When `ℓ` is a nonzerodivisor of `Sym M`
the quotient is unique, which defines the *divided-difference operator*
`δ p = (p - σ p) / ℓ`.

The typical example is a pseudoreflection `s` of a vector space `V` acting on the polynomial
functions `Sym(V*)`, with `ℓ` a linear form cutting out the hyperplane fixed by `s`. The operator
`δ` is the basic tool of the proof that the invariants of a finite group generated by
pseudoreflections form a polynomial algebra.

The operator `δ` is `R`-linear and satisfies `ℓ * δ p = p - σ p`, so that
`1 - σ = m_ℓ ∘ δ` as operators on `Sym M`. It lowers degrees by one, it vanishes exactly on the
elements fixed by `σ`, it satisfies the twisted Leibniz rule
`δ (p * q) = δ p * q + σ p * δ q`, and consequently it is linear over the `σ`-fixed elements.

## Main definitions

* `SymmetricAlgebra.dividedDifference`: the divided-difference operator `p ↦ (p - σ p) / ℓ`.

## Main results

* `SymmetricAlgebra.ι_dvd_sub_map`: `ℓ` divides `p - σ p` for every `p ∈ Sym M`.
* `SymmetricAlgebra.ι_mul_dividedDifference` and
  `SymmetricAlgebra.mulLeft_comp_dividedDifference`: the operator identity `1 - σ = m_ℓ ∘ δ`.
* `SymmetricAlgebra.dividedDifference_eq_zero_iff`: `δ p = 0` exactly when `σ p = p`.
* `SymmetricAlgebra.dividedDifference_mul`: the twisted Leibniz rule.
* `SymmetricAlgebra.dividedDifference_mul_of_map_eq`: `δ` is linear over `σ`-fixed elements.
* `SymmetricAlgebra.dividedDifference_mem_homogeneousSubmodule`: `δ` lowers degrees by one.

## References

* R. Kane, *Reflection Groups and Invariant Theory*, CMS Books in Mathematics, Springer (2001),
  §§ 17–18.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), § 7.2.
-/

public section

namespace SymmetricAlgebra

open TauCeti.SymmetricAlgebra

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] {σ : M →ₗ[R] M} {ℓ : M}

/-- If `m - σ m` is a multiple of `ℓ` for every `m ∈ M`, then `ℓ` divides `p - σ p` for every `p`
in the symmetric algebra, where `σ` acts on `Sym M` by `SymmetricAlgebra.map`. -/
theorem ι_dvd_sub_map (hσ : ∀ m, m - σ m ∈ R ∙ ℓ) (p : SymmetricAlgebra R M) :
    ι R M ℓ ∣ p - map R σ p := by
  induction p using SymmetricAlgebra.induction with
  | algebraMap r => simp
  | ι m =>
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.1 (hσ m)
    exact ⟨algebraMap R _ c, by
      rw [map_apply_ι, ← map_sub, ← hc, map_smul, Algebra.smul_def, mul_comm]⟩
  | mul p q hp hq =>
    have h : p * q - map R σ (p * q) = (p - map R σ p) * q + map R σ p * (q - map R σ q) := by
      rw [map_mul]
      ring
    rw [h]
    exact dvd_add (dvd_mul_of_dvd_left hp q) (dvd_mul_of_dvd_right hq _)
  | add p q hp hq =>
    rw [map_add, add_sub_add_comm]
    exact dvd_add hp hq

/-- A nonzero element of a free module over a domain is a nonzerodivisor in the symmetric
algebra. -/
theorem isLeftRegular_ι [IsDomain R] [Module.Free R M] (hℓ : ℓ ≠ 0) :
    IsLeftRegular (ι R M ℓ) :=
  IsLeftCancelMulZero.mul_left_cancel_of_ne_zero <| (map_ne_zero_iff _ (ι_injective R M)).2 hℓ

variable (σ ℓ) in
/-- The **divided-difference operator** `p ↦ (p - σ p) / ℓ` on the symmetric algebra, for a linear
endomorphism `σ` of `M` such that `m - σ m` is a multiple of `ℓ` for every `m`, and an element
`ℓ` that is a nonzerodivisor in `Sym M`. It is characterized by
`ι ℓ * dividedDifference σ ℓ hσ hℓ p = p - σ p` (`SymmetricAlgebra.dividedDifference_eq_iff`). -/
noncomputable def dividedDifference (hσ : ∀ m, m - σ m ∈ R ∙ ℓ) (hℓ : IsLeftRegular (ι R M ℓ)) :
    SymmetricAlgebra R M →ₗ[R] SymmetricAlgebra R M where
  toFun p := (ι_dvd_sub_map hσ p).choose
  map_add' p q := hℓ <| by
    beta_reduce
    rw [mul_add, ← (ι_dvd_sub_map hσ (p + q)).choose_spec, ← (ι_dvd_sub_map hσ p).choose_spec,
      ← (ι_dvd_sub_map hσ q).choose_spec, map_add]
    abel
  map_smul' r p := hℓ <| by
    beta_reduce
    rw [RingHom.id_apply, mul_smul_comm, ← (ι_dvd_sub_map hσ (r • p)).choose_spec,
      ← (ι_dvd_sub_map hσ p).choose_spec, map_smul, smul_sub]

variable {hσ : ∀ m, m - σ m ∈ R ∙ ℓ} {hℓ : IsLeftRegular (ι R M ℓ)}

/-- The defining identity of the divided-difference operator: `ℓ * δ p = p - σ p`. -/
@[simp]
theorem ι_mul_dividedDifference (p : SymmetricAlgebra R M) :
    ι R M ℓ * dividedDifference σ ℓ hσ hℓ p = p - map R σ p :=
  (ι_dvd_sub_map hσ p).choose_spec.symm

/-- The divided difference of `p` is the unique `q` with `ℓ * q = p - σ p`. -/
theorem dividedDifference_eq_iff {p q : SymmetricAlgebra R M} :
    dividedDifference σ ℓ hσ hℓ p = q ↔ ι R M ℓ * q = p - map R σ p := by
  refine ⟨fun h ↦ h ▸ ι_mul_dividedDifference p, fun h ↦ hℓ ?_⟩
  beta_reduce
  rw [ι_mul_dividedDifference, h]

/-- **The operator identity** `1 - σ = m_ℓ ∘ δ` on the symmetric algebra. -/
theorem mulLeft_comp_dividedDifference :
    LinearMap.mulLeft R (ι R M ℓ) ∘ₗ dividedDifference σ ℓ hσ hℓ =
      LinearMap.id - (map R σ).toLinearMap :=
  LinearMap.ext fun p ↦ ι_mul_dividedDifference p

/-- The divided difference of `p` vanishes exactly when `σ` fixes `p`. -/
@[simp]
theorem dividedDifference_eq_zero_iff {p : SymmetricAlgebra R M} :
    dividedDifference σ ℓ hσ hℓ p = 0 ↔ map R σ p = p := by
  rw [dividedDifference_eq_iff, mul_zero, eq_comm, sub_eq_zero, eq_comm]

/-- The divided difference of a scalar vanishes. -/
@[simp]
theorem dividedDifference_algebraMap (r : R) :
    dividedDifference σ ℓ hσ hℓ (algebraMap R (SymmetricAlgebra R M) r) = 0 :=
  dividedDifference_eq_zero_iff.2 ((map R σ).commutes r)

/-- On a generator `ι m`, the divided difference is the scalar `c` with `m - σ m = c • ℓ`. -/
theorem dividedDifference_ι {m : M} {c : R} (hc : m - σ m = c • ℓ) :
    dividedDifference σ ℓ hσ hℓ (ι R M m) = algebraMap R (SymmetricAlgebra R M) c := by
  rw [dividedDifference_eq_iff, map_apply_ι, ← map_sub, hc, map_smul, Algebra.smul_def, mul_comm]

/-- **The twisted Leibniz rule** `δ (p * q) = δ p * q + σ p * δ q`. -/
theorem dividedDifference_mul (p q : SymmetricAlgebra R M) :
    dividedDifference σ ℓ hσ hℓ (p * q) =
      dividedDifference σ ℓ hσ hℓ p * q + map R σ p * dividedDifference σ ℓ hσ hℓ q := by
  rw [dividedDifference_eq_iff, mul_add, ← mul_assoc, ι_mul_dividedDifference, mul_left_comm,
    ι_mul_dividedDifference, map_mul]
  ring

/-- The divided-difference operator is linear over the elements fixed by `σ`. -/
theorem dividedDifference_mul_of_map_eq {a : SymmetricAlgebra R M} (ha : map R σ a = a)
    (p : SymmetricAlgebra R M) :
    dividedDifference σ ℓ hσ hℓ (a * p) = a * dividedDifference σ ℓ hσ hℓ p := by
  rw [dividedDifference_mul, dividedDifference_eq_zero_iff.2 ha, zero_mul, zero_add, ha]

/-- **The divided-difference operator lowers degrees by one**: it sends the degree-`n + 1` part of
`Sym M` to the degree-`n` part. -/
theorem dividedDifference_mem_homogeneousSubmodule {n : ℕ} {p : SymmetricAlgebra R M}
    (hp : p ∈ homogeneousSubmodule R M (n + 1)) :
    dividedDifference σ ℓ hσ hℓ p ∈ homogeneousSubmodule R M n := by
  refine TauCeti.GradedAlgebra.mem_of_mul_mem_add_of_isLeftRegular (homogeneousSubmodule R M)
    (ι_mem_homogeneousSubmodule R M ℓ) hℓ ?_
  rw [ι_mul_dividedDifference, add_comm 1 n]
  exact Submodule.sub_mem _ hp (map_mem_homogeneousSubmodule σ hp)

end SymmetricAlgebra
