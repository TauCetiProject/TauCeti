module

public import TauCeti.LinearAlgebra.SymmetricAlgebra.Grading
public import TauCeti.RingTheory.GradedAlgebra.HomogeneousLocalization.Basic

/-!
# Homogeneous localizations of a symmetric algebra at a linear form

Let `M` be a module over a commutative ring `R`, and grade the symmetric algebra `Sym M` by
`TauCeti.SymmetricAlgebra.homogeneousSubmodule R M`. For `x ∈ M` the homogeneous localization
`Sym(M)_(x)`, the degree-zero part of `Sym(M)[1/x]`, is the coordinate ring of the standard chart
`D₊(x)` of `Proj (Sym M)`. It is generated by the fractions `m / x`, `m ∈ M`.

## Main declarations

* `TauCeti.SymmetricAlgebra.awayLinearMap`: the linear form `m ↦ m / x` with values in
  `Sym(M)_(x)`; it takes the value `1` at `x` (`TauCeti.SymmetricAlgebra.awayLinearMap_self`,
  in simp-normal form `HomogeneousLocalization.Away.mk_self`).
* `AlgHom.apply_awayMk_eq_lift`: an algebra homomorphism `ψ` on `Sym(M)_(x)` evaluates a
  homogeneous fraction `a / xⁿ` as `a` at any linear map agreeing with `m ↦ ψ (m / x)`.
* `AlgHom.chartFunctional`: the linear map `m ↦ ψ (m / x)` of an algebra homomorphism `ψ` on
  `Sym(M)_(x)`; it takes the value `1` at `x` (`AlgHom.chartFunctional_self`).
* `AlgHom.apply_awayMk_eq_lift_chartFunctional`: such a `ψ` evaluates `a / xⁿ` as `a` at its
  functional.
-/

public section

universe u v w

open HomogeneousLocalization

namespace TauCeti.SymmetricAlgebra

variable (R : Type u) {M : Type v} [CommRing R] [AddCommMonoid M] [Module R M]

/-- The linear form `m ↦ m / x` on `M` with values in the homogeneous localization `Sym(M)_(x)`. -/
noncomputable def awayLinearMap (x : M) :
    M →ₗ[R] Away (homogeneousSubmodule R M) (SymmetricAlgebra.ι R M x) :=
  Away.mkLinearMap (ι_mem_homogeneousSubmodule R M x) 1 ∘ₗ
    (SymmetricAlgebra.ι R M).codRestrict _ (ι_mem_homogeneousSubmodule_one_smul R M)

@[simp]
theorem awayLinearMap_apply (x m : M) :
    awayLinearMap R x m = Away.mk (homogeneousSubmodule R M) (ι_mem_homogeneousSubmodule R M x) 1
      (SymmetricAlgebra.ι R M m) (ι_mem_homogeneousSubmodule_one_smul R M m) := by
  simp only [awayLinearMap, LinearMap.comp_apply, Away.mkLinearMap_apply,
    LinearMap.codRestrict_apply]

/-- The linear form `m ↦ m / x` takes the value one at `x`. -/
theorem awayLinearMap_self (x : M) : awayLinearMap R x x = 1 := by
  simp

variable {R}

/-- On the standard chart `D₊(x)` of a linear form `x`, an `R`-algebra homomorphism `ψ`
evaluates a homogeneous fraction `a / xⁿ` as the polynomial `a` evaluated at a linear map `v`
that agrees with `m ↦ ψ (m / x)` on linear forms. -/
theorem _root_.AlgHom.apply_awayMk_eq_lift {A : Type w} [CommRing A] [Algebra R A] {x : M}
    (ψ : Away (homogeneousSubmodule R M) (SymmetricAlgebra.ι R M x) →ₐ[R] A) (v : M →ₗ[R] A)
    (hv : ∀ c, ψ (Away.mk _ (ι_mem_homogeneousSubmodule R M x) 1 (SymmetricAlgebra.ι R M c)
      (by simp)) = v c)
    {n : ℕ} {a : SymmetricAlgebra R M} (ha : a ∈ homogeneousSubmodule R M n) :
    ψ (Away.mk _ (ι_mem_homogeneousSubmodule R M x) n a (by rwa [smul_eq_mul, mul_one])) =
      SymmetricAlgebra.lift v a := by
  have hx := ι_mem_homogeneousSubmodule R M x
  induction ha using Submodule.pow_induction_on_left' with
  | algebraMap r =>
    have : Away.mk _ hx 0 (algebraMap R _ r) (by simp) = algebraMap R (Away _ _) r := by
      apply val_injective
      rw [Away.val_mk, val_algebraMap,
        IsScalarTower.algebraMap_apply R (SymmetricAlgebra R M) (Localization.Away _) r,
        ← Localization.mk_one_eq_algebraMap]
      exact congrArg _ (Subtype.ext (pow_zero _))
    rw [this]
    simp
  | add a b i ha hb iha ihb =>
    have : Away.mk _ hx i (a + b) (by simpa using add_mem ha hb) =
        Away.mk _ hx i a (by simpa using ha) + Away.mk _ hx i b (by simpa using hb) := by
      apply val_injective
      simp [Away.val_mk, Localization.add_mk_self]
    rw [this, map_add, iha, ihb, map_add]
  | mem_mul c hc i a ha iha =>
    obtain ⟨c, rfl⟩ := hc
    have hc : SymmetricAlgebra.ι R M c ∈ homogeneousSubmodule R M (1 • 1) := by simp
    have ha' : a ∈ homogeneousSubmodule R M (i • 1) := by simpa using ha
    have hca : SymmetricAlgebra.ι R M c * a ∈ homogeneousSubmodule R M ((i + 1) • 1) := by
      simpa [add_comm] using SetLike.mul_mem_graded (ι_mem_homogeneousSubmodule R M c) ha
    have : Away.mk _ hx (i + 1) _ hca = Away.mk _ hx 1 _ hc * Away.mk _ hx i a ha' := by
      apply val_injective
      simp [Away.val_mk, Localization.mk_mul, pow_succ']
    rw [this, map_mul, iha, map_mul, SymmetricAlgebra.lift_ι_apply, hv]

/-- The linear map `m ↦ ψ (m / x)` of an `R`-algebra homomorphism `ψ` on the standard chart
`D₊(x)` of a linear form `x`. -/
noncomputable def _root_.AlgHom.chartFunctional {A : Type w} [CommRing A] [Algebra R A] {x : M}
    (ψ : Away (homogeneousSubmodule R M) (SymmetricAlgebra.ι R M x) →ₐ[R] A) : M →ₗ[R] A :=
  ψ.toLinearMap ∘ₗ awayLinearMap R x

/-- The functional of `ψ` sends `m` to `ψ (m / x)`. -/
theorem _root_.AlgHom.chartFunctional_apply {A : Type w} [CommRing A] [Algebra R A] {x : M}
    (ψ : Away (homogeneousSubmodule R M) (SymmetricAlgebra.ι R M x) →ₐ[R] A) (m : M) :
    ψ.chartFunctional m =
      ψ (Away.mk _ (ι_mem_homogeneousSubmodule R M x) 1 (SymmetricAlgebra.ι R M m) (by simp)) := by
  simp [AlgHom.chartFunctional]

/-- The functional of `ψ` takes the value `1` on the chart coordinate `x`. -/
@[simp]
theorem _root_.AlgHom.chartFunctional_self {A : Type w} [CommRing A] [Algebra R A] {x : M}
    (ψ : Away (homogeneousSubmodule R M) (SymmetricAlgebra.ι R M x) →ₐ[R] A) :
    ψ.chartFunctional x = 1 := by
  simp [AlgHom.chartFunctional]

/-- On the standard chart `D₊(x)` of a linear form `x`, an `R`-algebra homomorphism `ψ`
evaluates a homogeneous fraction `a / xⁿ` as the polynomial `a` evaluated at its functional
`m ↦ ψ (m / x)`. -/
theorem _root_.AlgHom.apply_awayMk_eq_lift_chartFunctional {A : Type w} [CommRing A]
    [Algebra R A] {x : M}
    (ψ : Away (homogeneousSubmodule R M) (SymmetricAlgebra.ι R M x) →ₐ[R] A)
    {n : ℕ} {a : SymmetricAlgebra R M} (ha : a ∈ homogeneousSubmodule R M n) :
    ψ (Away.mk _ (ι_mem_homogeneousSubmodule R M x) n a (by rwa [smul_eq_mul, mul_one])) =
      SymmetricAlgebra.lift ψ.chartFunctional a :=
  ψ.apply_awayMk_eq_lift _ (fun m ↦ (ψ.chartFunctional_apply m).symm) ha

end TauCeti.SymmetricAlgebra
