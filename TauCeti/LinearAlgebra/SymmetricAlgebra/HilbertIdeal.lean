module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.Ideal.Over
public import TauCeti.LinearAlgebra.SymmetricAlgebra.Functoriality
public import TauCeti.LinearAlgebra.SymmetricAlgebra.Grading
import TauCeti.RingTheory.MvPolynomial.Ideal

/-!
# The ideal generated by a subalgebra of a symmetric algebra

Let `A` be a subalgebra of the symmetric algebra `S = Sym M` of a module `M` over a commutative
semiring `R`. Regard `S` as the coordinate ring of an affine space with origin given by the
augmentation `SymmetricAlgebra.algebraMapInv`, and `A` as the coordinate ring of a quotient. The
ideal `A₊ · S` of `S` generated by the elements of `A` vanishing at the origin
(`Subalgebra.symmetricAlgebraHilbertIdeal`) is the ideal of the scheme-theoretic zero fibre of the
morphism `Spec S → Spec A`: an `S`-algebra lies over the fibre exactly when every element of `A`
vanishing at the origin goes to zero (`Subalgebra.symmetricAlgebraHilbertIdeal_le_iff`). No
reduction is taken.

For `A` the invariants of a linear group action this is the Hilbert ideal of the action, whose
quotient is the coinvariant algebra (`Representation.symmetricAlgebraHilbertIdeal`); for the
adjoint action of an affine group on the polynomial functions on its Lie algebra it is the ideal of
the nilpotent cone (`TauCeti.nilpotentConeIdeal`).

When `A` contains the homogeneous components of its elements, which holds for invariants of a
linear action, the ideal is generated by the homogeneous elements of `A` of positive degree, and so
is a homogeneous ideal: the zero fibre is a cone.

## Main definitions

* `Subalgebra.symmetricAlgebraHilbertIdeal`: the ideal `A₊ · Sym M`.

## Main results

* `Subalgebra.symmetricAlgebraHilbertIdeal_le_iff`: an ideal contains `A₊ · Sym M` exactly when it
  contains every element of `A` vanishing at the origin.
* `Subalgebra.symmetricAlgebraHilbertIdeal_eq_map_under`: `A₊ · Sym M` is the extension of the
  contraction `A₊` of the irrelevant ideal to `A`.
* `Subalgebra.symmetricAlgebraHilbertIdeal_le_irrelevant`: `A₊ · Sym M` lies in the irrelevant
  ideal, so the origin lies in the zero fibre.
* `Subalgebra.symmetricAlgebraHilbertIdeal_top`: for `A` the whole symmetric algebra it is the
  augmentation ideal.
* `Subalgebra.map_symmetricAlgebraHilbertIdeal`: the image of `A₊ · Sym M` under the map induced by
  a linear map `f : M → N` is the ideal of the image of `A`.
* `Subalgebra.symmetricAlgebraHilbertIdeal_eq_span_of_surjective`: a generating family of `A`
  vanishing at the origin generates `A₊ · Sym M`.
* `Subalgebra.symmetricAlgebraHilbertIdeal_eq_span` and
  `Subalgebra.isHomogeneous_symmetricAlgebraHilbertIdeal`: for a homogeneous subalgebra, it is
  generated by the homogeneous elements of positive degree, and so it is homogeneous.

## References

* H. Derksen, G. Kemper, *Computational Invariant Theory*, Springer (2002), Chapter 2.
* B. Kostant, *Lie group representations on polynomial rings*, Amer. J. Math. 85 (1963),
  327–404.
-/

public section

open TauCeti.SymmetricAlgebra

namespace Subalgebra

variable {R M N : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M] [AddCommMonoid N]
  [Module R N]

variable (A : Subalgebra R (SymmetricAlgebra R M))

/-- The ideal `A₊ · Sym M` of the symmetric algebra generated by the elements of a subalgebra `A`
vanishing at the origin, that is killed by the augmentation `SymmetricAlgebra.algebraMapInv`: the
ideal of the scheme-theoretic zero fibre of `Spec (Sym M) → Spec A`. For the invariants of a group
action it is the Hilbert ideal of the action. -/
noncomputable def symmetricAlgebraHilbertIdeal : Ideal (SymmetricAlgebra R M) :=
  Ideal.span {p | p ∈ A ∧ SymmetricAlgebra.algebraMapInv p = 0}

/-- The defining generators of `A₊ · Sym M`. -/
theorem symmetricAlgebraHilbertIdeal_def :
    A.symmetricAlgebraHilbertIdeal =
      Ideal.span {p | p ∈ A ∧ SymmetricAlgebra.algebraMapInv p = 0} :=
  (rfl)

variable {A}

/-- An element of `A` vanishing at the origin lies in `A₊ · Sym M`. -/
theorem mem_symmetricAlgebraHilbertIdeal_of_mem {p : SymmetricAlgebra R M} (hp : p ∈ A)
    (hp₀ : SymmetricAlgebra.algebraMapInv p = 0) : p ∈ A.symmetricAlgebraHilbertIdeal :=
  Ideal.subset_span ⟨hp, hp₀⟩

/-- **The universal property of `A₊ · Sym M`.** An ideal contains it exactly when it contains every
element of `A` vanishing at the origin. -/
theorem symmetricAlgebraHilbertIdeal_le_iff {J : Ideal (SymmetricAlgebra R M)} :
    A.symmetricAlgebraHilbertIdeal ≤ J ↔
      ∀ p ∈ A, SymmetricAlgebra.algebraMapInv p = 0 → p ∈ J := by
  rw [symmetricAlgebraHilbertIdeal, Ideal.span_le]
  exact ⟨fun h p hp hp₀ ↦ h ⟨hp, hp₀⟩, fun h p hp ↦ h p hp.1 hp.2⟩

variable (A) in
/-- `A₊ · Sym M` is the extension to `Sym M` of the contraction `A₊` to `A` of the irrelevant
ideal. -/
theorem symmetricAlgebraHilbertIdeal_eq_map_under :
    A.symmetricAlgebraHilbertIdeal =
      ((HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal.under A).map
        (algebraMap A (SymmetricAlgebra R M)) := by
  refine le_antisymm (symmetricAlgebraHilbertIdeal_le_iff.2 fun p hp hp₀ ↦ ?_) <|
    Ideal.map_le_iff_le_comap.2 fun p hp ↦ mem_symmetricAlgebraHilbertIdeal_of_mem p.property <|
      mem_irrelevant_iff_algebraMapInv_eq_zero.1 hp
  have hp' : (⟨p, hp⟩ : A) ∈
      (HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal.under A :=
    mem_irrelevant_iff_algebraMapInv_eq_zero.2 hp₀
  exact Ideal.mem_map_of_mem (algebraMap A _) hp'

/-- A larger subalgebra generates a larger ideal. -/
theorem symmetricAlgebraHilbertIdeal_mono :
    Monotone (symmetricAlgebraHilbertIdeal : Subalgebra R (SymmetricAlgebra R M) → _) :=
  fun _ _ h ↦ Ideal.span_mono fun _ hp ↦ ⟨h hp.1, hp.2⟩

/-- `A₊ · Sym M` lies in the irrelevant ideal: the origin lies in the zero fibre. -/
theorem symmetricAlgebraHilbertIdeal_le_irrelevant :
    A.symmetricAlgebraHilbertIdeal ≤
      (HomogeneousIdeal.irrelevant (homogeneousSubmodule R M)).toIdeal := by
  rw [toIdeal_irrelevant_eq_ker_algebraMapInv]
  exact symmetricAlgebraHilbertIdeal_le_iff.2 fun _ _ hp₀ ↦ hp₀

variable (R M) in
/-- For the whole symmetric algebra, `A₊ · Sym M` is the augmentation ideal: the zero fibre of the
identity is the origin. -/
@[simp]
theorem symmetricAlgebraHilbertIdeal_top :
    (⊤ : Subalgebra R (SymmetricAlgebra R M)).symmetricAlgebraHilbertIdeal =
      RingHom.ker (SymmetricAlgebra.algebraMapInv : SymmetricAlgebra R M →ₐ[R] R) :=
  le_antisymm (symmetricAlgebraHilbertIdeal_le_iff.2 fun _ _ hp₀ ↦ hp₀)
    fun _ hp ↦ mem_symmetricAlgebraHilbertIdeal_of_mem Algebra.mem_top hp

variable (A) in
/-- The map of symmetric algebras induced by a linear map `f : M → N` carries `A₊ · Sym M` onto the
ideal of `Sym N` generated by the image of `A`, since it preserves the augmentation. -/
theorem map_symmetricAlgebraHilbertIdeal (f : M →ₗ[R] N) :
    A.symmetricAlgebraHilbertIdeal.map (SymmetricAlgebra.map R f) =
      (A.map (SymmetricAlgebra.map R f)).symmetricAlgebraHilbertIdeal := by
  rw [symmetricAlgebraHilbertIdeal, symmetricAlgebraHilbertIdeal, Ideal.map_span]
  congr 1
  ext q
  simp only [Set.mem_image, Set.mem_ofPred_eq, mem_map]
  constructor
  · rintro ⟨p, ⟨hp, hp₀⟩, rfl⟩
    exact ⟨⟨p, hp, rfl⟩, by rw [SymmetricAlgebra.algebraMapInv_map, hp₀]⟩
  · rintro ⟨⟨p, hp, rfl⟩, hq₀⟩
    exact ⟨p, ⟨hp, by rwa [SymmetricAlgebra.algebraMapInv_map] at hq₀⟩, rfl⟩

/-- A generating family of `A` vanishing at the origin generates `A₊ · Sym M` in the ambient
symmetric algebra. Polynomial independence and finiteness of the family are not needed. -/
theorem symmetricAlgebraHilbertIdeal_eq_span_of_surjective {ι : Type*} (f : ι → A)
    (hf : ∀ i, SymmetricAlgebra.algebraMapInv (f i : SymmetricAlgebra R M) = 0)
    (hsurj : Function.Surjective (MvPolynomial.aeval (R := R) f)) :
    A.symmetricAlgebraHilbertIdeal =
      Ideal.span (Set.range fun i ↦ (f i : SymmetricAlgebra R M)) := by
  refine le_antisymm (symmetricAlgebraHilbertIdeal_le_iff.2 fun p hp hp₀ ↦ ?_) <|
    Ideal.span_le.2 <| Set.range_subset_iff.2 fun i ↦
      mem_symmetricAlgebraHilbertIdeal_of_mem (f i).property (hf i)
  -- Write `p` as a polynomial `P` in the family. Then `P` has zero constant term, so it lies in the
  -- ideal of the variables, whose image is the ideal generated by the family.
  obtain ⟨P, hP⟩ := hsurj ⟨p, hp⟩
  have heval : MvPolynomial.aeval (fun i ↦ (f i : SymmetricAlgebra R M)) P = p := by
    simpa only [MvPolynomial.comp_aeval_apply, val_apply] using congrArg A.val hP
  have hc : MvPolynomial.constantCoeff P = 0 := by
    rw [← heval, MvPolynomial.comp_aeval_apply] at hp₀
    simpa only [hf, MvPolynomial.aeval_zero', Algebra.algebraMap_self_apply] using hp₀
  have hPmem : P ∈ MvPolynomial.idealOfVars ι R := by
    rw [← MvPolynomial.ker_constantCoeff, RingHom.mem_ker]
    exact hc
  have h := Ideal.mem_map_of_mem (MvPolynomial.aeval (fun i ↦ (f i : SymmetricAlgebra R M))) hPmem
  rwa [MvPolynomial.map_aeval_idealOfVars, heval] at h

/-- **Homogeneous generators.** If `A` contains the homogeneous components of its elements, then
`A₊ · Sym M` is generated by the homogeneous elements of `A` of positive degree. -/
theorem symmetricAlgebraHilbertIdeal_eq_span
    (hA : DirectSum.SetLike.IsHomogeneous (homogeneousSubmodule R M) A) :
    A.symmetricAlgebraHilbertIdeal = Ideal.span
      {p | p ∈ A ∧ ∃ n, 0 < n ∧ p ∈ homogeneousSubmodule R M n} := by
  refine le_antisymm (symmetricAlgebraHilbertIdeal_le_iff.2 fun p hp hp₀ ↦ ?_) <|
    Ideal.span_le.2 fun p ⟨hp, n, hn, hpn⟩ ↦ mem_symmetricAlgebraHilbertIdeal_of_mem hp <|
      mem_irrelevant_iff_algebraMapInv_eq_zero.1 (HomogeneousIdeal.mem_irrelevant_of_mem _ hn hpn)
  classical
  -- Each homogeneous component of `p` lies in `A`, and the one of degree zero vanishes.
  rw [← DirectSum.sum_support_decompose (homogeneousSubmodule R M) p]
  refine Ideal.sum_mem _ fun n _ ↦ ?_
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · rw [← mem_irrelevant_iff_algebraMapInv_eq_zero, HomogeneousIdeal.mem_irrelevant_iff,
      GradedRing.proj_apply] at hp₀
    rw [hp₀]
    exact zero_mem _
  · exact Ideal.subset_span ⟨hA n hp, n, hn, SetLike.coe_mem _⟩

/-- **The zero fibre is a cone.** If `A` contains the homogeneous components of its elements, then
`A₊ · Sym M` is a homogeneous ideal. -/
theorem isHomogeneous_symmetricAlgebraHilbertIdeal
    (hA : DirectSum.SetLike.IsHomogeneous (homogeneousSubmodule R M) A) :
    A.symmetricAlgebraHilbertIdeal.IsHomogeneous (homogeneousSubmodule R M) := by
  rw [symmetricAlgebraHilbertIdeal_eq_span hA]
  exact Ideal.homogeneous_span _ _ fun _ ⟨_, n, _, hpn⟩ ↦ ⟨n, hpn⟩

end Subalgebra
