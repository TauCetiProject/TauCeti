/-!
# Jacobians in a symmetric algebra

The **Jacobian** of a family `f : n → Sym M` in a finite basis `b : Basis n R M` is the
determinant of the matrix of partial derivatives `∂ (f i) / ∂ (b j)`, the derivatives
`SymmetricAlgebra.pderiv (b.coord j) (f i)` along the coordinate forms of `b`. This file proves:

* a change of basis multiplies the Jacobian by the determinant of the change of basis, a unit;
* the chain rule: for an endomorphism `g` of `M`, the Jacobian of the family `map g (f i)` is
  `det g` times the image under `map g` of the Jacobian of `f`. Hence, if every `f i` is fixed by
  `map g`, the Jacobian is a relative invariant: `det g • map g (jacobian b f) = jacobian b f`;
* if every `f i` is homogeneous of degree `d i`, the Jacobian is homogeneous of degree
  `∑ i, (d i - 1)`;
* **the Jacobian criterion**: over a domain of characteristic zero, if every generator `ι (b j)`
  is algebraic over the subalgebra generated by the `f i`, then the Jacobian is nonzero.
  Otherwise a nonzero vector in the kernel of the Jacobian matrix gives a nonzero derivation
  killing every `f i`, which must then also kill every generator, since these are algebraic over
  the subalgebra they generate (`Derivation.apply_eq_zero_of_isAlgebraic`).

For a system of basic invariants of a finite group generated by reflections, these properties are
the input to the classical identification of the Jacobian, up to a nonzero scalar, with the
product of the linear forms of the reflecting hyperplanes.

## Main definitions

* `SymmetricAlgebra.jacobianMatrix`: the matrix of partial derivatives of a family in `Sym M`, in
  the coordinates of a basis of `M`.
* `SymmetricAlgebra.jacobian`: its determinant.

## Main results

* `SymmetricAlgebra.jacobian_eq_algebraMap_det_mul`: the Jacobian under a change of basis.
* `SymmetricAlgebra.jacobian_map`: the chain rule for Jacobians.
* `SymmetricAlgebra.jacobian_mem_homogeneousSubmodule`: the degree of the Jacobian.
* `SymmetricAlgebra.jacobian_ne_zero`: the Jacobian criterion in characteristic zero.

## References

* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press (1990),
  Chapter 3 (the Jacobian criterion, and the Jacobian of a system of basic invariants).
-/

public section

open TauCeti.SymmetricAlgebra

namespace SymmetricAlgebra

section CommRing

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
variable {n : Type*} [Fintype n] [DecidableEq n] (b : Module.Basis n R M)

/-- The Jacobian matrix of a family `f` in `Sym M`, in the coordinates of a basis `b` of `M`: its
entry `(i, j)` is the partial derivative of `f i` in the variable `b j`. -/
noncomputable def jacobianMatrix (f : n → SymmetricAlgebra R M) :
    Matrix n n (SymmetricAlgebra R M) :=
  Matrix.of fun i j ↦ pderiv (b.coord j) (f i)

omit [Fintype n] [DecidableEq n] in
/-- The entries of the Jacobian matrix are the partial derivatives `∂ (f i) / ∂ (b j)`. -/
@[simp]
theorem jacobianMatrix_apply (f : n → SymmetricAlgebra R M) (i j : n) :
    jacobianMatrix b f i j = pderiv (b.coord j) (f i) :=
  (rfl)

/-- The Jacobian of a family `f` in `Sym M`, in the coordinates of a basis `b` of `M`: the
determinant of the matrix of partial derivatives `∂ (f i) / ∂ (b j)`. -/
noncomputable def jacobian (f : n → SymmetricAlgebra R M) : SymmetricAlgebra R M :=
  (jacobianMatrix b f).det

/-- The Jacobian is the determinant of the Jacobian matrix. -/
theorem jacobian_def (f : n → SymmetricAlgebra R M) : jacobian b f = (jacobianMatrix b f).det :=
  (rfl)

/-- The determinant of the derivatives of `f` along any family `φ` of linear forms is the Jacobian
times the determinant of the values of the forms on the basis. -/
private theorem det_of_pderiv (φ : n → Module.Dual R M) (f : n → SymmetricAlgebra R M) :
    (Matrix.of fun i j ↦ pderiv (φ j) (f i)).det =
      algebraMap R _ (Matrix.of fun j k ↦ φ j (b k)).det * jacobian b f := by
  have h : (Matrix.of fun i j ↦ pderiv (φ j) (f i)) = jacobianMatrix b f *
      ((algebraMap R (SymmetricAlgebra R M)).mapMatrix
        (Matrix.of fun j k ↦ φ j (b k))).transpose := by
    ext i j
    rw [Matrix.of_apply, pderiv_eq_sum b]
    simp [Matrix.mul_apply, mul_comm]
  rw [h, Matrix.det_mul, Matrix.det_transpose, ← RingHom.map_det, jacobian_def, mul_comm]

/-- **Change of basis.** The Jacobians of a family in two bases `b` and `b'` differ by the
determinant of `b` in the basis `b'`, a unit. -/
theorem jacobian_eq_algebraMap_det_mul (b' : Module.Basis n R M) (f : n → SymmetricAlgebra R M) :
    jacobian b' f = algebraMap R _ (b'.det b) * jacobian b f := by
  have h : b'.toMatrix b = Matrix.of fun j k ↦ b'.coord j (b k) := by
    ext j k
    simp [Module.Basis.toMatrix_apply]
  rw [Module.Basis.det_apply, h, ← det_of_pderiv, jacobian_def, jacobianMatrix]

/-- **The chain rule for Jacobians.** For an endomorphism `g` of `M`, the Jacobian of the family
`map g (f i)` is `det g` times the image under `map g` of the Jacobian of `f`. -/
theorem jacobian_map (g : M →ₗ[R] M) (f : n → SymmetricAlgebra R M) :
    jacobian b (fun i ↦ map R g (f i)) =
      algebraMap R _ (LinearMap.det g) * map R g (jacobian b f) := by
  have h : jacobianMatrix b (fun i ↦ map R g (f i)) =
      (map R g).mapMatrix (Matrix.of fun i j ↦ pderiv (b.coord j ∘ₗ g) (f i)) := by
    ext i j
    simp [pderiv_map]
  rw [jacobian_def, h, ← AlgHom.map_det, det_of_pderiv b, map_mul, AlgHom.commutes,
    ← LinearMap.det_toMatrix b]
  congr 3
  ext j k
  simp [LinearMap.toMatrix_apply]

/-- **The Jacobian of invariants is a relative invariant.** If every `f i` is fixed by the map
induced by an endomorphism `g` of `M`, then the Jacobian of `f` satisfies
`det g • map g (jacobian b f) = jacobian b f`; when `det g` is a unit, `map g` multiplies the
Jacobian by `(det g)⁻¹`. -/
theorem algebraMap_det_mul_map_jacobian {g : M →ₗ[R] M} {f : n → SymmetricAlgebra R M}
    (hf : ∀ i, map R g (f i) = f i) :
    algebraMap R _ (LinearMap.det g) * map R g (jacobian b f) = jacobian b f := by
  rw [← jacobian_map]
  simp only [hf]

/-- **The degree of the Jacobian.** If every `f i` is homogeneous of degree `d i`, the Jacobian is
homogeneous of degree `∑ i, (d i - 1)`. -/
theorem jacobian_mem_homogeneousSubmodule {f : n → SymmetricAlgebra R M} (d : n → ℕ)
    (hf : ∀ i, f i ∈ homogeneousSubmodule R M (d i)) :
    jacobian b f ∈ homogeneousSubmodule R M (∑ i, (d i - 1)) := by
  rw [jacobian_def, Matrix.det_apply]
  refine Submodule.sum_mem _ fun σ _ ↦ ?_
  rw [Units.smul_def, ← Equiv.sum_comp σ (fun i ↦ d i - 1)]
  exact zsmul_mem (SetLike.prod_mem_graded (homogeneousSubmodule R M) _ _ fun i _ ↦
    pderiv_mem_homogeneousSubmodule _ (hf (σ i))) _

/-- **The Jacobian criterion.** Over a domain `R` of characteristic zero, if every generator
`ι (b j)` is algebraic over the subalgebra generated by the family `f`, then the Jacobian of `f`
is nonzero. This applies to a system of basic invariants of a finite group, over which the
polynomial algebra is integral. -/
theorem jacobian_ne_zero [IsDomain R] [CharZero R] {f : n → SymmetricAlgebra R M}
    (hf : ∀ j, IsAlgebraic (Algebra.adjoin R (Set.range f)) (ι R M (b j))) :
    jacobian b f ≠ 0 := by
  have := Module.Free.of_basis b
  have := charZero_of_injective_algebraMap (algebraMap_leftInverse (R := R) M).injective
  intro h
  -- A nonzero vector `v` in the kernel of the Jacobian matrix gives a derivation `D` killing
  -- every `f i`, with `D (ι (b j)) = v j`.
  obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.2 h
  let D : Derivation R (SymmetricAlgebra R M) (SymmetricAlgebra R M) :=
    ∑ k, v k • pderiv (b.coord k)
  have hD : ∀ x ∈ Algebra.adjoin R (Set.range f), D x = 0 := fun x hx ↦
    Derivation.eqOn_adjoin (D2 := 0) (by
      rintro _ ⟨i, rfl⟩
      simpa [D, Matrix.mulVec, dotProduct, mul_comm] using congrFun hv i) hx
  -- Since the generators are algebraic over the subalgebra generated by `f`, `D` kills them too.
  refine hv0 (funext fun j ↦ ?_)
  simpa [D, Derivation.coe_sum_linearMap, Finsupp.single_apply] using
    D.apply_eq_zero_of_isAlgebraic hD (hf j)

end CommRing

end SymmetricAlgebra
