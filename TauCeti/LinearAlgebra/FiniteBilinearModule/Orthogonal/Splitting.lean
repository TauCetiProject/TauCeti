module

public import TauCeti.LinearAlgebra.FiniteBilinearModule.Quadratic

/-!
# Orthogonal splitting along a nondegenerate subgroup

Let `H` be a subgroup of a finite bilinear module `A` on which the restricted pairing is
nondegenerate. Then `H` meets its orthogonal complement trivially, since `H ∩ H⊥` is the radical of
the restriction, and every `x : A` is the sum of an element of `H` and an element of `H⊥`: the
character `b(x, ·)` on `H` is `b(h, ·)` for some `h ∈ H`, and then `x - h ∈ H⊥`. So

```text
A = H ⊕ H⊥,
```

an orthogonal direct sum. No nondegeneracy of `A` is needed for this. If `A` is nondegenerate as
well, then so is the pairing restricted to `H⊥`. Mathlib's
`LinearMap.BilinForm.isCompl_orthogonal_of_restrict_nondegenerate` is the analogue for a bilinear
form on a finite-dimensional vector space, where nondegeneracy is injectivity and a dimension count
replaces the character argument; it does not apply to `ℚ/ℤ`-valued pairings on finite groups.

A cyclic subgroup `⟨z⟩` is nondegenerate exactly when `b(z, z)` has the same order as `z`. This
is the criterion for splitting off a cyclic orthogonal summand.

Summands are found at the top exponent of a primary part. If a prime `p` divides `#A` and `A` is
nondegenerate, take `x` of the largest `p`-power order `p^{k+1}`. The character `b(x, ·)` then has
order `p^{k+1}` too, so `p^k b(x, y) ≠ 0` for some `y`, which can be replaced by its `p`-primary
part. Whether `x`, `y` and their combinations generate a cyclic or a rank-two summand depends on
`p` and on the self-pairings.

For a finite quadratic module the quadratic map is additive across the splitting, because the
polar pairing of `H` with `H⊥` vanishes, so the splitting is an isometry from the orthogonal
product `H ⊥ H⊥` onto `A`. This is the analogue, for `ℚ/ℤ`-valued quadratic maps, of
`QuadraticMap.IsometryEquiv.prodRestrictOrthogonal`, which is stated for quadratic forms valued in
the scalar ring. Splitting off nondegenerate summands one at a time is how a nondegenerate finite
quadratic module is decomposed into cyclic and rank-two pieces.

## Main declarations

* `TauCeti.FiniteBilinearModule.isCompl_orthogonalComplement`: a subgroup with nondegenerate
  restricted pairing is complementary to its orthogonal complement.
* `TauCeti.FiniteBilinearModule.IsNondegenerate.isNondegenerate_restrict_orthogonalComplement`:
  in a nondegenerate module, the orthogonal complement of such a subgroup is nondegenerate too.
* `TauCeti.FiniteBilinearModule.isNondegenerate_restrict_zmultiples_iff`: the cyclic subgroup
  generated by `z` is nondegenerate exactly when `b(z, z)` and `z` have the same order.
* `TauCeti.FiniteBilinearModule.addOrderOf_eq_and_isNondegenerate_of_pairing`: if `p^{k+1}` kills
  `z` but not `p^k b(z, z)`, then `⟨z⟩` is a nondegenerate cyclic subgroup of order `p^{k+1}`.
* `TauCeti.FiniteBilinearModule.exists_nsmul_pairing_ne_zero_of_dvd_card`: a pair `x, y` killed by
  `p^{k+1}` with `p^k b(x, y) ≠ 0`, for a prime `p` dividing the order of a nondegenerate module.
* `TauCeti.FiniteQuadraticModule.restrictProdOrthogonalComplementIsometry`: the isometry
  `H ⊥ H⊥ ≅ A` of finite quadratic modules.

## References

* V. V. Nikulin, *Integral symmetric bilinear forms and some of their applications*, §1.1.
* C. T. C. Wall, *Quadratic forms on finite groups, and related topics*, Topology 2 (1963),
  281–298.
-/

public section

namespace TauCeti

universe u

namespace FiniteBilinearModule

variable (A : FiniteBilinearModule.{u})

/-- **Orthogonal splitting.** If the pairing restricted to `H` is nondegenerate, then `H` and its
orthogonal complement are complementary subgroups. -/
theorem isCompl_orthogonalComplement {H : AddSubgroup A} (hH : (A.restrict H).IsNondegenerate) :
    IsCompl H (A.orthogonalComplement H) := by
  constructor
  · rw [AddSubgroup.disjoint_def]
    intro x hxH hx
    have hrad : (⟨x, hxH⟩ : H) ∈ (A.restrict H).radical := by
      rw [radical_restrict, AddSubgroup.mem_addSubgroupOf]
      exact hx
    rw [hH.radical_eq_bot, AddSubgroup.mem_bot] at hrad
    exact congrArg Subtype.val hrad
  · rw [codisjoint_iff, eq_top_iff]
    intro x _
    -- The character `b(x, ·)` restricted to `H` is the pairing with some `h ∈ H`.
    obtain ⟨h, hh⟩ := IsNondegenerate.surjective _ hH ((A.pairing x).comp H.subtype)
    have hxh : x - h ∈ A.orthogonalComplement H := by
      rw [mem_orthogonalComplement_iff]
      intro y hy
      have hy' := DFunLike.congr_fun hh ⟨y, hy⟩
      rw [restrict_pairing] at hy'
      rw [sub_eq_add_neg, pairing_add_left, pairing_neg_left, ← sub_eq_add_neg, sub_eq_zero]
      exact hy'.symm
    simpa using AddSubgroup.add_mem_sup h.2 hxh

/-- In a nondegenerate finite bilinear module, the orthogonal complement of a subgroup with
nondegenerate restricted pairing also has nondegenerate restricted pairing. -/
theorem IsNondegenerate.isNondegenerate_restrict_orthogonalComplement
    {A : FiniteBilinearModule.{u}} (hA : A.IsNondegenerate) {H : AddSubgroup A}
    (hH : (A.restrict H).IsNondegenerate) :
    (A.restrict (A.orthogonalComplement H)).IsNondegenerate := by
  refine isNondegenerate_of_radical_eq_bot _ (eq_bot_iff.2 fun x hx ↦ ?_)
  rw [mem_radical_iff] at hx
  rw [AddSubgroup.mem_bot, Subtype.ext_iff, AddSubgroup.coe_zero]
  -- `x` pairs trivially with `H` and with `H⊥`, hence with `H ⊔ H⊥ = A`.
  refine IsNondegenerate.eq_zero_of_forall_pairing_eq_zero _ hA fun y ↦ ?_
  have hy : y ∈ H ⊔ A.orthogonalComplement H := by
    rw [(A.isCompl_orthogonalComplement hH).sup_eq_top]
    exact AddSubgroup.mem_top y
  obtain ⟨a, ha, b, hb, rfl⟩ := AddSubgroup.mem_sup.1 hy
  rw [pairing_add_right, (A.mem_orthogonalComplement_iff H x).1 x.2 a ha, zero_add]
  exact (A.restrict_pairing _ x ⟨b, hb⟩).symm.trans (hx ⟨b, hb⟩)

/-- **The cyclic subgroup generated by `z` is nondegenerate exactly when `b(z, z)` has the same
order as `z`.** The order of `b(z, z)` always divides that of `z`; equality says that `j • b(z, z)`
vanishes only when `j • z` does, and `b(j • z, i • z) = ij • b(z, z)`. -/
theorem isNondegenerate_restrict_zmultiples_iff (z : A) :
    (A.restrict (AddSubgroup.zmultiples z)).IsNondegenerate ↔
      addOrderOf (A.pairing z z) = addOrderOf z := by
  have hsmul : ∀ (w : A) (j : ℤ), A.pairing (j • z) w = j • A.pairing z w := fun w j ↦ by
    rw [A.pairing_comm, map_zsmul, A.pairing_comm]
  rw [isNondegenerate_iff_radical_eq_bot, radical_restrict, AddSubgroup.eq_bot_iff_forall]
  simp only [AddSubgroup.mem_addSubgroupOf, mem_orthogonalComplement_iff]
  constructor
  · intro h
    refine Nat.dvd_antisymm (addOrderOf_dvd_of_nsmul_eq_zero ?_) ?_
    · rw [← map_nsmul, addOrderOf_nsmul_eq_zero, map_zero]
    -- `addOrderOf (b z z) • z` pairs trivially with the cyclic subgroup, so it vanishes.
    have hzero := h ⟨(addOrderOf (A.pairing z z) : ℤ) • z, AddSubgroup.zsmul_mem_zmultiples _ _⟩
      fun y hy ↦ by
        obtain ⟨j, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hy
        rw [map_zsmul, hsmul, natCast_zsmul, addOrderOf_nsmul_eq_zero, smul_zero]
    rw [← Int.natCast_dvd_natCast, addOrderOf_dvd_iff_zsmul_eq_zero]
    exact congrArg Subtype.val hzero
  · intro h x hx
    obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.1 x.2
    have hjz := hx z (AddSubgroup.mem_zmultiples z)
    rw [← hj, hsmul, ← addOrderOf_dvd_iff_zsmul_eq_zero, h, addOrderOf_dvd_iff_zsmul_eq_zero,
      hj] at hjz
    exact Subtype.ext hjz

/-- If `p^{k+1}` kills `z` but not `p^k b(z, z)`, then `z` has order `p^{k+1}` and generates a
nondegenerate cyclic subgroup. -/
theorem addOrderOf_eq_and_isNondegenerate_of_pairing {p k : ℕ} [Fact p.Prime] {z : A}
    (hz : p ^ (k + 1) • z = 0) (hzz : p ^ k • A.pairing z z ≠ 0) :
    addOrderOf z = p ^ (k + 1) ∧ (A.restrict (AddSubgroup.zmultiples z)).IsNondegenerate := by
  have horder : addOrderOf z = p ^ (k + 1) := addOrderOf_eq_prime_pow
    (fun h ↦ hzz (by rw [← map_nsmul, h, map_zero])) hz
  refine ⟨horder, (A.isNondegenerate_restrict_zmultiples_iff z).2 ?_⟩
  rw [horder]
  exact addOrderOf_eq_prime_pow hzz (by rw [← map_nsmul, hz, map_zero])

/-- An element `y` can be replaced by an element of `p`-power order with the same pairing against
a given `x` killed by `p^k`: write `#⟨y⟩ = p^e r` with `p ∤ r` and take the multiple of `y` by an
inverse of `r` modulo `p^k`. -/
private theorem exists_pairing_eq_of_addOrderOf_eq_prime_pow {p k : ℕ} [hp : Fact p.Prime]
    {x : A} (hx : p ^ k • x = 0) (y : A) :
    ∃ y' : A, (∃ e, addOrderOf y' = p ^ e) ∧ A.pairing x y' = A.pairing x y := by
  obtain ⟨e, r, hr, hn⟩ := Nat.exists_eq_pow_mul_and_not_dvd (addOrderOf_pos y).ne' p
    hp.out.one_lt.ne'
  obtain ⟨s, t, hst⟩ : IsCoprime (r : ℤ) ((p ^ k : ℕ) : ℤ) := Nat.isCoprime_iff_coprime.2
    (Nat.Coprime.pow_right _ ((Nat.Prime.coprime_iff_not_dvd hp.out).2 hr).symm)
  refine ⟨(s * r) • y, ?_, ?_⟩
  · -- `p^e` kills `(s r) • y`, so its order is a power of `p`.
    have hdvd : addOrderOf ((s * r) • y) ∣ p ^ e := by
      rw [← Int.natCast_dvd_natCast, addOrderOf_dvd_iff_zsmul_eq_zero, smul_smul,
        show ((p ^ e : ℕ) : ℤ) * (s * r) = s * (addOrderOf y : ℤ) by rw [hn]; push_cast; ring,
        mul_zsmul, natCast_zsmul, addOrderOf_nsmul_eq_zero, smul_zero]
    obtain ⟨e', -, he'⟩ := (Nat.dvd_prime_pow hp.out).1 hdvd
    exact ⟨e', he'⟩
  · -- `s r ≡ 1` modulo `p^k`, which kills `b(x, y)`.
    have hpk : ((p ^ k : ℕ) : ℤ) • A.pairing x y = 0 := by
      rw [natCast_zsmul, ← pairing_nsmul_left, hx, pairing_zero_left]
    rw [map_zsmul, show s * r = 1 - t * ((p ^ k : ℕ) : ℤ) by rw [← hst]; ring, sub_smul,
      one_smul, mul_smul, hpk, smul_zero, sub_zero]

/-- **A pair detecting a nonzero primary pairing.** In a nondegenerate finite bilinear
module whose order is divisible by a prime `p`, there are `x` and `y`, both killed by `p^{k+1}`,
with `p^k b(x, y) ≠ 0`. In particular `x` and `y` both have order exactly `p^{k+1}`. -/
theorem exists_nsmul_pairing_ne_zero_of_dvd_card {p : ℕ} [hp : Fact p.Prime]
    (hA : A.IsNondegenerate) (hpA : p ∣ Nat.card A) :
    ∃ (x y : A) (k : ℕ), p ^ (k + 1) • x = 0 ∧ p ^ (k + 1) • y = 0 ∧
      p ^ k • A.pairing x y ≠ 0 := by
  classical
  have : Fintype A := Fintype.ofFinite A
  -- Choose `x` of the largest order `p^k` among elements of `p`-power order.
  obtain ⟨x, hxS, hmax⟩ := (Finset.univ.filter fun x : A ↦ ∃ k, addOrderOf x = p ^ k)
    |>.exists_max_image addOrderOf ⟨0, Finset.mem_filter.2 ⟨Finset.mem_univ _, 0, by simp⟩⟩
  obtain ⟨k, hk⟩ := (Finset.mem_filter.1 hxS).2
  have hkill : ∀ y : A, (∃ e, addOrderOf y = p ^ e) → p ^ k • y = 0 := by
    rintro y ⟨e, he⟩
    have hle : p ^ e ≤ p ^ k :=
      he ▸ hk ▸ hmax y (Finset.mem_filter.2 ⟨Finset.mem_univ _, e, he⟩)
    rw [← addOrderOf_dvd_iff_nsmul_eq_zero, he]
    exact Nat.pow_dvd_pow p ((Nat.pow_le_pow_iff_right hp.out.one_lt).1 hle)
  -- By Cauchy's theorem there is an element of order `p`, so `k ≥ 1`.
  obtain ⟨y₀, hy₀⟩ := exists_prime_addOrderOf_dvd_card' p hpA
  obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := by
    refine Nat.exists_eq_succ_of_ne_zero fun hk0 ↦ hp.out.one_lt.ne' ?_
    have := hkill y₀ ⟨1, by rw [hy₀, pow_one]⟩
    rw [hk0, pow_zero, one_smul] at this
    rw [← hy₀, this, addOrderOf_zero]
  have hxk : p ^ (k + 1) • x = 0 := by rw [← hk, addOrderOf_nsmul_eq_zero]
  -- The character `b(x, ·)` has order `p^{k+1}`, so `p^k b(x, y) ≠ 0` for some `y`, which may
  -- be taken of `p`-power order.
  obtain ⟨y, hy⟩ : ∃ y, p ^ k • A.pairing x y ≠ 0 := by
    by_contra! h
    refine nsmul_ne_zero_of_lt_addOrderOf (pow_ne_zero _ hp.out.ne_zero)
      (hk ▸ Nat.pow_lt_pow_right hp.out.one_lt k.lt_succ_self) ?_
    exact IsNondegenerate.eq_zero_of_forall_pairing_eq_zero _ hA fun y ↦ by
      rw [pairing_nsmul_left, h y]
  obtain ⟨y', hy'p, hxy'⟩ := A.exists_pairing_eq_of_addOrderOf_eq_prime_pow hxk y
  exact ⟨x, y', k, hxk, hkill y' hy'p, hxy' ▸ hy⟩

end FiniteBilinearModule

namespace FiniteQuadraticModule

variable (A : FiniteQuadraticModule.{u})

/-- **The orthogonal splitting of a finite quadratic module** along a subgroup `H` with
nondegenerate restricted pairing: addition `(h, k) ↦ h + k` is an isometry from the orthogonal
product of the restrictions to `H` and to `H⊥` onto `A`. -/
noncomputable def restrictProdOrthogonalComplementIsometry {H : AddSubgroup A}
    (hH : (A.restrict H).IsNondegenerate) :
    Isometry ((A.restrict H).prod (A.restrict (A.toFiniteBilinearModule.orthogonalComplement H)))
      A where
  toLinearEquiv := Submodule.prodEquivOfIsCompl _ _
    (AddSubgroup.toIntSubmodule.isCompl (A.toFiniteBilinearModule.isCompl_orthogonalComplement
      (A.restrict_toFiniteBilinearModule H ▸ hH)))
  map_app' x := by
    -- The cross term of `q(h + k)` is the pairing of `h ∈ H` with `k ∈ H⊥`, which vanishes.
    have hpolar : QuadraticMap.polar A.quadratic x.1.1 x.2.1 = 0 := by
      rw [polar_eq_pairing, A.toFiniteBilinearModule.pairing_comm]
      exact (FiniteBilinearModule.mem_orthogonalComplement_iff _ H _).1 x.2.2 x.1.1 x.1.2
    rw [QuadraticMap.polar, sub_sub, sub_eq_zero] at hpolar
    -- `prodEquivOfIsCompl` adds the two components (`Submodule.coe_prodEquivOfIsCompl'`) and a
    -- restricted quadratic map evaluates `q` on the underlying element (`restrict_quadratic`). Both
    -- hold by `rfl`, and the carrier of `A.restrict H` is not syntactically `H`, so the rewrites
    -- cannot be stated on `x` directly; the goal is `hpolar` up to these two unfoldings.
    rw [QuadraticMap.prod_apply]
    exact hpolar

/-- The orthogonal splitting isometry adds the two components. -/
@[simp]
theorem restrictProdOrthogonalComplementIsometry_apply {H : AddSubgroup A}
    (hH : (A.restrict H).IsNondegenerate)
    (h : H) (k : A.toFiniteBilinearModule.orthogonalComplement H) :
    A.restrictProdOrthogonalComplementIsometry hH (h, k) = (h : A) + k :=
  Submodule.coe_prodEquivOfIsCompl' H.toIntSubmodule
    (A.toFiniteBilinearModule.orthogonalComplement H).toIntSubmodule
    (AddSubgroup.toIntSubmodule.isCompl (A.toFiniteBilinearModule.isCompl_orthogonalComplement
      (A.restrict_toFiniteBilinearModule H ▸ hH))) (h, k)

end FiniteQuadraticModule

end TauCeti
