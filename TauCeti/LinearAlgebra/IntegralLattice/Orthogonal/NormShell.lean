module

public import TauCeti.LinearAlgebra.IntegralLattice.Orthogonal.Pi
public import TauCeti.LinearAlgebra.IntegralLattice.PosDef.Minimum

/-!
# Norm shells of finite orthogonal sums

If each summand of a finite orthogonal sum is generated by its vectors of norm `n`, then
the sum is generated by its vectors of norm `n`. Embed the generating vectors in one
coordinate at a time. In particular, an orthogonal sum of root lattices is generated by roots.
No definiteness or evenness assumption is needed for this spanning argument.

When every nonzero vector in every summand has norm at least `m > 0`, a vector of the orthogonal
sum `⊥ i, L i` of norm `m` cannot have two nonzero coordinates, since their norms would add to at
least `2m > m`. The norm-`m` shell of `⊥ i, L i` is therefore the disjoint union of the norm-`m`
shells of the summands, embedded one coordinate at a time (`piVectorsOfNormEquiv`), and the
representation number `r(m)` adds over the summands (`representationNumber_pi_eq_sum`). In
particular, for an orthogonal sum of even positive definite lattices (`m = 2`), every root lies in
a single summand (`piVectorsOfNormTwoEquiv`) and the number of roots is the sum of the summand
root counts (`representationNumber_pi_two`).

## Main declarations

* `TauCeti.IntegralLattice.span_image_vectorsOfNorm_pi_eq`: spanning by norm-`n` vectors passes to
  finite orthogonal sums.
* `TauCeti.IntegralLattice.mem_vectorsOfNorm_pi_iff` and
  `TauCeti.IntegralLattice.piVectorsOfNormEquiv`: at a positive lower bound `m` on nonzero summand
  norms, the norm-`m` shell of `pi L` splits as `Σ i, (L i).vectorsOfNorm m`.
* `TauCeti.IntegralLattice.representationNumber_pi_eq_sum`: `r_{pi L}(m) = ∑ i, r_{L i}(m)` at
  such a bound `m`.
* `TauCeti.IntegralLattice.mem_vectorsOfNorm_two_pi_iff`,
  `TauCeti.IntegralLattice.piVectorsOfNormTwoEquiv`, and
  `TauCeti.IntegralLattice.representationNumber_pi_two`: the norm-two shell and root count of a
  finite orthogonal sum of even positive definite lattices.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §3.
* W. Ebeling, *Lattices and Codes*, 3rd ed., Chapters 1–2.
-/

public section

namespace TauCeti.IntegralLattice

universe u v

variable {ι : Type v} [Fintype ι] {V : ι → Type u} [∀ i, AddCommGroup (V i)]
  [∀ i, Module ℚ (V i)] (L : ∀ i, IntegralLattice (V i))

/-- If each summand is generated by its norm-`n` vectors, the same holds for their finite
orthogonal sum. The equality is in the rational ambient space. -/
theorem span_image_vectorsOfNorm_pi_eq {n : ℚ}
    (hspan : ∀ i, Submodule.span ℤ
      ((fun x : L i ↦ (x : V i)) '' (L i).vectorsOfNorm n) = (L i).carrier) :
    Submodule.span ℤ ((fun x : pi L ↦ (x : ∀ i, V i)) '' (pi L).vectorsOfNorm n) =
      (pi L).carrier := by
  classical
  refine le_antisymm (Submodule.span_le.mpr ?_) ?_
  · rintro _ ⟨x, -, rfl⟩
    exact x.2
  · conv_lhs => rw [pi_carrier, ← Submodule.iSup_map_single]
    refine iSup_le fun i ↦ ?_
    rw [← hspan i, Submodule.map_span]
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
    exact Submodule.subset_span
      ⟨⟨Pi.single i (x : V i), single_mem_pi_carrier L i x.2⟩,
        mem_vectorsOfNorm.mpr ((norm_pi_single L i x).trans (mem_vectorsOfNorm.mp hx)), rfl⟩

/-! ## Minimal shells of finite orthogonal sums -/

/-- When every nonzero vector in every summand has norm at least `m > 0`, a vector of the
orthogonal sum `pi L` has norm `m` if and only if it is supported in a single coordinate by a
norm-`m` vector of that summand. -/
theorem mem_vectorsOfNorm_pi_iff [DecidableEq ι] {m : ℚ} (hm : 0 < m)
    (hmin : ∀ i (v : L i), v ≠ 0 → m ≤ (L i).norm v) (x : pi L) :
    x ∈ (pi L).vectorsOfNorm m ↔
      ∃ (i : ι) (v : (L i).vectorsOfNorm m), (x : ∀ j, V j) = Pi.single i (v.1 : V i) := by
  constructor
  · intro hx
    have hsum : ∑ j, (L j).norm ((x : ∀ j, V j) j) = m := by
      simpa only [mem_vectorsOfNorm, norm_pi_apply] using hx
    let xc : ∀ j, L j := fun j ↦ ⟨(x : ∀ j, V j) j, (mem_pi_carrier_iff L _).mp x.2 j⟩
    have hnn (j : ι) : 0 ≤ (L j).norm ((x : ∀ k, V k) j) := by
      rcases eq_or_ne (xc j) 0 with hj | hj
      · have hj0 : (x : ∀ k, V k) j = 0 := congrArg Subtype.val hj
        rw [hj0, norm_zero]
      · exact hm.le.trans (hmin j (xc j) hj)
    have hex : ∃ i, xc i ≠ 0 := by
      by_contra! hall
      have h0 : ∑ j, (L j).norm ((x : ∀ j, V j) j) = 0 :=
        Finset.sum_eq_zero fun j _ ↦ by
          have hj0 : (x : ∀ k, V k) j = 0 := congrArg Subtype.val (hall j)
          rw [hj0, norm_zero]
      linarith
    obtain ⟨i, hi⟩ := hex
    have hzero (j : ι) (hji : j ≠ i) : (x : ∀ k, V k) j = 0 := by
      by_contra hj
      have hjc : xc j ≠ 0 := fun h ↦ hj (congrArg Subtype.val h)
      have hpair : (L i).norm ((x : ∀ k, V k) i) + (L j).norm ((x : ∀ k, V k) j) ≤
          ∑ k, (L k).norm ((x : ∀ k, V k) k) :=
        (Finset.sum_pair (f := fun k ↦ (L k).norm ((x : ∀ k, V k) k)) hji.symm).symm.trans_le
          (Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) fun k _ _ ↦ hnn k)
      have hmi : m ≤ (L i).norm ((x : ∀ k, V k) i) := hmin i (xc i) hi
      have hmj : m ≤ (L j).norm ((x : ∀ k, V k) j) := hmin j (xc j) hjc
      linarith
    have hxsingle : (x : ∀ j, V j) = Pi.single i (xc i : V i) := by
      funext j
      rcases eq_or_ne j i with rfl | hji
      · simp [xc]
      · rw [Pi.single_eq_of_ne hji, hzero j hji]
    have hnormi : (L i).norm (xc i) = m := by
      have hx' := mem_vectorsOfNorm.mp hx
      rwa [hxsingle, norm_pi_single] at hx'
    exact ⟨i, ⟨xc i, mem_vectorsOfNorm.mpr hnormi⟩, hxsingle⟩
  · rintro ⟨i, v, hx⟩
    rw [mem_vectorsOfNorm, hx, norm_pi_single]
    exact mem_vectorsOfNorm.mp v.2

/-- **Decomposition of a minimal shell of an orthogonal sum**: when every nonzero vector in every
summand has norm at least `m > 0`, the norm-`m` shell of `pi L` is equivalent to the disjoint union
`Σ i, (L i).vectorsOfNorm m`, embedding each summand vector in its own coordinate. -/
noncomputable def piVectorsOfNormEquiv [DecidableEq ι] {m : ℚ} (hm : 0 < m)
    (hmin : ∀ i (v : L i), v ≠ 0 → m ≤ (L i).norm v) :
    (Σ i, (L i).vectorsOfNorm m) ≃ (pi L).vectorsOfNorm m :=
  Equiv.ofBijective
    (fun s ↦ ⟨⟨Pi.single s.1 (s.2.1 : V s.1), single_mem_pi_carrier L s.1 s.2.1.2⟩,
      mem_vectorsOfNorm.mpr ((norm_pi_single L s.1 s.2.1).trans (mem_vectorsOfNorm.mp s.2.2))⟩)
    ⟨by
      rintro ⟨i, v⟩ ⟨j, w⟩ h
      have hval : (Pi.single i (v.1 : V i) : ∀ k, V k) = Pi.single j (w.1 : V j) :=
        congrArg (fun z : (pi L).vectorsOfNorm m ↦ ((z : pi L) : ∀ k, V k)) h
      have hv0 : (v.1 : V i) ≠ 0 := by
        intro hv0
        have hnorm := mem_vectorsOfNorm.mp v.2
        rw [hv0, norm_zero] at hnorm
        linarith
      have hij : i = j := by
        by_contra hij
        have := congrFun hval i
        rw [Pi.single_eq_same, Pi.single_eq_of_ne hij] at this
        exact hv0 this
      subst hij
      refine Sigma.ext rfl (heq_of_eq (Subtype.ext (Subtype.ext ?_)))
      simpa using congrFun hval i,
    fun x ↦ by
      obtain ⟨i, v, hx⟩ := (mem_vectorsOfNorm_pi_iff L hm hmin x.1).mp x.2
      exact ⟨⟨i, v⟩, Subtype.ext (Subtype.ext hx.symm)⟩⟩

/-- Evaluating `piVectorsOfNormEquiv` embeds a summand shell vector in its coordinate. -/
@[simp]
theorem coe_piVectorsOfNormEquiv_apply [DecidableEq ι] {m : ℚ} (hm : 0 < m)
    (hmin : ∀ i (v : L i), v ≠ 0 → m ≤ (L i).norm v) (s : Σ i, (L i).vectorsOfNorm m) :
    ((piVectorsOfNormEquiv L hm hmin s : pi L) : ∀ j, V j) = Pi.single s.1 (s.2.1 : V s.1) :=
  (rfl)

/-- The inverse of `piVectorsOfNormEquiv` recovers the index and vector of a single-coordinate
shell element. -/
@[simp]
theorem piVectorsOfNormEquiv_symm_single [DecidableEq ι] {m : ℚ} (hm : 0 < m)
    (hmin : ∀ i (v : L i), v ≠ 0 → m ≤ (L i).norm v) (i : ι) (v : (L i).vectorsOfNorm m) :
    (piVectorsOfNormEquiv L hm hmin).symm
      ⟨⟨Pi.single i (v.1 : V i), single_mem_pi_carrier L i v.1.2⟩,
        mem_vectorsOfNorm.mpr ((norm_pi_single L i v.1).trans (mem_vectorsOfNorm.mp v.2))⟩ =
      ⟨i, v⟩ :=
  (piVectorsOfNormEquiv L hm hmin).injective (by ext; simp)

/-- **Additivity of minimal-shell representation numbers**: when every nonzero vector in every
summand has norm at least `m > 0`, the representation number `r_{pi L}(m)` is the sum of the
summand representation numbers `r_{L i}(m)`. -/
theorem representationNumber_pi_eq_sum {m : ℚ} (hm : 0 < m)
    (hmin : ∀ i (v : L i), v ≠ 0 → m ≤ (L i).norm v) :
    (pi L).representationNumber m = ∑ i, (L i).representationNumber m := by
  classical
  have hfin (i : ι) : Finite ((L i).vectorsOfNorm m) := by
    have hpos : (L i).integralNorm.PosDef := fun v hv ↦ by
      have hlt : (0 : ℚ) < (L i).norm v := hm.trans_le (hmin i v hv)
      rw [← (L i).integralNorm_cast v] at hlt
      exact_mod_cast hlt
    exact (hpos.finite_setOf_apply_le ⌊m⌋).subset fun v hv ↦ by
      simp only [mem_vectorsOfNorm, Set.mem_ofPred_eq] at hv ⊢
      rw [Int.le_floor, (L i).integralNorm_cast, hv]
  rw [representationNumber_def, ← Nat.card_coe_set_eq,
    ← Nat.card_congr (piVectorsOfNormEquiv L hm hmin), Nat.card_sigma]
  exact Finset.sum_congr rfl fun i _ ↦
    (Nat.card_coe_set_eq _).trans ((L i).representationNumber_def m).symm

/-! ## Norm-two shells of even positive definite orthogonal sums -/

omit [Fintype ι] in
private theorem two_le_norm_of_isEven_isPosDef {L : ∀ i, IntegralLattice (V i)}
    (he : ∀ i, (L i).IsEven) (hp : ∀ i, (L i).IsPosDef) (i : ι) (v : L i) (hv : v ≠ 0) :
    (2 : ℚ) ≤ (L i).norm v := by
  have : Nontrivial (L i) := nontrivial_of_ne v 0 hv
  have h2 : (2 : ℤ) ≤ (L i).integralNorm v :=
    (Int.ofNat_le.mpr ((hp i).two_le_minimum (he i))).trans
      ((hp i).isPosSemidef.minimum_le_integralNorm hv)
  rw [← (L i).integralNorm_cast v]
  exact_mod_cast h2

/-- In a finite orthogonal sum of even positive definite lattices, a vector has norm `2` if and
only if it is supported in a single coordinate by a root of that summand. -/
theorem mem_vectorsOfNorm_two_pi_iff [DecidableEq ι] (he : ∀ i, (L i).IsEven)
    (hp : ∀ i, (L i).IsPosDef) (x : pi L) :
    x ∈ (pi L).vectorsOfNorm 2 ↔
      ∃ (i : ι) (v : (L i).vectorsOfNorm 2), (x : ∀ j, V j) = Pi.single i (v.1 : V i) :=
  mem_vectorsOfNorm_pi_iff L two_pos (two_le_norm_of_isEven_isPosDef he hp) x

/-- **The roots of a finite orthogonal sum of even positive definite lattices** are the disjoint
union of the roots of the summands, embedded coordinate by coordinate. -/
noncomputable def piVectorsOfNormTwoEquiv [DecidableEq ι] (he : ∀ i, (L i).IsEven)
    (hp : ∀ i, (L i).IsPosDef) :
    (Σ i, (L i).vectorsOfNorm 2) ≃ (pi L).vectorsOfNorm 2 :=
  piVectorsOfNormEquiv L two_pos (two_le_norm_of_isEven_isPosDef he hp)

/-- Evaluating `piVectorsOfNormTwoEquiv` embeds a summand root in its coordinate. -/
@[simp]
theorem coe_piVectorsOfNormTwoEquiv_apply [DecidableEq ι] (he : ∀ i, (L i).IsEven)
    (hp : ∀ i, (L i).IsPosDef) (s : Σ i, (L i).vectorsOfNorm 2) :
    ((piVectorsOfNormTwoEquiv L he hp s : pi L) : ∀ j, V j) = Pi.single s.1 (s.2.1 : V s.1) :=
  (rfl)

/-- The inverse of `piVectorsOfNormTwoEquiv` recovers the index and root of a single-coordinate
root. -/
@[simp]
theorem piVectorsOfNormTwoEquiv_symm_single [DecidableEq ι] (he : ∀ i, (L i).IsEven)
    (hp : ∀ i, (L i).IsPosDef) (i : ι) (v : (L i).vectorsOfNorm 2) :
    (piVectorsOfNormTwoEquiv L he hp).symm
      ⟨⟨Pi.single i (v.1 : V i), single_mem_pi_carrier L i v.1.2⟩,
        mem_vectorsOfNorm.mpr ((norm_pi_single L i v.1).trans (mem_vectorsOfNorm.mp v.2))⟩ =
      ⟨i, v⟩ :=
  piVectorsOfNormEquiv_symm_single L two_pos (two_le_norm_of_isEven_isPosDef he hp) i v

/-- **The root count of a finite orthogonal sum of even positive definite lattices** is the sum of
the root counts of the summands. -/
theorem representationNumber_pi_two (he : ∀ i, (L i).IsEven) (hp : ∀ i, (L i).IsPosDef) :
    (pi L).representationNumber 2 = ∑ i, (L i).representationNumber 2 :=
  representationNumber_pi_eq_sum L two_pos (two_le_norm_of_isEven_isPosDef he hp)

end TauCeti.IntegralLattice
