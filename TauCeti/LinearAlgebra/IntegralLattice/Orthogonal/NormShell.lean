module

public import TauCeti.LinearAlgebra.IntegralLattice.Orthogonal.RepresentationNumber
public import TauCeti.LinearAlgebra.IntegralLattice.PosDef.Minimum

/-!
# Norm shells of orthogonal sums

If each summand of a finite orthogonal sum is generated by its vectors of norm `n`, then
the sum is generated by its vectors of norm `n`. Embed the generating vectors in one
coordinate at a time. In particular, an orthogonal sum of root lattices is generated by roots.
No definiteness or evenness assumption is needed for this spanning argument.

When every summand is even and positive definite, every nonzero summand vector has norm at least
`2`, so a norm-`2` vector of the sum, a root, has exactly one nonzero coordinate
(`exists_eq_single_of_mem_vectorsOfNorm_two_pi`). Hence the roots of the sum are the roots of the
summands, each placed in its own coordinate, and the number of roots of the sum is the sum of the
numbers of roots of the summands (`representationNumber_pi_two`).
-/

public section

namespace TauCeti.IntegralLattice

universe u v

variable {ι : Type v} [Fintype ι] {V : ι → Type u} [∀ i, AddCommGroup (V i)]
  [∀ i, Module ℚ (V i)] (L : ∀ i, IntegralLattice (V i))

/-- If each summand is generated by its norm-`n` vectors, the same holds for their finite
orthogonal sum. The equality is in the rational ambient space. -/
theorem span_image_vectorsOfNorm_pi_eq {n : ℚ}
    (hspan : ∀ i, Submodule.span ℤ
      ((fun x : L i ↦ (x : V i)) '' (L i).vectorsOfNorm n) = (L i).carrier) :
    Submodule.span ℤ ((fun x : pi L ↦ (x : ∀ i, V i)) '' (pi L).vectorsOfNorm n) =
      (pi L).carrier := by
  classical
  refine le_antisymm (Submodule.span_le.mpr ?_) ?_
  · rintro _ ⟨x, -, rfl⟩
    exact x.2
  · conv_lhs => rw [pi_carrier, ← Submodule.iSup_map_single]
    refine iSup_le fun i ↦ ?_
    rw [← hspan i, Submodule.map_span]
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
    exact Submodule.subset_span
      ⟨⟨Pi.single i (x : V i), single_mem_pi_carrier L i x.2⟩,
        mem_vectorsOfNorm.mpr ((norm_pi_single L i x).trans (mem_vectorsOfNorm.mp hx)), rfl⟩

/-! ### Roots of an orthogonal sum of even positive definite lattices -/

variable {L}

/-- **A root of an orthogonal sum of even positive definite lattices lies in one summand**: a
norm-`2` vector of the sum is a norm-`2` vector of a single summand, placed in its coordinate. -/
theorem exists_eq_single_of_mem_vectorsOfNorm_two_pi [DecidableEq ι]
    (hp : ∀ i, (L i).IsPosDef) (he : ∀ i, (L i).IsEven) {x : pi L}
    (hx : x ∈ (pi L).vectorsOfNorm 2) :
    ∃ i, ∃ y ∈ (L i).vectorsOfNorm 2, (x : ∀ i, V i) = Pi.single i (y : V i) := by
  obtain ⟨i, y, hy, hxy⟩ := exists_eq_single_of_norm_pi_eq L (by norm_num)
    (fun i y hy ↦ by
      rw [← integralNorm_cast]
      exact_mod_cast (hp i).two_le_integralNorm (he i) hy)
    x (mem_vectorsOfNorm.mp hx)
  exact ⟨i, y, mem_vectorsOfNorm.mpr hy, hxy⟩

/-- **The number of roots of an orthogonal sum of even positive definite lattices is the sum of
the numbers of roots of the summands**: `r_{⊥ L_i}(2) = ∑ i, r_{L_i}(2)`. -/
theorem representationNumber_pi_two (hp : ∀ i, (L i).IsPosDef) (he : ∀ i, (L i).IsEven) :
    (pi L).representationNumber 2 = ∑ i, (L i).representationNumber 2 := by
  apply representationNumber_pi_of_le_norm L (by norm_num)
  · intro i x hx
    rw [← integralNorm_cast]
    exact_mod_cast (hp i).two_le_integralNorm (he i) hx
  · exact fun i ↦ (hp i).finite_vectorsOfNorm 2

end TauCeti.IntegralLattice
