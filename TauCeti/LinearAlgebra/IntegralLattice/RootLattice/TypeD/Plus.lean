module

public import TauCeti.LinearAlgebra.IntegralLattice.Overlattice.Index
public import TauCeti.LinearAlgebra.IntegralLattice.Overlattice.Dual
public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeD.Basic

/-!
# Spinor glue lattices `Dₙ⁺`

For positive `n` divisible by eight, adjoining the spinor vector
`s = (1/2, …, 1/2)` to the checkerboard lattice constructs the positive definite even
unimodular lattice `Dₙ⁺`. Its carrier is literally `Dₙ ∪ (s + Dₙ)`.
In positive rank the order-two spinor subgroup is quadratic-isotropic and
Lagrangian; the general gluing theorem therefore proves unimodularity.
In particular, the construction supplies `D₁₆⁺`, while at rank eight it is the
coordinate model of `E₈`. The rank-zero lattice is included as well.

The subgroup and intermediate carrier are defined in every rank. The two-coset
description needs even rank,
and the index-two description needs even positive rank; quadratic isotropy needs
exactly divisibility by eight.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, §4.8.1.
* V. V. Nikulin, *Integral symmetric bilinear forms and some of their applications*,
  Proposition 1.4.1.
* W. Ebeling, *Lattices and Codes*, Chapter 3.
-/

public section

namespace TauCeti.IntegralLattice

variable (n : ℕ)

/-- The subgroup generated by the spinor class in the discriminant group of `Dₙ`. -/
noncomputable def checkerboardSpinorSubgroup :
    AddSubgroup (checkerboardLattice n).DiscriminantGroup :=
  AddSubgroup.zmultiples (checkerboardSpinorClass n)

/-- In even rank the spinor subgroup consists of zero and the spinor class. -/
@[simp]
theorem mem_checkerboardSpinorSubgroup_iff (hn : Even n)
    (x : (checkerboardLattice n).DiscriminantGroup) :
    x ∈ checkerboardSpinorSubgroup n ↔ x = 0 ∨ x = checkerboardSpinorClass n := by
  rw [checkerboardSpinorSubgroup]
  exact mem_zmultiples_checkerboardSpinorClass_iff n hn x

/-- The spinor subgroup has order two in even positive rank. -/
theorem natCard_checkerboardSpinorSubgroup [NeZero n] (hn : Even n) :
    Nat.card (checkerboardSpinorSubgroup n) = 2 := by
  rw [checkerboardSpinorSubgroup, Nat.card_zmultiples,
    addOrderOf_checkerboardSpinorClass_of_even n hn]

/-- The inverse image of the spinor subgroup in the dual of the checkerboard lattice. -/
noncomputable def checkerboardPlusCarrier : (checkerboardLattice n).IntermediateCarrier :=
  (checkerboardLattice n).intermediateCarrierOfDiscriminantSubgroup
    (checkerboardSpinorSubgroup n)

/-- In even rank, the spinor enlargement is the union of `Dₙ` and its spinor coset. -/
@[simp]
theorem mem_checkerboardPlusCarrier_iff (hn : Even n) (x : Fin n → ℚ) :
    x ∈ (checkerboardPlusCarrier n).1 ↔
      x ∈ (checkerboardLattice n).carrier ∨
        x - checkerboardSpinor n ∈ (checkerboardLattice n).carrier := by
  rw [checkerboardPlusCarrier,
    (checkerboardLattice n).mem_intermediateCarrierOfDiscriminantSubgroup_iff]
  constructor
  · rintro ⟨hxdual, hx⟩
    rw [mem_checkerboardSpinorSubgroup_iff n hn] at hx
    rcases hx with hx | hx
    · left
      exact ((checkerboardLattice n).discriminantGroup_mk_eq_zero_iff
        ⟨x, hxdual⟩).mp hx
    · right
      rw [checkerboardSpinorClass_def] at hx
      exact ((checkerboardLattice n).discriminantGroup_mk_eq_iff
        ⟨x, hxdual⟩ ⟨checkerboardSpinor n, checkerboardSpinor_mem_dualCarrier⟩).mp hx
  · rintro (hx | hx)
    · have hxdual := (checkerboardLattice n).le_dualCarrier hx
      refine ⟨hxdual, ?_⟩
      rw [mem_checkerboardSpinorSubgroup_iff n hn]
      left
      exact ((checkerboardLattice n).discriminantGroup_mk_eq_zero_iff
        ⟨x, hxdual⟩).mpr hx
    · have hxdiff := (checkerboardLattice n).le_dualCarrier hx
      have hxdual : x ∈ (checkerboardLattice n).dualCarrier := by
        have hadd := (checkerboardLattice n).dualCarrier.add_mem hxdiff
          checkerboardSpinor_mem_dualCarrier
        simpa only [sub_add_cancel] using hadd
      refine ⟨hxdual, ?_⟩
      rw [mem_checkerboardSpinorSubgroup_iff n hn]
      right
      rw [checkerboardSpinorClass_def]
      exact ((checkerboardLattice n).discriminantGroup_mk_eq_iff
        ⟨x, hxdual⟩ ⟨checkerboardSpinor n, checkerboardSpinor_mem_dualCarrier⟩).mpr hx

/-- The subgroup recovered from the spinor enlargement is the spinor subgroup. -/
@[simp]
theorem discriminantSubgroup_checkerboardPlusCarrier :
    (checkerboardLattice n).discriminantSubgroup (checkerboardPlusCarrier n) =
      checkerboardSpinorSubgroup n := by
  rw [checkerboardPlusCarrier,
    (checkerboardLattice n).discriminantSubgroup_intermediateCarrierOfDiscriminantSubgroup]

/-- The spinor class is quadratic-isotropic exactly in ranks divisible by eight. -/
theorem discriminantQuadraticMap_checkerboardSpinorClass_eq_zero_iff :
    (checkerboardLattice n).discriminantQuadraticMap (isEven_checkerboardLattice n)
      (checkerboardSpinorClass n) = 0 ↔ 8 ∣ n := by
  rw [discriminantQuadraticMap_checkerboardSpinorClass,
    AddCircle.coe_eq_zero_iff_mem_one, Submodule.mem_one]
  constructor
  · rintro ⟨z, hz⟩
    simp only [algebraMap_int_eq, Int.coe_castRingHom] at hz
    have h : (n : ℤ) = 8 * z := by
      have hq : (n : ℚ) = 8 * z := by linarith
      exact_mod_cast hq
    exact Int.natCast_dvd_natCast.mp ⟨z, h⟩
  · rintro ⟨k, rfl⟩
    exact ⟨k, by push_cast; ring⟩

/-- The spinor subgroup is quadratic-isotropic exactly in ranks divisible by eight. -/
@[simp]
theorem isIsotropic_checkerboardSpinorSubgroup_iff :
    ((checkerboardLattice n).discriminantQuadraticModule
      (isEven_checkerboardLattice n)).IsIsotropic (checkerboardSpinorSubgroup n) ↔ 8 ∣ n := by
  rw [← (checkerboardLattice n).isEven_intermediateCarrierOfDiscriminantSubgroup_iff
    (isEven_checkerboardLattice n),
    IntermediateCarrier.isEven_iff_forall_discriminantQuadraticMap_eq_zero
      (isEven_checkerboardLattice n),
    discriminantSubgroup_intermediateCarrierOfDiscriminantSubgroup]
  constructor
  · intro h
    exact (discriminantQuadraticMap_checkerboardSpinorClass_eq_zero_iff n).mp
      (h _ (AddSubgroup.mem_zmultiples _))
  · intro hn x hx
    obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
    rw [QuadraticMap.map_smul]
    simp [(discriminantQuadraticMap_checkerboardSpinorClass_eq_zero_iff n).mpr hn]

/-- In ranks divisible by eight, the spinor enlargement is even. -/
theorem isEven_checkerboardPlusCarrier (hn : 8 ∣ n) :
    IntermediateCarrier.IsEven (checkerboardPlusCarrier n) := by
  rw [checkerboardPlusCarrier,
    (checkerboardLattice n).isEven_intermediateCarrierOfDiscriminantSubgroup_iff]
  exact (isIsotropic_checkerboardSpinorSubgroup_iff n).mpr hn

/-- In ranks divisible by eight, the spinor subgroup is Lagrangian. -/
theorem isLagrangian_checkerboardSpinorSubgroup (hn : 8 ∣ n) :
    ((checkerboardLattice n).discriminantQuadraticModule
      (isEven_checkerboardLattice n)).IsLagrangian (checkerboardSpinorSubgroup n) := by
  have hcard : Nat.card (checkerboardSpinorSubgroup n) ^ 2 =
      Nat.card (checkerboardLattice n).DiscriminantGroup := by
    by_cases hzero : n = 0
    · subst n
      simp
    have : NeZero n := ⟨hzero⟩
    rw [natCard_checkerboardSpinorSubgroup n (even_iff_two_dvd.mpr
      (dvd_trans (by decide) hn)), natCard_discriminantGroup_checkerboardLattice]
    norm_num
  exact FiniteQuadraticModule.IsIsotropic.isLagrangian_of_card_sq_eq _
    ((isIsotropic_checkerboardSpinorSubgroup_iff n).mpr hn)
    ((checkerboardLattice n).isNondegenerate_discriminantQuadraticModule
      (isEven_checkerboardLattice n)) hcard

/-- The positive definite even unimodular spinor glue lattice `Dₙ⁺`, for `8 ∣ n`. -/
noncomputable def checkerboardPlusLattice (hn : 8 ∣ n) : IntegralLattice (Fin n → ℚ) :=
  (isEven_checkerboardPlusCarrier n hn).isIntegral.toIntegralLattice

/-- The general intermediate-carrier construction recovers `Dₙ⁺`. -/
theorem toIntegralLattice_eq_checkerboardPlusLattice (hn : 8 ∣ n)
    (h : IntermediateCarrier.IsEven
      ((checkerboardLattice n).intermediateCarrierOfDiscriminantSubgroup
        (checkerboardSpinorSubgroup n))) :
    h.isIntegral.toIntegralLattice = checkerboardPlusLattice n hn := (rfl)

/-- The carrier of `Dₙ⁺` is the inverse image of the spinor subgroup. -/
@[simp]
theorem checkerboardPlusLattice_carrier (hn : 8 ∣ n) :
    (checkerboardPlusLattice n hn).carrier = (checkerboardPlusCarrier n).1 := by
  rw [checkerboardPlusLattice, IntermediateCarrier.IsIntegral.toIntegralLattice_carrier]

/-- The form of `Dₙ⁺` is the standard dot product inherited from `Dₙ`. -/
@[simp]
theorem checkerboardPlusLattice_form (hn : 8 ∣ n) :
    (checkerboardPlusLattice n hn).form = (checkerboardLattice n).form := by
  rw [checkerboardPlusLattice, IntermediateCarrier.IsIntegral.toIntegralLattice_form]

/-- The spinor glue lattice is nondegenerate. -/
instance instIsNondegenerateCheckerboardPlusLattice (hn : 8 ∣ n) :
    (checkerboardPlusLattice n hn).IsNondegenerate := by
  rw [checkerboardPlusLattice]
  infer_instance

/-- The spinor glue lattice is even. -/
theorem isEven_checkerboardPlusLattice (hn : 8 ∣ n) :
    (checkerboardPlusLattice n hn).IsEven :=
  (isEven_checkerboardPlusCarrier n hn).isEven_toIntegralLattice

/-- The spinor enlargement has index two in even positive rank. -/
theorem index_checkerboardPlusCarrier [NeZero n] (hn : Even n) :
    IntermediateCarrier.index (checkerboardPlusCarrier n) = 2 := by
  rw [checkerboardPlusCarrier, IntermediateCarrier.index_intermediateCarrierOfDiscriminantSubgroup,
    natCard_checkerboardSpinorSubgroup n hn]

/-- The spinor glue lattice is positive definite. -/
theorem isPosDef_checkerboardPlusLattice (hn : 8 ∣ n) :
    (checkerboardPlusLattice n hn).IsPosDef :=
  (isEven_checkerboardPlusCarrier n hn).isIntegral.isPosDef_toIntegralLattice_iff.mpr
    (isPosDef_checkerboardLattice n)

/-- The spinor glue lattice is unimodular, by gluing along a Lagrangian. -/
theorem isUnimodular_checkerboardPlusLattice (hn : 8 ∣ n) :
    (checkerboardPlusLattice n hn).IsUnimodular := by
  rw [checkerboardPlusLattice,
    IntermediateCarrier.IsIntegral.isUnimodular_toIntegralLattice_iff_isLagrangian,
    discriminantSubgroup_checkerboardPlusCarrier]
  exact (isLagrangian_checkerboardSpinorSubgroup n hn).toFiniteBilinearModule

/-- The spinor glue lattice has discriminant one. -/
@[simp]
theorem discriminant_checkerboardPlusLattice (hn : 8 ∣ n) :
    (checkerboardPlusLattice n hn).discriminant = 1 :=
  (checkerboardPlusLattice n hn).isUnimodular_iff_discriminant_eq_one.mp
    (isUnimodular_checkerboardPlusLattice n hn)

/-- The rank of `Dₙ⁺` is `n`. -/
@[simp]
theorem finrank_checkerboardPlusLattice (hn : 8 ∣ n) :
    Module.finrank ℤ (checkerboardPlusLattice n hn) = n := by
  rw [finrank_carrier]
  simp

end TauCeti.IntegralLattice
