/-!
# Shortest vectors in the discriminant cosets of `Aₙ`

The discriminant group of the root lattice `Aₙ` is cyclic of order `n + 1`, generated by the class
of the first fundamental weight `ω₁`; the class `[k] = k ω₁` is the Conway–Sloane glue label `k`
of an `Aₙ` component.  This file computes the minimum norm of every class and identifies and counts
all dual vectors attaining it:

```text
min {⟨x, x⟩ | x ∈ Aₙ^∨, x + Aₙ = k ω₁ + Aₙ} = k (n + 1 - k) / (n + 1)      (0 ≤ k ≤ n + 1).
```

The computation takes place in the classical coordinates `Aₙ = {y ∈ ℤ^{n+1} | ∑ yⱼ = 0}`, in
which `ω₁` is `e₀ - (1 / (n + 1)) (1, …, 1)`.  A vector of the class `k ω₁` is then a vector `y`
of coordinate sum zero with `yⱼ = mⱼ - k / (n + 1)` for integers `mⱼ`, and the coordinate sum
forces `∑ mⱼ = k`.  Expanding the squares gives the exact identity

```text
∑ yⱼ² = k (n + 1 - k) / (n + 1) + ∑ mⱼ (mⱼ - 1),
```

whose error term is a sum of the nonnegative integers `mⱼ (mⱼ - 1)`.  So the displayed value is a
lower bound, and it is attained exactly when every `mⱼ` is `0` or `1`: for `0 ≤ k ≤ n + 1`, the
minimal vectors of the class `k ω₁` are the `(n + 1).choose k` coordinate permutations of
`zeroSumCosetMinimizer n k`, which has `k` coordinates equal to `(n + 1 - k) / (n + 1)` and the
remaining `n + 1 - k` coordinates equal to `-k / (n + 1)`.

The minima are stated as `IsLeast` over the norms of the actual dual-lattice vectors in each
discriminant class, so they record attainment as well as the lower bound.  They are the
shortest-norm values attached to the glue labels of an `Aₙ` component, the input for bounding the
norm of a glue vector in an orthogonal sum of root lattices.

## Main definitions and results

* `TauCeti.IntegralLattice.dotProduct_self_eq_mul_sub_div_add_sum`,
  `TauCeti.IntegralLattice.mul_sub_div_le_dotProduct_self`,
  `TauCeti.IntegralLattice.dotProduct_self_eq_mul_sub_div_iff`: the exact norm identity, lower
  bound, and coordinatewise equality criterion in classical coordinates.
* `TauCeti.IntegralLattice.zeroSumCosetMinimizer`: for `k ≤ n + 1`, the canonical coset minimizer
  of `k ω₁` in `ℚ^{n+1}`, with `(n + 1 - k) / (n + 1)` in the first `k` coordinates and
  `-k / (n + 1)` in the remaining `n + 1 - k` coordinates (extended as a total function for
  `k > n + 1`).
* `sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_map_univ_eq`,
  `sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_exists_finset`,
  `sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_exists_perm`,
  `TauCeti.IntegralLattice.ncard_sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq`:
  rearrangement characterizations (via coordinate multiset, `k`-element subset indicators, and
  index permutations) and exact count `(n + 1).choose k` in classical coordinates.
* `TauCeti.IntegralLattice.exists_mk_eq_nsmul_typeAFundamentalWeightClass_and_apply_eq`,
  `TauCeti.IntegralLattice.isLeast_form_self_nsmul_typeAFundamentalWeightClass`,
  `TauCeti.IntegralLattice.isLeast_form_self_typeADiscriminantGroupEquiv`: attainment and minimum
  norm of the discriminant classes `k ω₁` (for `k ≤ n + 1`) and `typeADiscriminantGroupEquiv n a`
  in `typeARootLattice n`.
* `TauCeti.IntegralLattice.isLeast_form_self_nsmul_zeroSumFundamentalWeightClass`,
  `TauCeti.IntegralLattice.isLeast_form_self_zeroSumDiscriminantGroupEquiv`,
  `mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_map_univ_eq`,
  `mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_exists_finset`,
  `mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_exists_perm`,
  `TauCeti.IntegralLattice.mk_eq_zeroSumDiscriminantGroupEquiv_and_form_self_eq_iff_exists_perm`,
  `TauCeti.IntegralLattice.ncard_mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq`,
  `TauCeti.IntegralLattice.ncard_mk_eq_zeroSumDiscriminantGroupEquiv_and_form_self_eq`:
  coset minima, minimizer characterizations, and counts `(n + 1).choose k` in `zeroSumLattice n`.
* `mk_eq_nsmul_typeAFundamentalWeightClass_and_form_self_eq_iff_map_univ_eq`,
  `mk_eq_nsmul_typeAFundamentalWeightClass_and_form_self_eq_iff_exists_finset`,
  `mk_eq_nsmul_typeAFundamentalWeightClass_and_form_self_eq_iff_exists_perm`,
  `TauCeti.IntegralLattice.mk_eq_typeADiscriminantGroupEquiv_and_form_self_eq_iff_exists_perm`,
  `TauCeti.IntegralLattice.ncard_mk_eq_nsmul_typeAFundamentalWeightClass_and_form_self_eq`,
  `TauCeti.IntegralLattice.ncard_mk_eq_typeADiscriminantGroupEquiv_and_form_self_eq`:
  minimizer characterizations and counts in `typeARootLattice n`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, Chapter 4, §6.1 and
  Chapter 16, §1.
-/

public section

namespace TauCeti.IntegralLattice

open Finset Matrix

section ClassicalBound

variable {n : ℕ}

/-! ## The coset bound in classical coordinates -/

/-- **The norm identity of the cosets of `Aₙ`.** If `x` has coordinate sum zero and
`xⱼ = mⱼ - k / (n + 1)` with integers `mⱼ`, then
`∑ xⱼ² = k (n + 1 - k) / (n + 1) + ∑ mⱼ (mⱼ - 1)`. -/
theorem dotProduct_self_eq_mul_sub_div_add_sum {k : ℤ} {x : Fin (n + 1) → ℚ}
    (hx : ∑ j, x j = 0) {m : Fin (n + 1) → ℤ} (hm : ∀ j, x j = m j - k / (n + 1)) :
    x ⬝ᵥ x = k * (n + 1 - k) / (n + 1) + ∑ j, (m j : ℚ) * (m j - 1) := by
  have hn : (n : ℚ) + 1 ≠ 0 := by positivity
  -- The coordinate sum `∑ (mⱼ - k / (n + 1)) = 0` forces `∑ mⱼ = k`.
  have hmsum : ∑ j, (m j : ℚ) = k := by
    simp only [hm, sum_sub_distrib, sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul,
      Nat.cast_add, Nat.cast_one] at hx
    field_simp at hx
    linarith
  have hsq (j : Fin (n + 1)) : x j * x j =
      (m j : ℚ) * (m j - 1) + (1 - 2 * (k / (n + 1))) * m j + (k / (n + 1)) ^ 2 := by
    rw [hm j]
    ring
  simp only [dotProduct, hsq, sum_add_distrib, ← mul_sum, hmsum, sum_const, card_univ,
    Fintype.card_fin, nsmul_eq_mul, Nat.cast_add, Nat.cast_one]
  field_simp
  ring

/-- **The coset bound for `Aₙ` in classical coordinates.** A vector of `ℚ^{n+1}` with coordinate
sum zero whose coordinates all lie in `ℤ - k / (n + 1)` has norm at least
`k (n + 1 - k) / (n + 1)`. -/
theorem mul_sub_div_le_dotProduct_self {k : ℤ} {x : Fin (n + 1) → ℚ} (hx : ∑ j, x j = 0)
    (hint : ∀ j, ∃ m : ℤ, x j = m - k / (n + 1)) :
    k * (n + 1 - k) / (n + 1) ≤ x ⬝ᵥ x := by
  choose m hm using hint
  rw [dotProduct_self_eq_mul_sub_div_add_sum hx hm, le_add_iff_nonneg_right]
  exact sum_nonneg fun j _ ↦ by exact_mod_cast Int.zero_le_mul_sub_one (m j)

/-- **The vectors attaining the coset bound for `Aₙ`.** A vector of `ℚ^{n+1}` with coordinate sum
zero whose coordinates all lie in `ℤ - k / (n + 1)` has norm `k (n + 1 - k) / (n + 1)` exactly
when each of its coordinates is `-k / (n + 1)` or `1 - k / (n + 1)`. -/
theorem dotProduct_self_eq_mul_sub_div_iff {k : ℤ} {x : Fin (n + 1) → ℚ} (hx : ∑ j, x j = 0)
    (hint : ∀ j, ∃ m : ℤ, x j = m - k / (n + 1)) :
    x ⬝ᵥ x = k * (n + 1 - k) / (n + 1) ↔
      ∀ j, x j = -(k / (n + 1)) ∨ x j = 1 - k / (n + 1) := by
  choose m hm using hint
  rw [dotProduct_self_eq_mul_sub_div_add_sum hx hm, add_eq_left,
    sum_eq_zero_iff_of_nonneg fun j _ ↦ by exact_mod_cast Int.zero_le_mul_sub_one (m j)]
  refine forall_congr' fun j ↦ ?_
  rw [imp_iff_right (mem_univ j), hm j, mul_eq_zero, sub_eq_zero]
  constructor <;> rintro (h | h) <;> [left; right; left; right] <;> linarith

end ClassicalBound

/-! ## The canonical coset minimizer and rearrangement in classical coordinates -/

/-- **The canonical coset minimizer of the discriminant class `k ω₁` of `Aₙ` in classical
coordinates**, for `k ≤ n + 1`: the vector of `ℚ^{n+1}` with `(n + 1 - k) / (n + 1)` in the first
`k` coordinates and `-k / (n + 1)` in the remaining `n + 1 - k` coordinates. For `k > n + 1` the
same conditional formula gives a total extension (constant `(n + 1 - k) / (n + 1)`, not in the
zero-sum hyperplane). -/
def zeroSumCosetMinimizer (n k : ℕ) (j : Fin (n + 1)) : ℚ :=
  if (j : ℕ) < k then ((n : ℚ) + 1 - k) / (n + 1) else -(k : ℚ) / (n + 1)

/-- Evaluation of `zeroSumCosetMinimizer` as a conditional expression. -/
theorem zeroSumCosetMinimizer_apply (n k : ℕ) (j : Fin (n + 1)) :
    zeroSumCosetMinimizer n k j =
      if (j : ℕ) < k then ((n : ℚ) + 1 - k) / (n + 1) else -(k : ℚ) / (n + 1) :=
  (rfl)

@[simp]
theorem zeroSumCosetMinimizer_of_lt {n k : ℕ} {j : Fin (n + 1)} (hj : (j : ℕ) < k) :
    zeroSumCosetMinimizer n k j = ((n : ℚ) + 1 - k) / (n + 1) :=
  ite_eq_left hj

@[simp]
theorem zeroSumCosetMinimizer_of_le {n k : ℕ} {j : Fin (n + 1)} (hj : k ≤ (j : ℕ)) :
    zeroSumCosetMinimizer n k j = -(k : ℚ) / (n + 1) :=
  ite_eq_right (not_lt.mpr hj)

/-- `zeroSumCosetMinimizer` written in the form `(0 or 1) - k / (n + 1)`. -/
theorem zeroSumCosetMinimizer_eq_ite_sub (n k : ℕ) (j : Fin (n + 1)) :
    zeroSumCosetMinimizer n k j = (if (j : ℕ) < k then 1 else 0) - (k : ℚ) / (n + 1) := by
  have hn : (n : ℚ) + 1 ≠ 0 := by positivity
  rw [zeroSumCosetMinimizer_apply]
  split_ifs
  · field_simp
  · field_simp; ring

@[simp]
theorem zeroSumCosetMinimizer_zero (n : ℕ) : zeroSumCosetMinimizer n 0 = 0 := by
  ext j
  simp

@[simp]
theorem zeroSumCosetMinimizer_succ_self (n : ℕ) : zeroSumCosetMinimizer n (n + 1) = 0 := by
  ext j
  rw [zeroSumCosetMinimizer_of_lt j.isLt, Pi.zero_apply]
  push_cast
  ring

/-- The two coordinate values `(n + 1 - k) / (n + 1)` and `-k / (n + 1)` differ by `1`, hence are
distinct for all `n` and `k`. -/
private theorem sub_div_ne_neg_div (n k : ℕ) :
    ((n : ℚ) + 1 - k) / (n + 1) ≠ -(k : ℚ) / (n + 1) := by
  have hn : (n : ℚ) + 1 ≠ 0 := by positivity
  intro h
  have h1 : (((n : ℚ) + 1 - k) / (n + 1) - (-(k : ℚ) / (n + 1))) * (n + 1) = 0 := by
    rw [h, sub_self, zero_mul]
  field_simp at h1
  linarith

section ClassicalMinimizers

variable {n k : ℕ}

/-- For `k ≤ n + 1`, the multiset of coordinates of `zeroSumCosetMinimizer n k` consists of `k`
copies of `(n + 1 - k) / (n + 1)` and `n + 1 - k` copies of `-k / (n + 1)`. -/
theorem map_univ_zeroSumCosetMinimizer (hk : k ≤ n + 1) :
    Finset.univ.val.map (zeroSumCosetMinimizer n k) =
      Multiset.replicate k (((n : ℚ) + 1 - k) / (n + 1)) +
        Multiset.replicate (n + 1 - k) (-(k : ℚ) / (n + 1)) := by
  let s : Finset (Fin (n + 1)) := univ.filter fun j : Fin (n + 1) ↦ (j : ℕ) < k
  have hs : s.card = k := by
    simp [s, Fin.card_filter_val_lt, min_eq_right hk]
  have hfun : zeroSumCosetMinimizer n k =
      fun j ↦ if j ∈ s then ((n : ℚ) + 1 - k) / (n + 1) else -(k : ℚ) / (n + 1) := by
    ext j
    simp [zeroSumCosetMinimizer_apply, s]
  rw [hfun, Multiset.map_univ_ite_mem, hs, Fintype.card_fin]

/-- For `k ≤ n + 1`, `zeroSumCosetMinimizer n k` has coordinate sum zero. -/
theorem sum_zeroSumCosetMinimizer (hk : k ≤ n + 1) :
    ∑ j, zeroSumCosetMinimizer n k j = 0 := by
  have hn : (n : ℚ) + 1 ≠ 0 := by positivity
  simp only [zeroSumCosetMinimizer_eq_ite_sub, sum_sub_distrib, sum_boole, Fin.card_filter_val_lt,
    min_eq_right hk, sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_add,
    Nat.cast_one]
  field_simp
  ring

/-- For `k ≤ n + 1`, `zeroSumCosetMinimizer n k` belongs to `singleParityCheckCode ℚ (Fin (n + 1))`.
-/
theorem zeroSumCosetMinimizer_mem_singleParityCheckCode (hk : k ≤ n + 1) :
    zeroSumCosetMinimizer n k ∈ singleParityCheckCode ℚ (Fin (n + 1)) :=
  (mem_singleParityCheckCode _ _).mpr (sum_zeroSumCosetMinimizer hk)

/-- For `k ≤ n + 1`, `zeroSumCosetMinimizer n k` has squared norm `k (n + 1 - k) / (n + 1)`. -/
theorem zeroSumCosetMinimizer_dotProduct_self (hk : k ≤ n + 1) :
    zeroSumCosetMinimizer n k ⬝ᵥ zeroSumCosetMinimizer n k =
      (k : ℚ) * (n + 1 - k) / (n + 1) := by
  have h := (dotProduct_self_eq_mul_sub_div_iff (k := (k : ℤ)) (sum_zeroSumCosetMinimizer hk)
    fun j ↦ ⟨if (j : ℕ) < k then 1 else 0, by
      rw [zeroSumCosetMinimizer_eq_ite_sub]; split_ifs <;> simp⟩).mpr fun j ↦ by
    rw [zeroSumCosetMinimizer_eq_ite_sub]
    split_ifs <;> [right; left] <;> push_cast <;> ring
  simpa using h

/-- Summing a `{0, 1}`-valued equality indicator minus a constant `c` over `Fin (n + 1)` gives
`occCount f a - (n + 1) * c`. -/
private theorem sum_ite_eq_sub_const {α : Type*} [DecidableEq α] (f : Fin (n + 1) → α) (a : α)
    (c : ℚ) :
    ∑ j, ((if f j = a then (1 : ℚ) else 0) - c) = Function.occCount f a - (n + 1) * c := by
  have hocc : ∑ j, (if f j = a then (1 : ℚ) else 0) = Function.occCount f a := by
    simp [Function.occCount_eq_sum]
  have hc : ∑ _j : Fin (n + 1), c = (n + 1) * c := by
    simp [add_mul]
  rw [sum_sub_distrib, hocc, hc]

/-- **Multiset characterization of the coset minimizers of `Aₙ` in classical coordinates.** A
vector `x ∈ ℚ^{n+1}` has coordinate sum zero, coordinates in `ℤ - k / (n + 1)`, and squared norm
`k (n + 1 - k) / (n + 1)` if and only if its multiset of coordinates consists of `k` copies of
`(n + 1 - k) / (n + 1)` and `n + 1 - k` copies of `-k / (n + 1)`. -/
theorem sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_map_univ_eq
    {x : Fin (n + 1) → ℚ} :
    (∑ j, x j = 0 ∧ (∀ j, ∃ m : ℤ, x j = m - k / (n + 1)) ∧
        x ⬝ᵥ x = (k : ℚ) * (n + 1 - k) / (n + 1)) ↔
      Finset.univ.val.map x =
        Multiset.replicate k (((n : ℚ) + 1 - k) / (n + 1)) +
          Multiset.replicate (n + 1 - k) (-(k : ℚ) / (n + 1)) := by
  have hn : (n : ℚ) + 1 ≠ 0 := by positivity
  set a : ℚ := ((n : ℚ) + 1 - k) / (n + 1)
  set b : ℚ := -(k : ℚ) / (n + 1)
  have ha1 : 1 - (k : ℚ) / (n + 1) = a := by simp only [a]; field_simp
  have hb0 : -((k : ℚ) / (n + 1)) = b := by simp only [b]; ring
  have hsum_occ (hvals : ∀ j, x j = a ∨ x j = b) :
      ∑ j, x j = (Function.occCount x a : ℚ) - k := by
    have hx_eq (j : Fin (n + 1)) : x j = (if x j = a then (1 : ℚ) else 0) - k / (n + 1) := by
      rcases hvals j with hj | hj
      · rw [hj, ite_eq_left rfl, ha1]
      · rw [hj, ite_eq_right (sub_div_ne_neg_div n k).symm, zero_sub, hb0]
    rw [sum_congr rfl fun j _ ↦ hx_eq j, sum_ite_eq_sub_const, mul_div_cancel₀ _ hn]
  have hmult : (Finset.univ.val.map x =
      Multiset.replicate k a + Multiset.replicate (n + 1 - k) b) ↔
      (∀ j, x j = a ∨ x j = b) ∧ Function.occCount x a = k := by
    simpa only [Fintype.card_fin] using
      Function.map_univ_eq_replicate_add_replicate_iff_occCount (X := Fin (n + 1))
        (sub_div_ne_neg_div n k) (k := k) (f := x)
  rw [hmult]
  constructor
  · rintro ⟨hsum, hint, hnorm⟩
    have hvals : ∀ j, x j = a ∨ x j = b := fun j ↦ by
      simpa [ha1, hb0, or_comm] using
        (dotProduct_self_eq_mul_sub_div_iff (k := (k : ℤ)) hsum hint).mp (by simpa using hnorm) j
    refine ⟨hvals, ?_⟩
    have hocc : (Function.occCount x a : ℚ) = k := by linarith [hsum_occ hvals]
    exact_mod_cast hocc
  · rintro ⟨hvals, hocc⟩
    have hsum : ∑ j, x j = 0 := by rw [hsum_occ hvals, hocc, sub_self]
    have hint : ∀ j, ∃ m : ℤ, x j = m - k / (n + 1) := fun j ↦ by
      rcases hvals j with hj | hj
      · exact ⟨1, by rw [hj, ← ha1]; norm_num⟩
      · exact ⟨0, by rw [hj, ← hb0]; norm_num⟩
    refine ⟨hsum, hint, ?_⟩
    have hnorm := (dotProduct_self_eq_mul_sub_div_iff (k := (k : ℤ)) hsum hint).mpr fun j ↦ by
      simpa [ha1, hb0, or_comm] using hvals j
    simpa using hnorm

/-- **Subset-indicator characterization of the coset minimizers of `Aₙ` in classical coordinates.**
-/
theorem sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_exists_finset
    {x : Fin (n + 1) → ℚ} :
    (∑ j, x j = 0 ∧ (∀ j, ∃ m : ℤ, x j = m - k / (n + 1)) ∧
        x ⬝ᵥ x = (k : ℚ) * (n + 1 - k) / (n + 1)) ↔
      ∃ s : Finset (Fin (n + 1)), s.card = k ∧
        x = fun j ↦ if j ∈ s then ((n : ℚ) + 1 - k) / (n + 1) else -(k : ℚ) / (n + 1) :=
  sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_map_univ_eq.trans
    (by simpa only [Fintype.card_fin] using
      Multiset.map_univ_eq_replicate_add_replicate_iff_exists_finset (X := Fin (n + 1)))

/-- **Permutation characterization of the coset minimizers of `Aₙ` in classical coordinates.** For
`k ≤ n + 1`, the vectors of coordinate sum zero in `ℤ - k / (n + 1)` attaining the minimum norm
`k (n + 1 - k) / (n + 1)` are precisely the coordinate permutations of `zeroSumCosetMinimizer n k`.
-/
theorem sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_exists_perm
    (hk : k ≤ n + 1) {x : Fin (n + 1) → ℚ} :
    (∑ j, x j = 0 ∧ (∀ j, ∃ m : ℤ, x j = m - k / (n + 1)) ∧
        x ⬝ᵥ x = (k : ℚ) * (n + 1 - k) / (n + 1)) ↔
      ∃ σ : Equiv.Perm (Fin (n + 1)), zeroSumCosetMinimizer n k ∘ σ = x := by
  rw [sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_map_univ_eq,
    ← map_univ_zeroSumCosetMinimizer hk, Function.map_univ_eq_iff_exists_perm]

end ClassicalMinimizers

/-- **There are `(n + 1).choose k` coset minimizers in classical coordinates.** -/
theorem ncard_sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq (n k : ℕ) :
    {x : Fin (n + 1) → ℚ | ∑ j, x j = 0 ∧ (∀ j, ∃ m : ℤ, x j = m - k / (n + 1)) ∧
      x ⬝ᵥ x = (k : ℚ) * (n + 1 - k) / (n + 1)}.ncard = (n + 1).choose k := by
  simp_rw [sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_map_univ_eq]
  simpa only [Fintype.card_fin] using
    Multiset.ncard_map_univ_eq_replicate_add_replicate (X := Fin (n + 1))
      (sub_div_ne_neg_div n k) k

/-- For `k ≤ n + 1`, `zeroSumCosetMinimizer n k` has `(n + 1).choose k` distinct coordinate
permutations. -/
theorem ncard_exists_perm_zeroSumCosetMinimizer {n k : ℕ} (hk : k ≤ n + 1) :
    {x : Fin (n + 1) → ℚ |
      ∃ σ : Equiv.Perm (Fin (n + 1)), zeroSumCosetMinimizer n k ∘ σ = x}.ncard =
      (n + 1).choose k := by
  simp_rw [← sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_exists_perm hk]
  exact ncard_sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq n k

/-! ## Coset minima and minimizers of the simple-root model -/

section SimpleRootCosets

variable {n : ℕ}

/-- **A minimal vector of the discriminant class `k ω₁` of `Aₙ`.** For `0 ≤ k ≤ n + 1`, the class
`k ω₁` contains a dual vector whose classical coordinates are `1 - k / (n + 1)` in the first `k`
places and `-k / (n + 1)` in the others. -/
theorem exists_mk_eq_nsmul_typeAFundamentalWeightClass_and_apply_eq {k : ℕ} (hk : k ≤ n + 1) :
    ∃ x : (typeARootLattice n).dualCarrier,
      Submodule.Quotient.mk x = k • typeAFundamentalWeightClass n ∧
        ∀ j, (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) j =
          (if (j : ℕ) < k then 1 else 0) - k / (n + 1) := by
  set e := typeAIsometryZeroSumLattice n
  -- The difference `z` of the wanted vector from the classical coordinates
  -- `k (e₀ - (1 / (n + 1)) (1, …, 1))` of `k ω₁` is an integral vector of coordinate sum zero.
  set z : Fin (n + 1) → ℚ := fun j ↦ (if (j : ℕ) < k then 1 else 0) - k * if j = 0 then 1 else 0
  have hz : z ∈ singleParityCheckCode ℚ (Fin (n + 1)) := by
    rw [mem_singleParityCheckCode]
    simp [z, sum_sub_distrib, sum_boole, Fin.card_filter_val_lt, min_eq_right hk]
  have hzL : e.symm ⟨z, hz⟩ ∈ (typeARootLattice n).carrier := by
    rw [e.symm.apply_mem_carrier_iff, mem_zeroSumLattice_carrier_iff]
    intro j
    refine ⟨(if (j : ℕ) < k then 1 else 0) - k * if j = 0 then 1 else 0, ?_⟩
    simp [z]
  refine ⟨(k : ℤ) • typeAFundamentalWeightDual n +
    ⟨e.symm ⟨z, hz⟩, (typeARootLattice n).le_dualCarrier hzL⟩, ?_, fun j ↦ ?_⟩
  · rw [← natCast_zsmul, mk_eq_zsmul_typeAFundamentalWeightClass_iff, Submodule.coe_add,
      Submodule.coe_smul, coe_typeAFundamentalWeightDual, add_sub_cancel_left]
    exact hzL
  · simp only [Submodule.coe_add, Submodule.coe_smul, coe_typeAFundamentalWeightDual, map_add,
      map_zsmul, Isometry.apply_symm_apply]
    simp [e, z]
    split_ifs <;> ring

/-- **The minimum norm of the discriminant class `k ω₁` of `Aₙ` is `k (n + 1 - k) / (n + 1)`**,
for `0 ≤ k ≤ n + 1`.  It is attained by the dual vector whose classical coordinates are
`(n + 1 - k) / (n + 1)` in the first `k` places and `-k / (n + 1)` in the others, and it bounds the
norm of every dual vector of the class. -/
theorem isLeast_form_self_nsmul_typeAFundamentalWeightClass {k : ℕ} (hk : k ≤ n + 1) :
    IsLeast {q : ℚ | ∃ x : (typeARootLattice n).dualCarrier,
      Submodule.Quotient.mk x = k • typeAFundamentalWeightClass n ∧
        (typeARootLattice n).form x x = q} ((k : ℚ) * (n + 1 - k) / (n + 1)) := by
  set e := typeAIsometryZeroSumLattice n
  refine ⟨?_, ?_⟩
  · obtain ⟨x, hx, hex⟩ := exists_mk_eq_nsmul_typeAFundamentalWeightClass_and_apply_eq hk
    refine ⟨x, hx, ?_⟩
    have hsum := (mem_singleParityCheckCode ℚ (Fin (n + 1))).mp (e x).2
    rw [typeARootLattice_form_self_eq_dotProduct]
    refine (dotProduct_self_eq_mul_sub_div_iff (k := k) hsum fun j ↦
      ⟨if (j : ℕ) < k then 1 else 0, by simp [e, hex]⟩).mpr fun j ↦ ?_
    by_cases hj : (j : ℕ) < k <;> simp [e, hex, hj]
  · rintro q ⟨x, hx, rfl⟩
    rw [← natCast_zsmul] at hx
    rw [typeARootLattice_form_self_eq_dotProduct]
    have hsum := (mem_singleParityCheckCode ℚ (Fin (n + 1))).mp (e x).2
    simpa using mul_sub_div_le_dotProduct_self (k := k) hsum
      (exists_typeAIsometryZeroSumLattice_apply_eq_intCast_sub_of_mk_eq x hx)

/-- **The minimum norm of the discriminant class labelled `a : ZMod (n + 1)`.**  The class
`typeADiscriminantGroupEquiv n a = a.val • ω₁` of `Aₙ` has minimum norm
`a.val (n + 1 - a.val) / (n + 1)`, the shortest norm of the Conway–Sloane glue label `[a]` of an
`Aₙ` component. -/
theorem isLeast_form_self_typeADiscriminantGroupEquiv (a : ZMod (n + 1)) :
    IsLeast {q : ℚ | ∃ x : (typeARootLattice n).dualCarrier,
      Submodule.Quotient.mk x = typeADiscriminantGroupEquiv n a ∧
        (typeARootLattice n).form x x = q} ((a.val : ℚ) * (n + 1 - a.val) / (n + 1)) := by
  rw [typeADiscriminantGroupEquiv_apply]
  exact isLeast_form_self_nsmul_typeAFundamentalWeightClass (ZMod.val_lt a).le

end SimpleRootCosets

/-! ## Coset minima, minimizers, and counts in the zero-sum model -/

section ZeroSumCosets

variable {n : ℕ}

/-- **The minimum norm of the discriminant class `k ω₁` of `zeroSumLattice n` is
`k (n + 1 - k) / (n + 1)`**, for `0 ≤ k ≤ n + 1`. -/
theorem isLeast_form_self_nsmul_zeroSumFundamentalWeightClass {k : ℕ} (hk : k ≤ n + 1) :
    IsLeast {q : ℚ | ∃ y : (zeroSumLattice n).dualCarrier,
      Submodule.Quotient.mk y = k • zeroSumFundamentalWeightClass n ∧
        (zeroSumLattice n).form y y = q} ((k : ℚ) * (n + 1 - k) / (n + 1)) :=
  ((typeAIsometryZeroSumLattice n).isLeast_form_self_iff_of_discriminantGroupEquiv_eq
    (discriminantGroupEquiv_typeAIsometryZeroSumLattice_nsmul_typeAFundamentalWeightClass n k)).mpr
    (isLeast_form_self_nsmul_typeAFundamentalWeightClass hk)

/-- **The minimum norm of the discriminant class labelled `a : ZMod (n + 1)` in
`zeroSumLattice n`.** -/
theorem isLeast_form_self_zeroSumDiscriminantGroupEquiv (a : ZMod (n + 1)) :
    IsLeast {q : ℚ | ∃ y : (zeroSumLattice n).dualCarrier,
      Submodule.Quotient.mk y = zeroSumDiscriminantGroupEquiv n a ∧
        (zeroSumLattice n).form y y = q} ((a.val : ℚ) * (n + 1 - a.val) / (n + 1)) := by
  rw [zeroSumDiscriminantGroupEquiv_apply]
  exact isLeast_form_self_nsmul_zeroSumFundamentalWeightClass (ZMod.val_lt a).le

/-- **Multiset characterization of the coset minimizers of `k ω₁` in `zeroSumLattice n`.** -/
theorem mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_map_univ_eq
    {k : ℕ} {y : (zeroSumLattice n).dualCarrier} :
    ((Submodule.Quotient.mk y : (zeroSumLattice n).DiscriminantGroup) =
        k • zeroSumFundamentalWeightClass n ∧
        (zeroSumLattice n).form y y = (k : ℚ) * (n + 1 - k) / (n + 1)) ↔
      Finset.univ.val.map ((y : singleParityCheckCode ℚ (Fin (n + 1))) : Fin (n + 1) → ℚ) =
        Multiset.replicate k (((n : ℚ) + 1 - k) / (n + 1)) +
          Multiset.replicate (n + 1 - k) (-(k : ℚ) / (n + 1)) := by
  have hsum : ∑ j, ((y : singleParityCheckCode ℚ (Fin (n + 1))) : Fin (n + 1) → ℚ) j = 0 :=
    (mem_singleParityCheckCode _ _).mp y.1.2
  rw [← natCast_zsmul, mk_eq_zsmul_zeroSumFundamentalWeightClass_iff_forall_exists_intCast_sub,
    zeroSumLattice_form, zeroSumForm_apply, Int.cast_natCast,
    ← sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_map_univ_eq,
    and_iff_right hsum]

/-- **Subset-indicator characterization of the coset minimizers of `k ω₁` in `zeroSumLattice n`.**
-/
theorem mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_exists_finset
    {k : ℕ} {y : (zeroSumLattice n).dualCarrier} :
    ((Submodule.Quotient.mk y : (zeroSumLattice n).DiscriminantGroup) =
        k • zeroSumFundamentalWeightClass n ∧
        (zeroSumLattice n).form y y = (k : ℚ) * (n + 1 - k) / (n + 1)) ↔
      ∃ s : Finset (Fin (n + 1)), s.card = k ∧
        ((y : singleParityCheckCode ℚ (Fin (n + 1))) : Fin (n + 1) → ℚ) =
          fun j ↦ if j ∈ s then ((n : ℚ) + 1 - k) / (n + 1) else -(k : ℚ) / (n + 1) :=
  mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_map_univ_eq.trans
    (by simpa only [Fintype.card_fin] using
      Multiset.map_univ_eq_replicate_add_replicate_iff_exists_finset (X := Fin (n + 1)))

/-- **Permutation characterization of the coset minimizers of `k ω₁` in `zeroSumLattice n`.** A dual
vector of `zeroSumLattice n` lies in the class `k ω₁` and attains norm `k (n + 1 - k) / (n + 1)` if
and only if its coordinate vector is a permutation of `zeroSumCosetMinimizer n k`. -/
theorem mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_exists_perm
    {k : ℕ} {y : (zeroSumLattice n).dualCarrier} :
    ((Submodule.Quotient.mk y : (zeroSumLattice n).DiscriminantGroup) =
        k • zeroSumFundamentalWeightClass n ∧
        (zeroSumLattice n).form y y = (k : ℚ) * (n + 1 - k) / (n + 1)) ↔
      ∃ σ : Equiv.Perm (Fin (n + 1)),
        zeroSumCosetMinimizer n k ∘ σ =
          ((y : singleParityCheckCode ℚ (Fin (n + 1))) : Fin (n + 1) → ℚ) := by
  by_cases hk : k ≤ n + 1
  · rw [mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_map_univ_eq,
      ← map_univ_zeroSumCosetMinimizer hk, Function.map_univ_eq_iff_exists_perm]
  · have hsum : ∑ j, ((y : singleParityCheckCode ℚ (Fin (n + 1))) : Fin (n + 1) → ℚ) j = 0 :=
      (mem_singleParityCheckCode _ _).mp y.1.2
    refine iff_of_false ?_ ?_
    · rw [mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_map_univ_eq]
      intro hmap
      have hcard := congrArg Multiset.card hmap
      simp only [Multiset.card_map, Finset.card_val, Finset.card_univ, Fintype.card_fin,
        Multiset.card_add, Multiset.card_replicate] at hcard
      omega
    · rintro ⟨σ, hσ⟩
      have hn : (n : ℚ) + 1 ≠ 0 := by positivity
      have hcoord (j : Fin (n + 1)) :
          (zeroSumCosetMinimizer n k ∘ σ) j = ((n : ℚ) + 1 - k) / (n + 1) :=
        zeroSumCosetMinimizer_of_lt (lt_of_lt_of_le (σ j).isLt (by omega))
      rw [← hσ] at hsum
      simp only [hcoord, sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_add,
        Nat.cast_one] at hsum
      field_simp at hsum
      have hk' : (n : ℚ) + 1 < k := by exact_mod_cast not_le.mp hk
      linarith

/-- **Permutation characterization of the coset minimizers of the class `a : ZMod (n + 1)` in
`zeroSumLattice n`.** -/
theorem mk_eq_zeroSumDiscriminantGroupEquiv_and_form_self_eq_iff_exists_perm
    {a : ZMod (n + 1)} {y : (zeroSumLattice n).dualCarrier} :
    ((Submodule.Quotient.mk y : (zeroSumLattice n).DiscriminantGroup) =
        zeroSumDiscriminantGroupEquiv n a ∧
        (zeroSumLattice n).form y y = (a.val : ℚ) * (n + 1 - a.val) / (n + 1)) ↔
      ∃ σ : Equiv.Perm (Fin (n + 1)),
        zeroSumCosetMinimizer n a.val ∘ σ =
          ((y : singleParityCheckCode ℚ (Fin (n + 1))) : Fin (n + 1) → ℚ) := by
  rw [zeroSumDiscriminantGroupEquiv_apply,
    mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_exists_perm]

end ZeroSumCosets

/-- **The discriminant class `k ω₁` of `zeroSumLattice n` has `(n + 1).choose k` vectors of norm
`k (n + 1 - k) / (n + 1)`.** -/
theorem ncard_mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq (n k : ℕ) :
    {y : (zeroSumLattice n).dualCarrier |
      (Submodule.Quotient.mk y : (zeroSumLattice n).DiscriminantGroup) =
        k • zeroSumFundamentalWeightClass n ∧
      (zeroSumLattice n).form y y = (k : ℚ) * (n + 1 - k) / (n + 1)}.ncard =
      (n + 1).choose k := by
  let val : (zeroSumLattice n).dualCarrier → (Fin (n + 1) → ℚ) :=
    fun y ↦ ((y : singleParityCheckCode ℚ (Fin (n + 1))) : Fin (n + 1) → ℚ)
  have hinj : Function.Injective val := Subtype.val_injective.comp Subtype.val_injective
  have himg : val '' {y : (zeroSumLattice n).dualCarrier |
      (Submodule.Quotient.mk y : (zeroSumLattice n).DiscriminantGroup) =
        k • zeroSumFundamentalWeightClass n ∧
      (zeroSumLattice n).form y y = (k : ℚ) * (n + 1 - k) / (n + 1)} =
      {x : Fin (n + 1) → ℚ | ∑ j, x j = 0 ∧ (∀ j, ∃ m : ℤ, x j = m - k / (n + 1)) ∧
        x ⬝ᵥ x = (k : ℚ) * (n + 1 - k) / (n + 1)} := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      rw [Set.mem_ofPred_eq,
        mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_map_univ_eq] at hy
      exact sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_map_univ_eq.mpr hy
    · intro hx
      rw [Set.mem_ofPred_eq] at hx
      rcases hx with ⟨hsum, hint, hnorm⟩
      have hx0 : x ∈ singleParityCheckCode ℚ (Fin (n + 1)) :=
        (mem_singleParityCheckCode _ _).mpr hsum
      have hdual : (⟨x, hx0⟩ : singleParityCheckCode ℚ (Fin (n + 1))) ∈
          (zeroSumLattice n).dualCarrier := by
        rw [mem_dualCarrier_zeroSumLattice_iff]
        intro i j
        obtain ⟨mi, hmi⟩ := hint i
        obtain ⟨mj, hmj⟩ := hint j
        exact ⟨mi - mj, by simp [hmi, hmj]⟩
      refine ⟨⟨⟨x, hx0⟩, hdual⟩, ?_, rfl⟩
      rw [Set.mem_ofPred_eq,
        mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_map_univ_eq]
      exact sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq_iff_map_univ_eq.mp
        ⟨hsum, hint, hnorm⟩
  rw [← Set.ncard_image_of_injective _ hinj, himg,
    ncard_sum_eq_zero_and_forall_exists_intCast_sub_and_dotProduct_self_eq]

/-- **The discriminant class `a : ZMod (n + 1)` of `zeroSumLattice n` has `(n + 1).choose a.val`
shortest vectors.** -/
theorem ncard_mk_eq_zeroSumDiscriminantGroupEquiv_and_form_self_eq {n : ℕ} (a : ZMod (n + 1)) :
    {y : (zeroSumLattice n).dualCarrier |
      Submodule.Quotient.mk y = zeroSumDiscriminantGroupEquiv n a ∧
        (zeroSumLattice n).form y y = (a.val : ℚ) * (n + 1 - a.val) / (n + 1)}.ncard =
      (n + 1).choose a.val := by
  simp_rw [zeroSumDiscriminantGroupEquiv_apply]
  exact ncard_mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq n a.val

/-! ## Minimizer characterizations and counts in the simple-root model -/

section SimpleRootMinimizers

variable {n : ℕ}

/-- **Multiset characterization of the coset minimizers of `k ω₁` in `typeARootLattice n`.** -/
theorem mk_eq_nsmul_typeAFundamentalWeightClass_and_form_self_eq_iff_map_univ_eq
    {k : ℕ} {x : (typeARootLattice n).dualCarrier} :
    ((Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup) =
        k • typeAFundamentalWeightClass n ∧
        (typeARootLattice n).form x x = (k : ℚ) * (n + 1 - k) / (n + 1)) ↔
      Finset.univ.val.map (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) =
        Multiset.replicate k (((n : ℚ) + 1 - k) / (n + 1)) +
          Multiset.replicate (n + 1 - k) (-(k : ℚ) / (n + 1)) := by
  rw [← Isometry.mk_dualCarrierEquiv_eq_and_form_self_eq_iff_of_discriminantGroupEquiv_eq _
      (discriminantGroupEquiv_typeAIsometryZeroSumLattice_nsmul_typeAFundamentalWeightClass n k),
    mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_map_univ_eq,
    Isometry.coe_dualCarrierEquiv_apply]

/-- **Subset-indicator characterization of the coset minimizers of `k ω₁` in
`typeARootLattice n`.** -/
theorem mk_eq_nsmul_typeAFundamentalWeightClass_and_form_self_eq_iff_exists_finset
    {k : ℕ} {x : (typeARootLattice n).dualCarrier} :
    ((Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup) =
        k • typeAFundamentalWeightClass n ∧
        (typeARootLattice n).form x x = (k : ℚ) * (n + 1 - k) / (n + 1)) ↔
      ∃ s : Finset (Fin (n + 1)), s.card = k ∧
        (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) =
          fun j ↦ if j ∈ s then ((n : ℚ) + 1 - k) / (n + 1) else -(k : ℚ) / (n + 1) :=
  mk_eq_nsmul_typeAFundamentalWeightClass_and_form_self_eq_iff_map_univ_eq.trans
    (by simpa only [Fintype.card_fin] using
      Multiset.map_univ_eq_replicate_add_replicate_iff_exists_finset (X := Fin (n + 1)))

/-- **Permutation characterization of the coset minimizers of `k ω₁` in `typeARootLattice n`.** -/
theorem mk_eq_nsmul_typeAFundamentalWeightClass_and_form_self_eq_iff_exists_perm
    {k : ℕ} {x : (typeARootLattice n).dualCarrier} :
    ((Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup) =
        k • typeAFundamentalWeightClass n ∧
        (typeARootLattice n).form x x = (k : ℚ) * (n + 1 - k) / (n + 1)) ↔
      ∃ σ : Equiv.Perm (Fin (n + 1)),
        zeroSumCosetMinimizer n k ∘ σ = (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) := by
  rw [← Isometry.mk_dualCarrierEquiv_eq_and_form_self_eq_iff_of_discriminantGroupEquiv_eq _
      (discriminantGroupEquiv_typeAIsometryZeroSumLattice_nsmul_typeAFundamentalWeightClass n k),
    mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq_iff_exists_perm,
    Isometry.coe_dualCarrierEquiv_apply]

/-- **Permutation characterization of the coset minimizers of the class `a : ZMod (n + 1)` in
`typeARootLattice n`.** -/
theorem mk_eq_typeADiscriminantGroupEquiv_and_form_self_eq_iff_exists_perm
    {a : ZMod (n + 1)} {x : (typeARootLattice n).dualCarrier} :
    ((Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup) =
        typeADiscriminantGroupEquiv n a ∧
        (typeARootLattice n).form x x = (a.val : ℚ) * (n + 1 - a.val) / (n + 1)) ↔
      ∃ σ : Equiv.Perm (Fin (n + 1)),
        zeroSumCosetMinimizer n a.val ∘ σ =
          (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) := by
  rw [typeADiscriminantGroupEquiv_apply,
    mk_eq_nsmul_typeAFundamentalWeightClass_and_form_self_eq_iff_exists_perm]

end SimpleRootMinimizers

/-- **The discriminant class `k ω₁` of `typeARootLattice n` has `(n + 1).choose k` vectors of norm
`k (n + 1 - k) / (n + 1)`.** -/
theorem ncard_mk_eq_nsmul_typeAFundamentalWeightClass_and_form_self_eq (n k : ℕ) :
    {x : (typeARootLattice n).dualCarrier |
      (Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup) =
        k • typeAFundamentalWeightClass n ∧
      (typeARootLattice n).form x x = (k : ℚ) * (n + 1 - k) / (n + 1)}.ncard =
      (n + 1).choose k := by
  rw [← (typeAIsometryZeroSumLattice n).ncard_mk_eq_and_form_self_eq_of_discriminantGroupEquiv_eq
    (discriminantGroupEquiv_typeAIsometryZeroSumLattice_nsmul_typeAFundamentalWeightClass n k),
    ncard_mk_eq_nsmul_zeroSumFundamentalWeightClass_and_form_self_eq]

/-- **The discriminant class `a : ZMod (n + 1)` of `typeARootLattice n` has `(n + 1).choose a.val`
shortest vectors.** -/
theorem ncard_mk_eq_typeADiscriminantGroupEquiv_and_form_self_eq {n : ℕ} (a : ZMod (n + 1)) :
    {x : (typeARootLattice n).dualCarrier |
      Submodule.Quotient.mk x = typeADiscriminantGroupEquiv n a ∧
        (typeARootLattice n).form x x = (a.val : ℚ) * (n + 1 - a.val) / (n + 1)}.ncard =
      (n + 1).choose a.val := by
  simp_rw [typeADiscriminantGroupEquiv_apply]
  exact ncard_mk_eq_nsmul_typeAFundamentalWeightClass_and_form_self_eq n a.val

end TauCeti.IntegralLattice
