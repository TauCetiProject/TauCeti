module

public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeA.ZeroSum

/-!
# The dual lattice of `Aₙ` and its discriminant classes in classical coordinates

In the classical coordinates `Aₙ = {y ∈ ℤ^{n+1} | ∑ yⱼ = 0}` of
`TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeA.ZeroSum`, the first fundamental weight
is `ω₁ = e₀ - (1 / (n + 1)) (1, …, 1)`.  This file describes the dual lattice and the subgroups
of its discriminant group in these coordinates:

```text
Aₙ^∨ = {y | ∑ yⱼ = 0, yᵢ - yⱼ ∈ ℤ for all i, j},
y + Aₙ = k ω₁ + Aₙ   ↔   yⱼ ∈ ℤ - k / (n + 1) for all j,
y + Aₙ ∈ ⟨e ω₁⟩      ↔   d yⱼ ∈ ℤ for all j          (e d = n + 1).
```

Together with the description of an isotropic gluing as the inverse image of a subgroup of
the discriminant group, the last description identifies the overlattice of `Aₙ` glued along
the subgroup of order `d` of `ℤ/(n+1)`: it consists of the vectors of coordinate sum zero
whose coordinates are congruent modulo `ℤ` and lie in `(1/d) ℤ`.  For instance, the subgroup
generated by `5 ω₁` in `A₂₄^∨ / A₂₄ ≃ ℤ/25` gives the rank-24 overlattice of `A₂₄` in
Conway--Sloane's table of even unimodular lattices.

## Main results

* `TauCeti.IntegralLattice.mk_eq_zsmul_typeAFundamentalWeightClass_iff_forall_exists_intCast_sub`,
  `TauCeti.IntegralLattice.mk_eq_zsmul_zeroSumFundamentalWeightClass_iff_forall_exists_intCast_sub`:
  a dual vector lies in the class `k ω₁` (in the simple-root or zero-sum model) exactly when all
  its classical coordinates lie in `ℤ - k / (n + 1)`.
* `TauCeti.IntegralLattice.mem_dualCarrier_typeARootLattice_iff`,
  `TauCeti.IntegralLattice.mem_dualCarrier_zeroSumLattice_iff`: a vector lies in the dual of `Aₙ`
  exactly when its classical coordinates differ pairwise by integers.
* `TauCeti.IntegralLattice.mk_mem_zmultiples_nsmul_typeAFundamentalWeightClass_iff`,
  `TauCeti.IntegralLattice.mk_mem_zmultiples_nsmul_zeroSumFundamentalWeightClass_iff`: for
  `e d = n + 1`, a dual vector lies in a class of the subgroup generated by `e ω₁` exactly when
  `d` times each of its classical coordinates is an integer.
* `TauCeti.IntegralLattice.zeroSumFundamentalWeight`,
  `TauCeti.IntegralLattice.zeroSumFundamentalWeightClass`,
  `TauCeti.IntegralLattice.zeroSumDiscriminantGroupEquiv`: the first fundamental weight `ω₁`, its
  discriminant class, and the cyclic identification `ZMod (n + 1) ≃+ A_{Aₙ}` directly on
  `zeroSumLattice n`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, Chapter 4, §6.1 and
  Chapter 16, §1.
-/

public section

namespace TauCeti.IntegralLattice

open Finset

section SimpleRootModel

variable {n : ℕ}

/-- **The classical coordinates of the class `k ω₁`.** A dual vector of `Aₙ` lies in the
discriminant class `k ω₁` exactly when all its classical coordinates lie in `ℤ - k / (n + 1)`. -/
theorem mk_eq_zsmul_typeAFundamentalWeightClass_iff_forall_exists_intCast_sub
    (x : (typeARootLattice n).dualCarrier) (k : ℤ) :
    (Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup) =
        k • typeAFundamentalWeightClass n ↔
      ∀ j, ∃ m : ℤ, (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) j = m - k / (n + 1) := by
  refine ⟨fun hx j ↦ exists_typeAIsometryZeroSumLattice_apply_eq_intCast_sub_of_mk_eq x hx j,
    fun h ↦ ?_⟩
  rw [mk_eq_zsmul_typeAFundamentalWeightClass_iff,
    ← (typeAIsometryZeroSumLattice n).apply_mem_carrier_iff, mem_zeroSumLattice_carrier_iff]
  intro j
  obtain ⟨m, hm⟩ := h j
  refine ⟨m - k * if j = 0 then 1 else 0, ?_⟩
  rw [map_sub, map_zsmul]
  simp only [AddSubgroupClass.coe_sub, SetLike.val_smul_of_tower, zsmul_eq_mul, Pi.sub_apply, hm,
    Pi.mul_apply, Pi.intCast_apply, typeAIsometryZeroSumLattice_typeAFundamentalWeight_apply,
    one_div, mul_ite, mul_one, mul_zero, Int.cast_sub, Int.cast_ite, Int.cast_zero]
  split_ifs <;> ring

/-- **The dual lattice of `Aₙ` in classical coordinates.** A vector lies in the dual of `Aₙ`
exactly when its classical coordinates differ pairwise by integers. -/
theorem mem_dualCarrier_typeARootLattice_iff (x : Fin n → ℚ) :
    x ∈ (typeARootLattice n).dualCarrier ↔ ∀ i j, ∃ m : ℤ,
      (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) i -
        (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) j = m := by
  constructor
  · intro hx i j
    -- Every dual class is a multiple `k ω₁`, whose coordinates all lie in `ℤ - k / (n + 1)`.
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp
      ((zmultiples_typeAFundamentalWeightClass n).symm ▸ AddSubgroup.mem_top
        (Submodule.Quotient.mk ⟨x, hx⟩ : (typeARootLattice n).DiscriminantGroup))
    have hc := (mk_eq_zsmul_typeAFundamentalWeightClass_iff_forall_exists_intCast_sub
      ⟨x, hx⟩ k).mp hk.symm
    obtain ⟨a, ha⟩ := hc i
    obtain ⟨b, hb⟩ := hc j
    exact ⟨a - b, by rw [ha, hb]; push_cast; ring⟩
  · intro h
    -- With `yⱼ - y₀ = mⱼ` and `s = ∑ mⱼ = -(n + 1) y₀`, the vector `x - s ω₁` is integral.
    set y := (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ)
    choose m hm using fun j ↦ h j 0
    have hsum : ∑ j, y j = 0 :=
      (mem_singleParityCheckCode _ _).mp (typeAIsometryZeroSumLattice n x).2
    have hs : ∑ j, (m j : ℚ) = -((n : ℚ) + 1) * y 0 := by
      simp_rw [← hm]
      rw [sum_sub_distrib, hsum]
      simp
      ring
    have hmem : x - (∑ j, m j) • typeAFundamentalWeight n ∈ (typeARootLattice n).carrier := by
      rw [← (typeAIsometryZeroSumLattice n).apply_mem_carrier_iff, mem_zeroSumLattice_carrier_iff]
      intro j
      refine ⟨m j - (∑ j, m j) * if j = 0 then 1 else 0, ?_⟩
      rw [map_sub, map_zsmul]
      simp only [AddSubgroupClass.coe_sub, SetLike.val_smul_of_tower, zsmul_eq_mul, Int.cast_sum,
        Pi.sub_apply, Pi.mul_apply, Finset.sum_apply, Pi.intCast_apply,
        typeAIsometryZeroSumLattice_typeAFundamentalWeight_apply, one_div, mul_ite, mul_one,
        mul_zero, Int.cast_sub, Int.cast_ite, Int.cast_zero]
      have hn : (n : ℚ) + 1 ≠ 0 := by positivity
      rw [hs, ← hm j]
      field_simp
      split_ifs <;> ring
    simpa using add_mem ((typeARootLattice n).le_dualCarrier hmem)
      (zsmul_mem (typeAFundamentalWeight_mem_dualCarrier n) (∑ j, m j))

/-- **The subgroup of order `d` of the discriminant group of `Aₙ` in classical coordinates.**
If `e d = n + 1`, a dual vector of `Aₙ` lies in a class of the cyclic subgroup of order `d`
generated by `e ω₁` exactly when `d` times each of its classical coordinates is an integer. -/
theorem mk_mem_zmultiples_nsmul_typeAFundamentalWeightClass_iff {e d : ℕ} (hed : e * d = n + 1)
    (x : (typeARootLattice n).dualCarrier) :
    (Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup) ∈
        AddSubgroup.zmultiples (e • typeAFundamentalWeightClass n) ↔
      ∀ j, ∃ m : ℤ, d * (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) j = m := by
  have hed' : (e : ℚ) * d = n + 1 := by exact_mod_cast hed
  have hpos : (0 : ℚ) < n + 1 := by positivity
  have he : (e : ℚ) ≠ 0 := by
    rintro h
    rw [h, zero_mul] at hed'
    linarith
  have hd : (d : ℚ) ≠ 0 := by
    rintro h
    rw [h, mul_zero] at hed'
    linarith
  constructor
  · rintro ⟨t, ht⟩ j
    simp only at ht
    have ht' : (Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup) =
        (t * e) • typeAFundamentalWeightClass n := by
      rw [← ht, ← natCast_zsmul, ← mul_zsmul, mul_comm]
    obtain ⟨m, hm⟩ :=
      (mk_eq_zsmul_typeAFundamentalWeightClass_iff_forall_exists_intCast_sub x _).mp ht' j
    refine ⟨d * m - t, ?_⟩
    rw [hm, ← hed']
    push_cast
    field_simp
  · intro h
    -- The class is some `k ω₁`; integrality of `d y₀ = d m₀ - k / e` forces `e ∣ k`.
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp
      ((zmultiples_typeAFundamentalWeightClass n).symm ▸ AddSubgroup.mem_top
        (Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup))
    obtain ⟨m, hm⟩ :=
      (mk_eq_zsmul_typeAFundamentalWeightClass_iff_forall_exists_intCast_sub x k).mp hk.symm 0
    obtain ⟨c, hc⟩ := h 0
    have hk' : (k : ℚ) = e * (d * m - c) := by
      rw [hm, ← hed'] at hc
      field_simp at hc
      linear_combination -hc
    refine ⟨d * m - c, ?_⟩
    dsimp only
    rw [← hk, ← natCast_zsmul, ← mul_zsmul']
    congr 1
    exact_mod_cast hk'.symm

end SimpleRootModel

/-! ## The dual lattice and discriminant group in the zero-sum model -/

section ZeroSumModel

variable (n : ℕ)

/-- **The first fundamental weight `ω₁` in the zero-sum model**: `e₀ - (1 / (n + 1)) (1, …, 1)`. -/
def zeroSumFundamentalWeight : singleParityCheckCode ℚ (Fin (n + 1)) :=
  ⟨fun j ↦ (if j = 0 then 1 else 0) - 1 / ((n : ℚ) + 1), by
    have hn : (n : ℚ) + 1 ≠ 0 := by positivity
    rw [mem_singleParityCheckCode]
    simp [sum_sub_distrib]
    field_simp
    norm_num⟩

/-- Evaluation of `zeroSumFundamentalWeight` at a coordinate `j`. -/
@[simp]
theorem zeroSumFundamentalWeight_apply (j : Fin (n + 1)) :
    (zeroSumFundamentalWeight n : Fin (n + 1) → ℚ) j =
      (if j = 0 then 1 else 0) - 1 / ((n : ℚ) + 1) :=
  (rfl)

/-- `typeAIsometryZeroSumLattice` carries the first fundamental weight of the simple-root model to
`zeroSumFundamentalWeight`. -/
@[simp]
theorem typeAIsometryZeroSumLattice_typeAFundamentalWeight :
    typeAIsometryZeroSumLattice n (typeAFundamentalWeight n) = zeroSumFundamentalWeight n :=
  Subtype.ext (funext (typeAIsometryZeroSumLattice_typeAFundamentalWeight_apply n))

/-- The first fundamental weight lies in the dual lattice of `zeroSumLattice n`. -/
theorem zeroSumFundamentalWeight_mem_dualCarrier :
    zeroSumFundamentalWeight n ∈ (zeroSumLattice n).dualCarrier := by
  rw [← typeAIsometryZeroSumLattice_typeAFundamentalWeight,
    (typeAIsometryZeroSumLattice n).apply_mem_dualCarrier_iff]
  exact typeAFundamentalWeight_mem_dualCarrier n

/-- The first fundamental weight as an element of `(zeroSumLattice n).dualCarrier`. -/
noncomputable def zeroSumFundamentalWeightDual : (zeroSumLattice n).dualCarrier :=
  ⟨zeroSumFundamentalWeight n, zeroSumFundamentalWeight_mem_dualCarrier n⟩

@[simp]
theorem coe_zeroSumFundamentalWeightDual :
    (zeroSumFundamentalWeightDual n : singleParityCheckCode ℚ (Fin (n + 1))) =
      zeroSumFundamentalWeight n :=
  (rfl)

/-- `typeAIsometryZeroSumLattice` carries `typeAFundamentalWeightDual` to
`zeroSumFundamentalWeightDual`. -/
@[simp]
theorem dualCarrierEquiv_typeAIsometryZeroSumLattice_typeAFundamentalWeightDual :
    (typeAIsometryZeroSumLattice n).dualCarrierEquiv (typeAFundamentalWeightDual n) =
      zeroSumFundamentalWeightDual n := by
  ext : 1
  rw [Isometry.coe_dualCarrierEquiv_apply, coe_typeAFundamentalWeightDual,
    coe_zeroSumFundamentalWeightDual, typeAIsometryZeroSumLattice_typeAFundamentalWeight]

/-- The discriminant class of the first fundamental weight in
`(zeroSumLattice n).DiscriminantGroup`. -/
noncomputable def zeroSumFundamentalWeightClass : (zeroSumLattice n).DiscriminantGroup :=
  Submodule.Quotient.mk (zeroSumFundamentalWeightDual n)

@[simp]
theorem mk_zeroSumFundamentalWeightDual :
    Submodule.Quotient.mk (zeroSumFundamentalWeightDual n) = zeroSumFundamentalWeightClass n :=
  (rfl)

/-- `typeAIsometryZeroSumLattice` carries `typeAFundamentalWeightClass` to
`zeroSumFundamentalWeightClass`. -/
@[simp]
theorem discriminantGroupEquiv_typeAIsometryZeroSumLattice_typeAFundamentalWeightClass :
    (typeAIsometryZeroSumLattice n).discriminantGroupEquiv (typeAFundamentalWeightClass n) =
      zeroSumFundamentalWeightClass n := by
  rw [← mk_typeAFundamentalWeightDual, Isometry.discriminantGroupEquiv_mk,
    dualCarrierEquiv_typeAIsometryZeroSumLattice_typeAFundamentalWeightDual,
    mk_zeroSumFundamentalWeightDual]

/-- **The cyclic `ℤ/(n+1)` parametrization of the discriminant group of `zeroSumLattice n`**,
carrying `1` to the class of `zeroSumFundamentalWeight`. -/
noncomputable def zeroSumDiscriminantGroupEquiv :
    ZMod (n + 1) ≃+ (zeroSumLattice n).DiscriminantGroup :=
  (typeADiscriminantGroupEquiv n).trans
    (typeAIsometryZeroSumLattice n).discriminantGroupEquiv.toAddEquiv

/-- `typeAIsometryZeroSumLattice` intertwines `typeADiscriminantGroupEquiv` and
`zeroSumDiscriminantGroupEquiv`. -/
@[simp]
theorem discriminantGroupEquiv_typeAIsometryZeroSumLattice_typeADiscriminantGroupEquiv
    (a : ZMod (n + 1)) :
    (typeAIsometryZeroSumLattice n).discriminantGroupEquiv (typeADiscriminantGroupEquiv n a) =
      zeroSumDiscriminantGroupEquiv n a :=
  (rfl)

@[simp]
theorem zeroSumDiscriminantGroupEquiv_apply_one :
    zeroSumDiscriminantGroupEquiv n 1 = zeroSumFundamentalWeightClass n := by
  rw [← discriminantGroupEquiv_typeAIsometryZeroSumLattice_typeADiscriminantGroupEquiv,
    typeADiscriminantGroupEquiv_apply_one,
    discriminantGroupEquiv_typeAIsometryZeroSumLattice_typeAFundamentalWeightClass]

/-- The label `a : ZMod (n + 1)` names the class `a.val • ω₁` in `zeroSumLattice n`. -/
theorem zeroSumDiscriminantGroupEquiv_apply (a : ZMod (n + 1)) :
    zeroSumDiscriminantGroupEquiv n a = a.val • zeroSumFundamentalWeightClass n := by
  rw [← discriminantGroupEquiv_typeAIsometryZeroSumLattice_typeADiscriminantGroupEquiv,
    typeADiscriminantGroupEquiv_apply, ← natCast_zsmul,
    (typeAIsometryZeroSumLattice n).discriminantGroupEquiv.map_smul,
    discriminantGroupEquiv_typeAIsometryZeroSumLattice_typeAFundamentalWeightClass, natCast_zsmul]

end ZeroSumModel

section ZeroSumCharacterizations

variable {n : ℕ}

/-- **The dual lattice of `zeroSumLattice n`.** A vector of coordinate sum zero lies in the dual of
`zeroSumLattice n` if and only if its coordinates differ pairwise by integers. -/
theorem mem_dualCarrier_zeroSumLattice_iff (y : singleParityCheckCode ℚ (Fin (n + 1))) :
    y ∈ (zeroSumLattice n).dualCarrier ↔
      ∀ i j, ∃ m : ℤ, (y : Fin (n + 1) → ℚ) i - (y : Fin (n + 1) → ℚ) j = m := by
  rw [← (typeAIsometryZeroSumLattice n).symm.apply_mem_dualCarrier_iff,
    mem_dualCarrier_typeARootLattice_iff, Isometry.apply_symm_apply]

/-- **The discriminant class `k ω₁` of `zeroSumLattice n`.** A dual vector of `zeroSumLattice n`
lies in the class `k ω₁` if and only if all its coordinates lie in `ℤ - k / (n + 1)`. -/
theorem mk_eq_zsmul_zeroSumFundamentalWeightClass_iff_forall_exists_intCast_sub
    (y : (zeroSumLattice n).dualCarrier) (k : ℤ) :
    (Submodule.Quotient.mk y : (zeroSumLattice n).DiscriminantGroup) =
        k • zeroSumFundamentalWeightClass n ↔
      ∀ j, ∃ m : ℤ, (y : Fin (n + 1) → ℚ) j = m - k / (n + 1) := by
  let e := typeAIsometryZeroSumLattice n
  let x := e.dualCarrierEquiv.symm y
  have hx : e.dualCarrierEquiv x = y := e.dualCarrierEquiv.apply_symm_apply y
  have hclass : e.discriminantGroupEquiv (k • typeAFundamentalWeightClass n) =
      k • zeroSumFundamentalWeightClass n := by
    rw [e.discriminantGroupEquiv.map_smul,
      discriminantGroupEquiv_typeAIsometryZeroSumLattice_typeAFundamentalWeightClass]
  rw [← hx, ← hclass, ← Isometry.discriminantGroupEquiv_mk,
    e.discriminantGroupEquiv.injective.eq_iff,
    mk_eq_zsmul_typeAFundamentalWeightClass_iff_forall_exists_intCast_sub,
    ← Isometry.coe_dualCarrierEquiv_apply, hx]

/-- **The subgroup of order `d` of the discriminant group of `zeroSumLattice n`.** If
`e d = n + 1`, a dual vector of `zeroSumLattice n` lies in a class of the cyclic subgroup generated
by `e ω₁` if and only if `d` times each of its coordinates is an integer. -/
theorem mk_mem_zmultiples_nsmul_zeroSumFundamentalWeightClass_iff {e d : ℕ} (hed : e * d = n + 1)
    (y : (zeroSumLattice n).dualCarrier) :
    (Submodule.Quotient.mk y : (zeroSumLattice n).DiscriminantGroup) ∈
        AddSubgroup.zmultiples (e • zeroSumFundamentalWeightClass n) ↔
      ∀ j, ∃ m : ℤ, d * (y : Fin (n + 1) → ℚ) j = m := by
  let f := typeAIsometryZeroSumLattice n
  let x := f.dualCarrierEquiv.symm y
  have hx : f.dualCarrierEquiv x = y := f.dualCarrierEquiv.apply_symm_apply y
  have he : f.discriminantGroupEquiv (e • typeAFundamentalWeightClass n) =
      e • zeroSumFundamentalWeightClass n := by
    rw [← natCast_zsmul, f.discriminantGroupEquiv.map_smul,
      discriminantGroupEquiv_typeAIsometryZeroSumLattice_typeAFundamentalWeightClass, natCast_zsmul]
  have hcoe : ((y : singleParityCheckCode ℚ (Fin (n + 1))) : Fin (n + 1) → ℚ) =
      (f x : Fin (n + 1) → ℚ) := by
    rw [← hx, Isometry.coe_dualCarrierEquiv_apply]
  rw [hcoe, ← mk_mem_zmultiples_nsmul_typeAFundamentalWeightClass_iff hed x,
    AddSubgroup.mem_zmultiples_iff, AddSubgroup.mem_zmultiples_iff]
  refine ⟨fun ⟨t, ht⟩ ↦ ⟨t, f.discriminantGroupEquiv.injective ?_⟩, fun ⟨t, ht⟩ ↦ ⟨t, ?_⟩⟩
  · rw [f.discriminantGroupEquiv.map_smul, he, Isometry.discriminantGroupEquiv_mk, hx, ht]
  · rw [← hx, ← Isometry.discriminantGroupEquiv_mk, ← ht, f.discriminantGroupEquiv.map_smul, he]

end ZeroSumCharacterizations

end TauCeti.IntegralLattice
