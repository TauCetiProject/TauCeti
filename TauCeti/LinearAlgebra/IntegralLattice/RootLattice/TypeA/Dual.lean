module

public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeA.ZeroSum

/-!
# The dual lattice of `Aₙ` and its discriminant classes in classical coordinates

In the classical coordinates `Aₙ = {y ∈ ℤ^{n+1} | ∑ yⱼ = 0}` of
`TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeA.ZeroSum`, the first fundamental weight
is `ω₁ = e₀ - (1 / (n + 1)) (1, …, 1)`.  This file describes the dual lattice and the subgroups
of its discriminant group in these coordinates:

```text
Aₙ^∨ = {y | ∑ yⱼ = 0, yᵢ - yⱼ ∈ ℤ for all i, j},
y + Aₙ = k ω₁ + Aₙ   ↔   yⱼ ∈ ℤ - k / (n + 1) for all j,
y + Aₙ ∈ ⟨e ω₁⟩      ↔   d yⱼ ∈ ℤ for all j          (e d = n + 1).
```

Together with the description of an isotropic gluing as the inverse image of a subgroup of
the discriminant group, the last description identifies the overlattice of `Aₙ` glued along
the subgroup of order `d` of `ℤ/(n+1)`: it consists of the vectors of coordinate sum zero
whose coordinates are congruent modulo `ℤ` and lie in `(1/d) ℤ`.  For instance, the subgroup
generated by `5 ω₁` in `A₂₄^∨ / A₂₄ ≃ ℤ/25` gives the rank-24 overlattice of `A₂₄` in
Conway--Sloane's table of even unimodular lattices.

## Main results

* `TauCeti.IntegralLattice.mk_eq_zsmul_typeAFundamentalWeightClass_iff_forall_exists_intCast_sub`:
  a dual vector lies in the class `k ω₁` exactly when all its classical coordinates lie in
  `ℤ - k / (n + 1)`.
* `TauCeti.IntegralLattice.mem_dualCarrier_typeARootLattice_iff`: a vector lies in the dual of
  `Aₙ` exactly when its classical coordinates differ pairwise by integers.
* `TauCeti.IntegralLattice.mk_mem_zmultiples_nsmul_typeAFundamentalWeightClass_iff`: for
  `e d = n + 1`, a dual vector lies in a class of the subgroup generated by `e ω₁` exactly when
  `d` times each of its classical coordinates is an integer.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, Chapter 4, §6.1 and
  Chapter 16, §1.
-/

public section

namespace TauCeti.IntegralLattice

open Finset

variable {n : ℕ}

/-- **The classical coordinates of the class `k ω₁`.** A dual vector of `Aₙ` lies in the
discriminant class `k ω₁` exactly when all its classical coordinates lie in `ℤ - k / (n + 1)`. -/
theorem mk_eq_zsmul_typeAFundamentalWeightClass_iff_forall_exists_intCast_sub
    (x : (typeARootLattice n).dualCarrier) (k : ℤ) :
    (Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup) =
        k • typeAFundamentalWeightClass n ↔
      ∀ j, ∃ m : ℤ, (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) j = m - k / (n + 1) := by
  refine ⟨fun hx j ↦ exists_typeAIsometryZeroSumLattice_apply_eq_intCast_sub_of_mk_eq x hx j,
    fun h ↦ ?_⟩
  rw [mk_eq_zsmul_typeAFundamentalWeightClass_iff,
    ← (typeAIsometryZeroSumLattice n).apply_mem_carrier_iff, mem_zeroSumLattice_carrier_iff]
  intro j
  obtain ⟨m, hm⟩ := h j
  refine ⟨m - k * if j = 0 then 1 else 0, ?_⟩
  rw [map_sub, map_zsmul]
  simp only [AddSubgroupClass.coe_sub, SetLike.val_smul_of_tower, zsmul_eq_mul, Pi.sub_apply, hm,
    Pi.mul_apply, Pi.intCast_apply, typeAIsometryZeroSumLattice_typeAFundamentalWeight_apply,
    one_div, mul_ite, mul_one, mul_zero, Int.cast_sub, Int.cast_ite, Int.cast_zero]
  split_ifs <;> ring

/-- **The dual lattice of `Aₙ` in classical coordinates.** A vector lies in the dual of `Aₙ`
exactly when its classical coordinates differ pairwise by integers. -/
theorem mem_dualCarrier_typeARootLattice_iff (x : Fin n → ℚ) :
    x ∈ (typeARootLattice n).dualCarrier ↔ ∀ i j, ∃ m : ℤ,
      (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) i -
        (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) j = m := by
  constructor
  · intro hx i j
    -- Every dual class is a multiple `k ω₁`, whose coordinates all lie in `ℤ - k / (n + 1)`.
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp
      ((zmultiples_typeAFundamentalWeightClass n).symm ▸ AddSubgroup.mem_top
        (Submodule.Quotient.mk ⟨x, hx⟩ : (typeARootLattice n).DiscriminantGroup))
    have hc := (mk_eq_zsmul_typeAFundamentalWeightClass_iff_forall_exists_intCast_sub
      ⟨x, hx⟩ k).mp hk.symm
    obtain ⟨a, ha⟩ := hc i
    obtain ⟨b, hb⟩ := hc j
    exact ⟨a - b, by rw [ha, hb]; push_cast; ring⟩
  · intro h
    -- With `yⱼ - y₀ = mⱼ` and `s = ∑ mⱼ = -(n + 1) y₀`, the vector `x - s ω₁` is integral.
    set y := (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) with hy
    choose m hm using fun j ↦ h j 0
    have hsum : ∑ j, y j = 0 :=
      (mem_singleParityCheckCode _ _).mp (typeAIsometryZeroSumLattice n x).2
    have hs : ∑ j, (m j : ℚ) = -((n : ℚ) + 1) * y 0 := by
      simp_rw [← hm]
      rw [sum_sub_distrib, hsum]
      simp
      ring
    have hmem : x - (∑ j, m j) • typeAFundamentalWeight n ∈ (typeARootLattice n).carrier := by
      rw [← (typeAIsometryZeroSumLattice n).apply_mem_carrier_iff, mem_zeroSumLattice_carrier_iff]
      intro j
      refine ⟨m j - (∑ j, m j) * if j = 0 then 1 else 0, ?_⟩
      rw [map_sub, map_zsmul]
      simp only [AddSubgroupClass.coe_sub, SetLike.val_smul_of_tower, zsmul_eq_mul, Int.cast_sum,
        Pi.sub_apply, Pi.mul_apply, Finset.sum_apply, Pi.intCast_apply,
        typeAIsometryZeroSumLattice_typeAFundamentalWeight_apply, one_div, mul_ite, mul_one,
        mul_zero, Int.cast_sub, Int.cast_ite, Int.cast_zero]
      have hn : (n : ℚ) + 1 ≠ 0 := by positivity
      rw [hs, ← hm j]
      field_simp
      split_ifs <;> ring
    simpa using add_mem ((typeARootLattice n).le_dualCarrier hmem)
      (zsmul_mem (typeAFundamentalWeight_mem_dualCarrier n) (∑ j, m j))

/-- **The subgroup of order `d` of the discriminant group of `Aₙ` in classical coordinates.**
If `e d = n + 1`, a dual vector of `Aₙ` lies in a class of the cyclic subgroup of order `d`
generated by `e ω₁` exactly when `d` times each of its classical coordinates is an integer. -/
theorem mk_mem_zmultiples_nsmul_typeAFundamentalWeightClass_iff {e d : ℕ} (hed : e * d = n + 1)
    (x : (typeARootLattice n).dualCarrier) :
    (Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup) ∈
        AddSubgroup.zmultiples (e • typeAFundamentalWeightClass n) ↔
      ∀ j, ∃ m : ℤ, d * (typeAIsometryZeroSumLattice n x : Fin (n + 1) → ℚ) j = m := by
  have hed' : (e : ℚ) * d = n + 1 := by exact_mod_cast hed
  have hpos : (0 : ℚ) < n + 1 := by positivity
  have he : (e : ℚ) ≠ 0 := by
    rintro h
    rw [h, zero_mul] at hed'
    linarith
  have hd : (d : ℚ) ≠ 0 := by
    rintro h
    rw [h, mul_zero] at hed'
    linarith
  constructor
  · rintro ⟨t, ht⟩ j
    simp only at ht
    have ht' : (Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup) =
        (t * e) • typeAFundamentalWeightClass n := by
      rw [← ht, ← natCast_zsmul, ← mul_zsmul, mul_comm]
    obtain ⟨m, hm⟩ :=
      (mk_eq_zsmul_typeAFundamentalWeightClass_iff_forall_exists_intCast_sub x _).mp ht' j
    refine ⟨d * m - t, ?_⟩
    rw [hm, ← hed']
    push_cast
    field_simp
  · intro h
    -- The class is some `k ω₁`; integrality of `d y₀ = d m₀ - k / e` forces `e ∣ k`.
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp
      ((zmultiples_typeAFundamentalWeightClass n).symm ▸ AddSubgroup.mem_top
        (Submodule.Quotient.mk x : (typeARootLattice n).DiscriminantGroup))
    obtain ⟨m, hm⟩ :=
      (mk_eq_zsmul_typeAFundamentalWeightClass_iff_forall_exists_intCast_sub x k).mp hk.symm 0
    obtain ⟨c, hc⟩ := h 0
    have hk' : (k : ℚ) = e * (d * m - c) := by
      rw [hm, ← hed'] at hc
      field_simp at hc
      linear_combination -hc
    refine ⟨d * m - c, ?_⟩
    dsimp only
    rw [← hk, ← natCast_zsmul, ← mul_zsmul']
    congr 1
    exact_mod_cast hk'.symm

end TauCeti.IntegralLattice
