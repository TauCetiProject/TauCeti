module

public import TauCeti.LinearAlgebra.IntegralLattice.Overlattice.Isotropic

/-!
# Short vectors and roots of glued lattices

If every representative of a nonzero glue class has norm at least `r`, then all vectors
of norm strictly less than `r` in the glued lattice already belong to the original lattice.
Consequently their norm shells have the same images in the rational ambient space. In
particular, when `2 < r` and the original lattice is generated by its roots, the integral
span of the glued lattice's roots is literally the original carrier.

The bound is required only on nonzero classes in the chosen subgroup. It can be supplied
by actual coset minima together with lower bounds for those minima; it requires neither
attainment nor positive definiteness for the exclusion argument itself.

The constructions and representative equations come from
`TauCeti.LinearAlgebra.IntegralLattice.Overlattice.Basic` and
`TauCeti.LinearAlgebra.IntegralLattice.Overlattice.Isotropic`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed.,
  Chapter 4 §6 and Chapter 16 §1, for coset minima and the exclusion of additional roots
  in glue constructions.
-/

public section

namespace TauCeti.IntegralLattice

universe u

variable {V : Type u} [AddCommGroup V] [Module ℚ V]
variable (L : IntegralLattice V)

/-- A vector of an intermediate carrier below the norm bound for its nonzero glue classes
belongs to the original lattice. This uses only the carrier correspondence, without any
integrality or nondegeneracy assumption on the intermediate carrier. -/
theorem mem_carrier_of_mem_intermediateCarrierOfDiscriminantSubgroup_of_norm_lt
    (H : AddSubgroup L.DiscriminantGroup) {r : ℚ}
    (hbound : ∀ x : L.dualCarrier, (Submodule.Quotient.mk x : L.DiscriminantGroup) ∈ H →
      (Submodule.Quotient.mk x : L.DiscriminantGroup) ≠ 0 → r ≤ L.norm x)
    {x : V} (hx : x ∈ (L.intermediateCarrierOfDiscriminantSubgroup H).1)
    (hnorm : L.norm x < r) : x ∈ L.carrier := by
  obtain ⟨hxdual, hxH⟩ :=
    (L.mem_intermediateCarrierOfDiscriminantSubgroup_iff H x).mp hx
  apply (L.discriminantGroup_mk_eq_zero_iff ⟨x, hxdual⟩).mp
  by_contra hne
  exact (not_le_of_gt hnorm) (hbound ⟨x, hxdual⟩ hxH hne)

variable [L.IsNondegenerate]

/-- Gluing adds no vectors to a prescribed norm shell strictly below the lower bound for
all nonzero glue classes. The equality compares ambient images, since the two shells have
different lattice carriers. -/
theorem image_vectorsOfNorm_ofIsotropicSubgroup_eq (hL : L.IsEven)
    (H : AddSubgroup L.DiscriminantGroup)
    (hH : (L.discriminantQuadraticModule hL).IsIsotropic H) {r n : ℚ}
    (hbound : ∀ x : L.dualCarrier, (Submodule.Quotient.mk x : L.DiscriminantGroup) ∈ H →
      (Submodule.Quotient.mk x : L.DiscriminantGroup) ≠ 0 → r ≤ L.norm x)
    (hn : n < r) :
    (fun x : L.ofIsotropicSubgroup hL H hH ↦ (x : V)) ''
        (L.ofIsotropicSubgroup hL H hH).vectorsOfNorm n =
      (fun x : L ↦ (x : V)) '' L.vectorsOfNorm n := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    have hynorm : L.norm y = n := by
      simpa only [mem_vectorsOfNorm, norm_apply, ofIsotropicSubgroup_form] using hy
    have hymem : (y : V) ∈ (L.intermediateCarrierOfDiscriminantSubgroup H).1 := by
      simpa only [ofIsotropicSubgroup_carrier] using y.2
    have hyL := L.mem_carrier_of_mem_intermediateCarrierOfDiscriminantSubgroup_of_norm_lt
      H hbound hymem (hynorm.trans_lt hn)
    exact ⟨⟨y, hyL⟩, mem_vectorsOfNorm.mpr hynorm, rfl⟩
  · rintro ⟨y, hy, rfl⟩
    have hymem : (y : V) ∈ (L.ofIsotropicSubgroup hL H hH).carrier := by
      rw [ofIsotropicSubgroup_carrier]
      exact (L.intermediateCarrierOfDiscriminantSubgroup H).2.1 y.2
    refine ⟨⟨y, hymem⟩, ?_, rfl⟩
    simpa only [mem_vectorsOfNorm, norm_apply, ofIsotropicSubgroup_form] using hy

/-- If the original lattice is generated by its roots and every nonzero glue class has
norm strictly greater than two, the root sublattice of the glued lattice, viewed in the
common rational ambient space, is exactly the original carrier. -/
theorem span_vectorsOfNorm_two_ofIsotropicSubgroup_eq (hL : L.IsEven)
    (H : AddSubgroup L.DiscriminantGroup)
    (hH : (L.discriminantQuadraticModule hL).IsIsotropic H) {r : ℚ}
    (hbound : ∀ x : L.dualCarrier, (Submodule.Quotient.mk x : L.DiscriminantGroup) ∈ H →
      (Submodule.Quotient.mk x : L.DiscriminantGroup) ≠ 0 → r ≤ L.norm x)
    (hr : 2 < r) (hspan : Submodule.span ℤ (L.vectorsOfNorm 2) = ⊤) :
    Submodule.span ℤ
        ((fun x : L.ofIsotropicSubgroup hL H hH ↦ (x : V)) ''
          (L.ofIsotropicSubgroup hL H hH).vectorsOfNorm 2) = L.carrier := by
  rw [L.image_vectorsOfNorm_ofIsotropicSubgroup_eq hL H hH hbound hr]
  exact (Submodule.span_val_image_eq_iff L.carrier (L.vectorsOfNorm 2)).mpr hspan

end TauCeti.IntegralLattice
