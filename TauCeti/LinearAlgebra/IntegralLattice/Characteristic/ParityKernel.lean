/-!
# The discriminant group and overlattices of the norm-parity kernel

For an integral lattice `L`, the canonical even sublattice `L.evenSublattice` is the kernel of norm
parity. When `L` is odd, `L.evenSublattice` has index two in `L`, so its signed determinant and
discriminant are four times those of `L`.

When `L` is unimodular and `w` is a characteristic vector of `L`, half of `w` lies in the dual
carrier of `L.evenSublattice`, and the dual carrier is spanned over `L` by `(1 / 2) • w`:

```text
(L_even)ᵛ = L + ℤ · (w / 2) = L ∪ (w / 2 + L).
```

Reducing the integral bilinear form modulo two and applying the characteristic-two normal-form
dichotomy (`Nondegenerate.exists_basis_toMatrix_eq_J_or_toMatrix_eq_one`) gives the elementary
parity congruence `L.integralNorm w ≡ Module.finrank ℤ L [ZMOD 2]` without signature or Gauss sums.
Consequently, for an odd unimodular lattice `L`:

* in odd rank, the discriminant group `A_(L_even)` is cyclic of order four, generated by the class
  of `w / 2`;
* in even rank, `A_(L_even)` is isomorphic to `ℤ/2 × ℤ/2`, generated by the class of any odd-norm
  vector `e ∈ L` and the class of `w / 2`.

In even rank the three subgroups of order two in `A_(L_even)` are generated by `[e]` (recovering
`L` itself), `[w / 2]`, and `[e + w / 2]`. The latter two intermediate carriers are integral
precisely when `4 ∣ L.integralNorm w`, and are even (hence even unimodular Kneser two-neighbors of
`L`) precisely when `8 ∣ L.integralNorm w`. Conversely, every even Kneser two-neighbor of `L`
meets `L` in `L.evenSublattice` and arises by gluing along `[w / 2]` or `[e + w / 2]`.

## Main definitions

* `TauCeti.IntegralLattice.halfCharacteristicDual` and
  `TauCeti.IntegralLattice.halfCharacteristicClass`: the dual vector `(1 / 2) • w` of
  `L.evenSublattice` and its discriminant class.
* `TauCeti.IntegralLattice.oddVectorDual` and `TauCeti.IntegralLattice.oddVectorClass`: a lattice
  vector regarded in `(L_even)ᵛ` and its discriminant class.
* `TauCeti.IntegralLattice.zmodFourAddEquivEvenSublatticeDiscriminantGroup`: `ℤ/4 ≃+ A_(L_even)` in
  odd rank.
* `TauCeti.IntegralLattice.zmodTwoProdAddEquivEvenSublatticeDiscriminantGroup`:
  `ℤ/2 × ℤ/2 ≃+ A_(L_even)` in even rank.
* `TauCeti.IntegralLattice.halfCharacteristicSubgroup` and
  `TauCeti.IntegralLattice.shiftedHalfCharacteristicSubgroup`: the two non-`L` cyclic subgroups
  `⟨[w / 2]⟩` and `⟨[e + w / 2]⟩` of `A_(L_even)`.
* `TauCeti.IntegralLattice.halfCharacteristicOverlattice` and
  `TauCeti.IntegralLattice.shiftedHalfCharacteristicOverlattice`: the two even unimodular
  two-neighbors of an odd unimodular lattice when `8 ∣ L.integralNorm w`.

## Main results

* `TauCeti.IntegralLattice.relIndex_evenSublattice_of_not_isEven`: `[L : L_even] = 2` for odd `L`.
* `TauCeti.IntegralLattice.mem_evenSublattice_dualCarrier_iff` and
  `TauCeti.IntegralLattice.evenSublattice_dualCarrier_eq_sup_span_half_characteristic`:
  `(L_even)ᵛ = L ∪ (w / 2 + L) = L + ℤ(w / 2)` for unimodular `L`.
* `TauCeti.IntegralLattice.IsUnimodular.integralNorm_characteristicVector_modEq_finrank`:
  `L.integralNorm w ≡ Module.finrank ℤ L [ZMOD 2]`.
* `TauCeti.IntegralLattice.eq_halfCharacteristicOverlattice_or_shifted_of_isNeighbor`: every even
  Kneser two-neighbor of an odd unimodular lattice is one of the two half-characteristic
  overlattices.

## References

* J.-P. Serre, *A Course in Arithmetic*, Chapter V, §1.4 and §2.2.
* J. Milnor and D. Husemoller, *Symmetric Bilinear Forms*, Chapter II and Appendix 4.
* M. Kneser, *Klassenzahlen definiter quadratischer Formen*, Arch. Math. 8 (1957), 241--250.
-/

public section

open Module

namespace TauCeti.IntegralLattice

universe u

variable {V : Type u} [AddCommGroup V] [Module ℚ V]

/-! ## Equal-form signature invariance and even-sublattice index -/

/-- Two integral lattices on the same ambient space with the same rational bilinear form have the
same signature. -/
theorem signature_eq_of_form_eq {L M : IntegralLattice V} (h : L.form = M.form) :
    L.signature = M.signature :=
  L.signature_eq_of_equivalent ⟨h ▸ LinearMap.BilinForm.IsometryEquiv.refl L.form⟩

/-- Kneser `p`-neighbors share the same ambient rational form and therefore the same signature. -/
theorem IsNeighbor.signature_eq {L M : IntegralLattice V} {p : ℕ} (h : L.IsNeighbor M p) :
    L.signature = M.signature :=
  signature_eq_of_form_eq h.form_eq

variable (L : IntegralLattice V)

/-- The even sublattice coincides with the lattice itself precisely when the lattice is even. -/
@[simp]
theorem evenSublattice_eq_self_iff : L.evenSublattice = L ↔ L.IsEven := by
  refine ⟨fun h ↦ h ▸ L.isEven_evenSublattice, fun h ↦ ?_⟩
  refine IntegralLattice.ext (le_antisymm L.evenSublattice_carrier_le fun x hx ↦ ?_)
    L.evenSublattice_form
  exact (L.mem_evenSublattice_carrier_iff ⟨x, hx⟩).mpr
    ((L.even_integralNorm_iff ⟨x, hx⟩).mpr (L.isEven_iff_forall_norm.mp h ⟨x, hx⟩))

/-- The even sublattice has index one in the lattice precisely when the lattice is even. -/
theorem relIndex_evenSublattice_eq_one_iff :
    L.evenSublattice.carrier.toAddSubgroup.relIndex L.carrier.toAddSubgroup = 1 ↔ L.IsEven := by
  rw [AddSubgroup.relIndex_eq_one, Submodule.toAddSubgroup_le]
  refine ⟨fun h ↦ L.evenSublattice_eq_self_iff.mp
    (IntegralLattice.ext (le_antisymm L.evenSublattice_carrier_le h) L.evenSublattice_form),
    fun h ↦ le_of_eq (congrArg IntegralLattice.carrier (L.evenSublattice_eq_self_iff.mpr h).symm)⟩

/-- **The even sublattice has index two in every odd integral lattice.** -/
theorem relIndex_evenSublattice_of_not_isEven (hL : ¬ L.IsEven) :
    L.evenSublattice.carrier.toAddSubgroup.relIndex L.carrier.toAddSubgroup = 2 := by
  have htop : (⊤ : AddSubgroup L).map (L.carrier.subtype : L →+ V) =
      L.carrier.toAddSubgroup :=
    (AddSubgroup.map_top _).trans (AddSubgroup.range_subtype L.carrier.toAddSubgroup)
  rw [evenSublattice_carrier, Submodule.map_toAddSubgroup, ← htop,
    AddSubgroup.relIndex_map_map_of_injective _ _ L.carrier.injective_subtype,
    AddSubgroup.relIndex_top_right, AddSubgroup.index_eq_card]
  exact L.natCard_quotient_evenSubmodule hL

/-- For an odd lattice, the signed determinant of the even sublattice is four times that of the
lattice. No nondegeneracy is needed. -/
theorem determinant_evenSublattice_of_not_isEven (hL : ¬ L.IsEven) :
    L.evenSublattice.determinant = 4 * L.determinant := by
  rw [L.evenSublattice.determinant_eq_mul_relIndex_sq L L.evenSublattice_form
    L.evenSublattice_carrier_le, L.relIndex_evenSublattice_of_not_isEven hL]
  ring

/-- For an odd lattice, the discriminant of the even sublattice is four times that of the lattice.
No nondegeneracy is needed. -/
theorem discriminant_evenSublattice_of_not_isEven (hL : ¬ L.IsEven) :
    L.evenSublattice.discriminant = 4 * L.discriminant := by
  rw [L.evenSublattice.discriminant_eq_mul_relIndex_sq L L.evenSublattice_form
    L.evenSublattice_carrier_le, L.relIndex_evenSublattice_of_not_isEven hL]
  ring

/-- For an odd unimodular lattice, the discriminant group of its even sublattice has order four. -/
theorem natCard_evenSublattice_discriminantGroup (hLu : L.IsUnimodular) (hL : ¬ L.IsEven) :
    Nat.card L.evenSublattice.DiscriminantGroup = 4 := by
  have : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  rw [L.evenSublattice.natCard_discriminantGroup, L.discriminant_evenSublattice_of_not_isEven hL,
    L.isUnimodular_iff_discriminant_eq_one.mp hLu, mul_one]

/-! ## Half-characteristic dual vectors and the dual of `L.evenSublattice` -/

/-- Half of a characteristic vector pairs integrally with every even-norm lattice vector, so it
lies in the dual carrier of the even sublattice. -/
theorem half_characteristic_mem_evenSublattice_dualCarrier {w : L}
    (hw : L.IsCharacteristicVector w) :
    (1 / 2 : ℚ) • (w : V) ∈ L.evenSublattice.dualCarrier := by
  rw [LinearMap.BilinForm.mem_dualSubmodule]
  intro y hy
  let yL : L := ⟨y, L.evenSublattice_carrier_le hy⟩
  have he : Even (L.integralNorm yL) := (L.mem_evenSublattice_carrier_iff yL).mp hy
  have hp := (L.isCharacteristicVector_iff w).mp hw yL
  obtain ⟨k, hk⟩ := Int.modEq_zero_iff_dvd.mp
    (hp.trans (Int.modEq_zero_iff_dvd.mpr (even_iff_two_dvd.mp he)))
  refine Submodule.mem_one.mpr ⟨k, ?_⟩
  rw [eq_intCast, L.evenSublattice_form, map_smul, LinearMap.smul_apply, smul_eq_mul,
    ← L.integralForm_cast w yL, hk]
  push_cast
  ring

/-- Half of a characteristic vector, packaged in the dual carrier of `L.evenSublattice`. -/
noncomputable def halfCharacteristicDual {w : L} (hw : L.IsCharacteristicVector w) :
    L.evenSublattice.dualCarrier :=
  ⟨(1 / 2 : ℚ) • (w : V), L.half_characteristic_mem_evenSublattice_dualCarrier hw⟩

/-- Ambient coercion of `halfCharacteristicDual`. -/
@[simp]
theorem coe_halfCharacteristicDual {w : L} (hw : L.IsCharacteristicVector w) :
    (L.halfCharacteristicDual hw : V) = (1 / 2 : ℚ) • (w : V) :=
  (rfl)

/-- The discriminant class of `(1 / 2) • w` in `A_(L_even)`. -/
noncomputable def halfCharacteristicClass {w : L} (hw : L.IsCharacteristicVector w) :
    L.evenSublattice.DiscriminantGroup :=
  Submodule.Quotient.mk (L.halfCharacteristicDual hw)

/-- `halfCharacteristicClass` unfolded as the quotient class of `halfCharacteristicDual`. -/
theorem halfCharacteristicClass_def {w : L} (hw : L.IsCharacteristicVector w) :
    L.halfCharacteristicClass hw = Submodule.Quotient.mk (L.halfCharacteristicDual hw) :=
  (rfl)

/-- Any vector of `L` lies in the dual carrier of `L.evenSublattice`. -/
theorem coe_mem_evenSublattice_dualCarrier (x : L) :
    (x : V) ∈ L.evenSublattice.dualCarrier := by
  rw [LinearMap.BilinForm.mem_dualSubmodule, L.evenSublattice_form]
  exact fun y hy ↦ L.form_mem_one x ⟨y, L.evenSublattice_carrier_le hy⟩

/-- A vector of `L`, packaged in the dual carrier of `L.evenSublattice`. -/
noncomputable def oddVectorDual (x : L) : L.evenSublattice.dualCarrier :=
  ⟨(x : V), L.coe_mem_evenSublattice_dualCarrier x⟩

/-- Ambient coercion of `oddVectorDual`. -/
@[simp]
theorem coe_oddVectorDual (x : L) : (L.oddVectorDual x : V) = (x : V) :=
  (rfl)

/-- The discriminant class in `A_(L_even)` of a lattice vector `x ∈ L`. -/
noncomputable def oddVectorClass (x : L) : L.evenSublattice.DiscriminantGroup :=
  Submodule.Quotient.mk (L.oddVectorDual x)

/-- `oddVectorClass` unfolded as the quotient class of `oddVectorDual`. -/
theorem oddVectorClass_def (x : L) :
    L.oddVectorClass x = Submodule.Quotient.mk (L.oddVectorDual x) :=
  (rfl)

/-- The class of a lattice vector in `A_(L_even)` vanishes precisely when its norm is even. -/
@[simp]
theorem oddVectorClass_eq_zero_iff (x : L) :
    L.oddVectorClass x = 0 ↔ Even (L.integralNorm x) := by
  rw [oddVectorClass_def, L.evenSublattice.discriminantGroup_mk_eq_zero_iff, coe_oddVectorDual,
    L.mem_evenSublattice_carrier_iff]

/-- Every lattice vector defines a two-torsion class in `A_(L_even)`. -/
@[simp]
theorem two_nsmul_oddVectorClass (x : L) : 2 • L.oddVectorClass x = 0 := by
  rw [oddVectorClass_def, ← Nat.cast_smul_eq_nsmul ℤ, ← Submodule.Quotient.mk_smul,
    Nat.cast_smul_eq_nsmul ℤ, L.evenSublattice.discriminantGroup_mk_eq_zero_iff]
  have h : ((2 • L.oddVectorDual x : L.evenSublattice.dualCarrier) : V) =
      (((2 : ℤ) • x : L) : V) := by
    simp [two_smul]
  rw [h, L.mem_evenSublattice_carrier_iff]
  exact (L.mem_evenSubmodule_iff _).mp (L.two_smul_mem_evenSubmodule x)

/-- Integer scalar multiplication by `2` annihilates every `oddVectorClass`. -/
theorem two_zsmul_oddVectorClass (x : L) : (2 : ℤ) • L.oddVectorClass x = 0 := by
  rw [two_zsmul, ← two_nsmul, L.two_nsmul_oddVectorClass]

/-- Half of a characteristic vector cannot lie in an odd lattice, since otherwise `w` would be
twice a lattice vector and `0` would be characteristic. -/
theorem half_characteristic_notMem_carrier_of_not_isEven {w : L}
    (hw : L.IsCharacteristicVector w) (hL : ¬ L.IsEven) :
    (1 / 2 : ℚ) • (w : V) ∉ L.carrier := by
  intro hm
  have hw2 : w = 0 + (2 : ℤ) • (⟨(1 / 2 : ℚ) • (w : V), hm⟩ : L) := by
    apply Subtype.ext
    simp only [zero_add, Submodule.coe_smul_of_tower, ← Int.cast_smul_eq_zsmul ℚ, smul_smul]
    norm_num
  rw [hw2, L.isCharacteristicVector_add_two_smul_iff] at hw
  exact hL (L.isEven_iff_isCharacteristicVector_zero.mpr hw)

/-- In a unimodular lattice, half of a characteristic vector lies in the carrier precisely when
the lattice is even. -/
theorem half_characteristic_mem_carrier_iff (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) :
    (1 / 2 : ℚ) • (w : V) ∈ L.carrier ↔ L.IsEven := by
  refine ⟨fun hm ↦ by_contra fun hL ↦ L.half_characteristic_notMem_carrier_of_not_isEven hw hL hm,
    fun hLe ↦ ?_⟩
  obtain ⟨v, hv⟩ := hLu.exists_characteristicVector_sub_eq_two_smul hw
    (L.isEven_iff_isCharacteristicVector_zero.mp hLe)
  have hEq : (1 / 2 : ℚ) • (w : V) = (v : V) := by
    have hv' := congrArg (Subtype.val : L → V) hv
    simp only [sub_zero, Submodule.coe_smul_of_tower, ← Int.cast_smul_eq_zsmul ℚ] at hv'
    rw [hv', smul_smul]
    norm_num
  exact hEq ▸ v.2

/-- The discriminant quadratic map evaluates `[w / 2]` to `w² / 8` modulo `1`. -/
theorem discriminantQuadraticMap_halfCharacteristicClass {w : L}
    (hw : L.IsCharacteristicVector w) :
    L.evenSublattice.discriminantQuadraticMap L.isEven_evenSublattice
        (L.halfCharacteristicClass hw) =
      ZMod.toRatAddCircle 8 (L.integralNorm w : ZMod 8) := by
  rw [halfCharacteristicClass_def, discriminantQuadraticMap_mk, L.evenSublattice_form,
    ZMod.toRatAddCircle_intCast, L.integralNorm_cast, L.norm_apply]
  simp only [coe_halfCharacteristicDual, map_smul, LinearMap.smul_apply, smul_eq_mul]
  congr 1
  ring

private theorem halfNorm_add_lattice_vector {w : L} (hw : L.IsCharacteristicVector w) (y : L) :
    ∃ k : ℤ, L.form ((1 / 2 : ℚ) • (w : V) + y) ((1 / 2 : ℚ) • (w : V) + y) / 2 =
      L.form ((1 / 2 : ℚ) • (w : V)) ((1 / 2 : ℚ) • (w : V)) / 2 + k := by
  obtain ⟨k, hk⟩ := Int.modEq_iff_dvd.mp ((L.isCharacteristicVector_iff w).mp hw y)
  refine ⟨L.integralForm w y + k, ?_⟩
  rw [← L.norm_apply, ← L.norm_apply, L.norm_add]
  simp only [L.norm_smul, map_smul, LinearMap.smul_apply, smul_eq_mul]
  rw [← L.integralForm_cast w y, ← L.integralNorm_cast y]
  have hkq : (L.integralNorm y : ℚ) - L.integralForm w y = 2 * k := by exact_mod_cast hk
  push_cast
  linarith

/-- Translating `[w / 2]` by any class from `L / L_even` leaves the discriminant quadratic value
unchanged. -/
theorem discriminantQuadraticMap_halfCharacteristicClass_add {w : L}
    (hw : L.IsCharacteristicVector w)
    (h : L.evenSublattice.discriminantSubgroup
      (L.toIntermediateCarrier L.evenSublattice_form.symm L.evenSublattice_carrier_le)) :
    L.evenSublattice.discriminantQuadraticMap L.isEven_evenSublattice
        (L.halfCharacteristicClass hw + h) =
      L.evenSublattice.discriminantQuadraticMap L.isEven_evenSublattice
        (L.halfCharacteristicClass hw) := by
  obtain ⟨x, hx⟩ := h
  induction x using Submodule.Quotient.induction_on with
  | _ y =>
    have hy : (y : V) ∈ L.carrier := by
      have := (L.evenSublattice.mk_mem_discriminantSubgroup_iff
        (L.toIntermediateCarrier L.evenSublattice_form.symm L.evenSublattice_carrier_le) y).mp hx
      rwa [coe_toIntermediateCarrier] at this
    obtain ⟨k, hk⟩ := L.halfNorm_add_lattice_vector hw ⟨y, hy⟩
    rw [halfCharacteristicClass_def, ← Submodule.Quotient.mk_add, discriminantQuadraticMap_mk,
      discriminantQuadraticMap_mk, L.evenSublattice_form]
    simp only [Submodule.coe_add, coe_halfCharacteristicDual]
    rw [hk, AddCircle.coe_add_intCast]

/-- For any lattice vector `e ∈ L`, the shifted class `[e] + [w / 2]` has the same discriminant
quadratic value `w² / 8` modulo `1` as `[w / 2]`. -/
theorem discriminantQuadraticMap_oddVectorClass_add_halfCharacteristicClass {w : L}
    (hw : L.IsCharacteristicVector w) (e : L) :
    L.evenSublattice.discriminantQuadraticMap L.isEven_evenSublattice
        (L.oddVectorClass e + L.halfCharacteristicClass hw) =
      ZMod.toRatAddCircle 8 (L.integralNorm w : ZMod 8) := by
  have he : L.oddVectorClass e ∈ L.evenSublattice.discriminantSubgroup
      (L.toIntermediateCarrier L.evenSublattice_form.symm L.evenSublattice_carrier_le) := by
    rw [oddVectorClass_def, L.evenSublattice.mk_mem_discriminantSubgroup_iff,
      coe_toIntermediateCarrier, coe_oddVectorDual]
    exact e.2
  rw [add_comm, L.discriminantQuadraticMap_halfCharacteristicClass_add hw ⟨_, he⟩,
    L.discriminantQuadraticMap_halfCharacteristicClass hw]

private theorem two_smul_mem_carrier_of_mem_evenSublattice_dualCarrier (hLu : L.IsUnimodular)
    {x : V} (hx : x ∈ L.evenSublattice.dualCarrier) : (2 : ℚ) • x ∈ L.carrier := by
  rw [L.isUnimodular_def.mp hLu, LinearMap.BilinForm.mem_dualSubmodule]
  intro y hy
  have hy2 : ((2 : ℤ) • (⟨y, hy⟩ : L) : V) ∈ L.evenSublattice.carrier :=
    (L.mem_evenSublattice_carrier_iff _).mpr
      ((L.mem_evenSubmodule_iff _).mp (L.two_smul_mem_evenSubmodule ⟨y, hy⟩))
  have hxy := hx _ hy2
  simpa only [L.evenSublattice_form, Submodule.coe_smul_of_tower, ← Int.cast_smul_eq_zsmul ℚ,
    map_smul, LinearMap.smul_apply, Int.cast_ofNat] using hxy

private theorem isCharacteristicVector_of_even_on_evenNorm {u y₀ : L}
    (hu_even : ∀ z : L, Even (L.integralNorm z) → Even (L.integralForm u z))
    (hy₀ : ¬ Even (L.integralForm u y₀)) : L.IsCharacteristicVector u := by
  have hy₀p : L.normParity y₀ = 1 := by
    rw [normParity_apply, ZMod.intCast_eq_one_iff_odd, ← Int.not_even_iff_odd]
    exact fun h ↦ hy₀ (hu_even y₀ h)
  rw [L.isCharacteristicVector_iff_forall_integralForm_eq_normParity]
  intro y
  rcases (by decide : ∀ a : ZMod 2, a = 0 ∨ a = 1) (L.normParity y) with hy0 | hy1
  · rw [hy0, ZMod.intCast_eq_zero_iff_even]
    exact hu_even y ((ZMod.intCast_eq_zero_iff_even).mp (L.normParity_apply y ▸ hy0))
  · have hsum : Even (L.integralNorm (y + y₀)) := by
      rw [← ZMod.intCast_eq_zero_iff_even, ← L.normParity_apply, map_add, hy1, hy₀p]
      decide
    have hform := (ZMod.intCast_eq_zero_iff_even).mpr (hu_even (y + y₀) hsum)
    have hform₀ : (L.integralForm u y₀ : ZMod 2) = 1 :=
      (ZMod.intCast_eq_one_iff_odd).mpr (Int.not_even_iff_odd.mp hy₀)
    rw [map_add, Int.cast_add, hform₀] at hform
    rw [hy1]
    exact CharTwo.add_eq_zero.mp hform

/-- **Coset description of `(L_even)ᵛ` for unimodular `L`.** Every dual vector of the even
sublattice lies either in `L` or in `(1 / 2) • w + L`. Both even and odd unimodular lattices are
covered. -/
theorem mem_evenSublattice_dualCarrier_iff (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) (x : V) :
    x ∈ L.evenSublattice.dualCarrier ↔
      x ∈ L.carrier ∨ x - (1 / 2 : ℚ) • (w : V) ∈ L.carrier := by
  refine ⟨fun hx ↦ ?_, ?_⟩
  · let u : L := ⟨(2 : ℚ) • x, L.two_smul_mem_carrier_of_mem_evenSublattice_dualCarrier hLu hx⟩
    have hu_even (z : L) (hz : Even (L.integralNorm z)) : Even (L.integralForm u z) := by
      obtain ⟨k, hk⟩ := Submodule.mem_one.mp (hx z ((L.mem_evenSublattice_carrier_iff z).mpr hz))
      refine ⟨k, Int.cast_injective (α := ℚ) ?_⟩
      rw [L.integralForm_cast]
      simp only [u, map_smul, LinearMap.smul_apply, smul_eq_mul, L.evenSublattice_form] at hk ⊢
      rw [← hk, eq_intCast]
      push_cast
      ring
    by_cases hall : ∀ y : L, Even (L.integralForm u y)
    · left
      rw [L.isUnimodular_def.mp hLu, LinearMap.BilinForm.mem_dualSubmodule]
      intro y hy
      obtain ⟨k, hk⟩ := hall ⟨y, hy⟩
      refine Submodule.mem_one.mpr ⟨k, ?_⟩
      have hcast := L.integralForm_cast u ⟨y, hy⟩
      simp only [u, map_smul, LinearMap.smul_apply, smul_eq_mul, hk] at hcast
      rw [eq_intCast]
      push_cast at hcast
      linarith
    · right
      push Not at hall
      obtain ⟨y₀, hy₀⟩ := hall
      have hu := L.isCharacteristicVector_of_even_on_evenNorm hu_even hy₀
      obtain ⟨v, hv⟩ := hLu.exists_characteristicVector_sub_eq_two_smul hu hw
      have hxv : x - (1 / 2 : ℚ) • (w : V) = (v : V) := by
        have hv' := congrArg (Subtype.val : L → V) hv
        simp only [u, Submodule.coe_sub, Submodule.coe_smul_of_tower,
          ← Int.cast_smul_eq_zsmul ℚ] at hv'
        calc
          x - (1 / 2 : ℚ) • (w : V) = (1 / 2 : ℚ) • ((2 : ℚ) • x - (w : V)) := by
            rw [smul_sub, smul_smul]; norm_num
          _ = (v : V) := by
            rw [hv', smul_smul]; norm_num
      exact hxv ▸ v.2
  · rintro (hx | hx)
    · exact L.coe_mem_evenSublattice_dualCarrier ⟨x, hx⟩
    · simpa only [sub_add_cancel] using L.evenSublattice.dualCarrier.add_mem
        (L.coe_mem_evenSublattice_dualCarrier ⟨_, hx⟩)
        (L.half_characteristic_mem_evenSublattice_dualCarrier hw)

/-- **Span description of `(L_even)ᵛ` for unimodular `L`:** `(L_even)ᵛ = L + ℤ · (w / 2)`. -/
theorem evenSublattice_dualCarrier_eq_sup_span_half_characteristic (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) :
    L.evenSublattice.dualCarrier = L.carrier ⊔ (ℤ ∙ ((1 / 2 : ℚ) • (w : V))) := by
  refine le_antisymm (fun x hx ↦ ?_) (sup_le (fun x hx ↦ L.coe_mem_evenSublattice_dualCarrier
    ⟨x, hx⟩) ((Submodule.span_singleton_le_iff_mem _ _).mpr
      (L.half_characteristic_mem_evenSublattice_dualCarrier hw)))
  rcases (L.mem_evenSublattice_dualCarrier_iff hLu hw x).mp hx with hxL | hxL
  · exact Submodule.mem_sup_left hxL
  · rw [← sub_add_cancel x ((1 / 2 : ℚ) • (w : V))]
    exact Submodule.add_mem_sup hxL (Submodule.mem_span_singleton_self _)

/-! ## Elementary mod-two parity of characteristic norms -/

omit L in
/-- **Characteristic-norm parity modulo two.** In a unimodular lattice, the norm of any
characteristic vector is congruent modulo two to the rank of the lattice. The proof reduces the
Gram matrix modulo two and applies the normal-form dichotomy over `𝔽₂` (symplectic in the
alternating case, orthonormal otherwise), without using signature or Gauss sums. -/
theorem IsUnimodular.integralNorm_characteristicVector_modEq_finrank {L : IntegralLattice V}
    (hLu : L.IsUnimodular) {w : L} (hw : L.IsCharacteristicVector w) :
    L.integralNorm w ≡ Module.finrank ℤ L [ZMOD 2] := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let n := Module.finrank ℤ L
  let b : Basis (Fin n) ℤ L := Module.finBasis ℤ L
  let G₂ : Matrix (Fin n) (Fin n) (ZMod 2) :=
    (Int.castRingHom (ZMod 2)).mapMatrix (L.gramMatrix b)
  let B : LinearMap.BilinForm (ZMod 2) (Fin n → ZMod 2) := G₂.toBilin'
  have hG₂unit : IsUnit G₂.det := by
    rw [← RingHom.map_det, ← L.gramDet_def]
    exact ((L.isUnimodular_iff_isUnit_gramDet b).mp hLu).map _
  have hBsymm : LinearMap.BilinForm.IsSymm B :=
    Matrix.isSymm_toBilin'_iff_isSymm.mpr ((L.isSymm_gramMatrix b).map _)
  have hBnd : B.Nondegenerate :=
    LinearMap.BilinForm.nondegenerate_toBilin'_of_det_ne_zero' G₂ hG₂unit.ne_zero
  let f (x : L) (i : Fin n) : ZMod 2 := b.repr x i
  have hf_form (x y : L) : B (f x) (f y) = (L.integralForm x y : ZMod 2) := by
    have hxy := LinearMap.BilinForm.apply_eq_dotProduct_toMatrix_mulVec b L.integralForm x y
    rw [← L.gramMatrix_eq_toMatrix] at hxy
    simpa [B, Matrix.toBilin'_apply', f, G₂, RingHom.mapMatrix_apply, dotProduct, Matrix.mulVec,
      Finset.sum_mul, mul_assoc] using (congrArg (Int.castRingHom (ZMod 2)) hxy).symm
  have hwB (x : Fin n → ZMod 2) : B (f w) x = B x x := by
    let y : L := b.repr.symm (Finsupp.equivFunOnFinite.symm fun i ↦ (x i).val)
    have hy : f y = x := by ext i; simp [f, y]
    rw [← hy, hf_form, hf_form, ← L.integralNorm_apply]
    exact (ZMod.intCast_eq_intCast_iff _ _ 2).mpr ((L.isCharacteristicVector_iff w).mp hw y)
  apply (ZMod.intCast_eq_intCast_iff _ _ 2).mp
  rw [L.integralNorm_apply, ← hf_form w w, Int.cast_natCast]
  rcases hBnd.exists_basis_toMatrix_eq_J_or_toMatrix_eq_one (fun a ↦ isSquare_of_charTwo' a)
    (Or.inr hBsymm) with ⟨halt, -⟩ | ⟨_, v, hv⟩
  · have heven : Even n := by
      simpa [Module.finrank_fintype_fun_eq_card] using halt.even_finrank hBnd
    rw [halt (f w), (ZMod.natCast_eq_zero_iff_even).mpr heven]
  · set s : Fin n → ZMod 2 := ∑ i, v i
    have hvB (i j : Fin (Module.finrank (ZMod 2) (Fin n → ZMod 2))) :
        B (v i) (v j) = if i = j then 1 else 0 := by
      simpa [LinearMap.BilinForm.toMatrix_apply, Matrix.one_apply] using
        congrFun (congrFun hv i) j
    have hzero : B (f w - s) = 0 := v.ext fun j ↦ by
      rw [map_sub, LinearMap.sub_apply, hwB (v j), hvB j j]
      simp [s, map_sum, LinearMap.sum_apply, hvB]
    have hw_eq : f w = s :=
      sub_eq_zero.mp (hBnd.1 (f w - s) fun m ↦ by rw [hzero, LinearMap.zero_apply])
    rw [hw_eq]
    simp [s, n, map_sum, LinearMap.sum_apply, hvB, Module.finrank_fintype_fun_eq_card]

omit L in
/-- A unimodular lattice of odd rank cannot be even. -/
theorem IsUnimodular.not_isEven_of_odd_finrank {L : IntegralLattice V} (hLu : L.IsUnimodular)
    (hodd : Odd (Module.finrank ℤ L)) : ¬ L.IsEven := by
  intro hLe
  have hmod := hLu.integralNorm_characteristicVector_modEq_finrank
    (L.isEven_iff_isCharacteristicVector_zero.mp hLe)
  rw [L.integralNorm_zero] at hmod
  exact Int.not_even_iff_odd.mpr hodd.natCast
    (even_iff_two_dvd.mpr (Int.modEq_zero_iff_dvd.mp hmod.symm))

/-! ## Structure of `A_(L_even)` in odd and even rank -/

/-- Twice the half-characteristic class `[w / 2]` vanishes in `A_(L_even)` precisely when the
norm of `w` is even. -/
theorem two_nsmul_halfCharacteristicClass_eq_zero_iff_even_integralNorm {w : L}
    (hw : L.IsCharacteristicVector w) :
    2 • L.halfCharacteristicClass hw = 0 ↔ Even (L.integralNorm w) := by
  rw [halfCharacteristicClass_def, ← Nat.cast_smul_eq_nsmul ℤ, ← Submodule.Quotient.mk_smul,
    Nat.cast_smul_eq_nsmul ℤ, L.evenSublattice.discriminantGroup_mk_eq_zero_iff]
  have h2 : ((2 • L.halfCharacteristicDual hw : L.evenSublattice.dualCarrier) : V) = (w : V) := by
    simp only [Submodule.coe_smul_of_tower, coe_halfCharacteristicDual,
      ← Nat.cast_smul_eq_nsmul ℚ, smul_smul]
    norm_num
  rw [h2, L.mem_evenSublattice_carrier_iff]

/-- In a unimodular lattice, twice `[w / 2]` vanishes in `A_(L_even)` precisely when the rank is
even. -/
theorem two_nsmul_halfCharacteristicClass_eq_zero_iff (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) :
    2 • L.halfCharacteristicClass hw = 0 ↔ Even (Module.finrank ℤ L) := by
  rw [L.two_nsmul_halfCharacteristicClass_eq_zero_iff_even_integralNorm hw,
    ← ZMod.intCast_eq_zero_iff_even,
    (ZMod.intCast_eq_intCast_iff _ _ 2).mpr
      (hLu.integralNorm_characteristicVector_modEq_finrank hw),
    Int.cast_natCast, ZMod.natCast_eq_zero_iff_even]

/-- In odd rank, twice `[w / 2]` is the unique nonzero class `[e]` of `L / L_even`. -/
theorem two_zsmul_halfCharacteristicClass_eq_oddVectorClass (hLu : L.IsUnimodular)
    (hodd : Odd (Module.finrank ℤ L)) {w : L} (hw : L.IsCharacteristicVector w)
    {e : L} (he : Odd (L.integralNorm e)) :
    (2 : ℤ) • L.halfCharacteristicClass hw = L.oddVectorClass e := by
  have hw_odd : Odd (L.integralNorm w) := by
    rw [← ZMod.intCast_eq_one_iff_odd,
      (ZMod.intCast_eq_intCast_iff _ _ 2).mpr
        (hLu.integralNorm_characteristicVector_modEq_finrank hw),
      Int.cast_natCast, ZMod.natCast_eq_one_iff_odd]
    exact hodd
  rw [halfCharacteristicClass_def, oddVectorClass_def, ← Submodule.Quotient.mk_smul,
    L.evenSublattice.discriminantGroup_mk_eq_iff]
  have hsub : (((2 : ℤ) • L.halfCharacteristicDual hw - L.oddVectorDual e :
      L.evenSublattice.dualCarrier) : V) = ((w - e : L) : V) := by
    simp only [Submodule.coe_sub, Submodule.coe_smul_of_tower, coe_halfCharacteristicDual,
      coe_oddVectorDual, ← Int.cast_smul_eq_zsmul ℚ, smul_smul]
    norm_num
  rw [hsub, L.mem_evenSublattice_carrier_iff, L.integralNorm_sub]
  exact (hw_odd.add_odd he).sub (even_two_mul _)

/-- **Four-element exhaustion of `A_(L_even)`:** for a unimodular lattice `L` with characteristic
vector `w` and an odd-norm vector `e ∈ L`, every element of `A_(L_even)` is `0`, `[e]`, `[w / 2]`,
or `[e] + [w / 2]`. -/
theorem evenSublatticeDiscriminantGroup_eq_four_classes (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) {e : L} (he : Odd (L.integralNorm e))
    (x : L.evenSublattice.DiscriminantGroup) :
    x = 0 ∨ x = L.oddVectorClass e ∨ x = L.halfCharacteristicClass hw ∨
      x = L.oddVectorClass e + L.halfCharacteristicClass hw := by
  induction x using Submodule.Quotient.induction_on with
  | _ y =>
    rcases (L.mem_evenSublattice_dualCarrier_iff hLu hw y).mp y.2 with hyL | hyL
    · let u : L := ⟨y, hyL⟩
      rcases Int.even_or_odd (L.integralNorm u) with hu | hu
      · left
        rw [L.evenSublattice.discriminantGroup_mk_eq_zero_iff]
        exact (L.mem_evenSublattice_carrier_iff u).mpr hu
      · right; left
        rw [oddVectorClass_def, L.evenSublattice.discriminantGroup_mk_eq_iff]
        have hsub : ((y - L.oddVectorDual e : L.evenSublattice.dualCarrier) : V) =
            ((u - e : L) : V) := rfl
        rw [hsub, L.mem_evenSublattice_carrier_iff, L.integralNorm_sub]
        exact (hu.add_odd he).sub (even_two_mul _)
    · let u : L := ⟨(y : V) - (1 / 2 : ℚ) • (w : V), hyL⟩
      rcases Int.even_or_odd (L.integralNorm u) with hu | hu
      · right; right; left
        rw [halfCharacteristicClass_def, L.evenSublattice.discriminantGroup_mk_eq_iff]
        exact (L.mem_evenSublattice_carrier_iff u).mpr hu
      · right; right; right
        rw [oddVectorClass_def, halfCharacteristicClass_def, ← Submodule.Quotient.mk_add,
          L.evenSublattice.discriminantGroup_mk_eq_iff]
        have hsub : ((y - (L.oddVectorDual e + L.halfCharacteristicDual hw) :
            L.evenSublattice.dualCarrier) : V) = ((u - e : L) : V) := by
          simp only [u, Submodule.coe_sub, Submodule.coe_add, coe_oddVectorDual,
            coe_halfCharacteristicDual]
          abel
        rw [hsub, L.mem_evenSublattice_carrier_iff, L.integralNorm_sub]
        exact (hu.add_odd he).sub (even_two_mul _)

/-- **In odd rank, `A_(L_even) ≃+ ℤ/4`**, generated by `[w / 2]`. -/
noncomputable def zmodFourAddEquivEvenSublatticeDiscriminantGroup (hLu : L.IsUnimodular)
    (hodd : Odd (Module.finrank ℤ L)) {w : L} (hw : L.IsCharacteristicVector w) :
    ZMod 4 ≃+ L.evenSublattice.DiscriminantGroup := by
  have hLo : ¬ L.IsEven := hLu.not_isEven_of_odd_finrank hodd
  have hw_odd : Odd (L.integralNorm w) := by
    rw [← ZMod.intCast_eq_one_iff_odd,
      (ZMod.intCast_eq_intCast_iff _ _ 2).mpr
        (hLu.integralNorm_characteristicVector_modEq_finrank hw),
      Int.cast_natCast, ZMod.natCast_eq_one_iff_odd]
    exact hodd
  refine zmodAddEquivOfGenerator (g := L.halfCharacteristicClass hw) (fun x ↦ ?_)
    (L.natCard_evenSublattice_discriminantGroup hLu hLo)
  have h2 := L.two_zsmul_halfCharacteristicClass_eq_oddVectorClass hLu hodd hw hw_odd
  rcases L.evenSublatticeDiscriminantGroup_eq_four_classes hLu hw hw_odd x with
    rfl | rfl | rfl | rfl
  · exact ⟨0, by simp⟩
  · exact ⟨2, h2⟩
  · exact ⟨1, one_zsmul _⟩
  · refine ⟨3, ?_⟩
    dsimp only
    have h3 : (3 : ℤ) = 2 + 1 := by norm_num
    rw [h3, add_zsmul, h2, one_zsmul]

/-- `zmodFourAddEquivEvenSublatticeDiscriminantGroup` sends `1` to `[w / 2]`. -/
@[simp]
theorem zmodFourAddEquivEvenSublatticeDiscriminantGroup_apply_one (hLu : L.IsUnimodular)
    (hodd : Odd (Module.finrank ℤ L)) {w : L} (hw : L.IsCharacteristicVector w) :
    L.zmodFourAddEquivEvenSublatticeDiscriminantGroup hLu hodd hw 1 =
      L.halfCharacteristicClass hw := by
  rw [zmodFourAddEquivEvenSublatticeDiscriminantGroup]
  exact zmodAddEquivOfGenerator_apply_one _ _

private noncomputable def evenSublatticeZModTwoHom (x : L.evenSublattice.DiscriminantGroup)
    (hx : (2 : ℤ) • x = 0) : ZMod 2 →+ L.evenSublattice.DiscriminantGroup :=
  ZMod.lift 2 ⟨zmultiplesHom _ x, by simpa using hx⟩

private theorem evenSublatticeZModTwoHom_one (x : L.evenSublattice.DiscriminantGroup)
    (hx : (2 : ℤ) • x = 0) : L.evenSublatticeZModTwoHom x hx 1 = x := by
  rw [evenSublatticeZModTwoHom, ← Int.cast_one, ZMod.lift_coe]
  exact one_zsmul x

/-- **In even rank, `A_(L_even) ≃+ ℤ/2 × ℤ/2`** for an odd unimodular lattice, with generators
`[e]` (for any odd-norm `e ∈ L`) and `[w / 2]`. -/
noncomputable def zmodTwoProdAddEquivEvenSublatticeDiscriminantGroup (hLu : L.IsUnimodular)
    (heven : Even (Module.finrank ℤ L)) {w : L} (hw : L.IsCharacteristicVector w)
    {e : L} (he : Odd (L.integralNorm e)) :
    ZMod 2 × ZMod 2 ≃+ L.evenSublattice.DiscriminantGroup := by
  have hLo : ¬ L.IsEven := fun hLe ↦ Int.not_odd_iff_even.mpr
    ((L.even_integralNorm_iff e).mpr (L.isEven_iff_forall_norm.mp hLe e)) he
  have hw2 : (2 : ℤ) • L.halfCharacteristicClass hw = 0 := by
    rw [two_zsmul, ← two_nsmul]
    exact (L.two_nsmul_halfCharacteristicClass_eq_zero_iff hLu hw).mpr heven
  refine AddEquiv.ofBijective
    ((L.evenSublatticeZModTwoHom _ (L.two_zsmul_oddVectorClass e)).coprod
      (L.evenSublatticeZModTwoHom _ hw2)) ?_
  rw [Nat.bijective_iff_surjective_and_card]
  refine ⟨fun g ↦ ?_, by simp [L.natCard_evenSublattice_discriminantGroup hLu hLo]⟩
  rcases L.evenSublatticeDiscriminantGroup_eq_four_classes hLu hw he g with rfl | rfl | rfl | rfl
  · exact ⟨(0, 0), by simp⟩
  · exact ⟨(1, 0), by simp [evenSublatticeZModTwoHom_one]⟩
  · exact ⟨(0, 1), by simp [evenSublatticeZModTwoHom_one]⟩
  · exact ⟨(1, 1), by simp [evenSublatticeZModTwoHom_one]⟩

/-- `zmodTwoProdAddEquivEvenSublatticeDiscriminantGroup` sends `(1, 0)` to `[e]`. -/
@[simp]
theorem zmodTwoProdAddEquivEvenSublatticeDiscriminantGroup_apply_one_zero (hLu : L.IsUnimodular)
    (heven : Even (Module.finrank ℤ L)) {w : L} (hw : L.IsCharacteristicVector w)
    {e : L} (he : Odd (L.integralNorm e)) :
    L.zmodTwoProdAddEquivEvenSublatticeDiscriminantGroup hLu heven hw he (1, 0) =
      L.oddVectorClass e := by
  simp [zmodTwoProdAddEquivEvenSublatticeDiscriminantGroup, evenSublatticeZModTwoHom_one]

/-- `zmodTwoProdAddEquivEvenSublatticeDiscriminantGroup` sends `(0, 1)` to `[w / 2]`. -/
@[simp]
theorem zmodTwoProdAddEquivEvenSublatticeDiscriminantGroup_apply_zero_one (hLu : L.IsUnimodular)
    (heven : Even (Module.finrank ℤ L)) {w : L} (hw : L.IsCharacteristicVector w)
    {e : L} (he : Odd (L.integralNorm e)) :
    L.zmodTwoProdAddEquivEvenSublatticeDiscriminantGroup hLu heven hw he (0, 1) =
      L.halfCharacteristicClass hw := by
  simp [zmodTwoProdAddEquivEvenSublatticeDiscriminantGroup, evenSublatticeZModTwoHom_one]

/-! ## The three order-two overlattices and Kneser two-neighbors -/

/-- The cyclic subgroup of `A_(L_even)` generated by `[w / 2]`. -/
noncomputable def halfCharacteristicSubgroup {w : L} (hw : L.IsCharacteristicVector w) :
    AddSubgroup L.evenSublattice.DiscriminantGroup :=
  AddSubgroup.zmultiples (L.halfCharacteristicClass hw)

/-- The cyclic subgroup of `A_(L_even)` generated by `[e] + [w / 2]`. -/
noncomputable def shiftedHalfCharacteristicSubgroup {w : L} (hw : L.IsCharacteristicVector w)
    (e : L) : AddSubgroup L.evenSublattice.DiscriminantGroup :=
  AddSubgroup.zmultiples (L.oddVectorClass e + L.halfCharacteristicClass hw)

/-- The subgroup of `A_(L_even)` attached to `L` itself is generated by any odd-norm vector. -/
theorem discriminantSubgroup_toIntermediateCarrier_eq_zmultiples_oddVectorClass
    {e : L} (he : Odd (L.integralNorm e)) :
    L.evenSublattice.discriminantSubgroup
        (L.toIntermediateCarrier L.evenSublattice_form.symm L.evenSublattice_carrier_le) =
      AddSubgroup.zmultiples (L.oddVectorClass e) := by
  ext x
  rw [AddSubgroup.mem_zmultiples_iff_of_two_nsmul_eq_zero (L.two_nsmul_oddVectorClass e)]
  induction x using Submodule.Quotient.induction_on with
  | _ y =>
    rw [L.evenSublattice.mk_mem_discriminantSubgroup_iff, coe_toIntermediateCarrier,
      L.evenSublattice.discriminantGroup_mk_eq_zero_iff, oddVectorClass_def,
      L.evenSublattice.discriminantGroup_mk_eq_iff]
    refine ⟨fun hy ↦ ?_, ?_⟩
    · rcases Int.even_or_odd (L.integralNorm ⟨y, hy⟩) with hy2 | hy2
      · exact Or.inl ((L.mem_evenSublattice_carrier_iff ⟨y, hy⟩).mpr hy2)
      · right
        have hsub : ((y - L.oddVectorDual e : L.evenSublattice.dualCarrier) : V) =
            ((⟨y, hy⟩ - e : L) : V) := rfl
        rw [hsub, L.mem_evenSublattice_carrier_iff, L.integralNorm_sub]
        exact (hy2.add_odd he).sub (even_two_mul _)
    · rintro (hy0 | hye)
      · exact L.evenSublattice_carrier_le hy0
      · simpa only [Submodule.coe_sub, coe_oddVectorDual, sub_add_cancel] using
          L.carrier.add_mem (L.evenSublattice_carrier_le hye) e.2

/-- In even rank, `[w / 2]` is nonzero for an odd lattice, hence has order two. -/
theorem halfCharacteristicClass_ne_zero_of_not_isEven {w : L} (hw : L.IsCharacteristicVector w)
    (hL : ¬ L.IsEven) : L.halfCharacteristicClass hw ≠ 0 := by
  rw [halfCharacteristicClass_def, Ne, L.evenSublattice.discriminantGroup_mk_eq_zero_iff,
    coe_halfCharacteristicDual]
  exact fun hm ↦ L.half_characteristic_notMem_carrier_of_not_isEven hw hL
    (L.evenSublattice_carrier_le hm)

/-- For an odd lattice, `[e] + [w / 2]` is nonzero for every `e ∈ L`. -/
theorem oddVectorClass_add_halfCharacteristicClass_ne_zero_of_not_isEven {w : L}
    (hw : L.IsCharacteristicVector w) (hL : ¬ L.IsEven) (e : L) :
    L.oddVectorClass e + L.halfCharacteristicClass hw ≠ 0 := by
  rw [oddVectorClass_def, halfCharacteristicClass_def, ← Submodule.Quotient.mk_add, Ne,
    L.evenSublattice.discriminantGroup_mk_eq_zero_iff]
  intro hm
  have hmem : (1 / 2 : ℚ) • (w : V) ∈ L.carrier := by
    have heq : (1 / 2 : ℚ) • (w : V) =
        ((L.oddVectorDual e + L.halfCharacteristicDual hw : L.evenSublattice.dualCarrier) : V) -
          (e : V) := by
      simp [add_sub_cancel_left]
    rw [heq]
    exact L.carrier.sub_mem (L.evenSublattice_carrier_le hm) e.2
  exact L.half_characteristic_notMem_carrier_of_not_isEven hw hL hmem

/-- In even rank, `halfCharacteristicSubgroup` has order two when `L` is odd and unimodular. -/
theorem natCard_halfCharacteristicSubgroup (hLu : L.IsUnimodular)
    (heven : Even (Module.finrank ℤ L)) {w : L} (hw : L.IsCharacteristicVector w)
    (hL : ¬ L.IsEven) :
    Nat.card (L.halfCharacteristicSubgroup hw) = 2 := by
  rw [halfCharacteristicSubgroup, Nat.card_zmultiples]
  exact addOrderOf_eq_prime
    ((L.two_nsmul_halfCharacteristicClass_eq_zero_iff hLu hw).mpr heven)
    (L.halfCharacteristicClass_ne_zero_of_not_isEven hw hL)

/-- In even rank, `shiftedHalfCharacteristicSubgroup` has order two when `L` is odd and
unimodular. -/
theorem natCard_shiftedHalfCharacteristicSubgroup (hLu : L.IsUnimodular)
    (heven : Even (Module.finrank ℤ L)) {w : L} (hw : L.IsCharacteristicVector w)
    (hL : ¬ L.IsEven) (e : L) :
    Nat.card (L.shiftedHalfCharacteristicSubgroup hw e) = 2 := by
  rw [shiftedHalfCharacteristicSubgroup, Nat.card_zmultiples]
  refine addOrderOf_eq_prime ?_
    (L.oddVectorClass_add_halfCharacteristicClass_ne_zero_of_not_isEven hw hL e)
  rw [nsmul_add, L.two_nsmul_oddVectorClass e, zero_add]
  exact (L.two_nsmul_halfCharacteristicClass_eq_zero_iff hLu hw).mpr heven

/-- The self-pairing of `[w / 2]` in `A_(L_even)` vanishes precisely when `4 ∣ L.integralNorm w`. -/
theorem discriminantPairing_halfCharacteristicClass_self_eq_zero_iff {w : L}
    (hw : L.IsCharacteristicVector w) :
    L.evenSublattice.discriminantPairing (L.halfCharacteristicClass hw)
        (L.halfCharacteristicClass hw) = 0 ↔ 4 ∣ L.integralNorm w := by
  rw [halfCharacteristicClass_def, L.evenSublattice.discriminantPairing_mk_eq_zero_iff,
    Submodule.mem_one, L.evenSublattice_form, coe_halfCharacteristicDual]
  simp only [map_smul, LinearMap.smul_apply, smul_eq_mul, ← L.integralForm_cast w w,
    ← L.integralNorm_apply, algebraMap_int_eq, eq_intCast]
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, Int.cast_injective (α := ℚ) ?_⟩
    push_cast
    linarith
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    rw [hk]
    push_cast
    ring

/-- The carrier glued along `⟨[w / 2]⟩` is integral precisely when `4 ∣ L.integralNorm w`. -/
theorem isIntegral_intermediateCarrier_halfCharacteristicSubgroup_iff {w : L}
    (hw : L.IsCharacteristicVector w) :
    IntermediateCarrier.IsIntegral
        (L.evenSublattice.intermediateCarrierOfDiscriminantSubgroup
          (L.halfCharacteristicSubgroup hw)) ↔
      4 ∣ L.integralNorm w := by
  rw [IntermediateCarrier.isIntegral_iff_forall_discriminantPairing_eq_zero,
    L.evenSublattice.discriminantSubgroup_intermediateCarrierOfDiscriminantSubgroup,
    halfCharacteristicSubgroup]
  refine ⟨fun h ↦ (L.discriminantPairing_halfCharacteristicClass_self_eq_zero_iff hw).mp
    (h _ (AddSubgroup.mem_zmultiples _) _ (AddSubgroup.mem_zmultiples _)), fun h4 a ha b hb ↦ ?_⟩
  obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp ha
  obtain ⟨n, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hb
  simp only [map_zsmul, LinearMap.smul_apply,
    (L.discriminantPairing_halfCharacteristicClass_self_eq_zero_iff hw).mpr h4, zsmul_zero]

/-- The carrier glued along `⟨[e] + [w / 2]⟩` is integral precisely when `4 ∣ L.integralNorm w`. -/
theorem isIntegral_intermediateCarrier_shiftedHalfCharacteristicSubgroup_iff {w : L}
    (hw : L.IsCharacteristicVector w) (e : L) :
    IntermediateCarrier.IsIntegral
        (L.evenSublattice.intermediateCarrierOfDiscriminantSubgroup
          (L.shiftedHalfCharacteristicSubgroup hw e)) ↔
      4 ∣ L.integralNorm w := by
  have hself : L.evenSublattice.discriminantPairing
      (L.oddVectorClass e + L.halfCharacteristicClass hw)
      (L.oddVectorClass e + L.halfCharacteristicClass hw) =
      L.evenSublattice.discriminantPairing (L.halfCharacteristicClass hw)
        (L.halfCharacteristicClass hw) := by
    rw [oddVectorClass_def, halfCharacteristicClass_def, ← Submodule.Quotient.mk_add,
      discriminantPairing_mk, discriminantPairing_mk, L.evenSublattice_form]
    simp only [Submodule.coe_add, coe_oddVectorDual, coe_halfCharacteristicDual]
    have hwe : L.form ((1 / 2 : ℚ) • (w : V)) (e : V) = (1 / 2 : ℚ) * L.integralForm w e := by
      rw [map_smul, LinearMap.smul_apply, smul_eq_mul, ← L.integralForm_cast w e]
    have hee : L.form (e : V) (e : V) = L.integralNorm e := by
      rw [← L.integralForm_cast e e, L.integralNorm_apply]
    have hpol : L.form ((e : V) + (1 / 2 : ℚ) • (w : V)) ((e : V) + (1 / 2 : ℚ) • (w : V)) =
        L.form ((1 / 2 : ℚ) • (w : V)) ((1 / 2 : ℚ) • (w : V)) +
          ((L.integralNorm e + L.integralForm w e : ℤ) : ℚ) := by
      simp only [map_add, LinearMap.add_apply,
        L.isSymm.eq (e : V) ((1 / 2 : ℚ) • (w : V)), hwe, hee]
      push_cast
      ring
    rw [hpol, AddCircle.coe_add_intCast]
  rw [IntermediateCarrier.isIntegral_iff_forall_discriminantPairing_eq_zero,
    L.evenSublattice.discriminantSubgroup_intermediateCarrierOfDiscriminantSubgroup,
    shiftedHalfCharacteristicSubgroup]
  refine ⟨fun h ↦ (L.discriminantPairing_halfCharacteristicClass_self_eq_zero_iff hw).mp
    (hself ▸ h _ (AddSubgroup.mem_zmultiples _) _ (AddSubgroup.mem_zmultiples _)),
    fun h4 a ha b hb ↦ ?_⟩
  obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp ha
  obtain ⟨n, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hb
  simp only [map_zsmul, LinearMap.smul_apply, hself,
    (L.discriminantPairing_halfCharacteristicClass_self_eq_zero_iff hw).mpr h4, zsmul_zero]

/-- `[w / 2]` is quadratic-isotropic in `A_(L_even)` precisely when `8 ∣ L.integralNorm w`. -/
theorem discriminantQuadraticMap_halfCharacteristicClass_eq_zero_iff {w : L}
    (hw : L.IsCharacteristicVector w) :
    L.evenSublattice.discriminantQuadraticMap L.isEven_evenSublattice
        (L.halfCharacteristicClass hw) = 0 ↔ 8 ∣ L.integralNorm w := by
  rw [L.discriminantQuadraticMap_halfCharacteristicClass hw, ZMod.toRatAddCircle_eq_zero 8,
    ZMod.intCast_zmod_eq_zero_iff_dvd]
  rfl

/-- `⟨[w / 2]⟩` is quadratic-isotropic precisely when `8 ∣ L.integralNorm w`. -/
@[simp]
theorem isIsotropic_halfCharacteristicSubgroup_iff [L.IsNondegenerate] {w : L}
    (hw : L.IsCharacteristicVector w) :
    (L.evenSublattice.discriminantQuadraticModule L.isEven_evenSublattice).IsIsotropic
        (L.halfCharacteristicSubgroup hw) ↔
      8 ∣ L.integralNorm w := by
  rw [← L.evenSublattice.isEven_intermediateCarrierOfDiscriminantSubgroup_iff
    L.isEven_evenSublattice,
    IntermediateCarrier.isEven_iff_forall_discriminantQuadraticMap_eq_zero L.isEven_evenSublattice,
    L.evenSublattice.discriminantSubgroup_intermediateCarrierOfDiscriminantSubgroup,
    halfCharacteristicSubgroup]
  refine ⟨fun h ↦ (L.discriminantQuadraticMap_halfCharacteristicClass_eq_zero_iff hw).mp
    (h _ (AddSubgroup.mem_zmultiples _)), fun h8 a ha ↦ ?_⟩
  obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp ha
  rw [QuadraticMap.map_smul,
    (L.discriminantQuadraticMap_halfCharacteristicClass_eq_zero_iff hw).mpr h8, smul_zero]

/-- `⟨[e] + [w / 2]⟩` is quadratic-isotropic precisely when `8 ∣ L.integralNorm w`. -/
@[simp]
theorem isIsotropic_shiftedHalfCharacteristicSubgroup_iff [L.IsNondegenerate] {w : L}
    (hw : L.IsCharacteristicVector w) (e : L) :
    (L.evenSublattice.discriminantQuadraticModule L.isEven_evenSublattice).IsIsotropic
        (L.shiftedHalfCharacteristicSubgroup hw e) ↔
      8 ∣ L.integralNorm w := by
  rw [← L.evenSublattice.isEven_intermediateCarrierOfDiscriminantSubgroup_iff
    L.isEven_evenSublattice,
    IntermediateCarrier.isEven_iff_forall_discriminantQuadraticMap_eq_zero L.isEven_evenSublattice,
    L.evenSublattice.discriminantSubgroup_intermediateCarrierOfDiscriminantSubgroup,
    shiftedHalfCharacteristicSubgroup]
  refine ⟨fun h ↦ ?_, fun h8 a ha ↦ ?_⟩
  · have h0 := h _ (AddSubgroup.mem_zmultiples _)
    rwa [L.discriminantQuadraticMap_oddVectorClass_add_halfCharacteristicClass hw e,
      ZMod.toRatAddCircle_eq_zero 8, ZMod.intCast_zmod_eq_zero_iff_dvd] at h0
  · obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp ha
    rw [QuadraticMap.map_smul,
      L.discriminantQuadraticMap_oddVectorClass_add_halfCharacteristicClass hw e,
      (ZMod.toRatAddCircle_eq_zero 8).mpr ((ZMod.intCast_zmod_eq_zero_iff_dvd _ 8).mpr h8),
      smul_zero]

/-- **The first even unimodular two-neighbor of an odd unimodular lattice with `8 ∣ w²`**, obtained
by adjoining `(1 / 2) • w` to `L.evenSublattice`. -/
noncomputable def halfCharacteristicOverlattice (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) : IntegralLattice V :=
  letI : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  L.evenSublattice.ofIsotropicSubgroup L.isEven_evenSublattice (L.halfCharacteristicSubgroup hw)
    ((L.isIsotropic_halfCharacteristicSubgroup_iff hw).mpr h8)

/-- **The second even unimodular two-neighbor of an odd unimodular lattice with `8 ∣ w²`**, obtained
by adjoining `e + (1 / 2) • w` to `L.evenSublattice` for an odd-norm vector `e ∈ L`. -/
noncomputable def shiftedHalfCharacteristicOverlattice (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) (e : L) : IntegralLattice V :=
  letI : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  L.evenSublattice.ofIsotropicSubgroup L.isEven_evenSublattice
    (L.shiftedHalfCharacteristicSubgroup hw e)
    ((L.isIsotropic_shiftedHalfCharacteristicSubgroup_iff hw e).mpr h8)

/-- `halfCharacteristicOverlattice` shares the ambient rational bilinear form of `L`. -/
@[simp]
theorem halfCharacteristicOverlattice_form (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) :
    (L.halfCharacteristicOverlattice hLu hw h8).form = L.form := by
  have : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  rw [halfCharacteristicOverlattice, ofIsotropicSubgroup_form, evenSublattice_form]

/-- `shiftedHalfCharacteristicOverlattice` shares the ambient rational bilinear form of `L`. -/
@[simp]
theorem shiftedHalfCharacteristicOverlattice_form (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) (e : L) :
    (L.shiftedHalfCharacteristicOverlattice hLu hw h8 e).form = L.form := by
  have : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  rw [shiftedHalfCharacteristicOverlattice, ofIsotropicSubgroup_form, evenSublattice_form]

/-- `halfCharacteristicOverlattice` has the same signature as `L`. -/
@[simp]
theorem halfCharacteristicOverlattice_signature (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) :
    (L.halfCharacteristicOverlattice hLu hw h8).signature = L.signature :=
  signature_eq_of_form_eq (L.halfCharacteristicOverlattice_form hLu hw h8)

/-- `shiftedHalfCharacteristicOverlattice` has the same signature as `L`. -/
@[simp]
theorem shiftedHalfCharacteristicOverlattice_signature (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) (e : L) :
    (L.shiftedHalfCharacteristicOverlattice hLu hw h8 e).signature = L.signature :=
  signature_eq_of_form_eq (L.shiftedHalfCharacteristicOverlattice_form hLu hw h8 e)

/-- `halfCharacteristicOverlattice` is an even integral lattice. -/
theorem isEven_halfCharacteristicOverlattice (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) :
    (L.halfCharacteristicOverlattice hLu hw h8).IsEven := by
  have : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  exact L.evenSublattice.isEven_ofIsotropicSubgroup _ _ _

/-- `shiftedHalfCharacteristicOverlattice` is an even integral lattice. -/
theorem isEven_shiftedHalfCharacteristicOverlattice (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) (e : L) :
    (L.shiftedHalfCharacteristicOverlattice hLu hw h8 e).IsEven := by
  have : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  exact L.evenSublattice.isEven_ofIsotropicSubgroup _ _ _

private theorem even_finrank_of_eight_dvd_characteristicNorm (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) :
    Even (Module.finrank ℤ L) := by
  have hw2 : Even (L.integralNorm w) := even_iff_two_dvd.mpr (dvd_trans (by decide) h8)
  rwa [← L.two_nsmul_halfCharacteristicClass_eq_zero_iff hLu hw,
    L.two_nsmul_halfCharacteristicClass_eq_zero_iff_even_integralNorm hw]

private theorem natCard_sq_eq_of_isEven (hLu : L.IsUnimodular) (hLe : L.IsEven)
    (H : AddSubgroup L.evenSublattice.DiscriminantGroup) :
    Nat.card H ^ 2 = Nat.card L.evenSublattice.DiscriminantGroup := by
  have : Subsingleton L.evenSublattice.DiscriminantGroup :=
    L.evenSublattice.isUnimodular_iff_subsingleton_discriminantGroup.mp
      ((L.evenSublattice_eq_self_iff.mpr hLe).symm ▸ hLu)
  simp [Nat.card_unique]

/-- `halfCharacteristicOverlattice` is unimodular for every unimodular lattice `L` with
`8 ∣ L.integralNorm w`. -/
theorem isUnimodular_halfCharacteristicOverlattice (hLu : L.IsUnimodular)
    {w : L} (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) :
    (L.halfCharacteristicOverlattice hLu hw h8).IsUnimodular := by
  have : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  have hcard : Nat.card (L.halfCharacteristicSubgroup hw) ^ 2 =
      Nat.card L.evenSublattice.DiscriminantGroup := by
    by_cases hL : L.IsEven
    · exact L.natCard_sq_eq_of_isEven hLu hL _
    · rw [L.natCard_halfCharacteristicSubgroup hLu
        (L.even_finrank_of_eight_dvd_characteristicNorm hLu hw h8) hw hL,
        L.natCard_evenSublattice_discriminantGroup hLu hL]
      norm_num
  rw [halfCharacteristicOverlattice,
    L.evenSublattice.isUnimodular_ofIsotropicSubgroup_iff_isLagrangian]
  exact ((FiniteQuadraticModule.isLagrangian_def _ _).mp
    (FiniteQuadraticModule.IsIsotropic.isLagrangian_of_card_sq_eq _
      ((L.isIsotropic_halfCharacteristicSubgroup_iff hw).mpr h8)
      (L.evenSublattice.isNondegenerate_discriminantQuadraticModule L.isEven_evenSublattice)
      hcard)).2

/-- `shiftedHalfCharacteristicOverlattice` is unimodular for every unimodular lattice `L` with
`8 ∣ L.integralNorm w`. -/
theorem isUnimodular_shiftedHalfCharacteristicOverlattice (hLu : L.IsUnimodular)
    {w : L} (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) (e : L) :
    (L.shiftedHalfCharacteristicOverlattice hLu hw h8 e).IsUnimodular := by
  have : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  have hcard : Nat.card (L.shiftedHalfCharacteristicSubgroup hw e) ^ 2 =
      Nat.card L.evenSublattice.DiscriminantGroup := by
    by_cases hL : L.IsEven
    · exact L.natCard_sq_eq_of_isEven hLu hL _
    · rw [L.natCard_shiftedHalfCharacteristicSubgroup hLu
        (L.even_finrank_of_eight_dvd_characteristicNorm hLu hw h8) hw hL e,
        L.natCard_evenSublattice_discriminantGroup hLu hL]
      norm_num
  rw [shiftedHalfCharacteristicOverlattice,
    L.evenSublattice.isUnimodular_ofIsotropicSubgroup_iff_isLagrangian]
  exact ((FiniteQuadraticModule.isLagrangian_def _ _).mp
    (FiniteQuadraticModule.IsIsotropic.isLagrangian_of_card_sq_eq _
      ((L.isIsotropic_shiftedHalfCharacteristicSubgroup_iff hw e).mpr h8)
      (L.evenSublattice.isNondegenerate_discriminantQuadraticModule L.isEven_evenSublattice)
      hcard)).2

/-- Explicit coset membership in `halfCharacteristicOverlattice`: its carrier is
`L.evenSublattice ∪ ((1 / 2) • w + L.evenSublattice)`. -/
theorem mem_halfCharacteristicOverlattice_carrier_iff (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) (x : V) :
    x ∈ (L.halfCharacteristicOverlattice hLu hw h8).carrier ↔
      x ∈ L.evenSublattice.carrier ∨ x - (1 / 2 : ℚ) • (w : V) ∈ L.evenSublattice.carrier := by
  have : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  have heven := L.even_finrank_of_eight_dvd_characteristicNorm hLu hw h8
  rw [halfCharacteristicOverlattice, L.evenSublattice.ofIsotropicSubgroup_carrier,
    halfCharacteristicSubgroup, halfCharacteristicClass_def]
  exact L.evenSublattice.mem_intermediateCarrierOfDiscriminantSubgroup_zmultiples_iff
    (L.half_characteristic_mem_evenSublattice_dualCarrier hw)
    ((L.two_nsmul_halfCharacteristicClass_eq_zero_iff hLu hw).mpr heven) x

/-- Explicit coset membership in `shiftedHalfCharacteristicOverlattice`: its carrier is
`L.evenSublattice ∪ (e + (1 / 2) • w + L.evenSublattice)`. -/
theorem mem_shiftedHalfCharacteristicOverlattice_carrier_iff (hLu : L.IsUnimodular) {w : L}
    (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) (e : L) (x : V) :
    x ∈ (L.shiftedHalfCharacteristicOverlattice hLu hw h8 e).carrier ↔
      x ∈ L.evenSublattice.carrier ∨
        x - ((e : V) + (1 / 2 : ℚ) • (w : V)) ∈ L.evenSublattice.carrier := by
  have : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  have heven := L.even_finrank_of_eight_dvd_characteristicNorm hLu hw h8
  have hmem := L.evenSublattice.dualCarrier.add_mem (L.coe_mem_evenSublattice_dualCarrier e)
    (L.half_characteristic_mem_evenSublattice_dualCarrier hw)
  have hmk : (Submodule.Quotient.mk ⟨(e : V) + (1 / 2 : ℚ) • (w : V), hmem⟩ :
      L.evenSublattice.DiscriminantGroup) =
      L.oddVectorClass e + L.halfCharacteristicClass hw := by
    rw [oddVectorClass_def, halfCharacteristicClass_def, ← Submodule.Quotient.mk_add]
    rfl
  have h2 : 2 • (Submodule.Quotient.mk ⟨(e : V) + (1 / 2 : ℚ) • (w : V), hmem⟩ :
      L.evenSublattice.DiscriminantGroup) = 0 := by
    rw [hmk, nsmul_add, L.two_nsmul_oddVectorClass e, zero_add]
    exact (L.two_nsmul_halfCharacteristicClass_eq_zero_iff hLu hw).mpr heven
  rw [shiftedHalfCharacteristicOverlattice, L.evenSublattice.ofIsotropicSubgroup_carrier,
    shiftedHalfCharacteristicSubgroup, ← hmk]
  exact L.evenSublattice.mem_intermediateCarrierOfDiscriminantSubgroup_zmultiples_iff hmem h2 x

/-- `halfCharacteristicOverlattice` is a Kneser two-neighbor of `L`. -/
theorem isNeighbor_halfCharacteristicOverlattice (hLu : L.IsUnimodular) (hL : ¬ L.IsEven)
    {w : L} (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) :
    L.IsNeighbor (L.halfCharacteristicOverlattice hLu hw h8) 2 := by
  have : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  have heven := L.even_finrank_of_eight_dvd_characteristicNorm hLu hw h8
  have hinf : L.carrier ⊓ (L.halfCharacteristicOverlattice hLu hw h8).carrier =
      L.evenSublattice.carrier := by
    refine le_antisymm (fun x ⟨hxL, hxM⟩ ↦ ?_)
      (le_inf L.evenSublattice_carrier_le fun x hx ↦
        (L.mem_halfCharacteristicOverlattice_carrier_iff hLu hw h8 x).mpr (Or.inl hx))
    rcases (L.mem_halfCharacteristicOverlattice_carrier_iff hLu hw h8 x).mp hxM with hx0 | hx1
    · exact hx0
    · exfalso
      apply L.half_characteristic_notMem_carrier_of_not_isEven hw hL
      simpa only [sub_sub_cancel] using L.carrier.sub_mem hxL (L.evenSublattice_carrier_le hx1)
  refine ⟨L.evenSublattice_form.symm.trans (L.evenSublattice.ofIsotropicSubgroup_form _ _ _).symm,
    by rw [hinf]; exact L.relIndex_evenSublattice_of_not_isEven hL, ?_⟩
  rw [hinf, halfCharacteristicOverlattice, L.evenSublattice.ofIsotropicSubgroup_carrier,
    ← IntermediateCarrier.index_def,
    IntermediateCarrier.index_intermediateCarrierOfDiscriminantSubgroup]
  exact L.natCard_halfCharacteristicSubgroup hLu heven hw hL

/-- `shiftedHalfCharacteristicOverlattice` is a Kneser two-neighbor of `L`. -/
theorem isNeighbor_shiftedHalfCharacteristicOverlattice (hLu : L.IsUnimodular) (hL : ¬ L.IsEven)
    {w : L} (hw : L.IsCharacteristicVector w) (h8 : 8 ∣ L.integralNorm w) (e : L) :
    L.IsNeighbor (L.shiftedHalfCharacteristicOverlattice hLu hw h8 e) 2 := by
  have : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  have heven := L.even_finrank_of_eight_dvd_characteristicNorm hLu hw h8
  have hinf : L.carrier ⊓ (L.shiftedHalfCharacteristicOverlattice hLu hw h8 e).carrier =
      L.evenSublattice.carrier := by
    refine le_antisymm (fun x ⟨hxL, hxM⟩ ↦ ?_)
      (le_inf L.evenSublattice_carrier_le fun x hx ↦
        (L.mem_shiftedHalfCharacteristicOverlattice_carrier_iff hLu hw h8 e x).mpr (Or.inl hx))
    rcases (L.mem_shiftedHalfCharacteristicOverlattice_carrier_iff hLu hw h8 e x).mp hxM with
      hx0 | hx1
    · exact hx0
    · exfalso
      apply L.half_characteristic_notMem_carrier_of_not_isEven hw hL
      have hsub := L.carrier.sub_mem hxL (L.evenSublattice_carrier_le hx1)
      have heq : (1 / 2 : ℚ) • (w : V) =
          (x - (x - ((e : V) + (1 / 2 : ℚ) • (w : V)))) - (e : V) := by
        abel
      rw [heq]
      exact L.carrier.sub_mem hsub e.2
  refine ⟨L.evenSublattice_form.symm.trans (L.evenSublattice.ofIsotropicSubgroup_form _ _ _).symm,
    by rw [hinf]; exact L.relIndex_evenSublattice_of_not_isEven hL, ?_⟩
  rw [hinf, shiftedHalfCharacteristicOverlattice, L.evenSublattice.ofIsotropicSubgroup_carrier,
    ← IntermediateCarrier.index_def,
    IntermediateCarrier.index_intermediateCarrierOfDiscriminantSubgroup]
  exact L.natCard_shiftedHalfCharacteristicSubgroup hLu heven hw hL e

/-- **Every even Kneser two-neighbor of an odd lattice meets it in the even sublattice.** -/
theorem carrier_inf_eq_evenSublattice_carrier_of_isNeighbor {M : IntegralLattice V}
    (hL : ¬ L.IsEven) (hM : L.IsNeighbor M 2) (hMe : M.IsEven) :
    L.carrier ⊓ M.carrier = L.evenSublattice.carrier := by
  have hle : L.carrier ⊓ M.carrier ≤ L.evenSublattice.carrier := fun x ⟨hxL, hxM⟩ ↦ by
    rw [L.mem_evenSublattice_carrier_iff ⟨x, hxL⟩, L.even_integralNorm_iff]
    simpa only [norm_apply, hM.form_eq] using M.isEven_iff_forall_norm.mp hMe ⟨x, hxM⟩
  have hmul := AddSubgroup.relIndex_mul_relIndex
    (L.carrier ⊓ M.carrier).toAddSubgroup L.evenSublattice.carrier.toAddSubgroup
    L.carrier.toAddSubgroup ((Submodule.toAddSubgroup_le _ _).mpr hle)
    ((Submodule.toAddSubgroup_le _ _).mpr L.evenSublattice_carrier_le)
  rw [hM.relIndex_inf_left, L.relIndex_evenSublattice_of_not_isEven hL] at hmul
  have h1 : (L.carrier ⊓ M.carrier).toAddSubgroup.relIndex
      L.evenSublattice.carrier.toAddSubgroup = 1 := by omega
  exact le_antisymm hle ((Submodule.toAddSubgroup_le _ _).mp (AddSubgroup.relIndex_eq_one.mp h1))

private theorem exists_zmultiples_eq_of_natCard_eq_two
    {H : AddSubgroup L.evenSublattice.DiscriminantGroup} (hcardH : Nat.card H = 2) :
    ∃ g : L.evenSublattice.DiscriminantGroup, g ≠ 0 ∧ AddSubgroup.zmultiples g = H := by
  have : Finite H := Nat.finite_of_card_ne_zero (by omega)
  have : Nontrivial H := Finite.one_lt_card_iff_nontrivial.mp (by omega)
  obtain ⟨⟨g, hgH⟩, hg0⟩ := exists_ne (0 : H)
  have hg_ne : g ≠ 0 := fun h ↦ hg0 (Subtype.ext h)
  have hg2 : 2 • g = 0 := by
    have hcard_smul : Nat.card H • (⟨g, hgH⟩ : H) = 0 :=
      addOrderOf_dvd_iff_nsmul_eq_zero.mp (addOrderOf_dvd_natCard (⟨g, hgH⟩ : H))
    rw [hcardH] at hcard_smul
    exact congrArg Subtype.val hcard_smul
  have hcz : Nat.card (AddSubgroup.zmultiples g) = 2 := by
    rw [Nat.card_zmultiples]
    exact addOrderOf_eq_prime hg2 hg_ne
  exact ⟨g, hg_ne, AddSubgroup.eq_of_le_of_card_ge (AddSubgroup.zmultiples_le.mpr hgH) (by omega)⟩

/-- **Classification of even Kneser two-neighbors of an odd unimodular lattice.** If `M` is an
even Kneser two-neighbor of a unimodular lattice `L` containing an odd-norm vector `e`, then
`8 ∣ L.integralNorm w` for every characteristic vector `w` of `L`, and `M` equals either
`halfCharacteristicOverlattice` or `shiftedHalfCharacteristicOverlattice`. -/
theorem eq_halfCharacteristicOverlattice_or_shifted_of_isNeighbor {M : IntegralLattice V}
    (hLu : L.IsUnimodular) (hM : L.IsNeighbor M 2) (hMe : M.IsEven)
    {w : L} (hw : L.IsCharacteristicVector w) {e : L} (he : Odd (L.integralNorm e)) :
    ∃ h8 : 8 ∣ L.integralNorm w,
      M = L.halfCharacteristicOverlattice hLu hw h8 ∨
        M = L.shiftedHalfCharacteristicOverlattice hLu hw h8 e := by
  have : L.IsNondegenerate := ⟨hLu.nondegenerate⟩
  have hL : ¬ L.IsEven := fun hLe ↦ Int.not_odd_iff_even.mpr
    ((L.even_integralNorm_iff e).mpr (L.isEven_iff_forall_norm.mp hLe e)) he
  have hinf := L.carrier_inf_eq_evenSublattice_carrier_of_isNeighbor hL hM hMe
  have hle : L.evenSublattice.carrier ≤ M.carrier := hinf ▸ inf_le_right
  have hform : M.form = L.evenSublattice.form := hM.form_eq.symm.trans L.evenSublattice_form.symm
  let P : L.evenSublattice.IntermediateCarrier := M.toIntermediateCarrier hform hle
  let H : AddSubgroup L.evenSublattice.DiscriminantGroup := L.evenSublattice.discriminantSubgroup P
  have hHiso : (L.evenSublattice.discriminantQuadraticModule L.isEven_evenSublattice).IsIsotropic
      H := (IntermediateCarrier.isEven_iff_isIsotropic_discriminantSubgroup
        L.isEven_evenSublattice P).mp (M.isEven_toIntermediateCarrier hform hle hMe)
  have hcardH : Nat.card H = 2 := by
    rw [← IntermediateCarrier.index_eq_natCard_discriminantSubgroup, IntermediateCarrier.index_def,
      M.coe_toIntermediateCarrier hform hle, ← hinf, hM.relIndex_inf_right]
  obtain ⟨g, hg_ne, hHz⟩ := L.exists_zmultiples_eq_of_natCard_eq_two hcardH
  have hM_eq : L.evenSublattice.ofIsotropicSubgroup L.isEven_evenSublattice H hHiso = M := by
    refine IntegralLattice.ext ?_ ((L.evenSublattice.ofIsotropicSubgroup_form _ _ _).trans
      hform.symm)
    rw [L.evenSublattice.ofIsotropicSubgroup_carrier,
      L.evenSublattice.intermediateCarrierOfDiscriminantSubgroup_discriminantSubgroup P]
    exact M.coe_toIntermediateCarrier hform hle
  rcases L.evenSublatticeDiscriminantGroup_eq_four_classes hLu hw he g with
    rfl | rfl | rfl | rfl
  · exact (hg_ne rfl).elim
  · exfalso
    have hHL : L.evenSublattice.discriminantSubgroup P = L.evenSublattice.discriminantSubgroup
        (L.toIntermediateCarrier L.evenSublattice_form.symm L.evenSublattice_carrier_le) :=
      hHz.symm.trans
        (L.discriminantSubgroup_toIntermediateCarrier_eq_zmultiples_oddVectorClass he).symm
    rw [← L.evenSublattice.intermediateCarrierOrderIsoDiscriminantSubgroup_apply,
      ← L.evenSublattice.intermediateCarrierOrderIsoDiscriminantSubgroup_apply] at hHL
    have hPL := congrArg Subtype.val
      (L.evenSublattice.intermediateCarrierOrderIsoDiscriminantSubgroup.injective hHL)
    rw [M.coe_toIntermediateCarrier hform hle, L.coe_toIntermediateCarrier] at hPL
    have hML : M = L := IntegralLattice.ext hPL hM.form_eq.symm
    exact hL (hML ▸ hMe)
  · rw [← halfCharacteristicSubgroup] at hHz
    have h8 : 8 ∣ L.integralNorm w :=
      (L.isIsotropic_halfCharacteristicSubgroup_iff hw).mp (hHz ▸ hHiso)
    refine ⟨h8, Or.inl ?_⟩
    rw [← hM_eq, halfCharacteristicOverlattice, L.evenSublattice.ofIsotropicSubgroup_inj]
    exact hHz.symm
  · rw [← shiftedHalfCharacteristicSubgroup] at hHz
    have h8 : 8 ∣ L.integralNorm w :=
      (L.isIsotropic_shiftedHalfCharacteristicSubgroup_iff hw e).mp (hHz ▸ hHiso)
    refine ⟨h8, Or.inr ?_⟩
    rw [← hM_eq, shiftedHalfCharacteristicOverlattice, L.evenSublattice.ofIsotropicSubgroup_inj]
    exact hHz.symm

end TauCeti.IntegralLattice
