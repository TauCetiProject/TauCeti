module

public import TauCeti.LinearAlgebra.IntegralLattice.Even
public import TauCeti.LinearAlgebra.BilinearForm.Ideals

/-!
# Scale and norm ideals of an integral lattice

The scale ideal is generated by all integral pairings, and the norm ideal by all
self-pairings. Polarization gives `2 𝔰(L) ≤ 𝔫(L) ≤ 𝔰(L)`. In particular,
evenness says exactly that the norm ideal is contained in `2ℤ`.

The ideal constructions and their algebraic properties are stated for bilinear
forms over commutative rings, then specialized to integral lattices.

These ideals are the integral invariants used to distinguish the parity types of
local Jordan constituents.

## References

* O. T. O'Meara, *Introduction to Quadratic Forms*, §82E.
-/

public section

namespace TauCeti

universe u v

variable {V : Type u} [AddCommGroup V] [Module ℚ V]
variable {W : Type v} [AddCommGroup W] [Module ℚ W]

namespace IntegralLattice

/-- The scale ideal of the integral form of a lattice. -/
noncomputable abbrev scaleIdeal (L : IntegralLattice V) : Ideal ℤ :=
  L.integralForm.scaleIdeal

/-- The norm ideal of the integral form of a lattice. -/
noncomputable abbrev normIdeal (L : IntegralLattice V) : Ideal ℤ :=
  L.integralForm.normIdeal

/-- The norm ideal as a span of self-pairing values. -/
theorem normIdeal_def (L : IntegralLattice V) :
    L.normIdeal = Ideal.span (Set.range L.integralNorm) := by
  unfold normIdeal
  rw [LinearMap.BilinForm.normIdeal_def]
  simp_rw [← L.integralNorm_apply]

/-- Every integral norm lies in the norm ideal. -/
@[simp] theorem integralNorm_mem_normIdeal (L : IntegralLattice V) (x : L) :
    L.integralNorm x ∈ L.normIdeal := by
  rw [L.integralNorm_apply]
  exact L.integralForm.self_mem_normIdeal x

/-- The norm ideal is the smallest ideal containing all integral norms. -/
theorem normIdeal_le_iff (L : IntegralLattice V) (I : Ideal ℤ) :
    L.normIdeal ≤ I ↔ ∀ x : L, L.integralNorm x ∈ I := by
  simpa only [L.integralNorm_apply] using
    L.integralForm.normIdeal_le_iff I

/-- Twice each integral pairing belongs to the norm ideal. -/
theorem two_mul_integralForm_mem_normIdeal (L : IntegralLattice V) (x y : L) :
    2 * L.integralForm x y ∈ L.normIdeal :=
  L.integralForm.two_mul_apply_mem_normIdeal L.isSymm_integralForm x y

/-- A spanning set generates the norm ideal through its norms and twice its pairings. -/
theorem normIdeal_eq_span_of_span (L : IntegralLattice V) {s : Set L}
    (hs : Submodule.span ℤ s = ⊤) :
    L.normIdeal = Ideal.span
      (L.integralNorm '' s ∪ Set.image2 (fun x y ↦ 2 * L.integralForm x y) s s) := by
  have h : (⇑L.integralNorm) =
      (fun x : L ↦ L.integralForm x x) := funext L.integralNorm_apply
  rw [h]
  exact L.integralForm.normIdeal_eq_span_of_span L.isSymm_integralForm hs

/-- In a basis, the norm ideal is generated by diagonal Gram entries and twice every
Gram entry. Including all ordered pairs avoids a choice of order on the index. -/
theorem normIdeal_eq_span_basis {ι : Type*} (L : IntegralLattice V)
    (b : Module.Basis ι ℤ L) :
    L.normIdeal = Ideal.span
      (Set.range (fun i : ι ↦ L.integralNorm (b i)) ∪
        Set.range (fun ij : ι × ι ↦ 2 * L.integralForm (b ij.1) (b ij.2))) := by
  simpa only [L.integralNorm_apply] using
    L.integralForm.normIdeal_eq_span_basis L.isSymm_integralForm b

/-- Polarization yields `2 𝔰(L) ≤ 𝔫(L)`. -/
theorem span_singleton_two_mul_scaleIdeal_le_normIdeal (L : IntegralLattice V) :
    Ideal.span {(2 : ℤ)} * L.scaleIdeal ≤ L.normIdeal :=
  L.integralForm.span_singleton_two_mul_scaleIdeal_le_normIdeal L.isSymm_integralForm

/-- The norm ideal lies in `2ℤ` exactly when the lattice is even. -/
theorem isEven_iff_normIdeal_le_span_singleton_two (L : IntegralLattice V) :
    L.IsEven ↔ L.normIdeal ≤ Ideal.span {(2 : ℤ)} := by
  rw [L.isEven_iff_forall_norm, L.normIdeal_le_iff]
  simp only [Ideal.mem_span_singleton, ← even_iff_two_dvd, L.even_integralNorm_iff]

namespace Isometry

variable {L : IntegralLattice V} {M : IntegralLattice W}

/-- An integral-lattice isometry maps scale ideals into one another. -/
theorem scaleIdeal_le (e : Isometry L M) : L.scaleIdeal ≤ M.scaleIdeal := by
  apply (L.integralForm.scaleIdeal_le_iff M.scaleIdeal).mpr
  intro x y
  rw [← e.carrierEquiv_map_integralForm x y]
  exact M.integralForm.apply_mem_scaleIdeal _ _

/-- An integral-lattice isometry preserves the scale ideal. -/
theorem scaleIdeal_eq (e : Isometry L M) : L.scaleIdeal = M.scaleIdeal :=
  le_antisymm e.scaleIdeal_le e.symm.scaleIdeal_le

/-- An integral-lattice isometry maps norm ideals into one another. -/
theorem normIdeal_le (e : Isometry L M) : L.normIdeal ≤ M.normIdeal := by
  apply (L.normIdeal_le_iff M.normIdeal).mpr
  intro x
  rw [← e.integralNorm_carrierEquiv x]
  exact M.integralNorm_mem_normIdeal _

/-- An integral-lattice isometry preserves the norm ideal. -/
theorem normIdeal_eq (e : Isometry L M) : L.normIdeal = M.normIdeal :=
  le_antisymm e.normIdeal_le e.symm.normIdeal_le

end Isometry

end IntegralLattice

end TauCeti
