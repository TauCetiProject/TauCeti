module

public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.GlueAlphabet.Roots

/-!
# The Niemeier lattice with root system `A₁₁ D₇ E₆`

The ordered root system `A₁₁ D₇ E₆` has total rank `11 + 7 + 6 = 24` and the glue alphabet
`ℤ/12 × ℤ/4 × ℤ/3`, of order `144`, in the Conway--Sloane labels: the `D₇` factor is the cyclic
group of order four generated by the spinor label `[1] = s`.  The three alphabets are cyclic
groups of the different orders `12`, `4` and `3`, not vector spaces over one field, so this row
exercises the mixed glue-word language uniformly in the components.

The glue word `[111]` has order `lcm(12, 4, 3) = 12`.  Its multiples `k • [111]` have label
minima `μ_A₁₁(k) + μ_D₇(k) + μ_E₆(k)` summing to `4`, except for `k ≡ 5, 7 (mod 12)`, where
the sum is `6`, and `k ≡ 0`, where it is `0` (`sum_glueMinimum_nsmul_a11d7e6GlueWord`).  Hence
the cyclic subgroup `H` generated by `[111]` is quadratically isotropic, since `q = μ / 2` is
zero in `ℚ/ℤ`, it is Lagrangian because `|H|² = 144` is the order of the glue alphabet, and each
of its nonzero words has minimum norm at least `4`.

Gluing the orthogonal sum `R = A₁₁ ⊥ D₇ ⊥ E₆` along `H` by `TauCeti.DynkinType.gluedLattice`
gives a positive definite even unimodular lattice of rank `24` whose vectors of norm less than `4`
are those of `R` (`image_vectorsOfNorm_a11d7e6Lattice_eq`) and whose roots span `R`
(`span_vectorsOfNorm_two_a11d7e6Lattice`).  The root sublattice is computed from the glue minima,
not from evenness, unimodularity, or a root count.  Assembling the component weights `ω₁`, `s` and
`ϖ₁` gives the explicit norm-`4` glue generator `TauCeti.a11d7e6GlueVector` representing `[111]`
and the `12`-coset decomposition `mem_a11d7e6Lattice_carrier_iff_exists_sub_mem` of the carrier.

## Main declarations

* `TauCeti.a11d7e6`: the ordered components `A₁₁`, `D₇`, `E₆`.
* `TauCeti.a11d7e6GlueWord`: the glue word `[111]`, with `addOrderOf_a11d7e6GlueWord`,
  `sum_glueMinimum_a11d7e6GlueWord` and `quadratic_a11d7e6GlueWord`.
* `TauCeti.a11d7e6GlueSubgroup`: the cyclic glue subgroup, with `natCard_a11d7e6GlueSubgroup`,
  `isLagrangian_a11d7e6GlueSubgroup` and `four_le_sum_glueMinimum_of_mem_a11d7e6GlueSubgroup`.
* `TauCeti.a11d7e6Lattice`: the glued lattice, with `a11d7e6Lattice_def`,
  `mem_a11d7e6Lattice_carrier_iff`, `isEven_a11d7e6Lattice`, `isUnimodular_a11d7e6Lattice`,
  `isPosDef_a11d7e6Lattice`, `finrank_a11d7e6Lattice`, `image_vectorsOfNorm_a11d7e6Lattice_eq`,
  and the root-sublattice equality `span_vectorsOfNorm_two_a11d7e6Lattice`.
* `TauCeti.a11d7e6GlueDual`, `TauCeti.a11d7e6GlueVector`: the explicit norm-`4` dual representative
  of `[111]`, with `mk_a11d7e6GlueDual`, `form_a11d7e6GlueVector_self`,
  `a11d7e6Lattice_carrier_eq_sup_span`, and `mem_a11d7e6Lattice_carrier_iff_exists_sub_mem`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §§6--8, and Chapter 16, §1, Table 16.1.
* J. H. Conway and N. J. A. Sloane, *On the enumeration of lattices of determinant one*,
  Journal of Number Theory 15 (1982), Table V.
-/

public section

namespace TauCeti

open DynkinType IntegralLattice

/-! ### The components and the glue word -/

/-- **The ordered components `A₁₁`, `D₇`, `E₆`** of the rank-24 root system glued in this file.
The order fixes the positions of the glue labels. -/
-- Exposed so that the glue alphabets `(a11d7e6 i).glueAlphabet _` of the three positions reduce to
-- `ℤ/12`, `ℤ/4` and `ℤ/3`, in which the glue labels are written and evaluated.
@[expose] def a11d7e6 : Fin 3 → DynkinType := ![.A 11, .D 7, .E6]

/-- The components `A₁₁`, `D₇`, `E₆` are simply laced. -/
theorem isSimplyLaced_a11d7e6 : ∀ i, (a11d7e6 i).IsSimplyLaced := by decide

/-- The components `A₁₁`, `D₇`, `E₆` are valid Dynkin types. -/
theorem valid_a11d7e6 : ∀ i, (a11d7e6 i).Valid := by decide

/-- The orthogonal sum `A₁₁ ⊥ D₇ ⊥ E₆` of the component root lattices. -/
noncomputable abbrev a11d7e6RootLattice : IntegralLattice (∀ i, Fin (a11d7e6 i).rank → ℚ) :=
  pi fun i ↦ (a11d7e6 i).rootLattice (isSimplyLaced_a11d7e6 i)

/-- **The glue word `[111]`** of `A₁₁ D₇ E₆`: the generator `1` of `ℤ/12`, the spinor label
`1` of `ℤ/4`, and the generator `1` of `ℤ/3`. -/
-- The `A₁₁` and `E₆` labels are written in the carriers `ZMod 12` and `ZMod 3`, which the expected
-- types `(a11d7e6 i).glueAlphabet _` reach by unfolding `glueAlphabet` (`glueAlphabet_A` and
-- `glueAlphabet_E6` hold by `rfl`); hence the `show`.  The `D₇` alphabet is identified with `ℤ/4`
-- by the equation `glueAlphabet_D_of_odd`, not by `rfl`, so its label is transported along it.
noncomputable def a11d7e6GlueWord :
    FiniteQuadraticModule.pi fun i ↦ (a11d7e6 i).glueAlphabet (isSimplyLaced_a11d7e6 i) :=
  Fin.cons (α := fun i ↦ (a11d7e6 i).glueAlphabet (isSimplyLaced_a11d7e6 i))
    (show ZMod 12 from 1) <|
  Fin.cons (α := fun i ↦ (a11d7e6 i.succ).glueAlphabet (isSimplyLaced_a11d7e6 i.succ))
    ((FiniteQuadraticModule.Isometry.ofEq
      (glueAlphabet_D_of_odd 7 (isSimplyLaced_a11d7e6 1) (by decide))).symm
        (show ZMod 4 from 1)) <|
  Fin.cons (α := fun i ↦ (a11d7e6 i.succ.succ).glueAlphabet (isSimplyLaced_a11d7e6 i.succ.succ))
    (show ZMod 3 from 1) finZeroElim

/-! The carriers of the `A₁₁` and `E₆` glue alphabets are `ZMod 12` and `ZMod 3` by definition
of `TauCeti.DynkinType.glueAlphabet`, so the labels of the multiples of `[111]` in these
positions are stated as equalities in these groups.  The `D₇` label is read off through the
isometry `glueAlphabet_D_of_odd` with `ℤ/4`.  Each label of `k • [111]` is `k` times the
corresponding label of `[111]`, computed by `Fin.cons` evaluation. -/

/-- The `A₁₁` label of `k • [111]` is `k mod 12`. -/
theorem nsmul_a11d7e6GlueWord_apply_zero (k : ℕ) :
    @Eq (ZMod 12) ((k • a11d7e6GlueWord) 0) k :=
  (Pi.smul_apply k a11d7e6GlueWord 0).trans (nsmul_one (A := ZMod 12) k)

/-- The `D₇` label of `k • [111]` is `k mod 4` in the cyclic `D₇` alphabet `ℤ/4`. -/
theorem nsmul_a11d7e6GlueWord_apply_one (k : ℕ) :
    FiniteQuadraticModule.Isometry.ofEq
        (glueAlphabet_D_of_odd 7 (isSimplyLaced_a11d7e6 1) (by decide))
        ((k • a11d7e6GlueWord) 1) = (k : ZMod 4) :=
  (congrArg _ (Pi.smul_apply k a11d7e6GlueWord 1)).trans <| (map_nsmul _ k _).trans <|
    (congrArg (k • ·) (QuadraticMap.IsometryEquiv.apply_symm_apply _ _)).trans
      (nsmul_one (A := ZMod 4) k)

/-- The `E₆` label of `k • [111]` is `k mod 3`. -/
theorem nsmul_a11d7e6GlueWord_apply_two (k : ℕ) :
    @Eq (ZMod 3) ((k • a11d7e6GlueWord) 2) k :=
  (Pi.smul_apply k a11d7e6GlueWord 2).trans (nsmul_one (A := ZMod 3) k)

/-- A multiple `k • [111]` vanishes exactly when `12` divides `k`. -/
theorem nsmul_a11d7e6GlueWord_eq_zero_iff (k : ℕ) :
    k • a11d7e6GlueWord = 0 ↔ 12 ∣ k := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · exact (ZMod.natCast_eq_zero_iff k 12).mp
      ((nsmul_a11d7e6GlueWord_apply_zero k).symm.trans (congrFun h 0))
  · funext i
    fin_cases i
    · exact (nsmul_a11d7e6GlueWord_apply_zero k).trans ((ZMod.natCast_eq_zero_iff k 12).mpr h)
    · refine (FiniteQuadraticModule.Isometry.ofEq
        (glueAlphabet_D_of_odd 7 (isSimplyLaced_a11d7e6 1) (by decide))).injective ?_
      exact (nsmul_a11d7e6GlueWord_apply_one k).trans
        (((ZMod.natCast_eq_zero_iff k 4).mpr ((by norm_num : 4 ∣ 12).trans h)).trans
          (map_zero _).symm)
    · exact (nsmul_a11d7e6GlueWord_apply_two k).trans
        ((ZMod.natCast_eq_zero_iff k 3).mpr ((by norm_num : 3 ∣ 12).trans h))

/-- **The glue word `[111]` has order `12`**, the least common multiple of `12`, `4` and `3`. -/
@[simp]
theorem addOrderOf_a11d7e6GlueWord : addOrderOf a11d7e6GlueWord = 12 :=
  Nat.dvd_antisymm
    (addOrderOf_dvd_iff_nsmul_eq_zero.mpr ((nsmul_a11d7e6GlueWord_eq_zero_iff 12).mpr dvd_rfl))
    ((nsmul_a11d7e6GlueWord_eq_zero_iff _).mp (addOrderOf_nsmul_eq_zero a11d7e6GlueWord))

/-! ### Minimum norms of the glue words -/

private theorem glueMinimum_nsmul_a11d7e6GlueWord_zero (k : ℕ) :
    (a11d7e6 0).glueMinimum (isSimplyLaced_a11d7e6 0) ((k • a11d7e6GlueWord) 0) =
      ((k % 12 : ℕ) : ℚ) * (12 - (k % 12 : ℕ)) / 12 := by
  have h := glueMinimum_A 11 (isSimplyLaced_a11d7e6 0) ((k • a11d7e6GlueWord) 0)
  refine h.trans ?_
  rw [nsmul_a11d7e6GlueWord_apply_zero, ZMod.val_natCast]
  norm_num

private theorem glueMinimum_nsmul_a11d7e6GlueWord_one (k : ℕ) :
    (a11d7e6 1).glueMinimum (isSimplyLaced_a11d7e6 1) ((k • a11d7e6GlueWord) 1) =
      if k % 4 = 0 then 0 else if k % 4 = 2 then 1 else 7 / 4 := by
  have h := glueMinimum_D_of_odd 7 (isSimplyLaced_a11d7e6 1) (by decide) _ _
    (nsmul_a11d7e6GlueWord_apply_one k)
  have h2 : (k : ZMod 4) = 2 ↔ k % 4 = 2 := by
    simpa using ZMod.natCast_eq_natCast_iff' k 2 4
  refine h.trans ?_
  simp only [ZMod.natCast_eq_zero_iff, Nat.dvd_iff_mod_eq_zero, h2, Nat.cast_ofNat]

private theorem glueMinimum_nsmul_a11d7e6GlueWord_two (k : ℕ) :
    (a11d7e6 2).glueMinimum (isSimplyLaced_a11d7e6 2) ((k • a11d7e6GlueWord) 2) =
      if k % 3 = 0 then 0 else 4 / 3 := by
  refine (glueMinimum_E6 (isSimplyLaced_a11d7e6 2) ((k • a11d7e6GlueWord) 2)).trans ?_
  rw [nsmul_a11d7e6GlueWord_apply_two]
  simp only [ZMod.natCast_eq_zero_iff, Nat.dvd_iff_mod_eq_zero]

/-- **The minimum norms of the multiples of `[111]`.**  The coset of `k • [111]` has minimum
norm `μ_A₁₁(k) + μ_D₇(k) + μ_E₆(k)`, which is `0` for `k ≡ 0`, `6` for `k ≡ 5, 7`, and `4` for
every other residue of `k` modulo `12`. -/
theorem sum_glueMinimum_nsmul_a11d7e6GlueWord (k : ℕ) :
    ∑ i, (a11d7e6 i).glueMinimum (isSimplyLaced_a11d7e6 i) ((k • a11d7e6GlueWord) i) =
      if k % 12 = 0 then 0 else if k % 12 = 5 ∨ k % 12 = 7 then 6 else 4 := by
  rw [Fin.sum_univ_three, glueMinimum_nsmul_a11d7e6GlueWord_zero,
    glueMinimum_nsmul_a11d7e6GlueWord_one, glueMinimum_nsmul_a11d7e6GlueWord_two,
    show k % 4 = k % 12 % 4 by omega, show k % 3 = k % 12 % 3 by omega]
  have hr : k % 12 < 12 := Nat.mod_lt _ (by norm_num)
  generalize k % 12 = r at hr ⊢
  interval_cases r <;> norm_num

/-- **The glue word `[111]` has minimum norm `4`**: `11/12 + 7/4 + 4/3 = 4`. -/
theorem sum_glueMinimum_a11d7e6GlueWord :
    ∑ i, (a11d7e6 i).glueMinimum (isSimplyLaced_a11d7e6 i) (a11d7e6GlueWord i) = 4 := by
  simpa using sum_glueMinimum_nsmul_a11d7e6GlueWord 1

/-- **The glue word `[111]` is quadratically isotropic**: its quadratic value is half its
minimum norm `4`, which is zero in `ℚ/ℤ`. -/
theorem quadratic_a11d7e6GlueWord :
    (FiniteQuadraticModule.pi fun i ↦ (a11d7e6 i).glueAlphabet
      (isSimplyLaced_a11d7e6 i)).quadratic a11d7e6GlueWord = 0 := by
  rw [quadratic_pi_glueAlphabet_eq_sum_glueMinimum_div_two _ valid_a11d7e6,
    sum_glueMinimum_a11d7e6GlueWord]
  exact (AddCircle.coe_eq_zero_iff_mem_one _).mpr (Submodule.mem_one.mpr ⟨2, by norm_num⟩)

/-- The module of glue words of `A₁₁ D₇ E₆` has order `12 · 4 · 3 = 144`. -/
theorem natCard_pi_glueAlphabet_a11d7e6 :
    Nat.card (FiniteQuadraticModule.pi fun i ↦ (a11d7e6 i).glueAlphabet
      (isSimplyLaced_a11d7e6 i)) = 144 := by
  have h0 : Nat.card ((a11d7e6 0).glueAlphabet (isSimplyLaced_a11d7e6 0)) = 12 :=
    Nat.card_zmod 12
  have h1 : Nat.card ((a11d7e6 1).glueAlphabet (isSimplyLaced_a11d7e6 1)) = 4 :=
    Nat.card_zmod 4
  have h2 : Nat.card ((a11d7e6 2).glueAlphabet (isSimplyLaced_a11d7e6 2)) = 3 :=
    Nat.card_zmod 3
  rw [Nat.card_pi, Fin.prod_univ_three, h0, h1, h2]
  norm_num

/-! ### The glue subgroup -/

/-- **The glue subgroup of `A₁₁ D₇ E₆`**: the cyclic subgroup generated by `[111]`. -/
noncomputable def a11d7e6GlueSubgroup :
    AddSubgroup (FiniteQuadraticModule.pi fun i ↦ (a11d7e6 i).glueAlphabet
      (isSimplyLaced_a11d7e6 i)) :=
  AddSubgroup.zmultiples a11d7e6GlueWord

/-- The glue subgroup is the cyclic subgroup generated by `[111]`. -/
theorem a11d7e6GlueSubgroup_def : a11d7e6GlueSubgroup = AddSubgroup.zmultiples a11d7e6GlueWord :=
  (rfl)

/-- The glue subgroup has order `12`. -/
theorem natCard_a11d7e6GlueSubgroup : Nat.card a11d7e6GlueSubgroup = 12 := by
  rw [a11d7e6GlueSubgroup, Nat.card_zmultiples, addOrderOf_a11d7e6GlueWord]

/-- The words of the glue subgroup are the multiples `k • [111]` with `k < 12`. -/
theorem mem_a11d7e6GlueSubgroup_iff {w : FiniteQuadraticModule.pi fun i ↦
      (a11d7e6 i).glueAlphabet (isSimplyLaced_a11d7e6 i)} :
    w ∈ a11d7e6GlueSubgroup ↔ ∃ k < 12, k • a11d7e6GlueWord = w := by
  classical
  rw [a11d7e6GlueSubgroup, (isOfFinAddOrder_of_finite _).mem_zmultiples_iff_mem_range_addOrderOf,
    addOrderOf_a11d7e6GlueWord, Finset.mem_image]
  simp only [Finset.mem_range]

/-- **The glue subgroup is quadratically isotropic.** -/
theorem isIsotropic_a11d7e6GlueSubgroup :
    (FiniteQuadraticModule.pi fun i ↦ (a11d7e6 i).glueAlphabet
      (isSimplyLaced_a11d7e6 i)).IsIsotropic a11d7e6GlueSubgroup :=
  (FiniteQuadraticModule.isIsotropic_zmultiples_iff _ _).mpr
    ((FiniteQuadraticModule.isIsotropicElem_def _ _).mpr quadratic_a11d7e6GlueWord)

/-- **The glue subgroup is Lagrangian**: it is isotropic of order `12`, and `12² = 144` is the
order of the nondegenerate module of glue words. -/
theorem isLagrangian_a11d7e6GlueSubgroup :
    (FiniteQuadraticModule.pi fun i ↦ (a11d7e6 i).glueAlphabet
      (isSimplyLaced_a11d7e6 i)).IsLagrangian a11d7e6GlueSubgroup :=
  isIsotropic_a11d7e6GlueSubgroup.isLagrangian_of_card_sq_eq _
    (isNondegenerate_pi_glueAlphabet _ _ valid_a11d7e6)
    (by rw [natCard_a11d7e6GlueSubgroup, natCard_pi_glueAlphabet_a11d7e6]; norm_num)

/-- **Every nonzero word of the glue subgroup has minimum norm at least `4`.** -/
theorem four_le_sum_glueMinimum_of_mem_a11d7e6GlueSubgroup {w : FiniteQuadraticModule.pi fun i ↦
      (a11d7e6 i).glueAlphabet (isSimplyLaced_a11d7e6 i)}
    (hw : w ∈ a11d7e6GlueSubgroup) (hw0 : w ≠ 0) :
    4 ≤ ∑ i, (a11d7e6 i).glueMinimum (isSimplyLaced_a11d7e6 i) (w i) := by
  obtain ⟨k, hk, rfl⟩ := mem_a11d7e6GlueSubgroup_iff.mp hw
  have hk0 : k % 12 ≠ 0 := fun h ↦
    hw0 ((nsmul_a11d7e6GlueWord_eq_zero_iff k).mpr (Nat.dvd_of_mod_eq_zero h))
  rw [sum_glueMinimum_nsmul_a11d7e6GlueWord]
  split_ifs with h0
  · exact absurd h0 hk0
  · norm_num
  · norm_num

/-! ### The glued lattice -/

/-- **The Niemeier lattice `A₁₁ D₇ E₆`**: the even overlattice of `A₁₁ ⊥ D₇ ⊥ E₆` glued along
the subgroup generated by `[111]`. -/
noncomputable def a11d7e6Lattice : IntegralLattice (∀ i, Fin (a11d7e6 i).rank → ℚ) :=
  gluedLattice _ isSimplyLaced_a11d7e6 valid_a11d7e6 a11d7e6GlueSubgroup
    isIsotropic_a11d7e6GlueSubgroup

/-- The lattice `A₁₁ D₇ E₆` is the gluing of `A₁₁ ⊥ D₇ ⊥ E₆` along `a11d7e6GlueSubgroup`. -/
theorem a11d7e6Lattice_def :
    a11d7e6Lattice = gluedLattice _ isSimplyLaced_a11d7e6 valid_a11d7e6 a11d7e6GlueSubgroup
      isIsotropic_a11d7e6GlueSubgroup :=
  (rfl)

/-- **The carrier of `A₁₁ D₇ E₆`**: a vector lies in the glued lattice exactly when it lies in
the dual of `A₁₁ ⊥ D₇ ⊥ E₆` and its discriminant class has glue word in the subgroup generated
by `[111]`. -/
theorem mem_a11d7e6Lattice_carrier_iff (x : ∀ i, Fin (a11d7e6 i).rank → ℚ) :
    x ∈ a11d7e6Lattice.carrier ↔ ∃ hx : x ∈ a11d7e6RootLattice.dualCarrier,
      (glueWordIsometry _ _ valid_a11d7e6).toAddEquiv.symm
        (Submodule.Quotient.mk ⟨x, hx⟩) ∈ a11d7e6GlueSubgroup :=
  mem_gluedLattice_carrier_iff _ _ _ _ _ x

/-- `A₁₁ ⊥ D₇ ⊥ E₆` is a sublattice of the glued lattice. -/
theorem a11d7e6RootLattice_carrier_le_a11d7e6Lattice_carrier :
    a11d7e6RootLattice.carrier ≤ a11d7e6Lattice.carrier :=
  carrier_le_gluedLattice_carrier _ _ _ _ _

/-- **`A₁₁ ⊥ D₇ ⊥ E₆` has index `12` in the glued lattice**, the order of the glue subgroup. -/
theorem relIndex_a11d7e6RootLattice_a11d7e6Lattice :
    a11d7e6RootLattice.carrier.toAddSubgroup.relIndex a11d7e6Lattice.carrier.toAddSubgroup =
      12 :=
  (relIndex_gluedLattice _ _ _ _ _).trans natCard_a11d7e6GlueSubgroup

/-- The form of the glued lattice is the form of `A₁₁ ⊥ D₇ ⊥ E₆`. -/
@[simp]
theorem a11d7e6Lattice_form : a11d7e6Lattice.form = a11d7e6RootLattice.form :=
  gluedLattice_form _ _ _ _ _

/-- The glued lattice is nondegenerate. -/
instance instIsNondegenerateA11d7e6Lattice : a11d7e6Lattice.IsNondegenerate :=
  isNondegenerate_gluedLattice _ _ _ _ _

/-- **The lattice `A₁₁ D₇ E₆` is even.** -/
theorem isEven_a11d7e6Lattice : a11d7e6Lattice.IsEven :=
  isEven_gluedLattice _ _ _ _ _

/-- **The lattice `A₁₁ D₇ E₆` is unimodular**, being glued along a Lagrangian subgroup. -/
theorem isUnimodular_a11d7e6Lattice : a11d7e6Lattice.IsUnimodular :=
  (isUnimodular_gluedLattice_iff _ _ _ _ _).mpr isLagrangian_a11d7e6GlueSubgroup

/-- **The lattice `A₁₁ D₇ E₆` is positive definite.** -/
theorem isPosDef_a11d7e6Lattice : a11d7e6Lattice.IsPosDef :=
  isPosDef_gluedLattice _ _ _ _ _

/-- **The lattice `A₁₁ D₇ E₆` has rank `24`.** -/
@[simp]
theorem finrank_a11d7e6Lattice : Module.finrank ℤ a11d7e6Lattice = 24 := by
  rw [a11d7e6Lattice, finrank_gluedLattice]
  decide

/-- **Gluing `A₁₁ ⊥ D₇ ⊥ E₆` along `[111]` adds no vectors of norm less than `4`**, compared in the
common ambient space.  In particular the norm-`2` vectors of `a11d7e6Lattice` are the norm-`2`
vectors of `a11d7e6RootLattice`. -/
theorem image_vectorsOfNorm_a11d7e6Lattice_eq {n : ℚ} (hn : n < 4) :
    (fun x : a11d7e6Lattice ↦ (x : ∀ i, Fin (a11d7e6 i).rank → ℚ)) ''
        a11d7e6Lattice.vectorsOfNorm n =
      (fun x : a11d7e6RootLattice ↦ (x : ∀ i, Fin (a11d7e6 i).rank → ℚ)) ''
        a11d7e6RootLattice.vectorsOfNorm n :=
  image_vectorsOfNorm_gluedLattice_eq _ _ valid_a11d7e6 _
    isIsotropic_a11d7e6GlueSubgroup
    (fun _ hw hw0 ↦ four_le_sum_glueMinimum_of_mem_a11d7e6GlueSubgroup hw hw0) hn

/-- **The root sublattice of `A₁₁ D₇ E₆` is `A₁₁ ⊥ D₇ ⊥ E₆`**: the norm-`2` vectors of the glued
lattice span exactly the carrier of the orthogonal sum of the component root lattices.  Gluing
adds no roots because every nonzero glue word has minimum norm at least `4`. -/
theorem span_vectorsOfNorm_two_a11d7e6Lattice :
    Submodule.span ℤ ((fun x : a11d7e6Lattice ↦ (x : ∀ i, Fin (a11d7e6 i).rank → ℚ)) ''
      a11d7e6Lattice.vectorsOfNorm 2) = a11d7e6RootLattice.carrier :=
  span_vectorsOfNorm_two_gluedLattice _ _ valid_a11d7e6 _
    isIsotropic_a11d7e6GlueSubgroup
    (fun _ hw hw0 ↦ four_le_sum_glueMinimum_of_mem_a11d7e6GlueSubgroup hw hw0) (by norm_num)

/-! ### Explicit glue generator and coset decomposition -/

/-- The component dual representatives of `[111]`: the first fundamental weight `ω₁` of `A₁₁`, the
spinor weight `s` of `D₇` pulled back along `rootLatticeIsometryCheckerboard`, and the minuscule
weight `ϖ₁` of `E₆`. -/
private noncomputable def a11d7e6GlueComponents :
    ∀ i, ((a11d7e6 i).rootLattice (isSimplyLaced_a11d7e6 i)).dualCarrier :=
  Fin.cons (α := fun i ↦ ((a11d7e6 i).rootLattice (isSimplyLaced_a11d7e6 i)).dualCarrier)
    ((Isometry.ofEq (rootLattice_A 11 (isSimplyLaced_a11d7e6 0)).symm).dualCarrierEquiv
      (typeAFundamentalWeightDual 11)) <|
  Fin.cons (α := fun i ↦ ((a11d7e6 i.succ).rootLattice (isSimplyLaced_a11d7e6 i.succ)).dualCarrier)
    ((rootLatticeIsometryCheckerboard 7 (by decide)
      (isSimplyLaced_a11d7e6 1)).symm.dualCarrierEquiv
        ⟨checkerboardSpinor 7, checkerboardSpinor_mem_dualCarrier⟩) <|
  Fin.cons (α := fun i ↦
      ((a11d7e6 i.succ.succ).rootLattice (isSimplyLaced_a11d7e6 i.succ.succ)).dualCarrier)
    ((Isometry.ofEq (rootLattice_E6 (isSimplyLaced_a11d7e6 2)).symm).dualCarrierEquiv
      typeE₆MinusculeWeightDual) finZeroElim

/-- **The canonical dual representative of `[111]`** in `(A₁₁ ⊥ D₇ ⊥ E₆)^∨`, assembling `ω₁` on
`A₁₁`, the spinor weight `s` on `D₇`, and the minuscule weight `ϖ₁` on `E₆`. -/
noncomputable def a11d7e6GlueDual : a11d7e6RootLattice.dualCarrier :=
  (piDualCarrierEquiv fun i ↦ (a11d7e6 i).rootLattice (isSimplyLaced_a11d7e6 i)).symm
    a11d7e6GlueComponents

/-- **The explicit norm-`4` glue generator of `A₁₁ D₇ E₆`** in the ambient rational space: its
components are `typeAFundamentalWeight 11`, the pullback of `checkerboardSpinor 7`, and
`typeE₆MinusculeWeight`. -/
noncomputable def a11d7e6GlueVector : ∀ i, Fin (a11d7e6 i).rank → ℚ :=
  a11d7e6GlueDual

/-- The ambient vector of `a11d7e6GlueDual` is `a11d7e6GlueVector`. -/
@[simp]
theorem coe_a11d7e6GlueDual :
    (a11d7e6GlueDual : ∀ i, Fin (a11d7e6 i).rank → ℚ) = a11d7e6GlueVector :=
  (rfl)

/-- `a11d7e6GlueVector` lies in the dual carrier of `A₁₁ ⊥ D₇ ⊥ E₆`. -/
theorem a11d7e6GlueVector_mem_dualCarrier :
    a11d7e6GlueVector ∈ a11d7e6RootLattice.dualCarrier :=
  a11d7e6GlueDual.2

/-- The `A₁₁` component of `a11d7e6GlueVector` is the first fundamental weight `ω₁`. -/
@[simp]
theorem a11d7e6GlueVector_zero : a11d7e6GlueVector 0 = typeAFundamentalWeight 11 := by
  rw [a11d7e6GlueVector, a11d7e6GlueDual, coe_piDualCarrierEquiv_symm_apply]
  exact ((Isometry.ofEq
    (rootLattice_A 11 (isSimplyLaced_a11d7e6 0)).symm).coe_dualCarrierEquiv_apply
      (typeAFundamentalWeightDual 11)).trans <|
    (Isometry.ofEq_apply (rootLattice_A 11 (isSimplyLaced_a11d7e6 0)).symm _).trans
      (coe_typeAFundamentalWeightDual 11)

/-- The `D₇` component of `a11d7e6GlueVector` is the spinor vector `(1/2, …, 1/2)` pulled back
along `rootLatticeIsometryCheckerboard`. -/
@[simp]
theorem a11d7e6GlueVector_one :
    a11d7e6GlueVector 1 =
      (rootLatticeIsometryCheckerboard 7 (by decide) (isSimplyLaced_a11d7e6 1)).symm
        (checkerboardSpinor 7) := by
  rw [a11d7e6GlueVector, a11d7e6GlueDual, coe_piDualCarrierEquiv_symm_apply]
  exact (rootLatticeIsometryCheckerboard 7 (by decide)
    (isSimplyLaced_a11d7e6 1)).symm.coe_dualCarrierEquiv_apply _

/-- In checkerboard coordinates, the `D₇` component of `a11d7e6GlueVector` is the spinor vector
`checkerboardSpinor 7`. -/
theorem rootLatticeIsometryCheckerboard_a11d7e6GlueVector_one :
    rootLatticeIsometryCheckerboard 7 (by decide) (isSimplyLaced_a11d7e6 1)
        (a11d7e6GlueVector 1) =
      checkerboardSpinor 7 := by
  rw [a11d7e6GlueVector_one, Isometry.apply_symm_apply]

/-- The `E₆` component of `a11d7e6GlueVector` is the minuscule weight `ϖ₁`. -/
@[simp]
theorem a11d7e6GlueVector_two : a11d7e6GlueVector 2 = typeE₆MinusculeWeight := by
  rw [a11d7e6GlueVector, a11d7e6GlueDual, coe_piDualCarrierEquiv_symm_apply]
  exact ((Isometry.ofEq (rootLattice_E6 (isSimplyLaced_a11d7e6 2)).symm).coe_dualCarrierEquiv_apply
    typeE₆MinusculeWeightDual).trans <|
    (Isometry.ofEq_apply (rootLattice_E6 (isSimplyLaced_a11d7e6 2)).symm _).trans
      coe_typeE₆MinusculeWeightDual

/-- **The dual vector `a11d7e6GlueDual` represents the glue word `[111]`** in the discriminant
group of `A₁₁ ⊥ D₇ ⊥ E₆`. -/
theorem mk_a11d7e6GlueDual :
    (Submodule.Quotient.mk a11d7e6GlueDual : a11d7e6RootLattice.DiscriminantGroup) =
      glueWordIsometry a11d7e6 isSimplyLaced_a11d7e6 valid_a11d7e6 a11d7e6GlueWord := by
  apply (discriminantGroupPiEquiv fun i ↦
    (a11d7e6 i).rootLattice (isSimplyLaced_a11d7e6 i)).injective
  funext i
  rw [discriminantGroupPiEquiv_mk, discriminantGroupPiEquiv_glueWordIsometry, a11d7e6GlueDual,
    LinearEquiv.apply_symm_apply]
  fin_cases i
  · exact (Isometry.discriminantGroupEquiv_mk _ _).symm.trans <|
      (congrArg _ ((mk_typeAFundamentalWeightDual 11).trans
        (typeADiscriminantGroupEquiv_apply_one 11).symm)).trans
        (glueAlphabetIsometry_A_apply 11 (valid_a11d7e6 0) (isSimplyLaced_a11d7e6 0) 1).symm
  · have h1 := nsmul_a11d7e6GlueWord_apply_one 1
    rw [one_nsmul, Nat.cast_one] at h1
    exact (Isometry.discriminantGroupEquiv_mk _ _).symm.trans <|
      (congrArg _ (checkerboardSpinorClass_def 7).symm).trans <|
        (congrArg _ ((zmodFourAddEquivCheckerboardDiscriminantGroup_apply_one 7
          (by decide)).symm.trans (congrArg _ h1.symm))).trans
          (glueAlphabetIsometry_D_apply_of_odd 7 (valid_a11d7e6 1) (isSimplyLaced_a11d7e6 1)
            (by decide) (a11d7e6GlueWord 1)).symm
  · exact (Isometry.discriminantGroupEquiv_mk _ _).symm.trans <|
      (congrArg _ (mk_typeE₆MinusculeWeightDual.trans
        typeE₆DiscriminantGroupEquiv_apply_one.symm)).trans
        (glueAlphabetIsometry_E6_apply (valid_a11d7e6 2) (isSimplyLaced_a11d7e6 2) 1).symm

/-- **The glue generator `a11d7e6GlueVector` has norm `4`**: `11/12 + 7/4 + 4/3 = 4`. -/
theorem form_a11d7e6GlueVector_self :
    a11d7e6Lattice.form a11d7e6GlueVector a11d7e6GlueVector = 4 := by
  have h0 : ((a11d7e6 0).rootLattice (isSimplyLaced_a11d7e6 0)).form
      (a11d7e6GlueVector 0) (a11d7e6GlueVector 0) = 11 / 12 :=
    ((Isometry.ofEq (rootLattice_A 11 (isSimplyLaced_a11d7e6 0))).map_app _ _).symm.trans <|
      (congrArg₂ (fun u v ↦ (typeARootLattice 11).form u v)
        ((Isometry.ofEq_apply (rootLattice_A 11 (isSimplyLaced_a11d7e6 0)) _).trans
          a11d7e6GlueVector_zero)
        ((Isometry.ofEq_apply (rootLattice_A 11 (isSimplyLaced_a11d7e6 0)) _).trans
          a11d7e6GlueVector_zero)).trans <|
        (form_typeAFundamentalWeight_self 11).trans (by norm_num)
  have h1 : ((a11d7e6 1).rootLattice (isSimplyLaced_a11d7e6 1)).form
      (a11d7e6GlueVector 1) (a11d7e6GlueVector 1) = 7 / 4 :=
    (congrArg₂ (fun u v ↦ ((a11d7e6 1).rootLattice (isSimplyLaced_a11d7e6 1)).form u v)
      a11d7e6GlueVector_one a11d7e6GlueVector_one).trans <|
      (Isometry.map_app _ _ _).trans <|
        checkerboardLattice_form_checkerboardSpinor_self.trans (by norm_num)
  have h2 : ((a11d7e6 2).rootLattice (isSimplyLaced_a11d7e6 2)).form
      (a11d7e6GlueVector 2) (a11d7e6GlueVector 2) = 4 / 3 :=
    ((Isometry.ofEq (rootLattice_E6 (isSimplyLaced_a11d7e6 2))).map_app _ _).symm.trans <|
      (congrArg₂ (fun u v ↦ typeE₆RootLattice.form u v)
        ((Isometry.ofEq_apply (rootLattice_E6 (isSimplyLaced_a11d7e6 2)) _).trans
          a11d7e6GlueVector_two)
        ((Isometry.ofEq_apply (rootLattice_E6 (isSimplyLaced_a11d7e6 2)) _).trans
          a11d7e6GlueVector_two)).trans
        form_typeE₆MinusculeWeight_self
  rw [a11d7e6Lattice_form, pi_form, piForm_apply, Fin.sum_univ_three, h0, h1, h2]
  norm_num

/-- **The glue generator `a11d7e6GlueVector` belongs to the glued lattice `A₁₁ D₇ E₆`.** -/
theorem a11d7e6GlueVector_mem_a11d7e6Lattice :
    a11d7e6GlueVector ∈ a11d7e6Lattice.carrier := by
  rw [mem_a11d7e6Lattice_carrier_iff]
  refine ⟨a11d7e6GlueVector_mem_dualCarrier, ?_⟩
  have hmk : (Submodule.Quotient.mk ⟨a11d7e6GlueVector, a11d7e6GlueVector_mem_dualCarrier⟩ :
      a11d7e6RootLattice.DiscriminantGroup) =
      glueWordIsometry a11d7e6 isSimplyLaced_a11d7e6 valid_a11d7e6 a11d7e6GlueWord :=
    mk_a11d7e6GlueDual
  rw [hmk]
  exact (AddEquiv.symm_apply_apply (glueWordIsometry _ _ valid_a11d7e6).toAddEquiv
    a11d7e6GlueWord).symm ▸ AddSubgroup.mem_zmultiples a11d7e6GlueWord

/-- A multiple `k • a11d7e6GlueVector` lies in `A₁₁ ⊥ D₇ ⊥ E₆` exactly when `12` divides `k`. -/
theorem nsmul_a11d7e6GlueVector_mem_a11d7e6RootLattice_iff (k : ℕ) :
    k • a11d7e6GlueVector ∈ a11d7e6RootLattice.carrier ↔ 12 ∣ k := by
  rw [← natCast_zsmul, ← coe_a11d7e6GlueDual, ← Submodule.coe_smul,
    ← a11d7e6RootLattice.discriminantGroup_mk_eq_zero_iff, Submodule.Quotient.mk_smul,
    natCast_zsmul]
  exact (congrArg (· = 0) ((congrArg (k • ·) mk_a11d7e6GlueDual).trans
    (map_nsmul (glueWordIsometry a11d7e6 isSimplyLaced_a11d7e6 valid_a11d7e6) k
      a11d7e6GlueWord).symm)).to_iff.trans <|
    (map_eq_zero_iff _ (EquivLike.injective _)).trans (nsmul_a11d7e6GlueWord_eq_zero_iff k)

/-- An integer multiple `k • a11d7e6GlueVector` lies in `A₁₁ ⊥ D₇ ⊥ E₆` exactly when `12` divides
`k`. -/
theorem zsmul_a11d7e6GlueVector_mem_a11d7e6RootLattice_iff (k : ℤ) :
    k • a11d7e6GlueVector ∈ a11d7e6RootLattice.carrier ↔ (12 : ℤ) ∣ k := by
  rcases k.eq_nat_or_neg with ⟨n, rfl | rfl⟩
  · rw [natCast_zsmul, nsmul_a11d7e6GlueVector_mem_a11d7e6RootLattice_iff]
    exact_mod_cast Iff.rfl
  · rw [neg_smul, Submodule.neg_mem_iff, natCast_zsmul,
      nsmul_a11d7e6GlueVector_mem_a11d7e6RootLattice_iff, dvd_neg]
    exact_mod_cast Iff.rfl

/-- **Generators of `A₁₁ D₇ E₆`**: the glued lattice is spanned over `ℤ` by the root lattice
`A₁₁ ⊥ D₇ ⊥ E₆` and the single norm-`4` glue vector `a11d7e6GlueVector`. -/
theorem a11d7e6Lattice_carrier_eq_sup_span :
    a11d7e6Lattice.carrier =
      a11d7e6RootLattice.carrier ⊔ Submodule.span ℤ {a11d7e6GlueVector} := by
  refine (gluedLattice_carrier_eq_sup_span _ _ _ _ _ (G := {a11d7e6GlueWord})
    (AddSubgroup.zmultiples_eq_closure a11d7e6GlueWord).symm (fun _ ↦ a11d7e6GlueDual) ?_).trans ?_
  · rintro _ rfl
    exact mk_a11d7e6GlueDual
  · rw [Set.image_singleton, coe_a11d7e6GlueDual]

/-- **Coset decomposition of `A₁₁ D₇ E₆`**: a vector lies in the glued lattice exactly when it
differs from one of the twelve multiples `k • a11d7e6GlueVector` (`k < 12`) by a vector of the root
lattice `A₁₁ ⊥ D₇ ⊥ E₆`. -/
theorem mem_a11d7e6Lattice_carrier_iff_exists_sub_mem
    (x : ∀ i, Fin (a11d7e6 i).rank → ℚ) :
    x ∈ a11d7e6Lattice.carrier ↔
      ∃ k < 12, x - k • a11d7e6GlueVector ∈ a11d7e6RootLattice.carrier := by
  constructor
  · intro hx
    obtain ⟨hxDual, hw⟩ := (mem_a11d7e6Lattice_carrier_iff x).mp hx
    obtain ⟨k, hk, hkw⟩ := mem_a11d7e6GlueSubgroup_iff.mp hw
    refine ⟨k, hk, ?_⟩
    have hmk : (Submodule.Quotient.mk ⟨x, hxDual⟩ : a11d7e6RootLattice.DiscriminantGroup) =
        Submodule.Quotient.mk ((k : ℤ) • a11d7e6GlueDual) :=
      (AddEquiv.apply_symm_apply (glueWordIsometry _ _ valid_a11d7e6).toAddEquiv _).symm.trans <|
        (congrArg (glueWordIsometry _ _ valid_a11d7e6).toAddEquiv hkw.symm).trans <|
          (map_nsmul (glueWordIsometry _ _ valid_a11d7e6).toAddEquiv k a11d7e6GlueWord).trans <|
            (congrArg (k • ·) mk_a11d7e6GlueDual.symm).trans <|
              (natCast_zsmul _ _).symm.trans (Submodule.Quotient.mk_smul _ _ _).symm
    have hdiff := (a11d7e6RootLattice.discriminantGroup_mk_eq_iff ⟨x, hxDual⟩
      ((k : ℤ) • a11d7e6GlueDual)).mp hmk
    rwa [Submodule.coe_sub, Submodule.coe_smul, coe_a11d7e6GlueDual, natCast_zsmul] at hdiff
  · rintro ⟨k, -, hmem⟩
    exact sub_add_cancel x (k • a11d7e6GlueVector) ▸ a11d7e6Lattice.carrier.add_mem
      (a11d7e6RootLattice_carrier_le_a11d7e6Lattice_carrier hmem)
      (a11d7e6Lattice.carrier.nsmul_mem a11d7e6GlueVector_mem_a11d7e6Lattice k)

end TauCeti
