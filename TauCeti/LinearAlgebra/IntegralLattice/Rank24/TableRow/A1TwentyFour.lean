module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.A1TwentyFour
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Niemeier

/-!
# The table row `A₁²⁴` is binary Golay Construction A

The row `A₁²⁴` of the rootful rank-24 table, `TauCeti.RootfulNiemeierType.a1TwentyFourth`, glues
the orthogonal sum of its components, read off by position from the list of twenty-four `A₁`
components, along the subgroup `H` generated by the decoded Conway--Sloane pattern
`[1(00000101001100110101111)]`.  The same row is also constructed directly, as the lattice
`TauCeti.a1TwentyFourthLattice` glued from the constant family `A₁` on `Fin 24` along the
subgroup generated by the twenty-three printed rotations, which is identified with the extended
binary Golay code.  This file shows that the two constructions agree, so that the uniform table
lattice `a1TwentyFourth.lattice` inherits the identification with the Golay code.

The components of the row are all equal to `A₁`, so passing from the row's family of components
to the constant family is the isometry of glue-word modules
`TauCeti.RootfulNiemeierType.a1TwentyFourthGlueIsometry`, which keeps every Conway--Sloane digit.
The digit words of the row's pattern are exactly the twenty-three printed rotations
(`TauCeti.RootfulNiemeierType.glueWords_a1TwentyFourth`, a finite check), so this isometry carries
`H` onto the subgroup generated by the printed words
(`TauCeti.RootfulNiemeierType.map_glueSubgroup_a1TwentyFourth`).  Consequently a glue word of the
row lies in `H` exactly when its image in Golay coordinates is a Golay codeword
(`TauCeti.RootfulNiemeierType.mem_glueSubgroup_a1TwentyFourth_iff`).

At the level of lattices, the naturality of gluing under equal families of components gives the
explicit isometry `TauCeti.RootfulNiemeierType.a1TwentyFourthLatticeIsometry` from the table lattice
to `TauCeti.a1TwentyFourthLattice`, which keeps every coordinate.  Composing with
`TauCeti.a1TwentyFourthConstructionAIsometry` identifies the table lattice with
`TauCeti.BinaryGolay.constructionALattice`
(`TauCeti.RootfulNiemeierType.a1TwentyFourthLatticeConstructionAIsometry`): the Golay coordinate
`j` of the image of `x` is twice the simple-root coordinate of `x` in the table component
`p j`, where `p` is the destination-to-source permutation `TauCeti.a1TableToGolayPerm`.  In
particular this rootful lattice is Construction A of the Golay code, not the Leech lattice.

## Main declarations

* `TauCeti.RootfulNiemeierType.a1TwentyFourthGlueIsometry`: glue words of the row in the constant
  `A₁` alphabets.
* `TauCeti.RootfulNiemeierType.map_glueSubgroup_a1TwentyFourth`,
  `TauCeti.RootfulNiemeierType.mem_glueSubgroup_a1TwentyFourth_iff`: the table glue subgroup is the
  printed glue subgroup, that is, the binary Golay code.
* `TauCeti.RootfulNiemeierType.a1TwentyFourthLatticeIsometry`: the table lattice is the lattice
  `TauCeti.a1TwentyFourthLattice`.
* `TauCeti.RootfulNiemeierType.a1TwentyFourthLatticeConstructionAIsometry`: the table lattice is
  binary Golay Construction A.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §3, Chapter 7, §6, and Chapter 16, §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType IntegralLattice

/-! ### The components and glue words of the row -/

/-- The row `A₁²⁴` has twenty-four components. -/
@[simp]
theorem length_components_a1TwentyFourth : a1TwentyFourth.components.length = 24 :=
  List.length_replicate

/-- Every component of the row `A₁²⁴` has type `A₁`. -/
@[simp]
theorem componentType_a1TwentyFourth (i : Fin a1TwentyFourth.components.length) :
    a1TwentyFourth.componentType i = A 1 :=
  congrArg Subtype.val (List.getElem_replicate _)

/-- **The digit words of the row `A₁²⁴` are the twenty-three printed rotations**: the label `1`
followed by a cyclic rotation of the block `00000101001100110101111`. -/
theorem glueWords_a1TwentyFourth : a1TwentyFourth.glueWords =
    Finset.univ.image fun r : Fin 23 ↦ List.ofFn fun j ↦ (a1TwentyFourPrintedWord r j : ℕ) := by
  have hword (r : Fin 23) : (List.ofFn fun j ↦ (a1TwentyFourPrintedWord r j : ℕ)) =
      1 :: List.ofFn fun i : Fin 23 ↦ (a1TwentyFourPrintedBlock (i + r) : ℕ) := by
    simp [List.ofFn_succ]
  simp only [hword, a1TwentyFourPrintedBlock_def]
  decide

/-- **Glue words of the row `A₁²⁴` in the constant `A₁` alphabets**: the isometry of glue-word
modules that reads the label of component `j : Fin 24` as a label of `A₁`. -/
noncomputable def a1TwentyFourthGlueIsometry :
    FiniteQuadraticModule.Isometry a1TwentyFourth.glueModule a1TwentyFourGlueModule :=
  piGlueAlphabetCongr _ _ (finCongr length_components_a1TwentyFourth.symm)
    fun _ ↦ componentType_a1TwentyFourth _

/-- The glue isometry of the row `A₁²⁴` keeps every Conway--Sloane digit. -/
@[simp]
theorem encodeGlueWord_a1TwentyFourthGlueIsometry (w : a1TwentyFourth.glueModule) :
    encodeGlueWord (fun _ : Fin 24 ↦ A 1) (fun _ ↦ isSimplyLaced_A 1)
        (a1TwentyFourthGlueIsometry w) =
      encodeGlueWord a1TwentyFourth.componentType a1TwentyFourth.isSimplyLaced_componentType w :=
  encodeGlueWord_piGlueAlphabetCongr _ _ _ _ _ w

/-- The decoded printed rotation of `A₁²⁴` has the printed digits. -/
private theorem encodeGlueWord_a1TwentyFourPrintedWord (r : Fin 23) :
    encodeGlueWord (fun _ : Fin 24 ↦ A 1) (fun _ ↦ isSimplyLaced_A 1)
        (fun j ↦ (A 1).glueLabelEquiv (isSimplyLaced_A 1) (a1TwentyFourPrintedWord r j)) =
      List.ofFn fun j ↦ (a1TwentyFourPrintedWord r j : ℕ) := by
  rw [eq_comm, ← decodeGlueWord_eq_some_iff,
    decodeGlueWord_ofFn _ _ _ fun j ↦ (a1TwentyFourPrintedWord r j).isLt]

/-- The glue isometry of the row carries its glue generators to the decoded printed rotations. -/
private theorem image_glueGenerators_a1TwentyFourth :
    a1TwentyFourthGlueIsometry '' a1TwentyFourth.glueGenerators = Set.range fun r j ↦
      (A 1).glueLabelEquiv (isSimplyLaced_A 1) (a1TwentyFourPrintedWord r j) := by
  ext v
  obtain ⟨w, rfl⟩ := EquivLike.surjective a1TwentyFourthGlueIsometry v
  rw [(EquivLike.injective a1TwentyFourthGlueIsometry).mem_set_image, mem_glueGenerators_iff,
    glueWords_a1TwentyFourth, ← encodeGlueWord_a1TwentyFourthGlueIsometry, Finset.mem_image]
  simp only [Finset.mem_univ, true_and, Set.mem_range]
  refine exists_congr fun r ↦ ?_
  rw [← encodeGlueWord_a1TwentyFourPrintedWord]
  exact (encodeGlueWord_injective _ _).eq_iff

/-! ### The glue subgroup of the row -/

/-- **The table glue subgroup of `A₁²⁴` is the printed glue subgroup**: the glue isometry of the
row carries the subgroup generated by the decoded table pattern onto the subgroup generated by the
twenty-three printed rotations. -/
theorem map_glueSubgroup_a1TwentyFourth :
    a1TwentyFourth.glueSubgroup.map
        a1TwentyFourthGlueIsometry.toLinearEquiv.toAddEquiv.toAddMonoidHom =
      a1TwentyFourGlueSubgroup := by
  rw [glueSubgroup_def, AddMonoidHom.map_closure, a1TwentyFourGlueSubgroup_def]
  exact congrArg AddSubgroup.closure image_glueGenerators_a1TwentyFourth

/-- A glue word of the row `A₁²⁴` lies in the table glue subgroup exactly when its image under the
glue isometry lies in the printed glue subgroup. -/
theorem a1TwentyFourthGlueIsometry_mem_a1TwentyFourGlueSubgroup_iff
    (w : a1TwentyFourth.glueModule) :
    a1TwentyFourthGlueIsometry w ∈ a1TwentyFourGlueSubgroup ↔ w ∈ a1TwentyFourth.glueSubgroup := by
  rw [← map_glueSubgroup_a1TwentyFourth, AddSubgroup.mem_map_equiv]
  simp

/-- **The table glue subgroup of `A₁²⁴` is the binary Golay code**: a glue word of the row lies
in the subgroup generated by `[1(00000101001100110101111)]` exactly when, read in the Golay
coordinates of `TauCeti.a1TableToGolayIsometry`, it is a word of the extended binary Golay
code. -/
theorem mem_glueSubgroup_a1TwentyFourth_iff (w : a1TwentyFourth.glueModule) :
    w ∈ a1TwentyFourth.glueSubgroup ↔
      a1TableToGolayIsometry (a1TwentyFourthGlueIsometry w) ∈ BinaryGolay.code := by
  rw [← a1TwentyFourthGlueIsometry_mem_a1TwentyFourGlueSubgroup_iff,
    mem_a1TwentyFourGlueSubgroup_iff]

/-! ### The lattice of the row -/

/-- **The table lattice of `A₁²⁴` is the Golay-glued lattice `TauCeti.a1TwentyFourthLattice`**,
by the isometry keeping every coordinate: component `j : Fin 24` of the image is component `j`
of the source, a vector of the `A₁` root lattice. -/
noncomputable def a1TwentyFourthLatticeIsometry :
    IntegralLattice.Isometry a1TwentyFourth.lattice a1TwentyFourthLattice :=
  (Isometry.ofEq (lattice_def _)).trans <|
    (gluedLatticeIsometryOfEq _ _ _ _ _ _ _ _ _
      a1TwentyFourthGlueIsometry_mem_a1TwentyFourGlueSubgroup_iff).trans
    (Isometry.ofEq a1TwentyFourthLattice_def.symm)

/-- The isometry from the table lattice of `A₁²⁴` to `TauCeti.a1TwentyFourthLattice` keeps every
coordinate, up to the identification of the index types. -/
theorem a1TwentyFourthLatticeIsometry_apply
    (x : ∀ i, Fin (a1TwentyFourth.componentType i).rank → ℚ) (k : Fin 24) (j : Fin (A 1).rank) :
    a1TwentyFourthLatticeIsometry x k j =
      x (Fin.cast length_components_a1TwentyFourth.symm k)
        (Fin.cast (congrArg rank (componentType_a1TwentyFourth _)).symm j) := by
  rw [a1TwentyFourthLatticeIsometry, Isometry.trans_apply, Isometry.trans_apply,
    Isometry.ofEq_apply, Isometry.ofEq_apply]
  exact gluedLatticeIsometryOfEq_apply (s := fun _ ↦ A 1) _ _ _ _ _ _ _ _ _ _ x k j

/-- **The table lattice of `A₁²⁴` is binary Golay Construction A**: an explicit isometry from
`a1TwentyFourth.lattice` onto `TauCeti.BinaryGolay.constructionALattice`. -/
noncomputable def a1TwentyFourthLatticeConstructionAIsometry :
    IntegralLattice.Isometry a1TwentyFourth.lattice BinaryGolay.constructionALattice :=
  a1TwentyFourthLatticeIsometry.trans a1TwentyFourthConstructionAIsometry

/-- The isometry onto Golay Construction A doubles, in Golay coordinate `j`, the simple-root
coordinate of the table component `p j`, where `p = TauCeti.a1TableToGolayPerm`. -/
theorem a1TwentyFourthLatticeConstructionAIsometry_apply
    (x : ∀ i, Fin (a1TwentyFourth.componentType i).rank → ℚ) (j : Fin 24) :
    a1TwentyFourthLatticeConstructionAIsometry x j =
      2 * x (Fin.cast length_components_a1TwentyFourth.symm (a1TableToGolayPerm j))
        ⟨0, by rw [componentType_a1TwentyFourth]; decide⟩ := by
  rw [a1TwentyFourthLatticeConstructionAIsometry, Isometry.trans_apply,
    a1TwentyFourthConstructionAIsometry_apply, a1TwentyFourthLatticeIsometry_apply]
  rfl

end RootfulNiemeierType

end TauCeti
