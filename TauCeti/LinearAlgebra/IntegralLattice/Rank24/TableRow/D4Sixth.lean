module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.D4Six.Glue
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.Checks

/-!
# The table row `D₄⁶` is glued along the hexacode

The row `D₄⁶` of the rootful rank-24 table, `TauCeti.RootfulNiemeierType.d4Sixth`, is the only row
with the `𝔽₄`-linear span mode: its glue subgroup `H` is generated by the decoded words
`[111111]` and `[0(02332)]` together with their multiples by `ω` and `ω²`, read through the
labelling `0, 1, 2, 3 ↦ 0, ω, 1, ω²` of the `D₄` labels.  The same subgroup is also constructed
directly, over the constant family `D₄` on `Fin 6`, as `TauCeti.d4SixGlueSubgroup`: the additive
closure of the six printed words and `[222222]`.  That subgroup has order `64`, is closed under
the scalars of `𝔽₄`, and is carried onto the hexacode by `TauCeti.d4SixHexacodeIsometry`.

This file shows that the two subgroups agree
(`TauCeti.RootfulNiemeierType.map_glueSubgroup_d4Sixth`), along the isometry of glue-word modules
`TauCeti.RootfulNiemeierType.d4SixthGlueIsometry` which keeps every Conway--Sloane digit.  The
seven generators of `TauCeti.d4SixGlueSubgroup` are digit words of the row (a finite check), so it
is contained in the image of `H`; both have order `64`
(`TauCeti.RootfulNiemeierType.natCard_glueSubgroup`, `TauCeti.natCard_d4SixGlueSubgroup`), so they
are equal.  Consequently a glue word of the row lies in `H` exactly when its hexacode coordinates
form a hexacode word (`TauCeti.RootfulNiemeierType.mem_glueSubgroup_d4Sixth_iff`).

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §7, and Chapter 16, §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType

/-- The row `D₄⁶` has six components. -/
@[simp]
theorem length_components_d4Sixth : d4Sixth.components.length = 6 :=
  List.length_replicate

/-- Every component of the row `D₄⁶` has type `D₄`. -/
@[simp]
theorem componentType_d4Sixth (i : Fin d4Sixth.components.length) :
    d4Sixth.componentType i = D 4 :=
  congrArg Subtype.val (List.getElem_replicate _)

/-- **Glue words of the row `D₄⁶` in the constant `D₄` alphabets**: the isometry of glue-word
modules that reads the label of component `j : Fin 6` as a label of `D₄`. -/
noncomputable def d4SixthGlueIsometry :
    FiniteQuadraticModule.Isometry d4Sixth.glueModule d4SixGlueModule :=
  piGlueAlphabetCongr _ _ (finCongr length_components_d4Sixth.symm)
    fun _ ↦ componentType_d4Sixth _

/-- The glue isometry of the row `D₄⁶` is the reindexing of glue words from the positions of the
row's components to `Fin 6`. -/
theorem d4SixthGlueIsometry_def :
    d4SixthGlueIsometry = piGlueAlphabetCongr _ _
      (finCongr length_components_d4Sixth.symm) fun _ ↦ componentType_d4Sixth _ :=
  (rfl)

/-- The glue isometry of the row `D₄⁶` keeps every Conway--Sloane digit. -/
@[simp]
theorem encodeGlueWord_d4SixthGlueIsometry (w : d4Sixth.glueModule) :
    encodeGlueWord (fun _ : Fin 6 ↦ D 4) (fun _ ↦ isSimplyLaced_D 4) (d4SixthGlueIsometry w) =
      encodeGlueWord d4Sixth.componentType d4Sixth.isSimplyLaced_componentType w :=
  encodeGlueWord_piGlueAlphabetCongr _ _ _ _ _ w

/-- The generators of `TauCeti.d4SixGlueSubgroup` are digit words of the row `D₄⁶`. -/
private theorem ofFn_mem_glueWords_d4Sixth :
    ∀ d ∈ insert ![2, 2, 2, 2, 2, 2] d4SixPrintedDigits,
      (List.ofFn fun j : Fin 6 ↦ (d j : ℕ)) ∈ d4Sixth.glueWords := by
  simp only [d4SixPrintedDigits_def, Set.mem_insert_iff, Set.mem_singleton_iff]
  rintro d (rfl | rfl | rfl | rfl | rfl | rfl | rfl) <;> decide

/-- **The table glue subgroup of `D₄⁶` is the printed glue subgroup**: the glue isometry of the
row carries the subgroup generated with the `𝔽₄`-linear span mode onto
`TauCeti.d4SixGlueSubgroup`, the additive closure of the printed words and `[222222]`. -/
theorem map_glueSubgroup_d4Sixth :
    d4Sixth.glueSubgroup.map d4SixthGlueIsometry.toLinearEquiv.toAddEquiv.toAddMonoidHom =
      d4SixGlueSubgroup := by
  have hle : d4SixGlueSubgroup ≤
      d4Sixth.glueSubgroup.map d4SixthGlueIsometry.toLinearEquiv.toAddEquiv.toAddMonoidHom := by
    rw [d4SixGlueSubgroup_def, AddSubgroup.closure_le]
    rintro _ ⟨d, hd, rfl⟩
    obtain ⟨w, hw⟩ := EquivLike.surjective d4SixthGlueIsometry
      fun j ↦ (D 4).glueLabelEquiv (isSimplyLaced_D 4) (d j)
    refine ⟨w, ?_, hw⟩
    rw [glueSubgroup_def]
    refine AddSubgroup.subset_closure (mem_glueGenerators_iff.mpr ?_)
    have hdigits : encodeGlueWord (fun _ : Fin 6 ↦ D 4) (fun _ ↦ isSimplyLaced_D 4)
        (fun j ↦ (D 4).glueLabelEquiv (isSimplyLaced_D 4) (d j)) =
          List.ofFn fun j ↦ (d j : ℕ) := by
      rw [eq_comm, ← decodeGlueWord_eq_some_iff, decodeGlueWord_ofFn _ _ _ fun j ↦ (d j).isLt]
    rw [← encodeGlueWord_d4SixthGlueIsometry, hw, hdigits]
    exact ofFn_mem_glueWords_d4Sixth d hd
  refine (AddSubgroup.eq_of_le_of_card_ge hle ?_).symm
  rw [natCard_d4SixGlueSubgroup,
    AddSubgroup.card_map_of_injective (EquivLike.injective d4SixthGlueIsometry),
    natCard_glueSubgroup]
  rfl

/-- A glue word of the row `D₄⁶` lies in the table glue subgroup exactly when its image under the
glue isometry lies in the printed glue subgroup. -/
theorem d4SixthGlueIsometry_mem_d4SixGlueSubgroup_iff (w : d4Sixth.glueModule) :
    d4SixthGlueIsometry w ∈ d4SixGlueSubgroup ↔ w ∈ d4Sixth.glueSubgroup := by
  rw [← map_glueSubgroup_d4Sixth, AddSubgroup.mem_map_equiv]
  simp

variable {F : Type*} [Field F] [Finite F] (hF : Nat.card F = 4) {ω : F} (hω : ω ^ 2 + ω + 1 = 0)

/-- **The table glue subgroup of `D₄⁶` is the hexacode**: a glue word of the row lies in the
subgroup generated `𝔽₄`-linearly by `[111111]` and `[0(02332)]` exactly when, read in the hexacode
coordinates of `TauCeti.d4SixHexacodeIsometry`, it is a word of the hexacode. -/
theorem mem_glueSubgroup_d4Sixth_iff (w : d4Sixth.glueModule) :
    w ∈ d4Sixth.glueSubgroup ↔
      d4SixHexacodeIsometry hF hω (d4SixthGlueIsometry w) ∈ Hexacode.code ω := by
  rw [← d4SixthGlueIsometry_mem_d4SixGlueSubgroup_iff, mem_d4SixGlueSubgroup_iff hF hω]

end RootfulNiemeierType

end TauCeti
