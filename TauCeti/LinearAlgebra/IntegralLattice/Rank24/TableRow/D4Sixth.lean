module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.IdentifiedRows

/-!
# The table row `D₄⁶` is glued along the hexacode

The row `D₄⁶` of the rootful rank-24 table, `TauCeti.RootfulNiemeierType.d4Sixth`, is the only row
with the `𝔽₄`-linear span mode: its glue subgroup `H` is generated by the decoded words
`[111111]` and `[0(02332)]` together with their multiples by `ω` and `ω²`, read through the
labelling `0, 1, 2, 3 ↦ 0, ω, 1, ω²` of the `D₄` labels.  The same subgroup is also constructed
directly, over the constant family `D₄` on `Fin 6`, as `TauCeti.d4SixGlueSubgroup`: the additive
closure of the six printed words and `[222222]`.  That subgroup has order `64`, is closed under
the scalars of `𝔽₄`, and is carried onto the hexacode by `TauCeti.d4SixHexacodeIsometry`.

The two subgroups agree by `TauCeti.RootfulNiemeierType.map_glueSubgroup_d4Sixth`, along
`TauCeti.RootfulNiemeierType.d4SixthGlueModuleIsometry` from
`TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.IdentifiedRows`. This file uses that
identification to show that a glue word of the row lies in `H` exactly when its hexacode
coordinates form a hexacode word (`TauCeti.RootfulNiemeierType.mem_glueSubgroup_d4Sixth_iff`).

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §7, and Chapter 16, §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType

/-- The row `D₄⁶` has six components. -/
@[simp]
theorem length_components_d4Sixth : d4Sixth.components.length = 6 :=
  List.length_replicate

/-- The glue isometry of the row `D₄⁶` keeps every Conway--Sloane digit. -/
@[simp]
theorem encodeGlueWord_d4SixthGlueModuleIsometry (w : d4Sixth.glueModule) :
    encodeGlueWord (fun _ : Fin 6 ↦ D 4) (fun _ ↦ isSimplyLaced_D 4)
        (d4SixthGlueModuleIsometry w) =
      encodeGlueWord d4Sixth.componentType d4Sixth.isSimplyLaced_componentType w :=
  encodeGlueWord_glueModuleIsometry _ _ _ _ w

variable {F : Type*} [Field F] [Finite F] (hF : Nat.card F = 4) {ω : F} (hω : ω ^ 2 + ω + 1 = 0)

/-- **The table glue subgroup of `D₄⁶` is the hexacode**: a glue word of the row lies in the
subgroup generated `𝔽₄`-linearly by `[111111]` and `[0(02332)]` exactly when, read in the hexacode
coordinates of `TauCeti.d4SixHexacodeIsometry`, it is a word of the hexacode. -/
theorem mem_glueSubgroup_d4Sixth_iff (w : d4Sixth.glueModule) :
    w ∈ d4Sixth.glueSubgroup ↔
      d4SixHexacodeIsometry hF hω (d4SixthGlueModuleIsometry w) ∈ Hexacode.code ω := by
  rw [← d4SixthGlueModuleIsometry_mem_d4SixGlueSubgroup_iff, mem_d4SixGlueSubgroup_iff hF hω]

end RootfulNiemeierType

end TauCeti
