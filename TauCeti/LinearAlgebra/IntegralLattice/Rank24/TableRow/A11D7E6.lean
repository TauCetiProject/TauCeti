module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.A11D7E6
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.IdentifiedRows
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Niemeier

/-!
# The table row `A₁₁ D₇ E₆` and its explicit norm-`4` glue generator

The row `A₁₁ D₇ E₆` of the rootful rank-24 table, `TauCeti.RootfulNiemeierType.a11d7e6`, glues the
orthogonal sum of its three mixed-type components along the cyclic subgroup `a11d7e6.glueSubgroup`
generated by the decoded Conway--Sloane word `[111]`.  The same mixed-alphabet Niemeier lattice is
constructed over the explicit component family `TauCeti.a11d7e6` on `Fin 3` as
`TauCeti.a11d7e6Lattice` in `TauCeti.LinearAlgebra.IntegralLattice.Rank24.A11D7E6`.

This file connects the uniform table lattice `a11d7e6.lattice` to `TauCeti.a11d7e6Lattice` and
transfers the explicit shortest glue generator `(ω₁, s, ϖ₁)` to the table row:

* Using `TauCeti.RootfulNiemeierType.map_glueSubgroup_a11d7e6`, a glue word of the row lies in
  `a11d7e6.glueSubgroup` exactly when its image under `a11d7e6GlueModuleIsometry` is one of the
  twelve multiples `k • a11d7e6GlueWord` (`k < 12`)
  (`TauCeti.RootfulNiemeierType.mem_glueSubgroup_a11d7e6_iff_exists_nsmul`).
* Combining the subgroup order `12` and the glue-minimum bound `μ(w) ≥ 4` from
  `TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.IdentifiedRows` with the general gluing
  theorems gives unimodularity (`TauCeti.RootfulNiemeierType.isUnimodular_a11d7e6_lattice`),
  preservation of all norm shells below `4`
  (`TauCeti.RootfulNiemeierType.image_vectorsOfNorm_a11d7e6_lattice_eq`), and literal recovery of
  the root sublattice `a11d7e6.rootLattice`
  (`TauCeti.RootfulNiemeierType.span_vectorsOfNorm_two_a11d7e6_lattice`).
* Naturality of gluing under equal families of components gives the coordinate-preserving isometry
  `TauCeti.RootfulNiemeierType.a11d7e6LatticeIsometry` from `a11d7e6.lattice` onto
  `TauCeti.a11d7e6Lattice`.
* Pulling `TauCeti.a11d7e6GlueVector` back along `a11d7e6LatticeIsometry` gives the explicit
  norm-`4` glue vector `TauCeti.RootfulNiemeierType.a11d7e6TableGlueVector` of `a11d7e6.lattice`,
  the generator description `TauCeti.RootfulNiemeierType.a11d7e6_lattice_carrier_eq_sup_span`, and
  the `12`-coset decomposition
  `TauCeti.RootfulNiemeierType.mem_a11d7e6_lattice_carrier_iff_exists_sub_mem` of the carrier.

## Main declarations

* `TauCeti.RootfulNiemeierType.a11d7e6GlueModuleIsometry_mem_a11d7e6GlueSubgroup_iff`,
  `TauCeti.RootfulNiemeierType.mem_glueSubgroup_a11d7e6_iff_exists_nsmul`,
  `TauCeti.RootfulNiemeierType.mem_a11d7e6_lattice_carrier_iff_exists_nsmul`: cyclic
  characterization of `a11d7e6.glueSubgroup` and `a11d7e6.lattice.carrier`.
* `TauCeti.RootfulNiemeierType.relIndex_a11d7e6_rootLattice_lattice`,
  `TauCeti.RootfulNiemeierType.isUnimodular_a11d7e6_lattice`,
  `TauCeti.RootfulNiemeierType.image_vectorsOfNorm_a11d7e6_lattice_eq`,
  `TauCeti.RootfulNiemeierType.span_vectorsOfNorm_two_a11d7e6_lattice`: index `12`, unimodularity,
  norm shells below `4`, and the root sublattice of `a11d7e6.lattice`.
* `TauCeti.RootfulNiemeierType.a11d7e6LatticeIsometry`: coordinate-preserving isometry onto
  `TauCeti.a11d7e6Lattice`, with `a11d7e6LatticeIsometry_apply`,
  `a11d7e6LatticeIsometry_symm_apply`, and `a11d7e6LatticeIsometry_mem_a11d7e6RootLattice_iff`.
* `TauCeti.RootfulNiemeierType.a11d7e6TableGlueVector`: the explicit norm-`4` glue generator of
  `a11d7e6.lattice`, with `form_a11d7e6TableGlueVector_self`,
  `a11d7e6_lattice_carrier_eq_sup_span`, and `mem_a11d7e6_lattice_carrier_iff_exists_sub_mem`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §§6--8, and Chapter 16, §1, Table 16.1.
* J. H. Conway and N. J. A. Sloane, *On the enumeration of lattices of determinant one*,
  Journal of Number Theory 15 (1982), Table V.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType IntegralLattice

/-! ### Cyclic characterization of the table glue subgroup -/

/-- A glue word of the row `A₁₁ D₇ E₆` lies in the table glue subgroup `a11d7e6.glueSubgroup`
exactly when its image under `a11d7e6GlueModuleIsometry` lies in `a11d7e6GlueSubgroup`. -/
theorem a11d7e6GlueModuleIsometry_mem_a11d7e6GlueSubgroup_iff (w : a11d7e6.glueModule) :
    a11d7e6GlueModuleIsometry w ∈ a11d7e6GlueSubgroup ↔ w ∈ a11d7e6.glueSubgroup := by
  rw [← map_glueSubgroup_a11d7e6]
  exact AddSubgroup.mem_map_equiv.trans
    (by rw [AddEquiv.symm_apply_apply a11d7e6GlueModuleIsometry.toAddEquiv w])

/-- **The table glue subgroup of `A₁₁ D₇ E₆` consists of the twelve multiples of `[111]`**: a glue
word of the row lies in `a11d7e6.glueSubgroup` exactly when its image under
`a11d7e6GlueModuleIsometry` has the form `k • a11d7e6GlueWord` with `k < 12`. -/
theorem mem_glueSubgroup_a11d7e6_iff_exists_nsmul (w : a11d7e6.glueModule) :
    w ∈ a11d7e6.glueSubgroup ↔ ∃ k < 12, k • a11d7e6GlueWord = a11d7e6GlueModuleIsometry w := by
  rw [← a11d7e6GlueModuleIsometry_mem_a11d7e6GlueSubgroup_iff, mem_a11d7e6GlueSubgroup_iff]

/-- **The carrier of `a11d7e6.lattice` via glue words**: a vector lies in the table lattice of
`A₁₁ D₇ E₆` exactly when it lies in the dual of `a11d7e6.rootLattice` and its discriminant glue
word, transported by `a11d7e6GlueModuleIsometry`, is one of the twelve multiples
`k • a11d7e6GlueWord` (`k < 12`). -/
theorem mem_a11d7e6_lattice_carrier_iff_exists_nsmul
    (x : ∀ i, Fin (a11d7e6.componentType i).rank → ℚ) :
    x ∈ a11d7e6.lattice.carrier ↔ ∃ hx : x ∈ a11d7e6.rootLattice.dualCarrier,
      ∃ k < 12, k • a11d7e6GlueWord = a11d7e6GlueModuleIsometry
        ((DynkinType.glueWordIsometry a11d7e6.componentType a11d7e6.isSimplyLaced_componentType
          a11d7e6.valid_componentType).toAddEquiv.symm
            (Submodule.Quotient.mk ⟨x, hx⟩)) :=
  (a11d7e6.mem_lattice_carrier_iff x).trans
    (exists_congr fun _ ↦ mem_glueSubgroup_a11d7e6_iff_exists_nsmul _)

/-! ### Index, unimodularity, and root sublattice of `a11d7e6.lattice` -/

/-- **The root sublattice `a11d7e6.rootLattice` has index `12` in `a11d7e6.lattice`.** -/
theorem relIndex_a11d7e6_rootLattice_lattice :
    a11d7e6.rootLattice.carrier.toAddSubgroup.relIndex a11d7e6.lattice.carrier.toAddSubgroup =
      12 :=
  a11d7e6.relIndex_rootLattice_lattice.trans natCard_glueSubgroup_a11d7e6

/-- **The table lattice `a11d7e6.lattice` is unimodular.** -/
theorem isUnimodular_a11d7e6_lattice : a11d7e6.lattice.IsUnimodular :=
  (isUnimodular_lattice_iff a11d7e6).mpr natCard_glueSubgroup_a11d7e6

/-- **Gluing along the table subgroup of `A₁₁ D₇ E₆` adds no vectors of norm less than `4`**,
compared in the common ambient space.  In particular the norm-`2` vectors of `a11d7e6.lattice` are
exactly the norm-`2` vectors of `a11d7e6.rootLattice`. -/
theorem image_vectorsOfNorm_a11d7e6_lattice_eq {n : ℚ} (hn : n < 4) :
    (fun x : a11d7e6.lattice ↦ (x : ∀ i, Fin (a11d7e6.componentType i).rank → ℚ)) ''
        a11d7e6.lattice.vectorsOfNorm n =
      (fun x : a11d7e6.rootLattice ↦ (x : ∀ i, Fin (a11d7e6.componentType i).rank → ℚ)) ''
        a11d7e6.rootLattice.vectorsOfNorm n := by
  rw [lattice_def]
  exact DynkinType.image_vectorsOfNorm_gluedLattice_eq _ _ a11d7e6.valid_componentType _ _
    (fun _ hw hw0 ↦ four_le_sum_glueMinimum_of_mem_glueSubgroup_a11d7e6 hw hw0) hn

/-- **The root sublattice of `a11d7e6.lattice` is `a11d7e6.rootLattice`**: the norm-`2` vectors of
the table lattice span the carrier of the orthogonal sum of its `A₁₁`, `D₇`, and `E₆` root
lattices. -/
theorem span_vectorsOfNorm_two_a11d7e6_lattice :
    Submodule.span ℤ
        ((fun x : a11d7e6.lattice ↦ (x : ∀ i, Fin (a11d7e6.componentType i).rank → ℚ)) ''
          a11d7e6.lattice.vectorsOfNorm 2) =
      a11d7e6.rootLattice.carrier := by
  rw [lattice_def]
  exact DynkinType.span_vectorsOfNorm_two_gluedLattice _ _ a11d7e6.valid_componentType _ _
    (fun _ hw hw0 ↦ four_le_sum_glueMinimum_of_mem_glueSubgroup_a11d7e6 hw hw0) (by norm_num)

/-! ### Comparison of the table lattice with `TauCeti.a11d7e6Lattice` -/

/-- Reindexing glue words of `a11d7e6` by `piGlueAlphabetCongr` agrees with
`a11d7e6GlueModuleIsometry`, since both preserve every Conway--Sloane digit. -/
private theorem piGlueAlphabetCongr_eq_a11d7e6GlueModuleIsometry (w : a11d7e6.glueModule) :
    piGlueAlphabetCongr a11d7e6.componentType a11d7e6.isSimplyLaced_componentType
        (finCongr (rfl : 3 = a11d7e6.components.length)) (fun i ↦ componentType_a11d7e6 i) w =
      a11d7e6GlueModuleIsometry w :=
  encodeGlueWord_injective _ _ <|
    (encodeGlueWord_piGlueAlphabetCongr _ _ _ _ _ w).trans
      (encodeGlueWord_glueModuleIsometry _ _ _ _ w).symm

private theorem piGlueAlphabetCongr_mem_a11d7e6GlueSubgroup_iff (w : a11d7e6.glueModule) :
    piGlueAlphabetCongr a11d7e6.componentType a11d7e6.isSimplyLaced_componentType
        (finCongr (rfl : 3 = a11d7e6.components.length)) (fun i ↦ componentType_a11d7e6 i) w ∈
      a11d7e6GlueSubgroup ↔ w ∈ a11d7e6.glueSubgroup := by
  rw [piGlueAlphabetCongr_eq_a11d7e6GlueModuleIsometry,
    a11d7e6GlueModuleIsometry_mem_a11d7e6GlueSubgroup_iff]

/-- **The table lattice of `A₁₁ D₇ E₆` is `TauCeti.a11d7e6Lattice`**, by the coordinate-preserving
isometry identifying the three components of the row with `TauCeti.a11d7e6`. -/
noncomputable def a11d7e6LatticeIsometry : Isometry a11d7e6.lattice TauCeti.a11d7e6Lattice :=
  (Isometry.ofEq (lattice_def _)).trans <|
    (gluedLatticeIsometryOfEq _ _ _ _ _ _ _ _ _
      piGlueAlphabetCongr_mem_a11d7e6GlueSubgroup_iff).trans
    (Isometry.ofEq a11d7e6Lattice_def.symm)

/-- `a11d7e6LatticeIsometry` keeps every simple-root coordinate, up to the identification of each
component Dynkin type with `TauCeti.a11d7e6 k`. -/
@[simp]
theorem a11d7e6LatticeIsometry_apply
    (x : ∀ i, Fin (a11d7e6.componentType i).rank → ℚ) (k : Fin 3)
    (j : Fin (TauCeti.a11d7e6 k).rank) :
    a11d7e6LatticeIsometry x k j =
      x k (Fin.cast (congrArg rank (componentType_a11d7e6 k)).symm j) := by
  rw [a11d7e6LatticeIsometry, Isometry.trans_apply, Isometry.trans_apply, Isometry.ofEq_apply,
    Isometry.ofEq_apply]
  exact gluedLatticeIsometryOfEq_apply (s := TauCeti.a11d7e6) _ _ _ _ _ _ _ _ _ _ x k j

/-- The inverse of `a11d7e6LatticeIsometry` keeps every simple-root coordinate, up to the
identification of each component Dynkin type with `TauCeti.a11d7e6 k`. -/
@[simp]
theorem a11d7e6LatticeIsometry_symm_apply
    (y : ∀ k, Fin (TauCeti.a11d7e6 k).rank → ℚ) (k : Fin a11d7e6.components.length)
    (j : Fin (a11d7e6.componentType k).rank) :
    a11d7e6LatticeIsometry.symm y k j =
      y k (Fin.cast (congrArg rank (componentType_a11d7e6 k)) j) := by
  have h := a11d7e6LatticeIsometry_apply (a11d7e6LatticeIsometry.symm y) k
    (Fin.cast (congrArg rank (componentType_a11d7e6 k)) j)
  rw [Isometry.apply_symm_apply, Fin.cast_cast, Fin.cast_refl] at h
  exact h.symm

/-- `a11d7e6LatticeIsometry` restricts on ambient vectors to the root sublattices: an ambient
vector maps into `TauCeti.a11d7e6RootLattice` exactly when it lies in `a11d7e6.rootLattice`. -/
theorem a11d7e6LatticeIsometry_mem_a11d7e6RootLattice_iff
    (x : ∀ i, Fin (a11d7e6.componentType i).rank → ℚ) :
    a11d7e6LatticeIsometry x ∈ TauCeti.a11d7e6RootLattice.carrier ↔
      x ∈ a11d7e6.rootLattice.carrier := by
  simp only [mem_pi_carrier_iff, mem_rootLattice_carrier_iff, a11d7e6LatticeIsometry_apply]
  refine ⟨fun h i j ↦ ?_, fun h k j ↦ h k _⟩
  simpa only [Fin.cast_cast, Fin.cast_refl, id_eq] using
    h i (Fin.cast (congrArg rank (componentType_a11d7e6 i)) j)

/-! ### Explicit glue generator and coset decomposition of `a11d7e6.lattice` -/

/-- **The explicit norm-`4` glue generator of the table lattice `a11d7e6.lattice`**, obtained by
pulling `TauCeti.a11d7e6GlueVector` back along `a11d7e6LatticeIsometry`. -/
noncomputable def a11d7e6TableGlueVector : ∀ i, Fin (a11d7e6.componentType i).rank → ℚ :=
  a11d7e6LatticeIsometry.symm TauCeti.a11d7e6GlueVector

/-- `a11d7e6LatticeIsometry.symm` sends `TauCeti.a11d7e6GlueVector` to `a11d7e6TableGlueVector`. -/
@[simp]
theorem a11d7e6LatticeIsometry_symm_a11d7e6GlueVector :
    a11d7e6LatticeIsometry.symm TauCeti.a11d7e6GlueVector = a11d7e6TableGlueVector :=
  (rfl)

/-- `a11d7e6LatticeIsometry` sends `a11d7e6TableGlueVector` to `TauCeti.a11d7e6GlueVector`. -/
@[simp]
theorem a11d7e6LatticeIsometry_a11d7e6TableGlueVector :
    a11d7e6LatticeIsometry a11d7e6TableGlueVector = TauCeti.a11d7e6GlueVector :=
  a11d7e6LatticeIsometry.apply_symm_apply _

/-- Each coordinate of `a11d7e6TableGlueVector` is the corresponding coordinate of
`TauCeti.a11d7e6GlueVector`. -/
@[simp]
theorem a11d7e6TableGlueVector_apply (k : Fin a11d7e6.components.length)
    (j : Fin (a11d7e6.componentType k).rank) :
    a11d7e6TableGlueVector k j =
      TauCeti.a11d7e6GlueVector k (Fin.cast (congrArg rank (componentType_a11d7e6 k)) j) :=
  a11d7e6LatticeIsometry_symm_apply _ k j

/-- **The table glue generator `a11d7e6TableGlueVector` has norm `4`.** -/
theorem form_a11d7e6TableGlueVector_self :
    a11d7e6.lattice.form a11d7e6TableGlueVector a11d7e6TableGlueVector = 4 := by
  rw [← a11d7e6LatticeIsometry.map_app, a11d7e6LatticeIsometry_a11d7e6TableGlueVector,
    form_a11d7e6GlueVector_self]

/-- **The table glue generator `a11d7e6TableGlueVector` belongs to `a11d7e6.lattice`.** -/
theorem a11d7e6TableGlueVector_mem_lattice :
    a11d7e6TableGlueVector ∈ a11d7e6.lattice.carrier := by
  rw [← a11d7e6LatticeIsometry.apply_mem_carrier_iff,
    a11d7e6LatticeIsometry_a11d7e6TableGlueVector]
  exact a11d7e6GlueVector_mem_a11d7e6Lattice

/-- A multiple `k • a11d7e6TableGlueVector` lies in `a11d7e6.rootLattice` exactly when `12`
divides `k`. -/
theorem nsmul_a11d7e6TableGlueVector_mem_rootLattice_iff (k : ℕ) :
    k • a11d7e6TableGlueVector ∈ a11d7e6.rootLattice.carrier ↔ 12 ∣ k := by
  rw [← a11d7e6LatticeIsometry_mem_a11d7e6RootLattice_iff, map_nsmul,
    a11d7e6LatticeIsometry_a11d7e6TableGlueVector,
    nsmul_a11d7e6GlueVector_mem_a11d7e6RootLattice_iff]

/-- An integer multiple `k • a11d7e6TableGlueVector` lies in `a11d7e6.rootLattice` exactly when
`12` divides `k`. -/
theorem zsmul_a11d7e6TableGlueVector_mem_rootLattice_iff (k : ℤ) :
    k • a11d7e6TableGlueVector ∈ a11d7e6.rootLattice.carrier ↔ (12 : ℤ) ∣ k := by
  rw [← a11d7e6LatticeIsometry_mem_a11d7e6RootLattice_iff, map_zsmul,
    a11d7e6LatticeIsometry_a11d7e6TableGlueVector,
    zsmul_a11d7e6GlueVector_mem_a11d7e6RootLattice_iff]

/-- **Coset decomposition of `a11d7e6.lattice`**: a vector lies in the table lattice of
`A₁₁ D₇ E₆` exactly when it differs from one of the twelve multiples `k • a11d7e6TableGlueVector`
(`k < 12`) by a vector of `a11d7e6.rootLattice`. -/
theorem mem_a11d7e6_lattice_carrier_iff_exists_sub_mem
    (x : ∀ i, Fin (a11d7e6.componentType i).rank → ℚ) :
    x ∈ a11d7e6.lattice.carrier ↔
      ∃ k < 12, x - k • a11d7e6TableGlueVector ∈ a11d7e6.rootLattice.carrier := by
  rw [← a11d7e6LatticeIsometry.apply_mem_carrier_iff,
    mem_a11d7e6Lattice_carrier_iff_exists_sub_mem]
  refine exists_congr fun k ↦ and_congr_right fun _ ↦ ?_
  rw [← a11d7e6LatticeIsometry_mem_a11d7e6RootLattice_iff, map_sub, map_nsmul,
    a11d7e6LatticeIsometry_a11d7e6TableGlueVector]

/-- **Generators of `a11d7e6.lattice`**: the table lattice of `A₁₁ D₇ E₆` is spanned over `ℤ` by
`a11d7e6.rootLattice` and the single norm-`4` glue vector `a11d7e6TableGlueVector`. -/
theorem a11d7e6_lattice_carrier_eq_sup_span :
    a11d7e6.lattice.carrier =
      a11d7e6.rootLattice.carrier ⊔ Submodule.span ℤ {a11d7e6TableGlueVector} := by
  refine le_antisymm (fun x hx ↦ ?_) (sup_le a11d7e6.rootLattice_carrier_le_lattice_carrier
    ((Submodule.span_singleton_le_iff_mem _ _).mpr a11d7e6TableGlueVector_mem_lattice))
  obtain ⟨k, -, hmem⟩ := (mem_a11d7e6_lattice_carrier_iff_exists_sub_mem x).mp hx
  have hspan : k • a11d7e6TableGlueVector ∈
      Submodule.span ℤ ({a11d7e6TableGlueVector} : Set _) := by
    rw [← natCast_zsmul]
    exact Submodule.smul_mem _ (k : ℤ) (Submodule.subset_span rfl)
  exact sub_add_cancel x (k • a11d7e6TableGlueVector) ▸
    add_mem (Submodule.mem_sup_left hmem) (Submodule.mem_sup_right hspan)

end RootfulNiemeierType

end TauCeti
