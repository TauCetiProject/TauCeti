module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.IdentifiedRows

/-!
# The mixed table row `A₁₁ D₇ E₆`

`TauCeti.RootfulNiemeierType.a11d7e6LatticeIsometry` identifies the uniform table lattice
`TauCeti.RootfulNiemeierType.a11d7e6.lattice` with `TauCeti.a11d7e6Lattice`, constructed by
gluing the ordered family `A₁₁`, `D₇`, `E₆` along the cyclic subgroup generated by `[111]`.
It keeps every simple-root coordinate; the forward and inverse formulas make the identification
usable without unfolding either gluing construction.

The carrier criterion `TauCeti.RootfulNiemeierType.mem_lattice_carrier_a11d7e6_iff` describes
the table lattice directly: a vector is in the dual root lattice and its glue word, in the
explicit family's coordinates, is one of the twelve multiples of `[111]`. These multiples
simultaneously read modulo `12`, `4`, and `3` in the three component alphabets.

The comparison uses `map_glueSubgroup_a11d7e6` and the naturality of isotropic gluing under equal
families of components (`TauCeti.DynkinType.gluedLatticeIsometryOfEq`).

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed.,
  Chapter 4 §3 and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti.RootfulNiemeierType

open DynkinType IntegralLattice

/-- The mixed row has three components. -/
@[simp]
theorem length_components_a11d7e6 : a11d7e6.components.length = 3 :=
  (rfl)

private theorem a11d7e6GlueModuleIsometry_eq (w : a11d7e6.glueModule) :
    a11d7e6GlueModuleIsometry w = piGlueAlphabetCongr a11d7e6.componentType
      a11d7e6.isSimplyLaced_componentType (finCongr rfl) componentType_a11d7e6 w := by
  apply encodeGlueWord_injective TauCeti.a11d7e6 isSimplyLaced_a11d7e6
  exact (encodeGlueWord_glueModuleIsometry _ _ _ _ w).trans
    (encodeGlueWord_piGlueAlphabetCongr _ _ _ rfl componentType_a11d7e6 w).symm

private theorem a11d7e6GlueModuleIsometry_mem_iff (w : a11d7e6.glueModule) :
    a11d7e6GlueModuleIsometry w ∈ a11d7e6GlueSubgroup ↔ w ∈ a11d7e6.glueSubgroup := by
  rw [← map_glueSubgroup_a11d7e6]
  exact AddSubgroup.mem_map_iff_mem a11d7e6GlueModuleIsometry.injective

/-- A table glue word of `A₁₁ D₇ E₆` lies in the glue subgroup exactly when, in the explicit
component coordinates, it is one of the twelve multiples of `[111]`. -/
theorem mem_glueSubgroup_a11d7e6_iff (w : a11d7e6.glueModule) :
    w ∈ a11d7e6.glueSubgroup ↔
      ∃ k < 12, k • a11d7e6GlueWord = a11d7e6GlueModuleIsometry w := by
  rw [← a11d7e6GlueModuleIsometry_mem_iff, mem_a11d7e6GlueSubgroup_iff]

/-- The table lattice `A₁₁ D₇ E₆` is the lattice glued from the explicit ordered family along
`[111]`. The isometry keeps all simple-root coordinates. -/
noncomputable def a11d7e6LatticeIsometry :
    IntegralLattice.Isometry a11d7e6.lattice a11d7e6Lattice :=
  (Isometry.ofEq (lattice_def _)).trans <|
    (gluedLatticeIsometryOfEq a11d7e6.componentType a11d7e6.isSimplyLaced_componentType
      a11d7e6.valid_componentType a11d7e6.glueSubgroup a11d7e6.isIsotropic_glueSubgroup
      valid_a11d7e6 isIsotropic_a11d7e6GlueSubgroup (finCongr rfl) componentType_a11d7e6
      fun w ↦ (a11d7e6GlueModuleIsometry_eq w) ▸ a11d7e6GlueModuleIsometry_mem_iff w).trans
    (Isometry.ofEq a11d7e6Lattice_def.symm)

/-- The comparison reads component `k` and node `j` in the same positions in the table. -/
@[simp]
theorem a11d7e6LatticeIsometry_apply
    (x : ∀ i, Fin (a11d7e6.componentType i).rank → ℚ)
    (k : Fin 3) (j : Fin (TauCeti.a11d7e6 k).rank) :
    a11d7e6LatticeIsometry x k j =
      x (Fin.cast length_components_a11d7e6.symm k)
        (Fin.cast (congrArg rank (componentType_a11d7e6 _)).symm j) := by
  rw [a11d7e6LatticeIsometry, Isometry.trans_apply, Isometry.trans_apply,
    Isometry.ofEq_apply, Isometry.ofEq_apply]
  exact gluedLatticeIsometryOfEq_apply _ _ _ _ _ _ _ _ _ _ x k j

/-- The inverse comparison also keeps each component and simple-root coordinate. -/
@[simp]
theorem a11d7e6LatticeIsometry_symm_apply
    (x : ∀ i, Fin (TauCeti.a11d7e6 i).rank → ℚ)
    (k : Fin a11d7e6.components.length) (j : Fin (a11d7e6.componentType k).rank) :
    a11d7e6LatticeIsometry.symm x k j =
      x (Fin.cast length_components_a11d7e6 k)
        (Fin.cast (congrArg rank (componentType_a11d7e6 k)) j) := by
  calc
    a11d7e6LatticeIsometry.symm x k j =
        a11d7e6LatticeIsometry (a11d7e6LatticeIsometry.symm x)
          (Fin.cast length_components_a11d7e6 k)
          (Fin.cast (congrArg rank (componentType_a11d7e6 k)) j) := by
      -- Both the component cast and the node cast cancel in the round trip.
      refine Eq.trans ?_ (a11d7e6LatticeIsometry_apply (a11d7e6LatticeIsometry.symm x)
          (Fin.cast length_components_a11d7e6 k)
          (Fin.cast (congrArg rank (componentType_a11d7e6 k)) j)).symm
      congr 2
    _ = x (Fin.cast length_components_a11d7e6 k)
        (Fin.cast (congrArg rank (componentType_a11d7e6 k)) j) :=
      congrFun (congrFun (a11d7e6LatticeIsometry.apply_symm_apply x)
        (Fin.cast length_components_a11d7e6 k)) _

/-- A vector belongs to the table lattice `A₁₁ D₇ E₆` exactly when it belongs to the dual root
lattice and its glue word in the explicit family is one of `0, [111], …, 11 • [111]`. -/
theorem mem_lattice_carrier_a11d7e6_iff
    (x : ∀ i, Fin (a11d7e6.componentType i).rank → ℚ) :
    x ∈ a11d7e6.lattice.carrier ↔ ∃ hx : x ∈ a11d7e6.rootLattice.dualCarrier,
      ∃ k < 12, k • a11d7e6GlueWord = a11d7e6GlueModuleIsometry
        ((glueWordIsometry a11d7e6.componentType a11d7e6.isSimplyLaced_componentType
          a11d7e6.valid_componentType).toAddEquiv.symm (Submodule.Quotient.mk ⟨x, hx⟩)) := by
  rw [mem_lattice_carrier_iff]
  exact exists_congr fun hx ↦ mem_glueSubgroup_a11d7e6_iff _

end TauCeti.RootfulNiemeierType
