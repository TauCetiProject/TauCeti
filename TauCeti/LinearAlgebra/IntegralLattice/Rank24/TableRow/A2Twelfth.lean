module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.IdentifiedRows

/-!
# The table row `A₂¹²` is the ternary Golay gluing of `(A₂)¹²`

The row `A₂¹²` of the rootful rank-24 table, `TauCeti.RootfulNiemeierType.a2Twelfth`, glues the
orthogonal sum `a2Twelfth.rootLattice` of its twelve `A₂` components, read off by position from its
component list, along the subgroup `a2Twelfth.glueSubgroup` generated by the decoded Conway--Sloane
pattern `[2(11211122212)]`.  The same row is also constructed directly in
`TauCeti.LinearAlgebra.IntegralLattice.Rank24.A2Twelfth`, as the lattice `TauCeti.a2TwelfthLattice`
glued from the constant family `A₂` on `Fin 12` along `TauCeti.a2TwelfthGlueSubgroup`, which is
identified with the extended ternary Golay code `TauCeti.TernaryGolay.code` by the signed
coordinate change `TauCeti.a2TwelfthGolayIsometry`.  This file connects the uniform table lattice
`a2Twelfth.lattice` to `TauCeti.a2TwelfthLattice` and to the ternary Golay gluing of the
simple-root coordinate power `(A₂)¹²`.

At the level of glue words, `TauCeti.RootfulNiemeierType.map_glueSubgroup_a2Twelfth` identifies
`a2Twelfth.glueSubgroup` with `TauCeti.a2TwelfthGlueSubgroup` via
`TauCeti.RootfulNiemeierType.a2TwelfthGlueModuleIsometry`, so a glue word of the row lies in
`a2Twelfth.glueSubgroup` precisely when its image in Golay coordinates belongs to
`TauCeti.TernaryGolay.code` (`mem_glueSubgroup_a2Twelfth_iff_ternaryGolay`).  Transporting the
order `729` and minimum-norm bound `μ(w) ≥ 4` gives the index `729` of `a2Twelfth.rootLattice` in
`a2Twelfth.lattice`, unimodularity of `a2Twelfth.lattice`, agreement of low-norm shells (`< 4`)
with `a2Twelfth.rootLattice`, and equality of the root sublattice of `a2Twelfth.lattice` with
`a2Twelfth.rootLattice.carrier`.

At the level of lattices, naturality of gluing under equal families of components produces the
coordinate-preserving isometry `a2TwelfthLatticeIsometry` from `a2Twelfth.lattice` onto
`TauCeti.a2TwelfthLattice`.  Composing with `TauCeti.a2TwelfthTernaryGolayIsometry` recovers
`a2Twelfth.lattice` as the overlattice of `(A₂)¹²` glued along the extended ternary Golay code
(`a2TwelfthLatticeTernaryGolayIsometry`): in Golay coordinate `j : Fin 12`, the image of `x` is the
sign `TauCeti.a2TwelfthSign j` times the component of `x` at table position
`TauCeti.a2TwelfthDestinationToSource j`, with explicit inverse formula and compatibility with the
root sublattices.

## Main declarations

* `TauCeti.RootfulNiemeierType.length_components_a2Twelfth`: the row `A₂¹²` has `12` components.
* `TauCeti.RootfulNiemeierType.a2TwelfthGlueModuleIsometry_mem_a2TwelfthGlueSubgroup_iff`,
  `TauCeti.RootfulNiemeierType.mem_glueSubgroup_a2Twelfth_iff_ternaryGolay`: membership in the
  table glue subgroup via `TauCeti.a2TwelfthGlueSubgroup` and `TauCeti.TernaryGolay.code`.
* `TauCeti.RootfulNiemeierType.relIndex_rootLattice_a2Twelfth_lattice`,
  `TauCeti.RootfulNiemeierType.isUnimodular_a2Twelfth_lattice`,
  `TauCeti.RootfulNiemeierType.image_vectorsOfNorm_a2Twelfth_lattice_eq`,
  `TauCeti.RootfulNiemeierType.span_vectorsOfNorm_two_a2Twelfth_lattice`,
  `TauCeti.RootfulNiemeierType.mem_a2Twelfth_lattice_carrier_iff_ternaryGolay`: structural
  properties and Golay carrier description of `a2Twelfth.lattice`.
* `TauCeti.RootfulNiemeierType.a2TwelfthLatticeIsometry`: the isometry from `a2Twelfth.lattice`
  onto `TauCeti.a2TwelfthLattice`, with `a2TwelfthLatticeIsometry_apply`,
  `a2TwelfthLatticeIsometry_symm_apply`, and `map_rootLattice_carrier_a2TwelfthLatticeIsometry`.
* `TauCeti.RootfulNiemeierType.a2TwelfthLatticeTernaryGolayIsometry`: the isometry from
  `a2Twelfth.lattice` onto the ternary Golay gluing of `(A₂)¹²`, with
  `a2TwelfthLatticeTernaryGolayIsometry_def`, `a2TwelfthLatticeTernaryGolayIsometry_apply`,
  `a2TwelfthLatticeTernaryGolayIsometry_symm_apply`, and
  `map_rootLattice_carrier_a2TwelfthLatticeTernaryGolayIsometry`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §§3 and 6, Chapter 7, §8, and Chapter 16, §1, Table 16.1.
* W. C. Huffman and V. Pless, *Fundamentals of Error-Correcting Codes* (2003), §1.9.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType IntegralLattice

/-! ### The components and glue subgroup of the row -/

/-- The row `A₂¹²` has twelve components. -/
@[simp]
theorem length_components_a2Twelfth : a2Twelfth.components.length = 12 :=
  List.length_replicate

/-- A glue word of the row `A₂¹²` lies in the table glue subgroup if and only if its image in the
constant `A₂` alphabets lies in `TauCeti.a2TwelfthGlueSubgroup`. -/
@[simp]
theorem a2TwelfthGlueModuleIsometry_mem_a2TwelfthGlueSubgroup_iff (w : a2Twelfth.glueModule) :
    a2TwelfthGlueModuleIsometry w ∈ a2TwelfthGlueSubgroup ↔ w ∈ a2Twelfth.glueSubgroup :=
  (iff_of_eq (congrArg (a2TwelfthGlueModuleIsometry w ∈ ·) map_glueSubgroup_a2Twelfth.symm)).trans
    (AddSubgroup.mem_map_iff_mem a2TwelfthGlueModuleIsometry.toAddEquiv.injective)

/-- **The table glue subgroup of `A₂¹²` is the extended ternary Golay code**: a glue word of the
row lies in the subgroup generated by `[2(11211122212)]` if and only if its image under
`TauCeti.a2TwelfthGolayIsometry` (after reading the row's components as twelve copies of `A₂`) is a
codeword of `TauCeti.TernaryGolay.code`. -/
theorem mem_glueSubgroup_a2Twelfth_iff_ternaryGolay (w : a2Twelfth.glueModule) :
    w ∈ a2Twelfth.glueSubgroup ↔
      a2TwelfthGolayIsometry (a2TwelfthGlueModuleIsometry w) ∈ TernaryGolay.code := by
  rw [← a2TwelfthGlueModuleIsometry_mem_a2TwelfthGlueSubgroup_iff, mem_a2TwelfthGlueSubgroup_iff]

/-! ### Invariants, norm shells and carrier of the table lattice -/

/-- **The root lattice of `A₂¹²` has index `729` in the table lattice**, the order of the extended
ternary Golay code. -/
theorem relIndex_rootLattice_a2Twelfth_lattice :
    a2Twelfth.rootLattice.carrier.toAddSubgroup.relIndex a2Twelfth.lattice.carrier.toAddSubgroup =
      729 :=
  (a2Twelfth.relIndex_rootLattice_lattice).trans natCard_glueSubgroup_a2Twelfth

/-- **The table lattice of `A₂¹²` is unimodular.** -/
theorem isUnimodular_a2Twelfth_lattice : a2Twelfth.lattice.IsUnimodular :=
  (isUnimodular_lattice_iff a2Twelfth).mpr natCard_glueSubgroup_a2Twelfth

/-- **Gluing adds no vectors of norm strictly below `4`**: for every `m < 4`, the norm-`m` vectors
of `a2Twelfth.lattice` coincide with those of `a2Twelfth.rootLattice` in the common ambient space,
since every nonzero glue word of the row has glue minimum at least `4`. -/
theorem image_vectorsOfNorm_a2Twelfth_lattice_eq {m : ℚ} (hm : m < 4) :
    (fun x : a2Twelfth.lattice ↦ (x : ∀ i, Fin (a2Twelfth.componentType i).rank → ℚ)) ''
        a2Twelfth.lattice.vectorsOfNorm m =
      (fun x : a2Twelfth.rootLattice ↦ (x : ∀ i, Fin (a2Twelfth.componentType i).rank → ℚ)) ''
        a2Twelfth.rootLattice.vectorsOfNorm m := by
  rw [lattice_def]
  exact DynkinType.image_vectorsOfNorm_gluedLattice_eq _ _ a2Twelfth.valid_componentType _ _
    (fun _ hw hw0 ↦ four_le_sum_glueMinimum_of_mem_glueSubgroup_a2Twelfth hw hw0) hm

/-- **The root sublattice of `a2Twelfth.lattice` is `a2Twelfth.rootLattice`**: the norm-`2` vectors
of the table lattice span the carrier of the orthogonal sum of its twelve `A₂` root lattices. -/
theorem span_vectorsOfNorm_two_a2Twelfth_lattice :
    Submodule.span ℤ ((fun x : a2Twelfth.lattice ↦
        (x : ∀ i, Fin (a2Twelfth.componentType i).rank → ℚ)) ''
      a2Twelfth.lattice.vectorsOfNorm 2) = a2Twelfth.rootLattice.carrier := by
  rw [lattice_def]
  exact DynkinType.span_vectorsOfNorm_two_gluedLattice _ _ a2Twelfth.valid_componentType _ _
    (fun _ hw hw0 ↦ four_le_sum_glueMinimum_of_mem_glueSubgroup_a2Twelfth hw hw0) (by norm_num)

/-- **The carrier of the table lattice `A₂¹²` in Golay coordinates**: an ambient vector lies in
`a2Twelfth.lattice` if and only if it lies in the dual of `a2Twelfth.rootLattice` and the glue word
of its discriminant class maps into `TauCeti.TernaryGolay.code`. -/
theorem mem_a2Twelfth_lattice_carrier_iff_ternaryGolay
    (x : ∀ i, Fin (a2Twelfth.componentType i).rank → ℚ) :
    x ∈ a2Twelfth.lattice.carrier ↔ ∃ hx : x ∈ a2Twelfth.rootLattice.dualCarrier,
      a2TwelfthGolayIsometry (a2TwelfthGlueModuleIsometry
        ((DynkinType.glueWordIsometry a2Twelfth.componentType
            a2Twelfth.isSimplyLaced_componentType a2Twelfth.valid_componentType).toAddEquiv.symm
          (Submodule.Quotient.mk ⟨x, hx⟩))) ∈ TernaryGolay.code :=
  (a2Twelfth.mem_lattice_carrier_iff x).trans
    (exists_congr fun _ ↦ mem_glueSubgroup_a2Twelfth_iff_ternaryGolay _)

/-! ### Comparison with `TauCeti.a2TwelfthLattice` and the ternary Golay gluing of `(A₂)¹²` -/

private theorem piGlueAlphabetCongr_eq_a2TwelfthGlueModuleIsometry (w : a2Twelfth.glueModule) :
    piGlueAlphabetCongr a2Twelfth.componentType a2Twelfth.isSimplyLaced_componentType
        (finCongr length_components_a2Twelfth.symm)
        (fun _ ↦ componentType_a2Twelfth _) w =
      a2TwelfthGlueModuleIsometry w :=
  encodeGlueWord_injective _ _ <|
    (encodeGlueWord_piGlueAlphabetCongr _ _ _ _ _ w).trans
      (encodeGlueWord_glueModuleIsometry _ _ _ _ w).symm

private theorem piGlueAlphabetCongr_mem_a2TwelfthGlueSubgroup_iff (w : a2Twelfth.glueModule) :
    piGlueAlphabetCongr a2Twelfth.componentType a2Twelfth.isSimplyLaced_componentType
        (finCongr length_components_a2Twelfth.symm)
        (fun _ ↦ componentType_a2Twelfth _) w ∈ a2TwelfthGlueSubgroup ↔
      w ∈ a2Twelfth.glueSubgroup := by
  rw [piGlueAlphabetCongr_eq_a2TwelfthGlueModuleIsometry,
    a2TwelfthGlueModuleIsometry_mem_a2TwelfthGlueSubgroup_iff]

private theorem a2TwelfthLattice_eq_gluedLattice :
    TauCeti.a2TwelfthLattice =
      gluedLattice (fun _ : Fin 12 ↦ A 2) (fun _ ↦ isSimplyLaced_A 2)
        (fun _ ↦ valid_A.mpr one_le_two) a2TwelfthGlueSubgroup
        isLagrangian_a2TwelfthGlueSubgroup.isIsotropic := by
  refine IntegralLattice.ext (Submodule.ext fun x ↦ ?_)
    (a2TwelfthLattice_form.trans (gluedLattice_form _ _ _ _ _).symm)
  exact (mem_a2TwelfthLattice_carrier_iff x).trans <|
    (exists_congr fun _ ↦ mem_a2TwelfthGlueSubgroup_iff.symm).trans
      (mem_gluedLattice_carrier_iff _ _ _ _ _ x).symm

/-- **The table lattice of `A₂¹²` is the Golay-glued lattice `TauCeti.a2TwelfthLattice`**, by the
isometry keeping every coordinate: component `k : Fin 12` of the image is component `k` of the
source, read as a vector of the `A₂` root lattice. -/
noncomputable def a2TwelfthLatticeIsometry :
    IntegralLattice.Isometry a2Twelfth.lattice TauCeti.a2TwelfthLattice :=
  (Isometry.ofEq (lattice_def _)).trans <|
    (gluedLatticeIsometryOfEq _ _ _ _ _ _ _ _ _
      piGlueAlphabetCongr_mem_a2TwelfthGlueSubgroup_iff).trans
    (Isometry.ofEq a2TwelfthLattice_eq_gluedLattice.symm)

/-- The isometry from the table lattice of `A₂¹²` to `TauCeti.a2TwelfthLattice` keeps every
coordinate, up to the identification of the component and simple-root index types. -/
-- Not `@[simp]`: `simp` rewrites `(A 2).rank` inside the left-hand side by `rank_A`.
theorem a2TwelfthLatticeIsometry_apply
    (x : ∀ i, Fin (a2Twelfth.componentType i).rank → ℚ) (k : Fin 12) (j : Fin (A 2).rank) :
    a2TwelfthLatticeIsometry x k j =
      x (Fin.cast length_components_a2Twelfth.symm k)
        (Fin.cast (congrArg rank (componentType_a2Twelfth _)).symm j) := by
  rw [a2TwelfthLatticeIsometry, Isometry.trans_apply, Isometry.trans_apply,
    Isometry.ofEq_apply, Isometry.ofEq_apply]
  exact gluedLatticeIsometryOfEq_apply (s := fun _ ↦ A 2) _ _ _ _ _ _ _ _ _ _ x k j

/-- The inverse of `a2TwelfthLatticeIsometry` reads component `i` of the table lattice from
component `i` of `TauCeti.a2TwelfthLattice`. -/
-- Not `@[simp]`: `simp` rewrites `(A 2).rank` inside the left-hand side by `rank_A`.
theorem a2TwelfthLatticeIsometry_symm_apply
    (y : Fin 12 → Fin (A 2).rank → ℚ) (i : Fin a2Twelfth.components.length)
    (j : Fin (a2Twelfth.componentType i).rank) :
    a2TwelfthLatticeIsometry.symm y i j =
      y (Fin.cast length_components_a2Twelfth i)
        (Fin.cast (congrArg rank (componentType_a2Twelfth i)) j) := by
  obtain ⟨n, hn⟩ := i
  obtain ⟨m, hm⟩ := j
  have h := a2TwelfthLatticeIsometry_apply (a2TwelfthLatticeIsometry.symm y)
    (Fin.cast length_components_a2Twelfth ⟨n, hn⟩)
    (Fin.cast (congrArg rank (componentType_a2Twelfth ⟨n, hn⟩)) ⟨m, hm⟩)
  rw [a2TwelfthLatticeIsometry.apply_symm_apply] at h
  exact h.symm

/-- `a2TwelfthLatticeIsometry` carries the root sublattice of the table row onto
`TauCeti.a2TwelfthRootLattice`. -/
theorem map_rootLattice_carrier_a2TwelfthLatticeIsometry :
    a2Twelfth.rootLattice.carrier.map a2TwelfthLatticeIsometry.ambientEquiv.toLinearMap =
      a2TwelfthRootLattice.carrier := by
  let eRoot : IntegralLattice.Isometry a2Twelfth.rootLattice a2TwelfthRootLattice :=
    ((Isometry.piCongrLeft (fun i ↦ (a2Twelfth.componentType i).rootLattice
        (a2Twelfth.isSimplyLaced_componentType i))
      (finCongr length_components_a2Twelfth.symm)).symm.trans
      (Isometry.pi fun k ↦ (a2Twelfth.componentType _).rootLatticeIsometryOfEq _
        (componentType_a2Twelfth _) (isSimplyLaced_A 2)))
  ext y
  rw [Submodule.mem_map_equiv, Isometry.ambientEquiv_symm_apply, ← eRoot.apply_mem_carrier_iff]
  convert Iff.rfl using 2
  ext ⟨k, hk⟩ ⟨j, hj⟩
  rw [Isometry.trans_apply, Isometry.pi_apply, rootLatticeIsometryOfEq_apply,
    Isometry.piCongrLeft_symm_apply, finCongr_apply, a2TwelfthLatticeIsometry_symm_apply]
  rfl

/-- **The table lattice of `A₂¹²` is the ternary Golay gluing of `(A₂)¹²`**: an explicit isometry
from `a2Twelfth.lattice` onto the overlattice of the simple-root coordinate power `(A₂)¹²` glued
along `TauCeti.TernaryGolay.code`, placed in its discriminant group by
`TauCeti.codeInTypeA2CoordinatePowerDiscriminant`. -/
noncomputable def a2TwelfthLatticeTernaryGolayIsometry :
    IntegralLattice.Isometry a2Twelfth.lattice
      (((typeARootLattice 2).coordinatePower (Fin 12)).ofIsotropicSubgroup
        ((isEven_typeARootLattice 2).coordinatePower (Fin 12))
        (codeInTypeA2CoordinatePowerDiscriminant TernaryGolay.code.toAddSubgroup)
        TernaryGolay.isLagrangian_codeInTypeA2CoordinatePowerDiscriminant.isIsotropic) :=
  a2TwelfthLatticeIsometry.trans a2TwelfthTernaryGolayIsometry

/-- `a2TwelfthLatticeTernaryGolayIsometry` is the composition of `a2TwelfthLatticeIsometry` with
`TauCeti.a2TwelfthTernaryGolayIsometry`. -/
theorem a2TwelfthLatticeTernaryGolayIsometry_def :
    a2TwelfthLatticeTernaryGolayIsometry =
      a2TwelfthLatticeIsometry.trans a2TwelfthTernaryGolayIsometry :=
  (rfl)

/-- In Golay coordinate `j : Fin 12` and simple-root coordinate `k : Fin 2`, the image of `x` under
`a2TwelfthLatticeTernaryGolayIsometry` is `TauCeti.a2TwelfthSign j` times the coordinate of `x` in
table component `TauCeti.a2TwelfthDestinationToSource j`. -/
@[simp]
theorem a2TwelfthLatticeTernaryGolayIsometry_apply
    (x : ∀ i, Fin (a2Twelfth.componentType i).rank → ℚ) (j : Fin 12) (k : Fin 2) :
    a2TwelfthLatticeTernaryGolayIsometry x j k =
      (a2TwelfthSign j : ℤ) •
        x (Fin.cast length_components_a2Twelfth.symm (a2TwelfthDestinationToSource j))
          (Fin.cast ((congrArg rank (componentType_a2Twelfth _)).trans (rank_A 2)).symm k) := by
  obtain ⟨k, hk⟩ := k
  rw [a2TwelfthLatticeTernaryGolayIsometry, Isometry.trans_apply]
  have h := congrFun (a2TwelfthTernaryGolayIsometry_apply (a2TwelfthLatticeIsometry x) j) ⟨k, hk⟩
  exact h.trans ((Pi.smul_apply (a2TwelfthSign j : ℤ)
    (a2TwelfthLatticeIsometry x (a2TwelfthDestinationToSource j))
    (Fin.cast (rank_A 2).symm ⟨k, hk⟩)).trans
      (congrArg ((a2TwelfthSign j : ℤ) • ·) (a2TwelfthLatticeIsometry_apply x
        (a2TwelfthDestinationToSource j) (Fin.cast (rank_A 2).symm ⟨k, hk⟩))))

/-- The inverse of `a2TwelfthLatticeTernaryGolayIsometry` sends `y` at table component `i` and
simple-root coordinate `k` to `TauCeti.a2TwelfthSign j` times `y j`, where
`j = a2TwelfthDestinationToSource.symm i`. -/
@[simp]
theorem a2TwelfthLatticeTernaryGolayIsometry_symm_apply
    (y : Fin 12 → Fin 2 → ℚ) (i : Fin a2Twelfth.components.length)
    (k : Fin (a2Twelfth.componentType i).rank) :
    a2TwelfthLatticeTernaryGolayIsometry.symm y i k =
      (a2TwelfthSign (a2TwelfthDestinationToSource.symm
          (Fin.cast length_components_a2Twelfth i)) : ℤ) •
        y (a2TwelfthDestinationToSource.symm (Fin.cast length_components_a2Twelfth i))
          (Fin.cast ((congrArg rank (componentType_a2Twelfth i)).trans (rank_A 2)) k) := by
  obtain ⟨n, hn⟩ := i
  obtain ⟨m, hm⟩ := k
  set j := a2TwelfthDestinationToSource.symm (Fin.cast length_components_a2Twelfth ⟨n, hn⟩)
  set k' := Fin.cast ((congrArg rank (componentType_a2Twelfth ⟨n, hn⟩)).trans (rank_A 2)) ⟨m, hm⟩
  have h := a2TwelfthLatticeTernaryGolayIsometry_apply
    (a2TwelfthLatticeTernaryGolayIsometry.symm y) j k'
  rw [a2TwelfthLatticeTernaryGolayIsometry.apply_symm_apply] at h
  have hj : a2TwelfthDestinationToSource j = Fin.cast length_components_a2Twelfth ⟨n, hn⟩ :=
    a2TwelfthDestinationToSource.apply_symm_apply _
  have hcast : a2TwelfthLatticeTernaryGolayIsometry.symm y
      (Fin.cast length_components_a2Twelfth.symm (a2TwelfthDestinationToSource j))
      (Fin.cast ((congrArg rank (componentType_a2Twelfth _)).trans (rank_A 2)).symm k') =
      a2TwelfthLatticeTernaryGolayIsometry.symm y ⟨n, hn⟩ ⟨m, hm⟩ := by
    rw [hj]
    rfl
  rw [hcast] at h
  rw [h, smul_smul, Int.units_coe_mul_self, one_smul]

/-- `a2TwelfthLatticeTernaryGolayIsometry` carries the root sublattice of the table row onto the
coordinate power `(A₂)¹²`. -/
theorem map_rootLattice_carrier_a2TwelfthLatticeTernaryGolayIsometry :
    a2Twelfth.rootLattice.carrier.map
        a2TwelfthLatticeTernaryGolayIsometry.ambientEquiv.toLinearMap =
      ((typeARootLattice 2).coordinatePower (Fin 12)).carrier := by
  have hz (z) : z ∈ a2Twelfth.rootLattice.carrier ↔
      a2TwelfthLatticeIsometry z ∈ a2TwelfthRootLattice.carrier := by
    rw [← map_rootLattice_carrier_a2TwelfthLatticeIsometry, Submodule.mem_map_equiv,
      Isometry.ambientEquiv_symm_apply, a2TwelfthLatticeIsometry.symm_apply_apply]
  ext y
  rw [Submodule.mem_map_equiv, Isometry.ambientEquiv_symm_apply, hz,
    ← a2TwelfthRootIsometry.apply_mem_carrier_iff]
  convert Iff.rfl using 2
  symm
  calc a2TwelfthRootIsometry
          (a2TwelfthLatticeIsometry (a2TwelfthLatticeTernaryGolayIsometry.symm y))
      = a2TwelfthTernaryGolayIsometry
          (a2TwelfthLatticeIsometry (a2TwelfthLatticeTernaryGolayIsometry.symm y)) :=
        funext fun j ↦ (a2TwelfthRootIsometry_apply _ j).trans
          (a2TwelfthTernaryGolayIsometry_apply _ j).symm
    _ = a2TwelfthLatticeTernaryGolayIsometry (a2TwelfthLatticeTernaryGolayIsometry.symm y) :=
        (Isometry.trans_apply _ _ _).symm
    _ = y := a2TwelfthLatticeTernaryGolayIsometry.apply_symm_apply y

end RootfulNiemeierType

end TauCeti
