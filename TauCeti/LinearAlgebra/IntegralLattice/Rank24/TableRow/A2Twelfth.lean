module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.CodeAutomorphism
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.IdentifiedRows

/-!
# The table row `A₂¹²` is the ternary Golay overlattice of `(A₂)¹²`

The row `A₂¹²` of the rootful rank-24 table, `TauCeti.RootfulNiemeierType.a2Twelfth`, glues the
orthogonal sum of its twelve `A₂` components, read off by position from the row's component list,
along the subgroup `a2Twelfth.glueSubgroup` generated by the decoded Conway--Sloane pattern
`[2(11211122212)]`.  The same Niemeier lattice is constructed over the constant family `A₂` on
`Fin 12` as `TauCeti.a2TwelfthLattice`, and identified in
`TauCeti.LinearAlgebra.IntegralLattice.Rank24.A2Twelfth` with the overlattice of the coordinate
power `(A₂)¹²` of the simple-root model `TauCeti.typeARootLattice 2` glued along the extended
ternary Golay code.

This file connects the uniform table lattice `a2Twelfth.lattice` to both models:

* Through `TauCeti.RootfulNiemeierType.map_glueSubgroup_a2Twelfth`, a glue word of the row lies in
  the table glue subgroup exactly when its image under the signed coordinate change
  `TauCeti.a2TwelfthGolayIsometry` is a word of `TauCeti.TernaryGolay.code`
  (`TauCeti.RootfulNiemeierType.mem_glueSubgroup_a2Twelfth_iff`), which gives the carrier
  description `TauCeti.RootfulNiemeierType.mem_a2Twelfth_lattice_carrier_iff`.
* Naturality of gluing under equal families of components gives the coordinate-preserving
  isometry `TauCeti.RootfulNiemeierType.a2TwelfthLatticeIsometry` from `a2Twelfth.lattice` onto
  `TauCeti.a2TwelfthLattice`.
* Composing with `TauCeti.a2TwelfthTernaryGolayIsometry` yields
  `TauCeti.RootfulNiemeierType.a2TwelfthLatticeTernaryGolayIsometry`, identifying the table lattice
  with the ternary Golay gluing of `(A₂)¹²`: in Golay coordinate `j` it multiplies the table
  component `p j` by the sign `s j`, where `p = TauCeti.a2TwelfthDestinationToSource` and
  `s = TauCeti.a2TwelfthSign` are the displayed coordinate permutation and scalings.
* Conjugating `TauCeti.a2TwelfthGolayAutIsometry` along `a2TwelfthLatticeIsometry` transports
  every monomial automorphism of the ternary Golay code to a self-isometry
  `TauCeti.RootfulNiemeierType.a2TwelfthLatticeGolayAutIsometry` of the table lattice.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §§3 and 6, Chapter 7, §8, and Chapter 16, §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType IntegralLattice

/-! ### The glue subgroup and the carrier of the row -/

/-- A glue word of the row `A₂¹²` lies in the table glue subgroup exactly when its image under
`a2TwelfthGlueModuleIsometry` lies in `TauCeti.a2TwelfthGlueSubgroup`. -/
theorem a2TwelfthGlueModuleIsometry_mem_a2TwelfthGlueSubgroup_iff (w : a2Twelfth.glueModule) :
    a2TwelfthGlueModuleIsometry w ∈ a2TwelfthGlueSubgroup ↔ w ∈ a2Twelfth.glueSubgroup := by
  rw [← map_glueSubgroup_a2Twelfth]
  exact AddSubgroup.mem_map_iff_mem a2TwelfthGlueModuleIsometry.injective

/-- **The table glue subgroup of `A₂¹²` is the extended ternary Golay code**: a glue word of the
row lies in the subgroup generated by `[2(11211122212)]` exactly when, read in the Golay
coordinates of `TauCeti.a2TwelfthGolayIsometry`, it is a word of `TauCeti.TernaryGolay.code`. -/
theorem mem_glueSubgroup_a2Twelfth_iff (w : a2Twelfth.glueModule) :
    w ∈ a2Twelfth.glueSubgroup ↔
      a2TwelfthGolayIsometry (a2TwelfthGlueModuleIsometry w) ∈ TernaryGolay.code := by
  rw [← a2TwelfthGlueModuleIsometry_mem_a2TwelfthGlueSubgroup_iff, mem_a2TwelfthGlueSubgroup_iff]

/-- **The carrier of the table lattice of `A₂¹²`**: a vector lies in `a2Twelfth.lattice` exactly
when it lies in the dual of the orthogonal sum `a2Twelfth.rootLattice` of its twelve `A₂` root
lattices and the glue word of its discriminant class, read in Golay coordinates, is a word of the
extended ternary Golay code. -/
theorem mem_a2Twelfth_lattice_carrier_iff
    (x : ∀ i, Fin (a2Twelfth.componentType i).rank → ℚ) :
    x ∈ a2Twelfth.lattice.carrier ↔ ∃ hx : x ∈ a2Twelfth.rootLattice.dualCarrier,
      a2TwelfthGolayIsometry (a2TwelfthGlueModuleIsometry
        ((glueWordIsometry a2Twelfth.componentType a2Twelfth.isSimplyLaced_componentType
          a2Twelfth.valid_componentType).toAddEquiv.symm (Submodule.Quotient.mk ⟨x, hx⟩))) ∈
        TernaryGolay.code :=
  (mem_lattice_carrier_iff a2Twelfth x).trans
    (exists_congr fun _ ↦ mem_glueSubgroup_a2Twelfth_iff _)

/-! ### Comparison of the table lattice with `a2TwelfthLattice` -/

/-- Reindexing glue words of `a2Twelfth` by `piGlueAlphabetCongr` agrees with
`a2TwelfthGlueModuleIsometry`, since both preserve every Conway--Sloane digit. -/
private theorem piGlueAlphabetCongr_eq_a2TwelfthGlueModuleIsometry (w : a2Twelfth.glueModule) :
    piGlueAlphabetCongr a2Twelfth.componentType a2Twelfth.isSimplyLaced_componentType
        (finCongr (rfl : 12 = a2Twelfth.components.length)) (fun _ ↦ componentType_a2Twelfth _)
        w =
      a2TwelfthGlueModuleIsometry w :=
  encodeGlueWord_injective _ _ <|
    (encodeGlueWord_piGlueAlphabetCongr _ _ _ _ _ w).trans
      (encodeGlueWord_glueModuleIsometry _ _ _ _ w).symm

private theorem piGlueAlphabetCongr_mem_a2TwelfthGlueSubgroup_iff (w : a2Twelfth.glueModule) :
    piGlueAlphabetCongr a2Twelfth.componentType a2Twelfth.isSimplyLaced_componentType
        (finCongr (rfl : 12 = a2Twelfth.components.length)) (fun _ ↦ componentType_a2Twelfth _)
        w ∈ a2TwelfthGlueSubgroup ↔ w ∈ a2Twelfth.glueSubgroup := by
  rw [piGlueAlphabetCongr_eq_a2TwelfthGlueModuleIsometry,
    a2TwelfthGlueModuleIsometry_mem_a2TwelfthGlueSubgroup_iff]

/-- **The table lattice of `A₂¹²` is `TauCeti.a2TwelfthLattice`**, by the coordinate-preserving
isometry identifying the twelve `A₂` components of the row with the constant family on
`Fin 12`. -/
noncomputable def a2TwelfthLatticeIsometry : Isometry a2Twelfth.lattice a2TwelfthLattice :=
  (Isometry.ofEq (lattice_def _)).trans <|
    (gluedLatticeIsometryOfEq _ _ _ _ _ _ _ _ _
      piGlueAlphabetCongr_mem_a2TwelfthGlueSubgroup_iff).trans
    (Isometry.ofEq a2TwelfthLattice_def.symm)

/-- `a2TwelfthLatticeIsometry` keeps every simple-root coordinate, up to the identification of the
component Dynkin type with `A₂`. -/
-- Not `@[simp]`: `simp` rewrites `(A 2).rank` inside the argument `j` by `rank_A`.
theorem a2TwelfthLatticeIsometry_apply
    (x : ∀ i, Fin (a2Twelfth.componentType i).rank → ℚ) (k : Fin 12) (j : Fin (A 2).rank) :
    a2TwelfthLatticeIsometry x k j =
      x k (Fin.cast (congrArg rank (componentType_a2Twelfth k)).symm j) := by
  rw [a2TwelfthLatticeIsometry, Isometry.trans_apply, Isometry.trans_apply, Isometry.ofEq_apply,
    Isometry.ofEq_apply]
  exact gluedLatticeIsometryOfEq_apply (s := fun _ ↦ A 2) _ _ _ _ _ _ _ _ _ _ x k j

/-- The inverse of `a2TwelfthLatticeIsometry` keeps every simple-root coordinate, up to the
identification of the component Dynkin type with `A₂`. -/
-- Not `@[simp]`: `simp` rewrites `a2Twelfth.componentType k` inside the argument `j` by
-- `componentType_a2Twelfth`.
theorem a2TwelfthLatticeIsometry_symm_apply
    (y : Fin 12 → Fin (A 2).rank → ℚ) (k : Fin a2Twelfth.components.length)
    (j : Fin (a2Twelfth.componentType k).rank) :
    a2TwelfthLatticeIsometry.symm y k j =
      y k (Fin.cast (congrArg rank (componentType_a2Twelfth k)) j) := by
  have h := a2TwelfthLatticeIsometry_apply (a2TwelfthLatticeIsometry.symm y) k
    (Fin.cast (congrArg rank (componentType_a2Twelfth k)) j)
  rw [Isometry.apply_symm_apply, Fin.cast_cast, Fin.cast_refl] at h
  exact h.symm

/-! ### Comparison with the ternary Golay gluing of `(A₂)¹²` -/

/-- **The table lattice of `A₂¹²` is the ternary Golay gluing of `(A₂)¹²`**: composing
`a2TwelfthLatticeIsometry` with `TauCeti.a2TwelfthTernaryGolayIsometry` identifies
`a2Twelfth.lattice` with the overlattice of the coordinate power `(A₂)¹²` glued along
`TauCeti.codeInTypeA2CoordinatePowerDiscriminant` of the extended ternary Golay code. -/
noncomputable def a2TwelfthLatticeTernaryGolayIsometry :
    Isometry a2Twelfth.lattice
      (((typeARootLattice 2).coordinatePower (Fin 12)).ofIsotropicSubgroup
        ((isEven_typeARootLattice 2).coordinatePower (Fin 12))
        (codeInTypeA2CoordinatePowerDiscriminant TernaryGolay.code.toAddSubgroup)
        TernaryGolay.isLagrangian_codeInTypeA2CoordinatePowerDiscriminant.isIsotropic) :=
  a2TwelfthLatticeIsometry.trans a2TwelfthTernaryGolayIsometry

/-- In Golay coordinate `j`, `a2TwelfthLatticeTernaryGolayIsometry` multiplies the table component
`p j` by the sign `s j`, where `p = TauCeti.a2TwelfthDestinationToSource` and
`s = TauCeti.a2TwelfthSign`. -/
-- Not `@[simp]`: `simp` rewrites `a2Twelfth.componentType` inside the argument by
-- `componentType_a2Twelfth`.
theorem a2TwelfthLatticeTernaryGolayIsometry_apply
    (x : ∀ i, Fin (a2Twelfth.componentType i).rank → ℚ) (j : Fin 12) (i : Fin 2) :
    a2TwelfthLatticeTernaryGolayIsometry x j i =
      (a2TwelfthSign j : ℤ) • x (a2TwelfthDestinationToSource j)
        (Fin.cast (congrArg rank (componentType_a2Twelfth _)).symm i) := by
  rw [a2TwelfthLatticeTernaryGolayIsometry, Isometry.trans_apply]
  -- The ambient index type of the target is `Fin 2`, while `a2TwelfthTernaryGolayIsometry_apply`
  -- is stated over `Fin (A 2).rank`; `erw` reduces `(A 2).rank` when matching.
  erw [a2TwelfthTernaryGolayIsometry_apply]
  exact congrArg _ (a2TwelfthLatticeIsometry_apply x _ i)

/-! ### Ternary Golay code automorphisms act on the table lattice -/

/-- **Every monomial automorphism of the ternary Golay code induces a self-isometry of the table
lattice `a2Twelfth.lattice`**, obtained by conjugating `TauCeti.a2TwelfthGolayAutIsometry` along
`a2TwelfthLatticeIsometry`. -/
noncomputable def a2TwelfthLatticeGolayAutIsometry (v : Fin 12 → ℤˣ) (e : Equiv.Perm (Fin 12))
    (he : signedEquiv (R := ZMod 3) v e ∈ monomialAut TernaryGolay.code) :
    Isometry a2Twelfth.lattice a2Twelfth.lattice :=
  a2TwelfthLatticeIsometry.symm.conjMulEquiv (a2TwelfthGolayAutIsometry v e he)

/-- `a2TwelfthLatticeIsometry` intertwines `a2TwelfthLatticeGolayAutIsometry` with
`TauCeti.a2TwelfthGolayAutIsometry`. -/
-- Not `@[simp]`: `simp` rewrites `(A 2).rank` inside the `DFunLike.coe` motive by `rank_A`.
theorem a2TwelfthLatticeIsometry_a2TwelfthLatticeGolayAutIsometry_apply
    (v : Fin 12 → ℤˣ) (e : Equiv.Perm (Fin 12))
    (he : signedEquiv (R := ZMod 3) v e ∈ monomialAut TernaryGolay.code)
    (x : ∀ i, Fin (a2Twelfth.componentType i).rank → ℚ) :
    a2TwelfthLatticeIsometry (a2TwelfthLatticeGolayAutIsometry v e he x) =
      a2TwelfthGolayAutIsometry v e he (a2TwelfthLatticeIsometry x) := by
  rw [a2TwelfthLatticeGolayAutIsometry, Isometry.conjMulEquiv_apply, Isometry.symm_symm,
    Isometry.apply_symm_apply]

/-- The self-isometry of the table lattice induced by a ternary Golay code automorphism
`signedEquiv v e` moves the component in table position `p a` to table position `p (e a)`,
multiplied by the sign `s (e a) * v a * s a`, for `p = TauCeti.a2TwelfthDestinationToSource` and
`s = TauCeti.a2TwelfthSign`.  At table position `k` this is stated with `a = e.symm (p.symm k)`. -/
-- Not `@[simp]`: `simp` rewrites `a2Twelfth.componentType k` inside the argument `i` by
-- `componentType_a2Twelfth`.
theorem a2TwelfthLatticeGolayAutIsometry_apply (v : Fin 12 → ℤˣ) (e : Equiv.Perm (Fin 12))
    (he : signedEquiv (R := ZMod 3) v e ∈ monomialAut TernaryGolay.code)
    (x : ∀ m, Fin (a2Twelfth.componentType m).rank → ℚ)
    (k : Fin a2Twelfth.components.length) (i : Fin (a2Twelfth.componentType k).rank) :
    a2TwelfthLatticeGolayAutIsometry v e he x k i =
      ((a2TwelfthSign (a2TwelfthDestinationToSource.symm k) *
          v (e.symm (a2TwelfthDestinationToSource.symm k)) *
            a2TwelfthSign (e.symm (a2TwelfthDestinationToSource.symm k)) : ℤˣ) : ℤ) •
        x (a2TwelfthDestinationToSource (e.symm (a2TwelfthDestinationToSource.symm k)))
          (Fin.cast ((congrArg rank (componentType_a2Twelfth k)).trans
            (congrArg rank (componentType_a2Twelfth _)).symm) i) := by
  rw [a2TwelfthLatticeGolayAutIsometry, Isometry.conjMulEquiv_apply, Isometry.symm_symm,
    a2TwelfthLatticeIsometry_symm_apply]
  have h := congrFun (a2TwelfthGolayAutIsometry_apply v e he (a2TwelfthLatticeIsometry x) k)
    (Fin.cast (congrArg rank (componentType_a2Twelfth k)) i)
  rw [h, Pi.smul_apply, a2TwelfthLatticeIsometry_apply, Units.smul_def, Fin.cast_cast]

end RootfulNiemeierType

end TauCeti
