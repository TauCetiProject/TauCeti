module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Niemeier
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.GolayRows

/-!
# The table row `A₁²⁴` is binary Golay Construction A

The row `A₁²⁴` of the rootful rank-24 table, `TauCeti.RootfulNiemeierType.a1TwentyFourth`, glues
the orthogonal sum of its components, read off by position from the list of twenty-four `A₁`
components, along the subgroup `H` generated by the decoded Conway--Sloane pattern
`[1(00000101001100110101111)]`.  The same row is also constructed directly, as the lattice
`TauCeti.a1TwentyFourthLattice` glued from the constant family `A₁` on `Fin 24` along the
subgroup generated by the twenty-three printed rotations, which is identified with the extended
binary Golay code.  This file shows that the two constructions agree, so that the uniform table
lattice `a1TwentyFourth.lattice` inherits the identification with the Golay code.

The glue subgroup `H` of the row is the subgroup generated by the printed words
(`TauCeti.RootfulNiemeierType.map_glueSubgroup_a1TwentyFourth`), along the isometry of glue-word
modules `TauCeti.RootfulNiemeierType.a1TwentyFourthGlueIsometry`, which keeps every
Conway--Sloane digit; both are in `TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.GolayRows`.

At the level of lattices, the naturality of gluing under equal families of components gives the
explicit isometry `TauCeti.RootfulNiemeierType.a1TwentyFourthLatticeIsometry` from the table lattice
to `TauCeti.a1TwentyFourthLattice`, which keeps every coordinate.  Composing with
`TauCeti.a1TwentyFourthConstructionAIsometry` identifies the table lattice with
`TauCeti.BinaryGolay.constructionALattice`
(`TauCeti.RootfulNiemeierType.a1TwentyFourthLatticeConstructionAIsometry`): the Golay coordinate
`j` of the image of `x` is twice the simple-root coordinate of `x` in the table component
`p j`, where `p` is the destination-to-source permutation `TauCeti.a1TableToGolayPerm`.  In
particular this rootful lattice is Construction A of the Golay code, not the Leech lattice.

## Main declarations

* `TauCeti.RootfulNiemeierType.a1TwentyFourthLatticeIsometry`: the table lattice is the lattice
  `TauCeti.a1TwentyFourthLattice`.
* `TauCeti.RootfulNiemeierType.a1TwentyFourthLatticeConstructionAIsometry`: the table lattice is
  binary Golay Construction A.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §3, Chapter 7, §6, and Chapter 16, §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType IntegralLattice

/-! ### The lattice of the row -/

/-- **The table lattice of `A₁²⁴` is the Golay-glued lattice `TauCeti.a1TwentyFourthLattice`**,
by the isometry keeping every coordinate: component `j : Fin 24` of the image is component `j`
of the source, a vector of the `A₁` root lattice. -/
noncomputable def a1TwentyFourthLatticeIsometry :
    IntegralLattice.Isometry a1TwentyFourth.lattice a1TwentyFourthLattice :=
  (Isometry.ofEq (lattice_def _)).trans <|
    (gluedLatticeIsometryOfEq _ _ _ _ _ _ _ _ _ fun w ↦ by
      rw [← a1TwentyFourthGlueIsometry_def]
      exact a1TwentyFourthGlueIsometry_mem_a1TwentyFourGlueSubgroup_iff w).trans
    (Isometry.ofEq a1TwentyFourthLattice_def.symm)

/-- The isometry from the table lattice of `A₁²⁴` to `TauCeti.a1TwentyFourthLattice` keeps every
coordinate, up to the identification of the index types. -/
theorem a1TwentyFourthLatticeIsometry_apply
    (x : ∀ i, Fin (a1TwentyFourth.componentType i).rank → ℚ) (k : Fin 24) (j : Fin (A 1).rank) :
    a1TwentyFourthLatticeIsometry x k j =
      x (Fin.cast length_components_a1TwentyFourth.symm k)
        (Fin.cast (congrArg rank (componentType_a1TwentyFourth _)).symm j) := by
  rw [a1TwentyFourthLatticeIsometry, Isometry.trans_apply, Isometry.trans_apply,
    Isometry.ofEq_apply, Isometry.ofEq_apply]
  exact gluedLatticeIsometryOfEq_apply (s := fun _ ↦ A 1) _ _ _ _ _ _ _ _ _ _ x k j

/-- **The table lattice of `A₁²⁴` is binary Golay Construction A**: an explicit isometry from
`a1TwentyFourth.lattice` onto `TauCeti.BinaryGolay.constructionALattice`. -/
noncomputable def a1TwentyFourthLatticeConstructionAIsometry :
    IntegralLattice.Isometry a1TwentyFourth.lattice BinaryGolay.constructionALattice :=
  a1TwentyFourthLatticeIsometry.trans a1TwentyFourthConstructionAIsometry

/-- The comparison with Construction A factors through the constant-family gluing. -/
theorem a1TwentyFourthLatticeConstructionAIsometry_def :
    a1TwentyFourthLatticeConstructionAIsometry =
      a1TwentyFourthLatticeIsometry.trans a1TwentyFourthConstructionAIsometry :=
  (rfl)

/-- The isometry onto Golay Construction A doubles, in Golay coordinate `j`, the simple-root
coordinate of the table component `p j`, where `p = TauCeti.a1TableToGolayPerm`. -/
theorem a1TwentyFourthLatticeConstructionAIsometry_apply
    (x : ∀ i, Fin (a1TwentyFourth.componentType i).rank → ℚ) (j : Fin 24) :
    a1TwentyFourthLatticeConstructionAIsometry x j =
      2 * x (Fin.cast length_components_a1TwentyFourth.symm (a1TableToGolayPerm j))
        ⟨0, by rw [componentType_a1TwentyFourth]; decide⟩ := by
  rw [a1TwentyFourthLatticeConstructionAIsometry, Isometry.trans_apply,
    a1TwentyFourthConstructionAIsometry_apply, a1TwentyFourthLatticeIsometry_apply]
  rfl

end RootfulNiemeierType

end TauCeti
