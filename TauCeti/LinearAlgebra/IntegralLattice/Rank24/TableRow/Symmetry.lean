module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Niemeier
public import TauCeti.LinearAlgebra.IntegralLattice.Isometry.Group

/-!
# Symmetries of the glue columns act on the rootful rank-24 lattices

A row `r` of the rootful rank-24 table glues the orthogonal sum `R_r` of its ordered ADE components
along the subgroup `H_r` generated by the decoded digit words `r.glueWords` of its glue columns.
A permutation `g` of the component positions is a *glue symmetry* of the row
(`TauCeti.RootfulNiemeierType.glueSymmetries`) when it maps every component to one of the same
type and permutes the digit words: a word with digits `d` is a digit word of the row exactly when
the word with digits `d ∘ g` is.  The glue symmetries form a subgroup of the permutations of the
positions.

Permuting the components of `R_r` along a glue symmetry carries `H_r` onto itself, so it restricts
to a self-isometry of the glued lattice `N_r = r.lattice`; these isometries form an action of the
glue symmetries on `N_r` (`TauCeti.RootfulNiemeierType.latticeIsometryHom`), in which `g` moves
the component in position `k` to position `g k`.

The table patterns supply such symmetries.  A glue symmetry need not be a symmetry of each printed
pattern: it suffices that it preserves component types and that the expansion of every pattern of
the row is invariant under it (`mem_glueSymmetries_of_forall_gluePatterns`), and the scalar orbits
of the `𝔽₄`-linear row `D₄⁶` are then permuted as well.  In particular the rotations of a marked
block and the even permutations indicated by a pattern of the row are glue symmetries for every
row except `A₅⁴ D₄` (`mem_glueSymmetries_of_mem_symmetries`), and they act on `N_r`
(`TauCeti.RootfulNiemeierType.patternIsometryHom`).  This covers the cyclic patterns of `D₈³`,
`E₆⁴`, `A₈³`, `A₆⁴`, `D₄⁶`, `A₄⁶`, `A₃⁸`, `A₂¹²` and `A₁²⁴`, and the alternating group on the
four components of `D₆⁴`.  In the row `A₅⁴ D₄` the rotation of the three `A₅` components marked
in `[2(024)0]` does not preserve the glue subgroup: it carries `[33001]` to `[30301]`, whose
difference with `[30302]` is the nonzero word `[00003]` of shortest norm `1`.

## Main declarations

* `TauCeti.RootfulNiemeierType.glueSymmetries`: the glue symmetries of a row.
* `TauCeti.RootfulNiemeierType.piGlueAlphabetCongr_mem_glueSubgroup_iff`: a glue symmetry
  preserves the glue subgroup.
* `TauCeti.RootfulNiemeierType.latticeIsometryHom`: the action of the glue symmetries on `N_r`.
* `TauCeti.RootfulNiemeierType.mem_glueSymmetries_of_mem_symmetries`,
  `TauCeti.RootfulNiemeierType.patternIsometryHom`: the indicated symmetries of the table patterns
  are glue symmetries and act on `N_r`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4
  §3 and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType IntegralLattice

variable (r : RootfulNiemeierType)

/-! ### Glue symmetries of a row -/

/-- **The glue symmetries of a row**: the permutations `g` of the component positions which map
every component to one of the same type and permute the digit words of the row, in the sense that
the word with digits `d ∘ g` is a digit word exactly when the word with digits `d` is. -/
def glueSymmetries : Subgroup (Equiv.Perm (Fin r.components.length)) where
  carrier := {g | (∀ k, r.componentType (g k) = r.componentType k) ∧
    ∀ d : Fin r.components.length → ℕ, List.ofFn (d ∘ g) ∈ r.glueWords ↔ List.ofFn d ∈ r.glueWords}
  one_mem' := ⟨fun _ ↦ rfl, fun _ ↦ Iff.rfl⟩
  mul_mem' {g h} hg hh :=
    ⟨fun k ↦ (hg.1 (h k)).trans (hh.1 k), fun d ↦ (hh.2 (d ∘ g)).trans (hg.2 d)⟩
  inv_mem' {g} hg := by
    refine ⟨fun k ↦ ?_, fun d ↦ ?_⟩
    · simpa using (hg.1 (g⁻¹ k)).symm
    · simpa [Function.comp_assoc] using (hg.2 (d ∘ ⇑g⁻¹)).symm

/-- A permutation of the positions is a glue symmetry exactly when it preserves component types
and permutes the digit words of the row. -/
theorem mem_glueSymmetries_iff {g : Equiv.Perm (Fin r.components.length)} :
    g ∈ r.glueSymmetries ↔ (∀ k, r.componentType (g k) = r.componentType k) ∧
      ∀ d : Fin r.components.length → ℕ,
        List.ofFn (d ∘ g) ∈ r.glueWords ↔ List.ofFn d ∈ r.glueWords :=
  Iff.rfl

/-- A glue symmetry maps every component to one of the same type. -/
theorem componentType_apply_of_mem_glueSymmetries {g : Equiv.Perm (Fin r.components.length)}
    (hg : g ∈ r.glueSymmetries) (k : Fin r.components.length) :
    r.componentType (g k) = r.componentType k :=
  (r.mem_glueSymmetries_iff.mp hg).1 k

/-- **Glue symmetries from the patterns**: a permutation preserving the component types is a glue
symmetry of a row as soon as the expansion of every pattern of the row is invariant under it. -/
theorem mem_glueSymmetries_of_forall_gluePatterns {g : Equiv.Perm (Fin r.components.length)}
    (hg : ∀ k, r.componentType (g k) = r.componentType k)
    (hp : ∀ p ∈ r.gluePatterns, ∀ d : Fin r.components.length → ℕ,
      List.ofFn (d ∘ g) ∈ p.expand ↔ List.ofFn d ∈ p.expand) :
    g ∈ r.glueSymmetries := by
  refine ⟨hg, fun d ↦ ?_⟩
  simp only [mem_glueWords_iff_exists_ofFn]
  -- Reindex the expanded word `e` as `e ∘ g`, which ranges over all digit functions.
  refine ⟨fun ⟨p, hp', e, he, hd⟩ ↦ ⟨p, hp', e ∘ ⇑g⁻¹, ?_, ?_⟩,
    fun ⟨p, hp', e, he, hd⟩ ↦ ⟨p, hp', e ∘ g, (hp p hp' e).mpr he, ?_⟩⟩
  · rw [← hp p hp']
    simpa [Function.comp_assoc] using he
  · rw [← r.spanMode.ofFn_comp_mem_scalarOrbit_ofFn_comp_iff g]
    simpa [Function.comp_assoc] using hd
  · exact (r.spanMode.ofFn_comp_mem_scalarOrbit_ofFn_comp_iff g d e).mpr hd

/-! ### Glue symmetries act on the glued lattice -/

/-- **A glue symmetry preserves the glue subgroup**: permuting the components of a glue word
along a glue symmetry keeps it in the glue subgroup `H_r` exactly when it lies there. -/
theorem piGlueAlphabetCongr_mem_glueSubgroup_iff {g : Equiv.Perm (Fin r.components.length)}
    (hg : g ∈ r.glueSymmetries) (w : r.glueModule) :
    piGlueAlphabetCongr r.componentType r.isSimplyLaced_componentType g
        (r.componentType_apply_of_mem_glueSymmetries hg) w ∈ r.glueSubgroup ↔
      w ∈ r.glueSubgroup := by
  set φ := (piGlueAlphabetCongr r.componentType r.isSimplyLaced_componentType g
    (r.componentType_apply_of_mem_glueSymmetries hg)).toAddEquiv
  have hgen : φ ⁻¹' r.glueGenerators = r.glueGenerators := by
    ext v
    rw [Set.mem_preimage, mem_glueGenerators_iff, mem_glueGenerators_iff]
    rw [show φ v = piGlueAlphabetCongr r.componentType r.isSimplyLaced_componentType g
        (r.componentType_apply_of_mem_glueSymmetries hg) v from rfl,
      encodeGlueWord_piGlueAlphabetCongr_eq_ofFn, encodeGlueWord_def]
    exact (r.mem_glueSymmetries_iff.mp hg).2 fun i ↦ (((r.componentType i).glueLabelEquiv
      (r.isSimplyLaced_componentType i)).symm (v i)).val
  have hmap : r.glueSubgroup.map φ.symm.toAddMonoidHom = r.glueSubgroup := by
    rw [glueSubgroup_def, AddMonoidHom.map_closure]
    exact congrArg AddSubgroup.closure ((φ.toEquiv.image_symm_eq_preimage _).trans hgen)
  have h := AddSubgroup.mem_map_equiv (f := φ.symm) (K := r.glueSubgroup) (x := w)
  rw [hmap, AddEquiv.symm_symm] at h
  exact h.symm

/-- The self-isometry of `N_r` induced by a glue symmetry `g`, reading the component in position
`k` from position `g k`. -/
private noncomputable def glueSymmetryIsometry {g : Equiv.Perm (Fin r.components.length)}
    (hg : g ∈ r.glueSymmetries) : IntegralLattice.Isometry r.lattice r.lattice :=
  (Isometry.ofEq (lattice_def r)).trans <|
    (gluedLatticeIsometryOfEq r.componentType r.isSimplyLaced_componentType r.valid_componentType
      r.glueSubgroup r.isIsotropic_glueSubgroup r.valid_componentType r.isIsotropic_glueSubgroup g
      (r.componentType_apply_of_mem_glueSymmetries hg)
      (r.piGlueAlphabetCongr_mem_glueSubgroup_iff hg)).trans
    (Isometry.ofEq (lattice_def r).symm)

/-- The isometry induced by a glue symmetry `g` reads the component in position `k` from position
`g k`. -/
private theorem glueSymmetryIsometry_apply {g : Equiv.Perm (Fin r.components.length)}
    (hg : g ∈ r.glueSymmetries) (x : ∀ i, Fin (r.componentType i).rank → ℚ)
    (k : Fin r.components.length) (j : Fin (r.componentType k).rank) :
    r.glueSymmetryIsometry hg x k j =
      x (g k)
        (Fin.cast (congrArg rank (r.componentType_apply_of_mem_glueSymmetries hg k)).symm j) := by
  rw [glueSymmetryIsometry, Isometry.trans_apply, Isometry.trans_apply, Isometry.ofEq_apply,
    Isometry.ofEq_apply]
  exact gluedLatticeIsometryOfEq_apply _ _ _ _ _ _ _ _ _ _ x k j

/-- **The glue symmetries of a row act on its lattice `N_r`** by permuting the components: a glue
symmetry `g` moves the component in position `k` to position `g k`. -/
noncomputable def latticeIsometryHom :
    r.glueSymmetries →* IntegralLattice.Isometry r.lattice r.lattice where
  toFun g := r.glueSymmetryIsometry (inv_mem g.2)
  map_one' := Isometry.ext fun x ↦ funext fun k ↦ funext fun j ↦ by
    rw [glueSymmetryIsometry_apply, Isometry.one_apply]
    rfl
  map_mul' g h := Isometry.ext fun x ↦ funext fun k ↦ funext fun j ↦ by
    rw [Isometry.mul_apply, glueSymmetryIsometry_apply, glueSymmetryIsometry_apply,
      glueSymmetryIsometry_apply]
    rfl

/-- The action of a glue symmetry `g` on `N_r` reads the component in position `k` from position
`g⁻¹ k`. -/
theorem latticeIsometryHom_apply (g : r.glueSymmetries)
    (x : ∀ i, Fin (r.componentType i).rank → ℚ) (k : Fin r.components.length)
    (j : Fin (r.componentType k).rank) :
    r.latticeIsometryHom g x k j =
      x ((g : Equiv.Perm _)⁻¹ k)
        (Fin.cast (congrArg rank (r.componentType_apply_of_mem_glueSymmetries (inv_mem g.2) k)).symm
          j) :=
  r.glueSymmetryIsometry_apply (inv_mem g.2) x k j

/-! ### The indicated symmetries of the table patterns -/

/-- **The indicated symmetries of the table patterns are glue symmetries.**  For every row other
than `A₅⁴ D₄`, the rotations of a marked block and the even permutations indicated by a pattern of
the row, read on the component positions, are glue symmetries of the row. -/
theorem mem_glueSymmetries_of_mem_symmetries {r : RootfulNiemeierType}
    (hr : r ≠ a5FourthD4) {p : GluePattern} (hp : p ∈ r.gluePatterns)
    {g : Equiv.Perm (Fin p.length)} (hg : g ∈ p.symmetries) :
    (finCongr (length_eq_of_mem_gluePatterns hp)).permCongr g ∈ r.glueSymmetries := by
  -- Enumerate the patterns of every row.
  cases r <;> simp only [gluePatterns] at hp <;>
    rcases hp with _ | ⟨_, _ | ⟨_, _ | ⟨_, _ | ⟨_, ⟨⟩⟩⟩⟩⟩
  all_goals first
    -- A literal word indicates only the identity.
    | rw [GluePattern.symmetries_literal, Subgroup.mem_bot] at hg
      subst hg
      exact one_mem _
    | exact absurd rfl hr
    -- The remaining rows have equal components, and only `D₄⁶` has a second pattern, the
    -- constant word `[111111]`, which is fixed by every permutation of the positions.
    | refine mem_glueSymmetries_of_forall_gluePatterns _ (fun k ↦ congrArg Subtype.val
        ((List.eq_of_mem_replicate (List.getElem_mem _)).trans
          (List.eq_of_mem_replicate (List.getElem_mem _)).symm)) fun q hq d ↦ ?_
      simp only [gluePatterns] at hq
      rcases hq with _ | ⟨_, _ | ⟨_, ⟨⟩⟩⟩
      all_goals first
        | exact GluePattern.ofFn_comp_permCongr_mem_expand_iff _ _ hg d
        | have h : [1, 1, 1, 1, 1, 1] = List.ofFn fun _ : Fin d4Sixth.components.length ↦ 1 := rfl
          simp only [GluePattern.expand_literal, Finset.mem_singleton, h, List.ofFn_inj]
          exact (Equiv.surjective _).injective_comp_right.eq_iff' rfl

/-- **The indicated symmetries of a table pattern act on the lattice of its row**, for every row
other than `A₅⁴ D₄`, by moving the component in position `k` to position `g k`. -/
noncomputable def patternIsometryHom {r : RootfulNiemeierType} (hr : r ≠ a5FourthD4)
    {p : GluePattern} (hp : p ∈ r.gluePatterns) :
    p.symmetries →* IntegralLattice.Isometry r.lattice r.lattice :=
  r.latticeIsometryHom.comp <|
    ((finCongr (length_eq_of_mem_gluePatterns hp)).permCongrHom.toMonoidHom.comp
      p.symmetries.subtype).codRestrict r.glueSymmetries fun g ↦
        mem_glueSymmetries_of_mem_symmetries hr hp g.2

/-- The action of an indicated pattern symmetry `g` on `N_r` reads the component in position `k`
from position `g⁻¹ k`, the positions of the pattern being those of the row. -/
theorem patternIsometryHom_apply {r : RootfulNiemeierType} (hr : r ≠ a5FourthD4)
    {p : GluePattern} (hp : p ∈ r.gluePatterns) (g : p.symmetries)
    (x : ∀ i, Fin (r.componentType i).rank → ℚ) (k : Fin r.components.length)
    (j : Fin (r.componentType k).rank) :
    patternIsometryHom hr hp g x k j =
      x (((finCongr (length_eq_of_mem_gluePatterns hp)).permCongr g)⁻¹ k)
        (Fin.cast (congrArg rank (r.componentType_apply_of_mem_glueSymmetries
          (inv_mem (mem_glueSymmetries_of_mem_symmetries hr hp g.2)) k)).symm j) :=
  r.latticeIsometryHom_apply _ x k j

end RootfulNiemeierType

end TauCeti
