module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Niemeier
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.TableRow.A5FourthD4
public import TauCeti.LinearAlgebra.IntegralLattice.Isometry.Group

/-!
# Symmetries of the glue columns act on the rootful rank-24 lattices

A row `r` of the rootful rank-24 table glues the orthogonal sum `R_r` of its ordered ADE components
along the subgroup `H_r` generated by the decoded digit words `r.glueWords` of its glue columns.
A permutation `g` of the component positions is a *glue symmetry* of the row
(`TauCeti.RootfulNiemeierType.glueSymmetries`) when it maps every component to one of the same
type and permuting the components of glue words along it carries `H_r` onto itself.  The glue
symmetries form a subgroup of the permutations of the positions.  A type-preserving permutation
that permutes the digit words, in the sense that a word with digits `d` is a digit word of the row
exactly when the word with digits `d ∘ g` is, is a glue symmetry
(`mem_glueSymmetries_of_glueWords`).

Permuting the components of `R_r` along a glue symmetry therefore restricts to a self-isometry of
the glued lattice `N_r = r.lattice`; these isometries form an action of the glue symmetries on
`N_r` (`TauCeti.RootfulNiemeierType.latticeIsometryHom`), in which `g` moves the component in
position `k` to position `g k`.

The table patterns supply such symmetries.  A glue symmetry need not be a symmetry of each printed
pattern: it suffices that it preserves component types and that the expansion of every pattern of
the row is invariant under it (`mem_glueSymmetries_of_forall_gluePatterns`), and the scalar orbits
of the `𝔽₄`-linear row `D₄⁶` are then permuted as well.  In particular the rotations of a marked
block and the even permutations indicated by a pattern of the row are glue symmetries for every
row except `A₅⁴ D₄` (`mem_glueSymmetries_of_mem_symmetries`).  In the row `A₅⁴ D₄` the pure
rotation of the three `A₅` components marked in `[2(024)0]` does not preserve the glue subgroup
(`a5FourthD4BlockPerm_notMem_glueSymmetries`): reindexing `[30302]` along it gives `[33002]`, whose
sum with `[33001]` is the nonzero word `[00003]` of shortest norm `1`.  Coupling that block
rotation with `D₄` triality in `TauCeti.LinearAlgebra.IntegralLattice.Rank24.TableRow.A5FourthD4`
repairs the action, so `TauCeti.RootfulNiemeierType.patternIsometryHom` lifts the indicated
symmetries of every pattern of every one of the 23 rows to `N_r`.

## Main declarations

* `TauCeti.RootfulNiemeierType.glueSymmetries`: the glue symmetries of a row.
* `TauCeti.RootfulNiemeierType.piGlueAlphabetCongr_mem_glueSubgroup_iff`: a glue symmetry
  preserves the glue subgroup.
* `TauCeti.RootfulNiemeierType.mem_glueSymmetries_of_glueWords`: a type-preserving permutation of
  the digit words is a glue symmetry.
* `TauCeti.RootfulNiemeierType.latticeIsometryHom`: the action of the glue symmetries on `N_r`.
* `TauCeti.RootfulNiemeierType.mem_glueSymmetries_of_mem_symmetries`: the indicated symmetries of
  the table patterns are glue symmetries for every row except `A₅⁴ D₄`.
* `TauCeti.RootfulNiemeierType.a5FourthD4BlockPerm_notMem_glueSymmetries`: the pure block rotation
  of `[2(024)0]` is not a glue symmetry of `A₅⁴ D₄`.
* `TauCeti.RootfulNiemeierType.patternIsometryHom`: the action of `p.symmetries` on `N_r` for every
  row `r` and every pattern `p ∈ r.gluePatterns`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4
  §3 and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType IntegralLattice

variable (r : RootfulNiemeierType)

/-! ### Glue symmetries of a row -/

/-- **The glue symmetries of a row**: the permutations `g` of the component positions which map
every component to one of the same type and preserve the glue subgroup `H_r`, in the sense that
the glue word reading its label in position `k` from position `g k` lies in `H_r` exactly when the
original word does. -/
def glueSymmetries : Subgroup (Equiv.Perm (Fin r.components.length)) where
  carrier := {g | ∃ hg : ∀ k, r.componentType (g k) = r.componentType k,
    ∀ w : r.glueModule, piGlueAlphabetCongr r.componentType r.isSimplyLaced_componentType g hg w ∈
      r.glueSubgroup ↔ w ∈ r.glueSubgroup}
  one_mem' := ⟨fun _ ↦ rfl, fun w ↦
    (congrArg (· ∈ r.glueSubgroup) (DFunLike.congr_fun (piGlueAlphabetCongr_refl _ _ _) w)).to_iff⟩
  mul_mem' {g h} hg hh := ⟨fun k ↦ (hg.fst (h k)).trans (hh.fst k), fun w ↦
    (congrArg (· ∈ r.glueSubgroup)
      (DFunLike.congr_fun (piGlueAlphabetCongr_trans _ _ g hg.fst h hh.fst) w).symm).to_iff.trans
      ((hh.snd _).trans (hg.snd w))⟩
  inv_mem' {g} hg := by
    have hgi : ∀ k, r.componentType (g⁻¹ k) = r.componentType k := fun k ↦ by
      simpa using (hg.fst (g⁻¹ k)).symm
    refine ⟨hgi, fun w ↦ ?_⟩
    -- Write `w` as the reindexing of `v` along `g`, which the reindexing along `g⁻¹` undoes.
    obtain ⟨v, rfl⟩ := EquivLike.surjective (piGlueAlphabetCongr r.componentType
      r.isSimplyLaced_componentType g hg.fst (hs := r.isSimplyLaced_componentType)) w
    have hv := DFunLike.congr_fun (piGlueAlphabetCongr_trans _ _ g hg.fst g⁻¹ hgi
      (hs := r.isSimplyLaced_componentType) (hu := r.isSimplyLaced_componentType)) v
    simp only [Equiv.Perm.inv_def, Equiv.symm_trans_self, piGlueAlphabetCongr_refl] at hv
    exact (congrArg (· ∈ r.glueSubgroup) hv).to_iff.trans (hg.snd v).symm

/-- A permutation of the positions is a glue symmetry exactly when it preserves component types
and the glue subgroup of the row. -/
theorem mem_glueSymmetries_iff {g : Equiv.Perm (Fin r.components.length)} :
    g ∈ r.glueSymmetries ↔ ∃ hg : ∀ k, r.componentType (g k) = r.componentType k,
      ∀ w : r.glueModule, piGlueAlphabetCongr r.componentType r.isSimplyLaced_componentType g hg w ∈
        r.glueSubgroup ↔ w ∈ r.glueSubgroup :=
  Iff.rfl

/-- A glue symmetry maps every component to one of the same type. -/
theorem componentType_apply_of_mem_glueSymmetries {g : Equiv.Perm (Fin r.components.length)}
    (hg : g ∈ r.glueSymmetries) (k : Fin r.components.length) :
    r.componentType (g k) = r.componentType k :=
  (r.mem_glueSymmetries_iff.mp hg).fst k

/-- **A glue symmetry preserves the glue subgroup**: permuting the components of a glue word
along a glue symmetry keeps it in the glue subgroup `H_r` exactly when it lies there. -/
theorem piGlueAlphabetCongr_mem_glueSubgroup_iff {g : Equiv.Perm (Fin r.components.length)}
    (hg : g ∈ r.glueSymmetries) (w : r.glueModule) :
    piGlueAlphabetCongr r.componentType r.isSimplyLaced_componentType g
        (r.componentType_apply_of_mem_glueSymmetries hg) w ∈ r.glueSubgroup ↔
      w ∈ r.glueSubgroup :=
  (r.mem_glueSymmetries_iff.mp hg).snd w

/-- **Glue symmetries from the digit words**: a permutation preserving the component types is a
glue symmetry of a row as soon as it permutes the digit words of the row, in the sense that the
word with digits `d ∘ g` is a digit word exactly when the word with digits `d` is.  Such a
permutation preserves the glue generators, hence the subgroup they generate. -/
theorem mem_glueSymmetries_of_glueWords {g : Equiv.Perm (Fin r.components.length)}
    (hg : ∀ k, r.componentType (g k) = r.componentType k)
    (hw : ∀ d : Fin r.components.length → ℕ,
      List.ofFn (d ∘ g) ∈ r.glueWords ↔ List.ofFn d ∈ r.glueWords) :
    g ∈ r.glueSymmetries := by
  refine ⟨hg, fun w ↦ ?_⟩
  set φ := piGlueAlphabetCongr r.componentType r.isSimplyLaced_componentType g hg
    (hs := r.isSimplyLaced_componentType)
  have hgen : φ ⁻¹' r.glueGenerators = r.glueGenerators := by
    ext v
    rw [Set.mem_preimage, mem_glueGenerators_iff, mem_glueGenerators_iff,
      encodeGlueWord_piGlueAlphabetCongr_eq_ofFn, encodeGlueWord_def]
    exact hw fun i ↦ (((r.componentType i).glueLabelEquiv
      (r.isSimplyLaced_componentType i)).symm (v i)).val
  have hmap : r.glueSubgroup.map (φ : r.glueModule →+ r.glueModule) = r.glueSubgroup := by
    rw [glueSubgroup_def, AddMonoidHom.map_closure, AddMonoidHom.coe_ofClass]
    exact congrArg AddSubgroup.closure
      ((congrArg _ hgen.symm).trans (Set.image_preimage_eq _ (EquivLike.surjective φ)))
  have h := AddSubgroup.mem_map_iff_mem (f := (φ : r.glueModule →+ r.glueModule))
    (by rw [AddMonoidHom.coe_ofClass]; exact EquivLike.injective φ) (K := r.glueSubgroup) (x := w)
  rwa [hmap, AddMonoidHom.coe_ofClass] at h

/-- **Glue symmetries from the patterns**: a permutation preserving the component types is a glue
symmetry of a row as soon as the expansion of every pattern of the row is invariant under it. -/
theorem mem_glueSymmetries_of_forall_gluePatterns {g : Equiv.Perm (Fin r.components.length)}
    (hg : ∀ k, r.componentType (g k) = r.componentType k)
    (hp : ∀ p ∈ r.gluePatterns, ∀ d : Fin r.components.length → ℕ,
      List.ofFn (d ∘ g) ∈ p.expand ↔ List.ofFn d ∈ p.expand) :
    g ∈ r.glueSymmetries := by
  refine r.mem_glueSymmetries_of_glueWords hg fun d ↦ ?_
  simp only [mem_glueWords_iff_exists_ofFn]
  -- Reindex the expanded word `e` as `e ∘ g`, which ranges over all digit functions.
  refine ⟨fun ⟨p, hp', e, he, hd⟩ ↦ ⟨p, hp', e ∘ ⇑g⁻¹, ?_, ?_⟩,
    fun ⟨p, hp', e, he, hd⟩ ↦ ⟨p, hp', e ∘ g, (hp p hp' e).mpr he, ?_⟩⟩
  · rw [← hp p hp']
    simpa [Function.comp_assoc] using he
  · rw [← r.spanMode.ofFn_comp_mem_scalarOrbit_ofFn_comp_iff g]
    simpa [Function.comp_assoc] using hd
  · exact (r.spanMode.ofFn_comp_mem_scalarOrbit_ofFn_comp_iff g d e).mpr hd

/-! ### Glue symmetries act on the glued lattice -/

/-- The self-isometry of `N_r` induced by a glue symmetry `g`, reading the component in position
`k` from position `g k`. -/
private noncomputable def glueSymmetryIsometry {g : Equiv.Perm (Fin r.components.length)}
    (hg : g ∈ r.glueSymmetries) : IntegralLattice.Isometry r.lattice r.lattice :=
  (Isometry.ofEq (lattice_def r)).trans <|
    (gluedLatticeIsometryOfEq r.componentType r.isSimplyLaced_componentType r.valid_componentType
      r.glueSubgroup r.isIsotropic_glueSubgroup r.valid_componentType r.isIsotropic_glueSubgroup g
      (r.componentType_apply_of_mem_glueSymmetries hg)
      (r.piGlueAlphabetCongr_mem_glueSubgroup_iff hg)).trans
    (Isometry.ofEq (lattice_def r).symm)

/-- The isometry induced by a glue symmetry `g` reads the component in position `k` from position
`g k`. -/
private theorem glueSymmetryIsometry_apply {g : Equiv.Perm (Fin r.components.length)}
    (hg : g ∈ r.glueSymmetries) (x : ∀ i, Fin (r.componentType i).rank → ℚ)
    (k : Fin r.components.length) (j : Fin (r.componentType k).rank) :
    r.glueSymmetryIsometry hg x k j =
      x (g k)
        (Fin.cast (congrArg rank (r.componentType_apply_of_mem_glueSymmetries hg k)).symm j) := by
  rw [glueSymmetryIsometry, Isometry.trans_apply, Isometry.trans_apply, Isometry.ofEq_apply,
    Isometry.ofEq_apply]
  exact gluedLatticeIsometryOfEq_apply _ _ _ _ _ _ _ _ _ _ x k j

/-- Reading coordinates of `x` at equal positions, through casts of the coordinate index to their
ranks, gives the same value. -/
private theorem apply_cast_eq_apply_cast (x : ∀ i, Fin (r.componentType i).rank → ℚ)
    {a b : Fin r.components.length} (hab : a = b) {n : ℕ} (ha : n = (r.componentType a).rank)
    (hb : n = (r.componentType b).rank) (j : Fin n) :
    x a (Fin.cast ha j) = x b (Fin.cast hb j) := by
  subst hab
  -- The two casts now have the same source and target, so they agree by proof irrelevance.
  rfl

/-- **The glue symmetries of a row act on its lattice `N_r`** by permuting the components: a glue
symmetry `g` moves the component in position `k` to position `g k`. -/
noncomputable def latticeIsometryHom :
    r.glueSymmetries →* IntegralLattice.Isometry r.lattice r.lattice where
  toFun g := r.glueSymmetryIsometry (inv_mem g.2)
  map_one' := Isometry.ext fun x ↦ funext fun k ↦ funext fun j ↦ by
    rw [glueSymmetryIsometry_apply, Isometry.one_apply]
    exact (r.apply_cast_eq_apply_cast x (by simp) _ rfl j).trans
      (congrArg (x k) (Fin.cast_eq_self j))
  map_mul' g h := Isometry.ext fun x ↦ funext fun k ↦ funext fun j ↦ by
    rw [Isometry.mul_apply, glueSymmetryIsometry_apply, glueSymmetryIsometry_apply,
      glueSymmetryIsometry_apply, Fin.cast_cast]
    exact r.apply_cast_eq_apply_cast x (by simp) _ _ j

/-- The action of a glue symmetry `g` on `N_r` reads the component in position `k` from position
`g⁻¹ k`. -/
@[simp]
theorem latticeIsometryHom_apply (g : r.glueSymmetries)
    (x : ∀ i, Fin (r.componentType i).rank → ℚ) (k : Fin r.components.length)
    (j : Fin (r.componentType k).rank) :
    r.latticeIsometryHom g x k j =
      x ((g : Equiv.Perm _)⁻¹ k)
        (Fin.cast (congrArg rank (r.componentType_apply_of_mem_glueSymmetries (inv_mem g.2) k)).symm
          j) :=
  r.glueSymmetryIsometry_apply (inv_mem g.2) x k j

/-! ### The indicated symmetries of the table patterns -/

/-- **The indicated symmetries of the table patterns are glue symmetries.**  For every row other
than `A₅⁴ D₄`, the rotations of a marked block and the even permutations indicated by a pattern of
the row, read on the component positions, are glue symmetries of the row. -/
theorem mem_glueSymmetries_of_mem_symmetries {r : RootfulNiemeierType}
    (hr : r ≠ a5FourthD4) {p : GluePattern} (hp : p ∈ r.gluePatterns)
    {g : Equiv.Perm (Fin p.length)} (hg : g ∈ p.symmetries) :
    (finCongr (length_eq_of_mem_gluePatterns hp)).permCongr g ∈ r.glueSymmetries := by
  -- Enumerate the patterns of every row.
  cases r <;> simp only [gluePatterns] at hp <;>
    rcases hp with _ | ⟨_, _ | ⟨_, _ | ⟨_, _ | ⟨_, ⟨⟩⟩⟩⟩⟩
  all_goals first
    -- A literal word indicates only the identity.
    | rw [GluePattern.symmetries_literal, Subgroup.mem_bot] at hg
      subst hg
      exact one_mem _
    | exact absurd rfl hr
    -- The remaining rows have equal components, and only `D₄⁶` has a second pattern, the
    -- constant word `[111111]`, which is fixed by every permutation of the positions.
    | refine mem_glueSymmetries_of_forall_gluePatterns _ (fun k ↦ congrArg Subtype.val
        ((List.eq_of_mem_replicate (List.getElem_mem _)).trans
          (List.eq_of_mem_replicate (List.getElem_mem _)).symm)) fun q hq d ↦ ?_
      simp only [gluePatterns] at hq
      rcases hq with _ | ⟨_, _ | ⟨_, ⟨⟩⟩⟩
      all_goals first
        | exact GluePattern.ofFn_comp_permCongr_mem_expand_iff _ _ hg d
        | have h : [1, 1, 1, 1, 1, 1] = List.ofFn fun _ : Fin d4Sixth.components.length ↦ 1 := rfl
          simp only [GluePattern.expand_literal, Finset.mem_singleton, h, List.ofFn_inj]
          exact (Equiv.surjective _).injective_comp_right.eq_iff' rfl

/-- Build an element of `a5FourthD4.glueModule` from bounded Conway--Sloane digits on `Fin 5`. -/
private noncomputable def decodeA5FourthD4Tuple (d : Fin 5 → ℕ)
    (hd : ∀ i : Fin 5, d i < (a5FourthD4.componentType ⟨i.val, i.isLt⟩).glueLabelCount) :
    a5FourthD4.glueModule :=
  fun i ↦ (a5FourthD4.componentType i).glueLabelEquiv (a5FourthD4.isSimplyLaced_componentType i)
    ⟨d ⟨i.val, i.isLt⟩, hd ⟨i.val, i.isLt⟩⟩

private theorem encodeGlueWord_decodeA5FourthD4Tuple (d : Fin 5 → ℕ)
    (hd : ∀ i : Fin 5, d i < (a5FourthD4.componentType ⟨i.val, i.isLt⟩).glueLabelCount) :
    encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
        (decodeA5FourthD4Tuple d hd) =
      List.ofFn d :=
  encodeGlueWord_glueLabelEquiv a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
    fun i ↦ ⟨d ⟨i.val, i.isLt⟩, hd ⟨i.val, i.isLt⟩⟩

private theorem mem_glueSubgroup_decodeA5FourthD4Tuple (d : Fin 5 → ℕ)
    (hd : ∀ i : Fin 5, d i < (a5FourthD4.componentType ⟨i.val, i.isLt⟩).glueLabelCount)
    (hl : List.ofFn d ∈ a5FourthD4.glueWords) :
    decodeA5FourthD4Tuple d hd ∈ a5FourthD4.glueSubgroup := by
  rw [glueSubgroup_def]
  refine AddSubgroup.subset_closure ?_
  rw [mem_glueGenerators_iff, encodeGlueWord_decodeA5FourthD4Tuple]
  exact hl

/-- **The pure block rotation of `[2(024)0]` is not a glue symmetry of `A₅⁴ D₄`.**  Reindexing the
glue generator `[30302]` along `a5FourthD4ComponentPerm` without acting on the `D₄` component
produces `[33002]`, whose sum with `[33001]` is the nonzero word `[00003]` of glue minimum
`1 < 4`. -/
theorem a5FourthD4BlockPerm_notMem_glueSymmetries :
    a5FourthD4ComponentPerm ∉ a5FourthD4.glueSymmetries := by
  intro hg
  let w₁ := decodeA5FourthD4Tuple ![3, 3, 0, 0, 1] (by decide)
  let w₂ := decodeA5FourthD4Tuple ![3, 0, 3, 0, 2] (by decide)
  have hw₁ : w₁ ∈ a5FourthD4.glueSubgroup :=
    mem_glueSubgroup_decodeA5FourthD4Tuple ![3, 3, 0, 0, 1] (by decide) (by decide)
  have hw₂ : w₂ ∈ a5FourthD4.glueSubgroup :=
    mem_glueSubgroup_decodeA5FourthD4Tuple ![3, 0, 3, 0, 2] (by decide) (by decide)
  let w₂' : a5FourthD4.glueModule :=
    piGlueAlphabetCongr a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
      a5FourthD4ComponentPerm (a5FourthD4.componentType_apply_of_mem_glueSymmetries hg) w₂
  have hw₂' : w₂' ∈ a5FourthD4.glueSubgroup :=
    (a5FourthD4.piGlueAlphabetCongr_mem_glueSubgroup_iff hg w₂).mpr hw₂
  have hw₂'enc : encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
      w₂' = [3, 3, 0, 0, 2] := by
    rw [encodeGlueWord_piGlueAlphabetCongr_eq_ofFn]
    simp only [w₂, decodeA5FourthD4Tuple, Equiv.symm_apply_apply]
    change (List.ofFn fun k : Fin 5 ↦ ![3, 0, 3, 0, 2] (a5FourthD4BlockPerm k)) = [3, 3, 0, 0, 2]
    simp only [a5FourthD4BlockPerm_apply]
    decide
  have henc : encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
      (w₂' + w₁) = [0, 0, 0, 0, 3] := by
    rw [encodeGlueWord_add, hw₂'enc, encodeGlueWord_decodeA5FourthD4Tuple]
    decide
  have hne : w₂' + w₁ ≠ 0 := fun h0 ↦ by
    rw [h0, encodeGlueWord_zero] at henc
    exact absurd henc (by decide)
  have hmin := four_le_sum_glueMinimum_of_mem_glueSubgroup a5FourthD4 (add_mem hw₂' hw₁) hne
  rw [← glueWordMinimum_encodeGlueWord, henc] at hmin
  have hlt : glueWordMinimum a5FourthD4.componentType [0, 0, 0, 0, 3] < 4 := by decide +kernel
  exact not_lt_of_ge hmin hlt

/-- **The indicated symmetries of every table pattern act on the lattice of its row.**  On every
row other than `A₅⁴ D₄`, a pattern symmetry `g` acts purely by permuting the components (`k` moves
to `g k`); on `A₅⁴ D₄`, the cyclic block rotation of `[2(024)0]` is coupled with `D₄` triality on
component `4` via `a5FourthD4PatternIsometryHom`. -/
noncomputable def patternIsometryHom {r : RootfulNiemeierType} {p : GluePattern}
    (hp : p ∈ r.gluePatterns) :
    p.symmetries →* IntegralLattice.Isometry r.lattice r.lattice :=
  if hr : r = a5FourthD4 then
    hr ▸ a5FourthD4PatternIsometryHom (hr ▸ hp)
  else
    r.latticeIsometryHom.comp <|
      ((finCongr (length_eq_of_mem_gluePatterns hp)).permCongrHom.toMonoidHom.comp
        p.symmetries.subtype).codRestrict r.glueSymmetries fun g ↦
          mem_glueSymmetries_of_mem_symmetries hr hp g.2

/-- On `A₅⁴ D₄`, `patternIsometryHom` agrees with `a5FourthD4PatternIsometryHom`. -/
@[simp]
theorem patternIsometryHom_a5FourthD4 {p : GluePattern} (hp : p ∈ a5FourthD4.gluePatterns) :
    patternIsometryHom hp = a5FourthD4PatternIsometryHom hp := by
  simp [patternIsometryHom]

/-- On every row other than `A₅⁴ D₄`, `patternIsometryHom` factors through `latticeIsometryHom` and
`glueSymmetries`. -/
theorem patternIsometryHom_of_ne {r : RootfulNiemeierType} (hr : r ≠ a5FourthD4)
    {p : GluePattern} (hp : p ∈ r.gluePatterns) :
    patternIsometryHom hp =
      r.latticeIsometryHom.comp
        (((finCongr (length_eq_of_mem_gluePatterns hp)).permCongrHom.toMonoidHom.comp
          p.symmetries.subtype).codRestrict r.glueSymmetries fun g ↦
            mem_glueSymmetries_of_mem_symmetries hr hp g.2) :=
  dite_eq_right hr

/-- On every row other than `A₅⁴ D₄`, the action of an indicated pattern symmetry `g` on `N_r`
reads the component in position `k` from position `g⁻¹ k`. -/
@[simp]
theorem patternIsometryHom_apply_of_ne {r : RootfulNiemeierType} (hr : r ≠ a5FourthD4)
    {p : GluePattern} (hp : p ∈ r.gluePatterns) (g : p.symmetries)
    (x : ∀ i, Fin (r.componentType i).rank → ℚ) (k : Fin r.components.length)
    (j : Fin (r.componentType k).rank) :
    patternIsometryHom hp g x k j =
      x (((finCongr (length_eq_of_mem_gluePatterns hp)).permCongr g)⁻¹ k)
        (Fin.cast (congrArg rank (r.componentType_apply_of_mem_glueSymmetries
          (inv_mem (mem_glueSymmetries_of_mem_symmetries hr hp g.2)) k)).symm j) := by
  rw [patternIsometryHom_of_ne hr hp]
  exact r.latticeIsometryHom_apply _ x k j

end RootfulNiemeierType

end TauCeti
