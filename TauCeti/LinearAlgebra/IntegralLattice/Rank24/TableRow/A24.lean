module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Niemeier
public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeA.Dual

/-!
# The table lattice `A₂₄` in classical coordinates

The fourth row of Conway--Sloane's table of rootful rank-24 lattices glues the one-component
root lattice `A₂₄` along the subgroup generated by the glue word `[5]`.  The discriminant group
of `A₂₄` is cyclic of order `25`, so this subgroup is its proper subgroup of order `5`.  This file
makes the table lattice `TauCeti.niemeierA24 = TauCeti.RootfulNiemeierType.a24.lattice`
explicit in the classical coordinates `A₂₄ = {y ∈ ℤ²⁵ | ∑ yⱼ = 0}`:

```text
niemeierA24 = {y ∈ ℚ²⁵ | ∑ yⱼ = 0, yᵢ - yⱼ ∈ ℤ, 5 yⱼ ∈ ℤ},
```

with the standard dot product.  The coordinate change `TauCeti.a24ZeroSumEquiv` applies
`TauCeti.IntegralLattice.typeAIsometryZeroSumLattice`, which carries the `i`-th simple root to
`eᵢ - eᵢ₊₁`, to the simple-root coordinates of the sole component.

The proof goes through the table's actual decoded glue subgroup: its only generator is the
decoded word `[5]` (`TauCeti.RootfulNiemeierType.glueSubgroup_a24`), whose discriminant class
is `5 ω₁`, and the classes of the subgroup generated by `5 ω₁` are described in classical
coordinates by `TauCeti.IntegralLattice.mk_mem_zmultiples_nsmul_typeAFundamentalWeightClass_iff`.

The lattice is generated by `A₂₄` and the glue vector `TauCeti.a24GlueVector`, whose classical
coordinates are `4/5` five times and `-1/5` twenty times.  It lies in the class `5 ω₁` and has
norm `4 = 5 · 20 / 25`, the minimum norm of that class computed in
`TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeA.CosetMinimum`.  Unimodularity and the
root-sublattice theorem for `TauCeti.niemeierA24` are the row-`A₂₄` specializations of the uniform
table statements `TauCeti.RootfulNiemeierType.isUnimodular_lattice` and
`TauCeti.RootfulNiemeierType.span_vectorsOfNorm_two_lattice`.

## Main declarations

* `TauCeti.a24ZeroSumEquiv`: classical coordinates on the ambient space of the row.
* `TauCeti.RootfulNiemeierType.glueSubgroup_a24`: the table glue subgroup is generated by the
  word `[5]`.
* `TauCeti.mem_niemeierA24_carrier_iff`: the carrier in classical coordinates.
* `TauCeti.niemeierA24_form_eq_dotProduct`: the form is the dot product of classical coordinates.
* `TauCeti.niemeierA24_carrier_eq_sup_span`: the lattice is generated by `A₂₄` and the norm-`4`
  glue vector `TauCeti.a24GlueVector`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed.,
  Chapter 4, §6.1, and Chapter 16, §1, Table 16.1.
-/

public section

namespace TauCeti

open IntegralLattice DynkinType

/-- The `A₂₄` row has a single component position. -/
local instance : Unique (Fin RootfulNiemeierType.a24.components.length) :=
  inferInstanceAs (Unique (Fin 1))

/-! ### The glue subgroup -/

namespace RootfulNiemeierType

/-- **The glue word `[5]`** of the row `A₂₄`: the label `5` of the alphabet `ℤ/25`. -/
noncomputable def a24GlueWord : a24.glueModule :=
  fun i ↦ (a24.componentType i).glueLabelEquiv (a24.isSimplyLaced_componentType i)
    ⟨5, by fin_cases i; decide⟩

/-- The Conway--Sloane digits of `a24GlueWord` are `[5]`. -/
@[simp]
theorem encodeGlueWord_a24GlueWord :
    encodeGlueWord a24.componentType a24.isSimplyLaced_componentType a24GlueWord = [5] := by
  rw [encodeGlueWord_def]
  simp only [a24GlueWord, Equiv.symm_apply_apply]
  -- The digit list of a one-component word is computed by evaluation.
  rfl

/-- The only glue generator of the row `A₂₄` is the decoded word `[5]`. -/
theorem glueGenerators_a24 : a24.glueGenerators = {a24GlueWord} := by
  ext w
  have hwords : a24.glueWords = {[5]} := by decide
  rw [mem_glueGenerators_iff, hwords, Finset.mem_singleton, ← encodeGlueWord_a24GlueWord,
    Set.mem_singleton_iff]
  exact (encodeGlueWord_injective _ _).eq_iff

/-- **The table glue subgroup of `A₂₄` is the cyclic subgroup generated by `[5]`.** -/
theorem glueSubgroup_a24 : a24.glueSubgroup = AddSubgroup.zmultiples a24GlueWord := by
  rw [glueSubgroup_def, AddSubgroup.zmultiples_eq_closure, glueGenerators_a24]

end RootfulNiemeierType

open RootfulNiemeierType (a24GlueWord glueGenerators_a24 glueSubgroup_a24)

/-! ### Comparison with the simple-root model of `A₂₄` -/

/-- The sole component of the row is `A₂₄`. -/
private theorem componentType_a24 : RootfulNiemeierType.a24.componentType default = A 24 := (rfl)

/-- The root lattice of the sole component is the simple-root model `typeARootLattice 24`. -/
private noncomputable def a24ComponentIsometry :
    Isometry ((RootfulNiemeierType.a24.componentType default).rootLattice
      (RootfulNiemeierType.a24.isSimplyLaced_componentType default)) (typeARootLattice 24) :=
  ((RootfulNiemeierType.a24.componentType default).rootLatticeIsometryOfEq _
    componentType_a24 (by decide)).trans (Isometry.ofEq (rootLattice_A 24 _))

/-- The discriminant group of the row's root lattice is that of `typeARootLattice 24`. -/
private noncomputable def a24DiscriminantGroupEquiv :
    RootfulNiemeierType.a24.rootLattice.DiscriminantGroup ≃ₗ[ℤ]
      (typeARootLattice 24).DiscriminantGroup :=
  (discriminantGroupPiEquiv _).trans ((LinearEquiv.piUnique ℤ _).trans
    a24ComponentIsometry.discriminantGroupEquiv)

private theorem a24DiscriminantGroupEquiv_apply
    (c : RootfulNiemeierType.a24.rootLattice.DiscriminantGroup) :
    a24DiscriminantGroupEquiv c =
      a24ComponentIsometry.discriminantGroupEquiv (discriminantGroupPiEquiv _ c default) :=
  (rfl)

private theorem a24DiscriminantGroupEquiv_mk
    (x : RootfulNiemeierType.a24.rootLattice.dualCarrier) :
    a24DiscriminantGroupEquiv (Submodule.Quotient.mk x) = Submodule.Quotient.mk
      (a24ComponentIsometry.dualCarrierEquiv (piDualCarrierEquiv _ x default)) := by
  rw [a24DiscriminantGroupEquiv_apply, discriminantGroupPiEquiv_mk,
    Isometry.discriminantGroupEquiv_mk]

/-- The glue word `[5]` names the class `5 ω₁`. -/
private theorem a24DiscriminantGroupEquiv_glueWordIsometry :
    a24DiscriminantGroupEquiv (glueWordIsometry RootfulNiemeierType.a24.componentType
        RootfulNiemeierType.a24.isSimplyLaced_componentType
        RootfulNiemeierType.a24.valid_componentType a24GlueWord) =
      5 • typeAFundamentalWeightClass 24 := by
  -- The glue isometry lands in the discriminant quadratic module, whose carrier is only
  -- definitionally the discriminant group, and `rootLattice_A` compares lattices on the
  -- definitionally equal spaces `Fin (A 24).rank → ℚ` and `Fin 24 → ℚ`.  The steps are
  -- therefore chained as terms, which are checked up to definitional equality.
  refine (a24DiscriminantGroupEquiv_apply _).trans ?_
  rw [discriminantGroupPiEquiv_glueWordIsometry]
  have hA : (A 24).IsSimplyLaced := by decide
  have hvA : (A 24).Valid := by decide
  -- Identify the label of the sole component with the label `5` of `A₂₄`.
  have h := (glueAlphabetIsometry_ofEq componentType_a24
    (RootfulNiemeierType.a24.valid_componentType default) hvA
    (RootfulNiemeierType.a24.isSimplyLaced_componentType default) hA (a24GlueWord default)).trans
    (Isometry.discriminantQuadraticIsometry_apply _ _ _)
  have hlabel : FiniteQuadraticModule.Isometry.ofEq
      (glueAlphabet_congr componentType_a24
        (RootfulNiemeierType.a24.isSimplyLaced_componentType default) hA) (a24GlueWord default) =
      (5 : ZMod 25) :=
    (FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans ((cast_eq _ _).trans
      ((glueLabelEquiv_A 24 hA ⟨5, by decide⟩).trans (Nat.cast_ofNat (R := ZMod 25) (n := 5))))
  rw [hlabel] at h
  refine (LinearEquiv.congr_fun (Isometry.discriminantGroupEquiv_trans
    ((RootfulNiemeierType.a24.componentType default).rootLatticeIsometryOfEq _
      componentType_a24 hA) (Isometry.ofEq (rootLattice_A 24 hA))) _).trans ?_
  refine (congrArg (Isometry.ofEq (rootLattice_A 24 hA)).discriminantGroupEquiv h.symm).trans ?_
  refine (congrArg (Isometry.ofEq (rootLattice_A 24 hA)).discriminantGroupEquiv
    (glueAlphabetIsometry_A_apply 24 hvA hA 5)).trans ?_
  -- The two transports along `rootLattice_A` cancel.
  have hsymm : (Isometry.ofEq (rootLattice_A 24 hA).symm).discriminantGroupEquiv
      (typeADiscriminantGroupEquiv 24 5) =
      (Isometry.ofEq (rootLattice_A 24 hA)).discriminantGroupEquiv.symm
        (typeADiscriminantGroupEquiv 24 5) :=
    (congrArg (fun e ↦ Isometry.discriminantGroupEquiv e (typeADiscriminantGroupEquiv 24 5))
      (Isometry.symm_ofEq _).symm).trans
      (LinearEquiv.congr_fun (Isometry.discriminantGroupEquiv_symm _) _)
  exact ((congrArg _ hsymm).trans (LinearEquiv.apply_symm_apply _ _)).trans
    (typeADiscriminantGroupEquiv_apply 24 5)

/-! ### Classical coordinates -/

/-- **Classical coordinates on the ambient space of the row `A₂₄`**: the simple-root
coordinates of the sole component, identified with the hyperplane of coordinate sum zero in
`ℚ²⁵` by `TauCeti.IntegralLattice.typeAIsometryZeroSumLattice`. -/
noncomputable def a24ZeroSumEquiv :
    (∀ i, Fin (RootfulNiemeierType.a24.componentType i).rank → ℚ) ≃ₗ[ℚ]
      singleParityCheckCode ℚ (Fin 25) :=
  (LinearEquiv.piUnique ℚ _).trans
    ((a24ComponentIsometry : _ ≃ₗ[ℚ] Fin 24 → ℚ).trans (typeAIsometryZeroSumLattice 24 : _ ≃ₗ[ℚ] _))

/-- The classical coordinates of a vector are those of its simple-root coordinates in the sole
component. -/
theorem a24ZeroSumEquiv_apply (x : ∀ i, Fin (RootfulNiemeierType.a24.componentType i).rank → ℚ) :
    a24ZeroSumEquiv x =
      typeAIsometryZeroSumLattice 24 (fun j ↦ x ⟨0, by decide⟩ (Fin.cast (by decide) j)) := by
  refine congrArg (typeAIsometryZeroSumLattice 24) (funext fun j ↦ ?_)
  exact (congrFun ((Isometry.trans_apply _ _ _).trans (Isometry.ofEq_apply _ _)) j).trans
    ((RootfulNiemeierType.a24.componentType default).rootLatticeIsometryOfEq_apply _
      componentType_a24 _ (x default) j)

private theorem mem_dualCarrier_a24_iff
    (x : ∀ i, Fin (RootfulNiemeierType.a24.componentType i).rank → ℚ) :
    x ∈ RootfulNiemeierType.a24.rootLattice.dualCarrier ↔
      a24ComponentIsometry (x default) ∈ (typeARootLattice 24).dualCarrier := by
  rw [mem_dualCarrier_pi_iff, Unique.forall_iff, a24ComponentIsometry.apply_mem_dualCarrier_iff]

/-- **The carrier of `A₂₄` in classical coordinates**: a vector lies in the table lattice
exactly when its classical coordinates differ pairwise by integers and are multiples of `1/5`. -/
theorem mem_niemeierA24_carrier_iff
    (x : ∀ i, Fin (RootfulNiemeierType.a24.componentType i).rank → ℚ) :
    x ∈ niemeierA24.carrier ↔
      (∀ i j, ∃ m : ℤ,
        (a24ZeroSumEquiv x : Fin 25 → ℚ) i - (a24ZeroSumEquiv x : Fin 25 → ℚ) j = m) ∧
        ∀ i, ∃ m : ℤ, 5 * (a24ZeroSumEquiv x : Fin 25 → ℚ) i = m := by
  have hdual := mem_dualCarrier_a24_iff x
  -- The glue word of the class of `x` lies in `⟨[5]⟩` exactly when the class of the component
  -- lies in `⟨5 ω₁⟩`.
  have hclass (hx : x ∈ RootfulNiemeierType.a24.rootLattice.dualCarrier) :
      (glueWordIsometry RootfulNiemeierType.a24.componentType
          RootfulNiemeierType.a24.isSimplyLaced_componentType
          RootfulNiemeierType.a24.valid_componentType).toAddEquiv.symm
          (Submodule.Quotient.mk ⟨x, hx⟩) ∈ RootfulNiemeierType.a24.glueSubgroup ↔
        (Submodule.Quotient.mk ⟨_, hdual.mp hx⟩ : (typeARootLattice 24).DiscriminantGroup) ∈
          AddSubgroup.zmultiples (5 • typeAFundamentalWeightClass 24) := by
    let e := (glueWordIsometry RootfulNiemeierType.a24.componentType
      RootfulNiemeierType.a24.isSimplyLaced_componentType
      RootfulNiemeierType.a24.valid_componentType).toAddEquiv
    let c : RootfulNiemeierType.a24.rootLattice.DiscriminantGroup := Submodule.Quotient.mk ⟨x, hx⟩
    have hE : a24DiscriminantGroupEquiv c = Submodule.Quotient.mk ⟨_, hdual.mp hx⟩ :=
      (a24DiscriminantGroupEquiv_mk _).trans (congrArg _ (Subtype.ext (by simp)))
    -- Transport the cyclic subgroup `⟨[5]⟩` along the composite equivalence.
    let φ := e.trans a24DiscriminantGroupEquiv.toAddEquiv
    rw [glueSubgroup_a24, ← AddSubgroup.mem_map_iff_mem (f := φ.toAddMonoidHom) φ.injective,
      AddMonoidHom.map_zmultiples]
    exact Iff.of_eq (congrArg₂ (· ∈ AddSubgroup.zmultiples ·)
      ((congrArg a24DiscriminantGroupEquiv (e.apply_symm_apply c)).trans hE)
      a24DiscriminantGroupEquiv_glueWordIsometry)
  rw [RootfulNiemeierType.mem_lattice_carrier_iff]
  constructor
  · rintro ⟨hx, hw⟩
    have hx' := hdual.mp hx
    exact ⟨(mem_dualCarrier_typeARootLattice_iff _).mp hx',
      (mk_mem_zmultiples_nsmul_typeAFundamentalWeightClass_iff (by norm_num) ⟨_, hx'⟩).mp
        ((hclass hx).mp hw)⟩
  · rintro ⟨h₁, h₂⟩
    have hx' := (mem_dualCarrier_typeARootLattice_iff _).mpr h₁
    exact ⟨hdual.mpr hx', (hclass _).mpr
      ((mk_mem_zmultiples_nsmul_typeAFundamentalWeightClass_iff (by norm_num) ⟨_, hx'⟩).mpr h₂)⟩

/-- **The form of `A₂₄` in classical coordinates** is the standard dot product. -/
theorem niemeierA24_form_eq_dotProduct
    (x y : ∀ i, Fin (RootfulNiemeierType.a24.componentType i).rank → ℚ) :
    niemeierA24.form x y =
      (a24ZeroSumEquiv x : Fin 25 → ℚ) ⬝ᵥ (a24ZeroSumEquiv y : Fin 25 → ℚ) := by
  rw [RootfulNiemeierType.lattice_form, pi_form, piForm_apply, Fintype.sum_unique,
    ← a24ComponentIsometry.map_app, ← (typeAIsometryZeroSumLattice 24).map_app,
    zeroSumLattice_form, zeroSumForm_apply]
  -- Both sides evaluate the same composite coordinate map.
  rfl

/-! ### A glue vector -/

/-- The classical coordinates `(4/5, …, 4/5, -1/5, …, -1/5)` of the glue vector, with five
entries `4/5`. -/
private def a24GlueCoord : Fin 25 → ℚ := fun j ↦ if j.val < 5 then 4 / 5 else -1 / 5

private theorem a24GlueCoord_mem : a24GlueCoord ∈ singleParityCheckCode ℚ (Fin 25) := by
  rw [mem_singleParityCheckCode]
  simp only [a24GlueCoord, Fin.sum_univ_succ, Fin.val_zero, Fin.val_succ]
  norm_num

/-- **The glue vector of `A₂₄`**: the vector whose classical coordinates are `4/5` in the first
five positions and `-1/5` in the remaining twenty.  It lies in the class `5 ω₁` named by the
glue word `[5]`. -/
noncomputable def a24GlueVector : ∀ i, Fin (RootfulNiemeierType.a24.componentType i).rank → ℚ :=
  a24ZeroSumEquiv.symm ⟨a24GlueCoord, a24GlueCoord_mem⟩

/-- The classical coordinates of the glue vector. -/
@[simp]
theorem a24ZeroSumEquiv_a24GlueVector_apply (j : Fin 25) :
    (a24ZeroSumEquiv a24GlueVector : Fin 25 → ℚ) j = if j.val < 5 then 4 / 5 else -1 / 5 := by
  rw [a24GlueVector, LinearEquiv.apply_symm_apply]
  -- The remaining goal unfolds the private coordinate vector `a24GlueCoord`.
  rfl

/-- The glue vector lies in the table lattice `A₂₄`. -/
theorem a24GlueVector_mem_niemeierA24_carrier : a24GlueVector ∈ niemeierA24.carrier := by
  rw [mem_niemeierA24_carrier_iff]
  simp only [a24ZeroSumEquiv_a24GlueVector_apply]
  refine ⟨fun i j ↦ ?_, fun i ↦ ?_⟩
  · by_cases hi : i.val < 5 <;> by_cases hj : j.val < 5
    · exact ⟨0, by norm_num [hi, hj]⟩
    · exact ⟨1, by norm_num [hi, hj]⟩
    · exact ⟨-1, by norm_num [hi, hj]⟩
    · exact ⟨0, by norm_num [hi, hj]⟩
  · by_cases hi : i.val < 5
    · exact ⟨4, by norm_num [hi]⟩
    · exact ⟨-1, by norm_num [hi]⟩

/-- **The glue vector has norm `4`**: `5 · (4/5)² + 20 · (1/5)² = 4`. -/
theorem niemeierA24_form_a24GlueVector_self :
    niemeierA24.form a24GlueVector a24GlueVector = 4 := by
  rw [niemeierA24_form_eq_dotProduct]
  simp only [dotProduct, a24ZeroSumEquiv_a24GlueVector_apply, Fin.sum_univ_succ, Fin.val_zero,
    Fin.val_succ]
  norm_num

/-- **Generators of `A₂₄`**: the table lattice is spanned by the root lattice `A₂₄` and the glue
vector. -/
theorem niemeierA24_carrier_eq_sup_span :
    niemeierA24.carrier =
      RootfulNiemeierType.a24.rootLattice.carrier ⊔ Submodule.span ℤ {a24GlueVector} := by
  obtain ⟨hv, -⟩ :=
    (RootfulNiemeierType.mem_lattice_carrier_iff _ _).mp a24GlueVector_mem_niemeierA24_carrier
  have hv' := (mem_dualCarrier_a24_iff _).mp hv
  -- The glue vector lies in the class `5 ω₁`, read off its classical coordinates.
  have hcoord : (Submodule.Quotient.mk ⟨_, hv'⟩ : (typeARootLattice 24).DiscriminantGroup) =
      (5 : ℤ) • typeAFundamentalWeightClass 24 := by
    refine (mk_eq_zsmul_typeAFundamentalWeightClass_iff_forall_exists_intCast_sub _ 5).mpr
      fun j ↦ ?_
    have hj : (typeAIsometryZeroSumLattice 24 (a24ComponentIsometry (a24GlueVector default)) :
        Fin 25 → ℚ) j = if j.val < 5 then 4 / 5 else -1 / 5 :=
      a24ZeroSumEquiv_a24GlueVector_apply j
    by_cases h5 : j.val < 5
    · exact ⟨1, by norm_num [hj, h5]⟩
    · exact ⟨0, by norm_num [hj, h5]⟩
  have hclass : (Submodule.Quotient.mk ⟨a24GlueVector, hv⟩ :
      RootfulNiemeierType.a24.rootLattice.DiscriminantGroup) =
      glueWordIsometry RootfulNiemeierType.a24.componentType
        RootfulNiemeierType.a24.isSimplyLaced_componentType
        RootfulNiemeierType.a24.valid_componentType a24GlueWord := by
    refine a24DiscriminantGroupEquiv.injective ?_
    refine (a24DiscriminantGroupEquiv_mk _).trans ?_
    refine (congrArg Submodule.Quotient.mk (Subtype.ext (by simp) :
      _ = (⟨_, hv'⟩ : (typeARootLattice 24).dualCarrier))).trans ?_
    exact (hcoord.trans (natCast_zsmul _ 5)).trans a24DiscriminantGroupEquiv_glueWordIsometry.symm
  refine (RootfulNiemeierType.lattice_carrier_eq_sup_span _ (fun _ ↦ ⟨_, hv⟩)
    fun w hw ↦ ?_).trans ?_
  · rw [glueGenerators_a24, Set.mem_singleton_iff] at hw
    subst hw
    exact hclass
  · rw [glueGenerators_a24, Set.image_singleton]

end TauCeti
