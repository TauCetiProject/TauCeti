module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Niemeier
public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeD.Plus

/-!
# Explicit carriers for the `D₁₆ E₈` table lattice

The second Conway--Sloane row adjoins the spinor of its `D₁₆` component and does
not enlarge its `E₈` component.  Its canonical computable digit-word representative
`RootfulNiemeierType.d16e8.glueDigitsVector [1, 0]` carries the spinor representative of `D₁₆` on
the first component and `0` on `E₈`, and the table lattice is the union of `D₁₆ ⊥ E₈` and its
translate by this vector (`mem_niemeierD16E8_carrier_iff`).

In checkerboard coordinates on the first component and simple-root coordinates
on the second, membership is therefore membership in `D₁₆⁺` and integrality of
the eight remaining coordinates (`mem_niemeierD16E8_carrier_iff_checkerboard`).
Dual-lattice membership, norm `4`, and the generator span of `niemeierD16E8` follow directly from
the uniform `RootfulNiemeierType` API in `TauCeti.LinearAlgebra.IntegralLattice.Rank24.Niemeier`.

## Main declarations

* `TauCeti.map_glueSubgroup_d16e8_eq_zmultiples`: the discriminant glue subgroup is generated by
  the class of `RootfulNiemeierType.d16e8.glueDigitsVector [1, 0]`.
* `TauCeti.mem_niemeierD16E8_carrier_iff`: two-coset decomposition of `niemeierD16E8`.
* `TauCeti.mem_niemeierD16E8_carrier_iff_checkerboard`: characterization of `niemeierD16E8` via
  `D₁₆⁺` and integral `E₈` coordinates.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*,
  3rd ed., Chapter 4 §8.1 and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti

open IntegralLattice DynkinType

private noncomputable def spinorWord : RootfulNiemeierType.d16e8.glueModule :=
  fun i ↦ (RootfulNiemeierType.d16e8.componentType i).glueLabelEquiv
    (RootfulNiemeierType.d16e8.isSimplyLaced_componentType i)
      ⟨if i.val = 0 then 1 else 0, by fin_cases i <;> decide⟩

private theorem encode_spinorWord :
    encodeGlueWord RootfulNiemeierType.d16e8.componentType
      RootfulNiemeierType.d16e8.isSimplyLaced_componentType spinorWord = [1, 0] := by
  rw [encodeGlueWord_def]
  simp only [spinorWord, Equiv.symm_apply_apply]
  -- `List.ofFn` evaluates the two digits at the table's component positions.
  rfl

private theorem glueSubgroup_d16e8 :
    RootfulNiemeierType.d16e8.glueSubgroup = AddSubgroup.zmultiples spinorWord :=
  RootfulNiemeierType.d16e8.glueSubgroup_eq_zmultiples (by decide) encode_spinorWord

private theorem two_nsmul_spinorWord : 2 • spinorWord = 0 := by
  apply encodeGlueWord_injective RootfulNiemeierType.d16e8.componentType
    RootfulNiemeierType.d16e8.isSimplyLaced_componentType
  rw [two_nsmul, encodeGlueWord_add, encode_spinorWord, encodeGlueWord_zero]
  decide

private theorem mem_glueSubgroup_d16e8_iff (w : RootfulNiemeierType.d16e8.glueModule) :
    w ∈ RootfulNiemeierType.d16e8.glueSubgroup ↔ w = 0 ∨ w = spinorWord := by
  rw [glueSubgroup_d16e8, AddSubgroup.mem_zmultiples_iff]
  constructor
  · rintro ⟨k, rfl⟩
    have h2 : (2 : ℤ) • spinorWord = 0 := by
      simpa only [two_zsmul, two_nsmul] using two_nsmul_spinorWord
    have hk : k = (k / 2) * 2 + k % 2 := by omega
    rw [hk, add_zsmul, mul_zsmul, h2, smul_zero, zero_add]
    rcases Int.emod_two_eq_zero_or_one k with h0 | h1
    · exact Or.inl (by rw [h0, zero_zsmul])
    · exact Or.inr (by rw [h1, one_zsmul])
  · rintro (rfl | rfl)
    · exact ⟨0, zero_zsmul _⟩
    · exact ⟨1, one_zsmul _⟩

/-- The table's decoded subgroup `[10]`, in the actual discriminant group of
`D₁₆ ⊥ E₈`, is generated by the class of `RootfulNiemeierType.d16e8.glueDigitsVector [1, 0]`. -/
theorem map_glueSubgroup_d16e8_eq_zmultiples :
    RootfulNiemeierType.d16e8.glueSubgroup.map
      (glueWordIsometry RootfulNiemeierType.d16e8.componentType
        RootfulNiemeierType.d16e8.isSimplyLaced_componentType
        RootfulNiemeierType.d16e8.valid_componentType).toAddEquiv.toAddMonoidHom =
      AddSubgroup.zmultiples (Submodule.Quotient.mk
        ⟨RootfulNiemeierType.d16e8.glueDigitsVector [1, 0],
          RootfulNiemeierType.d16e8.glueDigitsVector_mem_dualCarrier (by decide)⟩ :
          RootfulNiemeierType.d16e8.rootLattice.DiscriminantGroup) := by
  have hvec :
      RootfulNiemeierType.d16e8.glueDigitsVector [1, 0] =
        RootfulNiemeierType.d16e8.glueWordVector spinorWord := by
    rw [← encode_spinorWord, RootfulNiemeierType.glueDigitsVector_encodeGlueWord]
  have hmk :
      (Submodule.Quotient.mk
          ⟨RootfulNiemeierType.d16e8.glueDigitsVector [1, 0],
            RootfulNiemeierType.d16e8.glueDigitsVector_mem_dualCarrier (by decide)⟩ :
          RootfulNiemeierType.d16e8.rootLattice.DiscriminantGroup) =
        glueWordIsometry RootfulNiemeierType.d16e8.componentType
          RootfulNiemeierType.d16e8.isSimplyLaced_componentType
          RootfulNiemeierType.d16e8.valid_componentType spinorWord :=
    (congrArg Submodule.Quotient.mk (Subtype.ext hvec)).trans
      (RootfulNiemeierType.d16e8.mk_glueWordVector spinorWord
        (RootfulNiemeierType.d16e8.glueWordVector_mem_dualCarrier spinorWord))
  rw [glueSubgroup_d16e8, AddMonoidHom.map_zmultiples, hmk]
  -- The additive-hom coercion of `glueWordIsometry` evaluates as the isometry itself.
  rfl

/-- The literal two-coset carrier of the table lattice `D₁₆ E₈`. -/
theorem mem_niemeierD16E8_carrier_iff
    (x : ∀ i, Fin (RootfulNiemeierType.d16e8.componentType i).rank → ℚ) :
    x ∈ niemeierD16E8.carrier ↔
      x ∈ RootfulNiemeierType.d16e8.rootLattice.carrier ∨
        x - RootfulNiemeierType.d16e8.glueDigitsVector [1, 0] ∈
          RootfulNiemeierType.d16e8.rootLattice.carrier := by
  rw [niemeierD16E8, RootfulNiemeierType.mem_lattice_carrier_iff_exists_glueSubgroup]
  have hspinor :
      RootfulNiemeierType.d16e8.glueWordVector spinorWord =
        RootfulNiemeierType.d16e8.glueDigitsVector [1, 0] := by
    rw [← RootfulNiemeierType.glueDigitsVector_encodeGlueWord, encode_spinorWord]
  constructor
  · rintro ⟨w, hw, hmem⟩
    rcases (mem_glueSubgroup_d16e8_iff w).mp hw with rfl | rfl
    · exact Or.inl (by simpa only [RootfulNiemeierType.glueWordVector_zero, sub_zero] using hmem)
    · exact Or.inr (hspinor ▸ hmem)
  · rintro (hmem | hmem)
    · exact ⟨0, zero_mem _,
        by simpa only [RootfulNiemeierType.glueWordVector_zero, sub_zero] using hmem⟩
    · exact ⟨spinorWord, (mem_glueSubgroup_d16e8_iff spinorWord).mpr (Or.inr rfl),
        hspinor.symm ▸ hmem⟩

/-- In checkerboard coordinates on `D₁₆` and simple-root coordinates on `E₈`,
the table lattice consists exactly of `D₁₆⁺` and eight integral coordinates. -/
theorem mem_niemeierD16E8_carrier_iff_checkerboard
    (x : ∀ i, Fin (RootfulNiemeierType.d16e8.componentType i).rank → ℚ) :
    x ∈ niemeierD16E8.carrier ↔
      (rootLatticeIsometryCheckerboard 16 (by decide) (isSimplyLaced_D 16)) (x ⟨0, by decide⟩) ∈
        (checkerboardPlusCarrier 16).1 ∧
        ∀ j, ∃ z : ℤ, (z : ℚ) = x ⟨1, by decide⟩ j := by
  rw [mem_niemeierD16E8_carrier_iff]
  have hmem (y : ∀ i, Fin (RootfulNiemeierType.d16e8.componentType i).rank → ℚ) :
      y ∈ RootfulNiemeierType.d16e8.rootLattice.carrier ↔
        y ⟨0, by decide⟩ ∈ ((D 16).rootLattice (isSimplyLaced_D 16)).carrier ∧
        y ⟨1, by decide⟩ ∈ (E8.rootLattice (isSimplyLaced_E8)).carrier :=
    (mem_pi_carrier_iff _ _).trans Fin.forall_fin_two
  have h0 : RootfulNiemeierType.d16e8.glueDigitsVector [1, 0] ⟨0, by decide⟩ =
      (D 16).glueLabelVector 1 := rfl
  have h1 : RootfulNiemeierType.d16e8.glueDigitsVector [1, 0] ⟨1, by decide⟩ = 0 := rfl
  simp only [hmem, Pi.sub_apply, h0, h1, sub_zero]
  -- The explicit indices require converting the table components to `D 16` and `E8`.
  erw [← Isometry.apply_mem_carrier_iff
      (rootLatticeIsometryCheckerboard 16 (by decide) (isSimplyLaced_D 16)),
    ← (rootLatticeIsometryCheckerboard 16 (by decide) (isSimplyLaced_D 16)).apply_mem_carrier_iff,
    map_sub, rootLatticeIsometryCheckerboard_glueLabelVector_one 16 (by decide)
      (isSimplyLaced_D 16),
    checkerboardLattice_carrier, mem_rootLattice_carrier_iff,
    mem_checkerboardPlusCarrier_iff 16 (by decide), checkerboardLattice_carrier]
  exact or_and_right.symm

end TauCeti
