module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Niemeier
public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeD.Triality

/-!
# The triality-lifted cyclic symmetry of the Niemeier lattice `A₅⁴ D₄`

The table row `A₅⁴ D₄` (`TauCeti.RootfulNiemeierType.a5FourthD4`) has four `A₅` components in
positions `0, 1, 2, 3` and one `D₄` component in position `4`.  Its glue subgroup `H` is generated
additively by the rotations of the cyclic pattern `[2(024)0]` together with the three literal words
`[33001]`, `[30302]`, and `[30033]`.

The rotation `1 ↦ 2 ↦ 3 ↦ 1` of the marked `A₅` block (`a5FourthD4CyclicPerm`) cycles the three
rotations of `[2(024)0]`, but on the three literal words it moves the `A₅` labels `3` while leaving
the `D₄` labels `1, 2, 3` (`s, v, c`) fixed, so as a pure coordinate permutation it does not
preserve `H`.  Combining this rotation of the `A₅` components with `DynkinType.typeD4Triality` on
the `D₄` component cycles the `D₄` glue labels by `1 ↦ 2 ↦ 3 ↦ 1` (`s ↦ v ↦ c ↦ s`), sending
`[33001] ↦ [30302] ↦ [30033] ↦ [33001]` while fixing the `0` label of `[2(024)0]`.  The combined
automorphism of the glue module (`a5FourthD4CyclicGlueIsometry`) therefore preserves `H`, and by
the combined reindexing-and-componentwise naturality `DynkinType.gluedLatticePiCongrIsometry` it
lifts to an order-three self-isometry `a5FourthD4CyclicIsometry` of the Niemeier lattice
`a5FourthD4.lattice`.

This gives a faithful action of the cyclic subgroup generated by `a5FourthD4CyclicPerm`
(`a5FourthD4CyclicIsometryHom`) and hence of the indicated symmetries `p.symmetries` of every table
pattern `p ∈ a5FourthD4.gluePatterns` (`a5FourthD4PatternIsometryHom`) on `a5FourthD4.lattice`.

## Main declarations

* `TauCeti.RootfulNiemeierType.a5FourthD4CyclicPerm`: the three-cycle `1 ↦ 2 ↦ 3 ↦ 1` on the
  component positions of `A₅⁴ D₄`, fixing positions `0` and `4`.
* `TauCeti.RootfulNiemeierType.a5FourthD4CyclicGlueIsometry`: the induced order-three isometry of
  `a5FourthD4.glueModule` combining the `A₅` rotation with `D₄` triality, preserving
  `a5FourthD4.glueSubgroup` (`a5FourthD4CyclicGlueIsometry_mem_glueSubgroup_iff`).
* `TauCeti.RootfulNiemeierType.a5FourthD4CyclicIsometry`: the lifted order-three self-isometry of
  `a5FourthD4.lattice` (`a5FourthD4CyclicIsometry_pow_three`, `orderOf_a5FourthD4CyclicIsometry`).
* `TauCeti.RootfulNiemeierType.a5FourthD4CyclicIsometryHom`: the faithful action of
  `Subgroup.zpowers a5FourthD4CyclicPerm` on `a5FourthD4.lattice`.
* `TauCeti.RootfulNiemeierType.a5FourthD4PatternIsometryHom`: the faithful action of the indicated
  symmetries of every pattern of `A₅⁴ D₄` on `a5FourthD4.lattice`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §§3 and 7.1, and Chapter 16, §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType IntegralLattice

/-! ### Components and cyclic permutation of `A₅⁴ D₄` -/

/-- The row `A₅⁴ D₄` has five components. -/
theorem length_components_a5FourthD4 : a5FourthD4.components.length = 5 :=
  rfl

/-- The first four components of `A₅⁴ D₄` have type `A₅`. -/
theorem componentType_a5FourthD4_of_lt_four
    {k : Fin a5FourthD4.components.length} (hk : k.val < 4) :
    a5FourthD4.componentType k = .A 5 := by
  fin_cases k <;> simp_all [componentType, components]

/-- The fifth component of `A₅⁴ D₄` has type `D₄`. -/
theorem componentType_a5FourthD4_four : a5FourthD4.componentType ⟨4, by decide⟩ = .D 4 :=
  rfl

/-- The three-cycle `1 ↦ 2 ↦ 3 ↦ 1` of the marked `A₅` positions in `A₅⁴ D₄`, fixing position `0`
and the `D₄` position `4`.  This is the generator of the cyclic symmetries of `[2(024)0]`, read on
the component positions of `a5FourthD4`. -/
def a5FourthD4CyclicPerm : Equiv.Perm (Fin a5FourthD4.components.length) :=
  (finCongr (show (1 + 3) + 1 = a5FourthD4.components.length from
    length_components_a5FourthD4.symm)).permCongr
    (Equiv.Perm.finSumPerm
      (Equiv.Perm.finSumPerm (1 : Equiv.Perm (Fin 1)) (finRotate 3))
      (1 : Equiv.Perm (Fin 1)))

/-- `a5FourthD4CyclicPerm` is the cyclic rotation of the middle three positions conjugated along
any equality `(1 + 3) + 1 = a5FourthD4.components.length`. -/
theorem a5FourthD4CyclicPerm_def (h : (1 + 3) + 1 = a5FourthD4.components.length) :
    a5FourthD4CyclicPerm =
      (finCongr h).permCongr
        (Equiv.Perm.finSumPerm
          (Equiv.Perm.finSumPerm (1 : Equiv.Perm (Fin 1)) (finRotate 3))
          (1 : Equiv.Perm (Fin 1))) :=
  (rfl)

/-- On the middle three positions `1, 2, 3`, `a5FourthD4CyclicPerm` acts as `finRotate 3`. -/
private theorem a5FourthD4CyclicPerm_apply_mid (j : Fin 3) :
    a5FourthD4CyclicPerm ⟨j.val + 1, by rw [length_components_a5FourthD4]; omega⟩ =
      ⟨(finRotate 3 j).val + 1, by rw [length_components_a5FourthD4]; omega⟩ := by
  let h : (1 + 3) + 1 = a5FourthD4.components.length := length_components_a5FourthD4.symm
  apply Fin.ext
  rw [a5FourthD4CyclicPerm_def h, Equiv.permCongr_apply, finCongr_apply, Fin.val_cast]
  have hcast :
      (finCongr h).symm ⟨j.val + 1, by rw [length_components_a5FourthD4]; omega⟩ =
        Fin.castAdd 1 (Fin.natAdd 1 j) := by
    apply Fin.ext
    simp [Nat.add_comm]
  rw [hcast, Equiv.Perm.finSumPerm_apply_castAdd, Equiv.Perm.finSumPerm_apply_natAdd]
  simp [Nat.add_comm]

/-- The `A₅⁴ D₄` cyclic permutation fixes position `0`. -/
@[simp]
theorem a5FourthD4CyclicPerm_apply_zero :
    a5FourthD4CyclicPerm ⟨0, by decide⟩ = ⟨0, by decide⟩ := by
  let h : (1 + 3) + 1 = a5FourthD4.components.length := length_components_a5FourthD4.symm
  apply Fin.ext
  rw [a5FourthD4CyclicPerm_def h, Equiv.permCongr_apply, finCongr_apply, Fin.val_cast]
  have hcast : (finCongr h).symm ⟨0, by decide⟩ = Fin.castAdd 1 (Fin.castAdd 3 (0 : Fin 1)) := by
    apply Fin.ext
    simp
  rw [hcast, Equiv.Perm.finSumPerm_apply_castAdd, Equiv.Perm.finSumPerm_apply_castAdd]
  simp

/-- The `A₅⁴ D₄` cyclic permutation sends position `1` to position `2`. -/
@[simp]
theorem a5FourthD4CyclicPerm_apply_one :
    a5FourthD4CyclicPerm ⟨1, by decide⟩ = ⟨2, by decide⟩ := by
  simpa using a5FourthD4CyclicPerm_apply_mid 0

/-- The `A₅⁴ D₄` cyclic permutation sends position `2` to position `3`. -/
@[simp]
theorem a5FourthD4CyclicPerm_apply_two :
    a5FourthD4CyclicPerm ⟨2, by decide⟩ = ⟨3, by decide⟩ := by
  simpa using a5FourthD4CyclicPerm_apply_mid 1

/-- The `A₅⁴ D₄` cyclic permutation sends position `3` to position `1`. -/
@[simp]
theorem a5FourthD4CyclicPerm_apply_three :
    a5FourthD4CyclicPerm ⟨3, by decide⟩ = ⟨1, by decide⟩ := by
  simpa using a5FourthD4CyclicPerm_apply_mid 2

/-- The `A₅⁴ D₄` cyclic permutation fixes the `D₄` position `4`. -/
@[simp]
theorem a5FourthD4CyclicPerm_apply_four :
    a5FourthD4CyclicPerm ⟨4, by decide⟩ = ⟨4, by decide⟩ := by
  let h : (1 + 3) + 1 = a5FourthD4.components.length := length_components_a5FourthD4.symm
  apply Fin.ext
  rw [a5FourthD4CyclicPerm_def h, Equiv.permCongr_apply, finCongr_apply, Fin.val_cast]
  have hcast : (finCongr h).symm ⟨4, by decide⟩ = Fin.natAdd (1 + 3) (0 : Fin 1) := by
    apply Fin.ext
    simp
  rw [hcast, Equiv.Perm.finSumPerm_apply_natAdd]
  simp

/-- The inverse `A₅⁴ D₄` cyclic permutation fixes position `0`. -/
@[simp]
theorem a5FourthD4CyclicPerm_inv_apply_zero :
    a5FourthD4CyclicPerm⁻¹ ⟨0, by decide⟩ = ⟨0, by decide⟩ :=
  a5FourthD4CyclicPerm.symm_apply_eq.mpr a5FourthD4CyclicPerm_apply_zero.symm

/-- The inverse `A₅⁴ D₄` cyclic permutation sends position `1` to position `3`. -/
@[simp]
theorem a5FourthD4CyclicPerm_inv_apply_one :
    a5FourthD4CyclicPerm⁻¹ ⟨1, by decide⟩ = ⟨3, by decide⟩ :=
  a5FourthD4CyclicPerm.symm_apply_eq.mpr a5FourthD4CyclicPerm_apply_three.symm

/-- The inverse `A₅⁴ D₄` cyclic permutation sends position `2` to position `1`. -/
@[simp]
theorem a5FourthD4CyclicPerm_inv_apply_two :
    a5FourthD4CyclicPerm⁻¹ ⟨2, by decide⟩ = ⟨1, by decide⟩ :=
  a5FourthD4CyclicPerm.symm_apply_eq.mpr a5FourthD4CyclicPerm_apply_one.symm

/-- The inverse `A₅⁴ D₄` cyclic permutation sends position `3` to position `2`. -/
@[simp]
theorem a5FourthD4CyclicPerm_inv_apply_three :
    a5FourthD4CyclicPerm⁻¹ ⟨3, by decide⟩ = ⟨2, by decide⟩ :=
  a5FourthD4CyclicPerm.symm_apply_eq.mpr a5FourthD4CyclicPerm_apply_two.symm

/-- The inverse `A₅⁴ D₄` cyclic permutation fixes the `D₄` position `4`. -/
@[simp]
theorem a5FourthD4CyclicPerm_inv_apply_four :
    a5FourthD4CyclicPerm⁻¹ ⟨4, by decide⟩ = ⟨4, by decide⟩ :=
  a5FourthD4CyclicPerm.symm_apply_eq.mpr a5FourthD4CyclicPerm_apply_four.symm

/-- The `A₅⁴ D₄` cyclic permutation has cube equal to `1`. -/
@[simp]
theorem a5FourthD4CyclicPerm_pow_three : a5FourthD4CyclicPerm ^ 3 = 1 := by
  apply Equiv.ext
  intro k
  fin_cases k <;> simp [pow_three, Equiv.Perm.mul_apply]

/-- The `A₅⁴ D₄` cyclic permutation is nontrivial. -/
theorem a5FourthD4CyclicPerm_ne_one : a5FourthD4CyclicPerm ≠ 1 := by
  intro h
  have h1 := Equiv.congr_fun h ⟨1, by decide⟩
  simp at h1

/-- The `A₅⁴ D₄` cyclic permutation has order three. -/
@[simp]
theorem orderOf_a5FourthD4CyclicPerm : orderOf a5FourthD4CyclicPerm = 3 :=
  orderOf_eq_prime a5FourthD4CyclicPerm_pow_three a5FourthD4CyclicPerm_ne_one

/-- The `A₅⁴ D₄` cyclic permutation preserves component types. -/
theorem componentType_a5FourthD4CyclicPerm (k : Fin a5FourthD4.components.length) :
    a5FourthD4.componentType (a5FourthD4CyclicPerm k) = a5FourthD4.componentType k := by
  fin_cases k <;> simp <;> rfl

/-- The inverse `A₅⁴ D₄` cyclic permutation preserves component types. -/
theorem componentType_a5FourthD4CyclicPerm_inv (k : Fin a5FourthD4.components.length) :
    a5FourthD4.componentType (a5FourthD4CyclicPerm⁻¹ k) = a5FourthD4.componentType k := by
  fin_cases k <;> simp <;> rfl

/-- The inverse `A₅⁴ D₄` cyclic permutation maps the four `A₅` positions into themselves. -/
private theorem a5FourthD4CyclicPerm_inv_lt_four
    {k : Fin a5FourthD4.components.length} (hk : k.val < 4) :
    (a5FourthD4CyclicPerm⁻¹ k).val < 4 := by
  fin_cases k <;> simp_all

/-- Any component position with index `4` has type `D₄`. -/
private theorem componentType_a5FourthD4_of_eq_four
    {k : Fin a5FourthD4.components.length} (hk : k.val = 4) :
    a5FourthD4.componentType k = .D 4 := by
  have hk4 : k = ⟨4, by decide⟩ := Fin.ext hk
  rw [hk4]
  exact componentType_a5FourthD4_four

/-- The inverse `A₅⁴ D₄` cyclic permutation sends any position with index `4` to type `D₄`. -/
private theorem componentType_a5FourthD4CyclicPerm_inv_of_eq_four
    {k : Fin a5FourthD4.components.length} (hk : k.val = 4) :
    a5FourthD4.componentType (a5FourthD4CyclicPerm⁻¹ k) = .D 4 := by
  have hk4 : k = ⟨4, by decide⟩ := Fin.ext hk
  rw [hk4, a5FourthD4CyclicPerm_inv_apply_four]
  exact componentType_a5FourthD4_four

/-- The cyclic subgroup generated by `a5FourthD4CyclicPerm` consists of `1`,
`a5FourthD4CyclicPerm`, and `a5FourthD4CyclicPerm ^ 2`. -/
theorem mem_zpowers_a5FourthD4CyclicPerm_iff
    {g : Equiv.Perm (Fin a5FourthD4.components.length)} :
    g ∈ Subgroup.zpowers a5FourthD4CyclicPerm ↔
      g = 1 ∨ g = a5FourthD4CyclicPerm ∨ g = a5FourthD4CyclicPerm ^ 2 := by
  rw [mem_zpowers_iff_mem_range_orderOf, orderOf_a5FourthD4CyclicPerm,
    show Finset.range 3 = {0, 1, 2} by decide]
  simp

/-- Every element `g` of `Subgroup.zpowers a5FourthD4CyclicPerm` is the power
`a5FourthD4CyclicPerm ^ ((g ⟨1, _⟩).val - 1)`. -/
theorem eq_a5FourthD4CyclicPerm_pow_of_mem_zpowers
    {g : Equiv.Perm (Fin a5FourthD4.components.length)}
    (hg : g ∈ Subgroup.zpowers a5FourthD4CyclicPerm) :
    g = a5FourthD4CyclicPerm ^ ((g ⟨1, by decide⟩).val - 1) := by
  rcases mem_zpowers_a5FourthD4CyclicPerm_iff.mp hg with rfl | rfl | rfl <;>
    simp [pow_two, Equiv.Perm.mul_apply]

/-- Every element of `Subgroup.zpowers a5FourthD4CyclicPerm` preserves component types. -/
theorem componentType_of_mem_zpowers_a5FourthD4CyclicPerm
    {g : Equiv.Perm (Fin a5FourthD4.components.length)}
    (hg : g ∈ Subgroup.zpowers a5FourthD4CyclicPerm) (k : Fin a5FourthD4.components.length) :
    a5FourthD4.componentType (g k) = a5FourthD4.componentType k := by
  rcases mem_zpowers_a5FourthD4CyclicPerm_iff.mp hg with rfl | rfl | rfl
  · rfl
  · exact componentType_a5FourthD4CyclicPerm k
  · rw [pow_two, Equiv.Perm.mul_apply, componentType_a5FourthD4CyclicPerm,
      componentType_a5FourthD4CyclicPerm]

/-! ### The triality-lifted automorphism of the `A₅⁴ D₄` glue module -/

/-- The componentwise root-lattice isometry for the triality-lifted cyclic symmetry of `A₅⁴ D₄`:
the equality identification on the four `A₅` positions and `typeD4Triality` on position `4`. -/
private noncomputable def a5FourthD4ComponentIsometry (k : Fin a5FourthD4.components.length) :
    IntegralLattice.Isometry
      ((a5FourthD4.componentType (a5FourthD4CyclicPerm⁻¹ k)).rootLattice
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4CyclicPerm⁻¹ k)))
      ((a5FourthD4.componentType k).rootLattice (a5FourthD4.isSimplyLaced_componentType k)) :=
  if hk : k.val = 4 then
    ((a5FourthD4.componentType (a5FourthD4CyclicPerm⁻¹ k)).rootLatticeIsometryOfEq _
        (componentType_a5FourthD4CyclicPerm_inv_of_eq_four hk) (isSimplyLaced_D 4)).trans
      ((typeD4Triality (isSimplyLaced_D 4)).trans
        ((D 4).rootLatticeIsometryOfEq (isSimplyLaced_D 4)
          (componentType_a5FourthD4_of_eq_four hk).symm _))
  else
    (a5FourthD4.componentType (a5FourthD4CyclicPerm⁻¹ k)).rootLatticeIsometryOfEq _
      (componentType_a5FourthD4CyclicPerm_inv k) _

/-- The componentwise glue-alphabet isometry matching `a5FourthD4ComponentIsometry`. -/
private noncomputable def a5FourthD4ComponentGlueIsometry (k : Fin a5FourthD4.components.length) :
    FiniteQuadraticModule.Isometry
      ((a5FourthD4.componentType (a5FourthD4CyclicPerm⁻¹ k)).glueAlphabet
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4CyclicPerm⁻¹ k)))
      ((a5FourthD4.componentType k).glueAlphabet (a5FourthD4.isSimplyLaced_componentType k)) :=
  if hk : k.val = 4 then
    (FiniteQuadraticModule.Isometry.ofEq
        (glueAlphabet_congr (componentType_a5FourthD4CyclicPerm_inv_of_eq_four hk) _
          (isSimplyLaced_D 4))).trans
      ((typeD4TrialityGlueIsometry (isSimplyLaced_D 4)).trans
        (FiniteQuadraticModule.Isometry.ofEq
          (glueAlphabet_congr (componentType_a5FourthD4_of_eq_four hk).symm
            (isSimplyLaced_D 4) _)))
  else
    FiniteQuadraticModule.Isometry.ofEq
      (glueAlphabet_congr (componentType_a5FourthD4CyclicPerm_inv k) _ _)

/-- The componentwise root-lattice and glue-alphabet isometries are compatible through the
component glue isometries. -/
private theorem glueAlphabetIsometry_a5FourthD4ComponentGlueIsometry
    (k : Fin a5FourthD4.components.length)
    (x : (a5FourthD4.componentType (a5FourthD4CyclicPerm⁻¹ k)).glueAlphabet
      (a5FourthD4.isSimplyLaced_componentType (a5FourthD4CyclicPerm⁻¹ k))) :
    (a5FourthD4.componentType k).glueAlphabetIsometry
        (a5FourthD4.valid_componentType k) (a5FourthD4.isSimplyLaced_componentType k)
        (a5FourthD4ComponentGlueIsometry k x) =
      (a5FourthD4ComponentIsometry k).discriminantQuadraticIsometry
        ((a5FourthD4.componentType (a5FourthD4CyclicPerm⁻¹ k)).isEven_rootLattice _)
        ((a5FourthD4.componentType (a5FourthD4CyclicPerm⁻¹ k)).glueAlphabetIsometry
          (a5FourthD4.valid_componentType _) _ x) := by
  by_cases hk : k.val = 4
  · rw [a5FourthD4ComponentGlueIsometry, a5FourthD4ComponentIsometry, dite_eq_left hk,
      dite_eq_left hk]
    have h1 := componentType_a5FourthD4CyclicPerm_inv_of_eq_four hk
    have h2 := componentType_a5FourthD4_of_eq_four hk
    have step1 := glueAlphabetIsometry_ofEq h1 (a5FourthD4.valid_componentType _)
      (valid_D.mpr le_rfl) _ (isSimplyLaced_D 4) x
    have step2 := glueAlphabetIsometry_typeD4TrialityGlueIsometry (isSimplyLaced_D 4)
      (valid_D.mpr le_rfl)
      (FiniteQuadraticModule.Isometry.ofEq (glueAlphabet_congr h1 _ (isSimplyLaced_D 4)) x)
    have step3 := glueAlphabetIsometry_ofEq h2.symm (valid_D.mpr le_rfl)
      (a5FourthD4.valid_componentType k) (isSimplyLaced_D 4)
      (a5FourthD4.isSimplyLaced_componentType k)
      (typeD4TrialityGlueIsometry (isSimplyLaced_D 4)
        (FiniteQuadraticModule.Isometry.ofEq (glueAlphabet_congr h1 _ (isSimplyLaced_D 4)) x))
    rw [QuadraticMap.IsometryEquiv.trans_apply, QuadraticMap.IsometryEquiv.trans_apply,
      step3, step2, step1, Isometry.discriminantQuadraticIsometry_trans,
      Isometry.discriminantQuadraticIsometry_trans,
      FiniteQuadraticModule.Isometry.trans_apply, FiniteQuadraticModule.Isometry.trans_apply]
  · rw [a5FourthD4ComponentGlueIsometry, a5FourthD4ComponentIsometry, dite_eq_right hk,
      dite_eq_right hk]
    exact glueAlphabetIsometry_ofEq (componentType_a5FourthD4CyclicPerm_inv k)
      (a5FourthD4.valid_componentType _) (a5FourthD4.valid_componentType k) _ _ x

/-- **The triality-lifted cyclic automorphism of the `A₅⁴ D₄` glue module**: it moves the `A₅`
labels along `a5FourthD4CyclicPerm` (reading position `k` from `a5FourthD4CyclicPerm⁻¹ k`) and
cycles the `D₄` labels in position `4` by `typeD4TrialityGlueIsometry` (`1 ↦ 2 ↦ 3 ↦ 1`). -/
noncomputable def a5FourthD4CyclicGlueIsometry :
    FiniteQuadraticModule.Isometry a5FourthD4.glueModule a5FourthD4.glueModule :=
  (QuadraticMap.IsometryEquiv.piCongrLeft
      (fun i ↦ ((a5FourthD4.componentType i).glueAlphabet
        (a5FourthD4.isSimplyLaced_componentType i)).quadratic)
      a5FourthD4CyclicPerm⁻¹).symm.trans
    (QuadraticMap.IsometryEquiv.pi a5FourthD4ComponentGlueIsometry)

private theorem a5FourthD4CyclicGlueIsometry_apply_private (w : a5FourthD4.glueModule)
    (k : Fin a5FourthD4.components.length) :
    a5FourthD4CyclicGlueIsometry w k =
      a5FourthD4ComponentGlueIsometry k (w (a5FourthD4CyclicPerm⁻¹ k)) := by
  rw [a5FourthD4CyclicGlueIsometry, QuadraticMap.IsometryEquiv.trans_apply,
    QuadraticMap.IsometryEquiv.pi_apply, QuadraticMap.IsometryEquiv.piCongrLeft_symm_apply]

/-- On the four `A₅` positions, `a5FourthD4CyclicGlueIsometry` reads position `k` from
`a5FourthD4CyclicPerm⁻¹ k`. -/
@[simp]
theorem a5FourthD4CyclicGlueIsometry_apply_of_lt_four (w : a5FourthD4.glueModule)
    {k : Fin a5FourthD4.components.length} (hk : k.val < 4) :
    a5FourthD4CyclicGlueIsometry w k =
      FiniteQuadraticModule.Isometry.ofEq
        (glueAlphabet_congr (componentType_a5FourthD4CyclicPerm_inv k) _ _)
        (w (a5FourthD4CyclicPerm⁻¹ k)) := by
  rw [a5FourthD4CyclicGlueIsometry_apply_private, a5FourthD4ComponentGlueIsometry,
    dite_eq_right (Nat.ne_of_lt hk)]

/-- On the `D₄` position `4`, `a5FourthD4CyclicGlueIsometry` acts by
`typeD4TrialityGlueIsometry`. -/
@[simp]
theorem a5FourthD4CyclicGlueIsometry_apply_four (w : a5FourthD4.glueModule) :
    a5FourthD4CyclicGlueIsometry w ⟨4, by decide⟩ =
      FiniteQuadraticModule.Isometry.ofEq
          (glueAlphabet_congr componentType_a5FourthD4_four.symm (isSimplyLaced_D 4)
            (a5FourthD4.isSimplyLaced_componentType ⟨4, by decide⟩))
        (typeD4TrialityGlueIsometry (isSimplyLaced_D 4)
          (FiniteQuadraticModule.Isometry.ofEq
            (glueAlphabet_congr componentType_a5FourthD4_four
              (a5FourthD4.isSimplyLaced_componentType ⟨4, by decide⟩) (isSimplyLaced_D 4))
            (w ⟨4, by decide⟩))) := by
  rw [a5FourthD4CyclicGlueIsometry_apply_private, a5FourthD4ComponentGlueIsometry,
    dite_eq_left rfl, QuadraticMap.IsometryEquiv.trans_apply,
    QuadraticMap.IsometryEquiv.trans_apply,
    FiniteQuadraticModule.Isometry.ofEq_apply_eq
      (F := fun i ↦ (a5FourthD4.componentType i).glueAlphabet
        (a5FourthD4.isSimplyLaced_componentType i))
      w a5FourthD4CyclicPerm_inv_apply_four
      (glueAlphabet_congr (componentType_a5FourthD4CyclicPerm_inv_of_eq_four rfl) _
        (isSimplyLaced_D 4))
      (glueAlphabet_congr componentType_a5FourthD4_four _ (isSimplyLaced_D 4))]

/-- Applying `a5FourthD4CyclicGlueIsometry` three times fixes every glue word of `A₅⁴ D₄`. -/
@[simp]
theorem a5FourthD4CyclicGlueIsometry_apply_apply_apply (w : a5FourthD4.glueModule) :
    a5FourthD4CyclicGlueIsometry
        (a5FourthD4CyclicGlueIsometry (a5FourthD4CyclicGlueIsometry w)) = w := by
  funext k
  by_cases hk : k.val < 4
  · have hk1 := a5FourthD4CyclicPerm_inv_lt_four hk
    have hk2 := a5FourthD4CyclicPerm_inv_lt_four hk1
    rw [a5FourthD4CyclicGlueIsometry_apply_of_lt_four _ hk,
      a5FourthD4CyclicGlueIsometry_apply_of_lt_four _ hk1,
      a5FourthD4CyclicGlueIsometry_apply_of_lt_four _ hk2,
      FiniteQuadraticModule.Isometry.ofEq_ofEq, FiniteQuadraticModule.Isometry.ofEq_ofEq]
    have hk3 : a5FourthD4CyclicPerm⁻¹ (a5FourthD4CyclicPerm⁻¹ (a5FourthD4CyclicPerm⁻¹ k)) = k := by
      have h3 : (a5FourthD4CyclicPerm⁻¹) ^ 3 = 1 := by
        rw [inv_pow, a5FourthD4CyclicPerm_pow_three, inv_one]
      have h3k := Equiv.congr_fun h3 k
      simpa [pow_three, Equiv.Perm.mul_apply] using h3k
    exact (FiniteQuadraticModule.Isometry.ofEq_apply_eq
      (F := fun i ↦ (a5FourthD4.componentType i).glueAlphabet
        (a5FourthD4.isSimplyLaced_componentType i))
      w hk3 _ rfl).trans (by simp)
  · have hlt : k.val < 5 := length_components_a5FourthD4 ▸ k.isLt
    have hval : k.val = 4 := by omega
    have hk4 : k = ⟨4, by decide⟩ := Fin.ext hval
    subst hk4
    rw [a5FourthD4CyclicGlueIsometry_apply_four, a5FourthD4CyclicGlueIsometry_apply_four,
      a5FourthD4CyclicGlueIsometry_apply_four, FiniteQuadraticModule.Isometry.ofEq_symm_apply,
      FiniteQuadraticModule.Isometry.ofEq_symm_apply,
      typeD4TrialityGlueIsometry_apply_apply_apply,
      FiniteQuadraticModule.Isometry.ofEq_symm_apply]

/-- The digit-list transformation corresponding to `a5FourthD4CyclicGlueIsometry`: cycling
positions `1 ↦ 2 ↦ 3 ↦ 1` and permuting the `D₄` label in position `4` by `1 ↦ 2 ↦ 3 ↦ 1`. -/
private def a5FourthD4CyclicDigits (l : List ℕ) : List ℕ :=
  [l.getD 0 0, l.getD 3 0, l.getD 1 0, l.getD 2 0,
    match l.getD 4 0 with
    | 1 => 2
    | 2 => 3
    | 3 => 1
    | d => d]

private theorem a5FourthD4CyclicDigits_mem_glueWords :
    ∀ l ∈ a5FourthD4.glueWords, a5FourthD4CyclicDigits l ∈ a5FourthD4.glueWords := by
  decide

private theorem encodeGlueWord_a5FourthD4CyclicGlueIsometry (w : a5FourthD4.glueModule) :
    encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
        (a5FourthD4CyclicGlueIsometry w) =
      a5FourthD4CyclicDigits
        (encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w) := by
  refine List.ext_getElem
    ((length_encodeGlueWord _ _ _).trans length_components_a5FourthD4) fun i hi _ ↦ ?_
  have hi' : i < a5FourthD4.components.length := by rwa [length_encodeGlueWord] at hi
  rw [getElem_encodeGlueWord _ _ _ ⟨i, hi'⟩]
  by_cases hi4 : i < 4
  · -- On the four `A₅` positions, the cyclic isometry permutes labels by `a5FourthD4CyclicPerm⁻¹`.
    rw [a5FourthD4CyclicGlueIsometry_apply_of_lt_four w hi4,
      val_glueLabelEquiv_symm_ofEq (componentType_a5FourthD4CyclicPerm_inv _),
      ← getD_encodeGlueWord _ _ w (a5FourthD4CyclicPerm⁻¹ ⟨i, hi'⟩)]
    interval_cases i <;> simp [a5FourthD4CyclicDigits]
  · -- On position `4`, `typeD4TrialityGlueIsometry` cycles the `D₄` labels `1 ↦ 2 ↦ 3 ↦ 1`.
    have hi5 : i < 5 := length_components_a5FourthD4 ▸ hi'
    have hi_eq : i = 4 := by omega
    subst hi_eq
    have h4 : (⟨4, hi'⟩ : Fin a5FourthD4.components.length) = ⟨4, by decide⟩ := rfl
    rw [h4, a5FourthD4CyclicGlueIsometry_apply_four,
      val_glueLabelEquiv_symm_ofEq componentType_a5FourthD4_four.symm,
      glueLabelEquiv_symm_typeD4TrialityGlueIsometry]
    simp only [a5FourthD4CyclicDigits, List.getElem_cons_succ, List.getElem_cons_zero]
    rw [getD_encodeGlueWord _ _ w ⟨4, by decide⟩]
    have hval :
        (((D 4).glueLabelEquiv (isSimplyLaced_D 4)).symm
          (FiniteQuadraticModule.Isometry.ofEq
            (glueAlphabet_congr componentType_a5FourthD4_four
              (a5FourthD4.isSimplyLaced_componentType ⟨4, by decide⟩) (isSimplyLaced_D 4))
            (w ⟨4, by decide⟩))).val =
        (((a5FourthD4.componentType ⟨4, by decide⟩).glueLabelEquiv
          (a5FourthD4.isSimplyLaced_componentType ⟨4, by decide⟩)).symm (w ⟨4, by decide⟩)).val :=
      val_glueLabelEquiv_symm_ofEq componentType_a5FourthD4_four _ _ _
    rw [← hval]
    generalize ((D 4).glueLabelEquiv (isSimplyLaced_D 4)).symm
      (FiniteQuadraticModule.Isometry.ofEq
        (glueAlphabet_congr componentType_a5FourthD4_four
          (a5FourthD4.isSimplyLaced_componentType ⟨4, by decide⟩) (isSimplyLaced_D 4))
        (w ⟨4, by decide⟩)) = d
    fin_cases d <;> simp

/-- **The triality-lifted cyclic automorphism preserves the glue subgroup of `A₅⁴ D₄`**: it
permutes the six glue generators, cycling `[2(024)0]` and `[33001] ↦ [30302] ↦ [30033] ↦ [33001]`,
so it maps `a5FourthD4.glueSubgroup` onto itself. -/
@[simp]
theorem a5FourthD4CyclicGlueIsometry_mem_glueSubgroup_iff (w : a5FourthD4.glueModule) :
    a5FourthD4CyclicGlueIsometry w ∈ a5FourthD4.glueSubgroup ↔ w ∈ a5FourthD4.glueSubgroup := by
  have hgen_fwd (v : a5FourthD4.glueModule) (hv : v ∈ a5FourthD4.glueGenerators) :
      a5FourthD4CyclicGlueIsometry v ∈ a5FourthD4.glueGenerators := by
    rw [mem_glueGenerators_iff, encodeGlueWord_a5FourthD4CyclicGlueIsometry]
    exact a5FourthD4CyclicDigits_mem_glueWords _ (mem_glueGenerators_iff.mp hv)
  -- `toLinearEquiv.toAddEquiv` has the same underlying function as the isometry by definition.
  have hgen :
      a5FourthD4CyclicGlueIsometry.toLinearEquiv.toAddEquiv ⁻¹' a5FourthD4.glueGenerators =
        a5FourthD4.glueGenerators := by
    ext v
    change a5FourthD4CyclicGlueIsometry v ∈ a5FourthD4.glueGenerators ↔
      v ∈ a5FourthD4.glueGenerators
    refine ⟨fun hv ↦ ?_, hgen_fwd v⟩
    have hv3 := hgen_fwd _ (hgen_fwd _ hv)
    rwa [a5FourthD4CyclicGlueIsometry_apply_apply_apply] at hv3
  exact a5FourthD4.mem_glueSubgroup_iff_of_preimage_glueGenerators
    a5FourthD4CyclicGlueIsometry.toLinearEquiv.toAddEquiv hgen w

/-! ### The triality-lifted cyclic isometry of `A₅⁴ D₄` -/

/-- **The triality-lifted cyclic isometry of `A₅⁴ D₄`**: the self-isometry of `a5FourthD4.lattice`
rotating the three marked `A₅` components `1 ↦ 2 ↦ 3 ↦ 1`, fixing component `0`, and applying
`DynkinType.typeD4Triality` to the `D₄` component `4`. -/
noncomputable def a5FourthD4CyclicIsometry :
    IntegralLattice.Isometry a5FourthD4.lattice a5FourthD4.lattice :=
  (Isometry.ofEq (lattice_def a5FourthD4)).trans <|
    (gluedLatticePiCongrIsometry a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
      a5FourthD4.valid_componentType a5FourthD4.glueSubgroup a5FourthD4.isIsotropic_glueSubgroup
      a5FourthD4.valid_componentType a5FourthD4.isIsotropic_glueSubgroup
      a5FourthD4CyclicPerm⁻¹ a5FourthD4ComponentIsometry
      (fun k x ↦ a5FourthD4ComponentGlueIsometry k x)
      glueAlphabetIsometry_a5FourthD4ComponentGlueIsometry
      fun w ↦ by
        have heq : (fun k ↦ a5FourthD4ComponentGlueIsometry k (w (a5FourthD4CyclicPerm⁻¹ k))) =
            a5FourthD4CyclicGlueIsometry w :=
          funext fun k ↦ (a5FourthD4CyclicGlueIsometry_apply_private w k).symm
        rw [heq]
        exact a5FourthD4CyclicGlueIsometry_mem_glueSubgroup_iff w).trans
    (Isometry.ofEq (lattice_def a5FourthD4).symm)

private theorem a5FourthD4CyclicIsometry_apply_private
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ) (k : Fin a5FourthD4.components.length) :
    a5FourthD4CyclicIsometry x k =
      a5FourthD4ComponentIsometry k (x (a5FourthD4CyclicPerm⁻¹ k)) := by
  rw [a5FourthD4CyclicIsometry, Isometry.trans_apply, Isometry.trans_apply, Isometry.ofEq_apply,
    Isometry.ofEq_apply, gluedLatticePiCongrIsometry_apply]

/-- On the four `A₅` components, `a5FourthD4CyclicIsometry` reads component `k` from
`a5FourthD4CyclicPerm⁻¹ k`. -/
@[simp]
theorem a5FourthD4CyclicIsometry_apply_of_lt_four
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ)
    {k : Fin a5FourthD4.components.length} (hk : k.val < 4)
    (j : Fin (a5FourthD4.componentType k).rank) :
    a5FourthD4CyclicIsometry x k j =
      x (a5FourthD4CyclicPerm⁻¹ k)
        (Fin.cast (congrArg rank (componentType_a5FourthD4CyclicPerm_inv k)).symm j) := by
  rw [a5FourthD4CyclicIsometry_apply_private, a5FourthD4ComponentIsometry,
    dite_eq_right (Nat.ne_of_lt hk), rootLatticeIsometryOfEq_apply]

/-- On the `D₄` component `4`, `a5FourthD4CyclicIsometry` acts by `DynkinType.typeD4Triality`. -/
@[simp]
theorem a5FourthD4CyclicIsometry_apply_four
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ)
    (j : Fin (a5FourthD4.componentType ⟨4, by decide⟩).rank) :
    a5FourthD4CyclicIsometry x ⟨4, by decide⟩ j =
      typeD4Triality (isSimplyLaced_D 4)
        (x ⟨4, by decide⟩ ∘ Fin.cast (congrArg rank componentType_a5FourthD4_four).symm)
        (Fin.cast (congrArg rank componentType_a5FourthD4_four) j) := by
  rw [a5FourthD4CyclicIsometry_apply_private, a5FourthD4ComponentIsometry, dite_eq_left rfl,
    Isometry.trans_apply, Isometry.trans_apply, rootLatticeIsometryOfEq_apply]
  refine congrFun (congrArg (typeD4Triality (isSimplyLaced_D 4)) ?_) _
  funext i
  rw [rootLatticeIsometryOfEq_apply, Function.comp_apply]
  exact congr_heq (congr_arg_heq x a5FourthD4CyclicPerm_inv_apply_four)
    ((Fin.heq_ext_iff (by rw [a5FourthD4CyclicPerm_inv_apply_four])).mpr rfl)

/-- On the four `A₅` components, the `m`-th power of `a5FourthD4CyclicIsometry` reads component `k`
from `(a5FourthD4CyclicPerm ^ m)⁻¹ k`. -/
@[simp]
theorem a5FourthD4CyclicIsometry_pow_apply_of_lt_four (m : ℕ)
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ)
    {k : Fin a5FourthD4.components.length} (hk : k.val < 4)
    (j : Fin (a5FourthD4.componentType k).rank) :
    (a5FourthD4CyclicIsometry ^ m) x k j =
      x ((a5FourthD4CyclicPerm ^ m)⁻¹ k)
        (Fin.cast (congrArg rank
          (componentType_of_mem_zpowers_a5FourthD4CyclicPerm
            (inv_mem (pow_mem (Subgroup.mem_zpowers _) m)) k)).symm j) := by
  induction m generalizing k with
  | zero =>
    rw [pow_zero, Isometry.one_apply]
    exact congr_heq (congr_arg_heq x (by simp))
      ((Fin.heq_ext_iff (by simp)).mpr (by simp))
  | succ m ih =>
    rw [pow_succ', Isometry.mul_apply, a5FourthD4CyclicIsometry_apply_of_lt_four _ hk j,
      ih (a5FourthD4CyclicPerm_inv_lt_four hk), Fin.cast_cast]
    have hidx : (a5FourthD4CyclicPerm ^ m)⁻¹ (a5FourthD4CyclicPerm⁻¹ k) =
        (a5FourthD4CyclicPerm ^ (m + 1))⁻¹ k := by
      rw [pow_succ', mul_inv_rev, Equiv.Perm.mul_apply]
    exact congr_heq (congr_arg_heq x hidx)
      ((Fin.heq_ext_iff (by rw [hidx])).mpr (by simp))

/-- On the `D₄` component `4`, the `m`-th power of `a5FourthD4CyclicIsometry` acts by the `m`-th
power of `DynkinType.typeD4Triality`. -/
@[simp]
theorem a5FourthD4CyclicIsometry_pow_apply_four (m : ℕ)
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ)
    (j : Fin (a5FourthD4.componentType ⟨4, by decide⟩).rank) :
    (a5FourthD4CyclicIsometry ^ m) x ⟨4, by decide⟩ j =
      (typeD4Triality (isSimplyLaced_D 4) ^ m)
        (x ⟨4, by decide⟩ ∘ Fin.cast (congrArg rank componentType_a5FourthD4_four).symm)
        (Fin.cast (congrArg rank componentType_a5FourthD4_four) j) := by
  induction m generalizing x j with
  | zero =>
    rw [pow_zero, pow_zero, Isometry.one_apply, Isometry.one_apply, Function.comp_apply,
      Fin.cast_cast, Fin.cast_eq_self]
  | succ m ih =>
    rw [pow_succ', Isometry.mul_apply, a5FourthD4CyclicIsometry_apply_four, pow_succ',
      Isometry.mul_apply]
    refine congrFun (congrArg (typeD4Triality (isSimplyLaced_D 4)) ?_) _
    funext i
    rw [Function.comp_apply, ih x, Fin.cast_cast, Fin.cast_eq_self]

/-- **The triality-lifted cyclic isometry of `A₅⁴ D₄` has cube equal to `1`.** -/
@[simp]
theorem a5FourthD4CyclicIsometry_pow_three : a5FourthD4CyclicIsometry ^ 3 = 1 := by
  refine Isometry.ext fun x ↦ funext fun k ↦ funext fun j ↦ ?_
  by_cases hk : k.val < 4
  · rw [a5FourthD4CyclicIsometry_pow_apply_of_lt_four 3 x hk j, Isometry.one_apply]
    exact congr_heq (congr_arg_heq x (by simp))
      ((Fin.heq_ext_iff (by simp)).mpr (by simp))
  · have hlt : k.val < 5 := length_components_a5FourthD4 ▸ k.isLt
    have hval : k.val = 4 := by omega
    have hk4 : k = ⟨4, by decide⟩ := Fin.ext hval
    subst hk4
    rw [a5FourthD4CyclicIsometry_pow_apply_four 3 x j, typeD4Triality_pow_three,
      Isometry.one_apply, Isometry.one_apply, Function.comp_apply, Fin.cast_cast, Fin.cast_eq_self]

/-- The triality-lifted cyclic isometry of `A₅⁴ D₄` is nontrivial. -/
theorem a5FourthD4CyclicIsometry_ne_one : a5FourthD4CyclicIsometry ≠ 1 := by
  intro h
  let x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ :=
    fun i _ ↦ if i.val = 1 then 1 else 0
  have hx := congrFun (congrFun (Isometry.ext_iff.mp h x) ⟨2, by decide⟩) ⟨0, by decide⟩
  rw [a5FourthD4CyclicIsometry_apply_of_lt_four x (by decide : (2 : ℕ) < 4),
    Isometry.one_apply] at hx
  dsimp only [x] at hx
  rw [a5FourthD4CyclicPerm_inv_apply_two] at hx
  norm_num at hx

/-- **The triality-lifted cyclic isometry of `A₅⁴ D₄` has order three.** -/
@[simp]
theorem orderOf_a5FourthD4CyclicIsometry : orderOf a5FourthD4CyclicIsometry = 3 :=
  orderOf_eq_prime a5FourthD4CyclicIsometry_pow_three a5FourthD4CyclicIsometry_ne_one

/-! ### Action of the cyclic pattern symmetries on `A₅⁴ D₄` -/

/-- **The triality-lifted cyclic action on `A₅⁴ D₄`**: the group homomorphism from
`Subgroup.zpowers a5FourthD4CyclicPerm` to `Isometry a5FourthD4.lattice a5FourthD4.lattice`
sending `a5FourthD4CyclicPerm` to `a5FourthD4CyclicIsometry`. -/
noncomputable def a5FourthD4CyclicIsometryHom :
    Subgroup.zpowers a5FourthD4CyclicPerm →*
      IntegralLattice.Isometry a5FourthD4.lattice a5FourthD4.lattice where
  toFun g := a5FourthD4CyclicIsometry ^ ((g.1 ⟨1, by decide⟩).val - 1)
  map_one' := by simp
  map_mul' g h := by
    have hmod :
        (((g.1 ⟨1, by decide⟩).val - 1) + ((h.1 ⟨1, by decide⟩).val - 1)) % 3 =
          (((g.1 * h.1) ⟨1, by decide⟩).val - 1) % 3 := by
      rcases mem_zpowers_a5FourthD4CyclicPerm_iff.mp g.2 with hg | hg | hg <;>
        rcases mem_zpowers_a5FourthD4CyclicPerm_iff.mp h.2 with hh | hh | hh <;>
        simp [hg, hh, pow_two, Equiv.Perm.mul_apply]
    rw [Subgroup.coe_mul, ← pow_add, pow_eq_pow_mod _ a5FourthD4CyclicIsometry_pow_three,
      pow_eq_pow_mod (_ + _) a5FourthD4CyclicIsometry_pow_three, hmod]

/-- Each element `g` of `Subgroup.zpowers a5FourthD4CyclicPerm` acts as
`a5FourthD4CyclicIsometry ^ ((g.1 ⟨1, _⟩).val - 1)`. -/
theorem a5FourthD4CyclicIsometryHom_apply (g : Subgroup.zpowers a5FourthD4CyclicPerm) :
    a5FourthD4CyclicIsometryHom g =
      a5FourthD4CyclicIsometry ^ ((g.1 ⟨1, by decide⟩).val - 1) :=
  (rfl)

/-- The generator `a5FourthD4CyclicPerm` acts as `a5FourthD4CyclicIsometry`. -/
@[simp]
theorem a5FourthD4CyclicIsometryHom_gen :
    a5FourthD4CyclicIsometryHom ⟨a5FourthD4CyclicPerm, Subgroup.mem_zpowers _⟩ =
      a5FourthD4CyclicIsometry := by
  rw [a5FourthD4CyclicIsometryHom_apply]
  simp

/-- On the four `A₅` components, `a5FourthD4CyclicIsometryHom g` reads component `k` from
`g⁻¹ k`. -/
@[simp]
theorem a5FourthD4CyclicIsometryHom_apply_of_lt_four
    (g : Subgroup.zpowers a5FourthD4CyclicPerm)
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ)
    {k : Fin a5FourthD4.components.length} (hk : k.val < 4)
    (j : Fin (a5FourthD4.componentType k).rank) :
    a5FourthD4CyclicIsometryHom g x k j =
      x ((g : Equiv.Perm _)⁻¹ k)
        (Fin.cast (congrArg rank
          (componentType_of_mem_zpowers_a5FourthD4CyclicPerm (inv_mem g.2) k)).symm j) := by
  rw [a5FourthD4CyclicIsometryHom_apply, a5FourthD4CyclicIsometry_pow_apply_of_lt_four _ x hk j]
  have hidx := congrArg (fun σ : Equiv.Perm _ ↦ σ⁻¹ k)
    (eq_a5FourthD4CyclicPerm_pow_of_mem_zpowers g.2).symm
  exact congr_heq (congr_arg_heq x hidx)
    ((Fin.heq_ext_iff (by rw [hidx])).mpr (by simp))

/-- On the `D₄` component `4`, `a5FourthD4CyclicIsometryHom g` acts by the matching power of
`DynkinType.typeD4Triality`. -/
@[simp]
theorem a5FourthD4CyclicIsometryHom_apply_four
    (g : Subgroup.zpowers a5FourthD4CyclicPerm)
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ)
    (j : Fin (a5FourthD4.componentType ⟨4, by decide⟩).rank) :
    a5FourthD4CyclicIsometryHom g x ⟨4, by decide⟩ j =
      (typeD4Triality (isSimplyLaced_D 4) ^ ((g.1 ⟨1, by decide⟩).val - 1))
        (x ⟨4, by decide⟩ ∘ Fin.cast (congrArg rank componentType_a5FourthD4_four).symm)
        (Fin.cast (congrArg rank componentType_a5FourthD4_four) j) := by
  rw [a5FourthD4CyclicIsometryHom_apply, a5FourthD4CyclicIsometry_pow_apply_four]

/-- The triality-lifted cyclic action on `A₅⁴ D₄` is faithful. -/
theorem a5FourthD4CyclicIsometryHom_injective : Function.Injective a5FourthD4CyclicIsometryHom := by
  intro ⟨g, hg⟩ ⟨h, hh⟩ hgh
  apply Subtype.ext
  dsimp only
  rw [a5FourthD4CyclicIsometryHom_apply, a5FourthD4CyclicIsometryHom_apply] at hgh
  have hmod := (isOfFinOrder_iff_pow_eq_one.mpr
    ⟨3, by decide, a5FourthD4CyclicIsometry_pow_three⟩).pow_inj_mod.mp hgh
  rw [orderOf_a5FourthD4CyclicIsometry] at hmod
  rw [eq_a5FourthD4CyclicPerm_pow_of_mem_zpowers hg,
    eq_a5FourthD4CyclicPerm_pow_of_mem_zpowers hh]
  conv_lhs => rw [pow_eq_pow_mod _ a5FourthD4CyclicPerm_pow_three]
  conv_rhs => rw [pow_eq_pow_mod _ a5FourthD4CyclicPerm_pow_three]
  rw [hmod]

/-- Every indicated symmetry of a table pattern of `A₅⁴ D₄`, read on the component positions, lies
in `Subgroup.zpowers a5FourthD4CyclicPerm`. -/
theorem permCongr_mem_zpowers_a5FourthD4CyclicPerm {p : GluePattern}
    (hp : p ∈ a5FourthD4.gluePatterns) {g : Equiv.Perm (Fin p.length)} (hg : g ∈ p.symmetries) :
    (finCongr (length_eq_of_mem_gluePatterns hp)).permCongr g ∈
      Subgroup.zpowers a5FourthD4CyclicPerm := by
  simp only [gluePatterns, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl
  · rw [GluePattern.symmetries_cyclic] at hg
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
    -- The literal lists `[2]`, `[0, 2, 4]`, and `[0]` have lengths `1`, `3`, and `1`, so the
    -- conjugated generator matches `a5FourthD4CyclicPerm_def`.
    let h : (1 + 3) + 1 = a5FourthD4.components.length := length_eq_of_mem_gluePatterns hp
    change (finCongr h).permCongrHom
      ((Equiv.Perm.finSumPerm
        (Equiv.Perm.finSumPerm (1 : Equiv.Perm (Fin 1)) (finRotate 3))
        (1 : Equiv.Perm (Fin 1))) ^ n) ∈ _
    rw [map_zpow, Equiv.permCongrHom_coe, ← a5FourthD4CyclicPerm_def h]
    exact Subgroup.zpow_mem_zpowers a5FourthD4CyclicPerm n
  all_goals
    rw [GluePattern.symmetries_literal, Subgroup.mem_bot] at hg
    subst hg
    rw [← Equiv.permCongrHom_coe, map_one]
    exact one_mem _

/-- **The indicated symmetries of every table pattern of `A₅⁴ D₄` act on `a5FourthD4.lattice`**:
for the cyclic pattern `[2(024)0]`, the marked `A₅` components rotate while `D₄` triality acts on
component `4`; for the three literal patterns, the trivial group acts trivially. -/
noncomputable def a5FourthD4PatternIsometryHom {p : GluePattern}
    (hp : p ∈ a5FourthD4.gluePatterns) :
    p.symmetries →* IntegralLattice.Isometry a5FourthD4.lattice a5FourthD4.lattice :=
  a5FourthD4CyclicIsometryHom.comp <|
    ((finCongr (length_eq_of_mem_gluePatterns hp)).permCongrHom.toMonoidHom.comp
      p.symmetries.subtype).codRestrict (Subgroup.zpowers a5FourthD4CyclicPerm) fun g ↦ by
        rw [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, Subgroup.coe_subtype,
          Equiv.permCongrHom_coe]
        exact permCongr_mem_zpowers_a5FourthD4CyclicPerm hp g.2

/-- Evaluating `a5FourthD4PatternIsometryHom` conjugates the pattern symmetry to the component
positions of `A₅⁴ D₄` and applies `a5FourthD4CyclicIsometryHom`. -/
theorem a5FourthD4PatternIsometryHom_apply {p : GluePattern}
    (hp : p ∈ a5FourthD4.gluePatterns) (g : p.symmetries) :
    a5FourthD4PatternIsometryHom hp g =
      a5FourthD4CyclicIsometryHom
        ⟨(finCongr (length_eq_of_mem_gluePatterns hp)).permCongr g.1,
          permCongr_mem_zpowers_a5FourthD4CyclicPerm hp g.2⟩ := by
  rw [a5FourthD4PatternIsometryHom, MonoidHom.comp_apply, MonoidHom.codRestrict_apply]
  refine congrArg a5FourthD4CyclicIsometryHom (Subtype.ext ?_)
  rw [Subtype.coe_mk, Subtype.coe_mk, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    Subgroup.coe_subtype, Equiv.permCongrHom_coe]

/-- On the four `A₅` components, the action of an indicated pattern symmetry `g` of `A₅⁴ D₄` reads
component `k` from `g⁻¹ k`. -/
@[simp]
theorem a5FourthD4PatternIsometryHom_apply_of_lt_four {p : GluePattern}
    (hp : p ∈ a5FourthD4.gluePatterns) (g : p.symmetries)
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ)
    {k : Fin a5FourthD4.components.length} (hk : k.val < 4)
    (j : Fin (a5FourthD4.componentType k).rank) :
    a5FourthD4PatternIsometryHom hp g x k j =
      x (((finCongr (length_eq_of_mem_gluePatterns hp)).permCongr g)⁻¹ k)
        (Fin.cast (congrArg rank
          (componentType_of_mem_zpowers_a5FourthD4CyclicPerm
            (inv_mem (permCongr_mem_zpowers_a5FourthD4CyclicPerm hp g.2)) k)).symm j) := by
  rw [a5FourthD4PatternIsometryHom_apply, a5FourthD4CyclicIsometryHom_apply_of_lt_four _ x hk j]

/-- On the `D₄` component `4`, an indicated pattern symmetry `g` of `A₅⁴ D₄` acts by the matching
power of `DynkinType.typeD4Triality`. -/
@[simp]
theorem a5FourthD4PatternIsometryHom_apply_four {p : GluePattern}
    (hp : p ∈ a5FourthD4.gluePatterns) (g : p.symmetries)
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ)
    (j : Fin (a5FourthD4.componentType ⟨4, by decide⟩).rank) :
    a5FourthD4PatternIsometryHom hp g x ⟨4, by decide⟩ j =
      (typeD4Triality (isSimplyLaced_D 4) ^
          ((((finCongr (length_eq_of_mem_gluePatterns hp)).permCongr g.1) ⟨1, by decide⟩).val - 1))
        (x ⟨4, by decide⟩ ∘ Fin.cast (congrArg rank componentType_a5FourthD4_four).symm)
        (Fin.cast (congrArg rank componentType_a5FourthD4_four) j) := by
  rw [a5FourthD4PatternIsometryHom_apply, a5FourthD4CyclicIsometryHom_apply_four]

/-- The lifted action of the indicated symmetries of every table pattern of `A₅⁴ D₄` is
faithful. -/
theorem a5FourthD4PatternIsometryHom_injective {p : GluePattern}
    (hp : p ∈ a5FourthD4.gluePatterns) :
    Function.Injective (a5FourthD4PatternIsometryHom hp) := by
  rw [a5FourthD4PatternIsometryHom, MonoidHom.coe_comp]
  refine a5FourthD4CyclicIsometryHom_injective.comp <|
    (MonoidHom.injective_codRestrict _ _ _).mpr ?_
  rw [MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom]
  exact (finCongr (length_eq_of_mem_gluePatterns hp)).permCongrHom.injective.comp
    p.symmetries.subtype_injective

end RootfulNiemeierType

