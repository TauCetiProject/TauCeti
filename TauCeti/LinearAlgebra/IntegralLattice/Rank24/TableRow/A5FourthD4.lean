module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Niemeier
public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeD.Triality
public import TauCeti.LinearAlgebra.IntegralLattice.Isometry.Group

/-!
# The table row `A₅⁴ D₄` and its triality-coupled pattern symmetry

The row `A₅⁴ D₄` of the rootful rank-24 table, `TauCeti.RootfulNiemeierType.a5FourthD4`, glues the
orthogonal sum of four `A₅` root lattices and one `D₄` root lattice along the subgroup of order
`72` generated by the cyclic pattern `[2(024)0]` together with the three literal words `[33001]`,
`[30302]`, and `[30033]`.

Unlike the other twenty-two rows of the table, rotating the three `A₅` positions `(1, 2, 3)` marked
in `[2(024)0]` while fixing the `D₄` component at position `4` does not preserve the glue subgroup:
on the literal generators `[33001]`, `[30302]`, and `[30033]`, cycling the three `A₅` positions
`(1, 2, 3)` shifts the nonzero `A₅` digit `3` in lockstep with the nonzero Conway--Sloane `D₄`
labels `1 ↦ 2 ↦ 3 ↦ 1` (`s ↦ v ↦ c ↦ s`).  Realizing the pattern symmetry of `[2(024)0]` on
`niemeierA5FourthD4 = a5FourthD4.lattice` therefore requires coupling the block rotation of the
three `A₅` components with the diagram triality isometry `TauCeti.DynkinType.typeD4Triality` on the
`D₄` component.

This file constructs that coupled action from `TauCeti.DynkinType.gluedLatticePiCongrIsometry` and
`TauCeti.DynkinType.typeD4GlueAlphabetTriality`:

* `TauCeti.RootfulNiemeierType.a5FourthD4BlockPerm` is the order-`3` block rotation fixing positions
  `0` and `4` and cycling `(1, 2, 3)`.
* `TauCeti.RootfulNiemeierType.a5FourthD4TrialityGlueIsometry` is the induced self-isometry of
  `a5FourthD4.glueModule`, permuting the six digit words `a5FourthD4.glueWords` onto themselves and
  hence preserving `a5FourthD4.glueSubgroup`
  (`a5FourthD4TrialityGlueIsometry_mem_glueSubgroup_iff`).
* `TauCeti.RootfulNiemeierType.a5FourthD4TrialityIsometry` is the resulting order-`3` self-isometry
  of `niemeierA5FourthD4`, fixing the leading `A₅` component, cycling the three `A₅` components
  `(1, 2, 3)`, and acting as `typeD4Triality` on the `D₄` component.
* `TauCeti.RootfulNiemeierType.a5FourthD4PatternIsometryHom` lifts `p.symmetries` to self-isometries
  of `niemeierA5FourthD4` for every glue pattern `p ∈ a5FourthD4.gluePatterns`, allowing
  `TauCeti.RootfulNiemeierType.patternIsometryHom` in
  `TauCeti.LinearAlgebra.IntegralLattice.Rank24.TableRow.Symmetry` to cover all 23 rows uniformly.

## Main declarations

* `TauCeti.RootfulNiemeierType.a5FourthD4BlockPerm`: the block rotation of positions `(1, 2, 3)`,
  of order `3` (`orderOf_a5FourthD4BlockPerm`).
* `TauCeti.RootfulNiemeierType.a5FourthD4TrialityGlueIsometry`: the coupled order-`3` self-isometry
  of `a5FourthD4.glueModule`, with `encodeGlueWord_a5FourthD4TrialityGlueIsometry` and
  `a5FourthD4TrialityGlueIsometry_mem_glueSubgroup_iff`.
* `TauCeti.RootfulNiemeierType.a5FourthD4TrialityIsometry`: the coupled self-isometry of
  `niemeierA5FourthD4`, with coordinate formulas on the `A₅` and `D₄` components,
  `a5FourthD4TrialityIsometry_pow_three`, and `orderOf_a5FourthD4TrialityIsometry`.
* `TauCeti.RootfulNiemeierType.a5FourthD4PatternIsometryHom`: the action of `p.symmetries` on
  `niemeierA5FourthD4` for every pattern `p ∈ a5FourthD4.gluePatterns`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §§3 and 7.1, and Chapter 16, §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType IntegralLattice

/-! ### Component structure and block permutation of `A₅⁴ D₄` -/

/-- The row `A₅⁴ D₄` has five components. -/
@[simp]
theorem length_components_a5FourthD4 : a5FourthD4.components.length = 5 :=
  (rfl)

/-- The index of the `D₄` component of `A₅⁴ D₄`. -/
abbrev a5FourthD4LastIndex : Fin a5FourthD4.components.length :=
  ⟨4, by decide⟩

/-- Each of the first four components of `A₅⁴ D₄` has Dynkin type `A₅`. -/
theorem componentType_a5FourthD4_of_lt_four {i : Fin a5FourthD4.components.length}
    (hi : i.val < 4) : a5FourthD4.componentType i = A 5 := by
  rcases i with ⟨v, hv⟩
  interval_cases v <;> rfl

/-- The fifth component of `A₅⁴ D₄` (at index `4`) has Dynkin type `D₄`. -/
@[simp]
theorem componentType_a5FourthD4_four : a5FourthD4.componentType a5FourthD4LastIndex = D 4 :=
  (rfl)

/-- **The block rotation of `[2(024)0]`**: the permutation of `Fin 5` that fixes positions `0` and
`4` and cycles `(1, 2, 3)` as `1 ↦ 2 ↦ 3 ↦ 1`, matching the generator of
`(GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries`. -/
def a5FourthD4BlockPerm : Equiv.Perm (Fin 5) :=
  Equiv.Perm.finSumPerm (m := 4) (n := 1)
    (Equiv.Perm.finSumPerm (m := 1) (n := 3) 1 (finRotate 3)) 1

/-- `a5FourthD4BlockPerm` fixes position `0`. -/
@[simp]
theorem a5FourthD4BlockPerm_zero : a5FourthD4BlockPerm 0 = 0 := by
  refine (Equiv.Perm.finSumPerm_apply_castAdd _ _ (Fin.castAdd 3 (0 : Fin 1))).trans ?_
  rw [Equiv.Perm.finSumPerm_apply_castAdd]
  rfl

/-- `a5FourthD4BlockPerm` sends position `1` to `2`. -/
@[simp]
theorem a5FourthD4BlockPerm_one : a5FourthD4BlockPerm 1 = 2 := by
  refine (Equiv.Perm.finSumPerm_apply_castAdd _ _ (Fin.natAdd 1 (0 : Fin 3))).trans ?_
  rw [Equiv.Perm.finSumPerm_apply_natAdd]
  decide

/-- `a5FourthD4BlockPerm` sends position `2` to `3`. -/
@[simp]
theorem a5FourthD4BlockPerm_two : a5FourthD4BlockPerm 2 = 3 := by
  refine (Equiv.Perm.finSumPerm_apply_castAdd _ _ (Fin.natAdd 1 (1 : Fin 3))).trans ?_
  rw [Equiv.Perm.finSumPerm_apply_natAdd]
  decide

/-- `a5FourthD4BlockPerm` sends position `3` to `1`. -/
@[simp]
theorem a5FourthD4BlockPerm_three : a5FourthD4BlockPerm 3 = 1 := by
  refine (Equiv.Perm.finSumPerm_apply_castAdd _ _ (Fin.natAdd 1 (2 : Fin 3))).trans ?_
  rw [Equiv.Perm.finSumPerm_apply_natAdd]
  decide

/-- `a5FourthD4BlockPerm` fixes the `D₄` position `4`. -/
@[simp]
theorem a5FourthD4BlockPerm_four : a5FourthD4BlockPerm 4 = 4 := by
  refine (Equiv.Perm.finSumPerm_apply_natAdd _ _ (0 : Fin 1)).trans ?_
  rfl

/-- Explicit value table of `a5FourthD4BlockPerm` on `Fin 5`. -/
theorem a5FourthD4BlockPerm_apply (i : Fin 5) :
    a5FourthD4BlockPerm i = ![0, 2, 3, 1, 4] i := by
  fin_cases i <;> simp

/-- Explicit value table of `a5FourthD4BlockPerm⁻¹` on `Fin 5`. -/
theorem a5FourthD4BlockPerm_inv_apply (i : Fin 5) :
    (a5FourthD4BlockPerm⁻¹ : Equiv.Perm (Fin 5)) i = ![0, 3, 1, 2, 4] i := by
  refine a5FourthD4BlockPerm.injective ?_
  rw [Equiv.Perm.inv_def, Equiv.apply_symm_apply, a5FourthD4BlockPerm_apply]
  fin_cases i <;> simp

private theorem componentType_a5FourthD4BlockPerm_fin5 (k : Fin 5) :
    a5FourthD4.componentType ⟨k.val, k.isLt⟩ =
      a5FourthD4.componentType ⟨(a5FourthD4BlockPerm k).val, (a5FourthD4BlockPerm k).isLt⟩ := by
  fin_cases k <;> simp <;> rfl

/-- `a5FourthD4BlockPerm` preserves the Dynkin type of every component of `A₅⁴ D₄`. -/
theorem componentType_a5FourthD4BlockPerm (i : Fin a5FourthD4.components.length) :
    a5FourthD4.componentType i =
      a5FourthD4.componentType (a5FourthD4BlockPerm i) :=
  componentType_a5FourthD4BlockPerm_fin5 ⟨i.val, i.isLt⟩

/-- `a5FourthD4BlockPerm` has cube equal to `1`. -/
@[simp]
theorem a5FourthD4BlockPerm_pow_three : a5FourthD4BlockPerm ^ 3 = 1 := by
  ext i
  fin_cases i <;> simp [pow_three]

/-- `a5FourthD4BlockPerm` is nontrivial. -/
theorem a5FourthD4BlockPerm_ne_one : a5FourthD4BlockPerm ≠ 1 := by
  intro h
  have h1 := congrArg (fun σ : Equiv.Perm (Fin 5) ↦ σ 1) h
  simp at h1

/-- `a5FourthD4BlockPerm` has order `3`. -/
@[simp]
theorem orderOf_a5FourthD4BlockPerm : orderOf a5FourthD4BlockPerm = 3 :=
  orderOf_eq_prime a5FourthD4BlockPerm_pow_three a5FourthD4BlockPerm_ne_one

/-! ### Triality-coupled action on glue words of `A₅⁴ D₄` -/

/-- `a5FourthD4BlockPerm` as a permutation of `Fin a5FourthD4.components.length`. -/
abbrev a5FourthD4ComponentPerm : Equiv.Perm (Fin a5FourthD4.components.length) :=
  a5FourthD4BlockPerm

private theorem a5FourthD4ComponentPerm_last :
    a5FourthD4ComponentPerm a5FourthD4LastIndex = a5FourthD4LastIndex :=
  a5FourthD4BlockPerm_four

private theorem d4_eq_componentType_perm_last :
    D 4 = a5FourthD4.componentType (a5FourthD4ComponentPerm a5FourthD4LastIndex) := by
  rw [a5FourthD4ComponentPerm_last]
  rfl

private noncomputable def a5FourthD4LastGlueIsometry :
    FiniteQuadraticModule.Isometry
      ((a5FourthD4.componentType a5FourthD4LastIndex).glueAlphabet
        (a5FourthD4.isSimplyLaced_componentType a5FourthD4LastIndex))
      ((a5FourthD4.componentType (a5FourthD4ComponentPerm a5FourthD4LastIndex)).glueAlphabet
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm a5FourthD4LastIndex))) :=
  (typeD4GlueAlphabetTriality (isSimplyLaced_D 4)).trans
    (FiniteQuadraticModule.Isometry.ofEq
      (glueAlphabet_congr d4_eq_componentType_perm_last (isSimplyLaced_D 4)
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm a5FourthD4LastIndex))))

/-- The componentwise glue-alphabet isometries along `a5FourthD4ComponentPerm`: identity casts on
the four `A₅` components and `typeD4GlueAlphabetTriality` on the `D₄` component at index `4`. -/
private noncomputable def a5FourthD4ComponentGlueIsometry
    (i : Fin a5FourthD4.components.length) :
    FiniteQuadraticModule.Isometry
      ((a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i))
      ((a5FourthD4.componentType (a5FourthD4ComponentPerm i)).glueAlphabet
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm i))) :=
  if hi : i = a5FourthD4LastIndex then
    hi ▸ a5FourthD4LastGlueIsometry
  else
    FiniteQuadraticModule.Isometry.ofEq
      (glueAlphabet_congr (componentType_a5FourthD4BlockPerm i)
        (a5FourthD4.isSimplyLaced_componentType i)
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm i)))

/-- **The triality-coupled self-isometry of the glue module of `A₅⁴ D₄`**: it moves the `A₅` labels
in positions `(1, 2, 3)` along `a5FourthD4BlockPerm`, fixes the leading `A₅` label, and applies
`typeD4GlueAlphabetTriality` to the `D₄` label in position `4`. -/
noncomputable def a5FourthD4TrialityGlueIsometry :
    FiniteQuadraticModule.Isometry a5FourthD4.glueModule a5FourthD4.glueModule :=
  QuadraticMap.IsometryEquiv.piCongr a5FourthD4ComponentPerm a5FourthD4ComponentGlueIsometry

/-- The digit-word transformation induced by `a5FourthD4TrialityGlueIsometry`: positions `(1, 2, 3)`
shift as `(d₁, d₂, d₃) ↦ (d₃, d₁, d₂)` while the `D₄` digit `d₄` transforms by `0 ↦ 0`,
`1 ↦ 2 ↦ 3 ↦ 1`. -/
@[expose] def a5FourthD4TrialityDigitWord (l : List ℕ) : List ℕ :=
  [l.getD 0 0, l.getD 3 0, l.getD 1 0, l.getD 2 0, [0, 2, 3, 1].getD (l.getD 4 0) 0]

private theorem encodeGlueWord_a5FourthD4_eq_list (w : a5FourthD4.glueModule) :
    encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w =
      [(((a5FourthD4.componentType ⟨0, by decide⟩).glueLabelEquiv
          (a5FourthD4.isSimplyLaced_componentType ⟨0, by decide⟩)).symm (w ⟨0, by decide⟩)).val,
       (((a5FourthD4.componentType ⟨1, by decide⟩).glueLabelEquiv
          (a5FourthD4.isSimplyLaced_componentType ⟨1, by decide⟩)).symm (w ⟨1, by decide⟩)).val,
       (((a5FourthD4.componentType ⟨2, by decide⟩).glueLabelEquiv
          (a5FourthD4.isSimplyLaced_componentType ⟨2, by decide⟩)).symm (w ⟨2, by decide⟩)).val,
       (((a5FourthD4.componentType ⟨3, by decide⟩).glueLabelEquiv
          (a5FourthD4.isSimplyLaced_componentType ⟨3, by decide⟩)).symm (w ⟨3, by decide⟩)).val,
       (((a5FourthD4.componentType a5FourthD4LastIndex).glueLabelEquiv
          (a5FourthD4.isSimplyLaced_componentType a5FourthD4LastIndex)).symm
          (w a5FourthD4LastIndex)).val] := by
  rw [encodeGlueWord_def]
  rfl

private theorem val_glueLabelEquiv_symm_congr (u : a5FourthD4.glueModule)
    {a b : Fin a5FourthD4.components.length} (hab : a = b) :
    (((a5FourthD4.componentType a).glueLabelEquiv
        (a5FourthD4.isSimplyLaced_componentType a)).symm (u a)).val =
      (((a5FourthD4.componentType b).glueLabelEquiv
        (a5FourthD4.isSimplyLaced_componentType b)).symm (u b)).val := by
  subst hab
  rfl

private theorem d4_triality_getD (c : Fin 4) :
    (![0, 2, 3, 1] c : Fin 4).val = [0, 2, 3, 1].getD c.val 0 := by
  fin_cases c <;> rfl

/-- `a5FourthD4TrialityGlueIsometry` acts on encoded Conway--Sloane digit words by
`a5FourthD4TrialityDigitWord`. -/
@[simp]
theorem encodeGlueWord_a5FourthD4TrialityGlueIsometry (w : a5FourthD4.glueModule) :
    encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
        (a5FourthD4TrialityGlueIsometry w) =
      a5FourthD4TrialityDigitWord
        (encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w) := by
  have hcoord (i : Fin a5FourthD4.components.length) (hi : i ≠ a5FourthD4LastIndex) :
      (((a5FourthD4.componentType (a5FourthD4ComponentPerm i)).glueLabelEquiv
          (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm i))).symm
        (a5FourthD4TrialityGlueIsometry w (a5FourthD4ComponentPerm i))).val =
      (((a5FourthD4.componentType i).glueLabelEquiv
          (a5FourthD4.isSimplyLaced_componentType i)).symm (w i)).val := by
    rw [a5FourthD4TrialityGlueIsometry, QuadraticMap.IsometryEquiv.piCongr_apply_apply,
      a5FourthD4ComponentGlueIsometry, dite_eq_right hi]
    exact val_glueLabelEquiv_symm_ofEq (componentType_a5FourthD4BlockPerm i) _ _ _
  have h4 : (((a5FourthD4.componentType a5FourthD4LastIndex).glueLabelEquiv
        (a5FourthD4.isSimplyLaced_componentType a5FourthD4LastIndex)).symm
      (a5FourthD4TrialityGlueIsometry w a5FourthD4LastIndex)).val =
      [0, 2, 3, 1].getD ((((a5FourthD4.componentType a5FourthD4LastIndex).glueLabelEquiv
        (a5FourthD4.isSimplyLaced_componentType a5FourthD4LastIndex)).symm
        (w a5FourthD4LastIndex)).val) 0 := by
    have h4' : (((a5FourthD4.componentType
          (a5FourthD4ComponentPerm a5FourthD4LastIndex)).glueLabelEquiv
          (a5FourthD4.isSimplyLaced_componentType
            (a5FourthD4ComponentPerm a5FourthD4LastIndex))).symm
        (a5FourthD4TrialityGlueIsometry w (a5FourthD4ComponentPerm a5FourthD4LastIndex))).val =
        (((D 4).glueLabelEquiv (isSimplyLaced_D 4)).symm
          (typeD4GlueAlphabetTriality (isSimplyLaced_D 4) (w a5FourthD4LastIndex))).val := by
      rw [a5FourthD4TrialityGlueIsometry, QuadraticMap.IsometryEquiv.piCongr_apply_apply,
        a5FourthD4ComponentGlueIsometry, dite_eq_left rfl]
      exact val_glueLabelEquiv_symm_ofEq d4_eq_componentType_perm_last (isSimplyLaced_D 4)
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm a5FourthD4LastIndex))
        (typeD4GlueAlphabetTriality (isSimplyLaced_D 4) (w a5FourthD4LastIndex))
    have htri := congrArg Fin.val
      (glueLabelEquiv_symm_typeD4GlueAlphabetTriality (isSimplyLaced_D 4) (w a5FourthD4LastIndex))
    exact (val_glueLabelEquiv_symm_congr (a5FourthD4TrialityGlueIsometry w)
      a5FourthD4ComponentPerm_last.symm).trans (h4'.trans (htri.trans (d4_triality_getD _)))
  rw [encodeGlueWord_a5FourthD4_eq_list, encodeGlueWord_a5FourthD4_eq_list]
  have h0 := hcoord ⟨0, by decide⟩ (by decide)
  have h1 := hcoord ⟨1, by decide⟩ (by decide)
  have h2 := hcoord ⟨2, by decide⟩ (by decide)
  have h3 := hcoord ⟨3, by decide⟩ (by decide)
  rw [show a5FourthD4ComponentPerm ⟨0, by decide⟩ = ⟨0, by decide⟩ from a5FourthD4BlockPerm_zero]
    at h0
  rw [show a5FourthD4ComponentPerm ⟨1, by decide⟩ = ⟨2, by decide⟩ from a5FourthD4BlockPerm_one]
    at h1
  rw [show a5FourthD4ComponentPerm ⟨2, by decide⟩ = ⟨3, by decide⟩ from a5FourthD4BlockPerm_two]
    at h2
  rw [show a5FourthD4ComponentPerm ⟨3, by decide⟩ = ⟨1, by decide⟩ from a5FourthD4BlockPerm_three]
    at h3
  simp [a5FourthD4TrialityDigitWord, h0, h1, h2, h3, h4]

private theorem a5FourthD4TrialityDigitWord_iter_three {l : List ℕ} (hl : l.length = 5)
    (h4 : l[4]'(by omega) < 4) :
    a5FourthD4TrialityDigitWord (a5FourthD4TrialityDigitWord (a5FourthD4TrialityDigitWord l)) =
      l := by
  rcases l with _ | ⟨d0, _ | ⟨d1, _ | ⟨d2, _ | ⟨d3, _ | ⟨d4, _ | _⟩⟩⟩⟩⟩
  all_goals simp only [List.length_cons, List.length_nil] at hl
  all_goals try omega
  simp only [List.getElem_cons_succ, List.getElem_cons_zero] at h4
  interval_cases d4 <;> rfl

/-- `a5FourthD4TrialityGlueIsometry` has order three on `a5FourthD4.glueModule`. -/
@[simp]
theorem a5FourthD4TrialityGlueIsometry_apply_apply_apply (w : a5FourthD4.glueModule) :
    a5FourthD4TrialityGlueIsometry
        (a5FourthD4TrialityGlueIsometry (a5FourthD4TrialityGlueIsometry w)) = w := by
  refine encodeGlueWord_injective a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType ?_
  rw [encodeGlueWord_a5FourthD4TrialityGlueIsometry, encodeGlueWord_a5FourthD4TrialityGlueIsometry,
    encodeGlueWord_a5FourthD4TrialityGlueIsometry]
  have hvalid := (isValidGlueWord_iff _ _).mp
    (isValidGlueWord_encodeGlueWord a5FourthD4.componentType
      a5FourthD4.isSimplyLaced_componentType w)
  have h4 : (encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w)[4]'
      (by simp) < 4 := hvalid.choose_spec a5FourthD4LastIndex
  exact a5FourthD4TrialityDigitWord_iter_three (by simp) h4

/-- `a5FourthD4TrialityDigitWord` maps every printed digit word of `A₅⁴ D₄` into
`a5FourthD4.glueWords`. -/
theorem a5FourthD4TrialityDigitWord_mem_glueWords {l : List ℕ}
    (hl : l ∈ a5FourthD4.glueWords) : a5FourthD4TrialityDigitWord l ∈ a5FourthD4.glueWords := by
  decide +revert

/-- **`a5FourthD4TrialityGlueIsometry` preserves `a5FourthD4.glueSubgroup`**, permuting the three
words of `[2(024)0]` and cycling `[33001] ↦ [30302] ↦ [30033] ↦ [33001]`. -/
@[simp]
theorem a5FourthD4TrialityGlueIsometry_mem_glueSubgroup_iff (w : a5FourthD4.glueModule) :
    a5FourthD4TrialityGlueIsometry w ∈ a5FourthD4.glueSubgroup ↔ w ∈ a5FourthD4.glueSubgroup := by
  have hforward : ∀ v ∈ a5FourthD4.glueSubgroup,
      a5FourthD4TrialityGlueIsometry v ∈ a5FourthD4.glueSubgroup := by
    have hle : a5FourthD4.glueSubgroup ≤
        a5FourthD4.glueSubgroup.comap a5FourthD4TrialityGlueIsometry.toAddEquiv.toAddMonoidHom := by
      rw [glueSubgroup_def, AddSubgroup.closure_le]
      intro v hv
      refine AddSubgroup.subset_closure ?_
      rw [mem_glueGenerators_iff]
      change encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
        (a5FourthD4TrialityGlueIsometry v) ∈ a5FourthD4.glueWords
      rw [encodeGlueWord_a5FourthD4TrialityGlueIsometry]
      exact a5FourthD4TrialityDigitWord_mem_glueWords (mem_glueGenerators_iff.mp hv)
    exact fun v hv ↦ hle hv
  refine ⟨fun hw ↦ ?_, hforward w⟩
  rw [← a5FourthD4TrialityGlueIsometry_apply_apply_apply w]
  exact hforward _ (hforward _ hw)

/-! ### Triality-coupled self-isometry of `niemeierA5FourthD4` -/

private noncomputable def a5FourthD4LastComponentIsometry :
    Isometry
      ((a5FourthD4.componentType a5FourthD4LastIndex).rootLattice
        (a5FourthD4.isSimplyLaced_componentType a5FourthD4LastIndex))
      ((a5FourthD4.componentType (a5FourthD4ComponentPerm a5FourthD4LastIndex)).rootLattice
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm a5FourthD4LastIndex))) :=
  (typeD4Triality (isSimplyLaced_D 4)).trans
    ((D 4).rootLatticeIsometryOfEq (isSimplyLaced_D 4) d4_eq_componentType_perm_last
      (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm a5FourthD4LastIndex)))

/-- The componentwise root-lattice isometries along `a5FourthD4ComponentPerm`: identity casts on
the four `A₅` components and `typeD4Triality` on the `D₄` component at index `4`. -/
private noncomputable def a5FourthD4ComponentIsometry (i : Fin a5FourthD4.components.length) :
    Isometry ((a5FourthD4.componentType i).rootLattice (a5FourthD4.isSimplyLaced_componentType i))
      ((a5FourthD4.componentType (a5FourthD4ComponentPerm i)).rootLattice
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm i))) :=
  if hi : i = a5FourthD4LastIndex then
    hi ▸ a5FourthD4LastComponentIsometry
  else
    (a5FourthD4.componentType i).rootLatticeIsometryOfEq
      (a5FourthD4.isSimplyLaced_componentType i) (componentType_a5FourthD4BlockPerm i)
      (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm i))

/-- Each component root-lattice isometry intertwines `glueAlphabetIsometry` with
`a5FourthD4ComponentGlueIsometry`. -/
private theorem glueAlphabetIsometry_a5FourthD4ComponentGlueIsometry
    (i : Fin a5FourthD4.components.length)
    (x : (a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i)) :
    (a5FourthD4.componentType (a5FourthD4ComponentPerm i)).glueAlphabetIsometry
        (a5FourthD4.valid_componentType (a5FourthD4ComponentPerm i))
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm i))
        (a5FourthD4ComponentGlueIsometry i x) =
      (a5FourthD4ComponentIsometry i).discriminantQuadraticIsometry
        ((a5FourthD4.componentType i).isEven_rootLattice
          (a5FourthD4.isSimplyLaced_componentType i))
        ((a5FourthD4.componentType i).glueAlphabetIsometry (a5FourthD4.valid_componentType i)
          (a5FourthD4.isSimplyLaced_componentType i) x) := by
  by_cases hi : i = a5FourthD4LastIndex
  · subst hi
    rw [a5FourthD4ComponentGlueIsometry, a5FourthD4ComponentIsometry, dite_eq_left rfl,
      dite_eq_left rfl]
    refine (glueAlphabetIsometry_ofEq d4_eq_componentType_perm_last
      (a5FourthD4.valid_componentType a5FourthD4LastIndex)
      (a5FourthD4.valid_componentType (a5FourthD4ComponentPerm a5FourthD4LastIndex))
      (isSimplyLaced_D 4)
      (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm a5FourthD4LastIndex))
      (typeD4GlueAlphabetTriality (isSimplyLaced_D 4) x)).trans ?_
    have htri := glueAlphabetIsometry_typeD4GlueAlphabetTriality (isSimplyLaced_D 4)
      (a5FourthD4.valid_componentType a5FourthD4LastIndex) x
    refine (congrArg _ htri).trans ?_
    refine (Isometry.discriminantQuadraticIsometry_apply _ _ _).trans <|
      (congrArg _ (Isometry.discriminantQuadraticIsometry_apply _ _ _)).trans <|
      (DFunLike.congr_fun
        (Isometry.discriminantGroupEquiv_trans
          (typeD4Triality (isSimplyLaced_D 4))
          ((D 4).rootLatticeIsometryOfEq (isSimplyLaced_D 4) d4_eq_componentType_perm_last
            (a5FourthD4.isSimplyLaced_componentType
              (a5FourthD4ComponentPerm a5FourthD4LastIndex)))) _).symm.trans <|
      (Isometry.discriminantQuadraticIsometry_apply a5FourthD4LastComponentIsometry _ _).symm
  · rw [a5FourthD4ComponentGlueIsometry, a5FourthD4ComponentIsometry, dite_eq_right hi,
      dite_eq_right hi]
    exact glueAlphabetIsometry_ofEq (componentType_a5FourthD4BlockPerm i)
      (a5FourthD4.valid_componentType i)
      (a5FourthD4.valid_componentType (a5FourthD4ComponentPerm i))
      (a5FourthD4.isSimplyLaced_componentType i)
      (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm i)) x

/-- **The triality-coupled self-isometry of `niemeierA5FourthD4`**: the order-`3` self-isometry of
`a5FourthD4.lattice` that fixes the leading `A₅` component, cycles the three `A₅` components
`(1, 2, 3)` marked in `[2(024)0]`, and acts by `typeD4Triality` on the `D₄` component at index
`4`. -/
noncomputable def a5FourthD4TrialityIsometry :
    Isometry a5FourthD4.lattice a5FourthD4.lattice :=
  (Isometry.ofEq (lattice_def a5FourthD4)).trans <|
    (gluedLatticePiCongrIsometry a5FourthD4.componentType
      a5FourthD4.isSimplyLaced_componentType a5FourthD4.valid_componentType
      a5FourthD4.glueSubgroup a5FourthD4.isIsotropic_glueSubgroup
      a5FourthD4.valid_componentType a5FourthD4.isIsotropic_glueSubgroup
      a5FourthD4ComponentPerm a5FourthD4ComponentIsometry
      (fun i x ↦ a5FourthD4ComponentGlueIsometry i x)
      glueAlphabetIsometry_a5FourthD4ComponentGlueIsometry fun w ↦ by
        have heq : Equiv.piCongrLeft
            (fun k ↦ (a5FourthD4.componentType k).glueAlphabet
              (a5FourthD4.isSimplyLaced_componentType k))
            a5FourthD4ComponentPerm (fun i ↦ a5FourthD4ComponentGlueIsometry i (w i)) =
          a5FourthD4TrialityGlueIsometry w := by
          funext k
          obtain ⟨i, rfl⟩ := a5FourthD4ComponentPerm.surjective k
          rw [Equiv.piCongrLeft_apply_apply, a5FourthD4TrialityGlueIsometry,
            QuadraticMap.IsometryEquiv.piCongr_apply_apply]
        rw [heq]
        exact a5FourthD4TrialityGlueIsometry_mem_glueSubgroup_iff w).trans
      (Isometry.ofEq (lattice_def a5FourthD4).symm)

private theorem apply_cast_eq_apply_cast
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ)
    {a b : Fin a5FourthD4.components.length} (hab : a = b) {n : ℕ}
    (ha : n = (a5FourthD4.componentType a).rank)
    (hb : n = (a5FourthD4.componentType b).rank) (j : Fin n) :
    x a (Fin.cast ha j) = x b (Fin.cast hb j) := by
  subst hab
  rfl

/-- On any of the four `A₅` components (`i < 4`), `a5FourthD4TrialityIsometry` moves component `i`
to component `a5FourthD4ComponentPerm i` without changing its simple-root coordinates. -/
theorem a5FourthD4TrialityIsometry_apply_of_lt_four
    (x : ∀ k, Fin (a5FourthD4.componentType k).rank → ℚ)
    {i : Fin a5FourthD4.components.length} (hi : i.val < 4)
    (j : Fin (a5FourthD4.componentType (a5FourthD4ComponentPerm i)).rank) :
    a5FourthD4TrialityIsometry x (a5FourthD4ComponentPerm i) j =
      x i (Fin.cast (congrArg rank (componentType_a5FourthD4BlockPerm i)).symm j) := by
  have hi4 : i ≠ a5FourthD4LastIndex := fun h ↦ by rw [h] at hi; exact absurd hi (by decide)
  rw [a5FourthD4TrialityIsometry, Isometry.trans_apply, Isometry.trans_apply, Isometry.ofEq_apply,
    Isometry.ofEq_apply, gluedLatticePiCongrIsometry_apply, a5FourthD4ComponentIsometry,
    dite_eq_right hi4, rootLatticeIsometryOfEq_apply]

/-- `a5FourthD4ComponentPerm⁻¹` preserves the Dynkin type of every component of `A₅⁴ D₄`. -/
theorem componentType_a5FourthD4ComponentPerm_inv (k : Fin a5FourthD4.components.length) :
    a5FourthD4.componentType k = a5FourthD4.componentType (a5FourthD4ComponentPerm⁻¹ k) := by
  have hk : a5FourthD4ComponentPerm (a5FourthD4ComponentPerm⁻¹ k) = k :=
    Equiv.Perm.inv_def a5FourthD4ComponentPerm ▸ a5FourthD4ComponentPerm.apply_symm_apply k
  exact (congrArg a5FourthD4.componentType hk.symm).trans
    (componentType_a5FourthD4BlockPerm (a5FourthD4ComponentPerm⁻¹ k)).symm

private theorem val_a5FourthD4BlockPerm_inv_lt_four (k : Fin 5) (hk : k.val < 4) :
    ((a5FourthD4BlockPerm⁻¹ : Equiv.Perm (Fin 5)) k).val < 4 := by
  rw [a5FourthD4BlockPerm_inv_apply]
  fin_cases k <;> simp_all

/-- `a5FourthD4ComponentPerm⁻¹` preserves the first four (`A₅`) positions. -/
private theorem val_a5FourthD4ComponentPerm_inv_lt_four
    {k : Fin a5FourthD4.components.length} (hk : k.val < 4) :
    (a5FourthD4ComponentPerm⁻¹ k).val < 4 :=
  val_a5FourthD4BlockPerm_inv_lt_four ⟨k.val, k.isLt⟩ hk

/-- Reading an `A₅` component `k` (`k < 4`) of `a5FourthD4TrialityIsometry x` pulls back from
position `a5FourthD4ComponentPerm⁻¹ k`. -/
theorem a5FourthD4TrialityIsometry_apply_of_lt_four'
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ)
    {k : Fin a5FourthD4.components.length} (hk : k.val < 4)
    (j : Fin (a5FourthD4.componentType k).rank) :
    a5FourthD4TrialityIsometry x k j =
      x (a5FourthD4ComponentPerm⁻¹ k)
        (Fin.cast (congrArg rank (componentType_a5FourthD4ComponentPerm_inv k)) j) := by
  have heq : a5FourthD4ComponentPerm (a5FourthD4ComponentPerm⁻¹ k) = k :=
    Equiv.Perm.inv_def a5FourthD4ComponentPerm ▸ a5FourthD4ComponentPerm.apply_symm_apply k
  have h1 := apply_cast_eq_apply_cast (a5FourthD4TrialityIsometry x) heq.symm rfl
    (congrArg (fun m ↦ (a5FourthD4.componentType m).rank) heq.symm) j
  rw [Fin.cast_refl, id_eq] at h1
  refine h1.trans ?_
  rw [a5FourthD4TrialityIsometry_apply_of_lt_four x (val_a5FourthD4ComponentPerm_inv_lt_four hk),
    Fin.cast_cast]

/-- On the `D₄` component at index `4`, `a5FourthD4TrialityIsometry` acts as `typeD4Triality`. -/
@[simp]
theorem a5FourthD4TrialityIsometry_apply_four
    (x : ∀ k, Fin (a5FourthD4.componentType k).rank → ℚ) :
    a5FourthD4TrialityIsometry x a5FourthD4LastIndex =
      typeD4Triality (isSimplyLaced_D 4) (x a5FourthD4LastIndex) := by
  ext j
  have h1 := apply_cast_eq_apply_cast (a5FourthD4TrialityIsometry x)
    a5FourthD4ComponentPerm_last.symm rfl
    (congrArg (fun m ↦ (a5FourthD4.componentType m).rank) a5FourthD4ComponentPerm_last.symm) j
  rw [Fin.cast_refl, id_eq] at h1
  refine h1.trans ?_
  rw [a5FourthD4TrialityIsometry, Isometry.trans_apply, Isometry.trans_apply, Isometry.ofEq_apply,
    Isometry.ofEq_apply, gluedLatticePiCongrIsometry_apply, a5FourthD4ComponentIsometry,
    dite_eq_left rfl]
  refine (congrFun (Isometry.trans_apply
    (typeD4Triality (isSimplyLaced_D 4))
    ((D 4).rootLatticeIsometryOfEq (isSimplyLaced_D 4) d4_eq_componentType_perm_last
      (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentPerm a5FourthD4LastIndex)))
    (x a5FourthD4LastIndex)) _).trans ?_
  exact (rootLatticeIsometryOfEq_apply _ _ _ _ _ _).trans
    (congrArg (typeD4Triality (isSimplyLaced_D 4) (x a5FourthD4LastIndex)) (Fin.ext rfl))

/-- **`a5FourthD4TrialityIsometry` has cube equal to `1`.** -/
@[simp]
theorem a5FourthD4TrialityIsometry_pow_three : a5FourthD4TrialityIsometry ^ 3 = 1 := by
  refine Isometry.ext fun x ↦ funext fun k ↦ ?_
  by_cases hk : k.val < 4
  · have hk1 := val_a5FourthD4ComponentPerm_inv_lt_four hk
    have hk2 := val_a5FourthD4ComponentPerm_inv_lt_four hk1
    ext j
    simp only [pow_three, Isometry.mul_apply, Isometry.one_apply]
    rw [a5FourthD4TrialityIsometry_apply_of_lt_four' _ hk,
      a5FourthD4TrialityIsometry_apply_of_lt_four' _ hk1,
      a5FourthD4TrialityIsometry_apply_of_lt_four' _ hk2, Fin.cast_cast, Fin.cast_cast]
    have hinv3 : a5FourthD4ComponentPerm⁻¹
        (a5FourthD4ComponentPerm⁻¹ (a5FourthD4ComponentPerm⁻¹ k)) = k := by
      have hp : (a5FourthD4ComponentPerm⁻¹) ^ 3 = 1 := by
        rw [inv_pow, show a5FourthD4ComponentPerm ^ 3 = 1 from a5FourthD4BlockPerm_pow_three,
          inv_one]
      simpa only [pow_three, Equiv.Perm.mul_apply, Equiv.Perm.one_apply] using
        congrArg (fun σ ↦ σ k) hp
    exact (apply_cast_eq_apply_cast x hinv3 _ rfl j).trans (by rw [Fin.cast_refl, id_eq])
  · have hk5 : k.val < 5 := k.isLt
    have hk4 : k = a5FourthD4LastIndex := Fin.ext (by change k.val = 4; omega)
    subst hk4
    simp only [pow_three, Isometry.mul_apply, Isometry.one_apply,
      a5FourthD4TrialityIsometry_apply_four]
    let y : Fin (D 4).rank → ℚ := x a5FourthD4LastIndex
    have h3 := congrArg (fun f : Isometry ((D 4).rootLattice (isSimplyLaced_D 4))
        ((D 4).rootLattice (isSimplyLaced_D 4)) ↦ f y)
      (typeD4Triality_pow_three (isSimplyLaced_D 4))
    rw [pow_three, Isometry.mul_apply, Isometry.mul_apply, Isometry.one_apply] at h3
    exact h3

/-- `a5FourthD4TrialityIsometry` is nontrivial: it moves a vector supported at `A₅` position `1`
to position `2`. -/
theorem a5FourthD4TrialityIsometry_ne_one : a5FourthD4TrialityIsometry ≠ 1 := by
  intro h
  let i1 : Fin a5FourthD4.components.length := ⟨1, by decide⟩
  let i2 : Fin a5FourthD4.components.length := ⟨2, by decide⟩
  let v : ∀ k, Fin (a5FourthD4.componentType k).rank → ℚ := Pi.single i1 fun _ ↦ (1 : ℚ)
  have hx := congrFun (congrFun (congrArg DFunLike.coe h) v) i2
  have h2 := a5FourthD4TrialityIsometry_apply_of_lt_four' v (k := i2) (by decide) ⟨0, by decide⟩
  rw [hx, Isometry.one_apply] at h2
  have hne : i2 ≠ i1 := by decide
  have hinv : a5FourthD4ComponentPerm⁻¹ i2 = i1 := by
    change (a5FourthD4BlockPerm⁻¹ : Equiv.Perm (Fin 5)) 2 = 1
    rw [a5FourthD4BlockPerm_inv_apply]
    rfl
  have hlhs : v i2 ⟨0, by decide⟩ = 0 := by simp [v, Pi.single_eq_of_ne hne]
  have hrhs : v (a5FourthD4ComponentPerm⁻¹ i2)
      (Fin.cast (congrArg rank (componentType_a5FourthD4ComponentPerm_inv i2)) ⟨0, by decide⟩) =
      1 := by
    refine (apply_cast_eq_apply_cast v hinv _ rfl ⟨0, by decide⟩).trans ?_
    simp [v]
  exact zero_ne_one (hlhs.symm.trans (h2.trans hrhs))

/-- **`a5FourthD4TrialityIsometry` has order `3` in the isometry group of `niemeierA5FourthD4`.** -/
@[simp]
theorem orderOf_a5FourthD4TrialityIsometry : orderOf a5FourthD4TrialityIsometry = 3 :=
  orderOf_eq_prime a5FourthD4TrialityIsometry_pow_three a5FourthD4TrialityIsometry_ne_one

/-! ### Lifting the pattern symmetries of `A₅⁴ D₄` -/

/-- The exponent in `{0, 1, 2}` recovering a power of `a5FourthD4BlockPerm` from where it sends
position `1`. -/
private def a5FourthD4PermExponent (g : Equiv.Perm (Fin 5)) : ℕ :=
  ![0, 0, 1, 2, 0] (g 1)

private theorem a5FourthD4PermExponent_one : a5FourthD4PermExponent 1 = 0 :=
  (rfl)

private theorem a5FourthD4PermExponent_pow (k : ℕ) :
    a5FourthD4PermExponent (a5FourthD4BlockPerm ^ k) = k % 3 := by
  rw [pow_eq_pow_mod k a5FourthD4BlockPerm_pow_three]
  have hr : ∀ r : Fin 3, a5FourthD4PermExponent (a5FourthD4BlockPerm ^ r.val) = r.val := by
    intro r
    fin_cases r
    · rfl
    · simp [a5FourthD4PermExponent]
    · simp [a5FourthD4PermExponent, pow_two]
  exact hr ⟨k % 3, Nat.mod_lt k (by decide)⟩

/-- Reindexing `p.symmetries` onto `Equiv.Perm (Fin 5)` for any pattern `p` of `A₅⁴ D₄`. -/
private def a5FourthD4PatternPermHom {p : GluePattern} (hp : p ∈ a5FourthD4.gluePatterns) :
    p.symmetries →* Equiv.Perm (Fin 5) :=
  (finCongr ((length_eq_of_mem_gluePatterns hp).trans
    length_components_a5FourthD4)).permCongrHom.toMonoidHom.comp p.symmetries.subtype

private theorem a5FourthD4CyclicPattern_mem :
    GluePattern.cyclic [2] [0, 2, 4] [0] ∈ a5FourthD4.gluePatterns :=
  List.Mem.head _

private theorem permCongrHom_cyclicGen_pow (k : ℕ) :
    (finCongr (rfl : ([2].length + [0, 2, 4].length + [0].length) = 5)).permCongrHom
        (Equiv.Perm.finSumPerm (Equiv.Perm.finSumPerm 1 (finRotate [0, 2, 4].length)) 1 ^ k) =
      a5FourthD4BlockPerm ^ k :=
  map_pow (finCongr (rfl : ([2].length + [0, 2, 4].length + [0].length) = 5)).permCongrHom
    (Equiv.Perm.finSumPerm (Equiv.Perm.finSumPerm 1 (finRotate [0, 2, 4].length)) 1) k

/-- For the cyclic pattern `[2(024)0]` of `A₅⁴ D₄`, the group homomorphism sending each power
`a5FourthD4BlockPerm ^ k` in its symmetry group to `a5FourthD4TrialityIsometry ^ k`. -/
noncomputable def a5FourthD4CyclicPatternIsometryHom :
    (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries →*
      Isometry a5FourthD4.lattice a5FourthD4.lattice where
  toFun g :=
    a5FourthD4TrialityIsometry ^
      a5FourthD4PermExponent (a5FourthD4PatternPermHom a5FourthD4CyclicPattern_mem g)
  map_one' := by
    rw [map_one, a5FourthD4PermExponent_one, pow_zero]
  map_mul' x y := by
    rcases x with ⟨g, hg⟩
    rcases y with ⟨h, hh⟩
    have hg' := hg
    have hh' := hh
    rw [GluePattern.symmetries_cyclic] at hg' hh'
    obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp (mem_powers_iff_mem_zpowers.mpr hg')
    obtain ⟨m, hm⟩ := (Submonoid.mem_powers_iff _ _).mp (mem_powers_iff_mem_zpowers.mpr hh')
    have hgk : a5FourthD4PatternPermHom a5FourthD4CyclicPattern_mem ⟨g, hg⟩ =
        a5FourthD4BlockPerm ^ k := by
      refine (congrArg ((finCongr
        ((length_eq_of_mem_gluePatterns a5FourthD4CyclicPattern_mem).trans
          length_components_a5FourthD4)).permCongrHom) hk.symm).trans ?_
      exact permCongrHom_cyclicGen_pow k
    have hhm : a5FourthD4PatternPermHom a5FourthD4CyclicPattern_mem ⟨h, hh⟩ =
        a5FourthD4BlockPerm ^ m := by
      refine (congrArg ((finCongr
        ((length_eq_of_mem_gluePatterns a5FourthD4CyclicPattern_mem).trans
          length_components_a5FourthD4)).permCongrHom) hm.symm).trans ?_
      exact permCongrHom_cyclicGen_pow m
    rw [map_mul, hgk, hhm, ← pow_add, a5FourthD4PermExponent_pow, a5FourthD4PermExponent_pow,
      a5FourthD4PermExponent_pow, ← pow_eq_pow_mod _ a5FourthD4TrialityIsometry_pow_three,
      ← pow_eq_pow_mod _ a5FourthD4TrialityIsometry_pow_three,
      ← pow_eq_pow_mod _ a5FourthD4TrialityIsometry_pow_three, pow_add]

/-- `a5FourthD4CyclicPatternIsometryHom` sends the `k`-th power of the block-rotation generator of
`[2(024)0]` to `a5FourthD4TrialityIsometry ^ k`. -/
@[simp]
theorem a5FourthD4CyclicPatternIsometryHom_pow (k : ℕ)
    (hk : (a5FourthD4BlockPerm ^ k :
        Equiv.Perm (Fin (GluePattern.cyclic [2] [0, 2, 4] [0]).length)) ∈
      (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries) :
    a5FourthD4CyclicPatternIsometryHom ⟨a5FourthD4BlockPerm ^ k, hk⟩ =
      a5FourthD4TrialityIsometry ^ k := by
  have hpow : a5FourthD4PatternPermHom a5FourthD4CyclicPattern_mem ⟨a5FourthD4BlockPerm ^ k, hk⟩ =
      a5FourthD4BlockPerm ^ k :=
    map_pow (finCongr rfl).permCongrHom a5FourthD4BlockPerm k
  change a5FourthD4TrialityIsometry ^
    a5FourthD4PermExponent (a5FourthD4PatternPermHom a5FourthD4CyclicPattern_mem _) = _
  rw [hpow, a5FourthD4PermExponent_pow, ← pow_eq_pow_mod k a5FourthD4TrialityIsometry_pow_three]

private theorem eq_one_of_mem_symmetries_literal (l : List ℕ)
    (x : (GluePattern.literal l).symmetries) : x = 1 := by
  rcases x with ⟨g, hg⟩
  rw [GluePattern.symmetries_literal, Subgroup.mem_bot] at hg
  exact Subtype.ext hg

/-- **Every glue pattern of `A₅⁴ D₄` acts on `niemeierA5FourthD4`**: the cyclic pattern `[2(024)0]`
acts through `a5FourthD4CyclicPatternIsometryHom` (coupling the `(1, 2, 3)` block rotation with `D₄`
triality), and each of the three literal patterns has trivial symmetry group acting trivially. -/
noncomputable def a5FourthD4PatternIsometryHom {p : GluePattern}
    (hp : p ∈ a5FourthD4.gluePatterns) :
    p.symmetries →* Isometry a5FourthD4.lattice a5FourthD4.lattice where
  toFun g := a5FourthD4TrialityIsometry ^ a5FourthD4PermExponent (a5FourthD4PatternPermHom hp g)
  map_one' := by
    rw [map_one, a5FourthD4PermExponent_one, pow_zero]
  map_mul' x y := by
    simp only [gluePatterns, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact a5FourthD4CyclicPatternIsometryHom.map_mul x y
    all_goals
      rw [eq_one_of_mem_symmetries_literal _ x, eq_one_of_mem_symmetries_literal _ y,
        mul_one, map_one, a5FourthD4PermExponent_one, pow_zero, mul_one]

/-- On the cyclic pattern `[2(024)0]`, `a5FourthD4PatternIsometryHom` agrees with
`a5FourthD4CyclicPatternIsometryHom`. -/
@[simp]
theorem a5FourthD4PatternIsometryHom_cyclic
    (hp : GluePattern.cyclic [2] [0, 2, 4] [0] ∈ a5FourthD4.gluePatterns) :
    a5FourthD4PatternIsometryHom hp = a5FourthD4CyclicPatternIsometryHom :=
  (rfl)

end RootfulNiemeierType

