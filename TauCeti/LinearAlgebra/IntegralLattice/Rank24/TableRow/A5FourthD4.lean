module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Niemeier
public import TauCeti.LinearAlgebra.IntegralLattice.Isometry.Group
public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeD.Triality

/-!
# Triality-twisted block rotation of the Niemeier lattice `A₅⁴ D₄`

The row `A₅⁴ D₄` of Conway--Sloane's Table 16.1, `TauCeti.RootfulNiemeierType.a5FourthD4`, glues
four `A₅` root lattices and one `D₄` root lattice along the subgroup generated by the cyclic
pattern `[2(024)0]` and the three literal words `[33001]`, `[30302]`, `[30033]`.

Rotating the three marked `A₅` components in positions `1, 2, 3` while leaving the `D₄` component
untouched preserves `[2(024)0]`, but does not preserve the glue subgroup: it sends `[33001]` to
`[30301]`, which differs from `[30302]` by the nonzero word `[00003]` of shortest norm `1`.
Accompanying the block rotation `1 ↦ 2 ↦ 3 ↦ 1` of the `A₅` components by the triality isometry
`TauCeti.DynkinType.typeD4Triality` on the `D₄` component in position `4` simultaneously cycles the
Conway--Sloane `D₄` labels `1 ↦ 2 ↦ 3 ↦ 1`, so it cycles `[33001] ↦ [30302] ↦ [30033] ↦ [33001]`
while permuting the expansions of `[2(024)0]`.

This file constructs the resulting glue-module isometry `a5FourthD4GlueTriality`, the order-`3`
self-isometry `a5FourthD4BlockRotation` of `niemeierA5FourthD4`, and the faithful actions
`a5FourthD4CyclicPatternIsometryHom` and `a5FourthD4PatternIsometryHom` of the glue patterns of
`A₅⁴ D₄` on `niemeierA5FourthD4`.

## Main declarations

* `TauCeti.RootfulNiemeierType.a5FourthD4BlockPerm`: the block rotation fixing `0` and `4` and
  cycling `1 ↦ 2 ↦ 3 ↦ 1`, equal to the generator of
  `(GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries` (`a5FourthD4BlockPerm_eq_finSumPerm`).
* `TauCeti.RootfulNiemeierType.a5FourthD4GlueTriality`: the triality-twisted block rotation of
  `a5FourthD4.glueModule`, preserving `a5FourthD4.glueGenerators` and `a5FourthD4.glueSubgroup`
  (`a5FourthD4GlueTriality_mem_glueSubgroup_iff`).
* `TauCeti.RootfulNiemeierType.a5FourthD4BlockRotation`: the induced self-isometry of
  `niemeierA5FourthD4`, of order `3` (`orderOf_a5FourthD4BlockRotation`).
* `TauCeti.RootfulNiemeierType.a5FourthD4CyclicPatternIsometryHom`,
  `TauCeti.RootfulNiemeierType.a5FourthD4PatternIsometryHom`: the faithful action of the cyclic
  pattern `[2(024)0]` and of every glue pattern of `A₅⁴ D₄` on `niemeierA5FourthD4`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §§3 and 7.1, and Chapter 16, §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType IntegralLattice

/-! ### Component metadata and the `A₅` block permutation -/

/-- The row `A₅⁴ D₄` has five components. -/
theorem length_components_a5FourthD4 : a5FourthD4.components.length = 5 :=
  (rfl)

/-- The six Conway--Sloane digit words of the row `A₅⁴ D₄`. -/
theorem glueWords_a5FourthD4 :
    a5FourthD4.glueWords =
      {[2, 0, 2, 4, 0], [2, 2, 4, 0, 0], [2, 4, 0, 2, 0],
        [3, 3, 0, 0, 1], [3, 0, 3, 0, 2], [3, 0, 0, 3, 3]} := by
  decide

/-- **The block rotation of the three marked `A₅` components of `A₅⁴ D₄`**: fixing positions `0`
and `4` and cycling positions `1 ↦ 2 ↦ 3 ↦ 1`. -/
def a5FourthD4BlockPerm : Equiv.Perm (Fin a5FourthD4.components.length) where
  toFun := ![0, 2, 3, 1, 4]
  invFun := ![0, 3, 1, 2, 4]
  left_inv i := by fin_cases i <;> rfl
  right_inv i := by fin_cases i <;> rfl

/-- `a5FourthD4BlockPerm` maps `0, 1, 2, 3, 4` to `0, 2, 3, 1, 4`. -/
@[simp]
theorem a5FourthD4BlockPerm_apply (i : Fin a5FourthD4.components.length) :
    a5FourthD4BlockPerm i = ![0, 2, 3, 1, 4] i :=
  (rfl)

/-- `a5FourthD4BlockPerm.symm` maps `0, 1, 2, 3, 4` to `0, 3, 1, 2, 4`. -/
@[simp]
theorem a5FourthD4BlockPerm_symm_apply (i : Fin a5FourthD4.components.length) :
    a5FourthD4BlockPerm.symm i = ![0, 3, 1, 2, 4] i :=
  (rfl)

/-- `a5FourthD4BlockPerm` preserves the Dynkin type of every component of `A₅⁴ D₄`. -/
theorem componentType_a5FourthD4BlockPerm (i : Fin a5FourthD4.components.length) :
    a5FourthD4.componentType (a5FourthD4BlockPerm i) = a5FourthD4.componentType i := by
  fin_cases i <;> rfl

/-- `a5FourthD4BlockPerm` has order dividing three. -/
@[simp]
theorem a5FourthD4BlockPerm_pow_three : a5FourthD4BlockPerm ^ 3 = 1 := by
  decide

/-- `a5FourthD4BlockPerm` is nontrivial. -/
theorem a5FourthD4BlockPerm_ne_one : a5FourthD4BlockPerm ≠ 1 := by
  decide

/-- `a5FourthD4BlockPerm` has order three. -/
@[simp]
theorem orderOf_a5FourthD4BlockPerm : orderOf a5FourthD4BlockPerm = 3 :=
  orderOf_eq_prime a5FourthD4BlockPerm_pow_three a5FourthD4BlockPerm_ne_one

/-- `a5FourthD4BlockPerm` is the block rotation generating the symmetries of `[2(024)0]`. -/
theorem a5FourthD4BlockPerm_eq_finSumPerm :
    a5FourthD4BlockPerm =
      Equiv.Perm.finSumPerm
        (Equiv.Perm.finSumPerm (1 : Equiv.Perm (Fin 1)) (finRotate 3))
        (1 : Equiv.Perm (Fin 1)) := by
  symm
  ext i
  revert i
  -- Split `Fin ((1 + 3) + 1)` along the outer and inner block sums so `finSumPerm` evaluates via
  -- its public `@[simp]` lemmas before `fin_cases` reduces the indices.
  refine Fin.addCases (fun j ↦ ?_) (fun j ↦ ?_)
  · rw [Equiv.Perm.finSumPerm_apply_castAdd]
    revert j
    refine Fin.addCases (fun k ↦ ?_) (fun k ↦ ?_)
    · rw [Equiv.Perm.finSumPerm_apply_castAdd]
      fin_cases k
      simp
      rfl
    · rw [Equiv.Perm.finSumPerm_apply_natAdd]
      fin_cases k <;> (simp; rfl)
  · rw [Equiv.Perm.finSumPerm_apply_natAdd]
    fin_cases j
    simp
    rfl

private theorem mem_zpowers_a5FourthD4BlockPerm_iff
    {g : Equiv.Perm (Fin a5FourthD4.components.length)} :
    g ∈ Subgroup.zpowers a5FourthD4BlockPerm ↔
      g = 1 ∨ g = a5FourthD4BlockPerm ∨ g = a5FourthD4BlockPerm ^ 2 := by
  refine ⟨fun hg ↦ ?_, ?_⟩
  · obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
    rw [zpow_eq_zpow_emod' k a5FourthD4BlockPerm_pow_three, Nat.cast_ofNat]
    have h0 : 0 ≤ k % 3 := Int.emod_nonneg k (by decide)
    have : k % 3 < 3 := Int.emod_lt_of_pos k (by decide)
    obtain ⟨m, hm⟩ := Int.eq_ofNat_of_zero_le h0
    have hm3 : m < 3 := by omega
    rw [hm, zpow_natCast]
    interval_cases m
    · exact Or.inl rfl
    · exact Or.inr (Or.inl (pow_one _))
    · exact Or.inr (Or.inr rfl)
  · rintro (rfl | rfl | rfl)
    · exact one_mem _
    · exact Subgroup.mem_zpowers _
    · exact pow_mem (Subgroup.mem_zpowers _) 2

/-- The symmetries of the cyclic pattern `[2(024)0]` are `1`, `a5FourthD4BlockPerm`, and
`a5FourthD4BlockPerm ^ 2`. -/
theorem mem_symmetries_a5FourthD4_cyclic_iff
    {g : Equiv.Perm (Fin (GluePattern.cyclic [2] [0, 2, 4] [0]).length)} :
    g ∈ (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries ↔
      g = 1 ∨ g = a5FourthD4BlockPerm ∨ g = a5FourthD4BlockPerm ^ 2 := by
  have hsym : (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries =
      Subgroup.zpowers a5FourthD4BlockPerm :=
    (GluePattern.symmetries_cyclic [2] [0, 2, 4] [0]).trans
      (congrArg Subgroup.zpowers a5FourthD4BlockPerm_eq_finSumPerm.symm)
  exact (Iff.of_eq (congrArg (g ∈ ·) hsym)).trans mem_zpowers_a5FourthD4BlockPerm_iff

/-! ### Triality-twisted block rotation of glue words -/

private theorem eq_fin_a5FourthD4 (i : Fin a5FourthD4.components.length) :
    i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 := by
  fin_cases i <;> decide

/-- The componentwise glue-alphabet isometries: the identity on the four `A₅` alphabets and
`typeD4GlueAlphabetTriality` on the `D₄` alphabet in position `4`. -/
private noncomputable def a5FourthD4ComponentGlueTriality :
    (i : Fin a5FourthD4.components.length) →
      FiniteQuadraticModule.Isometry
        ((a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i))
        ((a5FourthD4.componentType (a5FourthD4BlockPerm i)).glueAlphabet
          (a5FourthD4.isSimplyLaced_componentType (a5FourthD4BlockPerm i)))
  | ⟨0, _⟩ => QuadraticMap.IsometryEquiv.refl _
  | ⟨1, _⟩ => QuadraticMap.IsometryEquiv.refl _
  | ⟨2, _⟩ => QuadraticMap.IsometryEquiv.refl _
  | ⟨3, _⟩ => QuadraticMap.IsometryEquiv.refl _
  | ⟨4, _⟩ => typeD4GlueAlphabetTriality (isSimplyLaced_D 4)

/-- **The triality-twisted block rotation of the glue words of `A₅⁴ D₄`**: moving the `A₅` glue
labels along `a5FourthD4BlockPerm` (`1 ↦ 2 ↦ 3 ↦ 1`, fixing `0`) while applying
`typeD4GlueAlphabetTriality` (`1 ↦ 2 ↦ 3 ↦ 1` on Conway--Sloane labels) to the `D₄` glue label in
position `4`. -/
noncomputable def a5FourthD4GlueTriality :
    FiniteQuadraticModule.Isometry a5FourthD4.glueModule a5FourthD4.glueModule :=
  (QuadraticMap.IsometryEquiv.pi a5FourthD4ComponentGlueTriality).trans
    (QuadraticMap.IsometryEquiv.piCongrLeft
      (fun i ↦ ((a5FourthD4.componentType i).glueAlphabet
        (a5FourthD4.isSimplyLaced_componentType i)).quadratic)
      a5FourthD4BlockPerm)

private theorem a5FourthD4GlueTriality_apply_blockPerm (w : a5FourthD4.glueModule)
    (i : Fin a5FourthD4.components.length) :
    a5FourthD4GlueTriality w (a5FourthD4BlockPerm i) =
      a5FourthD4ComponentGlueTriality i (w i) :=
  QuadraticMap.IsometryEquiv.piCongrLeft_apply_apply _ a5FourthD4BlockPerm _ i

/-- `a5FourthD4GlueTriality` fixes position `0`. -/
theorem a5FourthD4GlueTriality_apply_zero (w : a5FourthD4.glueModule) :
    a5FourthD4GlueTriality w 0 = w 0 :=
  a5FourthD4GlueTriality_apply_blockPerm w 0

/-- `a5FourthD4GlueTriality` moves position `3` to position `1`. -/
theorem a5FourthD4GlueTriality_apply_one (w : a5FourthD4.glueModule) :
    a5FourthD4GlueTriality w 1 = w 3 :=
  a5FourthD4GlueTriality_apply_blockPerm w 3

/-- `a5FourthD4GlueTriality` moves position `1` to position `2`. -/
theorem a5FourthD4GlueTriality_apply_two (w : a5FourthD4.glueModule) :
    a5FourthD4GlueTriality w 2 = w 1 :=
  a5FourthD4GlueTriality_apply_blockPerm w 1

/-- `a5FourthD4GlueTriality` moves position `2` to position `3`. -/
theorem a5FourthD4GlueTriality_apply_three (w : a5FourthD4.glueModule) :
    a5FourthD4GlueTriality w 3 = w 2 :=
  a5FourthD4GlueTriality_apply_blockPerm w 2

/-- `a5FourthD4GlueTriality` applies `typeD4GlueAlphabetTriality` at position `4`. -/
theorem a5FourthD4GlueTriality_apply_four (w : a5FourthD4.glueModule) :
    a5FourthD4GlueTriality w 4 = typeD4GlueAlphabetTriality (isSimplyLaced_D 4) (w 4) :=
  a5FourthD4GlueTriality_apply_blockPerm w 4

/-- `a5FourthD4GlueTriality` has order three under composition. -/
@[simp]
theorem a5FourthD4GlueTriality_trans_three :
    ((a5FourthD4GlueTriality.trans a5FourthD4GlueTriality).trans a5FourthD4GlueTriality) =
      QuadraticMap.IsometryEquiv.refl _ := by
  refine DFunLike.ext _ _ fun w ↦ funext fun i ↦ ?_
  change a5FourthD4GlueTriality (a5FourthD4GlueTriality (a5FourthD4GlueTriality w)) i = w i
  rcases eq_fin_a5FourthD4 i with rfl | rfl | rfl | rfl | rfl
  · exact (a5FourthD4GlueTriality_apply_zero _).trans
      ((a5FourthD4GlueTriality_apply_zero _).trans (a5FourthD4GlueTriality_apply_zero w))
  · exact (a5FourthD4GlueTriality_apply_one _).trans
      ((a5FourthD4GlueTriality_apply_three _).trans (a5FourthD4GlueTriality_apply_two w))
  · exact (a5FourthD4GlueTriality_apply_two _).trans
      ((a5FourthD4GlueTriality_apply_one _).trans (a5FourthD4GlueTriality_apply_three w))
  · exact (a5FourthD4GlueTriality_apply_three _).trans
      ((a5FourthD4GlueTriality_apply_two _).trans (a5FourthD4GlueTriality_apply_one w))
  · exact (a5FourthD4GlueTriality_apply_four _).trans
      ((congrArg (typeD4GlueAlphabetTriality (isSimplyLaced_D 4))
        ((a5FourthD4GlueTriality_apply_four _).trans
          (congrArg (typeD4GlueAlphabetTriality (isSimplyLaced_D 4))
            (a5FourthD4GlueTriality_apply_four w)))).trans
        (DFunLike.congr_fun (typeD4GlueAlphabetTriality_trans_three (isSimplyLaced_D 4)) (w 4)))

/-- On digit lists, `a5FourthD4GlueTriality` rotates the middle three digits `a₁, a₂, a₃` to
`a₃, a₁, a₂` and applies `typeD4GlueLabelPerm` to the `D₄` digit `a₄`. -/
theorem encodeGlueWord_a5FourthD4GlueTriality_of_eq (w : a5FourthD4.glueModule)
    {a₀ a₁ a₂ a₃ a₄ : ℕ} (ha₄ : a₄ < 4)
    (hw : encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w =
      [a₀, a₁, a₂, a₃, a₄]) :
    encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
        (a5FourthD4GlueTriality w) =
      [a₀, a₃, a₁, a₂, (typeD4GlueLabelPerm ⟨a₄, ha₄⟩).val] := by
  have h0 : (((a5FourthD4.componentType 0).glueLabelEquiv
      (a5FourthD4.isSimplyLaced_componentType 0)).symm (w 0)).val = a₀ := by
    simpa [hw, length_components_a5FourthD4] using
      (getElem_encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w
        0).symm
  have h1 : (((a5FourthD4.componentType 1).glueLabelEquiv
      (a5FourthD4.isSimplyLaced_componentType 1)).symm (w 1)).val = a₁ := by
    simpa [hw, length_components_a5FourthD4] using
      (getElem_encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w
        1).symm
  have h2 : (((a5FourthD4.componentType 2).glueLabelEquiv
      (a5FourthD4.isSimplyLaced_componentType 2)).symm (w 2)).val = a₂ := by
    simpa [hw, length_components_a5FourthD4] using
      (getElem_encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w
        2).symm
  have h3 : (((a5FourthD4.componentType 3).glueLabelEquiv
      (a5FourthD4.isSimplyLaced_componentType 3)).symm (w 3)).val = a₃ := by
    simpa [hw, length_components_a5FourthD4] using
      (getElem_encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w
        3).symm
  have h4 : ((a5FourthD4.componentType 4).glueLabelEquiv
      (a5FourthD4.isSimplyLaced_componentType 4)).symm (w 4) = ⟨a₄, ha₄⟩ :=
    Fin.ext <| by
      simpa [hw, length_components_a5FourthD4] using
        (getElem_encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w
          4).symm
  apply List.ext_getElem
  · simp [length_components_a5FourthD4]
  · intro k hk₁ hk₂
    have hk5 : k < 5 := by simpa using hk₂
    have hget := getElem_encodeGlueWord a5FourthD4.componentType
      a5FourthD4.isSimplyLaced_componentType (a5FourthD4GlueTriality w) ⟨k, hk5⟩
    interval_cases k
    · exact hget.trans
        ((congrArg (fun x ↦ (((a5FourthD4.componentType 0).glueLabelEquiv _).symm x).val)
          (a5FourthD4GlueTriality_apply_zero w)).trans h0)
    · exact hget.trans
        ((congrArg (fun x ↦ (((a5FourthD4.componentType 1).glueLabelEquiv _).symm x).val)
          (a5FourthD4GlueTriality_apply_one w)).trans h3)
    · exact hget.trans
        ((congrArg (fun x ↦ (((a5FourthD4.componentType 2).glueLabelEquiv _).symm x).val)
          (a5FourthD4GlueTriality_apply_two w)).trans h1)
    · exact hget.trans
        ((congrArg (fun x ↦ (((a5FourthD4.componentType 3).glueLabelEquiv _).symm x).val)
          (a5FourthD4GlueTriality_apply_three w)).trans h2)
    · exact hget.trans
        ((congrArg (fun x ↦ (((D 4).glueLabelEquiv (isSimplyLaced_D 4)).symm x).val)
          (a5FourthD4GlueTriality_apply_four w)).trans
          (congrArg Fin.val
            ((glueLabelEquiv_symm_typeD4GlueAlphabetTriality (isSimplyLaced_D 4) (w 4)).trans
              (congrArg typeD4GlueLabelPerm h4))))

private theorem a5FourthD4GlueTriality_mem_glueGenerators {w : a5FourthD4.glueModule}
    (hw : w ∈ a5FourthD4.glueGenerators) :
    a5FourthD4GlueTriality w ∈ a5FourthD4.glueGenerators := by
  rw [mem_glueGenerators_iff, glueWords_a5FourthD4] at hw
  simp only [Finset.mem_insert, Finset.mem_singleton] at hw
  rcases hw with h | h | h | h | h | h <;>
    · rw [mem_glueGenerators_iff, encodeGlueWord_a5FourthD4GlueTriality_of_eq w (by decide) h,
        typeD4GlueLabelPerm_apply]
      decide

/-- `a5FourthD4GlueTriality` preserves the glue generators of `A₅⁴ D₄`. -/
@[simp]
theorem a5FourthD4GlueTriality_mem_glueGenerators_iff (w : a5FourthD4.glueModule) :
    a5FourthD4GlueTriality w ∈ a5FourthD4.glueGenerators ↔ w ∈ a5FourthD4.glueGenerators := by
  refine ⟨fun hw ↦ ?_, a5FourthD4GlueTriality_mem_glueGenerators⟩
  have h3 : a5FourthD4GlueTriality (a5FourthD4GlueTriality (a5FourthD4GlueTriality w)) = w :=
    DFunLike.congr_fun a5FourthD4GlueTriality_trans_three w
  rw [← h3]
  exact a5FourthD4GlueTriality_mem_glueGenerators
    (a5FourthD4GlueTriality_mem_glueGenerators hw)

/-- **`a5FourthD4GlueTriality` preserves the glue subgroup of `A₅⁴ D₄`.** -/
@[simp]
theorem a5FourthD4GlueTriality_mem_glueSubgroup_iff (w : a5FourthD4.glueModule) :
    a5FourthD4GlueTriality w ∈ a5FourthD4.glueSubgroup ↔ w ∈ a5FourthD4.glueSubgroup := by
  have hpre : a5FourthD4GlueTriality ⁻¹' a5FourthD4.glueGenerators = a5FourthD4.glueGenerators :=
    Set.ext a5FourthD4GlueTriality_mem_glueGenerators_iff
  have hmap : a5FourthD4.glueSubgroup.map
      (a5FourthD4GlueTriality : a5FourthD4.glueModule →+ a5FourthD4.glueModule) =
        a5FourthD4.glueSubgroup := by
    rw [glueSubgroup_def, AddMonoidHom.map_closure, AddMonoidHom.coe_ofClass]
    exact congrArg AddSubgroup.closure
      ((congrArg _ hpre.symm).trans
        (Set.image_preimage_eq _ (EquivLike.surjective a5FourthD4GlueTriality)))
  have h := AddSubgroup.mem_map_iff_mem
    (f := (a5FourthD4GlueTriality : a5FourthD4.glueModule →+ a5FourthD4.glueModule))
    (by rw [AddMonoidHom.coe_ofClass]; exact EquivLike.injective a5FourthD4GlueTriality)
    (K := a5FourthD4.glueSubgroup) (x := w)
  rwa [hmap, AddMonoidHom.coe_ofClass] at h

/-! ### The triality-twisted block rotation of `niemeierA5FourthD4` -/

/-- The componentwise root-lattice isometries: the identity on the four `A₅` root lattices and
`typeD4Triality` on the `D₄` root lattice in position `4`. -/
private noncomputable def a5FourthD4ComponentIsometry :
    (i : Fin a5FourthD4.components.length) →
      Isometry
        ((a5FourthD4.componentType i).rootLattice (a5FourthD4.isSimplyLaced_componentType i))
        ((a5FourthD4.componentType (a5FourthD4BlockPerm i)).rootLattice
          (a5FourthD4.isSimplyLaced_componentType (a5FourthD4BlockPerm i)))
  | ⟨0, _⟩ => Isometry.refl _
  | ⟨1, _⟩ => Isometry.refl _
  | ⟨2, _⟩ => Isometry.refl _
  | ⟨3, _⟩ => Isometry.refl _
  | ⟨4, _⟩ => typeD4Triality (isSimplyLaced_D 4)

private theorem glueAlphabetIsometry_a5FourthD4ComponentGlueTriality
    (i : Fin a5FourthD4.components.length)
    (x : (a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i)) :
    (a5FourthD4.componentType (a5FourthD4BlockPerm i)).glueAlphabetIsometry
        (a5FourthD4.valid_componentType (a5FourthD4BlockPerm i))
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4BlockPerm i))
        (a5FourthD4ComponentGlueTriality i x) =
      (a5FourthD4ComponentIsometry i).discriminantQuadraticIsometry
        ((a5FourthD4.componentType i).isEven_rootLattice (a5FourthD4.isSimplyLaced_componentType i))
        ((a5FourthD4.componentType i).glueAlphabetIsometry (a5FourthD4.valid_componentType i)
          (a5FourthD4.isSimplyLaced_componentType i) x) := by
  rcases eq_fin_a5FourthD4 i with rfl | rfl | rfl | rfl | rfl
  · exact ((Isometry.discriminantQuadraticIsometry_apply _ _ _).trans
      ((DFunLike.congr_fun (Isometry.discriminantGroupEquiv_refl _) _).trans
        (LinearEquiv.refl_apply _))).symm
  · exact ((Isometry.discriminantQuadraticIsometry_apply _ _ _).trans
      ((DFunLike.congr_fun (Isometry.discriminantGroupEquiv_refl _) _).trans
        (LinearEquiv.refl_apply _))).symm
  · exact ((Isometry.discriminantQuadraticIsometry_apply _ _ _).trans
      ((DFunLike.congr_fun (Isometry.discriminantGroupEquiv_refl _) _).trans
        (LinearEquiv.refl_apply _))).symm
  · exact ((Isometry.discriminantQuadraticIsometry_apply _ _ _).trans
      ((DFunLike.congr_fun (Isometry.discriminantGroupEquiv_refl _) _).trans
        (LinearEquiv.refl_apply _))).symm
  · exact glueAlphabetIsometry_typeD4GlueAlphabetTriality (isSimplyLaced_D 4)
      (a5FourthD4.valid_componentType 4) x

private theorem piCongrLeft_a5FourthD4ComponentGlueTriality_eq (w : a5FourthD4.glueModule) :
    Equiv.piCongrLeft
        (fun k ↦ (a5FourthD4.componentType k).glueAlphabet
          (a5FourthD4.isSimplyLaced_componentType k))
        a5FourthD4BlockPerm (fun i ↦ a5FourthD4ComponentGlueTriality i (w i)) =
      a5FourthD4GlueTriality w := by
  funext k
  obtain ⟨i, rfl⟩ := a5FourthD4BlockPerm.surjective k
  rw [Equiv.piCongrLeft_apply_apply, a5FourthD4GlueTriality_apply_blockPerm]

/-- **The triality-twisted block rotation of `niemeierA5FourthD4`**: the order-`3` self-isometry
fixing component `0`, cycling the three marked `A₅` components `1 ↦ 2 ↦ 3 ↦ 1`, and acting on the
`D₄` component in position `4` by `typeD4Triality`. -/
noncomputable def a5FourthD4BlockRotation :
    Isometry niemeierA5FourthD4 niemeierA5FourthD4 :=
  (Isometry.ofEq a5FourthD4.lattice_def).trans <|
    (gluedLatticePiCongrIsometry a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
      a5FourthD4.valid_componentType a5FourthD4.glueSubgroup a5FourthD4.isIsotropic_glueSubgroup
      a5FourthD4.valid_componentType a5FourthD4.isIsotropic_glueSubgroup a5FourthD4BlockPerm
      a5FourthD4ComponentIsometry (fun i x ↦ a5FourthD4ComponentGlueTriality i x)
      glueAlphabetIsometry_a5FourthD4ComponentGlueTriality fun w ↦ by
        rw [piCongrLeft_a5FourthD4ComponentGlueTriality_eq]
        exact a5FourthD4GlueTriality_mem_glueSubgroup_iff w).trans
    (Isometry.ofEq a5FourthD4.lattice_def.symm)

private theorem a5FourthD4BlockRotation_apply_blockPerm
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ)
    (i : Fin a5FourthD4.components.length) :
    a5FourthD4BlockRotation x (a5FourthD4BlockPerm i) = a5FourthD4ComponentIsometry i (x i) := by
  rw [a5FourthD4BlockRotation, Isometry.trans_apply, Isometry.trans_apply, Isometry.ofEq_apply,
    Isometry.ofEq_apply, gluedLatticePiCongrIsometry_apply_apply]

/-- `a5FourthD4BlockRotation` fixes component `0`. -/
@[simp]
theorem a5FourthD4BlockRotation_apply_zero
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ) :
    a5FourthD4BlockRotation x 0 = x 0 :=
  (a5FourthD4BlockRotation_apply_blockPerm x 0).trans
    (Isometry.refl_apply
      ((a5FourthD4.componentType 0).rootLattice (a5FourthD4.isSimplyLaced_componentType 0)) (x 0))

/-- `a5FourthD4BlockRotation` moves component `3` to component `1`. -/
@[simp]
theorem a5FourthD4BlockRotation_apply_one
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ) :
    a5FourthD4BlockRotation x 1 = x 3 :=
  (a5FourthD4BlockRotation_apply_blockPerm x 3).trans
    (Isometry.refl_apply
      ((a5FourthD4.componentType 3).rootLattice (a5FourthD4.isSimplyLaced_componentType 3)) (x 3))

/-- `a5FourthD4BlockRotation` moves component `1` to component `2`. -/
@[simp]
theorem a5FourthD4BlockRotation_apply_two
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ) :
    a5FourthD4BlockRotation x 2 = x 1 :=
  (a5FourthD4BlockRotation_apply_blockPerm x 1).trans
    (Isometry.refl_apply
      ((a5FourthD4.componentType 1).rootLattice (a5FourthD4.isSimplyLaced_componentType 1)) (x 1))

/-- `a5FourthD4BlockRotation` moves component `2` to component `3`. -/
@[simp]
theorem a5FourthD4BlockRotation_apply_three
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ) :
    a5FourthD4BlockRotation x 3 = x 2 :=
  (a5FourthD4BlockRotation_apply_blockPerm x 2).trans
    (Isometry.refl_apply
      ((a5FourthD4.componentType 2).rootLattice (a5FourthD4.isSimplyLaced_componentType 2)) (x 2))

/-- `a5FourthD4BlockRotation` acts on component `4` (`D₄`) by `typeD4Triality`. -/
@[simp]
theorem a5FourthD4BlockRotation_apply_four
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ) :
    a5FourthD4BlockRotation x 4 = typeD4Triality (isSimplyLaced_D 4) (x 4) :=
  a5FourthD4BlockRotation_apply_blockPerm x 4

/-- **`a5FourthD4BlockRotation` has order dividing three.** -/
@[simp]
theorem a5FourthD4BlockRotation_pow_three : a5FourthD4BlockRotation ^ 3 = 1 := by
  apply Isometry.ext
  intro x
  funext i
  rw [pow_three, Isometry.mul_apply, Isometry.mul_apply, Isometry.one_apply]
  rcases eq_fin_a5FourthD4 i with rfl | rfl | rfl | rfl | rfl
  · simp
  · simp
  · simp
  · simp
  · simp only [a5FourthD4BlockRotation_apply_four]
    let y : Fin (D 4).rank → ℚ := x 4
    have h4 := congrFun (congrArg DFunLike.coe (typeD4Triality_pow_three (isSimplyLaced_D 4))) y
    rwa [pow_three, Isometry.mul_apply, Isometry.mul_apply, Isometry.one_apply] at h4

/-- `a5FourthD4BlockRotation` is nontrivial. -/
theorem a5FourthD4BlockRotation_ne_one : a5FourthD4BlockRotation ≠ 1 := by
  intro h
  let x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ :=
    fun i _ ↦ if i = 3 then 1 else 0
  have hx := congrFun (congrFun (congrFun (congrArg DFunLike.coe h) x) 1) ⟨0, by decide⟩
  simp [x] at hx

/-- **`a5FourthD4BlockRotation` has order three.** -/
@[simp]
theorem orderOf_a5FourthD4BlockRotation : orderOf a5FourthD4BlockRotation = 3 :=
  orderOf_eq_prime a5FourthD4BlockRotation_pow_three a5FourthD4BlockRotation_ne_one

/-! ### Action of the `A₅⁴ D₄` glue patterns on `niemeierA5FourthD4` -/

/-- **The indicated symmetries of `[2(024)0]` act faithfully on `niemeierA5FourthD4`**, sending the
block rotation `a5FourthD4BlockPerm` to `a5FourthD4BlockRotation`. -/
noncomputable def a5FourthD4CyclicPatternIsometryHom :
    (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries →*
      Isometry niemeierA5FourthD4 niemeierA5FourthD4 where
  toFun g := a5FourthD4BlockRotation ^ ((![0, 0, 1, 2, 0] : Fin 5 → ℕ) (g.1 ⟨1, by decide⟩))
  map_one' := pow_zero _
  map_mul' g h := by
    rcases mem_symmetries_a5FourthD4_cyclic_iff.mp g.2 with hg | hg | hg <;>
      rcases mem_symmetries_a5FourthD4_cyclic_iff.mp h.2 with hh | hh | hh
    all_goals
      simp only [Subgroup.coe_mul, hg, hh, ← pow_add]
      -- Each of the nine products reduces definitionally modulo `3`.
      rw [pow_eq_pow_mod _ a5FourthD4BlockRotation_pow_three,
        pow_eq_pow_mod (_ + _) a5FourthD4BlockRotation_pow_three]
      rfl

/-- `a5FourthD4CyclicPatternIsometryHom` sends the `k`-th power of `a5FourthD4BlockPerm` to the
`k`-th power of `a5FourthD4BlockRotation`. -/
@[simp]
theorem a5FourthD4CyclicPatternIsometryHom_pow (k : ℕ)
    (hk : a5FourthD4BlockPerm ^ k ∈ (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries) :
    a5FourthD4CyclicPatternIsometryHom ⟨a5FourthD4BlockPerm ^ k, hk⟩ =
      a5FourthD4BlockRotation ^ k := by
  have h1 : a5FourthD4BlockPerm ∈ (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries :=
    mem_symmetries_a5FourthD4_cyclic_iff.mpr (Or.inr (Or.inl rfl))
  have hgen : (⟨a5FourthD4BlockPerm ^ k, hk⟩ :
      (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries) = ⟨a5FourthD4BlockPerm, h1⟩ ^ k :=
    Subtype.ext rfl
  rw [hgen, map_pow]
  congr 1
  exact pow_one a5FourthD4BlockRotation

/-- `a5FourthD4CyclicPatternIsometryHom` sends `a5FourthD4BlockPerm` to
`a5FourthD4BlockRotation`. -/
@[simp]
theorem a5FourthD4CyclicPatternIsometryHom_blockPerm
    (h : a5FourthD4BlockPerm ∈ (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries) :
    a5FourthD4CyclicPatternIsometryHom ⟨a5FourthD4BlockPerm, h⟩ = a5FourthD4BlockRotation := by
  simpa using a5FourthD4CyclicPatternIsometryHom_pow 1 (by simpa using h)

/-- **`a5FourthD4CyclicPatternIsometryHom` is injective.** -/
theorem a5FourthD4CyclicPatternIsometryHom_injective :
    Function.Injective a5FourthD4CyclicPatternIsometryHom := by
  rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
  intro g hg
  rw [MonoidHom.mem_ker] at hg
  let g₀ : (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries :=
    ⟨a5FourthD4BlockPerm, mem_symmetries_a5FourthD4_cyclic_iff.mpr (Or.inr (Or.inl rfl))⟩
  rcases mem_symmetries_a5FourthD4_cyclic_iff.mp g.2 with h | h | h
  · exact Subtype.ext h
  · have hg₀ : g = g₀ := Subtype.ext h
    rw [hg₀, a5FourthD4CyclicPatternIsometryHom_blockPerm] at hg
    exact (a5FourthD4BlockRotation_ne_one hg).elim
  · have hg₀ : g = g₀ ^ 2 := Subtype.ext h
    rw [hg₀, map_pow, a5FourthD4CyclicPatternIsometryHom_blockPerm] at hg
    refine (a5FourthD4BlockRotation_ne_one ?_).elim
    calc a5FourthD4BlockRotation
        = a5FourthD4BlockRotation ^ 2 * a5FourthD4BlockRotation ^ 2 := by
            rw [← pow_add, pow_eq_pow_mod 4 a5FourthD4BlockRotation_pow_three]
            exact (pow_one _).symm
      _ = 1 := by rw [hg, mul_one]

/-- **Every glue pattern of `A₅⁴ D₄` acts on `niemeierA5FourthD4`**: the cyclic pattern `[2(024)0]`
acts through `a5FourthD4CyclicPatternIsometryHom`, and the three literal patterns act trivially on
their trivial symmetry groups. -/
noncomputable def a5FourthD4PatternIsometryHom :
    ∀ {p : GluePattern}, p ∈ a5FourthD4.gluePatterns →
      p.symmetries →* Isometry niemeierA5FourthD4 niemeierA5FourthD4
  | .literal _, _ => 1
  | .cyclic pre block post, hp =>
    have h : pre = [2] ∧ block = [0, 2, 4] ∧ post = [0] := by
      simpa [gluePatterns] using hp
    h.1 ▸ h.2.1 ▸ h.2.2 ▸ a5FourthD4CyclicPatternIsometryHom
  | .evenPermutations _, hp => by simp [gluePatterns] at hp

/-- On any literal pattern of `A₅⁴ D₄`, `a5FourthD4PatternIsometryHom` is the trivial
homomorphism. -/
@[simp]
theorem a5FourthD4PatternIsometryHom_literal {word : List ℕ}
    (hp : GluePattern.literal word ∈ a5FourthD4.gluePatterns) :
    a5FourthD4PatternIsometryHom hp = 1 :=
  (rfl)

/-- On `[2(024)0]`, `a5FourthD4PatternIsometryHom` is `a5FourthD4CyclicPatternIsometryHom`. -/
@[simp]
theorem a5FourthD4PatternIsometryHom_cyclic
    (hp : GluePattern.cyclic [2] [0, 2, 4] [0] ∈ a5FourthD4.gluePatterns) :
    a5FourthD4PatternIsometryHom hp = a5FourthD4CyclicPatternIsometryHom :=
  (rfl)

/-- **`a5FourthD4PatternIsometryHom` is injective** for every glue pattern of `A₅⁴ D₄`. -/
theorem a5FourthD4PatternIsometryHom_injective {p : GluePattern}
    (hp : p ∈ a5FourthD4.gluePatterns) :
    Function.Injective (a5FourthD4PatternIsometryHom hp) := by
  cases p with
  | literal word =>
    have : Subsingleton (GluePattern.literal word).symmetries := by
      rw [GluePattern.symmetries_literal]
      infer_instance
    exact Function.injective_of_subsingleton _
  | cyclic pre block post =>
    obtain ⟨rfl, rfl, rfl⟩ : pre = [2] ∧ block = [0, 2, 4] ∧ post = [0] := by
      simpa [gluePatterns] using hp
    exact a5FourthD4CyclicPatternIsometryHom_injective
  | evenPermutations _ => simp [gluePatterns] at hp

