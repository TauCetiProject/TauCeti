public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.TableRow.Symmetry.Basic
public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeD.Triality

/-!
# The block rotation and triality glue-word symmetry of the table row `A₅⁴ D₄`

The row `A₅⁴ D₄` of the rootful rank-24 table, `TauCeti.RootfulNiemeierType.a5FourthD4`, glues
four `A₅` components and one `D₄` component along the subgroup generated by the patterns
`[2(024)0]`, `[33001]`, `[30302]` and `[30033]`.  The first pattern marks the block of the
second, third and fourth components for rotation.  For every other row of the table the indicated
rotations are glue symmetries and act on the glued lattice
(`TauCeti.RootfulNiemeierType.patternIsometryHom`).  In this row the rotation alone
(`TauCeti.RootfulNiemeierType.a5FourthD4BlockRot`) is not a glue symmetry: it does not preserve
the glue subgroup (`TauCeti.RootfulNiemeierType.a5FourthD4BlockRot_notMem_glueSymmetries`).

The rotation moves the labels of `[33001]`, `[30302]` and `[30033]` among the three `A₅`
positions while their `D₄` labels `1, 2, 3` stay put.  Triality on the `D₄` component cycles those
labels as `[1] ↦ [2] ↦ [3] ↦ [1]`
(`TauCeti.DynkinType.glueLabelEquiv_symm_typeD4GlueAlphabetTriality`), and composing the two
permutes the three words (`[33001] ↦ [30302] ↦ [30033] ↦ [33001]`).  So the rotation combined
with triality on the glue words (`TauCeti.RootfulNiemeierType.a5FourthD4TrialityGlueIsometry`)
preserves the glue subgroup
(`TauCeti.RootfulNiemeierType.a5FourthD4TrialityGlueIsometry_mem_glueSubgroup_iff`).
The lift to `TauCeti.niemeierA5FourthD4` and the cyclic pattern action live in
`TauCeti.LinearAlgebra.IntegralLattice.Rank24.TableRow.A5FourthD4.CyclicSymmetry`.

## Main declarations

* `TauCeti.RootfulNiemeierType.cyclic_mem_gluePatterns_a5FourthD4`: `[2(024)0]` is a glue pattern
  of `A₅⁴ D₄`.
* `TauCeti.RootfulNiemeierType.a5FourthD4BlockRot`: the cyclic rotation `1 ↦ 2 ↦ 3 ↦ 1`
  generating `(GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries`
  (`symmetries_cyclic_a5FourthD4`), of order three (`orderOf_a5FourthD4BlockRot`).
* `TauCeti.RootfulNiemeierType.a5FourthD4BlockRot_notMem_glueSymmetries`: the uncoupled block
  rotation is not a glue symmetry of `a5FourthD4`.
* `TauCeti.RootfulNiemeierType.a5FourthD4TrialityGlueIsometry`: the rotation combined with
  triality on glue words, preserving the glue subgroup
  (`a5FourthD4TrialityGlueIsometry_mem_glueSubgroup_iff`).

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4
  §§3 and 7.1, and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType IntegralLattice

/-! ### The marked-block rotation of `[2(024)0]` and its uncoupled obstruction -/

/-- The pattern `[2(024)0]` of `A₅⁴ D₄`, with its marked block of three `A₅` components. -/
theorem cyclic_mem_gluePatterns_a5FourthD4 :
    GluePattern.cyclic [2] [0, 2, 4] [0] ∈ a5FourthD4.gluePatterns := by
  simp [gluePatterns]

/-- **The marked-block rotation of `A₅⁴ D₄`**: the 3-cycle `1 ↦ 2 ↦ 3 ↦ 1` fixing positions `0` and
`4`, which generates `(GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries`. -/
def a5FourthD4BlockRot : Equiv.Perm (Fin 5) :=
  Equiv.Perm.finSumPerm (Equiv.Perm.finSumPerm (1 : Equiv.Perm (Fin 1)) (finRotate 3))
    (1 : Equiv.Perm (Fin 1))

/-- `a5FourthD4BlockRot` is the block permutation fixing `0` and `4` and rotating the middle block
of length three. -/
theorem a5FourthD4BlockRot_def :
    a5FourthD4BlockRot =
      Equiv.Perm.finSumPerm (Equiv.Perm.finSumPerm (1 : Equiv.Perm (Fin 1)) (finRotate 3))
        (1 : Equiv.Perm (Fin 1)) :=
  (rfl)

/-- The symmetry group of `[2(024)0]` is the cyclic subgroup generated by `a5FourthD4BlockRot`. -/
theorem symmetries_cyclic_a5FourthD4 :
    (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries = Subgroup.zpowers a5FourthD4BlockRot :=
  (GluePattern.symmetries_cyclic [2] [0, 2, 4] [0]).trans
    (congrArg Subgroup.zpowers a5FourthD4BlockRot_def.symm)

/-- `a5FourthD4BlockRot` is the 3-cycle `swap 1 2 * swap 2 3` on `Fin 5`. -/
theorem a5FourthD4BlockRot_eq_swap_mul_swap :
    a5FourthD4BlockRot = Equiv.swap 1 2 * Equiv.swap 2 3 := by
  apply Equiv.ext
  intro i
  -- Write each element of `Fin 5` in `Fin (1 + 3 + 1)` block form so `finSumPerm_apply_*` applies.
  fin_cases i
  · change a5FourthD4BlockRot (Fin.castAdd 1 (Fin.castAdd 3 (0 : Fin 1))) = _
    rw [a5FourthD4BlockRot_def, Equiv.Perm.finSumPerm_apply_castAdd,
      Equiv.Perm.finSumPerm_apply_castAdd]
    decide
  · change a5FourthD4BlockRot (Fin.castAdd 1 (Fin.natAdd 1 (0 : Fin 3))) = _
    rw [a5FourthD4BlockRot_def, Equiv.Perm.finSumPerm_apply_castAdd,
      Equiv.Perm.finSumPerm_apply_natAdd]
    decide
  · change a5FourthD4BlockRot (Fin.castAdd 1 (Fin.natAdd 1 (1 : Fin 3))) = _
    rw [a5FourthD4BlockRot_def, Equiv.Perm.finSumPerm_apply_castAdd,
      Equiv.Perm.finSumPerm_apply_natAdd]
    decide
  · change a5FourthD4BlockRot (Fin.castAdd 1 (Fin.natAdd 1 (2 : Fin 3))) = _
    rw [a5FourthD4BlockRot_def, Equiv.Perm.finSumPerm_apply_castAdd,
      Equiv.Perm.finSumPerm_apply_natAdd]
    decide
  · change a5FourthD4BlockRot (Fin.natAdd 4 (0 : Fin 1)) = _
    rw [a5FourthD4BlockRot_def, Equiv.Perm.finSumPerm_apply_natAdd]
    decide

@[simp]
theorem a5FourthD4BlockRot_zero : a5FourthD4BlockRot 0 = 0 := by
  rw [a5FourthD4BlockRot_eq_swap_mul_swap]; decide

@[simp]
theorem a5FourthD4BlockRot_one : a5FourthD4BlockRot 1 = 2 := by
  rw [a5FourthD4BlockRot_eq_swap_mul_swap]; decide

@[simp]
theorem a5FourthD4BlockRot_two : a5FourthD4BlockRot 2 = 3 := by
  rw [a5FourthD4BlockRot_eq_swap_mul_swap]; decide

@[simp]
theorem a5FourthD4BlockRot_three : a5FourthD4BlockRot 3 = 1 := by
  rw [a5FourthD4BlockRot_eq_swap_mul_swap]; decide

@[simp]
theorem a5FourthD4BlockRot_four : a5FourthD4BlockRot 4 = 4 := by
  rw [a5FourthD4BlockRot_eq_swap_mul_swap]; decide

@[simp]
theorem a5FourthD4BlockRot_inv_zero : a5FourthD4BlockRot⁻¹ 0 = 0 := by
  rw [a5FourthD4BlockRot_eq_swap_mul_swap]; decide

@[simp]
theorem a5FourthD4BlockRot_inv_one : a5FourthD4BlockRot⁻¹ 1 = 3 := by
  rw [a5FourthD4BlockRot_eq_swap_mul_swap]; decide

@[simp]
theorem a5FourthD4BlockRot_inv_two : a5FourthD4BlockRot⁻¹ 2 = 1 := by
  rw [a5FourthD4BlockRot_eq_swap_mul_swap]; decide

@[simp]
theorem a5FourthD4BlockRot_inv_three : a5FourthD4BlockRot⁻¹ 3 = 2 := by
  rw [a5FourthD4BlockRot_eq_swap_mul_swap]; decide

@[simp]
theorem a5FourthD4BlockRot_inv_four : a5FourthD4BlockRot⁻¹ 4 = 4 := by
  rw [a5FourthD4BlockRot_eq_swap_mul_swap]; decide

/-- `a5FourthD4BlockRot` has order three. -/
@[simp]
theorem a5FourthD4BlockRot_pow_three : a5FourthD4BlockRot ^ 3 = 1 := by
  rw [a5FourthD4BlockRot_eq_swap_mul_swap]; decide

/-- The inverse of `a5FourthD4BlockRot` is its square. -/
theorem a5FourthD4BlockRot_inv : a5FourthD4BlockRot⁻¹ = a5FourthD4BlockRot ^ 2 := by
  rw [a5FourthD4BlockRot_eq_swap_mul_swap]; decide

/-- `a5FourthD4BlockRot` has exact order `3`. -/
@[simp]
theorem orderOf_a5FourthD4BlockRot : orderOf a5FourthD4BlockRot = 3 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  refine orderOf_eq_prime a5FourthD4BlockRot_pow_three fun h ↦ ?_
  have h1 := Equiv.congr_fun h 1
  simp at h1

/-- `a5FourthD4BlockRot` belongs to the symmetry group of the cyclic pattern `[2(024)0]`. -/
theorem a5FourthD4BlockRot_mem_symmetries :
    a5FourthD4BlockRot ∈ (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries := by
  rw [symmetries_cyclic_a5FourthD4]
  exact Subgroup.mem_zpowers _

/-- The inverse block rotation maps every component to one of the same type. -/
theorem componentType_a5FourthD4BlockRot_inv (k : Fin a5FourthD4.components.length) :
    a5FourthD4.componentType
        ((a5FourthD4BlockRot⁻¹ : Equiv.Perm (Fin a5FourthD4.components.length)) k) =
      a5FourthD4.componentType k := by
  have h : ∀ j : Fin 5,
      a5FourthD4.componentType (a5FourthD4BlockRot⁻¹ j) = a5FourthD4.componentType j
    | 0 => by rw [a5FourthD4BlockRot_inv_zero]
    | 1 => by rw [a5FourthD4BlockRot_inv_one]; rfl
    | 2 => by rw [a5FourthD4BlockRot_inv_two]; rfl
    | 3 => by rw [a5FourthD4BlockRot_inv_three]; rfl
    | 4 => by rw [a5FourthD4BlockRot_inv_four]
  exact h k

/-- **The uncoupled block rotation of `[2(024)0]` is not a glue symmetry of `A₅⁴ D₄`**: reindexing
`[33001]` along `a5FourthD4BlockRot` gives `[30031]`, whose sum with `[30033]` is the nonzero glue
word `[00002]` of shortest norm `1 < 4`. -/
theorem a5FourthD4BlockRot_notMem_glueSymmetries :
    (a5FourthD4BlockRot : Equiv.Perm (Fin a5FourthD4.components.length)) ∉
      a5FourthD4.glueSymmetries := by
  intro hrot
  let d₁ : ∀ i : Fin 5, Fin (a5FourthD4.componentType i).glueLabelCount :=
    fun i ↦ ⟨![3, 3, 0, 0, 1] i, by fin_cases i <;> decide⟩
  let d₃ : ∀ i : Fin 5, Fin (a5FourthD4.componentType i).glueLabelCount :=
    fun i ↦ ⟨![3, 0, 0, 3, 3] i, by fin_cases i <;> decide⟩
  let w₁ : a5FourthD4.glueModule := fun i ↦
    (a5FourthD4.componentType i).glueLabelEquiv (a5FourthD4.isSimplyLaced_componentType i) (d₁ i)
  let w₃ : a5FourthD4.glueModule := fun i ↦
    (a5FourthD4.componentType i).glueLabelEquiv (a5FourthD4.isSimplyLaced_componentType i) (d₃ i)
  let v := piGlueAlphabetCongr a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
    a5FourthD4BlockRot (a5FourthD4.componentType_apply_of_mem_glueSymmetries hrot)
    (hs := a5FourthD4.isSimplyLaced_componentType) w₁
  have hv : v ∈ a5FourthD4.glueSubgroup :=
    (a5FourthD4.piGlueAlphabetCongr_mem_glueSubgroup_iff hrot w₁).mpr
      (a5FourthD4.glueLabelEquiv_mem_glueSubgroup d₁ (by decide))
  have hw₃ : w₃ ∈ a5FourthD4.glueSubgroup :=
    a5FourthD4.glueLabelEquiv_mem_glueSubgroup d₃ (by decide)
  have hv_enc : encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType v =
      [3, 0, 0, 3, 1] := by
    refine (encodeGlueWord_piGlueAlphabetCongr_eq_ofFn _ _ _ _ _ w₁).trans ?_
    refine (congrArg List.ofFn (funext fun k : Fin 5 ↦
      congrArg Fin.val (Equiv.symm_apply_apply _ (d₁ (a5FourthD4BlockRot k))))).trans ?_
    dsimp only [d₁]
    rw [a5FourthD4BlockRot_eq_swap_mul_swap]
    decide
  have hw₃_enc :
      encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w₃ =
        [3, 0, 0, 3, 3] := by
    rw [encodeGlueWord_glueLabelEquiv]
    decide
  have henc : encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
      (v + w₃) = [0, 0, 0, 0, 2] := by
    refine (encodeGlueWord_add _ _ v w₃).trans ?_
    rw [hv_enc, hw₃_enc]
    decide +kernel
  have hne : v + w₃ ≠ 0 := fun h0 ↦ absurd
    (henc.symm.trans ((congrArg (encodeGlueWord a5FourthD4.componentType
      a5FourthD4.isSimplyLaced_componentType) h0).trans (encodeGlueWord_zero _ _))) (by decide)
  have hmin := four_le_sum_glueMinimum_of_mem_glueSubgroup a5FourthD4 (add_mem hv hw₃) hne
  rw [← glueWordMinimum_encodeGlueWord, henc] at hmin
  exact absurd hmin (by decide +kernel)

/-! ### Triality on the `D₄` component -/

/-- The position of the `D₄` component of `A₅⁴ D₄`, the last one. -/
-- Exposed so that the component type at this position reduces to `D 4`.
@[expose] def a5FourthD4D4Index : Fin a5FourthD4.components.length :=
  ⟨4, by decide⟩

/-- The component in position `a5FourthD4D4Index` has type `D₄`. -/
@[simp]
theorem componentType_a5FourthD4D4Index : a5FourthD4.componentType a5FourthD4D4Index = D 4 :=
  (rfl)

/-- The self-isometries of the component root lattices applying triality to the `D₄` component
and the identity to the `A₅` components. -/
noncomputable def componentTriality : ∀ i : Fin a5FourthD4.components.length,
    IntegralLattice.Isometry
      ((a5FourthD4.componentType i).rootLattice (a5FourthD4.isSimplyLaced_componentType i))
      ((a5FourthD4.componentType i).rootLattice (a5FourthD4.isSimplyLaced_componentType i)) :=
  fun i ↦ if h : i = a5FourthD4D4Index then h ▸ typeD4Triality (isSimplyLaced_D 4) else 1

/-- On the `D₄` component, `componentTriality` is `typeD4Triality`. -/
theorem componentTriality_d4Index :
    componentTriality a5FourthD4D4Index = typeD4Triality (isSimplyLaced_D 4) :=
  dite_eq_left rfl

/-- On each `A₅` component, `componentTriality` is the identity. -/
theorem componentTriality_of_ne {i : Fin a5FourthD4.components.length}
    (hi : i ≠ a5FourthD4D4Index) : componentTriality i = 1 :=
  dite_eq_right hi

/-- The action of `componentTriality` on the glue alphabet of each component. -/
noncomputable def componentTrialityLabel (i : Fin a5FourthD4.components.length) :
    FiniteQuadraticModule.Isometry
      ((a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i))
      ((a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i)) :=
  if h : i = a5FourthD4D4Index then h ▸ typeD4GlueAlphabetTriality (isSimplyLaced_D 4)
  else QuadraticMap.IsometryEquiv.refl _

private theorem componentTrialityLabel_d4Index :
    componentTrialityLabel a5FourthD4D4Index = typeD4GlueAlphabetTriality (isSimplyLaced_D 4) :=
  dite_eq_left rfl

/-- `componentTrialityLabel` intertwines `glueAlphabetIsometry` with the discriminant-quadratic
action of `componentTriality`. -/
theorem glueAlphabetIsometry_componentTrialityLabel
    (i : Fin a5FourthD4.components.length)
    (x : (a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i)) :
    (a5FourthD4.componentType i).glueAlphabetIsometry (a5FourthD4.valid_componentType i)
        (a5FourthD4.isSimplyLaced_componentType i) (componentTrialityLabel i x) =
      (componentTriality i).discriminantQuadraticIsometry
        ((a5FourthD4.componentType i).isEven_rootLattice _)
        ((a5FourthD4.componentType i).glueAlphabetIsometry (a5FourthD4.valid_componentType i)
          (a5FourthD4.isSimplyLaced_componentType i) x) := by
  by_cases hi : i = a5FourthD4D4Index
  · subst hi
    have h1 : componentTrialityLabel a5FourthD4D4Index x =
        glueAlphabetIsometryOfIsometry (valid_D.mpr le_rfl) (valid_D.mpr le_rfl)
          (typeD4Triality (isSimplyLaced_D 4)) x :=
      DFunLike.congr_fun
        (componentTrialityLabel_d4Index.trans
          (typeD4GlueAlphabetTriality_def (isSimplyLaced_D 4))) x
    have h2 : componentTriality a5FourthD4D4Index = typeD4Triality (isSimplyLaced_D 4) :=
      componentTriality_d4Index
    refine (congrArg _ h1).trans ?_
    refine (glueAlphabetIsometry_glueAlphabetIsometryOfIsometry
      (valid_D.mpr le_rfl) (valid_D.mpr le_rfl) (typeD4Triality (isSimplyLaced_D 4)) x).trans ?_
    exact congrArg (fun f : IntegralLattice.Isometry _ _ ↦
      f.discriminantQuadraticIsometry ((D 4).isEven_rootLattice (isSimplyLaced_D 4)) _) h2.symm
  · refine Eq.trans ?_ (Isometry.discriminantQuadraticIsometry_apply _ _ _).symm
    rw [componentTrialityLabel, dite_eq_right hi, QuadraticMap.IsometryEquiv.refl_apply,
      componentTriality_of_ne hi, Isometry.one_def, Isometry.discriminantGroupEquiv_refl]
    exact (LinearEquiv.refl_apply (M := ((a5FourthD4.componentType i).rootLattice
      (a5FourthD4.isSimplyLaced_componentType i)).DiscriminantGroup) _).symm

private theorem componentTrialityLabel_of_ne {i : Fin a5FourthD4.components.length}
    (hi : i ≠ a5FourthD4D4Index)
    (x : (a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i)) :
    componentTrialityLabel i x = x := by
  rw [componentTrialityLabel, dite_eq_right hi, QuadraticMap.IsometryEquiv.refl_apply]

private theorem val_glueLabelEquiv_symm_componentTrialityLabel_d4Index
    (x : (a5FourthD4.componentType a5FourthD4D4Index).glueAlphabet
      (a5FourthD4.isSimplyLaced_componentType a5FourthD4D4Index)) :
    (((a5FourthD4.componentType a5FourthD4D4Index).glueLabelEquiv _).symm
        (componentTrialityLabel a5FourthD4D4Index x)).val =
      [0, 2, 3, 1].getD
        (((a5FourthD4.componentType a5FourthD4D4Index).glueLabelEquiv _).symm x).val 0 := by
  let d : Fin 4 :=
    ((a5FourthD4.componentType a5FourthD4D4Index).glueLabelEquiv _).symm x
  have h1 : (((a5FourthD4.componentType a5FourthD4D4Index).glueLabelEquiv _).symm
        (componentTrialityLabel a5FourthD4D4Index x)).val =
      (typeD4TrialityLabelPerm d).val := by
    have h2 : ((D 4).glueLabelEquiv (isSimplyLaced_D 4)).symm
          (componentTrialityLabel a5FourthD4D4Index x) =
        typeD4TrialityLabelPerm (((D 4).glueLabelEquiv (isSimplyLaced_D 4)).symm x) := by
      rw [← glueLabelEquiv_symm_typeD4GlueAlphabetTriality (isSimplyLaced_D 4) x]
      exact congrArg (fun f : FiniteQuadraticModule.Isometry ((D 4).glueAlphabet _) _ ↦
        ((D 4).glueLabelEquiv (isSimplyLaced_D 4)).symm (f x)) componentTrialityLabel_d4Index
    exact congrArg Fin.val h2
  have hget : ∀ i : Fin 4, (typeD4TrialityLabelPerm i).val = [0, 2, 3, 1].getD i.val 0 :=
    fun i ↦ by fin_cases i <;> simp
  exact h1.trans (hget _)

/-! ### The rotation combined with triality on glue words -/

/-- A function on the component positions of `A₅⁴ D₄` lists its five values. -/
private theorem ofFn_a5FourthD4 {α : Type*} (f : Fin a5FourthD4.components.length → α) :
    List.ofFn f =
      [f ⟨0, by decide⟩, f ⟨1, by decide⟩, f ⟨2, by decide⟩, f ⟨3, by decide⟩,
        f ⟨4, by decide⟩] := by
  refine (List.map_ofFn (f := id) (g := f)).symm.trans ?_
  rw [show List.ofFn (id : Fin a5FourthD4.components.length → _) = [⟨0, by decide⟩,
      ⟨1, by decide⟩, ⟨2, by decide⟩, ⟨3, by decide⟩, ⟨4, by decide⟩] by decide]
  simp only [List.map_cons, List.map_nil]

private theorem ofFn_comp_a5FourthD4BlockRot_inv {α : Type*}
    (f : Fin a5FourthD4.components.length → α) :
    List.ofFn (fun k ↦
        f ((a5FourthD4BlockRot⁻¹ : Equiv.Perm (Fin a5FourthD4.components.length)) k)) =
      [f ⟨0, by decide⟩, f ⟨3, by decide⟩, f ⟨1, by decide⟩, f ⟨2, by decide⟩,
        f ⟨4, by decide⟩] := by
  refine (ofFn_a5FourthD4 fun k ↦
    f ((a5FourthD4BlockRot⁻¹ : Equiv.Perm (Fin a5FourthD4.components.length)) k)).trans ?_
  rw [show (a5FourthD4BlockRot⁻¹ : Equiv.Perm (Fin a5FourthD4.components.length)) ⟨0, by decide⟩ =
      ⟨0, by decide⟩ from a5FourthD4BlockRot_inv_zero,
    show (a5FourthD4BlockRot⁻¹ : Equiv.Perm (Fin a5FourthD4.components.length)) ⟨1, by decide⟩ =
      ⟨3, by decide⟩ from a5FourthD4BlockRot_inv_one,
    show (a5FourthD4BlockRot⁻¹ : Equiv.Perm (Fin a5FourthD4.components.length)) ⟨2, by decide⟩ =
      ⟨1, by decide⟩ from a5FourthD4BlockRot_inv_two,
    show (a5FourthD4BlockRot⁻¹ : Equiv.Perm (Fin a5FourthD4.components.length)) ⟨3, by decide⟩ =
      ⟨2, by decide⟩ from a5FourthD4BlockRot_inv_three,
    show (a5FourthD4BlockRot⁻¹ : Equiv.Perm (Fin a5FourthD4.components.length)) ⟨4, by decide⟩ =
      ⟨4, by decide⟩ from a5FourthD4BlockRot_inv_four]

/-- **The rotation combined with triality on the glue words of `A₅⁴ D₄`**: it applies triality to
the `D₄` label and then reads the label in position `k` from position `ρ⁻¹ k`, where `ρ` is
`a5FourthD4BlockRot`. -/
noncomputable def a5FourthD4TrialityGlueIsometry :
    FiniteQuadraticModule.Isometry a5FourthD4.glueModule a5FourthD4.glueModule :=
  (QuadraticMap.IsometryEquiv.pi componentTrialityLabel).trans
    (piGlueAlphabetCongr a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
      (a5FourthD4BlockRot⁻¹ : Equiv.Perm (Fin a5FourthD4.components.length))
      componentType_a5FourthD4BlockRot_inv)

/-- Applying `componentTrialityLabel` after permuting components by `a5FourthD4BlockRot⁻¹` agrees
with `a5FourthD4TrialityGlueIsometry`. -/
theorem componentTrialityLabel_piGlueAlphabetCongr (w : a5FourthD4.glueModule) :
    (fun k ↦ componentTrialityLabel k
        (piGlueAlphabetCongr a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
          (a5FourthD4BlockRot⁻¹ : Equiv.Perm (Fin a5FourthD4.components.length))
          componentType_a5FourthD4BlockRot_inv w k)) =
      a5FourthD4TrialityGlueIsometry w := by
  funext k
  rw [a5FourthD4TrialityGlueIsometry, QuadraticMap.IsometryEquiv.trans_apply,
    piGlueAlphabetCongr_apply, piGlueAlphabetCongr_apply,
    QuadraticMap.IsometryEquiv.pi_apply]
  by_cases hk : k = a5FourthD4D4Index
