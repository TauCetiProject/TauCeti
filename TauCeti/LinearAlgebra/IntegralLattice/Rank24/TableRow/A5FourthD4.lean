/-!
# The rotation symmetry of the table row `A₅⁴ D₄`

The row `A₅⁴ D₄` of the rootful rank-24 table, `TauCeti.RootfulNiemeierType.a5FourthD4`, glues
four `A₅` components and one `D₄` component along the subgroup generated by the patterns
`[2(024)0]`, `[33001]`, `[30302]` and `[30033]`.  The first pattern marks the block of the
second, third and fourth components for rotation.  For every other row of the table the indicated
rotations are glue symmetries and act on the glued lattice
(`TauCeti.RootfulNiemeierType.patternIsometryHom`).  In this row the rotation alone is not a
symmetry: it does not preserve the glue subgroup, and in fact the row has no nontrivial glue
symmetry permuting components alone (`TauCeti.RootfulNiemeierType.glueSymmetries_a5FourthD4_eq_bot`
and `TauCeti.RootfulNiemeierType.a5FourthD4BlockRotation_notMem_glueSymmetries`, in
`TauCeti.LinearAlgebra.IntegralLattice.Rank24.TableRow.Symmetry`).

The rotation moves the labels of `[33001]`, `[30302]` and `[30033]` among the three `A₅`
positions while their `D₄` labels `1, 2, 3` stay put.  Triality on the `D₄` component cycles those
labels as `[1] ↦ [2] ↦ [3] ↦ [1]`
(`TauCeti.DynkinType.discriminantGroupEquiv_typeD4Triality_glueLabelEquiv`), and composing the two
permutes the three words.  So the rotation combined with triality is a symmetry of the row.  It
induces the self-isometry `TauCeti.RootfulNiemeierType.a5FourthD4TrialityIsometry` of the glued
lattice `N_{A₅⁴ D₄}`.  This isometry moves the component in position `k` to position `ρ k`, where
`ρ` is the block rotation, and applies triality to the `D₄` component.  It has order three, as
the rotation does (`orderOf_a5FourthD4TrialityIsometry`), and the indicated symmetries of the
pattern `[2(024)0]` act faithfully on `N_{A₅⁴ D₄}` through it
(`TauCeti.RootfulNiemeierType.a5FourthD4CyclicSymmetryHom`).  Together with the trivial action of
the literal patterns this gives the action of every pattern of the row
(`TauCeti.RootfulNiemeierType.a5FourthD4PatternIsometryHom`), which completes
`TauCeti.RootfulNiemeierType.patternIsometryHom` on the row `A₅⁴ D₄`.

Concretely, the block rotation `ρ` maps the positions `1 ↦ 2 ↦ 3 ↦ 1` and fixes `0` and `4`, and
the induced map on glue words reads a digit word `[a b c d e]` as `[a d b c τ(e)]`, where
`τ` cycles the `D₄` labels `1 ↦ 2 ↦ 3 ↦ 1` (`TauCeti.RootfulNiemeierType.a5FourthD4TrialityDigits`).

## Main declarations

* `TauCeti.RootfulNiemeierType.a5FourthD4BlockRotation`: the rotation of the block marked in
  `[2(024)0]`, generating the indicated symmetries of that pattern
  (`map_symmetries_cyclic_a5FourthD4`), unfolded by `a5FourthD4BlockRotation_def`.  Its values
  are given by `ofFn_comp_a5FourthD4BlockRotation` and `ofFn_comp_a5FourthD4BlockRotation_symm`, it
  fixes the `D₄` position (`a5FourthD4BlockRotation_d4Index`), and it has order three
  (`a5FourthD4BlockRotation_pow_three`).
* `TauCeti.RootfulNiemeierType.a5FourthD4TrialityGlueIsometry`: the rotation combined with
  triality on glue words, which preserves the glue subgroup
  (`a5FourthD4TrialityGlueIsometry_mem_glueSubgroup_iff`).
* `TauCeti.RootfulNiemeierType.a5FourthD4TrialityIsometry`: the induced self-isometry of the glued
  lattice, with coordinate formulas `a5FourthD4TrialityIsometry_apply_d4Index` and
  `a5FourthD4TrialityIsometry_apply_of_ne`, of order three
  (`a5FourthD4TrialityIsometry_pow_three`, `orderOf_a5FourthD4TrialityIsometry`).
* `TauCeti.RootfulNiemeierType.a5FourthD4CyclicSymmetryGen`,
  `TauCeti.RootfulNiemeierType.a5FourthD4CyclicSymmetryHom`,
  `TauCeti.RootfulNiemeierType.a5FourthD4PatternIsometryHom`: the order-three generator of the
  symmetries of `[2(024)0]` (`zpowers_a5FourthD4CyclicSymmetryGen`,
  `orderOf_a5FourthD4CyclicSymmetryGen`), its faithful action on `N_{A₅⁴ D₄}` by
  `a5FourthD4TrialityIsometry`, and the action of `p.symmetries` for every pattern `p` of the row
  (`a5FourthD4PatternIsometryHom_injective`).

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4
  §§3 and 7.1, and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType IntegralLattice

/-! ### The block rotation -/

/-- The pattern `[2(024)0]` of `A₅⁴ D₄`, with its marked block of three `A₅` components. -/
theorem cyclic_mem_gluePatterns_a5FourthD4 :
    GluePattern.cyclic [2] [0, 2, 4] [0] ∈ a5FourthD4.gluePatterns := by
  simp [gluePatterns]

/-- **The rotation of the block marked in `[2(024)0]`**, read on the component positions of
`A₅⁴ D₄`: the cycle mapping the positions `1 ↦ 2 ↦ 3 ↦ 1` and fixing the positions `0` and `4`.
It is the generator of the indicated symmetries of the pattern
(`map_symmetries_cyclic_a5FourthD4`). -/
def a5FourthD4BlockRotation : Equiv.Perm (Fin a5FourthD4.components.length) :=
  c[⟨1, by decide⟩, ⟨2, by decide⟩, ⟨3, by decide⟩]

/-- The block rotation is the cycle `c[1, 2, 3]` on the component positions. -/
theorem a5FourthD4BlockRotation_def :
    a5FourthD4BlockRotation = c[⟨1, by decide⟩, ⟨2, by decide⟩, ⟨3, by decide⟩] :=
  (rfl)

/-- A function on the component positions of `A₅⁴ D₄` lists its five values. -/
private theorem ofFn_a5FourthD4 {α : Type*} (f : Fin a5FourthD4.components.length → α) :
    List.ofFn f =
      [f ⟨0, by decide⟩, f ⟨1, by decide⟩, f ⟨2, by decide⟩, f ⟨3, by decide⟩,
        f ⟨4, by decide⟩] := by
  refine (List.map_ofFn (f := id) (g := f)).symm.trans ?_
  rw [show List.ofFn (id : Fin a5FourthD4.components.length → _) = [⟨0, by decide⟩,
      ⟨1, by decide⟩, ⟨2, by decide⟩, ⟨3, by decide⟩, ⟨4, by decide⟩] by decide]
  simp only [List.map_cons, List.map_nil]

/-- **The values of the block rotation**: reading a function `f` on the component positions along
the block rotation lists its values in the positions `0, 2, 3, 1, 4`. -/
theorem ofFn_comp_a5FourthD4BlockRotation {α : Type*}
    (f : Fin a5FourthD4.components.length → α) :
    List.ofFn (fun k ↦ f (a5FourthD4BlockRotation k)) =
      [f ⟨0, by decide⟩, f ⟨2, by decide⟩, f ⟨3, by decide⟩, f ⟨1, by decide⟩,
        f ⟨4, by decide⟩] := by
  rw [ofFn_a5FourthD4 (fun k ↦ f (a5FourthD4BlockRotation k)),
    show a5FourthD4BlockRotation ⟨0, by decide⟩ = ⟨0, by decide⟩ by decide,
    show a5FourthD4BlockRotation ⟨1, by decide⟩ = ⟨2, by decide⟩ by decide,
    show a5FourthD4BlockRotation ⟨2, by decide⟩ = ⟨3, by decide⟩ by decide,
    show a5FourthD4BlockRotation ⟨3, by decide⟩ = ⟨1, by decide⟩ by decide,
    show a5FourthD4BlockRotation ⟨4, by decide⟩ = ⟨4, by decide⟩ by decide]

/-- **The values of the inverse block rotation**: reading a function `f` on the component positions
along the inverse block rotation lists its values in the positions `0, 3, 1, 2, 4`. -/
theorem ofFn_comp_a5FourthD4BlockRotation_symm {α : Type*}
    (f : Fin a5FourthD4.components.length → α) :
    List.ofFn (fun k ↦ f (a5FourthD4BlockRotation.symm k)) =
      [f ⟨0, by decide⟩, f ⟨3, by decide⟩, f ⟨1, by decide⟩, f ⟨2, by decide⟩,
        f ⟨4, by decide⟩] := by
  rw [ofFn_a5FourthD4 (fun k ↦ f (a5FourthD4BlockRotation.symm k)),
    show a5FourthD4BlockRotation.symm ⟨0, by decide⟩ = ⟨0, by decide⟩ by decide,
    show a5FourthD4BlockRotation.symm ⟨1, by decide⟩ = ⟨3, by decide⟩ by decide,
    show a5FourthD4BlockRotation.symm ⟨2, by decide⟩ = ⟨1, by decide⟩ by decide,
    show a5FourthD4BlockRotation.symm ⟨3, by decide⟩ = ⟨2, by decide⟩ by decide,
    show a5FourthD4BlockRotation.symm ⟨4, by decide⟩ = ⟨4, by decide⟩ by decide]

/-- **The block rotation has order three.** -/
@[simp]
theorem a5FourthD4BlockRotation_pow_three : a5FourthD4BlockRotation ^ 3 = 1 := by
  decide

/-- **The block rotation has order exactly three.** -/
@[simp]
theorem orderOf_a5FourthD4BlockRotation : orderOf a5FourthD4BlockRotation = 3 :=
  orderOf_eq_prime a5FourthD4BlockRotation_pow_three (by decide)

private theorem finSumPerm_finRotate_apply_castAdd_castAdd :
    Equiv.Perm.finSumPerm (Equiv.Perm.finSumPerm 1 (finRotate 3)) 1
        (Fin.castAdd 1 (Fin.castAdd 3 (0 : Fin 1))) =
      Fin.castAdd 1 (Fin.castAdd 3 (0 : Fin 1)) := by
  rw [Equiv.Perm.finSumPerm_apply_castAdd, Equiv.Perm.finSumPerm_apply_castAdd,
    Equiv.Perm.one_apply]

private theorem finSumPerm_finRotate_apply_castAdd_natAdd (i : Fin 3) :
    Equiv.Perm.finSumPerm (Equiv.Perm.finSumPerm 1 (finRotate 3)) 1
        (Fin.castAdd 1 (Fin.natAdd 1 i)) =
      Fin.castAdd 1 (Fin.natAdd 1 (finRotate 3 i)) := by
  rw [Equiv.Perm.finSumPerm_apply_castAdd, Equiv.Perm.finSumPerm_apply_natAdd]

private theorem finSumPerm_finRotate_apply_natAdd :
    Equiv.Perm.finSumPerm (Equiv.Perm.finSumPerm 1 (finRotate 3)) 1 (Fin.natAdd 4 (0 : Fin 1)) =
      Fin.natAdd 4 (0 : Fin 1) := by
  rw [Equiv.Perm.finSumPerm_apply_natAdd, Equiv.Perm.one_apply]

/-- The rotation of the marked block in the coordinates of the pattern, transported to the
component positions, is the block rotation. -/
private theorem permCongr_finSumPerm_finRotate :
    (finCongr (by decide : 1 + 3 + 1 = a5FourthD4.components.length)).permCongr
        (Equiv.Perm.finSumPerm (Equiv.Perm.finSumPerm 1 (finRotate 3)) 1) =
      a5FourthD4BlockRotation := by
  ext k
  rw [Equiv.permCongr_apply, finCongr_apply, Fin.val_cast, finCongr_symm, finCongr_apply]
  fin_cases k
  · exact (congrArg Fin.val finSumPerm_finRotate_apply_castAdd_castAdd).trans (by decide)
  · exact (congrArg Fin.val (finSumPerm_finRotate_apply_castAdd_natAdd 0)).trans (by decide)
  · exact (congrArg Fin.val (finSumPerm_finRotate_apply_castAdd_natAdd 1)).trans (by decide)
  · exact (congrArg Fin.val (finSumPerm_finRotate_apply_castAdd_natAdd 2)).trans (by decide)
  · exact (congrArg Fin.val finSumPerm_finRotate_apply_natAdd).trans (by decide)

/-- **The indicated symmetries of the pattern `[2(024)0]`**, read on the component positions, are
the powers of the block rotation. -/
theorem map_symmetries_cyclic_a5FourthD4 :
    (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries.map
        (finCongr (length_eq_of_mem_gluePatterns
          cyclic_mem_gluePatterns_a5FourthD4)).permCongrHom.toMonoidHom =
      Subgroup.zpowers a5FourthD4BlockRotation := by
  rw [GluePattern.symmetries_cyclic]
  exact (MonoidHom.map_zpowers _ _).trans
    (congrArg Subgroup.zpowers permCongr_finSumPerm_finRotate)

/-- The block rotation maps every component to one of the same type. -/
theorem componentType_a5FourthD4BlockRotation_symm (k : Fin a5FourthD4.components.length) :
    a5FourthD4.componentType (a5FourthD4BlockRotation.symm k) = a5FourthD4.componentType k := by
  fin_cases k <;> rfl

/-! ### Triality on the `D₄` component -/

/-- The position of the `D₄` component of `A₅⁴ D₄`, the last one. -/
-- Exposed so that the component type at this position reduces to `D 4`, which the statement of
-- `a5FourthD4TrialityIsometry_apply_d4Index` needs in order to apply triality.
@[expose] def a5FourthD4D4Index : Fin a5FourthD4.components.length :=
  ⟨4, by decide⟩

/-- The component in position `a5FourthD4D4Index` has type `D₄`. -/
@[simp]
theorem componentType_a5FourthD4D4Index : a5FourthD4.componentType a5FourthD4D4Index = D 4 :=
  (rfl)

/-- The self-isometries of the component root lattices applying triality to the `D₄` component
and the identity to the `A₅` components. -/
private noncomputable def componentTriality : ∀ i : Fin a5FourthD4.components.length,
    IntegralLattice.Isometry
      ((a5FourthD4.componentType i).rootLattice (a5FourthD4.isSimplyLaced_componentType i))
      ((a5FourthD4.componentType i).rootLattice (a5FourthD4.isSimplyLaced_componentType i)) :=
  fun i ↦ if h : i = a5FourthD4D4Index then h ▸ typeD4Triality (isSimplyLaced_D 4) else 1

private theorem componentTriality_d4Index :
    componentTriality a5FourthD4D4Index = typeD4Triality (isSimplyLaced_D 4) :=
  dite_eq_left rfl

private theorem componentTriality_of_ne {i : Fin a5FourthD4.components.length}
    (hi : i ≠ a5FourthD4D4Index) : componentTriality i = 1 :=
  dite_eq_right hi

/-- The action of `componentTriality` on the glue alphabet of each component. -/
private noncomputable def componentTrialityLabel (i : Fin a5FourthD4.components.length) :
    FiniteQuadraticModule.Isometry
      ((a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i))
      ((a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i)) :=
  (((a5FourthD4.componentType i).glueAlphabetIsometry (a5FourthD4.valid_componentType i)
      (a5FourthD4.isSimplyLaced_componentType i)).trans
    ((componentTriality i).discriminantQuadraticIsometry
      ((a5FourthD4.componentType i).isEven_rootLattice _))).trans
    ((a5FourthD4.componentType i).glueAlphabetIsometry (a5FourthD4.valid_componentType i)
      (a5FourthD4.isSimplyLaced_componentType i)).symm

private theorem glueAlphabetIsometry_componentTrialityLabel
    (i : Fin a5FourthD4.components.length)
    (x : (a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i)) :
    (a5FourthD4.componentType i).glueAlphabetIsometry (a5FourthD4.valid_componentType i)
        (a5FourthD4.isSimplyLaced_componentType i) (componentTrialityLabel i x) =
      (componentTriality i).discriminantQuadraticIsometry
        ((a5FourthD4.componentType i).isEven_rootLattice _)
        ((a5FourthD4.componentType i).glueAlphabetIsometry (a5FourthD4.valid_componentType i)
          (a5FourthD4.isSimplyLaced_componentType i) x) := by
  rw [componentTrialityLabel, QuadraticMap.IsometryEquiv.trans_apply,
    QuadraticMap.IsometryEquiv.apply_symm_apply, QuadraticMap.IsometryEquiv.trans_apply]

private theorem componentTrialityLabel_of_ne {i : Fin a5FourthD4.components.length}
    (hi : i ≠ a5FourthD4D4Index)
    (x : (a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i)) :
    componentTrialityLabel i x = x := by
  unfold componentTrialityLabel
  rw [QuadraticMap.IsometryEquiv.trans_apply, QuadraticMap.IsometryEquiv.trans_apply,
    QuadraticMap.IsometryEquiv.symm_apply_eq]
  refine (Isometry.discriminantQuadraticIsometry_apply _ _ _).trans ?_
  rw [componentTriality_of_ne hi, Isometry.one_def, Isometry.discriminantGroupEquiv_refl]
  exact LinearEquiv.refl_apply (M := ((a5FourthD4.componentType i).rootLattice
    (a5FourthD4.isSimplyLaced_componentType i)).DiscriminantGroup) _

private theorem val_glueLabelEquiv_symm_componentTrialityLabel_d4Index
    (x : (a5FourthD4.componentType a5FourthD4D4Index).glueAlphabet
      (a5FourthD4.isSimplyLaced_componentType a5FourthD4D4Index)) :
    (((a5FourthD4.componentType a5FourthD4D4Index).glueLabelEquiv _).symm
        (componentTrialityLabel a5FourthD4D4Index x)).val =
      [0, 2, 3, 1].getD
        (((a5FourthD4.componentType a5FourthD4D4Index).glueLabelEquiv _).symm x).val 0 := by
  obtain ⟨d, rfl⟩ := ((a5FourthD4.componentType a5FourthD4D4Index).glueLabelEquiv
    (a5FourthD4.isSimplyLaced_componentType a5FourthD4D4Index)).surjective x
  have key : componentTrialityLabel a5FourthD4D4Index
      ((D 4).glueLabelEquiv (isSimplyLaced_D 4) d) =
        (D 4).glueLabelEquiv (isSimplyLaced_D 4) (![0, 2, 3, 1] d) := by
    apply ((D 4).glueAlphabetIsometry (by decide) (isSimplyLaced_D 4)).injective
    refine (glueAlphabetIsometry_componentTrialityLabel a5FourthD4D4Index _).trans ?_
    refine (Isometry.discriminantQuadraticIsometry_apply _ _ _).trans ?_
    refine (congrArg (fun e : IntegralLattice.Isometry _ _ ↦ e.discriminantGroupEquiv _)
      componentTriality_d4Index).trans ?_
    exact discriminantGroupEquiv_typeD4Triality_glueLabelEquiv (isSimplyLaced_D 4) (by decide) d
  rw [Equiv.symm_apply_apply]
  refine (congrArg (fun y ↦ (((D 4).glueLabelEquiv (isSimplyLaced_D 4)).symm y).val) key).trans ?_
  rw [Equiv.symm_apply_apply]
  fin_cases d <;> rfl

/-! ### The rotation combined with triality on glue words -/

/-- **The rotation combined with triality on the glue words of `A₅⁴ D₄`**: it applies triality to
the `D₄` label and then reads the label in position `k` from position `ρ⁻¹ k`, where `ρ` is the
block rotation. -/
noncomputable def a5FourthD4TrialityGlueIsometry :
    FiniteQuadraticModule.Isometry a5FourthD4.glueModule a5FourthD4.glueModule :=
  (QuadraticMap.IsometryEquiv.pi componentTrialityLabel).trans
    (piGlueAlphabetCongr a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
      a5FourthD4BlockRotation.symm componentType_a5FourthD4BlockRotation_symm)

/-- The digit words of the rotation combined with triality: `[a b c d e]` becomes
`[a d b c τ(e)]`, where `τ` cycles the `D₄` labels `1 ↦ 2 ↦ 3 ↦ 1`. -/
def a5FourthD4TrialityDigits (l : List ℕ) : List ℕ :=
  [l.getD 0 0, l.getD 3 0, l.getD 1 0, l.getD 2 0, [0, 2, 3, 1].getD (l.getD 4 0) 0]

/-- The digits of the rotation combined with triality, as an explicit list of five digits. -/
theorem a5FourthD4TrialityDigits_def (l : List ℕ) :
    a5FourthD4TrialityDigits l =
      [l.getD 0 0, l.getD 3 0, l.getD 1 0, l.getD 2 0, [0, 2, 3, 1].getD (l.getD 4 0) 0] :=
  (rfl)

/-- The digit word of the image of a glue word under the rotation combined with triality. -/
theorem encodeGlueWord_a5FourthD4TrialityGlueIsometry (w : a5FourthD4.glueModule) :
    encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
        (a5FourthD4TrialityGlueIsometry w) =
      a5FourthD4TrialityDigits
        (encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w) := by
  rw [a5FourthD4TrialityGlueIsometry, QuadraticMap.IsometryEquiv.trans_apply,
    encodeGlueWord_piGlueAlphabetCongr_eq_ofFn]
  set G : Fin a5FourthD4.components.length → ℕ := fun i ↦
    (((a5FourthD4.componentType i).glueLabelEquiv _).symm (componentTrialityLabel i (w i))).val
  have hG (i : Fin a5FourthD4.components.length) (hi : i ≠ a5FourthD4D4Index) :
      G i = (((a5FourthD4.componentType i).glueLabelEquiv _).symm (w i)).val := by
    simp only [G, componentTrialityLabel_of_ne hi]
  have hG4 : G ⟨4, by decide⟩ = [0, 2, 3, 1].getD
      (((a5FourthD4.componentType ⟨4, by decide⟩).glueLabelEquiv _).symm
        (w ⟨4, by decide⟩)).val 0 :=
    val_glueLabelEquiv_symm_componentTrialityLabel_d4Index _
  -- The inverse rotation reads the positions `0, 3, 1, 2, 4`, and
  -- `QuadraticMap.IsometryEquiv.pi` applies `componentTrialityLabel` coordinatewise by definition.
  refine (ofFn_comp_a5FourthD4BlockRotation_symm G).trans ?_
  rw [hG ⟨0, by decide⟩ (by decide), hG ⟨3, by decide⟩ (by decide),
    hG ⟨1, by decide⟩ (by decide), hG ⟨2, by decide⟩ (by decide), hG4, encodeGlueWord_def,
    ofFn_a5FourthD4, a5FourthD4TrialityDigits_def]
  simp only [List.getD_cons_zero, List.getD_cons_succ]

/-- **The rotation combined with triality permutes the digit words of `A₅⁴ D₄`**: it carries the
rotations of `[2(024)0]` among themselves and `[33001] ↦ [30302] ↦ [30033] ↦ [33001]`. -/
theorem a5FourthD4TrialityDigits_mem_glueWords :
    ∀ l ∈ a5FourthD4.glueWords, a5FourthD4TrialityDigits l ∈ a5FourthD4.glueWords := by
  decide

/-- **The rotation combined with triality preserves the glue subgroup of `A₅⁴ D₄`.** -/
theorem a5FourthD4TrialityGlueIsometry_mem_glueSubgroup_iff (w : a5FourthD4.glueModule) :
    a5FourthD4TrialityGlueIsometry w ∈ a5FourthD4.glueSubgroup ↔ w ∈ a5FourthD4.glueSubgroup :=
  -- The rotation combined with triality maps the generators of the glue subgroup among themselves.
  a5FourthD4.apply_mem_glueSubgroup_iff_of_mapsTo_glueGenerators a5FourthD4TrialityGlueIsometry
    (fun v hv ↦ mem_glueGenerators_iff.mpr <| encodeGlueWord_a5FourthD4TrialityGlueIsometry v ▸
      a5FourthD4TrialityDigits_mem_glueWords _ (mem_glueGenerators_iff.mp hv)) w

/-! ### The induced isometry of the glued lattice -/

/-- The glue words whose reindexing along the inverse block rotation lies in the glue subgroup:
the glue subgroup after triality on the `D₄` label, an intermediate step of
`a5FourthD4TrialityIsometry`. -/
private noncomputable def trialityGlueSubgroup : AddSubgroup a5FourthD4.glueModule :=
  a5FourthD4.glueSubgroup.comap
    ((piGlueAlphabetCongr a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
        a5FourthD4BlockRotation.symm
        componentType_a5FourthD4BlockRotation_symm).toLinearEquiv.toAddEquiv :
      a5FourthD4.glueModule →+ a5FourthD4.glueModule)

private theorem mem_trialityGlueSubgroup_iff (w : a5FourthD4.glueModule) :
    w ∈ trialityGlueSubgroup ↔
      piGlueAlphabetCongr a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
        a5FourthD4BlockRotation.symm componentType_a5FourthD4BlockRotation_symm w ∈
          a5FourthD4.glueSubgroup :=
  Iff.rfl

private theorem isIsotropic_trialityGlueSubgroup :
    a5FourthD4.glueModule.IsIsotropic trialityGlueSubgroup :=
  (FiniteQuadraticModule.isIsotropic_def _).mpr fun x hx ↦
    ((piGlueAlphabetCongr a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
        a5FourthD4BlockRotation.symm componentType_a5FourthD4BlockRotation_symm).map_app
          x).symm.trans
      ((FiniteQuadraticModule.isIsotropic_def _).mp a5FourthD4.isIsotropic_glueSubgroup _ hx)

/-- **The rotation combined with triality is a self-isometry of the lattice `N_{A₅⁴ D₄}`.**  It
applies triality to the `D₄` component and moves the component in position `k` to position `ρ k`,
where `ρ` is the block rotation of `[2(024)0]`. -/
noncomputable def a5FourthD4TrialityIsometry :
    IntegralLattice.Isometry a5FourthD4.lattice a5FourthD4.lattice :=
  (Isometry.ofEq (lattice_def a5FourthD4)).trans <| ((gluedLatticePiIsometry
      a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
      a5FourthD4.valid_componentType a5FourthD4.glueSubgroup a5FourthD4.isIsotropic_glueSubgroup
      a5FourthD4.valid_componentType isIsotropic_trialityGlueSubgroup componentTriality
      (fun i ↦ componentTrialityLabel i) glueAlphabetIsometry_componentTrialityLabel
      fun w ↦ (mem_trialityGlueSubgroup_iff _).trans
        (a5FourthD4TrialityGlueIsometry_mem_glueSubgroup_iff w)).trans
    (gluedLatticeIsometryOfEq a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
      a5FourthD4.valid_componentType trialityGlueSubgroup isIsotropic_trialityGlueSubgroup
      a5FourthD4.valid_componentType a5FourthD4.isIsotropic_glueSubgroup
      a5FourthD4BlockRotation.symm componentType_a5FourthD4BlockRotation_symm
      fun w ↦ (mem_trialityGlueSubgroup_iff w).symm)).trans
    (Isometry.ofEq (lattice_def a5FourthD4).symm)

private theorem a5FourthD4TrialityIsometry_apply
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ)
    (k : Fin a5FourthD4.components.length) (j : Fin (a5FourthD4.componentType k).rank) :
    a5FourthD4TrialityIsometry x k j =
      componentTriality (a5FourthD4BlockRotation.symm k) (x (a5FourthD4BlockRotation.symm k))
        (Fin.cast (congrArg rank (componentType_a5FourthD4BlockRotation_symm k)).symm j) := by
  rw [a5FourthD4TrialityIsometry, Isometry.trans_apply, Isometry.trans_apply,
    Isometry.trans_apply, Isometry.ofEq_apply, Isometry.ofEq_apply,
    gluedLatticeIsometryOfEq_apply, gluedLatticePiIsometry_apply]

/-- The block rotation fixes the position of the `D₄` component. -/
@[simp]
theorem a5FourthD4BlockRotation_d4Index :
    a5FourthD4BlockRotation a5FourthD4D4Index = a5FourthD4D4Index := by
  decide

/-- The inverse block rotation fixes the position of the `D₄` component. -/
@[simp]
theorem a5FourthD4BlockRotation_symm_d4Index :
    a5FourthD4BlockRotation.symm a5FourthD4D4Index = a5FourthD4D4Index := by
  decide

/-- The block rotation maps the positions of the `A₅` components among themselves. -/
private theorem a5FourthD4BlockRotation_symm_ne_d4Index {i : Fin a5FourthD4.components.length}
    (hi : i ≠ a5FourthD4D4Index) : a5FourthD4BlockRotation.symm i ≠ a5FourthD4D4Index :=
  fun h ↦ hi (a5FourthD4BlockRotation.symm.injective
    (h.trans a5FourthD4BlockRotation_symm_d4Index.symm))

/-- The cube of the block rotation is the identity. -/
private theorem a5FourthD4BlockRotation_symm_symm_symm (k : Fin a5FourthD4.components.length) :
    a5FourthD4BlockRotation.symm (a5FourthD4BlockRotation.symm (a5FourthD4BlockRotation.symm k)) =
      k := by
  revert k
  decide

/-- **On the `D₄` component, `a5FourthD4TrialityIsometry` is triality.** -/
@[simp]
theorem a5FourthD4TrialityIsometry_apply_d4Index
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ) :
    a5FourthD4TrialityIsometry x a5FourthD4D4Index =
      typeD4Triality (isSimplyLaced_D 4) (x a5FourthD4D4Index) := by
  funext j
  rw [a5FourthD4TrialityIsometry_apply]
  refine (Fin.apply_cast_eq_apply_cast (fun i ↦ componentTriality i (x i))
    a5FourthD4BlockRotation_symm_d4Index _ rfl j).trans ?_
  rw [componentTriality_d4Index, Fin.cast_eq_self]
  -- The two sides differ only in the type of `x a5FourthD4D4Index`, written once with
  -- `a5FourthD4.componentType a5FourthD4D4Index` and once with `D 4`; these agree by definition
  -- (`componentType_a5FourthD4D4Index`).
  rfl

/-- **On an `A₅` component, `a5FourthD4TrialityIsometry` reads the coordinates in position `k`
from position `ρ⁻¹ k`**, where `ρ` is the block rotation. -/
theorem a5FourthD4TrialityIsometry_apply_of_ne
    (x : ∀ i, Fin (a5FourthD4.componentType i).rank → ℚ) {k : Fin a5FourthD4.components.length}
    (hk : k ≠ a5FourthD4D4Index) (j : Fin (a5FourthD4.componentType k).rank) :
    a5FourthD4TrialityIsometry x k j =
      x (a5FourthD4BlockRotation.symm k)
        (Fin.cast (congrArg rank (componentType_a5FourthD4BlockRotation_symm k)).symm j) := by
  rw [a5FourthD4TrialityIsometry_apply,
    componentTriality_of_ne (a5FourthD4BlockRotation_symm_ne_d4Index hk), Isometry.one_apply]

/-- **The rotation combined with triality has order dividing three**, like the rotation and
triality themselves. -/
@[simp]
theorem a5FourthD4TrialityIsometry_pow_three : a5FourthD4TrialityIsometry ^ 3 = 1 := by
  refine Isometry.ext fun x ↦ funext fun k ↦ ?_
  rw [pow_three, Isometry.mul_apply, Isometry.mul_apply, Isometry.one_apply]
  by_cases hk : k = a5FourthD4D4Index
  · subst hk
    rw [a5FourthD4TrialityIsometry_apply_d4Index, a5FourthD4TrialityIsometry_apply_d4Index,
      a5FourthD4TrialityIsometry_apply_d4Index]
    have h (y : Fin (D 4).rank → ℚ) : typeD4Triality (isSimplyLaced_D 4)
        (typeD4Triality (isSimplyLaced_D 4) (typeD4Triality (isSimplyLaced_D 4) y)) = y := by
      rw [← Isometry.mul_apply, ← Isometry.mul_apply, ← pow_three', typeD4Triality_pow_three,
        Isometry.one_apply]
    exact h (x a5FourthD4D4Index)
  · funext j
    have hk' := a5FourthD4BlockRotation_symm_ne_d4Index hk
    rw [a5FourthD4TrialityIsometry_apply_of_ne _ hk, a5FourthD4TrialityIsometry_apply_of_ne _ hk',
      a5FourthD4TrialityIsometry_apply_of_ne _ (a5FourthD4BlockRotation_symm_ne_d4Index hk'),
      Fin.cast_cast, Fin.cast_cast]
    exact Fin.apply_cast_eq_apply_cast x (a5FourthD4BlockRotation_symm_symm_symm k) _ rfl j

/-- `a5FourthD4TrialityIsometry` moves the component in position `1` to position `2`, so it is not
the identity. -/
theorem a5FourthD4TrialityIsometry_ne_one : a5FourthD4TrialityIsometry ≠ 1 := fun h ↦ by
  let k : Fin a5FourthD4.components.length := ⟨2, by decide⟩
  let j₀ : Fin (a5FourthD4.componentType k).rank := ⟨0, by decide⟩
  have hv := congrArg (fun f : Isometry a5FourthD4.lattice a5FourthD4.lattice ↦
    f (Pi.single (a5FourthD4BlockRotation.symm k) fun _ ↦ 1) k j₀) h
  rw [a5FourthD4TrialityIsometry_apply_of_ne _ (by decide), Isometry.one_apply,
    Pi.single_eq_same, Pi.single_eq_of_ne (by decide : k ≠ a5FourthD4BlockRotation.symm k)] at hv
  exact one_ne_zero hv

/-- **The rotation combined with triality has order exactly three.** -/
@[simp]
theorem orderOf_a5FourthD4TrialityIsometry : orderOf a5FourthD4TrialityIsometry = 3 :=
  orderOf_eq_prime a5FourthD4TrialityIsometry_pow_three a5FourthD4TrialityIsometry_ne_one

/-! ### The action of the pattern symmetries of `A₅⁴ D₄` -/

/-- The indicated symmetries of `[2(024)0]` are the powers of the block rotation, read in the
positions of the pattern. -/
private theorem symmetries_cyclic_a5FourthD4 :
    (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries =
      Subgroup.zpowers ((finCongr (length_eq_of_mem_gluePatterns
        cyclic_mem_gluePatterns_a5FourthD4)).symm.permCongr a5FourthD4BlockRotation) := by
  rw [GluePattern.symmetries_cyclic]
  exact congrArg Subgroup.zpowers ((Equiv.eq_symm_apply _).mpr permCongr_finSumPerm_finRotate)

/-- **The generator of the indicated symmetries of `[2(024)0]`**: the block rotation, read in the
positions of the pattern. -/
def a5FourthD4CyclicSymmetryGen : (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries :=
  ⟨(finCongr (length_eq_of_mem_gluePatterns cyclic_mem_gluePatterns_a5FourthD4)).symm.permCongr
      a5FourthD4BlockRotation, symmetries_cyclic_a5FourthD4.ge (Subgroup.mem_zpowers _)⟩

/-- As a permutation of the positions of the pattern, `a5FourthD4CyclicSymmetryGen` is the block
rotation transported along the identification of the positions with the component positions. -/
@[simp]
theorem val_a5FourthD4CyclicSymmetryGen :
    a5FourthD4CyclicSymmetryGen.val =
      (finCongr (length_eq_of_mem_gluePatterns cyclic_mem_gluePatterns_a5FourthD4)).symm.permCongr
        a5FourthD4BlockRotation :=
  (rfl)

/-- Every symmetry of `[2(024)0]` is an integer power of `a5FourthD4CyclicSymmetryGen`. -/
theorem mem_zpowers_a5FourthD4CyclicSymmetryGen
    (x : (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries) :
    x ∈ Subgroup.zpowers a5FourthD4CyclicSymmetryGen := by
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (symmetries_cyclic_a5FourthD4.le x.2)
  exact Subgroup.mem_zpowers_iff.mpr ⟨n, Subtype.ext (by simpa using hn)⟩

/-- `a5FourthD4CyclicSymmetryGen` generates the symmetries of `[2(024)0]`. -/
@[simp]
theorem zpowers_a5FourthD4CyclicSymmetryGen :
    Subgroup.zpowers a5FourthD4CyclicSymmetryGen = ⊤ :=
  eq_top_iff.mpr fun x _ ↦ mem_zpowers_a5FourthD4CyclicSymmetryGen x

/-- `a5FourthD4CyclicSymmetryGen` has exponent three. -/
@[simp]
theorem a5FourthD4CyclicSymmetryGen_pow_three : a5FourthD4CyclicSymmetryGen ^ 3 = 1 := by
  refine Subtype.ext ?_
  rw [Subgroup.coe_pow, Subgroup.coe_one, val_a5FourthD4CyclicSymmetryGen,
    ← Equiv.permCongrHom_coe, ← map_pow, a5FourthD4BlockRotation_pow_three, map_one]

/-- `a5FourthD4CyclicSymmetryGen` has order three. -/
@[simp]
theorem orderOf_a5FourthD4CyclicSymmetryGen : orderOf a5FourthD4CyclicSymmetryGen = 3 := by
  rw [← Subgroup.orderOf_coe, val_a5FourthD4CyclicSymmetryGen, ← Equiv.permCongrHom_coe,
    MulEquiv.orderOf_eq, orderOf_a5FourthD4BlockRotation]

/-- **The rotations of `[2(024)0]` act on `N_{A₅⁴ D₄}`** by mapping the generator
`a5FourthD4CyclicSymmetryGen` to `a5FourthD4TrialityIsometry`. -/
noncomputable def a5FourthD4CyclicSymmetryHom :
    (GluePattern.cyclic [2] [0, 2, 4] [0]).symmetries →*
      IntegralLattice.Isometry a5FourthD4.lattice a5FourthD4.lattice :=
  monoidHomOfForallMemZpowers mem_zpowers_a5FourthD4CyclicSymmetryGen
    (by rw [orderOf_a5FourthD4TrialityIsometry, orderOf_a5FourthD4CyclicSymmetryGen])

/-- `a5FourthD4CyclicSymmetryHom` maps the generator to `a5FourthD4TrialityIsometry`. -/
@[simp]
theorem a5FourthD4CyclicSymmetryHom_gen :
    a5FourthD4CyclicSymmetryHom a5FourthD4CyclicSymmetryGen = a5FourthD4TrialityIsometry :=
  monoidHomOfForallMemZpowers_apply_gen _ _

/-- **The rotations of `[2(024)0]` act faithfully on `N_{A₅⁴ D₄}`.** -/
theorem a5FourthD4CyclicSymmetryHom_injective :
    Function.Injective a5FourthD4CyclicSymmetryHom := by
  rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
  intro x hx
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp (mem_zpowers_a5FourthD4CyclicSymmetryGen x)
  rw [MonoidHom.mem_ker, map_zpow, a5FourthD4CyclicSymmetryHom_gen,
    ← orderOf_dvd_iff_zpow_eq_one, orderOf_a5FourthD4TrialityIsometry] at hx
  rwa [← orderOf_dvd_iff_zpow_eq_one, orderOf_a5FourthD4CyclicSymmetryGen]

/-- **Every pattern of `A₅⁴ D₄` acts on `N_{A₅⁴ D₄}`**: `[2(024)0]` acts through
`a5FourthD4CyclicSymmetryHom` (the block rotation combined with triality on the `D₄` component),
and the three literal patterns have trivial symmetry group and act trivially. -/
noncomputable def a5FourthD4PatternIsometryHom :
    {p : GluePattern} → p ∈ a5FourthD4.gluePatterns →
      p.symmetries →* IntegralLattice.Isometry a5FourthD4.lattice a5FourthD4.lattice
  | .literal _, _ => 1
  | .cyclic pre block post, hp =>
    have heq : GluePattern.cyclic pre block post = .cyclic [2] [0, 2, 4] [0] := by
      simp only [gluePatterns, List.mem_cons, List.not_mem_nil, or_false, reduceCtorEq] at hp
      exact hp
    heq ▸ a5FourthD4CyclicSymmetryHom
  | .evenPermutations _, hp => by
    simp [gluePatterns] at hp

/-- On the pattern `[2(024)0]`, `a5FourthD4PatternIsometryHom` is `a5FourthD4CyclicSymmetryHom`. -/
@[simp]
theorem a5FourthD4PatternIsometryHom_cyclic
    (hp : .cyclic [2] [0, 2, 4] [0] ∈ a5FourthD4.gluePatterns) :
    a5FourthD4PatternIsometryHom hp = a5FourthD4CyclicSymmetryHom :=
  (rfl)

/-- On a literal pattern of `A₅⁴ D₄`, `a5FourthD4PatternIsometryHom` is trivial. -/
@[simp]
theorem a5FourthD4PatternIsometryHom_literal {w : List ℕ}
    (hp : .literal w ∈ a5FourthD4.gluePatterns) :
    a5FourthD4PatternIsometryHom hp = 1 :=
  (rfl)

/-- **Every pattern of `A₅⁴ D₄` acts faithfully on `N_{A₅⁴ D₄}`.** -/
theorem a5FourthD4PatternIsometryHom_injective {p : GluePattern}
    (hp : p ∈ a5FourthD4.gluePatterns) :
    Function.Injective (a5FourthD4PatternIsometryHom hp) := by
  have hp' := hp
  simp only [gluePatterns, List.mem_cons, List.not_mem_nil, or_false] at hp'
  rcases hp' with rfl | rfl | rfl | rfl
  · exact a5FourthD4CyclicSymmetryHom_injective
  all_goals
    intro g h _
    exact Subtype.ext
      ((Subgroup.mem_bot.mp ((GluePattern.symmetries_literal _).le g.2)).trans
        (Subgroup.mem_bot.mp ((GluePattern.symmetries_literal _).le h.2)).symm)

