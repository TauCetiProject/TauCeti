module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.Table

/-!
# The cyclic glue symmetry of the mixed row `A₅⁴ D₄`

The rotation of the three marked `A₅` components in `[2(024)0]` does not by itself
preserve the glue subgroup of `A₅⁴ D₄`. It must be accompanied by triality on the
`D₄` alphabet: the labels are cycled `1 ↦ 2 ↦ 3 ↦ 1`. The combined operation reads
the components in order `[0,3,1,2,4]` and cycles the last label. It permutes the
three rotations of `[20240]` and also the other three generators `[33001]`,
`[30302]`, `[30033]`.

Here this operation is constructed as an isometry of the complete finite quadratic
module, not just a permutation of the printed words. It preserves the subgroup
generated by the table words and has cube equal to the identity. This supplies the
glue-coordinate symmetry for lifting the combined component rotation and `D₄`
diagram triality to the glued lattice.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*,
  3rd ed., Chapter 4 §3 and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti.RootfulNiemeierType

open DynkinType IntegralLattice

private abbrev types : Fin 5 → DynkinType := ![A 5, A 5, A 5, A 5, D 4]

private theorem simplyLaced (i : Fin 5) : (types i).IsSimplyLaced := by
  fin_cases i <;> decide

private noncomputable abbrev words := FiniteQuadraticModule.pi fun i ↦
  (types i).glueAlphabet (simplyLaced i)

private noncomputable def coordinates : FiniteQuadraticModule.Isometry a5FourthD4.glueModule
    words :=
  a5FourthD4.glueModuleIsometry simplyLaced rfl (fun i ↦ by fin_cases i <;> rfl)

private theorem encode_coordinates (w : a5FourthD4.glueModule) :
    encodeGlueWord types simplyLaced (coordinates w) =
      encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w :=
  encodeGlueWord_glueModuleIsometry _ _ _ _ w

/-- The operation on the explicit family of component alphabets. -/
private noncomputable def rotate (w : words) : words
  | 0 => w 0
  | 1 => w 3
  | 2 => w 1
  | 3 => w 2
  | 4 => ((w 4).1 + (w 4).2, (w 4).1)

private theorem rotate_cube (w : words) : rotate (rotate (rotate w)) = w := by
  ext i
  fin_cases i <;> try rfl
  -- Make the concrete Klein four carrier visible to the finite computation.
  change (((w 4).1 + (w 4).2 + (w 4).1 + ((w 4).1 + (w 4).2),
    (w 4).1 + (w 4).2 + (w 4).1) : ZMod 2 × ZMod 2) = w 4
  exact (by decide : ∀ a b : ZMod 2,
    (a + b + a + (a + b), a + b + a) = (a, b)) (w 4).1 (w 4).2

private noncomputable def rotationAddEquiv : words ≃+ words where
  toFun := rotate
  invFun := rotate ∘ rotate
  left_inv := rotate_cube
  right_inv := rotate_cube
  map_add' w v := by
    ext i
    fin_cases i <;> try rfl
    -- Expose only the Klein four coordinate; the cyclic coordinates are reflexive.
    change (((w 4).1 + (v 4).1 + ((w 4).2 + (v 4).2), (w 4).1 + (v 4).1) :
      ZMod 2 × ZMod 2) = ((w 4).1 + (w 4).2 + ((v 4).1 + (v 4).2),
        (w 4).1 + (v 4).1)
    congr 1
    ring

private noncomputable def rotation : FiniteQuadraticModule.Isometry words words where
  toLinearEquiv := rotationAddEquiv.toIntLinearEquiv
  map_app' w := by
    let q : (ZMod 2 × ZMod 2) → AddCircle (1 : ℚ) :=
      (checkerboardStandardQuadraticModule 4 (by decide)).quadratic
    have h10 : q (1, 0) = ((1 / 2 : ℚ) : AddCircle (1 : ℚ)) :=
      checkerboardStandardQuadraticModule_quadratic_one_zero _ _
    have h01 : q (0, 1) = ((1 / 2 : ℚ) : AddCircle (1 : ℚ)) := by
      convert checkerboardStandardQuadraticModule_quadratic_zero_one 4 (by decide) using 1
      norm_num
    have h11 : q (1, 1) = ((1 / 2 : ℚ) : AddCircle (1 : ℚ)) := by
      convert checkerboardStandardQuadraticModule_quadratic_one_one 4 (by decide) using 1
      norm_num
    have hD (a b : ZMod 2) : q (a + b, a) = q (a, b) := by
      fin_cases a <;> fin_cases b
      · rfl
      · convert h10.trans h01.symm using 1 <;> congr 1
      · convert h11.trans h10.symm using 1 <;> congr 1
      · convert h01.trans h11.symm using 1 <;> congr 1
    -- The explicit family makes the carrier literally four cyclic alphabets and one Klein four.
    change (∑ i, ((types i).glueAlphabet (simplyLaced i)).quadratic (rotate w i)) =
      ∑ i, ((types i).glueAlphabet (simplyLaced i)).quadratic (w i)
    simp only [Fin.sum_univ_succ, Finset.univ_eq_empty, Finset.sum_empty, add_zero]
    -- Spell out both the cyclic forms and the ambient additive structure, avoiding
    -- semireducible finite-module carriers during rearrangement.
    let qa : ZMod 6 → AddCircle (1 : ℚ) := (typeAStandardQuadraticModule 5).quadratic
    change qa (w 0) + (qa (w 3) + (qa (w 1) + (qa (w 2) +
      q ((w 4).1 + (w 4).2, (w 4).1)))) =
      qa (w 0) + (qa (w 1) + (qa (w 2) + (qa (w 3) + q (w 4))))
    rw [hD]
    abel

private theorem rotation_apply (w : words) : rotation w = rotate w := (rfl)

/-- **The corrected cyclic symmetry of the `A₅⁴ D₄` glue module**: rotate the
marked `A₅` positions and cycle the nonzero `D₄` labels `1 ↦ 2 ↦ 3 ↦ 1`.
Both the half-norm and its polar pairing are preserved. -/
noncomputable def a5FourthD4GlueRotation :
    FiniteQuadraticModule.Isometry a5FourthD4.glueModule a5FourthD4.glueModule :=
  coordinates.trans (rotation.trans coordinates.symm)

private def rotateDigits (l : List ℕ) : List ℕ :=
  [l[0]!, l[3]!, l[1]!, l[2]!,
    match l[4]! with | 1 => 2 | 2 => 3 | 3 => 1 | d => d]

private theorem encode_rotation (w : words) :
    encodeGlueWord types simplyLaced (rotation w) =
      rotateDigits (encodeGlueWord types simplyLaced w) := by
  obtain ⟨d, hd⟩ := (Equiv.piCongrRight fun i ↦
    (types i).glueLabelEquiv (simplyLaced i)).surjective w
  have he : w = fun i ↦ (types i).glueLabelEquiv _ (d i) := hd.symm
  rw [he, rotation_apply]
  simp only [encodeGlueWord_def, List.ofFn_succ, List.ofFn_zero, rotate, rotateDigits]
  dsimp
  -- The label carrier is semireducible, so cancellation needs `erw` transparency.
  repeat erw [Equiv.symm_apply_apply]
  -- Replace the dependent coordinate types by their concrete alphabet carriers.
  change [((d 0 : Fin 6) : ℕ), ((d 3 : Fin 6) : ℕ), ((d 1 : Fin 6) : ℕ),
    ((d 2 : Fin 6) : ℕ),
    (((D 4).glueLabelEquiv (isSimplyLaced_D 4)).symm
      ((((D 4).glueLabelEquiv _ (d 4)).1 + ((D 4).glueLabelEquiv _ (d 4)).2,
        ((D 4).glueLabelEquiv _ (d 4)).1))).val] =
      rotateDigits [((d 0 : Fin 6) : ℕ), ((d 1 : Fin 6) : ℕ), ((d 2 : Fin 6) : ℕ),
        ((d 3 : Fin 6) : ℕ), ((d 4 : Fin 4) : ℕ)]
  let e := (D 4).glueLabelEquiv (isSimplyLaced_D 4)
  have hlabel (i : Fin 4) : e i =
      (((i.val / 2 : ℕ) : ZMod 2), ((i.val % 2 : ℕ) : ZMod 2)) := by
    have h := glueLabelEquiv_D_of_even 4 (isSimplyLaced_D 4) (by decide) i
    erw [FiniteQuadraticModule.Isometry.ofEq_apply, cast_eq] at h
    exact h
  have htrial (i : Fin 4) : e.symm ((e i).1 + (e i).2, (e i).1) = ![0, 2, 3, 1] i := by
    apply e.symm_apply_eq.mpr
    erw [hlabel, hlabel]
    -- Restate in the literal Klein four carrier after rewriting the transported labels.
    change (((i.val / 2 : ℕ) : ZMod 2) + ((i.val % 2 : ℕ) : ZMod 2),
      ((i.val / 2 : ℕ) : ZMod 2)) =
        ((((![0, 2, 3, 1] i : Fin 4).val / 2 : ℕ) : ZMod 2),
          (((![0, 2, 3, 1] i : Fin 4).val % 2 : ℕ) : ZMod 2))
    fin_cases i <;> decide
  erw [htrial]
  generalize d 4 = i
  fin_cases i <;> rfl

/-- **The digit formula for the corrected rotation.** The four `A₅` digits
are read in order `[0,3,1,2]`, while the final digit undergoes triality. -/
theorem encodeGlueWord_a5FourthD4GlueRotation (w : a5FourthD4.glueModule) :
    encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
        (a5FourthD4GlueRotation w) =
      let l := encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w
      [l[0]!, l[3]!, l[1]!, l[2]!,
        match l[4]! with | 1 => 2 | 2 => 3 | 3 => 1 | d => d] := by
  rw [← encode_coordinates, a5FourthD4GlueRotation]
  simp only [QuadraticMap.IsometryEquiv.trans_apply, QuadraticMap.IsometryEquiv.apply_symm_apply]
  rw [encode_rotation, encode_coordinates]
  rfl

/-- The combined symmetry has cube equal to the identity. -/
@[simp]
theorem a5FourthD4GlueRotation_cube (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation (a5FourthD4GlueRotation (a5FourthD4GlueRotation w)) = w := by
  apply coordinates.injective
  -- Use the isometry coercion, rather than the underlying linear-equivalence coercion.
  change coordinates (a5FourthD4GlueRotation (a5FourthD4GlueRotation
    (a5FourthD4GlueRotation w))) = coordinates w
  simp only [a5FourthD4GlueRotation, QuadraticMap.IsometryEquiv.trans_apply,
    QuadraticMap.IsometryEquiv.apply_symm_apply]
  erw [rotation_apply, rotation_apply, rotation_apply]
  exact rotate_cube _

private theorem rotation_mem_generators (w : words) :
    encodeGlueWord types simplyLaced (rotation w) ∈ a5FourthD4.glueWords ↔
      encodeGlueWord types simplyLaced w ∈ a5FourthD4.glueWords := by
  rw [encode_rotation]
  have hwords : a5FourthD4.glueWords =
      {[2, 0, 2, 4, 0], [2, 2, 4, 0, 0], [2, 4, 0, 2, 0],
        [3, 3, 0, 0, 1], [3, 0, 3, 0, 2], [3, 0, 0, 3, 3]} := by decide
  rw [hwords]
  obtain ⟨d, hd⟩ := (Equiv.piCongrRight fun i ↦
    (types i).glueLabelEquiv (simplyLaced i)).surjective w
  have he : w = fun i ↦ (types i).glueLabelEquiv _ (d i) := hd.symm
  rw [he, encodeGlueWord_glueLabelEquiv]
  clear he hd w
  -- Split the coordinate tuple before computation to keep kernel recursion shallow.
  have h (a b c d : Fin 6) (e : Fin 4) :
      rotateDigits [a.val, b.val, c.val, d.val, e.val] ∈
          ({[2, 0, 2, 4, 0], [2, 2, 4, 0, 0], [2, 4, 0, 2, 0],
            [3, 3, 0, 0, 1], [3, 0, 3, 0, 2], [3, 0, 0, 3, 3]} : Finset (List ℕ)) ↔
        [a.val, b.val, c.val, d.val, e.val] ∈
          ({[2, 0, 2, 4, 0], [2, 2, 4, 0, 0], [2, 4, 0, 2, 0],
            [3, 3, 0, 0, 1], [3, 0, 3, 0, 2], [3, 0, 0, 3, 3]} : Finset (List ℕ)) := by
    revert a b c d e
    decide +kernel
  simp only [List.ofFn_succ, List.ofFn_zero]
  convert h (d 0) (d 1) (d 2) (d 3) (d 4) using 1 <;> rfl

/-- The combined symmetry permutes the actual decoded table generators. -/
@[simp]
theorem a5FourthD4GlueRotation_mem_glueGenerators_iff (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation w ∈ a5FourthD4.glueGenerators ↔
      w ∈ a5FourthD4.glueGenerators := by
  rw [mem_glueGenerators_iff, mem_glueGenerators_iff, ← encode_coordinates,
    ← encode_coordinates]
  simp only [a5FourthD4GlueRotation, QuadraticMap.IsometryEquiv.trans_apply,
    QuadraticMap.IsometryEquiv.apply_symm_apply]
  exact rotation_mem_generators _

/-- **The combined rotation and triality preserves the generated glue subgroup**,
not merely the set of printed words. -/
theorem map_glueSubgroup_a5FourthD4GlueRotation :
    a5FourthD4.glueSubgroup.map
        (a5FourthD4GlueRotation : a5FourthD4.glueModule →+ a5FourthD4.glueModule) =
      a5FourthD4.glueSubgroup := by
  rw [glueSubgroup_def, AddMonoidHom.map_closure]
  congr 1
  ext w
  constructor
  · rintro ⟨v, hv, rfl⟩
    exact (a5FourthD4GlueRotation_mem_glueGenerators_iff v).mpr hv
  · intro hw
    obtain ⟨v, rfl⟩ := a5FourthD4GlueRotation.surjective w
    exact ⟨v, (a5FourthD4GlueRotation_mem_glueGenerators_iff v).mp hw, rfl⟩

/-- Membership in the glue subgroup is invariant under the corrected rotation. -/
@[simp]
theorem a5FourthD4GlueRotation_mem_glueSubgroup_iff (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation w ∈ a5FourthD4.glueSubgroup ↔ w ∈ a5FourthD4.glueSubgroup := by
  have h := AddSubgroup.mem_map_iff_mem
    (f := (a5FourthD4GlueRotation : a5FourthD4.glueModule →+ a5FourthD4.glueModule))
    a5FourthD4GlueRotation.injective (K := a5FourthD4.glueSubgroup) (x := w)
  rwa [map_glueSubgroup_a5FourthD4GlueRotation] at h

end TauCeti.RootfulNiemeierType
