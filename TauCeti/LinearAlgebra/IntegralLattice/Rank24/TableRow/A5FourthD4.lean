module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.Table
public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeD.Triality

/-!
# The cyclic glue symmetry of the mixed row `A₅⁴ D₄`

The rotation of the three marked `A₅` components in `[2(024)0]` does not by itself
preserve the glue subgroup of `A₅⁴ D₄`. It must be accompanied by triality on the
`D₄` alphabet: the labels are cycled `1 ↦ 2 ↦ 3 ↦ 1`. The combined operation reads
the components in order `[0,3,1,2,4]` and cycles the last label. It permutes the
three rotations of `[20240]` and also the other three generators `[33001]`,
`[30302]`, `[30033]`.

The isometry is assembled from component reindexing and the discriminant action
of `DynkinType.typeD4Triality`. It preserves the subgroup generated by the table
words and has cube equal to the identity. The component formulas in the native
row coordinates describe the symmetry for lifting the combined rotation and
diagram triality to the glued lattice.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*,
  3rd ed., Chapter 4 §3 and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti.RootfulNiemeierType

open DynkinType IntegralLattice

/-- The component reindexing `[0,3,1,2,4]` of the mixed row `A₅⁴ D₄`. -/
def a5FourthD4ComponentRotation : Equiv.Perm (Fin 5) where
  toFun := ![0, 3, 1, 2, 4]
  invFun := ![0, 2, 3, 1, 4]
  left_inv := by decide
  right_inv := by decide

/-- The component rotation reads positions in order `[0,3,1,2,4]`. -/
theorem a5FourthD4ComponentRotation_apply (i : Fin 5) :
    a5FourthD4ComponentRotation i = ![0, 3, 1, 2, 4] i := (rfl)

/-- The inverse component rotation reads positions in order `[0,2,3,1,4]`. -/
theorem a5FourthD4ComponentRotation_symm_apply (i : Fin 5) :
    a5FourthD4ComponentRotation.symm i = ![0, 2, 3, 1, 4] i := (rfl)

/-- The component rotation fixes position zero. -/
@[simp] theorem a5FourthD4ComponentRotation_zero : a5FourthD4ComponentRotation 0 = 0 := (rfl)

/-- The component rotation reads position three at position one. -/
@[simp] theorem a5FourthD4ComponentRotation_one : a5FourthD4ComponentRotation 1 = 3 := (rfl)

/-- The component rotation reads position one at position two. -/
@[simp] theorem a5FourthD4ComponentRotation_two : a5FourthD4ComponentRotation 2 = 1 := (rfl)

/-- The component rotation reads position two at position three. -/
@[simp] theorem a5FourthD4ComponentRotation_three : a5FourthD4ComponentRotation 3 = 2 := (rfl)

/-- The component rotation fixes position four. -/
@[simp] theorem a5FourthD4ComponentRotation_four : a5FourthD4ComponentRotation 4 = 4 := (rfl)

/-- The inverse component rotation fixes position zero. -/
@[simp] theorem a5FourthD4ComponentRotation_symm_zero :
    a5FourthD4ComponentRotation.symm 0 = 0 := (rfl)

/-- The inverse component rotation reads position two at position one. -/
@[simp] theorem a5FourthD4ComponentRotation_symm_one :
    a5FourthD4ComponentRotation.symm 1 = 2 := (rfl)

/-- The inverse component rotation reads position three at position two. -/
@[simp] theorem a5FourthD4ComponentRotation_symm_two :
    a5FourthD4ComponentRotation.symm 2 = 3 := (rfl)

/-- The inverse component rotation reads position one at position three. -/
@[simp] theorem a5FourthD4ComponentRotation_symm_three :
    a5FourthD4ComponentRotation.symm 3 = 1 := (rfl)

/-- The inverse component rotation fixes position four. -/
@[simp] theorem a5FourthD4ComponentRotation_symm_four :
    a5FourthD4ComponentRotation.symm 4 = 4 := (rfl)

/-- The component rotation has cube equal to the identity. -/
@[simp] theorem a5FourthD4ComponentRotation_pow_three :
    a5FourthD4ComponentRotation ^ 3 = 1 := by decide

/-- Applying the component rotation three times fixes every position. -/
@[simp] theorem a5FourthD4ComponentRotation_apply_apply_apply (i : Fin 5) :
    a5FourthD4ComponentRotation
      (a5FourthD4ComponentRotation (a5FourthD4ComponentRotation i)) = i := by
  fin_cases i <;> simp

private noncomputable def componentIsometry (i : Fin 5) :
    FiniteQuadraticModule.Isometry
      ((a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i))
      ((a5FourthD4.componentType i).glueAlphabet (a5FourthD4.isSimplyLaced_componentType i)) :=
  match i with
  | 0 => QuadraticMap.IsometryEquiv.refl _
  | 1 => QuadraticMap.IsometryEquiv.refl _
  | 2 => QuadraticMap.IsometryEquiv.refl _
  | 3 => QuadraticMap.IsometryEquiv.refl _
  | 4 => typeD4TrialityGlueAlphabetIsometry _

/-- The component rotation preserves the type of each component of the row. -/
theorem componentType_a5FourthD4ComponentRotation (i : Fin 5) :
    a5FourthD4.componentType (a5FourthD4ComponentRotation i) = a5FourthD4.componentType i := by
  fin_cases i <;> rfl

/-- **The corrected cyclic symmetry of the `A₅⁴ D₄` glue module**: rotate the
marked `A₅` positions and apply the discriminant action of `typeD4Triality` to `D₄`.
Both the half-norm and its polar pairing are preserved. -/
noncomputable def a5FourthD4GlueRotation :
    FiniteQuadraticModule.Isometry a5FourthD4.glueModule a5FourthD4.glueModule :=
  (piGlueAlphabetCongr a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
    a5FourthD4ComponentRotation componentType_a5FourthD4ComponentRotation).trans
      (QuadraticMap.IsometryEquiv.pi componentIsometry)

private theorem rotation_apply (w : a5FourthD4.glueModule) (i : Fin 5) :
    a5FourthD4GlueRotation w i = componentIsometry i
      (FiniteQuadraticModule.Isometry.ofEq
        (glueAlphabet_congr (componentType_a5FourthD4ComponentRotation i)
          (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentRotation i))
          (a5FourthD4.isSimplyLaced_componentType i))
        (w (a5FourthD4ComponentRotation i))) := by
  unfold a5FourthD4GlueRotation
  -- Apply the composition law as a term: rewriting cannot infer that the native index is Fin 5.
  exact (congrArg (fun v : a5FourthD4.glueModule ↦ v i)
    (QuadraticMap.IsometryEquiv.trans_apply _ _ w)).trans
    ((QuadraticMap.IsometryEquiv.pi_apply componentIsometry _ i).trans
      (congrArg (componentIsometry i) (piGlueAlphabetCongr_apply _ _ _ _ w i)))

-- On the A₅ coordinates only reindexing remains; keep the dependent transport explicit.
private theorem rotation_of_ne_four (w : a5FourthD4.glueModule) (i : Fin 5) (hi : i ≠ 4) :
    a5FourthD4GlueRotation w i = FiniteQuadraticModule.Isometry.ofEq
      (glueAlphabet_congr (componentType_a5FourthD4ComponentRotation i)
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentRotation i))
        (a5FourthD4.isSimplyLaced_componentType i))
      (w (a5FourthD4ComponentRotation i)) := by
  rw [rotation_apply]
  have h : componentIsometry i = QuadraticMap.IsometryEquiv.refl _ := by
    fin_cases i <;> first | rfl | exact (hi rfl).elim
  rw [h, QuadraticMap.IsometryEquiv.refl_apply]

private theorem rotation_eq (w : a5FourthD4.glueModule) {i j : Fin 5}
    (hij : a5FourthD4ComponentRotation i = j) :
    a5FourthD4GlueRotation w i = componentIsometry i
      (FiniteQuadraticModule.Isometry.ofEq (glueAlphabet_congr
        ((congrArg a5FourthD4.componentType hij).symm.trans
          (componentType_a5FourthD4ComponentRotation i))
        (a5FourthD4.isSimplyLaced_componentType j)
        (a5FourthD4.isSimplyLaced_componentType i)) (w j)) := by
  subst j
  exact rotation_apply w i

/-- The combined rotation fixes the unmarked `A₅` coordinate of the row. -/
theorem a5FourthD4GlueRotation_apply_zero (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation w (0 : Fin 5) = w (0 : Fin 5) := by
  rw [rotation_eq w a5FourthD4ComponentRotation_zero]
  simp only [componentIsometry, QuadraticMap.IsometryEquiv.refl_apply]
  exact (FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _)

/-- The first marked coordinate of the row reads the third. -/
theorem a5FourthD4GlueRotation_apply_one (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation w (1 : Fin 5) = w (3 : Fin 5) := by
  rw [rotation_eq w a5FourthD4ComponentRotation_one]
  simp only [componentIsometry, QuadraticMap.IsometryEquiv.refl_apply]
  exact (FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _)

/-- The second marked coordinate of the row reads the first. -/
theorem a5FourthD4GlueRotation_apply_two (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation w (2 : Fin 5) = w (1 : Fin 5) := by
  rw [rotation_eq w a5FourthD4ComponentRotation_two]
  simp only [componentIsometry, QuadraticMap.IsometryEquiv.refl_apply]
  exact (FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _)

/-- The third marked coordinate of the row reads the second. -/
theorem a5FourthD4GlueRotation_apply_three (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation w (3 : Fin 5) = w (2 : Fin 5) := by
  rw [rotation_eq w a5FourthD4ComponentRotation_three]
  simp only [componentIsometry, QuadraticMap.IsometryEquiv.refl_apply]
  exact (FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _)

/-- The `D₄` coordinate of the row undergoes glue-alphabet triality. -/
theorem a5FourthD4GlueRotation_apply_four (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation w (4 : Fin 5) =
      typeD4TrialityGlueAlphabetIsometry (isSimplyLaced_D 4) (w (4 : Fin 5)) := by
  rw [rotation_eq w a5FourthD4ComponentRotation_four]
  dsimp [componentIsometry]
  exact congrArg (typeD4TrialityGlueAlphabetIsometry _)
    ((FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _))

/-- On the row's `D₄` coordinate, the discriminant action is induced by root-lattice triality. -/
theorem glueAlphabetIsometry_a5FourthD4GlueRotation_apply_four (w : a5FourthD4.glueModule) :
    (D 4).glueAlphabetIsometry (by decide) (isSimplyLaced_D 4)
        (a5FourthD4GlueRotation w (4 : Fin 5)) =
      (typeD4Triality (isSimplyLaced_D 4)).discriminantGroupEquiv
        ((D 4).glueAlphabetIsometry (by decide) (isSimplyLaced_D 4) (w (4 : Fin 5))) := by
  rw [a5FourthD4GlueRotation_apply_four]
  exact glueAlphabetIsometry_typeD4TrialityGlueAlphabetIsometry _ _

/-- **The digit formula for the corrected rotation.** The four `A₅` digits
are read in order `[0,3,1,2]`, while the final digit undergoes triality. -/
theorem encodeGlueWord_a5FourthD4GlueRotation (w : a5FourthD4.glueModule) :
    encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
        (a5FourthD4GlueRotation w) =
      List.ofFn fun i : Fin 5 ↦ if i = 4 then
        (typeD4TrialityLabel (((a5FourthD4.componentType (4 : Fin 5)).glueLabelEquiv
          (a5FourthD4.isSimplyLaced_componentType (4 : Fin 5))).symm (w (4 : Fin 5)))).val
      else (((a5FourthD4.componentType (a5FourthD4ComponentRotation i)).glueLabelEquiv
        (a5FourthD4.isSimplyLaced_componentType (a5FourthD4ComponentRotation i))).symm
          (w (a5FourthD4ComponentRotation i))).val := by
  rw [encodeGlueWord_def]
  congr 1
  funext (i : Fin 5)
  by_cases hi : i = 4
  · subst i
    rw [a5FourthD4GlueRotation_apply_four, ite_eq_left rfl]
    exact congrArg Fin.val (glueLabelEquiv_symm_typeD4TrialityGlueAlphabetIsometry _ _)
  · rw [ite_eq_right hi, rotation_of_ne_four w i hi]
    exact val_glueLabelEquiv_symm_ofEq (componentType_a5FourthD4ComponentRotation i) _ _ _

/-- The combined symmetry has cube equal to the identity. -/
theorem a5FourthD4GlueRotation_apply_apply_apply (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation (a5FourthD4GlueRotation (a5FourthD4GlueRotation w)) = w := by
  funext i
  fin_cases i
  · exact (a5FourthD4GlueRotation_apply_zero _).trans
      ((a5FourthD4GlueRotation_apply_zero _).trans (a5FourthD4GlueRotation_apply_zero _))
  · exact (a5FourthD4GlueRotation_apply_one _).trans
      ((a5FourthD4GlueRotation_apply_three _).trans (a5FourthD4GlueRotation_apply_two _))
  · exact (a5FourthD4GlueRotation_apply_two _).trans
      ((a5FourthD4GlueRotation_apply_one _).trans (a5FourthD4GlueRotation_apply_three _))
  · exact (a5FourthD4GlueRotation_apply_three _).trans
      ((a5FourthD4GlueRotation_apply_two _).trans (a5FourthD4GlueRotation_apply_one _))
  · exact (a5FourthD4GlueRotation_apply_four _).trans
      ((congrArg (typeD4TrialityGlueAlphabetIsometry _)
        ((a5FourthD4GlueRotation_apply_four _).trans
          (congrArg (typeD4TrialityGlueAlphabetIsometry _)
            (a5FourthD4GlueRotation_apply_four w)))).trans
              (typeD4TrialityGlueAlphabetIsometry_apply_apply_apply _ _))

private def a5FourthD4WordSet : Finset (List ℕ) :=
  {[2, 0, 2, 4, 0], [2, 2, 4, 0, 0], [2, 4, 0, 2, 0],
    [3, 3, 0, 0, 1], [3, 0, 3, 0, 2], [3, 0, 0, 3, 3]}

/-- The combined symmetry permutes the actual decoded table generators. -/
theorem a5FourthD4GlueRotation_mem_glueGenerators_iff (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation w ∈ a5FourthD4.glueGenerators ↔
      w ∈ a5FourthD4.glueGenerators := by
  have hwords : a5FourthD4.glueWords = a5FourthD4WordSet := by decide
  have h (a b c d : ℕ) (e : Fin 4) :
      [a, d, b, c, (typeD4TrialityLabel e).val] ∈ a5FourthD4WordSet ↔
        [a, b, c, d, e.val] ∈ a5FourthD4WordSet := by
    fin_cases e <;> simp [a5FourthD4WordSet] <;> grind
  rw [mem_glueGenerators_iff, mem_glueGenerators_iff,
    encodeGlueWord_a5FourthD4GlueRotation, encodeGlueWord_def, hwords]
  let d (i : Fin 5) := (((a5FourthD4.componentType i).glueLabelEquiv
    (a5FourthD4.isSimplyLaced_componentType i)).symm (w i)).val
  let e : Fin 4 := ((a5FourthD4.componentType (4 : Fin 5)).glueLabelEquiv
    (a5FourthD4.isSimplyLaced_componentType (4 : Fin 5))).symm (w (4 : Fin 5))
  -- Package the scalar digits before simplifying indices: simp cannot transport the dependent
  -- alphabet and its label equivalence together. The native row length reduces to five here.
  change (List.ofFn fun i : Fin 5 ↦ if i = 4 then (typeD4TrialityLabel e).val
    else d (a5FourthD4ComponentRotation i)) ∈ a5FourthD4WordSet ↔
      List.ofFn d ∈ a5FourthD4WordSet
  simpa only [List.ofFn_succ, List.ofFn_zero, Fin.isValue, Fin.reduceSucc,
    a5FourthD4ComponentRotation_zero, a5FourthD4ComponentRotation_one,
    a5FourthD4ComponentRotation_two, a5FourthD4ComponentRotation_three,
    ite_true, ite_false, Fin.reduceEq] using h (d 0) (d 1) (d 2) (d 3) e

/-- **The combined rotation and triality preserves the generated glue subgroup**,
not merely the set of printed words. -/
theorem map_glueSubgroup_a5FourthD4GlueRotation :
    a5FourthD4.glueSubgroup.map
        (a5FourthD4GlueRotation : a5FourthD4.glueModule →+ a5FourthD4.glueModule) =
      a5FourthD4.glueSubgroup :=
  a5FourthD4.map_glueSubgroup_of_forall_mem a5FourthD4GlueRotation
    (fun w hw ↦ by
      rw [glueSubgroup_def]
      exact AddSubgroup.subset_closure ((a5FourthD4GlueRotation_mem_glueGenerators_iff w).mpr hw))

/-- Membership in the glue subgroup is invariant under the corrected rotation. -/
theorem a5FourthD4GlueRotation_mem_glueSubgroup_iff (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation w ∈ a5FourthD4.glueSubgroup ↔ w ∈ a5FourthD4.glueSubgroup :=
  a5FourthD4.apply_mem_glueSubgroup_iff_of_forall_mem a5FourthD4GlueRotation
    (fun v hv ↦ by
      rw [glueSubgroup_def]
      exact AddSubgroup.subset_closure ((a5FourthD4GlueRotation_mem_glueGenerators_iff v).mpr hv)) w

end TauCeti.RootfulNiemeierType
