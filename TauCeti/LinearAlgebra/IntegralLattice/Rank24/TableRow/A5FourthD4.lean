module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.Table
public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeD.Triality

/-!
# The cyclic glue symmetry of the mixed row `A₅⁴ D₄`

The rotation of the three marked `A₅` components in `[2(024)0]` does not by itself
preserve the glue subgroup of `A₅⁴ D₄`. It must be accompanied by triality on the
`D₄` alphabet: the labels are cycled `1 ↦ 2 ↦ 3 ↦ 1`. The combined operation reads
the components in order `[0,3,1,2,4]` and cycles the last label. It permutes the
three rotations of `[20240]` and also the other three generators `[33001]`,
`[30302]`, `[30033]`.

The isometry is assembled from component reindexing and the discriminant action
of `DynkinType.typeD4Triality`. It preserves the subgroup generated by the table
words and has cube equal to the identity. The component formulas in the displayed
glue coordinates describe the symmetry for lifting the combined rotation and
diagram triality to the glued lattice.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*,
  3rd ed., Chapter 4 §3 and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti.RootfulNiemeierType

open DynkinType IntegralLattice

private abbrev types : Fin 5 → DynkinType := ![A 5, A 5, A 5, A 5, D 4]

private theorem simplyLaced (i : Fin 5) : (types i).IsSimplyLaced := by
  fin_cases i <;> decide

private noncomputable abbrev words := FiniteQuadraticModule.pi fun i ↦
  (types i).glueAlphabet (simplyLaced i)

/-- The glue coordinates of `A₅⁴ D₄` in the displayed order, with four cyclic
alphabets followed by the `D₄` alphabet. -/
noncomputable def a5FourthD4GlueModuleIsometry :
    FiniteQuadraticModule.Isometry a5FourthD4.glueModule
      (FiniteQuadraticModule.pi fun i : Fin 5 ↦
        (![A 5, A 5, A 5, A 5, D 4] i).glueAlphabet (by fin_cases i <;> decide)) :=
  a5FourthD4.glueModuleIsometry simplyLaced rfl (fun i ↦ by fin_cases i <;> rfl)

/-- The displayed zero coordinate is the row's zero coordinate. -/
theorem a5FourthD4GlueModuleIsometry_zero (w : a5FourthD4.glueModule) :
    a5FourthD4GlueModuleIsometry w 0 = w (0 : Fin 5) := by
  exact (glueModuleIsometry_apply _ _ _ _ w (0 : Fin 5)).trans
    ((FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _))

/-- The displayed first coordinate is the row's first coordinate. -/
theorem a5FourthD4GlueModuleIsometry_one (w : a5FourthD4.glueModule) :
    a5FourthD4GlueModuleIsometry w 1 = w (1 : Fin 5) := by
  exact (glueModuleIsometry_apply _ _ _ _ w (1 : Fin 5)).trans
    ((FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _))

/-- The displayed second coordinate is the row's second coordinate. -/
theorem a5FourthD4GlueModuleIsometry_two (w : a5FourthD4.glueModule) :
    a5FourthD4GlueModuleIsometry w 2 = w (2 : Fin 5) := by
  exact (glueModuleIsometry_apply _ _ _ _ w (2 : Fin 5)).trans
    ((FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _))

/-- The displayed third coordinate is the row's third coordinate. -/
theorem a5FourthD4GlueModuleIsometry_three (w : a5FourthD4.glueModule) :
    a5FourthD4GlueModuleIsometry w 3 = w (3 : Fin 5) := by
  exact (glueModuleIsometry_apply _ _ _ _ w (3 : Fin 5)).trans
    ((FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _))

/-- The displayed fourth coordinate is the row's fourth coordinate. -/
theorem a5FourthD4GlueModuleIsometry_four (w : a5FourthD4.glueModule) :
    a5FourthD4GlueModuleIsometry w 4 = w (4 : Fin 5) := by
  exact (glueModuleIsometry_apply _ _ _ _ w (4 : Fin 5)).trans
    ((FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _))

/-- The explicit glue coordinates preserve the Conway--Sloane digit list. -/
@[simp]
theorem encodeGlueWord_a5FourthD4GlueModuleIsometry (w : a5FourthD4.glueModule) :
    encodeGlueWord (![A 5, A 5, A 5, A 5, D 4]) (fun i ↦ by fin_cases i <;> decide)
        (a5FourthD4GlueModuleIsometry w) =
      encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType w :=
  encodeGlueWord_glueModuleIsometry _ _ _ _ w

/-- The component reindexing `[0,3,1,2,4]` of the mixed row `A₅⁴ D₄`. -/
def a5FourthD4ComponentRotation : Equiv.Perm (Fin 5) where
  toFun := ![0, 3, 1, 2, 4]
  invFun := ![0, 2, 3, 1, 4]
  left_inv := by decide
  right_inv := by decide

/-- The component rotation reads positions in order `[0,3,1,2,4]`. -/
theorem a5FourthD4ComponentRotation_apply (i : Fin 5) :
    a5FourthD4ComponentRotation i = ![0, 3, 1, 2, 4] i := (rfl)

/-- The inverse component rotation reads positions in order `[0,2,3,1,4]`. -/
theorem a5FourthD4ComponentRotation_symm_apply (i : Fin 5) :
    a5FourthD4ComponentRotation.symm i = ![0, 2, 3, 1, 4] i := (rfl)

/-- The component rotation fixes position zero. -/
@[simp] theorem a5FourthD4ComponentRotation_zero : a5FourthD4ComponentRotation 0 = 0 := (rfl)

/-- The component rotation reads position three at position one. -/
@[simp] theorem a5FourthD4ComponentRotation_one : a5FourthD4ComponentRotation 1 = 3 := (rfl)

/-- The component rotation reads position one at position two. -/
@[simp] theorem a5FourthD4ComponentRotation_two : a5FourthD4ComponentRotation 2 = 1 := (rfl)

/-- The component rotation reads position two at position three. -/
@[simp] theorem a5FourthD4ComponentRotation_three : a5FourthD4ComponentRotation 3 = 2 := (rfl)

/-- The component rotation fixes position four. -/
@[simp] theorem a5FourthD4ComponentRotation_four : a5FourthD4ComponentRotation 4 = 4 := (rfl)

/-- The inverse component rotation fixes position zero. -/
@[simp] theorem a5FourthD4ComponentRotation_symm_zero :
    a5FourthD4ComponentRotation.symm 0 = 0 := (rfl)

/-- The inverse component rotation reads position two at position one. -/
@[simp] theorem a5FourthD4ComponentRotation_symm_one :
    a5FourthD4ComponentRotation.symm 1 = 2 := (rfl)

/-- The inverse component rotation reads position three at position two. -/
@[simp] theorem a5FourthD4ComponentRotation_symm_two :
    a5FourthD4ComponentRotation.symm 2 = 3 := (rfl)

/-- The inverse component rotation reads position one at position three. -/
@[simp] theorem a5FourthD4ComponentRotation_symm_three :
    a5FourthD4ComponentRotation.symm 3 = 1 := (rfl)

/-- The inverse component rotation fixes position four. -/
@[simp] theorem a5FourthD4ComponentRotation_symm_four :
    a5FourthD4ComponentRotation.symm 4 = 4 := (rfl)

/-- The component rotation has cube equal to the identity. -/
@[simp] theorem a5FourthD4ComponentRotation_pow_three :
    a5FourthD4ComponentRotation ^ 3 = 1 := by decide

/-- Applying the component rotation three times fixes every position. -/
@[simp] theorem a5FourthD4ComponentRotation_apply_apply_apply (i : Fin 5) :
    a5FourthD4ComponentRotation
      (a5FourthD4ComponentRotation (a5FourthD4ComponentRotation i)) = i := by
  fin_cases i <;> simp

private noncomputable def componentIsometry (i : Fin 5) :
    FiniteQuadraticModule.Isometry ((types i).glueAlphabet (simplyLaced i))
      ((types i).glueAlphabet (simplyLaced i)) :=
  match i with
  | 0 => QuadraticMap.IsometryEquiv.refl _
  | 1 => QuadraticMap.IsometryEquiv.refl _
  | 2 => QuadraticMap.IsometryEquiv.refl _
  | 3 => QuadraticMap.IsometryEquiv.refl _
  | 4 => typeD4TrialityGlueAlphabetIsometry _

private theorem types_rotation (i : Fin 5) : types (a5FourthD4ComponentRotation i) = types i := by
  fin_cases i <;> rfl

private noncomputable def rotation : FiniteQuadraticModule.Isometry words words :=
  (piGlueAlphabetCongr types simplyLaced a5FourthD4ComponentRotation types_rotation).trans
    (QuadraticMap.IsometryEquiv.pi componentIsometry)

private theorem rotation_apply (w : words) (i : Fin 5) :
    rotation w i = componentIsometry i
      (FiniteQuadraticModule.Isometry.ofEq (glueAlphabet_congr (types_rotation i)
        (simplyLaced (a5FourthD4ComponentRotation i)) (simplyLaced i))
          (w (a5FourthD4ComponentRotation i))) := by
  -- The product isometry acts coordinatewise by definition; isolate that reduction here.
  exact congrArg (componentIsometry i) (piGlueAlphabetCongr_apply _ _ _ _ w i)

/-- **The corrected cyclic symmetry of the `A₅⁴ D₄` glue module**: rotate the
marked `A₅` positions and apply the discriminant action of `typeD4Triality` to `D₄`.
Both the half-norm and its polar pairing are preserved. -/
noncomputable def a5FourthD4GlueRotation :
    FiniteQuadraticModule.Isometry a5FourthD4.glueModule a5FourthD4.glueModule :=
  a5FourthD4GlueModuleIsometry.trans (rotation.trans a5FourthD4GlueModuleIsometry.symm)

private theorem coordinates_rotation (w : a5FourthD4.glueModule) :
    a5FourthD4GlueModuleIsometry (a5FourthD4GlueRotation w) =
      rotation (a5FourthD4GlueModuleIsometry w) :=
  a5FourthD4GlueModuleIsometry.apply_symm_apply _

-- On the A₅ coordinates only reindexing remains; keep the dependent transport explicit.
private theorem rotation_of_ne_four (w : words) (i : Fin 5) (hi : i ≠ 4) :
    rotation w i = FiniteQuadraticModule.Isometry.ofEq
      (glueAlphabet_congr (types_rotation i)
        (simplyLaced (a5FourthD4ComponentRotation i)) (simplyLaced i))
      (w (a5FourthD4ComponentRotation i)) := by
  rw [rotation_apply]
  have h : componentIsometry i = QuadraticMap.IsometryEquiv.refl _ := by
    fin_cases i <;> first | rfl | exact (hi rfl).elim
  rw [h]
  -- The identity isometry has the identity underlying function.
  rfl

private theorem rotation_four (w : words) :
    rotation w 4 = typeD4TrialityGlueAlphabetIsometry _ (w 4) :=
  (rotation_apply w 4).trans (by
    dsimp [componentIsometry, a5FourthD4ComponentRotation]
    exact congrArg (typeD4TrialityGlueAlphabetIsometry _)
      ((FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _)))

/-- In displayed coordinates the unmarked `A₅` component is fixed. -/
@[simp]
theorem a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_zero (w : a5FourthD4.glueModule) :
    a5FourthD4GlueModuleIsometry (a5FourthD4GlueRotation w) 0 =
      a5FourthD4GlueModuleIsometry w 0 := by
  rw [coordinates_rotation]
  exact (rotation_of_ne_four _ _ (by decide)).trans
    ((FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _))

/-- In displayed coordinates the first marked component reads the third. -/
@[simp]
theorem a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_one (w : a5FourthD4.glueModule) :
    a5FourthD4GlueModuleIsometry (a5FourthD4GlueRotation w) 1 =
      a5FourthD4GlueModuleIsometry w 3 := by
  rw [coordinates_rotation]
  exact (rotation_of_ne_four _ _ (by decide)).trans
    ((FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _))

/-- In displayed coordinates the second marked component reads the first. -/
@[simp]
theorem a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_two (w : a5FourthD4.glueModule) :
    a5FourthD4GlueModuleIsometry (a5FourthD4GlueRotation w) 2 =
      a5FourthD4GlueModuleIsometry w 1 := by
  rw [coordinates_rotation]
  exact (rotation_of_ne_four _ _ (by decide)).trans
    ((FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _))

/-- In displayed coordinates the third marked component reads the second. -/
@[simp]
theorem a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_three (w : a5FourthD4.glueModule) :
    a5FourthD4GlueModuleIsometry (a5FourthD4GlueRotation w) 3 =
      a5FourthD4GlueModuleIsometry w 2 := by
  rw [coordinates_rotation]
  exact (rotation_of_ne_four _ _ (by decide)).trans
    ((FiniteQuadraticModule.Isometry.ofEq_apply _ _).trans (cast_eq _ _))

/-- In displayed coordinates the `D₄` component undergoes glue-alphabet triality. -/
@[simp]
theorem a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_four
    (w : a5FourthD4.glueModule) :
    a5FourthD4GlueModuleIsometry (a5FourthD4GlueRotation w) 4 =
      typeD4TrialityGlueAlphabetIsometry (isSimplyLaced_D 4)
        (a5FourthD4GlueModuleIsometry w 4) := by
  rw [coordinates_rotation, rotation_four]

/-- The last component's discriminant action is induced by root-lattice triality. -/
theorem glueAlphabetIsometry_a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_four
    (w : a5FourthD4.glueModule) :
    (D 4).glueAlphabetIsometry (by decide) (isSimplyLaced_D 4)
        (a5FourthD4GlueModuleIsometry (a5FourthD4GlueRotation w) 4) =
      (typeD4Triality (isSimplyLaced_D 4)).discriminantGroupEquiv
        ((D 4).glueAlphabetIsometry (by decide) (isSimplyLaced_D 4)
          (a5FourthD4GlueModuleIsometry w 4)) := by
  rw [a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_four]
  exact glueAlphabetIsometry_typeD4TrialityGlueAlphabetIsometry _ _

private def rotatedDigits (d : ∀ i : Fin 5, Fin (types i).glueLabelCount) : List ℕ :=
  List.ofFn fun i ↦ if i = 4 then (typeD4TrialityLabel (d 4)).val
    else (d (a5FourthD4ComponentRotation i)).val

private theorem encode_rotation (w : words) :
    encodeGlueWord types simplyLaced (rotation w) =
      rotatedDigits (fun i ↦ ((types i).glueLabelEquiv (simplyLaced i)).symm (w i)) := by
  rw [encodeGlueWord_def]
  unfold rotatedDigits
  congr 1
  funext i
  by_cases hi : i = 4
  · subst i
    exact congrArg Fin.val
      ((congrArg ((D 4).glueLabelEquiv (isSimplyLaced_D 4)).symm (rotation_four w)).trans
        (glueLabelEquiv_symm_typeD4TrialityGlueAlphabetIsometry _ _))
  · rw [ite_eq_right hi, rotation_of_ne_four w i hi]
    exact val_glueLabelEquiv_symm_ofEq (types_rotation i) _ _ _

/-- **The digit formula for the corrected rotation.** The four `A₅` digits
are read in order `[0,3,1,2]`, while the final digit undergoes triality. -/
theorem encodeGlueWord_a5FourthD4GlueRotation (w : a5FourthD4.glueModule) :
    encodeGlueWord a5FourthD4.componentType a5FourthD4.isSimplyLaced_componentType
        (a5FourthD4GlueRotation w) =
      List.ofFn fun i : Fin 5 ↦ if i = 4 then
        (typeD4TrialityLabel (((D 4).glueLabelEquiv (isSimplyLaced_D 4)).symm
          (a5FourthD4GlueModuleIsometry w 4))).val
      else (((![A 5, A 5, A 5, A 5, D 4] (a5FourthD4ComponentRotation i)).glueLabelEquiv
        (by fin_cases i <;> decide)).symm
          (a5FourthD4GlueModuleIsometry w (a5FourthD4ComponentRotation i))).val := by
  rw [← encodeGlueWord_a5FourthD4GlueModuleIsometry, coordinates_rotation, encode_rotation]
  unfold rotatedDigits
  rfl

/-- The combined symmetry has cube equal to the identity. -/
@[simp]
theorem a5FourthD4GlueRotation_apply_apply_apply (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation (a5FourthD4GlueRotation (a5FourthD4GlueRotation w)) = w := by
  apply EquivLike.injective a5FourthD4GlueModuleIsometry
  funext i
  fin_cases i
  · exact (a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_zero _).trans
      ((a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_zero _).trans
        (a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_zero _))
  · exact (a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_one _).trans
      ((a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_three _).trans
        (a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_two _))
  · exact (a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_two _).trans
      ((a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_one _).trans
        (a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_three _))
  · exact (a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_three _).trans
      ((a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_two _).trans
        (a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_one _))
  · exact (a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_four _).trans
      ((congrArg (typeD4TrialityGlueAlphabetIsometry _)
        ((a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_four _).trans
          (congrArg (typeD4TrialityGlueAlphabetIsometry _)
            (a5FourthD4GlueModuleIsometry_a5FourthD4GlueRotation_four w)))).trans
              (typeD4TrialityGlueAlphabetIsometry_apply_apply_apply _ _))

private def a5FourthD4WordSet : Finset (List ℕ) :=
  {[2, 0, 2, 4, 0], [2, 2, 4, 0, 0], [2, 4, 0, 2, 0],
    [3, 3, 0, 0, 1], [3, 0, 3, 0, 2], [3, 0, 0, 3, 3]}

private theorem rotation_mem_generators (w : words) :
    encodeGlueWord types simplyLaced (rotation w) ∈ a5FourthD4.glueWords ↔
      encodeGlueWord types simplyLaced w ∈ a5FourthD4.glueWords := by
  have hwords : a5FourthD4.glueWords = a5FourthD4WordSet := by decide
  obtain ⟨d, hd⟩ := (Equiv.piCongrRight fun i ↦
    (types i).glueLabelEquiv (simplyLaced i)).surjective w
  have he : w = fun i ↦ (types i).glueLabelEquiv _ (d i) := hd.symm
  rw [encode_rotation, hwords, he, encodeGlueWord_glueLabelEquiv]
  -- Splitting the dependent tuple keeps the finite kernel computation shallow.
  have h (a b c d : Fin 6) (e : Fin 4) :
      [a.val, d.val, b.val, c.val, (typeD4TrialityLabel e).val] ∈ a5FourthD4WordSet ↔
        [a.val, b.val, c.val, d.val, e.val] ∈ a5FourthD4WordSet := by
    simp only [typeD4TrialityLabel_apply]
    revert a b c d e
    decide +kernel
  have hc : (fun i ↦ ((types i).glueLabelEquiv (simplyLaced i)).symm
      ((types i).glueLabelEquiv (simplyLaced i) (d i))) = d :=
    funext fun i ↦ ((types i).glueLabelEquiv (simplyLaced i)).symm_apply_apply (d i)
  rw [hc]
  exact h (d 0) (d 1) (d 2) (d 3) (d 4)

/-- The combined symmetry permutes the actual decoded table generators. -/
@[simp]
theorem a5FourthD4GlueRotation_mem_glueGenerators_iff (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation w ∈ a5FourthD4.glueGenerators ↔
      w ∈ a5FourthD4.glueGenerators := by
  rw [mem_glueGenerators_iff, mem_glueGenerators_iff,
    ← encodeGlueWord_a5FourthD4GlueModuleIsometry, ← encodeGlueWord_a5FourthD4GlueModuleIsometry,
    coordinates_rotation]
  exact rotation_mem_generators _

/-- **The combined rotation and triality preserves the generated glue subgroup**,
not merely the set of printed words. -/
theorem map_glueSubgroup_a5FourthD4GlueRotation :
    a5FourthD4.glueSubgroup.map
        (a5FourthD4GlueRotation : a5FourthD4.glueModule →+ a5FourthD4.glueModule) =
      a5FourthD4.glueSubgroup :=
  a5FourthD4.map_glueSubgroup_of_apply_mem_glueGenerators_iff a5FourthD4GlueRotation
    a5FourthD4GlueRotation_mem_glueGenerators_iff

/-- Membership in the glue subgroup is invariant under the corrected rotation. -/
@[simp]
theorem a5FourthD4GlueRotation_mem_glueSubgroup_iff (w : a5FourthD4.glueModule) :
    a5FourthD4GlueRotation w ∈ a5FourthD4.glueSubgroup ↔ w ∈ a5FourthD4.glueSubgroup :=
  a5FourthD4.apply_mem_glueSubgroup_iff_of_apply_mem_glueGenerators_iff a5FourthD4GlueRotation
    a5FourthD4GlueRotation_mem_glueGenerators_iff w

end TauCeti.RootfulNiemeierType
