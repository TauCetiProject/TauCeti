module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.EnumeratedRows
public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.GlueAlphabet.Roots

/-!
# The rootful rank-24 lattices glued from the table

For each of the 23 rows `r` of `TauCeti.RootfulNiemeierType`, let `R_r` be the orthogonal sum of
the root lattices of the row's ordered ADE components and `H_r = r.glueSubgroup` its glue subgroup,
generated by the decoded Conway--Sloane glue words.  Since `H_r` is quadratically isotropic
(`TauCeti.RootfulNiemeierType.isIsotropic_glueSubgroup`), the isotropic gluing
`TauCeti.DynkinType.gluedLattice` produces the overlattice

`N_r = r.lattice`,

defined once for all rows from the table data.  Its carrier is the inverse image of `H_r` in the
dual of `R_r`, written in glue-word coordinates (`mem_lattice_carrier_iff`), and it contains `R_r`
with index `|H_r|`.  Since `H_r` is generated by the decoded table words, `N_r` is spanned by `R_r`
and one dual representative of each of these words (`lattice_carrier_eq_sup_span`); the
representatives can be chosen to be shortest vectors of their cosets, of norm `μ(w)`
(`exists_lattice_carrier_eq_sup_span_glueMinimum`).

Uniformly in the row, `N_r` is even, positive definite and of rank `24`, and it is unimodular
exactly when `H_r` has the displayed order `|H|`, since `|H|² = |A_R|`.

The finite checks of the table then specialize these statements.  For the 19 rows whose glue
subgroup is enumerated in `TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.EnumeratedRows`, that
is all rows other than `A₁²⁴`, `A₂¹²`, `D₄⁶` and `A₁₁ D₇ E₆`, the glue subgroup has order `|H|`, so
`N_r` is unimodular, and every nonzero glue word has minimum norm at least `4`.  By the
coset-minimum theorem, `N_r` then has exactly the norm-`2` vectors of `R_r`, and its root
sublattice is literally the carrier of `R_r`.  This root-system statement is derived from the
glue minima, not from evenness, unimodularity or a root count.

## Main declarations

* `TauCeti.RootfulNiemeierType.rootLattice`: the orthogonal sum `R_r` of the component root
  lattices of a row.
* `TauCeti.RootfulNiemeierType.lattice`: the lattice `N_r` glued from `R_r` along `H_r`, with
  `TauCeti.RootfulNiemeierType.lattice_eq_rootLattice_iff_glueSubgroup_eq_bot`.
* `TauCeti.RootfulNiemeierType.mem_lattice_carrier_iff`: the carrier of `N_r`.
* `TauCeti.RootfulNiemeierType.lattice_carrier_eq_sup_span`,
  `TauCeti.RootfulNiemeierType.exists_lattice_carrier_eq_sup_span_glueMinimum`: `N_r` is spanned
  by `R_r` and representatives, possibly shortest ones, of the glue generators.
* `TauCeti.RootfulNiemeierType.isEven_lattice`, `isPosDef_lattice`, `finrank_lattice`.
* `TauCeti.RootfulNiemeierType.isUnimodular_lattice_iff`: `N_r` is unimodular exactly when
  `|H_r| = |H|`.
* `TauCeti.RootfulNiemeierType.isUnimodular_lattice_of_ne`,
  `TauCeti.RootfulNiemeierType.image_vectorsOfNorm_two_lattice_of_ne`,
  `TauCeti.RootfulNiemeierType.span_vectorsOfNorm_two_lattice_of_ne`: unimodularity, the norm-`2`
  vectors and the root sublattice for the enumerated rows.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4
  §§3 and 6, and Chapter 16 §1, Table 16.1.
* J. H. Conway and N. J. A. Sloane, *On the enumeration of lattices of determinant one*,
  Journal of Number Theory 15 (1982), Table V.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open IntegralLattice

/-! ### The root lattice and the glued lattice of a row -/

/-- **The root lattice `R_r` of a row**: the orthogonal sum of the root lattices of its ordered
ADE components. -/
noncomputable abbrev rootLattice (r : RootfulNiemeierType) :
    IntegralLattice (∀ i, Fin (r.componentType i).rank → ℚ) :=
  pi fun i ↦ (r.componentType i).rootLattice (r.isSimplyLaced_componentType i)

/-- **The lattice `N_r` of a row of the rootful rank-24 table**: the even overlattice of the
orthogonal sum `R_r` of the component root lattices glued along the glue subgroup `H_r`, which is
generated by the decoded Conway--Sloane glue words of the row. -/
noncomputable def lattice (r : RootfulNiemeierType) :
    IntegralLattice (∀ i, Fin (r.componentType i).rank → ℚ) :=
  DynkinType.gluedLattice r.componentType r.isSimplyLaced_componentType r.valid_componentType
    r.glueSubgroup r.isIsotropic_glueSubgroup

/-- The lattice of a row is the glued lattice of its components along its glue subgroup. -/
theorem lattice_def (r : RootfulNiemeierType) :
    r.lattice = DynkinType.gluedLattice r.componentType r.isSimplyLaced_componentType
      r.valid_componentType r.glueSubgroup r.isIsotropic_glueSubgroup :=
  (rfl)

/-- The form of `N_r` is the form of the orthogonal sum `R_r`. -/
@[simp]
theorem lattice_form (r : RootfulNiemeierType) : r.lattice.form = r.rootLattice.form :=
  DynkinType.gluedLattice_form _ _ _ _ _

/-- The lattice of a row coincides with its component root lattice if and only if its glue
subgroup is trivial. -/
theorem lattice_eq_rootLattice_iff_glueSubgroup_eq_bot (r : RootfulNiemeierType) :
    r.lattice = r.rootLattice ↔ r.glueSubgroup = ⊥ := by
  -- `r.rootLattice` is `abbrev` for the `pi` lattice that `gluedLattice_def` glues over.
  rw [lattice_def, DynkinType.gluedLattice_def]
  exact (r.rootLattice.ofIsotropicSubgroup_eq_self_iff _ _ _).trans
    (AddSubgroup.map_eq_bot_iff_of_injective r.glueSubgroup
      (DynkinType.glueWordIsometry r.componentType r.isSimplyLaced_componentType
        r.valid_componentType).toAddEquiv.injective)

/-- **The carrier of `N_r`**: a vector lies in `N_r` exactly when it lies in the dual of `R_r` and
the glue word of its discriminant class lies in the glue subgroup `H_r`. -/
theorem mem_lattice_carrier_iff (r : RootfulNiemeierType)
    (x : ∀ i, Fin (r.componentType i).rank → ℚ) :
    x ∈ r.lattice.carrier ↔ ∃ hx : x ∈ r.rootLattice.dualCarrier,
      (DynkinType.glueWordIsometry r.componentType r.isSimplyLaced_componentType
          r.valid_componentType).toAddEquiv.symm (Submodule.Quotient.mk ⟨x, hx⟩) ∈
        r.glueSubgroup :=
  DynkinType.mem_gluedLattice_carrier_iff _ _ _ _ _ x

/-- The root lattice `R_r` is a sublattice of `N_r`. -/
theorem rootLattice_carrier_le_lattice_carrier (r : RootfulNiemeierType) :
    r.rootLattice.carrier ≤ r.lattice.carrier :=
  DynkinType.carrier_le_gluedLattice_carrier _ _ _ _ _

/-- **`R_r` has index `|H_r|` in `N_r`.** -/
theorem relIndex_rootLattice_lattice (r : RootfulNiemeierType) :
    r.rootLattice.carrier.toAddSubgroup.relIndex r.lattice.carrier.toAddSubgroup =
      Nat.card r.glueSubgroup :=
  DynkinType.relIndex_gluedLattice _ _ _ _ _

/-- **Generators of `N_r`**: if, for each glue generator `w` of the row, `rep w` is a dual vector
of `R_r` in the coset named by `w`, then `N_r` is spanned by `R_r` and the vectors `rep w`. -/
theorem lattice_carrier_eq_sup_span (r : RootfulNiemeierType)
    (rep : r.glueModule → r.rootLattice.dualCarrier)
    (hrep : ∀ w ∈ r.glueGenerators, Submodule.Quotient.mk (rep w) =
      DynkinType.glueWordIsometry r.componentType r.isSimplyLaced_componentType
        r.valid_componentType w) :
    r.lattice.carrier = r.rootLattice.carrier ⊔ Submodule.span ℤ
      ((fun w ↦ (rep w : ∀ i, Fin (r.componentType i).rank → ℚ)) '' r.glueGenerators) :=
  DynkinType.gluedLattice_carrier_eq_sup_span _ _ _ _ _ (glueSubgroup_def r).symm rep hrep

/-- **`N_r` is spanned by `R_r` and shortest glue vectors**: there is a choice, for every glue word
`w`, of a dual vector of `R_r` in the coset named by `w` whose norm is the shortest norm `μ(w)` of
that coset, the sum of the shortest norms of the labels of `w`; and `N_r` is spanned by `R_r`
together with the chosen vectors of the glue generators of the row. -/
theorem exists_lattice_carrier_eq_sup_span_glueMinimum (r : RootfulNiemeierType) :
    ∃ rep : r.glueModule → r.rootLattice.dualCarrier,
      (∀ w, Submodule.Quotient.mk (rep w) =
          DynkinType.glueWordIsometry r.componentType r.isSimplyLaced_componentType
            r.valid_componentType w ∧
        r.rootLattice.form (rep w) (rep w) =
          ∑ i, (r.componentType i).glueMinimum (r.isSimplyLaced_componentType i) (w i)) ∧
      r.lattice.carrier = r.rootLattice.carrier ⊔ Submodule.span ℤ
        ((fun w ↦ (rep w : ∀ i, Fin (r.componentType i).rank → ℚ)) '' r.glueGenerators) := by
  choose rep hrep hform using fun w ↦ (DynkinType.isLeast_sum_glueMinimum r.componentType
    r.valid_componentType r.isSimplyLaced_componentType w).1
  exact ⟨rep, fun w ↦ ⟨hrep w, hform w⟩, r.lattice_carrier_eq_sup_span rep fun w _ ↦ hrep w⟩

/-- The lattice of a row is nondegenerate. -/
instance isNondegenerate_lattice (r : RootfulNiemeierType) : r.lattice.IsNondegenerate :=
  DynkinType.isNondegenerate_gluedLattice _ _ _ _ _

/-- **The lattice of every row is even.** -/
theorem isEven_lattice (r : RootfulNiemeierType) : r.lattice.IsEven :=
  DynkinType.isEven_gluedLattice _ _ _ _ _

/-- **The lattice of every row is positive definite.** -/
theorem isPosDef_lattice (r : RootfulNiemeierType) : r.lattice.IsPosDef :=
  DynkinType.isPosDef_gluedLattice _ _ _ _ _

/-- **The lattice of every row has rank `24`**, the total rank of the row's components. -/
@[simp]
theorem finrank_lattice (r : RootfulNiemeierType) : Module.finrank ℤ r.lattice = 24 := by
  rw [lattice_def, DynkinType.finrank_gluedLattice]
  cases r <;> decide

/-- **The lattice of a row is unimodular exactly when its glue subgroup has the displayed order
`|H|`.**  This is the gluing criterion `|H_r|² = |A_R|` combined with `|H|² = |A_R|`. -/
theorem isUnimodular_lattice_iff (r : RootfulNiemeierType) :
    r.lattice.IsUnimodular ↔ Nat.card r.glueSubgroup = r.glueOrder := by
  rw [lattice_def, DynkinType.isUnimodular_gluedLattice_iff_natCard_sq_eq,
    ← glueOrder_sq_eq_natCard_glueModule]
  exact (Nat.pow_left_injective two_ne_zero).eq_iff

/-! ### The enumerated rows -/

/-- **The lattice is unimodular** for every row other than `A₁²⁴`, `A₂¹²`, `D₄⁶` and
`A₁₁ D₇ E₆`. -/
theorem isUnimodular_lattice_of_ne (r : RootfulNiemeierType) (h₁ : r ≠ .a1TwentyFourth)
    (h₂ : r ≠ .a2Twelfth) (h₃ : r ≠ .d4Sixth) (h₄ : r ≠ .a11d7e6) :
    r.lattice.IsUnimodular :=
  (isUnimodular_lattice_iff r).mpr (natCard_glueSubgroup_of_ne r h₁ h₂ h₃ h₄)

/-- **Gluing adds no roots**: for every row other than `A₁²⁴`, `A₂¹²`, `D₄⁶` and `A₁₁ D₇ E₆`, the
norm-`2` vectors of `N_r` are exactly the norm-`2` vectors of `R_r`, compared in the common
ambient space.  In particular every norm-`2` vector of `N_r` lies in `R_r`. -/
theorem image_vectorsOfNorm_two_lattice_of_ne (r : RootfulNiemeierType)
    (h₁ : r ≠ .a1TwentyFourth) (h₂ : r ≠ .a2Twelfth) (h₃ : r ≠ .d4Sixth) (h₄ : r ≠ .a11d7e6) :
    (fun x : r.lattice ↦ (x : ∀ i, Fin (r.componentType i).rank → ℚ)) ''
        r.lattice.vectorsOfNorm 2 =
      (fun x : r.rootLattice ↦ (x : ∀ i, Fin (r.componentType i).rank → ℚ)) ''
        r.rootLattice.vectorsOfNorm 2 :=
  DynkinType.image_vectorsOfNorm_gluedLattice_eq _ _ r.valid_componentType _ _
    (fun _ hw hw0 ↦ four_le_sum_glueMinimum_of_mem_glueSubgroup_of_ne r h₁ h₂ h₃ h₄ hw hw0)
    (by norm_num)

/-- **The root sublattice of `N_r` is `R_r`**: for every row other than `A₁²⁴`, `A₂¹²`, `D₄⁶` and
`A₁₁ D₇ E₆`, the norm-`2` vectors of `N_r` span exactly the carrier of the orthogonal sum of the
component root lattices. -/
theorem span_vectorsOfNorm_two_lattice_of_ne (r : RootfulNiemeierType)
    (h₁ : r ≠ .a1TwentyFourth) (h₂ : r ≠ .a2Twelfth) (h₃ : r ≠ .d4Sixth) (h₄ : r ≠ .a11d7e6) :
    Submodule.span ℤ ((fun x : r.lattice ↦ (x : ∀ i, Fin (r.componentType i).rank → ℚ)) ''
        r.lattice.vectorsOfNorm 2) = r.rootLattice.carrier :=
  DynkinType.span_vectorsOfNorm_two_gluedLattice _ _ r.valid_componentType _ _
    (fun _ hw hw0 ↦ four_le_sum_glueMinimum_of_mem_glueSubgroup_of_ne r h₁ h₂ h₃ h₄ hw hw0)
    (by norm_num)

end RootfulNiemeierType

end TauCeti
