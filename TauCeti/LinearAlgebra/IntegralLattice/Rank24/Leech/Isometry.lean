module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Leech.MinimalVectors
public import TauCeti.LinearAlgebra.IntegralLattice.Isometry.NormShell
public import TauCeti.LinearAlgebra.IntegralLattice.Isometry.AntipodalPairs

/-!
# The minimal-vector and antipodal-pair actions of the Leech isometry group

The full lattice isometry group acts faithfully on the 196560 minimal vectors, since they
span the rational ambient space by `TauCeti.span_vectorsOfNorm_four_leechLattice`.
This gives a faithful permutation representation of the group usually denoted `Co₀`, without
assuming that any proposed list of Conway generators generates all lattice isometries.
Finiteness of the group already follows from the general positive-definite lattice API.
On antipodal pairs, exactly identity and negation act trivially. The first-family minimal
vectors `2(e₀ + eᵢ)` for `i ≠ 0`, together with `2(e₀ - e₁)`, span the rational coordinate
space and all pair nontrivially with `2(e₀ + e₂)`. Preservation of the form forces their signs
to agree. Thus the pair-action kernel is the subgroup generated by negation, allowing the
Conway quotient `Co₁` to act faithfully.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, Chapter 10.
* R. A. Wilson, *The Finite Simple Groups*, §5.4.
-/

public section

namespace TauCeti

/-- The full Leech isometry group's action on the norm-four vectors is faithful. -/
theorem normShellHom_leechLattice_injective :
    Function.Injective (IntegralLattice.Isometry.normShellHom leechLattice 4) :=
  IntegralLattice.Isometry.normShellHom_injective 4 span_vectorsOfNorm_four_leechLattice

/-- The full Leech lattice isometry group is finite, since the lattice is positive definite. -/
instance instFiniteIsometryLeechLattice :
    Finite (IntegralLattice.Isometry leechLattice leechLattice) :=
  isPosDef_leechLattice.finite_isometry

open IntegralLattice

private def pair (i : Fin 24) (t : ℤˣ) : Fin 24 → ℚ :=
  fun k ↦ (leechPairVector 0 i 1 t k : ℚ) / 2

private theorem pair_minimal {i : Fin 24} (hi : i ≠ 0) (t : ℤˣ) :
    ∃ x ∈ leechLattice.vectorsOfNorm 4, (x : Fin 24 → ℚ) = pair i t := by
  obtain ⟨hmem, hnorm⟩ := leechPairVector_mem hi.symm 1 t
  refine ⟨⟨_, hmem⟩, ?_, rfl⟩
  rw [mem_vectorsOfNorm, leechLattice_norm_intCast_div_two, hnorm]
  norm_num

private def spanningPairs : Set (Fin 24 → ℚ) :=
  {v | (∃ i ≠ 0, v = pair i 1) ∨ v = pair 1 (-1)}

private theorem span_spanningPairs : Submodule.span ℚ spanningPairs = ⊤ := by
  let S := Submodule.span ℚ spanningPairs
  have hplus (i : Fin 24) (hi : i ≠ 0) : pair i 1 ∈ S :=
    Submodule.subset_span (Or.inl ⟨i, hi, rfl⟩)
  have hminus : pair 1 (-1) ∈ S := Submodule.subset_span (Or.inr rfl)
  have hzero : Pi.single (0 : Fin 24) (1 : ℚ) ∈ S := by
    have h := S.smul_mem (1 / 4 : ℚ) (S.add_mem (hplus 1 (by decide)) hminus)
    convert h using 1
    ext k
    by_cases hk : k = 0 <;> by_cases hk' : k = 1 <;>
      norm_num [pair, leechPairVector_apply, hk, hk']
  have hsingle (i : Fin 24) : Pi.single i (1 : ℚ) ∈ S := by
    by_cases hi : i = 0
    · simpa [hi] using hzero
    · have h := S.sub_mem (S.smul_mem (1 / 2 : ℚ) (hplus i hi)) hzero
      convert h using 1
      ext k
      by_cases hk : k = 0 <;> by_cases hk' : k = i <;>
        norm_num [pair, leechPairVector_apply, hk, hk', hi, Ne.symm hi]
  apply top_unique
  intro x _
  rw [pi_eq_sum_univ' x]
  exact S.sum_mem fun i _ ↦ S.smul_mem (x i) (hsingle i)

private theorem pair_pairing {i : Fin 24} (hi : i ≠ 0) (t : ℤˣ) :
    leechLattice.form (pair i t) (pair 2 1) =
      2 + if i = 2 then 2 * (t : ℚ) else 0 := by
  rw [leechLattice_form, ConstructionA.form_apply, dotProduct]
  rw [Fintype.sum_eq_add (0 : Fin 24) 2 (by decide) (fun k hk ↦ ?_)]
  · by_cases hi2 : i = 2
    · subst i
      norm_num [pair, leechPairVector_apply]
      ring
    · norm_num [pair, leechPairVector_apply, hi2, Ne.symm hi2]
  · simp [pair, leechPairVector_apply, hk.1, hk.2]

/-- An isometry fixes all antipodal pairs of Leech minimal vectors if and only if it is
identity or negation. -/
theorem mem_ker_antipodalPairsHom_leechLattice_iff
    (e : Isometry leechLattice leechLattice) :
    e ∈ (Isometry.antipodalPairsHom leechLattice 4).ker ↔
      e = 1 ∨ e = Isometry.neg leechLattice := by
  constructor
  · intro he
    have hsign {i : Fin 24} (hi : i ≠ 0) (t : ℤˣ) :
        e (pair i t) = pair i t ∨ e (pair i t) = -pair i t := by
      obtain ⟨x, hx, hxe⟩ := pair_minimal hi t
      simpa only [hxe] using (Isometry.mem_ker_antipodalPairsHom_iff e 4).mp he x hx
    apply e.eq_one_or_neg_of_span_of_form_ne_zero span_spanningPairs
      (hsign (by decide : (2 : Fin 24) ≠ 0) 1)
    · rintro x (⟨i, hi, rfl⟩ | rfl)
      · exact hsign hi 1
      · exact hsign (by decide) (-1)
    · rintro x (⟨i, hi, rfl⟩ | rfl)
      · rw [pair_pairing hi]
        split_ifs <;> norm_num
      · rw [pair_pairing (by decide : (1 : Fin 24) ≠ 0)]
        norm_num
  · rintro (rfl | rfl) <;> simp [MonoidHom.mem_ker]

/-- The trivial permutation of Leech minimal-vector pairs comes exactly from identity or
negation. -/
@[simp]
theorem antipodalPairsHom_leechLattice_eq_one_iff
    {e : Isometry leechLattice leechLattice} :
    Isometry.antipodalPairsHom leechLattice 4 e = 1 ↔
      e = 1 ∨ e = Isometry.neg leechLattice := by
  rw [← MonoidHom.mem_ker, mem_ker_antipodalPairsHom_leechLattice_iff]

/-- The kernel of the action on Leech minimal-vector pairs is precisely the subgroup generated
by negation. -/
@[simp]
theorem ker_antipodalPairsHom_leechLattice :
    (Isometry.antipodalPairsHom leechLattice 4).ker =
      Subgroup.zpowers (Isometry.neg leechLattice) := by
  ext e
  rw [mem_ker_antipodalPairsHom_leechLattice_iff, Isometry.mem_zpowers_neg_iff]

end TauCeti
