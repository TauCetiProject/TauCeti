module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Leech.Basic

/-!
# The discriminant of the Leech half-lattice

Let `K` be the binary Golay Construction B lattice, with the halved dot product. Its
four-element discriminant group is the Klein four-group, generated by the classes of
`v = 2 e₀` and the odd Leech shift `s = (-3/2, 1/2, …, 1/2)`.
Both generators have half-norm zero modulo integers, and their pairing is `1/2`.
Thus the third nonzero class has half-norm `1/2`: the discriminant form is the split
quadratic plane, not merely an unspecified group of order four.

`BinaryGolay.constructionBDiscriminantEquiv` gives these coordinates on the literal dual
quotient. The dual-carrier description below states that every dual vector differs from
one of `0`, `v`, `s`, `v + s` by a vector of `K`.

The construction uses the existing discriminant cardinality of Construction B and the
odd-shift class from `Leech.Basic`. The coordinate map uses Mathlib's `ZMod.lift` and
`AddMonoidHom.coprod`, as in the checkerboard discriminant presentation in
`RootLattice.TypeD.Basic`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, Chapter 4,
  §11, and Chapter 10, §1.
* R. A. Wilson, *The Finite Simple Groups*, §5.4.
-/

public section

namespace TauCeti.BinaryGolay

open IntegralLattice

/-- The vector `2 e₀` pairs integrally with the Golay Construction B lattice. -/
theorem single_two_mem_constructionBLattice_dualCarrier :
    Pi.single 0 (2 : ℚ) ∈ constructionBLattice.dualCarrier := by
  rw [dualCarrier, LinearMap.BilinForm.mem_dualSubmodule]
  intro x hx
  obtain ⟨z, -, rfl⟩ := (ConstructionA.mem_lattice 2).mp
    (constructionALattice_carrier ▸ constructionBLattice_carrier_le hx)
  simp [constructionBLattice_form, ConstructionA.form_apply, single_dotProduct]

/-- The class of `2 e₀` in the discriminant group of the Golay Construction B lattice. -/
noncomputable def constructionBVectorClass : constructionBLattice.DiscriminantGroup :=
  Submodule.Quotient.mk ⟨Pi.single 0 (2 : ℚ), single_two_mem_constructionBLattice_dualCarrier⟩

/-- The vector class is represented by `2 e₀`. -/
theorem constructionBVectorClass_def : constructionBVectorClass =
    Submodule.Quotient.mk ⟨Pi.single 0 (2 : ℚ), single_two_mem_constructionBLattice_dualCarrier⟩ :=
  (rfl)

/-- Twice the vector class vanishes, since `4 e₀` lies in Construction B. -/
theorem two_zsmul_constructionBVectorClass : (2 : ℤ) • constructionBVectorClass = 0 := by
  rw [constructionBVectorClass_def, ← Submodule.Quotient.mk_smul,
    constructionBLattice.discriminantGroup_mk_eq_zero_iff, Submodule.coe_smul,
    constructionBLattice_carrier, ConstructionB.mem_lattice]
  refine ⟨Submodule.smul_mem _ _ (ConstructionA.single_mem_lattice 2 code.toAddSubgroup 0),
    1, ?_⟩
  norm_num [← Finset.mul_sum]

/-- The vector class has half-norm zero modulo integers. -/
@[simp]
theorem discriminantQuadraticMap_constructionBVectorClass :
    constructionBLattice.discriminantQuadraticMap isEven_constructionBLattice
      constructionBVectorClass = 0 := by
  have hf : constructionBLattice.form (Pi.single 0 (2 : ℚ)) (Pi.single 0 (2 : ℚ)) = 2 := by
    norm_num [constructionBLattice_form, ConstructionA.form_apply, single_dotProduct]
  rw [constructionBVectorClass_def, discriminantQuadraticMap_mk, hf]
  norm_num only
  rw [AddCircle.coe_eq_zero_iff_den_eq_one]
  norm_num

/-- The vector class has zero self-pairing. -/
@[simp]
theorem discriminantPairing_constructionBVectorClass_self :
    constructionBLattice.discriminantPairing constructionBVectorClass
      constructionBVectorClass = 0 := by
  rw [← constructionBLattice.polar_discriminantQuadraticMap isEven_constructionBLattice,
    QuadraticMap.polar_self, discriminantQuadraticMap_constructionBVectorClass, smul_zero]

/-- The vector and odd-shift classes pair to `1/2` modulo integers. -/
@[simp]
theorem discriminantPairing_constructionBVectorClass_leechShiftClass :
    constructionBLattice.discriminantPairing constructionBVectorClass leechShiftClass =
      ((1 / 2 : ℚ) : AddCircle (1 : ℚ)) := by
  have hf : constructionBLattice.form (Pi.single 0 (2 : ℚ)) leechShift = -(3 / 2) := by
    norm_num [constructionBLattice_form, ConstructionA.form_apply, single_dotProduct]
  rw [constructionBVectorClass_def, leechShiftClass_def, discriminantPairing_mk, hf]
  have h : -(3 / 2 : ℚ) = 1 / 2 + ((-2 : ℤ) : ℚ) := by norm_num
  rw [h, AddCircle.coe_add_intCast]

private noncomputable def halfDiscriminantHom :
    ZMod 2 × ZMod 2 →+ constructionBLattice.DiscriminantGroup :=
  (ZMod.lift 2 ⟨zmultiplesHom _ constructionBVectorClass,
    by simpa using two_zsmul_constructionBVectorClass⟩).coprod
    (ZMod.lift 2 ⟨zmultiplesHom _ leechShiftClass,
      by simpa only [zmultiplesHom_apply, natCast_zsmul] using two_nsmul_leechShiftClass⟩)

private theorem halfDiscriminantHom_apply (a b : ZMod 2) :
    halfDiscriminantHom (a, b) =
      (a.val : ℤ) • constructionBVectorClass + (b.val : ℤ) • leechShiftClass := by
  rw [halfDiscriminantHom, AddMonoidHom.coprod_apply]
  have ha : ((a.val : ℤ) : ZMod 2) = a := by simp
  have hb : ((b.val : ℤ) : ZMod 2) = b := by simp
  conv_lhs => rw [← ha, ← hb, ZMod.lift_coe, ZMod.lift_coe]
  rfl

private theorem halfDiscriminantHom_injective : Function.Injective halfDiscriminantHom := by
  rw [injective_iff_map_eq_zero]
  rintro ⟨a, b⟩ h
  have hb := congrArg (fun x ↦ constructionBLattice.discriminantPairing
    constructionBVectorClass x) h
  have ha := congrArg (fun x ↦ constructionBLattice.discriminantPairing x leechShiftClass) h
  have hhalf : ((1 / 2 : ℚ) : AddCircle (1 : ℚ)) ≠ 0 := by
    rw [Ne, AddCircle.coe_eq_zero_iff_den_eq_one]
    norm_num
  rcases (by decide : ∀ x : ZMod 2, x = 0 ∨ x = 1) a with rfl | rfl <;>
    rcases (by decide : ∀ x : ZMod 2, x = 0 ∨ x = 1) b with rfl | rfl <;>
    simp only [halfDiscriminantHom_apply, ZMod.val_zero, ZMod.val_one, Nat.cast_zero,
      Nat.cast_one, zero_smul, one_smul, zero_add, add_zero, map_add, LinearMap.add_apply,
      discriminantPairing_constructionBVectorClass_self,
      discriminantPairing_constructionBVectorClass_leechShiftClass, map_zero,
      LinearMap.zero_apply] at ha hb ⊢
  all_goals first | rfl | exact False.elim (hhalf ha) | exact False.elim (hhalf hb)

/-- **The dual quotient of the Golay Construction B lattice is `(ℤ/2)²`.** The first
coordinate is the class of `2 e₀`, and the second is the odd Leech shift class. -/
noncomputable def constructionBDiscriminantEquiv :
    ZMod 2 × ZMod 2 ≃+ constructionBLattice.DiscriminantGroup :=
  AddEquiv.ofBijective halfDiscriminantHom
    ((Nat.bijective_iff_injective_and_card _).mpr
      ⟨halfDiscriminantHom_injective, by simp⟩)

/-- Discriminant coordinates assemble the indicated multiples of the two classes. -/
theorem constructionBDiscriminantEquiv_apply (a b : ZMod 2) :
    constructionBDiscriminantEquiv (a, b) =
      (a.val : ℤ) • constructionBVectorClass + (b.val : ℤ) • leechShiftClass :=
  halfDiscriminantHom_apply a b

/-- The first coordinate generator is the vector class. -/
@[simp]
theorem constructionBDiscriminantEquiv_one_zero :
    constructionBDiscriminantEquiv (1, 0) = constructionBVectorClass := by
  simp [constructionBDiscriminantEquiv_apply, ZMod.val_one]

/-- The second coordinate generator is the odd shift class. -/
@[simp]
theorem constructionBDiscriminantEquiv_zero_one :
    constructionBDiscriminantEquiv (0, 1) = leechShiftClass := by
  simp [constructionBDiscriminantEquiv_apply, ZMod.val_one]

/-- **The discriminant half-norm in coordinates is `ab/2` modulo integers.** In particular,
the two coordinate generators are isotropic and their sum is not. -/
@[simp]
theorem discriminantQuadraticMap_constructionBDiscriminantEquiv (a b : ZMod 2) :
    constructionBLattice.discriminantQuadraticMap isEven_constructionBLattice
        (constructionBDiscriminantEquiv (a, b)) =
      (((a.val : ℚ) * b.val / 2 : ℚ) : AddCircle (1 : ℚ)) := by
  rcases (by decide : ∀ x : ZMod 2, x = 0 ∨ x = 1) a with rfl | rfl <;>
    rcases (by decide : ∀ x : ZMod 2, x = 0 ∨ x = 1) b with rfl | rfl <;>
    simp [constructionBDiscriminantEquiv_apply, ZMod.val_one, QuadraticMap.map_add,
      polar_discriminantQuadraticMap]

/-- **The literal dual carrier consists of four cosets of Construction B**, represented by
`0`, `2 e₀`, the odd Leech shift `s`, and `2 e₀ + s`. -/
theorem mem_constructionBLattice_dualCarrier_iff (x : Fin 24 → ℚ) :
    x ∈ constructionBLattice.dualCarrier ↔
      x ∈ constructionBLattice.carrier ∨
      x - Pi.single 0 (2 : ℚ) ∈ constructionBLattice.carrier ∨
      x - leechShift ∈ constructionBLattice.carrier ∨
      x - (Pi.single 0 (2 : ℚ) + leechShift) ∈ constructionBLattice.carrier := by
  constructor
  · intro hx
    obtain ⟨⟨a, b⟩, hab⟩ := constructionBDiscriminantEquiv.surjective
      (Submodule.Quotient.mk ⟨x, hx⟩)
    have h := hab.symm
    rcases (by decide : ∀ y : ZMod 2, y = 0 ∨ y = 1) a with rfl | rfl <;>
      rcases (by decide : ∀ y : ZMod 2, y = 0 ∨ y = 1) b with rfl | rfl <;>
      simp only [constructionBDiscriminantEquiv_apply, ZMod.val_zero, ZMod.val_one,
        Nat.cast_zero, Nat.cast_one, zero_smul, one_smul, zero_add, add_zero] at h
    · exact Or.inl ((constructionBLattice.discriminantGroup_mk_eq_zero_iff _).mp h)
    · rw [leechShiftClass_def, constructionBLattice.discriminantGroup_mk_eq_iff] at h
      exact Or.inr (Or.inr (Or.inl h))
    · rw [constructionBVectorClass_def, constructionBLattice.discriminantGroup_mk_eq_iff] at h
      exact Or.inr (Or.inl h)
    · rw [constructionBVectorClass_def, leechShiftClass_def, ← Submodule.Quotient.mk_add,
        constructionBLattice.discriminantGroup_mk_eq_iff] at h
      exact Or.inr (Or.inr (Or.inr h))
  · rintro (hx | hx | hx | hx)
    · exact constructionBLattice.le_dualCarrier hx
    · simpa only [sub_add_cancel] using constructionBLattice.dualCarrier.add_mem
        (constructionBLattice.le_dualCarrier hx) single_two_mem_constructionBLattice_dualCarrier
    · simpa only [sub_add_cancel] using constructionBLattice.dualCarrier.add_mem
        (constructionBLattice.le_dualCarrier hx) leechShift_mem_constructionBLattice_dualCarrier
    · simpa only [sub_add_cancel] using constructionBLattice.dualCarrier.add_mem
        (constructionBLattice.le_dualCarrier hx)
        (constructionBLattice.dualCarrier.add_mem single_two_mem_constructionBLattice_dualCarrier
          leechShift_mem_constructionBLattice_dualCarrier)

end TauCeti.BinaryGolay
