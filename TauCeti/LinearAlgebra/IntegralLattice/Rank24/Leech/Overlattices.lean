module

public import TauCeti.LinearAlgebra.IntegralLattice.ConstructionA.Golay.Roots
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Leech.HalfLattice
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Leech.Minimum

/-!
# The two even overlattices of index two of Golay Construction B

Let `K` be the binary Golay Construction B lattice. Its discriminant group is the Klein
four-group, and exactly two of its three subgroups of order two are isotropic
(`TauCeti.BinaryGolay.isIsotropic_constructionBLattice_iff_of_natCard_eq_two`): the one
generated by the class of the odd shift `s = (-3/2, 1/2, …, 1/2)` and the one generated by the
class of `2 e₀`. Gluing `K` along either gives an even unimodular lattice of rank `24`.

This file identifies the second gluing and separates the two. The Golay Construction A lattice
is the union of `K` and `2 e₀ + K` (`TauCeti.ConstructionB.mem_constructionALattice_iff`), so
gluing `K` along the class of `2 e₀` gives back the Golay Construction A lattice. That lattice
contains `2 e₀`, a vector of norm `2`, whereas the Leech lattice has no vector of norm `2`.
So among the isotropic subgroups of order two, the Leech glue subgroup is the only one along which
`K` glues to a lattice without roots.

## Main declarations

* `TauCeti.BinaryGolay.isIsotropic_zmultiples_constructionBVectorClass`: the class of `2 e₀`
  generates an isotropic subgroup.
* `BinaryGolay.ofIsotropicSubgroup_zmultiples_constructionBVectorClass_eq_constructionALattice`:
  gluing `K` along the class of `2 e₀` gives the Golay Construction A lattice.
* `TauCeti.BinaryGolay.vectorsOfNorm_two_ofIsotropicSubgroup_constructionBLattice_eq_empty_iff`:
  an isotropic subgroup of order two glues `K` to a lattice without roots exactly when it is the
  Leech glue subgroup.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, Chapter 7, §5, and
  Chapter 10, §1.
-/

public section

namespace TauCeti.BinaryGolay

open IntegralLattice

/-- The subgroup generated by the class of `2 e₀` is isotropic for the discriminant quadratic
form of the Golay Construction B lattice. -/
theorem isIsotropic_zmultiples_constructionBVectorClass :
    (constructionBLattice.discriminantQuadraticModule isEven_constructionBLattice).IsIsotropic
      (AddSubgroup.zmultiples constructionBVectorClass :
        AddSubgroup constructionBLattice.DiscriminantGroup) :=
  (FiniteQuadraticModule.isIsotropic_zmultiples_iff _ _).mpr
    ((FiniteQuadraticModule.isIsotropicElem_def _ _).mpr
      discriminantQuadraticMap_constructionBVectorClass)

/-- **Gluing Golay Construction B along the class of `2 e₀` gives Golay Construction A.** -/
@[simp]
theorem ofIsotropicSubgroup_zmultiples_constructionBVectorClass_eq_constructionALattice :
    constructionBLattice.ofIsotropicSubgroup isEven_constructionBLattice
        (AddSubgroup.zmultiples constructionBVectorClass)
        isIsotropic_zmultiples_constructionBVectorClass =
      constructionALattice := by
  refine IntegralLattice.ext ?_ ?_
  · ext x
    rw [ofIsotropicSubgroup_carrier, constructionBVectorClass_def,
      constructionBLattice.mem_intermediateCarrierOfDiscriminantSubgroup_zmultiples_iff
        single_two_mem_constructionBLattice_dualCarrier
        (by rw [← constructionBVectorClass_def, ← natCast_zsmul]
            exact two_zsmul_constructionBVectorClass),
      constructionBLattice_carrier, constructionALattice_carrier,
      ConstructionB.mem_constructionALattice_iff code isDoublyEven_code.isEven 0]
  · rw [ofIsotropicSubgroup_form, constructionBLattice_form, constructionALattice_form]

/-- **Only the Leech glue subgroup gives a rootless lattice.** An isotropic subgroup of order two
of the discriminant group of the Golay Construction B lattice glues it to a lattice without
vectors of norm `2` exactly when it is the Leech glue subgroup, generated by the class of the odd
shift. The other isotropic subgroup of order two gives the Golay Construction A lattice, which
contains the root `2 e₀`. -/
theorem vectorsOfNorm_two_ofIsotropicSubgroup_constructionBLattice_eq_empty_iff
    {H : AddSubgroup constructionBLattice.DiscriminantGroup} (hcard : Nat.card H = 2)
    (hH : (constructionBLattice.discriminantQuadraticModule
      isEven_constructionBLattice).IsIsotropic H) :
    (constructionBLattice.ofIsotropicSubgroup isEven_constructionBLattice H hH).vectorsOfNorm 2 =
        ∅ ↔
      H = leechShiftSubgroup := by
  constructor
  · intro h
    rcases (isIsotropic_constructionBLattice_iff_of_natCard_eq_two hcard).mp hH with rfl | rfl
    · rfl
    · rw [ofIsotropicSubgroup_zmultiples_constructionBVectorClass_eq_constructionALattice] at h
      exact absurd (mem_vectorsOfNorm.mpr (norm_coordinateRoot 0))
        (Set.eq_empty_iff_forall_notMem.mp h _)
  · rintro rfl
    rw [ofIsotropicSubgroup_leechShiftSubgroup_eq_leechLattice, vectorsOfNorm_two_leechLattice]

end TauCeti.BinaryGolay
