module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.EnumeratedRows
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.IdentifiedRows
public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.GlueAlphabet.Roots

/-!
# The 23 rootful rank-24 lattices are even unimodular with the displayed root systems

For a row `r` of `TauCeti.RootfulNiemeierType`, let `R_r` be the orthogonal sum of the root
lattices of its ordered ADE components, `H_r = r.glueSubgroup` the subgroup of glue words generated
by the decoded Conway--Sloane glue generators, and `N_r = r.lattice` the even overlattice of `R_r`
glued along `H_r`.  This file proves, by single statements quantified over the row index, the
remaining finite checks of Conway--Sloane's Table 16.1 on the generated subgroups and their
consequences for the lattices:

* `H_r` has the displayed order `|H|` (`natCard_glueSubgroup`);
* `H_r` is a quadratic Lagrangian, `H_r = H_r^⊥` (`isLagrangian_glueSubgroup`);
* every nonzero word `w ∈ H_r` has glue minimum `μ(w) ≥ 4`
  (`four_le_sum_glueMinimum_of_mem_glueSubgroup`), where `μ(w)` is the least norm of a vector of
  the dual coset of `R_r` named by `w`;
* `N_r` is unimodular (`isUnimodular_lattice`), and hence, together with
  `TauCeti.RootfulNiemeierType.isEven_lattice`, `isPosDef_lattice` and `finrank_lattice`, a
  positive definite even unimodular lattice of rank `24`;
* the norm-`2` vectors of `N_r` are exactly those of `R_r` (`image_vectorsOfNorm_two_lattice`), and
  they span exactly the carrier of `R_r` (`span_vectorsOfNorm_two_lattice`): the root sublattice of
  `N_r` is the embedded root lattice of the displayed root system.

The root-sublattice statement is derived from the glue minima through the attained coset minima of
the components, not from evenness, unimodularity, the determinant or a root count.

The two glue checks are assembled from two sources.  For the 19 rows other than `A₁²⁴`, `A₂¹²`,
`D₄⁶` and `A₁₁ D₇ E₆`, the glue subgroup is enumerated word by word in
`TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.EnumeratedRows`.  For the four remaining rows it
is identified, in `TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.IdentifiedRows`, with the
extended binary Golay code, the extended ternary Golay code, the hexacode and the cyclic group
generated by `[111]`.  The Lagrangian property then follows uniformly from the order, since `H_r`
is isotropic in the nondegenerate module of glue words of order `|H|²`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4
  §§3 and 6, and Chapter 16 §1, Table 16.1.
* J. H. Conway and N. J. A. Sloane, *On the enumeration of lattices of determinant one*,
  Journal of Number Theory 15 (1982), Table V.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open IntegralLattice

/-- A statement holds for every row once it holds for the four rows `A₁²⁴`, `A₂¹²`, `D₄⁶` and
`A₁₁ D₇ E₆`, whose glue subgroups are identified with codes or a cyclic group, and for the other
19 rows, whose glue subgroups are enumerated. -/
private theorem forall_of_identified_of_ne {P : RootfulNiemeierType → Prop}
    (h₁ : P .a1TwentyFourth) (h₂ : P .a2Twelfth) (h₃ : P .d4Sixth) (h₄ : P .a11d7e6)
    (h : ∀ r, r ≠ .a1TwentyFourth → r ≠ .a2Twelfth → r ≠ .d4Sixth → r ≠ .a11d7e6 → P r)
    (r : RootfulNiemeierType) : P r := by
  cases r
  case a1TwentyFourth => exact h₁
  case a2Twelfth => exact h₂
  case d4Sixth => exact h₃
  case a11d7e6 => exact h₄
  all_goals exact h _ (by decide) (by decide) (by decide) (by decide)

/-- **The glue subgroup of every row has the displayed order `|H|`.** -/
theorem natCard_glueSubgroup (r : RootfulNiemeierType) :
    Nat.card r.glueSubgroup = r.glueOrder :=
  forall_of_identified_of_ne natCard_glueSubgroup_a1TwentyFourth natCard_glueSubgroup_a2Twelfth
    natCard_glueSubgroup_d4Sixth natCard_glueSubgroup_a11d7e6 natCard_glueSubgroup_of_ne r

/-- **The glue subgroup of every row is a quadratic Lagrangian**, `H_r = H_r^⊥`: it is isotropic,
and its order `|H|` satisfies `|H|² = |A_R|`. -/
theorem isLagrangian_glueSubgroup (r : RootfulNiemeierType) :
    r.glueModule.IsLagrangian r.glueSubgroup :=
  r.isIsotropic_glueSubgroup.isLagrangian_of_card_sq_eq _
    (DynkinType.isNondegenerate_pi_glueAlphabet _ _ r.valid_componentType)
    (by rw [natCard_glueSubgroup, glueOrder_sq_eq_natCard_glueModule])

/-- **Every nonzero word of the glue subgroup of every row has glue minimum `μ(w) ≥ 4`.** -/
theorem four_le_sum_glueMinimum_of_mem_glueSubgroup (r : RootfulNiemeierType)
    {w : r.glueModule} (hw : w ∈ r.glueSubgroup) (hw0 : w ≠ 0) :
    4 ≤ ∑ i, (r.componentType i).glueMinimum (r.isSimplyLaced_componentType i) (w i) := by
  induction r using forall_of_identified_of_ne with
  | h₁ => exact four_le_sum_glueMinimum_of_mem_glueSubgroup_a1TwentyFourth hw hw0
  | h₂ => exact four_le_sum_glueMinimum_of_mem_glueSubgroup_a2Twelfth hw hw0
  | h₃ => exact four_le_sum_glueMinimum_of_mem_glueSubgroup_d4Sixth hw hw0
  | h₄ => exact four_le_sum_glueMinimum_of_mem_glueSubgroup_a11d7e6 hw hw0
  | h r h₁ h₂ h₃ h₄ => exact four_le_sum_glueMinimum_of_mem_glueSubgroup_of_ne r h₁ h₂ h₃ h₄ hw hw0

/-- **The lattice of every row is unimodular.** -/
theorem isUnimodular_lattice (r : RootfulNiemeierType) : r.lattice.IsUnimodular :=
  (isUnimodular_lattice_iff r).mpr (natCard_glueSubgroup r)

/-- **Gluing adds no roots**: for every row, the norm-`2` vectors of `N_r` are exactly the
norm-`2` vectors of `R_r`, compared in the common ambient space.  In particular every norm-`2`
vector of `N_r` lies in `R_r`. -/
theorem image_vectorsOfNorm_two_lattice (r : RootfulNiemeierType) :
    (fun x : r.lattice ↦ (x : ∀ i, Fin (r.componentType i).rank → ℚ)) ''
        r.lattice.vectorsOfNorm 2 =
      (fun x : r.rootLattice ↦ (x : ∀ i, Fin (r.componentType i).rank → ℚ)) ''
        r.rootLattice.vectorsOfNorm 2 := by
  rw [lattice_def]
  exact DynkinType.image_vectorsOfNorm_gluedLattice_eq _ _ r.valid_componentType _ _
    (fun _ ↦ r.four_le_sum_glueMinimum_of_mem_glueSubgroup) (by norm_num)

/-- **The root sublattice of `N_r` is `R_r`**: for every row, the norm-`2` vectors of `N_r` span
exactly the carrier of the orthogonal sum of the component root lattices. -/
theorem span_vectorsOfNorm_two_lattice (r : RootfulNiemeierType) :
    Submodule.span ℤ ((fun x : r.lattice ↦ (x : ∀ i, Fin (r.componentType i).rank → ℚ)) ''
        r.lattice.vectorsOfNorm 2) = r.rootLattice.carrier := by
  rw [lattice_def]
  exact DynkinType.span_vectorsOfNorm_two_gluedLattice _ _ r.valid_componentType _ _
    (fun _ ↦ r.four_le_sum_glueMinimum_of_mem_glueSubgroup) (by norm_num)

end RootfulNiemeierType

end TauCeti
