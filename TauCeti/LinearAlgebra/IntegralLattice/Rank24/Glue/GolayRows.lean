module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.A1TwentyFour
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.A2Twelfth
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.Table

/-!
# The table rows `A₁²⁴` and `A₂¹²` are glued along the Golay codes

The rows `A₁²⁴` and `A₂¹²` of the rootful rank-24 table,
`TauCeti.RootfulNiemeierType.a1TwentyFourth` and `TauCeti.RootfulNiemeierType.a2Twelfth`, have
glue subgroups `H` generated by the decoded Conway--Sloane patterns
`[1(00000101001100110101111)]` and `[2(11211122212)]`, with `4096` and `729` words.  The same
subgroups are also constructed directly, over the constant families `A₁` on `Fin 24` and `A₂` on
`Fin 12`, as `TauCeti.a1TwentyFourGlueSubgroup` and `TauCeti.a2TwelfthGlueSubgroup`, which are
identified with the extended binary and ternary Golay codes.  This file shows that the table
subgroups are these subgroups, so that the table rows inherit the Golay identifications.

All components of each row are equal, so passing from the row's family of components to the
constant family is an isometry of glue-word modules which keeps every Conway--Sloane digit
(`TauCeti.RootfulNiemeierType.a1TwentyFourthGlueIsometry`,
`TauCeti.RootfulNiemeierType.a2TwelfthGlueIsometry`).  The digit words of each row's pattern are
the printed generators of the direct construction (a finite check), so this isometry carries `H`
onto the direct glue subgroup.  Consequently a glue word of the row lies in `H` exactly when its
image in Golay coordinates is a Golay codeword.

## Main declarations

* `TauCeti.RootfulNiemeierType.map_glueSubgroup_a1TwentyFourth`,
  `TauCeti.RootfulNiemeierType.mem_glueSubgroup_a1TwentyFourth_iff`: the table glue subgroup of
  `A₁²⁴` is the printed glue subgroup, that is, the binary Golay code.
* `TauCeti.RootfulNiemeierType.map_glueSubgroup_a2Twelfth`,
  `TauCeti.RootfulNiemeierType.mem_glueSubgroup_a2Twelfth_iff`: the table glue subgroup of `A₂¹²`
  is the printed glue subgroup, that is, the ternary Golay code.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Chapter 4,
  §3, and Chapter 16, §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

open DynkinType

/-! ### The row `A₁²⁴` -/

/-- The row `A₁²⁴` has twenty-four components. -/
@[simp]
theorem length_components_a1TwentyFourth : a1TwentyFourth.components.length = 24 :=
  List.length_replicate

/-- Every component of the row `A₁²⁴` has type `A₁`. -/
@[simp]
theorem componentType_a1TwentyFourth (i : Fin a1TwentyFourth.components.length) :
    a1TwentyFourth.componentType i = A 1 :=
  congrArg Subtype.val (List.getElem_replicate _)

/-- **The digit words of the row `A₁²⁴` are the twenty-three printed rotations**: the label `1`
followed by a cyclic rotation of the block `00000101001100110101111`. -/
theorem glueWords_a1TwentyFourth : a1TwentyFourth.glueWords =
    Finset.univ.image fun r : Fin 23 ↦ List.ofFn fun j ↦ (a1TwentyFourPrintedWord r j : ℕ) := by
  have hword (r : Fin 23) : (List.ofFn fun j ↦ (a1TwentyFourPrintedWord r j : ℕ)) =
      1 :: List.ofFn fun i : Fin 23 ↦ (a1TwentyFourPrintedBlock (i + r) : ℕ) := by
    simp [List.ofFn_succ]
  simp only [hword, a1TwentyFourPrintedBlock_def]
  decide

/-- **Glue words of the row `A₁²⁴` in the constant `A₁` alphabets**: the isometry of glue-word
modules that reads the label of component `j : Fin 24` as a label of `A₁`. -/
noncomputable def a1TwentyFourthGlueIsometry :
    FiniteQuadraticModule.Isometry a1TwentyFourth.glueModule a1TwentyFourGlueModule :=
  piGlueAlphabetCongr _ _ (finCongr length_components_a1TwentyFourth.symm)
    fun _ ↦ componentType_a1TwentyFourth _

/-- The glue isometry of the row `A₁²⁴` is the reindexing of glue words from the positions of the
row's components to `Fin 24`. -/
theorem a1TwentyFourthGlueIsometry_def :
    a1TwentyFourthGlueIsometry = piGlueAlphabetCongr _ _
      (finCongr length_components_a1TwentyFourth.symm) fun _ ↦ componentType_a1TwentyFourth _ :=
  (rfl)

/-- The glue isometry of the row `A₁²⁴` keeps every Conway--Sloane digit. -/
@[simp]
theorem encodeGlueWord_a1TwentyFourthGlueIsometry (w : a1TwentyFourth.glueModule) :
    encodeGlueWord (fun _ : Fin 24 ↦ A 1) (fun _ ↦ isSimplyLaced_A 1)
        (a1TwentyFourthGlueIsometry w) =
      encodeGlueWord a1TwentyFourth.componentType a1TwentyFourth.isSimplyLaced_componentType w :=
  encodeGlueWord_piGlueAlphabetCongr _ _ _ _ _ w

/-- The glue isometry of the row `A₁²⁴` preserves the shortest norm `μ(w)` of a glue word. -/
@[simp]
theorem sum_glueMinimum_a1TwentyFourthGlueIsometry (w : a1TwentyFourth.glueModule) :
    ∑ j, (A 1).glueMinimum (isSimplyLaced_A 1) (a1TwentyFourthGlueIsometry w j) =
      ∑ i, (a1TwentyFourth.componentType i).glueMinimum
        (a1TwentyFourth.isSimplyLaced_componentType i) (w i) :=
  sum_glueMinimum_piGlueAlphabetCongr _ _ _ _ _ w

/-- The decoded printed rotation of `A₁²⁴` has the printed digits. -/
private theorem encodeGlueWord_a1TwentyFourPrintedWord (r : Fin 23) :
    encodeGlueWord (fun _ : Fin 24 ↦ A 1) (fun _ ↦ isSimplyLaced_A 1)
        (fun j ↦ (A 1).glueLabelEquiv (isSimplyLaced_A 1) (a1TwentyFourPrintedWord r j)) =
      List.ofFn fun j ↦ (a1TwentyFourPrintedWord r j : ℕ) := by
  rw [eq_comm, ← decodeGlueWord_eq_some_iff,
    decodeGlueWord_ofFn _ _ _ fun j ↦ (a1TwentyFourPrintedWord r j).isLt]

/-- The glue isometry of the row carries its glue generators to the decoded printed rotations. -/
private theorem image_glueGenerators_a1TwentyFourth :
    a1TwentyFourthGlueIsometry '' a1TwentyFourth.glueGenerators = Set.range fun r j ↦
      (A 1).glueLabelEquiv (isSimplyLaced_A 1) (a1TwentyFourPrintedWord r j) := by
  ext v
  obtain ⟨w, rfl⟩ := EquivLike.surjective a1TwentyFourthGlueIsometry v
  rw [(EquivLike.injective a1TwentyFourthGlueIsometry).mem_set_image, mem_glueGenerators_iff,
    glueWords_a1TwentyFourth, ← encodeGlueWord_a1TwentyFourthGlueIsometry, Finset.mem_image]
  simp only [Finset.mem_univ, true_and, Set.mem_range]
  refine exists_congr fun r ↦ ?_
  rw [← encodeGlueWord_a1TwentyFourPrintedWord]
  exact (encodeGlueWord_injective _ _).eq_iff

/-- **The table glue subgroup of `A₁²⁴` is the printed glue subgroup**: the glue isometry of the
row carries the subgroup generated by the decoded table pattern onto the subgroup generated by the
twenty-three printed rotations. -/
theorem map_glueSubgroup_a1TwentyFourth :
    a1TwentyFourth.glueSubgroup.map
        a1TwentyFourthGlueIsometry.toLinearEquiv.toAddEquiv.toAddMonoidHom =
      a1TwentyFourGlueSubgroup := by
  rw [glueSubgroup_def, AddMonoidHom.map_closure, a1TwentyFourGlueSubgroup_def]
  exact congrArg AddSubgroup.closure image_glueGenerators_a1TwentyFourth

/-- A glue word of the row `A₁²⁴` lies in the table glue subgroup exactly when its image under the
glue isometry lies in the printed glue subgroup. -/
theorem a1TwentyFourthGlueIsometry_mem_a1TwentyFourGlueSubgroup_iff
    (w : a1TwentyFourth.glueModule) :
    a1TwentyFourthGlueIsometry w ∈ a1TwentyFourGlueSubgroup ↔ w ∈ a1TwentyFourth.glueSubgroup := by
  rw [← map_glueSubgroup_a1TwentyFourth, AddSubgroup.mem_map_equiv]
  simp

/-- **The table glue subgroup of `A₁²⁴` is the binary Golay code**: a glue word of the row lies
in the subgroup generated by `[1(00000101001100110101111)]` exactly when, read in the Golay
coordinates of `TauCeti.a1TableToGolayIsometry`, it is a word of the extended binary Golay
code. -/
theorem mem_glueSubgroup_a1TwentyFourth_iff (w : a1TwentyFourth.glueModule) :
    w ∈ a1TwentyFourth.glueSubgroup ↔
      a1TableToGolayIsometry (a1TwentyFourthGlueIsometry w) ∈ BinaryGolay.code := by
  rw [← a1TwentyFourthGlueIsometry_mem_a1TwentyFourGlueSubgroup_iff,
    mem_a1TwentyFourGlueSubgroup_iff]

/-! ### The row `A₂¹²` -/

/-- The row `A₂¹²` has twelve components. -/
@[simp]
theorem length_components_a2Twelfth : a2Twelfth.components.length = 12 :=
  List.length_replicate

/-- Every component of the row `A₂¹²` has type `A₂`. -/
@[simp]
theorem componentType_a2Twelfth (i : Fin a2Twelfth.components.length) :
    a2Twelfth.componentType i = A 2 :=
  congrArg Subtype.val (List.getElem_replicate _)

/-- **The digit words of the row `A₂¹²` are the expansions of `[2(11211122212)]`.** -/
theorem glueWords_a2Twelfth :
    a2Twelfth.glueWords = (GluePattern.cyclic [2] [1, 1, 2, 1, 1, 1, 2, 2, 2, 1, 2] []).expand := by
  decide

/-- **Glue words of the row `A₂¹²` in the constant `A₂` alphabets**: the isometry of glue-word
modules that reads the label of component `j : Fin 12` as a label of `A₂`. -/
noncomputable def a2TwelfthGlueIsometry :
    FiniteQuadraticModule.Isometry a2Twelfth.glueModule a2TwelfthGlueModule :=
  piGlueAlphabetCongr _ _ (finCongr length_components_a2Twelfth.symm)
    fun _ ↦ componentType_a2Twelfth _

/-- The glue isometry of the row `A₂¹²` is the reindexing of glue words from the positions of the
row's components to `Fin 12`. -/
theorem a2TwelfthGlueIsometry_def :
    a2TwelfthGlueIsometry = piGlueAlphabetCongr _ _
      (finCongr length_components_a2Twelfth.symm) fun _ ↦ componentType_a2Twelfth _ :=
  (rfl)

/-- The glue isometry of the row `A₂¹²` keeps every Conway--Sloane digit. -/
@[simp]
theorem encodeGlueWord_a2TwelfthGlueIsometry (w : a2Twelfth.glueModule) :
    encodeGlueWord (fun _ : Fin 12 ↦ A 2) (fun _ ↦ isSimplyLaced_A 2) (a2TwelfthGlueIsometry w) =
      encodeGlueWord a2Twelfth.componentType a2Twelfth.isSimplyLaced_componentType w :=
  encodeGlueWord_piGlueAlphabetCongr _ _ _ _ _ w

/-- The glue isometry of the row `A₂¹²` preserves the shortest norm `μ(w)` of a glue word. -/
@[simp]
theorem sum_glueMinimum_a2TwelfthGlueIsometry (w : a2Twelfth.glueModule) :
    ∑ j, (A 2).glueMinimum (isSimplyLaced_A 2) (a2TwelfthGlueIsometry w j) =
      ∑ i, (a2Twelfth.componentType i).glueMinimum (a2Twelfth.isSimplyLaced_componentType i)
        (w i) :=
  sum_glueMinimum_piGlueAlphabetCongr _ _ _ _ _ w

/-- The glue isometry of the row carries its glue generators to the decoded expansions of
`[2(11211122212)]`. -/
private theorem image_glueGenerators_a2Twelfth :
    a2TwelfthGlueIsometry '' a2Twelfth.glueGenerators =
      {w | ∃ l ∈ (GluePattern.cyclic [2] [1, 1, 2, 1, 1, 1, 2, 2, 2, 1, 2] []).expand,
        decodeGlueWord (fun _ : Fin 12 ↦ A 2) (fun _ ↦ isSimplyLaced_A 2) l = some w} := by
  ext v
  obtain ⟨w, rfl⟩ := EquivLike.surjective a2TwelfthGlueIsometry v
  rw [(EquivLike.injective a2TwelfthGlueIsometry).mem_set_image, mem_glueGenerators_iff,
    glueWords_a2Twelfth, ← encodeGlueWord_a2TwelfthGlueIsometry]
  simp

/-- **The table glue subgroup of `A₂¹²` is the printed glue subgroup**: the glue isometry of the
row carries the subgroup generated by the decoded table pattern onto
`TauCeti.a2TwelfthGlueSubgroup`. -/
theorem map_glueSubgroup_a2Twelfth :
    a2Twelfth.glueSubgroup.map a2TwelfthGlueIsometry.toLinearEquiv.toAddEquiv.toAddMonoidHom =
      a2TwelfthGlueSubgroup := by
  rw [glueSubgroup_def, AddMonoidHom.map_closure, a2TwelfthGlueSubgroup_def]
  exact congrArg AddSubgroup.closure image_glueGenerators_a2Twelfth

/-- A glue word of the row `A₂¹²` lies in the table glue subgroup exactly when its image under the
glue isometry lies in the printed glue subgroup. -/
theorem a2TwelfthGlueIsometry_mem_a2TwelfthGlueSubgroup_iff (w : a2Twelfth.glueModule) :
    a2TwelfthGlueIsometry w ∈ a2TwelfthGlueSubgroup ↔ w ∈ a2Twelfth.glueSubgroup := by
  rw [← map_glueSubgroup_a2Twelfth, AddSubgroup.mem_map_equiv]
  simp

/-- **The table glue subgroup of `A₂¹²` is the ternary Golay code**: a glue word of the row lies
in the subgroup generated by `[2(11211122212)]` exactly when, read in the Golay coordinates of
`TauCeti.a2TwelfthGolayIsometry`, it is a word of the extended ternary Golay code. -/
theorem mem_glueSubgroup_a2Twelfth_iff (w : a2Twelfth.glueModule) :
    w ∈ a2Twelfth.glueSubgroup ↔
      a2TwelfthGolayIsometry (a2TwelfthGlueIsometry w) ∈ TernaryGolay.code := by
  rw [← a2TwelfthGlueIsometry_mem_a2TwelfthGlueSubgroup_iff, mem_a2TwelfthGlueSubgroup_iff]

end RootfulNiemeierType

end TauCeti
