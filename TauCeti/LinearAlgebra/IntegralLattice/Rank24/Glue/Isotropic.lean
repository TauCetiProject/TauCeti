module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.Table

/-!
# The glue subgroups of the rootful rank-24 table are isotropic

For each of the 23 rows `r` of `TauCeti.RootfulNiemeierType`, the glue subgroup
`H_r = r.glueSubgroup` is quadratically isotropic in the module of glue words of the row's ordered
components (`TauCeti.RootfulNiemeierType.isIsotropic_glueSubgroup`): every word of `H_r` has
quadratic value `q(w) = μ(w) / 2 = 0` in `ℚ/ℤ`, that is, the shortest norm `μ(w)` of its coset is
an even integer.  This is the quadratic-isotropy check of the Conway--Sloane table, stated once for
all rows, and it is what the isotropic gluing `TauCeti.DynkinType.gluedLattice` requires of `H_r`.

The statement is about the whole generated subgroup, not only its listed generators.  It is
reduced to the generators by `TauCeti.FiniteQuadraticModule.isIsotropic_closure_iff`: the subgroup
generated by a set is isotropic exactly when the generators are isotropic and pairwise orthogonal.
Since the pairing is the polar form, `b(x, y) = q(x + y) - q(x) - q(y)`, so it suffices that `μ` is
an even integer on every generator and on every sum of two generators.  These finitely many values
are computed from the printed digit words by `TauCeti.glueWordMinimum` and `TauCeti.glueWordAdd`,
which agree with `μ` and with addition of glue words (`TauCeti.glueWordMinimum_encodeGlueWord`,
`TauCeti.encodeGlueWord_add`), and the resulting finite check over the table is a proof-producing
computation by `decide`.

## Main declarations

* `TauCeti.RootfulNiemeierType.isIsotropic_glueSubgroup`: every glue subgroup of the table is
  quadratically isotropic.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed.,
  Chapter 4 §3 and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti

namespace RootfulNiemeierType

/-- The finite check behind isotropy: the shortest norm of every digit word of a row, and of every
label-wise sum of two of them, is an even integer. -/
private theorem den_glueWordMinimum_div_two_eq_one (r : RootfulNiemeierType) :
    ∀ l ∈ r.glueWords, ∀ l' ∈ r.glueWords,
      (glueWordMinimum r.componentType l / 2).den = 1 ∧
        (glueWordMinimum r.componentType (glueWordAdd r.componentType l l') / 2).den = 1 := by
  cases r <;> decide +kernel

/-- The quadratic value of a glue word is half the shortest norm read off its digit word. -/
private theorem quadratic_eq_glueWordMinimum (r : RootfulNiemeierType) (w : r.glueModule) :
    r.glueModule.quadratic w =
      ((glueWordMinimum r.componentType
          (encodeGlueWord r.componentType r.isSimplyLaced_componentType w) / 2 : ℚ) :
        AddCircle (1 : ℚ)) := by
  rw [DynkinType.quadratic_pi_glueAlphabet_eq_sum_glueMinimum_div_two _ r.valid_componentType,
    glueWordMinimum_encodeGlueWord]

/-- **The glue subgroup of every row of the rootful rank-24 table is quadratically isotropic**:
every word `w ∈ H_r` has quadratic value `q(w) = 0`, equivalently its coset minimum `μ(w)` is an
even integer. -/
theorem isIsotropic_glueSubgroup (r : RootfulNiemeierType) :
    r.glueModule.IsIsotropic r.glueSubgroup := by
  have hq : ∀ w ∈ r.glueGenerators, ∀ w' ∈ r.glueGenerators,
      r.glueModule.quadratic w = 0 ∧ r.glueModule.quadratic (w + w') = 0 := by
    intro w hw w' hw'
    rw [mem_glueGenerators_iff] at hw hw'
    obtain ⟨h, h'⟩ := den_glueWordMinimum_div_two_eq_one r _ hw _ hw'
    rw [quadratic_eq_glueWordMinimum, quadratic_eq_glueWordMinimum, encodeGlueWord_add]
    exact ⟨(AddCircle.coe_eq_zero_iff_den_eq_one _).mpr h,
      (AddCircle.coe_eq_zero_iff_den_eq_one _).mpr h'⟩
  rw [glueSubgroup_def, FiniteQuadraticModule.isIsotropic_closure_iff]
  refine ⟨fun w hw ↦ (hq w hw w hw).1, fun w hw w' hw' ↦ ?_⟩
  rw [← FiniteQuadraticModule.polar_eq_pairing, QuadraticMap.polar, (hq w hw w' hw').2,
    (hq w hw w hw).1, (hq w' hw' w' hw').1, sub_zero, sub_zero]

end RootfulNiemeierType

end TauCeti
