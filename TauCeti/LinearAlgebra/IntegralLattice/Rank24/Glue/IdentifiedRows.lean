/-!
# The table glue subgroups of the separately identified rows

The glue subgroup `H_r = TauCeti.RootfulNiemeierType.glueSubgroup r` of a row of the rootful
rank-24 table is generated by the decoded words of the row's glue columns, in the module of glue
words `r.glueModule` indexed by the positions of the row's component list.  Four rows also have a
separate description, with the components written as an explicit family on `Fin n` and with the
order, Lagrangian and minimum-norm checks proved through a code identification or a cyclic
generator:

| row | separate subgroup | identification |
| --- | --- | --- |
| `A₁²⁴` | `a1TwentyFourthGlueSubgroup`, `a1TwentyFourGlueSubgroup` | extended binary Golay code |
| `A₂¹²` | `a2TwelfthGlueSubgroup` | extended ternary Golay code |
| `D₄⁶` | `d4SixGlueSubgroup` | hexacode |
| `A₁₁ D₇ E₆` | `a11d7e6GlueSubgroup` | cyclic group generated by `[111]` |

This file proves that the table subgroup of each of these rows *is* the separate subgroup.  The
modules are identified by `TauCeti.RootfulNiemeierType.glueModuleIsometry` from
`TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.Table`, the identity on glue words once the
component list of the row is read as the explicit family; it preserves the Conway--Sloane digits
of a word (`encodeGlueWord_glueModuleIsometry`) and its glue minimum
(`sum_glueMinimum_glueModuleIsometry`).  For three rows the generators agree literally.  For
`D₄⁶` they do not: the table spans the `𝔽₄`-scalar orbits of the printed words, while
`d4SixGlueSubgroup` adjoins only `[222222]` to them, so the comparison uses that the latter is
closed under multiplication by `ω` (`d4SixQuaternaryIsometry_symm_smul_mem_d4SixGlueSubgroup`).

Transporting the separate checks then gives, for these rows and for the table subgroup itself,
the order `|H_r| = glueOrder r`, the Lagrangian property, and, except for `A₂¹²`, the bound
`μ(w) ≥ 4` on the glue minimum of every nonzero word.  The two `A₁²⁴` subgroups, defined from the
decoded pattern and from the printed rotations, are shown equal through the binary Golay code
(`a1TwentyFourthGlueSubgroup_eq_a1TwentyFourGlueSubgroup`).

## Main declarations

* `map_glueSubgroup_a1TwentyFourth`, `map_glueSubgroup_a2Twelfth`, `map_glueSubgroup_d4Sixth`,
  `map_glueSubgroup_a11d7e6`: the table subgroups are the separately identified subgroups.
* `natCard_glueSubgroup_*`, `isLagrangian_glueSubgroup_*`,
  `four_le_sum_glueMinimum_of_mem_glueSubgroup_*`: the order, Lagrangian and minimum-norm checks
  of these rows, for the table subgroup.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed.,
  Chapter 4 §3 and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti

open DynkinType FiniteQuadraticModule

/-- **The two `A₁²⁴` glue subgroups agree**: the subgroup generated by the decoded expansions of
`[1(00000101001100110101111)]` is the subgroup generated by the printed rotations, since both
are the preimage of the extended binary Golay code under the same coordinate permutation. -/
theorem a1TwentyFourthGlueSubgroup_eq_a1TwentyFourGlueSubgroup :
    a1TwentyFourthGlueSubgroup = a1TwentyFourGlueSubgroup := by
  ext w
  have hgolay : (a1TwentyFourthGolayIsometry w : Fin 24 → ZMod 2) = a1TableToGolayIsometry w := by
    funext j
    rw [a1TwentyFourthGolayIsometry_apply, a1TableToGolayIsometry_apply,
      typeA1GlueAlphabetZModStandardIsometry_apply, a1TwentyFourthDestinationToSource_apply,
      coe_a1TableToGolayPerm]
  have hmem : w ∈ a1TwentyFourthGlueSubgroup ↔ a1TwentyFourthGolayIsometry w ∈
      a1TwentyFourthGlueSubgroup.map a1TwentyFourthGolayIsometry.toAddEquiv :=
    (AddSubgroup.mem_map_iff_mem (EquivLike.injective _)).symm
  rw [hmem, map_a1TwentyFourthGlueSubgroup_eq_extendedBinaryGolay, mem_a1TwentyFourGlueSubgroup_iff]
  exact iff_of_eq (congrArg (· ∈ BinaryGolay.code) hgolay)

namespace RootfulNiemeierType

/-! ### `A₁²⁴` -/

/-- Every component of `A₁²⁴` is `A₁`. -/
@[simp]
theorem componentType_a1TwentyFourth (i : Fin a1TwentyFourth.components.length) :
    a1TwentyFourth.componentType i = A 1 :=
  congrArg Subtype.val (List.eq_of_mem_replicate (List.getElem_mem _))

private theorem glueWords_a1TwentyFourth :
    a1TwentyFourth.glueWords = a1TwentyFourthPattern.expand := by
  rw [a1TwentyFourthPattern_def, a1TwentyFourthBlock_eq]
  decide

/-- The glue words of the row `A₁²⁴` as words in twenty-four copies of the `A₁` glue alphabet. -/
noncomputable abbrev a1TwentyFourthGlueModuleIsometry :
    Isometry a1TwentyFourth.glueModule a1TwentyFourthGlueModule :=
  a1TwentyFourth.glueModuleIsometry (fun _ ↦ isSimplyLaced_A 1) rfl
    fun i ↦ (componentType_a1TwentyFourth i).symm

/-- **The table glue subgroup of `A₁²⁴` is `a1TwentyFourthGlueSubgroup`**, the subgroup identified
with the extended binary Golay code. -/
theorem map_glueSubgroup_a1TwentyFourth :
    a1TwentyFourth.glueSubgroup.map a1TwentyFourthGlueModuleIsometry.toAddEquiv =
      a1TwentyFourthGlueSubgroup := by
  refine (map_glueSubgroup_glueModuleIsometry _ _ _ _).trans ?_
  rw [glueWords_a1TwentyFourth, a1TwentyFourthGlueSubgroup_def]

/-- **The table glue subgroup of `A₁²⁴` has the displayed order `4096`.** -/
theorem natCard_glueSubgroup_a1TwentyFourth :
    Nat.card a1TwentyFourth.glueSubgroup = a1TwentyFourth.glueOrder :=
  (Nat.card_congr (a1TwentyFourthGlueModuleIsometry.toAddEquiv.addSubgroupMap _).toEquiv).trans <|
    by rw [map_glueSubgroup_a1TwentyFourth, natCard_a1TwentyFourthGlueSubgroup]; rfl

/-- **The table glue subgroup of `A₁²⁴` is a quadratic Lagrangian.** -/
theorem isLagrangian_glueSubgroup_a1TwentyFourth :
    a1TwentyFourth.glueModule.IsLagrangian a1TwentyFourth.glueSubgroup := by
  rw [← a1TwentyFourthGlueModuleIsometry.isLagrangian_map_iff, map_glueSubgroup_a1TwentyFourth]
  exact isLagrangian_a1TwentyFourthGlueSubgroup

/-- **Every nonzero word of the table glue subgroup of `A₁²⁴` has glue minimum at least `4`.** -/
theorem four_le_sum_glueMinimum_of_mem_glueSubgroup_a1TwentyFourth
    {w : a1TwentyFourth.glueModule} (hw : w ∈ a1TwentyFourth.glueSubgroup) (hw0 : w ≠ 0) :
    4 ≤ ∑ i, (a1TwentyFourth.componentType i).glueMinimum
      (a1TwentyFourth.isSimplyLaced_componentType i) (w i) := by
  refine (four_le_sum_glueMinimum_of_mem_a1TwentyFourGlueSubgroup ?_
    ((map_ne_zero_iff _ a1TwentyFourthGlueModuleIsometry.injective).mpr hw0)).trans_eq
      (sum_glueMinimum_glueModuleIsometry _ _ _ _ w)
  rw [← a1TwentyFourthGlueSubgroup_eq_a1TwentyFourGlueSubgroup, ← map_glueSubgroup_a1TwentyFourth]
  exact AddSubgroup.mem_map_of_mem _ hw

