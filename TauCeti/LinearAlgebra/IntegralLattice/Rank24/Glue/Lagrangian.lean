module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.A11D7E6
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.A1TwentyFour
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.A2Twelfth
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.D4Six.Glue
public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.Isotropic

/-!
# Orders, Lagrangian property and glue minima of the rootful rank-24 glue subgroups

For each of the 23 rows `r` of `TauCeti.RootfulNiemeierType`, this file proves the remaining
finite checks of Conway--Sloane's Table 16.1 on the generated glue subgroup `H_r = r.glueSubgroup`
itself, each as a single statement over the row index:

* `H_r` has the displayed order `|H|` (`TauCeti.RootfulNiemeierType.natCard_glueSubgroup`);
* `H_r` is Lagrangian, `H_r = H_r^⊥` (`TauCeti.RootfulNiemeierType.isLagrangian_glueSubgroup`);
* every nonzero word `w ∈ H_r` has glue minimum `μ(w) ≥ 4`
  (`TauCeti.RootfulNiemeierType.four_le_sum_glueMinimum_of_mem_glueSubgroup`).

In every row the upper bound `|H_r| ≤ |H|` is automatic: `H_r` is isotropic
(`TauCeti.RootfulNiemeierType.isIsotropic_glueSubgroup`) in the nondegenerate module of glue
words, whose order is `|H|²` (`TauCeti.RootfulNiemeierType.natCard_glueSubgroup_le`).  The rows are
then treated in two ways.

## Enumerated rows

For the 19 rows other than `A₁²⁴`, `A₂¹²`, `D₄⁶` and `A₁₁ D₇ E₆`, every word of `H_r` is listed by
its Conway--Sloane digits.  The list is built from the zero word by adjoining the generators one
at a time: for the current list `S` and a generator `g`, the multiples `0, g, 2g, …, (m - 1) g`
are computed up to the first multiple `m g` lying in `S`, and the next list consists of the sums
`s + j g`.  Every listed word lies in `H_r`, by induction on the construction.  A proof-producing
computation by `decide` then checks that the list has no repetition and has length `|H|`, and that
every nonzero listed word has `μ(w) ≥ 4`, read off its digits with `TauCeti.glueWordMinimum`.
Since `|H_r| ≤ |H|`, the `|H|` distinct listed words are all of `H_r`; no closure check is needed.

## Code rows and the mixed row

The glue subgroups of `A₁²⁴` and `A₂¹²` have `4096` and `729` words, too many for a kernel
enumeration.  For these rows, and for `D₄⁶` and `A₁₁ D₇ E₆`, the checks are instead transported
from the subgroups built row by row from the printed generators:
`TauCeti.a1TwentyFourGlueSubgroup`, identified with the extended binary Golay code;
`TauCeti.a2TwelfthGlueSubgroup`, identified with the extended ternary Golay code;
`TauCeti.d4SixGlueSubgroup`, identified with the hexacode; and `TauCeti.a11d7e6GlueSubgroup`, the
cyclic group generated by `[111]`.  Each of them has order `|H|` and glue minimum at least `4`,
and its generators encode to digit words of the table row, so it is contained in `H_r`.  An
inclusion of a subgroup of order `|H|` in `H_r`, which has order at most `|H|`, is an equality.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed.,
  Chapter 4 §3 and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti

/-! ### Listing the words of a generated subgroup -/

section Enumeration

variable {n : ℕ} (t : Fin n → DynkinType)

/-- The words `x, x + g, x + 2 g, …`, prepended in reverse order to `acc`, stopping before the
first one that lies in `S`, and after at most `k` of them. -/
private def glueWordMultiples (S : List (List ℕ)) (g : List ℕ) :
    ℕ → List ℕ → List (List ℕ) → List (List ℕ)
  | 0, _, acc => acc
  | k + 1, x, acc =>
    if x ∈ S then acc else glueWordMultiples S g k (glueWordAdd t x g) (x :: acc)

/-- A list of words of the subgroup generated by the digit words `gs`, built from the zero word
by adjoining the generators one at a time: the list for `g :: gs` consists of the sums `s + j g`
of a word `s` in the list for `gs` and a multiple `j g` preceding the first multiple in that
list.  At most `fuel` multiples of each generator are used. -/
private def glueSpanWords (fuel : ℕ) : List (List ℕ) → List (List ℕ)
  | [] => [List.replicate n 0]
  | g :: gs =>
    let S := glueSpanWords fuel gs
    (glueWordMultiples t S g fuel g [List.replicate n 0]).flatMap fun y ↦
      S.map (glueWordAdd t · y)

variable (ht : ∀ i, (t i).IsSimplyLaced) (H : AddSubgroup (∀ i, (t i).glueAlphabet (ht i)))

/-- A digit word is the encoding of a word of `H`. -/
private def EncodesMem (l : List ℕ) : Prop :=
  ∃ w ∈ H, encodeGlueWord t ht w = l

private theorem encodesMem_zero : EncodesMem t ht H (List.replicate n 0) :=
  ⟨0, H.zero_mem, encodeGlueWord_zero t ht⟩

private theorem EncodesMem.glueWordAdd {l l' : List ℕ} (hl : EncodesMem t ht H l)
    (hl' : EncodesMem t ht H l') : EncodesMem t ht H (glueWordAdd t l l') := by
  obtain ⟨w, hw, rfl⟩ := hl
  obtain ⟨w', hw', rfl⟩ := hl'
  exact ⟨w + w', H.add_mem hw hw', encodeGlueWord_add t ht w w'⟩

private theorem encodesMem_of_mem_glueWordMultiples {S : List (List ℕ)} {g : List ℕ}
    (hg : EncodesMem t ht H g) :
    ∀ (k : ℕ) {x : List ℕ} {acc : List (List ℕ)}, EncodesMem t ht H x →
      (∀ y ∈ acc, EncodesMem t ht H y) →
      ∀ y ∈ glueWordMultiples t S g k x acc, EncodesMem t ht H y
  | 0, _, _, _, hacc => hacc
  | k + 1, x, acc, hx, hacc => by
    rw [glueWordMultiples]
    split_ifs
    · exact hacc
    · refine encodesMem_of_mem_glueWordMultiples hg k (hx.glueWordAdd t ht H hg) ?_
      simpa using ⟨hx, hacc⟩

private theorem encodesMem_of_mem_glueSpanWords (fuel : ℕ) :
    ∀ {gs : List (List ℕ)}, (∀ g ∈ gs, EncodesMem t ht H g) →
      ∀ y ∈ glueSpanWords t fuel gs, EncodesMem t ht H y
  | [], _ => by simpa [glueSpanWords] using encodesMem_zero t ht H
  | g :: gs, hgs => by
    have hS := encodesMem_of_mem_glueSpanWords fuel (gs := gs) fun g' hg' ↦
      hgs g' (by simp [hg'])
    have hg := hgs g (by simp)
    simp only [glueSpanWords, List.mem_flatMap, List.mem_map, forall_exists_index, and_imp]
    rintro _ y hy s hs rfl
    refine (hS s hs).glueWordAdd t ht H ?_
    refine encodesMem_of_mem_glueWordMultiples t ht H hg fuel hg ?_ y hy
    simpa using encodesMem_zero t ht H

end Enumeration

namespace RootfulNiemeierType

/-! ### The enumeration of the table rows -/

/-- The digit words that a pattern may expand to: the word itself, the rotations of the marked
block, or all permutations of the positions.  Only those that are digit words of the row are used
as generators. -/
private def candidateWords : GluePattern → List (List ℕ)
  | .literal word => [word]
  | .cyclic pre block post => block.cyclicPermutations.map (pre ++ · ++ post)
  | .evenPermutations word => (List.ofFn word).permutations'

/-- A list of digit words of a row, used as generators of its glue subgroup. -/
private def generatorWords (r : RootfulNiemeierType) : List (List ℕ) :=
  (r.gluePatterns.flatMap candidateWords).filter (· ∈ r.glueWords)

/-- The listed words of the glue subgroup of a row. -/
private def subgroupWords (r : RootfulNiemeierType) : List (List ℕ) :=
  glueSpanWords r.componentType r.glueOrder r.generatorWords

/-- Every listed word of a row is the digit word of a word of its glue subgroup. -/
private theorem exists_mem_glueSubgroup_of_mem_subgroupWords (r : RootfulNiemeierType)
    {l : List ℕ} (hl : l ∈ r.subgroupWords) :
    ∃ w ∈ r.glueSubgroup, encodeGlueWord r.componentType r.isSimplyLaced_componentType w = l := by
  refine encodesMem_of_mem_glueSpanWords _ _ _ _ (fun g hg ↦ ?_) l hl
  obtain ⟨w, hw, hdec⟩ := exists_decodeGlueWord_mem_glueGenerators
    (of_decide_eq_true (List.mem_filter.mp hg).2)
  refine ⟨w, r.glueSubgroup_def ▸ AddSubgroup.subset_closure hw, ?_⟩
  exact ((decodeGlueWord_eq_some_iff _ _ _ _).mp hdec).symm

/-- The finite check: for each of the 19 enumerated rows, the listed words are distinct, there
are `|H|` of them, and every nonzero one has glue minimum at least `4`. -/
private theorem subgroupWords_check (r : RootfulNiemeierType) (h₁ : r ≠ .a1TwentyFourth)
    (h₂ : r ≠ .a2Twelfth) (h₃ : r ≠ .d4Sixth) (h₄ : r ≠ .a11d7e6) :
    r.subgroupWords.Nodup ∧ r.subgroupWords.length = r.glueOrder ∧
      ∀ l ∈ r.subgroupWords, l ≠ List.replicate r.components.length 0 →
        4 ≤ glueWordMinimum r.componentType l := by
  revert h₁ h₂ h₃ h₄
  cases r <;> decide +kernel

/-! ### Orders and glue minima -/

/-- **The glue subgroup of every row has order at most `|H|`**: it is isotropic, hence contained
in its orthogonal complement, in the nondegenerate module of glue words of order `|H|²`. -/
theorem natCard_glueSubgroup_le (r : RootfulNiemeierType) :
    Nat.card r.glueSubgroup ≤ r.glueOrder := by
  have hA := DynkinType.isNondegenerate_pi_glueAlphabet r.componentType
    r.isSimplyLaced_componentType
  have hmul := FiniteBilinearModule.IsNondegenerate.card_mul_card_orthogonalComplement _ hA
    r.glueSubgroup
  have hle := AddSubgroup.card_le_of_le
    ((FiniteBilinearModule.isIsotropic_iff_le_orthogonalComplement _ _).mp
      r.isIsotropic_glueSubgroup.toFiniteBilinearModule)
  have hsq : Nat.card r.glueSubgroup ^ 2 ≤ r.glueOrder ^ 2 := by
    rw [glueOrder_sq_eq_natCard_glueModule, pow_two]
    exact (Nat.mul_le_mul_left _ hle).trans hmul.le
  exact (Nat.pow_le_pow_iff_left two_ne_zero).mp hsq

/-- For an enumerated row, the digit words of the glue subgroup are exactly the listed words, and
the glue subgroup has order `|H|`. -/
private theorem image_encodeGlueWord_glueSubgroup (r : RootfulNiemeierType)
    (h₁ : r ≠ .a1TwentyFourth) (h₂ : r ≠ .a2Twelfth) (h₃ : r ≠ .d4Sixth) (h₄ : r ≠ .a11d7e6) :
    encodeGlueWord r.componentType r.isSimplyLaced_componentType '' r.glueSubgroup =
        {l | l ∈ r.subgroupWords} ∧
      Nat.card r.glueSubgroup = r.glueOrder := by
  obtain ⟨hnd, hlen, -⟩ := subgroupWords_check r h₁ h₂ h₃ h₄
  have hinj := encodeGlueWord_injective r.componentType r.isSimplyLaced_componentType
  have hsub : {l | l ∈ r.subgroupWords} ⊆
      encodeGlueWord r.componentType r.isSimplyLaced_componentType '' r.glueSubgroup :=
    fun l hl ↦ exists_mem_glueSubgroup_of_mem_subgroupWords r hl
  have hT : {l | l ∈ r.subgroupWords}.ncard = r.glueOrder := by
    rw [← hlen, ← List.toFinset_card_of_nodup hnd, ← Set.ncard_coe_finset]
    simp
  have hH : (encodeGlueWord r.componentType r.isSimplyLaced_componentType ''
      r.glueSubgroup).ncard = Nat.card r.glueSubgroup := by
    rw [Set.ncard_image_of_injective _ hinj, ← Nat.card_coe_set_eq, SetLike.coe_sort_coe]
  have hge := Set.ncard_le_ncard hsub
  have hle := natCard_glueSubgroup_le r
  exact ⟨(Set.eq_of_subset_of_ncard_le hsub (by omega)).symm, by omega⟩

/-- The two finite checks on the glue subgroup of a row that are not automatic: it has the
displayed order `|H|`, and each of its nonzero words has glue minimum at least `4`. -/
private def GlueChecks (r : RootfulNiemeierType) : Prop :=
  Nat.card r.glueSubgroup = r.glueOrder ∧ ∀ w ∈ r.glueSubgroup, w ≠ 0 →
    4 ≤ ∑ i, (r.componentType i).glueMinimum (r.isSimplyLaced_componentType i) (w i)

/-- The finite checks hold for every enumerated row. -/
private theorem glueChecks_of_ne (r : RootfulNiemeierType) (h₁ : r ≠ .a1TwentyFourth)
    (h₂ : r ≠ .a2Twelfth) (h₃ : r ≠ .d4Sixth) (h₄ : r ≠ .a11d7e6) : r.GlueChecks := by
  refine ⟨(image_encodeGlueWord_glueSubgroup r h₁ h₂ h₃ h₄).2, fun w hw hw0 ↦ ?_⟩
  have himage := (image_encodeGlueWord_glueSubgroup r h₁ h₂ h₃ h₄).1
  have hmem : encodeGlueWord r.componentType r.isSimplyLaced_componentType w ∈
      r.subgroupWords := by
    simpa only [himage, Set.mem_ofPred_eq] using Set.mem_image_of_mem (encodeGlueWord _ _) hw
  rw [← glueWordMinimum_encodeGlueWord]
  refine (subgroupWords_check r h₁ h₂ h₃ h₄).2.2 _ hmem ?_
  rw [← encodeGlueWord_zero r.componentType r.isSimplyLaced_componentType]
  exact (encodeGlueWord_injective _ _).ne hw0

/-! ### The code rows and the mixed row

The row-by-row subgroups live in the glue words of families indexed by `Fin 24`, `Fin 12`,
`Fin 6` and `Fin 3`, which are the index types `Fin r.components.length` of the table rows once the
length of the exposed component list is computed.  For the rows with one repeated component, the
component at each position is read off `List.replicate` by `List.eq_of_mem_replicate`. -/

/-- **Transport of the finite checks from a subgroup of order `|H|`.**  Let `t` be a family of
components agreeing with those of the row after the identification of their index types, and
`K` a subgroup of the glue words of `t` contained in the subgroup generated by the digit words of
the row.  If `K` has order `|H|` and every nonzero word of `K` has glue minimum at least `4`, then
`K` is the glue subgroup of the row, which therefore passes the same checks. -/
private theorem glueChecks_of_le (r : RootfulNiemeierType) {m : ℕ} {t : Fin m → DynkinType}
    (ht : ∀ i, (t i).IsSimplyLaced) (hm : r.components.length = m)
    (h : ∀ i, r.componentType i = t (Fin.cast hm i))
    (K : AddSubgroup (FiniteQuadraticModule.pi fun i ↦ (t i).glueAlphabet (ht i)))
    (hle : K ≤ AddSubgroup.closure {w | encodeGlueWord t ht w ∈ r.glueWords})
    (hcard : Nat.card K = r.glueOrder)
    (hmin : ∀ w ∈ K, w ≠ 0 → 4 ≤ ∑ i, (t i).glueMinimum (ht i) (w i)) : r.GlueChecks := by
  subst hm
  obtain rfl : r.componentType = t :=
    funext fun i ↦ (h i).trans (congrArg t (congrFun (Fin.cast_refl _ rfl) i))
  have hgen : r.glueGenerators =
      {w | encodeGlueWord r.componentType r.isSimplyLaced_componentType w ∈ r.glueWords} :=
    Set.ext fun _ ↦ mem_glueGenerators_iff
  obtain rfl : K = r.glueSubgroup := by
    refine AddSubgroup.eq_of_le_of_card_ge ?_ (hcard ▸ natCard_glueSubgroup_le r)
    rwa [glueSubgroup_def, hgen]
  exact ⟨hcard, hmin⟩

/-- The finite checks for `A₁²⁴`, transported from the subgroup generated by the printed words,
which corresponds to the extended binary Golay code. -/
private theorem glueChecks_a1TwentyFourth : a1TwentyFourth.GlueChecks := by
  refine glueChecks_of_le _ (m := 24) (t := fun _ ↦ .A 1) (fun _ ↦ DynkinType.isSimplyLaced_A 1)
    rfl (fun _ ↦ congrArg Subtype.val (List.eq_of_mem_replicate (List.getElem_mem _)))
    a1TwentyFourGlueSubgroup ?_ natCard_a1TwentyFourGlueSubgroup
    fun _ hw hw0 ↦ four_le_sum_glueMinimum_of_mem_a1TwentyFourGlueSubgroup hw hw0
  rw [a1TwentyFourGlueSubgroup_def]
  refine AddSubgroup.closure_mono ?_
  rintro _ ⟨r, rfl⟩
  rw [Set.mem_ofPred_eq, encodeGlueWord_glueLabelEquiv]
  simp only [List.ofFn_succ, a1TwentyFourPrintedWord_zero, a1TwentyFourPrintedWord_succ,
    a1TwentyFourPrintedBlock_def]
  revert r
  decide

/-- The finite checks for `A₂¹²`, transported from the subgroup generated by the decoded
expansions of its pattern, which corresponds to the extended ternary Golay code. -/
private theorem glueChecks_a2Twelfth : a2Twelfth.GlueChecks := by
  refine glueChecks_of_le _ (m := 12) (t := fun _ ↦ .A 2) (fun _ ↦ DynkinType.isSimplyLaced_A 2)
    rfl (fun _ ↦ congrArg Subtype.val (List.eq_of_mem_replicate (List.getElem_mem _)))
    a2TwelfthGlueSubgroup ?_ natCard_a2TwelfthGlueSubgroup
    fun _ hw hw0 ↦ four_le_sum_glueMinimum_of_mem_a2TwelfthGlueSubgroup hw hw0
  rw [a2TwelfthGlueSubgroup_def]
  refine AddSubgroup.closure_mono ?_
  rintro w ⟨l, hl, hdec⟩
  rw [decodeGlueWord_eq_some_iff] at hdec
  rw [Set.mem_ofPred_eq, ← hdec]
  exact mem_glueWords_of_mem_expand (List.mem_singleton_self _) hl

/-- The finite checks for `D₄⁶`, transported from the additive subgroup generated by the printed
words and `[222222]`, which corresponds to the hexacode. -/
private theorem glueChecks_d4Sixth : d4Sixth.GlueChecks := by
  refine glueChecks_of_le _ (m := 6) (t := fun _ ↦ .D 4) (fun _ ↦ DynkinType.isSimplyLaced_D 4)
    rfl (fun _ ↦ congrArg Subtype.val (List.eq_of_mem_replicate (List.getElem_mem _)))
    d4SixGlueSubgroup ?_ natCard_d4SixGlueSubgroup
    fun _ hw hw0 ↦ four_le_sum_glueMinimum_of_mem_d4SixGlueSubgroup hw hw0
  rw [d4SixGlueSubgroup_def]
  refine AddSubgroup.closure_mono ?_
  rintro _ ⟨d, hd, rfl⟩
  simp only [d4SixPrintedDigits_def, Set.mem_insert_iff, Set.mem_singleton_iff] at hd
  rw [Set.mem_ofPred_eq, encodeGlueWord_glueLabelEquiv]
  rcases hd with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide

/-- The finite checks for `A₁₁ D₇ E₆`, transported from the cyclic subgroup generated by
`[111]`. -/
private theorem glueChecks_a11d7e6 : a11d7e6.GlueChecks := by
  refine glueChecks_of_le _ (m := 3) (t := TauCeti.a11d7e6) isSimplyLaced_a11d7e6 rfl
    (fun i ↦ by fin_cases i <;> rfl) a11d7e6GlueSubgroup ?_ natCard_a11d7e6GlueSubgroup
    fun _ hw hw0 ↦ four_le_sum_glueMinimum_of_mem_a11d7e6GlueSubgroup hw hw0
  intro w hw
  obtain ⟨k, -, rfl⟩ := mem_a11d7e6GlueSubgroup_iff.mp hw
  refine AddSubgroup.nsmul_mem _ (AddSubgroup.subset_closure ?_) k
  rw [Set.mem_ofPred_eq, encodeGlueWord_a11d7e6GlueWord]
  decide

/-- The finite checks hold for every row of the table. -/
private theorem glueChecks (r : RootfulNiemeierType) : r.GlueChecks := by
  by_cases h₁ : r = .a1TwentyFourth
  · exact h₁ ▸ glueChecks_a1TwentyFourth
  by_cases h₂ : r = .a2Twelfth
  · exact h₂ ▸ glueChecks_a2Twelfth
  by_cases h₃ : r = .d4Sixth
  · exact h₃ ▸ glueChecks_d4Sixth
  by_cases h₄ : r = .a11d7e6
  · exact h₄ ▸ glueChecks_a11d7e6
  exact glueChecks_of_ne r h₁ h₂ h₃ h₄

/-! ### Orders, the Lagrangian property and glue minima -/

/-- **The glue subgroup of every row has the displayed order `|H|`.** -/
@[simp]
theorem natCard_glueSubgroup (r : RootfulNiemeierType) :
    Nat.card r.glueSubgroup = r.glueOrder :=
  r.glueChecks.1

/-- **The glue subgroup of every row is Lagrangian**, `H_r = H_r^⊥`: it is isotropic, and the
square of its order `|H|` is the order of the module of glue words. -/
theorem isLagrangian_glueSubgroup (r : RootfulNiemeierType) :
    r.glueModule.IsLagrangian r.glueSubgroup :=
  r.isIsotropic_glueSubgroup.isLagrangian_of_card_sq_eq _
    (DynkinType.isNondegenerate_pi_glueAlphabet _ _)
    (by rw [natCard_glueSubgroup, glueOrder_sq_eq_natCard_glueModule])

/-- **Every nonzero word of the glue subgroup of every row has glue minimum `μ(w) ≥ 4`.** -/
theorem four_le_sum_glueMinimum_of_mem_glueSubgroup (r : RootfulNiemeierType)
    {w : r.glueModule} (hw : w ∈ r.glueSubgroup) (hw0 : w ≠ 0) :
    4 ≤ ∑ i, (r.componentType i).glueMinimum (r.isSimplyLaced_componentType i) (w i) :=
  r.glueChecks.2 w hw hw0

end RootfulNiemeierType

end TauCeti
