module

public import TauCeti.LinearAlgebra.IntegralLattice.Rank24.Glue.Decode
public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.Glued
public import TauCeti.LinearAlgebra.IntegralLattice.Isometry.Group
public import TauCeti.LinearAlgebra.QuadraticForm.Prod
import TauCeti.LinearAlgebra.Pi

/-!
# Symmetries of subgroups generated by glue patterns

The rotations of a marked block and the even permutations of an alternating pattern preserve
not only its expanded words but also their generated additive subgroup. Reindexing the ADE
components along a pattern symmetry therefore gives an isometry of the corresponding glued
lattices. For a constant family of components these isometries form an action of the pattern's
symmetry group on the glued lattice.

The subgroup here is the additive closure of `GluePattern.decodedWords`. Thus this construction
applies directly to additive-span patterns; it does not replace the scalar-orbit span needed
for the hexacode row. Isotropy is an input to gluing, not inferred from pattern symmetry.

The decoding step uses `GluePattern.decodedWords_comp`, and the lattice step uses
`DynkinType.gluedLatticePiCongrLeftIsometry`, so both actions agree with the existing
discriminant coordinates and gluing operation.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd edition,
  Chapter 4 §3 and Chapter 16 §1, Table 16.1.
-/

public section

namespace TauCeti.GluePattern

open DynkinType IntegralLattice

variable (p : GluePattern) (t : Fin p.length → DynkinType)
  (ht : ∀ i, (t i).IsSimplyLaced) {g : Equiv.Perm (Fin p.length)}

/-- Reindexing by a pattern symmetry carries the subgroup generated by the decoded pattern
for the reindexed components onto the subgroup for the original components. -/
theorem map_closure_decodedWords (hg : g ∈ p.symmetries) :
    (AddSubgroup.closure (p.decodedWords (fun k ↦ t (g k)) (fun k ↦ ht (g k)))).map
        (LinearEquiv.piCongrLeft ℤ (fun i ↦ (t i).glueAlphabet (ht i)) g).toAddEquiv =
      AddSubgroup.closure (p.decodedWords t ht) := by
  rw [AddMonoidHom.map_closure, p.decodedWords_comp t ht hg]
  rw [AddMonoidHom.coe_ofClass, LinearEquiv.coe_toAddEquiv_piCongrLeft]
  exact congrArg AddSubgroup.closure ((Equiv.piCongrLeft _ g).image_symm_image _)

/-- Isotropy of a pattern-generated subgroup is unchanged by an indicated symmetry and
reindexing of its components. -/
theorem isIsotropic_closure_decodedWords_comp_iff (hg : g ∈ p.symmetries) :
    (FiniteQuadraticModule.pi fun k ↦ (t (g k)).glueAlphabet (ht (g k))).IsIsotropic
        (AddSubgroup.closure (p.decodedWords (fun k ↦ t (g k)) (fun k ↦ ht (g k)))) ↔
      (FiniteQuadraticModule.pi fun i ↦ (t i).glueAlphabet (ht i)).IsIsotropic
        (AddSubgroup.closure (p.decodedWords t ht)) := by
  let e : FiniteQuadraticModule.Isometry
      (FiniteQuadraticModule.pi fun k ↦ (t (g k)).glueAlphabet (ht (g k)))
      (FiniteQuadraticModule.pi fun i ↦ (t i).glueAlphabet (ht i)) :=
    QuadraticMap.IsometryEquiv.piCongrLeft
      (fun i ↦ ((t i).glueAlphabet (ht i)).quadratic) g
  have h := FiniteQuadraticModule.Isometry.isIsotropic_map_iff _ e
    (AddSubgroup.closure (p.decodedWords (fun k ↦ t (g k)) (fun k ↦ ht (g k))))
  have he : e.toAddEquiv =
      (LinearEquiv.piCongrLeft ℤ (fun i ↦ (t i).glueAlphabet (ht i)) g).toAddEquiv :=
    congrArg LinearEquiv.toAddEquiv
      (QuadraticMap.IsometryEquiv.toLinearEquiv_piCongrLeft _ _)
  rw [he, p.map_closure_decodedWords t ht hg] at h
  exact h.symm

variable (hv : ∀ i, (t i).Valid)
  (hH : (FiniteQuadraticModule.pi fun i ↦ (t i).glueAlphabet (ht i)).IsIsotropic
    (AddSubgroup.closure (p.decodedWords t ht)))

/-- A symmetry of a glue pattern induces a lattice isometry from the reindexed gluing to the
original gluing, along the additive subgroups generated by that pattern. -/
noncomputable def gluedLatticeIsometry (hg : g ∈ p.symmetries) :
    IntegralLattice.Isometry
      (DynkinType.gluedLattice (fun k ↦ t (g k)) (fun k ↦ ht (g k)) (fun k ↦ hv (g k))
        (AddSubgroup.closure (p.decodedWords (fun k ↦ t (g k)) (fun k ↦ ht (g k))))
        ((p.isIsotropic_closure_decodedWords_comp_iff t ht hg).mpr hH))
      (DynkinType.gluedLattice t ht hv (AddSubgroup.closure (p.decodedWords t ht)) hH) :=
  gluedLatticePiCongrLeftIsometry t ht hv _ hH g
    ((p.isIsotropic_closure_decodedWords_comp_iff t ht hg).mpr hH) fun w ↦ by
      rw [← p.map_closure_decodedWords t ht hg]
      have hmem := AddSubgroup.mem_map_iff_mem
        (f := (LinearEquiv.piCongrLeft ℤ
          (fun i ↦ (t i).glueAlphabet (ht i)) g).toAddEquiv.toAddMonoidHom)
        (LinearEquiv.piCongrLeft ℤ (fun i ↦ (t i).glueAlphabet (ht i)) g).injective
        (K := AddSubgroup.closure
          (p.decodedWords (fun k ↦ t (g k)) (fun k ↦ ht (g k)))) (x := w)
      simpa only [AddEquiv.toAddMonoidHom_eq_coe, AddMonoidHom.coe_ofClass,
        LinearEquiv.coe_toAddEquiv_piCongrLeft] using hmem

/-- The induced lattice isometry moves the component in position `k` to position `g k`. -/
@[simp]
theorem gluedLatticeIsometry_apply (hg : g ∈ p.symmetries)
    (x : ∀ k, Fin (t (g k)).rank → ℚ) (k : Fin p.length) :
    p.gluedLatticeIsometry t ht hv hH hg x (g k) = x k :=
  gluedLatticePiCongrLeftIsometry_apply _ _ _ _ _ _ _ _ x k

section Constant

variable (T : DynkinType) (hT : T.IsSimplyLaced) (vT : T.Valid)
  (h : (FiniteQuadraticModule.pi fun _ : Fin p.length ↦ T.glueAlphabet hT).IsIsotropic
    (AddSubgroup.closure (p.decodedWords (fun _ ↦ T) (fun _ ↦ hT))))

/-- For equal ADE components, the indicated symmetries of a pattern act on its glued lattice
by permuting the components. This is the actual lattice action, not just an action on words. -/
noncomputable def gluedLatticeIsometryHom :
    p.symmetries →* IntegralLattice.Isometry
      (DynkinType.gluedLattice (fun _ : Fin p.length ↦ T) (fun _ ↦ hT) (fun _ ↦ vT)
        (AddSubgroup.closure (p.decodedWords (fun _ ↦ T) (fun _ ↦ hT))) h)
      (DynkinType.gluedLattice (fun _ : Fin p.length ↦ T) (fun _ ↦ hT) (fun _ ↦ vT)
        (AddSubgroup.closure (p.decodedWords (fun _ ↦ T) (fun _ ↦ hT))) h) where
  toFun g := p.gluedLatticeIsometry (fun _ ↦ T) (fun _ ↦ hT) (fun _ ↦ vT) h g.property
  map_one' := by
    apply Isometry.ext
    intro x
    rw [Isometry.one_apply]
    funext i
    exact p.gluedLatticeIsometry_apply _ _ (fun _ ↦ vT) h (one_mem _) x i
  map_mul' a b := by
    apply Isometry.ext
    intro x
    funext i
    obtain ⟨k, rfl⟩ := (a.val * b.val).surjective i
    rw [Isometry.mul_apply, p.gluedLatticeIsometry_apply _ _ _ h
      (mul_mem a.property b.property)]
    exact ((p.gluedLatticeIsometry_apply _ _ (fun _ ↦ vT) h a.property _ (b.val k)).trans
      (p.gluedLatticeIsometry_apply _ _ (fun _ ↦ vT) h b.property x k)).symm

/-- The action of a pattern symmetry sends component `k` to component `g k`. -/
@[simp]
theorem gluedLatticeIsometryHom_apply (g : p.symmetries)
    (x : Fin p.length → Fin T.rank → ℚ) (k : Fin p.length) :
    p.gluedLatticeIsometryHom T hT vT h g x (g.val k) = x k :=
  p.gluedLatticeIsometry_apply _ _ _ h g.property x k

end Constant

end TauCeti.GluePattern
