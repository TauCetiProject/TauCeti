module

public import TauCeti.LinearAlgebra.IntegralLattice.Isometry.Group
public import TauCeti.LinearAlgebra.IntegralLattice.Norm
import Mathlib.LinearAlgebra.Span.Basic

/-!
# Permutation representations on lattice norm shells

Self-isometries of an integral lattice permute its vectors of any specified norm. If those
vectors span the rational ambient space, this permutation representation is faithful. It
represents the full lattice isometry group, not merely a subgroup generated by selected
isometries.

The construction restricts the native carrier equivalence of a lattice isometry; faithfulness
uses `LinearMap.ext_on` on the rational span of the shell.
-/

public section

namespace TauCeti.IntegralLattice.Isometry

variable {V : Type*} [AddCommGroup V] [Module ℚ V] {L : IntegralLattice V}

/-- The permutation representation of the full lattice isometry group on a norm shell. -/
def normShellHom (L : IntegralLattice V) (n : ℚ) :
    Isometry L L →* Equiv.Perm (L.vectorsOfNorm n) where
  toFun e := e.carrierEquiv.toEquiv.subtypeEquiv fun x ↦
    (e.carrierEquiv_mem_vectorsOfNorm_iff x n).symm
  map_one' := by
    ext x
    simp
  map_mul' e f := by
    ext x
    simp

/-- On ambient vectors, the shell permutation is the original lattice isometry. -/
@[simp]
theorem coe_normShellHom_apply (e : Isometry L L) (n : ℚ) (x : L.vectorsOfNorm n) :
    ((normShellHom L n e x : L) : V) = e (x : L) := by
  simp [normShellHom]

/-- On ambient vectors, the inverse shell permutation is the inverse lattice isometry. -/
@[simp]
theorem coe_normShellHom_symm_apply (e : Isometry L L) (n : ℚ) (x : L.vectorsOfNorm n) :
    (((normShellHom L n e).symm x : L) : V) = e.symm (x : L) := by
  simp [normShellHom]

/-- Isometries are determined by a norm shell that spans their rational ambient space. -/
theorem normShellHom_injective (n : ℚ)
    (hspan : Submodule.span ℚ (Subtype.val '' L.vectorsOfNorm n : Set V) = ⊤) :
    Function.Injective (normShellHom L n) := by
  intro e f hef
  have heq : (e : V ≃ₗ[ℚ] V).toLinearMap = (f : V ≃ₗ[ℚ] V).toLinearMap := by
    apply LinearMap.ext_on hspan
    rintro _ ⟨x, hx, rfl⟩
    simpa only [LinearEquiv.coe_coe, coe_toLinearEquiv, coe_normShellHom_apply] using
      congrArg (fun p : Equiv.Perm (L.vectorsOfNorm n) ↦ ((p ⟨x, hx⟩ : L) : V)) hef
  exact Isometry.ext fun x ↦ LinearMap.congr_fun heq x

end TauCeti.IntegralLattice.Isometry
