module

public import TauCeti.LinearAlgebra.IntegralLattice.Isometry.Reflection
public import TauCeti.LinearAlgebra.IntegralLattice.Quadratic
public import TauCeti.LinearAlgebra.IntegralLattice.Unimodular
public import TauCeti.LinearAlgebra.QuadraticForm.ModTwo
public import TauCeti.LinearAlgebra.QuadraticForm.OrthogonalGroup.Basic

/-!
# Isometries of an even lattice modulo two

An even integral lattice `L` carries the integral quadratic form `q(x) = B(x, x) / 2`
(`TauCeti.IntegralLattice.quadraticForm`), whose reduction modulo two is a quadratic form `Q₂`
over `ZMod 2` on the `ZMod 2`-vector space `L / 2L`, with polar form `B` modulo two. When `L` is
unimodular, `Q₂` is nonsingular.

Every isometry of `L` preserves `q`, so its reduction modulo two lies in the orthogonal group of
`Q₂`. This gives a homomorphism `O(L) → O(Q₂)` with kernel the principal congruence subgroup of
level two. It carries the reflection in a vector `r` of norm `2` or `-2`, `y ↦ y ∓ B(r, y) r`,
to the orthogonal transvection `y ↦ y + b(y, [r]) [r]` of `L / 2L` in the class `[r]` of `r`, whose
value `Q₂ [r] = 1` is invertible: in characteristic two this transvection is the reflection
`TauCeti.QuadraticMap.reflectionOrthogonal` in `[r]`.

Since orthogonal groups of nonsingular quadratic spaces in characteristic two are generated by
their transvections outside one small exception, these statements reduce the surjectivity of
`O(L) → O(Q₂)` to finding roots in the classes `c` with `Q₂ c = 1`.

## Main declarations

* `TauCeti.IntegralLattice.nondegenerate_polarBilin_reduceModTwo_quadraticForm`: `Q₂` is
  nonsingular when `L` is unimodular.
* `TauCeti.IntegralLattice.Isometry.reductionModTwoHom`: the homomorphism `O(L) → O(Q₂)`, acting
  as `TauCeti.IntegralLattice.Isometry.reductionHom` (`coe_reductionModTwoHom_apply`), with kernel
  `congruenceSubgroup L 2` (`ker_reductionModTwoHom`).
* `TauCeti.IntegralLattice.Isometry.reductionModTwoHom_rootReflection` and
  `TauCeti.IntegralLattice.Isometry.reductionModTwoHom_negRootReflection`: reflections in vectors
  of norm `±2` reduce to orthogonal transvections.

## References

* V. V. Nikulin, *Integral symmetric bilinear forms and some of their applications*, §1.
* V. Gritsenko and K. Hulek, *Moduli of polarized Enriques surfaces*, §2.
-/

public section

namespace TauCeti.IntegralLattice

variable {V : Type*} [AddCommGroup V] [Module ℚ V] {L : IntegralLattice V} (hL : L.IsEven)

/-- **The reduction modulo two of an even unimodular lattice is nonsingular.** For an even
unimodular lattice `L`, the polar form of the quadratic form `B(x, x) / 2 mod 2` on `L / 2L` is
nondegenerate. -/
theorem nondegenerate_polarBilin_reduceModTwo_quadraticForm (hu : L.IsUnimodular) :
    (L.quadraticForm hL).reduceModTwo.polarBilin.Nondegenerate :=
  QuadraticForm.nondegenerate_polarBilin_reduceModTwo _ <| by
    have := hu.isPerfPair_integralForm
    rw [polarBilin_quadraticForm]
    exact LinearMap.IsPerfPair.bijective_left _

namespace Isometry

/-- The reduction modulo two of an isometry, as a `ZMod 2`-linear automorphism of `L / 2L`. -/
private noncomputable def reductionModTwoEquiv (g : Isometry L L) :
    QuotSMulTop (2 : ℤ) L ≃ₗ[ZMod 2] QuotSMulTop (2 : ℤ) L where
  toFun := reductionHom L 2 g
  map_add' := map_add _
  map_smul' := ZMod.map_smul (reductionHom L 2 g)
  invFun := reductionHom L 2 g⁻¹
  left_inv c := by
    rw [← mul_apply_eq_comp, ← map_mul, inv_mul_cancel, map_one, one_apply_eq_self]
  right_inv c := by
    rw [← mul_apply_eq_comp, ← map_mul, mul_inv_cancel, map_one, one_apply_eq_self]

private theorem reductionModTwoEquiv_apply (g : Isometry L L) (c : QuotSMulTop (2 : ℤ) L) :
    reductionModTwoEquiv g c = reductionHom L 2 g c :=
  (rfl)

/-- **The action of `O(L)` on `L / 2L` as orthogonal transformations.** For an even lattice `L`,
the reduction modulo two of a self-isometry of `L` preserves the quadratic form
`B(x, x) / 2 mod 2` on `L / 2L`, giving a homomorphism from `O(L)` to the orthogonal group of
that form. -/
noncomputable def reductionModTwoHom :
    Isometry L L →* QuadraticMap.orthogonalGroup (L.quadraticForm hL).reduceModTwo where
  toFun g := ⟨reductionModTwoEquiv g, QuadraticMap.mem_orthogonalGroup_iff.mpr fun c ↦ by
    induction c using Submodule.Quotient.induction_on with
    | _ x =>
      rw [reductionModTwoEquiv_apply, reductionHom_apply_mk, QuadraticForm.reduceModTwo_mk,
        QuadraticForm.reduceModTwo_mk, quadraticForm_apply, quadraticForm_apply,
        integralNorm_carrierEquiv]⟩
  map_one' := Subtype.ext <| LinearEquiv.ext fun c ↦ by
    rw [reductionModTwoEquiv_apply, map_one, one_apply_eq_self, Subgroup.coe_one,
      one_apply_eq_self]
  map_mul' g h := Subtype.ext <| LinearEquiv.ext fun c ↦ by
    rw [reductionModTwoEquiv_apply, map_mul, mul_apply_eq_comp, Subgroup.coe_mul,
      mul_apply_eq_comp, reductionModTwoEquiv_apply, reductionModTwoEquiv_apply]

/-- The orthogonal transformation of `L / 2L` induced by an isometry is its reduction modulo
two. -/
@[simp]
theorem coe_reductionModTwoHom_apply (g : Isometry L L) (c : QuotSMulTop (2 : ℤ) L) :
    (reductionModTwoHom hL g : QuotSMulTop (2 : ℤ) L ≃ₗ[ZMod 2] QuotSMulTop (2 : ℤ) L) c =
      reductionHom L 2 g c :=
  (rfl)

/-- The kernel of `O(L) → O(Q₂)` is the principal congruence subgroup of level two. -/
@[simp]
theorem ker_reductionModTwoHom : (reductionModTwoHom hL).ker = congruenceSubgroup L 2 := by
  ext g
  rw [MonoidHom.mem_ker, ← ker_reductionHom, MonoidHom.mem_ker]
  constructor
  · intro h
    refine LinearMap.ext fun c ↦ ?_
    simpa using congrArg (fun σ : QuadraticMap.orthogonalGroup _ ↦
      (σ : QuotSMulTop (2 : ℤ) L ≃ₗ[ZMod 2] QuotSMulTop (2 : ℤ) L) c) h
  · intro h
    refine Subtype.ext <| LinearEquiv.ext fun c ↦ ?_
    simpa using LinearMap.congr_fun h c

/-- **Root reflections reduce to orthogonal transvections.** The reflection in a lattice vector
`x` of norm `2` acts on `L / 2L` as the orthogonal transvection in the class of `x`, the
characteristic-two reflection `y ↦ y + b(y, [x]) [x]` of the quadratic form `Q₂`, for which
`Q₂ [x] = 1`. -/
theorem reductionModTwoHom_rootReflection (x : L) (hx : L.integralNorm x = 2)
    [Invertible ((L.quadraticForm hL).reduceModTwo (Submodule.Quotient.mk x))] :
    reductionModTwoHom hL (rootReflection x hx) =
      QuadraticMap.reflectionOrthogonal _ (Submodule.Quotient.mk x) := by
  have hinv : ⅟((L.quadraticForm hL).reduceModTwo (Submodule.Quotient.mk x)) = 1 :=
    invOf_eq_right_inv (by simp [hx])
  ext c
  induction c using Submodule.Quotient.induction_on with
  | _ y =>
    simp [QuadraticMap.reflection_apply, hinv, Int.cast_smul_eq_zsmul]

/-- **Reflections in vectors of norm `-2` reduce to orthogonal transvections.** The reflection in
a lattice vector `x` of norm `-2` acts on `L / 2L` as the orthogonal transvection in the class
of `x`, the characteristic-two reflection `y ↦ y + b(y, [x]) [x]` of the quadratic form `Q₂`, for
which `Q₂ [x] = 1`. -/
theorem reductionModTwoHom_negRootReflection (x : L) (hx : L.integralNorm x = -2)
    [Invertible ((L.quadraticForm hL).reduceModTwo (Submodule.Quotient.mk x))] :
    reductionModTwoHom hL (negRootReflection x hx) =
      QuadraticMap.reflectionOrthogonal _ (Submodule.Quotient.mk x) := by
  have hinv : ⅟((L.quadraticForm hL).reduceModTwo (Submodule.Quotient.mk x)) = 1 :=
    invOf_eq_right_inv (by simp [hx])
  ext c
  induction c using Submodule.Quotient.induction_on with
  | _ y =>
    simp [QuadraticMap.reflection_apply, hinv, Int.cast_smul_eq_zsmul, sub_eq_add_neg]

end Isometry

end TauCeti.IntegralLattice
