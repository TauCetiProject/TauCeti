module

public import Mathlib.Algebra.MonoidAlgebra.Module
public import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
public import Mathlib.LinearAlgebra.Unimodular
public import Mathlib.RingTheory.LocalRing.Basic
public import Mathlib.GroupTheory.GroupAction.SubMulAction

/-!
# Unimodular elements: scalar extension, unit rescaling, and local coordinates

Complements to `Mathlib.LinearAlgebra.Unimodular`. Unimodularity of an element `v` of an
`R`-module (some linear functional takes the value `1` at `v`) is invariant under linear
equivalences and under multiplication by units, so each unit multiple or linear-automorphism image
of a unimodular vector can be used as a generator when constructing projective orbit morphisms.
Extending scalars preserves unimodularity, including along maps to
noncommutative algebras. A coordinate vector `v : ι → R` with a unit coordinate is unimodular.
Over a directly finite local semiring the converse holds for finitely many coordinates: `v` is
unimodular exactly when one of its coordinates is a unit. In particular this applies to local
commutative rings, where it normalizes homogeneous coordinates of points of projective schemes,
and, since the rows of an invertible matrix are unimodular, it gives every such row a unit entry.

## Main results

* `Module.IsUnimodular.map_linearEquiv` and `LinearEquiv.isUnimodular_apply_iff`: linear
  equivalences preserve unimodularity.
* `Units.isUnimodular_smul_iff`: unit rescaling leaves unimodularity unchanged.
* `TauCeti.Module.unimodularSubMulAction`: the unimodular vectors, stable under unit rescaling;
  its orbits under the units are the unimodular vectors up to a unit, such as the points of the
  projective line `ℙ¹(R)` for `M = R²` over a local ring.
* `Module.IsUnimodular.one_tmul`: scalar extension preserves a unimodular vector.
* `Module.IsUnimodular.tmul`: the pure tensor product of two unimodular vectors is unimodular.
* `Module.IsUnimodular.span_singleton_eq_iff`: cyclic submodules generated by a unimodular
  vector agree precisely up to unit rescaling, even over rings with zero divisors.
* `Module.IsUnimodular.exists_units_smul_of_tmul_eq_tmul`: uniqueness up to a unit scalar of the
  factors of a pure tensor whose reference factors are unimodular, over any commutative semiring.
* `Module.IsUnimodular.span_singleton_tmul_eq_iff`: a pure tensor spans the same cyclic submodule as
  a tensor of unimodular vectors precisely when its factors span the same cyclic submodules.
* `IsUnit.isUnimodular_pi`: a coordinate vector with a unit coordinate is unimodular.
* `Module.isUnimodular_mk_one`: a vector `(v, 1)` of `M × R` is unimodular.
* `Module.Basis.isUnimodular`: every vector of a basis is unimodular.
* `MonoidAlgebra.isUnimodular_single`: the basis vectors `single i 1` of a monoid algebra are
  unimodular.
* `Matrix.isUnimodular_apply_of_isUnit_det` and `Matrix.GeneralLinearGroup.isUnimodular_apply`:
  every row of an invertible square matrix is unimodular, and
  `Matrix.GeneralLinearGroup.isUnimodular_vecMul_iff`: right-multiplying by an invertible matrix
  preserves unimodularity.
* `TauCeti.Module.isUnimodular_pi_iff`: a finitely indexed coordinate vector `v : ι → R` over a
  semiring is unimodular if and only if `∑ i, v i * b i = 1` for some `b`.
* `TauCeti.Module.isUnimodular_iff_exists_isUnit`: over a directly finite local semiring, a vector
  with finitely many coordinates is unimodular if and only if one of its coordinates is a unit.
* `TauCeti.forall_mul_eq_mul_iff_exists_units`: two coordinate families generating the unit ideal
  are unit multiples of one another exactly when their `2 × 2` minors vanish.
-/

public section

open scoped TensorProduct

namespace Module.IsUnimodular

/-- Extending scalars preserves a unimodular vector. No flatness or commutativity of the target
algebra is needed. -/
theorem one_tmul {R S M : Type*} [CommSemiring R] [Semiring S]
    [Algebra R S] [AddCommMonoid M] [Module R M] {m : M}
    (hm : Module.IsUnimodular R m) : Module.IsUnimodular S (1 ⊗ₜ[R] m : S ⊗[R] M) := by
  obtain ⟨φ, hφ⟩ := Module.isUnimodular_iff.mp hm
  exact Module.isUnimodular_of_apply_eq_one
    (f := (TensorProduct.AlgebraTensorModule.rid R S S).toLinearMap.comp (φ.baseChange S))
    (by simp [hφ])

/-- The pure tensor product of two unimodular vectors is unimodular. -/
theorem tmul {R M N : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M]
    [AddCommMonoid N] [Module R N] {m : M} {n : N}
    (hm : Module.IsUnimodular R m) (hn : Module.IsUnimodular R n) :
    Module.IsUnimodular R (m ⊗ₜ[R] n) := by
  obtain ⟨φ, hφ⟩ := Module.isUnimodular_iff.mp hm
  obtain ⟨ψ, hψ⟩ := Module.isUnimodular_iff.mp hn
  exact Module.isUnimodular_of_apply_eq_one
    (f := (TensorProduct.lid R R).toLinearMap.comp (TensorProduct.map φ ψ)) (by simp [hφ, hψ])

end Module.IsUnimodular

section Semiring

variable {R M : Type*} [Semiring R] [AddCommMonoid M] [Module R M]

/-- Every linear equivalence preserves unimodularity. -/
theorem Module.IsUnimodular.map_linearEquiv {N : Type*} [AddCommMonoid N] [Module R N]
    {m : M} (hm : Module.IsUnimodular R m) (e : M ≃ₗ[R] N) :
    Module.IsUnimodular R (e m) := by
  obtain ⟨f, hf⟩ := Module.isUnimodular_iff.mp hm
  exact Module.isUnimodular_of_apply_eq_one (f := f.comp e.symm.toLinearMap) (by simp [hf])

/-- Applying a linear equivalence leaves unimodularity unchanged. -/
@[simp]
theorem LinearEquiv.isUnimodular_apply_iff {N : Type*} [AddCommMonoid N] [Module R N]
    (e : M ≃ₗ[R] N) {m : M} :
    Module.IsUnimodular R (e m) ↔ Module.IsUnimodular R m :=
  ⟨fun hm ↦ by simpa using hm.map_linearEquiv e.symm, fun hm ↦ hm.map_linearEquiv e⟩

/-- Unit rescaling leaves unimodularity unchanged. -/
@[simp]
theorem Units.isUnimodular_smul_iff (c : Rˣ) {m : M} :
    Module.IsUnimodular R (c • m) ↔ Module.IsUnimodular R m := by
  have forward (c : Rˣ) {m : M} (hm : Module.IsUnimodular R m) :
      Module.IsUnimodular R (c • m) := by
    obtain ⟨f, hf⟩ := Module.isUnimodular_iff.mp hm
    exact Module.isUnimodular_of_apply_eq_one
      (f := (LinearMap.mulRight R (↑c⁻¹ : R)).comp f) (by
        simp [LinearMap.mulRight_apply, Units.smul_def, hf])
  exact ⟨fun h ↦ by simpa using forward c⁻¹ h, forward c⟩

/-- A coordinate vector with a unit coordinate is unimodular. -/
theorem IsUnit.isUnimodular_pi {ι : Type*} {v : ι → R} {i : ι} (hi : IsUnit (v i)) :
    Module.IsUnimodular R v :=
  Module.isUnimodular_of_apply_eq_one
    (f := (LinearMap.mulRight R (↑hi.unit⁻¹ : R)).comp (LinearMap.proj i)) (by simp)

/-- A vector `(v, 1)` of `M × R` is unimodular: the second projection takes the value `1` at it.
These are the vectors spanning the lines of the affine chart `M ⊆ P(M × R)`. -/
theorem Module.isUnimodular_mk_one (v : M) : Module.IsUnimodular R ((v, 1) : M × R) :=
  Module.isUnimodular_of_apply_eq_one (f := LinearMap.snd R M R) rfl

/-- Every vector of a basis is unimodular: its coordinate functional takes the value `1` at it. -/
theorem Module.Basis.isUnimodular {ι : Type*} (b : Module.Basis ι R M) (i : ι) :
    Module.IsUnimodular R (b i) :=
  Module.isUnimodular_of_apply_eq_one (f := b.coord i) (by simp)

/-- The basis vectors `single i 1` of a monoid algebra are unimodular. -/
theorem MonoidAlgebra.isUnimodular_single {ι : Type*} (i : ι) :
    Module.IsUnimodular R (MonoidAlgebra.single i (1 : R)) :=
  (MonoidAlgebra.basis ι R).isUnimodular i

end Semiring

namespace TauCeti.Module

variable (R M : Type*) [Semiring R] [AddCommMonoid M] [Module R M]

/-- The unimodular vectors of `M`, which are stable under multiplication by the units of `R`
(`Units.isUnimodular_smul_iff`). Its orbits under `Rˣ` are the unimodular vectors up to a unit;
for `M = R²` over a commutative local ring they are the points of the projective line `ℙ¹(R)`. -/
def unimodularSubMulAction : SubMulAction Rˣ M where
  carrier := {v | Module.IsUnimodular R v}
  smul_mem' c _ hv := (Units.isUnimodular_smul_iff c).mpr hv

variable {R M}

@[simp]
theorem mem_unimodularSubMulAction {v : M} :
    v ∈ unimodularSubMulAction R M ↔ Module.IsUnimodular R v :=
  Iff.rfl

end TauCeti.Module

/-- Every row of a square matrix of unit determinant is unimodular: the functional
`w ↦ (w ᵥ* σ⁻¹) l` takes the value `1` at the row `σ l`. -/
theorem Matrix.isUnimodular_apply_of_isUnit_det {R m : Type*} [CommRing R] [Fintype m]
    [DecidableEq m] {σ : Matrix m m R} (hσ : IsUnit σ.det) (l : m) :
    Module.IsUnimodular R (σ l) := by
  refine Module.isUnimodular_of_apply_eq_one
    (f := (LinearMap.proj l).comp (Matrix.vecMulLinear σ⁻¹)) ?_
  have hone : (σ * σ⁻¹) l l = 1 := by rw [Matrix.mul_nonsing_inv _ hσ, Matrix.one_apply_eq]
  simpa [Matrix.mul_apply, Matrix.vecMul, dotProduct] using hone

section Matrix

open scoped Matrix

/-- Right-multiplying a row vector by an invertible matrix over a semiring preserves
unimodularity. -/
@[simp]
theorem Matrix.GeneralLinearGroup.isUnimodular_vecMul_iff {R m : Type*} [Semiring R] [Fintype m]
    [DecidableEq m] (g : Matrix.GeneralLinearGroup m R) {v : m → R} :
    Module.IsUnimodular R (v ᵥ* (g : Matrix m m R)) ↔ Module.IsUnimodular R v := by
  let e : (m → R) ≃ₗ[R] (m → R) :=
    LinearEquiv.ofLinearMap (Matrix.vecMulLinear (g : Matrix m m R))
      (Matrix.vecMulLinear (↑g⁻¹ : Matrix m m R))
      (LinearMap.ext fun x ↦ by simp [Matrix.vecMul_vecMul])
      (LinearMap.ext fun x ↦ by simp [Matrix.vecMul_vecMul])
  exact e.isUnimodular_apply_iff

/-- Every row of an invertible matrix over a semiring is unimodular. -/
theorem Matrix.GeneralLinearGroup.isUnimodular_apply {R m : Type*} [Semiring R] [Fintype m]
    [DecidableEq m] (g : Matrix.GeneralLinearGroup m R) (i : m) :
    Module.IsUnimodular R (g i) := by
  have h : Module.IsUnimodular R (Pi.single i (1 : R)) :=
    IsUnit.isUnimodular_pi (i := i) (by simp)
  simpa [Matrix.single_vecMul, Matrix.row_def] using
    (g.isUnimodular_vecMul_iff (v := Pi.single i 1)).mpr h

end Matrix

namespace TauCeti.Module

/-- Over any semiring, a finitely indexed coordinate vector `v : ι → R` is unimodular if and only
if its coordinates generate `R` as a right ideal, that is `∑ i, v i * b i = 1` for some `b`. -/
theorem isUnimodular_pi_iff {R ι : Type*} [Semiring R] [Fintype ι] {v : ι → R} :
    Module.IsUnimodular R v ↔ ∃ b : ι → R, ∑ i, v i * b i = 1 := by
  classical
  constructor
  · intro h
    obtain ⟨f, hf⟩ := Module.isUnimodular_iff.mp h
    rw [LinearMap.pi_apply_eq_sum_univ] at hf
    refine ⟨fun i ↦ f (Pi.single i 1), Eq.trans (Finset.sum_congr rfl fun i _ ↦ ?_) hf⟩
    rw [smul_eq_mul]
    congr 1
    exact congrArg f (funext fun j ↦ by simp [Pi.single_apply, eq_comm])
  · rintro ⟨b, hb⟩
    refine Module.isUnimodular_of_apply_eq_one
      (f := ∑ i : ι, (LinearMap.mulRight R (b i)).comp (LinearMap.proj i)) ?_
    simpa [LinearMap.sum_apply, LinearMap.mulRight_apply] using hb

/-- Over a directly finite local semiring, a vector with finitely many coordinates is unimodular
if and only if one of its coordinates is a unit. -/
theorem isUnimodular_iff_exists_isUnit {R ι : Type*} [Semiring R] [IsLocalRing R]
    [IsDedekindFiniteMonoid R] [Finite ι]
    {v : ι → R} : Module.IsUnimodular R v ↔ ∃ i, IsUnit (v i) := by
  refine ⟨fun h ↦ ?_, fun ⟨i, hi⟩ ↦ hi.isUnimodular_pi⟩
  obtain ⟨f, hf⟩ := Module.isUnimodular_iff.mp h
  classical
  have := Fintype.ofFinite ι
  -- `f v = ∑ᵢ vᵢ f(eᵢ)` is a unit, so one of its summands is.
  rw [LinearMap.pi_apply_eq_sum_univ] at hf
  obtain ⟨i, -, hi⟩ := IsLocalRing.exists_of_isUnit_sum (hf ▸ isUnit_one)
  exact ⟨i, isUnit_of_mul_isUnit_left hi⟩

end TauCeti.Module

namespace TauCeti

variable {R ι : Type*} [CommSemiring R]

/-- If a coordinate family generates the unit ideal and a second family has vanishing `2 × 2`
minors against it, then the second family is a multiple of the first. -/
theorem exists_forall_eq_mul_of_mul_eq_mul {a b : ι → R}
    (ha : Ideal.span (Set.range a) = ⊤) (hab : ∀ i j, b i * a j = b j * a i) :
    ∃ u : R, ∀ j, b j = u * a j := by
  obtain ⟨s, hs⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp
    (ha ▸ Submodule.mem_top : (1 : R) ∈ Ideal.span (Set.range a))
  refine ⟨s.sum fun i r ↦ r * b i, fun j ↦ ?_⟩
  -- Multiply `b j` by `1 = ∑ sᵢ aᵢ` and swap each `aᵢ` with `b j` using the minors.
  calc b j = (s.sum fun i r ↦ r • a i) * b j := by rw [hs, one_mul]
    _ = (s.sum fun i r ↦ r * b i) * a j := by
      simp only [Finsupp.sum_mul, smul_eq_mul, mul_assoc, hab, mul_comm (a _)]

/-- Two coordinate families, each generating the unit ideal, are unit multiples of one another
exactly when all their `2 × 2` minors vanish. -/
theorem forall_mul_eq_mul_iff_exists_units {a b : ι → R}
    (ha : Ideal.span (Set.range a) = ⊤) (hb : Ideal.span (Set.range b) = ⊤) :
    (∀ i j, b i * a j = b j * a i) ↔ ∃ c : Rˣ, ∀ i, b i = c * a i := by
  constructor
  · intro hab
    obtain ⟨u, hu⟩ := exists_forall_eq_mul_of_mul_eq_mul ha hab
    obtain ⟨v, hv⟩ := exists_forall_eq_mul_of_mul_eq_mul hb fun i j ↦ by
      rw [mul_comm, hab j i, mul_comm]
    obtain ⟨t, ht⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp
      (hb ▸ Submodule.mem_top : (1 : R) ∈ Ideal.span (Set.range b))
    -- `u * v` fixes every `b j`, and the `b j` generate the unit ideal.
    have huv : u * v = 1 := by
      calc u * v = u * v * (t.sum fun i r ↦ r • b i) := by rw [ht, mul_one]
        _ = t.sum fun i r ↦ r • b i := by
          simp only [Finsupp.mul_sum, smul_eq_mul]
          refine Finsupp.sum_congr fun i _ ↦ ?_
          rw [mul_left_comm, mul_assoc, ← hv, ← hu]
        _ = 1 := ht
    exact ⟨⟨u, v, huv, by rw [mul_comm, huv]⟩, hu⟩
  · rintro ⟨c, hc⟩ i j
    rw [hc i, hc j, mul_right_comm, mul_assoc]

end TauCeti

namespace Module.IsUnimodular

variable {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M]

/-- A unimodular vector and another vector generate the same cyclic submodule exactly when
one is a unit multiple of the other. This also holds over rings with zero divisors. -/
theorem span_singleton_eq_iff {v : M} (hv : Module.IsUnimodular R v) (w : M) :
    R ∙ v = R ∙ w ↔ ∃ c : Rˣ, c • v = w := by
  constructor
  · intro h
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp
      (h.symm ▸ Submodule.mem_span_singleton_self w)
    obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.mp
      (h ▸ Submodule.mem_span_singleton_self v)
    obtain ⟨f, hf⟩ := Module.isUnimodular_iff.mp hv
    have hab : b * a = 1 := by
      have heq := congrArg f hb
      rw [← ha, map_smul, map_smul] at heq
      simpa [hf] using heq
    exact ⟨⟨a, b, by simpa [mul_comm] using hab, hab⟩, ha⟩
  · rintro ⟨c, rfl⟩
    exact (Submodule.span_singleton_group_smul_eq R c v).symm

section TensorProduct

variable {N : Type*} [AddCommMonoid N] [Module R N]

/-- Two pure-tensor representations of the same element of `M ⊗[R] N` over a commutative semiring
whose reference factors are unimodular differ by reciprocal unit scalars. -/
theorem exists_units_smul_of_tmul_eq_tmul {m m₀ : M} {n n₀ : N}
    (hm₀ : Module.IsUnimodular R m₀) (hn₀ : Module.IsUnimodular R n₀)
    (h : m ⊗ₜ[R] n = m₀ ⊗ₜ[R] n₀) :
    ∃ c : Rˣ, m = c • m₀ ∧ n₀ = c • n := by
  obtain ⟨φ₀, hφ₀⟩ := Module.isUnimodular_iff.mp hm₀
  obtain ⟨ψ₀, hψ₀⟩ := Module.isUnimodular_iff.mp hn₀
  have hn : φ₀ m • n = n₀ := by
    simpa [hφ₀] using
      congrArg ((TensorProduct.lid R N).toLinearMap ∘ₗ LinearMap.rTensor N φ₀) h
  have hm : ψ₀ n • m = m₀ := by
    simpa [hψ₀] using
      congrArg ((TensorProduct.rid R M).toLinearMap ∘ₗ LinearMap.lTensor M ψ₀) h
  have hmul : φ₀ m * ψ₀ n = 1 := by simpa [hψ₀, smul_eq_mul] using congrArg ψ₀ hn
  refine ⟨⟨φ₀ m, ψ₀ n, hmul, by rw [mul_comm, hmul]⟩, ?_, ?_⟩
  · exact Eq.symm (by rw [Units.smul_def, Units.val_mk, ← hm, smul_smul, hmul, one_smul])
  · rw [Units.smul_def, Units.val_mk, hn]

/-- Over a commutative semiring, if `u₀` and `v₀` are unimodular, `u ⊗ₜ v` spans the same
cyclic submodule as `u₀ ⊗ₜ v₀` iff `u` spans `R ∙ u₀` and `v` spans `R ∙ v₀`. -/
theorem span_singleton_tmul_eq_iff {u u₀ : M} {v v₀ : N}
    (hu₀ : Module.IsUnimodular R u₀) (hv₀ : Module.IsUnimodular R v₀) :
    R ∙ (u ⊗ₜ[R] v) = R ∙ (u₀ ⊗ₜ[R] v₀) ↔
      R ∙ u = R ∙ u₀ ∧ R ∙ v = R ∙ v₀ := by
  rw [eq_comm (a := R ∙ (u ⊗ₜ[R] v)), (hu₀.tmul hv₀).span_singleton_eq_iff,
    eq_comm (a := R ∙ u), hu₀.span_singleton_eq_iff,
    eq_comm (a := R ∙ v), hv₀.span_singleton_eq_iff]
  constructor
  · rintro ⟨c, hc⟩
    have hc' : u ⊗ₜ[R] v = (c • u₀) ⊗ₜ[R] v₀ := by
      simpa [TensorProduct.smul_tmul', Units.smul_def] using hc.symm
    obtain ⟨d, hd₁, hd₂⟩ :=
      ((Units.isUnimodular_smul_iff c).mpr hu₀).exists_units_smul_of_tmul_eq_tmul hv₀ hc'
    refine ⟨⟨d * c, by rw [mul_smul, ← hd₁]⟩, ⟨d⁻¹, ?_⟩⟩
    rw [hd₂, inv_smul_smul]
  · rintro ⟨⟨c₁, rfl⟩, ⟨c₂, rfl⟩⟩
    exact ⟨c₁ * c₂, by
      simp only [Units.smul_def, Units.val_mul]
      exact (TensorProduct.smul_tmul_smul (c₁ : R) (c₂ : R) u₀ v₀).symm⟩

end TensorProduct

end Module.IsUnimodular
