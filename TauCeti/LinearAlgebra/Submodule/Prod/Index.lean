module

public import Mathlib.RingTheory.Ideal.Norm.AbsNorm
import TauCeti.RingTheory.Ideal.Norm.AbsNorm

/-!
# Indices of submodules of a product

Let `L` be a submodule of a product `M × N`. Its projection `L.map (LinearMap.fst R M N)` to the
first factor and its intersection `L.comap (LinearMap.inr R M N)` with the second factor
determine its index:
`[M × N : L] = [M : L.map fst] · [N : L.comap inr]`
(`Submodule.cardQuot_eq_cardQuot_map_fst_mul_cardQuot_comap_inr`).

When the first factor is the ring `R` itself and the projection of `L` is the left ideal
`R ∙ g` generated by a non-zero-divisor `g`, the submodule is a graph: it is spanned by one
vector `(g, x)` and its intersection `K` with `N` (`Submodule.eq_span_singleton_sup_map_inr`),
and the class of `x` modulo `K` determines it. So the submodules with projection `R ∙ g` and
intersection `K` are in bijection with `N ⧸ K` (`Submodule.prodFiberEquivQuotient`). This is the
induction step for counting the submodules of given index in a free module over a discrete
valuation ring.

## Main declarations

* `Submodule.cardQuot_eq_cardQuot_map_fst_mul_cardQuot_comap_inr`: the index of a submodule of a
  product.
* `Submodule.prodFiberEquivQuotient`: the submodules of `R × N` with projection `R ∙ g` and
  intersection `K` with `N` correspond to the classes of `N ⧸ K`; it is characterised by
  `Submodule.prodFiberEquivQuotient_eq_mk_iff` and `Submodule.coe_prodFiberEquivQuotient_symm_mk`.

## Attribution

`Submodule.cardQuot_eq_cardQuot_map_fst_mul_cardQuot_comap_inr` and
`Submodule.eq_span_singleton_sup_map_inr` are adapted from
`cardQuot_eq_cardQuot_map_fst_mul_comap_inr` and `eq_span_sup_of_map_fst_eq_span` in the file
`src/New/Spanning/RemainingTerms/Discriminants.lean` of grh-lean
(https://github.com/lsernau/grh-lean, Apache 2.0, Copyright 2026 Anthropic, PBC).
-/

public section

namespace Submodule

variable {R M N : Type*} [Ring R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

/-- The index of a submodule `L` of a product `M × N` is the index of its projection to `M`
times the index of its intersection with `N`. -/
theorem cardQuot_eq_cardQuot_map_fst_mul_cardQuot_comap_inr (L : Submodule R (M × N)) :
    L.cardQuot =
      (L.map (LinearMap.fst R M N)).cardQuot * (L.comap (LinearMap.inr R M N)).cardQuot := by
  -- `L ≤ L ⊔ N`, the preimage of the projection of `L`; the relative index of `L` in it is the
  -- index of `L ∩ N` in `N`.
  set I := LinearMap.range (LinearMap.inr R M N)
  have h_fst : (L ⊔ I).cardQuot = (L.map (LinearMap.fst R M N)).cardQuot := by
    rw [← cardQuot_comap_of_surjective (f := LinearMap.fst R M N) (fun m ↦ ⟨(m, 0), rfl⟩),
      comap_map_eq, LinearMap.ker_fst]
  have h_snd : L.toAddSubgroup.relIndex (L ⊔ I).toAddSubgroup =
      (L.comap (LinearMap.inr R M N)).cardQuot := by
    rw [sup_toAddSubgroup, sup_comm, AddSubgroup.relIndex_sup_right]
    exact (L.toAddSubgroup.index_comap (LinearMap.inr R M N).toAddMonoidHom).symm
  rw [← h_fst, ← h_snd, mul_comm]
  exact (AddSubgroup.relIndex_mul_index (toAddSubgroup_mono le_sup_left)).symm

/-- Let `L` be a submodule of `R × N` whose projection to `R` is the left ideal `R ∙ g`, and let
`(g, x) ∈ L`. Then `L` is spanned by `(g, x)` and its intersection with `N`. -/
theorem eq_span_singleton_sup_map_inr {L : Submodule R (R × N)} {g : R} {x : N}
    (hx : (g, x) ∈ L) (hg : L.map (LinearMap.fst R R N) = R ∙ g) :
    L = (R ∙ (g, x)) ⊔ (L.comap (LinearMap.inr R R N)).map (LinearMap.inr R R N) := by
  refine le_antisymm ?_ (sup_le ((span_singleton_le_iff_mem _ _).2 hx) (map_comap_le _ _))
  rintro ⟨a, y⟩ hay
  obtain ⟨c, rfl⟩ : ∃ c : R, c • g = a := mem_span_singleton.1 (hg.le (mem_map_of_mem hay))
  have h_rest : ((0 : R), y - c • x) ∈ L := by simpa using L.sub_mem hay (L.smul_mem c hx)
  refine mem_sup.2 ⟨c • (g, x), mem_span_singleton.2 ⟨c, rfl⟩, (0, y - c • x),
    mem_map_of_mem (f := LinearMap.inr R R N) h_rest, ?_⟩
  simp

/-- Membership in the submodule of `R × N` spanned by `(g, x)` and a submodule `K` of `N`. -/
theorem mem_span_singleton_sup_map_inr {g : R} {x : N} {K : Submodule R N} {a : R} {y : N} :
    (a, y) ∈ (R ∙ (g, x)) ⊔ K.map (LinearMap.inr R R N) ↔
      ∃ c : R, c * g = a ∧ y - c • x ∈ K := by
  constructor
  · intro h
    obtain ⟨u, hu, v, hv, huv⟩ := mem_sup.1 h
    obtain ⟨c, rfl⟩ := mem_span_singleton.1 hu
    obtain ⟨k, hk, rfl⟩ := mem_map.1 hv
    simp only [Prod.smul_mk, smul_eq_mul, LinearMap.inr_apply, Prod.mk_add_mk, add_zero,
      Prod.mk.injEq] at huv
    exact ⟨c, huv.left, by rwa [← huv.right, add_sub_cancel_left]⟩
  · rintro ⟨c, rfl, hc⟩
    refine mem_sup.2 ⟨c • (g, x), mem_span_singleton.2 ⟨c, rfl⟩, (0, y - c • x),
      mem_map_of_mem (f := LinearMap.inr R R N) hc, ?_⟩
    simp

/-- The projection to `R` of the submodule spanned by `(g, x)` and `K ≤ N` is `R ∙ g`. -/
theorem map_fst_span_singleton_sup_map_inr (g : R) (K : Submodule R N) (x : N) :
    ((R ∙ (g, x)) ⊔ K.map (LinearMap.inr R R N)).map (LinearMap.fst R R N) = R ∙ g := by
  ext a
  simp only [mem_map, Prod.exists, LinearMap.fst_apply, exists_and_right, exists_eq_right,
    mem_span_singleton_sup_map_inr, mem_span_singleton, smul_eq_mul]
  exact ⟨fun ⟨_, c, hc, _⟩ ↦ ⟨c, hc⟩, fun ⟨c, hc⟩ ↦ ⟨c • x, c, hc, by simp⟩⟩

/-- If the projection of `L ≤ R × N` to `R` contains `g`, then `(g, x) ∈ L` for some `x`. -/
theorem exists_mk_mem_of_mem_map_fst {L : Submodule R (R × N)} {g : R}
    (hg : g ∈ L.map (LinearMap.fst R R N)) : ∃ x : N, (g, x) ∈ L := by
  obtain ⟨⟨a, x⟩, hx, rfl⟩ := mem_map.1 hg
  exact ⟨x, hx⟩

section NonZeroDivisor

variable {g : R} (hg : g ∈ nonZeroDivisors R) (K : Submodule R N)
include hg

/-- For a non-zero-divisor `g`, the intersection with `N` of the submodule spanned by `(g, x)`
and `K ≤ N` is `K`. -/
theorem comap_inr_span_singleton_sup_map_inr (x : N) :
    ((R ∙ (g, x)) ⊔ K.map (LinearMap.inr R R N)).comap (LinearMap.inr R R N) = K := by
  ext y
  simp only [mem_comap, LinearMap.inr_apply, mem_span_singleton_sup_map_inr]
  refine ⟨fun ⟨c, hc, hy⟩ ↦ ?_, fun hy ↦ ⟨0, zero_mul g, by simpa using hy⟩⟩
  obtain rfl : c = 0 := (mul_right_mem_nonZeroDivisors_eq_zero_iff hg).1 hc
  simpa using hy

/-- For a non-zero-divisor `g`, if `(g, y)` lies in the submodule spanned by `(g, x)` and
`K ≤ N`, then `y - x ∈ K`. -/
theorem sub_mem_of_mk_mem_span_singleton_sup_map_inr {x y : N}
    (h : (g, y) ∈ (R ∙ (g, x)) ⊔ K.map (LinearMap.inr R R N)) : y - x ∈ K := by
  obtain ⟨c, hc, hy⟩ := mem_span_singleton_sup_map_inr.1 h
  obtain rfl : c = 1 := sub_eq_zero.1 <|
    (mul_right_mem_nonZeroDivisors_eq_zero_iff hg).1 (by rw [sub_mul, hc, one_mul, sub_self])
  rwa [one_smul] at hy

/-- For a non-zero-divisor `g`, the submodules `L` of `R × N` with projection `R ∙ g` to the first
factor and intersection `K` with `N` correspond to the classes of `N ⧸ K`: the class of `x` is
sent to the submodule spanned by `(g, x)` and `K`, and `L` to the class of any `x` with
`(g, x) ∈ L`. -/
noncomputable def prodFiberEquivQuotient :
    {L : Submodule R (R × N) //
        L.map (LinearMap.fst R R N) = R ∙ g ∧ L.comap (LinearMap.inr R R N) = K} ≃ N ⧸ K where
  toFun L := K.mkQ (exists_mk_mem_of_mem_map_fst
    (L.property.left.ge (mem_span_singleton_self g))).choose
  invFun z := ⟨(R ∙ (g, z.out)) ⊔ K.map (LinearMap.inr R R N),
    map_fst_span_singleton_sup_map_inr g K _, comap_inr_span_singleton_sup_map_inr hg K _⟩
  left_inv L := by
    obtain ⟨L, hfst, hinr⟩ := L
    have hx := (exists_mk_mem_of_mem_map_fst (hfst.ge (mem_span_singleton_self g))).choose_spec
    set x := (exists_mk_mem_of_mem_map_fst (hfst.ge (mem_span_singleton_self g))).choose
    have h_out : (g, (K.mkQ x).out) ∈ L := by
      have h_diff : (K.mkQ x).out - x ∈ L.comap (LinearMap.inr R R N) := by
        rw [hinr, ← Submodule.Quotient.eq]
        simp
      simpa using L.add_mem hx h_diff
    have h_eq := eq_span_singleton_sup_map_inr h_out hfst
    rw [hinr] at h_eq
    exact Subtype.ext h_eq.symm
  right_inv z := by
    have hx := (exists_mk_mem_of_mem_map_fst ((map_fst_span_singleton_sup_map_inr g K z.out).ge
      (mem_span_singleton_self g))).choose_spec
    refine ((Submodule.Quotient.eq K).2
      (sub_mem_of_mk_mem_span_singleton_sup_map_inr hg K hx)).trans ?_
    exact Submodule.Quotient.mk_out z

/-- For a non-zero-divisor `g`, the class attached by `Submodule.prodFiberEquivQuotient` to `L` is
the class of `x` exactly when `(g, x) ∈ L`. -/
theorem prodFiberEquivQuotient_eq_mk_iff
    (L : {L : Submodule R (R × N) //
        L.map (LinearMap.fst R R N) = R ∙ g ∧ L.comap (LinearMap.inr R R N) = K}) (x : N) :
    prodFiberEquivQuotient hg K L = Submodule.Quotient.mk x ↔ (g, x) ∈ L.val := by
  obtain ⟨L, hfst, hinr⟩ := L
  have hc := (exists_mk_mem_of_mem_map_fst (hfst.ge (mem_span_singleton_self g))).choose_spec
  set c := (exists_mk_mem_of_mem_map_fst (hfst.ge (mem_span_singleton_self g))).choose
  -- Both sides say `x - c ∈ K`, for the chosen `(g, c) ∈ L`.
  have hmem : (g, x) ∈ L ↔ x - c ∈ K := by
    rw [← hinr, mem_comap, LinearMap.inr_apply]
    exact ⟨fun h ↦ by simpa using L.sub_mem h hc, fun h ↦ by simpa using L.add_mem hc h⟩
  simp only [prodFiberEquivQuotient, Equiv.coe_fn_mk, mkQ_apply]
  rw [eq_comm, Submodule.Quotient.eq, hmem]

/-- For a non-zero-divisor `g`, the submodule attached by `Submodule.prodFiberEquivQuotient` to the
class of `x` is the one spanned by `(g, x)` and `K`. -/
@[simp]
theorem coe_prodFiberEquivQuotient_symm_mk (x : N) :
    ((prodFiberEquivQuotient hg K).symm (Submodule.Quotient.mk x) : Submodule R (R × N)) =
      (R ∙ (g, x)) ⊔ K.map (LinearMap.inr R R N) := by
  have h := (prodFiberEquivQuotient_eq_mk_iff hg K ⟨_, map_fst_span_singleton_sup_map_inr g K x,
    comap_inr_span_singleton_sup_map_inr hg K x⟩ x).2 (mem_sup_left (mem_span_singleton_self _))
  rw [(prodFiberEquivQuotient hg K).symm_apply_eq.2 h.symm]

end NonZeroDivisor

end Submodule
