module

public import Mathlib.Algebra.Algebra.RestrictScalars
public import TauCeti.LinearAlgebra.TensorProduct.Balanced.Unit
public import TauCeti.LinearAlgebra.Matrix.Idempotent

import TauCeti.Algebra.Module.Projective.Semilinear

/-!
# Extension of scalars along a ring homomorphism of noncommutative rings

For a ring homomorphism `f : R →+* S` of possibly noncommutative rings and a left `R`-module `P`,
the extension of scalars `S ⊗_R P` is the balanced tensor product of `S`, regarded as a right
`R`-module through `s · r = s * f r`, with `P`. It is the abelian group generated by symbols
`s ⊗ p`, biadditive and subject to `(s * f r) ⊗ p = s ⊗ (r • p)`, and `S` acts on the left
through the first factor.

Mathlib's `TensorProduct` needs a commutative ring of scalars, and Mathlib's
`ModuleCat.extendScalars` needs `R` and `S` commutative. Here the tensor product is the
balanced tensor product `TauCeti.BalancedTensorProduct ℤ R` over the integers, so no
commutativity is assumed.

## Main definitions

* `TauCeti.BalancedExtension.Scalars f`: the ring `S` as an `(S, R)`-bimodule, with `R` acting on
  the right through `f`.
* `TauCeti.BalancedExtension f P`: the left `S`-module `S ⊗_R P`, with pure tensors
  `TauCeti.BalancedExtension.tmul f s p`.
* `TauCeti.BalancedExtension.includeRight`: the `f`-semilinear map `p ↦ 1 ⊗ p`.
* `TauCeti.BalancedExtension.lift` and `TauCeti.BalancedExtension.liftEquiv`: the universal
  property. `S`-linear maps `S ⊗_R P → Q` correspond to `f`-semilinear maps `P → Q`, that is, to
  additive maps that are `R`-linear for the action on `Q` restricted along `f`.
* `TauCeti.BalancedExtension.map`: functoriality in `R`-linear maps, and
  `TauCeti.BalancedExtension.congr` for `R`-linear equivalences.
* `TauCeti.BalancedExtension.lid`: extension along the identity, `R ⊗_R P ≃ P`.
* `TauCeti.BalancedExtension.moduleBase`: for an `A`-algebra `S`, the `A`-action on `S ⊗_R P`
  restricted from the `S`-action; it is not an instance.
* `TauCeti.BalancedExtension.cancelBaseChange`: extension along a composite,
  `T ⊗_S (S ⊗_R P) ≃ T ⊗_R P`.
* `TauCeti.BalancedExtension.rid`: extension of the regular module, `S ⊗_R R ≃ S`.
* `TauCeti.BalancedExtension.piScalarRight`: extension of a finite free module,
  `S ⊗_R Rⁿ ≃ Sⁿ`.
* `TauCeti.BalancedExtension.piEquiv`: extension of a finite product of modules,
  `S ⊗_R (Π i, M i) ≃ Π i, (S ⊗_R M i)`.
* `TauCeti.BalancedExtension.rangeVecMulLinearEquiv`: extension of the image of an idempotent
  matrix, `S ⊗_R (Rⁿ e) ≃ Sⁿ f(e)`.
* `TauCeti.BalancedExtension.equivTensorProduct`: identification with Mathlib's tensor product
  `S ⊗[R] P` when `R` is commutative and `S` is an `R`-algebra.

The extension of the zero module is zero by the `Subsingleton` instances of
`TauCeti.BalancedTensorProduct`, since `TauCeti.BalancedExtension` is an `abbrev`.

## Main results

* `TauCeti.BalancedExtension.map_surjective`: extension of scalars preserves surjections.
* Extension of scalars along any `f` sends finitely generated `R`-modules to finitely generated
  `S`-modules and projective `R`-modules to projective `S`-modules (instances), hence finitely
  generated projective modules to finitely generated projective modules. No flatness or
  finiteness hypothesis on `f` is needed.

## References

* C. A. Weibel, *The K-book*, Chapter I, §2, pp. 7–8, and Chapter II, §2.8 and
  Example 2.8.1, pp. 12–13.
-/

public section

namespace TauCeti

open MulOpposite

universe u₁ u₂ u₃ v w

variable {R : Type u₁} {S : Type u₂} {T : Type u₃} [Ring R] [Ring S] [Ring T]

namespace BalancedExtension

/-- The ring `S` regarded as an `(S, R)`-bimodule through a ring homomorphism `f : R →+* S`:
`S` acts on the left by multiplication and `R` acts on the right by `s · r = s * f r`. This is a
type synonym so that the right `R`-action is not an instance on `S` itself. -/
@[expose]
def Scalars (_f : R →+* S) : Type u₂ := S

variable (f : R →+* S)

namespace Scalars

instance : AddCommGroup (Scalars f) := inferInstanceAs (AddCommGroup S)

instance : Module S (Scalars f) := inferInstanceAs (Module S S)

/-- The right action of `R` on `S` through `f`, as a left action of `Rᵐᵒᵖ`. -/
instance : Module Rᵐᵒᵖ (Scalars f) := Module.compHom S (RingHom.op f)

/-- The identification of `S` with `Scalars f` as an additive group. -/
def of : S ≃+ Scalars f := AddEquiv.refl S

/-- `S` acts on `Scalars f` by left multiplication. -/
@[simp]
theorem smul_of (s x : S) : s • of f x = of f (s * x) := (rfl)

/-- `R` acts on `Scalars f` on the right through `f`. -/
@[simp]
theorem op_smul_of (r : R) (x : S) : op r • of f x = of f (x * f r) := (rfl)

instance : SMulCommClass S Rᵐᵒᵖ (Scalars f) where
  smul_comm s r x := by
    induction r using MulOpposite.rec'
    obtain ⟨x, rfl⟩ := (of f).surjective x
    simp only [smul_of, op_smul_of, mul_assoc]

end Scalars

end BalancedExtension

/-- The extension of scalars `S ⊗_R P` of a left `R`-module `P` along a ring homomorphism
`f : R →+* S`: the balanced tensor product of `S`, a right `R`-module through `f`, with `P`.
It is a left `S`-module through the first factor. -/
abbrev BalancedExtension (f : R →+* S) (P : Type v) [AddCommGroup P] [Module R P] :
    Type (max u₂ v) :=
  BalancedTensorProduct ℤ R (BalancedExtension.Scalars f) P

namespace BalancedExtension

variable (f : R →+* S) (P : Type v) [AddCommGroup P] [Module R P]

/-- The left `S`-module structure of `S ⊗_R P`, by multiplication on the first factor.

When `S = ℤ` (extension along a ring homomorphism `R →+* ℤ`, such as an augmentation) this is a
second `Module ℤ` structure on `ℤ ⊗_R P`, besides `AddCommGroup.toIntModule`, and the two are not
definitionally equal: `rfl` does not identify them, although `Subsingleton.elim` does, and
elementwise `int_smul_eq_zsmul` rewrites this action to `zsmul`. Instance search for
`Module ℤ (BalancedExtension f P)` finds `AddCommGroup.toIntModule`, so the `Module.Finite S` and
`Module.Projective S` instances below, which are stated for this structure, do not fire at `S = ℤ`
unless this instance is supplied by hand. -/
instance : Module S (BalancedExtension f P) :=
  BalancedTensorProduct.leftModule (k := ℤ) (A := R) (M := Scalars f) (N := P) S

variable {P}

/-- The pure tensor `s ⊗ p` in `S ⊗_R P`. -/
def tmul (s : S) (p : P) : BalancedExtension f P :=
  BalancedTensorProduct.tmul ℤ R (Scalars.of f s) p

theorem tmul_def (s : S) (p : P) :
    tmul f s p = BalancedTensorProduct.tmul ℤ R (Scalars.of f s) p := (rfl)

variable {f}

@[simp]
theorem zero_tmul (p : P) : tmul f 0 p = 0 := by
  rw [tmul_def, map_zero, BalancedTensorProduct.zero_tmul]

@[simp]
theorem tmul_zero (s : S) : tmul f s (0 : P) = 0 :=
  BalancedTensorProduct.tmul_zero ℤ R (Scalars.of f s)

theorem add_tmul (s s' : S) (p : P) : tmul f (s + s') p = tmul f s p + tmul f s' p := by
  rw [tmul_def, _root_.map_add, BalancedTensorProduct.add_tmul, tmul_def, tmul_def]

theorem tmul_add (s : S) (p p' : P) : tmul f s (p + p') = tmul f s p + tmul f s p' :=
  BalancedTensorProduct.tmul_add ℤ R (Scalars.of f s) p p'

/-- The balancing relation `s ⊗ (r • p) = (s * f r) ⊗ p`. -/
theorem tmul_smul (s : S) (r : R) (p : P) : tmul f s (r • p) = tmul f (s * f r) p := by
  rw [tmul_def, tmul_def, ← BalancedTensorProduct.balance, Scalars.op_smul_of]

/-- `S` acts on `S ⊗_R P` by left multiplication on the first factor. -/
@[simp]
theorem smul_tmul (s s' : S) (p : P) : s • tmul f s' p = tmul f (s * s') p :=
  (BalancedTensorProduct.smul_tmul_left (k := ℤ) (A := R) (N := P) S s _ p).trans
    (congrArg (BalancedTensorProduct.tmul ℤ R · p) (Scalars.smul_of f s s'))

theorem tmul_eq_smul_one_tmul (s : S) (p : P) : tmul f s p = s • tmul f 1 p := by
  rw [smul_tmul, mul_one]

/-- Induction on `S ⊗_R P` by pure tensors and addition. -/
@[elab_as_elim]
theorem induction_on {C : BalancedExtension f P → Prop} (x : BalancedExtension f P)
    (tmul : ∀ s p, C (BalancedExtension.tmul f s p)) (add : ∀ x y, C x → C y → C (x + y)) :
    C x :=
  BalancedTensorProduct.induction_on ℤ R x (fun s p ↦ tmul ((Scalars.of f).symm s) p) add

variable {Q : Type w} [AddCommGroup Q] [Module S Q]

/-- `S`-linear maps out of `S ⊗_R P` agree once they agree on the tensors `1 ⊗ p`. -/
@[ext high]
theorem hom_ext {φ ψ : BalancedExtension f P →ₗ[S] Q} (h : ∀ p, φ (tmul f 1 p) = ψ (tmul f 1 p)) :
    φ = ψ := by
  ext x
  induction x using induction_on with
  | tmul s p => rw [tmul_eq_smul_one_tmul, map_smul, map_smul, h]
  | add x y hx hy => rw [_root_.map_add, _root_.map_add, hx, hy]

variable (f P) in
/-- The `f`-semilinear map `p ↦ 1 ⊗ p` into the extension of scalars. -/
def includeRight : P →ₛₗ[f] BalancedExtension f P where
  toFun p := tmul f 1 p
  map_add' := tmul_add 1
  map_smul' r p := by simp only [tmul_smul, one_mul, smul_tmul, mul_one]

@[simp]
theorem includeRight_apply (p : P) : includeRight f P p = tmul f 1 p := (rfl)

/-- The balanced biadditive map `(s, p) ↦ s • g p` attached to an `f`-semilinear map `g`. -/
private def liftAux (g : P →ₛₗ[f] Q) : Scalars f →ₗ[ℤ] P →ₗ[ℤ] Q :=
  LinearMap.mk₂ ℤ (fun s p ↦ (Scalars.of f).symm s • g p)
    (fun _ _ _ ↦ by rw [_root_.map_add, add_smul]) (fun _ _ _ ↦ by rw [map_zsmul, smul_assoc])
    (fun _ _ _ ↦ by rw [_root_.map_add, smul_add]) (fun _ _ _ ↦ by rw [map_zsmul, smul_comm])

private theorem liftAux_apply (g : P →ₛₗ[f] Q) (s : S) (p : P) :
    liftAux g (Scalars.of f s) p = s • g p := (rfl)

private theorem liftAux_balanced (g : P →ₛₗ[f] Q) (r : R) (s : Scalars f) (p : P) :
    liftAux g (op r • s) p = liftAux g s (r • p) := by
  obtain ⟨s, rfl⟩ := (Scalars.of f).surjective s
  rw [Scalars.op_smul_of, liftAux_apply, liftAux_apply, map_smulₛₗ, mul_smul]

/-- The `S`-linear map `S ⊗_R P → Q`, `s ⊗ p ↦ s • g p`, induced by an `f`-semilinear map
`g : P → Q`. -/
def lift (g : P →ₛₗ[f] Q) : BalancedExtension f P →ₗ[S] Q where
  toFun := BalancedTensorProduct.lift (liftAux g) (liftAux_balanced g)
  map_add' := _root_.map_add _
  map_smul' s x :=
    BalancedTensorProduct.lift_smul_left (k := ℤ) (A := R) (M := Scalars f) (N := P) S _ _
      (fun s x p ↦ by
        obtain ⟨x, rfl⟩ := (Scalars.of f).surjective x
        rw [Scalars.smul_of, liftAux_apply, liftAux_apply, mul_smul]) s x

@[simp]
theorem lift_tmul (g : P →ₛₗ[f] Q) (s : S) (p : P) : lift g (tmul f s p) = s • g p :=
  (BalancedTensorProduct.lift_tmul (liftAux g) (liftAux_balanced g) _ p).trans (liftAux_apply g s p)

@[simp]
theorem lift_comp_includeRight (g : P →ₛₗ[f] Q) : (lift g).comp (includeRight f P) = g := by
  ext p
  simp

/-- **The universal property of extension of scalars.** `S`-linear maps `S ⊗_R P → Q` correspond
to `f`-semilinear maps `P → Q`, by restriction along `p ↦ 1 ⊗ p`. -/
def liftEquiv : (P →ₛₗ[f] Q) ≃ (BalancedExtension f P →ₗ[S] Q) where
  toFun := lift
  invFun φ := φ.comp (includeRight f P)
  left_inv := lift_comp_includeRight
  right_inv φ := hom_ext fun p ↦ by simp

@[simp]
theorem liftEquiv_apply (g : P →ₛₗ[f] Q) : liftEquiv g = lift g := (rfl)

@[simp]
theorem liftEquiv_symm_apply (φ : BalancedExtension f P →ₗ[S] Q) :
    liftEquiv.symm φ = φ.comp (includeRight f P) := (rfl)

section Map

variable {P' P'' : Type*} [AddCommGroup P'] [Module R P'] [AddCommGroup P''] [Module R P'']

variable (f) in
/-- The `S`-linear map `S ⊗_R P → S ⊗_R P'`, `s ⊗ p ↦ s ⊗ g p`, induced by an `R`-linear map. -/
def map (g : P →ₗ[R] P') : BalancedExtension f P →ₗ[S] BalancedExtension f P' :=
  lift ((includeRight f P').comp g)

@[simp]
theorem map_tmul (g : P →ₗ[R] P') (s : S) (p : P) : map f g (tmul f s p) = tmul f s (g p) := by
  simp [map]

@[simp]
theorem map_id : map f (LinearMap.id : P →ₗ[R] P) = LinearMap.id :=
  hom_ext fun p ↦ by simp

theorem map_comp (g : P →ₗ[R] P') (g' : P' →ₗ[R] P'') :
    map f (g'.comp g) = (map f g').comp (map f g) :=
  hom_ext fun p ↦ by simp

theorem map_add (g g' : P →ₗ[R] P') : map f (g + g') = map f g + map f g' :=
  hom_ext fun p ↦ by simp [tmul_add]

@[simp]
theorem map_zero : map f (0 : P →ₗ[R] P') = 0 :=
  hom_ext fun p ↦ by simp

variable (f) in
/-- The `S`-linear equivalence `S ⊗_R P ≃ S ⊗_R P'`, `s ⊗ p ↦ s ⊗ θ p`, induced by an `R`-linear
equivalence `θ`. This is the `S`-linear form of the additive equivalence
`TauCeti.BalancedTensorProduct.congr`. -/
def congr (θ : P ≃ₗ[R] P') : BalancedExtension f P ≃ₗ[S] BalancedExtension f P' :=
  LinearEquiv.ofLinearMap (map f θ.toLinearMap) (map f θ.symm.toLinearMap)
    (hom_ext fun p ↦ by simp) (hom_ext fun p ↦ by simp)

@[simp]
theorem congr_tmul (θ : P ≃ₗ[R] P') (s : S) (p : P) :
    congr f θ (tmul f s p) = tmul f s (θ p) :=
  map_tmul _ s p

@[simp]
theorem congr_symm (θ : P ≃ₗ[R] P') : (congr f θ).symm = congr f θ.symm := (rfl)

end Map

/-- Transport balanced extension along equality of the scalar ring homomorphisms. -/
def congrRingHom {g : R →+* S} (h : f = g) :
    BalancedExtension f P ≃ₗ[S] BalancedExtension g P := by
  subst g
  exact .refl _ _

/-- Transport along an equality of ring homomorphisms keeps both factors of a pure tensor. -/
@[simp]
theorem congrRingHom_tmul {g : R →+* S} (h : f = g) (s : S) (p : P) :
    congrRingHom h (tmul f s p) = tmul g s p := by
  subst g
  rfl

/-- The inverse of transport along `h` is transport along the reversed equality `h.symm`. -/
@[simp]
theorem congrRingHom_symm {g : R →+* S} (h : f = g) :
    (congrRingHom h).symm = congrRingHom (P := P) h.symm := by
  subst g
  rfl

/-- Transport along reflexive equality is the identity equivalence. -/
@[simp]
theorem congrRingHom_refl : congrRingHom (P := P) (rfl : f = f) = LinearEquiv.refl S _ := by rfl

/-- Successive transports compose to transport along the transitive equality. -/
@[simp]
theorem congrRingHom_trans {g h : R →+* S} (hfg : f = g) (hgh : g = h) :
    (congrRingHom (P := P) hfg).trans (congrRingHom hgh) = congrRingHom (hfg.trans hgh) := by
  subst g h
  rfl

section CentralAction

/-- Scalars acting compatibly with the destination ring act on the first factor of `S ⊗_R P`. -/
@[simp]
theorem smul_tmul' {C : Type*} [SMul C S] [SMul C (BalancedExtension f P)]
    [IsScalarTower C S (BalancedExtension f P)] (c : C) (s : S) (p : P) :
    c • tmul f s p = tmul f (c • s) p := by
  rw [tmul_eq_smul_one_tmul, ← smul_assoc, ← tmul_eq_smul_one_tmul]

variable (A : Type*) [CommSemiring A] [Algebra A S]

variable (f P) in
/-- The `A`-action on `S ⊗_R P` restricted from the `S`-action, for an `A`-algebra `S`. As with
`TauCeti.CentralBaseChange.module`, it is not an instance; activate it locally when needed. -/
noncomputable abbrev moduleBase : Module A (BalancedExtension f P) :=
  Module.restrictScalars A S _

attribute [local instance low] moduleBase

/-- Restricting the destination action to an `A`-algebra structure forms a scalar tower. -/
instance : IsScalarTower A S (BalancedExtension f P) :=
  IsScalarTower.restrictScalars A S _

end CentralAction

section Identity

variable (R P) in
/-- **Extension along the identity.** `R ⊗_R P ≃ P`, `r ⊗ p ↦ r • p`. -/
def lid : BalancedExtension (RingHom.id R) P ≃ₗ[R] P :=
  LinearEquiv.ofLinearMap (lift LinearMap.id) (includeRight (RingHom.id R) P)
    (by ext p; simp) (hom_ext fun p ↦ by simp)

@[simp]
theorem lid_tmul (r : R) (p : P) : lid R P (tmul (RingHom.id R) r p) = r • p := by
  simp [lid]

@[simp]
theorem lid_symm_apply (p : P) : (lid R P).symm p = tmul (RingHom.id R) 1 p := (rfl)

end Identity

section Composition

variable (f) (g : S →+* T)

/-- The map `Scalars f → Scalars (g.comp f)` given by `g`, which is `R`-equivariant. -/
private def scalarsMap : Scalars f →ₗ[ℤ] Scalars (g.comp f) :=
  (((Scalars.of (g.comp f)).toAddMonoidHom.comp (g : S →+ T)).comp
    (Scalars.of f).symm.toAddMonoidHom).toIntLinearMap

private theorem scalarsMap_of (s : S) :
    scalarsMap f g (Scalars.of f s) = Scalars.of (g.comp f) (g s) := (rfl)

private theorem scalarsMap_op_smul (r : R) (x : Scalars f) :
    scalarsMap f g (op r • x) = op r • scalarsMap f g x := by
  obtain ⟨s, rfl⟩ := (Scalars.of f).surjective x
  rw [Scalars.op_smul_of, scalarsMap_of, scalarsMap_of, Scalars.op_smul_of, map_mul,
    RingHom.comp_apply]

/-- The additive map `S ⊗_R P → T ⊗_R P`, `s ⊗ p ↦ g s ⊗ p`. -/
private def changeScalarsAux : BalancedExtension f P →ₗ[ℤ] BalancedExtension (g.comp f) P :=
  BalancedTensorProduct.map (scalarsMap f g) LinearMap.id (scalarsMap_op_smul f g)
    (fun _ _ ↦ rfl)

private theorem changeScalarsAux_tmul (s : S) (p : P) :
    changeScalarsAux f g (tmul f s p) = tmul (g.comp f) (g s) p :=
  BalancedTensorProduct.map_tmul _ _ _ _ _ _

/-- The `g`-semilinear map `S ⊗_R P → T ⊗_R P`, `s ⊗ p ↦ g s ⊗ p`, underlying
`cancelBaseChange`. -/
private def changeScalars : BalancedExtension f P →ₛₗ[g] BalancedExtension (g.comp f) P where
  toFun := changeScalarsAux f g
  map_add' := _root_.map_add _
  map_smul' s x := by
    induction x using induction_on with
    | tmul s' p => simp [changeScalarsAux_tmul]
    | add x y hx hy => simp only [smul_add, _root_.map_add, hx, hy]

private theorem changeScalars_tmul (s : S) (p : P) :
    changeScalars f g (tmul f s p) = tmul (g.comp f) (g s) p :=
  changeScalarsAux_tmul f g s p

/-- **Extension along a composite.** For ring homomorphisms `f : R →+* S` and `g : S →+* T`,
`T ⊗_S (S ⊗_R P) ≃ T ⊗_R P`, `t ⊗ (s ⊗ p) ↦ (t * g s) ⊗ p`. -/
def cancelBaseChange :
    BalancedExtension g (BalancedExtension f P) ≃ₗ[T] BalancedExtension (g.comp f) P :=
  haveI : RingHomCompTriple f g (g.comp f) := ⟨rfl⟩
  LinearEquiv.ofLinearMap (lift (changeScalars f g))
    (lift ((includeRight g _).comp (includeRight f P)))
    (hom_ext fun p ↦ by simp [changeScalars_tmul])
    (hom_ext fun x ↦ by
      induction x using induction_on with
      | tmul s p =>
        simp only [LinearMap.comp_apply, lift_tmul, changeScalars_tmul, one_smul,
          includeRight_apply, smul_tmul, mul_one, LinearMap.id_apply]
        rw [tmul_eq_smul_one_tmul (f := f) s, tmul_smul, one_mul]
      | add x y hx hy => simp only [tmul_add, _root_.map_add, hx, hy])

@[simp]
theorem cancelBaseChange_tmul (t : T) (s : S) (p : P) :
    cancelBaseChange f g (tmul g t (tmul f s p)) = tmul (g.comp f) (t * g s) p := by
  simp [cancelBaseChange, changeScalars_tmul]

@[simp]
theorem cancelBaseChange_symm_tmul (t : T) (p : P) :
    (cancelBaseChange f g).symm (tmul (g.comp f) t p) = tmul g t (tmul f 1 p) := by
  simp [cancelBaseChange]

end Composition

section RightUnit

variable (f)

/-- **Extension of the regular module.** `S ⊗_R R ≃ S`, sending `s ⊗ r` to `s * f r`. It is the
right unit identification `TauCeti.BalancedTensorProduct.rid` of the right `R`-module `S`. -/
noncomputable def rid : BalancedExtension f R ≃ₗ[S] S where
  toAddEquiv := (BalancedTensorProduct.rid ℤ R (Scalars f)).toAddEquiv.trans (Scalars.of f).symm
  map_smul' s x := congrArg (Scalars.of f).symm
    (BalancedTensorProduct.rid_smul_left ℤ R (Scalars f) S s x)

@[simp]
theorem rid_tmul (s : S) (r : R) : rid f (tmul f s r) = s * f r := by
  simp [rid, tmul_def]

@[simp]
theorem rid_symm_apply (s : S) : (rid f).symm s = tmul f s 1 := by
  rw [LinearEquiv.symm_apply_eq, rid_tmul, map_one, mul_one]

end RightUnit

section Pi

variable (f) (ι : Type*) [Fintype ι]

/-- The inverse map `(Π i, S ⊗_R M i) →ₗ[S] S ⊗_R (Π i, M i)` sending `y` to
`∑ i, (S ⊗_R single i) (y i)`. -/
private noncomputable def piEquivInv [DecidableEq ι] (M : ι → Type*)
    [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)] :
    (∀ i, BalancedExtension f (M i)) →ₗ[S] BalancedExtension f (∀ i, M i) :=
  ∑ i : ι, (map f (LinearMap.single R M i)).comp (LinearMap.proj i)

private theorem piEquivInv_apply [DecidableEq ι] {M : ι → Type*} [∀ i, AddCommGroup (M i)]
    [∀ i, Module R (M i)] (y : ∀ i, BalancedExtension f (M i)) :
    piEquivInv f ι M y = ∑ i, map f (LinearMap.single R M i) (y i) := by
  simp [piEquivInv]

/-- **Extension of a finite product of modules.** Extension of scalars commutes with finite
products: `S ⊗_R (Π i, M i) ≃ Π i, (S ⊗_R M i)`. -/
noncomputable def piEquiv (M : ι → Type*) [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)] :
    BalancedExtension f (∀ i, M i) ≃ₗ[S] ∀ i, BalancedExtension f (M i) :=
  letI := Classical.decEq ι
  LinearEquiv.ofLinearMap
    (LinearMap.pi fun i ↦ map f (LinearMap.proj i))
    (piEquivInv f ι M)
    (LinearMap.ext fun y ↦ funext fun i ↦ by
      simp only [LinearMap.comp_apply, LinearMap.pi_apply, piEquivInv_apply,
        LinearMap.id_apply, map_sum]
      rw [Finset.sum_eq_single i]
      · rw [← LinearMap.comp_apply, ← map_comp, LinearMap.proj_comp_single_same, map_id,
          LinearMap.id_apply]
      · intro j _ hji
        rw [← LinearMap.comp_apply, ← map_comp, LinearMap.proj_comp_single_ne R M i j hji.symm,
          map_zero, LinearMap.zero_apply]
      · intro hi; exact (hi (Finset.mem_univ i)).elim)
    (hom_ext fun x ↦ by
      simp only [LinearMap.comp_apply, LinearMap.pi_apply, LinearMap.proj_apply,
        piEquivInv_apply, LinearMap.id_apply, map_tmul]
      simp only [← includeRight_apply, ← map_sum, LinearMap.single_apply, Finset.univ_sum_single])

@[simp]
theorem piEquiv_tmul {M : ι → Type*} [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    (s : S) (x : ∀ i, M i) (i : ι) :
    piEquiv f ι M (tmul f s x) i = tmul f s (x i) := by
  simp [piEquiv]

@[simp]
theorem piEquiv_symm_apply [DecidableEq ι] {M : ι → Type*} [∀ i, AddCommGroup (M i)]
    [∀ i, Module R (M i)] (y : ∀ i, BalancedExtension f (M i)) :
    (piEquiv f ι M).symm y = ∑ i, map f (LinearMap.single R M i) (y i) := by
  simp only [piEquiv, LinearEquiv.symm_ofLinearMap, LinearEquiv.coe_ofLinearMap, piEquivInv_apply]
  convert rfl

/-- **Extension of a finite free module.** `S ⊗_R (ι → R) ≃ (ι → S)`, sending `s ⊗ x` to
`i ↦ s * f (x i)`. Its inverse sends `v` to `∑ i, v i ⊗ eᵢ` (`piScalarRight_symm_apply`). -/
noncomputable def piScalarRight : BalancedExtension f (ι → R) ≃ₗ[S] (ι → S) :=
  (piEquiv f ι (fun _ ↦ R)).trans (LinearEquiv.piCongrRight fun _ ↦ rid f)

@[simp]
theorem piScalarRight_tmul (s : S) (x : ι → R) :
    piScalarRight f ι (tmul f s x) = fun i ↦ s * f (x i) := by
  ext i
  simp [piScalarRight]

@[simp]
theorem piScalarRight_symm_apply [DecidableEq ι] (v : ι → S) :
    (piScalarRight f ι).symm v = ∑ i, tmul f (v i) (Pi.single i 1) := by
  simp [piScalarRight]

end Pi

section FiniteProjective

variable {P' : Type*} [AddCommGroup P'] [Module R P']

/-- Extension of scalars preserves surjections: if `g : P → P'` is surjective, so is
`S ⊗_R g`. -/
theorem map_surjective {g : P →ₗ[R] P'} (hg : Function.Surjective g) :
    Function.Surjective (map f g) := by
  intro x
  induction x using induction_on with
  | tmul s p =>
    obtain ⟨q, rfl⟩ := hg p
    exact ⟨tmul f s q, map_tmul g s q⟩
  | add x y hx hy =>
    obtain ⟨x, rfl⟩ := hx
    obtain ⟨y, rfl⟩ := hy
    exact ⟨x + y, _root_.map_add _ x y⟩

/-- The extension of scalars of a finitely generated module is finitely generated: a surjection
`Rⁿ → P` extends to a surjection `Sⁿ ≃ S ⊗_R Rⁿ → S ⊗_R P`. -/
instance [Module.Finite R P] : Module.Finite S (BalancedExtension f P) := by
  obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin' R P
  exact .of_surjective ((map f g).comp (piScalarRight f (Fin n)).symm.toLinearMap)
    ((map_surjective hg).comp (piScalarRight f (Fin n)).symm.surjective)

/-- The extension of scalars of a projective module is projective: an `S`-linear map out of
`S ⊗_R P` is an `f`-semilinear map out of `P`, and these lift along surjections because `P` is
projective. -/
instance [Module.Projective R P] : Module.Projective S (BalancedExtension f P) := by
  refine .of_lifting_property'' fun F hF ↦ ?_
  obtain ⟨h, hh⟩ := Module.projective_lifting_property_semilinear F hF (includeRight f P)
  exact ⟨lift h, hom_ext fun p ↦ by simpa using LinearMap.congr_fun hh p⟩

end FiniteProjective

section Idempotent

open Matrix

variable (f) {ι : Type*} [Fintype ι] {e : Matrix ι ι R}

/-- The `S`-linear map `Sⁿ f(e) → S ⊗_R (Rⁿ e)`, `w ↦ ∑ i, wᵢ ⊗ eᵢ`, through the rows `eᵢ`
of `e`. -/
private def rangeVecMulLinearInv :
    LinearMap.range (e.map f).vecMulLinear →ₗ[S]
      BalancedExtension f (LinearMap.range e.vecMulLinear) :=
  Fintype.linearCombination S (fun i ↦ tmul f 1 ⟨e i, e.row_mem_range_vecMulLinear i⟩) ∘ₗ
    (LinearMap.range _).subtype

/-- **Extension of the image of an idempotent matrix.** For an idempotent matrix `e` over `R`,
whose image `Rⁿ e` under right multiplication of row vectors is a finitely generated projective
module, the extension of scalars along `f` is the image `Sⁿ f(e)` of the matrix `f(e)`:
`S ⊗_R (Rⁿ e) ≃ Sⁿ f(e)`, sending `s ⊗ v` to `i ↦ s * f (v i)`
(`coe_rangeVecMulLinearEquiv_tmul`). Its inverse sends `w` to `∑ i, wᵢ ⊗ eᵢ`, through the rows
`eᵢ` of `e` (`rangeVecMulLinearEquiv_symm_apply`). -/
noncomputable def rangeVecMulLinearEquiv (he : IsIdempotentElem e) :
    BalancedExtension f (LinearMap.range e.vecMulLinear) ≃ₗ[S]
      LinearMap.range (e.map f).vecMulLinear :=
  LinearEquiv.ofLinearMap (lift (e.rangeVecMulLinearMap f)) (rangeVecMulLinearInv f)
    (LinearMap.ext fun w ↦ by
      conv_rhs => rw [LinearMap.id_apply, (he.matrix_map f).eq_sum_smul_row w]
      simp only [rangeVecMulLinearInv, LinearMap.comp_apply, Fintype.linearCombination_apply,
        map_sum, map_smul, lift_tmul, one_smul, Submodule.subtype_apply]
      exact Finset.sum_congr rfl fun i _ ↦ congrArg _ <| Subtype.ext <|
        coe_rangeVecMulLinearMap_apply e f _)
    (hom_ext fun v ↦ by
      conv_rhs => rw [LinearMap.id_apply, he.eq_sum_smul_row v, ← includeRight_apply, map_sum]
      simp only [LinearMap.comp_apply, lift_tmul, one_smul, rangeVecMulLinearInv,
        Fintype.linearCombination_apply, map_smulₛₗ, includeRight_apply, smul_tmul, mul_one,
        Submodule.subtype_apply, coe_rangeVecMulLinearMap_apply, Function.comp_apply])

@[simp]
theorem coe_rangeVecMulLinearEquiv_tmul (he : IsIdempotentElem e) (s : S)
    (v : LinearMap.range e.vecMulLinear) :
    (rangeVecMulLinearEquiv f he (tmul f s v) : ι → S) = fun i ↦ s * f ((v : ι → R) i) := by
  ext i
  simp [rangeVecMulLinearEquiv]

@[simp]
theorem rangeVecMulLinearEquiv_symm_apply (he : IsIdempotentElem e)
    (w : LinearMap.range (e.map f).vecMulLinear) :
    (rangeVecMulLinearEquiv f he).symm w =
      ∑ i, tmul f ((w : ι → S) i) ⟨e i, e.row_mem_range_vecMulLinear i⟩ := by
  simp [rangeVecMulLinearEquiv, rangeVecMulLinearInv, Fintype.linearCombination_apply, smul_tmul]

end Idempotent

end BalancedExtension

end TauCeti

namespace TauCeti.BalancedExtension

section Algebra

open scoped TensorProduct

variable (R : Type u₁) (S : Type u₂) [CommRing R] [Ring S] [Algebra R S]
  (P : Type v) [AddCommGroup P] [Module R P]

private noncomputable def equivTensorProductFwd :
    P →ₛₗ[algebraMap R S] S ⊗[R] P where
  toFun p := (1 : S) ⊗ₜ[R] p
  map_add' p₁ p₂ := TensorProduct.tmul_add 1 p₁ p₂
  map_smul' r p := by
    rw [TensorProduct.tmul_smul]
    exact (algebraMap_smul S r ((1 : S) ⊗ₜ[R] p)).symm

private theorem equivTensorProductFwd_apply (p : P) :
    equivTensorProductFwd R S P p = (1 : S) ⊗ₜ[R] p := (rfl)

private noncomputable def equivTensorProductToFun :
    BalancedExtension (algebraMap R S) P →ₗ[S] S ⊗[R] P :=
  lift (equivTensorProductFwd R S P)

private theorem equivTensorProductToFun_tmul (s : S) (p : P) :
    equivTensorProductToFun R S P (tmul (algebraMap R S) s p) = s ⊗ₜ[R] p := by
  simp [equivTensorProductToFun, equivTensorProductFwd_apply, TensorProduct.smul_tmul']

private noncomputable def equivTensorProductInvR :
    S ⊗[R] P →+ BalancedExtension (algebraMap R S) P :=
  letI : Module R (BalancedExtension (algebraMap R S) P) :=
    Module.compHom (BalancedExtension (algebraMap R S) P) (algebraMap R S)
  have smul_def (r : R) (x : BalancedExtension (algebraMap R S) P) :
      r • x = algebraMap R S r • x := rfl
  (TensorProduct.lift <| LinearMap.mk₂ R (fun s p ↦ tmul (algebraMap R S) s p)
    (fun s₁ s₂ p ↦ add_tmul s₁ s₂ p)
    (fun r s p ↦ by rw [smul_def, Algebra.smul_def, ← smul_tmul])
    (fun s p₁ p₂ ↦ tmul_add s p₁ p₂)
    (fun r s p ↦ by rw [smul_def, tmul_smul, ← Algebra.commutes, ← smul_tmul])).toAddMonoidHom

private theorem equivTensorProductInvR_tmul (s : S) (p : P) :
    equivTensorProductInvR R S P (s ⊗ₜ[R] p) = tmul (algebraMap R S) s p := by
  simp [equivTensorProductInvR]

private noncomputable def equivTensorProductInv :
    S ⊗[R] P →ₗ[S] BalancedExtension (algebraMap R S) P where
  toFun := equivTensorProductInvR R S P
  map_add' := (equivTensorProductInvR R S P).map_add
  map_smul' s x := by
    induction x using TensorProduct.inductionOn with
    | tmul s' p =>
      simp only [TensorProduct.smul_tmul', smul_eq_mul, RingHom.id_apply,
        equivTensorProductInvR_tmul, smul_tmul]
    | add x y hx hy => simp only [smul_add, _root_.map_add, RingHom.id_apply, hx, hy]

private theorem equivTensorProductInv_tmul (s : S) (p : P) :
    equivTensorProductInv R S P (s ⊗ₜ[R] p) = tmul (algebraMap R S) s p :=
  equivTensorProductInvR_tmul R S P s p

/-- **Comparison with Mathlib's tensor product.** When `R` is commutative and `S` is an
`R`-algebra, the balanced extension of scalars along `algebraMap R S` is `S`-linearly isomorphic
to `S ⊗[R] P`, sending `s ⊗ p` to `s ⊗ₜ[R] p`. -/
noncomputable def equivTensorProduct :
    BalancedExtension (algebraMap R S) P ≃ₗ[S] S ⊗[R] P :=
  LinearEquiv.ofLinearMap (equivTensorProductToFun R S P) (equivTensorProductInv R S P)
    (LinearMap.ext fun x ↦ by
      induction x using TensorProduct.inductionOn with
      | tmul s p =>
        simp only [LinearMap.comp_apply, LinearMap.id_apply, equivTensorProductInv_tmul,
          equivTensorProductToFun_tmul]
      | add x y hx hy => simp only [_root_.map_add, hx, hy])
    (hom_ext fun p ↦ by
      simp only [LinearMap.comp_apply, LinearMap.id_apply,
        equivTensorProductToFun_tmul, equivTensorProductInv_tmul])

@[simp]
theorem equivTensorProduct_tmul (s : S) (p : P) :
    equivTensorProduct R S P (tmul (algebraMap R S) s p) = s ⊗ₜ[R] p :=
  equivTensorProductToFun_tmul R S P s p

@[simp]
theorem equivTensorProduct_symm_tmul (s : S) (p : P) :
    (equivTensorProduct R S P).symm (s ⊗ₜ[R] p) = tmul (algebraMap R S) s p :=
  equivTensorProductInv_tmul R S P s p

end Algebra

end TauCeti.BalancedExtension
