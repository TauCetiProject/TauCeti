/-!
# Extension of scalars along a ring homomorphism of noncommutative rings

For a ring homomorphism `f : R →+* S` of possibly noncommutative rings and a left `R`-module `P`,
the extension of scalars `S ⊗_R P` is the balanced tensor product of `S`, regarded as a right
`R`-module through `s · r = s * f r`, with `P`. It is the abelian group generated by symbols
`s ⊗ p`, biadditive and subject to `(s * f r) ⊗ p = s ⊗ (r • p)`, and `S` acts on the left
through the first factor.

Mathlib's `TensorProduct` needs a commutative ring of scalars, and Mathlib's
`ModuleCat.extendScalars` needs `R` and `S` commutative. Here the tensor product is the
balanced tensor product `TauCeti.BalancedTensorProduct ℤ R` over the integers, so no
commutativity is assumed.

## Main definitions

* `TauCeti.BalancedExtension.Scalars f`: the ring `S` as an `(S, R)`-bimodule, with `R` acting on
  the right through `f`.
* `TauCeti.BalancedExtension f P`: the left `S`-module `S ⊗_R P`, with pure tensors
  `TauCeti.BalancedExtension.tmul f s p`.
* `TauCeti.BalancedExtension.includeRight`: the `f`-semilinear map `p ↦ 1 ⊗ p`.
* `TauCeti.BalancedExtension.lift` and `TauCeti.BalancedExtension.liftEquiv`: the universal
  property. `S`-linear maps `S ⊗_R P → Q` correspond to `f`-semilinear maps `P → Q`, that is, to
  additive maps that are `R`-linear for the action on `Q` restricted along `f`.
* `TauCeti.BalancedExtension.map`: functoriality in `R`-linear maps.
* `TauCeti.BalancedExtension.lid`: extension along the identity, `R ⊗_R P ≃ P`.
* `TauCeti.BalancedExtension.cancelBaseChange`: extension along a composite,
  `T ⊗_S (S ⊗_R P) ≃ T ⊗_R P`.
* `TauCeti.BalancedExtension.piScalarRight`: extension of a finite free module,
  `S ⊗_R Rⁿ ≃ Sⁿ`.

The extension of the zero module is zero by the `Subsingleton` instances of
`TauCeti.BalancedTensorProduct`, since `TauCeti.BalancedExtension` is an `abbrev`.

## References

* C. A. Weibel, *The K-book*, Chapter I, §2, pp. 7–8, and Chapter II, §2.8.
-/

public section

namespace TauCeti

open MulOpposite

universe u₁ u₂ u₃ v w

variable {R : Type u₁} {S : Type u₂} {T : Type u₃} [Ring R] [Ring S] [Ring T]

namespace BalancedExtension

/-- The ring `S` regarded as an `(S, R)`-bimodule through a ring homomorphism `f : R →+* S`:
`S` acts on the left by multiplication and `R` acts on the right by `s · r = s * f r`. This is a
type synonym so that the right `R`-action is not an instance on `S` itself. -/
@[expose]
def Scalars (_f : R →+* S) : Type u₂ := S

variable (f : R →+* S)

namespace Scalars

instance : AddCommGroup (Scalars f) := inferInstanceAs (AddCommGroup S)

instance : Module S (Scalars f) := inferInstanceAs (Module S S)

/-- The right action of `R` on `S` through `f`, as a left action of `Rᵐᵒᵖ`. -/
instance : Module Rᵐᵒᵖ (Scalars f) := Module.compHom S (RingHom.op f)

/-- The identification of `S` with `Scalars f` as an additive group. -/
def of : S ≃+ Scalars f := AddEquiv.refl S

/-- `S` acts on `Scalars f` by left multiplication. -/
@[simp]
theorem smul_of (s x : S) : s • of f x = of f (s * x) := (rfl)

/-- `R` acts on `Scalars f` on the right through `f`. -/
@[simp]
theorem op_smul_of (r : R) (x : S) : op r • of f x = of f (x * f r) := (rfl)

instance : SMulCommClass S Rᵐᵒᵖ (Scalars f) where
  smul_comm s r x := by
    induction r using MulOpposite.rec'
    obtain ⟨x, rfl⟩ := (of f).surjective x
    simp only [smul_of, op_smul_of, mul_assoc]

end Scalars

end BalancedExtension

/-- The extension of scalars `S ⊗_R P` of a left `R`-module `P` along a ring homomorphism
`f : R →+* S`: the balanced tensor product of `S`, a right `R`-module through `f`, with `P`.
It is a left `S`-module through the first factor. -/
abbrev BalancedExtension (f : R →+* S) (P : Type v) [AddCommGroup P] [Module R P] :
    Type (max u₂ v) :=
  BalancedTensorProduct ℤ R (BalancedExtension.Scalars f) P

namespace BalancedExtension

variable (f : R →+* S) (P : Type v) [AddCommGroup P] [Module R P]

/-- The left `S`-module structure of `S ⊗_R P`, by multiplication on the first factor. -/
instance : Module S (BalancedExtension f P) :=
  BalancedTensorProduct.leftModule (k := ℤ) (A := R) (M := Scalars f) (N := P) S

variable {P}

/-- The pure tensor `s ⊗ p` in `S ⊗_R P`. -/
def tmul (s : S) (p : P) : BalancedExtension f P :=
  BalancedTensorProduct.tmul ℤ R (Scalars.of f s) p

theorem tmul_def (s : S) (p : P) :
    tmul f s p = BalancedTensorProduct.tmul ℤ R (Scalars.of f s) p := (rfl)

variable {f}

@[simp]
theorem zero_tmul (p : P) : tmul f 0 p = 0 := by
  rw [tmul_def, map_zero, BalancedTensorProduct.zero_tmul]

@[simp]
theorem tmul_zero (s : S) : tmul f s (0 : P) = 0 :=
  BalancedTensorProduct.tmul_zero ℤ R (Scalars.of f s)

theorem add_tmul (s s' : S) (p : P) : tmul f (s + s') p = tmul f s p + tmul f s' p := by
  rw [tmul_def, _root_.map_add, BalancedTensorProduct.add_tmul, tmul_def, tmul_def]

theorem tmul_add (s : S) (p p' : P) : tmul f s (p + p') = tmul f s p + tmul f s p' :=
  BalancedTensorProduct.tmul_add ℤ R (Scalars.of f s) p p'

/-- The balancing relation `s ⊗ (r • p) = (s * f r) ⊗ p`. -/
theorem tmul_smul (s : S) (r : R) (p : P) : tmul f s (r • p) = tmul f (s * f r) p := by
  rw [tmul_def, tmul_def, ← BalancedTensorProduct.balance, Scalars.op_smul_of]

/-- `S` acts on `S ⊗_R P` by left multiplication on the first factor. -/
@[simp]
theorem smul_tmul (s s' : S) (p : P) : s • tmul f s' p = tmul f (s * s') p :=
  (BalancedTensorProduct.smul_tmul_left (k := ℤ) (A := R) (N := P) S s _ p).trans
    (congrArg (BalancedTensorProduct.tmul ℤ R · p) (Scalars.smul_of f s s'))

theorem tmul_eq_smul_one_tmul (s : S) (p : P) : tmul f s p = s • tmul f 1 p := by
  rw [smul_tmul, mul_one]

/-- Induction on `S ⊗_R P` by pure tensors and addition. -/
@[elab_as_elim]
theorem induction_on {C : BalancedExtension f P → Prop} (x : BalancedExtension f P)
    (tmul : ∀ s p, C (BalancedExtension.tmul f s p)) (add : ∀ x y, C x → C y → C (x + y)) :
    C x :=
  BalancedTensorProduct.induction_on ℤ R x (fun s p ↦ tmul ((Scalars.of f).symm s) p) add

variable {Q : Type w} [AddCommGroup Q] [Module S Q]

/-- `S`-linear maps out of `S ⊗_R P` agree once they agree on the tensors `1 ⊗ p`. -/
@[ext high]
theorem hom_ext {φ ψ : BalancedExtension f P →ₗ[S] Q} (h : ∀ p, φ (tmul f 1 p) = ψ (tmul f 1 p)) :
    φ = ψ := by
  ext x
  induction x using induction_on with
  | tmul s p => rw [tmul_eq_smul_one_tmul, map_smul, map_smul, h]
  | add x y hx hy => rw [_root_.map_add, _root_.map_add, hx, hy]

variable (f P) in
/-- The `f`-semilinear map `p ↦ 1 ⊗ p` into the extension of scalars. -/
def includeRight : P →ₛₗ[f] BalancedExtension f P where
  toFun p := tmul f 1 p
  map_add' := tmul_add 1
  map_smul' r p := by simp only [tmul_smul, one_mul, smul_tmul, mul_one]

@[simp]
theorem includeRight_apply (p : P) : includeRight f P p = tmul f 1 p := (rfl)

/-- The balanced biadditive map `(s, p) ↦ s • g p` attached to an `f`-semilinear map `g`. -/
private def liftAux (g : P →ₛₗ[f] Q) : Scalars f →ₗ[ℤ] P →ₗ[ℤ] Q :=
  LinearMap.mk₂ ℤ (fun s p ↦ (Scalars.of f).symm s • g p)
    (fun _ _ _ ↦ by rw [_root_.map_add, add_smul]) (fun _ _ _ ↦ by rw [map_zsmul, smul_assoc])
    (fun _ _ _ ↦ by rw [_root_.map_add, smul_add]) (fun _ _ _ ↦ by rw [map_zsmul, smul_comm])

private theorem liftAux_apply (g : P →ₛₗ[f] Q) (s : S) (p : P) :
    liftAux g (Scalars.of f s) p = s • g p := (rfl)

private theorem liftAux_balanced (g : P →ₛₗ[f] Q) (r : R) (s : Scalars f) (p : P) :
    liftAux g (op r • s) p = liftAux g s (r • p) := by
  obtain ⟨s, rfl⟩ := (Scalars.of f).surjective s
  rw [Scalars.op_smul_of, liftAux_apply, liftAux_apply, map_smulₛₗ, mul_smul]

/-- The `S`-linear map `S ⊗_R P → Q`, `s ⊗ p ↦ s • g p`, induced by an `f`-semilinear map
`g : P → Q`. -/
def lift (g : P →ₛₗ[f] Q) : BalancedExtension f P →ₗ[S] Q where
  toFun := BalancedTensorProduct.lift (liftAux g) (liftAux_balanced g)
  map_add' := _root_.map_add _
  map_smul' s x :=
    BalancedTensorProduct.lift_smul_left (k := ℤ) (A := R) (M := Scalars f) (N := P) S _ _
      (fun s x p ↦ by
        obtain ⟨x, rfl⟩ := (Scalars.of f).surjective x
        rw [Scalars.smul_of, liftAux_apply, liftAux_apply, mul_smul]) s x

@[simp]
theorem lift_tmul (g : P →ₛₗ[f] Q) (s : S) (p : P) : lift g (tmul f s p) = s • g p :=
  (BalancedTensorProduct.lift_tmul (liftAux g) (liftAux_balanced g) _ p).trans (liftAux_apply g s p)

@[simp]
theorem lift_comp_includeRight (g : P →ₛₗ[f] Q) : (lift g).comp (includeRight f P) = g := by
  ext p
  simp

/-- **The universal property of extension of scalars.** `S`-linear maps `S ⊗_R P → Q` correspond
to `f`-semilinear maps `P → Q`, by restriction along `p ↦ 1 ⊗ p`. -/
def liftEquiv : (P →ₛₗ[f] Q) ≃ (BalancedExtension f P →ₗ[S] Q) where
  toFun := lift
  invFun φ := φ.comp (includeRight f P)
  left_inv := lift_comp_includeRight
  right_inv φ := hom_ext fun p ↦ by simp

@[simp]
theorem liftEquiv_apply (g : P →ₛₗ[f] Q) : liftEquiv g = lift g := (rfl)

@[simp]
theorem liftEquiv_symm_apply (φ : BalancedExtension f P →ₗ[S] Q) :
    liftEquiv.symm φ = φ.comp (includeRight f P) := (rfl)

section Map

variable {P' P'' : Type*} [AddCommGroup P'] [Module R P'] [AddCommGroup P''] [Module R P'']

variable (f) in
/-- The `S`-linear map `S ⊗_R P → S ⊗_R P'`, `s ⊗ p ↦ s ⊗ g p`, induced by an `R`-linear map. -/
def map (g : P →ₗ[R] P') : BalancedExtension f P →ₗ[S] BalancedExtension f P' :=
  lift ((includeRight f P').comp g)

@[simp]
theorem map_tmul (g : P →ₗ[R] P') (s : S) (p : P) : map f g (tmul f s p) = tmul f s (g p) := by
  simp [map]

@[simp]
theorem map_id : map f (LinearMap.id : P →ₗ[R] P) = LinearMap.id :=
  hom_ext fun p ↦ by simp

theorem map_comp (g : P →ₗ[R] P') (g' : P' →ₗ[R] P'') :
    map f (g'.comp g) = (map f g').comp (map f g) :=
  hom_ext fun p ↦ by simp

theorem map_add (g g' : P →ₗ[R] P') : map f (g + g') = map f g + map f g' :=
  hom_ext fun p ↦ by simp [tmul_add]

end Map

section Identity

variable (R P) in
/-- **Extension along the identity.** `R ⊗_R P ≃ P`, `r ⊗ p ↦ r • p`. -/
def lid : BalancedExtension (RingHom.id R) P ≃ₗ[R] P :=
  LinearEquiv.ofLinearMap (lift LinearMap.id) (includeRight (RingHom.id R) P)
    (by ext p; simp) (hom_ext fun p ↦ by simp)

@[simp]
theorem lid_tmul (r : R) (p : P) : lid R P (tmul (RingHom.id R) r p) = r • p := by
  simp [lid]

@[simp]
theorem lid_symm_apply (p : P) : (lid R P).symm p = tmul (RingHom.id R) 1 p := (rfl)

end Identity

section Composition

variable (f) (g : S →+* T)

/-- The map `Scalars f → Scalars (g.comp f)` given by `g`, which is `R`-equivariant. -/
private def scalarsMap : Scalars f →ₗ[ℤ] Scalars (g.comp f) :=
  (((Scalars.of (g.comp f)).toAddMonoidHom.comp (g : S →+ T)).comp
    (Scalars.of f).symm.toAddMonoidHom).toIntLinearMap

private theorem scalarsMap_of (s : S) :
    scalarsMap f g (Scalars.of f s) = Scalars.of (g.comp f) (g s) := (rfl)

private theorem scalarsMap_op_smul (r : R) (x : Scalars f) :
    scalarsMap f g (op r • x) = op r • scalarsMap f g x := by
  obtain ⟨s, rfl⟩ := (Scalars.of f).surjective x
  rw [Scalars.op_smul_of, scalarsMap_of, scalarsMap_of, Scalars.op_smul_of, map_mul,
    RingHom.comp_apply]

/-- The additive map `S ⊗_R P → T ⊗_R P`, `s ⊗ p ↦ g s ⊗ p`. -/
private def changeScalarsAux : BalancedExtension f P →ₗ[ℤ] BalancedExtension (g.comp f) P :=
  BalancedTensorProduct.map (scalarsMap f g) LinearMap.id (scalarsMap_op_smul f g)
    (fun _ _ ↦ rfl)

private theorem changeScalarsAux_tmul (s : S) (p : P) :
    changeScalarsAux f g (tmul f s p) = tmul (g.comp f) (g s) p :=
  BalancedTensorProduct.map_tmul _ _ _ _ _ _

/-- The `g`-semilinear map `S ⊗_R P → T ⊗_R P`, `s ⊗ p ↦ g s ⊗ p`, underlying
`cancelBaseChange`. -/
private def changeScalars : BalancedExtension f P →ₛₗ[g] BalancedExtension (g.comp f) P where
  toFun := changeScalarsAux f g
  map_add' := _root_.map_add _
  map_smul' s x := by
    induction x using induction_on with
    | tmul s' p => simp [changeScalarsAux_tmul]
    | add x y hx hy => simp only [smul_add, _root_.map_add, hx, hy]

private theorem changeScalars_tmul (s : S) (p : P) :
    changeScalars f g (tmul f s p) = tmul (g.comp f) (g s) p :=
  changeScalarsAux_tmul f g s p

/-- **Extension along a composite.** For ring homomorphisms `f : R →+* S` and `g : S →+* T`,
`T ⊗_S (S ⊗_R P) ≃ T ⊗_R P`, `t ⊗ (s ⊗ p) ↦ (t * g s) ⊗ p`. -/
def cancelBaseChange :
    BalancedExtension g (BalancedExtension f P) ≃ₗ[T] BalancedExtension (g.comp f) P :=
  haveI : RingHomCompTriple f g (g.comp f) := ⟨rfl⟩
  LinearEquiv.ofLinearMap (lift (changeScalars f g))
    (lift ((includeRight g _).comp (includeRight f P)))
    (hom_ext fun p ↦ by simp [changeScalars_tmul])
    (hom_ext fun x ↦ by
      induction x using induction_on with
      | tmul s p =>
        simp only [LinearMap.comp_apply, lift_tmul, changeScalars_tmul, one_smul,
          includeRight_apply, smul_tmul, mul_one, LinearMap.id_apply]
        rw [tmul_eq_smul_one_tmul (f := f) s, tmul_smul, one_mul]
      | add x y hx hy => simp only [tmul_add, _root_.map_add, hx, hy])

@[simp]
theorem cancelBaseChange_tmul (t : T) (s : S) (p : P) :
    cancelBaseChange f g (tmul g t (tmul f s p)) = tmul (g.comp f) (t * g s) p := by
  simp [cancelBaseChange, changeScalars_tmul]

@[simp]
theorem cancelBaseChange_symm_tmul (t : T) (p : P) :
    (cancelBaseChange f g).symm (tmul (g.comp f) t p) = tmul g t (tmul f 1 p) := by
  simp [cancelBaseChange]

end Composition

section Pi

variable (f) (ι : Type*) [Fintype ι]

/-- **Extension of a finite free module.** `S ⊗_R (ι → R) ≃ (ι → S)`, sending `s ⊗ x` to
`i ↦ s * f (x i)`. Its inverse sends `v` to `∑ i, v i ⊗ eᵢ` (`piScalarRight_symm_apply`). -/
noncomputable def piScalarRight : BalancedExtension f (ι → R) ≃ₗ[S] (ι → S) where
  toAddEquiv := (BalancedTensorProduct.piRight ℤ R (Scalars f) ι).toAddEquiv.trans
    (AddEquiv.piCongrRight fun _ ↦ (Scalars.of f).symm)
  map_smul' s x := by
    simp only [AddEquiv.toFun_eq_coe, RingHom.id_apply]
    induction x using induction_on with
    | tmul s' x =>
      ext i
      simp [tmul_def, mul_assoc]
    | add x y hx hy => rw [smul_add, _root_.map_add, _root_.map_add, hx, hy, smul_add]

@[simp]
theorem piScalarRight_tmul (s : S) (x : ι → R) :
    piScalarRight f ι (tmul f s x) = fun i ↦ s * f (x i) := by
  ext i
  simp [piScalarRight, tmul_def]

@[simp]
theorem piScalarRight_symm_apply [DecidableEq ι] (v : ι → S) :
    (piScalarRight f ι).symm v = ∑ i, tmul f (v i) (Pi.single i 1) := by
  rw [LinearEquiv.symm_apply_eq, map_sum]
  ext i
  simp [Pi.single_apply]

end Pi

end BalancedExtension

end TauCeti
