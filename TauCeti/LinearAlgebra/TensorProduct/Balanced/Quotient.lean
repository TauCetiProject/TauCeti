module

public import Mathlib.Algebra.Algebra.Operations
public import Mathlib.Algebra.Algebra.Opposite
public import Mathlib.RingTheory.Ideal.Defs
public import TauCeti.LinearAlgebra.TensorProduct.Balanced.Basic

import Mathlib.Algebra.Algebra.Tower
import Mathlib.LinearAlgebra.Isomorphisms

/-!
# Balanced tensor products with cyclic quotients

For a right module `M` over an algebra `A` and a left ideal `K`, the balanced
tensor product `M ⊗_A (A ⧸ K)` is the quotient of `M` by the submodule generated
by the products `m k`. Taking `M` to be a right ideal gives the tensor calculation
in the cyclic Tor formula of Weibel, *An Introduction to Homological Algebra*,
Exercise 3.1.3, p. 68.
-/

public section

namespace TauCeti.BalancedTensorProduct

open MulOpposite

variable (R : Type*) {A : Type*} [CommRing R] [Ring A] [Algebra R A]
variable (M : Type*) [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
  [IsScalarTower R Aᵐᵒᵖ M]

/-- The ground-ring submodule `MK` of a right module generated by the products
`m k` with `k` in the left ideal `K`. -/
def rightSMulIdeal (K : Ideal A) : Submodule R M :=
  (K.restrictScalars R).map (opLinearEquiv R).toLinearMap • ⊤

/-- To contain `MK`, a submodule must contain each product `m k` for `k ∈ K`. -/
theorem rightSMulIdeal_le {K : Ideal A} {P : Submodule R M} :
    rightSMulIdeal R M K ≤ P ↔ ∀ k ∈ K, ∀ m : M, op k • m ∈ P := by
  rw [rightSMulIdeal, Submodule.smul_le]
  constructor
  · intro h k hk m
    exact h (op k) ⟨k, hk, rfl⟩ m Submodule.mem_top
  · rintro h _ ⟨k, hk, rfl⟩ m -
    exact h k hk m

private def actionModIdeal (K : Ideal A) :
    A →ₗ[R] M →ₗ[R] M ⧸ rightSMulIdeal R M K :=
  (LinearMap.llcomp R M M _ (rightSMulIdeal R M K).mkQ).comp
    ((Algebra.lsmul R R M (A := Aᵐᵒᵖ)).toLinearMap.comp (opLinearEquiv R).toLinearMap)

private theorem actionModIdeal_apply (K : Ideal A) (a : A) (m : M) :
    actionModIdeal R M K a m = (rightSMulIdeal R M K).mkQ (op a • m) := rfl

private def tensorQuotBilinear (K : Ideal A) :
    M →ₗ[R] (A ⧸ K) →ₗ[R] M ⧸ rightSMulIdeal R M K :=
  let g := (K.restrictScalars R).liftQ (actionModIdeal R M K) fun a ha ↦ by
    refine LinearMap.mem_ker.mpr (LinearMap.ext fun m ↦ ?_)
    rw [actionModIdeal_apply, LinearMap.zero_apply, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero]
    exact (rightSMulIdeal_le R M).mp le_rfl a ha m
  (g.comp (Submodule.Quotient.restrictScalarsEquiv R K).symm.toLinearMap).flip

private theorem tensorQuotBilinear_apply_mk (K : Ideal A) (m : M) (a : A) :
    tensorQuotBilinear R M K m (Submodule.Quotient.mk a) =
      Submodule.Quotient.mk (op a • m) := by
  simp [tensorQuotBilinear, Submodule.mkQ_apply, actionModIdeal_apply]

private theorem tensorQuotBilinear_balanced (K : Ideal A) (a : A) (m : M) (q : A ⧸ K) :
    tensorQuotBilinear R M K (op a • m) q = tensorQuotBilinear R M K m (a • q) := by
  obtain ⟨b, rfl⟩ := K.mkQ_surjective q
  rw [← K.mkQ.map_smul, Submodule.mkQ_apply, Submodule.mkQ_apply,
    tensorQuotBilinear_apply_mk, tensorQuotBilinear_apply_mk]
  simp [smul_smul, op_mul, smul_eq_mul]

private def quotSMulToTensorQuot (K : Ideal A) :
    (M ⧸ rightSMulIdeal R M K) →ₗ[R] BalancedTensorProduct R A M (A ⧸ K) :=
  (rightSMulIdeal R M K).liftQ ((mk R A).flip (K.mkQ 1)) <|
    (rightSMulIdeal_le R M).mpr fun k hk m ↦ by
      have hzero : K.mkQ k = 0 := by
        simpa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] using hk
      rw [LinearMap.mem_ker, LinearMap.flip_apply, mk_apply, balance, ← K.mkQ.map_smul,
        smul_eq_mul, mul_one, hzero, tmul_zero]

private theorem quotSMulToTensorQuot_mk (K : Ideal A) (m : M) :
    quotSMulToTensorQuot R M K (Submodule.Quotient.mk m) =
      tmul R A m (Submodule.Quotient.mk 1) := by
  rw [quotSMulToTensorQuot, Submodule.liftQ_apply, LinearMap.flip_apply, mk_apply,
    Submodule.mkQ_apply]

/-- The balanced tensor product `M ⊗_A (A ⧸ K)` is the quotient by `MK`. -/
noncomputable def tensorQuotEquivQuotSMul (K : Ideal A) :
    BalancedTensorProduct R A M (A ⧸ K) ≃ₗ[R] M ⧸ rightSMulIdeal R M K :=
  LinearEquiv.ofLinearMap (lift (tensorQuotBilinear R M K) (tensorQuotBilinear_balanced R M K))
    (quotSMulToTensorQuot R M K)
    ((rightSMulIdeal R M K).quot_hom_ext _ _ fun m ↦ by
      simp only [LinearMap.comp_apply, quotSMulToTensorQuot_mk, lift_tmul,
        tensorQuotBilinear_apply_mk, op_one, one_smul, LinearMap.id_apply])
    (hom_ext fun m q ↦ by
      obtain ⟨a, rfl⟩ := K.mkQ_surjective q
      simp only [LinearMap.comp_apply, lift_tmul, Submodule.mkQ_apply,
        tensorQuotBilinear_apply_mk, quotSMulToTensorQuot_mk, LinearMap.id_apply]
      rw [balance, ← Submodule.mkQ_apply, ← K.mkQ.map_smul, smul_eq_mul, mul_one,
        Submodule.mkQ_apply])

/-- The cyclic quotient comparison sends `m ⊗ [a]` to `[m a]`. -/
@[simp]
theorem tensorQuotEquivQuotSMul_tmul_mk (K : Ideal A) (m : M) (a : A) :
    tensorQuotEquivQuotSMul R M K (tmul R A m (Submodule.Quotient.mk (p := K) a)) =
      Submodule.Quotient.mk (op a • m) := by
  simp only [tensorQuotEquivQuotSMul, LinearEquiv.coe_ofLinearMap, lift_tmul,
    tensorQuotBilinear_apply_mk]

/-- The inverse cyclic quotient comparison sends `[m]` to `m ⊗ [1]`. -/
@[simp]
theorem tensorQuotEquivQuotSMul_symm_mk (K : Ideal A) (m : M) :
    (tensorQuotEquivQuotSMul R M K).symm (Submodule.Quotient.mk m) =
      tmul R A m (Submodule.Quotient.mk (p := K) 1) := by
  rw [LinearEquiv.symm_apply_eq, tensorQuotEquivQuotSMul_tmul_mk, op_one, one_smul]

/-- For the regular right module, the products with a left ideal generate that ideal. -/
@[simp]
theorem rightSMulIdeal_self (K : Ideal A) : rightSMulIdeal R A K = K.restrictScalars R := by
  apply le_antisymm
  · exact (rightSMulIdeal_le R A).mpr fun k hk a ↦ K.mul_mem_left a hk
  · intro k hk
    simpa [MulOpposite.smul_eq_mul_unop] using
      (rightSMulIdeal_le R A).mp le_rfl k hk (1 : A)

/-- In the ambient algebra, the products of a right ideal with a left ideal generate
their ground-ring submodule product. -/
theorem map_rightSMulIdeal_subtype (I : Submodule Aᵐᵒᵖ A) (K : Ideal A) :
    (rightSMulIdeal R I K).map (I.subtype.restrictScalars R) =
      I.restrictScalars R * K.restrictScalars R := by
  apply le_antisymm
  · rw [Submodule.map_le_iff_le_comap, rightSMulIdeal_le]
    intro k hk i
    exact Submodule.mul_mem_mul i.property hk
  · rw [Submodule.mul_le]
    intro i hi k hk
    exact ⟨op k • (⟨i, hi⟩ : I), (rightSMulIdeal_le R I).mp le_rfl k hk _, rfl⟩

section Kernel

variable (I : Submodule Aᵐᵒᵖ A) (K : Ideal A)

private theorem map_subtype_tmul_mk_one_eq_zero_iff (i : I) :
    map (I.subtype.restrictScalars R) LinearMap.id
        (fun _ _ ↦ by simp only [LinearMap.restrictScalars_apply, map_smul]) (fun _ _ ↦ rfl)
        (tmul R A i (Submodule.Quotient.mk (p := K) 1)) = 0 ↔ (i : A) ∈ K := by
  -- The equivariance proof uses the right-ideal inclusion before restriction of scalars.
  erw [map_tmul]
  rw [LinearMap.id_apply, ← (tensorQuotEquivQuotSMul R A K).map_eq_zero_iff,
    tensorQuotEquivQuotSMul_tmul_mk, op_one, one_smul, Submodule.Quotient.mk_eq_zero]
  simp

/-- The kernel of `I ⊗_A (A ⧸ K) → A ⊗_A (A ⧸ K)` is `(I ∩ K)/IK`.
The map to the kernel sends the class of `i` to `i ⊗ [1]`. -/
noncomputable def kerMapRightIdealTensorQuotEquiv :
    let f := map (A := A) (I.subtype.restrictScalars R) (LinearMap.id : (A ⧸ K) →ₗ[R] (A ⧸ K))
      (fun _ _ ↦ by simp only [LinearMap.restrictScalars_apply, map_smul]) (fun _ _ ↦ rfl)
    let J := I.restrictScalars R ⊓ K.restrictScalars R
    let P := I.restrictScalars R * K.restrictScalars R
    LinearMap.ker f ≃ₗ[R] J ⧸ P.comap J.subtype := by
  intro f J P
  let ι : J →ₗ[R] I := J.subtype.codRestrict (I.restrictScalars R)
    (fun j ↦ j.property.1)
  let g : J →ₗ[R] LinearMap.ker f :=
    (((mk R A).flip (Submodule.Quotient.mk (p := K) 1)).comp ι).codRestrict _ fun j ↦ by
      rw [LinearMap.mem_ker, LinearMap.comp_apply, LinearMap.flip_apply, mk_apply]
      exact (map_subtype_tmul_mk_one_eq_zero_iff R I K (ι j)).mpr j.property.2
  have hg_apply (j : J) :
      (g j : BalancedTensorProduct R A I (A ⧸ K)) =
        tmul R A (ι j) (Submodule.Quotient.mk (p := K) 1) := by
    simp only [g, LinearMap.codRestrict_apply, LinearMap.comp_apply, LinearMap.flip_apply,
      mk_apply]
  have hg : Function.Surjective g := by
    -- The cyclic quotient comparison represents every tensor by one with second factor `[1]`.
    intro z
    let e := tensorQuotEquivQuotSMul R I K
    obtain ⟨i, hi⟩ := (rightSMulIdeal R I K).mkQ_surjective (e z)
    have ht : tmul R A i (Submodule.Quotient.mk (p := K) 1) =
        (z : BalancedTensorProduct R A I (A ⧸ K)) := by
      rw [← tensorQuotEquivQuotSMul_symm_mk, ← Submodule.mkQ_apply, hi,
        LinearEquiv.symm_apply_apply]
    have hik : (i : A) ∈ K :=
      (map_subtype_tmul_mk_one_eq_zero_iff R I K i).mp (ht ▸ LinearMap.mem_ker.mp z.property)
    let j : J := ⟨i, i.property, hik⟩
    have hι : ι j = i := Subtype.ext rfl
    refine ⟨j, Subtype.ext ?_⟩
    rw [hg_apply, hι, ht]
  have hker : LinearMap.ker g = P.comap J.subtype := by
    -- The cyclic quotient comparison identifies vanishing with membership in `IK`.
    ext j
    rw [LinearMap.mem_ker, ← Subtype.coe_inj]
    simp only [hg_apply, Submodule.coe_zero]
    rw [← (tensorQuotEquivQuotSMul R I K).map_eq_zero_iff, tensorQuotEquivQuotSMul_tmul_mk,
      op_one, one_smul, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap]
    rw [← Submodule.comap_map_eq_of_injective (f := I.subtype.restrictScalars R)
      Subtype.coe_injective (rightSMulIdeal R I K), map_rightSMulIdeal_subtype, Submodule.mem_comap]
    rfl
  exact ((Submodule.quotEquivOfEq _ _ hker.symm).trans (g.quotKerEquivOfSurjective hg)).symm

/-- The inverse kernel comparison sends the class of `i ∈ I ∩ K` to `i ⊗ [1]`. -/
@[simp]
theorem kerMapRightIdealTensorQuotEquiv_symm_mk
    (i : ↥(I.restrictScalars R ⊓ K.restrictScalars R)) :
    ((kerMapRightIdealTensorQuotEquiv R I K).symm (Submodule.Quotient.mk i) :
        BalancedTensorProduct R A I (A ⧸ K)) =
      tmul R A (⟨i, i.property.1⟩ : I) (Submodule.Quotient.mk (p := K) 1) := by
  simp only [kerMapRightIdealTensorQuotEquiv, LinearEquiv.symm_symm, LinearEquiv.trans_apply]
  -- The quotient by the equal submodule uses the same representative `i`.
  refine (congrArg Subtype.val
    (LinearMap.quotKerEquivOfSurjective_apply_mk _ _ i)).trans ?_
  simp only [LinearMap.codRestrict_apply]
  refine (LinearMap.comp_apply _ _ i).trans ((LinearMap.flip_apply _ _ _).trans ?_)
  exact mk_apply R A _ _

end Kernel

end TauCeti.BalancedTensorProduct
