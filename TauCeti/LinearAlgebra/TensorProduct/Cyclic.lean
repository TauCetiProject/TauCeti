module

public import Mathlib.LinearAlgebra.TensorProduct.Basic
public import Mathlib.LinearAlgebra.Span.Basic

/-!
# Tensor products with a cyclic module

If an `R`-module `N` is generated by a single element `n₀`, then every element of `M ⊗[R] N` is a
pure tensor `m ⊗ n₀`: a pure tensor `m ⊗ r • n₀` equals `r • m ⊗ n₀`, and sums of such tensors
combine in the left factor. Applied to extension of scalars `S ⊗[R] N`, this says that the
extension of a cyclic module is cyclic, generated by `1 ⊗ n₀`.

## Main declarations

* `TensorProduct.exists_eq_tmul_of_span_singleton_eq_top`: every element of `M ⊗[R] N` is
  `m ⊗ n₀` when `n₀` spans `N`.
-/

public section

open scoped TensorProduct

namespace TensorProduct

variable {R M N : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M] [AddCommMonoid N]
  [Module R N]

/-- If `n₀` spans `N`, then every element of `M ⊗[R] N` is a pure tensor `m ⊗ n₀`. -/
theorem exists_eq_tmul_of_span_singleton_eq_top {n₀ : N} (h : Submodule.span R {n₀} = ⊤)
    (x : M ⊗[R] N) : ∃ m : M, x = m ⊗ₜ n₀ := by
  induction x using TensorProduct.inductionOn with
  | tmul m n =>
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp (h ▸ Submodule.mem_top (x := n))
    exact ⟨r • m, (smul_tmul r m n₀).symm⟩
  | add x y hx hy =>
    obtain ⟨m, rfl⟩ := hx
    obtain ⟨m', rfl⟩ := hy
    exact ⟨m + m', (add_tmul m m' n₀).symm⟩

end TensorProduct
