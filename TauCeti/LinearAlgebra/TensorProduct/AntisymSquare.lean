/-!
# The antisymmetric tensor cokernel

For a module `M` over a commutative ring `R`, the **antisymmetric tensor cokernel**
`TauCeti.antisymSquare R M` is the quotient of `M ⊗[R] M` by the image of `1 + τ`, where `τ` is
the flip `a ⊗ b ↦ b ⊗ a`; the class of `a ⊗ b` is written `a ∧ b`. It is the target of the
boundary map `[x] ↦ x ∧ (1 - x)` on the pre-Bloch group of a field `F`, taken with `R = ℤ` and
`M = Additive Fˣ` (Weibel's antisymmetric square).

In `antisymSquare R M` the wedge is skew, `a ∧ b + b ∧ a = 0`, but the diagonal classes `a ∧ a`
need not vanish: they satisfy only `2 • (a ∧ a) = 0`. So `antisymSquare R M` is neither the
exterior square `⋀[R]^2 M`, which kills `a ∧ a`, nor the antisymmetric tensors
`TauCeti.antisymmetricTensors R M`, which form the kernel rather than the cokernel of `1 + τ`.
Over `ℤ` the discrepancy with the exterior square is exactly `A/2A`: for every abelian group `A`
the sequence `0 → A/2A → antisymSquare ℤ A → ⋀[ℤ]^2 A → 0`, with first map `a ↦ a ∧ a`, is
exact. For instance `antisymSquare ℤ ℤ` is `ℤ/2`, generated by `1 ∧ 1`, while `⋀[ℤ]^2 ℤ = 0`.

## Main definitions

* `TauCeti.antisymSquare R M`: the quotient `M ⊗[R] M ⧸ range (1 + τ)`.
* `TauCeti.antisymSquare.mk`: the bilinear map `(a, b) ↦ a ∧ b`.
* `TauCeti.antisymSquare.lift`: a bilinear map `f` with `f a b + f b a = 0` factors through
  `antisymSquare R M`.
* `TauCeti.antisymSquare.map`: the map induced by a linear map `M → N`.
* `TauCeti.antisymSquare.diag`: the additive diagonal `a ↦ a ∧ a`.
* `TauCeti.antisymSquare.toExterior`: the canonical surjection onto `⋀[R]^2 M`.
* `TauCeti.antisymSquare.diagModTwo`: the map `A/2A → antisymSquare ℤ A` induced by the diagonal.

## Main results

* `TauCeti.antisymSquare.range_id_add_comm`: the relations are spanned by the `a ⊗ b + b ⊗ a`.
* `TauCeti.antisymSquare.mk_add_mk_swap` and `TauCeti.antisymSquare.two_nsmul_mk_self`: the wedge
  is skew and its diagonal is `2`-torsion.
* `TauCeti.antisymSquare.ker_toExterior`: the kernel of the exterior projection is spanned by the
  diagonal classes, over any commutative ring.
* `TauCeti.antisymSquare.diagModTwo_injective`, `TauCeti.antisymSquare.exact_diagModTwo_toExterior`
  and `TauCeti.antisymSquare.toExterior_surjective`: the sequence
  `0 → A/2A → antisymSquare ℤ A → ⋀[ℤ]^2 A → 0` is exact.
* `TauCeti.antisymSquare.diag_eq_diag_iff`: `a ∧ a = b ∧ b` in `antisymSquare ℤ A` exactly when
  `a - b` is divisible by two.
* `TauCeti.antisymSquare.mk_one_one_ne_zero`: `1 ∧ 1 ≠ 0` in `antisymSquare ℤ ℤ`.
* `TauCeti.antisymSquare_diagonal_exact`: the exact sequence
  `0 → A/2A → antisymSquare ℤ A → ⋀[ℤ]^2 A → 0`, stated through its maps.

## Implementation notes

Injectivity of `A/2A → antisymSquare ℤ A` is detected by a symmetric bilinear map `A × A → A/2A`
with `(a, a) ↦ a mod 2`. Such a map exists only after a choice: in coordinates for a
`ZMod 2`-basis of `A/2A` it is the coordinatewise product, which is symmetric, hence skew in
characteristic two, and restricts on the diagonal to the identity because `c * c = c` in `ZMod 2`.

## References

* C. Weibel, *The K-book: an introduction to algebraic K-theory*, Graduate Studies in
  Mathematics **145**, AMS, 2013, Chapter VI, §5 (opening of the section).
-/

public section

open TensorProduct

namespace TauCeti

variable (R M : Type*) [CommRing R] [AddCommGroup M] [Module R M]

/-- The **antisymmetric tensor cokernel** `M ⊗[R] M ⧸ range (1 + τ)` of an `R`-module `M`, where
`τ` is the flip `a ⊗ b ↦ b ⊗ a`. The class of `a ⊗ b` is the wedge `a ∧ b`
(`TauCeti.antisymSquare.mk`). Unlike in the exterior square, the diagonal class `a ∧ a` need not
vanish; it is only `2`-torsion. -/
abbrev antisymSquare : Type _ :=
  (M ⊗[R] M) ⧸ LinearMap.range (LinearMap.id + (TensorProduct.comm R M M).toLinearMap)

namespace antisymSquare

/-- The relations of `antisymSquare R M` are spanned by the symmetrized tensors
`a ⊗ b + b ⊗ a`. -/
theorem range_id_add_comm :
    LinearMap.range (LinearMap.id + (TensorProduct.comm R M M).toLinearMap) =
      Submodule.span R (Set.range fun p : M × M ↦ p.1 ⊗ₜ[R] p.2 + p.2 ⊗ₜ[R] p.1) := by
  rw [LinearMap.range_eq_map, ← TensorProduct.span_tmul_eq_top, Submodule.map_span]
  congr 1
  ext x
  simp [Prod.exists, eq_comm]

/-- The bilinear wedge `(a, b) ↦ a ∧ b`, the class of `a ⊗ b` in `antisymSquare R M`. -/
def mk : M →ₗ[R] M →ₗ[R] antisymSquare R M :=
  (TensorProduct.mk R M M).compr₂ (Submodule.mkQ _)

variable {R M}

/-- The wedge `a ∧ b` is the class of the tensor `a ⊗ b`. -/
theorem mk_apply (a b : M) : mk R M a b = Submodule.Quotient.mk (a ⊗ₜ[R] b) :=
  (rfl)

/-- The wedge is skew: `a ∧ b + b ∧ a = 0`. -/
@[simp]
theorem mk_add_mk_swap (a b : M) : mk R M a b + mk R M b a = 0 := by
  rw [mk_apply, mk_apply, ← Submodule.Quotient.mk_add, Submodule.Quotient.mk_eq_zero]
  exact ⟨a ⊗ₜ b, by simp⟩

/-- The wedge is skew: `b ∧ a = -(a ∧ b)`. -/
theorem mk_swap (a b : M) : mk R M b a = -mk R M a b :=
  eq_neg_of_add_eq_zero_right (mk_add_mk_swap a b)

/-- The diagonal class `a ∧ a` is `2`-torsion. -/
@[simp]
theorem two_nsmul_mk_self (a : M) : 2 • mk R M a a = 0 := by
  rw [two_nsmul, mk_add_mk_swap]

/-- The diagonal is additive: `(a + b) ∧ (a + b) = a ∧ a + b ∧ b`. -/
theorem mk_add_add (a b : M) : mk R M (a + b) (a + b) = mk R M a a + mk R M b b := by
  simp only [map_add, LinearMap.add_apply, mk_swap b a]
  abel

/-- The wedges `a ∧ b` span `antisymSquare R M`. -/
theorem span_mk : Submodule.span R {z : antisymSquare R M | ∃ a b, mk R M a b = z} = ⊤ := by
  rw [eq_top_iff]
  rintro z -
  obtain ⟨t, rfl⟩ := Submodule.mkQ_surjective _ z
  induction t using TensorProduct.inductionOn with
  | tmul a b => exact Submodule.subset_span ⟨a, b, rfl⟩
  | add t t' ht ht' => simpa using Submodule.add_mem _ ht ht'

variable (R M) in
/-- The diagonal `a ↦ a ∧ a`, an additive map. It need not be `R`-linear;
it satisfies `diag (r • a) = r ^ 2 • diag a`. -/
def diag : M →+ antisymSquare R M where
  toFun a := mk R M a a
  map_zero' := by simp
  map_add' := mk_add_add

/-- The diagonal sends `a` to the wedge `a ∧ a`. -/
@[simp]
theorem diag_apply (a : M) : diag R M a = mk R M a a :=
  (rfl)

/-- The diagonal is quadratic in the scalars: `(r • a) ∧ (r • a) = r ^ 2 • (a ∧ a)`. -/
theorem diag_smul (r : R) (a : M) : diag R M (r • a) = r ^ 2 • diag R M a := by
  simp [pow_two, mul_smul]

/-- The diagonal vanishes on `2M`. -/
theorem diag_two_nsmul (a : M) : diag R M (2 • a) = 0 := by
  rw [map_nsmul, diag_apply, two_nsmul_mk_self]

section lift

variable {N : Type*} [AddCommGroup N] [Module R N]

/-- **Universal property.** A bilinear map `f` with `f a b + f b a = 0` factors through
`antisymSquare R M`, sending `a ∧ b` to `f a b` (`TauCeti.antisymSquare.lift_mk`); the
factorization is unique by `TauCeti.antisymSquare.ext`. -/
def lift (f : M →ₗ[R] M →ₗ[R] N) (hf : ∀ a b, f a b + f b a = 0) :
    antisymSquare R M →ₗ[R] N :=
  Submodule.liftQ _ (TensorProduct.lift f) <| LinearMap.range_le_ker_iff.2 <|
    TensorProduct.ext' fun a b ↦ by simp [hf]

/-- The factorization of `f` sends `a ∧ b` to `f a b`. -/
@[simp]
theorem lift_mk (f : M →ₗ[R] M →ₗ[R] N) (hf : ∀ a b, f a b + f b a = 0) (a b : M) :
    lift f hf (mk R M a b) = f a b :=
  (rfl)

/-- Two linear maps out of `antisymSquare R M` agreeing on every wedge `a ∧ b` are equal.

The priority is raised so that `ext` uses this lemma before the extensionality lemmas of the
underlying quotient and tensor product, which would state the goal through `mkQ` and `curry`. -/
@[ext high]
theorem ext {f g : antisymSquare R M →ₗ[R] N} (h : ∀ a b, f (mk R M a b) = g (mk R M a b)) :
    f = g :=
  Submodule.linearMap_qext _ (TensorProduct.ext' h)

/-- The factorization of `f` through the wedge is `f` itself. -/
@[simp]
theorem mk_compr₂_lift (f : M →ₗ[R] M →ₗ[R] N) (hf : ∀ a b, f a b + f b a = 0) :
    (mk R M).compr₂ (lift f hf) = f := by
  ext a b
  simp

/-- A linear map out of `antisymSquare R M` is the lift of its composite with the wedge. -/
@[simp]
theorem lift_mk_compr₂ (g : antisymSquare R M →ₗ[R] N) :
    lift ((mk R M).compr₂ g) (fun a b ↦ by simp [← map_add]) = g := by
  ext a b
  simp

end lift

section map

variable {N P : Type*} [AddCommGroup N] [Module R N] [AddCommGroup P] [Module R P]

/-- The map `a ∧ b ↦ g a ∧ g b` induced by a linear map `g : M → N`. -/
def map (g : M →ₗ[R] N) : antisymSquare R M →ₗ[R] antisymSquare R N :=
  lift ((mk R N).compl₁₂ g g) fun a b ↦ mk_add_mk_swap (g a) (g b)

/-- The induced map sends `a ∧ b` to `g a ∧ g b`. -/
@[simp]
theorem map_mk (g : M →ₗ[R] N) (a b : M) : map g (mk R M a b) = mk R N (g a) (g b) :=
  (rfl)

/-- The identity induces the identity. -/
@[simp]
theorem map_id : map (LinearMap.id : M →ₗ[R] M) = LinearMap.id :=
  ext fun _ _ ↦ rfl

/-- The induced maps compose: `map (g ∘ h) = map g ∘ map h`. -/
theorem map_comp (g : N →ₗ[R] P) (h : M →ₗ[R] N) : map (g ∘ₗ h) = map g ∘ₗ map h :=
  ext fun _ _ ↦ rfl

end map

section toExterior

variable (R M) in
/-- The canonical projection `a ∧ b ↦ a ∧ b` onto the exterior square `⋀[R]^2 M`, which kills the
diagonal classes. -/
def toExterior : antisymSquare R M →ₗ[R] ⋀[R]^2 M :=
  lift (exteriorPower.ιMulti R 2).toMultilinearMap.toBilinMap fun a b ↦ by
    rw [← (exteriorPower.ιMulti R 2).isAlt_toBilinMap.neg b a, neg_add_cancel]

/-- The exterior projection sends the wedge `a ∧ b` to the exterior product `a ∧ b`. -/
@[simp]
theorem toExterior_mk (a b : M) :
    toExterior R M (mk R M a b) = exteriorPower.ιMulti R 2 ![a, b] := by
  simp [toExterior]

/-- The exterior projection kills the diagonal classes `a ∧ a`. -/
theorem toExterior_mk_self (a : M) : toExterior R M (mk R M a a) = 0 := by
  rw [toExterior_mk]
  exact (exteriorPower.ιMulti R 2).map_eq_zero_of_eq _ (i := 0) (j := 1) rfl zero_ne_one

/-- The exterior projection is surjective, since the exterior products span `⋀[R]^2 M`. -/
theorem toExterior_surjective : Function.Surjective (toExterior R M) := by
  rw [← LinearMap.range_eq_top, eq_top_iff, ← exteriorPower.ιMulti_span, Submodule.span_le]
  rintro _ ⟨v, rfl⟩
  refine ⟨mk R M (v 0) (v 1), ?_⟩
  rw [toExterior_mk]
  congr 1
  ext i
  fin_cases i <;> rfl

/-- The exterior projection is natural: it intertwines the maps induced by `g` on
`antisymSquare` and on the exterior square. -/
theorem toExterior_comp_map {N : Type*} [AddCommGroup N] [Module R N] (g : M →ₗ[R] N) :
    toExterior R N ∘ₗ map g = exteriorPower.map 2 g ∘ₗ toExterior R M :=
  ext fun a b ↦ by
    rw [LinearMap.comp_apply, LinearMap.comp_apply, map_mk, toExterior_mk, toExterior_mk,
      exteriorPower.map_apply_ιMulti_two]

/-- The exterior projection is natural, applied to an element: see
`TauCeti.antisymSquare.toExterior_comp_map`. -/
theorem toExterior_map {N : Type*} [AddCommGroup N] [Module R N] (g : M →ₗ[R] N)
    (z : antisymSquare R M) :
    toExterior R N (map g z) = exteriorPower.map 2 g (toExterior R M z) :=
  congr($(toExterior_comp_map g) z)

/-- The kernel of the exterior projection is the submodule spanned by the diagonal classes
`a ∧ a`. -/
theorem ker_toExterior :
    LinearMap.ker (toExterior R M) = Submodule.span R (Set.range (diag R M)) := by
  set D := Submodule.span R (Set.range (diag R M))
  refine le_antisymm (fun z hz ↦ ?_) <| Submodule.span_le.2 ?_
  · -- The wedge modulo `D` is alternating, so it descends to `⋀[R]^2 M`; this inverts the
    -- exterior projection modulo `D`.
    have hω : ((mk R M).compr₂ D.mkQ).IsAlt := fun a ↦ by
      simpa [Submodule.Quotient.mk_eq_zero] using Submodule.subset_span (s := Set.range (diag R M))
        ⟨a, rfl⟩
    have h : exteriorPower.alternatingMapLinearEquiv hω.toAlternatingMap ∘ₗ toExterior R M =
        D.mkQ :=
      ext fun a b ↦ by simp [exteriorPower.alternatingMapLinearEquiv_apply_ιMulti]
    rw [LinearMap.mem_ker] at hz
    rw [← Submodule.Quotient.mk_eq_zero, ← Submodule.mkQ_apply, ← h, LinearMap.comp_apply, hz,
      map_zero]
  · rintro _ ⟨a, rfl⟩
    exact toExterior_mk_self a

end toExterior

section integral

variable {A : Type*} [AddCommGroup A]

/-- Over `ℤ` the kernel of the exterior projection consists of the diagonal classes `a ∧ a`
themselves, since the diagonal is additive. -/
theorem toExterior_eq_zero_iff (z : antisymSquare ℤ A) :
    toExterior ℤ A z = 0 ↔ ∃ a, diag ℤ A a = z := by
  rw [← LinearMap.mem_ker, ker_toExterior, ← Submodule.mem_toAddSubgroup,
    Submodule.span_int_eq_addSubgroupClosure, ← AddMonoidHom.coe_range, AddSubgroup.closure_eq,
    AddMonoidHom.mem_range]

/-- Over `ℤ`, the diagonal classes are exactly the kernel of the exterior projection:
`A → antisymSquare ℤ A → ⋀[ℤ]^2 A` is exact. -/
theorem exact_diag_toExterior : Function.Exact (diag ℤ A) (toExterior ℤ A) := fun z ↦
  (toExterior_eq_zero_iff z).trans Set.mem_range.symm

variable (A) in
/-- The map `A/2A → antisymSquare ℤ A`, `a mod 2 ↦ a ∧ a`, induced by the diagonal. -/
def diagModTwo : ModN A 2 →+ antisymSquare ℤ A :=
  ModN.liftEquiv.symm ⟨diag ℤ A, fun a ↦ by rw [diag_apply, two_nsmul_mk_self]⟩

/-- The diagonal map on `A/2A` sends `a mod 2` to `a ∧ a`. -/
@[simp]
theorem diagModTwo_mkQ (a : A) : diagModTwo A (ModN.mkQ 2 a) = diag ℤ A a :=
  (rfl)

/-- The coordinates of `a mod 2` in the chosen `ZMod 2`-basis of `A/2A`. -/
private noncomputable def modTwoCoord (A : Type*) [AddCommGroup A] :
    A →ₗ[ℤ] Module.Basis.ofVectorSpaceIndex (ZMod 2) (ModN A 2) →₀ ZMod 2 :=
  ((Module.Basis.ofVectorSpace (ZMod 2) (ModN A 2)).repr.toAddMonoidHom.comp
    (ModN.mkQ 2)).toIntLinearMap

private theorem modTwoCoord_apply (a : A) :
    modTwoCoord A a = (Module.Basis.ofVectorSpace (ZMod 2) (ModN A 2)).repr (ModN.mkQ 2 a) :=
  (rfl)

/-- The coordinatewise product of the coordinates of `a mod 2` and `b mod 2`: a symmetric
bilinear map taking `(a, a)` to the coordinates of `a mod 2`. -/
private noncomputable def coordProduct (A : Type*) [AddCommGroup A] :
    A →ₗ[ℤ] A →ₗ[ℤ] Module.Basis.ofVectorSpaceIndex (ZMod 2) (ModN A 2) →₀ ZMod 2 :=
  (LinearMap.mul ℤ _).compl₁₂ (modTwoCoord A) (modTwoCoord A)

private theorem coordProduct_add_swap (x y : A) :
    coordProduct A x y + coordProduct A y x = 0 := by
  ext i
  simp only [coordProduct, LinearMap.compl₁₂_apply, LinearMap.mul_apply', Finsupp.add_apply,
    Finsupp.mul_apply, Finsupp.coe_zero, Pi.zero_apply, mul_comm (modTwoCoord A y i)]
  exact CharTwo.add_self_eq_zero _

/-- In `antisymSquare ℤ A` the diagonal class `a ∧ a` vanishes only for `a ∈ 2A`, so the map
`A/2A → antisymSquare ℤ A` induced by the diagonal is injective. -/
theorem diagModTwo_injective : Function.Injective (diagModTwo A) := by
  set b := Module.Basis.ofVectorSpace (ZMod 2) (ModN A 2)
  have hq : Function.Surjective (ModN.mkQ (G := A) 2) := Submodule.mkQ_surjective _
  -- The coordinatewise product detects `a mod 2` on the diagonal, since `c * c = c` in `ZMod 2`.
  have hL : ∀ u, lift (coordProduct A) coordProduct_add_swap (diagModTwo A u) = b.repr u := by
    refine hq.forall.2 fun a ↦ ?_
    ext i
    simp only [diagModTwo_mkQ, diag_apply, lift_mk, coordProduct, LinearMap.compl₁₂_apply,
      LinearMap.mul_apply', Finsupp.mul_apply, modTwoCoord_apply, b]
    have hc : ∀ c : ZMod 2, c * c = c := by decide
    exact hc _
  rw [injective_iff_map_eq_zero]
  intro u hu
  apply b.repr.injective
  rw [← hL, hu, map_zero, map_zero]

/-- **The diagonal sequence.** The sequence `A/2A → antisymSquare ℤ A → ⋀[ℤ]^2 A` is exact;
together with `TauCeti.antisymSquare.diagModTwo_injective` and
`TauCeti.antisymSquare.toExterior_surjective` this makes
`0 → A/2A → antisymSquare ℤ A → ⋀[ℤ]^2 A → 0` short exact. -/
theorem exact_diagModTwo_toExterior : Function.Exact (diagModTwo A) (toExterior ℤ A) := by
  intro z
  rw [toExterior_eq_zero_iff]
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨ModN.mkQ 2 a, diagModTwo_mkQ a⟩
  · rintro ⟨u, rfl⟩
    obtain ⟨a, rfl⟩ := (Submodule.mkQ_surjective _ : Function.Surjective (ModN.mkQ (G := A) 2)) u
    exact ⟨a, (diagModTwo_mkQ a).symm⟩

/-- Over `ℤ`, `a ∧ a = 0` exactly when `a` is divisible by two. -/
theorem diag_eq_zero_iff (a : A) : diag ℤ A a = 0 ↔ ∃ c, a = 2 • c := by
  rw [← diagModTwo_mkQ, ← map_zero (diagModTwo A), diagModTwo_injective.eq_iff, ModN.mkQ,
    AddMonoidHom.coe_ofClass, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    LinearMap.mem_range]
  simp only [LinearMap.lsmul_apply, natCast_zsmul, eq_comm]

/-- Over `ℤ`, `a ∧ a = b ∧ b` exactly when `a - b` is divisible by two. -/
theorem diag_eq_diag_iff (a b : A) : diag ℤ A a = diag ℤ A b ↔ ∃ c, a - b = 2 • c := by
  rw [← sub_eq_zero, ← map_sub, diag_eq_zero_iff]

/-- In `antisymSquare ℤ ℤ` the class `1 ∧ 1` is nonzero, although its image in the exterior
square `⋀[ℤ]^2 ℤ` vanishes. -/
theorem mk_one_one_ne_zero : mk ℤ ℤ 1 1 ≠ 0 := by
  rw [ne_eq, ← diag_apply, diag_eq_zero_iff]
  rintro ⟨c, hc⟩
  rw [two_nsmul] at hc
  omega

end integral

end antisymSquare

open antisymSquare in
/-- For an abelian group `A`, the sequence `0 → A/2A → antisymSquare ℤ A → ⋀[ℤ]^2 A → 0` is
exact, stated through its maps: the exterior projection is a surjection sending `a ∧ b` to
`ιMulti ℤ 2 ![a, b]`, its kernel consists of the diagonal classes `a ∧ a`, and two diagonal
classes `a ∧ a` and `b ∧ b` agree exactly when `a - b ∈ 2A`. -/
theorem antisymSquare_diagonal_exact (A : Type*) [AddCommGroup A] :
    ∃ p : antisymSquare ℤ A →ₗ[ℤ] (⋀[ℤ]^2 A),
      Function.Surjective p ∧
      (∀ a b : A, p (Submodule.Quotient.mk (a ⊗ₜ[ℤ] b)) = exteriorPower.ιMulti ℤ 2 ![a, b]) ∧
      (∀ z : antisymSquare ℤ A, p z = 0 ↔ ∃ a : A,
        z = (Submodule.Quotient.mk (a ⊗ₜ[ℤ] a) : antisymSquare ℤ A)) ∧
      (∀ a b : A,
        (Submodule.Quotient.mk (a ⊗ₜ[ℤ] a) : antisymSquare ℤ A) =
          (Submodule.Quotient.mk (b ⊗ₜ[ℤ] b) : antisymSquare ℤ A) ↔
        ∃ c : A, a - b = 2 • c) := by
  refine ⟨toExterior ℤ A, toExterior_surjective, fun a b ↦ toExterior_mk a b, fun z ↦ ?_,
    diag_eq_diag_iff⟩
  rw [toExterior_eq_zero_iff]
  exact exists_congr fun a ↦ eq_comm

end TauCeti
