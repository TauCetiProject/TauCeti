module

public import Mathlib.LinearAlgebra.TensorProduct.Map
public import Mathlib.RingTheory.FilteredAlgebra.Basic
public import TauCeti.Algebra.DirectSum.DegreeTail

/-!
# Total-degree tails on a tensor product

For families `F` and `G` of submodules, `tensorFiltrationTail F G n` is the sum of
the images of `F a ⊗ G b` for `n ≤ a + b`. For decreasing families this is already
the sum over `a + b = n`, and for two nonnegative `DirectSum.degreeTail` filtrations it coincides
with the bidegree `DirectSum.degreeTail` for the sum of the two degree functions
(`TauCeti.DirectSum.tensorFiltrationTail_degreeTail_eq`). No flatness or injectivity of the tensor
maps is required: we use their images, expressed by Mathlib's `Submodule.map₂`.

This is the decreasing filtration used for completed tensor products. It is distinct from
`TauCeti.tensorFiltration`, the increasing order filtration generated by degrees `a + b ≤ n`.

Adapted from `yuma-mizuno-lean/Mei`, commit
`2f6cbcc81315ba2d32fd3e4bfc4c592476cf5471`,
`Mei/LinearAlgebra/TensorProduct/Filtration.lean` (Apache 2.0).
The map and factor-exchange results adapt the ideal-family results in
`Mei/RingTheory/FilteredAlgebra/TensorProduct/Basic.lean` at commit
`a79c57178cc83666fc244ca6e6eeaa722e9b8bc7`, generalized here to arbitrary submodule families.
-/

public section

namespace TauCeti

open scoped TensorProduct

variable {R M N : Type*} [CommSemiring R]
  [AddCommMonoid M] [Module R M] [AddCommMonoid N] [Module R N]

/-- The sum of tensor images whose total filtration degree is at least `n`. -/
def tensorFiltrationTail (F : ℕ → Submodule R M) (G : ℕ → Submodule R N)
    (n : ℕ) : Submodule R (M ⊗[R] N) :=
  ⨆ a, ⨆ b, ⨆ (_ : n ≤ a + b), Submodule.map₂ (TensorProduct.mk R M N) (F a) (G b)

variable (F : ℕ → Submodule R M) (G : ℕ → Submodule R N)

/-- The defining sum of tensor images. -/
theorem tensorFiltrationTail_def (n : ℕ) :
    tensorFiltrationTail F G n =
      ⨆ a, ⨆ b, ⨆ (_ : n ≤ a + b),
        Submodule.map₂ (TensorProduct.mk R M N) (F a) (G b) := (rfl)

/-- Each tensor image of sufficiently high total degree lies in the filtration tail. -/
theorem map₂_le_tensorFiltrationTail {a b n : ℕ} (h : n ≤ a + b) :
    Submodule.map₂ (TensorProduct.mk R M N) (F a) (G b) ≤ tensorFiltrationTail F G n := by
  rw [tensorFiltrationTail_def]
  exact le_iSup_of_le a (le_iSup_of_le b (le_iSup_of_le h le_rfl))

/-- Pure tensors have at least the sum of the filtration degrees of their factors. -/
theorem tmul_mem_tensorFiltrationTail {a b n : ℕ} {x : M} {y : N}
    (h : n ≤ a + b) (hx : x ∈ F a) (hy : y ∈ G b) :
    x ⊗ₜ[R] y ∈ tensorFiltrationTail F G n :=
  map₂_le_tensorFiltrationTail F G h (Submodule.apply_mem_map₂ _ hx hy)

/-- To bound a tensor filtration tail, it suffices to bound its generating pure tensors. -/
theorem tensorFiltrationTail_le_iff {n : ℕ} {P : Submodule R (M ⊗[R] N)} :
    tensorFiltrationTail F G n ≤ P ↔
      ∀ a b, n ≤ a + b → ∀ x ∈ F a, ∀ y ∈ G b, x ⊗ₜ[R] y ∈ P := by
  simp only [tensorFiltrationTail_def, iSup_le_iff, Submodule.map₂_le,
    TensorProduct.mk_apply]

/-- Total-degree filtration tails decrease, even for arbitrary input families. -/
theorem tensorFiltrationTail_antitone : Antitone (tensorFiltrationTail F G) := by
  intro n m h
  exact (tensorFiltrationTail_le_iff F G).mpr fun a b hab x hx y hy =>
    tmul_mem_tensorFiltrationTail F G (h.trans hab) hx hy

/-- For decreasing input families, only pairs of total degree exactly `n` are needed. -/
theorem tensorFiltrationTail_eq_iSup_add_eq (hF : Antitone F) (hG : Antitone G) (n : ℕ) :
    tensorFiltrationTail F G n =
      ⨆ a, ⨆ b, ⨆ (_ : a + b = n),
        Submodule.map₂ (TensorProduct.mk R M N) (F a) (G b) := by
  apply le_antisymm
  · refine (tensorFiltrationTail_le_iff F G).mpr fun a b hab x hx y hy => ?_
    have ha : min a n ≤ a := min_le_left _ _
    have hb : n - min a n ≤ b := by omega
    have hab' : min a n + (n - min a n) = n := by omega
    apply Submodule.mem_iSup_of_mem (min a n)
    apply Submodule.mem_iSup_of_mem (n - min a n)
    rw [iSup_pos hab']
    exact Submodule.apply_mem_map₂ _ (hF ha hx) (hG hb hy)
  · refine iSup_le fun a => iSup_le fun b => iSup_le fun hab => ?_
    exact map₂_le_tensorFiltrationTail F G (by omega)

/-- If both degree-zero terms are full, the tensor filtration tail starts with the full module. -/
@[simp]
theorem tensorFiltrationTail_zero (hF : F 0 = ⊤) (hG : G 0 = ⊤) :
    tensorFiltrationTail F G 0 = ⊤ := by
  apply top_unique
  simpa [hF, hG, TensorProduct.map₂_mk_top_top_eq_top] using
    map₂_le_tensorFiltrationTail F G (a := 0) (b := 0) (n := 0) le_rfl

/-- The total-degree tails carry the standard filtration on order-dual natural indices. -/
instance tensorFiltrationTail_isFiltration :
    IsFiltration (fun n : ℕᵒᵈ => tensorFiltrationTail F G n.ofDual)
      (fun n : ℕᵒᵈ => tensorFiltrationTail F G (n.ofDual + 1)) where
  mono _ _ h := tensorFiltrationTail_antitone F G h
  is_le h := tensorFiltrationTail_antitone F G (Nat.succ_le_of_lt h)
  is_sup P n h := h (OrderDual.toDual (n.ofDual + 1)) (by exact Nat.lt_succ_self _)

/-- Tensoring linear maps preserving the factor families preserves total-degree tails. -/
theorem tensorFiltrationTail_le_comap_map {M' N' : Type*}
    [AddCommMonoid M'] [Module R M'] [AddCommMonoid N'] [Module R N']
    (F' : ℕ → Submodule R M') (G' : ℕ → Submodule R N')
    (f : M →ₗ[R] M') (g : N →ₗ[R] N')
    (hf : ∀ a, F a ≤ (F' a).comap f) (hg : ∀ b, G b ≤ (G' b).comap g) (n : ℕ) :
    tensorFiltrationTail F G n ≤
      (tensorFiltrationTail F' G' n).comap (TensorProduct.map f g) := by
  refine (tensorFiltrationTail_le_iff F G).mpr fun a b hab x hx y hy => ?_
  simpa only [Submodule.mem_comap, TensorProduct.map_tmul] using
    tmul_mem_tensorFiltrationTail F' G' hab (hf a hx) (hg b hy)

/-- Exchanging the factors preserves total-degree tails. -/
theorem comm_mem_tensorFiltrationTail (n : ℕ) {x : M ⊗[R] N}
    (hx : x ∈ tensorFiltrationTail F G n) :
    TensorProduct.comm R M N x ∈ tensorFiltrationTail G F n := by
  have h : tensorFiltrationTail F G n ≤
      (tensorFiltrationTail G F n).comap (TensorProduct.comm R M N).toLinearMap := by
    refine (tensorFiltrationTail_le_iff F G).mpr fun a b hab x hx y hy => ?_
    simpa only [Submodule.mem_comap, LinearEquiv.coe_coe, TensorProduct.comm_tmul] using
      tmul_mem_tensorFiltrationTail G F (by omega) hy hx
  exact h hx

/-- Factor exchange identifies the total-degree tails exactly. -/
@[simp]
theorem tensorFiltrationTail_comap_comm (n : ℕ) :
    (tensorFiltrationTail G F n).comap (TensorProduct.comm R M N).toLinearMap =
      tensorFiltrationTail F G n := by
  ext x
  constructor
  · intro hx
    have h := comm_mem_tensorFiltrationTail G F n hx
    rw [← TensorProduct.comm_symm R M N] at h
    simpa only [LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply] using h
  · exact comm_mem_tensorFiltrationTail F G n

end TauCeti

namespace TauCeti.DirectSum

open scoped TensorProduct

variable {R M N ι κ : Type*} [CommSemiring R]
  [AddCommMonoid M] [Module R M] [AddCommMonoid N] [Module R N]

/-- The total-degree tensor filtration tail of two nonnegative degree tails is the degree tail of
the bidegree tensor summands with respect to total degree. -/
theorem tensorFiltrationTail_degreeTail_eq
    (ℳ : ι → Submodule R M) (dM : ι → ℤ) (hnegM : ∀ i, dM i < 0 → ℳ i = ⊥)
    (𝓝 : κ → Submodule R N) (dN : κ → ℤ) (hnegN : ∀ j, dN j < 0 → 𝓝 j = ⊥) (k : ℕ) :
    tensorFiltrationTail (degreeTail ℳ dM) (degreeTail 𝓝 dN) k =
      degreeTail (fun p : ι × κ => Submodule.map₂ (TensorProduct.mk R M N) (ℳ p.1) (𝓝 p.2))
        (fun p => dM p.1 + dN p.2) k := by
  let 𝒯 : ι × κ → Submodule R (M ⊗[R] N) :=
    fun p => Submodule.map₂ (TensorProduct.mk R M N) (ℳ p.1) (𝓝 p.2)
  let δ : ι × κ → ℤ := fun p => dM p.1 + dN p.2
  apply le_antisymm
  · refine (tensorFiltrationTail_le_iff _ _).mpr fun a b hab => ?_
    have hstep (j : κ) (hj : (b : ℤ) ≤ dN j) {y : N} (hy : y ∈ 𝓝 j) :
        degreeTail ℳ dM a ≤ (degreeTail 𝒯 δ k).comap ((TensorProduct.mk R M N).flip y) := by
      simp only [degreeTail_def, iSup_le_iff]; intro i hi x hx
      simpa only [Submodule.mem_comap, LinearMap.flip_apply, degreeTail_def] using
        le_degreeTail 𝒯 δ (n := k) (i := (i, j)) (by dsimp [δ]; omega)
          (Submodule.apply_mem_map₂ _ hx hy)
    intro x hx y hy
    refine (?_ : degreeTail 𝓝 dN b ≤ (degreeTail 𝒯 δ k).comap (TensorProduct.mk R M N x)) hy
    simp only [degreeTail_def, iSup_le_iff]
    intro j hj z hz
    simpa only [Submodule.mem_comap, LinearMap.flip_apply, degreeTail_def] using hstep j hj hz hx
  · simp only [degreeTail_def, iSup_le_iff, Prod.forall, Submodule.map₂_le, TensorProduct.mk_apply]
    intro i j hij x hx y hy
    by_cases hi : dM i < 0
    · obtain rfl : x = 0 := by simpa only [hnegM i hi, Submodule.mem_bot] using hx
      simp
    by_cases hj : dN j < 0
    · obtain rfl : y = 0 := by simpa only [hnegN j hj, Submodule.mem_bot] using hy
      simp
    exact tmul_mem_tensorFiltrationTail _ _ (a := (dM i).toNat) (b := (dN j).toNat) (by omega)
      (le_degreeTail ℳ dM (by omega) hx) (le_degreeTail 𝓝 dN (by omega) hy)

end TauCeti.DirectSum
