module

public import Mathlib.LinearAlgebra.Span.Basic
public import Mathlib.Algebra.Ring.Opposite

/-!
# Right annihilators as kernels in the regular right module

Right `A`-modules are left `Aᵐᵒᵖ`-modules, and the regular right module `A` is the regular left
module `Aᵐᵒᵖ`. Under this identification, left multiplication by `a` on `A` is the
`Aᵐᵒᵖ`-linear map `LinearMap.toSpanSingleton Aᵐᵒᵖ Aᵐᵒᵖ (op a)`, whose kernel is the right
annihilator of `a`, and the right ideal `bA` is the cyclic submodule generated by `op b`.

## Main results

* `TauCeti.span_singleton_op_eq_ker_toSpanSingleton_iff`: the right ideal `bA` is the kernel of
  left multiplication by `a` exactly when `a * s = 0` holds precisely for the multiples
  `s = b * t`.
-/

public section

namespace TauCeti

open MulOpposite

variable {A : Type*} [Ring A] {a b : A}

/-- **The right annihilator of `a` is `bA`** exactly when the cyclic submodule of `Aᵐᵒᵖ` generated
by `op b` is the kernel of right multiplication by `op a`, i.e. of left multiplication by `a` on
the regular right module `A`. -/
theorem span_singleton_op_eq_ker_toSpanSingleton_iff :
    Submodule.span Aᵐᵒᵖ {op b} = LinearMap.ker (LinearMap.toSpanSingleton Aᵐᵒᵖ Aᵐᵒᵖ (op a)) ↔
      ∀ s : A, a * s = 0 ↔ ∃ t, b * t = s := by
  rw [SetLike.ext_iff, op_surjective.forall]
  refine forall_congr' fun s ↦ ?_
  rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, Submodule.mem_span_singleton,
    smul_eq_mul, ← op_mul, op_eq_zero_iff, op_surjective.exists]
  simp only [smul_eq_mul, ← op_mul, op_inj]
  exact Iff.comm

end TauCeti
