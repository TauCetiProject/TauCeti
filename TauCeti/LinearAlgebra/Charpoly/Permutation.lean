public import TauCeti.LinearAlgebra.Finsupp.LMapDomain

/-!
# The characteristic polynomial of a permutation module

A permutation `π` of a finite type `α` acts on the free module `α →₀ R` by permuting the standard
basis, through `Finsupp.lmapDomain R R π`. This file computes the characteristic polynomial of that
endomorphism from the cycle structure of `π`: each cycle of length `d`, fixed points included,
contributes a factor `X ^ d - 1`, so

  `charpoly (lmapDomain π) = ∏ (X ^ d - 1)` and `reverse (charpoly (lmapDomain π)) = ∏ (1 - X ^ d)`,

with the products over `Equiv.Perm.fullCycleType π`, the multiset of all cycle lengths. The
permutation representation `Representation.ofMulAction` of a group acting on a finite set, such as
a coset space `G ⧸ H`, gets the same formulas in terms of the cycle type of `MulAction.toPerm g`.

The formulas hold over any commutative ring. They show that the characteristic polynomial of a
permutation module depends only on the cycle lengths of the permutation, hence only on its
conjugacy class, and the reversed form `det (1 - X π) = ∏ (1 - X ^ d)` is the shape in which such
determinants enter Euler factors: for `g` acting on `G ⧸ H`, it is read off from the orbits of the
cyclic subgroup generated by `g` on the cosets.

## Main results

* `Equiv.Perm.charpoly_lmapDomain`: the characteristic polynomial of a permutation module is the
  product of `X ^ d - 1` over the full cycle type.
* `Equiv.Perm.reverse_charpoly_lmapDomain`: its reverse is the product of `1 - X ^ d`.
* `Representation.charpoly_ofMulAction`, `Representation.reverse_charpoly_ofMulAction`: the same
  formulas for the permutation representation of a group acting on a finite set.
-/

public section

open Polynomial

namespace Equiv.Perm

variable {R α : Type*} [CommRing R]

/-- If a permutation preserves a predicate `p`, then the characteristic polynomial of its
permutation module is the product of those of its restrictions to `p` and to its complement. -/
theorem charpoly_lmapDomain_eq_mul_subtypePerm [Finite α] (π : Perm α) (p : α → Prop)
    (h : ∀ x, p (π x) ↔ p x) :
    (Finsupp.lmapDomain R R π).charpoly =
      (Finsupp.lmapDomain R R (π.subtypePerm h)).charpoly *
        (Finsupp.lmapDomain R R
          (π.subtypePerm (p := fun x ↦ ¬ p x) fun x ↦ not_congr (h x))).charpoly := by
  classical
  let e : (α →₀ R) ≃ₗ[R] ({x // p x} →₀ R) × ({x // ¬ p x} →₀ R) :=
    (Finsupp.domLCongr (Equiv.sumCompl p).symm).trans (Finsupp.sumFinsuppLEquivProdFinsupp R)
  rw [← LinearMap.charpoly_prodMap, ← e.charpoly_conj]
  congr 1
  apply LinearMap.prod_ext <;> apply Finsupp.lhom_ext <;> intro y c
  · have hy : p (π y) := (h y).mpr y.2
    simp [e, LinearEquiv.conj_apply, Equiv.sumCompl_symm_apply_of_pos hy,
      Finsupp.comapDomain_single, Finsupp.comapDomain_single_of_notMem_range]
  · have hy : ¬ p (π y) := (not_congr (h y)).mpr y.2
    simp [e, LinearEquiv.conj_apply, Equiv.sumCompl_symm_apply_of_neg hy,
      Finsupp.comapDomain_single, Finsupp.comapDomain_single_of_notMem_range]

variable [Fintype α]

/-- If a single cycle of `π` passes through every point, then the characteristic polynomial of its
permutation module is `X ^ Fintype.card α - 1`. -/
theorem charpoly_lmapDomain_of_forall_sameCycle (π : Perm α) {x : α}
    (hx : ∀ y, π.SameCycle x y) :
    (Finsupp.lmapDomain R R π).charpoly = X ^ Fintype.card α - 1 := by
  nontriviality R
  set n := Fintype.card α
  have hn : ∀ y, Function.minimalPeriod π y = n := fun y ↦ by
    rw [minimalPeriod_eq_natCard_of_forall_sameCycle π hx y, Nat.card_eq_fintype_card]
  have hpos : 0 < n := Fintype.card_pos_iff.mpr ⟨x⟩
  have hTn : Finsupp.lmapDomain R R π ^ n = 1 := by
    have : π ^ n = 1 := by
      ext y
      rw [Perm.one_apply, ← iterate_eq_pow, ← hn y, Function.iterate_minimalPeriod]
    rw [lmapDomain_pow, this, coe_one, Finsupp.lmapDomain_id, Module.End.one_eq_id]
  -- `single x 1` is a cyclic vector: its translates under the first `n` powers of the map are
  -- the distinct basis vectors `single ((π ^ i) x) 1`, so no nonzero polynomial of degree
  -- below `n` annihilates it.
  have hind : ∀ q : R[X], q.natDegree < n →
      aeval (Finsupp.lmapDomain R R π) q (Finsupp.single x 1) = 0 → q = 0 := by
    classical
    intro q hq h0
    ext j
    rw [coeff_zero]
    rcases lt_or_ge j n with hj | hj
    · have := congrArg (fun f ↦ f ((π ^ j) x)) h0
      simp only [aeval_eq_sum_range' hq, LinearMap.sum_apply, LinearMap.smul_apply, lmapDomain_pow,
        Finsupp.lmapDomain_apply, Finsupp.mapDomain_single, Finset.sum_apply', Finsupp.smul_apply,
        Finsupp.single_apply, smul_eq_mul, mul_ite, mul_one, mul_zero, Finsupp.coe_zero,
        Pi.zero_apply] at this
      rw [Finset.sum_eq_single_of_mem j (Finset.mem_range.mpr hj)] at this
      · simpa using this
      · intro i hi hij
        refine ite_eq_right_iff.mpr fun h ↦ (hij ?_).elim
        rw [← iterate_eq_pow, ← iterate_eq_pow] at h
        exact Function.iterate_injOn_Iio_minimalPeriod (by simpa [hn] using hi)
          (by simpa [hn] using hj) h
    · exact coeff_eq_zero_of_natDegree_lt (hq.trans_le hj)
  -- The characteristic polynomial and `X ^ n - 1` are monic of degree `n`, and both annihilate
  -- the map, so their difference is such a polynomial.
  have hdeg : (Finsupp.lmapDomain R R π).charpoly.natDegree = n := by
    rw [LinearMap.charpoly_natDegree, Module.finrank_finsupp_self]
  rw [← sub_eq_zero]
  apply hind
  · exact IsMonicOfDegree.natDegree_sub_lt hpos.ne' ⟨hdeg, LinearMap.charpoly_monic _⟩
      ((isMonicOfDegree_X_pow R n).sub (by simpa using hpos))
  · simp [LinearMap.aeval_self_charpoly, hTn]

variable [DecidableEq α]

/-- **The characteristic polynomial of a permutation module.** For a permutation `π` of a finite
type, the endomorphism of `α →₀ R` permuting the standard basis by `π` has characteristic
polynomial `∏ (X ^ d - 1)`, the product over the full cycle type of `π`, that is, over all
cycle lengths with fixed points counted as cycles of length one. -/
theorem charpoly_lmapDomain (π : Perm α) :
    (Finsupp.lmapDomain R R π).charpoly = (π.fullCycleType.map fun d ↦ X ^ d - 1).prod := by
  nontriviality R
  induction hn : Fintype.card α using Nat.strong_induction_on generalizing α with
  | _ n ih =>
  rcases isEmpty_or_nonempty α with hα | ⟨⟨x⟩⟩
  · rw [fullCycleType_of_isEmpty, Multiset.map_zero, Multiset.prod_zero]
    refine eq_one_of_monic_natDegree_zero (LinearMap.charpoly_monic _) ?_
    rw [LinearMap.charpoly_natDegree, Module.finrank_finsupp_self, Fintype.card_eq_zero]
  · -- Split off the cycle through `x`; the complement has fewer points.
    have h : ∀ y, π.SameCycle x (π y) ↔ π.SameCycle x y := fun _ ↦ sameCycle_apply_right
    rw [charpoly_lmapDomain_eq_mul_subtypePerm π _ h, fullCycleType_eq_add_subtypePerm π _ h,
      Multiset.map_add, Multiset.prod_add]
    congr 1
    · have hc : ∀ y, (π.subtypePerm h).SameCycle ⟨x, SameCycle.refl π x⟩ y :=
        fun y ↦ sameCycle_subtypePerm.mpr y.2
      rw [charpoly_lmapDomain_of_forall_sameCycle _ hc, fullCycleType_of_forall_sameCycle _ hc,
        Multiset.map_singleton, Multiset.prod_singleton]
    · refine ih _ ?_ _ rfl
      rw [← hn]
      exact Fintype.card_subtype_lt (p := fun y ↦ ¬ π.SameCycle x y) (x := x)
        (not_not.mpr (SameCycle.refl π x))

/-- **The reversed characteristic polynomial of a permutation module.** For a permutation `π`
of a finite type, `det (1 - X π)` on `α →₀ R` is `∏ (1 - X ^ d)`, the product over the full
cycle type of `π`. -/
theorem reverse_charpoly_lmapDomain (π : Perm α) :
    (Finsupp.lmapDomain R R π).charpoly.reverse =
      (π.fullCycleType.map fun d ↦ 1 - X ^ d).prod := by
  rw [charpoly_lmapDomain, reverse_multiset_prod_of_monic, Multiset.map_map]
  · refine congrArg Multiset.prod (Multiset.map_congr rfl fun d _ ↦ ?_)
    simpa using reverse_X_pow_sub_C d (1 : R)
  · simp only [Multiset.mem_map]
    rintro _ ⟨d, hd, rfl⟩
    exact monic_X_pow_sub_C 1 (pos_of_mem_fullCycleType hd).ne'

end Equiv.Perm

namespace Representation

variable {R G Ω : Type*} [CommRing R] [Group G] [MulAction G Ω] [Fintype Ω] [DecidableEq Ω]

/-- The characteristic polynomial of `g` in the permutation representation of a finite `G`-set
`Ω` is `∏ (X ^ d - 1)`, the product over the full cycle type of the permutation of `Ω` by `g`. -/
theorem charpoly_ofMulAction (g : G) :
    (ofMulAction R G Ω g).charpoly =
      ((MulAction.toPerm g : Equiv.Perm Ω).fullCycleType.map fun d ↦ X ^ d - 1).prod := by
  rw [← Equiv.Perm.charpoly_lmapDomain, ofMulAction_def,
    ← (MonoidAlgebra.coeffLinearEquiv R).symm.charpoly_conj (Finsupp.lmapDomain R R _),
    LinearEquiv.conj_apply, LinearEquiv.symm_symm]
  -- `MulAction.toPerm g` is `(g • ·)` as a function, by definition.
  rfl

/-- The reversed characteristic polynomial `det (1 - X g)` of `g` in the permutation
representation of a finite `G`-set `Ω` is `∏ (1 - X ^ d)`, the product over the full cycle type
of the permutation of `Ω` by `g`. -/
theorem reverse_charpoly_ofMulAction (g : G) :
    (ofMulAction R G Ω g).charpoly.reverse =
      ((MulAction.toPerm g : Equiv.Perm Ω).fullCycleType.map fun d ↦ 1 - X ^ d).prod := by
  rw [charpoly_ofMulAction, ← Equiv.Perm.charpoly_lmapDomain,
    Equiv.Perm.reverse_charpoly_lmapDomain]

end Representation
