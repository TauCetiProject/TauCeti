module

public import Mathlib.LinearAlgebra.CliffordAlgebra.Conjugation

/-!
# The Clifford vector normalizer

The vector normalizer consists of Clifford units for which twisted conjugation by the unit and
by its inverse both preserve the image of the underlying module. The two preservation conditions
make this a subgroup without any dimension or nondegeneracy assumption on the quadratic form.

This is the classical vector-normalizer condition; it is distinct from the subgroup generated by
invertible Clifford vectors.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I, §2.
-/

public section

namespace CliffordAlgebra

universe u v

variable {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
  (Q : QuadraticForm R M)

private theorem preservesVectorRange_mul {x y : (CliffordAlgebra Q)ˣ}
    (hx : ∀ m, involute (Q := Q) (x : CliffordAlgebra Q) * ι Q m *
      (x⁻¹ : (CliffordAlgebra Q)ˣ) ∈ LinearMap.range (ι Q))
    (hy : ∀ m, involute (Q := Q) (y : CliffordAlgebra Q) * ι Q m *
      (y⁻¹ : (CliffordAlgebra Q)ˣ) ∈ LinearMap.range (ι Q)) :
    ∀ m, involute (Q := Q) ((x * y : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * ι Q m *
      ((x * y)⁻¹ : (CliffordAlgebra Q)ˣ) ∈ LinearMap.range (ι Q) := by
  intro m
  obtain ⟨n, hn⟩ := hy m
  simpa only [hn, Units.val_mul, map_mul, mul_inv_rev, mul_assoc] using hx n

/-- Clifford units whose twisted conjugation, in both directions, preserves the vector range. -/
def vectorNormalizer : Subgroup (CliffordAlgebra Q)ˣ where
  carrier := {x | (∀ m, involute (Q := Q) (x : CliffordAlgebra Q) * ι Q m *
      (x⁻¹ : (CliffordAlgebra Q)ˣ) ∈ LinearMap.range (ι Q)) ∧
    (∀ m, involute (Q := Q) ((x⁻¹ : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * ι Q m *
      (x : CliffordAlgebra Q) ∈ LinearMap.range (ι Q))}
  one_mem' := by
    constructor <;> intro m <;> simp
  mul_mem' := by
    intro x y hx hy
    constructor
    · exact preservesVectorRange_mul Q hx.1 hy.1
    · simpa only [mul_inv_rev, inv_inv] using
        preservesVectorRange_mul Q (x := y⁻¹) (y := x⁻¹)
          (by simpa only [inv_inv] using hy.2) (by simpa only [inv_inv] using hx.2)
  inv_mem' := by
    intro x hx
    constructor
    · simpa only [inv_inv] using hx.2
    · simpa only [inv_inv] using hx.1

/-- Membership in the vector normalizer is twisted preservation by a unit and its inverse. -/
theorem mem_vectorNormalizer_iff (x : (CliffordAlgebra Q)ˣ) :
    x ∈ vectorNormalizer Q ↔
      (∀ m, involute (Q := Q) (x : CliffordAlgebra Q) * ι Q m *
        (x⁻¹ : (CliffordAlgebra Q)ˣ) ∈ LinearMap.range (ι Q)) ∧
      (∀ m, involute (Q := Q) ((x⁻¹ : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * ι Q m *
        (x : CliffordAlgebra Q) ∈ LinearMap.range (ι Q)) :=
  Iff.rfl

end CliffordAlgebra

end
