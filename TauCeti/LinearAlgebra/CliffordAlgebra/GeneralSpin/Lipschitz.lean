/-!
# The Clifford group and the Lipschitz group

This file compares the Clifford group `GPin(Q)`, the general spin group `GSpin(Q)` and the
norm-one spin group `Spin(Q)` of `TauCeti.LinearAlgebra.CliffordAlgebra.GeneralSpin.Basic` with
Mathlib's Lipschitz group `lipschitzGroup`, generated by the invertible vectors, and with Mathlib's
`spinGroup`, the even part of `pinGroup`, which is the unitary part of the Lipschitz group.

Over every commutative ring the Lipschitz group consists of locally homogeneous units. It lies in
the Clifford group whenever `Q(m)` is a unit for every invertible vector `ι(m)`, in particular for
a free module in every characteristic and whenever `2` is invertible. When `2` is invertible the
Clifford norm `gpinNorm` restricts to Tau Ceti's `lipschitzNorm`; when moreover the module is free,
the vector action `gpinToOrthogonal` restricts to Tau Ceti's `lipschitzToOrthogonal`. Over a
field of characteristic not two, for a nondegenerate form on a finite-dimensional space taking a
unit value (equivalently, of positive rank), the Clifford group *is* the Lipschitz group,
`GSpin(Q)` is its even part, and `Spin(Q)` is Mathlib's `spinGroup`. In rank `0` the Lipschitz
group is trivial while `GPin(Q)` is `Kˣ`, and in characteristic two the Lipschitz group can be
smaller than `GPin(Q)`, so neither hypothesis can be dropped.

## Main results

* `CliffordAlgebra.lipschitzGroup_le_gpinGroup_of_isUnit`,
  `CliffordAlgebra.lipschitzGroup_le_gpinGroup_of_free`,
  `CliffordAlgebra.lipschitzGroup_le_gpinGroup`: the Lipschitz group lies in the Clifford group.
* `CliffordAlgebra.gpinToOrthogonal_comp_inclusion`: for free `M`, `ρ` restricts to
  `lipschitzToOrthogonal`.
* `CliffordAlgebra.coe_gpinNorm_of_mem_lipschitzGroup`: `N` restricts to `lipschitzNorm`.
* `CliffordAlgebra.gpinGroup_eq_lipschitzGroup`,
  `CliffordAlgebra.gspinGroup_eq_lipschitzGroup_inf_evenUnits`, and
  `CliffordAlgebra.mem_normOneSpinGroup_iff_mem_spinGroup`: the field points.

## References

* B. Conrad, *Reductive group schemes*, Appendix C, §C.4.
-/

public section

open TauCeti

namespace CliffordAlgebra

universe u v

section Ring

variable {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
  (Q : QuadraticForm R M)

/-- **Lipschitz elements are locally homogeneous**: the generating invertible vectors are odd. -/
theorem lipschitzGroup_le_locallyHomogeneousUnits :
    lipschitzGroup Q ≤ locallyHomogeneousUnits Q := by
  rw [lipschitzGroup, Subgroup.closure_le]
  rintro x ⟨m, hm⟩
  rw [SetLike.mem_coe, mem_locallyHomogeneousUnits_iff, ← hm]
  exact isLocallyHomogeneous_of_mem_evenOdd_one (ι_mem_evenOdd_one Q m)

/-- **The Lipschitz group lies in the Clifford group** when `Q(m)` is a unit for every
invertible vector `ι(m)`. The twisted conjugation by an invertible vector `ι(a)` is the reflection
`ι(b) ↦ ι(b - Q(a)⁻¹ polar(a, b) a)`, read off from the Clifford relations. -/
theorem lipschitzGroup_le_gpinGroup_of_isUnit (hQ : ∀ m, IsUnit (ι Q m) → IsUnit (Q m)) :
    lipschitzGroup Q ≤ gpinGroup Q := by
  rw [gpinGroup_def]
  refine le_inf ?_ (lipschitzGroup_le_locallyHomogeneousUnits Q)
  rw [lipschitzGroup, Subgroup.closure_le]
  rintro x ⟨a, ha⟩
  -- As in Mathlib's `lipschitzGroup.involute_act_ι_mem_range_ι`, with `hQ` in place of
  -- `invertibleOfInvertibleι`.
  let := x.invertible
  let : Invertible (ι Q a) := by rwa [ha]
  let : Invertible (Q a) := (hQ a (by rw [ha]; exact x.isUnit)).invertible
  refine (mem_vectorNormalizer_iff Q x).mpr ⟨fun b => ?_, fun b => ?_⟩
  · simp_rw [← invOf_units x, ← ha, involute_ι, neg_mul, ι_mul_ι_mul_invOf_ι Q a b, ← map_neg,
      LinearMap.mem_range_self]
  · let := invertibleNeg (ι Q a)
    let := Invertible.map involute (ι Q a)
    simp_rw [← invOf_units x, ← ha, map_invOf, involute_ι, invOf_neg, neg_mul,
      invOf_ι_mul_ι_mul_ι, ← map_neg, LinearMap.mem_range_self]

/-- **The Lipschitz group lies in the Clifford group** for a free module, in every
characteristic. -/
theorem lipschitzGroup_le_gpinGroup_of_free [Module.Free R M] : lipschitzGroup Q ≤ gpinGroup Q :=
  lipschitzGroup_le_gpinGroup_of_isUnit Q fun _ => isUnit_of_isUnit_ι_of_free

variable [Invertible (2 : R)]

/-- **The Lipschitz group lies in the Clifford group** when `2` is invertible. -/
theorem lipschitzGroup_le_gpinGroup : lipschitzGroup Q ≤ gpinGroup Q :=
  lipschitzGroup_le_gpinGroup_of_isUnit Q fun _ => isUnit_of_isUnit_ι Q

/-- **The Clifford norm restricts to the Lipschitz norm.** -/
theorem coe_gpinNorm_of_mem_lipschitzGroup (x : lipschitzGroup Q) :
    ((gpinNorm Q ⟨x, lipschitzGroup_le_gpinGroup Q x.property⟩ : (CliffordAlgebra Q)ˣ) :
        CliffordAlgebra Q) =
      algebraMap R (CliffordAlgebra Q) (lipschitzNorm Q x : R) := by
  rw [coe_gpinNorm]
  exact star_mul_self_eq_algebraMap_lipschitzNorm Q x

/-- **The vector action restricts to the action of the Lipschitz group.** -/
theorem gpinToOrthogonal_comp_inclusion [Module.Free R M] :
    (gpinToOrthogonal Q).comp (Subgroup.inclusion (lipschitzGroup_le_gpinGroup Q)) =
      lipschitzToOrthogonal Q :=
  MonoidHom.ext fun x => Subtype.ext <| LinearEquiv.ext fun m => ι_injective_of_free Q <| by
    rw [MonoidHom.comp_apply, ι_gpinToOrthogonal_apply, coe_lipschitzToOrthogonal_apply,
      ι_lipschitzVectorAction_apply, Subgroup.coe_inclusion]

end Ring

section Field

variable {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] [Invertible (2 : K)] {Q : QuadraticForm K V}

/-- **Over a field of characteristic not two the Clifford group is the Lipschitz group**, for a
nondegenerate form taking a unit value. -/
theorem gpinGroup_eq_lipschitzGroup (hQ : Q.Nondegenerate) (hv : ∃ v, IsUnit (Q v)) :
    gpinGroup Q = lipschitzGroup Q :=
  le_antisymm
    (fun x hx => (mem_lipschitzGroup_iff_involute_act_ι_mem_range_ι Q hQ hv).mpr
      ((mem_vectorNormalizer_iff Q x).mp (mem_gpinGroup_iff.mp hx).1).1)
    (lipschitzGroup_le_gpinGroup Q)

/-- **Over a field of characteristic not two the general spin group is the even part of the
Lipschitz group**, for a nondegenerate form taking a unit value. -/
theorem gspinGroup_eq_lipschitzGroup_inf_evenUnits (hQ : Q.Nondegenerate)
    (hv : ∃ v, IsUnit (Q v)) :
    gspinGroup Q = lipschitzGroup Q ⊓ evenUnits Q := by
  rw [← gpinGroup_eq_lipschitzGroup hQ hv, gpinGroup_def, gspinGroup_def, inf_assoc,
    inf_eq_right.mpr (evenUnits_le_locallyHomogeneousUnits Q)]

/-- **Over a field of characteristic not two the norm-one spin group is Mathlib's `spinGroup`**,
for a nondegenerate form taking a unit value. -/
theorem mem_normOneSpinGroup_iff_mem_spinGroup (hQ : Q.Nondegenerate) (hv : ∃ v, IsUnit (Q v))
    {x : (CliffordAlgebra Q)ˣ} :
    x ∈ normOneSpinGroup Q ↔ (x : CliffordAlgebra Q) ∈ spinGroup Q := by
  rw [mem_normOneSpinGroup_iff, mem_spinGroup_iff_unitary_even_and_involute_act_ι_mem_range_ι Q
    hQ hv, Unitary.mem_iff]
  constructor
  · rintro ⟨hx, h⟩
    have hx' := hx
    rw [gspinGroup_def, Subgroup.mem_inf, mem_evenUnits_iff] at hx'
    have h' : star (x : CliffordAlgebra Q) * x = 1 := by
      rw [star_mul_self_eq_reverse_mul_self_of_mem_even hx'.2]
      exact h
    have hinv : star (x : CliffordAlgebra Q) = ↑x⁻¹ := Units.eq_inv_of_mul_eq_one_right h'
    refine ⟨⟨h', by rw [hinv, Units.mul_inv]⟩, hx'.2, fun m => ?_⟩
    rw [hinv]
    exact ((mem_vectorNormalizer_iff Q x).mp hx'.1).1 m
  · rintro ⟨⟨h1, -⟩, heven, hconj⟩
    have hinv : star (x : CliffordAlgebra Q) = ↑x⁻¹ := Units.eq_inv_of_mul_eq_one_right h1
    have hlip : x ∈ lipschitzGroup Q :=
      (mem_lipschitzGroup_iff_involute_act_ι_mem_range_ι Q hQ hv).mpr fun m => hinv ▸ hconj m
    have hspin : x ∈ gspinGroup Q := by
      rw [gspinGroup_eq_lipschitzGroup_inf_evenUnits hQ hv]
      exact ⟨hlip, (mem_evenUnits_iff Q).mpr heven⟩
    refine ⟨hspin, ?_⟩
    rwa [← star_mul_self_eq_reverse_mul_self_of_mem_even heven]

end Field

end CliffordAlgebra
