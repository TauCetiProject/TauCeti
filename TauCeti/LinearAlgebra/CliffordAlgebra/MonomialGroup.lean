/-!
# The finite group of signed monomials of a Clifford algebra

Let `b` be an orthogonal basis of a quadratic module `(M, Q)` whose generators square to `±1`, that
is `Q (b i) = 1` or `Q (b i) = -1` for every index `i`; over `ℂ` this is a normalized orthogonal
basis `e_i² = 1` of `ℂⁿ`. The subgroup `CliffordAlgebra.monomialGroup Q b` of the units of
`CliffordAlgebra Q` generated by `-1` and the generators `ι Q (b i)` is the finite group

`G = {±e_s : s a finite set of indices}`,

where `e_s = ι Q (b i₁) * ⋯ * ι Q (b iₖ)` for `s = {i₁ < ⋯ < iₖ}` is the basis vector
`CliffordAlgebra.basis Q b s`. Its multiplication is the sign rule
`CliffordAlgebra.basis_mul_basis`: `e_s * e_t = ±e_{s ∆ t}`. Its element `ε = -1` is central, and
when the ring is nontrivial and the index type has `n` elements the group has order `2 ^ (n + 1)`.

The group is a finite model of the Clifford algebra: the `e_s` form a basis of `CliffordAlgebra Q`
and multiply as the elements of `G` do, so its group algebra modulo `ε + 1` is the Clifford
algebra. That comparison is not made in this file.

## Main definitions

* `CliffordAlgebra.monomialGroup Q v`: the subgroup of `(CliffordAlgebra Q)ˣ` generated by `-1`
  and the units whose value is a generator `ι Q (v i)`, for any family `v` of vectors.

## Main results

* `CliffordAlgebra.mem_monomialGroup_iff`: **the normal form**: a unit lies in the group exactly
  when its value is `e_s` or `-e_s` for some finite index set `s`.
* `CliffordAlgebra.isUnit_basis`: each `e_s` is a unit, of square `±1`.
* `CliffordAlgebra.neg_one_mem_center_monomialGroup`: `ε = -1` is central.
* `CliffordAlgebra.natCard_monomialGroup`: **the order** of the group is `2 ^ (n + 1)`.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I, §1.
-/

public section

open scoped symmDiff

namespace CliffordAlgebra

variable {R M I : Type*} [CommRing R] [AddCommGroup M] [Module R M] (Q : QuadraticForm R M)

/-- The **group of signed monomials** of a family `v` of vectors: the subgroup of the units of
`CliffordAlgebra Q` generated by `-1` and the units whose value is a generator `ι Q (v i)`.

For an orthogonal basis whose generators square to `±1` it is the finite group of the `±e_s`
(`CliffordAlgebra.mem_monomialGroup_iff`). -/
def monomialGroup (v : I → M) : Subgroup (CliffordAlgebra Q)ˣ :=
  Subgroup.closure {u | (u : CliffordAlgebra Q) = -1 ∨ ∃ i, (u : CliffordAlgebra Q) = ι Q (v i)}

variable {Q} (v : I → M)

/-- The defining generators of the group of signed monomials. -/
theorem monomialGroup_def :
    monomialGroup Q v = Subgroup.closure {u : (CliffordAlgebra Q)ˣ |
      (u : CliffordAlgebra Q) = -1 ∨ ∃ i, (u : CliffordAlgebra Q) = ι Q (v i)} :=
  (rfl)

/-- The element `ε = -1` lies in the group of signed monomials. -/
theorem neg_one_mem_monomialGroup : -1 ∈ monomialGroup Q v :=
  Subgroup.subset_closure (Or.inl (by simp))

/-- A unit whose value is a generator `ι Q (v i)` lies in the group of signed monomials. -/
theorem mem_monomialGroup_of_val_eq_ι {u : (CliffordAlgebra Q)ˣ} {i : I}
    (h : (u : CliffordAlgebra Q) = ι Q (v i)) : u ∈ monomialGroup Q v :=
  Subgroup.subset_closure (Or.inr ⟨i, h⟩)

/-- **The element `ε = -1` is central** in the group of signed monomials. -/
theorem neg_one_mem_center_monomialGroup :
    (⟨-1, neg_one_mem_monomialGroup v⟩ : monomialGroup Q v) ∈ Subgroup.center (monomialGroup Q v) :=
  Subgroup.mem_center_iff.mpr fun _ ↦ Subtype.ext (Units.ext (by simp))

variable [Invertible (2 : R)] [LinearOrder I] {b : Module.Basis I R M}

omit [Invertible (2 : R)] in
/-- The coefficient in the multiplication rule `CliffordAlgebra.basis_mul_basis` is `±1` when every
generator squares to `±1`. -/
private theorem coeff_eq_one_or_neg_one (hQ : ∀ i, Q (b i) = 1 ∨ Q (b i) = -1) (s t : Finset I) :
    (-1 : R) ^ (∑ i ∈ s, (t.filter (· < i)).card) * ∏ i ∈ s ∩ t, Q (b i) = 1 ∨
      (-1 : R) ^ (∑ i ∈ s, (t.filter (· < i)).card) * ∏ i ∈ s ∩ t, Q (b i) = -1 := by
  have hprod : ∏ i ∈ s ∩ t, Q (b i) = 1 ∨ ∏ i ∈ s ∩ t, Q (b i) = -1 :=
    Finset.prod_induction _ (fun x : R ↦ x = 1 ∨ x = -1)
      (fun x y hx hy ↦ by rcases hx with rfl | rfl <;> rcases hy with rfl | rfl <;> simp)
      (Or.inl rfl) fun i _ ↦ hQ i
  rcases neg_one_pow_eq_or R (∑ i ∈ s, (t.filter (· < i)).card) with h | h <;> rw [h] <;>
    rcases hprod with h' | h' <;> rw [h'] <;> simp

/-- When every generator squares to `±1`, the product of two basis vectors is `±e_{s ∆ t}`. -/
private theorem basis_mul_basis_eq_or (hb : (QuadraticMap.associated Q).IsOrthoᵢ b)
    (hQ : ∀ i, Q (b i) = 1 ∨ Q (b i) = -1) (s t : Finset I) :
    basis Q b s * basis Q b t = basis Q b (s ∆ t) ∨
      basis Q b s * basis Q b t = -basis Q b (s ∆ t) := by
  rw [basis_mul_basis hb]
  rcases coeff_eq_one_or_neg_one hQ s t with hc | hc <;> rw [hc] <;> simp

/-- When every generator squares to `±1`, each basis vector `e_s` squares to `±1`. -/
private theorem basis_mul_self_eq_or (hb : (QuadraticMap.associated Q).IsOrthoᵢ b)
    (hQ : ∀ i, Q (b i) = 1 ∨ Q (b i) = -1) (s : Finset I) :
    basis Q b s * basis Q b s = 1 ∨ basis Q b s * basis Q b s = -1 := by
  simpa only [symmDiff_self, Finset.bot_eq_empty, basis_empty] using
    basis_mul_basis_eq_or hb hQ s s

/-- **Each signed monomial `e_s` is a unit**, when the generators square to `±1`: its inverse is
`±e_s`. -/
theorem isUnit_basis (hb : (QuadraticMap.associated Q).IsOrthoᵢ b)
    (hQ : ∀ i, Q (b i) = 1 ∨ Q (b i) = -1) (s : Finset I) : IsUnit (basis Q b s) := by
  rcases basis_mul_self_eq_or hb hQ s with h | h
  · exact ⟨⟨_, _, h, h⟩, rfl⟩
  · exact ⟨⟨_, -basis Q b s, by rw [mul_neg, h, neg_neg], by rw [neg_mul, h, neg_neg]⟩, rfl⟩

/-- **The normal form of the group of signed monomials**: for an orthogonal basis whose generators
square to `±1`, a unit lies in `CliffordAlgebra.monomialGroup Q b` exactly when its value is
`e_s` or `-e_s` for a finite index set `s`. -/
theorem mem_monomialGroup_iff (hb : (QuadraticMap.associated Q).IsOrthoᵢ b)
    (hQ : ∀ i, Q (b i) = 1 ∨ Q (b i) = -1) {u : (CliffordAlgebra Q)ˣ} :
    u ∈ monomialGroup Q b ↔
      ∃ s, (u : CliffordAlgebra Q) = basis Q b s ∨ (u : CliffordAlgebra Q) = -basis Q b s := by
  constructor
  · -- The signed monomials contain the generators and are closed under products and inverses.
    intro hu
    induction hu using Subgroup.closure_induction with
    | mem u hu =>
      rcases hu with hu | ⟨i, hu⟩
      · exact ⟨∅, Or.inr (by rw [hu, basis_empty])⟩
      · exact ⟨{i}, Or.inl (by rw [hu, basis_singleton])⟩
    | one => exact ⟨∅, Or.inl (by rw [Units.val_one, basis_empty])⟩
    | mul u v _ _ hu hv =>
      obtain ⟨s, hs⟩ := hu
      obtain ⟨t, ht⟩ := hv
      refine ⟨s ∆ t, ?_⟩
      rw [Units.val_mul]
      rcases basis_mul_basis_eq_or hb hQ s t with h | h <;>
        rcases hs with hs | hs <;> rcases ht with ht | ht <;>
        simp only [hs, ht, neg_mul, mul_neg, neg_neg, h, true_or, or_true]
    | inv u _ hu =>
      obtain ⟨s, hs⟩ := hu
      refine ⟨s, ?_⟩
      -- `u * u = ±1`, so `u⁻¹ = ±u`.
      have huu : (u : CliffordAlgebra Q) * u = 1 ∨ (u : CliffordAlgebra Q) * u = -1 := by
        rcases hs with hs | hs <;> simpa only [hs, neg_mul_neg] using basis_mul_self_eq_or hb hQ s
      rcases huu with h | h
      · rw [Units.inv_eq_of_mul_eq_one_right h]
        exact hs
      · rw [Units.inv_eq_of_mul_eq_one_right (show (u : CliffordAlgebra Q) * -u = 1 by
          rw [mul_neg, h, neg_neg])]
        rcases hs with hs | hs <;> rw [hs] <;> simp
  · -- Peel off the generators one at a time, starting from the least index.
    rintro ⟨s, hs⟩
    induction s using Finset.induction_on_min generalizing u with
    | empty =>
      rw [basis_empty] at hs
      rcases hs with hs | hs
      · rw [Units.val_eq_one.mp hs]
        exact one_mem _
      · exact Subgroup.subset_closure (Or.inl hs)
    | insert a s ha ih =>
      -- The generator of `a` squares to `Q (b a) = ±1`, so it is a unit.
      have hsq : Q (b a) * Q (b a) = 1 := by rcases hQ a with h | h <;> rw [h] <;> norm_num
      let : Invertible (Q (b a)) := ⟨Q (b a), hsq, hsq⟩
      let := invertibleιOfInvertible Q (b a)
      let g : (CliffordAlgebra Q)ˣ :=
        ⟨ι Q (b a), ⅟(ι Q (b a)), mul_invOf_self _, invOf_mul_self _⟩
      have hg : g ∈ monomialGroup Q b := mem_monomialGroup_of_val_eq_ι b rfl
      have hgu : g⁻¹ * u ∈ monomialGroup Q b := by
        refine ih ?_
        rw [basis_insert_of_forall_lt hb ha] at hs
        simp only [g, Units.inv_mk, Units.val_mul]
        rcases hs with hs | hs
        · exact Or.inl (by rw [hs, invOf_mul_cancel_left])
        · exact Or.inr (by rw [hs, mul_neg, invOf_mul_cancel_left])
      simpa using mul_mem hg hgu

/-- **The order of the group of signed monomials**: for an orthogonal basis of a nontrivial ring,
indexed by a type with `n` elements and whose generators square to `±1`, the group has `2 ^ (n + 1)`
elements, the `±e_s` for the `2 ^ n` index sets `s`. -/
theorem natCard_monomialGroup [Fintype I] [Nontrivial R]
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b) (hQ : ∀ i, Q (b i) = 1 ∨ Q (b i) = -1) :
    Nat.card (monomialGroup Q b) = 2 ^ (Fintype.card I + 1) := by
  -- Parametrize the values of the group by a sign and an index set.
  let f : ℤˣ × Finset I → CliffordAlgebra Q := fun p ↦ ((p.1 : ℤ) : R) • basis Q b p.2
  have hsign (ε : ℤˣ) : ((ε : ℤ) : R) = 1 ∨ ((ε : ℤ) : R) = -1 := by
    rcases Int.units_eq_one_or ε with rfl | rfl <;> simp
  -- The parametrization is injective: the basis vectors are independent and `1 ≠ -1`.
  have hf : Function.Injective f := by
    rintro ⟨ε, s⟩ ⟨ε', t⟩ h
    have h2 : (2 : R) ≠ 0 := Invertible.ne_zero 2
    have h' := congrArg (basis Q b).repr h
    simp only [f, map_smul, Module.Basis.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
      Finsupp.single_eq_single_iff] at h'
    rcases h' with ⟨rfl, hε⟩ | ⟨h0, -⟩
    · refine Prod.ext ?_ rfl
      rcases Int.units_eq_one_or ε with rfl | rfl <;> rcases Int.units_eq_one_or ε' with rfl | rfl
      all_goals first
        | rfl
        | (exfalso; apply h2; simp only [Units.val_one, Units.val_neg, Int.cast_one, Int.cast_neg]
            at hε; first | linear_combination hε | linear_combination -hε)
    · rcases hsign ε with h | h <;> rw [h] at h0 <;> simp at h0
  -- Its image is the set of values of the group, by the normal form.
  have hrange : Units.val '' (monomialGroup Q b : Set (CliffordAlgebra Q)ˣ) = Set.range f := by
    ext x
    simp only [Set.mem_image, SetLike.mem_coe, Set.mem_range, Prod.exists]
    constructor
    · rintro ⟨u, hu, rfl⟩
      obtain ⟨s, hs | hs⟩ := (mem_monomialGroup_iff hb hQ).mp hu
      · exact ⟨1, s, by simp [f, hs]⟩
      · exact ⟨-1, s, by simp [f, hs]⟩
    · rintro ⟨ε, s, rfl⟩
      obtain ⟨u, hu⟩ := isUnit_basis hb hQ s
      rcases hsign ε with h | h
      · exact ⟨u, (mem_monomialGroup_iff hb hQ).mpr ⟨s, Or.inl hu⟩, by simp [f, h, hu]⟩
      · exact ⟨-u, (mem_monomialGroup_iff hb hQ).mpr ⟨s, Or.inr (by simp [hu])⟩,
          by simp [f, h, hu]⟩
  rw [← SetLike.coe_sort_coe, ← Nat.card_image_of_injective Units.val_injective, hrange,
    Nat.card_range_of_injective hf, Nat.card_prod, Nat.card_eq_fintype_card,
    Nat.card_eq_fintype_card, Fintype.card_units_int, Fintype.card_finset, pow_succ, mul_comm]

end CliffordAlgebra
