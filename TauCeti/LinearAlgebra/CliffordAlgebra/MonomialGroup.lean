/-!
# The finite group of signed monomials of a Clifford algebra

Let `b` be an orthogonal basis of a quadratic module `(M, Q)` whose generators square to `±1`, that
is `Q (b i) = 1` or `Q (b i) = -1` for every index `i`; over `ℂ` this is a normalized orthogonal
basis `e_i² = 1` of `ℂⁿ`. The subgroup `CliffordAlgebra.monomialGroup Q b` of the units of
`CliffordAlgebra Q` generated by `-1` and the generators `ι Q (b i)` is the group

`G = {±e_s : s a finite set of indices}`,

where `e_s = ι Q (b i₁) * ⋯ * ι Q (b iₖ)` for `s = {i₁ < ⋯ < iₖ}` is the basis vector
`CliffordAlgebra.basis Q b s`. Its multiplication is the sign rule
`CliffordAlgebra.basis_mul_basis`: `e_s * e_t = ±e_{s ∆ t}`. Its element `ε = -1` is central.
When the ring is nontrivial, `2` is invertible, and the finite index type has `n` elements,
the group is finite of order `2 ^ (n + 1)`.

For a finite index type the group is a finite model of the Clifford algebra: the `e_s` form a basis
of `CliffordAlgebra Q` and multiply as the elements of `G` do, so its group algebra modulo `ε + 1`
is the Clifford algebra. That comparison is not made in this file.

## Main definitions

* `CliffordAlgebra.monomialGroup Q v`: the subgroup of `(CliffordAlgebra Q)ˣ` generated by `-1`
  and the units whose value is a generator `ι Q (v i)`, for any family `v` of vectors.

## Main results

* `CliffordAlgebra.mem_monomialGroup_iff`: **the normal form**: a unit lies in the group exactly
  when its value is `e_s` or `-e_s` for some finite index set `s`.
* `CliffordAlgebra.neg_one_mem_center_monomialGroup`: `ε = -1` is central.
* `CliffordAlgebra.natCard_monomialGroup`: **the order** is `2 ^ (n + 1)` over a nontrivial
  ring in which `2` is invertible.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I, §1.
-/

public section

open scoped symmDiff

namespace CliffordAlgebra

variable {R M I : Type*} [CommRing R] [AddCommGroup M] [Module R M] (Q : QuadraticForm R M)

/-- The **group of signed monomials** of a family `v` of vectors: the subgroup of the units of
`CliffordAlgebra Q` generated by `-1` and the units whose value is a generator `ι Q (v i)`.

For a finite orthogonal basis whose generators square to `±1` it is the finite group of the `±e_s`
(`CliffordAlgebra.mem_monomialGroup_iff`). -/
def monomialGroup (v : I → M) : Subgroup (CliffordAlgebra Q)ˣ :=
  Subgroup.closure {u | (u : CliffordAlgebra Q) = -1 ∨ ∃ i, (u : CliffordAlgebra Q) = ι Q (v i)}

variable {Q} (v : I → M)

/-- The defining generators of the group of signed monomials. -/
theorem monomialGroup_def :
    monomialGroup Q v = Subgroup.closure {u : (CliffordAlgebra Q)ˣ |
      (u : CliffordAlgebra Q) = -1 ∨ ∃ i, (u : CliffordAlgebra Q) = ι Q (v i)} :=
  (rfl)

/-- The element `ε = -1` lies in the group of signed monomials. -/
theorem neg_one_mem_monomialGroup : -1 ∈ monomialGroup Q v :=
  Subgroup.subset_closure (Or.inl (by simp))

/-- A unit whose value is a generator `ι Q (v i)` lies in the group of signed monomials. -/
theorem mem_monomialGroup_of_val_eq_ι {u : (CliffordAlgebra Q)ˣ} {i : I}
    (h : (u : CliffordAlgebra Q) = ι Q (v i)) : u ∈ monomialGroup Q v :=
  Subgroup.subset_closure (Or.inr ⟨i, h⟩)

/-- **The element `ε = -1` is central** in the group of signed monomials. -/
theorem neg_one_mem_center_monomialGroup :
    (⟨-1, neg_one_mem_monomialGroup v⟩ : monomialGroup Q v) ∈ Subgroup.center (monomialGroup Q v) :=
  Subgroup.mem_center_iff.mpr fun _ ↦ Subtype.ext (Units.ext (by simp))

variable [Invertible (2 : R)] [LinearOrder I] {b : Module.Basis I R M}

/-- **The normal form of the group of signed monomials**: for an orthogonal basis whose generators
square to `±1`, a unit lies in `CliffordAlgebra.monomialGroup Q b` exactly when its value is
`e_s` or `-e_s` for a finite index set `s`. -/
theorem mem_monomialGroup_iff (hb : (QuadraticMap.associated Q).IsOrthoᵢ b)
    (hQ : ∀ i, Q (b i) = 1 ∨ Q (b i) = -1) {u : (CliffordAlgebra Q)ˣ} :
    u ∈ monomialGroup Q b ↔
      ∃ s, (u : CliffordAlgebra Q) = basis Q b s ∨ (u : CliffordAlgebra Q) = -basis Q b s := by
  constructor
  · -- The signed monomials contain the generators and are closed under products and inverses.
    intro hu
    induction hu using Subgroup.closure_induction with
    | mem u hu =>
      rcases hu with hu | ⟨i, hu⟩
      · exact ⟨∅, Or.inr (by rw [hu, basis_empty])⟩
      · exact ⟨{i}, Or.inl (by rw [hu, basis_singleton])⟩
    | one => exact ⟨∅, Or.inl (by rw [Units.val_one, basis_empty])⟩
    | mul u v _ _ hu hv =>
      obtain ⟨s, hs⟩ := hu
      obtain ⟨t, ht⟩ := hv
      refine ⟨s ∆ t, ?_⟩
      rw [Units.val_mul]
      rcases basis_mul_basis_eq_or hb hQ s t with h | h <;>
        rcases hs with hs | hs <;> rcases ht with ht | ht <;>
        simp only [hs, ht, neg_mul, mul_neg, neg_neg, h, true_or, or_true]
    | inv u _ hu =>
      obtain ⟨s, hs⟩ := hu
      refine ⟨s, ?_⟩
      -- `u * u = ±1`, so `u⁻¹ = ±u`.
      have huu : (u : CliffordAlgebra Q) * u = 1 ∨ (u : CliffordAlgebra Q) * u = -1 := by
        rcases hs with hs | hs <;> simpa only [hs, neg_mul_neg] using basis_mul_self_eq_or hb hQ s
      rcases huu with h | h
      · rw [Units.inv_eq_of_mul_eq_one_right h]
        exact hs
      · have hneg : (u : CliffordAlgebra Q) * -u = 1 := by rw [mul_neg, h, neg_neg]
        rw [Units.inv_eq_of_mul_eq_one_right hneg]
        rcases hs with hs | hs <;> rw [hs] <;> simp
  · -- Peel off the generators one at a time, starting from the least index.
    rintro ⟨s, hs⟩
    induction s using Finset.induction_on_min generalizing u with
    | empty =>
      rw [basis_empty] at hs
      rcases hs with hs | hs
      · rw [Units.val_eq_one.mp hs]
        exact one_mem _
      · exact Subgroup.subset_closure (Or.inl hs)
    | insert a s ha ih =>
      -- The generator of `a` squares to `Q (b a) = ±1`, so it is a unit.
      have hsq : Q (b a) * Q (b a) = 1 := by rcases hQ a with h | h <;> rw [h] <;> norm_num
      let : Invertible (Q (b a)) := ⟨Q (b a), hsq, hsq⟩
      let := invertibleιOfInvertible Q (b a)
      let g := unitOfInvertible (ι Q (b a))
      have hg : g ∈ monomialGroup Q b := mem_monomialGroup_of_val_eq_ι b rfl
      have hgu : g⁻¹ * u ∈ monomialGroup Q b := by
        refine ih ?_
        rw [basis_insert_of_forall_lt hb ha] at hs
        -- Mathlib's `unitOfInvertible` has value `ι Q (b a)` and inverse `⅟(ι Q (b a))`.
        simp only [g, unitOfInvertible, Units.inv_mk, Units.val_mul]
        rcases hs with hs | hs
        · exact Or.inl (by rw [hs, invOf_mul_cancel_left])
        · exact Or.inr (by rw [hs, mul_neg, invOf_mul_cancel_left])
      simpa using mul_mem hg hgu

/-- **The order of the group of signed monomials**: for an orthogonal basis over a nontrivial ring
in which `2` is invertible, indexed by a type with `n` elements and whose generators square to `±1`,
the group has `2 ^ (n + 1)` elements, the `±e_s` for the `2 ^ n` index sets `s`. -/
theorem natCard_monomialGroup [Fintype I] [Nontrivial R]
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b) (hQ : ∀ i, Q (b i) = 1 ∨ Q (b i) = -1) :
    Nat.card (monomialGroup Q b) = 2 ^ (Fintype.card I + 1) := by
  -- Parametrize the values of the group by a sign and an index set.
  let f : ℤˣ × Finset I → CliffordAlgebra Q := fun p ↦ ((p.1 : ℤ) : R) • basis Q b p.2
  have hsign (ε : ℤˣ) : ((ε : ℤ) : R) = 1 ∨ ((ε : ℤ) : R) = -1 := by
    rcases Int.units_eq_one_or ε with rfl | rfl <;> simp
  have hne : (1 : R) ≠ -1 := by
    intro h
    have h2 : (2 : R) = 0 := by linear_combination h
    exact Invertible.ne_zero 2 h2
  -- The parametrization is injective: the basis vectors are independent and `1 ≠ -1`.
  have hf : Function.Injective f := by
    rintro ⟨ε, s⟩ ⟨ε', t⟩ h
    have h' := congrArg (basis Q b).repr h
    simp only [f, map_smul, Module.Basis.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
      Finsupp.single_eq_single_iff] at h'
    rcases h' with ⟨rfl, hε⟩ | ⟨h0, -⟩
    · refine Prod.ext ?_ rfl
      rcases Int.units_eq_one_or ε with rfl | rfl <;> rcases Int.units_eq_one_or ε' with rfl | rfl
      · rfl
      · exact (hne (by simpa using hε)).elim
      · exact (hne (by simpa using hε.symm)).elim
      · rfl
    · rcases hsign ε with h | h <;> rw [h] at h0 <;> simp at h0
  -- Its image is the set of values of the group, by the normal form.
  have hrange : Units.val '' (monomialGroup Q b : Set (CliffordAlgebra Q)ˣ) = Set.range f := by
    ext x
    simp only [Set.mem_image, SetLike.mem_coe, Set.mem_range, Prod.exists]
    constructor
    · rintro ⟨u, hu, rfl⟩
      obtain ⟨s, hs | hs⟩ := (mem_monomialGroup_iff hb hQ).mp hu
      · exact ⟨1, s, by simp [f, hs]⟩
      · exact ⟨-1, s, by simp [f, hs]⟩
    · rintro ⟨ε, s, rfl⟩
      have hunit : ∀ i ∈ s, IsUnit (Q (b i)) := by
        intro i _
        rcases hQ i with hi | hi <;> rw [hi] <;> simp
      obtain ⟨u, hu⟩ := isUnit_basis hb s hunit
      rcases hsign ε with h | h
      · exact ⟨u, (mem_monomialGroup_iff hb hQ).mpr ⟨s, Or.inl hu⟩, by simp [f, h, hu]⟩
      · exact ⟨-u, (mem_monomialGroup_iff hb hQ).mpr ⟨s, Or.inr (by simp [hu])⟩,
          by simp [f, h, hu]⟩
  have hcard : Nat.card (monomialGroup Q b) = Nat.card (ℤˣ × Finset I) := by
    rw [← SetLike.coe_sort_coe, ← Nat.card_image_of_injective Units.val_injective, hrange,
      Nat.card_range_of_injective hf]
  rw [hcard]
  simp only [Nat.card_eq_fintype_card, Fintype.card_prod, Fintype.card_units_int,
    Fintype.card_finset, pow_succ, mul_comm]


/-- A signed basis monomial is central in the finite monomial subgroup exactly when its support is
empty, or when it is the full index set of odd cardinality. The proof uses the generator crossing
signs, so the result applies to any nontrivial commutative coefficient ring with `2` invertible. -/
theorem mem_center_monomialGroup_iff [Fintype I] [Nontrivial R]
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b)
    (hQ : ∀ i, Q (b i) = 1 ∨ Q (b i) = -1)
    {u : monomialGroup Q b} :
    u ∈ Subgroup.center (monomialGroup Q b) ↔
      ∃ s : Finset I,
        ((↑(u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) = basis Q b s ∨
          (↑(u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) = -basis Q b s) ∧
        (s = ∅ ∨ (s = Finset.univ ∧ Odd s.card)) := by
  have basis_comm_iff (s : Finset I) :
      (∀ i : I, basis Q b s * ι Q (b i) = ι Q (b i) * basis Q b s) ↔
        s = ∅ ∨ (s = Finset.univ ∧ Odd s.card) := by
    constructor
    · intro hs
      by_cases hempty : s = ∅
      · exact Or.inl hempty
      · right
        have hsodd : Odd s.card := by
          obtain ⟨i, hi⟩ := Finset.nonempty_iff_ne_empty.mpr hempty
          have h := hs i
          rw [basis_mul_ι_of_mem hb hi] at h
          have hunit : IsUnit (ι Q (b i) * basis Q b s) :=
            (isUnit_ι_of_isUnit Q (by rcases hQ i with hi | hi <;> simp [hi])).mul
              (isUnit_basis hb s (fun j hj => by
                rcases hQ j with hj' | hj' <;> rw [hj'] <;> simp))
          have hscalar : (-1 : R) ^ (s.card - 1) = 1 := by
            have hmul : algebraMap R (CliffordAlgebra Q) ((-1 : R) ^ (s.card - 1)) *
                (ι Q (b i) * basis Q b s) = algebraMap R (CliffordAlgebra Q) 1 *
                  (ι Q (b i) * basis Q b s) := by
              simpa [Algebra.smul_def] using h
            apply algebraMap_injective Q
            simpa using hunit.mul_right_cancel hmul
          have hneg : (-1 : R) ≠ 1 := by
            intro hneg
            apply Invertible.ne_zero (2 : R)
            calc
              (2 : R) = 1 - (-1) := by ring
              _ = 0 := by rw [hneg]; simp
          have heven : Even (s.card - 1) :=
            (neg_one_pow_eq_one_iff_even hneg).mp hscalar
          have hpos : 1 ≤ s.card := by
            exact Nat.one_le_iff_ne_zero.mpr (by
              intro hzero
              exact hempty (Finset.card_eq_zero.mp hzero))
          have hodd' := heven.add_one
          simpa [Nat.sub_add_cancel hpos] using hodd'
        have heq : s = Finset.univ := by
          apply Finset.eq_univ_of_forall
          intro i
          by_contra hi
          have heven : Even s.card := by
            have h := hs i
            rw [basis_mul_ι_of_notMem hb hi] at h
            have hunit : IsUnit (ι Q (b i) * basis Q b s) :=
              (isUnit_ι_of_isUnit Q (by rcases hQ i with hi | hi <;> simp [hi])).mul
                (isUnit_basis hb s (fun j hj => by
                  rcases hQ j with hj' | hj' <;> rw [hj'] <;> simp))
            have hscalar : (-1 : R) ^ s.card = 1 := by
              have hmul : algebraMap R (CliffordAlgebra Q) ((-1 : R) ^ s.card) *
                  (ι Q (b i) * basis Q b s) = algebraMap R (CliffordAlgebra Q) 1 *
                    (ι Q (b i) * basis Q b s) := by
                simpa [Algebra.smul_def] using h
              apply algebraMap_injective Q
              simpa using hunit.mul_right_cancel hmul
            have hneg : (-1 : R) ≠ 1 := by
              intro hneg
              apply Invertible.ne_zero (2 : R)
              calc
                (2 : R) = 1 - (-1) := by ring
                _ = 0 := by rw [hneg]; simp
            exact (neg_one_pow_eq_one_iff_even hneg).mp hscalar
          exact (Nat.not_even_iff_odd.mpr hsodd) heven
        exact ⟨heq, hsodd⟩
    · rintro (rfl | ⟨rfl, hsodd⟩) i
      · rw [basis_empty, one_mul, mul_one]
      · obtain ⟨k, hk⟩ := hsodd
        have heven : Even ((Finset.univ : Finset I).card - 1) := by
          refine ⟨k, ?_⟩
          simp [hk, two_mul]
        rw [basis_mul_ι_of_mem hb (by simp), heven.neg_one_pow]
        simp
  have central_comm_of_value (hu : u ∈ Subgroup.center (monomialGroup Q b))
      (s : Finset I) (hs : (↑(u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) = basis Q b s ∨
        (↑(u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) = -basis Q b s) :
      ∀ i : I, basis Q b s * ι Q (b i) = ι Q (b i) * basis Q b s := by
    intro i
    let hsq : Q (b i) * Q (b i) = 1 := by
      rcases hQ i with hi | hi <;> rw [hi] <;> norm_num
    let : Invertible (Q (b i)) := ⟨Q (b i), hsq, hsq⟩
    let := invertibleιOfInvertible Q (b i)
    let g := unitOfInvertible (ι Q (b i))
    have hg : g ∈ monomialGroup Q b := mem_monomialGroup_of_val_eq_ι b rfl
    have hc := Subgroup.mem_center_iff.mp hu
      (⟨g, hg⟩ : monomialGroup Q b)
    have hc' : (u : (CliffordAlgebra Q)ˣ) * g = g * (u : (CliffordAlgebra Q)ˣ) := by
      simpa using congrArg Subtype.val hc.symm
    have hc'' := congrArg Units.val hc'
    rcases hs with hs | hs
    · simpa [g, hs] using hc''
    · simpa [g, hs] using hc''
  constructor
  · intro hu
    obtain ⟨s, hs | hs⟩ := (mem_monomialGroup_iff (b := b) hb hQ).mp u.property
    · refine ⟨s, Or.inl hs, (basis_comm_iff s).mp ?_⟩
      exact central_comm_of_value hu s (Or.inl hs)
    · refine ⟨s, Or.inr hs, (basis_comm_iff s).mp ?_⟩
      exact central_comm_of_value hu s (Or.inr hs)
  · rintro ⟨s, hs, hpar⟩
    rw [Subgroup.mem_center_iff]
    let uval : CliffordAlgebra Q := ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q)
    have hcomm : ∀ x : (CliffordAlgebra Q)ˣ, x ∈ monomialGroup Q b →
        (x : CliffordAlgebra Q) * uval = uval * (x : CliffordAlgebra Q) := by
      intro x hx
      induction hx using Subgroup.closure_induction with
      | mem x hx =>
          rcases hx with hx | ⟨i, hxi⟩
          · simp [uval, hx]
          · let hsq : Q (b i) * Q (b i) = 1 := by
              rcases hQ i with hi | hi <;> rw [hi] <;> norm_num
            let : Invertible (Q (b i)) := ⟨Q (b i), hsq, hsq⟩
            let := invertibleιOfInvertible Q (b i)
            let gen := unitOfInvertible (ι Q (b i))
            have hscomm := (basis_comm_iff s).mpr hpar i
            rcases hs with hs | hs
            · simpa [uval, gen, hs, hxi] using hscomm.symm
            · simpa [uval, gen, hs, hxi] using hscomm.symm
      | one => simp [uval]
      | mul x y _ _ hx hy =>
          calc
            (x * y : (CliffordAlgebra Q)ˣ) * uval =
                (x : CliffordAlgebra Q) * ((y : CliffordAlgebra Q) * uval) := by simp [mul_assoc]
            _ = (x : CliffordAlgebra Q) * (uval * (y : CliffordAlgebra Q)) := by rw [hy]
            _ = ((x : CliffordAlgebra Q) * uval) * (y : CliffordAlgebra Q) := by rw [mul_assoc]
            _ = (uval * (x : CliffordAlgebra Q)) * (y : CliffordAlgebra Q) := by rw [hx]
            _ = uval * ((x : CliffordAlgebra Q) * (y : CliffordAlgebra Q)) := by rw [mul_assoc]
      | inv x _ hx =>
          have hunit : x * (u : (CliffordAlgebra Q)ˣ) = (u : (CliffordAlgebra Q)ˣ) * x :=
            Units.ext hx
          have hinv : x⁻¹ * (u : (CliffordAlgebra Q)ˣ) =
              (u : (CliffordAlgebra Q)ˣ) * x⁻¹ := by
            simpa [mul_assoc] using
              (congrArg (fun z : (CliffordAlgebra Q)ˣ => x⁻¹ * z * x⁻¹) hunit).symm
          simpa [uval] using congrArg Units.val hinv
    intro g
    exact Subtype.ext (Units.ext (hcomm (g : (CliffordAlgebra Q)ˣ) g.property))

end CliffordAlgebra
