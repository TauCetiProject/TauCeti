module

public import TauCeti.LinearAlgebra.CliffordAlgebra.Pin.Action
import TauCeti.LinearAlgebra.CliffordAlgebra.Basic

/-!
# The Lipschitz group as the products of vectors

Mathlib defines `lipschitzGroup Q` as the subgroup of `(CliffordAlgebra Q)ˣ` *generated* by the
invertible vectors. This file describes that closure concretely. The inverse of a vector of
invertible norm `v` is the vector `⅟(Q v) • v`, so the generating set is closed under inversion
and no inverses are needed: the Lipschitz group is exactly the set of products of vectors of
invertible norm. The scalar units are the products `ι (a • v) * (ι v)⁻¹`, so they lie in the
Lipschitz group as soon as some vector has invertible norm.

## Main results

* `CliffordAlgebra.coe_unitι_inv`: the inverse of a vector is a vector.
* `CliffordAlgebra.mem_lipschitzGroup_iff_exists_list`: a unit lies in the Lipschitz group exactly
  when it is a product of vectors of invertible norm.
* `CliffordAlgebra.lipschitzGroup_eq_bot`: the Lipschitz group of the zero module is trivial.
* `CliffordAlgebra.scalarUnits`: the scalar units, as a homomorphism into the Lipschitz group,
  whenever some vector has invertible norm.
* `CliffordAlgebra.scalarUnits_injective`: when `2` is invertible, the scalar units embed.

## References

See C. Chevalley, *The Algebraic Theory of Spinors* (1954), Chapter II, and H. B. Lawson and
M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I §2.
-/

public section

universe u v

namespace CliffordAlgebra

variable {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
  {Q : QuadraticForm R M}

/-! ### Inverses of vectors -/

/-- The inverse of a vector of invertible norm `v` is the vector `⅟(Q v) • v`. -/
@[simp]
theorem coe_unitι_inv (v : M) [Invertible (Q v)] :
    (((unitι Q v)⁻¹ : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) = ι Q (⅟(Q v) • v) := by
  let _ := invertibleιOfInvertible Q v
  rw [← invOf_ι Q v]
  exact Units.inv_eq_of_mul_eq_one_left (by rw [coe_unitι, invOf_mul_self])

/-- The product of the vectors of a list, taken in reverse order after replacing each vector by
its inverse, is a left inverse of the product of the list. -/
private theorem prod_reverse_map_inverse_mul_prod_map_ι (l : List M)
    (hl : ∀ v ∈ l, IsUnit (Q v)) :
    ((l.map fun v ↦ Ring.inverse (Q v) • v).reverse.map (ι Q)).prod * (l.map (ι Q)).prod = 1 := by
  induction l with
  | nil => simp
  | cons a l ih =>
    have ha : ι Q (Ring.inverse (Q a) • a) * ι Q a = 1 := by
      rw [map_smul, smul_mul_assoc, ι_sq_scalar, Algebra.smul_def, ← map_mul,
        Ring.inverse_mul_cancel _ (hl a List.mem_cons_self), map_one]
    simp only [List.map_cons, List.reverse_cons, List.map_append, List.prod_append,
      List.prod_cons, List.map_nil, List.prod_nil, mul_one]
    rw [mul_assoc, ← mul_assoc _ (ι Q a), ha, one_mul,
      ih fun v hv ↦ hl v (List.mem_cons_of_mem a hv)]

/-! ### The Lipschitz group as the products of vectors -/

/-- A unit that is a product of vectors of invertible norm lies in the Lipschitz group. -/
theorem mem_lipschitzGroup_of_coe_eq_prod_map_ι {x : (CliffordAlgebra Q)ˣ} (l : List M)
    (hl : ∀ v ∈ l, IsUnit (Q v)) (hx : (x : CliffordAlgebra Q) = (l.map (ι Q)).prod) :
    x ∈ lipschitzGroup Q := by
  induction l generalizing x with
  | nil =>
    obtain rfl : x = 1 := Units.ext (by simpa using hx)
    exact one_mem _
  | cons a l ih =>
    let _ := (hl a List.mem_cons_self).invertible
    have hy := ih (x := (unitι Q a)⁻¹ * x) (fun v hv ↦ hl v (List.mem_cons_of_mem a hv)) (by
      rw [Units.val_mul, hx, List.map_cons, List.prod_cons, ← mul_assoc, ← coe_unitι a,
        Units.inv_mul, one_mul])
    have hx' : x = unitι Q a * ((unitι Q a)⁻¹ * x) := (mul_inv_cancel_left _ _).symm
    rw [hx']
    exact mul_mem (unitι_mem_lipschitzGroup a) hy

/-- **The Lipschitz group is the set of products of vectors of invertible norm.** Mathlib defines
it as the subgroup generated by the invertible vectors; since the inverse of such a vector is again
a vector (`coe_unitι_inv`), products suffice and no inverses are needed. -/
theorem mem_lipschitzGroup_iff_exists_list [Invertible (2 : R)] {x : (CliffordAlgebra Q)ˣ} :
    x ∈ lipschitzGroup Q ↔
      ∃ l : List M, (∀ v ∈ l, IsUnit (Q v)) ∧ (x : CliffordAlgebra Q) = (l.map (ι Q)).prod := by
  refine ⟨fun hx ↦ ?_, fun ⟨l, hl, hx⟩ ↦ mem_lipschitzGroup_of_coe_eq_prod_map_ι l hl hx⟩
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨m, hm⟩ := hx
    refine ⟨[m], ?_, by simp [hm]⟩
    simp only [List.mem_singleton, forall_eq]
    exact isUnit_of_isUnit_ι Q (hm ▸ x.isUnit)
  | one => exact ⟨[], by simp, by simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨l₁, hl₁, hx⟩ := hx
    obtain ⟨l₂, hl₂, hy⟩ := hy
    refine ⟨l₁ ++ l₂, fun v hv ↦ ?_, by rw [Units.val_mul, hx, hy, List.map_append,
      List.prod_append]⟩
    rcases List.mem_append.mp hv with hv | hv
    exacts [hl₁ v hv, hl₂ v hv]
  | inv x _ hx =>
    obtain ⟨l, hl, hx⟩ := hx
    refine ⟨(l.map fun v ↦ Ring.inverse (Q v) • v).reverse, fun w hw ↦ ?_, ?_⟩
    · obtain ⟨v, hv, rfl⟩ := List.mem_map.mp (List.mem_reverse.mp hw)
      rw [QuadraticMap.map_smul]
      exact ((hl v hv).ringInverse.mul (hl v hv).ringInverse).mul (hl v hv)
    · refine Units.inv_eq_of_mul_eq_one_left ?_
      rw [hx, prod_reverse_map_inverse_mul_prod_map_ι l hl]

/-- The Lipschitz group of a quadratic form on the zero module is trivial: its only vector is `0`,
which is not a unit unless the Clifford algebra is itself trivial. -/
theorem lipschitzGroup_eq_bot [Subsingleton M] : lipschitzGroup Q = ⊥ := by
  rw [lipschitzGroup, Subgroup.closure_eq_bot_iff]
  rintro x ⟨m, hm⟩
  rw [Subsingleton.elim m 0, map_zero] at hm
  have : Subsingleton (CliffordAlgebra Q) := subsingleton_of_zero_eq_one (by
    rw [← x.mul_inv, ← hm, zero_mul])
  exact Subsingleton.elim x 1

/-! ### The scalar units -/

/-- If some vector has invertible norm, every scalar unit lies in the Lipschitz group: it is the
product `ι (a • v) * (ι v)⁻¹` of two generators. -/
theorem units_map_algebraMap_mem_lipschitzGroup (hQ : ∃ v, IsUnit (Q v)) (a : Rˣ) :
    Units.map (algebraMap R (CliffordAlgebra Q)) a ∈ lipschitzGroup Q := by
  obtain ⟨v, hv⟩ := hQ
  let _ := hv.invertible
  have hav : IsUnit (Q ((a : R) • v)) := by
    rw [QuadraticMap.map_smul]
    exact (a.isUnit.mul a.isUnit).mul hv
  let _ := hav.invertible
  have hscale : unitι Q ((a : R) • v) =
      Units.map (algebraMap R (CliffordAlgebra Q)) a * unitι Q v := by
    ext
    simp [Algebra.smul_def]
  rw [← mul_inv_eq_iff_eq_mul.mpr hscale]
  exact mul_mem (unitι_mem_lipschitzGroup _) (inv_mem (unitι_mem_lipschitzGroup _))

variable (Q) in
/-- The scalar units of the Clifford algebra, as a homomorphism into the Lipschitz group. It
exists as soon as some vector has invertible norm (`units_map_algebraMap_mem_lipschitzGroup`); for
the zero module the Lipschitz group is trivial (`lipschitzGroup_eq_bot`), so no scalar unit other
than `1` can lie in it. -/
noncomputable def scalarUnits (hQ : ∃ v, IsUnit (Q v)) : Rˣ →* lipschitzGroup Q :=
  (Units.map (algebraMap R (CliffordAlgebra Q)).toMonoidHom).codRestrict _
    (units_map_algebraMap_mem_lipschitzGroup hQ)

/-- The scalar unit `a` is the Clifford element `algebraMap R _ a`. -/
@[simp]
theorem coe_scalarUnits (hQ : ∃ v, IsUnit (Q v)) (a : Rˣ) :
    ((scalarUnits Q hQ a : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) =
      algebraMap R (CliffordAlgebra Q) a :=
  (rfl)

/-- The scalar units embed into the Lipschitz group. -/
theorem scalarUnits_injective [Invertible (2 : R)] (hQ : ∃ v, IsUnit (Q v)) :
    Function.Injective (scalarUnits Q hQ) := fun a b hab ↦
  Units.ext (algebraMap_injective Q (by
    simpa using congrArg (fun x : lipschitzGroup Q ↦ ((x : (CliffordAlgebra Q)ˣ) :
      CliffordAlgebra Q)) hab))

end CliffordAlgebra
