/-!
# The normalized Clifford full cover

For a quadratic form, the reverse Clifford norm is a unit-valued homomorphism on the
Lipschitz group.  Its inverse image of the subgroup generated by `-1` is the normalized full
Clifford cover: its elements have reverse norm `1` or `-1`.  This carrier contains the Spin group
at norm `1` and acts on the quadratic space through the existing Lipschitz action.

Rescaling a Lipschitz element by a scalar unit `a` multiplies its norm by `a ^ 2` and does not
change its action. So a Lipschitz element rescales into the full cover exactly when its norm or the
negative of its norm is a square. Over a field in which every element is a square up to sign, such
as `ℝ` or any real closed field (`IsRealClosed.isSquare_or_isSquare_neg`), this always happens.
Since the Lipschitz action of a finite-dimensional nondegenerate quadratic space is onto the
orthogonal group (Cartan--Dieudonné), so is the full-cover action. An element acting trivially is
a scalar `r` with `r ^ 2 = ±1`; when `-1` is not a square, as over `ℝ`, this forces `r = ±1`, so
the kernel of the full-cover action is `{±1}`, the image of the Spin kernel. An element of the full
cover is even exactly when its action has determinant one, so under the same square-up-to-sign
hypothesis the even elements of the full cover cover all of `SO(Q)`. By contrast, the Spin group
consists of the even elements of norm `1` only, and over `ℝ` its image in `SO(Q)` is a proper
subgroup for an indefinite form.

## Main definitions

* `CliffordAlgebra.cliffordFullCover`: the normalized full Clifford cover.
* `CliffordAlgebra.cliffordFullCoverToOrthogonal`: its action on the quadratic space.
* `CliffordAlgebra.spinToCliffordFullCover`: the inclusion of the Spin group.

## Main results

* `CliffordAlgebra.exists_scalarUnits_mul_mem_cliffordFullCover_iff`: a Lipschitz element
  rescales into the full cover exactly when its norm is a square up to sign.
* `CliffordAlgebra.cliffordFullCoverToOrthogonal_surjective`: when every element is a square up to
  sign, the full cover is onto the orthogonal group of a finite-dimensional nondegenerate space.
* `CliffordAlgebra.mem_ker_cliffordFullCoverToOrthogonal_iff` and
  `CliffordAlgebra.ker_cliffordFullCoverToOrthogonal`: when `-1` is not a square, the kernel of
  the full-cover action is `{±1}`, the image of the kernel of the Spin action.
* `CliffordAlgebra.exists_cliffordFullCoverToOrthogonal_eq_and_mem_even_iff`: an orthogonal
  transformation is the action of an even element of the full cover exactly when it lies in
  `SO(Q)`.

## References

H. B. Lawson and M.-L. Michelsohn, *Spin Geometry*, Chapter I, Section 2, with the reverse-norm
convention recorded in `Lipschitz.ReverseNorm`.
-/

public section

noncomputable section

namespace CliffordAlgebra

open TauCeti

universe u v

variable {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
  [Invertible (2 : R)]

/-- The normalized full Clifford cover of a quadratic form.

It is the subgroup of the Lipschitz group on which the reverse Clifford norm is generated by
`-1`; equivalently, its elements have norm `1` or `-1`. -/
def cliffordFullCover (Q : QuadraticForm R M) : Subgroup (lipschitzGroup Q) :=
  (Subgroup.zpowers (-1 : Rˣ)).comap (cliffordNorm Q)

/-- Membership in the normalized full cover is the reverse-norm sign condition. -/
@[simp]
theorem mem_cliffordFullCover_iff (Q : QuadraticForm R M) (x : lipschitzGroup Q) :
    x ∈ cliffordFullCover Q ↔
      cliffordNorm Q x = 1 ∨ cliffordNorm Q x = -1 := by
  rw [cliffordFullCover, Subgroup.mem_comap,
    Subgroup.mem_zpowers_iff_of_sq_eq_one]
  simp

/-- The orthogonal action restricted to the normalized full Clifford cover. -/
def cliffordFullCoverToOrthogonal (Q : QuadraticForm R M) :
    cliffordFullCover Q →* QuadraticMap.orthogonalGroup Q :=
  (lipschitzToOrthogonal Q).comp (cliffordFullCover Q).subtype

/-- The full-cover action is the ambient Lipschitz action on the underlying element. -/
@[simp]
theorem cliffordFullCoverToOrthogonal_apply (Q : QuadraticForm R M)
    (x : cliffordFullCover Q) :
    cliffordFullCoverToOrthogonal Q x =
      lipschitzToOrthogonal Q (x : lipschitzGroup Q) := by
  simp [cliffordFullCoverToOrthogonal]

/-- The Spin group embeds in the normalized full cover through its canonical Lipschitz lift. -/
def spinToCliffordFullCover (Q : QuadraticForm R M) :
    spinGroup Q →* cliffordFullCover Q :=
  (spinToLipschitz Q).codRestrict _ fun x => by
    rw [mem_cliffordFullCover_iff]
    rw [spinToLipschitz_apply]
    exact Or.inl (cliffordNorm_pinToLipschitz_spinToPin x)

/-- The underlying Lipschitz element of the Spin-to-full-cover inclusion. -/
@[simp]
theorem coe_spinToCliffordFullCover_apply (Q : QuadraticForm R M) (x : spinGroup Q) :
    (spinToCliffordFullCover Q x : lipschitzGroup Q) = spinToLipschitz Q x := by
  simp only [spinToCliffordFullCover, MonoidHom.codRestrict_apply]

/-- The Spin-to-full-cover inclusion is injective. -/
theorem spinToCliffordFullCover_injective (Q : QuadraticForm R M) :
    Function.Injective (spinToCliffordFullCover Q) := by
  exact (MonoidHom.injective_codRestrict _ _ _).mpr (spinToLipschitz_injective Q)

/-- The Spin action is the restriction of the full-cover action pointwise. -/
@[simp 1100]
theorem cliffordFullCoverToOrthogonal_spinToCliffordFullCover_apply
    (Q : QuadraticForm R M) (x : spinGroup Q) :
    cliffordFullCoverToOrthogonal Q (spinToCliffordFullCover Q x) =
      spinToOrthogonal Q x := by
  rw [cliffordFullCoverToOrthogonal_apply, coe_spinToCliffordFullCover_apply]
  rw [spinToLipschitz_apply]
  rw [← pinToOrthogonal_eq_lipschitzToOrthogonal, pinToOrthogonal_spinToPin]

/-- The restricted orthogonal action agrees with the usual Spin action on the included subgroup. -/
@[simp]
theorem cliffordFullCoverToOrthogonal_comp_spinToCliffordFullCover
    (Q : QuadraticForm R M) :
    (cliffordFullCoverToOrthogonal Q).comp (spinToCliffordFullCover Q) =
      spinToOrthogonal Q := by
  apply MonoidHom.ext
  intro x
  simpa only [MonoidHom.comp_apply] using
    cliffordFullCoverToOrthogonal_spinToCliffordFullCover_apply Q x

/-! ### Rescaling into the full cover -/

section Rescale

variable {Q : QuadraticForm R M}

/-- **Rescaling a Lipschitz element into the full cover.** A Lipschitz element can be multiplied
by a scalar unit into the normalized full cover exactly when its Clifford norm or the negative of
its Clifford norm is a square. Rescaling by `a` multiplies the norm by `a * a`. -/
theorem exists_scalarUnits_mul_mem_cliffordFullCover_iff (hQ : ∃ v, IsUnit (Q v))
    (x : lipschitzGroup Q) :
    (∃ a : Rˣ, scalarUnits Q hQ a * x ∈ cliffordFullCover Q) ↔
      IsSquare (cliffordNorm Q x) ∨ IsSquare (-cliffordNorm Q x) := by
  simp_rw [mem_cliffordFullCover_iff, map_mul, cliffordNorm_scalarUnits]
  constructor
  · rintro ⟨a, ha | ha⟩
    · exact Or.inl ⟨a⁻¹, by rw [eq_inv_of_mul_eq_one_right ha, mul_inv]⟩
    · refine Or.inr ⟨a⁻¹, ?_⟩
      rw [eq_inv_of_mul_eq_one_right (by rw [mul_neg, ha, neg_neg] : a * a * -cliffordNorm Q x = 1),
        mul_inv]
  · rintro (⟨b, hb⟩ | ⟨b, hb⟩)
    · exact ⟨b⁻¹, Or.inl (by rw [hb]; group)⟩
    · refine ⟨b⁻¹, Or.inr ?_⟩
      rw [← neg_neg (cliffordNorm Q x), hb, mul_neg]
      congr 1
      group

end Rescale

/-! ### The full cover over a field -/

section Field

variable {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  [Invertible (2 : K)] {Q : QuadraticForm K V}

/-- **The full cover is onto the orthogonal group** of a finite-dimensional nondegenerate
quadratic space over a field in which every element is a square up to sign, such as `ℝ` or any
real closed field (`IsRealClosed.isSquare_or_isSquare_neg`). -/
theorem cliffordFullCoverToOrthogonal_surjective (hQ : Q.Nondegenerate)
    (hK : ∀ a : K, IsSquare a ∨ IsSquare (-a)) :
    Function.Surjective (cliffordFullCoverToOrthogonal Q) := by
  intro g
  rcases subsingleton_or_nontrivial V with hV | hV
  · exact ⟨1, Subtype.ext (LinearEquiv.ext fun v ↦ Subsingleton.elim _ _)⟩
  obtain ⟨x, rfl⟩ := lipschitzToOrthogonal_surjective Q hQ g
  obtain ⟨a, ha⟩ :=
    (exists_scalarUnits_mul_mem_cliffordFullCover_iff hQ.exists_isUnit x).2 <|
      (hK (cliffordNorm Q x : K)).imp Units.isSquare_coe_iff.mp
        fun h ↦ Units.isSquare_coe_iff.mp (by rwa [Units.val_neg])
  exact ⟨⟨_, ha⟩, by simp⟩

/-- **The kernel of the full-cover action is `{±1}`** for a positive-dimensional
finite-dimensional nondegenerate quadratic space over a field in which `-1` is not a square. The
element `-1` of the full cover is the image of the Spin element `-1`. -/
theorem mem_ker_cliffordFullCoverToOrthogonal_iff [Nontrivial V] (hQ : Q.Nondegenerate)
    (h : ¬IsSquare (-1 : K)) (x : cliffordFullCover Q) :
    x ∈ (cliffordFullCoverToOrthogonal Q).ker ↔
      x = 1 ∨ x = spinToCliffordFullCover Q (spinGroup.negOne Q hQ.ne_zero) := by
  constructor
  · intro hx
    obtain ⟨r, hr⟩ := (mem_ker_lipschitzToOrthogonal_iff hQ).1 (by simpa using hx)
    have hnorm : cliffordNorm Q x = r * r := by
      simpa only [map_one, mul_one, sq] using
        cliffordNorm_eq_sq_mul_of_coe_eq_algebraMap_mul (x := 1) (c := r) (by simpa using hr)
    have hr1 : (r : K) * r = 1 := by
      rcases (mem_cliffordFullCover_iff Q x).1 x.2 with h1 | h1
      · simpa using congrArg Units.val (hnorm.symm.trans h1)
      · exact absurd ⟨(r : K), by simpa using (congrArg Units.val (hnorm.symm.trans h1)).symm⟩ h
    have hval {y : cliffordFullCover Q} {c : K}
        (hy : (((y : lipschitzGroup Q) : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) =
          algebraMap K _ c) :
        x = y ↔ (r : K) = c := by
      rw [← (algebraMap_injective Q).eq_iff, ← hr, ← hy]
      exact ⟨fun h ↦ by rw [h], fun h ↦ Subtype.ext (Subtype.ext (Units.ext h))⟩
    rcases mul_self_eq_one_iff.1 hr1 with h1 | h1
    · exact Or.inl ((hval (y := 1) (by simp)).2 h1)
    · exact Or.inr ((hval (c := -1) (by simp)).2 h1)
  · rintro (rfl | rfl)
    · exact one_mem _
    · rw [MonoidHom.mem_ker, cliffordFullCoverToOrthogonal_spinToCliffordFullCover_apply,
        spinGroup.spinToOrthogonal_negOne]

/-- When `-1` is not a square, the kernel of the full-cover action is the image of the kernel of
the Spin action: the two covers have the same kernel `{±1}`. -/
theorem ker_cliffordFullCoverToOrthogonal [Nontrivial V] (hQ : Q.Nondegenerate)
    (h : ¬IsSquare (-1 : K)) :
    (cliffordFullCoverToOrthogonal Q).ker =
      (spinToOrthogonal Q).ker.map (spinToCliffordFullCover Q) := by
  rw [← cliffordFullCoverToOrthogonal_comp_spinToCliffordFullCover, ← MonoidHom.comap_ker,
    Subgroup.map_comap_eq]
  refine (inf_eq_right.2 fun x hx ↦ ?_).symm
  rcases (mem_ker_cliffordFullCoverToOrthogonal_iff hQ h x).1 hx with rfl | rfl
  · exact one_mem _
  · exact ⟨_, rfl⟩

/-- **The even part of the full cover covers `SO(Q)`.** Over a field in which every element is a
square up to sign, an orthogonal transformation of a finite-dimensional nondegenerate quadratic
space is the action of an even element of the full cover exactly when it has determinant one. -/
theorem exists_cliffordFullCoverToOrthogonal_eq_and_mem_even_iff (hQ : Q.Nondegenerate)
    (hK : ∀ a : K, IsSquare a ∨ IsSquare (-a)) (g : QuadraticMap.orthogonalGroup Q) :
    (∃ x : cliffordFullCover Q, cliffordFullCoverToOrthogonal Q x = g ∧
        (((x : lipschitzGroup Q) : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) ∈ even Q) ↔
      g ∈ QuadraticMap.specialOrthogonalWithin Q := by
  rw [QuadraticMap.mem_specialOrthogonalWithin_iff, ← QuadraticMap.orthogonalDet_apply]
  constructor
  · rintro ⟨x, rfl, hx⟩
    exact det_lipschitzToOrthogonal_eq_one_of_mem_even Q _ hx
  · intro hg
    obtain ⟨x, rfl⟩ := cliffordFullCoverToOrthogonal_surjective hQ hK g
    exact ⟨x, rfl, mem_even_of_det_lipschitzToOrthogonal_eq_one Q _ hg⟩

end Field

end CliffordAlgebra
