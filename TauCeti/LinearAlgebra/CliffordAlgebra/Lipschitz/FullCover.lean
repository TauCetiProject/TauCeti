module

public import TauCeti.Algebra.Group.Subgroup.ZPowers
public import TauCeti.LinearAlgebra.CliffordAlgebra.Lipschitz.ReverseNorm
public import TauCeti.LinearAlgebra.CliffordAlgebra.Pin.Action

/-!
# The normalized Clifford full cover

For a quadratic form, the reverse Clifford norm is a unit-valued homomorphism on the
Lipschitz group.  Its inverse image of the subgroup generated by `-1` is the normalized full
Clifford cover: its elements have reverse norm `1` or `-1`.  This carrier contains the Spin group
at norm `1` and acts on the quadratic space through the existing Lipschitz action.

For positive-dimensional finite-dimensional nondegenerate real quadratic spaces, this action is
surjective onto the full orthogonal group and has scalar kernel `{±1}`; see Lawson and Michelsohn,
*Spin Geometry*, Chapter I, Section 2.  These classical facts are not proved here.

The construction follows Lawson and Michelsohn, *Spin Geometry*, Chapter I, Section 2, with the
reverse-norm convention recorded in `Lipschitz.ReverseNorm`.
-/

public section

noncomputable section

namespace CliffordAlgebra

open TauCeti

universe u v

variable {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
  [Invertible (2 : R)]

/-- The normalized full Clifford cover of a quadratic form.

It is the subgroup of the Lipschitz group on which the reverse Clifford norm is generated by
`-1`; equivalently, its elements have norm `1` or `-1`. -/
def cliffordFullCover (Q : QuadraticForm R M) : Subgroup (lipschitzGroup Q) :=
  (Subgroup.zpowers (-1 : Rˣ)).comap (cliffordNorm Q)

/-- Membership in the normalized full cover is the reverse-norm sign condition. -/
@[simp]
theorem mem_cliffordFullCover_iff (Q : QuadraticForm R M) (x : lipschitzGroup Q) :
    x ∈ cliffordFullCover Q ↔
      cliffordNorm Q x = 1 ∨ cliffordNorm Q x = -1 := by
  rw [cliffordFullCover, Subgroup.mem_comap,
    Subgroup.mem_zpowers_iff_of_sq_eq_one]
  simp

/-- The orthogonal action restricted to the normalized full Clifford cover. -/
def cliffordFullCoverToOrthogonal (Q : QuadraticForm R M) :
    cliffordFullCover Q →* QuadraticMap.orthogonalGroup Q :=
  (lipschitzToOrthogonal Q).comp (cliffordFullCover Q).subtype

/-- The full-cover action is the ambient Lipschitz action on the underlying element. -/
@[simp]
theorem cliffordFullCoverToOrthogonal_apply (Q : QuadraticForm R M)
    (x : cliffordFullCover Q) :
    cliffordFullCoverToOrthogonal Q x =
      lipschitzToOrthogonal Q (x : lipschitzGroup Q) := by
  simp [cliffordFullCoverToOrthogonal]

/-- The Spin group embeds in the normalized full cover through its canonical Lipschitz lift. -/
def spinToCliffordFullCover (Q : QuadraticForm R M) :
    spinGroup Q →* cliffordFullCover Q :=
  (spinToLipschitz Q).codRestrict _ fun x => by
    rw [mem_cliffordFullCover_iff]
    rw [spinToLipschitz_apply]
    exact Or.inl (cliffordNorm_pinToLipschitz_spinToPin x)

/-- The underlying Lipschitz element of the Spin-to-full-cover inclusion. -/
@[simp]
theorem coe_spinToCliffordFullCover_apply (Q : QuadraticForm R M) (x : spinGroup Q) :
    (spinToCliffordFullCover Q x : lipschitzGroup Q) = spinToLipschitz Q x := by
  simp only [spinToCliffordFullCover, MonoidHom.codRestrict_apply]

/-- The Spin-to-full-cover inclusion is injective. -/
theorem spinToCliffordFullCover_injective (Q : QuadraticForm R M) :
    Function.Injective (spinToCliffordFullCover Q) := by
  exact (MonoidHom.injective_codRestrict _ _ _).mpr (spinToLipschitz_injective Q)

/-- The Spin action is the restriction of the full-cover action pointwise. -/
@[simp 1100]
theorem cliffordFullCoverToOrthogonal_spinToCliffordFullCover_apply
    (Q : QuadraticForm R M) (x : spinGroup Q) :
    cliffordFullCoverToOrthogonal Q (spinToCliffordFullCover Q x) =
      spinToOrthogonal Q x := by
  rw [cliffordFullCoverToOrthogonal_apply, coe_spinToCliffordFullCover_apply]
  rw [spinToLipschitz_apply]
  rw [← pinToOrthogonal_eq_lipschitzToOrthogonal, pinToOrthogonal_spinToPin]

/-- The restricted orthogonal action agrees with the usual Spin action on the included subgroup. -/
@[simp]
theorem cliffordFullCoverToOrthogonal_comp_spinToCliffordFullCover
    (Q : QuadraticForm R M) :
    (cliffordFullCoverToOrthogonal Q).comp (spinToCliffordFullCover Q) =
      spinToOrthogonal Q := by
  apply MonoidHom.ext
  intro x
  simpa only [MonoidHom.comp_apply] using
    cliffordFullCoverToOrthogonal_spinToCliffordFullCover_apply Q x

end CliffordAlgebra
