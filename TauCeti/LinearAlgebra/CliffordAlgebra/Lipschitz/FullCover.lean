module

public import TauCeti.Algebra.Group.Subgroup.ZPowers
public import TauCeti.LinearAlgebra.CliffordAlgebra.RealForm.Basic
public import TauCeti.LinearAlgebra.CliffordAlgebra.Lipschitz.Action
public import TauCeti.LinearAlgebra.CliffordAlgebra.Lipschitz.ReverseNorm
public import TauCeti.LinearAlgebra.CliffordAlgebra.Pin.Action

/-!
# The normalized real Clifford full cover

For a real quadratic form, the reverse Clifford norm is a unit-valued homomorphism on the
Lipschitz group.  Its inverse image of the subgroup generated by `-1` is the normalized full
Clifford cover: its elements have reverse norm `1` or `-1`.  This carrier contains the Spin group
at norm `1` and acts on the quadratic space through the existing Lipschitz action.

The later Cartan--Dieudonné argument identifies this action with the full orthogonal group and
computes its scalar kernel.  This file supplies the carrier and the restriction maps that those
arguments consume.

The construction follows Lawson and Michelsohn, *Spin Geometry*, Chapter I, Section 2, with the
reverse-norm convention recorded in `Lipschitz.ReverseNorm`.
-/

public section

noncomputable section

namespace CliffordAlgebra

open TauCeti

universe u v

variable {M : Type u} [AddCommGroup M] [Module ℝ M]

/-- The normalized full Clifford cover of a real quadratic form.

It is the subgroup of the Lipschitz group on which the reverse Clifford norm is generated by
`-1`; equivalently, its elements have norm `1` or `-1`. -/
def realCliffordFullCover (Q : QuadraticForm ℝ M) : Subgroup (lipschitzGroup Q) :=
  (Subgroup.zpowers (-1 : ℝˣ)).comap (cliffordNorm Q)

/-- Membership in the normalized full cover is the reverse-norm sign condition. -/
@[simp]
theorem mem_realCliffordFullCover_iff (Q : QuadraticForm ℝ M) (x : lipschitzGroup Q) :
    x ∈ realCliffordFullCover Q ↔
      cliffordNorm Q x = 1 ∨ cliffordNorm Q x = -1 := by
  rw [realCliffordFullCover, Subgroup.mem_comap,
    Subgroup.mem_zpowers_iff_of_sq_eq_one]
  simp

/-- The orthogonal action restricted to the normalized full Clifford cover. -/
def realCliffordFullCoverToOrthogonal (Q : QuadraticForm ℝ M) :
    realCliffordFullCover Q →* QuadraticMap.orthogonalGroup Q :=
  (lipschitzToOrthogonal Q).comp (realCliffordFullCover Q).subtype

/-- The full-cover action is the ambient Lipschitz action on the underlying element. -/
@[simp]
theorem realCliffordFullCoverToOrthogonal_apply (Q : QuadraticForm ℝ M)
    (x : realCliffordFullCover Q) :
    realCliffordFullCoverToOrthogonal Q x =
      lipschitzToOrthogonal Q (x : lipschitzGroup Q) := by
  simp [realCliffordFullCoverToOrthogonal]

/-- The Spin group embeds in the normalized full cover through its canonical Lipschitz lift. -/
def realCliffordSpinToFullCover (Q : QuadraticForm ℝ M) :
    spinGroup Q →* realCliffordFullCover Q where
  toFun x :=
    ⟨pinToLipschitz Q (spinToPin Q x), by
      rw [mem_realCliffordFullCover_iff]
      exact Or.inl (cliffordNorm_pinToLipschitz_spinToPin x)⟩
  map_one' := by
    apply Subtype.ext
    simp
  map_mul' x y := by
    apply Subtype.ext
    simp [map_mul]

/-- The underlying Lipschitz element of the Spin-to-full-cover inclusion. -/
@[simp]
theorem realCliffordSpinToFullCover_apply (Q : QuadraticForm ℝ M) (x : spinGroup Q) :
    (realCliffordSpinToFullCover Q x : lipschitzGroup Q) =
      pinToLipschitz Q (spinToPin Q x) := by
  rfl

/-- The restricted orthogonal action agrees with the usual Spin action on the included subgroup. -/
theorem realCliffordFullCoverToOrthogonal_comp_spinToFullCover
    (Q : QuadraticForm ℝ M) :
    (realCliffordFullCoverToOrthogonal Q).comp (realCliffordSpinToFullCover Q) =
      spinToOrthogonal Q := by
  apply MonoidHom.ext
  intro x
  change lipschitzToOrthogonal Q (pinToLipschitz Q (spinToPin Q x)) = spinToOrthogonal Q x
  rw [← pinToOrthogonal_eq_lipschitzToOrthogonal, pinToOrthogonal_spinToPin]

end CliffordAlgebra
