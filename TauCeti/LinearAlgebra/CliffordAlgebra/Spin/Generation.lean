module

public import TauCeti.LinearAlgebra.CliffordAlgebra.Spin.Kernel
public import TauCeti.LinearAlgebra.QuadraticForm.CartanDieudonne.SpecialOrthogonal

/-!
# Generation of Spin groups by reflection-pair lifts

The special orthogonal group of a finite-dimensional nondegenerate quadratic space is generated
by products of two reflections. Consequently, a subgroup of the Spin group is the whole group as
soon as it contains the kernel generator `-1` and one lift of every reflection pair. This file
records that reduction and its concrete formulation when the Spin action is surjective.

## Main results

* `CliffordAlgebra.subgroup_eq_top_of_negOne_mem_of_reflection_pair_lift_mem` reduces generation of
  a Spin group to the kernel generator and lifts of products of two reflections.
* `CliffordAlgebra.closure_spin_reflection_pair_lifts_eq_top_of_surjective` identifies the subgroup
  generated by all reflection-pair lifts when the Spin action is surjective.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I, Section 2.
-/

public section

namespace CliffordAlgebra

open TauCeti

universe u v

variable {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] [Invertible (2 : K)] [Nontrivial V]

/-- A subgroup of a Spin group is the whole group if it contains the scalar `-1` and contains
one lift of every product of two anisotropic reflections.

The reflection-pair hypothesis is existential: different choices of lifts differ by an element
of the kernel, and the `-1` hypothesis already puts that entire kernel in `H`. -/
theorem subgroup_eq_top_of_negOne_mem_of_reflection_pair_lift_mem
    (Q : QuadraticForm K V) (hQ : Q.Nondegenerate) (H : Subgroup (spinGroup Q))
    (hneg : spinGroup.negOne Q hQ.ne_zero ∈ H)
    (hlift : ∀ (v w : V) [Invertible (Q v)] [Invertible (Q w)],
      ∃ x ∈ H,
        (spinToSpecialOrthogonal Q x : V ≃ₗ[K] V) =
          QuadraticMap.reflection Q v * QuadraticMap.reflection Q w) :
    H = ⊤ := by
  let p := spinToSpecialOrthogonal Q
  let M : Subgroup (V ≃ₗ[K] V) :=
    (H.map p).map (QuadraticMap.specialOrthogonalGroup Q).subtype
  have hpairs : ∀ (v w : V) [Invertible (Q v)] [Invertible (Q w)],
      QuadraticMap.reflection Q v * QuadraticMap.reflection Q w ∈ M := by
    intro v w _ _
    obtain ⟨x, hxH, hx⟩ := hlift v w
    rw [Subgroup.mem_map]
    exact ⟨p x, Subgroup.mem_map_of_mem p hxH, hx⟩
  have hSO : QuadraticMap.specialOrthogonalGroup Q ≤ M :=
    QuadraticMap.specialOrthogonalGroup_le_of_reflection_mul_mem Q hQ M.toSubmonoid hpairs
  have hmap : H.map p = ⊤ := by
    rw [Subgroup.eq_top_iff']
    intro g
    have hg : (g : V ≃ₗ[K] V) ∈ M := hSO g.prop
    rw [Subgroup.mem_map] at hg
    obtain ⟨z, hz, hzg⟩ := hg
    have : z = g := Subtype.ext hzg
    rwa [this] at hz
  have hker : p.ker ≤ H := by
    intro x hx
    rcases (mem_ker_spinToSpecialOrthogonal_iff Q hQ x).mp hx with rfl | rfl
    · exact H.one_mem
    · exact hneg
  calc
    H = (H.map p).comap p := (Subgroup.comap_map_eq_self hker).symm
    _ = ⊤ := by rw [hmap]; exact Subgroup.comap_top p

/-- If the Spin action is surjective, the Spin group is generated by the elements whose
special-orthogonal projections are products of two anisotropic reflections. -/
theorem closure_spin_reflection_pair_lifts_eq_top_of_surjective
    (Q : QuadraticForm K V) (hQ : Q.Nondegenerate)
    (hsurj : Function.Surjective (spinToSpecialOrthogonal Q)) :
    Subgroup.closure {x : spinGroup Q |
      ∃ (v w : V) (_ : Invertible (Q v)) (_ : Invertible (Q w)),
        (spinToSpecialOrthogonal Q x : V ≃ₗ[K] V) =
          QuadraticMap.reflection Q v * QuadraticMap.reflection Q w} = ⊤ := by
  let H : Subgroup (spinGroup Q) := Subgroup.closure {x : spinGroup Q |
    ∃ (v w : V) (_ : Invertible (Q v)) (_ : Invertible (Q w)),
      (spinToSpecialOrthogonal Q x : V ≃ₗ[K] V) =
        QuadraticMap.reflection Q v * QuadraticMap.reflection Q w}
  apply subgroup_eq_top_of_negOne_mem_of_reflection_pair_lift_mem Q hQ H
  · apply Subgroup.subset_closure
    obtain ⟨v, hv⟩ := DFunLike.ne_iff.mp hQ.ne_zero
    let _ : Invertible (Q v) := (isUnit_iff_ne_zero.mpr (by simpa using hv)).invertible
    refine ⟨v, v, inferInstance, inferInstance, ?_⟩
    simpa using (QuadraticMap.reflection_mul_self Q v).symm
  · intro v w _ _
    let g : QuadraticMap.specialOrthogonalGroup Q :=
      ⟨QuadraticMap.reflection Q v * QuadraticMap.reflection Q w,
        QuadraticMap.mem_specialOrthogonalGroup_iff.mpr
          ⟨(QuadraticMap.orthogonalGroup Q).mul_mem
            (QuadraticMap.reflection_mem_orthogonalGroup Q v)
            (QuadraticMap.reflection_mem_orthogonalGroup Q w), by simp⟩⟩
    obtain ⟨x, hx⟩ := hsurj g
    have hx' : (spinToSpecialOrthogonal Q x : V ≃ₗ[K] V) =
        QuadraticMap.reflection Q v * QuadraticMap.reflection Q w :=
      congrArg Subtype.val hx
    exact ⟨x, Subgroup.subset_closure ⟨v, w, inferInstance, inferInstance, hx'⟩, hx'⟩

end CliffordAlgebra
