module

public import Mathlib.Analysis.SpecialFunctions.Complex.Circle
public import TauCeti.LinearAlgebra.CliffordAlgebra.Spin.Kernel

/-!
# The group `Spinᶜ(Q)`

For a nonzero real quadratic form `Q`, the group `Spinᶜ(Q)` is the quotient
`(Spin(Q) × U(1)) / {1, (-1, -1)}` of the product of the Spin group with the unit circle by the
central subgroup generated by `(-1, -1)`. We write `[s, z]` for the class of `(s, z)`. It is the
structure group of a `Spinᶜ` structure: for `Q v = -‖v‖²` on an oriented four-space, its
half-spin representations `[s, z] ↦ z ρ^±(s)` are the fibres of the spinor bundles `W^±` of a
`Spinᶜ` four-manifold.

The group comes with two homomorphisms: the determinant character `[s, z] ↦ z²` to `U(1)`, and
the rotation homomorphism `[s, z] ↦ π(s)` to `SO(Q)` through the Spin action
`π : Spin(Q) → SO(Q)`. For a `Spinᶜ` structure, the determinant line `L` is the line bundle
associated to its principal `Spinᶜ` bundle through the determinant character, and the frame bundle
is obtained from that principal bundle through the rotation homomorphism. Both homomorphisms are
well defined because `(-1)² = 1` and `π(-1) = 1`. For a finite-dimensional nondegenerate `Q` in
positive dimension, the kernel of their product `Spinᶜ(Q) → SO(Q) × U(1)` is the subgroup
`{1, [1, -1]}` of order two, and the product is onto whenever the Spin action is. So `Spinᶜ(Q)` is
a double cover of `SO(Q) × U(1)` whenever `Spin(Q)` is a double cover of `SO(Q)`.

## Main definitions

* `CliffordAlgebra.spinCKernel Q hQ`: the central subgroup of `spinGroup Q × Circle` generated by
  `(-1, -1)`.
* `CliffordAlgebra.spinCGroup Q hQ`: the quotient group `Spinᶜ(Q)`.
* `CliffordAlgebra.spinCGroup.mk Q hQ`: the quotient map `(s, z) ↦ [s, z]`, and
  `CliffordAlgebra.spinCGroup.lift`: the descent of homomorphisms trivial on `(-1, -1)`.
* `CliffordAlgebra.spinCGroup.ofSpin Q hQ` and `CliffordAlgebra.spinCGroup.ofCircle Q hQ`: the
  injective homomorphisms `s ↦ [s, 1]` and `z ↦ [1, z]`.
* `CliffordAlgebra.spinCGroup.det Q hQ`: the determinant character `[s, z] ↦ z²`.
* `CliffordAlgebra.spinCGroup.toSpecialOrthogonal Q hQ`: the rotation homomorphism
  `[s, z] ↦ π(s)`.

## Main results

* `CliffordAlgebra.mem_spinCKernel_iff`: the subgroup `spinCKernel Q hQ` is `{1, (-1, -1)}`.
* `CliffordAlgebra.spinCGroup.mk_eq_mk_iff`: `[s, z] = [s', z']` exactly when
  `(s', z') = (s, z)` or `(s', z') = (-s, -z)`.
* `CliffordAlgebra.spinCGroup.mem_ker_toSpecialOrthogonal_prod_det_iff`: the kernel of
  `Spinᶜ(Q) → SO(Q) × U(1)` is `{1, [1, -1]}`.
* `CliffordAlgebra.spinCGroup.toSpecialOrthogonal_prod_det_surjective`: this map is onto when the
  Spin action is onto `SO(Q)`.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Appendix D.
* J. W. Morgan, *The Seiberg–Witten equations and applications to the topology of smooth
  four-manifolds*, Mathematical Notes 44, Princeton University Press, 1996, §3.1.
-/

public section

noncomputable section

namespace CliffordAlgebra

open TauCeti.QuadraticMap

variable {M : Type*} [AddCommGroup M] [Module ℝ M] (Q : QuadraticForm ℝ M) (hQ : Q ≠ 0)

/-- The central subgroup of `spinGroup Q × Circle` generated by `(-1, -1)`. The group
`Spinᶜ(Q)` is the quotient by it. -/
def spinCKernel : Subgroup (spinGroup Q × Circle) :=
  Subgroup.zpowers (spinGroup.negOne Q hQ, -1)

/-- The subgroup `spinCKernel Q hQ` consists of `1` and `(-1, -1)`. -/
theorem mem_spinCKernel_iff {p : spinGroup Q × Circle} :
    p ∈ spinCKernel Q hQ ↔ p = 1 ∨ p = (spinGroup.negOne Q hQ, -1) := by
  have hsq : (spinGroup.negOne Q hQ, (-1 : Circle)) ^ (2 : ℤ) = 1 := by
    ext <;> simp
  constructor
  · rintro ⟨k, rfl⟩
    dsimp only
    rw [zpow_eq_zpow_emod k hsq]
    rcases Int.emod_two_eq_zero_or_one k with h | h <;> simp [h]
  · rintro (rfl | rfl)
    · exact one_mem _
    · exact Subgroup.mem_zpowers _

/-- `(-1, -1)` lies in `spinCKernel Q hQ`. -/
theorem negOne_neg_one_mem_spinCKernel : (spinGroup.negOne Q hQ, -1) ∈ spinCKernel Q hQ :=
  Subgroup.mem_zpowers _

/-- The subgroup `spinCKernel Q hQ` is central. -/
theorem spinCKernel_le_center : spinCKernel Q hQ ≤ Subgroup.center (spinGroup Q × Circle) := by
  rw [spinCKernel, Subgroup.zpowers_le, Subgroup.mem_center_iff]
  intro p
  ext
  · simp
  · exact mul_comm _ _

instance : (spinCKernel Q hQ).Normal :=
  Subgroup.normal_of_le_center (spinCKernel_le_center Q hQ)

/-- **The group `Spinᶜ(Q)`**: the quotient `(Spin(Q) × U(1)) / {1, (-1, -1)}`. For
`Q v = -‖v‖²` on a real inner product space of dimension `n`, this is `Spinᶜ(n)`, the structure
group of a `Spinᶜ` structure. -/
abbrev spinCGroup : Type _ :=
  (spinGroup Q × Circle) ⧸ spinCKernel Q hQ

namespace spinCGroup

/-- The quotient map `Spin(Q) × U(1) → Spinᶜ(Q)`, `(s, z) ↦ [s, z]`. -/
def mk : spinGroup Q × Circle →* spinCGroup Q hQ :=
  QuotientGroup.mk' _

/-- `mk` is the quotient map. -/
theorem mk_apply (p : spinGroup Q × Circle) : mk Q hQ p = (p : spinCGroup Q hQ) :=
  (rfl)

/-- Every element of `Spinᶜ(Q)` is a class `[s, z]`. -/
theorem mk_surjective : Function.Surjective (mk Q hQ) :=
  QuotientGroup.mk'_surjective _

/-- The kernel of the quotient map is `{1, (-1, -1)}`. -/
@[simp]
theorem ker_mk : (mk Q hQ).ker = spinCKernel Q hQ :=
  QuotientGroup.ker_mk' _

/-- `[-1, -1] = 1` in `Spinᶜ(Q)`. -/
@[simp]
theorem mk_negOne_neg_one : mk Q hQ (spinGroup.negOne Q hQ, -1) = 1 := by
  rw [← MonoidHom.mem_ker, ker_mk]
  exact negOne_neg_one_mem_spinCKernel Q hQ

/-- `[s, z] = [s', z']` exactly when `(s', z') = (s, z)` or `(s', z') = (-s, -z)`. -/
theorem mk_eq_mk_iff {p p' : spinGroup Q × Circle} :
    mk Q hQ p = mk Q hQ p' ↔ p' = p ∨ p' = (spinGroup.negOne Q hQ, -1) * p := by
  rw [mk_apply, mk_apply, QuotientGroup.eq, mem_spinCKernel_iff, inv_mul_eq_one,
    inv_mul_eq_iff_eq_mul, eq_comm (a := p), Subgroup.mem_center_iff.mp
      (spinCKernel_le_center Q hQ (negOne_neg_one_mem_spinCKernel Q hQ)) p]

/-- **The universal property of `Spinᶜ(Q)`**: a homomorphism out of `Spin(Q) × U(1)` that is
trivial on `(-1, -1)` descends to `Spinᶜ(Q)`. -/
def lift {G : Type*} [Monoid G] (f : spinGroup Q × Circle →* G)
    (hf : f (spinGroup.negOne Q hQ, -1) = 1) : spinCGroup Q hQ →* G :=
  QuotientGroup.lift _ f <| by
    rwa [spinCKernel, Subgroup.zpowers_le, MonoidHom.mem_ker]

@[simp]
theorem lift_mk {G : Type*} [Monoid G] (f : spinGroup Q × Circle →* G)
    (hf : f (spinGroup.negOne Q hQ, -1) = 1) (p : spinGroup Q × Circle) :
    lift Q hQ f hf (mk Q hQ p) = f p :=
  (rfl)

/-- The composite of `lift f` with the quotient map is `f`. -/
@[simp]
theorem lift_comp_mk {G : Type*} [Monoid G] (f : spinGroup Q × Circle →* G)
    (hf : f (spinGroup.negOne Q hQ, -1) = 1) : (lift Q hQ f hf).comp (mk Q hQ) = f :=
  (rfl)

/-- The inclusion `Spin(Q) → Spinᶜ(Q)`, `s ↦ [s, 1]`. -/
def ofSpin : spinGroup Q →* spinCGroup Q hQ :=
  (mk Q hQ).comp (MonoidHom.inl _ _)

/-- The inclusion `U(1) → Spinᶜ(Q)`, `z ↦ [1, z]`. -/
def ofCircle : Circle →* spinCGroup Q hQ :=
  (mk Q hQ).comp (MonoidHom.inr _ _)

theorem ofSpin_apply (s : spinGroup Q) : ofSpin Q hQ s = mk Q hQ (s, 1) :=
  (rfl)

theorem ofCircle_apply (z : Circle) : ofCircle Q hQ z = mk Q hQ (1, z) :=
  (rfl)

/-- The class `[s, z]` is the product `[s, 1] [1, z]`. -/
theorem ofSpin_mul_ofCircle (s : spinGroup Q) (z : Circle) :
    ofSpin Q hQ s * ofCircle Q hQ z = mk Q hQ (s, z) := by
  simp [ofSpin_apply, ofCircle_apply, ← map_mul]

/-- The circle factor is central in `Spinᶜ(Q)`. -/
theorem ofCircle_mem_center (z : Circle) :
    ofCircle Q hQ z ∈ Subgroup.center (spinCGroup Q hQ) := by
  rw [Subgroup.mem_center_iff]
  intro x
  obtain ⟨⟨s, w⟩, rfl⟩ := mk_surjective Q hQ x
  simp only [ofCircle_apply, ← map_mul, Prod.mk_mul_mk, mul_one, one_mul, mul_comm z]

/-- The two inclusions agree on `-1`: `[-1, 1] = [1, -1]`. -/
theorem ofSpin_negOne : ofSpin Q hQ (spinGroup.negOne Q hQ) = ofCircle Q hQ (-1) := by
  rw [ofSpin_apply, ofCircle_apply, mk_eq_mk_iff]
  right
  ext <;> simp

/-- `Spin(Q)` is a subgroup of `Spinᶜ(Q)`. -/
theorem ofSpin_injective : Function.Injective (ofSpin Q hQ) := by
  intro s s' h
  rcases (mk_eq_mk_iff Q hQ).mp h with h | h
  · exact (Prod.ext_iff.mp h).1.symm
  · exact absurd (Prod.ext_iff.mp h).2 (by simpa using (Circle.neg_ne_self (1 : Circle)).symm)

/-- `U(1)` is a subgroup of `Spinᶜ(Q)`. -/
theorem ofCircle_injective : Function.Injective (ofCircle Q hQ) := by
  intro z z' h
  rcases (mk_eq_mk_iff Q hQ).mp h with h | h
  · exact (Prod.ext_iff.mp h).2.symm
  · exact absurd (by simpa using (Prod.ext_iff.mp h).1.symm) (spinGroup.negOne_ne_one Q hQ)

/-! ### The determinant character -/

/-- **The determinant character** `Spinᶜ(Q) → U(1)`, `[s, z] ↦ z²`, well defined because
`(-1)² = 1`. The determinant line of a `Spinᶜ` structure is the line bundle associated to its
principal `Spinᶜ` bundle through this character. -/
def det : spinCGroup Q hQ →* Circle :=
  lift Q hQ ((powMonoidHom 2).comp (MonoidHom.snd _ _)) (by simp)

@[simp]
theorem det_mk (p : spinGroup Q × Circle) : det Q hQ (mk Q hQ p) = p.2 ^ 2 :=
  (rfl)

@[simp]
theorem det_ofSpin (s : spinGroup Q) : det Q hQ (ofSpin Q hQ s) = 1 := by
  simp [ofSpin_apply]

@[simp]
theorem det_ofCircle (z : Circle) : det Q hQ (ofCircle Q hQ z) = z ^ 2 := by
  simp [ofCircle_apply]

/-! ### The rotation homomorphism -/

/-- **The rotation homomorphism** `Spinᶜ(Q) → SO(Q)`, `[s, z] ↦ π(s)`, through the Spin action
`π`; it is well defined because `π(-1) = 1`. -/
def toSpecialOrthogonal : spinCGroup Q hQ →* specialOrthogonalGroup Q :=
  lift Q hQ ((spinToSpecialOrthogonal Q).comp (MonoidHom.fst _ _)) (by simp)

@[simp]
theorem toSpecialOrthogonal_mk (p : spinGroup Q × Circle) :
    toSpecialOrthogonal Q hQ (mk Q hQ p) = spinToSpecialOrthogonal Q p.1 :=
  (rfl)

@[simp]
theorem toSpecialOrthogonal_ofSpin (s : spinGroup Q) :
    toSpecialOrthogonal Q hQ (ofSpin Q hQ s) = spinToSpecialOrthogonal Q s := by
  simp [ofSpin_apply]

@[simp]
theorem toSpecialOrthogonal_ofCircle (z : Circle) :
    toSpecialOrthogonal Q hQ (ofCircle Q hQ z) = 1 := by
  simp [ofCircle_apply]

/-! ### `Spinᶜ(Q)` as a double cover of `SO(Q) × U(1)` -/

/-- **The kernel of `Spinᶜ(Q) → SO(Q) × U(1)`**, `[s, z] ↦ (π(s), z²)`, is `{1, [1, -1]}` for a
finite-dimensional nondegenerate quadratic form in positive dimension. -/
theorem mem_ker_toSpecialOrthogonal_prod_det_iff [FiniteDimensional ℝ M] [Nontrivial M]
    (hQn : Q.Nondegenerate) (x : spinCGroup Q hQ) :
    x ∈ ((toSpecialOrthogonal Q hQ).prod (det Q hQ)).ker ↔ x = 1 ∨ x = ofCircle Q hQ (-1) := by
  obtain ⟨⟨s, z⟩, rfl⟩ := mk_surjective Q hQ x
  constructor
  · intro hx
    rw [MonoidHom.mem_ker, MonoidHom.prod_apply, Prod.mk_eq_one, toSpecialOrthogonal_mk,
      det_mk] at hx
    have hz : z = 1 ∨ z = -1 := by
      have h := congrArg ((↑) : Circle → ℂ) hx.2
      rw [Circle.coe_pow, Circle.coe_one, sq, mul_self_eq_one_iff] at h
      exact h.imp (fun h ↦ Circle.ext (by simpa using h)) (fun h ↦ Circle.ext (by simpa using h))
    rcases (mem_ker_spinToSpecialOrthogonal_iff Q hQn s).mp hx.1 with rfl | rfl <;>
      rcases hz with rfl | rfl
    · exact Or.inl (map_one _)
    · exact Or.inr rfl
    · refine Or.inr ((mk_eq_mk_iff Q hQ).mpr (Or.inr ?_))
      ext <;> simp
    · exact Or.inl (mk_negOne_neg_one Q hQ)
  · rintro (h | h) <;> simp [h]

/-- **`Spinᶜ(Q) → SO(Q) × U(1)` is onto** whenever the Spin action is onto `SO(Q)`: every unit
complex number has a square root on the circle. -/
theorem toSpecialOrthogonal_prod_det_surjective
    (h : Function.Surjective (spinToSpecialOrthogonal Q)) :
    Function.Surjective ((toSpecialOrthogonal Q hQ).prod (det Q hQ)) := by
  rintro ⟨g, z⟩
  obtain ⟨s, rfl⟩ := h g
  refine ⟨mk Q hQ (s, Circle.exp (Complex.arg z / 2)), ?_⟩
  rw [MonoidHom.prod_apply, toSpecialOrthogonal_mk, det_mk, ← Circle.exp_nsmul, nsmul_eq_mul,
    Nat.cast_ofNat, mul_div_cancel₀ _ two_ne_zero, Circle.exp_arg]

end spinCGroup

end CliffordAlgebra
