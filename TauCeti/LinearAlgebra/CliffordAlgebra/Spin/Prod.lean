module

public import Mathlib.GroupTheory.NoncommCoprod
public import Mathlib.LinearAlgebra.CliffordAlgebra.Prod
public import TauCeti.LinearAlgebra.CliffordAlgebra.Spin.Kernel
public import TauCeti.LinearAlgebra.QuadraticForm.Prod
import TauCeti.LinearAlgebra.CliffordAlgebra.Spin.Basic

/-!
# Spin groups of an orthogonal sum

The two orthogonal inclusions `Q₁ → Q₁ ⊕ Q₂ ← Q₂` induce homomorphisms of Spin groups, and since
even Clifford elements supported on orthogonal summands commute, they combine into a single
homomorphism

`CliffordAlgebra.spinGroupProd Q₁ Q₂ : Spin(Q₁) × Spin(Q₂) →* Spin(Q₁ ⊕ Q₂)`,

sending `(x, y)` to the Clifford product of the images of `x` and `y`. It acts on the orthogonal
sum componentwise, so over a free finite base its projection to the special orthogonal group of
the sum is the product of the projections of the two factors.

For finite-dimensional nondegenerate forms on nonzero spaces over a field in which `2` is
invertible, the homomorphism is not injective: the scalar `-1` of either factor maps to the scalar
`-1` of the sum, so the nontrivial element `(-1, -1)` maps to `1`. In that setting this is the
whole kernel, so the image is
`(Spin(Q₁) × Spin(Q₂)) / ⟨(-1, -1)⟩`. Splitting a real signature form into its definite blocks,
this gives the block subgroup `(Spin(p) × Spin(q)) / ⟨(-1, -1)⟩` of `Spin(p, q)`.

## Main definitions

* `CliffordAlgebra.spinGroupProd Q₁ Q₂`: the homomorphism `Spin(Q₁) × Spin(Q₂) →* Spin(Q₁ ⊕ Q₂)`.

## Main results

* `CliffordAlgebra.coe_spinGroupProd_apply`: its Clifford value is the product of the images of
  the two factors under the orthogonal inclusions.
* `CliffordAlgebra.spinGroupProd_inl_one` and `CliffordAlgebra.spinGroupProd_one_inr`: restricting
  `spinGroupProd` to either factor recovers the Spin map of that orthogonal inclusion.
* `CliffordAlgebra.spinGroupMap_prodMap_spinGroupProd` and
  `CliffordAlgebra.spinGroupEquiv_prod_spinGroupProd`: naturality of `spinGroupProd` with respect
  to products of quadratic isometries and isometric equivalences.
* `CliffordAlgebra.uniqueProd_spinGroupEquiv_spinGroupProd`,
  `CliffordAlgebra.prodUnique_spinGroupEquiv_spinGroupProd`,
  `CliffordAlgebra.prodAssoc_spinGroupEquiv_spinGroupProd`, and
  `CliffordAlgebra.prodComm_spinGroupEquiv_spinGroupProd`: left- and right-unit, associativity,
  and symmetry coherences of `spinGroupProd`.
* `CliffordAlgebra.spinVectorAction_spinGroupProd`: it acts on the orthogonal sum componentwise.
* `CliffordAlgebra.spinToOrthogonal_spinGroupProd` and
  `CliffordAlgebra.spinToSpecialOrthogonal_spinGroupProd`: its projections to the orthogonal and
  special orthogonal groups are the products of the two projections.
* `CliffordAlgebra.mem_ker_spinGroupProd_iff` and `CliffordAlgebra.ker_spinGroupProd`: over a field
  in which `2` is invertible, for finite-dimensional nondegenerate forms on nonzero spaces, its
  kernel is generated by `(-1, -1)`.
* `CliffordAlgebra.normal_zpowers_negOne_negOne`: `(-1, -1)` is central, so the subgroup it
  generates is normal and its quotient is a group.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I §2.
* C. Chevalley, *The Algebraic Theory of Spinors*, Columbia (1954), Chapter II.

Building `spinGroupProd` as `MonoidHom.noncommCoprod` of the two orthogonal-inclusion Spin maps
follows the approach of the closed, unmerged Tau Ceti pull request
[#12828](https://github.com/TauCetiProject/TauCeti/pull/12828) (combine Spin groups across
orthogonal sums).
-/

public section

open QuadraticMap

namespace CliffordAlgebra

variable {R M₁ M₂ : Type*} [CommRing R] [AddCommGroup M₁] [Module R M₁]
  [AddCommGroup M₂] [Module R M₂] (Q₁ : QuadraticForm R M₁) (Q₂ : QuadraticForm R M₂)

/-- The images of the Spin groups of two orthogonal summands commute in the Spin group of their
orthogonal sum: both are even, and even elements supported on orthogonal summands commute. -/
theorem commute_spinGroupMap_inl_spinGroupMap_inr (x : spinGroup Q₁) (y : spinGroup Q₂) :
    Commute ((Isometry.inl Q₁ Q₂).spinGroupMap x) ((Isometry.inr Q₁ Q₂).spinGroupMap y) :=
  Subtype.ext <| by
    simpa only [Submonoid.coe_mul, Isometry.coe_spinGroupMap_apply] using
      (commute_map_mul_map_of_isOrtho_of_mem_evenOdd_zero_left (Isometry.inl Q₁ Q₂)
        (Isometry.inr Q₁ Q₂) (fun a b ↦ IsOrtho.inl_inr a b) _ _ x.2.2 y.2.2).eq

/-- **The Spin group of an orthogonal sum receives the product of the Spin groups of the
summands.** The homomorphism `Spin(Q₁) × Spin(Q₂) →* Spin(Q₁ ⊕ Q₂)` multiplies the images of the
two factors under the orthogonal inclusions. -/
def spinGroupProd : spinGroup Q₁ × spinGroup Q₂ →* spinGroup (Q₁.prod Q₂) :=
  (Isometry.inl Q₁ Q₂).spinGroupMap.noncommCoprod (Isometry.inr Q₁ Q₂).spinGroupMap
    (commute_spinGroupMap_inl_spinGroupMap_inr Q₁ Q₂)

/-- `spinGroupProd` multiplies the images of the two factors under the orthogonal inclusions. -/
theorem spinGroupProd_apply (x : spinGroup Q₁ × spinGroup Q₂) :
    spinGroupProd Q₁ Q₂ x =
      (Isometry.inl Q₁ Q₂).spinGroupMap x.1 * (Isometry.inr Q₁ Q₂).spinGroupMap x.2 :=
  MonoidHom.noncommCoprod_apply ..

/-- The Clifford value of `spinGroupProd Q₁ Q₂ (x, y)` is the product of the images of `x` and
`y` in the Clifford algebra of the orthogonal sum. -/
@[simp]
theorem coe_spinGroupProd_apply (x : spinGroup Q₁ × spinGroup Q₂) :
    (spinGroupProd Q₁ Q₂ x : CliffordAlgebra (Q₁.prod Q₂)) =
      map (Isometry.inl Q₁ Q₂) (x.1 : CliffordAlgebra Q₁) *
        map (Isometry.inr Q₁ Q₂) (x.2 : CliffordAlgebra Q₂) := by
  rw [spinGroupProd_apply, Submonoid.coe_mul, Isometry.coe_spinGroupMap_apply,
    Isometry.coe_spinGroupMap_apply]

/-- Restricting `spinGroupProd` to the first factor gives the Spin map of the left orthogonal
inclusion. -/
@[simp]
theorem spinGroupProd_inl_one (x : spinGroup Q₁) :
    spinGroupProd Q₁ Q₂ (x, 1) = (Isometry.inl Q₁ Q₂).spinGroupMap x := by
  rw [spinGroupProd_apply, map_one, mul_one]

/-- Restricting `spinGroupProd` to the second factor gives the Spin map of the right orthogonal
inclusion. -/
@[simp]
theorem spinGroupProd_one_inr (y : spinGroup Q₂) :
    spinGroupProd Q₁ Q₂ (1, y) = (Isometry.inr Q₁ Q₂).spinGroupMap y := by
  rw [spinGroupProd_apply, map_one, one_mul]

/-- Composing `spinGroupProd` with `MonoidHom.inl` recovers `(Isometry.inl Q₁ Q₂).spinGroupMap`. -/
@[simp]
theorem spinGroupProd_comp_inl :
    (spinGroupProd Q₁ Q₂).comp (MonoidHom.inl _ _) = (Isometry.inl Q₁ Q₂).spinGroupMap :=
  MonoidHom.noncommCoprod_comp_inl ..

/-- Composing `spinGroupProd` with `MonoidHom.inr` recovers `(Isometry.inr Q₁ Q₂).spinGroupMap`. -/
@[simp]
theorem spinGroupProd_comp_inr :
    (spinGroupProd Q₁ Q₂).comp (MonoidHom.inr _ _) = (Isometry.inr Q₁ Q₂).spinGroupMap :=
  MonoidHom.noncommCoprod_comp_inr ..

/-- The Spin-group map of a left orthogonal summand is injective when the left Clifford algebra is
flat and scalar action on the right Clifford algebra is faithful. -/
theorem spinGroupMap_inl_injective [Module.Flat R (CliffordAlgebra Q₁)]
    [FaithfulSMul R (CliffordAlgebra Q₂)] :
    Function.Injective (Isometry.inl Q₁ Q₂).spinGroupMap :=
  (Isometry.inl Q₁ Q₂).spinGroupMap_injective (map_inl_injective Q₁ Q₂)

/-- The Spin-group map of a right orthogonal summand is injective when the right Clifford algebra
is flat and scalar action on the left Clifford algebra is faithful. -/
theorem spinGroupMap_inr_injective [Module.Flat R (CliffordAlgebra Q₂)]
    [FaithfulSMul R (CliffordAlgebra Q₁)] :
    Function.Injective (Isometry.inr Q₁ Q₂).spinGroupMap := by
  have hinr : Isometry.inr Q₁ Q₂ =
      (IsometryEquiv.prodComm Q₂ Q₁).toIsometry.comp (Isometry.inl Q₂ Q₁) :=
    Isometry.ext fun _ ↦ by simp
  rw [hinr, ← Isometry.spinGroupMap_comp, MonoidHom.coe_comp]
  exact ((IsometryEquiv.prodComm Q₂ Q₁).toIsometry.spinGroupMap_injective_of_leftInverse
    (IsometryEquiv.prodComm Q₁ Q₂).toIsometry
    (IsometryEquiv.prodComm Q₂ Q₁).symm_apply_apply).comp (spinGroupMap_inl_injective Q₂ Q₁)

/-- `spinGroupProd` is natural with respect to products of quadratic isometries. -/
@[simp]
theorem spinGroupMap_prodMap_spinGroupProd {N₁ N₂ : Type*} [AddCommGroup N₁] [Module R N₁]
    [AddCommGroup N₂] [Module R N₂] {Q₁' : QuadraticForm R N₁} {Q₂' : QuadraticForm R N₂}
    (f₁ : Q₁ →qᵢ Q₁') (f₂ : Q₂ →qᵢ Q₂') (x : spinGroup Q₁ × spinGroup Q₂) :
    (f₁.prodMap f₂).spinGroupMap (spinGroupProd Q₁ Q₂ x) =
      spinGroupProd Q₁' Q₂' (f₁.spinGroupMap x.1, f₂.spinGroupMap x.2) := by
  rw [spinGroupProd_apply, spinGroupProd_apply, map_mul, ← MonoidHom.comp_apply,
    ← MonoidHom.comp_apply, Isometry.spinGroupMap_comp, Isometry.spinGroupMap_comp,
    Isometry.prodMap_comp_inl, Isometry.prodMap_comp_inr, ← Isometry.spinGroupMap_comp,
    ← Isometry.spinGroupMap_comp, MonoidHom.comp_apply, MonoidHom.comp_apply]

/-- `spinGroupProd` is natural with respect to products of isometric equivalences. -/
theorem spinGroupEquiv_prod_spinGroupProd {N₁ N₂ : Type*} [AddCommGroup N₁] [Module R N₁]
    [AddCommGroup N₂] [Module R N₂] {Q₁' : QuadraticForm R N₁} {Q₂' : QuadraticForm R N₂}
    (e₁ : Q₁.IsometryEquiv Q₁') (e₂ : Q₂.IsometryEquiv Q₂') (x : spinGroup Q₁ × spinGroup Q₂) :
    (e₁.prod e₂).spinGroupEquiv (spinGroupProd Q₁ Q₂ x) =
      spinGroupProd Q₁' Q₂' (e₁.spinGroupEquiv x.1, e₂.spinGroupEquiv x.2) := by
  rw [IsometryEquiv.spinGroupEquiv_apply, IsometryEquiv.toIsometry_prod,
    spinGroupMap_prodMap_spinGroupProd, ← IsometryEquiv.spinGroupEquiv_apply,
    ← IsometryEquiv.spinGroupEquiv_apply]

/-- Deleting a trivial left summand along `IsometryEquiv.uniqueProd` sends `spinGroupProd` to its
second factor. -/
theorem uniqueProd_spinGroupEquiv_spinGroupProd [Unique M₁] (x : spinGroup Q₁ × spinGroup Q₂) :
    (IsometryEquiv.uniqueProd Q₁ Q₂).spinGroupEquiv (spinGroupProd Q₁ Q₂ x) = x.2 := by
  have hx₁ : x.1 = 1 := Subsingleton.elim _ _
  have hid : (IsometryEquiv.uniqueProd Q₁ Q₂).toIsometry.comp (Isometry.inr Q₁ Q₂) =
      Isometry.id Q₂ :=
    Isometry.ext fun _ ↦ by simp
  obtain ⟨x₁, x₂⟩ := x
  subst hx₁
  rw [spinGroupProd_one_inr, IsometryEquiv.spinGroupEquiv_apply, ← MonoidHom.comp_apply,
    Isometry.spinGroupMap_comp, hid, Isometry.spinGroupMap_id, MonoidHom.id_apply]

/-- Deleting a trivial right summand along `IsometryEquiv.prodUnique` sends `spinGroupProd` to its
first factor. -/
theorem prodUnique_spinGroupEquiv_spinGroupProd [Unique M₂] (x : spinGroup Q₁ × spinGroup Q₂) :
    (IsometryEquiv.prodUnique Q₁ Q₂).spinGroupEquiv (spinGroupProd Q₁ Q₂ x) = x.1 := by
  have hx₂ : x.2 = 1 := Subsingleton.elim _ _
  have hid : (IsometryEquiv.prodUnique Q₁ Q₂).toIsometry.comp (Isometry.inl Q₁ Q₂) =
      Isometry.id Q₁ :=
    Isometry.ext fun _ ↦ by simp
  obtain ⟨x₁, x₂⟩ := x
  subst hx₂
  rw [spinGroupProd_inl_one, IsometryEquiv.spinGroupEquiv_apply, ← MonoidHom.comp_apply,
    Isometry.spinGroupMap_comp, hid, Isometry.spinGroupMap_id, MonoidHom.id_apply]

/-- **`spinGroupProd` is associative** up to transport along `IsometryEquiv.prodAssoc`. -/
theorem prodAssoc_spinGroupEquiv_spinGroupProd {M₃ : Type*} [AddCommGroup M₃] [Module R M₃]
    (Q₃ : QuadraticForm R M₃) (x : spinGroup Q₁) (y : spinGroup Q₂) (z : spinGroup Q₃) :
    (IsometryEquiv.prodAssoc Q₁ Q₂ Q₃).spinGroupEquiv
        (spinGroupProd (Q₁.prod Q₂) Q₃ (spinGroupProd Q₁ Q₂ (x, y), z)) =
      spinGroupProd Q₁ (Q₂.prod Q₃) (x, spinGroupProd Q₂ Q₃ (y, z)) := by
  have h₁ : (IsometryEquiv.prodAssoc Q₁ Q₂ Q₃).toIsometry.comp
      ((Isometry.inl (Q₁.prod Q₂) Q₃).comp (Isometry.inl Q₁ Q₂)) =
      Isometry.inl Q₁ (Q₂.prod Q₃) :=
    Isometry.ext fun _ ↦ by simp
  have h₂ : (IsometryEquiv.prodAssoc Q₁ Q₂ Q₃).toIsometry.comp
      ((Isometry.inl (Q₁.prod Q₂) Q₃).comp (Isometry.inr Q₁ Q₂)) =
      (Isometry.inr Q₁ (Q₂.prod Q₃)).comp (Isometry.inl Q₂ Q₃) :=
    Isometry.ext fun _ ↦ by simp
  have h₃ : (IsometryEquiv.prodAssoc Q₁ Q₂ Q₃).toIsometry.comp
      (Isometry.inr (Q₁.prod Q₂) Q₃) =
      (Isometry.inr Q₁ (Q₂.prod Q₃)).comp (Isometry.inr Q₂ Q₃) :=
    Isometry.ext fun _ ↦ by simp
  simp only [IsometryEquiv.spinGroupEquiv_apply, spinGroupProd_apply, map_mul,
    ← MonoidHom.comp_apply, Isometry.spinGroupMap_comp, h₁, h₂, h₃, mul_assoc]

/-- **Swapping the two summands along `IsometryEquiv.prodComm` swaps the two factors of
`spinGroupProd`**, with no Koszul sign because Spin elements have even Clifford parity. -/
theorem prodComm_spinGroupEquiv_spinGroupProd (x : spinGroup Q₁ × spinGroup Q₂) :
    (IsometryEquiv.prodComm Q₁ Q₂).spinGroupEquiv (spinGroupProd Q₁ Q₂ x) =
      spinGroupProd Q₂ Q₁ x.swap := by
  have h₁ : (IsometryEquiv.prodComm Q₁ Q₂).toIsometry.comp (Isometry.inl Q₁ Q₂) =
      Isometry.inr Q₂ Q₁ :=
    Isometry.ext fun _ ↦ by simp
  have h₂ : (IsometryEquiv.prodComm Q₁ Q₂).toIsometry.comp (Isometry.inr Q₁ Q₂) =
      Isometry.inl Q₂ Q₁ :=
    Isometry.ext fun _ ↦ by simp
  rw [IsometryEquiv.spinGroupEquiv_apply, spinGroupProd_apply, spinGroupProd_apply, map_mul,
    ← MonoidHom.comp_apply, ← MonoidHom.comp_apply, Isometry.spinGroupMap_comp,
    Isometry.spinGroupMap_comp, h₁, h₂, Prod.snd_swap, Prod.fst_swap,
    (commute_spinGroupMap_inl_spinGroupMap_inr Q₂ Q₁ x.2 x.1).symm.eq]

variable [Invertible (2 : R)]

/-- **`spinGroupProd` acts componentwise**: `(x, y)` acts on the orthogonal sum by `x` on the first
summand and by `y` on the second. -/
@[simp]
theorem spinVectorAction_spinGroupProd (x : spinGroup Q₁ × spinGroup Q₂) (m : M₁ × M₂) :
    spinVectorAction (Q₁.prod Q₂) (spinGroupProd Q₁ Q₂ x) m =
      (spinVectorAction Q₁ x.1 m.1, spinVectorAction Q₂ x.2 m.2) := by
  obtain ⟨a, b⟩ := m
  -- The product-action lemma, applied through the identity and swap isometries, whose
  -- compositions with the inclusions are definitionally the inclusions.
  have h₁ := (IsometryEquiv.refl (Q₁.prod Q₂)).spinGroupMap_spinVectorAction_prod x.1 a
    (spinVectorAction Q₂ x.2 b)
  have h₂ := (IsometryEquiv.prodComm Q₁ Q₂).spinGroupMap_spinVectorAction_prod x.2 b a
  rw [spinGroupProd_apply, spinVectorAction_mul, mul_apply_eq_comp]
  exact (congrArg _ h₂).trans h₁

/-- **The projection of `spinGroupProd` to the orthogonal group** is the product of the projections
of the two factors. -/
@[simp]
theorem spinToOrthogonal_spinGroupProd (x : spinGroup Q₁ × spinGroup Q₂) :
    spinToOrthogonal (Q₁.prod Q₂) (spinGroupProd Q₁ Q₂ x) =
      orthogonalGroupProd Q₁ Q₂ (spinToOrthogonal Q₁ x.1, spinToOrthogonal Q₂ x.2) := by
  ext m <;> simp [coe_spinToOrthogonal_apply]

/-- **The projection of `spinGroupProd` to the special orthogonal group** is the product of the
projections of the two factors. -/
@[simp]
theorem spinToSpecialOrthogonal_spinGroupProd [Module.Free R M₁] [Module.Finite R M₁]
    [Module.Free R M₂] [Module.Finite R M₂] (x : spinGroup Q₁ × spinGroup Q₂) :
    spinToSpecialOrthogonal (Q₁.prod Q₂) (spinGroupProd Q₁ Q₂ x) =
      specialOrthogonalGroupProd Q₁ Q₂
        (spinToSpecialOrthogonal Q₁ x.1, spinToSpecialOrthogonal Q₂ x.2) := by
  ext m <;> simp [coe_spinToSpecialOrthogonal_apply]

end CliffordAlgebra

namespace CliffordAlgebra

section NegOne

variable {K M₁ M₂ : Type*} [Field K] [AddCommGroup M₁] [Module K M₁]
  [AddCommGroup M₂] [Module K M₂] {Q₁ : QuadraticForm K M₁} {Q₂ : QuadraticForm K M₂}

/-- The pair of scalars `(-1, -1)` is central in `Spin(Q₁) × Spin(Q₂)`, so the subgroup it generates
is normal. -/
instance normal_zpowers_negOne_negOne (hQ₁ : Q₁ ≠ 0) (hQ₂ : Q₂ ≠ 0) :
    (Subgroup.zpowers (spinGroup.negOne Q₁ hQ₁, spinGroup.negOne Q₂ hQ₂)).Normal :=
  Subgroup.normal_of_le_center <| Subgroup.zpowers_le.mpr <| Subgroup.mem_center_iff.mpr fun g ↦
    Prod.ext (Subtype.ext (by simp)) (Subtype.ext (by simp))

/-- `spinGroupProd` sends `(-1, 1)` to the scalar `-1` of the orthogonal sum. -/
theorem spinGroupProd_negOne_one (hQ₁ : Q₁ ≠ 0) :
    spinGroupProd Q₁ Q₂ (spinGroup.negOne Q₁ hQ₁, 1) =
      spinGroup.negOne (Q₁.prod Q₂)
        (fun h ↦ hQ₁ <| QuadraticMap.ext fun m ↦ by simpa using QuadraticMap.congr_fun h (m, 0)) :=
  Subtype.ext (by simp)

/-- `spinGroupProd` sends `(1, -1)` to the scalar `-1` of the orthogonal sum. -/
theorem spinGroupProd_one_negOne (hQ₂ : Q₂ ≠ 0) :
    spinGroupProd Q₁ Q₂ (1, spinGroup.negOne Q₂ hQ₂) =
      spinGroup.negOne (Q₁.prod Q₂)
        (fun h ↦ hQ₂ <| QuadraticMap.ext fun m ↦ by simpa using QuadraticMap.congr_fun h (0, m)) :=
  Subtype.ext (by simp)

/-- `spinGroupProd` sends `(-1, -1)` to `1`. -/
@[simp]
theorem spinGroupProd_negOne_negOne (hQ₁ : Q₁ ≠ 0) (hQ₂ : Q₂ ≠ 0) :
    spinGroupProd Q₁ Q₂ (spinGroup.negOne Q₁ hQ₁, spinGroup.negOne Q₂ hQ₂) = 1 :=
  Subtype.ext (by simp)

end NegOne

end CliffordAlgebra

namespace CliffordAlgebra

variable {K M₁ M₂ : Type*} [Field K] [Invertible (2 : K)]
  [AddCommGroup M₁] [Module K M₁] [FiniteDimensional K M₁] [Nontrivial M₁]
  [AddCommGroup M₂] [Module K M₂] [FiniteDimensional K M₂] [Nontrivial M₂]
  {Q₁ : QuadraticForm K M₁} {Q₂ : QuadraticForm K M₂}

/-- **The kernel of `spinGroupProd`.** For finite-dimensional nondegenerate forms on nonzero spaces
over a field in which `2` is invertible, a pair of Spin elements maps to `1` exactly when it is
`(1, 1)` or `(-1, -1)`. -/
theorem mem_ker_spinGroupProd_iff (hQ₁ : Q₁.Nondegenerate) (hQ₂ : Q₂.Nondegenerate)
    (x : spinGroup Q₁ × spinGroup Q₂) :
    x ∈ (spinGroupProd Q₁ Q₂).ker ↔
      x = 1 ∨ x = (spinGroup.negOne Q₁ hQ₁.ne_zero, spinGroup.negOne Q₂ hQ₂.ne_zero) := by
  have hsum : Q₁.prod Q₂ ≠ 0 := (hQ₁.prod hQ₂).ne_zero
  have hneg (y : spinGroup Q₁ × spinGroup Q₂)
      (hy : (spinGroupProd Q₁ Q₂ y : CliffordAlgebra (Q₁.prod Q₂)) = -1) :
      y ∉ (spinGroupProd Q₁ Q₂).ker :=
    fun h ↦ spinGroup.negOne_ne_one _ hsum <| Subtype.ext <| by
      rw [spinGroup.coe_negOne, ← hy, MonoidHom.mem_ker.mp h]
  constructor
  · intro hx
    -- Both factors act trivially, so each is `1` or `-1`.
    have hSO : (spinToSpecialOrthogonal Q₁ x.1, spinToSpecialOrthogonal Q₂ x.2) = 1 :=
      specialOrthogonalGroupProd_injective Q₁ Q₂ <| by
        rw [map_one, ← spinToSpecialOrthogonal_spinGroupProd, MonoidHom.mem_ker.mp hx, map_one]
    have h₁ := (mem_ker_spinToSpecialOrthogonal_iff Q₁ hQ₁ x.1).mp (congrArg Prod.fst hSO)
    have h₂ := (mem_ker_spinToSpecialOrthogonal_iff Q₂ hQ₂ x.2).mp (congrArg Prod.snd hSO)
    obtain ⟨x₁, x₂⟩ := x
    rcases h₁ with rfl | rfl <;> rcases h₂ with rfl | rfl
    · exact Or.inl rfl
    · exact absurd hx (hneg _ (by simp))
    · exact absurd hx (hneg _ (by simp))
    · exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact one_mem _
    · rw [MonoidHom.mem_ker]
      exact spinGroupProd_negOne_negOne hQ₁.ne_zero hQ₂.ne_zero

/-- **The kernel of `spinGroupProd` is generated by `(-1, -1)`**, for finite-dimensional
nondegenerate forms on nonzero spaces over a field in which `2` is invertible. -/
theorem ker_spinGroupProd (hQ₁ : Q₁.Nondegenerate) (hQ₂ : Q₂.Nondegenerate) :
    (spinGroupProd Q₁ Q₂).ker =
      Subgroup.zpowers (spinGroup.negOne Q₁ hQ₁.ne_zero, spinGroup.negOne Q₂ hQ₂.ne_zero) := by
  refine le_antisymm (fun x hx ↦ ?_) (Subgroup.zpowers_le.mpr ?_)
  · rcases (mem_ker_spinGroupProd_iff hQ₁ hQ₂ x).mp hx with rfl | rfl
    · exact one_mem _
    · exact Subgroup.mem_zpowers _
  · exact (mem_ker_spinGroupProd_iff hQ₁ hQ₂ _).mpr (Or.inr rfl)

end CliffordAlgebra
