module

public import TauCeti.LinearAlgebra.CliffordAlgebra.Spin.Generation
public import TauCeti.LinearAlgebra.CliffordAlgebra.Spin.Real.Basic

/-!
# Reflection-pair generation for positive-definite real Spin groups

For a finite-dimensional positive-definite real quadratic space, the Spin action onto the special
orthogonal group is surjective. The general reflection-pair generation theorem therefore shows
that the Spin group is generated by the elements lying above products of two reflections.

This form is suited to topological arguments: to prove that a subgroup such as the identity
component is the whole Spin group, it is enough to put every reflection-pair lift in that subgroup.

## Main result

* `CliffordAlgebra.closure_spin_reflection_pair_lifts_eq_top_of_posDef` gives reflection-pair
  generation for every nonzero finite-dimensional positive-definite real quadratic space.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I, Section 2.
-/

public section

namespace CliffordAlgebra

open TauCeti

universe v

variable {V : Type v} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V] [Nontrivial V]

/-- The Spin group of a nonzero finite-dimensional positive-definite real quadratic space is
generated by the elements whose projections are products of two anisotropic reflections. -/
theorem closure_spin_reflection_pair_lifts_eq_top_of_posDef
    (Q : QuadraticForm ℝ V) (hQ : Q.PosDef) :
    Subgroup.closure {x : spinGroup Q |
      ∃ (v w : V) (_ : Invertible (Q v)) (_ : Invertible (Q w)),
        (spinToSpecialOrthogonal Q x : V ≃ₗ[ℝ] V) =
          QuadraticMap.reflection Q v * QuadraticMap.reflection Q w} = ⊤ :=
  closure_spin_reflection_pair_lifts_eq_top_of_surjective Q hQ.anisotropic.nondegenerate
    (spinToSpecialOrthogonal_surjective_of_posDef Q hQ)

end CliffordAlgebra
