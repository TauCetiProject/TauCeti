module

public import TauCeti.LinearAlgebra.CliffordAlgebra.Spin.Prod
public import TauCeti.LinearAlgebra.CliffordAlgebra.Spin.Real.Neg

/-!
# The block subgroup `(Spin(p) × Spin(q)) / ⟨(-1, -1)⟩` of `Spin(p, q)`

The real signature form `realCliffordForm p q` is the orthogonal sum of its positive-definite block
on the first `p` coordinates and its negative-definite block on the last `q` coordinates
(`TauCeti.realCliffordBlockIsometry`). The first block is the compact form of `Spin(p)`. The second
is the negative-definite coordinate form `realCliffordForm 0 q`, and the compact group `Spin(q)` of
the positive-definite form `realCliffordForm q 0` is carried into its Clifford algebra by
`CliffordAlgebra.realCliffordSpinGroupEquivNeg q 0`.

Combining these with the Spin group of an orthogonal sum, `CliffordAlgebra.spinGroupProd`, gives the
block homomorphism

`CliffordAlgebra.realCliffordSpinBlockHom p q : Spin(p) × Spin(q) →* Spin(p, q)`,

which acts on the positive block through `Spin(p)` and on the negative block through `Spin(q)`.
For `p` and `q` both positive its kernel is generated by `(-1, -1)`, so its image is
`(Spin(p) × Spin(q)) / ⟨(-1, -1)⟩` (`CliffordAlgebra.realCliffordSpinBlockQuotientEquiv`). This
image is the maximal compact subgroup of `Spin(p, q)`; its topology and maximality are not proved
here.

## Main definitions

* `CliffordAlgebra.realCliffordSpinBlockHom p q`: the block homomorphism
  `Spin(p) × Spin(q) →* Spin(p, q)`.
* `CliffordAlgebra.realCliffordSpinBlockQuotientEquiv p q`: the isomorphism of
  `(Spin(p) × Spin(q)) / ⟨(-1, -1)⟩` with the image of the block homomorphism.

## Main results

* `CliffordAlgebra.spinVectorAction_realCliffordSpinBlockHom`: the block homomorphism acts on the
  two signature blocks through the two factors.
* `CliffordAlgebra.mem_ker_realCliffordSpinBlockHom_iff` and
  `CliffordAlgebra.ker_realCliffordSpinBlockHom`: for positive `p` and `q`, its kernel is
  `{(1, 1), (-1, -1)}`.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I §§2–3.
-/

public section

open QuadraticMap TauCeti

namespace CliffordAlgebra

variable (p q : ℕ)

/-- **The block homomorphism `Spin(p) × Spin(q) →* Spin(p, q)`.** The first factor acts on the
positive-definite block of the signature form, and the second, transported to the negative-definite
coordinate form by `realCliffordSpinGroupEquivNeg q 0`, acts on the negative-definite block. -/
noncomputable def realCliffordSpinBlockHom :
    realCliffordSpinGroupZero p × realCliffordSpinGroupZero q →* realCliffordSpinGroup p q :=
  (realCliffordBlockIsometry p q).symm.spinGroupEquiv.toMonoidHom.comp <|
    (spinGroupProd (realCliffordForm p 0) (realCliffordForm 0 q)).comp <|
      (MonoidHom.id _).prodMap (realCliffordSpinGroupEquivNeg q 0).toMonoidHom

/-- The block homomorphism is the Spin group of an orthogonal sum, applied after transporting the
second factor to the negative-definite form, and carried along the block isometry. -/
theorem realCliffordSpinBlockHom_apply
    (x : realCliffordSpinGroupZero p × realCliffordSpinGroupZero q) :
    realCliffordSpinBlockHom p q x =
      (realCliffordBlockIsometry p q).symm.spinGroupEquiv
        (spinGroupProd (realCliffordForm p 0) (realCliffordForm 0 q)
          (x.1, realCliffordSpinGroupEquivNeg q 0 x.2)) :=
  (rfl)

/-- **The block homomorphism acts block by block.** `realCliffordSpinBlockHom p q (x, y)` acts on
the positive block by `x` and on the negative block, read through the coordinate isometry
`realCliffordFormNegIsometry q 0`, by `y`. -/
@[simp]
theorem spinVectorAction_realCliffordSpinBlockHom
    (x : realCliffordSpinGroupZero p × realCliffordSpinGroupZero q)
    (a : Fin (p + 0) → ℝ) (b : Fin (q + 0) → ℝ) :
    spinVectorAction (realCliffordForm p q) (realCliffordSpinBlockHom p q x)
        ((realCliffordBlockIsometry p q).symm (a, realCliffordFormNegIsometry q 0 b)) =
      (realCliffordBlockIsometry p q).symm
        (spinVectorAction (realCliffordForm p 0) x.1 a,
          realCliffordFormNegIsometry q 0 (spinVectorAction (realCliffordForm q 0) x.2 b)) := by
  rw [realCliffordSpinBlockHom_apply, IsometryEquiv.spinGroupEquiv_apply,
    ← IsometryEquiv.toIsometry_apply, Isometry.spinGroupMap_spinVectorAction,
    spinVectorAction_spinGroupProd, spinVectorAction_realCliffordSpinGroupEquivNeg,
    IsometryEquiv.toIsometry_apply]

variable [NeZero p] [NeZero q]

/-- **The kernel of the block homomorphism.** For positive `p` and `q`, a pair in
`Spin(p) × Spin(q)` maps to `1` in `Spin(p, q)` exactly when it is `(1, 1)` or `(-1, -1)`. -/
theorem mem_ker_realCliffordSpinBlockHom_iff
    (x : realCliffordSpinGroupZero p × realCliffordSpinGroupZero q) :
    x ∈ (realCliffordSpinBlockHom p q).ker ↔
      x = 1 ∨ x = (spinGroup.negOne (realCliffordForm p 0)
          (nondegenerate_realCliffordForm p 0).ne_zero,
        spinGroup.negOne (realCliffordForm q 0) (nondegenerate_realCliffordForm q 0).ne_zero) := by
  have hneg := realCliffordSpinGroupEquivNeg_negOne q 0
  rw [MonoidHom.mem_ker, realCliffordSpinBlockHom_apply, MulEquiv.map_eq_one_iff,
    ← MonoidHom.mem_ker,
    mem_ker_spinGroupProd_iff (nondegenerate_realCliffordForm p 0)
      (nondegenerate_realCliffordForm 0 q)]
  obtain ⟨x₁, x₂⟩ := x
  simp only [Prod.mk_eq_one, Prod.mk.injEq, MulEquiv.map_eq_one_iff, ← hneg,
    (realCliffordSpinGroupEquivNeg q 0).injective.eq_iff]

/-- **The kernel of the block homomorphism is generated by `(-1, -1)`**, for positive `p` and
`q`. -/
theorem ker_realCliffordSpinBlockHom :
    (realCliffordSpinBlockHom p q).ker =
      Subgroup.zpowers (spinGroup.negOne (realCliffordForm p 0)
          (nondegenerate_realCliffordForm p 0).ne_zero,
        spinGroup.negOne (realCliffordForm q 0) (nondegenerate_realCliffordForm q 0).ne_zero) := by
  refine le_antisymm (fun x hx ↦ ?_) (Subgroup.zpowers_le.mpr ?_)
  · rcases (mem_ker_realCliffordSpinBlockHom_iff p q x).mp hx with rfl | rfl
    · exact one_mem _
    · exact Subgroup.mem_zpowers _
  · exact (mem_ker_realCliffordSpinBlockHom_iff p q _).mpr (Or.inr rfl)

/-- **The block subgroup of `Spin(p, q)` is `(Spin(p) × Spin(q)) / ⟨(-1, -1)⟩`.** For positive `p`
and `q`, the block homomorphism identifies the quotient of `Spin(p) × Spin(q)` by the subgroup
generated by `(-1, -1)` with its image in `Spin(p, q)`. -/
noncomputable def realCliffordSpinBlockQuotientEquiv :
    (realCliffordSpinGroupZero p × realCliffordSpinGroupZero q) ⧸
        Subgroup.zpowers (spinGroup.negOne (realCliffordForm p 0)
          (nondegenerate_realCliffordForm p 0).ne_zero,
        spinGroup.negOne (realCliffordForm q 0) (nondegenerate_realCliffordForm q 0).ne_zero) ≃*
      (realCliffordSpinBlockHom p q).range :=
  (QuotientGroup.quotientMulEquivOfEq (ker_realCliffordSpinBlockHom p q).symm).trans
    (QuotientGroup.quotientKerEquivRange _)

/-- `realCliffordSpinBlockQuotientEquiv` sends the class of a pair to its image under the block
homomorphism. -/
@[simp]
theorem coe_realCliffordSpinBlockQuotientEquiv_mk
    (x : realCliffordSpinGroupZero p × realCliffordSpinGroupZero q) :
    (realCliffordSpinBlockQuotientEquiv p q x : realCliffordSpinGroup p q) =
      realCliffordSpinBlockHom p q x :=
  (rfl)

end CliffordAlgebra
