/-!
# An elementary abelian subgroup of order sixteen in `Spin(7)` outside tori of rank three

Write `e₀, …, e₆` for the coordinate generators of the Clifford algebra of the negative-definite
form `realCliffordForm 0 7` on `ℝ⁷`, so that `eᵢ² = -1` and `eᵢ eⱼ = -eⱼ eᵢ` for `i ≠ j`. The
three fourfold products

`e₀e₁e₂e₃`, `e₀e₁e₄e₅`, `e₀e₂e₄e₆`

are the basis monomials `e_s` of the supports `s = {0, 1, 2, 3}`, `{0, 1, 4, 5}`, `{0, 2, 4, 6}`
(`CliffordAlgebra.basis_eq_prod_map_sort`). They have even degree and their generators have norm
`-1`, so they are elements of the Spin group (`CliffordAlgebra.basis_mem_spinGroup`). Their
supports pairwise meet in two indices, so they commute, and each squares to `1`. The supports are
independent over `𝔽₂`: together with `∅` the symmetric differences they generate are the eight
supports of `TauCeti.spinSevenSupports`. With the independent central sign `-1`, they therefore
generate an elementary abelian `2`-group `TauCeti.realSpinZeroSevenElementaryAbelian` of order
`16`, consisting of the sixteen signed monomials `±e_s` for those eight supports
(`TauCeti.mem_realSpinZeroSevenElementaryAbelian_iff`).

The isomorphism `CliffordAlgebra.realCliffordSpinGroupEquivNeg 0 7` between the Spin groups of
the negative- and positive-definite forms transports it to the compact Spin group
`realCliffordSpinGroup 7 0`, as `TauCeti.realSpinSevenElementaryAbelian`. A torus
`∀ i, AddCircle (p i)` of rank `r` has at most `2 ^ r` points of order dividing two
(`AddCircle.natCard_torsionBy_pi_le`), while every element of this subgroup squares
to one. So this subgroup of order `16` is not contained in the image of any injective homomorphism
from a torus of rank at most three (`TauCeti.not_realSpinSevenElementaryAbelian_le_range`). Since
the maximal tori of `Spin(7)` have rank three, it follows that the subgroup lies in no torus of
`Spin(7)`, although `Spin(7)` is compact, connected and simply connected; the rank of the maximal
tori is not proved in this file.

## Main definitions

* `TauCeti.spinSevenSupports`: the eight supports `∅` and `{0, 1, 2, 3}`, `{0, 1, 4, 5}`,
  `{0, 2, 4, 6}` together with their symmetric differences.
* `TauCeti.realSpinZeroSevenElementaryAbelian`: the subgroup of the Spin group of
  `realCliffordForm 0 7` generated by `-1` and the three fourfold products.
* `TauCeti.realSpinSevenElementaryAbelian`: its image in the compact Spin group
  `realCliffordSpinGroup 7 0`.

## Main results

* `TauCeti.mem_realSpinZeroSevenElementaryAbelian_iff`: the elements are exactly the signed basis
  monomials `±e_s` with `s ∈ spinSevenSupports`.
* `TauCeti.mul_self_eq_one_of_mem_realSpinZeroSevenElementaryAbelian`,
  `TauCeti.realSpinZeroSevenElementaryAbelian_isMulCommutative`,
  `TauCeti.natCard_realSpinZeroSevenElementaryAbelian`: it is an elementary abelian `2`-group of
  order `16`; `TauCeti.exponent_realSpinZeroSevenElementaryAbelian` records its exponent `2`.
* `TauCeti.not_realSpinSevenElementaryAbelian_le_range`: its image in the compact Spin group lies
  in the image of no injective homomorphism from a torus of rank at most three.

## References

* R. L. Griess, Jr., *Elementary abelian p-subgroups of algebraic groups*, Geometriae Dedicata 39
  (1991), 253–305, for nontoral elementary abelian `2`-subgroups of Spin groups.
* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I, §1–§2.
-/

public section

open scoped symmDiff

open Function

open CliffordAlgebra

namespace TauCeti

/-! ### The supports -/

/-- The eight supports of the elementary abelian subgroup: `∅`, the three supports
`{0, 1, 2, 3}`, `{0, 1, 4, 5}` and `{0, 2, 4, 6}`, and their symmetric differences
`{2, 3, 4, 5}`, `{1, 3, 4, 6}`, `{1, 2, 5, 6}` and `{0, 3, 5, 6}`. -/
def spinSevenSupports : Finset (Finset (Fin (0 + 7))) :=
  {∅, {0, 1, 2, 3}, {0, 1, 4, 5}, {0, 2, 4, 6}, {2, 3, 4, 5}, {1, 3, 4, 6}, {1, 2, 5, 6},
    {0, 3, 5, 6}}

/-- The defining list of the eight supports. -/
theorem spinSevenSupports_def : spinSevenSupports =
    {∅, {0, 1, 2, 3}, {0, 1, 4, 5}, {0, 2, 4, 6}, {2, 3, 4, 5}, {1, 3, 4, 6}, {1, 2, 5, 6},
      {0, 3, 5, 6}} :=
  (rfl)

/-- Membership in the eight supports. -/
theorem mem_spinSevenSupports {s : Finset (Fin (0 + 7))} :
    s ∈ spinSevenSupports ↔ s = ∅ ∨ s = {0, 1, 2, 3} ∨ s = {0, 1, 4, 5} ∨ s = {0, 2, 4, 6} ∨
      s = {2, 3, 4, 5} ∨ s = {1, 3, 4, 6} ∨ s = {1, 2, 5, 6} ∨ s = {0, 3, 5, 6} := by
  simp only [spinSevenSupports_def, Finset.mem_insert, Finset.mem_singleton]

/-- The supports are closed under symmetric difference. -/
theorem symmDiff_mem_spinSevenSupports {s t : Finset (Fin (0 + 7))} (hs : s ∈ spinSevenSupports)
    (ht : t ∈ spinSevenSupports) : s ∆ t ∈ spinSevenSupports := by
  revert s t
  decide +kernel

/-- There are eight supports: the three generating supports are independent over `𝔽₂`. -/
@[simp]
theorem card_spinSevenSupports : spinSevenSupports.card = 8 := by
  decide +kernel

/-- Every support has even cardinality. -/
theorem even_card_of_mem_spinSevenSupports {s : Finset (Fin (0 + 7))}
    (hs : s ∈ spinSevenSupports) : Even s.card := by
  revert s
  decide +kernel

/-- The sign of `e_s * e_s` in `CliffordAlgebra.basis_mul_basis`, together with the sign
`(-1) ^ #s` of the squares of the generators, is `+1` for every support. -/
private theorem square_parity : ∀ s ∈ spinSevenSupports,
    (∑ i ∈ s, (s.filter (· < i)).card + s.card) % 2 = 0 := by
  decide +kernel

/-! ### Signed basis monomials -/

/-- The Spin element `e_s` of an even support `s`. -/
private noncomputable def spinBasis (s : Finset (Fin (0 + 7))) (hs : Even s.card) :
    realCliffordSpinGroup 0 7 :=
  ⟨basis (realCliffordForm 0 7) (Pi.basisFun ℝ (Fin (0 + 7))) s,
    basis_mem_spinGroup (isOrthoᵢ_associated_realCliffordForm 0 7) hs <| by
      simp_rw [Pi.basisFun_apply, realCliffordForm_single_one_of_le (Nat.zero_le _),
        Finset.prod_const, hs.neg_one_pow]⟩

/-- The central element `-1` of the Spin group of `realCliffordForm 0 7`. -/
private noncomputable def spinNegOne : realCliffordSpinGroup 0 7 :=
  spinGroup.negOne _ (nondegenerate_realCliffordForm 0 7).ne_zero

/-- The property of a Spin element of being the signed basis monomial `±e_s`. -/
private def IsSignedBasis (g : realCliffordSpinGroup 0 7) (s : Finset (Fin (0 + 7))) : Prop :=
  (g : CliffordAlgebra (realCliffordForm 0 7)) =
      basis (realCliffordForm 0 7) (Pi.basisFun ℝ (Fin (0 + 7))) s ∨
    (g : CliffordAlgebra (realCliffordForm 0 7)) =
      -basis (realCliffordForm 0 7) (Pi.basisFun ℝ (Fin (0 + 7))) s

/-- The product of `±e_s` and `±e_t` is `±e_{s ∆ t}`. -/
private theorem IsSignedBasis.mul {g h : realCliffordSpinGroup 0 7} {s t : Finset (Fin (0 + 7))}
    (hg : IsSignedBasis g s) (hh : IsSignedBasis h t) : IsSignedBasis (g * h) (s ∆ t) := by
  unfold IsSignedBasis at *
  rw [Submonoid.coe_mul]
  exact mul_eq_or_of_eq_basis_or (isOrthoᵢ_associated_realCliffordForm 0 7)
    (fun i ↦ Or.inr <| by
      rw [Pi.basisFun_apply, realCliffordForm_single_one_of_le (Nat.zero_le _)]) hg hh

/-- A signed basis monomial `±e_s` with `s` a support squares to `1`. -/
private theorem IsSignedBasis.mul_self {g : realCliffordSpinGroup 0 7} {s : Finset (Fin (0 + 7))}
    (hg : IsSignedBasis g s) (hs : s ∈ spinSevenSupports) : g * g = 1 := by
  have hss : basis (realCliffordForm 0 7) (Pi.basisFun ℝ (Fin (0 + 7))) s *
      basis (realCliffordForm 0 7) (Pi.basisFun ℝ (Fin (0 + 7))) s = 1 := by
    simp_rw [basis_mul_basis (isOrthoᵢ_associated_realCliffordForm 0 7), symmDiff_self,
      Finset.bot_eq_empty, basis_empty, Finset.inter_self, Pi.basisFun_apply,
      realCliffordForm_single_one_of_le (Nat.zero_le _), Finset.prod_const]
    rw [← pow_add, neg_one_pow_eq_pow_mod_two, square_parity s hs, pow_zero, one_smul]
  refine Subtype.ext ?_
  rw [Submonoid.coe_mul, OneMemClass.coe_one]
  rcases hg with hg | hg <;> simp only [hg, neg_mul_neg, hss]

/-- Two Spin elements that are signed basis monomials of the same support agree up to `-1`. -/
private theorem IsSignedBasis.eq_or_eq_negOne_mul {g h : realCliffordSpinGroup 0 7}
    {s : Finset (Fin (0 + 7))} (hg : IsSignedBasis g s) (hh : IsSignedBasis h s) :
    g = h ∨ g = spinNegOne * h := by
  unfold IsSignedBasis at hg hh
  simp only [spinNegOne, Subtype.ext_iff, Submonoid.coe_mul, spinGroup.coe_negOne, neg_one_mul]
  rcases hg with hg | hg <;> rcases hh with hh | hh <;> simp [hg, hh]

/-! ### The elementary abelian subgroup -/

/-- **The elementary abelian subgroup of order `16` of `Spin(7)`**, in the Spin group of the
negative-definite form `realCliffordForm 0 7`: the subgroup generated by `-1` and the three
fourfold products `e₀e₁e₂e₃`, `e₀e₁e₄e₅` and `e₀e₂e₄e₆` of coordinate generators. -/
noncomputable def realSpinZeroSevenElementaryAbelian : Subgroup (realCliffordSpinGroup 0 7) :=
  Subgroup.closure {spinNegOne, spinBasis {0, 1, 2, 3} (by decide),
    spinBasis {0, 1, 4, 5} (by decide), spinBasis {0, 2, 4, 6} (by decide)}

/-- Every generator of the subgroup is a signed basis monomial with support in
`spinSevenSupports`. -/
private theorem exists_isSignedBasis_of_mem_generators {g : realCliffordSpinGroup 0 7}
    (hg : g ∈ ({spinNegOne, spinBasis {0, 1, 2, 3} (by decide),
      spinBasis {0, 1, 4, 5} (by decide), spinBasis {0, 2, 4, 6} (by decide)} :
        Set (realCliffordSpinGroup 0 7))) :
    ∃ s ∈ spinSevenSupports, IsSignedBasis g s := by
  rcases hg with rfl | rfl | rfl | rfl
  · exact ⟨∅, by decide, Or.inr (by simp [spinNegOne])⟩
  all_goals exact ⟨_, by decide, Or.inl rfl⟩

/-- Every signed basis monomial whose support lies in `spinSevenSupports` is a product of the
generators. -/
private theorem exists_mem_isSignedBasis {s : Finset (Fin (0 + 7))}
    (hs : s ∈ spinSevenSupports) : ∃ g ∈ realSpinZeroSevenElementaryAbelian, IsSignedBasis g s := by
  -- The supports reached by products of generators contain the generating supports and are
  -- closed under symmetric difference.
  have h₀ : ∃ g ∈ realSpinZeroSevenElementaryAbelian, IsSignedBasis g ∅ :=
    ⟨1, one_mem _, Or.inl (by simp)⟩
  have hmul {t u : Finset (Fin (0 + 7))}
      (ht : ∃ g ∈ realSpinZeroSevenElementaryAbelian, IsSignedBasis g t)
      (hu : ∃ g ∈ realSpinZeroSevenElementaryAbelian, IsSignedBasis g u) :
      ∃ g ∈ realSpinZeroSevenElementaryAbelian, IsSignedBasis g (t ∆ u) := by
    obtain ⟨g, hg, hgt⟩ := ht
    obtain ⟨h, hh, hhu⟩ := hu
    exact ⟨g * h, mul_mem hg hh, hgt.mul hhu⟩
  have hA : ∃ g ∈ realSpinZeroSevenElementaryAbelian, IsSignedBasis g {0, 1, 2, 3} :=
    ⟨spinBasis {0, 1, 2, 3} (by decide), Subgroup.subset_closure (by simp), Or.inl rfl⟩
  have hB : ∃ g ∈ realSpinZeroSevenElementaryAbelian, IsSignedBasis g {0, 1, 4, 5} :=
    ⟨spinBasis {0, 1, 4, 5} (by decide), Subgroup.subset_closure (by simp), Or.inl rfl⟩
  have hC : ∃ g ∈ realSpinZeroSevenElementaryAbelian, IsSignedBasis g {0, 2, 4, 6} :=
    ⟨spinBasis {0, 2, 4, 6} (by decide), Subgroup.subset_closure (by simp), Or.inl rfl⟩
  rw [mem_spinSevenSupports] at hs
  rcases hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h₀
  · exact hA
  · exact hB
  · exact hC
  · have h : ({0, 1, 2, 3} : Finset (Fin (0 + 7))) ∆ {0, 1, 4, 5} = {2, 3, 4, 5} := by decide
    rw [← h]
    exact hmul hA hB
  · have h : ({0, 1, 2, 3} : Finset (Fin (0 + 7))) ∆ {0, 2, 4, 6} = {1, 3, 4, 6} := by decide
    rw [← h]
    exact hmul hA hC
  · have h : ({0, 1, 4, 5} : Finset (Fin (0 + 7))) ∆ {0, 2, 4, 6} = {1, 2, 5, 6} := by decide
    rw [← h]
    exact hmul hB hC
  · have h : ({0, 1, 2, 3} : Finset (Fin (0 + 7))) ∆ {0, 1, 4, 5} ∆ {0, 2, 4, 6} =
        {0, 3, 5, 6} := by
      decide
    rw [← h]
    exact hmul (hmul hA hB) hC

/-- **The elements of the elementary abelian subgroup are the signed basis monomials** `±e_s`,
for the eight supports `s ∈ spinSevenSupports`. -/
theorem mem_realSpinZeroSevenElementaryAbelian_iff {g : realCliffordSpinGroup 0 7} :
    g ∈ realSpinZeroSevenElementaryAbelian ↔ ∃ s ∈ spinSevenSupports,
      (g : CliffordAlgebra (realCliffordForm 0 7)) =
          basis (realCliffordForm 0 7) (Pi.basisFun ℝ (Fin (0 + 7))) s ∨
        (g : CliffordAlgebra (realCliffordForm 0 7)) =
          -basis (realCliffordForm 0 7) (Pi.basisFun ℝ (Fin (0 + 7))) s := by
  refine ⟨fun hg ↦ ?_, fun ⟨s, hs, hgs⟩ ↦ ?_⟩
  · induction hg using Subgroup.closure_induction with
    | mem g hg => exact exists_isSignedBasis_of_mem_generators hg
    | one => exact ⟨∅, by decide, Or.inl (by simp)⟩
    | mul g h _ _ hg hh =>
      obtain ⟨s, hs, hgs⟩ := hg
      obtain ⟨t, ht, hht⟩ := hh
      exact ⟨s ∆ t, symmDiff_mem_spinSevenSupports hs ht, IsSignedBasis.mul hgs hht⟩
    | inv g _ hg =>
      obtain ⟨s, hs, hgs⟩ := hg
      rw [inv_eq_of_mul_eq_one_right (IsSignedBasis.mul_self hgs hs)]
      exact ⟨s, hs, hgs⟩
  · obtain ⟨h, hh, hhs⟩ := exists_mem_isSignedBasis hs
    rcases IsSignedBasis.eq_or_eq_negOne_mul hgs hhs with rfl | rfl
    · exact hh
    · exact mul_mem (Subgroup.subset_closure (by simp)) hh

/-- The central element `-1` lies in the elementary abelian subgroup. -/
theorem negOne_mem_realSpinZeroSevenElementaryAbelian :
    spinGroup.negOne _ (nondegenerate_realCliffordForm 0 7).ne_zero ∈
      realSpinZeroSevenElementaryAbelian :=
  Subgroup.subset_closure (by simp [spinNegOne])

/-- **Every element of the elementary abelian subgroup squares to `1`.** -/
theorem mul_self_eq_one_of_mem_realSpinZeroSevenElementaryAbelian {g : realCliffordSpinGroup 0 7}
    (hg : g ∈ realSpinZeroSevenElementaryAbelian) : g * g = 1 := by
  obtain ⟨s, hs, hgs⟩ := mem_realSpinZeroSevenElementaryAbelian_iff.mp hg
  exact IsSignedBasis.mul_self hgs hs

/-- **The elementary abelian subgroup has order `16`**: its elements are the signed basis
monomials `±e_s` for the eight supports, and these are distinct. -/
@[simp]
theorem natCard_realSpinZeroSevenElementaryAbelian :
    Nat.card realSpinZeroSevenElementaryAbelian = 16 := by
  have hb := isOrthoᵢ_associated_realCliffordForm 0 7
  have hQ (i : Fin (0 + 7)) : realCliffordForm 0 7 (Pi.basisFun ℝ (Fin (0 + 7)) i) = 1 ∨
      realCliffordForm 0 7 (Pi.basisFun ℝ (Fin (0 + 7)) i) = -1 :=
    Or.inr <| by rw [Pi.basisFun_apply, realCliffordForm_single_one_of_le (Nat.zero_le _)]
  -- The signed monomial `u • e_s` of a support `s` and a sign `u`.
  let F : spinSevenSupports × ℤˣ → realCliffordSpinGroup 0 7 := fun p ↦
    (if p.2 = 1 then 1 else spinNegOne) * spinBasis p.1 (even_card_of_mem_spinSevenSupports p.1.2)
  have hF (p : spinSevenSupports × ℤˣ) :
      ((F p : realCliffordSpinGroup 0 7) : CliffordAlgebra (realCliffordForm 0 7)) =
        ((p.2 : ℤ) • basis (realCliffordForm 0 7) (Pi.basisFun ℝ (Fin (0 + 7))) p.1) := by
    rcases Int.units_eq_one_or p.2 with h | h <;> simp [F, h, spinBasis, spinNegOne]
  let f : spinSevenSupports × ℤˣ → realSpinZeroSevenElementaryAbelian := fun p ↦
    ⟨F p, mem_realSpinZeroSevenElementaryAbelian_iff.mpr ⟨p.1, p.1.2, by
      rcases Int.units_eq_one_or p.2 with h | h <;> simp [hF, h]⟩⟩
  have hbij : Bijective f := by
    refine ⟨fun p q hpq ↦ ?_, fun g ↦ ?_⟩
    · have h := congrArg (fun g : realSpinZeroSevenElementaryAbelian ↦
        ((g : realCliffordSpinGroup 0 7) : CliffordAlgebra (realCliffordForm 0 7))) hpq
      simp only [f, hF] at h
      have := (monomialGroupEquiv hb hQ).injective (a₁ := (p.1, p.2)) (a₂ := (q.1, q.2))
        (Subtype.ext (Units.ext (by
          rw [coe_monomialGroupEquiv_apply, coe_monomialGroupEquiv_apply]
          exact h)))
      rw [Prod.mk.injEq] at this
      exact Prod.ext (Subtype.ext this.1) this.2
    · obtain ⟨s, hs, hgs | hgs⟩ := mem_realSpinZeroSevenElementaryAbelian_iff.mp g.2
      · exact ⟨(⟨s, hs⟩, 1), Subtype.ext (Subtype.ext (by rw [hF, hgs]; simp))⟩
      · exact ⟨(⟨s, hs⟩, -1), Subtype.ext (Subtype.ext (by rw [hF, hgs]; simp))⟩
  rw [← Nat.card_congr (Equiv.ofBijective f hbij), Nat.card_prod, Nat.card_eq_fintype_card,
    Fintype.card_coe, card_spinSevenSupports]
  simp

/-- The elementary abelian subgroup is finite. -/
instance finite_realSpinZeroSevenElementaryAbelian : Finite realSpinZeroSevenElementaryAbelian :=
  Nat.finite_of_card_ne_zero (by simp)

/-- **The elementary abelian subgroup has exponent `2`.** -/
@[simp]
theorem exponent_realSpinZeroSevenElementaryAbelian :
    Monoid.exponent realSpinZeroSevenElementaryAbelian = 2 := by
  have hdvd : Monoid.exponent realSpinZeroSevenElementaryAbelian ∣ 2 :=
    Monoid.exponent_dvd_of_forall_pow_eq_one fun g ↦
      Subtype.ext <| by
        rw [pow_two]; exact mul_self_eq_one_of_mem_realSpinZeroSevenElementaryAbelian g.2
  have hne : Monoid.exponent realSpinZeroSevenElementaryAbelian ≠ 1 := by
    rw [Ne, Monoid.exp_eq_one_iff]
    intro h
    have := natCard_realSpinZeroSevenElementaryAbelian
    rw [Nat.card_of_subsingleton (1 : realSpinZeroSevenElementaryAbelian)] at this
    omega
  rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h | h
  · exact absurd h hne
  · exact h

/-- **The elementary abelian subgroup is commutative**, as it has exponent `2`. -/
instance realSpinZeroSevenElementaryAbelian_isMulCommutative :
    IsMulCommutative realSpinZeroSevenElementaryAbelian :=
  ⟨⟨mul_comm_of_exponent_two exponent_realSpinZeroSevenElementaryAbelian⟩⟩

/-! ### The compact Spin group -/

/-- **The elementary abelian subgroup of order `16` in the compact Spin group** `Spin(7)`, the
Spin group of the positive-definite form `realCliffordForm 7 0`: the image of
`TauCeti.realSpinZeroSevenElementaryAbelian` under the isomorphism
`CliffordAlgebra.realCliffordSpinGroupEquivNeg 0 7`. -/
noncomputable def realSpinSevenElementaryAbelian : Subgroup (realCliffordSpinGroup 7 0) :=
  realSpinZeroSevenElementaryAbelian.map (realCliffordSpinGroupEquivNeg 0 7).toMonoidHom

/-- The defining equation of the elementary abelian subgroup of `Spin(7)`. -/
theorem realSpinSevenElementaryAbelian_def : realSpinSevenElementaryAbelian =
    realSpinZeroSevenElementaryAbelian.map (realCliffordSpinGroupEquivNeg 0 7).toMonoidHom :=
  (rfl)

/-- Membership in the elementary abelian subgroup of `Spin(7)`: the preimage under
`CliffordAlgebra.realCliffordSpinGroupEquivNeg 0 7` lies in
`TauCeti.realSpinZeroSevenElementaryAbelian`. -/
theorem mem_realSpinSevenElementaryAbelian_iff {g : realCliffordSpinGroup 7 0} :
    g ∈ realSpinSevenElementaryAbelian ↔
      (realCliffordSpinGroupEquivNeg 0 7).symm g ∈ realSpinZeroSevenElementaryAbelian :=
  Subgroup.mem_map_equiv

/-- Every element of the elementary abelian subgroup of `Spin(7)` squares to `1`. -/
theorem mul_self_eq_one_of_mem_realSpinSevenElementaryAbelian {g : realCliffordSpinGroup 7 0}
    (hg : g ∈ realSpinSevenElementaryAbelian) : g * g = 1 := by
  obtain ⟨h, hh, rfl⟩ := Subgroup.mem_map.mp hg
  rw [← map_mul, mul_self_eq_one_of_mem_realSpinZeroSevenElementaryAbelian hh, map_one]

/-- The elementary abelian subgroup of `Spin(7)` is commutative. -/
instance realSpinSevenElementaryAbelian_isMulCommutative :
    IsMulCommutative realSpinSevenElementaryAbelian :=
  Subgroup.map_isMulCommutative _ _

/-- The elementary abelian subgroup of `Spin(7)` has order `16`. -/
@[simp]
theorem natCard_realSpinSevenElementaryAbelian : Nat.card realSpinSevenElementaryAbelian = 16 := by
  rw [realSpinSevenElementaryAbelian,
    Subgroup.card_map_of_injective (realCliffordSpinGroupEquivNeg 0 7).injective,
    natCard_realSpinZeroSevenElementaryAbelian]

/-- The elementary abelian subgroup of `Spin(7)` is finite. -/
instance finite_realSpinSevenElementaryAbelian : Finite realSpinSevenElementaryAbelian :=
  Nat.finite_of_card_ne_zero (by simp)

/-- The elementary abelian subgroup of `Spin(7)` has exponent `2`. -/
@[simp]
theorem exponent_realSpinSevenElementaryAbelian :
    Monoid.exponent realSpinSevenElementaryAbelian = 2 := by
  rw [realSpinSevenElementaryAbelian, ← Monoid.exponent_eq_of_mulEquiv
    (realSpinZeroSevenElementaryAbelian.equivMapOfInjective _
      (realCliffordSpinGroupEquivNeg 0 7).injective),
    exponent_realSpinZeroSevenElementaryAbelian]

/-- **The elementary abelian subgroup of order `16` of `Spin(7)` lies in no torus of rank at most
three**: it is not contained in the image of any injective homomorphism from a torus
`∀ i, AddCircle (p i)` with at most three circles, since such a torus has at most `8` points of
order dividing `2` (`AddCircle.natCard_torsionBy_pi_le`). -/
theorem not_realSpinSevenElementaryAbelian_le_range {ι : Type*} [Finite ι]
    (hι : Nat.card ι ≤ 3) (p : ι → ℝ)
    (f : Multiplicative (∀ i, AddCircle (p i)) →* realCliffordSpinGroup 7 0) (hf : Injective f) :
    ¬realSpinSevenElementaryAbelian ≤ f.range := by
  intro hle
  have hreg : IsSMulRegular ℝ 2 := .of_right_eq_zero_of_smul fun r h ↦ by simpa using h
  have := AddCircle.finite_torsionBy_pi p hreg
  -- Each element is the image of a point of the torus, which has order dividing `2`.
  have hpre (g : realSpinSevenElementaryAbelian) :
      ∃ x : AddSubgroup.torsionBy (∀ i, AddCircle (p i)) ((2 : ℕ) : ℤ),
        f (Multiplicative.ofAdd x.1) = g := by
    obtain ⟨x, hx⟩ := hle g.2
    refine ⟨⟨x.toAdd, AddSubgroup.torsionBy.nsmul_iff.mpr ?_⟩, by rwa [ofAdd_toAdd]⟩
    have hx2 : f (x * x) = f 1 := by
      rw [map_mul, hx, map_one, mul_self_eq_one_of_mem_realSpinSevenElementaryAbelian g.2]
    rw [two_nsmul, ← toAdd_mul, hf hx2, toAdd_one]
  choose φ hφ using hpre
  have hφinj : Injective φ := fun g h hgh ↦ Subtype.ext (by rw [← hφ g, ← hφ h, hgh])
  have hcard := (Nat.card_le_card_of_injective φ hφinj).trans
    (AddCircle.natCard_torsionBy_pi_le p two_ne_zero hreg)
  rw [natCard_realSpinSevenElementaryAbelian] at hcard
  have : 2 ^ Nat.card ι ≤ 2 ^ 3 := Nat.pow_le_pow_right two_pos hι
  omega

end TauCeti
