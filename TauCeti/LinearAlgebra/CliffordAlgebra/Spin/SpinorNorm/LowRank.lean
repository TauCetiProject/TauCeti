module

public import TauCeti.LinearAlgebra.CliffordAlgebra.Spin.SpinorNorm.Range
public import TauCeti.LinearAlgebra.QuadraticForm.OrthogonalGroup.LowRank
public import TauCeti.LinearAlgebra.QuadraticForm.SpecialOrthogonal.LowRank
import TauCeti.Algebra.Group.Units.Basic

/-!
# Spinor norms in dimension one

For a nondegenerate one-dimensional quadratic space, the special orthogonal group has trivial
spinor norm. The image on the full orthogonal group is generated by the square class of any
nonzero value of the form. In particular, for the form `a * x ^ 2` with `a ≠ 0`, that image is
generated by `[a]`; it is trivial exactly when `a` is a square.

The orthogonal group of such a space is `{1, -1}`, and `-1` is the reflection in every nonzero
vector, so the spinor norm of `-1` is that same class: `[a]` for `Q x = a x²`
(`CliffordAlgebra.orthogonalSpinorNorm_negOrthogonal_smul_sq`). The scalar `a` matters: for
`Q x = x²` the class is trivial, while for `a` a nonsquare the spinor norm of `-1` is
nontrivial (`CliffordAlgebra.orthogonalSpinorNorm_negOrthogonal_smul_sq_eq_one_iff`).

## References

O. T. O'Meara, *Introduction to Quadratic Forms*, §55.
-/

public section

namespace CliffordAlgebra

open TauCeti QuadraticMap

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] [Invertible (2 : K)]

/-- In dimension at most one, the spinor norm on the special orthogonal group is trivial. -/
@[simp]
theorem spinorNorm_eq_one_of_finrank_le_one (Q : QuadraticForm K V)
    (hQ : Q.Nondegenerate) (hV : Module.finrank K V ≤ 1) : spinorNorm Q hQ = 1 := by
  have hbot := specialOrthogonalGroup_eq_bot_of_finrank_le_one Q hV
  ext g
  have hg : g = 1 := Subtype.ext ((Subgroup.eq_bot_iff_forall _).mp hbot g g.2)
  simp [hg]

/-- In dimension one, the orthogonal spinor-norm image is the cyclic subgroup generated by
any invertible value of the form. -/
theorem orthogonalSpinorNorm_range_eq_zpowers_of_finrank_eq_one (Q : QuadraticForm K V)
    (hQ : Q.Nondegenerate) (hV : Module.finrank K V = 1)
    (v : V) [Invertible (Q v)] :
    (orthogonalSpinorNorm Q hQ).range =
      Subgroup.zpowers (squareClassHom (unitOfInvertible (Q v))) := by
  rw [spinorNorm_range_orthogonal_eq_sup Q hQ v,
    spinorNorm_eq_one_of_finrank_le_one Q hQ hV.le]
  simp

/-- The orthogonal spinor norm in dimension one is trivial exactly when any chosen nonzero
value of the quadratic form is a square. -/
theorem orthogonalSpinorNorm_eq_one_iff_isSquare_apply_of_finrank_eq_one (Q : QuadraticForm K V)
    (hQ : Q.Nondegenerate) (hV : Module.finrank K V = 1)
    (v : V) [Invertible (Q v)] :
    orthogonalSpinorNorm Q hQ = 1 ↔ IsSquare (Q v) := by
  refine (MonoidHom.range_eq_bot_iff
    (G := orthogonalGroup Q) (G' := Multiplicative (SquareClassGroup K))
    (f := orthogonalSpinorNorm Q hQ)).symm.trans ?_
  rw [orthogonalSpinorNorm_range_eq_zpowers_of_finrank_eq_one Q hQ hV v, Subgroup.zpowers_eq_bot]
  simp [squareClassHom_apply, ← isSquare_units_val_iff]

/-- In dimension one, `-1` is the reflection in any anisotropic vector `v`, so its spinor norm is
the square class of `Q v`. -/
theorem orthogonalSpinorNorm_negOrthogonal_of_finrank_eq_one (Q : QuadraticForm K V)
    (hQ : Q.Nondegenerate) (hV : Module.finrank K V = 1) (v : V) [Invertible (Q v)] :
    orthogonalSpinorNorm Q hQ (negOrthogonal Q) = squareClassHom (unitOfInvertible (Q v)) := by
  rw [← reflectionOrthogonal_eq_negOrthogonal_of_finrank_eq_one Q v hV,
    orthogonalSpinorNorm_reflectionOrthogonal]

/-- For the form `Q x = a x²` on `K`, the spinor norm of `-1` is the square class of `a`. -/
theorem orthogonalSpinorNorm_negOrthogonal_smul_sq (a : Kˣ) :
    orthogonalSpinorNorm ((a : K) • QuadraticMap.sq) (QuadraticMap.nondegenerate_smul_sq a.ne_zero)
      (negOrthogonal _) = squareClassHom a := by
  let _ : Invertible (((a : K) • QuadraticMap.sq : QuadraticForm K K) 1) :=
    invertibleOfNonzero (by simp)
  rw [orthogonalSpinorNorm_negOrthogonal_of_finrank_eq_one _ _ (Module.finrank_self K) 1]
  congr 1
  exact Units.ext (by simp)

/-- For the form `Q x = a x²` on `K`, the spinor norm of `-1` is trivial exactly when `a` is a
square. With `a` a nonsquare, this is the dimension-one check that the spinor norm detects `-1`. -/
theorem orthogonalSpinorNorm_negOrthogonal_smul_sq_eq_one_iff (a : Kˣ) :
    orthogonalSpinorNorm ((a : K) • QuadraticMap.sq) (QuadraticMap.nondegenerate_smul_sq a.ne_zero)
      (negOrthogonal _) = 1 ↔ IsSquare (a : K) := by
  rw [orthogonalSpinorNorm_negOrthogonal_smul_sq]
  simp [squareClassHom_apply, ← isSquare_units_val_iff]

end CliffordAlgebra
