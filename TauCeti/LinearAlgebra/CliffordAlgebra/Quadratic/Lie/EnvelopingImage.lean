namespace CliffordAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing

section Image

variable (K : Type u) (L : Type v) [Field K] [LieRing L] [LieAlgebra K L]
  [FiniteDimensional K L] [Invertible (2 : K)] [_root_.LieAlgebra.IsKilling K L]

/-- **The image of the enveloping algebra in the Clifford algebra of the Killing form**: the range
of the algebra homomorphism `U(L) → Cl(L, κ)` extending the adjoint quadratic lift
`CliffordAlgebra.adjointCliffordHom`. -/
noncomputable def adjointEnvelopingImage :
    Subalgebra K (CliffordAlgebra (killingQuadraticForm K L)) :=
  (_root_.UniversalEnvelopingAlgebra.lift K (adjointCliffordHom K L)).range

/-- The image of the enveloping algebra is the range of the lift of the adjoint quadratic lift. -/
theorem adjointEnvelopingImage_def :
    adjointEnvelopingImage K L =
      (_root_.UniversalEnvelopingAlgebra.lift K (adjointCliffordHom K L)).range :=
  (rfl)

variable {K L} in
/-- The elements of the image of the enveloping algebra are the images of elements of `U(L)`. -/
theorem mem_adjointEnvelopingImage_iff {c : CliffordAlgebra (killingQuadraticForm K L)} :
    c ∈ adjointEnvelopingImage K L ↔
      ∃ u, _root_.UniversalEnvelopingAlgebra.lift K (adjointCliffordHom K L) u = c := by
  rw [adjointEnvelopingImage_def, AlgHom.mem_range]

variable {K L} in
/-- The image of every element of `U(L)` lies in the image of the enveloping algebra. -/
@[simp]
theorem lift_mem_adjointEnvelopingImage (u : _root_.UniversalEnvelopingAlgebra K L) :
    _root_.UniversalEnvelopingAlgebra.lift K (adjointCliffordHom K L) u ∈
      adjointEnvelopingImage K L :=
  mem_adjointEnvelopingImage_iff.2 ⟨u, rfl⟩

variable {K L} in
/-- The quadratic lift of every element of `L` lies in the image of the enveloping algebra. Not a
`simp` lemma: `CliffordAlgebra.adjointCliffordHom_apply` rewrites its left-hand side. -/
theorem adjointCliffordHom_mem_adjointEnvelopingImage (x : L) :
    adjointCliffordHom K L x ∈ adjointEnvelopingImage K L :=
  mem_adjointEnvelopingImage_iff.2
    ⟨_root_.UniversalEnvelopingAlgebra.ι K x, _root_.UniversalEnvelopingAlgebra.lift_ι_apply K _ x⟩

/-- **The image of the enveloping algebra is generated by the quadratic lift** of the adjoint
representation. -/
theorem adjointEnvelopingImage_eq_adjoin :
    adjointEnvelopingImage K L = Algebra.adjoin K (Set.range (adjointCliffordHom K L)) := by
  rw [adjointEnvelopingImage_def, range_lift_eq_adjoin]

/-- **The image of the enveloping algebra lies in the even Clifford algebra**, because the
quadratic elements do. -/
theorem adjointEnvelopingImage_le_even :
    adjointEnvelopingImage K L ≤ even (killingQuadraticForm K L) := by
  rw [adjointEnvelopingImage_def, range_lift_le_iff]
  intro x
  rw [adjointCliffordHom_apply]
  exact quadraticLieSubalgebra_le_even _ (Subtype.property _)

variable {K L} in
/-- **The commutant of the image of the enveloping algebra**: a Clifford element commutes with
every element of the image exactly when its commutator with every quadratic element `q x`
vanishes, that is, when it is invariant under the commutator action
(`CliffordAlgebra.mem_centralizer_adjointEnvelopingImage_iff_mem_maxTrivSubmodule`). -/
theorem mem_centralizer_adjointEnvelopingImage_iff
    {c : CliffordAlgebra (killingQuadraticForm K L)} :
    c ∈ Subalgebra.centralizer K
        (adjointEnvelopingImage K L : Set (CliffordAlgebra (killingQuadraticForm K L))) ↔
      ∀ x : L, ⁅adjointCliffordHom K L x, c⁆ = 0 := by
  simp only [adjointEnvelopingImage_def, mem_centralizer_range_lift_iff, Ring.lie_def,
    sub_eq_zero]

open scoped CliffordAlgebra.Commutator in
variable {K L} in
/-- **The commutant of the image of the enveloping algebra is the invariant Clifford algebra**:
an element commutes with the image of `U(L)` exactly when it is invariant under the commutator
action `⁅x, c⁆ = ⁅q x, c⁆` of `CliffordAlgebra.Commutator.instLieRingModule`. -/
theorem mem_centralizer_adjointEnvelopingImage_iff_mem_maxTrivSubmodule
    {c : CliffordAlgebra (killingQuadraticForm K L)} :
    c ∈ Subalgebra.centralizer K
        (adjointEnvelopingImage K L : Set (CliffordAlgebra (killingQuadraticForm K L))) ↔
      c ∈ maxTrivSubmodule K L (CliffordAlgebra (killingQuadraticForm K L)) := by
  simp only [mem_centralizer_adjointEnvelopingImage_iff, mem_maxTrivSubmodule, commutator_lie_def]

end Image

section Kostant

variable {K : Type u} [Field K] {L : Type v} [LieRing L] [LieAlgebra K L]
  [FiniteDimensional K L] [Invertible (2 : K)] [_root_.LieAlgebra.IsKilling K L]

variable [CharZero K] [IsAlgClosed K] {H : LieSubalgebra K L} [H.IsCartanSubalgebra]
  (base : (IsKilling.rootSystem H).Base)

/-- **The kernel of `U(L) → Cl(L, κ)` is the annihilator of `L(ρ)`.** Kostant's module is a direct
sum of a positive number of copies of `L(ρ)`, so it has the same annihilator as `L(ρ)`. -/
theorem ker_lift_adjointCliffordHom_eq_ker_representation_irreducibleQuotient :
    RingHom.ker (_root_.UniversalEnvelopingAlgebra.lift K (adjointCliffordHom K L)) =
      RingHom.ker (representation K L
        (irreducibleQuotient base (weylVector (IsKilling.rootSystem H) base))) := by
  obtain ⟨e⟩ := nonempty_lieModuleEquiv_directSum_irreducibleQuotient_weylVector_kostant base
  have : Nonempty (Fin (2 ^ ((finrank K L + LieAlgebra.rank K L) / 2))) :=
    ⟨⟨0, Nat.two_pow_pos _⟩⟩
  rw [ker_lift_adjointCliffordHom_eq_ker_representation_kostant,
    e.ker_representation_eq, ker_representation_directSum, iInf_const]

/-- **Kostant's identification `A ≃ End(L(ρ))`.** The image of the enveloping algebra in the
Clifford algebra of the Killing form is isomorphic, as an algebra, to the algebra of linear
endomorphisms of the irreducible module of highest weight `ρ`: both are the quotient of `U(L)` by
the annihilator of `L(ρ)`. -/
noncomputable def adjointEnvelopingImageEquivEnd :
    adjointEnvelopingImage K L ≃ₐ[K]
      Module.End K (irreducibleQuotient base (weylVector (IsKilling.rootSystem H) base)) :=
  (Subalgebra.equivOfEq _ _ (adjointEnvelopingImage_def K L)).trans <|
    (Ideal.quotientKerEquivRange _).symm.trans <|
      (Ideal.quotientEquivAlgOfEq K
        (ker_lift_adjointCliffordHom_eq_ker_representation_irreducibleQuotient base)).trans <|
        -- Jacobson density: `U(L)` realizes every linear endomorphism of `L(ρ)`.
        Ideal.quotientKerAlgEquivOfSurjective
          (have := finiteDimensional_irreducibleQuotient_weylVector base
          (isHighestWeightVector_irreducibleQuotientGenerator base _).representation_surjective)

/-- **The identification `A ≃ End(L(ρ))` is compatible with the actions of `U(L)`**: it sends the
image of `u ∈ U(L)` in the Clifford algebra to the action of `u` on `L(ρ)`. -/
@[simp]
theorem adjointEnvelopingImageEquivEnd_apply (u : _root_.UniversalEnvelopingAlgebra K L) :
    adjointEnvelopingImageEquivEnd base
        ⟨_root_.UniversalEnvelopingAlgebra.lift K (adjointCliffordHom K L) u,
          lift_mem_adjointEnvelopingImage u⟩ =
      representation K L
        (irreducibleQuotient base (weylVector (IsKilling.rootSystem H) base)) u := by
  have h : (Ideal.quotientKerEquivRange
      (_root_.UniversalEnvelopingAlgebra.lift K (adjointCliffordHom K L))).symm
        ⟨_, lift_mem_adjointEnvelopingImage u⟩ = Ideal.Quotient.mk _ u := by
    rw [AlgEquiv.symm_apply_eq]
    ext
    simp [Ideal.quotientKerEquivRange]
  simp [adjointEnvelopingImageEquivEnd, h]

/-- The inverse of `A ≃ End(L(ρ))` sends the action of `u ∈ U(L)` on `L(ρ)` to the image of `u` in
the Clifford algebra. -/
@[simp]
theorem coe_adjointEnvelopingImageEquivEnd_symm_representation
    (u : _root_.UniversalEnvelopingAlgebra K L) :
    ((adjointEnvelopingImageEquivEnd base).symm (representation K L
        (irreducibleQuotient base (weylVector (IsKilling.rootSystem H) base)) u) :
          CliffordAlgebra (killingQuadraticForm K L)) =
      _root_.UniversalEnvelopingAlgebra.lift K (adjointCliffordHom K L) u := by
  rw [← adjointEnvelopingImageEquivEnd_apply base u, AlgEquiv.symm_apply_apply]

end Kostant

section Dimension

variable (K : Type u) [Field K] [CharZero K] [IsAlgClosed K] (L : Type v) [LieRing L]
  [LieAlgebra K L] [FiniteDimensional K L] [Invertible (2 : K)] [_root_.LieAlgebra.IsKilling K L]

/-- **The image of the enveloping algebra has dimension `2 ^ (d - l)`** in the Clifford algebra of
dimension `2 ^ d`, for `L` of dimension `d` and rank `l`. -/
theorem finrank_adjointEnvelopingImage :
    finrank K (adjointEnvelopingImage K L) = 2 ^ (finrank K L - LieAlgebra.rank K L) := by
  obtain ⟨H, _, ⟨b⟩⟩ := exists_isCartanSubalgebra_base K L
  rw [(adjointEnvelopingImageEquivEnd b).toLinearEquiv.finrank_eq,
    finrank_end_irreducibleQuotient_weylVector b]

variable {K L} in
/-- **In dimension three the image of the enveloping algebra has dimension four**, half of the
eight-dimensional Clifford algebra: this is `2 ^ (d - l)` at `d = 3` and `l = 1`. -/
theorem finrank_adjointEnvelopingImage_of_finrank_eq_three (h : finrank K L = 3) :
    finrank K (adjointEnvelopingImage K L) = 4 := by
  rw [finrank_adjointEnvelopingImage, h, rank_eq_one_of_finrank_eq_three h]
  rfl

open _root_.LieAlgebra.SpecialLinear in
/-- **For `𝔰𝔩₂` the image of the enveloping algebra has dimension four**, the dimension of
`End(L(ρ))` for the two-dimensional module `L(ρ)`, inside the eight-dimensional Clifford
algebra. -/
theorem finrank_adjointEnvelopingImage_sl_fin_two :
    finrank K (adjointEnvelopingImage K (sl (Fin 2) K)) = 4 :=
  finrank_adjointEnvelopingImage_of_finrank_eq_three (by simp [finrank_sl])

end Dimension

end CliffordAlgebra
