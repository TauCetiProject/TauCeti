/-!
# Positivity and faithfulness of the complexified Clifford scalar trace

Let `Q` be a quadratic form on a real vector space `V`, and let `τ` be the scalar part
`CliffordAlgebra.scalarTrace` of the complexified Clifford algebra `Cℓ(ℂ ⊗ V, Q_ℂ)`. This file
proves that the two conjugate-linear Clifford adjoints of `Cℓ(ℂ ⊗ V, Q_ℂ)` turn `τ` into a positive
Hermitian form for the appropriate sign of `Q`:

* the **positive-form adjoint** `x ↦ complexConj (reverse x)`, complex conjugation of the
  coefficients after reversal, for which `τ(x^* x) ≥ 0` when `Q` is positive semidefinite;
* the **negative-metric adjoint** `CliffordAlgebra.conjStar`, complex conjugation after Clifford
  conjugation `star = reverse ∘ involute`, for which `τ(x^* x) ≥ 0` when `Q` is negative
  semidefinite. This is the adjoint for the geometric convention `Q v = -g (v, v)`, for which a
  `*`-representation makes Clifford multiplication by a real vector skew-Hermitian.

Both statements come from one coordinate formula. A real basis `b` of `V` orthogonal for `Q` has an
ordered-product Clifford basis `e_s` for the base-changed basis `1 ⊗ b`, and the `e_s` are fixed by
`complexConj` because they are products of real vectors. So the coordinates of `complexConj x` are
the complex conjugates of those of `x`, and the real trace-pairing computation
`CliffordAlgebra.scalarTrace_reverse_mul` gives

  `τ(complexConj (reverse x) * y) = ∑ₛ conj xₛ * (∏ i ∈ s, Q (b i)) * yₛ`.

The grade involution multiplies the coordinate at `s` by `(-1) ^ |s|`, which replaces the weights
by `∏ i ∈ s, -Q (b i)` for `conjStar`. The diagonal values are therefore
`∑ₛ |xₛ|² ∏ i ∈ s, (±Q (b i))`: real, nonnegative for a semidefinite form of the right sign, and
zero exactly when `x` lies in the two-sided ideal generated by the radical of `Q_ℂ`. In particular
the Hermitian form is faithful exactly when `Q`, respectively `-Q`, is positive definite: a nonzero
real vector `v` with `Q v ≤ 0`, respectively `Q v ≥ 0`, gives the nonzero real Clifford element
`√|Q v| + ι v` of zero trace norm.

The coordinate formulas hold for every real quadratic form and every orthogonal basis, of any
index type, including degenerate and indefinite forms. The intrinsic statements assume `V`
finite-dimensional so that an orthogonal basis exists; rank zero is included. The negative-metric
statements are also transported to the tensor carrier `ℂ ⊗[ℝ] Cℓ(V, Q)`, where `conjStar` is the
tensor-product `star` (`CliffordAlgebra.toBaseChange_conjStar`) and the trace is
`Module.Dual.baseChange ℂ (scalarTrace Q)`.

## Main results

* `CliffordAlgebra.basis_repr_complexConj`: in a real orthogonal basis, the coordinates of
  `complexConj x` are the conjugates of the coordinates of `x`.
* `CliffordAlgebra.scalarTrace_complexConj_reverse_mul` and
  `CliffordAlgebra.scalarTrace_conjStar_mul`: the two sesquilinear trace pairings in coordinates.
* `CliffordAlgebra.scalarTrace_complexConj_reverse_mul_self` and
  `CliffordAlgebra.scalarTrace_conjStar_mul_self`: the weighted sums of squared absolute values.
* `CliffordAlgebra.scalarTrace_complexConj_reverse_mul_self_nonneg` and
  `CliffordAlgebra.scalarTrace_conjStar_mul_self_nonneg`: positivity for semidefinite forms.
* `CliffordAlgebra.scalarTrace_complexConj_reverse_mul_self_eq_zero_iff_basis_repr_eq_zero` and
  `CliffordAlgebra.scalarTrace_conjStar_mul_self_eq_zero_iff_basis_repr_eq_zero`: the null set of
  a semidefinite form in coordinates.
* `CliffordAlgebra.scalarTrace_complexConj_reverse_mul_self_eq_zero_iff_mem_span_radical` and
  `CliffordAlgebra.scalarTrace_conjStar_mul_self_eq_zero_iff_mem_span_radical`: the null set of a
  semidefinite form is the ideal generated by the radical.
* `CliffordAlgebra.posDef_iff_forall_scalarTrace_reverse_mul_self_eq_zero`: on the real Clifford
  algebra, the trace norm `τ (reverse x * x)` is faithful exactly for positive definite `Q`.
* `CliffordAlgebra.posDef_iff_forall_scalarTrace_complexConj_reverse_mul_self_eq_zero` and
  `CliffordAlgebra.posDef_neg_iff_forall_scalarTrace_conjStar_mul_self_eq_zero`: faithfulness is
  equivalent to definiteness of the right sign.
* `CliffordAlgebra.baseChange_scalarTrace_star_mul_self_nonneg` and
  `CliffordAlgebra.baseChange_scalarTrace_star_mul_self_eq_zero_iff`: the negative-metric
  statements on the tensor carrier.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I, §1 and §5.
-/

public section

open scoped TensorProduct ComplexConjugate ComplexOrder

namespace CliffordAlgebra

variable {V : Type*} [AddCommGroup V] [Module ℝ V] {Q : QuadraticForm ℝ V}

/-! ### Real elements of zero trace norm -/

/-- A nonzero real vector `v` with `Q v ≤ 0` gives the nonzero Clifford element `√(-Q v) + ι v`,
which pairs to zero with itself under `(x, y) ↦ τ (reverse x * y)`. -/
theorem exists_ne_zero_scalarTrace_reverse_mul_self_eq_zero {v : V} (hv : v ≠ 0) (hQ : Q v ≤ 0) :
    ∃ y : CliffordAlgebra Q, y ≠ 0 ∧ scalarTrace Q (reverse y * y) = 0 := by
  refine ⟨algebraMap ℝ _ √(-Q v) + ι Q v, fun hy ↦ hv ?_, ?_⟩
  · simpa using congrArg (ιInv Q) hy
  · have hsq : √(-Q v) * √(-Q v) = -Q v := Real.mul_self_sqrt (neg_nonneg.mpr hQ)
    simp [Algebra.algebraMap_eq_smul_one, add_mul, mul_add, hsq]

/-- A nonzero real vector `v` with `0 ≤ Q v` gives the nonzero Clifford element `√(Q v) + ι v`,
which pairs to zero with itself under `(x, y) ↦ τ (star x * y)`. -/
theorem exists_ne_zero_scalarTrace_star_mul_self_eq_zero {v : V} (hv : v ≠ 0) (hQ : 0 ≤ Q v) :
    ∃ y : CliffordAlgebra Q, y ≠ 0 ∧ scalarTrace Q (star y * y) = 0 := by
  refine ⟨algebraMap ℝ _ √(Q v) + ι Q v, fun hy ↦ hv ?_, ?_⟩
  · simpa using congrArg (ιInv Q) hy
  · have hsq : √(Q v) * √(Q v) = Q v := Real.mul_self_sqrt hQ
    simp [Algebra.algebraMap_eq_smul_one, add_mul, mul_add, hsq]

/-! ### Coordinates in a real orthogonal basis -/

section Basis

variable {I : Type*} [LinearOrder I] {b : Module.Basis I ℝ V}

/-- The ordered-product Clifford basis of the base change of a real orthogonal basis is fixed by
complex conjugation of the coefficients. -/
theorem complexConj_basis_baseChange (hb : (QuadraticMap.associated Q).IsOrthoᵢ b)
    (s : Finset I) :
    complexConj Q (basis (Q.baseChange ℂ) (b.baseChange ℂ) s) =
      basis (Q.baseChange ℂ) (b.baseChange ℂ) s := by
  rw [basis_eq_prod_map_sort (QuadraticForm.isOrthoᵢ_associated_baseChange hb), map_list_prod]
  simp [List.map_map, Function.comp_def]

/-- In the ordered-product Clifford basis of a real orthogonal basis, the coordinates of
`complexConj x` are the complex conjugates of those of `x`. -/
theorem basis_repr_complexConj (hb : (QuadraticMap.associated Q).IsOrthoᵢ b)
    (x : CliffordAlgebra (Q.baseChange ℂ)) (s : Finset I) :
    (basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr (complexConj Q x) s =
      conj ((basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr x s) := by
  have hx : complexConj Q x = Finsupp.linearCombination ℂ (basis (Q.baseChange ℂ) (b.baseChange ℂ))
      (Finsupp.mapRange conj (map_zero _) ((basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr x)) := by
    conv_lhs => rw [← (basis (Q.baseChange ℂ) (b.baseChange ℂ)).linearCombination_repr x]
    simp only [Finsupp.linearCombination_apply, map_finsuppSum, complexConj_smul,
      complexConj_basis_baseChange hb]
    exact (Finsupp.sum_mapRange_index
      (h := fun s z ↦ z • basis (Q.baseChange ℂ) (b.baseChange ℂ) s) fun _ ↦ zero_smul ℂ _).symm
  rw [hx, Module.Basis.repr_linearCombination, Finsupp.mapRange_apply]

/-- **The positive-form sesquilinear trace pairing in coordinates.** For a real basis `b`
orthogonal for `Q`, `τ(complexConj (reverse x) * y) = ∑ₛ conj xₛ * (∏ i ∈ s, Q (b i)) * yₛ`,
the sum running over the support of the coordinates of `x`. -/
theorem scalarTrace_complexConj_reverse_mul (hb : (QuadraticMap.associated Q).IsOrthoᵢ b)
    (x y : CliffordAlgebra (Q.baseChange ℂ)) :
    scalarTrace (Q.baseChange ℂ) (complexConj Q (reverse x) * y) =
      ((basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr x).sum fun s z ↦
        conj z * (((∏ i ∈ s, Q (b i) : ℝ) : ℂ) *
          (basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr y s) := by
  have hrepr : (basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr (complexConj Q x) =
      Finsupp.mapRange conj (map_zero _) ((basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr x) :=
    Finsupp.ext fun s ↦ basis_repr_complexConj hb x s
  rw [complexConj_reverse,
    scalarTrace_reverse_mul (QuadraticForm.isOrthoᵢ_associated_baseChange hb), hrepr,
    Finsupp.sum_mapRange_index fun _ ↦ zero_mul _]
  simp only [QuadraticForm.baseChange_apply_basis_baseChange, Complex.coe_algebraMap,
    Complex.ofReal_prod]

/-- **The negative-metric sesquilinear trace pairing in coordinates.** For a real basis `b`
orthogonal for `Q`, `τ(conjStar x * y) = ∑ₛ conj xₛ * (∏ i ∈ s, -Q (b i)) * yₛ`, the sum running
over the support of the coordinates of `x`. -/
theorem scalarTrace_conjStar_mul (hb : (QuadraticMap.associated Q).IsOrthoᵢ b)
    (x y : CliffordAlgebra (Q.baseChange ℂ)) :
    scalarTrace (Q.baseChange ℂ) (conjStar Q x * y) =
      ((basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr x).sum fun s z ↦
        conj z * (((∏ i ∈ s, -Q (b i) : ℝ) : ℂ) *
          (basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr y s) := by
  have hb' := QuadraticForm.isOrthoᵢ_associated_baseChange (A := ℂ) hb
  have hsupp : ((basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr (involute x)).support =
      ((basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr x).support := by
    ext s
    simp [basis_repr_involute hb']
  rw [conjStar_apply, star_def, scalarTrace_complexConj_reverse_mul hb, Finsupp.sum, hsupp,
    Finsupp.sum]
  refine Finset.sum_congr rfl fun s _ ↦ ?_
  rw [basis_repr_involute hb', Finset.prod_neg, map_mul]
  push_cast
  simp only [map_pow, map_neg, map_one]
  ring

/-- **The positive-form trace norm in coordinates**: `τ(complexConj (reverse x) * x)` is the real
number `∑ₛ |xₛ|² ∏ i ∈ s, Q (b i)`. -/
theorem scalarTrace_complexConj_reverse_mul_self (hb : (QuadraticMap.associated Q).IsOrthoᵢ b)
    (x : CliffordAlgebra (Q.baseChange ℂ)) :
    scalarTrace (Q.baseChange ℂ) (complexConj Q (reverse x) * x) =
      (((basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr x).sum fun s z ↦
        Complex.normSq z * ∏ i ∈ s, Q (b i) : ℝ) := by
  rw [scalarTrace_complexConj_reverse_mul hb, Finsupp.ofReal_sum_normSq_mul]

/-- **The negative-metric trace norm in coordinates**: `τ(conjStar x * x)` is the real number
`∑ₛ |xₛ|² ∏ i ∈ s, -Q (b i)`. -/
theorem scalarTrace_conjStar_mul_self (hb : (QuadraticMap.associated Q).IsOrthoᵢ b)
    (x : CliffordAlgebra (Q.baseChange ℂ)) :
    scalarTrace (Q.baseChange ℂ) (conjStar Q x * x) =
      (((basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr x).sum fun s z ↦
        Complex.normSq z * ∏ i ∈ s, -Q (b i) : ℝ) := by
  rw [scalarTrace_conjStar_mul hb, Finsupp.ofReal_sum_normSq_mul]

/-- **Positivity of the positive-form trace norm**: if `Q` is nonnegative on a real orthogonal
basis, then `τ(complexConj (reverse x) * x) ≥ 0`, in particular it is real. -/
theorem scalarTrace_complexConj_reverse_mul_self_nonneg_of_isOrtho
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b) (hQ : ∀ i, 0 ≤ Q (b i))
    (x : CliffordAlgebra (Q.baseChange ℂ)) :
    0 ≤ scalarTrace (Q.baseChange ℂ) (complexConj Q (reverse x) * x) := by
  rw [scalarTrace_complexConj_reverse_mul_self hb, Complex.zero_le_real]
  exact Finsupp.sum_normSq_mul_nonneg _ fun s ↦ Finset.prod_nonneg fun i _ ↦ hQ i

/-- **Positivity of the negative-metric trace norm**: if `Q` is nonpositive on a real orthogonal
basis, then `τ(conjStar x * x) ≥ 0`, in particular it is real. -/
theorem scalarTrace_conjStar_mul_self_nonneg_of_isOrtho
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b) (hQ : ∀ i, Q (b i) ≤ 0)
    (x : CliffordAlgebra (Q.baseChange ℂ)) :
    0 ≤ scalarTrace (Q.baseChange ℂ) (conjStar Q x * x) := by
  rw [scalarTrace_conjStar_mul_self hb, Complex.zero_le_real]
  exact Finsupp.sum_normSq_mul_nonneg _ fun s ↦ Finset.prod_nonneg fun i _ ↦ neg_nonneg.mpr (hQ i)

/-- **Null vectors of the positive-form trace norm in coordinates**: if `Q` is nonnegative on a
real orthogonal basis, then `τ(complexConj (reverse x) * x) = 0` exactly when the coordinates of
`x` vanish at every monomial of nonzero quadratic weight. -/
theorem scalarTrace_complexConj_reverse_mul_self_eq_zero_iff_basis_repr_eq_zero
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b) (hQ : ∀ i, 0 ≤ Q (b i))
    {x : CliffordAlgebra (Q.baseChange ℂ)} :
    scalarTrace (Q.baseChange ℂ) (complexConj Q (reverse x) * x) = 0 ↔
      ∀ s : Finset I, (∏ i ∈ s, Q (b i)) ≠ 0 →
        (basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr x s = 0 := by
  rw [scalarTrace_complexConj_reverse_mul_self hb, Complex.ofReal_eq_zero,
    Finsupp.sum_normSq_mul_eq_zero_iff _ fun s ↦ Finset.prod_nonneg fun i _ ↦ hQ i]

/-- **Null vectors of the negative-metric trace norm in coordinates**: if `Q` is nonpositive on a
real orthogonal basis, then `τ(conjStar x * x) = 0` exactly when the coordinates of `x` vanish at
every monomial of nonzero quadratic weight. -/
theorem scalarTrace_conjStar_mul_self_eq_zero_iff_basis_repr_eq_zero
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b) (hQ : ∀ i, Q (b i) ≤ 0)
    {x : CliffordAlgebra (Q.baseChange ℂ)} :
    scalarTrace (Q.baseChange ℂ) (conjStar Q x * x) = 0 ↔
      ∀ s : Finset I, (∏ i ∈ s, -Q (b i)) ≠ 0 →
        (basis (Q.baseChange ℂ) (b.baseChange ℂ)).repr x s = 0 := by
  rw [scalarTrace_conjStar_mul_self hb, Complex.ofReal_eq_zero,
    Finsupp.sum_normSq_mul_eq_zero_iff _ fun s ↦
      Finset.prod_nonneg fun i _ ↦ neg_nonneg.mpr (hQ i)]

/-- The positive-form trace norm vanishes exactly on the ideal generated by the radical of
`Q_ℂ`, when `Q` is nonnegative on a real orthogonal basis. -/
theorem scalarTrace_complexConj_reverse_mul_self_eq_zero_iff_mem_span_radical_of_isOrtho
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b) (hQ : ∀ i, 0 ≤ Q (b i))
    (x : CliffordAlgebra (Q.baseChange ℂ)) :
    scalarTrace (Q.baseChange ℂ) (complexConj Q (reverse x) * x) = 0 ↔
      x ∈ TwoSidedIdeal.span
        (ι (Q.baseChange ℂ) '' ((Q.baseChange ℂ).radical : Set (ℂ ⊗[ℝ] V))) := by
  rw [mem_span_radical_iff_basis_repr_eq_zero (QuadraticForm.isOrthoᵢ_associated_baseChange hb),
    scalarTrace_complexConj_reverse_mul_self_eq_zero_iff_basis_repr_eq_zero hb hQ]
  simp only [QuadraticForm.baseChange_apply_basis_baseChange, Complex.coe_algebraMap,
    ← Complex.ofReal_prod, ne_eq, Complex.ofReal_eq_zero]

/-- The negative-metric trace norm vanishes exactly on the ideal generated by the radical of
`Q_ℂ`, when `Q` is nonpositive on a real orthogonal basis. -/
theorem scalarTrace_conjStar_mul_self_eq_zero_iff_mem_span_radical_of_isOrtho
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b) (hQ : ∀ i, Q (b i) ≤ 0)
    (x : CliffordAlgebra (Q.baseChange ℂ)) :
    scalarTrace (Q.baseChange ℂ) (conjStar Q x * x) = 0 ↔
      x ∈ TwoSidedIdeal.span
        (ι (Q.baseChange ℂ) '' ((Q.baseChange ℂ).radical : Set (ℂ ⊗[ℝ] V))) := by
  rw [mem_span_radical_iff_basis_repr_eq_zero (QuadraticForm.isOrthoᵢ_associated_baseChange hb),
    scalarTrace_conjStar_mul_self_eq_zero_iff_basis_repr_eq_zero hb hQ]
  simp only [QuadraticForm.baseChange_apply_basis_baseChange, Complex.coe_algebraMap,
    ← Complex.ofReal_prod, ne_eq, Complex.ofReal_eq_zero, Finset.prod_neg, mul_eq_zero,
    pow_eq_zero_iff', neg_eq_zero, one_ne_zero, false_and, false_or]

end Basis

/-! ### Intrinsic statements -/

section FiniteDimensional

variable [FiniteDimensional ℝ V]

/-- **Positivity of the positive-form trace norm** on the complexified Clifford algebra of a
positive semidefinite real quadratic form. -/
theorem scalarTrace_complexConj_reverse_mul_self_nonneg (hQ : ∀ v, 0 ≤ Q v)
    (x : CliffordAlgebra (Q.baseChange ℂ)) :
    0 ≤ scalarTrace (Q.baseChange ℂ) (complexConj Q (reverse x) * x) := by
  obtain ⟨b, hb⟩ := LinearMap.BilinForm.exists_orthogonal_basis
    (B := QuadraticMap.associated Q) (QuadraticForm.associated_isSymm ℝ Q)
  exact scalarTrace_complexConj_reverse_mul_self_nonneg_of_isOrtho hb (fun i ↦ hQ (b i)) x

/-- **Positivity of the negative-metric trace norm** on the complexified Clifford algebra of a
negative semidefinite real quadratic form. -/
theorem scalarTrace_conjStar_mul_self_nonneg (hQ : ∀ v, Q v ≤ 0)
    (x : CliffordAlgebra (Q.baseChange ℂ)) :
    0 ≤ scalarTrace (Q.baseChange ℂ) (conjStar Q x * x) := by
  obtain ⟨b, hb⟩ := LinearMap.BilinForm.exists_orthogonal_basis
    (B := QuadraticMap.associated Q) (QuadraticForm.associated_isSymm ℝ Q)
  exact scalarTrace_conjStar_mul_self_nonneg_of_isOrtho hb (fun i ↦ hQ (b i)) x

/-- For a positive semidefinite real quadratic form, the null set of the positive-form trace norm
on the complexified Clifford algebra is the two-sided ideal generated by the radical of `Q_ℂ`. -/
theorem scalarTrace_complexConj_reverse_mul_self_eq_zero_iff_mem_span_radical
    (hQ : ∀ v, 0 ≤ Q v) (x : CliffordAlgebra (Q.baseChange ℂ)) :
    scalarTrace (Q.baseChange ℂ) (complexConj Q (reverse x) * x) = 0 ↔
      x ∈ TwoSidedIdeal.span
        (ι (Q.baseChange ℂ) '' ((Q.baseChange ℂ).radical : Set (ℂ ⊗[ℝ] V))) := by
  obtain ⟨b, hb⟩ := LinearMap.BilinForm.exists_orthogonal_basis
    (B := QuadraticMap.associated Q) (QuadraticForm.associated_isSymm ℝ Q)
  exact scalarTrace_complexConj_reverse_mul_self_eq_zero_iff_mem_span_radical_of_isOrtho hb
    (fun i ↦ hQ (b i)) x

/-- For a negative semidefinite real quadratic form, the null set of the negative-metric trace
norm on the complexified Clifford algebra is the two-sided ideal generated by the radical of
`Q_ℂ`. -/
theorem scalarTrace_conjStar_mul_self_eq_zero_iff_mem_span_radical
    (hQ : ∀ v, Q v ≤ 0) (x : CliffordAlgebra (Q.baseChange ℂ)) :
    scalarTrace (Q.baseChange ℂ) (conjStar Q x * x) = 0 ↔
      x ∈ TwoSidedIdeal.span
        (ι (Q.baseChange ℂ) '' ((Q.baseChange ℂ).radical : Set (ℂ ⊗[ℝ] V))) := by
  obtain ⟨b, hb⟩ := LinearMap.BilinForm.exists_orthogonal_basis
    (B := QuadraticMap.associated Q) (QuadraticForm.associated_isSymm ℝ Q)
  exact scalarTrace_conjStar_mul_self_eq_zero_iff_mem_span_radical_of_isOrtho hb
    (fun i ↦ hQ (b i)) x

/-- **Faithfulness of the positive-form trace norm** for a positive definite real quadratic
form. -/
theorem scalarTrace_complexConj_reverse_mul_self_eq_zero_iff (hQ : Q.PosDef)
    {x : CliffordAlgebra (Q.baseChange ℂ)} :
    scalarTrace (Q.baseChange ℂ) (complexConj Q (reverse x) * x) = 0 ↔ x = 0 := by
  obtain ⟨b, hb⟩ := LinearMap.BilinForm.exists_orthogonal_basis
    (B := QuadraticMap.associated Q) (QuadraticForm.associated_isSymm ℝ Q)
  have hpos (i) : 0 < Q (b i) := hQ (b i) (b.ne_zero i)
  rw [scalarTrace_complexConj_reverse_mul_self_eq_zero_iff_basis_repr_eq_zero hb fun i ↦
    (hpos i).le, forall_prod_ne_zero_basis_repr_eq_zero_iff fun i ↦ (hpos i).ne']

/-- **Faithfulness of the negative-metric trace norm** for a negative definite real quadratic
form. -/
theorem scalarTrace_conjStar_mul_self_eq_zero_iff (hQ : (-Q).PosDef)
    {x : CliffordAlgebra (Q.baseChange ℂ)} :
    scalarTrace (Q.baseChange ℂ) (conjStar Q x * x) = 0 ↔ x = 0 := by
  obtain ⟨b, hb⟩ := LinearMap.BilinForm.exists_orthogonal_basis
    (B := QuadraticMap.associated Q) (QuadraticForm.associated_isSymm ℝ Q)
  have hpos (i) : 0 < -Q (b i) := hQ (b i) (b.ne_zero i)
  rw [scalarTrace_conjStar_mul_self_eq_zero_iff_basis_repr_eq_zero hb fun i ↦ neg_nonneg.mp
    (hpos i).le, forall_prod_ne_zero_basis_repr_eq_zero_iff fun i ↦ (hpos i).ne']

/-- **The real trace norm is faithful exactly for positive definite forms.** A nonzero real
vector `v` with `Q v ≤ 0` gives a nonzero Clifford element of zero trace norm. -/
theorem posDef_iff_forall_scalarTrace_reverse_mul_self_eq_zero :
    Q.PosDef ↔ ∀ x : CliffordAlgebra Q, scalarTrace Q (reverse x * x) = 0 → x = 0 := by
  refine ⟨fun hQ x ↦ ?_, fun h v hv ↦ lt_of_not_ge fun hle ↦ ?_⟩
  · obtain ⟨b, hb⟩ := LinearMap.BilinForm.exists_orthogonal_basis
      (B := QuadraticMap.associated Q) (QuadraticForm.associated_isSymm ℝ Q)
    exact (scalarTrace_reverse_mul_self_eq_zero_iff hb fun i ↦ hQ (b i) (b.ne_zero i)).mp
  · obtain ⟨y, hy, htrace⟩ := exists_ne_zero_scalarTrace_reverse_mul_self_eq_zero hv hle
    exact hy (h y htrace)

/-- **The positive-form trace norm is faithful exactly for positive definite forms.** If `Q` is
not positive definite, a nonzero real Clifford element, viewed in the complexification, has zero
trace norm. -/
theorem posDef_iff_forall_scalarTrace_complexConj_reverse_mul_self_eq_zero :
    Q.PosDef ↔ ∀ x : CliffordAlgebra (Q.baseChange ℂ),
      scalarTrace (Q.baseChange ℂ) (complexConj Q (reverse x) * x) = 0 → x = 0 := by
  refine ⟨fun hQ x ↦ (scalarTrace_complexConj_reverse_mul_self_eq_zero_iff hQ).mp, fun h ↦
    posDef_iff_forall_scalarTrace_reverse_mul_self_eq_zero.mpr fun y hy ↦
      ofBaseChangeAux_injective (A := ℂ) Q ?_⟩
  rw [map_zero]
  refine h _ ?_
  rw [← ofBaseChangeAux_reverse, complexConj_ofBaseChangeAux, ← map_mul,
    scalarTrace_ofBaseChangeAux, hy, map_zero]

/-- **The negative-metric trace norm is faithful exactly for negative definite forms.** A nonzero
real vector `v` with `0 ≤ Q v` gives a nonzero real Clifford element of zero trace norm. -/
theorem posDef_neg_iff_forall_scalarTrace_conjStar_mul_self_eq_zero :
    (-Q).PosDef ↔ ∀ x : CliffordAlgebra (Q.baseChange ℂ),
      scalarTrace (Q.baseChange ℂ) (conjStar Q x * x) = 0 → x = 0 := by
  refine ⟨fun hQ x ↦ (scalarTrace_conjStar_mul_self_eq_zero_iff hQ).mp,
    fun h v hv ↦ neg_pos.mpr (lt_of_not_ge fun hle ↦ ?_)⟩
  obtain ⟨y, hy, htrace⟩ := exists_ne_zero_scalarTrace_star_mul_self_eq_zero hv hle
  refine hy (ofBaseChangeAux_injective (A := ℂ) Q ?_)
  rw [map_zero]
  refine h _ ?_
  rw [conjStar_ofBaseChangeAux, ← map_mul, scalarTrace_ofBaseChangeAux, htrace, map_zero]

/-! ### The tensor carrier -/

section Tensor

attribute [local instance] starModule_of_trivialStar

/-- **Positivity on the tensor carrier.** For a negative semidefinite real quadratic form, the
complexified scalar trace `Module.Dual.baseChange ℂ (scalarTrace Q)` of `star x * x` is
nonnegative, where `star` is the tensor-product star `conj ⊗ star`. -/
theorem baseChange_scalarTrace_star_mul_self_nonneg (hQ : ∀ v, Q v ≤ 0)
    (x : ℂ ⊗[ℝ] CliffordAlgebra Q) :
    0 ≤ Module.Dual.baseChange ℂ (scalarTrace Q) (star x * x) := by
  obtain ⟨y, rfl⟩ := (equivBaseChange ℂ Q).surjective x
  rw [equivBaseChange_apply, ← toBaseChange_conjStar, ← map_mul,
    baseChange_scalarTrace_toBaseChange]
  exact scalarTrace_conjStar_mul_self_nonneg hQ y

/-- **Faithfulness on the tensor carrier.** For a negative definite real quadratic form, the
complexified scalar trace of `star x * x` vanishes only for `x = 0`. -/
theorem baseChange_scalarTrace_star_mul_self_eq_zero_iff (hQ : (-Q).PosDef)
    {x : ℂ ⊗[ℝ] CliffordAlgebra Q} :
    Module.Dual.baseChange ℂ (scalarTrace Q) (star x * x) = 0 ↔ x = 0 := by
  obtain ⟨y, rfl⟩ := (equivBaseChange ℂ Q).surjective x
  rw [equivBaseChange_apply, ← toBaseChange_conjStar, ← map_mul,
    baseChange_scalarTrace_toBaseChange, scalarTrace_conjStar_mul_self_eq_zero_iff hQ,
    ← equivBaseChange_apply, map_eq_zero_iff _ (equivBaseChange ℂ Q).injective]

end Tensor

end FiniteDimensional

