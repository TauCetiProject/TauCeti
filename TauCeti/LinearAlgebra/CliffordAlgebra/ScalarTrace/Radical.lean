/-!
# The radical of the Clifford scalar-trace pairing

The scalar-trace pairing on a possibly degenerate Clifford algebra detects exactly the quotient
by the two-sided ideal generated by the radical of the quadratic form. In an orthogonal basis,
the ideal consists of the linear combinations of ordered monomials containing an isotropic basis
vector. Equivalently, the coordinates at every monomial with nonzero quadratic weight vanish.

This identifies the algebraic obstruction to faithfulness of scalar-trace metrics. The pairing
criterion works for arbitrary quadratic forms over fields of characteristic different from two;
it does not require a positivity assumption.

The proofs use the ordered-product basis and its diagonal trace pairing from
`CliffordAlgebra.scalarTrace_reverse_basis_mul`, and Mathlib's native quadratic radical and
two-sided ideal span.

## References

* H. B. Lawson and M.-L. Michelsohn, *Spin Geometry* (1989), Chapter I, §1.
-/

public section

namespace CliffordAlgebra

section CommRing

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] [Invertible (2 : R)]
  {Q : QuadraticForm R M}

/-- A vector in the quadratic radical pairs to zero with every Clifford element. -/
theorem scalarTrace_ι_mul_of_mem_radical {v : M} (hv : v ∈ Q.radical)
    (x : CliffordAlgebra Q) : scalarTrace Q (ι Q v * x) = 0 := by
  have hassoc : QuadraticMap.associated Q v = 0 := by
    simpa only [QuadraticMap.radical_eq_ker_associated, LinearMap.mem_ker] using hv
  have hneg : QuadraticMap.associated (-Q) v = 0 := by
    simpa using congrArg Neg.neg hassoc
  rw [scalarTrace_apply, equivExterior_ι_mul, hneg]
  simp [ExteriorAlgebra.algebraMapInv_ι]

/-- Every element of the ideal generated by the quadratic radical pairs to zero with every
Clifford element. This direction holds over a commutative ring. -/
theorem scalarTrace_mul_eq_zero_of_mem_span_radical {x : CliffordAlgebra Q}
    (hx : x ∈ TwoSidedIdeal.span (ι Q '' (Q.radical : Set M))) (y : CliffordAlgebra Q) :
    scalarTrace Q (x * y) = 0 := by
  induction hx using TwoSidedIdeal.span_induction generalizing y with
  | mem x hx =>
    obtain ⟨v, hv, rfl⟩ := hx
    exact scalarTrace_ι_mul_of_mem_radical hv y
  | zero => simp
  | add x z _ _ hx hz => simp [add_mul, hx, hz]
  | neg x _ hx => simp [hx]
  | left_absorb a x _ hx =>
    rw [mul_assoc, scalarTrace_mul_comm a (x * y), mul_assoc]
    exact hx _
  | right_absorb a x _ hx => simpa only [mul_assoc] using hx (a * y)

end CommRing

section Domain

variable {K V I : Type*} [CommRing K] [IsDomain K] [AddCommGroup V] [Module K V]
  [Invertible (2 : K)]
  {Q : QuadraticForm K V} [LinearOrder I] {b : Module.Basis I K V}

/-- A monomial of an orthogonal basis belongs to the radical-generated ideal whenever one of its
quadratic weights vanishes. -/
theorem basis_mem_span_radical_of_prod_eq_zero
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b) {s : Finset I}
    (hs : ∏ i ∈ s, Q (b i) = 0) :
    basis Q b s ∈ TwoSidedIdeal.span (ι Q '' (Q.radical : Set V)) := by
  classical
  obtain ⟨i, hi, hQi⟩ := Finset.prod_eq_zero_iff.mp hs
  have hrad : b i ∈ Q.radical := by
    rw [QuadraticMap.radical_eq_ker_associated, LinearMap.mem_ker]
    apply b.ext
    intro j
    by_cases hij : i = j
    · subst j
      simpa only [LinearMap.zero_apply, QuadraticMap.associated_eq_self_apply] using hQi
    · exact hb hij
  have hgen : ι Q (b i) ∈ TwoSidedIdeal.span (ι Q '' (Q.radical : Set V)) :=
    TwoSidedIdeal.subset_span ⟨b i, hrad, rfl⟩
  obtain ⟨l, r, hlr⟩ := List.append_of_mem ((Finset.mem_sort (α := I) (· ≤ ·)).mpr hi)
  rw [basis_eq_prod_map_sort hb, hlr, List.map_append, List.map_cons,
    List.map_append, List.map_cons, List.prod_append, List.prod_cons]
  exact TwoSidedIdeal.mul_mem_left _ _ _ (TwoSidedIdeal.mul_mem_right _ _ _ hgen)

/-- The ideal generated by the quadratic radical consists exactly of the elements whose
coordinates at all monomials of nonzero quadratic weight vanish. -/
theorem mem_span_radical_iff_basis_repr_eq_zero
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b) (x : CliffordAlgebra Q) :
    x ∈ TwoSidedIdeal.span (ι Q '' (Q.radical : Set V)) ↔
      ∀ s : Finset I, (∏ i ∈ s, Q (b i)) ≠ 0 → (basis Q b).repr x s = 0 := by
  constructor
  · intro hx s hs
    have h := scalarTrace_mul_eq_zero_of_mem_span_radical hx (reverse (basis Q b s))
    rw [scalarTrace_mul_comm, scalarTrace_reverse_basis_mul hb] at h
    exact (mul_eq_zero.mp h).resolve_left hs
  · intro hx
    rw [← (basis Q b).linearCombination_repr x, Finsupp.linearCombination_apply]
    refine (TwoSidedIdeal.span (ι Q '' (Q.radical : Set V))).asIdeal.sum_mem fun s hs ↦ ?_
    by_cases hweight : ∏ i ∈ s, Q (b i) = 0
    · simp only [Algebra.smul_def]
      exact TwoSidedIdeal.mul_mem_left _ _ _ (basis_mem_span_radical_of_prod_eq_zero hb hweight)
    · simp [hx s hweight]

/-- The radical of the scalar-trace pairing is the two-sided ideal generated by the quadratic
radical, expressed using any orthogonal basis. -/
theorem mem_span_radical_iff_forall_scalarTrace_mul_eq_zero_of_isOrtho
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b) (x : CliffordAlgebra Q) :
    x ∈ TwoSidedIdeal.span (ι Q '' (Q.radical : Set V)) ↔
      ∀ y : CliffordAlgebra Q, scalarTrace Q (x * y) = 0 := by
  refine ⟨fun hx y ↦ scalarTrace_mul_eq_zero_of_mem_span_radical hx y, fun hx ↦ ?_⟩
  rw [mem_span_radical_iff_basis_repr_eq_zero hb]
  intro s hs
  have h := hx (reverse (basis Q b s))
  rw [scalarTrace_mul_comm, scalarTrace_reverse_basis_mul hb] at h
  exact (mul_eq_zero.mp h).resolve_left hs

end Domain

section FiniteDimensional

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V] [Invertible (2 : K)]
  [FiniteDimensional K V] {Q : QuadraticForm K V}

/-- For every finite-dimensional quadratic space, the radical of the scalar-trace pairing is
exactly the two-sided ideal generated by the quadratic radical. -/
theorem mem_span_radical_iff_forall_scalarTrace_mul_eq_zero (x : CliffordAlgebra Q) :
    x ∈ TwoSidedIdeal.span (ι Q '' (Q.radical : Set V)) ↔
      ∀ y : CliffordAlgebra Q, scalarTrace Q (x * y) = 0 := by
  obtain ⟨b, hb⟩ := LinearMap.BilinForm.exists_orthogonal_basis
    (B := QuadraticMap.associated Q) (QuadraticForm.associated_isSymm K Q)
  exact mem_span_radical_iff_forall_scalarTrace_mul_eq_zero_of_isOrtho hb x

end FiniteDimensional

section OrderedRing

variable {K V I : Type*} [CommRing K] [LinearOrder K] [IsStrictOrderedRing K]
  [AddCommGroup V] [Module K V] [Invertible (2 : K)]
  {Q : QuadraticForm K V} [LinearOrder I] {b : Module.Basis I K V}

/-- For a form nonnegative on an orthogonal basis, the null set of the scalar-trace quadratic
pairing is exactly the ideal generated by the quadratic radical. -/
theorem scalarTrace_reverse_mul_self_eq_zero_iff_mem_span_radical_of_isOrtho
    (hb : (QuadraticMap.associated Q).IsOrthoᵢ b) (hQ : ∀ i, 0 ≤ Q (b i))
    (x : CliffordAlgebra Q) :
    scalarTrace Q (reverse x * x) = 0 ↔
      x ∈ TwoSidedIdeal.span (ι Q '' (Q.radical : Set V)) := by
  classical
  refine ⟨fun hx ↦ ?_, fun hx ↦ ?_⟩
  · rw [mem_span_radical_iff_basis_repr_eq_zero hb]
    have hnonneg (s : Finset I) (c : K) : 0 ≤ c * ((∏ i ∈ s, Q (b i)) * c) := by
      rw [mul_left_comm]
      exact mul_nonneg (Finset.prod_nonneg fun i _ ↦ hQ i) (mul_self_nonneg c)
    rw [scalarTrace_reverse_mul hb, Finsupp.sum,
      Finset.sum_eq_zero_iff_of_nonneg (fun s _ ↦ hnonneg s _)] at hx
    intro s hs
    by_cases hmem : s ∈ ((basis Q b).repr x).support
    · have h := hx s hmem
      rw [mul_left_comm, mul_eq_zero, or_iff_right hs, mul_self_eq_zero] at h
      exact h
    · exact Finsupp.notMem_support_iff.mp hmem
  · rw [scalarTrace_mul_comm]
    exact scalarTrace_mul_eq_zero_of_mem_span_radical hx _

end OrderedRing

section OrderedField

variable {K V : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  [AddCommGroup V] [Module K V] [Invertible (2 : K)] [FiniteDimensional K V]
  {Q : QuadraticForm K V}

/-- For a nonnegative quadratic form on a finite-dimensional space, the null set of its Clifford
scalar-trace metric is the two-sided ideal generated by its radical. -/
theorem scalarTrace_reverse_mul_self_eq_zero_iff_mem_span_radical
    (hQ : ∀ v, 0 ≤ Q v) (x : CliffordAlgebra Q) :
    scalarTrace Q (reverse x * x) = 0 ↔
      x ∈ TwoSidedIdeal.span (ι Q '' (Q.radical : Set V)) := by
  obtain ⟨b, hb⟩ := LinearMap.BilinForm.exists_orthogonal_basis
    (B := QuadraticMap.associated Q) (QuadraticForm.associated_isSymm K Q)
  exact scalarTrace_reverse_mul_self_eq_zero_iff_mem_span_radical_of_isOrtho hb (fun i ↦ hQ (b i)) x

end OrderedField

end CliffordAlgebra
