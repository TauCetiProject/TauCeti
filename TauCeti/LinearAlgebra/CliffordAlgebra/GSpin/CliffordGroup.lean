/-!
# Clifford groups, general spin groups and their norms over a commutative ring

For a quadratic form `Q` on a module `M` over a commutative ring `R`, in every characteristic,
this file defines the groups of points of the *Clifford group* `GPin(Q)`, the *general spin
group* `GSpin(Q)`, and the kernels `Pin(Q)` and `Spin(Q)` of their norms, as subgroups of the
units of `CliffordAlgebra Q`:

* `GPin(Q)` is the set of units `g` that are *locally homogeneous* (`R` splits as a product by an
  idempotent `e`, with `g` even over the first factor and odd over the second) and whose twisted
  conjugation `v ↦ α(g) v g⁻¹` preserves the vectors `ι(M)`, where `α = involute`;
* `GSpin(Q)` is the set of even units whose conjugation `v ↦ g v g⁻¹` preserves `ι(M)`.

The twisted conjugation condition is Tau Ceti's `CliffordAlgebra.vectorNormalizer`. Local
homogeneity is stated with an idempotent rather than with the grade involution, because in
characteristic two the grade involution is the identity and does not detect parity.

The *Clifford norm* `N(g) = star(g) g`, where `star = reverse ∘ involute`, is central on
`GPin(Q)` (`CliffordAlgebra.commute_star_mul_self`) and is a homomorphism
`GPin(Q) → Z(C(Q))ˣ` (`CliffordAlgebra.gpinNorm`); its restriction to
`GSpin(Q)` is `ν(g) = reverse(g) g` (`CliffordAlgebra.gspinNorm`). Their kernels are
`CliffordAlgebra.normOnePinGroup` and `CliffordAlgebra.normOneSpinGroup`. These differ from
Mathlib's `pinGroup`, the unitary part of the Lipschitz group `lipschitzGroup` generated by the
invertible vectors, and `spinGroup`, the even part of `pinGroup`: in rank `0`, `normOneSpinGroup`
is the group of units of `R` whose square is `1` (`{±1}` over a field) while `spinGroup` is
trivial. `gpinNorm` extends
the `star` norm `CliffordAlgebra.lipschitzNorm` of the Lipschitz group; it is not the `reverse`
norm `CliffordAlgebra.cliffordNorm` of
`TauCeti.LinearAlgebra.CliffordAlgebra.Lipschitz.ReverseNorm`, which differs on odd elements.

When `ι` and the scalars embed in the Clifford algebra, as they do for free `M` in every
characteristic (`CliffordAlgebra.ι_injective_of_free`,
`CliffordAlgebra.algebraMap_injective_of_free`) and whenever `2` is invertible, the vector action
`CliffordAlgebra.vectorNormalizerAction` of the vector normalizer restricts to the *vector action*
`ρ : GPin(Q) → O(Q)` (`CliffordAlgebra.gpinToOrthogonal`), with `ι (ρ(g) v) = α(g) ι(v) g⁻¹`.

These are the groups of points over `R` of the Clifford and general spin group functors of
Conrad, App. C, §C.4. The comparisons with Mathlib's `lipschitzGroup` (over any commutative ring)
and `spinGroup` (over a field of characteristic not two) are in
`TauCeti.LinearAlgebra.CliffordAlgebra.GSpin.Lipschitz`.

## Main declarations

* `CliffordAlgebra.IsLocallyHomogeneous`, `CliffordAlgebra.locallyHomogeneousUnits`,
  `CliffordAlgebra.evenUnits`: locally homogeneous and even Clifford units.
* `CliffordAlgebra.gpinGroup`, `CliffordAlgebra.gspinGroup`: the Clifford and general spin groups.
* `CliffordAlgebra.mem_gspinGroup_iff_conj`: `GSpin(Q)` is given by untwisted conjugation.
* `CliffordAlgebra.gpinNorm`, `CliffordAlgebra.gspinNorm`: the norms `GPin(Q) → Z(C(Q))ˣ` and
  `GSpin(Q) → Z(C(Q))ˣ`, with kernels `CliffordAlgebra.normOnePinGroup` and
  `CliffordAlgebra.normOneSpinGroup` (`CliffordAlgebra.normOnePinGroup_eq_map_ker`,
  `CliffordAlgebra.normOneSpinGroup_eq_map_ker`).
* `CliffordAlgebra.gpinToOrthogonal`: the vector action `GPin(Q) → O(Q)` when `ι` and the
  scalars embed.

## References

* B. Conrad, *Reductive group schemes*, Appendix C, §C.4, for the Clifford and spin groups of a
  quadratic space over a ring.
* H. Bass, *Clifford algebras and spinor norms over a commutative ring*, Amer. J. Math. 96
  (1974), §3.
-/

public section

open TauCeti

namespace CliffordAlgebra

universe u v

variable {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
  (Q : QuadraticForm R M)

/-! ### Homogeneous units -/

section Homogeneous

variable {Q}

/-- A Clifford element is **locally homogeneous** when, for some idempotent `e` of the base ring,
it is even over `e` and odd over `1 - e`: Zariski-locally on `Spec R` it is even or odd. -/
def IsLocallyHomogeneous (x : CliffordAlgebra Q) : Prop :=
  ∃ e : R, IsIdempotentElem e ∧ e • x ∈ evenOdd Q 0 ∧ (1 - e) • x ∈ evenOdd Q 1

/-- Unfolding `CliffordAlgebra.IsLocallyHomogeneous`. -/
theorem isLocallyHomogeneous_iff {x : CliffordAlgebra Q} :
    IsLocallyHomogeneous x ↔
      ∃ e : R, IsIdempotentElem e ∧ e • x ∈ evenOdd Q 0 ∧ (1 - e) • x ∈ evenOdd Q 1 := by
  rw [IsLocallyHomogeneous]

/-- An even element is locally homogeneous. -/
theorem isLocallyHomogeneous_of_mem_evenOdd_zero {x : CliffordAlgebra Q}
    (hx : x ∈ evenOdd Q 0) : IsLocallyHomogeneous x :=
  ⟨1, IsIdempotentElem.one, by rwa [one_smul], by rw [sub_self, zero_smul]; exact zero_mem _⟩

/-- An odd element is locally homogeneous. -/
theorem isLocallyHomogeneous_of_mem_evenOdd_one {x : CliffordAlgebra Q}
    (hx : x ∈ evenOdd Q 1) : IsLocallyHomogeneous x :=
  ⟨0, IsIdempotentElem.zero, by rw [zero_smul]; exact zero_mem _, by rwa [sub_zero, one_smul]⟩

/-- **The grade involution acts on a locally homogeneous element by a sign**: a scalar `s` with
`s * s = 1`, namely `s = 2e - 1`. -/
theorem IsLocallyHomogeneous.exists_involute_eq_smul {x : CliffordAlgebra Q}
    (hx : IsLocallyHomogeneous x) : ∃ s : R, s * s = 1 ∧ involute x = s • x := by
  obtain ⟨e, he, h0, h1⟩ := hx
  refine ⟨2 * e - 1, by linear_combination 4 * he.eq, ?_⟩
  have hsplit : x = e • x + (1 - e) • x := by rw [← add_smul, add_sub_cancel, one_smul]
  conv_lhs => rw [hsplit]
  rw [map_add, involute_eq_of_mem_even h0, involute_eq_of_mem_odd h1]
  conv_rhs => rw [hsplit]
  module

variable (Q) in
/-- The locally homogeneous units of a Clifford algebra. -/
def locallyHomogeneousUnits : Subgroup (CliffordAlgebra Q)ˣ where
  carrier := {x | IsLocallyHomogeneous (x : CliffordAlgebra Q)}
  one_mem' := isLocallyHomogeneous_of_mem_evenOdd_zero (SetLike.one_mem_graded _)
  mul_mem' := by
    rintro x y ⟨e, he, hx0, hx1⟩ ⟨f, hf, hy0, hy1⟩
    have h00 : ((0 : ZMod 2) + 0) = 0 := rfl
    have h11 : ((1 : ZMod 2) + 1) = 0 := rfl
    have h01 : ((0 : ZMod 2) + 1) = 1 := rfl
    have h10 : ((1 : ZMod 2) + 0) = 1 := rfl
    refine ⟨e * f + (1 - e) * (1 - f), ?_, ?_, ?_⟩
    · rw [IsIdempotentElem]
      linear_combination (1 - 2 * f) ^ 2 * he.eq + hf.eq
    · have h : (e * f + (1 - e) * (1 - f)) • ((x : CliffordAlgebra Q) * y) =
          (e • (x : CliffordAlgebra Q)) * (f • (y : CliffordAlgebra Q)) +
            ((1 - e) • (x : CliffordAlgebra Q)) * ((1 - f) • (y : CliffordAlgebra Q)) := by
        rw [smul_mul_smul, smul_mul_smul, add_smul]
      rw [Units.val_mul, h]
      refine add_mem ?_ ?_
      · exact h00 ▸ SetLike.GradedMul.mul_mem hx0 hy0
      · exact h11 ▸ SetLike.GradedMul.mul_mem hx1 hy1
    · have h : (1 - (e * f + (1 - e) * (1 - f))) • ((x : CliffordAlgebra Q) * y) =
          (e • (x : CliffordAlgebra Q)) * ((1 - f) • (y : CliffordAlgebra Q)) +
            ((1 - e) • (x : CliffordAlgebra Q)) * (f • (y : CliffordAlgebra Q)) := by
        rw [smul_mul_smul, smul_mul_smul, ← add_smul]
        congr 1
        ring
      rw [Units.val_mul, h]
      refine add_mem ?_ ?_
      · exact h01 ▸ SetLike.GradedMul.mul_mem hx0 hy1
      · exact h10 ▸ SetLike.GradedMul.mul_mem hx1 hy0
  inv_mem' := by
    rintro x ⟨e, he, hx0, hx1⟩
    have key : ∀ (f : R) (i : ZMod 2), IsIdempotentElem f →
        f • (x : CliffordAlgebra Q) ∈ evenOdd Q i →
        f • ((x⁻¹ : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) ∈ evenOdd Q i := by
      intro f i hf hxf
      refine mem_evenOdd_of_mul_eq_algebraMap hxf (f := f) ?_ ?_ ?_
      · rw [smul_smul, hf.eq]
      · rw [smul_mul_smul, hf.eq, Units.mul_inv, Algebra.algebraMap_eq_smul_one]
      · rw [smul_mul_smul, hf.eq, Units.inv_mul, Algebra.algebraMap_eq_smul_one]
    exact ⟨e, he, key e 0 he hx0, key (1 - e) 1 he.one_sub hx1⟩

variable (Q) in
/-- A unit is in `locallyHomogeneousUnits` when its underlying element is locally homogeneous. -/
@[simp]
theorem mem_locallyHomogeneousUnits_iff {x : (CliffordAlgebra Q)ˣ} :
    x ∈ locallyHomogeneousUnits Q ↔ IsLocallyHomogeneous (x : CliffordAlgebra Q) :=
  Iff.rfl

variable (Q) in
/-- The even units of a Clifford algebra: the units of `C₀(Q)`. -/
def evenUnits : Subgroup (CliffordAlgebra Q)ˣ :=
  (even Q).toSubmonoid.units

variable (Q) in
/-- A unit is even when its underlying element lies in the even subalgebra `C₀(Q)`. -/
@[simp]
theorem mem_evenUnits_iff {x : (CliffordAlgebra Q)ˣ} :
    x ∈ evenUnits Q ↔ (x : CliffordAlgebra Q) ∈ even Q := by
  simp only [evenUnits, Submonoid.mem_units_iff, Subsemiring.mem_toSubmonoid,
    Subalgebra.mem_toSubsemiring, and_iff_left_iff_imp]
  intro hx
  rw [← Subalgebra.mem_toSubmodule, even_toSubmodule] at hx ⊢
  exact coe_inv_mem_evenOdd hx

variable (Q) in
/-- Even units are locally homogeneous. -/
theorem evenUnits_le_locallyHomogeneousUnits : evenUnits Q ≤ locallyHomogeneousUnits Q :=
  fun _ hx => isLocallyHomogeneous_of_mem_evenOdd_zero <| by
    rw [← even_toSubmodule, Subalgebra.mem_toSubmodule]
    exact (mem_evenUnits_iff Q).mp hx

end Homogeneous

/-! ### The Clifford group and the general spin group -/

/-- **The Clifford group** `GPin(Q)`: the locally homogeneous Clifford units `g` whose twisted
conjugation `v ↦ α(g) v g⁻¹` preserves the vectors `ι(M)`. -/
def gpinGroup : Subgroup (CliffordAlgebra Q)ˣ :=
  vectorNormalizer Q ⊓ locallyHomogeneousUnits Q

/-- **The general spin group** `GSpin(Q)`: the even Clifford units whose conjugation preserves
the vectors `ι(M)`. -/
def gspinGroup : Subgroup (CliffordAlgebra Q)ˣ :=
  vectorNormalizer Q ⊓ evenUnits Q

variable {Q}

variable (Q) in
/-- The Clifford group is the locally homogeneous part of the vector normalizer. -/
theorem gpinGroup_def : gpinGroup Q = vectorNormalizer Q ⊓ locallyHomogeneousUnits Q := by
  rw [gpinGroup]

variable (Q) in
/-- The general spin group is the even part of the vector normalizer. -/
theorem gspinGroup_def : gspinGroup Q = vectorNormalizer Q ⊓ evenUnits Q := by
  rw [gspinGroup]

/-- A unit lies in the Clifford group when it normalizes the vectors under twisted conjugation
and is locally homogeneous. -/
@[simp]
theorem mem_gpinGroup_iff {x : (CliffordAlgebra Q)ˣ} :
    x ∈ gpinGroup Q ↔ x ∈ vectorNormalizer Q ∧ IsLocallyHomogeneous (x : CliffordAlgebra Q) :=
  Iff.rfl

/-- A unit lies in the general spin group when it normalizes the vectors under twisted conjugation
and is even. -/
@[simp]
theorem mem_gspinGroup_iff {x : (CliffordAlgebra Q)ˣ} :
    x ∈ gspinGroup Q ↔ x ∈ vectorNormalizer Q ∧ (x : CliffordAlgebra Q) ∈ even Q := by
  rw [gspinGroup, Subgroup.mem_inf, mem_evenUnits_iff]

variable (Q) in
/-- The general spin group lies in the Clifford group. -/
theorem gspinGroup_le_gpinGroup : gspinGroup Q ≤ gpinGroup Q :=
  inf_le_inf_left _ (evenUnits_le_locallyHomogeneousUnits Q)

variable (Q) in
/-- The Clifford group lies in the vector normalizer. -/
theorem gpinGroup_le_vectorNormalizer : gpinGroup Q ≤ vectorNormalizer Q := inf_le_left

/-- **`GSpin(Q)` is cut out by untwisted conjugation**: an even unit `g` lies in the general spin
group exactly when `g ι(M) g⁻¹ ⊆ ι(M)` and `g⁻¹ ι(M) g ⊆ ι(M)`. -/
theorem mem_gspinGroup_iff_conj {x : (CliffordAlgebra Q)ˣ} :
    x ∈ gspinGroup Q ↔ (x : CliffordAlgebra Q) ∈ even Q ∧
      (∀ m, (x : CliffordAlgebra Q) * ι Q m * ↑x⁻¹ ∈ LinearMap.range (ι Q)) ∧
      (∀ m, ((x⁻¹ : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * ι Q m * ↑x ∈
        LinearMap.range (ι Q)) := by
  have hinv (hx : (x : CliffordAlgebra Q) ∈ even Q) :
      ((x⁻¹ : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) ∈ even Q :=
    (mem_evenUnits_iff Q).mp (inv_mem ((mem_evenUnits_iff Q).mpr hx))
  rw [mem_gspinGroup_iff, mem_vectorNormalizer_iff]
  constructor
  · rintro ⟨⟨h1, h2⟩, hx⟩
    refine ⟨hx, fun m => ?_, fun m => ?_⟩
    · simpa only [involute_eq_of_mem_even hx] using h1 m
    · simpa only [involute_eq_of_mem_even (hinv hx)] using h2 m
  · rintro ⟨hx, h1, h2⟩
    refine ⟨⟨fun m => ?_, fun m => ?_⟩, hx⟩
    · simpa only [involute_eq_of_mem_even hx] using h1 m
    · simpa only [involute_eq_of_mem_even (hinv hx)] using h2 m

/-! ### The Clifford norm -/

/-- Twisted conjugation by an element of the Clifford group commutes with Clifford conjugation:
`star(g) g` commutes with every vector. -/
private theorem commute_star_mul_self_ι {x : (CliffordAlgebra Q)ˣ} (hx : x ∈ gpinGroup Q)
    (m : M) :
    Commute (star (x : CliffordAlgebra Q) * x) (ι Q m) := by
  obtain ⟨s, hs, hinv⟩ := (mem_gpinGroup_iff.mp hx).2.exists_involute_eq_smul
  obtain ⟨w, hw⟩ := ((mem_vectorNormalizer_iff Q x).mp (mem_gpinGroup_iff.mp hx).1).1 m
  set g : CliffordAlgebra Q := (x : CliffordAlgebra Q)
  set h : CliffordAlgebra Q := ((x⁻¹ : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q)
  have hgh : g * h = 1 := Units.mul_inv x
  have hhg : h * g = 1 := Units.inv_mul x
  have hsi : star (involute g) = reverse g := by rw [star_def, involute_involute]
  have hrev : reverse g = s • star g := by
    rw [star_def g, hinv, map_smul, smul_smul, hs, one_smul]
  have h1 := congrArg star hw
  rw [star_ι, star_mul, star_mul, star_ι, hsi, hrev] at h1
  rw [hinv] at hw
  have hE : star h * ι Q m * star g = g * ι Q m * h := by
    have h2 : s • (star h * ι Q m * star g) = ι Q w := by
      rw [← neg_inj, h1]
      simp only [mul_smul_comm, mul_neg, neg_mul, mul_assoc, smul_neg]
    have h3 := congrArg (s • ·) (h2.trans hw)
    simpa only [smul_smul, hs, one_smul, smul_mul_assoc] using h3
  have hsg : star g * star h = 1 := by rw [← star_mul, hhg, star_one]
  calc star g * g * ι Q m = star g * (g * ι Q m * h) * g := by
        simp only [mul_assoc, hhg, mul_one]
    _ = star g * (star h * ι Q m * star g) * g := by rw [hE]
    _ = (star g * star h) * ι Q m * (star g * g) := by simp only [mul_assoc]
    _ = ι Q m * (star g * g) := by rw [hsg, one_mul]

/-- **The Clifford norm of an element of the Clifford group commutes with the whole Clifford
algebra**: `star(g) g` commutes with every Clifford element, for `g` in the Clifford group. -/
theorem commute_star_mul_self {x : (CliffordAlgebra Q)ˣ} (hx : x ∈ gpinGroup Q)
    (c : CliffordAlgebra Q) : Commute (star (x : CliffordAlgebra Q) * x) c := by
  induction c using CliffordAlgebra.induction with
  | algebraMap r => exact Algebra.commute_algebraMap_right r _
  | ι m => exact commute_star_mul_self_ι hx m
  | mul a b ha hb => exact ha.mul_right hb
  | add a b ha hb => exact ha.add_right hb

/-- **The Clifford norm of an element of the Clifford group is central.** -/
theorem star_mul_self_mem_center {x : (CliffordAlgebra Q)ˣ} (hx : x ∈ gpinGroup Q) :
    star x * x ∈ Subgroup.center (CliffordAlgebra Q)ˣ := by
  rw [Subgroup.mem_center_iff]
  intro y
  ext
  simp only [Units.val_mul, Units.coe_star]
  exact ((commute_star_mul_self hx y).eq).symm

variable (Q) in
/-- **The Clifford norm** `N(g) = star(g) g` on the Clifford group, a homomorphism to the central
units of the Clifford algebra. On `GSpin(Q)` it is `ν(g) = reverse(g) g`
(`CliffordAlgebra.coe_gpinNorm_of_mem_gspinGroup`). It extends the `star` norm `lipschitzNorm`,
not the `reverse` norm `cliffordNorm` of the Lipschitz group. -/
noncomputable def gpinNorm : gpinGroup Q →* Subgroup.center (CliffordAlgebra Q)ˣ where
  toFun x := ⟨star (x : (CliffordAlgebra Q)ˣ) * x, star_mul_self_mem_center x.property⟩
  map_one' := Subtype.ext <| by simp
  map_mul' x y := Subtype.ext <| Units.ext <| by
    simp only [Subgroup.coe_mul, Units.val_mul, Units.coe_star, star_mul]
    set g : CliffordAlgebra Q := ((x : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q)
    set h : CliffordAlgebra Q := ((y : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q)
    -- `star(g) g` is central, so it moves past `star h`.
    calc star h * star g * (g * h) = star h * (star g * g) * h := by simp only [mul_assoc]
      _ = star g * g * (star h * h) := by
        rw [← (commute_star_mul_self x.property (star h)).eq, mul_assoc]

/-- The Clifford norm is `star(g) g`. -/
@[simp]
theorem coe_gpinNorm (x : gpinGroup Q) :
    (((gpinNorm Q x : (CliffordAlgebra Q)ˣ)) : CliffordAlgebra Q) =
      star ((x : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * (x : (CliffordAlgebra Q)ˣ) := by
  simp only [gpinNorm, MonoidHom.coe_mk, OneHom.coe_mk, Units.val_mul, Units.coe_star]

/-- **On the general spin group the Clifford norm is `ν(g) = reverse(g) g`.** -/
theorem coe_gpinNorm_of_mem_gspinGroup {x : (CliffordAlgebra Q)ˣ} (hx : x ∈ gspinGroup Q) :
    (((gpinNorm Q ⟨x, gspinGroup_le_gpinGroup Q hx⟩ : (CliffordAlgebra Q)ˣ)) :
        CliffordAlgebra Q) =
      reverse (x : CliffordAlgebra Q) * x := by
  rw [coe_gpinNorm, star_mul_self_eq_reverse_mul_self_of_mem_even (mem_gspinGroup_iff.mp hx).2]

variable (Q) in
/-- **The general spin norm** `ν(g) = reverse(g) g` on the general spin group
(`CliffordAlgebra.coe_gspinNorm`), the restriction of the Clifford norm `gpinNorm`. -/
noncomputable def gspinNorm : gspinGroup Q →* Subgroup.center (CliffordAlgebra Q)ˣ :=
  (gpinNorm Q).comp (Subgroup.inclusion (gspinGroup_le_gpinGroup Q))

/-- The general spin norm is `reverse(g) g`. -/
@[simp]
theorem coe_gspinNorm (x : gspinGroup Q) :
    (((gspinNorm Q x : (CliffordAlgebra Q)ˣ)) : CliffordAlgebra Q) =
      reverse ((x : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * (x : (CliffordAlgebra Q)ˣ) :=
  coe_gpinNorm_of_mem_gspinGroup x.property

/-- An element of the Clifford group has Clifford norm one exactly when `star(g) g = 1`. -/
theorem gpinNorm_eq_one_iff (x : gpinGroup Q) :
    gpinNorm Q x = 1 ↔
      star ((x : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * (x : (CliffordAlgebra Q)ˣ) = 1 := by
  rw [Subtype.ext_iff, Units.ext_iff, coe_gpinNorm, OneMemClass.coe_one, Units.val_one]

/-- An element of the general spin group has general spin norm one exactly when
`reverse(g) g = 1`. -/
theorem gspinNorm_eq_one_iff (x : gspinGroup Q) :
    gspinNorm Q x = 1 ↔
      reverse ((x : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * (x : (CliffordAlgebra Q)ˣ) =
        1 := by
  rw [Subtype.ext_iff, Units.ext_iff, coe_gspinNorm, OneMemClass.coe_one, Units.val_one]

variable (Q) in
/-- **The norm-one Pin group** `Pin(Q) = ker N`: the elements of the Clifford group of Clifford
norm one. -/
noncomputable def normOnePinGroup : Subgroup (CliffordAlgebra Q)ˣ :=
  (gpinNorm Q).ker.map (gpinGroup Q).subtype

/-- An element lies in `Pin(Q)` exactly when it lies in the Clifford group and `star(g) g = 1`. -/
@[simp]
theorem mem_normOnePinGroup_iff {x : (CliffordAlgebra Q)ˣ} :
    x ∈ normOnePinGroup Q ↔ x ∈ gpinGroup Q ∧ star (x : CliffordAlgebra Q) * x = 1 := by
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y.property, (gpinNorm_eq_one_iff y).mp (MonoidHom.mem_ker.mp hy)⟩
  · rintro ⟨hx, h⟩
    exact ⟨⟨x, hx⟩, MonoidHom.mem_ker.mpr ((gpinNorm_eq_one_iff ⟨x, hx⟩).mpr h), rfl⟩

variable (Q) in
/-- `Pin(Q)` is the kernel of the Clifford norm, as a subgroup of the Clifford units. -/
theorem normOnePinGroup_eq_map_ker :
    normOnePinGroup Q = (gpinNorm Q).ker.map (gpinGroup Q).subtype := by
  rw [normOnePinGroup]

variable (Q) in
/-- **The norm-one spin group** `Spin(Q) = ker ν`: the elements of the general spin group with
`reverse(g) g = 1`. In rank `0` this is the group of units of `R` whose square is `1` (`{±1}`
over a field), whereas Mathlib's `spinGroup` is trivial. -/
noncomputable def normOneSpinGroup : Subgroup (CliffordAlgebra Q)ˣ :=
  normOnePinGroup Q ⊓ gspinGroup Q

variable (Q) in
/-- `Spin(Q)` is the part of `Pin(Q)` lying in `GSpin(Q)`. -/
theorem normOneSpinGroup_def : normOneSpinGroup Q = normOnePinGroup Q ⊓ gspinGroup Q := by
  rw [normOneSpinGroup]

/-- An element lies in `Spin(Q)` exactly when it lies in `GSpin(Q)` and `reverse(g) g = 1`. -/
@[simp]
theorem mem_normOneSpinGroup_iff {x : (CliffordAlgebra Q)ˣ} :
    x ∈ normOneSpinGroup Q ↔ x ∈ gspinGroup Q ∧ reverse (x : CliffordAlgebra Q) * x = 1 := by
  rw [normOneSpinGroup, Subgroup.mem_inf, mem_normOnePinGroup_iff]
  constructor
  · rintro ⟨⟨_, h⟩, hx⟩
    rw [← coe_gpinNorm_of_mem_gspinGroup hx]
    exact ⟨hx, h⟩
  · rintro ⟨hx, h⟩
    rw [← coe_gpinNorm_of_mem_gspinGroup hx] at h
    exact ⟨⟨gspinGroup_le_gpinGroup Q hx, h⟩, hx⟩

variable (Q) in
/-- `Spin(Q)` is the kernel of the general spin norm, as a subgroup of the Clifford units. -/
theorem normOneSpinGroup_eq_map_ker :
    normOneSpinGroup Q = (gspinNorm Q).ker.map (gspinGroup Q).subtype := by
  ext x
  rw [mem_normOneSpinGroup_iff]
  constructor
  · rintro ⟨hx, h⟩
    exact ⟨⟨x, hx⟩, MonoidHom.mem_ker.mpr ((gspinNorm_eq_one_iff ⟨x, hx⟩).mpr h), rfl⟩
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y.property, (gspinNorm_eq_one_iff y).mp (MonoidHom.mem_ker.mp hy)⟩

/-! ### The vector action of the Clifford group -/

variable (Q) in
/-- **The vector action** `ρ : GPin(Q) → O(Q)` of the Clifford group, in every characteristic,
whenever `ι` and the scalars embed in the Clifford algebra (for instance for a free module, by
`CliffordAlgebra.ι_injective_of_free` and `CliffordAlgebra.algebraMap_injective_of_free`):
`ι (ρ(g) v) = α(g) ι(v) g⁻¹`. -/
noncomputable def gpinToOrthogonal (hι : Function.Injective (ι Q))
    (hinj : Function.Injective (algebraMap R (CliffordAlgebra Q))) :
    gpinGroup Q →* TauCeti.QuadraticMap.orthogonalGroup Q :=
  ((vectorNormalizerAction hι).comp
    (Subgroup.inclusion (gpinGroup_le_vectorNormalizer Q))).codRestrict _ fun _ =>
      TauCeti.QuadraticMap.mem_orthogonalGroup_iff.mpr (vectorNormalizerAction_map_app hι hinj _)

/-- The vector action of the Clifford group is twisted conjugation. -/
@[simp]
theorem ι_gpinToOrthogonal_apply (hι : Function.Injective (ι Q))
    (hinj : Function.Injective (algebraMap R (CliffordAlgebra Q))) (x : gpinGroup Q) (m : M) :
    ι Q ((gpinToOrthogonal Q hι hinj x : M ≃ₗ[R] M) m) =
      involute ((x : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * ι Q m *
        (((x : (CliffordAlgebra Q)ˣ)⁻¹ : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) :=
  ι_vectorNormalizerAction_apply hι _ m

end CliffordAlgebra
