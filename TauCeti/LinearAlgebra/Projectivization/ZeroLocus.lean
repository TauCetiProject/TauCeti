module

public import Mathlib.Algebra.Module.LinearMap.Polynomial
public import Mathlib.Basic.Complex.Basic
public import Mathlib.LinearAlgebra.Projectivization.Cardinality
public import TauCeti.LinearAlgebra.Projectivization.Basic
public import TauCeti.RingTheory.MvPolynomial.Dehomogenization

/-!
# Zero loci of polynomial families in complex projective space

For a family `p : ι → MvPolynomial (Fin N) ℂ`, the set `complexProjectiveZeroLocus p` consists of
the complex lines `L` in `ℂ^N`, that is the points of `Projectivization ℂ (Fin N → ℂ)`, such that
every `p i` vanishes at every vector of `L`. Asking for vanishing on the whole line, rather than at
one representative, makes the set independent of any choice and meaningful for arbitrary
polynomials: a nonzero constant equation cuts out the empty set and the zero equation cuts out
everything. When each `p i` is homogeneous, testing one nonzero representative suffices, and in
the standard affine chart where coordinate `i` is nonzero the zero locus is cut out by the
dehomogenized equations `dehomogenize i (p k)` in the coordinate ratios.

The zero locus only depends on the ideal generated by the equations. In particular reindexing and
adding or removing equations lying in that ideal do not change it. Replacing equations by positive
powers changes the ideal but not its radical, and does not change the zero locus either: it is a
reduced zero set, not a presentation. Unions of families of equations give intersections of zero
loci, and pulling equations back along an injective linear map `ℂ^N → ℂ^M` computes the preimage
under the induced map of projective spaces.

## Main definitions

* `TauCeti.complexProjectiveZeroLocus p`: the common zero locus of the family `p` in
  `Projectivization ℂ (Fin N → ℂ)`.

## Main results

* `TauCeti.complexProjectiveZeroLocus_mk_iff_forall_smul`: the class of a nonzero vector `v` lies
  in the zero locus exactly when every `p i` vanishes on every multiple of `v`.
* `TauCeti.complexProjectiveZeroLocus_mk_iff`: for homogeneous equations, the class of a nonzero
  vector `v` lies in the zero locus exactly when every `p i` vanishes at `v`.
* `TauCeti.complexProjectiveZeroLocus_mk_iff_dehomogenize` and
  `TauCeti.complexProjectiveZeroLocus_mk_insertNth_iff`: the equations of the zero locus in the
  standard affine charts.
* `TauCeti.complexProjectiveZeroLocus_subset_of_forall_mem_span`: equations lying in the ideal
  generated by another family vanish on its zero locus.
* `TauCeti.complexProjectiveZeroLocus_eq_of_span_eq`: the zero locus only depends on the ideal
  generated by the equations.
* `TauCeti.complexProjectiveZeroLocus_sumElim` and `TauCeti.complexProjectiveZeroLocus_sigma`:
  unions of families of equations cut out intersections of zero loci.
* `TauCeti.complexProjectiveZeroLocus_pow`: replacing equations by positive powers does not change
  the zero locus.
* `TauCeti.preimage_map_complexProjectiveZeroLocus`: the preimage of a zero locus under the
  projective map induced by an injective linear map is the zero locus of the pulled-back
  equations.
-/

public section

open MvPolynomial
open scoped LinearAlgebra.Projectivization

namespace TauCeti

variable {N : ℕ} {ι : Type*}

/-- The common zero locus of a family of polynomials in `N` variables, as a set of complex lines
in `ℂ^N`: a line belongs to it when every polynomial of the family vanishes at every vector of
the line. The line of `L` is `L.submodule`, which is the underlying submodule of
`Projectivization.equivSubmodule ℂ (Fin N → ℂ) L`. -/
def complexProjectiveZeroLocus (p : ι → MvPolynomial (Fin N) ℂ) :
    Set (ℙ ℂ (Fin N → ℂ)) :=
  {L | ∀ i, ∀ v ∈ L.submodule, eval v (p i) = 0}

/-- Membership in the zero locus unfolds to vanishing on every vector of the line. -/
@[simp]
theorem mem_complexProjectiveZeroLocus {p : ι → MvPolynomial (Fin N) ℂ}
    {L : ℙ ℂ (Fin N → ℂ)} :
    L ∈ complexProjectiveZeroLocus p ↔ ∀ i, ∀ v ∈ L.submodule, eval v (p i) = 0 :=
  Iff.rfl

/-- The class of a nonzero vector `v` lies in the zero locus exactly when every equation
vanishes at every scalar multiple of `v`. No homogeneity is needed. -/
theorem complexProjectiveZeroLocus_mk_iff_forall_smul {p : ι → MvPolynomial (Fin N) ℂ}
    (v : Fin N → ℂ) (hv : v ≠ 0) :
    Projectivization.mk ℂ v hv ∈ complexProjectiveZeroLocus p ↔
      ∀ i, ∀ c : ℂ, eval (c • v) (p i) = 0 := by
  simp only [mem_complexProjectiveZeroLocus, Projectivization.submodule_mk,
    Submodule.mem_span_singleton, forall_exists_index, forall_apply_eq_imp_iff]

/-- For homogeneous equations, the class of a nonzero vector `v` lies in the zero locus exactly
when every equation vanishes at `v`. This includes equations of degree zero, which are constants
and vanish at `v` exactly when they are zero. -/
theorem complexProjectiveZeroLocus_mk_iff {p : ι → MvPolynomial (Fin N) ℂ} {d : ι → ℕ}
    (hp : ∀ i, (p i).IsHomogeneous (d i)) (v : Fin N → ℂ) (hv : v ≠ 0) :
    Projectivization.mk ℂ v hv ∈ complexProjectiveZeroLocus p ↔ ∀ i, eval v (p i) = 0 := by
  rw [complexProjectiveZeroLocus_mk_iff_forall_smul]
  refine forall_congr' fun i ↦ ⟨fun h ↦ by simpa using h 1, fun h c ↦ ?_⟩
  rw [(hp i).eval_smul, h, smul_zero]

/-- For homogeneous equations, membership in the zero locus can be tested on the chosen
representative `L.rep`. -/
theorem mem_complexProjectiveZeroLocus_iff_eval_rep {p : ι → MvPolynomial (Fin N) ℂ}
    {d : ι → ℕ} (hp : ∀ i, (p i).IsHomogeneous (d i)) (L : ℙ ℂ (Fin N → ℂ)) :
    L ∈ complexProjectiveZeroLocus p ↔ ∀ i, eval L.rep (p i) = 0 := by
  conv_lhs => rw [← L.mk_rep]
  exact complexProjectiveZeroLocus_mk_iff hp _ _

/-- **Chart equations.** In the standard affine chart where coordinate `i` is nonzero, a
homogeneous family cuts out the zero locus of its dehomogenizations: the class of `v` with
`v i ≠ 0` lies in the zero locus exactly when every `dehomogenize i (p k)` vanishes at the
coordinate ratios `v (i.succAbove j) / v i`. -/
theorem complexProjectiveZeroLocus_mk_iff_dehomogenize {n : ℕ}
    {p : ι → MvPolynomial (Fin (n + 1)) ℂ} {d : ι → ℕ} (hp : ∀ k, (p k).IsHomogeneous (d k))
    (v : Fin (n + 1) → ℂ) {i : Fin (n + 1)} (hi : v i ≠ 0) :
    Projectivization.mk ℂ v (Function.ne_iff.mpr ⟨i, hi⟩) ∈ complexProjectiveZeroLocus p ↔
      ∀ k, eval (fun j ↦ v (i.succAbove j) / v i) (dehomogenize i (p k)) = 0 := by
  rw [complexProjectiveZeroLocus_mk_iff hp]
  refine forall_congr' fun k ↦ ?_
  rw [eval_dehomogenize_div i (hp k) v hi, mul_eq_zero,
    or_iff_right (pow_ne_zero _ (inv_ne_zero hi))]

/-- The inverse chart: the class of the vector `[z₀ : ⋯ : 1 : ⋯ : zₙ₋₁]`, with `1` inserted at
coordinate `i`, lies in the zero locus of a homogeneous family exactly when `z` is a common zero of
the dehomogenizations `dehomogenize i (p k)`. -/
theorem complexProjectiveZeroLocus_mk_insertNth_iff {n : ℕ}
    {p : ι → MvPolynomial (Fin (n + 1)) ℂ} {d : ι → ℕ} (hp : ∀ k, (p k).IsHomogeneous (d k))
    (i : Fin (n + 1)) (z : Fin n → ℂ) :
    Projectivization.mk ℂ (i.insertNth 1 z) (Function.ne_iff.mpr ⟨i, by simp⟩) ∈
      complexProjectiveZeroLocus p ↔
      ∀ k, eval z (dehomogenize i (p k)) = 0 := by
  simp [complexProjectiveZeroLocus_mk_iff hp]

/-- In `ℂ⁰` there are no lines, so every zero locus is empty. -/
@[simp]
theorem complexProjectiveZeroLocus_of_fin_zero (p : ι → MvPolynomial (Fin 0) ℂ) :
    complexProjectiveZeroLocus p = ∅ :=
  Set.eq_empty_of_isEmpty _

/-- The empty family of equations cuts out the whole projective space. -/
@[simp]
theorem complexProjectiveZeroLocus_of_isEmpty [IsEmpty ι] (p : ι → MvPolynomial (Fin N) ℂ) :
    complexProjectiveZeroLocus p = Set.univ :=
  Set.eq_univ_of_forall fun _ ↦ isEmptyElim

/-- The family of zero equations cuts out the whole projective space. -/
@[simp]
theorem complexProjectiveZeroLocus_zero :
    complexProjectiveZeroLocus (0 : ι → MvPolynomial (Fin N) ℂ) = Set.univ :=
  Set.eq_univ_of_forall fun _ _ _ _ ↦ by simp

/-- A nonzero constant equation cuts out the empty set. -/
theorem complexProjectiveZeroLocus_eq_empty_of_eq_C {p : ι → MvPolynomial (Fin N) ℂ} {i : ι}
    {c : ℂ} (hpi : p i = C c) (hc : c ≠ 0) :
    complexProjectiveZeroLocus p = ∅ :=
  Set.eq_empty_of_forall_notMem fun L hL ↦ hc <| by
    simpa [hpi] using hL i 0 (Submodule.zero_mem _)

/-- Every polynomial in the ideal generated by a family of equations vanishes on its zero locus:
the zero locus of `p` is contained in that of `q` when each `q j` lies in that ideal. -/
theorem complexProjectiveZeroLocus_subset_of_forall_mem_span {κ : Type*}
    {p : ι → MvPolynomial (Fin N) ℂ} {q : κ → MvPolynomial (Fin N) ℂ}
    (h : ∀ j, q j ∈ Ideal.span (Set.range p)) :
    complexProjectiveZeroLocus p ⊆ complexProjectiveZeroLocus q := by
  intro L hL j v hv
  have hker : Ideal.span (Set.range p) ≤ RingHom.ker (eval v) :=
    Ideal.span_le.mpr <| Set.range_subset_iff.mpr fun i ↦ hL i v hv
  exact hker (h j)

/-- The zero locus only depends on the ideal generated by the equations. -/
theorem complexProjectiveZeroLocus_eq_of_span_eq {κ : Type*}
    {p : ι → MvPolynomial (Fin N) ℂ} {q : κ → MvPolynomial (Fin N) ℂ}
    (h : Ideal.span (Set.range p) = Ideal.span (Set.range q)) :
    complexProjectiveZeroLocus p = complexProjectiveZeroLocus q :=
  (complexProjectiveZeroLocus_subset_of_forall_mem_span fun j ↦
      h ▸ Ideal.subset_span (Set.mem_range_self j)).antisymm
    (complexProjectiveZeroLocus_subset_of_forall_mem_span fun i ↦
      h ▸ Ideal.subset_span (Set.mem_range_self i))

/-- Dropping equations enlarges the zero locus: a subfamily, indexed along any map `e`, has a
larger zero locus. -/
theorem complexProjectiveZeroLocus_subset_comp {κ : Type*} (p : ι → MvPolynomial (Fin N) ℂ)
    (e : κ → ι) :
    complexProjectiveZeroLocus p ⊆ complexProjectiveZeroLocus (p ∘ e) :=
  fun _ hL j ↦ hL (e j)

/-- Reindexing a family of equations along a surjection does not change its zero locus. -/
theorem complexProjectiveZeroLocus_comp_of_surjective {κ : Type*}
    (p : ι → MvPolynomial (Fin N) ℂ) {e : κ → ι} (he : Function.Surjective e) :
    complexProjectiveZeroLocus (p ∘ e) = complexProjectiveZeroLocus p :=
  complexProjectiveZeroLocus_eq_of_span_eq <| by rw [Set.range_comp, he.range_eq, Set.image_univ]

/-- Joining two families of equations intersects their zero loci. -/
theorem complexProjectiveZeroLocus_sumElim {κ : Type*} (p : ι → MvPolynomial (Fin N) ℂ)
    (q : κ → MvPolynomial (Fin N) ℂ) :
    complexProjectiveZeroLocus (Sum.elim p q) =
      complexProjectiveZeroLocus p ∩ complexProjectiveZeroLocus q := by
  ext L
  simp [Sum.forall]

/-- Adding equations that lie in the ideal generated by a family does not change its zero
locus. -/
theorem complexProjectiveZeroLocus_sumElim_of_forall_mem_span {κ : Type*}
    (p : ι → MvPolynomial (Fin N) ℂ) {q : κ → MvPolynomial (Fin N) ℂ}
    (h : ∀ j, q j ∈ Ideal.span (Set.range p)) :
    complexProjectiveZeroLocus (Sum.elim p q) = complexProjectiveZeroLocus p := by
  rw [complexProjectiveZeroLocus_sumElim, Set.inter_eq_left]
  exact complexProjectiveZeroLocus_subset_of_forall_mem_span h

/-- The union of a family of families of equations cuts out the intersection of their zero
loci. -/
theorem complexProjectiveZeroLocus_sigma {κ : Type*} {ι : κ → Type*}
    (p : (k : κ) → ι k → MvPolynomial (Fin N) ℂ) :
    complexProjectiveZeroLocus (fun x : Σ k, ι k ↦ p x.1 x.2) =
      ⋂ k, complexProjectiveZeroLocus (p k) := by
  ext L
  simp [Sigma.forall]

/-- Replacing each equation by a positive power does not change the zero locus. -/
theorem complexProjectiveZeroLocus_pow (p : ι → MvPolynomial (Fin N) ℂ) {k : ι → ℕ}
    (hk : ∀ i, k i ≠ 0) :
    complexProjectiveZeroLocus (fun i ↦ p i ^ k i) = complexProjectiveZeroLocus p := by
  ext L
  simp [hk]

/-- The preimage of a zero locus under the map of projective spaces induced by an injective
linear map `f : ℂ^N → ℂ^M` is the zero locus of the equations pulled back along `f`, that is
with each variable `X j` replaced by the `j`-th coordinate of `f` as a linear form. -/
theorem preimage_map_complexProjectiveZeroLocus {M : ℕ} (f : (Fin N → ℂ) →ₗ[ℂ] Fin M → ℂ)
    (hf : Function.Injective f) (q : ι → MvPolynomial (Fin M) ℂ) :
    Projectivization.map f hf ⁻¹' complexProjectiveZeroLocus q =
      complexProjectiveZeroLocus fun i ↦ aeval (LinearMap.toMatrix' f).toMvPolynomial (q i) := by
  ext L
  have hpull (v : Fin N → ℂ) (i : ι) :
      eval v (aeval (LinearMap.toMatrix' f).toMvPolynomial (q i)) = eval (f v) (q i) := by
    simpa only [aeval_eq_eval, Matrix.toMvPolynomial_eval_eq_apply,
      LinearMap.toMatrix'_mulVec] using
      comp_aeval_apply (LinearMap.toMatrix' f).toMvPolynomial (aeval v) (q i)
  simp only [Set.mem_preimage, mem_complexProjectiveZeroLocus, Projectivization.submodule_map,
    Submodule.mem_map, forall_exists_index, and_imp, forall_apply_eq_imp_iff₂, hpull]

end TauCeti
