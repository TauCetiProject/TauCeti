module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.LinearAlgebra.Projectivization.Basic

/-!
# The field of definition of a projective point

The field of definition of a point with coordinates in an extension `F / K` is the
intermediate field generated by all coordinate ratios. It does not depend on the
representative. At any nonzero coordinate, it is generated by the coordinates of the
representative normalized to have that coordinate equal to one.

This field, rather than the field generated by an arbitrary representative, measures the
degree of a projective point in Northcott's theorem. For example, every point represented
by a scalar multiple of `(1, 2)` has field of definition `K`.

## References

* E. Bombieri and W. Gubler, *Heights in Diophantine Geometry* (2006), §1.5 and Theorem 1.6.8.
-/

public section

namespace Projectivization

open IntermediateField

variable (K : Type*) {F ι : Type*} [Field K] [Field F] [Algebra K F]

/-- The field generated over `K` by the coordinate ratios of a projective point. -/
noncomputable def fieldOfDefinition (p : Projectivization F (ι → F)) : IntermediateField K F :=
  p.lift (fun (x : {v : ι → F // v ≠ 0}) ↦
    adjoin K (Set.range fun ij : ι × ι ↦ x.1 ij.1 / x.1 ij.2)) (by
    intro x y c h
    have hc : c ≠ 0 := by
      intro hc
      exact x.2 (by simpa [hc] using h)
    simp only [h, Pi.smul_apply, smul_eq_mul, mul_div_mul_left _ _ hc])

/-- Computing the field of definition from any nonzero representative. -/
theorem fieldOfDefinition_mk {x : ι → F} (hx : x ≠ 0) :
    fieldOfDefinition K (mk F x hx) =
      adjoin K (Set.range fun ij : ι × ι ↦ x ij.1 / x ij.2) := by
  simp [fieldOfDefinition]

/-- The field of definition is the smallest intermediate field containing all coordinate
ratios of a representative. -/
theorem fieldOfDefinition_mk_le_iff {x : ι → F} (hx : x ≠ 0)
    {E : IntermediateField K F} :
    fieldOfDefinition K (mk F x hx) ≤ E ↔ ∀ i j, x i / x j ∈ E := by
  rw [fieldOfDefinition_mk, adjoin_le_iff]
  simp [Set.range_subset_iff, Prod.forall]

/-- Every coordinate ratio of a representative belongs to the field of definition. -/
theorem div_mem_fieldOfDefinition {x : ι → F} (hx : x ≠ 0) (i j : ι) :
    x i / x j ∈ fieldOfDefinition K (mk F x hx) := by
  rw [fieldOfDefinition_mk]
  exact subset_adjoin K _ (Set.mem_range_self (i, j))

/-- At any nonzero coordinate the field of definition is generated by the normalized
coordinates at that coordinate. -/
theorem fieldOfDefinition_mk_eq_adjoin_div {x : ι → F} (hx : x ≠ 0) {i : ι}
    (hi : x i ≠ 0) :
    fieldOfDefinition K (mk F x hx) = adjoin K (Set.range fun j ↦ x j / x i) := by
  rw [fieldOfDefinition_mk]
  apply le_antisymm
  · refine adjoin_le_iff.mpr ?_
    rintro _ ⟨⟨j, k⟩, rfl⟩
    have hj := subset_adjoin K (Set.range fun j ↦ x j / x i) (Set.mem_range_self j)
    have hk := subset_adjoin K (Set.range fun j ↦ x j / x i) (Set.mem_range_self k)
    simpa [div_div_div_cancel_right₀ hi] using div_mem hj hk
  · refine adjoin_le_iff.mpr ?_
    rintro _ ⟨j, rfl⟩
    exact subset_adjoin K _ (Set.mem_range_self (j, i))

/-- A representative with a coordinate equal to one generates exactly the field of definition. -/
theorem fieldOfDefinition_mk_eq_adjoin {x : ι → F} (hx : x ≠ 0) {i : ι}
    (hi : x i = 1) :
    fieldOfDefinition K (mk F x hx) = adjoin K (Set.range x) := by
  simpa [hi] using fieldOfDefinition_mk_eq_adjoin_div K hx (by simp [hi] : x i ≠ 0)

/-- The field of definition of the affine point `(a : 1)` is the simple extension `K(a)`. -/
@[simp]
theorem fieldOfDefinition_mk_pair (a : F) :
    fieldOfDefinition K (mk F ![a, 1] (by simp)) = K⟮a⟯ := by
  rw [fieldOfDefinition_mk_eq_adjoin K (by simp) (i := 1) (by simp)]
  apply le_antisymm
  · refine adjoin_le_iff.mpr ?_
    rintro _ ⟨i, rfl⟩
    fin_cases i
    · exact mem_adjoin_simple_self K a
    · exact one_mem _
  · exact adjoin_simple_le_iff.mpr (subset_adjoin K _ (Set.mem_range_self 0))

/-- The field of definition of a finite projective tuple with algebraic coordinates is finite
over the base field. No finiteness of the ambient extension is needed. -/
instance [Finite ι] [Algebra.IsAlgebraic K F] (p : Projectivization F (ι → F)) :
    FiniteDimensional K (fieldOfDefinition K p) := by
  rw [← p.mk_rep, fieldOfDefinition_mk]
  exact finiteDimensional_adjoin fun x _ ↦ (Algebra.IsAlgebraic.isAlgebraic x).isIntegral

end Projectivization
