/-!
# Generation of the standard special unitary group by Siegel transformations

Let `σ` be an involution of a field `K` and let `Q_r = TauCeti.typeAGraphConjugator r K`. Its
sesquilinear form `B(x, y) = (σ ∘ x) ⬝ᵥ (Q_r *ᵥ y)` is `(-1) ^ r`-Hermitian. Under surjectivity of
the signed trace `t ↦ t + (-1) ^ r * σ(t)` onto `{s | σ(s) = (-1) ^ r * s}` and existence of a
nonzero kernel element `d ≠ 0` with `d + (-1) ^ r * σ(d) = 0`, this file proves that
`Q_r.specialIsometryGroup σ` is generated by its admissible Siegel transformations `S(u, w, c)` for
every rank `r`, via the border embedding
`(Q_{r'}).specialIsometryGroup σ ↪ (Q_{r' + 2}).specialIsometryGroup σ` given by
`A ↦ diag(1, A, 1)` (`Matrix.cornerBlockSucc 1 ∘ Matrix.blockSucc`), whose inner block carries the
negated form `−Q_{r'}`.

## Main results

* `TauCeti.unitaryTransvection_typeAGraphConjugator_single`: for `i ≠ i.rev`, the unitary
  transvection of `Q_r` along `eᵢ` is the elementary transvection
  `1 + (-1) ^ i * a * E_{i, i.rev}`.
* `TauCeti.diag2n_zero_last_mem_elementaryUnitaryGroup_typeAGraphConjugator`: for `σ(t) = t`
  (`t ≠ 0`), `diag(t, 1, …, 1, t⁻¹)` lies in `Q_r.specialIsometryGroup σ` and in
  `Q_r.elementaryUnitaryGroup σ`.
* `TauCeti.subgroup_typeAGraphConjugator_eq_top_of_siegelTransvection_mem`: any subgroup of
  `Q_r.specialIsometryGroup σ` containing all admissible Siegel transformations is `⊤`.

## References

* D. E. Taylor, *The Geometry of the Classical Groups* (1992), Chapter 11.
-/

public section

open Matrix

namespace TauCeti

section CommRing

variable {R : Type*} [CommRing R]

/-- A unitary transvection of `Q_r = typeAGraphConjugator r R` along a standard coordinate vector
`eᵢ` with `i ≠ i.rev` is the elementary transvection `1 + (-1) ^ i * a * E_{i, i.rev}`. -/
theorem unitaryTransvection_typeAGraphConjugator_single (σ : R →+* R) {r : ℕ}
    {i : Fin (r + 1)} (hi : i ≠ i.rev) (a : R) :
    (typeAGraphConjugator r R : Matrix (Fin (r + 1)) (Fin (r + 1)) R).unitaryTransvection σ
        (Pi.single i 1) a =
      (Matrix.SpecialLinearGroup.transvection hi ((-1 : R) ^ (i : ℕ) * a) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) R) := by
  refine mulVec_injective (funext fun v ↦ ?_)
  rw [unitaryTransvection_mulVec, comp_single_dotProduct_typeAGraphConjugator_mulVec,
    Matrix.SpecialLinearGroup.transvection_coe, add_mulVec, one_mulVec, Matrix.single_mulVec_eq]
  simp [mul_assoc, mul_comm]

end CommRing

section Field

variable {K : Type*} [Field K] {σ : K →+* K}

private theorem specialIsometryGroup_mul_mulVec {n : Type*} [Fintype n] [DecidableEq n]
    {Q : Matrix n n K} (g₁ g₂ : Q.specialIsometryGroup σ) (v : n → K) :
    (((g₁ * g₂ : Q.specialIsometryGroup σ) : Matrix.SpecialLinearGroup n K) :
      Matrix n n K) *ᵥ v =
      ((g₁ : Matrix.SpecialLinearGroup n K) : Matrix n n K) *ᵥ
        (((g₂ : Matrix.SpecialLinearGroup n K) : Matrix n n K) *ᵥ v) := by
  rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, ← mulVec_mulVec]

private theorem comp_single_zero_last_typeAGraphConjugator (σ : K →+* K) (r : ℕ) :
    (σ ∘ Pi.single 0 1) ⬝ᵥ
        ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ
          Pi.single (Fin.last r) 1) = 1 ∧
      (σ ∘ Pi.single (Fin.last r) 1) ⬝ᵥ
        ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ
          Pi.single 0 1) = (-1 : K) ^ r := by
  constructor
  · rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]
    simp [Fin.rev_zero]
  · rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]
    simp [Fin.rev_last]

private theorem corner_transvections_mem_elementary (hσ : Function.Involutive σ) {r : ℕ}
    (h0r : (0 : Fin (r + 1)) ≠ Fin.last r) {d : K}
    (hd : d + (-1 : K) ^ r * σ d = 0) {s : K} (hs : σ s = s) :
    (∃ hm : Matrix.SpecialLinearGroup.transvection h0r (s * d) ∈
        (typeAGraphConjugator r K :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ,
      (⟨_, hm⟩ : (typeAGraphConjugator r K :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ) ∈
        (typeAGraphConjugator r K :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K).elementaryUnitaryGroup σ) ∧
    (∃ hm : Matrix.SpecialLinearGroup.transvection h0r.symm (s * d⁻¹) ∈
        (typeAGraphConjugator r K :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ,
      (⟨_, hm⟩ : (typeAGraphConjugator r K :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ) ∈
        (typeAGraphConjugator r K :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K).elementaryUnitaryGroup σ) := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single_zero (σ := σ) h0r
  have her := comp_single_dotProduct_typeAGraphConjugator_mulVec_single_last (σ := σ) h0r
  constructor
  · have ha : s * d + (-1 : K) ^ r * σ (s * d) = 0 := by rw [map_mul, hs]; linear_combination s * hd
    obtain ⟨⟨g, hg⟩, hgW, hga⟩ := exists_mem_elementaryUnitaryGroup_coe_eq hσ hQ he0 ha
    have hge : g = Matrix.SpecialLinearGroup.transvection h0r (s * d) := by
      refine Subtype.ext ?_
      rw [hga, unitaryTransvection_typeAGraphConjugator_single σ (i := 0) (by rwa [Fin.rev_zero])]
      simp [Matrix.SpecialLinearGroup.transvection_coe, Fin.rev_zero]
    subst hge; exact ⟨hg, hgW⟩
  · have ha : (-1 : K) ^ r * (s * d⁻¹) + (-1 : K) ^ r * σ ((-1 : K) ^ r * (s * d⁻¹)) = 0 := by
      rcases neg_one_pow_eq_or K r with hr | hr <;> rw [hr] at hd ⊢
      · have hσd : σ d = -d := by linear_combination hd
        simp only [one_mul, map_mul, map_inv₀, hs, hσd, inv_neg]; ring
      · have hσd : σ d = d := by linear_combination -hd
        simp only [neg_one_mul, map_neg, map_mul, map_inv₀, hs, hσd]; ring
    obtain ⟨⟨g, hg⟩, hgW, hga⟩ := exists_mem_elementaryUnitaryGroup_coe_eq hσ hQ her ha
    have hsign : (-1 : K) ^ r * (-1 : K) ^ r = 1 := by
      rw [← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow]
    have hge : g = Matrix.SpecialLinearGroup.transvection h0r.symm (s * d⁻¹) := by
      refine Subtype.ext ?_
      rw [hga, unitaryTransvection_typeAGraphConjugator_single σ (i := Fin.last r)
        (by rw [Fin.rev_last]; exact h0r.symm)]
      simp only [Matrix.SpecialLinearGroup.transvection_coe, Fin.val_last, Fin.rev_last]
      congr 2
      linear_combination (s * d⁻¹) * hsign
    subst hge; exact ⟨hg, hgW⟩

/-- **Corner diagonal torus elements belong to the elementary unitary group.** For an involution
`σ`, a nonzero rank `r`, a nonzero element `d` with `d + (-1) ^ r * σ(d) = 0`, and any nonzero
`σ`-fixed scalar `t`, the diagonal matrix `diag(t, 1, …, 1, t⁻¹)` lies in
`Q_r.specialIsometryGroup σ` and in `Q_r.elementaryUnitaryGroup σ`. -/
theorem diag2n_zero_last_mem_elementaryUnitaryGroup_typeAGraphConjugator
    (hσ : Function.Involutive σ) {r : ℕ} (h0r : (0 : Fin (r + 1)) ≠ Fin.last r)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ r * σ d = 0) {t : K}
    (ht0 : t ≠ 0) (ht : σ t = t) :
    ∃ hmem : Matrix.SpecialLinearGroup.diag2n h0r t ht0 ∈
        (typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ,
      (⟨Matrix.SpecialLinearGroup.diag2n h0r t ht0, hmem⟩ :
        (typeAGraphConjugator r K :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ) ∈
        (typeAGraphConjugator r K :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K).elementaryUnitaryGroup σ := by
  obtain ⟨d, hd0, hd⟩ := hadm
  obtain ⟨⟨hm1, h1⟩, -⟩ := corner_transvections_mem_elementary hσ h0r hd ht
  obtain ⟨-, ⟨hm2, h2⟩⟩ := corner_transvections_mem_elementary hσ h0r hd
    (s := -t⁻¹) (by rw [map_neg, map_inv₀, ht])
  obtain ⟨⟨hm3, h3⟩, -⟩ := corner_transvections_mem_elementary hσ h0r hd (s := -1) (by simp)
  obtain ⟨-, ⟨hm4, h4⟩⟩ := corner_transvections_mem_elementary hσ h0r hd (s := 1) (map_one σ)
  let prodW : (typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ :=
    ⟨_, hm1⟩ * ⟨_, hm2⟩ * ⟨_, hm1⟩ * ⟨_, hm3⟩ * ⟨_, hm4⟩ * ⟨_, hm3⟩
  have hmemW : prodW ∈ (typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).elementaryUnitaryGroup σ :=
    mul_mem (mul_mem (mul_mem (mul_mem (mul_mem h1 h2) h1) h3) h4) h3
  have hcoe : (prodW : Matrix.SpecialLinearGroup (Fin (r + 1)) K) =
      Matrix.SpecialLinearGroup.diag2n h0r t ht0 := by
    rw [← Matrix.SpecialLinearGroup.diag2nUnit_mk0 h0r t ht0,
      Matrix.SpecialLinearGroup.diag2nUnit_eq_mul_six_transvections h0r
        (Units.mk0 t ht0) (Units.mk0 d hd0)]
    simp [prodW]
  obtain ⟨prodSL, hprodQ⟩ := prodW
  dsimp only at hcoe; subst hcoe
  exact ⟨hprodQ, hmemW⟩

/-! ### The Siegel-generated subgroup and scaling `(e₀, e_r)` -/

private def siegelClosure (σ : K →+* K) (r : ℕ) :
    Subgroup ((typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ) :=
  Subgroup.closure {g | ∃ (u w : Fin (r + 1) → K) (c : K),
    (σ ∘ u) ⬝ᵥ ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ u) = 0 ∧
    (σ ∘ u) ⬝ᵥ ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w) = 0 ∧
    c + (-1 : K) ^ r * σ c + (-1 : K) ^ r *
      ((σ ∘ w) ⬝ᵥ ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w)) = 0 ∧
    ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix _ _ K) =
      (typeAGraphConjugator r K :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K).siegelTransvection σ ((-1 : K) ^ r) u w c}

private theorem mem_siegelClosure_of_coe_eq {r : ℕ}
    {g : (typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ}
    {u w : Fin (r + 1) → K} {c : K}
    (hu : (σ ∘ u) ⬝ᵥ
      ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ u) = 0)
    (huw : (σ ∘ u) ⬝ᵥ
      ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w) = 0)
    (hc : c + (-1 : K) ^ r * σ c + (-1 : K) ^ r *
      ((σ ∘ w) ⬝ᵥ ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w)) = 0)
    (hg : ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix _ _ K) =
      (typeAGraphConjugator r K :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K).siegelTransvection σ ((-1 : K) ^ r) u w c) :
    g ∈ siegelClosure σ r :=
  Subgroup.subset_closure ⟨u, w, c, hu, huw, hc, hg⟩

private theorem elementaryUnitaryGroup_le_siegelClosure (hσ : Function.Involutive σ) (r : ℕ) :
    (typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K).elementaryUnitaryGroup σ ≤
      siegelClosure σ r := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have hdet : (typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K).det ≠ 0 :=
    (isUnits_det_units _).ne_zero
  rw [elementaryUnitaryGroup_eq_iSup]
  refine iSup_le fun p g hg ↦ ?_
  obtain ⟨a, ha⟩ := mem_unitaryTransvectionSubgroup_iff.mp hg
  have hadm := (exists_coe_eq_unitaryTransvection_iff hσ hQ hdet p a).mp ⟨⟨g, hg⟩, ha⟩
  exact mem_siegelClosure_of_coe_eq (w := 0) (c := a) (comp_rep_dotProduct_mulVec_rep p) (by simp)
    (by simp [hadm]) (by rwa [siegelTransvection_zero_eq_unitaryTransvection])

private theorem exists_isotropic_pairings_of_three_le (hσ : Function.Involutive σ) {r : ℕ}
    (hr : 3 ≤ r) (z : K) :
    ∃ v : Fin (r + 1) → K,
      (σ ∘ v) ⬝ᵥ ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) = 0 ∧
      (σ ∘ Pi.single 0 1) ⬝ᵥ
        ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) = 1 ∧
      (σ ∘ Pi.single (Fin.last r) 1) ⬝ᵥ
        ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) =
          (-1 : K) ^ r * z := by
  -- Supported on `{0, 1, r - 1, r}`; the inner hyperbolic pair `{1, r - 1}` cancels the
  -- pairing of `z • e₀` and `e_r`.
  let i₁ : Fin (r + 1) := ⟨1, by omega⟩
  let i₂ : Fin (r + 1) := i₁.rev
  have h01 : (0 : Fin (r + 1)) ≠ i₁ := by simp [i₁, Fin.ext_iff]
  have h02 : (0 : Fin (r + 1)) ≠ i₂ := by simp [i₂, i₁, Fin.rev, Fin.ext_iff]; omega
  have h0r : (0 : Fin (r + 1)) ≠ Fin.last r := by simp [Fin.ext_iff]; omega
  have h12 : i₁ ≠ i₂ := by simp [i₂, i₁, Fin.rev, Fin.ext_iff]; omega
  have h1r : i₁ ≠ Fin.last r := by simp [i₁, Fin.ext_iff]; omega
  have h2r : i₂ ≠ Fin.last r := by simp [i₂, i₁, Fin.rev, Fin.ext_iff]; omega
  set v : Fin (r + 1) → K :=
    z • Pi.single 0 1 + Pi.single i₁ 1 + σ z • Pi.single i₂ 1 + Pi.single (Fin.last r) 1
  refine ⟨v, ?_, ?_, ?_⟩
  · have hv0 : v 0 = z := by simp [v, h01, h02, h0r]
    have hv1 : v i₁ = 1 := by simp [v, h01.symm, h12, h1r]
    have hv2 : v i₂ = σ z := by simp [v, h02.symm, h12.symm, h2r]
    have hvr : v (Fin.last r) = 1 := by simp [v, h0r.symm, h1r.symm, h2r.symm]
    have hi₁rev : i₁.rev = i₂ := rfl
    have hi₂val : (i₂ : ℕ) = r - 1 := by simp [i₂, i₁, Fin.rev]
    rw [dotProduct_typeAGraphConjugator_mulVec]
    have hterm (k : Fin (r + 1)) :
        (-1 : K) ^ (k : ℕ) * ((σ ∘ v) k * v k.rev) =
          (if k = 0 then σ z else 0) + (if k = i₁ then -σ z else 0) +
          (if k = i₂ then (-1 : K) ^ (r - 1) * z else 0) +
          (if k = Fin.last r then (-1 : K) ^ r * z else 0) := by
      by_cases hk0 : k = 0
      · subst hk0; simp [hv0, Fin.rev_zero, hvr, h01, h02, h0r]
      by_cases hk1 : k = i₁
      · subst hk1; simp [hk0, hv1, hi₁rev, hv2, h12, h1r, i₁]
      by_cases hk2 : k = i₂
      · subst hk2
        rw [Function.comp_apply, hv2, Fin.rev_rev i₁, hv1, hσ, mul_one, hi₂val]
        simp [hk0, hk1, h2r]
      by_cases hkr : k = Fin.last r
      · subst hkr; simp [hk0, hk1, hk2, hvr, Fin.rev_last, hv0]
      · simp [hk0, hk1, hk2, hkr, v, Pi.single_apply]
    simp only [hterm, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
    have hr1 : (-1 : K) ^ r = -((-1 : K) ^ (r - 1)) := by
      conv_lhs => rw [← Nat.sub_add_cancel (by omega : 1 ≤ r)]
      rw [pow_succ]; ring
    rw [hr1]; ring
  · rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]
    simp [v, Fin.rev_zero, h0r.symm, h1r.symm, h2r.symm]
  · rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]
    simp [v, Fin.rev_last, h01, h02, h0r]

private theorem exists_mem_siegelClosure_mulVec_last_eq_smul_zero_of_exists_isotropic
    (hσ : Function.Involutive σ) {r : ℕ} (h0r : (0 : Fin (r + 1)) ≠ Fin.last r)
    {t : K} (ht0 : t ≠ 0) {v : Fin (r + 1) → K}
    (hv : (σ ∘ v) ⬝ᵥ ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) = 0)
    (h0v : (σ ∘ Pi.single 0 1) ⬝ᵥ
      ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) = 1)
    (hrv : (σ ∘ Pi.single (Fin.last r) 1) ⬝ᵥ
      ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) =
        (-1 : K) ^ r * t) :
    ∃ m ∈ siegelClosure σ r,
      ((m : Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ
        Pi.single (Fin.last r) 1 = t • Pi.single 0 1 := by
  let Q := (typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K)
  let ε := (-1 : K) ^ r
  have hQ : (Q.map σ)ᵀ = ε • Q := transpose_map_typeAGraphConjugator σ r
  let e0 : Fin (r + 1) → K := Pi.single 0 1
  let er : Fin (r + 1) → K := Pi.single (Fin.last r) 1
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single_zero (σ := σ) h0r
  have her := comp_single_dotProduct_typeAGraphConjugator_mulVec_single_last (σ := σ) h0r
  obtain ⟨he0r, her0⟩ := comp_single_zero_last_typeAGraphConjugator σ r
  have hε0 : ε ≠ 0 := pow_ne_zero r (neg_ne_zero.mpr one_ne_zero)
  obtain ⟨g₁, hg₁, w₁, c₁, huw₁, hc₁, hS₁, -, hg₁er⟩ :=
    exists_mem_specialIsometryGroup_coe_eq_siegelTransvection_mulVec_eq_self_and_mulVec_eq
      hσ hQ he0 her hv (by rw [he0r]; exact one_ne_zero) (he0r.trans h0v.symm)
  have hte0 : (σ ∘ (t • e0)) ⬝ᵥ (Q *ᵥ (t • e0)) = 0 := by
    rw [comp_smul_dotProduct_mulVec_smul, he0, mul_zero]
  have hrte0 : (σ ∘ er) ⬝ᵥ (Q *ᵥ (t • e0)) = ε * t := by
    rw [mulVec_smul, dotProduct_smul, smul_eq_mul, her0, mul_comm]
  obtain ⟨g₂, hg₂, w₂, c₂, huw₂, hc₂, hS₂, -, hg₂v⟩ :=
    exists_mem_specialIsometryGroup_coe_eq_siegelTransvection_mulVec_eq_self_and_mulVec_eq
      hσ hQ her hv hte0 (by rw [hrv]; exact mul_ne_zero hε0 ht0) (hrv.trans hrte0.symm)
  refine ⟨⟨g₂, hg₂⟩ * ⟨g₁, hg₁⟩, mul_mem (mem_siegelClosure_of_coe_eq her huw₂ hc₂ hS₂)
    (mem_siegelClosure_of_coe_eq he0 huw₁ hc₁ hS₁), ?_⟩
  rw [specialIsometryGroup_mul_mulVec, hg₁er, hg₂v]

private theorem inv_mul_mulVec_last_eq_smul {r : ℕ}
    {m₁ m₂ : (typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ}
    {t₁ t₂ : K} (ht₁0 : t₁ ≠ 0)
    (hm₁ : ((m₁ : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ Pi.single (Fin.last r) 1 = t₁ • Pi.single 0 1)
    (hm₂ : ((m₂ : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ Pi.single (Fin.last r) 1 = t₂ • Pi.single 0 1) :
    (((m₁⁻¹ * m₂ : (typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ) :
        Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ
        Pi.single (Fin.last r) 1 = (t₂ * t₁⁻¹) • Pi.single (Fin.last r) 1 := by
  have hm₁inv : ((m₁⁻¹ : (typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ) :
      Matrix.SpecialLinearGroup (Fin (r + 1)) K).val *ᵥ Pi.single 0 1 =
      t₁⁻¹ • Pi.single (Fin.last r) 1 := by
    have h := congrArg (((m₁⁻¹ : (typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ) :
        Matrix.SpecialLinearGroup (Fin (r + 1)) K).val *ᵥ ·) hm₁
    rw [← specialIsometryGroup_mul_mulVec, inv_mul_cancel, Subgroup.coe_one,
      Matrix.SpecialLinearGroup.coe_one, one_mulVec, mulVec_smul] at h
    exact ((inv_smul_eq_iff₀ ht₁0).mpr h).symm
  rw [specialIsometryGroup_mul_mulVec, hm₂, mulVec_smul, hm₁inv, smul_smul]

private theorem exists_mem_siegelClosure_two_mulVec_last_of_fixed (hσ : Function.Involutive σ)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ 2 * σ d = 0) {c : K} (hc0 : c ≠ 0) (hc : σ c = c) :
    ∃ D ∈ siegelClosure σ 2,
      ((D : Matrix.SpecialLinearGroup (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) *ᵥ
        Pi.single (Fin.last 2) 1 = c • Pi.single (Fin.last 2) 1 := by
  have h02 : (0 : Fin 3) ≠ Fin.last 2 := by decide
  obtain ⟨hmem, hdiagW⟩ := diag2n_zero_last_mem_elementaryUnitaryGroup_typeAGraphConjugator
    hσ h02 hadm (inv_ne_zero hc0) (by rw [map_inv₀, hc])
  refine ⟨⟨Matrix.SpecialLinearGroup.diag2n h02 c⁻¹ (inv_ne_zero hc0), hmem⟩,
    elementaryUnitaryGroup_le_siegelClosure hσ 2 hdiagW, ?_⟩
  dsimp only
  rw [← Matrix.SpecialLinearGroup.diag2nUnit_mk0 h02 c⁻¹ (inv_ne_zero hc0),
    Matrix.SpecialLinearGroup.diag2nUnit_mulVec_single_right]
  simp

private theorem exists_mem_siegelClosure_two_mulVec_last_eq_smul_zero_of_eq
    (hσ : Function.Involutive σ) {t x : K} (ht0 : t ≠ 0) (hx : σ x * x = t + σ t) :
    ∃ m ∈ siegelClosure σ 2,
      ((m : Matrix.SpecialLinearGroup (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) *ᵥ
        Pi.single (Fin.last 2) 1 = t • Pi.single 0 1 := by
  have h02 : (0 : Fin 3) ≠ Fin.last 2 := by decide
  refine exists_mem_siegelClosure_mulVec_last_eq_smul_zero_of_exists_isotropic hσ h02 ht0
    (v := ![t, x, 1]) ?_ ?_ ?_
  · rw [dotProduct_typeAGraphConjugator_two_mulVec]
    simp [map_one]
    linear_combination -hx
  · rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]
    simp [Fin.rev_zero]
  · rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]
    simp

private theorem exists_mem_siegelClosure_two_mulVec_last_of_eq (hσ : Function.Involutive σ)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ 2 * σ d = 0) {t x : K} (ht0 : t ≠ 0)
    (hx : σ x * x = t + σ t) :
    ∃ n ∈ siegelClosure σ 2,
      ((n : Matrix.SpecialLinearGroup (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) *ᵥ
        Pi.single (Fin.last 2) 1 = t • Pi.single (Fin.last 2) 1 := by
  obtain ⟨mt, hmt, hmter⟩ := exists_mem_siegelClosure_two_mulVec_last_eq_smul_zero_of_eq hσ ht0 hx
  by_cases h2 : (2 : K) = 0
  · obtain ⟨m₁, hm₁, hm₁er⟩ := exists_mem_siegelClosure_two_mulVec_last_eq_smul_zero_of_eq hσ
      (t := 1) (x := 0) one_ne_zero (by rw [map_zero, zero_mul, map_one, one_add_one_eq_two, h2])
    refine ⟨m₁⁻¹ * mt, mul_mem (inv_mem hm₁) hmt, ?_⟩
    simpa only [inv_one, mul_one] using inv_mul_mulVec_last_eq_smul one_ne_zero hm₁er hmter
  · have hσ2 : σ 2 = 2 := map_ofNat σ 2
    obtain ⟨m₁, hm₁, hm₁er⟩ := exists_mem_siegelClosure_two_mulVec_last_eq_smul_zero_of_eq hσ
      (t := (2 : K)⁻¹) (x := 1) (inv_ne_zero h2)
      (by rw [map_one, mul_one, map_inv₀, hσ2, ← two_mul, mul_inv_cancel₀ h2])
    obtain ⟨D, hD, hDer⟩ := exists_mem_siegelClosure_two_mulVec_last_of_fixed hσ hadm
      (inv_ne_zero h2) (by rw [map_inv₀, hσ2])
    refine ⟨D * (m₁⁻¹ * mt), mul_mem hD (mul_mem (inv_mem hm₁) hmt), ?_⟩
    rw [specialIsometryGroup_mul_mulVec,
      inv_mul_mulVec_last_eq_smul (inv_ne_zero h2) hm₁er hmter, inv_inv, mulVec_smul, hDer,
      smul_smul, mul_inv_cancel_right₀ h2]

private theorem exists_mem_siegelClosure_mulVec_last_eq_smul_self (hσ : Function.Involutive σ)
    {r : ℕ} (hr : 2 ≤ r) (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ r * σ d = 0)
    {z : K} (hz0 : z ≠ 0) :
    ∃ n ∈ siegelClosure σ r,
      ((n : Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ
        Pi.single (Fin.last r) 1 = z • Pi.single (Fin.last r) 1 := by
  rcases eq_or_lt_of_le hr with rfl | hr3
  · by_cases hzt : z + σ z = 0
    · exact exists_mem_siegelClosure_two_mulVec_last_of_eq hσ hadm hz0 (x := 0) (by simp [hzt])
    · set c := z + σ z
      have hc : σ c = c := by rw [map_add, hσ, add_comm]
      set t := c⁻¹ * z
      have ht0 : t ≠ 0 := mul_ne_zero (inv_ne_zero hzt) hz0
      have htx : σ 1 * 1 = t + σ t := by
        rw [map_one, mul_one, map_mul, map_inv₀, hc, ← mul_add, inv_mul_cancel₀ hzt]
      obtain ⟨n₁, hn₁, hn₁er⟩ := exists_mem_siegelClosure_two_mulVec_last_of_eq hσ hadm ht0 htx
      obtain ⟨D, hD, hDer⟩ := exists_mem_siegelClosure_two_mulVec_last_of_fixed hσ hadm hzt hc
      refine ⟨D * n₁, mul_mem hD hn₁, ?_⟩
      rw [specialIsometryGroup_mul_mulVec, hn₁er, mulVec_smul, hDer, smul_smul, mul_comm t c,
        mul_inv_cancel_left₀ hzt]
  · have h0r : (0 : Fin (r + 1)) ≠ Fin.last r := by simp [Fin.ext_iff]; omega
    obtain ⟨v₁, hv₁, h0v₁, hrv₁⟩ := exists_isotropic_pairings_of_three_le hσ hr3 1
    obtain ⟨vz, hvz, h0vz, hrvz⟩ := exists_isotropic_pairings_of_three_le hσ hr3 z
    obtain ⟨m₁, hm₁, hm₁er⟩ := exists_mem_siegelClosure_mulVec_last_eq_smul_zero_of_exists_isotropic
      hσ h0r one_ne_zero hv₁ h0v₁ hrv₁
    obtain ⟨mz, hmz, hmzer⟩ := exists_mem_siegelClosure_mulVec_last_eq_smul_zero_of_exists_isotropic
      hσ h0r hz0 hvz h0vz hrvz
    refine ⟨m₁⁻¹ * mz, mul_mem (inv_mem hm₁) hmz, ?_⟩
    simpa only [inv_one, mul_one] using inv_mul_mulVec_last_eq_smul one_ne_zero hm₁er hmzer

private theorem exists_mem_siegelClosure_mul_mulVec_eq_smul_of_mulVec_eq_smul
    (hσ : Function.Involutive σ) {r : ℕ} {u v : Fin (r + 1) → K}
    (hu : (σ ∘ u) ⬝ᵥ
      ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ u) = 0)
    (hv : (σ ∘ v) ⬝ᵥ
      ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) = 0)
    (huv : (σ ∘ u) ⬝ᵥ
      ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) ≠ 0)
    {g : (typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ}
    {a : K} (ha0 : a ≠ 0)
    (hgu : ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ u = a • u) :
    ∃ s ∈ siegelClosure σ r,
      (((s * g : (typeAGraphConjugator r K :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ) :
          Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ u = a • u ∧
      (((s * g : (typeAGraphConjugator r K :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ) :
          Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v = (σ a)⁻¹ • v := by
  let Q := (typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K)
  let gv := ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
    Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v
  have hgv : (σ ∘ gv) ⬝ᵥ (Q *ᵥ gv) = 0 := by
    rw [comp_mulVec_dotProduct_mulVec_mulVec (mem_specialIsometryGroup_iff.mp g.property), hv]
  have hσa0 : σ a ≠ 0 := (map_ne_zero σ).mpr ha0
  have hugv : (σ ∘ u) ⬝ᵥ (Q *ᵥ gv) = (σ a)⁻¹ * ((σ ∘ u) ⬝ᵥ (Q *ᵥ v)) := by
    have hp := comp_mulVec_dotProduct_mulVec_mulVec (mem_specialIsometryGroup_iff.mp g.property) u v
    rw [hgu, TauCeti.map_comp_smul, smul_dotProduct, smul_eq_mul] at hp
    exact mul_left_cancel₀ hσa0 (by rw [← mul_assoc, mul_inv_cancel₀ hσa0, one_mul]; exact hp)
  have hv₀ : (σ ∘ ((σ a)⁻¹ • v)) ⬝ᵥ (Q *ᵥ ((σ a)⁻¹ • v)) = 0 := by
    rw [comp_smul_dotProduct_mulVec_smul, hv, mul_zero]
  have huv₀ : (σ ∘ u) ⬝ᵥ (Q *ᵥ ((σ a)⁻¹ • v)) = (σ a)⁻¹ * ((σ ∘ u) ⬝ᵥ (Q *ᵥ v)) := by
    rw [mulVec_smul, dotProduct_smul, smul_eq_mul]
  obtain ⟨s, hsQ, w, c, huw, hc, hS, hsu, hsgv⟩ :=
    exists_mem_specialIsometryGroup_coe_eq_siegelTransvection_mulVec_eq_self_and_mulVec_eq hσ
      (transpose_map_typeAGraphConjugator σ r) hu hgv hv₀
      (hugv ▸ mul_ne_zero (inv_ne_zero hσa0) huv) (hugv.trans huv₀.symm)
  refine ⟨⟨s, hsQ⟩, mem_siegelClosure_of_coe_eq hu huw hc hS, ?_, ?_⟩
  · rw [specialIsometryGroup_mul_mulVec, hgu, mulVec_smul, hsu]
  · rw [specialIsometryGroup_mul_mulVec, hsgv]

private theorem exists_mem_siegelClosure_mulVec_single_zero_and_last (hσ : Function.Involutive σ)
    {r : ℕ} (hr : 2 ≤ r) (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ r * σ d = 0)
    {z : K} (hz0 : z ≠ 0) :
    ∃ h ∈ siegelClosure σ r,
      ((h : Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ
        Pi.single 0 1 = (σ z)⁻¹ • Pi.single 0 1 ∧
      ((h : Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ
        Pi.single (Fin.last r) 1 = z • Pi.single (Fin.last r) 1 := by
  have h0r : (0 : Fin (r + 1)) ≠ Fin.last r := by simp [Fin.ext_iff]; omega
  obtain ⟨-, her0⟩ := comp_single_zero_last_typeAGraphConjugator σ r
  obtain ⟨n, hnS, hner⟩ := exists_mem_siegelClosure_mulVec_last_eq_smul_self hσ hr hadm hz0
  obtain ⟨s, hsS, hser, hse0⟩ :=
    exists_mem_siegelClosure_mul_mulVec_eq_smul_of_mulVec_eq_smul hσ
      (comp_single_dotProduct_typeAGraphConjugator_mulVec_single_last h0r)
      (comp_single_dotProduct_typeAGraphConjugator_mulVec_single_zero h0r)
      (by rw [her0]; exact pow_ne_zero r (neg_ne_zero.mpr one_ne_zero)) hz0 hner
  exact ⟨s * n, mul_mem hsS hnS, hse0, hser⟩

/-! ### Border embedding of special isometry groups via `A ↦ diag(1, A, 1)` (inner block carries
`−Q_{r'}`) -/

private def borderEquiv (r' : ℕ) : Fin 2 ⊕ Fin (r' + 1) ≃ Fin (r' + 2 + 1) where
  toFun := Sum.elim (fun i : Fin 2 ↦ if i = 0 then 0 else Fin.last (r' + 2))
    (fun i ↦ i.castSucc.succ)
  invFun := Fin.cases (.inl 0) (Fin.lastCases (.inl 1) .inr)
  left_inv x := by
    rcases x with i | i
    · fin_cases i
      · simp
      · change Fin.cases (Sum.inl 0) (Fin.lastCases (Sum.inl 1) Sum.inr)
            (Fin.last (r' + 2)) = Sum.inl 1
        rw [← Fin.succ_last (r' + 1), Fin.cases_succ, Fin.lastCases_last]
    · simp [Fin.lastCases_castSucc]
  right_inv k := by
    induction k using Fin.cases with
    | zero => simp
    | succ k =>
      induction k using Fin.lastCases with
      | last =>
        dsimp only
        rw [Fin.cases_succ, Fin.lastCases_last]
        simp [Fin.succ_last]
      | cast j => simp [Fin.lastCases_castSucc]

private theorem reindex_cornerBlockSucc_blockSucc {r' : ℕ}
    (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) :
    Matrix.reindex (borderEquiv r').symm (borderEquiv r').symm
        (cornerBlockSucc 1 (blockSucc A)) =
      fromBlocks (1 : Matrix (Fin 2) (Fin 2) K) 0 0 A := by
  have h0 : borderEquiv r' (.inl 0) = 0 := rfl
  have h1 : borderEquiv r' (.inl 1) = (Fin.last (r' + 1)).succ := by
    rw [Fin.succ_last]; rfl
  have hi (i : Fin (r' + 1)) : borderEquiv r' (.inr i) = i.castSucc.succ := rfl
  ext (i | i) (j | j)
  · fin_cases i <;> fin_cases j <;> simp [-Fin.succ_last, h0, h1]
  · fin_cases i <;> simp [-Fin.succ_last, h0, h1, hi]
  · fin_cases j <;> simp [-Fin.succ_last, h0, h1, hi]
  · simp [hi]

private theorem reindex_typeAGraphConjugator_add_two (r' : ℕ) :
    Matrix.reindex (borderEquiv r').symm (borderEquiv r').symm
        (typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) =
      fromBlocks !![(0 : K), 1; (-1 : K) ^ r', 0] 0 0
        (-(typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K)) := by
  have hrev (i : Fin (r' + 1)) :
      ((i.castSucc.succ : Fin (r' + 2 + 1)).rev) = i.rev.castSucc.succ := by
    ext; simp [Fin.rev]; omega
  have hne0 (i : Fin (r' + 1)) : i.castSucc.succ ≠ (0 : Fin (r' + 2 + 1)) := Fin.succ_ne_zero _
  have hnel (i : Fin (r' + 1)) : i.castSucc.succ ≠ Fin.last (r' + 2) := by
    rw [← Fin.succ_last (r' + 1), ne_eq, Fin.succ_inj]; exact (Fin.castSucc_lt_last i).ne
  have hinj : Function.Injective (fun i : Fin (r' + 1) ↦ i.castSucc.succ) :=
    (Fin.succ_injective _).comp (Fin.castSucc_injective _)
  ext (i | i) (j | j)
  · fin_cases i <;> fin_cases j <;>
      simp [borderEquiv, typeAGraphConjugator_apply, Fin.rev_zero, Fin.rev_last, Fin.last_pos.ne',
        Fin.last_pos.ne, pow_add]
  · fin_cases i <;>
      simp [borderEquiv, typeAGraphConjugator_apply, Fin.rev_zero, Fin.rev_last, hne0, hnel]
  · fin_cases j <;>
      simp [borderEquiv, typeAGraphConjugator_apply, hrev, (hne0 _).symm, (hnel _).symm]
  · simp [borderEquiv, typeAGraphConjugator_apply, hrev, hinj.eq_iff, pow_succ]
    split_ifs <;> simp

private theorem reindex_bordered_gram {r' : ℕ} (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) :
    Matrix.reindex (borderEquiv r').symm (borderEquiv r').symm
        (((cornerBlockSucc 1 (blockSucc A)).map σ)ᵀ *
          (typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *
          cornerBlockSucc 1 (blockSucc A)) =
      fromBlocks !![(0 : K), 1; (-1 : K) ^ r', 0] 0 0
        (-((A.map σ)ᵀ *
          (typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) * A)) := by
  let e : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K ≃+*
      Matrix (Fin 2 ⊕ Fin (r' + 1)) (Fin 2 ⊕ Fin (r' + 1)) K :=
    Matrix.reindexRingEquiv K (borderEquiv r').symm
  have h1 : e (cornerBlockSucc 1 (blockSucc A)) = fromBlocks 1 0 0 A :=
    reindex_cornerBlockSucc_blockSucc A
  have h2 : e ((cornerBlockSucc 1 (blockSucc A)).map σ)ᵀ = fromBlocks 1 0 0 (A.map σ)ᵀ := by
    have he : e ((cornerBlockSucc 1 (blockSucc A)).map σ)ᵀ =
        ((e (cornerBlockSucc 1 (blockSucc A))).map σ)ᵀ := by
      ext i j; rfl
    rw [he, h1, fromBlocks_map, fromBlocks_transpose]
    simp [Matrix.map_one (f := σ)]
  change e (((cornerBlockSucc 1 (blockSucc A)).map σ)ᵀ *
      (typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *
      cornerBlockSucc 1 (blockSucc A)) = _
  rw [map_mul, map_mul, h2, h1]
  simp only [e, Matrix.coe_reindexRingEquiv]
  rw [reindex_typeAGraphConjugator_add_two]
  simp [fromBlocks_multiply, Matrix.mul_assoc]

private theorem cornerBlockSucc_blockSucc_mem_specialIsometryGroup_iff {r' : ℕ}
    (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) :
    ((cornerBlockSucc 1 (blockSucc A)).map σ)ᵀ *
        (typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *
        cornerBlockSucc 1 (blockSucc A) =
      (typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) ↔
      (A.map σ)ᵀ *
        (typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) * A =
        (typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) := by
  -- Reindex both sides into block form `Fin 2 ⊕ Fin (r' + 1)` and compare the `(2, 2)` blocks.
  rw [← (Matrix.reindexRingEquiv K (borderEquiv r').symm).injective.eq_iff]
  change Matrix.reindex (borderEquiv r').symm (borderEquiv r').symm _ =
    Matrix.reindex (borderEquiv r').symm (borderEquiv r').symm _ ↔ _
  rw [reindex_bordered_gram, reindex_typeAGraphConjugator_add_two, fromBlocks_inj]
  simp [neg_inj]

private def borderHom {r' : ℕ} :
    (typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).specialIsometryGroup σ →*
      (typeAGraphConjugator (r' + 2) K :
        Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K).specialIsometryGroup σ where
  toFun g :=
    ⟨⟨cornerBlockSucc 1 (blockSucc g.val.val), by simp [g.val.property]⟩,
      (mem_specialIsometryGroup_iff).mpr <|
        (cornerBlockSucc_blockSucc_mem_specialIsometryGroup_iff g.val.val).mpr
          (mem_specialIsometryGroup_iff.mp g.property)⟩
  map_one' := Subtype.ext (Subtype.ext (by simp))
  map_mul' _ _ := Subtype.ext <| Subtype.ext <| by
    change cornerBlockSucc 1 (blockSucc (_ * _)) =
      cornerBlockSucc 1 (blockSucc _) * cornerBlockSucc 1 (blockSucc _)
    rw [blockSucc_mul, cornerBlockSucc_mul_cornerBlockSucc, one_mul]

@[simp] private theorem coe_borderHom {r' : ℕ}
    (g : (typeAGraphConjugator r' K :
      Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).specialIsometryGroup σ) :
    ((borderHom g : Matrix.SpecialLinearGroup (Fin (r' + 2 + 1)) K) :
      Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) =
      cornerBlockSucc 1 (blockSucc g.val.val) :=
  rfl

private theorem cons_snoc_borderEquiv_inl {α : Type*} [Zero α] {r' : ℕ}
    (u : Fin (r' + 1) → α) (i : Fin 2) :
    (Fin.cons (0 : α) (Fin.snoc u 0) : Fin (r' + 2 + 1) → α) (borderEquiv r' (.inl i)) = 0 := by
  fin_cases i
  · simp [borderEquiv]
  · simp only [borderEquiv, Equiv.coe_fn_mk, Sum.elim_inl]
    rw [← Fin.succ_last (r' + 1)]
    simp

private theorem cons_snoc_borderEquiv_inr {α : Type*} [Zero α] {r' : ℕ}
    (u : Fin (r' + 1) → α) (i : Fin (r' + 1)) :
    (Fin.cons (0 : α) (Fin.snoc u 0) : Fin (r' + 2 + 1) → α) (borderEquiv r' (.inr i)) = u i := by
  simp [borderEquiv]

private theorem comp_cons_snoc_dotProduct_mulVec {r' : ℕ}
    (x : Fin (r' + 1) → K) (v : Fin (r' + 2 + 1) → K) :
    (σ ∘ Fin.cons 0 (Fin.snoc x 0)) ⬝ᵥ
        ((typeAGraphConjugator (r' + 2) K :
          Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ v) =
      -((σ ∘ x) ⬝ᵥ
        ((typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) *ᵥ
          fun j ↦ v j.castSucc.succ)) := by
  rw [← comp_equiv_dotProduct_comp_equiv (e := borderEquiv r')]
  have hcomp : (σ ∘ Fin.cons 0 (Fin.snoc x 0)) ∘ borderEquiv r' =
      Sum.elim (0 : Fin 2 → K) (σ ∘ x) := by
    ext y
    rcases y with i | i
    · simp [cons_snoc_borderEquiv_inl]
    · simp [cons_snoc_borderEquiv_inr]
  have hQ : ((typeAGraphConjugator (r' + 2) K :
        Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ v) ∘ borderEquiv r' =
      (fromBlocks !![(0 : K), 1; (-1 : K) ^ r', 0] 0 0
        (-(typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K))) *ᵥ
        (v ∘ borderEquiv r') := by
    rw [← reindex_typeAGraphConjugator_add_two, Matrix.reindex_apply, Matrix.submatrix_mulVec_equiv]
    simp [Function.comp_assoc]
  rw [hcomp, hQ, fromBlocks_mulVec, dotProduct_block]
  have hinr : (v ∘ borderEquiv r') ∘ Sum.inr = fun j : Fin (r' + 1) ↦ v j.castSucc.succ := by
    ext j; rfl
  simp [hinr, neg_mulVec]

private theorem coe_borderHom_eq_siegelTransvection {r' : ℕ}
    (u w : Fin (r' + 1) → K) (c : K) :
    cornerBlockSucc 1 (blockSucc
        ((typeAGraphConjugator r' K :
          Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).siegelTransvection σ ((-1 : K) ^ r') u w c)) =
      (typeAGraphConjugator (r' + 2) K :
          Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K).siegelTransvection σ
        ((-1 : K) ^ (r' + 2)) (Fin.cons 0 (Fin.snoc u 0)) (-Fin.cons 0 (Fin.snoc w 0)) (-c) := by
  refine mulVec_injective (funext fun v ↦ ?_)
  have hL : (cornerBlockSucc 1 (blockSucc
        ((typeAGraphConjugator r' K :
          Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).siegelTransvection σ ((-1 : K) ^ r') u w c)) *ᵥ
        v) ∘ borderEquiv r' =
      Sum.elim ((v ∘ borderEquiv r') ∘ Sum.inl)
        (((typeAGraphConjugator r' K :
          Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).siegelTransvection σ ((-1 : K) ^ r') u w c) *ᵥ
          fun j ↦ v j.castSucc.succ) := by
    have hre := congrArg (fun M ↦ M *ᵥ (v ∘ borderEquiv r')) (reindex_cornerBlockSucc_blockSucc
      ((typeAGraphConjugator r' K :
        Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).siegelTransvection σ ((-1 : K) ^ r') u w c))
    rw [Matrix.reindex_apply, Matrix.submatrix_mulVec_equiv, Equiv.symm_symm,
      fromBlocks_mulVec] at hre
    have hinr : (v ∘ borderEquiv r') ∘ Sum.inr = fun j : Fin (r' + 1) ↦ v j.castSucc.succ := by
      ext j; rfl
    simpa [hinr, Function.comp_assoc] using hre
  have hpow : (-1 : K) ^ (r' + 2) = (-1 : K) ^ r' := by simp [pow_add]
  have hpair_neg : (σ ∘ (-Fin.cons 0 (Fin.snoc w 0))) ⬝ᵥ
        ((typeAGraphConjugator (r' + 2) K :
          Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ v) =
      (σ ∘ w) ⬝ᵥ
        ((typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) *ᵥ
          fun j ↦ v j.castSucc.succ) := by
    rw [map_comp_neg, neg_dotProduct, comp_cons_snoc_dotProduct_mulVec, neg_neg]
  have hEq : (cornerBlockSucc 1 (blockSucc
        ((typeAGraphConjugator r' K :
          Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).siegelTransvection σ ((-1 : K) ^ r') u w c)) *ᵥ
        v) ∘ borderEquiv r' =
      ((typeAGraphConjugator (r' + 2) K :
          Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K).siegelTransvection σ
        ((-1 : K) ^ (r' + 2)) (Fin.cons 0 (Fin.snoc u 0)) (-Fin.cons 0 (Fin.snoc w 0)) (-c) *ᵥ
        v) ∘ borderEquiv r' := by
    rw [hL]
    ext x
    rcases x with i | i
    · simp only [Sum.elim_inl, Function.comp_apply, siegelTransvection_mulVec, Pi.sub_apply,
        Pi.add_apply, Pi.smul_apply, Pi.neg_apply, cons_snoc_borderEquiv_inl, neg_zero, smul_zero,
        add_zero, sub_zero]
    · have hbinr : borderEquiv r' (.inr i) = i.castSucc.succ := rfl
      simp only [Sum.elim_inr, Function.comp_apply, siegelTransvection_mulVec, Pi.sub_apply,
        Pi.add_apply, Pi.smul_apply, Pi.neg_apply, comp_cons_snoc_dotProduct_mulVec, hpair_neg,
        hpow, cons_snoc_borderEquiv_inr, smul_eq_mul]
      rw [hbinr]
      ring
  exact funext fun k ↦ by
    simpa using congrFun hEq ((borderEquiv r').symm k)

private theorem mem_range_borderHom_of_mulVec_single_eq {r' : ℕ}
    {g : (typeAGraphConjugator (r' + 2) K :
      Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K).specialIsometryGroup σ}
    (hg0 : ((g : Matrix.SpecialLinearGroup (Fin (r' + 2 + 1)) K) :
      Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ Pi.single 0 1 = Pi.single 0 1)
    (hgl : ((g : Matrix.SpecialLinearGroup (Fin (r' + 2 + 1)) K) :
      Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ Pi.single (Fin.last (r' + 2)) 1 =
        Pi.single (Fin.last (r' + 2)) 1) :
    g ∈ (borderHom (σ := σ) (r' := r')).range := by
  let M := g.val.val
  let e : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K ≃+*
      Matrix (Fin 2 ⊕ Fin (r' + 1)) (Fin 2 ⊕ Fin (r' + 1)) K :=
    Matrix.reindexRingEquiv K (borderEquiv r').symm
  let N := e M
  have hcol0 (k : Fin (r' + 2 + 1)) : M k 0 = if k = 0 then 1 else 0 := by
    simpa [M, Matrix.mulVec_single_one, Pi.single_apply] using congrFun hg0 k
  have hcoll (k : Fin (r' + 2 + 1)) :
      M k (Fin.last (r' + 2)) = if k = Fin.last (r' + 2) then 1 else 0 := by
    simpa [M, Matrix.mulVec_single_one, Pi.single_apply] using congrFun hgl k
  have hN11 : N.toBlocks₁₁ = 1 := by
    ext i j
    fin_cases i <;> fin_cases j
    · simp [N, e, Matrix.toBlocks₁₁, borderEquiv, hcol0]
    · simp [N, e, Matrix.toBlocks₁₁, borderEquiv, hcoll]
    · simp [N, e, Matrix.toBlocks₁₁, borderEquiv, hcol0]
    · simp [N, e, Matrix.toBlocks₁₁, borderEquiv, hcoll]
  have hN21 : N.toBlocks₂₁ = 0 := by
    ext i j
    fin_cases j
    · simp [N, e, Matrix.toBlocks₂₁, borderEquiv, hcol0, Fin.succ_ne_zero]
    · simp [N, e, Matrix.toBlocks₂₁, borderEquiv, hcoll]
  have hgram : ((N.map σ)ᵀ * fromBlocks !![(0 : K), 1; (-1 : K) ^ r', 0] 0 0
        (-(typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K)) * N) =
      fromBlocks !![(0 : K), 1; (-1 : K) ^ r', 0] 0 0
        (-(typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K)) := by
    have hQ := congrArg e (mem_specialIsometryGroup_iff.mp g.property)
    have hNt : e (M.map σ)ᵀ = (N.map σ)ᵀ := by ext i j; rfl
    rw [map_mul, map_mul, hNt] at hQ
    simp only [e, Matrix.coe_reindexRingEquiv] at hQ
    rwa [reindex_typeAGraphConjugator_add_two] at hQ
  have hQ2_mul : !![(0 : K), 1; (-1 : K) ^ r', 0] * N.toBlocks₁₂ = 0 := by
    have hN : N = fromBlocks 1 N.toBlocks₁₂ 0 N.toBlocks₂₂ := by
      rw [← hN11, ← hN21, fromBlocks_toBlocks]
    rw [hN, fromBlocks_map, fromBlocks_transpose] at hgram
    rw [Matrix.map_one (⇑σ) (map_zero σ) (map_one σ),
      Matrix.map_zero (⇑σ) (map_zero σ), transpose_one, transpose_zero] at hgram
    rw [fromBlocks_multiply, fromBlocks_multiply, fromBlocks_inj] at hgram
    simpa using hgram.2.1
  have hQ2_inv : !![(0 : K), (-1 : K) ^ r'; 1, 0] * !![(0 : K), 1; (-1 : K) ^ r', 0] = 1 := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two, ← pow_add, ← two_mul, pow_mul]
  have hN12 : N.toBlocks₁₂ = 0 := by
    have := congrArg (!![(0 : K), (-1 : K) ^ r'; 1, 0] * ·) hQ2_mul
    rwa [← Matrix.mul_assoc, hQ2_inv, Matrix.one_mul, Matrix.mul_zero] at this
  have hM : cornerBlockSucc 1 (blockSucc N.toBlocks₂₂) = M := e.injective <| by
    change Matrix.reindex (borderEquiv r').symm (borderEquiv r').symm
        (cornerBlockSucc 1 (blockSucc N.toBlocks₂₂)) = N
    rw [reindex_cornerBlockSucc_blockSucc, ← hN11, ← hN12, ← hN21, fromBlocks_toBlocks]
  have hdetA : N.toBlocks₂₂.det = 1 := by
    have hdetM : (cornerBlockSucc 1 (blockSucc N.toBlocks₂₂)).det = 1 := hM ▸ g.val.property
    simpa using hdetM
  let ASL : Matrix.SpecialLinearGroup (Fin (r' + 1)) K := ⟨N.toBlocks₂₂, hdetA⟩
  have hmem : ASL ∈ (typeAGraphConjugator r' K :
      Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).specialIsometryGroup σ :=
    (mem_specialIsometryGroup_iff).mpr <|
      (cornerBlockSucc_blockSucc_mem_specialIsometryGroup_iff N.toBlocks₂₂).mp
        (hM ▸ mem_specialIsometryGroup_iff.mp g.property)
  exact ⟨⟨ASL, hmem⟩, Subtype.ext (Subtype.ext hM)⟩

private theorem siegelClosure_le_comap_borderHom (r' : ℕ) :
    siegelClosure σ r' ≤ (siegelClosure σ (r' + 2)).comap borderHom := by
  rw [siegelClosure, Subgroup.closure_le]
  rintro k ⟨u', w', c', hu', huw', hc', hk⟩
  rw [SetLike.mem_coe, Subgroup.mem_comap]
  have hbv (x : Fin (r' + 1) → K) :
      (σ ∘ Fin.cons 0 (Fin.snoc x 0)) ⬝ᵥ
          ((typeAGraphConjugator (r' + 2) K :
            Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ Fin.cons 0 (Fin.snoc x 0)) =
        -((σ ∘ x) ⬝ᵥ ((typeAGraphConjugator r' K :
          Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) *ᵥ x)) := by
    simpa using comp_cons_snoc_dotProduct_mulVec (σ := σ) x (Fin.cons 0 (Fin.snoc x 0))
  have hbu : (σ ∘ Fin.cons 0 (Fin.snoc u' 0)) ⬝ᵥ
      ((typeAGraphConjugator (r' + 2) K :
        Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ Fin.cons 0 (Fin.snoc u' 0)) = 0 := by
    rw [hbv u']; simpa using congrArg Neg.neg hu'
  have hbuw : (σ ∘ Fin.cons 0 (Fin.snoc u' 0)) ⬝ᵥ
      ((typeAGraphConjugator (r' + 2) K :
        Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ (-Fin.cons 0 (Fin.snoc w' 0))) = 0 := by
    rw [mulVec_neg, dotProduct_neg, comp_cons_snoc_dotProduct_mulVec]
    simp [huw']
  have hww : (σ ∘ (-Fin.cons 0 (Fin.snoc w' 0))) ⬝ᵥ
      ((typeAGraphConjugator (r' + 2) K :
        Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ (-Fin.cons 0 (Fin.snoc w' 0))) =
      -((σ ∘ w') ⬝ᵥ ((typeAGraphConjugator r' K :
        Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) *ᵥ w')) := by
    rw [map_comp_neg, mulVec_neg, neg_dotProduct, dotProduct_neg, neg_neg,
      comp_cons_snoc_dotProduct_mulVec]
    simp
  have hpow : (-1 : K) ^ (r' + 2) = (-1 : K) ^ r' := by simp [pow_add]
  have hbc : (-c') + (-1 : K) ^ (r' + 2) * σ (-c') + (-1 : K) ^ (r' + 2) *
      ((σ ∘ (-Fin.cons 0 (Fin.snoc w' 0))) ⬝ᵥ
        ((typeAGraphConjugator (r' + 2) K :
          Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ (-Fin.cons 0 (Fin.snoc w' 0)))) =
      0 := by
    rw [hww, hpow, map_neg]
    linear_combination -hc'
  exact mem_siegelClosure_of_coe_eq hbu hbuw hbc
    (by rw [coe_borderHom, hk, coe_borderHom_eq_siegelTransvection])

/-! ### Main Siegel generation theorem -/

private theorem exists_mem_siegelClosure_mul_mulVec_single_zero_and_last
    (hσ : Function.Involutive σ) {r₁ : ℕ}
    (htr : ∀ s : K, σ s = (-1 : K) ^ (r₁ + 1) * s → ∃ t : K, t + (-1 : K) ^ (r₁ + 1) * σ t = s)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ (r₁ + 1) * σ d = 0)
    (g : (typeAGraphConjugator (r₁ + 1) K :
      Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K).specialIsometryGroup σ) :
    ∃ h ∈ siegelClosure σ (r₁ + 1), ∃ c ≠ (0 : K),
      (((h * g : (typeAGraphConjugator (r₁ + 1) K :
        Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K).specialIsometryGroup σ) :
          Matrix.SpecialLinearGroup (Fin (r₁ + 2)) K) :
        Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K) *ᵥ Pi.single 0 1 = c • Pi.single 0 1 ∧
      (((h * g : (typeAGraphConjugator (r₁ + 1) K :
        Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K).specialIsometryGroup σ) :
          Matrix.SpecialLinearGroup (Fin (r₁ + 2)) K) :
        Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K) *ᵥ Pi.single (Fin.last (r₁ + 1)) 1 =
        (σ c)⁻¹ • Pi.single (Fin.last (r₁ + 1)) 1 := by
  -- First send `g *ᵥ e₀` onto `K • e₀` in the elementary group, then adjust the `e_{r₁+1}`-line.
  let Q := (typeAGraphConjugator (r₁ + 1) K : Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K)
  have hQ := transpose_map_typeAGraphConjugator σ (r₁ + 1)
  have hdet : Q.det ≠ 0 := (isUnits_det_units _).ne_zero
  have h0r : (0 : Fin (r₁ + 2)) ≠ Fin.last (r₁ + 1) := by simp [Fin.ext_iff]
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single_zero (σ := σ) h0r
  have her := comp_single_dotProduct_typeAGraphConjugator_mulVec_single_last (σ := σ) h0r
  obtain ⟨he0r, -⟩ := comp_single_zero_last_typeAGraphConjugator σ (r₁ + 1)
  have he00 : (Pi.single 0 1 : Fin (r₁ + 2) → K) ≠ 0 := Pi.single_ne_zero_iff.mpr one_ne_zero
  let ge0 := g.val.val *ᵥ Pi.single 0 1
  have hge0_ne : ge0 ≠ 0 := fun h0 ↦ he00 (Matrix.eq_zero_of_mulVec_eq_zero
    (by rw [Matrix.SpecialLinearGroup.det_coe]; exact one_ne_zero) h0)
  have hge0_iso : (σ ∘ ge0) ⬝ᵥ (Q *ᵥ ge0) = 0 := by
    rw [comp_mulVec_dotProduct_mulVec_mulVec (mem_specialIsometryGroup_iff.mp g.property), he0]
  obtain ⟨⟨h₁, hh₁W⟩, c, hc0, hh₁e0⟩ := exists_elementaryUnitaryGroup_mulVec_eq_smul
    hσ hQ hdet htr hadm hge0_ne he00 hge0_iso he0
  have hh₁ := elementaryUnitaryGroup_le_siegelClosure hσ (r₁ + 1) hh₁W
  have hg₁e0 : (((h₁ * g : (typeAGraphConjugator (r₁ + 1) K :
        Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K).specialIsometryGroup σ) :
        Matrix.SpecialLinearGroup (Fin (r₁ + 2)) K) :
      Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K) *ᵥ Pi.single 0 1 = c • Pi.single 0 1 := by
    rw [specialIsometryGroup_mul_mulVec, hh₁e0]
  obtain ⟨s₂, hs₂, hs₂e0, hs₂er⟩ :=
    exists_mem_siegelClosure_mul_mulVec_eq_smul_of_mulVec_eq_smul hσ he0 her
      (by rw [he0r]; exact one_ne_zero) hc0 hg₁e0
  refine ⟨s₂ * h₁, mul_mem hs₂ hh₁, c, hc0, ?_, ?_⟩
  · simpa only [mul_assoc] using hs₂e0
  · simpa only [mul_assoc] using hs₂er

private theorem siegelClosure_one_eq_top (hσ : Function.Involutive σ)
    (htr : ∀ s : K, σ s = (-1 : K) ^ 1 * s → ∃ t : K, t + (-1 : K) ^ 1 * σ t = s)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ 1 * σ d = 0) :
    siegelClosure σ 1 = ⊤ := by
  refine top_unique fun g _ ↦ ?_
  obtain ⟨h, hh, c, hc0, hg₂e0, hg₂er⟩ :=
    exists_mem_siegelClosure_mul_mulVec_single_zero_and_last hσ htr hadm g
  let g₂ := h * g
  have hσc0 : σ c ≠ 0 := (map_ne_zero σ).mpr hc0
  have hg₂_mat : ((g₂ : Matrix.SpecialLinearGroup (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) =
      diagonal ![c, (σ c)⁻¹] := by
    refine Matrix.ext_of_mulVec_single fun i ↦ ?_
    fin_cases i
    · simpa [g₂, Matrix.diagonal_mulVec_single, ← Pi.single_smul'] using hg₂e0
    · simpa [g₂, Matrix.diagonal_mulVec_single, ← Pi.single_smul'] using hg₂er
  have hdet1 : c * (σ c)⁻¹ = 1 := by
    have hd := g₂.val.property; rwa [hg₂_mat, det_diagonal, Fin.prod_univ_two] at hd
  have hσc : σ c = c := ((mul_inv_eq_one₀ hσc0).mp hdet1).symm
  have h0r : (0 : Fin 2) ≠ Fin.last 1 := by decide
  obtain ⟨hmem, hdiagW⟩ := diag2n_zero_last_mem_elementaryUnitaryGroup_typeAGraphConjugator
    hσ h0r hadm hc0 hσc
  have hg₂_eq : g₂ = ⟨Matrix.SpecialLinearGroup.diag2n h0r c hc0, hmem⟩ := Subtype.ext <|
    Subtype.ext <| by
      rw [hg₂_mat, Matrix.SpecialLinearGroup.diag2n_coe]; ext i j
      fin_cases i <;> fin_cases j <;> simp [hσc]
  have hg_eq : g = h⁻¹ * g₂ := by simp [g₂]
  rw [hg_eq]
  exact mul_mem (inv_mem hh) (elementaryUnitaryGroup_le_siegelClosure hσ 1 (hg₂_eq ▸ hdiagW))

private theorem siegelClosure_eq_top (hσ : Function.Involutive σ) {r : ℕ}
    (htr : ∀ s : K, σ s = (-1 : K) ^ r * s → ∃ t : K, t + (-1 : K) ^ r * σ t = s)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ r * σ d = 0) :
    siegelClosure σ r = ⊤ := by
  induction r using Nat.strongRecOn with | ind r ih => ?_
  rcases r with _ | _ | r₂
  · refine top_unique fun g _ ↦ ?_
    have hg1 : g = 1 :=
      Subtype.ext (Subsingleton.elim (α := Matrix.SpecialLinearGroup (Fin 1) K) _ _)
    exact hg1 ▸ one_mem _
  · exact siegelClosure_one_eq_top hσ htr hadm
  · refine top_unique fun g _ ↦ ?_
    obtain ⟨h, hh, c, hc0, hg₂e0, hg₂er⟩ :=
      exists_mem_siegelClosure_mul_mulVec_single_zero_and_last hσ htr hadm g
    have hσc0 : σ c ≠ 0 := (map_ne_zero σ).mpr hc0
    obtain ⟨h₃, hh₃, hh₃e0, hh₃er⟩ := exists_mem_siegelClosure_mulVec_single_zero_and_last hσ
      (by omega : 2 ≤ r₂ + 2) hadm hσc0
    let g₃ := h₃ * (h * g)
    have hg₃e0 : ((g₃ : Matrix.SpecialLinearGroup (Fin (r₂ + 2 + 1)) K) :
        Matrix (Fin (r₂ + 2 + 1)) (Fin (r₂ + 2 + 1)) K) *ᵥ Pi.single 0 1 = Pi.single 0 1 := by
      rw [specialIsometryGroup_mul_mulVec, hg₂e0, mulVec_smul, hh₃e0, hσ c, smul_inv_smul₀ hc0]
    have hg₃er : ((g₃ : Matrix.SpecialLinearGroup (Fin (r₂ + 2 + 1)) K) :
        Matrix (Fin (r₂ + 2 + 1)) (Fin (r₂ + 2 + 1)) K) *ᵥ Pi.single (Fin.last (r₂ + 2)) 1 =
        Pi.single (Fin.last (r₂ + 2)) 1 := by
      rw [specialIsometryGroup_mul_mulVec, hg₂er, mulVec_smul, hh₃er, inv_smul_smul₀ hσc0]
    obtain ⟨g', hg'⟩ := mem_range_borderHom_of_mulVec_single_eq (r' := r₂) hg₃e0 hg₃er
    have hpow : (-1 : K) ^ (r₂ + 2) = (-1 : K) ^ r₂ := by simp [pow_add]
    have hg'S : g' ∈ siegelClosure σ r₂ := by
      rw [ih r₂ (by omega) (by simpa only [hpow] using htr) (by simpa only [hpow] using hadm)]
      exact Subgroup.mem_top g'
    have hg_eq : g = (h₃ * h)⁻¹ * g₃ := by simp [g₃, mul_assoc]
    rw [hg_eq]
    exact mul_mem (inv_mem (mul_mem hh₃ hh)) (hg' ▸ siegelClosure_le_comap_borderHom r₂ hg'S)

/-- **The standard special unitary group is generated by its admissible Siegel transformations.**
Let `σ` be an involution of a field `K` and `Q_r = typeAGraphConjugator r K`. Assuming that the
signed trace `t ↦ t + (-1) ^ r * σ(t)` is onto `{s | σ(s) = (-1) ^ r * s}` and has a nonzero
kernel element, every subgroup `H` of `Q_r.specialIsometryGroup σ` containing all admissible Siegel
transformations `S(u, w, c)` with `u ≠ 0` equals `⊤`. -/
theorem subgroup_typeAGraphConjugator_eq_top_of_siegelTransvection_mem
    (hσ : Function.Involutive σ) {r : ℕ}
    (htr : ∀ s : K, σ s = (-1 : K) ^ r * s → ∃ t : K, t + (-1 : K) ^ r * σ t = s)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ r * σ d = 0)
    (H : Subgroup ((typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ))
    (hS : ∀ (g : (typeAGraphConjugator r K :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ)
        (u w : Fin (r + 1) → K) (c : K),
      u ≠ 0 →
      (σ ∘ u) ⬝ᵥ ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ u) = 0 →
      (σ ∘ u) ⬝ᵥ ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w) = 0 →
      c + (-1 : K) ^ r * σ c + (-1 : K) ^ r *
        ((σ ∘ w) ⬝ᵥ ((typeAGraphConjugator r K :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w)) = 0 →
      ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (typeAGraphConjugator r K :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K).siegelTransvection σ ((-1 : K) ^ r) u w c →
      g ∈ H) :
    H = ⊤ := by
  refine top_unique <| siegelClosure_eq_top hσ htr hadm ▸
    (Subgroup.closure_le H).mpr fun g ⟨u, w, c, hu, huw, hc, hg⟩ ↦ ?_
  by_cases hu0 : u = 0
  · subst hu0
    have hg1 : g = 1 := Subtype.ext (Subtype.ext (by simpa using hg)); exact hg1 ▸ one_mem H
  · exact hS g u w c hu0 hu huw hc hg

end Field

end TauCeti
