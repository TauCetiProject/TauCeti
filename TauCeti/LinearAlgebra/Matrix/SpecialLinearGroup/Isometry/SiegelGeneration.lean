/-!
# Generation of the standard special unitary group by Siegel transformations

Let `σ` be an involution of a field `K`, and let `Q_r` be the `(r + 1) × (r + 1)` signed reversal
matrix `TauCeti.typeAGraphConjugator r K`. Its sesquilinear form `B(x, y) = (σ ∘ x) ⬝ᵥ (Q_r *ᵥ y)`
is `(-1) ^ r`-Hermitian, so `Q_r.specialIsometryGroup σ` is the standard special unitary group
`SU_{r+1}(K, σ)`.

This file proves that `Q_r.specialIsometryGroup σ` is generated by its admissible Siegel
transformations `S(u, w, c)` along isotropic vectors `u`, for **every** rank `r` (including
`SU₃(2)`, where unitary transvections alone generate only a proper subgroup). Over a general
`(K, σ)` the inputs are:

* `t ↦ t + σ(t)` is onto `{s | σ(s) = s}`;
* `d + σ(d) = 0` has a nonzero solution;
* in positive even rank `r = 2m` (odd dimension `2m + 1`, where an anisotropic core line remains),
  `b ↦ σ(b) * b` is onto `{s | σ(s) = s}`.

For the subgroup generated by all admissible Siegel transformations (which contains all admissible
unitary transvections `τ_{u, a} = S(u, 0, a)`):

1. Unitary transvections move `g *ᵥ e₀` to `c • e₀` (`c ≠ 0`), and a Siegel transformation along
   `e₀` moves `(h₁ * g) *ᵥ e_r` to `(σ c)⁻¹ • e_r` while fixing `e₀`.
2. In rank `r = 1`, `det = 1` forces `σ(c) = c`, and `diag(c, c⁻¹)` is a product of six unitary
   transvections along `e₀` and `e₁`.
3. In rank `r ≥ 2`, an explicit isotropic vector `v(z)` with `B(e₀, v(z)) = 1` and
   `B(e_r, v(z)) = (-1) ^ r * z` yields Siegel products scaling `(e₀, e_r)` to `((σ z)⁻¹ • e₀,
   z • e_r)`, reducing `g` to an element fixing both `e₀` and `e_r`.
4. Elements fixing `e₀` and `e_r` preserve `{e₀, e_r}^⊥`: for `r = 2` they are trivial by
   `det = 1`, and for `r = r' + 2` they come from `Q_{r'}.specialIsometryGroup σ` via a border
   homomorphism (`Matrix.cornerBlockSucc 1 ∘ Matrix.blockSucc`) carrying Siegel transformations of
   `Q_{r'}` to Siegel transformations of `Q_r`.

## Main results

* `TauCeti.transpose_map_typeAGraphConjugator`: `(Q_r ^ σ)ᵀ = (-1) ^ r • Q_r`.
* `TauCeti.diag2n_zero_last_mem_iSup_unitaryTransvectionSubgroup`: for `σ(t) = t` (`t ≠ 0`), the
  corner diagonal matrix `diag(t, 1, …, 1, t⁻¹)` lies in `Q_r.specialIsometryGroup σ` and in
  `⨆ p, Q_r.unitaryTransvectionSubgroup σ p`.
* `TauCeti.specialIsometryGroup_typeAGraphConjugator_eq_top_of_siegelTransvection_mem`: any subgroup
  of `Q_r.specialIsometryGroup σ` containing all admissible Siegel transformations is `⊤`.

## References

* D. E. Taylor, *The Geometry of the Classical Groups* (1992), Chapter 11.
-/

public section

open Matrix

namespace TauCeti

section Ring

variable {R : Type*} [CommRing R]

/-- The entries `0` and `±1` of `typeAGraphConjugator` are fixed by every ring homomorphism, so its
conjugate transpose satisfies `(Q_r ^ σ)ᵀ = (-1) ^ r • Q_r`. -/
theorem transpose_map_typeAGraphConjugator (σ : R →+* R) (r : ℕ) :
    ((typeAGraphConjugator r R : Matrix (Fin (r + 1)) (Fin (r + 1)) R).map σ)ᵀ =
      (-1 : R) ^ r • (typeAGraphConjugator r R : Matrix (Fin (r + 1)) (Fin (r + 1)) R) := by
  have hmap := congrArg Units.val (map_typeAGraphConjugator σ r)
  rw [Units.coe_map, MonoidHom.coe_ofClass, RingHom.mapMatrix_apply] at hmap
  rw [hmap, transpose_typeAGraphConjugator]

/-- A unitary transvection of `Q_r` along `e₀` is the upper corner elementary transvection
`1 + a E_{0, r}`. -/
theorem unitaryTransvection_single_zero (σ : R →+* R) {r : ℕ}
    (h0r : (0 : Fin (r + 1)) ≠ Fin.last r) (a : R) :
    (typeAGraphConjugator r R : Matrix (Fin (r + 1)) (Fin (r + 1)) R).unitaryTransvection σ
        (Pi.single 0 1) a =
      (Matrix.SpecialLinearGroup.transvection h0r a : Matrix (Fin (r + 1)) (Fin (r + 1)) R) := by
  refine mulVec_injective (funext fun v ↦ ?_)
  have hc : σ ∘ Pi.single (0 : Fin (r + 1)) (1 : R) = Pi.single 0 1 := funext fun j ↦ by
    by_cases hj : j = 0 <;> simp [hj]
  rw [unitaryTransvection_mulVec, hc, single_one_dotProduct, coe_typeAGraphConjugator_mulVec,
    Matrix.SpecialLinearGroup.transvection_coe, add_mulVec, one_mulVec]
  ext i
  by_cases hi : i = 0
  · subst hi
    simp [mulVec, dotProduct, Matrix.single_apply, ite_mul, Fin.rev_zero]
  · simp [mulVec, dotProduct, hi, Ne.symm hi]

/-- A unitary transvection of `Q_r` along `e_r` with parameter `(-1) ^ r * b` is the lower corner
elementary transvection `1 + b E_{r, 0}`. -/
theorem unitaryTransvection_single_last (σ : R →+* R) {r : ℕ}
    (h0r : (0 : Fin (r + 1)) ≠ Fin.last r) (b : R) :
    (typeAGraphConjugator r R : Matrix (Fin (r + 1)) (Fin (r + 1)) R).unitaryTransvection σ
        (Pi.single (Fin.last r) 1) ((-1 : R) ^ r * b) =
      (Matrix.SpecialLinearGroup.transvection h0r.symm b :
        Matrix (Fin (r + 1)) (Fin (r + 1)) R) := by
  refine mulVec_injective (funext fun v ↦ ?_)
  have hc : σ ∘ Pi.single (Fin.last r) (1 : R) = Pi.single (Fin.last r) 1 := funext fun j ↦ by
    by_cases hj : j = Fin.last r <;> simp [hj]
  have hsign : (-1 : R) ^ r * (-1 : R) ^ r = 1 := by
    rw [← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow]
  rw [unitaryTransvection_mulVec, hc, single_one_dotProduct, coe_typeAGraphConjugator_mulVec,
    Matrix.SpecialLinearGroup.transvection_coe, add_mulVec, one_mulVec]
  ext i
  by_cases hi : i = Fin.last r
  · subst hi
    simp only [Pi.add_apply, Pi.smul_apply, Pi.single_eq_same, smul_eq_mul, mul_one,
      Fin.val_last, Fin.rev_last, mulVec, dotProduct, Matrix.single_apply, true_and, ite_mul,
      zero_mul, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
    linear_combination b * v 0 * hsign
  · simp [mulVec, dotProduct, hi, Ne.symm hi]

/-- A standard coordinate vector `eᵢ` with `i ≠ i.rev` is isotropic for `Q_r`. -/
theorem comp_single_dotProduct_typeAGraphConjugator_mulVec_single {σ : R →+* R} {r : ℕ}
    {i : Fin (r + 1)} (hi : i ≠ i.rev) :
    (σ ∘ Pi.single i (1 : R)) ⬝ᵥ
      ((typeAGraphConjugator r R : Matrix (Fin (r + 1)) (Fin (r + 1)) R) *ᵥ Pi.single i 1) =
        0 := by
  have hcomp : σ ∘ Pi.single i (1 : R) = Pi.single i 1 := funext fun j ↦ by
    by_cases hj : j = i <;> simp [hj]
  rw [hcomp, single_one_dotProduct, coe_typeAGraphConjugator_mulVec]
  simp [hi.symm]

end Ring

section Field

variable {K : Type*} [Field K] {σ : K →+* K}

private abbrev stdUnitMat (R : Type*) [Ring R] (r : ℕ) : Matrix (Fin (r + 1)) (Fin (r + 1)) R :=
  typeAGraphConjugator r R

private theorem comp_single_zero_last_stdUnitMat (σ : K →+* K) (r : ℕ) :
    (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ Pi.single (Fin.last r) 1) = 1 ∧
    (σ ∘ Pi.single (Fin.last r) 1) ⬝ᵥ (stdUnitMat K r *ᵥ Pi.single 0 1) = (-1 : K) ^ r := by
  have hc (i : Fin (r + 1)) : σ ∘ Pi.single i (1 : K) = Pi.single i 1 := funext fun j ↦ by
    by_cases hj : j = i <;> simp [hj]
  constructor
  · rw [hc, single_one_dotProduct, coe_typeAGraphConjugator_mulVec]; simp [Fin.rev_zero]
  · rw [hc, single_one_dotProduct, coe_typeAGraphConjugator_mulVec]; simp [Fin.rev_last]

/-- Surjectivity of `t ↦ t + σ(t)` onto `{s | σ(s) = s}` implies surjectivity of the signed trace
`t ↦ t + (-1) ^ k * σ(t)` onto `{s | σ(s) = (-1) ^ k * s}` for every `k`. -/
theorem exists_add_neg_one_pow_mul_apply_eq
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s) (k : ℕ) {s : K}
    (hs : σ s = (-1 : K) ^ k * s) : ∃ t : K, t + (-1 : K) ^ k * σ t = s := by
  rcases neg_one_pow_eq_or K k with hk | hk <;> rw [hk] at hs ⊢
  · obtain ⟨t, ht⟩ := htr s (by simpa using hs)
    exact ⟨t, by simpa using ht⟩
  · obtain ⟨b, hb⟩ := htr 1 (map_one σ)
    refine ⟨s * b, ?_⟩
    rw [map_mul, show σ s = -s by linear_combination hs]
    linear_combination s * hb

/-- Existence of a nonzero `d` with `d + σ(d) = 0` gives a nonzero solution of
`d + (-1) ^ k * σ(d) = 0` for every `k`. -/
theorem exists_ne_zero_add_neg_one_pow_mul_apply_eq_zero
    (hadm : ∃ d ≠ (0 : K), d + σ d = 0) (k : ℕ) :
    ∃ d ≠ (0 : K), d + (-1 : K) ^ k * σ d = 0 := by
  rcases neg_one_pow_eq_or K k with hk | hk <;> rw [hk]
  · obtain ⟨d, hd0, hd⟩ := hadm
    exact ⟨d, hd0, by simpa using hd⟩
  · exact ⟨1, one_ne_zero, by simp⟩

/-- Upper and lower corner elementary transvections `1 + (s * d) E_{0, r}` and
`1 + (s * d⁻¹) E_{r, 0}` belong to `⨆ p, Q_r.unitaryTransvectionSubgroup σ p` when `σ(s) = s` and
`d + (-1) ^ r * σ(d) = 0` (`d ≠ 0`). -/
private theorem corner_transvections_mem_iSup (hσ : Function.Involutive σ) {r : ℕ}
    (h0r : (0 : Fin (r + 1)) ≠ Fin.last r) {d : K}
    (hd : d + (-1 : K) ^ r * σ d = 0) {s : K} (hs : σ s = s) :
    (∃ hm : Matrix.SpecialLinearGroup.transvection h0r (s * d) ∈
        (stdUnitMat K r).specialIsometryGroup σ,
      (⟨_, hm⟩ : (stdUnitMat K r).specialIsometryGroup σ) ∈
        ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p) ∧
    (∃ hm : Matrix.SpecialLinearGroup.transvection h0r.symm (s * d⁻¹) ∈
        (stdUnitMat K r).specialIsometryGroup σ,
      (⟨_, hm⟩ : (stdUnitMat K r).specialIsometryGroup σ) ∈
        ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p) := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  have her := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := Fin.last r)
    (by rw [Fin.rev_last]; exact h0r.symm)
  constructor
  · have ha : s * d + (-1 : K) ^ r * σ (s * d) = 0 := by
      rw [map_mul, hs]; linear_combination s * hd
    obtain ⟨⟨g, hg⟩, hgW, hga⟩ := exists_mem_iSup_unitaryTransvectionSubgroup_coe_eq hσ hQ he0 ha
    have hge : g = Matrix.SpecialLinearGroup.transvection h0r (s * d) :=
      Subtype.ext (hga.trans (unitaryTransvection_single_zero σ h0r (s * d)))
    subst hge; exact ⟨hg, hgW⟩
  · have ha : (-1 : K) ^ r * (s * d⁻¹) + (-1 : K) ^ r * σ ((-1 : K) ^ r * (s * d⁻¹)) = 0 := by
      rcases neg_one_pow_eq_or K r with hr | hr <;> rw [hr] at hd ⊢
      · have hσd : σ d = -d := by linear_combination hd
        simp only [one_mul, map_mul, map_inv₀, hs, hσd, inv_neg]; ring
      · have hσd : σ d = d := by linear_combination -hd
        simp only [neg_one_mul, map_neg, map_mul, map_inv₀, hs, hσd]; ring
    obtain ⟨⟨g, hg⟩, hgW, hga⟩ := exists_mem_iSup_unitaryTransvectionSubgroup_coe_eq hσ hQ her ha
    have hge : g = Matrix.SpecialLinearGroup.transvection h0r.symm (s * d⁻¹) :=
      Subtype.ext (hga.trans (unitaryTransvection_single_last σ h0r (s * d⁻¹)))
    subst hge; exact ⟨hg, hgW⟩

/-- Six-transvection decomposition of `diag2n h0r t ht0` as `diag2n (t * d) * (diag2n d)⁻¹`. -/
private theorem diag2n_eq_mul_six_transvections {r : ℕ} (h0r : (0 : Fin (r + 1)) ≠ Fin.last r)
    {t d : K} (ht0 : t ≠ 0) (hd0 : d ≠ 0) :
    Matrix.SpecialLinearGroup.diag2n h0r t ht0 =
      Matrix.SpecialLinearGroup.transvection h0r (t * d) *
        Matrix.SpecialLinearGroup.transvection h0r.symm (-t⁻¹ * d⁻¹) *
        Matrix.SpecialLinearGroup.transvection h0r (t * d) *
        Matrix.SpecialLinearGroup.transvection h0r (-1 * d) *
        Matrix.SpecialLinearGroup.transvection h0r.symm (1 * d⁻¹) *
        Matrix.SpecialLinearGroup.transvection h0r (-1 * d) := by
  have hmul : Matrix.SpecialLinearGroup.diag2n h0r t ht0 =
      Matrix.SpecialLinearGroup.diag2n h0r (t * d) (mul_ne_zero ht0 hd0) *
        (Matrix.SpecialLinearGroup.diag2n h0r d hd0)⁻¹ := by
    rw [← Matrix.SpecialLinearGroup.diag2nUnit_mk0 h0r t ht0,
      ← Matrix.SpecialLinearGroup.diag2nUnit_mk0 h0r (t * d) (mul_ne_zero ht0 hd0),
      ← Matrix.SpecialLinearGroup.diag2nUnit_mk0 h0r d hd0,
      Matrix.SpecialLinearGroup.diag2nUnit_inv]
    apply Subtype.ext
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.diag2nUnit_coe,
      diagonal_mul_diagonal]
    congr 1; ext i
    by_cases h1 : i = 0
    · subst h1; simp [hd0]
    · by_cases h2 : i = Fin.last r
      · subst h2
        simp only [h1, ↓reduceIte, Units.val_mk0, Units.val_inv_eq_inv_val,
          _root_.mul_inv_rev, inv_inv]
        rw [mul_comm d⁻¹, inv_mul_cancel_right₀ hd0]
      · simp [h1, h2]
  have hinv {i j : Fin (r + 1)} (hij : i ≠ j) (c : K) :
      (Matrix.SpecialLinearGroup.transvection hij c)⁻¹ =
        Matrix.SpecialLinearGroup.transvection hij (-c) := by
    refine inv_eq_of_mul_eq_one_right (Subtype.ext ?_)
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_one,
      Matrix.SpecialLinearGroup.transvection_coe, Matrix.SpecialLinearGroup.transvection_coe]
    simp [_root_.Matrix.mul_add, _root_.Matrix.add_mul,
      _root_.Matrix.single_mul_single_of_ne _ _ _ _ hij.symm, add_assoc, ← _root_.Matrix.single_add]
  have hc₁ {i j : Fin (r + 1)} (hij : i ≠ j) (a : K)
      (x : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix.SpecialLinearGroup.transvection hij (-a) *
        (Matrix.SpecialLinearGroup.transvection hij a * x) = x := by
    rw [← mul_assoc, ← hinv, inv_mul_cancel, one_mul]
  have hc₂ {i j : Fin (r + 1)} (hij : i ≠ j) (a : K)
      (x : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix.SpecialLinearGroup.transvection hij a *
        (Matrix.SpecialLinearGroup.transvection hij (-a) * x) = x := by
    rw [← mul_assoc, ← hinv, mul_inv_cancel, one_mul]
  rw [hmul, Matrix.SpecialLinearGroup.diag2n_decompose h0r (t * d),
    Matrix.SpecialLinearGroup.diag2n_decompose h0r d]
  simp only [_root_.mul_inv_rev, hinv, neg_neg, show -(d⁻¹ * t⁻¹) = -t⁻¹ * d⁻¹ by ring,
    show (-1 : K) * d = -d by ring, show (1 : K) * d⁻¹ = d⁻¹ by ring, mul_assoc, hc₁, hc₂]

/-- **Corner diagonal torus elements from unitary transvections.** For `0 ≠ Fin.last r` and any
nonzero `t` fixed by `σ`, `diag2n h0r t ht0` belongs to `Q_r.specialIsometryGroup σ` and lies in
`⨆ p, Q_r.unitaryTransvectionSubgroup σ p` as a product of six corner unitary transvections. -/
theorem diag2n_zero_last_mem_iSup_unitaryTransvectionSubgroup (hσ : Function.Involutive σ) {r : ℕ}
    (h0r : (0 : Fin (r + 1)) ≠ Fin.last r) (hadm : ∃ d ≠ (0 : K), d + σ d = 0) {t : K}
    (ht0 : t ≠ 0) (ht : σ t = t) :
    ∃ hmem : Matrix.SpecialLinearGroup.diag2n h0r t ht0 ∈
        (typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ,
      (⟨Matrix.SpecialLinearGroup.diag2n h0r t ht0, hmem⟩ :
        (typeAGraphConjugator r K :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ) ∈
        ⨆ p, (typeAGraphConjugator r K :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K).unitaryTransvectionSubgroup σ p := by
  obtain ⟨d, hd0, hd⟩ := exists_ne_zero_add_neg_one_pow_mul_apply_eq_zero hadm r
  obtain ⟨⟨hm1, h1⟩, -⟩ := corner_transvections_mem_iSup hσ h0r hd ht
  obtain ⟨-, ⟨hm2, h2⟩⟩ := corner_transvections_mem_iSup hσ h0r hd
    (s := -t⁻¹) (by rw [map_neg, map_inv₀, ht])
  obtain ⟨⟨hm3, h3⟩, -⟩ := corner_transvections_mem_iSup hσ h0r hd (s := -1) (by simp)
  obtain ⟨-, ⟨hm4, h4⟩⟩ := corner_transvections_mem_iSup hσ h0r hd (s := 1) (map_one σ)
  let prodW : (stdUnitMat K r).specialIsometryGroup σ :=
    ⟨_, hm1⟩ * ⟨_, hm2⟩ * ⟨_, hm1⟩ * ⟨_, hm3⟩ * ⟨_, hm4⟩ * ⟨_, hm3⟩
  have hmemW : prodW ∈ ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p :=
    mul_mem (mul_mem (mul_mem (mul_mem (mul_mem h1 h2) h1) h3) h4) h3
  have hcoe : prodW.1 = Matrix.SpecialLinearGroup.diag2n h0r t ht0 :=
    (diag2n_eq_mul_six_transvections h0r ht0 hd0).symm
  obtain ⟨prodSL, hprodQ⟩ := prodW
  dsimp only at hcoe
  subst hcoe
  exact ⟨hprodQ, hmemW⟩

/-! ### The Siegel-generated subgroup and scaling `(e₀, e_r)` -/

/-- The subgroup of `Q_r.specialIsometryGroup σ` generated by all admissible Siegel
transformations. -/
private def siegelClosure (σ : K →+* K) (r : ℕ) :
    Subgroup ((stdUnitMat K r).specialIsometryGroup σ) :=
  Subgroup.closure {g | ∃ (u w : Fin (r + 1) → K) (c : K),
    (σ ∘ u) ⬝ᵥ (stdUnitMat K r *ᵥ u) = 0 ∧ (σ ∘ u) ⬝ᵥ (stdUnitMat K r *ᵥ w) = 0 ∧
    c + (-1 : K) ^ r * σ c + (-1 : K) ^ r * ((σ ∘ w) ⬝ᵥ (stdUnitMat K r *ᵥ w)) = 0 ∧
    ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
      (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) u w c}

private theorem mem_siegelClosure_of_coe_eq {r : ℕ}
    {g : (stdUnitMat K r).specialIsometryGroup σ} {u w : Fin (r + 1) → K} {c : K}
    (hu : (σ ∘ u) ⬝ᵥ (stdUnitMat K r *ᵥ u) = 0) (huw : (σ ∘ u) ⬝ᵥ (stdUnitMat K r *ᵥ w) = 0)
    (hc : c + (-1 : K) ^ r * σ c + (-1 : K) ^ r * ((σ ∘ w) ⬝ᵥ (stdUnitMat K r *ᵥ w)) = 0)
    (hg : ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
      (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) u w c) :
    g ∈ siegelClosure σ r :=
  Subgroup.subset_closure ⟨u, w, c, hu, huw, hc, hg⟩

/-- Every unitary transvection `τ_{v, a}` is the Siegel transformation `S(v, 0, a)`, so the
unitary-transvection subgroup lies inside `siegelClosure σ r`. -/
private theorem iSup_unitaryTransvectionSubgroup_le_siegelClosure (hσ : Function.Involutive σ)
    (r : ℕ) :
    ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p ≤ siegelClosure σ r := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have hdet : (stdUnitMat K r).det ≠ 0 := (isUnits_det_units _).ne_zero
  refine iSup_le fun p g hg ↦ ?_
  obtain ⟨a, ha⟩ := mem_unitaryTransvectionSubgroup_iff.mp hg
  have hadm := (exists_coe_eq_unitaryTransvection_iff hσ hQ hdet p a).mp ⟨⟨g, hg⟩, ha⟩
  exact mem_siegelClosure_of_coe_eq (w := 0) (c := a) (comp_rep_dotProduct_mulVec_rep p) (by simp)
    (by simp [hadm]) (by rwa [siegelTransvection_zero_eq_unitaryTransvection])

/-- For `3 ≤ r`, `v = z • e₀ + e₁ + σ(z) • e_{r - 1} + e_r` is isotropic with `B(e₀, v) = 1` and
`B(e_r, v) = (-1) ^ r * z`. -/
private theorem exists_isotropic_pairings_of_three_le (hσ : Function.Involutive σ) {r : ℕ}
    (hr : 3 ≤ r) (z : K) :
    ∃ v : Fin (r + 1) → K,
      (σ ∘ v) ⬝ᵥ ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) = 0 ∧
      (σ ∘ Pi.single 0 1) ⬝ᵥ
        ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) = 1 ∧
      (σ ∘ Pi.single (Fin.last r) 1) ⬝ᵥ
        ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) =
        (-1 : K) ^ r * z := by
  let i₁ : Fin (r + 1) := ⟨1, by omega⟩
  let i₂ : Fin (r + 1) := i₁.rev
  have h01 : (0 : Fin (r + 1)) ≠ i₁ := by simp [i₁, Fin.ext_iff]
  have h02 : (0 : Fin (r + 1)) ≠ i₂ := by simp [i₂, i₁, Fin.rev, Fin.ext_iff]; omega
  have h0r : (0 : Fin (r + 1)) ≠ Fin.last r := by simp [Fin.ext_iff]; omega
  have h12 : i₁ ≠ i₂ := by simp [i₂, i₁, Fin.rev, Fin.ext_iff]; omega
  have h1r : i₁ ≠ Fin.last r := by simp [i₁, Fin.ext_iff]; omega
  have h2r : i₂ ≠ Fin.last r := by simp [i₂, i₁, Fin.rev, Fin.ext_iff]; omega
  set v : Fin (r + 1) → K :=
    z • Pi.single 0 1 + Pi.single i₁ 1 + σ z • Pi.single i₂ 1 + Pi.single (Fin.last r) 1
  have hcomp (i : Fin (r + 1)) : σ ∘ Pi.single i (1 : K) = Pi.single i 1 := funext fun j ↦ by
    by_cases hj : j = i <;> simp [hj]
  refine ⟨v, ?_, ?_, ?_⟩
  · have hv0 : v 0 = z := by simp [v, h01, h02, h0r]
    have hv1 : v i₁ = 1 := by simp [v, h01.symm, h12, h1r]
    have hv2 : v i₂ = σ z := by simp [v, h02.symm, h12.symm, h2r]
    have hvr : v (Fin.last r) = 1 := by simp [v, h0r.symm, h1r.symm, h2r.symm]
    rw [dotProduct_typeAGraphConjugator_mulVec]
    have hterm (k : Fin (r + 1)) :
        (-1 : K) ^ (k : ℕ) * ((σ ∘ v) k * v k.rev) =
          (if k = 0 then σ z else 0) + (if k = i₁ then -σ z else 0) +
          (if k = i₂ then (-1 : K) ^ (r - 1) * z else 0) +
          (if k = Fin.last r then (-1 : K) ^ r * z else 0) := by
      by_cases hk0 : k = 0
      · subst hk0; simp [hv0, Fin.rev_zero, hvr, h01, h02, h0r]
      by_cases hk1 : k = i₁
      · subst hk1; simp [hk0, hv1, show i₁.rev = i₂ from rfl, hv2, h12, h1r, i₁]
      by_cases hk2 : k = i₂
      · subst hk2
        have hrev2 : i₂.rev = i₁ := Fin.rev_rev i₁
        have hval2 : (i₂ : ℕ) = r - 1 := by simp [i₂, i₁, Fin.rev]
        rw [Function.comp_apply, hv2, hrev2, hv1, hσ, mul_one, hval2]
        simp [hk0, hk1, h2r]
      by_cases hkr : k = Fin.last r
      · subst hkr; simp [hk0, hk1, hk2, hvr, Fin.rev_last, hv0]
      · simp [hk0, hk1, hk2, hkr, v, Pi.single_apply]
    simp only [hterm, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
    have hr1 : (-1 : K) ^ r = -((-1 : K) ^ (r - 1)) := by
      conv_lhs => rw [show r = (r - 1) + 1 by omega]
      rw [pow_succ]; ring
    rw [hr1]; ring
  · rw [hcomp, single_one_dotProduct, coe_typeAGraphConjugator_mulVec]
    simp [v, Fin.rev_zero, h0r.symm, h1r.symm, h2r.symm]
  · rw [hcomp, single_one_dotProduct, coe_typeAGraphConjugator_mulVec]
    simp [v, Fin.rev_last, h01, h02, h0r]

/-- For `2 ≤ r`, construct an isotropic vector `v(z)` with `B(e₀, v(z)) = 1` and
`B(e_r, v(z)) = (-1) ^ r * z`, using `hnorm` when `r = 2`. -/
private theorem exists_isotropic_pairings_single_zero_last (hσ : Function.Involutive σ) {r : ℕ}
    (hr : 2 ≤ r) (hnorm : r = 2 → ∀ s : K, σ s = s → ∃ b : K, σ b * b = s) (z : K) :
    ∃ v : Fin (r + 1) → K,
      (σ ∘ v) ⬝ᵥ ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) = 0 ∧
      (σ ∘ Pi.single 0 1) ⬝ᵥ
        ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) = 1 ∧
      (σ ∘ Pi.single (Fin.last r) 1) ⬝ᵥ
        ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ v) =
        (-1 : K) ^ r * z := by
  rcases eq_or_lt_of_le hr with rfl | hr3
  · obtain ⟨x, hx⟩ := hnorm rfl (σ z + z) (by rw [map_add, hσ, add_comm])
    refine ⟨![z, x, 1], ?_, ?_, ?_⟩
    · rw [coe_typeAGraphConjugator_two]
      simp [dotProduct, mulVec, Fin.sum_univ_three]
      linear_combination -hx
    · have hcomp : σ ∘ Pi.single (0 : Fin 3) (1 : K) = Pi.single 0 1 := funext fun j ↦ by
        fin_cases j <;> simp
      rw [hcomp, single_one_dotProduct, coe_typeAGraphConjugator_mulVec]; simp [Fin.rev_zero]
    · have hcomp : σ ∘ Pi.single (Fin.last 2) (1 : K) = Pi.single 2 1 := funext fun j ↦ by
        fin_cases j <;> simp
      rw [hcomp, single_one_dotProduct, coe_typeAGraphConjugator_mulVec]; simp [Fin.rev]
  · exact exists_isotropic_pairings_of_three_le hσ hr3 z

/-- For `2 ≤ r` and `t ≠ 0`, `siegelClosure σ r` contains an element sending `e_r ↦ t • e₀`. -/
private theorem exists_mem_siegelClosure_mulVec_last_eq_smul_zero (hσ : Function.Involutive σ)
    {r : ℕ} (hr : 2 ≤ r) (hnorm : r = 2 → ∀ s : K, σ s = s → ∃ b : K, σ b * b = s)
    {t : K} (ht0 : t ≠ 0) :
    ∃ m ∈ siegelClosure σ r,
      ((m : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ Pi.single (Fin.last r) 1 =
        t • Pi.single 0 1 := by
  let Q := stdUnitMat K r
  let ε := (-1 : K) ^ r
  have hQ : (Q.map σ)ᵀ = ε • Q := transpose_map_typeAGraphConjugator σ r
  have h0r : (0 : Fin (r + 1)) ≠ Fin.last r := by simp [Fin.ext_iff]; omega
  let e0 : Fin (r + 1) → K := Pi.single 0 1
  let er : Fin (r + 1) → K := Pi.single (Fin.last r) 1
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  have her := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := Fin.last r)
    (by rw [Fin.rev_last]; exact h0r.symm)
  obtain ⟨he0r, her0⟩ := comp_single_zero_last_stdUnitMat σ r
  have hε0 : ε ≠ 0 := pow_ne_zero r (neg_ne_zero.mpr one_ne_zero)
  obtain ⟨v, hv, h0v, hrv⟩ := exists_isotropic_pairings_single_zero_last hσ hr hnorm t
  obtain ⟨g₁, hg₁, w₁, c₁, huw₁, hc₁, hS₁, -, hg₁er⟩ :=
    exists_mem_specialIsometryGroup_coe_eq_siegelTransvection_mulVec_eq_self_and_mulVec_eq
      hσ hQ he0 her hv (by rw [he0r]; exact one_ne_zero) (he0r.trans h0v.symm)
  have hte0 : (σ ∘ (t • e0)) ⬝ᵥ (Q *ᵥ (t • e0)) = 0 := by
    rw [TauCeti.map_comp_smul, smul_dotProduct, mulVec_smul, dotProduct_smul, he0, smul_zero,
      smul_zero]
  have hrte0 : (σ ∘ er) ⬝ᵥ (Q *ᵥ (t • e0)) = ε * t := by
    rw [mulVec_smul, dotProduct_smul, smul_eq_mul, her0, mul_comm]
  obtain ⟨g₂, hg₂, w₂, c₂, huw₂, hc₂, hS₂, -, hg₂v⟩ :=
    exists_mem_specialIsometryGroup_coe_eq_siegelTransvection_mulVec_eq_self_and_mulVec_eq
      hσ hQ her hv hte0 (by rw [hrv]; exact mul_ne_zero hε0 ht0) (hrv.trans hrte0.symm)
  refine ⟨⟨g₂, hg₂⟩ * ⟨g₁, hg₁⟩, mul_mem (mem_siegelClosure_of_coe_eq her huw₂ hc₂ hS₂)
    (mem_siegelClosure_of_coe_eq he0 huw₁ hc₁ hS₁), ?_⟩
  rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, ← mulVec_mulVec, hg₁er, hg₂v]

/-- For `2 ≤ r` and `z ≠ 0`, `siegelClosure σ r` contains an element scaling `e₀ ↦ (σ z)⁻¹ • e₀`
and `e_r ↦ z • e_r`. -/
private theorem exists_mem_siegelClosure_mulVec_single_zero_and_last (hσ : Function.Involutive σ)
    {r : ℕ} (hr : 2 ≤ r) (hnorm : r = 2 → ∀ s : K, σ s = s → ∃ b : K, σ b * b = s)
    {z : K} (hz0 : z ≠ 0) :
    ∃ h ∈ siegelClosure σ r,
      ((h : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ Pi.single 0 1 = (σ z)⁻¹ • Pi.single 0 1 ∧
      ((h : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ Pi.single (Fin.last r) 1 =
        z • Pi.single (Fin.last r) 1 := by
  let Q := stdUnitMat K r
  let ε := (-1 : K) ^ r
  have hQ : (Q.map σ)ᵀ = ε • Q := transpose_map_typeAGraphConjugator σ r
  have h0r : (0 : Fin (r + 1)) ≠ Fin.last r := by simp [Fin.ext_iff]; omega
  let e0 : Fin (r + 1) → K := Pi.single 0 1
  let er : Fin (r + 1) → K := Pi.single (Fin.last r) 1
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  have her := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := Fin.last r)
    (by rw [Fin.rev_last]; exact h0r.symm)
  obtain ⟨-, her0⟩ := comp_single_zero_last_stdUnitMat σ r
  obtain ⟨m₁, hm₁, hm₁er⟩ := exists_mem_siegelClosure_mulVec_last_eq_smul_zero hσ hr hnorm
    one_ne_zero
  obtain ⟨mz, hmz, hmzer⟩ := exists_mem_siegelClosure_mulVec_last_eq_smul_zero hσ hr hnorm hz0
  let n : Q.specialIsometryGroup σ := m₁⁻¹ * mz
  have hnS : n ∈ siegelClosure σ r := mul_mem (inv_mem hm₁) hmz
  have hner : ((n : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ er = z • er := by
    have hm₁inv := congrArg ((((m₁⁻¹ : Q.specialIsometryGroup σ) :
      Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ ·) hm₁er
    rw [one_smul, mulVec_mulVec, ← Matrix.SpecialLinearGroup.coe_mul, ← Subgroup.coe_mul,
      inv_mul_cancel, Subgroup.coe_one, Matrix.SpecialLinearGroup.coe_one, one_mulVec] at hm₁inv
    rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, ← mulVec_mulVec, hmzer, mulVec_smul,
      ← hm₁inv]
  let u₁ := ((n : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
    Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ e0
  have hu₁ : (σ ∘ u₁) ⬝ᵥ (Q *ᵥ u₁) = 0 := by
    rw [comp_mulVec_dotProduct_mulVec_mulVec (mem_specialIsometryGroup_iff.mp n.2), he0]
  have hσz0 : σ z ≠ 0 := (map_ne_zero σ).mpr hz0
  have hε0 : ε ≠ 0 := pow_ne_zero r (neg_ne_zero.mpr one_ne_zero)
  have hru₁ : (σ ∘ er) ⬝ᵥ (Q *ᵥ u₁) = (σ z)⁻¹ * ε := by
    have hpres := comp_mulVec_dotProduct_mulVec_mulVec (mem_specialIsometryGroup_iff.mp n.2) er e0
    rw [hner, her0, TauCeti.map_comp_smul, smul_dotProduct, smul_eq_mul] at hpres
    exact mul_left_cancel₀ hσz0 (by rw [← mul_assoc, mul_inv_cancel₀ hσz0, one_mul]; exact hpres)
  have hu₀ : (σ ∘ ((σ z)⁻¹ • e0)) ⬝ᵥ (Q *ᵥ ((σ z)⁻¹ • e0)) = 0 := by
    rw [TauCeti.map_comp_smul, smul_dotProduct, mulVec_smul, dotProduct_smul, he0, smul_zero,
      smul_zero]
  have hru₀ : (σ ∘ er) ⬝ᵥ (Q *ᵥ ((σ z)⁻¹ • e0)) = (σ z)⁻¹ * ε := by
    rw [mulVec_smul, dotProduct_smul, smul_eq_mul, her0]
  obtain ⟨g₃, hg₃, w₃, c₃, huw₃, hc₃, hS₃, hg₃er, hg₃u₁⟩ :=
    exists_mem_specialIsometryGroup_coe_eq_siegelTransvection_mulVec_eq_self_and_mulVec_eq hσ hQ
      her hu₁ hu₀ (by rw [hru₁]; exact mul_ne_zero (inv_ne_zero hσz0) hε0) (hru₁.trans hru₀.symm)
  refine ⟨⟨g₃, hg₃⟩ * n, mul_mem (mem_siegelClosure_of_coe_eq her huw₃ hc₃ hS₃) hnS, ?_, ?_⟩
  · rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, ← mulVec_mulVec, hg₃u₁]
  · rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, ← mulVec_mulVec, hner, mulVec_smul,
      hg₃er]

/-! ### Border embedding `Q_{r'} ↪ Q_{r' + 2}` via `cornerBlockSucc 1 ∘ blockSucc` -/

private def innerIdx {r' : ℕ} (i : Fin (r' + 1)) : Fin (r' + 2 + 1) :=
  i.castSucc.succ

@[simp]
private theorem innerIdx_rev {r' : ℕ} (i : Fin (r' + 1)) :
    (innerIdx i).rev = innerIdx i.rev := by
  ext; simp [innerIdx, Fin.rev]; omega

@[simp]
private theorem innerIdx_ne_zero {r' : ℕ} (i : Fin (r' + 1)) : innerIdx i ≠ 0 :=
  Fin.succ_ne_zero _

@[simp]
private theorem zero_ne_innerIdx {r' : ℕ} (i : Fin (r' + 1)) : 0 ≠ innerIdx i :=
  (Fin.succ_ne_zero _).symm

@[simp]
private theorem innerIdx_ne_last {r' : ℕ} (i : Fin (r' + 1)) :
    innerIdx i ≠ Fin.last (r' + 2) := by
  rw [← Fin.succ_last (r' + 1), innerIdx, ne_eq, Fin.succ_inj]
  exact (Fin.castSucc_lt_last i).ne

@[simp]
private theorem last_ne_innerIdx {r' : ℕ} (i : Fin (r' + 1)) :
    Fin.last (r' + 2) ≠ innerIdx i :=
  (innerIdx_ne_last i).symm

private def borderVec {r' : ℕ} (v : Fin (r' + 1) → K) : Fin (r' + 2 + 1) → K :=
  Fin.cons 0 (Fin.snoc v 0)

@[simp]
private theorem borderVec_zero {r' : ℕ} (v : Fin (r' + 1) → K) : borderVec v 0 = 0 := rfl

@[simp]
private theorem borderVec_last {r' : ℕ} (v : Fin (r' + 1) → K) :
    borderVec v (Fin.last (r' + 2)) = 0 := by
  rw [← Fin.succ_last (r' + 1)]; simp [borderVec]

@[simp]
private theorem borderVec_innerIdx {r' : ℕ} (v : Fin (r' + 1) → K) (i : Fin (r' + 1)) :
    borderVec v (innerIdx i) = v i := by
  simp [borderVec, innerIdx]

private def borderMat {r' : ℕ} (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) :
    Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K :=
  cornerBlockSucc 1 (blockSucc A)

@[simp] private theorem borderMat_zero_zero {r' : ℕ} (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) :
    borderMat A 0 0 = 1 := cornerBlockSucc_zero_zero _ _

@[simp] private theorem borderMat_zero_succ {r' : ℕ} (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K)
    (j : Fin (r' + 2)) : borderMat A 0 j.succ = 0 := cornerBlockSucc_zero_succ _ _ j

@[simp] private theorem borderMat_succ_zero {r' : ℕ} (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K)
    (i : Fin (r' + 2)) : borderMat A i.succ 0 = 0 := cornerBlockSucc_succ_zero _ _ i

@[simp] private theorem borderMat_zero_last {r' : ℕ} (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) :
    borderMat A 0 (Fin.last (r' + 2)) = 0 := by
  rw [← Fin.succ_last (r' + 1), borderMat_zero_succ]

@[simp] private theorem borderMat_last_zero {r' : ℕ} (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) :
    borderMat A (Fin.last (r' + 2)) 0 = 0 := by
  rw [← Fin.succ_last (r' + 1), borderMat_succ_zero]

@[simp] private theorem borderMat_zero_innerIdx {r' : ℕ}
    (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) (j : Fin (r' + 1)) :
    borderMat A 0 (innerIdx j) = 0 := borderMat_zero_succ A j.castSucc

@[simp] private theorem borderMat_innerIdx_zero {r' : ℕ}
    (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) (i : Fin (r' + 1)) :
    borderMat A (innerIdx i) 0 = 0 := borderMat_succ_zero A i.castSucc

@[simp] private theorem borderMat_innerIdx_innerIdx {r' : ℕ}
    (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) (i j : Fin (r' + 1)) :
    borderMat A (innerIdx i) (innerIdx j) = A i j := by
  simp [borderMat, innerIdx]

@[simp] private theorem borderMat_innerIdx_last {r' : ℕ}
    (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) (i : Fin (r' + 1)) :
    borderMat A (innerIdx i) (Fin.last (r' + 2)) = 0 := by
  rw [← Fin.succ_last (r' + 1), borderMat, innerIdx, cornerBlockSucc_succ_succ,
    blockSucc_castSucc_last]

@[simp] private theorem borderMat_last_innerIdx {r' : ℕ}
    (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) (j : Fin (r' + 1)) :
    borderMat A (Fin.last (r' + 2)) (innerIdx j) = 0 := by
  rw [← Fin.succ_last (r' + 1), borderMat, innerIdx, cornerBlockSucc_succ_succ,
    blockSucc_last_castSucc]

@[simp] private theorem borderMat_last_last {r' : ℕ} (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) :
    borderMat A (Fin.last (r' + 2)) (Fin.last (r' + 2)) = 1 := by
  rw [← Fin.succ_last (r' + 1), borderMat, cornerBlockSucc_succ_succ, blockSucc_last_last]

private theorem forall_fin_border {r' : ℕ} {P : Fin (r' + 2 + 1) → Prop} (h0 : P 0)
    (hinner : ∀ i : Fin (r' + 1), P (innerIdx i)) (hlast : P (Fin.last (r' + 2))) :
    ∀ k : Fin (r' + 2 + 1), P k := by
  intro k
  induction k using Fin.cases with
  | zero => exact h0
  | succ k₁ =>
    induction k₁ using Fin.lastCases with
    | last => exact Fin.succ_last (r' + 1) ▸ hlast
    | cast i => exact hinner i

private theorem sum_fin_border {r' : ℕ} (f : Fin (r' + 2 + 1) → K) :
    ∑ k : Fin (r' + 2 + 1), f k =
      f 0 + (∑ i : Fin (r' + 1), f (innerIdx i)) + f (Fin.last (r' + 2)) := by
  rw [Fin.sum_univ_succ, Fin.sum_univ_castSucc]
  simp [innerIdx, add_assoc]

private theorem comp_borderVec_dotProduct_typeAGraphConjugator_mulVec {r' : ℕ}
    (x : Fin (r' + 1) → K) (v : Fin (r' + 2 + 1) → K) :
    (σ ∘ borderVec x) ⬝ᵥ
      ((typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ v) =
      -((σ ∘ x) ⬝ᵥ ((typeAGraphConjugator r' K :
        Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) *ᵥ fun j ↦ v (innerIdx j))) := by
  rw [dotProduct_typeAGraphConjugator_mulVec, dotProduct_typeAGraphConjugator_mulVec,
    sum_fin_border]
  simp only [Function.comp_apply, borderVec_zero, borderVec_last, map_zero, zero_mul, mul_zero,
    zero_add, add_zero, borderVec_innerIdx, innerIdx_rev, ← Finset.sum_neg_distrib]
  exact Finset.sum_congr rfl fun i _ ↦ by simp [innerIdx, pow_succ, neg_mul]

private theorem det_borderMat {r' : ℕ} (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) :
    (borderMat A).det = A.det := by
  have hsub : (borderMat A).submatrix Fin.succ Fin.succ = blockSucc A := by
    ext i j; simp [borderMat]
  rw [det_succ_row_zero, Finset.sum_eq_single 0
    (fun j _ hj ↦ by obtain ⟨k, rfl⟩ := Fin.eq_succ_of_ne_zero hj; simp)
    (fun h ↦ absurd (Finset.mem_univ _) h)]
  rw [Fin.val_zero, pow_zero, one_mul, borderMat_zero_zero, one_mul, Fin.succAbove_zero, hsub,
    det_blockSucc]

private theorem transpose_map_borderMat {r' : ℕ} (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) :
    ((borderMat A).map σ)ᵀ = borderMat ((A.map σ)ᵀ) := by
  refine ext_fin_succ (by simp) (fun j ↦ by simp) (fun i ↦ by simp) (fun i j ↦ ?_)
  rw [transpose_apply, map_apply, borderMat, cornerBlockSucc_succ_succ, borderMat,
    cornerBlockSucc_succ_succ, ← transpose_blockSucc, ← map_blockSucc, transpose_apply, map_apply]

private def borderSL {r' : ℕ} (A : Matrix.SpecialLinearGroup (Fin (r' + 1)) K) :
    Matrix.SpecialLinearGroup (Fin (r' + 2 + 1)) K :=
  ⟨borderMat (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K), by rw [det_borderMat, A.2]⟩

@[simp]
private theorem coe_borderSL {r' : ℕ} (A : Matrix.SpecialLinearGroup (Fin (r' + 1)) K) :
    (borderSL A : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) =
      borderMat (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) := rfl

private theorem borderSL_mem_specialIsometryGroup_iff {r' : ℕ}
    (A : Matrix.SpecialLinearGroup (Fin (r' + 1)) K) :
    borderSL A ∈ (typeAGraphConjugator (r' + 2) K :
        Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K).specialIsometryGroup σ ↔
      A ∈ (typeAGraphConjugator r' K :
        Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).specialIsometryGroup σ := by
  rw [mem_specialIsometryGroup_iff, mem_specialIsometryGroup_iff, coe_borderSL]
  have hinj : Function.Injective (innerIdx (r' := r')) :=
    (Fin.succ_injective _).comp (Fin.castSucc_injective _)
  have hQ_inner (i j : Fin (r' + 1)) :
      (typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K)
        (innerIdx i) (innerIdx j) =
      -(typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) i j := by
    rw [typeAGraphConjugator_apply, typeAGraphConjugator_apply, innerIdx_rev]
    simp only [hinj.eq_iff]
    by_cases hp : j = i.rev <;> simp [hp, innerIdx, pow_succ]
  have hQB (k l : Fin (r' + 2 + 1)) :
      ((typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *
        borderMat (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K)) k l =
      (-1 : K) ^ (k : ℕ) * borderMat (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) k.rev l := by
    rw [Matrix.mul_apply]; simp [typeAGraphConjugator_apply]
  have hQA (m j : Fin (r' + 1)) :
      ((typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *
        borderMat (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K)) (innerIdx m) (innerIdx j) =
      -(((typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) *
        (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K)) m j) := by
    rw [hQB, innerIdx_rev, borderMat_innerIdx_innerIdx, Matrix.mul_apply]
    simp [typeAGraphConjugator_apply, innerIdx, pow_succ]
  have hLHS (i j : Fin (r' + 1)) :
      (((borderMat (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K)).map σ)ᵀ *
        (typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *
        borderMat (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K)) (innerIdx i) (innerIdx j) =
      -((((A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).map σ)ᵀ *
        (typeAGraphConjugator r' K : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) *
        (A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K)) i j) := by
    rw [transpose_map_borderMat, Matrix.mul_assoc, Matrix.mul_apply, sum_fin_border]
    simp only [borderMat_innerIdx_zero, borderMat_innerIdx_last, borderMat_innerIdx_innerIdx,
      zero_mul, zero_add, add_zero, hQA, mul_neg, Finset.sum_neg_distrib]
    rw [Matrix.mul_assoc, Matrix.mul_apply]
  have hlast0 : (Fin.last (r' + 2) : Fin (r' + 2 + 1)) ≠ 0 := Fin.last_pos.ne'
  refine ⟨fun h ↦ Matrix.ext fun i j ↦ neg_injective ?_, fun h ↦ Matrix.ext <| ?_⟩
  · have hij := congrArg (fun N ↦ N (innerIdx i) (innerIdx j)) h
    rwa [hLHS, hQ_inner] at hij
  · refine forall_fin_border ?_ (fun i ↦ ?_) ?_
    · refine forall_fin_border ?_ (fun j ↦ ?_) ?_ <;>
        rw [transpose_map_borderMat, Matrix.mul_assoc, Matrix.mul_apply, sum_fin_border] <;>
        simp [hQB, typeAGraphConjugator_apply, Fin.rev_zero, hlast0.symm]
    · refine forall_fin_border ?_ (fun j ↦ by rw [hLHS, h, hQ_inner]) ?_ <;>
        rw [transpose_map_borderMat, Matrix.mul_assoc, Matrix.mul_apply, sum_fin_border] <;>
        simp [hQB, typeAGraphConjugator_apply]
    · refine forall_fin_border ?_ (fun j ↦ ?_) ?_ <;>
        rw [transpose_map_borderMat, Matrix.mul_assoc, Matrix.mul_apply, sum_fin_border] <;>
        simp [hQB, typeAGraphConjugator_apply, Fin.rev_last, hlast0]

private def borderHom {r' : ℕ} :
    (typeAGraphConjugator r' K :
      Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).specialIsometryGroup σ →*
      (typeAGraphConjugator (r' + 2) K :
        Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K).specialIsometryGroup σ where
  toFun g := ⟨borderSL (g : Matrix.SpecialLinearGroup (Fin (r' + 1)) K),
    (borderSL_mem_specialIsometryGroup_iff _).mpr g.2⟩
  map_one' := Subtype.ext (Subtype.ext (by simp [borderSL, borderMat]))
  map_mul' _ _ := by
    apply Subtype.ext; apply Subtype.ext
    simp only [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, coe_borderSL, borderMat,
      blockSucc_mul, cornerBlockSucc_mul_cornerBlockSucc, mul_one]

private theorem coe_borderHom_eq_siegelTransvection {r' : ℕ}
    (u w : Fin (r' + 1) → K) (c : K) :
    borderMat ((typeAGraphConjugator r' K :
        Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).siegelTransvection σ ((-1 : K) ^ r') u w c) =
      (typeAGraphConjugator (r' + 2) K :
        Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K).siegelTransvection σ ((-1 : K) ^ (r' + 2))
        (borderVec u) (-borderVec w) (-c) := by
  refine mulVec_injective (funext fun v ↦ funext <| forall_fin_border ?_ (fun i ↦ ?_) ?_)
  · rw [siegelTransvection_mulVec, mulVec, dotProduct, sum_fin_border]; simp
  · have hbm (N : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) :
        (borderMat N *ᵥ v) (innerIdx i) = (N *ᵥ fun j ↦ v (innerIdx j)) i := by
      rw [mulVec, dotProduct, sum_fin_border]; simp [mulVec, dotProduct]
    have hpair_neg : (σ ∘ (-borderVec w)) ⬝ᵥ
        ((typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ v) =
        (σ ∘ w) ⬝ᵥ ((typeAGraphConjugator r' K :
          Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) *ᵥ fun j ↦ v (innerIdx j)) := by
      rw [show σ ∘ (-borderVec w) = -(σ ∘ borderVec w) from funext fun _ ↦ by simp, neg_dotProduct,
        comp_borderVec_dotProduct_typeAGraphConjugator_mulVec, neg_neg]
    rw [hbm, siegelTransvection_mulVec, siegelTransvection_mulVec,
      comp_borderVec_dotProduct_typeAGraphConjugator_mulVec, hpair_neg,
      show (-1 : K) ^ (r' + 2) = (-1 : K) ^ r' by simp [pow_add]]
    simp only [Pi.sub_apply, Pi.add_apply, Pi.smul_apply, Pi.neg_apply, borderVec_innerIdx,
      smul_eq_mul]
    ring
  · rw [siegelTransvection_mulVec, mulVec, dotProduct, sum_fin_border]; simp

private theorem mem_range_borderHom_of_mulVec_single_eq {r' : ℕ}
    {g : (typeAGraphConjugator (r' + 2) K :
      Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K).specialIsometryGroup σ}
    (hg0 : ((g : Matrix.SpecialLinearGroup (Fin (r' + 2 + 1)) K) :
      Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ Pi.single 0 1 = Pi.single 0 1)
    (hgl : ((g : Matrix.SpecialLinearGroup (Fin (r' + 2 + 1)) K) :
      Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ Pi.single (Fin.last (r' + 2)) 1 =
      Pi.single (Fin.last (r' + 2)) 1) :
    g ∈ (borderHom (σ := σ) (r' := r')).range := by
  let M := ((g : Matrix.SpecialLinearGroup (Fin (r' + 2 + 1)) K) :
    Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K)
  let A : Matrix (Fin (r' + 1)) (Fin (r' + 1)) K := fun i j ↦ M (innerIdx i) (innerIdx j)
  have hcol0 (k : Fin (r' + 2 + 1)) : M k 0 = if k = 0 then 1 else 0 := by
    simpa [mulVec, dotProduct, Pi.single_apply] using congrFun hg0 k
  have hcoll (k : Fin (r' + 2 + 1)) :
      M k (Fin.last (r' + 2)) = if k = Fin.last (r' + 2) then 1 else 0 := by
    simpa [mulVec, dotProduct, Pi.single_apply] using congrFun hgl k
  have hrow0 (j : Fin (r' + 1)) : M 0 (innerIdx j) = 0 := by
    have hp := comp_mulVec_dotProduct_mulVec_mulVec (mem_specialIsometryGroup_iff.mp g.2)
      (Pi.single (Fin.last (r' + 2)) 1) (Pi.single (innerIdx j) 1)
    have hc : σ ∘ Pi.single (Fin.last (r' + 2)) (1 : K) = Pi.single (Fin.last (r' + 2)) 1 :=
      funext fun m ↦ by by_cases hm : m = Fin.last (r' + 2) <;> simp [hm]
    rw [hgl, hc, single_one_dotProduct, single_one_dotProduct, coe_typeAGraphConjugator_mulVec,
      coe_typeAGraphConjugator_mulVec] at hp
    simp only [Fin.rev_last, Pi.single_apply, zero_ne_innerIdx, ↓reduceIte, mul_zero] at hp
    have hM0 : M 0 (innerIdx j) = (M *ᵥ Pi.single (innerIdx j) 1) 0 := by
      simp [mulVec, dotProduct, Pi.single_apply]
    exact hM0 ▸ (mul_eq_zero.mp hp).resolve_left (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero))
  have hrowl (j : Fin (r' + 1)) : M (Fin.last (r' + 2)) (innerIdx j) = 0 := by
    have hp := comp_mulVec_dotProduct_mulVec_mulVec (mem_specialIsometryGroup_iff.mp g.2)
      (Pi.single 0 1) (Pi.single (innerIdx j) 1)
    have hc : σ ∘ Pi.single (0 : Fin (r' + 2 + 1)) (1 : K) = Pi.single 0 1 :=
      funext fun m ↦ by by_cases hm : m = 0 <;> simp [hm]
    rw [hg0, hc, single_one_dotProduct, single_one_dotProduct, coe_typeAGraphConjugator_mulVec,
      coe_typeAGraphConjugator_mulVec] at hp
    simpa [Fin.rev_zero, Pi.single_apply, mulVec, dotProduct] using hp
  have hlast0 : (Fin.last (r' + 2) : Fin (r' + 2 + 1)) ≠ 0 := Fin.last_pos.ne'
  have hM : borderMat A = M := Matrix.ext <| forall_fin_border
    (forall_fin_border (by simp [hcol0 0]) (fun j ↦ by simp [hrow0 j])
      (by simp [hcoll 0, hlast0.symm]))
    (fun i ↦ forall_fin_border (by simp [hcol0 (innerIdx i)])
      (fun j ↦ borderMat_innerIdx_innerIdx A i j) (by simp [hcoll (innerIdx i)]))
    (forall_fin_border (by simp [hcol0 (Fin.last (r' + 2)), hlast0])
      (fun j ↦ by simp [hrowl j]) (by simp [hcoll (Fin.last (r' + 2))]))
  let ASL : Matrix.SpecialLinearGroup (Fin (r' + 1)) K :=
    ⟨A, by rw [← det_borderMat, hM, (g : Matrix.SpecialLinearGroup (Fin (r' + 2 + 1)) K).2]⟩
  have hSL : borderSL ASL = (g : Matrix.SpecialLinearGroup (Fin (r' + 2 + 1)) K) := Subtype.ext hM
  have hAmem : ASL ∈ (typeAGraphConjugator r' K :
      Matrix (Fin (r' + 1)) (Fin (r' + 1)) K).specialIsometryGroup σ :=
    (borderSL_mem_specialIsometryGroup_iff ASL).mp (hSL ▸ g.2)
  exact ⟨⟨ASL, hAmem⟩, Subtype.ext hSL⟩

private theorem siegelClosure_le_comap_borderHom (r' : ℕ) :
    siegelClosure σ r' ≤ (siegelClosure σ (r' + 2)).comap borderHom := by
  rw [siegelClosure, Subgroup.closure_le]
  rintro k ⟨u', w', c', hu', huw', hc', hk⟩
  rw [SetLike.mem_coe, Subgroup.mem_comap]
  have hbu : (σ ∘ borderVec u') ⬝ᵥ
      ((typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ
        borderVec u') = 0 := by
    rw [comp_borderVec_dotProduct_typeAGraphConjugator_mulVec]
    simpa using congrArg Neg.neg hu'
  have hbuw : (σ ∘ borderVec u') ⬝ᵥ
      ((typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ
        (-borderVec w')) = 0 := by
    rw [mulVec_neg, dotProduct_neg, comp_borderVec_dotProduct_typeAGraphConjugator_mulVec, neg_neg]
    simpa using huw'
  have hww : (σ ∘ (-borderVec w')) ⬝ᵥ
      ((typeAGraphConjugator (r' + 2) K : Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ
        (-borderVec w')) =
      -((σ ∘ w') ⬝ᵥ ((typeAGraphConjugator r' K :
        Matrix (Fin (r' + 1)) (Fin (r' + 1)) K) *ᵥ w')) := by
    rw [show σ ∘ (-borderVec w') = -(σ ∘ borderVec w') from funext fun _ ↦ by simp, mulVec_neg,
      neg_dotProduct, dotProduct_neg, neg_neg,
      comp_borderVec_dotProduct_typeAGraphConjugator_mulVec]
    simp only [borderVec_innerIdx]
  have hbc : (-c') + (-1 : K) ^ (r' + 2) * σ (-c') + (-1 : K) ^ (r' + 2) *
      ((σ ∘ (-borderVec w')) ⬝ᵥ ((typeAGraphConjugator (r' + 2) K :
        Matrix (Fin (r' + 2 + 1)) (Fin (r' + 2 + 1)) K) *ᵥ (-borderVec w'))) = 0 := by
    rw [hww, show (-1 : K) ^ (r' + 2) = (-1 : K) ^ r' by simp [pow_add], map_neg]
    linear_combination -hc'
  refine mem_siegelClosure_of_coe_eq hbu hbuw hbc ?_
  rw [← coe_borderHom_eq_siegelTransvection, ← hk]
  rfl

/-! ### Main Siegel generation theorem -/

/-- Left-multiply any `g ∈ Q_{r₁ + 1}.specialIsometryGroup σ` by an element of `siegelClosure` so
that `e₀` and `e_{r₁ + 1}` are scaled by `c` and `(σ c)⁻¹`. -/
private theorem exists_mem_siegelClosure_mul_mulVec_single_zero_and_last
    (hσ : Function.Involutive σ) (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s)
    (hadm : ∃ d ≠ (0 : K), d + σ d = 0) {r₁ : ℕ}
    (g : (stdUnitMat K (r₁ + 1)).specialIsometryGroup σ) :
    ∃ h ∈ siegelClosure σ (r₁ + 1), ∃ c ≠ (0 : K),
      (((h * g : (stdUnitMat K (r₁ + 1)).specialIsometryGroup σ) :
        Matrix.SpecialLinearGroup (Fin (r₁ + 2)) K) :
        Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K) *ᵥ Pi.single 0 1 = c • Pi.single 0 1 ∧
      (((h * g : (stdUnitMat K (r₁ + 1)).specialIsometryGroup σ) :
        Matrix.SpecialLinearGroup (Fin (r₁ + 2)) K) :
        Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K) *ᵥ Pi.single (Fin.last (r₁ + 1)) 1 =
        (σ c)⁻¹ • Pi.single (Fin.last (r₁ + 1)) 1 := by
  let Q := stdUnitMat K (r₁ + 1)
  have hQ := transpose_map_typeAGraphConjugator σ (r₁ + 1)
  have hdet : Q.det ≠ 0 := (isUnits_det_units _).ne_zero
  have h0r : (0 : Fin (r₁ + 2)) ≠ Fin.last (r₁ + 1) := by simp [Fin.ext_iff]
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ)
    (i := (0 : Fin (r₁ + 2))) (by rwa [Fin.rev_zero])
  have her := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ)
    (i := Fin.last (r₁ + 1)) (by rw [Fin.rev_last]; exact h0r.symm)
  obtain ⟨he0r, -⟩ := comp_single_zero_last_stdUnitMat σ (r₁ + 1)
  have he00 : (Pi.single 0 1 : Fin (r₁ + 2) → K) ≠ 0 := Pi.single_ne_zero_iff.mpr one_ne_zero
  let ge0 := ((g : Matrix.SpecialLinearGroup (Fin (r₁ + 2)) K) :
    Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K) *ᵥ Pi.single 0 1
  have hge0_ne : ge0 ≠ 0 := fun h0 ↦ he00 (Matrix.eq_zero_of_mulVec_eq_zero
    (by rw [Matrix.SpecialLinearGroup.det_coe]; exact one_ne_zero) h0)
  have hge0_iso : (σ ∘ ge0) ⬝ᵥ (Q *ᵥ ge0) = 0 := by
    rw [comp_mulVec_dotProduct_mulVec_mulVec (mem_specialIsometryGroup_iff.mp g.2), he0]
  obtain ⟨h₁, hh₁W, c, hc0, hh₁e0⟩ := exists_mem_iSup_unitaryTransvectionSubgroup_mulVec_eq_smul
    hσ hQ hdet (fun _ hs ↦ exists_add_neg_one_pow_mul_apply_eq htr (r₁ + 1) hs)
    (exists_ne_zero_add_neg_one_pow_mul_apply_eq_zero hadm (r₁ + 1)) hge0_ne he00 hge0_iso he0
  have hh₁ := iSup_unitaryTransvectionSubgroup_le_siegelClosure hσ (r₁ + 1) hh₁W
  let g₁ := h₁ * g
  have hg₁e0 : ((g₁ : Matrix.SpecialLinearGroup (Fin (r₁ + 2)) K) :
      Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K) *ᵥ Pi.single 0 1 = c • Pi.single 0 1 := by
    rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, ← mulVec_mulVec, hh₁e0]
  let y₁ := ((g₁ : Matrix.SpecialLinearGroup (Fin (r₁ + 2)) K) :
    Matrix (Fin (r₁ + 2)) (Fin (r₁ + 2)) K) *ᵥ Pi.single (Fin.last (r₁ + 1)) 1
  have hy₁ : (σ ∘ y₁) ⬝ᵥ (Q *ᵥ y₁) = 0 := by
    rw [comp_mulVec_dotProduct_mulVec_mulVec (mem_specialIsometryGroup_iff.mp g₁.2), her]
  have hσc0 : σ c ≠ 0 := (map_ne_zero σ).mpr hc0
  have he0y₁ : (σ ∘ Pi.single 0 1) ⬝ᵥ (Q *ᵥ y₁) = (σ c)⁻¹ := by
    have hp := comp_mulVec_dotProduct_mulVec_mulVec (mem_specialIsometryGroup_iff.mp g₁.2)
      (Pi.single 0 1) (Pi.single (Fin.last (r₁ + 1)) 1)
    rw [hg₁e0, he0r, TauCeti.map_comp_smul, smul_dotProduct, smul_eq_mul] at hp
    exact mul_left_cancel₀ hσc0 (by rw [mul_inv_cancel₀ hσc0]; exact hp)
  have hy₀ : (σ ∘ ((σ c)⁻¹ • Pi.single (Fin.last (r₁ + 1)) 1)) ⬝ᵥ
      (Q *ᵥ ((σ c)⁻¹ • Pi.single (Fin.last (r₁ + 1)) 1)) = 0 := by
    rw [TauCeti.map_comp_smul, smul_dotProduct, mulVec_smul, dotProduct_smul, her, smul_zero,
      smul_zero]
  have he0y₀ : (σ ∘ Pi.single 0 1) ⬝ᵥ (Q *ᵥ ((σ c)⁻¹ • Pi.single (Fin.last (r₁ + 1)) 1)) =
      (σ c)⁻¹ := by rw [mulVec_smul, dotProduct_smul, smul_eq_mul, he0r, mul_one]
  obtain ⟨s₂, hs₂, w₂, c₂, huw₂, hc₂, hS₂, hs₂e0, hs₂y₁⟩ :=
    exists_mem_specialIsometryGroup_coe_eq_siegelTransvection_mulVec_eq_self_and_mulVec_eq
      hσ hQ he0 hy₁ hy₀ (by rw [he0y₁]; exact inv_ne_zero hσc0) (he0y₁.trans he0y₀.symm)
  refine ⟨⟨s₂, hs₂⟩ * h₁, mul_mem (mem_siegelClosure_of_coe_eq he0 huw₂ hc₂ hS₂) hh₁, c, hc0, ?_,
    ?_⟩
  · rw [mul_assoc, Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, ← mulVec_mulVec, hg₁e0,
      mulVec_smul, hs₂e0]
  · rw [mul_assoc, Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, ← mulVec_mulVec, hs₂y₁]

private theorem siegelClosure_one_eq_top (hσ : Function.Involutive σ)
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s)
    (hadm : ∃ d ≠ (0 : K), d + σ d = 0) :
    siegelClosure σ 1 = ⊤ := by
  refine top_unique fun g _ ↦ ?_
  obtain ⟨h, hh, c, hc0, hg₂e0, hg₂er⟩ :=
    exists_mem_siegelClosure_mul_mulVec_single_zero_and_last hσ htr hadm g
  let g₂ := h * g
  have hσc0 : σ c ≠ 0 := (map_ne_zero σ).mpr hc0
  have hg₂_mat : ((g₂ : Matrix.SpecialLinearGroup (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) =
      diagonal ![c, (σ c)⁻¹] := by
    ext i j; fin_cases j
    · have := congrFun hg₂e0 i; fin_cases i <;> simpa [g₂, mulVec, dotProduct] using this
    · have := congrFun hg₂er i; fin_cases i <;> simpa [g₂, mulVec, dotProduct] using this
  have hdet1 : c * (σ c)⁻¹ = 1 := by
    have hd := (g₂ : Matrix.SpecialLinearGroup (Fin 2) K).2
    rwa [hg₂_mat, det_diagonal, Fin.prod_univ_two] at hd
  have hσc : σ c = c := ((mul_inv_eq_one₀ hσc0).mp hdet1).symm
  have h0r : (0 : Fin 2) ≠ Fin.last 1 := by decide
  obtain ⟨hmem, hdiagW⟩ := diag2n_zero_last_mem_iSup_unitaryTransvectionSubgroup hσ h0r hadm hc0
    hσc
  have hg₂_eq : g₂ = ⟨Matrix.SpecialLinearGroup.diag2n h0r c hc0, hmem⟩ := by
    refine Subtype.ext (Subtype.ext ?_)
    rw [hg₂_mat, Matrix.SpecialLinearGroup.diag2n_coe]
    ext i j; fin_cases i <;> fin_cases j <;> simp [hσc]
  have hg₂S : g₂ ∈ siegelClosure σ 1 :=
    iSup_unitaryTransvectionSubgroup_le_siegelClosure hσ 1 (hg₂_eq ▸ hdiagW)
  rw [show g = h⁻¹ * g₂ by simp [g₂]]
  exact mul_mem (inv_mem hh) hg₂S

private theorem siegelClosure_eq_top (hσ : Function.Involutive σ)
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s)
    (hadm : ∃ d ≠ (0 : K), d + σ d = 0) {r : ℕ}
    (hnorm : Even r → r ≠ 0 → ∀ s : K, σ s = s → ∃ b : K, σ b * b = s) :
    siegelClosure σ r = ⊤ := by
  induction r using Nat.strongRecOn with | ind r ih => ?_
  rcases r with _ | _ | r₂
  · refine top_unique fun g _ ↦ ?_
    obtain rfl : g = 1 :=
      Subtype.ext (Subsingleton.elim (α := Matrix.SpecialLinearGroup (Fin 1) K) _ _)
    exact one_mem _
  · exact siegelClosure_one_eq_top hσ htr hadm
  · refine top_unique fun g _ ↦ ?_
    obtain ⟨h, hh, c, hc0, hg₂e0, hg₂er⟩ :=
      exists_mem_siegelClosure_mul_mulVec_single_zero_and_last hσ htr hadm g
    have hσc0 : σ c ≠ 0 := (map_ne_zero σ).mpr hc0
    obtain ⟨h₃, hh₃, hh₃e0, hh₃er⟩ := exists_mem_siegelClosure_mulVec_single_zero_and_last hσ
      (by omega : 2 ≤ r₂ + 2) (fun hr2 ↦ hnorm (hr2 ▸ even_two) (by omega)) hσc0
    let g₃ := h₃ * (h * g)
    have hg₃e0 : ((g₃ : Matrix.SpecialLinearGroup (Fin (r₂ + 3)) K) :
        Matrix (Fin (r₂ + 3)) (Fin (r₂ + 3)) K) *ᵥ Pi.single 0 1 = Pi.single 0 1 := by
      rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, ← mulVec_mulVec, hg₂e0, mulVec_smul,
        hh₃e0, hσ c, smul_inv_smul₀ hc0]
    have hg₃er : ((g₃ : Matrix.SpecialLinearGroup (Fin (r₂ + 3)) K) :
        Matrix (Fin (r₂ + 3)) (Fin (r₂ + 3)) K) *ᵥ Pi.single (Fin.last (r₂ + 2)) 1 =
        Pi.single (Fin.last (r₂ + 2)) 1 := by
      rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, ← mulVec_mulVec, hg₂er, mulVec_smul,
        hh₃er, inv_smul_smul₀ hσc0]
    obtain ⟨g', hg'⟩ := mem_range_borderHom_of_mulVec_single_eq (r' := r₂) hg₃e0 hg₃er
    have hg'S : g' ∈ siegelClosure σ r₂ := by
      rw [ih r₂ (by omega) (fun hev _ ↦ hnorm (by simpa [Nat.even_add] using hev) (by omega))]
      exact Subgroup.mem_top g'
    have hg₃S : g₃ ∈ siegelClosure σ (r₂ + 2) := hg' ▸ siegelClosure_le_comap_borderHom r₂ hg'S
    rw [show g = (h₃ * h)⁻¹ * g₃ by simp [g₃, mul_assoc]]
    exact mul_mem (inv_mem (mul_mem hh₃ hh)) hg₃S

/-- **The standard special unitary group is generated by its admissible Siegel transformations.**
Let `σ` be an involution of a field `K` such that `t ↦ t + σ(t)` is onto `{s | σ(s) = s}`,
`d + σ(d) = 0` has a nonzero solution, and, when `r` is positive and even, `b ↦ σ(b) * b` is onto
`{s | σ(s) = s}`. Then any subgroup of `(typeAGraphConjugator r K).specialIsometryGroup σ`
containing all admissible Siegel transformations `S(u, w, c)` with `u ≠ 0` is `⊤`. -/
theorem specialIsometryGroup_typeAGraphConjugator_eq_top_of_siegelTransvection_mem
    (hσ : Function.Involutive σ) (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s)
    (hadm : ∃ d ≠ (0 : K), d + σ d = 0) {r : ℕ}
    (hnorm : Even r → r ≠ 0 → ∀ s : K, σ s = s → ∃ b : K, σ b * b = s)
    (H : Subgroup ((typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ))
    (hS : ∀ (g : (typeAGraphConjugator r K :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K).specialIsometryGroup σ)
        (u w : Fin (r + 1) → K) (c : K),
      u ≠ 0 →
      (σ ∘ u) ⬝ᵥ ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ u) = 0 →
      (σ ∘ u) ⬝ᵥ ((typeAGraphConjugator r K : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w) = 0 →
      c + (-1 : K) ^ r * σ c + (-1 : K) ^ r *
        ((σ ∘ w) ⬝ᵥ ((typeAGraphConjugator r K :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w)) = 0 →
      ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (typeAGraphConjugator r K :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K).siegelTransvection σ ((-1 : K) ^ r) u w c →
      g ∈ H) :
    H = ⊤ := by
  refine top_unique <| siegelClosure_eq_top hσ htr hadm hnorm ▸
    (Subgroup.closure_le H).mpr fun g ⟨u, w, c, hu, huw, hc, hg⟩ ↦ ?_
  by_cases hu0 : u = 0
  · subst hu0
    have hg1 : g = 1 := Subtype.ext (Subtype.ext (by simpa using hg))
    exact hg1 ▸ one_mem H
  · exact hS g u w c hu0 hu huw hc hg

end Field

