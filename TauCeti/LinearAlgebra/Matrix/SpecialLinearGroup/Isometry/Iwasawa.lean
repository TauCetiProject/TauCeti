module

public import TauCeti.GroupTheory.GroupAction.Iwasawa
public import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Isometry.Primitive

/-!
# The Iwasawa structure and simplicity criterion for projective special unitary groups

Let `σ` be an involution of a field `K`, and let `Q` be an invertible `ε`-Hermitian Gram matrix.
Conjugation by `g ∈ Q.specialIsometryGroup σ` carries `Q.unitaryTransvectionSubgroup σ p` to
`Q.unitaryTransvectionSubgroup σ (g • p)`, so the abelian transvection subgroups define
`Matrix.unitaryIwasawaStructure` whenever `Q.elementaryUnitaryGroup σ = ⊤`. If `Q` admits at least
one isotropic point (`Nonempty (Q.isotropicPoints σ)`), the trace `t ↦ t + ε σ(t)` is onto the
elements `s` with `σ(s) = ε s` and has a nonzero kernel element, and `Q.specialIsometryGroup σ` is
perfect and generated by its unitary transvections, then Iwasawa's theorem shows that
`Q.specialIsometryGroup σ ⧸ Subgroup.center _` is simple.

## Main definitions and results

* `Matrix.unitaryIwasawaStructure`: the `MulAction.IwasawaStructure` on `Q.isotropicPoints σ` when
  `Q.elementaryUnitaryGroup σ = ⊤`.
* `Matrix.isSimpleGroup_quotient_center_specialIsometryGroup`: Iwasawa's simplicity criterion for
  the projective special unitary group.

## References

* K. Iwasawa, *Über die Einfachheit der speziellen projektiven Gruppen*, Proc. Imp. Acad. Tokyo
  **17** (1941), 57--59.
* D. E. Taylor, *The Geometry of the Classical Groups* (1992), Chapters 10 and 11.
-/

public section

namespace Matrix

variable {n K : Type*} [Fintype n] [DecidableEq n] [Field K]

section General

variable (Q : Matrix n n K) (σ : K →+* K)

/-- **The Iwasawa structure of a special unitary group on its isotropic points**, when the
elementary unitary group equals the full special isometry group. -/
def unitaryIwasawaStructure (hgen : Q.elementaryUnitaryGroup σ = ⊤) :
    MulAction.IwasawaStructure (Q.specialIsometryGroup σ) (Q.isotropicPoints σ) where
  T := Q.unitaryTransvectionSubgroup σ
  is_comm _ := inferInstance
  is_conj := Q.unitaryTransvectionSubgroup_smul
  is_generator := elementaryUnitaryGroup_eq_iSup.symm.trans hgen

/-- The transvection subgroups of `unitaryIwasawaStructure` are the unitary transvection subgroups
`Q.unitaryTransvectionSubgroup σ p`. -/
@[simp]
theorem unitaryIwasawaStructure_T (hgen : Q.elementaryUnitaryGroup σ = ⊤)
    (p : Q.isotropicPoints σ) :
    (Q.unitaryIwasawaStructure σ hgen).T p = Q.unitaryTransvectionSubgroup σ p :=
  (rfl)

end General

section Hermitian

variable {Q : Matrix n n K} {σ : K →+* K} {ε : K}

/-- **Iwasawa's theorem for a projective special unitary group.** Let `σ` be an involution, let `Q`
be an invertible `ε`-Hermitian matrix admitting an isotropic point, and suppose that the trace
`t ↦ t + ε σ(t)` is onto the elements `s` with `σ(s) = ε s` and has a nonzero kernel element. If
the elementary unitary group equals `⊤` and `Q.specialIsometryGroup σ` is perfect, then
`Q.specialIsometryGroup σ ⧸ Subgroup.center (Q.specialIsometryGroup σ)` is simple. -/
theorem isSimpleGroup_quotient_center_specialIsometryGroup (hσ : Function.Involutive σ)
    (hQ : (Q.map σ)ᵀ = ε • Q) (hdet : Q.det ≠ 0)
    (htr : ∀ s, σ s = ε * s → ∃ t, t + ε * σ t = s) (hadm : ∃ d ≠ 0, d + ε * σ d = 0)
    [Nonempty (Q.isotropicPoints σ)]
    (hgen : Q.elementaryUnitaryGroup σ = ⊤)
    (hperf : commutator (Q.specialIsometryGroup σ) = ⊤) :
    IsSimpleGroup (Q.specialIsometryGroup σ ⧸ Subgroup.center (Q.specialIsometryGroup σ)) := by
  have : Group.IsPerfect (Q.specialIsometryGroup σ) := ⟨hperf⟩
  have := nontrivial_specialIsometryGroup hσ hQ hdet hadm
  have := isPreprimitive_isotropicPoints hσ hQ hdet htr hadm
  exact (Q.unitaryIwasawaStructure σ hgen).isSimpleGroup_quotient_center fun g hg ↦
    mem_center_specialIsometryGroup_of_forall_smul_eq hσ hQ hdet htr hadm hg

end Hermitian

end Matrix
