import TauCeti.LinearAlgebra.Matrix.SesquilinearForm

/-!
# The Iwasawa structure and simplicity criterion for projective special unitary groups

Let `σ` be an involution of a field `K`, and let `Q` be an invertible `ε`-Hermitian Gram matrix
(`(Q ^ σ)ᵀ = ε • Q`). To each isotropic point `p` of projective space,
`Matrix.unitaryTransvectionSubgroup Q σ p` attaches the abelian subgroup of unitary transvections
along `p`, and conjugation by an element `g` of `Matrix.specialIsometryGroup Q σ` carries the
subgroup at `p` to that at `g • p` (`Matrix.unitaryTransvectionSubgroup_smul`).

Consequently, the subgroup `⨆ p, Q.unitaryTransvectionSubgroup σ p` generated by all unitary
transvections is normal in `Q.specialIsometryGroup σ`. Whenever it is the whole special isometry
group, the family `Matrix.unitaryTransvectionSubgroup Q σ` forms an Iwasawa structure
(`Matrix.unitaryIwasawaStructure`) for the action on `Q.isotropicPoints σ`. Under the two trace
hypotheses of `Matrix.isPreprimitive_isotropicPoints` (`t ↦ t + ε σ(t)` is onto `{s | σ(s) = ε s}`
and has a nonzero kernel element), this action is primitive and its kernel is central when an
isotropic point exists, while the nonzero kernel element gives a nontrivial unitary transvection.
Iwasawa's central-quotient theorem `MulAction.IwasawaStructure.isSimpleGroup_quotient_center` then
implies that `Q.specialIsometryGroup σ` modulo its centre is simple as soon as
`Q.specialIsometryGroup σ` is generated by its unitary transvections and is perfect.

## Main definitions

* `Matrix.unitaryIwasawaStructure`: the `MulAction.IwasawaStructure` on `Q.isotropicPoints σ` built
  from `Q.unitaryTransvectionSubgroup σ` when unitary transvections generate
  `Q.specialIsometryGroup σ`.

## Main results

* `Matrix.normal_iSup_unitaryTransvectionSubgroup`: the subgroup generated by all unitary
  transvections is normal in `Q.specialIsometryGroup σ`.
* `Matrix.iSup_unitaryTransvectionSubgroup_le_of_normal`: on a transitive isotropic-point action, a
  normal subgroup containing the transvections at one isotropic point contains all unitary
  transvections.
* `Matrix.mem_iSup_unitaryTransvectionSubgroup_of_coe_eq` and
  `Matrix.exists_mem_iSup_unitaryTransvectionSubgroup_coe_eq`: every special isometry realized as a
  unitary transvection along an isotropic vector (including `0`) lies in
  `⨆ p, Q.unitaryTransvectionSubgroup σ p`.
* `Matrix.exists_mem_iSup_unitaryTransvectionSubgroup_mulVec_eq_smul`: under the two trace
  hypotheses, `⨆ p, Q.unitaryTransvectionSubgroup σ p` moves any nonzero isotropic vector to a
  nonzero multiple of any other.
* `Matrix.nontrivial_specialIsometryGroup`: when an isotropic point and a nonzero admissible
  transvection parameter exist for a nondegenerate `ε`-Hermitian `Q`, `Q.specialIsometryGroup σ` is
  nontrivial.
* `Matrix.isSimpleGroup_quotient_center_specialIsometryGroup`: Iwasawa's simplicity criterion for
  the projective special unitary group `Q.specialIsometryGroup σ ⧸ Subgroup.center _`.
* `Matrix.mem_center_specialIsometryGroup_iff_forall_smul_eq`: when `Q.specialIsometryGroup σ` is
  additionally perfect and generated by unitary transvections, its centre is the exact kernel of the
  action on isotropic points.

## References

* K. Iwasawa, *Über die Einfachheit der speziellen projektiven Gruppen*, Proc. Imp. Acad. Tokyo
  **17** (1941), 57--59.
* D. E. Taylor, *The Geometry of the Classical Groups* (1992), Chapters 10 and 11.
-/

public section

open scoped LinearAlgebra.Projectivization Pointwise

namespace Matrix

variable {n K : Type*} [Fintype n] [DecidableEq n] [Field K]

section General

variable (Q : Matrix n n K) (σ : K →+* K)

/-- **The subgroup generated by all unitary transvections is normal** in the special isometry group,
because conjugation permutes the point transvection subgroups along the action. -/
instance normal_iSup_unitaryTransvectionSubgroup :
    (⨆ p : Q.isotropicPoints σ, Q.unitaryTransvectionSubgroup σ p).Normal := by
  refine ⟨fun x hx g ↦ ?_⟩
  have hle : ⨆ p : Q.isotropicPoints σ, Q.unitaryTransvectionSubgroup σ p ≤
      (⨆ p : Q.isotropicPoints σ, Q.unitaryTransvectionSubgroup σ p).comap
        (MulAut.conj g : Q.specialIsometryGroup σ →* Q.specialIsometryGroup σ) := by
    refine iSup_le fun p y hy ↦ Subgroup.mem_iSup_of_mem (g • p) ?_
    rw [Q.unitaryTransvectionSubgroup_smul, Subgroup.mem_smul_pointwise_iff_exists]
    exact ⟨y, hy, rfl⟩
  exact hle hx

variable {Q σ}

/-- Any special isometry whose matrix is a unitary transvection along an isotropic vector (possibly
`0`) belongs to `⨆ p, Q.unitaryTransvectionSubgroup σ p`. -/
theorem mem_iSup_unitaryTransvectionSubgroup_of_coe_eq {g : Q.specialIsometryGroup σ}
    {v : n → K} (hv : (σ ∘ v) ⬝ᵥ (Q *ᵥ v) = 0) {a : K}
    (hg : ((g : SpecialLinearGroup n K) : Matrix n n K) = Q.unitaryTransvection σ v a) :
    g ∈ ⨆ p : Q.isotropicPoints σ, Q.unitaryTransvectionSubgroup σ p := by
  by_cases hv0 : v = 0
  · subst hv0
    have hg1 : g = 1 := Subtype.ext (Subtype.ext (by simp [hg, unitaryTransvection_def]))
    exact hg1 ▸ one_mem _
  · let p : Q.isotropicPoints σ := ⟨Projectivization.mk K v hv0,
      (mk_mem_isotropicPoints_iff hv0).mpr hv⟩
    exact Subgroup.mem_iSup_of_mem p ((mem_unitaryTransvectionSubgroup_mk_iff hv0 p.2).mpr ⟨a, hg⟩)

/-- On a transitive isotropic-point action, a normal subgroup containing the unitary transvection
group of one isotropic point contains the unitary transvection group of every isotropic point. -/
theorem iSup_unitaryTransvectionSubgroup_le_of_normal
    [MulAction.IsPretransitive (Q.specialIsometryGroup σ) (Q.isotropicPoints σ)]
    {N : Subgroup (Q.specialIsometryGroup σ)} [N.Normal] (p₀ : Q.isotropicPoints σ)
    (hp₀ : Q.unitaryTransvectionSubgroup σ p₀ ≤ N) :
    ⨆ p : Q.isotropicPoints σ, Q.unitaryTransvectionSubgroup σ p ≤ N := by
  refine iSup_le fun p ↦ ?_
  obtain ⟨g, rfl⟩ := MulAction.exists_smul_eq (Q.specialIsometryGroup σ) p₀ p
  rw [Q.unitaryTransvectionSubgroup_smul]
  intro x hx
  rw [Subgroup.mem_smul_pointwise_iff_exists] at hx
  obtain ⟨y, hy, rfl⟩ := hx
  exact ‹N.Normal›.conj_mem y (hp₀ hy) g

variable (Q σ) in
/-- **The Iwasawa structure of a special unitary group on its isotropic points**, given that its
unitary transvection subgroups generate the group. -/
def unitaryIwasawaStructure
    (hgen : ⨆ p : Q.isotropicPoints σ, Q.unitaryTransvectionSubgroup σ p = ⊤) :
    MulAction.IwasawaStructure (Q.specialIsometryGroup σ) (Q.isotropicPoints σ) where
  T := Q.unitaryTransvectionSubgroup σ
  is_comm _ := inferInstance
  is_conj := Q.unitaryTransvectionSubgroup_smul
  is_generator := hgen

@[simp]
theorem unitaryIwasawaStructure_T
    (hgen : ⨆ p : Q.isotropicPoints σ, Q.unitaryTransvectionSubgroup σ p = ⊤)
    (p : Q.isotropicPoints σ) :
    (Q.unitaryIwasawaStructure σ hgen).T p = Q.unitaryTransvectionSubgroup σ p :=
  (rfl)

end General

section Hermitian

variable {Q : Matrix n n K} {σ : K →+* K} {ε : K}

/-- Every admissible unitary transvection `τ_{v, a}` along an isotropic vector `v` (possibly `0`)
defines an element of `⨆ p, Q.unitaryTransvectionSubgroup σ p`. -/
theorem exists_mem_iSup_unitaryTransvectionSubgroup_coe_eq (hσ : Function.Involutive σ)
    (hQ : (Q.map σ)ᵀ = ε • Q) {v : n → K} (hv : (σ ∘ v) ⬝ᵥ (Q *ᵥ v) = 0) {a : K}
    (ha : a + ε * σ a = 0) :
    ∃ g ∈ ⨆ p : Q.isotropicPoints σ, Q.unitaryTransvectionSubgroup σ p,
      ((g : SpecialLinearGroup n K) : Matrix n n K) = Q.unitaryTransvection σ v a := by
  obtain ⟨g, hg, hga⟩ := exists_mem_specialIsometryGroup_coe_eq_unitaryTransvection hσ hQ hv ha
  exact ⟨⟨g, hg⟩, mem_iSup_unitaryTransvectionSubgroup_of_coe_eq hv hga, hga⟩

/-- Single-transvection step for `exists_mem_iSup_unitaryTransvectionSubgroup_mulVec_eq_smul` when
`h(y, x) ≠ 0`. -/
private theorem exists_mem_iSup_unitaryTransvectionSubgroup_mulVec_eq_smul_of_ne_zero
    (hσ : Function.Involutive σ) (hQ : (Q.map σ)ᵀ = ε • Q) (hadm : ∃ d ≠ 0, d + ε * σ d = 0)
    {x y : n → K} (hx : (σ ∘ x) ⬝ᵥ (Q *ᵥ x) = 0) (hy : (σ ∘ y) ⬝ᵥ (Q *ᵥ y) = 0)
    (hyx : (σ ∘ y) ⬝ᵥ (Q *ᵥ x) ≠ 0) :
    ∃ g ∈ ⨆ p : Q.isotropicPoints σ, Q.unitaryTransvectionSubgroup σ p,
      ∃ c ≠ (0 : K), ((g : SpecialLinearGroup n K) : Matrix n n K) *ᵥ x = c • y := by
  obtain ⟨d, hd0, hd⟩ := hadm
  set b := (σ ∘ y) ⬝ᵥ (Q *ᵥ x) with hb
  have hσb : σ b ≠ 0 := (map_ne_zero σ).mpr hyx
  have hσb_eq : σ b = ε * ((σ ∘ x) ⬝ᵥ (Q *ᵥ y)) := apply_comp_dotProduct_mulVec hσ hQ y x
  have hε0 : ε ≠ 0 := left_ne_zero_of_mul (hσb_eq ▸ hσb)
  set c := d * (σ b)⁻¹
  have hc0 : c ≠ 0 := mul_ne_zero hd0 (inv_ne_zero hσb)
  have hcyx : (σ ∘ (c • y)) ⬝ᵥ (Q *ᵥ x) = σ d := by
    rw [TauCeti.map_comp_smul, smul_dotProduct, smul_eq_mul, ← hb]
    simp [c, hσ b, hyx]
  have hcy : (σ ∘ (c • y)) ⬝ᵥ (Q *ᵥ (c • y)) = 0 := by
    rw [TauCeti.map_comp_smul, smul_dotProduct, mulVec_smul, dotProduct_smul, hy, smul_zero,
      smul_zero]
  have hxcy : (σ ∘ x) ⬝ᵥ (Q *ᵥ (c • y)) + (σ ∘ (c • y)) ⬝ᵥ (Q *ᵥ x) = 0 := by
    refine mul_left_cancel₀ hε0 ?_
    have h1 : c * (ε * ((σ ∘ x) ⬝ᵥ (Q *ᵥ y))) = d := by rw [← hσb_eq]; simp [c, hσb]
    rw [hcyx, mulVec_smul, dotProduct_smul, smul_eq_mul]
    linear_combination h1 + hd
  have hw : (σ ∘ (c • y - x)) ⬝ᵥ (Q *ᵥ (c • y - x)) = 0 := by
    simp only [map_comp_sub, sub_dotProduct, mulVec_sub, dotProduct_sub, hx, hcy]
    linear_combination -hxcy
  obtain ⟨g, hg, hga, hgx⟩ :=
    exists_mem_specialIsometryGroup_coe_eq_unitaryTransvection_sub_and_mulVec_eq
      hσ hQ hx hcy (hcyx ▸ (map_ne_zero σ).mpr hd0) hxcy
  exact ⟨⟨g, hg⟩, mem_iSup_unitaryTransvectionSubgroup_of_coe_eq hw hga, c, hc0, hgx⟩

/-- **Unitary transvections act transitively on isotropic lines.** Under the two trace hypotheses of
`Matrix.isPretransitive_isotropicPoints`, for any two nonzero isotropic vectors `x` and `y`, some
product of unitary transvections sends `x` to a nonzero scalar multiple of `y`. -/
theorem exists_mem_iSup_unitaryTransvectionSubgroup_mulVec_eq_smul
    (hσ : Function.Involutive σ) (hQ : (Q.map σ)ᵀ = ε • Q) (hdet : Q.det ≠ 0)
    (htr : ∀ s, σ s = ε * s → ∃ t, t + ε * σ t = s) (hadm : ∃ d ≠ 0, d + ε * σ d = 0)
    {x y : n → K} (hx0 : x ≠ 0) (hy0 : y ≠ 0)
    (hx : (σ ∘ x) ⬝ᵥ (Q *ᵥ x) = 0) (hy : (σ ∘ y) ⬝ᵥ (Q *ᵥ y) = 0) :
    ∃ g ∈ ⨆ p : Q.isotropicPoints σ, Q.unitaryTransvectionSubgroup σ p,
      ∃ c ≠ (0 : K), ((g : SpecialLinearGroup n K) : Matrix n n K) *ᵥ x = c • y := by
  by_cases hyx : (σ ∘ y) ⬝ᵥ (Q *ᵥ x) = 0
  swap
  · exact exists_mem_iSup_unitaryTransvectionSubgroup_mulVec_eq_smul_of_ne_zero hσ hQ hadm hx hy hyx
  obtain ⟨v, -, hvx, hvy⟩ := exists_comp_dotProduct_mulVec_eq_zero_and_ne_zero_pair
    (u := 0) (x := x) (y := y) hσ.surjective hdet (by simp [hx0]) (by simp [hy0])
  obtain ⟨a, hz⟩ := exists_comp_add_smul_dotProduct_mulVec_add_smul_eq_zero hσ hQ htr hx hvx
  set z := v + a • x
  have hxy : (σ ∘ x) ⬝ᵥ (Q *ᵥ y) = 0 := (comp_dotProduct_mulVec_eq_zero_comm hσ hQ).mp hyx
  have hzx : (σ ∘ z) ⬝ᵥ (Q *ᵥ x) ≠ 0 := by simpa [z, hx] using hvx
  have hyz : (σ ∘ y) ⬝ᵥ (Q *ᵥ z) ≠ 0 := by
    rw [comp_dotProduct_mulVec_ne_zero_comm hσ hQ]
    simpa [z, hxy] using hvy
  obtain ⟨g₁, hg₁, c₁, hc₁, hg₁x⟩ :=
    exists_mem_iSup_unitaryTransvectionSubgroup_mulVec_eq_smul_of_ne_zero hσ hQ hadm hx hz hzx
  obtain ⟨g₂, hg₂, c₂, hc₂, hg₂z⟩ :=
    exists_mem_iSup_unitaryTransvectionSubgroup_mulVec_eq_smul_of_ne_zero hσ hQ hadm hz hy hyz
  refine ⟨g₂ * g₁, mul_mem hg₂ hg₁, c₁ * c₂, mul_ne_zero hc₁ hc₂, ?_⟩
  rw [Subgroup.coe_mul, SpecialLinearGroup.coe_mul, ← mulVec_mulVec, hg₁x, mulVec_smul, hg₂z,
    smul_smul]

/-- **Nontriviality of a special unitary group with an isotropic point.** If `σ` is an involution,
`Q` is an invertible `ε`-Hermitian matrix, `d + ε σ(d) = 0` has a nonzero solution, and an isotropic
point exists, then `Q.specialIsometryGroup σ` is nontrivial, witnessed by a unitary transvection. -/
theorem nontrivial_specialIsometryGroup (hσ : Function.Involutive σ) (hQ : (Q.map σ)ᵀ = ε • Q)
    (hdet : Q.det ≠ 0) (hadm : ∃ d ≠ 0, d + ε * σ d = 0) [Nonempty (Q.isotropicPoints σ)] :
    Nontrivial (Q.specialIsometryGroup σ) := by
  obtain ⟨p₀⟩ := ‹Nonempty (Q.isotropicPoints σ)›
  obtain ⟨d, hd0, hd⟩ := hadm
  set v := (p₀ : ℙ K (n → K)).rep
  obtain ⟨g, hg, hga⟩ := exists_mem_specialIsometryGroup_coe_eq_unitaryTransvection hσ hQ
    (comp_rep_dotProduct_mulVec_rep p₀) hd
  refine ⟨⟨⟨g, hg⟩, 1, fun h ↦ ?_⟩⟩
  have hmat : Q.unitaryTransvection σ v d = 1 := by
    rw [← hga]
    exact congrArg (fun x : Q.specialIsometryGroup σ ↦ ((x : SpecialLinearGroup n K) :
      Matrix n n K)) h
  rw [unitaryTransvection_def, add_eq_left, smul_eq_zero, vecMulVec_eq_zero] at hmat
  have hσv : σ ∘ v ≠ 0 := fun h0 ↦ (p₀ : ℙ K (n → K)).rep_ne_zero <| funext fun i ↦
    (map_eq_zero σ).mp (congrFun h0 i)
  have hvQ : (σ ∘ v) ᵥ* Q ≠ 0 := fun h0 ↦
    hdet (exists_vecMul_eq_zero_iff.mp ⟨σ ∘ v, hσv, h0⟩)
  exact (hmat.resolve_left hd0).elim (p₀ : ℙ K (n → K)).rep_ne_zero hvQ

/-- **Iwasawa's theorem for a projective special unitary group.** Let `σ` be an involution, let `Q`
be an invertible `ε`-Hermitian matrix with at least one isotropic point, and suppose that
`t ↦ t + ε σ(t)` is onto `{s | σ(s) = ε s}` and has a nonzero kernel element. If
`Q.specialIsometryGroup σ` is generated by its unitary transvections and is perfect, then its
central quotient is simple. -/
theorem isSimpleGroup_quotient_center_specialIsometryGroup (hσ : Function.Involutive σ)
    (hQ : (Q.map σ)ᵀ = ε • Q) (hdet : Q.det ≠ 0)
    (htr : ∀ s, σ s = ε * s → ∃ t, t + ε * σ t = s) (hadm : ∃ d ≠ 0, d + ε * σ d = 0)
    [Nonempty (Q.isotropicPoints σ)]
    (hgen : ⨆ p : Q.isotropicPoints σ, Q.unitaryTransvectionSubgroup σ p = ⊤)
    (hperf : commutator (Q.specialIsometryGroup σ) = ⊤) :
    IsSimpleGroup (Q.specialIsometryGroup σ ⧸ Subgroup.center (Q.specialIsometryGroup σ)) := by
  have : Group.IsPerfect (Q.specialIsometryGroup σ) := ⟨hperf⟩
  have := nontrivial_specialIsometryGroup hσ hQ hdet hadm
  have := isPreprimitive_isotropicPoints hσ hQ hdet htr hadm
  exact (Q.unitaryIwasawaStructure σ hgen).isSimpleGroup_quotient_center fun g hg ↦
    mem_center_specialIsometryGroup_of_forall_smul_eq hσ hQ hdet htr hadm hg

/-- **The centre of a perfect special unitary group is the kernel of its isotropic-point
action.** -/
theorem mem_center_specialIsometryGroup_iff_forall_smul_eq (hσ : Function.Involutive σ)
    (hQ : (Q.map σ)ᵀ = ε • Q) (hdet : Q.det ≠ 0)
    (htr : ∀ s, σ s = ε * s → ∃ t, t + ε * σ t = s) (hadm : ∃ d ≠ 0, d + ε * σ d = 0)
    [Nonempty (Q.isotropicPoints σ)]
    (hgen : ⨆ p : Q.isotropicPoints σ, Q.unitaryTransvectionSubgroup σ p = ⊤)
    (hperf : commutator (Q.specialIsometryGroup σ) = ⊤) {g : Q.specialIsometryGroup σ} :
    g ∈ Subgroup.center (Q.specialIsometryGroup σ) ↔ ∀ p : Q.isotropicPoints σ, g • p = p := by
  have : Group.IsPerfect (Q.specialIsometryGroup σ) := ⟨hperf⟩
  have := isPreprimitive_isotropicPoints hσ hQ hdet htr hadm
  exact (Q.unitaryIwasawaStructure σ hgen).mem_center_iff fun k hk ↦
    mem_center_specialIsometryGroup_of_forall_smul_eq hσ hQ hdet htr hadm hk

end Hermitian

end Matrix
