import TauCeti.Algebra.Group.Hom.Defs
import TauCeti.LinearAlgebra.Matrix.SesquilinearForm

/-!
# Transvection generation of the standard special unitary groups

`TauCeti.specialIsometryGroup_typeAGraphConjugator_eq_top_of_siegelTransvection_mem` shows that the
special unitary group of the signed anti-diagonal Gram matrix `Q_r = typeAGraphConjugator r K` is
generated by its admissible Siegel transformations `S(u, w, c)`. This file expresses every
admissible Siegel transformation as a product of unitary transvections (`S(v, 0, a) = τ_{v,a}`),
showing that the transvection-generated normal subgroup
`⨆ p, Q_r.unitaryTransvectionSubgroup σ p` is all of `Q_r.specialIsometryGroup σ`, except possibly
at `r = 2` when the fixed subfield `{t : K | σ(t) = t}` is `𝔽₂` (reflecting the solvable group
`SU₃(2)`).

After conjugating an isotropic `u ≠ 0` onto the line `K ∙ e₀` by unitary transvections and shifting
`w` along `e₀` so that `w ∈ {e₀, e_r}^⊥`:

* for `r = 1`, `{e₀, e₁}^⊥ = 0`, so `S(e₀, 0, c) = τ_{e₀, c}`;
* when `{t : K | σ(t) = t}` contains `t ∉ {0, 1}` (in particular for `r = 2` once the fixed field
  has at least three elements), the corner torus element `diag2n 0 r t ∈ W` scales `e₀` by `t` and
  fixes `{e₀, e_r}^⊥`, so `[diag2n 0 r t, S(e₀, (t - 1)⁻¹ • w, c₀)] = S(e₀, w, c') ∈ W` by
  normality of `W`;
* for `3 ≤ r`, `{e₀, e_r}^⊥` contains a hyperbolic pair `(e₁, e_{r-1})`, so every `w ∈ {e₀, e_r}^⊥`
  is a sum of at most three isotropic vectors `z ∈ {e₀, e_r}^⊥`, and each `S(e₀, z, 0)` factors as
  the product of three unitary transvections `τ_{e₀ + d⁻¹ • z, d} * τ_{e₀, -d} * τ_{d⁻¹ • z, -d}`.

## Main results

* `TauCeti.iSup_unitaryTransvectionSubgroup_typeAGraphConjugator`: under the trace, skew-trace, and
  (for positive even `r`) norm hypotheses, together with `r ≠ 2 ∨ ∃ t, σ t = t ∧ t ≠ 0 ∧ t ≠ 1`,
  `⨆ p, (typeAGraphConjugator r K).unitaryTransvectionSubgroup σ p = ⊤`.

## References

* J. Dieudonné, *La géométrie des groupes classiques*, 3rd ed., Springer (1971), Chapter II, §5.
* D. E. Taylor, *The Geometry of the Classical Groups* (1992), §10.5 and §11.4.
-/

public section

open Matrix

namespace TauCeti

section Field

variable {K : Type*} [Field K] {σ : K →+* K}

private abbrev stdUnitMat (R : Type*) [Ring R] (r : ℕ) : Matrix (Fin (r + 1)) (Fin (r + 1)) R :=
  typeAGraphConjugator r R

/-- Any special isometry of `Q_r` (`0 < r`) of the form `S(e₀, w, c)` with `B(e₀, w) = 0` satisfies
the Siegel scalar equation `c + (-1) ^ r * σ(c) + (-1) ^ r * B(w, w) = 0`. -/
private theorem siegelTransvection_single_zero_scalar_eq_zero (hσ : Function.Involutive σ) {r : ℕ}
    (h0r : (0 : Fin (r + 1)) ≠ Fin.last r) {g : (stdUnitMat K r).specialIsometryGroup σ}
    {w : Fin (r + 1) → K} (he0w : (σ ∘ Pi.single (0 : Fin (r + 1)) 1) ⬝ᵥ (stdUnitMat K r *ᵥ w) = 0)
    {c : K}
    (hg : ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
      (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) w c) :
    c + (-1 : K) ^ r * σ c + (-1 : K) ^ r * ((σ ∘ w) ⬝ᵥ (stdUnitMat K r *ᵥ w)) = 0 := by
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  have hiso := mem_specialIsometryGroup_iff.mp g.2
  rw [hg, transpose_map_siegelTransvection_mul_mul hσ (transpose_map_typeAGraphConjugator σ r) he0
    he0w] at hiso
  have hentry := congrArg (fun M ↦ M (Fin.last r) (Fin.last r)) (add_eq_left.mp hiso)
  have hQe0 : (stdUnitMat K r *ᵥ Pi.single 0 1) (Fin.last r) = (-1 : K) ^ r := by
    rw [coe_typeAGraphConjugator_mulVec]; simp [Fin.rev_last]
  have he0Q : ((σ ∘ Pi.single (0 : Fin (r + 1)) 1) ᵥ* stdUnitMat K r) (Fin.last r) = 1 := by
    have hc : σ ∘ Pi.single (0 : Fin (r + 1)) (1 : K) = Pi.single 0 1 := funext fun j ↦ by
      by_cases hj : j = 0 <;> simp [hj]
    rw [hc, single_one_vecMul]; simp [typeAGraphConjugator_apply, Fin.rev_zero]
  simp only [Matrix.smul_apply, vecMulVec_apply, hQe0, he0Q, mul_one, smul_eq_mul] at hentry
  exact (mul_eq_zero.mp hentry).resolve_right (pow_ne_zero r (neg_ne_zero.mpr one_ne_zero))

/-- Adjusting the scalar parameter `c₁ ↦ c₂` of `S(e₀, w, c₁) ∈ W` by multiplying on the left with
the unitary transvection `τ_{e₀, c₂ - c₁} ∈ W`. -/
private theorem siegelTransvection_single_zero_mem_iSup_of_mem_iSup (hσ : Function.Involutive σ)
    {r : ℕ} (h0r : (0 : Fin (r + 1)) ≠ Fin.last r) {w : Fin (r + 1) → K}
    (he0w : (σ ∘ Pi.single (0 : Fin (r + 1)) 1) ⬝ᵥ (stdUnitMat K r *ᵥ w) = 0)
    {g₁ g₂ : (stdUnitMat K r).specialIsometryGroup σ}
    (hg₁W : g₁ ∈ ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p) {c₁ c₂ : K}
    (hg₁ : ((g₁ : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
      (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) w c₁)
    (hg₂ : ((g₂ : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
      (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) w c₂) :
    g₂ ∈ ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p := by
  have hc₁ := siegelTransvection_single_zero_scalar_eq_zero hσ h0r he0w hg₁
  have hc₂ := siegelTransvection_single_zero_scalar_eq_zero hσ h0r he0w hg₂
  have ha : (c₂ - c₁) + (-1 : K) ^ r * σ (c₂ - c₁) = 0 := by
    rw [map_sub]; linear_combination hc₂ - hc₁
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  obtain ⟨t, htW, hta⟩ := exists_mem_iSup_unitaryTransvectionSubgroup_coe_eq hσ
    (transpose_map_typeAGraphConjugator σ r) he0 ha
  have hprod : g₂ = t * g₁ := by
    refine Subtype.ext (Subtype.ext ?_)
    rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, hta, hg₁, hg₂,
      ← siegelTransvection_zero_eq_unitaryTransvection (ε := (-1 : K) ^ r),
      siegelTransvection_mul_siegelTransvection he0 he0w (by simp), zero_add]
    congr 1
    simp only [Function.comp_def, Pi.zero_apply, map_zero, ← Pi.zero_def, zero_dotProduct,
      mul_zero, sub_zero, sub_add_cancel]
  exact hprod ▸ mul_mem htW hg₁W

private theorem comp_single_zero_dotProduct_stdUnitMat_mulVec {r : ℕ} (v : Fin (r + 1) → K) :
    (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ v) = v (Fin.last r) := by
  have hc : σ ∘ Pi.single (0 : Fin (r + 1)) (1 : K) = Pi.single 0 1 := funext fun j ↦ by
    by_cases hj : j = 0 <;> simp [hj]
  rw [hc, single_one_dotProduct, coe_typeAGraphConjugator_mulVec]
  simp [Fin.rev_zero]

private theorem coe_inv_eq_siegelTransvection_neg (hσ : Function.Involutive σ) {r : ℕ}
    (h0r : (0 : Fin (r + 1)) ≠ Fin.last r) {g : (stdUnitMat K r).specialIsometryGroup σ}
    {w : Fin (r + 1) → K} (he0w : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ w) = 0) {c : K}
    (hg : ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
      (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) w c) :
    (((g⁻¹ : (stdUnitMat K r).specialIsometryGroup σ) :
        Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
      (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) (-w)
        (-c - (-1 : K) ^ r * ((σ ∘ w) ⬝ᵥ (stdUnitMat K r *ᵥ w))) := by
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  have hwe0 := (comp_dotProduct_mulVec_eq_zero_comm hσ
    (transpose_map_typeAGraphConjugator σ r)).mp he0w
  have h1 := siegelTransvection_mul_siegelTransvection_neg_eq_one (Q := stdUnitMat K r) (σ := σ)
    (ε := (-1 : K) ^ r) he0 he0w hwe0 c
  have h2 : ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) *
      (((g⁻¹ : (stdUnitMat K r).specialIsometryGroup σ) :
        Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) = 1 := by
    rw [Subgroup.coe_inv, ← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel,
      Matrix.SpecialLinearGroup.coe_one]
  rw [← hg] at h1
  exact (inv_eq_right_inv h2).symm.trans (inv_eq_right_inv h1)

private theorem diag2n_zero_last_mulVec_eq_self {r : ℕ} (h0r : (0 : Fin (r + 1)) ≠ Fin.last r)
    {t : K} (ht0 : t ≠ 0) {w : Fin (r + 1) → K} (hw0 : w 0 = 0) (hwl : w (Fin.last r) = 0) :
    (Matrix.SpecialLinearGroup.diag2n h0r t ht0 :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w = w := by
  ext i
  by_cases hi : i = 0
  · subst hi; simp [Matrix.SpecialLinearGroup.diag2n_coe, mulVec_diagonal, hw0]
  · by_cases hl : i = Fin.last r
    · subst hl; simp [Matrix.SpecialLinearGroup.diag2n_coe, mulVec_diagonal, hwl]
    · simp [Matrix.SpecialLinearGroup.diag2n_coe, mulVec_diagonal, hi, hl]

/-- When `{t : K | σ(t) = t}` contains `t ∉ {0, 1}`, every `w ∈ {e₀, e_r}^⊥` admits an admissible
Siegel transformation `S(e₀, w, c₁)` in `⨆ p, Q_r.unitaryTransvectionSubgroup σ p` via the
commutator `[diag2n 0 r t, S(e₀, (t - 1)⁻¹ • w, c₀)]`. -/
private theorem exists_siegelTransvection_single_zero_mem_iSup_of_exists_fixed
    (hσ : Function.Involutive σ) (htr : ∀ s : K, σ s = s → ∃ a : K, a + σ a = s)
    (hadm : ∃ d ≠ (0 : K), d + σ d = 0) {r : ℕ} (h0r : (0 : Fin (r + 1)) ≠ Fin.last r)
    {t : K} (ht : σ t = t) (ht0 : t ≠ 0) (ht1 : t ≠ 1) {w : Fin (r + 1) → K}
    (hw0 : w 0 = 0) (hwl : w (Fin.last r) = 0) :
    ∃ g₁ ∈ ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p,
      ∃ c₁ : K, ((g₁ : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) w c₁ := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  let w₀ : Fin (r + 1) → K := (t - 1)⁻¹ • w
  have he0w₀ : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ w₀) = 0 := by
    rw [comp_single_zero_dotProduct_stdUnitMat_mulVec]; simp [w₀, hwl]
  have hw₀e0 : (σ ∘ w₀) ⬝ᵥ (stdUnitMat K r *ᵥ Pi.single 0 1) = 0 :=
    (comp_dotProduct_mulVec_eq_zero_comm hσ hQ).mp he0w₀
  obtain ⟨c₀, hc₀⟩ := exists_add_neg_one_pow_mul_apply_eq htr r
    (s := -((-1 : K) ^ r * ((σ ∘ w₀) ⬝ᵥ (stdUnitMat K r *ᵥ w₀)))) (by
      rw [map_neg, map_mul, map_pow, map_neg, map_one, apply_comp_dotProduct_mulVec hσ hQ]
      rcases neg_one_pow_eq_or K r with hr | hr <;> simp [hr])
  obtain ⟨g₀SL, hg₀Q, hg₀coe⟩ := exists_mem_specialIsometryGroup_coe_eq_siegelTransvection hσ hQ
    he0 he0w₀ (c := c₀) (by linear_combination hc₀)
  let g₀ : (stdUnitMat K r).specialIsometryGroup σ := ⟨g₀SL, hg₀Q⟩
  obtain ⟨hDQ, hDW⟩ := diag2n_zero_last_mem_iSup_unitaryTransvectionSubgroup hσ h0r hadm ht0 ht
  let D : (stdUnitMat K r).specialIsometryGroup σ :=
    ⟨Matrix.SpecialLinearGroup.diag2n h0r t ht0, hDQ⟩
  let k : (stdUnitMat K r).specialIsometryGroup σ := D * g₀ * D⁻¹ * g₀⁻¹
  have hkW : k ∈ ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p := by
    rw [show k = D * (g₀ * D⁻¹ * g₀⁻¹) by simp [k, mul_assoc]]
    exact mul_mem hDW ((normal_iSup_unitaryTransvectionSubgroup (stdUnitMat K r) σ).conj_mem _
      (inv_mem hDW) g₀)
  have hDe0 : ((D : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ Pi.single 0 1 = t • Pi.single 0 1 := by
    ext i; by_cases hi : i = 0 <;> simp [D, Matrix.SpecialLinearGroup.diag2n_coe, hi]
  have hDw₀ : ((D : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w₀ = w₀ :=
    diag2n_zero_last_mulVec_eq_self h0r ht0 (by simp [w₀, hw0]) (by simp [w₀, hwl])
  refine ⟨k, hkW, ?_, by
    rw [show ((k : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (((D : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
            Matrix (Fin (r + 1)) (Fin (r + 1)) K) * (g₀SL : Matrix (Fin (r + 1)) (Fin (r + 1)) K) *
          ((D⁻¹ : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
            Matrix (Fin (r + 1)) (Fin (r + 1)) K)) *
        (((g₀⁻¹ : (stdUnitMat K r).specialIsometryGroup σ) :
            Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
            Matrix (Fin (r + 1)) (Fin (r + 1)) K) by simp [k, g₀, mul_assoc],
      coe_inv_eq_siegelTransvection_neg hσ h0r he0w₀ hg₀coe, hg₀coe,
      coe_mul_siegelTransvection_mul_coe_inv D.2, hDe0, hDw₀, siegelTransvection_smul_left hσ, ht,
      siegelTransvection_mul_siegelTransvection he0
        (by rw [mulVec_neg, dotProduct_neg, he0w₀, neg_zero])
        (by rw [TauCeti.map_comp_smul, smul_dotProduct, hw₀e0, smul_zero]),
      show t • w₀ + -w₀ = w by
        ext i
        simp only [w₀, Pi.add_apply, Pi.neg_apply, Pi.smul_apply, smul_eq_mul]
        rw [show t * ((t - 1)⁻¹ * w i) + -((t - 1)⁻¹ * w i) = (t - 1) * (t - 1)⁻¹ * w i by ring,
          mul_inv_cancel₀ (sub_ne_zero.mpr ht1), one_mul]]⟩

/-- For an isotropic vector `z` orthogonal to `e₀`, the Siegel transformation `S(e₀, z, 0)` is the
product of three unitary transvections `τ_{e₀ + d⁻¹ • z, d} * τ_{e₀, -d} * τ_{d⁻¹ • z, -d}` and
therefore belongs to `⨆ p, Q_r.unitaryTransvectionSubgroup σ p`. -/
private theorem siegelTransvection_single_zero_isotropic_mem_iSup (hσ : Function.Involutive σ)
    (hadm : ∃ d ≠ (0 : K), d + σ d = 0) {r : ℕ} (h0r : (0 : Fin (r + 1)) ≠ Fin.last r)
    {z : Fin (r + 1) → K} (hz : (σ ∘ z) ⬝ᵥ (stdUnitMat K r *ᵥ z) = 0)
    (he0z : (σ ∘ Pi.single (0 : Fin (r + 1)) 1) ⬝ᵥ (stdUnitMat K r *ᵥ z) = 0) :
    ∃ g ∈ ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p,
      ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) z 0 := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  obtain ⟨d, hd0, hd⟩ := exists_ne_zero_add_neg_one_pow_mul_apply_eq_zero hadm r
  have hnd : -d + (-1 : K) ^ r * σ (-d) = 0 := by rw [map_neg]; linear_combination -hd
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  have hze0 : (σ ∘ z) ⬝ᵥ (stdUnitMat K r *ᵥ Pi.single 0 1) = 0 :=
    (comp_dotProduct_mulVec_eq_zero_comm hσ hQ).mp he0z
  let y : Fin (r + 1) → K := d⁻¹ • z
  have hy : (σ ∘ y) ⬝ᵥ (stdUnitMat K r *ᵥ y) = 0 := by
    rw [TauCeti.map_comp_smul, smul_dotProduct, mulVec_smul, dotProduct_smul, hz, smul_zero,
      smul_zero]
  have he0y : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ y) = 0 := by
    rw [mulVec_smul, dotProduct_smul, he0z, smul_zero]
  have hye0 : (σ ∘ y) ⬝ᵥ (stdUnitMat K r *ᵥ Pi.single 0 1) = 0 := by
    rw [TauCeti.map_comp_smul, smul_dotProduct, hze0, smul_zero]
  have hsum : (σ ∘ (Pi.single 0 1 + y)) ⬝ᵥ (stdUnitMat K r *ᵥ (Pi.single 0 1 + y)) = 0 := by
    rw [comp_add_dotProduct_mulVec, mulVec_add, dotProduct_add, dotProduct_add, he0, hy, he0y,
      hye0, add_zero, add_zero]
  obtain ⟨t₁, ht₁W, ht₁⟩ := exists_mem_iSup_unitaryTransvectionSubgroup_coe_eq hσ hQ hsum hd
  obtain ⟨t₂, ht₂W, ht₂⟩ := exists_mem_iSup_unitaryTransvectionSubgroup_coe_eq hσ hQ he0 hnd
  obtain ⟨t₃, ht₃W, ht₃⟩ := exists_mem_iSup_unitaryTransvectionSubgroup_coe_eq hσ hQ hy hnd
  refine ⟨t₁ * t₂ * t₃, mul_mem (mul_mem ht₁W ht₂W) ht₃W, mulVec_injective (funext fun v ↦ ?_)⟩
  have hσd0 : σ d ≠ 0 := (map_ne_zero σ).mpr hd0
  have hdσd : d * (σ d)⁻¹ = -((-1 : K) ^ r) := by
    rw [← div_eq_mul_inv, div_eq_iff hσd0]
    linear_combination hd
  rw [Subgroup.coe_mul, Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul,
    Matrix.SpecialLinearGroup.coe_mul, ht₁, ht₂, ht₃, Matrix.mul_assoc, ← mulVec_mulVec,
    ← mulVec_mulVec]
  simp only [unitaryTransvection_mulVec, siegelTransvection_mulVec, mulVec_add, mulVec_smul,
    comp_add_dotProduct_mulVec, he0, hy, he0y, hye0, mul_zero, add_zero, zero_smul]
  simp only [y, TauCeti.map_comp_smul, map_inv₀, smul_dotProduct, smul_eq_mul, smul_add, smul_smul]
  dsimp only [stdUnitMat] at hdσd ⊢
  have hc1 (x : K) : d * x * d⁻¹ = x := by rw [mul_right_comm, mul_inv_cancel₀ hd0, one_mul]
  have hc2 (x : K) : -d * x * d⁻¹ = -x := by rw [neg_mul, neg_mul, hc1]
  have hc3 : d * ((σ d)⁻¹ * ((σ ∘ z) ⬝ᵥ ((typeAGraphConjugator r K : Matrix _ _ K) *ᵥ v))) =
      -((-1 : K) ^ r * ((σ ∘ z) ⬝ᵥ ((typeAGraphConjugator r K : Matrix _ _ K) *ᵥ v))) := by
    rw [← mul_assoc, hdσd, neg_mul]
  rw [hc1, hc2, mul_add, hc3]
  module

private theorem exists_siegelTransvection_single_zero_mem_iSup_of_pair_ne
    (hσ : Function.Involutive σ) (htr : ∀ s : K, σ s = s → ∃ a : K, a + σ a = s)
    (hadm : ∃ d ≠ (0 : K), d + σ d = 0) {r : ℕ} (h0r : (0 : Fin (r + 1)) ≠ Fin.last r)
    {x₀ : Fin (r + 1) → K} (hx₀ : (σ ∘ x₀) ⬝ᵥ (stdUnitMat K r *ᵥ x₀) = 0)
    (hx₀l : x₀ (Fin.last r) = 0) {v : Fin (r + 1) → K} (hvl : v (Fin.last r) = 0)
    (hv : (σ ∘ v) ⬝ᵥ (stdUnitMat K r *ᵥ x₀) ≠ 0) :
    ∃ g ∈ ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p,
      ∃ c : K, ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) v c := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  obtain ⟨a, hz₁⟩ := exists_comp_add_smul_dotProduct_mulVec_add_smul_eq_zero hσ hQ
    (fun _ ↦ exists_add_neg_one_pow_mul_apply_eq htr r) hx₀ hv
  have he0z₁ : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ (v + a • x₀)) = 0 := by
    rw [comp_single_zero_dotProduct_stdUnitMat_mulVec]; simp [hvl, hx₀l]
  have hz₂ : (σ ∘ ((-a) • x₀)) ⬝ᵥ (stdUnitMat K r *ᵥ ((-a) • x₀)) = 0 := by
    rw [TauCeti.map_comp_smul, smul_dotProduct, mulVec_smul, dotProduct_smul, hx₀, smul_zero,
      smul_zero]
  have he0z₂ : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ ((-a) • x₀)) = 0 := by
    rw [comp_single_zero_dotProduct_stdUnitMat_mulVec]; simp [hx₀l]
  obtain ⟨g₁, hg₁W, hg₁⟩ := siegelTransvection_single_zero_isotropic_mem_iSup hσ hadm h0r hz₁ he0z₁
  obtain ⟨g₂, hg₂W, hg₂⟩ := siegelTransvection_single_zero_isotropic_mem_iSup hσ hadm h0r hz₂ he0z₂
  refine ⟨g₁ * g₂, mul_mem hg₁W hg₂W, ?_, by
    rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, hg₁, hg₂,
      siegelTransvection_mul_siegelTransvection he0 he0z₂
        ((comp_dotProduct_mulVec_eq_zero_comm hσ hQ).mp he0z₁),
      show (v + a • x₀) + (-a) • x₀ = v by module]⟩

/-- When `3 ≤ r`, `{e₀, e_r}^⊥` contains the hyperbolic pair `(e₁, e_{r-1})`, so every vector
`w` with `w_r = 0` decomposes as a sum of at most three isotropic vectors orthogonal to `e₀`,
giving an element `S(e₀, w, c₁)` in `⨆ p, Q_r.unitaryTransvectionSubgroup σ p`. -/
private theorem exists_siegelTransvection_single_zero_mem_iSup_of_three_le
    (hσ : Function.Involutive σ) (htr : ∀ s : K, σ s = s → ∃ a : K, a + σ a = s)
    (hadm : ∃ d ≠ (0 : K), d + σ d = 0) {r : ℕ} (hr : 3 ≤ r) {w : Fin (r + 1) → K}
    (hwl : w (Fin.last r) = 0) :
    ∃ g₁ ∈ ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p,
      ∃ c₁ : K, ((g₁ : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) w c₁ := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have h0r : (0 : Fin (r + 1)) ≠ Fin.last r := by simp [Fin.ext_iff]; omega
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  let i₁ : Fin (r + 1) := ⟨1, by omega⟩
  let j₁ : Fin (r + 1) := i₁.rev
  let x₀ : Fin (r + 1) → K := Pi.single i₁ 1
  let y₀ : Fin (r + 1) → K := Pi.single j₁ 1
  have hi₁j₁ : i₁ ≠ j₁ := by simp [i₁, j₁, Fin.ext_iff, Fin.rev]; omega
  have hi₁l : i₁ ≠ Fin.last r := by simp [i₁, Fin.ext_iff]; omega
  have hj₁l : j₁ ≠ Fin.last r := by simp [j₁, i₁, Fin.ext_iff, Fin.rev]; omega
  have hx₀ : (σ ∘ x₀) ⬝ᵥ (stdUnitMat K r *ᵥ x₀) = 0 :=
    comp_single_dotProduct_typeAGraphConjugator_mulVec_single hi₁j₁
  have hx₀l : x₀ (Fin.last r) = 0 := by simp [x₀, hi₁l.symm]
  by_cases hwx : (σ ∘ w) ⬝ᵥ (stdUnitMat K r *ᵥ x₀) = 0
  swap
  · exact exists_siegelTransvection_single_zero_mem_iSup_of_pair_ne hσ htr hadm h0r hx₀ hx₀l hwl hwx
  have hyx : (σ ∘ y₀) ⬝ᵥ (stdUnitMat K r *ᵥ x₀) ≠ 0 := by
    have hc : σ ∘ y₀ = y₀ := funext fun m ↦ by by_cases hm : m = j₁ <;> simp [y₀, hm]
    rw [hc, show y₀ = Pi.single j₁ 1 from rfl, single_one_dotProduct,
      coe_typeAGraphConjugator_mulVec]
    simp [x₀, j₁]
  have hwjl : (w + y₀) (Fin.last r) = 0 := by simp [y₀, hwl, hj₁l.symm]
  obtain ⟨g₁, hg₁W, c₁, hg₁⟩ := exists_siegelTransvection_single_zero_mem_iSup_of_pair_ne hσ htr
    hadm h0r hx₀ hx₀l hwjl (by rwa [comp_add_dotProduct_mulVec, hwx, zero_add])
  have hy₀ : (σ ∘ y₀) ⬝ᵥ (stdUnitMat K r *ᵥ y₀) = 0 :=
    comp_single_dotProduct_typeAGraphConjugator_mulVec_single (by simpa [j₁] using hi₁j₁.symm)
  have hny₀ : (σ ∘ (-y₀)) ⬝ᵥ (stdUnitMat K r *ᵥ (-y₀)) = 0 := by
    rw [show σ ∘ (-y₀) = -(σ ∘ y₀) from funext fun _ ↦ map_neg σ _, neg_dotProduct, mulVec_neg,
      dotProduct_neg, hy₀, neg_zero, neg_zero]
  have he0ny₀ : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ (-y₀)) = 0 := by
    rw [comp_single_zero_dotProduct_stdUnitMat_mulVec]; simp [y₀, hj₁l.symm]
  have he0wy₀ : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ (w + y₀)) = 0 := by
    rw [comp_single_zero_dotProduct_stdUnitMat_mulVec, hwjl]
  obtain ⟨g₂, hg₂W, hg₂⟩ := siegelTransvection_single_zero_isotropic_mem_iSup hσ hadm h0r hny₀
    he0ny₀
  refine ⟨g₁ * g₂, mul_mem hg₁W hg₂W, ?_, by
    rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, hg₁, hg₂,
      siegelTransvection_mul_siegelTransvection he0 he0ny₀
        ((comp_dotProduct_mulVec_eq_zero_comm hσ hQ).mp he0wy₀),
      add_neg_cancel_right]⟩

/-- Conjugate any Siegel transformation `S(u, w, c)` with `u ≠ 0` by an element of
`Q_r.specialIsometryGroup σ` into `S(e₀, w₂, c₂)` with `w₂ ∈ {e₀, e_r}^⊥`. -/
private theorem exists_conj_coe_eq_siegelTransvection_single_zero (hσ : Function.Involutive σ)
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s) (hadm : ∃ d ≠ (0 : K), d + σ d = 0)
    {r : ℕ} (h0r : (0 : Fin (r + 1)) ≠ Fin.last r)
    {g : (stdUnitMat K r).specialIsometryGroup σ} {u w : Fin (r + 1) → K} {c : K}
    (hu0 : u ≠ 0) (hu : (σ ∘ u) ⬝ᵥ (stdUnitMat K r *ᵥ u) = 0)
    (huw : (σ ∘ u) ⬝ᵥ (stdUnitMat K r *ᵥ w) = 0)
    (hg : ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
      (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) u w c) :
    ∃ (h : (stdUnitMat K r).specialIsometryGroup σ) (w₂ : Fin (r + 1) → K) (c₂ : K),
      w₂ 0 = 0 ∧ w₂ (Fin.last r) = 0 ∧
      (((h * g * h⁻¹ : (stdUnitMat K r).specialIsometryGroup σ) :
          Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
          Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) w₂ c₂ := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  have he0_ne : (Pi.single 0 1 : Fin (r + 1) → K) ≠ 0 := Pi.single_ne_zero_iff.mpr one_ne_zero
  have hdet : (stdUnitMat K r).det ≠ 0 := (isUnits_det_units _).ne_zero
  obtain ⟨h, -, a, ha0, hhu⟩ := exists_mem_iSup_unitaryTransvectionSubgroup_mulVec_eq_smul hσ hQ
    hdet (fun _ ↦ exists_add_neg_one_pow_mul_apply_eq htr r)
    (exists_ne_zero_add_neg_one_pow_mul_apply_eq_zero hadm r) hu0 he0_ne hu he0
  let w₁ : Fin (r + 1) → K :=
    σ a • (((h : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w)
  let w₂ : Fin (r + 1) → K := w₁ + (-w₁ 0) • Pi.single 0 1
  have hw₁l : w₁ (Fin.last r) = 0 := by
    have hhw := comp_mulVec_dotProduct_mulVec_mulVec (mem_specialIsometryGroup_iff.mp h.2) u w
    rw [huw, hhu, TauCeti.map_comp_smul, smul_dotProduct, smul_eq_mul] at hhw
    have h1 := (mul_eq_zero.mp hhw).resolve_left ((map_ne_zero σ).mpr ha0)
    rw [← comp_single_zero_dotProduct_stdUnitMat_mulVec (σ := σ) w₁, mulVec_smul, dotProduct_smul,
      h1, smul_zero]
  refine ⟨h, w₂, c * a * σ a + w₁ 0 - (-1 : K) ^ r * σ (w₁ 0), by simp [w₂],
    by simp [w₂, hw₁l, h0r.symm], ?_⟩
  rw [Subgroup.coe_mul, Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul,
    Matrix.SpecialLinearGroup.coe_mul, Subgroup.coe_inv, hg, coe_mul_siegelTransvection_mul_coe_inv
    h.2, hhu, siegelTransvection_smul_left hσ,
    show σ a • (((h : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w) =
      w₂ + w₁ 0 • Pi.single 0 1 by simp [w₂, w₁],
    siegelTransvection_add_smul]

private theorem siegelTransvection_mem_iSup_of_ne_zero (hσ : Function.Involutive σ)
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s) (hadm : ∃ d ≠ (0 : K), d + σ d = 0)
    {r : ℕ} (hr0 : r ≠ 0) (hfield : r ≠ 2 ∨ ∃ t : K, σ t = t ∧ t ≠ 0 ∧ t ≠ 1)
    {g : (stdUnitMat K r).specialIsometryGroup σ} {u w : Fin (r + 1) → K} {c : K}
    (hu0 : u ≠ 0) (hu : (σ ∘ u) ⬝ᵥ (stdUnitMat K r *ᵥ u) = 0)
    (huw : (σ ∘ u) ⬝ᵥ (stdUnitMat K r *ᵥ w) = 0)
    (hg : ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
      (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) u w c) :
    g ∈ ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p := by
  have h0r : (0 : Fin (r + 1)) ≠ Fin.last r := by simp [Fin.ext_iff]; omega
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  obtain ⟨h, w₂, c₂, hw₂0, hw₂l, hg'coe⟩ :=
    exists_conj_coe_eq_siegelTransvection_single_zero hσ htr hadm h0r hu0 hu huw hg
  let g' : (stdUnitMat K r).specialIsometryGroup σ := h * g * h⁻¹
  suffices hg'W : g' ∈ ⨆ p, (stdUnitMat K r).unitaryTransvectionSubgroup σ p by
    simpa [g', mul_assoc] using
      (normal_iSup_unitaryTransvectionSubgroup (stdUnitMat K r) σ).conj_mem g' hg'W h⁻¹
  have he0w₂ : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ w₂) = 0 := by
    rw [comp_single_zero_dotProduct_stdUnitMat_mulVec, hw₂l]
  by_cases hr1 : r = 1
  · subst hr1
    have hw₂_eq : w₂ = 0 := funext fun i ↦ by fin_cases i; exacts [hw₂0, hw₂l]
    rw [hw₂_eq, siegelTransvection_zero_eq_unitaryTransvection] at hg'coe
    exact mem_iSup_unitaryTransvectionSubgroup_of_coe_eq he0 hg'coe
  rcases hfield with hr2 | ⟨t, ht, ht0, ht1⟩
  · obtain ⟨g₁, hg₁W, c₁, hg₁⟩ := exists_siegelTransvection_single_zero_mem_iSup_of_three_le hσ htr
      hadm (by omega) hw₂l
    exact siegelTransvection_single_zero_mem_iSup_of_mem_iSup hσ h0r he0w₂ hg₁W hg₁ hg'coe
  · obtain ⟨g₁, hg₁W, c₁, hg₁⟩ := exists_siegelTransvection_single_zero_mem_iSup_of_exists_fixed
      hσ htr hadm h0r ht ht0 ht1 hw₂0 hw₂l
    exact siegelTransvection_single_zero_mem_iSup_of_mem_iSup hσ h0r he0w₂ hg₁W hg₁ hg'coe

/-- **Unitary transvections generate the standard special unitary group.** Let `σ` be an involution
of a field `K` such that `t ↦ t + σ(t)` is onto `{s | σ(s) = s}`, `d + σ(d) = 0` has a nonzero
solution, and, when `r` is positive and even, `b ↦ σ(b) * b` is onto `{s | σ(s) = s}`. Assuming
`r ≠ 2` or that `{t : K | σ(t) = t}` has at least three elements (excluding `SU₃(2)`), the unitary
transvections generate `(typeAGraphConjugator r K).specialIsometryGroup σ`. -/
theorem iSup_unitaryTransvectionSubgroup_typeAGraphConjugator
    (hσ : Function.Involutive σ) (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s)
    (hadm : ∃ d ≠ (0 : K), d + σ d = 0) {r : ℕ}
    (hnorm : Even r → r ≠ 0 → ∀ s : K, σ s = s → ∃ b : K, σ b * b = s)
    (hfield : r ≠ 2 ∨ ∃ t : K, σ t = t ∧ t ≠ 0 ∧ t ≠ 1) :
    ⨆ p, (typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).unitaryTransvectionSubgroup σ p = ⊤ := by
  by_cases hr0 : r = 0
  · subst hr0
    refine top_unique fun g _ ↦ ?_
    obtain rfl : g = 1 :=
      Subtype.ext (Subsingleton.elim (α := Matrix.SpecialLinearGroup (Fin 1) K) _ _)
    exact one_mem _
  exact specialIsometryGroup_typeAGraphConjugator_eq_top_of_siegelTransvection_mem hσ htr hadm
    hnorm _ fun _ _ _ _ hu0 hu huw _ hg ↦
      siegelTransvection_mem_iSup_of_ne_zero hσ htr hadm hr0 hfield hu0 hu huw hg

end Field

