public import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Isometry.SiegelGeneration
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Module
import TauCeti.Algebra.Group.Hom.Defs
import TauCeti.LinearAlgebra.Matrix.MulVec
import TauCeti.LinearAlgebra.Matrix.SesquilinearForm

/-!
# Transvection generation of the standard special unitary groups

`TauCeti.subgroup_typeAGraphConjugator_eq_top_of_siegelTransvection_mem` shows that
`Q_r.specialIsometryGroup σ` (`Q_r = typeAGraphConjugator r K`) is generated by its admissible
Siegel transformations `S(u, w, c)`. This file expresses every admissible Siegel transformation as a
product of unitary transvections (`S(v, 0, a) = τ_{v, a}`), proving that
`Q_r.elementaryUnitaryGroup σ = ⊤` under the signed-trace and kernel hypotheses whenever `r ≠ 2` or
`{t : K | σ(t) = t}` has at least three elements (excluding `SU₃(2)`).

## Main results

* `TauCeti.elementaryUnitaryGroup_typeAGraphConjugator_eq_top`: if `σ` is an involution, the signed
  trace `t ↦ t + (-1) ^ r * σ(t)` is onto `{s | σ(s) = (-1) ^ r * s}` and has a nonzero kernel
  element, and `r ≠ 2 ∨ ∃ t, σ t = t ∧ t ≠ 0 ∧ t ≠ 1`, then
  `(typeAGraphConjugator r K).elementaryUnitaryGroup σ = ⊤`.

## References

* J. Dieudonné, *La géométrie des groupes classiques*, 3rd ed., Springer (1971), Chapter II, §5.
* D. E. Taylor, *The Geometry of the Classical Groups* (1992), §10.5 and §11.4.
-/

public section

open Matrix

namespace TauCeti

section Field

variable {K : Type*} [Field K] {σ : K →+* K}

private abbrev stdUnitMat (R : Type*) [Ring R] (r : ℕ) : Matrix (Fin (r + 1)) (Fin (r + 1)) R :=
  typeAGraphConjugator r R

private theorem siegelTransvection_single_zero_mem_elementary_of_mem_elementary
    (hσ : Function.Involutive σ) {r : ℕ} (h0r : (0 : Fin (r + 1)) ≠ Fin.last r)
    {w : Fin (r + 1) → K}
    (he0w : (σ ∘ Pi.single (0 : Fin (r + 1)) 1) ⬝ᵥ (stdUnitMat K r *ᵥ w) = 0)
    {g₁ g₂ : (stdUnitMat K r).specialIsometryGroup σ}
    (hg₁W : g₁ ∈ (stdUnitMat K r).elementaryUnitaryGroup σ) {c₁ c₂ : K}
    (hg₁ : ((g₁ : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) w c₁)
    (hg₂ : ((g₂ : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) w c₂) :
    g₂ ∈ (stdUnitMat K r).elementaryUnitaryGroup σ := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have hdet : (stdUnitMat K r).det ≠ 0 := (isUnits_det_units _).ne_zero
  have he0_ne : (Pi.single 0 1 : Fin (r + 1) → K) ≠ 0 := Pi.single_ne_zero_iff.mpr one_ne_zero
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  have hc₁ := (exists_mem_specialIsometryGroup_coe_eq_siegelTransvection_iff hσ hQ hdet he0_ne he0
    he0w c₁).mp ⟨g₁.val, g₁.property, hg₁⟩
  have hc₂ := (exists_mem_specialIsometryGroup_coe_eq_siegelTransvection_iff hσ hQ hdet he0_ne he0
    he0w c₂).mp ⟨g₂.val, g₂.property, hg₂⟩
  have ha : (c₂ - c₁) + (-1 : K) ^ r * σ (c₂ - c₁) = 0 := by
    rw [map_sub]; linear_combination hc₂ - hc₁
  obtain ⟨t, htW, hta⟩ := exists_mem_elementaryUnitaryGroup_coe_eq hσ hQ he0 ha
  have hprod : g₂ = t * g₁ := Subtype.ext <| Subtype.ext <| by
    rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, hta, hg₁, hg₂,
      ← siegelTransvection_zero_eq_unitaryTransvection (ε := (-1 : K) ^ r),
      siegelTransvection_mul_siegelTransvection he0 he0w (by simp), zero_add]
    congr 1
    rw [map_comp_zero, zero_dotProduct, mul_zero, sub_zero, sub_add_cancel]
  exact hprod ▸ mul_mem htW hg₁W

private theorem exists_siegelTransvection_single_zero_mem_elementary_of_exists_fixed
    (hσ : Function.Involutive σ) {r : ℕ}
    (htr : ∀ s : K, σ s = (-1 : K) ^ r * s → ∃ a : K, a + (-1 : K) ^ r * σ a = s)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ r * σ d = 0)
    (h0r : (0 : Fin (r + 1)) ≠ Fin.last r)
    {t : K} (ht : σ t = t) (ht0 : t ≠ 0) (ht1 : t ≠ 1) {w : Fin (r + 1) → K}
    (hw0 : w 0 = 0) (hwl : w (Fin.last r) = 0) :
    ∃ g₁ ∈ (stdUnitMat K r).elementaryUnitaryGroup σ,
      ∃ c₁ : K, ((g₁ : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
          (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) w c₁ := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  let w₀ : Fin (r + 1) → K := (t - 1)⁻¹ • w
  have he0w₀ : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ w₀) = 0 := by
    rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]; simp [w₀, Fin.rev_zero, hwl]
  have hw₀e0 : (σ ∘ w₀) ⬝ᵥ (stdUnitMat K r *ᵥ Pi.single 0 1) = 0 :=
    (comp_dotProduct_mulVec_eq_zero_comm hσ hQ).mp he0w₀
  obtain ⟨c₀, hc₀⟩ := htr
    (-((-1 : K) ^ r * ((σ ∘ w₀) ⬝ᵥ (stdUnitMat K r *ᵥ w₀)))) (by
      rw [map_neg, map_mul, map_pow, map_neg, map_one, apply_comp_dotProduct_mulVec hσ hQ]
      rcases neg_one_pow_eq_or K r with hr | hr <;> simp [hr])
  obtain ⟨g₀SL, hg₀Q, hg₀coe⟩ := exists_mem_specialIsometryGroup_coe_eq_siegelTransvection hσ hQ
    he0 he0w₀ (c := c₀) (by linear_combination hc₀)
  let g₀ : (stdUnitMat K r).specialIsometryGroup σ := ⟨g₀SL, hg₀Q⟩
  obtain ⟨hDQ, hDW⟩ := diag2n_zero_last_mem_elementaryUnitaryGroup_typeAGraphConjugator
    hσ h0r hadm ht0 ht
  let D : (stdUnitMat K r).specialIsometryGroup σ :=
    ⟨Matrix.SpecialLinearGroup.diag2n h0r t ht0, hDQ⟩
  let k : (stdUnitMat K r).specialIsometryGroup σ := D * g₀ * D⁻¹ * g₀⁻¹
  have hkW : k ∈ (stdUnitMat K r).elementaryUnitaryGroup σ := by
    have hk_eq : k = D * (g₀ * D⁻¹ * g₀⁻¹) := by simp [k, mul_assoc]
    rw [hk_eq]
    exact mul_mem hDW ((normal_elementaryUnitaryGroup (Q := stdUnitMat K r) (σ := σ)).conj_mem _
      (inv_mem hDW) g₀)
  have hDe0 : ((D : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ Pi.single 0 1 = t • Pi.single 0 1 :=
    Matrix.SpecialLinearGroup.diag2n_mulVec_single_left h0r ht0 1
  have hDw₀ : ((D : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w₀ = w₀ :=
    Matrix.SpecialLinearGroup.diag2n_mulVec_eq_self h0r ht0 (by simp [w₀, hw0]) (by simp [w₀, hwl])
  have hw_eq : t • w₀ + -w₀ = w := by
    calc t • w₀ + -w₀ = (t - 1) • w₀ := by module
      _ = w := by simp only [w₀, smul_smul, mul_inv_cancel₀ (sub_ne_zero.mpr ht1), one_smul]
  exact ⟨k, hkW, _, by
    simp only [k, Subgroup.coe_mul, Subgroup.coe_inv, Matrix.SpecialLinearGroup.coe_mul]
    rw [coe_inv_eq_siegelTransvection_neg he0 he0w₀ hw₀e0 hg₀coe, hg₀coe,
      coe_mul_siegelTransvection_mul_coe_inv D.property, hDe0, hDw₀,
      siegelTransvection_smul_left hσ, ht, siegelTransvection_mul_siegelTransvection he0
        (by rw [mulVec_neg, dotProduct_neg, he0w₀, neg_zero])
        (by rw [TauCeti.map_comp_smul, smul_dotProduct, hw₀e0, smul_zero]),
      hw_eq]⟩

private theorem siegelTransvection_single_zero_isotropic_mem_elementary
    (hσ : Function.Involutive σ) {r : ℕ} (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ r * σ d = 0)
    (h0r : (0 : Fin (r + 1)) ≠ Fin.last r) {z : Fin (r + 1) → K}
    (hz : (σ ∘ z) ⬝ᵥ (stdUnitMat K r *ᵥ z) = 0)
    (he0z : (σ ∘ Pi.single (0 : Fin (r + 1)) 1) ⬝ᵥ (stdUnitMat K r *ᵥ z) = 0) :
    ∃ g ∈ (stdUnitMat K r).elementaryUnitaryGroup σ,
      ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) z 0 := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  obtain ⟨d, hd0, hd⟩ := hadm
  have hnd : -d + (-1 : K) ^ r * σ (-d) = 0 := by rw [map_neg]; linear_combination -hd
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  have hze0 := (comp_dotProduct_mulVec_eq_zero_comm hσ hQ).mp he0z
  let y : Fin (r + 1) → K := d⁻¹ • z
  have hy : (σ ∘ y) ⬝ᵥ (stdUnitMat K r *ᵥ y) = 0 := by
    rw [comp_smul_dotProduct_mulVec_smul, hz, mul_zero]
  have he0y : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ y) = 0 := by
    rw [mulVec_smul, dotProduct_smul, he0z, smul_zero]
  have hye0 : (σ ∘ y) ⬝ᵥ (stdUnitMat K r *ᵥ Pi.single 0 1) = 0 := by
    rw [TauCeti.map_comp_smul, smul_dotProduct, hze0, smul_zero]
  have hsum : (σ ∘ (Pi.single 0 1 + y)) ⬝ᵥ (stdUnitMat K r *ᵥ (Pi.single 0 1 + y)) = 0 := by
    rw [comp_add_dotProduct_mulVec, mulVec_add, dotProduct_add, dotProduct_add, he0, hy, he0y,
      hye0, add_zero, add_zero]
  obtain ⟨t₁, ht₁W, ht₁⟩ := exists_mem_elementaryUnitaryGroup_coe_eq hσ hQ hsum hd
  obtain ⟨t₂, ht₂W, ht₂⟩ := exists_mem_elementaryUnitaryGroup_coe_eq hσ hQ he0 hnd
  obtain ⟨t₃, ht₃W, ht₃⟩ := exists_mem_elementaryUnitaryGroup_coe_eq hσ hQ hy hnd
  refine ⟨t₁ * t₂ * t₃, mul_mem (mul_mem ht₁W ht₂W) ht₃W, mulVec_injective (funext fun v ↦ ?_)⟩
  have hdσd : d * (σ d)⁻¹ = -((-1 : K) ^ r) := by
    rw [← div_eq_mul_inv, div_eq_iff ((map_ne_zero σ).mpr hd0)]; linear_combination hd
  simp only [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul]
  rw [ht₁, ht₂, ht₃, Matrix.mul_assoc, ← mulVec_mulVec, ← mulVec_mulVec]
  simp only [unitaryTransvection_mulVec, siegelTransvection_mulVec, mulVec_add, mulVec_smul,
    comp_add_dotProduct_mulVec, he0, hy, he0y, hye0, mul_zero, add_zero, zero_smul]
  simp only [y, TauCeti.map_comp_smul, map_inv₀, smul_dotProduct, smul_eq_mul, smul_add, smul_smul]
  dsimp only [stdUnitMat] at hdσd ⊢
  have hc1 (x : K) : d * x * d⁻¹ = x := by rw [mul_right_comm, mul_inv_cancel₀ hd0, one_mul]
  have hc2 (x : K) : -d * x * d⁻¹ = -x := by rw [neg_mul, neg_mul, hc1]
  have hc3 : d * ((σ d)⁻¹ * ((σ ∘ z) ⬝ᵥ ((typeAGraphConjugator r K : Matrix _ _ K) *ᵥ v))) =
      -((-1 : K) ^ r * ((σ ∘ z) ⬝ᵥ ((typeAGraphConjugator r K : Matrix _ _ K) *ᵥ v))) := by
    rw [← mul_assoc, hdσd, neg_mul]
  rw [hc1, hc2, mul_add, hc3]; module

private theorem exists_siegelTransvection_single_zero_mem_elementary_of_pair_ne
    (hσ : Function.Involutive σ) {r : ℕ}
    (htr : ∀ s : K, σ s = (-1 : K) ^ r * s → ∃ a : K, a + (-1 : K) ^ r * σ a = s)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ r * σ d = 0)
    (h0r : (0 : Fin (r + 1)) ≠ Fin.last r)
    {x₀ : Fin (r + 1) → K} (hx₀ : (σ ∘ x₀) ⬝ᵥ (stdUnitMat K r *ᵥ x₀) = 0)
    (hx₀l : x₀ (Fin.last r) = 0) {v : Fin (r + 1) → K} (hvl : v (Fin.last r) = 0)
    (hv : (σ ∘ v) ⬝ᵥ (stdUnitMat K r *ᵥ x₀) ≠ 0) :
    ∃ g ∈ (stdUnitMat K r).elementaryUnitaryGroup σ,
      ∃ c : K, ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
          (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) v c := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  obtain ⟨a, hz₁⟩ := exists_comp_add_smul_dotProduct_mulVec_add_smul_eq_zero hσ hQ htr hx₀ hv
  have he0z₁ : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ (v + a • x₀)) = 0 := by
    rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]; simp [Fin.rev_zero, hvl, hx₀l]
  have hz₂ : (σ ∘ ((-a) • x₀)) ⬝ᵥ (stdUnitMat K r *ᵥ ((-a) • x₀)) = 0 := by
    rw [comp_smul_dotProduct_mulVec_smul, hx₀, mul_zero]
  have he0z₂ : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ ((-a) • x₀)) = 0 := by
    rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]; simp [Fin.rev_zero, hx₀l]
  obtain ⟨g₁, hg₁W, hg₁⟩ :=
    siegelTransvection_single_zero_isotropic_mem_elementary hσ hadm h0r hz₁ he0z₁
  obtain ⟨g₂, hg₂W, hg₂⟩ :=
    siegelTransvection_single_zero_isotropic_mem_elementary hσ hadm h0r hz₂ he0z₂
  have hv_eq : (v + a • x₀) + (-a) • x₀ = v := by module
  exact ⟨g₁ * g₂, mul_mem hg₁W hg₂W, _, by
    rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, hg₁, hg₂,
      siegelTransvection_mul_siegelTransvection he0 he0z₂
        ((comp_dotProduct_mulVec_eq_zero_comm hσ hQ).mp he0z₁), hv_eq]⟩

private theorem exists_siegelTransvection_single_zero_mem_elementary_of_three_le
    (hσ : Function.Involutive σ) {r : ℕ}
    (htr : ∀ s : K, σ s = (-1 : K) ^ r * s → ∃ a : K, a + (-1 : K) ^ r * σ a = s)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ r * σ d = 0)
    (hr : 3 ≤ r) {w : Fin (r + 1) → K} (hwl : w (Fin.last r) = 0) :
    ∃ g₁ ∈ (stdUnitMat K r).elementaryUnitaryGroup σ,
      ∃ c₁ : K, ((g₁ : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
        Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
          (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) w c₁ := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have h0r : (0 : Fin (r + 1)) ≠ Fin.last r := by simp [Fin.ext_iff]; omega
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  let i₁ : Fin (r + 1) := ⟨1, by omega⟩
  let j₁ : Fin (r + 1) := i₁.rev
  let x₀ : Fin (r + 1) → K := Pi.single i₁ 1
  let y₀ : Fin (r + 1) → K := Pi.single j₁ 1
  have hi₁j₁ : i₁ ≠ j₁ := by simp [i₁, j₁, Fin.ext_iff, Fin.rev]; omega
  have hi₁l : i₁ ≠ Fin.last r := by simp [i₁, Fin.ext_iff]; omega
  have hj₁l : j₁ ≠ Fin.last r := by simp [j₁, i₁, Fin.ext_iff, Fin.rev]; omega
  have hx₀ : (σ ∘ x₀) ⬝ᵥ (stdUnitMat K r *ᵥ x₀) = 0 :=
    comp_single_dotProduct_typeAGraphConjugator_mulVec_single hi₁j₁
  have hx₀l : x₀ (Fin.last r) = 0 := by simp [x₀, hi₁l.symm]
  by_cases hwx : (σ ∘ w) ⬝ᵥ (stdUnitMat K r *ᵥ x₀) = 0
  swap
  · exact exists_siegelTransvection_single_zero_mem_elementary_of_pair_ne
      hσ htr hadm h0r hx₀ hx₀l hwl hwx
  have hyx : (σ ∘ y₀) ⬝ᵥ (stdUnitMat K r *ᵥ x₀) ≠ 0 := by
    dsimp only [y₀]
    rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]
    simp [x₀, j₁]
  have hwjl : (w + y₀) (Fin.last r) = 0 := by simp [y₀, hwl, hj₁l.symm]
  obtain ⟨g₁, hg₁W, c₁, hg₁⟩ := exists_siegelTransvection_single_zero_mem_elementary_of_pair_ne
    hσ htr hadm h0r hx₀ hx₀l hwjl (by rwa [comp_add_dotProduct_mulVec, hwx, zero_add])
  have hy₀ : (σ ∘ y₀) ⬝ᵥ (stdUnitMat K r *ᵥ y₀) = 0 :=
    comp_single_dotProduct_typeAGraphConjugator_mulVec_single (by simpa [j₁] using hi₁j₁.symm)
  have hny₀ : (σ ∘ (-y₀)) ⬝ᵥ (stdUnitMat K r *ᵥ (-y₀)) = 0 := by
    rw [map_comp_neg, neg_dotProduct, mulVec_neg, dotProduct_neg, hy₀, neg_zero, neg_zero]
  have he0ny₀ : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ (-y₀)) = 0 := by
    rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]; simp [y₀, Fin.rev_zero, hj₁l.symm]
  have he0wy₀ : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ (w + y₀)) = 0 := by
    rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]; simp [Fin.rev_zero, hwjl]
  obtain ⟨g₂, hg₂W, hg₂⟩ :=
    siegelTransvection_single_zero_isotropic_mem_elementary hσ hadm h0r hny₀ he0ny₀
  exact ⟨g₁ * g₂, mul_mem hg₁W hg₂W, _, by
    rw [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, hg₁, hg₂,
      siegelTransvection_mul_siegelTransvection he0 he0ny₀
        ((comp_dotProduct_mulVec_eq_zero_comm hσ hQ).mp he0wy₀), add_neg_cancel_right]⟩

private theorem exists_conj_coe_eq_siegelTransvection_single_zero (hσ : Function.Involutive σ)
    {r : ℕ} (htr : ∀ s : K, σ s = (-1 : K) ^ r * s → ∃ t : K, t + (-1 : K) ^ r * σ t = s)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ r * σ d = 0)
    (h0r : (0 : Fin (r + 1)) ≠ Fin.last r)
    {g : (stdUnitMat K r).specialIsometryGroup σ} {u w : Fin (r + 1) → K} {c : K}
    (hu0 : u ≠ 0) (hu : (σ ∘ u) ⬝ᵥ (stdUnitMat K r *ᵥ u) = 0)
    (huw : (σ ∘ u) ⬝ᵥ (stdUnitMat K r *ᵥ w) = 0)
    (hg : ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) u w c) :
    ∃ (h : (stdUnitMat K r).specialIsometryGroup σ) (w₂ : Fin (r + 1) → K) (c₂ : K),
      w₂ 0 = 0 ∧ w₂ (Fin.last r) = 0 ∧
      (((h * g * h⁻¹ : (stdUnitMat K r).specialIsometryGroup σ) :
        Matrix.SpecialLinearGroup (Fin (r + 1)) K) : Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) (Pi.single 0 1) w₂ c₂ := by
  have hQ := transpose_map_typeAGraphConjugator σ r
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  have he0_ne : (Pi.single 0 1 : Fin (r + 1) → K) ≠ 0 := Pi.single_ne_zero_iff.mpr one_ne_zero
  obtain ⟨⟨h, _⟩, a, ha0, hhu⟩ := exists_elementaryUnitaryGroup_mulVec_eq_smul hσ hQ
    (isUnits_det_units _).ne_zero htr hadm hu0 he0_ne hu he0
  let w₁ : Fin (r + 1) → K := σ a • (((h : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
    Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w)
  let w₂ : Fin (r + 1) → K := w₁ + (-w₁ 0) • Pi.single 0 1
  have hw₁l : w₁ (Fin.last r) = 0 := by
    have hhw :=
      comp_mulVec_dotProduct_mulVec_mulVec (mem_specialIsometryGroup_iff.mp h.property) u w
    rw [huw, hhu, TauCeti.map_comp_smul, smul_dotProduct, smul_eq_mul] at hhw
    have h1 := (mul_eq_zero.mp hhw).resolve_left ((map_ne_zero σ).mpr ha0)
    have hpair := comp_single_dotProduct_typeAGraphConjugator_mulVec σ (0 : Fin (r + 1)) w₁
    simp only [Fin.val_zero, pow_zero, one_mul, Fin.rev_zero] at hpair
    rw [← hpair, mulVec_smul, dotProduct_smul, h1, smul_zero]
  have hw₁_eq : σ a • (((h : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) *ᵥ w) = w₂ + w₁ 0 • Pi.single 0 1 := by
    simp [w₂, w₁]
  refine ⟨h, w₂, c * a * σ a + w₁ 0 - (-1 : K) ^ r * σ (w₁ 0), by simp [w₂],
    by simp [w₂, hw₁l, h0r.symm], ?_⟩
  simp only [Subgroup.coe_mul, Subgroup.coe_inv, Matrix.SpecialLinearGroup.coe_mul]
  rw [hg, coe_mul_siegelTransvection_mul_coe_inv h.property, hhu, siegelTransvection_smul_left hσ,
    hw₁_eq, siegelTransvection_add_smul]

private theorem siegelTransvection_mem_elementary_of_ne_zero (hσ : Function.Involutive σ) {r : ℕ}
    (htr : ∀ s : K, σ s = (-1 : K) ^ r * s → ∃ t : K, t + (-1 : K) ^ r * σ t = s)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ r * σ d = 0)
    (hr0 : r ≠ 0) (hfield : r ≠ 2 ∨ ∃ t : K, σ t = t ∧ t ≠ 0 ∧ t ≠ 1)
    {g : (stdUnitMat K r).specialIsometryGroup σ} {u w : Fin (r + 1) → K} {c : K}
    (hu0 : u ≠ 0) (hu : (σ ∘ u) ⬝ᵥ (stdUnitMat K r *ᵥ u) = 0)
    (huw : (σ ∘ u) ⬝ᵥ (stdUnitMat K r *ᵥ w) = 0)
    (hg : ((g : Matrix.SpecialLinearGroup (Fin (r + 1)) K) :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K) =
        (stdUnitMat K r).siegelTransvection σ ((-1 : K) ^ r) u w c) :
    g ∈ (stdUnitMat K r).elementaryUnitaryGroup σ := by
  have h0r : (0 : Fin (r + 1)) ≠ Fin.last r := by simp [Fin.ext_iff]; omega
  have he0 := comp_single_dotProduct_typeAGraphConjugator_mulVec_single (σ := σ) (i := 0)
    (by rwa [Fin.rev_zero])
  obtain ⟨h, w₂, c₂, hw₂0, hw₂l, hg'coe⟩ :=
    exists_conj_coe_eq_siegelTransvection_single_zero hσ htr hadm h0r hu0 hu huw hg
  let g' : (stdUnitMat K r).specialIsometryGroup σ := h * g * h⁻¹
  suffices hg'W : g' ∈ (stdUnitMat K r).elementaryUnitaryGroup σ by
    simpa [g', mul_assoc] using
      (normal_elementaryUnitaryGroup (Q := stdUnitMat K r) (σ := σ)).conj_mem g' hg'W h⁻¹
  have he0w₂ : (σ ∘ Pi.single 0 1) ⬝ᵥ (stdUnitMat K r *ᵥ w₂) = 0 := by
    rw [comp_single_dotProduct_typeAGraphConjugator_mulVec]; simp [Fin.rev_zero, hw₂l]
  by_cases hr1 : r = 1
  · subst hr1
    have hw₂_eq : w₂ = 0 := funext fun i ↦ by fin_cases i; exacts [hw₂0, hw₂l]
    rw [hw₂_eq, siegelTransvection_zero_eq_unitaryTransvection] at hg'coe
    exact mem_elementaryUnitaryGroup_of_coe_eq he0 hg'coe
  rcases hfield with hr2 | ⟨t, ht, ht0, ht1⟩
  · obtain ⟨g₁, hg₁W, c₁, hg₁⟩ := exists_siegelTransvection_single_zero_mem_elementary_of_three_le
      hσ htr hadm (by omega) hw₂l
    exact siegelTransvection_single_zero_mem_elementary_of_mem_elementary
      hσ h0r he0w₂ hg₁W hg₁ hg'coe
  · obtain ⟨g₁, hg₁W, c₁, hg₁⟩ :=
      exists_siegelTransvection_single_zero_mem_elementary_of_exists_fixed
        hσ htr hadm h0r ht ht0 ht1 hw₂0 hw₂l
    exact siegelTransvection_single_zero_mem_elementary_of_mem_elementary
      hσ h0r he0w₂ hg₁W hg₁ hg'coe

/-- **Unitary transvections generate the standard special unitary group.** Let `σ` be an involution
of a field `K` and `Q_r = typeAGraphConjugator r K`. Assuming that the signed trace
`t ↦ t + (-1) ^ r * σ(t)` is onto `{s | σ(s) = (-1) ^ r * s}` and has a nonzero kernel element, and
that either `r ≠ 2` or the fixed field `{t : K | σ(t) = t}` has at least three elements (excluding
`SU₃(2)`), the elementary unitary group `Q_r.elementaryUnitaryGroup σ` equals `⊤`. -/
theorem elementaryUnitaryGroup_typeAGraphConjugator_eq_top (hσ : Function.Involutive σ) {r : ℕ}
    (htr : ∀ s : K, σ s = (-1 : K) ^ r * s → ∃ t : K, t + (-1 : K) ^ r * σ t = s)
    (hadm : ∃ d ≠ (0 : K), d + (-1 : K) ^ r * σ d = 0)
    (hfield : r ≠ 2 ∨ ∃ t : K, σ t = t ∧ t ≠ 0 ∧ t ≠ 1) :
    (typeAGraphConjugator r K :
      Matrix (Fin (r + 1)) (Fin (r + 1)) K).elementaryUnitaryGroup σ = ⊤ := by
  by_cases hr0 : r = 0
  · subst hr0
    refine top_unique fun g _ ↦ ?_
    obtain rfl : g = 1 :=
      Subtype.ext (Subsingleton.elim (α := Matrix.SpecialLinearGroup (Fin 1) K) _ _)
    exact one_mem _
  exact subgroup_typeAGraphConjugator_eq_top_of_siegelTransvection_mem hσ htr hadm _
    fun _ _ _ _ hu0 hu huw _ hg ↦
      siegelTransvection_mem_elementary_of_ne_zero hσ htr hadm hr0 hfield hu0 hu huw hg

