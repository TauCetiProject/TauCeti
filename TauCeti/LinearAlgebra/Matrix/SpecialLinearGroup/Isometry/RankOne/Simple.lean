/-!
# Normal generation, perfectness, and simplicity of rank-one unitary groups

Let `K` be a field with an involutive endomorphism `σ : K →+* K`, let `Q` be the three-dimensional
signed reversal matrix `TauCeti.typeAGraphConjugator 2 K`, and let
`G = Matrix.specialIsometryGroup Q σ` be the special isometry group of the `σ`-sesquilinear form of
Gram matrix `Q`. Building on the Bruhat decomposition and rank-one Tits system of
`TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Isometry.RankOne.Bruhat`, this file determines
when `G` is normally generated by its upper-unitriangular unipotent subgroup `U`, identifies the
normal core of its Borel subgroup `B` with the centre `Z(G)`, proves perfectness of `G`, and
deduces the simplicity of `G ⧸ Z(G)` and of `TauCeti.DerivedCentralQuotient G`.

Each step carries the sharp field-theoretic hypotheses on `(K, σ)` under which it holds:

* **Normal generation (`normalClosure_unipotentSubgroup_eq_top`) and Borel normal core
  (`normalCore_borelSubgroup_eq_center`).** Assuming a nonzero skew-trace element `d ≠ 0` with
  `d + σ d = 0` (which excludes `SO₃(𝔽₃) ≅ S₄`, where `normalClosure U = A₄`), the rank-one matrix
  identity `weyl_mul_torus_mk0_eq` expresses `w · torus(z)` as a product of two elements of `U` and
  one `w`-conjugate of `U` whenever `z ≠ 0` satisfies `z + σ z = x * σ x`. Scaling `d` by `σ`-fixed
  units puts `torus(s)` into `normalClosure U` for every `σ`-fixed `s ∈ Kˣ`, and for any `t ∈ Kˣ`
  with `σ t ≠ t` the skew-trace adjustment `s = d * (t - σ t)` makes `s * d * t` have trace `s²`,
  putting every torus element, `w`, `B`, and hence all of `G = B ∪ B w B` into `normalClosure U`.
  Disjointness of `normalCore B` from `U` then forces `normalCore B` to centralize `U`, hence all
  of `G`, while commuting with the central root element `u(0, d)` forces `Z(G) ≤ B`.
* **Commutator generation (`unipotentSubgroup_le_commutator` and `commutator_eq_top`).** Assuming
  the trace `t ↦ t + σ t` is surjective onto `{s | σ s = s}` and some `a ∈ Kˣ` satisfies
  `a ^ 2 ≠ σ a` (which excludes `SU₃(2)` of order `216`, where `a ^ 2 = a ^ 2` on `𝔽₄ˣ`), root-group
  commutators produce every central root element `u(0, z₀)` with `z₀ + σ z₀ = 0`, and torus
  commutators `⁅torus(a), u(x₁, z₁)⁆` produce every first coordinate `x`, so `U ≤ ⁅G, G⁆`.
* **Simplicity (`isSimpleGroup_quotient_center` and `isSimpleGroup_derivedCentralQuotient`).**
  Combining Tits's simplicity theorem `TauCeti.TitsSystem.isSimpleGroup_quotient_normalCore` for
  the irreducible rank-one Tits system on `G` with nilpotency of `U`, normal generation,
  perfectness, and `normalCore B = Z(G)` shows that `G ⧸ Z(G)` and `DerivedCentralQuotient G` are
  simple groups.

## Main results

* `TauCeti.UnitaryRankOne.weyl_mul_torus_mk0_eq`: the rank-one identity expressing `w * torus(z)`
  in `U * (w U w) * U` when `z ≠ 0` and `z + σ z = x * σ x`.
* `TauCeti.UnitaryRankOne.normalClosure_unipotentSubgroup_eq_top`: the conjugates of `U` generate
  `G` whenever `∃ d ≠ 0, d + σ d = 0`.
* `TauCeti.UnitaryRankOne.normalCore_borelSubgroup_eq_center`: the normal core of `B` is `Z(G)`
  whenever `∃ d ≠ 0, d + σ d = 0`.
* `TauCeti.UnitaryRankOne.unipotentSubgroup_le_commutator`: `U ≤ commutator G` under surjective
  trace onto fixed elements and `∃ a ≠ 0, a ^ 2 ≠ σ a`.
* `TauCeti.UnitaryRankOne.commutator_eq_top`: `G` is perfect under all three conditions on `(K, σ)`.
* `TauCeti.UnitaryRankOne.isSimpleGroup_quotient_center` and
  `TauCeti.UnitaryRankOne.isSimpleGroup_derivedCentralQuotient`: `G ⧸ Z(G)` and
  `DerivedCentralQuotient G` are simple groups.

## References

* R. W. Carter, *Simple Groups of Lie Type*, Wiley (1972), §§11.1, 13.3, and 14.1.
* D. E. Taylor, *The Geometry of the Classical Groups*, Heldermann (1992), Chapter 10,
  Theorem 10.22.
* R. Wilson, *The Finite Simple Groups*, Springer (2009), §3.6.2.
-/

public section

open Matrix
open scoped commutatorElement

namespace TauCeti.UnitaryRankOne

variable {K : Type*} [Field K] {σ : K →+* K}

private abbrev toMat
    (g : (typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) :
    Matrix (Fin 3) (Fin 3) K :=
  ((g : Matrix.SpecialLinearGroup (Fin 3) K) : Matrix (Fin 3) (Fin 3) K)

private theorem ext_toMat
    {g h : (typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ}
    (H : ∀ i j : Fin 3, toMat g i j = toMat h i j) : g = h := by
  apply Subtype.ext
  apply Matrix.SpecialLinearGroup.ext
  exact H

private theorem toMat_mul
    (g h : (typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) :
    toMat (g * h) = toMat g * toMat h := (rfl)

private theorem toMat_unipotentHom (a : HeisenbergGroup.unitarySubgroup σ) :
    toMat (unipotentHom K σ a) = (a : HeisenbergGroup K).toMatrix := by
  simp [toMat]

private theorem toMat_weyl :
    toMat (weyl K σ) = !![0, 0, 1; 0, -1, 0; 1, 0, 0] :=
  coe_weyl K σ

private theorem toMat_torus (hσ : Function.Involutive σ) (t : Kˣ) :
    toMat (torus K σ hσ t) =
      Matrix.diagonal ![(t : K), ((t⁻¹ : Kˣ) : K) * σ (t : K), σ ((t⁻¹ : Kˣ) : K)] :=
  coe_torus hσ t

/-! ### Normal generation by the unipotent subgroup -/

/-- Every product `weyl * torus (Units.mk0 z hz0)` for root parameters `(x, z)` with `z ≠ 0`
factors as a product of two upper-unitriangular root elements and one `weyl`-conjugated root
element. -/
theorem weyl_mul_torus_mk0_eq (hσ : Function.Involutive σ) {x z : K} (hz0 : z ≠ 0)
    (hz : z + σ z = x * σ x) :
    unipotentHom K σ (HeisenbergGroup.unitaryMk σ hσ (x * (σ z)⁻¹) (σ z)⁻¹ (by
        have h1 := mul_inv_cancel₀ hz0
        have h2 := mul_inv_cancel₀ ((map_ne_zero σ).mpr hz0)
        simp only [map_mul, map_inv₀, hσ z]
        linear_combination z⁻¹ * (σ z)⁻¹ * hz - (σ z)⁻¹ * h1 - z⁻¹ * h2)) *
      (weyl K σ * unipotentHom K σ (HeisenbergGroup.unitaryMk σ hσ x z hz) * weyl K σ) *
      unipotentHom K σ (HeisenbergGroup.unitaryMk σ hσ (x * z⁻¹) (σ z)⁻¹ (by
        have h1 := mul_inv_cancel₀ hz0
        have h2 := mul_inv_cancel₀ ((map_ne_zero σ).mpr hz0)
        simp only [map_mul, map_inv₀, hσ z]
        linear_combination z⁻¹ * (σ z)⁻¹ * hz - (σ z)⁻¹ * h1 - z⁻¹ * h2)) =
      weyl K σ * torus K σ hσ (Units.mk0 z hz0) := by
  have hσz : σ z ≠ 0 := (map_ne_zero σ).mpr hz0
  have hz1 : z * z⁻¹ = 1 := mul_inv_cancel₀ hz0
  have hσz1 : σ z * (σ z)⁻¹ = 1 := mul_inv_cancel₀ hσz
  set L := weyl K σ * unipotentHom K σ (HeisenbergGroup.unitaryMk σ hσ x z hz) * weyl K σ
  have hL : toMat L = !![1, 0, 0; -σ x, 1, 0; z, -x, 1] := by
    simpa [toMat, L] using coe_weyl_mul_unipotentHom_mul_weyl
      (HeisenbergGroup.unitaryMk σ hσ x z hz)
  apply ext_toMat
  intro i j
  simp only [toMat_mul, hL, toMat_unipotentHom, toMat_weyl, toMat_torus,
    HeisenbergGroup.coe_unitaryMk, Matrix.mul_apply, Fin.sum_univ_three]
  fin_cases i <;> fin_cases j <;>
    simp [HeisenbergGroup.toMatrix_apply, hσ z]
  · linear_combination (σ z)⁻¹ * hz - hσz1
  · linear_combination x * z⁻¹ * (σ z)⁻¹ * hz - x * z⁻¹ * hσz1
  · linear_combination (σ z)⁻¹ ^ 2 * hz - (σ z)⁻¹ * hσz1
  · linear_combination σ x * hz1
  · linear_combination x * σ x * z⁻¹ * hz1 + z⁻¹ * hz - hz1
  · linear_combination σ x * z⁻¹ * (σ z)⁻¹ * hz - σ x * z⁻¹ * hσz1
  · linear_combination x * hz1
  · linear_combination (σ z)⁻¹ * hz - hσz1

private theorem weyl_mul_torus_mk0_mem_normalClosure (hσ : Function.Involutive σ) {x z : K}
    (hz0 : z ≠ 0) (hz : z + σ z = x * σ x) :
    weyl K σ * torus K σ hσ (Units.mk0 z hz0) ∈
      Subgroup.normalClosure (unipotentSubgroup K σ : Set _) := by
  rw [← weyl_mul_torus_mk0_eq hσ hz0 hz]
  refine mul_mem (mul_mem (Subgroup.subset_normalClosure (unipotentHom_mem_unipotentSubgroup _))
    ?_) (Subgroup.subset_normalClosure (unipotentHom_mem_unipotentSubgroup _))
  have hconj :=
    (inferInstance : (Subgroup.normalClosure (unipotentSubgroup K σ : Set _)).Normal).conj_mem _
      (Subgroup.subset_normalClosure (unipotentHom_mem_unipotentSubgroup
        (HeisenbergGroup.unitaryMk σ hσ x z hz))) (weyl K σ)
  rwa [weyl_inv] at hconj

private theorem torus_mem_normalClosure_of_map_eq (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0) {s : Kˣ} (hs : σ (s : K) = (s : K)) :
    torus K σ hσ s ∈ Subgroup.normalClosure (unipotentSubgroup K σ : Set _) := by
  obtain ⟨d, hd0, hd⟩ := hadm
  have hsd0 : (s : K) * d ≠ 0 := mul_ne_zero s.ne_zero hd0
  have hg₁ := weyl_mul_torus_mk0_mem_normalClosure hσ (x := 0) hd0 (by simpa using hd)
  have hg₂ := weyl_mul_torus_mk0_mem_normalClosure hσ (x := 0) hsd0
    (by simp only [map_mul, hs, map_zero, mul_zero]; linear_combination (s : K) * hd)
  have hmul : (weyl K σ * torus K σ hσ (Units.mk0 d hd0))⁻¹ *
      (weyl K σ * torus K σ hσ (Units.mk0 ((s : K) * d) hsd0)) = torus K σ hσ s := by
    have hu : (Units.mk0 d hd0)⁻¹ * Units.mk0 ((s : K) * d) hsd0 = s := by
      ext
      simp only [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_mk0]
      have hd1 : d * d⁻¹ = 1 := mul_inv_cancel₀ hd0
      linear_combination (s : K) * hd1
    rw [_root_.mul_inv_rev, weyl_inv, mul_assoc, ← mul_assoc (weyl K σ), weyl_mul_self, one_mul,
      ← map_inv, ← map_mul, hu]
  exact hmul ▸ mul_mem (inv_mem hg₁) hg₂

private theorem torus_mem_normalClosure (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0) (t : Kˣ) :
    torus K σ hσ t ∈ Subgroup.normalClosure (unipotentSubgroup K σ : Set _) := by
  by_cases ht : σ (t : K) = (t : K)
  · exact torus_mem_normalClosure_of_map_eq hσ hadm ht
  · obtain ⟨d, hd0, hd⟩ := hadm
    let s : K := d * ((t : K) - σ (t : K))
    have hs0 : s ≠ 0 := mul_ne_zero hd0 (sub_ne_zero.mpr (Ne.symm ht))
    have hσs : σ s = s := by
      simp only [s, map_mul, map_sub, hσ (t : K)]
      linear_combination -((t : K) - σ (t : K)) * hd
    have hz0 : s * d * (t : K) ≠ 0 := mul_ne_zero (mul_ne_zero hs0 hd0) t.ne_zero
    have hg₁ := weyl_mul_torus_mk0_mem_normalClosure hσ (x := 0) hd0 (by simpa using hd)
    have hg₂ := weyl_mul_torus_mk0_mem_normalClosure hσ (x := s) hz0 (by
      simp only [map_mul, hσs]
      change s * d * (t : K) + s * σ d * σ (t : K) = s * (d * ((t : K) - σ (t : K)))
      linear_combination s * σ (t : K) * hd)
    have hst : torus K σ hσ (Units.mk0 s hs0 * t) ∈
        Subgroup.normalClosure (unipotentSubgroup K σ : Set _) := by
      have hu : (Units.mk0 d hd0)⁻¹ * Units.mk0 (s * d * (t : K)) hz0 =
          Units.mk0 s hs0 * t := by
        ext
        simp only [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_mk0]
        have hd1 : d * d⁻¹ = 1 := mul_inv_cancel₀ hd0
        linear_combination s * (t : K) * hd1
      have hmul : (weyl K σ * torus K σ hσ (Units.mk0 d hd0))⁻¹ *
          (weyl K σ * torus K σ hσ (Units.mk0 (s * d * (t : K)) hz0)) =
          torus K σ hσ (Units.mk0 s hs0 * t) := by
        rw [_root_.mul_inv_rev, weyl_inv, mul_assoc, ← mul_assoc (weyl K σ), weyl_mul_self,
          one_mul, ← map_inv, ← map_mul, hu]
      exact hmul ▸ mul_mem (inv_mem hg₁) hg₂
    have hs_mem := torus_mem_normalClosure_of_map_eq hσ ⟨d, hd0, hd⟩ (s := Units.mk0 s hs0) hσs
    rw [map_mul] at hst
    simpa only [inv_mul_cancel_left] using mul_mem (inv_mem hs_mem) hst

/-- **Normal generation by the unipotent subgroup**: when `σ` is involutive and `K` has a nonzero
element `d` with `d + σ d = 0`, the conjugates of `unipotentSubgroup K σ` generate the entire
rank-one special isometry group. -/
theorem normalClosure_unipotentSubgroup_eq_top (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0) :
    Subgroup.normalClosure (unipotentSubgroup K σ :
      Set ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) = ⊤ := by
  have hB : borelSubgroup K σ ≤ Subgroup.normalClosure (unipotentSubgroup K σ :
      Set ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) := by
    rw [borelSubgroup_eq_sup hσ]
    refine sup_le ?_ Subgroup.le_normalClosure
    rintro _ ⟨t, rfl⟩
    exact torus_mem_normalClosure hσ hadm t
  obtain ⟨d, hd0, hd⟩ := hadm
  have hw : weyl K σ ∈ Subgroup.normalClosure (unipotentSubgroup K σ :
      Set ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) := by
    have hwd := weyl_mul_torus_mk0_mem_normalClosure hσ (x := 0) hd0 (by simpa using hd)
    have hd_mem := torus_mem_normalClosure hσ ⟨d, hd0, hd⟩ (Units.mk0 d hd0)
    simpa only [mul_inv_cancel_right] using mul_mem hwd (inv_mem hd_mem)
  rw [eq_top_iff]
  intro g _
  rcases mem_borelSubgroup_or_mem_doubleCoset hσ g with hg | hg
  · exact hB hg
  · obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    exact mul_mem (mul_mem (hB hb₁) hw) (hB hb₂)

/-! ### The normal core of the Borel subgroup -/

/-- The normal core of the Borel subgroup intersects the unipotent subgroup trivially. -/
theorem normalCore_borelSubgroup_inf_unipotentSubgroup_eq_bot :
    (borelSubgroup K σ).normalCore ⊓ unipotentSubgroup K σ = ⊥ := by
  rw [eq_bot_iff]
  rintro g ⟨hgN, hgU⟩
  rw [unipotentSubgroup_def] at hgU
  obtain ⟨a, rfl⟩ := hgU
  have hconj : weyl K σ * unipotentHom K σ a * (weyl K σ)⁻¹ ∈ borelSubgroup K σ :=
    (borelSubgroup K σ).normalCore_le
      ((inferInstance : (borelSubgroup K σ).normalCore.Normal).conj_mem _ hgN (weyl K σ))
  rw [weyl_inv, mem_borelSubgroup_iff, coe_weyl_mul_unipotentHom_mul_weyl] at hconj
  have hz : (a : HeisenbergGroup K).z = 0 := by simpa using hconj
  have hx0 : (a : HeisenbergGroup K).x * σ (a : HeisenbergGroup K).x = 0 := by
    have htr := HeisenbergGroup.unitarySubgroup.z_add_map_z a
    rw [hz, map_zero, add_zero] at htr
    exact htr.symm
  have hx : (a : HeisenbergGroup K).x = 0 := (mul_eq_zero.mp hx0).elim id (map_eq_zero σ).mp
  have ha1 : a = 1 := HeisenbergGroup.unitarySubgroup.ext hx hz
  simp [ha1]

/-- **The normal core of the Borel subgroup is the centre** of the rank-one special isometry group
whenever `σ` is involutive and `∃ d ≠ 0, d + σ d = 0`. -/
theorem normalCore_borelSubgroup_eq_center (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0) :
    (borelSubgroup K σ).normalCore = Subgroup.center _ := by
  refine le_antisymm ?_ (Subgroup.normal_le_normalCore.mpr fun g hg ↦ ?_)
  · have hUC : unipotentSubgroup K σ ≤ Subgroup.centralizer ((borelSubgroup K σ).normalCore :
        Set ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) :=
      le_centralizer_of_le_normalizer_of_inf_eq_bot
        (Z := unipotentSubgroup K σ) (U := (borelSubgroup K σ).normalCore)
        Subgroup.le_normalizer_of_normal
        ((borelSubgroup K σ).normalCore_le.trans (borelSubgroup_le_normalizer_unipotentSubgroup hσ))
        (inf_comm (unipotentSubgroup K σ) _ ▸ normalCore_borelSubgroup_inf_unipotentSubgroup_eq_bot)
    have htop : Subgroup.centralizer ((borelSubgroup K σ).normalCore :
        Set ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) = ⊤ :=
      top_le_iff.mp (normalClosure_unipotentSubgroup_eq_top hσ hadm ▸
        Subgroup.normalClosure_le_normal hUC)
    intro z hz
    refine Subgroup.mem_center_iff.mpr fun g ↦ ?_
    have hzg : g ∈ Subgroup.centralizer ((borelSubgroup K σ).normalCore :
        Set ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) := by
      rw [htop]
      exact Subgroup.mem_top g
    exact (Subgroup.mem_centralizer_iff.mp hzg z hz).symm
  · obtain ⟨d, hd0, hd⟩ := hadm
    let u := unipotentHom K σ (HeisenbergGroup.unitaryMk σ hσ 0 d (by simpa using hd))
    have hcomm : g * u = u * g := (Subgroup.mem_center_iff.mp hg u).symm
    have hmul : toMat g 2 0 * d = 0 := by
      have h22 := congrArg (fun m ↦ toMat m 2 2) hcomm
      simpa [u, toMat_mul, toMat_unipotentHom, HeisenbergGroup.toMatrix_apply,
        Matrix.mul_apply, Fin.sum_univ_three] using h22
    exact mem_borelSubgroup_iff.mpr ((mul_eq_zero.mp hmul).resolve_right hd0)

/-! ### Commutator generation, perfectness, and simplicity -/

private theorem unipotentHom_unitaryMk_zero_mem_commutator (hσ : Function.Involutive σ)
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s) {z₀ : K} (hz₀ : z₀ + σ z₀ = 0) :
    unipotentHom K σ (HeisenbergGroup.unitaryMk σ hσ 0 z₀ (by simpa using hz₀)) ∈
      commutator
        ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) := by
  obtain ⟨t₁, ht₁⟩ := htr 1 (map_one σ)
  let x₂ : K := -z₀ * σ t₁
  obtain ⟨t₂, ht₂⟩ := htr (x₂ * σ x₂) (by simp only [map_mul, hσ x₂]; ring)
  let a₁ := HeisenbergGroup.unitaryMk σ hσ 1 t₁ (by simpa using ht₁)
  let a₂ := HeisenbergGroup.unitaryMk σ hσ x₂ t₂ ht₂
  have hcomm : ⁅a₁, a₂⁆ = HeisenbergGroup.unitaryMk σ hσ 0 z₀ (by simpa using hz₀) := by
    rw [HeisenbergGroup.commutatorElement_unitaryMk, HeisenbergGroup.unitaryMk_inj]
    refine ⟨rfl, ?_⟩
    simp only [x₂, map_neg, map_mul, map_one, hσ t₁]
    linear_combination z₀ * ht₁ - t₁ * hz₀
  rw [← hcomm, map_commutatorElement]
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)

private theorem exists_unipotentHom_mem_commutator_x_eq (hσ : Function.Involutive σ)
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s)
    (hunit : ∃ a : K, a ≠ 0 ∧ a ^ 2 ≠ σ a) (x : K) :
    ∃ b : HeisenbergGroup.unitarySubgroup σ, (b : HeisenbergGroup K).x = x ∧
      unipotentHom K σ b ∈
        commutator
          ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) := by
  obtain ⟨a, ha0, ha⟩ := hunit
  have hσa : σ a ≠ 0 := (map_ne_zero σ).mpr ha0
  let c : K := a ^ 2 * (σ a)⁻¹ - 1
  have hc0 : c ≠ 0 := by
    intro hc
    apply ha
    have h1 : a ^ 2 * (σ a)⁻¹ = 1 := sub_eq_zero.mp hc
    calc a ^ 2 = a ^ 2 * (σ a)⁻¹ * σ a := (inv_mul_cancel_right₀ hσa (a ^ 2)).symm
      _ = σ a := by rw [h1, one_mul]
  let x₁ : K := c⁻¹ * x
  obtain ⟨z₁, hz₁⟩ := htr (x₁ * σ x₁) (by simp only [map_mul, hσ x₁]; ring)
  let u₁ := HeisenbergGroup.unitaryMk σ hσ x₁ z₁ hz₁
  let t : Kˣ := Units.mk0 a ha0
  have hconj := torus_mul_unipotentHom_unitaryMk_mul_inv hσ t x₁ z₁ hz₁
  set u₂ := HeisenbergGroup.unitaryMk σ hσ ((t : K) ^ 2 * σ ((t⁻¹ : Kˣ) : K) * x₁)
    ((t : K) * σ (t : K) * z₁) _
  refine ⟨u₂ * u₁⁻¹, ?_, ?_⟩
  · simp only [u₂, u₁, t, HeisenbergGroup.unitarySubgroup.coe_mul,
      HeisenbergGroup.unitarySubgroup.coe_inv, HeisenbergGroup.coe_unitaryMk,
      Units.val_mk0, Units.val_inv_eq_inv_val, map_inv₀]
    calc a ^ 2 * (σ a)⁻¹ * x₁ + -x₁ = c * x₁ := by simp only [c]; ring
      _ = x := mul_inv_cancel_left₀ hc0 x
  · have hb_eq : unipotentHom K σ (u₂ * u₁⁻¹) = ⁅torus K σ hσ t, unipotentHom K σ u₁⁆ := by
      rw [commutatorElement_def, hconj, ← map_inv, ← map_mul]
    rw [hb_eq]
    exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)

/-- Every element of `unipotentSubgroup K σ` is a product of commutators whenever the trace
`t ↦ t + σ t` is surjective onto `σ`-fixed elements and `K` has a nonzero `a` with `a ^ 2 ≠ σ a`. -/
theorem unipotentSubgroup_le_commutator (hσ : Function.Involutive σ)
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s)
    (hunit : ∃ a : K, a ≠ 0 ∧ a ^ 2 ≠ σ a) :
    unipotentSubgroup K σ ≤
      commutator
        ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) := by
  intro g hg
  rw [unipotentSubgroup_def] at hg
  obtain ⟨a₀, rfl⟩ := hg
  obtain ⟨b₁, hb₁_x, hb₁_mem⟩ :=
    exists_unipotentHom_mem_commutator_x_eq hσ htr hunit (a₀ : HeisenbergGroup K).x
  let b₀ : HeisenbergGroup.unitarySubgroup σ := b₁⁻¹ * a₀
  have hb₀_x : (b₀ : HeisenbergGroup K).x = 0 := by
    simp [b₀, hb₁_x]
  have hb₀_z : (b₀ : HeisenbergGroup K).z + σ (b₀ : HeisenbergGroup K).z = 0 := by
    have hz := HeisenbergGroup.unitarySubgroup.z_add_map_z b₀
    simpa [hb₀_x] using hz
  have hb₀_eq : b₀ = HeisenbergGroup.unitaryMk σ hσ 0 (b₀ : HeisenbergGroup K).z
      (by simpa using hb₀_z) := by
    apply HeisenbergGroup.unitarySubgroup.ext
    · simpa using hb₀_x
    · simp
  have hb₀_mem : unipotentHom K σ b₀ ∈
      commutator
        ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) := by
    rw [hb₀_eq]
    exact unipotentHom_unitaryMk_zero_mem_commutator hσ htr hb₀_z
  rw [← mul_inv_cancel_left b₁ a₀, map_mul]
  exact mul_mem hb₁_mem hb₀_mem

/-- **Perfectness of the rank-one unitary group**: under an involution `σ`, a nonzero skew-trace
element `d + σ d = 0`, surjective trace onto `σ`-fixed elements, and a unit `a` with `a ^ 2 ≠ σ a`,
the rank-one special isometry group is perfect. -/
theorem commutator_eq_top (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0)
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s)
    (hunit : ∃ a : K, a ≠ 0 ∧ a ^ 2 ≠ σ a) :
    commutator ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) =
      ⊤ :=
  top_le_iff.mp (normalClosure_unipotentSubgroup_eq_top hσ hadm ▸
    Subgroup.normalClosure_le_normal (unipotentSubgroup_le_commutator hσ htr hunit))

/-- **Simplicity of the projective rank-one unitary group**: under the hypotheses of
`commutator_eq_top`, the quotient of the rank-one special isometry group by its centre is a simple
group. -/
theorem isSimpleGroup_quotient_center (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0)
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s)
    (hunit : ∃ a : K, a ≠ 0 ∧ a ^ 2 ≠ σ a) :
    IsSimpleGroup
      ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ ⧸
        Subgroup.center
          ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) := by
  have : Group.IsPerfect
      ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) :=
    ⟨commutator_eq_top hσ hadm htr hunit⟩
  have hS : (titsSystem K σ hσ).simple.Nonempty := by
    rw [titsSystem_simple]
    exact Set.singleton_nonempty _
  have hsimple := (titsSystem K σ hσ).isSimpleGroup_quotient_normalCore hS
    (isIrreducible_titsSystem hσ)
    (U := unipotentSubgroup K σ)
    (by rw [titsSystem_subgroupB]; exact borelSubgroup_le_normalizer_unipotentSubgroup hσ)
    (normalClosure_unipotentSubgroup_eq_top hσ hadm)
  have heq : (titsSystem K σ hσ).subgroupB.normalCore = Subgroup.center _ := by
    rw [titsSystem_subgroupB]
    exact normalCore_borelSubgroup_eq_center hσ hadm
  exact (QuotientGroup.quotientMulEquivOfEq heq).symm.isSimpleGroup

/-- **Simplicity of the derived central quotient** of the rank-one unitary group under the
hypotheses of `commutator_eq_top`. -/
theorem isSimpleGroup_derivedCentralQuotient (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0)
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s)
    (hunit : ∃ a : K, a ≠ 0 ∧ a ^ 2 ≠ σ a) :
    IsSimpleGroup (DerivedCentralQuotient
      ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) := by
  have : Group.IsPerfect
      ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) :=
    ⟨commutator_eq_top hσ hadm htr hunit⟩
  have := isSimpleGroup_quotient_center hσ hadm htr hunit
  exact DerivedCentralQuotient.mulEquivQuotientCenter.isSimpleGroup

end TauCeti.UnitaryRankOne
