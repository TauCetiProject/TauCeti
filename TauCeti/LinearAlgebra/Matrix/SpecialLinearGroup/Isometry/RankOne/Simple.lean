namespace TauCeti.UnitaryRankOne

/-! ### Rank-one matrix factorization over a commutative ring -/

section CommRing

variable {R : Type*} [CommRing R] {σ : R →+* R}

/-- Every product `weyl * torus z` for root parameters `(x, z)` with `z : Rˣ` and
`z + σ z = x * σ x` factors as a product of two upper-unitriangular root elements and one
`weyl`-conjugated root element. -/
theorem weyl_mul_torus_eq (hσ : Function.Involutive σ) {x : R} {z : Rˣ}
    (hz : (z : R) + σ (z : R) = x * σ x) :
    weyl R σ * torus R σ hσ z =
      unipotentHom R σ (HeisenbergGroup.unitaryMk σ hσ (x * σ ((z⁻¹ : Rˣ) : R))
          (σ ((z⁻¹ : Rˣ) : R)) (by
            have h1 : (z : R) * ((z⁻¹ : Rˣ) : R) = 1 := z.mul_inv
            have h2 : σ (z : R) * σ ((z⁻¹ : Rˣ) : R) = 1 := by
              rw [← map_mul, h1, map_one]
            simp only [map_mul, hσ ((z⁻¹ : Rˣ) : R)]
            linear_combination ((z⁻¹ : Rˣ) : R) * σ ((z⁻¹ : Rˣ) : R) * hz -
              σ ((z⁻¹ : Rˣ) : R) * h1 - ((z⁻¹ : Rˣ) : R) * h2)) *
        (weyl R σ * unipotentHom R σ (HeisenbergGroup.unitaryMk σ hσ x (z : R) hz) * weyl R σ) *
        unipotentHom R σ (HeisenbergGroup.unitaryMk σ hσ (x * ((z⁻¹ : Rˣ) : R))
          (σ ((z⁻¹ : Rˣ) : R)) (by
            have h1 : (z : R) * ((z⁻¹ : Rˣ) : R) = 1 := z.mul_inv
            have h2 : σ (z : R) * σ ((z⁻¹ : Rˣ) : R) = 1 := by
              rw [← map_mul, h1, map_one]
            simp only [map_mul, hσ ((z⁻¹ : Rˣ) : R)]
            linear_combination ((z⁻¹ : Rˣ) : R) * σ ((z⁻¹ : Rˣ) : R) * hz -
              σ ((z⁻¹ : Rˣ) : R) * h1 - ((z⁻¹ : Rˣ) : R) * h2)) := by
  symm
  have hz1 : (z : R) * ((z⁻¹ : Rˣ) : R) = 1 := z.mul_inv
  have hσz1 : σ (z : R) * σ ((z⁻¹ : Rˣ) : R) = 1 := by
    rw [← map_mul, hz1, map_one]
  set L := weyl R σ * unipotentHom R σ (HeisenbergGroup.unitaryMk σ hσ x (z : R) hz) * weyl R σ
  have hL : ((L : Matrix.SpecialLinearGroup (Fin 3) R) : Matrix (Fin 3) (Fin 3) R) =
      !![1, 0, 0; -σ x, 1, 0; (z : R), -x, 1] := by
    simpa [L] using coe_weyl_mul_unipotentHom_mul_weyl
      (HeisenbergGroup.unitaryMk σ hσ x (z : R) hz)
  apply Subtype.ext
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  simp only [Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, hL, coe_unipotentHom,
    HeisenbergGroup.coe_toSpecialLinear, coe_weyl, coe_torus, HeisenbergGroup.coe_unitaryMk,
    Matrix.mul_apply, Fin.sum_univ_three]
  fin_cases i <;> fin_cases j <;>
    simp [HeisenbergGroup.toMatrix_apply, hσ ((z⁻¹ : Rˣ) : R)]
  · linear_combination σ ((z⁻¹ : Rˣ) : R) * hz - hσz1
  · linear_combination x * ((z⁻¹ : Rˣ) : R) * σ ((z⁻¹ : Rˣ) : R) * hz -
      x * ((z⁻¹ : Rˣ) : R) * hσz1
  · linear_combination σ ((z⁻¹ : Rˣ) : R) ^ 2 * hz - σ ((z⁻¹ : Rˣ) : R) * hσz1
  · linear_combination ((z⁻¹ : Rˣ) : R) * hz - hz1
  · linear_combination σ x * ((z⁻¹ : Rˣ) : R) * σ ((z⁻¹ : Rˣ) : R) * hz -
      σ x * ((z⁻¹ : Rˣ) : R) * hσz1 - σ x * σ ((z⁻¹ : Rˣ) : R) * hz1
  · linear_combination x * hz1
  · linear_combination σ ((z⁻¹ : Rˣ) : R) * hz - hσz1

end CommRing

/-! ### Normal generation by the unipotent subgroup -/

section Field

variable {K : Type*} [Field K] {σ : K →+* K}

private theorem weyl_mul_torus_mem_normalClosure (hσ : Function.Involutive σ) {x : K} {z : Kˣ}
    (hz : (z : K) + σ (z : K) = x * σ x) :
    weyl K σ * torus K σ hσ z ∈ Subgroup.normalClosure (unipotentSubgroup K σ : Set _) := by
  rw [weyl_mul_torus_eq hσ hz]
  refine mul_mem (mul_mem (Subgroup.subset_normalClosure (unipotentHom_mem_unipotentSubgroup _))
    ?_) (Subgroup.subset_normalClosure (unipotentHom_mem_unipotentSubgroup _))
  have hconj :=
    (inferInstance : (Subgroup.normalClosure (unipotentSubgroup K σ : Set _)).Normal).conj_mem _
      (Subgroup.subset_normalClosure (unipotentHom_mem_unipotentSubgroup
        (HeisenbergGroup.unitaryMk σ hσ x (z : K) hz))) (weyl K σ)
  rwa [weyl_inv] at hconj

private theorem torus_mem_normalClosure_of_mul_add_map_eq (hσ : Function.Involutive σ)
    {d : K} (hd0 : d ≠ 0) (hd : d + σ d = 0) {u : Kˣ} {x : K}
    (h : (u : K) * d + σ ((u : K) * d) = x * σ x) :
    torus K σ hσ u ∈ Subgroup.normalClosure (unipotentSubgroup K σ : Set _) := by
  let d₀ : Kˣ := Units.mk0 d hd0
  have hg₁ := weyl_mul_torus_mem_normalClosure hσ (x := 0) (z := d₀) (by simpa [d₀] using hd)
  have hg₂ := weyl_mul_torus_mem_normalClosure hσ (x := x) (z := u * d₀) (by simpa [d₀] using h)
  have hmul : (weyl K σ * torus K σ hσ d₀)⁻¹ * (weyl K σ * torus K σ hσ (u * d₀)) =
      torus K σ hσ u := by
    rw [_root_.mul_inv_rev, weyl_inv, mul_assoc, ← mul_assoc (weyl K σ), weyl_mul_self, one_mul,
      ← map_inv, ← map_mul, mul_comm u d₀, inv_mul_cancel_left]
  exact hmul ▸ mul_mem (inv_mem hg₁) hg₂

private theorem torus_mem_normalClosure_of_map_eq (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0) {s : Kˣ} (hs : σ (s : K) = (s : K)) :
    torus K σ hσ s ∈ Subgroup.normalClosure (unipotentSubgroup K σ : Set _) := by
  obtain ⟨d, hd0, hd⟩ := hadm
  exact torus_mem_normalClosure_of_mul_add_map_eq hσ hd0 hd (x := 0)
    (by simp only [map_mul, hs, map_zero, mul_zero]; linear_combination (s : K) * hd)

private theorem torus_mem_normalClosure (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0) (t : Kˣ) :
    torus K σ hσ t ∈ Subgroup.normalClosure (unipotentSubgroup K σ : Set _) := by
  by_cases ht : σ (t : K) = (t : K)
  · exact torus_mem_normalClosure_of_map_eq hσ hadm ht
  · obtain ⟨d, hd0, hd⟩ := hadm
    set s : K := d * ((t : K) - σ (t : K)) with hs
    have hs0 : s ≠ 0 := mul_ne_zero hd0 (sub_ne_zero.mpr (Ne.symm ht))
    have hσs : σ s = s := by
      simp only [hs, map_mul, map_sub, hσ (t : K)]
      linear_combination -((t : K) - σ (t : K)) * hd
    have hst : torus K σ hσ (Units.mk0 s hs0 * t) ∈
        Subgroup.normalClosure (unipotentSubgroup K σ : Set _) :=
      torus_mem_normalClosure_of_mul_add_map_eq hσ hd0 hd (x := s) (by
        simp only [Units.val_mul, Units.val_mk0, map_mul, hσs]
        linear_combination s * σ (t : K) * hd - s * hs)
    have hs_mem := torus_mem_normalClosure_of_map_eq hσ ⟨d, hd0, hd⟩ (s := Units.mk0 s hs0) hσs
    rw [map_mul] at hst
    simpa only [inv_mul_cancel_left] using mul_mem (inv_mem hs_mem) hst

/-- **Normal generation by the unipotent subgroup**: when `σ` is involutive and `K` has a nonzero
element `d` with `d + σ d = 0`, the conjugates of `unipotentSubgroup K σ` generate the entire
rank-one special isometry group. -/
theorem normalClosure_unipotentSubgroup_eq_top (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0) :
    Subgroup.normalClosure (unipotentSubgroup K σ :
      Set ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) = ⊤ := by
  have hB : borelSubgroup K σ ≤ Subgroup.normalClosure (unipotentSubgroup K σ :
      Set ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) := by
    rw [borelSubgroup_eq_sup hσ]
    refine sup_le ?_ Subgroup.le_normalClosure
    rintro _ ⟨t, rfl⟩
    exact torus_mem_normalClosure hσ hadm t
  obtain ⟨d, hd0, hd⟩ := hadm
  have hw : weyl K σ ∈ Subgroup.normalClosure (unipotentSubgroup K σ :
      Set ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) := by
    have hwd := weyl_mul_torus_mem_normalClosure hσ (x := 0) (z := Units.mk0 d hd0)
      (by simpa using hd)
    have hd_mem := torus_mem_normalClosure hσ ⟨d, hd0, hd⟩ (Units.mk0 d hd0)
    simpa only [mul_inv_cancel_right] using mul_mem hwd (inv_mem hd_mem)
  rw [eq_top_iff]
  intro g _
  rcases mem_borelSubgroup_or_mem_doubleCoset hσ g with hg | hg
  · exact hB hg
  · obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
    exact mul_mem (mul_mem (hB hb₁) hw) (hB hb₂)

/-! ### The normal core of the Borel subgroup -/

/-- The normal core of the Borel subgroup intersects the unipotent subgroup trivially. -/
theorem normalCore_borelSubgroup_inf_unipotentSubgroup_eq_bot :
    (borelSubgroup K σ).normalCore ⊓ unipotentSubgroup K σ = ⊥ := by
  rw [unipotentSubgroup_def, eq_bot_iff]
  rintro g ⟨hgN, a, rfl⟩
  have hconj : weyl K σ * unipotentHom K σ a * (weyl K σ)⁻¹ ∈ borelSubgroup K σ :=
    (borelSubgroup K σ).normalCore_le
      ((inferInstance : (borelSubgroup K σ).normalCore.Normal).conj_mem _ hgN (weyl K σ))
  rw [weyl_inv, weyl_mul_unipotentHom_mul_weyl_mem_borelSubgroup_iff] at hconj
  simp [hconj]

/-- **The normal core of the Borel subgroup is the centre** of the rank-one special isometry group
whenever `σ` is involutive and `∃ d ≠ 0, d + σ d = 0`. -/
theorem normalCore_borelSubgroup_eq_center (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0) :
    (borelSubgroup K σ).normalCore = Subgroup.center _ := by
  refine le_antisymm ?_ (Subgroup.normal_le_normalCore.mpr fun g hg ↦ ?_)
  · have hUC : unipotentSubgroup K σ ≤ Subgroup.centralizer ((borelSubgroup K σ).normalCore :
        Set ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) :=
      le_centralizer_of_le_normalizer_of_inf_eq_bot
        (Z := unipotentSubgroup K σ) (U := (borelSubgroup K σ).normalCore)
        Subgroup.le_normalizer_of_normal
        ((borelSubgroup K σ).normalCore_le.trans (borelSubgroup_le_normalizer_unipotentSubgroup hσ))
        (inf_comm (unipotentSubgroup K σ) _ ▸ normalCore_borelSubgroup_inf_unipotentSubgroup_eq_bot)
    have htop : Subgroup.centralizer ((borelSubgroup K σ).normalCore :
        Set ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) = ⊤ :=
      top_le_iff.mp (normalClosure_unipotentSubgroup_eq_top hσ hadm ▸
        Subgroup.normalClosure_le_normal hUC)
    exact Subgroup.centralizer_eq_top_iff_subset.mp htop
  · obtain ⟨d, hd0, hd⟩ := hadm
    let u := unipotentHom K σ (HeisenbergGroup.unitaryMk σ hσ 0 d (by simpa using hd))
    have hcomm : g * u = u * g := (Subgroup.mem_center_iff.mp hg u).symm
    have hmul :
        ((g : Matrix.SpecialLinearGroup (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) 2 0 * d = 0 := by
      have h22 := congrArg (fun m :
          (typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ ↦
        ((m : Matrix.SpecialLinearGroup (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) 2 2) hcomm
      simpa [u, Subgroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, coe_unipotentHom,
        HeisenbergGroup.coe_toSpecialLinear, HeisenbergGroup.toMatrix_apply,
        Matrix.mul_apply, Fin.sum_univ_three] using h22
    exact mem_borelSubgroup_iff.mpr ((mul_eq_zero.mp hmul).resolve_right hd0)

/-! ### Commutator generation, perfectness, and simplicity -/

private theorem unipotentHom_unitaryMk_zero_mem_commutator (hσ : Function.Involutive σ)
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s) {z₀ : K} (hz₀ : z₀ + σ z₀ = 0) :
    unipotentHom K σ (HeisenbergGroup.unitaryMk σ hσ 0 z₀ (by simpa using hz₀)) ∈
      commutator
        ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) := by
  obtain ⟨t₁, ht₁⟩ := htr 1 (map_one σ)
  let x₂ : K := -z₀ * σ t₁
  obtain ⟨t₂, ht₂⟩ := htr (x₂ * σ x₂) (by simp only [map_mul, hσ x₂]; ring)
  let a₁ := HeisenbergGroup.unitaryMk σ hσ 1 t₁ (by simpa using ht₁)
  let a₂ := HeisenbergGroup.unitaryMk σ hσ x₂ t₂ ht₂
  have hcomm : ⁅a₁, a₂⁆ = HeisenbergGroup.unitaryMk σ hσ 0 z₀ (by simpa using hz₀) := by
    rw [HeisenbergGroup.commutatorElement_unitaryMk, HeisenbergGroup.unitaryMk_inj]
    refine ⟨rfl, ?_⟩
    simp only [x₂, map_neg, map_mul, map_one, hσ t₁]
    linear_combination z₀ * ht₁ - t₁ * hz₀
  rw [← hcomm, map_commutatorElement]
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)

private theorem exists_unipotentHom_mem_commutator_x_eq (hσ : Function.Involutive σ)
    (htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s)
    (hunit : ∃ a : K, a ≠ 0 ∧ a ^ 2 ≠ σ a) (x : K) :
    ∃ b : HeisenbergGroup.unitarySubgroup σ, (b : HeisenbergGroup K).x = x ∧
      unipotentHom K σ b ∈
        commutator
          ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) := by
  obtain ⟨a, ha0, ha⟩ := hunit
  have hσa : σ a ≠ 0 := (map_ne_zero σ).mpr ha0
  let c : K := a ^ 2 * (σ a)⁻¹ - 1
  have hc0 : c ≠ 0 := by
    intro hc
    apply ha
    have h1 : a ^ 2 * (σ a)⁻¹ = 1 := sub_eq_zero.mp hc
    calc a ^ 2 = a ^ 2 * (σ a)⁻¹ * σ a := (inv_mul_cancel_right₀ hσa (a ^ 2)).symm
      _ = σ a := by rw [h1, one_mul]
  let x₁ : K := c⁻¹ * x
  obtain ⟨z₁, hz₁⟩ := htr (x₁ * σ x₁) (by simp only [map_mul, hσ x₁]; ring)
  let u₁ := HeisenbergGroup.unitaryMk σ hσ x₁ z₁ hz₁
  let t : Kˣ := Units.mk0 a ha0
  have hconj := torus_mul_unipotentHom_unitaryMk_mul_inv hσ t x₁ z₁ hz₁
  set u₂ := HeisenbergGroup.unitaryMk σ hσ ((t : K) ^ 2 * σ ((t⁻¹ : Kˣ) : K) * x₁)
    ((t : K) * σ (t : K) * z₁) _
  refine ⟨u₂ * u₁⁻¹, ?_, ?_⟩
  · simp only [u₂, u₁, t, HeisenbergGroup.unitarySubgroup.coe_mul,
      HeisenbergGroup.unitarySubgroup.coe_inv, HeisenbergGroup.coe_unitaryMk,
      Units.val_mk0, Units.val_inv_eq_inv_val, map_inv₀]
    calc a ^ 2 * (σ a)⁻¹ * x₁ + -x₁ = c * x₁ := by simp only [c]; ring
      _ = x := mul_inv_cancel_left₀ hc0 x
  · have hb_eq : unipotentHom K σ (u₂ * u₁⁻¹) = ⁅torus K σ hσ t, unipotentHom K σ u₁⁆ := by
      rw [commutatorElement_def, hconj, ← map_inv, ← map_mul]
    rw [hb_eq]
    exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)

/-- Every element of `unipotentSubgroup K σ` is a product of commutators whenever `σ` is involutive
and `K` has a nonzero `a` with `a ^ 2 ≠ σ a`. -/
theorem unipotentSubgroup_le_commutator (hσ : Function.Involutive σ)
    (hunit : ∃ a : K, a ≠ 0 ∧ a ^ 2 ≠ σ a) :
    unipotentSubgroup K σ ≤
      commutator
        ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) := by
  by_cases htr0 : ∃ y : K, y + σ y ≠ 0
  · obtain ⟨y, hy⟩ := htr0
    have htr : ∀ s : K, σ s = s → ∃ t : K, t + σ t = s := fun s hs ↦ by
      refine ⟨s * (y + σ y)⁻¹ * y, ?_⟩
      have hσy : σ (y + σ y) = y + σ y := by
        rw [map_add, hσ y, add_comm]
      have hinv : (y + σ y)⁻¹ * (y + σ y) = 1 := inv_mul_cancel₀ hy
      simp only [map_mul, map_inv₀, hs, hσy]
      linear_combination s * hinv
    intro g hg
    rw [unipotentSubgroup_def] at hg
    obtain ⟨a₀, rfl⟩ := hg
    obtain ⟨b₁, hb₁_x, hb₁_mem⟩ :=
      exists_unipotentHom_mem_commutator_x_eq hσ htr hunit (a₀ : HeisenbergGroup K).x
    let b₀ : HeisenbergGroup.unitarySubgroup σ := b₁⁻¹ * a₀
    have hb₀_x : (b₀ : HeisenbergGroup K).x = 0 := by
      simp [b₀, hb₁_x]
    have hb₀_z : (b₀ : HeisenbergGroup K).z + σ (b₀ : HeisenbergGroup K).z = 0 := by
      have hz := HeisenbergGroup.unitarySubgroup.z_add_map_z b₀
      simpa [hb₀_x] using hz
    have hb₀_eq : b₀ = HeisenbergGroup.unitaryMk σ hσ 0 (b₀ : HeisenbergGroup K).z
        (by simpa using hb₀_z) := by
      apply HeisenbergGroup.unitarySubgroup.ext
      · simpa using hb₀_x
      · simp
    have hb₀_mem : unipotentHom K σ b₀ ∈
        commutator
          ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) := by
      rw [hb₀_eq]
      exact unipotentHom_unitaryMk_zero_mem_commutator hσ htr hb₀_z
    rw [← mul_inv_cancel_left b₁ a₀, map_mul]
    exact mul_mem hb₁_mem hb₀_mem
  · push Not at htr0
    have h1 : (1 : K) + 1 = 0 := by simpa using htr0 1
    have hσ_id : ∀ y : K, σ y = y := fun y ↦ by
      have hy := htr0 y
      linear_combination hy - y * h1
    obtain ⟨a, ha0, ha⟩ := hunit
    have ha1 : a ^ 2 + 1 ≠ 0 := fun hc ↦ ha <| by
      have hsq : (a + 1) ^ 2 = 0 := by linear_combination hc + a * h1
      have ha_eq : a = 1 := by linear_combination eq_zero_of_pow_eq_zero hsq - h1
      rw [ha_eq, one_pow, map_one]
    rw [unipotentSubgroup_def]
    rintro _ ⟨a₀, rfl⟩
    have hx₀ : (a₀ : HeisenbergGroup K).x = 0 := by
      have hz := HeisenbergGroup.unitarySubgroup.z_add_map_z a₀
      rw [htr0, hσ_id] at hz
      exact mul_self_eq_zero.mp hz.symm
    let z₁ : K := (a ^ 2 + 1)⁻¹ * (a₀ : HeisenbergGroup K).z
    have hz₁ : z₁ + σ z₁ = 0 * σ 0 := by simp [htr0 z₁]
    let u₁ := HeisenbergGroup.unitaryMk σ hσ 0 z₁ hz₁
    let t : Kˣ := Units.mk0 a ha0
    have hconj := torus_mul_unipotentHom_unitaryMk_mul_inv hσ t 0 z₁ hz₁
    set u₂ := HeisenbergGroup.unitaryMk σ hσ ((t : K) ^ 2 * σ ((t⁻¹ : Kˣ) : K) * 0)
      ((t : K) * σ (t : K) * z₁) _
    have ha₀_eq : u₂ * u₁⁻¹ = a₀ := by
      apply HeisenbergGroup.unitarySubgroup.ext
      · simp [u₂, u₁, hx₀]
      · simp only [u₂, u₁, t, HeisenbergGroup.unitarySubgroup.coe_mul,
          HeisenbergGroup.unitarySubgroup.coe_inv, HeisenbergGroup.coe_unitaryMk,
          Units.val_mk0, hσ_id a, hσ_id z₁, mul_zero, zero_mul, zero_add, add_zero]
        calc a * a * z₁ + z₁ = (a ^ 2 + 1) * z₁ := by ring
          _ = (a₀ : HeisenbergGroup K).z := mul_inv_cancel_left₀ ha1 _
    rw [← ha₀_eq, map_mul, map_inv, ← hconj, ← commutatorElement_def]
    exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)

/-- **Perfectness of the rank-one unitary group**: under an involution `σ`, a nonzero skew-trace
element `d + σ d = 0`, and a nonzero `a` with `a ^ 2 ≠ σ a`, the rank-one special isometry group
is perfect. -/
theorem commutator_eq_top (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0)
    (hunit : ∃ a : K, a ≠ 0 ∧ a ^ 2 ≠ σ a) :
    commutator ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) =
      ⊤ :=
  top_le_iff.mp (normalClosure_unipotentSubgroup_eq_top hσ hadm ▸
    Subgroup.normalClosure_le_normal (unipotentSubgroup_le_commutator hσ hunit))

/-- **Simplicity of the projective rank-one unitary group**: under the hypotheses of
`commutator_eq_top`, the quotient of the rank-one special isometry group by its centre is a simple
group. -/
theorem isSimpleGroup_quotient_center (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0)
    (hunit : ∃ a : K, a ≠ 0 ∧ a ^ 2 ≠ σ a) :
    IsSimpleGroup
      ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ ⧸
        Subgroup.center
          ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) := by
  have : Group.IsPerfect
      ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) :=
    ⟨commutator_eq_top hσ hadm hunit⟩
  have hS : (titsSystem K σ hσ).simple.Nonempty := by
    rw [titsSystem_simple]
    exact Set.singleton_nonempty _
  have hsimple := (titsSystem K σ hσ).isSimpleGroup_quotient_normalCore hS
    (isIrreducible_titsSystem hσ)
    (U := unipotentSubgroup K σ)
    (by rw [titsSystem_subgroupB]; exact borelSubgroup_le_normalizer_unipotentSubgroup hσ)
    (normalClosure_unipotentSubgroup_eq_top hσ hadm)
  have heq : (titsSystem K σ hσ).subgroupB.normalCore = Subgroup.center _ := by
    rw [titsSystem_subgroupB]
    exact normalCore_borelSubgroup_eq_center hσ hadm
  exact (QuotientGroup.quotientMulEquivOfEq heq).symm.isSimpleGroup

/-- **Simplicity of the derived central quotient** of the rank-one unitary group under the
hypotheses of `commutator_eq_top`. -/
theorem isSimpleGroup_derivedCentralQuotient (hσ : Function.Involutive σ)
    (hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0)
    (hunit : ∃ a : K, a ≠ 0 ∧ a ^ 2 ≠ σ a) :
    IsSimpleGroup (DerivedCentralQuotient
      ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) := by
  have : Group.IsPerfect
      ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) :=
    ⟨commutator_eq_top hσ hadm hunit⟩
  have := isSimpleGroup_quotient_center hσ hadm hunit
  exact DerivedCentralQuotient.mulEquivQuotientCenter.isSimpleGroup

/-! ### Finite-field specialization for fields of order `q ^ 2` -/

private theorem involutive_and_exists_of_natCard_eq_sq {q : ℕ} (hq : 3 ≤ q)
    (hK : Nat.card K = q ^ 2) (hσ : ∀ a, σ a = a ^ q) :
    Function.Involutive σ ∧ (∃ d : K, d ≠ 0 ∧ d + σ d = 0) ∧
      (∃ a : K, a ≠ 0 ∧ a ^ 2 ≠ σ a) := by
  have : Finite K := Nat.finite_of_card_ne_zero (by rw [hK]; positivity)
  let _ := Fintype.ofFinite K
  have hσ_inv : Function.Involutive σ := fun a ↦ by
    rw [hσ, hσ, ← pow_mul, ← sq, ← hK, Nat.card_eq_fintype_card]
    exact FiniteField.pow_card a
  obtain ⟨b, -, hb⟩ := TauCeti.FiniteField.exists_ne_zero_pow_ne_pow (F := K) (m := 1) (n := q)
    (by omega) (by
      rw [hK]
      calc q - 1 + 1 = q := by omega
        _ < q ^ 2 := by nlinarith)
  have hne : b ≠ σ b := by rwa [pow_one, ← hσ b] at hb
  have hadm : ∃ d : K, d ≠ 0 ∧ d + σ d = 0 :=
    ⟨b - σ b, sub_ne_zero.mpr hne, by rw [map_sub, hσ_inv b]; ring⟩
  obtain ⟨a, ha0, ha⟩ := TauCeti.FiniteField.exists_ne_zero_pow_ne_pow (F := K) (m := 2) (n := q)
    (by omega) (by
      rw [hK]
      calc q - 2 + 1 < q := by omega
        _ < q ^ 2 := by nlinarith)
  exact ⟨hσ_inv, hadm, a, ha0, by rwa [hσ]⟩

/-- **Over a field of order `q ^ 2` with `3 ≤ q` and `σ a = a ^ q`, the three-dimensional special
unitary group `SU₃(q)` is perfect.** -/
theorem commutator_eq_top_of_natCard_eq_sq {q : ℕ} (hq : 3 ≤ q)
    (hK : Nat.card K = q ^ 2) (hσ : ∀ a, σ a = a ^ q) :
    commutator ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ) =
      ⊤ := by
  obtain ⟨hσ_inv, hadm, hunit⟩ := involutive_and_exists_of_natCard_eq_sq hq hK hσ
  exact commutator_eq_top hσ_inv hadm hunit

/-- **Over a field of order `q ^ 2` with `3 ≤ q` and `σ a = a ^ q`, the projective special unitary
group `PSU₃(q)` is simple.** -/
theorem isSimpleGroup_quotient_center_of_natCard_eq_sq {q : ℕ} (hq : 3 ≤ q)
    (hK : Nat.card K = q ^ 2) (hσ : ∀ a, σ a = a ^ q) :
    IsSimpleGroup
      ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ ⧸
        Subgroup.center
          ((typeAGraphConjugator 2 K : Matrix (Fin 3) (Fin 3) K).specialIsometryGroup σ)) := by
  obtain ⟨hσ_inv, hadm, hunit⟩ := involutive_and_exists_of_natCard_eq_sq hq hK hσ
  exact isSimpleGroup_quotient_center hσ_inv hadm hunit

