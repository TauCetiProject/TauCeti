/-!
# Infinite conjugacy classes in `ℤ² ⋊ G` for `G ≤ SL(2, ℤ)`

Let `ι : G →* SL(2, ℤ)` and form `ℤ² ⋊ G` with `G` acting on column vectors through `ι`
(`TauCeti.slTwoAction`). This file decides when every nontrivial conjugacy class of `ℤ² ⋊ G` is
infinite, the ICC condition of Murray and von Neumann's factor theorem.

An element `(n, g)` with `ι g ≠ 1` has an infinite conjugacy class with no hypothesis on `G`:
conjugating by translations `w ∈ ℤ²` changes `n` by `w - ι g • w`, and `1 - ι g` is a nonzero
integer matrix, so its image is infinite. The conjugacy class of a translation `v ∈ ℤ²` is the
`G`-orbit of `v`, again with no hypothesis on `G`. So for injective `ι`, the group `ℤ² ⋊ G` is ICC
exactly when every nonzero vector of `ℤ²` has an infinite `G`-orbit.

A nonamenable `G` has this property. The stabilizer of a nonzero vector in `SL(2, ℤ)` is
commutative (`Matrix.SpecialLinearGroup.isMulCommutative_stabilizer`), hence amenable, and a
discrete group with a finite orbit and amenable stabilizer is amenable
(`TauCeti.Amenable.of_finite_orbit`). This covers `SL(2, ℤ)` itself, its finite-index subgroups,
and the free subgroups, such as Sanov's subgroup generated by `[[1, 2], [0, 1]]` and
`[[1, 0], [2, 1]]` (`TauCeti.injective_freeGroup_lift_transvection_two`).

## Main statements

* `TauCeti.infinite_setOf_isConj_inl_iff`: the conjugacy class of a translation `v` is infinite
  exactly when its `G`-orbit is.
* `TauCeti.infinite_setOf_isConj_of_right_ne_one`: elements with nontrivial linear part have
  infinite conjugacy classes.
* `TauCeti.forall_infinite_setOf_isConj_iff_of_injective`: for injective `ι`, the group
  `ℤ² ⋊ G` is ICC exactly when every nonzero vector has an infinite orbit.
* `TauCeti.infinite_range_smul_of_not_hasFoelnerSets` and
  `TauCeti.infinite_range_smul_of_not_amenable`: a nonamenable `G` has infinite orbits on nonzero
  vectors.
* `TauCeti.infinite_setOf_isConj_semidirectProduct_of_not_amenable`: `ℤ² ⋊ G` is ICC for
  nonamenable `G`, with the specializations
  `Subgroup.infinite_setOf_isConj_semidirectProduct_of_not_amenable`,
  `Subgroup.infinite_setOf_isConj_semidirectProduct_of_finiteIndex`,
  `TauCeti.infinite_setOf_isConj_semidirectProduct_slTwo` and
  `TauCeti.infinite_setOf_isConj_semidirectProduct_freeGroup` to nonamenable and finite-index
  subgroups of `SL(2, ℤ)`, to `SL(2, ℤ)` itself and to free subgroups of rank at least two.

## References

* C. Anantharaman and S. Popa, *An Introduction to II₁ Factors*, Example 18.1.5 and
  Theorem 18.3.2, where `ℤ² ⋊ F_n` is used as an ICC group.
-/

public section

open Matrix Multiplicative SemidirectProduct
open scoped MatrixGroups IsMulCommutative

namespace TauCeti

section Conjugacy

variable {G : Type*} [Group G] {ι : G →* SL(2, ℤ)}

/-- The conjugacy class of the translation by `v` in `ℤ² ⋊ G` is infinite exactly when the orbit
of `v` under `G` is infinite. -/
theorem infinite_setOf_isConj_inl_iff (v : Fin 2 → ℤ) :
    {y : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] G |
        IsConj (inl (ofAdd v)) y}.Infinite ↔
      (Set.range fun g => ι g • v).Infinite := by
  have hconj : {y : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] G |
      IsConj (inl (ofAdd v)) y} = (fun w => inl (ofAdd w)) '' Set.range fun g => ι g • v := by
    ext y
    simp only [Set.mem_ofPred_eq, isConj_iff, Set.mem_image, Set.mem_range,
      exists_exists_eq_and]
    constructor
    · rintro ⟨c, rfl⟩
      refine ⟨c.right, ?_⟩
      rw [mul_inl_mul_inv]
      exact congrArg inl (toAdd.injective (by simp [slTwoAction_apply]))
    · rintro ⟨g, rfl⟩
      refine ⟨inr g, ?_⟩
      rw [mul_inl_mul_inv]
      exact congrArg inl (toAdd.injective (by simp [slTwoAction_apply]))
  rw [hconj, Set.infinite_image_iff fun _ _ _ _ h => ofAdd.injective (inl_injective h)]

/-- An element of `ℤ² ⋊ G` whose linear part acts nontrivially on `ℤ²` has an infinite conjugacy
class: conjugating by translations already produces infinitely many conjugates. -/
theorem infinite_setOf_isConj_of_right_ne_one
    {x : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] G} (hx : ι x.right ≠ 1) :
    {y | IsConj x y}.Infinite := by
  obtain ⟨u, hu⟩ : ∃ u : Fin 2 → ℤ, ι x.right • u ≠ u := by
    by_contra! h
    exact hx (SpecialLinearGroup.toLin'_injective (LinearEquiv.ext fun u => by
      simpa [SpecialLinearGroup.toLin'_apply, SpecialLinearGroup.smul_def] using h u))
  have hd : u - ι x.right • u ≠ 0 := sub_ne_zero.2 hu.symm
  let f : ℤ → Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] G :=
    fun k => inl (ofAdd (k • u)) * x * (inl (ofAdd (k • u)))⁻¹
  have hleft (k : ℤ) : toAdd (f k).left = toAdd x.left + k • (u - ι x.right • u) := by
    simp only [f, mul_left, inv_left, left_inl, right_inl, mul_right, inv_one, map_one,
      MulAut.one_apply, toAdd_mul, toAdd_inv, MonoidHom.comp_apply, slTwoAction_apply, toAdd_ofAdd,
      map_inv]
    rw [one_mul, smul_comm (ι x.right) k u, smul_sub]
    abel
  refine Set.infinite_of_injective_forall_mem (f := f) (fun k l hkl => ?_)
    (fun k => isConj_iff.2 ⟨_, rfl⟩)
  have := congrArg (fun y => toAdd y.left) hkl
  simp only [hleft, add_right_inj] at this
  exact smul_left_injective ℤ hd this

/-- For injective `ι`, every nontrivial conjugacy class of `ℤ² ⋊ G` is infinite exactly when every
nonzero vector of `ℤ²` has an infinite `G`-orbit. -/
theorem forall_infinite_setOf_isConj_iff_of_injective (hι : Function.Injective ι) :
    (∀ x : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] G, x ≠ 1 →
        {y | IsConj x y}.Infinite) ↔
      ∀ v : Fin 2 → ℤ, v ≠ 0 → (Set.range fun g => ι g • v).Infinite := by
  refine ⟨fun h v hv => (infinite_setOf_isConj_inl_iff v).1 (h _ ?_), fun h x hx => ?_⟩
  · rwa [ne_eq, map_eq_one_iff _ inl_injective, ← toAdd_eq_zero, toAdd_ofAdd]
  · by_cases hr : x.right = 1
    · rw [← inl_left_mul_inr_right x, hr, map_one, mul_one] at hx ⊢
      rw [← ofAdd_toAdd x.left] at hx ⊢
      refine (infinite_setOf_isConj_inl_iff _).2 (h _ fun h0 => hx ?_)
      rw [h0, ofAdd_zero, map_one]
    · exact infinite_setOf_isConj_of_right_ne_one fun h1 => hr (hι (h1.trans (map_one ι).symm))

/-- **Infinite orbits of nonamenable groups on `ℤ²`** (Følner form): if `ι : G →* SL(2, ℤ)` is
injective and `G` has no Følner sets, then every nonzero vector of `ℤ²` has an infinite `G`-orbit.
The stabilizer of a nonzero vector is commutative, so a finite orbit would make `G` amenable. -/
theorem infinite_range_smul_of_not_hasFoelnerSets (hι : Function.Injective ι)
    (hG : ¬ HasFoelnerSets G) {v : Fin 2 → ℤ} (hv : v ≠ 0) :
    (Set.range fun g => ι g • v).Infinite := by
  intro hfin
  let _ : TopologicalSpace G := ⊥
  have : DiscreteTopology G := ⟨rfl⟩
  let _ : MulAction G (Fin 2 → ℤ) := MulAction.compHom _ ι
  have : Finite (MulAction.orbit G v) := hfin.to_subtype
  have : IsMulCommutative (MulAction.stabilizer SL(2, ℤ) v) :=
    Matrix.SpecialLinearGroup.isMulCommutative_stabilizer hv
  have hstab : (MulAction.stabilizer SL(2, ℤ) v).comap ι = MulAction.stabilizer G v :=
    Subgroup.ext fun _ => Iff.rfl
  have : IsMulCommutative (MulAction.stabilizer G v) :=
    hstab ▸ Subgroup.comap_injective_isMulCommutative _ hι
  exact hG (amenable_iff_hasFoelnerSets.1 (Amenable.of_finite_orbit v))

/-- **Infinite orbits of nonamenable groups on `ℤ²`**: if `ι : G →* SL(2, ℤ)` is injective and
`G` is not amenable, then every nonzero vector of `ℤ²` has an infinite `G`-orbit. -/
theorem infinite_range_smul_of_not_amenable [TopologicalSpace G] [IsTopologicalGroup G]
    (hι : Function.Injective ι) (hG : ¬ Amenable G) {v : Fin 2 → ℤ} (hv : v ≠ 0) :
    (Set.range fun g => ι g • v).Infinite :=
  infinite_range_smul_of_not_hasFoelnerSets hι (mt (Amenable.of_hasFoelnerSets (G := G)) hG) hv

/-- **`ℤ² ⋊ G` is ICC for nonamenable `G` embedded in `SL(2, ℤ)`**: if `ι : G →* SL(2, ℤ)` is
injective and `G` is not amenable, then every nontrivial conjugacy class of `ℤ² ⋊ G` is infinite. -/
theorem infinite_setOf_isConj_semidirectProduct_of_not_amenable [TopologicalSpace G]
    [IsTopologicalGroup G]
    (hι : Function.Injective ι) (hG : ¬ Amenable G)
    {x : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] G} (hx : x ≠ 1) :
    {y | IsConj x y}.Infinite :=
  (forall_infinite_setOf_isConj_iff_of_injective hι).2
    (fun _ => infinite_range_smul_of_not_amenable hι hG) x hx

end Conjugacy

/-- For a free group `FreeGroup α` on at least two generators embedded in `SL(2, ℤ)`, for instance
by Sanov's embedding for `α = Fin 2`, every nontrivial conjugacy class of `ℤ² ⋊ FreeGroup α` is
infinite. -/
theorem infinite_setOf_isConj_semidirectProduct_freeGroup {α : Type*} [Nontrivial α]
    {ι : FreeGroup α →* SL(2, ℤ)} (hι : Function.Injective ι)
    {x : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] FreeGroup α} (hx : x ≠ 1) :
    {y | IsConj x y}.Infinite := by
  let _ : TopologicalSpace (FreeGroup α) := ⊥
  have : DiscreteTopology (FreeGroup α) := ⟨rfl⟩
  exact infinite_setOf_isConj_semidirectProduct_of_not_amenable hι not_amenable_freeGroup hx

/-- **`ℤ² ⋊ SL(2, ℤ)` is ICC**: every nontrivial conjugacy class of `ℤ² ⋊ SL(2, ℤ)` is
infinite. -/
theorem infinite_setOf_isConj_semidirectProduct_slTwo
    {x : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction] SL(2, ℤ)} (hx : x ≠ 1) :
    {y | IsConj x y}.Infinite :=
  infinite_setOf_isConj_semidirectProduct_of_not_amenable (ι := MonoidHom.id SL(2, ℤ))
    Function.injective_id not_amenable_slTwo hx

end TauCeti

namespace Subgroup

open TauCeti

/-- **`ℤ² ⋊ G` is ICC for nonamenable subgroups `G ≤ SL(2, ℤ)`**: every nontrivial conjugacy class
of `ℤ² ⋊ G` is infinite. -/
theorem infinite_setOf_isConj_semidirectProduct_of_not_amenable (G : Subgroup SL(2, ℤ))
    (hG : ¬ Amenable G)
    {x : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp G.subtype] G} (hx : x ≠ 1) :
    {y | IsConj x y}.Infinite :=
  TauCeti.infinite_setOf_isConj_semidirectProduct_of_not_amenable G.subtype_injective hG hx

/-- **`ℤ² ⋊ G` is ICC for finite-index subgroups `G ≤ SL(2, ℤ)`**: every nontrivial conjugacy
class of `ℤ² ⋊ G` is infinite. -/
theorem infinite_setOf_isConj_semidirectProduct_of_finiteIndex (G : Subgroup SL(2, ℤ))
    [G.FiniteIndex]
    {x : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp G.subtype] G} (hx : x ≠ 1) :
    {y | IsConj x y}.Infinite :=
  G.infinite_setOf_isConj_semidirectProduct_of_not_amenable
    (fun _ => not_amenable_slTwo (Amenable.of_finiteIndex G)) hx

end Subgroup
