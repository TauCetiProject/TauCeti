/-!
# Structure of `SL(2, ZMod 3)`

The special linear group `SL(2, ZMod 3)` has cardinality `24` and a unique Sylow `2`-subgroup of
order `8`, which is normal of index `3`, isomorphic to the quaternion group `QuaternionGroup 2`,
and equal to the commutator subgroup `commutator SL(2, ZMod 3)`.  In particular `SL(2, ZMod 3)` is
solvable (one of the two small-field exceptions to
`TauCeti.Matrix.SpecialLinearGroup.not_isSolvable_fin_two`), and its centre `{±1}` admits neither a
local complement in the Sylow `2`-subgroup nor a global complement in `SL(2, ZMod 3)`.

By the rank-two Cayley–Hamilton identity `g ^ 2 = (g 0 0 + g 1 1) • g - 1` and the three possible
traces in `ZMod 3`, every element satisfies `g ^ 4 = 1` or `g ^ 6 = 1`, with `g ^ 2 = -1` precisely
at trace zero.  The quaternion subgroup generated by `I = !![0, -1; 1, 0]` and
`J = !![1, 1; 1, -1]` consists of the solutions to `g ^ 4 = 1`, so it is normal and contains every
element commuting with any of its elements of order `4`.

## Main definitions

* `TauCeti.sl2ZModThreeI`, `TauCeti.sl2ZModThreeJ`: explicit generators of order `4` in
  `SL(2, ZMod 3)` satisfying the quaternion relations.
* `TauCeti.sl2ZModThreeQuaternionHom`: the faithful homomorphism
  `QuaternionGroup 2 →* SL(2, ZMod 3)`.
* `TauCeti.sl2ZModThreeQuaternionSubgroup`: its image, the normal quaternion subgroup of order `8`
  and index `3`, with `TauCeti.sl2ZModThreeQuaternionEquiv` its isomorphism with
  `QuaternionGroup 2`.
* `TauCeti.sl2ZModThreeSylowTwo`: `sl2ZModThreeQuaternionSubgroup` packaged as a
  `Sylow 2 SL(2, ZMod 3)`.

## Main results

* `TauCeti.card_specialLinearGroup_fin_two_zmod_three`: `Nat.card SL(2, ZMod 3) = 24`.
* `Matrix.SpecialLinearGroup.pow_four_eq_one_or_pow_six_eq_one`: every element of `SL(2, ZMod 3)`
  satisfies `g ^ 4 = 1` or `g ^ 6 = 1`.
* `TauCeti.mem_sl2ZModThreeQuaternionSubgroup_iff`: an element of `SL(2, ZMod 3)` lies in the
  quaternion subgroup if and only if `g ^ 4 = 1`.
* `TauCeti.commutator_specialLinearGroup_fin_two_zmod_three`: the commutator subgroup of
  `SL(2, ZMod 3)` is `sl2ZModThreeQuaternionSubgroup`.
* `TauCeti.isSolvable_specialLinearGroup_fin_two_zmod_three`: `SL(2, ZMod 3)` is solvable.
* `TauCeti.mem_sl2ZModThreeQuaternionSubgroup_of_commute`: only elements of the quaternion subgroup
  commute with a non-central element of the quaternion subgroup.
* `TauCeti.not_exists_isLocalComplement_center_sl2ZModThreeQuaternionSubgroup` and
  `TauCeti.not_exists_isComplement'_center_specialLinearGroup_fin_two_zmod_three`: the centre of
  `SL(2, ZMod 3)` splits neither locally in `sl2ZModThreeQuaternionSubgroup` nor globally in
  `SL(2, ZMod 3)`.

## References

* D. Gorenstein, *Finite Groups*, 2nd ed., Chelsea, 1980, Theorem 2.8.3.
-/

public section

open Matrix
open scoped MatrixGroups commutatorElement

namespace Matrix.SpecialLinearGroup

/-- An element of `SL(2, ZMod 3)` squares to `-1` if and only if its trace `g 0 0 + g 1 1` is
zero. -/
theorem sq_eq_neg_one_iff_add_diag_eq_zero {g : SL(2, ZMod 3)} :
    g ^ 2 = -1 ↔ g 0 0 + g 1 1 = 0 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  refine ⟨fun hg => ?_, fun hg => ?_⟩
  · have hmat : (g 0 0 + g 1 1) • (g : Matrix (Fin 2) (Fin 2) (ZMod 3)) - 1 = -1 := by
      rw [← coe_sq_eq_trace_smul_sub_one, hg, coe_neg, coe_one]
    have hsmul : (g 0 0 + g 1 1) • (g : Matrix (Fin 2) (Fin 2) (ZMod 3)) = 0 :=
      (sub_eq_iff_eq_add.mp hmat).trans (neg_add_cancel 1)
    exact (smul_eq_zero.mp hsmul).resolve_right g.coe_ne_zero
  · apply Subtype.ext
    rw [coe_sq_eq_trace_smul_sub_one, hg, zero_smul, zero_sub, coe_neg, coe_one]

/-- Every element of `SL(2, ZMod 3)` satisfies `g ^ 4 = 1` or `g ^ 6 = 1`. -/
theorem pow_four_eq_one_or_pow_six_eq_one (g : SL(2, ZMod 3)) :
    g ^ 4 = 1 ∨ g ^ 6 = 1 := by
  have hsq := coe_sq_eq_trace_smul_sub_one g
  have htr : g 0 0 + g 1 1 = 0 ∨ g 0 0 + g 1 1 = 1 ∨ g 0 0 + g 1 1 = -1 := by
    generalize g 0 0 + g 1 1 = t
    decide +revert
  rcases htr with ht | ht | ht
  · left
    have hg2 : g ^ 2 = -1 := sq_eq_neg_one_iff_add_diag_eq_zero.mpr ht
    rw [(by decide : 4 = 2 * 2), pow_mul, hg2, neg_one_sq]
  · right
    have hg3 : g ^ 3 = -1 := by
      apply Subtype.ext
      calc ((g ^ 3 : SL(2, ZMod 3)) : Matrix (Fin 2) (Fin 2) (ZMod 3))
          = ((g ^ 2 : SL(2, ZMod 3)) : Matrix (Fin 2) (Fin 2) (ZMod 3)) * g := by
            rw [pow_succ, coe_mul]
        _ = ((g : Matrix (Fin 2) (Fin 2) (ZMod 3)) - 1) * g := by rw [hsq, ht, one_smul]
        _ = ((g ^ 2 : SL(2, ZMod 3)) : Matrix (Fin 2) (Fin 2) (ZMod 3)) - g := by
            rw [sub_mul, one_mul, ← sq, coe_pow]
        _ = -1 := by rw [hsq, ht, one_smul, sub_sub_cancel_left]
    rw [(by decide : 6 = 3 * 2), pow_mul, hg3, neg_one_sq]
  · right
    have hg3 : g ^ 3 = 1 := by
      apply Subtype.ext
      calc ((g ^ 3 : SL(2, ZMod 3)) : Matrix (Fin 2) (Fin 2) (ZMod 3))
          = ((g ^ 2 : SL(2, ZMod 3)) : Matrix (Fin 2) (Fin 2) (ZMod 3)) * g := by
            rw [pow_succ, coe_mul]
        _ = (-(g : Matrix (Fin 2) (Fin 2) (ZMod 3)) - 1) * g := by
            rw [hsq, ht, neg_one_smul]
        _ = -((g ^ 2 : SL(2, ZMod 3)) : Matrix (Fin 2) (Fin 2) (ZMod 3)) - g := by
            rw [sub_mul, neg_mul, one_mul, ← sq, coe_pow]
        _ = 1 := by rw [hsq, ht, neg_one_smul]; abel
    rw [(by decide : 6 = 3 * 2), pow_mul, hg3, one_pow]

end Matrix.SpecialLinearGroup

namespace TauCeti

/-- `SL(2, ZMod 3)` has cardinality `24`. -/
theorem card_specialLinearGroup_fin_two_zmod_three : Nat.card SL(2, ZMod 3) = 24 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  rw [Matrix.card_SL_field 2, Fin.prod_univ_two, ZMod.card]
  decide

/-- The centre of `SL(2, ZMod 3)` has cardinality `2`. -/
theorem card_center_specialLinearGroup_fin_two_zmod_three :
    Nat.card (Subgroup.center SL(2, ZMod 3)) = 2 := by
  have : NeZero (2 : ZMod 3) := ⟨by decide⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact Matrix.SpecialLinearGroup.card_center_eq_two
    Matrix.SpecialLinearGroup.neg_one_ne_one_of_neZero_two

/-- The centre of `SL(2, ZMod 3)` is generated by `-1`. -/
theorem center_specialLinearGroup_fin_two_zmod_three_eq_zpowers :
    Subgroup.center SL(2, ZMod 3) = Subgroup.zpowers (-1 : SL(2, ZMod 3)) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  ext g
  rw [Matrix.SpecialLinearGroup.mem_center_iff_eq_one_or_eq_neg_one,
    Subgroup.mem_zpowers_neg_one_iff]

/-! ### The normal quaternion Sylow `2`-subgroup -/

/-- The quarter-turn matrix `!![0, -1; 1, 0]` of order `4` in `SL(2, ZMod 3)`. -/
def sl2ZModThreeI : SL(2, ZMod 3) :=
  ⟨!![0, -1; 1, 0], by decide⟩

@[simp]
theorem coe_sl2ZModThreeI :
    (sl2ZModThreeI : Matrix (Fin 2) (Fin 2) (ZMod 3)) = !![0, -1; 1, 0] := (rfl)

/-- The matrix `!![1, 1; 1, -1]` of order `4` in `SL(2, ZMod 3)`, which together with
`TauCeti.sl2ZModThreeI` generates the quaternion subgroup of order `8`. -/
def sl2ZModThreeJ : SL(2, ZMod 3) :=
  ⟨!![1, 1; 1, -1], by decide⟩

@[simp]
theorem coe_sl2ZModThreeJ :
    (sl2ZModThreeJ : Matrix (Fin 2) (Fin 2) (ZMod 3)) = !![1, 1; 1, -1] := (rfl)

@[simp]
theorem sl2ZModThreeI_sq : sl2ZModThreeI ^ 2 = -1 := by decide

@[simp]
theorem sl2ZModThreeJ_sq : sl2ZModThreeJ ^ 2 = -1 := by decide

@[simp]
theorem orderOf_sl2ZModThreeI : orderOf sl2ZModThreeI = 4 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact orderOf_eq_prime_pow (x := sl2ZModThreeI) (p := 2) (n := 1) (by decide) (by decide)

/-- Conjugating `TauCeti.sl2ZModThreeI` by `TauCeti.sl2ZModThreeJ` yields its inverse. -/
theorem sl2ZModThreeJ_conj_sl2ZModThreeI :
    sl2ZModThreeJ * sl2ZModThreeI * sl2ZModThreeJ⁻¹ = sl2ZModThreeI⁻¹ := by decide

/-- The faithful homomorphism `QuaternionGroup 2 →* SL(2, ZMod 3)` sending `a 1` to
`TauCeti.sl2ZModThreeI` and `xa 0` to `TauCeti.sl2ZModThreeJ`. -/
def sl2ZModThreeQuaternionHom : QuaternionGroup 2 →* SL(2, ZMod 3) :=
  quaternionHom (by decide : sl2ZModThreeI ^ (2 * 2) = 1)
    (sl2ZModThreeJ_sq.trans sl2ZModThreeI_sq.symm) sl2ZModThreeJ_conj_sl2ZModThreeI

/-- `TauCeti.sl2ZModThreeQuaternionHom` is injective. -/
theorem sl2ZModThreeQuaternionHom_injective :
    Function.Injective sl2ZModThreeQuaternionHom :=
  quaternionHom_injective (sl2ZModThreeJ_sq.trans sl2ZModThreeI_sq.symm)
    sl2ZModThreeJ_conj_sl2ZModThreeI orderOf_sl2ZModThreeI

@[simp]
theorem sl2ZModThreeQuaternionHom_a_two :
    sl2ZModThreeQuaternionHom (QuaternionGroup.a 2) = -1 := by
  rw [sl2ZModThreeQuaternionHom, quaternionHom_a]
  decide

@[simp]
theorem sl2ZModThreeQuaternionHom_a_one :
    sl2ZModThreeQuaternionHom (QuaternionGroup.a 1) = sl2ZModThreeI := by
  rw [sl2ZModThreeQuaternionHom, quaternionHom_a]
  decide

@[simp]
theorem sl2ZModThreeQuaternionHom_xa_zero :
    sl2ZModThreeQuaternionHom (QuaternionGroup.xa 0) = sl2ZModThreeJ := by
  rw [sl2ZModThreeQuaternionHom, quaternionHom_xa]
  decide

/-- The quaternion subgroup of `SL(2, ZMod 3)` of order `8` and index `3`, defined as the range of
`TauCeti.sl2ZModThreeQuaternionHom`. -/
def sl2ZModThreeQuaternionSubgroup : Subgroup SL(2, ZMod 3) :=
  sl2ZModThreeQuaternionHom.range

/-- Unfolding lemma for `TauCeti.sl2ZModThreeQuaternionSubgroup`. -/
theorem sl2ZModThreeQuaternionSubgroup_def :
    sl2ZModThreeQuaternionSubgroup = sl2ZModThreeQuaternionHom.range := (rfl)

/-- `TauCeti.sl2ZModThreeQuaternionSubgroup` is isomorphic to `QuaternionGroup 2`. -/
noncomputable def sl2ZModThreeQuaternionEquiv :
    QuaternionGroup 2 ≃* sl2ZModThreeQuaternionSubgroup :=
  MonoidHom.ofInjective sl2ZModThreeQuaternionHom_injective

@[simp]
theorem coe_sl2ZModThreeQuaternionEquiv (q : QuaternionGroup 2) :
    (sl2ZModThreeQuaternionEquiv q : SL(2, ZMod 3)) = sl2ZModThreeQuaternionHom q := (rfl)

/-- The quaternion subgroup of `SL(2, ZMod 3)` is generated by `sl2ZModThreeI` and
`sl2ZModThreeJ`. -/
theorem sl2ZModThreeQuaternionSubgroup_eq_closure :
    sl2ZModThreeQuaternionSubgroup = Subgroup.closure {sl2ZModThreeI, sl2ZModThreeJ} :=
  range_quaternionHom _ _ _

/-- The quaternion subgroup of `SL(2, ZMod 3)` has cardinality `8`. -/
@[simp]
theorem card_sl2ZModThreeQuaternionSubgroup :
    Nat.card sl2ZModThreeQuaternionSubgroup = 8 := by
  rw [← Nat.card_congr sl2ZModThreeQuaternionEquiv.toEquiv, nat_card_quaternionGroup]

/-- The quaternion subgroup of `SL(2, ZMod 3)` has index `3`. -/
@[simp]
theorem index_sl2ZModThreeQuaternionSubgroup :
    sl2ZModThreeQuaternionSubgroup.index = 3 := by
  have h := sl2ZModThreeQuaternionSubgroup.card_mul_index
  rw [card_sl2ZModThreeQuaternionSubgroup, card_specialLinearGroup_fin_two_zmod_three] at h
  omega

@[simp]
theorem neg_one_mem_sl2ZModThreeQuaternionSubgroup :
    (-1 : SL(2, ZMod 3)) ∈ sl2ZModThreeQuaternionSubgroup :=
  ⟨QuaternionGroup.a 2, sl2ZModThreeQuaternionHom_a_two⟩

@[simp]
theorem sl2ZModThreeI_mem_sl2ZModThreeQuaternionSubgroup :
    sl2ZModThreeI ∈ sl2ZModThreeQuaternionSubgroup :=
  ⟨QuaternionGroup.a 1, sl2ZModThreeQuaternionHom_a_one⟩

@[simp]
theorem sl2ZModThreeJ_mem_sl2ZModThreeQuaternionSubgroup :
    sl2ZModThreeJ ∈ sl2ZModThreeQuaternionSubgroup :=
  ⟨QuaternionGroup.xa 0, sl2ZModThreeQuaternionHom_xa_zero⟩

/-- The centre `{±1}` of `SL(2, ZMod 3)` is contained in `TauCeti.sl2ZModThreeQuaternionSubgroup`.
-/
theorem center_le_sl2ZModThreeQuaternionSubgroup :
    Subgroup.center SL(2, ZMod 3) ≤ sl2ZModThreeQuaternionSubgroup := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact Matrix.SpecialLinearGroup.center_le_iff_neg_one_mem.mpr
    neg_one_mem_sl2ZModThreeQuaternionSubgroup

private def sl2ZModThreeQuaternionList : List SL(2, ZMod 3) :=
  [1, sl2ZModThreeI, -1, -sl2ZModThreeI, sl2ZModThreeJ, -sl2ZModThreeJ,
    sl2ZModThreeI * sl2ZModThreeJ, -(sl2ZModThreeI * sl2ZModThreeJ)]

private theorem sl2ZModThreeQuaternionList_mem {x : SL(2, ZMod 3)}
    (hx : x ∈ sl2ZModThreeQuaternionList) : x ∈ sl2ZModThreeQuaternionSubgroup := by
  have hneg (y : SL(2, ZMod 3)) (hy : y ∈ sl2ZModThreeQuaternionSubgroup) :
      -y ∈ sl2ZModThreeQuaternionSubgroup := by
    simpa only [neg_one_mul] using mul_mem neg_one_mem_sl2ZModThreeQuaternionSubgroup hy
  have hI := sl2ZModThreeI_mem_sl2ZModThreeQuaternionSubgroup
  have hJ := sl2ZModThreeJ_mem_sl2ZModThreeQuaternionSubgroup
  simp only [sl2ZModThreeQuaternionList, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [one_mem _, hI, neg_one_mem_sl2ZModThreeQuaternionSubgroup, hneg _ hI, hJ, hneg _ hJ,
    mul_mem hI hJ, hneg _ (mul_mem hI hJ)]

private theorem exists_mem_quaternionList_of_trace_zero :
    ∀ a b c : ZMod 3, a * (-a) - b * c = 1 →
      ∃ x ∈ sl2ZModThreeQuaternionList,
        (x : Matrix (Fin 2) (Fin 2) (ZMod 3)) = !![a, b; c, -a] := by
  decide

/-- An element of `SL(2, ZMod 3)` belongs to `TauCeti.sl2ZModThreeQuaternionSubgroup` if and only if
`g ^ 4 = 1`. -/
theorem mem_sl2ZModThreeQuaternionSubgroup_iff {g : SL(2, ZMod 3)} :
    g ∈ sl2ZModThreeQuaternionSubgroup ↔ g ^ 4 = 1 := by
  have : NeZero (2 : ZMod 3) := ⟨by decide +revert⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  refine ⟨?_, fun hg4 => ?_⟩
  · rintro ⟨q, rfl⟩
    rw [← map_pow, ← exponent_quaternionGroup_two, Monoid.pow_exponent_eq_one, map_one]
  · have hsq2 : (g ^ 2) ^ 2 = 1 := by rwa [← pow_mul]
    rcases Matrix.SpecialLinearGroup.sq_eq_one_iff_eq_one_or_eq_neg_one.mp hsq2 with hg2 | hg2
    · rcases Matrix.SpecialLinearGroup.sq_eq_one_iff_eq_one_or_eq_neg_one.mp hg2 with rfl | rfl
      · exact one_mem _
      · exact neg_one_mem_sl2ZModThreeQuaternionSubgroup
    · have htr : g 0 0 + g 1 1 = 0 :=
        Matrix.SpecialLinearGroup.sq_eq_neg_one_iff_add_diag_eq_zero.mp hg2
      have hd : g 1 1 = -g 0 0 := eq_neg_of_add_eq_zero_right htr
      have hdet : g 0 0 * (-g 0 0) - g 0 1 * g 1 0 = 1 := by
        simpa only [hd] using g.fin_two_mul_sub_mul_eq_one
      obtain ⟨x, hxL, hx⟩ := exists_mem_quaternionList_of_trace_zero (g 0 0) (g 0 1) (g 1 0) hdet
      have hgx : g = x := by
        apply Subtype.ext
        rw [hx]
        ext i j
        fin_cases i <;> fin_cases j <;> simp [hd]
      exact hgx ▸ sl2ZModThreeQuaternionList_mem hxL

/-- The quaternion subgroup of `SL(2, ZMod 3)` is normal. -/
instance sl2ZModThreeQuaternionSubgroup_normal : sl2ZModThreeQuaternionSubgroup.Normal where
  conj_mem x hx g :=
    mem_sl2ZModThreeQuaternionSubgroup_iff.mpr
      (by rw [conj_pow, mem_sl2ZModThreeQuaternionSubgroup_iff.mp hx, mul_one, mul_inv_cancel])

/-- `TauCeti.sl2ZModThreeQuaternionSubgroup` is a `2`-group. -/
theorem isPGroup_two_sl2ZModThreeQuaternionSubgroup :
    IsPGroup 2 sl2ZModThreeQuaternionSubgroup :=
  IsPGroup.of_card (n := 3) card_sl2ZModThreeQuaternionSubgroup

/-- `TauCeti.sl2ZModThreeQuaternionSubgroup` packaged as the unique Sylow `2`-subgroup of
`SL(2, ZMod 3)`. -/
def sl2ZModThreeSylowTwo : Sylow 2 SL(2, ZMod 3) :=
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  isPGroup_two_sl2ZModThreeQuaternionSubgroup.toSylow
    (by rw [index_sl2ZModThreeQuaternionSubgroup]; decide)

@[simp]
theorem coe_sl2ZModThreeSylowTwo :
    (sl2ZModThreeSylowTwo : Subgroup SL(2, ZMod 3)) = sl2ZModThreeQuaternionSubgroup := (rfl)

/-- `TauCeti.sl2ZModThreeSylowTwo` has finite index in `SL(2, ZMod 3)`. -/
instance finiteIndex_sl2ZModThreeSylowTwo :
    (sl2ZModThreeSylowTwo : Subgroup SL(2, ZMod 3)).FiniteIndex :=
  ⟨by rw [coe_sl2ZModThreeSylowTwo, index_sl2ZModThreeQuaternionSubgroup]; decide⟩

/-- **The commutator subgroup of `SL(2, ZMod 3)` is its normal quaternion subgroup of order `8`.**
-/
theorem commutator_specialLinearGroup_fin_two_zmod_three :
    commutator SL(2, ZMod 3) = sl2ZModThreeQuaternionSubgroup := by
  refine le_antisymm ?_ ?_
  · have hcard : Nat.card (SL(2, ZMod 3) ⧸ sl2ZModThreeQuaternionSubgroup) = 3 :=
      index_sl2ZModThreeQuaternionSubgroup
    have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    have : IsCyclic (SL(2, ZMod 3) ⧸ sl2ZModThreeQuaternionSubgroup) := isCyclic_of_prime_card hcard
    rw [← QuotientGroup.ker_mk' sl2ZModThreeQuaternionSubgroup]
    exact Group.Abelianization.commutator_le_ker (QuotientGroup.mk' sl2ZModThreeQuaternionSubgroup)
  · let u : SL(2, ZMod 3) := ⟨!![1, 1; 0, 1], by decide⟩
    have hI : sl2ZModThreeI = ⁅u, sl2ZModThreeJ⁆ := by decide
    have hImem : sl2ZModThreeI ∈ commutator SL(2, ZMod 3) := by
      rw [hI]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
    rw [sl2ZModThreeQuaternionSubgroup_eq_closure, Subgroup.closure_le]
    rintro x (rfl | rfl)
    · exact hImem
    · have hJ : sl2ZModThreeJ = ⁅u, sl2ZModThreeI⁆ * sl2ZModThreeI := by decide
      rw [hJ]
      exact mul_mem
        (Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)) hImem

/-- `SL(2, ZMod 3)` is solvable, with derived subgroup `Q₈` and abelianization of order `3`. -/
instance isSolvable_specialLinearGroup_fin_two_zmod_three : Group.IsSolvable SL(2, ZMod 3) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Group.IsNilpotent sl2ZModThreeQuaternionSubgroup :=
    isPGroup_two_sl2ZModThreeQuaternionSubgroup.isNilpotent
  rw [← Group.isSolvable_commutator_iff, commutator_specialLinearGroup_fin_two_zmod_three]
  infer_instance

/-- **Centralizer of a non-central quaternion element in `SL(2, ZMod 3)`.** If `x` lies in
`TauCeti.sl2ZModThreeQuaternionSubgroup` with `x ≠ 1` and `x ≠ -1`, then any `g : SL(2, ZMod 3)`
commuting with `x` also lies in `TauCeti.sl2ZModThreeQuaternionSubgroup`. -/
theorem mem_sl2ZModThreeQuaternionSubgroup_of_commute {g x : SL(2, ZMod 3)}
    (hx : x ∈ sl2ZModThreeQuaternionSubgroup) (hx1 : x ≠ 1) (hxneg : x ≠ -1)
    (hcomm : Commute g x) : g ∈ sl2ZModThreeQuaternionSubgroup := by
  have : NeZero (2 : ZMod 3) := ⟨by decide +revert⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hx4 : x ^ 4 = 1 := mem_sl2ZModThreeQuaternionSubgroup_iff.mp hx
  have hx2 : x ^ 2 ≠ 1 := fun h =>
    (Matrix.SpecialLinearGroup.sq_eq_one_iff_eq_one_or_eq_neg_one.mp h).elim hx1 hxneg
  have hord_x : orderOf x = 4 := orderOf_eq_prime_pow (n := 1) (by simpa using hx2) hx4
  by_contra hg
  have hg4 : g ^ 4 ≠ 1 := mt mem_sl2ZModThreeQuaternionSubgroup_iff.mpr hg
  have hg6 : g ^ 6 = 1 := g.pow_four_eq_one_or_pow_six_eq_one.resolve_left hg4
  have hg2 : g ^ 2 ≠ 1 := fun h => hg4 (by rw [(by decide : 4 = 2 * 2), pow_mul, h, one_pow])
  have hord_g2 : orderOf (g ^ 2) = 3 :=
    orderOf_eq_prime (by rw [← pow_mul]; exact hg6) hg2
  have hord12 : orderOf (g ^ 2 * x) = 12 := by
    have hmul := (hcomm.pow_left 2).orderOf_mul_eq_mul_orderOf_of_coprime
      (by rw [hord_g2, hord_x]; decide)
    rw [hord_g2, hord_x] at hmul
    exact hmul
  rcases (g ^ 2 * x).pow_four_eq_one_or_pow_six_eq_one with h4 | h6
  · have hdvd := orderOf_dvd_of_pow_eq_one h4
    rw [hord12] at hdvd
    omega
  · have hdvd := orderOf_dvd_of_pow_eq_one h6
    rw [hord12] at hdvd
    omega

/-! ### Non-splitting of the centre of `SL(2, ZMod 3)` -/

/-- Under `TauCeti.sl2ZModThreeQuaternionEquiv`, the centre of `QuaternionGroup 2` maps onto the
intersection of `Subgroup.center SL(2, ZMod 3)` with `TauCeti.sl2ZModThreeQuaternionSubgroup`. -/
theorem map_center_sl2ZModThreeQuaternionEquiv :
    (Subgroup.center (QuaternionGroup 2)).map sl2ZModThreeQuaternionEquiv.toMonoidHom =
      (Subgroup.center SL(2, ZMod 3)).subgroupOf sl2ZModThreeQuaternionSubgroup := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  ext y
  rw [Subgroup.mem_map_equiv, Subgroup.mem_subgroupOf,
    Matrix.SpecialLinearGroup.mem_center_iff_eq_one_or_eq_neg_one,
    mem_center_quaternionGroup_iff (by decide : (2 : ℕ) ≠ 1)]
  refine ⟨?_, ?_⟩
  · rintro (h | h)
    · left
      simpa using congrArg
        (fun q => ((sl2ZModThreeQuaternionEquiv q : sl2ZModThreeQuaternionSubgroup) :
          SL(2, ZMod 3))) h
    · right
      have hy := congrArg
        (fun q => ((sl2ZModThreeQuaternionEquiv q : sl2ZModThreeQuaternionSubgroup) :
          SL(2, ZMod 3))) h
      simpa [coe_sl2ZModThreeQuaternionEquiv] using hy
  · rintro (hy | hy)
    · exact Or.inl (sl2ZModThreeQuaternionEquiv.symm.map_eq_one_iff.mpr (Subtype.ext hy))
    · right
      apply sl2ZModThreeQuaternionEquiv.injective
      apply Subtype.ext
      simpa [coe_sl2ZModThreeQuaternionEquiv] using hy

/-- The centre of `SL(2, ZMod 3)` has no local complement inside the Sylow `2`-subgroup
`TauCeti.sl2ZModThreeQuaternionSubgroup`. -/
theorem not_exists_isLocalComplement_center_sl2ZModThreeQuaternionSubgroup :
    ¬ ∃ K : Subgroup SL(2, ZMod 3),
      (Subgroup.center SL(2, ZMod 3)).IsLocalComplement K sl2ZModThreeQuaternionSubgroup := by
  rw [Subgroup.exists_isLocalComplement_iff_exists_isComplement'_subgroupOf
    center_le_sl2ZModThreeQuaternionSubgroup, ← map_center_sl2ZModThreeQuaternionEquiv]
  rintro ⟨K, hK⟩
  exact not_exists_isComplement'_center_quaternionGroup (by decide : 2 ≤ 2)
    ⟨K.comap sl2ZModThreeQuaternionEquiv.toMonoidHom,
      hK.of_map sl2ZModThreeQuaternionEquiv.injective⟩

/-- **The centre of `SL(2, ZMod 3)` has no complement in `SL(2, ZMod 3)`.** -/
theorem not_exists_isComplement'_center_specialLinearGroup_fin_two_zmod_three :
    ¬ ∃ D : Subgroup SL(2, ZMod 3), (Subgroup.center SL(2, ZMod 3)).IsComplement' D := by
  rintro ⟨D, hD⟩
  exact not_exists_isLocalComplement_center_sl2ZModThreeQuaternionSubgroup
    ⟨D ⊓ sl2ZModThreeQuaternionSubgroup,
      hD.isLocalComplement_inf center_le_sl2ZModThreeQuaternionSubgroup⟩

end TauCeti
