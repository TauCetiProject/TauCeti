module

public import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup

import Mathlib.Tactic.LinearCombination
import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Transvection

/-!
# Chinese-remainder splitting of `SL(ι, ℤ)`

For coprime integers `d, d'`, every `τ ∈ SL(ι, ℤ)` — `ι` any finite index type — factors as
`τ₁ * τ₂` with `τ₁ ≡ 1 (mod d)` and `τ₂ ≡ 1 (mod d')`. In other words, the principal
congruence subgroups of levels `d` and `d'` (the kernels of reduction modulo `d` and `d'`)
generate `SL(ι, ℤ)`, and as they are normal their join is their product set. The proof is by
generators: `SL(ι, ℤ)` is generated by transvections
(`closure_range_toSpecialLinearGroup_eq_top`), and a single transvection splits by Bézout.

## Main results

* `Matrix.SpecialLinearGroup.exists_mul_modEq_one_of_coprime`: the factorization.

Ported from the AINTLIB `LeanModularForms` project
([`LeanModularForms/HeckeRIngs/GLn/CoprimeMul.lean`](https://github.com/CBirkbeck/AINTLIB),
Chris Birkbeck), where it is the group-theoretic input to the coprime multiplication rule of
the Hecke ring.
-/

public section

namespace Matrix.SpecialLinearGroup

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- **Chinese remainder decomposition of `SL(ι, ℤ)`**: for coprime `d, d'`, every element
factors as `τ₁ * τ₂` with `τ₁ ≡ 1 mod d` and `τ₂ ≡ 1 mod d'` entrywise. -/
theorem exists_mul_modEq_one_of_coprime {d d' : ℤ} (hcop : IsCoprime d d')
    (τ : SpecialLinearGroup ι ℤ) :
    ∃ τ₁ τ₂ : SpecialLinearGroup ι ℤ, τ = τ₁ * τ₂ ∧
      (∀ i j, d ∣ (τ₁ : Matrix ι ι ℤ) i j - if i = j then 1 else 0) ∧
      (∀ i j, d' ∣ (τ₂ : Matrix ι ι ℤ) i j - if i = j then 1 else 0) := by
  -- the principal congruence subgroup of level `e`: the kernel of reduction modulo `e`
  let Γ (e : ℤ) : Subgroup (SpecialLinearGroup ι ℤ) :=
    (map (Ideal.Quotient.mk (Ideal.span {e}))).ker
  have mem_Γ {e : ℤ} {σ : SpecialLinearGroup ι ℤ} (hσ : σ ∈ Γ e) (i j : ι) :
      e ∣ (σ : Matrix ι ι ℤ) i j - if i = j then 1 else 0 := by
    have := congr($(MonoidHom.mem_ker.1 hσ).1 i j)
    rw [← Ideal.Quotient.eq_zero_iff_dvd, map_sub, sub_eq_zero]
    simpa [Matrix.one_apply, apply_ite] using this
  -- each transvection splits by Bézout, and transvections generate `SL(ι, ℤ)`
  have hsup : Γ d ⊔ Γ d' = ⊤ := by
    obtain ⟨u, v, huv⟩ := hcop
    refine top_unique (closure_range_toSpecialLinearGroup_eq_top (ι := ι) ▸
      (Subgroup.closure_le _).2 (Set.range_subset_iff.2 fun ⟨i, j, hij, c⟩ ↦ ?_))
    have hc : c = c * u * d + c * v * d' := by linear_combination -c * huv
    rw [SetLike.mem_coe, TransvectionStruct.toSpecialLinearGroup_def, hc, transvection_add]
    refine Subgroup.mul_mem_sup ?_ ?_ <;> simp only [Γ, MonoidHom.mem_ker, map_transvection] <;>
      rw [(Ideal.Quotient.eq_zero_iff_dvd _ _).2 (dvd_mul_left _ _), transvection_coeff_zero]
  have hτ : τ ∈ ((Γ d ⊔ Γ d' : Subgroup _) : Set (SpecialLinearGroup ι ℤ)) :=
    hsup ▸ Subgroup.mem_top τ
  rw [Subgroup.mul_normal] at hτ
  obtain ⟨τ₁, h₁, τ₂, h₂, rfl⟩ := hτ
  exact ⟨τ₁, τ₂, rfl, mem_Γ h₁, mem_Γ h₂⟩

end Matrix.SpecialLinearGroup
