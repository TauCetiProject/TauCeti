module

public import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup

/-!
# Images of homomorphisms from SL₂

Over a field, the upper and lower transvections generate SL₂. Consequently their images
under any group homomorphism generate its range. These carrier-independent facts support
the rank-one subgroup constructions for the E₇ minuscule and F₄ short-root carriers.

The argument generalizes the containment and image proofs in
`TauCeti.Algebra.Lie.E7.Minuscule.RankOne`, using `Matrix.SL2.transvection_induction`.
-/

public section

open scoped MatrixGroups

namespace MonoidHom

open Matrix.SpecialLinearGroup

variable {K G : Type*} [Field K] [Group G]

/-- A homomorphism from SL₂ lands in a subgroup if both transvection families do. -/
theorem sl2_range_le_of_transvection_mem (f : SL(2, K) →* G) {H : Subgroup G}
    (h01 : ∀ t, f (transvection (by decide : (0 : Fin 2) ≠ 1) t) ∈ H)
    (h10 : ∀ t, f (transvection (by decide : (1 : Fin 2) ≠ 0) t) ∈ H) :
    f.range ≤ H := by
  rintro _ ⟨g, rfl⟩
  induction g using Matrix.SL2.transvection_induction with
  | htransvec a b hab t =>
    fin_cases a <;> fin_cases b
    · exact (hab rfl).elim
    · exact h01 t
    · exact h10 t
    · exact (hab rfl).elim
  | hmul g h hg hh => simpa only [map_mul] using H.mul_mem hg hh

/-- The range of a homomorphism from SL₂ is generated by the images of the upper and lower
transvections. -/
theorem sl2_range_eq_closure (f : SL(2, K) →* G) :
    f.range = Subgroup.closure
      (Set.range (f ∘ transvection (by decide : (0 : Fin 2) ≠ 1)) ∪
        Set.range (f ∘ transvection (by decide : (1 : Fin 2) ≠ 0))) := by
  apply le_antisymm
  · exact f.sl2_range_le_of_transvection_mem
      (fun t => Subgroup.subset_closure (Set.mem_union_left _ (Set.mem_range_self t)))
      (fun t => Subgroup.subset_closure (Set.mem_union_right _ (Set.mem_range_self t)))
  · rw [Subgroup.closure_le]
    rintro _ (⟨t, rfl⟩ | ⟨t, rfl⟩) <;> exact ⟨_, rfl⟩

end MonoidHom
