module

public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.GroupTheory.GroupAction.Defs
public import Mathlib.LinearAlgebra.Matrix.ToLin
public import Mathlib.LinearAlgebra.Reflection
public import TauCeti.LinearAlgebra.Matrix.Cartan.Coxeter.Basic

/-!
# Reflections on integer coefficient columns

Let `A` be a square integer matrix with `2` on the diagonal, in the convention
`A i j = ⟨αᵢ, αⱼ^∨⟩` of root rows and coroot columns. A column `c` stands for the combination
`∑ₖ cₖ αₖ`, and the simple reflection at `i` sends it to the column whose `k`-th entry is
`cₖ - δₖᵢ ∑ⱼ A j i * cⱼ`. This file packages that update as an involutive `ℤ`-linear equivalence,
and studies the subgroup generated by these equivalences and its orbits.

Nothing here refers to a root pairing, so the update can be run on an explicit Cartan matrix. The
matrix of the equivalence is `Matrix.reflMatrix`.

## Main definitions

* `Matrix.columnReflection`: the reflection at `i`, on the columns.
* `Matrix.columnReflectionGroup`: the subgroup generated by all of these reflections.

## Main results

* `Matrix.columnReflection_apply`: the formula `c - (∑ⱼ A j i * cⱼ) • eᵢ`.
* `Matrix.columnReflection_apply_same_eq`: with the update matrix `2 - Aᵀ`, the changed coordinate
  is `∑ⱼ (2 - Aᵀ) i j * cⱼ - cᵢ`.
* `Matrix.columnReflection_apply_eq_mulVec`: the equivalence is multiplication by `reflMatrix A i`.
* `Matrix.sum_columnReflection_smul`: evaluation of a reflected column on any family.
* `Matrix.columnReflection_comp_equiv`: compatibility with relabelling the index set.
* `Matrix.comp_equiv_mem_orbit`: relabelling the index set carries orbits to orbits.
* `Matrix.orbit_columnReflectionGroup_subset`: an orbit lies in any set containing its starting
  point and stable under all the reflections.

## References

The update formula is that of SGA 3, Exposé XXI, §1.1.
-/

public noncomputable section

open Function Set

namespace Matrix

variable {κ κ' : Type*} [Fintype κ] [DecidableEq κ] [Fintype κ'] [DecidableEq κ']
  (A : Matrix κ κ ℤ) (hA : ∀ i, A i i = 2)

/-- The reflection at `i` on integer coefficient columns: it sends `c` to the column with `k`-th
entry `cₖ - δₖᵢ ∑ⱼ A j i * cⱼ`. It is Mathlib's `Module.reflection` of the vector `eᵢ` along the
functional `c ↦ ∑ⱼ A j i * cⱼ`, which takes the value `A i i = 2` at `eᵢ`. -/
def columnReflection (i : κ) : (κ → ℤ) ≃ₗ[ℤ] (κ → ℤ) :=
  Module.reflection (f := LinearMap.proj i ∘ₗ Aᵀ.mulVecLin) (x := Pi.single i 1) <| by
    simp [hA]

/-- The reflection at `i` subtracts `∑ⱼ A j i * cⱼ` from the `i`-th entry of `c`. -/
theorem columnReflection_apply (i : κ) (c : κ → ℤ) :
    A.columnReflection hA i c = c - (∑ j, A j i * c j) • Pi.single i 1 :=
  Module.reflection_apply c _

@[simp]
theorem columnReflection_apply_same (i : κ) (c : κ → ℤ) :
    A.columnReflection hA i c i = c i - ∑ j, A j i * c j := by
  simp [columnReflection_apply]

@[simp]
theorem columnReflection_apply_of_ne {i k : κ} (hk : k ≠ i) (c : κ → ℤ) :
    A.columnReflection hA i c k = c k := by
  simp [columnReflection_apply, hk]

/-- With the update matrix `2 - Aᵀ`, the coordinate changed by the reflection at `i` is
`∑ⱼ (2 - Aᵀ) i j * cⱼ - cᵢ`. -/
theorem columnReflection_apply_same_eq (i : κ) (c : κ → ℤ) :
    A.columnReflection hA i c i = ((2 - Aᵀ) *ᵥ c) i - c i := by
  have hsum : (Aᵀ *ᵥ c) i = ∑ j, A j i * c j := (rfl)
  rw [columnReflection_apply_same, sub_mulVec, ofNat_mulVec, Pi.sub_apply, hsum, Pi.smul_apply,
    smul_eq_mul]
  ring

/-- The reflection is multiplication by the matrix `Matrix.reflMatrix A i`. -/
theorem columnReflection_apply_eq_mulVec (i : κ) (c : κ → ℤ) :
    A.columnReflection hA i c = reflMatrix A i *ᵥ c := by
  ext k
  simp only [mulVec, dotProduct, reflMatrix_apply, sub_mul, ite_mul, one_mul, zero_mul,
    Finset.sum_sub_distrib, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
  obtain rfl | hk := eq_or_ne k i
  · simp
  · simp [hk]

theorem columnReflection_involutive (i : κ) : Involutive (A.columnReflection hA i) :=
  Module.involutive_reflection _

@[simp]
theorem columnReflection_columnReflection (i : κ) (c : κ → ℤ) :
    A.columnReflection hA i (A.columnReflection hA i c) = c :=
  A.columnReflection_involutive hA i c

@[simp]
theorem columnReflection_symm (i : κ) :
    (A.columnReflection hA i).symm = A.columnReflection hA i :=
  Module.reflection_symm _

/-- The reflection at `i` negates the coordinate column `eᵢ`. -/
@[simp]
theorem columnReflection_single_self (i : κ) :
    A.columnReflection hA i (Pi.single i 1) = -Pi.single i 1 :=
  Module.reflection_apply_self _

/-- Evaluating a reflected column on a family `α`: the reflection at `i` corrects the value by a
multiple of `α i`. -/
theorem sum_columnReflection_smul {M : Type*} [AddCommGroup M] (α : κ → M) (i : κ) (c : κ → ℤ) :
    ∑ k, A.columnReflection hA i c k • α k =
      ∑ k, c k • α k - (∑ j, A j i * c j) • α i := by
  simp [columnReflection_apply, sub_smul, Finset.sum_sub_distrib, Pi.single_apply, ite_smul]

/-- Relabelling the index set relabels the reflections. -/
theorem columnReflection_comp_equiv {A' : Matrix κ' κ' ℤ} (hA' : ∀ i, A' i i = 2) (e : κ' ≃ κ)
    (he : ∀ i j, A' i j = A (e i) (e j)) (i : κ') (c : κ → ℤ) :
    A'.columnReflection hA' i (c ∘ e) = A.columnReflection hA (e i) c ∘ e := by
  ext k
  obtain rfl | hk := eq_or_ne k i
  · rw [Function.comp_apply, columnReflection_apply_same, columnReflection_apply_same]
    simp only [he, Function.comp_apply]
    rw [e.sum_comp fun j ↦ A j (e k) * c j]
  · have : e k ≠ e i := e.injective.ne hk
    simp [hk, this]

/-! ### The group generated by the reflections -/

/-- The subgroup of `ℤ`-linear automorphisms of the columns generated by the reflections. -/
def columnReflectionGroup : Subgroup ((κ → ℤ) ≃ₗ[ℤ] (κ → ℤ)) :=
  Subgroup.closure (range (A.columnReflection hA))

theorem columnReflection_mem_columnReflectionGroup (i : κ) :
    A.columnReflection hA i ∈ A.columnReflectionGroup hA :=
  Subgroup.subset_closure (mem_range_self i)

variable {A hA} in
/-- An orbit lies in any set containing its starting point and stable under every reflection. -/
theorem orbit_columnReflectionGroup_subset {S : Set (κ → ℤ)}
    (hS : ∀ i, ∀ c ∈ S, A.columnReflection hA i c ∈ S) {c : κ → ℤ} (hc : c ∈ S) :
    MulAction.orbit (A.columnReflectionGroup hA) c ⊆ S := by
  rintro _ ⟨⟨g, hg⟩, rfl⟩
  refine Subgroup.smul_mem_of_mem_closure_of_mem ?_ ?_ hg hc
  · rintro _ ⟨i, rfl⟩
    exact ⟨i, A.columnReflection_symm hA i⟩
  · rintro _ ⟨i, rfl⟩
    exact hS i

/-- Reflecting does not change membership in an orbit. -/
theorem columnReflection_mem_orbit_iff (i : κ) {c d : κ → ℤ} :
    A.columnReflection hA i c ∈ MulAction.orbit (A.columnReflectionGroup hA) d ↔
      c ∈ MulAction.orbit (A.columnReflectionGroup hA) d := by
  have hc : A.columnReflection hA i c =
      (⟨_, A.columnReflection_mem_columnReflectionGroup hA i⟩ : A.columnReflectionGroup hA) • c :=
    (rfl)
  rw [hc, ← MulAction.orbit_eq_iff, MulAction.orbit_smul, MulAction.orbit_eq_iff]

/-- Relabelling the index set carries orbits to orbits. -/
theorem comp_equiv_mem_orbit {A' : Matrix κ' κ' ℤ} (hA' : ∀ i, A' i i = 2) (e : κ' ≃ κ)
    (he : ∀ i j, A' i j = A (e i) (e j)) {c d : κ → ℤ}
    (h : c ∈ MulAction.orbit (A.columnReflectionGroup hA) d) :
    c ∘ e ∈ MulAction.orbit (A'.columnReflectionGroup hA') (d ∘ e) := by
  refine orbit_columnReflectionGroup_subset
    (S := {x | x ∘ e ∈ MulAction.orbit (A'.columnReflectionGroup hA') (d ∘ e)})
    (fun i x hx ↦ ?_) (MulAction.mem_orbit_self _) h
  have hx' := (A'.columnReflection_mem_orbit_iff hA' (e.symm i)).mpr hx
  rwa [A.columnReflection_comp_equiv hA hA' e he, e.apply_symm_apply] at hx'

/-- The orbit of a coordinate column is stable under negation. -/
theorem neg_mem_orbit_single {k : κ} {c : κ → ℤ}
    (hc : c ∈ MulAction.orbit (A.columnReflectionGroup hA) (Pi.single k 1 : κ → ℤ)) :
    -c ∈ MulAction.orbit (A.columnReflectionGroup hA) (Pi.single k 1 : κ → ℤ) := by
  obtain ⟨g, rfl⟩ := hc
  have hself : (-Pi.single k 1 : κ → ℤ) ∈
      MulAction.orbit (A.columnReflectionGroup hA) (Pi.single k 1 : κ → ℤ) :=
    A.columnReflection_single_self hA k ▸
      (A.columnReflection_mem_orbit_iff hA k).mpr (MulAction.mem_orbit_self _)
  obtain ⟨h, hh⟩ := hself
  exact ⟨g * h, by simp only [mul_smul, hh]; exact (smul_neg g _)⟩

end Matrix

end
