/-!
# Simple reflections, the Weyl group and the braid relations of a Cartan realization

Let `R` be a realization of a matrix `A` on a vector space `H` over a field `K`, with simple
coroots `hᵢ ∈ H` and simple roots `αᵢ ∈ H*` satisfying `αⱼ(hᵢ) = aᵢⱼ`. Whenever `aᵢᵢ = 2` for every
`i`, Mathlib's `Module.reflection` supplies the **simple reflection** `sᵢ(φ) = φ - φ(hᵢ) αᵢ` on `H*`
and the **simple coreflection** `sᵢ^∨(h) = h - αᵢ(h) hᵢ` on `H`. The **Weyl group** `R.weylGroup` is
the subgroup of `GL(H*)` generated by the simple reflections, with word length `R.length`. Over any
field `K` (even when `H` is infinite-dimensional), the covariant transpose identifies `R.weylGroup`
with the coreflection group on `H`; the resulting action `R.corootAction` preserves the evaluation
pairing, fixes the Cartan center pointwise, identifies the Weyl group of an enlargement with that
of any sub-realization supplementing the Cartan center (`R.restrictWeylEquiv`) compatibly with the
root lattice (`R.restrictRootLatticeEquiv`), and stabilizes `Q`, `Y` and `P`.

For an integral matrix `A`, `TauCeti.cartanCoxeterMatrix A` sets `mᵢᵢ = 1`, `mᵢⱼ = 2, 3, 4, 6` when
`i ≠ j` and `aᵢⱼ aⱼᵢ = 0, 1, 2, 3`, and `mᵢⱼ = 0` (encoding `∞`) when `i ≠ j` and `aᵢⱼ aⱼᵢ ≥ 4`.
Whenever `A` has diagonal `2` and symmetric zero pattern, the simple reflections satisfy
`(sᵢ sⱼ) ^ mᵢⱼ = 1`, giving a surjective homomorphism `R.coxeterToWeyl` onto `R.weylGroup` (proved
an isomorphism in `TauCeti.LinearAlgebra.Matrix.Cartan.Realization.WeylGroup.Coxeter`).

## Main definitions

* `TauCeti.cartanCoxeterMatrix`: the Kac–Moody Coxeter matrix of an integral matrix `A`.
* `TauCeti.CartanRealization.simpleReflection`, `TauCeti.CartanRealization.simpleCoreflection`,
  `TauCeti.CartanRealization.weylGroup`, `TauCeti.CartanRealization.weylSimple`,
  `TauCeti.CartanRealization.length`, `TauCeti.CartanRealization.corootAction`.
* `TauCeti.CartanRealization.restrictWeylEquiv`,
  `TauCeti.CartanRealization.restrictRootLatticeEquiv`.
* `TauCeti.CartanRealization.rootLatticeAction`,
  `TauCeti.CartanRealization.CoweightLattice.coweightAction`,
  `TauCeti.CartanRealization.CoweightLattice.weightAction`,
  `TauCeti.CartanRealization.coxeterToWeyl`.

## Main results

* `TauCeti.CartanRealization.smul_apply_corootAction`: `(w • φ)(w • h) = φ(h)`.
* `TauCeti.CartanRealization.restrictRootLatticeEquiv_smul`: equivariance of restriction to `Q`.
* `TauCeti.CartanRealization.weylSimple_mul_weylSimple_pow` and
  `TauCeti.CartanRealization.coxeterToWeyl_surjective`.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, Cambridge University Press, 1990,
  §§3.7 and 3.13.
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Ch. VI, §1.3.
-/

public section

open Module Polynomial.Chebyshev

namespace TauCeti

/-! ### The Coxeter matrix of a generalized Cartan matrix -/

section CoxeterMatrix

/-- **The Coxeter matrix attached to an integral Cartan matrix.** On the diagonal the entry is `1`.
Off the diagonal it translates the Cartan product `aᵢⱼ aⱼᵢ` into `2, 3, 4, 6` when
`aᵢⱼ aⱼᵢ = 0, 1, 2, 3` (`TauCeti.coxeterOrder`), and into `0` (Mathlib's encoding of an infinite
order) otherwise — in particular when `aᵢⱼ aⱼᵢ = 4` at two distinct nodes, as in affine `A₁⁽¹⁾`. -/
noncomputable def cartanCoxeterMatrix {I : Type*} (A : Matrix I I ℤ) : CoxeterMatrix I := by
  classical
  exact
    { M := Matrix.of fun i j ↦
        if i = j then 1
        else if A i j * A j i ≤ 3 then coxeterOrder (A i j * A j i) else 0
      isSymm := Matrix.IsSymm.ext fun i j ↦ by
        simp only [Matrix.of_apply, eq_comm (a := i), mul_comm (A i j)]
      diagonal i := by simp
      off_diagonal i j hij := by
        simp only [Matrix.of_apply, hij, ↓reduceIte]
        split_ifs with hle
        · rcases lt_or_ge (A i j * A j i) 0 with hlt | hge
          · have h0 : coxeterOrder (A i j * A j i) = 0 := coxeterOrder_eq_zero_iff.mpr <| by
              simp only [Set.mem_insert_iff, Set.mem_singleton_iff]; omega
            omega
          · have hmem : A i j * A j i ∈ ({0, 1, 2, 3} : Set ℤ) := by
              simp only [Set.mem_insert_iff, Set.mem_singleton_iff]; omega
            have := two_le_coxeterOrder hmem
            omega
        · decide }

/-- Unfolded entry formula for `TauCeti.cartanCoxeterMatrix`. -/
theorem cartanCoxeterMatrix_apply {I : Type*} [DecidableEq I] (A : Matrix I I ℤ) (i j : I) :
    cartanCoxeterMatrix A i j =
      if i = j then 1
      else if A i j * A j i ≤ 3 then coxeterOrder (A i j * A j i) else 0 := by
  -- Reconcile the classical `DecidableEq` inside `cartanCoxeterMatrix` with the caller's instance.
  change (letI := Classical.decEq I;
    if i = j then 1 else if A i j * A j i ≤ 3 then coxeterOrder (A i j * A j i) else 0) = _
  congr 1

theorem cartanCoxeterMatrix_self {I : Type*} (A : Matrix I I ℤ) (i : I) :
    cartanCoxeterMatrix A i i = 1 :=
  (cartanCoxeterMatrix A).diagonal i

theorem cartanCoxeterMatrix_of_ne {I : Type*} (A : Matrix I I ℤ) {i j : I} (hij : i ≠ j) :
    cartanCoxeterMatrix A i j =
      if A i j * A j i ≤ 3 then coxeterOrder (A i j * A j i) else 0 := by
  classical simp [cartanCoxeterMatrix_apply, hij]

@[simp]
theorem cartanCoxeterMatrix_of_ne_of_le {I : Type*} (A : Matrix I I ℤ) {i j : I} (hij : i ≠ j)
    (h : A i j * A j i ≤ 3) : cartanCoxeterMatrix A i j = coxeterOrder (A i j * A j i) := by
  simp [cartanCoxeterMatrix_of_ne A hij, h]

@[simp]
theorem cartanCoxeterMatrix_of_ne_of_lt {I : Type*} (A : Matrix I I ℤ) {i j : I} (hij : i ≠ j)
    (h : 3 < A i j * A j i) : cartanCoxeterMatrix A i j = 0 := by
  simp [cartanCoxeterMatrix_of_ne A hij, not_le.mpr h]

/-- When all off-diagonal Cartan products lie in `{0, 1, 2, 3}`, `cartanCoxeterMatrix` agrees with
`coxeterMatrixOfCartanMatrix`. -/
theorem cartanCoxeterMatrix_eq_coxeterMatrixOfCartanMatrix {I : Type*} (A : Matrix I I ℤ)
    (hdiag : ∀ i, A i i = 2)
    (hmem : ∀ i j, i ≠ j → A i j * A j i ∈ ({0, 1, 2, 3} : Set ℤ)) :
    cartanCoxeterMatrix A = coxeterMatrixOfCartanMatrix A hdiag hmem := by
  ext i j
  rcases eq_or_ne i j with rfl | hij
  · simp
  · have hle : A i j * A j i ≤ 3 := by
      have := hmem i j hij
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at this; omega
    rw [cartanCoxeterMatrix_of_ne_of_le A hij hle, coxeterMatrixOfCartanMatrix_apply]

end CoxeterMatrix

namespace CartanRealization

/-! ### Simple reflections and coreflections -/

section SimpleReflections

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I K}
  (R : CartanRealization A H) (hdiag : ∀ i, A i i = 2)

/-- The **simple reflection** `sᵢ(φ) = φ - φ(hᵢ) αᵢ` on the dual space `Dual K H`, constructed via
`Module.reflection`. -/
def simpleReflection (i : I) : Dual K H ≃ₗ[K] Dual K H :=
  Module.reflection (x := R.root i) (f := Dual.eval K H (R.coroot i))
    (by rw [Dual.eval_apply, R.root_coroot, hdiag])

/-- The **simple coreflection** `sᵢ^∨(h) = h - αᵢ(h) hᵢ` on the ambient space `H`, constructed via
`Module.reflection`. -/
def simpleCoreflection (i : I) : H ≃ₗ[K] H :=
  Module.reflection (x := R.coroot i) (f := R.root i) (by rw [R.root_coroot, hdiag])

theorem simpleReflection_apply (i : I) (φ : Dual K H) :
    R.simpleReflection hdiag i φ = φ - φ (R.coroot i) • R.root i :=
  Module.reflection_apply φ _

theorem simpleCoreflection_apply (i : I) (h : H) :
    R.simpleCoreflection hdiag i h = h - R.root i h • R.coroot i :=
  Module.reflection_apply h _

@[simp]
theorem simpleReflection_root_self (i : I) : R.simpleReflection hdiag i (R.root i) = -R.root i :=
  Module.reflection_apply_self _

@[simp]
theorem simpleCoreflection_coroot_self (i : I) :
    R.simpleCoreflection hdiag i (R.coroot i) = -R.coroot i :=
  Module.reflection_apply_self _

theorem simpleReflection_root (i j : I) :
    R.simpleReflection hdiag i (R.root j) = R.root j - A i j • R.root i := by
  rw [simpleReflection_apply, R.root_coroot]

theorem simpleCoreflection_coroot (i j : I) :
    R.simpleCoreflection hdiag i (R.coroot j) = R.coroot j - A j i • R.coroot i := by
  rw [simpleCoreflection_apply, R.root_coroot]

@[simp]
theorem simpleReflection_simpleReflection (i : I) (φ : Dual K H) :
    R.simpleReflection hdiag i (R.simpleReflection hdiag i φ) = φ :=
  Module.involutive_reflection _ φ

@[simp]
theorem simpleCoreflection_simpleCoreflection (i : I) (h : H) :
    R.simpleCoreflection hdiag i (R.simpleCoreflection hdiag i h) = h :=
  Module.involutive_reflection _ h

@[simp]
theorem simpleReflection_mul_self (i : I) :
    R.simpleReflection hdiag i * R.simpleReflection hdiag i = 1 :=
  LinearEquiv.ext fun φ ↦ R.simpleReflection_simpleReflection hdiag i φ

@[simp]
theorem simpleCoreflection_mul_self (i : I) :
    R.simpleCoreflection hdiag i * R.simpleCoreflection hdiag i = 1 :=
  LinearEquiv.ext fun h ↦ R.simpleCoreflection_simpleCoreflection hdiag i h

@[simp]
theorem simpleReflection_symm (i : I) :
    (R.simpleReflection hdiag i).symm = R.simpleReflection hdiag i :=
  Module.reflection_symm _

@[simp]
theorem simpleCoreflection_symm (i : I) :
    (R.simpleCoreflection hdiag i).symm = R.simpleCoreflection hdiag i :=
  Module.reflection_symm _

@[simp]
theorem simpleReflection_inv (i : I) :
    (R.simpleReflection hdiag i)⁻¹ = R.simpleReflection hdiag i :=
  Module.reflection_inv _

@[simp]
theorem simpleCoreflection_inv (i : I) :
    (R.simpleCoreflection hdiag i)⁻¹ = R.simpleCoreflection hdiag i :=
  Module.reflection_inv _

/-- Every simple coreflection fixes the Cartan center pointwise. -/
theorem simpleCoreflection_of_mem_cartanCenter (i : I) {h : H} (hh : h ∈ R.cartanCenter) :
    R.simpleCoreflection hdiag i h = h := by
  rw [simpleCoreflection_apply, (R.mem_cartanCenter_iff h).mp hh i, zero_smul, sub_zero]

/-- The simple reflection on `Dual K H` is the transpose of the simple coreflection on `H`. -/
theorem simpleReflection_eq_dualMap (i : I) :
    R.simpleReflection hdiag i = (R.simpleCoreflection hdiag i).dualMap := by
  ext φ h
  simp only [simpleReflection_apply, simpleCoreflection_apply, LinearEquiv.dualMap_apply,
    LinearMap.sub_apply, LinearMap.smul_apply, map_sub, map_smul, smul_eq_mul, mul_comm]

/-- Adjointness of `sᵢ` and `sᵢ^∨` for the evaluation pairing. -/
theorem simpleReflection_apply_apply (i : I) (φ : Dual K H) (h : H) :
    R.simpleReflection hdiag i φ h = φ (R.simpleCoreflection hdiag i h) := by
  rw [R.simpleReflection_eq_dualMap hdiag i, LinearEquiv.dualMap_apply]

/-- The simple reflection and coreflection preserve the evaluation pairing. -/
@[simp]
theorem simpleReflection_apply_simpleCoreflection (i : I) (φ : Dual K H) (h : H) :
    R.simpleReflection hdiag i φ (R.simpleCoreflection hdiag i h) = φ h := by
  rw [simpleReflection_apply_apply, simpleCoreflection_simpleCoreflection]

/-! ### The Weyl group, dual coroot action and word length -/

/-- The **Weyl group** of the realization: the subgroup of `GL(Dual K H)` generated by the simple
reflections. -/
def weylGroup : Subgroup (Dual K H ≃ₗ[K] Dual K H) :=
  Subgroup.closure (Set.range (R.simpleReflection hdiag))

theorem weylGroup_def :
    R.weylGroup hdiag = Subgroup.closure (Set.range (R.simpleReflection hdiag)) := (rfl)

theorem simpleReflection_mem_weylGroup (i : I) :
    R.simpleReflection hdiag i ∈ R.weylGroup hdiag :=
  Subgroup.subset_closure (Set.mem_range_self i)

/-- The simple reflection `sᵢ` as an element of `R.weylGroup hdiag`. -/
def weylSimple (i : I) : R.weylGroup hdiag :=
  ⟨R.simpleReflection hdiag i, R.simpleReflection_mem_weylGroup hdiag i⟩

@[simp]
theorem coe_weylSimple (i : I) :
    (R.weylSimple hdiag i : Dual K H ≃ₗ[K] Dual K H) = R.simpleReflection hdiag i := (rfl)

@[simp]
theorem weylSimple_smul (i : I) (φ : Dual K H) :
    R.weylSimple hdiag i • φ = R.simpleReflection hdiag i φ := (rfl)

@[simp]
theorem weylSimple_mul_self (i : I) : R.weylSimple hdiag i * R.weylSimple hdiag i = 1 :=
  Subtype.ext (R.simpleReflection_mul_self hdiag i)

@[simp]
theorem weylSimple_sq (i : I) : R.weylSimple hdiag i ^ 2 = 1 := by rw [sq, weylSimple_mul_self]

@[simp]
theorem weylSimple_inv (i : I) : (R.weylSimple hdiag i)⁻¹ = R.weylSimple hdiag i :=
  Subtype.ext (R.simpleReflection_inv hdiag i)

/-- Over a characteristic-zero field, no simple reflection is the identity. -/
theorem weylSimple_ne_one [CharZero K] (i : I) : R.weylSimple hdiag i ≠ 1 := by
  intro h
  have hα := congrArg (fun w : R.weylGroup hdiag ↦ (w • R.root i) (R.coroot i)) h
  simp only [weylSimple_smul, simpleReflection_root_self, LinearMap.neg_apply, one_smul,
    R.root_coroot, hdiag i] at hα
  norm_num at hα

/-- The simple elements `R.weylSimple hdiag i` generate `R.weylGroup hdiag`. -/
theorem closure_range_weylSimple : Subgroup.closure (Set.range (R.weylSimple hdiag)) = ⊤ := by
  rw [Subgroup.eq_top_iff']
  rintro ⟨g, hg⟩
  suffices ∀ x, (hx : x ∈ R.weylGroup hdiag) →
      (⟨x, hx⟩ : R.weylGroup hdiag) ∈ Subgroup.closure (Set.range (R.weylSimple hdiag)) from
    this g hg
  intro x hx
  induction hx using Subgroup.closure_induction with
  | mem _ hy => obtain ⟨i, rfl⟩ := hy; exact Subgroup.subset_closure ⟨i, rfl⟩
  | one => exact one_mem _
  | mul _ _ _ _ ihx ihy => exact mul_mem ihx ihy
  | inv _ _ ihx => exact inv_mem ihx

/-- Because every simple reflection is an involution, `R.weylGroup hdiag` is already generated as a
submonoid by the simple reflections. -/
theorem toSubmonoid_weylGroup :
    (R.weylGroup hdiag).toSubmonoid = Submonoid.closure (Set.range (R.simpleReflection hdiag)) := by
  open scoped Pointwise in
  have hsymm : (Set.range (R.simpleReflection hdiag))⁻¹ = Set.range (R.simpleReflection hdiag) := by
    ext f; simp [← inv_eq_iff_eq_inv]
  rw [weylGroup, Subgroup.closure_toSubmonoid, hsymm, Set.union_self]

/-- Induction principle on `R.weylGroup hdiag` requiring only `1`, simple reflections and
products (no separate inverse case). -/
@[elab_as_elim]
theorem weylGroup_induction {P : R.weylGroup hdiag → Prop} (one : P 1)
    (simple : ∀ i, P (R.weylSimple hdiag i))
    (mul : ∀ u v, P u → P v → P (u * v)) (w : R.weylGroup hdiag) : P w := by
  have hw : w.1 ∈ Submonoid.closure (Set.range (R.simpleReflection hdiag)) :=
    R.toSubmonoid_weylGroup hdiag ▸ w.2
  suffices ∀ g ∈ Submonoid.closure (Set.range (R.simpleReflection hdiag)),
      ∀ hg : g ∈ R.weylGroup hdiag, P ⟨g, hg⟩ from this w.1 hw w.2
  intro g hg
  induction hg using Submonoid.closure_induction with
  | mem _ hx => obtain ⟨i, rfl⟩ := hx; exact fun _ ↦ simple i
  | one => exact fun _ ↦ one
  | mul x y hx hy ihx ihy =>
    have hx' : x ∈ R.weylGroup hdiag := by
      rwa [← Subgroup.mem_toSubmonoid, R.toSubmonoid_weylGroup hdiag]
    have hy' : y ∈ R.weylGroup hdiag := by
      rwa [← Subgroup.mem_toSubmonoid, R.toSubmonoid_weylGroup hdiag]
    exact fun _ ↦ mul ⟨x, hx'⟩ ⟨y, hy'⟩ (ihx hx') (ihy hy')

/-- With an empty index set, the Weyl group is trivial. -/
@[simp]
theorem weylGroup_eq_bot [IsEmpty I] : R.weylGroup hdiag = ⊥ := by simp [weylGroup]

instance [IsEmpty I] : Subsingleton (R.weylGroup hdiag) where
  allEq x y := Subtype.ext <|
    ((Subgroup.eq_bot_iff_forall _).mp (R.weylGroup_eq_bot hdiag) x.1 x.2).trans
      ((Subgroup.eq_bot_iff_forall _).mp (R.weylGroup_eq_bot hdiag) y.1 y.2).symm

instance [IsEmpty I] : Unique (R.weylGroup hdiag) := uniqueOfSubsingleton 1

/-- The subgroup of `GL(H)` generated by the simple coreflections. -/
def corootWeylGroup : Subgroup (H ≃ₗ[K] H) :=
  Subgroup.closure (Set.range (R.simpleCoreflection hdiag))

theorem simpleCoreflection_mem_corootWeylGroup (i : I) :
    R.simpleCoreflection hdiag i ∈ R.corootWeylGroup hdiag :=
  Subgroup.subset_closure (Set.mem_range_self i)

/-- The canonical isomorphism between the coreflection group on `H` and the Weyl group on
`Dual K H`, valid even when `H` is infinite-dimensional. -/
noncomputable def corootWeylEquiv : R.corootWeylGroup hdiag ≃* R.weylGroup hdiag := by
  let dualAut : (H ≃ₗ[K] H) →* (Dual K H ≃ₗ[K] Dual K H) :=
    { toFun u := u.symm.dualMap, map_one' := by ext; rfl, map_mul' _ _ := by ext; rfl }
  have hinj : Function.Injective dualAut := by
    refine (injective_iff_map_eq_one _).mpr fun u hu ↦ LinearEquiv.ext fun x ↦ ?_
    have hx : u.symm (u x) = u x := by
      rw [← sub_eq_zero, ← Module.forall_dual_apply_eq_zero_iff K]
      intro φ
      have hφ : dualAut u φ (u x) = φ (u x) := by rw [hu, one_apply_eq_self]
      simpa [dualAut, map_sub, sub_eq_zero] using hφ
    rw [one_apply_eq_self, ← hx, u.symm_apply_apply]
  have hmap : (R.corootWeylGroup hdiag).map dualAut = R.weylGroup hdiag := by
    have hrange : dualAut '' Set.range (R.simpleCoreflection hdiag) =
        Set.range (R.simpleReflection hdiag) := by
      rw [← Set.range_comp]
      exact congrArg Set.range (funext fun i ↦
        (congrArg LinearEquiv.dualMap (R.simpleCoreflection_symm hdiag i)).trans
          (R.simpleReflection_eq_dualMap hdiag i).symm)
    rw [corootWeylGroup, MonoidHom.map_closure, hrange, weylGroup]
  exact ((R.corootWeylGroup hdiag).equivMapOfInjective dualAut hinj).trans
    (MulEquiv.subgroupCongr hmap)

@[simp]
theorem corootWeylEquiv_simpleCoreflection (i : I) :
    R.corootWeylEquiv hdiag ⟨R.simpleCoreflection hdiag i,
      R.simpleCoreflection_mem_corootWeylGroup hdiag i⟩ = R.weylSimple hdiag i := by
  apply Subtype.ext
  rw [corootWeylEquiv, MulEquiv.trans_apply, MulEquiv.subgroupCongr_apply]
  exact (congrArg LinearEquiv.dualMap (R.simpleCoreflection_symm hdiag i)).trans
    (R.simpleReflection_eq_dualMap hdiag i).symm

/-- The canonical action of `R.weylGroup hdiag` on the ambient space `H`, carrying each `sᵢ` to
`R.simpleCoreflection hdiag i`. -/
noncomputable def corootAction : R.weylGroup hdiag →* (H ≃ₗ[K] H) :=
  (R.corootWeylGroup hdiag).subtype.comp (R.corootWeylEquiv hdiag).symm.toMonoidHom

@[simp]
theorem corootAction_weylSimple (i : I) :
    R.corootAction hdiag (R.weylSimple hdiag i) = R.simpleCoreflection hdiag i := by
  rw [corootAction, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    ← R.corootWeylEquiv_simpleCoreflection hdiag i, MulEquiv.symm_apply_apply]
  rfl

theorem corootAction_injective : Function.Injective (R.corootAction hdiag) :=
  Subtype.val_injective.comp (R.corootWeylEquiv hdiag).symm.injective

/-- Adjointness of the Weyl group actions on `Dual K H` and `H`: `(w • φ)(h) = φ(w⁻¹ • h)`. -/
theorem smul_apply_eq_apply_corootAction_inv (w : R.weylGroup hdiag) (φ : Dual K H) (h : H) :
    (w • φ) h = φ (R.corootAction hdiag w⁻¹ h) := by
  induction w using R.weylGroup_induction generalizing φ h with
  | one => simp
  | simple i =>
    rw [weylSimple_smul, weylSimple_inv, R.corootAction_weylSimple, R.simpleReflection_apply_apply]
  | mul u v ihu ihv => rw [mul_smul, mul_inv_rev, map_mul, mul_apply_eq_comp, ihu, ihv]

/-- **The Weyl group preserves the evaluation pairing** between `Dual K H` and `H`. -/
@[simp]
theorem smul_apply_corootAction (w : R.weylGroup hdiag) (φ : Dual K H) (h : H) :
    (w • φ) (R.corootAction hdiag w h) = φ h := by
  rw [R.smul_apply_eq_apply_corootAction_inv hdiag, ← mul_apply_eq_comp, ← map_mul,
    inv_mul_cancel, map_one, one_apply_eq_self]

/-- Every Weyl group element fixes the Cartan center pointwise on `H`. -/
theorem corootAction_of_mem_cartanCenter (w : R.weylGroup hdiag) {h : H}
    (hh : h ∈ R.cartanCenter) : R.corootAction hdiag w h = h := by
  induction w using R.weylGroup_induction with
  | one => simp
  | simple i =>
    rw [corootAction_weylSimple]; exact R.simpleCoreflection_of_mem_cartanCenter hdiag i hh
  | mul u v ihu ihv => rw [map_mul, mul_apply_eq_comp, ihv, ihu]

/-- Every Weyl group element stabilizes any subspace `M` containing the coroots. -/
theorem corootAction_mem_of_corootSpan_le (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (w : R.weylGroup hdiag) {m : H} (hm : m ∈ M) : R.corootAction hdiag w m ∈ M := by
  induction w using R.weylGroup_induction generalizing m with
  | one => simpa using hm
  | simple i =>
    rw [corootAction_weylSimple, simpleCoreflection_apply]
    exact sub_mem hm (M.smul_mem _ (hc (R.coroot_mem_corootSpan i)))
  | mul u v ihu ihv => rw [map_mul, mul_apply_eq_comp]; exact ihu (ihv hm)

/-- Every Weyl group element stabilizes `R.corootSpan`. -/
theorem corootAction_mem_corootSpan (w : R.weylGroup hdiag) {h : H} (hh : h ∈ R.corootSpan) :
    R.corootAction hdiag w h ∈ R.corootSpan :=
  R.corootAction_mem_of_corootSpan_le hdiag R.corootSpan le_rfl w hh

/-- Conjugating `sᵢ` by `w` reflects along `w • αᵢ` and `w • hᵢ`. -/
theorem conj_weylSimple_smul (w : R.weylGroup hdiag) (i : I) (φ : Dual K H) :
    (w * R.weylSimple hdiag i * w⁻¹) • φ =
      φ - φ (R.corootAction hdiag w (R.coroot i)) • (w • R.root i) := by
  rw [mul_smul, mul_smul, weylSimple_smul, simpleReflection_apply, smul_sub,
    smul_comm w _ (R.root i), smul_inv_smul, R.smul_apply_eq_apply_corootAction_inv hdiag, inv_inv]

/-! ### Word length on the Weyl group -/

/-- Every Weyl group element can be written as a product of simple reflections. -/
theorem exists_list_prod_eq (w : R.weylGroup hdiag) :
    ∃ l : List I, (l.map (R.simpleReflection hdiag)).prod = w.1 := by
  induction w using R.weylGroup_induction with
  | one => exact ⟨[], rfl⟩
  | simple i => exact ⟨[i], by simp⟩
  | mul u v ihu ihv =>
    obtain ⟨lu, hlu⟩ := ihu; obtain ⟨lv, hlv⟩ := ihv
    exact ⟨lu ++ lv, by simp [List.prod_append, hlu, hlv]⟩

/-- The **length** of a Weyl group element: the least length of a word in the simple reflections
whose product is `w`. -/
noncomputable def length (w : R.weylGroup hdiag) : ℕ :=
  sInf {n | ∃ l : List I, l.length = n ∧ (l.map (R.simpleReflection hdiag)).prod = w.1}

theorem length_def (w : R.weylGroup hdiag) :
    R.length hdiag w =
      sInf {n | ∃ l : List I, l.length = n ∧ (l.map (R.simpleReflection hdiag)).prod = w.1} := (rfl)

theorem exists_list_length_eq (w : R.weylGroup hdiag) :
    ∃ l : List I, l.length = R.length hdiag w ∧ (l.map (R.simpleReflection hdiag)).prod = w.1 := by
  obtain ⟨l, hl⟩ := R.exists_list_prod_eq hdiag w
  exact Nat.sInf_mem (s := {n | ∃ l : List I,
    l.length = n ∧ (l.map (R.simpleReflection hdiag)).prod = w.1}) ⟨l.length, l, rfl, hl⟩

theorem length_le_of_prod_eq {w : R.weylGroup hdiag} {l : List I}
    (hl : (l.map (R.simpleReflection hdiag)).prod = w.1) : R.length hdiag w ≤ l.length :=
  Nat.sInf_le ⟨l, rfl, hl⟩

@[simp]
theorem length_one : R.length hdiag 1 = 0 :=
  Nat.eq_zero_of_le_zero (R.length_le_of_prod_eq hdiag (l := []) rfl)

@[simp]
theorem length_eq_zero_iff {w : R.weylGroup hdiag} : R.length hdiag w = 0 ↔ w = 1 := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ R.length_one hdiag⟩
  obtain ⟨l, hl, hprod⟩ := R.exists_list_length_eq hdiag w
  rw [List.length_eq_zero_iff.mp (hl.trans h)] at hprod
  exact Subtype.ext hprod.symm

@[simp]
theorem length_weylSimple [CharZero K] (i : I) : R.length hdiag (R.weylSimple hdiag i) = 1 := by
  refine le_antisymm (R.length_le_of_prod_eq hdiag (l := [i]) (by simp)) ?_
  have hne := mt (R.length_eq_zero_iff hdiag).mp (R.weylSimple_ne_one hdiag i)
  omega

@[simp]
theorem length_inv (w : R.weylGroup hdiag) : R.length hdiag w⁻¹ = R.length hdiag w := by
  have hrev_inv (l : List I) : ((l.map (R.simpleReflection hdiag)).prod)⁻¹ =
      (l.reverse.map (R.simpleReflection hdiag)).prod := by
    induction l with
    | nil => simp
    | cons a t ih =>
      rw [List.map_cons, List.prod_cons, mul_inv_rev, simpleReflection_inv, ih, List.reverse_cons,
        List.map_append, List.prod_append, List.map_singleton, List.prod_singleton]
  suffices ∀ u : R.weylGroup hdiag, R.length hdiag u⁻¹ ≤ R.length hdiag u from
    le_antisymm (this w) (by simpa using this w⁻¹)
  intro u
  obtain ⟨l, hl, hprod⟩ := R.exists_list_length_eq hdiag u
  rw [← hl, ← List.length_reverse]
  exact R.length_le_of_prod_eq hdiag (l := l.reverse)
    (by rw [← hrev_inv l, hprod, Subgroup.coe_inv])

theorem length_mul_le (u v : R.weylGroup hdiag) :
    R.length hdiag (u * v) ≤ R.length hdiag u + R.length hdiag v := by
  obtain ⟨lu, hlu, hpu⟩ := R.exists_list_length_eq hdiag u
  obtain ⟨lv, hlv, hpv⟩ := R.exists_list_length_eq hdiag v
  rw [← hlu, ← hlv, ← List.length_append]
  exact R.length_le_of_prod_eq hdiag (l := lu ++ lv) (by simp [List.prod_append, hpu, hpv])

/-! ### Central restriction of the Weyl group -/

/-- Restricting the dual space to `M` intertwines `R.simpleReflection` with the simple reflection of
`R.restrict M hc hs`. -/
theorem subtype_dualMap_simpleReflection (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (i : I) (φ : Dual K H) :
    M.subtype.dualMap (R.simpleReflection hdiag i φ) =
      (R.restrict M hc hs).simpleReflection hdiag i (M.subtype.dualMap φ) := by
  ext m; simp [simpleReflection_apply]

/-- **Invariance of the Weyl group under central enlargement.** Restricting to any subspace `M`
containing the coroots and supplementing the Cartan center (in particular, any minimal
sub-realization from `CartanRealization.exists_isMinimal_restrict_isCompl`) induces a canonical
isomorphism of Weyl groups. -/
noncomputable def restrictWeylEquiv (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) :
    R.weylGroup hdiag ≃* (R.restrict M hc hs).weylGroup hdiag := by
  let R' := R.restrict M hc hs
  let toSub : R.weylGroup hdiag →* (M ≃ₗ[K] M) :=
    { toFun w :=
        { toFun m := ⟨R.corootAction hdiag w m.1,
            R.corootAction_mem_of_corootSpan_le hdiag M hc w m.2⟩
          invFun m := ⟨R.corootAction hdiag w⁻¹ m.1,
            R.corootAction_mem_of_corootSpan_le hdiag M hc w⁻¹ m.2⟩
          left_inv m := Subtype.ext <| by
            dsimp only; rw [← mul_apply_eq_comp, ← map_mul, inv_mul_cancel, map_one,
              one_apply_eq_self]
          right_inv m := Subtype.ext <| by
            dsimp only; rw [← mul_apply_eq_comp, ← map_mul, mul_inv_cancel, map_one,
              one_apply_eq_self]
          map_add' _ _ := Subtype.ext (map_add _ _ _)
          map_smul' _ _ := Subtype.ext (map_smul _ _ _) }
      map_one' := by ext; simp
      map_mul' _ _ := by ext; simp [map_mul] }
  have hinj : Function.Injective toSub := by
    refine (injective_iff_map_eq_one _).mpr fun w hw ↦
      R.corootAction_injective hdiag <| LinearEquiv.ext fun x ↦ ?_
    obtain ⟨m, hm, z, hz, rfl⟩ := Submodule.mem_sup.mp (hs ▸ Submodule.mem_top : x ∈ _)
    have hm' : R.corootAction hdiag w m = m :=
      congrArg Subtype.val (DFunLike.congr_fun hw ⟨m, hm⟩)
    rw [map_add, hm', R.corootAction_of_mem_cartanCenter hdiag w hz, map_one, one_apply_eq_self]
  have hsimple (i : I) : toSub (R.weylSimple hdiag i) = R'.simpleCoreflection hdiag i := by
    ext m; simp [toSub, R', simpleCoreflection_apply]
  have hrange : toSub.range = R'.corootWeylGroup hdiag := by
    refine le_antisymm ?_ ?_
    · rintro _ ⟨w, rfl⟩
      induction w using R.weylGroup_induction with
      | one => rw [map_one]; exact one_mem _
      | simple i => rw [hsimple]; exact R'.simpleCoreflection_mem_corootWeylGroup hdiag i
      | mul u v ihu ihv => rw [map_mul]; exact mul_mem ihu ihv
    · rw [corootWeylGroup, Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩; exact ⟨R.weylSimple hdiag i, hsimple i⟩
  exact (MonoidHom.ofInjective hinj).trans <|
    (MulEquiv.subgroupCongr hrange).trans (R'.corootWeylEquiv hdiag)

@[simp]
theorem restrictWeylEquiv_weylSimple (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (i : I) :
    R.restrictWeylEquiv hdiag M hc hs (R.weylSimple hdiag i) =
      (R.restrict M hc hs).weylSimple hdiag i := by
  let R' := R.restrict M hc hs
  have hval : (R'.corootWeylEquiv hdiag).symm
      (R.restrictWeylEquiv hdiag M hc hs (R.weylSimple hdiag i)) =
        ⟨R'.simpleCoreflection hdiag i, R'.simpleCoreflection_mem_corootWeylGroup hdiag i⟩ := by
    apply Subtype.ext
    rw [restrictWeylEquiv, MulEquiv.trans_apply, MulEquiv.trans_apply, MulEquiv.symm_apply_apply,
      MulEquiv.subgroupCongr_apply, MonoidHom.ofInjective_apply]
    ext m; simp [R', simpleCoreflection_apply]
  have hval' : (R'.corootWeylEquiv hdiag).symm (R'.weylSimple hdiag i) =
      ⟨R'.simpleCoreflection hdiag i, R'.simpleCoreflection_mem_corootWeylGroup hdiag i⟩ :=
    (MulEquiv.symm_apply_eq (R'.corootWeylEquiv hdiag)).mpr
      (R'.corootWeylEquiv_simpleCoreflection hdiag i).symm
  exact (R'.corootWeylEquiv hdiag).symm.injective (hval.trans hval'.symm)

/-- `M.subtype.dualMap` intertwines the `R.weylGroup` action on `Dual K H` with the restricted
`weylGroup` action on `Dual K M`. -/
theorem subtype_dualMap_smul (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (w : R.weylGroup hdiag) (φ : Dual K H) :
    M.subtype.dualMap (w • φ) = R.restrictWeylEquiv hdiag M hc hs w • M.subtype.dualMap φ := by
  induction w using R.weylGroup_induction generalizing φ with
  | one => simp
  | simple i =>
    rw [restrictWeylEquiv_weylSimple, weylSimple_smul, weylSimple_smul,
      subtype_dualMap_simpleReflection]
  | mul u v ihu ihv => rw [mul_smul, ihu, ihv, map_mul, mul_smul]

omit hdiag in
/-- Every element of `R.rootLattice` vanishes on the Cartan center. -/
theorem eval_eq_zero_of_mem_rootLattice {φ : Dual K H} (hφ : φ ∈ R.rootLattice)
    {z : H} (hz : z ∈ R.cartanCenter) : φ z = 0 := by
  rw [R.rootLattice_def] at hφ
  induction hφ using Submodule.span_induction with
  | mem _ hx => obtain ⟨i, rfl⟩ := hx; exact (R.mem_cartanCenter_iff z).mp hz i
  | zero => rfl
  | add _ _ _ _ ihx ihy => simp [ihx, ihy]
  | smul n _ _ ihx => simp [ihx]

omit hdiag in
/-- Restriction of functionals from `H` to `M` identifies `R.rootLattice` with
`(R.restrict M hc hs).rootLattice` as `ℤ`-modules. -/
noncomputable def restrictRootLatticeEquiv (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) :
    R.rootLattice ≃ₗ[ℤ] (R.restrict M hc hs).rootLattice := by
  let f : Dual K H →ₗ[ℤ] Dual K M := M.subtype.dualMap.restrictScalars ℤ
  have hcomp : f ∘ R.root = (R.restrict M hc hs).root := by ext i m; simp [f]
  have hmap : R.rootLattice.map f = (R.restrict M hc hs).rootLattice := by
    rw [R.rootLattice_def, (R.restrict M hc hs).rootLattice_def, Submodule.map_span,
      ← Set.range_comp, hcomp]
  let g : R.rootLattice →ₗ[ℤ] (R.restrict M hc hs).rootLattice :=
    { toFun φ := ⟨M.subtype.dualMap φ.1, hmap ▸ Submodule.mem_map_of_mem φ.2⟩
      map_add' _ _ := Subtype.ext (map_add _ _ _)
      map_smul' _ _ := Subtype.ext (map_zsmul _ _ _) }
  refine LinearEquiv.ofBijective g ⟨fun φ₁ φ₂ h12 ↦ Subtype.ext ?_, fun ψ ↦ ?_⟩
  · rw [← sub_eq_zero]
    ext x
    obtain ⟨m, hm, z, hz, rfl⟩ := Submodule.mem_sup.mp (hs ▸ Submodule.mem_top : x ∈ _)
    have hm' : (φ₁.1 - φ₂.1) m = 0 := by
      simpa [g, sub_eq_zero] using
        congrArg (fun ξ : Dual K M ↦ ξ ⟨m, hm⟩) (congrArg Subtype.val h12)
    rw [map_add, hm', R.eval_eq_zero_of_mem_rootLattice (sub_mem φ₁.2 φ₂.2) hz, add_zero,
      LinearMap.zero_apply]
  · obtain ⟨φ, hφ, hφψ⟩ := Submodule.mem_map.mp (hmap.symm ▸ ψ.2 : ψ.1 ∈ R.rootLattice.map f)
    exact ⟨⟨φ, hφ⟩, Subtype.ext hφψ⟩

@[simp]
theorem coe_restrictRootLatticeEquiv (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (φ : R.rootLattice) :
    ((R.restrictRootLatticeEquiv M hc hs φ : (R.restrict M hc hs).rootLattice) : Dual K M) =
      M.subtype.dualMap φ := (rfl)

end SimpleReflections

/-! ### Stability of lattices and the braid relations -/

section IntegralMatrix

/-- Casting an integral matrix with diagonal `2` yields a matrix over `K` with diagonal `2`. -/
theorem mapIntCast_diag {I K : Type*} [Ring K] {A : Matrix I I ℤ} (hdiag : ∀ i, A i i = 2)
    (i : I) : (A.map (Int.cast : ℤ → K)) i i = 2 := by simp [hdiag i]

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-- Every functional in `R.rootLattice` takes integer-cast values on simple coroots. -/
theorem exists_intCast_eval_coroot_of_mem_rootLattice {φ : Dual K H} (hφ : φ ∈ R.rootLattice)
    (i : I) : ∃ n : ℤ, (n : K) = φ (R.coroot i) := by
  rw [R.rootLattice_def] at hφ
  induction hφ using Submodule.span_induction with
  | mem _ hx => obtain ⟨j, rfl⟩ := hx; exact ⟨A i j, by simp⟩
  | zero => exact ⟨0, by simp⟩
  | add _ _ _ _ ihx ihy =>
    obtain ⟨nx, hnx⟩ := ihx; obtain ⟨ny, hny⟩ := ihy
    exact ⟨nx + ny, by simp [← hnx, ← hny]⟩
  | smul c _ _ ihx => obtain ⟨nx, hnx⟩ := ihx; exact ⟨c * nx, by simp [← hnx]⟩

/-- The Weyl group stabilizes the root lattice `Q`. -/
theorem smul_mem_rootLattice (hdiag : ∀ i, A i i = 2)
    (w : R.weylGroup (mapIntCast_diag hdiag)) {φ : Dual K H} (hφ : φ ∈ R.rootLattice) :
    w • φ ∈ R.rootLattice := by
  induction w using R.weylGroup_induction generalizing φ with
  | one => simpa using hφ
  | simple i =>
    obtain ⟨n, hn⟩ := R.exists_intCast_eval_coroot_of_mem_rootLattice hφ i
    rw [weylSimple_smul, simpleReflection_apply, ← hn, Int.cast_smul_eq_zsmul K n (R.root i)]
    exact sub_mem hφ (Submodule.smul_mem _ n (R.root_mem_rootLattice i))
  | mul u v ihu ihv => rw [mul_smul]; exact ihu (ihv hφ)

@[simp]
theorem smul_mem_rootLattice_iff (hdiag : ∀ i, A i i = 2)
    (w : R.weylGroup (mapIntCast_diag hdiag)) {φ : Dual K H} :
    w • φ ∈ R.rootLattice ↔ φ ∈ R.rootLattice :=
  ⟨fun h ↦ by simpa using R.smul_mem_rootLattice hdiag w⁻¹ h, R.smul_mem_rootLattice hdiag w⟩

/-- The action of `R.weylGroup` on the root lattice `Q` by `ℤ`-linear automorphisms. -/
def rootLatticeAction (hdiag : ∀ i, A i i = 2) :
    R.weylGroup (mapIntCast_diag hdiag) →* (R.rootLattice ≃ₗ[ℤ] R.rootLattice) where
  toFun w :=
    { toFun φ := ⟨w • φ.1, R.smul_mem_rootLattice hdiag w φ.2⟩
      invFun φ := ⟨w⁻¹ • φ.1, R.smul_mem_rootLattice hdiag w⁻¹ φ.2⟩
      left_inv φ := Subtype.ext (inv_smul_smul w φ.1)
      right_inv φ := Subtype.ext (smul_inv_smul w φ.1)
      map_add' _ _ := Subtype.ext (smul_add w _ _)
      map_smul' _ _ := Subtype.ext (smul_comm w _ _) }
  map_one' := by ext; simp
  map_mul' _ _ := by ext; simp [mul_smul]

@[simp]
theorem coe_rootLatticeAction_apply (hdiag : ∀ i, A i i = 2)
    (w : R.weylGroup (mapIntCast_diag hdiag)) (φ : R.rootLattice) :
    (R.rootLatticeAction hdiag w φ : Dual K H) = w • (φ : Dual K H) := (rfl)

/-- `restrictRootLatticeEquiv` is equivariant with respect to `restrictWeylEquiv`. -/
theorem restrictRootLatticeEquiv_smul (hdiag : ∀ i, A i i = 2)
    (M : Submodule K H) (hc : R.corootSpan ≤ M) (hs : M ⊔ R.cartanCenter = ⊤)
    (w : R.weylGroup (mapIntCast_diag hdiag)) (φ : R.rootLattice) :
    R.restrictRootLatticeEquiv M hc hs (R.rootLatticeAction hdiag w φ) =
      (R.restrict M hc hs).rootLatticeAction hdiag
        (R.restrictWeylEquiv (mapIntCast_diag hdiag) M hc hs w)
        (R.restrictRootLatticeEquiv M hc hs φ) := by
  ext m
  simp only [coe_restrictRootLatticeEquiv, coe_rootLatticeAction_apply,
    R.subtype_dualMap_smul (mapIntCast_diag hdiag) M hc hs w φ]

/-! #### Stability of coweight and weight lattices -/

namespace CoweightLattice

variable {H : Type*} [AddCommGroup H] [Module ℚ H] {A : Matrix I I ℤ}
  {R : CartanRealization (A.map (Int.cast : ℤ → ℚ)) H} (L : R.CoweightLattice)

/-- The dual Weyl action on `H` stabilizes every coweight lattice `Y = L.lattice`. -/
theorem corootAction_mem_lattice (hdiag : ∀ i, A i i = 2)
    (w : R.weylGroup (mapIntCast_diag hdiag)) {y : H} (hy : y ∈ L.lattice) :
    R.corootAction (mapIntCast_diag hdiag) w y ∈ L.lattice := by
  induction w using R.weylGroup_induction generalizing y with
  | one => simpa using hy
  | simple i =>
    rw [corootAction_weylSimple, simpleCoreflection_apply]
    have hpair := L.cast_pairing (L.root i) ⟨y, hy⟩
    rw [L.coe_root] at hpair
    rw [← hpair, Int.cast_smul_eq_zsmul ℚ _ (R.coroot i)]
    exact sub_mem hy (L.lattice.smul_mem _ (L.coroot_mem i))
  | mul u v ihu ihv => rw [map_mul, mul_apply_eq_comp]; exact ihu (ihv hy)

@[simp]
theorem corootAction_mem_lattice_iff (hdiag : ∀ i, A i i = 2)
    (w : R.weylGroup (mapIntCast_diag hdiag)) {y : H} :
    R.corootAction (mapIntCast_diag hdiag) w y ∈ L.lattice ↔ y ∈ L.lattice :=
  ⟨fun hy ↦ by simpa [← mul_apply_eq_comp, ← map_mul] using
      L.corootAction_mem_lattice hdiag w⁻¹ hy, L.corootAction_mem_lattice hdiag w⟩

/-- The Weyl group stabilizes the weight lattice `P = L.weightLattice`. -/
theorem smul_mem_weightLattice (hdiag : ∀ i, A i i = 2)
    (w : R.weylGroup (mapIntCast_diag hdiag)) {φ : Dual ℚ H} (hφ : φ ∈ L.weightLattice) :
    w • φ ∈ L.weightLattice := by
  rw [L.mem_weightLattice_iff] at hφ ⊢
  intro y hy
  rw [R.smul_apply_eq_apply_corootAction_inv]
  exact hφ _ (L.corootAction_mem_lattice hdiag w⁻¹ hy)

@[simp]
theorem smul_mem_weightLattice_iff (hdiag : ∀ i, A i i = 2)
    (w : R.weylGroup (mapIntCast_diag hdiag)) {φ : Dual ℚ H} :
    w • φ ∈ L.weightLattice ↔ φ ∈ L.weightLattice :=
  ⟨fun hφ ↦ by simpa using L.smul_mem_weightLattice hdiag w⁻¹ hφ, L.smul_mem_weightLattice hdiag w⟩

/-- The action of `R.weylGroup` on the coweight lattice `Y = L.lattice`. -/
noncomputable def coweightAction (hdiag : ∀ i, A i i = 2) :
    R.weylGroup (mapIntCast_diag hdiag) →* (L.lattice ≃ₗ[ℤ] L.lattice) where
  toFun w :=
    { toFun y := ⟨R.corootAction (mapIntCast_diag hdiag) w y.1,
        L.corootAction_mem_lattice hdiag w y.2⟩
      invFun y := ⟨R.corootAction (mapIntCast_diag hdiag) w⁻¹ y.1,
        L.corootAction_mem_lattice hdiag w⁻¹ y.2⟩
      left_inv y := Subtype.ext <| by
        dsimp only; rw [← mul_apply_eq_comp, ← map_mul, inv_mul_cancel, map_one, one_apply_eq_self]
      right_inv y := Subtype.ext <| by
        dsimp only; rw [← mul_apply_eq_comp, ← map_mul, mul_inv_cancel, map_one, one_apply_eq_self]
      map_add' _ _ := Subtype.ext (map_add _ _ _)
      map_smul' _ _ := Subtype.ext (map_zsmul _ _ _) }
  map_one' := by ext; simp
  map_mul' _ _ := by ext; simp [map_mul]

@[simp]
theorem coe_coweightAction_apply (hdiag : ∀ i, A i i = 2)
    (w : R.weylGroup (mapIntCast_diag hdiag)) (y : L.lattice) :
    (L.coweightAction hdiag w y : H) = R.corootAction (mapIntCast_diag hdiag) w y := (rfl)

/-- The action of `R.weylGroup` on the weight lattice `P = L.weightLattice`. -/
def weightAction (hdiag : ∀ i, A i i = 2) :
    R.weylGroup (mapIntCast_diag hdiag) →* (L.weightLattice ≃ₗ[ℤ] L.weightLattice) where
  toFun w :=
    { toFun φ := ⟨w • φ.1, L.smul_mem_weightLattice hdiag w φ.2⟩
      invFun φ := ⟨w⁻¹ • φ.1, L.smul_mem_weightLattice hdiag w⁻¹ φ.2⟩
      left_inv φ := Subtype.ext (inv_smul_smul w φ.1)
      right_inv φ := Subtype.ext (smul_inv_smul w φ.1)
      map_add' _ _ := Subtype.ext (smul_add w _ _)
      map_smul' _ _ := Subtype.ext (smul_comm w _ _) }
  map_one' := by ext; simp
  map_mul' _ _ := by ext; simp [mul_smul]

@[simp]
theorem coe_weightAction_apply (hdiag : ∀ i, A i i = 2)
    (w : R.weylGroup (mapIntCast_diag hdiag)) (φ : L.weightLattice) :
    (L.weightAction hdiag w φ : Dual ℚ H) = w • (φ : Dual ℚ H) := (rfl)

@[simp]
theorem pairing_weightAction_coweightAction (hdiag : ∀ i, A i i = 2)
    (w : R.weylGroup (mapIntCast_diag hdiag)) (φ : L.weightLattice) (y : L.lattice) :
    L.pairing (L.weightAction hdiag w φ) (L.coweightAction hdiag w y) = L.pairing φ y := by
  refine Int.cast_injective (α := ℚ) ?_
  rw [L.cast_pairing, L.cast_pairing]
  exact R.smul_apply_corootAction (mapIntCast_diag hdiag) w φ.1 y.1

end CoweightLattice

/-! #### The braid relations and lifting from the Coxeter group -/

/-- Orthogonal simple reflections commute when `A i j = 0` and `A j i = 0`. -/
theorem commute_simpleReflection_of_eq_zero (hdiag : ∀ i, A i i = 2) {i j : I}
    (hij : A i j = 0) (hji : A j i = 0) :
    Commute (R.simpleReflection (mapIntCast_diag hdiag) i)
      (R.simpleReflection (mapIntCast_diag hdiag) j) := by
  refine LinearEquiv.ext fun φ ↦ ?_
  simp only [mul_apply_eq_comp, simpleReflection_apply, LinearMap.sub_apply, LinearMap.smul_apply,
    R.root_coroot, Matrix.map_apply, hij, hji, Int.cast_zero, smul_zero, sub_zero]
  exact sub_right_comm _ _ _

/-- **The braid relations for simple linear reflections** (with `Module.reflection` over any field
`K`): whenever `A` has diagonal `2` and symmetric zero pattern,
`(sᵢ * sⱼ) ^ (cartanCoxeterMatrix A i j) = 1`. -/
theorem simpleReflection_mul_simpleReflection_pow (hdiag : ∀ i, A i i = 2)
    (hzero : ∀ i j, A i j = 0 ↔ A j i = 0) (i j : I) :
    (R.simpleReflection (mapIntCast_diag hdiag) i *
        R.simpleReflection (mapIntCast_diag hdiag) j) ^ cartanCoxeterMatrix A i j = 1 := by
  rcases eq_or_ne i j with rfl | hij
  · simp
  rw [cartanCoxeterMatrix_of_ne A hij]
  split_ifs with hle
  · set c : ℤ := A i j * A j i
    rcases lt_or_ge c 0 with hlt | hge
    · have h0 : coxeterOrder c = 0 := coxeterOrder_eq_zero_iff.mpr <| by
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff]; omega
      simp [h0]
    · have hfi : Dual.eval K H (R.coroot i) (R.root i) = 2 := by simp [hdiag i]
      have hfj : Dual.eval K H (R.coroot j) (R.root j) = 2 := by simp [hdiag j]
      have hprod : Dual.eval K H (R.coroot i) (R.root j) *
          Dual.eval K H (R.coroot j) (R.root i) = (c : K) := by simp [c]
      rcases (by omega : c = 0 ∨ c = 1 ∨ c = 2 ∨ c = 3) with hc | hc | hc | hc
      · have haij : A i j = 0 := (mul_eq_zero.mp hc).elim id (hzero i j).mpr
        have hcomm := R.commute_simpleReflection_of_eq_zero hdiag haij ((hzero i j).mp haij)
        rw [hc, coxeterOrder_zero, hcomm.mul_pow, sq, sq, simpleReflection_mul_self,
          simpleReflection_mul_self, one_mul]
      · rw [hc, coxeterOrder_one]
        refine LinearEquiv.ext fun φ ↦ ?_
        simpa [simpleReflection, S_zero, S_one] using
          Module.reflection_mul_reflection_pow_apply hfi hfj 3 φ (-1 : K)
            (by rw [hprod, hc]; norm_num)
      · rw [hc, coxeterOrder_two]
        refine LinearEquiv.ext fun φ ↦ ?_
        simpa [simpleReflection, S_zero, S_one] using
          Module.reflection_mul_reflection_pow_apply hfi hfj 4 φ (0 : K)
            (by rw [hprod, hc]; norm_num)
      · rw [hc, coxeterOrder_three]
        refine LinearEquiv.ext fun φ ↦ ?_
        simpa [simpleReflection, S_two] using
          Module.reflection_mul_reflection_pow_apply hfi hfj 6 φ (1 : K)
            (by rw [hprod, hc]; norm_num)
  · simp

/-- **The braid relations in the Weyl group**: `(sᵢ * sⱼ) ^ (cartanCoxeterMatrix A i j) = 1`. -/
@[simp]
theorem weylSimple_mul_weylSimple_pow (hdiag : ∀ i, A i i = 2)
    (hzero : ∀ i j, A i j = 0 ↔ A j i = 0) (i j : I) :
    (R.weylSimple (mapIntCast_diag hdiag) i * R.weylSimple (mapIntCast_diag hdiag) j) ^
        cartanCoxeterMatrix A i j = 1 :=
  Subtype.ext (by simpa using R.simpleReflection_mul_simpleReflection_pow hdiag hzero i j)

/-- The canonical group homomorphism from `(cartanCoxeterMatrix A).Group` to `R.weylGroup`, sending
each Coxeter generator `i` to `R.weylSimple _ i`. -/
noncomputable def coxeterToWeyl (hdiag : ∀ i, A i i = 2)
    (hzero : ∀ i j, A i j = 0 ↔ A j i = 0) :
    (cartanCoxeterMatrix A).Group →* R.weylGroup (mapIntCast_diag hdiag) :=
  (cartanCoxeterMatrix A).toCoxeterSystem.lift
    ⟨R.weylSimple (mapIntCast_diag hdiag),
      fun i j ↦ R.weylSimple_mul_weylSimple_pow hdiag hzero i j⟩

@[simp]
theorem coxeterToWeyl_simple (hdiag : ∀ i, A i i = 2)
    (hzero : ∀ i j, A i j = 0 ↔ A j i = 0) (i : I) :
    R.coxeterToWeyl hdiag hzero ((cartanCoxeterMatrix A).simple i) =
      R.weylSimple (mapIntCast_diag hdiag) i :=
  (cartanCoxeterMatrix A).toCoxeterSystem.lift_apply_simple _ i

/-- `coxeterToWeyl` is surjective onto `R.weylGroup`. -/
theorem coxeterToWeyl_surjective (hdiag : ∀ i, A i i = 2)
    (hzero : ∀ i j, A i j = 0 ↔ A j i = 0) :
    Function.Surjective (R.coxeterToWeyl hdiag hzero) := by
  rw [← MonoidHom.range_eq_top, MonoidHom.range_eq_map,
    ← CoxeterMatrix.subgroupClosure_range_simple, MonoidHom.map_closure, ← Set.range_comp]
  have hcomp : R.coxeterToWeyl hdiag hzero ∘ (cartanCoxeterMatrix A).simple =
      R.weylSimple (mapIntCast_diag hdiag) := funext (R.coxeterToWeyl_simple hdiag hzero)
  rw [hcomp, R.closure_range_weylSimple]

end IntegralMatrix

