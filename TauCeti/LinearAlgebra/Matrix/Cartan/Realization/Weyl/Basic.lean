module

public import Mathlib.LinearAlgebra.Reflection
public import TauCeti.LinearAlgebra.Matrix.Cartan.Realization.RootLattice

/-!
# Simple reflections and the Weyl group of a Cartan realization

Let `R : CartanRealization A H` be a realization of a matrix `A` with diagonal entries `2` over a
field `K`, with simple coroots `hᵢ ∈ H` and simple roots `αᵢ ∈ H*` paired by `αⱼ(hᵢ) = A i j`.
Each node `i` defines two involutive linear equivalences via `Module.reflection`:

* the **simple reflection** `sᵢ(φ) = φ - φ(hᵢ) • αᵢ` on the dual space `Dual K H`;
* the **simple coreflection** `sᵢ(h) = h - αᵢ(h) • hᵢ` on the ambient space `H`.

The two reflections are contragredient (`(sᵢ φ) h = φ (sᵢ h)`), preserve the evaluation pairing,
and fix the Cartan center `R.cartanCenter` pointwise on `H`.

The **Weyl group** `R.weylGroup hdiag` is the subgroup of `Dual K H ≃ₗ[K] Dual K H` generated by
the simple reflections, equipped with its word-length function `R.weylLength hdiag` in the simple
generators. Without assuming finite dimensionality of `H` or finiteness of `I`, precomposition
with the inverse gives an injective contragredient homomorphism `(H ≃ₗ[K] H) →* (Dual K H ≃ₗ[K]
Dual K H)` matching each coreflection with the corresponding simple reflection. Inverting this
isomorphism on the generated subgroups yields a faithful ambient action
`R.ambientAction hdiag : R.weylGroup hdiag →* (H ≃ₗ[K] H)` preserving evaluation, fixing
`R.cartanCenter` pointwise, and stabilizing `R.corootSpan` together with every subspace containing
it.

For an integral matrix `A`, the Weyl group stabilizes the root lattice `R.rootLattice`, and for a
coweight lattice `L : R.CoweightLattice` of a rational realization it stabilizes both `L.lattice`
and `L.weightLattice` while preserving `L.pairing`. Finally, `R.weylGroup hdiag`,
`R.weylLength hdiag`, and the action on the root lattice are canonically invariant under linear
equivalences `R.map e` and under admissible restrictions `R.restrict M hc hs` (so enlarging a
minimal realization by central directions leaves the Weyl group and its root-lattice action
unchanged).

## Main definitions

* `TauCeti.CartanRealization.simpleReflection`: the simple reflection on `Dual K H` at `i`.
* `TauCeti.CartanRealization.coreflection`: the simple coreflection on `H` at `i`.
* `TauCeti.CartanRealization.weylGroup`: the subgroup of `Dual K H ≃ₗ[K] Dual K H` generated by
  the simple reflections.
* `TauCeti.CartanRealization.weylSimple`: the `i`-th simple reflection as an element of
  `R.weylGroup hdiag`.
* `TauCeti.CartanRealization.ambientAction`: the contragredient action of `R.weylGroup hdiag` on
  `H`.
* `TauCeti.CartanRealization.weylLength`: the word-length function on `R.weylGroup hdiag`.
* `TauCeti.CartanRealization.rootLatticeAction`,
  `TauCeti.CartanRealization.CoweightLattice.coweightAction`,
  `TauCeti.CartanRealization.CoweightLattice.weightAction`: the induced integral actions on `Q`,
  `Y`, and `P`.
* `TauCeti.CartanRealization.mapWeylGroupEquiv`,
  `TauCeti.CartanRealization.restrictWeylGroupEquiv`,
  `TauCeti.CartanRealization.restrictRootLatticeEquiv`: invariance under transport and central
  enlargement.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, §§3.7–3.11.
-/

public section

open Module

namespace TauCeti

namespace CartanRealization

section Reflections

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I K}
  (R : CartanRealization A H) (hdiag : ∀ i, A i i = 2)

/-- The **simple reflection** `sᵢ(φ) = φ - φ(hᵢ) • αᵢ` on the dual space `Dual K H`. -/
def simpleReflection (i : I) : Dual K H ≃ₗ[K] Dual K H :=
  Module.reflection (f := Dual.eval K H (R.coroot i)) (x := R.root i) <| by
    simp [hdiag i]

/-- The **simple coreflection** `sᵢ(h) = h - αᵢ(h) • hᵢ` on the ambient space `H`. -/
def coreflection (i : I) : H ≃ₗ[K] H :=
  Module.reflection (f := R.root i) (x := R.coroot i) <| by
    simp [hdiag i]

theorem simpleReflection_eq_reflection (i : I)
    (hf : Dual.eval K H (R.coroot i) (R.root i) = 2 := by simp [hdiag i]) :
    R.simpleReflection hdiag i = Module.reflection hf := (rfl)

theorem coreflection_eq_reflection (i : I)
    (hf : R.root i (R.coroot i) = 2 := by simp [hdiag i]) :
    R.coreflection hdiag i = Module.reflection hf := (rfl)

theorem simpleReflection_apply (i : I) (φ : Dual K H) :
    R.simpleReflection hdiag i φ = φ - φ (R.coroot i) • R.root i :=
  Module.reflection_apply _ _

theorem coreflection_apply (i : I) (h : H) :
    R.coreflection hdiag i h = h - R.root i h • R.coroot i :=
  Module.reflection_apply _ _

theorem simpleReflection_root (i j : I) :
    R.simpleReflection hdiag i (R.root j) = R.root j - A i j • R.root i := by
  rw [simpleReflection_apply, R.root_coroot]

theorem coreflection_coroot (i j : I) :
    R.coreflection hdiag i (R.coroot j) = R.coroot j - A j i • R.coroot i := by
  rw [coreflection_apply, R.root_coroot]

@[simp]
theorem simpleReflection_root_self (i : I) :
    R.simpleReflection hdiag i (R.root i) = -R.root i :=
  Module.reflection_apply_self _

@[simp]
theorem coreflection_coroot_self (i : I) :
    R.coreflection hdiag i (R.coroot i) = -R.coroot i :=
  Module.reflection_apply_self _

@[simp]
theorem simpleReflection_simpleReflection (i : I) (φ : Dual K H) :
    R.simpleReflection hdiag i (R.simpleReflection hdiag i φ) = φ :=
  Module.involutive_reflection _ φ

@[simp]
theorem coreflection_coreflection (i : I) (h : H) :
    R.coreflection hdiag i (R.coreflection hdiag i h) = h :=
  Module.involutive_reflection _ h

@[simp]
theorem simpleReflection_symm (i : I) :
    (R.simpleReflection hdiag i).symm = R.simpleReflection hdiag i :=
  Module.reflection_symm _

@[simp]
theorem coreflection_symm (i : I) :
    (R.coreflection hdiag i).symm = R.coreflection hdiag i :=
  Module.reflection_symm _

@[simp]
theorem simpleReflection_inv (i : I) :
    (R.simpleReflection hdiag i)⁻¹ = R.simpleReflection hdiag i :=
  Module.reflection_inv _

@[simp]
theorem coreflection_inv (i : I) :
    (R.coreflection hdiag i)⁻¹ = R.coreflection hdiag i :=
  Module.reflection_inv _

@[simp]
theorem simpleReflection_mul_self (i : I) :
    R.simpleReflection hdiag i * R.simpleReflection hdiag i = 1 :=
  LinearEquiv.ext (R.simpleReflection_simpleReflection hdiag i)

@[simp]
theorem coreflection_mul_self (i : I) :
    R.coreflection hdiag i * R.coreflection hdiag i = 1 :=
  LinearEquiv.ext (R.coreflection_coreflection hdiag i)

/-- A functional vanishing on `hᵢ` is fixed by the simple reflection `sᵢ`. -/
theorem simpleReflection_of_apply_coroot_eq_zero {i : I} {φ : Dual K H}
    (hφ : φ (R.coroot i) = 0) : R.simpleReflection hdiag i φ = φ := by
  rw [simpleReflection_apply, hφ, zero_smul, sub_zero]

/-- A vector annihilated by `αᵢ` is fixed by the simple coreflection `sᵢ`. -/
theorem coreflection_of_root_apply_eq_zero {i : I} {h : H} (hh : R.root i h = 0) :
    R.coreflection hdiag i h = h := by
  rw [coreflection_apply, hh, zero_smul, sub_zero]

/-- Every simple coreflection fixes the Cartan center pointwise. -/
theorem coreflection_of_mem_cartanCenter (i : I) {h : H} (hh : h ∈ R.cartanCenter) :
    R.coreflection hdiag i h = h :=
  R.coreflection_of_root_apply_eq_zero hdiag ((R.mem_cartanCenter_iff h).mp hh i)

/-- The simple reflection on `Dual K H` and the simple coreflection on `H` are adjoint for the
evaluation pairing. -/
theorem simpleReflection_apply_apply (i : I) (φ : Dual K H) (h : H) :
    R.simpleReflection hdiag i φ h = φ (R.coreflection hdiag i h) := by
  simp only [simpleReflection_apply, coreflection_apply, LinearMap.sub_apply, LinearMap.smul_apply,
    map_sub, map_smul, smul_eq_mul]
  ring

/-- Simple reflections and coreflections preserve the evaluation pairing: `(sᵢ φ)(sᵢ h) = φ(h)`. -/
@[simp]
theorem simpleReflection_apply_coreflection (i : I) (φ : Dual K H) (h : H) :
    R.simpleReflection hdiag i φ (R.coreflection hdiag i h) = φ h := by
  rw [simpleReflection_apply_apply, coreflection_coreflection]

/-- Whenever `(2 : K) ≠ 0`, no simple reflection is the identity. -/
theorem simpleReflection_ne_one [NeZero (2 : K)] (i : I) : R.simpleReflection hdiag i ≠ 1 := by
  intro h
  have hi := congr(($(h) (R.root i)) (R.coroot i))
  simp only [simpleReflection_root_self, LinearMap.neg_apply, one_apply_eq_self, root_coroot,
    hdiag i] at hi
  have hsq : (2 : K) * 2 = 0 := by linear_combination -hi
  exact two_ne_zero (mul_self_eq_zero.mp hsq)

/-! ### The Weyl group and its contragredient ambient action -/

/-- The **Weyl group** of a realization: the subgroup of `Dual K H ≃ₗ[K] Dual K H` generated by
the simple reflections. -/
def weylGroup : Subgroup (Dual K H ≃ₗ[K] Dual K H) :=
  Subgroup.closure (Set.range (R.simpleReflection hdiag))

theorem weylGroup_def :
    R.weylGroup hdiag = Subgroup.closure (Set.range (R.simpleReflection hdiag)) := (rfl)

/-- The `i`-th simple reflection as an element of the Weyl group. -/
def weylSimple (i : I) : R.weylGroup hdiag :=
  ⟨R.simpleReflection hdiag i, Subgroup.subset_closure (Set.mem_range_self i)⟩

@[simp]
theorem coe_weylSimple (i : I) :
    (R.weylSimple hdiag i : Dual K H ≃ₗ[K] Dual K H) = R.simpleReflection hdiag i := (rfl)

@[simp]
theorem weylSimple_mul_self (i : I) :
    R.weylSimple hdiag i * R.weylSimple hdiag i = 1 :=
  Subtype.ext (R.simpleReflection_mul_self hdiag i)

@[simp]
theorem weylSimple_inv (i : I) :
    (R.weylSimple hdiag i)⁻¹ = R.weylSimple hdiag i :=
  Subtype.ext (R.simpleReflection_inv hdiag i)

/-- Whenever `(2 : K) ≠ 0`, no simple reflection in the Weyl group is the identity. -/
theorem weylSimple_ne_one [NeZero (2 : K)] (i : I) : R.weylSimple hdiag i ≠ 1 := fun h ↦
  R.simpleReflection_ne_one hdiag i (congrArg Subtype.val h)

/-- The simple reflections generate the Weyl group. -/
theorem closure_range_weylSimple : Subgroup.closure (Set.range (R.weylSimple hdiag)) = ⊤ := by
  rw [eq_top_iff]
  rintro ⟨w, hw⟩ -
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact Subgroup.subset_closure (Set.mem_range_self i)
  | one => exact one_mem _
  | mul _ _ _ _ ihx ihy => exact mul_mem ihx ihy
  | inv _ _ ihx => exact inv_mem ihx

/-- Induction on the Weyl group: because each simple reflection is its own inverse, closure under
`1`, the simple reflections, and multiplication suffices. -/
theorem weylGroup_induction {P : R.weylGroup hdiag → Prop} (one : P 1)
    (simple : ∀ i, P (R.weylSimple hdiag i)) (mul : ∀ u v, P u → P v → P (u * v))
    (w : R.weylGroup hdiag) : P w := by
  have hw : w ∈ Subgroup.closure (Set.range (R.weylSimple hdiag)) :=
    (R.closure_range_weylSimple hdiag).symm ▸ Subgroup.mem_top w
  induction hw using Subgroup.closure_induction'' with
  | one => exact one
  | mem _ h =>
    obtain ⟨i, rfl⟩ := h
    exact simple i
  | inv_mem _ h =>
    obtain ⟨i, rfl⟩ := h
    simpa using simple i
  | mul _ _ _ _ ih₁ ih₂ => exact mul _ _ ih₁ ih₂

/-- With an empty index set, the Weyl group is trivial. -/
instance [IsEmpty I] : Subsingleton (R.weylGroup hdiag) := by
  have eq_one : ∀ w : R.weylGroup hdiag, w = 1 :=
    R.weylGroup_induction hdiag (P := fun w ↦ w = 1) rfl isEmptyElim
      (fun _ _ h₁ h₂ ↦ by rw [h₁, h₂, mul_one])
  exact ⟨fun u v ↦ (eq_one u).trans (eq_one v).symm⟩

/-- Precomposition with the inverse linear equivalence, as a covariant homomorphism into the
general linear group of the dual space. -/
private def contragredientHom {V : Type*} [AddCommGroup V] [Module K V] :
    (V ≃ₗ[K] V) →* (Dual K V ≃ₗ[K] Dual K V) where
  toFun e := e.symm.dualMap
  map_one' := LinearEquiv.ext fun _ ↦ LinearMap.ext fun _ ↦ rfl
  map_mul' _ _ := LinearEquiv.ext fun _ ↦ LinearMap.ext fun _ ↦ rfl

private theorem contragredientHom_injective {V : Type*} [AddCommGroup V] [Module K V] :
    Function.Injective (contragredientHom (K := K) (V := V)) := by
  intro e₁ e₂ h
  apply LinearEquiv.symm_bijective.injective
  ext x
  exact (Basis.ofVectorSpace K V).eval_injective (LinearMap.ext fun φ ↦ congr(($(h) φ) x))

private theorem contragredientHom_coreflection (i : I) :
    contragredientHom (R.coreflection hdiag i) = R.simpleReflection hdiag i := by
  ext φ h
  exact (R.simpleReflection_apply_apply hdiag i φ h).symm

private theorem map_contragredientHom_closure_coreflection :
    (Subgroup.closure (Set.range (R.coreflection hdiag))).map contragredientHom =
      R.weylGroup hdiag := by
  rw [MonoidHom.map_closure, ← Set.range_comp]
  exact congrArg Subgroup.closure (congrArg Set.range
    (funext (R.contragredientHom_coreflection hdiag)))

/-- The faithful contragredient action of the Weyl group on the ambient space `H`, sending each
simple reflection `sᵢ` to the simple coreflection `sᵢ` on `H`. No finite-dimensionality assumption
on `H` is needed. -/
noncomputable def ambientAction : R.weylGroup hdiag →* (H ≃ₗ[K] H) :=
  (Subgroup.closure (Set.range (R.coreflection hdiag))).subtype.comp
    ((Subgroup.equivMapOfInjective _ contragredientHom contragredientHom_injective).trans
      (MulEquiv.subgroupCongr
        (R.map_contragredientHom_closure_coreflection hdiag))).symm.toMonoidHom

/-- The dual action of `R.weylGroup hdiag` is precomposition with the inverse of
`R.ambientAction hdiag`. -/
@[simp]
theorem ambientAction_symm_dualMap (w : R.weylGroup hdiag) :
    (R.ambientAction hdiag w).symm.dualMap = (w : Dual K H ≃ₗ[K] Dual K H) := by
  let e := (Subgroup.equivMapOfInjective (Subgroup.closure (Set.range (R.coreflection hdiag)))
    contragredientHom contragredientHom_injective).trans
    (MulEquiv.subgroupCongr (R.map_contragredientHom_closure_coreflection hdiag))
  exact congrArg Subtype.val (e.apply_symm_apply w)

/-- The ambient action of the `i`-th simple reflection is the `i`-th simple coreflection. -/
@[simp]
theorem ambientAction_weylSimple (i : I) :
    R.ambientAction hdiag (R.weylSimple hdiag i) = R.coreflection hdiag i :=
  contragredientHom_injective <| (R.ambientAction_symm_dualMap hdiag _).trans
    (R.contragredientHom_coreflection hdiag i).symm

/-- The contragredient action of the Weyl group on the ambient space `H` is faithful. -/
theorem ambientAction_injective : Function.Injective (R.ambientAction hdiag) := fun u v h ↦
  Subtype.ext <| by
    rw [← R.ambientAction_symm_dualMap hdiag u, ← R.ambientAction_symm_dualMap hdiag v, h]

/-- Every element of the Weyl group preserves the evaluation pairing with `H`:
`(w φ)(w h) = φ(h)`. -/
@[simp]
theorem apply_ambientAction (w : R.weylGroup hdiag) (φ : Dual K H) (h : H) :
    (w : Dual K H ≃ₗ[K] Dual K H) φ (R.ambientAction hdiag w h) = φ h := by
  rw [← R.ambientAction_symm_dualMap hdiag w, LinearEquiv.dualMap_apply,
    LinearEquiv.symm_apply_apply]

/-- Evaluating `w φ` on `h` is evaluating `φ` on `w⁻¹ h`. -/
theorem weylGroup_apply_apply (w : R.weylGroup hdiag) (φ : Dual K H) (h : H) :
    (w : Dual K H ≃ₗ[K] Dual K H) φ h = φ (R.ambientAction hdiag w⁻¹ h) := by
  rw [← R.ambientAction_symm_dualMap hdiag w, LinearEquiv.dualMap_apply, map_inv]
  rfl

/-- **The Weyl group fixes the Cartan center pointwise.** -/
theorem ambientAction_of_mem_cartanCenter (w : R.weylGroup hdiag) {h : H}
    (hh : h ∈ R.cartanCenter) : R.ambientAction hdiag w h = h := by
  refine R.weylGroup_induction hdiag (P := fun w ↦ R.ambientAction hdiag w h = h)
    (by simp) (fun i ↦ ?_) (fun u v ihu ihv ↦ ?_) w
  · rw [ambientAction_weylSimple]
    exact R.coreflection_of_mem_cartanCenter hdiag i hh
  · rw [map_mul, mul_apply_eq_comp, ihv, ihu]

/-- On vectors in the Cartan center, every functional takes the same value before and after a
Weyl-group element acts. -/
theorem weylGroup_apply_of_mem_cartanCenter (w : R.weylGroup hdiag) (φ : Dual K H) {h : H}
    (hh : h ∈ R.cartanCenter) : (w : Dual K H ≃ₗ[K] Dual K H) φ h = φ h := by
  rw [R.weylGroup_apply_apply hdiag, R.ambientAction_of_mem_cartanCenter hdiag w⁻¹ hh]

/-- Every subspace of `H` containing the coroot span is stable under the Weyl group. -/
theorem ambientAction_mem_of_corootSpan_le {M : Submodule K H} (hc : R.corootSpan ≤ M)
    (w : R.weylGroup hdiag) {h : H} (hh : h ∈ M) : R.ambientAction hdiag w h ∈ M := by
  refine R.weylGroup_induction hdiag
    (P := fun w ↦ ∀ x : H, x ∈ M → R.ambientAction hdiag w x ∈ M)
    (fun x hx ↦ by simpa using hx) (fun i x hx ↦ ?_)
    (fun _ _ ihu ihv x hx ↦ by
      rw [map_mul, mul_apply_eq_comp]
      exact ihu _ (ihv x hx)) w h hh
  rw [ambientAction_weylSimple, coreflection_apply]
  exact sub_mem hx (Submodule.smul_mem _ _ (hc (R.coroot_mem_corootSpan i)))

/-- **The Weyl group stabilizes the coroot span.** -/
theorem ambientAction_mem_corootSpan (w : R.weylGroup hdiag) {h : H} (hh : h ∈ R.corootSpan) :
    R.ambientAction hdiag w h ∈ R.corootSpan :=
  R.ambientAction_mem_of_corootSpan_le hdiag le_rfl w hh

/-! ### Word length on the Weyl group -/

/-- The **word length** `ℓ(w)` of an element of the Weyl group: the minimum length of a list of
indices whose simple reflections multiply to `w`. -/
noncomputable def weylLength (w : R.weylGroup hdiag) : ℕ :=
  sInf {n | ∃ l : List I, l.length = n ∧ (l.map (R.weylSimple hdiag)).prod = w}

theorem weylLength_def (w : R.weylGroup hdiag) :
    R.weylLength hdiag w =
      sInf {n | ∃ l : List I, l.length = n ∧ (l.map (R.weylSimple hdiag)).prod = w} := (rfl)

/-- Every element of the Weyl group is a product of a list of simple reflections. -/
theorem exists_word_prod_eq (w : R.weylGroup hdiag) :
    ∃ l : List I, (l.map (R.weylSimple hdiag)).prod = w :=
  R.weylGroup_induction hdiag (P := fun w ↦ ∃ l : List I, (l.map (R.weylSimple hdiag)).prod = w)
    ⟨[], rfl⟩ (fun i ↦ ⟨[i], by simp⟩)
    (fun _ _ ⟨lu, hlu⟩ ⟨lv, hlv⟩ ↦ ⟨lu ++ lv, by simp [hlu, hlv]⟩) w

/-- Every element of the Weyl group is represented by a word attaining its `weylLength`. -/
theorem exists_length_eq_weylLength (w : R.weylGroup hdiag) :
    ∃ l : List I, l.length = R.weylLength hdiag w ∧ (l.map (R.weylSimple hdiag)).prod = w := by
  obtain ⟨l, hl⟩ := R.exists_word_prod_eq hdiag w
  exact Nat.sInf_mem (s := {n | ∃ l : List I, l.length = n ∧ (l.map (R.weylSimple hdiag)).prod = w})
    ⟨l.length, l, rfl, hl⟩

/-- Any word spelling `w` has length at least `R.weylLength hdiag w`. -/
theorem weylLength_le_of_prod_eq {l : List I} {w : R.weylGroup hdiag}
    (hl : (l.map (R.weylSimple hdiag)).prod = w) : R.weylLength hdiag w ≤ l.length :=
  Nat.sInf_le ⟨l, rfl, hl⟩

/-- A list of indices multiplies to `w` in `R.weylGroup hdiag` exactly when the corresponding
linear equivalences multiply to `w` in `Dual K H ≃ₗ[K] Dual K H`. -/
theorem prod_map_weylSimple_eq_iff (l : List I) (w : R.weylGroup hdiag) :
    (l.map (R.weylSimple hdiag)).prod = w ↔
      (l.map (R.simpleReflection hdiag)).prod = (w : Dual K H ≃ₗ[K] Dual K H) := by
  rw [← Subtype.coe_inj]
  simp [Function.comp_def]

@[simp]
theorem weylLength_one : R.weylLength hdiag 1 = 0 :=
  Nat.eq_zero_of_le_zero (R.weylLength_le_of_prod_eq hdiag (l := []) rfl)

@[simp]
theorem weylLength_eq_zero_iff {w : R.weylGroup hdiag} :
    R.weylLength hdiag w = 0 ↔ w = 1 := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ R.weylLength_one hdiag⟩
  obtain ⟨l, hlen, rfl⟩ := R.exists_length_eq_weylLength hdiag w
  rw [h, List.length_eq_zero_iff] at hlen
  simp [hlen]

theorem weylLength_weylSimple_le_one (i : I) :
    R.weylLength hdiag (R.weylSimple hdiag i) ≤ 1 :=
  R.weylLength_le_of_prod_eq hdiag (l := [i]) (by simp)

@[simp]
theorem weylLength_weylSimple [NeZero (2 : K)] (i : I) :
    R.weylLength hdiag (R.weylSimple hdiag i) = 1 := by
  have hle := R.weylLength_weylSimple_le_one hdiag i
  have hne : R.weylLength hdiag (R.weylSimple hdiag i) ≠ 0 :=
    mt (R.weylLength_eq_zero_iff hdiag).mp (R.weylSimple_ne_one hdiag i)
  omega

theorem weylLength_mul_le (u v : R.weylGroup hdiag) :
    R.weylLength hdiag (u * v) ≤ R.weylLength hdiag u + R.weylLength hdiag v := by
  obtain ⟨lu, hlu, rfl⟩ := R.exists_length_eq_weylLength hdiag u
  obtain ⟨lv, hlv, rfl⟩ := R.exists_length_eq_weylLength hdiag v
  simpa [hlu, hlv] using R.weylLength_le_of_prod_eq hdiag (l := lu ++ lv) (by simp)

private theorem prod_map_weylSimple_reverse (l : List I) :
    (l.reverse.map (R.weylSimple hdiag)).prod = ((l.map (R.weylSimple hdiag)).prod)⁻¹ := by
  induction l with
  | nil => simp
  | cons i l ih =>
    rw [List.reverse_cons, List.map_append, List.prod_append, ih]
    simp [mul_inv_rev]

@[simp]
theorem weylLength_inv (w : R.weylGroup hdiag) :
    R.weylLength hdiag w⁻¹ = R.weylLength hdiag w := by
  have key (u : R.weylGroup hdiag) : R.weylLength hdiag u⁻¹ ≤ R.weylLength hdiag u := by
    obtain ⟨l, hl, rfl⟩ := R.exists_length_eq_weylLength hdiag u
    simpa [hl] using R.weylLength_le_of_prod_eq hdiag (R.prod_map_weylSimple_reverse hdiag l)
  exact le_antisymm (key w) (by simpa using key w⁻¹)

end Reflections

/-- Restrict a group action by `K`-linear equivalences on `V` to an invariant `S`-submodule `P`. -/
private def restrictSubmoduleHom {G S K V : Type*} [Group G] [Ring S] [Ring K] [AddCommGroup V]
    [Module S V] [Module K V] [LinearMap.CompatibleSMul V V S K]
    (P : Submodule S V) (ρ : G →* (V ≃ₗ[K] V)) (hP : ∀ g, ∀ x ∈ P, ρ g x ∈ P) :
    G →* (P ≃ₗ[S] P) where
  toFun g := LinearEquiv.ofLinearMap (((ρ g).toLinearMap.restrictScalars S).restrict (hP g))
    (((ρ g⁻¹).toLinearMap.restrictScalars S).restrict (hP g⁻¹))
    (LinearMap.ext fun x ↦ Subtype.ext <| by
      change ρ g (ρ g⁻¹ x) = x
      rw [← mul_apply_eq_comp, ← map_mul, mul_inv_cancel, map_one, one_apply_eq_self])
    (LinearMap.ext fun x ↦ Subtype.ext <| by
      change ρ g⁻¹ (ρ g x) = x
      rw [← mul_apply_eq_comp, ← map_mul, inv_mul_cancel, map_one, one_apply_eq_self])
  map_one' := LinearEquiv.ext fun x ↦ Subtype.ext <| by change ρ 1 x = x; simp
  map_mul' u v := LinearEquiv.ext fun x ↦ Subtype.ext <| by
    change ρ (u * v) x = ρ u (ρ v x)
    rw [map_mul, mul_apply_eq_comp]

/-! ### Integral lattice stability -/

section IntegralLattices

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}

/-- Cast an integral diagonal condition `∀ i, A i i = 2` to `(A.map Int.cast) i i = 2`. -/
theorem diag_map_intCast (hdiag : ∀ i, A i i = 2) :
    ∀ i, (A.map (Int.cast : ℤ → K)) i i = 2 := fun i ↦ by
  simp [hdiag i]

section RootLattice

variable (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)
  (hdiag : ∀ i, (A.map (Int.cast : ℤ → K)) i i = 2)

/-- Every simple reflection stabilizes the root lattice `Q = ⊕ᵢ ℤ αᵢ`. -/
theorem simpleReflection_mem_rootLattice (i : I) {φ : Dual K H} (hφ : φ ∈ R.rootLattice) :
    R.simpleReflection hdiag i φ ∈ R.rootLattice := by
  have hle : Submodule.span ℤ (Set.range R.root) ≤
      R.rootLattice.comap ((R.simpleReflection hdiag i).toLinearMap.restrictScalars ℤ) := by
    rw [Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, Submodule.mem_comap, LinearMap.restrictScalars_apply,
      LinearEquiv.coe_coe, R.simpleReflection_root hdiag i j, Matrix.map_apply,
      Int.cast_smul_eq_zsmul K (A i j) (R.root i)]
    exact sub_mem (R.root_mem_rootLattice j) (Submodule.smul_mem _ _ (R.root_mem_rootLattice i))
  exact hle (R.rootLattice_def ▸ hφ)

/-- **The Weyl group stabilizes the root lattice `Q`.** -/
theorem weylGroup_mem_rootLattice (w : R.weylGroup hdiag) {φ : Dual K H}
    (hφ : φ ∈ R.rootLattice) : (w : Dual K H ≃ₗ[K] Dual K H) φ ∈ R.rootLattice :=
  R.weylGroup_induction hdiag
    (P := fun w ↦ ∀ ξ : Dual K H, ξ ∈ R.rootLattice →
      (w : Dual K H ≃ₗ[K] Dual K H) ξ ∈ R.rootLattice)
    (fun _ hξ ↦ hξ) (fun i _ hξ ↦ R.simpleReflection_mem_rootLattice hdiag i hξ)
    (fun _ _ ihu ihv ξ hξ ↦ by
      rw [Subgroup.coe_mul, mul_apply_eq_comp]
      exact ihu _ (ihv ξ hξ)) w φ hφ

/-- The induced action of the Weyl group on the root lattice `Q` by `ℤ`-linear equivalences. -/
def rootLatticeAction : R.weylGroup hdiag →* (R.rootLattice ≃ₗ[ℤ] R.rootLattice) :=
  restrictSubmoduleHom R.rootLattice (R.weylGroup hdiag).subtype
    (fun w _ ↦ R.weylGroup_mem_rootLattice hdiag w)

@[simp]
theorem coe_rootLatticeAction_apply (w : R.weylGroup hdiag) (φ : R.rootLattice) :
    (R.rootLatticeAction hdiag w φ : Dual K H) = (w : Dual K H ≃ₗ[K] Dual K H) φ := (rfl)

end RootLattice

namespace CoweightLattice

variable [Module ℚ H] {R : CartanRealization (A.map (Int.cast : ℤ → ℚ)) H}
  (L : R.CoweightLattice) (hdiag : ∀ i, (A.map (Int.cast : ℤ → ℚ)) i i = 2)

/-- Every simple coreflection stabilizes the coweight lattice `Y`. -/
theorem coreflection_mem_lattice (i : I) {y : H} (hy : y ∈ L.lattice) :
    R.coreflection hdiag i y ∈ L.lattice := by
  obtain ⟨m, hm⟩ := (L.mem_weightLattice_iff (R.root i)).mp
    (L.weightLattice_def.symm ▸ L.root_mem_dualLattice i) y hy
  rw [R.coreflection_apply hdiag i y, ← hm, Int.cast_smul_eq_zsmul]
  exact sub_mem hy (Submodule.smul_mem _ m (L.coroot_mem i))

/-- **The Weyl group stabilizes the coweight lattice `Y`.** -/
theorem ambientAction_mem_lattice (w : R.weylGroup hdiag) {y : H} (hy : y ∈ L.lattice) :
    R.ambientAction hdiag w y ∈ L.lattice := by
  refine R.weylGroup_induction hdiag
    (P := fun w ↦ ∀ z : H, z ∈ L.lattice → R.ambientAction hdiag w z ∈ L.lattice)
    (fun z hz ↦ by simpa using hz) (fun i z hz ↦ ?_)
    (fun _ _ ihu ihv z hz ↦ by
      rw [map_mul, mul_apply_eq_comp]
      exact ihu _ (ihv z hz)) w y hy
  rw [R.ambientAction_weylSimple hdiag i]
  exact L.coreflection_mem_lattice hdiag i hz

/-- **The Weyl group stabilizes the weight lattice `P = Y*`.** -/
theorem weylGroup_mem_weightLattice (w : R.weylGroup hdiag) {φ : Dual ℚ H}
    (hφ : φ ∈ L.weightLattice) : (w : Dual ℚ H ≃ₗ[ℚ] Dual ℚ H) φ ∈ L.weightLattice := by
  rw [← R.ambientAction_symm_dualMap hdiag w, weightLattice_def]
  exact Submodule.dualMap_mem_dualLattice L.lattice L.lattice
    (R.ambientAction hdiag w).symm.toLinearMap
    (fun y hy ↦ by
      have hw : (R.ambientAction hdiag w).symm y = R.ambientAction hdiag w⁻¹ y := by
        rw [map_inv]; rfl
      exact hw ▸ L.ambientAction_mem_lattice hdiag w⁻¹ hy)
    (L.weightLattice_def ▸ hφ)

/-- The induced action of the Weyl group on the coweight lattice `Y`. -/
noncomputable def coweightAction : R.weylGroup hdiag →* (L.lattice ≃ₗ[ℤ] L.lattice) :=
  restrictSubmoduleHom L.lattice (R.ambientAction hdiag)
    (fun w _ ↦ L.ambientAction_mem_lattice hdiag w)

/-- The induced action of the Weyl group on the weight lattice `P`. -/
def weightAction : R.weylGroup hdiag →* (L.weightLattice ≃ₗ[ℤ] L.weightLattice) :=
  restrictSubmoduleHom L.weightLattice (R.weylGroup hdiag).subtype
    (fun w _ ↦ L.weylGroup_mem_weightLattice hdiag w)

@[simp]
theorem coe_coweightAction_apply (w : R.weylGroup hdiag) (y : L.lattice) :
    (L.coweightAction hdiag w y : H) = R.ambientAction hdiag w y := (rfl)

@[simp]
theorem coe_weightAction_apply (w : R.weylGroup hdiag) (φ : L.weightLattice) :
    (L.weightAction hdiag w φ : Dual ℚ H) = (w : Dual ℚ H ≃ₗ[ℚ] Dual ℚ H) φ := (rfl)

/-- **The Weyl-group actions on `P` and `Y` preserve the perfect integral pairing.** -/
@[simp]
theorem pairing_weightAction_coweightAction (w : R.weylGroup hdiag) (φ : L.weightLattice)
    (y : L.lattice) :
    L.pairing (L.weightAction hdiag w φ) (L.coweightAction hdiag w y) = L.pairing φ y := by
  apply Int.cast_injective (α := ℚ)
  rw [L.cast_pairing, L.cast_pairing, coe_weightAction_apply, coe_coweightAction_apply,
    R.apply_ambientAction hdiag]

end CoweightLattice

end IntegralLattices

/-! ### Invariance under transport and central enlargement -/

section Invariance

variable {I K H H' : Type*} [Field K] [AddCommGroup H] [Module K H]
  [AddCommGroup H'] [Module K H'] {A : Matrix I I K}
  (R : CartanRealization A H) (hdiag : ∀ i, A i i = 2)

/-- Transporting a realization along `e : H ≃ₗ[K] H'` conjugates each simple reflection by
`e.symm.dualMap`. -/
theorem map_simpleReflection (e : H ≃ₗ[K] H') (i : I) :
    (R.map e).simpleReflection hdiag i =
      e.dualMap.trans ((R.simpleReflection hdiag i).trans e.dualMap.symm) := by
  ext φ h'
  simp [simpleReflection_apply]

/-- Transporting a realization along `e : H ≃ₗ[K] H'` induces a canonical isomorphism of Weyl
groups sending simple reflections to simple reflections. -/
noncomputable def mapWeylGroupEquiv (e : H ≃ₗ[K] H') :
    R.weylGroup hdiag ≃* (R.map e).weylGroup hdiag := by
  have h1 (φ : Dual K H) : e.dualMap (e.symm.dualMap φ) = φ := LinearMap.ext fun _ ↦ by simp
  have h2 (φ' : Dual K H') : e.symm.dualMap (e.dualMap φ') = φ' := LinearMap.ext fun _ ↦ by simp
  let conj : (Dual K H ≃ₗ[K] Dual K H) ≃* (Dual K H' ≃ₗ[K] Dual K H') :=
    { toFun g := e.dualMap.trans (g.trans e.dualMap.symm)
      invFun g' := e.dualMap.symm.trans (g'.trans e.dualMap)
      left_inv g := LinearEquiv.ext fun φ ↦ by simp [h1]
      right_inv g' := LinearEquiv.ext fun φ' ↦ by simp [h2]
      map_mul' g₁ g₂ := LinearEquiv.ext fun φ' ↦ by simp [mul_apply_eq_comp, h1] }
  have hmap : (R.weylGroup hdiag).map conj.toMonoidHom = (R.map e).weylGroup hdiag := by
    rw [weylGroup_def, weylGroup_def, MonoidHom.map_closure, ← Set.range_comp]
    refine congrArg Subgroup.closure (congrArg Set.range (funext fun i ↦ ?_))
    exact (R.map_simpleReflection hdiag e i).symm
  exact (Subgroup.equivMapOfInjective (R.weylGroup hdiag) conj.toMonoidHom conj.injective).trans
    (MulEquiv.subgroupCongr hmap)

@[simp]
theorem mapWeylGroupEquiv_apply_apply (e : H ≃ₗ[K] H') (w : R.weylGroup hdiag)
    (φ : Dual K H') :
    ((R.mapWeylGroupEquiv hdiag e w : Dual K H' ≃ₗ[K] Dual K H') φ) =
      e.symm.dualMap ((w : Dual K H ≃ₗ[K] Dual K H) (e.dualMap φ)) := (rfl)

@[simp]
theorem mapWeylGroupEquiv_weylSimple (e : H ≃ₗ[K] H') (i : I) :
    R.mapWeylGroupEquiv hdiag e (R.weylSimple hdiag i) = (R.map e).weylSimple hdiag i :=
  Subtype.ext (R.map_simpleReflection hdiag e i).symm

/-- Any isomorphism of Weyl groups matching simple reflections index-by-index preserves
`weylLength`, even across distinct scalar fields. -/
theorem weylLength_equiv {K' H'' : Type*} [Field K'] [AddCommGroup H''] [Module K' H'']
    {A' : Matrix I I K'} {R' : CartanRealization A' H''}
    (hdiag' : ∀ i, A' i i = 2) (e : R.weylGroup hdiag ≃* R'.weylGroup hdiag')
    (he : ∀ i, e (R.weylSimple hdiag i) = R'.weylSimple hdiag' i) (w : R.weylGroup hdiag) :
    R'.weylLength hdiag' (e w) = R.weylLength hdiag w := by
  have hcomp : e ∘ R.weylSimple hdiag = R'.weylSimple hdiag' := funext he
  have hle : R'.weylLength hdiag' (e w) ≤ R.weylLength hdiag w := by
    obtain ⟨l, hl, rfl⟩ := R.exists_length_eq_weylLength hdiag w
    refine hl ▸ R'.weylLength_le_of_prod_eq hdiag' (l := l) ?_
    rw [map_list_prod, List.map_map, hcomp]
  refine le_antisymm hle ?_
  obtain ⟨l, hl, hprod⟩ := R'.exists_length_eq_weylLength hdiag' (e w)
  refine hl ▸ R.weylLength_le_of_prod_eq hdiag (l := l) ?_
  apply e.injective
  rw [map_list_prod, List.map_map, hcomp]
  exact hprod

@[simp]
theorem weylLength_mapWeylGroupEquiv (e : H ≃ₗ[K] H') (w : R.weylGroup hdiag) :
    (R.map e).weylLength hdiag (R.mapWeylGroupEquiv hdiag e w) = R.weylLength hdiag w :=
  R.weylLength_equiv hdiag hdiag (R.mapWeylGroupEquiv hdiag e)
    (R.mapWeylGroupEquiv_weylSimple hdiag e) w

section Restrict

variable (M : Submodule K H) (hc : R.corootSpan ≤ M) (hs : M ⊔ R.cartanCenter = ⊤)

/-- Restricting the ambient action of `R.weylGroup hdiag` to an invariant subspace `M` containing
the coroot span. -/
private noncomputable def restrictAmbientHom : R.weylGroup hdiag →* (M ≃ₗ[K] M) :=
  restrictSubmoduleHom M (R.ambientAction hdiag)
    (fun w _ ↦ R.ambientAction_mem_of_corootSpan_le hdiag hc w)

include hs in
private theorem restrictAmbientHom_injective :
    Function.Injective (R.restrictAmbientHom hdiag M hc) := by
  refine (injective_iff_map_eq_one _).mpr fun w hw ↦ R.ambientAction_injective hdiag ?_
  ext x
  have hx : x ∈ M ⊔ R.cartanCenter := hs ▸ Submodule.mem_top
  obtain ⟨m, hm, z, hz, rfl⟩ := Submodule.mem_sup.mp hx
  have hm' : R.ambientAction hdiag w m = m := congrArg Subtype.val congr($(hw) ⟨m, hm⟩)
  rw [map_add, hm', R.ambientAction_of_mem_cartanCenter hdiag w hz, map_one, one_apply_eq_self]

private theorem restrictAmbientHom_weylSimple (i : I) :
    R.restrictAmbientHom hdiag M hc (R.weylSimple hdiag i) =
      (R.restrict M hc hs).coreflection hdiag i := by
  ext m
  change (R.ambientAction hdiag (R.weylSimple hdiag i) (m : H) : H) = _
  rw [R.ambientAction_weylSimple hdiag i]
  simp [coreflection_apply]

/-- The contragredient of `R.restrictAmbientHom`, sending `R.weylGroup hdiag` injectively into
`Dual K M ≃ₗ[K] Dual K M`. -/
private noncomputable def restrictDualHom : R.weylGroup hdiag →* (Dual K M ≃ₗ[K] Dual K M) :=
  contragredientHom.comp (R.restrictAmbientHom hdiag M hc)

private theorem restrictDualHom_weylSimple (i : I) :
    R.restrictDualHom hdiag M hc (R.weylSimple hdiag i) =
      (R.restrict M hc hs).simpleReflection hdiag i := by
  change contragredientHom (R.restrictAmbientHom hdiag M hc (R.weylSimple hdiag i)) = _
  rw [R.restrictAmbientHom_weylSimple hdiag M hc hs i, contragredientHom_coreflection]

private theorem range_restrictDualHom :
    (R.restrictDualHom hdiag M hc).range = (R.restrict M hc hs).weylGroup hdiag := by
  rw [MonoidHom.range_eq_map, ← R.closure_range_weylSimple hdiag, MonoidHom.map_closure,
    ← Set.range_comp, (R.restrict M hc hs).weylGroup_def]
  exact congrArg Subgroup.closure <| congrArg Set.range <| funext fun i ↦
    R.restrictDualHom_weylSimple hdiag M hc hs i

/-- **Invariance of the Weyl group under admissible restriction (and hence under central
enlargement).** If `M` contains the coroot span and spans `H` together with `R.cartanCenter`, then
the Weyl group of `R` is canonically isomorphic to the Weyl group of `R.restrict M hc hs`,
matching simple reflections index-by-index. -/
noncomputable def restrictWeylGroupEquiv :
    R.weylGroup hdiag ≃* (R.restrict M hc hs).weylGroup hdiag :=
  (MonoidHom.ofInjective (f := R.restrictDualHom hdiag M hc) <|
    contragredientHom_injective.comp (R.restrictAmbientHom_injective hdiag M hc hs)).trans
    (MulEquiv.subgroupCongr (R.range_restrictDualHom hdiag M hc hs))

private theorem coe_restrictWeylGroupEquiv (w : R.weylGroup hdiag) :
    (R.restrictWeylGroupEquiv hdiag M hc hs w : Dual K M ≃ₗ[K] Dual K M) =
      R.restrictDualHom hdiag M hc w := (rfl)

@[simp]
theorem restrictWeylGroupEquiv_weylSimple (i : I) :
    R.restrictWeylGroupEquiv hdiag M hc hs (R.weylSimple hdiag i) =
      (R.restrict M hc hs).weylSimple hdiag i :=
  Subtype.ext <| (R.coe_restrictWeylGroupEquiv hdiag M hc hs _).trans
    (R.restrictDualHom_weylSimple hdiag M hc hs i)

/-- Restriction of functionals to `M` intertwines the action of `R.weylGroup hdiag` on `Dual K H`
with the action of `(R.restrict M hc hs).weylGroup hdiag` on `Dual K M`. -/
theorem restrictWeylGroupEquiv_comp_subtype (w : R.weylGroup hdiag) (φ : Dual K H) :
    ((R.restrictWeylGroupEquiv hdiag M hc hs w : Dual K M ≃ₗ[K] Dual K M) (φ.comp M.subtype)) =
      ((w : Dual K H ≃ₗ[K] Dual K H) φ).comp M.subtype := by
  rw [R.coe_restrictWeylGroupEquiv hdiag M hc hs w]
  ext m
  exact (R.weylGroup_apply_apply hdiag w φ m).symm

/-- **Word length is invariant under admissible restriction (and central enlargement).** -/
@[simp]
theorem weylLength_restrictWeylGroupEquiv (w : R.weylGroup hdiag) :
    (R.restrict M hc hs).weylLength hdiag (R.restrictWeylGroupEquiv hdiag M hc hs w) =
      R.weylLength hdiag w :=
  R.weylLength_equiv hdiag hdiag (R.restrictWeylGroupEquiv hdiag M hc hs)
    (R.restrictWeylGroupEquiv_weylSimple hdiag M hc hs) w

private theorem range_domRestrict_dualRestrict_rootLattice :
    LinearMap.range ((M.dualRestrict.restrictScalars ℤ).domRestrict R.rootLattice) =
      (R.restrict M hc hs).rootLattice := by
  rw [LinearMap.range_domRestrict, rootLattice_def, rootLattice_def, Submodule.map_span,
    ← Set.range_comp]
  exact congrArg (Submodule.span ℤ) <| congrArg Set.range <| funext fun i ↦
    LinearMap.ext fun m ↦ (R.restrict_root_apply M hc hs i m).symm

/-- Restriction of functionals to `M` maps `R.rootLattice` isomorphically onto
`(R.restrict M hc hs).rootLattice`. -/
noncomputable def restrictRootLatticeEquiv :
    R.rootLattice ≃ₗ[ℤ] (R.restrict M hc hs).rootLattice :=
  (LinearEquiv.ofInjective ((M.dualRestrict.restrictScalars ℤ).domRestrict R.rootLattice) <|
    (injective_iff_map_eq_zero _).mpr fun φ hφ ↦ Subtype.ext <| by
      have hker : ∀ ξ ∈ R.rootLattice, ∀ z ∈ R.cartanCenter, ξ z = 0 := fun ξ hξ ↦ by
        rw [rootLattice_def] at hξ
        induction hξ using Submodule.span_induction with
        | mem _ hα => obtain ⟨i, rfl⟩ := hα; exact fun z hz ↦ (R.mem_cartanCenter_iff z).mp hz i
        | zero => exact fun _ _ ↦ rfl
        | add _ _ _ _ ih₁ ih₂ => exact fun z hz ↦ by simp [ih₁ z hz, ih₂ z hz]
        | smul _ _ _ ih => exact fun z hz ↦ by simp [ih z hz]
      ext x
      obtain ⟨m, hm, z, hz, rfl⟩ := Submodule.mem_sup.mp (hs ▸ Submodule.mem_top : x ∈ _)
      have hm' : (φ : Dual K H) m = 0 := congr($(hφ) ⟨m, hm⟩)
      simp [hm', hker φ φ.2 z hz]).trans
    (LinearEquiv.ofEq _ _ (R.range_domRestrict_dualRestrict_rootLattice M hc hs))

@[simp]
theorem coe_restrictRootLatticeEquiv_apply (φ : R.rootLattice) :
    (R.restrictRootLatticeEquiv M hc hs φ : Dual K M) = (φ : Dual K H).comp M.subtype := (rfl)

@[simp]
theorem restrictRootLatticeEquiv_root (i : I) :
    R.restrictRootLatticeEquiv M hc hs ⟨R.root i, R.root_mem_rootLattice i⟩ =
      ⟨(R.restrict M hc hs).root i, (R.restrict M hc hs).root_mem_rootLattice i⟩ :=
  Subtype.ext <| LinearMap.ext fun m ↦ (R.restrict_root_apply M hc hs i m).symm

end Restrict

/-- For an integral matrix `A`, `R.restrictRootLatticeEquiv` intertwines the Weyl-group action on
`R.rootLattice` with the restricted Weyl-group action on `(R.restrict M hc hs).rootLattice`. -/
theorem restrictRootLatticeEquiv_rootLatticeAction {B : Matrix I I ℤ}
    (S : CartanRealization (B.map (Int.cast : ℤ → K)) H)
    (hB : ∀ i, (B.map (Int.cast : ℤ → K)) i i = 2)
    (M : Submodule K H) (hc : S.corootSpan ≤ M) (hs : M ⊔ S.cartanCenter = ⊤)
    (w : S.weylGroup hB) (φ : S.rootLattice) :
    S.restrictRootLatticeEquiv M hc hs (S.rootLatticeAction hB w φ) =
      (S.restrict M hc hs).rootLatticeAction hB
        (S.restrictWeylGroupEquiv hB M hc hs w) (S.restrictRootLatticeEquiv M hc hs φ) :=
  Subtype.ext (S.restrictWeylGroupEquiv_comp_subtype hB M hc hs w φ).symm

end Invariance

end CartanRealization

end TauCeti
