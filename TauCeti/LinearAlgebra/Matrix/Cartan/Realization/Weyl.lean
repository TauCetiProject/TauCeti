module

public import Mathlib.GroupTheory.Coxeter.Basic
public import TauCeti.LinearAlgebra.Matrix.Cartan.Realization.RootLattice
public import TauCeti.LinearAlgebra.Reflection
public import TauCeti.LinearAlgebra.RootSystem.Coxeter.Matrix

/-!
# Simple reflections and the Weyl group of a realization

Let `R` be a realization of a matrix `A` with diagonal entries `2`, with simple coroots `hᵢ ∈ H`
and simple roots `αᵢ ∈ H*`, so that `αⱼ(hᵢ) = Aᵢⱼ`. The simple reflection `sᵢ λ = λ - λ(hᵢ) αᵢ`
of the dual space `H*` and the dual reflection `sᵢ h = h - αᵢ(h) hᵢ` of `H` are Mathlib's
`Module.reflection`s; they are involutions, adjoint to each other, and they preserve the pairing
between `H*` and `H`. The **Weyl group** of the realization is the subgroup of the linear
automorphisms of `H*` generated by the simple reflections. For an integral matrix it moves every
functional taking integral values on the simple coroots by an element of the root lattice `Q`, so
it preserves `Q`; for a rational realization it also preserves every weight lattice `P`, and the
dual reflections preserve the corresponding coweight lattice `Y`.

The reflections act on the full dual of the realization, not on the span of the roots, so nothing
here needs the matrix to be nonsingular or of finite type. Since `αᵢ(hᵢ) = 2` is the only input,
the definitions take the hypothesis `∀ i, A i i = 2` as an argument.

For an integral matrix `A` whose vanishing entries come in transposed pairs, the simple reflections
satisfy the relations of the Coxeter matrix `TauCeti.coxeterMatrixOfGeneralizedCartanMatrix A`:
`(sᵢ sⱼ)^mᵢⱼ = 1`, where `mᵢⱼ = 2, 3, 4, 6` for `Aᵢⱼ Aⱼᵢ = 0, 1, 2, 3` and `mᵢⱼ = ∞` otherwise. This
gives a homomorphism from the Coxeter group onto the Weyl group. Over a field of characteristic
zero, and when the Cartan products are nonnegative as for a generalized Cartan matrix, the
product `sᵢ sⱼ` of two simple reflections has order exactly `mᵢⱼ`, including the infinite order
`mᵢⱼ = ∞` of affine type `A₁⁽¹⁾`. That the homomorphism is injective over a field of characteristic
zero for a generalized Cartan matrix, so that the Weyl group is a Coxeter group on the simple
reflections, is Kac's Proposition 3.13, proved in
`TauCeti.LinearAlgebra.Matrix.Cartan.Realization.CoxeterSystem`.

## Main definitions

* `TauCeti.CartanRealization.simpleReflection`: the simple reflection `λ ↦ λ - λ(hᵢ) αᵢ` of `H*`.
* `TauCeti.CartanRealization.simpleCoreflection`: the dual reflection `h ↦ h - αᵢ(h) hᵢ` of `H`.
* `TauCeti.CartanRealization.weylGroup`: the subgroup generated by the simple reflections.
* `TauCeti.CartanRealization.coxeterHom`: the homomorphism from the Coxeter group of
  `TauCeti.coxeterMatrixOfGeneralizedCartanMatrix A` onto the Weyl group.

## Main results

* `TauCeti.CartanRealization.linearIndependent_root_pair`: two distinct simple roots are linearly
  independent.
* `TauCeti.CartanRealization.simpleReflection_root`: `sᵢ αⱼ = αⱼ - Aᵢⱼ αᵢ`.
* `TauCeti.CartanRealization.simpleReflection_apply_simpleCoreflection`: the simple reflections
  preserve the pairing, `(sᵢ λ)(sᵢ h) = λ(h)`.
* `TauCeti.CartanRealization.apply_sub_mem_rootLattice_of_mem_weylGroup`: for an integral matrix,
  `w λ - λ ∈ Q` for every element `w` of the Weyl group and every `λ` integral on the coroots, so
  `w` preserves `Q` (`TauCeti.CartanRealization.apply_mem_rootLattice_iff_of_mem_weylGroup`) and
  every lattice between `Q` and the integral functionals
  (`TauCeti.CartanRealization.apply_mem_iff_of_mem_weylGroup`).
* `TauCeti.CartanRealization.CoweightLattice.apply_mem_weightLattice_iff_of_mem_weylGroup`: the
  Weyl group preserves the weight lattice, and
  `TauCeti.CartanRealization.CoweightLattice.simpleCoreflection_mem_lattice_iff`: the dual
  reflections preserve the coweight lattice.
* `TauCeti.CartanRealization.pow_simpleReflection_mul_simpleReflection_eq_one`: the Coxeter
  relations hold, and `TauCeti.CartanRealization.range_coxeterHom`: the Coxeter group maps onto
  the Weyl group.
* `TauCeti.CartanRealization.orderOf_simpleReflection_mul_simpleReflection`: the order of
  `sᵢ sⱼ` is the Coxeter matrix entry.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, §3.7 (the fundamental
  reflections and the Weyl group) and Proposition 3.13 (the Coxeter matrix `mᵢⱼ` of the Weyl
  group).
-/

public section

open Module

namespace TauCeti

namespace CartanRealization

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H]

section Reflections

variable {A : Matrix I I K} (R : CartanRealization A H) (hA : ∀ i, A i i = 2)

/-- The simple roots at two distinct nodes are linearly independent. -/
theorem linearIndependent_root_pair {i j : I} (hij : i ≠ j) :
    LinearIndependent K ![R.root i, R.root j] := by
  have h := R.root_linearIndependent.comp ![i, j] fun a b hab ↦ by
    fin_cases a <;> fin_cases b <;> simp_all [hij.symm]
  convert h using 1
  ext k
  fin_cases k <;> simp

include hA in
/-- A simple coroot pairs to `2` with its simple root, when the matrix has diagonal entries `2`. -/
theorem root_coroot_two (i : I) : R.root i (R.coroot i) = 2 := by
  rw [root_coroot, hA]

include hA in
/-- The **simple reflection** `sᵢ λ = λ - λ(hᵢ) αᵢ` of the dual of the realization. -/
noncomputable def simpleReflection (i : I) : Dual K H ≃ₗ[K] Dual K H :=
  Module.reflection (x := R.root i) (f := Dual.eval K H (R.coroot i))
    (by rw [Dual.eval_apply, R.root_coroot_two hA])

include hA in
/-- The **dual simple reflection** `sᵢ h = h - αᵢ(h) hᵢ` of the realization. -/
noncomputable def simpleCoreflection (i : I) : H ≃ₗ[K] H :=
  Module.reflection (R.root_coroot_two hA i)

theorem simpleReflection_apply (i : I) (lam : Dual K H) :
    R.simpleReflection hA i lam = lam - lam (R.coroot i) • R.root i := by
  rw [simpleReflection, Module.reflection_apply, Dual.eval_apply]

theorem simpleCoreflection_apply (i : I) (h : H) :
    R.simpleCoreflection hA i h = h - R.root i h • R.coroot i := by
  rw [simpleCoreflection, Module.reflection_apply]

/-- `sᵢ αⱼ = αⱼ - Aᵢⱼ αᵢ`. -/
@[simp]
theorem simpleReflection_root (i j : I) :
    R.simpleReflection hA i (R.root j) = R.root j - A i j • R.root i := by
  rw [simpleReflection_apply, root_coroot]

/-- `sᵢ αᵢ = -αᵢ`. -/
@[simp high]
theorem simpleReflection_root_self (i : I) :
    R.simpleReflection hA i (R.root i) = -R.root i := by
  rw [simpleReflection_root, hA]
  module

/-- The dual simple reflection on the simple coroots: `sᵢ hⱼ = hⱼ - Aⱼᵢ hᵢ`. -/
@[simp]
theorem simpleCoreflection_coroot (i j : I) :
    R.simpleCoreflection hA i (R.coroot j) = R.coroot j - A j i • R.coroot i := by
  rw [simpleCoreflection_apply, root_coroot]

/-- `sᵢ hᵢ = -hᵢ`. -/
@[simp high]
theorem simpleCoreflection_coroot_self (i : I) :
    R.simpleCoreflection hA i (R.coroot i) = -R.coroot i := by
  rw [simpleCoreflection_coroot, hA]
  module

@[simp]
theorem simpleReflection_mul_self (i : I) :
    R.simpleReflection hA i * R.simpleReflection hA i = 1 :=
  LinearEquiv.ext fun lam ↦ Module.involutive_reflection _ lam

@[simp]
theorem simpleCoreflection_mul_self (i : I) :
    R.simpleCoreflection hA i * R.simpleCoreflection hA i = 1 := by
  ext h
  exact Module.involutive_reflection _ h

@[simp]
theorem simpleReflection_inv (i : I) : (R.simpleReflection hA i)⁻¹ = R.simpleReflection hA i :=
  Module.reflection_inv _

@[simp]
theorem simpleCoreflection_inv (i : I) :
    (R.simpleCoreflection hA i)⁻¹ = R.simpleCoreflection hA i :=
  Module.reflection_inv _

/-- The simple reflection is the transpose of the dual simple reflection:
`(sᵢ λ)(h) = λ(sᵢ h)`. -/
theorem simpleReflection_apply_apply (i : I) (lam : Dual K H) (h : H) :
    R.simpleReflection hA i lam h = lam (R.simpleCoreflection hA i h) := by
  simp [simpleReflection_apply, simpleCoreflection_apply, mul_comm]

/-- The simple reflection is the dual map of the dual simple reflection. -/
theorem dualMap_simpleCoreflection (i : I) :
    (R.simpleCoreflection hA i).dualMap = R.simpleReflection hA i := by
  ext lam h
  rw [LinearEquiv.dualMap_apply, simpleReflection_apply_apply]

/-- **The simple reflections preserve the pairing**: `(sᵢ λ)(sᵢ h) = λ(h)`. -/
@[simp]
theorem simpleReflection_apply_simpleCoreflection (i : I) (lam : Dual K H) (h : H) :
    R.simpleReflection hA i lam (R.simpleCoreflection hA i h) = lam h := by
  simp [simpleReflection_apply_apply, ← mul_apply_eq_comp]

/-- A simple reflection moves a functional `λ` by `-λ(hᵢ) αᵢ`, an element of the root lattice when
`λ(hᵢ)` is an integer. -/
theorem simpleReflection_apply_sub_mem_rootLattice (i : I) {lam : Dual K H}
    (hlam : ∃ n : ℤ, lam (R.coroot i) = n) :
    R.simpleReflection hA i lam - lam ∈ R.rootLattice := by
  obtain ⟨n, hn⟩ := hlam
  rw [simpleReflection_apply, sub_sub_cancel_left, hn, Int.cast_smul_eq_zsmul K n (R.root i)]
  exact neg_mem (zsmul_mem (R.root_mem_rootLattice i) n)

/-! ### The Weyl group -/

include hA in
/-- The **Weyl group** of the realization: the subgroup of the linear automorphisms of `H*`
generated by the simple reflections. -/
noncomputable def weylGroup : Subgroup (Dual K H ≃ₗ[K] Dual K H) :=
  Subgroup.closure (Set.range (R.simpleReflection hA))

theorem weylGroup_def :
    R.weylGroup hA = Subgroup.closure (Set.range (R.simpleReflection hA)) := (rfl)

@[simp]
theorem simpleReflection_mem_weylGroup (i : I) : R.simpleReflection hA i ∈ R.weylGroup hA :=
  Subgroup.subset_closure (Set.mem_range_self i)

end Reflections

/-! ### Integral matrices: the root lattice is stable -/

section Integral

variable {A : Matrix I I ℤ} (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)
  (hA : ∀ i, A.map (Int.cast : ℤ → K) i i = 2)

/-- For an integral matrix, the elements of the root lattice take integral values on the simple
coroots. -/
theorem exists_apply_coroot_eq_intCast_of_mem_rootLattice {lam : Dual K H}
    (hlam : lam ∈ R.rootLattice) (i : I) : ∃ n : ℤ, lam (R.coroot i) = n := by
  rw [rootLattice_def] at hlam
  induction hlam using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    exact ⟨A i j, by simp⟩
  | zero => exact ⟨0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨a, ha⟩ := hx
    obtain ⟨b, hb⟩ := hy
    exact ⟨a + b, by simp [ha, hb]⟩
  | smul n x _ hx =>
    obtain ⟨a, ha⟩ := hx
    exact ⟨n * a, by simp [ha]⟩

/-- **The Weyl group moves integral functionals by elements of the root lattice.** For an
integral matrix and a functional `λ` taking integral values on the simple coroots, `w λ - λ` lies
in the root lattice `Q` for every element `w` of the Weyl group. -/
theorem apply_sub_mem_rootLattice_of_mem_weylGroup {w : Dual K H ≃ₗ[K] Dual K H}
    (hw : w ∈ R.weylGroup hA) {lam : Dual K H} (hlam : ∀ i, ∃ n : ℤ, lam (R.coroot i) = n) :
    w lam - lam ∈ R.rootLattice := by
  induction hw using Subgroup.closure_induction'' generalizing lam with
  | mem s hs =>
    obtain ⟨i, rfl⟩ := hs
    exact R.simpleReflection_apply_sub_mem_rootLattice hA i (hlam i)
  | inv_mem s hs =>
    obtain ⟨i, rfl⟩ := hs
    rw [simpleReflection_inv]
    exact R.simpleReflection_apply_sub_mem_rootLattice hA i (hlam i)
  | one => simp
  | mul w₁ w₂ _ _ h₁ h₂ =>
    have h₂' := h₂ hlam
    -- `w₂ λ = λ + (w₂ λ - λ)` is again integral on the coroots, since `w₂ λ - λ ∈ Q`.
    have hint (i : I) : ∃ n : ℤ, w₂ lam (R.coroot i) = n := by
      obtain ⟨a, ha⟩ := hlam i
      obtain ⟨b, hb⟩ := R.exists_apply_coroot_eq_intCast_of_mem_rootLattice h₂' i
      refine ⟨b + a, ?_⟩
      rw [← sub_add_cancel (w₂ lam) lam, LinearMap.add_apply, hb, ha, Int.cast_add]
    rw [mul_apply_eq_comp, ← sub_add_sub_cancel _ (w₂ lam)]
    exact add_mem (h₁ hint) h₂'

/-- **The Weyl group preserves every lattice between the root lattice and the integral
functionals**, for an integral matrix: if `Q ≤ M` and every element of `M` takes integral values on
the simple coroots, then `w λ ∈ M ↔ λ ∈ M` for every element `w` of the Weyl group. -/
theorem apply_mem_iff_of_mem_weylGroup {M : Submodule ℤ (Dual K H)} (hQM : R.rootLattice ≤ M)
    (hM : ∀ lam ∈ M, ∀ i, ∃ n : ℤ, lam (R.coroot i) = n) {w : Dual K H ≃ₗ[K] Dual K H}
    (hw : w ∈ R.weylGroup hA) {lam : Dual K H} : w lam ∈ M ↔ lam ∈ M := by
  have key {w : Dual K H ≃ₗ[K] Dual K H} (hw : w ∈ R.weylGroup hA) {lam : Dual K H}
      (hlam : lam ∈ M) : w lam ∈ M := by
    rw [← sub_add_cancel (w lam) lam]
    exact add_mem (hQM (R.apply_sub_mem_rootLattice_of_mem_weylGroup hA hw (hM lam hlam))) hlam
  refine ⟨fun h ↦ ?_, key hw⟩
  simpa using key (inv_mem hw) h

/-- **The Weyl group preserves the root lattice**, for an integral matrix. -/
theorem apply_mem_rootLattice_iff_of_mem_weylGroup {w : Dual K H ≃ₗ[K] Dual K H}
    (hw : w ∈ R.weylGroup hA) {lam : Dual K H} : w lam ∈ R.rootLattice ↔ lam ∈ R.rootLattice :=
  R.apply_mem_iff_of_mem_weylGroup hA le_rfl
    (fun _ h ↦ R.exists_apply_coroot_eq_intCast_of_mem_rootLattice h) hw

/-! ### The Coxeter relations -/

/-- The pairing of a simple coroot with a simple root, as it enters `Module.reflection`. -/
private theorem dual_eval_coroot_root (i j : I) :
    Dual.eval K H (R.coroot i) (R.root j) = (A i j : K) := by
  rw [Dual.eval_apply, root_coroot, Matrix.map_apply]

/-- The Cartan product of two simple roots, as it enters `Module.reflection`, is the image of the
integer `A i j * A j i`. -/
private theorem dual_eval_mul_dual_eval (i j : I) :
    Dual.eval K H (R.coroot i) (R.root j) * Dual.eval K H (R.coroot j) (R.root i) =
      ((A i j * A j i : ℤ) : K) := by
  rw [dual_eval_coroot_root, dual_eval_coroot_root, Int.cast_mul]

/-- A Cartan product in `[0, 4)` of entries vanishing together is one of `0`, `1`, `2`, `3`, the
first only when both entries vanish. -/
private theorem cartan_product_cases {i j : I} (hzero : A i j = 0 ↔ A j i = 0)
    (h0 : 0 ≤ A i j * A j i) (h4 : A i j * A j i < 4) :
    (A i j = 0 ∧ A j i = 0) ∨ A i j * A j i = 1 ∨ A i j * A j i = 2 ∨ A i j * A j i = 3 := by
  rcases eq_or_ne (A i j * A j i) 0 with h | h
  · have hij0 : A i j = 0 := (mul_eq_zero.mp h).elim id hzero.mpr
    exact .inl ⟨hij0, hzero.mp hij0⟩
  · omega

variable [DecidableEq I]

/-- **The Coxeter relations.** If the entries `A i j` and `A j i` of the integral matrix `A`
vanish together, as for a generalized Cartan matrix, the simple reflections satisfy
`(sᵢ sⱼ)^mᵢⱼ = 1` for the Coxeter matrix `TauCeti.coxeterMatrixOfGeneralizedCartanMatrix A`. -/
theorem pow_simpleReflection_mul_simpleReflection_eq_one {i j : I}
    (hzero : A i j = 0 ↔ A j i = 0) :
    (R.simpleReflection hA i * R.simpleReflection hA j) ^
      coxeterMatrixOfGeneralizedCartanMatrix A i j = 1 := by
  rcases eq_or_ne i j with rfl | hij
  · simp
  rw [coxeterMatrixOfGeneralizedCartanMatrix_apply_of_ne A hij]
  split_ifs with h4
  swap
  · exact pow_zero _
  have hc := R.dual_eval_mul_dual_eval i j
  rw [simpleReflection, simpleReflection]
  -- The Cartan product `c = A i j * A j i < 4` is negative, giving the infinite entry, or one of
  -- `0, 1, 2, 3`.
  rcases lt_or_ge (A i j * A j i) 0 with hneg | hnonneg
  · rw [coxeterOrder_eq_zero_iff.mpr
      (by simp only [Set.mem_insert_iff, Set.mem_singleton_iff]; omega), pow_zero]
  obtain ⟨hij0, hji0⟩ | h | h | h := cartan_product_cases hzero hnonneg h4
  · rw [hij0, zero_mul, coxeterOrder_zero]
    exact Module.reflection_mul_reflection_pow_two_eq_one _ _
      (by rw [dual_eval_coroot_root, hij0, Int.cast_zero])
      (by rw [dual_eval_coroot_root, hji0, Int.cast_zero])
  · rw [h, coxeterOrder_one]
    exact Module.reflection_mul_reflection_pow_three_eq_one _ _ (by rw [hc, h, Int.cast_one])
  · rw [h, coxeterOrder_two]
    exact Module.reflection_mul_reflection_pow_four_eq_one _ _ (by rw [hc, h]; norm_num)
  · rw [h, coxeterOrder_three]
    exact Module.reflection_mul_reflection_pow_six_eq_one _ _ (by rw [hc, h]; norm_num)

/-- **The order of a product of two simple reflections is the Coxeter matrix entry.** Over a field
of characteristic zero, for an integral matrix whose vanishing entries come in transposed pairs
and whose Cartan products `A i j * A j i` are nonnegative, as for a generalized Cartan matrix, the
product `sᵢ sⱼ` has order exactly `TauCeti.coxeterMatrixOfGeneralizedCartanMatrix A i j`. When
`A i j * A j i ≥ 4` that entry is `0`: the product has infinite order. -/
theorem orderOf_simpleReflection_mul_simpleReflection [CharZero K] {i j : I}
    (hzero : A i j = 0 ↔ A j i = 0) (hprod : 0 ≤ A i j * A j i) :
    orderOf (R.simpleReflection hA i * R.simpleReflection hA j) =
      coxeterMatrixOfGeneralizedCartanMatrix A i j := by
  rcases eq_or_ne i j with rfl | hij
  · simp
  have hli := R.linearIndependent_root_pair hij
  have hc := R.dual_eval_mul_dual_eval i j
  rw [simpleReflection, simpleReflection]
  rcases lt_or_ge (A i j * A j i) 4 with h4 | h4
  swap
  · rw [coxeterMatrixOfGeneralizedCartanMatrix_apply_of_four_le A hij h4]
    exact Module.orderOf_reflection_mul_reflection_eq_zero hli hc h4
  rw [coxeterMatrixOfGeneralizedCartanMatrix_apply_of_lt_four A hij h4]
  obtain ⟨hij0, hji0⟩ | h | h | h := cartan_product_cases hzero hprod h4
  · rw [hij0, zero_mul, coxeterOrder_zero]
    exact Module.orderOf_reflection_mul_reflection_eq_two
      (smul_ne_zero two_ne_zero (R.root_linearIndependent.ne_zero i))
      (by rw [dual_eval_coroot_root, hij0, Int.cast_zero])
      (by rw [dual_eval_coroot_root, hji0, Int.cast_zero])
  · rw [h, coxeterOrder_one]
    exact Module.orderOf_reflection_mul_reflection_eq_three (by rw [hc, h, Int.cast_one])
      (by norm_num)
  · rw [h, coxeterOrder_two]
    exact Module.orderOf_reflection_mul_reflection_eq_four (by rw [hc, h]; norm_num) (by norm_num)
  · rw [h, coxeterOrder_three]
    exact Module.orderOf_reflection_mul_reflection_eq_six (by rw [hc, h]; norm_num) (by norm_num)
      (by norm_num)

/-! ### The homomorphism from the Coxeter group -/

/-- The homomorphism from the Coxeter group of `TauCeti.coxeterMatrixOfGeneralizedCartanMatrix A`
to the linear automorphisms of `H*` sending each Coxeter generator to the corresponding simple
reflection. It exists by the Coxeter relations
`TauCeti.CartanRealization.pow_simpleReflection_mul_simpleReflection_eq_one`, and its range is the
Weyl group (`TauCeti.CartanRealization.range_coxeterHom`). -/
noncomputable def coxeterHom (hzero : ∀ i j, A i j = 0 ↔ A j i = 0) :
    (coxeterMatrixOfGeneralizedCartanMatrix A).Group →* (Dual K H ≃ₗ[K] Dual K H) :=
  (coxeterMatrixOfGeneralizedCartanMatrix A).toCoxeterSystem.lift
    ⟨R.simpleReflection hA, fun i j ↦
      R.pow_simpleReflection_mul_simpleReflection_eq_one hA (hzero i j)⟩

variable (hzero : ∀ i j, A i j = 0 ↔ A j i = 0)

/-- The Coxeter generator `sᵢ` maps to the simple reflection `sᵢ`. -/
@[simp]
theorem coxeterHom_simple (i : I) :
    R.coxeterHom hA hzero ((coxeterMatrixOfGeneralizedCartanMatrix A).simple i) =
      R.simpleReflection hA i :=
  (coxeterMatrixOfGeneralizedCartanMatrix A).toCoxeterSystem.lift_apply_simple _ i

/-- **The Coxeter group maps onto the Weyl group.** -/
theorem range_coxeterHom : (R.coxeterHom hA hzero).range = R.weylGroup hA := by
  rw [MonoidHom.range_eq_map, ← CoxeterMatrix.subgroupClosure_range_simple, MonoidHom.map_closure,
    ← Set.range_comp, weylGroup_def]
  congr 2
  ext i : 1
  exact R.coxeterHom_simple hA hzero i

end Integral

/-! ### Weight and coweight lattices -/

namespace CoweightLattice

variable [Module ℚ H] {A : Matrix I I ℤ} {R : CartanRealization (A.map (Int.cast : ℤ → ℚ)) H}
  (hA : ∀ i, A.map (Int.cast : ℤ → ℚ) i i = 2) (L : R.CoweightLattice)

/-- A weight takes integral values on the simple coroots. -/
theorem exists_apply_coroot_eq_intCast {lam : Dual ℚ H} (hlam : lam ∈ L.weightLattice) (i : I) :
    ∃ n : ℤ, lam (R.coroot i) = n :=
  (L.mem_weightLattice_iff lam).mp hlam _ (L.coroot_mem i) |>.imp fun _ h ↦ h.symm

/-- **The Weyl group moves weights by elements of the root lattice.** -/
theorem apply_sub_mem_rootLattice_of_mem_weylGroup {w : Dual ℚ H ≃ₗ[ℚ] Dual ℚ H}
    (hw : w ∈ R.weylGroup hA) {lam : Dual ℚ H} (hlam : lam ∈ L.weightLattice) :
    w lam - lam ∈ R.rootLattice :=
  R.apply_sub_mem_rootLattice_of_mem_weylGroup hA hw (L.exists_apply_coroot_eq_intCast hlam)

/-- **The Weyl group preserves the weight lattice.** -/
theorem apply_mem_weightLattice_iff_of_mem_weylGroup {w : Dual ℚ H ≃ₗ[ℚ] Dual ℚ H}
    (hw : w ∈ R.weylGroup hA) {lam : Dual ℚ H} :
    w lam ∈ L.weightLattice ↔ lam ∈ L.weightLattice :=
  R.apply_mem_iff_of_mem_weylGroup hA L.rootLattice_le_weightLattice
    (fun _ h ↦ L.exists_apply_coroot_eq_intCast h) hw

/-- **The dual simple reflections preserve the coweight lattice.** -/
theorem simpleCoreflection_mem_lattice_iff (i : I) {h : H} :
    R.simpleCoreflection hA i h ∈ L.lattice ↔ h ∈ L.lattice := by
  have key {h : H} (hh : h ∈ L.lattice) : R.simpleCoreflection hA i h ∈ L.lattice := by
    obtain ⟨n, hn⟩ := (L.mem_weightLattice_iff _).mp (L.root i).property h hh
    rw [simpleCoreflection_apply, ← L.coe_root, ← hn, Int.cast_smul_eq_zsmul ℚ n (R.coroot i)]
    exact sub_mem hh (zsmul_mem (L.coroot_mem i) n)
  refine ⟨fun hh ↦ ?_, key⟩
  simpa [← mul_apply_eq_comp] using key hh

end CoweightLattice

end CartanRealization

end TauCeti

/-! ### Examples -/

section Examples

open TauCeti CartanRealization

/-- Affine type `A₁⁽¹⁾`: the Cartan product of the two nodes is `4`, and the two simple reflections
of any realization over a field of characteristic zero generate an infinite dihedral group. -/
example {K H : Type*} [Field K] [CharZero K] [AddCommGroup H] [Module K H]
    (R : CartanRealization ((!![2, -2; -2, 2] : Matrix (Fin 2) (Fin 2) ℤ).map (Int.cast : ℤ → K)) H)
    (hA : ∀ i, (!![2, -2; -2, 2] : Matrix (Fin 2) (Fin 2) ℤ).map (Int.cast : ℤ → K) i i = 2) :
    orderOf (R.simpleReflection hA 0 * R.simpleReflection hA 1) = 0 := by
  rw [R.orderOf_simpleReflection_mul_simpleReflection hA (by decide) (by decide)]
  simp

/-- Type `B₂`, with `A = [[2, -2], [-1, 2]]`: the Cartan product is `2`, so the product of the two
simple reflections has order `4`, not `3`. -/
example {K H : Type*} [Field K] [CharZero K] [AddCommGroup H] [Module K H]
    (R : CartanRealization ((!![2, -2; -1, 2] : Matrix (Fin 2) (Fin 2) ℤ).map (Int.cast : ℤ → K)) H)
    (hA : ∀ i, (!![2, -2; -1, 2] : Matrix (Fin 2) (Fin 2) ℤ).map (Int.cast : ℤ → K) i i = 2) :
    orderOf (R.simpleReflection hA 0 * R.simpleReflection hA 1) = 4 := by
  rw [R.orderOf_simpleReflection_mul_simpleReflection hA (by decide) (by decide)]
  simp

end Examples
