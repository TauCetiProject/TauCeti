module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.LinearAlgebra.Reflection
public import TauCeti.LinearAlgebra.Matrix.Cartan.Realization.RootLattice

/-!
# Simple reflections and the Weyl group of a Cartan realization

Let `R` be a `TauCeti.CartanRealization` of a square matrix `A` with diagonal entries `2` on a
`K`-vector space `H`. Every node `i : I` carries a dual pair of involutive reflections built from
Mathlib's `Module.reflection`:

* `TauCeti.CartanRealization.simpleReflection` on `Module.Dual K H`,
  `sᵢ(φ) = φ - φ(hᵢ) • αᵢ`, sending `αⱼ ↦ αⱼ - A i j • αᵢ` and `αᵢ ↦ -αᵢ`;
* `TauCeti.CartanRealization.corootReflection` on `H`,
  `sᵢ(h) = h - αᵢ(h) • hᵢ`, sending `hⱼ ↦ hⱼ - A j i • hᵢ`, fixing `R.cartanCenter` pointwise, and
  preserving `R.corootSpan`.

The **Weyl group** `TauCeti.CartanRealization.weylGroup` is the subgroup of
`Dual K H ≃ₗ[K] Dual K H` generated by the simple reflections. Even when `H` is
infinite-dimensional (and hence not reflexive), the contragredient homomorphism `e ↦ e.symm.dualMap`
is injective on `H ≃ₗ[K] H` and identifies the coroot Weyl group
`TauCeti.CartanRealization.corootWeylGroup` on `H` canonically with `R.weylGroup`
(`TauCeti.CartanRealization.corootWeylEquiv`), producing a faithful covariant action
`TauCeti.CartanRealization.corootAut : R.weylGroup hdiag →* (H ≃ₗ[K] H)` that preserves the
canonical pairing between `Dual K H` and `H`.

We also define the word-product map `TauCeti.CartanRealization.wordProd` and the minimal generator-
word length `TauCeti.CartanRealization.length` directly on `R.weylGroup`, and show that for an
integral matrix `A : Matrix I I ℤ` the Weyl group preserves the root lattice `Q` as well as every
coweight lattice `Y` and weight lattice `P` (`rootLatticeAut`, `CoweightLattice.coweightAut`,
`CoweightLattice.weightAut`).

## Main definitions

* `TauCeti.CartanRealization.simpleReflection`, `TauCeti.CartanRealization.corootReflection`:
  simple reflections on `Dual K H` and `H`.
* `TauCeti.CartanRealization.weylGroup`, `TauCeti.CartanRealization.corootWeylGroup`: the
  subgroups generated by simple reflections on `Dual K H` and `H`.
* `TauCeti.CartanRealization.corootWeylEquiv`, `TauCeti.CartanRealization.corootAut`: canonical
  equivalence `corootWeylGroup ≃* weylGroup` and faithful action `weylGroup →* (H ≃ₗ[K] H)`.
* `TauCeti.CartanRealization.wordProd`, `TauCeti.CartanRealization.length`: words in simple
  reflections and minimal word length.
* `TauCeti.CartanRealization.rootLatticeAut`,
  `TauCeti.CartanRealization.CoweightLattice.coweightAut`,
  `TauCeti.CartanRealization.CoweightLattice.weightAut`: induced `ℤ`-linear lattice actions.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, Cambridge University Press, 1990,
  §3.7.
-/

public section

open Module

namespace TauCeti.CartanRealization

section Field

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I K}
  (R : CartanRealization A H)

/-! ### Simple reflections on `Dual K H` and `H` -/

/-- The simple reflection `sᵢ(φ) = φ - φ(hᵢ) • αᵢ` on `Dual K H`. -/
noncomputable def simpleReflection (hdiag : ∀ i, A i i = 2) (i : I) :
    Dual K H ≃ₗ[K] Dual K H :=
  Module.reflection (f := Dual.eval K H (R.coroot i)) (x := R.root i) (by simp [hdiag i])

/-- The simple reflection `sᵢ(h) = h - αᵢ(h) • hᵢ` on the ambient Cartan space `H`. -/
noncomputable def corootReflection (hdiag : ∀ i, A i i = 2) (i : I) :
    H ≃ₗ[K] H :=
  Module.reflection (f := R.root i) (x := R.coroot i) (by simp [hdiag i])

section BasicReflections

variable (hdiag : ∀ i, A i i = 2)

theorem simpleReflection_eq_reflection (i : I) :
    R.simpleReflection hdiag i =
      Module.reflection (f := Dual.eval K H (R.coroot i)) (x := R.root i) (by simp [hdiag i]) :=
  (rfl)

theorem corootReflection_eq_reflection (i : I) :
    R.corootReflection hdiag i =
      Module.reflection (f := R.root i) (x := R.coroot i) (by simp [hdiag i]) :=
  (rfl)

theorem simpleReflection_apply (i : I) (φ : Dual K H) :
    R.simpleReflection hdiag i φ = φ - φ (R.coroot i) • R.root i :=
  Module.reflection_apply φ _

theorem corootReflection_apply (i : I) (h : H) :
    R.corootReflection hdiag i h = h - R.root i h • R.coroot i :=
  Module.reflection_apply h _

theorem simpleReflection_root (i j : I) :
    R.simpleReflection hdiag i (R.root j) = R.root j - A i j • R.root i := by
  rw [simpleReflection_apply, R.root_coroot]

theorem corootReflection_coroot (i j : I) :
    R.corootReflection hdiag i (R.coroot j) = R.coroot j - A j i • R.coroot i := by
  rw [corootReflection_apply, R.root_coroot]

@[simp]
theorem simpleReflection_root_self (i : I) :
    R.simpleReflection hdiag i (R.root i) = -R.root i :=
  Module.reflection_apply_self _

@[simp]
theorem corootReflection_coroot_self (i : I) :
    R.corootReflection hdiag i (R.coroot i) = -R.coroot i :=
  Module.reflection_apply_self _

theorem involutive_simpleReflection (i : I) :
    Function.Involutive (R.simpleReflection hdiag i) :=
  Module.involutive_reflection _

theorem involutive_corootReflection (i : I) :
    Function.Involutive (R.corootReflection hdiag i) :=
  Module.involutive_reflection _

@[simp]
theorem simpleReflection_simpleReflection (i : I) (φ : Dual K H) :
    R.simpleReflection hdiag i (R.simpleReflection hdiag i φ) = φ :=
  R.involutive_simpleReflection hdiag i φ

@[simp]
theorem corootReflection_corootReflection (i : I) (h : H) :
    R.corootReflection hdiag i (R.corootReflection hdiag i h) = h :=
  R.involutive_corootReflection hdiag i h

@[simp]
theorem simpleReflection_symm (i : I) :
    (R.simpleReflection hdiag i).symm = R.simpleReflection hdiag i :=
  Module.reflection_symm _

@[simp]
theorem corootReflection_symm (i : I) :
    (R.corootReflection hdiag i).symm = R.corootReflection hdiag i :=
  Module.reflection_symm _

@[simp]
theorem simpleReflection_inv (i : I) :
    (R.simpleReflection hdiag i)⁻¹ = R.simpleReflection hdiag i :=
  Module.reflection_inv _

@[simp]
theorem corootReflection_inv (i : I) :
    (R.corootReflection hdiag i)⁻¹ = R.corootReflection hdiag i :=
  Module.reflection_inv _

@[simp]
theorem simpleReflection_mul_self (i : I) :
    R.simpleReflection hdiag i * R.simpleReflection hdiag i = 1 :=
  LinearEquiv.ext fun φ ↦ R.simpleReflection_simpleReflection hdiag i φ

@[simp]
theorem corootReflection_mul_self (i : I) :
    R.corootReflection hdiag i * R.corootReflection hdiag i = 1 :=
  LinearEquiv.ext fun h ↦ R.corootReflection_corootReflection hdiag i h

theorem simpleReflection_ne_one [CharZero K] (i : I) :
    R.simpleReflection hdiag i ≠ 1 := by
  intro h1
  have hfix : R.simpleReflection hdiag i (R.root i) = R.root i := by simp [h1]
  rw [simpleReflection_root_self] at hfix
  have htwo : (2 : K) • R.root i = 0 := by
    rw [two_smul, ← neg_eq_iff_add_eq_zero]
    exact hfix
  exact (smul_eq_zero.mp htwo).elim two_ne_zero (R.root_linearIndependent.ne_zero i)

theorem corootReflection_ne_one [CharZero K] (i : I) :
    R.corootReflection hdiag i ≠ 1 := by
  intro h1
  have hfix : R.corootReflection hdiag i (R.coroot i) = R.coroot i := by simp [h1]
  rw [corootReflection_coroot_self] at hfix
  have htwo : (2 : K) • R.coroot i = 0 := by
    rw [two_smul, ← neg_eq_iff_add_eq_zero]
    exact hfix
  exact (smul_eq_zero.mp htwo).elim two_ne_zero (R.coroot_linearIndependent.ne_zero i)

/-- The dual transpose of `corootReflection` is `simpleReflection`. -/
@[simp]
theorem dualMap_corootReflection (i : I) :
    (R.corootReflection hdiag i).dualMap = R.simpleReflection hdiag i := by
  ext φ h
  simp only [LinearEquiv.dualMap_apply, corootReflection_apply, simpleReflection_apply,
    map_sub, map_smul, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul, mul_comm]

theorem simpleReflection_apply_eq_apply_corootReflection (i : I) (φ : Dual K H) (h : H) :
    R.simpleReflection hdiag i φ h = φ (R.corootReflection hdiag i h) := by
  rw [← R.dualMap_corootReflection hdiag i, LinearEquiv.dualMap_apply]

/-- Simple reflections on `Dual K H` and `H` preserve the evaluation pairing. -/
@[simp]
theorem simpleReflection_apply_corootReflection (i : I) (φ : Dual K H) (h : H) :
    R.simpleReflection hdiag i φ (R.corootReflection hdiag i h) = φ h := by
  rw [simpleReflection_apply_eq_apply_corootReflection, corootReflection_corootReflection]

/-- Every simple reflection fixes the Cartan center pointwise. -/
theorem corootReflection_eq_self_of_mem_cartanCenter {h : H} (hh : h ∈ R.cartanCenter) (i : I) :
    R.corootReflection hdiag i h = h := by
  rw [corootReflection_apply, (R.mem_cartanCenter_iff h).mp hh i, zero_smul, sub_zero]

/-- Every simple reflection preserves the coroot span. -/
theorem corootReflection_mem_corootSpan {h : H} (hh : h ∈ R.corootSpan) (i : I) :
    R.corootReflection hdiag i h ∈ R.corootSpan :=
  (R.corootReflection_eq_reflection hdiag i ▸
    Submodule.mem_invtSubmodule_reflection_of_mem _ R.corootSpan (R.coroot_mem_corootSpan i)) hh

/-! ### Compatibility with transport and restriction -/

theorem map_corootReflection_apply {H' : Type*} [AddCommGroup H'] [Module K H']
    (e : H ≃ₗ[K] H') (i : I) (h : H) :
    (R.map e).corootReflection hdiag i (e h) = e (R.corootReflection hdiag i h) := by
  simp [corootReflection_apply]

theorem coe_restrict_corootReflection (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (i : I) (m : M) :
    (((R.restrict M hc hs).corootReflection hdiag i m : M) : H) =
      R.corootReflection hdiag i m := by
  simp [corootReflection_apply]

theorem dualMap_subtype_simpleReflection (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (i : I) (φ : Dual K H) :
    M.subtype.dualMap (R.simpleReflection hdiag i φ) =
      (R.restrict M hc hs).simpleReflection hdiag i (M.subtype.dualMap φ) := by
  ext m
  simp [simpleReflection_apply]

end BasicReflections

/-! ### The Weyl group on `Dual K H` and `H` -/

/-- The **Weyl group** of a Cartan realization: the subgroup of `Dual K H ≃ₗ[K] Dual K H`
generated by the simple reflections. -/
noncomputable def weylGroup (hdiag : ∀ i, A i i = 2) : Subgroup (Dual K H ≃ₗ[K] Dual K H) :=
  Subgroup.closure (Set.range (R.simpleReflection hdiag))

/-- The `i`-th simple reflection as an element of `R.weylGroup hdiag`. -/
noncomputable def simpleReflectionMem (hdiag : ∀ i, A i i = 2) (i : I) : R.weylGroup hdiag :=
  ⟨R.simpleReflection hdiag i, Subgroup.subset_closure (Set.mem_range_self i)⟩

/-- The **coroot Weyl group** on the ambient space `H`: the subgroup of `H ≃ₗ[K] H` generated by
the simple coroot reflections. -/
noncomputable def corootWeylGroup (hdiag : ∀ i, A i i = 2) : Subgroup (H ≃ₗ[K] H) :=
  Subgroup.closure (Set.range (R.corootReflection hdiag))

/-- The `i`-th simple coroot reflection as an element of `R.corootWeylGroup hdiag`. -/
noncomputable def corootReflectionMem (hdiag : ∀ i, A i i = 2) (i : I) :
    R.corootWeylGroup hdiag :=
  ⟨R.corootReflection hdiag i, Subgroup.subset_closure (Set.mem_range_self i)⟩

section WeylGroupAPI

variable (hdiag : ∀ i, A i i = 2)

theorem weylGroup_def :
    R.weylGroup hdiag = Subgroup.closure (Set.range (R.simpleReflection hdiag)) :=
  (rfl)

theorem corootWeylGroup_def :
    R.corootWeylGroup hdiag = Subgroup.closure (Set.range (R.corootReflection hdiag)) :=
  (rfl)

@[simp]
theorem coe_simpleReflectionMem (i : I) :
    (R.simpleReflectionMem hdiag i : Dual K H ≃ₗ[K] Dual K H) = R.simpleReflection hdiag i :=
  (rfl)

@[simp]
theorem coe_corootReflectionMem (i : I) :
    (R.corootReflectionMem hdiag i : H ≃ₗ[K] H) = R.corootReflection hdiag i :=
  (rfl)

@[simp]
theorem simpleReflectionMem_mul_self (i : I) :
    R.simpleReflectionMem hdiag i * R.simpleReflectionMem hdiag i = 1 :=
  Subtype.ext (R.simpleReflection_mul_self hdiag i)

@[simp]
theorem corootReflectionMem_mul_self (i : I) :
    R.corootReflectionMem hdiag i * R.corootReflectionMem hdiag i = 1 :=
  Subtype.ext (R.corootReflection_mul_self hdiag i)

@[simp]
theorem simpleReflectionMem_inv (i : I) :
    (R.simpleReflectionMem hdiag i)⁻¹ = R.simpleReflectionMem hdiag i :=
  Subtype.ext (R.simpleReflection_inv hdiag i)

@[simp]
theorem corootReflectionMem_inv (i : I) :
    (R.corootReflectionMem hdiag i)⁻¹ = R.corootReflectionMem hdiag i :=
  Subtype.ext (R.corootReflection_inv hdiag i)

theorem simpleReflectionMem_ne_one [CharZero K] (i : I) :
    R.simpleReflectionMem hdiag i ≠ 1 :=
  fun h ↦ R.simpleReflection_ne_one hdiag i (congrArg Subtype.val h)

@[simp]
theorem orderOf_simpleReflectionMem [CharZero K] (i : I) :
    orderOf (R.simpleReflectionMem hdiag i) = 2 := by
  refine orderOf_eq_prime ?_ (R.simpleReflectionMem_ne_one hdiag i)
  rw [sq, simpleReflectionMem_mul_self]

/-- **Canonical isomorphism between the coroot Weyl group on `H` and the Weyl group on `H*`.**
Valid without finite dimensionality of `H`. -/
noncomputable def corootWeylEquiv : R.corootWeylGroup hdiag ≃* R.weylGroup hdiag :=
  let φ : (H ≃ₗ[K] H) →* (Dual K H ≃ₗ[K] Dual K H) :=
    { toFun e := e.symm.dualMap, map_one' := by ext; rfl, map_mul' _ _ := by ext; rfl }
  have hφ : Function.Injective φ := fun e₁ e₂ h ↦ by
    have hsymm : e₁.dualMap = e₂.dualMap := by simpa [φ] using congrArg LinearEquiv.symm h
    ext x
    refine (Basis.ofVectorSpace K H).eval_injective ?_
    ext f
    exact congrArg (fun g : Dual K H ≃ₗ[K] Dual K H ↦ g f x) hsymm
  ((R.corootWeylGroup hdiag).equivMapOfInjective φ hφ).trans <| MulEquiv.subgroupCongr <| by
    rw [corootWeylGroup_def, weylGroup_def, MonoidHom.map_closure, ← Set.range_comp]
    exact congrArg (fun f : I → Dual K H ≃ₗ[K] Dual K H ↦ Subgroup.closure (Set.range f))
      (funext fun i ↦ by simp [φ])

@[simp]
theorem coe_corootWeylEquiv (g : R.corootWeylGroup hdiag) :
    (R.corootWeylEquiv hdiag g : Dual K H ≃ₗ[K] Dual K H) =
      (g : H ≃ₗ[K] H).symm.dualMap :=
  (rfl)

@[simp]
theorem corootWeylEquiv_corootReflectionMem (i : I) :
    R.corootWeylEquiv hdiag (R.corootReflectionMem hdiag i) = R.simpleReflectionMem hdiag i := by
  ext φ h
  simp [coe_corootWeylEquiv]

@[simp]
theorem corootWeylEquiv_symm_simpleReflectionMem (i : I) :
    (R.corootWeylEquiv hdiag).symm (R.simpleReflectionMem hdiag i) =
      R.corootReflectionMem hdiag i :=
  (R.corootWeylEquiv hdiag).symm_apply_eq.mpr (R.corootWeylEquiv_corootReflectionMem hdiag i).symm

/-- The faithful covariant action of `R.weylGroup hdiag` on the ambient Cartan space `H`. -/
noncomputable def corootAut : R.weylGroup hdiag →* (H ≃ₗ[K] H) :=
  (R.corootWeylGroup hdiag).subtype.comp (R.corootWeylEquiv hdiag).symm.toMonoidHom

theorem corootAut_apply (w : R.weylGroup hdiag) :
    R.corootAut hdiag w = ((R.corootWeylEquiv hdiag).symm w : H ≃ₗ[K] H) :=
  (rfl)

theorem corootAut_mem_corootWeylGroup (w : R.weylGroup hdiag) :
    R.corootAut hdiag w ∈ R.corootWeylGroup hdiag :=
  ((R.corootWeylEquiv hdiag).symm w).2

theorem corootAut_injective : Function.Injective (R.corootAut hdiag) :=
  Subtype.val_injective.comp (R.corootWeylEquiv hdiag).symm.injective

@[simp]
theorem corootAut_simpleReflectionMem (i : I) :
    R.corootAut hdiag (R.simpleReflectionMem hdiag i) = R.corootReflection hdiag i := by
  rw [corootAut_apply, corootWeylEquiv_symm_simpleReflectionMem, coe_corootReflectionMem]

@[simp]
theorem symm_dualMap_corootAut (w : R.weylGroup hdiag) :
    (R.corootAut hdiag w).symm.dualMap = (w : Dual K H ≃ₗ[K] Dual K H) := by
  have hw := (R.corootWeylEquiv hdiag).apply_symm_apply w
  exact (R.coe_corootWeylEquiv hdiag _).symm.trans (congrArg Subtype.val hw)

theorem smul_dual_apply (w : R.weylGroup hdiag) (φ : Dual K H) (h : H) :
    (w • φ) h = φ (R.corootAut hdiag w⁻¹ h) := by
  have hsymm : (R.corootAut hdiag w).symm = R.corootAut hdiag w⁻¹ := by
    rw [map_inv]
    rfl
  rw [Subgroup.smul_def, LinearEquiv.smul_def, ← R.symm_dualMap_corootAut hdiag w,
    LinearEquiv.dualMap_apply, hsymm]

/-- **Invariance of the evaluation pairing under the Weyl group**: `(w • φ)(w(h)) = φ(h)`. -/
@[simp]
theorem smul_dual_corootAut_apply (w : R.weylGroup hdiag) (φ : Dual K H) (h : H) :
    (w • φ) (R.corootAut hdiag w h) = φ h := by
  rw [smul_dual_apply, ← mul_apply_eq_comp, ← map_mul, inv_mul_cancel, map_one]
  simp

/-! ### Words in the simple reflections and word length -/

/-- The element of `R.weylGroup hdiag` spelled by a list of simple-reflection indices. -/
noncomputable def wordProd (l : List I) : R.weylGroup hdiag :=
  (l.map (R.simpleReflectionMem hdiag)).prod

theorem wordProd_def (l : List I) :
    R.wordProd hdiag l = (l.map (R.simpleReflectionMem hdiag)).prod :=
  (rfl)

@[simp]
theorem wordProd_nil : R.wordProd hdiag [] = 1 :=
  List.prod_nil

@[simp]
theorem wordProd_cons (i : I) (l : List I) :
    R.wordProd hdiag (i :: l) = R.simpleReflectionMem hdiag i * R.wordProd hdiag l :=
  List.prod_cons

theorem wordProd_singleton (i : I) :
    R.wordProd hdiag [i] = R.simpleReflectionMem hdiag i := by
  simp

@[simp]
theorem wordProd_append (l₁ l₂ : List I) :
    R.wordProd hdiag (l₁ ++ l₂) = R.wordProd hdiag l₁ * R.wordProd hdiag l₂ := by
  rw [wordProd_def, List.map_append, List.prod_append]
  rfl

@[simp]
theorem wordProd_reverse (l : List I) :
    R.wordProd hdiag l.reverse = (R.wordProd hdiag l)⁻¹ := by
  simp [wordProd_def, List.prod_reverse_noncomm, Function.comp_def]

/-- Every element of the Weyl group is a product of simple reflections. -/
theorem exists_wordProd_eq (w : R.weylGroup hdiag) :
    ∃ l : List I, R.wordProd hdiag l = w := by
  obtain ⟨f, hf⟩ := w
  induction hf using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨i, rfl⟩ := hg
    exact ⟨[i], R.wordProd_singleton hdiag i⟩
  | one => exact ⟨[], R.wordProd_nil hdiag⟩
  | mul g₁ g₂ hg₁ hg₂ ih₁ ih₂ =>
    obtain ⟨l₁, hl₁⟩ := ih₁
    obtain ⟨l₂, hl₂⟩ := ih₂
    exact ⟨l₁ ++ l₂, (R.wordProd_append hdiag l₁ l₂).trans (congrArg₂ (· * ·) hl₁ hl₂)⟩
  | inv g hg ih =>
    obtain ⟨l, hl⟩ := ih
    exact ⟨l.reverse, (R.wordProd_reverse hdiag l).trans (congrArg Inv.inv hl)⟩

/-- The Weyl group fixes the Cartan center pointwise. -/
theorem corootAut_eq_self_of_mem_cartanCenter (w : R.weylGroup hdiag) {h : H}
    (hh : h ∈ R.cartanCenter) : R.corootAut hdiag w h = h := by
  obtain ⟨l, rfl⟩ := R.exists_wordProd_eq hdiag w
  induction l with
  | nil => simp
  | cons i l ih =>
    rw [wordProd_cons, map_mul, mul_apply_eq_comp, ih, corootAut_simpleReflectionMem]
    exact R.corootReflection_eq_self_of_mem_cartanCenter hdiag hh i

/-- The Weyl group preserves the coroot span. -/
theorem corootAut_mem_corootSpan (w : R.weylGroup hdiag) {h : H} (hh : h ∈ R.corootSpan) :
    R.corootAut hdiag w h ∈ R.corootSpan := by
  obtain ⟨l, rfl⟩ := R.exists_wordProd_eq hdiag w
  induction l generalizing h with
  | nil => simpa using hh
  | cons i l ih =>
    rw [wordProd_cons, map_mul, mul_apply_eq_comp, corootAut_simpleReflectionMem]
    exact R.corootReflection_mem_corootSpan hdiag (ih hh) i

/-- The **length** `ℓ(w)` of an element of `R.weylGroup hdiag`: the minimal length of a word in the
simple reflections spelling `w`. -/
noncomputable def length (w : R.weylGroup hdiag) : ℕ :=
  sInf {n | ∃ l : List I, l.length = n ∧ R.wordProd hdiag l = w}

theorem length_def (w : R.weylGroup hdiag) :
    R.length hdiag w = sInf {n | ∃ l : List I, l.length = n ∧ R.wordProd hdiag l = w} :=
  (rfl)

theorem exists_wordProd_length_eq (w : R.weylGroup hdiag) :
    ∃ l : List I, l.length = R.length hdiag w ∧ R.wordProd hdiag l = w := by
  obtain ⟨l, hl⟩ := R.exists_wordProd_eq hdiag w
  exact Nat.sInf_mem (s := {n | ∃ l : List I, l.length = n ∧ R.wordProd hdiag l = w})
    ⟨l.length, l, rfl, hl⟩

theorem length_wordProd_le (l : List I) :
    R.length hdiag (R.wordProd hdiag l) ≤ l.length :=
  Nat.sInf_le ⟨l, rfl, rfl⟩

@[simp]
theorem length_one : R.length hdiag 1 = 0 :=
  Nat.eq_zero_of_le_zero ((R.wordProd_nil hdiag) ▸ R.length_wordProd_le hdiag [])

@[simp]
theorem length_eq_zero_iff {w : R.weylGroup hdiag} :
    R.length hdiag w = 0 ↔ w = 1 := by
  refine ⟨fun h0 ↦ ?_, fun hw ↦ hw ▸ R.length_one hdiag⟩
  obtain ⟨l, hl, rfl⟩ := R.exists_wordProd_length_eq hdiag w
  rw [h0, List.length_eq_zero_iff] at hl
  rw [hl, wordProd_nil]

@[simp]
theorem length_inv (w : R.weylGroup hdiag) :
    R.length hdiag w⁻¹ = R.length hdiag w := by
  have hle (u : R.weylGroup hdiag) : R.length hdiag u⁻¹ ≤ R.length hdiag u := by
    obtain ⟨l, hl, rfl⟩ := R.exists_wordProd_length_eq hdiag u
    rw [← wordProd_reverse, ← hl, ← List.length_reverse]
    exact R.length_wordProd_le hdiag l.reverse
  exact le_antisymm (hle w) (inv_inv w ▸ hle w⁻¹)

theorem length_mul_le (w₁ w₂ : R.weylGroup hdiag) :
    R.length hdiag (w₁ * w₂) ≤ R.length hdiag w₁ + R.length hdiag w₂ := by
  obtain ⟨l₁, hl₁, rfl⟩ := R.exists_wordProd_length_eq hdiag w₁
  obtain ⟨l₂, hl₂, rfl⟩ := R.exists_wordProd_length_eq hdiag w₂
  rw [← wordProd_append, ← hl₁, ← hl₂, ← List.length_append]
  exact R.length_wordProd_le hdiag (l₁ ++ l₂)

@[simp]
theorem length_simpleReflectionMem [CharZero K] (i : I) :
    R.length hdiag (R.simpleReflectionMem hdiag i) = 1 := by
  have hle : R.length hdiag (R.simpleReflectionMem hdiag i) ≤ 1 := by
    simpa using R.length_wordProd_le hdiag [i]
  have hne : R.length hdiag (R.simpleReflectionMem hdiag i) ≠ 0 := by
    rw [Ne, length_eq_zero_iff]
    exact R.simpleReflectionMem_ne_one hdiag i
  omega

end WeylGroupAPI

end Field

/-! ### Stability of the root, coweight, and weight lattices -/

section IntegralRootLattice

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)
  (hdiag : ∀ i, A.map (Int.cast : ℤ → K) i i = 2)

theorem simpleReflection_root_int (i j : I) :
    R.simpleReflection hdiag i (R.root j) = R.root j - A i j • R.root i := by
  rw [simpleReflection_root, Matrix.map_apply]
  exact congrArg (R.root j - ·) (Int.cast_smul_eq_zsmul K (A i j) (R.root i))

theorem simpleReflection_mem_rootLattice (i : I) {φ : Dual K H} (hφ : φ ∈ R.rootLattice) :
    R.simpleReflection hdiag i φ ∈ R.rootLattice := by
  rw [R.rootLattice_def] at hφ
  induction hφ using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    rw [simpleReflection_root_int]
    exact sub_mem (R.root_mem_rootLattice j)
      (Submodule.smul_mem _ (A i j) (R.root_mem_rootLattice i))
  | zero => simp
  | add x y _ _ ihx ihy => rw [map_add]; exact add_mem ihx ihy
  | smul n x _ ih => rw [map_zsmul]; exact Submodule.smul_mem _ n ih

/-- The Weyl group preserves the root lattice `Q = ⊕ᵢ ℤ αᵢ`. -/
theorem smul_mem_rootLattice (w : R.weylGroup hdiag) {φ : Dual K H} (hφ : φ ∈ R.rootLattice) :
    w • φ ∈ R.rootLattice := by
  obtain ⟨l, rfl⟩ := R.exists_wordProd_eq hdiag w
  induction l generalizing φ with
  | nil => simpa using hφ
  | cons i l ih =>
    rw [wordProd_cons, mul_smul]
    exact R.simpleReflection_mem_rootLattice hdiag i (ih hφ)

/-- The induced `ℤ`-linear automorphism action of `R.weylGroup hdiag` on `R.rootLattice`. -/
noncomputable def rootLatticeAut : R.weylGroup hdiag →* (R.rootLattice ≃ₗ[ℤ] R.rootLattice) where
  toFun w :=
    { toFun α := ⟨w • (α : Dual K H), R.smul_mem_rootLattice hdiag w α.2⟩
      map_add' α β := Subtype.ext (smul_add w (α : Dual K H) β)
      map_smul' n α := Subtype.ext (map_zsmul (w : Dual K H ≃ₗ[K] Dual K H) n (α : Dual K H))
      invFun α := ⟨w⁻¹ • (α : Dual K H), R.smul_mem_rootLattice hdiag w⁻¹ α.2⟩
      left_inv α := Subtype.ext (inv_smul_smul w (α : Dual K H))
      right_inv α := Subtype.ext (smul_inv_smul w (α : Dual K H)) }
  map_one' := by ext α; simp
  map_mul' w₁ w₂ := by ext α; simp [mul_smul]

@[simp]
theorem coe_rootLatticeAut_apply (w : R.weylGroup hdiag) (α : R.rootLattice) :
    (R.rootLatticeAut hdiag w α : Dual K H) = w • (α : Dual K H) :=
  (rfl)

end IntegralRootLattice

namespace CoweightLattice

variable {I H : Type*} [AddCommGroup H] [Module ℚ H] {A : Matrix I I ℤ}
  {R : CartanRealization (A.map (Int.cast : ℤ → ℚ)) H}
  (L : R.CoweightLattice) (hdiag : ∀ i, A.map (Int.cast : ℤ → ℚ) i i = 2)

theorem corootReflection_mem_lattice (i : I) {y : H} (hy : y ∈ L.lattice) :
    R.corootReflection hdiag i y ∈ L.lattice := by
  have hcast : R.root i y = (L.pairing (L.root i) ⟨y, hy⟩ : ℚ) := by simp
  rw [corootReflection_apply, hcast, Int.cast_smul_eq_zsmul]
  exact sub_mem hy (Submodule.smul_mem _ _ (L.coroot_mem i))

/-- The Weyl group preserves any coweight lattice `Y ⊆ H`. -/
theorem corootAut_mem_lattice (w : R.weylGroup hdiag) {y : H} (hy : y ∈ L.lattice) :
    R.corootAut hdiag w y ∈ L.lattice := by
  obtain ⟨l, rfl⟩ := R.exists_wordProd_eq hdiag w
  induction l generalizing y with
  | nil => simpa using hy
  | cons i l ih =>
    rw [wordProd_cons, map_mul, mul_apply_eq_comp, corootAut_simpleReflectionMem]
    exact L.corootReflection_mem_lattice hdiag i (ih hy)

/-- The Weyl group preserves the weight lattice `P = Y* ⊆ Dual ℚ H`. -/
theorem smul_mem_weightLattice (w : R.weylGroup hdiag) {φ : Dual ℚ H}
    (hφ : φ ∈ L.weightLattice) : w • φ ∈ L.weightLattice := by
  rw [L.mem_weightLattice_iff] at hφ ⊢
  intro y hy
  rw [R.smul_dual_apply hdiag w φ y]
  exact hφ _ (L.corootAut_mem_lattice hdiag w⁻¹ hy)

/-- The induced `ℤ`-linear automorphism action of `R.weylGroup hdiag` on the coweight lattice. -/
noncomputable def coweightAut : R.weylGroup hdiag →* (L.lattice ≃ₗ[ℤ] L.lattice) where
  toFun w :=
    { toFun y := ⟨R.corootAut hdiag w y, L.corootAut_mem_lattice hdiag w y.2⟩
      map_add' y₁ y₂ := Subtype.ext (map_add (R.corootAut hdiag w) (y₁ : H) (y₂ : H))
      map_smul' n y := Subtype.ext (map_zsmul (R.corootAut hdiag w) n (y : H))
      invFun y := ⟨R.corootAut hdiag w⁻¹ y, L.corootAut_mem_lattice hdiag w⁻¹ y.2⟩
      left_inv y := Subtype.ext <| by
        have hmul : (R.corootAut hdiag w⁻¹ * R.corootAut hdiag w) (y : H) = y := by
          rw [← map_mul, inv_mul_cancel, map_one]
          simp
        exact (mul_apply_eq_comp _ _ _).symm.trans hmul
      right_inv y := Subtype.ext <| by
        have hmul : (R.corootAut hdiag w * R.corootAut hdiag w⁻¹) (y : H) = y := by
          rw [← map_mul, mul_inv_cancel, map_one]
          simp
        exact (mul_apply_eq_comp _ _ _).symm.trans hmul }
  map_one' := by ext y; simp
  map_mul' w₁ w₂ := by ext y; simp [mul_apply_eq_comp]

/-- The induced `ℤ`-linear automorphism action of `R.weylGroup hdiag` on the weight lattice. -/
noncomputable def weightAut : R.weylGroup hdiag →* (L.weightLattice ≃ₗ[ℤ] L.weightLattice) where
  toFun w :=
    { toFun φ := ⟨w • (φ : Dual ℚ H), L.smul_mem_weightLattice hdiag w φ.2⟩
      map_add' φ₁ φ₂ := Subtype.ext (smul_add w (φ₁ : Dual ℚ H) φ₂)
      map_smul' n φ := Subtype.ext (map_zsmul (w : Dual ℚ H ≃ₗ[ℚ] Dual ℚ H) n (φ : Dual ℚ H))
      invFun φ := ⟨w⁻¹ • (φ : Dual ℚ H), L.smul_mem_weightLattice hdiag w⁻¹ φ.2⟩
      left_inv φ := Subtype.ext (inv_smul_smul w (φ : Dual ℚ H))
      right_inv φ := Subtype.ext (smul_inv_smul w (φ : Dual ℚ H)) }
  map_one' := by ext φ; simp
  map_mul' w₁ w₂ := by ext φ; simp [mul_smul]

@[simp]
theorem coe_coweightAut_apply (w : R.weylGroup hdiag) (y : L.lattice) :
    (L.coweightAut hdiag w y : H) = R.corootAut hdiag w y :=
  (rfl)

@[simp]
theorem coe_weightAut_apply (w : R.weylGroup hdiag) (φ : L.weightLattice) :
    (L.weightAut hdiag w φ : Dual ℚ H) = w • (φ : Dual ℚ H) :=
  (rfl)

/-- The integral pairing `P × Y → ℤ` is invariant under the Weyl group. -/
@[simp]
theorem pairing_weightAut_coweightAut (w : R.weylGroup hdiag) (φ : L.weightLattice)
    (y : L.lattice) :
    L.pairing (L.weightAut hdiag w φ) (L.coweightAut hdiag w y) = L.pairing φ y := by
  refine Int.cast_injective (α := ℚ) ?_
  rw [L.cast_pairing, L.cast_pairing, coe_weightAut_apply, coe_coweightAut_apply,
    R.smul_dual_corootAut_apply]

end CoweightLattice

end TauCeti.CartanRealization
