module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.LinearAlgebra.Reflection
public import TauCeti.LinearAlgebra.Matrix.Cartan.Realization.RootLattice
import TauCeti.LinearAlgebra.LinearEquiv.Basic

/-!
# Simple reflections and the Weyl group of a Cartan realization

For a `TauCeti.CartanRealization` `R` of a matrix `A` with diagonal `2` on a `K`-vector space `H`,
every node `i : I` carries dual involutive reflections built from `Module.reflection`:
`TauCeti.CartanRealization.simpleReflection` on `Module.Dual K H` (`sᵢ(φ) = φ - φ(hᵢ) • αᵢ`) and
`TauCeti.CartanRealization.corootReflection` on `H` (`sᵢ(h) = h - αᵢ(h) • hᵢ`).

The **Weyl group** `TauCeti.CartanRealization.weylGroup` is generated by the `simpleReflection`s.
Without assuming `H` is finite-dimensional, `e ↦ e.symm.dualMap` identifies `R.corootWeylGroup`
canonically with `R.weylGroup` (`corootWeylEquiv`), giving a faithful covariant action `corootAut`
preserving the evaluation pairing, fixing `R.cartanCenter`, and stabilizing every subspace
containing `R.corootSpan`. We also define `wordProd`, minimal generator-word `length`, the
induction principle `weylGroup_induction`, and the induced `ℤ`-linear lattice actions
`rootLatticeAut`, `CoweightLattice.coweightAut`, and `CoweightLattice.weightAut` (Kac, §3.7).
-/

public section

open Module

namespace TauCeti.CartanRealization

section Field
variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I K}
  (R : CartanRealization A H)

/-- The simple reflection `sᵢ(φ) = φ - φ(hᵢ) • αᵢ` on `Dual K H`. -/
noncomputable def simpleReflection (hdiag : ∀ i, A i i = 2) (i : I) : Dual K H ≃ₗ[K] Dual K H :=
  Module.reflection (f := Dual.eval K H (R.coroot i)) (x := R.root i) (by simp [hdiag i])
/-- The simple reflection `sᵢ(h) = h - αᵢ(h) • hᵢ` on the ambient Cartan space `H`. -/
noncomputable def corootReflection (hdiag : ∀ i, A i i = 2) (i : I) : H ≃ₗ[K] H :=
  Module.reflection (f := R.root i) (x := R.coroot i) (by simp [hdiag i])

section BasicReflections
variable (hdiag : ∀ i, A i i = 2)

theorem simpleReflection_eq_reflection (i : I) : R.simpleReflection hdiag i =
    Module.reflection (f := Dual.eval K H (R.coroot i)) (x := R.root i) (by simp [hdiag i]) :=
  (rfl)
theorem corootReflection_eq_reflection (i : I) : R.corootReflection hdiag i =
    Module.reflection (f := R.root i) (x := R.coroot i) (by simp [hdiag i]) := (rfl)
theorem simpleReflection_apply (i : I) (φ : Dual K H) :
    R.simpleReflection hdiag i φ = φ - φ (R.coroot i) • R.root i := Module.reflection_apply φ _
theorem corootReflection_apply (i : I) (h : H) :
    R.corootReflection hdiag i h = h - R.root i h • R.coroot i := Module.reflection_apply h _
theorem simpleReflection_root (i j : I) :
    R.simpleReflection hdiag i (R.root j) = R.root j - A i j • R.root i := by
  rw [simpleReflection_apply, R.root_coroot]
theorem corootReflection_coroot (i j : I) :
    R.corootReflection hdiag i (R.coroot j) = R.coroot j - A j i • R.coroot i := by
  rw [corootReflection_apply, R.root_coroot]
@[simp] theorem simpleReflection_root_self (i : I) :
    R.simpleReflection hdiag i (R.root i) = -R.root i := Module.reflection_apply_self _
@[simp] theorem corootReflection_coroot_self (i : I) :
    R.corootReflection hdiag i (R.coroot i) = -R.coroot i := Module.reflection_apply_self _
theorem involutive_simpleReflection (i : I) :
    Function.Involutive (R.simpleReflection hdiag i) := Module.involutive_reflection _
theorem involutive_corootReflection (i : I) :
    Function.Involutive (R.corootReflection hdiag i) := Module.involutive_reflection _
@[simp] theorem simpleReflection_simpleReflection (i : I) (φ : Dual K H) :
    R.simpleReflection hdiag i (R.simpleReflection hdiag i φ) = φ :=
  R.involutive_simpleReflection hdiag i φ
@[simp] theorem corootReflection_corootReflection (i : I) (h : H) :
    R.corootReflection hdiag i (R.corootReflection hdiag i h) = h :=
  R.involutive_corootReflection hdiag i h
@[simp] theorem simpleReflection_symm (i : I) :
    (R.simpleReflection hdiag i).symm = R.simpleReflection hdiag i := Module.reflection_symm _
@[simp] theorem corootReflection_symm (i : I) :
    (R.corootReflection hdiag i).symm = R.corootReflection hdiag i := Module.reflection_symm _
@[simp] theorem simpleReflection_inv (i : I) :
    (R.simpleReflection hdiag i)⁻¹ = R.simpleReflection hdiag i := Module.reflection_inv _
@[simp] theorem corootReflection_inv (i : I) :
    (R.corootReflection hdiag i)⁻¹ = R.corootReflection hdiag i := Module.reflection_inv _
@[simp] theorem simpleReflection_mul_self (i : I) :
    R.simpleReflection hdiag i * R.simpleReflection hdiag i = 1 :=
  LinearEquiv.ext (R.simpleReflection_simpleReflection hdiag i)
@[simp] theorem corootReflection_mul_self (i : I) :
    R.corootReflection hdiag i * R.corootReflection hdiag i = 1 :=
  LinearEquiv.ext (R.corootReflection_corootReflection hdiag i)
@[simp] theorem dualMap_corootReflection (i : I) :
    (R.corootReflection hdiag i).dualMap = R.simpleReflection hdiag i := by
  ext φ h
  simp only [LinearEquiv.dualMap_apply, corootReflection_apply, simpleReflection_apply,
    map_sub, map_smul, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul, mul_comm]

theorem simpleReflection_ne_one [NeZero (2 : K)] (i : I) : R.simpleReflection hdiag i ≠ 1 :=
  fun h1 ↦ by
    have htwo : (2 : K) • R.root i = 0 := by
      rw [two_smul, ← neg_eq_iff_add_eq_zero, ← R.simpleReflection_root_self hdiag i, h1,
        FunLike.coe_one_eq_id, id_eq]
    exact (smul_eq_zero.mp htwo).elim (NeZero.ne 2) (R.root_linearIndependent.ne_zero i)
theorem corootReflection_ne_one [NeZero (2 : K)] (i : I) : R.corootReflection hdiag i ≠ 1 :=
  fun h1 ↦ R.simpleReflection_ne_one hdiag i (by
    rw [← dualMap_corootReflection, h1]; ext φ h; simp [LinearEquiv.dualMap_apply])
theorem simpleReflection_apply_eq_apply_corootReflection (i : I) (φ : Dual K H) (h : H) :
    R.simpleReflection hdiag i φ h = φ (R.corootReflection hdiag i h) := by
  rw [← R.dualMap_corootReflection hdiag i, LinearEquiv.dualMap_apply]
@[simp] theorem simpleReflection_apply_corootReflection (i : I) (φ : Dual K H) (h : H) :
    R.simpleReflection hdiag i φ (R.corootReflection hdiag i h) = φ h := by
  rw [simpleReflection_apply_eq_apply_corootReflection, corootReflection_corootReflection]
theorem corootReflection_eq_self_of_mem_cartanCenter {h : H} (hh : h ∈ R.cartanCenter) (i : I) :
    R.corootReflection hdiag i h = h := by
  rw [corootReflection_apply, (R.mem_cartanCenter_iff h).mp hh i, zero_smul, sub_zero]
theorem corootReflection_mem_corootSpan {h : H} (hh : h ∈ R.corootSpan) (i : I) :
    R.corootReflection hdiag i h ∈ R.corootSpan :=
  (R.corootReflection_eq_reflection hdiag i ▸
    Submodule.mem_invtSubmodule_reflection_of_mem _ R.corootSpan (R.coroot_mem_corootSpan i)) hh
theorem map_corootReflection_apply {H' : Type*} [AddCommGroup H'] [Module K H']
    (e : H ≃ₗ[K] H') (i : I) (h : H) :
    (R.map e).corootReflection hdiag i (e h) = e (R.corootReflection hdiag i h) := by
  simp [corootReflection_apply]
theorem coe_restrict_corootReflection (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (i : I) (m : M) :
    (((R.restrict M hc hs).corootReflection hdiag i m : M) : H) =
      R.corootReflection hdiag i m := by simp [corootReflection_apply]
theorem dualMap_subtype_simpleReflection (M : Submodule K H) (hc : R.corootSpan ≤ M)
    (hs : M ⊔ R.cartanCenter = ⊤) (i : I) (φ : Dual K H) :
    M.subtype.dualMap (R.simpleReflection hdiag i φ) =
      (R.restrict M hc hs).simpleReflection hdiag i (M.subtype.dualMap φ) := by
  ext m; simp [simpleReflection_apply]
end BasicReflections

/-- The **Weyl group** of a Cartan realization: the subgroup of `Dual K H ≃ₗ[K] Dual K H`
generated by the simple reflections. -/
noncomputable def weylGroup (hdiag : ∀ i, A i i = 2) : Subgroup (Dual K H ≃ₗ[K] Dual K H) :=
  Subgroup.closure (Set.range (R.simpleReflection hdiag))
/-- The `i`-th simple reflection as an element of `R.weylGroup hdiag`. -/
noncomputable def simpleReflectionMem (hdiag : ∀ i, A i i = 2) (i : I) : R.weylGroup hdiag :=
  ⟨R.simpleReflection hdiag i, Subgroup.subset_closure (Set.mem_range_self i)⟩
/-- The **coroot Weyl group** on `H`: generated by the simple coroot reflections. -/
noncomputable def corootWeylGroup (hdiag : ∀ i, A i i = 2) : Subgroup (H ≃ₗ[K] H) :=
  Subgroup.closure (Set.range (R.corootReflection hdiag))
/-- The `i`-th simple coroot reflection as an element of `R.corootWeylGroup hdiag`. -/
noncomputable def corootReflectionMem (hdiag : ∀ i, A i i = 2) (i : I) : R.corootWeylGroup hdiag :=
  ⟨R.corootReflection hdiag i, Subgroup.subset_closure (Set.mem_range_self i)⟩

section WeylGroupAPI
variable (hdiag : ∀ i, A i i = 2)

theorem weylGroup_def :
    R.weylGroup hdiag = Subgroup.closure (Set.range (R.simpleReflection hdiag)) := (rfl)
theorem corootWeylGroup_def :
    R.corootWeylGroup hdiag = Subgroup.closure (Set.range (R.corootReflection hdiag)) := (rfl)
@[simp] theorem coe_simpleReflectionMem (i : I) :
    (R.simpleReflectionMem hdiag i : Dual K H ≃ₗ[K] Dual K H) = R.simpleReflection hdiag i := (rfl)
@[simp] theorem coe_corootReflectionMem (i : I) :
    (R.corootReflectionMem hdiag i : H ≃ₗ[K] H) = R.corootReflection hdiag i := (rfl)
/-- The `•` action of `R.weylGroup hdiag` on `Dual K H` evaluates the underlying linear
equivalence. -/
theorem weylGroup_smul_def (w : R.weylGroup hdiag) (φ : Dual K H) :
    w • φ = (w : Dual K H ≃ₗ[K] Dual K H) φ := (rfl)
/-- The simple reflection `R.simpleReflectionMem hdiag i` acts on `Dual K H` via
`R.simpleReflection hdiag i`. -/
@[simp] theorem simpleReflectionMem_smul (i : I) (φ : Dual K H) :
    R.simpleReflectionMem hdiag i • φ = R.simpleReflection hdiag i φ := (rfl)
/-- A simple reflection negates its own simple root under the Weyl-group action. -/
theorem simpleReflectionMem_smul_root_self (i : I) :
    R.simpleReflectionMem hdiag i • R.root i = -R.root i := by simp
@[simp] theorem simpleReflectionMem_mul_self (i : I) :
    R.simpleReflectionMem hdiag i * R.simpleReflectionMem hdiag i = 1 :=
  Subtype.ext (R.simpleReflection_mul_self hdiag i)
@[simp] theorem corootReflectionMem_mul_self (i : I) :
    R.corootReflectionMem hdiag i * R.corootReflectionMem hdiag i = 1 :=
  Subtype.ext (R.corootReflection_mul_self hdiag i)
@[simp] theorem simpleReflectionMem_inv (i : I) :
    (R.simpleReflectionMem hdiag i)⁻¹ = R.simpleReflectionMem hdiag i :=
  Subtype.ext (R.simpleReflection_inv hdiag i)
@[simp] theorem corootReflectionMem_inv (i : I) :
    (R.corootReflectionMem hdiag i)⁻¹ = R.corootReflectionMem hdiag i :=
  Subtype.ext (R.corootReflection_inv hdiag i)
theorem simpleReflectionMem_ne_one [NeZero (2 : K)] (i : I) :
    R.simpleReflectionMem hdiag i ≠ 1 :=
  fun h ↦ R.simpleReflection_ne_one hdiag i (congrArg Subtype.val h)
@[simp] theorem orderOf_simpleReflectionMem [NeZero (2 : K)] (i : I) :
    orderOf (R.simpleReflectionMem hdiag i) = 2 :=
  orderOf_eq_prime (by rw [sq, simpleReflectionMem_mul_self]) (R.simpleReflectionMem_ne_one hdiag i)

/-- **Canonical isomorphism between the coroot Weyl group on `H` and the Weyl group on `H*`.** -/
noncomputable def corootWeylEquiv : R.corootWeylGroup hdiag ≃* R.weylGroup hdiag :=
  let φ : (H ≃ₗ[K] H) →* (Dual K H ≃ₗ[K] Dual K H) :=
    { toFun e := e.symm.dualMap
      map_one' := by ext f h; simp [LinearEquiv.dualMap_apply, LinearEquiv.symm_eq_inv]
      map_mul' _ _ := by
        ext f h; simp [LinearEquiv.dualMap_apply, LinearEquiv.symm_eq_inv, mul_apply_eq_comp] }
  have hφ : Function.Injective φ := fun e₁ e₂ h ↦ by
    have hsymm : e₁.dualMap = e₂.dualMap := by simpa [φ] using congrArg LinearEquiv.symm h
    ext x; refine (Basis.ofVectorSpace K H).eval_injective ?_
    ext f; exact congrArg (fun g : Dual K H ≃ₗ[K] Dual K H ↦ g f x) hsymm
  ((R.corootWeylGroup hdiag).equivMapOfInjective φ hφ).trans <| MulEquiv.subgroupCongr <| by
    rw [corootWeylGroup_def, weylGroup_def, MonoidHom.map_closure, ← Set.range_comp]
    exact congrArg (fun f : I → _ ↦ Subgroup.closure (Set.range f)) (funext fun i ↦ by simp [φ])

@[simp] theorem coe_corootWeylEquiv (g : R.corootWeylGroup hdiag) :
    (R.corootWeylEquiv hdiag g : Dual K H ≃ₗ[K] Dual K H) = (g : H ≃ₗ[K] H).symm.dualMap := (rfl)
@[simp] theorem corootWeylEquiv_corootReflectionMem (i : I) :
    R.corootWeylEquiv hdiag (R.corootReflectionMem hdiag i) = R.simpleReflectionMem hdiag i := by
  ext φ h; simp [coe_corootWeylEquiv]
@[simp] theorem corootWeylEquiv_symm_simpleReflectionMem (i : I) :
    (R.corootWeylEquiv hdiag).symm (R.simpleReflectionMem hdiag i) =
      R.corootReflectionMem hdiag i :=
  (R.corootWeylEquiv hdiag).symm_apply_eq.mpr (R.corootWeylEquiv_corootReflectionMem hdiag i).symm

/-- The faithful covariant action of `R.weylGroup hdiag` on the ambient Cartan space `H`. -/
noncomputable def corootAut : R.weylGroup hdiag →* (H ≃ₗ[K] H) :=
  (R.corootWeylGroup hdiag).subtype.comp (R.corootWeylEquiv hdiag).symm.toMonoidHom

theorem corootAut_apply (w : R.weylGroup hdiag) :
    R.corootAut hdiag w = ((R.corootWeylEquiv hdiag).symm w : H ≃ₗ[K] H) := (rfl)
theorem corootAut_mem_corootWeylGroup (w : R.weylGroup hdiag) :
    R.corootAut hdiag w ∈ R.corootWeylGroup hdiag := ((R.corootWeylEquiv hdiag).symm w).2
theorem corootAut_injective : Function.Injective (R.corootAut hdiag) :=
  Subtype.val_injective.comp (R.corootWeylEquiv hdiag).symm.injective
@[simp] theorem corootAut_simpleReflectionMem (i : I) :
    R.corootAut hdiag (R.simpleReflectionMem hdiag i) = R.corootReflection hdiag i := by
  rw [corootAut_apply, corootWeylEquiv_symm_simpleReflectionMem, coe_corootReflectionMem]
@[simp] theorem symm_dualMap_corootAut (w : R.weylGroup hdiag) :
    (R.corootAut hdiag w).symm.dualMap = (w : Dual K H ≃ₗ[K] Dual K H) :=
  (R.coe_corootWeylEquiv hdiag _).symm.trans
    (congrArg Subtype.val ((R.corootWeylEquiv hdiag).apply_symm_apply w))
theorem smul_dual_apply (w : R.weylGroup hdiag) (φ : Dual K H) (h : H) :
    (w • φ) h = φ (R.corootAut hdiag w⁻¹ h) := by
  rw [weylGroup_smul_def, ← R.symm_dualMap_corootAut hdiag w, LinearEquiv.dualMap_apply,
    LinearEquiv.symm_eq_inv, ← map_inv]
@[simp] theorem smul_dual_corootAut_apply (w : R.weylGroup hdiag) (φ : Dual K H) (h : H) :
    (w • φ) (R.corootAut hdiag w h) = φ h := by simp [smul_dual_apply]

/-- The element of `R.weylGroup hdiag` spelled by a list of simple-reflection indices. -/
noncomputable def wordProd (l : List I) : R.weylGroup hdiag :=
  (l.map (R.simpleReflectionMem hdiag)).prod

theorem wordProd_def (l : List I) :
    R.wordProd hdiag l = (l.map (R.simpleReflectionMem hdiag)).prod := (rfl)
@[simp] theorem wordProd_nil : R.wordProd hdiag [] = 1 := List.prod_nil
@[simp] theorem wordProd_cons (i : I) (l : List I) :
    R.wordProd hdiag (i :: l) = R.simpleReflectionMem hdiag i * R.wordProd hdiag l := List.prod_cons
theorem wordProd_singleton (i : I) : R.wordProd hdiag [i] = R.simpleReflectionMem hdiag i := by simp
@[simp] theorem wordProd_append (l₁ l₂ : List I) :
    R.wordProd hdiag (l₁ ++ l₂) = R.wordProd hdiag l₁ * R.wordProd hdiag l₂ := by
  simp only [wordProd_def, List.map_append, List.prod_append]
@[simp] theorem wordProd_reverse (l : List I) :
    R.wordProd hdiag l.reverse = (R.wordProd hdiag l)⁻¹ := by
  simp [wordProd_def, List.prod_reverse_noncomm, Function.comp_def]
theorem exists_wordProd_eq (w : R.weylGroup hdiag) : ∃ l : List I, R.wordProd hdiag l = w := by
  obtain ⟨f, hf⟩ := w
  induction hf using Subgroup.closure_induction with
  | mem _ hg => obtain ⟨i, rfl⟩ := hg; exact ⟨[i], R.wordProd_singleton hdiag i⟩
  | one => exact ⟨[], R.wordProd_nil hdiag⟩
  | mul _ _ _ _ ih₁ ih₂ =>
    obtain ⟨l₁, hl₁⟩ := ih₁; obtain ⟨l₂, hl₂⟩ := ih₂
    exact ⟨l₁ ++ l₂, (R.wordProd_append hdiag l₁ l₂).trans (congrArg₂ (· * ·) hl₁ hl₂)⟩
  | inv _ _ ih =>
    obtain ⟨l, hl⟩ := ih
    exact ⟨l.reverse, (R.wordProd_reverse hdiag l).trans (congrArg Inv.inv hl)⟩

/-- Induction principle on `R.weylGroup hdiag`: a property holding at `1` and preserved under left
multiplication by every simple reflection `R.simpleReflectionMem hdiag i` holds on the whole
Weyl group. -/
@[elab_as_elim] theorem weylGroup_induction {P : R.weylGroup hdiag → Prop} (one : P 1)
    (mul_simple : ∀ (i : I) (w : R.weylGroup hdiag), P w → P (R.simpleReflectionMem hdiag i * w))
    (w : R.weylGroup hdiag) : P w := by
  obtain ⟨l, rfl⟩ := R.exists_wordProd_eq hdiag w
  induction l with
  | nil => simpa using one
  | cons i l ih => rw [wordProd_cons]; exact mul_simple i _ ih

/-- Every Weyl-group element fixes `R.cartanCenter` pointwise under `R.corootAut`. -/
theorem corootAut_eq_self_of_mem_cartanCenter (w : R.weylGroup hdiag) {h : H}
    (hh : h ∈ R.cartanCenter) : R.corootAut hdiag w h = h := by
  induction w using R.weylGroup_induction hdiag with
  | one => simp
  | mul_simple i w ih =>
    rw [map_mul, mul_apply_eq_comp, ih, corootAut_simpleReflectionMem]
    exact R.corootReflection_eq_self_of_mem_cartanCenter hdiag hh i
/-- Every subspace `M` containing `R.corootSpan` is stable under `R.corootAut`. -/
theorem corootAut_mem_of_corootSpan_le {M : Submodule K H} (hc : R.corootSpan ≤ M)
    (w : R.weylGroup hdiag) {m : H} (hm : m ∈ M) : R.corootAut hdiag w m ∈ M := by
  induction w using R.weylGroup_induction hdiag with
  | one => simpa using hm
  | mul_simple i w ih =>
    rw [map_mul, mul_apply_eq_comp, corootAut_simpleReflectionMem, corootReflection_apply]
    exact sub_mem ih (M.smul_mem _ (hc (R.coroot_mem_corootSpan i)))
/-- The coroot span `R.corootSpan` is stable under `R.corootAut`. -/
theorem corootAut_mem_corootSpan (w : R.weylGroup hdiag) {h : H} (hh : h ∈ R.corootSpan) :
    R.corootAut hdiag w h ∈ R.corootSpan := R.corootAut_mem_of_corootSpan_le hdiag le_rfl w hh

/-- The **length** `ℓ(w)` of an element of `R.weylGroup hdiag`: the minimal length of a word in the
simple reflections spelling `w`. -/
noncomputable def length (w : R.weylGroup hdiag) : ℕ :=
  sInf {n | ∃ l : List I, l.length = n ∧ R.wordProd hdiag l = w}

theorem length_def (w : R.weylGroup hdiag) :
    R.length hdiag w = sInf {n | ∃ l : List I, l.length = n ∧ R.wordProd hdiag l = w} := (rfl)
theorem exists_wordProd_length_eq (w : R.weylGroup hdiag) :
    ∃ l : List I, l.length = R.length hdiag w ∧ R.wordProd hdiag l = w := by
  obtain ⟨l, hl⟩ := R.exists_wordProd_eq hdiag w
  exact Nat.sInf_mem (s := {n | ∃ l : List I, l.length = n ∧ R.wordProd hdiag l = w})
    ⟨l.length, l, rfl, hl⟩
theorem length_wordProd_le (l : List I) : R.length hdiag (R.wordProd hdiag l) ≤ l.length :=
  Nat.sInf_le ⟨l, rfl, rfl⟩
@[simp] theorem length_one : R.length hdiag 1 = 0 :=
  Nat.eq_zero_of_le_zero ((R.wordProd_nil hdiag) ▸ R.length_wordProd_le hdiag [])
@[simp] theorem length_eq_zero_iff {w : R.weylGroup hdiag} : R.length hdiag w = 0 ↔ w = 1 := by
  refine ⟨fun h0 ↦ ?_, fun hw ↦ hw ▸ R.length_one hdiag⟩
  obtain ⟨l, hl, rfl⟩ := R.exists_wordProd_length_eq hdiag w
  rw [List.length_eq_zero_iff.mp (hl.trans h0), wordProd_nil]
@[simp] theorem length_inv (w : R.weylGroup hdiag) : R.length hdiag w⁻¹ = R.length hdiag w := by
  have hle (u : R.weylGroup hdiag) : R.length hdiag u⁻¹ ≤ R.length hdiag u := by
    obtain ⟨l, hl, rfl⟩ := R.exists_wordProd_length_eq hdiag u
    simpa [← wordProd_reverse, ← hl] using R.length_wordProd_le hdiag l.reverse
  exact le_antisymm (hle w) (inv_inv w ▸ hle w⁻¹)
theorem length_mul_le (w₁ w₂ : R.weylGroup hdiag) :
    R.length hdiag (w₁ * w₂) ≤ R.length hdiag w₁ + R.length hdiag w₂ := by
  obtain ⟨l₁, hl₁, rfl⟩ := R.exists_wordProd_length_eq hdiag w₁
  obtain ⟨l₂, hl₂, rfl⟩ := R.exists_wordProd_length_eq hdiag w₂
  simpa [← wordProd_append, ← hl₁, ← hl₂] using R.length_wordProd_le hdiag (l₁ ++ l₂)
@[simp] theorem length_simpleReflectionMem [NeZero (2 : K)] (i : I) :
    R.length hdiag (R.simpleReflectionMem hdiag i) = 1 := by
  have hle : R.length hdiag (R.simpleReflectionMem hdiag i) ≤ 1 := by
    simpa using R.length_wordProd_le hdiag [i]
  have hne : R.length hdiag (R.simpleReflectionMem hdiag i) ≠ 0 :=
    mt (R.length_eq_zero_iff hdiag).mp (R.simpleReflectionMem_ne_one hdiag i)
  omega
end WeylGroupAPI
end Field

section IntegralRootLattice
variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)
  (hdiag : ∀ i, A.map (Int.cast : ℤ → K) i i = 2)

theorem simpleReflection_root_int (i j : I) :
    R.simpleReflection hdiag i (R.root j) = R.root j - A i j • R.root i :=
  (R.simpleReflection_root hdiag i j).trans <|
    congrArg (R.root j - ·) (Int.cast_smul_eq_zsmul K (A i j) (R.root i))
theorem simpleReflection_mem_rootLattice (i : I) {φ : Dual K H} (hφ : φ ∈ R.rootLattice) :
    R.simpleReflection hdiag i φ ∈ R.rootLattice := by
  rw [R.rootLattice_def] at hφ
  induction hφ using Submodule.span_induction with
  | mem _ hx =>
    obtain ⟨j, rfl⟩ := hx; rw [simpleReflection_root_int]
    exact sub_mem (R.root_mem_rootLattice j)
      (Submodule.smul_mem _ (A i j) (R.root_mem_rootLattice i))
  | zero => simp
  | add _ _ _ _ ihx ihy => rw [map_add]; exact add_mem ihx ihy
  | smul n _ _ ih => rw [map_zsmul]; exact Submodule.smul_mem _ n ih
theorem smul_mem_rootLattice (w : R.weylGroup hdiag) {φ : Dual K H} (hφ : φ ∈ R.rootLattice) :
    w • φ ∈ R.rootLattice := by
  induction w using R.weylGroup_induction hdiag with
  | one => simpa using hφ
  | mul_simple i w ih =>
    rw [mul_smul, simpleReflectionMem_smul]; exact R.simpleReflection_mem_rootLattice hdiag i ih

/-- The induced `ℤ`-linear automorphism action of `R.weylGroup hdiag` on `R.rootLattice`. -/
noncomputable def rootLatticeAut : R.weylGroup hdiag →* (R.rootLattice ≃ₗ[ℤ] R.rootLattice) :=
  (R.weylGroup hdiag).subtype.restrictSubmoduleAut R.rootLattice
    (fun w _ hφ ↦ by simpa [weylGroup_smul_def] using R.smul_mem_rootLattice hdiag w hφ)
@[simp] theorem coe_rootLatticeAut_apply (w : R.weylGroup hdiag) (α : R.rootLattice) :
    (R.rootLatticeAut hdiag w α : Dual K H) = w • (α : Dual K H) := by
  simp [rootLatticeAut, weylGroup_smul_def]
end IntegralRootLattice

namespace CoweightLattice
variable {I H : Type*} [AddCommGroup H] [Module ℚ H] {A : Matrix I I ℤ}
  {R : CartanRealization (A.map (Int.cast : ℤ → ℚ)) H}
  (L : R.CoweightLattice) (hdiag : ∀ i, A.map (Int.cast : ℤ → ℚ) i i = 2)

theorem corootReflection_mem_lattice (i : I) {y : H} (hy : y ∈ L.lattice) :
    R.corootReflection hdiag i y ∈ L.lattice := by
  have hpair : R.root i y = (L.pairing (L.root i) ⟨y, hy⟩ : ℚ) := by simp
  rw [corootReflection_apply, hpair, Int.cast_smul_eq_zsmul]
  exact sub_mem hy (Submodule.smul_mem _ _ (L.coroot_mem i))
theorem corootAut_mem_lattice (w : R.weylGroup hdiag) {y : H} (hy : y ∈ L.lattice) :
    R.corootAut hdiag w y ∈ L.lattice := by
  induction w using R.weylGroup_induction hdiag with
  | one => simpa using hy
  | mul_simple i w ih =>
    rw [map_mul, mul_apply_eq_comp, corootAut_simpleReflectionMem]
    exact L.corootReflection_mem_lattice hdiag i ih
theorem smul_mem_weightLattice (w : R.weylGroup hdiag) {φ : Dual ℚ H}
    (hφ : φ ∈ L.weightLattice) : w • φ ∈ L.weightLattice := by
  rw [L.mem_weightLattice_iff] at hφ ⊢
  exact fun y hy ↦ R.smul_dual_apply hdiag w φ y ▸ hφ _ (L.corootAut_mem_lattice hdiag w⁻¹ hy)

/-- The induced `ℤ`-linear automorphism action of `R.weylGroup hdiag` on the coweight lattice. -/
noncomputable def coweightAut : R.weylGroup hdiag →* (L.lattice ≃ₗ[ℤ] L.lattice) :=
  (R.corootAut hdiag).restrictSubmoduleAut L.lattice (L.corootAut_mem_lattice hdiag)
/-- The induced `ℤ`-linear automorphism action of `R.weylGroup hdiag` on the weight lattice. -/
noncomputable def weightAut : R.weylGroup hdiag →* (L.weightLattice ≃ₗ[ℤ] L.weightLattice) :=
  (R.weylGroup hdiag).subtype.restrictSubmoduleAut L.weightLattice
    (fun w _ hφ ↦ by simpa [weylGroup_smul_def] using L.smul_mem_weightLattice hdiag w hφ)
@[simp] theorem coe_coweightAut_apply (w : R.weylGroup hdiag) (y : L.lattice) :
    (L.coweightAut hdiag w y : H) = R.corootAut hdiag w y :=
  MonoidHom.coe_restrictSubmoduleAut_apply _ _ _ w y
@[simp] theorem coe_weightAut_apply (w : R.weylGroup hdiag) (φ : L.weightLattice) :
    (L.weightAut hdiag w φ : Dual ℚ H) = w • (φ : Dual ℚ H) := by
  simp [weightAut, weylGroup_smul_def]
@[simp] theorem pairing_weightAut_coweightAut (w : R.weylGroup hdiag) (φ : L.weightLattice)
    (y : L.lattice) :
    L.pairing (L.weightAut hdiag w φ) (L.coweightAut hdiag w y) = L.pairing φ y :=
  Int.cast_injective (α := ℚ) (by simp)
end CoweightLattice

end TauCeti.CartanRealization
