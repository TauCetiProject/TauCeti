/-!
# Simple reflections, the Weyl group, and lattice actions of a Cartan realization

Let `R` be a `TauCeti.CartanRealization A H` of a matrix `A` with `2` on the diagonal over an
arbitrary field `K`. Each node `i` defines two involutive linear automorphisms via
`Module.reflection`:

* the **simple reflection** `R.simpleReflection hdiag i : Dual K H ≃ₗ[K] Dual K H`, sending
  `φ ↦ φ - φ(hᵢ) • αᵢ`, so `sᵢ(αⱼ) = αⱼ - A i j • αᵢ`;
* the **dual reflection** `R.dualReflection hdiag i : H ≃ₗ[K] H`, sending `h ↦ h - αᵢ(h) • hᵢ`, so
  `sᵢ^∨(hⱼ) = hⱼ - A j i • hᵢ`.

The two reflections at `i` are adjoint for evaluation (`sᵢ(φ)(h) = φ(sᵢ^∨(h))`), preserve the
evaluation pairing (`sᵢ(φ)(sᵢ^∨(h)) = φ(h)`), and `sᵢ^∨` fixes `R.cartanCenter` pointwise while
stabilizing every subspace containing `R.corootSpan`.

The **Weyl group** `R.weylGroup hdiag` is the subgroup of `Dual K H ≃ₗ[K] Dual K H` generated by the
simple reflections, and `R.dualWeylGroup hdiag` is the subgroup of `H ≃ₗ[K] H` generated by the dual
reflections. Over any field `K` (without finite-dimensionality), the contragredient map
`e ↦ e.symm.dualMap` is injective and identifies the two subgroups (`R.dualWeylEquiv`), inducing an
action `R.dualAct` of `R.weylGroup` on `H` that preserves the evaluation pairing, fixes
`R.cartanCenter` pointwise, and makes `R.weylGroup` invariant under central enlargement /
restriction (`R.weylGroupRestrictEquiv`), compatibly with the root-lattice equivalence
`R.rootLatticeRestrictEquiv`.

For an integer-cast matrix `B.map Int.cast`, `R.weylGroup` stabilizes `R.rootLattice`
(`R.rootLatticeAct`), and for any rational coweight lattice `L : R.CoweightLattice` it stabilizes
both `L.lattice` (`L.coweightAct`) and `L.weightLattice` (`L.weightAct`) while preserving the
integral pairing `L.pairing`.

The Coxeter presentation, Kac's Lemma 3.11, and Kac's Proposition 3.13 over a characteristic-zero
field are proved in `TauCeti.LinearAlgebra.Matrix.Cartan.Realization.Coxeter`.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, §§1.1 and 3.7.
-/

public section

open Function Module Set
open scoped Matrix

namespace TauCeti.CartanRealization

/-! ### Simple reflections and dual reflections -/

section Reflections

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I K}
  (R : CartanRealization A H) (hdiag : ∀ i, A i i = 2)

/-- The `i`-th **simple reflection** on `Dual K H`, sending `φ ↦ φ - φ(hᵢ) • αᵢ`. -/
def simpleReflection (i : I) : Dual K H ≃ₗ[K] Dual K H :=
  Module.reflection (x := R.root i) (f := Dual.eval K H (R.coroot i))
    (by simp [hdiag i])

/-- The `i`-th **dual reflection** on `H`, sending `h ↦ h - αᵢ(h) • hᵢ`. -/
def dualReflection (i : I) : H ≃ₗ[K] H :=
  Module.reflection (x := R.coroot i) (f := R.root i) (by simp [hdiag i])

/-- `R.simpleReflection` expressed as `Module.reflection`. -/
theorem simpleReflection_eq_reflection (i : I) :
    R.simpleReflection hdiag i =
      Module.reflection (x := R.root i) (f := Dual.eval K H (R.coroot i)) (by simp [hdiag i]) :=
  (rfl)

/-- `R.dualReflection` expressed as `Module.reflection`. -/
theorem dualReflection_eq_reflection (i : I) :
    R.dualReflection hdiag i =
      Module.reflection (x := R.coroot i) (f := R.root i) (by simp [hdiag i]) :=
  (rfl)

theorem simpleReflection_apply (i : I) (φ : Dual K H) :
    R.simpleReflection hdiag i φ = φ - φ (R.coroot i) • R.root i :=
  Module.reflection_apply φ _

theorem dualReflection_apply (i : I) (h : H) :
    R.dualReflection hdiag i h = h - R.root i h • R.coroot i :=
  Module.reflection_apply h _

@[simp]
theorem simpleReflection_root_self (i : I) :
    R.simpleReflection hdiag i (R.root i) = -R.root i :=
  Module.reflection_apply_self _

@[simp]
theorem dualReflection_coroot_self (i : I) :
    R.dualReflection hdiag i (R.coroot i) = -R.coroot i :=
  Module.reflection_apply_self _

theorem simpleReflection_root (i j : I) :
    R.simpleReflection hdiag i (R.root j) = R.root j - A i j • R.root i := by
  simp [simpleReflection_apply]

theorem dualReflection_coroot (i j : I) :
    R.dualReflection hdiag i (R.coroot j) = R.coroot j - A j i • R.coroot i := by
  simp [dualReflection_apply]

@[simp]
theorem simpleReflection_simpleReflection (i : I) (φ : Dual K H) :
    R.simpleReflection hdiag i (R.simpleReflection hdiag i φ) = φ :=
  Module.involutive_reflection _ φ

@[simp]
theorem dualReflection_dualReflection (i : I) (h : H) :
    R.dualReflection hdiag i (R.dualReflection hdiag i h) = h :=
  Module.involutive_reflection _ h

@[simp]
theorem simpleReflection_mul_self (i : I) :
    R.simpleReflection hdiag i * R.simpleReflection hdiag i = 1 :=
  LinearEquiv.ext fun φ ↦ R.simpleReflection_simpleReflection hdiag i φ

@[simp]
theorem dualReflection_mul_self (i : I) :
    R.dualReflection hdiag i * R.dualReflection hdiag i = 1 :=
  LinearEquiv.ext fun h ↦ R.dualReflection_dualReflection hdiag i h

@[simp]
theorem simpleReflection_symm (i : I) :
    (R.simpleReflection hdiag i).symm = R.simpleReflection hdiag i :=
  Module.reflection_symm _

@[simp]
theorem dualReflection_symm (i : I) :
    (R.dualReflection hdiag i).symm = R.dualReflection hdiag i :=
  Module.reflection_symm _

@[simp]
theorem simpleReflection_inv (i : I) :
    (R.simpleReflection hdiag i)⁻¹ = R.simpleReflection hdiag i :=
  Module.reflection_inv _

@[simp]
theorem dualReflection_inv (i : I) :
    (R.dualReflection hdiag i)⁻¹ = R.dualReflection hdiag i :=
  Module.reflection_inv _

/-- Simple and dual reflections at `i` are adjoint for the evaluation pairing. -/
theorem simpleReflection_apply_eq_dualReflection (i : I) (φ : Dual K H) (h : H) :
    R.simpleReflection hdiag i φ h = φ (R.dualReflection hdiag i h) := by
  simp only [simpleReflection_apply, dualReflection_apply, LinearMap.sub_apply,
    LinearMap.smul_apply, map_sub, map_smul, smul_eq_mul]
  ring

@[simp]
theorem dualReflection_dualMap (i : I) :
    (R.dualReflection hdiag i).dualMap = R.simpleReflection hdiag i := by
  ext φ h
  exact (R.simpleReflection_apply_eq_dualReflection hdiag i φ h).symm

/-- Simple and dual reflections preserve the evaluation pairing: `sᵢ(φ)(sᵢ^∨(h)) = φ(h)`. -/
@[simp]
theorem simpleReflection_apply_dualReflection (i : I) (φ : Dual K H) (h : H) :
    R.simpleReflection hdiag i φ (R.dualReflection hdiag i h) = φ h := by
  rw [simpleReflection_apply_eq_dualReflection, dualReflection_dualReflection]

/-- Every dual reflection fixes the Cartan center pointwise. -/
theorem dualReflection_apply_of_mem_cartanCenter {h : H} (hh : h ∈ R.cartanCenter) (i : I) :
    R.dualReflection hdiag i h = h := by
  rw [dualReflection_apply, (R.mem_cartanCenter_iff h).mp hh i, zero_smul, sub_zero]

/-- Every dual reflection preserves any subspace containing the coroot span. -/
theorem dualReflection_mem_of_corootSpan_le {M : Submodule K H} (hc : R.corootSpan ≤ M)
    {m : H} (hm : m ∈ M) (i : I) : R.dualReflection hdiag i m ∈ M := by
  rw [dualReflection_apply]
  exact M.sub_mem hm (M.smul_mem _ (hc (R.coroot_mem_corootSpan i)))

/-- If `ω(hᵢ) = 1` and `2 • ω = αᵢ` (a fundamental weight in rank one), then `sᵢ(ω) = -ω`. -/
theorem simpleReflection_eq_neg_of_apply_coroot_eq_one {i : I} {ω : Dual K H}
    (hω : ω (R.coroot i) = 1) (h2ω : 2 • ω = R.root i) :
    R.simpleReflection hdiag i ω = -ω := by
  rw [simpleReflection_apply, hω, one_smul, ← h2ω, two_smul]
  abel

end Reflections

/-! ### The Weyl group, dual Weyl group, and contragredient equivalence -/

section WeylGroup

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I K}
  (R : CartanRealization A H) (hdiag : ∀ i, A i i = 2)

/-- The **Weyl group** of a Cartan realization, generated by `R.simpleReflection hdiag` inside
`Dual K H ≃ₗ[K] Dual K H`. -/
def weylGroup : Subgroup (Dual K H ≃ₗ[K] Dual K H) :=
  Subgroup.closure (range (R.simpleReflection hdiag))

/-- Definition of `CartanRealization.weylGroup` as the closure of the simple reflections. -/
theorem weylGroup_def :
    R.weylGroup hdiag = Subgroup.closure (range (R.simpleReflection hdiag)) :=
  (rfl)

/-- The **dual Weyl group**, generated by `R.dualReflection hdiag` inside `H ≃ₗ[K] H`. -/
def dualWeylGroup : Subgroup (H ≃ₗ[K] H) :=
  Subgroup.closure (range (R.dualReflection hdiag))

/-- Definition of `CartanRealization.dualWeylGroup` as the closure of the dual reflections. -/
theorem dualWeylGroup_def :
    R.dualWeylGroup hdiag = Subgroup.closure (range (R.dualReflection hdiag)) :=
  (rfl)

/-- Every simple reflection belongs to `R.weylGroup hdiag`. -/
@[simp]
theorem simpleReflection_mem_weylGroup (i : I) :
    R.simpleReflection hdiag i ∈ R.weylGroup hdiag :=
  Subgroup.subset_closure (mem_range_self i)

/-- Every dual reflection belongs to `R.dualWeylGroup hdiag`. -/
@[simp]
theorem dualReflection_mem_dualWeylGroup (i : I) :
    R.dualReflection hdiag i ∈ R.dualWeylGroup hdiag :=
  Subgroup.subset_closure (mem_range_self i)

/-- A subgroup contains `R.weylGroup hdiag` iff it contains every simple reflection. -/
@[simp]
theorem weylGroup_le_iff {S : Subgroup (Dual K H ≃ₗ[K] Dual K H)} :
    R.weylGroup hdiag ≤ S ↔ ∀ i, R.simpleReflection hdiag i ∈ S := by
  rw [weylGroup_def, Subgroup.closure_le, range_subset_iff]
  rfl

/-- A subgroup contains `R.dualWeylGroup hdiag` iff it contains every dual reflection. -/
@[simp]
theorem dualWeylGroup_le_iff {S : Subgroup (H ≃ₗ[K] H)} :
    R.dualWeylGroup hdiag ≤ S ↔ ∀ i, R.dualReflection hdiag i ∈ S := by
  rw [dualWeylGroup_def, Subgroup.closure_le, range_subset_iff]
  rfl

/-- The `i`-th simple reflection as an element of `R.weylGroup hdiag`. -/
def simpleReflectionMem (i : I) : R.weylGroup hdiag :=
  ⟨R.simpleReflection hdiag i, R.simpleReflection_mem_weylGroup hdiag i⟩

/-- The `i`-th dual reflection as an element of `R.dualWeylGroup hdiag`. -/
def dualReflectionMem (i : I) : R.dualWeylGroup hdiag :=
  ⟨R.dualReflection hdiag i, R.dualReflection_mem_dualWeylGroup hdiag i⟩

@[simp]
theorem coe_simpleReflectionMem (i : I) :
    (R.simpleReflectionMem hdiag i : Dual K H ≃ₗ[K] Dual K H) = R.simpleReflection hdiag i :=
  (rfl)

@[simp]
theorem coe_dualReflectionMem (i : I) :
    (R.dualReflectionMem hdiag i : H ≃ₗ[K] H) = R.dualReflection hdiag i :=
  (rfl)

@[simp]
theorem simpleReflectionMem_mul_self (i : I) :
    R.simpleReflectionMem hdiag i * R.simpleReflectionMem hdiag i = 1 :=
  Subtype.ext (R.simpleReflection_mul_self hdiag i)

@[simp]
theorem dualReflectionMem_mul_self (i : I) :
    R.dualReflectionMem hdiag i * R.dualReflectionMem hdiag i = 1 :=
  Subtype.ext (R.dualReflection_mul_self hdiag i)

@[simp]
theorem simpleReflectionMem_inv (i : I) :
    (R.simpleReflectionMem hdiag i)⁻¹ = R.simpleReflectionMem hdiag i :=
  Subtype.ext (R.simpleReflection_inv hdiag i)

@[simp]
theorem dualReflectionMem_inv (i : I) :
    (R.dualReflectionMem hdiag i)⁻¹ = R.dualReflectionMem hdiag i :=
  Subtype.ext (R.dualReflection_inv hdiag i)

/-- The simple reflections generate `R.weylGroup hdiag` as a group. -/
theorem closure_range_simpleReflectionMem :
    Subgroup.closure (range (R.simpleReflectionMem hdiag)) = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro ⟨w, hw⟩
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact Subgroup.subset_closure (mem_range_self i)
  | one => exact one_mem _
  | mul _ _ _ _ ih₁ ih₂ => exact mul_mem ih₁ ih₂
  | inv _ _ ih => exact inv_mem ih

/-- The dual reflections generate `R.dualWeylGroup hdiag` as a group. -/
theorem closure_range_dualReflectionMem :
    Subgroup.closure (range (R.dualReflectionMem hdiag)) = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro ⟨w, hw⟩
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact Subgroup.subset_closure (mem_range_self i)
  | one => exact one_mem _
  | mul _ _ _ _ ih₁ ih₂ => exact mul_mem ih₁ ih₂
  | inv _ _ ih => exact inv_mem ih

@[simp]
theorem weylGroup_eq_bot [IsEmpty I] : R.weylGroup hdiag = ⊥ := by
  simp [weylGroup]

@[simp]
theorem dualWeylGroup_eq_bot [IsEmpty I] : R.dualWeylGroup hdiag = ⊥ := by
  simp [dualWeylGroup]

/-- When the index type `I` is empty, the Weyl group is trivial. -/
instance [IsEmpty I] : Subsingleton (R.weylGroup hdiag) :=
  ⟨fun ⟨_, hw₁⟩ ⟨_, hw₂⟩ ↦ Subtype.ext <| by
    rw [R.weylGroup_eq_bot hdiag, Subgroup.mem_bot] at hw₁ hw₂
    exact hw₁.trans hw₂.symm⟩

private theorem symm_dualMap_mem_weylGroup {g : H ≃ₗ[K] H} (hg : g ∈ R.dualWeylGroup hdiag) :
    g.symm.dualMap ∈ R.weylGroup hdiag := by
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    simp
  | one =>
    have h1 : (1 : H ≃ₗ[K] H).symm.dualMap = 1 := by ext; rfl
    exact h1 ▸ one_mem _
  | mul g₁ g₂ _ _ ih₁ ih₂ =>
    have hmul : (g₁ * g₂).symm.dualMap = g₁.symm.dualMap * g₂.symm.dualMap := by ext; rfl
    exact hmul ▸ mul_mem ih₁ ih₂
  | inv g _ ih =>
    have hinv : g⁻¹.symm.dualMap = (g.symm.dualMap)⁻¹ := by ext; rfl
    exact hinv ▸ inv_mem ih

private def contragredientWeylHom : R.dualWeylGroup hdiag →* R.weylGroup hdiag where
  toFun g := ⟨g.1.symm.dualMap, R.symm_dualMap_mem_weylGroup hdiag g.2⟩
  map_one' := Subtype.ext (by ext; rfl)
  map_mul' _ _ := Subtype.ext (by ext; rfl)

/-- **Contragredient isomorphism between the Weyl group and the dual Weyl group**, sending each
simple reflection `sᵢ` to its dual reflection `sᵢ^∨` without any finite-dimensionality assumption on
`H`. -/
noncomputable def dualWeylEquiv : R.weylGroup hdiag ≃* R.dualWeylGroup hdiag :=
  (MulEquiv.ofBijective (R.contragredientWeylHom hdiag)
    ⟨(injective_iff_map_eq_one _).mpr fun g hg ↦ Subtype.ext <| LinearEquiv.ext fun x ↦ by
        rw [Subgroup.coe_one, one_apply_eq_self, ← sub_eq_zero]
        refine (Module.forall_dual_apply_eq_zero_iff K (g.1 x - x)).mp fun φ ↦ ?_
        have hφ : g.1.symm.dualMap φ (g.1 x) = φ (g.1 x) := by
          have := Subtype.ext_iff.mp hg
          dsimp only [contragredientWeylHom, MonoidHom.coe_mk, OneHom.coe_mk] at this
          rw [this, Subgroup.coe_one, one_apply_eq_self]
        have hsymm : φ x = φ (g.1 x) := by simpa using hφ
        rw [map_sub, hsymm, sub_self],
      MonoidHom.range_eq_top.mp <| eq_top_iff.mpr <| by
        rw [← R.closure_range_simpleReflectionMem hdiag, Subgroup.closure_le]
        rintro _ ⟨i, rfl⟩
        exact ⟨R.dualReflectionMem hdiag i,
          Subtype.ext (by simp [contragredientWeylHom])⟩⟩).symm

@[simp]
theorem dualWeylEquiv_symm_dualReflectionMem (i : I) :
    (R.dualWeylEquiv hdiag).symm (R.dualReflectionMem hdiag i) = R.simpleReflectionMem hdiag i :=
  Subtype.ext (by simp [dualWeylEquiv, contragredientWeylHom])

@[simp]
theorem dualWeylEquiv_simpleReflectionMem (i : I) :
    R.dualWeylEquiv hdiag (R.simpleReflectionMem hdiag i) = R.dualReflectionMem hdiag i := by
  rw [← R.dualWeylEquiv_symm_dualReflectionMem hdiag i, MulEquiv.apply_symm_apply]

/-- The contragredient action of `R.weylGroup hdiag` on `H` by linear automorphisms, sending
`sᵢ ↦ sᵢ^∨`. -/
noncomputable def dualAct : R.weylGroup hdiag →* (H ≃ₗ[K] H) :=
  (R.dualWeylGroup hdiag).subtype.comp (R.dualWeylEquiv hdiag).toMonoidHom

@[simp]
theorem dualAct_simpleReflectionMem (i : I) :
    R.dualAct hdiag (R.simpleReflectionMem hdiag i) = R.dualReflection hdiag i := by
  simp [dualAct]

/-- `CartanRealization.dualAct` is injective over any field `K`. -/
theorem dualAct_injective : Injective (R.dualAct hdiag) :=
  Subtype.val_injective.comp (R.dualWeylEquiv hdiag).injective

@[simp]
theorem dualAct_symm_dualMap (w : R.weylGroup hdiag) :
    (R.dualAct hdiag w).symm.dualMap = w.1 := by
  obtain ⟨g, rfl⟩ := (R.dualWeylEquiv hdiag).symm.surjective w
  have hg : R.dualAct hdiag ((R.dualWeylEquiv hdiag).symm g) = g.1 := by simp [dualAct]
  rw [hg]
  simp [dualWeylEquiv, contragredientWeylHom]

/-- Adjointness of the Weyl actions on `Dual K H` and `H`: `(w⁻¹ φ)(h) = φ(w h)`. -/
theorem inv_apply_eq_apply_dualAct (w : R.weylGroup hdiag) (φ : Dual K H) (h : H) :
    (w⁻¹.1 φ) h = φ (R.dualAct hdiag w h) := by
  have hsymm : (R.dualAct hdiag w⁻¹).symm = R.dualAct hdiag w := by
    rw [map_inv]
    rfl
  rw [← R.dualAct_symm_dualMap hdiag w⁻¹, hsymm, LinearEquiv.dualMap_apply]

/-- **Evaluation pairing invariance:** `(w φ)(w h) = φ(h)` for every `w ∈ R.weylGroup hdiag`. -/
@[simp]
theorem apply_dualAct (w : R.weylGroup hdiag) (φ : Dual K H) (h : H) :
    (w.1 φ) (R.dualAct hdiag w h) = φ h := by
  rw [← R.dualAct_symm_dualMap hdiag w, LinearEquiv.dualMap_apply, LinearEquiv.symm_apply_apply]

/-- Every element of `R.weylGroup hdiag` fixes `R.cartanCenter` pointwise on `H`. -/
theorem dualAct_apply_of_mem_cartanCenter (w : R.weylGroup hdiag) {h : H}
    (hh : h ∈ R.cartanCenter) : R.dualAct hdiag w h = h :=
  Subgroup.smul_mem_of_mem_closure_of_mem (t := {x | x = h})
    (by rintro _ ⟨i, rfl⟩; exact ⟨i, R.dualReflection_inv hdiag i⟩)
    (by rintro _ ⟨i, rfl⟩ _ rfl; exact R.dualReflection_apply_of_mem_cartanCenter hdiag hh i)
    (R.dualWeylEquiv hdiag w).2 rfl

/-- Every element of `R.weylGroup hdiag` preserves any subspace containing `R.corootSpan`. -/
theorem dualAct_mem_of_corootSpan_le {M : Submodule K H} (hc : R.corootSpan ≤ M)
    (w : R.weylGroup hdiag) {m : H} (hm : m ∈ M) : R.dualAct hdiag w m ∈ M :=
  Subgroup.smul_mem_of_mem_closure_of_mem (t := (M : Set H))
    (by rintro _ ⟨i, rfl⟩; exact ⟨i, R.dualReflection_inv hdiag i⟩)
    (by rintro _ ⟨i, rfl⟩ _ hm'; exact R.dualReflection_mem_of_corootSpan_le hdiag hc hm' i)
    (R.dualWeylEquiv hdiag w).2 hm

end WeylGroup

/-! ### Central enlargement / restriction invariance -/

section Restriction

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I K}
  (R : CartanRealization A H) (M : Submodule K H) (hc : R.corootSpan ≤ M)
  (hs : M ⊔ R.cartanCenter = ⊤) (hdiag : ∀ i, A i i = 2)

private noncomputable def dualActRestrictHom : R.weylGroup hdiag →* (M ≃ₗ[K] M) where
  toFun w :=
    { toFun m := ⟨R.dualAct hdiag w m, R.dualAct_mem_of_corootSpan_le hdiag hc w m.2⟩
      invFun m := ⟨R.dualAct hdiag w⁻¹ m, R.dualAct_mem_of_corootSpan_le hdiag hc w⁻¹ m.2⟩
      map_add' _ _ := Subtype.ext (map_add _ _ _)
      map_smul' _ _ := Subtype.ext (map_smul _ _ _)
      left_inv _ := Subtype.ext (by
        dsimp only
        rw [← mul_apply_eq_comp, ← map_mul, inv_mul_cancel, map_one, one_apply_eq_self])
      right_inv _ := Subtype.ext (by
        dsimp only
        rw [← mul_apply_eq_comp, ← map_mul, mul_inv_cancel, map_one, one_apply_eq_self]) }
  map_one' := by ext; simp
  map_mul' _ _ := by ext; simp [mul_apply_eq_comp]

@[simp]
private theorem coe_dualActRestrictHom_apply (w : R.weylGroup hdiag) (m : M) :
    (R.dualActRestrictHom M hc hdiag w m : H) = R.dualAct hdiag w m :=
  rfl

private theorem dualActRestrictHom_simpleReflectionMem (i : I) :
    R.dualActRestrictHom M hc hdiag (R.simpleReflectionMem hdiag i) =
      (R.restrict M hc hs).dualReflection hdiag i := by
  ext ⟨m, hm⟩
  simp [dualReflection_apply]

private theorem dualActRestrictHom_mem_dualWeylGroup (w : R.weylGroup hdiag) :
    R.dualActRestrictHom M hc hdiag w ∈ (R.restrict M hc hs).dualWeylGroup hdiag := by
  have htop : w ∈ (⊤ : Subgroup (R.weylGroup hdiag)) := Subgroup.mem_top w
  rw [← R.closure_range_simpleReflectionMem hdiag] at htop
  induction htop using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    rw [R.dualActRestrictHom_simpleReflectionMem M hc hs hdiag i]
    exact (R.restrict M hc hs).dualReflection_mem_dualWeylGroup hdiag i
  | one => exact map_one (R.dualActRestrictHom M hc hdiag) ▸ one_mem _
  | mul _ _ _ _ ih₁ ih₂ =>
    exact (map_mul (R.dualActRestrictHom M hc hdiag) _ _).symm ▸ mul_mem ih₁ ih₂
  | inv _ _ ih =>
    exact (map_inv (R.dualActRestrictHom M hc hdiag) _).symm ▸ inv_mem ih

include hs in
private theorem dualActRestrictHom_injective : Injective (R.dualActRestrictHom M hc hdiag) := by
  refine (injective_iff_map_eq_one _).mpr fun w hw ↦ R.dualAct_injective hdiag <|
    LinearEquiv.ext fun x ↦ ?_
  rw [map_one, one_apply_eq_self]
  have hx : x ∈ M ⊔ R.cartanCenter := hs ▸ Submodule.mem_top
  obtain ⟨m, hm, z, hz, rfl⟩ := Submodule.mem_sup.mp hx
  have hm_eq : R.dualAct hdiag w m = m := by
    have h := congrArg (fun e : M ≃ₗ[K] M ↦ (e ⟨m, hm⟩ : H)) hw
    simpa using h
  rw [map_add, hm_eq, R.dualAct_apply_of_mem_cartanCenter hdiag w hz]

private noncomputable def dualActRestrictSubgroupHom :
    R.weylGroup hdiag →* (R.restrict M hc hs).dualWeylGroup hdiag where
  toFun w := ⟨R.dualActRestrictHom M hc hdiag w,
    R.dualActRestrictHom_mem_dualWeylGroup M hc hs hdiag w⟩
  map_one' := Subtype.ext (map_one (R.dualActRestrictHom M hc hdiag))
  map_mul' w₁ w₂ := Subtype.ext (map_mul (R.dualActRestrictHom M hc hdiag) w₁ w₂)

@[simp]
private theorem coe_dualActRestrictSubgroupHom (w : R.weylGroup hdiag) :
    (R.dualActRestrictSubgroupHom M hc hs hdiag w : M ≃ₗ[K] M) =
      R.dualActRestrictHom M hc hdiag w :=
  rfl

private theorem dualActRestrictSubgroupHom_bijective :
    Bijective (R.dualActRestrictSubgroupHom M hc hs hdiag) :=
  ⟨(injective_iff_map_eq_one _).mpr fun w hw ↦
      (injective_iff_map_eq_one _).mp (R.dualActRestrictHom_injective M hc hs hdiag) w
        (Subtype.ext_iff.mp hw),
    MonoidHom.range_eq_top.mp <| eq_top_iff.mpr <| by
      rw [← (R.restrict M hc hs).closure_range_dualReflectionMem hdiag, Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩
      exact ⟨R.simpleReflectionMem hdiag i, Subtype.ext <|
        R.dualActRestrictHom_simpleReflectionMem M hc hs hdiag i⟩⟩

private noncomputable def dualActRestrictEquiv :
    R.weylGroup hdiag ≃* (R.restrict M hc hs).dualWeylGroup hdiag :=
  MulEquiv.ofBijective (R.dualActRestrictSubgroupHom M hc hs hdiag)
    (R.dualActRestrictSubgroupHom_bijective M hc hs hdiag)

@[simp]
private theorem coe_dualActRestrictEquiv (w : R.weylGroup hdiag) :
    (R.dualActRestrictEquiv M hc hs hdiag w : M ≃ₗ[K] M) =
      R.dualActRestrictHom M hc hdiag w := by
  simp [dualActRestrictEquiv]

private theorem coe_dualActRestrictEquiv_apply (w : R.weylGroup hdiag) (m : M) :
    ((R.dualActRestrictEquiv M hc hs hdiag w : M ≃ₗ[K] M) m : H) = R.dualAct hdiag w m := by
  rw [coe_dualActRestrictEquiv, coe_dualActRestrictHom_apply]

/-- **Enlargement / restriction invariance of the Weyl group.** Restricting a realization to a
subspace `M` containing `R.corootSpan` with `M ⊔ R.cartanCenter = ⊤` induces an isomorphism of Weyl
groups carrying simple reflections to simple reflections. -/
noncomputable def weylGroupRestrictEquiv :
    R.weylGroup hdiag ≃* (R.restrict M hc hs).weylGroup hdiag :=
  (R.dualActRestrictEquiv M hc hs hdiag).trans ((R.restrict M hc hs).dualWeylEquiv hdiag).symm

@[simp]
theorem weylGroupRestrictEquiv_simpleReflectionMem (i : I) :
    R.weylGroupRestrictEquiv M hc hs hdiag (R.simpleReflectionMem hdiag i) =
      (R.restrict M hc hs).simpleReflectionMem hdiag i := by
  have h : R.dualActRestrictEquiv M hc hs hdiag (R.simpleReflectionMem hdiag i) =
      (R.restrict M hc hs).dualReflectionMem hdiag i := by
    apply Subtype.ext
    rw [coe_dualActRestrictEquiv, dualActRestrictHom_simpleReflectionMem, coe_dualReflectionMem]
  simp [weylGroupRestrictEquiv, h]

@[simp]
theorem coe_dualAct_weylGroupRestrictEquiv (w : R.weylGroup hdiag) (m : M) :
    (((R.restrict M hc hs).dualAct hdiag (R.weylGroupRestrictEquiv M hc hs hdiag w) m) : H) =
      R.dualAct hdiag w m := by
  have h : ((R.restrict M hc hs).dualWeylEquiv hdiag (R.weylGroupRestrictEquiv M hc hs hdiag w)) =
      R.dualActRestrictEquiv M hc hs hdiag w := by
    simp [weylGroupRestrictEquiv]
  rw [dualAct, MonoidHom.comp_apply, Subgroup.coe_subtype, MulEquiv.coe_toMonoidHom, h,
    coe_dualActRestrictEquiv_apply]

/-- Every functional in `R.rootLattice` vanishes on `R.cartanCenter`. -/
theorem apply_eq_zero_of_mem_rootLattice_of_mem_cartanCenter {φ : Dual K H}
    (hφ : φ ∈ R.rootLattice) {z : H} (hz : z ∈ R.cartanCenter) : φ z = 0 := by
  rw [R.rootLattice_def] at hφ
  induction hφ using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact (R.mem_cartanCenter_iff z).mp hz i
  | zero => simp
  | add _ _ _ _ ih₁ ih₂ => simp [ih₁, ih₂]
  | smul c _ _ ih => simp [ih]

/-- **Enlargement / restriction invariance of the root lattice.** Restriction along `M.subtype`
identifies `R.rootLattice` with `(R.restrict M hc hs).rootLattice` as `ℤ`-modules. -/
noncomputable def rootLatticeRestrictEquiv :
    R.rootLattice ≃ₗ[ℤ] (R.restrict M hc hs).rootLattice :=
  LinearEquiv.ofBijective
    (((M.subtype.dualMap.restrictScalars ℤ).comp R.rootLattice.subtype).codRestrict
      (R.restrict M hc hs).rootLattice fun ⟨φ, hφ⟩ ↦ by
        dsimp only [LinearMap.coe_comp, LinearMap.coe_restrictScalars, Submodule.coe_subtype,
          Function.comp_apply]
        rw [R.rootLattice_def] at hφ
        induction hφ using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨i, rfl⟩ := hx
          convert (R.restrict M hc hs).root_mem_rootLattice i using 1
          ext m
          exact (R.restrict_root_apply M hc hs i m).symm
        | zero => rw [map_zero]; exact zero_mem _
        | add _ _ _ _ ih₁ ih₂ => rw [map_add]; exact add_mem ih₁ ih₂
        | smul c _ _ ih => rw [map_zsmul]; exact Submodule.smul_mem _ c ih)
    ⟨(injective_iff_map_eq_zero _).mpr fun φ hφ ↦ Subtype.ext <| LinearMap.ext fun x ↦ by
        rw [Submodule.coe_zero, LinearMap.zero_apply]
        obtain ⟨m, hm, z, hz, rfl⟩ := Submodule.mem_sup.mp (hs ▸ Submodule.mem_top : x ∈ _)
        have hm0 : φ.1 m = 0 := by
          simpa using congrArg (fun f : Dual K M ↦ f ⟨m, hm⟩) (Subtype.ext_iff.mp hφ)
        rw [map_add, hm0, R.apply_eq_zero_of_mem_rootLattice_of_mem_cartanCenter φ.2 hz, add_zero],
      fun ⟨ψ, hψ⟩ ↦ by
        suffices ∃ φ : R.rootLattice, M.subtype.dualMap φ.1 = ψ by
          obtain ⟨φ, hφ⟩ := this
          exact ⟨φ, Subtype.ext hφ⟩
        rw [(R.restrict M hc hs).rootLattice_def] at hψ
        induction hψ using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨i, rfl⟩ := hx
          exact ⟨⟨R.root i, R.root_mem_rootLattice i⟩,
            LinearMap.ext fun m ↦ (R.restrict_root_apply M hc hs i m).symm⟩
        | zero => exact ⟨0, map_zero _⟩
        | add _ _ _ _ ih₁ ih₂ =>
          obtain ⟨φ₁, h₁⟩ := ih₁
          obtain ⟨φ₂, h₂⟩ := ih₂
          exact ⟨φ₁ + φ₂, by simp [h₁, h₂]⟩
        | smul c _ _ ih =>
          obtain ⟨φ, h⟩ := ih
          exact ⟨c • φ, by simp [h]⟩⟩

@[simp]
theorem coe_rootLatticeRestrictEquiv_apply (φ : R.rootLattice) (m : M) :
    (R.rootLatticeRestrictEquiv M hc hs φ : Dual K M) m = (φ : Dual K H) m :=
  (rfl)

@[simp]
theorem rootLatticeRestrictEquiv_root (i : I) :
    R.rootLatticeRestrictEquiv M hc hs ⟨R.root i, R.root_mem_rootLattice i⟩ =
      ⟨(R.restrict M hc hs).root i, (R.restrict M hc hs).root_mem_rootLattice i⟩ :=
  Subtype.ext <| LinearMap.ext fun m ↦ (R.restrict_root_apply M hc hs i m).symm

/-- Restriction intertwines the Weyl actions on `Dual K H` and `Dual K M` along `M.subtype`. -/
theorem restrict_weylGroup_apply (w : R.weylGroup hdiag) (φ : Dual K H) (m : M) :
    ((R.weylGroupRestrictEquiv M hc hs hdiag w).1 (M.subtype.dualMap φ)) m =
      (w.1 φ) m := by
  have hinv := (R.restrict M hc hs).inv_apply_eq_apply_dualAct hdiag
    (R.weylGroupRestrictEquiv M hc hs hdiag w)⁻¹ (M.subtype.dualMap φ) m
  rw [inv_inv, ← map_inv] at hinv
  rw [hinv, LinearMap.dualMap_apply, Submodule.coe_subtype, R.coe_dualAct_weylGroupRestrictEquiv,
    ← R.inv_apply_eq_apply_dualAct, inv_inv]

end Restriction

/-! ### Stability of the root, coweight, and weight lattices -/

section RootLatticeStability

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {B : Matrix I I ℤ}
  (R : CartanRealization (B.map (Int.cast : ℤ → K)) H)
  (hdiag : ∀ i, B.map (Int.cast : ℤ → K) i i = 2)

/-- Integral action of `R.simpleReflection` on simple roots: `sᵢ(αⱼ) = αⱼ - B i j • αᵢ`. -/
theorem simpleReflection_root_intCast (i j : I) :
    R.simpleReflection hdiag i (R.root j) = R.root j - B i j • R.root i := by
  rw [R.simpleReflection_root]
  exact congrArg (R.root j - ·) (Int.cast_smul_eq_zsmul K (B i j) (R.root i))

/-- Integral action of `R.dualReflection` on simple coroots: `sᵢ^∨(hⱼ) = hⱼ - B j i • hᵢ`. -/
theorem dualReflection_coroot_intCast (i j : I) :
    R.dualReflection hdiag i (R.coroot j) = R.coroot j - B j i • R.coroot i := by
  rw [R.dualReflection_coroot]
  exact congrArg (R.coroot j - ·) (Int.cast_smul_eq_zsmul K (B j i) (R.coroot i))

/-- Every simple reflection preserves `R.rootLattice`. -/
theorem simpleReflection_mem_rootLattice (i : I) {φ : Dual K H} (hφ : φ ∈ R.rootLattice) :
    R.simpleReflection hdiag i φ ∈ R.rootLattice := by
  rw [R.rootLattice_def] at hφ
  induction hφ using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    rw [R.simpleReflection_root_intCast]
    exact R.rootLattice.sub_mem (R.root_mem_rootLattice j)
      (R.rootLattice.smul_mem (B i j) (R.root_mem_rootLattice i))
  | zero => simp
  | add _ _ _ _ ih₁ ih₂ => rw [map_add]; exact add_mem ih₁ ih₂
  | smul c _ _ ih => rw [map_zsmul]; exact R.rootLattice.smul_mem c ih

/-- Every element of `R.weylGroup hdiag` preserves `R.rootLattice`. -/
theorem weylGroup_apply_mem_rootLattice (w : R.weylGroup hdiag) {φ : Dual K H}
    (hφ : φ ∈ R.rootLattice) : w.1 φ ∈ R.rootLattice :=
  Subgroup.smul_mem_of_mem_closure_of_mem (t := (R.rootLattice : Set (Dual K H)))
    (by rintro _ ⟨i, rfl⟩; exact ⟨i, R.simpleReflection_inv hdiag i⟩)
    (by rintro _ ⟨i, rfl⟩ _ hφ'; exact R.simpleReflection_mem_rootLattice hdiag i hφ')
    w.2 hφ

/-- The integral action of `R.weylGroup hdiag` on `R.rootLattice`. -/
noncomputable def rootLatticeAct : R.weylGroup hdiag →* (R.rootLattice ≃ₗ[ℤ] R.rootLattice) where
  toFun w :=
    { toFun φ := ⟨w.1 φ, R.weylGroup_apply_mem_rootLattice hdiag w φ.2⟩
      invFun φ := ⟨w⁻¹.1 φ, R.weylGroup_apply_mem_rootLattice hdiag w⁻¹ φ.2⟩
      map_add' _ _ := Subtype.ext (map_add _ _ _)
      map_smul' _ _ := Subtype.ext (map_zsmul _ _ _)
      left_inv _ := Subtype.ext (by
        dsimp only
        rw [← mul_apply_eq_comp, ← Subgroup.coe_mul, inv_mul_cancel, Subgroup.coe_one,
          one_apply_eq_self])
      right_inv _ := Subtype.ext (by
        dsimp only
        rw [← mul_apply_eq_comp, ← Subgroup.coe_mul, mul_inv_cancel, Subgroup.coe_one,
          one_apply_eq_self]) }
  map_one' := by ext; simp
  map_mul' _ _ := by ext; simp [mul_apply_eq_comp]

@[simp]
theorem coe_rootLatticeAct_apply (w : R.weylGroup hdiag) (φ : R.rootLattice) :
    (R.rootLatticeAct hdiag w φ : Dual K H) = w.1 φ :=
  (rfl)

end RootLatticeStability

namespace CoweightLattice

variable {I H : Type*} [AddCommGroup H] [Module ℚ H] {B : Matrix I I ℤ}
  {R : CartanRealization (B.map (Int.cast : ℤ → ℚ)) H} (L : R.CoweightLattice)
  (hdiag : ∀ i, B.map (Int.cast : ℤ → ℚ) i i = 2)

/-- Every dual reflection preserves the coweight lattice `L.lattice`. -/
theorem dualReflection_mem_lattice (i : I) {y : H} (hy : y ∈ L.lattice) :
    R.dualReflection hdiag i y ∈ L.lattice := by
  have hcast : (L.pairing (L.root i) ⟨y, hy⟩ : ℚ) = R.root i y := by simp
  rw [R.dualReflection_apply, ← hcast, Int.cast_smul_eq_zsmul ℚ]
  exact L.lattice.sub_mem hy (L.lattice.smul_mem _ (L.coroot_mem i))

/-- Every element of `R.weylGroup hdiag` preserves the coweight lattice `L.lattice` under
`R.dualAct`. -/
theorem dualAct_mem_lattice (w : R.weylGroup hdiag) {y : H} (hy : y ∈ L.lattice) :
    R.dualAct hdiag w y ∈ L.lattice :=
  Subgroup.smul_mem_of_mem_closure_of_mem (t := (L.lattice : Set H))
    (by rintro _ ⟨i, rfl⟩; exact ⟨i, R.dualReflection_inv hdiag i⟩)
    (by rintro _ ⟨i, rfl⟩ _ hy'; exact L.dualReflection_mem_lattice hdiag i hy')
    (R.dualWeylEquiv hdiag w).2 hy

/-- The integral action of `R.weylGroup hdiag` on the coweight lattice `L.lattice`. -/
noncomputable def coweightAct : R.weylGroup hdiag →* (L.lattice ≃ₗ[ℤ] L.lattice) where
  toFun w :=
    { toFun y := ⟨R.dualAct hdiag w y, L.dualAct_mem_lattice hdiag w y.2⟩
      invFun y := ⟨R.dualAct hdiag w⁻¹ y, L.dualAct_mem_lattice hdiag w⁻¹ y.2⟩
      map_add' _ _ := Subtype.ext (map_add _ _ _)
      map_smul' _ _ := Subtype.ext (map_zsmul _ _ _)
      left_inv _ := Subtype.ext (by
        dsimp only
        rw [← mul_apply_eq_comp, ← map_mul, inv_mul_cancel, map_one, one_apply_eq_self])
      right_inv _ := Subtype.ext (by
        dsimp only
        rw [← mul_apply_eq_comp, ← map_mul, mul_inv_cancel, map_one, one_apply_eq_self]) }
  map_one' := by ext; simp
  map_mul' _ _ := by ext; simp [mul_apply_eq_comp]

@[simp]
theorem coe_coweightAct_apply (w : R.weylGroup hdiag) (y : L.lattice) :
    (L.coweightAct hdiag w y : H) = R.dualAct hdiag w y :=
  (rfl)

/-- Every element of `R.weylGroup hdiag` preserves the weight lattice `L.weightLattice`. -/
theorem weylGroup_apply_mem_weightLattice (w : R.weylGroup hdiag) {φ : Dual ℚ H}
    (hφ : φ ∈ L.weightLattice) : w.1 φ ∈ L.weightLattice := by
  rw [L.mem_weightLattice_iff] at hφ ⊢
  intro y hy
  have hinv := R.inv_apply_eq_apply_dualAct hdiag w⁻¹ φ y
  rw [inv_inv] at hinv
  rw [hinv]
  exact hφ _ (L.dualAct_mem_lattice hdiag w⁻¹ hy)

/-- Every simple reflection preserves the weight lattice `L.weightLattice`. -/
theorem simpleReflection_mem_weightLattice (i : I) {φ : Dual ℚ H} (hφ : φ ∈ L.weightLattice) :
    R.simpleReflection hdiag i φ ∈ L.weightLattice :=
  L.weylGroup_apply_mem_weightLattice hdiag (R.simpleReflectionMem hdiag i) hφ

/-- The integral action of `R.weylGroup hdiag` on the weight lattice `L.weightLattice`. -/
noncomputable def weightAct : R.weylGroup hdiag →* (L.weightLattice ≃ₗ[ℤ] L.weightLattice) where
  toFun w :=
    { toFun φ := ⟨w.1 φ, L.weylGroup_apply_mem_weightLattice hdiag w φ.2⟩
      invFun φ := ⟨w⁻¹.1 φ, L.weylGroup_apply_mem_weightLattice hdiag w⁻¹ φ.2⟩
      map_add' _ _ := Subtype.ext (map_add _ _ _)
      map_smul' _ _ := Subtype.ext (map_zsmul _ _ _)
      left_inv _ := Subtype.ext (by
        dsimp only
        rw [← mul_apply_eq_comp, ← Subgroup.coe_mul, inv_mul_cancel, Subgroup.coe_one,
          one_apply_eq_self])
      right_inv _ := Subtype.ext (by
        dsimp only
        rw [← mul_apply_eq_comp, ← Subgroup.coe_mul, mul_inv_cancel, Subgroup.coe_one,
          one_apply_eq_self]) }
  map_one' := by ext; simp
  map_mul' _ _ := by ext; simp [mul_apply_eq_comp]

@[simp]
theorem coe_weightAct_apply (w : R.weylGroup hdiag) (φ : L.weightLattice) :
    (L.weightAct hdiag w φ : Dual ℚ H) = w.1 φ :=
  (rfl)

/-- The Weyl actions on `L.weightLattice` and `L.lattice` preserve the integral pairing. -/
@[simp]
theorem pairing_weightAct_coweightAct (w : R.weylGroup hdiag) (φ : L.weightLattice)
    (y : L.lattice) :
    L.pairing (L.weightAct hdiag w φ) (L.coweightAct hdiag w y) = L.pairing φ y := by
  apply Int.cast_injective (α := ℚ)
  simp

end CoweightLattice

end TauCeti.CartanRealization

