/-!
# The Weyl group of a Cartan realization and its Coxeter presentation

For a realization `R : TauCeti.CartanRealization A H` over a field `K` with `hA : ∀ i, A i i = 2`,
the **Weyl group** `R.weylGroup hA` and **coroot Weyl group** `R.corootWeylGroup hA` are generated
by the simple reflections and coreflections, identified via contragredient duality (`corootEquiv`)
so that `(w • φ) (R.corootEquiv hA w • h) = φ h`, fixing `R.cartanCenter`, and inducing `ℤ`-linear
actions on `Q`, `Y`, and `P`.

When `A : Matrix I I ℤ` is a generalized Cartan matrix (`hA : A.IsGeneralizedCartan`), the simple
reflections satisfy the Coxeter relations of `hA.coxeterMatrix` (`weylCoxeterHom`). In
characteristic zero, rank-two dihedral positivity on `R.posRootCone` and parabolic induction yield
**Kac, Lemma 3.11** (`length_mul_weylSimple_lt_iff`), **Kac, Proposition 3.13** (`weylGroupEquiv`,
`weylCoxeterSystem`), faithfulness on `Q` (`rootLatticeAction_injective`), and enlargement
invariance (`restrictWeylGroupEquiv`).

## References

* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press, 1990, §5.4.
* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, Cambridge University Press, 1990,
  §3.7–§3.13 (Lemma 3.11 and Proposition 3.13).
* S. Kumar, *Kac-Moody Groups, their Flag Varieties and Representation Theory*, Progress in
  Mathematics 204, Birkhäuser, 2002, §1.3.
-/

public section

open Module Polynomial.Chebyshev

namespace TauCeti.CartanRealization

/-! ### The Weyl group, the coroot Weyl group, and word length over an arbitrary field -/

section Field

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I K}
  (R : CartanRealization A H) (hA : ∀ i, A i i = 2)

/-- The **Weyl group** of a Cartan realization: the subgroup of `Dual K H ≃ₗ[K] Dual K H`
generated by the simple reflections. -/
noncomputable def weylGroup : Subgroup (Dual K H ≃ₗ[K] Dual K H) :=
  Subgroup.closure (Set.range (R.simpleReflection hA))

theorem weylGroup_def : R.weylGroup hA = Subgroup.closure (Set.range (R.simpleReflection hA)) :=
  (rfl)

theorem simpleReflection_mem_weylGroup (i : I) : R.simpleReflection hA i ∈ R.weylGroup hA :=
  Subgroup.subset_closure (Set.mem_range_self i)

/-- The `i`-th simple reflection as an element of the Weyl group. -/
noncomputable def weylSimple (i : I) : R.weylGroup hA :=
  ⟨R.simpleReflection hA i, R.simpleReflection_mem_weylGroup hA i⟩

@[simp] theorem coe_weylSimple (i : I) :
    (R.weylSimple hA i : Dual K H ≃ₗ[K] Dual K H) = R.simpleReflection hA i := (rfl)

@[simp] theorem weylSimple_smul (i : I) (φ : Dual K H) :
    R.weylSimple hA i • φ = R.simpleReflection hA i φ := (rfl)

@[simp] theorem weylSimple_mul_self (i : I) : R.weylSimple hA i * R.weylSimple hA i = 1 :=
  Subtype.ext (R.simpleReflection_mul_self hA i)

@[simp] theorem weylSimple_sq (i : I) : R.weylSimple hA i ^ 2 = 1 := by
  rw [sq, weylSimple_mul_self]

@[simp] theorem weylSimple_inv (i : I) : (R.weylSimple hA i)⁻¹ = R.weylSimple hA i :=
  Subtype.ext (R.simpleReflection_inv hA i)

/-- Every element of `R.weylGroup hA` is a product of a list of simple reflections. -/
theorem exists_list_prod_eq_weylGroup (w : R.weylGroup hA) :
    ∃ l : List I, (l.map (R.weylSimple hA)).prod = w := by
  obtain ⟨e, he⟩ := w
  induction he using Subgroup.closure_induction with
  | mem _ hx => obtain ⟨i, rfl⟩ := hx; exact ⟨[i], Subtype.ext List.prod_singleton⟩
  | one => exact ⟨[], rfl⟩
  | mul _ _ _ _ ihx ihy =>
    obtain ⟨l₁, hl₁⟩ := ihx
    obtain ⟨l₂, hl₂⟩ := ihy
    exact ⟨l₁ ++ l₂, by rw [List.map_append, List.prod_append, hl₁, hl₂]; rfl⟩
  | inv _ _ ih =>
    obtain ⟨l, hl⟩ := ih
    refine ⟨l.reverse, ?_⟩
    have hinv : (l.map (R.weylSimple hA)).reverse.prod = (l.map (R.weylSimple hA)).prod⁻¹ := by
      rw [List.prod_inv_reverse, List.map_map]
      congr 2
      exact List.map_congr_left fun i _ ↦ (R.weylSimple_inv hA i).symm
    rw [List.map_reverse, hinv, hl]
    rfl

/-- Induction principle for `R.weylGroup hA` along `1`, simple reflections, and multiplication. -/
@[elab_as_elim]
theorem weylGroup_induction {motive : R.weylGroup hA → Prop} (one : motive 1)
    (simple : ∀ i, motive (R.weylSimple hA i))
    (mul : ∀ u v, motive u → motive v → motive (u * v)) (w : R.weylGroup hA) : motive w := by
  obtain ⟨l, rfl⟩ := R.exists_list_prod_eq_weylGroup hA w
  induction l with
  | nil => exact one
  | cons i l ih => exact mul _ _ (simple i) ih

/-- On an empty index set, the Weyl group is trivial. -/
instance [IsEmpty I] : Subsingleton (R.weylGroup hA) where
  allEq w₁ w₂ := by
    obtain ⟨l₁, rfl⟩ := R.exists_list_prod_eq_weylGroup hA w₁
    obtain ⟨l₂, rfl⟩ := R.exists_list_prod_eq_weylGroup hA w₂
    simp [List.eq_nil_iff_forall_not_mem.mpr fun i _ ↦ isEmptyElim i]

/-- On an empty index set, `1` is the unique element of the Weyl group. -/
noncomputable instance [IsEmpty I] : Unique (R.weylGroup hA) := uniqueOfSubsingleton 1

/-- The **word length** of an element `w` of the Weyl group: the least length of a list of indices
whose simple reflections multiply to `w`. -/
noncomputable def length (w : R.weylGroup hA) : ℕ :=
  sInf {n : ℕ | ∃ l : List I, l.length = n ∧ (l.map (R.weylSimple hA)).prod = w}

theorem length_def (w : R.weylGroup hA) :
    R.length hA w =
      sInf {n : ℕ | ∃ l : List I, l.length = n ∧ (l.map (R.weylSimple hA)).prod = w} := (rfl)

theorem isLeast_length (w : R.weylGroup hA) :
    IsLeast {n : ℕ | ∃ l : List I, l.length = n ∧ (l.map (R.weylSimple hA)).prod = w}
      (R.length hA w) := by
  obtain ⟨l, hl⟩ := R.exists_list_prod_eq_weylGroup hA w
  exact ⟨Nat.sInf_mem ⟨l.length, l, rfl, hl⟩, fun _ ↦ Nat.sInf_le⟩

theorem exists_list_prod_eq_and_length_eq (w : R.weylGroup hA) :
    ∃ l : List I, (l.map (R.weylSimple hA)).prod = w ∧ l.length = R.length hA w := by
  obtain ⟨⟨l, hlen, hprod⟩, -⟩ := R.isLeast_length hA w
  exact ⟨l, hprod, hlen⟩

theorem length_prod_map_le (l : List I) : R.length hA (l.map (R.weylSimple hA)).prod ≤ l.length :=
  (R.isLeast_length hA _).2 ⟨l, rfl, rfl⟩

@[simp] theorem length_one : R.length hA 1 = 0 :=
  Nat.eq_zero_of_le_zero (R.length_prod_map_le hA [])

@[simp] theorem length_eq_zero_iff {w : R.weylGroup hA} : R.length hA w = 0 ↔ w = 1 := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ R.length_one hA⟩
  obtain ⟨l, rfl, hlen⟩ := R.exists_list_prod_eq_and_length_eq hA w
  rw [List.length_eq_zero_iff.mp (hlen.trans h)]
  rfl

theorem length_mul_le (w₁ w₂ : R.weylGroup hA) :
    R.length hA (w₁ * w₂) ≤ R.length hA w₁ + R.length hA w₂ := by
  obtain ⟨l₁, rfl, h₁⟩ := R.exists_list_prod_eq_and_length_eq hA w₁
  obtain ⟨l₂, rfl, h₂⟩ := R.exists_list_prod_eq_and_length_eq hA w₂
  rw [← h₁, ← h₂, ← List.prod_append, ← List.map_append, ← List.length_append]
  exact R.length_prod_map_le hA (l₁ ++ l₂)

@[simp] theorem length_inv (w : R.weylGroup hA) : R.length hA w⁻¹ = R.length hA w := by
  suffices ∀ u : R.weylGroup hA, R.length hA u⁻¹ ≤ R.length hA u from
    le_antisymm (this w) (inv_inv w ▸ this w⁻¹)
  intro u
  obtain ⟨l, rfl, hlen⟩ := R.exists_list_prod_eq_and_length_eq hA u
  have hrev : (l.reverse.map (R.weylSimple hA)).prod = (l.map (R.weylSimple hA)).prod⁻¹ := by
    rw [List.map_reverse, List.prod_inv_reverse, List.map_map]
    congr 2
    exact List.map_congr_left fun i _ ↦ (R.weylSimple_inv hA i).symm
  rw [← hlen, ← hrev, ← List.length_reverse]
  exact R.length_prod_map_le hA l.reverse

/-! ### The coroot Weyl group and contragredient duality -/

/-- The **coroot Weyl group**: the subgroup of `H ≃ₗ[K] H` generated by the simple coreflections.
-/
noncomputable def corootWeylGroup : Subgroup (H ≃ₗ[K] H) :=
  Subgroup.closure (Set.range (R.simpleCoreflection hA))

theorem corootWeylGroup_def :
    R.corootWeylGroup hA = Subgroup.closure (Set.range (R.simpleCoreflection hA)) := (rfl)

theorem simpleCoreflection_mem_corootWeylGroup (i : I) :
    R.simpleCoreflection hA i ∈ R.corootWeylGroup hA :=
  Subgroup.subset_closure (Set.mem_range_self i)

/-- The `i`-th simple coreflection as an element of `R.corootWeylGroup hA`. -/
noncomputable def corootWeylSimple (i : I) : R.corootWeylGroup hA :=
  ⟨R.simpleCoreflection hA i, R.simpleCoreflection_mem_corootWeylGroup hA i⟩

@[simp] theorem coe_corootWeylSimple (i : I) :
    (R.corootWeylSimple hA i : H ≃ₗ[K] H) = R.simpleCoreflection hA i := (rfl)

@[simp] theorem corootWeylSimple_smul (i : I) (h : H) :
    R.corootWeylSimple hA i • h = R.simpleCoreflection hA i h := (rfl)

private def contragredientHom : (H ≃ₗ[K] H) →* (Dual K H ≃ₗ[K] Dual K H) where
  toFun e := e.symm.dualMap
  map_one' := by ext; rfl
  map_mul' _ _ := by ext; rfl

private theorem contragredientHom_injective :
    Function.Injective (contragredientHom (K := K) (H := H)) := fun _ _ h ↦
  LinearEquiv.symm_bijective.injective <| LinearEquiv.toLinearMap_injective <| by
    ext x
    rw [← sub_eq_zero, ← Module.forall_dual_apply_eq_zero_iff K]
    intro φ
    simpa [contragredientHom, sub_eq_zero] using LinearMap.congr_fun (LinearEquiv.congr_fun h φ) x

/-- Contragredient duality identifies `R.weylGroup hA` with `R.corootWeylGroup hA`, matching each
simple reflection with the corresponding simple coreflection. -/
noncomputable def corootEquiv : R.weylGroup hA ≃* R.corootWeylGroup hA :=
  (((R.corootWeylGroup hA).equivMapOfInjective contragredientHom contragredientHom_injective).trans
    (MulEquiv.subgroupCongr <| by
      rw [corootWeylGroup, weylGroup, MonoidHom.map_closure, ← Set.range_comp]
      congr 1
      ext i
      simp [contragredientHom, simpleReflection_eq_dualMap])).symm

@[simp] theorem coe_corootEquiv_symm (u : R.corootWeylGroup hA) :
    (((R.corootEquiv hA).symm u : R.weylGroup hA) : Dual K H ≃ₗ[K] Dual K H) =
      (u : H ≃ₗ[K] H).symm.dualMap := (rfl)

@[simp] theorem corootEquiv_symm_corootWeylSimple (i : I) :
    (R.corootEquiv hA).symm (R.corootWeylSimple hA i) = R.weylSimple hA i := by
  apply Subtype.ext
  rw [R.coe_corootEquiv_symm hA, coe_corootWeylSimple, R.simpleCoreflection_symm hA i,
    coe_weylSimple, R.simpleReflection_eq_dualMap hA i]

@[simp] theorem corootEquiv_weylSimple (i : I) :
    R.corootEquiv hA (R.weylSimple hA i) = R.corootWeylSimple hA i := by
  rw [← R.corootEquiv_symm_corootWeylSimple hA i, MulEquiv.apply_symm_apply]

theorem weylGroup_smul_apply (w : R.weylGroup hA) (φ : Dual K H) (h : H) :
    (w • φ) h = φ ((R.corootEquiv hA w)⁻¹ • h) := by
  have hw := R.coe_corootEquiv_symm hA (R.corootEquiv hA w)
  rw [MulEquiv.symm_apply_apply] at hw
  simp only [Subgroup.smul_def, LinearEquiv.smul_def, hw, LinearEquiv.dualMap_apply,
    Subgroup.coe_inv, LinearEquiv.coe_inv]

/-- **Weyl invariance of the evaluation pairing**: `(w • φ) (R.corootEquiv hA w • h) = φ h`. -/
@[simp] theorem weylGroup_smul_apply_corootEquiv_smul (w : R.weylGroup hA) (φ : Dual K H) (h : H) :
    (w • φ) (R.corootEquiv hA w • h) = φ h := by rw [weylGroup_smul_apply, inv_smul_smul]

theorem corootEquiv_smul_eq_self_of_mem_cartanCenter (w : R.weylGroup hA) {h : H}
    (hh : h ∈ R.cartanCenter) : R.corootEquiv hA w • h = h := by
  induction w using R.weylGroup_induction with
  | one => simp
  | simple i => simpa using R.simpleCoreflection_eq_self_of_mem_cartanCenter hA i hh
  | mul _ _ ihu ihv => rw [map_mul, mul_smul, ihv, ihu]

theorem weylGroup_smul_apply_of_mem_cartanCenter (w : R.weylGroup hA) (φ : Dual K H) {h : H}
    (hh : h ∈ R.cartanCenter) : (w • φ) h = φ h := by
  rw [weylGroup_smul_apply, ← map_inv, R.corootEquiv_smul_eq_self_of_mem_cartanCenter hA w⁻¹ hh]

theorem corootEquiv_smul_mem_corootSpan (w : R.weylGroup hA) {h : H} (hh : h ∈ R.corootSpan) :
    R.corootEquiv hA w • h ∈ R.corootSpan := by
  induction w using R.weylGroup_induction generalizing h with
  | one => simpa using hh
  | simple i => simpa using R.simpleCoreflection_mem_corootSpan hA i hh
  | mul _ _ ihu ihv => rw [map_mul, mul_smul]; exact ihu (ihv hh)

end Field

/-! ### Induced `ℤ`-linear actions on `Q`, `Y`, and `P` -/

private noncomputable def restrictSubmoduleAction {G F V : Type*} [Group G] [Field F]
    [AddCommGroup V] [Module F V] (ρ : G →* (V ≃ₗ[F] V)) (L : Submodule ℤ V)
    (hL : ∀ g, ∀ x ∈ L, ρ g x ∈ L) : G →* (L ≃ₗ[ℤ] L) where
  toFun g :=
    { toFun x := ⟨ρ g x, hL g x x.2⟩
      invFun x := ⟨ρ g⁻¹ x, hL g⁻¹ x x.2⟩
      left_inv x := Subtype.ext <| by
        change (ρ g⁻¹ * ρ g) x.1 = (1 : V ≃ₗ[F] V) x.1
        rw [← map_mul, inv_mul_cancel, map_one]
      right_inv x := Subtype.ext <| by
        change (ρ g * ρ g⁻¹) x.1 = (1 : V ≃ₗ[F] V) x.1
        rw [← map_mul, mul_inv_cancel, map_one]
      map_add' x y := Subtype.ext (map_add (ρ g) x.1 y.1)
      map_smul' n x := Subtype.ext (map_zsmul (ρ g) n x.1) }
  map_one' := by
    ext x : 1
    exact Subtype.ext (by change (ρ 1) x.1 = (1 : V ≃ₗ[F] V) x.1; rw [map_one])
  map_mul' g₁ g₂ := by
    ext x : 1
    exact Subtype.ext (by change (ρ (g₁ * g₂)) x.1 = (ρ g₁ * ρ g₂) x.1; rw [map_mul])

section Lattices

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-- The Weyl group preserves the root lattice `Q`. -/
theorem weylGroup_smul_mem_rootLattice (hA : ∀ i, A.map (Int.cast : ℤ → K) i i = 2)
    (w : R.weylGroup hA) {φ : Dual K H} (hφ : φ ∈ R.rootLattice) : w • φ ∈ R.rootLattice := by
  induction w using R.weylGroup_induction generalizing φ with
  | one => simpa using hφ
  | simple i => exact R.simpleReflection_mem_rootLattice hA i hφ
  | mul _ _ ihu ihv => rw [mul_smul]; exact ihu (ihv hφ)

/-- The `ℤ`-linear representation of `R.weylGroup hA` on the root lattice `Q`. -/
noncomputable def rootLatticeAction (hA : ∀ i, A.map (Int.cast : ℤ → K) i i = 2) :
    R.weylGroup hA →* (R.rootLattice ≃ₗ[ℤ] R.rootLattice) :=
  restrictSubmoduleAction (R.weylGroup hA).subtype R.rootLattice
    fun w _ ↦ R.weylGroup_smul_mem_rootLattice hA w

@[simp] theorem coe_rootLatticeAction_apply (hA : ∀ i, A.map (Int.cast : ℤ → K) i i = 2)
    (w : R.weylGroup hA) (x : R.rootLattice) :
    (R.rootLatticeAction hA w x : Dual K H) = w • (x : Dual K H) := (rfl)

@[simp] theorem rootLatticeAction_weylSimple (hA : ∀ i, A.map (Int.cast : ℤ → K) i i = 2)
    (i : I) : R.rootLatticeAction hA (R.weylSimple hA i) = R.rootLatticeSimpleReflection hA i := by
  ext x : 1
  exact Subtype.ext (by simp)

namespace CoweightLattice

variable {H₀ : Type*} [AddCommGroup H₀] [Module ℚ H₀]
  {R₀ : CartanRealization (A.map (Int.cast : ℤ → ℚ)) H₀} (L : R₀.CoweightLattice)

/-- The coroot Weyl group preserves every coweight lattice `Y`. -/
theorem corootEquiv_smul_mem_lattice (hA : ∀ i, A.map (Int.cast : ℤ → ℚ) i i = 2)
    (w : R₀.weylGroup hA) {y : H₀} (hy : y ∈ L.lattice) :
    R₀.corootEquiv hA w • y ∈ L.lattice := by
  induction w using R₀.weylGroup_induction generalizing y with
  | one => simpa using hy
  | simple i => simpa using L.simpleCoreflection_mem_lattice hA i hy
  | mul _ _ ihu ihv => rw [map_mul, mul_smul]; exact ihu (ihv hy)

/-- The Weyl group preserves the dual weight lattice `P`. -/
theorem weylGroup_smul_mem_weightLattice (hA : ∀ i, A.map (Int.cast : ℤ → ℚ) i i = 2)
    (w : R₀.weylGroup hA) {φ : Dual ℚ H₀} (hφ : φ ∈ L.weightLattice) :
    w • φ ∈ L.weightLattice := by
  induction w using R₀.weylGroup_induction generalizing φ with
  | one => simpa using hφ
  | simple i => exact L.simpleReflection_mem_weightLattice hA i hφ
  | mul _ _ ihu ihv => rw [mul_smul]; exact ihu (ihv hφ)

/-- The `ℤ`-linear action of the Weyl group on the coweight lattice `Y`. -/
noncomputable def corootWeylAction (hA : ∀ i, A.map (Int.cast : ℤ → ℚ) i i = 2) :
    R₀.weylGroup hA →* (L.lattice ≃ₗ[ℤ] L.lattice) :=
  restrictSubmoduleAction ((R₀.corootWeylGroup hA).subtype.comp (R₀.corootEquiv hA).toMonoidHom)
    L.lattice fun w _ ↦ L.corootEquiv_smul_mem_lattice hA w

/-- The `ℤ`-linear action of the Weyl group on the weight lattice `P`. -/
noncomputable def weylAction (hA : ∀ i, A.map (Int.cast : ℤ → ℚ) i i = 2) :
    R₀.weylGroup hA →* (L.weightLattice ≃ₗ[ℤ] L.weightLattice) :=
  restrictSubmoduleAction (R₀.weylGroup hA).subtype L.weightLattice
    fun w _ ↦ L.weylGroup_smul_mem_weightLattice hA w

@[simp] theorem coe_corootWeylAction_apply (hA : ∀ i, A.map (Int.cast : ℤ → ℚ) i i = 2)
    (w : R₀.weylGroup hA) (y : L.lattice) :
    (L.corootWeylAction hA w y : H₀) = R₀.corootEquiv hA w • (y : H₀) := (rfl)

@[simp] theorem coe_weylAction_apply (hA : ∀ i, A.map (Int.cast : ℤ → ℚ) i i = 2)
    (w : R₀.weylGroup hA) (φ : L.weightLattice) :
    (L.weylAction hA w φ : Dual ℚ H₀) = w • (φ : Dual ℚ H₀) := (rfl)

@[simp] theorem corootWeylAction_weylSimple (hA : ∀ i, A.map (Int.cast : ℤ → ℚ) i i = 2)
    (i : I) : L.corootWeylAction hA (R₀.weylSimple hA i) = L.coreflection hA i := by
  ext y : 1
  exact Subtype.ext (by simp)

@[simp] theorem weylAction_weylSimple (hA : ∀ i, A.map (Int.cast : ℤ → ℚ) i i = 2) (i : I) :
    L.weylAction hA (R₀.weylSimple hA i) = L.reflection hA i := by
  ext φ : 1
  exact Subtype.ext (by simp)

/-- The Weyl group actions on `P` and `Y` preserve the integral pairing `P × Y → ℤ`. -/
@[simp] theorem pairing_weylAction_corootWeylAction (hA : ∀ i, A.map (Int.cast : ℤ → ℚ) i i = 2)
    (w : R₀.weylGroup hA) (φ : L.weightLattice) (y : L.lattice) :
    L.pairing (L.weylAction hA w φ) (L.corootWeylAction hA w y) = L.pairing φ y := by
  apply Int.cast_injective (α := ℚ)
  simp

end CoweightLattice

end Lattices

/-! ### Coxeter presentation, Kac Lemma 3.11, and Kac Proposition 3.13 -/

section GeneralizedCartan

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix I I ℤ} (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)
  (hA : A.IsGeneralizedCartan)

/-- The simple reflections of a realization of a generalized Cartan matrix satisfy the Coxeter
relations of `hA.coxeterMatrix`. -/
theorem isLiftable_weylSimple : hA.coxeterMatrix.IsLiftable (R.weylSimple hA.cast_diag) := by
  intro i j
  obtain rfl | hij := eq_or_ne i j
  · simp
  apply Subtype.ext
  apply LinearEquiv.ext
  intro φ
  rcases le_or_gt (A i j * A j i) 3 with hle | hgt
  · rw [hA.coxeterMatrix_of_le hle]
    have hnn := hA.mul_nonneg i j
    have hpow (m : ℕ) :
        (((R.weylSimple hA.cast_diag i * R.weylSimple hA.cast_diag j) ^ m :
            R.weylGroup hA.cast_diag) : Dual K H ≃ₗ[K] Dual K H) φ =
          ((R.simpleReflection hA.cast_diag i * R.simpleReflection hA.cast_diag j) ^ m) φ := by
      rw [Subgroup.coe_pow, Subgroup.coe_mul, coe_weylSimple, coe_weylSimple]
    rcases (by omega : A i j * A j i = 0 ∨ A i j * A j i = 1 ∨
        A i j * A j i = 2 ∨ A i j * A j i = 3) with hc | hc | hc | hc
    · have hi : A i j = 0 := (hA.mul_eq_zero_iff i j).mp hc
      have hj : A j i = 0 := (hA.zero_comm i j).mp hi
      have hcomm : R.simpleReflection hA.cast_diag j * R.simpleReflection hA.cast_diag i =
          R.simpleReflection hA.cast_diag i * R.simpleReflection hA.cast_diag j := by
        ext ψ h
        simp [mul_apply_eq_comp, simpleReflection_apply, hi, hj]
        ring
      rw [hc, TauCeti.coxeterOrder_zero, hpow 2, sq, mul_assoc,
        ← mul_assoc (R.simpleReflection hA.cast_diag j), hcomm]
      simp only [← mul_assoc, R.simpleReflection_mul_self, one_mul, Subgroup.coe_one]
    · rw [hc, TauCeti.coxeterOrder_one, hpow 3, R.simpleReflection_eq_reflection hA.cast_diag i,
        R.simpleReflection_eq_reflection hA.cast_diag j,
        Module.reflection_mul_reflection_pow_apply _ _ 3 φ (-1)
          (by simp [R.root_coroot, ← Int.cast_mul, hc]; norm_num)]
      norm_num [S_zero, S_one]
    · rw [hc, TauCeti.coxeterOrder_two, hpow 4, R.simpleReflection_eq_reflection hA.cast_diag i,
        R.simpleReflection_eq_reflection hA.cast_diag j,
        Module.reflection_mul_reflection_pow_apply _ _ 4 φ 0
          (by simp [R.root_coroot, ← Int.cast_mul, hc])]
      norm_num [S_zero, S_one]
    · rw [hc, TauCeti.coxeterOrder_three, hpow 6, R.simpleReflection_eq_reflection hA.cast_diag i,
        R.simpleReflection_eq_reflection hA.cast_diag j,
        Module.reflection_mul_reflection_pow_apply _ _ 6 φ 1
          (by simp [R.root_coroot, ← Int.cast_mul, hc]; norm_num)]
      norm_num [S_two]
  · rw [hA.coxeterMatrix_of_ne_of_lt hij hgt, pow_zero]

/-- The canonical group homomorphism from the abstract Coxeter group `hA.coxeterMatrix.Group` to
the Weyl group, sending each generator to the corresponding simple reflection. -/
noncomputable def weylCoxeterHom : hA.coxeterMatrix.Group →* R.weylGroup hA.cast_diag :=
  hA.coxeterMatrix.toCoxeterSystem.lift ⟨R.weylSimple hA.cast_diag, R.isLiftable_weylSimple hA⟩

@[simp] theorem weylCoxeterHom_simple (i : I) :
    R.weylCoxeterHom hA (hA.coxeterMatrix.simple i) = R.weylSimple hA.cast_diag i :=
  hA.coxeterMatrix.toCoxeterSystem.lift_apply_simple (R.isLiftable_weylSimple hA) i

@[simp] theorem weylCoxeterHom_wordProd (l : List I) :
    R.weylCoxeterHom hA (hA.coxeterMatrix.toCoxeterSystem.wordProd l) =
      (l.map (R.weylSimple hA.cast_diag)).prod := by
  simp [CoxeterSystem.wordProd, map_list_prod, List.map_map, Function.comp_def]

theorem weylCoxeterHom_surjective : Function.Surjective (R.weylCoxeterHom hA) := fun w ↦
  let ⟨l, hl⟩ := R.exists_list_prod_eq_weylGroup hA.cast_diag w
  ⟨hA.coxeterMatrix.toCoxeterSystem.wordProd l, (R.weylCoxeterHom_wordProd hA l).trans hl⟩

/-! #### Rank-two alternating word coefficients and parabolic induction -/

private def altWordCoeffs (p q : ℤ) : ℕ → ℤ × ℤ
  | 0 => (1, 0)
  | k + 1 =>
    let cd := altWordCoeffs p q k
    if k % 2 = 0 then (cd.1, q * cd.1 - cd.2) else (p * cd.2 - cd.1, cd.2)

private theorem weylCoxeterHom_alternatingWord_smul_root (i j : I) (k : ℕ) :
    R.weylCoxeterHom hA (hA.coxeterMatrix.toCoxeterSystem.wordProd
        (CoxeterSystem.alternatingWord i j k)) • R.root i =
      (altWordCoeffs (-A i j) (-A j i) k).1 • R.root i +
        (altWordCoeffs (-A i j) (-A j i) k).2 • R.root j := by
  induction k with
  | zero => simp [CoxeterSystem.alternatingWord, altWordCoeffs]
  | succ k ih =>
    rw [CoxeterSystem.alternatingWord_succ', hA.coxeterMatrix.toCoxeterSystem.wordProd_cons,
      map_mul, mul_smul, ih, CoxeterMatrix.toCoxeterSystem_simple, weylCoxeterHom_simple,
      weylSimple_smul]
    by_cases hk : Even k <;>
    · have hkmod : (k % 2 = 0) = Even k := propext Nat.even_iff.symm
      simp only [altWordCoeffs, hkmod, hk, ↓reduceIte, map_add, map_zsmul,
        R.simpleReflection_root hA.cast_diag]
      simp only [Matrix.map_apply, hA.diag, ← Int.cast_smul_eq_zsmul K]
      push_cast
      module

private theorem altWordCoeffs_nonneg_of_ge_four {p q : ℤ} (hp : 0 ≤ p) (hq : 0 ≤ q)
    (hpq : 4 ≤ p * q) (k : ℕ) :
    0 < (altWordCoeffs p q k).1 ∧ 0 ≤ (altWordCoeffs p q k).2 ∧
      (if k % 2 = 0 then 2 * (altWordCoeffs p q k).2 < q * (altWordCoeffs p q k).1
        else 2 * (altWordCoeffs p q k).1 < p * (altWordCoeffs p q k).2) := by
  have hp_pos : 0 < p := by nlinarith
  have hq_pos : 0 < q := by nlinarith
  induction k with
  | zero => simp [altWordCoeffs, hq_pos]
  | succ k ih =>
    obtain ⟨hc, hd, hinv⟩ := ih
    by_cases hk : k % 2 = 0
    · have hk' : (k + 1) % 2 ≠ 0 := by omega
      simp only [hk, ↓reduceIte] at hinv
      simp only [altWordCoeffs, hk, hk', ↓reduceIte]
      exact ⟨hc, by omega, by nlinarith⟩
    · have hk' : (k + 1) % 2 = 0 := by omega
      simp only [hk, ↓reduceIte] at hinv
      simp only [altWordCoeffs, hk, hk', ↓reduceIte]
      exact ⟨by omega, hd, by nlinarith⟩

private theorem altWordCoeffs_nonneg_of_le_three {p q : ℤ} (hp : 0 ≤ p) (hq : 0 ≤ q)
    (hpq_le : p * q ≤ 3) {k : ℕ} (hk : k < TauCeti.coxeterOrder (p * q)) :
    0 ≤ (altWordCoeffs p q k).1 ∧ 0 ≤ (altWordCoeffs p q k).2 := by
  rcases eq_or_lt_of_le (mul_nonneg hp hq) with hc0 | hpos
  · rw [← hc0, TauCeti.coxeterOrder_zero] at hk
    rcases (by omega : k = 0 ∨ k = 1) with rfl | rfl <;> simp [altWordCoeffs, hq]
  · have hp1 : 1 ≤ p := by have : p ≠ 0 := (by rintro rfl; simp at hpos); omega
    have hq1 : 1 ≤ q := by have : q ≠ 0 := (by rintro rfl; simp at hpos); omega
    have hp3 : p ≤ 3 := by nlinarith
    have hq3 : q ≤ 3 := by nlinarith
    have hk6 : k < 6 := lt_of_lt_of_le hk (TauCeti.coxeterOrder_le_six _)
    rcases (by omega : p = 1 ∨ p = 2 ∨ p = 3) with rfl | rfl | rfl <;>
      rcases (by omega : q = 1 ∨ q = 2 ∨ q = 3) with rfl | rfl | rfl
    all_goals first | omega | (
      norm_num [TauCeti.coxeterOrder_one, TauCeti.coxeterOrder_two,
        TauCeti.coxeterOrder_three] at hk
      rcases (by omega : k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5) with
        rfl | rfl | rfl | rfl | rfl | rfl <;> first | omega | decide)

private theorem exists_nsmul_alternatingWord_smul_root {i j : I} (hij : i ≠ j) {k : ℕ}
    (hk : k < hA.coxeterMatrix i j ∨ hA.coxeterMatrix i j = 0) :
    ∃ a b : ℕ, R.weylCoxeterHom hA (hA.coxeterMatrix.toCoxeterSystem.wordProd
        (CoxeterSystem.alternatingWord i j k)) • R.root i =
      a • R.root i + b • R.root j := by
  set p := -A i j
  set q := -A j i
  have hp : 0 ≤ p := neg_nonneg.mpr (hA.offDiag_nonpos i j hij)
  have hq : 0 ≤ q := neg_nonneg.mpr (hA.offDiag_nonpos j i hij.symm)
  have hpq_eq : p * q = A i j * A j i := neg_mul_neg (A i j) (A j i)
  suffices hnn : 0 ≤ (altWordCoeffs p q k).1 ∧ 0 ≤ (altWordCoeffs p q k).2 by
    refine ⟨(altWordCoeffs p q k).1.toNat, (altWordCoeffs p q k).2.toNat, ?_⟩
    rw [R.weylCoxeterHom_alternatingWord_smul_root hA i j k, ← natCast_zsmul, ← natCast_zsmul,
      Int.toNat_of_nonneg hnn.1, Int.toNat_of_nonneg hnn.2]
  rcases le_or_gt (A i j * A j i) 3 with hle | hgt
  · have hm : hA.coxeterMatrix i j = TauCeti.coxeterOrder (p * q) :=
      (hA.coxeterMatrix_of_le hle).trans (congrArg _ hpq_eq.symm)
    have hmem : p * q ∈ ({0, 1, 2, 3} : Set ℤ) := by
      have := mul_nonneg hp hq
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
      omega
    have hne0 : TauCeti.coxeterOrder (p * q) ≠ 0 :=
      ne_of_gt (lt_of_lt_of_le zero_lt_two (TauCeti.two_le_coxeterOrder hmem))
    exact altWordCoeffs_nonneg_of_le_three hp hq (hpq_eq.trans_le hle)
      ((hm ▸ hk).resolve_right hne0)
  · exact ⟨(altWordCoeffs_nonneg_of_ge_four hp hq (by omega) k).1.le,
      (altWordCoeffs_nonneg_of_ge_four hp hq (by omega) k).2.1⟩

private theorem exists_nsmul_smul_root_of_mem_parabolic_pair {i j : I} (hij : i ≠ j)
    {v : hA.coxeterMatrix.Group}
    (hv : v ∈ hA.coxeterMatrix.toCoxeterSystem.parabolic {i, j})
    (hvi : ¬ hA.coxeterMatrix.toCoxeterSystem.IsRightDescent v i) :
    ∃ a b : ℕ, R.weylCoxeterHom hA v • R.root i = a • R.root i + b • R.root j := by
  let cs := hA.coxeterMatrix.toCoxeterSystem
  have hlen := cs.not_isRightDescent_iff.mp hvi
  have hv_alt : cs.wordProd (CoxeterSystem.alternatingWord i j (cs.length v)) = v := by
    refine (cs.wordProd_alternatingWord_eq_of_mem_parabolic_pair hv).elim id fun heq ↦ ?_
    rcases hk : cs.length v with - | k
    · simp [cs.length_eq_zero_iff.mp hk, CoxeterSystem.alternatingWord]
    · rw [hk, CoxeterSystem.alternatingWord_succ, cs.wordProd_concat] at heq
      have hle := cs.length_wordProd_le (CoxeterSystem.alternatingWord i j k)
      rw [CoxeterSystem.length_alternatingWord] at hle
      rw [← heq, cs.simple_mul_simple_cancel_right, heq] at hlen
      omega
  have hred : cs.IsReduced (CoxeterSystem.alternatingWord j i (cs.length v + 1)) := by
    rw [CoxeterSystem.IsReduced, CoxeterSystem.alternatingWord_succ, cs.wordProd_concat, hv_alt,
      hlen, List.concat_eq_append, List.length_append, CoxeterSystem.length_alternatingWord,
      List.length_singleton]
  have hk_bound : cs.length v < hA.coxeterMatrix i j ∨ hA.coxeterMatrix i j = 0 := by
    by_contra hcon
    rw [not_or, not_lt, ← hA.coxeterMatrix.symmetric j i] at hcon
    exact cs.not_isReduced_alternatingWord j i hcon.2 (by omega) hred
  exact hv_alt ▸ R.exists_nsmul_alternatingWord_smul_root hA hij hk_bound

private theorem smul_root_mem_posRootCone_of_not_isRightDescent {g : hA.coxeterMatrix.Group}
    {i : I} (hnd : ¬ hA.coxeterMatrix.toCoxeterSystem.IsRightDescent g i) :
    R.weylCoxeterHom hA g • R.root i ∈ R.posRootCone := by
  let cs := hA.coxeterMatrix.toCoxeterSystem
  induction hn : cs.length g using Nat.strong_induction_on generalizing g i with
  | _ n ih =>
    obtain rfl | hg1 := eq_or_ne g 1
    · simpa using R.root_mem_posRootCone i
    obtain ⟨j, hdj⟩ := cs.exists_rightDescent_of_ne_one hg1
    have hij : i ≠ j := fun h ↦ hnd (h ▸ hdj)
    obtain ⟨⟨u, v⟩, ⟨hu, hv, huv⟩, -⟩ := cs.existsUnique_isMinimalCosetRep_mul {i, j} g
    dsimp only at hu hv huv
    subst huv
    have hu' := cs.isMinimalCosetRep_iff.mp hu
    have hadd := cs.length_mul_of_isMinimalCosetRep hu hv
    have hv1 : v ≠ 1 := fun h ↦ hu' j (by simp) (by simpa [h] using hdj)
    have hv_pos : 0 < cs.length v := Nat.pos_of_ne_zero (mt cs.length_eq_zero_iff.mp hv1)
    have hvi : ¬ cs.IsRightDescent v i := fun hdvi ↦ hnd <| by
      rw [CoxeterSystem.IsRightDescent] at hdvi ⊢
      rw [mul_assoc, cs.length_mul_of_isMinimalCosetRep hu
        (mul_mem hv (cs.simple_mem_parabolic (by simp))), hadd]
      omega
    obtain ⟨a, b, hab⟩ := R.exists_nsmul_smul_root_of_mem_parabolic_pair hA hij hv hvi
    rw [map_mul, mul_smul, hab, smul_add, smul_comm _ a, smul_comm _ b]
    exact add_mem (Submodule.smul_mem _ a (ih _ (by omega) (hu' i (by simp)) rfl))
      (Submodule.smul_mem _ b (ih _ (by omega) (hu' j (by simp)) rfl))

variable [CharZero K]

private theorem isRightDescent_coxeter_iff (g : hA.coxeterMatrix.Group) (i : I) :
    hA.coxeterMatrix.toCoxeterSystem.IsRightDescent g i ↔
      -(R.weylCoxeterHom hA g • R.root i) ∈ R.posRootCone := by
  let cs := hA.coxeterMatrix.toCoxeterSystem
  refine ⟨fun hd ↦ ?_, fun hneg ↦ by_contra fun hnd ↦ ?_⟩
  · simpa [cs, map_mul, mul_smul] using R.smul_root_mem_posRootCone_of_not_isRightDescent hA
      (cs.isRightDescent_iff_not_isRightDescent_mul.mp hd)
  · have hzero := R.isPointed_posRootCone _
      (R.smul_root_mem_posRootCone_of_not_isRightDescent hA hnd) hneg
    exact R.root_linearIndependent.ne_zero i
      (by simpa using congrArg ((R.weylCoxeterHom hA g)⁻¹ • ·) hzero)

private theorem eq_one_of_forall_weylCoxeterHom_smul_root_eq {g : hA.coxeterMatrix.Group}
    (hg : ∀ i, R.weylCoxeterHom hA g • R.root i = R.root i) : g = 1 := by
  by_contra hg1
  obtain ⟨i, hdi⟩ := hA.coxeterMatrix.toCoxeterSystem.exists_rightDescent_of_ne_one hg1
  have hneg := hg i ▸ (R.isRightDescent_coxeter_iff hA g i).mp hdi
  exact R.root_linearIndependent.ne_zero i
    (R.isPointed_posRootCone _ (R.root_mem_posRootCone i) hneg)

/-- **Kac, Proposition 3.13 (injectivity)**: the canonical homomorphism from the Coxeter group of
`hA.coxeterMatrix` to the Weyl group is injective. -/
theorem weylCoxeterHom_injective : Function.Injective (R.weylCoxeterHom hA) :=
  (injective_iff_map_eq_one _).mpr fun _ hg ↦
    R.eq_one_of_forall_weylCoxeterHom_smul_root_eq hA fun i ↦ by rw [hg, one_smul]

/-- **Kac, Proposition 3.13**: `weylCoxeterHom` is bijective. -/
theorem weylCoxeterHom_bijective : Function.Bijective (R.weylCoxeterHom hA) :=
  ⟨R.weylCoxeterHom_injective hA, R.weylCoxeterHom_surjective hA⟩

/-- **Kac, Proposition 3.13**: group isomorphism
`hA.coxeterMatrix.Group ≃* R.weylGroup hA.cast_diag` identifying the Weyl group with the Coxeter
group of `hA.coxeterMatrix`. -/
noncomputable def weylGroupEquiv : hA.coxeterMatrix.Group ≃* R.weylGroup hA.cast_diag :=
  MulEquiv.ofBijective (R.weylCoxeterHom hA) (R.weylCoxeterHom_bijective hA)

@[simp] theorem coe_weylGroupEquiv :
    (R.weylGroupEquiv hA : hA.coxeterMatrix.Group →* R.weylGroup hA.cast_diag) =
      R.weylCoxeterHom hA := (rfl)

@[simp] theorem weylGroupEquiv_apply (g : hA.coxeterMatrix.Group) :
    R.weylGroupEquiv hA g = R.weylCoxeterHom hA g := (rfl)

@[simp] theorem weylGroupEquiv_symm_weylSimple (i : I) :
    (R.weylGroupEquiv hA).symm (R.weylSimple hA.cast_diag i) = hA.coxeterMatrix.simple i :=
  (R.weylGroupEquiv hA).symm_apply_eq.mpr (R.weylCoxeterHom_simple hA i).symm

/-- **The Weyl group as a Coxeter system** for `hA.coxeterMatrix`. -/
noncomputable def weylCoxeterSystem :
    CoxeterSystem hA.coxeterMatrix (R.weylGroup hA.cast_diag) :=
  hA.coxeterMatrix.toCoxeterSystem.map (R.weylGroupEquiv hA)

theorem weylCoxeterSystem_def :
    R.weylCoxeterSystem hA = hA.coxeterMatrix.toCoxeterSystem.map (R.weylGroupEquiv hA) := (rfl)

@[simp] theorem weylCoxeterSystem_simple (i : I) :
    (R.weylCoxeterSystem hA).simple i = R.weylSimple hA.cast_diag i := by simp [weylCoxeterSystem]

@[simp] theorem weylCoxeterSystem_wordProd (l : List I) :
    (R.weylCoxeterSystem hA).wordProd l = (l.map (R.weylSimple hA.cast_diag)).prod := by
  rw [weylCoxeterSystem, CoxeterSystem.wordProd_map, weylGroupEquiv_apply, weylCoxeterHom_wordProd]

@[simp] theorem weylCoxeterSystem_length (w : R.weylGroup hA.cast_diag) :
    (R.weylCoxeterSystem hA).length w = R.length hA.cast_diag w := by
  apply le_antisymm
  · obtain ⟨l, rfl, hlen⟩ := R.exists_list_prod_eq_and_length_eq hA.cast_diag w
    exact hlen ▸ weylCoxeterSystem_wordProd R hA l ▸ (R.weylCoxeterSystem hA).length_wordProd_le l
  · obtain ⟨l, hl, rfl⟩ := (R.weylCoxeterSystem hA).exists_isReduced w
    exact hl.eq.symm ▸ weylCoxeterSystem_wordProd R hA l ▸ R.length_prod_map_le hA.cast_diag l

@[simp] theorem length_weylSimple (i : I) :
    R.length hA.cast_diag (R.weylSimple hA.cast_diag i) = 1 := by
  simpa using (R.weylCoxeterSystem hA).length_simple i

@[simp] theorem orderOf_weylSimple_mul_weylSimple (i j : I) :
    orderOf (R.weylSimple hA.cast_diag i * R.weylSimple hA.cast_diag j) =
      hA.coxeterMatrix i j := by
  simpa using (R.weylCoxeterSystem hA).orderOf_simple_mul_simple i j

/-- **Kac, Lemma 3.11** (Coxeter descent form): `i` is a right descent of `w` if and only if
`-(w • αᵢ) ∈ Q₊`. -/
theorem isRightDescent_weylCoxeterSystem_iff (w : R.weylGroup hA.cast_diag) (i : I) :
    (R.weylCoxeterSystem hA).IsRightDescent w i ↔ -(w • R.root i) ∈ R.posRootCone := by
  obtain ⟨g, rfl⟩ := (R.weylGroupEquiv hA).surjective w
  rw [CoxeterSystem.IsRightDescent, weylCoxeterSystem_def, CoxeterSystem.map_simple, ← map_mul,
    CoxeterSystem.length_map, CoxeterSystem.length_map]
  exact R.isRightDescent_coxeter_iff hA g i

/-- **Kac, Lemma 3.11**: `ℓ(w sᵢ) < ℓ(w)` if and only if `-(w • αᵢ) ∈ Q₊`. -/
theorem length_mul_weylSimple_lt_iff (w : R.weylGroup hA.cast_diag) (i : I) :
    R.length hA.cast_diag (w * R.weylSimple hA.cast_diag i) < R.length hA.cast_diag w ↔
      -(w • R.root i) ∈ R.posRootCone := by
  simpa [CoxeterSystem.IsRightDescent] using R.isRightDescent_weylCoxeterSystem_iff hA w i

/-- Complementary form of Kac, Lemma 3.11: `w • αᵢ ∈ Q₊` if and only if `ℓ(w) < ℓ(w sᵢ)`. -/
theorem smul_root_mem_posRootCone_iff (w : R.weylGroup hA.cast_diag) (i : I) :
    w • R.root i ∈ R.posRootCone ↔
      R.length hA.cast_diag w < R.length hA.cast_diag (w * R.weylSimple hA.cast_diag i) := by
  let cs := R.weylCoxeterSystem hA
  have hiff : cs.IsRightDescent (w * cs.simple i) i ↔ w • R.root i ∈ R.posRootCone := by
    simpa [cs, mul_smul] using
      R.isRightDescent_weylCoxeterSystem_iff hA (w * R.weylSimple hA.cast_diag i) i
  rw [← hiff, cs.isRightDescent_iff_not_isRightDescent_mul, cs.simple_mul_simple_cancel_right,
    CoxeterSystem.IsRightDescent]
  have hlen := cs.length_mul_simple w i
  simp only [cs, weylCoxeterSystem_length, weylCoxeterSystem_simple] at hlen ⊢
  omega

theorem not_isRightDescent_weylCoxeterSystem_iff (w : R.weylGroup hA.cast_diag) (i : I) :
    ¬ (R.weylCoxeterSystem hA).IsRightDescent w i ↔ w • R.root i ∈ R.posRootCone := by
  rw [R.smul_root_mem_posRootCone_iff hA, CoxeterSystem.IsRightDescent]
  have hne := (R.weylCoxeterSystem hA).length_mul_simple_ne w i
  simp only [weylCoxeterSystem_simple, weylCoxeterSystem_length] at hne ⊢
  omega

/-! ### Faithfulness on `Q` and invariance under central enlargement -/

theorem weylGroup_eq_one_of_forall_smul_root_eq {w : R.weylGroup hA.cast_diag}
    (hw : ∀ i, w • R.root i = R.root i) : w = 1 := by
  obtain ⟨g, rfl⟩ := (R.weylGroupEquiv hA).surjective w
  rw [R.eq_one_of_forall_weylCoxeterHom_smul_root_eq hA hw, map_one]

/-- **Faithfulness of the Weyl group on the root lattice `Q`**: `R.rootLatticeAction` is injective.
-/
theorem rootLatticeAction_injective : Function.Injective (R.rootLatticeAction hA.cast_diag) :=
  (injective_iff_map_eq_one _).mpr fun _ hw ↦
    R.weylGroup_eq_one_of_forall_smul_root_eq hA fun i ↦
      congrArg Subtype.val (LinearEquiv.congr_fun hw ⟨R.root i, R.root_mem_rootLattice i⟩)

end GeneralizedCartan

section Enlargement

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I K}
  (R : CartanRealization A H) (M : Submodule K H) (hc : R.corootSpan ≤ M)
  (hs : M ⊔ R.cartanCenter = ⊤)

/-- Every element of `R.rootLattice` vanishes on the Cartan center. -/
theorem apply_eq_zero_of_mem_rootLattice_of_mem_cartanCenter {φ : Dual K H}
    (hφ : φ ∈ R.rootLattice) {z : H} (hz : z ∈ R.cartanCenter) : φ z = 0 := by
  rw [R.rootLattice_def] at hφ
  induction hφ using Submodule.span_induction with
  | mem _ hx => obtain ⟨i, rfl⟩ := hx; exact (R.mem_cartanCenter_iff z).mp hz i
  | zero => simp
  | add _ _ _ _ hx hy => simp [hx, hy]
  | smul _ _ _ hx => simp [hx]

/-- Restricting functionals to `M` carries `R.rootLattice` into `(R.restrict M hc hs).rootLattice`.
-/
theorem comp_subtype_mem_restrict_rootLattice {φ : Dual K H} (hφ : φ ∈ R.rootLattice) :
    φ.comp M.subtype ∈ (R.restrict M hc hs).rootLattice := by
  rw [R.rootLattice_def] at hφ
  induction hφ using Submodule.span_induction with
  | mem _ hx =>
    obtain ⟨i, rfl⟩ := hx
    exact (show (R.root i).comp M.subtype = (R.restrict M hc hs).root i by ext; simp) ▸
      (R.restrict M hc hs).root_mem_rootLattice i
  | zero => simp
  | add _ _ _ _ hx hy => simpa only [LinearMap.add_comp] using add_mem hx hy
  | smul n x _ hx =>
    exact (show (n • x).comp M.subtype = n • x.comp M.subtype by ext; simp) ▸
      Submodule.smul_mem _ n hx

private theorem restrictRootLattice_bijective :
    Function.Bijective (fun x : R.rootLattice ↦
      (⟨x.1.comp M.subtype, R.comp_subtype_mem_restrict_rootLattice M hc hs x.2⟩ :
        (R.restrict M hc hs).rootLattice)) := by
  refine ⟨fun x y hxy ↦ Subtype.ext <| sub_eq_zero.mp <| LinearMap.ext fun h ↦ ?_,
    fun ⟨ψ, hψ⟩ ↦ ?_⟩
  · obtain ⟨m, hm, z, hz, rfl⟩ := Submodule.mem_sup.mp (hs ▸ Submodule.mem_top : h ∈ _)
    have hm0 : (x.1 - y.1) m = 0 := by
      simpa [sub_eq_zero] using LinearMap.congr_fun (congrArg Subtype.val hxy) ⟨m, hm⟩
    simp [map_add, hm0, R.apply_eq_zero_of_mem_rootLattice_of_mem_cartanCenter (sub_mem x.2 y.2) hz]
  · suffices ∃ x : R.rootLattice, x.1.comp M.subtype = ψ from
      let ⟨x, hx⟩ := this; ⟨x, Subtype.ext hx⟩
    rw [(R.restrict M hc hs).rootLattice_def] at hψ
    induction hψ using Submodule.span_induction with
    | mem _ hy =>
      obtain ⟨i, rfl⟩ := hy
      exact ⟨⟨R.root i, R.root_mem_rootLattice i⟩, by ext; simp⟩
    | zero => exact ⟨0, by ext; simp⟩
    | add _ _ _ _ ihx ihy =>
      obtain ⟨x, rfl⟩ := ihx; obtain ⟨y, rfl⟩ := ihy; exact ⟨x + y, by ext; simp⟩
    | smul n _ _ ihx => obtain ⟨x, rfl⟩ := ihx; exact ⟨n • x, by ext; simp⟩

/-- Restriction along `M.subtype` is a `ℤ`-linear isomorphism from the root lattice of `R` to the
root lattice of `R.restrict M hc hs`. -/
noncomputable def restrictRootLatticeEquiv :
    R.rootLattice ≃ₗ[ℤ] (R.restrict M hc hs).rootLattice :=
  LinearEquiv.ofBijective
    { toFun x := ⟨x.1.comp M.subtype, R.comp_subtype_mem_restrict_rootLattice M hc hs x.2⟩
      map_add' _ _ := Subtype.ext (by ext; simp)
      map_smul' _ _ := Subtype.ext (by ext; simp) }
    (R.restrictRootLattice_bijective M hc hs)

@[simp] theorem coe_restrictRootLatticeEquiv_apply (x : R.rootLattice) :
    (R.restrictRootLatticeEquiv M hc hs x : Dual K M) = x.1.comp M.subtype := (rfl)

@[simp] theorem restrictRootLatticeEquiv_root (i : I) :
    R.restrictRootLatticeEquiv M hc hs ⟨R.root i, R.root_mem_rootLattice i⟩ =
      ⟨(R.restrict M hc hs).root i, (R.restrict M hc hs).root_mem_rootLattice i⟩ := by
  ext m
  simp

end Enlargement

section EnlargementWeylGroup

variable {I K H : Type*} [Field K] [CharZero K] [AddCommGroup H] [Module K H]
  {A : Matrix I I ℤ} (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)
  (hA : A.IsGeneralizedCartan) (M : Submodule K H) (hc : R.corootSpan ≤ M)
  (hs : M ⊔ R.cartanCenter = ⊤)

/-- **Enlargement invariance of the Weyl group**: the Weyl group of `R` is canonically isomorphic
to that of any sub-realization `R.restrict M hc hs`. -/
noncomputable def restrictWeylGroupEquiv :
    R.weylGroup hA.cast_diag ≃* (R.restrict M hc hs).weylGroup hA.cast_diag :=
  (R.weylGroupEquiv hA).symm.trans ((R.restrict M hc hs).weylGroupEquiv hA)

@[simp] theorem restrictWeylGroupEquiv_weylSimple (i : I) :
    R.restrictWeylGroupEquiv hA M hc hs (R.weylSimple hA.cast_diag i) =
      (R.restrict M hc hs).weylSimple hA.cast_diag i := by simp [restrictWeylGroupEquiv]

@[simp] theorem restrictWeylGroupEquiv_smul_comp_subtype (w : R.weylGroup hA.cast_diag)
    (φ : Dual K H) :
    R.restrictWeylGroupEquiv hA M hc hs w • φ.comp M.subtype = (w • φ).comp M.subtype := by
  induction w using R.weylGroup_induction generalizing φ with
  | one => simp
  | simple _ => simp
  | mul _ _ ihu ihv => rw [map_mul, mul_smul, mul_smul, ihv, ihu]

@[simp] theorem restrictRootLatticeEquiv_rootLatticeAction (w : R.weylGroup hA.cast_diag)
    (x : R.rootLattice) :
    (R.restrict M hc hs).rootLatticeAction hA.cast_diag
        (R.restrictWeylGroupEquiv hA M hc hs w) (R.restrictRootLatticeEquiv M hc hs x) =
      R.restrictRootLatticeEquiv M hc hs (R.rootLatticeAction hA.cast_diag w x) :=
  Subtype.ext (R.restrictWeylGroupEquiv_smul_comp_subtype hA M hc hs w x.1)

/-- `restrictWeylGroupEquiv` is uniquely determined by compatibility with restriction to `Q`. -/
theorem eq_restrictWeylGroupEquiv_of_rootLattice
    {w : R.weylGroup hA.cast_diag} {w' : (R.restrict M hc hs).weylGroup hA.cast_diag}
    (h : ∀ x : R.rootLattice,
      (R.restrict M hc hs).rootLatticeAction hA.cast_diag w'
          (R.restrictRootLatticeEquiv M hc hs x) =
        R.restrictRootLatticeEquiv M hc hs (R.rootLatticeAction hA.cast_diag w x)) :
    w' = R.restrictWeylGroupEquiv hA M hc hs w := by
  apply (R.restrict M hc hs).rootLatticeAction_injective hA
  ext y : 1
  obtain ⟨x, rfl⟩ := (R.restrictRootLatticeEquiv M hc hs).surjective y
  exact (h x).trans (R.restrictRootLatticeEquiv_rootLatticeAction hA M hc hs w x).symm

end EnlargementWeylGroup

end TauCeti.CartanRealization

/-! ### Examples and sanity checks -/

section Examples

open Matrix TauCeti

/-- Type `A₁`: `W = {1, s}` has order `2`, and `s(ω) = -ω` when `2 • ω = α`. -/
example {K H : Type*} [Field K] [CharZero K] [AddCommGroup H] [Module K H]
    (R : CartanRealization ((!![(2 : ℤ)] : Matrix (Fin 1) (Fin 1) ℤ).map (Int.cast : ℤ → K)) H)
    (ω : Module.Dual K H) (hω : 2 • ω = R.root 0) :
    ∃ hA : (!![(2 : ℤ)] : Matrix (Fin 1) (Fin 1) ℤ).IsGeneralizedCartan,
      (Set.univ : Set (R.weylGroup hA.cast_diag)) = {1, R.weylSimple hA.cast_diag 0} ∧
        Nat.card (R.weylGroup hA.cast_diag) = 2 ∧
        R.simpleReflection hA.cast_diag 0 ω = -ω := by
  have hA : (!![(2 : ℤ)] : Matrix (Fin 1) (Fin 1) ℤ).IsGeneralizedCartan :=
    ⟨by decide, by simp [Fin.forall_fin_one], by simp⟩
  let cs := R.weylCoxeterSystem hA
  have huniv (w : R.weylGroup hA.cast_diag) : w = 1 ∨ w = R.weylSimple hA.cast_diag 0 := by
    obtain ⟨l, hl, rfl⟩ := cs.exists_isReduced w
    match l, hl.isChain_ne with
    | [], _ => exact Or.inl rfl
    | [i], _ => exact Subsingleton.elim i 0 ▸ Or.inr (by simp [cs])
    | a :: b :: _, hc => exact absurd (Subsingleton.elim a b) (List.isChain_cons_cons.mp hc).1
  have hne : R.weylSimple hA.cast_diag 0 ≠ 1 := by simpa [cs] using cs.simple_ne_one 0
  have heq : Bool ≃ R.weylGroup hA.cast_diag :=
    Equiv.ofBijective (fun b ↦ if b then R.weylSimple hA.cast_diag 0 else 1)
      ⟨by rintro (_ | _) (_ | _) h <;> simp_all [hne.symm],
       fun w ↦ (huniv w).elim (⟨false, ·.symm⟩) (⟨true, ·.symm⟩)⟩
  have hω0 : ω (R.coroot 0) = 1 := mul_left_cancel₀ (two_ne_zero (α := K))
    (by simpa [two_smul, two_mul] using LinearMap.congr_fun hω (R.coroot 0))
  exact ⟨hA, Set.ext fun w ↦ by simpa using huniv w, by simpa using Nat.card_congr heq.symm,
    by rw [R.simpleReflection_apply, hω0, one_smul, ← hω, two_smul]; abel⟩

/-- Affine type `A₁⁽¹⁾` (`[[2, -2], [-2, 2]]`): `m₀₁ = 0` (`∞`), `W` is infinite, and
`(s₀ s₁)(α₁) = α₁ - 2 • (α₀ + α₁)`. -/
example {K H : Type*} [Field K] [CharZero K] [AddCommGroup H] [Module K H]
    (R : CartanRealization
      ((!![(2 : ℤ), -2; -2, 2] : Matrix (Fin 2) (Fin 2) ℤ).map (Int.cast : ℤ → K)) H) :
    ∃ hA : (!![(2 : ℤ), -2; -2, 2] : Matrix (Fin 2) (Fin 2) ℤ).IsGeneralizedCartan,
      hA.coxeterMatrix 0 1 = 0 ∧
        ¬ IsOfFinOrder (R.weylSimple hA.cast_diag 0 * R.weylSimple hA.cast_diag 1) ∧
        Infinite (R.weylGroup hA.cast_diag) ∧
        (R.weylSimple hA.cast_diag 0 * R.weylSimple hA.cast_diag 1) • R.root 1 =
          R.root 1 - 2 • (R.root 0 + R.root 1) := by
  have hA : (!![(2 : ℤ), -2; -2, 2] : Matrix (Fin 2) (Fin 2) ℤ).IsGeneralizedCartan :=
    ⟨by decide, by simp [Fin.forall_fin_two], by simp [Fin.forall_fin_two]⟩
  have hm01 : hA.coxeterMatrix 0 1 = 0 := hA.coxeterMatrix_of_ne_of_lt (by decide) (by decide)
  have hfin : ¬ IsOfFinOrder (R.weylSimple hA.cast_diag 0 * R.weylSimple hA.cast_diag 1) :=
    orderOf_eq_zero_iff.mp ((R.orderOf_weylSimple_mul_weylSimple hA 0 1).trans hm01)
  refine ⟨hA, hm01, hfin, not_finite_iff_infinite.mp fun _ ↦ hfin (isOfFinOrder_of_finite _), ?_⟩
  ext h
  simp [mul_smul, R.simpleReflection_root, two_smul]
  ring

/-- Asymmetric type `B₂` (`[[2, -2], [-1, 2]]`): `a₀₁ a₁₀ = 2`, so `m₀₁ = 4` and `s₀ s₁` has
order `4`. -/
example {K H : Type*} [Field K] [CharZero K] [AddCommGroup H] [Module K H]
    (R : CartanRealization ((CartanMatrix.B 2).map (Int.cast : ℤ → K)) H) :
    ∃ hB : (CartanMatrix.B 2).IsGeneralizedCartan,
      hB.coxeterMatrix 0 1 = 4 ∧
        orderOf (R.weylSimple hB.cast_diag 0 * R.weylSimple hB.cast_diag 1) = 4 := by
  have hB : (CartanMatrix.B 2).IsGeneralizedCartan :=
    ⟨by decide, by simp [Fin.forall_fin_two, CartanMatrix.B],
      by simp [Fin.forall_fin_two, CartanMatrix.B]⟩
  have hm : hB.coxeterMatrix 0 1 = 4 := hB.coxeterMatrix_eq_four_iff.mpr (by decide)
  exact ⟨hB, hm, (R.orderOf_weylSimple_mul_weylSimple hB 0 1).trans hm⟩

/-- Empty index set (`Fin 0`): `W` is trivial and `ℓ(1) = 0`. -/
example {K H : Type*} [Field K] [AddCommGroup H] [Module K H]
    (R : CartanRealization (!![] : Matrix (Fin 0) (Fin 0) K) H) :
    Subsingleton (R.weylGroup nofun) ∧ R.length nofun 1 = 0 :=
  ⟨inferInstance, R.length_one nofun⟩

end Examples
