/-!
# The commutator subgroup of the general linear group

Over a field with an element different from zero and one, the abstract commutator subgroup of
`GLₙ` is the determinant kernel. Conjugation by a diagonal matrix expresses every elementary
transvection as a commutator. The generation of `SLₙ` by transvections then supplies the reverse
inclusion to the one given by the determinant.

The hypothesis includes every field with more than two elements. It is needed in dimension two:
`GL₂(𝔽₂)` has a proper commutator subgroup, although its determinant is trivial. The statements
also include dimensions zero and one.

The proof uses `Matrix.SpecialLinearGroup.closure_range_toSpecialLinearGroup_eq_top_of_field`
and `TauCeti.elementarySubgroup_le_commutator_of_isUnit_sub_one`, which holds over any ring with a
unit `a` such that `a - 1` is a unit. The same generation shows that over a finite field every
character `GL ι K →* Kˣ` is trivial on `SL ι K` (`Matrix.SpecialLinearGroup.map_toGL_eq_one`).

In size two the same conclusion holds over a local ring `R` with a unit `u` such that `u - 1` is a
unit, such as `ℤ_ℓ` for an odd prime `ℓ`, and with a bound on the number of commutators: every
element of `SL₂(R)` is a product of four commutators of `GL₂(R)`. An element `[[a, b], [c, d]]` with
`a` a unit factors as `[[1, 0], [c/a, 1]] · diag(a, a⁻¹) · [[1, b/a], [0, 1]]`, and each factor is a
single commutator as soon as `b` and `c` are multiples of `u - 1`; when `a` is not a unit, `c` is,
and one elementary matrix moves the matrix into that case. The three-factor statement, with `b` and
`c` multiples of `u - 1`, is kept separately because it also applies when `u - 1` is not a unit:
over `ℤ₂` with `u = 3` it covers the matrices congruent to `1` modulo `2`. A bound uniform over a
family of rings is what makes the commutator subgroup of a product of such groups the product of
their commutator subgroups.

Over a field with two elements, where `GL₂(F) ≅ S₃`, the commutator subgroup is the alternating
group `A₃`: it consists of the elements whose cube is `1`. That it is generated by each of its
nontrivial elements is
`Matrix.GeneralLinearGroup.eq_one_or_eq_or_eq_inv_of_pow_three_eq_one_of_card_eq_two`, in
`TauCeti/LinearAlgebra/Matrix/GeneralLinearGroup/FieldCardTwo.lean`.

## Main results

* `Matrix.GeneralLinearGroup.commutator_eq_ker_det`: over a field with an element other than `0`
  and `1`, the commutator subgroup of `GLₙ` is the determinant kernel.
* `Matrix.SpecialLinearGroup.toGL_mem_commutatorSet_pow_three`: an element of `SL₂(R)` with a unit
  upper-left entry and off-diagonal entries divisible by `u - 1` is a product of three commutators.
* `Matrix.SpecialLinearGroup.toGL_mem_commutatorSet_pow_four`: over a local ring with units `u` and
  `u - 1`, every element of `SL₂(R)` is a product of four commutators of `GL₂(R)`.
* `Matrix.GeneralLinearGroup.commutator_eq_ker_det_fin_two_of_isLocalRing`: hence the commutator
  subgroup of `GL₂(R)` is the determinant kernel.
* `Matrix.GeneralLinearGroup.mem_commutator_fin_two_iff_pow_three_eq_one`: over a field with two
  elements, `x ∈ [GL₂(F), GL₂(F)]` exactly when `x ^ 3 = 1`.

## References

`Matrix.SpecialLinearGroup.map_toGL_eq_one` is adapted from grh-lean
(https://github.com/lsernau/grh-lean, Apache 2.0, Copyright 2026 Anthropic PBC), file
`src/New/Congruences/FirstOrder/OnePrime.lean` (`New.Patching.map_toGL_transvection_eq_one`).
-/

public section

open Matrix
open scoped commutatorElement

namespace TauCeti

noncomputable section

variable {K : Type*} [Field K] {ι : Type*} [Fintype ι] [DecidableEq ι] {i j : ι}

/-- Over a field with more than two elements, the abstract commutator subgroup of `GLₙ` is
exactly the kernel of the unit-valued determinant. -/
theorem _root_.Matrix.GeneralLinearGroup.commutator_eq_ker_det {a : K}
    (ha₀ : a ≠ 0) (ha₁ : a ≠ 1) :
    commutator (GL ι K) = (GeneralLinearGroup.det : GL ι K →* Kˣ).ker := by
  apply le_antisymm
  · apply Subgroup.commutator_le.mpr
    intro g _ h _
    simp [MonoidHom.mem_ker, commutatorElement_def]
  · intro g hg
    rw [← SpecialLinearGroup.range_toGL_eq_ker_det] at hg
    obtain ⟨s, rfl⟩ := hg
    have hgen := SpecialLinearGroup.closure_range_toSpecialLinearGroup_eq_top_of_field
      (ι := ι) (K := K)
    have hle : Subgroup.closure (Set.range (TransvectionStruct.toSpecialLinearGroup :
        TransvectionStruct ι K → SpecialLinearGroup ι K)) ≤
        (commutator (GL ι K)).comap SpecialLinearGroup.toGL := by
      rw [Subgroup.closure_le]
      rintro _ ⟨v, rfl⟩
      rcases v with ⟨i, j, hij, c⟩
      apply (Subgroup.mem_comap).mpr
      rw [TransvectionStruct.toSpecialLinearGroup_mk,
        toGL_transvection_eq_transvectionUnit]
      exact elementarySubgroup_le_commutator_of_isUnit_sub_one (Units.mk0 a ha₀)
        (sub_ne_zero.2 ha₁).isUnit (transvectionUnit_mem_elementarySubgroup hij c)
    rw [hgen] at hle
    exact hle (Subgroup.mem_top s)

/-- Over a finite field, a character of `GL ι K` with values in `Kˣ` is trivial on `SL ι K`: the
special linear group is generated by transvections, and a homomorphism from the additive group of
`K`, of order `q`, to `Kˣ`, of order `q - 1`, is trivial. -/
theorem _root_.Matrix.SpecialLinearGroup.map_toGL_eq_one [Finite K] (τ : GL ι K →* Kˣ)
    (s : SpecialLinearGroup ι K) :
    τ (SpecialLinearGroup.toGL s) = 1 := by
  have : Fintype K := Fintype.ofFinite K
  suffices τ.comp SpecialLinearGroup.toGL = 1 from DFunLike.congr_fun this s
  refine MonoidHom.eq_of_eqOn_dense
    SpecialLinearGroup.closure_range_toSpecialLinearGroup_eq_top_of_field ?_
  rintro _ ⟨t, rfl⟩
  -- The transvections with parameter in `K` form a homomorphic image of the additive group.
  let ψ : Multiplicative K →* Kˣ := τ.comp (transvectionHom t.hij)
  have h_eq : SpecialLinearGroup.toGL t.toSpecialLinearGroup =
      transvectionHom t.hij (Multiplicative.ofAdd t.c) :=
    Units.ext (by simp [TransvectionStruct.toMatrix, transvection])
  have pow_card : ψ (.ofAdd t.c) ^ Fintype.card K = 1 := by
    rw [← map_pow, ← ofAdd_nsmul, card_nsmul_eq_zero, ofAdd_zero, map_one]
  have ψ_eq : ψ (.ofAdd t.c) = 1 := Units.ext (by
    rw [← FiniteField.pow_card (ψ (.ofAdd t.c) : K), ← Units.val_pow_eq_pow_val, pow_card])
  rw [MonoidHom.comp_apply, MonoidHom.one_apply, h_eq]
  exact ψ_eq

/-! ## Commutator width of `GL₂` over a local ring -/

section FinTwo

open scoped MatrixGroups Pointwise

variable {R : Type*} [CommRing R]

/-- `diag(a, a⁻¹)` is the commutator of `diag(a, 1)` with the Weyl element `!![0, 1; -1, 0]`. -/
theorem diagGL_eq_commutatorElement_transvectionWeylElement (a : Rˣ) :
    diagGL ![a, a⁻¹] =
      ⁅diagGL (Pi.mulSingle (0 : Fin 2) a),
        transvectionWeylElement (A := R) (zero_ne_one : (0 : Fin 2) ≠ 1)⁆ := by
  rw [commutatorElement_def, transvectionWeylElement_inv, mul_assoc, mul_assoc,
    ← mul_assoc (transvectionWeylElement _), ← map_inv, transvectionWeylElement_mul_diagGL_mul_inv,
    ← map_mul]
  congr 1
  funext k
  fin_cases k <;> simp

/-- The upper-left section `[[a, 0], [c, a⁻¹]]` of `SL₂` is the lower unipotent matrix
`[[1, 0], [c a⁻¹, 1]]` times the diagonal matrix `diag(a, a⁻¹)`. -/
theorem _root_.Matrix.SpecialLinearGroup.toGL_upperLeftSection (a : Rˣ) (c : R) :
    SpecialLinearGroup.toGL (SpecialLinearGroup.upperLeftSection a c) =
      transvectionUnit (one_ne_zero : (1 : Fin 2) ≠ 0) (c * (a⁻¹ : Rˣ)) * diagGL ![a, a⁻¹] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two, transvection, Matrix.one_apply]

/-- An element of `SL₂(R)` whose upper-left entry is a unit and whose off-diagonal entries are
multiples of `u - 1`, for a unit `u`, is a product of three commutators of `GL₂(R)`. -/
theorem _root_.Matrix.SpecialLinearGroup.toGL_mem_commutatorSet_pow_three (g : SL(2, R))
    (u : Rˣ) (h00 : IsUnit (g 0 0)) (h01 : (u - 1 : R) ∣ g 0 1) (h10 : (u - 1 : R) ∣ g 1 0) :
    SpecialLinearGroup.toGL g ∈ commutatorSet (GL (Fin 2) R) ^ 3 := by
  obtain ⟨a, ha⟩ := h00
  obtain ⟨b, hb⟩ := h01
  obtain ⟨c, hc⟩ := h10
  -- `g = [[1, 0], [c/a, 1]] · diag(a, a⁻¹) · [[1, b/a], [0, 1]]`, and each factor is a commutator.
  have hg : SpecialLinearGroup.toGL g =
      ⁅diagGL (Pi.mulSingle (1 : Fin 2) u), transvectionUnit one_ne_zero (c * (a⁻¹ : Rˣ))⁆ *
        ⁅diagGL (Pi.mulSingle (0 : Fin 2) a), transvectionWeylElement zero_ne_one⁆ *
        ⁅diagGL (Pi.mulSingle (0 : Fin 2) u), transvectionUnit zero_ne_one ((a⁻¹ : Rˣ) * b)⁆ := by
    conv_lhs => rw [← SpecialLinearGroup.upperLeftSection_mul_transvection_eq g a ha.symm]
    rw [map_mul, SpecialLinearGroup.toGL_upperLeftSection, toGL_transvection_eq_transvectionUnit,
      commutatorElement_diagGL_mulSingle_transvectionUnit,
      commutatorElement_diagGL_mulSingle_transvectionUnit,
      ← diagGL_eq_commutatorElement_transvectionWeylElement, hb, hc]
    simp only [mul_assoc, mul_left_comm ((a⁻¹ : Rˣ) : R)]
  rw [hg, pow_three']
  exact Set.mul_mem_mul (Set.mul_mem_mul (commutator_mem_commutatorSet _ _)
    (commutator_mem_commutatorSet _ _)) (commutator_mem_commutatorSet _ _)

/-- **Commutator width of `GL₂` over a local ring.** Over a local ring with a unit `u` such that
`u - 1` is also a unit, every element of `SL₂(R)` is a product of four commutators of `GL₂(R)`.
The hypothesis holds over every local ring in which `2` is a unit, with `u = 2`. -/
theorem _root_.Matrix.SpecialLinearGroup.toGL_mem_commutatorSet_pow_four [IsLocalRing R]
    (g : SL(2, R)) (u : Rˣ) (hu : IsUnit ((u : R) - 1)) :
    SpecialLinearGroup.toGL g ∈ commutatorSet (GL (Fin 2) R) ^ 4 := by
  have hdvd (x : R) : ((u : R) - 1) ∣ x := hu.dvd
  by_cases h00 : IsUnit (g 0 0)
  · exact Set.pow_subset_pow_right (one_mem_commutatorSet _) (by norm_num)
      (g.toGL_mem_commutatorSet_pow_three u h00 (hdvd _) (hdvd _))
  -- Otherwise the lower-left entry is a unit, and `[[1, 1], [0, 1]] g` has a unit corner.
  have hdet : g 0 0 * g 1 1 + -(g 0 1 * g 1 0) = 1 := by
    rw [← sub_eq_add_neg, ← det_fin_two, g.det_coe]
  have h10 : IsUnit (g 1 0) := by
    rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add (hdet ▸ isUnit_one) with h | h
    · exact absurd (isUnit_of_mul_isUnit_left h) h00
    · exact isUnit_of_mul_isUnit_right ((IsUnit.neg_iff _).1 h)
  set t : SL(2, R) := SpecialLinearGroup.transvection (zero_ne_one : (0 : Fin 2) ≠ 1) 1
  have ht : (t * g) 0 0 = g 0 0 + g 1 0 := by
    simp [t, SpecialLinearGroup.coe_mul, SpecialLinearGroup.transvection_coe,
      Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply]
  have htg : IsUnit ((t * g) 0 0) := by
    rw [ht]
    by_contra h
    have hneg : -g 0 0 ∈ nonunits R := mt (IsUnit.neg_iff _).1 h00
    exact IsLocalRing.nonunits_add h hneg (by convert h10 using 1; ring)
  have hg : SpecialLinearGroup.toGL g = transvectionUnit zero_ne_one (-1) * (t * g).toGL := by
    rw [map_mul, ← mul_assoc, toGL_transvection_eq_transvectionUnit, ← transvectionUnit_add,
      neg_add_cancel, transvectionUnit_zero, one_mul]
  obtain ⟨v, hv⟩ := hu
  rw [hg, pow_succ', show (-1 : R) = ((u : R) - 1) * ((v⁻¹ : Rˣ) * -1) by
    rw [← hv, Units.mul_inv_cancel_left], ← commutatorElement_diagGL_mulSingle_transvectionUnit]
  exact Set.mul_mem_mul (commutator_mem_commutatorSet _ _)
    ((t * g).toGL_mem_commutatorSet_pow_three u htg (hdvd _) (hdvd _))

/-- Over a local ring with a unit `u` such that `u - 1` is also a unit, the abstract commutator
subgroup of `GL₂(R)` is exactly the kernel of the determinant. This applies to `ℤ_ℓ` for odd `ℓ`,
with `u = 2`. It fails over `ℤ₂`, where `[[1, 1], [0, 1]]` is not a product of commutators. -/
theorem _root_.Matrix.GeneralLinearGroup.commutator_eq_ker_det_fin_two_of_isLocalRing
    [IsLocalRing R] (u : Rˣ) (hu : IsUnit ((u : R) - 1)) :
    commutator (GL (Fin 2) R) = (GeneralLinearGroup.det : GL (Fin 2) R →* Rˣ).ker := by
  refine le_antisymm (Group.Abelianization.commutator_le_ker _) fun g hg ↦ ?_
  rw [← SpecialLinearGroup.range_toGL_eq_ker_det] at hg
  obtain ⟨s, rfl⟩ := hg
  exact commutatorSet_pow_subset_commutator 4 (s.toGL_mem_commutatorSet_pow_four u hu)

end FinTwo

/-! ## The commutator subgroup of `GL₂(𝔽₂) ≅ S₃` -/

/-- Over a field with two elements, the commutator subgroup of `GL₂(F) ≅ S₃` consists of the
elements whose cube is `1`: the identity and the two elements of order three, which form the
alternating group `A₃`. -/
theorem _root_.Matrix.GeneralLinearGroup.mem_commutator_fin_two_iff_pow_three_eq_one
    {F : Type*} [Field F] (hF : Nat.card F = 2) {x : GL (Fin 2) F} :
    x ∈ commutator (GL (Fin 2) F) ↔ x ^ 3 = 1 := by
  set e := gl2MulEquivPermFinThree hF
  -- Transport along `GL₂(F) ≃* S₃`, whose commutator subgroup is `A₃`.
  have he : (commutator (GL (Fin 2) F)).map e.toMonoidHom = alternatingGroup (Fin 3) := by
    rw [commutator_def, Subgroup.map_commutator, Subgroup.map_top_of_surjective _ e.surjective,
      ← commutator_def, commutator_perm_fin_three_eq_alternatingGroup]
  rw [← Subgroup.mem_map_iff_mem (f := e.toMonoidHom) e.injective, MulEquiv.coe_toMonoidHom, he,
    Equiv.Perm.mem_alternatingGroup, ← e.injective.eq_iff, map_pow, map_one]
  generalize e x = σ
  revert σ
  decide

end

end TauCeti
