module

public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Symplectic.GaussianGeneration
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Symplectic.RootGeneration

/-!
# Generating the symplectic group by root subgroups

Over a field, the standard symplectic group is generated by its positive and negative simple-root
subgroups. This file proves that statement. Along the way it shows that every element of the
diagonal general-linear Levi subgroup, the symplectic diagonal torus, is a product of opposite
long-root elements, so any subgroup containing the opposite long-root subgroups contains it.

For a coordinate `i` and a unit `a`, the rank-one identity

```text
diag(a, a⁻¹) = x₊(a) x₋(-a⁻¹) x₊(a) x₊(-1) x₋(1) x₊(-1)
```

expresses the corresponding diagonal Levi element as a product of long-root elements. Every
point of the diagonal torus is a product of these coordinate elements. The open-cell step and
block Gaussian factorization of
`TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Symplectic.GaussianGeneration` are combined here
with unipotent generation
(`TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Symplectic.UnipotentGeneration`), generation of
the `GL_m` Levi factor from the diagonal torus and difference roots
(`TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Symplectic.Levi`) and the Weyl and
Chevalley root reduction
(`TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Symplectic.RootGeneration`) to prove generation
by the root subgroups, and by the positive and negative simple-root subgroups.

## Main results

* `TauCeti.GLSymplecticFin.leviHom_diagGL_mulSingle`: the rank-one diagonal identity inside the
  symplectic group.
* `TauCeti.GLSymplecticFin.leviHom_diagGL_mem_of_long`: any subgroup containing the opposite
  long-root subgroups contains the entire diagonal Levi subgroup.
* `TauCeti.GLSymplecticFin.eq_top_of_root_subgroups`: all standard root subgroups generate the
  symplectic group over a field.
* `TauCeti.GLSymplecticFin.eq_top_of_adjacent_of_long`: the positive and negative simple-root
  families generate the symplectic group over a field.

## References

* R. W. Carter, *Simple Groups of Lie Type* (1972), §5.2.
* R. Steinberg, *Lectures on Chevalley Groups* (1968), §§3--4.
-/

public section

open Matrix

namespace TauCeti.GLSymplecticFin

universe u

variable {R : Type u} [CommRing R] {m : ℕ}

/-- **A coordinate diagonal Levi element is a product of six long-root elements.** This is the
usual rank-one `SL₂` identity, embedded in the two symplectic coordinates indexed by `i`. -/
theorem leviHom_diagGL_mulSingle (i : Fin m) (a : Rˣ) :
    leviHom (diagGL (Pi.mulSingle i a)) =
      positiveLongRootTransvectionUnit i (a : R) *
        negativeLongRootTransvectionUnit i (-((a⁻¹ : Rˣ) : R)) *
        positiveLongRootTransvectionUnit i (a : R) *
        positiveLongRootTransvectionUnit i (-1) *
        negativeLongRootTransvectionUnit i 1 *
        positiveLongRootTransvectionUnit i (-1) := by
  apply (mulEquivGLSymplectic m R).injective
  apply Subtype.ext
  have hpq : (Sum.inl i : Fin m ⊕ Fin m) ≠ Sum.inr i := Sum.inl_ne_inr
  have hinv :
      (((diagGL (Pi.mulSingle i a))⁻¹ : GL (Fin m) R) : Matrix (Fin m) (Fin m) R) =
        Matrix.diagonal fun j =>
          ((((Pi.mulSingle i a : Fin m → Rˣ) j)⁻¹ : Rˣ) : R) := by
    rw [← map_inv diagGL, diagGL_coe]
    ext r s
    simp [Matrix.diagonal_apply, Pi.mulSingle_apply]
  have hdiag :
      ((GLSymplectic.leviHom (diagGL (Pi.mulSingle i a)) : GLSymplectic (Fin m) R) :
          GL (Fin m ⊕ Fin m) R) =
        (Matrix.SpecialLinearGroup.diag2nUnit hpq a).toGL := by
    apply Matrix.GeneralLinearGroup.ext
    intro r s
    rw [GLSymplectic.coe_leviHom]
    rcases r with r | r <;> rcases s with s | s
    · by_cases hrs : r = s <;> by_cases hri : r = i <;>
        simp_all [Pi.mulSingle_apply]
    · simp
    · simp
    · rw [Matrix.fromBlocks_apply₂₂, Matrix.transpose_apply, hinv]
      by_cases hrs : r = s <;> by_cases hri : r = i <;> by_cases hsi : s = i <;>
        simp_all [Matrix.diagonal_apply, Pi.mulSingle_apply, eq_comm]
  have hpositive (c : R) :
      ((mulEquivGLSymplectic m R (positiveLongRootTransvectionUnit i c) :
          GLSymplectic (Fin m) R) : GL (Fin m ⊕ Fin m) R) =
        transvectionUnit hpq c := by
    rw [coe_mulEquivGLSymplectic, coe_positiveLongRootTransvectionUnit,
      reindexGL_transvectionUnit]
  have hnegative (c : R) :
      ((mulEquivGLSymplectic m R (negativeLongRootTransvectionUnit i c) :
          GLSymplectic (Fin m) R) : GL (Fin m ⊕ Fin m) R) =
        transvectionUnit hpq.symm c := by
    rw [coe_mulEquivGLSymplectic, coe_negativeLongRootTransvectionUnit,
      reindexGL_transvectionUnit]
  -- Expose the underlying general-linear equality so the transported Levi element and root
  -- elements rewrite through their coercion lemmas.
  change
    ((mulEquivGLSymplectic m R
        (leviHom (diagGL (Pi.mulSingle i a))) : GLSymplectic (Fin m) R) :
      GL (Fin m ⊕ Fin m) R) = _
  rw [mulEquivGLSymplectic_leviHom]
  rw [hdiag]
  have hdecomp := congrArg Matrix.SpecialLinearGroup.toGL
    (Matrix.SpecialLinearGroup.diag2nUnit_decompose hpq a)
  simpa only [map_mul, Subgroup.coe_mul, hpositive, hnegative,
    TauCeti.toGL_transvection_eq_transvectionUnit]
    using hdecomp

/-- A subgroup containing both long-root subgroups at every coordinate contains the entire
diagonal general-linear Levi subgroup. -/
theorem leviHom_diagGL_mem_of_long
    (H : Subgroup (GLSymplecticFin m R))
    (hpositive : ∀ (i : Fin m) (c : R), positiveLongRootTransvectionUnit i c ∈ H)
    (hnegative : ∀ (i : Fin m) (c : R), negativeLongRootTransvectionUnit i c ∈ H)
    (s : Fin m → Rˣ) : leviHom (diagGL s) ∈ H := by
  let P : Subgroup (Fin m → Rˣ) := H.comap (leviHom.comp diagGL)
  have hsingle (i : Fin m) : Pi.mulSingle i (s i) ∈ P := by
    rw [Subgroup.mem_comap, MonoidHom.comp_apply, leviHom_diagGL_mulSingle]
    exact H.mul_mem
      (H.mul_mem
        (H.mul_mem
          (H.mul_mem
            (H.mul_mem (hpositive i (s i)) (hnegative i (-(((s i)⁻¹ : Rˣ) : R))))
            (hpositive i (s i)))
          (hpositive i (-1)))
        (hnegative i 1))
      (hpositive i (-1))
  exact Subgroup.mem_comap.mp (Subgroup.pi_mem_of_mulSingle_mem s hsingle)

section Field

variable {K : Type u} [Field K]

/-- **The standard symplectic root subgroups generate the full symplectic group over a field.**
A subgroup containing every standard root subgroup is the whole group. -/
theorem eq_top_of_root_subgroups
    (H : Subgroup (GLSymplecticFin m K))
    (hroot : ∀ (root : RootSubgroupIndex m) (c : Multiplicative K), root.hom c ∈ H) :
    H = ⊤ := by
  have hdiagonal (s : Fin m → Kˣ) : leviHom (diagGL s) ∈ H := by
    apply leviHom_diagGL_mem_of_long H
    · intro i c
      simpa only [RootSubgroupIndex.hom_positiveLong,
        positiveLongRootTransvectionHom_apply, toAdd_ofAdd] using
          hroot (.positiveLong i) (Multiplicative.ofAdd c)
    · intro i c
      simpa only [RootSubgroupIndex.hom_negativeLong,
        negativeLongRootTransvectionHom_apply, toAdd_ofAdd] using
          hroot (.negativeLong i) (Multiplicative.ofAdd c)
  have hdifference : ∀ {i j : Fin m} (hij : i ≠ j) (c : K),
      differenceShortRootUnit hij c ∈ H := by
    intro i j hij c
    simpa only [RootSubgroupIndex.hom_difference, differenceShortRootHom_apply,
      toAdd_ofAdd] using
      hroot (.difference i j hij) (Multiplicative.ofAdd c)
  have hupper := Submonoid.upperUnipotent_mem_of_root_subgroups_hom H.toSubmonoid hroot
  have hlower := Submonoid.lowerUnipotent_mem_of_root_subgroups_hom H.toSubmonoid hroot
  have hlevi : ∀ A : GL (Fin m) K, leviHom A ∈ H :=
    leviHom_mem_of_difference_of_diagonal H hdifference hdiagonal
  -- An upper unipotent moves any element onto the open cell, where block Gaussian elimination
  -- (`mem_of_isUnit_toBlocks₁₁`) concludes.
  refine eq_top_iff.mpr fun g _ ↦ ?_
  obtain ⟨X, hX, hunit⟩ := exists_isSymm_isUnit_toBlocks₁₁_upperUnipotent_mul g
  have hprod : upperUnipotent X hX * g ∈ H :=
    mem_of_isUnit_toBlocks₁₁ H hupper hlower hlevi _ hunit
  simpa only [inv_mul_cancel_left] using H.mul_mem (H.inv_mem (hupper X hX)) hprod

/-- **The positive and negative simple-root families generate the standard symplectic group over
a field.** It is enough to contain both orientations of the adjacent difference roots and one
positive and negative long-root subgroup. Taking the terminal coordinate gives the Bourbaki
simple roots of type `C`. -/
theorem eq_top_of_adjacent_of_long
    (H : Subgroup (GLSymplecticFin m K)) (r : Fin m)
    (hadjacent : ∀ {i j : Fin m} (hij : i ≠ j) (c : K),
      i.val + 1 = j.val ∨ j.val + 1 = i.val → differenceShortRootUnit hij c ∈ H)
    (hpositive : ∀ c : K, positiveLongRootTransvectionUnit r c ∈ H)
    (hnegative : ∀ c : K, negativeLongRootTransvectionUnit r c ∈ H) : H = ⊤ := by
  apply eq_top_of_root_subgroups H
  exact RootSubgroupIndex.hom_apply_mem_of_adjacent_of_long
    H r hadjacent hpositive hnegative

end Field

end TauCeti.GLSymplecticFin
