/-!
# The cokernel of the Mayer–Vietoris map of algebraic `K₁`

Let `π₁ : A₁ →+* Q` and `π₂ : A₂ →+* Q` be homomorphisms of commutative rings. The Mayer–Vietoris
map of algebraic `K₁` is

```text
g₁ : K₁(A₁) × K₁(A₂) → K₁(Q),   (x, y) ↦ π₁(x) · π₂(y)⁻¹,
```

and for a Milnor square, the fibre product `D = A₁ ×_Q A₂` with one surjective leg, its cokernel
`K₁(Q) ⧸ im g₁` is the part of the Mayer–Vietoris sequence that the boundary `K₁(Q) → K₀(D)`
carries onto the kernel of `K₀(D) → K₀(A₁) × K₀(A₂)`.

The determinant `K₁(R) → Rˣ` of a commutative ring is onto and natural in ring homomorphisms, so
it carries `im g₁` onto the subgroup of `Qˣ` generated by the images of the unit groups `A₁ˣ` and
`A₂ˣ` (`TauCeti.AlgebraicK1.map_det_range_mayerVietoris`). When `SK₁(Q)` vanishes, for instance
when `Q` is semilocal, the determinant is an isomorphism and

```text
K₁(Q) ⧸ im g₁ ≃* Qˣ ⧸ (π₁(A₁ˣ) · π₂(A₂ˣ)).
```

This computes the cokernel for the two Milnor squares of integers and of polynomials that
serve as the standard examples of the Mayer–Vietoris sequence.

* The **arithmetic square** `ℤ → ℤ/n ← ℤ`, two copies of reduction modulo `n`, whose fibre product
  is the ring of pairs of integers congruent modulo `n`. The units of `ℤ` are `±1`, and
  `SK₁(ℤ/n) = 1`, so the cokernel is `(ℤ/n)ˣ ⧸ {±1}`. For `n = 5` this is cyclic of order two,
  the class of `x` being trivial exactly when `det x = ±1`.
* The **cusp square** `k[t] → k[t] ⧸ (t²) ← k` over a field `k`, reduction and the constants,
  whose fibre product is the cusp `k[t², t³]`; only the first leg is surjective. The units of
  `k[t]` are the nonzero constants, and `k[t] ⧸ (t²)` is the local ring of dual numbers `k[ε]`,
  so the cokernel is the group `(k[ε])ˣ ⧸ kˣ`, which is the additive group of `k` through
  `a + b t ↦ b / a`. For `k = 𝔽₅` it is cyclic of order five, generated by the class of `1 + t`.

## Main definitions

* `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquiv`: when `SK₁(Q) = 1`, the isomorphism
  `K₁(Q) ⧸ im g₁ ≃* Qˣ ⧸ (π₁(A₁ˣ) ⊔ π₂(A₂ˣ))` induced by the determinant.
* `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquivZMod n`: for the arithmetic square,
  `K₁(ℤ/n) ⧸ im g₁ ≃* (ℤ/n)ˣ ⧸ {±1}`.
* `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquivZModFive`: for `n = 5`,
  `K₁(𝔽₅) ⧸ im g₁ ≃* ℤ/2`, written multiplicatively.
* `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquivCusp k`: for the cusp square,
  `K₁(k[t] ⧸ (t²)) ⧸ im g₁ ≃* k`, written multiplicatively.

## Main results

* `TauCeti.AlgebraicK1.map_det_range_mayerVietoris`: the determinant carries `im g₁` onto
  `π₁(A₁ˣ) ⊔ π₂(A₂ˣ)`.
* `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquivZModFive_mk_eq_one_iff`: a class of
  `K₁(𝔽₅)` is trivial in the cokernel exactly when its determinant is `±1`.
* `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquivCusp_mk_ofUnits`: the class of a unit
  `a + b t` of `k[t] ⧸ (t²)` goes to `b / a`.
* `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquivCusp_symm_apply`: the inverse sends `b` to
  the class of the unit `1 + b t`.

## References

* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter III, Theorem 2.6 (the Mayer–Vietoris sequence of a Milnor
  square), and Chapter II, Example 2.9.1 (`K₀` of the cusp over a field).
-/

public section

noncomputable section

open Polynomial

namespace TauCeti.AlgebraicK1

section MayerVietoris

variable {A₁ A₂ Q : Type*} [CommRing A₁] [CommRing A₂] [CommRing Q] (π₁ : A₁ →+* Q)
  (π₂ : A₂ →+* Q)

/-- The determinant carries the image of the Mayer–Vietoris map
`(x, y) ↦ π₁(x) · π₂(y)⁻¹ : K₁(A₁) × K₁(A₂) → K₁(Q)` onto the subgroup of `Qˣ` generated by the
images of the unit groups of `A₁` and `A₂`. -/
theorem map_det_range_mayerVietoris :
    ((map π₁).comp (MonoidHom.fst _ _) / (map π₂).comp (MonoidHom.snd _ _)).range.map (det Q) =
      (Units.map (π₁ : A₁ →* Q)).range ⊔ (Units.map (π₂ : A₂ →* Q)).range := by
  refine le_antisymm ?_ (sup_le ?_ ?_)
  · rintro _ ⟨_, ⟨⟨x, y⟩, rfl⟩, rfl⟩
    simp only [MonoidHom.div_apply, MonoidHom.coe_comp, Function.comp_apply, MonoidHom.coe_fst,
      MonoidHom.coe_snd, _root_.map_div, det_map]
    exact div_mem (Subgroup.mem_sup_left (MonoidHom.mem_range.2 ⟨_, rfl⟩))
      (Subgroup.mem_sup_right (MonoidHom.mem_range.2 ⟨_, rfl⟩))
  · rintro _ ⟨u, rfl⟩
    exact ⟨_, ⟨(ofUnits A₁ u, 1), rfl⟩, by simp [det_ofUnits]⟩
  · rintro _ ⟨u, rfl⟩
    exact ⟨_, ⟨(1, ofUnits A₂ u⁻¹), rfl⟩, by simp [det_ofUnits]⟩

/-- **The cokernel of the Mayer–Vietoris map of `K₁`.** When `SK₁(Q)` vanishes, the determinant
identifies the cokernel of `(x, y) ↦ π₁(x) · π₂(y)⁻¹ : K₁(A₁) × K₁(A₂) → K₁(Q)` with the units of
`Q` modulo the images of the units of `A₁` and `A₂`. -/
def quotientMayerVietorisRangeEquiv (hQ : specialAlgebraicK1 Q = ⊥) :
    AlgebraicK1 Q ⧸ ((map π₁).comp (MonoidHom.fst _ _) / (map π₂).comp (MonoidHom.snd _ _)).range ≃*
      Qˣ ⧸ ((Units.map (π₁ : A₁ →* Q)).range ⊔ (Units.map (π₂ : A₂ →* Q)).range) :=
  QuotientGroup.congr _ _ (detEquiv hQ) (by
    rw [show ((detEquiv hQ : AlgebraicK1 Q ≃* Qˣ) : AlgebraicK1 Q →* Qˣ) = det Q from
      MonoidHom.ext (detEquiv_apply hQ)]
    exact map_det_range_mayerVietoris π₁ π₂)

/-- `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquiv` sends the class of `x` to the class of
its determinant. -/
@[simp]
theorem quotientMayerVietorisRangeEquiv_mk (hQ : specialAlgebraicK1 Q = ⊥) (x : AlgebraicK1 Q) :
    quotientMayerVietorisRangeEquiv π₁ π₂ hQ x = (det Q x : Qˣ ⧸ _) := by
  rw [quotientMayerVietorisRangeEquiv, QuotientGroup.congr_mk, detEquiv_apply]

/-- The inverse of `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquiv` sends the class of a unit
`u` to the class of the `1 × 1` matrix `(u)`. -/
@[simp]
theorem quotientMayerVietorisRangeEquiv_symm_mk (hQ : specialAlgebraicK1 Q = ⊥) (u : Qˣ) :
    (quotientMayerVietorisRangeEquiv π₁ π₂ hQ).symm u = (ofUnits Q u : AlgebraicK1 Q ⧸ _) := by
  rw [MulEquiv.symm_apply_eq, quotientMayerVietorisRangeEquiv_mk, det_ofUnits]

end MayerVietoris

section Arithmetic

/-- **The arithmetic square.** For the Milnor square `ℤ → ℤ/n ← ℤ` of two reductions modulo `n`,
the cokernel of the Mayer–Vietoris map `K₁(ℤ) × K₁(ℤ) → K₁(ℤ/n)` is `(ℤ/n)ˣ ⧸ {±1}`, through the
determinant. -/
def quotientMayerVietorisRangeEquivZMod (n : ℕ) :
    AlgebraicK1 (ZMod n) ⧸ ((map (Int.castRingHom (ZMod n))).comp (MonoidHom.fst _ _) /
      (map (Int.castRingHom (ZMod n))).comp (MonoidHom.snd _ _)).range ≃*
      (ZMod n)ˣ ⧸ Subgroup.zpowers (-1) :=
  (quotientMayerVietorisRangeEquiv _ _ (specialAlgebraicK1_zmod_eq_bot n)).trans
    (QuotientGroup.quotientMulEquivOfEq (by
      rw [sup_idem, Int.range_unitsMap_castRingHom]))

/-- `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquivZMod` sends the class of `x` to the class
of its determinant. -/
@[simp]
theorem quotientMayerVietorisRangeEquivZMod_mk (n : ℕ) (x : AlgebraicK1 (ZMod n)) :
    quotientMayerVietorisRangeEquivZMod n x = (det (ZMod n) x : (ZMod n)ˣ ⧸ _) := by
  rw [quotientMayerVietorisRangeEquivZMod, MulEquiv.trans_apply,
    quotientMayerVietorisRangeEquiv_mk, QuotientGroup.quotientMulEquivOfEq_mk]

/-- The inverse of `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquivZMod` sends the class of a
unit `u` to the class of the `1 × 1` matrix `(u)`. -/
@[simp]
theorem quotientMayerVietorisRangeEquivZMod_symm_mk (n : ℕ) (u : (ZMod n)ˣ) :
    (quotientMayerVietorisRangeEquivZMod n).symm u =
      (ofUnits (ZMod n) u : AlgebraicK1 (ZMod n) ⧸ _) := by
  rw [MulEquiv.symm_apply_eq, quotientMayerVietorisRangeEquivZMod_mk, det_ofUnits]

/-- **The arithmetic square over `𝔽₅`.** For `ℤ → 𝔽₅ ← ℤ`, the cokernel of the Mayer–Vietoris
map `K₁(ℤ) × K₁(ℤ) → K₁(𝔽₅)` is cyclic of order two: `𝔽₅ˣ ⧸ {±1} ≅ ℤ/2`, the classes of `2` and
`3 = 2⁻¹` being its generator. An isomorphism onto `ℤ/2` is unique. -/
def quotientMayerVietorisRangeEquivZModFive :
    AlgebraicK1 (ZMod 5) ⧸ ((map (Int.castRingHom (ZMod 5))).comp (MonoidHom.fst _ _) /
      (map (Int.castRingHom (ZMod 5))).comp (MonoidHom.snd _ _)).range ≃*
      Multiplicative (ZMod 2) :=
  (quotientMayerVietorisRangeEquivZMod 5).trans (mulEquivOfPrimeCardEq (p := 2) (by
    -- `{±1}` has index two in the cyclic group `𝔽₅ˣ` of order four.
    have h := Subgroup.card_eq_card_quotient_mul_card_subgroup
      (Subgroup.zpowers (-1 : (ZMod 5)ˣ))
    rw [Nat.card_zpowers, orderOf_eq_prime (p := 2) (by decide) (by decide),
      Nat.card_eq_fintype_card (α := (ZMod 5)ˣ), show Fintype.card (ZMod 5)ˣ = 4 by decide] at h
    omega) (by simp))

/-- A class of `K₁(𝔽₅)` vanishes in the cokernel of the Mayer–Vietoris map of the arithmetic square
exactly when its determinant is `±1`, the image of a unit of `ℤ`. -/
theorem quotientMayerVietorisRangeEquivZModFive_mk_eq_one_iff (x : AlgebraicK1 (ZMod 5)) :
    quotientMayerVietorisRangeEquivZModFive x = 1 ↔ det (ZMod 5) x = 1 ∨ det (ZMod 5) x = -1 := by
  rw [quotientMayerVietorisRangeEquivZModFive, MulEquiv.trans_apply, MulEquiv.map_eq_one_iff,
    quotientMayerVietorisRangeEquivZMod_mk, QuotientGroup.eq_one_iff,
    Subgroup.mem_zpowers_neg_one_iff]

end Arithmetic

section Cusp

variable (k : Type*) [Field k]

/-- The units of `k[X]` are the nonzero constants, so their images in `k[X] ⧸ (X²)` are among the
images of the units of `k`. -/
private theorem sup_range_unitsMap_cusp :
    (Units.map (Ideal.Quotient.mk (Ideal.span {(X : k[X]) ^ 2}) :
        k[X] →* k[X] ⧸ Ideal.span {(X : k[X]) ^ 2})).range ⊔
        (Units.map (algebraMap k (k[X] ⧸ Ideal.span {(X : k[X]) ^ 2}) :
          k →* k[X] ⧸ Ideal.span {(X : k[X]) ^ 2})).range =
      (Units.map (algebraMap k (k[X] ⧸ Ideal.span {(X : k[X]) ^ 2}) :
        k →* k[X] ⧸ Ideal.span {(X : k[X]) ^ 2})).range := by
  refine sup_eq_right.2 ?_
  rintro _ ⟨u, rfl⟩
  obtain ⟨a, ha, hau⟩ := Polynomial.isUnit_iff.1 u.isUnit
  refine ⟨ha.unit, Units.ext ?_⟩
  simp [← hau, ← Ideal.Quotient.mk_algebraMap]

/-- The identification `k[X] ⧸ (X²) ≃ₐ[k] k[ε]` matches the scalar units on both sides. -/
private theorem map_range_unitsMap_algebraMap_cusp :
    (Units.map (algebraMap k (k[X] ⧸ Ideal.span {(X : k[X]) ^ 2}) :
        k →* k[X] ⧸ Ideal.span {(X : k[X]) ^ 2})).range.map
        (Units.mapEquiv (dualNumberPolynomialQuotientAlgEquiv k).toMulEquiv :
          (k[X] ⧸ Ideal.span {(X : k[X]) ^ 2})ˣ →* (DualNumber k)ˣ) =
      (Units.map (algebraMap k (DualNumber k) : k →* DualNumber k)).range := by
  rw [MonoidHom.map_range]
  congr 1
  refine MonoidHom.ext fun u ↦ Units.ext ?_
  simp

/-- **The cusp square.** For the Milnor square `k[X] → k[X] ⧸ (X²) ← k` over a field `k`, whose
fibre product is the cusp `k[X², X³]`, the cokernel of the Mayer–Vietoris map
`K₁(k[X]) × K₁(k) → K₁(k[X] ⧸ (X²))` is the additive group of `k`, written multiplicatively: the
class of a unit `a + bX` goes to `b / a`. -/
def quotientMayerVietorisRangeEquivCusp :
    AlgebraicK1 (k[X] ⧸ Ideal.span {(X : k[X]) ^ 2}) ⧸
      ((map (Ideal.Quotient.mk (Ideal.span {(X : k[X]) ^ 2}))).comp (MonoidHom.fst _ _) /
        (map (algebraMap k (k[X] ⧸ Ideal.span {(X : k[X]) ^ 2}))).comp
          (MonoidHom.snd _ _)).range ≃*
      Multiplicative k :=
  ((quotientMayerVietorisRangeEquiv _ _ (specialAlgebraicK1_eq_bot_of_hasStableRangeLE_one
      (hasStableRangeLE_one_of_isLocalRing _))).trans
    (QuotientGroup.quotientMulEquivOfEq (sup_range_unitsMap_cusp k))).trans
    ((QuotientGroup.congr _ _
      (Units.mapEquiv (dualNumberPolynomialQuotientAlgEquiv k).toMulEquiv)
      (map_range_unitsMap_algebraMap_cusp k)).trans (dualNumberUnitsQuotientEquiv k))

/-- `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquivCusp` sends the class of a unit of
`k[X] ⧸ (X²)` represented by a polynomial `p`, that is by `a + bX` with `a = p₀` and `b = p₁`, to
`b / a`. -/
theorem quotientMayerVietorisRangeEquivCusp_mk_ofUnits
    (u : (k[X] ⧸ Ideal.span {(X : k[X]) ^ 2})ˣ) {p : k[X]}
    (hp : Ideal.Quotient.mk (Ideal.span {(X : k[X]) ^ 2}) p = u) :
    quotientMayerVietorisRangeEquivCusp k (ofUnits _ u) =
      Multiplicative.ofAdd (p.coeff 1 / p.coeff 0) := by
  simp only [quotientMayerVietorisRangeEquivCusp, MulEquiv.trans_apply,
    quotientMayerVietorisRangeEquiv_mk, det_ofUnits, QuotientGroup.quotientMulEquivOfEq_mk,
    QuotientGroup.congr_mk, dualNumberUnitsQuotientEquiv_mk]
  set v := Units.mapEquiv (dualNumberPolynomialQuotientAlgEquiv k).toMulEquiv u
  have hv : (v : DualNumber k) = aeval DualNumber.eps p := by
    simp [v, ← hp]
  have hinv : TrivSqZeroExt.fst ((v⁻¹ : (DualNumber k)ˣ) : DualNumber k) = (p.coeff 0)⁻¹ := by
    refine eq_inv_of_mul_eq_one_right ?_
    rw [← (show TrivSqZeroExt.fst (v : DualNumber k) = p.coeff 0 by simp [hv])]
    exact dualNumber_fst_mul_fst_inv v
  rw [hinv, hv, DualNumber.snd_aeval_eps, Algebra.algebraMap_self, RingHom.id_apply,
    div_eq_mul_inv]

/-- The inverse of `TauCeti.AlgebraicK1.quotientMayerVietorisRangeEquivCusp` sends `b` to the class
of the unit `1 + bX` of `k[X] ⧸ (X²)`, the image of the unit `1 + bε` of `k[ε]`. -/
@[simp]
theorem quotientMayerVietorisRangeEquivCusp_symm_apply (b : Multiplicative k) :
    (quotientMayerVietorisRangeEquivCusp k).symm b =
      (ofUnits _ (Units.mapEquiv (dualNumberPolynomialQuotientAlgEquiv k).symm.toMulEquiv
        (dualNumberUnit b.toAdd)) : AlgebraicK1 _ ⧸ _) := by
  rw [MulEquiv.symm_apply_eq,
    quotientMayerVietorisRangeEquivCusp_mk_ofUnits k _ (p := 1 + C b.toAdd * X)]
  · simp [coeff_one]
  · simp [DualNumber.dualNumberPolynomialQuotientAlgEquiv_symm_apply]

end Cusp

end TauCeti.AlgebraicK1
