/-!
# Steinberg symbols, the diagonal subgroup and the Matsumoto group

Let `R` be a commutative ring. The **diagonal subgroup** `H ⊆ St(R)` of the Steinberg group is
generated by the diagonal elements `h_{ij}(u)`, which lift the diagonal matrices with `u` at `i`
and `u⁻¹` at `j`. This file proves that **every element of `K₂(R)` lying in `H` is a product of
Steinberg symbols** `{u, v}` (Milnor, §9; Steinberg). For a field `F` it constructs the symbol
homomorphism `MatsumotoGroup F →+ K₂(F)`, `{x, y} ↦ {x, y}`, the map of Matsumoto's theorem, and
identifies its range with the subgroup of `K₂(F)` generated by the Steinberg symbols, so every
element of `K₂(F) ∩ H` is in its range.

The proof works modulo the subgroup `S ⊆ St(R)` generated by the Steinberg symbols, which is
central because `K₂(R)` is. First, the commutator `⁅h_{ij}(u), h_{ik}(v)⁆` for any pairwise distinct
indices is the symbol `{u, v}`: conjugating by a permutation matrix moves `(i, j, k)` to
`(0, 1, 2)`, and star products are invariant under conjugation. Hence modulo `S` each `h_{ij}` is
multiplicative, `h_{ji}(u) ≡ h_{ij}(u⁻¹)`, and, from the identity
`h_{ik}(-u) h_{ik}(-1)⁻¹ = h_{jk}(u⁻¹)⁻¹ h_{ij}(u)` obtained by conjugating with the Weyl element
`w_{jk}(1)`, also `h_{ik}(u) ≡ h_{jk}(u) h_{ij}(u)`. So modulo `S` every element of `H` is a product
`∏_{k ≠ 0} h_{k0}(d_k)` of pairwise commuting factors. Its image in `GL_∞(R)` is the diagonal matrix
with entries `d_k` at `k ≠ 0`, so if the element lies in `K₂(R)` then every `d_k = 1`, and the
element lies in `S`.

## Main definitions

* `TauCeti.SteinbergGroup.diagonalSubgroup`: the subgroup of `St(R)` generated by the diagonal
  elements `h_{ij}(u)`.
* `TauCeti.AlgebraicK2.symbolSubgroup`: the subgroup of `K₂(R)` generated by the Steinberg symbols.
* `TauCeti.MatsumotoGroup.toAlgebraicK2`: for a field `F`, the homomorphism
  `MatsumotoGroup F →+ K₂(F)` sending `{x, y}` to the Steinberg symbol `{x, y}`.

## Main results

* `TauCeti.SteinbergGroup.commutatorElement_h_h_eq_steinbergSymbol`: for pairwise distinct
  `i, j, k`, `⁅h_{ij}(u), h_{ik}(v)⁆ = {u, v}`.
* `TauCeti.AlgebraicK2.mem_symbolSubgroup_of_mem_diagonalSubgroup`: an element of `K₂(R)` in the
  diagonal subgroup is a product of Steinberg symbols.
* `TauCeti.MatsumotoGroup.range_toAlgebraicK2`: the range of the symbol homomorphism is the
  subgroup generated by the Steinberg symbols.
* `TauCeti.MatsumotoGroup.mem_range_toAlgebraicK2_of_mem_diagonalSubgroup`: every element of
  `K₂(F)` in the diagonal subgroup is in the range of the symbol homomorphism.

## References

* J. Milnor, *Introduction to Algebraic K-Theory*, Annals of Mathematics Studies 72 (1971), §9.
* R. Steinberg, *Générateurs, relations et revêtements de groupes algébriques*, Colloque sur la
  théorie des groupes algébriques (Bruxelles, 1962).
* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter III, §5 and Theorem 6.1.
-/

public section

noncomputable section

open Matrix

open scoped commutatorElement

namespace TauCeti

/-! ## The diagonal subgroup -/

namespace SteinbergGroup

open IndexedSteinbergGroup

section Ring

variable (R : Type*) [Ring R]

/-- The **diagonal subgroup** of the Steinberg group `St(R)`: the subgroup generated by the
diagonal elements `h_{ij}(u)`, which lift the diagonal matrices with `u` at `i`, `u⁻¹` at `j` and
`1` elsewhere. -/
def diagonalSubgroup : Subgroup (SteinbergGroup R) :=
  Subgroup.closure {g | ∃ (i j : ℕ) (hij : i ≠ j) (u : Rˣ), h hij u = g}

variable {R}

/-- Each diagonal element `h_{ij}(u)` lies in the diagonal subgroup. -/
@[simp]
theorem h_mem_diagonalSubgroup {i j : ℕ} (hij : i ≠ j) (u : Rˣ) :
    h hij u ∈ diagonalSubgroup R :=
  Subgroup.subset_closure ⟨i, j, hij, u, rfl⟩

/-- A subgroup of `St(R)` contains the diagonal subgroup exactly when it contains every
`h_{ij}(u)`. -/
theorem diagonalSubgroup_le_iff {H : Subgroup (SteinbergGroup R)} :
    diagonalSubgroup R ≤ H ↔ ∀ ⦃i j : ℕ⦄ (hij : i ≠ j) (u : Rˣ), h hij u ∈ H := by
  refine (Subgroup.closure_le _).trans ⟨fun hH i j hij u ↦ hH ⟨i, j, hij, u, rfl⟩, ?_⟩
  rintro hH _ ⟨i, j, hij, u, rfl⟩
  exact hH hij u

/-! ## Symbols at arbitrary indices -/

/-- Conjugating the image in `GL_∞(R)` of `h_{ab}(w)` by the permutation matrix of `σ` gives the
image of `h_{σ a, σ b}(w)`. -/
private theorem conj_toStableGL_h {n : ℕ} (σ : Equiv.Perm (Fin n)) {a b : Fin n} (hab : a ≠ b)
    (w : Rˣ) :
    StableGeneralLinearGroup.of R n (permutationGL σ) *
        toStableGL R (h (Fin.val_ne_of_ne hab) w) *
        (StableGeneralLinearGroup.of R n (permutationGL σ))⁻¹ =
      toStableGL R (h (Fin.val_ne_of_ne (σ.injective.ne hab)) w) := by
  rw [toStableGL_h _ w a.isLt b.isLt, toStableGL_h _ w (σ a).isLt (σ b).isLt, ← map_inv,
    ← map_mul, ← map_mul, permutationGL_mul_diagGL_mul_inv]
  congr 2
  ext m : 1
  simp only [Fin.eta, Pi.mul_apply, Pi.mulSingle_apply, Equiv.Perm.inv_eq_iff_eq]

/-- **Symbols at arbitrary indices.** For pairwise distinct `i, j, k` and commuting units `u` and
`v`, the commutator of the diagonal elements `h_{ij}(u)` and `h_{ik}(v)` is the Steinberg symbol
`{u, v}`. -/
theorem commutatorElement_h_h_eq_steinbergSymbol {i j k : ℕ} (hij : i ≠ j) (hik : i ≠ k)
    (hjk : j ≠ k) {u v : Rˣ} (huv : Commute u v) :
    ⁅h hij u, h hik v⁆ = (steinbergSymbol u v huv : SteinbergGroup R) := by
  set n := max i (max j k) + 1
  -- A permutation `σ` of `Fin n` sending `i, j, k` to `0, 1, 2`.
  let e₁ : Fin 3 → Fin n := ![⟨i, by omega⟩, ⟨j, by omega⟩, ⟨k, by omega⟩]
  let e₂ : Fin 3 → Fin n := ![⟨0, by omega⟩, ⟨1, by omega⟩, ⟨2, by omega⟩]
  have he₁ : Function.Injective e₁ := by
    intro a b hab
    fin_cases a <;> fin_cases b <;> simp [e₁, Fin.ext_iff] at hab ⊢ <;> omega
  have he₂ : Function.Injective e₂ := by
    intro a b hab
    fin_cases a <;> fin_cases b <;> simp_all [e₂, Fin.ext_iff]
  obtain ⟨σ, hσ⟩ := Equiv.Perm.exists_extending_pair e₁ e₂ he₁ he₂
  let g := StableGeneralLinearGroup.of R n (permutationGL σ)
  -- Conjugation by `g` turns `h_{ij}(u)` and `h_{ik}(v)` into `h_{01}(u)` and `h_{02}(v)`.
  have hconj {a b : Fin 3} (hab : a ≠ b) (w : Rˣ) :
      toElementarySubgroup R (h (Fin.val_ne_of_ne (he₂.ne hab)) w) =
        MulAut.conjNormal g (toElementarySubgroup R (h (Fin.val_ne_of_ne (he₁.ne hab)) w)) := by
    refine Subtype.ext ?_
    rw [MulAut.conjNormal_apply, coe_toElementarySubgroup, coe_toElementarySubgroup,
      conj_toStableGL_h σ (he₁.ne hab) w]
    exact congrArg _ (h_congr (congrArg Fin.val (hσ a).symm) (congrArg Fin.val (hσ b).symm) rfl)
  -- The images of `h_{ij}(u)` and `h_{ik}(v)` are commuting diagonal matrices.
  have hcomm : Commute (toElementarySubgroup R (h hij u)) (toElementarySubgroup R (h hik v)) := by
    refine Commute.of_map (f := Subgroup.subtype _) Subtype.coe_injective ?_
    rw [Subgroup.coe_subtype, coe_toElementarySubgroup, coe_toElementarySubgroup,
      toStableGL_h hij u (n := n) (by omega) (by omega),
      toStableGL_h hik v (n := n) (by omega) (by omega)]
    refine ((Pi.commute_iff.2 fun m ↦ ?_).map diagGL).map _
    simp only [Pi.mul_apply, Pi.mulSingle_apply, Fin.ext_iff]
    split_ifs <;> simp_all [huv.inv_left]
  calc ⁅h hij u, h hik v⁆
      = (AlgebraicK2.starProduct _ _ hcomm : SteinbergGroup R) :=
        (AlgebraicK2.coe_starProduct_toElementarySubgroup hcomm).symm
    _ = (AlgebraicK2.starProduct _ _ (hcomm.map (MulAut.conjNormal g)) : SteinbergGroup R) := by
        rw [AlgebraicK2.starProduct_conjNormal]
    _ = ⁅h (by decide : (0 : ℕ) ≠ 1) u, h (by decide : (0 : ℕ) ≠ 2) v⁆ :=
        AlgebraicK2.coe_starProduct_eq_commutatorElement _
          (hconj (a := 0) (b := 1) (by decide) u) (hconj (a := 0) (b := 2) (by decide) v)
    _ = (steinbergSymbol u v huv : SteinbergGroup R) :=
        (coe_steinbergSymbol_eq_commutatorElement_h _).symm

end Ring

end SteinbergGroup

/-! ## The subgroup generated by the Steinberg symbols -/

namespace AlgebraicK2

variable (R : Type*) [CommRing R]

/-- The subgroup of `K₂(R)` generated by the Steinberg symbols `{u, v}` of units of the
commutative ring `R`. -/
def symbolSubgroup : Subgroup (AlgebraicK2 R) :=
  Subgroup.closure (Set.range fun p : Rˣ × Rˣ ↦ steinbergSymbol p.1 p.2 (Commute.all _ _))

variable {R}

/-- Each Steinberg symbol lies in the symbol subgroup. -/
@[simp]
theorem steinbergSymbol_mem_symbolSubgroup {u v : Rˣ} (h : Commute u v) :
    steinbergSymbol u v h ∈ symbolSubgroup R :=
  Subgroup.subset_closure ⟨(u, v), rfl⟩

/-- A subgroup of `K₂(R)` contains the symbol subgroup exactly when it contains every Steinberg
symbol. -/
theorem symbolSubgroup_le_iff {H : Subgroup (AlgebraicK2 R)} :
    symbolSubgroup R ≤ H ↔ ∀ u v : Rˣ, steinbergSymbol u v (Commute.all u v) ∈ H := by
  refine (Subgroup.closure_le _).trans ⟨fun hH u v ↦ hH ⟨(u, v), rfl⟩, ?_⟩
  rintro hH _ ⟨⟨u, v⟩, rfl⟩
  exact hH u v

end AlgebraicK2

/-! ## The diagonal subgroup modulo symbols -/

namespace SteinbergGroup

open IndexedSteinbergGroup

variable {R : Type*} [CommRing R]

/-- The normal subgroup of `St(R)` generated by the Steinberg symbols. -/
private def symbolNormal (R : Type*) [CommRing R] : Subgroup (SteinbergGroup R) :=
  (AlgebraicK2.symbolSubgroup R).map (toStableGL R).ker.subtype

private theorem symbolNormal_le_ker : symbolNormal R ≤ (toStableGL R).ker := by
  rintro _ ⟨y, -, rfl⟩
  exact y.property

private instance : (symbolNormal R).Normal :=
  Subgroup.normal_of_le_center (symbolNormal_le_ker.trans ker_toStableGL_le_center)

/-- The quotient map `St(R) →* St(R) / S` by the subgroup `S` generated by the symbols. -/
private abbrev mkSymbol : SteinbergGroup R →* SteinbergGroup R ⧸ symbolNormal R :=
  QuotientGroup.mk' _

private theorem mkSymbol_commutatorElement_h_h {i j k : ℕ} (hij : i ≠ j) (hik : i ≠ k)
    (hjk : j ≠ k) (u v : Rˣ) : mkSymbol ⁅h hij u, h hik v⁆ = 1 := by
  rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff,
    commutatorElement_h_h_eq_steinbergSymbol hij hik hjk (Commute.all u v)]
  exact Subgroup.mem_map_of_mem _ (AlgebraicK2.steinbergSymbol_mem_symbolSubgroup _)

/-- Modulo the symbols, `h_{ij}` is multiplicative. -/
private theorem mkSymbol_h_mul {i j : ℕ} (hij : i ≠ j) (u v : Rˣ) :
    mkSymbol (h hij (u * v)) = mkSymbol (h hij u) * mkSymbol (h hij v) := by
  have hik : i ≠ i + j + 1 := by omega
  have hjk : j ≠ i + j + 1 := by omega
  rw [mul_comm u v, h_mul hij hik hjk, map_mul, map_mul, map_inv,
    mkSymbol_commutatorElement_h_h hij hik hjk, inv_one, one_mul]

private theorem mkSymbol_h_inv {i j : ℕ} (hij : i ≠ j) (u : Rˣ) :
    mkSymbol (h hij u⁻¹) = (mkSymbol (h hij u))⁻¹ := by
  rw [eq_inv_iff_mul_eq_one, ← mkSymbol_h_mul, inv_mul_cancel, h_one, map_one]

/-- Modulo the symbols, `h_{ji}(u) ≡ h_{ij}(u⁻¹)`. -/
private theorem mkSymbol_h_symm {i j : ℕ} (hij : i ≠ j) (u : Rˣ) :
    mkSymbol (h hij.symm u) = mkSymbol (h hij u⁻¹) := by
  have hik : i ≠ i + j + 1 := by omega
  have hjk : j ≠ i + j + 1 := by omega
  have hw : w hij.symm u = w hij (-u⁻¹) := by
    rw [← w_symm_neg_inv hij hik hjk (-u⁻¹), inv_neg, inv_inv, neg_neg]
  have hw₁ : w hij.symm (-1 : Rˣ) = w hij 1 := by
    rw [← w_symm_neg_inv hij hik hjk (1 : Rˣ), inv_one]
  rw [h_def, hw, hw₁, w_mul_w, map_mul, map_inv, show (-u⁻¹ : Rˣ) = u⁻¹ * -1 from
    (mul_neg_one _).symm, mkSymbol_h_mul, mul_inv_cancel_right]

/-- Modulo the symbols, `h_{mb}(u) ≡ h_{ab}(u) h_{ma}(u)` for pairwise distinct `m, a, b`. -/
private theorem mkSymbol_h_eq_mul {a b m : ℕ} (hab : a ≠ b) (hma : m ≠ a) (hmb : m ≠ b)
    (u : Rˣ) :
    mkSymbol (h hmb u) = mkSymbol (h hab u) * mkSymbol (h hma u) := by
  have key := congrArg mkSymbol (h_neg_mul_h_neg_one_inv hma hmb hab u)
  rwa [map_mul, map_mul, map_inv, map_inv, mkSymbol_h_inv, inv_inv,
    show (-u : Rˣ) = u * -1 from (mul_neg_one u).symm, mkSymbol_h_mul, mul_inv_cancel_right] at key

/-- The homomorphism `u ↦ h_{k0}(u)` modulo the symbols, for `k ≠ 0`; it is trivial for `k = 0`. -/
private def diagHom (k : ℕ) : Rˣ →* SteinbergGroup R ⧸ symbolNormal R :=
  if hk : k = 0 then 1 else MonoidHom.mk' (fun u ↦ mkSymbol (h hk u)) (mkSymbol_h_mul hk)

private theorem diagHom_zero : diagHom (R := R) 0 = 1 := by
  simp [diagHom]

private theorem diagHom_apply_of_ne {k : ℕ} (hk : k ≠ 0) (u : Rˣ) :
    diagHom k u = mkSymbol (h hk u) := by
  simp [diagHom, hk]

private theorem commute_diagHom {k l : ℕ} (hkl : k ≠ l) (a b : Rˣ) :
    Commute (diagHom (R := R) k a) (diagHom l b) := by
  rcases eq_or_ne k 0 with rfl | hk
  · rw [diagHom_zero]
    exact Commute.one_left _
  rcases eq_or_ne l 0 with rfl | hl
  · rw [diagHom_zero]
    exact Commute.one_right _
  rw [diagHom_apply_of_ne hk, diagHom_apply_of_ne hl, mkSymbol_h_symm hk.symm,
    mkSymbol_h_symm hl.symm, ← commutatorElement_eq_one_iff_commute, ← map_commutatorElement]
  exact mkSymbol_commutatorElement_h_h hk.symm hl.symm hkl _ _

/-- Modulo the symbols, `h_{ij}(u) ≡ h_{i0}(u) h_{j0}(u⁻¹)`, reading `h_{00}` as trivial. -/
private theorem mkSymbol_h_eq_diagHom_mul {i j : ℕ} (hij : i ≠ j) (u : Rˣ) :
    mkSymbol (h hij u) = diagHom i u * diagHom j u⁻¹ := by
  rcases eq_or_ne i 0 with rfl | hi
  · rw [diagHom_zero, MonoidHom.one_apply, one_mul, diagHom_apply_of_ne hij.symm,
      ← mkSymbol_h_symm hij.symm]
  rcases eq_or_ne j 0 with rfl | hj
  · rw [diagHom_zero, MonoidHom.one_apply, mul_one, diagHom_apply_of_ne hi]
  rw [(commute_diagHom hij u u⁻¹).eq, diagHom_apply_of_ne hi, diagHom_apply_of_ne hj,
    mkSymbol_h_inv, mkSymbol_h_eq_mul hj hij hi u, inv_mul_cancel_left]

/-- The products `∏_{k < n} h_{k0}(d_k)` modulo the symbols. -/
private def diagProd (n : ℕ) : (Fin n → Rˣ) →* SteinbergGroup R ⧸ symbolNormal R :=
  MonoidHom.noncommPiCoprod (fun k : Fin n ↦ diagHom k) fun _ _ hkl ↦
    commute_diagHom (Fin.val_ne_of_ne hkl)

private theorem diagProd_mulSingle {n : ℕ} (k : Fin n) (u : Rˣ) :
    diagProd n (Pi.mulSingle k u) = diagHom k u :=
  MonoidHom.noncommPiCoprod_mulSingle (fun k : Fin n ↦ diagHom (R := R) k) k u

/-- Modulo the symbols, every element of the diagonal subgroup is a product `∏_{k < n} h_{k0}(d_k)`
for all large `n`. -/
private theorem exists_diagProd_eq {x : SteinbergGroup R} (hx : x ∈ diagonalSubgroup R) :
    ∃ n₀, ∀ n ≥ n₀, ∃ d : Fin n → Rˣ, mkSymbol x = diagProd n d := by
  induction hx using Subgroup.closure_induction with
  | mem _ hg =>
    obtain ⟨i, j, hij, u, rfl⟩ := hg
    refine ⟨max i j + 1, fun n hn ↦ ⟨Pi.mulSingle ⟨i, by omega⟩ u *
      Pi.mulSingle ⟨j, by omega⟩ u⁻¹, ?_⟩⟩
    rw [map_mul, diagProd_mulSingle, diagProd_mulSingle, mkSymbol_h_eq_diagHom_mul]
  | one => exact ⟨0, fun n _ ↦ ⟨1, by rw [map_one, map_one]⟩⟩
  | mul x y _ _ hx hy =>
    obtain ⟨n₁, h₁⟩ := hx
    obtain ⟨n₂, h₂⟩ := hy
    refine ⟨max n₁ n₂, fun n hn ↦ ?_⟩
    obtain ⟨d₁, hd₁⟩ := h₁ n (le_of_max_le_left hn)
    obtain ⟨d₂, hd₂⟩ := h₂ n (le_of_max_le_right hn)
    exact ⟨d₁ * d₂, by rw [map_mul, map_mul, hd₁, hd₂]⟩
  | inv x _ hx =>
    obtain ⟨n₀, h₀⟩ := hx
    refine ⟨n₀, fun n hn ↦ ?_⟩
    obtain ⟨d, hd⟩ := h₀ n hn
    exact ⟨d⁻¹, by rw [map_inv, map_inv, hd]⟩

/-- The projection `St(R) / S →* GL_∞(R)` induced by `St(R) →* GL_∞(R)`. -/
private abbrev toStableGLSymbol :
    SteinbergGroup R ⧸ symbolNormal R →* StableGeneralLinearGroup R :=
  QuotientGroup.lift _ (toStableGL R) symbolNormal_le_ker

/-- The diagonal entries of the image of `∏_{k ≤ n} h_{k0}(d_k)`: `d_k` at `k ≠ 0`, and the
inverse of their product at `0`. -/
private def diagEntries (n : ℕ) : (Fin (n + 1) → Rˣ) →* (Fin (n + 1) → Rˣ) :=
  MonoidHom.mk' (fun d ↦ d * Pi.mulSingle 0 (∏ k, d k)⁻¹) fun d e ↦ by
    rw [show ∏ k, (d * e) k = (∏ k, d k) * ∏ k, e k from Finset.prod_mul_distrib, mul_inv,
      Pi.mulSingle_mul, mul_mul_mul_comm]

/-- The image of `∏_{k ≤ n} h_{k0}(d_k)` in `GL_∞(R)` is the diagonal matrix
`diag(diagEntries n d)`. -/
private theorem toStableGLSymbol_comp_diagProd (n : ℕ) :
    toStableGLSymbol.comp (diagProd (n + 1)) =
      (StableGeneralLinearGroup.of R (n + 1)).comp (diagGL.comp (diagEntries n)) := by
  refine MonoidHom.pi_ext fun k u ↦ ?_
  simp only [MonoidHom.comp_apply, diagProd_mulSingle, diagEntries, MonoidHom.mk'_apply,
    Fintype.prod_pi_mulSingle']
  rcases eq_or_ne (k : ℕ) 0 with hk | hk
  · obtain rfl : k = 0 := Fin.ext hk
    rw [Fin.val_zero, diagHom_zero, MonoidHom.one_apply, map_one, ← Pi.mulSingle_mul,
      mul_inv_cancel, Pi.mulSingle_one, map_one, map_one]
  · rw [diagHom_apply_of_ne hk, QuotientGroup.mk'_apply, QuotientGroup.lift_mk,
      toStableGL_h hk u k.isLt (Nat.zero_lt_succ n), Fin.eta, Fin.mk_zero]

end SteinbergGroup

namespace AlgebraicK2

open SteinbergGroup IndexedSteinbergGroup

variable {R : Type*} [CommRing R]

/-- **Diagonal elements of `K₂` are products of symbols.** Over a commutative ring `R`, an element
of `K₂(R)` that lies in the diagonal subgroup of `St(R)`, generated by the elements `h_{ij}(u)`,
lies in the subgroup generated by the Steinberg symbols. -/
theorem mem_symbolSubgroup_of_mem_diagonalSubgroup {x : AlgebraicK2 R}
    (hx : (x : SteinbergGroup R) ∈ diagonalSubgroup R) : x ∈ symbolSubgroup R := by
  obtain ⟨n₀, hn⟩ := exists_diagProd_eq hx
  obtain ⟨d, hd⟩ := hn (n₀ + 1) (Nat.le_succ n₀)
  -- The image of `∏ h_{k0}(d_k)` in `GL_∞(R)` is trivial, so every `d_k` with `k ≠ 0` is `1`.
  have himg : toStableGLSymbol (diagProd (n₀ + 1) d) = 1 := by
    rw [← hd, QuotientGroup.mk'_apply, QuotientGroup.lift_mk]
    exact x.property
  rw [← MonoidHom.comp_apply, toStableGLSymbol_comp_diagProd, MonoidHom.comp_apply,
    MonoidHom.comp_apply, ← map_one (StableGeneralLinearGroup.of R (n₀ + 1)),
    ← map_one diagGL] at himg
  have hE := diagGL_injective (StableGeneralLinearGroup.of_injective _ himg)
  have hd₀ : d = Pi.mulSingle 0 (d 0) := by
    ext1 m
    rcases eq_or_ne m 0 with rfl | hm
    · rw [Pi.mulSingle_eq_same]
    · have := congrFun hE m
      simp only [diagEntries, MonoidHom.mk'_apply, Pi.mul_apply, Pi.mulSingle_eq_of_ne hm,
        mul_one, Pi.one_apply] at this
      rw [this, Pi.mulSingle_eq_of_ne hm]
  have h₁ : mkSymbol (x : SteinbergGroup R) = 1 := by
    rw [hd, hd₀, diagProd_mulSingle, Fin.val_zero, diagHom_zero,
      MonoidHom.one_apply]
  rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h₁
  obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.1 h₁
  rwa [← Subtype.ext hyx]

end AlgebraicK2

/-! ## The symbol homomorphism from the Matsumoto group -/

namespace MatsumotoGroup

variable (F : Type*) [Field F]

/-- The Steinberg symbol as a biadditive pairing `Fˣ × Fˣ → K₂(F)`, written additively. -/
private def steinbergSymbolPairing : Additive Fˣ →+ Additive Fˣ →+ Additive (AlgebraicK2 F) :=
  AddMonoidHom.mk'
    (fun a ↦ AddMonoidHom.mk'
      (fun b ↦ Additive.ofMul (steinbergSymbol a.toMul b.toMul (Commute.all _ _)))
      fun b b' ↦ by
        rw [toMul_add, steinbergSymbol_mul_right (Commute.all _ _) (Commute.all _ _)
          (Commute.all _ _), ofMul_mul])
    fun a a' ↦ AddMonoidHom.ext fun b ↦ by
      simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, toMul_add]
      rw [steinbergSymbol_mul_left (Commute.all _ _) (Commute.all _ _) (Commute.all _ _),
        ofMul_mul]

/-- **The symbol homomorphism of Matsumoto's theorem**: the homomorphism from the Matsumoto group
of a field `F` to `K₂(F)`, written additively, sending the class `{x, y}` of `x ⊗ y` to the
Steinberg symbol `{x, y}`. It is well defined because Steinberg symbols are bimultiplicative and
satisfy the Steinberg relation `{x, y} = 1` for `x + y = 1`. -/
def toAlgebraicK2 : MatsumotoGroup F →+ Additive (AlgebraicK2 F) :=
  lift (steinbergSymbolPairing F) fun x y hxy ↦ by
    simp [steinbergSymbolPairing, steinbergSymbol_of_add_eq_one _ hxy]

variable {F}

/-- The symbol homomorphism sends the class `{x, y}` to the Steinberg symbol `{x, y}`. -/
@[simp]
theorem toAlgebraicK2_symbol (x y : Fˣ) :
    toAlgebraicK2 F (symbol x y) = Additive.ofMul (steinbergSymbol x y (Commute.all x y)) := by
  rw [toAlgebraicK2, lift_symbol]
  rfl

/-- The range of the symbol homomorphism is the subgroup of `K₂(F)` generated by the Steinberg
symbols. -/
theorem range_toAlgebraicK2 :
    (toAlgebraicK2 F).range = (AlgebraicK2.symbolSubgroup F).toAddSubgroup := by
  refine le_antisymm ?_ fun z hz ↦ ?_
  · rintro _ ⟨q, rfl⟩
    induction q using induction_on with
    | symbol x y =>
      rw [toAlgebraicK2_symbol, Additive.mem_toAddSubgroup, toMul_ofMul]
      exact AlgebraicK2.steinbergSymbol_mem_symbolSubgroup _
    | add a b ha hb => exact map_add (toAlgebraicK2 F) a b ▸ add_mem ha hb
  · obtain ⟨y, rfl⟩ := Additive.ofMul.surjective z
    rw [Additive.mem_toAddSubgroup, toMul_ofMul] at hz
    induction hz using Subgroup.closure_induction with
    | mem _ hg =>
      obtain ⟨⟨x, y⟩, rfl⟩ := hg
      exact ⟨symbol x y, toAlgebraicK2_symbol x y⟩
    | one => exact zero_mem _
    | mul a b _ _ ha hb => exact ofMul_mul a b ▸ add_mem ha hb
    | inv a _ ha => exact ofMul_inv a ▸ neg_mem ha

/-- **Diagonal elements of `K₂(F)` come from the Matsumoto group.** Every element of `K₂(F)` lying
in the diagonal subgroup of the Steinberg group is the image of an element of the Matsumoto group
under the symbol homomorphism. -/
theorem mem_range_toAlgebraicK2_of_mem_diagonalSubgroup {x : AlgebraicK2 F}
    (hx : (x : SteinbergGroup F) ∈ SteinbergGroup.diagonalSubgroup F) :
    Additive.ofMul x ∈ (toAlgebraicK2 F).range := by
  rw [range_toAlgebraicK2, Additive.mem_toAddSubgroup, toMul_ofMul]
  exact AlgebraicK2.mem_symbolSubgroup_of_mem_diagonalSubgroup hx

end MatsumotoGroup

end TauCeti
