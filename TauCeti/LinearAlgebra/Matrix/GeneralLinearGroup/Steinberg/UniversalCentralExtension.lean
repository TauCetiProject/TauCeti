/-!
# The Kervaire–Steinberg universal central extension

For any associative ring `R`, sending the Steinberg generator `x_{ij}(a)` to the stable
transvection `e_{ij}(a) = 1 + a E_{ij}` defines a homomorphism `St(R) →* GL_∞(R)` whose image is
the stable elementary subgroup `E_∞(R)`.

This file proves the **Kervaire–Steinberg theorem**: the corestriction `St(R) →* E_∞(R)` is the
universal central extension of the perfect group `E_∞(R)`.

1. **Centrality of the kernel** (Milnor §5, Theorem 5.1; Weibel, Chapter III, Theorem 5.2.1):
   Every element `z ∈ ker(St(R) →* GL_∞(R))` lies in the image of `St_N(R)` for some `N`. For
   any `N`, the column subgroup `P_N` generated by `{x_{k, N}(a) | k < N}` is normalized by the
   image of `St_N(R)` and maps injectively into `GL_{N+1}(R)` as upper block unipotent matrices
   of shape `(N, 1)`. Since `ker(St(R) →* GL_∞(R))` is normal and meets `P_N` trivially, `z`
   centralizes `P_N`; symmetrically, `z` centralizes the row subgroup `Q_N` generated by
   `{x_{N, k}(a) | k < N}`. For any `i ≠ j` with `i, j < N`, `z` therefore commutes with
   `x_{ij}(a) = [x_{i, N}(a), x_{N, j}(1)]`, hence `z` is central in `St(R)`.
2. **Universal property** (Kervaire–Steinberg; Milnor §5, Theorem 5.10; Weibel, Chapter III,
   Theorem 5.5): Given any central extension `q : E →* E_∞(R)` (or equivalently any homomorphism
   `q : E →* GL_∞(R)` with image `E_∞(R)` and central kernel), commutators of lifts in `E` depend
   only on their images in `E_∞(R)`. Defining `y_{ij}(a)` as the commutator of lifts of
   `e_{ik}(a)` and `e_{kj}(1)` for `k ∉ {i, j}` is independent of `k` by a five-index commutator
   calculation, satisfies the Steinberg relations, and yields a homomorphism `ψ : St(R) →* E`
   lifting `St(R) →* E_∞(R)`. Uniqueness of `ψ` follows from the perfectness of `St(R)`.

## Main definitions

* `TauCeti.SteinbergGroup.stableToGL`: the canonical homomorphism `St(R) →* GL_∞(R)` sending
  `x_{ij}(a)` to `TauCeti.stableTransvection hij a`.
* `TauCeti.SteinbergGroup.stableToElementary`: the corestriction `St(R) →* E_∞(R)`.

## Main results

* `TauCeti.SteinbergGroup.range_stableToGL`, `TauCeti.SteinbergGroup.stableToElementary_surjective`:
  the image of `St(R) →* GL_∞(R)` is `E_∞(R)`.
* `TauCeti.SteinbergGroup.ker_stableToGL_le_center`: the kernel of `St(R) →* GL_∞(R)` is central
  in `St(R)`.
* `TauCeti.SteinbergGroup.isCentralExtension_stableToElementary`: `St(R) →* E_∞(R)` is a central
  extension.
* `TauCeti.SteinbergGroup.existsUnique_lift_of_range_eq_elementarySubgroup_of_ker_le_center`:
  unique lifting from `St(R)` to any group mapping onto `E_∞(R)` with central kernel.
* `TauCeti.SteinbergGroup.isUniversalCentralExtension_stableToElementary`: `St(R) →* E_∞(R)` is
  a universal central extension in the sense of `MonoidHom.IsUniversalCentralExtension`.
* `TauCeti.steinberg_universalCentralExtension`: the Kervaire–Steinberg theorem packaged for
  `St(R) →* GL_∞(R)`.

## References

* J. Milnor, *Introduction to Algebraic K-Theory*, Annals of Mathematics Studies 72, Princeton
  University Press (1971), §5, Theorems 5.1 and 5.10.
* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter III, Theorems 5.2.1 and 5.5, Lemma 5.3.3.
-/

public section

noncomputable section

open Matrix Subgroup

open scoped commutatorElement

universe u v

namespace TauCeti

namespace SteinbergGroup

/-! ## The canonical homomorphism `St(R) →* GL_∞(R)` -/

section StableToGL

variable {R : Type u} [Ring R]

variable (R) in
/-- The canonical homomorphism `St(R) →* GL_∞(R)` sending each Steinberg generator `x_{ij}(a)` to
the stable elementary matrix `e_{ij}(a) = 1 + a E_{ij}`. -/
def stableToGL : SteinbergGroup ℕ R →* StableGeneralLinearGroup R :=
  lift (fun _ _ hij a ↦ stableTransvection hij a)
    (fun _ _ hij a b ↦ (stableTransvection_add hij a b).symm)
    (fun _ _ _ _ hij hkl hjk hil a b ↦ commute_stableTransvection hij hkl hjk hil a b)
    (fun _ _ _ hij hjk hik a b ↦ commutatorElement_stableTransvection hij hjk hik a b)

/-- `stableToGL` sends the generator `x_{ij}(a)` to `stableTransvection hij a`. -/
@[simp]
theorem stableToGL_of {i j : ℕ} (hij : i ≠ j) (a : R) :
    stableToGL R (of hij a) = stableTransvection hij a :=
  lift_of ..

/-- `stableToGL` is compatible with `toStable` and the finite homomorphisms `toGL`. -/
@[simp]
theorem stableToGL_toStable (n : ℕ) (x : SteinbergGroup (Fin n) R) :
    stableToGL R (toStable R n x) = StableGeneralLinearGroup.of R n (toGL (Fin n) R x) := by
  have h : (stableToGL R).comp (toStable R n) =
      (StableGeneralLinearGroup.of R n).comp (toGL (Fin n) R) := by
    ext i j hij a
    simp only [MonoidHom.comp_apply, toStable_of, stableToGL_of, toGL_of]
    exact stableTransvection_eq_of i.isLt j.isLt (Fin.val_injective.ne hij) a
  exact DFunLike.congr_fun h x

/-- The image of `stableToGL : St(R) →* GL_∞(R)` is the stable elementary subgroup `E_∞(R)`. -/
@[simp]
theorem range_stableToGL :
    (stableToGL R).range = StableGeneralLinearGroup.elementarySubgroup R := by
  refine le_antisymm ?_ ?_
  · rintro _ ⟨x, rfl⟩
    exact generated_by ((StableGeneralLinearGroup.elementarySubgroup R).comap (stableToGL R))
      (fun _ _ hij a ↦ by simp [stableTransvection_mem_elementarySubgroup]) x
  · intro g hg
    obtain ⟨n, u, hu, rfl⟩ := StableGeneralLinearGroup.mem_elementarySubgroup_iff.mp hg
    rw [← range_toGL] at hu
    obtain ⟨y, rfl⟩ := hu
    exact ⟨toStable R n y, stableToGL_toStable n y⟩

variable (R) in
/-- The canonical surjective homomorphism `St(R) →* E_∞(R)` onto the stable elementary subgroup. -/
def stableToElementary : SteinbergGroup ℕ R →* StableGeneralLinearGroup.elementarySubgroup R :=
  (stableToGL R).codRestrict (StableGeneralLinearGroup.elementarySubgroup R) fun x ↦
    range_stableToGL (R := R) ▸ ⟨x, rfl⟩

/-- Composing `stableToElementary` with the subgroup inclusion recovers `stableToGL`. -/
@[simp]
theorem coe_stableToElementary (x : SteinbergGroup ℕ R) :
    (stableToElementary R x : StableGeneralLinearGroup R) = stableToGL R x :=
  (rfl)

/-- The homomorphism `St(R) →* E_∞(R)` is surjective. -/
theorem stableToElementary_surjective : Function.Surjective (stableToElementary R) := by
  rintro ⟨g, hg⟩
  rw [← range_stableToGL] at hg
  obtain ⟨x, rfl⟩ := hg
  exact ⟨x, Subtype.ext rfl⟩

/-- `stableToElementary` and `stableToGL` have the same kernel. -/
@[simp]
theorem ker_stableToElementary : (stableToElementary R).ker = (stableToGL R).ker := by
  ext x
  simp [MonoidHom.mem_ker, Subtype.ext_iff]

end StableToGL

/-! ## Centrality of the kernel of `St(R) →* GL_∞(R)` -/

section Centrality

variable {R : Type u} [Ring R]

private theorem colHom_pairwise (N : ℕ) :
    Pairwise fun (k l : Fin N) ↦ ∀ (x y : Multiplicative R),
      Commute (ofHom (Nat.ne_of_lt k.isLt) x) (ofHom (Nat.ne_of_lt l.isLt) y) :=
  fun _ _ _ _ _ ↦ by simp only [ofHom_apply]; exact commute_of _ _ (by omega) (by omega) _ _

private theorem rowHom_pairwise (N : ℕ) :
    Pairwise fun (k l : Fin N) ↦ ∀ (x y : Multiplicative R),
      Commute (ofHom (Nat.ne_of_lt k.isLt).symm x) (ofHom (Nat.ne_of_lt l.isLt).symm y) :=
  fun _ _ _ _ _ ↦ by simp only [ofHom_apply]; exact commute_of _ _ (by omega) (by omega) _ _

/-- The column homomorphism `(Fin N → Multiplicative R) →* St(R)` sending a tuple `(a_k)` to the
product of the pairwise commuting generators `x_{k, N}(a_k)`. -/
private def colHom (R : Type u) [Ring R] (N : ℕ) :
    (Fin N → Multiplicative R) →* SteinbergGroup ℕ R :=
  MonoidHom.noncommPiCoprod (fun k : Fin N ↦ ofHom (Nat.ne_of_lt k.isLt)) (colHom_pairwise N)

/-- The row homomorphism `(Fin N → Multiplicative R) →* St(R)` sending a tuple `(a_k)` to the
product of the pairwise commuting generators `x_{N, k}(a_k)`. -/
private def rowHom (R : Type u) [Ring R] (N : ℕ) :
    (Fin N → Multiplicative R) →* SteinbergGroup ℕ R :=
  MonoidHom.noncommPiCoprod (fun k : Fin N ↦ ofHom (Nat.ne_of_lt k.isLt).symm) (rowHom_pairwise N)

/-- The upper block unipotent column embedding `(Fin N → Multiplicative R) →* GL (Fin (N + 1)) R`.
-/
private def colGLHom (R : Type u) [Ring R] (N : ℕ) :
    (Fin N → Multiplicative R) →* GL (Fin (N + 1)) R where
  toFun v := finSumFinEquiv.reindexGL R (upperBlockGL (Matrix.of fun k (_ : Fin 1) ↦ (v k).toAdd))
  map_one' := by
    have h0 : Matrix.of (fun (_ : Fin N) (_ : Fin 1) ↦ (0 : R)) = 0 := rfl
    simp [h0]
  map_mul' v w := by
    rw [← map_mul, ← upperBlockGL_add]
    rfl

/-- The lower block unipotent row embedding `(Fin N → Multiplicative R) →* GL (Fin (N + 1)) R`. -/
private def rowGLHom (R : Type u) [Ring R] (N : ℕ) :
    (Fin N → Multiplicative R) →* GL (Fin (N + 1)) R where
  toFun v := finSumFinEquiv.reindexGL R (lowerBlockGL (Matrix.of fun (_ : Fin 1) k ↦ (v k).toAdd))
  map_one' := by
    have h0 : Matrix.of (fun (_ : Fin 1) (_ : Fin N) ↦ (0 : R)) = 0 := rfl
    simp [h0]
  map_mul' v w := by
    rw [← map_mul, ← lowerBlockGL_add]
    rfl

private theorem colGLHom_injective (N : ℕ) : Function.Injective (colGLHom R N) := by
  intro v w h
  have hblk := (finSumFinEquiv.reindexGL R).injective h
  funext k
  apply Multiplicative.toAdd.injective
  have hent := congrArg (fun u : GL (Fin N ⊕ Fin 1) R ↦ u.1 (Sum.inl k) (Sum.inr 0)) hblk
  simpa [coe_upperBlockGL] using hent

private theorem rowGLHom_injective (N : ℕ) : Function.Injective (rowGLHom R N) := by
  intro v w h
  have hblk := (finSumFinEquiv.reindexGL R).injective h
  funext k
  apply Multiplicative.toAdd.injective
  have hent := congrArg (fun u : GL (Fin N ⊕ Fin 1) R ↦ u.1 (Sum.inr 0) (Sum.inl k)) hblk
  simpa [coe_lowerBlockGL] using hent

private theorem stableToGL_comp_colHom (N : ℕ) :
    (stableToGL R).comp (colHom R N) =
      (StableGeneralLinearGroup.of R (N + 1)).comp (colGLHom R N) := by
  refine MonoidHom.pi_ext fun k a ↦ ?_
  simp only [MonoidHom.comp_apply, colHom, MonoidHom.noncommPiCoprod_mulSingle, ofHom_apply,
    stableToGL_of]
  rw [stableTransvection_eq_of (n := N + 1) (Nat.lt_succ_of_lt k.isLt) (Nat.lt_succ_self N)]
  refine congrArg (StableGeneralLinearGroup.of R (N + 1)) (Units.ext ?_)
  ext p q
  obtain ⟨p, rfl⟩ := finSumFinEquiv.surjective p
  obtain ⟨q, rfl⟩ := finSumFinEquiv.surjective q
  rcases p with p | p <;> rcases q with q | q
  · simp [colGLHom, coe_transvectionUnit_eq_one_add_single, Matrix.one_apply, Fin.ext_iff,
      (Nat.ne_of_lt q.isLt).symm]
  · fin_cases q
    by_cases hpk : p = k
    · subst hpk
      simp [colGLHom, coe_transvectionUnit_eq_one_add_single, single_apply, Fin.ext_iff,
        Nat.ne_of_lt p.isLt]
    · simp [colGLHom, coe_transvectionUnit_eq_one_add_single, Fin.ext_iff, hpk,
        (Fin.val_ne_of_ne hpk).symm, Nat.ne_of_lt p.isLt]
  · fin_cases p
    simp [colGLHom, coe_transvectionUnit_eq_one_add_single, Fin.ext_iff,
      (Nat.ne_of_lt q.isLt).symm]
  · fin_cases p; fin_cases q
    simp [colGLHom, coe_transvectionUnit_eq_one_add_single, Fin.ext_iff, Nat.ne_of_lt k.isLt]

private theorem stableToGL_comp_rowHom (N : ℕ) :
    (stableToGL R).comp (rowHom R N) =
      (StableGeneralLinearGroup.of R (N + 1)).comp (rowGLHom R N) := by
  refine MonoidHom.pi_ext fun k a ↦ ?_
  simp only [MonoidHom.comp_apply, rowHom, MonoidHom.noncommPiCoprod_mulSingle, ofHom_apply,
    stableToGL_of]
  rw [stableTransvection_eq_of (n := N + 1) (Nat.lt_succ_self N) (Nat.lt_succ_of_lt k.isLt)]
  refine congrArg (StableGeneralLinearGroup.of R (N + 1)) (Units.ext ?_)
  ext p q
  obtain ⟨p, rfl⟩ := finSumFinEquiv.surjective p
  obtain ⟨q, rfl⟩ := finSumFinEquiv.surjective q
  rcases p with p | p <;> rcases q with q | q
  · simp [rowGLHom, coe_transvectionUnit_eq_one_add_single, Matrix.one_apply, Fin.ext_iff,
      (Nat.ne_of_lt p.isLt).symm]
  · fin_cases q
    simp [rowGLHom, coe_transvectionUnit_eq_one_add_single, Fin.ext_iff,
      Nat.ne_of_lt p.isLt, (Nat.ne_of_lt p.isLt).symm]
  · fin_cases p
    by_cases hqk : q = k
    · subst hqk
      simp [rowGLHom, coe_transvectionUnit_eq_one_add_single, single_apply, Fin.ext_iff,
        (Nat.ne_of_lt q.isLt).symm]
    · simp [rowGLHom, coe_transvectionUnit_eq_one_add_single, Fin.ext_iff, hqk,
        (Fin.val_ne_of_ne hqk).symm, (Nat.ne_of_lt q.isLt).symm]
  · fin_cases p; fin_cases q
    simp [rowGLHom, coe_transvectionUnit_eq_one_add_single, Fin.ext_iff, Nat.ne_of_lt k.isLt]

private theorem ker_stableToGL_inf_range_colHom (N : ℕ) :
    (stableToGL R).ker ⊓ (colHom R N).range = ⊥ := by
  rw [eq_bot_iff]
  rintro x ⟨hxker, v, rfl⟩
  have hinj : Function.Injective ((stableToGL R).comp (colHom R N)) := by
    rw [stableToGL_comp_colHom]
    exact (StableGeneralLinearGroup.of_injective (N + 1)).comp (colGLHom_injective N)
  have hv : v = 1 := hinj (by simpa [MonoidHom.mem_ker] using hxker)
  simp [hv]

private theorem ker_stableToGL_inf_range_rowHom (N : ℕ) :
    (stableToGL R).ker ⊓ (rowHom R N).range = ⊥ := by
  rw [eq_bot_iff]
  rintro x ⟨hxker, v, rfl⟩
  have hinj : Function.Injective ((stableToGL R).comp (rowHom R N)) := by
    rw [stableToGL_comp_rowHom]
    exact (StableGeneralLinearGroup.of_injective (N + 1)).comp (rowGLHom_injective N)
  have hv : v = 1 := hinj (by simpa [MonoidHom.mem_ker] using hxker)
  simp [hv]

private theorem range_colHom_eq_closure (N : ℕ) :
    (colHom R N).range =
      Subgroup.closure
        {g : SteinbergGroup ℕ R | ∃ (k : Fin N) (a : R), g = of (Nat.ne_of_lt k.isLt) a} := by
  refine le_antisymm ?_ ?_
  · rw [colHom, MonoidHom.noncommPiCoprod_range]
    refine iSup_le fun k ↦ ?_
    rintro _ ⟨a, rfl⟩
    exact subset_closure ⟨k, a.toAdd, ofHom_apply ..⟩
  · rw [closure_le]
    rintro _ ⟨k, a, rfl⟩
    exact ⟨Pi.mulSingle k (Multiplicative.ofAdd a), by simp [colHom]⟩

private theorem range_rowHom_eq_closure (N : ℕ) :
    (rowHom R N).range =
      Subgroup.closure
        {g : SteinbergGroup ℕ R | ∃ (k : Fin N) (a : R), g = of (Nat.ne_of_lt k.isLt).symm a} := by
  refine le_antisymm ?_ ?_
  · rw [rowHom, MonoidHom.noncommPiCoprod_range]
    refine iSup_le fun k ↦ ?_
    rintro _ ⟨a, rfl⟩
    exact subset_closure ⟨k, a.toAdd, ofHom_apply ..⟩
  · rw [closure_le]
    rintro _ ⟨k, a, rfl⟩
    exact ⟨Pi.mulSingle k (Multiplicative.ofAdd a), by simp [rowHom]⟩

private theorem range_toStable_eq_closure (N : ℕ) :
    (toStable R N).range =
      Subgroup.closure {g : SteinbergGroup ℕ R |
        ∃ (i j : Fin N) (hij : i ≠ j) (a : R), g = of (Fin.val_injective.ne hij) a} := by
  let S : Set (SteinbergGroup ℕ R) :=
    {g | ∃ (i j : Fin N) (hij : i ≠ j) (a : R), g = of (Fin.val_injective.ne hij) a}
  refine le_antisymm ?_ ?_
  · rintro _ ⟨x, rfl⟩
    exact generated_by ((Subgroup.closure S).comap (toStable R N))
      (fun i j hij a ↦ by
        rw [Subgroup.mem_comap, toStable_of]
        exact subset_closure ⟨i, j, hij, a, rfl⟩) x
  · rw [closure_le]
    rintro _ ⟨i, j, hij, a, rfl⟩
    exact ⟨of hij a, toStable_of hij a⟩

private theorem conj_colGen_mem (N : ℕ) {i j : Fin N} (hij : i ≠ j) (r : R) (k : Fin N) (a : R) :
    of (Fin.val_injective.ne hij) r * of (Nat.ne_of_lt k.isLt) a *
        (of (Fin.val_injective.ne hij) r)⁻¹ ∈ (colHom R N).range := by
  rw [range_colHom_eq_closure]
  by_cases hjk : (j : ℕ) = k
  · have heq :
        of (Fin.val_injective.ne hij) r * of (Nat.ne_of_lt k.isLt) a *
            (of (Fin.val_injective.ne hij) r)⁻¹ =
          ⁅of (Fin.val_injective.ne hij) r, of (Nat.ne_of_lt k.isLt) a⁆ *
            of (Nat.ne_of_lt k.isLt) a := by
      rw [commutatorElement_def]; group
    rw [heq]
    have hcomm :
        ⁅of (Fin.val_injective.ne hij) r, of (Nat.ne_of_lt k.isLt) a⁆ =
          of (Nat.ne_of_lt i.isLt) (r * a) := by
      have hk : k = j := Fin.ext hjk.symm
      subst hk
      exact commutatorElement_of (Fin.val_injective.ne hij) (Nat.ne_of_lt k.isLt)
        (Nat.ne_of_lt i.isLt) r a
    rw [hcomm]
    exact mul_mem (subset_closure ⟨i, r * a, rfl⟩) (subset_closure ⟨k, a, rfl⟩)
  · have hc := commute_of (Fin.val_injective.ne hij) (Nat.ne_of_lt k.isLt) hjk
      (Nat.ne_of_lt i.isLt) r a
    rw [hc.eq, mul_inv_cancel_right]
    exact subset_closure ⟨k, a, rfl⟩

private theorem conj_rowGen_mem (N : ℕ) {i j : Fin N} (hij : i ≠ j) (r : R) (k : Fin N) (a : R) :
    of (Fin.val_injective.ne hij) r * of (Nat.ne_of_lt k.isLt).symm a *
        (of (Fin.val_injective.ne hij) r)⁻¹ ∈ (rowHom R N).range := by
  rw [range_rowHom_eq_closure]
  by_cases hik : (i : ℕ) = k
  · have heq :
        of (Fin.val_injective.ne hij) r * of (Nat.ne_of_lt k.isLt).symm a *
            (of (Fin.val_injective.ne hij) r)⁻¹ =
          ⁅of (Fin.val_injective.ne hij) r, of (Nat.ne_of_lt k.isLt).symm a⁆ *
            of (Nat.ne_of_lt k.isLt).symm a := by
      rw [commutatorElement_def]; group
    rw [heq]
    have hcomm :
        ⁅of (Fin.val_injective.ne hij) r, of (Nat.ne_of_lt k.isLt).symm a⁆ =
          of (Nat.ne_of_lt j.isLt).symm (-(a * r)) := by
      have hk : k = i := Fin.ext hik.symm
      subst hk
      exact commutatorElement_of_reverse (Fin.val_injective.ne hij) (Nat.ne_of_lt k.isLt).symm
        (Nat.ne_of_lt j.isLt).symm r a
    rw [hcomm]
    exact mul_mem (subset_closure ⟨j, -(a * r), rfl⟩) (subset_closure ⟨k, a, rfl⟩)
  · have hc := commute_of (Fin.val_injective.ne hij) (Nat.ne_of_lt k.isLt).symm
      (Nat.ne_of_lt j.isLt) hik r a
    rw [hc.eq, mul_inv_cancel_right]
    exact subset_closure ⟨k, a, rfl⟩

private theorem range_toStable_le_normalizer_colHom (N : ℕ) :
    (toStable R N).range ≤ normalizer ((colHom R N).range : Set (SteinbergGroup ℕ R)) := by
  rw [range_toStable_eq_closure, range_colHom_eq_closure]
  refine closure_le_normalizer_closure ?_ ?_
  · rintro _ ⟨i, j, hij, r, rfl⟩ _ ⟨k, a, rfl⟩
    rw [← range_colHom_eq_closure]
    exact conj_colGen_mem N hij r k a
  · rintro _ ⟨i, j, hij, r, rfl⟩ _ ⟨k, a, rfl⟩
    rw [← range_colHom_eq_closure, of_inv]
    simpa [of_inv] using conj_colGen_mem N hij (-r) k a

private theorem range_toStable_le_normalizer_rowHom (N : ℕ) :
    (toStable R N).range ≤ normalizer ((rowHom R N).range : Set (SteinbergGroup ℕ R)) := by
  rw [range_toStable_eq_closure, range_rowHom_eq_closure]
  refine closure_le_normalizer_closure ?_ ?_
  · rintro _ ⟨i, j, hij, r, rfl⟩ _ ⟨k, a, rfl⟩
    rw [← range_rowHom_eq_closure]
    exact conj_rowGen_mem N hij r k a
  · rintro _ ⟨i, j, hij, r, rfl⟩ _ ⟨k, a, rfl⟩
    rw [← range_rowHom_eq_closure, of_inv]
    simpa [of_inv] using conj_rowGen_mem N hij (-r) k a

/-- **Centrality of `ker(St(R) →* GL_∞(R))`** (Milnor §5, Theorem 5.1; Weibel, Chapter III,
Theorem 5.2.1): every element of the kernel of `St(R) →* GL_∞(R)` lies in the centre of `St(R)`. -/
theorem ker_stableToGL_le_center :
    (stableToGL R).ker ≤ center (SteinbergGroup ℕ R) := by
  intro z hz
  obtain ⟨M, y, hy⟩ := exists_toStable z
  -- It suffices to show `z` commutes with every Steinberg generator `x_{ij}(a)`.
  have hcomm_gen : ∀ (i j : ℕ) (hij : i ≠ j) (a : R), Commute z (of hij a) := by
    intro i j hij a
    let N := max M (max i j + 1)
    have hzN : z ∈ (toStable R N).range :=
      ⟨stabilize R (le_max_left M _) y, by rw [toStable_stabilize, hy]⟩
    have hcomm_of_norm : ∀ {K : Subgroup (SteinbergGroup ℕ R)},
        (toStable R N).range ≤ normalizer (K : Set (SteinbergGroup ℕ R)) →
        (stableToGL R).ker ⊓ K = ⊥ → ∀ u ∈ K, Commute z u := by
      intro K hnorm hinf u hu
      have h1 : ⁅z, u⁆ ∈ (stableToGL R).ker := by
        have hsplit : ⁅z, u⁆ = z * (u * z⁻¹ * u⁻¹) := by rw [commutatorElement_def]; group
        rw [hsplit]
        exact (stableToGL R).ker.mul_mem hz
          ((stableToGL R).normal_ker.conj_mem z⁻¹ ((stableToGL R).ker.inv_mem hz) u)
      have h2 : ⁅z, u⁆ ∈ K := by
        rw [commutatorElement_def]
        exact K.mul_mem ((mem_normalizer_iff.mp (hnorm hzN) u).mp hu) (K.inv_mem hu)
      exact commutatorElement_eq_one_iff_commute.mp
        ((eq_bot_iff_forall _).mp hinf _ ⟨h1, h2⟩)
    have hiN : i < N := by omega
    have hjN : j < N := by omega
    have hz_col : Commute z (of (Nat.ne_of_lt hiN) a) :=
      hcomm_of_norm (range_toStable_le_normalizer_colHom N) (ker_stableToGL_inf_range_colHom N) _
        (by rw [range_colHom_eq_closure]; exact subset_closure ⟨⟨i, hiN⟩, a, rfl⟩)
    have hz_row : Commute z (of (Nat.ne_of_lt hjN).symm (1 : R)) :=
      hcomm_of_norm (range_toStable_le_normalizer_rowHom N) (ker_stableToGL_inf_range_rowHom N) _
        (by rw [range_rowHom_eq_closure]; exact subset_closure ⟨⟨j, hjN⟩, 1, rfl⟩)
    have heq : of hij a = ⁅of (Nat.ne_of_lt hiN) a, of (Nat.ne_of_lt hjN).symm (1 : R)⁆ := by
      rw [commutatorElement_of (Nat.ne_of_lt hiN) (Nat.ne_of_lt hjN).symm hij, mul_one]
    rw [heq, commutatorElement_def]
    exact ((hz_col.mul_right hz_row).mul_right hz_col.inv_right).mul_right hz_row.inv_right
  rw [mem_center_iff]
  intro g
  exact (generated_by (centralizer {z}) (fun i j hij a ↦ by
    simpa [mem_centralizer_iff] using (hcomm_gen i j hij a).eq) g z rfl).symm

/-- `St(R) →* E_∞(R)` is a central extension. -/
theorem isCentralExtension_stableToElementary :
    (stableToElementary R).IsCentralExtension :=
  ⟨stableToElementary_surjective, ker_stableToElementary (R := R) ▸ ker_stableToGL_le_center⟩

end Centrality

/-! ## The Kervaire–Steinberg universal central extension -/

section UniversalCentralExtension

variable {R : Type u} [Ring R]

section LiftConstruction

variable {E : Type v} [Group E] (q : E →* StableGeneralLinearGroup R)
  (hq_range : q.range = StableGeneralLinearGroup.elementarySubgroup R)

/-- A chosen lift in `E` of the stable transvection `e_{ij}(a)`. -/
private def liftElem {i j : ℕ} (hij : i ≠ j) (a : R) : E :=
  (hq_range.symm ▸ stableTransvection_mem_elementarySubgroup hij a).choose

private theorem map_liftElem {i j : ℕ} (hij : i ≠ j) (a : R) :
    q (liftElem q hq_range hij a) = stableTransvection hij a :=
  (hq_range.symm ▸ stableTransvection_mem_elementarySubgroup hij a).choose_spec

/-- The commutator in `E` of lifts of `e_{ij}(a)` and `e_{kl}(b)`. Because `q` has central kernel,
this element is independent of the chosen lifts. -/
private def liftComm {i j k l : ℕ} (hij : i ≠ j) (hkl : k ≠ l) (a b : R) : E :=
  ⁅liftElem q hq_range hij a, liftElem q hq_range hkl b⁆

private theorem commutatorElement_eq_liftComm (hq_ker : q.ker ≤ center E)
    {i j k l : ℕ} (hij : i ≠ j) (hkl : k ≠ l) {a b : R} {x y : E}
    (hx : q x = stableTransvection hij a) (hy : q y = stableTransvection hkl b) :
    ⁅x, y⁆ = liftComm q hq_range hij hkl a b :=
  q.commutatorElement_eq_of_ker_le_center hq_ker (hx.trans (map_liftElem q hq_range hij a).symm)
    (hy.trans (map_liftElem q hq_range hkl b).symm)

private theorem map_liftComm_chain {i j k : ℕ} (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k)
    (a b : R) : q (liftComm q hq_range hij hjk a b) = stableTransvection hik (a * b) := by
  rw [liftComm, map_commutatorElement, map_liftElem, map_liftElem,
    commutatorElement_stableTransvection hij hjk hik]

/-- A degenerate Hall–Witt identity: if `x` commutes with `z`, `⁅y, z⁆` commutes with `z` and
`⁅x, y⁆`, and `z` commutes with `⁅x, ⁅y, z⁆⁆`, then `⁅⁅x, y⁆, z⁆ = ⁅x, ⁅y, z⁆⁆`. -/
private theorem commutatorElement_assoc_of_commute {x y z : E}
    (hxz : Commute x z) (hyzz : Commute ⁅y, z⁆ z) (hyzxy : Commute ⁅y, z⁆ ⁅x, y⁆)
    (hzxyz : Commute z ⁅x, ⁅y, z⁆⁆) : ⁅⁅x, y⁆, z⁆ = ⁅x, ⁅y, z⁆⁆ := by
  have hzyz : z⁻¹ * y * z = ⁅y, z⁆ * y := by
    have h1 : ⁅y, z⁆ * z * y = y * z := by simp [commutatorElement_def, mul_assoc]
    rw [hyzz.eq, mul_assoc] at h1
    exact mul_left_cancel (a := z) (by simpa [mul_assoc] using h1.symm)
  have hzxyz_conj : z⁻¹ * ⁅x, y⁆ * z = ⁅x, ⁅y, z⁆⁆ * ⁅x, y⁆ := by
    have hzxz : z⁻¹ * x * z = x := by rw [mul_assoc, hxz.eq, inv_mul_cancel_left]
    have hwyw : ⁅y, z⁆ * ⁅x, y⁆ * ⁅y, z⁆⁻¹ = ⁅x, y⁆ := mul_inv_eq_iff_eq_mul.mpr hyzxy.eq
    calc
      z⁻¹ * ⁅x, y⁆ * z = z⁻¹ * ⁅x, y⁆ * (z⁻¹)⁻¹ := by simp
      _ = ⁅z⁻¹ * x * (z⁻¹)⁻¹, z⁻¹ * y * (z⁻¹)⁻¹⁆ := conjugate_commutatorElement x y z⁻¹
      _ = ⁅x, ⁅y, z⁆ * y⁆ := by simp [hzxz, hzyz]
      _ = ⁅x, ⁅y, z⁆⁆ * (⁅y, z⁆ * ⁅x, y⁆ * ⁅y, z⁆⁻¹) := by
        rw [commutatorElement_mul_right_eq_mul_conj]; simp [mul_assoc]
      _ = ⁅x, ⁅y, z⁆⁆ * ⁅x, y⁆ := by rw [hwyw]
  have h2 : ⁅x, y⁆ * z = ⁅x, ⁅y, z⁆⁆ * z * ⁅x, y⁆ := by
    have h3 := congrArg (z * ·) hzxyz_conj
    simp only [← mul_assoc, mul_inv_cancel, one_mul] at h3
    rw [h3, mul_assoc, ← mul_assoc z ⁅x, ⁅y, z⁆⁆, hzxyz.eq, mul_assoc]
  rw [commutatorElement_def, h2]
  group

include hq_range in
/-- If `q u = e_{ij}(a)` and `q w` commutes with `e_{ip}(a)` and `e_{pj}(1)` for some `p ∉ {i, j}`,
then `w` commutes with `u` in `E`. -/
private theorem commute_of_map_eq_stableTransvection (hq_ker : q.ker ≤ center E)
    {i j p : ℕ} (hij : i ≠ j) (hip : i ≠ p) (hpj : p ≠ j) {a : R} {w u : E}
    (hu : q u = stableTransvection hij a)
    (hw1 : Commute (q w) (stableTransvection hip a))
    (hw2 : Commute (q w) (stableTransvection hpj 1)) : Commute w u := by
  let u' : E := liftComm q hq_range hip hpj a 1
  have hqu' : q u' = stableTransvection hij a := by
    simpa [u', mul_one] using map_liftComm_chain q hq_range hip hpj hij a 1
  have hwu' : Commute w u' :=
    q.commute_commutatorElement_of_ker_le_center hq_ker
      (by rwa [map_liftElem]) (by rwa [map_liftElem])
  have hc : u'⁻¹ * u ∈ center E := hq_ker <| by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hqu', hu, inv_mul_cancel]
  rw [show u = u' * (u'⁻¹ * u) by simp]
  exact hwu'.mul_right (mem_center_iff.mp hc w)

/-- Five-index chaining identity in a central extension of `E_∞(R)`: for pairwise distinct
`i, j, m, n`, `[e'_{im}(a b), e'_{mj}(1)] = [e'_{in}(a), e'_{nj}(b)]` for lifts `e'` in `E`. -/
private theorem liftComm_chaining (hq_ker : q.ker ≤ center E) {i j m n : ℕ}
    (hij : i ≠ j) (him : i ≠ m) (hin : i ≠ n) (hjm : j ≠ m) (hjn : j ≠ n) (hmn : m ≠ n)
    (a b : R) :
    liftComm q hq_range him hjm.symm (a * b) 1 = liftComm q hq_range hin hjn.symm a b := by
  let p := max (max i j) (max m n) + 1
  have hip : i ≠ p := by omega
  have hjp : j ≠ p := by omega
  have hmp : m ≠ p := by omega
  have hnp : n ≠ p := by omega
  let X : E := liftElem q hq_range hin a
  let Y : E := liftComm q hq_range hnp hmp.symm b 1
  let Z : E := liftComm q hq_range hmp hjp.symm 1 1
  have hqX : q X = stableTransvection hin a := map_liftElem q hq_range hin a
  have hqY : q Y = stableTransvection hmn.symm b := by
    simpa [Y, mul_one] using map_liftComm_chain q hq_range hnp hmp.symm hmn.symm b 1
  have hqZ : q Z = stableTransvection hjm.symm 1 := by
    simpa [Z, mul_one] using map_liftComm_chain q hq_range hmp hjp.symm hjm.symm (1 : R) 1
  have hqW : q ⁅Y, Z⁆ = stableTransvection hjn.symm b := by
    rw [map_commutatorElement, hqY, hqZ,
      commutatorElement_stableTransvection hmn.symm hjm.symm hjn.symm, mul_one]
  have hqU : q ⁅X, Y⁆ = stableTransvection him (a * b) := by
    rw [map_commutatorElement, hqX, hqY, commutatorElement_stableTransvection hin hmn.symm him]
  have hXZ : Commute X Z :=
    commute_of_map_eq_stableTransvection q hq_range hq_ker hjm.symm hmp hjp.symm hqZ
      (by rw [hqX]; exact commute_stableTransvection hin hmp hmn.symm hip a 1)
      (by rw [hqX]; exact commute_stableTransvection hin hjp.symm hnp hij a 1)
  have hWZ : Commute ⁅Y, Z⁆ Z :=
    commute_of_map_eq_stableTransvection q hq_range hq_ker hjm.symm hmp hjp.symm hqZ
      (by rw [hqW]; exact commute_stableTransvection hjn.symm hmp hjm hnp b 1)
      (by rw [hqW]; exact commute_stableTransvection hjn.symm hjp.symm hjp hjn.symm b 1)
  have hWU : Commute ⁅Y, Z⁆ ⁅X, Y⁆ :=
    commute_of_map_eq_stableTransvection q hq_range hq_ker him hip hmp.symm hqU
      (by rw [hqW]; exact commute_stableTransvection hjn.symm hip hij.symm hnp b _)
      (by rw [hqW]; exact commute_stableTransvection hjn.symm hmp.symm hjp hmn.symm b 1)
  have hZXW : Commute Z ⁅X, ⁅Y, Z⁆⁆ :=
    q.commute_commutatorElement_of_ker_le_center hq_ker
      (by rw [hqZ, hqX]; exact commute_stableTransvection hjm.symm hin hij.symm hmn 1 a)
      (by rw [hqZ, hqW]; exact commute_stableTransvection hjm.symm hjn.symm hjn hjm.symm 1 b)
  calc
    liftComm q hq_range him hjm.symm (a * b) 1 = ⁅⁅X, Y⁆, Z⁆ :=
      (commutatorElement_eq_liftComm q hq_range hq_ker him hjm.symm hqU hqZ).symm
    _ = ⁅X, ⁅Y, Z⁆⁆ := commutatorElement_assoc_of_commute hXZ hWZ hWU hZXW
    _ = liftComm q hq_range hin hjn.symm a b :=
      commutatorElement_eq_liftComm q hq_range hq_ker hin hjn.symm hqX hqW

/-- The canonical lift `y_{ij}(a) ∈ E` of `e_{ij}(a)`, defined as `[e'_{ik}(a), e'_{kj}(1)]` for
`k = max i j + 1` and lifts `e'` in `E`. -/
private def liftGen (i j : ℕ) (a : R) : E :=
  liftComm q hq_range (i := i) (j := max i j + 1) (k := max i j + 1) (l := j)
    (by omega) (by omega) a 1

private theorem map_liftGen {i j : ℕ} (hij : i ≠ j) (a : R) :
    q (liftGen q hq_range i j a) = stableTransvection hij a := by
  simpa [liftGen, mul_one] using
    map_liftComm_chain q hq_range (by omega : i ≠ max i j + 1) (by omega : max i j + 1 ≠ j) hij a 1

private theorem liftGen_eq_liftComm (hq_ker : q.ker ≤ center E) {i j m : ℕ}
    (hij : i ≠ j) (him : i ≠ m) (hmj : m ≠ j) (a : R) :
    liftGen q hq_range i j a = liftComm q hq_range him hmj a 1 := by
  by_cases hm : m = max i j + 1
  · subst hm; rfl
  · simpa [liftGen, mul_one] using
      (liftComm_chaining q hq_range hq_ker hij him (by omega : i ≠ max i j + 1) hmj.symm
        (by omega : j ≠ max i j + 1) hm a 1).symm

private theorem liftGen_chevalley (hq_ker : q.ker ≤ center E) {i j k : ℕ}
    (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a b : R) :
    ⁅liftGen q hq_range i j a, liftGen q hq_range j k b⁆ = liftGen q hq_range i k (a * b) := by
  let m := max (max i j) k + 1
  rw [liftGen_eq_liftComm q hq_range hq_ker hik (by omega : i ≠ m) (by omega : m ≠ k) (a * b),
    liftComm_chaining q hq_range hq_ker hik (by omega : i ≠ m) hij (by omega : k ≠ m) hjk.symm
      (by omega : m ≠ j) a b]
  exact commutatorElement_eq_liftComm q hq_range hq_ker hij hjk
    (map_liftGen q hq_range hij a) (map_liftGen q hq_range hjk b)

private theorem liftGen_commute (hq_ker : q.ker ≤ center E) {i j k l : ℕ}
    (hij : i ≠ j) (hkl : k ≠ l) (hjk : j ≠ k) (hil : i ≠ l) (a b : R) :
    Commute (liftGen q hq_range i j a) (liftGen q hq_range k l b) := by
  let p := max (max i j) (max k l) + 1
  rw [liftGen_eq_liftComm q hq_range hq_ker hkl (by omega : k ≠ p) (by omega : p ≠ l) b]
  exact q.commute_commutatorElement_of_ker_le_center hq_ker
    (by rw [map_liftGen q hq_range hij, map_liftElem]
        exact commute_stableTransvection hij (by omega) hjk (by omega) a b)
    (by rw [map_liftGen q hq_range hij, map_liftElem]
        exact commute_stableTransvection hij (by omega) (by omega) hil a 1)

private theorem liftGen_add (hq_ker : q.ker ≤ center E) {i j : ℕ} (hij : i ≠ j) (a b : R) :
    liftGen q hq_range i j a * liftGen q hq_range i j b = liftGen q hq_range i j (a + b) := by
  let k := max i j + 1
  have hik : i ≠ k := by omega
  have hkj : k ≠ j := by omega
  have hprod : ∀ x y : R,
      liftGen q hq_range i j (x + y) = liftGen q hq_range i j y * liftGen q hq_range i j x := by
    intro x y
    let A := liftGen q hq_range i k x
    let B := liftGen q hq_range i k y
    let C := liftGen q hq_range k j 1
    have hqAB : q (A * B) = stableTransvection hik (x + y) := by
      rw [map_mul, map_liftGen q hq_range hik, map_liftGen q hq_range hik, stableTransvection_add]
    have hAB_C : liftGen q hq_range i j (x + y) = ⁅A * B, C⁆ := by
      rw [liftGen_eq_liftComm q hq_range hq_ker hij hik hkj (x + y)]
      exact (commutatorElement_eq_liftComm q hq_range hq_ker hik hkj hqAB
        (map_liftGen q hq_range hkj 1)).symm
    have hAC : ⁅A, C⁆ = liftGen q hq_range i j x := by
      simpa [A, C, mul_one] using liftGen_chevalley q hq_range hq_ker hik hkj hij x 1
    have hBC : ⁅B, C⁆ = liftGen q hq_range i j y := by
      simpa [B, C, mul_one] using liftGen_chevalley q hq_range hq_ker hik hkj hij y 1
    have hcomm : Commute A (liftGen q hq_range i j y) :=
      liftGen_commute q hq_range hq_ker hik hij hik.symm hij x y
    rw [hAB_C, commutatorElement_mul_left_eq_conj_mul, hAC, hBC, hcomm.eq, mul_inv_cancel_right]
  rw [add_comm, hprod b a]

end LiftConstruction

/-- **Kervaire–Steinberg lifting theorem**: for any group `E` (in any universe) and any homomorphism
`q : E →* GL_∞(R)` with image `E_∞(R)` and central kernel, there is a unique homomorphism
`ψ : St(R) →* E` with `q ∘ ψ = stableToGL R`. -/
theorem existsUnique_lift_of_range_eq_elementarySubgroup_of_ker_le_center
    {E : Type v} [Group E] (q : E →* StableGeneralLinearGroup R)
    (hq_range : q.range = StableGeneralLinearGroup.elementarySubgroup R)
    (hq_ker : q.ker ≤ center E) :
    ∃! ψ : SteinbergGroup ℕ R →* E, q.comp ψ = stableToGL R := by
  refine ⟨lift (fun i j _ a ↦ liftGen q hq_range i j a)
    (fun _ _ hij a b ↦ liftGen_add q hq_range hq_ker hij a b)
    (fun _ _ _ _ hij hkl hjk hil a b ↦ liftGen_commute q hq_range hq_ker hij hkl hjk hil a b)
    (fun _ _ _ hij hjk hik a b ↦ liftGen_chevalley q hq_range hq_ker hij hjk hik a b), ?_, ?_⟩
  · ext i j hij a
    simp [map_liftGen q hq_range hij]
  · intro ψ hψ
    refine MonoidHom.eq_of_comp_eq_of_ker_le_center hq_ker ?_
    rw [hψ]
    ext i j hij a
    simp [map_liftGen q hq_range hij]

variable (R) in
/-- **Kervaire–Steinberg theorem**: `St(R) →* E_∞(R)` is a universal central extension of the
perfect group `E_∞(R)` (Milnor §5, Theorem 5.10; Weibel, Chapter III, Theorem 5.5). -/
theorem isUniversalCentralExtension_stableToElementary :
    (stableToElementary R).IsUniversalCentralExtension.{v} where
  isCentralExtension := isCentralExtension_stableToElementary
  existsUnique_comp_eq := by
    intro E _ q hq
    let ι := (StableGeneralLinearGroup.elementarySubgroup R).subtype
    have hrange : (ι.comp q).range = StableGeneralLinearGroup.elementarySubgroup R := by
      rw [MonoidHom.range_comp, MonoidHom.range_eq_top_of_surjective q hq.surjective,
        Subgroup.map_top, Subgroup.range_subtype]
    have hker : (ι.comp q).ker ≤ center E := fun x hx ↦
      hq.ker_le_center (MonoidHom.mem_ker.mpr (Subtype.ext (MonoidHom.mem_ker.mp hx)))
    obtain ⟨ψ, hψ, huniq⟩ :=
      existsUnique_lift_of_range_eq_elementarySubgroup_of_ker_le_center (ι.comp q) hrange hker
    have hcomp_iff : ∀ f : SteinbergGroup ℕ R →* E,
        q.comp f = stableToElementary R ↔ (ι.comp q).comp f = stableToGL R := fun f ↦ by
      constructor
      · intro hf
        rw [MonoidHom.comp_assoc, hf]
        rfl
      · intro hf
        ext i j hij a
        exact DFunLike.congr_fun hf (of hij a)
    exact ⟨ψ, (hcomp_iff ψ).mpr hψ, fun f hf ↦ huniq f ((hcomp_iff f).mp hf)⟩

end UniversalCentralExtension

end SteinbergGroup

/-- **Kervaire–Steinberg theorem** (Weibel, *The K-book*, Chapter III, Theorems 5.2.1 and 5.5):
for every associative ring `R`, the canonical homomorphism `φ : St(R) →* GL_∞(R)` sending
`x_{ij}(a)` to `e_{ij}(a)` has image `E_∞(R)` and central kernel, and for every group `E` (in any
universe) and homomorphism `q : E →* GL_∞(R)` with image `E_∞(R)` and central kernel there is a
unique homomorphism `ψ : St(R) →* E` satisfying `q ∘ ψ = φ`. -/
theorem steinberg_universalCentralExtension (R : Type u) [Ring R] :
    ∃ φ : SteinbergGroup ℕ R →* StableGeneralLinearGroup R,
      (∀ (i j : ℕ) (hij : i ≠ j) (a : R), φ (SteinbergGroup.of hij a) = stableTransvection hij a) ∧
      φ.range = StableGeneralLinearGroup.elementarySubgroup R ∧
      φ.ker ≤ center (SteinbergGroup ℕ R) ∧
      ∀ (E : Type v) [Group E] (q : E →* StableGeneralLinearGroup R),
        q.range = StableGeneralLinearGroup.elementarySubgroup R →
        q.ker ≤ center E →
        ∃! ψ : SteinbergGroup ℕ R →* E, q.comp ψ = φ :=
  ⟨SteinbergGroup.stableToGL R, fun _ _ ↦ SteinbergGroup.stableToGL_of,
    SteinbergGroup.range_stableToGL, SteinbergGroup.ker_stableToGL_le_center,
    fun _ _ q hrange hker ↦
      SteinbergGroup.existsUnique_lift_of_range_eq_elementarySubgroup_of_ker_le_center q
        hrange hker⟩

end TauCeti
