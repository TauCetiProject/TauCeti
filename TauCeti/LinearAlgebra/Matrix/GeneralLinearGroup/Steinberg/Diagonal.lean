/-!
# Diagonal elements of `K₂` are products of Steinberg symbols

Let `R` be a ring whose units commute. The diagonal subgroup `H ⊆ St(R)` of the Steinberg group is
generated by the diagonal elements `h_{ij}(u)`, which lift the diagonal matrices with `u` at `i`
and `u⁻¹` at `j`. This file proves that **every element of `K₂(R)` lying in `H` is a product of
Steinberg symbols** `{u, v}` (Milnor, §9; Steinberg), and conversely, so that `K₂(R) ∩ H` is the
subgroup generated by the symbols.

The proof works modulo the subgroup `S ⊆ St(R)` generated by the Steinberg symbols, which is
central because `K₂(R)` is. For pairwise distinct indices and commuting units `u` and `v`, the
commutator `⁅h_{ij}(u), h_{ik}(v)⁆` is the symbol `{u, v}`
(`TauCeti.SteinbergGroup.commutatorElement_h_h_eq_steinbergSymbol`). From here on all units of `R`
commute. Then modulo `S` each `h_{ij}` is multiplicative, `h_{ji}(u) ≡ h_{ij}(u⁻¹)`, and, from the
identity `h_{ik}(-u) h_{ik}(-1)⁻¹ = h_{jk}(u⁻¹)⁻¹ h_{ij}(u)` obtained by conjugating with the Weyl
element `w_{jk}(1)`, also `h_{ik}(u) ≡ h_{jk}(u) h_{ij}(u)`. So modulo `S` every element of `H` is a
product `∏_{k ≠ 0} h_{k0}(d_k)` of pairwise commuting factors. Its image in `GL_∞(R)` is the
diagonal matrix with entries `d_k` at `k ≠ 0`, so if the element lies in `K₂(R)` then every
`d_k = 1`, and the element lies in `S`.

## Main results

* `TauCeti.AlgebraicK2.mem_symbolSubgroup_of_mem_diagonalSubgroup`: if the units of `R` commute,
  an element of `K₂(R)` in the diagonal subgroup is a product of Steinberg symbols.
* `TauCeti.AlgebraicK2.mem_symbolSubgroup_iff_mem_diagonalSubgroup`: if the units of `R` commute,
  an element of `K₂(R)` is a product of Steinberg symbols exactly when it lies in the diagonal
  subgroup.

## References

* J. Milnor, *Introduction to Algebraic K-Theory*, Annals of Mathematics Studies 72 (1971), §9.
* R. Steinberg, *Générateurs, relations et revêtements de groupes algébriques*, Colloque sur la
  théorie des groupes algébriques (Bruxelles, 1962).
* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter III, §5.
-/

public section

noncomputable section

open Matrix

open scoped commutatorElement

namespace TauCeti

/-! ## The diagonal subgroup modulo symbols -/

namespace SteinbergGroup

open IndexedSteinbergGroup

variable {R : Type*} [Ring R]

/-- The normal subgroup of `St(R)` generated by the Steinberg symbols. -/
private def symbolNormal (R : Type*) [Ring R] : Subgroup (SteinbergGroup R) :=
  (AlgebraicK2.symbolSubgroup R).map (toStableGL R).ker.subtype

private theorem symbolNormal_le_ker : symbolNormal R ≤ (toStableGL R).ker :=
  Subgroup.map_subtype_le _

private instance : (symbolNormal R).Normal :=
  Subgroup.normal_of_le_center (symbolNormal_le_ker.trans ker_toStableGL_le_center)

/-- The quotient map `St(R) →* St(R) / S` by the subgroup `S` generated by the symbols. -/
private abbrev mkSymbol : SteinbergGroup R →* SteinbergGroup R ⧸ symbolNormal R :=
  QuotientGroup.mk' _

private theorem mkSymbol_commutatorElement_h_h {i j k : ℕ} (hij : i ≠ j) (hik : i ≠ k)
    (hjk : j ≠ k) {u v : Rˣ} (huv : Commute u v) : mkSymbol ⁅h hij u, h hik v⁆ = 1 := by
  rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff,
    commutatorElement_h_h_eq_steinbergSymbol hij hik hjk huv]
  exact Subgroup.mem_map_of_mem _ (AlgebraicK2.steinbergSymbol_mem_symbolSubgroup _)

/-! From here on the units of `R` commute, which is all the diagonal argument needs. -/

variable [IsMulCommutative Rˣ]

open scoped IsMulCommutative

/-- Modulo the symbols, `h_{ij}` is multiplicative. -/
private theorem mkSymbol_h_mul {i j : ℕ} (hij : i ≠ j) (u v : Rˣ) :
    mkSymbol (h hij (u * v)) = mkSymbol (h hij u) * mkSymbol (h hij v) := by
  have hik : i ≠ i + j + 1 := by omega
  have hjk : j ≠ i + j + 1 := by omega
  rw [mul_comm' u v, h_mul hij hik hjk, map_mul, map_mul, map_inv,
    mkSymbol_commutatorElement_h_h hij hik hjk (mul_comm' u v), inv_one, one_mul]

private theorem mkSymbol_h_inv {i j : ℕ} (hij : i ≠ j) (u : Rˣ) :
    mkSymbol (h hij u⁻¹) = (mkSymbol (h hij u))⁻¹ := by
  rw [eq_inv_iff_mul_eq_one, ← mkSymbol_h_mul, inv_mul_cancel, h_one, map_one]

/-- Modulo the symbols, `h_{ij}(-u) h_{ij}(-1)⁻¹ ≡ h_{ij}(u)`. -/
private theorem mkSymbol_h_neg_mul_h_neg_one_inv {i j : ℕ} (hij : i ≠ j) (u : Rˣ) :
    mkSymbol (h hij (-u) * (h hij (-1))⁻¹) = mkSymbol (h hij u) := by
  rw [map_mul, map_inv, ← mul_neg_one u, mkSymbol_h_mul, mul_inv_cancel_right]

/-- Modulo the symbols, `h_{ji}(u) ≡ h_{ij}(u⁻¹)`. -/
private theorem mkSymbol_h_symm {i j : ℕ} (hij : i ≠ j) (u : Rˣ) :
    mkSymbol (h hij.symm u) = mkSymbol (h hij u⁻¹) := by
  have hik : i ≠ i + j + 1 := by omega
  have hjk : j ≠ i + j + 1 := by omega
  have hw : w hij.symm u = w hij (-u⁻¹) := by
    rw [← w_symm_neg_inv hij hik hjk (-u⁻¹), inv_neg, inv_inv, neg_neg]
  have hw₁ : w hij.symm (-1 : Rˣ) = w hij 1 := by
    rw [← w_symm_neg_inv hij hik hjk (1 : Rˣ), inv_one]
  rw [h_def, hw, hw₁, w_mul_w, mkSymbol_h_neg_mul_h_neg_one_inv]

/-- Modulo the symbols, `h_{mb}(u) ≡ h_{ab}(u) h_{ma}(u)` for pairwise distinct `m, a, b`. -/
private theorem mkSymbol_h_eq_mul {a b m : ℕ} (hab : a ≠ b) (hma : m ≠ a) (hmb : m ≠ b)
    (u : Rˣ) :
    mkSymbol (h hmb u) = mkSymbol (h hab u) * mkSymbol (h hma u) := by
  rw [← mkSymbol_h_neg_mul_h_neg_one_inv, h_neg_mul_h_neg_one_inv hma hmb hab u, map_mul, map_inv,
    mkSymbol_h_inv, inv_inv]

/-- The homomorphism `u ↦ h_{k0}(u)` modulo the symbols, for `k ≠ 0`; it is trivial for `k = 0`. -/
private def diagHom (k : ℕ) : Rˣ →* SteinbergGroup R ⧸ symbolNormal R :=
  if hk : k = 0 then 1 else MonoidHom.mk' (fun u ↦ mkSymbol (h hk u)) (mkSymbol_h_mul hk)

private theorem diagHom_zero : diagHom (R := R) 0 = 1 := by
  simp [diagHom]

private theorem diagHom_apply_of_ne {k : ℕ} (hk : k ≠ 0) (u : Rˣ) :
    diagHom k u = mkSymbol (h hk u) := by
  simp [diagHom, hk]

private theorem commute_diagHom {k l : ℕ} (hkl : k ≠ l) (a b : Rˣ) :
    Commute (diagHom (R := R) k a) (diagHom l b) := by
  rcases eq_or_ne k 0 with rfl | hk
  · rw [diagHom_zero]
    exact Commute.one_left _
  rcases eq_or_ne l 0 with rfl | hl
  · rw [diagHom_zero]
    exact Commute.one_right _
  rw [diagHom_apply_of_ne hk, diagHom_apply_of_ne hl, mkSymbol_h_symm hk.symm,
    mkSymbol_h_symm hl.symm, ← commutatorElement_eq_one_iff_commute, ← map_commutatorElement]
  exact mkSymbol_commutatorElement_h_h hk.symm hl.symm hkl (mul_comm' _ _)

/-- Modulo the symbols, `h_{ij}(u) ≡ h_{i0}(u) h_{j0}(u⁻¹)`, reading `h_{00}` as trivial. -/
private theorem mkSymbol_h_eq_diagHom_mul {i j : ℕ} (hij : i ≠ j) (u : Rˣ) :
    mkSymbol (h hij u) = diagHom i u * diagHom j u⁻¹ := by
  rcases eq_or_ne i 0 with rfl | hi
  · rw [diagHom_zero, MonoidHom.one_apply, one_mul, diagHom_apply_of_ne hij.symm,
      ← mkSymbol_h_symm hij.symm]
  rcases eq_or_ne j 0 with rfl | hj
  · rw [diagHom_zero, MonoidHom.one_apply, mul_one, diagHom_apply_of_ne hi]
  rw [(commute_diagHom hij u u⁻¹).eq, diagHom_apply_of_ne hi, diagHom_apply_of_ne hj,
    mkSymbol_h_inv, mkSymbol_h_eq_mul hj hij hi u, inv_mul_cancel_left]

/-- The products `∏_{k < n} h_{k0}(d_k)` modulo the symbols. -/
private def diagProd (n : ℕ) : (Fin n → Rˣ) →* SteinbergGroup R ⧸ symbolNormal R :=
  MonoidHom.noncommPiCoprod (fun k : Fin n ↦ diagHom k) fun _ _ hkl ↦
    commute_diagHom (Fin.val_ne_of_ne hkl)

/-- `diagProd` sends `Pi.mulSingle k u` to `h_{k0}(u)`. Unfolding `diagProd` and rewriting with
`MonoidHom.noncommPiCoprod_mulSingle` directly fails, since the unfolded commutation proof no longer
has the `Pairwise` type that the rewrite expects. -/
private theorem diagProd_mulSingle {n : ℕ} (k : Fin n) (u : Rˣ) :
    diagProd n (Pi.mulSingle k u) = diagHom k u :=
  MonoidHom.noncommPiCoprod_mulSingle (fun k : Fin n ↦ diagHom (R := R) k) k u

/-- Modulo the symbols, every element of the diagonal subgroup is a product `∏_{k < n} h_{k0}(d_k)`
for all large `n`. -/
private theorem exists_diagProd_eq {x : SteinbergGroup R} (hx : x ∈ diagonalSubgroup R) :
    ∃ n₀, ∀ n ≥ n₀, ∃ d : Fin n → Rˣ, mkSymbol x = diagProd n d := by
  rw [diagonalSubgroup_def] at hx
  induction hx using Subgroup.closure_induction with
  | mem _ hg =>
    obtain ⟨i, j, hij, u, rfl⟩ := hg
    refine ⟨max i j + 1, fun n hn ↦ ⟨Pi.mulSingle ⟨i, by omega⟩ u *
      Pi.mulSingle ⟨j, by omega⟩ u⁻¹, ?_⟩⟩
    rw [map_mul, diagProd_mulSingle, diagProd_mulSingle, mkSymbol_h_eq_diagHom_mul]
  | one => exact ⟨0, fun n _ ↦ ⟨1, by rw [map_one, map_one]⟩⟩
  | mul x y _ _ hx hy =>
    obtain ⟨n₁, h₁⟩ := hx
    obtain ⟨n₂, h₂⟩ := hy
    refine ⟨max n₁ n₂, fun n hn ↦ ?_⟩
    obtain ⟨d₁, hd₁⟩ := h₁ n (le_of_max_le_left hn)
    obtain ⟨d₂, hd₂⟩ := h₂ n (le_of_max_le_right hn)
    exact ⟨d₁ * d₂, by rw [map_mul, map_mul, hd₁, hd₂]⟩
  | inv x _ hx =>
    obtain ⟨n₀, h₀⟩ := hx
    refine ⟨n₀, fun n hn ↦ ?_⟩
    obtain ⟨d, hd⟩ := h₀ n hn
    exact ⟨d⁻¹, by rw [map_inv, map_inv, hd]⟩

/-- The projection `St(R) / S →* GL_∞(R)` induced by `St(R) →* GL_∞(R)`. -/
private abbrev toStableGLSymbol :
    SteinbergGroup R ⧸ symbolNormal R →* StableGeneralLinearGroup R :=
  QuotientGroup.lift _ (toStableGL R) symbolNormal_le_ker

/-- The image of a single factor `h_{k0}(u)` in `GL_∞(R)`, reading `h_{00}` as trivial, is the
diagonal matrix with `u` at `k` and `u⁻¹` at `0`. -/
private theorem toStableGLSymbol_diagProd_mulSingle {n : ℕ} (k : Fin (n + 1)) (u : Rˣ) :
    toStableGLSymbol (diagProd (n + 1) (Pi.mulSingle k u)) =
      StableGeneralLinearGroup.of R (n + 1) (diagGL (Pi.mulSingle k u * Pi.mulSingle 0 u⁻¹)) := by
  rw [diagProd_mulSingle]
  rcases eq_or_ne (k : ℕ) 0 with hk | hk
  · obtain rfl : k = 0 := Fin.ext hk
    rw [Fin.val_zero, diagHom_zero, MonoidHom.one_apply, map_one, ← Pi.mulSingle_mul,
      mul_inv_cancel, Pi.mulSingle_one, map_one, map_one]
  · rw [diagHom_apply_of_ne hk, QuotientGroup.mk'_apply, QuotientGroup.lift_mk,
      toStableGL_h hk u k.isLt (Nat.zero_lt_succ n), Fin.eta, Fin.mk_zero]

/-- The image of `∏_{k ≤ n} h_{k0}(d_k)` in `GL_∞(R)` is the diagonal matrix with entries `d_k`
at `k ≠ 0`, and the inverse of their product at `0`. -/
private theorem toStableGLSymbol_diagProd {n : ℕ} (d : Fin (n + 1) → Rˣ) :
    toStableGLSymbol (diagProd (n + 1) d) =
      StableGeneralLinearGroup.of R (n + 1) (diagGL (d * Pi.mulSingle 0 (∏ k, d k)⁻¹)) := by
  -- Both sides are homomorphisms in `d` that agree on single-coordinate functions.
  let φ : (Fin (n + 1) → Rˣ) →* (Fin (n + 1) → Rˣ) :=
    MonoidHom.id _ * (MonoidHom.mulSingle (fun _ ↦ Rˣ) 0).comp
      (∏ k, Pi.evalMonoidHom (fun _ ↦ Rˣ) k)⁻¹
  have hφ (e : Fin (n + 1) → Rˣ) : φ e = e * Pi.mulSingle 0 (∏ k, e k)⁻¹ := by
    simp only [φ, MonoidHom.mul_apply, MonoidHom.id_apply, MonoidHom.comp_apply,
      MonoidHom.inv_apply, MonoidHom.finsetProd_apply, Pi.evalMonoidHom_apply,
      MonoidHom.mulSingle_apply]
  have key : toStableGLSymbol.comp (diagProd (n + 1)) =
      (StableGeneralLinearGroup.of R (n + 1)).comp (diagGL.comp φ) := by
    refine MonoidHom.pi_ext fun k u ↦ ?_
    rw [MonoidHom.comp_apply, toStableGLSymbol_diagProd_mulSingle, MonoidHom.comp_apply,
      MonoidHom.comp_apply, hφ, Fintype.prod_pi_mulSingle']
  rw [← MonoidHom.comp_apply, key, MonoidHom.comp_apply, MonoidHom.comp_apply, hφ]

end SteinbergGroup

namespace AlgebraicK2

open SteinbergGroup IndexedSteinbergGroup

variable {R : Type*} [Ring R] [IsMulCommutative Rˣ]

open scoped IsMulCommutative

/-- **Diagonal elements of `K₂` are products of symbols.** Over a ring `R` whose units commute,
an element of `K₂(R)` that lies in the diagonal subgroup of `St(R)`, generated by the elements
`h_{ij}(u)`, lies in the subgroup generated by the Steinberg symbols. -/
theorem mem_symbolSubgroup_of_mem_diagonalSubgroup {x : AlgebraicK2 R}
    (hx : (x : SteinbergGroup R) ∈ diagonalSubgroup R) : x ∈ symbolSubgroup R := by
  obtain ⟨n₀, hn⟩ := exists_diagProd_eq hx
  obtain ⟨d, hd⟩ := hn (n₀ + 1) (Nat.le_succ n₀)
  -- The image of `∏ h_{k0}(d_k)` in `GL_∞(R)` is trivial, so every `d_k` with `k ≠ 0` is `1`.
  have himg : toStableGLSymbol (diagProd (n₀ + 1) d) = 1 := by
    rw [← hd, QuotientGroup.mk'_apply, QuotientGroup.lift_mk]
    exact x.property
  rw [toStableGLSymbol_diagProd, ← map_one (StableGeneralLinearGroup.of R (n₀ + 1)),
    ← map_one diagGL] at himg
  have hE := diagGL_injective (StableGeneralLinearGroup.of_injective _ himg)
  have hd₀ : d = Pi.mulSingle 0 (d 0) := by
    ext1 m
    rcases eq_or_ne m 0 with rfl | hm
    · rw [Pi.mulSingle_eq_same]
    · have := congrFun hE m
      rw [Pi.mul_apply, Pi.mulSingle_eq_of_ne hm, mul_one, Pi.one_apply] at this
      rw [this, Pi.mulSingle_eq_of_ne hm]
  have h₁ : mkSymbol (x : SteinbergGroup R) = 1 := by
    rw [hd, hd₀, diagProd_mulSingle, Fin.val_zero, diagHom_zero, MonoidHom.one_apply]
  rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h₁
  -- `h₁` says that `x` lies in the preimage of `S` under the inclusion of `K₂(R)`.
  have h₂ : x ∈ (symbolNormal R).comap (toStableGL R).ker.subtype := h₁
  rwa [symbolNormal, Subgroup.comap_map_eq_self_of_injective (Subgroup.subtype_injective _)] at h₂

/-- **Diagonal elements of `K₂` are exactly the products of symbols.** Over a ring `R` whose units
commute, an element of `K₂(R)` lies in the subgroup generated by the Steinberg symbols exactly
when it lies in the diagonal subgroup of `St(R)`. -/
theorem mem_symbolSubgroup_iff_mem_diagonalSubgroup {x : AlgebraicK2 R} :
    x ∈ symbolSubgroup R ↔ (x : SteinbergGroup R) ∈ diagonalSubgroup R :=
  ⟨mem_diagonalSubgroup_of_mem_symbolSubgroup, mem_symbolSubgroup_of_mem_diagonalSubgroup⟩

end AlgebraicK2

end TauCeti
