module

public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Steinberg.Basic

/-!
# Steinberg groups of a quotient ring

Let `f : R →+* S` be a surjective homomorphism of associative unital rings, with kernel `I`. The
induced homomorphism of Steinberg groups `St_ι(f) : St_ι(R) →* St_ι(S)`, which sends the root
`x_{ij}(a)` to `x_{ij}(f a)`, is surjective, and its kernel is the normal subgroup generated by
the roots `x_{ij}(a)` with coefficient `a ∈ I`. In other words

  `St_ι(R) ⧸ ⟨⟨x_{ij}(a) | a ∈ I⟩⟩ ≃* St_ι(S)`.

The proof compares root presentations. Modulo the normal closure of the roots with coefficient in
`I`, each root `x_{ij}(a)` depends only on the class of `a` modulo `I`, because
`x_{ij}(a + c) = x_{ij}(a) x_{ij}(c)`. Hence choosing any preimages of the coefficients defines
a homomorphism `St_ι(S) →* St_ι(R) ⧸ ⟨⟨x_{ij}(a) | a ∈ I⟩⟩` out of the root presentation of
`St_ι(S)`: the additivity, distant-commutation and Chevalley commutator relations of `St_ι(S)`
lift to relations which hold modulo the normal closure. This homomorphism is inverse to the one
induced by `St_ι(f)`.

Taking `ι = ℕ` gives the statement for the stable Steinberg group `TauCeti.SteinbergGroup R`,
which is `St_ℕ(R)` by definition. No relative Steinberg group or relative `K₂` enters here: the
normal closure is a subgroup of `St_ι(R)` itself. This presentation calculation is the input for
connecting homomorphisms such as `K₂(R/I) → K₁(R, I)`, which lift Steinberg words along
`St(R) → St(R/I)`.

## Main definitions

* `TauCeti.IndexedSteinbergGroup.rootNormalClosure ι s`: the normal subgroup of `St_ι(R)`
  generated by the roots `x_{ij}(a)` with `a ∈ s`.
* `TauCeti.IndexedSteinbergGroup.quotientRootNormalClosureEquivOfSurjective`: for a surjective
  ring homomorphism `f`, the isomorphism `St_ι(R) ⧸ ⟨⟨x_{ij}(a) | f a = 0⟩⟩ ≃* St_ι(S)` induced by
  `St_ι(f)`.

## Main results

* `TauCeti.IndexedSteinbergGroup.rootNormalClosure_le_iff`: a normal subgroup contains the root
  normal closure of `s` exactly when it contains every root with coefficient in `s`.
* `TauCeti.IndexedSteinbergGroup.mk_x_eq_mk_x_of_sub_mem`: modulo the root normal closure of
  `s`, the roots `x_{ij}(a)` and `x_{ij}(b)` agree when `b - a ∈ s`.
* `TauCeti.IndexedSteinbergGroup.map_rootNormalClosure`: a surjective ring homomorphism carries
  the root normal closure of `s` onto that of the image of `s`.
* `TauCeti.IndexedSteinbergGroup.ker_map_of_surjective`: for surjective `f`, the kernel of
  `St_ι(f)` is the root normal closure of the kernel of `f`.
* `TauCeti.IndexedSteinbergGroup.quotientRootNormalClosureEquivOfSurjective_symm_map`: the
  inverse isomorphism lifts `St_ι(f)(z)` to the class of `z`.
* `TauCeti.IndexedSteinbergGroup.quotientRootNormalClosureEquivOfSurjective_map`: the quotient
  isomorphisms are natural for commutative squares of ring homomorphisms.

## References

* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter III, Definition 5.1 (the root presentation) and §§5.7–5.8
  (the Steinberg groups of `R` and `R/I` in the relative exact sequence).
-/

public section

noncomputable section

open scoped commutatorElement

namespace TauCeti

namespace IndexedSteinbergGroup

variable {ι R S : Type*} [Ring R] [Ring S]

/-! ### The normal closure of the roots with coefficients in a set -/

variable (ι) in
/-- The **root normal closure** of a set `s ⊆ R`: the normal subgroup of `St_ι(R)` generated by
the roots `x_{ij}(a)` with coefficient `a ∈ s`. For `s` the kernel of a surjective ring
homomorphism `f` it is the kernel of `St_ι(f)` (`ker_map_of_surjective`). -/
def rootNormalClosure (s : Set R) : Subgroup (IndexedSteinbergGroup ι R) :=
  Subgroup.normalClosure {z | ∃ (i j : ι) (hij : i ≠ j) (a : R), a ∈ s ∧ x hij a = z}

instance rootNormalClosure_normal (s : Set R) : (rootNormalClosure ι s).Normal :=
  Subgroup.normalClosure_normal

theorem x_mem_rootNormalClosure {s : Set R} {i j : ι} (hij : i ≠ j) {a : R} (ha : a ∈ s) :
    x hij a ∈ rootNormalClosure ι s :=
  Subgroup.subset_normalClosure ⟨i, j, hij, a, ha, rfl⟩

/-- A normal subgroup contains the root normal closure of `s` exactly when it contains every root
`x_{ij}(a)` with `a ∈ s`. -/
theorem rootNormalClosure_le_iff {s : Set R} {N : Subgroup (IndexedSteinbergGroup ι R)}
    [N.Normal] :
    rootNormalClosure ι s ≤ N ↔ ∀ ⦃i j : ι⦄ (hij : i ≠ j) ⦃a : R⦄, a ∈ s → x hij a ∈ N := by
  refine ⟨fun h _ _ hij _ ha ↦ h (x_mem_rootNormalClosure hij ha), fun h ↦ ?_⟩
  refine Subgroup.normalClosure_le_normal ?_
  rintro _ ⟨i, j, hij, a, ha, rfl⟩
  exact h hij ha

@[gcongr]
theorem rootNormalClosure_mono {s t : Set R} (hst : s ⊆ t) :
    rootNormalClosure ι s ≤ rootNormalClosure ι t :=
  rootNormalClosure_le_iff.2 fun _ _ hij _ ha ↦ x_mem_rootNormalClosure hij (hst ha)

/-- Every root has a coefficient in `Set.univ`, so its root normal closure is everything. -/
@[simp]
theorem rootNormalClosure_univ : rootNormalClosure ι (Set.univ : Set R) = ⊤ :=
  subgroup_eq_top_iff.2 fun _ _ hij a ↦ x_mem_rootNormalClosure hij (Set.mem_univ a)

/-- The roots with coefficient `0` are trivial, so their root normal closure is trivial. -/
@[simp]
theorem rootNormalClosure_singleton_zero : rootNormalClosure ι ({0} : Set R) = ⊥ := by
  refine Subgroup.normalClosure_eq_bot_iff.2 ?_
  rintro _ ⟨i, j, hij, a, rfl, rfl⟩
  exact x_zero hij

/-- Modulo the root normal closure of `s`, the roots `x_{ij}(a)` and `x_{ij}(b)` agree as soon as
`b - a ∈ s`: the root `x_{ij}(a)` depends only on the class of `a` modulo `s`. -/
theorem mk_x_eq_mk_x_of_sub_mem {s : Set R} {i j : ι} (hij : i ≠ j) {a b : R} (h : b - a ∈ s) :
    (x hij a : IndexedSteinbergGroup ι R ⧸ rootNormalClosure ι s) = x hij b := by
  rw [QuotientGroup.eq, x_inv, ← x_add, neg_add_eq_sub]
  exact x_mem_rootNormalClosure hij h

/-! ### Naturality in the ring -/

/-- A ring homomorphism mapping `s` into `t` maps the root normal closure of `s` into that of
`t`. -/
theorem rootNormalClosure_le_comap_map (f : R →+* S) {s : Set R} {t : Set S}
    (h : Set.MapsTo f s t) :
    rootNormalClosure ι s ≤ (rootNormalClosure ι t).comap (map f) :=
  rootNormalClosure_le_iff.2 fun _ _ hij _ ha ↦ by
    rw [Subgroup.mem_comap, map_x]
    exact x_mem_rootNormalClosure hij (h ha)

/-- A surjective ring homomorphism carries the root normal closure of `s` onto the root normal
closure of the image of `s`. -/
theorem map_rootNormalClosure {f : R →+* S} (hf : Function.Surjective f) (s : Set R) :
    (rootNormalClosure ι s).map (map f) = rootNormalClosure ι (f '' s) := by
  rw [rootNormalClosure, Subgroup.map_normalClosure _ _ (map_surjective hf), rootNormalClosure]
  congr 1
  ext z
  simp only [Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨_, ⟨i, j, hij, a, ha, rfl⟩, rfl⟩
    exact ⟨i, j, hij, f a, ⟨a, ha, rfl⟩, (map_x f hij a).symm⟩
  · rintro ⟨i, j, hij, _, ⟨a, ha, rfl⟩, rfl⟩
    exact ⟨x hij a, ⟨i, j, hij, a, ha, rfl⟩, map_x f hij a⟩

/-- The roots with coefficient in the kernel of `f` lie in the kernel of `St_ι(f)`. -/
theorem rootNormalClosure_ker_le_ker_map (f : R →+* S) :
    rootNormalClosure ι (RingHom.ker f : Set R) ≤ (map (ι := ι) f).ker :=
  rootNormalClosure_le_iff.2 fun _ _ hij a ha ↦ by
    rw [MonoidHom.mem_ker, map_x, (RingHom.mem_ker).1 ha, x_zero]

/-- For a commutative square of ring homomorphisms `h ∘ f = f' ∘ g`, the homomorphism `St_ι(g)`
maps the root normal closure of the kernel of `f` into that of the kernel of `f'`. -/
theorem rootNormalClosure_ker_le_comap_map_of_comp_eq {R' S' : Type*} [Ring R'] [Ring S']
    {f : R →+* S} {f' : R' →+* S'} {g : R →+* R'} {h : S →+* S'} (hsq : h.comp f = f'.comp g) :
    rootNormalClosure ι (RingHom.ker f : Set R) ≤
      (rootNormalClosure ι (RingHom.ker f' : Set R')).comap (map g) :=
  rootNormalClosure_le_comap_map g fun a ha ↦ by
    rw [SetLike.mem_coe, RingHom.mem_ker] at ha ⊢
    rw [← RingHom.comp_apply, ← hsq, RingHom.comp_apply, ha, map_zero]

/-! ### The Steinberg group of a quotient ring -/

section Surjective

variable {f : R →+* S} (hf : Function.Surjective f)

/-- The root generator of `St_ι(S)` lifted to the quotient of `St_ι(R)` by the root normal
closure of the kernel, through a chosen preimage of the coefficient. -/
private def liftGen ⦃i j : ι⦄ (hij : i ≠ j) (b : S) :
    IndexedSteinbergGroup ι R ⧸ rootNormalClosure ι (RingHom.ker f : Set R) :=
  x hij (Function.surjInv hf b)

/-- Modulo the root normal closure of the kernel, a root only depends on the image of its
coefficient. -/
private theorem mk_x_eq_mk_x_of_map_eq {i j : ι} (hij : i ≠ j) {a b : R} (h : f a = f b) :
    (x hij a : IndexedSteinbergGroup ι R ⧸ rootNormalClosure ι (RingHom.ker f : Set R)) =
      x hij b :=
  mk_x_eq_mk_x_of_sub_mem hij (by rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, h, sub_self])

private theorem liftGen_eq {i j : ι} (hij : i ≠ j) {a : R} {b : S} (h : f a = b) :
    liftGen hf hij b = x hij a :=
  mk_x_eq_mk_x_of_map_eq hij (by rw [Function.surjInv_eq hf, h])

private theorem liftGen_add {i j : ι} (hij : i ≠ j) (b c : S) :
    liftGen hf hij (b + c) = liftGen hf hij b * liftGen hf hij c := by
  unfold liftGen
  rw [← QuotientGroup.mk_mul, ← x_add]
  exact mk_x_eq_mk_x_of_map_eq hij (by simp only [map_add, Function.surjInv_eq hf])

private theorem liftGen_mul {i j k : ι} (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (b c : S) :
    liftGen hf hik (b * c) = ⁅liftGen hf hij b, liftGen hf hjk c⁆ := by
  unfold liftGen
  rw [mk_x_eq_mk_x_of_map_eq hik (b := Function.surjInv hf b * Function.surjInv hf c)
    (by simp only [map_mul, Function.surjInv_eq hf]), ← commutatorElement_x hij hjk hik]
  simpa only [QuotientGroup.mk'_apply] using
    map_commutatorElement (QuotientGroup.mk' (rootNormalClosure ι (RingHom.ker f : Set R))) _ _

/-- The inverse of `St_ι(f)` on the quotient by the root normal closure of the kernel, defined
on the root presentation of `St_ι(S)` by lifting the coefficients. -/
private def quotientInv :
    IndexedSteinbergGroup ι S →*
      IndexedSteinbergGroup ι R ⧸ rootNormalClosure ι (RingHom.ker f : Set R) :=
  lift (liftGen hf) (fun _ _ hij b c ↦ liftGen_add hf hij b c)
    (fun _ _ _ _ hij hkl hjk hli _ _ ↦ by
      unfold liftGen
      simpa only [QuotientGroup.mk'_apply] using
        (commute_x hij hkl hjk hli _ _).map
          (QuotientGroup.mk' (rootNormalClosure ι (RingHom.ker f : Set R))))
    (fun _ _ _ hij hjk hik b c ↦ (liftGen_mul hf hij hjk hik b c).symm)

private theorem quotientInv_x {i j : ι} (hij : i ≠ j) (a : R) :
    quotientInv hf (x hij (f a)) = x hij a := by
  rw [quotientInv, lift_x, liftGen_eq hf hij rfl]

/-- **The Steinberg group of a quotient ring.** For a surjective ring homomorphism `f : R →+* S`,
the homomorphism `St_ι(f)` induces an isomorphism from the quotient of `St_ι(R)` by the normal
closure of the roots with coefficient in the kernel of `f` onto `St_ι(S)`. -/
def quotientRootNormalClosureEquivOfSurjective :
    IndexedSteinbergGroup ι R ⧸ rootNormalClosure ι (RingHom.ker f : Set R) ≃*
      IndexedSteinbergGroup ι S :=
  MonoidHom.toMulEquiv (QuotientGroup.lift _ (map f) (rootNormalClosure_ker_le_ker_map f))
    (quotientInv hf)
    (QuotientGroup.monoidHom_ext _ <| hom_ext fun _ _ hij a ↦ by
      simp [quotientInv_x])
    (hom_ext fun _ _ hij b ↦ by
      obtain ⟨a, rfl⟩ := hf b
      simp [quotientInv_x])

@[simp]
theorem quotientRootNormalClosureEquivOfSurjective_mk (z : IndexedSteinbergGroup ι R) :
    quotientRootNormalClosureEquivOfSurjective hf z = map f z :=
  QuotientGroup.lift_mk _ (rootNormalClosure_ker_le_ker_map f) z

@[simp]
theorem quotientRootNormalClosureEquivOfSurjective_symm_x {i j : ι} (hij : i ≠ j) (a : R) :
    (quotientRootNormalClosureEquivOfSurjective hf).symm (x hij (f a)) = x hij a :=
  quotientInv_x hf hij a

/-- The inverse of the quotient isomorphism sends `St_ι(f)(z)` to the class of `z`: this lifts
Steinberg words along `St_ι(R) → St_ι(S)`. -/
@[simp]
theorem quotientRootNormalClosureEquivOfSurjective_symm_map (z : IndexedSteinbergGroup ι R) :
    (quotientRootNormalClosureEquivOfSurjective hf).symm (map f z) = z :=
  (MulEquiv.symm_apply_eq _).2 (quotientRootNormalClosureEquivOfSurjective_mk hf z).symm

/-- **Naturality of the quotient isomorphism.** For a commutative square of ring homomorphisms
`h ∘ f = f' ∘ g` with `f` and `f'` surjective, the isomorphisms for `f` and `f'` intertwine the map
of quotients induced by `St_ι(g)` with `St_ι(h)`. -/
theorem quotientRootNormalClosureEquivOfSurjective_map {R' S' : Type*} [Ring R'] [Ring S']
    {f' : R' →+* S'} (hf' : Function.Surjective f') (g : R →+* R') (h : S →+* S')
    (hsq : h.comp f = f'.comp g)
    (z : IndexedSteinbergGroup ι R ⧸ rootNormalClosure ι (RingHom.ker f : Set R)) :
    quotientRootNormalClosureEquivOfSurjective hf'
        (QuotientGroup.map _ _ (map g) (rootNormalClosure_ker_le_comap_map_of_comp_eq hsq) z) =
      map h (quotientRootNormalClosureEquivOfSurjective hf z) := by
  induction z using QuotientGroup.induction_on with
  | H z =>
    rw [QuotientGroup.map_mk, quotientRootNormalClosureEquivOfSurjective_mk,
      quotientRootNormalClosureEquivOfSurjective_mk, map_map, map_map, hsq]

include hf in
/-- **The kernel of `St_ι(R) → St_ι(S)`.** For a surjective ring homomorphism `f`, the kernel of
`St_ι(f)` is the normal closure of the roots `x_{ij}(a)` with `f a = 0`. -/
theorem ker_map_of_surjective :
    (map (ι := ι) f).ker = rootNormalClosure ι (RingHom.ker f : Set R) := by
  refine le_antisymm (fun z hz ↦ ?_) (rootNormalClosure_ker_le_ker_map f)
  rw [← QuotientGroup.eq_one_iff, ← map_eq_one_iff _
    (quotientRootNormalClosureEquivOfSurjective (ι := ι) hf).injective,
    quotientRootNormalClosureEquivOfSurjective_mk]
  exact hz

end Surjective

end IndexedSteinbergGroup

end TauCeti
