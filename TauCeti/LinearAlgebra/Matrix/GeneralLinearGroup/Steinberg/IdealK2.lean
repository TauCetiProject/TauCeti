/-!
# The relative Steinberg group and the relative `K₂` of an ideal

Let `I` be a two-sided ideal of an associative unital ring `R`, and let `B = R ⊕ I` be the double
(`TwoSidedIdeal.double`), with the projection `pr : B → R`, the addition map `add : B → R` and the
diagonal section `R → B` of `pr`. Following Keune and Loday, the **relative Steinberg group**
`St(R, I)` is a quotient of the kernel `St'(R, I)` of `St(pr) : St(B) → St(R)`:

* `St'(R, I)` is the normal closure in `St(B)` of the generators `x_{ij}(0, v)` with `v ∈ I`
  (`TauCeti.IdealSteinbergGroup.kerFst_eq_normalClosure`);
* the *cross commutators* `⁅x_{ij}(0, u), x_{kl}(v, -v)⁆` with `u, v ∈ I` lie in `St'(R, I)` and in
  `K₂(B)`, hence in the center of `St(B)`. They generate a central subgroup `C`
  (`TauCeti.IdealSteinbergGroup.cross`), and `St(R, I) = St'(R, I) / C`.

The addition map kills `C`, so `St(add)` descends to a homomorphism `St(R, I) → St(R)`, whose range
is the normal closure in `St(R)` of the generators `x_{ij}(v)` with `v ∈ I`. The **relative `K₂`**
of the pair, `K₂(R, I)`, is the kernel of the composite `St(R, I) → St(R) → GL(R)`; as this
composite lands in the relative elementary group `E(R, I) ⊆ GL(R)`, it is the kernel of
`St(R, I) → E(R, I)` in Weibel's definition. It comes with the forgetful map `K₂(R, I) → K₂(R)`.
These are the groups on which the relative Dennis–Stein symbols, the relative exact sequence
`K₂(R, I) → K₂(R) → K₂(R/I) → K₁(R, I)` and Keune's presentation of `K₂(R, I)` are built.

Since the projection and the addition map are jointly injective on `B`, an element of `St'(R, I)`
lies in `K₂(B)` exactly when its image under the addition map lies in `K₂(R)`
(`TauCeti.SteinbergGroup.toStableGL_eq_one_iff_of_injective_prod`). Consequently `K₂(R, I)` is
central in `St(R, I)`, hence commutative, and it is the quotient of
`K₂'(R, I) = ker (K₂(pr) : K₂(B) → K₂(R))` by the cross commutators
(`TauCeti.idealAlgebraicK2.quotientEquiv`). Under this identification the forgetful map to `K₂(R)`
is induced by `K₂(add)`.

Everything is functorial in morphisms of pairs `(R, I) → (S, J)`, that is ring homomorphisms
`f : R →+* S` with `f(I) ⊆ J`, and `St(R, 0)` is trivial.

## Main definitions

* `TauCeti.IdealSteinbergGroup.kerFst`: the kernel `St'(R, I)` of `St(pr)`.
* `TauCeti.IdealSteinbergGroup.cross`: the subgroup `C` generated by the cross commutators,
  characterized by `TauCeti.IdealSteinbergGroup.cross_le_iff`.
* `TauCeti.IdealSteinbergGroup`: the relative Steinberg group `St(R, I) = St'(R, I) / C`.
* `TauCeti.IdealSteinbergGroup.toSteinbergGroup`: the homomorphism `St(R, I) → St(R)` induced by
  the addition map.
* `TauCeti.idealAlgebraicK2`: the relative `K₂(R, I)`, the kernel of `St(R, I) → GL(R)`, as a
  subgroup of `St(R, I)`.
* `TauCeti.idealAlgebraicK2.toAlgebraicK2`: the forgetful map `K₂(R, I) → K₂(R)`.
* `TauCeti.idealAlgebraicK2.kerFst`: the kernel `K₂'(R, I)` of `K₂(pr) : K₂(B) → K₂(R)`.
* `TauCeti.idealAlgebraicK2.quotientEquiv`: `K₂'(R, I) / C ≃* K₂(R, I)`.
* `TauCeti.IdealSteinbergGroup.map`, `TauCeti.idealAlgebraicK2.map`: functoriality in morphisms
  of pairs.

## Main results

* `TauCeti.IdealSteinbergGroup.kerFst_eq_normalClosure`: `St'(R, I)` is the normal closure of the
  generators `x_{ij}(0, v)`, `v ∈ I`.
* `TauCeti.IdealSteinbergGroup.cross_le_ker_toStableGL` and
  `TauCeti.IdealSteinbergGroup.cross_le_kerFst`: the cross commutators lie in `K₂(B)` and in
  `St'(R, I)`.
* `TauCeti.IdealSteinbergGroup.range_toSteinbergGroup`: the range of `St(R, I) → St(R)` is the
  normal closure of the generators `x_{ij}(v)`, `v ∈ I`; for `I = R` it is all of `St(R)`
  (`TauCeti.IdealSteinbergGroup.range_toSteinbergGroup_top`).
* `TauCeti.idealAlgebraicK2_le_center`: `K₂(R, I)` is central in `St(R, I)`.
* `TauCeti.idealAlgebraicK2.toAlgebraicK2_quotientEquiv_mk`: the identification with `K₂'(R, I)/C`
  is compatible with `K₂(add)`.
* `TauCeti.IdealSteinbergGroup.kerFst_bot`: `St'(R, 0)` is trivial, hence so are `St(R, 0)` and
  `K₂(R, 0)`.

## References

* F. Keune, *The relativization of K₂*, J. Algebra 54 (1978), 159–177.
* J.-L. Loday, *Cohomologie et groupe de Steinberg relatifs*, J. Algebra 54 (1978), 178–202.
* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter III, Definition 5.7 and Theorem 5.7.1.
-/

public section

noncomputable section

open Subgroup TwoSidedIdeal

open scoped commutatorElement

namespace TauCeti

universe u

namespace IdealSteinbergGroup

variable {R : Type u} [Ring R] (I : TwoSidedIdeal R)

/-! ### The kernel of the projection -/

/-- The kernel `St'(R, I)` of the homomorphism `St(R ⊕ I) →* St(R)` induced by the projection
`pr : R ⊕ I →+* R`. -/
def kerFst : Subgroup (SteinbergGroup I.double) :=
  (IndexedSteinbergGroup.map I.doubleFst).ker

instance : (kerFst I).Normal :=
  MonoidHom.normal_ker _

variable {I} in
@[simp]
theorem mem_kerFst_iff {z : SteinbergGroup I.double} :
    z ∈ kerFst I ↔ IndexedSteinbergGroup.map I.doubleFst z = 1 :=
  MonoidHom.mem_ker

/-- The generator `x_{ij}(0, v)` of `St(R ⊕ I)`, for `v ∈ I`, lies in `St'(R, I)`. -/
theorem x_doubleInr_mem_kerFst {i j : ℕ} (hij : i ≠ j) {v : R} (hv : v ∈ I) :
    IndexedSteinbergGroup.x hij (doubleInr hv) ∈ kerFst I := by
  simp

/-- **`St'(R, I)` is the normal closure of the generators `x_{ij}(0, v)`, `v ∈ I`.** -/
theorem kerFst_eq_normalClosure :
    kerFst I = normalClosure {z | ∃ (i j : ℕ) (hij : i ≠ j) (v : R) (hv : v ∈ I),
      IndexedSteinbergGroup.x hij (doubleInr hv) = z} := by
  set N := normalClosure {z | ∃ (i j : ℕ) (hij : i ≠ j) (v : R) (hv : v ∈ I),
    IndexedSteinbergGroup.x hij (doubleInr hv) = z}
  refine le_antisymm (fun z hz ↦ ?_) (normalClosure_le_normal ?_)
  · -- Modulo `N`, every generator `x_{ij}(r, x) = x_{ij}(r, 0) x_{ij}(0, x)` agrees with its
    -- image under the diagonal section of the projection, so the quotient map by `N` factors
    -- through the projection.
    have key : (QuotientGroup.mk' N).comp ((IndexedSteinbergGroup.map I.doubleDiag).comp
        (IndexedSteinbergGroup.map I.doubleFst)) = QuotientGroup.mk' N := by
      ext i j hij p
      have hp : IndexedSteinbergGroup.x hij (doubleInr (doubleSnd_sub_doubleFst_mem p)) ∈ N :=
        subset_normalClosure ⟨i, j, hij, _, _, rfl⟩
      conv_rhs => rw [← doubleDiag_add_doubleInr p]
      simpa [IndexedSteinbergGroup.x_add] using hp
    simpa [mem_kerFst_iff.1 hz] using (DFunLike.congr_fun key z).symm
  · rintro _ ⟨i, j, hij, v, hv, rfl⟩
    exact x_doubleInr_mem_kerFst I hij hv

/-! ### The cross commutators -/

/-- The subgroup `C` of `St(R ⊕ I)` generated by the **cross commutators**
`⁅x_{ij}(0, u), x_{kl}(v, -v)⁆` with `u, v ∈ I`; in the fibre product model of the double,
`(v, -v)` is the element `(v, 0)`. It lies in `K₂(R ⊕ I)`, hence is central
(`TauCeti.IdealSteinbergGroup.cross_le_center`) and equal to the normal closure of the cross
commutators (`TauCeti.IdealSteinbergGroup.normalClosure_eq_cross`). -/
def cross : Subgroup (SteinbergGroup I.double) :=
  closure {z | ∃ (i j k l : ℕ) (hij : i ≠ j) (hkl : k ≠ l) (u v : R) (hu : u ∈ I) (hv : v ∈ I),
    ⁅IndexedSteinbergGroup.x hij (doubleInr hu), IndexedSteinbergGroup.x hkl (doubleInl hv)⁆ = z}

/-- A cross commutator lies in the cross subgroup. -/
theorem commutatorElement_mem_cross {i j k l : ℕ} (hij : i ≠ j) (hkl : k ≠ l) {u v : R}
    (hu : u ∈ I) (hv : v ∈ I) :
    ⁅IndexedSteinbergGroup.x hij (doubleInr hu), IndexedSteinbergGroup.x hkl (doubleInl hv)⁆ ∈
      cross I :=
  subset_closure ⟨i, j, k, l, hij, hkl, u, v, hu, hv, rfl⟩

/-- The cross subgroup lies in a subgroup `H` exactly when every cross commutator does. -/
theorem cross_le_iff {H : Subgroup (SteinbergGroup I.double)} :
    cross I ≤ H ↔ ∀ {i j k l : ℕ} (hij : i ≠ j) (hkl : k ≠ l) {u v : R} (hu : u ∈ I) (hv : v ∈ I),
      ⁅IndexedSteinbergGroup.x hij (doubleInr hu), IndexedSteinbergGroup.x hkl (doubleInl hv)⁆ ∈
        H := by
  refine ⟨fun h _ _ _ _ hij hkl _ _ hu hv ↦ h (commutatorElement_mem_cross I hij hkl hu hv),
    fun h ↦ closure_le _ |>.2 ?_⟩
  rintro _ ⟨i, j, k, l, hij, hkl, u, v, hu, hv, rfl⟩
  exact h hij hkl hu hv

/-- The cross commutators lie in `St'(R, I)`. -/
theorem cross_le_kerFst : cross I ≤ kerFst I :=
  (cross_le_iff I).2 fun _ _ _ _ ↦ by simp

/-- The addition map kills the cross commutators. -/
theorem cross_le_ker_map_doubleSnd : cross I ≤ (IndexedSteinbergGroup.map I.doubleSnd).ker :=
  (cross_le_iff I).2 fun _ _ _ _ ↦ by simp

/-- **The cross commutators lie in `K₂(R ⊕ I)`.** -/
theorem cross_le_ker_toStableGL : cross I ≤ (SteinbergGroup.toStableGL I.double).ker := by
  -- Both the projection and the image under the addition map of a cross commutator are trivial.
  intro z hz
  simp [SteinbergGroup.toStableGL_eq_one_iff_of_injective_prod
    I.doubleFst_prod_doubleSnd_injective, mem_kerFst_iff.1 (cross_le_kerFst I hz),
    (MonoidHom.mem_ker).1 (cross_le_ker_map_doubleSnd I hz)]

/-- The cross subgroup is central in `St(R ⊕ I)`. -/
theorem cross_le_center : cross I ≤ center (SteinbergGroup I.double) :=
  (cross_le_ker_toStableGL I).trans SteinbergGroup.ker_toStableGL_le_center

instance : (cross I).Normal :=
  normal_of_le_center (cross_le_center I)

/-- The normal closure in `St(R ⊕ I)` of the cross commutators is the subgroup they generate. -/
theorem normalClosure_eq_cross :
    normalClosure {z | ∃ (i j k l : ℕ) (hij : i ≠ j) (hkl : k ≠ l) (u v : R) (hu : u ∈ I)
      (hv : v ∈ I), ⁅IndexedSteinbergGroup.x hij (doubleInr hu),
        IndexedSteinbergGroup.x hkl (doubleInl hv)⁆ = z} = cross I :=
  le_antisymm (normalClosure_le_normal subset_closure) closure_le_normalClosure

end IdealSteinbergGroup

/-! ### The relative Steinberg group -/

variable {R : Type u} [Ring R] (I : TwoSidedIdeal R)

/-- The **relative Steinberg group** `St(R, I)` of a two-sided ideal `I` of a ring `R`, following
Keune and Loday: the kernel `St'(R, I)` of `St(R ⊕ I) →* St(R)` (induced by the projection of the
double) modulo the central subgroup generated by the cross commutators
`⁅x_{ij}(0, u), x_{kl}(v, -v)⁆`, `u, v ∈ I`. -/
abbrev IdealSteinbergGroup : Type u :=
  IdealSteinbergGroup.kerFst I ⧸ (IdealSteinbergGroup.cross I).subgroupOf
    (IdealSteinbergGroup.kerFst I)

namespace IdealSteinbergGroup

/-- The quotient map `St'(R, I) →* St(R, I)`. -/
def mk : kerFst I →* IdealSteinbergGroup I :=
  QuotientGroup.mk' _

/-- The coercion of `St'(R, I)` into the quotient `St(R, I)` is the quotient map `mk`. -/
@[simp]
theorem coe_eq_mk (y : kerFst I) : (y : IdealSteinbergGroup I) = mk I y :=
  (rfl)

theorem mk_surjective : Function.Surjective (mk I) :=
  QuotientGroup.mk'_surjective _

variable {I} in
/-- An element of `St'(R, I)` is trivial in `St(R, I)` exactly when it lies in the cross subgroup.
-/
theorem mk_eq_one_iff {y : kerFst I} : mk I y = 1 ↔ (y : SteinbergGroup I.double) ∈ cross I :=
  (QuotientGroup.eq_one_iff y).trans mem_subgroupOf

variable {I} in
/-- Two homomorphisms out of `St(R, I)` agree when they agree on the classes of `St'(R, I)`. -/
theorem hom_ext {G : Type*} [Monoid G] {φ ψ : IdealSteinbergGroup I →* G}
    (h : φ.comp (mk I) = ψ.comp (mk I)) : φ = ψ :=
  QuotientGroup.monoidHom_ext _ h

/-! ### The homomorphism to `St(R)` -/

/-- The homomorphism `St(R, I) →* St(R)` induced by the addition map `add : R ⊕ I →+* R`, which
kills the cross commutators. -/
def toSteinbergGroup : IdealSteinbergGroup I →* SteinbergGroup R :=
  QuotientGroup.lift _ ((IndexedSteinbergGroup.map I.doubleSnd).comp (kerFst I).subtype)
    fun _ hy ↦ cross_le_ker_map_doubleSnd I (mem_subgroupOf.1 hy)

@[simp]
theorem toSteinbergGroup_mk (y : kerFst I) :
    toSteinbergGroup I (mk I y) = IndexedSteinbergGroup.map I.doubleSnd y :=
  QuotientGroup.lift_mk _ _ _

/-- The range of `St(R, I) →* St(R)` is the image of `St'(R, I)` under the addition map. -/
theorem range_toSteinbergGroup_eq_map :
    (toSteinbergGroup I).range = (kerFst I).map (IndexedSteinbergGroup.map I.doubleSnd) := by
  have h : (toSteinbergGroup I).comp (mk I) =
      (IndexedSteinbergGroup.map I.doubleSnd).comp (kerFst I).subtype :=
    MonoidHom.ext (toSteinbergGroup_mk I)
  calc (toSteinbergGroup I).range = ((toSteinbergGroup I).comp (mk I)).range := by
        rw [MonoidHom.range_comp, (mk I).range_eq_top_of_surjective (mk_surjective I),
          ← MonoidHom.range_eq_map]
    _ = (kerFst I).map (IndexedSteinbergGroup.map I.doubleSnd) := by
        rw [h, MonoidHom.range_comp, range_subtype]

/-- **The range of `St(R, I) →* St(R)` is the normal closure of the generators `x_{ij}(v)`,
`v ∈ I`.** -/
theorem range_toSteinbergGroup :
    (toSteinbergGroup I).range = normalClosure {z | ∃ (i j : ℕ) (hij : i ≠ j) (v : R),
      v ∈ I ∧ IndexedSteinbergGroup.x hij v = z} := by
  rw [range_toSteinbergGroup_eq_map, kerFst_eq_normalClosure, map_normalClosure _ _
    (IndexedSteinbergGroup.map_surjective I.doubleSnd_surjective)]
  congr 1
  ext z
  simp [eq_comm]

/-- For the unit ideal, `St(R, R) →* St(R)` is surjective. -/
theorem range_toSteinbergGroup_top : (toSteinbergGroup (⊤ : TwoSidedIdeal R)).range = ⊤ := by
  rw [range_toSteinbergGroup, IndexedSteinbergGroup.subgroup_eq_top_iff]
  exact fun i j hij a ↦ subset_normalClosure ⟨i, j, hij, a, TwoSidedIdeal.mem_top R, rfl⟩

/-! ### The zero ideal -/

/-- **`St'(R, 0)` is trivial**, so the relative Steinberg group of the zero ideal is trivial. -/
theorem kerFst_bot : kerFst (⊥ : TwoSidedIdeal R) = ⊥ := by
  -- For the zero ideal the projection of the double is a ring isomorphism, inverted by the
  -- diagonal.
  have hinj := (doubleFst_injective_iff (I := (⊥ : TwoSidedIdeal R))).2 rfl
  have hid : (⊥ : TwoSidedIdeal R).doubleDiag.comp (⊥ : TwoSidedIdeal R).doubleFst =
      RingHom.id _ :=
    RingHom.ext fun p ↦ hinj (by simp)
  refine (eq_bot_iff_forall _).2 fun z hz ↦ ?_
  simpa [IndexedSteinbergGroup.map_map, hid] using
    congrArg (IndexedSteinbergGroup.map (doubleDiag ⊥)) (mem_kerFst_iff.1 hz)

/-- `St'(R, 0)` is trivial (`TauCeti.IdealSteinbergGroup.kerFst_bot`). -/
instance : Subsingleton (kerFst (⊥ : TwoSidedIdeal R)) := by
  rw [kerFst_bot]
  infer_instance

/-- The relative Steinberg group of the zero ideal is trivial, being a quotient of `St'(R, 0)`. -/
instance : Subsingleton (IdealSteinbergGroup (⊥ : TwoSidedIdeal R)) :=
  (mk_surjective _).subsingleton

end IdealSteinbergGroup

/-! ### Relative `K₂` -/

/-- The **relative `K₂`** of a two-sided ideal `I` of a ring `R`: the kernel `K₂(R, I)` of the
composite `St(R, I) →* St(R) →* GL(R)`. Its image lies in the relative elementary group
`E(R, I) ⊆ GL(R)`, so this is the kernel of `St(R, I) → E(R, I)` in Weibel's definition. It is
central in `St(R, I)` (`TauCeti.idealAlgebraicK2_le_center`), hence a commutative group. -/
def idealAlgebraicK2 : Subgroup (IdealSteinbergGroup I) :=
  ((SteinbergGroup.toStableGL R).comp (IdealSteinbergGroup.toSteinbergGroup I)).ker

variable {I} in
@[simp]
theorem mem_idealAlgebraicK2_iff {w : IdealSteinbergGroup I} :
    w ∈ idealAlgebraicK2 I ↔
      SteinbergGroup.toStableGL R (IdealSteinbergGroup.toSteinbergGroup I w) = 1 :=
  MonoidHom.mem_ker

variable {I} in
/-- The class of an element of `St'(R, I)` lies in `K₂(R, I)` exactly when the element lies in
`K₂(R ⊕ I)`. -/
theorem IdealSteinbergGroup.mk_mem_idealAlgebraicK2_iff {y : IdealSteinbergGroup.kerFst I} :
    IdealSteinbergGroup.mk I y ∈ idealAlgebraicK2 I ↔
      (y : SteinbergGroup I.double) ∈ (SteinbergGroup.toStableGL I.double).ker := by
  simp [SteinbergGroup.toStableGL_eq_one_iff_of_injective_prod
    I.doubleFst_prod_doubleSnd_injective, IdealSteinbergGroup.mem_kerFst_iff.1 y.property]

/-- **`K₂(R, I)` is central in `St(R, I)`.** -/
theorem idealAlgebraicK2_le_center : idealAlgebraicK2 I ≤ center (IdealSteinbergGroup I) := by
  intro w hw
  obtain ⟨y, rfl⟩ := IdealSteinbergGroup.mk_surjective I w
  have hy := SteinbergGroup.ker_toStableGL_le_center
    (IdealSteinbergGroup.mk_mem_idealAlgebraicK2_iff.1 hw)
  refine mem_center_iff.2 fun g ↦ ?_
  obtain ⟨g', rfl⟩ := IdealSteinbergGroup.mk_surjective I g
  rw [← map_mul, ← map_mul]
  exact congrArg _ (Subtype.ext (mem_center_iff.1 hy g'))

namespace idealAlgebraicK2

/-- Relative `K₂(R, I)` is a commutative group, being central in `St(R, I)`. -/
instance instCommGroup : CommGroup (idealAlgebraicK2 I) :=
  { (inferInstance : Group (idealAlgebraicK2 I)) with
    mul_comm := fun a b ↦
      Subtype.ext (mem_center_iff.1 (idealAlgebraicK2_le_center I b.property) a.val) }

/-- The forgetful map `K₂(R, I) →* K₂(R)`, induced by the addition map of the double. -/
def toAlgebraicK2 : idealAlgebraicK2 I →* AlgebraicK2 R :=
  ((IdealSteinbergGroup.toSteinbergGroup I).comp (idealAlgebraicK2 I).subtype).codRestrict _
    fun x ↦ mem_idealAlgebraicK2_iff.1 x.property

@[simp]
theorem coe_toAlgebraicK2_apply (x : idealAlgebraicK2 I) :
    (toAlgebraicK2 I x : SteinbergGroup R) = IdealSteinbergGroup.toSteinbergGroup I x :=
  (rfl)

/-! ### The description through `K₂` of the double -/

/-- The kernel `K₂'(R, I)` of the homomorphism `K₂(R ⊕ I) →* K₂(R)` induced by the projection of
the double. -/
def kerFst : Subgroup (AlgebraicK2 I.double) :=
  (AlgebraicK2.map I.doubleFst).ker

variable {I} in
/-- An element of `K₂(R ⊕ I)` lies in `K₂'(R, I)` exactly when the projection kills it. -/
@[simp]
theorem mem_kerFst_iff {x : AlgebraicK2 I.double} :
    x ∈ kerFst I ↔ AlgebraicK2.map I.doubleFst x = 1 :=
  MonoidHom.mem_ker

variable {I} in
/-- An element of `K₂'(R, I)` lies in `St'(R, I)`. -/
theorem coe_mem_kerFst (x : kerFst I) :
    ((x : AlgebraicK2 I.double) : SteinbergGroup I.double) ∈ IdealSteinbergGroup.kerFst I := by
  simpa using congrArg Subtype.val (mem_kerFst_iff.1 x.property)

/-- The homomorphism `K₂'(R, I) →* K₂(R, I)` sending an element of `K₂(R ⊕ I)` killed by the
projection to its class in `St(R, I)`. It is surjective with kernel the cross commutators
(`TauCeti.idealAlgebraicK2.quotientEquiv`). -/
def ofKerFst : kerFst I →* idealAlgebraicK2 I :=
  ((IdealSteinbergGroup.mk I).comp
    (((SteinbergGroup.toStableGL I.double).ker.subtype.comp (kerFst I).subtype).codRestrict _
      coe_mem_kerFst)).codRestrict _
    fun x ↦ IdealSteinbergGroup.mk_mem_idealAlgebraicK2_iff.2 (x : AlgebraicK2 I.double).property

@[simp]
theorem coe_ofKerFst_apply (x : kerFst I) :
    (ofKerFst I x : IdealSteinbergGroup I) = IdealSteinbergGroup.mk I ⟨_, coe_mem_kerFst x⟩ :=
  (rfl)

theorem ofKerFst_surjective : Function.Surjective (ofKerFst I) := by
  rintro ⟨w, hw⟩
  obtain ⟨y, rfl⟩ := IdealSteinbergGroup.mk_surjective I w
  have hy := IdealSteinbergGroup.mk_mem_idealAlgebraicK2_iff.1 hw
  refine ⟨⟨⟨y, hy⟩, ?_⟩, Subtype.ext (coe_ofKerFst_apply I _)⟩
  simpa [← OneMemClass.coe_eq_one] using IdealSteinbergGroup.mem_kerFst_iff.1 y.property

/-- The kernel of `K₂'(R, I) →* K₂(R, I)` consists of the cross commutators. -/
theorem ker_ofKerFst :
    (ofKerFst I).ker = (IdealSteinbergGroup.cross I).comap
      ((SteinbergGroup.toStableGL I.double).ker.subtype.comp (kerFst I).subtype) := by
  ext x
  simp [← OneMemClass.coe_eq_one, IdealSteinbergGroup.mk_eq_one_iff]

/-- **`K₂(R, I) ≃* K₂'(R, I) / C`**: relative `K₂` is the kernel of `K₂(R ⊕ I) →* K₂(R)` induced
by the projection, modulo the cross commutators. -/
def quotientEquiv : kerFst I ⧸ (IdealSteinbergGroup.cross I).comap
      ((SteinbergGroup.toStableGL I.double).ker.subtype.comp (kerFst I).subtype) ≃*
    idealAlgebraicK2 I :=
  (QuotientGroup.quotientMulEquivOfEq (ker_ofKerFst I).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective _ (ofKerFst_surjective I))

@[simp]
theorem quotientEquiv_mk (x : kerFst I) :
    quotientEquiv I (QuotientGroup.mk x) = ofKerFst I x :=
  (rfl)

/-- Under `K₂(R, I) ≃* K₂'(R, I) / C`, the forgetful map `K₂(R, I) →* K₂(R)` is induced by the
homomorphism `K₂(R ⊕ I) →* K₂(R)` of the addition map. -/
theorem toAlgebraicK2_quotientEquiv_mk (x : kerFst I) :
    toAlgebraicK2 I (quotientEquiv I (QuotientGroup.mk x)) = AlgebraicK2.map I.doubleSnd x := by
  ext
  simp

end idealAlgebraicK2

/-! ### Functoriality in morphisms of pairs -/

section Map

variable {S T : Type*} [Ring S] [Ring T] {I} {J : TwoSidedIdeal S} {K : TwoSidedIdeal T}

namespace IdealSteinbergGroup

/-- A morphism of pairs carries `St'(R, I)` into `St'(S, J)`. -/
theorem map_doubleMap_mem_kerFst (f : R →+* S) (h : I ≤ comap f J) {z : SteinbergGroup I.double}
    (hz : z ∈ kerFst I) : IndexedSteinbergGroup.map (doubleMap f h) z ∈ kerFst J := by
  simpa using congrArg (IndexedSteinbergGroup.map f) (mem_kerFst_iff.1 hz)

/-- A morphism of pairs carries cross commutators to cross commutators. -/
theorem map_cross_le (f : R →+* S) (h : I ≤ comap f J) :
    (cross I).map (IndexedSteinbergGroup.map (doubleMap f h)) ≤ cross J :=
  map_le_iff_le_comap.2 <| (cross_le_iff I).2 fun hij hkl _ _ hu hv ↦ by
    simpa using
      commutatorElement_mem_cross J hij hkl ((mem_comap f).1 (h hu)) ((mem_comap f).1 (h hv))

/-- The restriction `St'(R, I) →* St'(S, J)` of the homomorphism induced by a morphism of pairs. -/
private def kerFstMap (f : R →+* S) (h : I ≤ comap f J) : kerFst I →* kerFst J :=
  ((IndexedSteinbergGroup.map (doubleMap f h)).comp (kerFst I).subtype).codRestrict _
    fun z ↦ map_doubleMap_mem_kerFst f h z.property

/-- The homomorphism `St(R, I) →* St(S, J)` induced by a ring homomorphism `f : R →+* S` carrying
`I` into `J`. -/
def map (f : R →+* S) (h : I ≤ comap f J) : IdealSteinbergGroup I →* IdealSteinbergGroup J :=
  QuotientGroup.map _ _ (kerFstMap f h) fun _ hy ↦ by
    rw [Subgroup.mem_comap, mem_subgroupOf]
    exact map_cross_le f h (mem_map_of_mem _ (mem_subgroupOf.1 hy))

@[simp]
theorem map_mk (f : R →+* S) (h : I ≤ comap f J) (y : kerFst I) :
    map f h (mk I y) =
      mk J ⟨IndexedSteinbergGroup.map (doubleMap f h) y, map_doubleMap_mem_kerFst f h y.property⟩ :=
  (rfl)

/-- The homomorphism `St(R, I) →* St(R)` is natural in morphisms of pairs. -/
@[simp]
theorem toSteinbergGroup_map (f : R →+* S) (h : I ≤ comap f J) (w : IdealSteinbergGroup I) :
    toSteinbergGroup J (map f h w) = IndexedSteinbergGroup.map f (toSteinbergGroup I w) := by
  obtain ⟨y, rfl⟩ := mk_surjective I w
  simp

variable (I) in
@[simp]
theorem map_id :
    map (RingHom.id R) (le_comap_id I) = MonoidHom.id (IdealSteinbergGroup I) := by
  refine hom_ext (MonoidHom.ext fun y ↦ ?_)
  simp

theorem map_comp (f : R →+* S) (g : S →+* T) (hf : I ≤ comap f J) (hg : J ≤ comap g K) :
    map (g.comp f) (le_comap_comp hf hg) = (map g hg).comp (map f hf) := by
  refine hom_ext (MonoidHom.ext fun y ↦ ?_)
  simp [IndexedSteinbergGroup.map_map, ← doubleMap_comp]

end IdealSteinbergGroup

namespace idealAlgebraicK2

/-- The homomorphism `K₂(R, I) →* K₂(S, J)` induced by a ring homomorphism `f : R →+* S` carrying
`I` into `J`. -/
def map (f : R →+* S) (h : I ≤ comap f J) : idealAlgebraicK2 I →* idealAlgebraicK2 J :=
  ((IdealSteinbergGroup.map f h).comp (idealAlgebraicK2 I).subtype).codRestrict _ fun x ↦ by
    simp [SteinbergGroup.toStableGL_map, mem_idealAlgebraicK2_iff.1 x.property]

@[simp]
theorem coe_map_apply (f : R →+* S) (h : I ≤ comap f J) (x : idealAlgebraicK2 I) :
    (map f h x : IdealSteinbergGroup J) = IdealSteinbergGroup.map f h x :=
  (rfl)

/-- The forgetful map `K₂(R, I) →* K₂(R)` is natural in morphisms of pairs. -/
@[simp]
theorem toAlgebraicK2_map (f : R →+* S) (h : I ≤ comap f J) (x : idealAlgebraicK2 I) :
    toAlgebraicK2 J (map f h x) = AlgebraicK2.map f (toAlgebraicK2 I x) := by
  ext
  simp

variable (I) in
@[simp]
theorem map_id :
    map (RingHom.id R) (le_comap_id I) = MonoidHom.id (idealAlgebraicK2 I) := by
  ext x
  simp

theorem map_comp (f : R →+* S) (g : S →+* T) (hf : I ≤ comap f J) (hg : J ≤ comap g K) :
    map (g.comp f) (le_comap_comp hf hg) = (map g hg).comp (map f hf) := by
  ext x
  simpa using
    DFunLike.congr_fun (IdealSteinbergGroup.map_comp f g hf hg) (x : IdealSteinbergGroup I)

end idealAlgebraicK2

end Map

end TauCeti
