module

public import TauCeti.LinearAlgebra.GeneralLinearGroup.Neat
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Diagonal.Basic
import Mathlib.LinearAlgebra.Eigenspace.Matrix

/-!
# Neat diagonal matrices

The eigenvalues of an invertible diagonal matrix are its diagonal entries, so its eigenvalue
subgroup is the subgroup generated by these entries, and the matrix is neat exactly when that
subgroup is torsion free.

## Main declarations

* `TauCeti.eigenvalueSubgroup_toLin_diagGL`: the eigenvalue subgroup of `diagGL t` is generated
  by the entries of `t`.
* `TauCeti.isNeat_toLin_diagGL_iff`: `diagGL t` is neat exactly when the entries of `t` generate
  a torsion-free subgroup.
-/

public section

namespace TauCeti

open LinearMap.GeneralLinearGroup

variable {k ι : Type*} [Field k] [Fintype ι] [DecidableEq ι]

/-- The eigenvalue subgroup of an invertible diagonal matrix is the subgroup generated by its
diagonal entries. -/
theorem eigenvalueSubgroup_toLin_diagGL (t : ι → kˣ) :
    eigenvalueSubgroup (Matrix.GeneralLinearGroup.toLin (diagGL t)) =
      Subgroup.closure (Set.range t) := by
  rw [eigenvalueSubgroup_def]
  congr 1
  ext z
  rw [Set.mem_ofPred_eq, Matrix.GeneralLinearGroup.coe_toLin, ← Matrix.toLin'_apply', diagGL_coe,
    hasEigenvalue_toLin'_diagonal_iff]
  simp [Units.ext_iff]

/-- An invertible diagonal matrix is neat exactly when its diagonal entries generate a
torsion-free subgroup of `kˣ`. -/
theorem isNeat_toLin_diagGL_iff (t : ι → kˣ) :
    IsNeat (Matrix.GeneralLinearGroup.toLin (diagGL t)) ↔
      IsMulTorsionFree (Subgroup.closure (Set.range t)) := by
  rw [isNeat_def, eigenvalueSubgroup_toLin_diagGL]

end TauCeti
