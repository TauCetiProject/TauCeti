module

public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Transvection
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.UpperUnitriangular.Basic

/-!
# The subgroup `U₀*` of the upper-unitriangular group

Over a ring `R`, the upper-unitriangular group `Uₙ(R)` of `GLₙ(R)` carries the root subgroups
`xᵢⱼ(R) = 1 + R Eᵢⱼ`, `i < j`, one for each positive root `εᵢ − εⱼ` of `GLₙ`; the positive roots
`εᵢ − εᵢ₊₁` are the simple ones. The subgroup `U₀*` of `Uₙ(R)` generated by the root subgroups of
the non-simple positive roots is the group of the upper-unitriangular matrices whose first
superdiagonal vanishes (`TauCeti.UpperUnitriangularNonSimpleGroup.mem_iff`).

Over a finite field, a character of `Uₙ(𝔽_q)` is called regular when it is trivial on `U₀*` and
nontrivial on every `xᵢ,ᵢ₊₁(𝔽_q)`; the Gelfand–Graev representations of `GLₙ(𝔽_q)` are induced
from the regular characters. The order of `Uₙ(𝔽_q)` and its index in `GLₙ(𝔽_q)` are computed in
`TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.UpperUnitriangular.Card`.

## Main declarations

* `TauCeti.upperUnitriangularNonSimpleGroup`: the subgroup `U₀*` of `Uₙ(R)`.
* `TauCeti.UpperUnitriangularNonSimpleGroup.mem_iff`: `g ∈ U₀*` if and only if `g` is upper
  unitriangular and `g i (i + 1) = 0` for every `i`.
* `TauCeti.UpperUnitriangularNonSimpleGroup.transvectionUnit_mem`: the generators `xᵢⱼ(c)` with
  `i + 1 < j` lie in `U₀*`.
* `Matrix.IsUpperUnitriangular.mul_apply_castSucc_succ`: an entry on the first superdiagonal of
  a product of upper-unitriangular matrices indexed by `Fin (m + 1)` is the sum of the two
  entries.
* `TauCeti.UpperUnitriangularGroup.transvectionUnit_mem`: a transvection `xᵢⱼ(c)` with `i < j`
  lies in `Uₙ(R)`.

## References

* R. W. Carter, *Finite Groups of Lie Type: Conjugacy Classes and Complex Characters*, Wiley, 1985.
* F. Digne, J. Michel, *Representations of Finite Groups of Lie Type*, Cambridge University Press,
  1991.
-/

public section

namespace Finset

/-- The open interval between `k` and its successor in `Fin (m + 1)` is empty. -/
theorem Ioo_castSucc_succ_eq_empty {m : ℕ} (k : Fin m) :
    Finset.Ioo k.castSucc k.succ = ∅ := by
  rw [Finset.eq_empty_iff_forall_notMem]
  intro x hx
  obtain ⟨h1, h2⟩ := Finset.mem_Ioo.mp hx
  exact lt_irrefl _ (lt_of_le_of_lt (Fin.le_castSucc_iff.mpr h2) h1)

end Finset

namespace Matrix

/-- An entry on the first superdiagonal of a product of upper-unitriangular matrices indexed by
`Fin (m + 1)` is the sum of the two entries: no index lies strictly between `k` and its
successor. -/
theorem IsUpperUnitriangular.mul_apply_castSucc_succ {R : Type*} [Ring R] {m : ℕ}
    {M N : Matrix (Fin (m + 1)) (Fin (m + 1)) R} (hM : M.IsUpperUnitriangular)
    (hN : N.IsUpperUnitriangular) (k : Fin m) :
    (M * N) k.castSucc k.succ = M k.castSucc k.succ + N k.castSucc k.succ := by
  have h := hM.mul_apply_of_lt hN (Fin.castSucc_lt_succ (i := k))
  rw [Finset.Ioo_castSucc_succ_eq_empty, Finset.sum_empty, add_zero] at h
  exact h

end Matrix

namespace TauCeti

open Matrix

/-- A transvection `xᵢⱼ(c)` with `i < j` is upper unitriangular. -/
theorem UpperUnitriangularGroup.transvectionUnit_mem {m : Type*} [Fintype m] [LinearOrder m]
    {R : Type*} [Ring R] {i j : m} (hij : i < j) (c : R) :
    transvectionUnit hij.ne c ∈ upperUnitriangularGroup m R := by
  rw [UpperUnitriangularGroup.mem_iff, TauCeti.coe_transvectionUnit_eq_one_add_single,
    Matrix.isUpperUnitriangular_def]
  constructor
  · intro a b hab
    have h1 : a ≠ b := Ne.symm (ne_of_lt hab)
    have h2 : ¬ (i = a ∧ j = b) := by
      rintro ⟨e1, e2⟩
      rw [e1, e2] at hij
      exact (lt_irrefl b (hab.trans hij)).elim
    simp only [Matrix.one_apply, Matrix.add_apply, Matrix.single_apply, ite_eq_right h1, zero_add,
      ite_eq_right h2]
  · intro a
    have h2 : ¬ (i = a ∧ j = a) := by
      rintro ⟨e1, e2⟩
      rw [e1, e2] at hij
      exact absurd hij (lt_irrefl _)
    simp only [Matrix.one_apply, Matrix.add_apply, Matrix.single_apply, ite_eq_right h2, add_zero,
      reduceIte]

variable {m : ℕ} {R : Type*} [Ring R]

/-- The subgroup `U₀*` of the upper-unitriangular group of `GL (Fin (m + 1)) R`: the subgroup
generated by the root subgroups `xᵢⱼ(R) = 1 + R Eᵢⱼ` of the non-simple positive roots
`εᵢ − εⱼ`, that is, by the transvections with `i + 1 < j`. -/
public def upperUnitriangularNonSimpleGroup (m : ℕ) (R : Type*) [Ring R] :
    Subgroup (GL (Fin (m + 1)) R) :=
  Subgroup.closure {g | ∃ (i j : Fin (m + 1)) (hij : (i : ℕ) + 1 < (j : ℕ)) (c : R),
    transvectionUnit (Fin.lt_def.2 (show (i : ℕ) < (j : ℕ) by omega)).ne c = g}

/-- `U₀*` is the subgroup generated by the transvections with `i + 1 < j`. -/
theorem upperUnitriangularNonSimpleGroup_def :
    upperUnitriangularNonSimpleGroup m R =
      Subgroup.closure {g | ∃ (i j : Fin (m + 1)) (hij : (i : ℕ) + 1 < (j : ℕ)) (c : R),
        transvectionUnit (Fin.lt_def.2 (show (i : ℕ) < (j : ℕ) by omega)).ne c = g} :=
  (rfl)

/-- `U₀*` is contained in the upper-unitriangular group. -/
theorem upperUnitriangularNonSimpleGroup_le_upperUnitriangularGroup :
    upperUnitriangularNonSimpleGroup m R ≤ upperUnitriangularGroup (Fin (m + 1)) R := by
  rw [upperUnitriangularNonSimpleGroup_def, Subgroup.closure_le]
  rintro g ⟨i, j, hij, c, rfl⟩
  exact UpperUnitriangularGroup.transvectionUnit_mem (Fin.lt_def.2 (by omega : (i : ℕ) < (j : ℕ))) c

namespace UpperUnitriangularNonSimpleGroup

/-- The root subgroup `xᵢⱼ(R)` of a non-simple positive root lies in `U₀*`. -/
theorem transvectionUnit_mem {i j : Fin (m + 1)} (hij : (i : ℕ) + 1 < (j : ℕ)) (c : R) :
    transvectionUnit (Fin.lt_def.2 (by omega : (i : ℕ) < (j : ℕ))).ne c ∈
      upperUnitriangularNonSimpleGroup m R :=
  Subgroup.subset_closure ⟨i, j, hij, c, rfl⟩

end UpperUnitriangularNonSimpleGroup

/-! ### Elimination of the entries away from the first superdiagonal -/

section Elimination

variable [DecidableEq R]

/-- The positions `(i, j)` with `i + 1 < j` at which the entries of a square matrix of size
`m + 1` do not vanish. -/
private def nonSimpleEntries (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) :
    Finset (Fin (m + 1) × Fin (m + 1)) :=
  Finset.univ.filter fun p => (p.1 : ℕ) + 1 < p.2 ∧ g p.1 p.2 ≠ 0

omit [DecidableEq R] in
/-- An upper-unitriangular matrix with vanishing first superdiagonal and no nonzero entry away
from the first superdiagonal is the identity. -/
private theorem eq_one_of_isUpperUnitriangular_of_superdiagonal_eq_zero_of_apply_eq_zero
    {g : Matrix (Fin (m + 1)) (Fin (m + 1)) R} (hg : g.IsUpperUnitriangular)
    (hs : ∀ k : Fin m, g k.castSucc k.succ = 0)
    (h0 : ∀ i j : Fin (m + 1), (i : ℕ) + 1 < (j : ℕ) → g i j = 0) : g = 1 := by
  ext a b
  by_cases hab : b < a
  · rw [hg.isUpperTriangular hab, Matrix.one_apply, ite_eq_right (Ne.symm (ne_of_lt hab))]
  · by_cases hba : a < b
    · rw [Matrix.one_apply, ite_eq_right (ne_of_lt hba)]
      rcases Nat.lt_or_ge ((b : ℕ)) ((a : ℕ) + 2) with hb2 | hb2
      · have hb1 : (b : ℕ) = (a : ℕ) + 1 := by omega
        have hb1' : (a : ℕ) + 1 < m + 1 := by have := b.isLt; omega
        have hb : b = ((⟨(a : ℕ) + 1, hb1'⟩ : Fin (m + 1))) := Fin.ext hb1
        have hk := hs (⟨(a : ℕ), by have := a.isLt; omega⟩ : Fin m)
        rw [Fin.castSucc_mk, Fin.succ_mk] at hk
        rw [hb]
        exact hk
      · exact h0 a b (by omega)
    · have hab' : a = b := by
        apply Fin.ext
        have ha := a.isLt
        have hb := b.isLt
        rw [Fin.lt_def] at hab hba
        omega
      subst hab'
      rw [Matrix.one_apply, ite_eq_left rfl, hg.apply_diag]

omit [DecidableEq R] in
/-- If the first superdiagonal of an upper-unitriangular matrix vanishes and its nonzero entries
away from the first superdiagonal all lie in columns at most `j`, then row `j` of the matrix is
the `j`-th unit vector. -/
private theorem apply_eq_single_of_isUpperUnitriangular_of_superdiagonal_eq_zero_of_le
    {g : Matrix (Fin (m + 1)) (Fin (m + 1)) R} (hg : g.IsUpperUnitriangular)
    (hs : ∀ k : Fin m, g k.castSucc k.succ = 0) {j : Fin (m + 1)}
    (hmax : ∀ i' j' : Fin (m + 1), (i' : ℕ) + 1 < (j' : ℕ) → j < j' → g i' j' = 0)
    (b : Fin (m + 1)) : g j b = if j = b then 1 else 0 := by
  by_cases hb : b = j
  · subst hb
    simp [hg.apply_diag]
  · rw [ite_eq_right (Ne.symm hb)]
    rcases lt_trichotomy ((b : ℕ)) ((j : ℕ)) with h | h | h
    · exact hg.isUpperTriangular (Fin.lt_def.2 h)
    · exact absurd (Fin.ext h) hb
    · rcases Nat.lt_or_ge ((b : ℕ)) ((j : ℕ) + 2) with hb2 | hb2
      · have hb1 : (b : ℕ) = (j : ℕ) + 1 := by omega
        have hb1' : (j : ℕ) + 1 < m + 1 := by have := b.isLt; omega
        have hb : b = ((⟨(j : ℕ) + 1, hb1'⟩ : Fin (m + 1))) := Fin.ext hb1
        have hk := hs (⟨(j : ℕ), by have := j.isLt; omega⟩ : Fin m)
        rw [Fin.castSucc_mk, Fin.succ_mk] at hk
        rw [hb]
        exact hk
      · exact hmax j b (by omega) h

omit [DecidableEq R] in
/-- If row `j` of `g` is the `j`-th unit vector, then `xᵢⱼ(-gᵢⱼ) g` agrees with `g` away from the
position `(i, j)`, where it vanishes. -/
private theorem transvectionUnit_mul_apply_of_apply_row_eq_single
    {g : GL (Fin (m + 1)) R} {i j : Fin (m + 1)} (hij : i ≠ j)
    (hrow : ∀ b, (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) j b = if j = b then 1 else 0)
    (a b : Fin (m + 1)) :
    ((transvectionUnit hij (-(g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) i j) * g :
      GL (Fin (m + 1)) R) : Matrix (Fin (m + 1)) (Fin (m + 1)) R) a b =
        if (a, b) = (i, j) then 0 else (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) a b := by
  rw [Units.val_mul, TauCeti.coe_transvectionUnit_eq_one_add_single, Matrix.add_mul,
    Matrix.one_mul, Matrix.add_apply]
  by_cases hai : a = i
  · rw [hai, Matrix.single_mul_apply_same, hrow b]
    by_cases hbj : b = j
    · subst hbj
      simp
    · rw [ite_eq_right (Ne.symm hbj), mul_zero, add_zero,
        ite_eq_right (fun h : (i, b) = (i, j) => hbj (congrArg Prod.snd h))]
  · rw [Matrix.single_mul_apply_of_ne _ _ _ _ _ hai _, add_zero,
      ite_eq_right (fun h : (a, b) = (i, j) => hai (congrArg Prod.fst h))]

/-- If `g` is upper unitriangular with vanishing first superdiagonal and has a nonzero entry at a
position `(i, j)` with `i + 1 < j` whose column is maximal among the nonzero entries at such
positions, then `g = xᵢⱼ(c) * g'`, where `c = gᵢⱼ` and `g'` is upper unitriangular with vanishing
first superdiagonal and strictly fewer nonzero entries at positions `(i', j')` with
`i' + 1 < j'`. -/
private theorem exists_transvectionUnit_mul_eq_of_mem_nonSimpleEntries
    {g : GL (Fin (m + 1)) R} (hg : g ∈ upperUnitriangularGroup (Fin (m + 1)) R)
    (hs : ∀ k : Fin m, (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) k.castSucc k.succ = 0)
    {i j : Fin (m + 1)} (hij : (i : ℕ) + 1 < (j : ℕ))
    (hne : (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) i j ≠ 0)
    (hmax : ∀ i' j' : Fin (m + 1), (i' : ℕ) + 1 < (j' : ℕ) → (j : Fin (m + 1)) < j' →
      (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) i' j' = 0) :
    ∃ g' : GL (Fin (m + 1)) R,
      (g' ∈ upperUnitriangularGroup (Fin (m + 1)) R ∧
        (∀ k : Fin m, (g' : Matrix (Fin (m + 1)) (Fin (m + 1)) R) k.castSucc k.succ = 0) ∧
        (nonSimpleEntries (g' : Matrix (Fin (m + 1)) (Fin (m + 1)) R)).card <
          (nonSimpleEntries (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R)).card) ∧
      transvectionUnit (Fin.lt_def.2 (by omega : (i : ℕ) < (j : ℕ))).ne
          ((g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) i j) * g' = g := by
  have hilt : i < j := Fin.lt_def.2 (by omega)
  have hrow := apply_eq_single_of_isUpperUnitriangular_of_superdiagonal_eq_zero_of_le
    (UpperUnitriangularGroup.mem_iff.mp hg) hs hmax
  have hg'entry := transvectionUnit_mul_apply_of_apply_row_eq_single hilt.ne hrow
  have hg'S : ∀ k : Fin m,
      ((transvectionUnit hilt.ne (-(g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) i j) * g :
        GL (Fin (m + 1)) R) : Matrix (Fin (m + 1)) (Fin (m + 1)) R) k.castSucc k.succ = 0 := by
    intro k
    rw [hg'entry]
    have h2 : ¬ ((k.castSucc, k.succ) = (i, j)) := by
      intro h
      have e1 : k.castSucc = i := congrArg Prod.fst h
      have e2 : k.succ = j := congrArg Prod.snd h
      rw [← e1, ← e2, Fin.val_castSucc, Fin.val_succ] at hij
      omega
    rw [ite_eq_right h2, hs k]
  have hcard : (nonSimpleEntries ((transvectionUnit hilt.ne
        (-(g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) i j) * g : GL (Fin (m + 1)) R) :
        Matrix (Fin (m + 1)) (Fin (m + 1)) R)).card <
      (nonSimpleEntries (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R)).card := by
    have hS' : nonSimpleEntries ((transvectionUnit hilt.ne
          (-(g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) i j) * g : GL (Fin (m + 1)) R) :
          Matrix (Fin (m + 1)) (Fin (m + 1)) R) =
        (nonSimpleEntries (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R)).erase (i, j) := by
      ext p
      simp only [nonSimpleEntries, Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_erase,
        hg'entry]
      by_cases hp : p = (i, j)
      · subst hp
        simp
      · simp [hp]
    rw [hS']
    exact Finset.card_erase_lt_of_mem (Finset.mem_filter.2 ⟨Finset.mem_univ _, hij, hne⟩)
  refine ⟨transvectionUnit hilt.ne (-(g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) i j) * g,
    ⟨Subgroup.mul_mem _
      (UpperUnitriangularGroup.transvectionUnit_mem hilt
        (-(g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) i j)) hg, hg'S,
      hcard⟩, ?_⟩
  rw [← mul_assoc, ← transvectionUnit_add, add_neg_cancel, transvectionUnit_zero, one_mul]

/-- If the column of `q` is maximal among the positions of the nonzero entries of `g` away from
the first superdiagonal, then the entries of `g` away from the first superdiagonal in greater
columns vanish. -/
private theorem apply_eq_zero_of_lt_of_max_column {g : Matrix (Fin (m + 1)) (Fin (m + 1)) R}
    {q : Fin (m + 1) × Fin (m + 1)}
    (hmax : ∀ p ∈ nonSimpleEntries g, (p.2 : ℕ) ≤ (q.2 : ℕ)) :
    ∀ i' j' : Fin (m + 1), (i' : ℕ) + 1 < (j' : ℕ) → (q.2 : Fin (m + 1)) < j' → g i' j' = 0 := by
  intro i' j' hi'j' hj'
  by_contra h
  have hle : (j' : ℕ) ≤ (q.2 : ℕ) :=
    hmax (i', j') (Finset.mem_filter.2 ⟨Finset.mem_univ _, hi'j', h⟩)
  omega

omit [DecidableEq R] in
/-- An upper-unitriangular matrix with vanishing first superdiagonal lies in `U₀*`. -/
private theorem mem_upperUnitriangularNonSimpleGroup_of_superdiagonal_eq_zero
    {g : GL (Fin (m + 1)) R} (hg : g ∈ upperUnitriangularGroup (Fin (m + 1)) R)
    (hs : ∀ k : Fin m, (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) k.castSucc k.succ = 0) :
    g ∈ upperUnitriangularNonSimpleGroup m R := by
  classical
  have : DecidableEq R := Classical.decEq R
  -- Induction on the number of nonzero entries at positions `(i, j)` with `i + 1 < j`: each step
  -- factors out one transvection and removes one such entry.
  have main : ∀ (N : ℕ) (g : GL (Fin (m + 1)) R), g ∈ upperUnitriangularGroup (Fin (m + 1)) R →
      (∀ k : Fin m, (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) k.castSucc k.succ = 0) →
      (nonSimpleEntries (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R)).card ≤ N →
      g ∈ upperUnitriangularNonSimpleGroup m R := by
    intro N
    induction N using Nat.strong_induction_on with
    | ind N ih =>
        intro g hg' hs' hN
        by_cases hne : (nonSimpleEntries (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R)).Nonempty
        · obtain ⟨q, hq, hmax⟩ := Finset.exists_max_image _
            (fun p : Fin (m + 1) × Fin (m + 1) => (p.2 : ℕ)) hne
          obtain ⟨hq1, hq2⟩ := (Finset.mem_filter.mp hq).2
          have hmax' := apply_eq_zero_of_lt_of_max_column
            (g := (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R)) hmax
          refine (exists_transvectionUnit_mul_eq_of_mem_nonSimpleEntries hg' hs' hq1 hq2 hmax').elim
            fun g' hg' => ?_
          have hg'U := hg'.1.1
          have hg'S := hg'.1.2.1
          have hcard := hg'.1.2.2
          have hgg' := hg'.2
          have hmem : transvectionUnit (Fin.lt_def.2 (show (q.1 : ℕ) < (q.2 : ℕ) by omega)).ne
              ((g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) q.1 q.2) * g' ∈
              upperUnitriangularNonSimpleGroup m R :=
            Subgroup.mul_mem _
              (UpperUnitriangularNonSimpleGroup.transvectionUnit_mem hq1
                ((g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) q.1 q.2))
              (ih _ (lt_of_lt_of_le hcard hN) g' hg'U hg'S le_rfl)
          rw [hgg'] at hmem
          exact hmem
        · have hempty : nonSimpleEntries (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) = ∅ :=
            Finset.not_nonempty_iff_eq_empty.mp hne
          have hg1 : g = 1 := by
            apply Units.ext
            exact eq_one_of_isUpperUnitriangular_of_superdiagonal_eq_zero_of_apply_eq_zero
              (UpperUnitriangularGroup.mem_iff.mp hg') hs' fun i j hij => by
                by_contra h
                have hmem : (i, j) ∈ nonSimpleEntries
                    (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) :=
                  Finset.mem_filter.2 ⟨Finset.mem_univ _, hij, h⟩
                rw [hempty] at hmem
                exact Finset.notMem_empty _ hmem
          rw [hg1]
          exact one_mem _
  exact main _ g hg hs le_rfl

end Elimination

/-- **The elements of `U₀*`** are the upper-unitriangular matrices whose first superdiagonal
vanishes. -/
@[simp]
theorem UpperUnitriangularNonSimpleGroup.mem_iff {g : GL (Fin (m + 1)) R} :
    g ∈ upperUnitriangularNonSimpleGroup m R ↔
      g ∈ upperUnitriangularGroup (Fin (m + 1)) R ∧
        ∀ k : Fin m, (g : Matrix (Fin (m + 1)) (Fin (m + 1)) R) k.castSucc k.succ = 0 := by
  classical
  have : DecidableEq R := Classical.decEq R
  constructor
  · intro hg
    induction hg using Subgroup.closure_induction with
    | mem g hg =>
        obtain ⟨i, j, hij, c, rfl⟩ := hg
        have hne : ∀ k : Fin m, ¬ (i = k.castSucc ∧ j = k.succ) := by
          intro k ⟨e1, e2⟩
          rw [e1, e2, Fin.val_castSucc, Fin.val_succ] at hij
          omega
        refine ⟨UpperUnitriangularGroup.transvectionUnit_mem (Fin.lt_def.2 (by omega :
          (i : ℕ) < (j : ℕ))) c, fun k => ?_⟩
        rw [TauCeti.coe_transvectionUnit_eq_one_add_single]
        simp only [Matrix.one_apply, Matrix.add_apply, Matrix.single_apply,
          ite_eq_right (ne_of_lt (Fin.castSucc_lt_succ (i := k))), zero_add,
          ite_eq_right (hne k)]
    | one =>
        refine ⟨one_mem _, fun k => ?_⟩
        rw [Units.val_one, Matrix.one_apply,
          ite_eq_right (ne_of_lt (Fin.castSucc_lt_succ (i := k)))]
    | mul g h _ _ ihg ihh =>
        refine ⟨Subgroup.mul_mem _ ihg.1 ihh.1, fun k => ?_⟩
        rw [Units.val_mul, (UpperUnitriangularGroup.mem_iff.mp ihg.1).mul_apply_castSucc_succ
          (UpperUnitriangularGroup.mem_iff.mp ihh.1) k, ihg.2 k, ihh.2 k, add_zero]
    | inv g _ ih =>
        have hgU : g⁻¹ ∈ upperUnitriangularGroup (Fin (m + 1)) R := Subgroup.inv_mem _ ih.1
        refine ⟨hgU, fun k => ?_⟩
        have h1 := (UpperUnitriangularGroup.mem_iff.mp ih.1).mul_apply_castSucc_succ
          (UpperUnitriangularGroup.mem_iff.mp hgU) k
        rw [← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.one_apply,
          ite_eq_right (ne_of_lt (Fin.castSucc_lt_succ (i := k))), ih.2 k, zero_add] at h1
        exact h1.symm
  · rintro ⟨hg, hs⟩
    exact mem_upperUnitriangularNonSimpleGroup_of_superdiagonal_eq_zero hg hs

end TauCeti

