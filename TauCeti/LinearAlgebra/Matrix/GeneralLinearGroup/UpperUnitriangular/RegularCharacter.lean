module

-- `AddChar.IsPrimitive.existsUnique_mulShift_eq` parametrizes the additive characters of
-- `Fin n → R`, hence the characters of `Uₙ₊₁(R)`; `RCLike` occurs in the statements of the
-- finite-ring section.
public import TauCeti.Analysis.Fourier.FiniteAbelian.PontryaginDuality
-- `diagGLConj` occurs in the statements about conjugation by the diagonal torus, and with it
-- `superdiagonalSubgroup` and `transvection`, which occur in the statements.
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.UpperUnitriangular.DiagonalConjugation
-- `AddChar.apply_eq_prod_single` decomposes the additive characters of `Fin n → R` in the proof of
-- `existsUnique_eq_adjacentChar`.
import TauCeti.Algebra.Group.AddChar.Basic
-- Non-public: `map_superdiagonalSubgroup_two_eq_one` (every character is trivial on `U²`, the
-- commutator subgroup) in the proofs of `existsUnique_eq_adjacentChar` and
-- `exists_comp_diagGLConj_eq_of_isRegularChar`.
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.UpperUnitriangular.Commutator

/-!
# Regular characters of the upper-unitriangular group

Let `R` be a ring. The first superdiagonal of the upper-unitriangular matrices `Uₙ₊₁(R)` is read
off by the homomorphism `TauCeti.UpperUnitriangularGroup.adjacentHom` onto `Fin n → R`, with
kernel `superdiagonalSubgroup 2`, the subgroup `U²` generated by the transvections of the
non-simple positive roots. Composing an additive character `ψ` of `R` with the dot product
`b ↦ a ⬝ᵥ b = ∑ᵢ aᵢ bᵢ` on the first superdiagonal gives `adjacentChar ψ a`, with values in any
monoid. A *character* of `Uₙ₊₁(R)`, that is, a homomorphism to a commutative monoid, is *regular*
(`TauCeti.UpperUnitriangularGroup.IsRegularChar`) when it is nontrivial on the root subgroup
`c ↦ eᵢ,ᵢ₊₁(c)` of every simple positive root. A regular character is also required, in general,
to be trivial on `U²`; this holds for every character, because `U²` is the commutator subgroup of
`Uₙ₊₁(R)` (`TauCeti.UpperUnitriangularGroup.commutator_eq_superdiagonalSubgroup_two`), and is
recorded in `TauCeti.UpperUnitriangularGroup.map_superdiagonalSubgroup_two_eq_one`.
For a primitive `ψ`, the character `adjacentChar ψ a` is regular exactly when no coefficient
`aᵢ` vanishes, and `ψ` separates the coefficients. Over a finite commutative ring, given a
primitive additive character `ψ` with values in an `RCLike` field (which has to be supplied: it
need not exist, as `𝔽₃` has no nontrivial additive character with values in `ℝ`), every character
with values in that field is `adjacentChar ψ a` for coefficients `a` that are unique for this
fixed `ψ`: read through `adjacentHom`, this is the parametrization of the additive
characters of a finite ring by the shifts of a primitive one. Regularity is unchanged
under composition with an injective homomorphism of commutative monoids
(`TauCeti.UpperUnitriangularGroup.isRegularChar_comp_iff_of_injective`), so the classification of
the regular characters also covers characters with values in the units `kˣ` of an `RCLike` field
`k`, such as `ℂ`.

The diagonal torus acts on `Uₙ₊₁(R)` by conjugation
(`TauCeti.UpperUnitriangularGroup.diagGLConj`), and conjugation by `t = (t₀, …, tₙ)` multiplies
the `i`-th coefficient by `tᵢ tᵢ₊₁⁻¹`. So the diagonal torus acts transitively on the characters
with invertible coefficients, in particular on the regular characters of `Uₙ₊₁(F)` over a finite
field `F` with values in an `RCLike` field. No additive character has to be given for this: a
regular character is nontrivial on the root subgroup of every simple root, which over a field
yields a primitive additive character when `n ≥ 1`, and `U₁(F)` is trivial.

## Main declarations

* `TauCeti.UpperUnitriangularGroup.adjacentChar`: the character
  `u ↦ ψ (∑ᵢ aᵢ uᵢ,ᵢ₊₁)` with coefficients `a`, defined for values in any monoid.
* `TauCeti.UpperUnitriangularGroup.IsRegularChar`: characters (homomorphisms to a commutative
  monoid) nontrivial on every simple root subgroup; `isRegularChar_def` unfolds it.
* `TauCeti.UpperUnitriangularGroup.isRegularChar_comp_iff_of_injective`: regularity is unchanged
  under composition with an injective homomorphism of commutative monoids.
* `TauCeti.UpperUnitriangularGroup.isRegularChar_adjacentChar_iff`: for primitive `ψ`,
  regularity means that no coefficient vanishes.
* `TauCeti.UpperUnitriangularGroup.existsUnique_eq_adjacentChar`: over a finite commutative
  ring, for a given primitive `ψ` with values in an `RCLike` field, every character is a
  `adjacentChar ψ a`, with coefficients unique for this `ψ`.
* `TauCeti.UpperUnitriangularGroup.isRegularChar_iff`: over a finite commutative ring, for a
  given primitive `ψ` with values in an `RCLike` field, the regular characters are the
  `adjacentChar ψ a` with no vanishing coefficient.
* `TauCeti.UpperUnitriangularGroup.adjacentChar_comp_diagGLConj`: conjugation multiplies
  the `i`-th coefficient by `tᵢ tᵢ₊₁⁻¹`.
* `TauCeti.UpperUnitriangularGroup.exists_comp_diagGLConj_eq`: the diagonal torus acts transitively
  on the characters with invertible coefficients.
* `TauCeti.UpperUnitriangularGroup.exists_comp_diagGLConj_eq_of_isRegularChar`: over a finite
  field with values in an `RCLike` field, the diagonal torus permutes the regular characters
  transitively.

## Implementation notes

`adjacentChar` follows `TauCeti.BlockUpperUnitriangularGroup.adjacentTraceChar` in
`TauCeti/LinearAlgebra/Matrix/GeneralLinearGroup/UpperUnitriangular/Block.lean`, the template for
its construction as an additive character read through a homomorphism to `Multiplicative R`, and
`adjacentChar_comp_diagGLConj` follows the computation
`TauCeti.BlockUpperUnitriangularGroup.adjacentBlockTrace_blockDiagonalConj` of a conjugate under
`TauCeti.BlockUpperUnitriangularGroup.blockDiagonalConj` there.

## References

* R. W. Carter, *Finite Groups of Lie Type*, Chapter 5.
* F. Digne, J. Michel, *Representations of Finite Groups of Lie Type*, Cambridge University Press,
  1991, §9.1.
-/

public section

open Matrix

namespace TauCeti.UpperUnitriangularGroup

universe u v w

/-! ### The characters with prescribed coefficients -/

section Ring

variable {R : Type u} [Ring R] {n : ℕ} {M : Type v} [Monoid M]

/-- The character of `Uₙ₊₁(R)` attached to an additive character `ψ` of `R` and coefficients
`a : Fin n → R`: it sends `u` to `ψ (∑ᵢ aᵢ uᵢ,ᵢ₊₁)`, the additive character `ψ` read through
the dot product `b ↦ a ⬝ᵥ b` on the first superdiagonal. -/
def adjacentChar (ψ : AddChar R M) (a : Fin n → R) :
    upperUnitriangularGroup (Fin (n + 1)) R →* M :=
  ψ.toMonoidHom.comp
    ((AddMonoidHom.mk' (a ⬝ᵥ ·) (dotProduct_add a)).toMultiplicative.comp (adjacentHom R n))

@[simp]
theorem adjacentChar_apply (ψ : AddChar R M) (a : Fin n → R)
    (u : upperUnitriangularGroup (Fin (n + 1)) R) :
    adjacentChar ψ a u = ψ (∑ i, a i *
      ((u : GL (Fin (n + 1)) R) : Matrix (Fin (n + 1)) (Fin (n + 1)) R) i.castSucc i.succ) := by
  simp only [adjacentChar, MonoidHom.comp_apply, AddChar.toMonoidHom_apply,
    AddMonoidHom.coe_toMultiplicative, Function.comp_apply, toAdd_ofAdd, AddMonoidHom.mk'_apply,
    dotProduct, toAdd_adjacentHom_apply]

/-- The value on the transvection `eᵢ,ᵢ₊₁(c)` of a simple root: only the `i`-th coefficient
contributes. -/
theorem adjacentChar_transvection (ψ : AddChar R M) (a : Fin n → R) (i : Fin n) (c : R) :
    adjacentChar ψ a (transvection i.castSucc_lt_succ c) = ψ (a i * c) := by
  rw [adjacentChar_apply, Finset.sum_eq_single_of_mem i (Finset.mem_univ i)]
  · rw [← toAdd_adjacentHom_apply, adjacentHom_transvection]
    simp
  · intro k _ hk
    have hne : (i.castSucc, i.succ) ≠ (k.castSucc, k.succ) := fun h =>
      hk.symm (Fin.castSucc_injective _ (congrArg Prod.fst h))
    rw [← toAdd_adjacentHom_apply, adjacentHom_transvection]
    simp [hne]

end Ring

/-! ### Regular characters -/

section

variable {R : Type u} [Ring R] {n : ℕ} {M : Type v} [CommMonoid M]

/-- A *character* of `Uₙ₊₁(R)`, that is, a homomorphism to a commutative monoid, is *regular*
when it is nontrivial on the root subgroup `c ↦ eᵢ,ᵢ₊₁(c)` of every simple positive root. That it
is trivial on `U²`, the subgroup generated by the root subgroups of the non-simple positive
roots, holds for every character (`map_superdiagonalSubgroup_two_eq_one`), so it is no
condition. -/
def IsRegularChar (χ : upperUnitriangularGroup (Fin (n + 1)) R →* M) : Prop :=
  ∀ i : Fin n, ∃ c : R, χ (transvection i.castSucc_lt_succ c) ≠ 1

/-- A character is regular when, for every simple positive root, some element of its root
subgroup is sent to a value other than `1`. -/
theorem isRegularChar_def {χ : upperUnitriangularGroup (Fin (n + 1)) R →* M} :
    IsRegularChar χ ↔ ∀ i : Fin n, ∃ c : R, χ (transvection i.castSucc_lt_succ c) ≠ 1 :=
  Iff.rfl

/-- Composing a character with an injective homomorphism of commutative monoids, such as the
inclusion of the units of a commutative ring, preserves regularity. -/
theorem isRegularChar_comp_iff_of_injective {N : Type w} [CommMonoid N] {f : M →* N}
    (hf : Function.Injective f) (χ : upperUnitriangularGroup (Fin (n + 1)) R →* M) :
    IsRegularChar (f.comp χ) ↔ IsRegularChar χ := by
  simp only [IsRegularChar, MonoidHom.comp_apply, map_ne_one_iff f hf]

end

section CommMonoid

variable {R : Type u} [CommRing R] {n : ℕ} {M : Type v} [CommMonoid M]

/-- For a primitive additive character `ψ`, the character with coefficients `a` is regular exactly
when none of the coefficients vanishes. -/
theorem isRegularChar_adjacentChar_iff {ψ : AddChar R M} (hψ : ψ.IsPrimitive)
    (a : Fin n → R) :
    IsRegularChar (adjacentChar ψ a) ↔ ∀ i, a i ≠ 0 := by
  constructor
  · intro h i hai
    obtain ⟨c, hc⟩ := h i
    rw [adjacentChar_transvection, hai, zero_mul, ψ.map_zero_eq_one] at hc
    exact hc rfl
  · intro ha i
    obtain ⟨c, hc⟩ := AddChar.ne_one_iff.1 (hψ (ha i))
    exact ⟨c, by simpa only [AddChar.mulShift_apply, adjacentChar_transvection] using hc⟩

/-- A primitive additive character separates the coefficients: `a ↦ adjacentChar ψ a` is
injective. -/
theorem adjacentChar_injective {ψ : AddChar R M} (hψ : ψ.IsPrimitive) :
    Function.Injective (adjacentChar (R := R) (n := n) ψ) := by
  intro a b h
  funext i
  refine AddChar.to_mulShift_inj_of_isPrimitive hψ ?_
  ext c
  rw [AddChar.mulShift_apply, AddChar.mulShift_apply, ← adjacentChar_transvection,
    ← adjacentChar_transvection, DFunLike.congr_fun h _]

end CommMonoid

/-! ### The characters of `Uₙ₊₁(R)` over a finite ring -/

section RCLike

variable {R : Type u} [CommRing R] [Finite R] {n : ℕ} {M : Type v} [RCLike M]

/-- **Every character is a character with coefficients.** Over a finite commutative ring, let `ψ`
be a given primitive additive character with values in an `RCLike` field. Then every character of
`Uₙ₊₁(R)` with values in that field equals `adjacentChar ψ a` for a tuple of coefficients `a`
that is unique for this fixed `ψ`. -/
theorem existsUnique_eq_adjacentChar {ψ : AddChar R M} (hψ : ψ.IsPrimitive)
    (χ : upperUnitriangularGroup (Fin (n + 1)) R →* M) :
    ∃! a : Fin n → R, χ = adjacentChar ψ a := by
  -- through its units, `χ` is a group homomorphism trivial on the kernel of `adjacentHom`
  have hker : (adjacentHom R n).ker ≤ χ.toHomUnits.ker := fun g hg =>
    Units.ext ((MonoidHom.coe_toHomUnits χ g).trans
      (map_superdiagonalSubgroup_two_eq_one χ (by rw [← ker_adjacentHom]; exact hg)))
  let f' := MonoidHom.liftOfSurjective _ adjacentHom_surjective ⟨_, hker⟩
  have hcomp' : f'.comp (adjacentHom R n) = χ.toHomUnits :=
    MonoidHom.liftOfRightInverse_comp ..
  let f : Multiplicative (Fin n → R) →* M := (Units.coeHom M).comp f'
  have hcomp : f.comp (adjacentHom R n) = χ := by
    rw [MonoidHom.comp_assoc, hcomp']
    ext u
    simp only [MonoidHom.comp_apply, Units.coeHom_apply, MonoidHom.coe_toHomUnits]
  obtain ⟨φ, hφ⟩ : ∃ φ : AddChar (Fin n → R) M, ∀ b : Fin n → R, f (Multiplicative.ofAdd b) = φ b :=
    ⟨_, fun b => (AddChar.toMonoidHomEquiv_symm_apply _ b).symm⟩
  -- each coordinate character of `φ` is a shift of `ψ`
  have hcoord : ∀ i, ∃ aᵢ : R, ∀ x, φ (Pi.single i x) = ψ (aᵢ * x) := by
    intro i
    obtain ⟨aᵢ, haᵢ, -⟩ := hψ.existsUnique_mulShift_eq
      (φ.compAddMonoidHom (AddMonoidHom.single (fun _ => R) i))
    refine ⟨aᵢ, fun x => ?_⟩
    simpa only [AddChar.mulShift_apply, AddChar.compAddMonoidHom_apply,
      AddMonoidHom.single_apply] using (DFunLike.congr_fun haᵢ x).symm
  choose a ha using hcoord
  have hφval (b : Fin n → R) : φ b = ψ (∑ i, a i * b i) := by
    rw [AddChar.apply_eq_prod_single, AddChar.map_sum_eq_prod]
    exact Finset.prod_congr rfl fun i _ => ha i (b i)
  have key : χ = adjacentChar ψ a := by
    ext u
    rw [← hcomp, MonoidHom.comp_apply, ← ofAdd_toAdd (adjacentHom R n u), hφ, hφval,
      adjacentChar_apply]
    simp only [toAdd_adjacentHom_apply]
  exact ⟨a, key, fun b hb => adjacentChar_injective hψ (hb.symm.trans key)⟩

/-- **The regular characters of `Uₙ₊₁(R)`** over a finite commutative ring with values in an
`RCLike` field: for a primitive additive character `ψ`, they are the characters
`adjacentChar ψ a` none of whose coefficients vanishes, and the coefficients are unique
(`adjacentChar_injective`). -/
theorem isRegularChar_iff {ψ : AddChar R M} (hψ : ψ.IsPrimitive)
    (χ : upperUnitriangularGroup (Fin (n + 1)) R →* M) :
    IsRegularChar χ ↔ ∃ a : Fin n → R, (∀ i, a i ≠ 0) ∧ χ = adjacentChar ψ a := by
  constructor
  · intro hχ
    obtain ⟨a, h, -⟩ := existsUnique_eq_adjacentChar hψ χ
    exact ⟨a, (isRegularChar_adjacentChar_iff hψ a).1 (h ▸ hχ), h⟩
  · rintro ⟨a, ha, rfl⟩
    exact (isRegularChar_adjacentChar_iff hψ a).2 ha

end RCLike

/-! ### Conjugation by the diagonal torus -/

section DiagonalCommRing

variable {R : Type u} [CommRing R] {n : ℕ} {M : Type v} [Monoid M]

/-- Conjugating by `t` multiplies the `i`-th coefficient of a character by `tᵢ tᵢ₊₁⁻¹`. -/
theorem adjacentChar_comp_diagGLConj (t : Fin (n + 1) → Rˣ) (ψ : AddChar R M)
    (a : Fin n → R) :
    (adjacentChar ψ a).comp (diagGLConj t).toMonoidHom =
      adjacentChar ψ (fun i => a i * (t i.castSucc * (t i.succ)⁻¹)) := by
  ext u
  rw [MonoidHom.comp_apply, adjacentChar_apply, adjacentChar_apply]
  refine congrArg ψ (Finset.sum_congr rfl fun i _ => ?_)
  rw [← toAdd_adjacentHom_apply, MulEquiv.coe_toMonoidHom, adjacentHom_diagGLConj,
    toAdd_adjacentHom_apply]
  ring

/-- **The diagonal torus acts transitively on the characters with invertible coefficients**: for
tuples `a` and `b` of units, some diagonal conjugation takes the character with coefficients `a`
to the character with coefficients `b`. -/
theorem exists_comp_diagGLConj_eq (ψ : AddChar R M) {a b : Fin n → R}
    (ha : ∀ i, IsUnit (a i)) (hb : ∀ i, IsUnit (b i)) :
    ∃ t : Fin (n + 1) → Rˣ,
      (adjacentChar ψ a).comp (diagGLConj t).toMonoidHom = adjacentChar ψ b := by
  set u : Fin n → Rˣ := fun k => (hb k).unit⁻¹ * (ha k).unit with hu
  refine ⟨Fin.partialProd u, ?_⟩
  rw [adjacentChar_comp_diagGLConj]
  have hcoeff : (fun i => a i * (↑(Fin.partialProd u i.castSucc) * ↑(Fin.partialProd u i.succ)⁻¹))
      = b := by
    funext i
    have h : (ha i).unit * (Fin.partialProd u i.castSucc * (Fin.partialProd u i.succ)⁻¹) =
        (hb i).unit := by
      rw [Fin.partialProd_succ, hu]
      have hXu (x v : Rˣ) : x * (x * v)⁻¹ = v⁻¹ := by
        rw [mul_inv_rev (G := Rˣ), ← mul_assoc, mul_comm x v⁻¹, mul_assoc, mul_inv_cancel, mul_one]
      rw [hXu, mul_inv_rev (G := Rˣ), inv_inv]
      group
    rw [← (ha i).unit_spec, ← (hb i).unit_spec, ← Units.val_mul, ← Units.val_mul, h]
  rw [hcoeff]

end DiagonalCommRing

section Field

variable {F : Type u} [Field F] {n : ℕ} {M : Type v} [CommMonoid M]

/-- A regular character of `Uₙ₊₁(F)` gives a primitive additive character of `F`: it is nontrivial
on the root subgroup `c ↦ eᵢ,ᵢ₊₁(c)` of every simple root, and over a field a nontrivial additive
character is primitive. -/
private theorem exists_isPrimitive_addChar (i : Fin n)
    {χ : upperUnitriangularGroup (Fin (n + 1)) F →* M} (hχ : IsRegularChar χ) :
    ∃ ψ : AddChar F M, ψ.IsPrimitive := by
  obtain ⟨c, hc⟩ := hχ i
  refine ⟨⟨fun c => χ (transvection i.castSucc_lt_succ c), ?_, fun c d => ?_⟩,
    AddChar.IsPrimitive.of_ne_one ?_⟩
  · rw [transvection_zero]
    exact χ.map_one
  · rw [transvection_add]
    exact χ.map_mul _ _
  · rw [AddChar.ne_one_iff]
    exact ⟨c, hc⟩

end Field

section DiagonalField

variable {F : Type u} [Field F] [Finite F] {n : ℕ} {M : Type v} [RCLike M]

/-- **The diagonal torus permutes the regular characters transitively**: over a finite field with
values in an `RCLike` field, any two regular characters of `Uₙ₊₁(F)` are conjugate under the
diagonal torus. -/
theorem exists_comp_diagGLConj_eq_of_isRegularChar
    {χ χ' : upperUnitriangularGroup (Fin (n + 1)) F →* M} (hχ : IsRegularChar χ)
    (hχ' : IsRegularChar χ') :
    ∃ t : Fin (n + 1) → Fˣ, χ.comp (diagGLConj t).toMonoidHom = χ' := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- `U₁(F)` is trivial: an upper-unitriangular `1 × 1` matrix is `1`, so `U² = ⊤`
    have htop : superdiagonalSubgroup (R := F) (n := 0 + 1) 2 = ⊤ :=
      (Subgroup.eq_top_iff' _).2 fun g => (mem_superdiagonalSubgroup_iff _ _).2 fun i j _ => by
        rw [Fin.fin_one_eq_zero i, Fin.fin_one_eq_zero j, apply_diag, Matrix.one_apply_eq]
    have hone (η : upperUnitriangularGroup (Fin (0 + 1)) F →* M) : η = 1 :=
      MonoidHom.ext fun g => map_superdiagonalSubgroup_two_eq_one η (by rw [htop]; trivial)
    exact ⟨1, by rw [hone χ, hone χ']; exact MonoidHom.one_comp _⟩
  · obtain ⟨ψ, hψ⟩ := exists_isPrimitive_addChar (⟨0, hn⟩ : Fin n) hχ
    obtain ⟨a, ha, rfl⟩ := (isRegularChar_iff hψ χ).1 hχ
    obtain ⟨b, hb, rfl⟩ := (isRegularChar_iff hψ χ').1 hχ'
    exact exists_comp_diagGLConj_eq ψ (fun i => (isUnit_iff_ne_zero).2 (ha i))
      (fun i => (isUnit_iff_ne_zero).2 (hb i))

end DiagonalField

end TauCeti.UpperUnitriangularGroup
