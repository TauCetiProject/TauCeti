module

public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.UpperUnitriangular.Basic
-- Non-public: the index of the upper-unitriangular group is the order of `GLₙ(𝔽)` divided by its
-- own order.
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Card
-- Non-public: `Fintype.card_product_filter_lt` counts the pairs `i < j`.
import Mathlib.Data.Fintype.Prod
-- Non-public: `Nat.card_fun` counts the functions on the pairs `i < j`.
import Mathlib.SetTheory.Cardinal.NatCard

/-!
# The order of the upper-unitriangular group

An upper-unitriangular matrix is determined by its entries strictly above the diagonal: over a
ring `R`, `TauCeti.upperUnitriangularGroupEquiv` identifies the upper-unitriangular group `Uₙ(R)`
with the functions on the pairs `i < j`. Hence `|Uₙ(R)| = |R| ^ (n.choose 2)` for every ring `R`
(`TauCeti.natCard_upperUnitriangularGroup`, stated for any finite linearly ordered index type),
and over a field `𝔽` with `q` elements the index of `Uₙ(𝔽)` in `GLₙ(𝔽)` is
`∏_{i = 1}^{n} (q ^ i - 1)` (`TauCeti.index_upperUnitriangularGroup`): the order of `GLₙ(𝔽)`
(`TauCeti.natCard_GL_fin`) divided by the order of `Uₙ(𝔽)`. The index is the prime-to-`p` part of
the order of `GLₙ(𝔽)` for `p` the characteristic, and the degree of the Gelfand–Graev
representations of `GLₙ(𝔽)`. The subgroup `U₀*` of `Uₙ(R)` generated by the root subgroups of the
non-simple positive roots, on which the regular characters of `Uₙ(𝔽)` are trivial, is
`TauCeti.UpperUnitriangularGroup.superdiagonalSubgroup 2`; this file only computes cardinalities.

## Main declarations

* `TauCeti.natCard_upperUnitriangularGroup`: `|Uₙ(R)| = |R| ^ (n.choose 2)`.
* `TauCeti.index_upperUnitriangularGroup`: `[GLₙ(𝔽) : Uₙ(𝔽)] = ∏_{i = 1}^{n} (q ^ i - 1)`.

## References

* F. Digne, J. Michel, *Representations of Finite Groups of Lie Type*, Cambridge University Press,
  1991.
-/

public section

namespace TauCeti

open Matrix

variable {ι : Type*} [Fintype ι] [LinearOrder ι] {R : Type*} [Ring R]

/-- The order of the upper-unitriangular group over a ring `R`: an upper-unitriangular matrix is
determined by its `(Fintype.card ι).choose 2` entries strictly above the diagonal. Over an
infinite ring `R` both sides equal `1` in size at most one and `0` in larger sizes. -/
theorem natCard_upperUnitriangularGroup :
    Nat.card (upperUnitriangularGroup ι R) = Nat.card R ^ (Fintype.card ι).choose 2 := by
  classical
  rw [Nat.card_congr (upperUnitriangularGroupEquiv ι R), Nat.card_fun,
    Nat.card_eq_fintype_card (α := {p : ι × ι // p.1 < p.2}), Fintype.card_subtype,
    Fintype.card_product_filter_lt]

section Field

variable {n : ℕ} {𝔽 : Type*} [Field 𝔽]

/-- The index of the upper-unitriangular group in `GLₙ(𝔽)`, for a field `𝔽` with `q` elements,
is `∏_{i = 1}^{n} (q ^ i - 1)`: the order of `GLₙ(𝔽)` divided by the order of `Uₙ(𝔽)`. Over an
infinite field both sides are `1` when `n = 0` and `0` otherwise, the determinant inducing a
surjection from the coset space onto `𝔽ˣ`. -/
theorem index_upperUnitriangularGroup :
    (upperUnitriangularGroup (Fin n) 𝔽).index =
      ∏ i ∈ Finset.range n, (Nat.card 𝔽 ^ (i + 1) - 1) := by
  rcases finite_or_infinite 𝔽 with hF | hF
  · let := Fintype.ofFinite 𝔽
    rw [Subgroup.index_eq_card_div, natCard_GL_fin, natCard_upperUnitriangularGroup,
      Fintype.card_fin, Nat.mul_div_cancel_left _ (Nat.pow_pos (Finite.card_pos_iff.mpr ⟨0⟩))]
  · cases n with
    | zero =>
      rw [Finset.prod_range_zero, Subgroup.index_eq_one, Subgroup.eq_top_iff']
      intro g
      simp only [UpperUnitriangularGroup.mem_iff, Matrix.isUpperUnitriangular_def]
      exact ⟨fun i => i.elim0, fun i => i.elim0⟩
    | succ n =>
      -- The determinant is trivial on `Uₙ₊₁(𝔽)`, hence constant on the left cosets, so it
      -- induces a surjection of the coset space onto the infinite group `𝔽ˣ`.
      have hdet : ∀ g : GL (Fin (n + 1)) 𝔽, g ∈ upperUnitriangularGroup (Fin (n + 1)) 𝔽 →
          Matrix.GeneralLinearGroup.det g = 1 := fun g hg => Units.ext <| by
        rw [Matrix.GeneralLinearGroup.val_det_apply,
          (UpperUnitriangularGroup.mem_iff.1 hg).det_eq_one, Units.val_one]
      have hdetcoset : ∀ a b : GL (Fin (n + 1)) 𝔽,
          a⁻¹ * b ∈ upperUnitriangularGroup (Fin (n + 1)) 𝔽 →
          Matrix.GeneralLinearGroup.det a = Matrix.GeneralLinearGroup.det b := by
        intro a b hab
        have hb : b = a * (a⁻¹ * b) := by rw [mul_inv_cancel_left]
        rw [hb, Matrix.GeneralLinearGroup.det.map_mul, hdet _ hab, mul_one]
      have hsurj : Function.Surjective
          (fun q : GL (Fin (n + 1)) 𝔽 ⧸ upperUnitriangularGroup (Fin (n + 1)) 𝔽 =>
            q.liftOn' (fun g => Matrix.GeneralLinearGroup.det g)
              (fun a b hab => hdetcoset a b (QuotientGroup.leftRel_apply.mp hab))) := by
        intro x
        obtain ⟨g, hg⟩ := Matrix.GeneralLinearGroup.det_surjective (n := Fin (n + 1)) x
        refine ⟨QuotientGroup.mk g, ?_⟩
        simp only [QuotientGroup.quotient_liftOn_mk]
        exact hg
      rw [Subgroup.index_eq_card,
        Finite.card_eq_zero_of_surjective hsurj (by simp [Nat.card_units]),
        Nat.card_eq_zero_of_infinite (α := 𝔽)]
      simp

end Field

end TauCeti

end
