module

public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.UpperUnitriangular.Nilpotent
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.UpperUnitriangular.Transvection
-- Non-public: `Group.Abelianization.commutator_le_ker` shows that a character kills commutators, in
-- the proof of `map_superdiagonalSubgroup_two_eq_one`.
import Mathlib.GroupTheory.Abelianization.Defs

/-!
# Exact commutators of the superdiagonal filtration

For a ring `R`, let `U^r ≤ Uₙ(R)` be the subgroup of upper-unitriangular matrices whose entries
strictly between the diagonal and the `r`-th superdiagonal vanish
(`TauCeti.UpperUnitriangularGroup.superdiagonalSubgroup r`). The inclusion
`[U^r, U^s] ≤ U^(r+s)` holds by a filtration estimate. This file proves that it is an equality for
`r, s ≥ 1`, over every ring:

```text
[U^r, U^s] = U^(r+s).
```

In the indexing of Harpaz and Wittenberg, where `U^m` is the subgroup whose first `m`
superdiagonals vanish (Tau Ceti's `U^(m+1)`), this reads `[U^a, U^b] = U^(a+b+1)` for `a, b ≥ 0`.

The reverse inclusion rests on generation: `U^r` is generated by the transvections
`e_ij(c) = 1 + c Eᵢⱼ` with `j - i ≥ r`.

Consequently the lower central series of `Uₙ(R)` is exactly the superdiagonal filtration:
`lowerCentralSeries k = U^(k+1)`, where Mathlib numbers the series from the whole group at
`k = 0`. The derived subgroup is `U^2`, and over a nontrivial ring the nilpotency class of
`Uₙ(R)` is exactly `n - 1`. In particular every character of `Uₙ(R)`, that is, every
homomorphism to a commutative monoid, is trivial on `U^2`.

## Main declarations

* `TauCeti.UpperUnitriangularGroup.superdiagonalSubgroup_eq_closure`: `U^r` is generated by the
  transvections `e_ij(c)` with `j - i ≥ r`.
* `TauCeti.UpperUnitriangularGroup.commutator_superdiagonalSubgroup`: `[U^r, U^s] = U^(r+s)` for
  `r, s ≥ 1`.
* `TauCeti.UpperUnitriangularGroup.lowerCentralSeries_eq_superdiagonalSubgroup`: the lower
  central series is the superdiagonal filtration.
* `TauCeti.UpperUnitriangularGroup.commutator_eq_superdiagonalSubgroup_two`: the derived
  subgroup is `U^2`.
* `TauCeti.UpperUnitriangularGroup.map_superdiagonalSubgroup_two_eq_one`: every homomorphism to a
  commutative monoid is trivial on `U^2`.
* `TauCeti.UpperUnitriangularGroup.nilpotencyClass_eq`: over a nontrivial ring, the nilpotency
  class of `Uₘ(R)` is `card m - 1`.

## Implementation notes

Generation is proved by clearing entries: right multiplication by `e_ij(-g_ij)` clears the entry
`(i, j)` of `g` and changes no other entry at distance `j - i`, so the entries at distance exactly
`r` are cleared one by one, landing in `U^(r+1)`, and one descends on `r`. If `j - i ≥ r + s`,
then with `k = i + r` the Chevalley commutator relation writes `e_ij(c) = [e_ik(c), e_kj(1)]` as
a commutator of an element of `U^r` and an element of `U^s`.

## References

* Y. Harpaz and O. Wittenberg, *The Massey vanishing conjecture for number fields*, §2.
* I. M. Michailov, *Bogomolov multipliers for unitriangular groups*, arXiv:1308.3408v2
  (C. R. Acad. Bulgare Sci. 68 (2015), 689–696), §3, (3.2), p. 5.
-/

public section

open Matrix
open scoped commutatorElement

namespace TauCeti.UpperUnitriangularGroup

universe u

variable {R : Type u} [Ring R]

/-! ### Generation of the superdiagonal filtration by transvections -/

variable {n : ℕ}

/-- `e_ij(c)` lies in `U^r` when `j - i ≥ r`. -/
theorem transvection_mem_superdiagonalSubgroup {i j : Fin n} (hij : i < j) {r : ℕ}
    (hr : i.val + r ≤ j.val) (c : R) :
    transvection hij c ∈ superdiagonalSubgroup (R := R) r := by
  rw [mem_superdiagonalSubgroup_iff]
  intro k l hkl
  have hne : ¬(i = k ∧ j = l) := fun h ↦ by
    obtain ⟨rfl, rfl⟩ := h
    omega
  simp [coe_transvectionUnit_eq_one_add_single, hne]

/-- The transvections `e_ij(c)` in `Uₙ(R)` with `j - i ≥ r`. They generate `U^r`
(`TauCeti.UpperUnitriangularGroup.superdiagonalSubgroup_eq_closure`). -/
def superdiagonalTransvections (r : ℕ) : Set (upperUnitriangularGroup (Fin n) R) :=
  {g | ∃ (i j : Fin n) (hij : i < j), i.val + r ≤ j.val ∧ ∃ c : R, transvection hij c = g}

/-- Membership in `superdiagonalTransvections r`: being a transvection `e_ij(c)` with
`j - i ≥ r`. -/
@[simp]
theorem mem_superdiagonalTransvections_iff {r : ℕ} {g : upperUnitriangularGroup (Fin n) R} :
    g ∈ superdiagonalTransvections r ↔
      ∃ (i j : Fin n) (hij : i < j), i.val + r ≤ j.val ∧ ∃ c : R, transvection hij c = g :=
  Iff.rfl

/-- A transvection `e_ij(c)` with `j - i ≥ r` belongs to `superdiagonalTransvections r`. -/
theorem transvection_mem_superdiagonalTransvections {i j : Fin n} (hij : i < j) {r : ℕ}
    (hr : i.val + r ≤ j.val) (c : R) :
    transvection hij c ∈ superdiagonalTransvections (R := R) r :=
  ⟨i, j, hij, hr, c, rfl⟩

/-- Requiring a larger distance from the diagonal gives fewer transvections. -/
theorem superdiagonalTransvections_antitone :
    Antitone (superdiagonalTransvections (R := R) (n := n)) := by
  rintro r s hrs _ ⟨i, j, hij, hd, c, rfl⟩
  exact ⟨i, j, hij, by omega, c, rfl⟩

/-- The entries of `g ∈ U^r` at distance exactly `r` that lie outside a finite set `P` of
positions vanish; then clearing the positions of `P` one at a time shows that `g` lies in the
subgroup generated by the transvections at distance at least `r`, provided `U^(r+1)` does. -/
private theorem mem_closure_of_apply_eq_zero {r : ℕ} (hr : 0 < r)
    (hnext : superdiagonalSubgroup (R := R) (n := n) (r + 1) ≤ Subgroup.closure
      (superdiagonalTransvections (r + 1)))
    (P : Finset (Fin n × Fin n)) :
    ∀ g ∈ superdiagonalSubgroup (R := R) (n := n) r,
      (∀ i j : Fin n, j.val = i.val + r → (i, j) ∉ P →
        ((g : GL (Fin n) R) : Matrix (Fin n) (Fin n) R) i j = 0) →
      g ∈ Subgroup.closure (superdiagonalTransvections r) := by
  induction P using Finset.induction_on with
  | empty =>
    -- With every entry at distance `r` zero, `g` lies one step further down the filtration.
    intro g hg hzero
    refine Subgroup.closure_mono (superdiagonalTransvections_antitone r.le_succ) (hnext ?_)
    rw [mem_superdiagonalSubgroup_iff] at hg ⊢
    intro i j hij
    rcases Nat.lt_or_ge j.val (i.val + r) with h | h
    · exact hg i j h
    · have hne : i ≠ j := fun h' ↦ by subst h'; omega
      rw [hzero i j (by omega) (Finset.notMem_empty _), one_apply_ne hne]
  | insert p P _ ih =>
    intro g hg hzero
    obtain ⟨a, b⟩ := p
    by_cases hab : b.val = a.val + r
    · -- Clear the entry `(a, b)` by a transvection and apply the induction hypothesis.
      have hab' : a < b := Fin.lt_def.2 (by omega)
      set c := ((g : GL (Fin n) R) : Matrix (Fin n) (Fin n) R) a b
      have hg' : g * transvection hab' (-c) ∈ Subgroup.closure
          (superdiagonalTransvections r) := by
        refine ih _ (mul_mem hg (transvection_mem_superdiagonalSubgroup hab' hab.ge _)) ?_
        intro i j hd hP
        rw [coe_mul_transvection_apply]
        by_cases hjb : j = b
        · subst hjb
          obtain rfl : i = a := Fin.ext (by omega)
          simp [c]
        · simp [hjb, hzero i j hd (by simp [hjb, hP])]
      have hgen : transvection hab' c ∈ Subgroup.closure
          (superdiagonalTransvections r) :=
        Subgroup.subset_closure (transvection_mem_superdiagonalTransvections hab' hab.ge c)
      simpa [mul_assoc, ← transvection_add] using mul_mem hg' hgen
    · refine ih g hg fun i j hd hP ↦ hzero i j hd ?_
      intro h
      rcases Finset.mem_insert.1 h with h | h
      · obtain ⟨rfl, rfl⟩ := Prod.ext_iff.1 h
        exact hab hd
      · exact hP h

/-- Descending induction on the filtration index: `U^r ≤ ⟨e_ij(c) : j - i ≥ r⟩` for `r ≥ 1`. -/
private theorem superdiagonalSubgroup_le_closure :
    ∀ k r : ℕ, 0 < r → n ≤ r + k →
      superdiagonalSubgroup (R := R) (n := n) r ≤ Subgroup.closure (superdiagonalTransvections r)
  | 0, r, _, hn => by
    rw [superdiagonalSubgroup_eq_bot_of_le (by omega)]
    exact bot_le
  | k + 1, r, hr, hn => fun g hg ↦
    mem_closure_of_apply_eq_zero hr
      (superdiagonalSubgroup_le_closure k (r + 1) (by omega) (by omega)) Finset.univ g hg
      fun _ _ _ h ↦ absurd (Finset.mem_univ _) h

/-- **Generation by transvections.** The subgroup `U^r ≤ Uₙ(R)` is generated by the
transvections `e_ij(c)` with `j - i ≥ r`. -/
theorem superdiagonalSubgroup_eq_closure (r : ℕ) :
    superdiagonalSubgroup (R := R) (n := n) r =
      Subgroup.closure (superdiagonalTransvections r) := by
  refine le_antisymm ?_ ((Subgroup.closure_le _).2 ?_)
  · rcases Nat.eq_zero_or_pos r with rfl | hr
    · -- `U^0` is the whole group, which is `U^1`, and the generators at distance `≥ 1` suffice.
      refine (le_top.trans (superdiagonalSubgroup_one (R := R) (n := n)).ge).trans ?_
      exact (superdiagonalSubgroup_le_closure n 1 one_pos (by omega)).trans
        (Subgroup.closure_mono (superdiagonalTransvections_antitone (Nat.zero_le 1)))
    · exact superdiagonalSubgroup_le_closure n r hr (by omega)
  · rintro _ ⟨i, j, hij, hd, c, rfl⟩
    exact transvection_mem_superdiagonalSubgroup hij hd c

/-! ### Exact commutators and the lower central series -/

/-- **Exact superdiagonal commutators.** For `r, s ≥ 1`, `[U^r, U^s] = U^(r+s)` in `Uₙ(R)`, over
every ring `R`. Both hypotheses are needed: `U^0 = U^1` is the whole group. -/
theorem commutator_superdiagonalSubgroup {r s : ℕ} (hr : 0 < r) (hs : 0 < s) :
    ⁅superdiagonalSubgroup (R := R) (n := n) r, superdiagonalSubgroup (R := R) (n := n) s⁆ =
      superdiagonalSubgroup (R := R) (n := n) (r + s) := by
  refine le_antisymm (commutator_superdiagonalSubgroup_le r s) ?_
  rw [superdiagonalSubgroup_eq_closure, Subgroup.closure_le]
  rintro _ ⟨i, j, hij, hd, c, rfl⟩
  -- Write `e_ij(c) = [e_ik(c), e_kj(1)]` with `k = i + r`.
  let k : Fin n := ⟨i.val + r, by omega⟩
  have hik : i < k := Fin.lt_def.2 (by simp [k]; omega)
  have hkj : k < j := Fin.lt_def.2 (by simp [k]; omega)
  have hmem := Subgroup.commutator_mem_commutator
    (transvection_mem_superdiagonalSubgroup hik (r := r) le_rfl c)
    (transvection_mem_superdiagonalSubgroup hkj (r := s) (by simp [k]; omega) (1 : R))
  rwa [commutatorElement_transvection, mul_one] at hmem

/-- The lower central series of `Uₙ(R)` is the superdiagonal filtration: with Mathlib's numbering,
in which the zeroth term is the whole group, the `k`-th term is `U^(k+1)`. -/
theorem lowerCentralSeries_eq_superdiagonalSubgroup (k : ℕ) :
    (⊤ : Subgroup (upperUnitriangularGroup (Fin n) R)).lowerCentralSeries k =
      superdiagonalSubgroup (R := R) (n := n) (k + 1) := by
  induction k with
  | zero => rw [Subgroup.lowerCentralSeries_zero, zero_add, superdiagonalSubgroup_one]
  | succ k ih =>
    rw [Subgroup.lowerCentralSeries_succ, ih, ← superdiagonalSubgroup_one,
      commutator_superdiagonalSubgroup (Nat.succ_pos k) one_pos]

/-- The derived subgroup of `Uₙ(R)` is `U^2`, the subgroup of matrices whose first superdiagonal
vanishes. -/
theorem commutator_eq_superdiagonalSubgroup_two :
    commutator (upperUnitriangularGroup (Fin n) R) = superdiagonalSubgroup (R := R) 2 := by
  rw [commutator_def, ← superdiagonalSubgroup_one, commutator_superdiagonalSubgroup one_pos one_pos]
  rfl

/-- Every character of `Uₙ(R)`, that is, every homomorphism to a commutative monoid, is trivial
on `U^2`: `U^2` is the commutator subgroup of `Uₙ(R)`, and through its units a character is a
homomorphism to a commutative group. -/
theorem map_superdiagonalSubgroup_two_eq_one {M : Type*} [CommMonoid M]
    (χ : upperUnitriangularGroup (Fin n) R →* M)
    {g : upperUnitriangularGroup (Fin n) R} (hg : g ∈ superdiagonalSubgroup 2) : χ g = 1 := by
  rw [← commutator_eq_superdiagonalSubgroup_two] at hg
  simpa only [MonoidHom.coe_toHomUnits, Units.val_one] using
    congrArg Units.val
      (MonoidHom.mem_ker.1 (Group.Abelianization.commutator_le_ker χ.toHomUnits hg))

private theorem sub_one_le_nilpotencyClass [Nontrivial R] :
    n - 1 ≤ Group.nilpotencyClass (upperUnitriangularGroup (Fin n) R) := by
  by_contra hlt
  -- Otherwise `U^(n-1)` would be trivial, but it contains the corner transvection `e_0(n-1)(1)`.
  have hbot := (Subgroup.lowerCentralSeries_eq_bot_iff_nilpotencyClass_le
    (G := upperUnitriangularGroup (Fin n) R) (n := n - 2)).2 (by omega)
  rw [lowerCentralSeries_eq_superdiagonalSubgroup] at hbot
  let i : Fin n := ⟨0, by omega⟩
  let j : Fin n := ⟨n - 1, by omega⟩
  have hij : i < j := Fin.lt_def.2 (by simp [i, j]; omega)
  have hmem := transvection_mem_superdiagonalSubgroup hij (r := n - 2 + 1) (by simp [i, j]; omega)
    (1 : R)
  rw [hbot, Subgroup.mem_bot, transvection_eq_one_iff] at hmem
  exact one_ne_zero hmem

/-- Over a nontrivial ring, the nilpotency class of `Uₘ(R)` is exactly `card m - 1`: the upper
bound `TauCeti.UpperUnitriangularGroup.nilpotencyClass_le` is attained. -/
theorem nilpotencyClass_eq [Nontrivial R] {m : Type*} [Fintype m] [LinearOrder m] :
    Group.nilpotencyClass (upperUnitriangularGroup m R) = Fintype.card m - 1 := by
  let e := (Fintype.orderIsoFinOfCardEq m rfl).reindexUpperUnitriangularGroup R
  refine le_antisymm UpperUnitriangularGroup.nilpotencyClass_le ?_
  exact sub_one_le_nilpotencyClass.trans
    (Group.nilpotencyClass_le_of_surjective e.symm.toMonoidHom e.symm.surjective)

end TauCeti.UpperUnitriangularGroup
