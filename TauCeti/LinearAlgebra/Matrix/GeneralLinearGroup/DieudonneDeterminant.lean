public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Stability

/-!
# The Dieudonné determinant and `K₁` of a division ring

Let `D` be a possibly noncommutative division ring and `Dˣᵃᵇ = Dˣ ⧸ [Dˣ, Dˣ]` the
abelianization of its unit group. The **Dieudonné determinant** is the homomorphism

  `Δₙ : GLₙ(D) →* Dˣᵃᵇ`

computed by Gaussian elimination: it is invariant under elementary row operations and sends
`diag(d, 1, …, 1)` to the class of `d`. For `n ≥ 2` it is surjective with kernel exactly the
elementary subgroup `Eₙ(D)`, and stably it identifies algebraic `K₁` of `D`:

  `K₁(D) ≃* Dˣᵃᵇ`, `[(d)] ↦ [d]`.

For a field this is `K₁(F) = Fˣ`. For `n = 1` the kernel of `Δ₁ : Dˣ → Dˣᵃᵇ` is the commutator
subgroup `[Dˣ, Dˣ]` rather than `E₁(D) = 1`, so the kernel formula needs `n ≥ 2`.

## Construction

A division ring is local, so it has Bass stable range one. Surjective and injective stability
then give `GL₂(D) ⧸ E₂(D) ≃* K₁(D)` and show that every class of `K₁(D)` is the class of a
`1 × 1` matrix. Hence `K₁(D)` is a quotient of `Dˣᵃᵇ`, and it remains to construct an inverse,
which is the determinant in size two. For `g = !![a, b; c, d]` it is

  `Δ₂(g) = [a] [d - c a⁻¹ b]` if `a ≠ 0`, and `Δ₂(g) = [-c] [b]` if `a = 0`,

the second case exchanging the two rows first. Comparing with the elimination on the pivot `c`,
`Δ₂(g) = [-c] [b - a c⁻¹ d]` whenever `c ≠ 0`, one checks that `Δ₂` is unchanged by both
elementary row operations and multiplied by `[μ]` when the first row is multiplied on the left
by `μ`. Since `GL₂(D)` is generated by elementary matrices and the matrices `diag(μ, 1)`, `Δ₂`
is multiplicative. The determinant in size `n` is then the class in `K₁(D)` followed by the
isomorphism `K₁(D) ≃* Dˣᵃᵇ`.

## Main definitions

* `TauCeti.AlgebraicK1.dieudonneDetEquiv`: the isomorphism `K₁(D) ≃* Dˣᵃᵇ`, sending the class of
  the `1 × 1` matrix `(d)` to the class of `d`.
* `TauCeti.dieudonneDet`: the Dieudonné determinant `GLₙ(D) →* Dˣᵃᵇ`.
* `TauCeti.dieudonneDetFintype`: the Dieudonné determinant `GL n D →* Dˣᵃᵇ` over an arbitrary
  finite index type `n`, obtained by relabelling the indices by `Fin (Fintype.card n)`.

## Main results

* `TauCeti.AlgebraicK1.ker_ofUnits`: the class `Dˣ →* K₁(D)` of `1 × 1` matrices has kernel
  `[Dˣ, Dˣ]`.
* `TauCeti.dieudonneDet_stabilizeGL`, `TauCeti.dieudonneDet_scalar_fin_one`: the determinant is
  compatible with stabilization `g ↦ g ⊕ 1`, and sends the `1 × 1` matrix `(d)`, hence
  `diag(d, 1, …, 1)`, to the class of `d`.
* `TauCeti.dieudonneDet_diagGL_mulSingle`, `TauCeti.dieudonneDet_diagGL`: the determinant sends
  the diagonal matrix with `d` in any position `i` and `1` elsewhere to the class of `d`, and an
  invertible diagonal matrix to the product of the classes of its entries.
* `TauCeti.dieudonneDet_surjective`: `Δₙ` is surjective for `n ≥ 1`.
* `TauCeti.ker_dieudonneDet`: `ker Δₙ = Eₙ(D)` for `n ≥ 2`.
* `TauCeti.dieudonneDet_reindexGL`, `TauCeti.dieudonneDetFintype_eq`: relabelling the indices does
  not change the determinant, so `dieudonneDetFintype` does not depend on the relabelling.
* `TauCeti.dieudonneDetFintype_surjective`, `TauCeti.ker_dieudonneDetFintype`,
  `TauCeti.dieudonneDetFintype_diagGL_mulSingle`, `TauCeti.dieudonneDetFintype_diagGL`: the same
  surjectivity, kernel and diagonal values over an arbitrary finite index type.
* `TauCeti.dieudonneDet_fin_two_of_ne_zero`, `TauCeti.dieudonneDet_fin_two_of_eq_zero`: the
  explicit formulas for `Δ₂`.

## References

* J. Dieudonné, *Les déterminants sur un corps non commutatif*, Bull. Soc. Math. France 71
  (1943), 27–45.
* E. Artin, *Geometric Algebra*, Interscience (1957), Chapter IV, §1.
* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter III, 1.2.4 and Example 1.3.5.
-/

public section

noncomputable section

open Matrix

namespace TauCeti

variable {D : Type*} [DivisionRing D]

/-! ## The determinant of `2 × 2` matrices -/

section TwoByTwo

open scoped Classical in
/-- The class in `Dˣᵃᵇ` of an element of `D`, with the junk value `1` at `0`. -/
private def abClass (a : D) : Group.Abelianization Dˣ :=
  if h : a = 0 then 1 else Group.Abelianization.of (Units.mk0 a h)

private theorem abClass_coe (u : Dˣ) : abClass (u : D) = Group.Abelianization.of u := by
  simp [abClass]

private theorem abClass_one : abClass (1 : D) = 1 := by
  simpa using abClass_coe (1 : Dˣ)

private theorem abClass_mul {a b : D} (ha : a ≠ 0) (hb : b ≠ 0) :
    abClass (a * b) = abClass a * abClass b := by
  lift a to Dˣ using ha.isUnit
  lift b to Dˣ using hb.isUnit
  rw [← Units.val_mul, abClass_coe, abClass_coe, abClass_coe, map_mul]

private theorem abClass_inv {a : D} (ha : a ≠ 0) : abClass a⁻¹ = (abClass a)⁻¹ := by
  lift a to Dˣ using ha.isUnit
  rw [← Units.val_inv_eq_inv_val, abClass_coe, abClass_coe, map_inv]

open scoped Classical in
/-- The Dieudonné determinant of a `2 × 2` matrix `!![a, b; c, d]`: elimination on the pivot `a`
gives `[a] [d - c a⁻¹ b]` when `a ≠ 0`, and exchanging the rows gives `[-c] [b]` when `a = 0`. -/
private def det₂ (g : Matrix (Fin 2) (Fin 2) D) : Group.Abelianization Dˣ :=
  if g 0 0 = 0 then abClass (-g 1 0) * abClass (g 0 1)
  else abClass (g 0 0) * abClass (g 1 1 - g 1 0 * (g 0 0)⁻¹ * g 0 1)

private theorem det₂_of_eq_zero {g : Matrix (Fin 2) (Fin 2) D} (h : g 0 0 = 0) :
    det₂ g = abClass (-g 1 0) * abClass (g 0 1) := by
  simp [det₂, h]

private theorem det₂_of_ne_zero {g : Matrix (Fin 2) (Fin 2) D} (h : g 0 0 ≠ 0) :
    det₂ g = abClass (g 0 0) * abClass (g 1 1 - g 1 0 * (g 0 0)⁻¹ * g 0 1) := by
  simp [det₂, h]

/-- With a nonzero pivot `a`, the Schur complement `d - c a⁻¹ b` of an invertible matrix is
nonzero. -/
private theorem schur_ne_zero (g : GL (Fin 2) D) (ha : g 0 0 ≠ 0) :
    g 1 1 - g 1 0 * (g 0 0)⁻¹ * g 0 1 ≠ 0 := by
  intro hs
  have h := mulVec_injective_of_isUnit g.isUnit (a₁ := ![-((g 0 0)⁻¹ * g 0 1), 1]) (a₂ := 0) <| by
    rw [mulVec_zero]
    ext i
    fin_cases i
    · simp [mulVec, dotProduct, Fin.sum_univ_two, ← mul_assoc, mul_inv_cancel₀ ha]
    · simpa [mulVec, dotProduct, Fin.sum_univ_two, ← mul_assoc, sub_eq_add_neg, add_comm]
        using hs
  simpa using congrFun h 1

/-- An invertible matrix has no zero first column. -/
private theorem apply_one_zero_ne_zero (g : GL (Fin 2) D) (ha : g 0 0 = 0) : g 1 0 ≠ 0 := by
  intro hc
  have h := mulVec_injective_of_isUnit g.isUnit (a₁ := ![1, 0]) (a₂ := 0) <| by
    rw [mulVec_zero]
    ext i
    fin_cases i <;> simp [mulVec, dotProduct, Fin.sum_univ_two, ha, hc]
  simpa using congrFun h 0

/-- An invertible matrix has no zero first row. -/
private theorem apply_zero_one_ne_zero (g : GL (Fin 2) D) (ha : g 0 0 = 0) : g 0 1 ≠ 0 := by
  intro hb
  have h := vecMul_injective_of_isUnit g.isUnit (a₁ := ![1, 0]) (a₂ := 0) <| by
    simp only [zero_vecMul]
    ext j
    fin_cases j <;> simp [vecMul, dotProduct, Fin.sum_univ_two, ha, hb]
  simpa using congrFun h 0

/-- Elimination on the pivot `c ≠ 0` computes the same determinant:
`Δ₂(!![a, b; c, d]) = [-c] [b - a c⁻¹ d]`. -/
private theorem det₂_of_ne_zero' (g : GL (Fin 2) D) (hc : g 1 0 ≠ 0) :
    det₂ (g : Matrix (Fin 2) (Fin 2) D) =
      abClass (-g 1 0) * abClass (g 0 1 - g 0 0 * (g 1 0)⁻¹ * g 1 1) := by
  by_cases ha : g 0 0 = 0
  · simp [det₂_of_eq_zero ha, ha]
  rw [det₂_of_ne_zero ha]
  set t := g 0 1 - g 0 0 * (g 1 0)⁻¹ * g 1 1
  -- The two Schur complements are related by `d - c a⁻¹ b = (-c) (a⁻¹ t)`.
  have hst : g 1 1 - g 1 0 * (g 0 0)⁻¹ * g 0 1 = -g 1 0 * ((g 0 0)⁻¹ * t) := by
    simp only [t, mul_sub, neg_mul, ← mul_assoc, inv_mul_cancel₀ ha, one_mul,
      mul_inv_cancel₀ hc]
    abel
  have ht : t ≠ 0 := by
    intro ht
    exact schur_ne_zero g ha (by rw [hst, ht, mul_zero, mul_zero])
  rw [hst, abClass_mul (neg_ne_zero.mpr hc) (mul_ne_zero (inv_ne_zero ha) ht),
    abClass_mul (inv_ne_zero ha) ht, abClass_inv ha]
  -- In the abelian group `Dˣᵃᵇ` the factors `[a]` and `[a]⁻¹` cancel.
  rw [mul_left_comm (abClass (g 0 0)), mul_inv_cancel_left]

private theorem det₂_one : det₂ (1 : Matrix (Fin 2) (Fin 2) D) = 1 := by
  simp [det₂_of_ne_zero, abClass_one]

/-- `Δ₂` is unchanged by adding a left multiple of the second row to the first. -/
private theorem det₂_transvection_zero_one (x : D) (g : GL (Fin 2) D) :
    det₂ ((transvectionUnit (show (0 : Fin 2) ≠ 1 by decide) x * g : GL (Fin 2) D) :
      Matrix (Fin 2) (Fin 2) D) = det₂ (g : Matrix (Fin 2) (Fin 2) D) := by
  set g' := transvectionUnit (show (0 : Fin 2) ≠ 1 by decide) x * g
  have h0 : ∀ k, g' 0 k = g 0 k + x * g 1 k := fun k ↦ by
    simp only [g', Units.val_mul, transvectionUnit_mul_apply_same]
  have h1 : ∀ k, g' 1 k = g 1 k := fun k ↦ by
    simp only [g', Units.val_mul,
      transvectionUnit_mul_apply_of_ne _ x _ (show (1 : Fin 2) ≠ 0 by decide)]
  by_cases hc : g 1 0 = 0
  · have ha := apply_one_zero_ne_zero g |>.mt (not_not.mpr hc)
    rw [det₂_of_ne_zero ha, det₂_of_ne_zero (by rwa [h0, hc, mul_zero, add_zero])]
    simp [h0, h1, hc]
  · rw [det₂_of_ne_zero' g hc, det₂_of_ne_zero' g' (by rwa [h1])]
    simp only [h0, h1]
    congr 2
    simp only [add_mul, mul_assoc, mul_inv_cancel_left₀ hc]
    abel

/-- `Δ₂` is unchanged by adding a left multiple of the first row to the second. -/
private theorem det₂_transvection_one_zero (x : D) (g : GL (Fin 2) D) :
    det₂ ((transvectionUnit (show (1 : Fin 2) ≠ 0 by decide) x * g : GL (Fin 2) D) :
      Matrix (Fin 2) (Fin 2) D) = det₂ (g : Matrix (Fin 2) (Fin 2) D) := by
  set g' := transvectionUnit (show (1 : Fin 2) ≠ 0 by decide) x * g
  have h0 : ∀ k, g' 0 k = g 0 k := fun k ↦ by
    simp only [g', Units.val_mul,
      transvectionUnit_mul_apply_of_ne _ x _ (show (0 : Fin 2) ≠ 1 by decide)]
  have h1 : ∀ k, g' 1 k = g 1 k + x * g 0 k := fun k ↦ by
    simp only [g', Units.val_mul, transvectionUnit_mul_apply_same]
  by_cases ha : g 0 0 = 0
  · rw [det₂_of_eq_zero ha, det₂_of_eq_zero (by rwa [h0])]
    simp [h0, h1, ha]
  · rw [det₂_of_ne_zero ha, det₂_of_ne_zero (by rwa [h0])]
    simp only [h0, h1]
    congr 2
    simp only [add_mul, mul_assoc, mul_inv_cancel_left₀ ha]
    abel

/-- The matrix `diag(u, 1)` of `GL₂(D)`: the stabilization of the `1 × 1` matrix `(u)`. -/
private abbrev diag₂ (u : Dˣ) : GL (Fin 2) D :=
  stabilizeGL D (show 1 ≤ 2 by decide) (GeneralLinearGroup.scalar (Fin 1) u)

private theorem coe_diag₂ (u : Dˣ) :
    (diag₂ u : Matrix (Fin 2) (Fin 2) D) = diagonal ![(u : D), 1] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [coe_stabilizeGL_apply]

/-- `Δ₂` is multiplied by `[u]` when the first row is multiplied on the left by `u`. -/
private theorem det₂_diag₂_mul (u : Dˣ) (g : GL (Fin 2) D) :
    det₂ ((diag₂ u * g : GL (Fin 2) D) : Matrix (Fin 2) (Fin 2) D) =
      Group.Abelianization.of u * det₂ (g : Matrix (Fin 2) (Fin 2) D) := by
  set g' := diag₂ u * g
  have h0 : ∀ k, g' 0 k = u * g 0 k := fun k ↦ by simp [g', Units.val_mul, coe_diag₂]
  have h1 : ∀ k, g' 1 k = g 1 k := fun k ↦ by simp [g', Units.val_mul, coe_diag₂]
  by_cases ha : g 0 0 = 0
  · rw [det₂_of_eq_zero ha, det₂_of_eq_zero (by rw [h0, ha, mul_zero])]
    simp only [h0, h1]
    rw [abClass_mul u.ne_zero (apply_zero_one_ne_zero g ha), abClass_coe, mul_left_comm]
  · rw [det₂_of_ne_zero ha, det₂_of_ne_zero (by rw [h0]; exact mul_ne_zero u.ne_zero ha)]
    simp only [h0, h1]
    have hs : g 1 0 * ((u : D) * g 0 0)⁻¹ * ((u : D) * g 0 1) = g 1 0 * (g 0 0)⁻¹ * g 0 1 := by
      simp only [_root_.mul_inv_rev, mul_assoc, inv_mul_cancel_left₀ u.ne_zero]
    rw [hs, abClass_mul u.ne_zero ha, abClass_coe, mul_assoc]

private theorem det₂_diag₂ (u : Dˣ) :
    det₂ ((diag₂ u : GL (Fin 2) D) : Matrix (Fin 2) (Fin 2) D) = Group.Abelianization.of u := by
  simpa [det₂_one] using det₂_diag₂_mul u 1

/-- The elements `e` of `GL₂(D)` with `Δ₂(e g) = Δ₂(g)` for every `g` form a subgroup. -/
private def det₂Stabilizer : Subgroup (GL (Fin 2) D) where
  carrier := {e | ∀ g : GL (Fin 2) D,
    det₂ ((e * g : GL (Fin 2) D) : Matrix (Fin 2) (Fin 2) D) = det₂ (g : Matrix (Fin 2) (Fin 2) D)}
  mul_mem' {e f} he hf g := by rw [mul_assoc, he, hf]
  one_mem' g := by rw [one_mul]
  inv_mem' {e} he g := by rw [← he, mul_inv_cancel_left]

private theorem elementarySubgroup_le_det₂Stabilizer :
    elementarySubgroup (Fin 2) D ≤ det₂Stabilizer := by
  refine elementarySubgroup_le_iff.2 fun i j hij x ↦ ?_
  fin_cases i <;> fin_cases j
  · exact absurd rfl hij
  · exact det₂_transvection_zero_one x
  · exact det₂_transvection_one_zero x
  · exact absurd rfl hij

/-- Every matrix of `GL₂(D)` is an elementary matrix times `diag(u, 1)`. -/
private theorem exists_mem_elementarySubgroup_mul (g : GL (Fin 2) D) :
    ∃ e ∈ elementarySubgroup (Fin 2) D, ∃ u : Dˣ, g = e * diag₂ u := by
  obtain ⟨u, hu⟩ := AlgebraicK1.ofUnits_surjective (hasStableRangeLE_one_of_isLocalRing D)
    (AlgebraicK1.mk D 2 g)
  refine ⟨g * (diag₂ u)⁻¹, ?_, u, by rw [inv_mul_cancel_right]⟩
  rw [← AlgebraicK1.ker_mk_eq_elementarySubgroup (hasStableRangeLE_one_of_isLocalRing D) le_rfl,
    MonoidHom.mem_ker, map_mul, map_inv, AlgebraicK1.mk_stabilizeGL, ← AlgebraicK1.ofUnits_apply,
    hu, mul_inv_cancel]

/-- The Dieudonné determinant on `GL₂(D)`, as a homomorphism. -/
private def det₂Hom : GL (Fin 2) D →* Group.Abelianization Dˣ where
  toFun g := det₂ (g : Matrix (Fin 2) (Fin 2) D)
  map_one' := det₂_one
  map_mul' g h := by
    obtain ⟨e, he, u, rfl⟩ := exists_mem_elementarySubgroup_mul g
    have he' := elementarySubgroup_le_det₂Stabilizer he
    simp only [mul_assoc]
    rw [he', he', det₂_diag₂_mul, det₂_diag₂]

private theorem det₂Hom_apply (g : GL (Fin 2) D) :
    det₂Hom g = det₂ (g : Matrix (Fin 2) (Fin 2) D) :=
  (rfl)

private theorem ker_mk_le_ker_det₂Hom :
    (AlgebraicK1.mk D 2).ker ≤ (det₂Hom (D := D)).ker := by
  rw [AlgebraicK1.ker_mk_eq_elementarySubgroup (hasStableRangeLE_one_of_isLocalRing D) le_rfl]
  intro e he
  have := elementarySubgroup_le_det₂Stabilizer he 1
  rwa [mul_one, Units.val_one, det₂_one] at this

/-- The determinant `K₁(D) →* Dˣᵃᵇ`, through `K₁(D) ≃* GL₂(D) ⧸ ker` and `Δ₂`. -/
private def k1ToAb : AlgebraicK1 D →* Group.Abelianization Dˣ :=
  (QuotientGroup.lift _ det₂Hom ker_mk_le_ker_det₂Hom).comp
    ((AlgebraicK1.quotientKerMkEquiv (hasStableRangeLE_one_of_isLocalRing D)
      (show 1 ≤ 2 by decide)).symm : AlgebraicK1 D →* GL (Fin 2) D ⧸ (AlgebraicK1.mk D 2).ker)

private theorem k1ToAb_mk (g : GL (Fin 2) D) :
    k1ToAb (AlgebraicK1.mk D 2 g) = det₂ (g : Matrix (Fin 2) (Fin 2) D) := by
  have h : (AlgebraicK1.quotientKerMkEquiv (hasStableRangeLE_one_of_isLocalRing D)
      (show 1 ≤ 2 by decide)).symm (AlgebraicK1.mk D 2 g) = (g : GL (Fin 2) D ⧸ _) :=
    (MulEquiv.symm_apply_eq _).2 (AlgebraicK1.quotientKerMkEquiv_mk _ _ g).symm
  rw [k1ToAb, MonoidHom.comp_apply, MonoidHom.coe_ofClass, h, QuotientGroup.lift_mk, det₂Hom_apply]

private theorem k1ToAb_ofUnits (u : Dˣ) :
    k1ToAb (AlgebraicK1.ofUnits D u) = Group.Abelianization.of u := by
  rw [AlgebraicK1.ofUnits_apply, ← AlgebraicK1.mk_stabilizeGL (show 1 ≤ 2 by decide), k1ToAb_mk,
    det₂_diag₂]

end TwoByTwo

/-! ## `K₁` of a division ring -/

namespace AlgebraicK1

variable (D) in
/-- **`K₁` of a division ring.** For a possibly noncommutative division ring `D`, algebraic `K₁(D)`
is the abelianization `Dˣ ⧸ [Dˣ, Dˣ]` of its unit group: the class of the `1 × 1` matrix `(d)`
corresponds to the class of `d`. For a field `F` this is `K₁(F) = Fˣ`. The forward map is the
stable Dieudonné determinant. -/
def dieudonneDetEquiv : AlgebraicK1 D ≃* Group.Abelianization Dˣ where
  toFun := k1ToAb
  invFun := Group.Abelianization.lift (ofUnits D)
  left_inv x := by
    obtain ⟨u, rfl⟩ := ofUnits_surjective (hasStableRangeLE_one_of_isLocalRing D) x
    rw [k1ToAb_ofUnits, Group.Abelianization.lift_apply_of]
  right_inv y := by
    obtain ⟨u, rfl⟩ := Group.Abelianization.surjective_of (G := Dˣ) y
    rw [Group.Abelianization.lift_apply_of, k1ToAb_ofUnits]
  map_mul' := map_mul k1ToAb

/-- The isomorphism `K₁(D) ≃* Dˣᵃᵇ` sends the class of the `1 × 1` matrix `(d)` to the class
of `d`. -/
@[simp]
theorem dieudonneDetEquiv_ofUnits (u : Dˣ) :
    dieudonneDetEquiv D (ofUnits D u) = Group.Abelianization.of u :=
  k1ToAb_ofUnits u

/-- The inverse of `K₁(D) ≃* Dˣᵃᵇ` sends the class of `d` to the class of the `1 × 1`
matrix `(d)`. -/
@[simp]
theorem dieudonneDetEquiv_symm_of (u : Dˣ) :
    (dieudonneDetEquiv D).symm (Group.Abelianization.of u) = ofUnits D u :=
  (MulEquiv.symm_apply_eq _).2 (dieudonneDetEquiv_ofUnits u).symm

variable (D) in
/-- Over a division ring, the class `Dˣ →* K₁(D)` of `1 × 1` matrices factors as the
abelianization map `Dˣ →* Dˣᵃᵇ` followed by the inverse of `K₁(D) ≃* Dˣᵃᵇ`. -/
theorem dieudonneDetEquiv_symm_comp_of :
    ((dieudonneDetEquiv D).symm : _ →* AlgebraicK1 D).comp Group.Abelianization.of = ofUnits D :=
  MonoidHom.ext dieudonneDetEquiv_symm_of

variable (D) in
/-- Over a division ring, the kernel of the class `Dˣ →* K₁(D)` of `1 × 1` matrices is the
commutator subgroup `[Dˣ, Dˣ]`. -/
theorem ker_ofUnits : (ofUnits D).ker = commutator Dˣ := by
  rw [← dieudonneDetEquiv_symm_comp_of, MonoidHom.ker_mulEquiv_comp, Group.Abelianization.ker_of]

end AlgebraicK1

/-! ## The Dieudonné determinant in every size -/

variable (D) in
/-- The **Dieudonné determinant** `GLₙ(D) →* Dˣᵃᵇ` of a possibly noncommutative division ring
`D`, with values in the abelianization of its unit group. It is unchanged by elementary row and
column operations and sends `diag(d, 1, …, 1)` to the class of `d`; for `n ≥ 2` its kernel is
the elementary subgroup. It is the class in `K₁(D)` followed by
`AlgebraicK1.dieudonneDetEquiv`. -/
def dieudonneDet (n : ℕ) : GL (Fin n) D →* Group.Abelianization Dˣ :=
  (AlgebraicK1.dieudonneDetEquiv D : AlgebraicK1 D →* _).comp (AlgebraicK1.mk D n)

/-- The Dieudonné determinant of `g` is the image of its class in `K₁(D)` under
`K₁(D) ≃* Dˣᵃᵇ`. -/
theorem dieudonneDet_apply {n : ℕ} (g : GL (Fin n) D) :
    dieudonneDet D n g = AlgebraicK1.dieudonneDetEquiv D (AlgebraicK1.mk D n g) :=
  (rfl)

/-- The Dieudonné determinant is compatible with stabilization `g ↦ g ⊕ 1`. -/
@[simp]
theorem dieudonneDet_stabilizeGL {m n : ℕ} (h : m ≤ n) (g : GL (Fin m) D) :
    dieudonneDet D n (stabilizeGL D h g) = dieudonneDet D m g := by
  rw [dieudonneDet_apply, dieudonneDet_apply, AlgebraicK1.mk_stabilizeGL]

/-- The Dieudonné determinant of the `1 × 1` matrix `(d)` is the class of `d`. Together with
`dieudonneDet_stabilizeGL`, the determinant of `diag(d, 1, …, 1)` is the class of `d`. -/
@[simp]
theorem dieudonneDet_scalar_fin_one (u : Dˣ) :
    dieudonneDet D 1 (GeneralLinearGroup.scalar (Fin 1) u) = Group.Abelianization.of u := by
  rw [dieudonneDet_apply, ← AlgebraicK1.ofUnits_apply, AlgebraicK1.dieudonneDetEquiv_ofUnits]

/-- `diag(u, 1, …, 1)`, the stabilization of the `1 × 1` matrix `(u)`, is the diagonal matrix with
`u` in position `0`. -/
private theorem stabilizeGL_scalar_fin_one {n : ℕ} (hn : 1 ≤ n) (u : Dˣ) :
    stabilizeGL D hn (GeneralLinearGroup.scalar (Fin 1) u) = diagGL (Pi.mulSingle ⟨0, hn⟩ u) := by
  ext a b
  rw [coe_stabilizeGL_apply, diagGL_apply]
  by_cases ha : (a : ℕ) = 0 <;> by_cases hb : (b : ℕ) = 0 <;>
    simp [ha, hb, eq_comm (a := (0 : ℕ)), Matrix.one_apply, Pi.mulSingle_apply, Fin.ext_iff,
      Matrix.scalar_apply]

/-- **The Dieudonné determinant of `diag(1, …, u, …, 1)`.** The diagonal matrix with `u` in
position `i` and `1` elsewhere has Dieudonné determinant the class of `u`. -/
theorem dieudonneDet_diagGL_mulSingle {n : ℕ} (i : Fin n) (u : Dˣ) :
    dieudonneDet D n (diagGL (Pi.mulSingle i u)) = Group.Abelianization.of u := by
  have hn : 1 ≤ n := i.pos
  -- Conjugating by the permutation matrix of the transposition `(0 i)` moves `u` to position `0`,
  -- and conjugation does not change a value in the abelian group `Dˣᵃᵇ`.
  have hσ : diagGL (Pi.mulSingle i u) = permutationGL (Equiv.swap ⟨0, hn⟩ i) *
      diagGL (Pi.mulSingle ⟨0, hn⟩ u) * (permutationGL (Equiv.swap ⟨0, hn⟩ i))⁻¹ := by
    rw [permutationGL_mul_diagGL_mul_inv]
    congr 1
    funext a
    simp [Pi.mulSingle_apply, Equiv.swap_apply_eq_iff]
  rw [hσ, map_mul, map_mul, map_inv, mul_inv_cancel_comm, ← stabilizeGL_scalar_fin_one hn,
    dieudonneDet_stabilizeGL, dieudonneDet_scalar_fin_one]

/-- The Dieudonné determinant of an invertible diagonal matrix is the product of the classes of
its diagonal entries. -/
@[simp]
theorem dieudonneDet_diagGL {n : ℕ} (t : Fin n → Dˣ) :
    dieudonneDet D n (diagGL t) = ∏ i, Group.Abelianization.of (t i) := by
  have h : (dieudonneDet D n).comp diagGL =
      ∏ i, Group.Abelianization.of.comp (Pi.evalMonoidHom (fun _ : Fin n ↦ Dˣ) i) :=
    MonoidHom.pi_ext fun i u ↦ by
      simp [dieudonneDet_diagGL_mulSingle, Pi.mulSingle_apply, apply_ite]
  simpa using DFunLike.congr_fun h t

/-- The Dieudonné determinant kills elementary matrices. -/
@[simp]
theorem dieudonneDet_transvectionUnit {n : ℕ} {i j : Fin n} (hij : i ≠ j) (x : D) :
    dieudonneDet D n (transvectionUnit hij x) = 1 := by
  rw [dieudonneDet_apply, AlgebraicK1.elementarySubgroup_le_ker_mk n
    (transvectionUnit_mem_elementarySubgroup hij x), map_one]

/-- The Dieudonné determinant `GLₙ(D) →* Dˣᵃᵇ` is surjective for `n ≥ 1`. -/
theorem dieudonneDet_surjective {n : ℕ} (hn : 1 ≤ n) : Function.Surjective (dieudonneDet D n) :=
  (AlgebraicK1.dieudonneDetEquiv D).surjective.comp
    (AlgebraicK1.mk_surjective (hasStableRangeLE_one_of_isLocalRing D) hn)

/-- **Dieudonné.** For `n ≥ 2` the kernel of the Dieudonné determinant `GLₙ(D) →* Dˣᵃᵇ` is the
elementary subgroup `Eₙ(D)`. -/
theorem ker_dieudonneDet {n : ℕ} (hn : 2 ≤ n) :
    (dieudonneDet D n).ker = elementarySubgroup (Fin n) D := by
  rw [dieudonneDet, MonoidHom.ker_mulEquiv_comp,
    AlgebraicK1.ker_mk_eq_elementarySubgroup (hasStableRangeLE_one_of_isLocalRing D) hn]

/-- For `n ≥ 2`, an invertible matrix over a division ring has trivial Dieudonné determinant
exactly when it is a product of elementary matrices. -/
theorem dieudonneDet_eq_one_iff {n : ℕ} (hn : 2 ≤ n) {g : GL (Fin n) D} :
    dieudonneDet D n g = 1 ↔ g ∈ elementarySubgroup (Fin n) D := by
  rw [← MonoidHom.mem_ker, ker_dieudonneDet hn]

/-- Relabelling the indices by a permutation does not change the Dieudonné determinant. -/
@[simp]
theorem dieudonneDet_reindexGL {n : ℕ} (σ : Equiv.Perm (Fin n)) (g : GL (Fin n) D) :
    dieudonneDet D n (σ.reindexGL D g) = dieudonneDet D n g := by
  -- Relabelling is conjugation by a permutation matrix, invisible in the abelian group `Dˣᵃᵇ`.
  rw [← permutationGL_mul_mul_inv, map_mul, map_mul, map_inv, mul_inv_cancel_comm]

/-! ## The Dieudonné determinant over an arbitrary finite index type -/

section Fintype

variable {n : Type*} [Fintype n] [DecidableEq n]

variable (D n) in
/-- The **Dieudonné determinant** `GL n D →* Dˣᵃᵇ` over an arbitrary finite index type `n`: the
determinant `dieudonneDet` after relabelling the indices by `Fin (Fintype.card n)`. By
`dieudonneDetFintype_eq` the value does not depend on the relabelling. -/
def dieudonneDetFintype : GL n D →* Group.Abelianization Dˣ :=
  (dieudonneDet D (Fintype.card n)).comp ((Fintype.equivFin n).reindexGL D).toMonoidHom

/-- The Dieudonné determinant over `n` is `dieudonneDet` after relabelling the indices by any
equivalence `n ≃ Fin k`. -/
theorem dieudonneDetFintype_eq {k : ℕ} (e : n ≃ Fin k) (g : GL n D) :
    dieudonneDetFintype D n g = dieudonneDet D k (e.reindexGL D g) := by
  obtain rfl : Fintype.card n = k := by simpa using Fintype.card_congr e
  -- The two relabellings differ by a permutation of `Fin (Fintype.card n)`.
  have h : (Fintype.equivFin n).reindexGL D g =
      (e.symm.trans (Fintype.equivFin n)).reindexGL D (e.reindexGL D g) := by
    rw [← Equiv.reindexGL_trans_reindexGL, MulEquiv.trans_apply,
      Equiv.reindexGL_symm_apply_reindexGL]
  rw [dieudonneDetFintype, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, h,
    dieudonneDet_reindexGL]

/-- Over `Fin k`, the Dieudonné determinant `dieudonneDetFintype` is `dieudonneDet`. -/
@[simp]
theorem dieudonneDetFintype_fin {k : ℕ} (g : GL (Fin k) D) :
    dieudonneDetFintype D (Fin k) g = dieudonneDet D k g := by
  rw [dieudonneDetFintype_eq (Equiv.refl _), Equiv.reindexGL_refl, MulEquiv.refl_apply]

/-- The Dieudonné determinant of an invertible diagonal matrix indexed by `n` is the product of
the classes of its diagonal entries. -/
@[simp]
theorem dieudonneDetFintype_diagGL (t : n → Dˣ) :
    dieudonneDetFintype D n (diagGL t) = ∏ i, Group.Abelianization.of (t i) := by
  have h : (Fintype.equivFin n).reindexGL D (diagGL t) =
      diagGL (t ∘ (Fintype.equivFin n).symm) := by
    ext a b
    simp [Matrix.diagonal_apply, (Fintype.equivFin n).symm.injective.eq_iff]
  rw [dieudonneDetFintype_eq (Fintype.equivFin n), h, dieudonneDet_diagGL]
  exact (Fintype.equivFin n).symm.prod_comp fun i ↦ Group.Abelianization.of (t i)

/-- **The Dieudonné determinant of `diag(1, …, u, …, 1)` over `n`.** The diagonal matrix with `u`
in position `i` and `1` elsewhere has Dieudonné determinant the class of `u`. -/
theorem dieudonneDetFintype_diagGL_mulSingle (i : n) (u : Dˣ) :
    dieudonneDetFintype D n (diagGL (Pi.mulSingle i u)) = Group.Abelianization.of u := by
  simp [Pi.mulSingle_apply, apply_ite]

/-- The Dieudonné determinant `GL n D →* Dˣᵃᵇ` is surjective when `n` is nonempty. -/
theorem dieudonneDetFintype_surjective (hn : 1 ≤ Fintype.card n) :
    Function.Surjective (dieudonneDetFintype D n) :=
  (dieudonneDet_surjective hn).comp ((Fintype.equivFin n).reindexGL D).surjective

/-- **Dieudonné.** When `n` has at least two elements, the kernel of the Dieudonné determinant
`GL n D →* Dˣᵃᵇ` is the elementary subgroup. -/
theorem ker_dieudonneDetFintype (hn : 2 ≤ Fintype.card n) :
    (dieudonneDetFintype D n).ker = elementarySubgroup n D := by
  ext g
  rw [MonoidHom.mem_ker, dieudonneDetFintype_eq (Fintype.equivFin n), dieudonneDet_eq_one_iff hn,
    Equiv.reindexGL_mem_elementarySubgroup_iff]

end Fintype

private theorem dieudonneDet_fin_two (g : GL (Fin 2) D) :
    dieudonneDet D 2 g = det₂ (g : Matrix (Fin 2) (Fin 2) D) :=
  k1ToAb_mk g

/-- **The `2 × 2` Dieudonné determinant with nonzero pivot.** If the entry `a = g₀₀` of
`g = !![a, b; c, d]` is nonzero, the Dieudonné determinant of `g` is `[a] [d - c a⁻¹ b]`. -/
theorem dieudonneDet_fin_two_of_ne_zero (g : GL (Fin 2) D) (a s : Dˣ) (ha : (a : D) = g 0 0)
    (hs : (s : D) = g 1 1 - g 1 0 * (g 0 0)⁻¹ * g 0 1) :
    dieudonneDet D 2 g = Group.Abelianization.of a * Group.Abelianization.of s := by
  rw [dieudonneDet_fin_two, det₂_of_ne_zero (ha ▸ a.ne_zero), ← hs, ← ha, abClass_coe,
    abClass_coe]

/-- **The `2 × 2` Dieudonné determinant with zero pivot.** If the entry `g₀₀` of
`g = !![0, b; c, d]` vanishes, the Dieudonné determinant of `g` is `[-c] [b]`: exchanging the two
rows contributes the class of `-1`. -/
theorem dieudonneDet_fin_two_of_eq_zero (g : GL (Fin 2) D) (h : g 0 0 = 0) (b c : Dˣ)
    (hb : (b : D) = g 0 1) (hc : (c : D) = g 1 0) :
    dieudonneDet D 2 g = Group.Abelianization.of (-c) * Group.Abelianization.of b := by
  rw [dieudonneDet_fin_two, det₂_of_eq_zero h, ← hb, ← hc, ← Units.val_neg, abClass_coe,
    abClass_coe]

end TauCeti
