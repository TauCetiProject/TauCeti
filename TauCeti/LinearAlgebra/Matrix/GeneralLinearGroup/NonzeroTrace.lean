/-!
# Nonsolvable subgroups of `GL₂` are generated by elements of nonzero trace

Let `H` be a subgroup of `GL₂(K)` over a commutative ring `K`, and let `N` be the subgroup
generated by the elements of `H` with nonzero trace. Since the trace is invariant under conjugation,
`N` is normal. By the Cayley–Hamilton theorem a traceless `2 × 2` matrix `x` satisfies
`x² = -(det x) • 1`, so every element of `H` outside `N` squares to a scalar matrix. If `N ≠ H`, it
follows that `H` is solvable: either `N` together with the scalars of `H` is still proper, and then
`H` modulo its scalars has a proper normal subgroup outside which every element is an involution,
or the scalars supplement `N`, and then multiplying by a scalar outside `N` shows that `H` has no
element of nonzero trace at all, so that `H` consists of scalars. Hence a nonsolvable subgroup of
`GL₂(K)` is generated by its elements of nonzero trace. The argument needs neither that `K` is a
field, nor finiteness of `K`, nor its characteristic.

The application is the freeness of twisting on deformations of a rank-two representation with
nonsolvable residual image. Let `A` be a local ring, `ρ : G →* GL₂(A)` and `χ : G →* Aˣ`, and
suppose that the twist `g ↦ χ(g) • ρ(g)` is conjugate to `ρ`. Taking traces gives
`χ(g) * tr ρ(g) = tr ρ(g)`, so `χ(g) = 1` whenever the residual trace of `ρ(g)` is nonzero. These
elements generate `G` when the residual image is nonsolvable, so `χ = 1`. In the dyadic method of
Khare–Wintenberger this is the triviality of the stabilizers of the action of residually trivial
characters on strict deformation classes; the conjugating matrix need not be residually trivial
here.

## Main results

* `Matrix.GeneralLinearGroup.mul_self_mem_center_of_trace_eq_zero`: a traceless element of
  `GL₂(R)` squares to a scalar matrix.
* `Subgroup.closure_setOfPred_trace_ne_zero_eq_top`: a nonsolvable subgroup of `GL₂(K)` is generated
  by its elements of nonzero trace.
* `MonoidHom.closure_setOfPred_trace_ne_zero_eq_top`: the same for the preimage under a homomorphism
  `G →* GL₂(K)` with nonsolvable image.
* `MonoidHom.eq_one_of_forall_mul_trace_eq`: a character `χ` with `χ(g) * tr ρ(g) = tr ρ(g)` for
  all `g` is trivial when `ρ` has nonsolvable residual image.
* `MonoidHom.eq_one_of_forall_smul_eq_conj`: a character whose twist of `ρ` is conjugate to `ρ` is
  trivial when `ρ` has nonsolvable residual image.

## References

* C. Khare, J.-P. Wintenberger, *Serre's modularity conjecture (II)*, Invent. Math. 178 (2009),
  §5.2, Lemma 5.1.
-/

public section

open Matrix

namespace Matrix.GeneralLinearGroup

/-- A traceless element of `GL₂(R)` squares to a scalar matrix, by the Cayley–Hamilton theorem
`x² = (trace x) • x - (det x) • 1`. -/
theorem mul_self_mem_center_of_trace_eq_zero {R : Type*} [CommRing R] {x : GL (Fin 2) R}
    (hx : trace (x : Matrix (Fin 2) (Fin 2) R) = 0) :
    x * x ∈ Subgroup.center (GL (Fin 2) R) := by
  rw [mem_center_iff_val_mem_range_scalar]
  refine ⟨-Matrix.det (x : Matrix (Fin 2) (Fin 2) R), ?_⟩
  have hsq := sq_eq_trace_smul_sub_det_smul_one_fin_two (x : Matrix (Fin 2) (Fin 2) R)
  rw [hx, zero_smul, zero_sub, sq] at hsq
  simp [hsq, smul_one_eq_diagonal]

end Matrix.GeneralLinearGroup

variable {K : Type*} [CommRing K]

namespace Subgroup

/-- A nonsolvable subgroup of `GL₂(K)` is generated by its elements of nonzero trace. -/
theorem closure_setOfPred_trace_ne_zero_eq_top (H : Subgroup (GL (Fin 2) K))
    (hH : ¬ Group.IsSolvable H) :
    closure {x : H | trace ((x : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) ≠ 0} = ⊤ := by
  set N := closure {x : H | trace ((x : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) ≠ 0}
    with hNdef
  by_contra hN
  apply hH
  have htr (x : H) (hx : x ∉ N) : trace ((x : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) = 0 :=
    not_not.mp fun h ↦ hx (subset_closure h)
  have : N.Normal := closure_normal_of_forall_conj_mem fun g y hy ↦ by
    simpa [trace_conj (g : GL (Fin 2) K).isUnit] using hy
  -- `Z` is the subgroup of scalar matrices in `H`.
  set Z := (center (GL (Fin 2) K)).comap H.subtype
  have hZ (z : H) (hz : z ∈ Z) (y : H) : z * y = y * z :=
    Subtype.ext (mem_center_iff.mp hz y).symm
  have : Z.Normal := Normal.comap inferInstance _
  by_cases hNZ : Z ⊔ N = ⊤
  · -- The scalars supplement `N`: then no element of `H` has nonzero trace, so `H = Z`.
    obtain ⟨z, hzZ, hzN⟩ : ∃ z ∈ Z, z ∉ N := by
      by_contra! hle
      exact hN (by rwa [sup_eq_right.mpr hle] at hNZ)
    obtain ⟨u, hu⟩ : (z : GL (Fin 2) K) ∈ (GeneralLinearGroup.scalar (Fin 2)).range := by
      rw [← GeneralLinearGroup.center_eq_range_scalar]
      exact hzZ
    have hzero (x : H) : trace ((x : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) = 0 := by
      by_contra hx
      have hzx : z * x ∈ N := subset_closure <| by
        simpa [← hu, GeneralLinearGroup.coe_scalar, ← smul_eq_diagonal_mul, trace_smul] using hx
      exact hzN (by simpa using mul_mem hzx (inv_mem (subset_closure hx)))
    have hN0 : N = ⊥ := by
      rw [hNdef, eq_bot_iff, closure_le]
      exact fun x hx ↦ absurd (hzero x) hx
    rw [hN0, sup_bot_eq] at hNZ
    exact Group.isSolvable_of_comm fun a b ↦ hZ a (hNZ ▸ mem_top a) b
  · -- Modulo the scalars, every element outside the image of `N` is an involution.
    have hM : N.map (QuotientGroup.mk' Z) ≠ ⊤ := fun h ↦ hNZ (QuotientGroup.map_mk'_eq_top.mp h)
    have hQ : Group.IsSolvable (H ⧸ Z) :=
      Group.isSolvable_of_forall_notMem_mul_self_eq_one hM fun q hq ↦ by
        induction q using QuotientGroup.induction_on with
        | H x =>
          have hx : x ∉ N := fun hx ↦ hq (mem_map_of_mem _ hx)
          rw [← QuotientGroup.mk_mul, QuotientGroup.eq_one_iff]
          exact GeneralLinearGroup.mul_self_mem_center_of_trace_eq_zero (htr x hx)
    have : Group.IsSolvable Z := Group.isSolvable_of_comm fun a b ↦ Subtype.ext (hZ a a.property b)
    exact (Group.isSolvable_iff_subgroup_quotient Z).mpr ⟨‹_›, hQ⟩

end Subgroup

namespace MonoidHom

variable {G : Type*} [Group G]

/-- If `ρ : G →* GL₂(K)` has nonsolvable image, then `G` is generated by the elements whose image
under `ρ` has nonzero trace. -/
theorem closure_setOfPred_trace_ne_zero_eq_top (ρ : G →* GL (Fin 2) K)
    (hρ : ¬ Group.IsSolvable ρ.range) :
    Subgroup.closure {g | trace ((ρ g : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) ≠ 0} = ⊤ := by
  set S := {g | trace ((ρ g : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) ≠ 0}
  have himage : ρ.rangeRestrict '' S =
      {x : ρ.range | trace ((x : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) ≠ 0} :=
    Set.image_preimage_eq {x : ρ.range | trace ((x : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) ≠ 0}
      ρ.rangeRestrict_surjective
  have hmap : (Subgroup.closure S).map ρ.rangeRestrict = ⊤ := by
    rw [MonoidHom.map_closure, himage, ρ.range.closure_setOfPred_trace_ne_zero_eq_top hρ]
  obtain ⟨g₀, hg₀⟩ : S.Nonempty := by
    by_contra hS
    refine hρ (Group.isSolvable_of_top_eq_bot _ ?_)
    rw [← hmap, Set.not_nonempty_iff_eq_empty.mp hS, Subgroup.closure_empty, Subgroup.map_bot]
  have hker : ρ.ker ≤ Subgroup.closure S := fun k hk ↦ by
    have hkg₀ : k * g₀ ∈ S := by simpa [S, (mem_ker.mp hk)] using hg₀
    simpa using mul_mem (Subgroup.subset_closure hkg₀) (inv_mem (Subgroup.subset_closure hg₀))
  rw [eq_top_iff, ← Subgroup.comap_top ρ.rangeRestrict, ← hmap,
    Subgroup.comap_map_eq_self (by rwa [ker_rangeRestrict])]

variable {A : Type*} [CommRing A] [IsLocalRing A]

/-- Let `ρ : G →* GL₂(A)` be a representation over a local ring whose residual image is not
solvable. A character `χ : G →* Aˣ` with `χ(g) * tr ρ(g) = tr ρ(g)` for every `g` is trivial. -/
theorem eq_one_of_forall_mul_trace_eq (χ : G →* Aˣ) (ρ : G →* GL (Fin 2) A)
    (hρ : ¬ Group.IsSolvable
      ((Matrix.GeneralLinearGroup.map (IsLocalRing.residue A)).comp ρ).range)
    (h : ∀ g, (χ g : A) * trace ((ρ g : GL (Fin 2) A) : Matrix (Fin 2) (Fin 2) A) =
      trace ((ρ g : GL (Fin 2) A) : Matrix (Fin 2) (Fin 2) A)) :
    χ = 1 :=
  eq_of_eqOn_dense (closure_setOfPred_trace_ne_zero_eq_top _ hρ) fun g hg ↦ by
    have hunit : IsUnit (trace ((ρ g : GL (Fin 2) A) : Matrix (Fin 2) (Fin 2) A)) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
      simpa [trace_fin_two, Matrix.GeneralLinearGroup.map_apply] using hg
    exact Units.ext (hunit.mul_left_inj.mp (by simpa using h g))

/-- Let `ρ : G →* GL₂(A)` be a representation over a local ring whose residual image is not
solvable. A character `χ : G →* Aˣ` for which the twist `g ↦ χ(g) • ρ(g)` is conjugate to `ρ` is
trivial. In particular twisting by residually trivial characters acts freely on strict deformation
classes of `ρ`. -/
theorem eq_one_of_forall_smul_eq_conj (χ : G →* Aˣ) (ρ : G →* GL (Fin 2) A)
    (hρ : ¬ Group.IsSolvable
      ((Matrix.GeneralLinearGroup.map (IsLocalRing.residue A)).comp ρ).range)
    (U : GL (Fin 2) A)
    (h : ∀ g, (χ g : A) • ((ρ g : GL (Fin 2) A) : Matrix (Fin 2) (Fin 2) A) =
      ((U * ρ g * U⁻¹ : GL (Fin 2) A) : Matrix (Fin 2) (Fin 2) A)) :
    χ = 1 :=
  χ.eq_one_of_forall_mul_trace_eq ρ hρ fun g ↦ by
    rw [← smul_eq_mul, ← trace_smul, h g, Units.val_mul, Units.val_mul, trace_units_conj]

end MonoidHom
