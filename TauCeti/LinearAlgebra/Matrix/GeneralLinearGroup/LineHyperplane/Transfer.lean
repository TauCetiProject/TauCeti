module

public import Mathlib.GroupTheory.Transfer
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.LineHyperplane
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Diagonal.Basic
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Commutator

/-!
# The transfer of the eigenvalue on a coordinate line

Let `K` be a field and `P = lineStabilizer K i ⊆ GL n K` the stabilizer of the coordinate line
`K ∙ eᵢ`. An element `g ∈ P` acts on that line by the scalar `g i i`, and `g ↦ g i i` is a
character `P →* Kˣ`, `TauCeti.lineStabilizerChar`. Over a finite field its transfer to `GL n K`
is the determinant.

The proof compares two characters of `GL n K` with values in `Kˣ`. Both are trivial on `SL n K`:
it is generated by transvections, and a homomorphism from the additive group of `K`, of order
`q`, to `Kˣ`, of order `q - 1`, is trivial. So it suffices to compare them at the diagonal matrix
`diag(1, …, x, …, 1)` with `x` at place `i`. There the transfer is a product over the orbits of
this matrix on the lines of `Kⁿ`: the line `K ∙ eᵢ` is fixed and contributes `x`, and every other
orbit contributes `1`, because its lines contain a vector with a nonzero coordinate fixed by the
matrix.

This is the computation behind the use of a tame generator as a diamond operator at an auxiliary
place: the stabilizer of a line in `GL_n` of the residue field is the reduction of a parahoric
subgroup, and the transfer turns a logarithm of its first entry into a logarithm of the
determinant.

## Main definitions

* `TauCeti.lineStabilizerChar K i`: the character `g ↦ g i i` of the line stabilizer.

## Main results

* `TauCeti.transfer_lineStabilizerChar_diagGL`: the transfer at `diag(1, …, x, …, 1)` is `x`.
* `TauCeti.transfer_lineStabilizerChar`: over a finite field, the transfer of
  `lineStabilizerChar K i` to `GL n K` is the determinant.

## References

The statement and its proof are adapted from grh-lean
(https://github.com/lsernau/grh-lean, Apache 2.0, Copyright 2026 Anthropic PBC), file
`src/New/Congruences/FirstOrder/OnePrime.lean` (`New.Patching.firstEntry`,
`New.Patching.transfer_firstEntry_diagGL`, `New.Patching.transfer_firstEntry`), which treats the
first line of `GL_n` of a finite field. It is generalised here to any coordinate line of `GL n K`
for a finite index type `n`; the reduction to diagonal matrices goes through the generation of
`SL n K` by transvections instead of a conjugation by a permutation matrix.
For the transfer see J.-P. Serre, *Local Fields*, Chapter VII, §8.
-/

public section

open Matrix

namespace TauCeti

variable {K : Type*} [Field K] {n : Type*} [Fintype n] [DecidableEq n]

variable (K) in
/-- The character `g ↦ g i i` of the stabilizer of the coordinate line `K ∙ eᵢ`: the scalar by
which `g` acts on that line. -/
noncomputable def lineStabilizerChar (i : n) : lineStabilizer K i →* Kˣ :=
  MonoidHom.toHomUnits
    { toFun g := (g : GL n K) i i
      map_one' := by simp
      map_mul' g h := coe_mul_apply_of_mem_lineStabilizer (g : GL n K) h.property i }

@[simp]
theorem coe_lineStabilizerChar_apply {i : n} (g : lineStabilizer K i) :
    (lineStabilizerChar K i g : K) = (g : GL n K) i i :=
  (rfl)

/-- If `h⁻¹ d h` stabilizes the line `K ∙ eᵢ` for a diagonal matrix `d = diagGL t`, then column
`i` of `h` is an eigenvector of `d`, so the eigenvalue of `h⁻¹ d h` on the line is `t j` for every
`j` at which that column is nonzero. -/
theorem lineStabilizerChar_inv_mul_diagGL_mul {t : n → Kˣ} {h : GL n K} {i : n}
    (h_mem : h⁻¹ * diagGL t * h ∈ lineStabilizer K i) {j : n} (hj : h j i ≠ 0) :
    lineStabilizerChar K i ⟨h⁻¹ * diagGL t * h, h_mem⟩ = t j := by
  refine Units.ext (mul_left_cancel₀ hj ?_)
  calc h j i * lineStabilizerChar K i ⟨h⁻¹ * diagGL t * h, h_mem⟩
      = (h * (h⁻¹ * diagGL t * h)) j i :=
        (coe_mul_apply_of_mem_lineStabilizer h h_mem j).symm
    _ = (diagGL t * h) j i := by rw [mul_assoc, mul_inv_cancel_left]
    _ = h j i * t j := by simp [mul_comm]

variable [Finite K]

/-- **The transfer of the eigenvalue on a line at a diagonal matrix.** Over a finite field, the
transfer of `lineStabilizerChar K i` to `GL n K` takes the value `x` at the diagonal matrix with
`x` at place `i` and `1` elsewhere. -/
theorem transfer_lineStabilizerChar_diagGL (i : n) (x : Kˣ) :
    (lineStabilizerChar K i).transfer (diagGL (Pi.mulSingle i x)) = x := by
  -- The transfer is a product over the orbits of `g = diag(1, …, x, …, 1)` on `GL n K ⧸ H`. The
  -- orbit of `H` is the fixed point `H` and contributes `x`; every other coset `h H` has
  -- `h j i ≠ 0` for some `j ≠ i`, where `g` has the entry `1`.
  let H : Subgroup (GL n K) := lineStabilizer K i
  set g : GL n K := diagGL (Pi.mulSingle i x) with hg
  let Ω := Quotient (MulAction.orbitRel (Subgroup.zpowers g) (GL n K ⧸ H))
  have : Fintype Ω := Fintype.ofFinite Ω
  have g_pow (f : ℕ) : g ^ f = diagGL (Pi.mulSingle i (x ^ f)) := by
    rw [hg, ← map_pow, Pi.mulSingle_pow]
  have g_mem : g ∈ H := mem_lineStabilizer_iff.2 fun j hj ↦ by simp [g, hj]
  let η₀ : GL n K ⧸ H := ↑(1 : GL n K)
  have eq_iff (η : GL n K ⧸ H) : η₀ = η ↔ η.out ∈ H := by
    conv_lhs => rw [← η.out_eq', QuotientGroup.eq, inv_one, one_mul]
  have fixed (k : GL n K) (hk : k ∈ H) : k • η₀ = η₀ := by
    simpa [η₀, QuotientGroup.eq] using hk
  rw [MonoidHom.transfer_eq_prod_quotient_orbitRel_zpowers_quot,
    Fintype.prod_eq_single (⟦η₀⟧ : Ω)]
  · -- The orbit of `η₀` is the single point `η₀`.
    have out_eq : η₀ = (⟦η₀⟧ : Ω).out := by
      obtain ⟨k, hk⟩ := MulAction.mem_orbit_iff.1 <| MulAction.orbitRel_apply.1 <|
        Quotient.mk_out (s := MulAction.orbitRel (Subgroup.zpowers g) (GL n K ⧸ H)) η₀
      rw [← hk, Subgroup.smul_def, fixed k (Subgroup.zpowers_le.2 g_mem k.property)]
    have out_mem : (⟦η₀⟧ : Ω).out.out ∈ H := (eq_iff _).1 out_eq
    have entry_ne : (⟦η₀⟧ : Ω).out.out i i ≠ 0 := (lineStabilizerChar K i ⟨_, out_mem⟩).ne_zero
    have period : Function.minimalPeriod (g • ·) (⟦η₀⟧ : Ω).out = 1 :=
      Function.minimalPeriod_eq_one_iff_isFixedPt.2 (by rw [← out_eq]; exact fixed g g_mem)
    simp only [g_pow]
    rw [lineStabilizerChar_inv_mul_diagGL_mul _ entry_ne, period, pow_one, Pi.mulSingle_eq_same]
  · intro q hq
    have not_mem : q.out.out ∉ H := fun h ↦ hq (by rw [(eq_iff q.out).2 h, q.out_eq])
    obtain ⟨j, hj, entry_ne⟩ : ∃ j ≠ i, q.out.out j i ≠ 0 := by
      by_contra! h
      exact not_mem (mem_lineStabilizer_iff.2 h)
    simp only [g_pow]
    rw [lineStabilizerChar_inv_mul_diagGL_mul _ entry_ne, Pi.mulSingle_eq_of_ne hj]

/-- **The transfer of the eigenvalue on a line is the determinant.** Let `K` be a finite field, and
let `lineStabilizerChar K i` be the character `g ↦ g i i` of the stabilizer in `GL n K` of the
coordinate line `K ∙ eᵢ`, the scalar by which `g` acts on that line. Its transfer to `GL n K` is the
determinant. -/
theorem transfer_lineStabilizerChar (i : n) :
    (lineStabilizerChar K i).transfer = GeneralLinearGroup.det := by
  refine MonoidHom.ext fun g ↦ ?_
  -- Split off the diagonal matrix `d = diag(1, …, det g, …, 1)`; `g d⁻¹` lies in `SL n K`, where
  -- both characters are trivial.
  set d : GL n K := diagGL (Pi.mulSingle i (GeneralLinearGroup.det g))
  have det_d : GeneralLinearGroup.det d = GeneralLinearGroup.det g :=
    Units.ext (by simp [d, Pi.mulSingle_apply, Finset.prod_ite_eq'])
  obtain ⟨s, hs⟩ : g * d⁻¹ ∈ (SpecialLinearGroup.toGL : SpecialLinearGroup n K →* _).range := by
    rw [SpecialLinearGroup.range_toGL_eq_ker_det, MonoidHom.mem_ker, map_mul, map_inv, det_d,
      mul_inv_cancel]
  have split : g = SpecialLinearGroup.toGL s * d := by rw [hs, inv_mul_cancel_right]
  rw [split, map_mul, map_mul, SpecialLinearGroup.map_toGL_eq_one (lineStabilizerChar K i).transfer,
    SpecialLinearGroup.map_toGL_eq_one GeneralLinearGroup.det, one_mul, one_mul, det_d]
  exact transfer_lineStabilizerChar_diagGL (K := K) i _

end TauCeti
