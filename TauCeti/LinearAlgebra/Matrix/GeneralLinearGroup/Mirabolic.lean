import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Basic

/-!
# The mirabolic subgroup of `GL₂`

The mirabolic subgroup consists of the invertible matrices with bottom row `(0, 1)`.
We identify it with the existing affine group: the matrix `!![a, b; 0, 1]` corresponds
to the transformation `x ↦ b + a * x`. Its multiplication therefore records the
translation/scaling relations used in mirabolic actions on representations.

The Borel is generated by the mirabolic and scalar matrices, whose intersection is
trivial. Over a field, adjoining the Weyl element generates all of `GL₂`.
All constructions before the last theorem work over any commutative ring.

## References

Pierre Colmez, *Représentations de GL₂(ℚₚ) et (φ,Γ)-modules*, Introduction §4,
Remark 0.4(iv), for the mirabolic subgroup and its role in extending actions to `GL₂`.
-/

public section

namespace TauCeti

open _root_.Matrix

variable (R : Type*) [CommRing R]

/-- The mirabolic subgroup of `GL₂`: matrices with bottom row `(0, 1)`.
It is the kernel of the lower diagonal character inside the Borel, embedded in `GL₂`. -/
def GL2Mirabolic : Subgroup (GL (Fin 2) R) :=
  (((MonoidHom.snd Rˣ Rˣ).comp (GL2Borel.diag (R := R))).ker).map
    (GL2Borel R).subtype

namespace GL2Mirabolic

variable {R}

/-- Membership in the mirabolic subgroup is exactly the bottom-row condition. -/
@[simp]
theorem mem_iff {g : GL (Fin 2) R} :
    g ∈ GL2Mirabolic R ↔ g 1 0 = 0 ∧ g 1 1 = 1 := by
  constructor
  · rintro ⟨b, hb, rfl⟩
    refine ⟨GL2Borel.apply_one_zero b, ?_⟩
    have h := congrArg (fun u : Rˣ ↦ (u : R)) (MonoidHom.mem_ker.mp hb)
    simpa using h
  · rintro ⟨h₀, h₁⟩
    refine ⟨⟨g, GL2Borel.mem_iff.mpr h₀⟩, ?_, rfl⟩
    apply MonoidHom.mem_ker.mpr
    apply Units.ext
    simpa using h₁

/-- The mirabolic is a subgroup of the upper-triangular Borel. -/
theorem le_borel : GL2Mirabolic R ≤ GL2Borel R :=
  fun _ hg ↦ GL2Borel.mem_iff.mpr (mem_iff.mp hg).1

/-- The lower-left entry of a mirabolic matrix is zero. -/
@[simp]
theorem apply_one_zero (g : GL2Mirabolic R) : (g : GL (Fin 2) R) 1 0 = 0 :=
  (mem_iff.mp g.property).1

/-- The lower-right entry of a mirabolic matrix is one. -/
@[simp]
theorem apply_one_one (g : GL2Mirabolic R) : (g : GL (Fin 2) R) 1 1 = 1 :=
  (mem_iff.mp g.property).2

/-- The mirabolic matrix with scaling parameter `a` and translation parameter `b`. -/
def mk (a : Rˣ) (b : R) : GL2Mirabolic R :=
  ⟨GL2Borel.mk a 1 b, by simp⟩

/-- The matrix underlying a mirabolic element in coordinates. -/
@[simp]
theorem coe_mk (a : Rˣ) (b : R) :
    ((mk a b : GL2Mirabolic R) : GL (Fin 2) R) = GL2Borel.mk a 1 b :=
  (rfl)

/-- The determinant of a mirabolic matrix is its upper-left entry. -/
@[simp]
theorem det_eq_apply_zero_zero (g : GL2Mirabolic R) :
    (g : GL (Fin 2) R).val.det = (g : GL (Fin 2) R) 0 0 := by
  simp [Matrix.det_fin_two]

/-- Every mirabolic matrix has the prescribed determinant and translation coordinates. -/
@[simp]
theorem mk_det (g : GL2Mirabolic R) :
    mk (Matrix.GeneralLinearGroup.det (g : GL (Fin 2) R))
      ((g : GL (Fin 2) R) 0 1) = g := by
  apply Subtype.ext
  apply Matrix.GeneralLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.GeneralLinearGroup.val_det_apply, Matrix.det_fin_two]

/-- Equality of coordinate matrices is equality of both parameters. -/
@[simp]
theorem mk_inj {a c : Rˣ} {b d : R} : mk a b = mk c d ↔ a = c ∧ b = d := by
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · apply Units.ext
      simpa using congrArg (fun g : GL2Mirabolic R ↦ (g : GL (Fin 2) R) 0 0) h
    · simpa using congrArg (fun g : GL2Mirabolic R ↦ (g : GL (Fin 2) R) 0 1) h
  · rintro ⟨rfl, rfl⟩
    rfl

/-- Mirabolic multiplication is the affine multiplication law. -/
@[simp]
theorem mk_mul_mk (a c : Rˣ) (b d : R) :
    mk a b * mk c d = mk (a * c) (b + (a : R) * d) := by
  apply Subtype.ext
  apply Matrix.GeneralLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two, add_comm]

/-- The zero translation and unit scaling give the identity. -/
@[simp]
theorem mk_one_zero : mk (1 : Rˣ) 0 = 1 := by
  apply Subtype.ext
  apply Matrix.GeneralLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;> simp

/-- Inversion of an affine transformation in mirabolic coordinates. -/
@[simp]
theorem mk_inv (a : Rˣ) (b : R) : (mk a b)⁻¹ = mk a⁻¹ (-((a⁻¹ : Rˣ) : R) * b) := by
  apply inv_eq_of_mul_eq_one_right
  simp

/-- The affine group is the mirabolic subgroup, with the translation coordinate first. -/
def affineEquiv : AffineGroup R ≃* GL2Mirabolic R where
  toFun g := mk g.right g.left.toAdd
  invFun g := ⟨Multiplicative.ofAdd ((g : GL (Fin 2) R) 0 1),
    Matrix.GeneralLinearGroup.det (g : GL (Fin 2) R)⟩
  left_inv g := by
    apply SemidirectProduct.ext
    · apply Multiplicative.ext
      simp
    · apply Units.ext
      simp [Matrix.GeneralLinearGroup.val_det_apply, Matrix.det_fin_two]
  right_inv g := mk_det g
  map_mul' g h := by
    simp

/-- The affine-group identification sends `(b, a)` to `!![a, b; 0, 1]`. -/
@[simp]
theorem affineEquiv_apply (g : AffineGroup R) :
    affineEquiv g = mk g.right g.left.toAdd :=
  (rfl)

/-- The inverse identification recovers the scaling parameter. -/
@[simp]
theorem affineEquiv_symm_right (g : GL2Mirabolic R) :
    ((affineEquiv (R := R)).symm g).right =
      Matrix.GeneralLinearGroup.det (g : GL (Fin 2) R) :=
  (rfl)

/-- The inverse identification recovers the translation parameter. -/
@[simp]
theorem affineEquiv_symm_left (g : GL2Mirabolic R) :
    ((affineEquiv (R := R)).symm g).left.toAdd = (g : GL (Fin 2) R) 0 1 :=
  (rfl)

/-- The mirabolic intersects the centre trivially. -/
theorem inf_center_eq_bot :
    GL2Mirabolic R ⊓ Subgroup.center (GL (Fin 2) R) = ⊥ := by
  rw [Matrix.GeneralLinearGroup.center_eq_range_scalar]
  apply le_antisymm _ bot_le
  rintro g ⟨hg, a, rfl⟩
  have ha : a = 1 := by simpa [Matrix.scalar_apply] using hg
  simp [ha]

/-- An upper-triangular matrix factors as a mirabolic matrix times a scalar matrix. -/
theorem exists_mul_scalar_eq {g : GL (Fin 2) R} (hg : g ∈ GL2Borel R) :
    ∃ (m : GL2Mirabolic R) (d : Rˣ),
      (m : GL (Fin 2) R) * Matrix.GeneralLinearGroup.scalar (Fin 2) d = g := by
  obtain ⟨a, d, b, rfl⟩ := GL2Borel.mem_iff_exists_mk.mp hg
  refine ⟨mk (a * d⁻¹) (b * (d⁻¹ : Rˣ)), d, ?_⟩
  apply Matrix.GeneralLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.GeneralLinearGroup.coe_scalar, Matrix.scalar_apply,
      Matrix.mul_apply, Fin.sum_univ_two, mul_assoc]

/-- The mirabolic and centre together generate precisely the Borel. -/
theorem sup_center_eq_borel :
    GL2Mirabolic R ⊔ Subgroup.center (GL (Fin 2) R) = GL2Borel R := by
  apply le_antisymm
  · refine sup_le le_borel ?_
    rw [Matrix.GeneralLinearGroup.center_eq_range_scalar]
    rintro g ⟨a, rfl⟩
    exact GL2Borel.scalar_mem R a
  · intro g hg
    obtain ⟨m, d, rfl⟩ := exists_mul_scalar_eq hg
    apply Subgroup.mul_mem
    · exact Subgroup.mem_sup_left m.property
    · apply Subgroup.mem_sup_right
      rw [Matrix.GeneralLinearGroup.center_eq_range_scalar]
      exact ⟨d, rfl⟩

/-- Over a field, the mirabolic, centre and Weyl element generate `GL₂`.
Consequently a `GL₂` action is determined by its mirabolic, scalar and Weyl actions. -/
theorem closure_insert_union_center_eq_top (F : Type*) [Field F] :
    Subgroup.closure (insert (GL2WeylElement F)
      ((GL2Mirabolic F : Set (GL (Fin 2) F)) ∪
        (Subgroup.center (GL (Fin 2) F) : Set (GL (Fin 2) F)))) = ⊤ := by
  simp only [← Set.singleton_union, Subgroup.closure_union, Subgroup.closure_eq,
    sup_center_eq_borel]
  simpa only [← Set.singleton_union, Subgroup.closure_union, Subgroup.closure_eq] using
    GL2Borel.closure_insert_gl2WeylElement_eq_top (F := F)

end GL2Mirabolic

end TauCeti
