import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Basic

/-!
# The mirabolic subgroup of `GL₂`

The **mirabolic subgroup** `P` of `GL₂(R)` consists of the invertible matrices whose lower row is
`(0, 1)`, that is the matrices `!![a, b; 0, 1]` with `a` a unit. It is the affine group of the
line: `!![a, b; 0, 1]` acts on `R` by `x ↦ a x + b`, and `P` is the semidirect product
`R ⋊ Rˣ` of the translations by the scalings, that is the affine group `TauCeti.AffineGroup R`
(`TauCeti.GL2Mirabolic.semidirectProductEquiv`).

Over a field the mirabolic subgroup, the centre `Z` and the Weyl element `w = !![0, 1; 1, 0]`
generate `GL₂` (`TauCeti.GL2Mirabolic.closure_insert_gl2WeylElement_union_center_eq_top`). Thus an
action of `GL₂` is determined by its restriction to `P`, its central character and the action of
`w`. This is how Colmez builds representations of `GL₂(ℚ_p)` from `(φ, Γ)`-modules: an étale
`(φ, Γ)`-module carries an action of a submonoid of `P(ℚ_p)`, and the representation is completed
by adding a central character and an involution `w`.

Everything except the generation statement holds over an arbitrary commutative ring. The proof of
generation combines the Bruhat decomposition `GL₂ = B ∪ B w B` with the factorisation `B = P Z`
(`TauCeti.GL2Mirabolic.sup_center_eq_gl2Borel`): every upper-triangular matrix is a scalar times a
mirabolic one, and the scalar is unique because `P ∩ Z = 1`
(`TauCeti.GL2Mirabolic.inf_center_eq_bot`).

## Main definitions

* `TauCeti.GL2Mirabolic R`: the subgroup of `GL (Fin 2) R` of matrices with lower row `(0, 1)`.
* `TauCeti.GL2Mirabolic.semidirectProductEquiv`: the isomorphism `TauCeti.AffineGroup R ≃* P`
  from the affine group `R ⋊ Rˣ`, sending `(b, a)` to `!![a, b; 0, 1]`.

## Main results

* `TauCeti.GL2Mirabolic.mem_iff_exists_mk`: the elements of `P` are the matrices `!![a, b; 0, 1]`.
* `TauCeti.GL2Mirabolic.inf_center_eq_bot`: `P ∩ Z = 1`.
* `TauCeti.GL2Mirabolic.sup_center_eq_gl2Borel`: the Borel subgroup is generated by `P` and `Z`.
* `TauCeti.GL2Mirabolic.closure_insert_gl2WeylElement_union_center_eq_top`: over a field, `GL₂` is
  generated by `P`, `Z` and `w`.

## References

* P. Colmez, *Représentations de `GL₂(ℚ_p)` et `(φ, Γ)`-modules*, Astérisque 330 (2010),
  Introduction §4 and §III.1.
* V. Paškūnas, *The image of Colmez's Montreal functor*, Publ. Math. IHÉS 118 (2013), §1.
-/

public section

namespace TauCeti

open Matrix

universe u

section CommRing

variable (R : Type u) [CommRing R]

/-- The **mirabolic subgroup** of `GL₂`: the invertible matrices whose lower row is `(0, 1)`. -/
def GL2Mirabolic : Subgroup (GL (Fin 2) R) where
  carrier := {g | (g : Matrix (Fin 2) (Fin 2) R) 1 0 = 0 ∧ (g : Matrix (Fin 2) (Fin 2) R) 1 1 = 1}
  one_mem' := by simp
  mul_mem' := by
    rintro g h ⟨hg₀, hg₁⟩ ⟨hh₀, hh₁⟩
    simp [Matrix.mul_apply, Fin.sum_univ_two, hg₀, hg₁, hh₀, hh₁]
  inv_mem' := by
    rintro g ⟨h₀, h₁⟩
    -- The lower row of `g * g⁻¹ = 1` is the lower row of `g⁻¹`, since that of `g` is `(0, 1)`.
    have h := congrArg (fun M : GL (Fin 2) R => (M : Matrix (Fin 2) (Fin 2) R)) (mul_inv_cancel g)
    have e₀ := congrFun (congrFun h 1) 0
    have e₁ := congrFun (congrFun h 1) 1
    simp only [Units.val_mul, Units.val_one, Matrix.mul_apply, Fin.sum_univ_two, h₀, h₁,
      zero_mul, one_mul, zero_add] at e₀ e₁
    exact ⟨by simpa using e₀, by simpa using e₁⟩

namespace GL2Mirabolic

variable {R}

theorem mem_iff {g : GL (Fin 2) R} :
    g ∈ GL2Mirabolic R ↔
      (g : Matrix (Fin 2) (Fin 2) R) 1 0 = 0 ∧ (g : Matrix (Fin 2) (Fin 2) R) 1 1 = 1 :=
  Iff.rfl

/-- The mirabolic subgroup lies in the Borel subgroup. -/
theorem le_gl2Borel : GL2Mirabolic R ≤ GL2Borel R :=
  fun _ hg => GL2Borel.mem_iff.mpr hg.1

@[simp]
theorem mk_mem (a : Rˣ) (b : R) : GL2Borel.mk a 1 b ∈ GL2Mirabolic R := by
  simp [mem_iff]

/-- **Normal form**: the elements of the mirabolic subgroup are exactly the matrices
`!![a, b; 0, 1]` with `a` a unit. -/
theorem mem_iff_exists_mk {g : GL (Fin 2) R} :
    g ∈ GL2Mirabolic R ↔ ∃ (a : Rˣ) (b : R), g = GL2Borel.mk a 1 b := by
  refine ⟨fun hg => ?_, ?_⟩
  · obtain ⟨a, d, b, rfl⟩ := GL2Borel.mem_iff_exists_mk.mp (le_gl2Borel hg)
    obtain rfl : d = 1 := Units.ext (by simpa [mem_iff] using hg)
    exact ⟨a, b, rfl⟩
  · rintro ⟨a, b, rfl⟩
    exact mk_mem a b

/-- The determinant of a mirabolic matrix `!![a, b; 0, 1]` is its upper-left entry `a`. -/
theorem det_eq {g : GL (Fin 2) R} (hg : g ∈ GL2Mirabolic R) :
    (g : Matrix (Fin 2) (Fin 2) R).det = (g : Matrix (Fin 2) (Fin 2) R) 0 0 := by
  simp [Matrix.det_fin_two, hg.1, hg.2]

variable (R) in
/-- The upper unipotent matrices `!![1, b; 0, 1]` lie in the mirabolic subgroup. -/
theorem upperRightHom_mem (b : R) :
    Matrix.GeneralLinearGroup.upperRightHom b ∈ GL2Mirabolic R := by
  simp [mem_iff, Matrix.GeneralLinearGroup.upperRightHom]

/-- A scalar matrix is mirabolic only when it is the identity. -/
@[simp]
theorem scalar_mem_iff {a : Rˣ} :
    Matrix.GeneralLinearGroup.scalar (Fin 2) a ∈ GL2Mirabolic R ↔ a = 1 := by
  refine ⟨fun h => Units.ext ?_, ?_⟩
  · simpa [Matrix.scalar_apply] using h.2
  · rintro rfl
    rw [map_one]
    exact Subgroup.one_mem _

variable (R)

/-- **`P ∩ Z = 1`**: the only central element of the mirabolic subgroup is the identity. -/
theorem inf_center_eq_bot : GL2Mirabolic R ⊓ Subgroup.center (GL (Fin 2) R) = ⊥ := by
  refine eq_bot_iff.mpr fun g ⟨hP, hZ⟩ => ?_
  rw [Matrix.GeneralLinearGroup.center_eq_range_scalar] at hZ
  obtain ⟨a, rfl⟩ := hZ
  rw [scalar_mem_iff.mp hP, map_one]
  exact Subgroup.one_mem _

/-- **`B = P Z`**: the Borel subgroup is generated by the mirabolic subgroup and the centre, since
`!![a, b; 0, d] = !![a d⁻¹, b d⁻¹; 0, 1] * d`. -/
theorem sup_center_eq_gl2Borel :
    GL2Mirabolic R ⊔ Subgroup.center (GL (Fin 2) R) = GL2Borel R := by
  refine le_antisymm (sup_le le_gl2Borel fun g hg => ?_) fun g hg => ?_
  · rw [Matrix.GeneralLinearGroup.center_eq_range_scalar] at hg
    obtain ⟨a, rfl⟩ := hg
    exact GL2Borel.scalar_mem R a
  · obtain ⟨a, d, b, rfl⟩ := GL2Borel.mem_iff_exists_mk.mp hg
    have h : GL2Borel.mk a d b =
        GL2Borel.mk (a * d⁻¹) 1 (b * (d⁻¹ : Rˣ)) * Matrix.GeneralLinearGroup.scalar (Fin 2) d := by
      refine Matrix.GeneralLinearGroup.ext fun i j => ?_
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two, mul_assoc]
    rw [h]
    refine Subgroup.mul_mem_sup (mk_mem _ _) ?_
    rw [Matrix.GeneralLinearGroup.center_eq_range_scalar]
    exact ⟨d, rfl⟩

variable {R}

/-- **The mirabolic subgroup is the affine group `R ⋊ Rˣ`**: the pair `(b, a)` of a translation and
a scaling corresponds to the matrix `!![a, b; 0, 1]`. -/
def semidirectProductEquiv : AffineGroup R ≃* GL2Mirabolic R where
  toFun x := ⟨GL2Borel.mk x.right 1 x.left.toAdd, mk_mem _ _⟩
  invFun g := ⟨Multiplicative.ofAdd (((g : GL (Fin 2) R) : Matrix (Fin 2) (Fin 2) R) 0 1),
    (GL2Borel.diag ⟨g, le_gl2Borel g.property⟩).1⟩
  left_inv x := by
    refine SemidirectProduct.ext ?_ ?_
    · simp
    · exact congrArg Prod.fst (GL2Borel.diag_mk x.right 1 x.left.toAdd)
  right_inv g := by
    obtain ⟨g, hg⟩ := g
    obtain ⟨a, b, rfl⟩ := mem_iff_exists_mk.mp hg
    refine Subtype.ext ?_
    simp
  map_mul' x y := by
    refine Subtype.ext ?_
    simp [add_comm]

@[simp]
theorem coe_semidirectProductEquiv_apply (x : AffineGroup R) :
    ((semidirectProductEquiv x : GL2Mirabolic R) : GL (Fin 2) R) =
      GL2Borel.mk x.right 1 x.left.toAdd :=
  (rfl)

@[simp]
theorem semidirectProductEquiv_symm_apply_left (g : GL2Mirabolic R) :
    (semidirectProductEquiv.symm g).left =
      Multiplicative.ofAdd (((g : GL (Fin 2) R) : Matrix (Fin 2) (Fin 2) R) 0 1) :=
  (rfl)

@[simp]
theorem val_semidirectProductEquiv_symm_apply_right (g : GL2Mirabolic R) :
    (((semidirectProductEquiv.symm g).right : Rˣ) : R) =
      ((g : GL (Fin 2) R) : Matrix (Fin 2) (Fin 2) R) 0 0 :=
  GL2Borel.diag_fst_val _

end GL2Mirabolic

end CommRing

section Field

variable (F : Type u) [Field F]

namespace GL2Mirabolic

/-- **`GL₂` is generated by `P`, `Z` and `w`**: over a field, the mirabolic subgroup, the centre and
the Weyl element generate `GL₂`. Hence an action of `GL₂` is determined by its restriction to the
mirabolic subgroup and the centre, together with the action of `w`. -/
theorem closure_insert_gl2WeylElement_union_center_eq_top :
    Subgroup.closure (insert (GL2WeylElement F)
      ((GL2Mirabolic F : Set (GL (Fin 2) F)) ∪ Subgroup.center (GL (Fin 2) F))) = ⊤ := by
  set S := insert (GL2WeylElement F)
    ((GL2Mirabolic F : Set (GL (Fin 2) F)) ∪ Subgroup.center (GL (Fin 2) F))
  have hB : GL2Borel F ≤ Subgroup.closure S := by
    rw [← sup_center_eq_gl2Borel, sup_le_iff]
    exact ⟨fun g hg => Subgroup.subset_closure (Or.inr (Or.inl hg)),
      fun g hg => Subgroup.subset_closure (Or.inr (Or.inr hg))⟩
  rw [eq_top_iff, ← GL2Borel.closure_insert_gl2WeylElement_eq_top F, Subgroup.closure_le]
  rintro g (rfl | hg)
  · exact Subgroup.subset_closure (Set.mem_insert _ _)
  · exact hB hg

end GL2Mirabolic

end Field

end TauCeti
