module

public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Transvection

/-!
# Elementary matrices over a ring and Whitehead's lemma

For a possibly noncommutative ring `A` and distinct indices `i ≠ j`, the elementary matrix
`eᵢⱼ(a) = 1 + a Eᵢⱼ` is the transvection `TauCeti.transvectionUnit`, invertible with inverse
`eᵢⱼ(-a)`. The subgroup `E n A` of `GL n A` generated by these matrices is the elementary
subgroup. Algebraic `K₁` is the quotient `GL_∞(A) / E_∞(A)` of the stable general linear group by
the stable elementary subgroup, and this file supplies the finite-size facts which make that
quotient a well-defined abelian group:

* `E n A` is perfect as soon as `n` has at least three elements: each generator is the commutator
  `⁅eᵢₗ(a), eₗⱼ(1)⁆` for an index `l` distinct from `i` and `j`. Hence `E n A` lies in the
  commutator subgroup of `GL n A`.
* **Whitehead's lemma.** For `u` invertible of size `m`, the block diagonal matrix `u ⊕ u⁻¹` is
  elementary of size `m ⊕ m`. Consequently, for a commutator `⁅u, v⁆` of `GL m A`, the
  stabilization `⁅u, v⁆ ⊕ 1` is elementary, and for `e ∈ E m A` and `g ∈ GL m A` the
  stabilization of the conjugate `g e g⁻¹` is elementary.

Thus, after stabilization, the elementary subgroup is normalized by every invertible matrix and
agrees with the commutator subgroup;
these are the relations through which homomorphisms on invertible matrices, such as Connes' odd
pairing with cyclic cohomology, descend to `K₁`.

## Main definitions

* `TauCeti.elementarySubgroup`: the subgroup of `GL n A` generated by elementary matrices.
* `TauCeti.fromBlocksGL`: the block diagonal homomorphism `GL m A × GL k A →* GL (m ⊕ k) A`.
* `Matrix.upperBlockGL`, `Matrix.lowerBlockGL`: the block unipotent matrices
  `fromBlocks 1 X 0 1` and `fromBlocks 1 0 Y 1`.

## Main results

* `TauCeti.commutator_elementarySubgroup_self`: `⁅E n A, E n A⁆ = E n A` when `3 ≤ card n`.
* `TauCeti.elementarySubgroup_le_commutator`: `E n A ≤ ⁅GL n A, GL n A⁆` when `3 ≤ card n`.
* `Matrix.upperBlockGL_mem_elementarySubgroup`, `Matrix.lowerBlockGL_mem_elementarySubgroup`:
  block unipotent matrices are elementary.
* `TauCeti.fromBlocksGL_inv_mem_elementarySubgroup`: Whitehead's lemma, `u ⊕ u⁻¹ ∈ E`.
* `TauCeti.map_commutator_le_elementarySubgroup`: the stabilized commutator subgroup is elementary.
* `TauCeti.fromBlocksGL_conj_mem_elementarySubgroup`: the stabilization of a conjugate of an
  elementary matrix is elementary.

## References

* J. Milnor, *Introduction to Algebraic K-Theory*, Annals of Mathematics Studies 72 (1971),
  §3, Lemma 3.1 (Whitehead) and Proposition 3.2.
* J. Rosenberg, *Algebraic K-Theory and Its Applications*, GTM 147 (1994), §2.1.
-/

public section

open Matrix

open scoped commutatorElement

namespace TauCeti

variable {n : Type*} [DecidableEq n] [Fintype n] {A : Type*} [Ring A] {i j l : n}

/-! ## The elementary subgroup -/

variable (n A) in
/-- The **elementary subgroup** of `GL n A`: the subgroup generated by the elementary matrices
`1 + a Eᵢⱼ` with `i ≠ j`. -/
def elementarySubgroup : Subgroup (GL n A) :=
  Subgroup.closure {g | ∃ (i j : n) (hij : i ≠ j) (a : A), transvectionUnit hij a = g}

variable (n A) in
/-- The elementary subgroup is the subgroup generated by the elementary matrices. -/
theorem elementarySubgroup_def :
    elementarySubgroup n A =
      Subgroup.closure {g | ∃ (i j : n) (hij : i ≠ j) (a : A), transvectionUnit hij a = g} :=
  (rfl)

/-- Elementary matrices lie in the elementary subgroup. -/
theorem transvectionUnit_mem_elementarySubgroup (hij : i ≠ j) (a : A) :
    transvectionUnit hij a ∈ elementarySubgroup n A :=
  Subgroup.subset_closure ⟨i, j, hij, a, rfl⟩

/-- The elementary subgroup is contained in a subgroup exactly when every elementary matrix is. -/
theorem elementarySubgroup_le_iff {H : Subgroup (GL n A)} :
    elementarySubgroup n A ≤ H ↔ ∀ (i j : n) (hij : i ≠ j) (a : A), transvectionUnit hij a ∈ H := by
  rw [elementarySubgroup_def, Subgroup.closure_le]
  constructor
  · exact fun h i j hij a ↦ h ⟨i, j, hij, a, rfl⟩
  · rintro h _ ⟨i, j, hij, a, rfl⟩
    exact h i j hij a

/-- **The elementary subgroup is perfect** in size at least three: each elementary matrix
`eᵢⱼ(a)` is the commutator `⁅eᵢₗ(a), eₗⱼ(1)⁆` for an index `l` distinct from `i` and `j`. -/
theorem commutator_elementarySubgroup_self (hn : 3 ≤ Fintype.card n) :
    ⁅elementarySubgroup n A, elementarySubgroup n A⁆ = elementarySubgroup n A := by
  refine le_antisymm (Subgroup.commutator_le.2 fun g hg h hh ↦ ?_) ?_
  · rw [commutatorElement_def]
    exact mul_mem (mul_mem (mul_mem hg hh) (inv_mem hg)) (inv_mem hh)
  refine elementarySubgroup_le_iff.2 fun i j hij a ↦ ?_
  -- A third index `l`, distinct from `i` and `j`.
  obtain ⟨l, -, hl⟩ := Finset.exists_mem_notMem_of_card_lt_card (s := {i, j})
    (t := Finset.univ) (Finset.card_le_two.trans_lt (by rw [Finset.card_univ]; omega))
  obtain ⟨hli, hlj⟩ : l ≠ i ∧ l ≠ j := by simpa [not_or] using hl
  rw [← mul_one a, ← commutatorElement_transvectionUnit hli.symm hlj hij]
  exact Subgroup.commutator_mem_commutator (transvectionUnit_mem_elementarySubgroup _ _)
    (transvectionUnit_mem_elementarySubgroup _ _)

/-- In size at least three, the elementary subgroup lies in the commutator subgroup of
`GL n A`. -/
theorem elementarySubgroup_le_commutator (hn : 3 ≤ Fintype.card n) :
    elementarySubgroup n A ≤ commutator (GL n A) := by
  rw [← commutator_elementarySubgroup_self hn]
  exact Subgroup.commutator_mono le_top le_top

/-! ## Block matrices -/

variable {m k : Type*} [DecidableEq m] [Fintype m] [DecidableEq k] [Fintype k]

/-- The **block diagonal homomorphism** `(u, v) ↦ u ⊕ v` from `GL m A × GL k A` to
`GL (m ⊕ k) A`. -/
def fromBlocksGL : GL m A × GL k A →* GL (m ⊕ k) A where
  toFun u :=
    { val := fromBlocks u.1 0 0 u.2
      inv := fromBlocks ↑u.1⁻¹ 0 0 ↑u.2⁻¹
      val_inv := by simp [fromBlocks_multiply]
      inv_val := by simp [fromBlocks_multiply] }
  map_one' := Units.ext (by simp)
  map_mul' u v := Units.ext (by simp [fromBlocks_multiply])

/-- The matrix underlying a block diagonal invertible matrix. -/
@[simp]
theorem coe_fromBlocksGL (u : GL m A × GL k A) :
    (fromBlocksGL u : Matrix (m ⊕ k) (m ⊕ k) A) = fromBlocks u.1 0 0 u.2 :=
  (rfl)

end TauCeti

namespace Matrix

open TauCeti

variable {A : Type*} [Ring A] {m k : Type*} [DecidableEq m] [Fintype m] [DecidableEq k]
  [Fintype k]

/-- The block unipotent matrix `fromBlocks 1 X 0 1`, with inverse `fromBlocks 1 (-X) 0 1`. -/
def upperBlockGL (X : Matrix m k A) : GL (m ⊕ k) A where
  val := fromBlocks 1 X 0 1
  inv := fromBlocks 1 (-X) 0 1
  val_inv := by simp [fromBlocks_multiply]
  inv_val := by simp [fromBlocks_multiply]

/-- The block unipotent matrix `fromBlocks 1 0 Y 1`, with inverse `fromBlocks 1 0 (-Y) 1`. -/
def lowerBlockGL (Y : Matrix k m A) : GL (m ⊕ k) A where
  val := fromBlocks 1 0 Y 1
  inv := fromBlocks 1 0 (-Y) 1
  val_inv := by simp [fromBlocks_multiply]
  inv_val := by simp [fromBlocks_multiply]

/-- The matrix underlying an upper block unipotent matrix. -/
@[simp]
theorem coe_upperBlockGL (X : Matrix m k A) :
    (upperBlockGL X : Matrix (m ⊕ k) (m ⊕ k) A) = fromBlocks 1 X 0 1 :=
  (rfl)

/-- The matrix underlying a lower block unipotent matrix. -/
@[simp]
theorem coe_lowerBlockGL (Y : Matrix k m A) :
    (lowerBlockGL Y : Matrix (m ⊕ k) (m ⊕ k) A) = fromBlocks 1 0 Y 1 :=
  (rfl)

/-- The upper block unipotent matrix of the zero block is the identity. -/
@[simp]
theorem upperBlockGL_zero : upperBlockGL (0 : Matrix m k A) = 1 :=
  Units.ext (by simp)

/-- The lower block unipotent matrix of the zero block is the identity. -/
@[simp]
theorem lowerBlockGL_zero : lowerBlockGL (0 : Matrix k m A) = 1 :=
  Units.ext (by simp)

/-- Upper block unipotent matrices multiply by adding their blocks. -/
@[simp]
theorem upperBlockGL_add (X Y : Matrix m k A) :
    upperBlockGL (X + Y) = upperBlockGL X * upperBlockGL Y :=
  Units.ext (by simp [fromBlocks_multiply, add_comm])

/-- Lower block unipotent matrices multiply by adding their blocks. -/
@[simp]
theorem lowerBlockGL_add (X Y : Matrix k m A) :
    lowerBlockGL (X + Y) = lowerBlockGL X * lowerBlockGL Y :=
  Units.ext (by simp [fromBlocks_multiply])

/-- The inverse of an upper block unipotent matrix negates its block. -/
@[simp]
theorem upperBlockGL_inv (X : Matrix m k A) : (upperBlockGL X)⁻¹ = upperBlockGL (-X) :=
  Units.ext (rfl)

/-- The inverse of a lower block unipotent matrix negates its block. -/
@[simp]
theorem lowerBlockGL_inv (Y : Matrix k m A) : (lowerBlockGL Y)⁻¹ = lowerBlockGL (-Y) :=
  Units.ext (rfl)

/-- Upper block unipotent matrices are elementary: they are products of the commuting elementary
matrices `1 + X a b E_(inl a, inr b)`. -/
theorem upperBlockGL_mem_elementarySubgroup (X : Matrix m k A) :
    upperBlockGL X ∈ elementarySubgroup (m ⊕ k) A := by
  induction X using Matrix.induction_on' with
  | h_zero => simp
  | h_add X Y hX hY => simpa only [upperBlockGL_add] using mul_mem hX hY
  | h_std_basis a b c =>
    convert transvectionUnit_mem_elementarySubgroup (Sum.inl_ne_inr (a := a) (b := b)) c
    ext (p | p) (q | q) <;>
      simp [coe_transvectionUnit_eq_one_add_single, single_apply, one_apply]

/-- Lower block unipotent matrices are elementary: they are products of the commuting elementary
matrices `1 + Y b a E_(inr b, inl a)`. -/
theorem lowerBlockGL_mem_elementarySubgroup (Y : Matrix k m A) :
    lowerBlockGL Y ∈ elementarySubgroup (m ⊕ k) A := by
  induction Y using Matrix.induction_on' with
  | h_zero => simp
  | h_add X Y hX hY => simpa only [lowerBlockGL_add] using mul_mem hX hY
  | h_std_basis b a c =>
    convert transvectionUnit_mem_elementarySubgroup (Sum.inr_ne_inl (a := a) (b := b)) c
    ext (p | p) (q | q) <;>
      simp [coe_transvectionUnit_eq_one_add_single, single_apply, one_apply]

end Matrix

namespace TauCeti

variable {A : Type*} [Ring A] {m k : Type*} [DecidableEq m] [Fintype m] [DecidableEq k]
  [Fintype k]

/-- Placing an elementary matrix in the upper left block gives an elementary matrix: the
stabilization `e ↦ e ⊕ 1` maps the elementary subgroup into the elementary subgroup. -/
theorem map_elementarySubgroup_le_elementarySubgroup :
    (elementarySubgroup m A).map (fromBlocksGL.comp (MonoidHom.inl (GL m A) (GL k A))) ≤
      elementarySubgroup (m ⊕ k) A := by
  refine Subgroup.map_le_iff_le_comap.2 (elementarySubgroup_le_iff.2 fun i j hij a ↦ ?_)
  rw [Subgroup.mem_comap]
  convert transvectionUnit_mem_elementarySubgroup (Sum.inl_injective.ne hij) a
  ext (p | p) (q | q) <;>
    simp [coe_transvectionUnit_eq_one_add_single, single_apply, one_apply]

/-- **Whitehead's lemma.** For an invertible matrix `u`, the block diagonal matrix `u ⊕ u⁻¹` is
elementary: it is the product of six block unipotent matrices,
`u ⊕ u⁻¹ = U(u) L(-u⁻¹) U(u) U(-1) L(1) U(-1)`. -/
theorem fromBlocksGL_inv_mem_elementarySubgroup (u : GL m A) :
    fromBlocksGL (u, u⁻¹) ∈ elementarySubgroup (m ⊕ m) A := by
  have h : fromBlocksGL (u, u⁻¹) = upperBlockGL (u : Matrix m m A) * lowerBlockGL (-↑u⁻¹) *
      upperBlockGL (u : Matrix m m A) * upperBlockGL (-1) * lowerBlockGL 1 * upperBlockGL (-1) :=
    Units.ext (by simp [fromBlocks_multiply])
  rw [h]
  refine mul_mem (mul_mem (mul_mem (mul_mem (mul_mem ?_ ?_) ?_) ?_) ?_) ?_ <;>
    first
    | exact upperBlockGL_mem_elementarySubgroup _
    | exact lowerBlockGL_mem_elementarySubgroup _

/-- **Commutators are stably elementary.** For invertible matrices `u` and `v`, the stabilized
commutator `⁅u, v⁆ ⊕ 1` is elementary, being `(uv ⊕ (uv)⁻¹) (u⁻¹ ⊕ u) (v⁻¹ ⊕ v)`. -/
theorem fromBlocksGL_commutatorElement_mem_elementarySubgroup (u v : GL m A) :
    fromBlocksGL (⁅u, v⁆, 1) ∈ elementarySubgroup (m ⊕ m) A := by
  have h : fromBlocksGL (⁅u, v⁆, 1) =
      fromBlocksGL (u * v, (u * v)⁻¹) * fromBlocksGL (u⁻¹, u⁻¹⁻¹) *
        fromBlocksGL (v⁻¹, v⁻¹⁻¹) := by
    rw [← map_mul, ← map_mul, Prod.mk_mul_mk, Prod.mk_mul_mk, commutatorElement_def]
    congr 1
    ext : 1 <;> simp [mul_assoc]
  rw [h]
  exact mul_mem (mul_mem (fromBlocksGL_inv_mem_elementarySubgroup _)
    (fromBlocksGL_inv_mem_elementarySubgroup _)) (fromBlocksGL_inv_mem_elementarySubgroup _)

/-- The stabilization `u ↦ u ⊕ 1` maps the commutator subgroup of `GL m A` into the elementary
subgroup of `GL (m ⊕ m) A`. -/
theorem map_commutator_le_elementarySubgroup :
    (commutator (GL m A)).map (fromBlocksGL.comp (MonoidHom.inl (GL m A) (GL m A))) ≤
      elementarySubgroup (m ⊕ m) A := by
  refine Subgroup.map_le_iff_le_comap.2 (Subgroup.commutator_le.2 fun u _ v _ ↦ ?_)
  exact fromBlocksGL_commutatorElement_mem_elementarySubgroup u v

/-- **The elementary subgroup is stably normal.** For `e` elementary and `g` invertible, the
stabilized conjugate `g e g⁻¹ ⊕ 1` is elementary, being `(g ⊕ g⁻¹) (e ⊕ 1) (g ⊕ g⁻¹)⁻¹`. -/
theorem fromBlocksGL_conj_mem_elementarySubgroup (g : GL m A) {e : GL m A}
    (he : e ∈ elementarySubgroup m A) :
    fromBlocksGL (g * e * g⁻¹, 1) ∈ elementarySubgroup (m ⊕ m) A := by
  have h : fromBlocksGL (g * e * g⁻¹, 1) =
      fromBlocksGL (g, g⁻¹) * fromBlocksGL (e, 1) * (fromBlocksGL (g, g⁻¹))⁻¹ := by
    rw [← map_inv, ← map_mul, ← map_mul]
    simp
  have he' : fromBlocksGL (e, 1) ∈ elementarySubgroup (m ⊕ m) A :=
    map_elementarySubgroup_le_elementarySubgroup ⟨e, he, rfl⟩
  rw [h]
  exact mul_mem (mul_mem (fromBlocksGL_inv_mem_elementarySubgroup g) he')
    (inv_mem (fromBlocksGL_inv_mem_elementarySubgroup g))

end TauCeti
