module

public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Transvection

/-!
# Elementary matrices over a ring and Whitehead's lemma

For a possibly noncommutative ring `A` and distinct indices `i ≠ j`, the elementary matrix
`eᵢⱼ(a) = 1 + a Eᵢⱼ` is the transvection `TauCeti.transvectionUnit`, invertible with inverse
`eᵢⱼ(-a)`. The subgroup `E n A` of `GL n A` generated by these matrices is the elementary
subgroup. Algebraic `K₁` is the quotient `GL_∞(A) / E_∞(A)` of the stable general linear group by
the stable elementary subgroup, and this file supplies the finite-size facts which make that
quotient a well-defined abelian group:

* `E n A` is perfect as soon as `n` has at least three elements: each generator is the commutator
  `⁅eᵢₗ(a), eₗⱼ(1)⁆` for an index `l` distinct from `i` and `j`. Hence `E n A` lies in the
  commutator subgroup of `GL n A`.
* **Whitehead's lemma.** For `u` invertible of size `m`, the block diagonal matrix `u ⊕ u⁻¹` is
  elementary of size `m ⊕ m`. Consequently, for a commutator `⁅u, v⁆` of `GL m A`, the
  stabilization `⁅u, v⁆ ⊕ 1` is elementary, and for `e ∈ E m A` and `g ∈ GL m A` the
  stabilization of the conjugate `g e g⁻¹` is elementary.

Thus, after stabilization, the elementary subgroup is normalized by every invertible matrix and
agrees with the commutator subgroup;
these are the relations through which homomorphisms on invertible matrices, such as Connes' odd
pairing with cyclic cohomology, descend to `K₁`.

Over a commutative ring the elementary matrices are Mathlib's determinant-one transvections, so
`E n A` is the image in `GL n A` of the subgroup of `SL n A` generated by transvections.

Over a Euclidean domain `R`, such as `ℤ` or a field, `E n R` consists exactly of the matrices of
determinant one, in every finite size; this is the input for computing `K₁` of these rings. Its
first step is column reduction: the Euclidean algorithm, run by elementary row operations on
pairs of coordinates, carries every vector to a multiple of a standard basis vector.

## Main definitions

* `TauCeti.elementarySubgroup`: the subgroup of `GL n A` generated by elementary matrices.
* `TauCeti.fromBlocksGL`: the block diagonal homomorphism `GL m A × GL k A →* GL (m ⊕ k) A`.
* `Matrix.upperBlockGL`, `Matrix.lowerBlockGL`: the block unipotent matrices
  `fromBlocks 1 X 0 1` and `fromBlocks 1 0 Y 1`.

## Main results

* `TauCeti.commutator_elementarySubgroup_self`: `⁅E n A, E n A⁆ = E n A` when `3 ≤ card n`.
* `TauCeti.elementarySubgroup_le_commutator`: `E n A ≤ ⁅GL n A, GL n A⁆` when `3 ≤ card n`.
* `Equiv.map_reindexGL_elementarySubgroup`: relabelling the indices preserves the elementary
  subgroup.
* `Matrix.upperBlockGL_mem_elementarySubgroup`, `Matrix.lowerBlockGL_mem_elementarySubgroup`:
  block unipotent matrices are elementary.
* `TauCeti.fromBlocksGL_inv_mem_elementarySubgroup`: Whitehead's lemma, `u ⊕ u⁻¹ ∈ E`.
* `TauCeti.map_commutator_le_elementarySubgroup`: the stabilized commutator subgroup is elementary.
* `TauCeti.fromBlocksGL_conj_mem_elementarySubgroup`: the stabilization of a conjugate of an
  elementary matrix is elementary.
* `TauCeti.elementarySubgroup_eq_map_closure_range_toSpecialLinearGroup`: over a commutative ring,
  `E n A` is the image of the subgroup of `SL n A` generated by transvections.
* `TauCeti.exists_mem_elementarySubgroup_mulVec_eq_single`: over a Euclidean domain, an
  elementary matrix carries any vector to a multiple of a chosen standard basis vector.
* `TauCeti.elementarySubgroup_eq_ker_det_of_euclideanDomain`: over a Euclidean domain, `E n R` is
  the subgroup of matrices of determinant one.

## Scalar change and lifting

`RingHom.elementarySubgroupMap` is entrywise scalar change via `Units.map` of
`RingHom.mapMatrix`, over arbitrary rings. It respects identity and composition and is
surjective for surjective ring maps, without changing the matrix size. In particular,
Whitehead's elementary matrix `u ⊕ u⁻¹` has an elementary invertible lift through any
surjective ring map, even when `u` itself has no invertible lift. These facts supply elementary
lifts for patching invertible matrices over a quotient ring.

## References

* J. Milnor, *Introduction to Algebraic K-Theory*, Annals of Mathematics Studies 72 (1971),
  §3, Lemma 3.1 (Whitehead) and Proposition 3.2.
* J. Rosenberg, *Algebraic K-Theory and Its Applications*, GTM 147 (1994), §2.1.
* C. A. Weibel, *The K-book*, Chapter III, §1, especially Remark 1.2.3,
  Whitehead's Lemma 1.3.3 and Exercise 1.5 (Euclidean domains).
-/

public section

open Matrix

open scoped commutatorElement

namespace TauCeti

variable {n : Type*} [DecidableEq n] [Fintype n] {A : Type*} [Ring A] {i j l : n}

/-! ## The elementary subgroup -/

variable (n A) in
/-- The **elementary subgroup** of `GL n A`: the subgroup generated by the elementary matrices
`1 + a Eᵢⱼ` with `i ≠ j`. -/
def elementarySubgroup : Subgroup (GL n A) :=
  Subgroup.closure {g | ∃ (i j : n) (hij : i ≠ j) (a : A), transvectionUnit hij a = g}

variable (n A) in
/-- The elementary subgroup is the subgroup generated by the elementary matrices. -/
theorem elementarySubgroup_def :
    elementarySubgroup n A =
      Subgroup.closure {g | ∃ (i j : n) (hij : i ≠ j) (a : A), transvectionUnit hij a = g} :=
  (rfl)

/-- Elementary matrices lie in the elementary subgroup. -/
theorem transvectionUnit_mem_elementarySubgroup (hij : i ≠ j) (a : A) :
    transvectionUnit hij a ∈ elementarySubgroup n A :=
  Subgroup.subset_closure ⟨i, j, hij, a, rfl⟩

/-- The elementary subgroup is contained in a subgroup exactly when every elementary matrix is. -/
theorem elementarySubgroup_le_iff {H : Subgroup (GL n A)} :
    elementarySubgroup n A ≤ H ↔ ∀ (i j : n) (hij : i ≠ j) (a : A), transvectionUnit hij a ∈ H := by
  rw [elementarySubgroup_def, Subgroup.closure_le]
  constructor
  · exact fun h i j hij a ↦ h ⟨i, j, hij, a, rfl⟩
  · rintro h _ ⟨i, j, hij, a, rfl⟩
    exact h i j hij a

/-- **The elementary subgroup is perfect** in size at least three: each elementary matrix
`eᵢⱼ(a)` is the commutator `⁅eᵢₗ(a), eₗⱼ(1)⁆` for an index `l` distinct from `i` and `j`. -/
theorem commutator_elementarySubgroup_self (hn : 3 ≤ Fintype.card n) :
    ⁅elementarySubgroup n A, elementarySubgroup n A⁆ = elementarySubgroup n A := by
  refine le_antisymm (Subgroup.commutator_le.2 fun g hg h hh ↦ ?_) ?_
  · rw [commutatorElement_def]
    exact mul_mem (mul_mem (mul_mem hg hh) (inv_mem hg)) (inv_mem hh)
  refine elementarySubgroup_le_iff.2 fun i j hij a ↦ ?_
  -- A third index `l`, distinct from `i` and `j`.
  obtain ⟨l, -, hl⟩ := Finset.exists_mem_notMem_of_card_lt_card (s := {i, j})
    (t := Finset.univ) (Finset.card_le_two.trans_lt (by rw [Finset.card_univ]; omega))
  obtain ⟨hli, hlj⟩ : l ≠ i ∧ l ≠ j := by simpa [not_or] using hl
  rw [← mul_one a, ← commutatorElement_transvectionUnit hli.symm hlj hij]
  exact Subgroup.commutator_mem_commutator (transvectionUnit_mem_elementarySubgroup _ _)
    (transvectionUnit_mem_elementarySubgroup _ _)

/-- In size at least three, the elementary subgroup lies in the commutator subgroup of
`GL n A`. -/
theorem elementarySubgroup_le_commutator (hn : 3 ≤ Fintype.card n) :
    elementarySubgroup n A ≤ commutator (GL n A) := by
  rw [← commutator_elementarySubgroup_self hn]
  exact Subgroup.commutator_mono le_top le_top

/-! ## Block matrices -/

variable {m k : Type*} [DecidableEq m] [Fintype m] [DecidableEq k] [Fintype k]

/-- The **block diagonal homomorphism** `(u, v) ↦ u ⊕ v` from `GL m A × GL k A` to
`GL (m ⊕ k) A`. -/
def fromBlocksGL : GL m A × GL k A →* GL (m ⊕ k) A where
  toFun u :=
    { val := fromBlocks u.1 0 0 u.2
      inv := fromBlocks ↑u.1⁻¹ 0 0 ↑u.2⁻¹
      val_inv := by simp [fromBlocks_multiply]
      inv_val := by simp [fromBlocks_multiply] }
  map_one' := Units.ext (by simp)
  map_mul' u v := Units.ext (by simp [fromBlocks_multiply])

/-- The matrix underlying a block diagonal invertible matrix. -/
@[simp]
theorem coe_fromBlocksGL (u : GL m A × GL k A) :
    (fromBlocksGL u : Matrix (m ⊕ k) (m ⊕ k) A) = fromBlocks u.1 0 0 u.2 :=
  (rfl)

end TauCeti

namespace Matrix

open TauCeti

variable {A : Type*} [Ring A] {m k : Type*} [DecidableEq m] [Fintype m] [DecidableEq k]
  [Fintype k]

/-- The block unipotent matrix `fromBlocks 1 X 0 1`, with inverse `fromBlocks 1 (-X) 0 1`. -/
def upperBlockGL (X : Matrix m k A) : GL (m ⊕ k) A where
  val := fromBlocks 1 X 0 1
  inv := fromBlocks 1 (-X) 0 1
  val_inv := by simp [fromBlocks_multiply]
  inv_val := by simp [fromBlocks_multiply]

/-- The block unipotent matrix `fromBlocks 1 0 Y 1`, with inverse `fromBlocks 1 0 (-Y) 1`. -/
def lowerBlockGL (Y : Matrix k m A) : GL (m ⊕ k) A where
  val := fromBlocks 1 0 Y 1
  inv := fromBlocks 1 0 (-Y) 1
  val_inv := by simp [fromBlocks_multiply]
  inv_val := by simp [fromBlocks_multiply]

/-- The matrix underlying an upper block unipotent matrix. -/
@[simp]
theorem coe_upperBlockGL (X : Matrix m k A) :
    (upperBlockGL X : Matrix (m ⊕ k) (m ⊕ k) A) = fromBlocks 1 X 0 1 :=
  (rfl)

/-- The matrix underlying a lower block unipotent matrix. -/
@[simp]
theorem coe_lowerBlockGL (Y : Matrix k m A) :
    (lowerBlockGL Y : Matrix (m ⊕ k) (m ⊕ k) A) = fromBlocks 1 0 Y 1 :=
  (rfl)

/-- The upper block unipotent matrix of the zero block is the identity. -/
@[simp]
theorem upperBlockGL_zero : upperBlockGL (0 : Matrix m k A) = 1 :=
  Units.ext (by simp)

/-- The lower block unipotent matrix of the zero block is the identity. -/
@[simp]
theorem lowerBlockGL_zero : lowerBlockGL (0 : Matrix k m A) = 1 :=
  Units.ext (by simp)

/-- Upper block unipotent matrices multiply by adding their blocks. -/
@[simp]
theorem upperBlockGL_add (X Y : Matrix m k A) :
    upperBlockGL (X + Y) = upperBlockGL X * upperBlockGL Y :=
  Units.ext (by simp [fromBlocks_multiply, add_comm])

/-- Lower block unipotent matrices multiply by adding their blocks. -/
@[simp]
theorem lowerBlockGL_add (X Y : Matrix k m A) :
    lowerBlockGL (X + Y) = lowerBlockGL X * lowerBlockGL Y :=
  Units.ext (by simp [fromBlocks_multiply])

/-- The inverse of an upper block unipotent matrix negates its block. -/
@[simp]
theorem upperBlockGL_inv (X : Matrix m k A) : (upperBlockGL X)⁻¹ = upperBlockGL (-X) :=
  Units.ext (rfl)

/-- The inverse of a lower block unipotent matrix negates its block. -/
@[simp]
theorem lowerBlockGL_inv (Y : Matrix k m A) : (lowerBlockGL Y)⁻¹ = lowerBlockGL (-Y) :=
  Units.ext (rfl)

/-- Upper block unipotent matrices are elementary: they are products of the commuting elementary
matrices `1 + X a b E_(inl a, inr b)`. -/
theorem upperBlockGL_mem_elementarySubgroup (X : Matrix m k A) :
    upperBlockGL X ∈ elementarySubgroup (m ⊕ k) A := by
  induction X using Matrix.induction_on' with
  | h_zero => simp
  | h_add X Y hX hY => simpa only [upperBlockGL_add] using mul_mem hX hY
  | h_std_basis a b c =>
    convert transvectionUnit_mem_elementarySubgroup (Sum.inl_ne_inr (a := a) (b := b)) c
    ext (p | p) (q | q) <;>
      simp [coe_transvectionUnit_eq_one_add_single, single_apply, Matrix.one_apply]

/-- Lower block unipotent matrices are elementary: they are products of the commuting elementary
matrices `1 + Y b a E_(inr b, inl a)`. -/
theorem lowerBlockGL_mem_elementarySubgroup (Y : Matrix k m A) :
    lowerBlockGL Y ∈ elementarySubgroup (m ⊕ k) A := by
  induction Y using Matrix.induction_on' with
  | h_zero => simp
  | h_add X Y hX hY => simpa only [lowerBlockGL_add] using mul_mem hX hY
  | h_std_basis b a c =>
    convert transvectionUnit_mem_elementarySubgroup (Sum.inr_ne_inl (a := a) (b := b)) c
    ext (p | p) (q | q) <;>
      simp [coe_transvectionUnit_eq_one_add_single, single_apply, Matrix.one_apply]

end Matrix

namespace TauCeti

variable {A : Type*} [Ring A] {m k : Type*} [DecidableEq m] [Fintype m] [DecidableEq k]
  [Fintype k]

/-- Placing an elementary matrix in the upper left block gives an elementary matrix: the
stabilization `e ↦ e ⊕ 1` maps the elementary subgroup into the elementary subgroup. -/
theorem map_elementarySubgroup_le_elementarySubgroup :
    (elementarySubgroup m A).map (fromBlocksGL.comp (MonoidHom.inl (GL m A) (GL k A))) ≤
      elementarySubgroup (m ⊕ k) A := by
  refine Subgroup.map_le_iff_le_comap.2 (elementarySubgroup_le_iff.2 fun i j hij a ↦ ?_)
  rw [Subgroup.mem_comap]
  convert transvectionUnit_mem_elementarySubgroup (Sum.inl_injective.ne hij) a
  ext (p | p) (q | q) <;>
    simp [coe_transvectionUnit_eq_one_add_single, single_apply, Matrix.one_apply]

/-- **Whitehead's lemma.** For an invertible matrix `u`, the block diagonal matrix `u ⊕ u⁻¹` is
elementary: it is the product of six block unipotent matrices,
`u ⊕ u⁻¹ = U(u) L(-u⁻¹) U(u) U(-1) L(1) U(-1)`. -/
theorem fromBlocksGL_inv_mem_elementarySubgroup (u : GL m A) :
    fromBlocksGL (u, u⁻¹) ∈ elementarySubgroup (m ⊕ m) A := by
  have h : fromBlocksGL (u, u⁻¹) = upperBlockGL (u : Matrix m m A) * lowerBlockGL (-↑u⁻¹) *
      upperBlockGL (u : Matrix m m A) * upperBlockGL (-1) * lowerBlockGL 1 * upperBlockGL (-1) :=
    Units.ext (by simp [fromBlocks_multiply])
  rw [h]
  refine mul_mem (mul_mem (mul_mem (mul_mem (mul_mem ?_ ?_) ?_) ?_) ?_) ?_ <;>
    first
    | exact upperBlockGL_mem_elementarySubgroup _
    | exact lowerBlockGL_mem_elementarySubgroup _

/-- **Commutators are stably elementary.** For invertible matrices `u` and `v`, the stabilized
commutator `⁅u, v⁆ ⊕ 1` is elementary, being `(uv ⊕ (uv)⁻¹) (u⁻¹ ⊕ u) (v⁻¹ ⊕ v)`. -/
theorem fromBlocksGL_commutatorElement_mem_elementarySubgroup (u v : GL m A) :
    fromBlocksGL (⁅u, v⁆, 1) ∈ elementarySubgroup (m ⊕ m) A := by
  have h : fromBlocksGL (⁅u, v⁆, 1) =
      fromBlocksGL (u * v, (u * v)⁻¹) * fromBlocksGL (u⁻¹, u⁻¹⁻¹) *
        fromBlocksGL (v⁻¹, v⁻¹⁻¹) := by
    rw [← map_mul, ← map_mul, Prod.mk_mul_mk, Prod.mk_mul_mk, commutatorElement_def]
    congr 1
    ext : 1 <;> simp [mul_assoc]
  rw [h]
  exact mul_mem (mul_mem (fromBlocksGL_inv_mem_elementarySubgroup _)
    (fromBlocksGL_inv_mem_elementarySubgroup _)) (fromBlocksGL_inv_mem_elementarySubgroup _)

/-- The stabilization `u ↦ u ⊕ 1` maps the commutator subgroup of `GL m A` into the elementary
subgroup of `GL (m ⊕ m) A`. -/
theorem map_commutator_le_elementarySubgroup :
    (commutator (GL m A)).map (fromBlocksGL.comp (MonoidHom.inl (GL m A) (GL m A))) ≤
      elementarySubgroup (m ⊕ m) A := by
  refine Subgroup.map_le_iff_le_comap.2 (Subgroup.commutator_le.2 fun u _ v _ ↦ ?_)
  exact fromBlocksGL_commutatorElement_mem_elementarySubgroup u v

/-- **The elementary subgroup is stably normal.** For `e` elementary and `g` invertible, the
stabilized conjugate `g e g⁻¹ ⊕ 1` is elementary, being `(g ⊕ g⁻¹) (e ⊕ 1) (g ⊕ g⁻¹)⁻¹`. -/
theorem fromBlocksGL_conj_mem_elementarySubgroup (g : GL m A) {e : GL m A}
    (he : e ∈ elementarySubgroup m A) :
    fromBlocksGL (g * e * g⁻¹, 1) ∈ elementarySubgroup (m ⊕ m) A := by
  have h : fromBlocksGL (g * e * g⁻¹, 1) =
      fromBlocksGL (g, g⁻¹) * fromBlocksGL (e, 1) * (fromBlocksGL (g, g⁻¹))⁻¹ := by
    rw [← map_inv, ← map_mul, ← map_mul]
    simp
  have he' : fromBlocksGL (e, 1) ∈ elementarySubgroup (m ⊕ m) A :=
    map_elementarySubgroup_le_elementarySubgroup ⟨e, he, rfl⟩
  rw [h]
  exact mul_mem (mul_mem (fromBlocksGL_inv_mem_elementarySubgroup g) he')
    (inv_mem (fromBlocksGL_inv_mem_elementarySubgroup g))

/-! ## Comparison with the special linear group over a commutative ring -/

section CommRing

variable {n : Type*} [DecidableEq n] [Fintype n] {R : Type*} [CommRing R]

/-- Over a commutative ring, the elementary subgroup is the image in `GL n R` of the subgroup of
`SL n R` generated by the transvections. -/
theorem elementarySubgroup_eq_map_closure_range_toSpecialLinearGroup :
    elementarySubgroup n R =
      (Subgroup.closure (Set.range (TransvectionStruct.toSpecialLinearGroup :
        TransvectionStruct n R → SpecialLinearGroup n R))).map SpecialLinearGroup.toGL := by
  rw [elementarySubgroup_def, MonoidHom.map_closure, ← Set.range_comp]
  congr 1
  ext g
  constructor
  · rintro ⟨i, j, hij, a, rfl⟩
    exact ⟨⟨i, j, hij, a⟩, toGL_transvection_eq_transvectionUnit hij a⟩
  · rintro ⟨t, rfl⟩
    exact ⟨t.i, t.j, t.hij, t.c, (toGL_transvection_eq_transvectionUnit t.hij t.c).symm⟩

/-- Over a commutative ring, every elementary matrix has determinant one. -/
theorem elementarySubgroup_le_ker_det :
    elementarySubgroup n R ≤ GeneralLinearGroup.det.ker :=
  elementarySubgroup_le_iff.2 fun _ _ hij a ↦ det_transvectionUnit hij a

/-- If the special linear group of a commutative ring is generated by its transvections, then the
elementary subgroup is the image of the whole special linear group, the subgroup of matrices of
determinant one. -/
theorem elementarySubgroup_eq_ker_det_of_closure_eq_top
    (h : Subgroup.closure (Set.range (TransvectionStruct.toSpecialLinearGroup :
      TransvectionStruct n R → SpecialLinearGroup n R)) = ⊤) :
    elementarySubgroup n R = GeneralLinearGroup.det.ker := by
  rw [elementarySubgroup_eq_map_closure_range_toSpecialLinearGroup, h, ← MonoidHom.range_eq_map,
    SpecialLinearGroup.range_toGL_eq_ker_det]

end CommRing

end TauCeti

namespace Equiv

open TauCeti

variable {n m : Type*} [DecidableEq n] [Fintype n] [DecidableEq m] [Fintype m] {A : Type*} [Ring A]

/-- Relabelling the indices along an equivalence maps the elementary subgroup onto the elementary
subgroup. -/
theorem map_reindexGL_elementarySubgroup (e : n ≃ m) :
    (elementarySubgroup n A).map (e.reindexGL A).toMonoidHom = elementarySubgroup m A := by
  rw [elementarySubgroup_def, elementarySubgroup_def, MonoidHom.map_closure]
  congr 1
  ext g
  simp only [Set.mem_image, Set.mem_ofPred_eq, MulEquiv.coe_toMonoidHom]
  constructor
  · rintro ⟨_, ⟨i, j, hij, a, rfl⟩, rfl⟩
    exact ⟨e i, e j, e.injective.ne hij, a, (e.reindexGL_transvectionUnit hij a).symm⟩
  · rintro ⟨i, j, hij, a, rfl⟩
    refine ⟨_, ⟨e.symm i, e.symm j, e.symm.injective.ne hij, a, rfl⟩, ?_⟩
    rw [reindexGL_transvectionUnit]
    simp_rw [Equiv.apply_symm_apply]

end Equiv

namespace RingHom

open TauCeti

variable {A B C n : Type*} [Ring A] [Ring B] [Ring C] [Fintype n] [DecidableEq n]

/-! ## Scalar change and lifting -/

/-- Scalar change carries elementary matrices into elementary matrices, in the same size. -/
theorem map_elementarySubgroup_le (f : A →+* B) :
    (elementarySubgroup n A).map (Units.map (f.mapMatrix (m := n)).toMonoidHom) ≤
      elementarySubgroup n B := by
  refine Subgroup.map_le_iff_le_comap.2 (elementarySubgroup_le_iff.2 fun i j hij a ↦ ?_)
  simpa only [Subgroup.mem_comap, RingHom.toMonoidHom_eq_coe,
    unitsMap_mapMatrix_transvectionUnit] using
    transvectionUnit_mem_elementarySubgroup hij (f a)

/-- A surjective ring map carries the elementary subgroup onto the elementary subgroup in the
same matrix size. Scalar change need not be surjective on the full general linear group,
even after stabilization. -/
theorem map_elementarySubgroup_eq_of_surjective (f : A →+* B)
    (hf : Function.Surjective f) :
    (elementarySubgroup n A).map (Units.map (f.mapMatrix (m := n)).toMonoidHom) =
      elementarySubgroup n B := by
  refine le_antisymm f.map_elementarySubgroup_le (elementarySubgroup_le_iff.2 ?_)
  intro i j hij b
  obtain ⟨a, rfl⟩ := hf b
  exact ⟨transvectionUnit hij a, transvectionUnit_mem_elementarySubgroup hij a,
    f.unitsMap_mapMatrix_transvectionUnit hij a⟩

/-- An elementary invertible matrix lifts to an elementary invertible matrix of the same size
through any surjective ring map. -/
theorem exists_mem_elementarySubgroup_unitsMap_mapMatrix_eq
    (f : A →+* B) (hf : Function.Surjective f) {u : GL n B} (hu : u ∈ elementarySubgroup n B) :
    ∃ v ∈ elementarySubgroup n A,
      Units.map (f.mapMatrix (m := n)).toMonoidHom v = u := by
  rw [← f.map_elementarySubgroup_eq_of_surjective hf] at hu
  exact hu

/-- The homomorphism on elementary subgroups induced by a unital ring map. -/
def elementarySubgroupMap (f : A →+* B) :
    elementarySubgroup n A →* elementarySubgroup n B :=
  ((Units.map (f.mapMatrix (m := n)).toMonoidHom).comp
    (elementarySubgroup n A).subtype).codRestrict (elementarySubgroup n B)
      (fun u ↦ f.map_elementarySubgroup_le ⟨u, u.property, rfl⟩)

/-- The induced map on elementary subgroups is entrywise scalar change. -/
@[simp]
theorem coe_elementarySubgroupMap (f : A →+* B) (u : elementarySubgroup n A) :
    (f.elementarySubgroupMap u : GL n B) =
      Units.map (f.mapMatrix (m := n)).toMonoidHom (u : GL n A) :=
  (rfl)

/-- Extension along the identity ring map is the identity on the elementary subgroup. -/
@[simp]
theorem elementarySubgroupMap_id :
    (RingHom.id A).elementarySubgroupMap (n := n) = MonoidHom.id _ := by
  ext u : 1
  apply Subtype.ext
  simp [coe_elementarySubgroupMap]

/-- Extension on elementary subgroups respects composition of ring maps. -/
@[simp]
theorem elementarySubgroupMap_comp (f : A →+* B) (g : B →+* C) :
    (g.comp f).elementarySubgroupMap (n := n) =
      g.elementarySubgroupMap.comp f.elementarySubgroupMap := by
  ext u : 1
  apply Subtype.ext
  simp only [MonoidHom.comp_apply, coe_elementarySubgroupMap]
  rfl

/-- The induced homomorphism on elementary subgroups is surjective whenever the ring map is. -/
theorem elementarySubgroupMap_surjective (f : A →+* B) (hf : Function.Surjective f) :
    Function.Surjective (f.elementarySubgroupMap (n := n)) := by
  intro u
  obtain ⟨v, hv, h⟩ := f.exists_mem_elementarySubgroup_unitsMap_mapMatrix_eq hf u.property
  exact ⟨⟨v, hv⟩, Subtype.ext h⟩

/-- Whitehead's matrix `u ⊕ u⁻¹` lifts to an elementary invertible matrix through every
surjective ring map, even when `u` itself has no invertible lift. This lifts `u ⊕ u⁻¹`
in size `n ⊕ n`, not the stabilization `u ⊕ 1`. -/
theorem exists_mem_elementarySubgroup_unitsMap_mapMatrix_eq_fromBlocksGL_inv
    (f : A →+* B) (hf : Function.Surjective f) (u : GL n B) :
    ∃ v ∈ elementarySubgroup (n ⊕ n) A,
      Units.map (f.mapMatrix (m := n ⊕ n)).toMonoidHom v = fromBlocksGL (u, u⁻¹) :=
  f.exists_mem_elementarySubgroup_unitsMap_mapMatrix_eq hf
    (fromBlocksGL_inv_mem_elementarySubgroup u)

end RingHom

namespace TauCeti

/-! ## Elementary generation over a Euclidean domain -/

section EuclideanDomain

variable {R : Type*} [EuclideanDomain R]

section Column

variable {n : Type*} [DecidableEq n] [Fintype n]

/-- One run of the Euclidean algorithm on the coordinates `i` and `j` of a vector whose `j`-th
coordinate is `x`: elementary row operations at `i` and `j` make one of these two coordinates
vanish and leave all other coordinates unchanged. The induction is on `x` for the well-founded
relation of the Euclidean domain. -/
private theorem exists_mem_elementarySubgroup_mulVec_eq_zero_or (x : R) :
    ∀ {i j : n}, i ≠ j → ∀ v : n → R, v j = x →
      ∃ e ∈ elementarySubgroup n R,
        (((e : Matrix n n R) *ᵥ v) i = 0 ∨ ((e : Matrix n n R) *ᵥ v) j = 0) ∧
          ∀ k, k ≠ i → k ≠ j → ((e : Matrix n n R) *ᵥ v) k = v k := by
  induction x using (@EuclideanDomain.r_wellFounded R _).induction with
  | _ x ih => ?_
  intro i j hij v hv
  by_cases hx : x = 0
  · exact ⟨1, one_mem _, Or.inr (by simp [hv, hx]), fun k _ _ ↦ by simp⟩
  -- Replace the `i`-th coordinate by its remainder modulo `x`; then the roles of `i` and `j`
  -- are exchanged, with a smaller value at the new second index.
  have ht : (transvectionUnit hij (-(v i / x)) : Matrix n n R) *ᵥ v =
      Function.update v i (v i % x) := by
    rw [transvectionUnit_mulVec, hv, EuclideanDomain.mod_eq_sub_mul_div]
    congr 1
    ring
  obtain ⟨e, he, hzero, hfix⟩ := ih (v i % x) (EuclideanDomain.mod_lt _ hx) hij.symm
    (Function.update v i (v i % x)) (by simp)
  refine ⟨e * transvectionUnit hij (-(v i / x)),
    mul_mem he (transvectionUnit_mem_elementarySubgroup _ _), ?_, fun k hki hkj ↦ ?_⟩
  · rw [Units.val_mul, ← mulVec_mulVec, ht]
    exact hzero.symm
  · rw [Units.val_mul, ← mulVec_mulVec, ht, hfix k hkj hki, Function.update_of_ne hki]

/-- Elementary row operations at `i` and `j` make the `j`-th coordinate of a vector over a
Euclidean domain vanish and leave all coordinates other than the `i`-th and `j`-th unchanged. -/
private theorem exists_mem_elementarySubgroup_mulVec_eq_zero {i j : n} (hij : i ≠ j)
    (v : n → R) :
    ∃ e ∈ elementarySubgroup n R, ((e : Matrix n n R) *ᵥ v) j = 0 ∧
      ∀ k, k ≠ i → k ≠ j → ((e : Matrix n n R) *ᵥ v) k = v k := by
  obtain ⟨e, he, hzero | hzero, hfix⟩ :=
    exists_mem_elementarySubgroup_mulVec_eq_zero_or (v j) hij v rfl
  · -- The `i`-th coordinate vanishes: copy the `j`-th coordinate into it, then clear the `j`-th.
    refine ⟨transvectionUnit hij.symm (-1) * transvectionUnit hij 1 * e,
      mul_mem (mul_mem (transvectionUnit_mem_elementarySubgroup _ _)
        (transvectionUnit_mem_elementarySubgroup _ _)) he, ?_, fun k hki hkj ↦ ?_⟩
    · simp only [Units.val_mul, ← mulVec_mulVec, transvectionUnit_mulVec]
      simp [hzero, hij.symm]
    · simp only [Units.val_mul, ← mulVec_mulVec, transvectionUnit_mulVec]
      simp [hki, hkj, hfix k hki hkj]
  · exact ⟨e, he, hzero, hfix⟩

/-- **Column reduction over a Euclidean domain.** An elementary matrix carries any vector over a
Euclidean domain to a multiple of any chosen standard basis vector. -/
theorem exists_mem_elementarySubgroup_mulVec_eq_single (v : n → R) (p : n) :
    ∃ e ∈ elementarySubgroup n R, ∃ d : R, (e : Matrix n n R) *ᵥ v = Pi.single p d := by
  suffices h : ∀ s : Finset n, p ∉ s →
      ∃ e ∈ elementarySubgroup n R, ∀ k ∈ s, ((e : Matrix n n R) *ᵥ v) k = 0 by
    obtain ⟨e, he, hs⟩ := h (Finset.univ.erase p) (Finset.notMem_erase p _)
    refine ⟨e, he, ((e : Matrix n n R) *ᵥ v) p, funext fun k ↦ ?_⟩
    rcases eq_or_ne k p with rfl | hk
    · simp
    · simp [hk, hs k (Finset.mem_erase.2 ⟨hk, Finset.mem_univ k⟩)]
  intro s
  induction s using Finset.induction_on with
  | empty => exact fun _ ↦ ⟨1, one_mem _, by simp⟩
  | insert j s hjs ih =>
    intro hp
    rw [Finset.mem_insert, not_or] at hp
    obtain ⟨e, he, hs⟩ := ih hp.2
    obtain ⟨e', he', hj, hfix⟩ :=
      exists_mem_elementarySubgroup_mulVec_eq_zero hp.1 ((e : Matrix n n R) *ᵥ v)
    refine ⟨e' * e, mul_mem he' he, fun k hk ↦ ?_⟩
    rw [Units.val_mul, ← mulVec_mulVec]
    rcases Finset.mem_insert.1 hk with rfl | hk
    · exact hj
    · rw [hfix k (fun h ↦ hp.2 (h ▸ hk)) (fun h ↦ hjs (h ▸ hk)), hs k hk]

/-- Three elementary row operations carry a unit multiple of a standard basis vector to that
basis vector, using a second index `q`. -/
private theorem exists_mem_elementarySubgroup_mulVec_single_eq_single_one {p q : n}
    (hqp : q ≠ p) (u : Rˣ) :
    ∃ e ∈ elementarySubgroup n R,
      (e : Matrix n n R) *ᵥ Pi.single p (u : R) = Pi.single p 1 := by
  refine ⟨transvectionUnit hqp (-1) * transvectionUnit hqp.symm (1 - (u : R)) *
      transvectionUnit hqp ((u⁻¹ : Rˣ) : R),
    mul_mem (mul_mem (transvectionUnit_mem_elementarySubgroup _ _)
      (transvectionUnit_mem_elementarySubgroup _ _)) (transvectionUnit_mem_elementarySubgroup _ _),
    ?_⟩
  simp only [Units.val_mul, ← mulVec_mulVec, transvectionUnit_mulVec]
  ext k
  rcases eq_or_ne k p with rfl | hkp
  · simp [Function.update_apply, hqp.symm]
  · rcases eq_or_ne k q with rfl | hkq
    · simp [Function.update_apply, hkp.symm]
    · simp [Function.update_apply, hkp, hkq]

/-- Over a Euclidean domain, as soon as there is a second index `q`, elementary row operations
reduce the `p`-th column of an invertible matrix to the `p`-th standard basis vector. -/
private theorem exists_mem_elementarySubgroup_mul_apply_eq_single {p q : n} (hqp : q ≠ p)
    (g : GL n R) :
    ∃ e ∈ elementarySubgroup n R,
      (fun i ↦ ((e * g : GL n R) : Matrix n n R) i p) = Pi.single p 1 := by
  have hcol (e g : GL n R) : (fun i ↦ ((e * g : GL n R) : Matrix n n R) i p) =
      (e : Matrix n n R) *ᵥ fun i ↦ (g : Matrix n n R) i p := by
    ext i
    simp [Matrix.mul_apply, mulVec, dotProduct]
  obtain ⟨e, he, d, hd⟩ := exists_mem_elementarySubgroup_mulVec_eq_single
    (fun i ↦ (g : Matrix n n R) i p) p
  -- The surviving entry `d` is a unit: the `(p, p)` entry of `(e g)⁻¹ (e g) = 1` is `x d`.
  have hd' : IsUnit d := by
    have h := congr_fun₂ (Units.inv_mul (e * g)) p p
    rw [Matrix.mul_apply] at h
    have hcol' := congr_fun ((hcol e g).trans hd)
    simp only [hcol', Pi.single_apply, mul_ite, mul_zero, Finset.sum_ite_eq',
      Finset.mem_univ, ite_true, one_apply_eq] at h
    exact IsUnit.of_mul_eq_one_right _ h
  obtain ⟨e', he', he'd⟩ :=
    exists_mem_elementarySubgroup_mulVec_single_eq_single_one hqp hd'.unit
  refine ⟨e' * e, mul_mem he' he, ?_⟩
  rw [mul_assoc, hcol, hcol, hd]
  exact he'd

end Column

/-- The inductive step of elementary generation: if every determinant-one matrix indexed by a
nonempty type `m` is elementary, so is every determinant-one matrix indexed by `m ⊕ Fin 1`. The
last column is cleared to a basis vector by row operations, the last row is then cleared by a
lower block unipotent matrix, and what remains is a determinant-one block `a ⊕ 1`. -/
private theorem mem_elementarySubgroup_sum_of_det_eq_one {m : Type*} [DecidableEq m] [Fintype m]
    [Nonempty m]
    (hm : ∀ g : GL m R, GeneralLinearGroup.det g = 1 → g ∈ elementarySubgroup m R)
    {g : GL (m ⊕ Fin 1) R} (hg : GeneralLinearGroup.det g = 1) :
    g ∈ elementarySubgroup (m ⊕ Fin 1) R := by
  obtain ⟨e, he, hcol⟩ := exists_mem_elementarySubgroup_mul_apply_eq_single
    (Sum.inl_ne_inr (a := Classical.arbitrary m) (b := (0 : Fin 1))) g
  set h := e * g with h_def
  set C : Matrix (Fin 1) m R := toBlocks₂₁ (h : Matrix (m ⊕ Fin 1) (m ⊕ Fin 1) R)
  set A : Matrix m m R := toBlocks₁₁ (h : Matrix (m ⊕ Fin 1) (m ⊕ Fin 1) R)
  have hB : toBlocks₁₂ (h : Matrix (m ⊕ Fin 1) (m ⊕ Fin 1) R) = 0 := by
    ext i j
    simpa [toBlocks₁₂, Fin.fin_one_eq_zero j] using congr_fun hcol (Sum.inl i)
  have hD : toBlocks₂₂ (h : Matrix (m ⊕ Fin 1) (m ⊕ Fin 1) R) = 1 := by
    ext i j
    fin_cases i
    fin_cases j
    simpa [toBlocks₂₂] using congr_fun hcol (Sum.inr 0)
  have hh : (h : Matrix (m ⊕ Fin 1) (m ⊕ Fin 1) R) = fromBlocks A 0 C 1 := by
    rw [← hB, ← hD]
    exact (fromBlocks_toBlocks _).symm
  -- Clearing the last row leaves the block diagonal matrix `A ⊕ 1`.
  have hk : ((h * lowerBlockGL (-C) : GL (m ⊕ Fin 1) R) : Matrix (m ⊕ Fin 1) (m ⊕ Fin 1) R) =
      fromBlocks A 0 0 1 := by
    rw [Units.val_mul, coe_lowerBlockGL, hh, fromBlocks_multiply]
    simp
  have hL : lowerBlockGL (-C) ∈ elementarySubgroup (m ⊕ Fin 1) R :=
    lowerBlockGL_mem_elementarySubgroup _
  have hA : A.det = 1 := by
    have hdet : GeneralLinearGroup.det (h * lowerBlockGL (-C)) = 1 := by
      rw [h_def, map_mul, map_mul, hg, elementarySubgroup_le_ker_det he,
        elementarySubgroup_le_ker_det hL, mul_one, one_mul]
    have h' := congrArg Units.val hdet
    rw [GeneralLinearGroup.val_det_apply, hk, det_fromBlocks_zero₁₂] at h'
    simpa using h'
  set a := GeneralLinearGroup.mk'' A (by rw [hA]; exact isUnit_one)
  have ha : a ∈ elementarySubgroup m R :=
    hm a (Units.ext (by simp [a, GeneralLinearGroup.val_det_apply, hA]))
  have hblock : h * lowerBlockGL (-C) = fromBlocksGL (a, 1) :=
    Units.ext (by rw [hk, coe_fromBlocksGL]; rfl)
  have hblock_mem : fromBlocksGL (a, 1) ∈ elementarySubgroup (m ⊕ Fin 1) R :=
    map_elementarySubgroup_le_elementarySubgroup ⟨a, ha, rfl⟩
  have hg' : g = e⁻¹ * (h * lowerBlockGL (-C)) * (lowerBlockGL (-C))⁻¹ := by
    rw [h_def]
    group
  rw [hg', hblock]
  exact mul_mem (mul_mem (inv_mem he) hblock_mem) (inv_mem hL)

/-- Elementary generation in the standard sizes `Fin m`, by induction on `m`. -/
private theorem mem_elementarySubgroup_fin_of_det_eq_one :
    ∀ (m : ℕ) {g : GL (Fin m) R}, GeneralLinearGroup.det g = 1 →
      g ∈ elementarySubgroup (Fin m) R
  | 0, g, _ => by
    rw [Subsingleton.elim g 1]
    exact one_mem _
  | 1, g, hg => by
    have : g = 1 := by
      ext i j
      have h := congrArg Units.val hg
      simp only [GeneralLinearGroup.val_det_apply, det_fin_one, Units.val_one] at h
      simp [Fin.fin_one_eq_zero i, Fin.fin_one_eq_zero j, h]
    rw [this]
    exact one_mem _
  | m + 2, g, hg => by
    have hm := mem_elementarySubgroup_sum_of_det_eq_one
      (fun g' hg' ↦ mem_elementarySubgroup_fin_of_det_eq_one (m + 1) hg')
      (g := (finSumFinEquiv (m := m + 1) (n := 1)).symm.reindexGL R g) (by simp [hg])
    rw [← (finSumFinEquiv (m := m + 1) (n := 1)).map_reindexGL_elementarySubgroup]
    exact ⟨_, hm, by simp⟩

variable {n : Type*} [DecidableEq n] [Fintype n]

/-- **Elementary generation over a Euclidean domain.** Over a Euclidean domain, an invertible
matrix is a product of elementary matrices exactly when its determinant is one, in every finite
size: `E n R = SL n R`. In particular this holds over `ℤ` and over every field. -/
theorem elementarySubgroup_eq_ker_det_of_euclideanDomain :
    elementarySubgroup n R = GeneralLinearGroup.det.ker := by
  refine le_antisymm elementarySubgroup_le_ker_det fun g hg ↦ ?_
  rw [← (Fintype.equivFin n).symm.map_reindexGL_elementarySubgroup]
  exact ⟨(Fintype.equivFin n).reindexGL R g, mem_elementarySubgroup_fin_of_det_eq_one _
    (by rwa [Equiv.det_reindexGL]), by simp⟩

end EuclideanDomain

end TauCeti
