module

public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Stable
public import Mathlib.RingTheory.Ideal.Quotient.Defs

/-!
# Relative Whitehead lemma

For an ideal `I` of a ring `R`, the stable elementary subgroup relative to `I` is generated by
conjugates of transvections with parameters in `I`. Conjugation in the stable general linear
group gives the same subgroup as conjugation in the stable elementary group. If an invertible
matrix reduces to the identity modulo `I`, its stable commutator with any invertible matrix
belongs to this relative elementary subgroup (for two-sided `I`). This is the commutator
inclusion that makes relative algebraic `K₁` abelian.

The proof uses the doubled block construction of the Relative Whitehead Lemma in Weibel,
*The K-book*, Chapter III, Lemma 2.1.
-/

public section

noncomputable section

open Matrix Matrix.GeneralLinearGroup
open scoped commutatorElement

namespace TauCeti.StableGeneralLinearGroup

variable {R : Type*} [Ring R]

/-- The stable transvections whose off-diagonal parameters belong to `I`. -/
def relativeTransvections (I : Ideal R) : Set (StableGeneralLinearGroup R) :=
  {g | ∃ p, ∃ a ∈ I, stableTransvection p a = g}

/-- Membership in the set of relative transvections specifies an index pair and a parameter. -/
@[simp]
theorem mem_relativeTransvections {I : Ideal R} {g : StableGeneralLinearGroup R} :
    g ∈ relativeTransvections I ↔ ∃ p, ∃ a ∈ I, stableTransvection p a = g :=
  (Iff.rfl)

/-- The stable elementary subgroup relative to `I`, viewed inside the stable general linear
group. It is also the normal closure inside the stable elementary group, as expressed by
`relativeElementarySubgroup_eq_map_normalClosure`. -/
def relativeElementarySubgroup (I : Ideal R) : Subgroup (StableGeneralLinearGroup R) :=
  Subgroup.normalClosure (relativeTransvections I)

/-- The relative elementary subgroup is normal in the stable general linear group. -/
instance (I : Ideal R) : (relativeElementarySubgroup I).Normal := by
  unfold relativeElementarySubgroup
  infer_instance

/-- Characterize containment of the relative elementary subgroup in a normal subgroup by
testing transvections with parameters in `I`. -/
theorem relativeElementarySubgroup_le_iff (I : Ideal R)
    {H : Subgroup (StableGeneralLinearGroup R)} [H.Normal] :
    relativeElementarySubgroup I ≤ H ↔ ∀ p a, a ∈ I → stableTransvection p a ∈ H := by
  rw [relativeElementarySubgroup, ← Subgroup.normalClosure_subset_iff]
  constructor
  · intro h p a ha
    exact h ⟨p, a, ha, rfl⟩
  · rintro h _ ⟨p, a, ha, rfl⟩
    exact h p a ha

/-- A stable transvection with parameter in `I` belongs to the relative elementary subgroup. -/
theorem stableTransvection_mem_relativeElementarySubgroup (I : Ideal R)
    (p : {p : ℕ × ℕ // p.1 ≠ p.2}) {a : R} (ha : a ∈ I) :
    stableTransvection p a ∈ relativeElementarySubgroup I :=
  Subgroup.subset_normalClosure ⟨p, a, ha, rfl⟩

/-- An elementary transvection with parameter in `I` belongs to the stable relative elementary
subgroup. -/
theorem of_transvectionUnit_mem_relativeElementarySubgroup (I : Ideal R) {n : ℕ} {i j : Fin n}
    (hij : i ≠ j) {a : R} (ha : a ∈ I) :
    of R n (transvectionUnit hij a) ∈ relativeElementarySubgroup I := by
  have hne := Fin.val_injective.ne hij
  rw [← stableTransvection_eq_of ⟨(i.val, j.val), hne⟩ a i.isLt j.isLt]
  exact stableTransvection_mem_relativeElementarySubgroup I _ ha

/-- Relative elementary matrices are stably elementary. -/
theorem relativeElementarySubgroup_le_elementarySubgroup (I : Ideal R) :
    relativeElementarySubgroup I ≤ elementarySubgroup R :=
  (relativeElementarySubgroup_le_iff I).2 fun p a _ ↦ stableTransvection_mem_elementarySubgroup p a

private def doubled (n : ℕ) : GL (Fin n ⊕ Fin n) R →* StableGeneralLinearGroup R :=
  (of R (n + n)).comp (finSumFinEquiv.reindexGL R).toMonoidHom

private theorem doubled_fromBlocksGL_one {n : ℕ} (u : GL (Fin n) R) :
    doubled n (fromBlocksGL (u, 1)) = of R n u := by
  simp only [doubled, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    ← stabilizeGL_eq_reindexGL_fromBlocksGL, of_stabilizeGL]

private theorem doubled_mem_elementarySubgroup {n : ℕ} {e : GL (Fin n ⊕ Fin n) R}
    (he : e ∈ TauCeti.elementarySubgroup (Fin n ⊕ Fin n) R) :
    doubled n e ∈ elementarySubgroup R :=
  of_mem_elementarySubgroup <| by
    rw [← finSumFinEquiv.map_reindexGL_elementarySubgroup]
    exact Subgroup.mem_map_of_mem _ he

-- In the doubled representation the unused block absorbs the inverse of the conjugating matrix.
private theorem exists_elementary_conj (g e : StableGeneralLinearGroup R) :
    ∃ d : elementarySubgroup R, (d : StableGeneralLinearGroup R) * e * (d : _)⁻¹ = g * e * g⁻¹ := by
  obtain ⟨n, u, v, rfl, rfl⟩ := exists_of₂ g e
  refine ⟨⟨_, doubled_mem_elementarySubgroup (fromBlocksGL_inv_mem_elementarySubgroup u)⟩, ?_⟩
  have h : fromBlocksGL (u, u⁻¹) * fromBlocksGL (v, (1 : GL (Fin n) R)) *
      (fromBlocksGL (u, u⁻¹))⁻¹ = fromBlocksGL (u * v * u⁻¹, (1 : GL (Fin n) R)) := by
    simp only [← map_inv, ← map_mul, Prod.mk_mul_mk, Prod.inv_mk, mul_one, inv_mul_cancel, inv_inv]
  calc
    _ = doubled n (fromBlocksGL (u, u⁻¹)) * of R n v * (doubled n (fromBlocksGL (u, u⁻¹)))⁻¹ := rfl
    _ = doubled n (fromBlocksGL (u * v * u⁻¹, 1)) := by
      rw [← doubled_fromBlocksGL_one v, ← map_inv, ← map_mul, ← map_mul, h]
    _ = _ := by rw [doubled_fromBlocksGL_one, map_mul, map_mul, map_inv]

/-- The normal closure defining the relative elementary subgroup can be taken in the stable
elementary subgroup rather than the stable general linear group. -/
theorem relativeElementarySubgroup_eq_map_normalClosure (I : Ideal R) :
    relativeElementarySubgroup I =
      (Subgroup.normalClosure ((elementarySubgroup R).subtype ⁻¹' relativeTransvections I)).map
        (elementarySubgroup R).subtype := by
  rw [relativeElementarySubgroup]
  refine le_antisymm ((Subgroup.closure_le _).2 ?_) ?_
  · intro x hx
    obtain ⟨e, he, hc⟩ := Group.mem_conjugatesOfSet_iff.1 hx
    obtain ⟨g, rfl⟩ := isConj_iff.1 hc
    obtain ⟨d, hd⟩ := exists_elementary_conj g e
    have he' : e ∈ elementarySubgroup R := by
      obtain ⟨p, a, _, rfl⟩ := he
      exact stableTransvection_mem_elementarySubgroup p a
    let t : elementarySubgroup R := ⟨e, he'⟩
    have ht : t ∈
        Subgroup.normalClosure ((elementarySubgroup R).subtype ⁻¹' relativeTransvections I) :=
      Subgroup.subset_normalClosure he
    exact ⟨d * t * d⁻¹, Subgroup.Normal.conj_mem t ht d, hd⟩
  · exact Subgroup.map_le_iff_le_comap.2
      (Subgroup.normalClosure_le_normal fun _ hx ↦ Subgroup.subset_normalClosure hx)

private theorem doubled_transvectionUnit_mem_relativeElementarySubgroup (I : Ideal R) {n : ℕ}
    {i j : Fin n ⊕ Fin n} (hij : i ≠ j) {a : R} (ha : a ∈ I) :
    doubled n (transvectionUnit hij a) ∈ relativeElementarySubgroup I := by
  simp only [doubled, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    Equiv.reindexGL_transvectionUnit]
  exact of_transvectionUnit_mem_relativeElementarySubgroup I _ ha

-- Induct over a matrix valued in the ideal, so cancellation in the additive step does not
-- lose the information that the individual summands have entries in the ideal.
private theorem doubled_block_mem_relativeElementarySubgroup (I : Ideal R) {n : ℕ}
    (X : Matrix (Fin n) (Fin n) I) :
    doubled n (upperBlockGL (X.map Subtype.val)) ∈ relativeElementarySubgroup I ∧
    doubled n (lowerBlockGL (X.map Subtype.val)) ∈ relativeElementarySubgroup I := by
  classical
  induction X using Matrix.induction_on' with
  | h_zero => simp
  | h_add X Y hX hY =>
    have h : (X + Y).map Subtype.val = X.map Subtype.val + Y.map Subtype.val := rfl
    simpa only [h, upperBlockGL_add, lowerBlockGL_add, map_mul] using
      And.intro (mul_mem hX.1 hY.1) (mul_mem hX.2 hY.2)
  | h_std_basis i j a =>
    constructor
    · convert doubled_transvectionUnit_mem_relativeElementarySubgroup I
        (Sum.inl_ne_inr (a := i) (b := j)) a.property using 2
      ext (p | p) (q | q) <;>
        simp [coe_transvectionUnit_eq_one_add_single, single_apply, Matrix.one_apply]
      split_ifs <;> simp
    · convert doubled_transvectionUnit_mem_relativeElementarySubgroup I
        (Sum.inr_ne_inl (a := j) (b := i)) a.property using 2
      ext (p | p) (q | q) <;>
        simp [coe_transvectionUnit_eq_one_add_single, single_apply, Matrix.one_apply]
      split_ifs <;> simp

private theorem doubled_fromBlocksGL_inv_mem_relativeElementarySubgroup (I : Ideal R)
    [I.IsTwoSided] {n : ℕ} (u : GL (Fin n) R)
    (hu : Units.map (Ideal.Quotient.mk I).mapMatrix.toMonoidHom u = 1) :
    doubled n (fromBlocksGL (u, u⁻¹)) ∈ relativeElementarySubgroup I := by
  let q := (QuotientGroup.mk' (relativeElementarySubgroup I)).comp (doubled (R := R) n)
  have hU (X Y : Matrix (Fin n) (Fin n) R) (h : ∀ i j, X i j - Y i j ∈ I) :
      q (upperBlockGL X) = q (upperBlockGL Y) := by
    apply eq_of_mul_inv_eq_one
    rw [← map_inv, ← map_mul, upperBlockGL_inv, ← upperBlockGL_add, ← sub_eq_add_neg]
    exact (QuotientGroup.eq_one_iff _).2
      (doubled_block_mem_relativeElementarySubgroup I (Matrix.of fun i j ↦ ⟨_, h i j⟩)).1
  have hL (X Y : Matrix (Fin n) (Fin n) R) (h : ∀ i j, X i j - Y i j ∈ I) :
      q (lowerBlockGL X) = q (lowerBlockGL Y) := by
    apply eq_of_mul_inv_eq_one
    rw [← map_inv, ← map_mul, lowerBlockGL_inv, ← lowerBlockGL_add, ← sub_eq_add_neg]
    exact (QuotientGroup.eq_one_iff _).2
      (doubled_block_mem_relativeElementarySubgroup I (Matrix.of fun i j ↦ ⟨_, h i j⟩)).2
  have hentry (v : GL (Fin n) R)
      (hv : Units.map (Ideal.Quotient.mk I).mapMatrix.toMonoidHom v = 1) (i j) :
      (v : Matrix (Fin n) (Fin n) R) i j - (1 : Matrix (Fin n) (Fin n) R) i j ∈ I := by
    apply Ideal.Quotient.eq.1
    simpa [Matrix.one_apply] using congrArg (fun w : GL (Fin n) (R ⧸ I) ↦
      (w : Matrix (Fin n) (Fin n) (R ⧸ I)) i j) hv
  have hu' : Units.map (Ideal.Quotient.mk I).mapMatrix.toMonoidHom u⁻¹ = 1 := by
    rw [map_inv, hu, inv_one]
  have hneg (i j : Fin n) : (- (↑u⁻¹ : Matrix (Fin n) (Fin n) R)) i j -
      (-1 : Matrix (Fin n) (Fin n) R) i j ∈ I := by
    simpa only [Matrix.neg_apply, neg_sub_neg, neg_sub] using I.neg_mem (hentry u⁻¹ hu' i j)
  have hq : q (fromBlocksGL (u, u⁻¹)) = q (fromBlocksGL ((1 : GL (Fin n) R), 1⁻¹)) := by
    rw [fromBlocksGL_inv_eq u, fromBlocksGL_inv_eq (1 : GL (Fin n) R)]
    simp only [inv_one, Units.val_one, map_mul, hU _ _ (hentry u hu), hL _ _ hneg]
  have hone : fromBlocksGL ((1 : GL (Fin n) R), (1 : GL (Fin n) R)) = 1 := map_one _
  rw [inv_one, hone, map_one] at hq
  exact (QuotientGroup.eq_one_iff _).1 hq

private theorem commutatorElement_of_of_mem_relativeElementarySubgroup (I : Ideal R)
    [I.IsTwoSided] {n : ℕ} {u : GL (Fin n) R} (v : GL (Fin n) R)
    (hu : Units.map (Ideal.Quotient.mk I).mapMatrix.toMonoidHom u = 1) :
    ⁅of R n u, of R n v⁆ ∈ relativeElementarySubgroup I := by
  have heq : ⁅fromBlocksGL (u, u⁻¹), fromBlocksGL (v, (1 : GL (Fin n) R))⁆ =
      fromBlocksGL (⁅u, v⁆, (1 : GL (Fin n) R)) := by
    rw [← map_commutatorElement]
    simp [commutatorElement_def]
  rw [← map_commutatorElement, ← doubled_fromBlocksGL_one, ← heq, map_commutatorElement]
  exact Subgroup.commutator_le_left _ _ (Subgroup.commutator_mem_commutator
    (doubled_fromBlocksGL_inv_mem_relativeElementarySubgroup I u hu) (Subgroup.mem_top _))

/-- **Relative Whitehead lemma.** If `u` reduces to the identity modulo a two-sided ideal `I`,
its commutator with any element of the stable general linear group is relative elementary. -/
theorem commutatorElement_mem_relativeElementarySubgroup_of_map_eq_one (I : Ideal R)
    [I.IsTwoSided] {n : ℕ} {u : GL (Fin n) R} (g : StableGeneralLinearGroup R)
    (hu : Units.map (Ideal.Quotient.mk I).mapMatrix.toMonoidHom u = 1) :
    ⁅of R n u, g⁆ ∈ relativeElementarySubgroup I := by
  obtain ⟨m, v, rfl⟩ := exists_of g
  obtain ⟨k, hnk, hmk⟩ := exists_ge_ge n m
  rw [← of_stabilizeGL hnk u, ← of_stabilizeGL hmk v]
  apply commutatorElement_of_of_mem_relativeElementarySubgroup
  rw [← stabilizeGL_map, hu, map_one]

end TauCeti.StableGeneralLinearGroup
