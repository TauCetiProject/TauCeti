/-!
# Determinants, the special Whitehead group, and computations of algebraic `K₁`

Over a commutative ring `R`, stabilization `u ↦ u ⊕ 1` preserves determinants
(`TauCeti.det_stabilizeGL`). Passing to the direct limit and its abelianization yields surjective
determinant homomorphisms `det : GL_∞(R) →* Rˣ` and `det : K₁(R) →* Rˣ`, both split by the `1 × 1`
unit embedding `ofUnits R : Rˣ →* K₁(R)`.

The kernel of `det : K₁(R) →* Rˣ` is the **special Whitehead group** `SK₁(R)`
(`TauCeti.specialAlgebraicK1 R`). Every class in `SK₁(R)` is represented by a matrix in `SLₙ(R)` of
some finite size (`TauCeti.specialAlgebraicK1.exists_mkSpecial`), and projecting `K₁(R)` onto
`SK₁(R)` along `ofUnits R` corresponds at finite matrix size to rescaling the first column by
`(det u)⁻¹` via `TauCeti.detOneRescale` (`TauCeti.specialAlgebraicK1.coe_projection_mk`). Combining
the determinant and this projection yields the natural direct-product decomposition
`K₁(R) ≃* Rˣ × SK₁(R)` (`TauCeti.AlgebraicK1.unitsProdSpecialEquiv`).

Whenever `SLₙ(R)` is generated by elementary transvections for cofinally many sizes `n` (including
rings such as `k[x, y]` where `SL₂ ≠ E₂` by Cohn's example while `SLₙ = Eₙ` for `n ≥ 3` by
Suslin's theorem), `SK₁(R)` vanishes
(`TauCeti.specialAlgebraicK1_eq_bot_of_forall_exists_ge_closure_eq_top`)
and the determinant is a group isomorphism `K₁(R) ≃* Rˣ`
(`TauCeti.AlgebraicK1.detEquivOfSpecialEqBot`). Specializing via
`TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Elementary` gives `SK₁(ℤ) = ⊥` and `K₁(ℤ) ≃* ℤˣ`
(`TauCeti.AlgebraicK1.detEquivInt`, generated by `ofUnits ℤ (-1)` of order `2`), as well as
`SK₁(K) = ⊥` and `K₁(K) ≃* Kˣ` for every field `K` (`TauCeti.AlgebraicK1.detEquivOfField`). Over
`ℤ`, the `1 × 1` matrix `-1` lifts across every unital ring homomorphism `A →+* ℤ` yet defines a
nontrivial class in `K₁(ℤ)`, whereas `-I₂` lies in `E₂(ℤ)` and has trivial class in `K₁(ℤ)`
(Weibel, Chapter III, Remark 1.2.3).

## Main definitions

* `TauCeti.StableGeneralLinearGroup.det`: the stabilized determinant `GL_∞(R) →* Rˣ`.
* `TauCeti.AlgebraicK1.det`: the determinant homomorphism `K₁(R) →* Rˣ`.
* `TauCeti.stabilizeSL`: stabilization `SL (Fin m) R →* SL (Fin n) R` for `m ≤ n`.
* `TauCeti.specialAlgebraicK1`: the special Whitehead group `SK₁(R) = ker(det : K₁(R) →* Rˣ)`.
* `TauCeti.AlgebraicK1.mkSpecial`: the class map `SL (Fin n) R →* SK₁(R)`.
* `TauCeti.specialAlgebraicK1.projection`: the splitting projection `K₁(R) →* SK₁(R)` along
  `ofUnits R`.
* `TauCeti.specialAlgebraicK1.map`: functoriality of `SK₁` along ring homomorphisms.
* `TauCeti.AlgebraicK1.unitsProdSpecialEquiv`: the natural splitting `K₁(R) ≃* Rˣ × SK₁(R)`.
* `TauCeti.AlgebraicK1.detEquivOfSpecialEqBot`: the determinant isomorphism `K₁(R) ≃* Rˣ` when
  `SK₁(R) = ⊥`.
* `TauCeti.AlgebraicK1.detEquivInt`, `TauCeti.AlgebraicK1.detEquivOfField`: the determinant
  isomorphisms `K₁(ℤ) ≃* ℤˣ` and `K₁(K) ≃* Kˣ`.

## Main results

* `TauCeti.det_stabilizeGL`: stabilization preserves determinants.
* `TauCeti.AlgebraicK1.det_ofUnits`, `TauCeti.AlgebraicK1.ofUnits_injective`,
  `TauCeti.AlgebraicK1.det_surjective`: `ofUnits R` splits `AlgebraicK1.det R`.
* `TauCeti.specialAlgebraicK1.exists_mkSpecial`: every element of `SK₁(R)` comes from `SLₙ(R)` for
  some `n`.
* `TauCeti.specialAlgebraicK1.coe_projection_mk`: on `mk R n u`, the `SK₁(R)` projection is
  represented by `TauCeti.detOneRescale u`.
* `TauCeti.AlgebraicK1.unitsProdSpecialEquiv_map`: naturality of `K₁(R) ≃* Rˣ × SK₁(R)`.
* `TauCeti.specialAlgebraicK1_eq_bot_of_forall_exists_ge_closure_eq_top`: cofinal generation of
  `SLₙ(R)` by transvections implies `SK₁(R) = ⊥`.
* `TauCeti.specialAlgebraicK1_int_eq_bot`, `TauCeti.specialAlgebraicK1_of_field_eq_bot`:
  `SK₁(ℤ) = ⊥` and `SK₁(K) = ⊥` for fields.
* `TauCeti.AlgebraicK1.orderOf_ofUnits_neg_one_int`,
  `TauCeti.AlgebraicK1.exists_forall_lift_and_mk_ne_one_int`: `ofUnits ℤ (-1)` has order `2` in
  `K₁(ℤ)`, and `scalar (Fin 1) (-1)` lifts across every ring homomorphism `A →+* ℤ` yet defines a
  nontrivial class in `K₁(ℤ)`.

## References

* J. Milnor, *Introduction to Algebraic K-Theory*, Annals of Mathematics Studies 72 (1971), §3.
* J. Rosenberg, *Algebraic K-Theory and Its Applications*, GTM 147 (1994), §2.2, Proposition
  2.2.2 and Corollary 2.2.4.
* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, GSM 145 (2013), Chapter III,
  §1, Lemma 1.2.1, Remark 1.2.3, Example 1.3.5, and Exercise 1.5.
-/

public section

noncomputable section

open Matrix

namespace TauCeti

section CommRing

variable {R : Type*} [CommRing R]

/-! ## Stabilized determinants -/

/-- Stabilization preserves the determinant of an invertible matrix. -/
@[simp]
theorem det_stabilizeGL {m n : ℕ} (h : m ≤ n) (u : GL (Fin m) R) :
    Matrix.GeneralLinearGroup.det (stabilizeGL R h u) = Matrix.GeneralLinearGroup.det u := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [stabilizeGL_eq_reindexGL_fromBlocksGL]
  exact Units.ext (by simp [Matrix.det_submatrix_equiv_self])

namespace StableGeneralLinearGroup

variable (R) in
/-- The **stabilized determinant** homomorphism `GL_∞(R) →* Rˣ` over a commutative ring `R`. -/
def det : StableGeneralLinearGroup R →* Rˣ :=
  lift (fun _ ↦ Matrix.GeneralLinearGroup.det) fun _ _ h u ↦ det_stabilizeGL h u

/-- On a finite-size matrix, the stabilized determinant agrees with the matrix determinant. -/
@[simp]
theorem det_of (n : ℕ) (u : GL (Fin n) R) :
    det R (of R n u) = Matrix.GeneralLinearGroup.det u :=
  lift_of ..

/-- Composition form of `TauCeti.StableGeneralLinearGroup.det_of`. -/
theorem det_comp_of (n : ℕ) :
    (det R).comp (of R n) = Matrix.GeneralLinearGroup.det :=
  MonoidHom.ext (det_of n)

/-- `StableGeneralLinearGroup.ofUnits R` is a right inverse of `StableGeneralLinearGroup.det R`. -/
@[simp]
theorem det_ofUnits (u : Rˣ) : det R (ofUnits R u) = u := by
  rw [ofUnits_def, det_of, Matrix.GeneralLinearGroup.det_scalar, Fintype.card_fin, pow_one]

/-- Composition form of `TauCeti.StableGeneralLinearGroup.det_ofUnits`. -/
@[simp]
theorem det_comp_ofUnits : (det R).comp (ofUnits R) = MonoidHom.id Rˣ :=
  MonoidHom.ext det_ofUnits

/-- Over a commutative ring, the stabilized determinant `GL_∞(R) →* Rˣ` is surjective. -/
theorem det_surjective : Function.Surjective (det R) :=
  Function.RightInverse.surjective det_ofUnits

end StableGeneralLinearGroup

namespace AlgebraicK1

variable (R) in
/-- The **determinant homomorphism** `K₁(R) →* Rˣ` over a commutative ring `R`. -/
def det : AlgebraicK1 R →* Rˣ :=
  lift (fun _ ↦ Matrix.GeneralLinearGroup.det) fun _ _ h u ↦ det_stabilizeGL h u

/-- On the class of an invertible matrix, `AlgebraicK1.det` is its matrix determinant. -/
@[simp]
theorem det_mk (n : ℕ) (u : GL (Fin n) R) :
    det R (mk R n u) = Matrix.GeneralLinearGroup.det u :=
  lift_mk ..

/-- Composition form of `TauCeti.AlgebraicK1.det_mk`. -/
theorem det_comp_mk (n : ℕ) :
    (det R).comp (mk R n) = Matrix.GeneralLinearGroup.det :=
  MonoidHom.ext (det_mk n)

/-- `AlgebraicK1.det` factors `StableGeneralLinearGroup.det` through the abelianization map. -/
@[simp]
theorem det_abelianizationOf (x : StableGeneralLinearGroup R) :
    det R (Group.Abelianization.of x) = StableGeneralLinearGroup.det R x := by
  obtain ⟨n, u, rfl⟩ := StableGeneralLinearGroup.exists_of x
  rw [abelianizationOf_of, det_mk, StableGeneralLinearGroup.det_of]

/-- `AlgebraicK1.ofUnits R` splits `AlgebraicK1.det R`. -/
@[simp]
theorem det_ofUnits (u : Rˣ) : det R (ofUnits R u) = u := by
  rw [ofUnits_def, det_mk, Matrix.GeneralLinearGroup.det_scalar, Fintype.card_fin, pow_one]

/-- Composition form of `TauCeti.AlgebraicK1.det_ofUnits`. -/
@[simp]
theorem det_comp_ofUnits : (det R).comp (ofUnits R) = MonoidHom.id Rˣ :=
  MonoidHom.ext det_ofUnits

/-- Over a commutative ring, `ofUnits R : Rˣ →* K₁(R)` is injective. -/
theorem ofUnits_injective : Function.Injective (ofUnits R) :=
  Function.LeftInverse.injective det_ofUnits

/-- Over a commutative ring, `det R : K₁(R) →* Rˣ` is surjective. -/
theorem det_surjective : Function.Surjective (det R) :=
  Function.RightInverse.surjective det_ofUnits

section DetMap

variable {S : Type*} [CommRing S]

/-- Composition form of naturality for `TauCeti.AlgebraicK1.det`. -/
theorem det_comp_map (f : R →+* S) :
    (det S).comp (map f) = (Units.map (f : R →* S)).comp (det R) := by
  refine hom_ext fun n ↦ MonoidHom.ext fun u ↦ ?_
  simp only [MonoidHom.comp_apply, map_mk, det_mk]
  exact Matrix.GeneralLinearGroup.map_det f u

/-- `TauCeti.AlgebraicK1.det` commutes with ring homomorphisms. -/
@[simp]
theorem det_map (f : R →+* S) (x : AlgebraicK1 R) :
    det S (map f x) = Units.map (f : R →* S) (det R x) :=
  DFunLike.congr_fun (det_comp_map f) x

end DetMap

end AlgebraicK1

/-! ## Stabilization in the special linear group and the special Whitehead group `SK₁` -/

variable (R) in
/-- The **special-linear stabilization homomorphism** `g ↦ g ⊕ 1` from `SL (Fin m) R` to
`SL (Fin n) R`, for `m ≤ n`. -/
def stabilizeSL {m n : ℕ} (h : m ≤ n) :
    SpecialLinearGroup (Fin m) R →* SpecialLinearGroup (Fin n) R :=
  SpecialLinearGroup.toGLKerEquiv.symm.toMonoidHom.comp <|
    ((stabilizeGL R h).comp SpecialLinearGroup.toGL).codRestrict
      Matrix.GeneralLinearGroup.det.ker fun g ↦ by
        rw [MonoidHom.mem_ker, MonoidHom.comp_apply, det_stabilizeGL,
          SpecialLinearGroup.coeToGL_det]

/-- Stabilization of special-linear matrices commutes with the inclusion into `GL`. -/
@[simp]
theorem toGL_stabilizeSL {m n : ℕ} (h : m ≤ n) (g : SpecialLinearGroup (Fin m) R) :
    SpecialLinearGroup.toGL (stabilizeSL R h g) = stabilizeGL R h g :=
  Units.ext (by simp [stabilizeSL])

/-- Special-linear stabilization to the same size is the identity. -/
@[simp]
theorem stabilizeSL_refl (n : ℕ) :
    stabilizeSL R (le_refl n) = MonoidHom.id (SpecialLinearGroup (Fin n) R) := by
  ext1 g
  exact SpecialLinearGroup.toGL_injective (by simp)

/-- Special-linear stabilizations compose. -/
@[simp]
theorem stabilizeSL_stabilizeSL {k m n : ℕ} (hkm : k ≤ m) (hmn : m ≤ n)
    (g : SpecialLinearGroup (Fin k) R) :
    stabilizeSL R hmn (stabilizeSL R hkm g) = stabilizeSL R (hkm.trans hmn) g :=
  SpecialLinearGroup.toGL_injective (by simp)

/-- Special-linear stabilization is injective. -/
theorem stabilizeSL_injective {m n : ℕ} (h : m ≤ n) : Function.Injective (stabilizeSL R h) := by
  intro g₁ g₂ huv
  apply SpecialLinearGroup.toGL_injective
  apply stabilizeGL_injective h
  simpa only [toGL_stabilizeSL] using congrArg SpecialLinearGroup.toGL huv

variable (R) in
/-- The **special Whitehead group** `SK₁(R)` of a commutative ring `R`: the kernel of the
determinant homomorphism `det : K₁(R) →* Rˣ`. -/
def specialAlgebraicK1 : Subgroup (AlgebraicK1 R) :=
  (AlgebraicK1.det R).ker

variable (R) in
/-- `specialAlgebraicK1 R` is the kernel of `AlgebraicK1.det R`. -/
theorem specialAlgebraicK1_def : specialAlgebraicK1 R = (AlgebraicK1.det R).ker :=
  (rfl)

/-- A class in `K₁(R)` belongs to `SK₁(R)` if and only if its determinant is `1`. -/
@[simp]
theorem mem_specialAlgebraicK1_iff {x : AlgebraicK1 R} :
    x ∈ specialAlgebraicK1 R ↔ AlgebraicK1.det R x = 1 :=
  MonoidHom.mem_ker

/-- Every element of `SK₁(R)` has determinant `1` when coerced to `K₁(R)`. -/
@[simp]
theorem AlgebraicK1.det_coe_specialAlgebraicK1 (x : specialAlgebraicK1 R) :
    AlgebraicK1.det R x = 1 :=
  x.2

/-- An invertible matrix represents an element of `SK₁(R)` if and only if its determinant is `1`. -/
theorem AlgebraicK1.mk_mem_specialAlgebraicK1_iff {n : ℕ} {u : GL (Fin n) R} :
    AlgebraicK1.mk R n u ∈ specialAlgebraicK1 R ↔ Matrix.GeneralLinearGroup.det u = 1 := by
  rw [mem_specialAlgebraicK1_iff, AlgebraicK1.det_mk]

/-- A `1 × 1` unit class belongs to `SK₁(R)` if and only if the unit is `1`. -/
theorem AlgebraicK1.ofUnits_mem_specialAlgebraicK1_iff {u : Rˣ} :
    AlgebraicK1.ofUnits R u ∈ specialAlgebraicK1 R ↔ u = 1 := by
  rw [mem_specialAlgebraicK1_iff, AlgebraicK1.det_ofUnits]

namespace AlgebraicK1

variable (R) in
/-- Canonical homomorphism `SL (Fin n) R →* SK₁(R)` sending a determinant-one matrix to its class
in the special Whitehead group. -/
def mkSpecial (n : ℕ) : SpecialLinearGroup (Fin n) R →* specialAlgebraicK1 R :=
  ((mk R n).comp SpecialLinearGroup.toGL).codRestrict (specialAlgebraicK1 R) fun g ↦ by simp

/-- Coercing `mkSpecial R n g` to `K₁(R)` gives the class of `g` viewed in `GL (Fin n) R`. -/
@[simp]
theorem coe_mkSpecial (n : ℕ) (g : SpecialLinearGroup (Fin n) R) :
    (mkSpecial R n g : AlgebraicK1 R) = mk R n g :=
  (rfl)

/-- `mkSpecial` is invariant under special-linear stabilization. -/
@[simp]
theorem mkSpecial_stabilizeSL {m n : ℕ} (h : m ≤ n) (g : SpecialLinearGroup (Fin m) R) :
    mkSpecial R n (stabilizeSL R h g) = mkSpecial R m g := by
  ext
  simp

/-- A special-linear matrix has trivial class in `SK₁(R)` if and only if some stabilization of it
in `GL` lies in the elementary subgroup. -/
theorem mkSpecial_eq_one_iff {n : ℕ} {g : SpecialLinearGroup (Fin n) R} :
    mkSpecial R n g = 1 ↔
      ∃ k, ∃ h : n ≤ k, stabilizeGL R h g ∈ TauCeti.elementarySubgroup (Fin k) R := by
  rw [← Subtype.coe_inj, Subgroup.coe_one, coe_mkSpecial, mk_eq_one_iff]

end AlgebraicK1

namespace specialAlgebraicK1

/-- Every element of `SK₁(R)` is the class of a special-linear matrix of some finite size. -/
theorem exists_mkSpecial (x : specialAlgebraicK1 R) :
    ∃ n g, AlgebraicK1.mkSpecial R n g = x := by
  obtain ⟨n, u, hu⟩ := AlgebraicK1.exists_mk (x : AlgebraicK1 R)
  have hdet : u ∈ (Matrix.GeneralLinearGroup.det : GL (Fin n) R →* Rˣ).ker := by
    rw [MonoidHom.mem_ker, ← AlgebraicK1.det_mk, hu, AlgebraicK1.det_coe_specialAlgebraicK1]
  rw [← SpecialLinearGroup.range_toGL_eq_ker_det] at hdet
  obtain ⟨g, rfl⟩ := hdet
  exact ⟨n, g, Subtype.ext hu⟩

/-- Homomorphisms out of `SK₁(R)` agree when they agree on `SL (Fin n) R` for every `n`. -/
@[ext]
theorem hom_ext {G : Type*} [MulOneClass G] {f₁ f₂ : specialAlgebraicK1 R →* G}
    (h : ∀ n, f₁.comp (AlgebraicK1.mkSpecial R n) = f₂.comp (AlgebraicK1.mkSpecial R n)) :
    f₁ = f₂ := by
  ext x
  obtain ⟨n, g, rfl⟩ := exists_mkSpecial x
  exact DFunLike.congr_fun (h n) g

/-! ## The determinant splitting `K₁(R) ≃* Rˣ × SK₁(R)` -/

variable (R) in
/-- Splitting projection `K₁(R) →* SK₁(R)` along `ofUnits R : Rˣ →* K₁(R)`, sending `x` to
`x * (ofUnits R (det R x))⁻¹`. -/
def projection : AlgebraicK1 R →* specialAlgebraicK1 R :=
  (MonoidHom.id (AlgebraicK1 R) / (AlgebraicK1.ofUnits R).comp (AlgebraicK1.det R)).codRestrict
    (specialAlgebraicK1 R) fun x ↦ by simp

/-- Coercing `projection R x` to `K₁(R)` multiplies `x` by `(ofUnits R (det R x))⁻¹`. -/
theorem coe_projection_apply (x : AlgebraicK1 R) :
    (projection R x : AlgebraicK1 R) = x * (AlgebraicK1.ofUnits R (AlgebraicK1.det R x))⁻¹ := by
  simp [projection, div_eq_mul_inv]

/-- `projection R` restricts to the identity on `SK₁(R)`. -/
@[simp]
theorem projection_coe (x : specialAlgebraicK1 R) : projection R x = x := by
  ext
  simp [coe_projection_apply]

/-- Composition form of `TauCeti.specialAlgebraicK1.projection_coe`. -/
@[simp]
theorem projection_comp_subtype :
    (projection R).comp (specialAlgebraicK1 R).subtype = MonoidHom.id (specialAlgebraicK1 R) :=
  MonoidHom.ext projection_coe

/-- `projection R` vanishes on the `1 × 1` unit classes. -/
@[simp]
theorem projection_ofUnits (u : Rˣ) : projection R (AlgebraicK1.ofUnits R u) = 1 := by
  ext
  simp [coe_projection_apply]

/-- Composition form of `TauCeti.specialAlgebraicK1.projection_ofUnits`. -/
@[simp]
theorem projection_comp_ofUnits :
    (projection R).comp (AlgebraicK1.ofUnits R) = 1 :=
  MonoidHom.ext projection_ofUnits

/-- Every class in `K₁(R)` factors as `ofUnits R (det R x)` times its `SK₁(R)` projection. -/
@[simp]
theorem ofUnits_det_mul_coe_projection (x : AlgebraicK1 R) :
    AlgebraicK1.ofUnits R (AlgebraicK1.det R x) * (projection R x : AlgebraicK1 R) = x := by
  rw [coe_projection_apply, mul_comm, inv_mul_cancel_right]

/-- On the class of an invertible matrix `u`, the projection onto `SK₁(R)` is represented by the
determinant-one rescaling `TauCeti.detOneRescale u` of its first column. -/
theorem coe_projection_mk (n : ℕ) (u : GL (Fin n) R) :
    (projection R (AlgebraicK1.mk R n u) : AlgebraicK1 R) =
      AlgebraicK1.mk R n (detOneRescale u) := by
  cases n with
  | zero =>
    have hdet : Matrix.GeneralLinearGroup.det u = 1 :=
      Units.ext (by simp [Matrix.GeneralLinearGroup.val_det_apply])
    rw [coe_projection_apply, AlgebraicK1.det_mk, hdet, detOneRescale_of_det_eq_one hdet,
      map_one, inv_one, mul_one]
  | succ m =>
    have hdiag : (fun i : Fin (m + 1) ↦
        if (i : ℕ) = 0 then (Matrix.GeneralLinearGroup.det u)⁻¹ else 1) =
          Pi.mulSingle 0 (Matrix.GeneralLinearGroup.det u)⁻¹ := by
      ext i
      rcases eq_or_ne i 0 with rfl | hi
      · simp
      · simp [hi]
    rw [detOneRescale_def, hdiag, map_mul, AlgebraicK1.mk_diagGL_mulSingle, map_inv,
      coe_projection_apply, AlgebraicK1.det_mk]

section Map

variable {S T : Type*} [CommRing S] [CommRing T]

/-- Homomorphism `SK₁(R) →* SK₁(S)` induced by a ring homomorphism `f : R →+* S`. -/
def map (f : R →+* S) : specialAlgebraicK1 R →* specialAlgebraicK1 S :=
  ((AlgebraicK1.map f).comp (specialAlgebraicK1 R).subtype).codRestrict
    (specialAlgebraicK1 S) fun x ↦ by simp

/-- `specialAlgebraicK1.map f` restricts `AlgebraicK1.map f` to `SK₁`. -/
@[simp]
theorem coe_map_apply (f : R →+* S) (x : specialAlgebraicK1 R) :
    (map f x : AlgebraicK1 S) = AlgebraicK1.map f x :=
  (rfl)

/-- `specialAlgebraicK1.map f` acts entrywise on special-linear matrix representatives. -/
@[simp]
theorem map_mkSpecial (f : R →+* S) (n : ℕ) (g : SpecialLinearGroup (Fin n) R) :
    map f (AlgebraicK1.mkSpecial R n g) =
      AlgebraicK1.mkSpecial S n (SpecialLinearGroup.map f g) := by
  ext
  simp only [coe_map_apply, AlgebraicK1.coe_mkSpecial, AlgebraicK1.map_mk]
  exact congrArg (AlgebraicK1.mk S n) (Units.ext (by ext i j; rfl))

/-- The splitting projection `K₁ →* SK₁` commutes with ring homomorphisms. -/
theorem map_projection (f : R →+* S) (x : AlgebraicK1 R) :
    map f (projection R x) = projection S (AlgebraicK1.map f x) := by
  ext
  simp [coe_projection_apply]

/-- The identity ring homomorphism induces the identity on `SK₁`. -/
@[simp]
theorem map_id : map (RingHom.id R) = MonoidHom.id (specialAlgebraicK1 R) :=
  MonoidHom.ext fun _ ↦ Subtype.ext (by simp)

/-- `SK₁` is functorial with respect to composition of ring homomorphisms. -/
theorem map_comp (f : R →+* S) (g : S →+* T) :
    map (g.comp f) = (map g).comp (map f) :=
  MonoidHom.ext fun _ ↦ Subtype.ext (by simp)

/-- Applying `specialAlgebraicK1.map f` followed by `specialAlgebraicK1.map g` equals
`specialAlgebraicK1.map (g.comp f)`. -/
@[simp]
theorem map_map (f : R →+* S) (g : S →+* T) (x : specialAlgebraicK1 R) :
    map g (map f x) = map (g.comp f) x := by
  rw [map_comp, MonoidHom.comp_apply]

end Map

end specialAlgebraicK1

namespace AlgebraicK1

variable (R) in
/-- **Determinant splitting of algebraic `K₁`.** Over a commutative ring `R`, the determinant
`K₁(R) →* Rˣ` and the splitting `ofUnits R : Rˣ →* K₁(R)` decompose `K₁(R)` as the direct product
`Rˣ × SK₁(R)`. -/
def unitsProdSpecialEquiv : AlgebraicK1 R ≃* Rˣ × specialAlgebraicK1 R :=
  MulEquiv.ofProdCoprod
    (det R)
    (specialAlgebraicK1.projection R)
    (ofUnits R)
    (specialAlgebraicK1 R).subtype
    (MonoidHom.ext specialAlgebraicK1.ofUnits_det_mul_coe_projection)
    det_comp_ofUnits
    (MonoidHom.ext det_coe_specialAlgebraicK1)
    specialAlgebraicK1.projection_comp_ofUnits
    specialAlgebraicK1.projection_comp_subtype

/-- `unitsProdSpecialEquiv` sends `x` to `(det R x, specialAlgebraicK1.projection R x)`. -/
@[simp]
theorem unitsProdSpecialEquiv_apply (x : AlgebraicK1 R) :
    unitsProdSpecialEquiv R x = (det R x, specialAlgebraicK1.projection R x) :=
  MulEquiv.ofProdCoprod_apply ..

/-- The inverse of `unitsProdSpecialEquiv` multiplies `ofUnits R p.1` by `p.2`. -/
@[simp]
theorem unitsProdSpecialEquiv_symm_apply (p : Rˣ × specialAlgebraicK1 R) :
    (unitsProdSpecialEquiv R).symm p = ofUnits R p.1 * p.2 :=
  MulEquiv.ofProdCoprod_symm_apply ..

/-- The decomposition `K₁(R) ≃* Rˣ × SK₁(R)` is natural with respect to ring homomorphisms. -/
theorem unitsProdSpecialEquiv_map {S : Type*} [CommRing S] (f : R →+* S) (x : AlgebraicK1 R) :
    unitsProdSpecialEquiv S (map f x) =
      Prod.map (Units.map (f : R →* S)) (specialAlgebraicK1.map f)
        (unitsProdSpecialEquiv R x) := by
  rw [unitsProdSpecialEquiv_apply, unitsProdSpecialEquiv_apply, Prod.map_apply, det_map,
    specialAlgebraicK1.map_projection]

end AlgebraicK1

/-! ## Vanishing of `SK₁` -/

/-- `SK₁(R)` is trivial if and only if `det R : K₁(R) →* Rˣ` is injective. -/
theorem specialAlgebraicK1_eq_bot_iff :
    specialAlgebraicK1 R = ⊥ ↔ Function.Injective (AlgebraicK1.det R) :=
  (AlgebraicK1.det R).ker_eq_bot_iff

/-- `det R : K₁(R) →* Rˣ` is bijective if and only if `SK₁(R)` is trivial. -/
theorem AlgebraicK1.bijective_det_iff_specialAlgebraicK1_eq_bot :
    Function.Bijective (AlgebraicK1.det R) ↔ specialAlgebraicK1 R = ⊥ := by
  rw [Function.Bijective, specialAlgebraicK1_eq_bot_iff, and_iff_left AlgebraicK1.det_surjective]

/-- When `SK₁(R)` is trivial, the determinant is a group isomorphism `K₁(R) ≃* Rˣ` with inverse
`TauCeti.AlgebraicK1.ofUnits R`. -/
def AlgebraicK1.detEquivOfSpecialEqBot (h : specialAlgebraicK1 R = ⊥) : AlgebraicK1 R ≃* Rˣ where
  toFun := AlgebraicK1.det R
  invFun := AlgebraicK1.ofUnits R
  left_inv x := by
    have hp : (specialAlgebraicK1.projection R x : AlgebraicK1 R) = 1 :=
      Subgroup.mem_bot.1 (h ▸ (specialAlgebraicK1.projection R x).2)
    simpa [hp] using specialAlgebraicK1.ofUnits_det_mul_coe_projection x
  right_inv := AlgebraicK1.det_ofUnits
  map_mul' := map_mul (AlgebraicK1.det R)

/-- `detEquivOfSpecialEqBot` evaluates as `AlgebraicK1.det R`. -/
@[simp]
theorem AlgebraicK1.detEquivOfSpecialEqBot_apply (h : specialAlgebraicK1 R = ⊥)
    (x : AlgebraicK1 R) :
    AlgebraicK1.detEquivOfSpecialEqBot h x = AlgebraicK1.det R x :=
  (rfl)

/-- The inverse of `detEquivOfSpecialEqBot` is `AlgebraicK1.ofUnits R`. -/
@[simp]
theorem AlgebraicK1.detEquivOfSpecialEqBot_symm_apply (h : specialAlgebraicK1 R = ⊥) (u : Rˣ) :
    (AlgebraicK1.detEquivOfSpecialEqBot h).symm u = AlgebraicK1.ofUnits R u :=
  (rfl)

/-- `ofUnits R : Rˣ →* K₁(R)` is surjective if and only if `SK₁(R)` is trivial. -/
theorem AlgebraicK1.surjective_ofUnits_iff_specialAlgebraicK1_eq_bot :
    Function.Surjective (AlgebraicK1.ofUnits R) ↔ specialAlgebraicK1 R = ⊥ := by
  refine ⟨fun hsurj ↦ ?_, fun h ↦ (AlgebraicK1.detEquivOfSpecialEqBot h).symm.surjective⟩
  rw [eq_bot_iff]
  intro x hx
  obtain ⟨u, rfl⟩ := hsurj x
  rw [AlgebraicK1.ofUnits_mem_specialAlgebraicK1_iff] at hx
  simp [hx]

/-- If `SL (Fin n) R` is generated by elementary transvections for cofinally many sizes `n`
(for instance for all `n ≥ 3`, even when `SL₂(R) ≠ E₂(R)`), then `SK₁(R)` vanishes. -/
theorem specialAlgebraicK1_eq_bot_of_forall_exists_ge_closure_eq_top
    (h : ∀ m, ∃ n ≥ m, Subgroup.closure (Set.range
      (TransvectionStruct.toSpecialLinearGroup :
        TransvectionStruct (Fin n) R → SpecialLinearGroup (Fin n) R)) = ⊤) :
    specialAlgebraicK1 R = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  obtain ⟨m, g, hg⟩ := specialAlgebraicK1.exists_mkSpecial ⟨x, hx⟩
  have hx' : (AlgebraicK1.mkSpecial R m g : AlgebraicK1 R) = x := congrArg Subtype.val hg
  obtain ⟨n, hmn, hn⟩ := h m
  rw [Subgroup.mem_bot, ← hx', AlgebraicK1.coe_mkSpecial, AlgebraicK1.mk_eq_one_iff]
  refine ⟨n, hmn, (mem_elementarySubgroup_iff_det_eq_one_of_closure_eq_top hn).2 ?_⟩
  rw [det_stabilizeGL, SpecialLinearGroup.coeToGL_det]

end CommRing

/-! ## Algebraic `K₁` of `ℤ` and universal liftability -/

/-- The special Whitehead group `SK₁(ℤ)` is trivial. -/
@[simp]
theorem specialAlgebraicK1_int_eq_bot : specialAlgebraicK1 ℤ = ⊥ :=
  specialAlgebraicK1_eq_bot_of_forall_exists_ge_closure_eq_top fun m ↦
    ⟨m, le_rfl, SpecialLinearGroup.closure_range_toSpecialLinearGroup_eq_top⟩

instance specialAlgebraicK1.instUniqueInt : Unique (specialAlgebraicK1 ℤ) where
  default := 1
  uniq x := Subtype.ext (Subgroup.mem_bot.1 (specialAlgebraicK1_int_eq_bot ▸ x.2))

namespace AlgebraicK1

/-- **Algebraic `K₁(ℤ) ≃* ℤˣ`.** The determinant identifies `K₁(ℤ)` with `ℤˣ = {±1}`, with inverse
`ofUnits ℤ`. -/
def detEquivInt : AlgebraicK1 ℤ ≃* ℤˣ :=
  detEquivOfSpecialEqBot specialAlgebraicK1_int_eq_bot

/-- `detEquivInt` acts as `AlgebraicK1.det ℤ`. -/
@[simp]
theorem detEquivInt_apply (x : AlgebraicK1 ℤ) : detEquivInt x = det ℤ x :=
  (rfl)

/-- On the class of `g ∈ GL (Fin n) ℤ`, `detEquivInt` returns its determinant in `ℤˣ`. -/
theorem detEquivInt_mk (n : ℕ) (g : GL (Fin n) ℤ) :
    detEquivInt (mk ℤ n g) = Matrix.GeneralLinearGroup.det g :=
  det_mk n g

/-- The inverse of `detEquivInt` is `ofUnits ℤ`. -/
@[simp]
theorem detEquivInt_symm_apply (u : ℤˣ) : detEquivInt.symm u = ofUnits ℤ u :=
  (rfl)

/-- The class of `-1 ∈ ℤˣ` in `K₁(ℤ)` is nontrivial. -/
theorem ofUnits_neg_one_int_ne_one : ofUnits ℤ (-1 : ℤˣ) ≠ 1 := by
  intro h
  have hdet := congrArg (fun x ↦ (det ℤ x : ℤ)) h
  simp only [det_ofUnits, Units.val_neg, Units.val_one, map_one] at hdet
  omega

/-- The generator `ofUnits ℤ (-1)` of `K₁(ℤ)` has order `2`. -/
@[simp]
theorem orderOf_ofUnits_neg_one_int : orderOf (ofUnits ℤ (-1 : ℤˣ)) = 2 :=
  orderOf_eq_prime ofUnits_neg_one_sq ofUnits_neg_one_int_ne_one

/-- Every class in `K₁(ℤ)` is either `1` or `ofUnits ℤ (-1)`. -/
theorem eq_one_or_eq_ofUnits_neg_one_int (x : AlgebraicK1 ℤ) :
    x = 1 ∨ x = ofUnits ℤ (-1 : ℤˣ) := by
  rcases Int.units_eq_one_or (detEquivInt x) with h | h
  · exact Or.inl (detEquivInt.injective (by simpa using h))
  · exact Or.inr (detEquivInt.injective (by simpa using h))

/-- **Weibel, Chapter III, Remark 1.2.3.** There is an invertible matrix `u ∈ GL (Fin 1) ℤ`
(namely `scalar (Fin 1) (-1)`) that lifts to an invertible matrix across *every* unital ring
homomorphism `f : A →+* ℤ` (over an arbitrary ring `A`), yet defines a nontrivial class
`mk ℤ 1 u ≠ 1` in `K₁(ℤ)` (whereas `-I₂ = scalar (Fin 2) (-1)` lies in `E₂(ℤ)` by
`TauCeti.scalar_two_neg_one_mem_elementarySubgroup`): universal liftability does not imply
triviality in `K₁`. -/
theorem exists_forall_lift_and_mk_ne_one_int.{u} :
    ∃ u : GL (Fin 1) ℤ,
      (∀ {A : Type u} [Ring A] (f : A →+* ℤ),
        ∃ u' : GL (Fin 1) A, Units.map (f.mapMatrix (m := Fin 1)).toMonoidHom u' = u) ∧
      mk ℤ 1 u ≠ 1 := by
  refine ⟨Matrix.GeneralLinearGroup.scalar (Fin 1) (-1 : ℤˣ), fun f ↦
    ⟨Matrix.GeneralLinearGroup.scalar (Fin 1) (-1 : _), ?_⟩,
    by rw [mk_one_scalar]; exact ofUnits_neg_one_int_ne_one⟩
  rw [f.unitsMap_mapMatrix_scalar]
  exact congrArg (Matrix.GeneralLinearGroup.scalar (Fin 1)) (Units.ext (by simp))

end AlgebraicK1

/-! ## Algebraic `K₁` of fields -/

section Field

variable {K : Type*} [Field K]

/-- For a field `K`, the special Whitehead group `SK₁(K)` is trivial. -/
@[simp]
theorem specialAlgebraicK1_of_field_eq_bot : specialAlgebraicK1 K = ⊥ :=
  specialAlgebraicK1_eq_bot_of_forall_exists_ge_closure_eq_top fun m ↦
    ⟨m, le_rfl, SpecialLinearGroup.closure_range_toSpecialLinearGroup_eq_top_of_field⟩

instance specialAlgebraicK1.instUniqueOfField : Unique (specialAlgebraicK1 K) where
  default := 1
  uniq x := Subtype.ext (Subgroup.mem_bot.1 (specialAlgebraicK1_of_field_eq_bot (K := K) ▸ x.2))

namespace AlgebraicK1

variable (K) in
/-- **Algebraic `K₁(K) ≃* Kˣ`** for a field `K`, given by the determinant with inverse
`ofUnits K`. -/
def detEquivOfField : AlgebraicK1 K ≃* Kˣ :=
  detEquivOfSpecialEqBot specialAlgebraicK1_of_field_eq_bot

/-- `detEquivOfField K` acts as `AlgebraicK1.det K`. -/
@[simp]
theorem detEquivOfField_apply (x : AlgebraicK1 K) : detEquivOfField K x = det K x :=
  (rfl)

/-- On the class of `g ∈ GL (Fin n) K`, `detEquivOfField K` returns its determinant in `Kˣ`. -/
theorem detEquivOfField_mk (n : ℕ) (g : GL (Fin n) K) :
    detEquivOfField K (mk K n g) = Matrix.GeneralLinearGroup.det g :=
  det_mk n g

/-- The inverse of `detEquivOfField K` is `ofUnits K`. -/
@[simp]
theorem detEquivOfField_symm_apply (u : Kˣ) : (detEquivOfField K).symm u = ofUnits K u :=
  (rfl)

end AlgebraicK1

end Field

end TauCeti
