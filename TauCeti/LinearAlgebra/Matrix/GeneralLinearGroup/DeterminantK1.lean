module

public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Stable

/-!
# The determinant of algebraic `K₁` and `K₁(ℤ) = {±1}`

For any ring `A`, the invertible `1 × 1` matrices give a homomorphism `Aˣ →* K₁(A)`,
`u ↦ [(u)]`. For a commutative ring `R` the determinant of invertible matrices is unchanged by
stabilization `u ↦ u ⊕ 1`, so it descends to a homomorphism `det : K₁(R) →* Rˣ`, and the
determinant of the `1 × 1` matrix `(u)` is `u`. Thus `det` is split surjective, and its kernel
`SK₁(R)` is a direct factor:

  `K₁(R) ≃* Rˣ × SK₁(R)`, `x ↦ (det x, x · [(det x)⁻¹])`.

The class of a matrix lies in `SK₁(R)` exactly when its determinant is one. Hence `SK₁(R)` is
trivial as soon as every matrix of determinant one is elementary, as happens for `ℤ`, whose
special linear groups are generated by transvections. For `ℤ` this gives the isomorphism
`K₁(ℤ) ≃* ℤˣ = {±1}` sending the class of an invertible integer matrix to its determinant, and
the class of `-1` is the element of order two.

## Main definitions

* `TauCeti.AlgebraicK1.ofUnits`: the homomorphism `Aˣ →* K₁(A)`, `u ↦ [(u)]`.
* `TauCeti.AlgebraicK1.det`: the determinant `K₁(R) →* Rˣ` of a commutative ring.
* `TauCeti.specialAlgebraicK1`: the subgroup `SK₁(R)`, the kernel of the determinant.
* `TauCeti.AlgebraicK1.equivUnitsProdSpecial`: the splitting `K₁(R) ≃* Rˣ × SK₁(R)`.
* `TauCeti.AlgebraicK1.detEquivInt`: the isomorphism `K₁(ℤ) ≃* ℤˣ` given by the determinant.

## Main results

* `TauCeti.AlgebraicK1.det_mk`: the determinant of the class of `u` is the determinant of `u`.
* `TauCeti.AlgebraicK1.det_ofUnits`: the determinant is a retraction of `ofUnits`.
* `TauCeti.specialAlgebraicK1_eq_bot_of_ker_det_le`: `SK₁(R)` is trivial when every matrix of
  determinant one is elementary.
* `TauCeti.specialAlgebraicK1_int_eq_bot`: `SK₁(ℤ)` is trivial.
* `TauCeti.AlgebraicK1.orderOf_ofUnits_neg_one_int`: the class of `-1` in `K₁(ℤ)` has order two.

## References

* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter III, Example 1.1.1 (the determinant and `SK₁`) and
  Example 1.3.5 with Exercise 1.5 (`K₁(ℤ) = {±1}`).
-/

public section

noncomputable section

open Matrix

namespace TauCeti

/-! ## Units as `1 × 1` matrices -/

namespace AlgebraicK1

section Ring

variable (A : Type*) [Ring A]

/-- The class in algebraic `K₁` of an invertible `1 × 1` matrix: the homomorphism
`Aˣ →* K₁(A)`, `u ↦ [(u)]`. -/
def ofUnits : Aˣ →* AlgebraicK1 A :=
  (mk A 1).comp (GeneralLinearGroup.scalar (Fin 1))

variable {A}

/-- `ofUnits` sends a unit `u` to the class of the `1 × 1` matrix `(u)`. -/
theorem ofUnits_apply (u : Aˣ) : ofUnits A u = mk A 1 (GeneralLinearGroup.scalar (Fin 1) u) :=
  (rfl)

/-- The homomorphism of algebraic `K₁` induced by a ring homomorphism sends the class of a unit
`u` to the class of `f u`. -/
@[simp]
theorem map_ofUnits {B : Type*} [Ring B] (f : A →+* B) (u : Aˣ) :
    map f (ofUnits A u) = ofUnits B (Units.map (f : A →* B) u) := by
  rw [ofUnits_apply, ofUnits_apply, map_mk]
  congr 1
  ext
  simp [diagonal_apply, apply_ite f]

end Ring

end AlgebraicK1

/-! ## The determinant -/

section CommRing

variable {R : Type*} [CommRing R]

/-- Stabilization `u ↦ u ⊕ 1` does not change the determinant of an invertible matrix over a
commutative ring. -/
@[simp]
theorem det_stabilizeGL {m n : ℕ} (h : m ≤ n) (u : GL (Fin m) R) :
    GeneralLinearGroup.det (stabilizeGL R h u) = GeneralLinearGroup.det u := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [stabilizeGL_eq_reindexGL_fromBlocksGL]
  ext
  simp [GeneralLinearGroup.val_det_apply, det_fromBlocks_zero₂₁]

namespace AlgebraicK1

variable (R) in
/-- The **determinant** `K₁(R) →* Rˣ` of a commutative ring `R`, induced by the determinants of
invertible matrices, which are compatible with stabilization. -/
def det : AlgebraicK1 R →* Rˣ :=
  lift (fun _ ↦ GeneralLinearGroup.det) fun _ _ h u ↦ det_stabilizeGL h u

/-- The determinant of the class of an invertible matrix is its determinant. -/
@[simp]
theorem det_mk (n : ℕ) (u : GL (Fin n) R) :
    det R (mk R n u) = GeneralLinearGroup.det u :=
  lift_mk ..

/-- The determinant of the class of the `1 × 1` matrix `(u)` is `u`. -/
@[simp]
theorem det_ofUnits (u : Rˣ) : det R (ofUnits R u) = u := by
  simp [ofUnits_apply, GeneralLinearGroup.det_scalar]

/-- The determinant is a retraction of `ofUnits`. -/
theorem det_comp_ofUnits : (det R).comp (ofUnits R) = MonoidHom.id Rˣ :=
  MonoidHom.ext det_ofUnits

/-- The determinant `K₁(R) →* Rˣ` is surjective. -/
theorem det_surjective : Function.Surjective (det R) :=
  fun u ↦ ⟨ofUnits R u, det_ofUnits u⟩

/-- The determinant of algebraic `K₁` is natural in ring homomorphisms. -/
@[simp]
theorem det_map {S : Type*} [CommRing S] (f : R →+* S) (x : AlgebraicK1 R) :
    det S (map f x) = Units.map (f : R →* S) (det R x) := by
  obtain ⟨n, u, rfl⟩ := exists_mk x
  ext
  simp [GeneralLinearGroup.val_det_apply, RingHom.map_det]

end AlgebraicK1

/-! ## `SK₁` and the splitting -/

variable (R) in
/-- `SK₁(R)`, the kernel of the determinant `K₁(R) →* Rˣ` of a commutative ring `R`. -/
def specialAlgebraicK1 : Subgroup (AlgebraicK1 R) :=
  (AlgebraicK1.det R).ker

/-- A class lies in `SK₁(R)` exactly when its determinant is one. -/
@[simp]
theorem mem_specialAlgebraicK1_iff {x : AlgebraicK1 R} :
    x ∈ specialAlgebraicK1 R ↔ AlgebraicK1.det R x = 1 :=
  MonoidHom.mem_ker

/-- The class of an invertible matrix lies in `SK₁(R)` exactly when the matrix has determinant
one. -/
theorem AlgebraicK1.mk_mem_specialAlgebraicK1_iff {n : ℕ} {u : GL (Fin n) R} :
    mk R n u ∈ specialAlgebraicK1 R ↔ GeneralLinearGroup.det u = 1 := by
  simp

namespace AlgebraicK1

variable (R) in
/-- The **determinant splitting** `K₁(R) ≃* Rˣ × SK₁(R)` of a commutative ring `R`: a class `x`
goes to its determinant and to `x · [(det x)⁻¹] ∈ SK₁(R)`. -/
def equivUnitsProdSpecial : AlgebraicK1 R ≃* Rˣ × specialAlgebraicK1 R where
  toFun x := (det R x, ⟨x * ofUnits R (det R x)⁻¹, by simp⟩)
  invFun p := ofUnits R p.1 * p.2
  left_inv x := by simp
  right_inv p := by
    have hp : det R p.2 = 1 := mem_specialAlgebraicK1_iff.1 p.2.2
    ext <;> simp [hp, mul_comm]
  map_mul' x y := by
    refine Prod.ext (map_mul _ x y) (Subtype.ext ?_)
    simp only [map_mul, mul_inv]
    exact mul_mul_mul_comm ..

/-- The first component of the determinant splitting is the determinant. -/
@[simp]
theorem equivUnitsProdSpecial_apply_fst (x : AlgebraicK1 R) :
    (equivUnitsProdSpecial R x).1 = det R x :=
  (rfl)

/-- The second component of the determinant splitting of `x` is `x · [(det x)⁻¹]`. -/
@[simp]
theorem coe_equivUnitsProdSpecial_apply_snd (x : AlgebraicK1 R) :
    ((equivUnitsProdSpecial R x).2 : AlgebraicK1 R) = x * ofUnits R (det R x)⁻¹ :=
  (rfl)

/-- The inverse of the determinant splitting multiplies the class of a unit with a class in
`SK₁(R)`. -/
@[simp]
theorem equivUnitsProdSpecial_symm_apply (p : Rˣ × specialAlgebraicK1 R) :
    (equivUnitsProdSpecial R).symm p = ofUnits R p.1 * p.2 :=
  (rfl)

end AlgebraicK1

/-- `SK₁(R)` is trivial when every invertible matrix of determinant one over `R` is elementary;
then the determinant `K₁(R) →* Rˣ` is an isomorphism. -/
theorem specialAlgebraicK1_eq_bot_of_ker_det_le
    (h : ∀ n, (GeneralLinearGroup.det : GL (Fin n) R →* Rˣ).ker ≤ elementarySubgroup (Fin n) R) :
    specialAlgebraicK1 R = ⊥ := by
  refine (Subgroup.eq_bot_iff_forall _).2 fun x hx ↦ ?_
  obtain ⟨n, u, rfl⟩ := AlgebraicK1.exists_mk x
  refine AlgebraicK1.mk_eq_one_iff.2 ⟨n, le_rfl, ?_⟩
  rw [stabilizeGL_refl, MonoidHom.id_apply]
  exact h n (AlgebraicK1.mk_mem_specialAlgebraicK1_iff.1 hx)

end CommRing

/-! ## `K₁(ℤ)` -/

/-- `SK₁(ℤ)` is trivial: an invertible integer matrix of determinant one is elementary. -/
theorem specialAlgebraicK1_int_eq_bot : specialAlgebraicK1 ℤ = ⊥ :=
  specialAlgebraicK1_eq_bot_of_ker_det_le fun _ ↦ elementarySubgroup_int_eq_ker_det.ge

namespace AlgebraicK1

/-- The determinant of `K₁(ℤ)` is injective. -/
theorem det_int_injective : Function.Injective (det ℤ) :=
  (MonoidHom.ker_eq_bot_iff _).1 specialAlgebraicK1_int_eq_bot

/-- **`K₁(ℤ) = {±1}`**: the determinant is an isomorphism `K₁(ℤ) ≃* ℤˣ`. -/
def detEquivInt : AlgebraicK1 ℤ ≃* ℤˣ :=
  MulEquiv.ofBijective (det ℤ) ⟨det_int_injective, det_surjective⟩

/-- The isomorphism `K₁(ℤ) ≃* ℤˣ` sends the class of an invertible integer matrix to its
determinant. -/
@[simp]
theorem detEquivInt_mk (n : ℕ) (g : GL (Fin n) ℤ) :
    detEquivInt (mk ℤ n g) = GeneralLinearGroup.det g :=
  det_mk n g

/-- The inverse of `K₁(ℤ) ≃* ℤˣ` sends a unit `u` to the class of the `1 × 1` matrix `(u)`. -/
@[simp]
theorem detEquivInt_symm_apply (u : ℤˣ) : detEquivInt.symm u = ofUnits ℤ u :=
  detEquivInt.symm_apply_eq.2 (det_ofUnits u).symm

/-- The class of the `1 × 1` matrix `(-1)` is the element of order two of `K₁(ℤ)`. -/
theorem orderOf_ofUnits_neg_one_int : orderOf (ofUnits ℤ (-1)) = 2 := by
  rw [← orderOf_injective (det ℤ) det_int_injective, det_ofUnits]
  exact orderOf_eq_prime (by decide) (by decide)

end AlgebraicK1

end TauCeti
