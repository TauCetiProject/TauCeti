/-!
# The Hermite matrix of an ideal in a fixed integral basis

Let `R` be a commutative ring with a `ℤ`-basis `ω = (ω 0, …, ω (n - 1))`, such as the ring of
integers of a number field with an integral basis. Reading coordinates in `ω` identifies `R` with
`ℤ^n`, and an ideal `I` of `R` with a sublattice of `ℤ^n`. The *Hermite matrix* `H_ω(I)` of `I` is
the Hermite basis of that sublattice: when `R` is a domain and `I ≠ 0` it is the unique `n × n`
integer matrix in (column-style, upper) Hermite normal form whose columns are the `ω`-coordinates
of a `ℤ`-basis of `I`. It is the canonical form in which ideals of number fields are recorded,
compared and labelled in computational algebraic number theory.

## Main definitions

* `Module.Basis.latticeOfMatrix ω H`: the `ℤ`-submodule spanned by the vectors whose
  `ω`-coordinates are the columns of the integer matrix `H`.
* `Module.Basis.idealHermiteMatrix ω I`: the Hermite matrix `H_ω(I)` of an ideal `I`. If `I` does
  not have full rank (in a domain: if `I = 0`), the Hermite basis of `I` has fewer than `n` columns
  and is padded with zero columns; the zero ideal has the zero matrix.

## Main results

* `Module.Basis.latticeOfMatrix_idealHermiteMatrix`: the columns of `H_ω(I)` span `I`.
* `Module.Basis.mem_iff_idealHermiteMatrix`: `x ∈ I` if and only if the `ω`-coordinates of `x` lie
  in the column lattice of `H_ω(I)`.
* `Module.Basis.idealHermiteMatrix_injective`: `I ↦ H_ω(I)` is injective.
* `Module.Basis.isHermiteNormalForm_idealHermiteMatrix`: for a nonzero ideal of a domain, `H_ω(I)`
  is in Hermite normal form.
* `Module.Basis.idealHermiteMatrix_eq_iff`, `Matrix.IsHermiteNormalForm.idealHermiteMatrix_eq`: a
  square matrix is `H_ω(I)` if and only if it is in Hermite normal form and its columns span `I`.
* `Module.Basis.idealHermiteMatrix_top`, `Module.Basis.idealHermiteMatrix_span_intCast`:
  `H_ω(R) = 1` and `H_ω((m)) = m • 1` for `m > 0`.
* `Module.Basis.comap_algebraMap_eq_span_idealHermiteMatrix`: if `ω 0 = 1`, then `I ∩ ℤ` is
  generated by the top left entry of `H_ω(I)`.

## References

* Karim Belabas, *Topics in computational algebraic number theory*, J. Théor. Nombres Bordeaux 16
  (2004), Section 5.3.1 (the Hermite normal form of an ideal in a fixed integral basis as its
  canonical representation) and Section 5.3.2 (`I ∩ ℤ` is generated by the top left entry when
  `ω 0 = 1`).
-/

public section

open Matrix

namespace Module.Basis

/-! ### The lattice of an integer matrix in a basis -/

section Lattice

variable {M : Type*} [AddCommGroup M] {n k : ℕ} (ω : Basis (Fin n) ℤ M)

/-- The *lattice* of an integer matrix `H` read in the basis `ω`: the `ℤ`-submodule spanned by the
vectors `∑ i, H i j • ω i` whose `ω`-coordinates are the columns of `H`, see
`Module.Basis.latticeOfMatrix_eq_span`. -/
noncomputable def latticeOfMatrix (H : Matrix (Fin n) (Fin k) ℤ) : Submodule ℤ M :=
  (LinearMap.range H.mulVecLin).map (ω.equivFun.symm : (Fin n → ℤ) →ₗ[ℤ] M)

variable {ω} {H : Matrix (Fin n) (Fin k) ℤ}

/-- A vector lies in the lattice of `H` if and only if its `ω`-coordinates are an integer
combination of the columns of `H`. -/
@[simp]
theorem mem_latticeOfMatrix {x : M} : x ∈ ω.latticeOfMatrix H ↔ ∃ c, H *ᵥ c = ω.equivFun x := by
  simp [latticeOfMatrix]

/-- The lattice of `H` is `N` if and only if the column lattice of `H` is the lattice of
`ω`-coordinates of `N`. -/
theorem latticeOfMatrix_eq_iff {N : Submodule ℤ M} :
    ω.latticeOfMatrix H = N ↔
      LinearMap.range H.mulVecLin = N.map (ω.equivFun : M →ₗ[ℤ] Fin n → ℤ) := by
  rw [latticeOfMatrix, Submodule.map_symm_eq_iff, eq_comm]

variable (ω H) in
/-- The lattice of `H` is spanned by the vectors `∑ i, H i j • ω i` whose `ω`-coordinates are the
columns of `H`. -/
theorem latticeOfMatrix_eq_span :
    ω.latticeOfMatrix H = Submodule.span ℤ (Set.range fun j ↦ ∑ i, H i j • ω i) := by
  rw [latticeOfMatrix, range_mulVecLin, Submodule.map_span, ← Set.range_comp]
  congr 2
  ext j
  rw [Function.comp_apply, LinearEquiv.coe_coe, equivFun_symm_apply]
  simp

variable (ω) in
/-- The lattice of the identity matrix is the whole module. -/
@[simp]
theorem latticeOfMatrix_one : ω.latticeOfMatrix (1 : Matrix (Fin n) (Fin n) ℤ) = ⊤ := by
  simp [latticeOfMatrix]

/-- The lattice of `H` is zero if and only if `H` is the zero matrix. -/
@[simp]
theorem latticeOfMatrix_eq_bot_iff : ω.latticeOfMatrix H = ⊥ ↔ H = 0 := by
  refine ⟨fun h ↦ ?_, fun h ↦ by simp [h, latticeOfMatrix]⟩
  rw [latticeOfMatrix_eq_iff, Submodule.map_bot] at h
  ext i j
  have hj : H.col j = 0 := (Submodule.mem_bot ℤ).mp (h ▸ H.col_mem_range_mulVecLin j)
  simpa using congrFun hj i

end Lattice

/-! ### The Hermite matrix of an ideal -/

variable {R : Type*} [CommRing R] {n : ℕ} (ω : Basis (Fin n) ℤ R)

/-- The *Hermite matrix* `H_ω(I)` of an ideal `I` in the `ℤ`-basis `ω`: the Hermite basis
`Submodule.hermiteBasis` of the lattice of `ω`-coordinates of `I`, padded with zero columns to a
square matrix. For a nonzero ideal of a domain no padding occurs: `H_ω(I)` is the unique square
matrix in Hermite normal form whose columns span `I`, see `Module.Basis.idealHermiteMatrix_eq_iff`.
The zero ideal has the zero matrix. -/
noncomputable def idealHermiteMatrix (I : Ideal R) : Matrix (Fin n) (Fin n) ℤ :=
  hermitePad ((I.restrictScalars ℤ).map (ω.equivFun : R →ₗ[ℤ] Fin n → ℤ)).hermiteBasis n

/-- **The columns of `H_ω(I)` span `I`.** The lattice of `H_ω(I)` read in `ω` is `I`. -/
@[simp]
theorem latticeOfMatrix_idealHermiteMatrix (I : Ideal R) :
    ω.latticeOfMatrix (ω.idealHermiteMatrix I) = I.restrictScalars ℤ := by
  set L := (I.restrictScalars ℤ).map (ω.equivFun : R →ₗ[ℤ] Fin n → ℤ)
  have hL : Module.finrank ℤ L ≤ n := by
    simpa using L.finrank_le
  rw [latticeOfMatrix_eq_iff, idealHermiteMatrix, range_mulVecLin_hermitePad _ hL,
    Submodule.range_mulVecLin_hermiteBasis]

/-- **Membership in an ideal from its Hermite matrix.** `x ∈ I` if and only if the
`ω`-coordinates of `x` are an integer combination of the columns of `H_ω(I)`. -/
theorem mem_iff_idealHermiteMatrix {I : Ideal R} {x : R} :
    x ∈ I ↔ ∃ c, ω.idealHermiteMatrix I *ᵥ c = ω.equivFun x := by
  rw [← mem_latticeOfMatrix, latticeOfMatrix_idealHermiteMatrix, Submodule.restrictScalars_mem]

/-- **Ideals are determined by their Hermite matrices.** -/
theorem idealHermiteMatrix_injective : Function.Injective ω.idealHermiteMatrix := fun I J h ↦
  Submodule.restrictScalars_injective ℤ _ _ <| by
    rw [← latticeOfMatrix_idealHermiteMatrix, h, latticeOfMatrix_idealHermiteMatrix]

/-- **Uniqueness of the Hermite matrix.** A square matrix in Hermite normal form whose columns
span `I` is the Hermite matrix of `I`. -/
theorem _root_.Matrix.IsHermiteNormalForm.idealHermiteMatrix_eq {H : Matrix (Fin n) (Fin n) ℤ}
    (hH : H.IsHermiteNormalForm) {I : Ideal R} (hHI : ω.latticeOfMatrix H = I.restrictScalars ℤ) :
    ω.idealHermiteMatrix I = H := by
  have h := Submodule.sigma_mk_hermiteBasis_eq_iff.mpr ⟨hH, latticeOfMatrix_eq_iff.mp hHI⟩
  rw [idealHermiteMatrix]
  simpa using congrArg (fun S : Σ k, Matrix (Fin n) (Fin k) ℤ ↦ hermitePad S.2 n) h

/-- The Hermite matrix of the unit ideal is the identity matrix. -/
@[simp]
theorem idealHermiteMatrix_top : ω.idealHermiteMatrix ⊤ = 1 :=
  IsHermiteNormalForm.one.idealHermiteMatrix_eq ω (by simp)

/-- The Hermite matrix of the zero ideal is the zero matrix. -/
@[simp]
theorem idealHermiteMatrix_bot : ω.idealHermiteMatrix ⊥ = 0 :=
  latticeOfMatrix_eq_bot_iff.mp <| by
    rw [latticeOfMatrix_idealHermiteMatrix, Submodule.restrictScalars_bot]

/-- For a positive integer `m`, the Hermite matrix of the principal ideal `(m)` is `m • 1`. -/
theorem idealHermiteMatrix_span_intCast {m : ℤ} (hm : 0 < m) :
    ω.idealHermiteMatrix (Ideal.span {(m : R)}) = m • 1 := by
  refine IsHermitePivotedBy.isHermiteNormalForm (p := id)
    ⟨strictMono_id, fun j ↦ by simpa using hm,
      fun j i (hji : j < i) ↦ by simp [one_apply_ne hji.ne'],
      fun hjj' ↦ by simp [one_apply_ne hjj'.ne], fun hjj' ↦ by simpa [one_apply_ne hjj'.ne]⟩
    |>.idealHermiteMatrix_eq ω ?_
  ext x
  rw [mem_latticeOfMatrix, Submodule.restrictScalars_mem, Ideal.mem_span_singleton']
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨ω.equivFun.symm c, ω.equivFun.injective ?_⟩
    rw [← hc, ← zsmul_eq_mul', map_zsmul, LinearEquiv.apply_symm_apply, smul_mulVec,
      one_mulVec]
  · rintro ⟨a, rfl⟩
    refine ⟨ω.equivFun a, ?_⟩
    rw [← zsmul_eq_mul', map_zsmul, smul_mulVec, one_mulVec]

variable [IsDomain R]

/-- **The Hermite matrix is in Hermite normal form.** For a nonzero ideal `I` of a domain, `H_ω(I)`
is in Hermite normal form. -/
theorem isHermiteNormalForm_idealHermiteMatrix {I : Ideal R} (hI : I ≠ ⊥) :
    (ω.idealHermiteMatrix I).IsHermiteNormalForm := by
  set L := (I.restrictScalars ℤ).map (ω.equivFun : R →ₗ[ℤ] Fin n → ℤ)
  -- A nonzero ideal of a domain has full rank, so its Hermite basis is square.
  have hL : Module.finrank ℤ L = n := by
    rw [LinearEquiv.finrank_map_eq, Ideal.finrank_eq_finrank ω I hI, finrank_eq_card_basis ω,
      Fintype.card_fin]
  have hpad {k : ℕ} {H : Matrix (Fin n) (Fin k) ℤ} (hH : H.IsHermiteNormalForm) (hk : k = n) :
      (hermitePad H n).IsHermiteNormalForm := by
    subst hk
    rwa [hermitePad_self]
  exact hpad L.isHermiteNormalForm_hermiteBasis hL

/-- **Characterisation of the Hermite matrix.** For a nonzero ideal `I` of a domain, a square
matrix is the Hermite matrix of `I` if and only if it is in Hermite normal form and its columns
span `I`. -/
theorem idealHermiteMatrix_eq_iff {I : Ideal R} (hI : I ≠ ⊥) {H : Matrix (Fin n) (Fin n) ℤ} :
    ω.idealHermiteMatrix I = H ↔
      H.IsHermiteNormalForm ∧ ω.latticeOfMatrix H = I.restrictScalars ℤ := by
  refine ⟨?_, fun h ↦ h.1.idealHermiteMatrix_eq ω h.2⟩
  rintro rfl
  exact ⟨ω.isHermiteNormalForm_idealHermiteMatrix hI, ω.latticeOfMatrix_idealHermiteMatrix I⟩

/-- **The integers in an ideal.** If the first basis vector is `ω 0 = 1`, then the integers in an
ideal `I` of a domain are the multiples of the top left entry of its Hermite matrix:
`I ∩ ℤ = H_ω(I)₀₀ ℤ`. -/
theorem comap_algebraMap_eq_span_idealHermiteMatrix [NeZero n] (hω : ω 0 = 1) (I : Ideal R) :
    I.comap (algebraMap ℤ R) = Ideal.span {ω.idealHermiteMatrix I 0 0} := by
  -- The `ω`-coordinates of an integer `a` are `a` followed by zeros.
  have hcoord (a : ℤ) : ω.equivFun (algebraMap ℤ R a) = Pi.single 0 a := by
    rw [algebraMap_int_eq, eq_intCast, ← zsmul_one, ← hω, map_zsmul]
    ext i
    simp [Pi.single_apply, Finsupp.single_apply, eq_comm]
  ext a
  rw [Ideal.mem_comap, mem_iff_idealHermiteMatrix, hcoord, Ideal.mem_span_singleton]
  rcases eq_or_ne I ⊥ with rfl | hI
  · simp [Pi.single_eq_zero_iff, eq_comm]
  have hH := ω.isHermiteNormalForm_idealHermiteMatrix hI
  set H := ω.idealHermiteMatrix I
  constructor
  · rintro ⟨c, hc⟩
    simpa using hH.isHermitePivotedBy_id.pivot_dvd_of_mem_range_mulVecLin (v := Pi.single 0 a)
      ⟨c, hc⟩ (j := 0) fun i (hi : 0 < i) ↦ by simp [hi.ne']
  · rintro ⟨t, rfl⟩
    refine ⟨Pi.single 0 t, funext fun i ↦ ?_⟩
    rcases eq_or_ne i 0 with rfl | hi
    · simp
    · simp [hi, hH.isUpperTriangular (Fin.pos_iff_ne_zero.mpr hi)]

/-! ### Examples -/

/-- In `ℤ[i]` with a basis `(1, i)`, the Hermite matrix of the ideal `(1 + i)` has the columns
`(2, 0)` and `(1, 1)`: the ideal consists of the `a + b i` with `a ≡ b mod 2`. -/
example (ω : Basis (Fin 2) ℤ GaussianInt) (hω₀ : ω 0 = 1) (hω₁ : ω 1 = ⟨0, 1⟩) :
    ω.idealHermiteMatrix (Ideal.span {⟨1, 1⟩}) = !![2, 1; 0, 1] := by
  have hω (x : GaussianInt) : ω.equivFun x = ![x.re, x.im] := by
    rw [← LinearEquiv.eq_symm_apply, equivFun_symm_apply, Fin.sum_univ_two, hω₀, hω₁]
    ext <;> simp
  refine (IsHermitePivotedBy.isHermiteNormalForm (p := id)
    ⟨strictMono_id, by decide, by decide, by decide, by decide⟩).idealHermiteMatrix_eq ω ?_
  ext x
  rw [mem_latticeOfMatrix, Submodule.restrictScalars_mem, Ideal.mem_span_singleton', hω]
  constructor
  · rintro ⟨c, hc⟩
    have h0 : 2 * c 0 + c 1 = x.re := by simpa [vecHead, vecTail] using congrFun hc 0
    have h1 : c 1 = x.im := by simpa [vecHead, vecTail] using congrFun hc 1
    exact ⟨⟨c 0 + c 1, -c 0⟩, by ext <;> simp <;> linarith⟩
  · rintro ⟨a, rfl⟩
    exact ⟨![-a.im, a.re + a.im], by ext i; fin_cases i <;> simp [vecHead, vecTail]; ring⟩

end Module.Basis
