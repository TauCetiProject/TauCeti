module

public import TauCeti.LinearAlgebra.Matrix.Range

/-!
# Changes of column generators over a subring

A column span containing a prescribed submodule is determined by that submodule and the
columns modulo it. When two invertible matrices generate the same column span over the
smaller ring, their change of generators is already invertible over that ring.
-/

public section

namespace Matrix

/-- A column span containing `P` is generated by `P` and any matrix whose columns agree
with the original columns modulo `P`. -/
theorem span_col_eq_sup_of_sub_mem {R A m n : Type*} [CommRing R] [CommRing A] [Algebra R A]
    {P : Submodule R (m → A)} (B C : Matrix m n A) (hP : P ≤ Submodule.span R (Set.range B.col))
    (h : ∀ j, B.col j - C.col j ∈ P) :
    Submodule.span R (Set.range B.col) = P ⊔ Submodule.span R (Set.range C.col) := by
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    have hc : C.col j ∈ P ⊔ Submodule.span R (Set.range C.col) :=
      Submodule.mem_sup_right (Submodule.subset_span (Set.mem_range_self j))
    have hd : B.col j - C.col j ∈ P ⊔ Submodule.span R (Set.range C.col) :=
      Submodule.mem_sup_left (h j)
    exact (Submodule.sub_mem_iff_left _ hc).mp hd
  · refine sup_le hP (Submodule.span_le.mpr ?_)
    rintro _ ⟨j, rfl⟩
    have hb : B.col j ∈ Submodule.span R (Set.range B.col) :=
      Submodule.subset_span (Set.mem_range_self j)
    have hm : B.col j - (B.col j - C.col j) ∈ Submodule.span R (Set.range B.col) :=
      Submodule.sub_mem _ hb (hP (h j))
    rw [sub_sub_cancel] at hm
    exact hm

/-- The column span of the identity over `S` consists exactly of vectors with entries in `S`. -/
theorem mem_span_range_col_one_iff {A n : Type*} [CommRing A] [Finite n] [DecidableEq n]
    (S : Subring A) (v : n → A) :
    v ∈ Submodule.span S (Set.range (1 : Matrix n n A).col) ↔ ∀ i, v i ∈ S := by
  let _ := Fintype.ofFinite n
  rw [Submodule.mem_span_range_iff_exists_fun]
  have hsum (c : n → S) (i : n) : (∑ j, c j • (1 : Matrix n n A).col j) i = (c i : A) := by
    simp only [Finset.sum_apply, Pi.smul_apply, col_apply]
    rw [Finset.sum_eq_single i]
    · rw [Matrix.one_apply_eq, Subring.smul_def, smul_eq_mul, mul_one]
    · intro j _ hj
      rw [Matrix.one_apply_ne' hj, smul_zero]
    · simp
  constructor
  · rintro ⟨c, rfl⟩ i
    rw [hsum]
    exact (c i).property
  · intro hv
    exact ⟨fun i ↦ ⟨v i, hv i⟩, funext (hsum _)⟩

namespace GeneralLinearGroup

/-- Invertible matrices spanning the same lattice over a smaller ring differ by an invertible
change of columns over that ring. -/
theorem exists_mul_map_eq_of_span_col_eq {R A n : Type*} [CommRing R] [CommRing A]
    [Algebra R A] [Fintype n] [DecidableEq n] (B C : GL n A)
    (hi : Function.Injective (algebraMap R A))
    (h : Submodule.span R (Set.range (B : Matrix n n A).col) =
      Submodule.span R (Set.range (C : Matrix n n A).col)) :
    ∃ V : GL n R, B * GeneralLinearGroup.map (algebraMap R A) V = C := by
  obtain ⟨X, hX⟩ := Matrix.exists_mul_map_eq_of_span_le h.ge
  obtain ⟨Y, hY⟩ := Matrix.exists_mul_map_eq_of_span_le h.le
  have hXY : X * Y = 1 := by
    apply Matrix.map_injective (f := algebraMap R A) hi
    dsimp only
    rw [Matrix.map_mul, Matrix.map_one _ (map_zero _) (map_one _)]
    apply B.isUnit.mul_right_injective
    dsimp only
    rw [← Matrix.mul_assoc, hX, hY, Matrix.mul_one]
  exact ⟨Units.mkOfMulEqOne X Y hXY, Units.ext hX⟩

end GeneralLinearGroup

end Matrix
