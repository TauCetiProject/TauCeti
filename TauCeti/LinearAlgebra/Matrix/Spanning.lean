/-!
# Families of matrices spanning the matrix algebra

A family `v : ι → Matrix n n R` **spans** the matrix algebra when the `R`-span of its range is
everything. This file records three general consequences of spanning, and a criterion for it
over a local ring.

* A matrix commuting with a spanning family commutes with every matrix unit, so it is scalar.
* Spanning survives every ring homomorphism `f : R →+* S`: the entrywise images span `M_n(S)`,
  because the image of `M_n(R)` contains the matrix units.
* Let `f : O →+* L` be injective, with `O` a Bézout domain. If `a ∈ GL_n(L)` conjugates a
  spanning family of `M_n(O)` into `M_n(O)`, then `a` is a unit of `L` times an element of
  `GL_n(O)`. Conjugating the matrix units shows that every product of an entry of `a⁻¹` and an
  entry of `a` lies in `O`. Fix `i₀, j₀` with `a⁻¹ i₀ j₀ * a j₀ i₀ ≠ 0`; a generator
  `d = ∑ r (k, l) * (a⁻¹ i₀ j₀ * a k l)` of the ideal generated by the products
  `a⁻¹ i₀ j₀ * a k l` gives the scalar `∑ r (k, l) * a k l`. The only cancellation is of `d`
  in `O`.
* Over a local ring `R`, spanning can be checked modulo the maximal ideal: if the reductions
  span `M_n(k)` over the residue field `k`, the family spans `M_n(R)`. This is Nakayama's lemma
  (`IsLocalRing.map_mkQ_eq_top`), applied to the finite module `M_n(R)`.

Take for `L` an algebraic closure of `ℚ_ℓ`, for `O` the ring of integers of a finite extension of
`ℚ_ℓ` in `L`, and for `f` the inclusion. Then `O` is a discrete valuation ring, hence a Bézout
domain, and the third statement says that a lattice in an `ℓ`-adic representation whose matrices
span `M_n(O)` is unique up to a scalar.

The kernel of the reduction `M_n(R) → M_n(k)` is `𝔪 • M_n(R)`, the matrices with all entries in
the maximal ideal `𝔪` (`Matrix.mem_ideal_smul_top_iff`).

## Main results

* `Matrix.mem_range_scalar_of_commute_of_span_eq_top`: a matrix commuting with a spanning family
  is scalar.
* `Matrix.span_range_map_eq_top`: the image of a spanning family under a ring homomorphism spans.
* `Matrix.GeneralLinearGroup.inv_mul_map_mul_mem_range_of_span_eq_top`: if `a` conjugates a
  spanning family into `M_n(O)`, it conjugates every matrix over `O` into `M_n(O)`.
* `Matrix.GeneralLinearGroup.inv_apply_mul_apply_mem_range_of_span_eq_top`: if `a` conjugates a
  spanning family into `M_n(O)`, every product of an entry of `a⁻¹` and an entry of `a` lies in
  `O`.
* `Matrix.GeneralLinearGroup.exists_eq_smul_map_of_inv_apply_mul_apply_mem_range`: over a Bézout
  domain, such an `a` is a unit of `L` times an element of `GL_n(O)`.
* `Matrix.GeneralLinearGroup.exists_eq_smul_map_of_span_eq_top`: the two together.
* `IsLocalRing.mem_maximalIdeal_smul_top_iff_map_residue_eq_zero`: so a matrix over a local ring
  lies in `𝔪 • M_n(R)` exactly when its reduction vanishes.
* `IsLocalRing.span_range_eq_top_of_span_range_map_residue_eq_top`: over a local ring, a family
  whose reductions span the matrix algebra over the residue field spans.

## Provenance

Adapted from `New.Selmer.IsLatticeIn.span_range_eq_top_of_map_pow_eq_map_conj` and the private
`Matrix.exists_eq_smul_one_of_commute_of_span_eq_top` in
`src/Lib/GaloisRep/Pseudocharacter/Pseudorepresentations.lean` of grh-lean
(https://github.com/lsernau/grh-lean, Apache 2.0, Copyright 2026 Anthropic, PBC). There the
lift from the residue field is a determinant computation in a basis of matrix units; here it is
Nakayama's lemma, which needs no counting and applies to families of any size.

`Matrix.GeneralLinearGroup.exists_eq_smul_map_of_span_eq_top` is the statement of
`New.Selmer.exists_eq_smul_of_conj_eq` in the same file of grh-lean, there for the ring of
integers of a finite extension of `ℚ_ℓ`. The proof here uses no absolute value: the scalar comes
from a generator of the finitely generated ideal of the products `a⁻¹ i₀ j₀ * a k l`, so the
statement holds over every Bézout domain.
-/

public section

open Function Submodule

namespace Matrix

variable {R ι n : Type*}

/-- **A matrix commuting with a spanning family is scalar.** If the `v i` span `M_n(R)` and every
`v i` commutes with `M`, then `M` commutes with every matrix, in particular with the matrix units,
so `M` is a scalar matrix. -/
theorem mem_range_scalar_of_commute_of_span_eq_top [Fintype n] [DecidableEq n] [CommSemiring R]
    {v : ι → Matrix n n R} (hv : span R (Set.range v) = ⊤) {M : Matrix n n R}
    (h : ∀ i, Commute (v i) M) :
    M ∈ Set.range (scalar n) :=
  mem_range_scalar_of_commute_single fun _ _ _ ↦
    Commute.span_left (Set.forall_mem_range.mpr h) _ (hv ▸ mem_top)

/-- **Spanning survives a change of rings.** If the `v i` span `M_n(R)` and `f : R →+* S` is a
ring homomorphism, the matrices `(v i).map f` span `M_n(S)`: the `S`-span of their range contains
the image of the `R`-span of the `v i`, hence the matrix units. -/
theorem span_range_map_eq_top [Finite n] {S : Type*} [CommSemiring R] [CommSemiring S]
    (f : R →+* S) {v : ι → Matrix n n R} (hv : span R (Set.range v) = ⊤) :
    span S (Set.range fun i ↦ (v i).map f) = ⊤ := by
  have := Fintype.ofFinite n
  classical
  set P := span S (Set.range fun i ↦ (v i).map f)
  have hmap (x : Matrix n n R) : x.map f ∈ P := by
    induction (hv ▸ mem_top : x ∈ span R (Set.range v)) using span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact subset_span ⟨i, rfl⟩
    | zero => simp
    | add x y _ _ hx hy => simpa [Matrix.map_add f (map_add f)] using P.add_mem hx hy
    | smul c x _ hx => simpa [Matrix.map_smul'] using P.smul_mem (f c) hx
  refine eq_top_iff'.mpr fun y ↦ ?_
  rw [matrix_eq_sum_single y]
  refine sum_mem fun i _ ↦ sum_mem fun j _ ↦ ?_
  simpa [map_single, smul_single] using P.smul_mem (y i j) (hmap (single i j 1))

end Matrix

namespace IsLocalRing

variable {R ι n : Type*} [CommRing R] [IsLocalRing R]

/-- A matrix over a local ring lies in `𝔪 • M_n(R)` exactly when its reduction vanishes, that is
when all its entries lie in the maximal ideal `𝔪`. -/
theorem mem_maximalIdeal_smul_top_iff_map_residue_eq_zero [Finite n] {x : Matrix n n R} :
    x ∈ maximalIdeal R • (⊤ : Submodule R (Matrix n n R)) ↔ x.map (residue R) = 0 := by
  simp [Matrix.mem_ideal_smul_top_iff, ← Matrix.ext_iff, residue_eq_zero_iff]

/-- **Nakayama's lemma for spanning families of matrices.** Over a local ring `R`, a family of
matrices whose reductions span the matrix algebra over the residue field spans `M_n(R)`. -/
theorem span_range_eq_top_of_span_range_map_residue_eq_top [Finite n] {v : ι → Matrix n n R}
    (hv : span (ResidueField R) (Set.range fun i ↦ (v i).map (residue R)) = ⊤) :
    span R (Set.range v) = ⊤ := by
  have := Fintype.ofFinite n
  classical
  rw [← map_mkQ_eq_top, eq_top_iff']
  intro z
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ z
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp
    (hv ▸ mem_top : x.map (residue R) ∈ span (ResidueField R) _)
  -- Lift the coefficients of `x.map (residue R)` to `R`.
  let lift := surjInv (residue_surjective (R := R))
  refine ⟨c.sum fun i a ↦ lift a • v i,
    sum_mem fun i _ ↦ smul_mem _ _ (subset_span ⟨i, rfl⟩), ?_⟩
  rw [mkQ_apply, Submodule.Quotient.eq]
  refine mem_maximalIdeal_smul_top_iff_map_residue_eq_zero.mpr ?_
  ext i j
  have := congrFun₂ hc i j
  simp only [Finsupp.sum, Matrix.sum_apply, Matrix.smul_apply, Matrix.map_apply,
    smul_eq_mul] at this
  simp [Finsupp.sum, Matrix.sum_apply, map_sum, lift, surjInv_eq, this]

end IsLocalRing

namespace Matrix.GeneralLinearGroup

variable {ι n O L : Type*} [Fintype n] [DecidableEq n]

/-- Let the `T i` span `M_n(O)` and let `a ∈ GL_n(L)` conjugate every `(T i).map f` into the
image of `M_n(O)`. Then `a` conjugates every `x.map f` into the image of `M_n(O)`. -/
theorem inv_mul_map_mul_mem_range_of_span_eq_top [Semiring O] [CommSemiring L] (f : O →+* L)
    {T : ι → Matrix n n O} (hT : span O (Set.range T) = ⊤) (a : GL n L)
    (ha : ∀ i, ((a⁻¹ : GL n L) : Matrix n n L) * (T i).map f * a ∈ Set.range (Matrix.map · f))
    (x : Matrix n n O) :
    ((a⁻¹ : GL n L) : Matrix n n L) * x.map f * a ∈ Set.range (Matrix.map · f) := by
  induction (hT ▸ mem_top : x ∈ span O (Set.range T)) using span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact ha i
  | zero => exact ⟨0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨x', hx'⟩ := hx
    obtain ⟨y', hy'⟩ := hy
    exact ⟨x' + y', by
      simp [Matrix.map_add f (map_add f), Matrix.mul_add, Matrix.add_mul, hx', hy']⟩
  | smul c x _ hx =>
    obtain ⟨x', hx'⟩ := hx
    exact ⟨c • x', by simp [Matrix.map_smul', hx']⟩

/-- Let the `T i` span `M_n(O)` and let `a ∈ GL_n(L)` conjugate every `(T i).map f` into the
image of `M_n(O)`. Then every product of an entry of `a⁻¹` and an entry of `a` lies in the image
of `f`. -/
theorem inv_apply_mul_apply_mem_range_of_span_eq_top [Semiring O] [CommSemiring L] (f : O →+* L)
    {T : ι → Matrix n n O} (hT : span O (Set.range T) = ⊤) (a : GL n L)
    (ha : ∀ i, ((a⁻¹ : GL n L) : Matrix n n L) * (T i).map f * a ∈ Set.range (Matrix.map · f))
    (i j k l : n) :
    ((a⁻¹ : GL n L) : Matrix n n L) i j * (a : Matrix n n L) k l ∈ Set.range f := by
  -- Entry `(i, l)` of the conjugate of the matrix unit `single j k 1` is the product.
  obtain ⟨y, hy⟩ := inv_mul_map_mul_mem_range_of_span_eq_top f hT a ha (single j k 1)
  exact ⟨y i l, by simpa using congrFun₂ hy i l⟩

/-- Let `f : O →+* L` be an injective ring homomorphism from a Bézout domain. If every product of
an entry of `a⁻¹` and an entry of `a ∈ GL_n(L)` lies in the image of `f`, then `a = α • k.map f`
for a unit `α` of `L` and some `k ∈ GL_n(O)`. -/
theorem exists_eq_smul_map_of_inv_apply_mul_apply_mem_range [Semiring O] [IsDomain O]
    [IsBezout O] [CommSemiring L] {f : O →+* L} (hf : Function.Injective f) (a : GL n L)
    (h : ∀ i j k l, ((a⁻¹ : GL n L) : Matrix n n L) i j * (a : Matrix n n L) k l ∈ Set.range f) :
    ∃ (α : Lˣ) (k : GL n O), (a : Matrix n n L) = (α : L) • (k : Matrix n n O).map f := by
  set A : Matrix n n L := ↑a
  set B : Matrix n n L := ((a⁻¹ : GL n L) : Matrix n n L)
  choose p hp using h
  rcases isEmpty_or_nonempty n with hn | ⟨⟨i₀⟩⟩
  · exact ⟨1, 1, Subsingleton.elim _ _⟩
  have hBA : B * A = 1 := by simp [A, B]
  have hAB : A * B = 1 := by simp [A, B]
  -- Some `p i₀ j₀ j₀ i₀` is nonzero, since these are the terms of the sum `(B * A) i₀ i₀ = 1`.
  obtain ⟨j₀, hj₀⟩ : ∃ j, p i₀ j j i₀ ≠ 0 := by
    by_contra! h0
    exact one_ne_zero <| hf <| by
      simpa [Matrix.mul_apply, ← hp, h0] using (congrFun₂ hBA i₀ i₀).symm
  -- The ideal generated by the `p i₀ j₀ k l` has a generator `d = ∑ r (k, l) * p i₀ j₀ k l`,
  -- and `p i₀ j₀ k l = c k l * d`.
  set I := Ideal.span (Set.range fun kl : n × n ↦ p i₀ j₀ kl.1 kl.2)
  obtain ⟨⟨d, hd⟩⟩ := IsBezout.isPrincipal_of_FG I (fg_span (Set.finite_range _))
  obtain ⟨r, hr⟩ := Ideal.mem_span_range_iff_exists_fun.mp (hd ▸ mem_span_singleton_self d : d ∈ I)
  have hpd (k l : n) : p i₀ j₀ k l ∈ O ∙ d := hd ▸ Ideal.subset_span ⟨(k, l), rfl⟩
  choose c hc using fun k l ↦ Ideal.mem_span_singleton'.mp (hpd k l)
  have hd0 : d ≠ 0 := by rintro rfl; simp [← hc] at hj₀
  -- With `α = ∑ r (k, l) * A k l`, every `B i j * α` is the image of `D i j`.
  set α : L := ∑ kl : n × n, f (r kl) * A kl.1 kl.2
  set D : Matrix n n O := Matrix.of fun i j ↦ ∑ kl : n × n, r kl * p i j kl.1 kl.2
  have hBα (i j : n) : B i j * α = f (D i j) := by
    simp [D, α, Finset.mul_sum, map_sum, hp, mul_left_comm]
  have hfd : f d = B i₀ j₀ * α := by rw [hBα, ← hr]; rfl
  -- `p i j k l = D i j * c k l`, after cancelling `d` in `O`.
  have hpDc (i j k l : n) : p i j k l = D i j * c k l := by
    refine mul_right_cancel₀ hd0 (hf ?_)
    calc f (p i j k l * d) = B i j * α * (B i₀ j₀ * A k l) := by rw [map_mul, hp, hfd]; ring
      _ = f (D i j * c k l * d) := by simp [mul_assoc, ← hBα, hc, hp]
  -- Left multiplication by all entries of `B` is injective on `L`, since `(A * B) i₀ i₀ = 1`.
  have hcancel {x y : L} (hxy : ∀ i j, B i j * x = B i j * y) : x = y := by
    have h1 : (A * B) i₀ i₀ = 1 := by simp [hAB]
    rw [← one_mul x, ← one_mul y, ← h1]
    simp only [Matrix.mul_apply, Finset.sum_mul, mul_assoc, hxy]
  have hA : A = α • (Matrix.of c).map f := by
    ext k l
    exact hcancel fun i j ↦ by simp [← hp, hpDc, ← hBα, mul_assoc]
  -- So `α` is a unit, with inverse an entry of `B * (Matrix.of c).map f`.
  have hα : IsUnit α := IsUnit.of_mul_eq_one ((B * (Matrix.of c).map f) i₀ i₀) <| by
    simpa [hA, Matrix.mul_smul] using congrFun₂ hBA i₀ i₀
  have hC : (Matrix.of c).map f = ((hα.unit⁻¹ : Lˣ) : L) • A := by simp [hA, smul_smul]
  have hD : D.map f = (hα.unit : L) • B := by ext; simp [← hBα, mul_comm]
  -- `Matrix.of c` and `D` are inverse to each other, since their images under `f` are.
  have hCD : Matrix.of c * D = 1 := Matrix.map_injective hf <| by simp [hC, hD, smul_smul, hAB]
  have hDC : D * Matrix.of c = 1 := Matrix.map_injective hf <| by simp [hC, hD, smul_smul, hBA]
  exact ⟨hα.unit, ⟨Matrix.of c, D, hCD, hDC⟩, by simpa using hA⟩

/-- Let `f : O →+* L` be an injective ring homomorphism from a Bézout domain, and let the `T i`
span `M_n(O)`. If `a ∈ GL_n(L)` conjugates every `(T i).map f` into the image of `M_n(O)`, then
`a = α • k.map f` for a unit `α` of `L` and some `k ∈ GL_n(O)`. -/
theorem exists_eq_smul_map_of_span_eq_top [Semiring O] [IsDomain O] [IsBezout O] [CommSemiring L]
    {f : O →+* L} (hf : Function.Injective f) {T : ι → Matrix n n O}
    (hT : span O (Set.range T) = ⊤) (a : GL n L)
    (ha : ∀ i, ((a⁻¹ : GL n L) : Matrix n n L) * (T i).map f * a ∈ Set.range (Matrix.map · f)) :
    ∃ (α : Lˣ) (k : GL n O), (a : Matrix n n L) = (α : L) • (k : Matrix n n O).map f :=
  exists_eq_smul_map_of_inv_apply_mul_apply_mem_range hf a
    (inv_apply_mul_apply_mem_range_of_span_eq_top f hT a ha)

end Matrix.GeneralLinearGroup
