/-!
# Neat linear automorphisms

A linear automorphism `g` of a vector space over a field `K` is *neat* when the subgroup of `Kˣ`
generated by its eigenvalues is torsion free. Neatness is the condition on arithmetic subgroups
of linear algebraic groups (and on compact open levels of their finite adelic points) under which
arithmetic quotients of symmetric spaces are manifolds rather than orbifolds: a neat element of
finite order is trivial, so a group of neat automorphisms is torsion free.

The eigenvalues are taken in `K` itself, so the notion is the classical one when `K` is
algebraically closed, for instance `K = ℂ` after extending scalars along an embedding of a number
field. All results requiring every eigenvalue to be visible assume `IsAlgClosed K`.

## Main declarations

* `LinearMap.GeneralLinearGroup.eigenvalueSubgroup`: the subgroup of `Kˣ` generated by the
  eigenvalues of a linear automorphism.
* `LinearMap.GeneralLinearGroup.IsNeat`: the eigenvalue subgroup is torsion free.
* `LinearMap.GeneralLinearGroup.isNeat_iff`: the elementwise form of neatness.
* `LinearMap.GeneralLinearGroup.isNeat_inv_iff`, `isNeat_conj_iff`,
  `isNeat_congrLinearEquiv_iff`: neatness is invariant under inversion, conjugation and transport
  along a linear equivalence.
* `LinearMap.GeneralLinearGroup.IsUnipotent.isNeat`: unipotent automorphisms are neat.
* `LinearMap.GeneralLinearGroup.IsNeat.pow`, `IsNeat.zpow`: powers of a neat automorphism of a
  finite-dimensional space over an algebraically closed field are neat.
* `LinearMap.GeneralLinearGroup.IsNeat.eq_one_of_isOfFinOrder`: over an algebraically closed field
  of characteristic zero, a neat automorphism of finite order is the identity.
* `LinearMap.GeneralLinearGroup.isMulTorsionFree_of_forall_isNeat`: a group acting faithfully by
  neat automorphisms is torsion free.

## References

* J. S. Milne, *Introduction to Shimura varieties*, §3, definition before Proposition 3.5, p. 34.
* A. Borel, *Introduction aux groupes arithmétiques*, §17.1.
-/

public section

namespace LinearMap.GeneralLinearGroup

open Module Pointwise

variable {K V W : Type*} [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]

section Field

/-- The subgroup of `Kˣ` generated by the eigenvalues of a linear automorphism. An eigenvalue of
an automorphism is never zero, so this is the group generated by all its eigenvalues in `K`. -/
def eigenvalueSubgroup (g : GeneralLinearGroup K V) : Subgroup Kˣ :=
  Subgroup.closure {z : Kˣ | Module.End.HasEigenvalue (g : End K V) z}

/-- The eigenvalue subgroup of `g` is the closure of the set of its eigenvalues. -/
theorem eigenvalueSubgroup_def (g : GeneralLinearGroup K V) :
    eigenvalueSubgroup g = Subgroup.closure {z : Kˣ | Module.End.HasEigenvalue (g : End K V) z} :=
  (rfl)

/-- An eigenvalue of `g` lies in its eigenvalue subgroup. -/
theorem mem_eigenvalueSubgroup_of_hasEigenvalue {g : GeneralLinearGroup K V} {z : Kˣ}
    (hz : Module.End.HasEigenvalue (g : End K V) z) : z ∈ eigenvalueSubgroup g :=
  Subgroup.subset_closure hz

/-- The eigenvalue subgroup of `g` lies in `H` exactly when every eigenvalue of `g` does. -/
theorem eigenvalueSubgroup_le_iff {g : GeneralLinearGroup K V} {H : Subgroup Kˣ} :
    eigenvalueSubgroup g ≤ H ↔ ∀ z : Kˣ, Module.End.HasEigenvalue (g : End K V) z → z ∈ H :=
  Subgroup.closure_le H

/-- A linear automorphism is *neat* when the subgroup of `Kˣ` generated by its eigenvalues is
torsion free. Over an algebraically closed field this is Borel's notion of a neat element. -/
def IsNeat (g : GeneralLinearGroup K V) : Prop :=
  IsMulTorsionFree (eigenvalueSubgroup g)

/-- Neatness of `g` means that its eigenvalue subgroup is torsion free. -/
theorem isNeat_def (g : GeneralLinearGroup K V) :
    IsNeat g ↔ IsMulTorsionFree (eigenvalueSubgroup g) :=
  Iff.rfl

/-- A linear automorphism is neat exactly when the only element of finite order in its
eigenvalue subgroup is `1`. -/
theorem isNeat_iff {g : GeneralLinearGroup K V} :
    IsNeat g ↔ ∀ z ∈ eigenvalueSubgroup g, IsOfFinOrder z → z = 1 := by
  rw [isNeat_def, isMulTorsionFree_iff_not_isOfFinOrder]
  refine ⟨fun h z hz hfin ↦ ?_, fun h z hz1 hfin ↦ hz1 ?_⟩
  · by_contra hz1
    exact h (a := ⟨z, hz⟩) (fun h1 ↦ hz1 (congrArg Subtype.val h1))
      (Submonoid.isOfFinOrder_coe.mp hfin)
  · exact Subtype.ext (h z z.property (Submonoid.isOfFinOrder_coe.mpr hfin))

/-- A neat automorphism has no eigenvalue of finite order other than `1`. -/
theorem IsNeat.eq_one_of_hasEigenvalue {g : GeneralLinearGroup K V} (hg : IsNeat g) {z : Kˣ}
    (hz : Module.End.HasEigenvalue (g : End K V) z) (hfin : IsOfFinOrder z) : z = 1 :=
  isNeat_iff.mp hg z (mem_eigenvalueSubgroup_of_hasEigenvalue hz) hfin

/-- An automorphism whose eigenvalue subgroup lies in that of a neat automorphism is neat. -/
theorem IsNeat.of_eigenvalueSubgroup_le {g h : GeneralLinearGroup K V}
    (hle : eigenvalueSubgroup g ≤ eigenvalueSubgroup h) (hh : IsNeat h) : IsNeat g :=
  isNeat_iff.mpr fun z hz hfin ↦ isNeat_iff.mp hh z (hle hz) hfin

/-- An automorphism with trivial eigenvalue subgroup is neat. -/
theorem isNeat_of_eigenvalueSubgroup_eq_bot {g : GeneralLinearGroup K V}
    (h : eigenvalueSubgroup g = ⊥) : IsNeat g :=
  isNeat_iff.mpr fun _ hz _ ↦ by rwa [h, Subgroup.mem_bot] at hz

/-- The eigenvalue subgroup of `g⁻¹` is that of `g`. -/
@[simp]
theorem eigenvalueSubgroup_inv (g : GeneralLinearGroup K V) :
    eigenvalueSubgroup g⁻¹ = eigenvalueSubgroup g := by
  have : {z : Kˣ | Module.End.HasEigenvalue ((g⁻¹ : GeneralLinearGroup K V) : End K V) z} =
      {z : Kˣ | Module.End.HasEigenvalue (g : End K V) z}⁻¹ := by
    ext z
    exact hasEigenvalue_inv_iff g z
  rw [eigenvalueSubgroup_def, this, Subgroup.closure_inv, eigenvalueSubgroup_def]

/-- An automorphism is neat exactly when its inverse is. -/
@[simp]
theorem isNeat_inv_iff (g : GeneralLinearGroup K V) : IsNeat g⁻¹ ↔ IsNeat g := by
  rw [isNeat_def, isNeat_def, eigenvalueSubgroup_inv]

/-- Transport along a linear equivalence preserves the eigenvalue subgroup. -/
theorem eigenvalueSubgroup_congrLinearEquiv (e : V ≃ₗ[K] W) (g : GeneralLinearGroup K V) :
    eigenvalueSubgroup (congrLinearEquiv e g) = eigenvalueSubgroup g := by
  simp only [eigenvalueSubgroup_def, hasEigenvalue_congrLinearEquiv_iff]

/-- Neatness is invariant under transport along a linear equivalence. -/
theorem isNeat_congrLinearEquiv_iff (e : V ≃ₗ[K] W) (g : GeneralLinearGroup K V) :
    IsNeat (congrLinearEquiv e g) ↔ IsNeat g := by
  rw [isNeat_def, isNeat_def, eigenvalueSubgroup_congrLinearEquiv]

/-- Conjugation preserves the eigenvalue subgroup. -/
@[simp]
theorem eigenvalueSubgroup_conj (g h : GeneralLinearGroup K V) :
    eigenvalueSubgroup (h * g * h⁻¹) = eigenvalueSubgroup g := by
  have hconj : congrLinearEquiv (toLinearEquiv h) g = h * g * h⁻¹ := by
    refine Units.ext <| LinearMap.ext fun v ↦ ?_
    have hinv : h.toLinearEquiv.symm v = ((h⁻¹ : GeneralLinearGroup K V) : End K V) v := by
      simp [← coe_toLinearEquiv, toLinearEquiv_inv]
    simp [hinv]
  rw [← hconj, eigenvalueSubgroup_congrLinearEquiv]

/-- Neatness is invariant under conjugation. -/
@[simp]
theorem isNeat_conj_iff (g h : GeneralLinearGroup K V) : IsNeat (h * g * h⁻¹) ↔ IsNeat g := by
  rw [isNeat_def, isNeat_def, eigenvalueSubgroup_conj]

/-- The eigenvalue subgroup of a unipotent automorphism is trivial. -/
theorem IsUnipotent.eigenvalueSubgroup_eq_bot {g : GeneralLinearGroup K V}
    (hg : IsUnipotent g) : eigenvalueSubgroup g = ⊥ :=
  le_bot_iff.mp <| eigenvalueSubgroup_le_iff.mpr fun _ hz ↦ by
    obtain ⟨v, hv⟩ := hz.exists_hasEigenvector
    exact Subgroup.mem_bot.mpr (Units.ext (hg.eigenvalue_eq_one hv.2 hv.apply_eq_smul))

/-- A unipotent automorphism is neat. -/
theorem IsUnipotent.isNeat {g : GeneralLinearGroup K V} (hg : IsUnipotent g) : IsNeat g :=
  isNeat_of_eigenvalueSubgroup_eq_bot hg.eigenvalueSubgroup_eq_bot

/-- The eigenvalue subgroup of the identity is trivial. -/
@[simp]
theorem eigenvalueSubgroup_one : eigenvalueSubgroup (1 : GeneralLinearGroup K V) = ⊥ :=
  isUnipotent_one.eigenvalueSubgroup_eq_bot

/-- The identity automorphism is neat. -/
@[simp]
theorem isNeat_one : IsNeat (1 : GeneralLinearGroup K V) :=
  isUnipotent_one.isNeat

end Field

section AlgClosed

variable [IsAlgClosed K] [FiniteDimensional K V]

/-- Over an algebraically closed field, every eigenvalue of a power `g ^ k` is a `k`-th power of
an eigenvalue of `g`, so the eigenvalue subgroup of `g ^ k` lies in that of `g`. -/
theorem eigenvalueSubgroup_pow_le (g : GeneralLinearGroup K V) (k : ℕ) :
    eigenvalueSubgroup (g ^ k) ≤ eigenvalueSubgroup g := by
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · simp
  refine eigenvalueSubgroup_le_iff.mpr fun z hz ↦ ?_
  rw [Module.End.hasEigenvalue_iff_mem_spectrum, Units.val_pow_eq_pow_val,
    spectrum.map_pow_of_pos _ hk] at hz
  obtain ⟨μ, hμ, hμz⟩ := hz
  have hμ0 : μ ≠ 0 := by
    rintro rfl
    exact z.ne_zero (by simpa [zero_pow hk.ne'] using hμz.symm)
  have hz : z = Units.mk0 μ hμ0 ^ k := Units.ext (by simpa using hμz.symm)
  rw [hz]
  exact Subgroup.pow_mem _ (mem_eigenvalueSubgroup_of_hasEigenvalue
    (Module.End.hasEigenvalue_iff_mem_spectrum.mpr hμ)) k

/-- Over an algebraically closed field, every natural power of a neat automorphism of a
finite-dimensional space is neat. -/
theorem IsNeat.pow {g : GeneralLinearGroup K V} (hg : IsNeat g) (k : ℕ) : IsNeat (g ^ k) :=
  hg.of_eigenvalueSubgroup_le (eigenvalueSubgroup_pow_le g k)

/-- Over an algebraically closed field, every integer power of a neat automorphism of a
finite-dimensional space is neat. -/
theorem IsNeat.zpow {g : GeneralLinearGroup K V} (hg : IsNeat g) (k : ℤ) : IsNeat (g ^ k) := by
  cases k with
  | ofNat k => simpa using hg.pow k
  | negSucc k => simpa [zpow_negSucc] using hg.pow (k + 1)

variable [CharZero K]

/-- **A neat automorphism of finite order is trivial.** Over an algebraically closed field of
characteristic zero, an automorphism of finite order of a finite-dimensional space is
diagonalizable with roots of unity as eigenvalues; neatness forces these eigenvalues to be `1`. -/
theorem IsNeat.eq_one_of_isOfFinOrder {g : GeneralLinearGroup K V} (hg : IsNeat g)
    (hfin : IsOfFinOrder g) : g = 1 := by
  obtain ⟨m, hm, hgm⟩ := isOfFinOrder_iff_pow_eq_one.mp hfin
  have hgm' : (g : End K V) ^ m = 1 := by rw [← Units.val_pow_eq_pow_val, hgm, Units.val_one]
  -- Every eigenvalue is an `m`-th root of unity, hence equal to `1` by neatness.
  have hev : ∀ μ : K, Module.End.HasEigenvalue (g : End K V) μ → μ = 1 := by
    intro μ hμ
    have hμm : μ ^ m = 1 := Module.End.pow_eq_one_of_hasEigenvalue hgm' hμ
    have hμ0 : μ ≠ 0 := by
      rintro rfl
      simp [zero_pow hm.ne'] at hμm
    have h1 := hg.eq_one_of_hasEigenvalue (z := Units.mk0 μ hμ0) hμ
      (isOfFinOrder_iff_pow_eq_one.mpr ⟨m, hm, Units.ext (by simpa using hμm)⟩)
    simpa using congr(($h1 : K))
  -- Since `X ^ m - 1` is squarefree in characteristic zero, `g` is semisimple.
  have hss : Module.End.IsSemisimple (g : End K V) :=
    Module.End.isSemisimple_of_pow_eq_one (by exact_mod_cast hm.ne') hgm'
  -- A semisimple endomorphism whose only eigenvalue is `1` is the identity.
  have hsub : (g : End K V) - algebraMap K (End K V) 1 = 0 := by
    refine (Module.End.isSemisimple_sub_algebraMap_iff.mpr hss).eq_zero_iff_forall_eigenvalue.mpr
      fun μ hμ ↦ ?_
    rw [Algebra.algebraMap_eq_smul_one, Module.End.one_eq_id,
      Module.End.hasEigenvalue_sub_iff] at hμ
    simpa using hev (μ + 1) hμ
  exact Units.ext (by simpa [sub_eq_zero] using hsub)

/-- A neat automorphism has finite order exactly when it is the identity. -/
theorem IsNeat.isOfFinOrder_iff {g : GeneralLinearGroup K V} (hg : IsNeat g) :
    IsOfFinOrder g ↔ g = 1 :=
  ⟨hg.eq_one_of_isOfFinOrder, fun h ↦ h ▸ IsOfFinOrder.one⟩

/-- **Neat groups are torsion free.** A group acting faithfully on a finite-dimensional space over
an algebraically closed field of characteristic zero, through neat automorphisms, is torsion
free. -/
theorem isMulTorsionFree_of_forall_isNeat {G : Type*} [Group G]
    (ρ : G →* GeneralLinearGroup K V) (hρ : Function.Injective ρ) (h : ∀ x, IsNeat (ρ x)) :
    IsMulTorsionFree G :=
  isMulTorsionFree_iff_not_isOfFinOrder.mpr fun x hx hfin ↦
    hx (hρ ((h x).eq_one_of_isOfFinOrder (ρ.isOfFinOrder hfin) |>.trans (map_one ρ).symm))

end AlgClosed

end LinearMap.GeneralLinearGroup
