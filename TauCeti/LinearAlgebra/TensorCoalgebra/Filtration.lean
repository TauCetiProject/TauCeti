/-!
# The conilpotence filtration of reduced tensor words

The reduced tensor coalgebra is filtered by tensor length, and reduced deconcatenation strictly
decreases that length: a word of length at most `n + 1` is cut into two words each of length at
most `n`.  This length bound is the inductive step behind conilpotence, which asserts that a high
enough iterate of the reduced coproduct annihilates every element.

The filtration is exhaustive and starts at the zero submodule, since the empty word is not a
reduced tensor word.  Its successive quotients are the words of a single length, onto which
`lengthProj` projects: a linear map vanishing on the words of length at most `n` sees a word of
length at most `n + 1` only through its top component.

## Main definitions

* `TauCeti.ReducedTensorWords.filtration`: the submodule generated by the tensor words of length
  at most `n`.
* `TauCeti.ReducedTensorWords.lengthProj`: the projection onto the words of length exactly `n`.

## Main results

* `TauCeti.ReducedTensorWords.iSup_filtration_eq_top` and
  `TauCeti.ReducedTensorWords.exists_mem_filtration`: the filtration is exhaustive.
* `TauCeti.ReducedTensorWords.exists_pow_apply_eq_zero_of_filtration_lowering`: a map lowering
  tensor length is locally nilpotent, also after composition with a length-preserving map.
* `TauCeti.ReducedTensorWords.ofLetter_mem_filtration` and
  `TauCeti.ReducedTensorWords.prepend_mem_filtration`: a letter has length one, and prepending a
  letter raises the length bound by one.
* `TauCeti.ReducedTensorWords.map_deconcatenation_filtration_succ_le`: deconcatenating a word of
  length at most `n + 1` produces a sum of tensors of two words of length at most `n`.
* `TauCeti.ReducedTensorWords.apply_eq_zero_of_mem_filtration_one`: a linear map vanishing on
  single letters vanishes on the words of length at most one.
* `TauCeti.ReducedTensorWords.map_deconcatenation_eq_zero_of_mem_filtration`: every cut of a word
  of length at most `a + b + 1` has a left half of length at most `a` or a right half of length
  at most `b`.
* `TauCeti.ReducedTensorWords.apply_lengthProj_of_mem_filtration`: a linear map vanishing on the
  words of length at most `n` agrees with its composite with the projection onto length `n + 1`
  on the words of length at most `n + 1`.

## References

* E. Getzler and J. D. S. Jones, *A-infinity algebras and the cyclic bar complex*, Sections 1--2.
* B. Keller, *Introduction to A-infinity algebras and modules*, Sections 3.1 and 3.6.
-/

public section

open scoped BigOperators DirectSum TensorProduct

universe uR uM

namespace TauCeti

namespace ReducedTensorWords

variable (R : Type uR) (M : Type uM) [CommSemiring R] [AddCommMonoid M] [Module R M]

/-- The `n`-th step of the conilpotence filtration: the submodule generated by the tensor words of
length at most `n`. -/
noncomputable def filtration (n : ℕ) : Submodule R (ReducedTensorWords R M) :=
  ⨆ (k : {k : ℕ // 0 < k}) (_ : k.1 ≤ n), LinearMap.range (of R M k)

/-- A tensor word of length at most `n` lies in the `n`-th step of the filtration. -/
theorem of_mem_filtration {k : {k : ℕ // 0 < k}} {n : ℕ} (hk : k.1 ≤ n)
    (x : TensorPower R k.1 M) : of R M k x ∈ filtration R M n :=
  Submodule.mem_iSup_of_mem k (Submodule.mem_iSup_of_mem hk ⟨x, rfl⟩)

/-- To prove that the `n`-th filtration step lies in a submodule, it suffices to check the
generating tensor powers of length at most `n`. -/
theorem filtration_le_iff {n : ℕ} {p : Submodule R (ReducedTensorWords R M)} :
    filtration R M n ≤ p ↔
      ∀ k : {k : ℕ // 0 < k}, k.1 ≤ n → LinearMap.range (of R M k) ≤ p := by
  rw [filtration, iSup₂_le_iff]

/-- The conilpotence filtration is increasing. -/
theorem filtration_monotone : Monotone (filtration R M) := fun _ _ hmn ↦
  biSup_mono fun _ hk ↦ hk.trans hmn

/-- A reduced tensor word has positive length, so the filtration starts at zero. -/
@[simp]
theorem filtration_zero : filtration R M 0 = ⊥ :=
  le_antisymm (iSup_le fun k ↦ iSup_le fun hk ↦ absurd (k.2.trans_le hk) (lt_irrefl 0)) bot_le

/-- Every linear map vanishes on the zero step of the filtration. -/
theorem apply_eq_zero_of_mem_filtration_zero {N : Type*} [AddCommMonoid N] [Module R N]
    (f : ReducedTensorWords R M →ₗ[R] N) : ∀ z ∈ filtration R M 0, f z = 0 := by
  intro z hz
  rw [filtration_zero, Submodule.mem_bot] at hz
  rw [hz, map_zero]

/-- The conilpotence filtration is exhaustive. -/
theorem iSup_filtration_eq_top : ⨆ n : ℕ, filtration R M n = ⊤ := by
  refine le_antisymm le_top ?_
  rw [← iSup_range_of]
  refine iSup_le fun k ↦ le_iSup_of_le k.1 ?_
  rintro _ ⟨x, rfl⟩
  exact of_mem_filtration R M le_rfl x

/-- Every reduced tensor word has bounded length: it lies in some step of the filtration. -/
theorem exists_mem_filtration (z : ReducedTensorWords R M) : ∃ n : ℕ, z ∈ filtration R M n := by
  have hz : z ∈ ⨆ n : ℕ, filtration R M n := by
    rw [iSup_filtration_eq_top]
    trivial
  exact (Submodule.mem_iSup_of_directed _ (filtration_monotone R M).directed_le).1 hz

/-- A map strictly lowering the tensor-length filtration is locally nilpotent. -/
theorem exists_pow_apply_eq_zero_of_filtration_lowering
    (f : Module.End R (ReducedTensorWords R M))
    (hf : ∀ n, Submodule.map f (filtration R M (n + 1)) ≤ filtration R M n)
    (z : ReducedTensorWords R M) : ∃ n, (f ^ n) z = 0 := by
  obtain ⟨n, hn⟩ := exists_mem_filtration R M z
  refine ⟨n, ?_⟩
  induction n generalizing z with
  | zero =>
      rw [filtration_zero] at hn
      have : z = 0 := hn
      simp [this]
  | succ n ih =>
      have hfz : f z ∈ filtration R M n := hf n ⟨z, hn, rfl⟩
      simpa only [pow_succ, Module.End.mul_apply] using ih (f z) hfz

/-- Composing a strictly length-lowering map with a length-preserving map remains locally
nilpotent. -/
theorem exists_pow_comp_apply_eq_zero_of_filtration_lowering
    (f h : Module.End R (ReducedTensorWords R M))
    (hf : ∀ n, Submodule.map f (filtration R M (n + 1)) ≤ filtration R M n)
    (hh : ∀ n, Submodule.map h (filtration R M n) ≤ filtration R M n)
    (z : ReducedTensorWords R M) : ∃ n, ((f ∘ₗ h) ^ n) z = 0 := by
  apply exists_pow_apply_eq_zero_of_filtration_lowering R M (f ∘ₗ h)
  intro n
  rintro _ ⟨x, hx, rfl⟩
  exact hf n ⟨h x, hh (n + 1) ⟨x, hx, rfl⟩, rfl⟩

/-- A block of length at most `n` lies in the `n`-th step of the filtration. -/
theorem subword_mem_filtration {l : ℕ} (x : Fin l → M) (a : ℕ) {b n : ℕ} (hb : b ≤ n) :
    subword R x a b ∈ filtration R M n := by
  rcases Nat.eq_zero_or_pos b with hb0 | hb0
  · rw [hb0, subword_length_zero]
    exact Submodule.zero_mem _
  by_cases hab : a + b ≤ l
  · rw [subword_eq_of_tprod R x hb0 hab]
    exact of_mem_filtration R M hb _
  · rw [subword_eq_zero_of_lt_add R x (by omega)]
    exact Submodule.zero_mem _

/-- A single letter is a word of length at most one. -/
theorem ofLetter_mem_filtration (a : M) : ofLetter R M a ∈ filtration R M 1 := by
  have h := subword_mem_filtration R M (fun _ : Fin 1 ↦ a) 0 (le_refl 1)
  rwa [subword_one R M _ Nat.one_pos] at h

/-- A linear map vanishing on single letters vanishes on the words of length at most one. -/
theorem apply_eq_zero_of_mem_filtration_one {N : Type*} [AddCommMonoid N] [Module R N]
    {f : ReducedTensorWords R M →ₗ[R] N} (hf : f ∘ₗ ofLetter R M = 0) :
    ∀ z ∈ filtration R M 1, f z = 0 := by
  have h : filtration R M 1 ≤ LinearMap.ker f := by
    rw [filtration_le_iff]
    intro k hk
    obtain rfl : k = 1 := Subtype.ext (by have := k.2; omega : k.1 = 1)
    rw [LinearMap.range_le_ker_iff]
    refine PiTensorProduct.ext (MultilinearMap.ext fun x ↦ ?_)
    have hx : x = fun _ ↦ x ⟨0, Nat.one_pos⟩ :=
      funext fun i ↦ congrArg x (Fin.ext (Nat.lt_one_iff.mp i.isLt))
    simp only [LinearMap.compMultilinearMap_apply, LinearMap.comp_apply, LinearMap.zero_apply]
    rw [hx, ← ofLetter_eq_of_tprod, ← LinearMap.comp_apply f, hf, LinearMap.zero_apply]
  exact fun z hz ↦ h hz

/-- Prepending a letter to a word of length at most `n` gives a word of length at most `n + 1`. -/
theorem prepend_mem_filtration (a : M) {n : ℕ} {z : ReducedTensorWords R M}
    (hz : z ∈ filtration R M n) : prepend R M a z ∈ filtration R M (n + 1) := by
  have h : filtration R M n ≤ (filtration R M (n + 1)).comap (prepend R M a) := by
    rw [filtration_le_iff]
    rintro k hk _ ⟨x, rfl⟩
    simp only [Submodule.mem_comap]
    induction x using PiTensorProduct.induction_on with
    | smul_tprod r y =>
        rw [map_smul, map_smul, prepend_of_tprod]
        exact Submodule.smul_mem _ _ (of_mem_filtration R M (Nat.succ_le_succ hk) _)
    | add u v hu hv =>
        rw [map_add, map_add]
        exact Submodule.add_mem _ hu hv
  exact h hz

/-- Reduced deconcatenation strictly decreases tensor length: a word of length at most `n + 1` is
sent into the image of `filtration n ⊗ filtration n`.  This is the length-lowering step behind the
conilpotence of the reduced tensor coalgebra. -/
theorem map_deconcatenation_filtration_succ_le (n : ℕ) :
    Submodule.map (deconcatenation R M) (filtration R M (n + 1)) ≤
      LinearMap.range (TensorProduct.mapIncl (filtration R M n) (filtration R M n)) := by
  rw [TensorProduct.range_mapIncl, Submodule.map_le_iff_le_comap, filtration_le_iff]
  intro k hk
  rintro _ ⟨z, rfl⟩
  simp only [Submodule.mem_comap]
  induction z using PiTensorProduct.induction_on with
  | smul_tprod r y =>
      rw [map_smul, map_smul, of_tprod_eq_subword R k.2 y,
        deconcatenation_subword R y (a := 0) (b := k.1)]
      refine Submodule.smul_mem _ _ (Submodule.sum_mem _ fun c hc ↦ ?_)
      simp only [Finset.mem_Ioo] at hc
      exact Submodule.apply_mem_map₂ _ (subword_mem_filtration R M y 0 (by omega))
        (subword_mem_filtration R M y (0 + c) (by omega))
  | add u v hu hv =>
      rw [map_add, map_add]
      exact Submodule.add_mem _ hu hv

/-- Every cut of a word of length at most `a + b + 1` has a left half of length at most `a` or a
right half of length at most `b`.  Hence mapping the two halves of the cuts by maps vanishing on
the words of length at most `a` and at most `b` respectively annihilates the deconcatenation of
such a word. -/
theorem map_deconcatenation_eq_zero_of_mem_filtration {P Q : Type*} [AddCommMonoid P]
    [Module R P] [AddCommMonoid Q] [Module R Q] {f : ReducedTensorWords R M →ₗ[R] P}
    {g : ReducedTensorWords R M →ₗ[R] Q} {a b : ℕ} (hf : ∀ z ∈ filtration R M a, f z = 0)
    (hg : ∀ z ∈ filtration R M b, g z = 0) {z : ReducedTensorWords R M}
    (hz : z ∈ filtration R M (a + b + 1)) :
    TensorProduct.map f g (deconcatenation R M z) = 0 := by
  have h : filtration R M (a + b + 1) ≤
      LinearMap.ker (TensorProduct.map f g ∘ₗ deconcatenation R M) := by
    rw [filtration_le_iff]
    intro k hk
    rw [LinearMap.range_le_ker_iff]
    refine PiTensorProduct.ext (MultilinearMap.ext fun x ↦ ?_)
    simp only [LinearMap.compMultilinearMap_apply, LinearMap.comp_apply, LinearMap.zero_apply]
    rw [of_tprod_eq_subword R k.2 x, map_deconcatenation_subword]
    refine Finset.sum_eq_zero fun c hc ↦ ?_
    rw [Finset.mem_range] at hc
    by_cases hca : c ≤ a
    · rw [hf _ (subword_mem_filtration R M x 0 hca), TensorProduct.zero_tmul]
    · rw [hg _ (subword_mem_filtration R M x (0 + c) (by omega)), TensorProduct.tmul_zero]
  exact h hz

/-! ### Projection onto a fixed length -/

/-- The projection of reduced tensor words onto the words of length exactly `n`, discarding the
components of every other length. -/
noncomputable def lengthProj (n : {n : ℕ // 0 < n}) :
    ReducedTensorWords R M →ₗ[R] ReducedTensorWords R M :=
  of R M n ∘ₗ component R M n

/-- The length projection reads off the component of length `n` and includes it back. -/
theorem lengthProj_apply (n : {n : ℕ // 0 < n}) (z : ReducedTensorWords R M) :
    lengthProj R M n z = of R M n (component R M n z) :=
  (rfl)

/-- The length projection fixes the words of its own length. -/
@[simp]
theorem lengthProj_of_self (n : {n : ℕ // 0 < n}) (x : TensorPower R n.1 M) :
    lengthProj R M n (of R M n x) = of R M n x := by
  rw [lengthProj_apply, component_of]

/-- The length projection kills the words of any other length. -/
@[simp]
theorem lengthProj_of_of_ne {m n : {n : ℕ // 0 < n}} (h : m ≠ n) (x : TensorPower R m.1 M) :
    lengthProj R M n (of R M m x) = 0 := by
  rw [lengthProj_apply, component_of_of_ne R M h, map_zero]

/-- The length projection is idempotent. -/
@[simp]
theorem lengthProj_lengthProj (n : {n : ℕ // 0 < n}) (z : ReducedTensorWords R M) :
    lengthProj R M n (lengthProj R M n z) = lengthProj R M n z := by
  rw [lengthProj_apply R M n z, lengthProj_of_self]

/-- Projections onto two different lengths are orthogonal. -/
theorem lengthProj_lengthProj_of_ne {m n : {n : ℕ // 0 < n}} (h : m ≠ n)
    (z : ReducedTensorWords R M) : lengthProj R M n (lengthProj R M m z) = 0 := by
  rw [lengthProj_apply R M m z, lengthProj_of_of_ne R M h]

/-- A word of length exactly `n` has length at most `n`. -/
theorem lengthProj_mem_filtration (n : {n : ℕ // 0 < n}) (z : ReducedTensorWords R M) :
    lengthProj R M n z ∈ filtration R M n.1 :=
  of_mem_filtration R M le_rfl _

/-- The words of length at most `k` have no component of a larger length `n`. -/
theorem lengthProj_apply_eq_zero_of_mem_filtration {n : {n : ℕ // 0 < n}} {k : ℕ} (hk : k < n.1)
    {z : ReducedTensorWords R M} (hz : z ∈ filtration R M k) : lengthProj R M n z = 0 := by
  have h : filtration R M k ≤ LinearMap.ker (lengthProj R M n) := by
    rw [filtration_le_iff]
    rintro m hm _ ⟨x, rfl⟩
    rw [LinearMap.mem_ker, lengthProj_of_of_ne R M fun h ↦ by subst h; omega]
  exact h hz

/-- A linear map vanishing on the words of length at most `n` sees a word of length at most
`n + 1` only through its component of length `n + 1`. -/
theorem apply_lengthProj_of_mem_filtration {N : Type*} [AddCommMonoid N] [Module R N]
    {f : ReducedTensorWords R M →ₗ[R] N} {n : ℕ} (hf : ∀ z ∈ filtration R M n, f z = 0)
    {z : ReducedTensorWords R M} (hz : z ∈ filtration R M (n + 1)) :
    f (lengthProj R M ⟨n + 1, n.succ_pos⟩ z) = f z := by
  have h : filtration R M (n + 1) ≤
      LinearMap.eqLocus (f ∘ₗ lengthProj R M ⟨n + 1, n.succ_pos⟩) f := by
    rw [filtration_le_iff]
    rintro k hk _ ⟨x, rfl⟩
    rw [LinearMap.mem_eqLocus, LinearMap.comp_apply]
    by_cases hkn : k = ⟨n + 1, n.succ_pos⟩
    · subst hkn
      rw [lengthProj_of_self]
    · rw [lengthProj_of_of_ne R M hkn, map_zero,
        hf _ (of_mem_filtration R M
          (by have : k.1 ≠ n + 1 := fun h ↦ hkn (Subtype.ext h); omega) x)]
  exact h hz

end ReducedTensorWords

end TauCeti
