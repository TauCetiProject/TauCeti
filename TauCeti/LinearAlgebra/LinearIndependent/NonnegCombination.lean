module

public import TauCeti.LinearAlgebra.Finsupp.LinearCombination
public import TauCeti.Data.Finsupp.Multiset

/-!
# Nonnegative integer combinations of a family

A sum `v l₀ + ⋯ + v lₙ₋₁` of members of a family `v` along a list `l` is the linear combination of
`v` whose coefficients count the letters of `l`, and an element of the additive subsemigroup
generated by the members of `v` is a linear combination of `v` with nonnegative integer
coefficients (`List.sum_map_eq_linearCombination` and
`AddSubsemigroup.exists_nonneg_linearCombination_eq_of_mem_closure_range`, in
`TauCeti.LinearAlgebra.Finsupp.LinearCombination`). For a linearly independent family these
coefficients are unique, so a sum along a list equal to `m` times a member `v i` is a sum of `m`
copies of `v i`, and no positive multiple of a member is a sum of negated members.

## Main results

* `LinearIndependent.eq_replicate_of_sum_map_eq_nsmul`: for an independent family, a list along
  which `v` sums to `m • v i` is `m` copies of `i`.
* `LinearIndependent.nsmul_notMem_closure_range_neg`: for a family independent over `ℤ`, a
  positive multiple `m • v i` is not a sum of negated members of `v`.
-/

public section

variable {ι R M : Type*}

namespace LinearIndependent

/-- For a family linearly independent over a semiring of characteristic zero, a list along which
the family sums to `m` times its member `v i` is the list of `m` copies of `i`. -/
theorem eq_replicate_of_sum_map_eq_nsmul [Semiring R] [CharZero R] [AddCommMonoid M] [Module R M]
    {v : ι → M} (hv : LinearIndependent R v) {l : List ι} {i : ι} {m : ℕ}
    (hl : (l.map v).sum = m • v i) :
    l = List.replicate m i := by
  refine List.eq_replicate_of_sum_map_single_one_eq (R := R)
    (hv.finsuppLinearCombination_injective ?_)
  rw [← List.sum_map_eq_linearCombination, Finsupp.linearCombination_single,
    Nat.cast_smul_eq_nsmul]
  exact hl

/-- For a family linearly independent over `ℤ`, no positive multiple of a member of the family is
a sum of negated members. -/
theorem nsmul_notMem_closure_range_neg [AddCommGroup M] {v : ι → M}
    (hv : LinearIndependent ℤ v) (i : ι) {m : ℕ} (hm : m ≠ 0) :
    m • v i ∉ AddSubsemigroup.closure (Set.range (-v)) := by
  intro hmem
  obtain ⟨n, hn, hx⟩ :=
    AddSubsemigroup.exists_nonneg_linearCombination_eq_of_mem_closure_range hmem
  have hneg : Finsupp.linearCombination ℤ (-v) n = -Finsupp.linearCombination ℤ v n := by
    simp [Finsupp.linearCombination_apply]
  have hsum : Finsupp.linearCombination ℤ v (Finsupp.single i (m : ℤ) + n) = 0 := by
    rw [map_add, Finsupp.linearCombination_single, natCast_zsmul, ← hx, hneg, neg_add_cancel]
  have h0 := congr($(hv.finsuppLinearCombination_injective (hsum.trans (map_zero _).symm)) i)
  simp only [Finsupp.add_apply, Finsupp.single_eq_same, Finsupp.coe_zero, Pi.zero_apply] at h0
  have := hn i
  omega

end LinearIndependent
