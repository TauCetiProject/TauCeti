module

public import TauCeti.LinearAlgebra.Finsupp.LinearCombination
public import TauCeti.Data.Finsupp.Multiset
import Mathlib.Data.List.Permutation

/-!
# Nonnegative integer combinations of a family

A sum `v l₀ + ⋯ + v lₙ₋₁` of members of a family `v` along a list `l` is the linear combination of
`v` whose coefficients count the letters of `l`, and an element of the additive subsemigroup
generated by the members of `v` is a linear combination of `v` with nonnegative integer
coefficients (`List.sum_map_eq_linearCombination` and
`AddSubsemigroup.exists_nonneg_linearCombination_eq_of_mem_closure_range`, in
`TauCeti.LinearAlgebra.Finsupp.LinearCombination`). For a linearly independent family these
coefficients are unique, so two lists with the same sum are permutations of each other, only
finitely many lists sum to any given target element, a sum along a list equal to `m` times a
member `v i` is a sum of `m` copies of `v i`, and no positive multiple of a member is a sum of
negated members.

## Main results

* `LinearIndependent.perm_of_sum_map_eq`: for an independent family over a characteristic-zero
  semiring, two lists with the same sum are permutations of each other.
* `LinearIndependent.finite_setOf_sum_map_eq`: only finitely many lists of indices sum to any
  given target element, even when the index type is infinite.
* `LinearIndependent.eq_replicate_of_sum_map_eq_nsmul`: for an independent family, a list along
  which `v` sums to `m • v i` is `m` copies of `i`.
* `LinearIndependent.nsmul_notMem_closure_range_neg`: for a family independent over `ℤ`, a
  positive multiple `m • v i` is not a sum of negated members of `v`.
* `LinearIndependent.zero_notMem_closure_range`: for a family independent over `ℤ`, zero is not a
  nonempty sum of members of `v`.
-/

public section

variable {ι R M : Type*}

namespace LinearIndependent

/-- For a family linearly independent over a semiring of characteristic zero, two lists along which
the family has the same sum are permutations of each other. -/
theorem perm_of_sum_map_eq [Semiring R] [CharZero R] [AddCommMonoid M] [Module R M]
    {v : ι → M} (hv : LinearIndependent R v) {l₁ l₂ : List ι}
    (h : (l₁.map v).sum = (l₂.map v).sum) :
    l₁.Perm l₂ := by
  classical
  have hsum : (l₁.map fun k => Finsupp.single k (1 : R)).sum =
      (l₂.map fun k => Finsupp.single k (1 : R)).sum := by
    apply hv.finsuppLinearCombination_injective
    rw [← List.sum_map_eq_linearCombination, ← List.sum_map_eq_linearCombination, h]
  rw [List.perm_iff_count]
  intro a
  have ha := congrArg (fun f : ι →₀ R => f a) hsum
  simpa [List.sum_map_single_one_apply] using ha

/-- For a family linearly independent over a semiring of characteristic zero, only finitely many
lists of indices have their images summing to a given element `x`, without assuming the index type
`ι` is finite. -/
theorem finite_setOf_sum_map_eq [Semiring R] [CharZero R] [AddCommMonoid M] [Module R M]
    {v : ι → M} (hv : LinearIndependent R v) (x : M) :
    {l : List ι | (l.map v).sum = x}.Finite := by
  rcases Set.eq_empty_or_nonempty {l : List ι | (l.map v).sum = x} with hempty | ⟨l₀, hl₀⟩
  · rw [hempty]; exact Set.finite_empty
  · exact (l₀.permutations.finite_toSet).subset fun l hl =>
      List.mem_permutations.2 (hv.perm_of_sum_map_eq (hl.trans hl₀.symm))

/-- For a family linearly independent over a semiring of characteristic zero, a list along which
the family sums to `m` times its member `v i` is the list of `m` copies of `i`. -/
theorem eq_replicate_of_sum_map_eq_nsmul [Semiring R] [CharZero R] [AddCommMonoid M] [Module R M]
    {v : ι → M} (hv : LinearIndependent R v) {l : List ι} {i : ι} {m : ℕ}
    (hl : (l.map v).sum = m • v i) :
    l = List.replicate m i := by
  refine List.eq_replicate_of_sum_map_single_one_eq (R := R)
    (hv.finsuppLinearCombination_injective ?_)
  rw [← List.sum_map_eq_linearCombination, Finsupp.linearCombination_single,
    Nat.cast_smul_eq_nsmul]
  exact hl

/-- For a family linearly independent over `ℤ`, no positive multiple of a member of the family is
a sum of negated members. -/
theorem nsmul_notMem_closure_range_neg [AddCommGroup M] {v : ι → M}
    (hv : LinearIndependent ℤ v) (i : ι) {m : ℕ} (hm : m ≠ 0) :
    m • v i ∉ AddSubsemigroup.closure (Set.range (-v)) := by
  intro hmem
  obtain ⟨n, hn, hx⟩ :=
    AddSubsemigroup.exists_nonneg_linearCombination_eq_of_mem_closure_range ℤ hmem
  have hneg : Finsupp.linearCombination ℤ (-v) n = -Finsupp.linearCombination ℤ v n := by
    simp [Finsupp.linearCombination_apply]
  have hsum : Finsupp.linearCombination ℤ v (Finsupp.single i (m : ℤ) + n) = 0 := by
    rw [map_add, Finsupp.linearCombination_single, natCast_zsmul, ← hx, hneg, neg_add_cancel]
  have h0 := congr($(hv.finsuppLinearCombination_injective (hsum.trans (map_zero _).symm)) i)
  simp only [Finsupp.add_apply, Finsupp.single_eq_same, Finsupp.coe_zero, Pi.zero_apply] at h0
  have := hn i
  omega

/-- For a family linearly independent over `ℤ`, zero is not a nonempty sum of members: such a sum
would express the negative of a member as a sum of members, or would make a member zero. -/
theorem zero_notMem_closure_range [AddCommGroup M] {v : ι → M} (hv : LinearIndependent ℤ v) :
    (0 : M) ∉ AddSubsemigroup.closure (Set.range v) := by
  have key {x : M} (hx : x ∈ AddSubsemigroup.closure (Set.range v)) :
      ∃ i, x = v i ∨ x - v i ∈ AddSubsemigroup.closure (Set.range v) := by
    induction hx using AddSubsemigroup.closure_induction with
    | mem _ hx =>
      obtain ⟨i, rfl⟩ := hx
      exact ⟨i, .inl rfl⟩
    | add x y hx hy ih _ =>
      obtain ⟨i, rfl | hi⟩ := ih
      · exact ⟨i, .inr (by simpa using hy)⟩
      · exact ⟨i, .inr (by simpa [sub_add_eq_add_sub] using add_mem hi hy)⟩
  intro h0
  obtain ⟨i, hi | hi⟩ := key h0
  · exact hv.ne_zero i hi.symm
  · exact hv.neg.nsmul_notMem_closure_range_neg i one_ne_zero (by simpa using hi)

end LinearIndependent
