/-!
# Characteristic polynomials and unipotence of transvections

Mathlib's `LinearMap.transvection f v` is the map `x ↦ x + f x • v`. Its linear equivalences form
the set `LinearEquiv.dilatransvections R V`, which over a division ring consists of the
automorphisms `g` with `g - 1` of rank at most one, and the subset `LinearEquiv.transvections R V`
of those with `f v = 0`. A *pseudo-reflection* is an element of `dilatransvections` other than the
identity, and a (proper) *transvection* is an element of `transvections` other than the identity.

This file computes the invariants that distinguish the two classes: the displacement
`g - 1 = (x ↦ f x • v)` satisfies `(g - 1) ^ 2 = f v • (g - 1)`, and the characteristic
polynomial of `transvection f v` on a free module of rank `n ≥ 1` is
`(X - 1) ^ (n - 1) * (X - (1 + f v))`. Consequently, for a pseudo-reflection `g`:

* `g` is a transvection exactly when `det g = 1`, exactly when `g` is unipotent, and then its
  characteristic polynomial is `(X - 1) ^ n`;
* otherwise `g` is diagonalisable: `V` is the direct sum of the fixed hyperplane of `g` and the
  line on which `g` acts by `det g ≠ 1`.

Both classes are stable under conjugation (also by an isomorphism onto another module), and
under extension of scalars, which preserves being different from the identity when the extension
is faithfully flat, for instance a field extension (`LinearEquiv.baseChange_eq_one_iff` in
`TauCeti.LinearAlgebra.LinearMap.BaseChange`). Mathlib already records stability under inverses
(`LinearEquiv.inv_mem_dilatransvections_iff`, `LinearEquiv.inv_mem_transvections_iff`) and the
base change of dilatransvections (`LinearEquiv.dilatransvection.baseChange`).

These are the facts used to recognise the local monodromy of a hypergeometric local system at
`1`, which differs from the identity by a rank-one map, and to identify the finite groups
generated by transvections.

## Main results

* `LinearMap.transvection.sub_one_sq`: `(transvection f v - 1) ^ 2 = f v • (transvection f v - 1)`.
* `LinearMap.toMatrix_transvection`: the matrix of `transvection f v` in a basis is the identity
  plus the rank-one matrix `vecMulVec (b.repr v) (f ∘ b)`.
* `LinearMap.transvection.charpoly`: the characteristic polynomial of `transvection f v` is
  `(X - 1) ^ (n - 1) * (X - C (1 + f v))`.
* `LinearEquiv.charpoly_of_mem_dilatransvections`, `LinearEquiv.charpoly_of_mem_transvections`:
  the characteristic polynomials of dilatransvections and transvections.
* `LinearEquiv.mem_transvections_iff_det_eq_one`: a dilatransvection is a transvection exactly
  when its determinant is `1`.
* `LinearEquiv.mem_transvections_iff_isNilpotent_sub_one`: a dilatransvection over a division
  ring is a transvection exactly when it is unipotent.
* `LinearEquiv.isCompl_fixedSubmodule_eigenspace_det`: a dilatransvection that is not a
  transvection is diagonalisable, with the fixed hyperplane and the `det`-eigenline as
  complementary eigenspaces.
* `LinearEquiv.conj_mem_dilatransvections_iff`, `LinearEquiv.conj_mem_transvections_iff`:
  stability under conjugation.
* `LinearEquiv.baseChange_mem_transvections`: stability under extension of scalars.

## References

* F. Beukers, G. Heckman, *Monodromy for the hypergeometric function `ₙF_{n-1}`*, Invent. Math.
  95 (1989), 325–354, Definition 2.9.
* L. Qian, *Potential automorphy for `GL_n`*, Invent. Math. 231 (2023), 1239–1275, Lemmas 3.3(3)
  and 3.4 (numbering of arXiv:2104.09761v1).
-/

public section

open Module Polynomial

open scoped TensorProduct

namespace LinearMap

namespace transvection

section Ring

variable {R V : Type*} [Ring R] [AddCommGroup V] [Module R V]

/-- The displacement `transvection f v - 1` is the rank-one map `x ↦ f x • v`. -/
theorem sub_one_apply (f : Dual R V) (v x : V) : (transvection f v - 1) x = f x • v := by
  rw [LinearMap.sub_apply, one_apply_eq_self, apply, add_sub_cancel_left]

/-- The powers of the displacement of a transvection: `(transvection f v - 1) ^ (k + 1)` sends
`x` to `(f x * f v ^ k) • v`. -/
theorem sub_one_pow_succ_apply (f : Dual R V) (v x : V) (k : ℕ) :
    ((transvection f v - 1) ^ (k + 1)) x = (f x * f v ^ k) • v := by
  induction k with
  | zero => rw [zero_add, pow_one, sub_one_apply, pow_zero, mul_one]
  | succ k ih =>
    rw [pow_succ', mul_apply_eq_comp, ih, sub_one_apply, map_smul, smul_eq_mul, mul_assoc,
      ← pow_succ]

end Ring

section CommRing

variable {R V : Type*} [CommRing R] [AddCommGroup V] [Module R V]

/-- The displacement `g - 1` of `g = transvection f v` satisfies `(g - 1) ^ 2 = f v • (g - 1)`.
In particular it is nilpotent when `f v = 0`, and `g` is annihilated by `(X - 1) * (X - 1 - f v)`
otherwise. -/
theorem sub_one_sq (f : Dual R V) (v : V) :
    (transvection f v - 1) ^ 2 = f v • (transvection f v - 1) := by
  ext x
  rw [sub_one_pow_succ_apply, LinearMap.smul_apply, sub_one_apply, smul_smul, pow_one, mul_comm]

end CommRing

end transvection

section Matrix

variable {R V : Type*} [CommRing R] [AddCommGroup V] [Module R V]

/-- In a basis `b`, the matrix of `transvection f v` is the identity plus the rank-one matrix
with entries `b.repr v i * f (b j)`. -/
theorem toMatrix_transvection {ι : Type*} [Fintype ι] [DecidableEq ι] (b : Basis ι R V)
    (f : Dual R V) (v : V) :
    toMatrix b b (transvection f v) = 1 + Matrix.vecMulVec (b.repr v) (fun j ↦ f (b j)) := by
  ext i j
  simp [toMatrix_apply, transvection.apply, Matrix.one_apply, Matrix.vecMulVec_apply,
    Finsupp.single_apply, mul_comm, eq_comm]

end Matrix

namespace transvection

variable {R V : Type*} [CommRing R] [AddCommGroup V] [Module R V] [Free R V] [Module.Finite R V]

/-- The characteristic polynomial of `transvection f v` on a free module of rank `n`, in the form
`(X - 1) ^ n - f v * (X - 1) ^ (n - 1)`, valid also for `n = 0`. -/
private theorem charpoly_eq_sub (f : Dual R V) (v : V) :
    (transvection f v).charpoly =
      (X - 1) ^ finrank R V - C (f v) * (X - 1) ^ (finrank R V - 1) := by
  classical
  rcases subsingleton_or_nontrivial R with hR | hR
  · exact Subsingleton.elim _ _
  let b := Module.finBasis R V
  have hdot : b.repr v ⬝ᵥ (fun j ↦ f (b j)) = f v := by
    conv_rhs => rw [← b.sum_repr v]
    simp only [dotProduct, map_sum, map_smul, smul_eq_mul]
  have hmat : (1 : Matrix (Fin (finrank R V)) (Fin (finrank R V)) R) +
      Matrix.vecMulVec (b.repr v) (fun j ↦ f (b j)) =
      Matrix.vecMulVec (b.repr v) (fun j ↦ f (b j)) - Matrix.scalar _ (-1 : R) := by
    rw [map_neg, sub_neg_eq_add, map_one, add_comm]
  rw [← LinearMap.charpoly_toMatrix _ b, toMatrix_transvection, hmat, Matrix.charpoly_sub_scalar,
    Matrix.charpoly_vecMulVec, hdot, Fintype.card_fin]
  simp [smul_eq_C_mul, sub_eq_add_neg]

/-- The characteristic polynomial of `transvection f v` on a nonzero free module of rank `n` is
`(X - 1) ^ (n - 1) * (X - (1 + f v))`; compare `LinearMap.transvection.det`. -/
theorem charpoly [Nontrivial V] (f : Dual R V) (v : V) :
    (transvection f v).charpoly = (X - 1) ^ (finrank R V - 1) * (X - C (1 + f v)) := by
  have : Nontrivial R := Module.nontrivial R V
  obtain ⟨n, hn⟩ := Nat.exists_eq_add_of_lt
    ((Module.finrank_pos_iff_of_free (R := R) (M := V)).mpr inferInstance)
  rw [charpoly_eq_sub, hn, Nat.zero_add, Nat.add_sub_cancel, pow_succ, C_add, map_one]
  ring

/-- If `f v = 0`, the characteristic polynomial of `transvection f v` is `(X - 1) ^ n`. -/
theorem charpoly_of_apply_eq_zero {f : Dual R V} {v : V} (hfv : f v = 0) :
    (transvection f v).charpoly = (X - 1) ^ finrank R V := by
  rw [charpoly_eq_sub, hfv, map_zero, zero_mul, sub_zero]

section DivisionRing

variable {K V : Type*} [DivisionRing K] [AddCommGroup V] [Module K V]

/-- For `v ≠ 0`, the fixed submodule of `transvection f v` is `ker f`, a hyperplane when
`f ≠ 0`. -/
theorem fixedSubmodule_eq_ker {f : Dual K V} {v : V} (hv : v ≠ 0) :
    (transvection f v).fixedSubmodule = LinearMap.ker f := by
  ext x
  simp [apply, hv]

end DivisionRing

section CommRing

variable {R V : Type*} [CommRing R] [AddCommGroup V] [Module R V]

/-- If `f v` is a unit, the eigenspace of `transvection f v` for the eigenvalue `1 + f v` is the
line spanned by `v`. -/
theorem eigenspace_one_add_apply {f : Dual R V} {v : V} (hfv : IsUnit (f v)) :
    Module.End.eigenspace (transvection f v) (1 + f v) = R ∙ v := by
  ext x
  rw [Module.End.mem_eigenspace_iff, apply, add_smul, one_smul, add_right_inj,
    Submodule.mem_span_singleton]
  refine ⟨fun h ↦ ⟨hfv.unit⁻¹ * f x, ?_⟩, fun ⟨a, ha⟩ ↦ ?_⟩
  · rw [mul_smul, h, ← smul_assoc, smul_eq_mul, IsUnit.val_inv_mul, one_smul]
  · rw [← ha, map_smul, smul_eq_mul, mul_smul, smul_comm]

end CommRing

end transvection

end LinearMap

namespace LinearEquiv

section Ring

variable {R V W : Type*} [Ring R] [AddCommGroup V] [Module R V] [AddCommGroup W] [Module R W]

/-- The displacement of a transvection squares to zero. -/
theorem sub_one_sq_eq_zero_of_mem_transvections {e : V ≃ₗ[R] V} (he : e ∈ transvections R V) :
    ((e : Module.End R V) - 1) ^ 2 = 0 := by
  obtain ⟨f, v, hfv, rfl⟩ := he
  ext x
  rw [transvection.coe_toLinearMap, LinearMap.transvection.sub_one_pow_succ_apply, pow_one, hfv,
    mul_zero, zero_smul, LinearMap.zero_apply]

/-- A linear equivalence whose underlying map is `transvection f v` with `f v = 0` is a
transvection. -/
theorem mem_transvections_of_coe_eq {e : V ≃ₗ[R] V} {f : Dual R V} {v : V}
    (he : (e : Module.End R V) = LinearMap.transvection f v) (hfv : f v = 0) :
    e ∈ transvections R V :=
  ⟨f, v, hfv, toLinearMap_injective (by rw [he, transvection.coe_toLinearMap])⟩

/-- A transvection is unipotent. -/
theorem isNilpotent_sub_one_of_mem_transvections {e : V ≃ₗ[R] V} (he : e ∈ transvections R V) :
    IsNilpotent ((e : Module.End R V) - 1) :=
  ⟨2, sub_one_sq_eq_zero_of_mem_transvections he⟩

private theorem symm_trans_trans_mem_dilatransvections (g : V ≃ₗ[R] W) {e : V ≃ₗ[R] V}
    (he : e ∈ dilatransvections R V) : g.symm.trans (e.trans g) ∈ dilatransvections R W := by
  obtain ⟨f, v, he⟩ := he
  exact ⟨f ∘ₗ g.symm, g v, by
    rw [coe_trans, coe_trans, LinearMap.comp_assoc, he, LinearMap.transvection.congr]⟩

private theorem symm_trans_trans_mem_transvections (g : V ≃ₗ[R] W) {e : V ≃ₗ[R] V}
    (he : e ∈ transvections R V) : g.symm.trans (e.trans g) ∈ transvections R W := by
  obtain ⟨f, v, hfv, rfl⟩ := he
  refine ⟨f ∘ₗ g.symm, g v, by simpa using hfv, ?_⟩
  rw [← toLinearMap_inj, coe_trans, coe_trans, LinearMap.comp_assoc, transvection.coe_toLinearMap,
    transvection.coe_toLinearMap, LinearMap.transvection.congr]

/-- Transporting along an isomorphism `g : V ≃ₗ[R] W` preserves and reflects dilatransvections. -/
@[simp]
theorem symm_trans_trans_mem_dilatransvections_iff (g : V ≃ₗ[R] W) {e : V ≃ₗ[R] V} :
    g.symm.trans (e.trans g) ∈ dilatransvections R W ↔ e ∈ dilatransvections R V := by
  refine ⟨fun he ↦ ?_, symm_trans_trans_mem_dilatransvections g⟩
  convert symm_trans_trans_mem_dilatransvections g.symm he
  ext x
  simp

/-- Transporting along an isomorphism `g : V ≃ₗ[R] W` preserves and reflects transvections. -/
@[simp]
theorem symm_trans_trans_mem_transvections_iff (g : V ≃ₗ[R] W) {e : V ≃ₗ[R] V} :
    g.symm.trans (e.trans g) ∈ transvections R W ↔ e ∈ transvections R V := by
  refine ⟨fun he ↦ ?_, symm_trans_trans_mem_transvections g⟩
  convert symm_trans_trans_mem_transvections g.symm he
  ext x
  simp

/-- A conjugate of a dilatransvection is a dilatransvection. -/
@[simp]
theorem conj_mem_dilatransvections_iff (g e : V ≃ₗ[R] V) :
    g * e * g⁻¹ ∈ dilatransvections R V ↔ e ∈ dilatransvections R V :=
  symm_trans_trans_mem_dilatransvections_iff g

/-- A conjugate of a transvection is a transvection. -/
@[simp]
theorem conj_mem_transvections_iff (g e : V ≃ₗ[R] V) :
    g * e * g⁻¹ ∈ transvections R V ↔ e ∈ transvections R V :=
  symm_trans_trans_mem_transvections_iff g

end Ring

section DivisionRing

variable {K V : Type*} [DivisionRing K] [AddCommGroup V] [Module K V]

/-- A dilatransvection over a division ring is a transvection exactly when it is unipotent. -/
theorem mem_transvections_iff_isNilpotent_sub_one {e : V ≃ₗ[K] V}
    (he : e ∈ dilatransvections K V) :
    e ∈ transvections K V ↔ IsNilpotent ((e : Module.End K V) - 1) := by
  refine ⟨isNilpotent_sub_one_of_mem_transvections, fun ⟨n, hn⟩ ↦ ?_⟩
  obtain ⟨f, v, he⟩ := he
  suffices hfv : f v = 0 from mem_transvections_of_coe_eq he hfv
  by_contra hfv
  have hv : v ≠ 0 := ne_zero_of_map hfv
  rw [he] at hn
  cases n with
  | zero => exact hv (by simpa using congr($hn v))
  | succ k =>
    have := congr($hn v)
    rw [LinearMap.transvection.sub_one_pow_succ_apply, LinearMap.zero_apply, smul_eq_zero,
      ← pow_succ'] at this
    exact this.elim (fun h ↦ hfv ((pow_eq_zero_iff k.succ_ne_zero).mp h)) hv

end DivisionRing

section CommRing

variable {R V : Type*} [CommRing R] [AddCommGroup V] [Module R V] [Free R V] [Module.Finite R V]

/-- The characteristic polynomial of a dilatransvection `e` of a nonzero free module of rank `n`
is `(X - 1) ^ (n - 1) * (X - det e)`. -/
theorem charpoly_of_mem_dilatransvections [Nontrivial V] {e : V ≃ₗ[R] V}
    (he : e ∈ dilatransvections R V) :
    (e : Module.End R V).charpoly =
      (X - 1) ^ (finrank R V - 1) * (X - C (LinearMap.det (e : Module.End R V))) := by
  obtain ⟨f, v, he⟩ := he
  rw [he, LinearMap.transvection.charpoly, LinearMap.transvection.det]

/-- The characteristic polynomial of a transvection of a free module of rank `n` is
`(X - 1) ^ n`. -/
theorem charpoly_of_mem_transvections {e : V ≃ₗ[R] V} (he : e ∈ transvections R V) :
    (e : Module.End R V).charpoly = (X - 1) ^ finrank R V := by
  obtain ⟨f, v, hfv, rfl⟩ := he
  rw [transvection.coe_toLinearMap, LinearMap.transvection.charpoly_of_apply_eq_zero hfv]

/-- A dilatransvection of a finite free module is a transvection exactly when its determinant is
`1`. -/
theorem mem_transvections_iff_det_eq_one {e : V ≃ₗ[R] V} (he : e ∈ dilatransvections R V) :
    e ∈ transvections R V ↔ LinearMap.det (e : Module.End R V) = 1 := by
  refine ⟨fun ⟨f, v, hfv, he'⟩ ↦ ?_, fun hdet ↦ ?_⟩
  · rw [he', transvection.coe_toLinearMap, LinearMap.transvection.det, hfv, add_zero]
  · obtain ⟨f, v, he⟩ := he
    rw [he, LinearMap.transvection.det, add_eq_left] at hdet
    exact mem_transvections_of_coe_eq he hdet

end CommRing

section Field

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

private theorem apply_ne_zero_of_notMem_transvections {e : V ≃ₗ[K] V} {f : Dual K V} {v : V}
    (he : (e : Module.End K V) = LinearMap.transvection f v) (he' : e ∉ transvections K V) :
    f v ≠ 0 :=
  fun hfv ↦ he' (mem_transvections_of_coe_eq he hfv)

variable [FiniteDimensional K V]

/-- A dilatransvection `e` that is not a transvection is diagonalisable: `V` is the direct sum of
the fixed hyperplane of `e` and the eigenspace of `e` for the eigenvalue `det e ≠ 1`. -/
theorem isCompl_fixedSubmodule_eigenspace_det {e : V ≃ₗ[K] V} (he : e ∈ dilatransvections K V)
    (he' : e ∉ transvections K V) :
    IsCompl (e : Module.End K V).fixedSubmodule
      (Module.End.eigenspace (e : Module.End K V) (LinearMap.det (e : Module.End K V))) := by
  obtain ⟨f, v, he⟩ := he
  have hfv := apply_ne_zero_of_notMem_transvections he he'
  have hv : v ≠ 0 := ne_zero_of_map hfv
  rw [he, LinearMap.transvection.det, LinearMap.transvection.fixedSubmodule_eq_ker hv,
    LinearMap.transvection.eigenspace_one_add_apply (Ne.isUnit hfv)]
  refine Module.Dual.isCompl_ker_of_disjoint_of_ne_bot ?_ (by simpa using hv)
  rw [Submodule.disjoint_def]
  intro x hx hxv
  obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hxv
  rw [LinearMap.mem_ker, LinearMap.map_smul, smul_eq_mul, mul_eq_zero] at hx
  simp [hx.resolve_right hfv]

/-- The eigenspace of a dilatransvection `e` that is not a transvection for the eigenvalue
`det e` is a line. -/
theorem finrank_eigenspace_det {e : V ≃ₗ[K] V} (he : e ∈ dilatransvections K V)
    (he' : e ∉ transvections K V) :
    finrank K
      (Module.End.eigenspace (e : Module.End K V) (LinearMap.det (e : Module.End K V))) = 1 := by
  obtain ⟨f, v, he⟩ := he
  have hfv := apply_ne_zero_of_notMem_transvections he he'
  have hv : v ≠ 0 := ne_zero_of_map hfv
  rw [he, LinearMap.transvection.det,
    LinearMap.transvection.eigenspace_one_add_apply (Ne.isUnit hfv), finrank_span_singleton hv]

end Field

section BaseChange

variable {R V : Type*} [CommRing R] [AddCommGroup V] [Module R V]
  (A : Type*) [CommRing A] [Algebra R A]

/-- Extension of scalars preserves transvections. -/
theorem baseChange_mem_transvections {e : V ≃ₗ[R] V} (he : e ∈ transvections R V) :
    e.baseChange R A V V ∈ transvections A (A ⊗[R] V) := by
  obtain ⟨f, v, hfv, rfl⟩ := he
  rw [transvection.baseChange hfv (hA := by simp [hfv])]
  exact transvection_mem_transvections

end BaseChange

end LinearEquiv
