module

public import TauCeti.LinearAlgebra.BilinearForm.Basic
public import Mathlib.LinearAlgebra.QuadraticForm.Basic
public import Mathlib.Algebra.Module.Submodule.Bilinear
public import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Tactic.Ring

/-!
# Scale and norm ideals of a bilinear form

The scale ideal is generated by all values of a bilinear form, and the norm ideal by its
self-pairings. For a symmetric form, polarization gives twice the scale ideal inside the
norm ideal. Spanning sets and bases provide generators for both ideals.

The qualified names are `TauCeti.BilinearFormIdeal.scaleIdeal` and
`TauCeti.BilinearFormIdeal.normIdeal`.

## References

* O. T. O'Meara, *Introduction to Quadratic Forms*, §82E.
-/

public section

namespace TauCeti

namespace BilinearFormIdeal

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- The ideal generated by the values of a bilinear form. -/
def scaleIdeal (B : LinearMap.BilinForm R M) : Ideal R :=
  Submodule.map₂ B ⊤ ⊤

/-- The ideal generated by the self-pairings of a bilinear form. -/
def normIdeal (B : LinearMap.BilinForm R M) : Ideal R :=
  Ideal.span (Set.range fun x : M ↦ B x x)

/-- The scale ideal as a span of pairing values. -/
theorem scaleIdeal_def (B : LinearMap.BilinForm R M) :
    scaleIdeal B = Ideal.span (Set.range fun p : M × M ↦ B p.1 p.2) := by
  simpa only [scaleIdeal, Submodule.span_univ, Ideal.submodule_span_eq,
    ← Set.image_prod, Set.univ_prod_univ, Set.image_univ] using
    Submodule.map₂_span_span R B Set.univ Set.univ

/-- The norm ideal as a span of self-pairings. -/
theorem normIdeal_def (B : LinearMap.BilinForm R M) :
    normIdeal B = Ideal.span (Set.range fun x : M ↦ B x x) := by
  unfold normIdeal
  rfl

/-- Every pairing belongs to the scale ideal. -/
@[simp] theorem apply_mem_scaleIdeal (B : LinearMap.BilinForm R M) (x y : M) :
    B x y ∈ scaleIdeal B :=
  Submodule.apply_mem_map₂ B Submodule.mem_top Submodule.mem_top

/-- The universal property of the scale ideal. -/
theorem scaleIdeal_le_iff (B : LinearMap.BilinForm R M) (I : Ideal R) :
    scaleIdeal B ≤ I ↔ ∀ x y : M, B x y ∈ I := by
  simp [scaleIdeal, Submodule.map₂_le]

/-- A spanning set generates the scale ideal through its pairings. -/
theorem scaleIdeal_eq_span_of_span (B : LinearMap.BilinForm R M) {s : Set M}
    (hs : Submodule.span R s = ⊤) :
    scaleIdeal B = Ideal.span (Set.image2 (fun x y ↦ B x y) s s) := by
  rw [scaleIdeal, ← hs, Submodule.map₂_span_span]

/-- Pairings of a spanning set suffice to bound the scale ideal. -/
theorem scaleIdeal_le_of_span (B : LinearMap.BilinForm R M) {s : Set M}
    (hs : Submodule.span R s = ⊤) (I : Ideal R)
    (h : ∀ a ∈ s, ∀ b ∈ s, B a b ∈ I) : scaleIdeal B ≤ I :=
  (scaleIdeal_eq_span_of_span B hs).le.trans
    (Ideal.span_le.mpr (Set.image2_subset_iff.mpr h))

/-- A basis generates the scale ideal through its Gram entries. -/
theorem scaleIdeal_eq_span_basis {ι : Type*} (B : LinearMap.BilinForm R M)
    (b : Module.Basis ι R M) :
    scaleIdeal B = Ideal.span (Set.range fun ij : ι × ι ↦ B (b ij.1) (b ij.2)) := by
  rw [scaleIdeal_eq_span_of_span B b.span_eq, Set.image2_range]

/-- Every self-pairing belongs to the norm ideal. -/
@[simp] theorem self_mem_normIdeal (B : LinearMap.BilinForm R M) (x : M) :
    B x x ∈ normIdeal B :=
  Ideal.subset_span (Set.mem_range_self x)

/-- The universal property of the norm ideal. -/
theorem normIdeal_le_iff (B : LinearMap.BilinForm R M) (I : Ideal R) :
    normIdeal B ≤ I ↔ ∀ x : M, B x x ∈ I := by
  rw [normIdeal, Ideal.span_le, Set.range_subset_iff]
  simp only [SetLike.mem_coe]

/-- The norm ideal is contained in the scale ideal. -/
theorem normIdeal_le_scaleIdeal (B : LinearMap.BilinForm R M) :
    normIdeal B ≤ scaleIdeal B :=
  (normIdeal_le_iff B (scaleIdeal B)).mpr fun x ↦ apply_mem_scaleIdeal B x x

/-- Twice a pairing of a symmetric form belongs to its norm ideal. -/
theorem two_mul_apply_mem_normIdeal (B : LinearMap.BilinForm R M) (hB : B.IsSymm) (x y : M) :
    2 * B x y ∈ normIdeal B := by
  have h := self_mem_normIdeal B (x + y)
  have hx := self_mem_normIdeal B x
  have hy := self_mem_normIdeal B y
  rw [bilinForm_apply_add_self hB x y] at h
  convert (normIdeal B).sub_mem ((normIdeal B).sub_mem h hx) hy using 1; ring

/-- A spanning set generates the norm ideal through self-pairings and twice the pairings. -/
theorem normIdeal_eq_span_of_span (B : LinearMap.BilinForm R M) (hB : B.IsSymm) {s : Set M}
    (hs : Submodule.span R s = ⊤) :
    normIdeal B = Ideal.span
      ((fun x : M ↦ B x x) '' s ∪ Set.image2 (fun x y ↦ 2 * B x y) s s) := by
  let I : Ideal R := Ideal.span
    ((fun x : M ↦ B x x) '' s ∪ Set.image2 (fun x y ↦ 2 * B x y) s s)
  have hpair (x y : M) : 2 * B x y ∈ I := by
    have h := scaleIdeal_le_of_span B hs (Submodule.comap (LinearMap.lsmul R R 2) I)
      (fun a ha b hb ↦ by
        simp only [Submodule.mem_comap, LinearMap.lsmul_apply, smul_eq_mul]
        exact Ideal.subset_span (Or.inr ⟨a, ha, b, hb, rfl⟩))
      (apply_mem_scaleIdeal B x y)
    simpa only [Submodule.mem_comap, LinearMap.lsmul_apply, smul_eq_mul] using h
  apply le_antisymm
  · apply (normIdeal_le_iff B I).mpr
    intro x
    have hx : x ∈ Submodule.span R s := by
      rw [hs]
      exact Submodule.mem_top
    induction hx using Submodule.span_induction with
    | mem x hx => exact Ideal.subset_span (Or.inl ⟨x, hx, rfl⟩)
    | zero => simp
    | add x y _ _ hx hy =>
        rw [bilinForm_apply_add_self hB x y]
        exact I.add_mem (I.add_mem hx hy) (hpair x y)
    | smul a x _ hx =>
        have hsmul : B (a • x) (a • x) = a ^ 2 * B x x := by
          simp only [map_smul, LinearMap.smul_apply, smul_eq_mul]
          ring
        rw [hsmul]
        exact I.mul_mem_left (a ^ 2) hx
  · apply Ideal.span_le.mpr
    rintro _ (⟨x, _, rfl⟩ | ⟨x, _, y, _, rfl⟩)
    · exact self_mem_normIdeal B x
    · exact two_mul_apply_mem_normIdeal B hB x y

/-- A basis generates the norm ideal through diagonal Gram entries and twice all entries. -/
theorem normIdeal_eq_span_basis {ι : Type*} (B : LinearMap.BilinForm R M) (hB : B.IsSymm)
    (b : Module.Basis ι R M) :
    normIdeal B = Ideal.span
      (Set.range (fun i : ι ↦ B (b i) (b i)) ∪
        Set.range (fun ij : ι × ι ↦ 2 * B (b ij.1) (b ij.2))) := by
  rw [normIdeal_eq_span_of_span B hB b.span_eq, Set.image2_range,
    ← Set.range_comp' (fun x : M ↦ B x x) b]

/-- Polarization gives twice the scale ideal inside the norm ideal. -/
theorem span_singleton_two_mul_scaleIdeal_le_normIdeal
    (B : LinearMap.BilinForm R M) (hB : B.IsSymm) :
    Ideal.span {(2 : R)} * scaleIdeal B ≤ normIdeal B := by
  rw [scaleIdeal_def, Ideal.span_mul_span, Ideal.span_le, Set.mul_subset_iff]
  intro a ha b hb
  obtain rfl := Set.mem_singleton_iff.mp ha
  obtain ⟨⟨x, y⟩, rfl⟩ := hb
  exact two_mul_apply_mem_normIdeal B hB x y

end BilinearFormIdeal

end TauCeti
