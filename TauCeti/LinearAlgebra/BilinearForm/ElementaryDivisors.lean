/-!
# Elementary divisors of alternating forms over a principal ideal domain

Let `B` be an alternating bilinear form on a finite free module `M` over a principal ideal domain
`R`. Then `M` has a basis `e₁, …, e_g, f₁, …, f_g, z₁, …, z_r` in which
`B (eᵢ, fᵢ) = dᵢ = -B (fᵢ, eᵢ)` with `dᵢ ≠ 0` and `d₁ ∣ d₂ ∣ ⋯ ∣ d_g`, every other pairing of basis
vectors vanishes, and the `zₖ` lie in the kernel of `B`. In matrix form,
`B = [[0, D, 0], [-D, 0, 0], [0, 0, 0]]` with `D = diag(d₁, …, d_g)`. When `B` is nondegenerate
there are no `zₖ`, so the rank of `M` is even, and the matrix is `[[0, D], [-D, 0]]` with
determinant `(d₁ ⋯ d_g)²`. Over an ordered ring such as `ℤ` the `dᵢ` can be taken positive, and
since an integral change of basis has determinant `±1`, the determinant of an integral form in
*every* basis is `(d₁ ⋯ d_g)²`.

This is the normal form behind the type of a polarization: an integral Riemann form on the period
lattice of a complex torus is a nondegenerate alternating form on a free `ℤ`-module of rank `2g`,
and its elementary divisors `(d₁, …, d_g)` are the type. Over a field every `dᵢ` is a unit, which
is the case of the symplectic basis theorem.

The proof is Frobenius's. Since `R` is Noetherian, some value `d = B e f` generates an ideal
maximal among those generated by single values of `B`. A Bézout combination shows that `d` divides
every `B e u` and every `B f u`. If `B f u = d * b`, the vector `e + u + b • e` pairs with `f` to
`d` again, so `d` also divides every `B u v`
(`LinearMap.BilinForm.IsAlt.exists_forall_dvd_apply`). Divisibility makes the projection
`u ↦ u + b • e - a • f`, where `B e u = d * a` and `B f u = d * b`, integral, so the span of `e, f`
splits off orthogonally (`LinearMap.BilinForm.IsAlt.isCompl_span_pair_orthogonal_of_dvd`). The
orthogonal complement is again finite free, of rank two less, and every value of `B` on it is a
multiple of `d`, which gives the divisibility of the next elementary divisor; induction on the rank
finishes the proof.

## Main results

* `LinearMap.BilinForm.IsAlt.exists_forall_dvd_apply`: over a principal ideal ring an alternating
  form has a value `B e f` dividing all of its values.
* `LinearMap.BilinForm.IsAlt.exists_basis_toMatrix_eq_fromBlocks`: **the elementary divisor normal
  form** `[[0, D, 0], [-D, 0, 0], [0, 0, 0]]` of an alternating form on a finite free module over a
  principal ideal domain.
* `LinearMap.BilinForm.IsAlt.exists_basis_toMatrix_eq_fromBlocks_of_nondegenerate`: the normal form
  `[[0, D], [-D, 0]]` of a nondegenerate alternating form.
* `LinearMap.BilinForm.IsAlt.exists_basis_toMatrix_eq_fromBlocks_pos_of_nondegenerate`: over an
  ordered principal ideal domain, such as `ℤ`, the elementary divisors can be taken positive.
* `LinearMap.BilinForm.det_toMatrix_eq_prod_sq_of_toMatrix_eq_fromBlocks`: over `ℤ` the
  determinant of the form in every basis is the square of the product of its elementary divisors.

The uniqueness of the elementary divisors up to units is not proved here.

## References

* G. Frobenius, *Theorie der linearen Formen mit ganzen Coefficienten*, J. Reine Angew. Math. 86
  (1879), 146–208.
* C. Birkenhake and H. Lange, *Complex Abelian Varieties*, 2nd ed., Grundlehren 302 (2004),
  Chapter 3 (the type of a polarization).
-/

public section

open Matrix Module Submodule

namespace LinearMap.BilinForm

open LinearMap (BilinForm)

section CommRing

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] {B : BilinForm R M}

/-- In a principal ideal ring, if `B e f` generates an ideal maximal among the ideals generated by
single values of `B`, then `B e f` divides `B e u` for every `u`. -/
private theorem dvd_apply_of_forall_not_lt [IsPrincipalIdealRing R] {e f : M}
    (hmax : ∀ x y : M, ¬Ideal.span {B e f} < Ideal.span {B x y}) (u : M) : B e f ∣ B e u := by
  obtain ⟨g, hg⟩ := (IsPrincipalIdealRing.principal (Ideal.span {B e f, B e u})).principal
  rw [Ideal.submodule_span_eq] at hg
  -- A Bézout combination `s * B e f + t * B e u` of the two values is itself a value of `B`.
  obtain ⟨s, t, hst⟩ := Ideal.mem_span_pair.1 (hg ▸ Ideal.mem_span_singleton_self g)
  have hval : B e (s • f + t • u) = g := by
    rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul, hst]
  have hle : Ideal.span {B e f} ≤ Ideal.span {B e f, B e u} :=
    Ideal.span_mono (Set.singleton_subset_iff.2 (Set.mem_insert _ _))
  have heq : Ideal.span {B e f} = Ideal.span {B e f, B e u} := by
    by_contra hne
    refine hmax e (s • f + t • u) ?_
    rw [hval, ← hg]
    exact lt_of_le_of_ne hle hne
  rw [← Ideal.mem_span_singleton, heq]
  exact Ideal.subset_span (by simp)

/-- **An alternating form over a principal ideal ring has a value dividing all of its values.**
There are `e` and `f` such that `B e f` divides `B x y` for all `x` and `y`, so `B e f` generates
the ideal spanned by the values of `B`. -/
theorem IsAlt.exists_forall_dvd_apply [IsPrincipalIdealRing R] (hB : B.IsAlt) :
    ∃ e f : M, ∀ x y, B e f ∣ B x y := by
  -- Choose `B e f` generating an ideal maximal among those generated by single values.
  obtain ⟨_, ⟨⟨e, f⟩, rfl⟩, hmax⟩ := set_has_maximal_iff_noetherian.2 inferInstance
    (Set.range fun p : M × M => Ideal.span {B p.1 p.2}) (Set.range_nonempty _)
  have hmax' : ∀ e' f' : M, Ideal.span {B e' f'} = Ideal.span {B e f} →
      ∀ x y : M, ¬Ideal.span {B e' f'} < Ideal.span {B x y} :=
    fun e' f' h x y => h ▸ hmax _ ⟨(x, y), rfl⟩
  have he : ∀ u, B e f ∣ B e u := dvd_apply_of_forall_not_lt (hmax' e f rfl)
  have hf : ∀ u, B e f ∣ B f u := fun u => by
    have h := dvd_apply_of_forall_not_lt
      (hmax' f e (by rw [← hB.neg_eq e f, Ideal.span_singleton_neg])) u
    rwa [← hB.neg_eq e f, neg_dvd] at h
  refine ⟨e, f, fun x y => ?_⟩
  -- Correct `x` to `x' = x + b • e`, orthogonal to `f`, where `B f x = B e f * b`. Then
  -- `B (e + x') f = B e f`, so the pair `e + x', f` is maximal too and `B e f` divides
  -- `B (e + x') y = B e y + B x y + b * B e y`.
  obtain ⟨b, hb⟩ := hf x
  have hval : B (e + (x + b • e)) f = B e f := by
    rw [← hB.neg_eq f]
    simp only [map_add, map_smul, smul_eq_mul, hb, ← hB.neg_eq e f]
    ring
  have h := dvd_apply_of_forall_not_lt (hmax' _ _ (by rw [hval])) y
  rw [hval] at h
  have hxy : B x y = B (e + (x + b • e)) y - B e y - b * B e y := by
    simp only [map_add, map_smul, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul]
    ring
  rw [hxy]
  exact dvd_sub (dvd_sub h (he y)) (dvd_mul_of_dvd_right (he y) _)

end CommRing

section PID

variable {R : Type*} [CommRing R]

/-- The index equivalence adjoining a hyperbolic pair, in positions `inl (inl 0)` and
`inl (inr 0)`, to a normal-form index type. -/
private def consIndexEquiv (g r : ℕ) :
    (Fin (g + 1) ⊕ Fin (g + 1)) ⊕ Fin r ≃ Fin 2 ⊕ ((Fin g ⊕ Fin g) ⊕ Fin r) where
  toFun := Sum.elim (Sum.elim (Fin.cons (.inl 0) fun i => .inr (.inl (.inl i)))
    (Fin.cons (.inl 1) fun i => .inr (.inl (.inr i)))) fun k => .inr (.inr k)
  invFun := Sum.elim (fun i => if i = 0 then .inl (.inl 0) else .inl (.inr 0))
    (Sum.elim (Sum.elim (fun i => .inl (.inl i.succ)) fun i => .inl (.inr i.succ)) .inr)
  left_inv := by
    rintro ((i | i) | k)
    · induction i using Fin.cases <;> simp
    · induction i using Fin.cases <;> simp
    · simp
  right_inv := by
    rintro (i | (i | i) | k)
    · fin_cases i <;> simp
    all_goals simp

/-- **Adjoining a divisible hyperbolic pair to a normal-form basis of its orthogonal complement.**
If `B e f` is a non-zero-divisor dividing every `B e u` and `B f u`, a basis of the orthogonal
complement of the span of `e, f` in which `B` has elementary divisor normal form with divisors `d`
extends, by `e` and `f`, to a basis of `M` in which `B` has normal form with divisors
`B e f, d₁, …, d_g`. -/
private theorem IsAlt.exists_basis_apply_eq_fromBlocks_cons {M : Type*} [AddCommGroup M]
    [Module R M] {B : BilinForm R M} (hB : B.IsAlt) {e f : M} (hd : B e f ∈ nonZeroDivisors R)
    (hdvd : ∀ u, B e f ∣ B e u ∧ B e f ∣ B f u) {g r : ℕ} {d : Fin g → R}
    (c : Basis ((Fin g ⊕ Fin g) ⊕ Fin r) R (B.orthogonal (span R {e, f})))
    (hc : ∀ x y, B (c x) (c y) =
      fromBlocks (fromBlocks 0 (diagonal d) (-diagonal d) 0) 0 0 0 x y) :
    ∃ b : Basis ((Fin (g + 1) ⊕ Fin (g + 1)) ⊕ Fin r) R M, ∀ x y, B (b x) (b y) =
      fromBlocks (fromBlocks 0 (diagonal (Fin.cons (B e f) d)) (-diagonal (Fin.cons (B e f) d)) 0)
        0 0 0 x y := by
  have hfe : B f e = -B e f := (hB.neg_eq e f).symm
  have hli := hB.linearIndependent_pair_of_mem_nonZeroDivisors hd
  have hspan : span R (Set.range ![e, f]) = span R {e, f} := by
    rw [Matrix.range_cons_cons_empty]
  let P : Basis (Fin 2) R (span R {e, f}) :=
    (Basis.span hli).map (LinearEquiv.ofEq _ _ hspan)
  have hP : ∀ i, (P i : M) = ![e, f] i := fun i => by
    simp [P, Basis.span_apply]
  let b₀ : Basis (Fin 2 ⊕ ((Fin g ⊕ Fin g) ⊕ Fin r)) R M :=
    (P.prod c).map (prodEquivOfIsCompl _ _ (hB.isCompl_span_pair_orthogonal_of_dvd hd hdvd))
  have hb₀l : ∀ i, b₀ (.inl i) = ![e, f] i := fun i => by simp [b₀, hP]
  have hb₀r : ∀ j, b₀ (.inr j) = c j := fun j => by simp [b₀]
  have hcW : ∀ j, B e (c j) = 0 ∧ B f (c j) = 0 := fun j =>
    ⟨mem_orthogonal_iff.1 (c j).property e (subset_span (by simp)),
      mem_orthogonal_iff.1 (c j).property f (subset_span (by simp))⟩
  have hWe : ∀ j, B (c j) e = 0 := fun j => by rw [← hB.neg_eq, (hcW j).1, neg_zero]
  have hWf : ∀ j, B (c j) f = 0 := fun j => by rw [← hB.neg_eq, (hcW j).2, neg_zero]
  refine ⟨b₀.reindex (consIndexEquiv g r).symm, fun x y => ?_⟩
  simp only [Basis.reindex_apply, Equiv.symm_symm]
  rcases x with (x | x) | k <;> rcases y with (y | y) | l <;>
    try induction x using Fin.cases
  all_goals try induction y using Fin.cases
  all_goals simp [consIndexEquiv, hb₀l, hb₀r, hc, hcW, hWe, hWf, hfe, hB.self_eq_zero,
    diagonal_apply, Fin.succ_ne_zero, fun a : Fin g => (Fin.succ_ne_zero a).symm]

variable [IsDomain R] [IsPrincipalIdealRing R]

/-- The induction behind `IsAlt.exists_basis_toMatrix_eq_fromBlocks`, stated for every module of a
given rank. -/
private theorem exists_basis_apply_eq_fromBlocks_aux (n : ℕ) :
    ∀ (M : Type*) [AddCommGroup M] [Module R M] [Module.Free R M] [Module.Finite R M],
      finrank R M = n → ∀ B : BilinForm R M, B.IsAlt →
      ∃ (g r : ℕ) (b : Basis ((Fin g ⊕ Fin g) ⊕ Fin r) R M) (d : Fin g → R),
        (∀ i, d i ≠ 0) ∧ (∀ i j, i ≤ j → d i ∣ d j) ∧
        ∀ x y, B (b x) (b y) =
          fromBlocks (fromBlocks 0 (diagonal d) (-diagonal d) 0) 0 0 0 x y := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro M _ _ _ _ hn B hB
  by_cases hB0 : B = 0
  · -- The zero form is in normal form in every basis, with no elementary divisors.
    subst hB0
    refine ⟨0, n, (finBasisOfFinrankEq R M hn).reindex (Equiv.emptySum _ _).symm, Fin.elim0,
      fun i => i.elim0, fun i => i.elim0, ?_⟩
    rintro ((x | x) | k) ((y | y) | l) <;> first | exact x.elim0 | exact y.elim0 | simp
  -- A value `B e f` dividing all values; it is nonzero since `B ≠ 0`.
  obtain ⟨e, f, hdvd⟩ := hB.exists_forall_dvd_apply
  have hd0 : B e f ≠ 0 := fun h =>
    hB0 (LinearMap.ext₂ fun x y => by simpa [h] using hdvd x y)
  have hd : B e f ∈ nonZeroDivisors R := mem_nonZeroDivisors_of_ne_zero hd0
  have hdvd' : ∀ u, B e f ∣ B e u ∧ B e f ∣ B f u := fun u => ⟨hdvd e u, hdvd f u⟩
  -- The orthogonal complement `W` of the span of `e, f` has rank `n - 2`.
  have hc := hB.isCompl_span_pair_orthogonal_of_dvd hd hdvd'
  have hspan : finrank R (span R {e, f}) = 2 := by
    rw [← Matrix.range_cons_cons_empty e f ![],
      finrank_span_eq_card (hB.linearIndependent_pair_of_mem_nonZeroDivisors hd),
      Fintype.card_fin]
  have hW : finrank R (B.orthogonal (span R {e, f})) + 2 = n := by
    have h := (prodEquivOfIsCompl _ _ hc).finrank_eq
    rw [finrank_prod, hspan, hn] at h
    omega
  -- Apply the induction hypothesis to `W`, then adjoin `e, f`.
  obtain ⟨g, r, c, d, hd0', hdd, hc'⟩ :=
    ih _ (by omega) (B.orthogonal (span R {e, f})) rfl (B.restrict _) fun z => hB.self_eq_zero z
  obtain ⟨b, hb⟩ := hB.exists_basis_apply_eq_fromBlocks_cons hd hdvd' c
    fun x y => by simpa only [restrict_apply, LinearMap.domRestrict_apply] using hc' x y
  refine ⟨g + 1, r, b, Fin.cons (B e f) d, fun i => ?_, fun i j hij => ?_, hb⟩
  · induction i using Fin.cases
    · simpa using hd0
    · simpa using hd0' _
  · induction j using Fin.cases with
    | zero => rw [Fin.le_zero_iff.1 hij]
    | succ j =>
      induction i using Fin.cases with
      | zero =>
        -- `d j` is a value of `B`, hence a multiple of `B e f`.
        have h := hc' (.inl (.inl j)) (.inl (.inr j))
        simp only [restrict_apply, fromBlocks_apply₁₁,
          fromBlocks_apply₁₂, diagonal_apply_eq] at h
        simpa [← h] using hdvd _ _
      | succ i => simpa using hdd i j (Fin.succ_le_succ_iff.1 hij)

/-- **Elementary divisor normal form of an alternating form.** An alternating bilinear form on a
finite free module over a principal ideal domain has, in a suitable basis
`e₁, …, e_g, f₁, …, f_g, z₁, …, z_r`, the matrix `[[0, D, 0], [-D, 0, 0], [0, 0, 0]]`, where
`D = diag(d₁, …, d_g)` with every `dᵢ ≠ 0` and `d₁ ∣ d₂ ∣ ⋯ ∣ d_g`. -/
theorem IsAlt.exists_basis_toMatrix_eq_fromBlocks {M : Type*} [AddCommGroup M] [Module R M]
    [Module.Free R M] [Module.Finite R M] {B : BilinForm R M} (hB : B.IsAlt) :
    ∃ (g r : ℕ) (b : Basis ((Fin g ⊕ Fin g) ⊕ Fin r) R M) (d : Fin g → R),
      (∀ i, d i ≠ 0) ∧ (∀ i j, i ≤ j → d i ∣ d j) ∧
      BilinForm.toMatrix b B = fromBlocks (fromBlocks 0 (diagonal d) (-diagonal d) 0) 0 0 0 := by
  obtain ⟨g, r, b, d, hd0, hdd, hb⟩ :=
    exists_basis_apply_eq_fromBlocks_aux (finrank R M) M rfl B hB
  exact ⟨g, r, b, d, hd0, hdd, Matrix.ext fun x y => by rw [toMatrix_apply, hb]⟩

/-- **Elementary divisor normal form of a nondegenerate alternating form.** A nondegenerate
alternating bilinear form on a finite free module over a principal ideal domain has, in a suitable
basis `e₁, …, e_g, f₁, …, f_g`, the matrix `[[0, D], [-D, 0]]`, where `D = diag(d₁, …, d_g)` with
every `dᵢ ≠ 0` and `d₁ ∣ d₂ ∣ ⋯ ∣ d_g`. In particular the module has even rank `2g`. -/
theorem IsAlt.exists_basis_toMatrix_eq_fromBlocks_of_nondegenerate {M : Type*} [AddCommGroup M]
    [Module R M] [Module.Free R M] [Module.Finite R M] {B : BilinForm R M} (hB : B.IsAlt)
    (hnd : B.Nondegenerate) :
    ∃ (g : ℕ) (b : Basis (Fin g ⊕ Fin g) R M) (d : Fin g → R),
      (∀ i, d i ≠ 0) ∧ (∀ i j, i ≤ j → d i ∣ d j) ∧
      BilinForm.toMatrix b B = fromBlocks 0 (diagonal d) (-diagonal d) 0 := by
  obtain ⟨g, r, b, d, hd0, hdd, hb⟩ := hB.exists_basis_toMatrix_eq_fromBlocks
  have hbv : ∀ x y, B (b x) (b y) =
      fromBlocks (fromBlocks 0 (diagonal d) (-diagonal d) 0) 0 0 0 x y := fun x y => by
    rw [← toMatrix_apply, hb]
  -- The vectors `zₖ` lie in the kernel of `B`, so there are none.
  have : IsEmpty (Fin r) := ⟨fun k => b.ne_zero (.inr k) <| hnd.1 _ fun y => by
    have h : B (b (.inr k)) = 0 := b.ext fun j => by rcases j with (j | j) | l <;> simp [hbv]
    rw [h, LinearMap.zero_apply]⟩
  refine ⟨g, b.reindex (Equiv.sumEmpty _ _), d, hd0, hdd, Matrix.ext fun x y => ?_⟩
  rw [toMatrix_apply, Basis.reindex_apply, Basis.reindex_apply, hbv]
  rcases x with x | x <;> rcases y with y | y <;> simp

end PID

section Ordered

variable {R M : Type*} [CommRing R] [LinearOrder R] [IsStrictOrderedRing R] [IsPrincipalIdealRing R]
  [AddCommGroup M] [Module R M] [Module.Free R M] [Module.Finite R M] {B : BilinForm R M}

/-- **Elementary divisor normal form with positive divisors.** Over an ordered principal ideal
domain such as `ℤ`, a nondegenerate alternating form on a finite free module has, in a suitable
basis `e₁, …, e_g, f₁, …, f_g`, the matrix `[[0, D], [-D, 0]]`, where `D = diag(d₁, …, d_g)` with
every `dᵢ > 0` and `d₁ ∣ d₂ ∣ ⋯ ∣ d_g`. -/
theorem IsAlt.exists_basis_toMatrix_eq_fromBlocks_pos_of_nondegenerate (hB : B.IsAlt)
    (hnd : B.Nondegenerate) :
    ∃ (g : ℕ) (b : Basis (Fin g ⊕ Fin g) R M) (d : Fin g → R),
      (∀ i, 0 < d i) ∧ (∀ i j, i ≤ j → d i ∣ d j) ∧
      BilinForm.toMatrix b B = fromBlocks 0 (diagonal d) (-diagonal d) 0 := by
  obtain ⟨g, b, d, hd0, hdd, hb⟩ := hB.exists_basis_toMatrix_eq_fromBlocks_of_nondegenerate hnd
  -- Multiply each `fᵢ` by the sign of `dᵢ`.
  let u : Fin g → Rˣ := fun i => if 0 < d i then 1 else -1
  have hu : ∀ i, (u i : R) * d i = |d i| := fun i => by
    by_cases h : 0 < d i
    · simp [u, h, abs_of_pos h]
    · simp [u, h, abs_of_neg (lt_of_le_of_ne (not_lt.1 h) (hd0 i))]
  have hbv : ∀ x y, B (b x) (b y) = fromBlocks 0 (diagonal d) (-diagonal d) 0 x y :=
    fun x y => by rw [← toMatrix_apply, hb]
  refine ⟨g, b.unitsSMul (Sum.elim 1 u), fun i => |d i|, fun i => abs_pos.2 (hd0 i),
    fun i j hij => (abs_dvd_abs _ _).2 (hdd i j hij), Matrix.ext fun x y => ?_⟩
  simp only [toMatrix_apply, Basis.unitsSMul_apply, Units.smul_def, map_smul,
    LinearMap.smul_apply, smul_eq_mul, hbv]
  rcases x with x | x <;> rcases y with y | y <;> by_cases h : x = y <;>
    simp [h, ← hu]

end Ordered

section Int

variable {M : Type*} [AddCommGroup M] {B : BilinForm ℤ M}

/-- **The determinant of an integral alternating form is the square of the product of its
elementary divisors**, in every basis: if `B` has matrix `[[0, D], [-D, 0]]` in some basis, with
`D = diag(d₁, …, d_g)`, then its matrix in any basis has determinant `(d₁ ⋯ d_g)²`. -/
theorem det_toMatrix_eq_prod_sq_of_toMatrix_eq_fromBlocks {g : ℕ} {b : Basis (Fin g ⊕ Fin g) ℤ M}
    {d : Fin g → ℤ} (hb : BilinForm.toMatrix b B = fromBlocks 0 (diagonal d) (-diagonal d) 0)
    {ι : Type*} [Fintype ι] [DecidableEq ι] (c : Basis ι ℤ M) :
    (BilinForm.toMatrix c B).det = (∏ i, d i) ^ 2 := by
  have hbc : (BilinForm.toMatrix c B).det = (BilinForm.toMatrix b B).det := by
    rw [← toMatrixAux_eq b B, ← toMatrixAux_eq c B]
    exact LinearMap.det_toMatrix₂Aux_eq_det_toMatrix₂Aux B b c
  rw [hbc, hb, det_fromBlocks_zero₁₁_zero₂₂, det_neg, det_diagonal, Fintype.card_fin]
  have h : (-1 : ℤ) ^ g * (-1) ^ g = 1 := by
    rw [← mul_pow]
    simp
  linear_combination (∏ i, d i) ^ 2 * h

end Int

end LinearMap.BilinForm
