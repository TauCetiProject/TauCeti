module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.Algebra.Algebra.Tower

/-!
# Centralizers of a generating scalar action

If an algebra is generated by one element, commuting with its action is equivalent to
linearity over the algebra. This identifies the centralizer of a cyclic algebra action
with its module endomorphisms, for example for nilpotent operators viewed as actions of
a truncated polynomial algebra.
-/

public section

namespace Module.End

variable {R A M : Type*} [CommSemiring R] [Semiring A] [Algebra R A]
  [AddCommMonoid M] [Module R M] [Module A M] [IsScalarTower R A M]

/-- If `a` generates `A`, the centralizer of its action consists precisely of the
`A`-linear endomorphisms. -/
def centralizerScalarEquiv (a : A) (ha : Algebra.adjoin R {a} = ⊤) :
    Subalgebra.centralizer R {Algebra.lsmul R R M a} ≃ₗ[R] Module.End A M where
  toFun f :=
    { __ := f.val
      map_smul' b := by
        suffices ∀ x, f.val (b • x) = b • f.val x from this
        have hb : b ∈ Algebra.adjoin R {a} := ha ▸ trivial
        have hf (x : M) : f.val (a • x) = a • f.val x :=
          (congrArg (fun g : Module.End R M => g x)
            ((Subalgebra.mem_centralizer_iff R).1 f.property _
              (Set.mem_singleton (Algebra.lsmul R R M a)))).symm
        induction hb using Algebra.adjoin_induction with
        | mem b hb => simpa only [Set.mem_singleton_iff.mp hb] using hf
        | algebraMap r => intro x; simp [algebraMap_smul]
        | add b c hb hc ihb ihc => intro x; simp [add_smul, ihb, ihc]
        | mul b c hb hc ihb ihc => intro x; simp [mul_smul, ihb, ihc] }
  invFun f := ⟨f.restrictScalars R, by
    rw [Subalgebra.mem_centralizer_iff]
    rintro _ ⟨rfl⟩
    ext x
    exact (f.map_smul a x).symm⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The centralizer equivalence preserves the underlying function. -/
@[simp]
theorem centralizerScalarEquiv_apply (a : A) (ha : Algebra.adjoin R {a} = ⊤)
    (f : Subalgebra.centralizer R {Algebra.lsmul R R M a}) (x : M) :
    centralizerScalarEquiv a ha f x = f.val x := (rfl)

/-- The inverse centralizer equivalence restricts scalars. -/
@[simp]
theorem centralizerScalarEquiv_symm_apply (a : A) (ha : Algebra.adjoin R {a} = ⊤)
    (f : Module.End A M) :
    ((centralizerScalarEquiv a ha).symm f).val = f.restrictScalars R := (rfl)

end Module.End
