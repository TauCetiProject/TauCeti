module

public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.LinearAlgebra.LinearIndependent.Basic
public import Mathlib.RingTheory.Noetherian.Defs

/-!
# Linear combinations in submodules, independent families and Noetherian modules

This file complements Mathlib's description of the span of a family by linear combinations:
coercion from a submodule commutes with linear combinations, membership in the span of a
*linearly independent* family is witnessed by a unique
finitely supported combination, and in a *Noetherian* module every sequence has a term that is a
linear combination of its predecessors. A linear map sending each vector of a finite family
to the corresponding standard basis vector of `ι → R` is a left inverse of the linear combination
map of that family, hence surjective. The linear map on finitely supported functions with matrix
coefficients `f`, sending `i` to the finitely supported function `f i` on a finite type, has the
entries of `f` as its coefficients. A sum of members of a family along a list is the linear
combination whose coefficients count the letters of the list, and every element of the additive
subsemigroup generated by the members of a family is a combination of the family with nonnegative
coefficients. A linear combination whose coefficients are supported in a finset `s` is a sum
indexed by the elements of `s`. Applying a ring homomorphism to every coefficient of finitely
supported vectors commutes with linear combinations of such vectors, and a semilinear map sends a
linear combination to the combination of the images with the twisted coefficients.

## Main statements

* `LinearIndependent.mem_span_range_iff_existsUnique`: membership in the span of a
  linearly independent family is equivalent to having unique finitely supported coordinates.
* `Finsupp.linearCombination_congr`: a linear combination depends only on the vectors indexed by
  the support of its coefficients.
* `List.sum_map_eq_linearCombination`: `(l.map v).sum` is the linear combination of `v` with the
  letter counts of `l` as coefficients.
* `Finsupp.linearCombination_eq_sum_coe_of_support_subset`: if `a` is supported in `s`, then
  `linearCombination R v a = ∑ i : s, a i • v i`.
* `AddSubsemigroup.exists_nonneg_linearCombination_eq_of_mem_closure_range`: every element of the
  additive subsemigroup generated by the members of `v` is a combination of `v` with nonnegative
  coefficients.
* `TauCeti.exists_sum_smul_eq_of_isNoetherian`: in a Noetherian module some term of a sequence is
  a linear combination of its predecessors.
* `TauCeti.leftInverse_fintypeLinearCombination`: a linear map `M → (ι → R)` sending each `x i` to
  the `i`-th standard basis vector is a left inverse of `Fintype.linearCombination R x`.
* `Finsupp.linearCombination_equivFunOnFinite_symm_apply` and
  `Finsupp.linearCombination_equivFunOnFinite_symm_eq_zero_iff`: the coefficients of the linear map
  on free modules over a finite basis with a given matrix, and its vanishing exactly when every
  matrix entry vanishes.
* `Fintype.linearCombination_intCast`: an additive map sends an integer linear combination to the
  linear combination of the images with the integer coefficients cast to the scalar ring.
* `Fintype.linearCombination_comp_equiv` and `Fintype.bijective_linearCombination_comp_equiv_iff`:
  reindexing a family along an equivalence reindexes the coefficients of its linear combinations,
  and preserves the bijectivity of the linear combination map.
* `Finsupp.mapRange_linearCombination`: applying a ring homomorphism `f` coefficientwise sends
  `∑ᵢ gᵢ • vᵢ` to `∑ᵢ f gᵢ • (f ∘ vᵢ)`, for finitely supported vectors `vᵢ`.
* `Finsupp.apply_linearCombinationₛₗ`: a `σ`-semilinear map `f` sends `∑ᵢ lᵢ • vᵢ` to
  `∑ᵢ σ lᵢ • f vᵢ`.
-/

public section

section

variable {ι R M : Type*} [Semiring R] [AddCommMonoid M] [Module R M]

/-- Coercing a linear combination in a submodule gives the corresponding combination in the
ambient module. -/
@[simp, norm_cast]
theorem _root_.Submodule.coe_linearCombination {p : Submodule R M} (v : ι → p) (a : ι →₀ R) :
    (Finsupp.linearCombination R v a : M) =
      Finsupp.linearCombination R (fun i ↦ (v i : M)) a := by
  simpa only [Submodule.subtype_apply, Function.comp_def] using
    Finsupp.apply_linearCombination R p.subtype v a

/-- An element lies in the span of a linearly independent family exactly when it has a unique
finitely supported expression in that family. -/
theorem _root_.LinearIndependent.mem_span_range_iff_existsUnique {v : ι → M}
    (h : LinearIndependent R v) (x : M) :
    x ∈ Submodule.span R (Set.range v) ↔
      ∃! a : ι →₀ R, a.sum (fun i r => r • v i) = x := by
  rw [Finsupp.mem_span_range_iff_exists_finsupp]
  constructor
  · rintro ⟨a, ha⟩
    refine ⟨a, ha, fun b hb => ?_⟩
    apply h.finsuppLinearCombination_injective
    simpa only [Finsupp.linearCombination_apply] using hb.trans ha.symm
  · exact ExistsUnique.exists

/-- A linear combination depends only on the vectors indexed by the support of its
coefficients. -/
theorem Finsupp.linearCombination_congr {v v' : ι → M} {l : ι →₀ R}
    (h : ∀ i ∈ l.support, v i = v' i) :
    Finsupp.linearCombination R v l = Finsupp.linearCombination R v' l := by
  simp only [Finsupp.linearCombination_apply]
  exact Finsupp.sum_congr fun i hi ↦ by rw [h i hi]

/-- The sum of a family along a list is the linear combination of the family whose coefficients
are the letter counts of the list. -/
theorem _root_.List.sum_map_eq_linearCombination (l : List ι) (v : ι → M) :
    (l.map v).sum =
      Finsupp.linearCombination R v (l.map fun j => Finsupp.single j (1 : R)).sum := by
  induction l with
  | nil => simp
  | cons j l ih => simp [ih]

/-- A linear combination whose coefficients are supported in a finset `s` is the sum over the
elements of `s`, indexed by the subtype. -/
theorem _root_.Finsupp.linearCombination_eq_sum_coe_of_support_subset {v : ι → M} {a : ι →₀ R}
    {s : Finset ι} (h : a.support ⊆ s) :
    Finsupp.linearCombination R v a = ∑ i : s, a i • v i := by
  rw [Finset.sum_coe_sort s (fun i ↦ a i • v i)]
  exact Finsupp.linearCombination_apply_of_mem_supported R
    ((Finsupp.mem_supported R a).2 (Finset.coe_subset.2 h))

end

/-- Every element of the additive subsemigroup generated by the members of a family is a linear
combination of the family with nonnegative coefficients, over any semiring `R` of scalars whose
preorder has `0 ≤ 1` and monotone addition (for instance `ℕ`, `ℤ` or `ℝ`). -/
theorem AddSubsemigroup.exists_nonneg_linearCombination_eq_of_mem_closure_range
    {ι : Type*} (R : Type*) {M : Type*} [Semiring R] [Preorder R] [AddLeftMono R]
    [ZeroLEOneClass R] [AddCommMonoid M] [Module R M] {v : ι → M} {x : M}
    (hx : x ∈ closure (Set.range v)) :
    ∃ n : ι →₀ R, (∀ j, 0 ≤ n j) ∧ Finsupp.linearCombination R v n = x := by
  classical
  induction hx using closure_induction with
  | mem _ hx =>
    obtain ⟨j, rfl⟩ := hx
    refine ⟨Finsupp.single j 1, fun k => ?_, by rw [Finsupp.linearCombination_single, one_smul]⟩
    rw [Finsupp.single_apply]
    split_ifs <;> simp
  | add _ _ _ _ hx hy =>
    obtain ⟨n, hn, rfl⟩ := hx
    obtain ⟨n', hn', rfl⟩ := hy
    exact ⟨n + n', fun k => add_nonneg (hn k) (hn' k), map_add _ _ _⟩

namespace TauCeti

variable (R : Type*) {M : Type*} [Semiring R] [AddCommMonoid M] [Module R M]

/-- **In a Noetherian module some term of a sequence is a linear combination of its
predecessors.**  The spans of the initial segments of `v` form an increasing chain of submodules,
which must stabilize; at the first repetition `v n` already lies in the span of the earlier terms.
-/
theorem exists_sum_smul_eq_of_isNoetherian [IsNoetherian R M] (v : ℕ → M) :
    ∃ (n : ℕ) (c : Fin n → R), ∑ i : Fin n, c i • v i = v n := by
  obtain ⟨n, hn⟩ := monotone_stabilizes_iff_noetherian.mpr ‹IsNoetherian R M›
    ⟨fun m => Submodule.span R (v '' Set.Iio m),
      fun i j hij => Submodule.span_mono (Set.image_mono (Set.Iio_subset_Iio hij))⟩
  have hstep : Submodule.span R (v '' Set.Iio n) = Submodule.span R (v '' Set.Iio (n + 1)) :=
    hn (n + 1) (Nat.le_succ n)
  have hmem : v n ∈ Submodule.span R (Set.range fun i : Fin n => v i) := by
    rw [Set.range_comp', Fin.range_val, hstep]
    exact Submodule.subset_span ⟨n, n.lt_add_one, rfl⟩
  exact ⟨n, (Submodule.mem_span_range_iff_exists_fun _).mp hmem⟩

/-- A linear map `φ : M → (ι → R)` with `φ (x i) = eᵢ` for every `i` is a left inverse of the linear
combination map `v ↦ ∑ i, v i • x i`; in particular it is surjective. -/
theorem leftInverse_fintypeLinearCombination {ι R M : Type*} [Fintype ι] [DecidableEq ι]
    [Semiring R] [AddCommMonoid M] [Module R M] {x : ι → M} {φ : M →ₗ[R] ι → R}
    (hφ : ∀ i, φ (x i) = Pi.single i 1) :
    Function.LeftInverse φ (Fintype.linearCombination R x) := fun v ↦ by
  ext j
  simp [Fintype.linearCombination_apply, hφ, Pi.single_apply]

end TauCeti

namespace Finsupp

variable {ι κ R : Type*} [Semiring R] [Finite κ]

/-- The coefficient of `j` in the image of a chain `c` under the `R`-linear map on free modules
with matrix coefficients `f`, which sends the basis vector `i` to `∑ j, f i j • j`. -/
theorem linearCombination_equivFunOnFinite_symm_apply (f : ι → κ → R) (c : ι →₀ R) (j : κ) :
    Finsupp.linearCombination R (fun i => Finsupp.equivFunOnFinite.symm (f i)) c j =
      c.sum fun i a => a * f i j := by
  simp [Finsupp.linearCombination_apply, Finsupp.sum_apply]

/-- The matrix coefficients of the `R`-linear map on free modules with matrix coefficients `f`
are the entries of `f`. -/
theorem linearCombination_equivFunOnFinite_symm_single_apply (f : ι → κ → R) (i : ι) (j : κ)
    (a : R) :
    Finsupp.linearCombination R (fun i => Finsupp.equivFunOnFinite.symm (f i))
      (Finsupp.single i a) j = a * f i j := by
  simp

/-- The `R`-linear map on free modules with matrix coefficients `f` vanishes exactly when all of
its coefficients vanish. -/
theorem linearCombination_equivFunOnFinite_symm_eq_zero_iff {f : ι → κ → R} :
    Finsupp.linearCombination R (fun i => Finsupp.equivFunOnFinite.symm (f i)) = 0 ↔
      ∀ i j, f i j = 0 := by
  refine ⟨fun h i j => ?_, fun h => ?_⟩
  · simpa using DFunLike.congr_fun (LinearMap.congr_fun h (Finsupp.single i 1)) j
  · ext i j
    simp [h]

end Finsupp

/-- An additive map `f : N →+ M` into a module over a ring `R` sends the integer linear combination
`∑ j, k j • u j` to the `R`-linear combination of the images `f (u j)` with the coefficients
`k j` cast to `R`. -/
theorem Fintype.linearCombination_intCast {ι R N M : Type*} [Fintype ι] [Ring R] [AddCommGroup N]
    [AddCommGroup M] [Module R M] (f : N →+ M) (u : ι → N) (k : ι → ℤ) :
    Fintype.linearCombination R (fun j ↦ f (u j)) (fun j ↦ (k j : R)) =
      f (Fintype.linearCombination ℤ u k) := by
  simp [Fintype.linearCombination_apply, map_sum, Int.cast_smul_eq_zsmul]

section Reindex

variable {ι κ R M : Type*} [Fintype ι] [Fintype κ] [Semiring R] [AddCommMonoid M] [Module R M]

/-- Reindexing a family `v` along an equivalence `e : κ ≃ ι` reindexes the coefficients of its
linear combinations along `e.symm`. -/
theorem Fintype.linearCombination_comp_equiv (e : κ ≃ ι) (v : ι → M) :
    Fintype.linearCombination R (v ∘ e) =
      Fintype.linearCombination R v ∘ₗ (LinearEquiv.funCongrLeft R R e.symm).toLinearMap := by
  ext c
  simp only [Fintype.linearCombination_apply, LinearMap.coe_comp, LinearEquiv.coe_coe,
    Function.comp_apply, LinearEquiv.funCongrLeft_apply]
  exact Fintype.sum_equiv e _ _ fun k ↦ by simp

/-- Reindexing a family along an equivalence does not change whether its linear combination map
is bijective, that is, whether it is a basis. -/
theorem Fintype.bijective_linearCombination_comp_equiv_iff (e : κ ≃ ι) {v : ι → M} :
    Function.Bijective (Fintype.linearCombination R (v ∘ e)) ↔
      Function.Bijective (Fintype.linearCombination R v) := by
  rw [Fintype.linearCombination_comp_equiv, LinearMap.coe_comp]
  exact Function.Bijective.of_comp_iff _ (LinearEquiv.funCongrLeft R R e.symm).bijective

end Reindex

namespace Finsupp

variable {ι κ A B F : Type*} [Semiring A] [Semiring B] [FunLike F A B] [RingHomClass F A B]

/-- Applying a ring homomorphism to every coefficient commutes with linear combinations of
finitely supported vectors: the image of `∑ᵢ gᵢ • vᵢ` is `∑ᵢ f gᵢ • (f ∘ vᵢ)`. -/
theorem mapRange_linearCombination (f : F) (v : ι → κ →₀ A) (g : ι →₀ A) :
    mapRange f (map_zero f) (linearCombination A v g) =
      linearCombination B (fun i ↦ mapRange f (map_zero f) (v i)) (mapRange f (map_zero f) g) := by
  rw [linearCombination_apply, linearCombination_apply,
    sum_mapRange_index fun i ↦ zero_smul B (mapRange f (map_zero f) (v i))]
  exact (map_finsuppSum (mapRange.addMonoidHom (f : A →+ B)) _ _).trans
    (sum_congr fun i _ ↦ mapRange_smul' _ _ _ (map_mul f _))

end Finsupp

/-- A semilinear map `f : M →ₛₗ[σ] N` sends the linear combination `∑ᵢ lᵢ • vᵢ` to the linear
combination `∑ᵢ σ lᵢ • f vᵢ`. This is the semilinear version of
`Finsupp.apply_linearCombination`. -/
theorem Finsupp.apply_linearCombinationₛₗ {ι R S M N : Type*} [Semiring R] [Semiring S]
    [AddCommMonoid M] [Module R M] [AddCommMonoid N] [Module S N] {σ : R →+* S}
    (f : M →ₛₗ[σ] N) (v : ι → M) (l : ι →₀ R) :
    f (linearCombination R v l) = linearCombination S (f ∘ v) (l.mapRange σ (map_zero σ)) := by
  simp [linearCombination_apply, sum_mapRange_index, map_finsuppSum]

