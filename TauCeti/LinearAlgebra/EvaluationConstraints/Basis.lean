/-!
# Bases and determinants of evaluation constraint modules

Let `E` be a field, `R` a commutative `E`-algebra, `ev : ι → R →ₐ[E] E` a family of evaluations
and `V j ⊆ κ → E` subspaces, with `κ` finite. Suppose that for each `j` in a finite set `J` the
kernel of `ev j` is generated by `q j = t - x j`, with the points `x j` pairwise distinct. This file
shows that the evaluation constraint module `TauCeti.evaluationConstraints ev V J` of rows
`F : κ → R` with `ev j ∘ F ∈ V j` for `j ∈ J` is the row space of a square matrix whose
determinant is associated to `∏_{j ∈ J} q j ^ (card κ - dim V j)`. When `R` is a domain and each
`q j` is nonzero, its rows form an `R`-basis of the constraint module, and the determinant of the
rows of *every* `R`-basis of the module is associated to the same product.

In the work of Lei, Loeffler and Zerbes this computes the images of Coleman maps of crystalline
representations: a character component of the image is such a constraint module, so it is free,
and its determinant is the product of the factors `q j` counted with the codimensions of the
subspaces `V j`.

The construction imposes the conditions one at a time. A single condition at `j` is the row space
of `diag(1, …, 1, q, …, q) * C`, where the rows of the invertible scalar matrix `C` form a basis of
`κ → E` adapted to `V j` and `q` occurs `codim (V j)` times. If the rows of `A` span the module
for the conditions in `J`, a new point `j ∉ J` specialises `A` to an invertible scalar matrix,
because `ev j (q i) = x j - x i ≠ 0` for `i ∈ J`; the new condition then becomes a single condition
on the coefficient rows, for the subspace pulled back along that scalar matrix.

## Main results

* `TauCeti.exists_range_vecMulLinear_eq_evaluationConstraints_singleton`: a single condition is
  the row space of a matrix with determinant associated to `q ^ (card κ - dim V j)`.
* `TauCeti.isUnit_map_of_associated_det_prod_sub`: a matrix with determinant associated to a
  product of powers of the factors `t - x i` specialises to an invertible matrix at any evaluation
  with `ev t ≠ x i`.
* `TauCeti.exists_range_vecMulLinear_eq_evaluationConstraints`: the evaluation constraint module
  is the row space of a matrix with determinant associated to `∏_{j ∈ J} q j ^ (card κ - dim V j)`.
* `TauCeti.exists_basis_evaluationConstraints`: over a domain, with nonzero factors, the module has
  an `R`-basis indexed by `κ` whose determinant is associated to that product.
* `TauCeti.associated_det_basis_evaluationConstraints`: the determinant of every such basis is
  associated to that product.

## References

* A. Lei, D. Loeffler and S. L. Zerbes, *Coleman maps and the p-adic regulator*, Algebra & Number
  Theory 5 (2011), §4A, Lemma 4.1 and Proposition 4.2.
-/

public section

open Finset Module

open scoped Matrix

namespace TauCeti

variable {E R ι κ : Type*} [Field E] [CommRing R] [Algebra E R] [Fintype κ] [DecidableEq κ]
  {ev : ι → R →ₐ[E] E} {V : ι → Submodule E (κ → E)}

/-- **Single-condition row matrix.** If the kernel of `ev j` is generated by `q`, the rows `F`
with `ev j ∘ F ∈ V j` form the row space of a square matrix whose determinant is associated to
`q ^ (card κ - finrank E (V j))`. -/
theorem exists_range_vecMulLinear_eq_evaluationConstraints_singleton {j : ι} {q : R}
    (hker : RingHom.ker (ev j) = Ideal.span {q}) :
    ∃ A : Matrix κ κ R, LinearMap.range A.vecMulLinear = evaluationConstraints ev V {j} ∧
      Associated A.det (q ^ (Fintype.card κ - finrank E (V j))) := by
  -- A basis `b` of `κ → E` in which `V j` is cut out by the coordinates outside `s`.
  obtain ⟨b, s, hV, hs⟩ := (V j).exists_basis_mem_iff_forall_repr_eq_zero (ι := κ) (by simp)
  let C : Matrix κ κ R := (Matrix.of fun k => b k).map (algebraMap E R)
  have hC : IsUnit C := by
    have hb : IsUnit (Matrix.of fun k => b k) := by
      rw [← Matrix.linearIndependent_row_iff_isUnit, Matrix.row_of]
      exact b.linearIndependent
    simpa [C, RingHom.mapMatrix_apply] using hb.map (algebraMap E R).mapMatrix
  -- A row `w ᵥ* C` satisfies the condition exactly when `ev j` kills its coordinates outside `s`.
  have key (w : κ → R) : ev j ∘ (w ᵥ* C) ∈ V j ↔ ∀ k ∉ s, ev j (w k) = 0 := by
    have hw : ev j ∘ (w ᵥ* C) = ∑ k, ev j (w k) • b k := by
      ext l
      simp [C, Matrix.vecMul, dotProduct, Finset.sum_apply]
    rw [hV, hw, b.repr_sum_self]
  have hq : ev j q = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_span_singleton_self q
  let δ : κ → R := fun k => if k ∈ s then 1 else q
  refine ⟨Matrix.diagonal δ * C, ?_, ?_⟩
  · ext F
    rw [LinearMap.mem_range, mem_evaluationConstraints_singleton]
    constructor
    · rintro ⟨a, rfl⟩
      rw [Matrix.vecMulLinear_apply, ← Matrix.vecMul_vecMul, key]
      intro k hk
      simp [Matrix.vecMul_diagonal, δ, hk, hq]
    · intro hF
      obtain ⟨w, rfl⟩ := Matrix.vecMul_surjective_iff_isUnit.2 hC F
      rw [key] at hF
      have hdvd (k : κ) : ∃ a, w k = a * δ k := by
        by_cases hk : k ∈ s
        · exact ⟨w k, by simp [δ, hk]⟩
        · obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.1 (hker ▸ RingHom.mem_ker.2 (hF k hk))
          exact ⟨a, by simp [δ, hk, ha]⟩
      choose a ha using hdvd
      refine ⟨a, ?_⟩
      rw [Matrix.vecMulLinear_apply, ← Matrix.vecMul_vecMul]
      congr 1
      ext k
      simp [Matrix.vecMul_diagonal, ha]
  · have hδ : ∏ k, δ k = q ^ (Fintype.card κ - finrank E (V j)) := by
      simp [δ, Finset.prod_ite, ← hs, filter_notMem_eq_sdiff, card_univ_sdiff]
    rw [Matrix.det_mul, Matrix.det_diagonal, hδ]
    exact associated_mul_unit_left _ _ ((Matrix.isUnit_iff_isUnit_det C).1 hC)

/-- **Invertibility at a new point.** If the determinant of `A` is associated to a product of
powers of the factors `t - x i`, `i ∈ J`, then `A` specialises to an invertible scalar matrix
under every `E`-algebra map `φ` with `φ t ≠ x i` for `i ∈ J`. -/
theorem isUnit_map_of_associated_det_prod_sub {t : R} {x : ι → E} {J : Finset ι} {n : ι → ℕ}
    {A : Matrix κ κ R} (hA : Associated A.det (∏ i ∈ J, (t - algebraMap E R (x i)) ^ n i))
    {φ : R →ₐ[E] E} (hφ : ∀ i ∈ J, x i ≠ φ t) : IsUnit (A.map φ) := by
  obtain ⟨u, hu⟩ := hA
  have hprod : φ (∏ i ∈ J, (t - algebraMap E R (x i)) ^ n i) ≠ 0 := by
    simp only [map_prod, map_pow, map_sub, AlgHom.commutes, Algebra.algebraMap_self,
      RingHom.id_apply]
    exact prod_ne_zero_iff.2 fun i hi => pow_ne_zero _ (sub_ne_zero.2 (hφ i hi).symm)
  rw [Matrix.isUnit_iff_isUnit_det, isUnit_iff_ne_zero]
  intro h
  apply hprod
  rw [← hu, map_mul, AlgHom.map_det]
  simp [AlgHom.mapMatrix_apply, h]

/-- **Row matrix of simultaneous constraints.** If the kernel of each `ev j`, `j ∈ J`, is generated
by `t - x j` and the `x j` are pairwise distinct on `J`, then the evaluation constraint module is
the row space of a square matrix whose determinant is associated to
`∏_{j ∈ J} (t - x j) ^ (card κ - finrank E (V j))`. -/
theorem exists_range_vecMulLinear_eq_evaluationConstraints {t : R} {x : ι → E} {J : Finset ι}
    (hx : Set.InjOn x J)
    (hker : ∀ j ∈ J, RingHom.ker (ev j) = Ideal.span {t - algebraMap E R (x j)}) :
    ∃ A : Matrix κ κ R, LinearMap.range A.vecMulLinear = evaluationConstraints ev V J ∧
      Associated A.det
        (∏ j ∈ J, (t - algebraMap E R (x j)) ^ (Fintype.card κ - finrank E (V j))) := by
  classical
  induction J using Finset.induction_on with
  | empty => exact ⟨1, by ext F; simp, by simp⟩
  | insert j J hj ih =>
    obtain ⟨A, hA, hdet⟩ := ih (hx.mono (by simp)) fun i hi => hker i (mem_insert_of_mem hi)
    -- The rows of `A` span the module for `J`. At the new point `j` the specialisation of `A`
    -- is an invertible scalar matrix, because `ev j (t - x i) = x j - x i ≠ 0` for `i ∈ J`.
    have hev : ev j t = x j := AlgHom.apply_eq_of_ker_eq_span_sub (hker j (mem_insert_self j J))
    obtain ⟨Ā, hĀ⟩ : ∃ Ā : (κ → E) ≃ₗ[E] κ → E, ∀ v, Ā v = v ᵥ* A.map (ev j) := by
      have h := isUnit_map_of_associated_det_prod_sub hdet fun i hi h =>
        hj (hx (by simp [hi]) (by simp) (h.trans hev) ▸ hi)
      exact ⟨.ofBijective (A.map (ev j)).vecMulLinear
        ⟨Matrix.vecMul_injective_iff_isUnit.2 h, Matrix.vecMul_surjective_iff_isUnit.2 h⟩,
        fun _ => rfl⟩
    -- So the condition at `j` on `c ᵥ* A` is a single condition on `c`, for the pullback of
    -- `V j` along `Ā`, which has the same dimension as `V j`.
    have hcond (c : κ → R) : ev j ∘ (c ᵥ* A) ∈ V j ↔
        c ∈ evaluationConstraints ev (fun _ => (V j).comap Ā.toLinearMap) {j} := by
      have hmap : ev j ∘ (c ᵥ* A) = (ev j ∘ c) ᵥ* A.map (ev j) := by
        ext k
        simpa using RingHom.map_vecMul (ev j : R →+* E) A c k
      rw [mem_evaluationConstraints_singleton, Submodule.mem_comap, LinearEquiv.coe_coe, hĀ,
        hmap]
    have hW : finrank E ((V j).comap Ā.toLinearMap) = finrank E (V j) := by
      rw [Submodule.comap_equiv_eq_map_symm, LinearEquiv.finrank_map_eq]
    obtain ⟨B, hB, hBdet⟩ := exists_range_vecMulLinear_eq_evaluationConstraints_singleton
      (V := fun _ => (V j).comap Ā.toLinearMap) (hker j (mem_insert_self j J))
    refine ⟨B * A, ?_, ?_⟩
    · ext F
      rw [mem_evaluationConstraints_insert, ← hA, LinearMap.mem_range, LinearMap.mem_range]
      constructor
      · rintro ⟨a, rfl⟩
        rw [Matrix.vecMulLinear_apply, ← Matrix.vecMul_vecMul, hcond, ← hB]
        exact ⟨⟨a, rfl⟩, a ᵥ* B, rfl⟩
      · rintro ⟨hF, c, rfl⟩
        rw [Matrix.vecMulLinear_apply, hcond, ← hB] at hF
        obtain ⟨a, rfl⟩ := hF
        exact ⟨a, by simp [Matrix.vecMul_vecMul]⟩
    · rw [prod_insert hj, Matrix.det_mul]
      exact (hW ▸ hBdet).mul_mul hdet

/-- **Basis of simultaneous constraints.** Over a domain `R`, if the kernel of each `ev j`,
`j ∈ J`, is generated by a nonzero `t - x j` and the `x j` are pairwise distinct on `J`, then the
evaluation constraint module has an `R`-basis indexed by `κ` whose matrix of rows has determinant
associated to `∏_{j ∈ J} (t - x j) ^ (card κ - finrank E (V j))`. -/
theorem exists_basis_evaluationConstraints [IsDomain R] {t : R} {x : ι → E} {J : Finset ι}
    (hx : Set.InjOn x J)
    (hker : ∀ j ∈ J, RingHom.ker (ev j) = Ideal.span {t - algebraMap E R (x j)})
    (hq : ∀ j ∈ J, t - algebraMap E R (x j) ≠ 0) :
    ∃ b : Basis κ R (evaluationConstraints ev V J),
      Associated (Matrix.of fun i => (b i : κ → R)).det
        (∏ j ∈ J, (t - algebraMap E R (x j)) ^ (Fintype.card κ - finrank E (V j))) := by
  obtain ⟨A, hA, hdet⟩ := exists_range_vecMulLinear_eq_evaluationConstraints (V := V) hx hker
  have hA0 : A.det ≠ 0 := by
    rw [Ne, hdet.eq_zero_iff]
    exact prod_ne_zero_iff.2 fun j hj => pow_ne_zero _ (hq j hj)
  have hspan : Submodule.span R (Set.range A.row) = evaluationConstraints ev V J := by
    rw [← range_vecMulLinear, hA]
  refine ⟨(Basis.span (Matrix.linearIndependent_rows_of_det_ne_zero hA0)).map
    (LinearEquiv.ofEq _ _ hspan), ?_⟩
  convert hdet
  ext i k
  simp

/-- **Determinant ideal of the constraint module.** Over a domain `R`, if the kernel of each
`ev j`, `j ∈ J`, is generated by a nonzero `t - x j` and the `x j` are pairwise distinct on `J`,
then for every `R`-basis of the evaluation constraint module indexed by `κ`, the determinant of its
matrix of rows is associated to `∏_{j ∈ J} (t - x j) ^ (card κ - finrank E (V j))`. -/
theorem associated_det_basis_evaluationConstraints [IsDomain R] {t : R} {x : ι → E}
    {J : Finset ι} (hx : Set.InjOn x J)
    (hker : ∀ j ∈ J, RingHom.ker (ev j) = Ideal.span {t - algebraMap E R (x j)})
    (hq : ∀ j ∈ J, t - algebraMap E R (x j) ≠ 0) (b : Basis κ R (evaluationConstraints ev V J)) :
    Associated (Matrix.of fun i => (b i : κ → R)).det
      (∏ j ∈ J, (t - algebraMap E R (x j)) ^ (Fintype.card κ - finrank E (V j))) := by
  obtain ⟨b₀, hb₀⟩ := exists_basis_evaluationConstraints (κ := κ) (V := V) hx hker hq
  refine Associated.trans ?_ hb₀
  -- Both row determinants are values of the standard determinant form on `R^κ`, and they differ
  -- by the change-of-basis determinant `b₀.det b`, a unit.
  have h := b₀.det_comp_eq_mul (Pi.basisFun R κ) (evaluationConstraints ev V J).subtype b
  simp only [Pi.basisFun_det_apply, Function.comp_def, Submodule.subtype_apply] at h
  rw [h]
  exact associated_mul_unit_left _ _ (b₀.isUnit_det b)

end TauCeti
