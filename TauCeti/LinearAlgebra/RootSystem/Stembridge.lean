module

public import TauCeti.LinearAlgebra.RootSystem.Chamber
import Mathlib.LinearAlgebra.RootSystem.Finite.Lemmas

/-!
# Stembridge's lemma: a dominant positive-root step

Fix a base `b` of a finite crystallographic root pairing `P` over a linearly ordered ring, and
compare weights by the **integral root order**: `lam` lies below `mu` when `mu - lam` belongs to
the positive root cone `Q⁺` (`TauCeti.posRootCone`), the additive monoid generated by the simple
roots. Stembridge's lemma says that between two distinct comparable dominant weights one can
always climb by a single positive root without leaving the dominant chamber: there is a positive
root `β` with `lam + β` dominant and still below `mu`.

The proof is Waldspurger's maximal-root argument. Write `mu - lam = ∑ nⱼ αⱼ` with natural
coefficients, and choose a positive root `β = ∑ mⱼ αⱼ` with `mⱼ ≤ nⱼ` of maximal height; such roots
exist because some `nⱼ` is nonzero and the corresponding simple root qualifies. At a simple index
`k`, either `mₖ < nₖ`, and then maximality says `β + αₖ` is not a root, so `⟨β, αₖ^∨⟩ ≥ 0`; or
`mₖ = nₖ`, and then `lam + β` is `mu` minus a natural combination of the *other* simple roots,
each of which pairs nonpositively with `αₖ^∨` (`RootPairing.coroot'_sum_nsmul_root_nonpos`).
Either way `lam + β` is nonnegative on `αₖ^∨`.

Only signs of simple-coroot values are used: neither endpoint needs to be integral, the root
pairing need not span its weight space, and central directions are kept. For coweights apply the
statement to `P.flip` and `b.flip`.

## Main results

* `RootPairing.stembridge_step`: **Stembridge's lemma**, the existence of a positive root `β`
  with `lam + β` dominant and `mu - (lam + β) ∈ Q⁺`.

## References

* M. Rapoport, *A positivity property of the Satake isomorphism*, Manuscripta Math. 101 (2000),
  153–166, Lemma 2.3 and its proof, equations (2.10)–(2.13).
* J. R. Stembridge, *The partial order of dominant weights*, Adv. Math. 136 (1998), 340–364.
-/

public section

namespace RootPairing

open TauCeti

variable {ι R M N : Type*} [CommRing R] [LinearOrder R] [IsStrictOrderedRing R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : RootPairing ι R M N) [Finite ι] [P.IsCrystallographic] (b : P.Base)

/-- **Stembridge's lemma.** Let `lam` and `mu` be distinct dominant weights with `mu - lam` in
the positive root cone `Q⁺`. Then there is a positive root `β` such that `lam + β` is dominant
and `mu - (lam + β)` is still in `Q⁺`.

Since `β` is a nonzero member of `Q⁺` (`TauCeti.root_mem_posRootCone_of_mem_posRoots`), the step
strictly increases `lam` in the integral root order. Neither endpoint needs integral
simple-coroot values, and the roots need not span `M`. If `lam` lies in an additive subgroup
containing the roots, so does `lam + β`.

This is the inductive step of Rapoport, *A positivity property of the Satake isomorphism*,
Lemma 2.3, proved by Waldspurger's argument: `β` is a positive root of maximal height among those
whose simple-root coordinates are bounded by those of `mu - lam`. -/
theorem stembridge_step {lam mu : M} (hlam : lam ∈ dominantChamber P b)
    (hmu : mu ∈ dominantChamber P b) (hne : lam ≠ mu) (hle : mu - lam ∈ posRootCone P b) :
    ∃ i, b.IsPos i ∧ lam + P.root i ∈ dominantChamber P b ∧
      mu - (lam + P.root i) ∈ posRootCone P b := by
  classical
  obtain ⟨n, hn⟩ := (mem_posRootCone P b).mp hle
  -- The eligible roots: those whose simple-root coordinates are bounded by `n`.
  let E : Set ι := {i | ∃ m : ι → ℕ, (∀ j ∈ b.support, m j ≤ n j) ∧
    P.root i = ∑ j ∈ b.support, m j • P.root j}
  have hE : E.Nonempty := by
    obtain ⟨k, hk, hnk⟩ : ∃ k ∈ b.support, n k ≠ 0 := by
      by_contra! h
      refine hne (sub_eq_zero.mp ?_).symm
      rw [hn]
      exact Finset.sum_eq_zero fun j hj => by rw [h j hj, zero_smul]
    refine ⟨k, fun j => if j = k then 1 else 0, fun j _ => ?_, ?_⟩
    · dsimp only
      split_ifs with h
      · subst h; omega
      · exact Nat.zero_le _
    · simp [ite_smul, hk]
  obtain ⟨β, ⟨m, hmn, hβ⟩, hmax⟩ := Set.exists_max_image E b.height E.toFinite hE
  have hβcone : P.root β ∈ posRootCone P b := (mem_posRootCone P b).mpr ⟨m, hβ⟩
  have hβpos : b.IsPos β :=
    (mem_posRoots P b β).mp ((mem_posRoots_iff_root_mem_posRootCone P b).mpr hβcone)
  -- The budget left after the step is the natural combination with coefficients `n - m`.
  have hbudget : mu - (lam + P.root β) = ∑ j ∈ b.support, (n j - m j) • P.root j := by
    rw [sub_add_eq_sub_sub, hn, hβ, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun j hj => ?_
    rw [sub_eq_iff_eq_add, ← add_nsmul, Nat.sub_add_cancel (hmn j hj)]
  refine ⟨β, hβpos, ?_, hbudget ▸ (mem_posRootCone P b).mpr ⟨_, rfl⟩⟩
  rw [mem_dominantChamber]
  intro k hk
  rcases lt_or_ge (m k) (n k) with hlt | hge
  · -- `β + αₖ` would be an eligible root of larger height, so it is not a root.
    have hnot : P.root β + P.root k ∉ Set.range P.root := by
      rintro ⟨l, hl⟩
      have hlE : l ∈ E := by
        refine ⟨fun j => m j + if j = k then 1 else 0, fun j hj => ?_, ?_⟩
        · have := hmn j hj
          dsimp only
          split_ifs with h
          · subst h; omega
          · omega
        · simp [hl, hβ, add_nsmul, Finset.sum_add_distrib, ite_smul, hk]
      have hheight := b.height_add hl
      rw [b.height_one_of_mem_support hk] at hheight
      have := hmax l hlE
      omega
    have hneg : P.root β ≠ -P.root k := fun h => P.ne_zero β <|
      eq_zero_of_add_eq_zero_of_mem_posRootCone P b hβcone
        (root_mem_posRootCone_of_mem_posRoots P b ((mem_posRoots P b k).mpr
          (b.isPos_of_mem_support hk))) (add_eq_zero_iff_eq_neg.mpr h)
    have hpair : 0 ≤ P.pairingIn ℤ β k := by
      by_contra! h
      exact hnot (P.root_add_root_mem_of_pairingIn_neg h hneg)
    rw [map_add, root_coroot'_eq_pairing, ← P.algebraMap_pairingIn ℤ, algebraMap_int_eq,
      eq_intCast]
    exact add_nonneg ((mem_dominantChamber P b lam).mp hlam k hk) (Int.cast_nonneg_iff.mpr hpair)
  · -- `lam + β` is `mu` minus a natural combination of the simple roots other than `αₖ`.
    have hsum : lam + P.root β = mu - ∑ j ∈ b.support, (n j - m j) • P.root j := by
      rw [← hbudget, sub_sub_cancel]
    rw [hsum, map_sub, sub_nonneg]
    exact (P.coroot'_sum_nsmul_root_nonpos b hk (by omega)).trans
      ((mem_dominantChamber P b mu).mp hmu k hk)

end RootPairing
