module

public import Mathlib.LinearAlgebra.RootSystem.CartanMatrix
public import TauCeti.LinearAlgebra.Matrix.Cartan.ColumnReflection
public import TauCeti.LinearAlgebra.RootSystem.SimpleReflections

/-!
# Reflections on simple-root coefficients

A base `b` of a root pairing makes the root lattice free on the simple roots
(`RootPairing.Base.toWeightBasisInt`), so its elements are integer columns indexed by `b.support`.
This file reads the simple reflections and the roots themselves in these coordinates. The
reflection at `i` becomes the explicit update of `Matrix.columnReflection` on the Cartan matrix of
`b`, which can be run without any knowledge of the root pairing, and the set of root columns is
recovered from the simple ones by iterating that update.

The roots are not assumed to span, and only the orbit theorems use finiteness or reducedness. In a
nonreduced system such as `BC₁` the root `2α` is not in the Weyl orbit of the simple root `α`, so
reducedness cannot be dropped from them.

## Main definitions

* `RootPairing.Base.coefficientReflection`: the reflection at a simple root, on columns.
* `RootPairing.Base.coefficientWeylGroup`: the group generated by these reflections.
* `RootPairing.Base.rootCoefficients`: the column of simple-root coefficients of a root.

## Main results

* `RootPairing.Base.coe_toWeightBasisInt_equivFun_symm_coefficientReflection`: evaluation in the
  root lattice intertwines the reflection on columns with the actual reflection.
* `RootPairing.Base.rootCoefficients_eq_iff`: the characterization of the column of a root.
* `RootPairing.Base.coefficientReflection_rootCoefficients`: the reflection on columns computes the
  column of the reflected root.
* `RootPairing.Base.zero_le_rootCoefficients_iff`: a root is positive exactly when its column is
  nonnegative.
* `RootPairing.Base.coefficientReflection_map` and `RootPairing.Base.rootCoefficients_map`:
  compatibility with transporting a base along an equivalence of root pairings.
* `RootPairing.Base.orbit_rootCoefficients_eq_image`: the orbit of a root column is the image of the
  orbit of the root under the actual Weyl group.
* `RootPairing.Base.iUnion_orbit_single_eq_range_rootCoefficients`: the union of the orbits of the
  simple columns is the set of all root columns, including those of negative roots.
* `RootPairing.Base.iUnion_orbit_single_inter_Ici_eq_image_isPos`: its nonnegative part is the set
  of columns of positive roots.

## References

* SGA 3, Exposé XXI, §1.1, for the coefficient formula of a simple reflection.
* J. S. Milne, *Algebraic Groups*, Appendix C, C.21 and C.22, for the description of the roots as
  the Weyl orbits of the simple roots.
-/

public noncomputable section

open Function Set Module

namespace RootPairing.Base

variable {ι R V U : Type*} [CommRing R] [CharZero R] [AddCommGroup V] [Module R V]
  [AddCommGroup U] [Module R U] {P : RootPairing ι R V U} (b : P.Base)

omit [CharZero R] in
/-- The reflection of an integer combination of roots corrects it by a multiple of the root of the
reflection, with coefficient computed by the integral pairing. -/
theorem _root_.RootPairing.reflection_sum_zsmul_root [P.IsCrystallographic] {κ : Type*} [Fintype κ]
    (v : κ → ι) (i : ι) (c : κ → ℤ) :
    P.reflection i (∑ k, c k • P.root (v k)) =
      ∑ k, c k • P.root (v k) - (∑ k, P.pairingIn ℤ (v k) i * c k) • P.root i := by
  simp only [map_sum, map_zsmul, P.reflection_apply_root' ℤ, smul_sub, Finset.sum_sub_distrib,
    Finset.sum_smul, mul_smul]
  congr 1
  exact Finset.sum_congr rfl fun k _ ↦ smul_comm _ _ _

/-- Evaluation of a column in the root lattice is the corresponding combination of simple roots. -/
theorem coe_toWeightBasisInt_equivFun_symm (c : b.support → ℤ) :
    ((b.toWeightBasisInt.equivFun.symm c : P.rootSpan ℤ) : V) = ∑ k, c k • P.root k := by
  simp [Basis.equivFun_symm_apply]

/-! ### The column of a root -/

/-- The column of simple-root coefficients of the root with index `i`. -/
def rootCoefficients (i : ι) : b.support → ℤ :=
  b.toWeightBasisInt.equivFun (P.rootSpanMem ℤ i)

/-- A root is the combination of the simple roots with coefficients its column. -/
theorem sum_rootCoefficients_smul_root (i : ι) :
    ∑ k, b.rootCoefficients i k • P.root k = P.root i := by
  rw [← coe_toWeightBasisInt_equivFun_symm, rootCoefficients, LinearEquiv.symm_apply_apply]

/-- The column of a root is the only column whose combination of simple roots is that root. -/
theorem rootCoefficients_eq_iff {i : ι} {c : b.support → ℤ} :
    b.rootCoefficients i = c ↔ ∑ k, c k • P.root k = P.root i := by
  rw [rootCoefficients, ← LinearEquiv.eq_symm_apply, Subtype.ext_iff,
    coe_toWeightBasisInt_equivFun_symm, eq_comm]

/-- The entries of the column of a root, from an expansion indexed by the simple indices in `ι`. -/
theorem rootCoefficients_apply_of_root_eq_sum {i : ι} {f : ι → ℤ}
    (h : P.root i = ∑ j ∈ b.support, f j • P.root j) (k : b.support) :
    b.rootCoefficients i k = f k := by
  have hc : b.rootCoefficients i = fun k : b.support ↦ f k :=
    b.rootCoefficients_eq_iff.mpr <| by
      rw [h, ← Finset.sum_coe_sort b.support fun j ↦ f j • P.root j]
  exact congrFun hc k

/-- Distinct roots have distinct columns. -/
theorem rootCoefficients_injective : Injective b.rootCoefficients := fun i j hij ↦
  P.root.injective <| by
    rw [← sum_rootCoefficients_smul_root b i, hij, sum_rootCoefficients_smul_root]

/-- The zero column is not the column of a root. -/
theorem rootCoefficients_ne_zero (i : ι) : b.rootCoefficients i ≠ 0 := fun h ↦
  P.ne_zero i <| by rw [← b.sum_rootCoefficients_smul_root i, h]; simp

/-- The column of a simple root is the corresponding coordinate column. -/
@[simp]
theorem rootCoefficients_coe [DecidableEq ι] (k : b.support) :
    b.rootCoefficients k = Pi.single k 1 :=
  b.rootCoefficients_eq_iff.mpr <| by simp [Pi.single_apply, ite_smul]

/-- The column of the negative of a root is the negative of its column. -/
@[simp]
theorem rootCoefficients_reflectionPerm_self (i : ι) :
    b.rootCoefficients (P.reflectionPerm i i) = -b.rootCoefficients i :=
  b.rootCoefficients_eq_iff.mpr <| by
    simp only [Pi.neg_apply, neg_smul, Finset.sum_neg_distrib, sum_rootCoefficients_smul_root,
      root_reflectionPerm, reflection_apply_self]

/-- The height of a root is the sum of the entries of its column. -/
theorem sum_rootCoefficients_eq_height (i : ι) : ∑ k, b.rootCoefficients i k = b.height i := by
  obtain ⟨f, -, -, hf⟩ := b.exists_root_eq_sum_int i
  simp_rw [b.rootCoefficients_apply_of_root_eq_sum hf, height_eq_sum hf]
  exact Finset.sum_coe_sort b.support f

/-- A root is positive exactly when its column is nonnegative. -/
theorem zero_le_rootCoefficients_iff {i : ι} : 0 ≤ b.rootCoefficients i ↔ b.IsPos i := by
  refine ⟨fun h ↦ (b.isPos_iff').mpr ?_, fun hi k ↦ ?_⟩
  · rw [← sum_rootCoefficients_eq_height]
    exact Finset.sum_nonneg fun k _ ↦ h k
  · obtain ⟨f, -, hf₁, hf⟩ := b.exists_root_eq_sum_int i
    rw [b.rootCoefficients_apply_of_root_eq_sum hf]
    obtain hf₁ | hf₁ := hf₁
    · exact hf₁.le k
    · have hneg : b.height i ≤ 0 := by
        rw [height_eq_sum hf]
        exact Finset.sum_nonpos fun j _ ↦ hf₁.le j
      exact absurd ((b.isPos_iff).mp hi) hneg.not_gt

/-! ### Transport of a base -/

section Map

variable {ι₂ V₂ U₂ : Type*} [DecidableEq ι₂] [AddCommGroup V₂] [Module R V₂] [AddCommGroup U₂]
  [Module R U₂] {P₂ : RootPairing ι₂ R V₂ U₂} (e : P.Equiv P₂)

/-- The column of a transported root, for the transported base, is the relabelled column. -/
theorem rootCoefficients_map (j : ι) :
    (b.map e).rootCoefficients (e.indexEquiv j) =
      b.rootCoefficients j ∘ (b.supportMapEquiv e).symm := by
  refine (b.map e).rootCoefficients_eq_iff.mpr ?_
  rw [← (b.supportMapEquiv e).sum_comp]
  have hroot (k : b.support) : P₂.root (b.supportMapEquiv e k) = e.weightEquiv (P.root k) :=
    (congrFun e.root_weightMap k).symm
  simp only [comp_apply, Equiv.symm_apply_apply, hroot, ← map_zsmul, ← map_sum,
    sum_rootCoefficients_smul_root]
  exact congrFun e.root_weightMap j

end Map

/-! ### The reflection on columns -/

section Reflection

variable [DecidableEq ι] [P.IsCrystallographic]

/-- The reflection at the simple root `αᵢ` on columns of simple-root coefficients: the update of
`Matrix.columnReflection` on the Cartan matrix of `b`, which is `c ↦ c - (∑ⱼ Cⱼᵢ cⱼ) eᵢ` for
`Cⱼᵢ = ⟨αⱼ, αᵢ^∨⟩`. -/
abbrev coefficientReflection (i : b.support) : (b.support → ℤ) ≃ₗ[ℤ] (b.support → ℤ) :=
  b.cartanMatrix.columnReflection b.cartanMatrix_apply_same i

/-- The group generated by the reflections on columns of simple-root coefficients. -/
abbrev coefficientWeylGroup : Subgroup ((b.support → ℤ) ≃ₗ[ℤ] (b.support → ℤ)) :=
  b.cartanMatrix.columnReflectionGroup b.cartanMatrix_apply_same

/-- Evaluating a reflected column on the simple roots gives the reflected combination. -/
theorem sum_coefficientReflection_smul_root (i : b.support) (c : b.support → ℤ) :
    ∑ k, b.coefficientReflection i c k • P.root k = P.reflection i (∑ k, c k • P.root k) := by
  rw [Matrix.sum_columnReflection_smul, P.reflection_sum_zsmul_root]
  simp only [cartanMatrixIn_def]

/-- **Evaluation in the root lattice intertwines the reflection on columns with the actual
reflection.** -/
theorem coe_toWeightBasisInt_equivFun_symm_coefficientReflection (i : b.support)
    (c : b.support → ℤ) :
    ((b.toWeightBasisInt.equivFun.symm (b.coefficientReflection i c) : P.rootSpan ℤ) : V) =
      P.reflection i (b.toWeightBasisInt.equivFun.symm c : P.rootSpan ℤ) := by
  rw [coe_toWeightBasisInt_equivFun_symm, coe_toWeightBasisInt_equivFun_symm,
    sum_coefficientReflection_smul_root]

/-- **The reflection on columns computes the column of the reflected root.** -/
theorem coefficientReflection_rootCoefficients (i : b.support) (j : ι) :
    b.coefficientReflection i (b.rootCoefficients j) =
      b.rootCoefficients (P.reflectionPerm i j) :=
  (b.rootCoefficients_eq_iff.mpr <| by
    rw [sum_coefficientReflection_smul_root, sum_rootCoefficients_smul_root,
      root_reflectionPerm]).symm

/-- The reflections on columns are compatible with the transport of a base along an equivalence of
root pairings, which relabels the coordinates by `RootPairing.Base.supportMapEquiv`. -/
theorem coefficientReflection_map {ι₂ V₂ U₂ : Type*} [DecidableEq ι₂] [AddCommGroup V₂]
    [Module R V₂] [AddCommGroup U₂] [Module R U₂] {P₂ : RootPairing ι₂ R V₂ U₂}
    [P₂.IsCrystallographic] (e : P.Equiv P₂) (i : b.support) (c : b.support → ℤ) :
    (b.map e).coefficientReflection (b.supportMapEquiv e i) (c ∘ (b.supportMapEquiv e).symm) =
      b.coefficientReflection i c ∘ (b.supportMapEquiv e).symm := by
  have h := b.cartanMatrix.columnReflection_comp_equiv b.cartanMatrix_apply_same
    (b.map e).cartanMatrix_apply_same (b.supportMapEquiv e).symm
    (fun i j ↦ by rw [b.map_equiv_cartanMatrix e, Matrix.reindex_apply, Matrix.submatrix_apply])
    (b.supportMapEquiv e i) c
  rwa [Equiv.symm_apply_apply] at h

/-! ### Orbits of columns -/

section Orbit

variable [Finite ι] [IsDomain R] [P.IsReduced]

/-- The column of the image of a root under a Weyl group element lies in the orbit of its column. -/
private theorem rootCoefficients_weylGroupToPerm_mem_orbit (w : P.weylGroup) (j : ι) :
    b.rootCoefficients (P.weylGroupToPerm w j) ∈
      MulAction.orbit b.coefficientWeylGroup (b.rootCoefficients j) := by
  have hw : w ∈ Subgroup.closure (range fun i : b.support ↦ weylGroup.ofIdx P (i : ι)) :=
    TauCeti.weylGroup_eq_closure_simple P b ▸ Subgroup.mem_top w
  induction hw using Subgroup.closure_induction generalizing j with
  | mem w hw =>
    obtain ⟨i, rfl⟩ := hw
    beta_reduce
    rw [weylGroupToPerm_ofIdx_apply, ← coefficientReflection_rootCoefficients,
      Matrix.columnReflection_mem_orbit_iff]
    exact MulAction.mem_orbit_self _
  | one => simp
  | mul v w _ _ hv hw =>
    rw [map_mul, Equiv.Perm.mul_apply, ← MulAction.orbit_eq_iff, MulAction.orbit_eq_iff.mpr (hv _),
      MulAction.orbit_eq_iff.mpr (hw _)]
  | inv w _ hw =>
    have h := hw (P.weylGroupToPerm w⁻¹ j)
    rw [← Equiv.Perm.mul_apply, ← map_mul, mul_inv_cancel, map_one, Equiv.Perm.one_apply] at h
    exact (MulAction.orbit_eq_iff.mp (MulAction.orbit_eq_iff.mpr h).symm)

/-- **The orbit of a root column is the image of the orbit of the root under the actual Weyl
group.** -/
theorem orbit_rootCoefficients_eq_image (j : ι) :
    MulAction.orbit b.coefficientWeylGroup (b.rootCoefficients j) =
      b.rootCoefficients '' range fun w : P.weylGroup ↦ P.weylGroupToPerm w j := by
  refine subset_antisymm (Matrix.orbit_columnReflectionGroup_subset ?_ ⟨j, ⟨1, by simp⟩, rfl⟩) ?_
  · rintro i _ ⟨_, ⟨w, rfl⟩, rfl⟩
    refine ⟨_, ⟨weylGroup.ofIdx P i * w, rfl⟩, ?_⟩
    beta_reduce
    rw [weylGroupToPerm_ofIdx_mul_apply, coefficientReflection_rootCoefficients]
  · rintro _ ⟨_, ⟨w, rfl⟩, rfl⟩
    exact b.rootCoefficients_weylGroupToPerm_mem_orbit w j

/-- **The union of the orbits of the simple columns is the set of all root columns**, including
the columns of negative roots. -/
theorem iUnion_orbit_single_eq_range_rootCoefficients :
    ⋃ k : b.support, MulAction.orbit b.coefficientWeylGroup (Pi.single k 1 : b.support → ℤ) =
      range b.rootCoefficients := by
  refine subset_antisymm (iUnion_subset fun k ↦ ?_) ?_
  · refine Matrix.orbit_columnReflectionGroup_subset ?_ ⟨k, b.rootCoefficients_coe k⟩
    rintro i _ ⟨j, rfl⟩
    exact ⟨_, (b.coefficientReflection_rootCoefficients i j).symm⟩
  · rintro _ ⟨i, rfl⟩
    refine b.induction_reflect i (p := fun i ↦ b.rootCoefficients i ∈
      ⋃ k : b.support, MulAction.orbit b.coefficientWeylGroup (Pi.single k 1 : b.support → ℤ))
      ?_ ?_ ?_
    · intro i hi
      obtain ⟨k, hk⟩ := mem_iUnion.mp hi
      rw [rootCoefficients_reflectionPerm_self]
      exact mem_iUnion.mpr ⟨k, Matrix.neg_mem_orbit_single _ _ hk⟩
    · intro i hi
      refine mem_iUnion.mpr ⟨⟨i, hi⟩, ?_⟩
      rw [b.rootCoefficients_coe ⟨i, hi⟩]
      exact MulAction.mem_orbit_self _
    · intro i j hi hj
      obtain ⟨k, hk⟩ := mem_iUnion.mp hi
      refine mem_iUnion.mpr ⟨k, ?_⟩
      have :=
        (b.cartanMatrix.columnReflection_mem_orbit_iff b.cartanMatrix_apply_same ⟨j, hj⟩).mpr hk
      rwa [coefficientReflection_rootCoefficients] at this

/-- **The nonnegative part of the union of the orbits of the simple columns is the set of columns
of positive roots.** -/
theorem iUnion_orbit_single_inter_Ici_eq_image_isPos :
    (⋃ k : b.support, MulAction.orbit b.coefficientWeylGroup (Pi.single k 1 : b.support → ℤ)) ∩
        Ici 0 =
      b.rootCoefficients '' {i | b.IsPos i} := by
  rw [iUnion_orbit_single_eq_range_rootCoefficients, ← image_preimage_eq_range_inter]
  congr 1
  ext i
  exact b.zero_le_rootCoefficients_iff

end Orbit

end Reflection

end RootPairing.Base

end
