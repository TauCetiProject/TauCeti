/-!
# Block reflections and universal orbit orthogonality

For a pairwise orthogonal finite set `s` of roots in a root pairing `P`, the product
`RootPairing.orthogonalProd P s hs` of the reflections in `s` is an involution in `P.weylGroup`
acting on weights as `x ↦ x - ∑ a ∈ s, ⟨x, αₐ^∨⟩ αₐ`. When `s = P.orbitIndices σ i` is a pairwise
orthogonal root orbit of an automorphism `σ : P.Aut`, this defines the **block reflection**
`RootPairing.blockReflection P σ i horth`, which commutes with `σ` inside `P.Aut` and acts on the
fixed submodule `LinearMap.fixedSubmodule σ.weightMap` as `x ↦ x - ⟨x, αᵢ^∨⟩ β_O`, where `β_O` is
the orbit sum of `O`.

In a simply laced finite reduced crystallographic root system over a linearly ordered field, if the
simple-root orbits of a based automorphism `σ` are pairwise orthogonal, Stembridge's height descent
under the simple block reflections moves every root into the simple roots
(`RootPairing.exists_mem_closure_blockReflection_mem_support`). Consequently every root orbit is
pairwise orthogonal (`RootPairing.pairwise_isOrthogonal_orbitIndices`), and the canonical norm-2
invariant form assigns every orbit sum squared length `2 |O|`
(`RootPairing.Base.simplyLacedInvariantForm_orbitSum_self`).

## Main definitions

* `RootPairing.orthogonalProd`: the product of the reflections in a pairwise orthogonal finite set
  of roots.
* `RootPairing.blockReflection`: the product of the reflections in a pairwise orthogonal root orbit
  of an automorphism `σ`.

## Main results

* `RootPairing.orthogonalProd_smul`, `RootPairing.orthogonalProd_mul_self`,
  `RootPairing.isPos_weylGroupToPerm_orthogonalProd_iff`,
  `RootPairing.height_weylGroupToPerm_orthogonalProd`: weight action, involution, positivity
  preservation, and height change for an orthogonal reflection product.
* `RootPairing.blockReflection_smul_of_mem_fixedSubmodule` and
  `RootPairing.commute_blockReflection_coe`: a block reflection commutes with `σ` and acts as a
  reflection along the orbit sum on the fixed submodule.
* `RootPairing.exists_mem_closure_blockReflection_mem_support`: every root can be carried into the
  simple roots by the subgroup generated by the simple block reflections.
* `RootPairing.pairwise_isOrthogonal_orbitIndices`: every root orbit is pairwise orthogonal.
* `RootPairing.InvariantForm.apply_orbitSum_self` and
  `RootPairing.Base.simplyLacedInvariantForm_orbitSum_self`: squared length of an orbit sum.

## References

* J. R. Stembridge, *Folding by automorphisms*, note of 20 August 2008, Claims 1–4.
-/

public section

namespace RootPairing

open Finset TauCeti

/-! ### Products of orthogonal reflections -/

section OrthogonalProd

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : RootPairing ι R M N)

/-- The product in `P.weylGroup` of the reflections in a pairwise orthogonal finite set of roots. -/
noncomputable def orthogonalProd (s : Finset ι) (hs : (s : Set ι).Pairwise P.IsOrthogonal) :
    P.weylGroup :=
  s.noncommProd (weylGroup.ofIdx P) fun _ ha _ hb hab ↦
    weylGroup.commute_ofIdx_of_isOrthogonal P (hs ha hb hab)

@[simp]
theorem orthogonalProd_empty (hs : ((∅ : Finset ι) : Set ι).Pairwise P.IsOrthogonal) :
    P.orthogonalProd ∅ hs = 1 :=
  Finset.noncommProd_empty (weylGroup.ofIdx P) _

@[simp]
theorem orthogonalProd_singleton (i : ι)
    (hs : (({i} : Finset ι) : Set ι).Pairwise P.IsOrthogonal) :
    P.orthogonalProd {i} hs = weylGroup.ofIdx P i :=
  Finset.noncommProd_singleton i (weylGroup.ofIdx P)

theorem orthogonalProd_insert [DecidableEq ι] {a : ι} {s : Finset ι} (ha : a ∉ s)
    (hs : ((insert a s : Finset ι) : Set ι).Pairwise P.IsOrthogonal) :
    P.orthogonalProd (insert a s) hs =
      weylGroup.ofIdx P a *
        P.orthogonalProd s (hs.mono fun _ hx ↦ Finset.mem_insert_of_mem hx) :=
  Finset.noncommProd_insert_of_notMem s a (weylGroup.ofIdx P) _ ha

theorem orthogonalProd_insert' [DecidableEq ι] {a : ι} {s : Finset ι} (ha : a ∉ s)
    (hs : ((insert a s : Finset ι) : Set ι).Pairwise P.IsOrthogonal) :
    P.orthogonalProd (insert a s) hs =
      P.orthogonalProd s (hs.mono fun _ hx ↦ Finset.mem_insert_of_mem hx) *
        weylGroup.ofIdx P a :=
  Finset.noncommProd_insert_of_notMem' s a (weylGroup.ofIdx P) _ ha

/-- The product of reflections in a pairwise orthogonal finite set of roots acts by subtracting
the sum of the individual root projections. -/
theorem orthogonalProd_smul (s : Finset ι) (hs : (s : Set ι).Pairwise P.IsOrthogonal) (x : M) :
    P.orthogonalProd s hs • x = x - ∑ a ∈ s, P.coroot' a x • P.root a := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert a s ha ih =>
    have hs' : (s : Set ι).Pairwise P.IsOrthogonal :=
      hs.mono fun _ hx ↦ Finset.mem_insert_of_mem hx
    rw [orthogonalProd_insert P ha hs, mul_smul, ih hs', weylGroup.ofIdx_smul,
      Equiv.reflection_smul, map_sub, map_sum, P.reflection_apply]
    have hfix : ∀ j ∈ s, P.reflection a (P.coroot' j x • P.root j) = P.coroot' j x • P.root j := by
      intro j hj
      have horth : P.IsOrthogonal a j :=
        hs (Finset.mem_insert_self a s) (Finset.mem_insert_of_mem hj) (fun h ↦ ha (h ▸ hj))
      rw [map_smul, P.reflection_apply_root, horth.2, zero_smul, sub_zero]
    rw [Finset.sum_congr rfl hfix, Finset.sum_insert ha, sub_sub]

/-- Every product of pairwise orthogonal root reflections is an involution. -/
@[simp]
theorem orthogonalProd_mul_self (s : Finset ι) (hs : (s : Set ι).Pairwise P.IsOrthogonal) :
    P.orthogonalProd s hs * P.orthogonalProd s hs = 1 := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert a s ha ih =>
    have hs' : (s : Set ι).Pairwise P.IsOrthogonal :=
      hs.mono fun _ hx ↦ Finset.mem_insert_of_mem hx
    have hcomm : Commute (weylGroup.ofIdx P a) (P.orthogonalProd s hs') :=
      Finset.noncommProd_commute s (weylGroup.ofIdx P) _ (weylGroup.ofIdx P a) fun j hj ↦
        weylGroup.commute_ofIdx_of_isOrthogonal P
          (hs (Finset.mem_insert_self a s) (Finset.mem_insert_of_mem hj) (fun h ↦ ha (h ▸ hj)))
    rw [orthogonalProd_insert P ha hs, mul_assoc, ← mul_assoc (P.orthogonalProd s hs'),
      ← hcomm.eq, mul_assoc, ih hs', mul_one, weylGroup.ofIdx_mul_self]

/-- Every product of pairwise orthogonal root reflections is its own inverse. -/
@[simp]
theorem orthogonalProd_inv (s : Finset ι) (hs : (s : Set ι).Pairwise P.IsOrthogonal) :
    (P.orthogonalProd s hs)⁻¹ = P.orthogonalProd s hs :=
  inv_eq_of_mul_eq_one_right (P.orthogonalProd_mul_self s hs)

/-- A product of orthogonal reflections fixes any root orthogonal to every root in the set. -/
theorem orthogonalProd_smul_root_of_isOrthogonal {s : Finset ι}
    (hs : (s : Set ι).Pairwise P.IsOrthogonal) {k : ι} (hk : ∀ a ∈ s, P.IsOrthogonal a k) :
    P.orthogonalProd s hs • P.root k = P.root k := by
  rw [orthogonalProd_smul]
  have hzero : ∑ a ∈ s, P.coroot' a (P.root k) • P.root a = 0 :=
    Finset.sum_eq_zero fun a ha ↦ by rw [root_coroot'_eq_pairing, (hk a ha).2, zero_smul]
  rw [hzero, sub_zero]

/-- On root indices, a product of orthogonal reflections fixes any index orthogonal to every root
in the set. -/
theorem weylGroupToPerm_orthogonalProd_of_isOrthogonal {s : Finset ι}
    (hs : (s : Set ι).Pairwise P.IsOrthogonal) {k : ι} (hk : ∀ a ∈ s, P.IsOrthogonal a k) :
    P.weylGroupToPerm (P.orthogonalProd s hs) k = k :=
  P.root.injective (by
    rw [← P.weylGroup_apply_root, P.orthogonalProd_smul_root_of_isOrthogonal hs hk])

/-- Reflecting a member of a pairwise orthogonal set by the full product negates that root. -/
theorem orthogonalProd_smul_root_of_mem {s : Finset ι}
    (hs : (s : Set ι).Pairwise P.IsOrthogonal) {k : ι} (hk : k ∈ s) :
    P.orthogonalProd s hs • P.root k = -P.root k := by
  classical
  rw [orthogonalProd_smul, Finset.sum_eq_single_of_mem k hk]
  · rw [root_coroot'_eq_pairing, pairing_same, two_smul]
    abel
  · intro a ha hak
    rw [root_coroot'_eq_pairing, (hs ha hk hak).2, zero_smul]

/-- Reflecting a member of a pairwise orthogonal set by the full product negates its index. -/
theorem weylGroupToPerm_orthogonalProd_of_mem {s : Finset ι}
    (hs : (s : Set ι).Pairwise P.IsOrthogonal) {k : ι} (hk : k ∈ s) :
    P.weylGroupToPerm (P.orthogonalProd s hs) k = P.reflectionPerm k k :=
  P.root.injective (by
    rw [← P.weylGroup_apply_root, P.orthogonalProd_smul_root_of_mem hs hk, root_reflectionPerm,
      reflection_apply_self])

/-- The product of reflections in a pairwise orthogonal set of simple roots preserves and reflects
positivity of every root outside the set and its negatives. -/
theorem isPos_weylGroupToPerm_orthogonalProd_iff [Finite ι] [CharZero R] [IsDomain R]
    [P.IsCrystallographic] [P.IsReduced] (b : P.Base) {s : Finset ι}
    (hs : (s : Set ι).Pairwise P.IsOrthogonal) (hsub : ∀ a ∈ s, a ∈ b.support) {k : ι}
    (hk : k ∉ s) (hkneg : ∀ a ∈ s, k ≠ P.reflectionPerm a a) :
    b.IsPos (P.weylGroupToPerm (P.orthogonalProd s hs) k) ↔ b.IsPos k := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert a s ha ih =>
    have hs' : (s : Set ι).Pairwise P.IsOrthogonal :=
      hs.mono fun _ hx ↦ Finset.mem_insert_of_mem hx
    have hsub' : ∀ j ∈ s, j ∈ b.support := fun j hj ↦ hsub j (Finset.mem_insert_of_mem hj)
    have hks : k ∉ s := fun h ↦ hk (Finset.mem_insert_of_mem h)
    have hka : k ≠ a := fun h ↦ hk (h ▸ Finset.mem_insert_self a s)
    have hkneg' : ∀ j ∈ s, k ≠ P.reflectionPerm j j :=
      fun j hj ↦ hkneg j (Finset.mem_insert_of_mem hj)
    have horth_a : ∀ j ∈ s, P.IsOrthogonal j a := fun j hj ↦
      hs (Finset.mem_insert_of_mem hj) (Finset.mem_insert_self a s) (fun h ↦ ha (h ▸ hj))
    have hfix_a : P.weylGroupToPerm (P.orthogonalProd s hs') a = a :=
      P.weylGroupToPerm_orthogonalProd_of_isOrthogonal hs' horth_a
    have hne₁ : P.weylGroupToPerm (P.orthogonalProd s hs') k ≠ a := fun heq ↦
      hka ((P.weylGroupToPerm (P.orthogonalProd s hs')).injective (heq.trans hfix_a.symm))
    have hfix_neg : P.weylGroupToPerm (P.orthogonalProd s hs') (P.reflectionPerm a a) =
        P.reflectionPerm a a := by
      let := P.indexNeg
      have h1 := P.weylGroupToPerm_neg (P.orthogonalProd s hs') a
      rw [indexNeg_neg, indexNeg_neg, hfix_a] at h1
      exact h1
    have hne₂ : P.weylGroupToPerm (P.orthogonalProd s hs') k ≠ P.reflectionPerm a a := fun heq ↦
      hkneg a (Finset.mem_insert_self a s)
        ((P.weylGroupToPerm (P.orthogonalProd s hs')).injective (heq.trans hfix_neg.symm))
    rw [orthogonalProd_insert P ha hs, weylGroupToPerm_ofIdx_mul_apply,
      Base.isPos_reflectionPerm_iff P b (hsub a (Finset.mem_insert_self a s)) hne₁ hne₂,
      ih hs' hsub' hks hkneg']

/-- The product of reflections in a pairwise orthogonal set of simple roots keeps every positive
root outside the set positive. -/
theorem isPos_weylGroupToPerm_orthogonalProd_of_isPos [Finite ι] [CharZero R] [IsDomain R]
    [P.IsCrystallographic] [P.IsReduced] (b : P.Base) {s : Finset ι}
    (hs : (s : Set ι).Pairwise P.IsOrthogonal) (hsub : ∀ a ∈ s, a ∈ b.support) {k : ι}
    (hkpos : b.IsPos k) (hk : k ∉ s) :
    b.IsPos (P.weylGroupToPerm (P.orthogonalProd s hs) k) := by
  refine (P.isPos_weylGroupToPerm_orthogonalProd_iff b hs hsub hk fun a ha hka ↦ ?_).mpr hkpos
  have hneg : ¬ b.IsPos (P.reflectionPerm a a) :=
    (isPos_reflectionPerm_self_iff_mem_negRoots P b a).not.mpr
      ((mem_negRoots P b a).not.mpr (not_not.mpr (b.isPos_of_mem_support (hsub a ha))))
  exact hneg (hka ▸ hkpos)

/-- The product of reflections in a pairwise orthogonal set of simple roots shifts root height by
the negative sum of the corresponding Cartan integers. -/
theorem height_weylGroupToPerm_orthogonalProd [CharZero R] [P.IsCrystallographic] (b : P.Base)
    {s : Finset ι} (hs : (s : Set ι).Pairwise P.IsOrthogonal) (hsub : ∀ a ∈ s, a ∈ b.support)
    (k : ι) :
    b.height (P.weylGroupToPerm (P.orthogonalProd s hs) k) =
      b.height k - ∑ a ∈ s, P.pairingIn ℤ k a := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert a s ha ih =>
    have hs' : (s : Set ι).Pairwise P.IsOrthogonal :=
      hs.mono fun _ hx ↦ Finset.mem_insert_of_mem hx
    have hsub' : ∀ j ∈ s, j ∈ b.support := fun j hj ↦ hsub j (Finset.mem_insert_of_mem hj)
    have horth_a : ∀ j ∈ s, P.IsOrthogonal j a := fun j hj ↦
      hs (Finset.mem_insert_of_mem hj) (Finset.mem_insert_self a s) (fun h ↦ ha (h ▸ hj))
    have hfix_a : P.weylGroupToPerm (P.orthogonalProd s hs') a = a :=
      P.weylGroupToPerm_orthogonalProd_of_isOrthogonal hs' horth_a
    have hpair : P.pairingIn ℤ (P.weylGroupToPerm (P.orthogonalProd s hs') k) a =
        P.pairingIn ℤ k a := by
      apply FaithfulSMul.algebraMap_injective ℤ R
      rw [algebraMap_pairingIn, algebraMap_pairingIn, ← root_coroot'_eq_pairing,
        ← root_coroot'_eq_pairing, ← P.weylGroup_apply_root]
      conv_lhs => rw [← hfix_a]
      exact coroot'_weylGroupToPerm_smul P (P.orthogonalProd s hs') a (P.root k)
    rw [orthogonalProd_insert P ha hs, weylGroupToPerm_ofIdx_mul_apply,
      b.height_reflectionPerm_of_mem_support (hsub a (Finset.mem_insert_self a s)),
      hpair, ih hs' hsub', Finset.sum_insert ha]
    omega

/-! ### Block reflections of an automorphism -/

section BlockReflection

variable [Finite ι] (σ : P.Aut)

/-- The **block reflection** associated to a pairwise orthogonal `σ`-orbit of roots: the product of
the commuting reflections in `P.orbitIndices σ i`. -/
noncomputable def blockReflection (i : ι)
    (horth : (P.orbitIndices σ i : Set ι).Pairwise P.IsOrthogonal) : P.weylGroup :=
  P.orthogonalProd (P.orbitIndices σ i) horth

theorem blockReflection_def (i : ι)
    (horth : (P.orbitIndices σ i : Set ι).Pairwise P.IsOrthogonal) :
    P.blockReflection σ i horth = P.orthogonalProd (P.orbitIndices σ i) horth := by
  rw [blockReflection]

theorem blockReflection_smul (i : ι)
    (horth : (P.orbitIndices σ i : Set ι).Pairwise P.IsOrthogonal) (x : M) :
    P.blockReflection σ i horth • x =
      x - ∑ a ∈ P.orbitIndices σ i, P.coroot' a x • P.root a :=
  P.orthogonalProd_smul (P.orbitIndices σ i) horth x

@[simp]
theorem blockReflection_mul_self (i : ι)
    (horth : (P.orbitIndices σ i : Set ι).Pairwise P.IsOrthogonal) :
    P.blockReflection σ i horth * P.blockReflection σ i horth = 1 :=
  P.orthogonalProd_mul_self (P.orbitIndices σ i) horth

@[simp]
theorem blockReflection_inv (i : ι)
    (horth : (P.orbitIndices σ i : Set ι).Pairwise P.IsOrthogonal) :
    (P.blockReflection σ i horth)⁻¹ = P.blockReflection σ i horth :=
  P.orthogonalProd_inv (P.orbitIndices σ i) horth

/-- A block reflection depends only on the `σ`-orbit, not on the chosen representative. -/
theorem blockReflection_eq_of_mem {i j : ι} (h : j ∈ P.orbitIndices σ i)
    (horth : (P.orbitIndices σ i : Set ι).Pairwise P.IsOrthogonal)
    (horth' : (P.orbitIndices σ j : Set ι).Pairwise P.IsOrthogonal) :
    P.blockReflection σ j horth' = P.blockReflection σ i horth :=
  weylGroup.ext fun x ↦ by
    rw [blockReflection_smul, blockReflection_smul, orbitIndices_eq_of_mem h]

/-- For a root fixed by `σ`, its block reflection is the ordinary reflection in that root. -/
theorem blockReflection_eq_ofIdx_of_indexEquiv_eq {i : ι} (h : σ.indexEquiv i = i)
    (horth : (P.orbitIndices σ i : Set ι).Pairwise P.IsOrthogonal) :
    P.blockReflection σ i horth = weylGroup.ofIdx P i :=
  weylGroup.ext fun x ↦ by
    rw [blockReflection_smul, orbitIndices_eq_singleton_iff.mpr h, Finset.sum_singleton,
      weylGroup.ofIdx_smul, Equiv.reflection_smul, P.reflection_apply]

/-- On any `σ`-fixed weight, all coroot functionals along a `σ`-orbit take the same value. -/
theorem coroot'_eq_of_mem_orbitIndices_of_mem_fixedSubmodule {i j : ι}
    (h : j ∈ P.orbitIndices σ i) {x : M} (hx : x ∈ LinearMap.fixedSubmodule σ.weightMap) :
    P.coroot' j x = P.coroot' i x := by
  have hstep (a : ι) : P.coroot' (σ.indexEquiv a) x = P.coroot' a x := by
    conv_lhs => rw [← LinearMap.mem_fixedSubmodule_iff.mp hx]
    exact σ.toHom.coroot'_weightMap a x
  exact (Equiv.Perm.SameCycle.apply_eq_of_apply_eq (f := fun a ↦ P.coroot' a x)
    (mem_orbitIndices.mp h) hstep).symm

/-- On the fixed submodule of `σ`, a block reflection acts by the reflection formula along the
corresponding orbit sum. -/
theorem blockReflection_smul_of_mem_fixedSubmodule (i : ι)
    (horth : (P.orbitIndices σ i : Set ι).Pairwise P.IsOrthogonal)
    {x : M} (hx : x ∈ LinearMap.fixedSubmodule σ.weightMap) :
    P.blockReflection σ i horth • x = x - P.coroot' i x • P.orbitSum σ i := by
  rw [blockReflection_smul, orbitSum_def, Finset.smul_sum]
  congr 1
  exact Finset.sum_congr rfl fun a ha ↦ by
    rw [P.coroot'_eq_of_mem_orbitIndices_of_mem_fixedSubmodule σ ha hx]

/-- Every block reflection commutes with `σ` inside `P.Aut`. -/
theorem commute_blockReflection_coe (i : ι)
    (horth : (P.orbitIndices σ i : Set ι).Pairwise P.IsOrthogonal) :
    Commute (P.blockReflection σ i horth : P.Aut) σ := by
  apply Equiv.weightHom_injective P
  ext x
  -- Both sides evaluate `blockReflection` and `σ.weightMap` on `x` in the two orders.
  change P.blockReflection σ i horth • σ.weightMap x =
    σ.weightMap (P.blockReflection σ i horth • x)
  rw [blockReflection_smul, blockReflection_smul, map_sub, map_sum]
  congr 1
  symm
  refine Finset.sum_equiv σ.indexEquiv (fun a ↦ indexEquiv_mem_orbitIndices_iff.symm)
    fun a _ ↦ ?_
  rw [map_smul, Hom.root_weightMap_apply, σ.toHom.coroot'_weightMap a x]

/-- For an automorphism preserving the simple roots of `b`, every member of a simple orbit is
again simple. -/
theorem mem_support_of_mem_orbitIndices {b : P.Base}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) {i j : ι}
    (hi : i ∈ b.support) (hj : j ∈ P.orbitIndices σ i) : j ∈ b.support := by
  obtain ⟨k, hk⟩ := mem_orbitIndices_iff_exists_pow.mp hj
  clear hj
  subst hk
  induction k with
  | zero => simpa using hi
  | succ n ih =>
    rw [pow_succ', Equiv.Perm.mul_apply]
    exact hσ _ ih

/-- If distinct simple roots in the same `σ`-orbit have vanishing pairing, every simple `σ`-orbit
is pairwise orthogonal. -/
theorem pairwise_isOrthogonal_orbitIndices_of_mem_support {b : P.Base}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    {i : ι} (hi : i ∈ b.support) :
    (P.orbitIndices σ i : Set ι).Pairwise P.IsOrthogonal := fun a ha c hc hac ↦
  ⟨horth a (P.mem_support_of_mem_orbitIndices σ hσ hi ha) c (by rwa [orbitIndices_eq_of_mem ha])
      hac,
    horth c (P.mem_support_of_mem_orbitIndices σ hσ hi hc) a (by rwa [orbitIndices_eq_of_mem hc])
      hac.symm⟩

/-- Every element of the subgroup generated by the simple block reflections commutes with `σ`. -/
theorem commute_of_mem_closure_blockReflection {b : P.Base}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    {w : P.weylGroup}
    (hw : w ∈ Subgroup.closure {w | ∃ (i : ι) (hi : i ∈ b.support),
      w = P.blockReflection σ i
        (P.pairwise_isOrthogonal_orbitIndices_of_mem_support σ hσ horth hi)}) :
    Commute (w : P.Aut) σ := by
  induction hw using Subgroup.closure_induction with
  | mem _ hx => obtain ⟨i, _, rfl⟩ := hx; exact P.commute_blockReflection_coe σ i _
  | one => exact Commute.one_left σ
  | mul _ _ _ _ hx hy => exact hx.mul_left hy
  | inv _ _ hx => exact hx.inv_left

end BlockReflection

end OrthogonalProd

/-! ### Orbit sums and invariant forms -/

section InvariantFormNorm

variable {ι R M N : Type*} [CommRing R] [IsDomain R] [CharZero R] [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N] {P : RootPairing ι R M N} [Finite ι]

/-- For any `σ`-invariant form `B`, the squared length of the orbit sum of a pairwise orthogonal
root orbit equals the orbit size times the squared length of any root in the orbit. -/
theorem InvariantForm.apply_orbitSum_self (B : P.InvariantForm) {σ : P.Aut}
    (hB : InvariantForm.comap σ.toHom B = B) {k : ι}
    (horth : (P.orbitIndices σ k : Set ι).Pairwise P.IsOrthogonal) :
    B.form (P.orbitSum σ k) (P.orbitSum σ k) =
      #(P.orbitIndices σ k) • B.form (P.root k) (P.root k) := by
  have hlen : ∀ a ∈ P.orbitIndices σ k,
      B.form (P.root a) (P.root a) = B.form (P.root k) (P.root k) := fun a ha ↦
    (Equiv.Perm.SameCycle.apply_eq_of_apply_eq
      (f := fun j ↦ B.form (P.root j) (P.root j)) (mem_orbitIndices.mp ha) fun j ↦ by
        rw [← Hom.root_weightMap_apply, ← InvariantForm.comap_form_apply, hB]).symm
  have hcross : ∀ a ∈ P.orbitIndices σ k, ∀ c ∈ P.orbitIndices σ k, a ≠ c →
      B.form (P.root a) (P.root c) = 0 := fun a ha c hc hac ↦ by
    have h2 := B.two_mul_apply_root_root a c
    rw [(horth ha hc hac).1, zero_mul] at h2
    exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
  rw [orbitSum_def, map_sum, ← Finset.sum_const]
  refine Finset.sum_congr rfl fun c hc ↦ ?_
  rw [map_sum, LinearMap.sum_apply,
    Finset.sum_eq_single_of_mem c hc (fun a ha hac ↦ hcross a ha c hc hac), hlen c hc]

end InvariantFormNorm

/-! ### Height descent and universal orbit orthogonality -/

section HeightDescent

variable {ι K M N : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]
  {P : RootPairing ι K M N} [Finite ι] [P.IsRootSystem] [P.IsReduced] [P.IsCrystallographic]
  {b : P.Base} {σ : P.Aut}

omit [LinearOrder K] [IsStrictOrderedRing K] [P.IsRootSystem] [P.IsReduced] [P.IsCrystallographic]
  in
private theorem sum_pairing_orbitIndices_eq_of_mem {k j i : ι}
    (h : j ∈ P.orbitIndices σ k) :
    ∑ a ∈ P.orbitIndices σ i, P.pairing j a = ∑ a ∈ P.orbitIndices σ i, P.pairing k a :=
  (Equiv.Perm.SameCycle.apply_eq_of_apply_eq
    (f := fun x ↦ ∑ a ∈ P.orbitIndices σ i, P.pairing x a) (mem_orbitIndices.mp h) fun x ↦
      (Finset.sum_equiv σ.indexEquiv (fun _ ↦ indexEquiv_mem_orbitIndices_iff.symm)
        fun a _ ↦ (σ.toHom.pairing (i := x) (j := a)).symm).symm).symm

private theorem card_orbitIndices_mul_sum_pairing (hsl : b.cartanMatrix.IsSimplyLaced) (k i : ι) :
    (#(P.orbitIndices σ k) : K) * ∑ a ∈ P.orbitIndices σ i, P.pairing k a =
      (#(P.orbitIndices σ i) : K) *
        (b.simplyLacedInvariantForm hsl).form (P.orbitSum σ k) (P.root i) := by
  set B := b.simplyLacedInvariantForm hsl
  have h1 : B.form (P.orbitSum σ k) (P.orbitSum σ i) =
      (#(P.orbitIndices σ k) : K) * ∑ a ∈ P.orbitIndices σ i, P.pairing k a := by
    rw [orbitSum_def P σ k, map_sum, LinearMap.sum_apply, ← nsmul_eq_mul, ← Finset.sum_const]
    refine Finset.sum_congr rfl fun j hj ↦ ?_
    rw [orbitSum_def, map_sum, ← sum_pairing_orbitIndices_eq_of_mem hj]
    exact Finset.sum_congr rfl fun a _ ↦ b.simplyLacedInvariantForm_root_root hsl j a
  have h2 : B.form (P.orbitSum σ k) (P.orbitSum σ i) =
      (#(P.orbitIndices σ i) : K) * B.form (P.orbitSum σ k) (P.root i) := by
    rw [orbitSum_def P σ i, map_sum, ← nsmul_eq_mul, ← Finset.sum_const]
    refine Finset.sum_congr rfl fun a ha ↦ ?_
    rw [b.simplyLacedInvariantForm_apply_root hsl, b.simplyLacedInvariantForm_apply_root hsl]
    exact P.coroot'_eq_of_mem_orbitIndices_of_mem_fixedSubmodule σ ha
      (P.orbitSum_mem_fixedSubmodule σ k)
  rw [← h1, h2]

private theorem exists_simple_sum_pairingIn_pos
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (hsl : b.cartanMatrix.IsSimplyLaced) {k : ι} (hk : b.IsPos k) :
    ∃ i ∈ b.support, 0 < ∑ a ∈ P.orbitIndices σ i, P.pairingIn ℤ k a := by
  set B := b.simplyLacedInvariantForm hsl
  obtain ⟨f, hf⟩ := (mem_posRootCone P b).mp (orbitSum_mem_posRootCone hσ hk)
  have hsum_pos : ∑ _i ∈ b.support, (0 : K) <
      ∑ i ∈ b.support, (f i : K) * B.form (P.orbitSum σ k) (P.root i) := by
    rw [Finset.sum_const_zero]
    have hpos : 0 < B.form (P.orbitSum σ k) (∑ i ∈ b.support, f i • P.root i) :=
      hf ▸ b.posDef_simplyLacedInvariantForm hsl (P.orbitSum σ k) (orbitSum_ne_zero hσ k)
    rw [map_sum] at hpos
    simpa only [map_nsmul, nsmul_eq_mul] using hpos
  obtain ⟨i, hi, hterm⟩ := Finset.exists_lt_of_sum_lt hsum_pos
  have hB_pos : 0 < B.form (P.orbitSum σ k) (P.root i) := by
    by_contra! hle
    linarith [mul_nonpos_of_nonneg_of_nonpos (Nat.cast_nonneg (f i)) hle]
  have hsumK : 0 < ∑ a ∈ P.orbitIndices σ i, P.pairing k a :=
    pos_of_mul_pos_right (by
      rw [card_orbitIndices_mul_sum_pairing hsl k i]
      exact mul_pos (Nat.cast_pos.mpr (P.card_orbitIndices_pos σ i)) hB_pos)
      (Nat.cast_pos.mpr (P.card_orbitIndices_pos σ k)).le
  refine ⟨i, hi, ?_⟩
  have hcast : ((∑ a ∈ P.orbitIndices σ i, P.pairingIn ℤ k a : ℤ) : K) =
      ∑ a ∈ P.orbitIndices σ i, P.pairing k a := by simp [← P.algebraMap_pairingIn ℤ]
  exact_mod_cast (hcast.symm ▸ hsumK)

/-- **Stembridge height descent**: in a simply laced root system with an orthogonal based
automorphism `σ`, the subgroup generated by the simple block reflections acts transitively from
every root into the simple roots. -/
theorem exists_mem_closure_blockReflection_mem_support
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (hsl : b.cartanMatrix.IsSimplyLaced)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (k : ι) :
    ∃ w ∈ Subgroup.closure {w | ∃ (i : ι) (hi : i ∈ b.support),
      w = P.blockReflection σ i
        (P.pairwise_isOrthogonal_orbitIndices_of_mem_support σ hσ horth hi)},
      P.weylGroupToPerm w k ∈ b.support := by
  set H : Subgroup P.weylGroup := Subgroup.closure {w | ∃ (i : ι) (hi : i ∈ b.support),
    w = P.blockReflection σ i
      (P.pairwise_isOrthogonal_orbitIndices_of_mem_support σ hσ horth hi)}
  have hpos_case : ∀ n : ℕ, ∀ k : ι, b.IsPos k → b.height k ≤ n →
      ∃ w ∈ H, P.weylGroupToPerm w k ∈ b.support := by
    intro n
    induction n with
    | zero => intro k hk hle; have := b.isPos_iff.mp hk; omega
    | succ n ih =>
      intro k hk hle
      obtain ⟨i, hi, hsum⟩ := exists_simple_sum_pairingIn_pos hσ hsl hk
      by_cases hki : k ∈ P.orbitIndices σ i
      · exact ⟨1, one_mem _, by simpa using P.mem_support_of_mem_orbitIndices σ hσ hi hki⟩
      · set sO := P.blockReflection σ i
          (P.pairwise_isOrthogonal_orbitIndices_of_mem_support σ hσ horth hi)
        have hsub : ∀ a ∈ P.orbitIndices σ i, a ∈ b.support :=
          fun a ha ↦ P.mem_support_of_mem_orbitIndices σ hσ hi ha
        have hk'ht : b.height (P.weylGroupToPerm sO k) =
            b.height k - ∑ a ∈ P.orbitIndices σ i, P.pairingIn ℤ k a :=
          P.height_weylGroupToPerm_orthogonalProd b _ hsub k
        obtain ⟨w, hw, hwk⟩ := ih (P.weylGroupToPerm sO k)
          (P.isPos_weylGroupToPerm_orthogonalProd_of_isPos b _ hsub hk hki) (by omega)
        exact ⟨w * sO, mul_mem hw (Subgroup.subset_closure ⟨i, hi, rfl⟩),
          by rwa [map_mul, Equiv.Perm.mul_apply]⟩
  by_cases hk : b.IsPos k
  · exact hpos_case (b.height k).toNat k hk (by omega)
  · have hneg : b.IsPos (P.reflectionPerm k k) :=
      (isPos_reflectionPerm_self_iff_mem_negRoots P b k).mpr ((mem_negRoots P b k).mpr hk)
    obtain ⟨w, hw, hwi⟩ := hpos_case (b.height (P.reflectionPerm k k)).toNat
      (P.reflectionPerm k k) hneg (by omega)
    set i := P.weylGroupToPerm w (P.reflectionPerm k k)
    set sO := P.blockReflection σ i
      (P.pairwise_isOrthogonal_orbitIndices_of_mem_support σ hσ horth hwi)
    refine ⟨sO * w, mul_mem (Subgroup.subset_closure ⟨i, hwi, rfl⟩) hw, ?_⟩
    have hwk : P.weylGroupToPerm w k = P.reflectionPerm i i := by
      let := P.indexNeg
      have h1 := P.weylGroupToPerm_neg w (P.reflectionPerm k k)
      rwa [indexNeg_neg, indexNeg_neg, reflectionPerm_reflectionPerm_self] at h1
    have hsOi : P.weylGroupToPerm sO (P.reflectionPerm i i) = i := by
      let := P.indexNeg
      have h1 := P.weylGroupToPerm_neg sO i
      have h2 := P.weylGroupToPerm_orthogonalProd_of_mem
        (P.pairwise_isOrthogonal_orbitIndices_of_mem_support σ hσ horth hwi)
        (P.self_mem_orbitIndices σ i)
      rw [indexNeg_neg, indexNeg_neg] at h1
      rw [h1, show P.weylGroupToPerm sO i = P.reflectionPerm i i from h2,
        reflectionPerm_reflectionPerm_self]
    rwa [map_mul, Equiv.Perm.mul_apply, hwk, hsOi]

/-- **Universal orbit orthogonality** (Stembridge Claim 4): if the simple orbits of a based
automorphism `σ` of a simply laced root system are pairwise orthogonal, then *every* root orbit of
`σ` is pairwise orthogonal. -/
theorem pairwise_isOrthogonal_orbitIndices
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (hsl : b.cartanMatrix.IsSimplyLaced)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (k : ι) :
    (P.orbitIndices σ k : Set ι).Pairwise P.IsOrthogonal := by
  obtain ⟨w, hw, hwi⟩ := exists_mem_closure_blockReflection_mem_support hσ hsl horth k
  have hcomm : Commute (w : P.Aut) σ := P.commute_of_mem_closure_blockReflection σ hσ horth hw
  have hmap := map_orbitIndices (w : P.Aut)
    (fun j ↦ congrArg (fun g : P.Aut ↦ g.indexEquiv j) hcomm) k
  have hmem (x : ι) (hx : x ∈ P.orbitIndices σ k) :
      (w : P.Aut).indexEquiv x ∈ P.orbitIndices σ (P.weylGroupToPerm w k) := by
    rw [weylGroupToPerm_apply, ← hmap]; exact Finset.mem_map_of_mem _ hx
  intro a ha c hc hac
  have hpair := P.pairwise_isOrthogonal_orbitIndices_of_mem_support σ hσ horth hwi
    (hmem a ha) (hmem c hc) fun h ↦ hac ((w : P.Aut).indexEquiv.injective h)
  exact ⟨by rw [← (w : P.Aut).toHom.pairing (i := a) (j := c)]; exact hpair.1,
    by rw [← (w : P.Aut).toHom.pairing (i := c) (j := a)]; exact hpair.2⟩

/-- In the orthogonal simply laced case, the canonical norm-2 invariant form assigns every orbit
sum squared length `2 |O|`. -/
theorem Base.simplyLacedInvariantForm_orbitSum_self
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (hsl : b.cartanMatrix.IsSimplyLaced)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (k : ι) :
    (b.simplyLacedInvariantForm hsl).form (P.orbitSum σ k) (P.orbitSum σ k) =
      2 * (#(P.orbitIndices σ k) : K) := by
  rw [(b.simplyLacedInvariantForm hsl).apply_orbitSum_self
      (b.comap_simplyLacedInvariantForm hsl σ)
      (pairwise_isOrthogonal_orbitIndices hσ hsl horth k),
    b.simplyLacedInvariantForm_root_self hsl k, nsmul_eq_mul, mul_comm]

end HeightDescent

end RootPairing
