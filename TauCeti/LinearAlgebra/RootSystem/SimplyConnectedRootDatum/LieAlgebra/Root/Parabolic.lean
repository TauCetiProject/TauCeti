module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Parabolic.NotG2

/-!
# The positive subgroup normalizes each punctured positive subgroup

Outside type G₂, the positive subgroup normalizes the subgroup generated by all positive
root groups except a chosen simple root. The opposite-simple-pair normalization and the
ordered factorization used here are proved in `Root.Parabolic.NotG2`.

The value ring is arbitrary; neither invertibility of structure constants nor generation
by positive simple root groups is assumed.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §8.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

noncomputable section

variable {t : DynkinType} {ht : t.Valid}
variable {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
  ∀ v ∈ M, ρ u v ∈ M)
variable (hnil : ∀ i, IsNilpotent
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

attribute [local instance high] Algebra.toModule

/-- Outside G₂, the positive subgroup normalizes the subgroup generated by all positive
roots except one simple root, over every commutative value ring. -/
theorem iSup_posRoots_le_normalizer_posRoots_diff_singleton
    [(t.rationalRootSystem ht).IsNotG2] (i : Fin t.rank) (A : CommAlgCat ℤ) :
    (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
      (chevalleyRootSubgroup ρ M hM hnil γ A).range) ≤
    Subgroup.normalizer
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) := by
  conv_lhs => rw [posRoots_eq_diff_union_simpleIndex i, iSup_union, iSup_singleton]
  refine sup_le Subgroup.le_normalizer ?_
  exact (Set.subset_union_left.trans Subgroup.subset_closure).trans
    (closure_simpleRootPair_le_normalizer_posRoots_diff_singleton ρ M hM hnil i A)

end

end TauCeti.DynkinType
