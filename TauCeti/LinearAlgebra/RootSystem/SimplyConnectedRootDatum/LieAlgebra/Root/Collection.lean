module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.G2

/-!
# Ordered positive-root products in every valid Dynkin type

On any Kostant-stable lattice with nilpotent root generators, every element generated by the
positive root subgroups is a product in any prescribed enumeration without repetitions.
The value ring is arbitrary, including bad characteristic and nonreduced rings.

This combines the height bound of `commutator_range_chevalleyRootSubgroup_le` outside G₂ with
`mem_biSup_posRoots_g2_iff_exists_list_prod_map` in G₂. Collection uses the graded-subgroup
API in `TauCeti.Algebra.Group.Subgroup.OrderedProduct`, without dividing by structure constants.
No weight basis, faithfulness, finite-dimensionality or coordinate uniqueness is assumed.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17.
* R. W. Carter, *Simple Groups of Lie Type*, §5.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

variable {t : DynkinType} {ht : t.Valid} {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
  (M : AddSubgroup V)
  (hM : ∀ u ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h, ∀ v ∈ M, ρ u v ∈ M)
  (hnil : ∀ i, IsNilpotent
    (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

attribute [local instance high] Algebra.toModule

/-- Every element generated by the positive root subgroups on a Kostant-stable lattice is a
product of one root element per positive root, in any enumeration without repetitions.
This holds in every valid Dynkin type over any commutative value ring. -/
theorem mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod (A : CommAlgCat ℤ)
    (l : List (Fin t.numRoots)) (hl : l.Nodup)
    (hlpos : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    g ∈ ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (chevalleyRootSubgroup ρ M hM hnil γ A).range ↔
      ∃ u : Fin t.numRoots → A,
        (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ A
          (Multiplicative.ofAdd (u γ))).prod = g := by
  classical
  by_cases hG2 : t = G2
  · subst t
    let l₆ : List (Fin 6) := l.attach.map fun ⟨γ, hγ⟩ =>
      ⟨γ.val, (mem_posRoots_rational_g2_iff ht γ).mp ((hlpos γ).mp hγ)⟩
    have hmap : l₆.map (Fin.castAdd 6) = l := by
      dsimp only [l₆]
      rw [List.map_map]
      exact (List.map_congr_left fun _ _ => rfl).trans l.attach_map_subtype_val
    have hl₆ := List.Nodup.of_map _ (hmap.symm ▸ hl)
    have hall (i : Fin 6) : i ∈ l₆ := by
      have hi : Fin.castAdd 6 i ∈ l :=
        (hlpos _).mpr ((mem_posRoots_rational_g2_iff ht _).mpr i.isLt)
      obtain ⟨j, hj, hji⟩ := List.mem_map.mp (hmap.symm ▸ hi)
      exact Fin.castAdd_injective 6 _ hji ▸ hj
    rw [mem_biSup_posRoots_g2_iff_exists_list_prod_map ρ M hM hnil A l₆ hl₆ hall g]
    have hprod (f : Fin G2.numRoots → LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
        (l.map f).prod = (l₆.map fun i => f (Fin.castAdd 6 i)).prod := by
      rw [← hmap]
      exact congrArg List.prod List.map_map
    constructor
    · rintro ⟨u, hu⟩
      refine ⟨fun γ => if h : γ.val < 6 then u ⟨γ.val, h⟩ else 0, ?_⟩
      rw [hprod]
      simpa only [Fin.val_castAdd, dite_eq_left (Fin.is_lt _)] using hu
    · rintro ⟨u, hu⟩
      exact ⟨fun i => u (Fin.castAdd 6 i), (hprod _).symm.trans hu⟩
  · let := isNotG2_rationalRootSystem_of_ne_G2 (ht := ht) hG2
    simpa only [mem_posRootsFinset] using
      (mem_biSup_range_iff_exists_list_prod_map
        (X := fun γ => chevalleyRootSubgroup ρ M hM hnil γ A)
        (ht := (t.rationalBase ht).height)
        (S := posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht))
        (fun α hα β hβ _ => commutator_range_chevalleyRootSubgroup_le
          ρ M hM hnil ((mem_posRootsFinset _ _ _).mp hα)
          ((mem_posRootsFinset _ _ _).mp hβ) A)
        hl (fun γ => (hlpos γ).trans (mem_posRootsFinset _ _ γ).symm) (g := g))

end TauCeti.DynkinType
