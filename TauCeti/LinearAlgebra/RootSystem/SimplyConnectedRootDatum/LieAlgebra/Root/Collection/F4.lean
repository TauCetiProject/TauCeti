module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.F4.Rational

/-!
# Ordered products of positive F₄ root subgroups

The first twenty-four entries of the pinned F₄ table index exactly the positive root subgroups.
They collect in any prescribed duplicate-free order, over every commutative value ring and on
every Kostant-stable lattice with nilpotent simple root operators. No uniqueness is asserted.

This table-indexed form specializes
`TauCeti.DynkinType.mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod` using
`TauCeti.DynkinType.mem_posRoots_rationalRootSystem_F4_iff`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 15 and 17.
* R. W. Carter, *Simple Groups of Lie Type*, Theorems 5.2.2 and 5.3.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

variable {ht : F4.Valid} {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (F4.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
  (M : AddSubgroup V)
  (hM : ∀ u ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (F4.lieBasis ht).rootGenerator (F4.lieBasis ht).h,
    ∀ v ∈ M, ρ u v ∈ M)
  (hnil : ∀ i, IsNilpotent
    (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((F4.lieBasis ht).rootGenerator i))))

attribute [local instance high] Algebra.toModule

/-- Every element generated by positive F₄ root subgroups is a product indexed by the first
twenty-four table entries, in any prescribed duplicate-free order. No uniqueness is asserted. -/
theorem mem_biSup_posRoots_chevalleyRootSubgroup_F4_iff_exists_list_prod_map (A : CommAlgCat ℤ)
    {l : List (Fin F4.numRoots)} (hl : l.Nodup)
    (hlS : ∀ γ, γ ∈ l ↔ γ.val < 24)
    {g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)} :
    g ∈ ⨆ γ ∈ posRoots (F4.rationalRootSystem ht) (F4.rationalBase ht),
        (chevalleyRootSubgroup ρ M hM hnil γ A).range ↔
      ∃ u : Fin F4.numRoots → A,
        (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ A
          (Multiplicative.ofAdd (u γ))).prod = g := by
  exact mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod ρ M hM hnil A l hl
    (fun γ => (hlS γ).trans (mem_posRoots_rationalRootSystem_F4_iff ht γ).symm) g

end TauCeti.DynkinType
