module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Commutator.Basic
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.F4.Positive
public import TauCeti.Algebra.Group.Subgroup.OrderedProduct

/-!
# Ordered products of positive F₄ root subgroups

On every Kostant-stable lattice with nilpotent simple root operators, the subgroup generated by
all positive F₄ root subgroups consists of their ordered products, in any prescribed order
without repetitions. The value ring is arbitrary, including characteristic two and nonreduced
rings. No uniqueness of the parameters or generation by positive simple roots is asserted.

The existing one- and two-factor integral Chevalley commutator formulas imply that commutators
strictly raise root height. The collection argument is
`TauCeti.mem_biSup_iff_exists_list_prod_map`; only its F₄ root-table input is supplied here.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 15 and 17.
* R. W. Carter, *Simple Groups of Lie Type*, Theorems 5.2.2 and 5.3.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra
open scoped commutatorElement

-- For each pair, choose the applicable integral commutator formula. The last alternative
-- reverses the pair when its second root, rather than its first, starts the double string.
private theorem f4_positive_pair_cases (α β : Fin 48) (h : α < β ∧ β.val < 24) :
    ((f4Root α + f4Root β ∉ Set.range f4Root ∧ f4Root α + f4Root β ≠ 0) ∨
      ∃ γ, f4Root γ = f4Root α + f4Root β ∧
        2 • f4Root α + f4Root β ∉ Set.range f4Root ∧
        f4Root α + 2 • f4Root β ∉ Set.range f4Root) ∨
    ((∃ γδ : Fin 48 × Fin 48,
      (f4Root γδ.1 = f4Root α + f4Root β ∧
        f4Root γδ.2 = 2 • f4Root α + f4Root β) ∧
      (3 • f4Root α + f4Root β ∉ Set.range f4Root ∧
        f4Root α + 2 • f4Root β ∉ Set.range f4Root)) ∨
      ∃ γδ : Fin 48 × Fin 48,
      (f4Root γδ.1 = f4Root β + f4Root α ∧
        f4Root γδ.2 = 2 • f4Root β + f4Root α) ∧
      (3 • f4Root β + f4Root α ∉ Set.range f4Root ∧
        f4Root β + 2 • f4Root α ∉ Set.range f4Root)) := by
  -- Cache these instances before synthesizing the decision procedure for the nested cases.
  let eqDec : DecidableEq (Fin 4 → ℤ) := Fintype.decidablePiFintype
  let rangeDec : DecidablePred (fun x : Fin 4 → ℤ => x ∈ Set.range f4Root) :=
    Fintype.decidableMemRangeFintype _
  revert h β α
  refine @of_decide_eq_true _ (inferInstance) ?_
  decide +kernel

variable {ht : F4.Valid} {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (F4.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
  (M : AddSubgroup V)
  (hM : ∀ u ∈ kostantForm (F4.lieBasis ht).rootGenerator (F4.lieBasis ht).h,
    ∀ v ∈ M, ρ u v ∈ M)
  (hnil : ∀ i, IsNilpotent
    (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((F4.lieBasis ht).rootGenerator i))))

attribute [local instance high] Algebra.toModule

/-- Commutators of distinct positive F₄ root subgroups lie in the subgroup generated by roots
of strictly greater height than both inputs, over every commutative value ring. -/
theorem commutator_range_chevalleyRootSubgroup_F4_le (A : CommAlgCat ℤ)
    {α β : Fin F4.numRoots}
    (hα : α ∈ posRoots (F4.rationalRootSystem ht) (F4.rationalBase ht))
    (hβ : β ∈ posRoots (F4.rationalRootSystem ht) (F4.rationalBase ht)) (hne : α ≠ β) :
    ⁅(chevalleyRootSubgroup ρ M hM hnil α A).range,
      (chevalleyRootSubgroup ρ M hM hnil β A).range⁆ ≤
      ⨆ γ ∈ {γ ∈ posRootsFinset (F4.rationalRootSystem ht) (F4.rationalBase ht) |
        max ((F4.rationalBase ht).height α) ((F4.rationalBase ht).height β) <
          (F4.rationalBase ht).height γ},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range := by
  classical
  -- Subgroup commutators are symmetric, so only increasing table pairs need checking.
  wlog hlt : α < β generalizing α β
  · simpa only [Subgroup.commutator_comm, max_comm] using
      this hβ hα hne.symm (lt_of_le_of_ne (le_of_not_gt hlt) hne.symm)
  let P := F4.simplyConnectedRootDatum ht
  let b := F4.rationalBase ht
  let X := fun γ => (chevalleyRootSubgroup ρ M hM hnil γ A).range
  let Z := ⨆ γ ∈ {γ ∈ posRootsFinset (F4.rationalRootSystem ht) b |
    max (b.height α) (b.height β) < b.height γ}, X γ
  have hαpos : 0 < b.height α := (mem_posRoots _ _ _).mp hα
  have hβpos : 0 < b.height β := (mem_posRoots _ _ _).mp hβ
  -- Transport integral root sums to rational heights; every resulting higher root is positive.
  have hheight {i j k : Fin F4.numRoots} (hk : P.root k = P.root i + P.root j) :
      b.height k = b.height i + b.height j := by
    apply b.height_add
    ext q
    simp only [Pi.add_apply, root_rationalRootSystem]
    exact_mod_cast congrFun hk q
  have hmem {γ : Fin F4.numRoots} (hγ : max (b.height α) (b.height β) < b.height γ)
      (u : Multiplicative A) : chevalleyRootSubgroup ρ M hM hnil γ A u ∈ Z := by
    apply le_iSup₂ (f := fun γ _ => X γ) γ _ ⟨u, rfl⟩
    simp only [Finset.mem_filter, mem_posRootsFinset, mem_posRoots,
      RootPairing.Base.isPos_iff]
    exact ⟨lt_trans (lt_max_of_lt_left hαpos) hγ, hγ⟩
  -- Treat a double string once, allowing either orientation of the input pair.
  have htwo {i j γ δ : Fin F4.numRoots}
      (hij : max (b.height i) (b.height j) = max (b.height α) (b.height β))
      (hi : 0 < b.height i) (hj : 0 < b.height j)
      (hγ : P.root γ = P.root i + P.root j)
      (hδ : P.root δ = 2 • P.root i + P.root j)
      (hi' : 3 • P.root i + P.root j ∉ Set.range P.root)
      (hj' : P.root i + 2 • P.root j ∉ Set.range P.root)
      (u v : A) :
      ⁅chevalleyRootSubgroup ρ M hM hnil i A (Multiplicative.ofAdd u),
        chevalleyRootSubgroup ρ M hM hnil j A (Multiplicative.ofAdd v)⁆ ∈ Z := by
    have hγheight := hheight hγ
    have hδ' : P.root δ = P.root i + P.root γ := by rw [hδ, hγ]; module
    have hδheight := hheight hδ'
    rw [commutatorElement_chevalleyRootSubgroup_of_root_eq_two_nsmul_add
      ρ M hM hnil hγ hδ hi' hj']
    exact Z.mul_mem (hmem (by omega) _) (hmem (by omega) _)
  have hcases := f4_positive_pair_cases α β ⟨hlt, (mem_posRoots_F4_iff ht β).mp hβ⟩
  -- Replace only the root table, so the following formulas retain the original lattice maps.
  rw [← f4SimplyConnectedRootDatum_root, ← simplyConnectedRootDatum_F4 ht] at hcases
  apply Subgroup.commutator_le.mpr
  rintro _ ⟨u, rfl⟩ _ ⟨v, rfl⟩
  rcases hcases with (⟨hsum, hzero⟩ | ⟨γ, hγ, hi, hj⟩) |
    (⟨⟨γ, δ⟩, ⟨hγ, hδ⟩, hi, hj⟩ | ⟨⟨γ, δ⟩, ⟨hγ, hδ⟩, hi, hj⟩)
  · have hc := commute_chevalleyRootSubgroup ρ M hM hnil hsum hzero A u.toAdd v.toAdd
    have hc' : Commute (chevalleyRootSubgroup ρ M hM hnil α A u)
        (chevalleyRootSubgroup ρ M hM hnil β A v) := by simpa only [ofAdd_toAdd] using hc
    rw [commutatorElement_eq_one_iff_commute.mpr hc']
    exact Z.one_mem
  · have hγheight := hheight hγ
    rw [← ofAdd_toAdd u, ← ofAdd_toAdd v,
      commutatorElement_chevalleyRootSubgroup_of_root_eq_add ρ M hM hnil hγ hi hj]
    exact hmem (by omega) _
  · exact htwo rfl hαpos hβpos hγ hδ hi hj u.toAdd v.toAdd
  · rw [← commutatorElement_inv]
    exact Z.inv_mem (htwo (max_comm _ _) hβpos hαpos hγ hδ hi hj v.toAdd u.toAdd)

/-- Every element of the subgroup generated by all positive F₄ roots is an ordered product
of one element from each root subgroup, in any prescribed duplicate-free order. The factors
are the existing additive root parameters, and no uniqueness assertion is made. -/
theorem mem_iSup_range_chevalleyRootSubgroup_F4_iff_exists_prod (A : CommAlgCat ℤ)
    {l : List (Fin F4.numRoots)} (hl : l.Nodup)
    (hlS : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (F4.rationalRootSystem ht) (F4.rationalBase ht))
    {g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)} :
    g ∈ ⨆ γ ∈ posRootsFinset (F4.rationalRootSystem ht) (F4.rationalBase ht),
        (chevalleyRootSubgroup ρ M hM hnil γ A).range ↔
      ∃ u : Fin F4.numRoots → A,
        (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ A
          (Multiplicative.ofAdd (u γ))).prod = g := by
  classical
  rw [TauCeti.mem_biSup_iff_exists_list_prod_map
    (ht := (F4.rationalBase ht).height)
    (fun α hα β hβ hne => commutator_range_chevalleyRootSubgroup_F4_le ρ M hM hnil A
      ((mem_posRootsFinset _ _ _).mp hα) ((mem_posRootsFinset _ _ _).mp hβ) hne)
    hl (fun γ => (hlS γ).trans (mem_posRootsFinset _ _ _).symm)]
  constructor
  · rintro ⟨f, hf, hprod⟩
    choose u hu using hf
    exact ⟨fun γ => (u γ).toAdd, by simpa only [ofAdd_toAdd, hu] using hprod⟩
  · rintro ⟨u, hprod⟩
    exact ⟨_, fun γ => ⟨_, rfl⟩, hprod⟩

end TauCeti.DynkinType
