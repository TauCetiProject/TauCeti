/-!
# Ordered positive-root products outside G₂

On every Kostant-stable lattice whose rational root system satisfies `IsNotG2`, the subgroup
generated by all positive root subgroups consists of their products in any prescribed order
without repetitions. In particular, this applies to classical types B and C.
This supplies the existence part of positive-root coordinates; no uniqueness or generation by
positive simple roots alone is asserted. The value ring is arbitrary, including characteristic
two and nonreduced rings.

The `IsNotG2` hypothesis excludes triple root strings. The native one- and two-factor integral
commutator formulas then show that commutators strictly raise height. Collection uses
`TauCeti.mem_biSup_iff_exists_list_prod_map`, rather than division by structure constants or
rewriting root words. The rational root system is used only to determine which root strings
occur; every group operation and parameter remains over the original value ring.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 15 and 17.
* R. W. Carter, *Simple Groups of Lie Type*, Theorems 5.2.2 and 5.3.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra
open scoped commutatorElement

noncomputable section

variable {t : DynkinType} {ht : t.Valid}

private theorem not_three_nsmul_add_mem_range_root
    [(t.rationalRootSystem ht).IsNotG2] (a c : Fin t.numRoots)
    (hli : LinearIndependent ℚ
      ![(t.rationalRootSystem ht).root a, (t.rationalRootSystem ht).root c]) :
    3 • (t.simplyConnectedRootDatum ht).root a + (t.simplyConnectedRootDatum ht).root c ∉
      Set.range (t.simplyConnectedRootDatum ht).root := by
  rintro ⟨d, hd⟩
  have hdQ := (t.root_rationalRootSystem_eq_nsmul_add_iff ht a c d 3).mpr hd
  have hcoeff := (t.rationalRootSystem ht).coefficients_of_pos_nsmul_add_pos_nsmul_mem hli
    (by decide : 0 < 3) (by decide : 0 < 1)
    (by simpa only [one_nsmul] using Set.mem_range.mpr ⟨d, hdQ⟩)
  omega

variable {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
  (M : AddSubgroup V)
  (hM : ∀ u ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
    ∀ v ∈ M, ρ u v ∈ M)
  (hnil : ∀ i, IsNilpotent
    (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

attribute [local instance high] Algebra.toModule

private theorem commutator_mem_higher_roots
    [(t.rationalRootSystem ht).IsNotG2]
    {α β : Fin t.numRoots}
    (hα : α ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hβ : β ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (A : CommAlgCat ℤ) (u v : A) :
    ⁅chevalleyRootSubgroup ρ M hM hnil α A (Multiplicative.ofAdd u),
      chevalleyRootSubgroup ρ M hM hnil β A (Multiplicative.ofAdd v)⁆ ∈
      ⨆ γ ∈ {γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
          (t.rationalBase ht).height γ},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range := by
  classical
  let P := t.rationalRootSystem ht
  let b := t.rationalBase ht
  let H := ⨆ γ ∈ {γ ∈ posRootsFinset P b |
    max (b.height α) (b.height β) < b.height γ},
      (chevalleyRootSubgroup ρ M hM hnil γ A).range
  have hH (d : Fin t.numRoots) (hd : d ∈ posRoots P b)
      (hheight : max (b.height α) (b.height β) < b.height d) :
      ∀ w, chevalleyRootSubgroup ρ M hM hnil d A w ∈ H := by
    intro w
    exact (le_iSup₂ (f := fun γ _ => (chevalleyRootSubgroup ρ M hM hnil γ A).range)
      d (Finset.mem_filter.mpr ⟨(mem_posRootsFinset P b d).mpr hd, hheight⟩)) ⟨w, rfl⟩
  have hmem {a c d : Fin t.numRoots}
      (ha : a ∈ posRoots P b) (hc : c ∈ posRoots P b)
      (horder : max (b.height a) (b.height c) = max (b.height α) (b.height β))
      (hd : P.root d = P.root a + P.root c) :
      ∀ w, chevalleyRootSubgroup ρ M hM hnil d A w ∈ H := by
    have hdpos := add_mem_posRoots P b ha hc hd
    have hdheight := b.height_add hd
    have hapos := one_le_height_of_mem_posRoots P b ha
    have hcpos := one_le_height_of_mem_posRoots P b hc
    exact hH d hdpos (by omega)
  -- A root sum has either no double string or exactly one orientation of a double string.
  by_cases hsum : P.root α + P.root β ∈ Set.range P.root
  · obtain ⟨γ, hγ⟩ := hsum
    have hγZ := (t.root_rationalRootSystem_eq_add_iff ht α β γ).mp hγ
    have hlin := P.linearIndependent_of_add_mem_range_root' ⟨γ, hγ⟩
    have hexclude := P.not_double_root_add_and_root_add_double_mem hlin
    have hdouble {a c d : Fin t.numRoots}
        (ha : a ∈ posRoots P b) (hc : c ∈ posRoots P b)
        (horder : max (b.height a) (b.height c) = max (b.height α) (b.height β))
        (hγ' : P.root γ = P.root a + P.root c)
        (hd : P.root d = 2 • P.root a + P.root c) :
        ∀ w, chevalleyRootSubgroup ρ M hM hnil d A w ∈ H := by
      have hd' : P.root d = P.root a + P.root γ := by rw [hd, hγ']; module
      have hγpos := add_mem_posRoots P b ha hc hγ'
      have hdpos := add_mem_posRoots P b ha hγpos hd'
      have hγheight := b.height_add hγ'
      have hdheight := b.height_add hd'
      have hapos := one_le_height_of_mem_posRoots P b ha
      have hcpos := one_le_height_of_mem_posRoots P b hc
      exact hH d hdpos (by omega)
    by_cases ha : 2 • (t.simplyConnectedRootDatum ht).root α +
        (t.simplyConnectedRootDatum ht).root β ∈ Set.range (t.simplyConnectedRootDatum ht).root
    · obtain ⟨δ, hδ⟩ := ha
      have hδQ := (t.root_rationalRootSystem_eq_nsmul_add_iff ht α β δ 2).mpr hδ
      have hb : (t.simplyConnectedRootDatum ht).root α +
          2 • (t.simplyConnectedRootDatum ht).root β ∉
            Set.range (t.simplyConnectedRootDatum ht).root := by
        rintro ⟨d, hd⟩
        exact hexclude ⟨⟨δ, hδQ⟩, ⟨d, by
          simpa only [add_comm] using
            (t.root_rationalRootSystem_eq_nsmul_add_iff ht β α d 2).mpr (hd.trans (add_comm _ _))⟩⟩
      rw [commutatorElement_chevalleyRootSubgroup_of_root_eq_two_nsmul_add
        ρ M hM hnil hγZ hδ (not_three_nsmul_add_mem_range_root α β hlin) hb]
      exact H.mul_mem (hmem hα hβ rfl hγ _) (hdouble hα hβ rfl hγ hδQ _)
    · by_cases hb : 2 • (t.simplyConnectedRootDatum ht).root β +
          (t.simplyConnectedRootDatum ht).root α ∈ Set.range (t.simplyConnectedRootDatum ht).root
      · obtain ⟨δ, hδ⟩ := hb
        have hγ' := hγ.trans (add_comm _ _)
        -- Reverse the commutator instead of introducing another coefficient/sign convention.
        rw [← commutatorElement_inv]
        apply H.inv_mem
        rw [commutatorElement_chevalleyRootSubgroup_of_root_eq_two_nsmul_add
          ρ M hM hnil (hγZ.trans (add_comm _ _)) hδ
          (not_three_nsmul_add_mem_range_root β α (LinearIndependent.pair_symm_iff.mpr hlin))
          (by simpa only [add_comm] using ha)]
        exact H.mul_mem (hmem hβ hα (max_comm _ _) hγ' _)
          (hdouble hβ hα (max_comm _ _) hγ'
            ((t.root_rationalRootSystem_eq_nsmul_add_iff ht β α δ 2).mpr hδ) _)
      · rw [commutatorElement_chevalleyRootSubgroup_of_root_eq_add ρ M hM hnil hγZ ha
          (by simpa only [add_comm] using hb)]
        exact hmem hα hβ rfl hγ _
  · -- Without a root sum the groups commute; positivity rules out opposite roots.
    have hsumZ : (t.simplyConnectedRootDatum ht).root α +
        (t.simplyConnectedRootDatum ht).root β ∉
          Set.range (t.simplyConnectedRootDatum ht).root := by
      rintro ⟨γ, hγ⟩
      exact hsum ⟨γ, (t.root_rationalRootSystem_eq_add_iff ht α β γ).mpr hγ⟩
    have hzero : (t.simplyConnectedRootDatum ht).root α +
        (t.simplyConnectedRootDatum ht).root β ≠ 0 := by
      intro hz
      have hdeg := congrArg (t.weightDegree ht) hz
      have ha := t.weightDegree_root_pos ht hα
      have hb := t.weightDegree_root_pos ht hβ
      rw [map_add, map_zero] at hdeg
      linarith
    rw [(commute_chevalleyRootSubgroup ρ M hM hnil hsumZ hzero A u v).commutator_eq]
    exact H.one_mem

/-- Outside G₂, commutators of positive root groups strictly raise root height over
any commutative value ring. The roots are those of the native pinned positive system. -/
theorem commutator_range_chevalleyRootSubgroup_le
    [(t.rationalRootSystem ht).IsNotG2]
    {α β : Fin t.numRoots}
    (hα : α ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hβ : β ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (A : CommAlgCat ℤ) :
    ⁅(chevalleyRootSubgroup ρ M hM hnil α A).range,
      (chevalleyRootSubgroup ρ M hM hnil β A).range⁆ ≤
      ⨆ γ ∈ {γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
          (t.rationalBase ht).height γ},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range := by
  apply Subgroup.commutator_le.mpr
  rintro _ ⟨u, rfl⟩ _ ⟨v, rfl⟩
  exact commutator_mem_higher_roots ρ M hM hnil hα hβ A u.toAdd v.toAdd

/-- Outside G₂, every element generated by the positive root subgroups is a product of
one root element per positive root, in any prescribed enumeration without repetitions.
This is a membership characterization, without a uniqueness assertion. -/
theorem mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod
    [(t.rationalRootSystem ht).IsNotG2] (A : CommAlgCat ℤ)
    (l : List (Fin t.numRoots)) (hl : l.Nodup)
    (hlpos : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    g ∈ ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (chevalleyRootSubgroup ρ M hM hnil γ A).range ↔
      ∃ u : Fin t.numRoots → A,
        (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ A
          (Multiplicative.ofAdd (u γ))).prod = g := by
  classical
  have hcollect := TauCeti.mem_biSup_iff_exists_list_prod_map
    (X := fun γ => (chevalleyRootSubgroup ρ M hM hnil γ A).range)
    (ht := (t.rationalBase ht).height)
    (S := posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht))
    (fun α hα β hβ _ => commutator_range_chevalleyRootSubgroup_le
      ρ M hM hnil ((mem_posRootsFinset _ _ _).mp hα)
      ((mem_posRootsFinset _ _ _).mp hβ) A)
    hl (fun γ => (hlpos γ).trans (mem_posRootsFinset _ _ γ).symm) (g := g)
  simp only [mem_posRootsFinset] at hcollect
  rw [hcollect]
  constructor
  · rintro ⟨f, hf, hprod⟩
    choose u hu using hf
    exact ⟨fun γ => (u γ).toAdd, by simpa only [ofAdd_toAdd, hu] using hprod⟩
  · rintro ⟨u, rfl⟩
    exact ⟨_, fun γ => ⟨Multiplicative.ofAdd (u γ), rfl⟩, rfl⟩

end

end TauCeti.DynkinType
