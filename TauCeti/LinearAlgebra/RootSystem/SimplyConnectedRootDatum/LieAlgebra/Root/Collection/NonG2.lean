module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.Basic
public import TauCeti.LinearAlgebra.RootSystem.Finite.PositiveCombinations
public import TauCeti.Algebra.Group.Subgroup.OrderedProduct

/-!
# Ordered products of positive root subgroups outside G₂

On every Kostant-stable lattice with nilpotent simple root operators, the positive-root subgroup
is the product of its root subgroups in any prescribed duplicate-free order. The value ring is
arbitrary. No uniqueness of parameters or generation by positive simple roots is asserted.

Outside G₂, `RootPairing.coefficients_of_pos_nsmul_add_pos_nsmul_mem` and
`RootPairing.not_double_root_add_and_root_add_double_mem` reduce each commutator to the existing
one- and two-factor integral formulas. They strictly raise root height, allowing collection by
`TauCeti.mem_biSup_iff_exists_list_prod_map`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 15 and 17.
* R. W. Carter, *Simple Groups of Lie Type*, Theorems 5.2.2 and 5.3.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra
open scoped commutatorElement

variable {t : DynkinType} {ht : t.Valid} {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
  (M : AddSubgroup V)
  (hM : ∀ u ∈ kostantForm (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
    ∀ v ∈ M, ρ u v ∈ M)
  (hnil : ∀ i, IsNilpotent
    (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

attribute [local instance high] Algebra.toModule

/-- Outside G₂, commutators of positive root subgroups lie in the subgroup generated by roots
of strictly greater height than both inputs, over every commutative value ring. -/
theorem commutator_range_chevalleyRootSubgroup_le (hG2 : t ≠ G2) (A : CommAlgCat ℤ)
    {α β : Fin t.numRoots}
    (hα : α ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hβ : β ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) :
    ⁅(chevalleyRootSubgroup ρ M hM hnil α A).range,
      (chevalleyRootSubgroup ρ M hM hnil β A).range⁆ ≤
      ⨆ γ ∈ {γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
          (t.rationalBase ht).height γ},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range := by
  classical
  let P := t.simplyConnectedRootDatum ht
  let Q := t.rationalRootSystem ht
  let b := t.rationalBase ht
  let Z := ⨆ γ ∈ {γ ∈ posRootsFinset Q b |
    max (b.height α) (b.height β) < b.height γ},
      (chevalleyRootSubgroup ρ M hM hnil γ A).range
  let _ := isNotG2_rationalRootSystem t ht hG2
  have hαpos : 0 < b.height α := b.isPos_iff.mp ((mem_posRoots _ _ _).mp hα)
  have hβpos : 0 < b.height β := b.isPos_iff.mp ((mem_posRoots _ _ _).mp hβ)
  -- The integral formulas use roots in P; the root-string bounds are applied over ℚ.
  have hmap {i j k : Fin t.numRoots} {n : ℕ}
      (h : P.root k = n • P.root i + P.root j) :
      Q.root k = n • Q.root i + Q.root j := by
    simpa only [Int.cast_natCast, Nat.cast_smul_eq_nsmul, add_comm] using
      (root_rationalRootSystem_eq_add_zsmul_iff t ht i j k n).mpr
        (by simpa only [natCast_zsmul, add_comm] using h)
  apply Subgroup.commutator_le.mpr
  rintro _ ⟨u, rfl⟩ _ ⟨v, rfl⟩
  by_cases heq : α = β
  · subst β
    rw [commutatorElement_eq_one_iff_commute.mpr
      ((Commute.all u v).map (chevalleyRootSubgroup ρ M hM hnil α A))]
    exact Z.one_mem
  rw [← ofAdd_toAdd u, ← ofAdd_toAdd v]
  by_cases hsum : P.root α + P.root β ∈ Set.range P.root
  · obtain ⟨γ, hγ⟩ := hsum
    have hγQ : Q.root γ = Q.root α + Q.root β := by
      simpa only [one_smul] using hmap (n := 1) (by simpa only [one_smul] using hγ)
    have hlin := Q.linearIndependent_of_add_mem_range_root' ⟨γ, hγQ⟩
    have hthree {i j : Fin t.numRoots}
        (hli : LinearIndependent ℚ ![Q.root i, Q.root j]) :
        3 • P.root i + P.root j ∉ Set.range P.root := by
      rintro ⟨δ, hδ⟩
      have hc := Q.coefficients_of_pos_nsmul_add_pos_nsmul_mem hli
        (by decide : 0 < 3) (by decide : 0 < 1)
        (by simpa only [one_smul] using Set.mem_range.mpr ⟨δ, hmap hδ⟩)
      omega
    have hnotboth : ¬ (2 • P.root α + P.root β ∈ Set.range P.root ∧
        P.root α + 2 • P.root β ∈ Set.range P.root) := by
      rintro ⟨⟨δ, hδ⟩, ⟨ε, hε⟩⟩
      apply Q.not_double_root_add_and_root_add_double_mem hlin
      refine ⟨⟨δ, hmap hδ⟩, ⟨ε, ?_⟩⟩
      simpa only [add_comm] using hmap (by simpa only [add_comm] using hε)
    -- Choose the double-string orientation if present; otherwise use the one-factor formula.
    by_cases hi : 2 • P.root α + P.root β ∈ Set.range P.root
    · obtain ⟨δ, hδ⟩ := hi
      exact commutatorElement_chevalleyRootSubgroup_mem_biSup_of_root_eq_two_nsmul_add
        ρ M hM hnil hγ hδ (hthree hlin) (fun hj => hnotboth ⟨⟨δ, hδ⟩, hj⟩)
        hα hβ A u.toAdd v.toAdd
    by_cases hj : P.root α + 2 • P.root β ∈ Set.range P.root
    · obtain ⟨δ, hδ⟩ := hj
      rw [← commutatorElement_inv]
      apply Z.inv_mem
      simpa only [Z, b, Q, max_comm] using
        commutatorElement_chevalleyRootSubgroup_mem_biSup_of_root_eq_two_nsmul_add
          ρ M hM hnil (by simpa only [add_comm] using hγ)
          (by simpa only [add_comm] using hδ) (hthree (LinearIndependent.pair_symm_iff.mpr hlin))
          (by simpa only [add_comm] using hi) hβ hα A v.toAdd u.toAdd
    rw [commutatorElement_chevalleyRootSubgroup_of_root_eq_add ρ M hM hnil hγ hi hj]
    have hγheight : b.height γ = b.height α + b.height β := height_rationalBase_add t ht hγ
    dsimp only [b] at hαpos hβpos hγheight
    exact chevalleyRootSubgroup_mem_biSup_of_height_lt ρ M hM hnil (by omega) (by omega) A _
  · have hzero : P.root α + P.root β ≠ 0 :=
      root_add_ne_zero_of_mem_posRoots_of_mem_posRootCone P (t.simplyConnectedBase ht)
        (by simpa only [posRoots_rationalRootSystem] using hα)
        (root_mem_posRootCone_of_mem_posRoots P (t.simplyConnectedBase ht)
          (by simpa only [posRoots_rationalRootSystem] using hβ))
    rw [commutatorElement_eq_one_iff_commute.mpr
      (commute_chevalleyRootSubgroup ρ M hM hnil hsum hzero A u.toAdd v.toAdd)]
    exact Z.one_mem

/-- Outside G₂, every element generated by positive root subgroups is a product with one factor
per positive root in any prescribed duplicate-free order. No uniqueness is asserted. -/
theorem mem_biSup_range_chevalleyRootSubgroup_iff_exists_list_prod_map
    (hG2 : t ≠ G2) (A : CommAlgCat ℤ)
    {l : List (Fin t.numRoots)} (hl : l.Nodup)
    (hlS : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    {g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)} :
    g ∈ ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (chevalleyRootSubgroup ρ M hM hnil γ A).range ↔
      ∃ u : Fin t.numRoots → A,
        (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ A
          (Multiplicative.ofAdd (u γ))).prod = g := by
  classical
  have hsup : (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
      (chevalleyRootSubgroup ρ M hM hnil γ A).range) =
      ⨆ γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht),
        (chevalleyRootSubgroup ρ M hM hnil γ A).range := by
    simp only [mem_posRootsFinset]
  rw [hsup, TauCeti.mem_biSup_iff_exists_list_prod_map
    (ht := (t.rationalBase ht).height)
    (fun α hα β hβ _ => commutator_range_chevalleyRootSubgroup_le ρ M hM hnil hG2 A
      ((mem_posRootsFinset _ _ _).mp hα) ((mem_posRootsFinset _ _ _).mp hβ))
    hl (fun γ => (hlS γ).trans (mem_posRootsFinset _ _ _).symm)]
  constructor
  · rintro ⟨f, hf, hprod⟩
    choose u hu using hf
    exact ⟨fun γ => (u γ).toAdd, by simpa only [ofAdd_toAdd, hu] using hprod⟩
  · rintro ⟨u, hprod⟩
    exact ⟨_, fun γ => ⟨_, rfl⟩, hprod⟩

end TauCeti.DynkinType
