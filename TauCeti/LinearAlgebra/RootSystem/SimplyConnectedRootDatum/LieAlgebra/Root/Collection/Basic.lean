module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Subgroup
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.G2
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2

/-!
# Ordered positive-root products across all valid Dynkin types

On any Kostant-stable lattice `M` with nilpotent simple root operators, the subgroup generated by
all positive root subgroups consists of products with one factor per positive root, in any
prescribed duplicate-free enumeration and over every commutative value ring. No faithfulness,
weight basis, or spanning hypothesis on `M` is required, and no coordinate uniqueness is asserted.

This combines the height-graded collection theorem outside `G₂`
(`TauCeti.DynkinType.mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod_of_isNotG2` in
`TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2`) with
the six-root table-index collection theorem in `G₂`
(`TauCeti.DynkinType.mem_biSup_posRoots_g2_iff_exists_list_prod_map` in
`TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.G2`).

## Main results

* `TauCeti.DynkinType.mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod`: ordered
  positive-root collection on any Kostant-stable lattice, for every valid Dynkin type and
  commutative value ring.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 15 and 17.
* R. W. Carter, *Simple Groups of Lie Type*, Theorems 5.2.2 and 5.3.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct

noncomputable section

attribute [local instance high] Algebra.toModule

private def g2Cast6 : Fin 6 → Fin G2.numRoots := Fin.castAdd 6

private theorem exists_map_g2Cast6_eq_of_posRoots_g2 {ht : G2.Valid}
    {l : List (Fin G2.numRoots)} (hl : l.Nodup)
    (hlpos : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht)) :
    ∃ l₆ : List (Fin 6),
      l₆.map g2Cast6 = l ∧ l₆.Nodup ∧ ∀ i : Fin 6, i ∈ l₆ := by
  have hex : ∀ l' : List (Fin G2.numRoots), (∀ γ ∈ l', (γ : ℕ) < 6) →
      ∃ l₆ : List (Fin 6), l₆.map g2Cast6 = l' := by
    intro l' hl'
    induction l' with
    | nil => exact ⟨[], rfl⟩
    | cons γ tl ih =>
      obtain ⟨l₆, rfl⟩ := ih fun δ hδ => hl' δ (List.mem_cons_of_mem _ hδ)
      exact ⟨⟨γ, hl' γ List.mem_cons_self⟩ :: l₆, congrArg (· :: _) (Fin.ext rfl)⟩
  obtain ⟨l₆, hmap⟩ :=
    hex l fun γ hγ => (mem_posRoots_rational_g2_iff ht γ).mp ((hlpos γ).mp hγ)
  refine ⟨l₆, hmap, List.Nodup.of_map g2Cast6 (by rwa [hmap]), fun i => ?_⟩
  have hi : g2Cast6 i ∈ l :=
    (hlpos _).mpr ((mem_posRoots_rational_g2_iff ht _).mpr i.isLt)
  rw [← hmap, List.mem_map] at hi
  obtain ⟨j, hj, hij⟩ := hi
  rwa [Fin.castAdd_inj.mp hij] at hj

private theorem mem_iSup_posRoots_chevalleyRootSubgroup_g2_iff_exists_list_prod
    {ht : G2.Valid} {V : Type*} [AddCommGroup V] [Module ℚ V]
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ (G2.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
    (M : AddSubgroup V)
    (hM : ∀ z ∈ UniversalEnvelopingAlgebra.kostantForm
      (G2.lieBasis ht).rootGenerator (G2.lieBasis ht).h,
      ∀ v ∈ M, ρ z v ∈ M)
    (hnil : ∀ r, IsNilpotent
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((G2.lieBasis ht).rootGenerator r))))
    (A : CommAlgCat ℤ) (l : List (Fin G2.numRoots)) (hl : l.Nodup)
    (hlpos : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht))
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    g ∈ ⨆ γ ∈ posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht),
        (chevalleyRootSubgroup ρ M hM hnil γ A).range ↔
      ∃ u : Fin G2.numRoots → A,
        (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ A
          (Multiplicative.ofAdd (u γ))).prod = g := by
  classical
  obtain ⟨l₆, hmap, hl₆, hlall⟩ := exists_map_g2Cast6_eq_of_posRoots_g2 hl hlpos
  rw [mem_biSup_posRoots_g2_iff_exists_list_prod_map ρ M hM hnil A l₆ hl₆ hlall]
  constructor
  · rintro ⟨f, hf⟩
    refine ⟨fun γ => if h : (γ : ℕ) < 6 then f ⟨γ, h⟩ else 0, ?_⟩
    rw [← hmap, List.map_map]
    refine (congrArg List.prod (List.map_congr_left fun i _ => ?_)).trans hf
    have hlt : (g2Cast6 i : ℕ) < 6 := i.isLt
    have harg : (if h : (g2Cast6 i : ℕ) < 6 then f ⟨(g2Cast6 i : ℕ), h⟩ else 0) = f i := by
      simp only [hlt, ↓reduceDIte]
      rfl
    exact congrArg (fun x => chevalleyRootSubgroup ρ M hM hnil (g2Cast6 i) A
      (Multiplicative.ofAdd x)) harg
  · rintro ⟨u, rfl⟩
    refine ⟨fun i => u (g2Cast6 i), ?_⟩
    rw [← hmap, List.map_map]
    rfl

/-- **Every element generated by the positive root subgroups on a Kostant-stable lattice is a
product of one root element per positive root**, in any duplicate-free enumeration, over every
commutative value ring and for every valid Dynkin type. No uniqueness of parameters is asserted. -/
theorem mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod
    {t : DynkinType} {ht : t.Valid} {V : Type*} [AddCommGroup V] [Module ℚ V]
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
    (M : AddSubgroup V)
    (hM : ∀ u ∈ UniversalEnvelopingAlgebra.kostantForm
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
      ∀ v ∈ M, ρ u v ∈ M)
    (hnil : ∀ i, IsNilpotent
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))
    (A : CommAlgCat ℤ) (l : List (Fin t.numRoots)) (hl : l.Nodup)
    (hlpos : ∀ γ, γ ∈ l ↔ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    g ∈ ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (chevalleyRootSubgroup ρ M hM hnil γ A).range ↔
      ∃ u : Fin t.numRoots → A,
        (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ A
          (Multiplicative.ofAdd (u γ))).prod = g := by
  by_cases hG2 : t = G2
  · subst t
    exact mem_iSup_posRoots_chevalleyRootSubgroup_g2_iff_exists_list_prod
      ρ M hM hnil A l hl hlpos g
  · have : (t.rationalRootSystem ht).IsNotG2 := isNotG2_rationalRootSystem_of_ne_G2 (ht := ht) hG2
    exact mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod_of_isNotG2
      ρ M hM hnil A l hl hlpos g

end

end TauCeti.DynkinType
