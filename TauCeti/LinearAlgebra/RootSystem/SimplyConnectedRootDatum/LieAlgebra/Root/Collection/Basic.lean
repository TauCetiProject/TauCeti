module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Commutator.Basic

/-!
# Height bounds for Chevalley commutators

The two-factor integral formula
`commutatorElement_chevalleyRootSubgroup_of_root_eq_two_nsmul_add` places the commutator of
positive root elements in the subgroup generated by roots of strictly greater height than both
inputs.
This supplies the type-independent double-string step for ordered collection.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 15.
* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.2.2.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra
open scoped commutatorElement

variable {t : DynkinType} {ht : t.Valid} {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
  (M : AddSubgroup V)
  (hM : ∀ u ∈ kostantForm (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
    ∀ v ∈ M, ρ u v ∈ M)
  (hnil : ∀ i, IsNilpotent
    (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

attribute [local instance high] Algebra.toModule

/-- A root element whose height exceeds a nonnegative bound belongs to the positive-root
subgroup filtered by that bound. -/
theorem chevalleyRootSubgroup_mem_biSup_of_height_lt
    {m : ℤ} {κ : Fin t.numRoots} (hm : 0 ≤ m)
    (hκ : m < (t.rationalBase ht).height κ)
    (A : CommAlgCat ℤ) (w : Multiplicative A) :
    chevalleyRootSubgroup ρ M hM hnil κ A w ∈
      ⨆ κ ∈ {κ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        m < (t.rationalBase ht).height κ},
        (chevalleyRootSubgroup ρ M hM hnil κ A).range := by
  classical
  apply le_iSup₂ (f := fun κ _ => (chevalleyRootSubgroup ρ M hM hnil κ A).range) κ _
    ⟨w, rfl⟩
  simp only [Finset.mem_filter, mem_posRootsFinset, mem_posRoots,
    RootPairing.Base.isPos_iff]
  exact ⟨lt_of_le_of_lt hm hκ, hκ⟩

/-- For positive roots with a two-factor Chevalley commutator formula, the commutator belongs
to the subgroup generated by positive roots of strictly greater height than both inputs.
This holds for every Dynkin type and every commutative value ring. -/
theorem commutatorElement_chevalleyRootSubgroup_mem_biSup_of_root_eq_two_nsmul_add
    {α β γ δ : Fin t.numRoots}
    (hγ : (t.simplyConnectedRootDatum ht).root γ =
      (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β)
    (hδ : (t.simplyConnectedRootDatum ht).root δ =
      2 • (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β)
    (hα' : 3 • (t.simplyConnectedRootDatum ht).root α +
      (t.simplyConnectedRootDatum ht).root β ∉ Set.range (t.simplyConnectedRootDatum ht).root)
    (hβ' : (t.simplyConnectedRootDatum ht).root α +
      2 • (t.simplyConnectedRootDatum ht).root β ∉ Set.range (t.simplyConnectedRootDatum ht).root)
    (hα : α ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hβ : β ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (A : CommAlgCat ℤ) (u v : A) :
    ⁅chevalleyRootSubgroup ρ M hM hnil α A (Multiplicative.ofAdd u),
      chevalleyRootSubgroup ρ M hM hnil β A (Multiplicative.ofAdd v)⁆ ∈
      ⨆ κ ∈ {κ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
          (t.rationalBase ht).height κ},
        (chevalleyRootSubgroup ρ M hM hnil κ A).range := by
  classical
  let b := t.rationalBase ht
  have hαpos : 0 < b.height α := b.isPos_iff.mp ((mem_posRoots _ _ _).mp hα)
  have hβpos : 0 < b.height β := b.isPos_iff.mp ((mem_posRoots _ _ _).mp hβ)
  have hγheight : b.height γ = b.height α + b.height β :=
    height_rationalBase_add t ht hγ
  have hδ' : (t.simplyConnectedRootDatum ht).root δ =
      (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root γ := by
    rw [hδ, hγ]; module
  have hδheight : b.height δ = b.height α + b.height γ :=
    height_rationalBase_add t ht hδ'
  dsimp only [b] at hαpos hβpos hγheight hδheight
  rw [commutatorElement_chevalleyRootSubgroup_of_root_eq_two_nsmul_add
    ρ M hM hnil hγ hδ hα' hβ']
  exact Subgroup.mul_mem _
    (chevalleyRootSubgroup_mem_biSup_of_height_lt ρ M hM hnil (by omega) (by omega) A _)
    (chevalleyRootSubgroup_mem_biSup_of_height_lt ρ M hM hnil (by omega) (by omega) A _)

end TauCeti.DynkinType
