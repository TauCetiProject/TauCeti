module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.G2

/-!
# Uniform positive-root collection

On any Kostant-stable lattice, the subgroup generated by the positive root subgroups has
ordered product coordinates for every valid Dynkin type over every commutative ring.
Parameters are indexed only by positive roots. Collection also holds after omitting a chosen
simple root, via `exists_prod_of_mem_iSup_punctured_posRoots_chevalleyRootSubgroup`.
The full positive-root result combines
`mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod` outside G₂ with
`mem_biSup_posRoots_g2_iff_exists_list_prod_map` in G₂; no faithfulness is required.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17.
* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.3.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

attribute [local instance high] Algebra.toModule

variable {t : DynkinType} {ht : t.Valid} {V : Type*} [AddCommGroup V] [Module ℚ V]

-- Reindex the native G₂ collection theorem by positive roots rather than its six-row table.
private theorem exists_prod_of_mem_iSup_G2 {ht : G2.Valid}
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ (G2.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
    (M : AddSubgroup V)
    (hM : ∀ z ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (G2.lieBasis ht).rootGenerator (G2.lieBasis ht).h,
      ∀ v ∈ M, ρ z v ∈ M)
    (hnil : ∀ r, IsNilpotent
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((G2.lieBasis ht).rootGenerator r))))
    (A : CommAlgCat ℤ)
    (l : List (posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht)))
    (hl : l.Nodup) (hcover : ∀ γ, γ ∈ l)
    (q : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M))
    (hq : q ∈ ⨆ γ ∈ posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht),
      (chevalleyRootSubgroup ρ M hM hnil γ A).range) :
    ∃ u : posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht) → A,
      (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ.val A
        (Multiplicative.ofAdd (u γ))).prod = q := by
  let e := g2PositiveRootEquiv ht
  obtain ⟨u, hu⟩ := (mem_biSup_posRoots_g2_iff_exists_list_prod_map ρ M hM hnil A
    (l.map e) (hl.map e.injective)
    (fun i => List.mem_map.mpr ⟨e.symm i, hcover _, e.apply_symm_apply i⟩) q).mp hq
  exact ⟨fun γ => u (e γ), by
    simpa only [List.map_map, Function.comp_def, e, castAdd_g2PositiveRootEquiv] using hu⟩

/-- For every valid Dynkin type, membership in the subgroup generated by the positive root
subgroups is equivalent to an ordered product with one parameter per positive root.
The lattice need only be Kostant-stable, and the value ring is arbitrary. -/
theorem mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_prod
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
    (M : AddSubgroup V)
    (hM : ∀ z ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
      ∀ v ∈ M, ρ z v ∈ M)
    (hnil : ∀ r, IsNilpotent
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator r))))
    (A : CommAlgCat ℤ)
    (l : List (posRoots (t.rationalRootSystem ht) (t.rationalBase ht)))
    (hl : l.Nodup) (hcover : ∀ γ, γ ∈ l)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    g ∈ ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (chevalleyRootSubgroup ρ M hM hnil γ A).range ↔
      ∃ u : posRoots (t.rationalRootSystem ht) (t.rationalBase ht) → A,
        (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ.val A
          (Multiplicative.ofAdd (u γ))).prod = g := by
  constructor
  · intro hg
    by_cases hG2 : t = G2
    · subst t
      exact exists_prod_of_mem_iSup_G2 ρ M hM hnil A l hl hcover g hg
    · have := isNotG2_rationalRootSystem_of_ne_G2 (ht := ht) hG2
      have hlist : ∀ γ, γ ∈ l.map Subtype.val ↔
          γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
        intro γ
        simp only [List.mem_map]
        exact ⟨fun ⟨δ, _, hδ⟩ => hδ ▸ δ.property,
          fun hγ => ⟨⟨γ, hγ⟩, hcover _, rfl⟩⟩
      obtain ⟨u, hu⟩ := (mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod
        ρ M hM hnil A (l.map Subtype.val) (hl.map Subtype.val_injective) hlist g).mp hg
      exact ⟨fun γ => u γ.val, by simpa only [List.map_map, Function.comp_def] using hu⟩
  · rintro ⟨u, rfl⟩
    apply Subgroup.list_prod_mem
    intro x hx
    obtain ⟨γ, _, rfl⟩ := List.mem_map.mp hx
    exact Subgroup.mem_iSup_of_mem γ.val (Subgroup.mem_iSup_of_mem γ.property ⟨_, rfl⟩)

local notation "PositiveRoot" =>
  {γ // γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht)}

section Punctured

variable
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
    (M : AddSubgroup V)
    (hM : ∀ z ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
      ∀ v ∈ M, ρ z v ∈ M)
    (hnil : ∀ r, IsNilpotent
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator r))))

open scoped Classical in
private theorem collect_punctured_of_commutator_bound {κ : Type*} [LinearOrder κ]
    (A : CommAlgCat ℤ) (i : Fin t.rank) (key : PositiveRoot → κ)
    (hcomm : ∀ α ∈ Finset.univ.erase
      (⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩ : PositiveRoot),
      ∀ β ∈ Finset.univ.erase
        (⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩ : PositiveRoot), α ≠ β →
      ⁅(chevalleyRootSubgroup ρ M hM hnil α.val A).range,
        (chevalleyRootSubgroup ρ M hM hnil β.val A).range⁆ ≤
        ⨆ γ ∈ {γ ∈ Finset.univ.erase
          (⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩ : PositiveRoot) |
            max (key α) (key β) < key γ},
          (chevalleyRootSubgroup ρ M hM hnil γ.val A).range)
    (l : List PositiveRoot) (hl : l.Nodup)
    (hall : ∀ γ, γ ∈ l ↔ γ ≠ ⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M))
    (hg : g ∈ ⨆ γ ∈ Finset.univ.erase
      (⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩ : PositiveRoot),
      (chevalleyRootSubgroup ρ M hM hnil γ.val A).range) :
    ∃ u : PositiveRoot → A,
      (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ.val A
        (Multiplicative.ofAdd (u γ))).prod = g := by
  exact (mem_biSup_range_iff_exists_list_prod_map hcomm hl
    (fun γ => by simpa only [Finset.mem_erase, Finset.mem_univ, and_true] using hall γ)).mp
      hg

open scoped Classical in
private theorem collect_punctured_notG2
    [(t.rationalRootSystem ht).IsNotG2] (A : CommAlgCat ℤ) (i : Fin t.rank)
    (l : List PositiveRoot) (hl : l.Nodup)
    (hall : ∀ γ, γ ∈ l ↔ γ ≠ ⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M))
    (hg : g ∈ ⨆ γ ∈ Finset.univ.erase
      (⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩ : PositiveRoot),
      (chevalleyRootSubgroup ρ M hM hnil γ.val A).range) :
    ∃ u : PositiveRoot → A,
      (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ.val A
        (Multiplicative.ofAdd (u γ))).prod = g := by
  classical
  let X (γ : PositiveRoot) := chevalleyRootSubgroup ρ M hM hnil γ.val A
  let S : Finset PositiveRoot := Finset.univ.erase ⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩
  have hcomm (α) (_ : α ∈ S) (β) (_ : β ∈ S) (_ : α ≠ β) :
      ⁅(X α).range, (X β).range⁆ ≤
        ⨆ γ ∈ {γ ∈ S | max ((t.rationalBase ht).height α.val)
          ((t.rationalBase ht).height β.val) < (t.rationalBase ht).height γ.val},
          (X γ).range := by
    refine (commutator_range_chevalleyRootSubgroup_le ρ M hM hnil
      α.property β.property A).trans (iSup₂_le fun γ hγ => ?_)
    obtain ⟨hpos, hheight⟩ := Finset.mem_filter.mp hγ
    have hpos' := (mem_posRootsFinset _ _ _).mp hpos
    have hne : (⟨γ, hpos'⟩ : PositiveRoot) ≠ ⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩ := by
      intro heq
      have hroot : γ = t.simpleIndex ht i := congrArg Subtype.val heq
      have hp := (t.rationalBase ht).isPos_iff.mp ((mem_posRoots _ _ _).mp α.property)
      rw [hroot, (t.rationalBase ht).height_one_of_mem_support
        (simpleIndex_mem_support i)] at hheight
      omega
    exact le_iSup_of_le ⟨γ, hpos'⟩ (le_iSup_of_le
      (Finset.mem_filter.mpr ⟨Finset.mem_erase.mpr ⟨hne, Finset.mem_univ _⟩, hheight⟩) le_rfl)
  exact collect_punctured_of_commutator_bound ρ M hM hnil A i _ hcomm l hl hall g hg

end Punctured

open scoped Classical in
private theorem collect_punctured_G2 {ht : G2.Valid}
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ (G2.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
    (M : AddSubgroup V)
    (hM : ∀ z ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (G2.lieBasis ht).rootGenerator (G2.lieBasis ht).h,
      ∀ v ∈ M, ρ z v ∈ M)
    (hnil : ∀ r, IsNilpotent
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((G2.lieBasis ht).rootGenerator r))))
    (A : CommAlgCat ℤ) (i : Fin G2.rank)
    (l : List {γ // γ ∈ posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht)})
    (hl : l.Nodup) (hall : ∀ γ, γ ∈ l ↔ γ ≠ ⟨G2.simpleIndex ht i, simpleIndex_mem_posRoots i⟩)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M))
    (hg : g ∈ ⨆ γ ∈ Finset.univ.erase
      (⟨G2.simpleIndex ht i, simpleIndex_mem_posRoots i⟩ :
        {γ // γ ∈ posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht)}),
      (chevalleyRootSubgroup ρ M hM hnil γ.val A).range) :
    ∃ u : {γ // γ ∈ posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht)} → A,
      (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ.val A
        (Multiplicative.ofAdd (u γ))).prod = g := by
  classical
  let X (γ : {γ // γ ∈ posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht)}) :=
    chevalleyRootSubgroup ρ M hM hnil γ.val A
  let S := Finset.univ.erase (⟨G2.simpleIndex ht i, simpleIndex_mem_posRoots i⟩ :
      {γ // γ ∈ posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht)})
  let e := g2PositiveRootEquiv ht
  have hcomm (α) (_ : α ∈ S) (β) (_ : β ∈ S) (hne : α ≠ β) :
      ⁅(X α).range, (X β).range⁆ ≤
        ⨆ γ ∈ {γ ∈ S | max (e α) (e β) < e γ}, (X γ).range := by
    let a := e α
    let b := e β
    have hab : a ≠ b := e.injective.ne hne
    have hbound := commutator_range_chevalleyRootSubgroup_g2_le ρ M hM hnil A a b hab
    rw [castAdd_g2PositiveRootEquiv, castAdd_g2PositiveRootEquiv] at hbound
    refine hbound.trans (iSup₂_le fun k hk => ?_)
    let γ := e.symm k
    have hγval : γ.val = Fin.castAdd 6 k := by
      rw [← castAdd_g2PositiveRootEquiv ht γ, ← e.apply_symm_apply k]
    have hk' : max α.val.val β.val.val < k.val := by
      simpa only [Fin.lt_def, Fin.val_max, a, b, e, g2PositiveRootEquiv_apply_val] using hk
    have hγ : γ ≠ ⟨G2.simpleIndex ht i, simpleIndex_mem_posRoots i⟩ := by
      intro heq
      have heq' := congrArg (fun x => x.val.val) heq
      have hi : i.val < 2 := i.isLt
      have hne' : α.val.val ≠ β.val.val := by
        simpa only [a, b, e, g2PositiveRootEquiv_apply_val] using Fin.val_injective.ne hab
      simp only [hγval, val_simpleIndex, Fin.val_castAdd] at heq'
      omega
    refine le_iSup_of_le γ (le_iSup_of_le
      (Finset.mem_filter.mpr ⟨Finset.mem_erase.mpr ⟨hγ, Finset.mem_univ _⟩, by
        simpa only [γ, e.apply_symm_apply] using hk⟩) ?_)
    simp only [X, hγval, le_refl]
  exact collect_punctured_of_commutator_bound ρ M hM hnil A i _ hcomm l hl hall g hg

open scoped Classical in
/-- On a Kostant-stable lattice, every element generated by positive root groups other than
one chosen simple root has ordered product coordinates on those remaining roots. No faithfulness
of the representation or field hypothesis on the value ring is required. -/
theorem exists_prod_of_mem_iSup_punctured_posRoots_chevalleyRootSubgroup
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
    (M : AddSubgroup V)
    (hM : ∀ z ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
      ∀ v ∈ M, ρ z v ∈ M)
    (hnil : ∀ r, IsNilpotent
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator r))))
    (A : CommAlgCat ℤ) (i : Fin t.rank)
    (l : List PositiveRoot) (hl : l.Nodup)
    (hall : ∀ γ, γ ∈ l ↔ γ ≠ ⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M))
    (hg : g ∈ ⨆ γ ∈ Finset.univ.erase
      (⟨t.simpleIndex ht i, simpleIndex_mem_posRoots i⟩ : PositiveRoot),
      (chevalleyRootSubgroup ρ M hM hnil γ.val A).range) :
    ∃ u : PositiveRoot → A,
      (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ.val A
        (Multiplicative.ofAdd (u γ))).prod = g := by
  by_cases htG2 : t = G2
  · subst t
    exact collect_punctured_G2 ρ M hM hnil A i l hl hall g hg
  · have := isNotG2_rationalRootSystem_of_ne_G2 (ht := ht) htG2
    exact collect_punctured_notG2 ρ M hM hnil A i l hl hall g hg

end TauCeti.DynkinType
