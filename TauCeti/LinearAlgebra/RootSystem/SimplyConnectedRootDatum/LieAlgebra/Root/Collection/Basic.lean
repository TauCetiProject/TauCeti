module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.G2

/-!
# Uniform positive-root collection

On any Kostant-stable lattice, the subgroup generated by the positive root subgroups has
ordered product coordinates for every valid Dynkin type over every commutative ring.
Parameters are indexed only by positive roots. This combines
`mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod` outside G₂ with
`mem_biSup_posRoots_g2_iff_exists_list_prod_map` in G₂; no faithfulness is required.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 17.
* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.3.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

attribute [local instance high] Algebra.toModule

variable {t : DynkinType} {ht : t.Valid} {V : Type*} [AddCommGroup V] [Module ℚ V]

-- Reindex the native G₂ collection theorem by positive roots rather than its six-row table.
private theorem exists_prod_of_mem_iSup_G2 {ht : G2.Valid}
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ (G2.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
    (M : AddSubgroup V)
    (hM : ∀ z ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (G2.lieBasis ht).rootGenerator (G2.lieBasis ht).h,
      ∀ v ∈ M, ρ z v ∈ M)
    (hnil : ∀ r, IsNilpotent
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((G2.lieBasis ht).rootGenerator r))))
    (A : CommAlgCat ℤ)
    (l : List (posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht)))
    (hl : l.Nodup) (hcover : ∀ γ, γ ∈ l)
    (q : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M))
    (hq : q ∈ ⨆ γ ∈ posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht),
      (chevalleyRootSubgroup ρ M hM hnil γ A).range) :
    ∃ u : posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht) → A,
      (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ.val A
        (Multiplicative.ofAdd (u γ))).prod = q := by
  let e : posRoots (G2.rationalRootSystem ht) (G2.rationalBase ht) ≃ Fin 6 :=
    { toFun := fun γ => ⟨γ.val.val, (mem_posRoots_rational_g2_iff ht γ.val).mp γ.property⟩
      invFun := fun i => ⟨Fin.castAdd 6 i, (mem_posRoots_rational_g2_iff ht _).mpr i.isLt⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  obtain ⟨u, hu⟩ := (mem_biSup_posRoots_g2_iff_exists_list_prod_map ρ M hM hnil A
    (l.map e) (hl.map e.injective)
    (fun i => List.mem_map.mpr ⟨e.symm i, hcover _, e.apply_symm_apply i⟩) q).mp hq
  have he (γ) : Fin.castAdd 6 (e γ) = γ.val := Fin.ext rfl
  exact ⟨fun γ => u (e γ), by simpa only [List.map_map, Function.comp_def, he] using hu⟩

/-- For every valid Dynkin type, membership in the subgroup generated by the positive root
subgroups is equivalent to an ordered product with one parameter per positive root.
The lattice need only be Kostant-stable, and the value ring is arbitrary. -/
theorem mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_prod
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
    (M : AddSubgroup V)
    (hM : ∀ z ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
      ∀ v ∈ M, ρ z v ∈ M)
    (hnil : ∀ r, IsNilpotent
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator r))))
    (A : CommAlgCat ℤ)
    (l : List (posRoots (t.rationalRootSystem ht) (t.rationalBase ht)))
    (hl : l.Nodup) (hcover : ∀ γ, γ ∈ l)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    g ∈ ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (chevalleyRootSubgroup ρ M hM hnil γ A).range ↔
      ∃ u : posRoots (t.rationalRootSystem ht) (t.rationalBase ht) → A,
        (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ.val A
          (Multiplicative.ofAdd (u γ))).prod = g := by
  constructor
  · intro hg
    by_cases hG2 : t = G2
    · subst t
      exact exists_prod_of_mem_iSup_G2 ρ M hM hnil A l hl hcover g hg
    · have := isNotG2_rationalRootSystem_of_ne_G2 (ht := ht) hG2
      have hlist : ∀ γ, γ ∈ l.map Subtype.val ↔
          γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) := by
        intro γ
        simp only [List.mem_map]
        exact ⟨fun ⟨δ, _, hδ⟩ => hδ ▸ δ.property,
          fun hγ => ⟨⟨γ, hγ⟩, hcover _, rfl⟩⟩
      obtain ⟨u, hu⟩ := (mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_list_prod
        ρ M hM hnil A (l.map Subtype.val) (hl.map Subtype.val_injective) hlist g).mp hg
      exact ⟨fun γ => u γ.val, by simpa only [List.map_map, Function.comp_def] using hu⟩
  · rintro ⟨u, rfl⟩
    apply Subgroup.list_prod_mem
    intro x hx
    obtain ⟨γ, _, rfl⟩ := List.mem_map.mp hx
    exact Subgroup.mem_iSup_of_mem γ.val (Subgroup.mem_iSup_of_mem γ.property ⟨_, rfl⟩)

end TauCeti.DynkinType
