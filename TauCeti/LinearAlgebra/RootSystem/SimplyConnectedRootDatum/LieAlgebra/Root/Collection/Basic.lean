module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.G2
import TauCeti.Algebra.Group.Subgroup.OrderedProduct

/-!
# Uniform positive-root commutator height bounds and ordered collection

On any Kostant-stable lattice and across every valid Dynkin type, commutators of positive root
subgroups lie in the join of positive root subgroups of strictly greater root height over every
commutative ring. Consequently, the subgroup generated by any upper height set
`{γ ∈ Φ⁺ | H ≤ height γ}` — and in particular the subgroup generated by all positive root subgroups
(`H = 1`) — consists of the ordered products with one parameter per root in any duplicate-free
enumeration.

This unifies `commutator_range_chevalleyRootSubgroup_le` outside `G₂` with the six-root commutator
filtration `commutator_range_chevalleyRootSubgroup_g2_le` and root-height formula
`height_rationalBase_G2_castAdd` in `G₂`; no faithfulness, full-weight, or characteristic
hypothesis is required, and uniqueness of the ordered parameters is not asserted here.

## Main results

* `TauCeti.DynkinType.commutator_range_chevalleyRootSubgroup_le_iSup_height`: commutators of
  positive root subgroups strictly raise root height for every valid Dynkin type.
* `TauCeti.DynkinType.mem_iSup_le_height_chevalleyRootSubgroup_iff_exists_prod`: ordered-product
  collection for any upper height set `{γ ∈ Φ⁺ | H ≤ height γ}`.
* `TauCeti.DynkinType.mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_prod`: ordered-product
  collection for all positive roots, indexed by the positive-root subtype.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemmas 15 and 17.
* R. W. Carter, *Simple Groups of Lie Type*, Theorems 5.2.2 and 5.3.3.
-/

public section

namespace TauCeti.DynkinType

open scoped commutatorElement
open TensorProduct TauCeti.UniversalEnvelopingAlgebra

attribute [local instance high] Algebra.toModule

variable {t : DynkinType} {ht : t.Valid} {V : Type*} [AddCommGroup V] [Module ℚ V]

/-- Across every valid Dynkin type, commutators of positive root subgroups on any Kostant-stable
lattice lie in the join of positive root subgroups of strictly greater root height, over every
commutative value ring. -/
theorem commutator_range_chevalleyRootSubgroup_le_iSup_height
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
    (M : AddSubgroup V)
    (hM : ∀ z ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
      ∀ v ∈ M, ρ z v ∈ M)
    (hnil : ∀ r, IsNilpotent
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator r))))
    {α β : Fin t.numRoots}
    (hα : α ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hβ : β ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (A : CommAlgCat ℤ) :
    ⁅(chevalleyRootSubgroup ρ M hM hnil α A).range,
      (chevalleyRootSubgroup ρ M hM hnil β A).range⁆ ≤
      ⨆ γ ∈ {γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
          (t.rationalBase ht).height γ},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range := by
  classical
  by_cases hαβ : α = β
  · subst β
    rw [Subgroup.commutator_self_eq_bot_iff.mpr (by infer_instance)]
    exact bot_le
  · by_cases hG2 : t = G2
    · subst t
      let α₆ : Fin 6 := ⟨α.val, (mem_posRoots_rational_g2_iff ht α).mp hα⟩
      let β₆ : Fin 6 := ⟨β.val, (mem_posRoots_rational_g2_iff ht β).mp hβ⟩
      have hαβ₆ : α₆ ≠ β₆ := fun h => hαβ (Fin.ext (congrArg (fun x : Fin 6 => x.val) h))
      -- `G2.numRoots` is definitionally `6 + 6`, so `Fin.castAdd 6` embeds `Fin 6` into it.
      have hα_cast : (Fin.castAdd 6 α₆ : Fin G2.numRoots) = α := Fin.ext rfl
      have hβ_cast : (Fin.castAdd 6 β₆ : Fin G2.numRoots) = β := Fin.ext rfl
      have hcomm := commutator_range_chevalleyRootSubgroup_g2_le ρ M hM hnil A α₆ β₆ hαβ₆
      rw [hα_cast, hβ_cast] at hcomm
      refine hcomm.trans (iSup₂_le fun k hk =>
        le_iSup₂_of_le (Fin.castAdd 6 k : Fin G2.numRoots) ?_ le_rfl)
      refine Finset.mem_filter.mpr
        ⟨(mem_posRootsFinset _ _ _).mpr ((mem_posRoots_rational_g2_iff ht _).mpr k.isLt), ?_⟩
      rw [← hα_cast, ← hβ_cast, height_rationalBase_G2_castAdd ht α₆,
        height_rationalBase_G2_castAdd ht β₆, height_rationalBase_G2_castAdd ht k]
      have hne : (α₆ : ℕ) ≠ (β₆ : ℕ) := Fin.val_ne_of_ne hαβ₆
      have hlt1 : (α₆ : ℕ) < (k : ℕ) := lt_of_le_of_lt (le_max_left α₆ β₆) hk
      have hlt2 : (β₆ : ℕ) < (k : ℕ) := lt_of_le_of_lt (le_max_right α₆ β₆) hk
      omega
    · have := isNotG2_rationalRootSystem_of_ne_G2 (ht := ht) hG2
      exact commutator_range_chevalleyRootSubgroup_le ρ M hM hnil hα hβ A

/-- For every valid Dynkin type and any height bound `H`, the join of positive root subgroups of
height at least `H` on a Kostant-stable lattice consists of the ordered products in any
duplicate-free enumeration of those roots, over every commutative ring. -/
theorem mem_iSup_le_height_chevalleyRootSubgroup_iff_exists_prod
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
    (M : AddSubgroup V)
    (hM : ∀ z ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
      ∀ v ∈ M, ρ z v ∈ M)
    (hnil : ∀ r, IsNilpotent
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator r))))
    (H : ℤ) (A : CommAlgCat ℤ) (l : List (Fin t.numRoots)) (hl : l.Nodup)
    (hcover : ∀ γ, γ ∈ l ↔
      γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) ∧
        H ≤ (t.rationalBase ht).height γ)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    g ∈ (⨆ γ ∈ {γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        H ≤ (t.rationalBase ht).height γ},
          (chevalleyRootSubgroup ρ M hM hnil γ A).range) ↔
      ∃ u : Fin t.numRoots → A,
        (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ A
          (Multiplicative.ofAdd (u γ))).prod = g := by
  classical
  let S := {γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
    H ≤ (t.rationalBase ht).height γ}
  have hcomm : ∀ α ∈ S, ∀ β ∈ S, α ≠ β →
      ⁅(chevalleyRootSubgroup ρ M hM hnil α A).range,
        (chevalleyRootSubgroup ρ M hM hnil β A).range⁆ ≤
        ⨆ γ ∈ {γ ∈ S | max ((t.rationalBase ht).height α) ((t.rationalBase ht).height β) <
          (t.rationalBase ht).height γ},
          (chevalleyRootSubgroup ρ M hM hnil γ A).range := by
    intro α hα β hβ _
    have hα' := Finset.mem_filter.mp hα
    have hβ' := Finset.mem_filter.mp hβ
    refine (commutator_range_chevalleyRootSubgroup_le_iSup_height ρ M hM hnil
      ((mem_posRootsFinset _ _ α).mp hα'.1) ((mem_posRootsFinset _ _ β).mp hβ'.1) A).trans ?_
    refine iSup₂_le fun γ hγ => le_iSup₂_of_le γ ?_ le_rfl
    have hγ' := Finset.mem_filter.mp hγ
    exact Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr
      ⟨hγ'.1, hα'.2.trans ((le_max_left _ _).trans hγ'.2.le)⟩, hγ'.2⟩
  have hlS : ∀ γ, γ ∈ l ↔ γ ∈ S := fun γ => by
    simp only [S, Finset.mem_filter, mem_posRootsFinset, hcover]
  exact TauCeti.mem_biSup_range_iff_exists_list_prod_map hcomm hl hlS

/-- For every valid Dynkin type, membership in the subgroup generated by the positive root
subgroups is equivalent to an ordered product with one parameter per positive root.
The lattice need only be Kostant-stable, and the value ring is arbitrary. -/
theorem mem_iSup_posRoots_chevalleyRootSubgroup_iff_exists_prod
    (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
    (M : AddSubgroup V)
    (hM : ∀ z ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
      ∀ v ∈ M, ρ z v ∈ M)
    (hnil : ∀ r, IsNilpotent
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator r))))
    (A : CommAlgCat ℤ)
    (l : List (posRoots (t.rationalRootSystem ht) (t.rationalBase ht)))
    (hl : l.Nodup) (hcover : ∀ γ, γ ∈ l)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    g ∈ ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (chevalleyRootSubgroup ρ M hM hnil γ A).range ↔
      ∃ u : posRoots (t.rationalRootSystem ht) (t.rationalBase ht) → A,
        (l.map fun γ => chevalleyRootSubgroup ρ M hM hnil γ.val A
          (Multiplicative.ofAdd (u γ))).prod = g := by
  classical
  have hwhole : (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
      (chevalleyRootSubgroup ρ M hM hnil γ A).range) =
      ⨆ γ ∈ {γ ∈ posRootsFinset (t.rationalRootSystem ht) (t.rationalBase ht) |
        1 ≤ (t.rationalBase ht).height γ},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range := by
    apply le_antisymm
    · refine iSup₂_le fun γ hγ => le_iSup₂_of_le γ ?_ le_rfl
      exact Finset.mem_filter.mpr ⟨(mem_posRootsFinset _ _ γ).mpr hγ,
        one_le_height_of_mem_posRoots _ _ hγ⟩
    · refine iSup₂_le fun γ hγ => le_iSup₂_of_le γ ?_ le_rfl
      exact (mem_posRootsFinset _ _ γ).mp (Finset.mem_filter.mp hγ).1
  have hlist : ∀ γ, γ ∈ l.map Subtype.val ↔
      γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) ∧
        1 ≤ (t.rationalBase ht).height γ := by
    intro γ
    simp only [List.mem_map]
    exact ⟨fun ⟨δ, _, hδ⟩ => hδ ▸ ⟨δ.property, one_le_height_of_mem_posRoots _ _ δ.property⟩,
      fun ⟨hγ, _⟩ => ⟨⟨γ, hγ⟩, hcover _, rfl⟩⟩
  rw [hwhole, mem_iSup_le_height_chevalleyRootSubgroup_iff_exists_prod
    ρ M hM hnil 1 A (l.map Subtype.val) (hl.map Subtype.val_injective) hlist]
  constructor
  · rintro ⟨u, hu⟩
    exact ⟨fun γ => u γ.val, by simpa only [List.map_map, Function.comp_def] using hu⟩
  · rintro ⟨u, rfl⟩
    refine ⟨fun γ =>
      if h : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) then u ⟨γ, h⟩ else 0, ?_⟩
    simp only [List.map_map, Function.comp_def]
    exact congrArg List.prod (List.map_congr_left fun γ _ => by simp only [dite_eq_left γ.property])

end TauCeti.DynkinType
