module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Subgroup
import TauCeti.Algebra.Group.Subgroup.Pointwise

/-!
# Simple Weyl elements and positive root subgroups

A simple Weyl representative permutes the root subgroups according to its root reflection.
In particular it normalizes the subgroup generated by all positive root subgroups except its
own simple root subgroup. Conjugating the whole positive-root subgroup replaces that one root
subgroup by its negative and leaves the punctured subgroup unchanged. These are the
positive-root conjugation identities used in the rank-one reduction of the Bruhat decomposition.

If a positive simple root subgroup normalizes the punctured positive subgroup, then its opposite
also normalizes that subgroup, and every positive element factors as a punctured-positive element
followed by an element of the chosen simple root subgroup.

The results hold on any lattice stable under the simple-generator Kostant form, provided the
simple root operators act nilpotently, over every commutative value ring. No faithfulness,
weight basis, or assertion that positive simple root subgroups generate all positive root
subgroups is needed. The generated subgroups are written as suprema of root-subgroup ranges.

We use the signed conjugation formula of
`TauCeti.DynkinType.kostantWeylGL_conj_chevalleyRootSubgroup` and the root-set permutation
`TauCeti.bijOn_reflectionPerm_posRoots_diff_singleton`. Signs disappear on subgroup ranges
because multiplication by a sign is bijective even in bad characteristic.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §8.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

noncomputable section

variable {t : DynkinType} {ht : t.Valid}

variable {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
  ∀ v ∈ M, ρ u v ∈ M)
variable (hnil : ∀ i, IsNilpotent
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

-- Match the tensor product to the integral algebra structure of the value ring.
attribute [local instance high] Algebra.toModule

/-- A simple Weyl representative normalizes the subgroup generated by the positive root
subgroups other than its own. Positivity is measured in the pinned rational base. -/
theorem kostantWeylGL_mem_normalizer_posRoots_diff_singleton
    (i : Fin t.rank) (A : CommAlgCat ℤ) :
    kostantWeylGL (t.lieBasis ht).rootGenerator (t.lieBasis ht).h ρ M hM
        (hnil (.inl i)) (hnil (.inr i)) A ∈
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) := by
  rw [Subgroup.mem_normalizer_iff_map_conj_eq,
    map_iSup_chevalleyRootSubgroup_conj_kostantWeylGL]
  have hperm := (bijOn_reflectionPerm_posRoots_diff_singleton
    (t.rationalRootSystem ht) (t.rationalBase ht) (simpleIndex_mem_support i)).image_eq
  rw [reflectionPerm_rationalRootSystem] at hperm
  rw [hperm]

/-- Conjugating the group generated by all positive root subgroups by a simple Weyl
representative leaves its punctured positive subgroup fixed and replaces the missing simple
root subgroup by its negative. This is an equality of generated subgroups, not an assertion
that the two factors commute or have already been collected into a product. -/
theorem map_iSup_posRoots_chevalleyRootSubgroup_conj_kostantWeylGL
    (i : Fin t.rank) (A : CommAlgCat ℤ) :
    Subgroup.map (MulAut.conj (kostantWeylGL (t.lieBasis ht).rootGenerator
        (t.lieBasis ht).h ρ M hM (hnil (.inl i)) (hnil (.inr i)) A))
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
        (chevalleyRootSubgroup ρ M hM hnil γ A).range) =
    (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
      (chevalleyRootSubgroup ρ M hM hnil γ A).range) ⊔
    (chevalleyRootSubgroup ρ M hM hnil
      ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
        (t.simpleIndex ht i)) A).range := by
  conv_lhs => rw [posRoots_eq_diff_union_simpleIndex i, iSup_union]
  simp only [iSup_singleton, Subgroup.map_sup,
    map_range_chevalleyRootSubgroup_conj_kostantWeylGL,
    (Subgroup.mem_normalizer_iff_map_conj_eq.mp
      (kostantWeylGL_mem_normalizer_posRoots_diff_singleton ρ M hM hnil i A))]

/-- If a positive simple root subgroup normalizes the punctured positive subgroup, then so
does its opposite root subgroup. -/
theorem closure_simpleRootPair_le_normalizer_posRoots_diff_singleton_of_le_normalizer
    (i : Fin t.rank) (A : CommAlgCat ℤ)
    (hpos : (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _)) :
    Subgroup.closure
      (Set.range (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A) ∪
        Set.range (chevalleyRootSubgroup ρ M hM hnil
          ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
            (t.simpleIndex ht i)) A)) ≤
    Subgroup.normalizer
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) := by
  set U : Subgroup _ := ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \
      {t.simpleIndex ht i}, (chevalleyRootSubgroup ρ M hM hnil γ A).range
  let w := kostantWeylGL (t.lieBasis ht).rootGenerator (t.lieBasis ht).h ρ M hM
    (hnil (.inl i)) (hnil (.inr i)) A
  have hw : U.map (MulAut.conj w) = U :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp
      (kostantWeylGL_mem_normalizer_posRoots_diff_singleton ρ M hM hnil i A)
  rw [← MonoidHom.coe_range, ← MonoidHom.coe_range, ← Subgroup.sup_eq_closure]
  refine sup_le hpos ?_
  rw [← map_range_chevalleyRootSubgroup_conj_kostantWeylGL ρ M hM hnil i]
  exact (Subgroup.map_mono hpos).trans (by
    have H := Subgroup.le_normalizer_map (H := U) (MulAut.conj w).toMonoidHom
    simpa only [MulEquiv.toMonoidHom_eq_coe, hw] using H)

/-- If a simple root subgroup normalizes the subgroup of the other positive roots, every
positive element factors as a punctured-positive element followed by a simple-root element.
No uniqueness or generation of the ambient group is assumed. -/
theorem mem_iSup_posRoots_iff_exists_posRoots_diff_singleton_mul_of_le_normalizer
    (i : Fin t.rank) (A : CommAlgCat ℤ)
    (hpos : (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _))
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    g ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
      (chevalleyRootSubgroup ρ M hM hnil γ A).range) ↔
    ∃ v ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \
        {t.simpleIndex ht i}, (chevalleyRootSubgroup ρ M hM hnil γ A).range),
      ∃ u : Multiplicative A,
        g = v * chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A u := by
  conv_lhs => rw [posRoots_eq_diff_union_simpleIndex i, iSup_union, iSup_singleton]
  rw [Subgroup.mem_sup_of_right_le_normalizer_left hpos]
  simp only [MonoidHom.mem_range, exists_exists_eq_and]
  simp only [eq_comm]

end

end TauCeti.DynkinType
