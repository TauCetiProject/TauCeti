module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Positive
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2
import TauCeti.Algebra.Group.Subgroup.Pointwise

/-!
# Punctured positive subgroups outside type G₂

For every valid type whose rational root system satisfies `RootPairing.IsNotG2`, the positive
and negative simple root groups normalize the subgroup generated by all positive roots except
that simple root. Consequently its positive subgroup factors as the punctured subgroup times
the omitted root group. These are the rank-one reduction inputs to Bruhat decomposition.
Types B, C and F₄ satisfy the hypothesis through the instances in
`TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.NotG2`; simply-laced types use
`TauCeti.DynkinType.isNotG2_rationalRootSystem_of_isSimplyLaced`.

The representation may be any Kostant-stable lattice with nilpotent simple root operators;
the value ring is arbitrary, including characteristic two and nonreduced rings. Neither
coordinate uniqueness nor equality with the full group of scheme points is asserted.

The proof uses the height-raising commutator bound
`commutator_range_chevalleyRootSubgroup_le` and the signed Weyl range transport in
`map_range_chevalleyRootSubgroup_conj_kostantWeylGL`. No structure constant is inverted
in the value ring.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 8.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

noncomputable section

variable {t : DynkinType} {ht : t.Valid}
variable {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
  (M : AddSubgroup V)
  (hM : ∀ u ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
    ∀ v ∈ M, ρ u v ∈ M)
  (hnil : ∀ i, IsNilpotent
    (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

-- Use the integral scalar action stored by the value-ring object in the tensor product.
attribute [local instance high] Algebra.toModule

/-- Outside type G₂, the opposite simple-root pair normalizes the subgroup generated by all
other positive roots, over every commutative value ring. -/
theorem closure_simpleRootPair_le_normalizer_posRoots_diff_singleton
    [(t.rationalRootSystem ht).IsNotG2] (i : Fin t.rank) (A : CommAlgCat ℤ) :
    Subgroup.closure
      (Set.range (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A) ∪
        Set.range (chevalleyRootSubgroup ρ M hM hnil
          ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
            (t.simpleIndex ht i)) A)) ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) := by
  classical
  let U := ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
    (chevalleyRootSubgroup ρ M hM hnil γ A).range
  have hp : (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer (U : Set _) := by
    dsimp only [U]
    rw [← iSup_subtype'']
    apply Subgroup.le_normalizer_iSup_of_commutator_le
    intro γ
    rw [iSup_subtype]
    refine (commutator_range_chevalleyRootSubgroup_le ρ M hM hnil
      (simpleIndex_mem_posRoots i) γ.property.1 A).trans ?_
    refine iSup₂_mono' fun δ hδ => ?_
    obtain ⟨hδpos, hδheight⟩ := Finset.mem_filter.mp hδ
    refine ⟨δ, ⟨(mem_posRootsFinset _ _ _).mp hδpos, ?_⟩, le_rfl⟩
    intro heq
    have heq := Set.mem_singleton_iff.mp heq
    have hsimple := RootPairing.Base.height_one_of_mem_support
      (simpleIndex_mem_support (ht := ht) i)
    have hγ := one_le_height_of_mem_posRoots _ _ γ.property.1
    rw [heq, hsimple] at hδheight
    omega
  -- Conjugate positive-root normalization by the simple Weyl element to obtain the negative.
  have hw := kostantWeylGL_mem_normalizer_posRoots_diff_singleton ρ M hM hnil i A
  have hn := (Subgroup.map_mono hp).trans
    (Subgroup.le_normalizer_map (H := U)
      (MulAut.conj (kostantWeylGL (t.lieBasis ht).rootGenerator (t.lieBasis ht).h
        ρ M hM (hnil (.inl i)) (hnil (.inr i)) A)).toMonoidHom)
  simp only [MulEquiv.toMonoidHom_eq_coe] at hn
  rw [map_range_chevalleyRootSubgroup_conj_kostantWeylGL,
    Subgroup.mem_normalizer_iff_map_conj_eq.mp hw] at hn
  exact (Subgroup.closure_le _).mpr (Set.union_subset hp hn)

/-- Outside type G₂, every element generated by the positive roots factors as a
punctured-positive element followed by an element of a prescribed simple root group.
No coordinate uniqueness is assumed. -/
theorem mem_iSup_posRoots_iff_exists_posRoots_diff_singleton_mul
    [(t.rationalRootSystem ht).IsNotG2] (i : Fin t.rank) (A : CommAlgCat ℤ)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    g ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
      (chevalleyRootSubgroup ρ M hM hnil γ A).range) ↔
      ∃ q ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range),
        ∃ u, g = q * chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A u := by
  have hnorm : (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) :=
    (Set.subset_union_left.trans Subgroup.subset_closure).trans
      (closure_simpleRootPair_le_normalizer_posRoots_diff_singleton ρ M hM hnil i A)
  conv_lhs => rw [posRoots_eq_diff_union_simpleIndex i, iSup_union, iSup_singleton]
  rw [Subgroup.mem_sup_of_right_le_normalizer_left hnorm]
  constructor
  · rintro ⟨q, hq, _, ⟨u, rfl⟩, heq⟩
    exact ⟨q, hq, u, heq.symm⟩
  · rintro ⟨q, hq, u, heq⟩
    exact ⟨q, hq, _, ⟨u, rfl⟩, heq.symm⟩

end

end TauCeti.DynkinType
