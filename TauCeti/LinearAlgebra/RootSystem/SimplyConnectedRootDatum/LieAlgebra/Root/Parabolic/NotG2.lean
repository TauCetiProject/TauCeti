module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Positive
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.NotG2
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2
import TauCeti.GroupTheory.Commutator

/-!
# Rank-one normalization of punctured positive subgroups outside G₂

For a simple root αᵢ, let Uᵢ be generated by the positive root subgroups other than Xᵢ.
On a Kostant-stable lattice with nilpotent simple root operators, the opposite pair
Xᵢ, X₋ᵢ normalizes Uᵢ whenever the rational root system satisfies `IsNotG2`.
This includes types B and C in every valid rank, over any commutative value ring.

The positive-root bound uses the height-raising commutator theorem
`TauCeti.DynkinType.commutator_range_chevalleyRootSubgroup_le`.
The negative-root bound follows from the simple-Weyl reduction in
`TauCeti.DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton_of_le_normalizer`.
The public positive-simple-root bound also supplies the hypothesis of
`TauCeti.DynkinType.mem_iSup_posRoots_iff_exists_posRoots_diff_singleton_mul_of_le_normalizer`,
giving the factorization U = Uᵢ Xᵢ used in the simple-reflection reduction of Bruhat decomposition.
No global Bruhat or ambient point-generation theorem is assumed.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 8.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

noncomputable section

variable {t : DynkinType} {ht : t.Valid}
variable {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ z ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm
  (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
  ∀ v ∈ M, ρ z v ∈ M)
variable (hnil : ∀ i, IsNilpotent
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

-- Match the tensor product to the integral algebra structure of the value ring.
attribute [local instance high] Algebra.toModule

/-- Outside G₂, a positive simple root subgroup normalizes the subgroup of the other positive
roots on any Kostant-stable lattice with nilpotent simple root operators, over every
commutative value ring. This bound can be used directly for punctured-positive factorization. -/
theorem range_simpleIndex_le_normalizer_posRoots_diff_singleton_of_isNotG2
    [(t.rationalRootSystem ht).IsNotG2] (i : Fin t.rank) (A : CommAlgCat ℤ) :
    (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) := by
  rw [iSup_subtype']
  apply Subgroup.le_normalizer_iSup_of_commutator_le
  rintro ⟨γ, hγ⟩
  have hcomm := commutator_range_chevalleyRootSubgroup_le ρ M hM hnil
    (simpleIndex_mem_posRoots i) hγ.1 A
  refine hcomm.trans ?_
  rw [iSup_subtype]
  refine iSup₂_le fun δ hδ => le_iSup_of_le δ (le_iSup_of_le ?_ le_rfl)
  obtain ⟨hδpos, hheight⟩ := Finset.mem_filter.mp hδ
  refine ⟨(mem_posRootsFinset _ _ _).mp hδpos, ?_⟩
  intro heq
  simp only [Set.mem_singleton_iff] at heq
  rw [heq] at hheight
  omega

/-- Outside G₂, the positive and negative simple root subgroups together normalize the subgroup
of the other positive roots. The lattice is Kostant-stable with nilpotent simple root operators;
the value ring is an arbitrary commutative ring. -/
theorem closure_simpleRootPair_le_normalizer_posRoots_diff_singleton_of_isNotG2
    [(t.rationalRootSystem ht).IsNotG2] (i : Fin t.rank) (A : CommAlgCat ℤ) :
    Subgroup.closure
      (Set.range (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A) ∪
        Set.range (chevalleyRootSubgroup ρ M hM hnil
          ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
            (t.simpleIndex ht i)) A)) ≤
    Subgroup.normalizer
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) := by
  exact closure_simpleRootPair_le_normalizer_posRoots_diff_singleton_of_le_normalizer
    ρ M hM hnil i A
    (range_simpleIndex_le_normalizer_posRoots_diff_singleton_of_isNotG2 ρ M hM hnil i A)

end

end TauCeti.DynkinType
