module

public import Mathlib.LinearAlgebra.RootSystem.Finite.G2
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Positive
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Collection.NotG2
import TauCeti.GroupTheory.Commutator

/-!
# Rank-one normalization of punctured positive subgroups outside G₂

When `(t.rationalRootSystem ht).IsNotG2` holds, removing any simple root `αᵢ` from the positive
roots produces a subgroup `U^{(i)}` of `GL_A(A ⊗ M)` normalized by the entire positive subgroup and
by the opposite root pair `X_{αᵢ}`, `X_{-αᵢ}`. Every element of the positive subgroup factors as an
element of `U^{(i)}` followed by an element of `X_{αᵢ}`.

Commutators of positive root subgroups strictly raise root height by
`TauCeti.DynkinType.commutator_range_chevalleyRootSubgroup_le`, so no commutator can land in the
omitted simple root subgroup of height one. Conjugating by the simple Weyl representative then
extends normalization to `X_{-αᵢ}` via
`TauCeti.DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton_of_le_normalizer`.
The results hold over every commutative value ring without characteristic restrictions.

## Main declarations

* `TauCeti.DynkinType.iSup_posRoots_le_normalizer_posRoots_diff_singleton_of_isNotG2`: the positive
  subgroup normalizes `U^{(i)}`.
* `TauCeti.DynkinType.closure_simpleRootPair_le_normalizer_posRoots_diff_singleton_of_isNotG2`:
  the opposite simple-root pair normalizes `U^{(i)}`.
* `TauCeti.DynkinType.mem_iSup_posRoots_iff_exists_posRoots_diff_singleton_mul_of_isNotG2`:
  every positive element factors in `U^{(i)} X_{αᵢ}`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.3 and 8.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

noncomputable section

variable {t : DynkinType} {ht : t.Valid}
variable {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ z ∈ UniversalEnvelopingAlgebra.kostantForm
  (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
  ∀ v ∈ M, ρ z v ∈ M)
variable (hnil : ∀ i, IsNilpotent
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

-- Match the tensor product to the integral algebra structure of the value ring.
attribute [local instance high] Algebra.toModule

/-- Outside `G₂`, the subgroup generated by all positive root subgroups normalizes the subgroup
generated by all positive roots other than a chosen simple root, over every commutative ring. -/
theorem iSup_posRoots_le_normalizer_posRoots_diff_singleton_of_isNotG2
    [(t.rationalRootSystem ht).IsNotG2] (i : Fin t.rank) (A : CommAlgCat ℤ) :
    (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
      (chevalleyRootSubgroup ρ M hM hnil γ A).range) ≤
    Subgroup.normalizer
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) := by
  refine iSup₂_le fun α hα => ?_
  rw [iSup_subtype']
  apply Subgroup.le_normalizer_iSup_of_commutator_le
  rintro ⟨γ, hγ⟩
  refine (commutator_range_chevalleyRootSubgroup_le ρ M hM hnil hα hγ.1 A).trans ?_
  rw [iSup_subtype]
  refine iSup₂_le fun δ hδ => le_iSup_of_le δ (le_iSup_of_le ?_ le_rfl)
  simp only [Finset.mem_filter, mem_posRootsFinset] at hδ
  refine ⟨hδ.1, ?_⟩
  intro heq
  have hαpos := one_le_height_of_mem_posRoots (t.rationalRootSystem ht) (t.rationalBase ht) hα
  have hi : (t.rationalBase ht).height (t.simpleIndex ht i) = 1 :=
    RootPairing.Base.height_one_of_mem_support (simpleIndex_mem_support i)
  have hlt := lt_of_le_of_lt (le_max_left _ _) hδ.2
  rw [heq, hi] at hlt
  omega

private theorem range_simpleIndex_le_normalizer_posRoots_diff_singleton_of_isNotG2
    [(t.rationalRootSystem ht).IsNotG2] (i : Fin t.rank) (A : CommAlgCat ℤ) :
    (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) :=
  (le_iSup₂_of_le (t.simpleIndex ht i) (simpleIndex_mem_posRoots (ht := ht) i) le_rfl).trans
    (iSup_posRoots_le_normalizer_posRoots_diff_singleton_of_isNotG2 ρ M hM hnil i A)

/-- Outside `G₂`, the opposite simple-root pair normalizes the punctured positive subgroup over
every commutative value ring. -/
theorem closure_simpleRootPair_le_normalizer_posRoots_diff_singleton_of_isNotG2
    [(t.rationalRootSystem ht).IsNotG2] (i : Fin t.rank) (A : CommAlgCat ℤ) :
    Subgroup.closure
      (Set.range (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A) ∪
        Set.range (chevalleyRootSubgroup ρ M hM hnil
          ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
            (t.simpleIndex ht i)) A)) ≤
    Subgroup.normalizer
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) :=
  closure_simpleRootPair_le_normalizer_posRoots_diff_singleton_of_le_normalizer ρ M hM hnil i A
    (range_simpleIndex_le_normalizer_posRoots_diff_singleton_of_isNotG2 ρ M hM hnil i A)

/-- Outside `G₂`, every element of the positive subgroup factors as an element of the punctured
positive subgroup followed by an element of the chosen simple root subgroup. -/
theorem mem_iSup_posRoots_iff_exists_posRoots_diff_singleton_mul_of_isNotG2
    [(t.rationalRootSystem ht).IsNotG2] (i : Fin t.rank) (A : CommAlgCat ℤ)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    g ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
      (chevalleyRootSubgroup ρ M hM hnil γ A).range) ↔
    ∃ v ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range),
      ∃ u : Multiplicative A,
        g = v * chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A u :=
  mem_iSup_posRoots_iff_exists_posRoots_diff_singleton_mul_of_le_normalizer ρ M hM hnil i A
    (range_simpleIndex_le_normalizer_posRoots_diff_singleton_of_isNotG2 ρ M hM hnil i A) g

end

end TauCeti.DynkinType
