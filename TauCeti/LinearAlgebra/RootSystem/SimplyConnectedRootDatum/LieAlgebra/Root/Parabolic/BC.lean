module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Positive
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Commutator.Basic
import TauCeti.LinearAlgebra.RootSystem.Finite.PositiveCombinations
import TauCeti.Algebra.Group.Subgroup.Pointwise

/-!
# Punctured positive subgroups in types B and C

For every valid classical doubly-laced type, the positive and negative simple root groups
normalize the subgroup generated by all positive roots except that simple root. Consequently
its positive subgroup factors as the punctured subgroup times the omitted root group. These
are the rank-one reduction inputs to Bruhat decomposition.

The representation may be any Kostant-stable lattice with nilpotent simple root operators;
the value ring is arbitrary, including characteristic two and nonreduced rings. Neither
coordinate uniqueness nor equality with the full group of scheme points is asserted.

The proof uses the native integral Chevalley commutator formulas and the signed Weyl range
transport in `map_range_chevalleyRootSubgroup_conj_kostantWeylGL`. Rational root strings only
determine which integral formula applies; no structure constant is inverted in the value ring.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 8.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra
open scoped commutatorElement

noncomputable section

variable {t : DynkinType} {ht : t.Valid}
variable {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
  (M : AddSubgroup V)
  (hM : ∀ u ∈ kostantForm (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
    ∀ v ∈ M, ρ u v ∈ M)
  (hnil : ∀ i, IsNilpotent
    (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

-- Use the integral scalar action stored by the value-ring object in the tensor product.
attribute [local instance high] Algebra.toModule

private theorem positive_commutator_mem_punctured
    [(t.rationalRootSystem ht).IsNotG2]
    (i : Fin t.rank) {α β : Fin t.numRoots}
    (hα : α ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (hβ : β ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
    (A : CommAlgCat ℤ) (u v : A) :
    ⁅chevalleyRootSubgroup ρ M hM hnil α A (Multiplicative.ofAdd u),
      chevalleyRootSubgroup ρ M hM hnil β A (Multiplicative.ofAdd v)⁆ ∈
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) := by
  let P := t.rationalRootSystem ht
  let b := t.rationalBase ht
  let R := t.simplyConnectedRootDatum ht
  let U := ⨆ γ ∈ posRoots P b \ {t.simpleIndex ht i},
    (chevalleyRootSubgroup ρ M hM hnil γ A).range
  have hcast (a c d : Fin t.numRoots) (n : ℕ) :
      P.root d = n • P.root a + P.root c ↔ R.root d = n • R.root a + R.root c := by
    simpa only [P, R, Int.cast_natCast, Nat.cast_smul_eq_nsmul, natCast_zsmul, add_comm] using
      t.root_rationalRootSystem_eq_add_zsmul_iff ht a c d n
  have hsum_mem {a c d : Fin t.numRoots}
      (ha : a ∈ posRoots P b) (hc : c ∈ posRoots P b)
      (hd : P.root d = P.root a + P.root c) :
      ∀ w, chevalleyRootSubgroup ρ M hM hnil d A w ∈ U := by
    have hdpos := add_mem_posRoots P b ha hc hd
    have hdne : d ≠ t.simpleIndex ht i := by
      intro heq
      exact root_ne_add_of_mem_support (simpleIndex_mem_support i)
        ((mem_posRoots P b _).mp ha) ((mem_posRoots P b _).mp hc) (heq ▸ hd)
    intro w
    exact (le_iSup₂ (f := fun γ _ => (chevalleyRootSubgroup ρ M hM hnil γ A).range)
      d ⟨hdpos, hdne⟩) ⟨w, rfl⟩
  -- Every nontrivial commutator has one or two factors, each a sum of positive roots.
  have htwo {a c d e : Fin t.numRoots}
      (ha : a ∈ posRoots P b) (hc : c ∈ posRoots P b)
      (hd : P.root d = P.root a + P.root c)
      (he : P.root e = 2 • P.root a + P.root c) (s z : A) :
      ⁅chevalleyRootSubgroup ρ M hM hnil a A (Multiplicative.ofAdd s),
        chevalleyRootSubgroup ρ M hM hnil c A (Multiplicative.ofAdd z)⁆ ∈ U := by
    have hlin := P.linearIndependent_of_add_mem_range_root' ⟨d, hd⟩
    have hthree : 3 • R.root a + R.root c ∉ Set.range R.root := by
      rintro ⟨f, hf⟩
      have htop := P.chainBotCoeff_add_chainTopCoeff_le_two a c
      have hle := (P.root_add_nsmul_mem_range_iff_le_chainTopCoeff hlin).mp
        (Set.mem_range.mpr ⟨f, ((hcast a c f 3).mpr hf).trans (add_comm _ _)⟩)
      omega
    have hother : R.root a + 2 • R.root c ∉ Set.range R.root := by
      rintro ⟨f, hf⟩
      exact P.not_double_root_add_and_root_add_double_mem hlin
        ⟨⟨e, he⟩, ⟨f, by
          simpa only [add_comm] using
            (hcast c a f 2).mpr (hf.trans (add_comm _ _))⟩⟩
    have hdZ : R.root d = R.root a + R.root c := by
      simpa only [one_nsmul] using (hcast a c d 1).mp (by simpa using hd)
    rw [commutatorElement_chevalleyRootSubgroup_of_root_eq_two_nsmul_add
      ρ M hM hnil hdZ ((hcast a c e 2).mp he) hthree hother]
    have he' : P.root e = P.root a + P.root d := by rw [he, hd]; module
    exact U.mul_mem (hsum_mem ha hc hd _)
      (hsum_mem ha (add_mem_posRoots P b ha hc hd) he' _)
  by_cases hs : R.root α + R.root β ∈ Set.range R.root
  · obtain ⟨γ, hγ⟩ := hs
    have hγQ : P.root γ = P.root α + P.root β := by
      simpa only [one_nsmul] using (hcast α β γ 1).mpr (by simpa using hγ)
    by_cases hd : 2 • R.root α + R.root β ∈ Set.range R.root
    · obtain ⟨δ, hδ⟩ := hd
      exact htwo hα hβ hγQ ((hcast α β δ 2).mpr hδ) u v
    · by_cases he : 2 • R.root β + R.root α ∈ Set.range R.root
      · obtain ⟨δ, hδ⟩ := he
        rw [← commutatorElement_inv]
        exact U.inv_mem (htwo hβ hα (hγQ.trans (add_comm _ _))
          ((hcast β α δ 2).mpr hδ) v u)
      · rw [commutatorElement_chevalleyRootSubgroup_of_root_eq_add ρ M hM hnil hγ hd
          (by simpa only [add_comm] using he)]
        exact hsum_mem hα hβ hγQ _
  · have hz : R.root α + R.root β ≠ 0 := by
      intro hz
      have hneg : R.root α = -R.root β := eq_neg_of_add_eq_zero_left hz
      have hQ := congrArg (fun f : Fin t.rank → ℤ => fun j => (f j : ℚ)) hneg
      have hnegQ : P.root α = -P.root β := by
        ext j
        simpa only [P, R, root_rationalRootSystem, Pi.neg_apply, Int.cast_neg] using congrFun hQ j
      exact root_add_ne_zero_of_mem_posRoots_of_mem_posRootCone P b hα
        (root_mem_posRootCone_of_mem_posRoots P b hβ) (by simp [hnegQ])
    rw [(commute_chevalleyRootSubgroup ρ M hM hnil hs hz A u v).commutator_eq]
    exact U.one_mem

/-- In arbitrary valid rank in types B and C, the opposite simple-root pair normalizes the
subgroup generated by all other positive roots, over every commutative value ring. -/
theorem range_simpleRootPair_le_normalizer_posRoots_diff_singleton_of_typeBC
    (hBC : ∃ n, t = B n ∨ t = C n) (i : Fin t.rank) (A : CommAlgCat ℤ) :
    let x := fun γ => chevalleyRootSubgroup ρ M hM hnil γ A
    let α := t.simpleIndex ht i
    (x α).range ⊔ (x ((t.simplyConnectedRootDatum ht).reflectionPerm α α)).range ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {α},
          (x γ).range : Subgroup _) := by
  have hbound (a c : Fin t.numRoots) :
      |(t.simplyConnectedRootDatum ht).pairing a c| ≤ 2 := by
    obtain ⟨n, rfl | rfl⟩ := hBC
    · rw [simplyConnectedRootDatum_B]
      exact abs_pairing_typeBSimplyConnectedRootDatum_le_two a c
    · rw [simplyConnectedRootDatum_C]
      exact abs_pairing_typeCSimplyConnectedRootDatum_le_two a c
  have : (t.rationalRootSystem ht).IsNotG2 := {
    pairingIn_mem_zero_one_two := fun a c => by
      have h := hbound a c
      rw [abs_le] at h
      have heq : (t.rationalRootSystem ht).pairingIn ℤ a c =
          (t.simplyConnectedRootDatum ht).pairing a c := by
        rw [pairingIn_rationalRootSystem]
        exact (t.simplyConnectedRootDatum ht).algebraMap_pairingIn ℤ a c
      rw [heq]
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
      omega }
  dsimp only
  let U := ⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
    (chevalleyRootSubgroup ρ M hM hnil γ A).range
  have hpos : t.simpleIndex ht i ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) :=
    (mem_posRoots _ _ _).mpr (RootPairing.Base.isPos_of_mem_support (simpleIndex_mem_support i))
  have hp : (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer (U : Set _) := by
    dsimp only [U]
    rw [← iSup_subtype'']
    apply Subgroup.le_normalizer_iSup_of_commutator_le
    intro γ
    apply Subgroup.commutator_le.mpr
    rintro _ ⟨u, rfl⟩ _ ⟨v, rfl⟩
    rw [iSup_subtype]
    exact positive_commutator_mem_punctured ρ M hM hnil i hpos γ.property.1 A u.toAdd v.toAdd
  -- Conjugate positive-root normalization by the simple Weyl element to obtain the negative.
  have hw := kostantWeylGL_mem_normalizer_posRoots_diff_singleton ρ M hM hnil i A
  have hn := (Subgroup.map_mono hp).trans
    (Subgroup.le_normalizer_map (H := U)
      (MulAut.conj (kostantWeylGL (t.lieBasis ht).rootGenerator (t.lieBasis ht).h
        ρ M hM (hnil (.inl i)) (hnil (.inr i)) A)).toMonoidHom)
  simp only [MulEquiv.toMonoidHom_eq_coe] at hn
  rw [map_range_chevalleyRootSubgroup_conj_kostantWeylGL,
    Subgroup.mem_normalizer_iff_map_conj_eq.mp hw] at hn
  exact sup_le hp hn

/-- Every element generated by the positive B/C roots factors as a punctured-positive element
followed by an element of a prescribed simple root group. No coordinate uniqueness is assumed. -/
theorem mem_iSup_posRoots_iff_exists_mul_simpleRoot_of_typeBC
    (hBC : ∃ n, t = B n ∨ t = C n) (i : Fin t.rank) (A : CommAlgCat ℤ)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    let x := fun γ => chevalleyRootSubgroup ρ M hM hnil γ A
    let α := t.simpleIndex ht i
    g ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht), (x γ).range) ↔
      ∃ v ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {α}, (x γ).range),
        ∃ a : Multiplicative A, v * x α a = g := by
  dsimp only
  have hα : t.simpleIndex ht i ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) :=
    (mem_posRoots _ _ _).mpr (RootPairing.Base.isPos_of_mem_support (simpleIndex_mem_support i))
  have hsplit : posRoots (t.rationalRootSystem ht) (t.rationalBase ht) =
      (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i}) ∪
        {t.simpleIndex ht i} :=
    (Set.sdiff_union_of_subset (Set.singleton_subset_iff.mpr hα)).symm
  conv_lhs => rw [hsplit, iSup_union, iSup_singleton]
  rw [Subgroup.mem_sup_of_right_le_normalizer_left
    ((range_simpleRootPair_le_normalizer_posRoots_diff_singleton_of_typeBC
      ρ M hM hnil hBC i A).trans' le_sup_left)]
  constructor
  · rintro ⟨v, hv, _, ⟨a, rfl⟩, heq⟩
    exact ⟨v, hv, a, heq⟩
  · rintro ⟨v, hv, a, heq⟩
    exact ⟨v, hv, _, ⟨a, rfl⟩, heq⟩

end

end TauCeti.DynkinType
