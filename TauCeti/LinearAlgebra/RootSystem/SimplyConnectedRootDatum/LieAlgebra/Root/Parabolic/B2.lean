module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Commutator.Basic
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.B.RankTwo.Rational
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Positive

/-!
# Rank-one normalization of punctured positive subgroups in type B₂

In a Kostant-stable representation of the pinned B₂ Lie algebra, the opposite simple-root
pair normalizes the subgroup generated by the other positive roots. Consequently every
positive element is a punctured-positive element followed by an element of the omitted
simple root subgroup. The factorization specializes
`mem_iSup_posRoots_iff_exists_mul_simpleRoot` from `Root.Positive`.
These are the local parabolic inputs to Bruhat reduction.

These statements hold over every commutative value ring, including characteristic two and
nonreduced rings. They neither identify generated subgroups with all scheme points nor
assert uniqueness of coordinates. In particular no structure constant is inverted.

The proof uses the native B₂ root table and the one- and two-factor Chevalley commutator
formulas in `Root.Commutator.Basic`, including reversed pairs by commutator inversion.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §§5.2 and 8.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra
open scoped commutatorElement

noncomputable section

variable {ht : (B 2).Valid}
variable {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ ((B 2).lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm ((B 2).lieBasis ht).rootGenerator ((B 2).lieBasis ht).h,
  ∀ v ∈ M, ρ u v ∈ M)
variable (hnil : ∀ i, IsNilpotent
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (((B 2).lieBasis ht).rootGenerator i))))

-- Match the integral scalar action stored in the value-ring object.
attribute [local instance high] Algebra.toModule

/-- Adding either sign of a simple B₂ root to a different positive root gives either no
root, a single root, or a two-root string, with every resulting root still positive and
different from the chosen simple root. The last case records the reversed string. -/
private theorem b2_parabolic_pairs (i : Fin 2) (k l : Fin 8)
    (hk : k.val = i.val ∨ k.val = i.val + 4) (hl : l.val < 4 ∧ l.val ≠ i.val) :
    (b2Root k + b2Root l ∉ Set.range b2Root ∧ b2Root k + b2Root l ≠ 0) ∨
    (∃ m : Fin 8, (m.val < 4 ∧ m.val ≠ i.val) ∧
      b2Root m = b2Root k + b2Root l ∧
      2 • b2Root k + b2Root l ∉ Set.range b2Root ∧
      b2Root k + 2 • b2Root l ∉ Set.range b2Root) ∨
    (∃ m n : Fin 8, (m.val < 4 ∧ m.val ≠ i.val) ∧ (n.val < 4 ∧ n.val ≠ i.val) ∧
      b2Root m = b2Root k + b2Root l ∧ b2Root n = 2 • b2Root k + b2Root l ∧
      3 • b2Root k + b2Root l ∉ Set.range b2Root ∧
      b2Root k + 2 • b2Root l ∉ Set.range b2Root) ∨
    (∃ m n : Fin 8, (m.val < 4 ∧ m.val ≠ i.val) ∧ (n.val < 4 ∧ n.val ≠ i.val) ∧
      b2Root m = b2Root l + b2Root k ∧ b2Root n = 2 • b2Root l + b2Root k ∧
      3 • b2Root l + b2Root k ∉ Set.range b2Root ∧
      b2Root l + 2 • b2Root k ∉ Set.range b2Root) := by
  simp only [Set.mem_range, ne_eq, funext_iff]
  fin_cases i <;> fin_cases k <;> fin_cases l <;> norm_num at hk <;> norm_num at hl <;> first
    | exact Or.inl (by decide)
    | exact Or.inr (Or.inl ⟨3, by decide⟩)
    | exact Or.inr (Or.inl ⟨0, by decide⟩)
    | exact Or.inr (Or.inr (Or.inl ⟨2, 3, by decide⟩))
    | exact Or.inr (Or.inr (Or.inl ⟨2, 0, by decide⟩))
    | exact Or.inr (Or.inr (Or.inr ⟨2, 3, by decide⟩))
    | exact Or.inr (Or.inr (Or.inr ⟨1, 3, by decide⟩))

private theorem b2_parabolic_commutator_mem (i : Fin 2) (k l : Fin 8)
    (hk : k.val = i.val ∨ k.val = i.val + 4) (hl : l.val < 4 ∧ l.val ≠ i.val)
    (A : CommAlgCat ℤ) (H : Subgroup (LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)))
    (hH : ∀ m : Fin 8, m.val < 4 ∧ m.val ≠ i.val →
      (chevalleyRootSubgroup ρ M hM hnil (b2Index m) A).range ≤ H) (u v : A) :
    ⁅chevalleyRootSubgroup ρ M hM hnil (b2Index k) A (Multiplicative.ofAdd u),
      chevalleyRootSubgroup ρ M hM hnil (b2Index l) A (Multiplicative.ofAdd v)⁆ ∈ H := by
  have hroot (m : Fin 8) : ((B 2).simplyConnectedRootDatum ht).root (b2Index m) =
      b2Root m := by
    rw [simplyConnectedRootDatum_B]
    -- The branch equation leaves the Dynkin rank in the implicit type of equality.
    change (typeBSimplyConnectedRootDatum 2).root (b2Index m) = b2Root m
    exact root_b2Index m
  have hrange : Set.range ((B 2).simplyConnectedRootDatum ht).root = Set.range b2Root := by
    rw [simplyConnectedRootDatum_B]
    -- Normalize the implicit character-lattice type together with the branch equation.
    change Set.range (typeBSimplyConnectedRootDatum 2).root = Set.range b2Root
    exact range_root_typeBSimplyConnectedRootDatum_two
  have hone (m : Fin 8)
      (heq : b2Root m = b2Root k + b2Root l)
      (ha : 2 • b2Root k + b2Root l ∉ Set.range b2Root)
      (hb : b2Root k + 2 • b2Root l ∉ Set.range b2Root) :=
    commutatorElement_chevalleyRootSubgroup_of_root_eq_add ρ M hM hnil
      (t := B 2) (ht := ht) (α := b2Index k) (β := b2Index l) (γ := b2Index m)
      (by simpa only [hroot] using! heq)
      (by simpa only [hroot, hrange] using! ha)
      (by simpa only [hroot, hrange] using! hb) A u v
  have htwo (k l m n : Fin 8)
      (hm : m.val < 4 ∧ m.val ≠ i.val) (hn : n.val < 4 ∧ n.val ≠ i.val)
      (heq : b2Root m = b2Root k + b2Root l)
      (heq' : b2Root n = 2 • b2Root k + b2Root l)
      (ha : 3 • b2Root k + b2Root l ∉ Set.range b2Root)
      (hb : b2Root k + 2 • b2Root l ∉ Set.range b2Root) (u v : A) :
      ⁅chevalleyRootSubgroup ρ M hM hnil (b2Index k) A (Multiplicative.ofAdd u),
        chevalleyRootSubgroup ρ M hM hnil (b2Index l) A (Multiplicative.ofAdd v)⁆ ∈ H := by
    rw [commutatorElement_chevalleyRootSubgroup_of_root_eq_two_nsmul_add ρ M hM hnil
      (t := B 2) (ht := ht) (α := b2Index k) (β := b2Index l) (γ := b2Index m) (δ := b2Index n)
      (by simpa only [hroot] using! heq) (by simpa only [hroot] using! heq')
      (by simpa only [hroot, hrange] using! ha)
      (by simpa only [hroot, hrange] using! hb)]
    exact H.mul_mem (hH m hm ⟨_, rfl⟩) (hH n hn ⟨_, rfl⟩)
  rcases b2_parabolic_pairs i k l hk hl with ⟨ha, hb⟩ | ⟨m, hm, heq, ha, hb⟩ |
      ⟨m, n, hm, hn, heq, heq', ha, hb⟩ | ⟨m, n, hm, hn, heq, heq', ha, hb⟩
  · rw [(commute_chevalleyRootSubgroup ρ M hM hnil
      (t := B 2) (ht := ht) (α := b2Index k) (β := b2Index l)
      (by simpa only [hroot, hrange] using! ha)
      (by simpa only [hroot] using! hb) A u v).commutator_eq]
    exact H.one_mem
  · rw [hone m heq ha hb]
    exact hH m hm ⟨_, rfl⟩
  · exact htwo k l m n hm hn heq heq' ha hb u v
  · rw [← commutatorElement_inv]
    exact H.inv_mem (htwo l k m n hm hn heq heq' ha hb v u)

/-- In type B₂, the opposite simple-root pair normalizes the subgroup generated by the
other positive roots, on any Kostant-stable lattice over every commutative value ring.
Positivity is measured in the pinned rational base. -/
theorem range_simpleRootPair_le_normalizer_posRoots_diff_singleton_B2
    (i : Fin 2) (A : CommAlgCat ℤ) :
    let x := fun γ : Fin (B 2).numRoots => chevalleyRootSubgroup ρ M hM hnil γ A
    let α := (B 2).simpleIndex ht i
    let β := ((B 2).simplyConnectedRootDatum ht).reflectionPerm α α
    (x α).range ⊔ (x β).range ≤ Subgroup.normalizer
      (⨆ γ ∈ posRoots ((B 2).rationalRootSystem ht) ((B 2).rationalBase ht) \ {α},
        (x γ).range : Subgroup _) := by
  dsimp only
  rw [posRoots_rational_B_two]
  let S := posRoots (typeBSimplyConnectedRootDatum 2) (typeBSimplyConnectedBase 2) \
    {((B 2).simpleIndex ht i : Fin (2 * 2 ^ 2))}
  let x : Fin (2 * 2 ^ 2) → _ := fun γ => chevalleyRootSubgroup ρ M hM hnil γ A
  let U := ⨆ γ ∈ S, (x γ).range
  -- Identify the punctured positive set in the existing table.
  have hS (m : Fin 8) : b2Index m ∈ S ↔ m.val < 4 ∧ m.val ≠ i.val := by
    have hi := simpleIndex_B_two_eq_b2Index ht i
    -- Read the Dynkin simple index in the concrete table's index type before rewriting.
    change b2Index m ∈ posRoots (typeBSimplyConnectedRootDatum 2)
      (typeBSimplyConnectedBase 2) \ {((B 2).simpleIndex ht i : Fin (2 * 2 ^ 2))} ↔ _
    rw [Set.mem_sdiff, b2Index_mem_posRoots_iff]
    constructor
    · rintro ⟨hm, hn⟩
      refine ⟨hm, fun h => hn ?_⟩
      exact Set.mem_singleton_iff.mpr ((congrArg b2Index (Fin.ext h)).trans hi.symm)
    · rintro ⟨hm, hn⟩
      refine ⟨hm, fun h => hn ?_⟩
      exact congrArg Fin.val (b2Index_injective ((Set.mem_singleton_iff.mp h).trans hi))
  -- Generator commutators in U imply normalization of the whole generated subgroup.
  have hnorm (k : Fin 8) (hk : k.val = i.val ∨ k.val = i.val + 4) :
      (x (b2Index k)).range ≤ Subgroup.normalizer (U : Set _) := by
    dsimp only [U]
    rw [← iSup_subtype'' S]
    apply Subgroup.le_normalizer_iSup_of_commutator_le
    intro l
    apply Subgroup.commutator_le.mpr
    rintro _ ⟨u, rfl⟩ _ ⟨v, rfl⟩
    obtain ⟨j, hj⟩ := b2Index_bijective.surjective l.val
    have hjS := (hS j).mp (hj ▸ l.property)
    rw [← hj]
    exact b2_parabolic_commutator_mem ρ M hM hnil i k j hk hjS A _
      (fun m hm => le_iSup_of_le ⟨b2Index m, (hS m).mpr hm⟩ le_rfl) u.toAdd v.toAdd
  -- The two table entries are the prescribed positive and negative simple roots.
  apply sup_le
  · simpa only [U, S, x, simpleIndex_B_two_eq_b2Index ht i] using!
      hnorm (Fin.castAdd 6 i) (Or.inl rfl)
  · have hi : ((B 2).simplyConnectedRootDatum ht).reflectionPerm
        ((B 2).simpleIndex ht i) ((B 2).simpleIndex ht i) =
        b2Index (Fin.castAdd 6 i + 4) := by
      apply ((B 2).simplyConnectedRootDatum ht).root.injective
      rw [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self]
      rw [simpleIndex_B_two_eq_b2Index, simplyConnectedRootDatum_B]
      -- Normalize the datum and index bounds together for the concrete root calculation.
      change -(typeBSimplyConnectedRootDatum 2).root (b2Index (Fin.castAdd 6 i)) =
        (typeBSimplyConnectedRootDatum 2).root (b2Index (Fin.castAdd 6 i + 4))
      rw [root_b2Index, root_b2Index, b2Root_add_four]
    simpa only [U, S, x, hi] using!
      hnorm (Fin.castAdd 6 i + 4) (Or.inr (by fin_cases i <;> decide))

/-- Every element generated by the positive B₂ roots is a product of an element generated by
all but a prescribed simple root and an element of that simple root subgroup. No uniqueness
or field assumption is needed. Positivity is measured in the pinned rational base. -/
theorem mem_iSup_posRoots_iff_exists_mul_simpleRoot_B2
    (i : Fin 2) (A : CommAlgCat ℤ)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    let x := fun γ : Fin (B 2).numRoots => chevalleyRootSubgroup ρ M hM hnil γ A
    let α := (B 2).simpleIndex ht i
    g ∈ (⨆ γ ∈ posRoots ((B 2).rationalRootSystem ht) ((B 2).rationalBase ht),
      (x γ).range) ↔
      ∃ v ∈ (⨆ γ ∈ posRoots ((B 2).rationalRootSystem ht) ((B 2).rationalBase ht) \ {α},
          (x γ).range), ∃ a : Multiplicative A, v * x α a = g :=
  mem_iSup_posRoots_iff_exists_mul_simpleRoot ρ M hM hnil i A
    ((range_simpleRootPair_le_normalizer_posRoots_diff_singleton_B2 ρ M hM hnil i A).trans'
      le_sup_left) g

end

end TauCeti.DynkinType
