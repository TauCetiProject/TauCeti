module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Positive
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.StructureConstant
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.SimplyLaced
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.WeightDegree
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Subsystem

/-!
# The punctured positive subgroup and its rank-one normalizer

In a simply-laced root system, remove one simple root from the positive roots. The subgroup
of a Kostant-stable lattice generated by the remaining root groups is normalized by the
opposite root pair at that node. Moreover, every element of the positive subgroup is a
product of an element of this punctured subgroup and an element of the omitted root group.
These are the local parabolic factorization and normalization used in Bruhat reduction.

The value ring is arbitrary; neither invertibility of structure constants nor generation
by positive simple root groups is assumed. The factorization is an existence statement,
not a claim of uniqueness. The rank-one normalization uses
`kostantWeylGL_mem_normalizer_posRoots_diff_singleton` from `Root.Positive`, the conjugation
formula `map_range_chevalleyRootSubgroup_conj_kostantWeylGL` from `Root.Subgroup`, and
`kostantSubsystemSubgroup_le_normalizer_of_isChevalleyStable` from the Kostant
`RootSubgroup.Subsystem` module.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4.
* R. W. Carter, *Simple Groups of Lie Type*, §8.3.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

noncomputable section

variable {t : DynkinType} {ht : t.Valid}

private theorem isChevalleyStableUnder_posRoots_diff_singleton_posRoots (hs : t.IsSimplyLaced)
    (i : Fin t.rank) :
    IsChevalleyStableUnder (t.chevalleySystem ht)
      (posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i})
      (posRoots (t.rationalRootSystem ht) (t.rationalBase ht)) := by
  rw [isChevalleyStableUnder_iff]
  intro α hα β hβ
  by_cases hadd : (t.simplyConnectedRootDatum ht).root α +
      (t.simplyConnectedRootDatum ht).root β ∈ Set.range (t.simplyConnectedRootDatum ht).root
  · obtain ⟨γ, hγ⟩ := hadd
    have hγrat : (t.rationalRootSystem ht).root γ =
        (t.rationalRootSystem ht).root α + (t.rationalRootSystem ht).root β := by
      simpa only [Int.cast_one, one_smul] using
        (t.root_rationalRootSystem_eq_add_zsmul_iff ht β α γ 1).mpr
          (by simpa only [one_smul] using hγ)
    have hγpos : γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) :=
      (mem_posRoots _ _ _).mpr (((mem_posRoots _ _ _).mp hα).add
        ((mem_posRoots _ _ _).mp hβ.1) hγrat)
    have hγne : γ ≠ t.simpleIndex ht i := by
      intro heq
      subst γ
      exact root_ne_add_of_mem_support (simpleIndex_mem_support i)
        ((mem_posRoots _ _ _).mp hα) ((mem_posRoots _ _ _).mp hβ.1) hγrat
    have hcomm := t.pairing_simplyConnectedRootDatum_comm ht hs
    exact Or.inr ⟨γ, ⟨hγpos, hγne⟩, t.structureConstant ht α β,
      lie_chevalleySystem_eq_structureConstant_zsmul hγ,
      lie_chevalleySystem_eq_zero_of_add_eq hγ
        (RootPairing.root_add_notMem_of_root_eq_add hcomm hγ),
      lie_chevalleySystem_eq_zero_of_add_eq (hγ.trans (add_comm _ _))
        (RootPairing.root_add_notMem_of_root_eq_add hcomm (hγ.trans (add_comm _ _)))⟩
  · refine Or.inl (lie_chevalleySystem_eq_zero hadd ?_)
    intro hzero
    have hdeg := congrArg (t.weightDegree ht) hzero
    have hαdeg := t.weightDegree_root_pos ht hα
    have hβdeg := t.weightDegree_root_pos ht hβ.1
    simp only [map_add, map_zero] at hdeg
    linarith

variable {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ UniversalEnvelopingAlgebra.kostantForm
  (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
  ∀ v ∈ M, ρ u v ∈ M)
variable (hnil : ∀ i, IsNilpotent
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

attribute [local instance high] Algebra.toModule

/-- In a simply-laced type, the positive subgroup normalizes the subgroup generated by all
positive roots except one simple root. This holds over every commutative value ring. -/
theorem iSup_posRoots_le_normalizer_posRoots_diff_singleton (hs : t.IsSimplyLaced)
    (i : Fin t.rank) (A : CommAlgCat ℤ) :
    (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
      (chevalleyRootSubgroup ρ M hM hnil γ A).range) ≤
    Subgroup.normalizer
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) := by
  have h := kostantSubsystemSubgroup_le_normalizer_of_isChevalleyStable
    (t.chevalleySystem ht) (t.lieBasis ht).h ρ M
    (kostantForm_chevalleySystem_smul_mem ρ M hM hnil)
    (isNilpotent_apply_ι_chevalleySystem ρ hnil)
    (isChevalleyStableUnder_posRoots_diff_singleton_posRoots hs i) A
  simpa only [kostantSubsystemSubgroup_eq_iSup,
    kostantRootSubgroupParam_chevalleySystem ρ M hM hnil] using h

private theorem range_simpleIndex_le_normalizer_posRoots_diff_singleton
    (hs : t.IsSimplyLaced) (i : Fin t.rank) (A : CommAlgCat ℤ) :
    (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) := by
  intro g hg
  apply iSup_posRoots_le_normalizer_posRoots_diff_singleton ρ M hM hnil hs i A
  exact Subgroup.mem_iSup_of_mem (t.simpleIndex ht i)
    (Subgroup.mem_iSup_of_mem (simpleIndex_mem_posRoots (ht := ht) i) hg)

/-- The opposite simple-root pair normalizes the punctured positive subgroup in a simply-laced
type. In particular, the negative simple root group preserves it by conjugation. -/
theorem closure_simpleRootPair_le_normalizer_posRoots_diff_singleton (hs : t.IsSimplyLaced)
    (i : Fin t.rank) (A : CommAlgCat ℤ) :
    Subgroup.closure
      (Set.range (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A) ∪
        Set.range (chevalleyRootSubgroup ρ M hM hnil
          ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i)
            (t.simpleIndex ht i)) A)) ≤
    Subgroup.normalizer
      (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
        (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) := by
  exact closure_simpleRootPair_le_normalizer_posRoots_diff_singleton_of_le_normalizer
    ρ M hM hnil i A
    (range_simpleIndex_le_normalizer_posRoots_diff_singleton ρ M hM hnil hs i A)

/-- Every positive element in a simply-laced type is a punctured-positive element followed by
an element of the chosen simple root group. No uniqueness of the factors is asserted. -/
theorem mem_iSup_posRoots_iff_exists_posRoots_diff_singleton_mul (hs : t.IsSimplyLaced)
    (i : Fin t.rank) (A : CommAlgCat ℤ)
    (g : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
    g ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht),
      (chevalleyRootSubgroup ρ M hM hnil γ A).range) ↔
    ∃ q ∈ (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
      (chevalleyRootSubgroup ρ M hM hnil γ A).range),
      ∃ u, g = q * chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A u := by
  exact mem_iSup_posRoots_iff_exists_posRoots_diff_singleton_mul_of_le_normalizer
    ρ M hM hnil i A
    (range_simpleIndex_le_normalizer_posRoots_diff_singleton ρ M hM hnil hs i A) g

end

end TauCeti.DynkinType
