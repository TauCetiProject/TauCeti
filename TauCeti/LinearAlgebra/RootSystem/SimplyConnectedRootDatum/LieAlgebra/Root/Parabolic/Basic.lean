module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Positive
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Commutator.Basic
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.WeightDegree
import TauCeti.LinearAlgebra.RootSystem.Positive
import TauCeti.GroupTheory.Commutator

/-!
# Simple-root normalization from short root strings

For any valid Dynkin type, a simple root subgroup normalizes the subgroup generated by the
other positive roots if its root pairs have at most two commutator factors. The root-table
hypothesis retains the orientation of double strings, so no structure constant is inverted.
Together with `Root.Positive`, this supplies rank-one normalization and factorization for
Bruhat reduction (Steinberg, *Lectures on Chevalley Groups*, Chapter 3, proof of Theorem 4;
Carter, *Simple Groups of Lie Type*, §5.2).
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra
open scoped commutatorElement

/-- Root-pair configurations giving zero, one, or two Chevalley commutator factors.
The two-factor alternatives retain their orientation, since exchanging the inputs inverts
the commutator. No positivity or simple-root hypothesis is included.

This is an abbreviation so finite root-table checks can unfold it and synthesize computable
decision instances for the individual cases. -/
abbrev SimplePairStringCases {ι L : Type*} [AddCommMonoid L] (r : ι → L) (α β : ι) : Prop :=
  (r α + r β ∉ Set.range r ∨
    ∃ γ, r γ = r α + r β ∧
      2 • r α + r β ∉ Set.range r ∧ r α + 2 • r β ∉ Set.range r) ∨
  ((∃ γ, r γ = r α + r β ∧ ∃ δ, r δ = 2 • r α + r β ∧
    3 • r α + r β ∉ Set.range r ∧ r α + 2 • r β ∉ Set.range r) ∨
    ∃ γ, r γ = r β + r α ∧ ∃ δ, r δ = 2 • r β + r α ∧
    3 • r β + r α ∉ Set.range r ∧ r β + 2 • r α ∉ Set.range r)

variable {t : DynkinType} {ht : t.Valid} {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
  (M : AddSubgroup V)
  (hM : ∀ u ∈ UniversalEnvelopingAlgebra.kostantForm
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
    ∀ v ∈ M, ρ u v ∈ M)
  (hnil : ∀ i, IsNilpotent
    (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

-- Match the tensor-product scalar structure to the integral algebra of the value ring.
attribute [local instance high] Algebra.toModule

/-- A simple root subgroup normalizes the remaining positive subgroup whenever every pair
with that simple root has a one- or two-factor Chevalley commutator formula. -/
theorem range_simple_le_normalizer_posRoots_diff_singleton_of_pair_cases
    (i : Fin t.rank) (A : CommAlgCat ℤ)
    (hcases : ∀ β : Fin t.numRoots,
      SimplePairStringCases (t.simplyConnectedRootDatum ht).root (t.simpleIndex ht i) β) :
    (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A).range ≤
      Subgroup.normalizer
        (⨆ γ ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i},
          (chevalleyRootSubgroup ρ M hM hnil γ A).range : Subgroup _) := by
  classical
  let S := posRoots (t.rationalRootSystem ht) (t.rationalBase ht) \ {t.simpleIndex ht i}
  let X := fun γ => (chevalleyRootSubgroup ρ M hM hnil γ A).range
  let U := ⨆ γ ∈ S, X γ
  have hsimple := simpleIndex_mem_posRoots (ht := ht) i
  -- A sum of two positive roots is positive and cannot be the omitted simple root.
  have hadd {α β γ : Fin t.numRoots}
      (hα : α ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
      (hβ : β ∈ posRoots (t.rationalRootSystem ht) (t.rationalBase ht))
      (hγ : (t.simplyConnectedRootDatum ht).root γ =
        (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β) :
      γ ∈ S := by
    have hrat := (t.root_rationalRootSystem_eq_add_zsmul_iff ht β α γ 1).mpr
      (by simpa only [one_smul] using hγ)
    simp only [Int.cast_one, one_smul] at hrat
    refine ⟨(mem_posRoots _ _ _).mpr
      (((mem_posRoots _ _ _).mp hα).add ((mem_posRoots _ _ _).mp hβ) hrat), ?_⟩
    intro heq
    exact root_ne_add_of_mem_support (simpleIndex_mem_support i)
      ((mem_posRoots _ _ _).mp hα) ((mem_posRoots _ _ _).mp hβ) (heq ▸ hrat)
  have hmem {γ : Fin t.numRoots} (hγ : γ ∈ S) (u : Multiplicative A) :
      chevalleyRootSubgroup ρ M hM hnil γ A u ∈ U :=
    le_iSup₂ (f := fun γ _ => X γ) γ hγ ⟨u, rfl⟩
  -- It suffices to place each generator commutator in the punctured subgroup.
  rw [← iSup_subtype'']
  apply Subgroup.le_normalizer_iSup_of_commutator_le
  intro β
  apply Subgroup.commutator_le.mpr
  rintro _ ⟨u, rfl⟩ _ ⟨v, rfl⟩
  simp only [iSup_subtype]
  have hzero : (t.simplyConnectedRootDatum ht).root (t.simpleIndex ht i) +
      (t.simplyConnectedRootDatum ht).root β ≠ 0 := by
    intro hz
    have hd := congrArg (t.weightDegree ht) hz
    have hi := t.weightDegree_root_pos ht hsimple
    have hb := t.weightDegree_root_pos ht β.property.1
    simp only [map_add, map_zero] at hd
    linarith
  -- Each nontrivial commutator has one or two positive sum-root factors.
  have hpair := hcases β.val
  unfold SimplePairStringCases at hpair
  rcases hpair with (hsum | ⟨γ, hγ, hi, hj⟩) |
    (⟨γ, hγ, δ, hδ, hi, hj⟩ | ⟨γ, hγ, δ, hδ, hi, hj⟩)
  · have hc := commute_chevalleyRootSubgroup ρ M hM hnil hsum hzero A u.toAdd v.toAdd
    simp only [ofAdd_toAdd] at hc
    rw [commutatorElement_eq_one_iff_commute.mpr hc]
    exact U.one_mem
  · rw [← ofAdd_toAdd u, ← ofAdd_toAdd v,
      commutatorElement_chevalleyRootSubgroup_of_root_eq_add ρ M hM hnil hγ hi hj]
    exact hmem (hadd hsimple β.property.1 hγ) _
  · have hδ' : (t.simplyConnectedRootDatum ht).root δ =
        (t.simplyConnectedRootDatum ht).root (t.simpleIndex ht i) +
          (t.simplyConnectedRootDatum ht).root γ := by rw [hδ, hγ]; module
    rw [← ofAdd_toAdd u, ← ofAdd_toAdd v,
      commutatorElement_chevalleyRootSubgroup_of_root_eq_two_nsmul_add ρ M hM hnil hγ hδ hi hj]
    exact U.mul_mem (hmem (hadd hsimple β.property.1 hγ) _)
      (hmem (hadd hsimple (hadd hsimple β.property.1 hγ).1 hδ') _)
  · have hδ' : (t.simplyConnectedRootDatum ht).root δ =
        (t.simplyConnectedRootDatum ht).root β + (t.simplyConnectedRootDatum ht).root γ := by
        rw [hδ, hγ]; module
    rw [← commutatorElement_inv, ← ofAdd_toAdd u, ← ofAdd_toAdd v,
      commutatorElement_chevalleyRootSubgroup_of_root_eq_two_nsmul_add ρ M hM hnil hγ hδ hi hj]
    exact U.inv_mem (U.mul_mem (hmem (hadd β.property.1 hsimple hγ) _)
      (hmem (hadd β.property.1 (hadd β.property.1 hsimple hγ).1 hδ') _))

end TauCeti.DynkinType
