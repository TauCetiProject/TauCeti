/-!
# Root subgroups of the pinned Chevalley system at every root

For a valid Dynkin type `t`, let `e_γ = TauCeti.DynkinType.chevalleySystem t ht γ` be the named
root vectors of the pinned rational Lie algebra, indexed by the root numbers `Fin t.numRoots`. Let
`ρ` be a representation of its universal enveloping algebra on a rational vector space `V`, and let
`M ≤ V` be an additive subgroup stable under the simple-generator Kostant form, on which the simple
generators `eᵢ`, `fᵢ` act nilpotently. Only the simple generators enter the Kostant form, so a
priori only the root subgroups of the simple roots and their negatives are defined on `M`. This
file constructs the root subgroup

```text
x_γ(u) = ∑ₙ uⁿ ρ(e_γ)⁽ⁿ⁾
```

of every root `γ` over every commutative ring of points, following Steinberg, *Lectures on Chevalley
Groups*, Chapter 3.

The input is the description of every root vector through the simple ones: the Weyl automorphism
`w_α` of the triple `(α^∨, e_α, e_{-α})` satisfies `w_α e_β = ε e_{s_α β}` for a sign `ε = ±1`,
recorded as `TauCeti.DynkinType.chevalleyWeylSign`, and every root vector is reached from the
simple root vectors by simple Weyl automorphisms and signs. In the representation `w_αᵢ` is
conjugation by Chevalley's Weyl element `nᵢ = xᵢ(1) x₋ᵢ(-1) xᵢ(1)`, which preserves `M`. Hence
`ρ(e_γ)` is nilpotent and has divided powers preserving `M`, and the root subgroups satisfy

```text
nᵢ x_γ(u) nᵢ⁻¹ = x_{sᵢ γ}(ε u),     ε = chevalleyWeylSign αᵢ γ,
```

over every ring of points, so that every root subgroup lies in the elementary group generated by
the simple ones.

Nothing about `V` beyond Kostant stability and nilpotence of the simple generators is used, so
the construction applies to any Kostant-stable lattice on which the simple generators act
nilpotently.

## Main definitions

* `TauCeti.DynkinType.chevalleyRootSubgroup`: the root subgroup `x_γ` of every root on the points
  of a Kostant-stable lattice.

## Main results

* `TauCeti.DynkinType.isNilpotent_apply_ι_chevalleySystem` and
  `TauCeti.DynkinType.dividedPower_chevalleySystem_smul_mem`: every root vector acts nilpotently,
  with divided powers preserving the lattice.
* `TauCeti.DynkinType.kostantForm_chevalleySystem_smul_mem`: the all-root Kostant
  form preserves the lattice.
* `TauCeti.DynkinType.kostantRootSubgroupParam_chevalleySystem`: comparison with the
  generic Kostant root subgroup for the all-root system.
* `TauCeti.DynkinType.chevalleyRootSubgroup_simpleIndex` and
  `TauCeti.DynkinType.chevalleyRootSubgroup_reflectionPerm_simpleIndex`: at `±αᵢ` these are the
  simple root subgroups of the Kostant data.
* `TauCeti.DynkinType.mapScalarExtensionAutomorphisms_chevalleyRootSubgroup`: naturality in the
  ring of points.
* `TauCeti.DynkinType.kostantWeylGL_conj_chevalleyRootSubgroup`: the signed conjugation identity
  `nᵢ x_γ(u) nᵢ⁻¹ = x_{sᵢ γ}(ε u)`.
* `TauCeti.DynkinType.map_range_chevalleyRootSubgroup_conj_kostantWeylGL` and
  `TauCeti.DynkinType.map_iSup_chevalleyRootSubgroup_conj_kostantWeylGL`: conjugation transports
  root-subgroup ranges and the groups generated by arbitrary root sets along the reflection.
* `TauCeti.DynkinType.commute_chevalleyRootSubgroup_of_add_notMem`: root subgroups commute
  when their roots sum to neither a root nor zero.
* `TauCeti.DynkinType.commutatorElement_chevalleyRootSubgroup_of_lie_eq`: a central root-vector
  bracket gives the one-factor commutator formula.
* `TauCeti.DynkinType.chevalleyRootSubgroup_mem_kostantElementarySubgroup`: every root subgroup
  lies in the elementary group generated by the simple root subgroups.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, AMS University Lecture Series 66 (2016),
  Chapter 3.
* R. W. Carter, *Simple Groups of Lie Type*, §6.4.
-/

public section

namespace TauCeti.DynkinType

open LieAlgebra LieAlgebra.IsKilling LieModule TensorProduct TauCeti.UniversalEnvelopingAlgebra
open scoped commutatorElement

noncomputable section

variable (t : DynkinType) (ht : t.Valid)

/-! ## Root vectors acting on a Kostant-stable lattice -/

section Lattice

variable {t ht}

variable {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ u ∈ kostantForm (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
  ∀ v ∈ M, ρ u v ∈ M)
variable (hnil : ∀ i, IsNilpotent
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

include hnil in
/-- **Every root vector acts nilpotently** in a representation in which the simple generators
`eᵢ`, `fᵢ` do: the action of `e_γ` is, up to sign, a conjugate of that of a simple generator by a
product of Weyl elements. -/
theorem isNilpotent_apply_ι_chevalleySystem (γ : Fin t.numRoots) :
    IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (t.chevalleySystem ht γ))) := by
  refine chevalleySystem_induction
    (p := fun z => IsNilpotent (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ z)))
    (fun z hz => by simpa using hz.neg) (fun i => by simpa using hnil (.inl i))
    (fun i z hz => ?_) γ
  obtain ⟨k, hk⟩ := hz
  refine ⟨k, ?_⟩
  rw [weylAut_simpleIndex_eq i ((t.lieBasis ht).isSl2Triple_rootGenerator i)
      (isNilpotent_ad_rootGenerator_inl i) (isNilpotent_ad_rootGenerator_inr i),
    apply_ι_weylAut_eq_weylUnit_conj (t.lieBasis ht).rootGenerator ρ (hnil (.inl i))
      (hnil (.inr i)), Units.conj_pow, hk, mul_zero, zero_mul]

include hM hnil in
/-- **Every root vector acts on a Kostant-stable lattice with integral divided powers.** For every
root `γ` and every `n`, the divided power `ρ(e_γ)ⁿ / n!` preserves `M`. At a simple root this is
Kostant stability; it passes to every root because the simple Weyl elements preserve `M`. -/
theorem dividedPower_chevalleySystem_smul_mem (γ : Fin t.numRoots) (n : ℕ) :
    ∀ v ∈ M, Associative.dividedPower n
      (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (t.chevalleySystem ht γ))) • v ∈ M := by
  revert n
  refine chevalleySystem_induction (p := fun z => ∀ n, ∀ v ∈ M,
      Associative.dividedPower n (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ z)) • v ∈ M)
    (fun z hz n => ?_) (fun i n _ hv => ?_) (fun i z hz n => ?_) γ
  · simpa using Associative.dividedPower_neg_smul_mem _ M (hz n)
  · simpa using dividedPower_apply_mem_of_kostantForm_apply_mem _ _ ρ hM (.inl i) n hv
  · rw [weylAut_simpleIndex_eq i ((t.lieBasis ht).isSl2Triple_rootGenerator i)
      (isNilpotent_ad_rootGenerator_inl i) (isNilpotent_ad_rootGenerator_inr i)]
    exact dividedPower_weylAut_smul_mem _ _ ρ M hM (hnil (.inl i)) (hnil (.inr i)) _ _ _ n (hz n)

include hM hnil in
/-- The all-root Kostant form preserves any subgroup stable under the simple-generator form
in a representation in which the simple root generators act nilpotently.
The Cartan generators are unchanged. -/
theorem kostantForm_chevalleySystem_smul_mem :
    ∀ u ∈ kostantForm (t.chevalleySystem ht) (t.lieBasis ht).h,
      ∀ v ∈ M, ρ u • v ∈ M := by
  apply kostantForm_apply_mem
    (t.chevalleySystem ht) (t.lieBasis ht).h ρ M.toIntSubmodule
  · intro γ n v hv
    rw [Associative.map_dividedPower]
    exact dividedPower_chevalleySystem_smul_mem ρ M hM hnil γ n v hv
  · intro i n v hv
    exact hM _ (ringChoose_mem_kostantForm _ _ i n) v hv

/-! ## The root subgroups -/

-- Match tensor products to the `ℤ`-algebra instance stored by `CommAlgCat` objects.
attribute [local instance high] Algebra.toModule

/-- **The root subgroup of a root** `γ` on the points of the Kostant-stable lattice `M` over a
commutative ring `A`: the one-parameter subgroup `x_γ(u) = ∑ₙ uⁿ ρ(e_γ)⁽ⁿ⁾` of the named root
vector `e_γ`, a finite sum because `ρ(e_γ)` is nilpotent, with integral divided powers. At the
simple roots and their negatives it is the root subgroup of the Kostant data
(`TauCeti.DynkinType.chevalleyRootSubgroup_simpleIndex`). -/
def chevalleyRootSubgroup (γ : Fin t.numRoots) (A : CommAlgCat ℤ) :
    Multiplicative A →* LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M) :=
  (LinearMap.GeneralLinearGroup.generalLinearEquiv A (A ⊗[ℤ] M)).symm.toMonoidHom.comp <|
    baseChangeExpHom (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (t.chevalleySystem ht γ))) M
      (dividedPower_chevalleySystem_smul_mem ρ M hM hnil γ)
      (isNilpotent_apply_ι_chevalleySystem ρ hnil γ)

/-- The root subgroup acts through the base-changed divided-power exponential of the root
vector. -/
@[simp]
theorem chevalleyRootSubgroup_val (γ : Fin t.numRoots) (A : CommAlgCat ℤ) (u : Multiplicative A) :
    (chevalleyRootSubgroup ρ M hM hnil γ A u).val =
      baseChangeExp (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (t.chevalleySystem ht γ))) M
        (dividedPower_chevalleySystem_smul_mem ρ M hM hnil γ) (Multiplicative.toAdd u) := by
  rw [chevalleyRootSubgroup, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    ← LinearMap.GeneralLinearGroup.generalLinearEquiv_to_linearMap, MulEquiv.apply_symm_apply,
    baseChangeExpHom_apply, baseChangeExpLinearEquiv_toLinearMap]

/-- The all-root Kostant parameter is the Chevalley root subgroup on any lattice stable under
both Kostant forms. -/
theorem kostantRootSubgroupParam_chevalleySystem
    (hAll : ∀ u ∈ kostantForm (t.chevalleySystem ht) (t.lieBasis ht).h,
      ∀ v ∈ M, ρ u v ∈ M)
    (γ : Fin t.numRoots) (A : CommAlgCat ℤ) :
    kostantRootSubgroupParam (t.chevalleySystem ht) (t.lieBasis ht).h ρ M hAll γ
        (isNilpotent_apply_ι_chevalleySystem ρ hnil γ) A =
      chevalleyRootSubgroup ρ M hM hnil γ A := by
  refine MonoidHom.ext fun u => Units.ext <| LinearMap.ext fun z => ?_
  rw [kostantRootSubgroupParam_val_apply, chevalleyRootSubgroup_val]

/-- Root subgroups commute when their roots sum to neither a root nor zero, in every type
and over every commutative value ring. -/
theorem commute_chevalleyRootSubgroup_of_add_notMem {α β : Fin t.numRoots}
    (h : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ∉
      Set.range (t.simplyConnectedRootDatum ht).root)
    (h₀ : (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β ≠ 0)
    (A : CommAlgCat ℤ) (u v : Multiplicative A) :
    Commute (chevalleyRootSubgroup ρ M hM hnil α A u)
      (chevalleyRootSubgroup ρ M hM hnil β A v) := by
  simpa only [kostantRootSubgroupParam_chevalleySystem ρ M hM hnil] using
    commute_kostantRootSubgroupParam _ _ ρ M
      (kostantForm_chevalleySystem_smul_mem ρ M hM hnil)
      (isNilpotent_apply_ι_chevalleySystem ρ hnil α)
      (isNilpotent_apply_ι_chevalleySystem ρ hnil β)
      (lie_chevalleySystem_eq_zero h h₀) A u v

/-- A bracket `⁅e_α, e_β⁆ = c • e_γ` with `e_γ` commuting with both root vectors gives the
one-factor Chevalley commutator formula over every commutative value ring. -/
theorem commutatorElement_chevalleyRootSubgroup_of_lie_eq {α β γ : Fin t.numRoots} {c : ℤ}
    (hαβ : ⁅t.chevalleySystem ht α, t.chevalleySystem ht β⁆ = c • t.chevalleySystem ht γ)
    (hαγ : ⁅t.chevalleySystem ht α, t.chevalleySystem ht γ⁆ = 0)
    (hβγ : ⁅t.chevalleySystem ht β, t.chevalleySystem ht γ⁆ = 0)
    (A : CommAlgCat ℤ) (u v : A) :
    ⁅chevalleyRootSubgroup ρ M hM hnil α A (Multiplicative.ofAdd u),
      chevalleyRootSubgroup ρ M hM hnil β A (Multiplicative.ofAdd v)⁆ =
      chevalleyRootSubgroup ρ M hM hnil γ A
        (Multiplicative.ofAdd ((c : A) * (u * v))) := by
  -- Transport the integral class-two exponential identity, as in
  -- UniversalEnvelopingAlgebra.kostantRootSubgroupPoints_mul_of_lie_eq.
  have hxy := mul_eq_mul_add_zsmul_of_lie_eq ρ hαβ
  have hxz := commute_of_lie_eq_zero ρ hαγ
  have hyz := commute_of_lie_eq_zero ρ hβγ
  have hdp := dividedPower_chevalleySystem_smul_mem ρ M hM hnil
  have hscaled (n : ℕ) (z : V) (hz : z ∈ M) :
      Associative.dividedPower n
        (c • ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ (t.chevalleySystem ht γ))) • z ∈ M := by
    rw [Associative.dividedPower_zsmul, smul_assoc]
    exact M.zsmul_mem (hdp γ n z hz) _
  have hprod :
      chevalleyRootSubgroup ρ M hM hnil α A (Multiplicative.ofAdd u) *
        chevalleyRootSubgroup ρ M hM hnil β A (Multiplicative.ofAdd v) =
      chevalleyRootSubgroup ρ M hM hnil β A (Multiplicative.ofAdd v) *
        chevalleyRootSubgroup ρ M hM hnil γ A
          (Multiplicative.ofAdd ((c : A) * (u * v))) *
        chevalleyRootSubgroup ρ M hM hnil α A (Multiplicative.ofAdd u) := by
    apply Units.ext
    simp only [Units.val_mul, chevalleyRootSubgroup_val, toAdd_ofAdd]
    rw [← baseChangeExp_zsmul c M (hdp γ) hscaled
      (isNilpotent_apply_ι_chevalleySystem ρ hnil γ)]
    exact baseChangeExp_mul_baseChangeExp_of_commutator_eq M hxy
      (hxz.smul_right c) (hyz.smul_right c)
      (isNilpotent_apply_ι_chevalleySystem ρ hnil α)
      (isNilpotent_apply_ι_chevalleySystem ρ hnil β) (hdp α) (hdp β) hscaled u v
  have hcomm (w : A) : Commute
      (chevalleyRootSubgroup ρ M hM hnil β A (Multiplicative.ofAdd v))
      (chevalleyRootSubgroup ρ M hM hnil γ A (Multiplicative.ofAdd w)) := by
    apply Units.ext
    simpa only [Units.val_mul, chevalleyRootSubgroup_val, toAdd_ofAdd] using
      (commute_baseChangeExp M hyz (hdp β) (hdp γ) v w).eq
  rw [commutatorElement_def, hprod, mul_inv_cancel_right, (hcomm _).eq]
  simp

/-- **At a simple root the root subgroup is the simple root subgroup** `xᵢ` of the Kostant data. -/
@[simp]
theorem chevalleyRootSubgroup_simpleIndex (i : Fin t.rank) (A : CommAlgCat ℤ) :
    chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A =
      kostantRootSubgroupParam (t.lieBasis ht).rootGenerator (t.lieBasis ht).h ρ M hM (.inl i)
        (hnil (.inl i)) A := by
  refine MonoidHom.ext fun u => Units.ext <| LinearMap.ext fun z => ?_
  rw [chevalleyRootSubgroup_val, kostantRootSubgroupParam_val_apply]
  exact LinearMap.congr_fun (baseChangeExp_congr (by simp) M _ _ _) z

/-- **At a negative simple root the root subgroup is the simple root subgroup** `x₋ᵢ` of the
Kostant data. -/
@[simp]
theorem chevalleyRootSubgroup_reflectionPerm_simpleIndex (i : Fin t.rank) (A : CommAlgCat ℤ) :
    chevalleyRootSubgroup ρ M hM hnil
        ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) (t.simpleIndex ht i))
        A =
      kostantRootSubgroupParam (t.lieBasis ht).rootGenerator (t.lieBasis ht).h ρ M hM (.inr i)
        (hnil (.inr i)) A := by
  refine MonoidHom.ext fun u => Units.ext <| LinearMap.ext fun z => ?_
  rw [chevalleyRootSubgroup_val, kostantRootSubgroupParam_val_apply]
  exact LinearMap.congr_fun (baseChangeExp_congr (by simp) M _ _ _) z

/-- **The root subgroups are natural in the ring of points.** Scalar extension of automorphisms
along a morphism `φ : A ⟶ B` of value rings carries `x_γ(u)` to `x_γ(φ u)`. -/
theorem mapScalarExtensionAutomorphisms_chevalleyRootSubgroup (γ : Fin t.numRoots)
    {A B : CommAlgCat ℤ} (φ : A ⟶ B) (u : Multiplicative A) :
    GeneralLinear.mapScalarExtensionAutomorphisms (V := M) φ
        (chevalleyRootSubgroup ρ M hM hnil γ A u) =
      chevalleyRootSubgroup ρ M hM hnil γ B
        (Multiplicative.ofAdd (φ.hom (Multiplicative.toAdd u))) := by
  refine (GeneralLinear.eq_mapScalarExtensionAutomorphisms_of_apply_scalarExtensionMap_eq
    φ _ _ fun z => ?_).symm
  rw [chevalleyRootSubgroup_val, chevalleyRootSubgroup_val, toAdd_ofAdd,
    GeneralLinear.scalarExtensionMap_eq_map]
  exact (map_baseChangeExp_algHom φ.hom _ M _ _ z).symm

/-- **Conjugating a root subgroup by a simple Weyl element.** Over every ring of points,
`nᵢ x_γ(u) nᵢ⁻¹ = x_{sᵢ γ}(ε u)` for Chevalley's Weyl element `nᵢ = xᵢ(1) x₋ᵢ(-1) xᵢ(1)` of the
simple root `αᵢ` and the sign `ε = chevalleyWeylSign αᵢ γ` of `w_{αᵢ} e_γ = ε e_{sᵢ γ}`. -/
theorem kostantWeylGL_conj_chevalleyRootSubgroup (i : Fin t.rank) (γ : Fin t.numRoots)
    (A : CommAlgCat ℤ) (u : A) :
    kostantWeylGL (t.lieBasis ht).rootGenerator (t.lieBasis ht).h ρ M hM (hnil (.inl i))
          (hnil (.inr i)) A *
        chevalleyRootSubgroup ρ M hM hnil γ A (Multiplicative.ofAdd u) *
        (kostantWeylGL (t.lieBasis ht).rootGenerator (t.lieBasis ht).h ρ M hM (hnil (.inl i))
          (hnil (.inr i)) A)⁻¹ =
      chevalleyRootSubgroup ρ M hM hnil
        ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ) A
        (Multiplicative.ofAdd (((t.chevalleyWeylSign ht (t.simpleIndex ht i) γ : ℤ) : A) * u)) := by
  refine Units.ext ?_
  rw [Units.val_mul, Units.val_mul, kostantWeylGL_val, kostantWeylGL_inv_val,
    chevalleyRootSubgroup_val, chevalleyRootSubgroup_val, toAdd_ofAdd, toAdd_ofAdd,
    kostantWeylPoints_conj_baseChangeExp_weylAut _ _ ρ M hM (hnil (.inl i)) (hnil (.inr i))
      ((t.lieBasis ht).isSl2Triple_rootGenerator i)
      (isNilpotent_ad_rootGenerator_inl i).exists_pow_apply_eq_zero
      (isNilpotent_ad_rootGenerator_inr i).exists_pow_apply_eq_zero
      (dividedPower_chevalleySystem_smul_mem ρ M hM hnil γ)
      (isNilpotent_apply_ι_chevalleySystem ρ hnil γ)]
  have hw : ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ
      (weylAut ((t.lieBasis ht).isSl2Triple_rootGenerator i)
        (isNilpotent_ad_rootGenerator_inl i).exists_pow_apply_eq_zero
        (isNilpotent_ad_rootGenerator_inr i).exists_pow_apply_eq_zero (t.chevalleySystem ht γ))) =
      (t.chevalleyWeylSign ht (t.simpleIndex ht i) γ : ℤ) • ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ
        (t.chevalleySystem ht ((t.simplyConnectedRootDatum ht).reflectionPerm
          (t.simpleIndex ht i) γ))) := by
    rw [← weylAut_simpleIndex_eq i _ (isNilpotent_ad_rootGenerator_inl i)
      (isNilpotent_ad_rootGenerator_inr i), weylAut_chevalleySystem, map_zsmul, map_zsmul]
  exact (baseChangeExp_congr hw M _
    (hw ▸ fun n => dividedPower_weylAut_smul_mem _ _ ρ M hM (hnil (.inl i)) (hnil (.inr i))
      ((t.lieBasis ht).isSl2Triple_rootGenerator i)
      (isNilpotent_ad_rootGenerator_inl i).exists_pow_apply_eq_zero
      (isNilpotent_ad_rootGenerator_inr i).exists_pow_apply_eq_zero n
      (dividedPower_chevalleySystem_smul_mem ρ M hM hnil γ n)) u).trans
    (baseChangeExp_zsmul _ M (dividedPower_chevalleySystem_smul_mem ρ M hM hnil _) _
      (isNilpotent_apply_ι_chevalleySystem ρ hnil _) u)

/-- Conjugation by a simple Weyl representative carries an entire root subgroup onto the
reflected root subgroup, independently of the sign in its parameter formula. -/
@[simp]
theorem map_range_chevalleyRootSubgroup_conj_kostantWeylGL
    (i : Fin t.rank) (γ : Fin t.numRoots) (A : CommAlgCat ℤ) :
    Subgroup.map (MulAut.conj (kostantWeylGL (t.lieBasis ht).rootGenerator
        (t.lieBasis ht).h ρ M hM (hnil (.inl i)) (hnil (.inr i)) A))
      (chevalleyRootSubgroup ρ M hM hnil γ A).range =
    (chevalleyRootSubgroup ρ M hM hnil
      ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) γ) A).range := by
  set ε : A := ((t.chevalleyWeylSign ht (t.simpleIndex ht i) γ : ℤ) : A)
  have hε : ε * ε = 1 := by
    simp [ε, ← Int.cast_mul, ← Units.val_mul]
  ext g
  simp only [Subgroup.mem_map, MonoidHom.mem_range, MonoidHom.coe_ofClass,
    MulAut.conj_apply]
  constructor
  · rintro ⟨_, ⟨u, rfl⟩, rfl⟩
    exact ⟨Multiplicative.ofAdd (ε * Multiplicative.toAdd u),
      (kostantWeylGL_conj_chevalleyRootSubgroup ρ M hM hnil i γ A _).symm⟩
  · rintro ⟨u, rfl⟩
    refine ⟨chevalleyRootSubgroup ρ M hM hnil γ A
      (Multiplicative.ofAdd (ε * Multiplicative.toAdd u)), ⟨_, rfl⟩, ?_⟩
    rw [kostantWeylGL_conj_chevalleyRootSubgroup]
    dsimp only [ε] at hε ⊢
    simp only [← mul_assoc, hε, one_mul, ofAdd_toAdd]

/-- A simple Weyl representative carries the group generated by any set of root subgroups
onto the group generated by the reflected set of roots. -/
theorem map_iSup_chevalleyRootSubgroup_conj_kostantWeylGL
    (i : Fin t.rank) (S : Set (Fin t.numRoots)) (A : CommAlgCat ℤ) :
    Subgroup.map (MulAut.conj (kostantWeylGL (t.lieBasis ht).rootGenerator
        (t.lieBasis ht).h ρ M hM (hnil (.inl i)) (hnil (.inr i)) A))
      (⨆ γ ∈ S, (chevalleyRootSubgroup ρ M hM hnil γ A).range) =
    ⨆ γ ∈ (t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) '' S,
      (chevalleyRootSubgroup ρ M hM hnil γ A).range := by
  simp only [Subgroup.map_iSup,
    map_range_chevalleyRootSubgroup_conj_kostantWeylGL, iSup_image]

/-- **Every root subgroup lies in the elementary group** generated by the root subgroups of the
simple roots and their negatives. -/
theorem chevalleyRootSubgroup_mem_kostantElementarySubgroup (γ : Fin t.numRoots)
    (A : CommAlgCat ℤ) (u : Multiplicative A) :
    chevalleyRootSubgroup ρ M hM hnil γ A u ∈
      kostantElementarySubgroup (t.lieBasis ht).rootGenerator (t.lieBasis ht).h ρ M hM hnil A := by
  set E := kostantElementarySubgroup (t.lieBasis ht).rootGenerator (t.lieBasis ht).h ρ M hM hnil A
  -- conjugation by the simple Weyl element `nᵢ ∈ E` carries the root subgroup of `k` onto that of
  -- `sᵢ k`, because the sign `ε` squares to one
  have step (i : Fin t.rank) (k : Fin t.numRoots)
      (hk : ∀ u, chevalleyRootSubgroup ρ M hM hnil k A u ∈ E)
      (u : Multiplicative A) :
      chevalleyRootSubgroup ρ M hM hnil
        ((t.simplyConnectedRootDatum ht).reflectionPerm (t.simpleIndex ht i) k) A u ∈ E := by
    set ε := t.chevalleyWeylSign ht (t.simpleIndex ht i) k
    have hε : ((ε : ℤ) : A) * ((ε : ℤ) : A) = 1 := by
      simp [← Int.cast_mul, ← Units.val_mul]
    have hu :
        u = Multiplicative.ofAdd (((ε : ℤ) : A) * (((ε : ℤ) : A) * Multiplicative.toAdd u)) := by
      simp [← mul_assoc, hε]
    have hn := kostantWeylGL_mem_kostantElementarySubgroup (t.lieBasis ht).rootGenerator
      (t.lieBasis ht).h ρ M hM hnil (.inl i) (.inr i) A
    rw [hu, ← kostantWeylGL_conj_chevalleyRootSubgroup]
    exact mul_mem (mul_mem hn (hk _)) (inv_mem hn)
  refine (t.rationalBase ht).induction_simple_reflect γ
    (p := fun k => ∀ u, chevalleyRootSubgroup ρ M hM hnil k A u ∈ E)
    (fun k hk => ?_) (fun k j hk hj => ?_) u
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hk
    simpa using kostantRootSubgroupParam_mem_kostantElementarySubgroup _ _ ρ M hM hnil A (.inl i)
  · obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hj
    simpa only [reflectionPerm_rationalRootSystem] using step i k hk

end Lattice

end

end TauCeti.DynkinType
