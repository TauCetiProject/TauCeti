module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Subgroup
import TauCeti.LinearAlgebra.RootSystem.Weyl.Orbit.Basic

/-!
# Every root subgroup is a signed conjugate of a simple one

On a Kostant-stable lattice, every root subgroup is conjugate to a positive simple-root
subgroup by a finite product of simple Weyl representatives. The conjugacy retains an integral
sign in the additive parameter. The same word and sign work over every commutative value ring,
including nonreduced rings and rings of small characteristic.

`exists_simple_weyl_word_conj_chevalleyRootSubgroup` supplies both the root-index equation
and the parameter equation for that word. This is stronger than membership in the subgroup
generated by the simple roots: it allows properties of an individual root map, such as
injectivity, to be transported from a simple root without a generation theorem for the ambient
point group. The injectivity consequence only needs the positive simple-root maps.

The construction uses the simple-reflection orbit induction and the signed conjugation formula
`kostantWeylGL_conj_chevalleyRootSubgroup` from the imported root-subgroup construction.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 19.
* R. W. Carter, *Simple Groups of Lie Type*, §6.4.
-/

public section

namespace TauCeti.DynkinType

open TensorProduct TauCeti.UniversalEnvelopingAlgebra

universe v w

-- Use the integral module structure of each bundled value algebra in tensor products.
attribute [local instance high] Algebra.toModule

variable {t : DynkinType} {ht : t.Valid}
variable {V : Type v} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ z ∈ kostantForm (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
  ∀ m ∈ M, ρ z m ∈ M)
variable (hnil : ∀ i, IsNilpotent
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

/-- Every root subgroup is a conjugate of a positive simple-root subgroup by a word of simple
Weyl representatives, with one integral sign in its parameter. The same word sends the simple
root index to the specified root index and works over every commutative value ring. Products
act rightmost first, both on indices and by conjugation. -/
theorem exists_simple_weyl_word_conj_chevalleyRootSubgroup (γ : Fin t.numRoots) :
    ∃ (l : List (Fin t.rank)) (i : Fin t.rank) (ε : ℤˣ),
      (l.map (fun j => (t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht j))).prod (t.simpleIndex ht i) = γ ∧
      ∀ (A : CommAlgCat.{w} ℤ) (u : A),
        (l.map (fun j => kostantWeylGL (t.lieBasis ht).rootGenerator (t.lieBasis ht).h
          ρ M hM (hnil (.inl j)) (hnil (.inr j)) A)).prod *
          chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A (Multiplicative.ofAdd u) *
          ((l.map (fun j => kostantWeylGL (t.lieBasis ht).rootGenerator (t.lieBasis ht).h
            ρ M hM (hnil (.inl j)) (hnil (.inr j)) A)).prod)⁻¹ =
        chevalleyRootSubgroup ρ M hM hnil γ A
          (Multiplicative.ofAdd (((ε : ℤ) : A) * u)) := by
  induction γ using (t.rationalBase ht).induction_simple_reflect with
  | h₁ k hk =>
    obtain ⟨i, rfl⟩ := exists_simpleIndex_eq_of_mem_support hk
    exact ⟨[], i, 1, by simp, by intro A u; simp⟩
  | h₂ k j hk hj =>
    obtain ⟨j, rfl⟩ := exists_simpleIndex_eq_of_mem_support hj
    obtain ⟨l, i, ε, hl, hconj⟩ := hk
    simp only [reflectionPerm_rationalRootSystem]
    refine ⟨j :: l, i, t.chevalleyWeylSign ht (t.simpleIndex ht j) k * ε, ?_, ?_⟩
    · simpa using congrArg ((t.simplyConnectedRootDatum ht).reflectionPerm
        (t.simpleIndex ht j)) hl
    · intro A u
      simp only [List.map_cons, List.prod_cons]
      have hassoc (n g x : LinearMap.GeneralLinearGroup A (A ⊗[ℤ] M)) :
          (n * g) * x * (n * g)⁻¹ = n * (g * x * g⁻¹) * n⁻¹ := by
        simp only [mul_inv_rev, mul_assoc]
      rw [hassoc, hconj, kostantWeylGL_conj_chevalleyRootSubgroup]
      simp only [Units.val_mul, Int.cast_mul, mul_assoc]

/-- Injectivity of the positive simple-root parameters implies injectivity of every root
parameter over the same commutative value ring. No generation or faithfulness assumption on
the ambient point group is needed. -/
theorem chevalleyRootSubgroup_injective_of_simple (A : CommAlgCat.{w} ℤ)
    (hinj : ∀ i : Fin t.rank, Function.Injective
      (chevalleyRootSubgroup ρ M hM hnil (t.simpleIndex ht i) A)) (γ : Fin t.numRoots) :
    Function.Injective (chevalleyRootSubgroup ρ M hM hnil γ A) := by
  obtain ⟨l, i, ε, _, hconj⟩ :=
    exists_simple_weyl_word_conj_chevalleyRootSubgroup ρ M hM hnil γ
  have hε : ((ε : ℤ) : A) * ((ε : ℤ) : A) = 1 := by
    simp [← Int.cast_mul, ← Units.val_mul]
  intro u v h
  have hu := hconj A (((ε : ℤ) : A) * Multiplicative.toAdd u)
  have hv := hconj A (((ε : ℤ) : A) * Multiplicative.toAdd v)
  simp only [← mul_assoc, hε, one_mul, ofAdd_toAdd] at hu hv
  have hi := hinj i (mul_left_cancel (mul_right_cancel (hu.trans (h.trans hv.symm))))
  have hout := congrArg (fun z : Multiplicative A =>
    Multiplicative.ofAdd (((ε : ℤ) : A) * Multiplicative.toAdd z)) hi
  simpa only [toAdd_ofAdd, ← mul_assoc, hε, one_mul, ofAdd_toAdd] using hout

end TauCeti.DynkinType
