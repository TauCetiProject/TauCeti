module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.StructureConstant
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.Root.Subgroup
import TauCeti.RingTheory.Nilpotent.ChevalleyCommutator

/-!
# Class-two commutators of native Chevalley root subgroups

For any valid Dynkin type, when `γ = α + β` and the root vector `e_γ` commutes with both
`e_α` and `e_β`, the native root subgroups satisfy
`⁅x_α(u), x_β(v)⁆ = x_γ(N_{α,β}uv)` over every commutative coefficient ring. Only nilpotence
of the simple generators and stability under their Kostant form are required.

The proof transports `TauCeti.baseChangeExp_mul_baseChangeExp_of_commutator_eq` through the
native all-root subgroup construction. It uses the Weyl-transported divided-power stability,
so it does not require a Kostant form generated by all the root vectors.

## Main results

* `TauCeti.DynkinType.commutatorElement_chevalleyRootSubgroup_of_lie_eq_zero`: the class-two
  commutator formula for arbitrary valid Dynkin types and Kostant-stable lattices.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 15.
* R. W. Carter, *Simple Groups of Lie Type*, Theorem 5.2.2.
-/

public section

namespace TauCeti.DynkinType

open TauCeti.UniversalEnvelopingAlgebra TensorProduct
open scoped commutatorElement

noncomputable section

variable {t : DynkinType} {ht : t.Valid}
variable {V : Type*} [AddCommGroup V] [Module ℚ V]
variable (ρ : _root_.UniversalEnvelopingAlgebra ℚ (t.lieAlgebra ht) →ₐ[ℚ] Module.End ℚ V)
variable (M : AddSubgroup V)
variable (hM : ∀ a ∈ kostantForm (t.lieBasis ht).rootGenerator (t.lieBasis ht).h,
  ∀ v ∈ M, ρ a v ∈ M)
variable (hnil : ∀ i, IsNilpotent
  (ρ (_root_.UniversalEnvelopingAlgebra.ι ℚ ((t.lieBasis ht).rootGenerator i))))

-- Match the scalar action on tensor products to the value algebra's stored instance.
attribute [local instance high] Algebra.toModule

/-- If `γ = α + β` and `e_γ` commutes with both summands, the native root-subgroup commutator
has the single factor `x_γ(N_{α,β}uv)` over any commutative coefficient ring. -/
theorem commutatorElement_chevalleyRootSubgroup_of_lie_eq_zero {α β γ : Fin t.numRoots}
    (hadd : (t.simplyConnectedRootDatum ht).root γ =
      (t.simplyConnectedRootDatum ht).root α + (t.simplyConnectedRootDatum ht).root β)
    (hαγ : ⁅t.chevalleySystem ht α, t.chevalleySystem ht γ⁆ = 0)
    (hβγ : ⁅t.chevalleySystem ht β, t.chevalleySystem ht γ⁆ = 0)
    (A : CommAlgCat ℤ) (u v : A) :
    ⁅chevalleyRootSubgroup ρ M hM hnil α A (Multiplicative.ofAdd u),
        chevalleyRootSubgroup ρ M hM hnil β A (Multiplicative.ofAdd v)⁆ =
      chevalleyRootSubgroup ρ M hM hnil γ A
        (Multiplicative.ofAdd ((t.structureConstant ht α β : A) * (u * v))) := by
  have hαβ := lie_chevalleySystem_eq_structureConstant_zsmul hadd
  -- Absorb the integral structure constant into the exponential parameter.
  have hscaled := dividedPower_zsmul_chevalleySystem_smul_mem ρ M hM hnil
    (t.structureConstant ht α β) γ
  -- The existing integral exponential identity supplies the product relation.
  -- Using preserved divided powers directly avoids requiring a finite-dimensional Lie module.
  have hprod :
      chevalleyRootSubgroup ρ M hM hnil α A (Multiplicative.ofAdd u) *
          chevalleyRootSubgroup ρ M hM hnil β A (Multiplicative.ofAdd v) =
        chevalleyRootSubgroup ρ M hM hnil β A (Multiplicative.ofAdd v) *
          chevalleyRootSubgroup ρ M hM hnil γ A
            (Multiplicative.ofAdd ((t.structureConstant ht α β : A) * (u * v))) *
          chevalleyRootSubgroup ρ M hM hnil α A (Multiplicative.ofAdd u) := by
    apply Units.ext
    simp only [Units.val_mul, chevalleyRootSubgroup_val, toAdd_ofAdd]
    rw [← baseChangeExp_zsmul (t.structureConstant ht α β) M
      (dividedPower_chevalleySystem_smul_mem ρ M hM hnil γ) hscaled
      (isNilpotent_apply_ι_chevalleySystem ρ hnil γ)]
    exact baseChangeExp_mul_baseChangeExp_of_commutator_eq M
      (mul_eq_mul_add_zsmul_of_lie_eq ρ hαβ)
      ((commute_of_lie_eq_zero ρ hαγ).smul_right _)
      ((commute_of_lie_eq_zero ρ hβγ).smul_right _)
      (isNilpotent_apply_ι_chevalleySystem ρ hnil α)
      (isNilpotent_apply_ι_chevalleySystem ρ hnil β) _ _ hscaled u v
  -- The central third factor turns that product relation into the canonical commutator.
  have hcomm : Commute
      (chevalleyRootSubgroup ρ M hM hnil β A (Multiplicative.ofAdd v))
      (chevalleyRootSubgroup ρ M hM hnil γ A
        (Multiplicative.ofAdd ((t.structureConstant ht α β : A) * (u * v)))) := by
    apply Units.ext
    simp only [Units.val_mul, chevalleyRootSubgroup_val, toAdd_ofAdd]
    exact commute_baseChangeExp M (commute_of_lie_eq_zero ρ hβγ) _ _ _ _
  rw [commutatorElement_def, hprod, mul_inv_cancel_right, hcomm.eq, mul_inv_cancel_right]

end

end TauCeti.DynkinType
