module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.LieAlgebra.SimplyConnectedModule.Lattice
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure.Generation
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Torus.Coroot

/-!
# Root generation of the full-weight toral closure

The full-weight module `V_sc(t) = ⨁ᵢ L(ϖᵢ)` carries an admissible lattice with a weight basis.
Its weight torus is parametrized by the fundamental-weight coordinates. Over every commutative
ring, that torus is already in the elementary subgroup generated by the numbered positive and
negative simple-root subgroups: each coordinate cocharacter is the coroot word
`xᵢ(u) x₋ᵢ(-u⁻¹) xᵢ(u) nᵢ(1)⁻¹`.

This file applies the generic Kostant coroot theorem to the full-weight module. Faithfulness
ensures that its represented simple generators form nonzero `sl₂` triples. No condition on the
Cartan rows is imposed, so rank one and the long roots of multiply-laced types are included.

Evaluating the torus containment at the universal torus point also identifies the integral
root-generated and toral-closure defining Hopf ideals. The canonical inclusion of the former
scheme in the latter is therefore an isomorphism, and morphisms out of this toral closure are
determined by the numbered root subgroups alone. This does not identify all ring-valued points
with the elementary subgroup, or identify a non-flat base change with the subgroup scheme
generated anew after specialization.

The construction uses
`TauCeti.UniversalEnvelopingAlgebra.kostantTorusSubgroup_le_kostantElementarySubgroup`
and the universal-torus criterion in `Kostant.RootSubgroup.Scheme.ToralClosure.Generation`.
The scheme-theoretic application follows the existing
`TauCeti.Algebra.Lie.E7.Minuscule.Generation` proof pattern.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 3, Lemma 20 and Corollary 5.
* R. W. Carter, *Simple Groups of Lie Type*, §§6.4 and 7.1.
-/

public section

namespace TauCeti.DynkinType

open TauCeti.UniversalEnvelopingAlgebra CategoryTheory

universe v

attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance high] Algebra.toModule

variable (t : DynkinType) (ht : t.Valid)

local notation "rootGen" => LieAlgebra.Basis.rootGenerator (t.lieBasis ht)
local notation "cartanGen" => LieAlgebra.Basis.h (t.lieBasis ht)
local notation "rep" => representation ℚ (t.lieAlgebra ht) (t.scModule ht)
local notation "lattice" => Submodule.toAddSubgroup (t.scLattice ht)
local notation "stable" => t.kostantForm_apply_mem_scLattice ht
local notation "nilpotent" => t.isNilpotent_representation_scModule_rootGenerator ht
local notation "basis" => t.scWeightBasis ht
local notation "weight" => t.scWeight ht

/-- The represented positive and negative simple generators on the full-weight module form
an `sl₂` triple at each Cartan coordinate. -/
private theorem isSl2Triple_representation_scModule (i : Fin t.rank) :
    IsSl2Triple (rep (_root_.UniversalEnvelopingAlgebra.ι ℚ (cartanGen i)))
      (rep (_root_.UniversalEnvelopingAlgebra.ι ℚ (rootGen (.inl i))))
      (rep (_root_.UniversalEnvelopingAlgebra.ι ℚ (rootGen (.inr i)))) := by
  simp only [representation_ι]
  have hfaith : Function.Injective (LieModule.toEnd ℚ (t.lieAlgebra ht) (t.scModule ht)) :=
    LieModule.IsFaithful.injective_toEnd
  exact ((t.lieBasis ht).isSl2Triple_rootGenerator i).map
    (LieModule.toEnd ℚ (t.lieAlgebra ht) (t.scModule ht))
    (by simpa only [map_zero] using hfaith.ne ((t.lieBasis ht).sl2 i).h_ne_zero)

/-- Over every commutative ring, the weight torus of the full-weight lattice lies in the
elementary subgroup generated by the numbered positive and negative simple-root subgroups. -/
theorem scWeightTorusSubgroup_le_elementarySubgroup (A : CommAlgCat.{v} ℤ) :
    kostantTorusSubgroup lattice basis weight A ≤
      kostantElementarySubgroup rootGen cartanGen rep lattice stable nilpotent A := by
  exact kostantTorusSubgroup_le_kostantElementarySubgroup
    rootGen cartanGen rep lattice stable nilpotent basis weight
    (t.isCartanWeightVector_scWeightBasis ht)
    (t.rootGeneratorWeight ht) (t.lie_lieBasis_h_rootGenerator ht)
    Sum.inl Sum.inr (t.isSl2Triple_representation_scModule ht)
    (fun i => by funext j; simp) A

/-- Each torus point on the full-weight lattice is a product of numbered root elements. -/
theorem scWeightTorusPoints_mem_elementarySubgroup (A : CommAlgCat.{v} ℤ)
    (s : Fin t.rank → Aˣ) :
    kostantTorusPoints lattice basis weight A s ∈
      kostantElementarySubgroup rootGen cartanGen rep lattice stable nilpotent A := by
  exact ((kostantTorusSubgroup_eq_range lattice basis weight A).symm.trans_le
    (t.scWeightTorusSubgroup_le_elementarySubgroup ht A)) ⟨s, rfl⟩

/-- Adjoining the weight torus to all numbered root subgroups of the full-weight lattice does
not enlarge the elementary subgroup, over every commutative ring. -/
theorem scWeightTorusSubsystemSubgroup_univ_eq_elementarySubgroup (A : CommAlgCat.{v} ℤ) :
    kostantTorusSubsystemSubgroup rootGen cartanGen rep lattice stable nilpotent basis weight
        Set.univ A =
      kostantElementarySubgroup rootGen cartanGen rep lattice stable nilpotent A := by
  exact kostantTorusSubsystemSubgroup_univ_eq_kostantElementarySubgroup
    rootGen cartanGen rep lattice stable nilpotent basis weight
    (t.isCartanWeightVector_scWeightBasis ht)
    (t.rootGeneratorWeight ht) (t.lie_lieBasis_h_rootGenerator ht)
    Sum.inl Sum.inr (t.isSl2Triple_representation_scModule ht)
    (fun i => by funext j; simp) A

/-- Adjoining the full-weight torus does not change the integral defining Hopf ideal of the
scheme generated by the numbered root subgroups. -/
theorem scToralDefiningIdeal_eq_generated :
    kostantToralDefiningIdeal rootGen cartanGen rep lattice stable nilpotent basis weight =
      kostantGeneratedDefiningIdeal rootGen cartanGen rep lattice stable nilpotent basis :=
  kostantToralDefiningIdeal_eq_kostantGeneratedDefiningIdeal_of_universal_torus_mem_elementary
    rootGen cartanGen rep lattice stable nilpotent basis weight
    (t.scWeightTorusPoints_mem_elementarySubgroup ht _ _)

/-- The integral full-weight toral closure equals the scheme generated by the numbered
positive and negative simple-root subgroups. -/
theorem scToralGroupScheme_eq_generated :
    kostantToralGroupScheme rootGen cartanGen rep lattice stable nilpotent basis weight =
      kostantGeneratedGroupScheme rootGen cartanGen rep lattice stable nilpotent basis :=
  kostantToralGroupScheme_eq_kostantGeneratedGroupScheme_of_universal_torus_mem_elementary
    rootGen cartanGen rep lattice stable nilpotent basis weight
    (t.scWeightTorusPoints_mem_elementarySubgroup ht _ _)

/-- The canonical inclusion of the root-generated full-weight carrier into its toral closure
is an isomorphism. -/
instance isIso_scGeneratedToToral :
    IsIso (kostantGeneratedToToral rootGen cartanGen rep lattice stable nilpotent basis weight) :=
  isIso_kostantGeneratedToToral_of_universal_torus_mem_elementary
    rootGen cartanGen rep lattice stable nilpotent basis weight
    (t.scWeightTorusPoints_mem_elementarySubgroup ht _ _)

/-- The transported integral toral and root-generated ideals agree after base change to any
commutative ring. This does not assert equality with the ideal generated anew over that ring. -/
theorem scToralBaseChangePresentationIdeal_eq_generated (A : Type v) [CommRing A] :
    kostantToralBaseChangePresentationIdeal rootGen cartanGen rep lattice stable nilpotent
        basis weight A =
      kostantGeneratedGeneralLinearBaseChangeIdeal rootGen cartanGen rep lattice stable
        nilpotent basis A :=
  kostantToralBaseChangePresentationIdeal_eq_generated_of_definingIdeal_eq
    rootGen cartanGen rep lattice stable nilpotent basis weight A
    (t.scToralDefiningIdeal_eq_generated ht)

/-- Morphisms from the full-weight toral closure to an affine group scheme are determined by
the numbered positive and negative simple-root subgroups, with no separate torus condition. -/
theorem scToralGroupScheme_hom_ext_of_rootSubgroup {Y : _root_.CommHopfAlgCat.{0} ℤ}
    (f g : kostantToralGroupScheme rootGen cartanGen rep lattice stable nilpotent basis weight ⟶
      (AlgebraicGeometry.hopfSpec (CommRingCat.of ℤ)).obj (Opposite.op Y))
    (hroot : ∀ i, kostantRootSubgroupToToral rootGen cartanGen rep lattice stable nilpotent
      basis weight i ≫ f =
        kostantRootSubgroupToToral rootGen cartanGen rep lattice stable nilpotent
          basis weight i ≫ g) :
    f = g :=
  kostantToralGroupScheme_hom_ext_of_isIso_kostantGeneratedToToral
    rootGen cartanGen rep lattice stable nilpotent basis weight f g hroot

end TauCeti.DynkinType
