module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.ToralClosure.Subsystem.Basic
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.ClosedRootSubgroup
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.Torus

/-!
# The positive subgroup scheme of the pinned Geck carrier

For a valid Dynkin type, the Geck carrier is the closed subgroup scheme of a general linear group
generated by its numbered positive and negative simple-root subgroups and its represented weight
torus.  This file constructs the corresponding **positive carrier**, generated only by the
positive simple-root subgroups and the same torus, and embeds it as a closed subgroup scheme of the
full Geck carrier.

The construction specializes the universal property of Kostant torus-subsystem closures.  Thus
the positive carrier is not merely a family of abstract subgroups on points: it is an affine group
scheme over `ℤ`, with canonical factorizations of the weight torus and of every positive simple-root
subgroup.  Its inclusion into the full carrier recovers the already named Geck morphisms.

This is the scheme-theoretic candidate for the Borel member of a pinning.  It is not called a Borel
subgroup here: smoothness, connectedness, and maximality among solvable subgroup schemes have not
yet been proved.  The pointwise subgroup generated by the weight torus and raising root subgroups
is proved solvable, while its torus-free positive part is proved nilpotent, in
`TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.Borel`.

## Main definitions

* `TauCeti.DynkinType.geckTorusPositiveDefiningIdeal`: the common-kernel Hopf ideal of the
  positive simple-root maps and the weight torus.
* `TauCeti.DynkinType.geckTorusPositiveGroupScheme`: the corresponding affine group scheme.
* `TauCeti.DynkinType.geckTorusPositiveInclusion`: its closed immersion into the full Geck
  carrier.
* `TauCeti.DynkinType.geckRootSubgroupToTorusPositive`: a positive simple-root subgroup factored
  through the positive carrier.
* `TauCeti.DynkinType.geckWeightTorusToTorusPositive`: the weight torus factored through the
  positive carrier.
* `TauCeti.DynkinType.geckTorusPositiveClosedSubgroup`: the positive carrier bundled as a closed
  subgroup scheme of the Geck carrier.

## Main results

* `TauCeti.DynkinType.le_geckTorusPositiveDefiningIdeal_iff` characterizes the defining ideal by
  the positive root and weight-torus coordinate maps.
* `TauCeti.DynkinType.geckRootSubgroupToTorusPositive_comp_geckTorusPositiveInclusion` and
  `TauCeti.DynkinType.geckWeightTorusToTorusPositive_comp_geckTorusPositiveInclusion` identify the
  factored maps with the named morphisms into the full Geck carrier.
* `TauCeti.DynkinType.geckTorusPositiveClosedSubgroup_le_iff` is the positive carrier's minimality
  characterization among closed subgroup schemes.
* `TauCeti.DynkinType.geckTorusPositiveGroupScheme_hom_ext` gives extensionality on the positive
  simple-root subgroups and the weight torus.

## References

* M. Geck, *On the construction of semisimple Lie algebras and Chevalley groups*,
  Proc. Amer. Math. Soc. **145** (2017), 3233--3247.
* R. W. Carter, *Simple Groups of Lie Type*, §§4.4, 7.1 and 8.2.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26--28.
-/

public section

open AlgebraicGeometry CategoryTheory

namespace TauCeti.DynkinType

noncomputable section

variable (t : DynkinType) (ht : t.Valid)

/-! ## The positive carrier and its inclusion -/

/-- **The defining Hopf ideal of the positive Geck carrier.** It is the largest Hopf ideal in the
coordinate algebra of the ambient general linear group killed by the positive simple-root maps and
the represented weight-torus map. -/
def geckTorusPositiveDefiningIdeal :
    HopfIdeal ℤ (GeneralLinear.coordinateHopfAlgebra ℤ (t.geckDim ht)) :=
  UniversalEnvelopingAlgebra.kostantTorusSubsystemDefiningIdeal
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
    (t.geckCoordinateLattice ht).toAddSubgroup
    (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
    (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht) (Set.range Sum.inl)
    (fun i => t.isNilpotent_geckRepresentation_rootGenerator ht i.1)

/-- The positive defining ideal is the Kostant common-kernel ideal for the positive simple roots. -/
theorem geckTorusPositiveDefiningIdeal_def :
    t.geckTorusPositiveDefiningIdeal ht =
      UniversalEnvelopingAlgebra.kostantTorusSubsystemDefiningIdeal
        (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
        (t.geckCoordinateLattice ht).toAddSubgroup
        (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
        (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht) (Set.range Sum.inl)
        (fun i => t.isNilpotent_geckRepresentation_rootGenerator ht i.1) := (rfl)

/-- **Coordinate universal property of the positive Geck carrier.** A Hopf ideal is contained in
the positive defining ideal exactly when every positive simple-root coordinate map and the weight
torus coordinate map kill it. -/
theorem le_geckTorusPositiveDefiningIdeal_iff
    (J : HopfIdeal ℤ (GeneralLinear.coordinateHopfAlgebra ℤ (t.geckDim ht))) :
    J ≤ t.geckTorusPositiveDefiningIdeal ht ↔
      (∀ i : Fin t.rank, J.toIdeal ≤ RingHom.ker
        (UniversalEnvelopingAlgebra.kostantRootSubgroupCoordinateMap
          (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
          (t.geckCoordinateLattice ht).toAddSubgroup
          (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht) (.inl i)
          (t.isNilpotent_geckRepresentation_rootGenerator ht (.inl i))
          (t.geckCoordinateBasisFin ht)).hom.toAlgHom.toRingHom) ∧
      J.toIdeal ≤ RingHom.ker
        (GeneralLinear.weightTorusCoordinateMap
          (t.geckWeightFin ht)).hom.toAlgHom.toRingHom := by
  rw [geckTorusPositiveDefiningIdeal_def]
  have hiff := UniversalEnvelopingAlgebra.le_kostantTorusSubsystemDefiningIdeal_iff
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
    (t.geckCoordinateLattice ht).toAddSubgroup
    (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
    (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht) (Set.range Sum.inl)
    (fun i => t.isNilpotent_geckRepresentation_rootGenerator ht i.1) J
  constructor
  · intro hJ
    have h := hiff.mp hJ
    exact ⟨fun i => h.1 (.inl i) (Set.mem_range_self i), h.2⟩
  · rintro ⟨hroot, htorus⟩
    apply hiff.mpr
    refine ⟨?_, htorus⟩
    intro i hi
    obtain ⟨j, rfl⟩ := hi
    exact hroot j

/-- The full Geck defining ideal is contained in the positive defining ideal.  Contravariantly,
this is the closed inclusion of the positive carrier into the full carrier. -/
theorem geckDefiningIdeal_le_geckTorusPositiveDefiningIdeal :
    t.geckDefiningIdeal ht ≤ t.geckTorusPositiveDefiningIdeal ht := by
  rw [geckDefiningIdeal_def, geckTorusPositiveDefiningIdeal_def]
  exact UniversalEnvelopingAlgebra.kostantToralDefiningIdeal_le_kostantTorusSubsystemDefiningIdeal
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
    (t.geckCoordinateLattice ht).toAddSubgroup
    (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
    (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht)
    (t.isNilpotent_geckRepresentation_rootGenerator ht) (Set.range Sum.inl)

/-- **The positive subgroup scheme of the Geck carrier**: the closed subgroup scheme generated by
the positive simple-root subgroups and the represented weight torus. -/
noncomputable def geckTorusPositiveGroupScheme : Grp (Over (Spec (CommRingCat.of ℤ))) :=
  UniversalEnvelopingAlgebra.kostantTorusSubsystemGroupScheme
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
    (t.geckCoordinateLattice ht).toAddSubgroup
    (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
    (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht) (Set.range Sum.inl)
    (fun i => t.isNilpotent_geckRepresentation_rootGenerator ht i.1)

/-- The positive Geck carrier is the Kostant torus-subsystem group scheme for the positive simple
roots. -/
theorem geckTorusPositiveGroupScheme_def :
    t.geckTorusPositiveGroupScheme ht =
      UniversalEnvelopingAlgebra.kostantTorusSubsystemGroupScheme
        (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
        (t.geckCoordinateLattice ht).toAddSubgroup
        (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
        (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht) (Set.range Sum.inl)
        (fun i => t.isNilpotent_geckRepresentation_rootGenerator ht i.1) := (rfl)

/-- The positive Geck carrier is the quotient spectrum cut out by its named defining ideal. -/
theorem geckTorusPositiveGroupScheme_eq_quotientSpec :
    t.geckTorusPositiveGroupScheme ht =
      CommHopfAlgCat.quotientSpec (GeneralLinear.coordinateHopfAlgebra ℤ (t.geckDim ht))
        (t.geckTorusPositiveDefiningIdeal ht) := by
  rw [geckTorusPositiveGroupScheme_def, geckTorusPositiveDefiningIdeal_def]

/-- **The inclusion of the positive Geck carrier into the full Geck carrier.** -/
def geckTorusPositiveInclusion :
    t.geckTorusPositiveGroupScheme ht ⟶ t.geckGroupScheme ht :=
  eqToHom (t.geckTorusPositiveGroupScheme_def ht) ≫
    UniversalEnvelopingAlgebra.kostantTorusSubsystemToToral
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
    (t.geckCoordinateLattice ht).toAddSubgroup
    (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
    (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht)
    (t.isNilpotent_geckRepresentation_rootGenerator ht) (Set.range Sum.inl) ≫
    eqToHom (t.geckGroupScheme_def ht).symm

/-- Including the positive carrier into the full carrier and then into `GL` is its direct
Kostant subsystem inclusion. -/
theorem geckTorusPositiveInclusion_comp_geckGroupSchemeι :
    t.geckTorusPositiveInclusion ht ≫ t.geckGroupSchemeι ht =
      eqToHom (t.geckTorusPositiveGroupScheme_def ht) ≫
        UniversalEnvelopingAlgebra.kostantTorusSubsystemGroupSchemeι
          (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
          (t.geckCoordinateLattice ht).toAddSubgroup
          (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
          (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht) (Set.range Sum.inl)
          (fun i => t.isNilpotent_geckRepresentation_rootGenerator ht i.1) := by
  rw [geckTorusPositiveInclusion, geckGroupSchemeι_def]
  slice_lhs 3 5 =>
    simp only [Functor.comp_obj, Functor.leftOp_obj, eqToHom_trans_assoc, eqToHom_refl,
      Category.id_comp]
  simpa only [Category.assoc] using congrArg
    (fun f => eqToHom (t.geckTorusPositiveGroupScheme_def ht) ≫ f)
    (UniversalEnvelopingAlgebra.kostantTorusSubsystemToToral_comp_ι
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
      (t.geckCoordinateLattice ht).toAddSubgroup
      (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
      (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht)
      (t.isNilpotent_geckRepresentation_rootGenerator ht) (Set.range Sum.inl))

/-- The positive Geck carrier is a closed subgroup scheme of the full carrier. -/
instance isClosedImmersion_geckTorusPositiveInclusion :
    IsClosedImmersion (t.geckTorusPositiveInclusion ht).hom.hom.left := by
  rw [← closedSubgroupMorphismProperty_iff]
  rw [geckTorusPositiveInclusion,
    (closedSubgroupMorphismProperty _).cancel_left_of_respectsIso,
    (closedSubgroupMorphismProperty _).cancel_right_of_respectsIso]
  rw [closedSubgroupMorphismProperty_iff]
  exact UniversalEnvelopingAlgebra.isClosedImmersion_kostantTorusSubsystemToToral
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
    (t.geckCoordinateLattice ht).toAddSubgroup
    (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
    (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht)
    (t.isNilpotent_geckRepresentation_rootGenerator ht) (Set.range Sum.inl)

/-- The positive Geck carrier bundled as a closed subgroup scheme of the full carrier. -/
def geckTorusPositiveClosedSubgroup : ClosedSubgroupScheme (t.geckGroupScheme ht) :=
  ClosedSubgroupScheme.mk (t.geckTorusPositiveInclusion ht)

/-- The underlying subobject of the positive Geck carrier is represented by its canonical
inclusion. -/
@[simp]
theorem coe_geckTorusPositiveClosedSubgroup :
    (t.geckTorusPositiveClosedSubgroup ht).1 =
      Subobject.mk (t.geckTorusPositiveInclusion ht) :=
  ClosedSubgroupScheme.coe_mk _

/-! ## The positive simple-root subgroups -/

/-- **The `i`-th positive simple-root subgroup factored through the positive Geck carrier.** -/
def geckRootSubgroupToTorusPositive (i : Fin t.rank) :
    AdditiveGroup.groupScheme ℤ ⟶ t.geckTorusPositiveGroupScheme ht :=
  UniversalEnvelopingAlgebra.kostantRootSubgroupToTorusSubsystem
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
    (t.geckCoordinateLattice ht).toAddSubgroup
    (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
    (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht) (Set.range Sum.inl)
    (fun j => t.isNilpotent_geckRepresentation_rootGenerator ht j.1)
    (Set.mem_range_self i) ≫
      eqToHom (t.geckTorusPositiveGroupScheme_def ht).symm

/-- Factoring a positive simple-root subgroup through the positive carrier and then including it
into the full carrier recovers the named Geck root subgroup. -/
@[simp]
theorem geckRootSubgroupToTorusPositive_comp_geckTorusPositiveInclusion (i : Fin t.rank) :
    t.geckRootSubgroupToTorusPositive ht i ≫ t.geckTorusPositiveInclusion ht =
      t.geckRootSubgroup ht (.inl i) := by
  rw [geckRootSubgroupToTorusPositive, geckTorusPositiveInclusion, geckRootSubgroup_def]
  slice_lhs 2 4 =>
    simp only [Functor.comp_obj, Functor.leftOp_obj, eqToHom_trans_assoc, eqToHom_refl,
      Category.id_comp]
  have h :=
    UniversalEnvelopingAlgebra.kostantRootSubgroupToTorusSubsystem_comp_kostantTorusSubsystemToToral
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
      (t.geckCoordinateLattice ht).toAddSubgroup
      (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
      (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht)
      (t.isNilpotent_geckRepresentation_rootGenerator ht) (Set.range Sum.inl)
      (Set.mem_range_self i)
  simpa only [Category.assoc] using
    congrArg (fun f => f ≫ eqToHom (t.geckGroupScheme_def ht).symm) h

/-- Every positive simple-root map into the positive Geck carrier is a closed immersion. -/
instance isClosedImmersion_geckRootSubgroupToTorusPositive (i : Fin t.rank) :
    IsClosedImmersion (t.geckRootSubgroupToTorusPositive ht i).hom.hom.left := by
  have hcomp : IsClosedImmersion
      ((t.geckRootSubgroupToTorusPositive ht i ≫
        t.geckTorusPositiveInclusion ht).hom.hom.left) := by
    rw [geckRootSubgroupToTorusPositive_comp_geckTorusPositiveInclusion]
    infer_instance
  simp only [Grp.comp', Mon.comp_hom', Over.comp_left] at hcomp
  have _ := hcomp
  exact IsClosedImmersion.of_comp
    (f := (t.geckRootSubgroupToTorusPositive ht i).hom.hom.left)
    (g := (t.geckTorusPositiveInclusion ht).hom.hom.left)

/-- Every positive simple-root closed subgroup of the full Geck carrier lies in the positive
closed subgroup. -/
theorem geckRootSubgroupClosedSubgroup_inl_le_geckTorusPositiveClosedSubgroup
    (i : Fin t.rank) :
    t.geckRootSubgroupClosedSubgroup ht (.inl i) ≤
      t.geckTorusPositiveClosedSubgroup ht := by
  rw [← Subtype.coe_le_coe, coe_geckRootSubgroupClosedSubgroup,
    coe_geckTorusPositiveClosedSubgroup]
  exact Subobject.mk_le_mk_of_comm (t.geckRootSubgroupToTorusPositive ht i)
    (t.geckRootSubgroupToTorusPositive_comp_geckTorusPositiveInclusion ht i)

/-! ## The weight torus -/

/-- **The represented weight torus factored through the positive Geck carrier.** -/
def geckWeightTorusToTorusPositive :
    SplitTorus.groupScheme ℤ (Fin t.rank) ⟶ t.geckTorusPositiveGroupScheme ht :=
  UniversalEnvelopingAlgebra.kostantWeightTorusToTorusSubsystem
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
    (t.geckCoordinateLattice ht).toAddSubgroup
    (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
    (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht) (Set.range Sum.inl)
    (fun i => t.isNilpotent_geckRepresentation_rootGenerator ht i.1) ≫
      eqToHom (t.geckTorusPositiveGroupScheme_def ht).symm

/-- Factoring the weight torus through the positive carrier and then including it into the full
carrier recovers the named Geck weight torus. -/
@[simp]
theorem geckWeightTorusToTorusPositive_comp_geckTorusPositiveInclusion :
    t.geckWeightTorusToTorusPositive ht ≫ t.geckTorusPositiveInclusion ht =
      t.geckWeightTorus ht := by
  rw [geckWeightTorusToTorusPositive, geckTorusPositiveInclusion, geckWeightTorus_def]
  slice_lhs 2 4 =>
    simp only [Functor.comp_obj, Functor.leftOp_obj, eqToHom_trans_assoc, eqToHom_refl,
      Category.id_comp]
  simpa only [Category.assoc] using congrArg
    (fun f => f ≫ eqToHom (t.geckGroupScheme_def ht).symm)
    (UniversalEnvelopingAlgebra.kostantWeightTorusToTorusSubsystem_comp_kostantTorusSubsystemToToral
        (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
        (t.geckCoordinateLattice ht).toAddSubgroup
        (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
        (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht)
        (t.isNilpotent_geckRepresentation_rootGenerator ht) (Set.range Sum.inl))

/-- Spanning Geck weights embed the represented weight torus as a closed subgroup of the positive
carrier. -/
theorem isClosedImmersion_geckWeightTorusToTorusPositive
    (hwt : Submodule.span ℤ (Set.range (t.geckWeight ht)) = ⊤) :
    IsClosedImmersion (t.geckWeightTorusToTorusPositive ht).hom.hom.left := by
  have hcomp : IsClosedImmersion
      ((t.geckWeightTorusToTorusPositive ht ≫
        t.geckTorusPositiveInclusion ht).hom.hom.left) := by
    rw [geckWeightTorusToTorusPositive_comp_geckTorusPositiveInclusion]
    exact t.isClosedImmersion_geckWeightTorus_of_span_eq_top ht hwt
  simp only [Grp.comp', Mon.comp_hom', Over.comp_left] at hcomp
  have _ := hcomp
  exact IsClosedImmersion.of_comp
    (f := (t.geckWeightTorusToTorusPositive ht).hom.hom.left)
    (g := (t.geckTorusPositiveInclusion ht).hom.hom.left)

/-- The closed Geck weight torus lies in the positive closed subgroup. -/
theorem geckWeightTorusClosedSubgroup_le_geckTorusPositiveClosedSubgroup
    (hwt : Submodule.span ℤ (Set.range (t.geckWeight ht)) = ⊤) :
    t.geckWeightTorusClosedSubgroup ht hwt ≤
      t.geckTorusPositiveClosedSubgroup ht := by
  have _ := t.isClosedImmersion_geckWeightTorus_of_span_eq_top ht hwt
  have _ := t.isClosedImmersion_geckWeightTorusToTorusPositive ht hwt
  rw [← Subtype.coe_le_coe, coe_geckWeightTorusClosedSubgroup,
    coe_geckTorusPositiveClosedSubgroup]
  exact Subobject.mk_le_mk_of_comm (t.geckWeightTorusToTorusPositive ht)
    (t.geckWeightTorusToTorusPositive_comp_geckTorusPositiveInclusion ht)

/-- **Universal property of the positive Geck carrier.** It is the smallest closed subgroup
scheme of the full Geck carrier through which every positive simple-root subgroup and the weight
torus factor. -/
theorem geckTorusPositiveClosedSubgroup_le_iff
    (P : ClosedSubgroupScheme (t.geckGroupScheme ht)) :
    t.geckTorusPositiveClosedSubgroup ht ≤ P ↔
      (∀ i : Fin t.rank, ∃! f : AdditiveGroup.groupScheme ℤ ⟶
        (P.1 : Grp (Over (Spec (CommRingCat.of ℤ)))),
          f ≫ P.1.arrow = t.geckRootSubgroup ht (.inl i)) ∧
      ∃! f : SplitTorus.groupScheme ℤ (Fin t.rank) ⟶
        (P.1 : Grp (Over (Spec (CommRingCat.of ℤ)))),
          f ≫ P.1.arrow = t.geckWeightTorus ht := by
  let eB := eqToIso (t.geckTorusPositiveGroupScheme_def ht)
  let eG := eqToIso (t.geckGroupScheme_def ht)
  let c := UniversalEnvelopingAlgebra.kostantTorusSubsystemToToral
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
    (t.geckCoordinateLattice ht).toAddSubgroup
    (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
    (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht)
    (t.isNilpotent_geckRepresentation_rootGenerator ht) (Set.range Sum.inl)
  have hinc : t.geckTorusPositiveInclusion ht = eB.hom ≫ c ≫ eG.inv := by
    rfl
  let j := P.1.arrow ≫ eG.hom
  have hj : IsClosedImmersion j.hom.hom.left := by
    rw [← closedSubgroupMorphismProperty_iff]
    dsimp only [j]
    rw [(closedSubgroupMorphismProperty _).cancel_right_of_respectsIso]
    exact P.2
  let _ : IsClosedImmersion j.hom.hom.left := hj
  let Q := ClosedSubgroupScheme.mk j
  have horder : t.geckTorusPositiveClosedSubgroup ht ≤ P ↔
      UniversalEnvelopingAlgebra.kostantTorusSubsystemClosedSubgroup
        (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
        (t.geckCoordinateLattice ht).toAddSubgroup
        (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
        (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht)
        (t.isNilpotent_geckRepresentation_rootGenerator ht) (Set.range Sum.inl) ≤ Q := by
    -- The order on bundled closed subgroups is the order on their underlying subobjects.
    change (t.geckTorusPositiveClosedSubgroup ht).1 ≤ P.1 ↔
      (UniversalEnvelopingAlgebra.kostantTorusSubsystemClosedSubgroup
        (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
        (t.geckCoordinateLattice ht).toAddSubgroup
        (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
        (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht)
        (t.isNilpotent_geckRepresentation_rootGenerator ht) (Set.range Sum.inl)).1 ≤ Q.1
    rw [coe_geckTorusPositiveClosedSubgroup,
      UniversalEnvelopingAlgebra.coe_kostantTorusSubsystemClosedSubgroup,
      show Q.1 = Subobject.mk j from ClosedSubgroupScheme.coe_mk j]
    constructor
    · intro hle
      let a := Subobject.ofMkLE (t.geckTorusPositiveInclusion ht) P.1 hle
      have ha : a ≫ P.1.arrow = t.geckTorusPositiveInclusion ht :=
        Subobject.ofMkLE_arrow _
      apply Subobject.mk_le_mk_of_comm (eB.inv ≫ a)
      dsimp only [j]
      slice_lhs 2 3 => rw [ha]
      rw [hinc]
      simp [c]
    · intro hle
      let a := Subobject.ofMkLEMk c j hle
      have ha : a ≫ j = c :=
        Subobject.ofMkLEMk_comp _
      apply Subobject.mk_le_of_comm (eB.hom ≫ a)
      apply (cancel_mono eG.hom).mp
      -- Reassociate to expose the transported representative arrow `j`.
      change eB.hom ≫ (a ≫ j) = t.geckTorusPositiveInclusion ht ≫ eG.hom
      rw [ha, hinc]
      simp
  have hfactor {X : Grp (Over (Spec (CommRingCat.of ℤ)))}
      (g : X ⟶ UniversalEnvelopingAlgebra.kostantToralGroupScheme
        (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
        (t.geckCoordinateLattice ht).toAddSubgroup
        (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
        (t.isNilpotent_geckRepresentation_rootGenerator ht)
        (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht)) :
      (∃! f : X ⟶ (Q.1 : Grp (Over (Spec (CommRingCat.of ℤ)))),
        f ≫ Q.1.arrow = g) ↔
      ∃! f : X ⟶ (P.1 : Grp (Over (Spec (CommRingCat.of ℤ)))),
        f ≫ P.1.arrow = g ≫ eqToHom (t.geckGroupScheme_def ht).symm := by
    let qIso := ClosedSubgroupScheme.mkIso j
    have hqIsoInv : qIso.inv ≫ Q.1.arrow = j := by
      dsimp only [qIso, Q]
      exact ClosedSubgroupScheme.mkIso_inv_comp_arrow j
    have hqIso : qIso.hom ≫ j = Q.1.arrow := by
      apply (cancel_epi qIso.inv).mp
      simpa only [Iso.inv_hom_id_assoc] using hqIsoInv.symm
    constructor
    · rintro ⟨f, hf, -⟩
      have hmap : (f ≫ qIso.hom) ≫ P.1.arrow =
          g ≫ eqToHom (t.geckGroupScheme_def ht).symm := by
        apply (cancel_mono eG.hom).mp
        -- The change only reassociates composition and unfolds `j`.
        change f ≫ qIso.hom ≫ j =
          (g ≫ eqToHom (t.geckGroupScheme_def ht).symm) ≫ eG.hom
        rw [Category.assoc, hqIso, hf]
        dsimp only [eG]
        simp
      refine ⟨f ≫ qIso.hom, hmap, ?_⟩
      intro f' hf'
      apply (cancel_mono P.1.arrow).mp
      rw [hf', hmap]
    · rintro ⟨f, hf, -⟩
      have hmap : (f ≫ qIso.inv) ≫ Q.1.arrow = g := by
        rw [Category.assoc, hqIsoInv]
        dsimp only [j]
        rw [← Category.assoc, hf]
        dsimp only [eG]
        simp
      refine ⟨f ≫ qIso.inv, hmap, ?_⟩
      intro f' hf'
      apply (cancel_mono Q.1.arrow).mp
      rw [hf', hmap]
  rw [horder, UniversalEnvelopingAlgebra.kostantTorusSubsystemClosedSubgroup_le_iff]
  constructor
  · rintro ⟨hroot, htorus⟩
    constructor
    · intro i
      simpa only [geckRootSubgroup_def] using
        (hfactor _).mp (hroot (.inl i) (Set.mem_range_self i))
    · simpa only [geckWeightTorus_def] using (hfactor _).mp htorus
  · rintro ⟨hroot, htorus⟩
    constructor
    · intro i hi
      obtain ⟨j, rfl⟩ := hi
      exact (hfactor _).mpr (by
        simpa only [geckRootSubgroup_def] using hroot j)
    · exact (hfactor _).mpr (by
        simpa only [geckWeightTorus_def] using htorus)

/-! ## Rigidity -/

/-- **Rigidity of the positive Geck carrier.** Two homomorphisms from it into an affine group
scheme represented by a commutative Hopf algebra are equal if they agree on every positive simple
root subgroup and on the represented weight torus. -/
@[ext]
theorem geckTorusPositiveGroupScheme_hom_ext {Y : _root_.CommHopfAlgCat.{0} ℤ}
    (φ ψ : t.geckTorusPositiveGroupScheme ht ⟶
      (hopfSpec (CommRingCat.of ℤ)).obj (Opposite.op Y))
    (hroot : ∀ i, t.geckRootSubgroupToTorusPositive ht i ≫ φ =
      t.geckRootSubgroupToTorusPositive ht i ≫ ψ)
    (htorus : t.geckWeightTorusToTorusPositive ht ≫ φ =
      t.geckWeightTorusToTorusPositive ht ≫ ψ) :
    φ = ψ := by
  apply (cancel_epi (eqToHom (t.geckTorusPositiveGroupScheme_def ht).symm)).1
  apply UniversalEnvelopingAlgebra.kostantTorusSubsystemGroupScheme_hom_ext
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
    (t.geckCoordinateLattice ht).toAddSubgroup
    (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
    (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht) (Set.range Sum.inl)
    (fun i => t.isNilpotent_geckRepresentation_rootGenerator ht i.1)
    (eqToHom (t.geckTorusPositiveGroupScheme_def ht).symm ≫ φ)
    (eqToHom (t.geckTorusPositiveGroupScheme_def ht).symm ≫ ψ)
  · intro i hi
    obtain ⟨j, rfl⟩ := hi
    simpa only [geckRootSubgroupToTorusPositive, Category.assoc] using hroot j
  · simpa only [geckWeightTorusToTorusPositive, Category.assoc] using htorus

end

end TauCeti.DynkinType
