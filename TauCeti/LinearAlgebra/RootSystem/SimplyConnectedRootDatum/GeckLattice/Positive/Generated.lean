module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.Generated.Connected
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.Generated.Smooth
import TauCeti.Algebra.AlgebraicGroup.DiagonalizableGroup.SmoothConnected
import Mathlib.RingTheory.TensorProduct.MonoidAlgebra
import TauCeti.RingTheory.Smooth.GeometricallyReduced

/-!
# The field-generated positive Geck subgroup

For a valid Dynkin type over a commutative ring `A`, the positive numbered Geck root subgroups
and the weight torus generate a closed subgroup of `GLₙ/A`. This file names its defining
common-kernel Hopf ideal and coordinate Hopf algebra. It also places this positive generated
subgroup inside the subgroup generated by all numbered root subgroups and the torus.

Over a field, the positive generated subgroup is smooth: its generators have geometrically
reduced coordinate algebras, so the common-kernel smoothness criterion applies. Over an
algebraically closed field it is geometrically connected because both the additive root groups
and the split weight torus are connected.

The construction here is made directly over `A`, so it is distinct from the scalar extension of
the integral positive carrier in `GeckLattice.Positive.BaseChange`. Equality of those two
presentations is not asserted. Establishing that equality in all characteristics, and then
proving Borel maximality, are the remaining steps needed to use this subgroup as the Borel in a
pinning of the Geck carrier.

## Main declarations

* `TauCeti.DynkinType.geckPositiveGeneratedDefiningIdeal`: the common-kernel ideal of the
  positive numbered root maps and weight-torus map.
* `TauCeti.DynkinType.geckPositiveGeneratedCoordinateHopfAlgebra`: the resulting coordinate
  Hopf algebra.
* `TauCeti.DynkinType.geckGeneratedDefiningIdeal_le_geckPositiveGeneratedDefiningIdeal`: the
  positive generated subgroup is a closed subgroup of the full generated subgroup.
* `TauCeti.DynkinType.smoothCommHopfAlgProperty_geckPositiveGeneratedCoordinateHopfAlgebra`:
  smoothness over every field.
* `geometricallyConnectedCommHopfAlgProperty_geckPositiveGeneratedCoordinateHopfAlgebra`:
  geometric connectedness over an algebraically closed field.

## References

* M. Geck, *On the construction of semisimple Lie algebras and Chevalley groups*,
  Proc. Amer. Math. Soc. **145** (2017), 3233--3247.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26--28.
* J. S. Milne, *Algebraic Groups* (2017), Propositions 2.37 and 2.48.
-/

public section

namespace TauCeti.DynkinType

open CategoryTheory

universe v

noncomputable section

variable (t : DynkinType) (ht : t.Valid) (A : Type v) [CommRing A]

/-! ## The positive generator family -/

/-- The coordinate algebras of the positive numbered Geck root subgroups and the weight torus.
They are the corresponding branches of the full Geck generator family. -/
noncomputable abbrev geckPositiveGeneratorCoordinateAlgebra :
    Sum (Fin t.rank) Unit → CommHopfAlgCat A
  | .inl i => t.geckGeneratorCoordinateAlgebra A (.inl (.inl i))
  | .inr u => t.geckGeneratorCoordinateAlgebra A (.inr u)

/-- The coordinate maps of the positive numbered Geck root subgroups and the weight torus into
`GLₙ/A`. -/
noncomputable def geckPositiveGeneratorCoordinateMap (j : Sum (Fin t.rank) Unit) :
    GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht) ⟶
      t.geckPositiveGeneratorCoordinateAlgebra A j :=
  match j with
  | .inl i => t.geckGeneratorCoordinateMap ht A (.inl (.inl i))
  | .inr u => t.geckGeneratorCoordinateMap ht A (.inr u)

/-- A positive numbered branch is the corresponding positive branch of the full generator
family. -/
@[simp]
theorem geckPositiveGeneratorCoordinateMap_inl (i : Fin t.rank) :
    t.geckPositiveGeneratorCoordinateMap ht A (.inl i) =
      t.geckGeneratorCoordinateMap ht A (.inl (.inl i)) := by
  simp [geckPositiveGeneratorCoordinateMap]

/-- The torus branch is the torus branch of the full generator family. -/
@[simp]
theorem geckPositiveGeneratorCoordinateMap_inr :
    t.geckPositiveGeneratorCoordinateMap ht A (.inr ()) =
      t.geckGeneratorCoordinateMap ht A (.inr ()) := by
  simp [geckPositiveGeneratorCoordinateMap]

/-! ## The generated subgroup -/

/-- The defining ideal of the subgroup of `GLₙ/A` generated by the positive numbered Geck root
subgroups and the weight torus. -/
noncomputable def geckPositiveGeneratedDefiningIdeal :
    HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht)) :=
  CommHopfAlgCat.commonKernelHopfIdeal (t.geckPositiveGeneratorCoordinateMap ht A)

/-- The positive generated defining ideal is the common kernel of its generator family. -/
@[simp]
theorem geckPositiveGeneratedDefiningIdeal_def :
    t.geckPositiveGeneratedDefiningIdeal ht A =
      CommHopfAlgCat.commonKernelHopfIdeal (t.geckPositiveGeneratorCoordinateMap ht A) := by
  simp [geckPositiveGeneratedDefiningIdeal]

/-- A Hopf ideal lies below the positive generated defining ideal exactly when every positive
generator coordinate map kills it. -/
theorem le_geckPositiveGeneratedDefiningIdeal_iff
    (J : HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht))) :
    J ≤ t.geckPositiveGeneratedDefiningIdeal ht A ↔
      ∀ j, J.toIdeal ≤ RingHom.ker
        (t.geckPositiveGeneratorCoordinateMap ht A j).hom.toAlgHom.toRingHom := by
  rw [geckPositiveGeneratedDefiningIdeal_def]
  exact CommHopfAlgCat.le_commonKernelHopfIdeal_iff
    (t.geckPositiveGeneratorCoordinateMap ht A) J

/-- The defining ideal for the full generated Geck subgroup is contained in the positive one.
Contravariantly, the positive generated subgroup is a closed subgroup of the full generated
subgroup. -/
theorem geckGeneratedDefiningIdeal_le_geckPositiveGeneratedDefiningIdeal :
    t.geckGeneratedDefiningIdeal ht A ≤ t.geckPositiveGeneratedDefiningIdeal ht A := by
  rw [t.le_geckPositiveGeneratedDefiningIdeal_iff ht A]
  rintro (i | u)
  · rw [geckPositiveGeneratorCoordinateMap_inl]
    rw [geckGeneratedDefiningIdeal_def]
    exact CommHopfAlgCat.commonKernelHopfIdeal_toIdeal_le_ker
      (t.geckGeneratorCoordinateMap ht A) (.inl (.inl i))
  · rcases u with ⟨⟩
    rw [geckPositiveGeneratorCoordinateMap_inr, geckGeneratedDefiningIdeal_def]
    exact CommHopfAlgCat.commonKernelHopfIdeal_toIdeal_le_ker
      (t.geckGeneratorCoordinateMap ht A) (.inr ())

/-- The coordinate Hopf algebra of the subgroup generated by the positive numbered Geck root
subgroups and the weight torus. -/
noncomputable def geckPositiveGeneratedCoordinateHopfAlgebra : CommHopfAlgCat A :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht))
    (t.geckPositiveGeneratedDefiningIdeal ht A)

/-- The positive generated subgroup has the quotient coordinate Hopf algebra of its defining
ideal. -/
@[simp]
theorem geckPositiveGeneratedCoordinateHopfAlgebra_def :
    t.geckPositiveGeneratedCoordinateHopfAlgebra ht A =
      CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht))
        (t.geckPositiveGeneratedDefiningIdeal ht A) := by
  simp [geckPositiveGeneratedCoordinateHopfAlgebra]

/-- The quotient coordinate map representing the positive generated subgroup inside `GLₙ/A`. -/
noncomputable def geckPositiveGeneratedCoordinateMap :
    GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht) ⟶
      t.geckPositiveGeneratedCoordinateHopfAlgebra ht A :=
  CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht))
    (t.geckPositiveGeneratedDefiningIdeal ht A)

/-- The positive generated quotient coordinate map is surjective. -/
theorem geckPositiveGeneratedCoordinateMap_surjective :
    Function.Surjective (t.geckPositiveGeneratedCoordinateMap ht A).hom :=
  CommHopfAlgCat.mkQuotient_surjective
    (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht))
    (t.geckPositiveGeneratedDefiningIdeal ht A)

/-- The kernel of the positive generated quotient coordinate map is its defining ideal. -/
@[simp]
theorem geckPositiveGeneratedCoordinateMap_ker :
    RingHom.ker (t.geckPositiveGeneratedCoordinateMap ht A).hom =
      (t.geckPositiveGeneratedDefiningIdeal ht A).toIdeal :=
  CommHopfAlgCat.mkQuotient_ker
    (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht))
    (t.geckPositiveGeneratedDefiningIdeal ht A)

/-- A coordinate morphism out of `O(GLₙ)` that kills the positive generated defining ideal
factors uniquely through the positive generated quotient coordinate map. -/
theorem existsUnique_geckPositiveGeneratedCoordinateMap_comp_eq {B : CommHopfAlgCat A}
    (f : GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht) ⟶ B)
    (hf : (t.geckPositiveGeneratedDefiningIdeal ht A).toIdeal ≤
      RingHom.ker f.hom.toAlgHom.toRingHom) :
    ∃! g : t.geckPositiveGeneratedCoordinateHopfAlgebra ht A ⟶ B,
      t.geckPositiveGeneratedCoordinateMap ht A ≫ g = f :=
  ⟨CommHopfAlgCat.liftQuotient (t.geckPositiveGeneratedDefiningIdeal ht A) f hf,
    CommHopfAlgCat.mkQuotient_comp_liftQuotient
      (t.geckPositiveGeneratedDefiningIdeal ht A) f hf,
    fun g hg => CommHopfAlgCat.liftQuotient_unique
      (t.geckPositiveGeneratedDefiningIdeal ht A) f hf g hg⟩

/-- Every positive generator coordinate map factors uniquely through the positive generated
quotient coordinate map. -/
theorem existsUnique_geckPositiveGeneratedCoordinateMap_comp_eq_generator
    (j : Sum (Fin t.rank) Unit) :
    ∃! g : t.geckPositiveGeneratedCoordinateHopfAlgebra ht A ⟶
        t.geckPositiveGeneratorCoordinateAlgebra A j,
      t.geckPositiveGeneratedCoordinateMap ht A ≫ g =
        t.geckPositiveGeneratorCoordinateMap ht A j :=
  t.existsUnique_geckPositiveGeneratedCoordinateMap_comp_eq ht A
    (t.geckPositiveGeneratorCoordinateMap ht A j) <| by
      rw [geckPositiveGeneratedDefiningIdeal_def]
      exact CommHopfAlgCat.commonKernelHopfIdeal_toIdeal_le_ker
        (t.geckPositiveGeneratorCoordinateMap ht A) j

/-- The positive generated coordinate Hopf algebra is of finite type over the base ring. -/
instance : Algebra.FiniteType A (t.geckPositiveGeneratedCoordinateHopfAlgebra ht A) := by
  rw [geckPositiveGeneratedCoordinateHopfAlgebra_def]
  infer_instance

/-! ## Geometry over fields -/

variable (k : Type v) [Field k]

private theorem isGeometricallyReduced_geckPositiveGeneratorCoordinateAlgebra :
    ∀ j, Algebra.IsGeometricallyReduced k
      (t.geckPositiveGeneratorCoordinateAlgebra k j) := by
  let : Algebra.IsGeometricallyReduced k (AdditiveGroup.coordinateHopfAlgebra k) :=
    isGeometricallyReduced_of_smooth k _
  let : Algebra.IsGeometricallyReduced k (DiagonalizableGroup.coordinateRing k
      (SplitTorus.characterGroup (Fin t.rank))).obj := by
    rw [Algebra.isGeometricallyReduced_field_iff]
    let e := _root_.MonoidAlgebra.scalarTensorEquiv k (AlgebraicClosure k)
      (M := SplitTorus.characterGroup (Fin t.rank))
    exact isReduced_of_injective e e.injective
  intro j
  cases j with
  | inl _ => exact inferInstance
  | inr _ => exact inferInstance

/-- The subgroup generated by the positive numbered Geck root subgroups and the weight torus is
smooth over every field. -/
theorem smoothCommHopfAlgProperty_geckPositiveGeneratedCoordinateHopfAlgebra :
    smoothCommHopfAlgProperty k (t.geckPositiveGeneratedCoordinateHopfAlgebra ht k) := by
  let : ∀ j, Algebra.IsGeometricallyReduced k
      (t.geckPositiveGeneratorCoordinateAlgebra k j) :=
    t.isGeometricallyReduced_geckPositiveGeneratorCoordinateAlgebra k
  rw [geckPositiveGeneratedCoordinateHopfAlgebra_def,
    geckPositiveGeneratedDefiningIdeal_def]
  exact
    CommHopfAlgCat.smoothCommHopfAlgProperty_quotient_commonKernelHopfIdeal_of_geometricallyReduced
      (t.geckPositiveGeneratorCoordinateMap ht k)

/-- The positive generated subgroup has reduced coordinate algebra over every field. -/
theorem isReduced_geckPositiveGeneratedCoordinateHopfAlgebra :
    IsReduced (t.geckPositiveGeneratedCoordinateHopfAlgebra ht k) := by
  let : Algebra.Smooth k (t.geckPositiveGeneratedCoordinateHopfAlgebra ht k) :=
    (smoothCommHopfAlgProperty_iff _).mp
      (t.smoothCommHopfAlgProperty_geckPositiveGeneratedCoordinateHopfAlgebra ht k)
  exact isReduced_of_smooth k _

private theorem connectedSpace_geckPositiveGeneratorCoordinateAlgebra :
    ∀ j, ConnectedSpace
      (PrimeSpectrum (t.geckPositiveGeneratorCoordinateAlgebra k j)) := by
  intro j
  cases j with
  | inl _ => exact AdditiveGroup.connectedSpace_primeSpectrum_coordinateHopfAlgebra k
  | inr _ =>
    exact DiagonalizableGroup.connectedSpace_primeSpectrum_coordinateRing k
      (SplitTorus.characterGroup (Fin t.rank))

/-- Over an algebraically closed field, the subgroup generated by the positive numbered Geck root
subgroups and the weight torus is geometrically connected. -/
theorem geometricallyConnectedCommHopfAlgProperty_geckPositiveGeneratedCoordinateHopfAlgebra
    [IsAlgClosed k] :
    geometricallyConnectedCommHopfAlgProperty k
      (t.geckPositiveGeneratedCoordinateHopfAlgebra ht k) := by
  rw [geckPositiveGeneratedCoordinateHopfAlgebra_def,
    geckPositiveGeneratedDefiningIdeal_def]
  exact CommHopfAlgCat.geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient
    (t.geckPositiveGeneratorCoordinateMap ht k)
    (t.connectedSpace_geckPositiveGeneratorCoordinateAlgebra k)

end

end TauCeti.DynkinType
