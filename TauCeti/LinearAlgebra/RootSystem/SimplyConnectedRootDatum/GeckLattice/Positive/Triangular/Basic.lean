module

public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.UpperTriangular.Conjugation
public import TauCeti.Algebra.AlgebraicGroup.Solvable.UpperTriangular
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.Positive.Basic
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.Positive.Triangular.Matrices

/-!
# Triangularity of the positive Geck subgroup scheme

Ordering the Geck weight basis by decreasing height conjugates the existing positive carrier into
the standard upper-triangular group scheme. The construction uses the integral change-of-basis
matrix, so it applies over every commutative value ring. The coordinate map is surjective and
therefore embeds every point group into an upper-triangular point group.

This proves solvability of all points of the positive subgroup scheme, beyond the abstract subgroup
generated by root and torus points.
-/

public section

open AlgebraicGeometry CategoryTheory TensorProduct WithConv
open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.DynkinType

universe v

noncomputable section

attribute [local instance high] Algebra.toModule

variable (t : DynkinType) (ht : t.Valid)

/-- Conjugation by the integral weight-ordering matrix carries the positive Geck defining ideal
into triangular position. Equivalently, the pulled-back upper-triangular ideal is contained in the
existing positive defining ideal. -/
theorem upperTriangular_comap_le_geckTorusPositiveDefiningIdeal :
    (GeneralLinear.UpperTriangular.definingHopfIdeal ℤ (t.geckDim ht)).comapOfSurjective
      (GeneralLinear.conjCoordinateIso (t.geckWeightOrderingMatrix ht)).inv.hom
      (ConcreteCategory.bijective_of_isIso
        (GeneralLinear.conjCoordinateIso (t.geckWeightOrderingMatrix ht)).inv).2 ≤
      t.geckTorusPositiveDefiningIdeal ht := by
  rw [t.le_geckTorusPositiveDefiningIdeal_iff ht]
  constructor
  · intro i
    apply GeneralLinear.UpperTriangular.comap_le_ker_of_conjugate
    let q : WithConv (AdditiveGroup.coordinateHopfAlgebra ℤ →ₐ[ℤ]
        AdditiveGroup.coordinateHopfAlgebra ℤ) := toConv (AlgHom.id ℤ _)
    have hmatrix := pointsMulEquiv_kostantRootSubgroupCoordinateMap
      (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
      (t.geckCoordinateLattice ht).toAddSubgroup
      (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht) (.inl i)
      (t.isNilpotent_geckRepresentation_rootGenerator ht (.inl i))
      (t.geckCoordinateBasisFin ht) (AdditiveGroup.coordinateHopfAlgebra ℤ) q
    rw [← GeneralLinear.pointsMulEquiv_apply] at hmatrix
    -- Evaluating at the identity point gives the coordinate map itself. Here `AlgHom.id_comp`
    -- does not match: the bundled additive coordinate ring and its symmetric algebra carry
    -- definitionally equal, but differently presented, ℤ-algebra instances.
    change GeneralLinear.pointsMulEquiv (t.geckDim ht)
      (toConv (kostantRootSubgroupCoordinateMap
        (t.lieBasis ht).rootGenerator (t.lieBasis ht).h (t.geckRepresentation ht)
        (t.geckCoordinateLattice ht).toAddSubgroup
        (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht) (.inl i)
        (t.isNilpotent_geckRepresentation_rootGenerator ht (.inl i))
        (t.geckCoordinateBasisFin ht)).hom.toAlgHom) = _ at hmatrix
    rw [hmatrix]
    exact t.isUpperTriangular_conj_geckRootSubgroupMatrix_inl ht i q
  · apply GeneralLinear.UpperTriangular.comap_le_ker_of_conjugate
    let p : HopfAlgebra.points (R := ℤ)
        (H := MonoidAlgebra ℤ (SplitTorus.characterGroup (Fin t.rank)))
        (CommAlgCat.of ℤ (MonoidAlgebra ℤ (SplitTorus.characterGroup (Fin t.rank)))) :=
      toConv (AlgHom.id ℤ _)
    have hmatrix : GeneralLinear.pointsMulEquiv (t.geckDim ht)
        ((CommHopfAlgCat.mapPointsFunctor
          (GeneralLinear.weightTorusCoordinateMap (R := ℤ) (t.geckWeightFin ht))).app _ p) =
        t.geckTorusMatrix ht (SplitTorus.pointsMulEquiv p) := by
      rw [geckTorusMatrix, kostantTorusMatrix_apply]
      exact GeneralLinear.pointsMulEquiv_mapPointsFunctor_weightTorusCoordinateMap
        (t.geckWeightFin ht) _ p
    -- Evaluating the point functor at the identity point gives the coordinate map. Here `p`
    -- uses the monoid algebra while the map targets its bundled coordinate ring; this conversion
    -- normalizes those wrappers before rewriting.
    change GeneralLinear.pointsMulEquiv (t.geckDim ht)
      (toConv (GeneralLinear.weightTorusCoordinateMap (R := ℤ)
        (t.geckWeightFin ht)).hom.toAlgHom) = _ at hmatrix
    rw [hmatrix]
    exact t.isUpperTriangular_conj_geckTorusMatrix ht (SplitTorus.pointsMulEquiv p)

/-- The surjective coordinate map from the upper-triangular group to the existing positive Geck
carrier, induced by the integral weight-ordering conjugation. -/
def geckTorusPositiveUpperTriangularCoordinateMap :
    GeneralLinear.UpperTriangular.coordinateHopfAlgebra ℤ (t.geckDim ht) ⟶
      CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra ℤ (t.geckDim ht))
        (t.geckTorusPositiveDefiningIdeal ht) :=
  (CommHopfAlgCat.quotientIsoOfIso
      (GeneralLinear.conjCoordinateIso (t.geckWeightOrderingMatrix ht)).symm
      (GeneralLinear.UpperTriangular.definingHopfIdeal ℤ (t.geckDim ht))).inv ≫
    CommHopfAlgCat.quotientMapOfLe (GeneralLinear.coordinateHopfAlgebra ℤ (t.geckDim ht))
      (t.upperTriangular_comap_le_geckTorusPositiveDefiningIdeal ht)

/-- The triangular coordinate map is surjective, so it embeds all points of the positive carrier
into the upper-triangular point group. -/
theorem geckTorusPositiveUpperTriangularCoordinateMap_surjective :
    Function.Surjective (t.geckTorusPositiveUpperTriangularCoordinateMap ht) :=
  (CommHopfAlgCat.quotientMapOfLe_surjective _ _).comp
    (ConcreteCategory.bijective_of_isIso
      (CommHopfAlgCat.quotientIsoOfIso
        (GeneralLinear.conjCoordinateIso (t.geckWeightOrderingMatrix ht)).symm
        (GeneralLinear.UpperTriangular.definingHopfIdeal ℤ (t.geckDim ht))).inv).2

/-- The triangular coordinate map is induced by conjugation on the ambient general linear group. -/
@[simp]
theorem coordinateMap_comp_geckTorusPositiveUpperTriangularCoordinateMap :
    GeneralLinear.UpperTriangular.coordinateMap ℤ (t.geckDim ht) ≫
        t.geckTorusPositiveUpperTriangularCoordinateMap ht =
      (GeneralLinear.conjCoordinateIso (t.geckWeightOrderingMatrix ht)).hom ≫
        CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra ℤ (t.geckDim ht))
          (t.geckTorusPositiveDefiningIdeal ht) := by
  rw [GeneralLinear.UpperTriangular.coordinateMap_def,
    geckTorusPositiveUpperTriangularCoordinateMap, ← Category.assoc,
    CommHopfAlgCat.mkQuotient_comp_quotientIsoOfIso_inv, Category.assoc,
    CommHopfAlgCat.mkQuotient_comp_quotientMapOfLe]
  rfl

/-- The existing positive Geck subgroup scheme embeds into the upper-triangular group after the
integral weight-ordering change of basis. -/
def geckTorusPositiveToUpperTriangular :
    t.geckTorusPositiveGroupScheme ht ⟶
      GeneralLinear.UpperTriangular.groupScheme ℤ (t.geckDim ht) :=
  eqToHom (t.geckTorusPositiveGroupScheme_eq_quotientSpec ht) ≫
    (hopfSpec (CommRingCat.of ℤ)).map
      (t.geckTorusPositiveUpperTriangularCoordinateMap ht).op ≫
    eqToHom (GeneralLinear.UpperTriangular.groupScheme_def ℤ (t.geckDim ht)).symm

/-- The triangular realization of the positive Geck subgroup scheme is a closed immersion. -/
instance isClosedImmersion_geckTorusPositiveToUpperTriangular :
    IsClosedImmersion (t.geckTorusPositiveToUpperTriangular ht).hom.hom.left := by
  rw [← closedSubgroupMorphismProperty_iff, geckTorusPositiveToUpperTriangular,
    (closedSubgroupMorphismProperty _).cancel_left_of_respectsIso,
    (closedSubgroupMorphismProperty _).cancel_right_of_respectsIso,
    closedSubgroupMorphismProperty_iff,
    CommHopfAlgCat.isClosedImmersion_hopfSpec_map_iff]
  exact t.geckTorusPositiveUpperTriangularCoordinateMap_surjective ht

/-- The triangular realization is conjugation of the existing positive-carrier inclusion into
the ambient general linear group. The final equality identifies `GL` with its Hopf spectrum. -/
@[simp]
theorem geckTorusPositiveToUpperTriangular_comp_inclusion :
    t.geckTorusPositiveToUpperTriangular ht ≫
        GeneralLinear.UpperTriangular.inclusion ℤ (t.geckDim ht) ≫
        eqToHom (GeneralLinear.groupScheme_def ℤ (t.geckDim ht)) =
      t.geckTorusPositiveInclusion ht ≫ t.geckGroupSchemeι ht ≫
        eqToHom (GeneralLinear.groupScheme_def ℤ (t.geckDim ht)) ≫
        (hopfSpec (CommRingCat.of ℤ)).map
          (GeneralLinear.conjCoordinateIso (t.geckWeightOrderingMatrix ht)).hom.op := by
  rw [← Category.assoc (t.geckTorusPositiveInclusion ht),
    t.geckTorusPositiveInclusion_comp_geckGroupSchemeι ht]
  simp only [geckTorusPositiveToUpperTriangular, GeneralLinear.UpperTriangular.inclusion,
    GeneralLinear.weightParabolicInclusion_def, kostantTorusSubsystemGroupSchemeι_def,
    CommHopfAlgCat.quotientSpecι_def, eqToIso.hom, Category.assoc,
    eqToHom_trans, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp, Category.comp_id]
  apply eq_of_heq
  simp only [eqToHom_comp_heq_iff, heq_eqToHom_comp_iff]
  rw [← Functor.map_comp, ← Functor.map_comp, ← op_comp, ← op_comp,
    ← GeneralLinear.UpperTriangular.coordinateMap_def,
    t.coordinateMap_comp_geckTorusPositiveUpperTriangularCoordinateMap ht,
    geckTorusPositiveDefiningIdeal_def]

/-- Every commutative-ring-valued point group of the positive Geck subgroup scheme is solvable. -/
theorem isSolvable_points_geckTorusPositive (A : CommAlgCat.{v} ℤ) :
    Group.IsSolvable
      (HopfAlgebra.points (R := ℤ)
        (H := CommHopfAlgCat.quotient
          (GeneralLinear.coordinateHopfAlgebra ℤ (t.geckDim ht))
          (t.geckTorusPositiveDefiningIdeal ht)) A) := by
  let f := t.geckTorusPositiveUpperTriangularCoordinateMap ht
  let φ : HopfAlgebra.points (R := ℤ)
      (H := CommHopfAlgCat.quotient
        (GeneralLinear.coordinateHopfAlgebra ℤ (t.geckDim ht))
        (t.geckTorusPositiveDefiningIdeal ht)) A →*
      HopfAlgebra.points (R := ℤ)
        (H := GeneralLinear.UpperTriangular.coordinateHopfAlgebra ℤ (t.geckDim ht)) A :=
    ((CommHopfAlgCat.mapPointsFunctor f).app A).hom
  let _ : Group.IsSolvable (HopfAlgebra.points (R := ℤ)
      (H := GeneralLinear.UpperTriangular.coordinateHopfAlgebra ℤ (t.geckDim ht)) A) :=
    GeneralLinear.UpperTriangular.isSolvable_points ℤ A (t.geckDim ht)
  exact Group.isSolvable_of_isSolvable_injective (f := φ)
    (CommHopfAlgCat.mapPointsFunctor_app_injective_of_surjective f
      (t.geckTorusPositiveUpperTriangularCoordinateMap_surjective ht) A)

end

end TauCeti.DynkinType
