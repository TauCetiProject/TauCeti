module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.Weyl.Basic
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Torus.Coroot

/-!
# Root generation of the Geck weight torus

The Geck carrier of a valid Dynkin type is built from its numbered positive and negative root
subgroups and its split weight torus. The represented generators form `sl₂` triples, and the root
of the `i`-th raising generator is the `i`-th row of the Bourbaki Cartan matrix. So the generic
coroot-generation theorem puts the entire weight torus in the subgroup generated by the root
subgroups, over every commutative ring and for every valid type. No arithmetic condition on the
Cartan matrix enters: in particular the rank-one row `(2)` and the long-root rows of `B₂` and
`Cₙ`, whose entries are all even, are covered.

This is a statement about the generated subgroups in the defining representation. Identifying
that subgroup with all points of the Geck toral-closure scheme is a separate comparison.

## Main results

* `TauCeti.DynkinType.range_geckTorusPoints_le_geckElementarySubgroup`: the Geck weight torus is
  contained in the elementary subgroup.
* `TauCeti.DynkinType.geckTorusSubsystemSubgroup_univ_eq_geckElementarySubgroup`: adjoining the
  torus to all numbered root subgroups adds no elements.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* `TauCeti.Algebra.Lie.E7.Minuscule.Generation`, an earlier formal coroot-generation application.
-/

public section

open scoped Matrix TensorProduct

universe v

namespace TauCeti.DynkinType

open TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance high] Algebra.toModule

variable (t : DynkinType) (ht : t.Valid)

/-- **The Geck weight torus lies in the elementary subgroup.** Over every commutative ring, the
torus is contained in the subgroup generated by the numbered positive and negative simple-root
subgroups. -/
theorem range_geckTorusPoints_le_geckElementarySubgroup (A : CommAlgCat.{v} ℤ) :
    (t.geckTorusPoints ht A).range ≤ t.geckElementarySubgroup ht A := by
  rw [← kostantTorusSubgroup_eq_range
    (t.geckCoordinateLattice ht).toAddSubgroup
    (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht) A]
  exact kostantTorusSubgroup_le_kostantElementarySubgroup
    (t.lieBasis ht).rootGenerator (t.lieBasis ht).h
    (t.geckRepresentation ht) (t.geckCoordinateLattice ht).toAddSubgroup
    (t.geckRepresentation_kostantForm_mem_geckCoordinateLattice ht)
    (t.isNilpotent_geckRepresentation_rootGenerator ht)
    (t.geckCoordinateBasisFin ht) (t.geckWeightFin ht)
    (t.isCartanWeightVector_geckCoordinateBasisFin ht)
    (t.rootGeneratorWeight ht) (t.lie_lieBasis_h_rootGenerator ht)
    Sum.inl Sum.inr (t.isSl2Triple_geckRepresentation ht)
    (fun i => by funext j; simp) A

/-- **Adjoining the Geck weight torus to every numbered simple-root subgroup adds nothing**, over
every commutative ring. -/
theorem geckTorusSubsystemSubgroup_univ_eq_geckElementarySubgroup (A : CommAlgCat.{v} ℤ) :
    t.geckTorusSubsystemSubgroup ht Set.univ A = t.geckElementarySubgroup ht A := by
  rw [geckTorusSubsystemSubgroup, kostantTorusSubsystemSubgroup_univ, sup_eq_left]
  exact t.range_geckTorusPoints_le_geckElementarySubgroup ht A

end TauCeti.DynkinType
