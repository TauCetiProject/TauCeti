module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.Weyl.Basic
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Torus.Coroot

/-!
# Root generation of the type-`G₂` Geck weight torus

The Geck carrier of type `G₂` is built from its numbered positive and negative root subgroups
and its split weight torus. In this type, both rows of the Bourbaki Cartan matrix are primitive:
the first contains `-1`, while the second row `(-3, 2)` has Bézout coefficients `(-1, -1)`.
The represented generators form `sl₂` triples, so the generic coroot-generation theorem puts the
entire weight torus in the subgroup generated by the root subgroups over every commutative ring.

This is a statement about the generated subgroups in the defining representation. Identifying
that subgroup with all points of the Geck toral-closure scheme is a separate comparison.

## Main results

* `TauCeti.DynkinType.range_geckTorusPoints_le_geckElementarySubgroup_G2`: the type-`G₂` weight
  torus is contained in the elementary subgroup.
* `TauCeti.DynkinType.geckTorusSubsystemSubgroup_univ_eq_geckElementarySubgroup_G2`: adjoining
  the torus to all numbered root subgroups adds no elements.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
-/

public section

open scoped Matrix TensorProduct

universe v

namespace TauCeti.DynkinType

open TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance high] Algebra.toModule

private def g2CartanBezout (i j : Fin G2.rank) : ℤ :=
  if i.val = 0 then if j.val = 1 then -1 else 0 else -1

private theorem g2Cartan_sum_mul_bezout (i : Fin G2.rank) :
    ∑ j, G2.cartanMatrix i j * g2CartanBezout i j = 1 := by
  -- `Fin.sum_univ_two` needs the rank exposed; `rank_G2` is not used by rewrite under binders.
  change (∑ j : Fin 2, G2.cartanMatrix i j * g2CartanBezout i j) = 1
  rw [Fin.sum_univ_two]
  fin_cases i <;>
    norm_num [g2CartanBezout, cartanMatrix_G2, CartanMatrix.G₂, Matrix.transpose_apply]
  all_goals decide

private theorem g2RootWeight_sum_mul_bezout (i : Fin G2.rank) :
    ∑ j, G2.rootGeneratorWeight valid_G2 (.inl i) j * g2CartanBezout i j = 1 := by
  calc
    ∑ j, G2.rootGeneratorWeight valid_G2 (.inl i) j * g2CartanBezout i j =
        ∑ j, G2.cartanMatrix i j * g2CartanBezout i j := by
      apply Finset.sum_congr rfl
      intro j _
      rw [rootGeneratorWeight_inl]
    _ = 1 := g2Cartan_sum_mul_bezout i

private theorem g2RootWeight_inr_eq_neg_inl (i : Fin G2.rank) :
    G2.rootGeneratorWeight valid_G2 (.inr i) =
      -G2.rootGeneratorWeight valid_G2 (.inl i) := by
  simpa only [rank_G2] using
    (rootGeneratorWeight_inr_eq_neg_root_simpleIndex G2 valid_G2 i).trans
      (congrArg Neg.neg (rootGeneratorWeight_inl_eq_root_simpleIndex G2 valid_G2 i).symm)

/-- Over every commutative ring, the type-`G₂` Geck weight torus is contained in the elementary
subgroup generated by the four numbered positive and negative simple-root subgroups. -/
theorem range_geckTorusPoints_le_geckElementarySubgroup_G2 (A : CommAlgCat.{v} ℤ) :
    (G2.geckTorusPoints valid_G2 A).range ≤ G2.geckElementarySubgroup valid_G2 A := by
  rw [← kostantTorusSubgroup_eq_range
    (G2.geckCoordinateLattice valid_G2).toAddSubgroup
    (G2.geckCoordinateBasisFin valid_G2) (G2.geckWeightFin valid_G2) A]
  exact kostantTorusSubgroup_le_kostantElementarySubgroup
    (G2.lieBasis valid_G2).rootGenerator (G2.lieBasis valid_G2).h
    (G2.geckRepresentation valid_G2) (G2.geckCoordinateLattice valid_G2).toAddSubgroup
    (G2.geckRepresentation_kostantForm_mem_geckCoordinateLattice valid_G2)
    (G2.isNilpotent_geckRepresentation_rootGenerator valid_G2)
    (G2.geckCoordinateBasisFin valid_G2) (G2.geckWeightFin valid_G2)
    (G2.isCartanWeightVector_geckCoordinateBasisFin valid_G2)
    (G2.rootGeneratorWeight valid_G2) (G2.lie_lieBasis_h_rootGenerator valid_G2)
    Sum.inl Sum.inr (G2.isSl2Triple_geckRepresentation valid_G2)
    g2RootWeight_inr_eq_neg_inl g2CartanBezout g2RootWeight_sum_mul_bezout A

/-- Adding the type-`G₂` Geck weight torus to every numbered simple-root subgroup does not
enlarge the elementary subgroup over any commutative ring. -/
theorem geckTorusSubsystemSubgroup_univ_eq_geckElementarySubgroup_G2
    (A : CommAlgCat.{v} ℤ) :
    G2.geckTorusSubsystemSubgroup valid_G2 Set.univ A =
      G2.geckElementarySubgroup valid_G2 A := by
  exact kostantTorusSubsystemSubgroup_univ_eq_kostantElementarySubgroup
    (G2.lieBasis valid_G2).rootGenerator (G2.lieBasis valid_G2).h
    (G2.geckRepresentation valid_G2) (G2.geckCoordinateLattice valid_G2).toAddSubgroup
    (G2.geckRepresentation_kostantForm_mem_geckCoordinateLattice valid_G2)
    (G2.isNilpotent_geckRepresentation_rootGenerator valid_G2)
    (G2.geckCoordinateBasisFin valid_G2) (G2.geckWeightFin valid_G2)
    (G2.isCartanWeightVector_geckCoordinateBasisFin valid_G2)
    (G2.rootGeneratorWeight valid_G2) (G2.lie_lieBasis_h_rootGenerator valid_G2)
    Sum.inl Sum.inr (G2.isSl2Triple_geckRepresentation valid_G2)
    g2RootWeight_inr_eq_neg_inl g2CartanBezout g2RootWeight_sum_mul_bezout A

end TauCeti.DynkinType
