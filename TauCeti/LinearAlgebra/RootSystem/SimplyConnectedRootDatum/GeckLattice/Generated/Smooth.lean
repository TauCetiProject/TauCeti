module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.Reduced
public import TauCeti.Algebra.AlgebraicGroup.Smooth.AlgebraicallyClosed
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.Generated.Basic

/-!
# Smoothness of the generated Geck subgroup

Over an algebraically closed field, the numbered Geck root subgroups and the Geck weight torus of
a valid Dynkin type generate a smooth closed subgroup of `GLₙ`. Each generator has reduced
coordinate algebra, an affine line or a split torus, and a subgroup generated by reduced closed
subgroups of a group over an algebraically closed field is reduced, hence smooth.

Smoothness is one of the geometric properties a split reductive group scheme has, so it is an
input to recognizing the Geck carrier as the pinned simply connected group of its type.

## Main results

* `TauCeti.DynkinType.isReduced_geckGeneratedCoordinateHopfAlgebra`: the generated subgroup has
  reduced coordinate algebra over an algebraically closed field.
* `TauCeti.DynkinType.smoothCommHopfAlgProperty_geckGeneratedCoordinateHopfAlgebra`: the generated
  subgroup is smooth over an algebraically closed field.

## References

* M. Geck, *On the construction of semisimple Lie algebras and Chevalley groups*,
  Proc. Amer. Math. Soc. **145** (2017), 3233--3247.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26--27.
* J. S. Milne, *Algebraic Groups* (2017), §2.h.

The argument follows the parallel minuscule statements in
`TauCeti.Algebra.Lie.E6.Minuscule.Generated.Smooth` and
`TauCeti.Algebra.Lie.E7.Minuscule.Generated.Smooth`.
-/

public section

namespace TauCeti.DynkinType

open CategoryTheory

universe v

variable (t : DynkinType) (ht : t.Valid) (k : Type v) [Field k]

private theorem isReduced_geckGeneratorCoordinateAlgebra :
    ∀ j, IsReduced (t.geckGeneratorCoordinateAlgebra k j) := by
  let : IsReduced (AdditiveGroup.coordinateHopfAlgebra k) :=
    AdditiveGroup.isReduced_coordinateHopfAlgebra k
  let : IsReduced (DiagonalizableGroup.coordinateRing k
      (SplitTorus.characterGroup (Fin t.rank))).obj := inferInstance
  intro j
  cases j with
  | inl i => exact inferInstance
  | inr _ => exact inferInstance

/-- The subgroup generated by the numbered Geck root subgroups and the Geck weight torus has
reduced coordinate algebra over an algebraically closed field. -/
theorem isReduced_geckGeneratedCoordinateHopfAlgebra [IsAlgClosed k] :
    IsReduced (t.geckGeneratedCoordinateHopfAlgebra ht k) := by
  let : ∀ j, IsReduced (t.geckGeneratorCoordinateAlgebra k j) :=
    t.isReduced_geckGeneratorCoordinateAlgebra k
  rw [geckGeneratedCoordinateHopfAlgebra_def, geckGeneratedDefiningIdeal_def]
  exact CommHopfAlgCat.isReduced_quotient_commonKernelHopfIdeal
    (t.geckGeneratorCoordinateMap ht k)

/-- The subgroup generated by the numbered Geck root subgroups and the Geck weight torus is
smooth over an algebraically closed field. -/
theorem smoothCommHopfAlgProperty_geckGeneratedCoordinateHopfAlgebra [IsAlgClosed k] :
    smoothCommHopfAlgProperty k (t.geckGeneratedCoordinateHopfAlgebra ht k) := by
  let : ∀ j, IsReduced (t.geckGeneratorCoordinateAlgebra k j) :=
    t.isReduced_geckGeneratorCoordinateAlgebra k
  rw [geckGeneratedCoordinateHopfAlgebra_def, geckGeneratedDefiningIdeal_def]
  exact CommHopfAlgCat.smoothCommHopfAlgProperty_quotient_commonKernelHopfIdeal
    (t.geckGeneratorCoordinateMap ht k)

end TauCeti.DynkinType
