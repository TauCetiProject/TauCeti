module

public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.GeometricallyReduced
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.Generated.Basic
import Mathlib.RingTheory.TensorProduct.MonoidAlgebra
import TauCeti.RingTheory.Smooth.GeometricallyReduced

/-!
# Smoothness of the generated Geck subgroup

Over any field, the numbered Geck root subgroups and the Geck weight torus of a valid Dynkin type
generate a smooth closed subgroup of `GLₙ`. Their coordinate algebras are geometrically reduced:
an affine line for each root subgroup and a split torus for the weight torus. Smoothness follows
from the common-kernel criterion for geometrically reduced generators.

## Main results

* `TauCeti.DynkinType.smoothCommHopfAlgProperty_geckGeneratedCoordinateHopfAlgebra`: the generated
  subgroup is smooth over any field.
* `TauCeti.DynkinType.isReduced_geckGeneratedCoordinateHopfAlgebra`: the generated subgroup has
  reduced coordinate algebra over any field.

## References

* M. Geck, *On the construction of semisimple Lie algebras and Chevalley groups*,
  Proc. Amer. Math. Soc. **145** (2017), 3233--3247.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26--27.
* J. S. Milne, *Algebraic Groups* (2017), §2.h.
-/

public section

namespace TauCeti.DynkinType

universe v

variable (t : DynkinType) (ht : t.Valid) (k : Type v) [Field k]

private theorem isGeometricallyReduced_geckGeneratorCoordinateAlgebra :
    ∀ j, Algebra.IsGeometricallyReduced k (t.geckGeneratorCoordinateAlgebra k j) := by
  let : Algebra.IsGeometricallyReduced k (AdditiveGroup.coordinateHopfAlgebra k) :=
    isGeometricallyReduced_of_smooth k _
  let : Algebra.IsGeometricallyReduced k (DiagonalizableGroup.coordinateRing k
      (SplitTorus.characterGroup (Fin t.rank))).obj := by
    rw [Algebra.isGeometricallyReduced_field_iff]
    let e := _root_.MonoidAlgebra.scalarTensorEquiv k (AlgebraicClosure k)
      (M := SplitTorus.characterGroup (Fin t.rank))
    exact isReduced_of_injective e e.injective
  intro j
  cases j with
  | inl _ => exact inferInstance
  | inr _ => exact inferInstance

/-- The subgroup generated by the numbered Geck root subgroups and the Geck weight torus is
smooth over any field. -/
theorem smoothCommHopfAlgProperty_geckGeneratedCoordinateHopfAlgebra :
    smoothCommHopfAlgProperty k (t.geckGeneratedCoordinateHopfAlgebra ht k) := by
  let : ∀ j, Algebra.IsGeometricallyReduced k (t.geckGeneratorCoordinateAlgebra k j) :=
    t.isGeometricallyReduced_geckGeneratorCoordinateAlgebra k
  rw [geckGeneratedCoordinateHopfAlgebra_def, geckGeneratedDefiningIdeal_def]
  exact
    CommHopfAlgCat.smoothCommHopfAlgProperty_quotient_commonKernelHopfIdeal_of_geometricallyReduced
      (t.geckGeneratorCoordinateMap ht k)

/-- The subgroup generated by the numbered Geck root subgroups and the Geck weight torus has
reduced coordinate algebra over any field. -/
theorem isReduced_geckGeneratedCoordinateHopfAlgebra :
    IsReduced (t.geckGeneratedCoordinateHopfAlgebra ht k) := by
  let : Algebra.Smooth k (t.geckGeneratedCoordinateHopfAlgebra ht k) :=
    (smoothCommHopfAlgProperty_iff _).mp
      (t.smoothCommHopfAlgProperty_geckGeneratedCoordinateHopfAlgebra ht k)
  exact isReduced_of_smooth k _

end TauCeti.DynkinType
