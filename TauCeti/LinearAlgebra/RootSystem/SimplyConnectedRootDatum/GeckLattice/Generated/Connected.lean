module

public import TauCeti.Algebra.AlgebraicGroup.Connected.Generated
public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.Generated.Basic
import TauCeti.Algebra.AlgebraicGroup.DiagonalizableGroup.SmoothConnected

/-!
# Connectedness of the generated Geck subgroup

Over an algebraically closed field, the numbered Geck root subgroups and the Geck weight torus of
a valid Dynkin type generate a geometrically connected closed subgroup of `GLₙ`. The coordinate
algebra of each generator, an affine line or a split torus, has connected spectrum, and the closed
subgroup they generate inherits that property.

Connectedness is one of the geometric properties a split reductive group scheme has, so it is an
input to recognizing the Geck carrier as the pinned simply connected group of its type.

## Main results

* `TauCeti.DynkinType.geometricallyConnectedCommHopfAlgProperty_geckGeneratedCoordinateHopfAlgebra`:
  the generated subgroup is geometrically connected over an algebraically closed field.

## References

* M. Geck, *On the construction of semisimple Lie algebras and Chevalley groups*,
  Proc. Amer. Math. Soc. **145** (2017), 3233--3247.
* J. S. Milne, *Algebraic Groups* (2017), Propositions 2.37 and 2.48.

The argument follows the parallel minuscule statements in
`TauCeti.Algebra.Lie.E6.Minuscule.Generated.Connected` and
`TauCeti.Algebra.Lie.E7.Minuscule.Generated.Connected`.
-/

public section

namespace TauCeti.DynkinType

open CategoryTheory

universe v

variable (t : DynkinType) (ht : t.Valid) (k : Type v) [Field k]

private theorem connectedSpace_geckGeneratorCoordinateAlgebra :
    ∀ j, ConnectedSpace (PrimeSpectrum (t.geckGeneratorCoordinateAlgebra k j)) := by
  intro j
  cases j with
  | inl _ => exact AdditiveGroup.connectedSpace_primeSpectrum_coordinateHopfAlgebra k
  | inr _ =>
    exact DiagonalizableGroup.connectedSpace_primeSpectrum_coordinateRing k
      (SplitTorus.characterGroup (Fin t.rank))

/-- The subgroup generated by the numbered Geck root subgroups and the Geck weight torus is
geometrically connected over an algebraically closed field. -/
theorem geometricallyConnectedCommHopfAlgProperty_geckGeneratedCoordinateHopfAlgebra
    [IsAlgClosed k] :
    geometricallyConnectedCommHopfAlgProperty k (t.geckGeneratedCoordinateHopfAlgebra ht k) := by
  rw [geckGeneratedCoordinateHopfAlgebra_def, geckGeneratedDefiningIdeal_def]
  exact CommHopfAlgCat.geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient
    (t.geckGeneratorCoordinateMap ht k) (t.connectedSpace_geckGeneratorCoordinateAlgebra k)

end TauCeti.DynkinType
