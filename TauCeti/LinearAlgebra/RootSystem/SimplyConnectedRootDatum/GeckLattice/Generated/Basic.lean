module

public import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.GeckLattice.BaseChange

/-!
# The subgroup generated by the Geck root subgroups and weight torus

For a valid Dynkin type `t`, the `2 · rank` numbered Geck root subgroups and the rank-`t.rank`
Geck weight torus are morphisms into `GLₙ` over any commutative ring `A`, with `n = t.geckDim`.
The closed subgroup they generate is cut out by the largest Hopf ideal killed by all of them,
that is by the common kernel of their coordinate maps.

This file names the ideal that family cuts out and the resulting coordinate Hopf algebra, and
records what a consumer needs about them: a coordinate morphism killing the defining ideal, and
in particular each single generator, factors uniquely through the quotient coordinate map; the
quotient is of finite type; and it lies inside the base change of the integral Geck carrier. The
factorizations are recorded as unique-existence statements about the named quotient coordinate map,
so no Geck-specific restatement of `TauCeti.CommHopfAlgCat.liftQuotient` is needed.

Equality of the generated subgroup with the base change of the integral carrier is not asserted:
extra equations can appear after specialization to a non-flat base. Nor is the generated subgroup
identified with a pinned simply connected group scheme of type `t`.

## Main declarations

* `TauCeti.DynkinType.geckGeneratedDefiningIdeal`: the common kernel of the generator family
  `TauCeti.DynkinType.geckGeneratorCoordinateMap`.
* `TauCeti.DynkinType.geckGeneratedCoordinateHopfAlgebra`: the coordinate Hopf algebra of the
  generated closed subgroup.
* `TauCeti.DynkinType.geckGeneratedCoordinateMap`: its quotient coordinate map, representing the
  closed immersion into `GLₙ`.

## Main results

* `TauCeti.DynkinType.le_geckGeneratedDefiningIdeal_iff`: a Hopf ideal lies below the generated
  subgroup's defining ideal exactly when every generator coordinate map kills it.
* `TauCeti.DynkinType.geckBaseChangeDefiningIdeal_le_geckGeneratedDefiningIdeal`: the
  base-changed integral Geck carrier contains the generated subgroup.
* `TauCeti.DynkinType.existsUnique_geckGeneratedCoordinateMap_comp_eq`: the universal property of
  the generated subgroup, as a unique factorization through its quotient coordinate map.
* `TauCeti.DynkinType.existsUnique_geckGeneratedCoordinateMap_comp_eq_geckGeneratorCoordinateMap`:
  each generator coordinate map factors uniquely through the generated subgroup.

## References

* M. Geck, *On the construction of semisimple Lie algebras and Chevalley groups*,
  Proc. Amer. Math. Soc. **145** (2017), 3233--3247.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26--27.
* R. W. Carter, *Simple Groups of Lie Type*, §4.4.

The quotient presentation of the generated subgroup follows the parallel minuscule constructions
in `TauCeti.Algebra.Lie.E6.Minuscule.Generated.Basic` and
`TauCeti.Algebra.Lie.E7.Minuscule.Generated.Basic`.
-/

public section

namespace TauCeti.DynkinType

open CategoryTheory
open TauCeti.UniversalEnvelopingAlgebra

universe v

noncomputable section

variable (t : DynkinType) (ht : t.Valid) (A : Type v) [CommRing A]

/-- The defining ideal of the subgroup of `GLₙ/A` generated by the numbered Geck root subgroups
and the Geck weight torus. -/
noncomputable def geckGeneratedDefiningIdeal :
    HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht)) :=
  CommHopfAlgCat.commonKernelHopfIdeal (t.geckGeneratorCoordinateMap ht A)

/-- The generated subgroup is defined by the common kernel of its generator maps. -/
@[simp]
theorem geckGeneratedDefiningIdeal_def :
    t.geckGeneratedDefiningIdeal ht A =
      CommHopfAlgCat.commonKernelHopfIdeal (t.geckGeneratorCoordinateMap ht A) := by
  simp [geckGeneratedDefiningIdeal]

/-- A Hopf ideal lies below the generated subgroup's defining ideal exactly when every generator
coordinate map kills it. -/
theorem le_geckGeneratedDefiningIdeal_iff
    (J : HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht))) :
    J ≤ t.geckGeneratedDefiningIdeal ht A ↔
      ∀ j, J.toIdeal ≤ RingHom.ker
        (t.geckGeneratorCoordinateMap ht A j).hom.toAlgHom.toRingHom := by
  rw [geckGeneratedDefiningIdeal_def]
  exact CommHopfAlgCat.le_commonKernelHopfIdeal_iff (t.geckGeneratorCoordinateMap ht A) J

/-- The base change of the integral Geck carrier contains the generated subgroup. This is
`TauCeti.DynkinType.geckBaseChangeDefiningIdeal_le_commonKernel` for the named ideal. -/
theorem geckBaseChangeDefiningIdeal_le_geckGeneratedDefiningIdeal :
    t.geckBaseChangeDefiningIdeal ht A ≤ t.geckGeneratedDefiningIdeal ht A := by
  rw [geckGeneratedDefiningIdeal_def]
  exact t.geckBaseChangeDefiningIdeal_le_commonKernel ht A

/-- The coordinate Hopf algebra of the subgroup of `GLₙ/A` generated by the numbered Geck root
subgroups and the Geck weight torus. -/
noncomputable def geckGeneratedCoordinateHopfAlgebra : CommHopfAlgCat A :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht))
    (t.geckGeneratedDefiningIdeal ht A)

/-- The generated subgroup has the quotient coordinate Hopf algebra of its defining ideal. -/
@[simp]
theorem geckGeneratedCoordinateHopfAlgebra_def :
    t.geckGeneratedCoordinateHopfAlgebra ht A =
      CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht))
        (t.geckGeneratedDefiningIdeal ht A) := by
  simp [geckGeneratedCoordinateHopfAlgebra]

/-- The quotient coordinate morphism `O(GLₙ) ⟶ O(generated subgroup)`, representing the closed
immersion of the generated subgroup into `GLₙ`. -/
noncomputable def geckGeneratedCoordinateMap :
    GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht) ⟶
      t.geckGeneratedCoordinateHopfAlgebra ht A :=
  CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht))
    (t.geckGeneratedDefiningIdeal ht A)

/-- The quotient coordinate morphism of the generated subgroup is surjective. -/
theorem geckGeneratedCoordinateMap_surjective :
    Function.Surjective (t.geckGeneratedCoordinateMap ht A).hom :=
  CommHopfAlgCat.mkQuotient_surjective
    (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht)) (t.geckGeneratedDefiningIdeal ht A)

/-- The kernel of the quotient coordinate morphism is the generated subgroup's defining ideal. -/
@[simp]
theorem geckGeneratedCoordinateMap_ker :
    RingHom.ker (t.geckGeneratedCoordinateMap ht A).hom =
      (t.geckGeneratedDefiningIdeal ht A).toIdeal :=
  CommHopfAlgCat.mkQuotient_ker
    (GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht)) (t.geckGeneratedDefiningIdeal ht A)

/-- **Universal property of the generated subgroup.** A coordinate morphism out of `O(GLₙ)` that
kills the generated subgroup's defining ideal factors through the quotient coordinate map, and does
so in exactly one way. -/
theorem existsUnique_geckGeneratedCoordinateMap_comp_eq {B : CommHopfAlgCat A}
    (f : GeneralLinear.coordinateHopfAlgebra A (t.geckDim ht) ⟶ B)
    (hf : (t.geckGeneratedDefiningIdeal ht A).toIdeal ≤
      RingHom.ker f.hom.toAlgHom.toRingHom) :
    ∃! g : t.geckGeneratedCoordinateHopfAlgebra ht A ⟶ B,
      t.geckGeneratedCoordinateMap ht A ≫ g = f :=
  ⟨CommHopfAlgCat.liftQuotient (t.geckGeneratedDefiningIdeal ht A) f hf,
    CommHopfAlgCat.mkQuotient_comp_liftQuotient (t.geckGeneratedDefiningIdeal ht A) f hf,
    fun g hg => CommHopfAlgCat.liftQuotient_unique (t.geckGeneratedDefiningIdeal ht A) f hf g hg⟩

/-- Each generator coordinate map factors through the generated subgroup's quotient coordinate map,
and does so in exactly one way. -/
theorem existsUnique_geckGeneratedCoordinateMap_comp_eq_geckGeneratorCoordinateMap
    (j : Sum (Fin t.rank ⊕ Fin t.rank) Unit) :
    ∃! g : t.geckGeneratedCoordinateHopfAlgebra ht A ⟶ t.geckGeneratorCoordinateAlgebra A j,
      t.geckGeneratedCoordinateMap ht A ≫ g = t.geckGeneratorCoordinateMap ht A j :=
  t.existsUnique_geckGeneratedCoordinateMap_comp_eq ht A (t.geckGeneratorCoordinateMap ht A j) <| by
    rw [geckGeneratedDefiningIdeal_def]
    exact CommHopfAlgCat.commonKernelHopfIdeal_toIdeal_le_ker
      (t.geckGeneratorCoordinateMap ht A) j

/-- The coordinate Hopf algebra of the generated subgroup is a finite-type `A`-algebra. -/
instance : Algebra.FiniteType A (t.geckGeneratedCoordinateHopfAlgebra ht A) := by
  rw [geckGeneratedCoordinateHopfAlgebra_def]
  infer_instance

end

end TauCeti.DynkinType
