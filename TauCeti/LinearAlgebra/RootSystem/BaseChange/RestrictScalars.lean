module

public import Mathlib.LinearAlgebra.RootSystem.BaseChange
public import Mathlib.LinearAlgebra.RootSystem.CartanMatrix

/-!
# Bases under restriction of scalars

Mathlib restricts a root pairing valued in a subfield `K` of `L` to the `K`-spans of its roots and
coroots (`RootPairing.restrictScalars'`). This file transports the rest of the structure used to
reason about a Cartan matrix: being crystallographic and reduced, and a base. The restricted base
has the same simple roots, and hence the same Cartan matrix.

The main use is `K = ℚ`: a crystallographic root pairing over any field of characteristic zero has a
form over a linearly ordered field, where positivity arguments about the root system apply, without
changing the integer pairings.

## Main definitions

* `RootPairing.Base.restrictScalars'`: a base restricted to a subfield.

## Main results

* `RootPairing.pairingIn_restrictScalars'`: restriction of scalars preserves the integer pairings.
* `RootPairing.Base.cartanMatrix_restrictScalars'`: restriction of scalars preserves the Cartan
  matrix of a base.
-/

public section

open Set Submodule

namespace RootPairing

variable {ι L M N : Type*} [Field L] [AddCommGroup M] [Module L M] [AddCommGroup N] [Module L N]
  {P : RootPairing ι L M N} (K : Type*) [Field K] [Algebra K L] [Module K M] [Module K N]
  [IsScalarTower K L M] [IsScalarTower K L N] [P.IsBalanced] [P.IsValuedIn K]

instance [P.IsCrystallographic] : (P.restrictScalars' K).IsCrystallographic where
  exists_value i j := by
    obtain ⟨z, hz⟩ := P.exists_value (S := ℤ) i j
    refine ⟨z, FaithfulSMul.algebraMap_injective K L ?_⟩
    rw [restrictScalars_pairing, ← hz, eq_intCast, eq_intCast, map_intCast]

instance [P.IsReduced] : (P.restrictScalars' K).IsReduced where
  eq_or_eq_neg i j h := by
    have hne : ¬ LinearIndependent L ![P.root i, P.root j] := fun hL ↦ h <| by
      refine LinearIndependent.of_comp (span K (range P.root)).subtype ?_
      convert LinearIndependent.restrict_scalars' K hL using 1
      ext k
      fin_cases k <;> rfl
    exact (IsReduced.eq_or_eq_neg i j hne).imp (fun h ↦ Subtype.ext h) fun h ↦ Subtype.ext h

/-- Restriction of scalars preserves the integer pairings of a crystallographic root pairing. -/
@[simp]
theorem pairingIn_restrictScalars' [CharZero L] [P.IsCrystallographic] (i j : ι) :
    (P.restrictScalars' K).pairingIn ℤ i j = P.pairingIn ℤ i j := by
  have h₁ := (P.restrictScalars' K).algebraMap_pairingIn ℤ i j
  have h₂ := P.algebraMap_pairingIn ℤ i j
  have h₃ := P.restrictScalars_pairing K i j
  rw [← h₁, eq_intCast, map_intCast] at h₃
  rw [eq_intCast] at h₂
  exact Int.cast_injective (h₃.trans h₂.symm)

/-- A vector of the restricted root span lies in the additive monoid generated by a set of
restricted roots as soon as it lies in the additive monoid generated by the corresponding roots. -/
theorem mem_closure_root_restrictScalars' {s : Set ι} {y : span K (range P.root)}
    (hy : (y : M) ∈ AddSubmonoid.closure (P.root '' s)) :
    y ∈ AddSubmonoid.closure ((P.restrictScalars' K).root '' s) :=
  (AddSubmonoid.mem_map_iff_mem (f := (span K (range P.root)).subtype.toAddMonoidHom)
    (injective_subtype _)).1 <| by rwa [AddMonoidHom.map_mclosure, image_image]

/-- A vector of the restricted coroot span lies in the additive monoid generated by a set of
restricted coroots as soon as it lies in the additive monoid generated by the corresponding
coroots. -/
theorem mem_closure_coroot_restrictScalars' {s : Set ι} {y : span K (range P.coroot)}
    (hy : (y : N) ∈ AddSubmonoid.closure (P.coroot '' s)) :
    y ∈ AddSubmonoid.closure ((P.restrictScalars' K).coroot '' s) :=
  (AddSubmonoid.mem_map_iff_mem (f := (span K (range P.coroot)).subtype.toAddMonoidHom)
    (injective_subtype _)).1 <| by rwa [AddMonoidHom.map_mclosure, image_image]

/-- A base of a root pairing valued in a subfield restricts to a base of the restricted root
pairing, with the same simple roots. The body is exposed because the two bases are compared through
the definitional equality of their supports, which index the same Cartan matrix. -/
@[expose]
def Base.restrictScalars' (b : P.Base) : (P.restrictScalars' K).Base where
  support := b.support
  linearIndepOn_root := LinearIndependent.of_comp (span K (range P.root)).subtype
    (LinearIndependent.restrict_scalars' K b.linearIndepOn_root)
  linearIndepOn_coroot := LinearIndependent.of_comp (span K (range P.coroot)).subtype
    (LinearIndependent.restrict_scalars' K b.linearIndepOn_coroot)
  root_mem_or_neg_mem i := (b.root_mem_or_neg_mem i).imp
    (mem_closure_root_restrictScalars' K) (mem_closure_root_restrictScalars' K)
  coroot_mem_or_neg_mem i := (b.coroot_mem_or_neg_mem i).imp
    (mem_closure_coroot_restrictScalars' K) (mem_closure_coroot_restrictScalars' K)

/-- Restriction of scalars preserves the Cartan matrix of a base. -/
@[simp]
theorem Base.cartanMatrix_restrictScalars' [CharZero L] [P.IsCrystallographic] (b : P.Base) :
    (b.restrictScalars' K).cartanMatrix = b.cartanMatrix := by
  ext i j
  simp only [cartanMatrix, cartanMatrixIn_def]
  exact pairingIn_restrictScalars' K i.1 j.1

end RootPairing
