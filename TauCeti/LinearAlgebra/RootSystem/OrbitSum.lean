module

public import Mathlib.LinearAlgebra.FixedSubmodule
public import TauCeti.LinearAlgebra.RootSystem.Positive
import TauCeti.GroupTheory.Perm.Basic
import TauCeti.LinearAlgebra.RootSystem.HomInvariance

/-!
# Distinct root-orbit sums of a root-pairing automorphism

Let `P` be a root pairing with finitely many roots and `σ` an automorphism of `P`. The
automorphism permutes the root indices, and the **root orbit** of an index `i` is the finite set
`RootPairing.orbitIndices P σ i` of the distinct indices `σᵏ i`. Its **orbit sum**
`RootPairing.orbitSum P σ i` is the sum of the corresponding roots, each counted once. These
vectors are the roots of the folding of `P` by `σ`: when `σ` permutes the simple roots of a finite
root system and the simple roots in each orbit are pairwise orthogonal, the distinct orbit sums
form a root system on the fixed space of `σ`, whose simple roots are the sums over orbits of
simple roots (Stembridge). This file develops the orbit sums themselves; it does not construct a
folded root system.

The orbit is the orbit of the cyclic group generated by `σ`, but no period or exponent of `σ` is
part of the data. A sum over a full period `m` of `σ` at `i` counts every root of the orbit
`m / d` times, where `d` is the size of the orbit
(`RootPairing.sum_range_root_pow_apply_eq_nsmul`); for instance six iterates of triality on an
outer root of `D₄` give twice the orbit sum.

The map `i ↦ orbitSum P σ i` need not be injective: in `A₂` with the diagram reversal, the
two-element orbit of simple roots and the fixed highest root have the same sum. The folded roots
are therefore indexed by the image `RootPairing.foldedIndices P σ`, a finite set of vectors.

## Main definitions

* `RootPairing.orbitIndices`: the distinct indices in the orbit of a root index.
* `RootPairing.orbitSum`: the sum of the roots in that orbit, each counted once.
* `RootPairing.foldedIndices`: the set of all orbit sums.

## Main results

* `RootPairing.mem_orbitIndices_iff_exists_pow`: the orbit consists of the forward iterates.
* `RootPairing.card_orbitIndices`: the size of the orbit is the minimal period of `i`.
* `RootPairing.orbitSum_eq_of_mem`: the orbit sum does not depend on the representative.
* `RootPairing.orbitSum_eq_root_of_indexEquiv_eq`: the orbit sum of a fixed root is that root.
* `RootPairing.sum_range_root_pow_apply_eq_nsmul`: a sum over a period `m` is `m / d` times the
  orbit sum.
* `RootPairing.weightMap_orbitSum`: an equivalence of root pairings intertwining two automorphisms
  carries orbit sums to orbit sums; in particular `RootPairing.orbitSum_mem_fixedSubmodule` says
  each orbit sum is fixed by `σ`.
* `RootPairing.orbitSum_reflectionPerm_self`: the orbit sum of a negated root is the negated
  orbit sum.
* `RootPairing.orbitSum_mem_posRootCone` and `RootPairing.orbitSum_ne_zero`: for an automorphism
  permuting the simple roots of a base, the orbit sum of a positive root is a natural combination
  of simple roots, and no orbit sum vanishes (`RootPairing.zero_notMem_foldedIndices`).

## References

* J. R. Stembridge, *Folding by automorphisms*, note of 20 August 2008, page 1.
-/

public section

namespace RootPairing

open Finset TauCeti

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : RootPairing ι R M N) [Finite ι]

/-! ### Root orbits -/

/-- The **root orbit** of the index `i` under the automorphism `σ`: the finite set of distinct
root indices `σᵏ i`, that is, of the indices on the same cycle of `σ` as `i`. -/
noncomputable def orbitIndices (σ : P.Aut) (i : ι) : Finset ι :=
  (Set.toFinite {j | Equiv.Perm.SameCycle σ.indexEquiv i j}).toFinset

variable {P} {σ : P.Aut} {i j : ι}

@[simp]
theorem mem_orbitIndices : j ∈ P.orbitIndices σ i ↔ Equiv.Perm.SameCycle σ.indexEquiv i j := by
  simp [orbitIndices]

/-- The root orbit consists of the forward iterates `σᵏ i` with `k` a natural number. -/
theorem mem_orbitIndices_iff_exists_pow :
    j ∈ P.orbitIndices σ i ↔ ∃ k : ℕ, (σ.indexEquiv ^ k) i = j := by
  rw [mem_orbitIndices]
  refine ⟨Equiv.Perm.SameCycle.exists_nat_pow_eq, ?_⟩
  rintro ⟨k, rfl⟩
  exact Equiv.Perm.sameCycle_pow_right.mpr (Equiv.Perm.SameCycle.refl _ _)

variable (P σ i) in
theorem self_mem_orbitIndices : i ∈ P.orbitIndices σ i :=
  mem_orbitIndices.mpr (Equiv.Perm.SameCycle.refl _ _)

variable (P σ i) in
theorem orbitIndices_nonempty : (P.orbitIndices σ i).Nonempty :=
  ⟨i, self_mem_orbitIndices P σ i⟩

/-- The root orbit is stable under `σ`. -/
theorem indexEquiv_mem_orbitIndices_iff :
    σ.indexEquiv j ∈ P.orbitIndices σ i ↔ j ∈ P.orbitIndices σ i := by
  simp only [mem_orbitIndices, Equiv.Perm.sameCycle_apply_right]

/-- Two indices in one root orbit have the same root orbit. -/
theorem orbitIndices_eq_of_mem (h : j ∈ P.orbitIndices σ i) :
    P.orbitIndices σ j = P.orbitIndices σ i := by
  ext k
  simp only [mem_orbitIndices] at h ⊢
  exact ⟨h.trans, h.symm.trans⟩

variable (P σ i) in
@[simp]
theorem orbitIndices_indexEquiv : P.orbitIndices σ (σ.indexEquiv i) = P.orbitIndices σ i :=
  orbitIndices_eq_of_mem (indexEquiv_mem_orbitIndices_iff.mpr (self_mem_orbitIndices P σ i))

/-- The root orbit of `i` is `{i}` exactly when `σ` fixes `i`. -/
theorem orbitIndices_eq_singleton_iff : P.orbitIndices σ i = {i} ↔ σ.indexEquiv i = i := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · simpa [h] using indexEquiv_mem_orbitIndices_iff.mpr (self_mem_orbitIndices P σ i)
  · ext j
    rw [mem_orbitIndices, Finset.mem_singleton]
    exact ⟨fun hj ↦ (hj.eq_of_left h).symm, fun hj ↦ hj ▸ Equiv.Perm.SameCycle.refl _ _⟩

variable (P i) in
@[simp]
theorem orbitIndices_one : P.orbitIndices 1 i = {i} :=
  orbitIndices_eq_singleton_iff.mpr rfl

variable (P σ i) in
/-- The size of the root orbit of `i` is the minimal period of `i` under `σ`. -/
theorem card_orbitIndices :
    #(P.orbitIndices σ i) = Function.minimalPeriod σ.indexEquiv i := by
  rw [orbitIndices, ← Set.ncard_eq_toFinset_card, Equiv.Perm.ncard_setOf_sameCycle]

variable (P σ i) in
theorem card_orbitIndices_pos : 0 < #(P.orbitIndices σ i) :=
  (orbitIndices_nonempty P σ i).card_pos

/-- If `σᵐ` fixes `i`, then the size of the root orbit of `i` divides `m`. -/
theorem card_orbitIndices_dvd {m : ℕ} (hm : (σ.indexEquiv ^ m) i = i) :
    #(P.orbitIndices σ i) ∣ m := by
  rw [card_orbitIndices]
  have hper : (⇑σ.indexEquiv)^[m] i = i := by rwa [← Equiv.Perm.coe_pow]
  exact Function.IsPeriodicPt.minimalPeriod_dvd hper

/-! ### Orbit sums -/

variable (P σ i) in
/-- The **orbit sum** of the root `αᵢ` under the automorphism `σ`: the sum of the roots indexed
by the distinct members of the root orbit of `i`, each counted once. -/
noncomputable def orbitSum : M :=
  ∑ j ∈ P.orbitIndices σ i, P.root j

variable (P σ i) in
theorem orbitSum_def : P.orbitSum σ i = ∑ j ∈ P.orbitIndices σ i, P.root j := by
  rw [orbitSum]

/-- The orbit sum does not depend on the chosen member of the orbit. -/
theorem orbitSum_eq_of_mem (h : j ∈ P.orbitIndices σ i) : P.orbitSum σ j = P.orbitSum σ i := by
  rw [orbitSum, orbitSum, orbitIndices_eq_of_mem h]

variable (P σ i) in
@[simp]
theorem orbitSum_indexEquiv : P.orbitSum σ (σ.indexEquiv i) = P.orbitSum σ i := by
  rw [orbitSum, orbitSum, orbitIndices_indexEquiv]

/-- The orbit sum of a root fixed by `σ` is that root. -/
theorem orbitSum_eq_root_of_indexEquiv_eq (h : σ.indexEquiv i = i) :
    P.orbitSum σ i = P.root i := by
  rw [orbitSum, orbitIndices_eq_singleton_iff.mpr h, sum_singleton]

variable (P i) in
@[simp]
theorem orbitSum_one : P.orbitSum 1 i = P.root i :=
  orbitSum_eq_root_of_indexEquiv_eq rfl

variable (P σ i) in
/-- The orbit sum is the sum of the roots `σᵏ αᵢ` for `k` below the minimal period of `i`. -/
theorem orbitSum_eq_sum_range :
    P.orbitSum σ i =
      ∑ k ∈ range (Function.minimalPeriod σ.indexEquiv i), P.root ((σ.indexEquiv ^ k) i) := by
  classical
  have hinj : Set.InjOn (fun k : ℕ ↦ (σ.indexEquiv ^ k) i)
      (range (Function.minimalPeriod σ.indexEquiv i)) := by
    simpa [Equiv.Perm.coe_pow, Set.InjOn] using
      Function.iterate_injOn_Iio_minimalPeriod (f := σ.indexEquiv) (x := i)
  rw [orbitSum, ← sum_image hinj]
  congr 1
  refine (eq_of_subset_of_card_le (fun j hj ↦ ?_) ?_).symm
  · obtain ⟨k, -, rfl⟩ := mem_image.mp hj
    exact mem_orbitIndices_iff_exists_pow.mpr ⟨k, rfl⟩
  · rw [card_image_of_injOn hinj, card_range, card_orbitIndices]

/-- **Full-period sums.** If `σᵐ` fixes `i`, then summing the roots `σᵏ αᵢ` over `k < m`
counts every root of the orbit `m / d` times, where `d` is the size of the orbit. -/
theorem sum_range_root_pow_apply_eq_nsmul {m : ℕ} (hm : (σ.indexEquiv ^ m) i = i) :
    ∑ k ∈ range m, P.root ((σ.indexEquiv ^ k) i) =
      (m / #(P.orbitIndices σ i)) • P.orbitSum σ i := by
  obtain ⟨q, rfl⟩ := card_orbitIndices_dvd (P := P) hm
  clear hm
  have hd := card_orbitIndices_pos P σ i
  rw [Nat.mul_div_cancel_left q hd, card_orbitIndices, orbitSum_eq_sum_range]
  set d := Function.minimalPeriod σ.indexEquiv i
  have hper (n k : ℕ) : (σ.indexEquiv ^ (d * n + k)) i = (σ.indexEquiv ^ k) i := by
    rw [Equiv.Perm.coe_pow, Equiv.Perm.coe_pow, ← Function.iterate_mod_minimalPeriod_eq,
      Nat.mul_add_mod]
    exact Function.iterate_mod_minimalPeriod_eq
  induction q with
  | zero => simp
  | succ n ih => rw [Nat.mul_succ, sum_range_add, ih, succ_nsmul]; simp only [hper]

/-- Every orbit sum lies in any additive submonoid containing all the roots. -/
theorem orbitSum_mem {S : Type*} [SetLike S M] [AddSubmonoidClass S M] {L : S}
    (hL : ∀ j, P.root j ∈ L) : P.orbitSum σ i ∈ L :=
  sum_mem fun j _ ↦ hL j

/-! ### Transport along equivalences -/

section Map

variable {ι₂ M₂ N₂ : Type*} [AddCommGroup M₂] [Module R M₂] [AddCommGroup N₂] [Module R N₂]
  {P₂ : RootPairing ι₂ R M₂ N₂} [Finite ι₂]

/-- An equivalence of root pairings intertwining `σ` and `τ` on the root indices carries the root
orbits of `σ` bijectively onto those of `τ`. -/
theorem map_orbitIndices (e : P.Equiv P₂) {τ : P₂.Aut}
    (h : ∀ j, e.indexEquiv (σ.indexEquiv j) = τ.indexEquiv (e.indexEquiv j)) (i : ι) :
    (P.orbitIndices σ i).map e.indexEquiv.toEmbedding = P₂.orbitIndices τ (e.indexEquiv i) := by
  have hsymm (z : ι₂) : e.indexEquiv.symm (τ.indexEquiv z) =
      σ.indexEquiv (e.indexEquiv.symm z) := by
    rw [e.indexEquiv.symm_apply_eq, h, e.indexEquiv.apply_symm_apply]
  ext k
  simp only [mem_map_equiv, mem_orbitIndices]
  refine ⟨fun hk ↦ ?_, fun hk ↦ ?_⟩
  · simpa using hk.map (g := e.indexEquiv) h
  · simpa using hk.map (g := e.indexEquiv.symm) hsymm

/-- An equivalence of root pairings intertwining `σ` and `τ` on the root indices carries each
orbit sum of `σ` to the corresponding orbit sum of `τ`. -/
theorem weightMap_orbitSum (e : P.Equiv P₂) {τ : P₂.Aut}
    (h : ∀ j, e.indexEquiv (σ.indexEquiv j) = τ.indexEquiv (e.indexEquiv j)) (i : ι) :
    e.weightMap (P.orbitSum σ i) = P₂.orbitSum τ (e.indexEquiv i) := by
  rw [orbitSum, orbitSum, ← map_orbitIndices e h, sum_map, map_sum]
  exact sum_congr rfl fun j _ ↦ Hom.root_weightMap_apply P P₂ j e.toHom

end Map

variable (P σ i) in
/-- Every orbit sum is fixed by `σ`. -/
@[simp]
theorem weightMap_orbitSum_self : σ.weightMap (P.orbitSum σ i) = P.orbitSum σ i := by
  rw [weightMap_orbitSum σ (fun _ ↦ rfl), orbitSum_indexEquiv]

variable (P σ i) in
theorem orbitSum_mem_fixedSubmodule :
    P.orbitSum σ i ∈ LinearMap.fixedSubmodule σ.weightMap :=
  LinearMap.mem_fixedSubmodule_iff.mpr (weightMap_orbitSum_self P σ i)

/-! ### Negation -/

variable (P σ i) in
/-- The orbit sum of the negative of a root is the negative of its orbit sum. -/
@[simp]
theorem orbitSum_reflectionPerm_self :
    P.orbitSum σ (P.reflectionPerm i i) = -P.orbitSum σ i := by
  have hneg := reflectionPerm_self_involutive P
  have hmaps {i j : ι} (hj : j ∈ P.orbitIndices σ i) :
      P.reflectionPerm j j ∈ P.orbitIndices σ (P.reflectionPerm i i) := by
    rw [mem_orbitIndices] at hj ⊢
    exact hj.map (g := fun z ↦ P.reflectionPerm z z) fun z ↦
      (σ.toHom.indexEquiv_reflectionPerm z z).symm
  rw [orbitSum, orbitSum, ← sum_neg_distrib]
  refine sum_nbij' (fun j ↦ P.reflectionPerm j j) (fun j ↦ P.reflectionPerm j j)
    (fun j hj ↦ ?_) (fun j hj ↦ hmaps hj) (fun j _ ↦ hneg j) (fun j _ ↦ hneg j) fun j _ ↦ ?_
  · simpa only [hneg i] using hmaps hj
  · rw [root_reflectionPerm, reflection_apply_self, neg_neg]

/-! ### Orbit sums and a base -/

section Base

variable [CharZero R] {b : P.Base}

/-- For an automorphism permuting the simple roots of `b`, the roots of one orbit are all
positive or all negative. -/
theorem isPos_iff_of_mem_orbitIndices (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (h : j ∈ P.orbitIndices σ i) : b.IsPos j ↔ b.IsPos i :=
  Iff.of_eq ((mem_orbitIndices.mp h).apply_eq_of_apply_eq (f := b.IsPos) fun z ↦
    propext (b.isPos_indexEquiv_iff hσ z)).symm

/-- For an automorphism permuting the simple roots of `b`, the orbit sum of a positive root is a
natural combination of the simple roots. -/
theorem orbitSum_mem_posRootCone (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (hi : b.IsPos i) : P.orbitSum σ i ∈ posRootCone P b :=
  sum_mem fun j hj ↦ root_mem_posRootCone_of_mem_posRoots P b
    ((mem_posRoots P b j).mpr ((isPos_iff_of_mem_orbitIndices hσ hj).mpr hi))

/-- For an automorphism permuting the simple roots of a base, no orbit sum vanishes: the roots
of an orbit are all positive or all negative, so they cannot cancel. -/
theorem orbitSum_ne_zero (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (i : ι) : P.orbitSum σ i ≠ 0 := by
  have hpos {i : ι} (hi : b.IsPos i) : P.orbitSum σ i ≠ 0 :=
    sum_root_ne_zero_of_mem_posRoots P b (orbitIndices_nonempty P σ i) fun j hj ↦
      (mem_posRoots P b j).mpr ((isPos_iff_of_mem_orbitIndices hσ hj).mpr hi)
  by_cases hi : b.IsPos i
  · exact hpos hi
  · rw [← neg_ne_zero, ← orbitSum_reflectionPerm_self]
    exact hpos ((isPos_reflectionPerm_self_iff_mem_negRoots P b i).mpr
      ((mem_negRoots P b i).mpr hi))

end Base

/-! ### The set of orbit sums -/

variable (P σ) in
/-- The set of all orbit sums of `σ`. Distinct orbits may have the same sum, so this set, rather
than the set of orbits, indexes the folded roots. -/
noncomputable def foldedIndices : Set M :=
  Set.range (P.orbitSum σ)

@[simp]
theorem mem_foldedIndices {x : M} : x ∈ P.foldedIndices σ ↔ ∃ i, P.orbitSum σ i = x :=
  Iff.rfl

variable (P σ i) in
theorem orbitSum_mem_foldedIndices : P.orbitSum σ i ∈ P.foldedIndices σ :=
  ⟨i, rfl⟩

instance : Finite (P.foldedIndices σ) :=
  Set.finite_range _

variable (P) in
/-- For the identity automorphism the orbit sums are exactly the roots. -/
@[simp]
theorem foldedIndices_one : P.foldedIndices 1 = Set.range P.root := by
  rw [foldedIndices, funext (orbitSum_one P)]

/-- For an automorphism permuting the simple roots of a base, zero is not an orbit sum. -/
theorem zero_notMem_foldedIndices [CharZero R] {b : P.Base}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) : 0 ∉ P.foldedIndices σ := by
  rintro ⟨i, hi⟩
  exact orbitSum_ne_zero hσ i hi

end RootPairing
