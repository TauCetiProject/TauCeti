module

public import Mathlib.Geometry.Convex.Cone.Pointed
public import Mathlib.LinearAlgebra.RootSystem.Finite.Nondegenerate
public import TauCeti.LinearAlgebra.RootSystem.Weyl.Group
import Mathlib.LinearAlgebra.QuadraticForm.Dual

/-!
# Simple systems of a finite root pairing over an ordered field

Let `P` be a finite reduced root pairing over a linearly ordered field `R`, with no
crystallographic hypothesis, so that `P` may be the root system of any finite real reflection
group, such as `H₃`, `H₄` or a dihedral group `I₂(m)`. Mathlib's `RootPairing.Base` asks for
integral coefficients, which such root systems lack. This file develops the real-coefficient
replacement, following Humphreys, *Reflection Groups and Coxeter Groups*, §§1.3–1.5.

A linear functional `f` on the weight space cuts out the **positive system**
`RootPairing.positiveSystem P f`, the roots on which `f` is positive. Its **simple system**
`RootPairing.simpleSystem P f` consists of the positive roots that are not nonnegative
combinations of the other positive roots, so their rays are the extreme rays of the cone spanned
by the positive roots. When `f` vanishes on no root:

* every positive root is a nonnegative combination of simple roots, and every root is a
  nonnegative or a nonpositive one;
* two distinct simple roots have nonpositive pairing;
* the simple roots are linearly independent, so they form a basis of the span of the roots;
* the simple system is the only linearly independent set of positive roots whose cone contains
  every positive root;
* a simple reflection permutes the positive roots other than its own root;
* every root is carried to a simple root by a product of simple reflections, so the simple
  reflections generate the Weyl group.

These are the facts from which the chamber geometry of a finite real reflection group, and its
Coxeter presentation by the simple reflections, are built.

Unlike Humphreys, we define the simple system canonically as the set of extreme positive roots
rather than as a minimal spanning subset; the two agree by
`RootPairing.eq_simpleSystem_of_linearIndepOn`. Linear independence uses Mathlib's
`LinearMap.BilinForm.linearIndependent_of_pairwise_le_zero` for the positive definite form
`RootPairing.posRootForm`.

## Main definitions

* `RootPairing.positiveSystem`: the roots on which a linear functional is positive.
* `RootPairing.simpleSystem`: the positive roots spanning extreme rays of the positive cone.

## Main results

* `RootPairing.root_ne_smul_root_of_mem_positiveSystem`: distinct positive roots are not
  proportional.
* `RootPairing.root_mem_hull_simpleSystem`: every positive root lies in the cone spanned by the
  simple roots.
* `RootPairing.root_mem_hull_simpleSystem_or_neg_mem`: every root or its negative lies there.
* `RootPairing.pairing_nonpos_of_mem_simpleSystem`: distinct simple roots have nonpositive pairing.
* `RootPairing.linearIndepOn_root_simpleSystem`: the simple roots are linearly independent.
* `RootPairing.span_root_simpleSystem` and `RootPairing.ncard_simpleSystem`: the simple roots
  span the span of the roots, and their number is its dimension.
* `RootPairing.eq_simpleSystem_of_linearIndepOn`: uniqueness of the simple system.
* `RootPairing.reflectionPerm_mem_positiveSystem`: a simple reflection permutes the other positive
  roots.
* `RootPairing.exists_weylGroupToPerm_mem_simpleSystem`: every root is conjugate to a simple root
  under the subgroup generated by the simple reflections.
* `RootPairing.weylGroup_eq_closure_simpleSystem`: the simple reflections generate the Weyl group.

## References

* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, §§1.3–1.5.
-/

public section

open Module Set Submodule

namespace RootPairing

variable {ι R M N : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : RootPairing ι R M N) (f : Dual R M)

/-- The positive system of a linear functional `f`: the roots on which `f` is positive. -/
def positiveSystem : Set ι :=
  {i | 0 < f (P.root i)}

/-- The simple system of a linear functional `f`: the positive roots that are not nonnegative
combinations of the other positive roots. -/
def simpleSystem : Set ι :=
  {i | 0 < f (P.root i) ∧
    P.root i ∉ PointedCone.hull R (P.root '' (P.positiveSystem f \ {i}))}

variable {i j : ι}

omit [IsStrictOrderedRing R] in
@[simp]
lemma mem_positiveSystem : i ∈ P.positiveSystem f ↔ 0 < f (P.root i) :=
  Iff.rfl

lemma mem_simpleSystem :
    i ∈ P.simpleSystem f ↔ 0 < f (P.root i) ∧
      P.root i ∉ PointedCone.hull R (P.root '' (P.positiveSystem f \ {i})) :=
  Iff.rfl

lemma simpleSystem_subset_positiveSystem : P.simpleSystem f ⊆ P.positiveSystem f :=
  fun _ hi => hi.1

variable {P f}

/-- A vector in the cone spanned by roots on which `f` is positive is zero as soon as `f`
vanishes on it. -/
private lemma nonneg_and_eq_zero_of_mem_hull {S : Set ι} (hS : S ⊆ P.positiveSystem f)
    {x : M} (hx : x ∈ PointedCone.hull R (P.root '' S)) :
    0 ≤ f x ∧ (f x = 0 → x = 0) := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨k, hk, rfl⟩ := hx
    have := hS hk
    exact ⟨this.le, fun h => (this.ne' h).elim⟩
  | zero => simp
  | add x y _ _ hx hy =>
    refine ⟨by simpa using add_nonneg hx.1 hy.1, fun h => ?_⟩
    rw [map_add] at h
    rw [hx.2 (by linarith [hx.1, hy.1]), hy.2 (by linarith [hx.1, hy.1]), add_zero]
  | smul c x _ hx =>
    obtain ⟨c, hc⟩ := c
    simp only [Nonneg.mk_smul, map_smul, smul_eq_mul]
    refine ⟨mul_nonneg hc hx.1, fun h => ?_⟩
    rcases mul_eq_zero.mp h with h | h
    · simp [h]
    · simp [hx.2 h]

/-- A nonzero vector in the cone spanned by roots on which `f` is positive has positive value
under `f`. -/
private lemma apply_pos_of_mem_hull {S : Set ι} (hS : S ⊆ P.positiveSystem f)
    {x : M} (hx : x ∈ PointedCone.hull R (P.root '' S)) (hx₀ : x ≠ 0) : 0 < f x :=
  (nonneg_and_eq_zero_of_mem_hull hS hx).1.lt_of_ne
    fun h => hx₀ ((nonneg_and_eq_zero_of_mem_hull hS hx).2 h.symm)

/-- The cone of a set of roots lies in the cone of a root together with the other roots of the
set. -/
private lemma hull_root_image_le_hull_insert (T : Set ι) (i : ι) :
    PointedCone.hull R (P.root '' T) ≤
      PointedCone.hull R (insert (P.root i) (P.root '' (T \ {i}))) := by
  refine span_mono ?_
  rintro - ⟨k, hk, rfl⟩
  by_cases hki : k = i
  · exact hki ▸ mem_insert _ _
  · exact mem_insert_of_mem _ ⟨k, ⟨hk, hki⟩, rfl⟩

omit [LinearOrder R] [IsStrictOrderedRing R] in
/-- A member of a linearly independent set of roots is not in the span of the others. -/
private lemma root_notMem_span_image_sdiff {S : Set ι} (hli : LinearIndepOn R P.root S)
    (hi : i ∈ S) : P.root i ∉ span R (P.root '' (S \ {i})) := by
  have hli' : LinearIndepOn R P.root (insert i (S \ {i})) := by
    rwa [insert_sdiff_singleton, insert_eq_of_mem hi]
  exact ((linearIndepOn_insert (by simp)).mp hli').2

/-- The negative of a root is positive exactly when the root is negative. -/
lemma reflectionPerm_self_mem_positiveSystem_iff :
    P.reflectionPerm i i ∈ P.positiveSystem f ↔ f (P.root i) < 0 := by
  simp [root_reflectionPerm, reflection_apply_self]

/-- The positive form detects the sign of the pairing. -/
private lemma rootForm_root_root_le_zero_iff [Fintype ι] :
    P.RootForm (P.root i) (P.root j) ≤ 0 ↔ P.pairing i j ≤ 0 := by
  have h₁ := P.algebraMap_posRootForm_posForm R (P.rootSpanMem R i) (P.rootSpanMem R j)
  have h₂ := P.algebraMap_pairingIn R i j
  simp only [Algebra.algebraMap_self, RingHom.id_apply] at h₁ h₂
  rw [← h₁, ← h₂]
  exact (P.posRootForm R).posForm_apply_root_root_le_zero_iff i j

variable [P.IsReduced]

/-- Distinct positive roots are not proportional. -/
lemma root_ne_smul_root_of_mem_positiveSystem (hi : i ∈ P.positiveSystem f)
    (hj : j ∈ P.positiveSystem f) (hij : j ≠ i) (t : R) : P.root j ≠ t • P.root i := by
  have hneg : P.root j ≠ -P.root i := fun h => by
    have := hj.out
    rw [h, map_neg] at this
    linarith [hi.out]
  have hli := IsReduced.linearIndependent P hij hneg
  rw [LinearIndependent.pair_iff] at hli
  exact fun h => one_ne_zero (hli 1 (-t) (by simp [h])).1

/-- The key cone computation behind the simple system. Suppose `T` is a set of positive roots
whose cone contains every positive root. If a positive root `αᵢ` is a nonnegative combination of
the other positive roots, then it is already a nonnegative combination of the members of `T`
other than itself. -/
private lemma root_mem_hull_sdiff_singleton {T : Set ι} (hT : T ⊆ P.positiveSystem f)
    (hTspan : ∀ j ∈ P.positiveSystem f, P.root j ∈ PointedCone.hull R (P.root '' T))
    (hi : i ∈ P.positiveSystem f)
    (hmem : P.root i ∈ PointedCone.hull R (P.root '' (P.positiveSystem f \ {i}))) :
    P.root i ∈ PointedCone.hull R (P.root '' (T \ {i})) := by
  set D := PointedCone.hull R (P.root '' (T \ {i}))
  have hD : T \ {i} ⊆ P.positiveSystem f := sdiff_subset.trans hT
  have hTD := hull_root_image_le_hull_insert (P := P) T i
  -- Every vector of the cone of the other positive roots splits as `b • αᵢ + u` with `u ∈ D`,
  -- where `u` vanishes only for the zero vector.
  have key : ∀ x ∈ PointedCone.hull R (P.root '' (P.positiveSystem f \ {i})),
      ∃ b : R, 0 ≤ b ∧ ∃ u ∈ D, x = b • P.root i + u ∧ (u = 0 → x = 0) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, ⟨hj, hji⟩, rfl⟩ := hx
      obtain ⟨⟨b, hb⟩, u, hu, hx⟩ := mem_span_insert.mp (hTD (hTspan j hj))
      refine ⟨b, hb, u, hu, by simpa using hx, fun hu₀ => ?_⟩
      exact (root_ne_smul_root_of_mem_positiveSystem hi hj hji b
        (by simpa [hu₀] using hx)).elim
    | zero => exact ⟨0, le_rfl, 0, zero_mem _, by simp, fun _ => rfl⟩
    | add x y _ _ hx hy =>
      obtain ⟨b, hb, u, hu, rfl, hu₀⟩ := hx
      obtain ⟨b', hb', u', hu', rfl, hu₀'⟩ := hy
      refine ⟨b + b', add_nonneg hb hb', u + u', add_mem hu hu', by module, fun h => ?_⟩
      have h₁ := nonneg_and_eq_zero_of_mem_hull hD hu
      have h₂ := nonneg_and_eq_zero_of_mem_hull hD hu'
      have hfu : f u + f u' = 0 := by rw [← map_add, h, map_zero]
      rw [hu₀ (h₁.2 (by linarith [h₁.1, h₂.1])), hu₀' (h₂.2 (by linarith [h₁.1, h₂.1])),
        add_zero]
    | smul c x _ hx =>
      obtain ⟨b, hb, u, hu, rfl, hu₀⟩ := hx
      obtain ⟨c, hc⟩ := c
      refine ⟨c * b, mul_nonneg hc hb, c • u, D.smul_mem hc hu, ?_, fun h => ?_⟩
      · simp only [Nonneg.mk_smul, smul_add, smul_smul]
      · rcases smul_eq_zero.mp h with h | h
        · simp [h]
        · simp [hu₀ h]
  obtain ⟨b, -, u, hu, hiu, hu₀⟩ := key _ hmem
  have hroot : P.root i ≠ 0 := fun h => by simpa [h] using hi.out
  have hu0 : u ≠ 0 := fun h => hroot (hu₀ h)
  have hsub : (1 - b) • P.root i = u := by rw [sub_smul, one_smul, sub_eq_iff_eq_add', ← hiu]
  have hb : 0 < 1 - b := by
    have := apply_pos_of_mem_hull hD hu hu0
    rw [← hsub, map_smul, smul_eq_mul] at this
    exact pos_of_mul_pos_left this hi.out.le
  have : P.root i = (1 - b)⁻¹ • u := by rw [← hsub, smul_smul, inv_mul_cancel₀ hb.ne', one_smul]
  rw [this]
  exact D.smul_mem (inv_nonneg.mpr hb.le) hu

/-- **Uniqueness of the simple system.** A linearly independent set of positive roots whose cone
contains every positive root is the simple system. -/
theorem eq_simpleSystem_of_linearIndepOn {S : Set ι} (hS : S ⊆ P.positiveSystem f)
    (hli : LinearIndepOn R P.root S)
    (hspan : ∀ j ∈ P.positiveSystem f, P.root j ∈ PointedCone.hull R (P.root '' S)) :
    S = P.simpleSystem f := by
  refine Subset.antisymm (fun k hk => ⟨hS hk, fun hmem => ?_⟩) fun k hk => ?_
  · exact root_notMem_span_image_sdiff hli hk
      (PointedCone.hull_le_span R _ (root_mem_hull_sdiff_singleton hS hspan (hS hk) hmem))
  · by_contra hkS
    refine hk.2 (span_mono (image_mono ?_) (hspan k hk.1))
    exact fun l hl => ⟨hS hl, fun h => hkS (h ▸ hl)⟩

/-- Two distinct simple roots have nonpositive pairing. -/
theorem pairing_nonpos_of_mem_simpleSystem (hf : ∀ k, f (P.root k) ≠ 0)
    (hi : i ∈ P.simpleSystem f) (hj : j ∈ P.simpleSystem f) (hij : i ≠ j) :
    P.pairing j i ≤ 0 := by
  by_contra! hpos
  set k := P.reflectionPerm i j
  have hk : P.root k = P.root j - P.pairing j i • P.root i := by
    simp [k, root_reflectionPerm, reflection_apply_root]
  rcases (hf k).lt_or_gt with hneg | hposk
  · -- `-αₖ = c • αᵢ - αⱼ` is a positive root, so `αᵢ = c⁻¹ • (αⱼ + (-αₖ))`.
    set k' := P.reflectionPerm k k
    have hk' : P.root k' = P.pairing j i • P.root i - P.root j := by
      rw [root_reflectionPerm, reflection_apply_self, hk, neg_sub]
    have hk'i : k' ≠ i := by
      intro h
      refine root_ne_smul_root_of_mem_positiveSystem hi.1 hj.1 hij.symm (P.pairing j i - 1) ?_
      rw [h] at hk'
      linear_combination (norm := module) hk'
    refine hi.2 ?_
    have : P.root i = (P.pairing j i)⁻¹ • (P.root j + P.root k') := by
      rw [hk', add_sub_cancel, smul_smul, inv_mul_cancel₀ hpos.ne', one_smul]
    rw [this]
    exact PointedCone.smul_mem _ (inv_nonneg.mpr hpos.le)
      (add_mem (subset_span ⟨j, ⟨hj.1, hij.symm⟩, rfl⟩)
        (subset_span ⟨k', ⟨reflectionPerm_self_mem_positiveSystem_iff.mpr hneg, hk'i⟩, rfl⟩))
  · -- `αₖ` is a positive root, so `αⱼ = αₖ + c • αᵢ`.
    have hkj : k ≠ j := by
      intro h
      rw [h, eq_comm, sub_eq_self, smul_eq_zero] at hk
      exact hk.elim hpos.ne' (P.ne_zero i)
    refine hj.2 ?_
    rw [show P.root j = P.root k + P.pairing j i • P.root i by rw [hk]; abel]
    exact add_mem (subset_span ⟨k, ⟨hposk, hkj⟩, rfl⟩)
      (PointedCone.smul_mem _ hpos.le (subset_span ⟨i, ⟨hi.1, hij⟩, rfl⟩))

variable [Finite ι]

/-- Every positive root is a nonnegative combination of the simple roots. -/
theorem root_mem_hull_simpleSystem (hi : i ∈ P.positiveSystem f) :
    P.root i ∈ PointedCone.hull R (P.root '' P.simpleSystem f) := by
  obtain ⟨T, -, hT⟩ := exists_minimal_le_of_wellFoundedLT
    (fun T : Set ι => T ⊆ P.positiveSystem f ∧
      ∀ j ∈ P.positiveSystem f, P.root j ∈ PointedCone.hull R (P.root '' T))
    (P.positiveSystem f) ⟨subset_rfl, fun j hj => subset_span ⟨j, hj, rfl⟩⟩
  have hTΔ : T ⊆ P.simpleSystem f := by
    intro k hk
    refine ⟨hT.1.1 hk, fun hmem => ?_⟩
    have hk' := root_mem_hull_sdiff_singleton hT.1.1 hT.1.2 (hT.1.1 hk) hmem
    have hle : PointedCone.hull R (P.root '' T) ≤ PointedCone.hull R (P.root '' (T \ {k})) := by
      refine span_le.mpr ?_
      rintro - ⟨l, hl, rfl⟩
      by_cases hlk : l = k
      · exact hlk ▸ hk'
      · exact subset_span ⟨l, ⟨hl, hlk⟩, rfl⟩
    have := hT.le_of_le (y := T \ {k}) ⟨sdiff_subset.trans hT.1.1, fun j hj => hle (hT.1.2 j hj)⟩
      sdiff_subset
    exact (this hk).2 rfl
  exact span_mono (image_mono hTΔ) (hT.1.2 i hi)

/-- Every root, or its negative, is a nonnegative combination of the simple roots. -/
theorem root_mem_hull_simpleSystem_or_neg_mem (hf : ∀ k, f (P.root k) ≠ 0) (k : ι) :
    P.root k ∈ PointedCone.hull R (P.root '' P.simpleSystem f) ∨
      -P.root k ∈ PointedCone.hull R (P.root '' P.simpleSystem f) := by
  rcases (hf k).lt_or_gt with h | h
  · right
    simpa [root_reflectionPerm, reflection_apply_self] using
      root_mem_hull_simpleSystem (reflectionPerm_self_mem_positiveSystem_iff.mpr h)
  · exact .inl (root_mem_hull_simpleSystem h)

/-- The simple roots are linearly independent. -/
theorem linearIndepOn_root_simpleSystem (hf : ∀ k, f (P.root k) ≠ 0) :
    LinearIndepOn R P.root (P.simpleSystem f) := by
  have : Fintype ι := Fintype.ofFinite ι
  let v (i : P.simpleSystem f) : P.rootSpan R := P.rootSpanMem R i
  -- `LinearIndepOn R P.root s` is by definition the linear independence of the family of roots
  -- indexed by `s`, which factors through the span of the roots.
  change LinearIndependent R ((P.rootSpan R).subtype ∘ v)
  rw [LinearMap.linearIndependent_iff_of_disjoint _ (by simp)]
  refine LinearMap.BilinForm.linearIndependent_of_pairwise_le_zero (P.posRootForm R).posForm
    (by simpa using P.posRootForm_rootFormIn_posDef R) (f ∘ₗ (P.rootSpan R).subtype) v
    (fun i => i.property.1) ?_
  rintro ⟨i, hi⟩ ⟨j, hj⟩ hij
  rw [RootPositiveForm.posForm_apply_root_root_le_zero_iff]
  have h := P.algebraMap_pairingIn R i j
  simp only [Algebra.algebraMap_self, RingHom.id_apply] at h
  rw [h]
  exact pairing_nonpos_of_mem_simpleSystem hf hj hi fun h => hij (Subtype.ext h.symm)

/-- The simple roots span the span of all the roots. -/
theorem span_root_simpleSystem (hf : ∀ k, f (P.root k) ≠ 0) :
    span R (P.root '' P.simpleSystem f) = P.rootSpan R := by
  refine le_antisymm (span_mono (image_subset_range _ _)) (span_le.mpr ?_)
  rintro - ⟨k, rfl⟩
  rcases root_mem_hull_simpleSystem_or_neg_mem hf k with h | h
  · exact PointedCone.hull_le_span R _ h
  · simpa using neg_mem (PointedCone.mem_ofSubmodule_iff.mp (PointedCone.hull_le_span R _ h))

/-- The number of simple roots is the dimension of the span of the roots. -/
theorem ncard_simpleSystem (hf : ∀ k, f (P.root k) ≠ 0) :
    (P.simpleSystem f).ncard = finrank R (P.rootSpan R) := by
  rw [← span_root_simpleSystem hf,
    finrank_span_set_eq_ncard (linearIndepOn_root_simpleSystem hf).id_image,
    ncard_image_of_injective _ P.root.injective]

/-- A simple reflection permutes the positive roots other than its own root. -/
theorem reflectionPerm_mem_positiveSystem (hf : ∀ k, f (P.root k) ≠ 0)
    (hi : i ∈ P.simpleSystem f) (hj : j ∈ P.positiveSystem f) (hji : j ≠ i) :
    P.reflectionPerm i j ∈ P.positiveSystem f := by
  set D := PointedCone.hull R (P.root '' (P.simpleSystem f \ {i}))
  have hD : P.simpleSystem f \ {i} ⊆ P.positiveSystem f :=
    sdiff_subset.trans (P.simpleSystem_subset_positiveSystem f)
  have hle := hull_root_image_le_hull_insert (P := P) (P.simpleSystem f) i
  obtain ⟨⟨a, ha⟩, u, hu, hju⟩ := mem_span_insert.mp (hle (root_mem_hull_simpleSystem hj))
  by_contra hk
  have hneg : f (P.root (P.reflectionPerm i j)) < 0 := (not_lt.mp hk).lt_of_ne (hf _)
  obtain ⟨⟨a', ha'⟩, u', hu', hku⟩ := mem_span_insert.mp
    (hle (root_mem_hull_simpleSystem (reflectionPerm_self_mem_positiveSystem_iff.mpr hneg)))
  have hk' : P.root (P.reflectionPerm (P.reflectionPerm i j) (P.reflectionPerm i j)) =
      -(P.root j - P.pairing j i • P.root i) := by
    rw [root_reflectionPerm, reflection_apply_self, root_reflectionPerm, reflection_apply_root]
  rw [Nonneg.mk_smul] at hju hku
  rw [hk'] at hku
  -- Comparing `αⱼ = a • αᵢ + u` with `-sᵢ αⱼ = a' • αᵢ + u'` gives `u + u' ∈ R • αᵢ`.
  have hsum : u + u' = (P.pairing j i - a - a') • P.root i := by
    linear_combination (norm := module) -hju - hku
  have hc : P.pairing j i - a - a' = 0 := by
    by_contra hc
    refine root_notMem_span_image_sdiff (linearIndepOn_root_simpleSystem hf) hi ?_
    have := add_mem (PointedCone.mem_ofSubmodule_iff.mp (PointedCone.hull_le_span R _ hu))
      (PointedCone.mem_ofSubmodule_iff.mp (PointedCone.hull_le_span R _ hu'))
    rwa [hsum, Submodule.smul_mem_iff _ hc] at this
  rw [hc, zero_smul] at hsum
  have h₁ := nonneg_and_eq_zero_of_mem_hull hD hu
  have h₂ := nonneg_and_eq_zero_of_mem_hull hD hu'
  have hfu : f u + f u' = 0 := by rw [← map_add, hsum, map_zero]
  have hu0 : u = 0 := h₁.2 (by linarith [h₁.1, h₂.1])
  exact root_ne_smul_root_of_mem_positiveSystem hi.1 hj hji a (by rw [hju, hu0, add_zero])

/-- Every positive root has positive pairing with some simple root. -/
private lemma exists_mem_simpleSystem_pairing_pos (hj : j ∈ P.positiveSystem f) :
    ∃ i ∈ P.simpleSystem f, 0 < P.pairing j i := by
  have : Fintype ι := Fintype.ofFinite ι
  by_contra! h
  have hcone : ∀ x ∈ PointedCone.hull R (P.root '' P.simpleSystem f),
      P.RootForm (P.root j) x ≤ 0 := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, hi, rfl⟩ := hx
      exact rootForm_root_root_le_zero_iff.mpr (h i hi)
    | zero => simp
    | add x y _ _ hx hy => simpa using add_nonpos hx hy
    | smul c x _ hx =>
      obtain ⟨c, hc⟩ := c
      simpa using mul_nonpos_of_nonneg_of_nonpos hc hx
  have h₁ := hcone _ (root_mem_hull_simpleSystem hj)
  have h₂ := P.rootForm_pos_of_ne_zero (subset_span (mem_range_self j)) (P.ne_zero j)
  exact h₂.not_ge h₁

/-- Every root is carried to a simple root by a product of simple reflections. -/
theorem exists_weylGroupToPerm_mem_simpleSystem (hf : ∀ k, f (P.root k) ≠ 0) (j : ι) :
    ∃ w ∈ Subgroup.closure (weylGroup.ofIdx P '' P.simpleSystem f),
      P.weylGroupToPerm w j ∈ P.simpleSystem f := by
  set W₀ := Subgroup.closure (weylGroup.ofIdx P '' P.simpleSystem f)
  suffices H : ∀ j ∈ P.positiveSystem f,
      ∃ w ∈ W₀, P.weylGroupToPerm w j ∈ P.simpleSystem f by
    rcases (hf j).lt_or_gt with h | h
    · -- If `w (-αⱼ) = αᵢ` then `sᵢ w αⱼ = αᵢ`.
      obtain ⟨w, hw, hwj⟩ := H _ (reflectionPerm_self_mem_positiveSystem_iff.mpr h)
      refine ⟨weylGroup.ofIdx P (P.weylGroupToPerm w (P.reflectionPerm j j)) * w,
        mul_mem (Subgroup.subset_closure ⟨_, hwj, rfl⟩) hw, ?_⟩
      rw [weylGroupToPerm_reflectionPerm_self] at hwj ⊢
      rwa [weylGroup.ofIdx_reflectionPerm_self, weylGroupToPerm_ofIdx_mul_apply]
    · exact H j h
  -- Induct on the value of `f`, through a counterexample on which it is least.
  intro j hj
  by_contra hjbad
  obtain ⟨j, ⟨hj, hjbad⟩, hmin⟩ := Set.exists_min_image
    {j | j ∈ P.positiveSystem f ∧ ¬∃ w ∈ W₀, P.weylGroupToPerm w j ∈ P.simpleSystem f}
    (fun j => f (P.root j)) (toFinite _) ⟨j, hj, hjbad⟩
  obtain ⟨i, hi, hji⟩ := exists_mem_simpleSystem_pairing_pos hj
  by_cases hij : j = i
  · exact hjbad ⟨1, one_mem _, by simpa [hij] using hi⟩
  have hk := reflectionPerm_mem_positiveSystem hf hi hj hij
  have hlt : f (P.root (P.reflectionPerm i j)) < f (P.root j) := by
    rw [root_reflectionPerm, reflection_apply_root, map_sub, map_smul, smul_eq_mul,
      sub_lt_self_iff]
    exact mul_pos hji hi.1
  by_cases hkbad : ∃ w ∈ W₀, P.weylGroupToPerm w (P.reflectionPerm i j) ∈ P.simpleSystem f
  · obtain ⟨w, hw, hwk⟩ := hkbad
    refine hjbad ⟨w * weylGroup.ofIdx P i,
      mul_mem hw (Subgroup.subset_closure ⟨i, hi, rfl⟩), ?_⟩
    rwa [weylGroupToPerm_mul_ofIdx_apply]
  · exact hlt.not_ge (hmin _ ⟨hk, hkbad⟩)

/-- The simple reflections generate the Weyl group. -/
theorem weylGroup_eq_closure_simpleSystem (hf : ∀ k, f (P.root k) ≠ 0) :
    (⊤ : Subgroup P.weylGroup) =
      Subgroup.closure (weylGroup.ofIdx P '' P.simpleSystem f) := by
  refine le_antisymm ?_ le_top
  rintro ⟨w, hw⟩ -
  induction hw using weylGroup.induction with
  | mem j =>
    obtain ⟨w, hw, hwj⟩ := exists_weylGroupToPerm_mem_simpleSystem hf j
    have h := weylGroup.ofIdx_weylGroupToPerm_eq_conj (P := P) w j
    have : weylGroup.ofIdx P j = w⁻¹ * weylGroup.ofIdx P (P.weylGroupToPerm w j) * w := by
      rw [h]
      group
    rw [weylGroup.mk_reflection_eq_ofIdx, this]
    exact mul_mem (mul_mem (inv_mem hw) (Subgroup.subset_closure ⟨_, hwj, rfl⟩)) hw
  | one => exact one_mem _
  | mul g h _ _ hg hh => exact mul_mem hg hh

end RootPairing
