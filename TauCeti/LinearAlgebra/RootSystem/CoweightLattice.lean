module

public import Mathlib.GroupTheory.FiniteAbelian.Basic
public import Mathlib.LinearAlgebra.RootSystem.IsValuedIn

/-!
# The coweight lattice and the coroot lattice of a root datum

Let `P` be a root pairing with weight space `M` and coweight space `N` over a commutative ring
`R`, and let `Q = P.rootSpan R` be the span of its roots. Restricting the pairing to `Q` gives a
linear map

`P.toDualRootSpan : N →ₗ[R] Dual R Q`,

sending a coweight to the functional it induces on the roots. For a root datum (`R = ℤ`), the
target `P∨ = Hom_ℤ(Q, ℤ)` is the *coweight lattice*: the coweights in the classical sense, the
functionals taking integer values on the root lattice. The image of the coroot span
`Q∨ = P.corootSpan ℤ` under this map is the *coroot lattice* inside it, generated by the restricted
coroots `P.coroot'In ℤ i` (`RootPairing.corootSpan_map_toDualRootSpan`).

When the root datum is semisimple, meaning that the roots span a finite-index sublattice of `M`
and the coroots one of `N` (equivalently, that they span the rational vector spaces `ℚ ⊗ M` and
`ℚ ⊗ N`), these lattices have the expected shape:

* the restriction map is injective, so `N` and in particular `Q∨` embed in `P∨`
  (`RootPairing.toDualRootSpan_injective`);
* `Q∨` has finite index in `P∨` (`RootPairing.finite_quotient_corootSpan_map`).

The finite group `P∨ / Q∨` is the quotient of the extended affine Weyl group `P∨ ⋊ W` by the
affine Weyl group `Q∨ ⋊ W`; for an irreducible reduced root system it is isomorphic to the
stabilizer of the fundamental alcove in `P∨ ⋊ W`.

Both statements are proved over an arbitrary commutative ring, with "finite index" replaced by the
quotient being a torsion module (`Module.IsTorsion`); over `ℤ` with `M` finitely generated a
torsion quotient is the same as a finite one. Only the perfectness of the pairing is used: no
finiteness of the root system, reducedness or crystallographic condition is needed.

## Main definitions

* `RootPairing.toDualRootSpan`: the restriction of the pairing to the root span, as a linear map
  from the coweight space to the dual of the root span.

## Main results

* `RootPairing.toDualRootSpan_injective`: if `M / Q` is torsion, the restriction map is injective.
* `RootPairing.isTorsion_quotient_corootSpan_map`: if moreover `M` is finitely generated and
  `N / Q∨` is torsion, then the dual of the root span modulo the image of the coroot span is
  torsion.
* `RootPairing.finite_quotient_corootSpan_map`: for a root datum with finitely generated character
  lattice whose roots and coroots span finite-index sublattices, the coroot lattice has finite
  index in the coweight lattice.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Chapter VI, §1.9 and §2.2–2.3.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, §4.2–4.9.
-/

public section

open Module Submodule
open scoped nonZeroDivisors

namespace RootPairing

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N]
  [Module R N] (P : RootPairing ι R M N)

/-- **The restriction of the pairing to the root span.** A coweight `y` is sent to the functional
`x ↦ ⟨x, y⟩` on the span `Q` of the roots. For a root datum the target `Hom_ℤ(Q, ℤ)` is the coweight
lattice, and the image of the coroot span is the coroot lattice inside it. -/
def toDualRootSpan : N →ₗ[R] Dual R (P.rootSpan R) :=
  (P.rootSpan R).subtype.dualMap ∘ₗ P.toLinearMap.flip

@[simp]
theorem toDualRootSpan_apply (y : N) (x : P.rootSpan R) :
    P.toDualRootSpan y x = P.toLinearMap x y :=
  (rfl)

/-- A coroot restricts to the functional `P.coroot'In R i` on the root span. -/
theorem toDualRootSpan_coroot (i : ι) : P.toDualRootSpan (P.coroot i) = P.coroot'In R i := by
  ext x
  simpa using (P.algebraMap_coroot'In_apply R i x).symm

/-- **The coroot lattice in the dual of the root span** is spanned by the restricted coroots. -/
theorem corootSpan_map_toDualRootSpan :
    (P.corootSpan R).map P.toDualRootSpan = span R (Set.range (P.coroot'In R)) := by
  rw [map_span, ← Set.range_comp]
  congr 1
  ext f
  simp [toDualRootSpan_coroot]

/-- **The coweights embed in the dual of the root span** as soon as the roots span `M` up to
torsion. -/
theorem toDualRootSpan_injective (hM : IsTorsion R (M ⧸ P.rootSpan R)) :
    Function.Injective P.toDualRootSpan := by
  refine (injective_iff_map_eq_zero _).2 fun y hy ↦
    (injective_iff_map_eq_zero _).1 (LinearMap.IsPerfPair.bijective_right P.toLinearMap).1 y ?_
  -- A coweight vanishing on the roots vanishes on a multiple of each `x`, hence on `x`.
  ext x
  obtain ⟨a, ha⟩ := @hM (Submodule.Quotient.mk x)
  have hax : a • x ∈ P.rootSpan R :=
    (Submodule.Quotient.mk_eq_zero _).1 (by rwa [Submodule.Quotient.mk_smul])
  have := congr($hy ⟨_, hax⟩)
  simp only [toDualRootSpan_apply, Submonoid.smul_def, map_smul, LinearMap.smul_apply,
    smul_eq_mul, LinearMap.zero_apply] at this
  simpa using (mul_left_mem_nonZeroDivisors_eq_zero_iff a.prop).1 this

/-- **The coroot lattice has torsion cokernel in the dual of the root span**, when `M` is finitely
generated and the roots and the coroots span `M` and `N` up to torsion. -/
theorem isTorsion_quotient_corootSpan_map [Module.Finite R M]
    (hM : IsTorsion R (M ⧸ P.rootSpan R)) (hN : IsTorsion R (N ⧸ P.corootSpan R)) :
    IsTorsion R (Dual R (P.rootSpan R) ⧸ (P.corootSpan R).map P.toDualRootSpan) := by
  -- Given a functional `f` on the root span, pick a nonzerodivisor `a` multiplying all of `M` into
  -- the root span. The functional `x ↦ f (a • x)` on `M` is the pairing with some coweight `y`, and
  -- a nonzerodivisor `b` multiplies `y` into the coroot span; so `(b * a) • f` is the restriction
  -- of the element `b • y` of the coroot span.
  obtain ⟨a, ha, ha0⟩ := Submodule.annihilator_top_inter_nonZeroDivisors hM
  have hax (x : M) : a • x ∈ P.rootSpan R := by
    rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_smul]
    exact (Submodule.mem_annihilator.1 ha) _ mem_top
  intro q
  induction q using Submodule.Quotient.induction_on with | H f => ?_
  obtain ⟨y, hy⟩ := (LinearMap.IsPerfPair.bijective_right P.toLinearMap).2
    (f ∘ₗ LinearMap.codRestrict (P.rootSpan R) (a • LinearMap.id) hax)
  obtain ⟨b, hb⟩ := @hN (Submodule.Quotient.mk y)
  have hby : b • y ∈ P.corootSpan R :=
    (Submodule.Quotient.mk_eq_zero _).1 (by rwa [Submodule.Quotient.mk_smul])
  refine ⟨⟨b * a, mul_mem b.prop ha0⟩, ?_⟩
  rw [Submonoid.smul_def, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
  refine ⟨b • y, hby, ?_⟩
  ext ⟨x, hx⟩
  have hfx : P.toLinearMap x y = a * f ⟨x, hx⟩ := by
    rw [← smul_eq_mul, ← map_smul]
    exact congr($hy x)
  simp [Submonoid.smul_def, hfx, mul_assoc]

/-- **The coroot lattice has finite index in the coweight lattice.** For a root datum whose
character lattice `M` is finitely generated, and whose roots and coroots span `M` and `N` up to
torsion (equivalently, up to finite index), the restricted coroots span a finite-index subgroup
of `Hom_ℤ(Q, ℤ)`, for `Q` the root lattice. -/
theorem finite_quotient_corootSpan_map {M N : Type*} [AddCommGroup M] [AddCommGroup N]
    (P : RootPairing ι ℤ M N) [Module.Finite ℤ M]
    (hM : IsTorsion ℤ (M ⧸ P.rootSpan ℤ)) (hN : IsTorsion ℤ (N ⧸ P.corootSpan ℤ)) :
    Finite (Dual ℤ (P.rootSpan ℤ) ⧸ (P.corootSpan ℤ).map P.toDualRootSpan) :=
  Module.finite_of_fg_torsion _ (P.isTorsion_quotient_corootSpan_map hM hN)

end RootPairing
