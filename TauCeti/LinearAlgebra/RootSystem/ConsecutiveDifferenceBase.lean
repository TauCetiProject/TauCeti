module

public import Mathlib.LinearAlgebra.RootSystem.Defs
public import Mathlib.LinearAlgebra.Dimension.Finrank
import Mathlib.LinearAlgebra.Dimension.OrzechProperty
import Mathlib.RingTheory.FiniteType
import TauCeti.Algebra.Group.Submonoid.Telescoping

/-!
# Bases of consecutive differences

Root systems of type `A` have roots `v a - v b` for a family `v : Fin (n + 1) → M`, and their
standard base consists of the consecutive differences `v k - v (k + 1)`. This file proves the two
hypotheses of `RootPairing.Base.mk'` for such a family of simple roots.

## Main results

* `RootPairing.root_mem_or_neg_mem_closure_of_forall_exists_eq_sub`: if every root is a difference
  `v a - v b` and the roots indexed by `s` are the consecutive differences, then every root or its
  negative is a sum of roots indexed by `s`.
* `RootPairing.linearIndepOn_root_range_of_root_mem_or_neg_mem_closure`: in a root system, `n`
  roots generating every root up to sign in a module of rank `n` are linearly independent.
-/

public section

open Module Set

namespace RootPairing

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N]
  [Module R N] {P : RootPairing ι R M N} {n : ℕ} {s : Fin n → ι}

/-- If every root is a difference `v a - v b` and the root indexed by `s k` is the consecutive
difference `v k - v (k + 1)`, then every root or its negative lies in the additive submonoid
generated by the roots indexed by `s`. -/
theorem root_mem_or_neg_mem_closure_of_forall_exists_eq_sub (v : Fin (n + 1) → M)
    (hs : ∀ k, P.root (s k) = v k.castSucc - v k.succ) (hv : ∀ i, ∃ a b, P.root i = v a - v b)
    (i : ι) :
    P.root i ∈ AddSubmonoid.closure (P.root '' range s) ∨
      -P.root i ∈ AddSubmonoid.closure (P.root '' range s) := by
  obtain ⟨a, b, hab⟩ := hv i
  have hcons (c d : Fin (n + 1)) (hcd : (c : ℕ) + 1 = d) :
      v c - v d ∈ AddSubmonoid.closure (P.root '' range s) := by
    have hc : (c : ℕ) < n := by omega
    obtain rfl : d = (⟨c, hc⟩ : Fin n).succ := Fin.ext (by simp; omega)
    have h := hs ⟨c, hc⟩
    rw [Fin.castSucc_mk, Fin.eta] at h
    rw [← h]
    exact AddSubmonoid.subset_closure ⟨s _, mem_range_self _, rfl⟩
  rw [hab, neg_sub]
  rcases le_total a b with h | h
  · exact .inl (TauCeti.sub_mem_of_consecutive_sub_mem_fin v hcons h)
  · exact .inr (TauCeti.sub_mem_of_consecutive_sub_mem_fin v hcons h)

/-- In a root system, `n` distinct roots that generate every root up to sign, in a weight module of
rank `n`, are linearly independent. -/
theorem linearIndepOn_root_range_of_root_mem_or_neg_mem_closure [P.IsRootSystem]
    (hinj : Function.Injective s)
    (hsp : ∀ i, P.root i ∈ AddSubmonoid.closure (P.root '' range s) ∨
      -P.root i ∈ AddSubmonoid.closure (P.root '' range s))
    (hn : finrank R M = n) :
    LinearIndepOn R P.root (range s) := by
  rw [linearIndepOn_range_iff hinj]
  refine linearIndependent_of_top_le_span_of_card_eq_finrank ?_ (by rw [Fintype.card_fin, hn])
  rw [← IsRootSystem.span_root_eq_top (P := P), Submodule.span_le]
  rintro _ ⟨i, rfl⟩
  have hsub : AddSubmonoid.closure (P.root '' range s) ≤
      (Submodule.span R (range (P.root ∘ s))).toAddSubmonoid := by
    rw [AddSubmonoid.closure_le, range_comp]
    exact Submodule.subset_span
  rcases hsp i with h | h
  · exact hsub h
  · exact (Submodule.neg_mem_iff _).mp (hsub h)

end RootPairing
