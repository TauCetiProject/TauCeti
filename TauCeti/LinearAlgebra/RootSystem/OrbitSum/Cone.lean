module

public import TauCeti.LinearAlgebra.RootSystem.Dominance
public import TauCeti.LinearAlgebra.RootSystem.OrbitSum.Basic

/-!
# Fixed vectors of the positive root monoid and of the root lattice

Let `b` be a base of a root pairing `P` with finitely many roots, and `σ` an automorphism of `P`
permuting the simple roots of `b`. For a simple orbit `O` write `β_O = ∑_{i ∈ O} αᵢ`, the orbit sum
`RootPairing.orbitSum P σ i` of any `i ∈ O`. When `P` is a finite root system and the simple
roots in each orbit are pairwise orthogonal, these are the simple roots of the folding of `P` by
`σ`; no such hypothesis is used here. This file shows that a `σ`-fixed vector is a natural
(respectively integral) combination of the simple roots exactly when it is a natural
(respectively integral) combination of the vectors `β_O`. So the fixed part of the positive root
monoid `Q⁺` is the monoid generated by the simple-orbit sums, and the fixed part of the root
lattice `Q` is the group they generate.

The proof expands a fixed vector in simple roots. Applying `σ` permutes the coefficients, so by
linear independence of the simple roots the coefficients are constant on each simple orbit
(`RootPairing.apply_indexEquiv_eq_of_weightMap_sum_smul_root_eq`), and the sum regroups orbit by
orbit, with the common coefficient of the orbit. There is no division by the size of an orbit, so
the statements hold over any coefficient semiring `A` acting compatibly on `M`, and need no
assumption on the characteristic of `R`.

Membership in `Q⁺` is a statement about vectors and not about integrality of their simple-root
coordinates: the fixed vector `(α₁ + α₂) / 2` of `A₂` under its diagram reversal lies neither in
`Q⁺` nor in the monoid generated by `α₁ + α₂`. Since integral root dominance only tests a
difference, it agrees on fixed endpoints with dominance for the simple-orbit sums
(`RootPairing.rootLE_iff_sub_mem_closure_orbitSum`).

## Main results

* `RootPairing.apply_indexEquiv_eq_of_weightMap_sum_smul_root_eq`: a fixed combination of the
  simple roots has coefficients constant along `σ`.
* `RootPairing.span_orbitSum_support`: over any coefficient semiring `A`, the `A`-span of the
  simple-orbit sums is the set of fixed vectors in the `A`-span of the simple roots.
* `RootPairing.mem_posRootCone_iff_mem_closure_orbitSum`: a fixed vector lies in `Q⁺` exactly when
  it is a natural combination of simple-orbit sums.
* `RootPairing.mem_rootSpan_int_iff_mem_span_orbitSum`: a fixed vector lies in the root lattice
  exactly when it is an integral combination of simple-orbit sums.
* `RootPairing.rootLE_iff_sub_mem_closure_orbitSum`: integral root dominance between fixed
  vectors is dominance for the simple-orbit sums.

## References

* J. R. Stembridge, *Folding by automorphisms*, note of 20 August 2008, page 1.
* M. Rapoport, *A positivity property of the Satake isomorphism*, Manuscripta Math. 101 (2000),
  153–166, §1, for integral root dominance.
-/

public section

namespace RootPairing

open Finset Submodule TauCeti

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} {σ : P.Aut} {b : P.Base}

/-- **A fixed combination of the simple roots has coefficients constant along `σ`.** If an
automorphism `σ` permutes the simple roots of `b` and fixes `∑ⱼ fⱼ αⱼ`, then `f (σ j) = f j` for
every simple index `j`. -/
theorem apply_indexEquiv_eq_of_weightMap_sum_smul_root_eq
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) {f : ι → R}
    (hf : σ.weightMap (∑ j ∈ b.support, f j • P.root j) = ∑ j ∈ b.support, f j • P.root j)
    {j : ι} (hj : j ∈ b.support) : f (σ.indexEquiv j) = f j := by
  classical
  have himage : b.support.image σ.indexEquiv = b.support := by
    convert congrArg Base.support (Base.map_eq_of_forall_mem_support hσ) using 1
    exact (b.support_map_eq σ).symm
  -- Applying `σ` moves the coefficient of `αⱼ` to `α_{σ j}`.
  have hmove : ∑ k ∈ b.support, f (σ.indexEquiv.symm k) • P.root k =
      ∑ k ∈ b.support, f k • P.root k := by
    rw [← hf, map_sum]
    calc ∑ k ∈ b.support, f (σ.indexEquiv.symm k) • P.root k
        = ∑ k ∈ b.support.image σ.indexEquiv, f (σ.indexEquiv.symm k) • P.root k := by
          rw [himage]
      _ = _ := by
          rw [sum_image σ.indexEquiv.injective.injOn]
          refine sum_congr rfl fun k _ ↦ ?_
          rw [Equiv.symm_apply_apply, map_smul, Hom.root_weightMap_apply]
  simpa using (linearIndepOn_finset_iffₛ.mp b.linearIndepOn_root _ _ hmove
    (σ.indexEquiv j) (hσ j hj)).symm

variable [Finite ι]

/-- A function on root indices that is invariant under `σ` on the simple roots is constant on
each simple orbit. -/
private theorem apply_eq_of_mem_orbitIndices {X : Type*} {f : ι → X}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (hf : ∀ j ∈ b.support, f (σ.indexEquiv j) = f j) {i k : ι} (hi : i ∈ b.support)
    (hk : k ∈ P.orbitIndices σ i) : f k = f i := by
  obtain ⟨m, rfl⟩ := mem_orbitIndices_iff_exists_pow.mp hk
  induction m with
  | zero => rfl
  | succ m ih =>
    have hm : (σ.indexEquiv ^ m) i ∈ P.orbitIndices σ i :=
      mem_orbitIndices_iff_exists_pow.mpr ⟨m, rfl⟩
    rw [pow_succ', Equiv.Perm.mul_apply,
      hf _ ((mem_support_iff_of_mem_orbitIndices hσ hm).mpr hi), ih hm]

/-- The simple indices whose orbit is the orbit of a simple index `i` form exactly that orbit. -/
private theorem filter_orbitIndices_eq [DecidableEq ι]
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) {i : ι} (hi : i ∈ b.support) :
    {j ∈ b.support | P.orbitIndices σ j = P.orbitIndices σ i} = P.orbitIndices σ i := by
  ext j
  refine ⟨fun hj ↦ ?_, fun hj ↦ mem_filter.mpr
    ⟨(mem_support_iff_of_mem_orbitIndices hσ hj).mpr hi, orbitIndices_eq_of_mem hj⟩⟩
  rw [← (mem_filter.mp hj).2]
  exact self_mem_orbitIndices P σ j

variable {A : Type*} [CommSemiring A] [Algebra A R] [Module A M] [IsScalarTower A R M]

/-- A combination of the simple roots whose coefficients are constant along `σ` is a combination
of the simple-orbit sums, with the same coefficients. -/
private theorem sum_smul_root_mem_span_orbitSum
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) {c : ι → A}
    (hc : ∀ j ∈ b.support, algebraMap A R (c (σ.indexEquiv j)) = algebraMap A R (c j)) :
    ∑ j ∈ b.support, c j • P.root j ∈ span A (P.orbitSum σ '' b.support) := by
  classical
  -- Group the sum by orbits: the fibre of the orbit map through a simple index is its orbit.
  rw [← sum_image' (g := P.orbitIndices σ) (f := fun O ↦ ∑ j ∈ O, c j • P.root j)
    (fun j ↦ c j • P.root j) fun i hi ↦ by rw [filter_orbitIndices_eq hσ hi]]
  refine sum_mem fun O hO ↦ ?_
  obtain ⟨i, hi, rfl⟩ := mem_image.mp hO
  -- On the orbit of `i` the coefficient is that of `i`, through `R`.
  have hterm (k : ι) (hk : k ∈ P.orbitIndices σ i) : c k • P.root k = c i • P.root k := by
    rw [← algebraMap_smul R (c k), ← algebraMap_smul R (c i),
      apply_eq_of_mem_orbitIndices (f := fun j ↦ algebraMap A R (c j)) hσ hc hi hk]
  rw [sum_congr rfl hterm, ← smul_sum, ← orbitSum_def]
  exact smul_mem _ _ (subset_span ⟨i, hi, rfl⟩)

/-- **The simple-orbit sums span the fixed vectors of the simple-root span.** For an automorphism
`σ` permuting the simple roots of `b` and any coefficient semiring `A`, the `A`-combinations of the
simple-orbit sums `β_O` are exactly the `σ`-fixed `A`-combinations of the simple roots. -/
theorem span_orbitSum_support (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) :
    span A (P.orbitSum σ '' b.support) =
      span A (P.root '' b.support) ⊓
        (LinearMap.fixedSubmodule σ.weightMap).restrictScalars A := by
  refine le_antisymm (span_le.mpr ?_) fun x ⟨hx, hfix⟩ ↦ ?_
  · rintro - ⟨i, hi, rfl⟩
    refine Submodule.mem_inf.mpr ⟨?_, (restrictScalars_mem ..).mpr
      (orbitSum_mem_fixedSubmodule P σ i)⟩
    rw [orbitSum_def]
    exact sum_mem fun k hk ↦
      subset_span ⟨k, (mem_support_iff_of_mem_orbitIndices hσ hk).mpr hi, rfl⟩
  obtain ⟨c, rfl⟩ := (mem_span_image_finset_iff_exists_fun' A).mp hx
  refine sum_smul_root_mem_span_orbitSum hσ fun j hj ↦
    apply_indexEquiv_eq_of_weightMap_sum_smul_root_eq (f := fun j ↦ algebraMap A R (c j)) hσ ?_ hj
  simpa only [algebraMap_smul] using LinearMap.mem_fixedSubmodule_iff.mp hfix

/-- A `σ`-fixed vector is an `A`-combination of the simple roots exactly when it is an
`A`-combination of the simple-orbit sums. -/
theorem mem_span_orbitSum_iff (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) {x : M}
    (hx : σ.weightMap x = x) :
    x ∈ span A (P.orbitSum σ '' b.support) ↔ x ∈ span A (P.root '' b.support) := by
  rw [span_orbitSum_support hσ, Submodule.mem_inf, restrictScalars_mem,
    LinearMap.mem_fixedSubmodule_iff]
  exact and_iff_left hx

/-- **The fixed part of the positive root monoid.** A `σ`-fixed vector lies in the positive root
monoid `Q⁺` of `b` exactly when it is a natural combination of the simple-orbit sums. -/
theorem mem_posRootCone_iff_mem_closure_orbitSum
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) {x : M} (hx : σ.weightMap x = x) :
    x ∈ posRootCone P b ↔ x ∈ AddSubmonoid.closure (P.orbitSum σ '' b.support) := by
  rw [← span_nat_eq_addSubmonoidClosure, mem_toAddSubmonoid, mem_span_orbitSum_iff hσ hx,
    mem_posRootCone, mem_span_image_finset_iff_exists_fun' ℕ]
  simp only [eq_comm]

/-- **The fixed part of the root lattice.** A `σ`-fixed vector lies in the `ℤ`-span of the roots
exactly when it is an integral combination of the simple-orbit sums. -/
theorem mem_rootSpan_int_iff_mem_span_orbitSum
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) {x : M} (hx : σ.weightMap x = x) :
    x ∈ P.rootSpan ℤ ↔ x ∈ span ℤ (P.orbitSum σ '' b.support) := by
  rw [mem_span_orbitSum_iff hσ hx, b.span_int_root_support]

/-- **Integral root dominance between fixed vectors.** For `σ`-fixed `x` and `y`, the difference
`y - x` is a natural combination of the simple roots exactly when it is a natural combination of
the simple-orbit sums. -/
theorem rootLE_iff_sub_mem_closure_orbitSum
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) {x y : M} (hx : σ.weightMap x = x)
    (hy : σ.weightMap y = y) :
    P.rootLE b x y ↔ y - x ∈ AddSubmonoid.closure (P.orbitSum σ '' b.support) := by
  rw [rootLE_iff_sub_mem_posRootCone]
  exact mem_posRootCone_iff_mem_closure_orbitSum hσ (by rw [map_sub, hx, hy])

end RootPairing
