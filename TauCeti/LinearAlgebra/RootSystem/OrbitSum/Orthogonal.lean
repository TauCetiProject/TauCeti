/-!
# The orthogonal orbit-sum fold of a based root system

Let `P` be a finite reduced crystallographic root system, `b` a base of `P`, and `σ` an
automorphism of `P` permuting the simple roots of `b`. Assume that distinct roots in the same
`σ`-orbit of `b.support` are orthogonal:

`∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0`.

Following Stembridge's *Folding by automorphisms*, this file constructs the orbit-sum realization
of `(P, b, σ)` on the fixed submodule `E^σ = LinearMap.fixedSubmodule σ.weightMap` and computes its
reflections, coroots, squared root lengths, and Cartan matrix:

* **Block reflections and squared lengths of orthogonal orbit sums.** Specializing
  `RootPairing.orthogonalReflectionProd` to an orthogonal `σ`-orbit gives the involutive block
  reflection `RootPairing.blockReflection P σ i₀ horth₀`, which commutes with `σ` and acts on
  `E^σ` as reflection in `P.orbitSum σ i₀` against `P.coroot' i₀`. For any `σ`-invariant bilinear
  form `B` on `P`, an orthogonal root orbit satisfies
  `B.form (P.orbitSum σ r) (P.orbitSum σ r) = #(P.orbitIndices σ r) • B.form (P.root r) (P.root r)`
  (`RootPairing.InvariantForm.apply_orbitSum_self`).
* **Coroots, reflections, and folded Cartan matrix.** On *any* `F : P.OrbitSumRealization b σ`
  over a characteristic-zero domain, for any orthogonal `σ`-orbit, folded coroots restrict ambient
  coroots (`RootPairing.OrbitSumRealization.coroot_apply_of_pairing_eq_zero`), folded reflections
  restrict ambient block reflections
  (`RootPairing.OrbitSumRealization.reflection_apply_of_pairing_eq_zero`), and under simple-orbit
  orthogonality the folded Cartan entries sum original Cartan integers across the first orbit
  (`RootPairing.OrbitSumRealization.cartanMatrix_apply`). When `b.cartanMatrix` is simply laced,
  each off-diagonal folded Cartan entry counts the negated number of diagram edges from the first
  orbit to one representative of the second
  (`RootPairing.OrbitSumRealization.cartanMatrix_apply_eq_neg_card_of_isSimplyLaced`,
  `RootPairing.OrbitSumRealization.card_mul_cartanMatrix_apply_eq_neg_card_of_isSimplyLaced`).
* **Height descent, unrestricted root-orbit orthogonality, and construction of the fold.** Over a
  linearly ordered field, positivity of `P.RootForm` on nonzero orbit sums supplies a simple block
  reflection that strictly lowers root height unless the root is already simple. Consequently every
  root lies in the orbit of `b.support` under the subgroup generated by simple block reflections,
  so *every* root orbit of `σ` — not merely the simple ones — is pairwise orthogonal
  (`RootPairing.orbit_pairing_eq_zero`, `RootPairing.pairwise_isOrthogonal_orbitIndices_of_base`),
  and `RootPairing.OrbitSumRealization.orthogonal` constructs `P.OrbitSumRealization b σ`.

## References

* J. R. Stembridge, *Folding by automorphisms*, note of 20 August 2008, pages 1–3.
-/

public section

namespace RootPairing

open Finset Function Set Submodule TauCeti

/-! ### Orthogonal orbits, block reflections, and invariant forms -/

section BlockReflection

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : RootPairing ι R M N) [Finite ι]

omit [Finite ι] in
private theorem indexEquiv_comm_of_commute {g σ : P.Aut} (h : Commute g σ) (j : ι) :
    g.indexEquiv (σ.indexEquiv j) = σ.indexEquiv (g.indexEquiv j) :=
  congrArg (fun f : P.Aut ↦ f.indexEquiv j) h.eq

/-- On a `σ`-fixed vector, all coroots in a single `σ`-orbit take the same value. -/
theorem coroot'_eq_of_mem_orbitIndices_of_weightMap_eq {σ : P.Aut} {i j : ι}
    (hj : j ∈ P.orbitIndices σ i) {x : M} (hx : σ.weightMap x = x) :
    P.coroot' j x = P.coroot' i x := by
  rcases mem_orbitIndices_iff_exists_pow.mp hj with ⟨m, rfl⟩
  clear hj
  have hpow_x : (σ ^ m).weightEquiv x = x := by
    change (σ ^ m) • x = x
    induction m with
    | zero => simp
    | succ m ih => rw [pow_succ', mul_smul, ih]; exact hx
  have hpow_idx : (σ ^ m).indexEquiv i = (σ.indexEquiv ^ m) i := by
    change Equiv.indexHom P (σ ^ m) i = ((Equiv.indexHom P σ) ^ m) i
    rw [map_pow]
  have hcor := (σ ^ m).coroot'_weightEquiv i x
  rwa [hpow_idx, hpow_x] at hcor

/-- If an automorphism `w` commutes with `σ`, it permutes `σ`-orbit sums via its index
equivalence. -/
theorem weylGroup_smul_orbitSum {σ : P.Aut} {w : P.weylGroup} (hcomm : Commute (w : P.Aut) σ)
    (r : ι) :
    w • P.orbitSum σ r = P.orbitSum σ (P.weylGroupToPerm w r) :=
  P.weightMap_orbitSum (w : P.Aut) (P.indexEquiv_comm_of_commute hcomm) r

/-- If `w` commutes with `σ`, it preserves the cardinalities of `σ`-orbits. -/
theorem card_orbitIndices_weylGroupToPerm {σ : P.Aut} {w : P.weylGroup}
    (hcomm : Commute (w : P.Aut) σ) (r : ι) :
    #(P.orbitIndices σ (P.weylGroupToPerm w r)) = #(P.orbitIndices σ r) := by
  rw [weylGroupToPerm_apply,
    ← P.map_orbitIndices (w : P.Aut) (P.indexEquiv_comm_of_commute hcomm) r, Finset.card_map]

variable {P} in
/-- A `σ`-invariant bilinear form assigns equal squared lengths to all roots in a `σ`-orbit. -/
theorem InvariantForm.apply_root_self_of_mem_orbitIndices (B : P.InvariantForm) {σ : P.Aut}
    (hBσ : ∀ x y, B.form (σ.weightMap x) (σ.weightMap y) = B.form x y) {r i : ι}
    (hi : i ∈ P.orbitIndices σ r) :
    B.form (P.root i) (P.root i) = B.form (P.root r) (P.root r) := by
  rcases mem_orbitIndices_iff_exists_pow.mp hi with ⟨m, rfl⟩
  clear hi
  induction m with
  | zero => rw [pow_zero, Equiv.Perm.one_apply]
  | succ m ih => rw [pow_succ', Equiv.Perm.mul_apply, ← Hom.root_weightMap_apply, hBσ, ih]

section CharZeroDomain

variable [CharZero R] [IsDomain R]

/-- Orthogonality of a root `i₀` to the rest of its `σ`-orbit implies pairwise orthogonality of the
entire `σ`-orbit, by `σ`-invariance of `P.pairing`. -/
theorem pairwise_isOrthogonal_orbitIndices {σ : P.Aut} {i₀ : ι}
    (horth₀ : ∀ j ∈ P.orbitIndices σ i₀, i₀ ≠ j → P.pairing i₀ j = 0) :
    (P.orbitIndices σ i₀ : Set ι).Pairwise P.IsOrthogonal := by
  intro j hj k hk hjk
  have hj' : j ∈ P.orbitIndices σ i₀ := Finset.mem_coe.mp hj
  rcases mem_orbitIndices_iff_exists_pow.mp hj' with ⟨m, rfl⟩
  let τ : P.Aut := σ ^ m
  have hτ_idx (z : ι) : τ.indexEquiv z = (σ.indexEquiv ^ m) z := by
    change Equiv.indexHom P (σ ^ m) z = ((Equiv.indexHom P σ) ^ m) z
    rw [map_pow]
  have hmap : (P.orbitIndices σ i₀).map τ.indexEquiv.toEmbedding = P.orbitIndices σ i₀ := by
    rw [P.map_orbitIndices τ (P.indexEquiv_comm_of_commute ((Commute.refl σ).pow_left m)) i₀,
      hτ_idx, orbitIndices_eq_of_mem hj']
  obtain ⟨k₀, hk₀_mem, rfl⟩ := Finset.mem_map.mp (hmap.symm ▸ Finset.mem_coe.mp hk)
  rw [Function.Embedding.coeFn_mk, ← hτ_idx i₀] at hjk ⊢
  have hp : P.pairing (τ.indexEquiv i₀) (τ.indexEquiv k₀) = 0 := by
    rw [τ.toHom.pairing]
    exact horth₀ k₀ hk₀_mem fun h ↦ hjk (congrArg τ.indexEquiv h)
  exact ⟨hp, P.pairing_eq_zero_iff'.mp hp⟩

/-- The **block reflection** associated with an orthogonal `σ`-orbit: the commuting product in
`P.weylGroup` of the reflections in `P.orbitIndices σ i₀`. -/
noncomputable def blockReflection (σ : P.Aut) (i₀ : ι)
    (horth₀ : ∀ j ∈ P.orbitIndices σ i₀, i₀ ≠ j → P.pairing i₀ j = 0) : P.weylGroup :=
  P.orthogonalReflectionProd (P.orbitIndices σ i₀) (P.pairwise_isOrthogonal_orbitIndices horth₀)

@[simp]
theorem blockReflection_mul_self {σ : P.Aut} {i₀ : ι}
    (horth₀ : ∀ j ∈ P.orbitIndices σ i₀, i₀ ≠ j → P.pairing i₀ j = 0) :
    P.blockReflection σ i₀ horth₀ * P.blockReflection σ i₀ horth₀ = 1 :=
  P.orthogonalReflectionProd_mul_self _ _

@[simp]
theorem blockReflection_inv {σ : P.Aut} {i₀ : ι}
    (horth₀ : ∀ j ∈ P.orbitIndices σ i₀, i₀ ≠ j → P.pairing i₀ j = 0) :
    (P.blockReflection σ i₀ horth₀)⁻¹ = P.blockReflection σ i₀ horth₀ :=
  P.orthogonalReflectionProd_inv _ _

/-- Every block reflection commutes with `σ`. -/
theorem commute_blockReflection {σ : P.Aut} {i₀ : ι}
    (horth₀ : ∀ j ∈ P.orbitIndices σ i₀, i₀ ≠ j → P.pairing i₀ j = 0) :
    Commute (P.blockReflection σ i₀ horth₀ : P.Aut) σ := by
  refine P.commute_orthogonalReflectionProd _ fun j hj ↦ ?_
  rcases mem_orbitIndices_iff_exists_pow.mp hj with ⟨m, rfl⟩
  exact mem_orbitIndices_iff_exists_pow.mpr ⟨m + 1, by rw [pow_succ', Equiv.Perm.mul_apply]⟩

/-- On a `σ`-fixed vector, the block reflection in the orbit of `i₀` acts as reflection in
`P.orbitSum σ i₀` against `P.coroot' i₀`. -/
theorem blockReflection_smul_of_weightMap_eq {σ : P.Aut} {i₀ : ι}
    (horth₀ : ∀ j ∈ P.orbitIndices σ i₀, i₀ ≠ j → P.pairing i₀ j = 0)
    {x : M} (hx : σ.weightMap x = x) :
    P.blockReflection σ i₀ horth₀ • x = x - P.coroot' i₀ x • P.orbitSum σ i₀ := by
  rw [blockReflection, orthogonalReflectionProd_smul, orbitSum_def, smul_sum]
  congr 1
  exact sum_congr rfl fun j hj ↦ by rw [P.coroot'_eq_of_mem_orbitIndices_of_weightMap_eq hj hx]

/-- Evaluating a coroot on the orbit sum of its own orthogonal orbit gives `2`. -/
theorem coroot'_orbitSum_self_eq_two {σ : P.Aut} {i₀ : ι}
    (horth₀ : ∀ j ∈ P.orbitIndices σ i₀, i₀ ≠ j → P.pairing i₀ j = 0) :
    P.coroot' i₀ (P.orbitSum σ i₀) = 2 := by
  rw [orbitSum_def, map_sum, sum_eq_single i₀]
  · rw [root_coroot'_eq_pairing, pairing_same]
  · intro j hj hne
    rw [root_coroot'_eq_pairing]
    exact P.pairing_eq_zero_iff'.mp (horth₀ j hj hne.symm)
  · exact fun hnot ↦ False.elim (hnot (self_mem_orbitIndices P σ i₀))

/-- A block reflection negates its own orbit sum. -/
theorem blockReflection_smul_orbitSum_self {σ : P.Aut} {i₀ : ι}
    (horth₀ : ∀ j ∈ P.orbitIndices σ i₀, i₀ ≠ j → P.pairing i₀ j = 0) :
    P.blockReflection σ i₀ horth₀ • P.orbitSum σ i₀ = -P.orbitSum σ i₀ := by
  rw [P.blockReflection_smul_of_weightMap_eq horth₀ (weightMap_orbitSum_self P σ i₀),
    P.coroot'_orbitSum_self_eq_two horth₀, two_smul, sub_add_eq_sub_sub, sub_self, zero_sub]

variable {P} in
/-- **Squared norm of an orthogonal orbit sum.** For any `σ`-invariant bilinear form `B` on `P`,
the squared norm of an orthogonal orbit sum is the orbit size times the squared norm of one
representative root. -/
theorem InvariantForm.apply_orbitSum_self (B : P.InvariantForm) {σ : P.Aut}
    (hBσ : ∀ x y, B.form (σ.weightMap x) (σ.weightMap y) = B.form x y) {r : ι}
    (horth_r : ∀ j ∈ P.orbitIndices σ r, r ≠ j → P.pairing r j = 0) :
    B.form (P.orbitSum σ r) (P.orbitSum σ r) =
      #(P.orbitIndices σ r) • B.form (P.root r) (P.root r) := by
  have hpair := P.pairwise_isOrthogonal_orbitIndices horth_r
  rw [orbitSum_def, map_sum]
  simp_rw [map_sum, LinearMap.sum_apply]
  rw [Finset.sum_comm]
  have hdiag : ∀ i ∈ P.orbitIndices σ r,
      ∑ j ∈ P.orbitIndices σ r, B.form (P.root i) (P.root j) = B.form (P.root r) (P.root r) := by
    intro i hi
    rw [sum_eq_single i (fun j hj hji ↦ ?_) (fun hnot ↦ False.elim (hnot hi))]
    · exact B.apply_root_self_of_mem_orbitIndices hBσ hi
    · have htwo := B.two_mul_apply_root_root i j
      rw [(hpair hi hj hji.symm).1, zero_mul] at htwo
      exact (mul_eq_zero.mp htwo).resolve_left two_ne_zero
  rw [sum_congr rfl hdiag, sum_const]

end CharZeroDomain

end BlockReflection

/-! ### Coroots, reflections, and Cartan matrix of an orthogonal realization -/

namespace OrbitSumRealization

variable {ι R M N : Type*} [CommRing R] [CharZero R] [IsDomain R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} [Finite ι] {b : P.Base} {σ : P.Aut}

/-- **Coroot formula for an orthogonal orbit.** On any orbit-sum realization, if the `σ`-orbit of
`i₀ : ι` is orthogonal, the coroot of `F.pairing` at its orbit sum `γ` restricts `P.coroot' i₀` to
`E^σ`. -/
theorem coroot_apply_of_pairing_eq_zero (F : P.OrbitSumRealization b σ) {i₀ : ι}
    (horth₀ : ∀ j ∈ P.orbitIndices σ i₀, i₀ ≠ j → P.pairing i₀ j = 0)
    {γ : P.foldedIndices σ} (hγ : P.orbitSum σ i₀ = (γ : M))
    (x : LinearMap.fixedSubmodule σ.weightMap) :
    F.pairing.coroot γ x = P.coroot' i₀ (x : M) := by
  let f : Module.Dual R (LinearMap.fixedSubmodule σ.weightMap) :=
    (P.coroot' i₀).comp (LinearMap.fixedSubmodule σ.weightMap).subtype
  suffices F.pairing.coroot γ = f by exact DFunLike.congr_fun this x
  refine F.coroot_eq_of_mapsTo_preReflection γ f ?_ ?_
  · simp only [f, LinearMap.comp_apply, Submodule.coe_subtype, F.root_eq γ, ← hγ]
    exact P.coroot'_orbitSum_self_eq_two horth₀
  · rintro _ ⟨δ, rfl⟩
    obtain ⟨s, hs⟩ := mem_foldedIndices.mp δ.property
    let w := P.blockReflection σ i₀ horth₀
    refine ⟨⟨P.orbitSum σ (P.weylGroupToPerm w s), orbitSum_mem_foldedIndices P σ _⟩,
      Subtype.ext ?_⟩
    rw [F.root_eq _, Module.preReflection_apply, Submodule.coe_sub, Submodule.coe_smul_of_tower]
    simp only [f, LinearMap.comp_apply, Submodule.coe_subtype]
    rw [F.root_eq δ, F.root_eq γ, ← hs, ← hγ,
      ← P.blockReflection_smul_of_weightMap_eq horth₀ (weightMap_orbitSum_self P σ s),
      P.weylGroup_smul_orbitSum (P.commute_blockReflection horth₀) s]

/-- **Reflection formula for an orthogonal orbit.** On any orbit-sum realization, reflection in the
orbit sum `γ` of an orthogonal orbit `i₀ : ι` restricts `P.blockReflection σ i₀ horth₀` to `E^σ`. -/
theorem reflection_apply_of_pairing_eq_zero (F : P.OrbitSumRealization b σ) {i₀ : ι}
    (horth₀ : ∀ j ∈ P.orbitIndices σ i₀, i₀ ≠ j → P.pairing i₀ j = 0)
    {γ : P.foldedIndices σ} (hγ : P.orbitSum σ i₀ = (γ : M))
    (x : LinearMap.fixedSubmodule σ.weightMap) :
    (F.pairing.reflection γ x : M) = P.blockReflection σ i₀ horth₀ • (x : M) := by
  rw [RootPairing.reflection_apply, F.coroot'_eq_coroot,
    F.coroot_apply_of_pairing_eq_zero horth₀ hγ, Submodule.coe_sub, Submodule.coe_smul_of_tower,
    F.root_eq γ, ← hγ,
    P.blockReflection_smul_of_weightMap_eq horth₀ (LinearMap.mem_fixedSubmodule_iff.mp x.property)]

/-- **Folded pairing against an orthogonal-orbit sum.** The pairing of any folded root `γ` (with
lift `r`) against the orbit sum `δ` of an orthogonal orbit `j₀ : ι` sums the ambient pairings
`P.pairing i j₀` over `i ∈ P.orbitIndices σ r`. -/
theorem pairing_eq_sum_of_pairing_eq_zero (F : P.OrbitSumRealization b σ) {r j₀ : ι}
    (horth₀ : ∀ j ∈ P.orbitIndices σ j₀, j₀ ≠ j → P.pairing j₀ j = 0)
    {γ δ : P.foldedIndices σ} (hγ : P.orbitSum σ r = (γ : M)) (hδ : P.orbitSum σ j₀ = (δ : M)) :
    F.pairing.pairing γ δ = ∑ i ∈ P.orbitIndices σ r, P.pairing i j₀ := by
  rw [F.pairing_eq_coroot_apply, F.coroot_apply_of_pairing_eq_zero horth₀ hδ, F.root_eq γ, ← hγ,
    orbitSum_def, map_sum]
  exact sum_congr rfl fun i _ ↦ root_coroot'_eq_pairing P j₀ i

/-- **Folded Cartan matrix entries.** When the simple `σ`-orbits are orthogonal, the `(γ, δ)`-entry
of `F.base.cartanMatrix` sums the ambient Cartan integers `P.pairingIn ℤ i j₀` as `i` ranges over
the first simple orbit and `j₀` is any representative of the second. -/
theorem cartanMatrix_apply [P.IsCrystallographic] (F : P.OrbitSumRealization b σ)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    {γ δ : F.base.support} {i₀ j₀ : ι} (hj₀ : j₀ ∈ b.support)
    (hγ : P.orbitSum σ i₀ = ((γ : P.foldedIndices σ) : M))
    (hδ : P.orbitSum σ j₀ = ((δ : P.foldedIndices σ) : M)) :
    F.base.cartanMatrix γ δ = ∑ i ∈ P.orbitIndices σ i₀, P.pairingIn ℤ i j₀ := by
  apply FaithfulSMul.algebraMap_injective ℤ R
  rw [Base.algebraMap_cartanMatrixIn_apply,
    F.pairing_eq_sum_of_pairing_eq_zero (horth j₀ hj₀) hγ hδ, map_sum]
  exact sum_congr rfl fun i _ ↦ (P.algebraMap_pairingIn ℤ i j₀).symm

/-- **Simply-laced folded Cartan entry (single-representative form).** When `b.cartanMatrix` is
simply laced and `γ ≠ δ`, `F.base.cartanMatrix γ δ` is the negated count of vertices in the first
simple orbit adjacent to a chosen representative `j₀` of the second. -/
theorem cartanMatrix_apply_eq_neg_card_of_isSimplyLaced [P.IsCrystallographic]
    (F : P.OrbitSumRealization b σ) (hsl : b.cartanMatrix.IsSimplyLaced)
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    {γ δ : F.base.support} (hγδ : γ ≠ δ)
    {i₀ j₀ : ι} (hi₀ : i₀ ∈ b.support) (hj₀ : j₀ ∈ b.support)
    (hγ : P.orbitSum σ i₀ = ((γ : P.foldedIndices σ) : M))
    (hδ : P.orbitSum σ j₀ = ((δ : P.foldedIndices σ) : M)) :
    F.base.cartanMatrix γ δ =
      -(#((P.orbitIndices σ i₀).filter fun i ↦ P.pairingIn ℤ i j₀ ≠ 0) : ℤ) := by
  rw [F.cartanMatrix_apply horth hj₀ hγ hδ, Finset.card_filter, Nat.cast_sum,
    ← Finset.sum_neg_distrib]
  refine sum_congr rfl fun i hi ↦ ?_
  have hi_supp : i ∈ b.support := mem_support_of_mem_orbitIndices hσ hi₀ hi
  have hij : (⟨i, hi_supp⟩ : b.support) ≠ ⟨j₀, hj₀⟩ := fun heq ↦
    hγδ <| Subtype.ext <| Subtype.ext <| by
      rw [← hγ, ← orbitSum_eq_of_mem hi, Subtype.mk.inj heq, hδ]
  rcases hsl hij with hz | hneg1
  · simp [show P.pairingIn ℤ i j₀ = 0 from hz]
  · simp [show P.pairingIn ℤ i j₀ = -1 from hneg1]

/-- **Simply-laced folded Cartan entry (block-edge form).** When `b.cartanMatrix` is simply laced
and `γ ≠ δ`, `#(P.orbitIndices σ j₀) * F.base.cartanMatrix γ δ` equals the negated total number of
oriented diagram edges from the `i₀`-orbit to the `j₀`-orbit. No interchange of the denominator's
orbit `j₀` is permitted. -/
theorem card_mul_cartanMatrix_apply_eq_neg_card_of_isSimplyLaced [P.IsCrystallographic]
    (F : P.OrbitSumRealization b σ) (hsl : b.cartanMatrix.IsSimplyLaced)
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    {γ δ : F.base.support} (hγδ : γ ≠ δ)
    {i₀ j₀ : ι} (hi₀ : i₀ ∈ b.support) (hj₀ : j₀ ∈ b.support)
    (hγ : P.orbitSum σ i₀ = ((γ : P.foldedIndices σ) : M))
    (hδ : P.orbitSum σ j₀ = ((δ : P.foldedIndices σ) : M)) :
    (#(P.orbitIndices σ j₀) : ℤ) * F.base.cartanMatrix γ δ =
      -(#((P.orbitIndices σ i₀ ×ˢ P.orbitIndices σ j₀).filter
        fun p ↦ P.pairingIn ℤ p.1 p.2 ≠ 0) : ℤ) := by
  have hsum :
      ∑ _j ∈ P.orbitIndices σ j₀, F.base.cartanMatrix γ δ =
        ∑ j ∈ P.orbitIndices σ j₀,
          -(#((P.orbitIndices σ i₀).filter fun i ↦ P.pairingIn ℤ i j ≠ 0) : ℤ) := by
    refine sum_congr rfl fun j hj ↦ ?_
    have hj_supp : j ∈ b.support := mem_support_of_mem_orbitIndices hσ hj₀ hj
    exact F.cartanMatrix_apply_eq_neg_card_of_isSimplyLaced hsl hσ horth hγδ hi₀ hj_supp hγ
      ((orbitSum_eq_of_mem hj).trans hδ)
  rw [Finset.sum_const, nsmul_eq_mul] at hsum
  rw [hsum, Finset.sum_neg_distrib, neg_inj, ← Nat.cast_sum, Nat.cast_inj]
  simp_rw [Finset.card_filter]
  rw [Finset.sum_comm, ← Finset.sum_product']

end OrbitSumRealization

/-! ### Height descent, unrestricted root-orbit orthogonality, and construction of the fold -/

section OrthogonalFold

variable {ι K M N : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]
  (P : RootPairing ι K M N) [Finite ι] [P.IsRootSystem] [P.IsReduced] [P.IsCrystallographic]

/-- The subgroup of `P.weylGroup` generated by the simple block reflections. -/
private noncomputable def blockWeylSubgroup (b : P.Base) (σ : P.Aut)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0) :
    Subgroup P.weylGroup :=
  Subgroup.closure
    {w : P.weylGroup | ∃ i : b.support, w = P.blockReflection σ i.1 (horth i.1 i.2)}

omit [P.IsRootSystem] [P.IsReduced] [P.IsCrystallographic] in
private theorem commute_of_mem_blockWeylSubgroup {b : P.Base} {σ : P.Aut}
    {horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0}
    {u : P.weylGroup} (hu : u ∈ P.blockWeylSubgroup b σ horth) :
    Commute (u : P.Aut) σ := by
  refine Subgroup.closure_induction ?_ (Commute.one_left σ)
    (fun _ _ _ _ h₁ h₂ ↦ h₁.mul_left h₂) (fun _ _ h ↦ h.inv_left) hu
  rintro _ ⟨i, rfl⟩
  exact P.commute_blockReflection (horth i.1 i.2)

omit [P.IsReduced] [P.IsCrystallographic] in
/-- Applying `heightLinearMap` to an orbit sum multiplies the root height by the orbit size. -/
private theorem heightLinearMap_orbitSum {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) (r : ι) :
    heightLinearMap P b (P.orbitSum σ r) = #(P.orbitIndices σ r) * (b.height r : K) := by
  rw [orbitSum_def, map_sum]
  have hconst : ∀ j ∈ P.orbitIndices σ r, heightLinearMap P b (P.root j) = (b.height r : K) := by
    intro j hj
    rw [heightLinearMap_root]
    congr 1
    rcases mem_orbitIndices_iff_exists_pow.mp hj with ⟨m, rfl⟩
    clear hj
    induction m with
    | zero => rw [pow_zero, Equiv.Perm.one_apply]
    | succ m ih => rw [pow_succ', Equiv.Perm.mul_apply, b.height_indexEquiv σ hσ, ih]
  rw [sum_congr rfl hconst, sum_const, nsmul_eq_mul]

/-- **Height descent for positive roots.** Every `b`-positive root can be moved into `b.support` by
an element of the subgroup generated by simple block reflections. -/
private theorem exists_mem_blockWeylSubgroup_of_isPos {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    {r : ι} (hr : b.IsPos r) :
    ∃ u ∈ P.blockWeylSubgroup b σ horth, ∃ i₀ ∈ b.support, P.weylGroupToPerm u r = i₀ := by
  have : Fintype ι := Fintype.ofFinite ι
  generalize hN : (b.height r).natAbs = N
  induction N using Nat.strong_induction_on generalizing r with
  | _ N ih =>
    have hpos_norm : 0 < P.RootForm (P.orbitSum σ r) (P.orbitSum σ r) :=
      P.rootForm_pos_of_ne_zero (by simp [IsRootSystem.span_root_eq_top]) (P.orbitSum_ne_zero hσ r)
    obtain ⟨n, hn⟩ := (mem_posRootCone P b).mp (P.orbitSum_mem_posRootCone hσ hr)
    have htwo_pos : 0 < 2 * P.RootForm (P.orbitSum σ r) (P.orbitSum σ r) := by linarith
    have hexpand :
        2 * P.RootForm (P.orbitSum σ r) (P.orbitSum σ r) =
          ∑ i ∈ b.support,
            (n i : K) * (P.coroot' i (P.orbitSum σ r) * P.RootForm (P.root i) (P.root i)) := by
      conv_lhs => enter [2, 2]; rw [hn]
      rw [map_sum, Finset.mul_sum]
      refine sum_congr rfl fun i _ ↦ ?_
      rw [← Nat.cast_smul_eq_nsmul K, map_smul, smul_eq_mul, mul_left_comm,
        ← P.toInvariantForm_form, P.toInvariantForm.two_mul_apply_root, P.toInvariantForm_form]
    rw [hexpand] at htwo_pos
    obtain ⟨i₀, hi₀, hterm_pos⟩ : ∃ i₀ ∈ b.support,
        0 < (n i₀ : K) * (P.coroot' i₀ (P.orbitSum σ r) * P.RootForm (P.root i₀) (P.root i₀)) := by
      by_contra! hle
      exact htwo_pos.not_ge (Finset.sum_nonpos hle)
    have hcor_pos : 0 < P.coroot' i₀ (P.orbitSum σ r) := by
      have hn_pos : 0 < (n i₀ : K) :=
        (Nat.cast_nonneg _).lt_of_ne' fun hz ↦ by simp [hz] at hterm_pos
      have hroot_pos : 0 < P.RootForm (P.root i₀) (P.root i₀) :=
        P.rootForm_pos_of_ne_zero (subset_span ⟨i₀, rfl⟩) (P.ne_zero i₀)
      exact pos_of_mul_pos_left (pos_of_mul_pos_right hterm_pos hn_pos.le) hroot_pos.le
    by_cases hr_mem : r ∈ P.orbitIndices σ i₀
    · exact ⟨1, Subgroup.one_mem _, r, mem_support_of_mem_orbitIndices hσ hi₀ hr_mem, by simp⟩
    · let w := P.blockReflection σ i₀ (horth i₀ hi₀)
      have hw_mem : w ∈ P.blockWeylSubgroup b σ horth :=
        Subgroup.subset_closure ⟨⟨i₀, hi₀⟩, rfl⟩
      have hw_comm : Commute (w : P.Aut) σ := P.commute_blockReflection (horth i₀ hi₀)
      let r' := P.weylGroupToPerm w r
      have hr'_pos : b.IsPos r' :=
        (P.isPos_and_notMem_weylGroupToPerm_orthogonalReflectionProd
          (P.pairwise_isOrthogonal_orbitIndices (horth i₀ hi₀))
          (fun _ hk ↦ mem_support_of_mem_orbitIndices hσ hi₀ hk) hr hr_mem).1
      have horb_eq : P.orbitSum σ r' =
          P.orbitSum σ r - P.coroot' i₀ (P.orbitSum σ r) • P.orbitSum σ i₀ := by
        rw [← P.weylGroup_smul_orbitSum hw_comm r,
          P.blockReflection_smul_of_weightMap_eq (horth i₀ hi₀) (weightMap_orbitSum_self P σ r)]
      have hht_eq := congrArg (heightLinearMap P b) horb_eq
      rw [map_sub, map_smul, smul_eq_mul, P.heightLinearMap_orbitSum hσ r',
        P.heightLinearMap_orbitSum hσ r, P.heightLinearMap_orbitSum hσ i₀,
        P.card_orbitIndices_weylGroupToPerm hw_comm r,
        Base.height_one_of_mem_support hi₀, Int.cast_one, mul_one] at hht_eq
      have hcard_i₀ : (0 : K) < #(P.orbitIndices σ i₀) :=
        Nat.cast_pos.mpr (card_orbitIndices_pos P σ i₀)
      have hcard_r : (0 : K) < #(P.orbitIndices σ r) :=
        Nat.cast_pos.mpr (card_orbitIndices_pos P σ r)
      have hht_lt : b.height r' < b.height r :=
        Int.cast_lt.mp <| lt_of_mul_lt_mul_left
          (by linarith [mul_pos hcor_pos hcard_i₀]) hcard_r.le
      have hnat_lt : (b.height r').natAbs < N := by
        have := b.isPos_iff.mp hr'_pos
        have := b.isPos_iff.mp hr
        omega
      obtain ⟨u', hu', i₁, hi₁, hu'_eq⟩ := ih _ hnat_lt hr'_pos rfl
      refine ⟨u' * w, Subgroup.mul_mem _ hu' hw_mem, i₁, hi₁, ?_⟩
      rw [map_mul, Equiv.Perm.mul_apply, hu'_eq]

/-- **Every root lies in the block-reflection orbit of `b.support`.** Negative roots reduce to
positive roots via `P.reflectionPerm r r` followed by the block reflection of the resulting simple
orbit. -/
private theorem exists_mem_blockWeylSubgroup {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (r : ι) :
    ∃ u ∈ P.blockWeylSubgroup b σ horth, ∃ i₀ ∈ b.support, P.weylGroupToPerm u r = i₀ := by
  by_cases hr : b.IsPos r
  · exact P.exists_mem_blockWeylSubgroup_of_isPos hσ horth hr
  · have hr_neg : b.IsPos (P.reflectionPerm r r) :=
      (isPos_reflectionPerm_self_iff_mem_negRoots P b r).mpr ((mem_negRoots P b r).mpr hr)
    obtain ⟨u, hu, i₀, hi₀, hu_eq⟩ := P.exists_mem_blockWeylSubgroup_of_isPos hσ horth hr_neg
    rw [weylGroupToPerm_apply, (u : P.Aut).toHom.indexEquiv_reflectionPerm r r,
      ← weylGroupToPerm_apply] at hu_eq
    have hur : P.weylGroupToPerm u r = P.reflectionPerm i₀ i₀ := by
      simpa [reflectionPerm_self_involutive P (P.weylGroupToPerm u r)] using
        congrArg (fun z ↦ P.reflectionPerm z z) hu_eq
    let w₀ := P.blockReflection σ i₀ (horth i₀ hi₀)
    have hw₀_i₀ : P.weylGroupToPerm w₀ i₀ = P.reflectionPerm i₀ i₀ :=
      P.weylGroupToPerm_orthogonalReflectionProd_of_mem _ (self_mem_orbitIndices P σ i₀)
    have hw₀_neg : P.weylGroupToPerm w₀ (P.reflectionPerm i₀ i₀) = i₀ := by
      rw [← hw₀_i₀, ← Equiv.Perm.mul_apply, ← map_mul, blockReflection_mul_self, map_one,
        Equiv.Perm.one_apply]
    refine ⟨w₀ * u, Subgroup.mul_mem _ (Subgroup.subset_closure ⟨⟨i₀, hi₀⟩, rfl⟩) hu, i₀, hi₀, ?_⟩
    rw [map_mul, Equiv.Perm.mul_apply, hur, hw₀_neg]

variable {P} in
/-- **Unrestricted root-orbit orthogonality (Stembridge).** In a finite reduced crystallographic
root system over a linearly ordered field, orthogonality of simple `σ`-orbits implies orthogonality
of *every* root `σ`-orbit. -/
theorem orbit_pairing_eq_zero {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (r : ι) {i j : ι} (hi : i ∈ P.orbitIndices σ r) (hj : j ∈ P.orbitIndices σ r) (hij : i ≠ j) :
    P.pairing i j = 0 := by
  obtain ⟨u, hu, i₀, hi₀, hu_eq⟩ := P.exists_mem_blockWeylSubgroup hσ horth r
  have hmap :
      (P.orbitIndices σ r).map (u : P.Aut).indexEquiv.toEmbedding = P.orbitIndices σ i₀ := by
    rw [P.map_orbitIndices (u : P.Aut)
      (P.indexEquiv_comm_of_commute (P.commute_of_mem_blockWeylSubgroup hu)) r,
      ← weylGroupToPerm_apply, hu_eq]
  have hi' : (u : P.Aut).indexEquiv i ∈ P.orbitIndices σ i₀ :=
    hmap ▸ Finset.mem_map_of_mem (u : P.Aut).indexEquiv.toEmbedding hi
  have hj' : (u : P.Aut).indexEquiv j ∈ P.orbitIndices σ i₀ :=
    hmap ▸ Finset.mem_map_of_mem (u : P.Aut).indexEquiv.toEmbedding hj
  rw [← (u : P.Aut).toHom.pairing]
  exact (P.pairwise_isOrthogonal_orbitIndices (horth i₀ hi₀) hi' hj'
    ((u : P.Aut).indexEquiv.injective.ne hij)).1

variable {P} in
/-- Every root `σ`-orbit is pairwise orthogonal under simple-orbit orthogonality. -/
theorem pairwise_isOrthogonal_orbitIndices_of_base {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (r : ι) :
    (P.orbitIndices σ r : Set ι).Pairwise P.IsOrthogonal :=
  P.pairwise_isOrthogonal_orbitIndices fun _ hj hrj ↦
    orbit_pairing_eq_zero hσ horth r (self_mem_orbitIndices P σ r) hj hrj

omit [LinearOrder K] [IsStrictOrderedRing K] [P.IsReduced] [P.IsCrystallographic] in
/-- Coordinates of a natural simple-root combination in `b.toWeightBasis`. -/
private theorem toWeightBasis_repr_of_eq_sum_nsmul {b : P.Base} {v : M} {f : ι → ℕ}
    (hv : v = ∑ l ∈ b.support, f l • P.root l) (l : b.support) :
    b.toWeightBasis.repr v l = (f l : K) := by
  have hexp : v = ∑ m : b.support, (f m : K) • b.toWeightBasis m := by
    rw [hv, ← Finset.sum_attach b.support, Finset.attach_eq_univ]
    exact sum_congr rfl fun m _ ↦ by rw [b.toWeightBasis_apply m, Nat.cast_smul_eq_nsmul K]
  have hfun : b.toWeightBasis.equivFun v = fun m : b.support ↦ (f m : K) := by
    rw [hexp, ← b.toWeightBasis.equivFun_symm_apply, b.toWeightBasis.equivFun.apply_symm_apply]
  rw [← b.toWeightBasis.equivFun_apply, hfun]

/-- A `b`-positive root whose simple-root expansion is supported inside a pairwise-orthogonal subset
`s ⊆ b.support` must belong to `s`. -/
private theorem mem_of_isPos_of_repr_support_subset {b : P.Base} {s : Finset ι}
    (hs : (s : Set ι).Pairwise P.IsOrthogonal) (hsub : (s : Set ι) ⊆ b.support)
    {k : ι} (hk : b.IsPos k)
    (hsupp : ∀ l : b.support, b.toWeightBasis.repr (P.root k) l ≠ 0 → (l : ι) ∈ s) :
    k ∈ s := by
  classical
  let p (m : ι) : Prop :=
    b.IsPos m ∧ ((∀ l : b.support, b.toWeightBasis.repr (P.root m) l ≠ 0 → (l : ι) ∈ s) → m ∈ s)
  have hmain : p k := by
    refine hk.induction_on_add (p := p)
      (fun i hi ↦ ⟨b.isPos_of_mem_support hi, fun hi_supp ↦ ?_⟩) ?_
    · refine hi_supp ⟨i, hi⟩ ?_
      rw [← b.toWeightBasis_apply ⟨i, hi⟩, Module.Basis.repr_self, Finsupp.single_eq_same]
      exact one_ne_zero
    · intro i j m hm ⟨hi_pos, ih_i⟩ hj
      refine ⟨hi_pos.add (b.isPos_of_mem_support hj) hm, fun hm_supp ↦ ?_⟩
      obtain ⟨f, hf⟩ := (mem_posRootCone P b).mp
        (root_mem_posRootCone_of_mem_posRoots P b ((mem_posRoots P b i).mpr hi_pos))
      have hrepr_i := P.toWeightBasis_repr_of_eq_sum_nsmul hf
      have hj_in_s : j ∈ s := hm_supp ⟨j, hj⟩ <| by
        rw [hm, map_add, Finsupp.add_apply, hrepr_i ⟨j, hj⟩,
          ← b.toWeightBasis_apply ⟨j, hj⟩, Module.Basis.repr_self, Finsupp.single_eq_same]
        linarith [show (0 : K) ≤ f j from Nat.cast_nonneg _]
      have hi_in_s : i ∈ s := ih_i fun l hl_ne ↦ hm_supp l <| by
        rw [hrepr_i l] at hl_ne
        have hjl_nn : (0 : K) ≤ b.toWeightBasis.repr (P.root j) l := by
          rw [← b.toWeightBasis_apply ⟨j, hj⟩, Module.Basis.repr_self, Finsupp.single_apply]
          split_ifs <;> norm_num
        rw [hm, map_add, Finsupp.add_apply, hrepr_i l]
        linarith [(Nat.cast_nonneg (f l)).lt_of_ne' hl_ne]
      exfalso
      rcases eq_or_ne i j with rfl | hij
      · have hdep : ¬ LinearIndependent K ![P.root m, P.root i] := by
          rw [LinearIndependent.pair_iff]
          push Not
          exact ⟨1, -2, by rw [one_smul, hm]; module, fun h ↦ absurd h one_ne_zero⟩
        rcases IsReduced.eq_or_eq_neg (P := P) m i hdep with h | h
        · exact P.ne_zero i (by simpa using sub_eq_zero.mpr (hm.symm.trans h))
        · have h3 : (3 : K) • P.root i = 0 := by
            calc (3 : K) • P.root i = (P.root i + P.root i) + P.root i := by module
              _ = 0 := by rw [← hm, h, neg_add_cancel]
          exact P.ne_zero i ((smul_eq_zero.mp h3).resolve_left (by norm_num))
      · have hij_sub : (⟨i, hsub hi_in_s⟩ : b.support) ≠ ⟨j, hj⟩ :=
          fun h ↦ hij (congrArg Subtype.val h)
        exact (b.cartanMatrix_apply_eq_zero_iff hij_sub).mp
          (b.cartanMatrix_apply_eq_zero_iff_pairing.mpr (hs hi_in_s hj_in_s hij).1) ⟨m, hm⟩
  exact hmain.2 hsupp

/-- **Proportionality of orbit sums forces `c = ±1`.** -/
private theorem eq_one_or_neg_one_of_orbitSum_eq_smul {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    {r₁ r₂ : ι} {c : K} (hc : P.orbitSum σ r₁ = c • P.orbitSum σ r₂) :
    c = 1 ∨ c = -1 := by
  classical
  obtain ⟨u, hu, j₀, hj₀, hu_eq⟩ := P.exists_mem_blockWeylSubgroup hσ horth r₂
  have hu_comm : Commute (u : P.Aut) σ := P.commute_of_mem_blockWeylSubgroup hu
  have hsmul := congrArg (fun v : M ↦ u • v) hc
  rw [P.weylGroup_smul_orbitSum hu_comm r₁, smul_comm,
    P.weylGroup_smul_orbitSum hu_comm r₂, hu_eq] at hsmul
  set r' := P.weylGroupToPerm u r₁
  have hpos_case {r₀ : ι} (hr₀ : b.IsPos r₀) {d : K}
      (hd₀ : P.orbitSum σ r₀ = d • P.orbitSum σ j₀) : d = 1 := by
    choose f hf using fun k : P.orbitIndices σ r₀ ↦
      (mem_posRootCone P b).mp (root_mem_posRootCone_of_mem_posRoots P b
        ((mem_posRoots P b k.1).mpr ((isPos_iff_of_mem_orbitIndices hσ k.2).mpr hr₀)))
    have horb_sub : P.orbitIndices σ j₀ ⊆ b.support :=
      fun l hl ↦ mem_support_of_mem_orbitIndices hσ hj₀ hl
    have hd : ∑ l ∈ b.support, (∑ k : P.orbitIndices σ r₀, (f k l : K)) • P.root l =
        ∑ l ∈ b.support, (if l ∈ P.orbitIndices σ j₀ then d else 0) • P.root l := by
      calc ∑ l ∈ b.support, (∑ k : P.orbitIndices σ r₀, (f k l : K)) • P.root l
          = ∑ k ∈ (P.orbitIndices σ r₀).attach, ∑ l ∈ b.support, (f k l : K) • P.root l := by
            simp_rw [Finset.sum_smul]; exact Finset.sum_comm
        _ = P.orbitSum σ r₀ := by
            rw [orbitSum_def, ← Finset.sum_attach (P.orbitIndices σ r₀)]
            refine sum_congr rfl fun k _ ↦ ?_
            rw [hf k]
            exact sum_congr rfl fun l _ ↦ (Nat.cast_smul_eq_nsmul K (f k l) (P.root l))
        _ = d • P.orbitSum σ j₀ := hd₀
        _ = ∑ l ∈ b.support, (if l ∈ P.orbitIndices σ j₀ then d else 0) • P.root l := by
            simp_rw [ite_smul, zero_smul, sum_ite_mem, Finset.inter_eq_right.mpr horb_sub,
              ← smul_sum, orbitSum_def]
    have hcoeff (l : ι) (hl : l ∈ b.support) :
        ∑ k : P.orbitIndices σ r₀, (f k l : K) = if l ∈ P.orbitIndices σ j₀ then d else 0 :=
      sub_eq_zero.mp <| linearIndepOn_iff'.mp b.linearIndepOn_root b.support
        (fun l ↦ (∑ k : P.orbitIndices σ r₀, (f k l : K)) -
          if l ∈ P.orbitIndices σ j₀ then d else 0)
        (fun _ hl ↦ hl) (by simp_rw [sub_smul, sum_sub_distrib, hd, sub_self]) l hl
    let r₀_sub : P.orbitIndices σ r₀ := ⟨r₀, self_mem_orbitIndices P σ r₀⟩
    have hr₀_in_orb : r₀ ∈ P.orbitIndices σ j₀ := by
      refine P.mem_of_isPos_of_repr_support_subset
        (P.pairwise_isOrthogonal_orbitIndices (horth j₀ hj₀)) horb_sub hr₀ fun l hl_ne ↦ ?_
      by_contra hl_not
      have hsum_nat : ∑ k : P.orbitIndices σ r₀, f k l = 0 := by
        exact_mod_cast (by simpa [hl_not] using hcoeff l l.2 :
          ∑ k : P.orbitIndices σ r₀, (f k l : K) = 0)
      have hf0 := Finset.sum_eq_zero_iff.mp hsum_nat r₀_sub (Finset.mem_univ _)
      exact hl_ne (by rw [P.toWeightBasis_repr_of_eq_sum_nsmul (hf r₀_sub) l, hf0, Nat.cast_zero])
    rw [orbitSum_eq_of_mem hr₀_in_orb] at hd₀
    have hsub0 : (d - 1) • P.orbitSum σ j₀ = 0 := by rw [sub_smul, one_smul, ← hd₀, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp hsub0).resolve_right (P.orbitSum_ne_zero hσ j₀))
  by_cases hr' : b.IsPos r'
  · exact .inl (hpos_case hr' hsmul)
  · right
    have hr'_neg : b.IsPos (P.reflectionPerm r' r') :=
      (isPos_reflectionPerm_self_iff_mem_negRoots P b r').mpr ((mem_negRoots P b r').mpr hr')
    exact neg_eq_iff_eq_neg.mp
      (hpos_case hr'_neg (by rw [orbitSum_reflectionPerm_self, hsmul, neg_smul]))

end OrthogonalFold

section RootFormAndConstruction

variable {ι K M N : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]

/-- **Canonical root form on an orbit sum.** Under simple-orbit orthogonality, the canonical root
form squared norm of *every* orbit sum `P.orbitSum σ r` is `#(P.orbitIndices σ r)` times the
squared norm of `P.root r`. -/
theorem rootForm_orbitSum_self {P : RootPairing ι K M N} [Fintype ι] [P.IsRootSystem]
    [P.IsReduced] [P.IsCrystallographic] {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (r : ι) :
    P.RootForm (P.orbitSum σ r) (P.orbitSum σ r) =
      #(P.orbitIndices σ r) * P.RootForm (P.root r) (P.root r) := by
  simpa only [toInvariantForm_form, nsmul_eq_mul] using
    P.toInvariantForm.apply_orbitSum_self (fun x y ↦ σ.toHom.rootForm_weightMap x y)
      (fun _ hj hrj ↦ orbit_pairing_eq_zero hσ horth r (self_mem_orbitIndices P σ r) hj hrj)

variable (P : RootPairing ι K M N) [Finite ι] [P.IsRootSystem] [P.IsReduced] [P.IsCrystallographic]

omit [P.IsReduced] [P.IsCrystallographic] in
private theorem rootForm_foldedIndices_pos {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) (γ : P.foldedIndices σ) :
    letI : Fintype ι := Fintype.ofFinite ι
    0 < P.RootForm (γ : M) (γ : M) := by
  let : Fintype ι := Fintype.ofFinite ι
  obtain ⟨r, hr⟩ := mem_foldedIndices.mp γ.property
  exact hr ▸ P.rootForm_pos_of_ne_zero (by simp [IsRootSystem.span_root_eq_top])
    (P.orbitSum_ne_zero hσ r)

omit [LinearOrder K] [IsStrictOrderedRing K] [P.IsRootSystem] [P.IsReduced]
  [P.IsCrystallographic] in
/-- **Normalized coroot functional on `E^σ`** defined via `P.RootForm`. -/
private noncomputable def foldedCorootFun (σ : P.Aut) (γ : P.foldedIndices σ) :
    Module.Dual K (LinearMap.fixedSubmodule σ.weightMap) :=
  letI : Fintype ι := Fintype.ofFinite ι
  (2 / P.RootForm (γ : M) (γ : M)) •
    (P.RootForm (γ : M)).comp (LinearMap.fixedSubmodule σ.weightMap).subtype

omit [LinearOrder K] [IsStrictOrderedRing K] [P.IsRootSystem] [P.IsReduced]
  [P.IsCrystallographic] in
private theorem foldedCorootFun_apply {σ : P.Aut} (γ : P.foldedIndices σ)
    (x : LinearMap.fixedSubmodule σ.weightMap) :
    letI : Fintype ι := Fintype.ofFinite ι
    foldedCorootFun P σ γ x =
      (2 / P.RootForm (γ : M) (γ : M)) * P.RootForm (γ : M) (x : M) := rfl

variable {P} in
/-- Under simple-orbit orthogonality, `foldedCorootFun P σ γ` agrees on `E^σ` with `P.coroot' r`
for *every* representative `r` of `γ`. -/
private theorem foldedCorootFun_eq_coroot' {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    {γ : P.foldedIndices σ} {r : ι} (hr : P.orbitSum σ r = (γ : M))
    (x : LinearMap.fixedSubmodule σ.weightMap) :
    foldedCorootFun P σ γ x = P.coroot' r (x : M) := by
  let : Fintype ι := Fintype.ofFinite ι
  have htwo : 2 * P.RootForm (γ : M) (x : M) =
      P.coroot' r (x : M) * P.RootForm (γ : M) (γ : M) := by
    have hsymm : P.RootForm (γ : M) (x : M) = P.RootForm (x : M) (γ : M) :=
      P.rootForm_symmetric.eq (γ : M) (x : M)
    conv_lhs => rw [hsymm, ← hr, orbitSum_def, map_sum, Finset.mul_sum]
    have hterm : ∀ j ∈ P.orbitIndices σ r,
        2 * P.RootForm (x : M) (P.root j) =
          P.coroot' r (x : M) * P.RootForm (P.root r) (P.root r) := fun j hj ↦ by
      rw [← P.toInvariantForm_form, P.toInvariantForm.two_mul_apply_root,
        P.coroot'_eq_of_mem_orbitIndices_of_weightMap_eq hj
          (LinearMap.mem_fixedSubmodule_iff.mp x.property),
        P.toInvariantForm.apply_root_self_of_mem_orbitIndices
          (fun u v ↦ σ.toHom.rootForm_weightMap u v) hj, P.toInvariantForm_form]
    rw [sum_congr rfl hterm, sum_const, nsmul_eq_mul, ← mul_assoc,
      mul_comm (#(P.orbitIndices σ r) : K), mul_assoc, ← rootForm_orbitSum_self hσ horth r, ← hr]
  rw [foldedCorootFun_apply, div_mul_eq_mul_div, htwo,
    mul_div_cancel_right₀ _ (rootForm_foldedIndices_pos P hσ γ).ne']

private theorem injective_foldedCorootFun {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0) :
    Injective (foldedCorootFun P σ) := by
  let : Fintype ι := Fintype.ofFinite ι
  intro γ₁ γ₂ heq
  have hpos₁ := rootForm_foldedIndices_pos P hσ γ₁
  have hpos₂ := rootForm_foldedIndices_pos P hσ γ₂
  let c : K := P.RootForm (γ₁ : M) (γ₁ : M) / P.RootForm (γ₂ : M) (γ₂ : M)
  have hc_pos : 0 < c := div_pos hpos₁ hpos₂
  let v : LinearMap.fixedSubmodule σ.weightMap := P.foldedRoot σ γ₁ - c • P.foldedRoot σ γ₂
  have hv_orth (x : LinearMap.fixedSubmodule σ.weightMap) : P.RootForm (v : M) (x : M) = 0 := by
    have hfun := DFunLike.congr_fun heq x
    simp only [foldedCorootFun_apply] at hfun
    have hrel : P.RootForm (γ₁ : M) (x : M) = c * P.RootForm (γ₂ : M) (x : M) := by
      have hmul := congrArg (fun t ↦ (P.RootForm (γ₁ : M) (γ₁ : M) / 2) * t) hfun
      dsimp only [c]
      field_simp [hpos₁.ne', hpos₂.ne'] at hmul ⊢
      linarith
    simp [v, hrel]
  have hv_zero : (v : M) = 0 := by
    by_contra hv_ne
    exact (P.rootForm_pos_of_ne_zero (by simp [IsRootSystem.span_root_eq_top]) hv_ne).ne'
      (hv_orth v)
  have hsmul : (γ₁ : M) = c • (γ₂ : M) := by simpa [v] using sub_eq_zero.mp hv_zero
  obtain ⟨r₁, hr₁⟩ := mem_foldedIndices.mp γ₁.property
  obtain ⟨r₂, hr₂⟩ := mem_foldedIndices.mp γ₂.property
  have hsmul' : P.orbitSum σ r₁ = c • P.orbitSum σ r₂ := by rw [hr₁, hr₂]; exact hsmul
  rcases P.eq_one_or_neg_one_of_orbitSum_eq_smul hσ horth hsmul' with hc | hc
  · rw [hc, one_smul] at hsmul; exact Subtype.ext hsmul
  · linarith

omit [P.IsReduced] [P.IsCrystallographic] in
private theorem foldedCorootFun_foldedRoot_self {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) (γ : P.foldedIndices σ) :
    (Module.Dual.eval K (LinearMap.fixedSubmodule σ.weightMap))
      (P.foldedRoot σ γ) (foldedCorootFun P σ γ) = 2 := by
  let : Fintype ι := Fintype.ofFinite ι
  change foldedCorootFun P σ γ (P.foldedRoot σ γ) = 2
  rw [foldedCorootFun_apply, coe_foldedRoot,
    div_mul_cancel₀ _ (rootForm_foldedIndices_pos P hσ γ).ne']

private theorem mapsTo_preReflection_foldedCorootFun {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (γ : P.foldedIndices σ) :
    MapsTo
      (Module.preReflection (P.foldedRoot σ γ)
        ((Module.Dual.eval K (LinearMap.fixedSubmodule σ.weightMap)).flip
          (foldedCorootFun P σ γ)))
      (range (P.foldedRoot σ)) (range (P.foldedRoot σ)) := by
  rintro _ ⟨δ, rfl⟩
  obtain ⟨r, hr⟩ := mem_foldedIndices.mp γ.property
  obtain ⟨s, h_s⟩ := mem_foldedIndices.mp δ.property
  obtain ⟨u, hu, i₀, hi₀, hu_eq⟩ := P.exists_mem_blockWeylSubgroup hσ horth r
  let wγ : P.weylGroup := u⁻¹ * P.blockReflection σ i₀ (horth i₀ hi₀) * u
  have hwγ_comm : Commute (wγ : P.Aut) σ := P.commute_of_mem_blockWeylSubgroup <|
    Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ hu)
      (Subgroup.subset_closure ⟨⟨i₀, hi₀⟩, rfl⟩)) hu
  have hu_comm : Commute (u : P.Aut) σ := P.commute_of_mem_blockWeylSubgroup hu
  refine ⟨⟨P.orbitSum σ (P.weylGroupToPerm wγ s), orbitSum_mem_foldedIndices P σ _⟩, Subtype.ext ?_⟩
  have hcor :
      ((Module.Dual.eval K (LinearMap.fixedSubmodule σ.weightMap)).flip
        (foldedCorootFun P σ γ)) (P.foldedRoot σ δ) = P.coroot' r (δ : M) := by
    simpa [coe_foldedRoot] using foldedCorootFun_eq_coroot' hσ horth hr (P.foldedRoot σ δ)
  rw [Module.preReflection_apply, hcor]
  simp only [Submodule.coe_sub, Submodule.coe_smul_of_tower, coe_foldedRoot]
  rw [← P.weylGroup_smul_orbitSum hwγ_comm s, h_s]
  symm
  have hu_fix : σ.weightMap (u • (δ : M)) = u • (δ : M) := by
    have hδ_fix : σ • (δ : M) = (δ : M) := h_s ▸ P.weightMap_orbitSum_self σ s
    change σ • ((u : P.Aut) • (δ : M)) = (u : P.Aut) • (δ : M)
    rw [← mul_smul, ← hu_comm.eq, mul_smul, hδ_fix]
  have hcor_u : P.coroot' i₀ (u • (δ : M)) = P.coroot' r (δ : M) := by
    rw [← hu_eq, weylGroupToPerm_apply]
    exact (u : P.Aut).coroot'_weightEquiv r (δ : M)
  have horb_u : u⁻¹ • P.orbitSum σ i₀ = (γ : M) := by
    have hperm : P.weylGroupToPerm u⁻¹ i₀ = r := by
      rw [← hu_eq, ← Equiv.Perm.mul_apply, ← map_mul, inv_mul_cancel, map_one,
        Equiv.Perm.one_apply]
    exact (P.weylGroup_smul_orbitSum (by simpa using hu_comm.inv_left) i₀).trans (by rw [hperm, hr])
  calc (δ : M) - P.coroot' r (δ : M) • (γ : M)
      = u⁻¹ • (u • (δ : M) - P.coroot' i₀ (u • (δ : M)) • P.orbitSum σ i₀) := by
        rw [smul_sub, inv_smul_smul, smul_comm, horb_u, hcor_u]
    _ = u⁻¹ • (P.blockReflection σ i₀ (horth i₀ hi₀) • (u • (δ : M))) := by
        rw [P.blockReflection_smul_of_weightMap_eq (horth i₀ hi₀) hu_fix]
    _ = wγ • (δ : M) := by simp [wγ, mul_smul]

private theorem exists_int_eq_foldedCorootFun {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (δ γ : P.foldedIndices σ) :
    ∃ z : ℤ, z = (Module.Dual.eval K (LinearMap.fixedSubmodule σ.weightMap))
      (P.foldedRoot σ δ) (foldedCorootFun P σ γ) := by
  obtain ⟨s, hs_eq⟩ := mem_foldedIndices.mp δ.property
  obtain ⟨r, hr_eq⟩ := mem_foldedIndices.mp γ.property
  refine ⟨∑ k ∈ P.orbitIndices σ s, P.pairingIn ℤ k r, ?_⟩
  dsimp only [Module.Dual.eval_apply]
  rw [foldedCorootFun_eq_coroot' hσ horth hr_eq, coe_foldedRoot, ← hs_eq, orbitSum_def,
    map_sum, Int.cast_sum]
  exact sum_congr rfl fun k _ ↦ by
    simpa only [eq_intCast, root_coroot'_eq_pairing] using P.algebraMap_pairingIn ℤ k r

private noncomputable def orthogonalPairing (b : P.Base) (σ : P.Aut)
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0) :
    RootPairing (P.foldedIndices σ) K (LinearMap.fixedSubmodule σ.weightMap)
      (Module.Dual K (LinearMap.fixedSubmodule σ.weightMap)) :=
  haveI : Module.Finite K M := Module.Finite.of_basis b.toWeightBasis
  RootPairing.mk'' (Module.Dual.eval K (LinearMap.fixedSubmodule σ.weightMap))
    ⟨P.foldedRoot σ, P.foldedRoot_injective σ⟩
    ⟨foldedCorootFun P σ, injective_foldedCorootFun P hσ horth⟩
    (foldedCorootFun_foldedRoot_self P hσ) (mapsTo_preReflection_foldedCorootFun P hσ horth)
    (span_range_foldedRoot_eq_top hσ)

private theorem isReduced_orthogonalPairing {b : P.Base} {σ : P.Aut}
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0) :
    (orthogonalPairing P b σ hσ horth).IsReduced := by
  let Q := orthogonalPairing P b σ hσ horth
  rw [isReduced_iff]
  intro γ₁ γ₂ hdep
  rw [LinearIndependent.pair_iff] at hdep
  push Not at hdep
  obtain ⟨a, d, had, hne0⟩ := hdep
  have ha : a ≠ 0 := fun ha0 ↦ by
    rw [ha0, zero_smul, zero_add] at had
    exact hne0 ha0 ((smul_eq_zero.mp had).resolve_right (Q.ne_zero γ₂))
  have hprop : Q.root γ₁ = (-a⁻¹ * d) • Q.root γ₂ := by
    calc Q.root γ₁ = a⁻¹ • (a • Q.root γ₁) := (inv_smul_smul₀ ha _).symm
      _ = a⁻¹ • (-(d • Q.root γ₂)) := by rw [eq_neg_of_add_eq_zero_left had]
      _ = (-a⁻¹ * d) • Q.root γ₂ := by rw [smul_neg, smul_smul, ← neg_smul, neg_mul]
  have hpropM : (γ₁ : M) = (-a⁻¹ * d) • (γ₂ : M) := by
    simpa [Q, orthogonalPairing, RootPairing.mk'', RootPairing.mk', coe_foldedRoot] using
      congrArg Subtype.val hprop
  obtain ⟨r₁, hr₁⟩ := mem_foldedIndices.mp γ₁.property
  obtain ⟨r₂, hr₂⟩ := mem_foldedIndices.mp γ₂.property
  rw [← hr₁, ← hr₂] at hpropM
  rcases P.eq_one_or_neg_one_of_orbitSum_eq_smul hσ horth hpropM with hc1 | hcn1
  · rw [hc1, one_smul] at hprop; exact .inl hprop
  · rw [hcn1, neg_one_smul] at hprop; exact .inr hprop

/-- **Construction of the orthogonal orbit-sum realization (Stembridge).** Let `P` be a finite
reduced crystallographic root system over a linearly ordered field `K`, `b` a base of `P`, and `σ`
a `b`-preserving automorphism whose simple orbits are orthogonal. Then the distinct orbit sums in
`E^σ` form a reduced crystallographic root system with base given by the simple-orbit sums. -/
noncomputable def OrbitSumRealization.orthogonal (b : P.Base) (σ : P.Aut)
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0) :
    P.OrbitSumRealization b σ :=
  let Q := orthogonalPairing P b σ hσ horth
  haveI : Module.Finite K M := Module.Finite.of_basis b.toWeightBasis
  haveI hCr : Q.IsCrystallographic := ⟨exists_int_eq_foldedCorootFun P hσ horth⟩
  haveI hRS : Q.IsRootSystem := isRootSystem_mk'' (exists_int_eq_foldedCorootFun P hσ horth)
  haveI hRed : Q.IsReduced := isReduced_orthogonalPairing P hσ horth
  { pairing := Q
    base := Base.mk' Q (P.simpleFoldedIndices b σ : Set (P.foldedIndices σ))
      (linearIndepOn_foldedRoot_simpleFoldedIndices hσ)
      (foldedRoot_mem_or_neg_mem_closure_simpleFoldedIndices hσ)
    rootSystem := hRS
    reduced := hRed
    crystallographic := hCr
    evaluation := fun _ _ ↦ rfl
    root_eq := fun γ ↦ P.coe_foldedRoot σ γ
    base_eq := fun γ ↦ by simp [Base.mk', mem_simpleFoldedIndices] }

/-- Over a linearly ordered field, simple-orbit orthogonality makes `P.OrbitSumRealization b σ`
nonempty. -/
theorem nonempty_orbitSumRealization_of_orthogonal (b : P.Base) (σ : P.Aut)
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0) :
    Nonempty (P.OrbitSumRealization b σ) :=
  ⟨OrbitSumRealization.orthogonal P b σ hσ horth⟩

variable {P} in
/-- **Unrestricted coroot formula on an orthogonal realization.** Over a linearly ordered field,
`F.pairing.coroot γ` restricts `P.coroot' r` to `E^σ` for *every* root `r` (not merely simple
ones) with orbit sum `γ`. -/
theorem OrbitSumRealization.coroot_apply {b : P.Base} {σ : P.Aut} (F : P.OrbitSumRealization b σ)
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    {γ : P.foldedIndices σ} {r : ι} (hr : P.orbitSum σ r = (γ : M))
    (x : LinearMap.fixedSubmodule σ.weightMap) :
    F.pairing.coroot γ x = P.coroot' r (x : M) :=
  F.coroot_apply_of_pairing_eq_zero
    (fun _ hj hrj ↦ orbit_pairing_eq_zero hσ horth r (self_mem_orbitIndices P σ r) hj hrj) hr x

variable {P} in
/-- **Unrestricted reflection formula on an orthogonal realization.** Over a linearly ordered field,
`F.pairing.reflection γ` restricts `P.blockReflection σ r` to `E^σ` for *every* root `r` with orbit
sum `γ`. -/
theorem OrbitSumRealization.reflection_apply {b : P.Base} {σ : P.Aut}
    (F : P.OrbitSumRealization b σ)
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    {γ : P.foldedIndices σ} {r : ι} (hr : P.orbitSum σ r = (γ : M))
    (x : LinearMap.fixedSubmodule σ.weightMap) :
    (F.pairing.reflection γ x : M) =
      P.blockReflection σ r
        (fun _ hj hrj ↦ orbit_pairing_eq_zero hσ horth r (self_mem_orbitIndices P σ r) hj hrj) •
        (x : M) :=
  F.reflection_apply_of_pairing_eq_zero _ hr x

variable {P} in
/-- **Unrestricted pairing formula on an orthogonal realization.** Over a linearly ordered field,
for any two folded roots `γ, δ` with lifts `r, s`, `F.pairing.pairing γ δ` sums `P.pairing i s`
over `i ∈ P.orbitIndices σ r`. -/
theorem OrbitSumRealization.pairing_eq_sum {b : P.Base} {σ : P.Aut} (F : P.OrbitSumRealization b σ)
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    {γ δ : P.foldedIndices σ} {r s : ι}
    (hγ : P.orbitSum σ r = (γ : M)) (hδ : P.orbitSum σ s = (δ : M)) :
    F.pairing.pairing γ δ = ∑ i ∈ P.orbitIndices σ r, P.pairing i s :=
  F.pairing_eq_sum_of_pairing_eq_zero
    (fun _ hj hsj ↦ orbit_pairing_eq_zero hσ horth s (self_mem_orbitIndices P σ s) hj hsj) hγ hδ

end RootFormAndConstruction

