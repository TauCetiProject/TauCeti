module

public import TauCeti.LinearAlgebra.RootSystem.CoweightLattice
public import TauCeti.LinearAlgebra.RootSystem.Weyl.Affine.Basic

/-!
# The extended affine Weyl group

Let `P` be a root pairing with coweight space `N`, Weyl group `W` (acting on `N` through the
coreflections), coroot lattice `Q∨ = P.corootSpan ℤ` and coweight lattice
`P∨ = P.coweightLattice`, the coweights at which every root takes an integer value. The affine
Weyl group `W_aff = Q∨ ⋊ W` (`RootPairing.affineWeylGroup`) is generated by the reflections in the
affine root hyperplanes. The **extended affine Weyl group** is

`W_ext = P∨ ⋊ W`,

the group of affine automorphisms of `N` whose linear part lies in `W` and whose translation part
lies in `P∨` (`RootPairing.extendedAffineWeylGroup`). This group is well defined because `W`
preserves `P∨`; in fact `W` moves each point of `P∨` by an element of the coroot lattice,
`w x - x ∈ Q∨` (`RootPairing.sub_mem_corootSpan_of_mem_closure_range_coreflection`, in
`TauCeti.LinearAlgebra.RootSystem.CoweightLattice`).

In general the main result is that `W_aff ∩ W_ext` is the kernel of the homomorphism

`W_ext → P∨ / (P∨ ∩ Q∨)`, `f ↦ f(0) mod Q∨`,

which is onto (the translations by `P∨` lie in `W_ext`). Thus `W_aff ∩ W_ext` is normal in
`W_ext`, with quotient `W_ext / (W_aff ∩ W_ext) ≃ P∨ / (P∨ ∩ Q∨)`
(`RootPairing.extendedAffineWeylGroupQuotientEquiv`). For a crystallographic pairing
`Q∨ ⊆ P∨`, so `W_aff ≤ W_ext` (`RootPairing.affineWeylGroup_le_extendedAffineWeylGroup`), and
this specializes to the classical statement: `W_aff` is normal in `W_ext`, with quotient
`W_ext / W_aff ≃ P∨ / Q∨`.

Classically, for a real irreducible reduced root system, `W_aff` acts simply transitively on the
alcoves, so this isomorphism restricts to one from the stabilizer of the fundamental alcove in
`W_ext` onto `P∨ / Q∨`; that step is not taken here.

Like `W_aff`, the group `W_ext` permutes the affine root hyperplanes `αⱼ = m`: each element carries
the affine function `αⱼ` to `αⱼ' + m` for a root `αⱼ'` and an integer `m`
(`RootPairing.exists_root'_apply_eq_add_intCast_of_mem_extendedAffineWeylGroup`). This needs no
crystallographic hypothesis, because the translations of `W_ext` are integral on the roots by
definition.

## Main definitions

* `RootPairing.extendedAffineWeylGroup`: the extended affine Weyl group `P∨ ⋊ W`.
* `RootPairing.extendedAffineWeylGroupToQuotient`: the homomorphism `W_ext → P∨ / (P∨ ∩ Q∨)`
  taking an element to the class of its translation part.
* `RootPairing.extendedAffineWeylGroupQuotientEquiv`: the isomorphism
  `W_ext / (W_aff ∩ W_ext) ≃ P∨ / (P∨ ∩ Q∨)`, which is `W_ext / W_aff ≃ P∨ / Q∨` for a
  crystallographic pairing.

## Main results

* `RootPairing.affineWeylGroup_le_extendedAffineWeylGroup`: for a crystallographic pairing,
  `W_aff ≤ W_ext`.
* `RootPairing.constVAdd_mem_extendedAffineWeylGroup_iff`: the translations in `W_ext` are the
  translations by the coweight lattice.
* `RootPairing.ker_extendedAffineWeylGroupToQuotient`: the kernel of `W_ext → P∨ / (P∨ ∩ Q∨)` is
  `W_aff ∩ W_ext`.
* `RootPairing.exists_root'_apply_eq_add_intCast_of_mem_extendedAffineWeylGroup`: `W_ext`
  permutes the affine roots.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Ch. VI, §2 (the group generated by
  `W` and the translations by `P(R∨)`, and its quotient by `W_a`, isomorphic to `P(R∨) / Q(R∨)`).
-/

public section

open Set Function

namespace RootPairing

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N]
  [Module R N] (P : RootPairing ι R M N)

/-! ### The extended affine Weyl group -/

/-- The **extended affine Weyl group** `P∨ ⋊ W` of a root pairing: the affine automorphisms of the
coweight space whose linear part lies in the group generated by the coreflections, the coweight
image of the Weyl group, and whose translation part `f 0` lies in the coweight lattice. -/
def extendedAffineWeylGroup : Subgroup (N ≃ᵃ[R] N) :=
  AffineEquiv.semidirectSubgroup (Subgroup.closure (range P.coreflection))
    P.coweightLattice.toAddSubgroup fun _ hw _ hv ↦
      P.mem_coweightLattice_of_mem_closure_range_coreflection hw hv

/-- **The extended affine Weyl group is `P∨ ⋊ W`.** An affine automorphism of the coweight space
lies in the extended affine Weyl group exactly when its linear part lies in the group generated by
the coreflections and its translation part `f 0` lies in the coweight lattice. -/
theorem mem_extendedAffineWeylGroup_iff {f : N ≃ᵃ[R] N} :
    f ∈ P.extendedAffineWeylGroup ↔
      f.linear ∈ Subgroup.closure (range P.coreflection) ∧ f 0 ∈ P.coweightLattice :=
  AffineEquiv.mem_semidirectSubgroup_iff

/-- The translations in the extended affine Weyl group are exactly the translations by the
coweight lattice. -/
@[simp]
theorem constVAdd_mem_extendedAffineWeylGroup_iff {v : N} :
    AffineEquiv.constVAdd R N v ∈ P.extendedAffineWeylGroup ↔ v ∈ P.coweightLattice := by
  rw [mem_extendedAffineWeylGroup_iff, AffineEquiv.linear_constVAdd]
  -- `LinearEquiv.refl R N` is the identity `1` of the group of linear automorphisms.
  exact ⟨fun h ↦ by simpa using h.2, fun hv ↦ ⟨one_mem _, by simpa using hv⟩⟩

/-- A linear automorphism of the coweight space in the group generated by the coreflections lies
in the extended affine Weyl group. -/
lemma toAffineEquiv_mem_extendedAffineWeylGroup {w : N ≃ₗ[R] N}
    (hw : w ∈ Subgroup.closure (range P.coreflection)) :
    w.toAffineEquiv ∈ P.extendedAffineWeylGroup :=
  P.mem_extendedAffineWeylGroup_iff.2 ⟨hw, by simp⟩

/-- The linear parts of the elements of the extended affine Weyl group form the group generated
by the coreflections, the coweight image of the Weyl group. -/
theorem map_linearHom_extendedAffineWeylGroup :
    P.extendedAffineWeylGroup.map AffineEquiv.linearHom =
      Subgroup.closure (range P.coreflection) := by
  ext w
  refine ⟨?_, fun hw ↦ ⟨w.toAffineEquiv, P.toAffineEquiv_mem_extendedAffineWeylGroup hw, rfl⟩⟩
  rintro ⟨f, hf, rfl⟩
  exact (P.mem_extendedAffineWeylGroup_iff.1 hf).1

/-- **The affine Weyl group lies in the extended affine Weyl group** of a crystallographic pairing,
because the coroot lattice lies in the coweight lattice. -/
theorem affineWeylGroup_le_extendedAffineWeylGroup [P.IsCrystallographic] :
    P.affineWeylGroup ≤ P.extendedAffineWeylGroup := fun _ hf ↦
  have hf := P.mem_affineWeylGroup_iff.mp hf
  P.mem_extendedAffineWeylGroup_iff.2 ⟨hf.1, P.corootSpan_le_coweightLattice hf.2⟩

/-- **The extended affine Weyl group permutes the affine roots.** An element `f` of the extended
affine Weyl group carries each root functional `αⱼ` to an affine function `αⱼ ∘ f = αⱼ' + m` with
`αⱼ'` a root functional and `m` an integer. -/
theorem exists_root'_apply_eq_add_intCast_of_mem_extendedAffineWeylGroup {f : N ≃ᵃ[R] N}
    (hf : f ∈ P.extendedAffineWeylGroup) (j : ι) :
    ∃ (j' : ι) (m : ℤ), ∀ x, P.root' j (f x) = P.root' j' x + m := by
  rw [mem_extendedAffineWeylGroup_iff] at hf
  obtain ⟨j', hj'⟩ := P.exists_root'_apply_eq_of_mem_closure_range_coreflection hf.1 j
  obtain ⟨m, hm⟩ := P.mem_coweightLattice.1 hf.2 j
  exact ⟨j', m, fun x ↦ by rw [AffineEquiv.apply_eq_linear_add f x, map_add, hj', hm]⟩

/-! ### The quotient by the affine Weyl group -/

/-- The homomorphism from the extended affine Weyl group to `P∨ / (P∨ ∩ Q∨)` taking an element to
the class of its translation part `f 0` modulo the coroot lattice; for a crystallographic pairing
the target is `P∨ / Q∨`. It is a homomorphism because the Weyl group acts trivially on this
quotient
(`RootPairing.sub_mem_corootSpan_of_mem_closure_range_coreflection`). -/
def extendedAffineWeylGroupToQuotient :
    P.extendedAffineWeylGroup →*
      Multiplicative (P.coweightLattice ⧸ (P.corootSpan ℤ).comap P.coweightLattice.subtype) where
  toFun f :=
    .ofAdd (Submodule.Quotient.mk ⟨f.1 0, (P.mem_extendedAffineWeylGroup_iff.1 f.2).2⟩)
  map_one' := by
    rw [← ofAdd_zero, ← Submodule.Quotient.mk_zero]
    simp
  map_mul' f g := by
    rw [← ofAdd_add, ← Submodule.Quotient.mk_add, Multiplicative.ofAdd.injective.eq_iff,
      Submodule.Quotient.eq]
    -- `(f g) 0 = f.linear (g 0) + f 0`, and `f.linear (g 0) - g 0` lies in the coroot lattice.
    have h := P.sub_mem_corootSpan_of_mem_closure_range_coreflection
      (P.mem_extendedAffineWeylGroup_iff.1 f.2).1 (P.mem_extendedAffineWeylGroup_iff.1 g.2).2
    rw [Submodule.mem_comap]
    simp only [Subgroup.coe_mul, AffineEquiv.coe_mul, comp_apply, Submodule.subtype_apply,
      Submodule.coe_sub, Submodule.coe_add]
    rw [AffineEquiv.apply_eq_linear_add f.1 (g.1 0)]
    convert h using 1
    abel

@[simp]
lemma extendedAffineWeylGroupToQuotient_apply (f : P.extendedAffineWeylGroup) :
    P.extendedAffineWeylGroupToQuotient f =
      .ofAdd (Submodule.Quotient.mk ⟨f.1 0, (P.mem_extendedAffineWeylGroup_iff.1 f.2).2⟩) :=
  (rfl)

/-- The homomorphism `W_ext → P∨ / (P∨ ∩ Q∨)` is onto: the class of `λ ∈ P∨` is the image of the
translation by `λ`. -/
theorem extendedAffineWeylGroupToQuotient_surjective :
    Surjective P.extendedAffineWeylGroupToQuotient := by
  intro q
  induction q using Multiplicative.rec with | ofAdd q => ?_
  induction q using Submodule.Quotient.induction_on with | H v => ?_
  refine ⟨⟨AffineEquiv.constVAdd R N v, by simp⟩, ?_⟩
  simp

/-- **The kernel of `W_ext → P∨ / (P∨ ∩ Q∨)` is `W_aff ∩ W_ext`**, the part of the affine Weyl
group `W_aff = Q∨ ⋊ W` lying in `W_ext`. For a crystallographic pairing `W_aff ≤ W_ext`, so the
kernel is the affine Weyl group itself. -/
theorem ker_extendedAffineWeylGroupToQuotient :
    P.extendedAffineWeylGroupToQuotient.ker =
      P.affineWeylGroup.subgroupOf P.extendedAffineWeylGroup := by
  ext f
  rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, P.mem_affineWeylGroup_iff,
    extendedAffineWeylGroupToQuotient_apply, ← ofAdd_zero, Multiplicative.ofAdd.injective.eq_iff,
    Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply]
  exact (and_iff_right (P.mem_extendedAffineWeylGroup_iff.1 f.2).1).symm

/-- **`W_aff ∩ W_ext` is normal in the extended affine Weyl group**, as the kernel of
`W_ext → P∨ / (P∨ ∩ Q∨)`. For a crystallographic pairing `W_aff ≤ W_ext`, so this says the affine
Weyl group is normal in the extended affine Weyl group. -/
instance normal_affineWeylGroup_subgroupOf_extendedAffineWeylGroup :
    (P.affineWeylGroup.subgroupOf P.extendedAffineWeylGroup).Normal :=
  P.ker_extendedAffineWeylGroupToQuotient ▸ MonoidHom.normal_ker _

/-- **`W_ext / (W_aff ∩ W_ext) ≃ P∨ / (P∨ ∩ Q∨)`.** The quotient of the extended affine Weyl
group by its intersection with the affine Weyl group is isomorphic to the quotient of the coweight
lattice by its intersection with the coroot lattice, through the class of the translation part.
For a crystallographic pairing this is the classical isomorphism `W_ext / W_aff ≃ P∨ / Q∨`. -/
noncomputable def extendedAffineWeylGroupQuotientEquiv :
    P.extendedAffineWeylGroup ⧸ P.affineWeylGroup.subgroupOf P.extendedAffineWeylGroup ≃*
      Multiplicative (P.coweightLattice ⧸ (P.corootSpan ℤ).comap P.coweightLattice.subtype) :=
  (QuotientGroup.quotientMulEquivOfEq P.ker_extendedAffineWeylGroupToQuotient.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective _ P.extendedAffineWeylGroupToQuotient_surjective)

@[simp]
lemma extendedAffineWeylGroupQuotientEquiv_mk (f : P.extendedAffineWeylGroup) :
    P.extendedAffineWeylGroupQuotientEquiv f = P.extendedAffineWeylGroupToQuotient f :=
  (rfl)

end RootPairing
