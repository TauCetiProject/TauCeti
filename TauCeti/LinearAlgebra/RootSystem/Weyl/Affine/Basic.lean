module

public import TauCeti.LinearAlgebra.AffineSpace.AffineEquiv
public import TauCeti.LinearAlgebra.RootSystem.Weyl.Group

/-!
# Affine reflections and the affine Weyl group

Let `P` be a root pairing with coweight space `N`. The roots are functionals `α(x) = ⟨α, x⟩` on
`N`, and for a root `αᵢ` and a scalar `c` the **affine reflection** in the affine root hyperplane
`H_{αᵢ,c} = {x | αᵢ(x) = c}` is

`s_{αᵢ,c}(x) = x - (αᵢ(x) - c) αᵢ^∨ = s_{αᵢ}(x) + c αᵢ^∨`,

the coreflection `s_{αᵢ} = RootPairing.coreflection` followed by the translation by `c αᵢ^∨`.
It fixes `H_{αᵢ,c}` pointwise, and it is an involution with linear part `s_{αᵢ}`. Two parallel
affine reflections compose to a translation, `s_{αᵢ,c} s_{αᵢ,d} = t_{(c - d) αᵢ^∨}`.

The **affine Weyl group** `W_aff` is the group of affine automorphisms of `N` generated by the
affine reflections `s_{αᵢ,k}` with `k` an integer, the reflections in the affine root hyperplanes
`αᵢ = k` (for a real root system these are the walls of the alcoves; see
`RootPairing.fundamentalAlcove`).
It is the semidirect product `Q^∨ ⋊ W` of the coroot lattice `Q^∨ = P.corootSpan ℤ` and the Weyl
group `W`, realised on `N` by the coreflections, in the following concrete sense. An affine
automorphism `f` lies in `W_aff` exactly when its linear part lies in the group generated by the
coreflections and its translation part `f 0` lies in `Q^∨`
(`RootPairing.mem_affineWeylGroup_iff`). Consequently the linear parts of
`W_aff` form the group generated by the coreflections
(`RootPairing.map_linearHom_affineWeylGroup`), which is the coweight image of the Weyl group by
`RootPairing.range_weylGroup_coweightHom`; the translations in `W_aff` are exactly the
translations by `Q^∨` (`RootPairing.constVAdd_mem_affineWeylGroup_iff`); and every linear
automorphism generated by the coreflections lies in `W_aff`
(`RootPairing.toAffineEquiv_mem_affineWeylGroup`), so that the two pieces split.

For a crystallographic pairing, `W_aff` permutes the affine roots: an element of `W_aff` carries
each affine function `αⱼ - m` to another one `αⱼ' - m'`
(`RootPairing.exists_root'_apply_eq_add_intCast_of_mem_affineWeylGroup`). In particular it
preserves the complement of the affine root hyperplanes (for a real root system, the union of the
open alcoves).

Everything is proved for an arbitrary root pairing over a commutative ring, with no finiteness,
reducedness or ordering hypothesis, with two exceptions. The fixed-point characterization of an
affine reflection needs `NoZeroDivisors R` and `NeZero (2 : R)`, so that `2` can be cancelled, and
the hyperplane statements need the pairing to be crystallographic, so that the affine root
hyperplanes are moved by integer amounts.

## Main definitions

* `RootPairing.affineCoreflection`: the affine reflection in the hyperplane `αᵢ = c` of the
  coweight space.
* `RootPairing.affineWeylGroup`: the affine Weyl group, generated by the affine reflections in the
  hyperplanes `αᵢ = k` with `k` an integer.

## Main results

* `RootPairing.affineCoreflection_apply_eq_self_iff`: if `R` has no zero divisors and `2 ≠ 0` in
  `R`, the fixed points of `s_{αᵢ,c}` are the hyperplane `αᵢ = c`.
* `RootPairing.affineCoreflection_mul_affineCoreflection`: two parallel affine reflections
  compose to a translation by a multiple of the coroot.
* `RootPairing.root'_affineCoreflection`: how a root functional changes under an affine
  reflection; `RootPairing.root'_affineCoreflection_intCast` is its integer form for a
  crystallographic pairing and an integer shift.
* `RootPairing.mem_affineWeylGroup_iff`: **`W_aff = Q^∨ ⋊ W`**: an affine automorphism lies in the
  affine Weyl group exactly when its linear part is generated by the coreflections and its
  translation part lies in the coroot lattice.
* `RootPairing.map_linearHom_affineWeylGroup`: the linear parts of the affine Weyl group form the
  group generated by the coreflections.
* `RootPairing.constVAdd_mem_affineWeylGroup_iff`: the translations in the affine Weyl group are
  the translations by the coroot lattice.
* `RootPairing.exists_root'_apply_eq_add_intCast_of_mem_affineWeylGroup` and
  `RootPairing.root'_apply_ne_intCast_of_mem_affineWeylGroup`: for a crystallographic pairing the
  affine Weyl group permutes the affine roots, and preserves the set of points lying on no affine
  root hyperplane.
* `RootPairing.intCast_lt_root'_apply_iff_of_mem_affineWeylGroup`: over an ordered ring, the
  affine Weyl group preserves the relation of lying on the same side of each affine root
  hyperplane.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Ch. VI, §2.1 (the affine Weyl group
  `W_a` and its semidirect product decomposition).
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge Studies in Advanced
  Mathematics 29, §4.1–§4.2.
-/

public section

open Set Function

namespace RootPairing

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N]
  [Module R N] (P : RootPairing ι R M N)

/-! ### Affine reflections -/

/-- The **affine reflection** `s_{αᵢ,c}` of the coweight space in the affine root hyperplane
`{x | αᵢ(x) = c}`: the coreflection `s_{αᵢ}` followed by the translation by `c αᵢ^∨`, so that
`s_{αᵢ,c}(x) = x - (αᵢ(x) - c) αᵢ^∨`. -/
def affineCoreflection (i : ι) (c : R) : N ≃ᵃ[R] N :=
  (P.coreflection i).toAffineEquiv.trans (AffineEquiv.constVAdd R N (c • P.coroot i))

lemma affineCoreflection_apply (i : ι) (c : R) (x : N) :
    P.affineCoreflection i c x = P.coreflection i x + c • P.coroot i := by
  simp [affineCoreflection, add_comm]

lemma affineCoreflection_apply_eq_sub (i : ι) (c : R) (x : N) :
    P.affineCoreflection i c x = x - (P.root' i x - c) • P.coroot i := by
  rw [affineCoreflection_apply, coreflection_apply, sub_smul]
  abel

@[simp]
lemma linear_affineCoreflection (i : ι) (c : R) :
    (P.affineCoreflection i c).linear = P.coreflection i :=
  (rfl)

/-- The affine reflection in a hyperplane through the origin is the coreflection. -/
@[simp]
lemma affineCoreflection_zero (i : ι) :
    P.affineCoreflection i 0 = (P.coreflection i).toAffineEquiv := by
  ext x
  simp [affineCoreflection_apply]

/-- An affine reflection fixes its hyperplane pointwise. -/
lemma affineCoreflection_apply_of_root'_eq {i : ι} {c : R} {x : N} (h : P.root' i x = c) :
    P.affineCoreflection i c x = x := by
  rw [affineCoreflection_apply_eq_sub, h, sub_self, zero_smul, sub_zero]

@[simp]
lemma affineCoreflection_affineCoreflection (i : ι) (c : R) (x : N) :
    P.affineCoreflection i c (P.affineCoreflection i c x) = x := by
  simp [affineCoreflection_apply, add_assoc]

@[simp]
lemma affineCoreflection_mul_self (i : ι) (c : R) :
    P.affineCoreflection i c * P.affineCoreflection i c = 1 := by
  ext x
  simp

@[simp]
lemma inv_affineCoreflection (i : ι) (c : R) :
    (P.affineCoreflection i c)⁻¹ = P.affineCoreflection i c :=
  inv_eq_of_mul_eq_one_right (P.affineCoreflection_mul_self i c)

@[simp]
lemma symm_affineCoreflection (i : ι) (c : R) :
    (P.affineCoreflection i c).symm = P.affineCoreflection i c :=
  P.inv_affineCoreflection i c

/-- Two parallel affine reflections compose to a translation by a multiple of the coroot:
`s_{αᵢ,c} s_{αᵢ,d} = t_{(c - d) αᵢ^∨}`. -/
lemma affineCoreflection_mul_affineCoreflection (i : ι) (c d : R) :
    P.affineCoreflection i c * P.affineCoreflection i d =
      AffineEquiv.constVAdd R N ((c - d) • P.coroot i) := by
  ext x
  simp only [AffineEquiv.coe_mul, comp_apply, affineCoreflection_apply, map_add, map_smul,
    coreflection_same, coreflection_apply_self, AffineEquiv.constVAdd_apply, vadd_eq_add, smul_neg,
    sub_smul]
  abel

/-- The value of a root functional at the image of a point under an affine reflection:
`αⱼ(s_{αᵢ,c}(x)) = (s_{αᵢ} αⱼ)(x) + ⟨αⱼ, αᵢ^∨⟩ c`. -/
lemma root'_affineCoreflection (i j : ι) (c : R) (x : N) :
    P.root' j (P.affineCoreflection i c x) =
      P.root' (P.reflectionPerm i j) x + P.pairing j i * c := by
  simp only [affineCoreflection_apply, map_add, map_smul, coreflection_apply, map_sub, root',
    ← root_coroot_eq_pairing, root_reflectionPerm, reflection_apply, LinearMap.sub_apply,
    LinearMap.smul_apply, smul_eq_mul, coroot', LinearMap.flip_apply]
  ring

/-- For a crystallographic pairing, `root'_affineCoreflection` with an integer shift `c`, the
pairing written through `pairingIn ℤ`:
`αⱼ(s_{αᵢ,c}(x)) = (s_{αᵢ} αⱼ)(x) + ⟨αⱼ, αᵢ^∨⟩ c` with `⟨αⱼ, αᵢ^∨⟩ c` an integer. -/
lemma root'_affineCoreflection_intCast [P.IsCrystallographic] (i j : ι) (c : ℤ) (x : N) :
    P.root' j (P.affineCoreflection i c x) =
      P.root' (P.reflectionPerm i j) x + ((P.pairingIn ℤ j i * c : ℤ) : R) := by
  rw [root'_affineCoreflection, ← P.algebraMap_pairingIn ℤ, algebraMap_int_eq, eq_intCast,
    Int.cast_mul]

@[simp]
lemma root'_affineCoreflection_self (i : ι) (c : R) (x : N) :
    P.root' i (P.affineCoreflection i c x) = 2 * c - P.root' i x := by
  simp only [affineCoreflection_apply, coreflection_apply, map_add, map_sub, map_smul,
    root'_coroot_eq_pairing, pairing_same, smul_eq_mul]
  ring

/-- If `R` has no zero divisors and `2 ≠ 0` in `R`, the fixed points of the affine reflection
`s_{αᵢ,c}` are exactly the points of the hyperplane `αᵢ = c`. -/
@[simp]
lemma affineCoreflection_apply_eq_self_iff [NoZeroDivisors R] [NeZero (2 : R)] {i : ι} {c : R}
    {x : N} : P.affineCoreflection i c x = x ↔ P.root' i x = c := by
  refine ⟨fun h ↦ ?_, P.affineCoreflection_apply_of_root'_eq⟩
  have h' := congrArg (P.root' i) h
  rw [root'_affineCoreflection_self] at h'
  have h2 : (2 : R) * (P.root' i x - c) = 0 := by linear_combination -h'
  exact sub_eq_zero.mp ((mul_eq_zero.mp h2).resolve_left two_ne_zero)

/-! ### The affine Weyl group -/

/-- The **affine Weyl group** of a root pairing: the group of affine automorphisms of the
coweight space generated by the affine reflections `s_{αᵢ,k}` in the hyperplanes `αᵢ = k`, for
`k` an integer. It is `Q^∨ ⋊ W` (`RootPairing.mem_affineWeylGroup_iff`). -/
def affineWeylGroup : Subgroup (N ≃ᵃ[R] N) :=
  Subgroup.closure (range fun p : ι × ℤ ↦ P.affineCoreflection p.1 p.2)

@[simp]
lemma affineCoreflection_mem_affineWeylGroup (i : ι) (k : ℤ) :
    P.affineCoreflection i k ∈ P.affineWeylGroup :=
  Subgroup.subset_closure ⟨(i, k), rfl⟩

/-- The translation by a coroot lies in the affine Weyl group: it is `s_{αᵢ,1} s_{αᵢ,0}`. -/
lemma constVAdd_coroot_mem_affineWeylGroup (i : ι) :
    AffineEquiv.constVAdd R N (P.coroot i) ∈ P.affineWeylGroup := by
  have h := mul_mem (P.affineCoreflection_mem_affineWeylGroup i 1)
    (P.affineCoreflection_mem_affineWeylGroup i 0)
  rwa [affineCoreflection_mul_affineCoreflection, Int.cast_one, Int.cast_zero, sub_zero,
    one_smul] at h

/-- The translation by an element of the coroot lattice lies in the affine Weyl group. -/
lemma constVAdd_mem_affineWeylGroup {v : N} (hv : v ∈ P.corootSpan ℤ) :
    AffineEquiv.constVAdd R N v ∈ P.affineWeylGroup := by
  induction hv using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact P.constVAdd_coroot_mem_affineWeylGroup i
  | zero =>
    rw [AffineEquiv.constVAdd_zero, ← AffineEquiv.one_def]
    exact one_mem _
  | add x y _ _ hx hy =>
    rw [AffineEquiv.constVAdd_add]
    exact mul_mem hx hy
  | smul z x _ hx =>
    rw [AffineEquiv.constVAdd_zsmul]
    exact zpow_mem hx z

/-- A linear automorphism of the coweight space in the group generated by the coreflections, that
is, in the coweight image of the Weyl group, lies in the affine Weyl group. -/
lemma toAffineEquiv_mem_affineWeylGroup {w : N ≃ₗ[R] N}
    (hw : w ∈ Subgroup.closure (range P.coreflection)) :
    w.toAffineEquiv ∈ P.affineWeylGroup := by
  induction hw using Subgroup.closure_induction'' with
  | mem w hw =>
    obtain ⟨i, rfl⟩ := hw
    simpa using P.affineCoreflection_mem_affineWeylGroup i 0
  | inv_mem w hw =>
    obtain ⟨i, rfl⟩ := hw
    simpa using P.affineCoreflection_mem_affineWeylGroup i 0
  -- `LinearEquiv.toAffineEquiv` sends `1` and `w₁ * w₂` to `1` and the product by definition.
  | one => exact one_mem _
  | mul w₁ w₂ _ _ h₁ h₂ => exact mul_mem h₁ h₂

/-- **The affine Weyl group is `Q^∨ ⋊ W`.** An affine automorphism of the coweight space lies in
the affine Weyl group exactly when its linear part lies in the group generated by the
coreflections, the coweight image of the Weyl group, and its translation part `f 0` lies in the
coroot lattice. -/
theorem mem_affineWeylGroup_iff {f : N ≃ᵃ[R] N} :
    f ∈ P.affineWeylGroup ↔
      f.linear ∈ Subgroup.closure (range P.coreflection) ∧ f 0 ∈ P.corootSpan ℤ := by
  constructor
  · intro hf
    let S : Subgroup (N ≃ᵃ[R] N) :=
      AffineEquiv.semidirectSubgroup (Subgroup.closure (range P.coreflection))
        (P.corootSpan ℤ).toAddSubgroup fun _ hw _ hv ↦
          P.mem_corootSpan_of_mem_closure_range_coreflection hw hv
    refine AffineEquiv.mem_semidirectSubgroup_iff.mp ((Subgroup.closure_le S).mpr ?_ hf)
    rintro _ ⟨⟨i, k⟩, rfl⟩
    refine AffineEquiv.mem_semidirectSubgroup_iff.mpr
      ⟨by simpa using Subgroup.subset_closure (mem_range_self i), ?_⟩
    rw [affineCoreflection_apply, map_zero, zero_add, Int.cast_smul_eq_zsmul]
    exact Submodule.smul_mem _ k (Submodule.subset_span (mem_range_self i))
  · rintro ⟨hl, h0⟩
    have hf : f = AffineEquiv.constVAdd R N (f 0) * f.linear.toAffineEquiv := by
      ext x
      simpa [add_comm] using AffineEquiv.apply_eq_linear_add f x
    rw [hf]
    exact mul_mem (P.constVAdd_mem_affineWeylGroup h0) (P.toAffineEquiv_mem_affineWeylGroup hl)

/-- The linear parts of the elements of the affine Weyl group form the group generated by the
coreflections, the coweight image of the Weyl group. -/
theorem map_linearHom_affineWeylGroup :
    P.affineWeylGroup.map AffineEquiv.linearHom = Subgroup.closure (range P.coreflection) := by
  ext w
  refine ⟨?_, fun hw ↦ ⟨w.toAffineEquiv, P.toAffineEquiv_mem_affineWeylGroup hw, rfl⟩⟩
  rintro ⟨f, hf, rfl⟩
  exact (P.mem_affineWeylGroup_iff.mp hf).1

/-- The translations in the affine Weyl group are exactly the translations by the coroot
lattice. -/
@[simp]
theorem constVAdd_mem_affineWeylGroup_iff {v : N} :
    AffineEquiv.constVAdd R N v ∈ P.affineWeylGroup ↔ v ∈ P.corootSpan ℤ :=
  ⟨fun h ↦ by simpa using (P.mem_affineWeylGroup_iff.mp h).2, P.constVAdd_mem_affineWeylGroup⟩

/-! ### The affine Weyl group permutes the affine roots -/

/-- **The affine Weyl group permutes the affine roots.** For a crystallographic pairing, an element
`f` of the affine Weyl group carries each root functional `αⱼ` to an affine function
`αⱼ ∘ f = αⱼ' + m` with `αⱼ'` a root functional and `m` an integer. -/
theorem exists_root'_apply_eq_add_intCast_of_mem_affineWeylGroup [P.IsCrystallographic]
    {f : N ≃ᵃ[R] N} (hf : f ∈ P.affineWeylGroup) (j : ι) :
    ∃ (j' : ι) (m : ℤ), ∀ x, P.root' j (f x) = P.root' j' x + m := by
  obtain ⟨hl, h0⟩ := P.mem_affineWeylGroup_iff.mp hf
  obtain ⟨j', hj'⟩ := P.exists_root'_apply_eq_of_mem_closure_range_coreflection hl j
  obtain ⟨m, hm⟩ := P.root'_apply_apply_mem_of_mem_span ℤ h0 j
  refine ⟨j', m, fun x ↦ ?_⟩
  rw [AffineEquiv.apply_eq_linear_add f x, map_add, hj', ← hm]
  simp

/-- For a crystallographic pairing, the affine Weyl group preserves the set of points lying on no
affine root hyperplane `αⱼ = m` (for a real root system, the union of the open alcoves). -/
theorem root'_apply_ne_intCast_of_mem_affineWeylGroup [P.IsCrystallographic]
    {f : N ≃ᵃ[R] N} (hf : f ∈ P.affineWeylGroup) {x : N}
    (hx : ∀ (j : ι) (m : ℤ), P.root' j x ≠ m) (j : ι) (m : ℤ) : P.root' j (f x) ≠ m := by
  obtain ⟨j', m', h⟩ := P.exists_root'_apply_eq_add_intCast_of_mem_affineWeylGroup hf j
  intro h'
  exact hx j' (m - m') (by push_cast; linear_combination (h x).symm.trans h')

/-- For a crystallographic pairing over an ordered ring, the affine Weyl group preserves the
relation of lying on the same side of each affine root hyperplane `αⱼ = m`: if `x` and `y` are on
the same side of every such hyperplane, so are `f x` and `f y`. -/
theorem intCast_lt_root'_apply_iff_of_mem_affineWeylGroup [PartialOrder R] [IsOrderedAddMonoid R]
    [P.IsCrystallographic] {f : N ≃ᵃ[R] N} (hf : f ∈ P.affineWeylGroup) {x y : N}
    (h : ∀ (j : ι) (m : ℤ), (m : R) < P.root' j y ↔ (m : R) < P.root' j x) (j : ι) (m : ℤ) :
    (m : R) < P.root' j (f y) ↔ (m : R) < P.root' j (f x) := by
  obtain ⟨j', m', hm⟩ := P.exists_root'_apply_eq_add_intCast_of_mem_affineWeylGroup hf j
  simpa only [hm, Int.cast_sub, sub_lt_iff_lt_add] using h j' (m - m')

end RootPairing
