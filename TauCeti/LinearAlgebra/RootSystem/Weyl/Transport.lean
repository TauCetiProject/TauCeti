module

public import TauCeti.LinearAlgebra.RootSystem.Isomorphism
public import TauCeti.LinearAlgebra.RootSystem.Weyl.Group

/-!
# Transporting the Weyl group along an equivalence of root pairings

An equivalence `e : P.Equiv Q` of root pairings conjugates automorphisms of `P` into automorphisms
of `Q`, and that conjugation carries reflections to reflections: the reflection in the root `i`
goes to the reflection in the root `e.indexEquiv i`. Since `RootPairing.weylGroup` is by definition
the subgroup of `RootPairing.Aut` generated by the reflections, conjugation maps it *onto* the Weyl
group of `Q`, and therefore restricts to a group isomorphism of Weyl groups.

This is what lets a Weyl-group computation performed on one root system be read off on any
isomorphic one. Combined with the rigidity half of the Cartan--Killing classification
(`TauCeti.nonempty_equiv_of_hasCartanType`) it says that the Weyl group is an invariant of the
Dynkin type alone, so the Weyl group of an abstract root system of type `t` may be identified by
computing it on one pinned model of type `t`.

Nothing here needs the index sets, the weight spaces or the coweight spaces of the two pairings to
agree: `e.indexEquiv` transports indices, `e.weightEquiv` transports weight vectors, and the
isomorphism of Weyl groups is compatible with both. Mathlib has the automorphism group, the
reflections in it and the Weyl group as its closure, but no transport of any of them along an
equivalence; the transport built here is genuinely between different pairings, unlike the
`subst`-style transport along an *equality* of root data that
`TauCeti/Algebra/AlgebraicGroup/GeneralLinear/Root/WeylGroup.lean` uses privately.

## Main definitions

* `RootPairing.Equiv.autCongr`: conjugation by an equivalence, as a group isomorphism
  `P.Aut ≃* Q.Aut`.
* `RootPairing.Equiv.weylGroupEquiv`: its restriction, a group isomorphism
  `P.weylGroup ≃* Q.weylGroup`.

## Main results

* `RootPairing.Equiv.self_comp_symm` and `RootPairing.Equiv.symm_comp_self`: an equivalence of root
  pairings composes with its inverse to the identity, in both orders; `RootPairing.Equiv.symm_id`
  and `RootPairing.Equiv.symm_comp` compute the inverse of an identity and of a composite, and
  `RootPairing.Equiv.weightEquiv_comp` and `RootPairing.Equiv.coweightEquiv_comp` the weight and
  coweight equivalences of a composite.
* `RootPairing.Equiv.autCongr_reflection`: conjugation carries the reflection in the root `i` to
  the reflection in the root `e.indexEquiv i`.
* `RootPairing.Equiv.map_weylGroup`: conjugation maps the Weyl group of `P` onto that of `Q`.
* `RootPairing.Equiv.weylGroupEquiv_ofIdx`: the isomorphism of Weyl groups matches up simple
  reflections along `e.indexEquiv`.
* `RootPairing.Equiv.weylGroupToPerm_weylGroupEquiv`: it is equivariant for the permutation
  actions on root indices, and `RootPairing.Equiv.weylGroupEquiv_smul` for the actions on weight
  vectors.
* `RootPairing.Equiv.autCongr_id`, `RootPairing.Equiv.autCongr_comp`,
  `RootPairing.Equiv.weylGroupEquiv_id` and `RootPairing.Equiv.weylGroupEquiv_comp`: both
  constructions are functorial.
* `RootPairing.Equiv.natCard_weylGroup_eq` and `RootPairing.Equiv.finite_weylGroup`: isomorphic
  root pairings have Weyl groups of equal cardinality, and finiteness transports.
* `TauCeti.nonempty_weylGroup_mulEquiv_of_hasCartanType`: **two root systems carrying bases of the
  same Cartan type have isomorphic Weyl groups.**

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4--6*, Ch. VI, §1.
* [Root systems roadmap](https://github.com/TauCetiProject/TauCetiRoadmap/blob/main/TauCetiRoadmap/RepresentationTheory/RootSystems/README.md)
-/

public section

open Function Set

namespace TauCeti

variable {ι ι₂ ι₃ R M N M₂ N₂ M₃ N₃ : Type*} [CommRing R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  [AddCommGroup M₂] [Module R M₂] [AddCommGroup N₂] [Module R N₂]
  [AddCommGroup M₃] [Module R M₃] [AddCommGroup N₃] [Module R N₃]

noncomputable section

variable {P : RootPairing ι R M N} {Q : RootPairing ι₂ R M₂ N₂} {S : RootPairing ι₃ R M₃ N₃}

open RootPairing (Aut weylGroup weylGroupToPerm)
open RootPairing.Equiv (reflection weightEquiv)

/-- An equivalence of root pairings composed with its inverse is the identity of the target. -/
@[simp]
theorem _root_.RootPairing.Equiv.self_comp_symm (e : P.Equiv Q) :
    RootPairing.Equiv.comp e (RootPairing.Equiv.symm P Q e) = RootPairing.Equiv.id Q := by
  ext x <;> simp

/-- The inverse of an equivalence of root pairings composed with it is the identity of the
source. -/
@[simp]
theorem _root_.RootPairing.Equiv.symm_comp_self (e : P.Equiv Q) :
    RootPairing.Equiv.comp (RootPairing.Equiv.symm P Q e) e = RootPairing.Equiv.id P := by
  ext x <;> simp

/-- The weight-space equivalence of the identity equivalence is the identity. -/
theorem _root_.RootPairing.Equiv.weightEquiv_id :
    weightEquiv (RootPairing.Equiv.id P) = LinearEquiv.refl R M :=
  LinearEquiv.ext fun _ ↦ rfl

/-- The coweight-space equivalence of the identity equivalence is the identity. -/
theorem _root_.RootPairing.Equiv.coweightEquiv_id :
    RootPairing.Equiv.coweightEquiv (RootPairing.Equiv.id P) = LinearEquiv.refl R N :=
  LinearEquiv.ext fun _ ↦ rfl

/-- The weight-space equivalence of a composite is the composite of the weight-space
equivalences. Mathlib records this only for endomorphisms of a single root pairing, as
`RootPairing.Equiv.weightEquiv_comp_toLin`. -/
theorem _root_.RootPairing.Equiv.weightEquiv_comp (e : P.Equiv Q) (f : Q.Equiv S) :
    weightEquiv (RootPairing.Equiv.comp f e) = e.weightEquiv ≪≫ₗ f.weightEquiv :=
  LinearEquiv.ext fun _ ↦ rfl

/-- The coweight-space equivalence of a composite is the composite of the coweight-space
equivalences, in the reverse order. -/
theorem _root_.RootPairing.Equiv.coweightEquiv_comp (e : P.Equiv Q) (f : Q.Equiv S) :
    RootPairing.Equiv.coweightEquiv (RootPairing.Equiv.comp f e) =
      f.coweightEquiv ≪≫ₗ e.coweightEquiv :=
  LinearEquiv.ext fun _ ↦ rfl

/-- The identity equivalence of a root pairing is its own inverse. -/
@[simp]
theorem _root_.RootPairing.Equiv.symm_id :
    RootPairing.Equiv.symm P P (RootPairing.Equiv.id P) = RootPairing.Equiv.id P := by
  ext x <;>
    simp [RootPairing.Equiv.weightEquiv_id, RootPairing.Equiv.coweightEquiv_id]

/-- The inverse of a composite of equivalences is the composite of the inverses, in the reverse
order. -/
@[simp]
theorem _root_.RootPairing.Equiv.symm_comp (e : P.Equiv Q) (f : Q.Equiv S) :
    RootPairing.Equiv.symm P S (RootPairing.Equiv.comp f e) =
      RootPairing.Equiv.comp (RootPairing.Equiv.symm P Q e) (RootPairing.Equiv.symm Q S f) := by
  ext x <;>
    simp [RootPairing.Equiv.weightEquiv_comp, RootPairing.Equiv.coweightEquiv_comp]

/-- **Conjugation by an equivalence of root pairings**, as a group isomorphism of automorphism
groups: an automorphism `g` of `P` is carried to `e ∘ g ∘ e⁻¹`. -/
def _root_.RootPairing.Equiv.autCongr (e : P.Equiv Q) : Aut P ≃* Aut Q where
  toFun g := .comp e (.comp g (.symm P Q e))
  invFun h := .comp (.symm P Q e) (.comp h e)
  left_inv g := by ext x <;> simp
  right_inv h := by ext x <;> simp
  map_mul' g₁ g₂ := by ext x <;> simp

theorem _root_.RootPairing.Equiv.autCongr_apply (e : P.Equiv Q) (g : Aut P) :
    e.autCongr g = .comp e (.comp g (.symm P Q e)) :=
  (rfl)

theorem _root_.RootPairing.Equiv.autCongr_symm_apply (e : P.Equiv Q) (h : Aut Q) :
    e.autCongr.symm h = .comp (.symm P Q e) (.comp h e) :=
  (rfl)

/-- The weight-space map of a conjugated automorphism is the conjugated weight-space map.

Not a `simp` lemma: `RootPairing.Equiv.weightEquiv_apply` rewrites the left-hand side to the
underlying `weightMap`, so the statement is not in `simp`-normal form. The intended interface is
`RootPairing.Equiv.autCongr_smul`, which is stated for the weight-space action. -/
theorem _root_.RootPairing.Equiv.weightEquiv_autCongr_apply (e : P.Equiv Q) (g : Aut P) (x : M₂) :
    weightEquiv (e.autCongr g) x = e.weightEquiv (g.weightEquiv (e.weightEquiv.symm x)) :=
  (rfl)

/-- The index permutation of a conjugated automorphism is the conjugated index permutation. -/
@[simp]
theorem _root_.RootPairing.Equiv.indexEquiv_autCongr_apply (e : P.Equiv Q) (g : Aut P) (i : ι₂) :
    (e.autCongr g).indexEquiv i = e.indexEquiv (g.indexEquiv (e.indexEquiv.symm i)) :=
  (rfl)

/-- Conjugation transports the action on weight vectors along `e.weightEquiv`. -/
theorem _root_.RootPairing.Equiv.autCongr_smul (e : P.Equiv Q) (g : Aut P) (x : M) :
    e.autCongr g • e.weightEquiv x = e.weightEquiv (g • x) := by
  have h : e.autCongr g • e.weightEquiv x = weightEquiv (e.autCongr g) (e.weightEquiv x) := (rfl)
  have h' : g • x = g.weightEquiv x := (rfl)
  rw [h, h', RootPairing.Equiv.weightEquiv_autCongr_apply, LinearEquiv.symm_apply_apply]

/-- Conjugation transports the action on root indices along `e.indexEquiv`. -/
theorem _root_.RootPairing.Equiv.autCongr_smul_index (e : P.Equiv Q) (g : Aut P) (i : ι) :
    e.autCongr g • e.indexEquiv i = e.indexEquiv (g • i) := by
  have h : e.autCongr g • e.indexEquiv i = (e.autCongr g).indexEquiv (e.indexEquiv i) := (rfl)
  have h' : g • i = g.indexEquiv i := (rfl)
  rw [h, h', RootPairing.Equiv.indexEquiv_autCongr_apply, Equiv.symm_apply_apply]

/-- **Conjugation carries reflections to reflections**: the reflection in the root `i` goes to the
reflection in the root `e.indexEquiv i`. -/
@[simp]
theorem _root_.RootPairing.Equiv.autCongr_reflection (e : P.Equiv Q) (i : ι) :
    e.autCongr (reflection P i) = reflection Q (e.indexEquiv i) := by
  refine RootPairing.Equiv.weightHom_injective Q (LinearEquiv.ext fun x ↦ ?_)
  obtain ⟨y, rfl⟩ := e.weightEquiv.surjective x
  simp only [RootPairing.Equiv.weightHom_apply, RootPairing.Equiv.weightEquiv_autCongr_apply,
    RootPairing.Equiv.reflection_weightEquiv, LinearEquiv.symm_apply_apply]
  exact e.weightEquiv_reflection i y

/-- Conjugation carries the range of the reflections of `P` onto the range of the reflections
of `Q`. -/
private theorem image_range_reflection (e : P.Equiv Q) :
    (e.autCongr : Aut P →* Aut Q) '' range (reflection P) = range (reflection Q) := by
  have h : ((e.autCongr : Aut P →* Aut Q) ∘ reflection P) = reflection Q ∘ e.indexEquiv :=
    funext fun i ↦ e.autCongr_reflection i
  rw [← Set.range_comp, h, e.indexEquiv.surjective.range_comp]

/-- **Conjugation maps the Weyl group of `P` onto the Weyl group of `Q`.** -/
theorem _root_.RootPairing.Equiv.map_weylGroup (e : P.Equiv Q) :
    (weylGroup P).map (e.autCongr : Aut P →* Aut Q) = weylGroup Q := by
  rw [RootPairing.weylGroup, MonoidHom.map_closure, image_range_reflection e,
    RootPairing.weylGroup]

/-- **The Weyl group transported along an equivalence of root pairings.** Conjugation by `e`
restricts to a group isomorphism of Weyl groups. -/
def _root_.RootPairing.Equiv.weylGroupEquiv (e : P.Equiv Q) : weylGroup P ≃* weylGroup Q :=
  (MulEquiv.subgroupMap e.autCongr (weylGroup P)).trans
    (MulEquiv.subgroupCongr e.map_weylGroup)

@[simp]
theorem _root_.RootPairing.Equiv.coe_weylGroupEquiv (e : P.Equiv Q) (w : weylGroup P) :
    (e.weylGroupEquiv w : Aut Q) = e.autCongr (w : Aut P) :=
  (rfl)

@[simp]
theorem _root_.RootPairing.Equiv.coe_weylGroupEquiv_symm (e : P.Equiv Q) (w : weylGroup Q) :
    (e.weylGroupEquiv.symm w : Aut P) = e.autCongr.symm (w : Aut Q) :=
  (rfl)

/-- The isomorphism of Weyl groups matches up the simple reflections along `e.indexEquiv`. -/
@[simp]
theorem _root_.RootPairing.Equiv.weylGroupEquiv_ofIdx (e : P.Equiv Q) (i : ι) :
    e.weylGroupEquiv (RootPairing.weylGroup.ofIdx P i) =
      RootPairing.weylGroup.ofIdx Q (e.indexEquiv i) :=
  Subtype.ext <| e.autCongr_reflection i

/-- The isomorphism of Weyl groups is equivariant for the permutation actions on root indices:
the permutation of `Q`'s root indices is the one of `P`'s conjugated by `e.indexEquiv`. -/
theorem _root_.RootPairing.Equiv.weylGroupToPerm_weylGroupEquiv (e : P.Equiv Q)
    (w : weylGroup P) :
    weylGroupToPerm Q (e.weylGroupEquiv w) = e.indexEquiv.permCongr (weylGroupToPerm P w) :=
  Equiv.ext fun i ↦ by
    have h : weylGroupToPerm Q (e.weylGroupEquiv w) i =
        (e.autCongr (w : Aut P)).indexEquiv i := (rfl)
    rw [h, RootPairing.Equiv.indexEquiv_autCongr_apply]
    rfl

/-- The applied form of `RootPairing.Equiv.weylGroupToPerm_weylGroupEquiv`: the transported
Weyl-group element moves the transported index the way the original moves the original. -/
theorem _root_.RootPairing.Equiv.weylGroupToPerm_weylGroupEquiv_indexEquiv (e : P.Equiv Q)
    (w : weylGroup P) (i : ι) :
    weylGroupToPerm Q (e.weylGroupEquiv w) (e.indexEquiv i) =
      e.indexEquiv (weylGroupToPerm P w i) :=
  e.autCongr_smul_index (w : Aut P) i

/-- The isomorphism of Weyl groups is equivariant for the actions on weight vectors. -/
theorem _root_.RootPairing.Equiv.weylGroupEquiv_smul (e : P.Equiv Q) (w : weylGroup P) (x : M) :
    e.weylGroupEquiv w • e.weightEquiv x = e.weightEquiv (w • x) :=
  e.autCongr_smul (w : Aut P) x

section Functoriality

/-- Conjugation by the identity equivalence is the identity. -/
@[simp]
theorem _root_.RootPairing.Equiv.autCongr_id :
    (RootPairing.Equiv.id P).autCongr = MulEquiv.refl (Aut P) :=
  MulEquiv.ext fun g ↦ by
    rw [RootPairing.Equiv.autCongr_apply, RootPairing.Equiv.symm_id,
      RootPairing.Equiv.id_comp, RootPairing.Equiv.comp_id]
    rfl

/-- Conjugation by a composite is the composite of the conjugations. -/
theorem _root_.RootPairing.Equiv.autCongr_comp (e : P.Equiv Q) (f : Q.Equiv S) :
    (RootPairing.Equiv.comp f e).autCongr = e.autCongr.trans f.autCongr :=
  MulEquiv.ext fun g ↦ by
    simp only [RootPairing.Equiv.autCongr_apply, MulEquiv.trans_apply,
      RootPairing.Equiv.symm_comp, RootPairing.Equiv.comp_assoc]

/-- The Weyl-group isomorphism of the identity equivalence is the identity. -/
@[simp]
theorem _root_.RootPairing.Equiv.weylGroupEquiv_id :
    (RootPairing.Equiv.id P).weylGroupEquiv = MulEquiv.refl (weylGroup P) :=
  MulEquiv.ext fun w ↦ Subtype.ext (by simp)

/-- The Weyl-group isomorphism of a composite is the composite of the Weyl-group isomorphisms. -/
theorem _root_.RootPairing.Equiv.weylGroupEquiv_comp (e : P.Equiv Q) (f : Q.Equiv S) :
    (RootPairing.Equiv.comp f e).weylGroupEquiv = e.weylGroupEquiv.trans f.weylGroupEquiv :=
  MulEquiv.ext fun w ↦ Subtype.ext (by simp [RootPairing.Equiv.autCongr_comp])

end Functoriality

/-- **Isomorphic root pairings have Weyl groups of the same cardinality.** -/
theorem _root_.RootPairing.Equiv.natCard_weylGroup_eq (e : P.Equiv Q) :
    Nat.card (weylGroup P) = Nat.card (weylGroup Q) :=
  Nat.card_congr e.weylGroupEquiv.toEquiv

/-- Finiteness of the Weyl group transports along an equivalence of root pairings. -/
theorem _root_.RootPairing.Equiv.finite_weylGroup (e : P.Equiv Q) [Finite (weylGroup P)] :
    Finite (weylGroup Q) :=
  Finite.of_equiv _ e.weylGroupEquiv.toEquiv

section CartanType

variable [CharZero R] [IsDomain R] [Finite ι] [Finite ι₂]
  [P.IsRootSystem] [P.IsCrystallographic] [P.IsReduced]
  [Q.IsRootSystem] [Q.IsCrystallographic] [Q.IsReduced]

/-- **Two root systems carrying bases of the same Cartan type have isomorphic Weyl groups.** The
Weyl group is therefore an invariant of the Dynkin type alone, so it may be computed on any one
pinned model of that type and read off on every root system of that type.

Only the existence of an isomorphism is asserted, because
`TauCeti.nonempty_equiv_of_hasCartanType` only asserts the existence of an isomorphism of root
systems: the one produced depends on the two labellings of the supports by the nodes of `t`. -/
theorem nonempty_weylGroup_mulEquiv_of_hasCartanType (b : P.Base) (b₂ : Q.Base) (t : DynkinType)
    (h : HasCartanType P b t) (h₂ : HasCartanType Q b₂ t) :
    Nonempty (weylGroup P ≃* weylGroup Q) :=
  (nonempty_equiv_of_hasCartanType b b₂ t h h₂).elim fun e ↦ ⟨e.weylGroupEquiv⟩

end CartanType

end

end TauCeti
