module

public import Mathlib.Algebra.Module.Submodule.Union
public import TauCeti.LinearAlgebra.Dual.Lemmas
public import TauCeti.LinearAlgebra.RootSystem.FundamentalDomain
public import TauCeti.LinearAlgebra.RootSystem.Weyl.Group
public import TauCeti.RepresentationTheory.Pseudoreflection

/-!
# The pseudoreflections of a Weyl group are its root reflections

Let `P` be a root pairing over a field `K` of characteristic zero, and let its Weyl group act on the
weight space `M` through `RootPairing.weylGroupRootRep`. An element of the Weyl group is a
*pseudoreflection* when its fixed space is a hyperplane (`Representation.pseudoreflectionSubgroup`).

The reflection `sᵢ` in a root `αᵢ` fixes exactly the hyperplane `ker αᵢ^∨`, so it is a
pseudoreflection, and since the Weyl group is generated by these reflections it is generated by
pseudoreflections. Over a linearly ordered field, for a finite crystallographic reduced root pairing
with a base, the converse holds: **every pseudoreflection of the Weyl group is the reflection in a
root**, and in exactly one positive root. So the number of pseudoreflections is the number `|Φ⁺|` of
positive roots. These are the inputs needed to specialize the invariant theory of finite groups
generated by pseudoreflections, such as the identity `∑ (dᵢ - 1) = #{pseudoreflections}` for the
degrees `dᵢ` of basic invariants, to Weyl groups.

The ordered field is used through the chamber geometry. Moving a weight `x` into the closed
dominant chamber by some `u`, the stabilizer of `u • x` is generated by the simple reflections in
the walls through `u • x` (`TauCeti.stabilizer_eq_closure_wallReflections`); transporting back by
`u`, **the stabilizer of every weight is generated by the root reflections fixing it**. Now if `w`
fixes the hyperplane `H` pointwise, choose `x ∈ H` on no root hyperplane other than `H` itself,
which is possible since `K` is infinite. The root reflections fixing `x` then all have fixed
hyperplane `H`, and two such reflections coincide: if `ker αᵢ^∨ ≤ ker αⱼ^∨` then the Coxeter weight
of `αᵢ, αⱼ` is `4`, so the roots are proportional (`RootPairing.reflection_eq_of_ker_coroot'_le`).
Hence `w` lies in a subgroup `{1, s}` for a root reflection `s`, and `w ≠ 1`.

## Main results

* `RootPairing.weylGroupRootRep_injective`: the Weyl group acts faithfully on the weight space.
* `RootPairing.fixedSubmodule_weylGroupRootRep_ofIdx`: the fixed space of `sᵢ` is `ker αᵢ^∨`.
* `RootPairing.pseudoreflectionSubgroup_weylGroupRootRep`: the Weyl group is generated by
  pseudoreflections.
* `RootPairing.reflection_eq_of_ker_coroot'_le`: in a finite reduced root pairing, a root reflection
  is determined by its fixed hyperplane, and `RootPairing.eq_of_ker_coroot'_le_of_mem_posRoots`:
  so is a positive root.
* `RootPairing.stabilizer_eq_closure_ofIdx`: the stabilizer of a weight is generated by the root
  reflections fixing it.
* `RootPairing.exists_mem_posRoots_eq_ofIdx_of_finrank_quotient_fixedSubmodule_eq_one`: every
  pseudoreflection of the Weyl group is the reflection in a positive root.
* `RootPairing.card_pseudoreflections_weylGroupRootRep_eq_ncard_posRoots`: the Weyl group has
  exactly `|Φ⁺|` pseudoreflections.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4--6*, Ch. V, §3.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, Cambridge University Press (1990),
  § 1.12, Theorem (c), for the stabilizers, and § 1.14 for the reflections of `W`.
-/

public section

open Module

namespace RootPairing

variable {ι K M N : Type*} [Field K] [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]
  (P : RootPairing ι K M N)

/-- The weight-space representation of the Weyl group is its action on the weights. -/
@[simp]
theorem weylGroupRootRep_apply (w : P.weylGroup) (x : M) : P.weylGroupRootRep w x = w • x :=
  (rfl)

/-- The Weyl group acts faithfully on the weight space. -/
theorem weylGroupRootRep_injective : Function.Injective P.weylGroupRootRep :=
  fun _ _ h ↦ weylGroup.ext fun x ↦ by simpa using LinearMap.congr_fun h x

section CharZero

variable [CharZero K]

/-- The fixed space of the reflection in a root is the hyperplane cut out by its coroot. -/
theorem fixedSubmodule_weylGroupRootRep_ofIdx (i : ι) :
    (P.weylGroupRootRep (weylGroup.ofIdx P i)).fixedSubmodule = LinearMap.ker (P.coroot' i) := by
  ext x
  simp [LinearMap.mem_fixedSubmodule_iff, reflection_apply, P.ne_zero i]

/-- The reflection in a root is a pseudoreflection of the weight space: its fixed space has
codimension one. -/
theorem finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx (i : ι) :
    finrank K (M ⧸ (P.weylGroupRootRep (weylGroup.ofIdx P i)).fixedSubmodule) = 1 := by
  rw [fixedSubmodule_weylGroupRootRep_ofIdx]
  exact Dual.finrank_quotient_ker_eq_one_of_ne_zero (P.coroot'_ne_zero i)

/-- **The Weyl group is generated by pseudoreflections** of the weight space, namely by the root
reflections. -/
theorem pseudoreflectionSubgroup_weylGroupRootRep :
    P.weylGroupRootRep.pseudoreflectionSubgroup = ⊤ := by
  refine (Subgroup.eq_top_iff' _).2 fun ⟨w, hw⟩ ↦ ?_
  induction hw using weylGroup.induction with
  | mem i =>
    exact Representation.mem_pseudoreflectionSubgroup_of_finrank_quotient_eq_one _
      (P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx i)
  | one => exact one_mem _
  | mul _ _ _ _ hx hy => exact mul_mem hx hy

/-- **A root reflection is determined by its fixed hyperplane.** In a finite reduced root pairing
over a field of characteristic zero, if the kernel of the coroot of `i` lies in the kernel of the
coroot of `j`, then the reflections in `i` and `j` coincide. -/
theorem reflection_eq_of_ker_coroot'_le [Finite ι] [P.IsReduced] {i j : ι}
    (h : LinearMap.ker (P.coroot' i) ≤ LinearMap.ker (P.coroot' j)) :
    P.reflection i = P.reflection j := by
  -- The coroot of `j` kills `αⱼ - (⟨αⱼ, αᵢ^∨⟩ / 2) αᵢ`, since the coroot of `i` does. Evaluating
  -- gives `⟨αᵢ, αⱼ^∨⟩ ⟨αⱼ, αᵢ^∨⟩ = 4`, so the two roots are proportional.
  have hz := @h (P.root j - (P.pairing j i / 2) • P.root i) (by
    simp only [LinearMap.mem_ker, map_sub, map_smul, root_coroot'_eq_pairing, pairing_same,
      smul_eq_mul]
    ring)
  simp only [LinearMap.mem_ker, map_sub, map_smul, root_coroot'_eq_pairing, pairing_same,
    smul_eq_mul] at hz
  have hdep : ¬LinearIndependent K ![P.root i, P.root j] := by
    rw [← coxeterWeight_eq_four_iff_not_linearIndependent, coxeterWeight]
    linear_combination -2 * hz
  rcases IsReduced.eq_or_eq_neg i j hdep with he | he
  · rw [P.root.injective he]
  · let := P.indexNeg
    have hi : i = -j := P.root.injective (by rw [he, root_neg_index])
    rw [hi, reflection_indexNeg_neg]

/-- Every root reflection is the reflection in a positive root. -/
theorem exists_mem_posRoots_ofIdx_eq (b : P.Base) (j : ι) :
    ∃ i ∈ TauCeti.posRoots P b, weylGroup.ofIdx P i = weylGroup.ofIdx P j := by
  by_cases hj : j ∈ TauCeti.posRoots P b
  · exact ⟨j, hj, rfl⟩
  · let := P.indexNeg
    refine ⟨-j, ?_, weylGroup.ext fun x ↦ ?_⟩
    · rw [indexNeg_neg, TauCeti.reflectionPerm_self_mem_posRoots_iff_mem_negRoots,
        ← TauCeti.not_mem_posRoots_iff_mem_negRoots]
      exact hj
    · rw [weylGroup.ofIdx_smul, weylGroup.ofIdx_smul, Equiv.reflection_smul,
        Equiv.reflection_smul, reflection_indexNeg_neg]

/-- **Distinct positive roots have distinct reflections.** -/
theorem injOn_ofIdx_posRoots [P.IsReduced] (b : P.Base) :
    Set.InjOn (weylGroup.ofIdx P) (TauCeti.posRoots P b) := by
  intro i hi j hj hij
  have h : P.reflection i (P.root i) = P.reflection j (P.root i) := by
    simpa using congrArg (· • P.root i) hij
  refine TauCeti.eq_of_isPos_of_reflection_eq ((TauCeti.mem_posRoots P b i).1 hi)
    ((TauCeti.mem_posRoots P b j).1 hj) h ?_
  rw [reflection_apply_self]
  intro h
  have h2 : (2 : K) • P.root i = 0 := by
    rw [two_smul]
    exact neg_eq_iff_add_eq_zero.1 h
  exact P.ne_zero i ((smul_eq_zero.1 h2).resolve_left two_ne_zero)

/-- **A positive root is determined by its hyperplane.** In a finite reduced root pairing, if the
kernel of the coroot of a positive root `i` lies in the kernel of the coroot of a positive root
`j`, then `i = j`. -/
theorem eq_of_ker_coroot'_le_of_mem_posRoots [Finite ι] [P.IsReduced] (b : P.Base) {i j : ι}
    (hi : i ∈ TauCeti.posRoots P b) (hj : j ∈ TauCeti.posRoots P b)
    (h : LinearMap.ker (P.coroot' i) ≤ LinearMap.ker (P.coroot' j)) : i = j :=
  P.injOn_ofIdx_posRoots b hi hj <| weylGroup.ext fun x ↦ by
    simp [P.reflection_eq_of_ker_coroot'_le h]

end CharZero

section LinearOrder

variable [LinearOrder K] [IsStrictOrderedRing K] [Finite ι] [P.IsCrystallographic] [P.IsReduced]

open TauCeti in
/-- **The stabilizer of a weight is generated by the root reflections fixing it.** For a finite
crystallographic reduced root pairing over a linearly ordered field, with a base and a finite Weyl
group, the stabilizer of any weight `x` is generated by the reflections `sⱼ` in the roots whose
coroot vanishes at `x`. The base is used only to move `x` into a closed chamber. -/
theorem stabilizer_eq_closure_ofIdx [Finite P.weylGroup] (b : P.Base) (x : M) :
    MulAction.stabilizer P.weylGroup x =
      Subgroup.closure (weylGroup.ofIdx P '' {j | P.coroot' j x = 0}) := by
  refine le_antisymm (fun g hg ↦ ?_) ((Subgroup.closure_le _).2 ?_)
  · -- Conjugate into the stabilizer of a dominant weight, generated by the walls through it.
    obtain ⟨u, hu⟩ := exists_mem_dominantChamber_of_finite_weylGroup P b x
    have hmem : u * g * u⁻¹ ∈ Subgroup.closure (wallReflections P b (u • x)) := by
      rw [← stabilizer_eq_closure_wallReflections P b hu, MulAction.mem_stabilizer_iff, mul_smul,
        mul_smul, inv_smul_smul, MulAction.mem_stabilizer_iff.1 hg]
    have hle : Subgroup.closure (wallReflections P b (u • x)) ≤
        (Subgroup.closure (weylGroup.ofIdx P '' {j | P.coroot' j x = 0})).comap
          (MulAut.conj u⁻¹).toMonoidHom := by
      refine (Subgroup.closure_le _).2 fun s hs ↦ ?_
      obtain ⟨i, -, hi, rfl⟩ := mem_wallReflections.mp hs
      have hperm : P.weylGroupToPerm u (P.weylGroupToPerm u⁻¹ i) = i := by
        rw [← Equiv.Perm.mul_apply, ← map_mul, mul_inv_cancel, map_one, Equiv.Perm.one_apply]
      refine Subgroup.subset_closure ⟨P.weylGroupToPerm u⁻¹ i, ?_, ?_⟩
      · have h := coroot'_weylGroupToPerm_smul P u (P.weylGroupToPerm u⁻¹ i) x
        rw [hperm] at h
        exact h.symm.trans hi
      · rw [weylGroup.ofIdx_weylGroupToPerm_eq_conj, MulEquiv.coe_toMonoidHom,
          MulAut.conj_apply, inv_inv]
    simpa [mul_assoc] using hle hmem
  · rintro _ ⟨j, hj, rfl⟩
    rw [SetLike.mem_coe, MulAction.mem_stabilizer_iff, weylGroup.ofIdx_smul, Equiv.reflection_smul,
      reflection_apply, hj, zero_smul, sub_zero]

open TauCeti in
/-- **Every pseudoreflection of a Weyl group is a root reflection.** For a finite crystallographic
reduced root pairing with a base `b` over a linearly ordered field, an element of the Weyl group
whose fixed space in the weight space is a hyperplane is the reflection in a positive root. -/
theorem exists_mem_posRoots_eq_ofIdx_of_finrank_quotient_fixedSubmodule_eq_one
    [Finite P.weylGroup] (b : P.Base) {w : P.weylGroup}
    (hw : finrank K (M ⧸ (P.weylGroupRootRep w).fixedSubmodule) = 1) :
    ∃ i ∈ posRoots P b, w = weylGroup.ofIdx P i := by
  classical
  set H := (P.weylGroupRootRep w).fixedSubmodule with hH
  -- `H` is a hyperplane, so a root hyperplane containing it equals it.
  obtain ⟨ℓ, hℓ, hkerℓ⟩ := H.exists_dual_ker_eq_of_finrank_quotient_eq_one hw
  have hcoatom : IsCoatom H :=
    hkerℓ ▸ LinearMap.isCoatom_ker_of_surjective (ℓ.surjective_or_eq_zero.resolve_right hℓ)
  have hker {j : ι} (hj : H ≤ LinearMap.ker (P.coroot' j)) : LinearMap.ker (P.coroot' j) = H :=
    (hcoatom.le_iff.1 hj).resolve_left fun htop ↦
      P.coroot'_ne_zero j (LinearMap.ker_eq_top.1 htop)
  -- A point `x` of `H` lying on no root hyperplane other than `H`.
  obtain ⟨x, hxH, hx⟩ := Dual.exists_forall_mem_ne_zero_of_forall_exists H
    (fun j : {j : ι // ¬H ≤ LinearMap.ker (P.coroot' j)} ↦ P.coroot' j) fun j ↦ by
      obtain ⟨y, hyH, hy⟩ := IsConcreteLE.not_le_iff_exists.1 j.2
      exact ⟨y, hyH, hy⟩
  have hwx : w ∈ MulAction.stabilizer P.weylGroup x := by
    simpa [hH, LinearMap.mem_fixedSubmodule_iff] using hxH
  rw [P.stabilizer_eq_closure_ofIdx b x] at hwx
  -- The reflections fixing `x` all fix `H`, so they all coincide with one reflection `s`, and the
  -- group they generate is `{1, s}`.
  have key : ∀ g ∈ Subgroup.closure (weylGroup.ofIdx P '' {j | P.coroot' j x = 0}),
      g = 1 ∨ ∃ j, H ≤ LinearMap.ker (P.coroot' j) ∧ g = weylGroup.ofIdx P j := by
    intro g hg
    induction hg using Subgroup.closure_induction with
    | mem g hg =>
      obtain ⟨j, hj, rfl⟩ := hg
      exact Or.inr ⟨j, not_not.1 fun hj' ↦ hx ⟨j, hj'⟩ hj, rfl⟩
    | one => exact Or.inl rfl
    | mul g g' _ _ hg hg' =>
      rcases hg with rfl | ⟨j, hj, rfl⟩ <;> rcases hg' with rfl | ⟨j', hj', rfl⟩
      · exact Or.inl (one_mul 1)
      · exact Or.inr ⟨j', hj', one_mul _⟩
      · exact Or.inr ⟨j, hj, mul_one _⟩
      · refine Or.inl ?_
        have h := P.reflection_eq_of_ker_coroot'_le ((hker hj).trans_le hj')
        rw [show weylGroup.ofIdx P j = weylGroup.ofIdx P j' from
          weylGroup.ext fun y ↦ by simp [h], weylGroup.ofIdx_mul_self]
    | inv g _ hg =>
      rcases hg with rfl | ⟨j, hj, rfl⟩
      · exact Or.inl inv_one
      · exact Or.inr ⟨j, hj, weylGroup.ofIdx_inv_eq P j⟩
  rcases key w hwx with rfl | ⟨j, -, rfl⟩
  · exact absurd rfl (P.weylGroupRootRep.ne_one_of_finrank_quotient_fixedSubmodule_eq_one hw)
  · obtain ⟨i, hi, hij⟩ := P.exists_mem_posRoots_ofIdx_eq b j
    exact ⟨i, hi, hij.symm⟩

open Finset TauCeti in
/-- **The number of pseudoreflections of a Weyl group is the number of positive roots.** -/
theorem card_pseudoreflections_weylGroupRootRep_eq_ncard_posRoots
    [Fintype P.weylGroup] (b : P.Base) :
    #{w | finrank K (M ⧸ (P.weylGroupRootRep w).fixedSubmodule) = 1} = (posRoots P b).ncard := by
  classical
  have himage : {w : P.weylGroup | finrank K (M ⧸ (P.weylGroupRootRep w).fixedSubmodule) = 1} =
      weylGroup.ofIdx P '' posRoots P b := by
    ext w
    constructor
    · intro hw
      obtain ⟨i, hi, rfl⟩ :=
        P.exists_mem_posRoots_eq_ofIdx_of_finrank_quotient_fixedSubmodule_eq_one b hw
      exact ⟨i, hi, rfl⟩
    · rintro ⟨i, -, rfl⟩
      exact P.finrank_quotient_fixedSubmodule_weylGroupRootRep_ofIdx i
  rw [← Set.ncard_coe_finset, Finset.coe_filter_univ, himage,
    (P.injOn_ofIdx_posRoots b).ncard_image]

end LinearOrder

end RootPairing
