module

public import TauCeti.GroupTheory.Coxeter.Bruhat
public import TauCeti.LinearAlgebra.RootSystem.Coxeter.Presentation
public import TauCeti.LinearAlgebra.RootSystem.FundamentalDomain

/-!
# The Weyl orbit of a dominant weight as a parabolic quotient

Let `λ` be a dominant weight for a base `b` of a finite crystallographic reduced root system. Its
stabilizer `W_λ` in the Weyl group is the standard parabolic subgroup of the Coxeter system
`TauCeti.weylCoxeterSystem` generated by the simple reflections in the walls through `λ`. So the
orbit `W λ` is the parabolic quotient `W / W_λ`, and each orbit weight `u λ` has a unique minimal
coset representative. This file records that dictionary and the **reflection test** comparing two
orbit weights related by a reflection.

For a positive root `β` and an orbit weight `u λ`, let `u` and `v` be the minimal representatives
of the cosets of `u` and of `s_β u`, so that `v λ = s_β (u λ)`. Then, in the Bruhat order,

* `v < u` when `⟨u λ, β^∨⟩ < 0`;
* `u < v` when `⟨u λ, β^∨⟩ > 0`;
* `v = u` when `⟨u λ, β^∨⟩ = 0`, and then also `s_β (u λ) = u λ`.

The comparison is between the minimal representatives, not between arbitrary Weyl-group elements
with the given weights: on a chamber wall `W_λ` is nontrivial, and `s_β u` itself is generally not
minimal in its coset. A weak inequality gives no strict comparison: on a wall the zero pairing
gives the same coset.

This is the order test on `W / W_λ` underlying the description of Lakshmibai–Seshadri paths by
saturated chains of orbit weights, in which each step is a reflection `ξ ↦ s_β ξ` with
`⟨ξ, β^∨⟩ < 0`.

## Main definitions

* `RootPairing.wallIndices`: the simple roots whose coroot vanishes on a weight, as a set of simple
  generators of `TauCeti.weylCoxeterSystem`.

## Main results

* `RootPairing.parabolic_wallIndices_eq_stabilizer`: the standard parabolic subgroup of the walls
  through a dominant weight is its stabilizer.
* `TauCeti.inv_mul_mem_parabolic_wallIndices_iff`: two Weyl-group elements lie in the same coset
  of that parabolic subgroup exactly when they move the dominant weight to the same point.
* `TauCeti.existsUnique_isMinimalCosetRep_smul_eq`: each orbit weight has a unique minimal coset
  representative.
* `TauCeti.bruhatLE_of_isMinimalCosetRep_of_smul_eq`: that representative lies below every
  Weyl-group element with the same orbit weight.
* `TauCeti.bruhatStep_ofIdx_mul_of_coroot'_neg`: `s_β w < w` in the Weyl group itself when
  `⟨w λ, β^∨⟩ < 0`.
* `TauCeti.bruhatLE_and_ne_of_isMinimalCosetRep_of_coroot'_neg`,
  `TauCeti.bruhatLE_and_ne_of_isMinimalCosetRep_of_coroot'_pos` and
  `TauCeti.eq_of_isMinimalCosetRep_of_coroot'_eq_zero`: **the reflection test** in its three cases.
* `TauCeti.bruhatLE_and_ne_iff_coroot'_neg_of_isMinimalCosetRep` and
  `TauCeti.eq_iff_coroot'_eq_zero_of_isMinimalCosetRep`: the reflection test as characterizations
  of the strict order and of equality.

## References

* A. Björner and F. Brenti, *Combinatorics of Coxeter Groups*, Springer GTM 231 (2005),
  Sections 2.4 and 2.5.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, CUP (1990), Sections 1.10 and 5.7.
* P. Littelmann, *Paths and root operators in representation theory*, Ann. of Math. 142 (1995),
  499--525, Section 4.
-/

public section

namespace TauCeti

open RootPairing

universe u v w x

variable {ι : Type u} {R : Type v} {M : Type w} {N : Type x}
  [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : _root_.RootPairing ι R M N) (b : P.Base)

/-! ### The walls through a weight as simple generators -/

/-- The simple roots of the base `b` whose simple coroot vanishes on `x`, as a set of simple
generators of `TauCeti.weylCoxeterSystem`. For dominant `x` the standard parabolic subgroup they
generate is the stabilizer of `x` (`RootPairing.parabolic_wallIndices_eq_stabilizer`). -/
def _root_.RootPairing.wallIndices (x : M) : Set b.support := {i | P.coroot' i x = 0}

variable {P b}

/-- A simple root lies in `RootPairing.wallIndices` exactly when its coroot vanishes on the
weight. -/
@[simp]
lemma _root_.RootPairing.mem_wallIndices {x : M} {i : b.support} :
    i ∈ P.wallIndices b x ↔ P.coroot' i x = 0 :=
  Iff.rfl

variable (P b) [LinearOrder R] [IsStrictOrderedRing R] [Finite ι] [P.IsCrystallographic]
  [P.IsReduced] [P.flip.IsReduced] {lam : M}

/-- **The stabilizer of a dominant weight is a standard parabolic subgroup**: the one generated by
the simple reflections in the walls through it. -/
theorem _root_.RootPairing.parabolic_wallIndices_eq_stabilizer
    (hlam : lam ∈ dominantChamber P b) :
    (weylCoxeterSystem P b).parabolic (P.wallIndices b lam) =
      MulAction.stabilizer P.weylGroup lam := by
  refine le_antisymm ((CoxeterSystem.parabolic_le_iff _).mpr fun i hi ↦ ?_) ?_
  · rw [MulAction.mem_stabilizer_iff, weylCoxeterSystem_simple]
    exact ofIdx_smul_eq_self_of_coroot'_eq_zero (mem_wallIndices.mp hi)
  · rw [stabilizer_eq_closure_wallReflections P b hlam, Subgroup.closure_le]
    intro w hw
    obtain ⟨i, hi, hzero, rfl⟩ := mem_wallReflections.mp hw
    rw [← weylCoxeterSystem_simple P b ⟨i, hi⟩]
    exact (weylCoxeterSystem P b).simple_mem_parabolic (mem_wallIndices.mpr hzero)

variable {P b}

/-- **Cosets of the stabilizer are orbit weights.** Two Weyl-group elements lie in the same left
coset of the standard parabolic subgroup of the walls through a dominant weight exactly when they
move that weight to the same point. -/
theorem inv_mul_mem_parabolic_wallIndices_iff (hlam : lam ∈ dominantChamber P b)
    {u w : P.weylGroup} :
    u⁻¹ * w ∈ (weylCoxeterSystem P b).parabolic (P.wallIndices b lam) ↔ w • lam = u • lam := by
  rw [P.parabolic_wallIndices_eq_stabilizer b hlam, MulAction.mem_stabilizer_iff, mul_smul,
    inv_smul_eq_iff]

/-- **Each orbit weight of a dominant weight has a unique minimal coset representative.** -/
theorem existsUnique_isMinimalCosetRep_smul_eq (hlam : lam ∈ dominantChamber P b)
    (w : P.weylGroup) :
    ∃! u, (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) u ∧
      u • lam = w • lam := by
  obtain ⟨v, hv, hmin⟩ :=
    (weylCoxeterSystem P b).exists_isMinimalCosetRep (P.wallIndices b lam) w
  refine ⟨w * v, ⟨hmin, ?_⟩, fun u ⟨hu, hulam⟩ ↦ hu.eq_of_inv_mul_mem _ hmin ?_⟩
  · rw [← inv_mul_mem_parabolic_wallIndices_iff hlam, inv_mul_cancel_left]
    exact hv
  · rw [inv_mul_mem_parabolic_wallIndices_iff hlam, hulam, mul_smul,
      MulAction.mem_stabilizer_iff.mp ((P.parabolic_wallIndices_eq_stabilizer b hlam).le hv)]

/-- **Minimal coset representatives are determined by their orbit weight.** -/
theorem eq_of_isMinimalCosetRep_of_smul_eq (hlam : lam ∈ dominantChamber P b)
    {u v : P.weylGroup} (hu : (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) u)
    (hv : (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) v)
    (h : u • lam = v • lam) : u = v :=
  hu.eq_of_inv_mul_mem _ hv ((inv_mul_mem_parabolic_wallIndices_iff hlam).mpr h.symm)

/-- **The minimal coset representative of an orbit weight is Bruhat-below every Weyl-group element
with that orbit weight.** -/
theorem bruhatLE_of_isMinimalCosetRep_of_smul_eq (hlam : lam ∈ dominantChamber P b)
    {v w : P.weylGroup} (hv : (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) v)
    (h : v • lam = w • lam) : (weylCoxeterSystem P b).BruhatLE v w := by
  have hmem := (inv_mul_mem_parabolic_wallIndices_iff hlam (u := v) (w := w)).mpr h.symm
  simpa using hv.bruhatLE_mul (weylCoxeterSystem P b) hmem

/-! ### The reflection test -/

/-- **Reflection test in the Weyl group.** Reflecting in a positive root `β` with
`⟨w λ, β^∨⟩ < 0` moves `w` one step down the Bruhat graph: `s_β w < w`, since the root `w⁻¹ β`
pairs negatively with the dominant weight `λ` and so is a negative root. -/
theorem bruhatStep_ofIdx_mul_of_coroot'_neg (hlam : lam ∈ dominantChamber P b)
    {w : P.weylGroup} {β : ι} (hβ : b.IsPos β) (hneg : P.coroot' β (w • lam) < 0) :
    (weylCoxeterSystem P b).BruhatStep (RootPairing.weylGroup.ofIdx P β * w) w := by
  have hinv : β ∈ inversions P b w⁻¹ := by
    refine (mem_inversions P b w⁻¹ β).mpr ⟨hβ, fun hpos ↦ hneg.not_ge ?_⟩
    have h := coroot'_weylGroupToPerm_smul P w⁻¹ β (w • lam)
    rw [inv_smul_smul] at h
    rw [← h]
    exact coroot'_nonneg_of_mem_posRoots P b hlam ((mem_posRoots P b _).mpr hpos)
  exact (P.bruhatStep_ofIdx_mul_iff_mem_inversions b w hβ).mpr hinv

/-- **Reflection test, negative pairing.** Let `β` be a positive root with `⟨w λ, β^∨⟩ < 0`, and
let `v` be the minimal coset representative of `s_β w`, so `v λ = s_β (w λ)`. Then `v < w` in the
Bruhat order. Here `w` is arbitrary; it need not be minimal in its own coset. -/
theorem bruhatLE_and_ne_of_isMinimalCosetRep_of_coroot'_neg (hlam : lam ∈ dominantChamber P b)
    {v w : P.weylGroup}
    (hv : (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) v) {β : ι}
    (hvw : v • lam = (RootPairing.weylGroup.ofIdx P β * w) • lam) (hβ : b.IsPos β)
    (hneg : P.coroot' β (w • lam) < 0) :
    (weylCoxeterSystem P b).BruhatLE v w ∧ v ≠ w := by
  have hstep := bruhatStep_ofIdx_mul_of_coroot'_neg hlam hβ hneg
  have hle := bruhatLE_of_isMinimalCosetRep_of_smul_eq hlam hv hvw
  exact ⟨hle.trans hstep.bruhatLE,
    fun h ↦ (hle.length_le.trans_lt hstep.length_lt).ne (congrArg _ h)⟩

/-- **Reflection test, positive pairing.** Let `u` be a minimal coset representative and `β` a
positive root with `⟨u λ, β^∨⟩ > 0`. Then `u < w` in the Bruhat order for every `w` with
`w λ = s_β (u λ)`, in particular for the minimal coset representative of `s_β u`. -/
theorem bruhatLE_and_ne_of_isMinimalCosetRep_of_coroot'_pos (hlam : lam ∈ dominantChamber P b)
    {u w : P.weylGroup}
    (hu : (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) u) {β : ι}
    (hwu : w • lam = (RootPairing.weylGroup.ofIdx P β * u) • lam) (hβ : b.IsPos β)
    (hpos : 0 < P.coroot' β (u • lam)) :
    (weylCoxeterSystem P b).BruhatLE u w ∧ u ≠ w := by
  -- Reflecting back, `u λ = s_β (w λ)` and `⟨w λ, β^∨⟩ = -⟨u λ, β^∨⟩ < 0`.
  have hwlam : w • lam = P.reflection β (u • lam) := by
    rw [hwu, mul_smul, RootPairing.weylGroup.ofIdx_smul, Equiv.reflection_smul]
  refine bruhatLE_and_ne_of_isMinimalCosetRep_of_coroot'_neg hlam hu ?_ hβ ?_
  · rw [mul_smul, hwlam, RootPairing.weylGroup.ofIdx_smul, Equiv.reflection_smul,
      reflection_same]
  · rw [hwlam, coroot'_reflection_self]
    exact neg_neg_of_pos hpos

/-- **Reflection test, zero pairing.** If `⟨u λ, β^∨⟩ = 0`, then `s_β` fixes `u λ`, so `u` and
`s_β u` have the same minimal coset representative. -/
theorem eq_of_isMinimalCosetRep_of_coroot'_eq_zero (hlam : lam ∈ dominantChamber P b)
    {u v : P.weylGroup}
    (hu : (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) u)
    (hv : (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) v) {β : ι}
    (hvu : v • lam = (RootPairing.weylGroup.ofIdx P β * u) • lam)
    (hzero : P.coroot' β (u • lam) = 0) : v = u := by
  refine eq_of_isMinimalCosetRep_of_smul_eq hlam hv hu ?_
  rw [hvu, mul_smul, ofIdx_smul_eq_self_of_coroot'_eq_zero hzero]

/-- **The reflection test characterizes the strict Bruhat order on minimal coset
representatives.** If `u` and `v` are the minimal coset representatives of `u` and `s_β u` for a
positive root `β`, then `v < u` exactly when `⟨u λ, β^∨⟩ < 0`. -/
theorem bruhatLE_and_ne_iff_coroot'_neg_of_isMinimalCosetRep (hlam : lam ∈ dominantChamber P b)
    {u v : P.weylGroup}
    (hu : (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) u)
    (hv : (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) v) {β : ι}
    (hvu : v • lam = (RootPairing.weylGroup.ofIdx P β * u) • lam) (hβ : b.IsPos β) :
    (weylCoxeterSystem P b).BruhatLE v u ∧ v ≠ u ↔ P.coroot' β (u • lam) < 0 := by
  refine ⟨fun ⟨hle, hne⟩ ↦ lt_of_not_ge fun hnonneg ↦ ?_,
    bruhatLE_and_ne_of_isMinimalCosetRep_of_coroot'_neg hlam hv hvu hβ⟩
  rcases hnonneg.eq_or_lt with hzero | hpos
  · exact hne (eq_of_isMinimalCosetRep_of_coroot'_eq_zero hlam hu hv hvu hzero.symm)
  · exact hne
      (hle.antisymm (bruhatLE_and_ne_of_isMinimalCosetRep_of_coroot'_pos hlam hu hvu hβ hpos).1)

/-- **The reflection test characterizes equal cosets.** If `u` and `v` are the minimal coset
representatives of `u` and `s_β u` for a root `β`, then `v = u` exactly when `⟨u λ, β^∨⟩ = 0`. -/
theorem eq_iff_coroot'_eq_zero_of_isMinimalCosetRep (hlam : lam ∈ dominantChamber P b)
    {u v : P.weylGroup}
    (hu : (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) u)
    (hv : (weylCoxeterSystem P b).IsMinimalCosetRep (P.wallIndices b lam) v) {β : ι}
    (hvu : v • lam = (RootPairing.weylGroup.ofIdx P β * u) • lam) :
    v = u ↔ P.coroot' β (u • lam) = 0 := by
  refine ⟨fun h ↦ ?_, eq_of_isMinimalCosetRep_of_coroot'_eq_zero hlam hu hv hvu⟩
  -- If `v = u`, then `s_β` fixes `u λ`, and reflecting negates the pairing with `β^∨`.
  rw [h, mul_smul, RootPairing.weylGroup.ofIdx_smul, Equiv.reflection_smul] at hvu
  have hpair := congrArg (P.coroot' β) hvu
  rw [coroot'_reflection_self] at hpair
  exact self_eq_neg.mp hpair

end TauCeti
