module

public import TauCeti.LinearAlgebra.RootSystem.AffineSimpleRoot
public import TauCeti.LinearAlgebra.RootSystem.Weyl.ExtendedAffine.Alcove

/-!
# The stabilizer of the fundamental alcove acts on the affine Dynkin diagram

Let `b` be a base of a finite, reduced, irreducible, crystallographic root pairing `P` over a
linearly ordered field, with simple roots `αᵢ`, highest root `θ` and fundamental alcove

`A = {x | αᵢ(x) > 0 for every simple root αᵢ, and θ(x) < 1}`.

Its walls are the zero sets of the **affine simple roots** (`RootPairing.Base.affineSimpleRoot'`),
the affine functions on the coweight space indexed by the nodes of the affine Dynkin diagram:
`αᵢ` at a simple node `i`, and `α₀ = 1 - θ` at the affine node, developed in
`TauCeti.LinearAlgebra.RootSystem.AffineSimpleRoot`. The alcove is the set of points at which all
of them are positive (`RootPairing.Base.mem_fundamentalAlcove_iff_forall_affineSimpleRoot'_pos`),
and with the marks `mₖ` of the affine Cartan matrix they satisfy the null-root relation
`∑ₖ mₖ αₖ = 1` (`RootPairing.Base.sum_affineMarks_mul_affineSimpleRoot'`).

The stabilizer `Ω` of `A` in the extended affine Weyl group
(`RootPairing.fundamentalAlcoveStabilizer`) permutes the walls of `A`: for `ω ∈ Ω` and each node
`k` there is a unique node `σ k` with `α_{σ k} ∘ ω = αₖ`, so that `ω` carries the wall of `k` onto
the wall of `σ k`. This gives a homomorphism `RootPairing.fundamentalAlcoveStabilizerToPerm` from
`Ω` to the permutations of the nodes, whose image lies in the symmetry group of the affine Cartan
matrix (`RootPairing.fundamentalAlcoveStabilizerToPerm_mem_matrixSymmetryGroup`): `Ω` acts by
automorphisms of the affine Dynkin diagram. For a root system the action is faithful
(`RootPairing.fundamentalAlcoveStabilizerToPerm_injective`).

## The proof

An element `ω` of the extended affine Weyl group carries each affine root `αⱼ - c` to another one,
and `ω` maps `A` onto `A`, so `αₖ ∘ ω` is an affine root positive on `A`. Every affine root
positive on `A` is a nonnegative integer combination `∑ₗ nₗ αₗ` of the affine simple roots
(`RootPairing.Base.exists_root'_sub_eq_sum_nat_mul_affineSimpleRoot'`). Write
`αₖ ∘ ω = ∑ₗ nₖₗ αₗ` and evaluate at the point `x*` at which every affine simple root takes the
value `1 / h`, `h = ∑ₖ mₖ`; it exists because the simple roots take arbitrary values and
`∑ₖ mₖ αₖ = 1`. On the one hand `(αₖ ∘ ω)(x*) = (∑ₗ nₖₗ) / h`, and on the other hand
`∑ₖ mₖ (αₖ ∘ ω) = 1`. Hence `∑ₖ mₖ (∑ₗ nₖₗ) = ∑ₖ mₖ`, and since every mark is positive and every
`αₖ ∘ ω` is nonzero, each row sum `∑ₗ nₖₗ` is `1`: `αₖ ∘ ω` is a single affine simple root.
No linear independence of the affine simple roots is needed for this step.

The Cartan integers are preserved because the linear part of `ω` lies in the group generated by
the coreflections, which carries the gradient `α_{σ k}` of `α_{σ k} ∘ ω` to the gradient `αₖ` and
preserves the pairing of roots with coroots
(`RootPairing.pairing_eq_of_mem_closure_range_coreflection`).

## Main definitions

* `RootPairing.fundamentalAlcoveStabilizerToPerm`: the action of `Ω` on the nodes of the affine
  Dynkin diagram.
* `RootPairing.fundamentalAlcoveStabilizerToMatrixSymmetryGroup`: the same action, as a
  homomorphism to the symmetry group of the affine Cartan matrix.

## Main results

* `RootPairing.affineSimpleRoot'_fundamentalAlcoveStabilizerToPerm_apply`: `ω` carries the wall of
  the node `k` to the wall of the node `σ k`.
* `RootPairing.fundamentalAlcoveStabilizerToPerm_mem_matrixSymmetryGroup`: **`Ω` acts by
  symmetries of the affine Cartan matrix.**
* `RootPairing.fundamentalAlcoveStabilizerToPerm_injective`: for a root system the action is
  faithful.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4–6*, Ch. VI, §2.3 (the group `Ω` and its
  action on the extended Dynkin diagram) and §4.3 (the marks).
* N. Iwahori and H. Matsumoto, *On some Bruhat decomposition and the structure of the Hecke rings
  of p-adic Chevalley groups*, Publ. Math. IHÉS 25 (1965), §1.
-/

public section

open Set

namespace RootPairing

/-! ### The action of `Ω` on the walls of the fundamental alcove -/

variable {ι R M N : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R] [AddCommGroup M]
  [Module R M] [AddCommGroup N] [Module R N] {P : RootPairing ι R M N} [Finite ι] [Nonempty ι]
  (b : P.Base) [P.IsCrystallographic] [P.IsReduced] [P.IsIrreducible]

/-- For `f ∈ Ω` and a node `l`, the affine function `αₗ ∘ f` is a nonzero nonnegative integer
combination of the affine simple roots: it is an affine root, and it is positive on the
fundamental alcove because `f` maps the alcove onto itself. -/
private theorem exists_affineSimpleRoot'_apply_eq_sum {f : N ≃ᵃ[R] N}
    (hf : f ∈ P.fundamentalAlcoveStabilizer b) (l : Option b.support) :
    ∃ n : Option b.support → ℕ, 0 < ∑ l', n l' ∧
      ∀ x, b.affineSimpleRoot' l (f x) = ∑ l', (n l' : R) * b.affineSimpleRoot' l' x := by
  obtain ⟨hfW, hfA⟩ := (P.mem_fundamentalAlcoveStabilizer b).mp hf
  obtain ⟨x₀, hx₀⟩ := fundamentalAlcove_nonempty b
  have hpos := b.mem_fundamentalAlcove_iff_forall_affineSimpleRoot'_pos.mp
    (hfA ▸ mem_image_of_mem f hx₀) l
  obtain ⟨j, c, hjc⟩ := b.exists_affineSimpleRoot'_eq l
  obtain ⟨j', m, hj'⟩ := P.exists_root'_apply_eq_add_intCast_of_mem_extendedAffineWeylGroup hfW j
  have heq (x : N) : b.affineSimpleRoot' l (f x) = P.root' j' x - ((c - m : ℤ) : R) := by
    rw [hjc, hj']
    push_cast
    ring
  rw [heq] at hpos
  obtain ⟨n, hn⟩ := b.exists_root'_sub_eq_sum_nat_mul_affineSimpleRoot' hx₀ (sub_pos.mp hpos)
  refine ⟨n, Nat.pos_of_ne_zero fun h0 ↦ ?_, fun x ↦ (heq x).trans (hn x)⟩
  -- If every coefficient vanished, `αₗ ∘ f` would vanish at `x₀`.
  have h0' (l' : Option b.support) : n l' = 0 :=
    Finset.sum_eq_zero_iff.mp h0 l' (Finset.mem_univ _)
  rw [hn x₀] at hpos
  simp [h0'] at hpos

/-- **An element of the stabilizer of the fundamental alcove carries each wall to a wall**: for
`f ∈ Ω` and a node `k`, the affine function `αₖ ∘ f` is the affine simple root of some node.

Write `αₗ ∘ f = ∑ₗ' nₗₗ' αₗ'` for every node `l`. Evaluating the null-root relation
`∑ₗ mₗ (αₗ ∘ f) = 1` at the point where every affine simple root is `1 / h` gives
`∑ₗ mₗ (∑ₗ' nₗₗ') = ∑ₗ mₗ`; as every mark and every row sum is positive, each row sum is `1`. -/
private theorem exists_affineSimpleRoot'_apply_eq {f : N ≃ᵃ[R] N}
    (hf : f ∈ P.fundamentalAlcoveStabilizer b) (k : Option b.support) :
    ∃ l, ∀ x, b.affineSimpleRoot' k (f x) = b.affineSimpleRoot' l x := by
  classical
  choose n hpos hn using exists_affineSimpleRoot'_apply_eq_sum b hf
  -- Every row sum `∑ₗ' nₗₗ'` is `1`.
  have hrow (l : Option b.support) : ∑ l', n l l' = 1 := by
    obtain ⟨y, hy⟩ := b.exists_forall_affineSimpleRoot'_eq
    have hh : ∑ k, (b.affineMarks k : R) ≠ 0 := by
      rw [← Int.cast_sum]
      exact_mod_cast b.sum_affineMarks_pos.ne'
    have hrel := b.sum_affineMarks_mul_affineSimpleRoot' (f y)
    simp only [hn, hy, ← Finset.sum_mul, ← Nat.cast_sum] at hrel
    have hsumR : ∑ l, (b.affineMarks l : R) * ((∑ l', n l l' : ℕ) : R) =
        ∑ l, (b.affineMarks l : R) := by
      have := congrArg (· * ∑ k, (b.affineMarks k : R)) hrel
      simpa only [one_mul, Finset.sum_mul, mul_assoc, inv_mul_cancel₀ hh, mul_one] using this
    have hsumZ : ∑ l, b.affineMarks l * ((∑ l', n l l' : ℕ) : ℤ) = ∑ l, b.affineMarks l := by
      exact_mod_cast hsumR
    have hle : ∀ l ∈ Finset.univ, b.affineMarks l ≤ b.affineMarks l * ((∑ l', n l l' : ℕ) : ℤ) :=
      fun l _ ↦ le_mul_of_one_le_right (b.affineMarks_pos l).le (by exact_mod_cast hpos l)
    have := (Finset.sum_eq_sum_iff_of_le hle).mp hsumZ.symm l (Finset.mem_univ _)
    have h1 : ((∑ l', n l l' : ℕ) : ℤ) = 1 :=
      mul_left_cancel₀ (b.affineMarks_pos l).ne' (this.symm.trans (mul_one _).symm)
    exact_mod_cast h1
  -- A row with sum `1` has a single nonzero entry, equal to `1`.
  obtain ⟨l, -, hl⟩ := Finset.exists_ne_zero_of_sum_ne_zero
    (show ∑ l', n k l' ≠ 0 by rw [hrow k]; exact one_ne_zero)
  have hl1 : n k l = 1 := by
    have := Finset.single_le_sum (f := n k) (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ l)
    rw [hrow k] at this
    omega
  have hrest (l' : Option b.support) (hl' : l' ≠ l) : n k l' = 0 := by
    have := Finset.add_sum_erase Finset.univ (n k) (Finset.mem_univ l)
    rw [hrow k, hl1, add_eq_left, Finset.sum_eq_zero_iff] at this
    exact this l' (Finset.mem_erase.mpr ⟨hl', Finset.mem_univ _⟩)
  refine ⟨l, fun x ↦ ?_⟩
  rw [hn k x, Finset.sum_eq_single l (fun l' _ hl' ↦ by simp [hrest l' hl']) (by simp), hl1,
    Nat.cast_one, one_mul]

/-- For `ω ∈ Ω` and a node `k`, there is a unique node `l` whose wall `ω` carries the wall of `k`
onto: `αₗ ∘ ω = αₖ`. -/
private theorem existsUnique_affineSimpleRoot'_apply_eq (ω : P.fundamentalAlcoveStabilizer b)
    (k : Option b.support) :
    ∃! l, ∀ x, b.affineSimpleRoot' l (ω.1 x) = b.affineSimpleRoot' k x := by
  obtain ⟨l, hl⟩ := exists_affineSimpleRoot'_apply_eq b (ω⁻¹).2 k
  refine ⟨l, fun x ↦ ?_, fun l' hl' ↦ b.affineSimpleRoot'_injective (funext fun y ↦ ?_)⟩
  · rw [← hl]
    simp [AffineEquiv.inv_def]
  · have := hl' (ω.1.symm y)
    rw [AffineEquiv.apply_symm_apply] at this
    rw [this, ← hl]
    simp [AffineEquiv.inv_def]

/-- The node to whose wall `ω` carries the wall of `k`. -/
private noncomputable def wallMap (ω : P.fundamentalAlcoveStabilizer b) (k : Option b.support) :
    Option b.support :=
  (existsUnique_affineSimpleRoot'_apply_eq b ω k).exists.choose

private theorem wallMap_eq_iff {ω : P.fundamentalAlcoveStabilizer b} {k l : Option b.support} :
    wallMap b ω k = l ↔ ∀ x, b.affineSimpleRoot' l (ω.1 x) = b.affineSimpleRoot' k x := by
  have h := existsUnique_affineSimpleRoot'_apply_eq b ω k
  exact ⟨fun hl ↦ hl ▸ h.exists.choose_spec, fun hl ↦ h.unique h.exists.choose_spec hl⟩

private theorem affineSimpleRoot'_wallMap (ω : P.fundamentalAlcoveStabilizer b)
    (k : Option b.support) (x : N) :
    b.affineSimpleRoot' (wallMap b ω k) (ω.1 x) = b.affineSimpleRoot' k x :=
  (wallMap_eq_iff b).mp rfl x

private theorem wallMap_inv_wallMap (ω : P.fundamentalAlcoveStabilizer b) (k : Option b.support) :
    wallMap b ω⁻¹ (wallMap b ω k) = k :=
  (wallMap_eq_iff b).mpr fun x ↦ by
    rw [← affineSimpleRoot'_wallMap b ω k ((ω⁻¹).1 x)]
    simp [AffineEquiv.inv_def]

variable (P) in
/-- **The action of the stabilizer `Ω` of the fundamental alcove on the nodes of the affine Dynkin
diagram**: `ω ∈ Ω` sends the node `k` to the node whose wall is the image under `ω` of the wall of
`k`, so that `α_{σ k} ∘ ω = αₖ` for the affine simple roots
(`RootPairing.affineSimpleRoot'_fundamentalAlcoveStabilizerToPerm_apply`). -/
noncomputable def fundamentalAlcoveStabilizerToPerm :
    P.fundamentalAlcoveStabilizer b →* Equiv.Perm (Option b.support) where
  toFun ω :=
    { toFun := wallMap b ω
      invFun := wallMap b ω⁻¹
      left_inv := wallMap_inv_wallMap b ω
      right_inv k := by simpa using wallMap_inv_wallMap b ω⁻¹ k }
  map_one' := _root_.Equiv.ext fun k ↦ (wallMap_eq_iff b).mpr fun x ↦ rfl
  map_mul' ω₁ ω₂ := _root_.Equiv.ext fun k ↦ (wallMap_eq_iff b).mpr fun x ↦ by
    simp only [Equiv.coe_fn_mk, Equiv.Perm.coe_mul, Function.comp_apply, Subgroup.coe_mul,
      AffineEquiv.coe_mul]
    rw [affineSimpleRoot'_wallMap, affineSimpleRoot'_wallMap]

/-- **An element `ω` of `Ω` carries the wall of the node `k` onto the wall of the node `σ k`**:
`α_{σ k} ∘ ω = αₖ` for the affine simple roots. -/
@[simp]
theorem affineSimpleRoot'_fundamentalAlcoveStabilizerToPerm_apply
    (ω : P.fundamentalAlcoveStabilizer b) (k : Option b.support) (x : N) :
    b.affineSimpleRoot' (P.fundamentalAlcoveStabilizerToPerm b ω k) (ω.1 x) =
      b.affineSimpleRoot' k x :=
  affineSimpleRoot'_wallMap b ω k x

/-- The node `σ k` is characterized by `α_{σ k} ∘ ω = αₖ`. -/
theorem fundamentalAlcoveStabilizerToPerm_apply_eq_iff {ω : P.fundamentalAlcoveStabilizer b}
    {k l : Option b.support} :
    P.fundamentalAlcoveStabilizerToPerm b ω k = l ↔
      ∀ x, b.affineSimpleRoot' l (ω.1 x) = b.affineSimpleRoot' k x :=
  wallMap_eq_iff b

/-- **The stabilizer of the fundamental alcove acts by symmetries of the affine Cartan matrix**:
the permutation of the nodes induced by `ω ∈ Ω` preserves every Cartan integer `⟨αₖ, αₗ^∨⟩` of the
affine simple roots, so it is an automorphism of the affine Dynkin diagram. -/
theorem fundamentalAlcoveStabilizerToPerm_mem_matrixSymmetryGroup
    (ω : P.fundamentalAlcoveStabilizer b) :
    P.fundamentalAlcoveStabilizerToPerm b ω ∈
      TauCeti.matrixSymmetryGroup b.affineCartanMatrix := by
  set σ := P.fundamentalAlcoveStabilizerToPerm b ω
  -- The linear part of `ω` carries the gradient of `α_{σ k}` to that of `αₖ`.
  have hlin (k : Option b.support) (x : N) :
      P.root' (b.affineSimpleRootIndex (σ k)) (ω.1.linear x) =
        P.root' (b.affineSimpleRootIndex k) x := by
    have h := b.affineSimpleRoot'_sub_affineSimpleRoot' (σ k) (ω.1 x) (ω.1 0)
    simp only [σ, affineSimpleRoot'_fundamentalAlcoveStabilizerToPerm_apply,
      b.affineSimpleRoot'_sub_affineSimpleRoot', sub_zero] at h
    rw [h, AffineEquiv.apply_eq_linear_add ω.1 x, add_sub_cancel_right]
  have hw := (P.mem_extendedAffineWeylGroup_iff.mp
    (P.fundamentalAlcoveStabilizer_le_extendedAffineWeylGroup b ω.2)).1
  rw [TauCeti.mem_matrixSymmetryGroup_iff]
  ext k l
  rw [Matrix.submatrix_apply, b.affineCartanMatrix_apply, b.affineCartanMatrix_apply,
    ← (FaithfulSMul.algebraMap_injective ℤ R).eq_iff, algebraMap_pairingIn, algebraMap_pairingIn]
  exact (P.pairing_eq_of_mem_closure_range_coreflection hw (hlin k) (hlin l)).symm

variable (P) in
/-- The action of the stabilizer of the fundamental alcove on the nodes of the affine Dynkin
diagram, as a homomorphism to the symmetry group of the affine Cartan matrix. -/
noncomputable def fundamentalAlcoveStabilizerToMatrixSymmetryGroup :
    P.fundamentalAlcoveStabilizer b →* TauCeti.matrixSymmetryGroup b.affineCartanMatrix :=
  (P.fundamentalAlcoveStabilizerToPerm b).codRestrict _
    (fundamentalAlcoveStabilizerToPerm_mem_matrixSymmetryGroup b)

@[simp]
lemma coe_fundamentalAlcoveStabilizerToMatrixSymmetryGroup_apply
    (ω : P.fundamentalAlcoveStabilizer b) :
    (P.fundamentalAlcoveStabilizerToMatrixSymmetryGroup b ω : Equiv.Perm (Option b.support)) =
      P.fundamentalAlcoveStabilizerToPerm b ω :=
  (rfl)

/-- **For a root system, `Ω` acts faithfully on the affine Dynkin diagram**: an element fixing
every wall of the fundamental alcove is the identity, since the simple roots then take the same
values at `x` and at `ω x`, and they determine a point of the coweight space. -/
theorem fundamentalAlcoveStabilizerToPerm_injective [P.IsRootSystem] :
    Function.Injective (P.fundamentalAlcoveStabilizerToPerm b) := by
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro ω hω
  rw [MonoidHom.mem_ker] at hω
  rw [Subgroup.mem_bot]
  refine Subtype.ext (AffineEquiv.ext fun x ↦ ?_)
  -- Every simple root takes the same value at `ω x` and at `x`.
  have hsimple (i : ι) (hi : i ∈ b.support) : P.root' i (ω.1 x - x) = 0 := by
    have := affineSimpleRoot'_fundamentalAlcoveStabilizerToPerm_apply b ω (some ⟨i, hi⟩) x
    rw [hω, Equiv.Perm.coe_one, id, Base.affineSimpleRoot'_some,
      Base.affineSimpleRoot'_some] at this
    rw [map_sub, this, sub_self]
  -- Hence so does every root, and the roots span the weight space.
  have hall (j : ι) : P.toLinearMap.flip (ω.1 x - x) (P.root j) = 0 := by
    obtain ⟨f, -, -, hf⟩ := b.exists_root_eq_sum_int j
    rw [LinearMap.flip_apply, hf, map_sum, LinearMap.coe_sum, Finset.sum_apply]
    exact Finset.sum_eq_zero fun i hi ↦ by
      rw [map_zsmul, LinearMap.smul_apply, ← root', hsimple i hi, smul_zero]
  have hzero : P.toLinearMap.flip (ω.1 x - x) = 0 :=
    LinearMap.ext_on_range IsRootSystem.span_root_eq_top fun j ↦ by simpa using hall j
  have := (LinearMap.IsPerfPair.bijective_right P.toLinearMap).1
    (hzero.trans (map_zero _).symm)
  simpa [sub_eq_zero] using this

end RootPairing
