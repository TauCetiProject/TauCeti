public import Mathlib.Geometry.Convex.Cone.Pointed

/-!
# Integral root dominance

`RootPairing.rootLE P b x y` means that `y - x` belongs to the additive monoid generated by
`b`'s simple roots. This is an explicit relation, not an order instance on the ambient module.
It is translation invariant and antisymmetric, and on integral simple-root coordinates it is
coordinatewise comparison. In particular, it is not the order obtained by saturating the root
monoid: a fraction of a simple root need not be an allowed increment.

The relation is defined on the whole weight module, with no spanning assumption, so central
directions are retained. For coweights use `P.flip` and `b.flip`; the increments are then
literally natural sums of simple coroots. Based equivalences preserve and reflect comparison.
Integral comparison implies rational-cone comparison; the converse is proved only when the
difference has integral simple-root coordinates.

## References

* M. Rapoport, *A positivity property of the Satake isomorphism*, Manuscripta Math. 101 (2000),
  153–166, §1, equation (1.8), and §2.
-/

public section

namespace RootPairing

open TauCeti

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N] (P : RootPairing ι R M N) (b : P.Base)

/-- Integral root dominance: the difference is a natural sum of simple roots.
No saturation of the positive root monoid is taken. -/
def rootLE (x y : M) : Prop := y - x ∈ posRootCone P b

/-- The defining positive-monoid criterion for integral root dominance. -/
theorem rootLE_iff_sub_mem_posRootCone {x y : M} :
    P.rootLE b x y ↔ y - x ∈ posRootCone P b := Iff.rfl

/-- Comparison is equivalent to a natural simple-root expansion of the difference. -/
theorem rootLE_iff_exists_nat {x y : M} :
    P.rootLE b x y ↔ ∃ n : ι → ℕ, y - x = ∑ i ∈ b.support, n i • P.root i :=
  mem_posRootCone P b

/-- Every weight is below itself in integral root dominance. -/
@[simp]
theorem rootLE_refl (x : M) : P.rootLE b x x := by
  simp [rootLE]

/-- The weights above zero are exactly the members of the positive root monoid. -/
@[simp]
theorem rootLE_zero_left_iff (x : M) : P.rootLE b 0 x ↔ x ∈ posRootCone P b := by
  simp [rootLE]

/-- Integral root dominance is transitive. -/
theorem rootLE_trans {x y z : M} (hxy : P.rootLE b x y) (hyz : P.rootLE b y z) :
    P.rootLE b x z := by
  rw [rootLE] at *
  simpa only [sub_add_sub_cancel] using (posRootCone P b).add_mem hyz hxy

/-- Translating both endpoints leaves integral comparison unchanged. -/
@[simp]
theorem rootLE_add_right_iff (x y z : M) :
    P.rootLE b (x + z) (y + z) ↔ P.rootLE b x y := by
  simp [rootLE]

/-- Translating both endpoints on the left leaves integral comparison unchanged. -/
@[simp]
theorem rootLE_add_left_iff (x y z : M) :
    P.rootLE b (z + x) (z + y) ↔ P.rootLE b x y := by
  simpa only [add_comm z] using P.rootLE_add_right_iff b x y z

/-- Integral root dominance is compatible with adding comparisons. -/
theorem rootLE_add {x₁ y₁ x₂ y₂ : M} (h₁ : P.rootLE b x₁ y₁)
    (h₂ : P.rootLE b x₂ y₂) : P.rootLE b (x₁ + x₂) (y₁ + y₂) := by
  rw [rootLE] at *
  simpa only [add_sub_add_comm] using (posRootCone P b).add_mem h₁ h₂

/-- Negation reverses integral root dominance. -/
@[simp]
theorem rootLE_neg_iff (x y : M) : P.rootLE b (-x) (-y) ↔ P.rootLE b y x := by
  simp [rootLE, sub_eq_add_neg, add_comm]

/-- The dual relation uses natural simple-coroot sums, with no change of normalization. -/
theorem rootLE_flip_iff_exists_nat {x y : N} :
    P.flip.rootLE b.flip x y ↔
      ∃ n : ι → ℕ, y - x = ∑ i ∈ b.support, n i • P.coroot i :=
  P.flip.rootLE_iff_exists_nat b.flip

/-- With empty simple support, comparison is equality, even in a nonzero ambient module. -/
theorem rootLE_iff_eq_of_support_eq_empty (hb : b.support = ∅) {x y : M} :
    P.rootLE b x y ↔ x = y := by
  simp [rootLE_iff_exists_nat, hb, sub_eq_zero, eq_comm]

variable [CharZero R]

/-- Pointedness of the integral root monoid makes integral dominance antisymmetric. -/
theorem rootLE_antisymm {x y : M} (hxy : P.rootLE b x y) (hyx : P.rootLE b y x) :
    x = y := by
  rw [rootLE] at hxy hyx
  have hz := (isPointed_posRootCone P b).eq_zero_of_mem_of_neg_mem hxy
    (by simpa only [neg_sub] using hyx)
  exact (sub_eq_zero.mp hz).symm

/-- Integral comparison in both directions is equality. -/
@[simp]
theorem rootLE_antisymm_iff (x y : M) :
    (P.rootLE b x y ∧ P.rootLE b y x) ↔ x = y := by
  constructor
  · rintro ⟨hxy, hyx⟩
    exact P.rootLE_antisymm b hxy hyx
  · rintro rfl
    simp

/-- On integral simple-root coordinates, integral dominance is coordinatewise comparison.
The coordinates are indexed only by the simple support, so none are unconstrained. -/
theorem rootLE_sum_int_iff (a c : b.support → ℤ) :
    P.rootLE b (∑ i, a i • P.root i) (∑ i, c i • P.root i) ↔ ∀ i, a i ≤ c i := by
  classical
  rw [rootLE_iff_sub_mem_posRootCone,
    mem_posRootCone_iff_exists_nat_of_bijOn P b
      (by simpa using (Set.injOn_subtype_val (s := Set.univ (α := b.support))).bijOn_image)]
  constructor
  · rintro ⟨n, hn⟩
    have heq : ∑ i : b.support, (c i - a i) • P.root i =
        ∑ i : b.support, (n i : ℤ) • P.root i := by
      simpa only [sub_smul, Finset.sum_sub_distrib, natCast_zsmul] using hn
    have he := Fintype.linearIndependent_iffₛ.mp
      (b.linearIndepOn_root.restrict_scalars' ℤ) _ _ heq
    intro i
    have := he i
    omega
  · intro h
    refine ⟨fun i ↦ (c i - a i).toNat, ?_⟩
    simp only [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i _
    rw [← sub_smul, ← natCast_zsmul, Int.toNat_of_nonneg (sub_nonneg.mpr (h i))]

section Equiv

variable {P b}
omit [CharZero R]

variable {ι₂ M₂ N₂ : Type*} [AddCommGroup M₂] [Module R M₂]
  [AddCommGroup N₂] [Module R N₂] {Q : RootPairing ι₂ R M₂ N₂}

/-- A based equivalence transports integral root dominance in both directions.
The hypothesis states exactly that its index equivalence preserves the simple support. -/
theorem Equiv.rootLE_weightMap_iff (e : P.Equiv Q) (c : Q.Base)
    (hbase : ∀ i, e.indexEquiv i ∈ c.support ↔ i ∈ b.support) (x y : M) :
    Q.rootLE c (e.weightMap x) (e.weightMap y) ↔ P.rootLE b x y := by
  classical
  have hbij : Set.BijOn (fun i : b.support ↦ e.indexEquiv i) Set.univ c.support := by
    refine ⟨fun i _ ↦ (hbase i).mpr i.property, ?_, ?_⟩
    · intro i _ j _ hij
      exact Subtype.ext (e.indexEquiv.injective hij)
    · intro j hj
      obtain ⟨i, rfl⟩ := e.indexEquiv.surjective j
      exact ⟨⟨i, (hbase i).mp hj⟩, trivial, rfl⟩
  rw [rootLE_iff_sub_mem_posRootCone, rootLE_iff_sub_mem_posRootCone,
    mem_posRootCone_iff_exists_nat_of_bijOn Q c hbij,
    mem_posRootCone_iff_exists_nat_of_bijOn P b
      (by simpa using (Set.injOn_subtype_val (s := Set.univ (α := b.support))).bijOn_image)]
  apply exists_congr
  intro n
  have hsum : e.weightMap (∑ i : b.support, n i • P.root i) =
      ∑ i : b.support, n i • Q.root (e.indexEquiv i) := by
    simp only [map_sum, map_nsmul, Hom.root_weightMap_apply]
  rw [← hsum, ← map_sub, e.bijective_weightMap.injective.eq_iff]

end Equiv

section RationalCone

variable [Module ℚ M]

omit [CharZero R] in
/-- Integral comparison implies comparison in the rational positive cone. -/
theorem sub_mem_hull_of_rootLE {x y : M} (h : P.rootLE b x y) :
    y - x ∈ PointedCone.hull ℚ (P.root '' (b.support : Set ι)) := by
  obtain ⟨n, hn⟩ := (P.rootLE_iff_exists_nat b).mp h
  rw [hn]
  let C := PointedCone.hull ℚ (P.root '' (b.support : Set ι))
  exact C.sum_mem fun i hi ↦
    C.toAddSubmonoid.nsmul_mem (PointedCone.subset_hull ⟨i, hi, rfl⟩) (n i)

variable [Algebra ℚ R] [IsScalarTower ℚ R M]

/-- Rational comparison detects integral dominance when the difference has integral
simple-root coordinates. The condition concerns the difference, not the endpoints. -/
theorem rootLE_iff_sub_mem_hull_of_eq_sum_int {x y : M} (z : b.support → ℤ)
    (hz : y - x = ∑ i, z i • P.root i) :
    P.rootLE b x y ↔ y - x ∈ PointedCone.hull ℚ (P.root '' (b.support : Set ι)) := by
  classical
  refine ⟨P.sub_mem_hull_of_rootLE b, fun h ↦ ?_⟩
  obtain ⟨q, hq⟩ := (Submodule.mem_span_image_finset_iff_exists_fun' (Nonneg ℚ)).mp h
  have heq : ∑ i : b.support, (z i : ℚ) • P.root i =
      ∑ i : b.support, (q i : ℚ) • P.root i := by
    calc
      _ = y - x := by simpa only [Int.cast_smul_eq_zsmul] using hz.symm
      _ = _ := by
        rw [Finset.sum_coe_sort b.support (fun i ↦ (q i : ℚ) • P.root i)]
        simpa only [Nonneg.coe_smul] using hq.symm
  have he := Fintype.linearIndependent_iffₛ.mp
    (b.linearIndepOn_root.restrict_scalars' ℚ) _ _ heq
  have hnonneg (i : b.support) : 0 ≤ z i := by
    have hi : (0 : ℚ) ≤ z i := (he i).symm ▸ (q i).property
    exact_mod_cast hi
  have hc := (P.rootLE_sum_int_iff b 0 z).mpr hnonneg
  simpa only [Pi.zero_apply, zero_smul, Finset.sum_const_zero, rootLE, sub_zero, ← hz] using hc

end RationalCone

end RootPairing
