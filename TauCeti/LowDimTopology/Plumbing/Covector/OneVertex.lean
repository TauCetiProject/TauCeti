/-!
# The completed lattice homology of the `(-1)`-framed vertex

The one-vertex plumbing with framing `-1` (`TauCeti.oneVertexPlumbing (-1)`) is the disc bundle
over the sphere with Euler number `-1`, whose boundary is the three-sphere. This file computes its
completed lattice homology over `𝔽₂[[U]]`
(`TauCeti.PlumbingGraph.completedCovectorHomology`): it is a single `𝔽₂[[U]]`-tower,

`𝔽₂[[U]] ≅ ℍ̂(P)` (`TauCeti.powerSeriesEquivOneVertexPlumbingNegOneCompletedCovectorHomology`),

generated by the class of the generator `[K₀, ∅]` of the canonical characteristic covector
`K₀ = -1`. This agrees with the completed minus Heegaard Floer homology of `S³`.

The characteristic covectors are the odd integers `2 m + 1`, all spin^c equivalent, and the
generators are the `[2 m + 1, ∅]` and `[2 m + 1, {v}]`. Since `2 v* = -2` and
`f_K(v) = (K - 1) / 2`, the differential of a one-dimensional generator is

`∂ [2 m + 1, {v}] = U ^ max(0, -m) [2 m + 1, ∅] + U ^ max(0, m) [2 m - 1, ∅]`,

so the complex is a zigzag along the odd integers, with exponents growing in both directions from
the two generators `[±1, ∅]`, which are joined by `∂ [1, {v}] = [1, ∅] + [-1, ∅]`. Write
`a_m` and `b_m` for the components of a completed chain at `[2 m + 1, ∅]` and `[2 m + 1, {v}]`.
The component of its differential at `[2 m + 1, ∅]` is
`U ^ max(0, -m) b_m + U ^ max(0, m + 1) b_{m + 1}`, and all its components at one-dimensional
generators vanish.

* **No cycles of dimension one.** If the differential vanishes at every `[2 m + 1, ∅]` other than
  `[-1, ∅]`, then `b_m = U ^ (m + 1) b_{m + 1}` for `m ≥ 0` and `b_m = U ^ (1 - m) b_{m - 1}` for
  `m ≤ -1`, so every `b_m` is divisible by every power of `U` and vanishes
  (`PowerSeries.eq_zero_of_forall_eq_X_pow_mul`). In particular every completed cycle is supported
  on the zero-dimensional generators
  (`TauCeti.oneVertexPlumbing_neg_one_apply_eq_zero_of_completedCovectorDifferential_eq_zero`),
  and a multiple of `[K₀, ∅]` that is a boundary is the boundary of a cycle, hence zero.
* **Every zero-chain is a multiple of `[K₀, ∅]` up to a boundary.** Given the `a_m`, the equations
  `a_m = b_m + U ^ (m + 1) b_{m + 1}` for `m ≥ 0` and `a_m = U ^ (-m) b_m + b_{m + 1}` for
  `m ≤ -2` are recursions running away from `[±1, ∅]` with positive exponents. They have
  `U`-adically convergent solutions (`PowerSeries.existsUnique_forall_eq_add_X_pow_mul`), and the
  remaining equation at `m = -1` determines the multiple of `[K₀, ∅]`.

The second step is where the completion enters: a completed zero-chain may have infinitely many
nonzero components, and the `b_m` are then infinite series in `U`. The finite-support computation
of the lattice homology of a one-vertex plumbing, over `𝔽₂[U]` and in Némethi's model, is
`TauCeti.coefficientEquivOneVertexPlumbingLatticeHomology`.

## Main results

* `TauCeti.oneVertexPlumbing_neg_one_apply_eq_zero_of_completedCovectorDifferential_eq_zero`:
  every completed cycle vanishes on the one-dimensional generators.
* `TauCeti.oneVertexPlumbing_neg_one_completedCovectorHomologyCycleMap_bijective`: the class of
  `[K₀, ∅]` freely generates the completed lattice homology over `𝔽₂[[U]]`.
* `TauCeti.powerSeriesEquivOneVertexPlumbingNegOneCompletedCovectorHomology`: the completed lattice
  homology is `𝔽₂[[U]]`.

## References

* I. Zemke, *The equivalence of lattice and Heegaard Floer homology*,
  [arXiv:2111.14962](https://arxiv.org/abs/2111.14962), §2.3 (the complex on the generators
  `[K, E]` over `𝔽[[U]]`).
* P. Ozsváth and Z. Szabó, *Holomorphic disks and topological invariants for closed
  three-manifolds*, Ann. of Math. 159 (2004), [arXiv:math/0101206](https://arxiv.org/abs/math/0101206)
  (the Heegaard Floer homology of `S³`, a single tower).
-/

public section

open PowerSeries

namespace TauCeti

/-! ### The characteristic covectors and generators -/

/-- The characteristic covector `2 m + 1` of the `(-1)`-framed vertex. -/
private def oddCovector (m : ℤ) : (oneVertexPlumbing (-1)).characteristicVectors :=
  ⟨fun _ => 2 * m + 1, ((oneVertexPlumbing (-1)).isCharacteristicVector_iff _).2 fun _ => by
    rw [oneVertexPlumbing_weight, Int.ModEq]
    omega⟩

private theorem oddCovector_val_zero (m : ℤ) : (oddCovector m).val 0 = 2 * m + 1 :=
  (rfl)

private theorem oddCovector_injective : Function.Injective oddCovector := fun m n h => by
  have := congrArg (fun K : (oneVertexPlumbing (-1)).characteristicVectors => K.val 0) h
  simp only [oddCovector_val_zero] at this
  omega

/-- Every characteristic covector of the `(-1)`-framed vertex is odd. -/
private theorem exists_oddCovector_eq (K : (oneVertexPlumbing (-1)).characteristicVectors) :
    ∃ m, oddCovector m = K := by
  have hK := ((oneVertexPlumbing (-1)).isCharacteristicVector_iff K.val).1 K.property 0
  rw [oneVertexPlumbing_weight, Int.ModEq] at hK
  refine ⟨K.val 0 / 2, Subtype.ext (funext fun i => ?_)⟩
  rw [Subsingleton.elim i 0, oddCovector_val_zero]
  omega

/-- The canonical characteristic covector `-weight - 2` of the `(-1)`-framed vertex is `-1`. -/
private theorem canonicalCharacteristic_eq_oddCovector :
    (⟨_, (oneVertexPlumbing (-1)).isCharacteristicVector_canonicalCharacteristic⟩ :
      (oneVertexPlumbing (-1)).characteristicVectors) = oddCovector (-1) := by
  refine Subtype.ext (funext fun i => ?_)
  simp [oddCovector]

/-- Shifting by `2 v* = -2` lowers the index of an odd covector by one. -/
private theorem addTwoMulVec_oddCovector (m : ℤ) :
    (oneVertexPlumbing (-1)).addTwoMulVec (oddCovector m) (Pi.single 0 1) =
      oddCovector (m - 1) := by
  refine Subtype.ext (funext fun i => ?_)
  rw [Subsingleton.elim i 0]
  simp [oddCovector, Matrix.mulVec, dotProduct]
  ring

/-- Every generator of the `(-1)`-framed vertex is `[2 m + 1, ∅]` or `[2 m + 1, {v}]`. -/
private theorem exists_covectorCube_eq (C : (oneVertexPlumbing (-1)).CovectorCube) :
    ∃ m, C = ⟨oddCovector m, ∅⟩ ∨ C = ⟨oddCovector m, {0}⟩ := by
  obtain ⟨K, E⟩ := C
  obtain ⟨m, rfl⟩ := exists_oddCovector_eq K
  refine ⟨m, ?_⟩
  rcases Finset.subset_singleton_iff.1
    (show E ⊆ {0} from fun i _ => Finset.mem_singleton.2 (Subsingleton.elim i 0)) with h | h <;>
    simp [h]

private theorem covectorCube_mk_empty_ne_mk_singleton
    (K L : (oneVertexPlumbing (-1)).characteristicVectors) :
    (⟨K, ∅⟩ : (oneVertexPlumbing (-1)).CovectorCube) ≠ ⟨L, {0}⟩ := by
  simp

/-! ### The differential -/

/-- The differential of the one-dimensional generator `[2 m + 1, {v}]` is
`U ^ max(0, -m) [2 m + 1, ∅] + U ^ max(0, m) [2 m - 1, ∅]`. -/
private theorem covectorDifferentialOnGenerator_oddCovector_singleton (m : ℤ) :
    (oneVertexPlumbing (-1)).covectorDifferentialOnGenerator ⟨oddCovector m, {0}⟩ =
      Finsupp.single ⟨oddCovector m, ∅⟩ (Polynomial.X ^ (-m).toNat) +
        Finsupp.single ⟨oddCovector (m - 1), ∅⟩ (Polynomial.X ^ m.toNat) := by
  have h := (oneVertexPlumbing (-1)).covectorDifferential_single_mk_singleton (oddCovector m) 0
  have hm : ((oddCovector m).val 0 + (oneVertexPlumbing (-1)).weight 0) / 2 = m := by
    rw [oddCovector_val_zero, oneVertexPlumbing_weight]
    omega
  rwa [PlumbingGraph.covectorDifferential_single, one_smul, hm, addTwoMulVec_oddCovector] at h

/-- The coefficient of `[2 m + 1, ∅]` in the differential of `[2 j + 1, {v}]`: it is
`U ^ max(0, -m)` for `j = m`, `U ^ max(0, m + 1)` for `j = m + 1`, and `0` otherwise. -/
private theorem covectorDifferentialOnGenerator_oddCovector_singleton_apply (j m : ℤ) :
    (oneVertexPlumbing (-1)).covectorDifferentialOnGenerator ⟨oddCovector j, {0}⟩
        ⟨oddCovector m, ∅⟩ =
      (if j = m then Polynomial.X ^ (-m).toNat else 0) +
        (if j = m + 1 then Polynomial.X ^ (m + 1).toNat else 0) := by
  classical
  rw [covectorDifferentialOnGenerator_oddCovector_singleton, Finsupp.add_apply,
    Finsupp.single_apply, Finsupp.single_apply]
  simp only [PlumbingGraph.CovectorCube.mk.injEq, oddCovector_injective.eq_iff, and_true]
  congr 1
  · by_cases h : j = m
    · simp [h]
    · simp [h]
  · by_cases h : j = m + 1
    · simp [h]
    · simp [h, show ¬ j - 1 = m by omega]

/-- No differential of a generator involves a one-dimensional generator. -/
private theorem covectorDifferentialOnGenerator_apply_singleton
    (C : (oneVertexPlumbing (-1)).CovectorCube)
    (K : (oneVertexPlumbing (-1)).characteristicVectors) :
    (oneVertexPlumbing (-1)).covectorDifferentialOnGenerator C ⟨K, {0}⟩ = 0 := by
  obtain ⟨j, rfl | rfl⟩ := exists_covectorCube_eq C
  · simp
  · rw [covectorDifferentialOnGenerator_oddCovector_singleton, Finsupp.add_apply,
      Finsupp.single_eq_of_ne (covectorCube_mk_empty_ne_mk_singleton _ _).symm,
      Finsupp.single_eq_of_ne (covectorCube_mk_empty_ne_mk_singleton _ _).symm, add_zero]

/-- The component of the completed differential at `[2 m + 1, ∅]` is
`U ^ max(0, -m) b_m + U ^ max(0, m + 1) b_{m + 1}`, where `b_j` is the component of the chain at
`[2 j + 1, {v}]`. -/
private theorem completedCovectorDifferential_apply_oddCovector_empty
    (c : (oneVertexPlumbing (-1)).CompletedCovectorChain) (m : ℤ) :
    (oneVertexPlumbing (-1)).completedCovectorDifferential c ⟨oddCovector m, ∅⟩ =
      X ^ (-m).toNat * c ⟨oddCovector m, {0}⟩ +
        X ^ (m + 1).toNat * c ⟨oddCovector (m + 1), {0}⟩ := by
  classical
  have hne : (⟨oddCovector m, {0}⟩ : (oneVertexPlumbing (-1)).CovectorCube) ≠
      ⟨oddCovector (m + 1), {0}⟩ := by
    simp [oddCovector_injective.eq_iff]
  rw [(oneVertexPlumbing (-1)).completedCovectorDifferential_apply_eq_sum c _
      (s := {⟨oddCovector m, {0}⟩, ⟨oddCovector (m + 1), {0}⟩}) fun C hC => ?_,
    Finset.sum_pair hne, covectorDifferentialOnGenerator_oddCovector_singleton_apply,
    covectorDifferentialOnGenerator_oddCovector_singleton_apply]
  · simp
  · obtain ⟨j, rfl | rfl⟩ := exists_covectorCube_eq C
    · simp at hC
    · rw [covectorDifferentialOnGenerator_oddCovector_singleton_apply] at hC
      by_cases h : j = m
      · simp [h]
      · by_cases h' : j = m + 1
        · simp [h']
        · simp [h, h'] at hC

/-- The components of the completed differential at the one-dimensional generators vanish. -/
private theorem completedCovectorDifferential_apply_singleton
    (c : (oneVertexPlumbing (-1)).CompletedCovectorChain)
    (K : (oneVertexPlumbing (-1)).characteristicVectors) :
    (oneVertexPlumbing (-1)).completedCovectorDifferential c ⟨K, {0}⟩ = 0 := by
  rw [(oneVertexPlumbing (-1)).completedCovectorDifferential_apply_eq_sum c _ (s := ∅)
    fun C hC => absurd (covectorDifferentialOnGenerator_apply_singleton C K) hC,
    Finset.sum_empty]

/-! ### Completed cycles of dimension one -/

/-- **A completed chain whose differential vanishes away from `[-1, ∅]` has no one-dimensional
components.** The vanishing components give `b_m = U ^ (m + 1) b_{m + 1}` for `m ≥ 0` and
`b_{-(k + 1)} = U ^ (k + 2) b_{-(k + 2)}` for `k ≥ 0`, homogeneous recursions with positive
exponents in both directions. -/
private theorem apply_singleton_eq_zero_of_forall_ne
    (c : (oneVertexPlumbing (-1)).CompletedCovectorChain)
    (hc : ∀ m ≠ -1,
      (oneVertexPlumbing (-1)).completedCovectorDifferential c ⟨oddCovector m, ∅⟩ = 0)
    (m : ℤ) : c ⟨oddCovector m, {0}⟩ = 0 := by
  have := charP_of_injective_ringHom (PowerSeries.C_injective (R := ZMod 2)) 2
  rcases le_or_gt 0 m with hm | hm
  · -- The components `b_k` for `k ≥ 0`.
    obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hm
    refine PowerSeries.eq_zero_of_forall_eq_X_pow_mul (b := fun k : ℕ =>
      c ⟨oddCovector k, {0}⟩) (d := fun k => k + 1) (fun _ => Nat.succ_ne_zero _)
      (fun k => ?_) k
    have h := hc k (by omega)
    rw [completedCovectorDifferential_apply_oddCovector_empty,
      show (-(k : ℤ)).toNat = 0 by omega, show ((k : ℤ) + 1).toNat = k + 1 by omega, pow_zero,
      one_mul] at h
    simpa using CharTwo.add_eq_zero.1 h
  · -- The components `b_{-(k + 1)}` for `k ≥ 0`.
    obtain ⟨k, rfl⟩ : ∃ k : ℕ, m = -((k : ℤ) + 1) := ⟨(-m - 1).toNat, by omega⟩
    refine PowerSeries.eq_zero_of_forall_eq_X_pow_mul (b := fun k : ℕ =>
      c ⟨oddCovector (-((k : ℤ) + 1)), {0}⟩) (d := fun k => k + 2) (fun _ => by omega)
      (fun k => ?_) k
    have h := hc (-((k : ℤ) + 2)) (by omega)
    rw [completedCovectorDifferential_apply_oddCovector_empty,
      show (-(-((k : ℤ) + 2))).toNat = k + 2 by omega,
      show (-((k : ℤ) + 2) + 1).toNat = 0 by omega, pow_zero, one_mul,
      show -((k : ℤ) + 2) + 1 = -((k : ℤ) + 1) by ring] at h
    rw [show -(((k + 1 : ℕ) : ℤ) + 1) = -((k : ℤ) + 2) by push_cast; ring]
    exact (CharTwo.add_eq_zero.1 h).symm

/-- **Every completed cycle of the `(-1)`-framed vertex vanishes on the one-dimensional
generators**: the completed differential is injective on the chains of the generators
`[K, {v}]`. -/
theorem oneVertexPlumbing_neg_one_apply_eq_zero_of_completedCovectorDifferential_eq_zero
    {c : (oneVertexPlumbing (-1)).CompletedCovectorChain}
    (hc : (oneVertexPlumbing (-1)).completedCovectorDifferential c = 0)
    {C : (oneVertexPlumbing (-1)).CovectorCube} (hC : C.directions.Nonempty) : c C = 0 := by
  obtain ⟨m, rfl | rfl⟩ := exists_covectorCube_eq C
  · simp at hC
  · exact apply_singleton_eq_zero_of_forall_ne c (fun m _ => by rw [hc]; rfl) m

/-! ### The completed lattice homology -/

/-- The generator `[K₀, ∅]` of the canonical characteristic covector `K₀ = -1`. -/
private abbrev canonicalCube : (oneVertexPlumbing (-1)).CovectorCube :=
  ⟨⟨_, (oneVertexPlumbing (-1)).isCharacteristicVector_canonicalCharacteristic⟩, ∅⟩

private theorem canonicalCube_eq : canonicalCube = ⟨oddCovector (-1), ∅⟩ := by
  rw [canonicalCube, canonicalCharacteristic_eq_oddCovector]

/-- **The zigzag equations of the `(-1)`-framed vertex are solvable away from `m = -1`.** For every
`a : ℤ → 𝔽₂[[U]]` there are `b_m` with `a_m = U ^ max(0, -m) b_m + U ^ max(0, m + 1) b_{m + 1}`
for all `m ≠ -1`: for `m ≥ 0` this is the recursion `b_m = a_m + U ^ (m + 1) b_{m + 1}`, and for
`m = -(k + 2)` it is `b_{-(k + 1)} = a_{-(k + 2)} + U ^ (k + 2) b_{-(k + 2)}`, both running away
from `m = -1` with positive exponents. -/
private theorem exists_forall_ne_eq_X_pow_mul_add_X_pow_mul (a : ℤ → PowerSeries (ZMod 2)) :
    ∃ b : ℤ → PowerSeries (ZMod 2), ∀ m ≠ -1,
      a m = X ^ (-m).toNat * b m + X ^ (m + 1).toNat * b (m + 1) := by
  have := charP_of_injective_ringHom (PowerSeries.C_injective (R := ZMod 2)) 2
  obtain ⟨β, hβ, -⟩ := PowerSeries.existsUnique_forall_eq_add_X_pow_mul
    (fun k : ℕ => a k) (d := fun k => k + 1) fun _ => Nat.succ_ne_zero _
  obtain ⟨γ, hγ, -⟩ := PowerSeries.existsUnique_forall_eq_add_X_pow_mul
    (fun k : ℕ => a (-((k : ℤ) + 2))) (d := fun k => k + 2) fun _ => by omega
  -- `b_k = β_k` for `k ≥ 0` and `b_{-(k + 1)} = γ_k`.
  let b : ℤ → PowerSeries (ZMod 2) := fun m => if 0 ≤ m then β m.toNat else γ (-m - 1).toNat
  have hb_nonneg (k : ℕ) : b k = β k := by simp [b]
  have hb_neg (k : ℕ) : b (-((k : ℤ) + 1)) = γ k := by
    simp only [b, show ¬ (0 ≤ -((k : ℤ) + 1)) by omega, ite_false,
      show (-(-((k : ℤ) + 1)) - 1).toNat = k by omega]
  refine ⟨b, fun m hm => ?_⟩
  rcases lt_or_gt_of_ne hm with hm | hm
  · obtain ⟨k, rfl⟩ : ∃ k : ℕ, m = -((k : ℤ) + 2) := ⟨(-m - 2).toNat, by omega⟩
    rw [show (-(-((k : ℤ) + 2))).toNat = k + 2 by omega,
      show (-((k : ℤ) + 2) + 1).toNat = 0 by omega, pow_zero, one_mul,
      show -((k : ℤ) + 2) + 1 = -((k : ℤ) + 1) by ring, hb_neg,
      show b (-((k : ℤ) + 2)) = γ (k + 1) by rw [← hb_neg (k + 1)]; push_cast; ring_nf, hγ k]
    linear_combination -CharTwo.add_self_eq_zero (X ^ (k + 2) * γ (k + 1))
  · obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le (show 0 ≤ m by omega)
    rw [show (-(k : ℤ)).toNat = 0 by omega, show ((k : ℤ) + 1).toNat = k + 1 by omega, pow_zero,
      one_mul, show (k : ℤ) + 1 = ((k + 1 : ℕ) : ℤ) by omega, hb_nonneg, hb_nonneg, hβ k]
    linear_combination -CharTwo.add_self_eq_zero (X ^ (k + 1) * β (k + 1))

/-- Modulo completed boundaries, every completed cycle is a multiple of `[K₀, ∅]`. It has no
one-dimensional components, and its zero-dimensional components `a_m` are matched by the
boundary of a chain with one-dimensional components `b_m` solving the zigzag equations away from
`m = -1`; the remaining equation at `m = -1` fixes the multiple. -/
private theorem exists_sub_smul_single_canonicalCube_mem_range
    [DecidableEq (oneVertexPlumbing (-1)).CovectorCube]
    {z : (oneVertexPlumbing (-1)).CompletedCovectorChain}
    (hz : (oneVertexPlumbing (-1)).completedCovectorDifferential z = 0) :
    ∃ φ : PowerSeries (ZMod 2), z - φ • Pi.single canonicalCube 1 ∈
      LinearMap.range (oneVertexPlumbing (-1)).completedCovectorDifferential := by
  obtain ⟨b, hb⟩ := exists_forall_ne_eq_X_pow_mul_add_X_pow_mul fun m => z ⟨oddCovector m, ∅⟩
  -- A completed chain with components `b_m` at `[2 m + 1, {v}]`; its components at the
  -- zero-dimensional generators do not enter its differential.
  obtain ⟨w, hw⟩ : ∃ w : (oneVertexPlumbing (-1)).CompletedCovectorChain,
      ∀ m, w ⟨oddCovector m, {0}⟩ = b m :=
    ⟨fun C => b ((C.covector.val 0 - 1) / 2), fun m => congrArg b (by
      rw [oddCovector_val_zero]
      omega)⟩
  refine ⟨z ⟨oddCovector (-1), ∅⟩ - (X * b (-1) + b 0), w, funext fun C => ?_⟩
  obtain ⟨m, rfl | rfl⟩ := exists_covectorCube_eq C
  · rw [completedCovectorDifferential_apply_oddCovector_empty, hw, hw, Pi.sub_apply,
      Pi.smul_apply, canonicalCube_eq, smul_eq_mul]
    by_cases hm : m = -1
    · -- The equation at `m = -1` is the choice of the multiple of `[K₀, ∅]`.
      subst hm
      rw [Pi.single_eq_same, mul_one, show (-(-1 : ℤ)).toNat = 1 by rfl,
        show ((-1 : ℤ) + 1).toNat = 0 by rfl, pow_one, pow_zero, one_mul,
        show (-1 : ℤ) + 1 = 0 by rfl]
      ring
    · rw [Pi.single_eq_of_ne (by simpa [oddCovector_injective.eq_iff] using hm), mul_zero,
        sub_zero, ← hb m hm]
  · rw [completedCovectorDifferential_apply_singleton, Pi.sub_apply, Pi.smul_apply,
      oneVertexPlumbing_neg_one_apply_eq_zero_of_completedCovectorDifferential_eq_zero hz
        (Finset.singleton_nonempty 0),
      Pi.single_eq_of_ne (by simp [canonicalCube]), smul_zero, sub_zero]

/-- **The completed lattice homology of the `(-1)`-framed vertex is a single `𝔽₂[[U]]`-tower.**
The class of the generator `[K₀, ∅]` of the canonical characteristic covector `K₀ = -1` generates
it freely: `φ ↦ [φ [K₀, ∅]]` is a bijection from `𝔽₂[[U]]`. -/
theorem oneVertexPlumbing_neg_one_completedCovectorHomologyCycleMap_bijective
    [DecidableEq (oneVertexPlumbing (-1)).CovectorCube] :
    Function.Bijective
      ((oneVertexPlumbing (-1)).completedCovectorHomologyCycleMap
        (Pi.single ⟨⟨_, (oneVertexPlumbing (-1)).isCharacteristicVector_canonicalCharacteristic⟩,
          ∅⟩ 1)
        ((oneVertexPlumbing (-1)).completedCovectorDifferential_single_mk_empty _ 1)) := by
  refine ⟨(injective_iff_map_eq_zero _).2 fun φ hφ => ?_,
    (oneVertexPlumbing (-1)).completedCovectorHomologyCycleMap_surjective _ _
      fun z hz => exists_sub_smul_single_canonicalCube_mem_range hz⟩
  -- If `φ [K₀, ∅] = ∂ w`, then `∂ w` vanishes away from `[K₀, ∅]`, so `w` has no
  -- one-dimensional components and `∂ w = 0`.
  rw [PlumbingGraph.completedCovectorHomologyCycleMap_apply_eq_zero_iff] at hφ
  obtain ⟨w, hw⟩ := hφ
  have hw0 : ∀ m, w ⟨oddCovector m, {0}⟩ = 0 :=
    apply_singleton_eq_zero_of_forall_ne w fun m hm => by
      rw [hw, Pi.smul_apply, Pi.single_eq_of_ne (by
        rw [← canonicalCube, canonicalCube_eq]
        simpa [oddCovector_injective.eq_iff] using hm), smul_zero]
  have h := congrFun hw canonicalCube
  rw [Pi.smul_apply, Pi.single_eq_same, smul_eq_mul, mul_one, canonicalCube_eq,
    completedCovectorDifferential_apply_oddCovector_empty, hw0, hw0, mul_zero, mul_zero,
    add_zero] at h
  exact h.symm

/-- **The completed lattice homology of the `(-1)`-framed vertex is `𝔽₂[[U]]`**, the class of the
generator `[K₀, ∅]` of the canonical characteristic covector corresponding to `1`. The boundary of
this plumbing is the three-sphere, whose completed minus Heegaard Floer homology is likewise a
single `𝔽₂[[U]]`-tower. -/
noncomputable def powerSeriesEquivOneVertexPlumbingNegOneCompletedCovectorHomology
    [DecidableEq (oneVertexPlumbing (-1)).CovectorCube] :
    PowerSeries (ZMod 2) ≃ₗ[PowerSeries (ZMod 2)]
      (oneVertexPlumbing (-1)).completedCovectorHomology :=
  LinearEquiv.ofBijective _ oneVertexPlumbing_neg_one_completedCovectorHomologyCycleMap_bijective

/-- The isomorphism `𝔽₂[[U]] ≅ ℍ̂` sends `φ` to the class of `φ [K₀, ∅]`. -/
@[simp]
theorem powerSeriesEquivOneVertexPlumbingNegOneCompletedCovectorHomology_apply
    [DecidableEq (oneVertexPlumbing (-1)).CovectorCube] (φ : PowerSeries (ZMod 2)) :
    powerSeriesEquivOneVertexPlumbingNegOneCompletedCovectorHomology φ =
      (oneVertexPlumbing (-1)).completedCovectorHomologyCycleMap
        (Pi.single ⟨⟨_, (oneVertexPlumbing (-1)).isCharacteristicVector_canonicalCharacteristic⟩,
          ∅⟩ 1)
        ((oneVertexPlumbing (-1)).completedCovectorDifferential_single_mk_empty _ 1) φ :=
  (rfl)

end TauCeti
