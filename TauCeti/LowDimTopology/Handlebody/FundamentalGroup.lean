/-!
# The fundamental group of a handlebody

The fundamental group of the standard handlebody of genus `g`, `TauCeti.handlebody g`, is free of
rank `g`, at every base point. Consequently it is generated by `g` elements, which is the input
for the inequality between the rank of the fundamental group of a closed orientable `3`-manifold
and its Heegaard genus: the fundamental group of the manifold is a quotient of that of either
handlebody of a Heegaard splitting.

The handlebody is the product of the planar surface `TauCeti.planarSurface g` with an interval, so
it is homotopy equivalent to the planar surface. The planar surface, a closed disc of radius
`g + 1` with `g` open discs of radius `1 / 2` removed about the real points `2k + 1 - g`, is a weak
deformation retract of the plane punctured at those `g` points: points inside a hole are pushed
radially out from its centre to its boundary circle, points outside the big disc are pushed
radially in to its boundary circle, and all other points stay put. The fundamental group of the
punctured plane is free on the punctures
(`TauCeti.nonempty_fundamentalGroup_compl_mulEquiv_freeGroup`).

The boundary surface of the handlebody, its frontier in `ℂ × ℝ`, carries its fundamental group:
the handlebody deformation retracts vertically onto its top face, which lies in the boundary
surface. Moreover the boundary surface is a deformation retract of an open neighbourhood of it in
the handlebody, namely the complement of a core sheet at height `0`, at distance at least `1 / 4`
from the boundary circles of the planar surface. Near the boundary circles, the deformation
moves points radially towards the nearest circle and vertically away from height `0`, along rays
from the edge of the core sheet; elsewhere it moves points vertically. These are the inputs for
the Seifert–van Kampen argument showing that the fundamental group of either handlebody of a
Heegaard splitting surjects onto that of the manifold.

## Main results

* `TauCeti.nonempty_fundamentalGroup_planarSurface_mulEquiv_freeGroup`: the fundamental group of
  the closed disc with `g` holes is free of rank `g`.
* `TauCeti.nonempty_fundamentalGroup_handlebody_mulEquiv_freeGroup`: the fundamental group of the
  standard handlebody of genus `g` is free of rank `g`.
* `TauCeti.rank_fundamentalGroup_handlebody_le`: it is generated by `g` elements.
* `TauCeti.isPathConnected_frontier_handlebody`: the boundary surface is path connected.
* `TauCeti.exists_deformation_frontier_handlebody`: the boundary surface is a deformation retract
  of an open, path connected neighbourhood of it in the handlebody.
* `TauCeti.fundamentalGroup_map_frontier_handlebody_surjective`: the inclusion of the boundary
  surface induces a surjection of fundamental groups.

## References

* J. Hempel, *3-Manifolds*, Annals of Mathematics Studies 86, Princeton University Press (1976),
  Chapter 2.
* A. Hatcher, *Algebraic Topology*, Cambridge University Press, 2002, Section 1.2 (the
  fundamental group of the plane minus finitely many points), and Chapter 0, Exercise 4 (weak
  deformation retractions).
-/

public section

noncomputable section

open Set Metric
open scoped ContinuousMap

namespace TauCeti

variable {g : ℕ}

/-! ### The centres of the holes -/

variable (g) in
/-- The centre `2k + 1 - g` of the `k`-th hole of `TauCeti.planarSurface g`. -/
private def holeCenter (k : Fin g) : ℝ := 2 * k + 1 - g

private theorem mem_planarSurface_iff {z : ℂ} :
    z ∈ planarSurface g ↔ ‖z‖ ≤ g + 1 ∧ ∀ k, 2⁻¹ ≤ ‖z - holeCenter g k‖ := by
  simp only [mem_planarSurface, holeCenter]

private theorem norm_holeCenter_le (k : Fin g) : ‖(holeCenter g k : ℂ)‖ ≤ g - 1 := by
  have hk : ((k : ℕ) : ℝ) + 1 ≤ g := by exact_mod_cast k.isLt
  have hk₀ : (0 : ℝ) ≤ (k : ℕ) := Nat.cast_nonneg _
  rw [Complex.norm_real, Real.norm_eq_abs, abs_le, holeCenter]
  constructor <;> linarith

private theorem two_le_abs_holeCenter_sub {i j : Fin g} (hij : i ≠ j) :
    2 ≤ |holeCenter g i - holeCenter g j| := by
  have h : (i : ℕ) ≠ j := Fin.val_injective.ne hij
  rcases h.lt_or_gt with h | h
  · have h' : ((i : ℕ) : ℝ) + 1 ≤ (j : ℕ) := by exact_mod_cast h
    rw [abs_sub_comm, abs_of_nonneg] <;> simp only [holeCenter] <;> linarith
  · have h' : ((j : ℕ) : ℝ) + 1 ≤ (i : ℕ) := by exact_mod_cast h
    rw [abs_of_nonneg] <;> simp only [holeCenter] <;> linarith

private theorem two_le_norm_holeCenter_sub {i j : Fin g} (hij : i ≠ j) :
    2 ≤ ‖(holeCenter g i : ℂ) - holeCenter g j‖ := by
  rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
  exact two_le_abs_holeCenter_sub hij

private theorem injective_holeCenter : Function.Injective fun k : Fin g ↦ (holeCenter g k : ℂ) :=
  fun i j hij ↦ by_contra fun h ↦ by
    have := two_le_norm_holeCenter_sub h
    rw [show (holeCenter g i : ℂ) = holeCenter g j from hij, sub_self, norm_zero] at this
    norm_num at this

private theorem mem_compl_range_iff {z : ℂ} :
    z ∈ (range fun k ↦ (holeCenter g k : ℂ))ᶜ ↔ ∀ k, z ≠ holeCenter g k := by
  simp [eq_comm]

private theorem planarSurface_subset_compl_range :
    planarSurface g ⊆ (range fun k ↦ (holeCenter g k : ℂ))ᶜ := by
  intro z hz
  refine mem_compl_range_iff.2 fun k hzk ↦ ?_
  have := (mem_planarSurface_iff.1 hz).2 k
  rw [hzk, sub_self, norm_zero] at this
  norm_num at this

/-! ### Pushing the punctured plane onto the planar surface -/

variable (g) in
/-- Radial projection of the plane onto the closed disc of radius `g + 1`. -/
private def clamp (z : ℂ) : ℂ := (((g : ℝ) + 1) / max ((g : ℝ) + 1) ‖z‖) • z

variable (g) in
/-- The radial push of the points inside each hole out to the boundary circle of the hole; it
vanishes outside the holes. -/
private def holePush (z : ℂ) : ℂ :=
  ∑ k : Fin g, (max (2⁻¹ / ‖z - holeCenter g k‖) 1 - 1) • (z - holeCenter g k)

variable (g) in
/-- The straight-line deformation from the identity to `clamp + holePush`. -/
private def retract (p : unitInterval × ℂ) : ℂ :=
  p.2 + (p.1 : ℝ) • (clamp g p.2 + holePush g p.2 - p.2)

private theorem clamp_eq_self {z : ℂ} (hz : ‖z‖ ≤ g + 1) : clamp g z = z := by
  have hR : (0 : ℝ) < g + 1 := by positivity
  rw [clamp, max_eq_left hz, div_self hR.ne', one_smul]

private theorem holePush_eq_zero {z : ℂ} (hz : ∀ k, 2⁻¹ ≤ ‖z - holeCenter g k‖) :
    holePush g z = 0 := by
  refine Finset.sum_eq_zero fun k _ ↦ ?_
  rw [max_eq_right (div_le_one_of_le₀ (hz k) (norm_nonneg _)), sub_self, zero_smul]

private theorem holePush_eq {z : ℂ} {k : Fin g} (hk : ‖z - holeCenter g k‖ < 2⁻¹)
    (hzk : z ≠ holeCenter g k) :
    holePush g z = (2⁻¹ / ‖z - holeCenter g k‖ - 1) • (z - holeCenter g k) := by
  have ha : 0 < ‖z - holeCenter g k‖ := norm_pos_iff.2 (sub_ne_zero.2 hzk)
  rw [holePush, Finset.sum_eq_single k, max_eq_left ((one_lt_div ha).2 hk).le]
  · intro j _ hjk
    have h := two_le_norm_holeCenter_sub hjk
    have := norm_sub_le_norm_sub_add_norm_sub (holeCenter g j : ℂ) z (holeCenter g k)
    rw [norm_sub_rev (holeCenter g j : ℂ) z] at this
    rw [max_eq_right (div_le_one_of_le₀ (by linarith) (norm_nonneg _)), sub_self, zero_smul]
  · simp

/-- Inside the `k`-th hole the deformation moves radially away from its centre, reaching the
boundary circle at time `1`. -/
private theorem norm_retract_sub_holeCenter {z : ℂ} {k : Fin g}
    (hk : ‖z - holeCenter g k‖ < 2⁻¹) (hzk : z ≠ holeCenter g k) (t : unitInterval) :
    ‖retract g (t, z) - holeCenter g k‖ =
      ‖z - holeCenter g k‖ + t * (2⁻¹ - ‖z - holeCenter g k‖) := by
  have ha : 0 < ‖z - holeCenter g k‖ := norm_pos_iff.2 (sub_ne_zero.2 hzk)
  have hz : ‖z‖ ≤ g + 1 := by
    have := norm_le_norm_add_norm_sub' z (holeCenter g k : ℂ)
    linarith [norm_holeCenter_le k]
  have h : retract g (t, z) - holeCenter g k =
      (1 + (t : ℝ) * (2⁻¹ / ‖z - holeCenter g k‖ - 1)) • (z - holeCenter g k) := by
    rw [retract, clamp_eq_self hz, holePush_eq hk hzk, add_sub_cancel_left, add_smul, one_smul,
      smul_smul]
    abel
  have hc : 0 ≤ 1 + (t : ℝ) * (2⁻¹ / ‖z - holeCenter g k‖ - 1) := by
    have := (one_lt_div ha).2 hk
    nlinarith [t.2.1]
  rw [h, norm_smul, Real.norm_eq_abs, abs_of_nonneg hc]
  field_simp

/-- Outside the closed disc of radius `g + 1` the deformation moves radially inwards, reaching
the boundary circle at time `1`. -/
private theorem norm_retract_of_lt {z : ℂ} (hz : g + 1 < ‖z‖) (t : unitInterval) :
    ‖retract g (t, z)‖ = (1 - (t : ℝ)) * ‖z‖ + t * ((g : ℝ) + 1) := by
  have hz₀ : 0 < ‖z‖ := lt_trans (by positivity) hz
  have hholes : ∀ k, 2⁻¹ ≤ ‖z - holeCenter g k‖ := fun k ↦ by
    have := norm_sub_norm_le z (holeCenter g k : ℂ)
    linarith [norm_holeCenter_le k]
  have h : retract g (t, z) = ((1 - (t : ℝ)) + t * (((g : ℝ) + 1) / ‖z‖)) • z := by
    rw [retract, holePush_eq_zero hholes, add_zero, clamp, max_eq_right hz.le]
    module
  have hc : 0 ≤ (1 - (t : ℝ)) + t * (((g : ℝ) + 1) / ‖z‖) :=
    add_nonneg (sub_nonneg.2 t.2.2) (mul_nonneg t.2.1 (by positivity))
  rw [h, norm_smul, Real.norm_eq_abs, abs_of_nonneg hc]
  field_simp

/-- The deformation fixes the planar surface. -/
private theorem retract_of_mem {z : ℂ} (hz : z ∈ planarSurface g) (t : unitInterval) :
    retract g (t, z) = z := by
  rw [mem_planarSurface_iff] at hz
  rw [retract, clamp_eq_self hz.1, holePush_eq_zero hz.2]
  simp

/-- The deformation of a point that is in no hole and outside the big disc stays away from the
hole centres. -/
private theorem two_le_norm_retract_sub_of_lt {z : ℂ} (hz : g + 1 < ‖z‖) (t : unitInterval)
    (j : Fin g) : 2 ≤ ‖retract g (t, z) - holeCenter g j‖ := by
  have h := norm_retract_of_lt hz t
  have := norm_sub_norm_le (retract g (t, z)) (holeCenter g j : ℂ)
  have hj := norm_holeCenter_le j
  nlinarith [t.2.1, t.2.2]

/-- Within a hole, the deformation stays at distance at least `3 / 2` from the other centres. -/
private theorem norm_retract_sub_holeCenter_ne {z : ℂ} {k j : Fin g}
    (hk : ‖z - holeCenter g k‖ < 2⁻¹) (hzk : z ≠ holeCenter g k) (hjk : j ≠ k)
    (t : unitInterval) : 3 / 2 ≤ ‖retract g (t, z) - holeCenter g j‖ := by
  have h := norm_retract_sub_holeCenter hk hzk t
  have hjk' := two_le_norm_holeCenter_sub hjk
  have := norm_sub_le_norm_sub_add_norm_sub (holeCenter g j : ℂ) (retract g (t, z))
    (holeCenter g k)
  rw [norm_sub_rev (holeCenter g j : ℂ) (retract g (t, z))] at this
  nlinarith [t.2.1, t.2.2]

private theorem retract_mem_compl_range {z : ℂ}
    (hz : z ∈ (range fun k ↦ (holeCenter g k : ℂ))ᶜ) (t : unitInterval) :
    retract g (t, z) ∈ (range fun k ↦ (holeCenter g k : ℂ))ᶜ := by
  rw [mem_compl_range_iff] at hz ⊢
  intro j hj
  by_cases hhole : ∃ k, ‖z - holeCenter g k‖ < 2⁻¹
  · obtain ⟨k, hk⟩ := hhole
    rcases eq_or_ne j k with rfl | hjk
    · have h := norm_retract_sub_holeCenter hk (hz j) t
      rw [hj, sub_self, norm_zero] at h
      have ha : 0 < ‖z - holeCenter g j‖ := norm_pos_iff.2 (sub_ne_zero.2 (hz j))
      nlinarith [t.2.1]
    · have h := norm_retract_sub_holeCenter_ne hk (hz k) hjk t
      rw [hj, sub_self, norm_zero] at h
      norm_num at h
  · simp only [not_exists, not_lt] at hhole
    by_cases hR : ‖z‖ ≤ g + 1
    · rw [retract, clamp_eq_self hR, holePush_eq_zero hhole] at hj
      exact hz j (by simpa using hj)
    · have h := two_le_norm_retract_sub_of_lt (not_le.1 hR) t j
      rw [hj, sub_self, norm_zero] at h
      norm_num at h

private theorem retract_one_mem {z : ℂ} (hz : z ∈ (range fun k ↦ (holeCenter g k : ℂ))ᶜ) :
    retract g (1, z) ∈ planarSurface g := by
  rw [mem_compl_range_iff] at hz
  rw [mem_planarSurface_iff]
  by_cases hhole : ∃ k, ‖z - holeCenter g k‖ < 2⁻¹
  · obtain ⟨k, hk⟩ := hhole
    have h := norm_retract_sub_holeCenter hk (hz k) 1
    simp only [Set.Icc.coe_one, one_mul, add_sub_cancel] at h
    refine ⟨?_, fun j ↦ ?_⟩
    · have := norm_le_norm_add_norm_sub' (retract g (1, z)) (holeCenter g k : ℂ)
      linarith [norm_holeCenter_le k]
    · rcases eq_or_ne j k with rfl | hjk
      · exact h.ge
      · linarith [norm_retract_sub_holeCenter_ne hk (hz k) hjk 1]
  · simp only [not_exists, not_lt] at hhole
    by_cases hR : ‖z‖ ≤ g + 1
    · rw [retract_of_mem (mem_planarSurface_iff.2 ⟨hR, hhole⟩)]
      exact ⟨hR, hhole⟩
    · refine ⟨?_, fun j ↦ ?_⟩
      · rw [norm_retract_of_lt (not_le.1 hR)]
        simp
      · linarith [two_le_norm_retract_sub_of_lt (not_le.1 hR) 1 j]

private theorem continuous_retract :
    Continuous fun p : unitInterval × ↥(range fun k ↦ (holeCenter g k : ℂ))ᶜ ↦
      retract g (p.1, p.2) := by
  have hR : (0 : ℝ) < g + 1 := by positivity
  unfold retract clamp holePush
  fun_prop (disch := first
    | exact fun _ ↦ (lt_max_of_lt_left hR).ne'
    | exact fun p ↦ norm_ne_zero_iff.2 (sub_ne_zero.2 (mem_compl_range_iff.1 p.2.2 _)))

/-- The closed disc with `g` holes is homotopy equivalent to the plane punctured at the centres of
its holes, by inclusion. -/
private def planarSurfaceHomotopyEquiv :
    planarSurface g ≃ₕ ↥(range fun k ↦ (holeCenter g k : ℂ))ᶜ :=
  .ofWeakDeformationRetraction planarSurface_subset_compl_range (fun p ↦ retract g (p.1, p.2))
    continuous_retract (fun p ↦ retract_mem_compl_range p.2.2 p.1)
    (fun _ ↦ by simp [retract])
    (fun z ↦ retract_one_mem z.2)
    (fun t _ hz ↦ by rwa [retract_of_mem hz t])

/-! ### The fundamental groups -/

instance : PathConnectedSpace (planarSurface g) :=
  have : PathConnectedSpace ↥(range fun k ↦ (holeCenter g k : ℂ))ᶜ :=
    isPathConnected_iff_pathConnectedSpace.1 <|
      (countable_range _).isPathConnected_compl_of_one_lt_rank (by simp)
  planarSurfaceHomotopyEquiv.symm.pathConnectedSpace

/-- **The fundamental group of the closed disc with `g` holes is free of rank `g`**, at every base
point. -/
theorem nonempty_fundamentalGroup_planarSurface_mulEquiv_freeGroup (z : planarSurface g) :
    Nonempty (FundamentalGroup (planarSurface g) z ≃* FreeGroup (Fin g)) := by
  obtain ⟨e⟩ := planarSurfaceHomotopyEquiv.nonempty_fundamentalGroupMulEquiv z
    (planarSurfaceHomotopyEquiv z)
  obtain ⟨f⟩ := nonempty_fundamentalGroup_compl_mulEquiv_freeGroup (finite_range _)
    (planarSurfaceHomotopyEquiv z)
  exact ⟨e.trans <| f.trans <|
    FreeGroup.freeGroupCongr (Equiv.ofInjective _ injective_holeCenter).symm⟩

/-- The standard handlebody of genus `g` is homotopy equivalent to the closed disc with `g` holes,
by projection. -/
private theorem nonempty_handlebody_homotopyEquiv :
    Nonempty (handlebody g ≃ₕ planarSurface g) := by
  have : ContractibleSpace (Icc (-1 : ℝ) 1) :=
    (convex_Icc (-1 : ℝ) 1).contractibleSpace (nonempty_Icc.2 (by norm_num))
  obtain ⟨e⟩ := ContractibleSpace.hequiv_unit (Icc (-1 : ℝ) 1)
  exact ⟨((Homeomorph.setCongr (Set.ext fun _ ↦ mem_handlebody.trans mem_prod.symm)).trans
    (Homeomorph.Set.prod _ _)).toHomotopyEquiv.trans <|
    ((ContinuousMap.HomotopyEquiv.refl _).prodCongr e).trans
      (Homeomorph.prodUnique _ _).toHomotopyEquiv⟩

instance : PathConnectedSpace (handlebody g) :=
  nonempty_handlebody_homotopyEquiv.some.symm.pathConnectedSpace

/-- **The fundamental group of the standard handlebody of genus `g` is free of rank `g`**, at
every base point. -/
theorem nonempty_fundamentalGroup_handlebody_mulEquiv_freeGroup (x : handlebody g) :
    Nonempty (FundamentalGroup (handlebody g) x ≃* FreeGroup (Fin g)) := by
  obtain ⟨e⟩ := nonempty_handlebody_homotopyEquiv (g := g)
  obtain ⟨φ⟩ := e.nonempty_fundamentalGroupMulEquiv x (e x)
  obtain ⟨ψ⟩ := nonempty_fundamentalGroup_planarSurface_mulEquiv_freeGroup (e x)
  exact ⟨φ.trans ψ⟩

instance (x : handlebody g) : Group.FG (FundamentalGroup (handlebody g) x) :=
  have e := (nonempty_fundamentalGroup_handlebody_mulEquiv_freeGroup x).some
  Group.fg_of_surjective (f := e.symm.toMonoidHom) e.symm.surjective

/-- **The fundamental group of the standard handlebody of genus `g` is generated by `g`
elements.** -/
theorem rank_fundamentalGroup_handlebody_le (x : handlebody g) :
    Group.rank (FundamentalGroup (handlebody g) x) ≤ g := by
  obtain ⟨e⟩ := nonempty_fundamentalGroup_handlebody_mulEquiv_freeGroup x
  rw [Group.rank_congr e]
  simpa using rank_freeGroup_le (Fin g)

/-! ### The boundary surface of the handlebody

The *boundary weight* of a point `z` of the planar surface measures how close `z` is to the
boundary circles: it is `1` on them and decreases linearly to `0` at distance `1 / 4` from them.
The *boundary normal* is the weight times the unit vector at `z` pointing radially towards the
nearest boundary circle. The annuli of width `1 / 4` along the different boundary circles are
disjoint, so near each circle only one term of the sums is nonzero. -/

variable (g) in
/-- The boundary weight contributed by the outer boundary circle of the planar surface. -/
private def outerWeight (z : ℂ) : ℝ := max 0 (1 - 4 * ((g : ℝ) + 1 - ‖z‖))

variable (g) in
/-- The boundary weight contributed by the boundary circle of the `k`-th hole. -/
private def holeWeight (k : Fin g) (z : ℂ) : ℝ := max 0 (1 - 4 * (‖z - holeCenter g k‖ - 2⁻¹))

variable (g) in
/-- The boundary weight: `1` on the boundary circles of the planar surface, `0` at distance at least
`1 / 4` from them. -/
private def boundaryWeight (z : ℂ) : ℝ := outerWeight g z + ∑ k, holeWeight g k z

variable (g) in
/-- The boundary weight times the unit vector pointing radially towards the nearest boundary
circle. -/
private def boundaryNormal (z : ℂ) : ℂ :=
  outerWeight g z • (max ‖z‖ 2⁻¹)⁻¹ • z -
    ∑ k, holeWeight g k z • (max ‖z - holeCenter g k‖ 2⁻¹)⁻¹ • (z - holeCenter g k)

private theorem outerWeight_nonneg (z : ℂ) : 0 ≤ outerWeight g z := le_max_left _ _

private theorem holeWeight_nonneg (k : Fin g) (z : ℂ) : 0 ≤ holeWeight g k z := le_max_left _ _

private theorem boundaryWeight_nonneg (z : ℂ) : 0 ≤ boundaryWeight g z :=
  add_nonneg (outerWeight_nonneg z) (Finset.sum_nonneg fun k _ ↦ holeWeight_nonneg k z)

private theorem outerWeight_le_boundaryWeight (z : ℂ) : outerWeight g z ≤ boundaryWeight g z :=
  le_add_of_nonneg_right (Finset.sum_nonneg fun k _ ↦ holeWeight_nonneg k z)

private theorem holeWeight_le_boundaryWeight (k : Fin g) (z : ℂ) :
    holeWeight g k z ≤ boundaryWeight g z :=
  (Finset.single_le_sum (fun j _ ↦ holeWeight_nonneg j z) (Finset.mem_univ k)).trans
    (le_add_of_nonneg_left (outerWeight_nonneg z))

@[fun_prop]
private theorem continuous_boundaryWeight : Continuous (boundaryWeight g) := by
  unfold boundaryWeight outerWeight holeWeight
  fun_prop

@[fun_prop]
private theorem continuous_boundaryNormal : Continuous (boundaryNormal g) := by
  unfold boundaryNormal outerWeight holeWeight
  fun_prop (disch := exact fun _ ↦ (lt_max_of_lt_right (by norm_num)).ne')

/-- Near the boundary circle of the `k`-th hole, only the `k`-th hole contributes. -/
private theorem boundaryWeight_hole {z : ℂ} {k : Fin g} (hk : ‖z - holeCenter g k‖ < 3 / 4) :
    boundaryWeight g z = holeWeight g k z ∧
      boundaryNormal g z =
        -(holeWeight g k z • (max ‖z - holeCenter g k‖ 2⁻¹)⁻¹ • (z - holeCenter g k)) := by
  have hz : ‖z‖ ≤ g + 3 / 4 := by
    have := norm_le_norm_add_norm_sub' z (holeCenter g k : ℂ)
    linarith [norm_holeCenter_le k]
  have hout : outerWeight g z = 0 := max_eq_left (by linarith)
  have hhole : ∀ j, j ≠ k → holeWeight g j z = 0 := fun j hjk ↦ by
    have h := two_le_norm_holeCenter_sub hjk
    have := norm_sub_le_norm_sub_add_norm_sub (holeCenter g j : ℂ) z (holeCenter g k)
    rw [norm_sub_rev (holeCenter g j : ℂ) z] at this
    exact max_eq_left (by linarith)
  refine ⟨?_, ?_⟩
  · rw [boundaryWeight, hout, zero_add, Finset.sum_eq_single k (fun j _ hjk ↦ hhole j hjk)
      (by simp)]
  · rw [boundaryNormal, hout, zero_smul, zero_sub, Finset.sum_eq_single k
      (fun j _ hjk ↦ by rw [hhole j hjk, zero_smul]) (by simp)]

/-- Near the outer boundary circle, only the outer circle contributes. -/
private theorem boundaryWeight_outer {z : ℂ} (hz : g + 3 / 4 < ‖z‖) :
    boundaryWeight g z = outerWeight g z ∧
      boundaryNormal g z = outerWeight g z • (max ‖z‖ 2⁻¹)⁻¹ • z := by
  have hhole : ∀ k, holeWeight g k z = 0 := fun k ↦ by
    have := norm_sub_norm_le z (holeCenter g k : ℂ)
    exact max_eq_left (by linarith [norm_holeCenter_le k])
  simp [boundaryWeight, boundaryNormal, hhole]

/-- Away from the boundary circles, the boundary weight and the boundary normal vanish. -/
private theorem boundaryWeight_core {z : ℂ} (hk : ∀ k, 3 / 4 ≤ ‖z - holeCenter g k‖)
    (hz : ‖z‖ ≤ g + 3 / 4) : boundaryWeight g z = 0 ∧ boundaryNormal g z = 0 := by
  have hout : outerWeight g z = 0 := max_eq_left (by linarith)
  have hhole : ∀ k, holeWeight g k z = 0 := fun k ↦ max_eq_left (by linarith [hk k])
  simp [boundaryWeight, boundaryNormal, hout, hhole]

/-- Every point of the plane is near a hole, near the outer circle, or away from both. -/
private theorem boundaryWeight_cases (z : ℂ) :
    (∃ k, ‖z - holeCenter g k‖ < 3 / 4) ∨ g + 3 / 4 < ‖z‖ ∨
      ((∀ k, 3 / 4 ≤ ‖z - holeCenter g k‖) ∧ ‖z‖ ≤ g + 3 / 4) := by
  by_cases hk : ∃ k, ‖z - holeCenter g k‖ < 3 / 4
  · exact .inl hk
  · simp only [not_exists, not_lt] at hk
    by_cases hz : g + 3 / 4 < ‖z‖
    · exact .inr (.inl hz)
    · exact .inr (.inr ⟨hk, not_lt.1 hz⟩)

/-- On the planar surface the boundary weight is at most `1`. -/
private theorem boundaryWeight_le_one {z : ℂ} (hz : z ∈ planarSurface g) :
    boundaryWeight g z ≤ 1 := by
  rw [mem_planarSurface_iff] at hz
  rcases boundaryWeight_cases (g := g) z with ⟨k, hk⟩ | hout | ⟨hk, hout⟩
  · rw [(boundaryWeight_hole hk).1, holeWeight]
    exact max_le zero_le_one (by linarith [hz.2 k])
  · rw [(boundaryWeight_outer hout).1, outerWeight]
    exact max_le zero_le_one (by linarith [hz.1])
  · rw [(boundaryWeight_core hk hout).1]
    exact zero_le_one

/-- **Moving along the boundary normal.** Moving a point `z` of the planar surface by `s / 4` times
its boundary normal, for `s ≥ 0` with `(1 + s)` times its boundary weight at most `1`, stays in the
planar surface and multiplies the boundary weight by `1 + s`. -/
private theorem boundaryNormal_step {z : ℂ} (hz : z ∈ planarSurface g) {s : ℝ} (hs : 0 ≤ s)
    (hw : (1 + s) * boundaryWeight g z ≤ 1) :
    z + (s / 4) • boundaryNormal g z ∈ planarSurface g ∧
      boundaryWeight g (z + (s / 4) • boundaryNormal g z) = (1 + s) * boundaryWeight g z := by
  rw [mem_planarSurface_iff] at hz
  rcases boundaryWeight_cases (g := g) z with ⟨k, hk⟩ | hout | ⟨hk, hout⟩
  · -- Near the `k`-th hole the point moves radially towards its centre.
    obtain ⟨hwk, hnk⟩ := boundaryWeight_hole hk
    set r := ‖z - holeCenter g k‖ with hr
    have hr₀ : 2⁻¹ ≤ r := hz.2 k
    have hmax : max r 2⁻¹ = r := max_eq_left hr₀
    have hwr : holeWeight g k z = 1 - 4 * (r - 2⁻¹) := max_eq_right (by linarith)
    rw [hwk, hwr] at hw
    have hsw : s * (1 - 4 * (r - 2⁻¹)) ≤ 4 * r - 2 := by linarith
    have hsub : z + (s / 4) • boundaryNormal g z - holeCenter g k =
        (1 - s * (1 - 4 * (r - 2⁻¹)) / (4 * r)) • (z - holeCenter g k) := by
      rw [hnk, hwr, hmax, smul_smul, smul_neg, smul_smul]
      module
    have hc : 0 ≤ 1 - s * (1 - 4 * (r - 2⁻¹)) / (4 * r) := by
      rw [sub_nonneg, div_le_one (by linarith)]
      linarith
    have hnorm : ‖z + (s / 4) • boundaryNormal g z - holeCenter g k‖ =
        r - s * (1 - 4 * (r - 2⁻¹)) / 4 := by
      rw [hsub, norm_smul, Real.norm_eq_abs, abs_of_nonneg hc, ← hr]
      field_simp
    have hk' : ‖z + (s / 4) • boundaryNormal g z - holeCenter g k‖ < 3 / 4 := by
      rw [hnorm]
      nlinarith
    refine ⟨mem_planarSurface_iff.2 ⟨?_, fun j ↦ ?_⟩, ?_⟩
    · have := norm_le_norm_add_norm_sub' (z + (s / 4) • boundaryNormal g z) (holeCenter g k : ℂ)
      linarith [norm_holeCenter_le k]
    · rcases eq_or_ne j k with rfl | hjk
      · rw [hnorm]
        linarith
      · have h := two_le_norm_holeCenter_sub hjk
        have := norm_sub_le_norm_sub_add_norm_sub (holeCenter g j : ℂ)
          (z + (s / 4) • boundaryNormal g z) (holeCenter g k)
        rw [norm_sub_rev (holeCenter g j : ℂ) (z + (s / 4) • boundaryNormal g z)] at this
        linarith
    · rw [(boundaryWeight_hole hk').1, holeWeight, hnorm, hwk, hwr, max_eq_right (by nlinarith)]
      ring
  · -- Near the outer circle the point moves radially away from the origin.
    obtain ⟨hwo, hno⟩ := boundaryWeight_outer hout
    set r := ‖z‖ with hr
    have hmax : max r 2⁻¹ = r := max_eq_left (by linarith [(Nat.cast_nonneg g : (0 : ℝ) ≤ g)])
    have hwr : outerWeight g z = 1 - 4 * ((g : ℝ) + 1 - r) := max_eq_right (by linarith)
    rw [hwo, hwr] at hw
    have hr₀ : 0 < r := by linarith [(Nat.cast_nonneg g : (0 : ℝ) ≤ g)]
    have hc : 0 ≤ 1 + s * (1 - 4 * ((g : ℝ) + 1 - r)) / (4 * r) :=
      add_nonneg zero_le_one (div_nonneg (mul_nonneg hs (by linarith)) (by linarith))
    have hnorm : ‖z + (s / 4) • boundaryNormal g z‖ = r + s * (1 - 4 * ((g : ℝ) + 1 - r)) / 4 := by
      have h : z + (s / 4) • boundaryNormal g z =
          (1 + s * (1 - 4 * ((g : ℝ) + 1 - r)) / (4 * r)) • z := by
        rw [hno, hwr, hmax, smul_smul, smul_smul]
        module
      rw [h, norm_smul, Real.norm_eq_abs, abs_of_nonneg hc, ← hr]
      field_simp
    have hout' : g + 3 / 4 < ‖z + (s / 4) • boundaryNormal g z‖ := by
      rw [hnorm]
      nlinarith
    refine ⟨mem_planarSurface_iff.2 ⟨by rw [hnorm]; linarith, fun j ↦ ?_⟩, ?_⟩
    · have := norm_sub_norm_le (z + (s / 4) • boundaryNormal g z) (holeCenter g j : ℂ)
      linarith [norm_holeCenter_le j]
    · rw [(boundaryWeight_outer hout').1, outerWeight, hnorm, hwo, hwr, max_eq_right (by nlinarith)]
      ring
  · -- Away from the boundary circles the point does not move.
    obtain ⟨hwc, hnc⟩ := boundaryWeight_core hk hout
    simp only [hnc, smul_zero, add_zero, hwc, mul_zero]
    exact ⟨mem_planarSurface_iff.2 hz, trivial⟩

/-- A point of the plane with boundary weight below `1` is an interior point of the planar
surface. -/
private theorem mem_interior_planarSurface {z : ℂ} (h : boundaryWeight g z < 1) :
    z ∈ interior (planarSurface g) := by
  have hout : ‖z‖ < g + 1 := by
    by_contra hz
    have : 1 ≤ outerWeight g z := le_max_of_le_right (by linarith)
    linarith [outerWeight_le_boundaryWeight (g := g) z]
  have hhole : ∀ k, 2⁻¹ < ‖z - holeCenter g k‖ := fun k ↦ by
    by_contra hk
    have : 1 ≤ holeWeight g k z := le_max_of_le_right (by linarith)
    linarith [holeWeight_le_boundaryWeight k z]
  refine mem_interior.2 ⟨ball 0 (g + 1) ∩ ⋂ k : Fin g, (closedBall (holeCenter g k : ℂ) 2⁻¹)ᶜ,
    fun w hw ↦ ?_,
    isOpen_ball.inter (isOpen_iInter_of_finite fun _ ↦ isClosed_closedBall.isOpen_compl),
    mem_ball_zero_iff.2 hout, mem_iInter.2 fun k ↦ ?_⟩
  · rw [mem_inter_iff, mem_ball_zero_iff, mem_iInter] at hw
    refine mem_planarSurface_iff.2 ⟨hw.1.le, fun k ↦ ?_⟩
    have := hw.2 k
    rw [mem_compl_iff, mem_closedBall, dist_eq_norm, not_le] at this
    exact this.le
  · rw [mem_compl_iff, mem_closedBall, dist_eq_norm, not_le]
    exact hhole k

/-- A point of the plane with boundary weight `1` is not an interior point of the planar surface. -/
private theorem notMem_interior_planarSurface {z : ℂ} (h : boundaryWeight g z = 1) :
    z ∉ interior (planarSurface g) := by
  intro hz
  -- If `max 0 a = 1` then `1 ≤ a`.
  have key {a : ℝ} (ha : max 0 a = 1) : 1 ≤ a := not_lt.1 fun h ↦ (max_lt zero_lt_one h).ne ha
  rcases boundaryWeight_cases (g := g) z with ⟨k, hk⟩ | hout | ⟨hk, hout⟩
  · have hr := key ((boundaryWeight_hole hk).1 ▸ h : holeWeight g k z = 1)
    have hsub : planarSurface g ⊆ (ball (holeCenter g k : ℂ) 2⁻¹)ᶜ := fun w hw ↦ by
      rw [mem_compl_iff, mem_ball, dist_eq_norm, not_lt]
      exact (mem_planarSurface_iff.1 hw).2 k
    have := interior_mono hsub hz
    rw [interior_compl, closure_ball _ (by norm_num), mem_compl_iff, mem_closedBall,
      dist_eq_norm] at this
    exact this (by linarith)
  · have hr := key ((boundaryWeight_outer hout).1 ▸ h : outerWeight g z = 1)
    have hsub : planarSurface g ⊆ closedBall 0 (g + 1) := fun w hw ↦
      mem_closedBall_zero_iff.2 (mem_planarSurface_iff.1 hw).1
    have := interior_mono hsub hz
    rw [interior_closedBall _ (by positivity), mem_ball_zero_iff] at this
    linarith
  · rw [(boundaryWeight_core hk hout).1] at h
    exact zero_ne_one h

variable (g) in
/-- The boundary level of a point of `ℂ × ℝ`: the larger of the boundary weight of its first
coordinate and the absolute value of its second. On the handlebody it is `1` exactly on the
boundary surface (`mem_frontier_handlebody_iff`) and `0` exactly on the core, the points of
height `0` at distance at least `1 / 4` from the boundary circles. -/
private def boundaryLevel (p : ℂ × ℝ) : ℝ := max (boundaryWeight g p.1) |p.2|

@[fun_prop]
private theorem continuous_boundaryLevel : Continuous (boundaryLevel g) := by
  unfold boundaryLevel
  fun_prop

private theorem boundaryLevel_le_one {p : ℂ × ℝ} (hp : p ∈ handlebody g) : boundaryLevel g p ≤ 1 :=
  max_le (boundaryWeight_le_one (mem_handlebody.1 hp).1) (abs_le.2 (mem_handlebody.1 hp).2)

private theorem isClosed_handlebody : IsClosed (handlebody g) := (isCompact_handlebody g).isClosed

/-- A point of the handlebody lies on its boundary surface exactly when its boundary level is
`1`. -/
private theorem mem_frontier_handlebody_iff {p : ℂ × ℝ} (hp : p ∈ handlebody g) :
    p ∈ frontier (handlebody g) ↔ boundaryLevel g p = 1 := by
  have hw := boundaryWeight_le_one (mem_handlebody.1 hp).1
  have ht : |p.2| ≤ 1 := abs_le.2 (mem_handlebody.1 hp).2
  have hH : handlebody g = planarSurface g ×ˢ Icc (-1) 1 :=
    Set.ext fun _ ↦ mem_handlebody.trans mem_prod.symm
  rw [isClosed_handlebody.frontier_eq, mem_sdiff, and_iff_right hp, hH, interior_prod_eq,
    interior_Icc, mem_prod, mem_Ioo, ← abs_lt, boundaryLevel]
  constructor
  · intro h
    by_contra hne
    have hlt := lt_of_le_of_ne (max_le hw ht) hne
    exact h ⟨mem_interior_planarSurface (lt_of_le_of_lt (le_max_left _ _) hlt),
      lt_of_le_of_lt (le_max_right _ _) hlt⟩
  · rintro h ⟨hint, ht'⟩
    have : boundaryWeight g p.1 = 1 :=
      le_antisymm hw (not_lt.1 fun hlt ↦ (max_lt hlt ht').ne h)
    exact notMem_interior_planarSurface this hint

variable (g) in
/-- The deformation of the handlebody minus its core onto its boundary surface: at time `τ` a
point of boundary level `m` moves along the boundary normal and vertically so that its boundary
level is multiplied by `1 + τ (m⁻¹ - 1)`. -/
private def boundaryDeform (τ : ℝ) (p : ℂ × ℝ) : ℂ × ℝ :=
  (p.1 + (τ * ((boundaryLevel g p)⁻¹ - 1) / 4) • boundaryNormal g p.1,
    (1 + τ * ((boundaryLevel g p)⁻¹ - 1)) * p.2)

/-- The deformation stays in the handlebody and multiplies the boundary level by
`1 + τ (m⁻¹ - 1)`. -/
private theorem boundaryDeform_spec {p : ℂ × ℝ} (hp : p ∈ handlebody g) (hm : 0 < boundaryLevel g p)
    {τ : ℝ} (hτ₀ : 0 ≤ τ) (hτ₁ : τ ≤ 1) :
    boundaryDeform g τ p ∈ handlebody g ∧
      boundaryLevel g (boundaryDeform g τ p) =
        (1 + τ * ((boundaryLevel g p)⁻¹ - 1)) * boundaryLevel g p := by
  set m := boundaryLevel g p with hm_def
  set s := τ * (m⁻¹ - 1) with hs_def
  have hm₁ : m ≤ 1 := boundaryLevel_le_one hp
  have hinv : 1 ≤ m⁻¹ := one_le_inv₀ hm |>.2 hm₁
  have hs : 0 ≤ s := mul_nonneg hτ₀ (by linarith)
  have hsm : (1 + s) * m ≤ 1 := by
    have : 1 + s ≤ m⁻¹ := by nlinarith
    calc (1 + s) * m ≤ m⁻¹ * m := mul_le_mul_of_nonneg_right this hm.le
      _ = 1 := inv_mul_cancel₀ hm.ne'
  have hw : (1 + s) * boundaryWeight g p.1 ≤ 1 :=
    (mul_le_mul_of_nonneg_left (le_max_left _ _) (by linarith)).trans hsm
  have ht : (1 + s) * |p.2| ≤ 1 :=
    (mul_le_mul_of_nonneg_left (le_max_right _ _) (by linarith)).trans hsm
  obtain ⟨hP, hW⟩ := boundaryNormal_step (mem_handlebody.1 hp).1 hs hw
  have habs : |(1 + s) * p.2| = (1 + s) * |p.2| := by
    rw [abs_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ 1 + s)]
  refine ⟨mem_handlebody.2 ⟨hP, abs_le.1 (habs ▸ ht)⟩, ?_⟩
  rw [boundaryLevel, boundaryDeform, hW, habs,
    ← mul_max_of_nonneg _ _ (by linarith : (0 : ℝ) ≤ 1 + s)]
  rfl

private theorem boundaryDeform_zero (p : ℂ × ℝ) : boundaryDeform g 0 p = p := by
  simp [boundaryDeform]

private theorem boundaryDeform_of_boundaryLevel_eq_one {p : ℂ × ℝ} (hp : boundaryLevel g p = 1)
    (τ : ℝ) : boundaryDeform g τ p = p := by
  simp [boundaryDeform, hp]

variable (g) in
/-- The neighbourhood of the boundary surface in the handlebody that deformation retracts onto
it: the complement of the core. -/
private def boundaryNhd : Set (handlebody g) := {x | 0 < boundaryLevel g x}

private theorem mem_boundaryNhd {x : handlebody g} : x ∈ boundaryNhd g ↔ 0 < boundaryLevel g x :=
  Iff.rfl

private theorem isOpen_boundaryNhd : IsOpen (boundaryNhd g) :=
  isOpen_lt continuous_const (continuous_boundaryLevel.comp continuous_subtype_val)

/-- The deformation of the complement of the core onto the boundary surface, as a continuous map
of subtypes. -/
private def boundaryDeformMap : C(unitInterval × boundaryNhd g, boundaryNhd g) where
  toFun q := ⟨⟨boundaryDeform g q.1 q.2,
      (boundaryDeform_spec q.2.1.2 q.2.2 q.1.2.1 q.1.2.2).1⟩, by
    rw [mem_boundaryNhd, (boundaryDeform_spec q.2.1.2 q.2.2 q.1.2.1 q.1.2.2).2]
    exact mul_pos (by nlinarith [q.1.2.1, one_le_inv₀ q.2.2 |>.2 (boundaryLevel_le_one q.2.1.2)])
      q.2.2⟩
  continuous_toFun := by
    refine (Continuous.subtype_mk (Continuous.subtype_mk ?_ _) _)
    unfold boundaryDeform
    fun_prop (disch := exact fun q ↦ q.2.2.ne')

private theorem boundaryDeformMap_apply_coe (q : unitInterval × boundaryNhd g) :
    ((boundaryDeformMap q : handlebody g) : ℂ × ℝ) = boundaryDeform g q.1 q.2 :=
  (rfl)

private theorem mem_frontier_boundaryDeformMap_one (x : boundaryNhd g) :
    ((boundaryDeformMap (1, x) : handlebody g) : ℂ × ℝ) ∈ frontier (handlebody g) := by
  rw [mem_frontier_handlebody_iff (boundaryDeformMap (1, x)).1.2, boundaryDeformMap_apply_coe]
  have h := (boundaryDeform_spec (τ := 1) x.1.2 x.2 zero_le_one le_rfl).2
  rwa [one_mul, add_sub_cancel, inv_mul_cancel₀ x.2.ne'] at h

/-! ### Path connectedness of the boundary surface -/

/-- The point `(g + 1, 1)` of the boundary surface, where the outer boundary circle meets the
top face. -/
private theorem outer_mem_planarSurface : ((g + 1 : ℝ) : ℂ) ∈ planarSurface g := by
  have hn : ‖((g + 1 : ℝ) : ℂ)‖ = g + 1 := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
  refine mem_planarSurface_iff.2 ⟨hn.le, fun k ↦ ?_⟩
  have := norm_sub_norm_le ((g + 1 : ℝ) : ℂ) (holeCenter g k : ℂ)
  linarith [norm_holeCenter_le k]

private theorem boundaryWeight_outer_point : boundaryWeight g ((g + 1 : ℝ) : ℂ) = 1 := by
  have hn : ‖((g + 1 : ℝ) : ℂ)‖ = g + 1 := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
  rw [(boundaryWeight_outer (by rw [hn]; linarith)).1, outerWeight, hn]
  norm_num

private theorem mem_frontier_of_abs_eq_one {z : ℂ} (hz : z ∈ planarSurface g) {t : ℝ}
    (ht : |t| = 1) : (z, t) ∈ frontier (handlebody g) := by
  have hp : (z, t) ∈ handlebody g := mem_handlebody.2 ⟨hz, abs_le.1 ht.le⟩
  rw [mem_frontier_handlebody_iff hp, boundaryLevel, ht]
  exact max_eq_right (boundaryWeight_le_one hz)

private theorem mem_frontier_of_boundaryWeight_eq_one {z : ℂ} (hz : z ∈ planarSurface g)
    (hw : boundaryWeight g z = 1) {t : ℝ} (ht : t ∈ Icc (-1 : ℝ) 1) :
    (z, t) ∈ frontier (handlebody g) := by
  rw [mem_frontier_handlebody_iff (mem_handlebody.2 ⟨hz, ht⟩), boundaryLevel, hw]
  exact max_eq_left (abs_le.2 ht)

/-- A vertical segment of the boundary surface. -/
private theorem joinedIn_frontier_vertical {z : ℂ} (hz : z ∈ planarSurface g)
    (hw : boundaryWeight g z = 1) {t t' : ℝ} (ht : t ∈ Icc (-1 : ℝ) 1)
    (ht' : t' ∈ Icc (-1 : ℝ) 1) : JoinedIn (frontier (handlebody g)) (z, t) (z, t') :=
  (((convex_singleton z).prod (convex_Icc (-1 : ℝ) 1)).isPathConnected
      ⟨(z, t), mem_singleton z, ht⟩).joinedIn (z, t) ⟨mem_singleton z, ht⟩ (z, t')
      ⟨mem_singleton z, ht'⟩ |>.mono fun ⟨q₁, q₂⟩ ⟨hq₁, hq₂⟩ ↦ by
    obtain rfl : q₁ = z := hq₁
    exact mem_frontier_of_boundaryWeight_eq_one hz hw hq₂

/-- A horizontal path in the top or bottom face of the boundary surface. -/
private theorem joinedIn_frontier_horizontal {z z' : ℂ} (hz : z ∈ planarSurface g)
    (hz' : z' ∈ planarSurface g) {t : ℝ} (ht : |t| = 1) :
    JoinedIn (frontier (handlebody g)) (z, t) (z', t) :=
  (((isPathConnected_iff_pathConnectedSpace.2 inferInstance).prod
      (isPathConnected_singleton t)).joinedIn (z, t) ⟨hz, mem_singleton t⟩ (z', t)
      ⟨hz', mem_singleton t⟩).mono fun ⟨q₁, q₂⟩ ⟨hq₁, hq₂⟩ ↦ by
    obtain rfl : q₂ = t := hq₂
    exact mem_frontier_of_abs_eq_one hq₁ ht

/-- **The boundary surface of the standard handlebody is path connected.** -/
theorem isPathConnected_frontier_handlebody (g : ℕ) :
    IsPathConnected (frontier (handlebody g)) := by
  have h₀ := outer_mem_planarSurface (g := g)
  have hw₀ := boundaryWeight_outer_point (g := g)
  refine ⟨(((g + 1 : ℝ) : ℂ), 1), mem_frontier_of_abs_eq_one h₀ abs_one, fun {p} hp ↦ ?_⟩
  obtain ⟨z, t⟩ := p
  have hpH : (z, t) ∈ handlebody g := isClosed_handlebody.frontier_subset hp
  obtain ⟨hz, ht⟩ := mem_handlebody.1 hpH
  have hlevel := (mem_frontier_handlebody_iff hpH).1 hp
  have hone : (1 : ℝ) ∈ Icc (-1 : ℝ) 1 := ⟨by norm_num, le_rfl⟩
  -- Every point of the boundary surface is joined to the top face, through a vertical segment
  -- over the outer circle for the bottom face and over its own position otherwise.
  rcases eq_or_ne |t| 1 with ht₁ | ht₁
  · rcases abs_eq (zero_le_one' ℝ) |>.1 ht₁ with rfl | rfl
    · exact joinedIn_frontier_horizontal h₀ hz abs_one
    · have hbot : (-1 : ℝ) ∈ Icc (-1 : ℝ) 1 := ⟨le_rfl, by norm_num⟩
      exact (joinedIn_frontier_vertical h₀ hw₀ hone hbot).trans
        (joinedIn_frontier_horizontal (t := -1) h₀ hz (by norm_num))
  · have hw : boundaryWeight g z = 1 := by
      rw [boundaryLevel] at hlevel
      rcases max_choice (boundaryWeight g z) |t| with h | h
      · rwa [h] at hlevel
      · exact absurd (h ▸ hlevel) ht₁
    exact (joinedIn_frontier_horizontal h₀ hz abs_one).trans
      (joinedIn_frontier_vertical hz hw hone ht)

/-! ### The neighbourhood deformation and the fundamental group of the boundary surface -/

/-- **The boundary surface of a handlebody is a deformation retract of a neighbourhood.** The
points of the standard handlebody of genus `g` on its frontier in `ℂ × ℝ` form a strong
deformation retract of an open, path connected neighbourhood `V` of them in the handlebody: a
homotopy `F` of `V` within `V` starts at the identity, ends on the frontier, and fixes the
frontier pointwise throughout. -/
theorem exists_deformation_frontier_handlebody (g : ℕ) :
    ∃ V : Set (handlebody g), IsOpen V ∧ IsPathConnected V ∧
      {x : handlebody g | (x : ℂ × ℝ) ∈ frontier (handlebody g)} ⊆ V ∧
      ∃ F : C(unitInterval × V, V), (∀ x, F (0, x) = x) ∧
        (∀ x, ((F (1, x) : handlebody g) : ℂ × ℝ) ∈ frontier (handlebody g)) ∧
        ∀ t (x : V), ((x : handlebody g) : ℂ × ℝ) ∈ frontier (handlebody g) → F (t, x) = x := by
  have hsub : {x : handlebody g | (x : ℂ × ℝ) ∈ frontier (handlebody g)} ⊆ boundaryNhd g :=
    fun x hx ↦ by
      rw [mem_boundaryNhd, (mem_frontier_handlebody_iff x.2).1 hx]
      exact zero_lt_one
  have hfix : ∀ t (x : boundaryNhd g), ((x : handlebody g) : ℂ × ℝ) ∈ frontier (handlebody g) →
      boundaryDeformMap (t, x) = x := fun t x hx ↦ Subtype.ext <| Subtype.ext <| by
    rw [boundaryDeformMap_apply_coe]
    exact boundaryDeform_of_boundaryLevel_eq_one ((mem_frontier_handlebody_iff x.1.2).1 hx) _
  have hconn : IsPathConnected {x : handlebody g | (x : ℂ × ℝ) ∈ frontier (handlebody g)} :=
    (isPathConnected_frontier_handlebody g).preimage_coe isClosed_handlebody.frontier_subset
  refine ⟨boundaryNhd g, isOpen_boundaryNhd, ?_, hsub, boundaryDeformMap,
    fun x ↦ Subtype.ext <| Subtype.ext <| boundaryDeform_zero _, mem_frontier_boundaryDeformMap_one,
    hfix⟩
  -- Every point of the neighbourhood is joined to the boundary surface by its deformation path.
  obtain ⟨y, hy, -⟩ := id hconn
  refine ⟨y, hsub hy, fun {x} hx ↦ ?_⟩
  have hpath : JoinedIn (boundaryNhd g) x (boundaryDeformMap (1, ⟨x, hx⟩)) :=
    ⟨⟨⟨fun t ↦ boundaryDeformMap (t, ⟨x, hx⟩),
      continuous_subtype_val.comp (boundaryDeformMap.continuous.comp
        (continuous_id.prodMk continuous_const))⟩,
      by simp [Subtype.ext_iff, boundaryDeformMap_apply_coe, boundaryDeform_zero], rfl⟩,
      fun t ↦ (boundaryDeformMap (t, ⟨x, hx⟩)).2⟩
  exact ((hconn.joinedIn y hy _ (mem_frontier_boundaryDeformMap_one ⟨x, hx⟩)).mono hsub).trans
    hpath.symm

/-- **The boundary surface carries the fundamental group of the handlebody.** At every point of
the boundary surface of the standard handlebody, the inclusion of the boundary surface induces a
surjection of fundamental groups: the handlebody deformation retracts vertically onto its top
face, which lies in the boundary surface. -/
theorem fundamentalGroup_map_frontier_handlebody_surjective
    (x : {y : handlebody g | (y : ℂ × ℝ) ∈ frontier (handlebody g)}) :
    Function.Surjective (FundamentalGroup.map
      (ContinuousMap.subtypeVal {y : handlebody g | (y : ℂ × ℝ) ∈ frontier (handlebody g)}) x) := by
  have : PathConnectedSpace {y : handlebody g | (y : ℂ × ℝ) ∈ frontier (handlebody g)} :=
    isPathConnected_iff_pathConnectedSpace.1 <|
      (isPathConnected_frontier_handlebody g).preimage_coe isClosed_handlebody.frontier_subset
  -- The top face is a weak deformation retract of the handlebody.
  have hTH : planarSurface g ×ˢ {(1 : ℝ)} ⊆ handlebody g := fun q hq ↦
    mem_handlebody.2 ⟨hq.1, by rw [mem_singleton_iff.1 hq.2]; norm_num⟩
  let e := ContinuousMap.HomotopyEquiv.ofWeakDeformationRetraction hTH
    (fun q : unitInterval × handlebody g ↦ ((q.2 : ℂ × ℝ).1,
      (q.2 : ℂ × ℝ).2 + q.1 * (1 - (q.2 : ℂ × ℝ).2))) (by fun_prop)
    (fun q ↦ by
      obtain ⟨hz, ht⟩ := mem_handlebody.1 q.2.2
      refine mem_handlebody.2 ⟨hz, ⟨?_, ?_⟩⟩ <;> nlinarith [q.1.2.1, q.1.2.2, ht.1, ht.2])
    (fun x ↦ by simp) (fun x ↦ ⟨(mem_handlebody.1 x.2).1, by simp⟩)
    (fun t x hx ↦ by
      obtain ⟨hz, ht⟩ := hx
      rw [mem_singleton_iff.1 ht]
      exact ⟨hz, by simp⟩)
  let j : C(planarSurface g ×ˢ {(1 : ℝ)},
      {y : handlebody g | (y : ℂ × ℝ) ∈ frontier (handlebody g)}) :=
    ⟨fun q ↦ ⟨⟨q, hTH q.2⟩, mem_frontier_of_abs_eq_one q.2.1
      (by rw [mem_singleton_iff.1 q.2.2, abs_one])⟩, by fun_prop⟩
  have hfac : (ContinuousMap.subtypeVal _).comp j = e.toFun := ContinuousMap.ext fun q ↦
    Subtype.ext (ContinuousMap.HomotopyEquiv.coe_ofWeakDeformationRetraction_apply _ _ _ _ _ _ _
      q).symm
  let q₀ : planarSurface g ×ˢ {(1 : ℝ)} :=
    ⟨(((g + 1 : ℝ) : ℂ), 1), outer_mem_planarSurface, mem_singleton 1⟩
  -- The bijection induced by the inclusion of the top face factors through the boundary surface.
  have hbij := e.fundamentalGroup_map_bijective q₀
  rw [← hfac, _root_.FundamentalGroup.map_comp, MonoidHom.coe_comp] at hbij
  exact FundamentalGroup.map_surjective_of_path _ (PathConnectedSpace.somePath (j q₀) x)
    hbij.2.of_comp

end TauCeti
