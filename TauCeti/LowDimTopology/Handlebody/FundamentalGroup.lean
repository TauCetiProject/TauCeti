/-!
# The fundamental group of a handlebody

The fundamental group of the standard handlebody of genus `g`, `TauCeti.handlebody g`, is free of
rank `g`, at every base point. Consequently it is generated by `g` elements, which is the input
for the inequality between the rank of the fundamental group of a closed orientable `3`-manifold
and its Heegaard genus: the fundamental group of the manifold is a quotient of that of either
handlebody of a Heegaard splitting.

The handlebody is the product of the planar surface `TauCeti.planarSurface g` with an interval, so
it is homotopy equivalent to the planar surface. The planar surface, a closed disc of radius
`g + 1` with `g` open discs of radius `1 / 2` removed about the real points `2k + 1 - g`, is a weak
deformation retract of the plane punctured at those `g` points: points inside a hole are pushed
radially out from its centre to its boundary circle, points outside the big disc are pushed
radially in to its boundary circle, and all other points stay put. The fundamental group of the
punctured plane is free on the punctures
(`TauCeti.nonempty_fundamentalGroup_compl_mulEquiv_freeGroup`).

## Main results

* `TauCeti.nonempty_fundamentalGroup_planarSurface_mulEquiv_freeGroup`: the fundamental group of
  the closed disc with `g` holes is free of rank `g`.
* `TauCeti.nonempty_fundamentalGroup_handlebody_mulEquiv_freeGroup`: the fundamental group of the
  standard handlebody of genus `g` is free of rank `g`.
* `TauCeti.rank_fundamentalGroup_handlebody_le`: it is generated by `g` elements.

## References

* J. Hempel, *3-Manifolds*, Annals of Mathematics Studies 86, Princeton University Press (1976),
  Chapter 2.
* A. Hatcher, *Algebraic Topology*, Cambridge University Press, 2002, Section 1.2 (the
  fundamental group of the plane minus finitely many points), and Chapter 0, Exercise 4 (weak
  deformation retractions).
-/

public section

noncomputable section

open Set Metric
open scoped ContinuousMap

namespace TauCeti

variable {g : ℕ}

/-! ### The centres of the holes -/

variable (g) in
/-- The centre `2k + 1 - g` of the `k`-th hole of `TauCeti.planarSurface g`. -/
private def holeCenter (k : Fin g) : ℝ := 2 * k + 1 - g

private theorem mem_planarSurface_iff {z : ℂ} :
    z ∈ planarSurface g ↔ ‖z‖ ≤ g + 1 ∧ ∀ k, 2⁻¹ ≤ ‖z - holeCenter g k‖ := by
  simp only [mem_planarSurface, holeCenter]

private theorem norm_holeCenter_le (k : Fin g) : ‖(holeCenter g k : ℂ)‖ ≤ g - 1 := by
  have hk : ((k : ℕ) : ℝ) + 1 ≤ g := by exact_mod_cast k.isLt
  have hk₀ : (0 : ℝ) ≤ (k : ℕ) := Nat.cast_nonneg _
  rw [Complex.norm_real, Real.norm_eq_abs, abs_le, holeCenter]
  constructor <;> linarith

private theorem two_le_abs_holeCenter_sub {i j : Fin g} (hij : i ≠ j) :
    2 ≤ |holeCenter g i - holeCenter g j| := by
  have h : (i : ℕ) ≠ j := Fin.val_injective.ne hij
  rcases h.lt_or_gt with h | h
  · have h' : ((i : ℕ) : ℝ) + 1 ≤ (j : ℕ) := by exact_mod_cast h
    rw [abs_sub_comm, abs_of_nonneg] <;> simp only [holeCenter] <;> linarith
  · have h' : ((j : ℕ) : ℝ) + 1 ≤ (i : ℕ) := by exact_mod_cast h
    rw [abs_of_nonneg] <;> simp only [holeCenter] <;> linarith

private theorem two_le_norm_holeCenter_sub {i j : Fin g} (hij : i ≠ j) :
    2 ≤ ‖(holeCenter g i : ℂ) - holeCenter g j‖ := by
  rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
  exact two_le_abs_holeCenter_sub hij

private theorem injective_holeCenter : Function.Injective fun k : Fin g ↦ (holeCenter g k : ℂ) :=
  fun i j hij ↦ by_contra fun h ↦ by
    have := two_le_norm_holeCenter_sub h
    rw [show (holeCenter g i : ℂ) = holeCenter g j from hij, sub_self, norm_zero] at this
    norm_num at this

private theorem mem_compl_range_iff {z : ℂ} :
    z ∈ (range fun k ↦ (holeCenter g k : ℂ))ᶜ ↔ ∀ k, z ≠ holeCenter g k := by
  simp [eq_comm]

private theorem planarSurface_subset_compl_range :
    planarSurface g ⊆ (range fun k ↦ (holeCenter g k : ℂ))ᶜ := by
  intro z hz
  refine mem_compl_range_iff.2 fun k hzk ↦ ?_
  have := (mem_planarSurface_iff.1 hz).2 k
  rw [hzk, sub_self, norm_zero] at this
  norm_num at this

/-! ### Pushing the punctured plane onto the planar surface -/

variable (g) in
/-- Radial projection of the plane onto the closed disc of radius `g + 1`. -/
private def clamp (z : ℂ) : ℂ := (((g : ℝ) + 1) / max ((g : ℝ) + 1) ‖z‖) • z

variable (g) in
/-- The radial push of the points inside each hole out to the boundary circle of the hole; it
vanishes outside the holes. -/
private def holePush (z : ℂ) : ℂ :=
  ∑ k : Fin g, (max (2⁻¹ / ‖z - holeCenter g k‖) 1 - 1) • (z - holeCenter g k)

variable (g) in
/-- The straight-line deformation from the identity to `clamp + holePush`. -/
private def retract (p : unitInterval × ℂ) : ℂ :=
  p.2 + (p.1 : ℝ) • (clamp g p.2 + holePush g p.2 - p.2)

private theorem clamp_eq_self {z : ℂ} (hz : ‖z‖ ≤ g + 1) : clamp g z = z := by
  have hR : (0 : ℝ) < g + 1 := by positivity
  rw [clamp, max_eq_left hz, div_self hR.ne', one_smul]

private theorem holePush_eq_zero {z : ℂ} (hz : ∀ k, 2⁻¹ ≤ ‖z - holeCenter g k‖) :
    holePush g z = 0 := by
  refine Finset.sum_eq_zero fun k _ ↦ ?_
  rw [max_eq_right (div_le_one_of_le₀ (hz k) (norm_nonneg _)), sub_self, zero_smul]

private theorem holePush_eq {z : ℂ} {k : Fin g} (hk : ‖z - holeCenter g k‖ < 2⁻¹)
    (hzk : z ≠ holeCenter g k) :
    holePush g z = (2⁻¹ / ‖z - holeCenter g k‖ - 1) • (z - holeCenter g k) := by
  have ha : 0 < ‖z - holeCenter g k‖ := norm_pos_iff.2 (sub_ne_zero.2 hzk)
  rw [holePush, Finset.sum_eq_single k, max_eq_left ((one_lt_div ha).2 hk).le]
  · intro j _ hjk
    have h := two_le_norm_holeCenter_sub hjk
    have := norm_sub_le_norm_sub_add_norm_sub (holeCenter g j : ℂ) z (holeCenter g k)
    rw [norm_sub_rev (holeCenter g j : ℂ) z] at this
    rw [max_eq_right (div_le_one_of_le₀ (by linarith) (norm_nonneg _)), sub_self, zero_smul]
  · simp

/-- Inside the `k`-th hole the deformation moves radially away from its centre, reaching the
boundary circle at time `1`. -/
private theorem norm_retract_sub_holeCenter {z : ℂ} {k : Fin g}
    (hk : ‖z - holeCenter g k‖ < 2⁻¹) (hzk : z ≠ holeCenter g k) (t : unitInterval) :
    ‖retract g (t, z) - holeCenter g k‖ =
      ‖z - holeCenter g k‖ + t * (2⁻¹ - ‖z - holeCenter g k‖) := by
  have ha : 0 < ‖z - holeCenter g k‖ := norm_pos_iff.2 (sub_ne_zero.2 hzk)
  have hz : ‖z‖ ≤ g + 1 := by
    have := norm_le_norm_add_norm_sub' z (holeCenter g k : ℂ)
    linarith [norm_holeCenter_le k]
  have h : retract g (t, z) - holeCenter g k =
      (1 + (t : ℝ) * (2⁻¹ / ‖z - holeCenter g k‖ - 1)) • (z - holeCenter g k) := by
    rw [retract, clamp_eq_self hz, holePush_eq hk hzk, add_sub_cancel_left, add_smul, one_smul,
      smul_smul]
    abel
  have hc : 0 ≤ 1 + (t : ℝ) * (2⁻¹ / ‖z - holeCenter g k‖ - 1) := by
    have := (one_lt_div ha).2 hk
    nlinarith [t.2.1]
  rw [h, norm_smul, Real.norm_eq_abs, abs_of_nonneg hc]
  field_simp

/-- Outside the closed disc of radius `g + 1` the deformation moves radially inwards, reaching
the boundary circle at time `1`. -/
private theorem norm_retract_of_lt {z : ℂ} (hz : g + 1 < ‖z‖) (t : unitInterval) :
    ‖retract g (t, z)‖ = (1 - (t : ℝ)) * ‖z‖ + t * ((g : ℝ) + 1) := by
  have hz₀ : 0 < ‖z‖ := lt_trans (by positivity) hz
  have hholes : ∀ k, 2⁻¹ ≤ ‖z - holeCenter g k‖ := fun k ↦ by
    have := norm_sub_norm_le z (holeCenter g k : ℂ)
    linarith [norm_holeCenter_le k]
  have h : retract g (t, z) = ((1 - (t : ℝ)) + t * (((g : ℝ) + 1) / ‖z‖)) • z := by
    rw [retract, holePush_eq_zero hholes, add_zero, clamp, max_eq_right hz.le]
    module
  have hc : 0 ≤ (1 - (t : ℝ)) + t * (((g : ℝ) + 1) / ‖z‖) :=
    add_nonneg (sub_nonneg.2 t.2.2) (mul_nonneg t.2.1 (by positivity))
  rw [h, norm_smul, Real.norm_eq_abs, abs_of_nonneg hc]
  field_simp

/-- The deformation fixes the planar surface. -/
private theorem retract_of_mem {z : ℂ} (hz : z ∈ planarSurface g) (t : unitInterval) :
    retract g (t, z) = z := by
  rw [mem_planarSurface_iff] at hz
  rw [retract, clamp_eq_self hz.1, holePush_eq_zero hz.2]
  simp

/-- The deformation of a point that is in no hole and outside the big disc stays away from the
hole centres. -/
private theorem two_le_norm_retract_sub_of_lt {z : ℂ} (hz : g + 1 < ‖z‖) (t : unitInterval)
    (j : Fin g) : 2 ≤ ‖retract g (t, z) - holeCenter g j‖ := by
  have h := norm_retract_of_lt hz t
  have := norm_sub_norm_le (retract g (t, z)) (holeCenter g j : ℂ)
  have hj := norm_holeCenter_le j
  nlinarith [t.2.1, t.2.2]

/-- Within a hole, the deformation stays at distance at least `3 / 2` from the other centres. -/
private theorem norm_retract_sub_holeCenter_ne {z : ℂ} {k j : Fin g}
    (hk : ‖z - holeCenter g k‖ < 2⁻¹) (hzk : z ≠ holeCenter g k) (hjk : j ≠ k)
    (t : unitInterval) : 3 / 2 ≤ ‖retract g (t, z) - holeCenter g j‖ := by
  have h := norm_retract_sub_holeCenter hk hzk t
  have hjk' := two_le_norm_holeCenter_sub hjk
  have := norm_sub_le_norm_sub_add_norm_sub (holeCenter g j : ℂ) (retract g (t, z))
    (holeCenter g k)
  rw [norm_sub_rev (holeCenter g j : ℂ) (retract g (t, z))] at this
  nlinarith [t.2.1, t.2.2]

private theorem retract_mem_compl_range {z : ℂ}
    (hz : z ∈ (range fun k ↦ (holeCenter g k : ℂ))ᶜ) (t : unitInterval) :
    retract g (t, z) ∈ (range fun k ↦ (holeCenter g k : ℂ))ᶜ := by
  rw [mem_compl_range_iff] at hz ⊢
  intro j hj
  by_cases hhole : ∃ k, ‖z - holeCenter g k‖ < 2⁻¹
  · obtain ⟨k, hk⟩ := hhole
    rcases eq_or_ne j k with rfl | hjk
    · have h := norm_retract_sub_holeCenter hk (hz j) t
      rw [hj, sub_self, norm_zero] at h
      have ha : 0 < ‖z - holeCenter g j‖ := norm_pos_iff.2 (sub_ne_zero.2 (hz j))
      nlinarith [t.2.1]
    · have h := norm_retract_sub_holeCenter_ne hk (hz k) hjk t
      rw [hj, sub_self, norm_zero] at h
      norm_num at h
  · simp only [not_exists, not_lt] at hhole
    by_cases hR : ‖z‖ ≤ g + 1
    · rw [retract, clamp_eq_self hR, holePush_eq_zero hhole] at hj
      exact hz j (by simpa using hj)
    · have h := two_le_norm_retract_sub_of_lt (not_le.1 hR) t j
      rw [hj, sub_self, norm_zero] at h
      norm_num at h

private theorem retract_one_mem {z : ℂ} (hz : z ∈ (range fun k ↦ (holeCenter g k : ℂ))ᶜ) :
    retract g (1, z) ∈ planarSurface g := by
  rw [mem_compl_range_iff] at hz
  rw [mem_planarSurface_iff]
  by_cases hhole : ∃ k, ‖z - holeCenter g k‖ < 2⁻¹
  · obtain ⟨k, hk⟩ := hhole
    have h := norm_retract_sub_holeCenter hk (hz k) 1
    simp only [Set.Icc.coe_one, one_mul, add_sub_cancel] at h
    refine ⟨?_, fun j ↦ ?_⟩
    · have := norm_le_norm_add_norm_sub' (retract g (1, z)) (holeCenter g k : ℂ)
      linarith [norm_holeCenter_le k]
    · rcases eq_or_ne j k with rfl | hjk
      · exact h.ge
      · linarith [norm_retract_sub_holeCenter_ne hk (hz k) hjk 1]
  · simp only [not_exists, not_lt] at hhole
    by_cases hR : ‖z‖ ≤ g + 1
    · rw [retract_of_mem (mem_planarSurface_iff.2 ⟨hR, hhole⟩)]
      exact ⟨hR, hhole⟩
    · refine ⟨?_, fun j ↦ ?_⟩
      · rw [norm_retract_of_lt (not_le.1 hR)]
        simp
      · linarith [two_le_norm_retract_sub_of_lt (not_le.1 hR) 1 j]

private theorem continuous_retract :
    Continuous fun p : unitInterval × ↥(range fun k ↦ (holeCenter g k : ℂ))ᶜ ↦
      retract g (p.1, p.2) := by
  have hR : (0 : ℝ) < g + 1 := by positivity
  unfold retract clamp holePush
  fun_prop (disch := first
    | exact fun _ ↦ (lt_max_of_lt_left hR).ne'
    | exact fun p ↦ norm_ne_zero_iff.2 (sub_ne_zero.2 (mem_compl_range_iff.1 p.2.2 _)))

/-- The closed disc with `g` holes is homotopy equivalent to the plane punctured at the centres of
its holes, by inclusion. -/
private def planarSurfaceHomotopyEquiv :
    planarSurface g ≃ₕ ↥(range fun k ↦ (holeCenter g k : ℂ))ᶜ :=
  .ofWeakDeformationRetraction planarSurface_subset_compl_range (fun p ↦ retract g (p.1, p.2))
    continuous_retract (fun p ↦ retract_mem_compl_range p.2.2 p.1)
    (fun _ ↦ by simp [retract])
    (fun z ↦ retract_one_mem z.2)
    (fun t _ hz ↦ by rwa [retract_of_mem hz t])

/-! ### The fundamental groups -/

instance : PathConnectedSpace (planarSurface g) :=
  have : PathConnectedSpace ↥(range fun k ↦ (holeCenter g k : ℂ))ᶜ :=
    isPathConnected_iff_pathConnectedSpace.1 <|
      (countable_range _).isPathConnected_compl_of_one_lt_rank (by simp)
  planarSurfaceHomotopyEquiv.symm.pathConnectedSpace

/-- **The fundamental group of the closed disc with `g` holes is free of rank `g`**, at every base
point. -/
theorem nonempty_fundamentalGroup_planarSurface_mulEquiv_freeGroup (z : planarSurface g) :
    Nonempty (FundamentalGroup (planarSurface g) z ≃* FreeGroup (Fin g)) := by
  obtain ⟨e⟩ := planarSurfaceHomotopyEquiv.nonempty_fundamentalGroupMulEquiv z
    (planarSurfaceHomotopyEquiv z)
  obtain ⟨f⟩ := nonempty_fundamentalGroup_compl_mulEquiv_freeGroup (finite_range _)
    (planarSurfaceHomotopyEquiv z)
  exact ⟨e.trans <| f.trans <|
    FreeGroup.freeGroupCongr (Equiv.ofInjective _ injective_holeCenter).symm⟩

/-- The standard handlebody of genus `g` is homotopy equivalent to the closed disc with `g` holes,
by projection. -/
private theorem nonempty_handlebody_homotopyEquiv :
    Nonempty (handlebody g ≃ₕ planarSurface g) := by
  have : ContractibleSpace (Icc (-1 : ℝ) 1) :=
    (convex_Icc (-1 : ℝ) 1).contractibleSpace (nonempty_Icc.2 (by norm_num))
  obtain ⟨e⟩ := ContractibleSpace.hequiv_unit (Icc (-1 : ℝ) 1)
  exact ⟨((Homeomorph.setCongr (Set.ext fun _ ↦ mem_handlebody.trans mem_prod.symm)).trans
    (Homeomorph.Set.prod _ _)).toHomotopyEquiv.trans <|
    ((ContinuousMap.HomotopyEquiv.refl _).prodCongr e).trans
      (Homeomorph.prodUnique _ _).toHomotopyEquiv⟩

instance : PathConnectedSpace (handlebody g) :=
  nonempty_handlebody_homotopyEquiv.some.symm.pathConnectedSpace

/-- **The fundamental group of the standard handlebody of genus `g` is free of rank `g`**, at
every base point. -/
theorem nonempty_fundamentalGroup_handlebody_mulEquiv_freeGroup (x : handlebody g) :
    Nonempty (FundamentalGroup (handlebody g) x ≃* FreeGroup (Fin g)) := by
  obtain ⟨e⟩ := nonempty_handlebody_homotopyEquiv (g := g)
  obtain ⟨φ⟩ := e.nonempty_fundamentalGroupMulEquiv x (e x)
  obtain ⟨ψ⟩ := nonempty_fundamentalGroup_planarSurface_mulEquiv_freeGroup (e x)
  exact ⟨φ.trans ψ⟩

instance (x : handlebody g) : Group.FG (FundamentalGroup (handlebody g) x) :=
  have e := (nonempty_fundamentalGroup_handlebody_mulEquiv_freeGroup x).some
  Group.fg_of_surjective (f := e.symm.toMonoidHom) e.symm.surjective

/-- **The fundamental group of the standard handlebody of genus `g` is generated by `g`
elements.** -/
theorem rank_fundamentalGroup_handlebody_le (x : handlebody g) :
    Group.rank (FundamentalGroup (handlebody g) x) ≤ g := by
  obtain ⟨e⟩ := nonempty_fundamentalGroup_handlebody_mulEquiv_freeGroup x
  rw [Group.rank_congr e]
  simpa using rank_freeGroup_le (Fin g)

end TauCeti
