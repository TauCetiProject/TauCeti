module

public import TauCeti.AlgebraicTopology.Homotopy.Hurewicz.One.Naturality
public import TauCeti.LowDimTopology.Heegaard.FundamentalGroup

/-!
# The first homology of a manifold with a Heegaard splitting

Let `M` be a `3`-manifold without boundary with a Heegaard splitting into two handlebodies `H₁`
and `H₂` meeting in the Heegaard surface `Σ = H₁ ∩ H₂`. The inclusion `Σ → M` is surjective on
first integral singular homology, and its kernel there is the sum `K₁ ⊔ K₂` of the kernels `Kᵢ`
of the maps `H₁(Σ) → H₁(Hᵢ)` induced by the inclusions of the Heegaard surface into the two
handlebodies. So

  `H₁(M) ≅ H₁(Σ) ⧸ (K₁ ⊔ K₂)`

(`TauCeti.HeegaardSplitting.firstHomologyEquiv`). This is the homological form of the
presentation of `M` by a Heegaard diagram: `K₁` and `K₂` are spanned by the classes of the `α`
and of the `β` curves (an identification not made here), and it computes `H₁(M)` as
`H₁(Σ) ⧸ ⟨[α_i], [β_j]⟩`.

The statement is the abelianization of the presentation of `π₁(M, x)` as the quotient of
`π₁(Σ, x)` by the subgroup generated by the kernels of the maps to `π₁(H₁, x)` and `π₁(H₂, x)`
(`TauCeti.HeegaardSplitting.fundamentalGroup_map_inter_surjective`,
`TauCeti.HeegaardSplitting.ker_fundamentalGroup_map_inter`). All four spaces are path connected
(`TauCeti.HeegaardSplitting.isPathConnected_left_inter_right`,
`TauCeti.HeegaardSplitting.pathConnectedSpace`), and all three maps out of `π₁(Σ, x)` are
surjective, so the degree-one Hurewicz theorem turns each statement about fundamental groups into
the corresponding one about first homology
(`ContinuousMap.singularHomologyMap_one_surjective`,
`ContinuousMap.toAddSubgroup_ker_singularHomologyMap_one`). Integer coefficients are read through
a ring `R ≃+* ℤ` in the universe of `M`, as for the Hurewicz isomorphism.

## Main results

* `TauCeti.HeegaardSplitting.singularHomologyMap_subtypeVal_inter_surjective`: the Heegaard surface
  carries the first homology of the manifold.
* `TauCeti.HeegaardSplitting.ker_singularHomologyMap_subtypeVal_inter`: a class of the Heegaard
  surface vanishes in the manifold exactly when it is a sum of classes vanishing in either
  handlebody.
* `TauCeti.HeegaardSplitting.firstHomologyEquiv`: the resulting isomorphism
  `H₁(Σ) ⧸ (K₁ ⊔ K₂) ≃ H₁(M)`.

## References

* J. Hempel, *3-Manifolds*, Annals of Mathematics Studies 86, Princeton University Press (1976),
  Chapter 2.
* A. Hatcher, *Algebraic Topology*, Cambridge University Press (2002), Section 1.2 (the
  Seifert–van Kampen theorem) and Theorem 2A.1 (the Hurewicz theorem in degree one).
* P. Ozsváth and Z. Szabó, *Holomorphic disks and topological invariants for closed
  three-manifolds*, Annals of Mathematics 159 (2004), Section 2.1.
-/

public section

noncomputable section

open Module Set ContinuousMap

universe u

namespace TauCeti

namespace HeegaardSplitting

variable {E : Type*} {M : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace M]
  [ChartedSpace E M] (s : HeegaardSplitting M)

variable (R : Type u) [Ring R]

/-- The Heegaard surface and the two handlebodies of a splitting are path connected: the inputs of
the Hurewicz comparison besides the path connectedness of the manifold. -/
private theorem pathConnectedSpace_inter_left_right (hE : finrank ℝ E = 3) :
    PathConnectedSpace ↥(s.left ∩ s.right) ∧ PathConnectedSpace s.left ∧
      PathConnectedSpace s.right :=
  ⟨isPathConnected_iff_pathConnectedSpace.1 (s.isPathConnected_left_inter_right hE),
    s.nonempty_homeomorph_left.some.symm.toHomotopyEquiv.pathConnectedSpace,
    s.nonempty_homeomorph_right.some.symm.toHomotopyEquiv.pathConnectedSpace⟩

/-- **The Heegaard surface carries the first homology of the manifold.** For a Heegaard splitting
of a manifold without boundary charted on a three-dimensional real normed space, the inclusion of
the Heegaard surface `H₁ ∩ H₂` induces a surjection on first singular homology with integer
coefficients, read through a ring `R ≃+* ℤ`. -/
theorem singularHomologyMap_subtypeVal_inter_surjective (hE : finrank ℝ E = 3) (e : R ≃+* ℤ) :
    Function.Surjective (singularHomologyMap R 1 (subtypeVal (s.left ∩ s.right))) := by
  obtain ⟨x, hxL, hxR⟩ := (s.isPathConnected_left_inter_right hE).nonempty
  obtain ⟨_, -, -⟩ := s.pathConnectedSpace_inter_left_right hE
  have := s.pathConnectedSpace hE
  exact singularHomologyMap_one_surjective e _ (s.fundamentalGroup_map_inter_surjective hE hxL hxR)

/-- **The first homology of a Heegaard-split manifold is a quotient of that of the Heegaard
surface.** For a Heegaard splitting of a manifold without boundary charted on a three-dimensional
real normed space, a first homology class of the Heegaard surface `H₁ ∩ H₂`, with integer
coefficients read through a ring `R ≃+* ℤ`, vanishes in the manifold exactly when it is the sum of
a class vanishing in the first handlebody and a class vanishing in the second. -/
theorem ker_singularHomologyMap_subtypeVal_inter (hE : finrank ℝ E = 3) (e : R ≃+* ℤ) :
    LinearMap.ker (singularHomologyMap R 1 (subtypeVal (s.left ∩ s.right))) =
      LinearMap.ker (singularHomologyMap R 1 (inclusion (inter_subset_left (s := s.left)))) ⊔
        LinearMap.ker (singularHomologyMap R 1 (inclusion (inter_subset_right (s := s.left)))) := by
  obtain ⟨x, hxL, hxR⟩ := (s.isPathConnected_left_inter_right hE).nonempty
  obtain ⟨_, _, _⟩ := s.pathConnectedSpace_inter_left_right hE
  have := s.pathConnectedSpace hE
  apply Submodule.toAddSubgroup_injective
  rw [Submodule.sup_toAddSubgroup, toAddSubgroup_ker_singularHomologyMap_one e _
      (s.fundamentalGroup_map_inter_surjective hE hxL hxR),
    toAddSubgroup_ker_singularHomologyMap_one e _
      (s.fundamentalGroup_map_inclusion_inter_left_surjective hE ⟨x, hxL, hxR⟩),
    toAddSubgroup_ker_singularHomologyMap_one e _
      (s.fundamentalGroup_map_inclusion_inter_right_surjective hE ⟨x, hxL, hxR⟩),
    s.ker_fundamentalGroup_map_inter hE hxL hxR, Subgroup.map_sup, map_sup, AddSubgroup.map_sup]

/-- **The first homology of a Heegaard-split manifold.** For a Heegaard splitting of a manifold
`M` without boundary charted on a three-dimensional real normed space, with Heegaard surface
`Σ = H₁ ∩ H₂`, the inclusion of `Σ` induces an isomorphism `H₁(Σ) ⧸ (K₁ ⊔ K₂) ≃ H₁(M)` of first
singular homology groups with integer coefficients, read through a ring `R ≃+* ℤ`, where `Kᵢ` is
the kernel of the map `H₁(Σ) → H₁(Hᵢ)` induced by the inclusion. -/
def firstHomologyEquiv (hE : finrank ℝ E = 3) (e : R ≃+* ℤ) :
    (((singularChains R).obj (TopCat.of ↥(s.left ∩ s.right))).homology 1 ⧸
      (LinearMap.ker (singularHomologyMap R 1 (inclusion (inter_subset_left (s := s.left)))) ⊔
        LinearMap.ker (singularHomologyMap R 1
          (inclusion (inter_subset_right (s := s.left)))))) ≃ₗ[R]
      ((singularChains R).obj (TopCat.of M)).homology 1 :=
  (Submodule.quotEquivOfEq _ _ (s.ker_singularHomologyMap_subtypeVal_inter R hE e).symm).trans
    (LinearMap.quotKerEquivOfSurjective _
      (s.singularHomologyMap_subtypeVal_inter_surjective R hE e))

/-- The isomorphism `H₁(Σ) ⧸ (K₁ ⊔ K₂) ≃ H₁(M)` sends the class of a first homology class of the
Heegaard surface to its image in the manifold. -/
@[simp]
theorem firstHomologyEquiv_mk (hE : finrank ℝ E = 3) (e : R ≃+* ℤ)
    (c : ((singularChains R).obj (TopCat.of ↥(s.left ∩ s.right))).homology 1) :
    s.firstHomologyEquiv R hE e (Submodule.Quotient.mk c) =
      singularHomologyMap R 1 (subtypeVal (s.left ∩ s.right)) c := by
  simp [firstHomologyEquiv]

/-- The inverse of the isomorphism `H₁(Σ) ⧸ (K₁ ⊔ K₂) ≃ H₁(M)` sends the image of a first homology
class of the Heegaard surface to its class in the quotient. -/
@[simp]
theorem firstHomologyEquiv_symm_singularHomologyMap (hE : finrank ℝ E = 3) (e : R ≃+* ℤ)
    (c : ((singularChains R).obj (TopCat.of ↥(s.left ∩ s.right))).homology 1) :
    (s.firstHomologyEquiv R hE e).symm (singularHomologyMap R 1 (subtypeVal (s.left ∩ s.right)) c) =
      Submodule.Quotient.mk c := by
  rw [LinearEquiv.symm_apply_eq, firstHomologyEquiv_mk]

end HeegaardSplitting

end TauCeti
