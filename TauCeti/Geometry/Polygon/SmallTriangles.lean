/-!
# Δ-moves across small triangles

A Δ-move (`Polygon.IsDeltaMove`) replaces an edge `[a, b]` of a polygonal knot by the two other
sides of a triangle `D = abc` meeting the knot only in that edge. To show that combinatorially
equivalent polygonal knots have diagrams related by Reidemeister moves (Reidemeister's theorem,
Lickorish, Chapter 1), one follows the effect of a Δ-move on a regular projection, and that effect
is only simple when the triangle is small compared with the diagram. So the triangle `D` is first
cut into small triangles, and the Δ-move across `D` is carried out as a sequence of Δ-moves across
the small ones. This file proves that reduction.

Cut `D` into four triangles by the midpoints `m_ab`, `m_ac` and `m_cb` of its sides. Starting from
the polygon `⋯ a b ⋯`, the following moves give the polygon `⋯ a c b ⋯` obtained by the Δ-move:

* subdivide the edge `[a, b]` at `m_ab`;
* a Δ-move across the corner triangle `a m_ab m_ac`, giving `⋯ a m_ac m_ab b ⋯`;
* a Δ-move across the middle triangle `m_ac m_ab m_cb`, giving `⋯ a m_ac m_cb m_ab b ⋯`;
* an inverse Δ-move across the corner triangle `m_cb b m_ab`, giving `⋯ a m_ac m_cb b ⋯`;
* a Δ-move across the corner triangle `m_ac m_cb c`, giving `⋯ a m_ac c m_cb b ⋯`;
* removing the vertices `m_ac` and `m_cb`, which subdivide the edges `[a, c]` and `[c, b]`.

Each of the four triangles lies in `D`, so it meets the polygon of the moment only along the
sides it should, and its sides are half as long as those of `D`. Iterating, a Δ-move is a
composition of subdivisions at points of `D` and of Δ-moves and inverse Δ-moves across triangles
contained in `D` whose sides are at most any given `ε > 0`
(`TauCeti.SimplePolygon.eqvGen_deltaMove_of_small`). The statement is phrased for an arbitrary
relation `r` containing these moves: the Δ-move is then in the equivalence relation generated by
`r`, so any property of polygons preserved by subdivisions and by Δ-moves across small triangles
inside `D` is preserved by the Δ-move across `D`.

The intersections of the four triangles with the sides involved are computed in the plane of
`D`, through the affine chart `TauCeti.triangleChart` `(s, t) ↦ a + s • (b - a) + t • (c - a)`,
which is injective because `a`, `b`, `c` are affinely independent.

## Main results

* `TauCeti.SimplePolygon.eqvGen_deltaMove_of_small`: a Δ-move is in the equivalence relation
  generated by any relation containing the subdivisions of edges at points of its triangle and the
  Δ-moves across triangles inside its triangle with all sides at most `ε`, for any `ε > 0`.

## References

* K. Reidemeister, *Elementare Begründung der Knotentheorie*, Abh. Math. Sem. Univ. Hamburg 5
  (1927), 24–32, for the reduction of Δ-moves to Reidemeister moves on diagrams.
* W. B. R. Lickorish, *An Introduction to Knot Theory*, Springer GTM 175 (1997), Chapter 1,
  pp. 2–4, for triangle moves and their effect on link diagrams.
* G. Burde, H. Zieschang, *Knots*, 2nd ed., De Gruyter Studies in Mathematics 5 (2003),
  Chapter 1 §B, Definitions 1.6 and 1.7 (Δ-moves and combinatorial equivalence).
-/

public section

open Set Function TauCeti

namespace Polygon

/-! ### Two ways to insert the same three vertices -/

section Reindex

variable {P : Type*} {n : ℕ}

/-- The polygon `⋯ a y z x b ⋯` built by inserting `x`, then `y` before it, then `z` after `y`,
is also built by inserting `y`, then `z` after it, then `x` after `z`. -/
private theorem insertVertex_insertVertex_insertVertex_middle (poly : Polygon P n) (i : Fin n)
    (x y z : P) :
    ((poly.insertVertex i x).insertVertex i.castSucc y).insertVertex i.castSucc.succ z =
      ((poly.insertVertex i y).insertVertex i.succ z).insertVertex i.succ.succ x := by
  rw [insertVertex_insertVertex_castSucc, Fin.succ_castSucc, insertVertex_insertVertex_castSucc]

/-- The polygon `⋯ a y w z b ⋯` built by inserting `y`, then `z` after it, then `w` between
them, is also built by inserting `w`, then `z` after it, then `y` before `w`. -/
private theorem insertVertex_insertVertex_insertVertex_corner (poly : Polygon P n) (i : Fin n)
    (y z w : P) :
    ((poly.insertVertex i y).insertVertex i.succ z).insertVertex i.succ.castSucc w =
      ((poly.insertVertex i w).insertVertex i.succ z).insertVertex i.castSucc.castSucc y := by
  refine congrArg Polygon.mk (funext fun j => ?_)
  simp only [insertVertex_apply, Fin.val_succ, Fin.val_castSucc]
  split_ifs <;> first | rfl | omega

end Reindex

/-! ### The sides of the midpoint subdivision in the plane of a triangle -/

section Chart

variable {V P : Type*} [AddCommGroup V] [Module ℝ V] [AddTorsor V P]

/-- The segment `[m_ab, b]` read in the chart of the plane of `abc`. -/
private theorem affineSegment_ab_b_eq_image (a b c : P) :
    affineSegment ℝ (midpoint ℝ a b) b =
      triangleChart ℝ a b c '' convexHull ℝ {(1 / 2, 0), (1, 0)} := by
  rw [convexHull_pair, ← affineSegment_eq_segment, affineSegment_image,
    triangleChart_apply_half_zero, triangleChart_apply_one_zero]

/-- The segment `[a, m_ac]` read in the chart of the plane of `abc`. -/
private theorem affineSegment_a_ac_eq_image (a b c : P) :
    affineSegment ℝ a (midpoint ℝ a c) =
      triangleChart ℝ a b c '' convexHull ℝ {(0, 0), (0, 1 / 2)} := by
  rw [convexHull_pair, ← affineSegment_eq_segment, affineSegment_image,
    triangleChart_apply_zero_zero, triangleChart_apply_zero_half]

/-- The segment `[m_ac, m_cb]` read in the chart of the plane of `abc`. -/
private theorem affineSegment_ac_cb_eq_image (a b c : P) :
    affineSegment ℝ (midpoint ℝ a c) (midpoint ℝ c b) =
      triangleChart ℝ a b c '' convexHull ℝ {(0, 1 / 2), (1 / 2, 1 / 2)} := by
  rw [convexHull_pair, ← affineSegment_eq_segment, affineSegment_image,
    triangleChart_apply_zero_half, triangleChart_apply_half_half]

/-- The segment `[m_cb, b]` read in the chart of the plane of `abc`. -/
private theorem affineSegment_cb_b_eq_image (a b c : P) :
    affineSegment ℝ (midpoint ℝ c b) b =
      triangleChart ℝ a b c '' convexHull ℝ {(1 / 2, 1 / 2), (1, 0)} := by
  rw [convexHull_pair, ← affineSegment_eq_segment, affineSegment_image,
    triangleChart_apply_half_half, triangleChart_apply_one_zero]

end Chart

/-! ### The midpoint subdivision of the standard triangle -/

section Plane

/-- `IsLinearMap.le_of_mem_convexHull` for the linear form `(s, t) ↦ u * s + v * t` on the plane,
in the form used below. -/
private theorem le_of_mem_convexHull {s : Set (ℝ × ℝ)} (u v w : ℝ)
    (hs : ∀ q ∈ s, u * q.1 + v * q.2 ≤ w) {p : ℝ × ℝ} (hp : p ∈ convexHull ℝ s) :
    u * p.1 + v * p.2 ≤ w :=
  IsLinearMap.le_of_mem_convexHull (f := fun q : ℝ × ℝ => u * q.1 + v * q.2)
    ⟨fun x y => by simp only [Prod.fst_add, Prod.snd_add]; ring,
     fun r x => by simp only [Prod.smul_fst, Prod.smul_snd, smul_eq_mul]; ring⟩ hs hp

/-! The four triangles of the midpoint subdivision of the triangle with vertices `(0, 0)`, `(1, 0)`
and `(0, 1)`, and their intersections with the sides met along the way. -/

/-- The six vertices of the midpoint subdivision lie in the standard triangle. -/
private theorem mem_convexHull_standard {x : ℝ × ℝ}
    (hx : x ∈ ({(0, 0), (1, 0), (0, 1), (1 / 2, 0), (0, 1 / 2), (1 / 2, 1 / 2)} : Set (ℝ × ℝ))) :
    x ∈ convexHull ℝ {((0 : ℝ), (0 : ℝ)), (1, 0), (0, 1)} := by
  have hA : ((0 : ℝ), (0 : ℝ)) ∈ convexHull ℝ {((0 : ℝ), (0 : ℝ)), (1, 0), (0, 1)} :=
    subset_convexHull ℝ _ (by simp)
  have hB : ((1 : ℝ), (0 : ℝ)) ∈ convexHull ℝ {((0 : ℝ), (0 : ℝ)), (1, 0), (0, 1)} :=
    subset_convexHull ℝ _ (by simp)
  have hC : ((0 : ℝ), (1 : ℝ)) ∈ convexHull ℝ {((0 : ℝ), (0 : ℝ)), (1, 0), (0, 1)} :=
    subset_convexHull ℝ _ (by simp)
  have hconv := convex_convexHull ℝ ({((0 : ℝ), (0 : ℝ)), (1, 0), (0, 1)} : Set (ℝ × ℝ))
  simp only [mem_insert_iff, mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl
  · exact hA
  · exact hB
  · exact hC
  · convert hconv hA hB (a := 1 / 2) (b := 1 / 2) (by norm_num) (by norm_num) (by norm_num) using 1
    ext <;> norm_num
  · convert hconv hA hC (a := 1 / 2) (b := 1 / 2) (by norm_num) (by norm_num) (by norm_num) using 1
    ext <;> norm_num
  · convert hconv hB hC (a := 1 / 2) (b := 1 / 2) (by norm_num) (by norm_num) (by norm_num) using 1
    ext <;> norm_num

/-- A triangle with vertices in the standard triangle lies in it. -/
private theorem convexHull_subset_standard {x y z : ℝ × ℝ}
    (hx : x ∈ ({(0, 0), (1, 0), (0, 1), (1 / 2, 0), (0, 1 / 2), (1 / 2, 1 / 2)} : Set (ℝ × ℝ)))
    (hy : y ∈ ({(0, 0), (1, 0), (0, 1), (1 / 2, 0), (0, 1 / 2), (1 / 2, 1 / 2)} : Set (ℝ × ℝ)))
    (hz : z ∈ ({(0, 0), (1, 0), (0, 1), (1 / 2, 0), (0, 1 / 2), (1 / 2, 1 / 2)} : Set (ℝ × ℝ))) :
    convexHull ℝ {x, y, z} ⊆ convexHull ℝ {((0 : ℝ), (0 : ℝ)), (1, 0), (0, 1)} :=
  convexHull_min (insert_subset_iff.2 ⟨mem_convexHull_standard hx, insert_subset_iff.2
    ⟨mem_convexHull_standard hy, singleton_subset_iff.2 (mem_convexHull_standard hz)⟩⟩)
    (convex_convexHull ℝ _)

/-- The first new side `[m_ab, b]` meets the corner triangle `a m_ab m_ac` only at `m_ab`. -/
private theorem inter_one_ab_b :
    convexHull ℝ {((1 : ℝ) / 2, (0 : ℝ)), (1, 0)} ∩
        convexHull ℝ {((0 : ℝ), (0 : ℝ)), (1 / 2, 0), (0, 1 / 2)} ⊆
      {((0 : ℝ), (0 : ℝ)), (1 / 2, 0)} := by
  rintro p ⟨h₁, h₂⟩
  have e₁ := le_of_mem_convexHull 0 1 0 (by simp) h₁
  have e₂ := le_of_mem_convexHull 0 (-1) 0 (by simp) h₁
  have e₃ := le_of_mem_convexHull (-1) 0 (-1 / 2) (by norm_num) h₁
  have e₄ := le_of_mem_convexHull 1 1 (1 / 2) (by norm_num) h₂
  exact .inr (Prod.ext (by simp; linarith) (by simp; linarith))

/-- The vertex `b` is not in the corner triangle `a m_ab m_ac`. -/
private theorem b_notMem_one :
    ((1 : ℝ), (0 : ℝ)) ∉ convexHull ℝ {((0 : ℝ), (0 : ℝ)), (1 / 2, 0), (0, 1 / 2)} := fun h => by
  have := le_of_mem_convexHull 1 1 (1 / 2) (by norm_num) h
  norm_num at this

/-- The middle triangle `m_ac m_ab m_cb` meets `[m_ab, b]` only at `m_ab`. -/
private theorem inter_two_ab_b :
    convexHull ℝ {((1 : ℝ) / 2, (0 : ℝ)), (1, 0)} ∩
        convexHull ℝ {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 0), (1 / 2, 1 / 2)} ⊆
      {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 0)} := by
  rintro p ⟨h₁, h₂⟩
  have e₁ := le_of_mem_convexHull 0 1 0 (by simp) h₁
  have e₂ := le_of_mem_convexHull 0 (-1) 0 (by simp) h₁
  have e₃ := le_of_mem_convexHull (-1) 0 (-1 / 2) (by norm_num) h₁
  have e₄ := le_of_mem_convexHull 1 0 (1 / 2) (by norm_num) h₂
  exact .inr (Prod.ext (by simp; linarith) (by simp; linarith))

/-- The middle triangle `m_ac m_ab m_cb` meets `[a, m_ac]` only at `m_ac`. -/
private theorem inter_two_a_ac :
    convexHull ℝ {((0 : ℝ), (0 : ℝ)), (0, 1 / 2)} ∩
        convexHull ℝ {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 0), (1 / 2, 1 / 2)} ⊆
      {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 0)} := by
  rintro p ⟨h₁, h₂⟩
  have e₁ := le_of_mem_convexHull 1 0 0 (by simp) h₁
  have e₂ := le_of_mem_convexHull (-1) 0 0 (by simp) h₁
  have e₃ := le_of_mem_convexHull 0 1 (1 / 2) (by norm_num) h₁
  have e₄ := le_of_mem_convexHull (-1) (-1) (-1 / 2) (by norm_num) h₂
  exact .inl (Prod.ext (by simp; linarith) (by simp; linarith))

/-- The vertices `a` and `b` are not in the middle triangle `m_ac m_ab m_cb`. -/
private theorem a_notMem_two :
    ((0 : ℝ), (0 : ℝ)) ∉ convexHull ℝ {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 0), (1 / 2, 1 / 2)} :=
  fun h => by
  have := le_of_mem_convexHull (-1) (-1) (-1 / 2) (by norm_num) h
  norm_num at this

private theorem b_notMem_two :
    ((1 : ℝ), (0 : ℝ)) ∉ convexHull ℝ {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 0), (1 / 2, 1 / 2)} :=
  fun h => by
  have := le_of_mem_convexHull 1 0 (1 / 2) (by norm_num) h
  norm_num at this

/-- The corner triangle `m_cb b m_ab` does not meet `[a, m_ac]`. -/
private theorem inter_three_a_ac :
    convexHull ℝ {((0 : ℝ), (0 : ℝ)), (0, 1 / 2)} ∩
        convexHull ℝ {((1 : ℝ) / 2, (1 / 2 : ℝ)), (1, 0), (1 / 2, 0)} ⊆
      {((1 : ℝ) / 2, (1 / 2 : ℝ)), (1, 0)} := by
  rintro p ⟨h₁, h₂⟩
  have e₁ := le_of_mem_convexHull 1 0 0 (by simp) h₁
  have e₂ := le_of_mem_convexHull (-1) 0 (-1 / 2) (by norm_num) h₂
  linarith

/-- The corner triangle `m_cb b m_ab` meets `[m_ac, m_cb]` only at `m_cb`. -/
private theorem inter_three_ac_cb :
    convexHull ℝ {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 1 / 2)} ∩
        convexHull ℝ {((1 : ℝ) / 2, (1 / 2 : ℝ)), (1, 0), (1 / 2, 0)} ⊆
      {((1 : ℝ) / 2, (1 / 2 : ℝ)), (1, 0)} := by
  rintro p ⟨h₁, h₂⟩
  have e₁ := le_of_mem_convexHull 0 1 (1 / 2) (by norm_num) h₁
  have e₂ := le_of_mem_convexHull 0 (-1) (-1 / 2) (by norm_num) h₁
  have e₃ := le_of_mem_convexHull 1 0 (1 / 2) (by norm_num) h₁
  have e₄ := le_of_mem_convexHull (-1) 0 (-1 / 2) (by norm_num) h₂
  exact .inl (Prod.ext (by simp; linarith) (by simp; linarith))

/-- The vertex `a` is not in the corner triangle `m_cb b m_ab`. -/
private theorem a_notMem_three :
    ((0 : ℝ), (0 : ℝ)) ∉ convexHull ℝ {((1 : ℝ) / 2, (1 / 2 : ℝ)), (1, 0), (1 / 2, 0)} :=
  fun h => by
  have := le_of_mem_convexHull (-1) 0 (-1 / 2) (by norm_num) h
  norm_num at this

/-- The corner triangle `m_ac m_cb c` meets `[a, m_ac]` only at `m_ac`. -/
private theorem inter_four_a_ac :
    convexHull ℝ {((0 : ℝ), (0 : ℝ)), (0, 1 / 2)} ∩
        convexHull ℝ {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 1 / 2), (0, 1)} ⊆
      {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 1 / 2)} := by
  rintro p ⟨h₁, h₂⟩
  have e₁ := le_of_mem_convexHull 1 0 0 (by simp) h₁
  have e₂ := le_of_mem_convexHull (-1) 0 0 (by simp) h₁
  have e₃ := le_of_mem_convexHull 0 1 (1 / 2) (by norm_num) h₁
  have e₄ := le_of_mem_convexHull 0 (-1) (-1 / 2) (by norm_num) h₂
  exact .inl (Prod.ext (by simp; linarith) (by simp; linarith))

/-- The corner triangle `m_ac m_cb c` meets `[m_cb, b]` only at `m_cb`. -/
private theorem inter_four_cb_b :
    convexHull ℝ {((1 : ℝ) / 2, (1 / 2 : ℝ)), (1, 0)} ∩
        convexHull ℝ {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 1 / 2), (0, 1)} ⊆
      {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 1 / 2)} := by
  rintro p ⟨h₁, h₂⟩
  have e₁ := le_of_mem_convexHull 1 1 1 (by norm_num) h₁
  have e₂ := le_of_mem_convexHull (-1) (-1) (-1) (by norm_num) h₁
  have e₃ := le_of_mem_convexHull (-1) 0 (-1 / 2) (by norm_num) h₁
  have e₄ := le_of_mem_convexHull 0 (-1) (-1 / 2) (by norm_num) h₂
  exact .inr (Prod.ext (by simp; linarith) (by simp; linarith))

/-- The vertices `a` and `b` are not in the corner triangle `m_ac m_cb c`. -/
private theorem a_notMem_four :
    ((0 : ℝ), (0 : ℝ)) ∉ convexHull ℝ {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 1 / 2), (0, 1)} :=
  fun h => by
  have := le_of_mem_convexHull 0 (-1) (-1 / 2) (by norm_num) h
  norm_num at this

private theorem b_notMem_four :
    ((1 : ℝ), (0 : ℝ)) ∉ convexHull ℝ {((0 : ℝ), (1 / 2 : ℝ)), (1 / 2, 1 / 2), (0, 1)} :=
  fun h => by
  have := le_of_mem_convexHull 0 (-1) (-1 / 2) (by norm_num) h
  norm_num at this

end Plane

/-! ### The four Δ-moves of the midpoint subdivision -/

section Steps

variable {V P : Type*} [AddCommGroup V] [Module ℝ V] [AddTorsor V P]

variable {n : ℕ} {poly : Polygon P n} {i : Fin n} {c : P}

/-- The edges of the polygon other than the one replaced by a Δ-move meet the image of a part `X`
of the standard triangle only at the images of the vertices `(0, 0)` and `(1, 0)` lying in `X`,
that is, at the ends of the replaced edge. -/
private theorem IsDeltaMove.iUnion_edgeSet_inter_image_subset (h : poly.IsDeltaMove ℝ i c)
    {X : Set (ℝ × ℝ)} (hX : X ⊆ convexHull ℝ {((0 : ℝ), (0 : ℝ)), (1, 0), (0, 1)}) {E : Set P}
    (ha : ((0 : ℝ), (0 : ℝ)) ∈ X → poly i ∈ E)
    (hb : ((1 : ℝ), (0 : ℝ)) ∈ X → poly (finRotate n i) ∈ E) :
    (⋃ (l : Fin n) (_ : l ≠ i), poly.edgeSet ℝ l) ∩
      triangleChart ℝ (poly i) (poly (finRotate n i)) c '' X ⊆ E := by
  rintro _ ⟨hx, y, hyX, rfl⟩
  obtain ⟨l, hl, hxl⟩ := mem_iUnion₂.1 hx
  have hφ := triangleChart_injective h.affineIndependent
  rcases h.edgeSet_inter_closedInterior_subset hl
      ⟨hxl, h.closedInterior_eq_image ▸ mem_image_of_mem _ (hX hyX)⟩ with he | he
  · obtain rfl := hφ (he.trans (triangleChart_apply_zero_zero _ _ c).symm)
    rw [triangleChart_apply_zero_zero]
    exact ha hyX
  · obtain rfl := hφ ((mem_singleton_iff.1 he).trans (triangleChart_apply_one_zero _ _ c).symm)
    rw [triangleChart_apply_one_zero]
    exact hb hyX

/-- First move: across the corner triangle `a m_ab m_ac`, after subdividing `[a, b]` at `m_ab`. -/
private theorem IsDeltaMove.isDeltaMove_corner_a (h : poly.IsDeltaMove ℝ i c) :
    (poly.insertVertex i (midpoint ℝ (poly i) (poly (finRotate n i)))).IsDeltaMove ℝ i.castSucc
      (midpoint ℝ (poly i) c) := by
  have hφ := triangleChart_injective h.affineIndependent
  refine isDeltaMove_of_chart hφ (x := (0, 0)) (y := (1 / 2, 0)) (z := (0, 1 / 2))
    (by rw [insertVertex_apply_castSucc_self, triangleChart_apply_zero_zero])
    (by rw [Fin.finRotate_castSucc, insertVertex_apply_succ_self, triangleChart_apply_half_zero])
    (triangleChart_apply_zero_half _ _ _).symm (affineIndependent_iff_det_ne_zero.2 (by norm_num))
    fun k hk => (inter_subset_inter_left _
      (edgeSet_insertVertex_subset_of_ne_castSucc _ _ _ hk)).trans ?_
  rw [union_inter_distrib_right, union_subset_iff]
  refine ⟨h.iUnion_edgeSet_inter_image_subset (convexHull_subset_standard (by simp) (by simp)
    (by simp)) (fun _ => ⟨(0, 0), by simp, triangleChart_apply_zero_zero _ _ _⟩)
    (fun hb => (b_notMem_one hb).elim), ?_⟩
  rw [affineSegment_ab_b_eq_image (c := c), ← image_inter hφ]
  exact image_mono inter_one_ab_b

/-- The triangle of the first move is `a m_ab m_ac`. -/
private theorem IsDeltaMove.isDeltaMove_corner_a_triangle_points (h : poly.IsDeltaMove ℝ i c) :
    h.isDeltaMove_corner_a.triangle.points =
      ![poly i, midpoint ℝ (poly i) (poly (finRotate n i)), midpoint ℝ (poly i) c] := by
  rw [IsDeltaMove.triangle_points, insertVertex_apply_castSucc_self, Fin.finRotate_castSucc,
    insertVertex_apply_succ_self]

/-- Second move: across the middle triangle `m_ac m_ab m_cb`. -/
private theorem IsDeltaMove.isDeltaMove_middle (h : poly.IsDeltaMove ℝ i c) :
    ((poly.insertVertex i (midpoint ℝ (poly i) (poly (finRotate n i)))).insertVertex i.castSucc
      (midpoint ℝ (poly i) c)).IsDeltaMove ℝ i.castSucc.succ
        (midpoint ℝ c (poly (finRotate n i))) := by
  have hφ := triangleChart_injective h.affineIndependent
  refine isDeltaMove_of_chart hφ (x := (0, 1 / 2)) (y := (1 / 2, 0)) (z := (1 / 2, 1 / 2))
    (by rw [insertVertex_apply_succ_self, triangleChart_apply_zero_half])
    (by rw [insertVertex_apply_finRotate_succ_self, Fin.finRotate_castSucc,
      insertVertex_apply_succ_self, triangleChart_apply_half_zero])
    (triangleChart_apply_half_half _ _ _).symm (affineIndependent_iff_det_ne_zero.2 (by norm_num))
    fun k hk => (inter_subset_inter_left _
      ((edgeSet_insertVertex_subset_of_ne_succ _ _ _ hk).trans (union_subset_union_left _
        (iUnion₂_subset fun l hl => edgeSet_insertVertex_subset_of_ne_castSucc _ _ _ hl)))).trans ?_
  rw [insertVertex_apply_castSucc_self, union_inter_distrib_right, union_inter_distrib_right,
    union_subset_iff, union_subset_iff, affineSegment_ab_b_eq_image (c := c),
    affineSegment_a_ac_eq_image (b := poly (finRotate n i)), ← image_inter hφ,
    ← image_inter hφ]
  exact ⟨⟨h.iUnion_edgeSet_inter_image_subset (convexHull_subset_standard (by simp) (by simp)
    (by simp)) (fun ha => (a_notMem_two ha).elim) (fun hb => (b_notMem_two hb).elim),
    image_mono inter_two_ab_b⟩, image_mono inter_two_a_ac⟩

/-- The triangle of the second move is `m_ac m_ab m_cb`. -/
private theorem IsDeltaMove.isDeltaMove_middle_triangle_points (h : poly.IsDeltaMove ℝ i c) :
    h.isDeltaMove_middle.triangle.points = ![midpoint ℝ (poly i) c,
      midpoint ℝ (poly i) (poly (finRotate n i)), midpoint ℝ c (poly (finRotate n i))] := by
  rw [IsDeltaMove.triangle_points, insertVertex_apply_succ_self,
    insertVertex_apply_finRotate_succ_self, Fin.finRotate_castSucc, insertVertex_apply_succ_self]

/-- Third move, read backwards: across the corner triangle `m_cb b m_ab`, from the polygon
`⋯ a m_ac m_cb b ⋯`. -/
private theorem IsDeltaMove.isDeltaMove_corner_b (h : poly.IsDeltaMove ℝ i c) :
    ((poly.insertVertex i (midpoint ℝ (poly i) c)).insertVertex i.succ
      (midpoint ℝ c (poly (finRotate n i)))).IsDeltaMove ℝ i.succ.succ
        (midpoint ℝ (poly i) (poly (finRotate n i))) := by
  have hφ := triangleChart_injective h.affineIndependent
  refine isDeltaMove_of_chart hφ (x := (1 / 2, 1 / 2)) (y := (1, 0)) (z := (1 / 2, 0))
    (by rw [insertVertex_apply_succ_self, triangleChart_apply_half_half])
    (by rw [insertVertex_apply_finRotate_succ_self, insertVertex_apply_finRotate_succ_self,
      triangleChart_apply_one_zero])
    (triangleChart_apply_half_zero _ _ _).symm (affineIndependent_iff_det_ne_zero.2 (by norm_num))
    fun k hk => (inter_subset_inter_left _
      ((edgeSet_insertVertex_subset_of_ne_succ _ _ _ hk).trans (union_subset_union_left _
        (iUnion₂_subset fun l hl => edgeSet_insertVertex_subset_of_ne_succ _ _ _ hl)))).trans ?_
  rw [insertVertex_apply_succ_self, union_inter_distrib_right, union_inter_distrib_right,
    union_subset_iff, union_subset_iff, affineSegment_a_ac_eq_image (b := poly (finRotate n i)),
    affineSegment_ac_cb_eq_image, ← image_inter hφ,
    ← image_inter hφ]
  exact ⟨⟨h.iUnion_edgeSet_inter_image_subset (convexHull_subset_standard (by simp) (by simp)
    (by simp)) (fun ha => (a_notMem_three ha).elim)
    (fun _ => ⟨(1, 0), by simp, triangleChart_apply_one_zero _ _ _⟩),
    image_mono inter_three_a_ac⟩, image_mono inter_three_ac_cb⟩

/-- The triangle of the third move is `m_cb b m_ab`. -/
private theorem IsDeltaMove.isDeltaMove_corner_b_triangle_points (h : poly.IsDeltaMove ℝ i c) :
    h.isDeltaMove_corner_b.triangle.points = ![midpoint ℝ c (poly (finRotate n i)),
      poly (finRotate n i), midpoint ℝ (poly i) (poly (finRotate n i))] := by
  rw [IsDeltaMove.triangle_points, insertVertex_apply_succ_self,
    insertVertex_apply_finRotate_succ_self, insertVertex_apply_finRotate_succ_self]

/-- Fourth move: across the corner triangle `m_ac m_cb c`, from the polygon
`⋯ a m_ac m_cb b ⋯`. -/
private theorem IsDeltaMove.isDeltaMove_corner_c (h : poly.IsDeltaMove ℝ i c) :
    ((poly.insertVertex i (midpoint ℝ (poly i) c)).insertVertex i.succ
      (midpoint ℝ c (poly (finRotate n i)))).IsDeltaMove ℝ i.succ.castSucc c := by
  have hφ := triangleChart_injective h.affineIndependent
  refine isDeltaMove_of_chart hφ (x := (0, 1 / 2)) (y := (1 / 2, 1 / 2)) (z := (0, 1))
    (by rw [insertVertex_apply_castSucc_self, insertVertex_apply_succ_self,
      triangleChart_apply_zero_half])
    (by rw [Fin.finRotate_castSucc, insertVertex_apply_succ_self, triangleChart_apply_half_half])
    (triangleChart_apply_zero_one _ _ _).symm (affineIndependent_iff_det_ne_zero.2 (by norm_num))
    fun k hk => (inter_subset_inter_left _
      ((edgeSet_insertVertex_subset_of_ne_castSucc _ _ _ hk).trans (union_subset_union_left _
        (iUnion₂_subset fun l hl => edgeSet_insertVertex_subset_of_ne_succ _ _ _ hl)))).trans ?_
  rw [insertVertex_apply_finRotate_succ_self, union_inter_distrib_right, union_inter_distrib_right,
    union_subset_iff, union_subset_iff, affineSegment_a_ac_eq_image (b := poly (finRotate n i)),
    affineSegment_cb_b_eq_image (a := poly i), ← image_inter hφ,
    ← image_inter hφ]
  exact ⟨⟨h.iUnion_edgeSet_inter_image_subset (convexHull_subset_standard (by simp) (by simp)
    (by simp)) (fun ha => (a_notMem_four ha).elim) (fun hb => (b_notMem_four hb).elim),
    image_mono inter_four_a_ac⟩, image_mono inter_four_cb_b⟩

/-- The triangle of the fourth move is `m_ac m_cb c`. -/
private theorem IsDeltaMove.isDeltaMove_corner_c_triangle_points (h : poly.IsDeltaMove ℝ i c) :
    h.isDeltaMove_corner_c.triangle.points =
      ![midpoint ℝ (poly i) c, midpoint ℝ c (poly (finRotate n i)), c] := by
  rw [IsDeltaMove.triangle_points, insertVertex_apply_castSucc_self, insertVertex_apply_succ_self,
    Fin.finRotate_castSucc, insertVertex_apply_succ_self]

end Steps

end Polygon

/-! ### Sizes and positions of the four triangles -/

namespace Polygon

section Metric

variable {V P : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [MetricSpace P]
  [NormedAddTorsor V P] {n : ℕ} {poly : Polygon P n} {i : Fin n} {c : P}

/-- A triangle whose vertices are among the vertices and midpoints of the sides of the triangle of
a Δ-move lies in that triangle. -/
private theorem IsDeltaMove.closedInterior_subset (h : poly.IsDeltaMove ℝ i c)
    {t : Affine.Triangle ℝ P} {x y z : P} (ht : t.points = ![x, y, z])
    (hx : x ∈ ({poly i, poly (finRotate n i), c, midpoint ℝ (poly i) (poly (finRotate n i)),
      midpoint ℝ (poly i) c, midpoint ℝ c (poly (finRotate n i))} : Set P))
    (hy : y ∈ ({poly i, poly (finRotate n i), c, midpoint ℝ (poly i) (poly (finRotate n i)),
      midpoint ℝ (poly i) c, midpoint ℝ c (poly (finRotate n i))} : Set P))
    (hz : z ∈ ({poly i, poly (finRotate n i), c, midpoint ℝ (poly i) (poly (finRotate n i)),
      midpoint ℝ (poly i) c, midpoint ℝ c (poly (finRotate n i))} : Set P)) :
    t.closedInterior ⊆ h.triangle.closedInterior := by
  have hφ := triangleChart_injective h.affineIndependent
  -- Each of the six points is the image under the chart of a point of the standard triangle.
  have hsix {w : P} (hw : w ∈ ({poly i, poly (finRotate n i), c,
      midpoint ℝ (poly i) (poly (finRotate n i)), midpoint ℝ (poly i) c,
      midpoint ℝ c (poly (finRotate n i))} : Set P)) :
      ∃ W ∈ ({(0, 0), (1, 0), (0, 1), (1 / 2, 0), (0, 1 / 2), (1 / 2, 1 / 2)} : Set (ℝ × ℝ)),
        triangleChart ℝ (poly i) (poly (finRotate n i)) c W = w := by
    simp only [mem_insert_iff, mem_singleton_iff] at hw
    rcases hw with rfl | rfl | rfl | rfl | rfl | rfl
    exacts [⟨_, by simp, triangleChart_apply_zero_zero _ _ _⟩,
      ⟨_, by simp, triangleChart_apply_one_zero _ _ _⟩,
      ⟨_, by simp, triangleChart_apply_zero_one _ _ _⟩,
      ⟨_, by simp, triangleChart_apply_half_zero _ _ _⟩,
      ⟨_, by simp, triangleChart_apply_zero_half _ _ _⟩,
      ⟨_, by simp, triangleChart_apply_half_half _ _ _⟩]
  obtain ⟨X, hX, rfl⟩ := hsix hx
  obtain ⟨Y, hY, rfl⟩ := hsix hy
  obtain ⟨Z, hZ, rfl⟩ := hsix hz
  rw [Affine.Triangle.closedInterior_eq_image_convexHull t ht, h.closedInterior_eq_image]
  exact image_mono (convexHull_subset_standard hX hY hZ)

/-- The images of the six vertices of the midpoint subdivision lie in the triangle of a
Δ-move. -/
private theorem IsDeltaMove.triangleChart_mem_closedInterior (h : poly.IsDeltaMove ℝ i c)
    {X : ℝ × ℝ}
    (hX : X ∈ ({(0, 0), (1, 0), (0, 1), (1 / 2, 0), (0, 1 / 2), (1 / 2, 1 / 2)} : Set (ℝ × ℝ))) :
    triangleChart ℝ (poly i) (poly (finRotate n i)) c X ∈ h.triangle.closedInterior := by
  rw [h.closedInterior_eq_image]
  exact mem_image_of_mem _ (mem_convexHull_standard hX)

/-- Half of a distance at most `2 * δ` is at most `δ`. -/
private theorem half_mul_le {d δ : ℝ} (h : d ≤ 2 * δ) : ‖(2 : ℝ)‖⁻¹ * d ≤ δ := by
  rw [Real.norm_two]
  linarith

end Metric

end Polygon

/-! ### Δ-moves across small triangles -/

namespace TauCeti

namespace SimplePolygon

open Polygon

variable {V P : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [MetricSpace P]
  [NormedAddTorsor V P]

/-- The Δ-move on the simple polygon with underlying polygon `q` is the simple polygon with
underlying polygon `q'`, for any `q'` equal to the inserted polygon. -/
private theorem deltaMove_mk_eq {m : ℕ} [NeZero m] {q : Polygon P m} (hq : q.IsSimple ℝ)
    {j : Fin m} {x : P} (h' : q.IsDeltaMove ℝ j x) {q' : Polygon P (m + 1)}
    (hq' : q'.IsSimple ℝ) (e : q.insertVertex j x = q') :
    SimplePolygon.deltaMove ⟨m, q, hq⟩ j x h' = ⟨m + 1, q', hq'⟩ := by
  subst e
  rfl

/-- The subdivision of the simple polygon with underlying polygon `q` is the simple polygon with
underlying polygon `q'`, for any `q'` equal to the inserted polygon. -/
private theorem insertVertex_mk_eq {m : ℕ} [NeZero m] {q : Polygon P m} (hq : q.IsSimple ℝ)
    (j : Fin m) (x : P) (hx : (q.insertVertex j x).IsSimple ℝ) {q' : Polygon P (m + 1)}
    (hq' : q'.IsSimple ℝ) (e : q.insertVertex j x = q') :
    SimplePolygon.insertVertex ⟨m, q, hq⟩ j x hx = ⟨m + 1, q', hq'⟩ := by
  subst e
  rfl

/-- One Δ-move of the midpoint subdivision of the triangle of `h`: a Δ-move across a triangle
whose vertices are among the vertices and midpoints of the sides of the triangle of `h`, and whose
sides are at most `δ`, is in the equivalence relation generated by `r` when `hΔ` provides the
Δ-moves across such triangles. -/
private theorem eqvGen_deltaMove_of_mem_midpoints
    {r : SimplePolygon ℝ P → SimplePolygon ℝ P → Prop} {n : ℕ} {poly : Polygon P n} {i : Fin n}
    {c : P} (h : poly.IsDeltaMove ℝ i c) {δ : ℝ}
    (hΔ : ∀ (q : SimplePolygon ℝ P) (j : Fin q.numVertices) (x : P)
      (h' : q.toPolygon.IsDeltaMove ℝ j x),
      h'.triangle.closedInterior ⊆ h.triangle.closedInterior →
        (∀ k l, dist (h'.triangle.points k) (h'.triangle.points l) ≤ δ) →
          Relation.EqvGen r q (q.deltaMove j x h'))
    {m : ℕ} [NeZero m] {q : Polygon P m} (hq : q.IsSimple ℝ) {j : Fin m} {w : P}
    (h' : q.IsDeltaMove ℝ j w) {q' : Polygon P (m + 1)} (hq' : q'.IsSimple ℝ)
    (e : q.insertVertex j w = q') {x y z : P} (ht : h'.triangle.points = ![x, y, z])
    (hx : x ∈ ({poly i, poly (finRotate n i), c, midpoint ℝ (poly i) (poly (finRotate n i)),
      midpoint ℝ (poly i) c, midpoint ℝ c (poly (finRotate n i))} : Set P))
    (hy : y ∈ ({poly i, poly (finRotate n i), c, midpoint ℝ (poly i) (poly (finRotate n i)),
      midpoint ℝ (poly i) c, midpoint ℝ c (poly (finRotate n i))} : Set P))
    (hz : z ∈ ({poly i, poly (finRotate n i), c, midpoint ℝ (poly i) (poly (finRotate n i)),
      midpoint ℝ (poly i) c, midpoint ℝ c (poly (finRotate n i))} : Set P))
    (hδ : 0 ≤ δ) (hxy : dist x y ≤ δ) (hxz : dist x z ≤ δ) (hyz : dist y z ≤ δ) :
    Relation.EqvGen r ⟨m, q, hq⟩ ⟨m + 1, q', hq'⟩ := by
  rw [← deltaMove_mk_eq hq h' hq' e]
  exact hΔ ⟨m, q, hq⟩ j w h' (h.closedInterior_subset ht hx hy hz)
    (Affine.Triangle.dist_points_le ht hδ hxy hxz hyz)

/-- One subdivision of the midpoint subdivision of the triangle of `h`: subdividing an edge at the
image `x` under the chart of one of the six points of the standard subdivision is in the
equivalence relation generated by `r` when `hsub` provides the subdivisions at points of the
triangle of `h`. -/
private theorem eqvGen_insertVertex_of_triangleChart
    {r : SimplePolygon ℝ P → SimplePolygon ℝ P → Prop} {n : ℕ} {poly : Polygon P n} {i : Fin n}
    {c : P} (h : poly.IsDeltaMove ℝ i c)
    (hsub : ∀ (q : SimplePolygon ℝ P) (j : Fin q.numVertices) (x : P),
      x ∈ q.toPolygon.edgeSet ℝ j → x ∈ h.triangle.closedInterior →
        ∀ hq, Relation.EqvGen r q (q.insertVertex j x hq))
    {m : ℕ} [NeZero m] {q : Polygon P m} (hq : q.IsSimple ℝ) {j : Fin m} {X : ℝ × ℝ}
    (hX : X ∈ ({(0, 0), (1, 0), (0, 1), (1 / 2, 0), (0, 1 / 2), (1 / 2, 1 / 2)} : Set (ℝ × ℝ)))
    {x : P} (hXx : triangleChart ℝ (poly i) (poly (finRotate n i)) c X = x)
    (hx : x ∈ q.edgeSet ℝ j) {q' : Polygon P (m + 1)} (hq' : q'.IsSimple ℝ)
    (e : q.insertVertex j x = q') :
    Relation.EqvGen r ⟨m, q, hq⟩ ⟨m + 1, q', hq'⟩ := by
  rw [← insertVertex_mk_eq hq j x (e ▸ hq') hq' e]
  exact hsub ⟨m, q, hq⟩ j x hx (hXx ▸ h.triangleChart_mem_closedInterior hX) _

/-- **The four Δ-moves of the midpoint subdivision.** When the sides of the triangle `abc` of `h`
are at most `2 * δ`, the Δ-moves across the four triangles of its midpoint subdivision lead from
`⋯ a m_ab b ⋯` to `⋯ a m_ac c m_cb b ⋯` in the equivalence relation generated by `r`, as soon as
it contains the Δ-moves across triangles inside `abc` with sides at most `δ`. -/
private theorem exists_eqvGen_midpointSubdivision
    {r : SimplePolygon ℝ P → SimplePolygon ℝ P → Prop} {n : ℕ} {poly : Polygon P n}
    {i : Fin n} {c : P} (h : poly.IsDeltaMove ℝ i c) {δ : ℝ}
    (hδ : ∀ k l, dist (h.triangle.points k) (h.triangle.points l) ≤ 2 * δ)
    (hΔ : ∀ (q : SimplePolygon ℝ P) (j : Fin q.numVertices) (x : P)
      (h' : q.toPolygon.IsDeltaMove ℝ j x),
      h'.triangle.closedInterior ⊆ h.triangle.closedInterior →
        (∀ k l, dist (h'.triangle.points k) (h'.triangle.points l) ≤ δ) →
          Relation.EqvGen r q (q.deltaMove j x h'))
    (hs₁ : (poly.insertVertex i (midpoint ℝ (poly i) (poly (finRotate n i)))).IsSimple ℝ) :
    ∃ hs₅ : (((poly.insertVertex i (midpoint ℝ (poly i) c)).insertVertex i.succ
        (midpoint ℝ c (poly (finRotate n i)))).insertVertex i.succ.castSucc c).IsSimple ℝ,
      Relation.EqvGen r ⟨_, _, hs₁⟩ ⟨_, _, hs₅⟩ := by
  have E := Relation.EqvGen.is_equivalence r
  -- The sides of the triangle `abc` of the move are at most `2 * δ`.
  have hpts := h.triangle_points
  have hab : dist (poly i) (poly (finRotate n i)) ≤ 2 * δ := by simpa [hpts] using hδ 0 1
  have hac : dist (poly i) c ≤ 2 * δ := by simpa [hpts] using hδ 0 2
  have hcb : dist c (poly (finRotate n i)) ≤ 2 * δ := by simpa [hpts, dist_comm] using hδ 1 2
  have hδ₀ : 0 ≤ δ := by linarith [dist_nonneg (x := poly i) (y := c)]
  have hac_cb : dist (midpoint ℝ (poly i) c) (midpoint ℝ c (poly (finRotate n i))) ≤ δ := by
    rw [midpoint_comm (poly i) c, dist_midpoint_midpoint_same_left]
    exact half_mul_le hab
  -- The four Δ-moves and the polygons `⋯ a m_ac m_ab b ⋯`, `⋯ a m_ac m_cb m_ab b ⋯` and
  -- `⋯ a m_ac m_cb b ⋯` between them.
  have h₁ := h.isDeltaMove_corner_a
  have h₂ := h.isDeltaMove_middle
  have h₃ := h.isDeltaMove_corner_b
  have h₄ := h.isDeltaMove_corner_c
  have hs₂ := h₁.isSimple_insertVertex hs₁
  have hs₃ := h₂.isSimple_insertVertex hs₂
  have e₃ := insertVertex_insertVertex_insertVertex_middle poly i
    (midpoint ℝ (poly i) (poly (finRotate n i))) (midpoint ℝ (poly i) c)
    (midpoint ℝ c (poly (finRotate n i)))
  have hs₄ := h₃.isSimple_of_isSimple_insertVertex (e₃ ▸ hs₃)
  have hs₅ := h₄.isSimple_insertVertex hs₄
  -- The Δ-move across `a m_ab m_ac`.
  have c₂ : Relation.EqvGen r ⟨_, _, hs₁⟩ ⟨_, _, hs₂⟩ :=
    eqvGen_deltaMove_of_mem_midpoints h hΔ hs₁ h₁ hs₂ rfl h.isDeltaMove_corner_a_triangle_points
      (by simp) (by simp) (by simp) hδ₀ ((dist_left_midpoint _ _).trans_le (half_mul_le hab))
      ((dist_left_midpoint _ _).trans_le (half_mul_le hac))
      ((dist_midpoint_midpoint_same_left _ _ _).trans_le (half_mul_le (by rwa [dist_comm])))
  -- The Δ-move across `m_ac m_ab m_cb`.
  have c₃ : Relation.EqvGen r ⟨_, _, hs₂⟩ ⟨_, _, hs₃⟩ :=
    eqvGen_deltaMove_of_mem_midpoints h hΔ hs₂ h₂ hs₃ rfl h.isDeltaMove_middle_triangle_points
      (by simp) (by simp) (by simp) hδ₀
      ((dist_midpoint_midpoint_same_left _ _ _).trans_le (half_mul_le hcb)) hac_cb
      ((dist_midpoint_midpoint_same_right _ _ _).trans_le (half_mul_le hac))
  -- The Δ-move across `m_cb b m_ab`, read backwards from `⋯ a m_ac m_cb m_ab b ⋯`.
  have c₄ : Relation.EqvGen r ⟨_, _, hs₄⟩ ⟨_, _, hs₃⟩ := by
    have hmid : dist (midpoint ℝ c (poly (finRotate n i)))
        (midpoint ℝ (poly i) (poly (finRotate n i))) ≤ δ := by
      rw [dist_midpoint_midpoint_same_right]
      exact half_mul_le (by rwa [dist_comm])
    exact eqvGen_deltaMove_of_mem_midpoints h hΔ hs₄ h₃ hs₃ e₃.symm
      h.isDeltaMove_corner_b_triangle_points (by simp) (by simp) (by simp) hδ₀
      ((dist_midpoint_right _ _).trans_le (half_mul_le hcb)) hmid
      ((dist_right_midpoint _ _).trans_le (half_mul_le hab))
  -- The Δ-move across `m_ac m_cb c`.
  have c₅ : Relation.EqvGen r ⟨_, _, hs₄⟩ ⟨_, _, hs₅⟩ :=
    eqvGen_deltaMove_of_mem_midpoints h hΔ hs₄ h₄ hs₅ rfl h.isDeltaMove_corner_c_triangle_points
      (by simp) (by simp) (by simp) hδ₀ hac_cb
      ((dist_midpoint_right _ _).trans_le (half_mul_le hac))
      ((dist_midpoint_left _ _).trans_le (half_mul_le hcb))
  exact ⟨hs₅, E.trans c₂ (E.trans c₃ (E.trans (E.symm c₄) c₅))⟩

/-- **One midpoint subdivision.** A Δ-move whose triangle has sides at most `2 * δ` is in the
equivalence relation generated by `r`, as soon as that equivalence relation contains the
subdivisions of edges at points of the triangle and the Δ-moves across triangles inside it with
sides at most `δ`. -/
private theorem eqvGen_deltaMove_of_halves {r : SimplePolygon ℝ P → SimplePolygon ℝ P → Prop}
    {n : ℕ} [NeZero n] {poly : Polygon P n} (hp : poly.IsSimple ℝ) {i : Fin n} {c : P}
    (h : poly.IsDeltaMove ℝ i c) {δ : ℝ}
    (hδ : ∀ k l, dist (h.triangle.points k) (h.triangle.points l) ≤ 2 * δ)
    (hsub : ∀ (q : SimplePolygon ℝ P) (j : Fin q.numVertices) (x : P),
      x ∈ q.toPolygon.edgeSet ℝ j → x ∈ h.triangle.closedInterior →
        ∀ hq, Relation.EqvGen r q (q.insertVertex j x hq))
    (hΔ : ∀ (q : SimplePolygon ℝ P) (j : Fin q.numVertices) (x : P)
      (h' : q.toPolygon.IsDeltaMove ℝ j x),
      h'.triangle.closedInterior ⊆ h.triangle.closedInterior →
        (∀ k l, dist (h'.triangle.points k) (h'.triangle.points l) ≤ δ) →
          Relation.EqvGen r q (q.deltaMove j x h')) :
    Relation.EqvGen r ⟨n, poly, hp⟩ (SimplePolygon.deltaMove ⟨n, poly, hp⟩ i c h) := by
  -- Following the module docstring, the simple polygons `⟨_, _, hs₁⟩, …, ⟨_, _, hs₇⟩` lead from
  -- `⋯ a b ⋯` to `⋯ a c b ⋯` through the four triangles of the midpoint subdivision of `abc`;
  -- consecutive ones are related by a subdivision or a Δ-move, in one direction or the other.
  have E := Relation.EqvGen.is_equivalence r
  -- The polygon `⋯ a m_ab b ⋯`, from which the four Δ-moves lead to `⋯ a m_ac c m_cb b ⋯`.
  have hs₁ : (poly.insertVertex i (midpoint ℝ (poly i) (poly (finRotate n i)))).IsSimple ℝ := by
    have := hp.insertVertex_edgePath i (s := (1 / 2 : ℝ)) ⟨by norm_num, by norm_num⟩
    rwa [edgePath, lineMap_one_half] at this
  obtain ⟨hs₅, c₂₅⟩ := exists_eqvGen_midpointSubdivision h hδ hΔ hs₁
  -- The polygons `⋯ a c b ⋯` and `⋯ a c m_cb b ⋯`; subdividing `[a, c]` at `m_ac` gives
  -- `⋯ a m_ac c m_cb b ⋯` again.
  have hs₇ := h.isSimple_insertVertex hp
  have hs₆ : ((poly.insertVertex i c).insertVertex i.succ
      (midpoint ℝ c (poly (finRotate n i)))).IsSimple ℝ := by
    have := hs₇.insertVertex_edgePath i.succ (s := (1 / 2 : ℝ)) ⟨by norm_num, by norm_num⟩
    rwa [edgePath_insertVertex_succ_self, lineMap_one_half] at this
  have e₅ := insertVertex_insertVertex_insertVertex_corner poly i (midpoint ℝ (poly i) c)
    (midpoint ℝ c (poly (finRotate n i))) c
  -- Subdivide `[a, b]` at `m_ab`.
  have c₁ : Relation.EqvGen r ⟨n, poly, hp⟩ ⟨_, _, hs₁⟩ :=
    eqvGen_insertVertex_of_triangleChart h hsub hp (X := (1 / 2, 0)) (by simp)
      (triangleChart_apply_half_zero _ _ _) (wbtw_midpoint ℝ _ _) hs₁ rfl
  -- Subdividing `[a, c]` at `m_ac` gives `⋯ a m_ac c m_cb b ⋯` back from `⋯ a c m_cb b ⋯`.
  have c₆ : Relation.EqvGen r ⟨_, _, hs₆⟩ ⟨_, _, hs₅⟩ := by
    have hidx : i.castSucc.castSucc = i.succ.succ.succAbove i.castSucc :=
      (Fin.succAbove_of_castSucc_lt _ _ (by simp [Fin.lt_def])).symm
    refine eqvGen_insertVertex_of_triangleChart h hsub hs₆ (X := (0, 1 / 2)) (by simp)
      (triangleChart_apply_zero_half _ _ _) ?_ hs₅ e₅.symm
    rw [hidx, edgeSet_insertVertex_succAbove _ _ _ Fin.castSucc_lt_succ.ne,
      edgeSet_insertVertex_castSucc_self]
    exact wbtw_midpoint ℝ _ _
  -- Subdividing `[c, b]` at `m_cb` gives `⋯ a c m_cb b ⋯` from `⋯ a c b ⋯`.
  have c₇ : Relation.EqvGen r ⟨_, _, hs₇⟩ ⟨_, _, hs₆⟩ :=
    eqvGen_insertVertex_of_triangleChart h hsub hs₇ (j := i.succ) (X := (1 / 2, 1 / 2)) (by simp)
      (triangleChart_apply_half_half _ _ _)
      (by rw [edgeSet_insertVertex_succ_self]; exact wbtw_midpoint ℝ _ _) hs₆ rfl
  rw [deltaMove_mk_eq hp h hs₇ rfl]
  exact E.trans c₁ (E.trans c₂₅ (E.trans (E.symm c₆) (E.symm c₇)))

/-- **Δ-moves across small triangles.** Let `r` be a relation on simple polygons that relates
every simple polygon to its subdivision of an edge at a point of the triangle `D` of a Δ-move on
`p`, and to the result of every Δ-move across a triangle contained in `D` whose vertices are at
distance at most `ε > 0` from one another. Then `p` and the result of the Δ-move are related by
the equivalence relation generated by `r`.

So a Δ-move is a composition of subdivisions of edges, their inverses, and Δ-moves and inverse
Δ-moves across arbitrarily small triangles inside its own triangle. -/
theorem eqvGen_deltaMove_of_small {r : SimplePolygon ℝ P → SimplePolygon ℝ P → Prop}
    (p : SimplePolygon ℝ P) (i : Fin p.numVertices) (c : P)
    (h : p.toPolygon.IsDeltaMove ℝ i c) {ε : ℝ} (hε : 0 < ε)
    (hsub : ∀ (q : SimplePolygon ℝ P) (j : Fin q.numVertices) (x : P),
      x ∈ q.toPolygon.edgeSet ℝ j → x ∈ h.triangle.closedInterior →
        ∀ hq, r q (q.insertVertex j x hq))
    (hΔ : ∀ (q : SimplePolygon ℝ P) (j : Fin q.numVertices) (x : P)
      (h' : q.toPolygon.IsDeltaMove ℝ j x),
      h'.triangle.closedInterior ⊆ h.triangle.closedInterior →
        (∀ k l, dist (h'.triangle.points k) (h'.triangle.points l) ≤ ε) →
          r q (q.deltaMove j x h')) :
    Relation.EqvGen r p (p.deltaMove i c h) := by
  -- By induction on `m`, a Δ-move across a triangle inside that of `h` with sides at most
  -- `2 ^ m * ε` is in the equivalence relation: halve the triangle `m` times.
  have key (m : ℕ) : ∀ (q : SimplePolygon ℝ P) (j : Fin q.numVertices) (x : P)
      (h' : q.toPolygon.IsDeltaMove ℝ j x),
      h'.triangle.closedInterior ⊆ h.triangle.closedInterior →
        (∀ k l, dist (h'.triangle.points k) (h'.triangle.points l) ≤ 2 ^ m * ε) →
          Relation.EqvGen r q (q.deltaMove j x h') := by
    induction m with
    | zero =>
      intro q j x h' hD hd
      exact .rel _ _ (hΔ q j x h' hD (by simpa using hd))
    | succ m ih =>
      rintro ⟨N, poly, hp⟩ j x h' hD hd
      exact eqvGen_deltaMove_of_halves hp h' (δ := 2 ^ m * ε)
        (fun k l => (hd k l).trans_eq (by ring))
        (fun q₁ j₁ x₁ hx hx' hq => .rel _ _ (hsub q₁ j₁ x₁ hx (hD hx') hq))
        (fun q₁ j₁ x₁ h₁ hD₁ hd₁ => ih q₁ j₁ x₁ h₁ (hD₁.trans hD) hd₁)
  -- Choose `m` with `2 ^ m * ε` larger than every distance between the vertices of `h`.
  obtain ⟨C, hC⟩ := Metric.isBounded_iff.1 (finite_range h.triangle.points).isBounded
  obtain ⟨m, hm⟩ := pow_unbounded_of_one_lt (C / ε) one_lt_two
  rw [div_lt_iff₀ hε] at hm
  exact key m p i c h subset_rfl fun k l =>
    (hC (mem_range_self k) (mem_range_self l)).trans hm.le

end SimplePolygon

end TauCeti
