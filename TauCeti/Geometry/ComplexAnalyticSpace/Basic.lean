module

public import Mathlib.AlgebraicGeometry.GammaSpecAdjunction
public import Mathlib.CategoryTheory.Comma.Over.Basic
public import Mathlib.CategoryTheory.ObjectProperty.FullSubcategory
public import TauCeti.Geometry.Manifold.Complex.StructureSheaf.ClosedSubspace
public import TauCeti.Geometry.RingedSpace.LocallyRingedSpace.ULift

/-!
# Complex analytic spaces

A complex analytic space is a locally ringed space over `Spec ℂ` which is locally isomorphic to a
local model `(V(J), (𝒪_U ⧸ J 𝒪_U)|_{V(J)})`: the closed analytic subspace
`TauCeti.closedAnalyticSubspace J` cut out by a finitely generated ideal `J` of holomorphic
functions on an open subset `U` of `ℂⁿ`. Nilpotents are kept: the structure sheaf of the model is
the quotient by `J` itself, not by its radical. No Hausdorff condition is imposed.

The local models are built in universe `0`, from the holomorphic functions on `U ⊆ ℂⁿ`. For each
universe `u` they are transported along `ULift` (`AlgebraicGeometry.LocallyRingedSpace.ulift`) to
locally ringed spaces over `Spec (ULift ℂ)` in universe `u`, the structure morphism to
`Spec (ULift ℂ)` being given by the constant functions. Complex analytic spaces in universe `u` are
the full subcategory of `Over (Spec (ULift ℂ))` in `LocallyRingedSpace.{u}` cut out by the
local-model condition, so that their morphisms are the morphisms of locally ringed spaces
commuting with the structure morphisms to `Spec (ULift ℂ)`.

An ideal sheaf on `U` which is generated by finitely many sections near each point is, near each
point, generated by finitely many holomorphic functions on a smaller open set. Since the
local-model condition is local, using finitely generated ideals of holomorphic functions on `U`
defines the same spaces as using finitely generated ideal sheaves.

## Main definitions

* `TauCeti.closedAnalyticSubspace.toOver J`: the closed analytic subspace cut out by `J`, in
  universe `u`, over `Spec (ULift ℂ)`.
* `TauCeti.IsComplexAnalyticSpace`: the local-model condition on locally ringed spaces over
  `Spec (ULift ℂ)`.
* `TauCeti.ComplexAnalyticSpace`: the category of complex analytic spaces in universe `u`.
* `TauCeti.ComplexAnalyticSpace.ofClosedAnalyticSubspace J hJ`: the local model cut out by a
  finitely generated ideal `J`, as a complex analytic space.

## Main results

* `TauCeti.closedAnalyticSubspace.toOverStalkEquiv`: the stalk of the local model in universe `u`
  at a point `z` of `V(J)` is `𝒪_{X,z} ⧸ J_z`.
* `TauCeti.closedAnalyticSubspace.not_isReduced_stalk_toOver_span_sq`: nilpotents survive in the
  local models; the ideal `(f²)` cuts out a nonreduced space wherever the germ of `f` is nonzero.
* `TauCeti.isComplexAnalyticSpace_iff`: the local-model condition, unfolded.
* `TauCeti.isComplexAnalyticSpace_toOver`: each local model is a complex analytic space.

## References

* Gerd Fischer, *Complex Analytic Geometry*, Lecture Notes in Mathematics 538, Springer, 1976,
  Chapter 0 (local models and complex spaces).
* Eberhard Freitag, *Complex Spaces*, lecture notes, 2017, Chapter II, Definitions 2.1–2.3 and
  Remark 2.4.
* Hans Grauert and Reinhold Remmert, *Coherent Analytic Sheaves*, Grundlehren der mathematischen
  Wissenschaften 265, Springer, 1984, Chapter 1.
-/

public noncomputable section

universe u

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry
open scoped Manifold

namespace TauCeti

namespace closedAnalyticSubspace

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℂ E H}
  {X : Type} [TopologicalSpace X] [ChartedSpace H X]
  (J : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤)))

/-- **The local model of complex analytic spaces in universe `u`.** The closed analytic subspace
cut out by `J`, transported to universe `u` along `ULift`, over `Spec (ULift ℂ)` through its
constant functions.

The body is exposed so that the points and sections of the local model are definitionally those of
the universe lift (`toOver_left`). -/
@[expose] def toOver : Over (Spec (CommRingCat.of (ULift.{u} ℂ))).toLocallyRingedSpace :=
  Over.mk ((closedAnalyticSubspace J).ulift.{u}.toΓSpec ≫
    Spec.locallyRingedSpaceMap (CommRingCat.ofHom (constRingHom J).ulift ≫
      ((closedAnalyticSubspace J).uliftΓIso.{u}).inv))

/-- The local model in universe `u` is the universe lift of the closed analytic subspace. -/
@[simp]
theorem toOver_left : (toOver.{u} J).left = (closedAnalyticSubspace J).ulift.{u} :=
  (rfl)

/-- The structure morphism of the local model is the canonical morphism to the spectrum of its
global sections, followed by the morphism of spectra induced by the constant functions. -/
theorem toOver_hom :
    (toOver.{u} J).hom = (closedAnalyticSubspace J).ulift.{u}.toΓSpec ≫
      Spec.locallyRingedSpaceMap (CommRingCat.ofHom (constRingHom J).ulift ≫
        ((closedAnalyticSubspace J).uliftΓIso.{u}).inv) :=
  (rfl)

/-- **The stalks of the local model.** The stalk of the local model in universe `u` at a point `z`
of `V(J)` is the quotient `𝒪_{X,z} ⧸ J_z` of the holomorphic stalk. -/
def toOverStalkEquiv (z : zeroLocus J) :
    (toOver.{u} J).left.presheaf.stalk (ULift.up z) ≃+*
      (holomorphicStructureSheaf I X).presheaf.stalk z.val ⧸
        (holomorphicStructureSheaf I X).presheaf.stalkIdeal J z.val :=
  ((closedAnalyticSubspace J).uliftStalkRingEquiv.{u} z).trans (stalkEquiv J z)

variable {J} in
/-- The stalk isomorphism of the local model sends the germ of a section at `z` to its class at
`z`. -/
@[simp]
theorem toOverStalkEquiv_germ {z : zeroLocus J} {W : Opens (toOver.{u} J).left.carrier}
    (hz : ULift.up z ∈ W) (f : (toOver.{u} J).left.presheaf.obj (op W)) :
    toOverStalkEquiv J z ((toOver.{u} J).left.presheaf.germ W (ULift.up z) hz f) =
      (TopCat.Presheaf.quotientIdealSheaf.sectionsEquiv _ J (zeroLocus J)
        ((closedAnalyticSubspace J).uliftOpensEquiv.{u}.functor.obj W) f.down).val ⟨z, hz⟩ :=
  -- By definition, `toOverStalkEquiv` applies `stalkEquiv` to the lifted stalk isomorphism,
  -- which sends the germ of `f` to the germ of `f.down`.
  (congrArg (stalkEquiv J z)
    ((closedAnalyticSubspace J).uliftStalkRingEquiv_germ.{u} W z hz f)).trans
      (stalkEquiv_germ hz f.down)

/-- **Nilpotents survive in the local model.** If `f` has a nonzero germ at a point `z` of the
zero locus of `f ^ 2`, then the stalk at `z` of the local model cut out by `f ^ 2` in universe `u`
is not reduced. -/
theorem not_isReduced_stalk_toOver_span_sq
    {f : (holomorphicStructureSheaf I X).presheaf.obj (op ⊤)} (z : zeroLocus (Ideal.span {f ^ 2}))
    (hf : (holomorphicStructureSheaf I X).presheaf.germ ⊤ z.val (Opens.mem_top _) f ≠ 0) :
    ¬ IsReduced ((toOver.{u} (Ideal.span {f ^ 2})).left.presheaf.stalk (ULift.up z)) := by
  intro hred
  -- The local model is the universe lift by `rfl` (`toOver_left`), so the stalk ring isomorphism
  -- of the universe lift applies to its stalks. The point `ULift.up z` depends on the space, so
  -- `rw [toOver_left]` would produce an ill-typed motive.
  let e : (toOver.{u} (Ideal.span {f ^ 2})).left.presheaf.stalk (ULift.up z) ≃+*
      (closedAnalyticSubspace (Ideal.span {f ^ 2})).presheaf.stalk z :=
    (closedAnalyticSubspace _).uliftStalkRingEquiv.{u} z
  exact not_isReduced_stalk_span_sq z hf (isReduced_of_injective e.symm.toRingHom e.symm.injective)

/-- The unit ideal cuts out the empty local model. -/
instance isEmpty_toOver_top : IsEmpty (toOver.{u} (⊤ : Ideal
    ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤)))).left :=
  ⟨fun z ↦ (Set.eq_empty_iff_forall_notMem.mp zeroLocus_top) z.down.val z.down.property⟩

end closedAnalyticSubspace

/-- **The local-model condition.** A locally ringed space `X` over `Spec (ULift ℂ)` satisfies it
when every point of `X` has an open neighbourhood `W` which, over `Spec (ULift ℂ)`, is isomorphic
to the local model `(V(J), (𝒪_U ⧸ J 𝒪_U)|_{V(J)})` cut out by a finitely generated ideal `J` of
holomorphic functions on an open subset `U` of some `ℂⁿ`. -/
def IsComplexAnalyticSpace :
    ObjectProperty (Over (Spec (CommRingCat.of (ULift.{u} ℂ))).toLocallyRingedSpace) :=
  fun X ↦ ∀ x : X.left, ∃ (W : Opens X.left) (_ : x ∈ W) (n : ℕ) (U : Opens (Fin n → ℂ))
    (J : Ideal ((holomorphicStructureSheaf 𝓘(ℂ, Fin n → ℂ) U).presheaf.obj (op ⊤))), J.FG ∧
      Nonempty (Over.mk (X.left.ofRestrict W.isOpenEmbedding ≫ X.hom) ≅
        closedAnalyticSubspace.toOver.{u} J)

/-- A locally ringed space over `Spec (ULift ℂ)` satisfies the local-model condition exactly when
every point has an open neighbourhood isomorphic over `Spec (ULift ℂ)` to a local model cut out by
a finitely generated ideal. -/
theorem isComplexAnalyticSpace_iff
    (X : Over (Spec (CommRingCat.of (ULift.{u} ℂ))).toLocallyRingedSpace) :
    IsComplexAnalyticSpace X ↔ ∀ x : X.left, ∃ (W : Opens X.left) (_ : x ∈ W) (n : ℕ)
      (U : Opens (Fin n → ℂ))
      (J : Ideal ((holomorphicStructureSheaf 𝓘(ℂ, Fin n → ℂ) U).presheaf.obj (op ⊤))), J.FG ∧
        Nonempty (Over.mk (X.left.ofRestrict W.isOpenEmbedding ≫ X.hom) ≅
          closedAnalyticSubspace.toOver.{u} J) :=
  Iff.rfl

/-- **Complex analytic spaces** in universe `u`: locally ringed spaces over `Spec (ULift ℂ)` which
are locally isomorphic to the local models `(V(J), (𝒪_U ⧸ J 𝒪_U)|_{V(J)})`, for finitely
generated ideals `J` of holomorphic functions on open subsets `U` of `ℂⁿ`. Morphisms are morphisms
of locally ringed spaces over `Spec (ULift ℂ)`. -/
abbrev ComplexAnalyticSpace : Type (u + 1) :=
  IsComplexAnalyticSpace.{u}.FullSubcategory

/-- **The local models are complex analytic spaces.** The closed analytic subspace cut out by a
finitely generated ideal of holomorphic functions on an open subset of `ℂⁿ`, at every universe,
satisfies the local-model condition, with the whole space as the neighbourhood of every point. -/
theorem isComplexAnalyticSpace_toOver {n : ℕ} {U : Opens (Fin n → ℂ)}
    {J : Ideal ((holomorphicStructureSheaf 𝓘(ℂ, Fin n → ℂ) U).presheaf.obj (op ⊤))}
    (hJ : J.FG) : IsComplexAnalyticSpace (closedAnalyticSubspace.toOver.{u} J) :=
  -- The morphism underlying `restrictTopIso` is `ofRestrict`, so it commutes with the structure
  -- morphisms by definition.
  (isComplexAnalyticSpace_iff _).mpr fun _ ↦
    ⟨⊤, trivial, n, U, J, hJ, ⟨Over.isoMk (LocallyRingedSpace.restrictTopIso _) rfl⟩⟩

namespace ComplexAnalyticSpace

/-- The local model cut out by a finitely generated ideal `J` of holomorphic functions on an open
subset `U` of `ℂⁿ`, as a complex analytic space in universe `u`. -/
def ofClosedAnalyticSubspace {n : ℕ} {U : Opens (Fin n → ℂ)}
    (J : Ideal ((holomorphicStructureSheaf 𝓘(ℂ, Fin n → ℂ) U).presheaf.obj (op ⊤)))
    (hJ : J.FG) : ComplexAnalyticSpace.{u} :=
  ⟨closedAnalyticSubspace.toOver.{u} J, isComplexAnalyticSpace_toOver hJ⟩

end ComplexAnalyticSpace

end TauCeti
