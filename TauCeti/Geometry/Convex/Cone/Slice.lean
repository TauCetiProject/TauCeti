/-!
# Slices of finitely generated cones

Fixed-height slices of a pointed cone in `V × K` are convex, and cone faces induce extreme
subsets of these slices. For a cone generated by a finite set `s` whose generators all have
nonnegative height, the height-one slice decomposes into the convex hull of the normalized
positive-height generators plus the cone generated by the zero-height generators, and the
height-zero slice is exactly the latter cone. No boundedness, salience, topology, or ambient
dimension is assumed; the only condition is that every generator has nonnegative height.

Adapted from `Mei/Geometry/Convex/Cone/Slice.lean` in
[yuma-mizuno-lean/Mei](https://github.com/yuma-mizuno-lean/Mei), commit
`3d2e9c869ee44c41ae9c7b5c6e2042898430d0ca` (Apache 2.0).
-/

public section

open scoped BigOperators Pointwise

namespace PointedCone

variable {K V : Type*} [Semiring K] [PartialOrder K] [IsOrderedRing K]
  [AddCommMonoid V] [Module K V]

/-- Every fixed-height slice of a pointed cone is convex. -/
theorem convex_slice (C : PointedCone K (V × K)) (t : K) :
    Convex K {x : V | (x, t) ∈ C} := by
  intro x hx y hy a b ha hb hab
  have hm := C.convex hx hy ha hb hab
  simp only [Set.mem_ofPred_eq]
  have he : (a • x + b • y, t) = a • (x, t) + b • (y, t) := by
    ext
    · simp
    · simp [← add_mul, hab]
  rw [he]
  exact hm

namespace IsFaceOf

-- `IsFaceOf` needs `AddCommGroup (V × K)`, hence `Ring K`.
variable {K V : Type*} [Ring K] [PartialOrder K] [IsOrderedRing K]
  [AddCommGroup V] [Module K V]

/-- Taking fixed-height slices preserves the extreme-subset property of a cone face. -/
theorem isExtreme_slice {C G : PointedCone K (V × K)} (hG : G.IsFaceOf C) (t : K) :
    IsExtreme K {x : V | (x, t) ∈ C} {x : V | (x, t) ∈ G} := by
  refine ⟨fun _ hx => hG.le hx, ?_⟩
  rintro x hx y hy z hz ⟨a, b, ha, hb, hab, heq⟩
  apply hG.mem_of_smul_add_smul_mem_left hx hy ha hb
  have hprod : a • (x, t) + b • (y, t) = (z, t) := by
    apply Prod.ext
    · exact heq
    · simp [← add_mul, hab]
  rw [hprod]
  exact hz

end IsFaceOf

end PointedCone

namespace Finset

open PointedCone

variable {K V : Type*}

section Zero

variable [Zero K]

/-- Project the zero-height generators to `V`. -/
noncomputable def zeroSliceGenerators (s : Finset (V × K)) : Finset V := by
  classical
  exact (s.filter (fun z => z.2 = 0)).image Prod.fst

/-- Membership records an original zero-height generator with the prescribed projection. -/
@[simp]
theorem mem_zeroSliceGenerators {s : Finset (V × K)} {x : V} :
    x ∈ zeroSliceGenerators s ↔ ∃ z ∈ s, z.2 = 0 ∧ z.1 = x := by
  classical
  simp only [zeroSliceGenerators, Finset.mem_image, Finset.mem_filter, and_assoc]

end Zero

section OrderedSemiring

variable [Semiring K] [PartialOrder K] [IsOrderedRing K] [AddCommMonoid V] [Module K V]

/-- A point of the cone generated by `s` is a nonnegative combination of `s`; this records
the `V`-component and the height of such a combination. -/
theorem exists_sum_smul_of_mem_hull {s : Finset (V × K)} {p : V × K}
    (hp : p ∈ hull K (s : Set (V × K))) :
    ∃ c : V × K → {t : K // 0 ≤ t},
      ∑ z ∈ s, (c z : K) • z.1 = p.1 ∧ ∑ z ∈ s, (c z : K) * z.2 = p.2 := by
  obtain ⟨c, -, he⟩ := Submodule.mem_span_finset.mp hp
  refine ⟨c, ?_, ?_⟩
  · simpa only [Prod.fst_sum, Prod.smul_fst, ← Nonneg.coe_smul] using congrArg Prod.fst he
  · simpa only [Prod.snd_sum, Prod.smul_snd, ← Nonneg.coe_smul, smul_eq_mul]
      using congrArg Prod.snd he

/-- The projected zero-height generator cone embeds into the original cone at height zero. -/
theorem hull_zeroSliceGenerators_le_comap (s : Finset (V × K)) :
    hull K (zeroSliceGenerators s : Set V) ≤
      (hull K (s : Set (V × K))).comap (LinearMap.inl K V K) := by
  classical
  apply Submodule.span_le.mpr
  intro v hv
  obtain ⟨z, hzs, hz0, rfl⟩ := mem_zeroSliceGenerators.mp hv
  have he : (z.1, (0 : K)) = z := Prod.ext rfl hz0.symm
  simp only [PointedCone.coe_comap, Set.mem_preimage, LinearMap.inl_apply]
  rw [he]
  exact subset_hull hzs

end OrderedSemiring

section OrderedField

variable [Field K] [LinearOrder K] [IsStrictOrderedRing K] [AddCommGroup V] [Module K V]

/-- Normalize the positive-height generators to height one and project to `V`. -/
noncomputable def positiveSliceGenerators (s : Finset (V × K)) : Finset V := by
  classical
  exact (s.filter (fun z => 0 < z.2)).image (fun z => z.2⁻¹ • z.1)

omit [IsStrictOrderedRing K] in
/-- Membership records the original positive-height generator and its normalization. -/
@[simp]
theorem mem_positiveSliceGenerators {s : Finset (V × K)} {x : V} :
    x ∈ positiveSliceGenerators s ↔ ∃ z ∈ s, 0 < z.2 ∧ z.2⁻¹ • z.1 = x := by
  classical
  simp only [positiveSliceGenerators, Finset.mem_image, Finset.mem_filter, and_assoc]

/-- Normalized positive-height generators embed into the original cone at height one. -/
theorem mem_hull_one_of_mem_positiveSliceGenerators {s : Finset (V × K)} {x : V}
    (hx : x ∈ positiveSliceGenerators s) : (x, (1 : K)) ∈ hull K (s : Set (V × K)) := by
  classical
  obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hx
  obtain ⟨hzs, hzpos⟩ := Finset.mem_filter.mp hz
  have hm := PointedCone.smul_mem (hull K (s : Set (V × K)))
    (inv_nonneg.mpr hzpos.le) (subset_hull hzs)
  convert hm using 1
  ext <;> simp [hzpos.ne']

/-- The convex hull of the normalized positive generators lies in the height-one slice. -/
theorem convexHull_positiveSliceGenerators_subset (s : Finset (V × K)) :
    convexHull K (positiveSliceGenerators s : Set V) ⊆
      {x : V | (x, (1 : K)) ∈ hull K (s : Set (V × K))} :=
  convexHull_min (fun _ hx => mem_hull_one_of_mem_positiveSliceGenerators hx)
    (convex_slice _ 1)

/-- A nonnegative combination of the positive-height generators of height one lies in the
convex hull of the normalized positive-height generators. -/
theorem sum_smul_mem_convexHull_positiveSliceGenerators {s : Finset (V × K)} {c : V × K → K}
    (hc : ∀ z ∈ s, 0 ≤ c z) (hweights : ∑ z ∈ s with 0 < z.2, c z * z.2 = 1) :
    ∑ z ∈ s with 0 < z.2, c z • z.1 ∈ convexHull K (positiveSliceGenerators s : Set V) := by
  classical
  have hm := (convex_convexHull K (positiveSliceGenerators s : Set V)).sum_mem
    (t := s.filter (fun z => 0 < z.2)) (w := fun z => c z * z.2) (z := fun z => z.2⁻¹ • z.1)
    (fun z hz => mul_nonneg (hc z (Finset.mem_filter.mp hz).1) (Finset.mem_filter.mp hz).2.le)
    hweights
    (fun z hz => subset_convexHull K _ (Finset.mem_image.mpr ⟨z, hz, rfl⟩))
  convert hm using 1
  apply Finset.sum_congr rfl
  intro z hz
  rw [smul_smul]
  simp [(Finset.mem_filter.mp hz).2.ne']

/-- If every generator in `s` has nonnegative height, the height-one slice of `hull K s` is the
convex hull of `positiveSliceGenerators s` plus the cone of `zeroSliceGenerators s`. -/
theorem setOf_prod_one_mem_hull_eq_convexHull_add (s : Finset (V × K))
    (hs : ∀ z ∈ s, 0 ≤ z.2) :
    {x : V | (x, (1 : K)) ∈ hull K (s : Set (V × K))} =
      convexHull K (positiveSliceGenerators s : Set V) +
        (hull K (zeroSliceGenerators s : Set V) : Set V) := by
  classical
  ext x
  constructor
  · intro hx
    obtain ⟨c, hfst, hheight⟩ := exists_sum_smul_of_mem_hull hx
    -- Split the generators into those of positive height and those of height zero.
    have hnzero : ∀ z ∈ s.filter (fun z => ¬0 < z.2), z.2 = 0 := by
      intro z hz
      obtain ⟨hzs, hzn⟩ := Finset.mem_filter.mp hz
      exact le_antisymm (le_of_not_gt hzn) (hs z hzs)
    have hzero : ∑ z ∈ s with ¬0 < z.2, (c z : K) * z.2 = 0 :=
      Finset.sum_eq_zero fun z hz => by simp [hnzero z hz]
    have hweights : ∑ z ∈ s with 0 < z.2, (c z : K) * z.2 = 1 := by
      have h := Finset.sum_filter_add_sum_filter_not s (fun z => 0 < z.2)
        (fun z => (c z : K) * z.2)
      rwa [hzero, add_zero, hheight] at h
    -- The positive-height part is a convex combination of the normalized generators.
    have hq := sum_smul_mem_convexHull_positiveSliceGenerators (s := s)
      (fun z _ => (c z).property) hweights
    -- The height-zero part lies in the cone of the zero-height generators.
    have hr : ∑ z ∈ s with ¬0 < z.2, (c z : K) • z.1 ∈
        hull K (zeroSliceGenerators s : Set V) := by
      apply Submodule.sum_mem
      intro z hz
      apply PointedCone.smul_mem _ (c z).property
      apply subset_hull
      exact mem_zeroSliceGenerators.mpr ⟨z, (Finset.mem_filter.mp hz).1, hnzero z hz, rfl⟩
    refine ⟨_, hq, _, hr, ?_⟩
    simpa only [Finset.sum_filter_add_sum_filter_not] using hfst
  · rintro ⟨q, hq, r, hr, rfl⟩
    have hq1 := convexHull_positiveSliceGenerators_subset s hq
    have hr0 := hull_zeroSliceGenerators_le_comap s hr
    have hm := (hull K (s : Set (V × K))).add_mem hq1 hr0
    simpa using hm

end OrderedField

section StrictOrderedSemiring

variable [Semiring K] [PartialOrder K] [IsStrictOrderedRing K] [AddCommMonoid V] [Module K V]

/-- If every generator in `s` has nonnegative height, the height-zero slice of `hull K s` is
the cone generated by the zero-height generators of `s`. Positive-height generators cannot
contribute to it. -/
theorem comap_inl_hull_eq_hull_zeroSliceGenerators (s : Finset (V × K))
    (hs : ∀ z ∈ s, 0 ≤ z.2) :
    (hull K (s : Set (V × K))).comap (LinearMap.inl K V K) =
      hull K (zeroSliceGenerators s : Set V) := by
  classical
  refine le_antisymm ?_ (hull_zeroSliceGenerators_le_comap s)
  intro x hx
  have hx' : (x, (0 : K)) ∈ hull K (s : Set (V × K)) := hx
  obtain ⟨c, hfst, hheight⟩ := exists_sum_smul_of_mem_hull hx'
  dsimp only at hfst hheight
  have hterm : ∀ z ∈ s, (c z : K) * z.2 = 0 :=
    (Finset.sum_eq_zero_iff_of_nonneg (fun z hz => mul_nonneg (c z).property (hs z hz))).mp
      hheight
  rw [← hfst]
  apply Submodule.sum_mem
  intro z hz
  by_cases hz0 : z.2 = 0
  · apply PointedCone.smul_mem _ (c z).property
    apply subset_hull
    exact mem_zeroSliceGenerators.mpr ⟨z, hz, hz0, rfl⟩
  · have hc0 : (c z : K) = 0 := by
      by_contra hc0
      have hpos := mul_pos (lt_of_le_of_ne (c z).property (Ne.symm hc0))
        (lt_of_le_of_ne (hs z hz) (Ne.symm hz0))
      exact hpos.ne' (hterm z hz)
    simp [hc0]

end StrictOrderedSemiring

end Finset
