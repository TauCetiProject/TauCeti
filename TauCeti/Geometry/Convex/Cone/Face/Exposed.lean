/-!
# Faces cut out by nonnegative linear functionals

A linear functional `φ` that is nonnegative on a pointed cone `C` cuts out the face
`C ⊓ ker φ` of `C`. This file records that fact and the finiteness property that makes such faces
useful for localization: if `C` is finitely generated, then any functional `ψ` that is nonnegative
on the face `C ⊓ ker φ` becomes nonnegative on all of `C` after adding a sufficiently large
multiple of `φ`. Conversely, a face `F` of the cone hull of a set `s` is cut out by any
functional that is nonnegative on `s` and vanishes at exactly the members of `s` lying in `F`.

The second statement is what identifies the dual of the face with the dual of `C` enlarged by
`-φ`. In toric geometry it shows that the semigroup of characters of the face `σ ∩ m^⊥` is
obtained from that of `σ` by adjoining `-m`, so the affine chart of the face is the localization of
the chart of `σ` away from the monomial of `m`. Finite generation cannot be dropped: the cone in
`ℝ²` generated by all vectors `(1, t)` with `t ≥ 0` meets the kernel of `φ (x, y) = x` only in
`0`, so `ψ (x, y) = -y` is nonnegative on that face, yet `ψ + n • φ` is negative at `(1, n + 1)`.

## Main declarations

* `PointedCone.isFaceOf_inf_ker`: a functional nonnegative on `C` cuts out a face of `C`.
* `PointedCone.inf_ker_add`: the face cut out by a sum of nonnegative functionals is the
  intersection of the faces they cut out.
* `PointedCone.inf_ker_eq_of_eq_hull`: a functional nonnegative on a generating set and vanishing
  at exactly the generators in a face `F` cuts out `F`.
* `PointedCone.FG.exists_nonneg_add_nsmul`: on a finitely generated cone, a functional
  nonnegative on the face cut out by `φ` becomes nonnegative after adding a multiple of `φ`.

Every face of a finitely generated cone is exposed by a nonnegative linear functional,
including cones with lineality and the full face. The construction uses Tucker’s theorem over
an arbitrary linearly ordered field. Over real normed spaces it gives
Mathlib’s continuous-functional `IsExposed` predicate; conversely, any nonempty exposed subset
of a cone over a linearly ordered field with an arbitrary topology is a cone face.

The finite-generation exposure results are adapted from
`Mei/Geometry/Convex/Cone/Face/Exposed.lean` at Mei commit `7f1e4c7`.

## References

* W. Fulton, *Introduction to Toric Varieties*, §§1.2–1.3.
* D. Cox, J. Little and H. Schenck, *Toric Varieties*, §1.2 and §1.3.
-/

public section

namespace PointedCone

section

variable {R M : Type*} [AddCommMonoid M]

/-- If two linear functionals `φ` and `ψ` are nonnegative on a pointed cone `C`, the face cut out
by `φ + ψ` is the intersection of the faces cut out by `φ` and by `ψ`. -/
theorem inf_ker_add [Semiring R] [PartialOrder R] [IsOrderedRing R] [Module R M]
    {C : PointedCone R M} {φ ψ : Module.Dual R M} (hφ : ∀ x ∈ C, 0 ≤ φ x)
    (hψ : ∀ x ∈ C, 0 ≤ ψ x) :
    C ⊓ PointedCone.ofSubmodule (LinearMap.ker (φ + ψ)) =
      (C ⊓ PointedCone.ofSubmodule (LinearMap.ker φ)) ⊓
        (C ⊓ PointedCone.ofSubmodule (LinearMap.ker ψ)) := by
  ext x
  simp only [Submodule.mem_inf, PointedCone.mem_ofSubmodule_iff, LinearMap.mem_ker,
    LinearMap.add_apply]
  refine ⟨fun ⟨hx, h⟩ ↦ ?_, fun ⟨⟨hx, h₁⟩, _, h₂⟩ ↦ ⟨hx, by rw [h₁, h₂, add_zero]⟩⟩
  obtain ⟨h₁, h₂⟩ := (add_eq_zero_iff_of_nonneg (hφ x hx) (hψ x hx)).1 h
  exact ⟨⟨hx, h₁⟩, hx, h₂⟩

end

section

variable {R M : Type*} [AddCommGroup M]

/-- A linear functional that is nonnegative on a pointed cone cuts out a face of the cone. -/
theorem isFaceOf_inf_ker [Semiring R] [PartialOrder R] [IsOrderedRing R] [NoZeroDivisors R]
    [Module R M] {C : PointedCone R M} {φ : Module.Dual R M} (hφ : ∀ x ∈ C, 0 ≤ φ x) :
    (C ⊓ PointedCone.ofSubmodule (LinearMap.ker φ)).IsFaceOf C := by
  refine ⟨inf_le_left, fun {x y a} hx hy ha hxy ↦ ⟨hx, ?_⟩⟩
  have hker : φ (a • x + y) = 0 := hxy.2
  rw [map_add, map_smul, smul_eq_mul] at hker
  have hax : a * φ x = 0 :=
    (add_eq_zero_iff_of_nonneg (mul_nonneg ha.le (hφ x hx)) (hφ y hy)).1 hker |>.1
  exact (mul_eq_zero.1 hax).resolve_left ha.ne'

/-- Let `F` be a face of the cone hull `C` of a set `s`. A linear functional that is nonnegative on
`s` and vanishes at exactly those members of `s` which lie in `F` cuts out `F` from `C`. -/
theorem inf_ker_eq_of_eq_hull [Semiring R] [PartialOrder R] [IsOrderedRing R] [NoZeroDivisors R]
    [Module R M] {C F : PointedCone R M} {s : Set M} (hC : C = PointedCone.hull R s)
    (hF : F.IsFaceOf C) {φ : Module.Dual R M} (hφ : ∀ x ∈ s, 0 ≤ φ x)
    (hφF : ∀ x ∈ s, φ x = 0 ↔ x ∈ F) :
    C ⊓ PointedCone.ofSubmodule (LinearMap.ker φ) = F := by
  have hφC : ∀ x ∈ C, 0 ≤ φ x := by
    subst hC
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx => exact hφ x hx
    | zero => simp
    | add x y _ _ hx hy => rw [map_add]; exact add_nonneg hx hy
    | smul c x _ hx => rw [← Nonneg.coe_smul, map_smul, smul_eq_mul]; exact mul_nonneg c.2 hx
  -- Both cones are faces of `C`, so each is generated by the members of `s` it contains.
  refine le_antisymm (((isFaceOf_inf_ker hφC).eq_hull_inter_of_eq_hull hC).le.trans
    (Submodule.span_le.2 fun x hx ↦ (hφF x hx.1).1 hx.2.2)) ?_
  exact (hF.eq_hull_inter_of_eq_hull hC).le.trans <| Submodule.span_le.2 fun x hx ↦
    ⟨hC ▸ PointedCone.subset_hull hx.1, (hφF x hx.1).2 hx.2⟩

end

section

variable {R M : Type*} [AddCommMonoid M]

/-- On a finitely generated pointed cone `C`, let `φ` be nonnegative on `C` and let `ψ` be
nonnegative on the face `C ⊓ ker φ`. Then `ψ + n • φ` is nonnegative on `C` for some natural
number `n`. -/
theorem FG.exists_nonneg_add_nsmul [Ring R] [PartialOrder R] [IsOrderedRing R] [Archimedean R]
    [Module R M] {C : PointedCone R M} (hC : C.FG) {φ ψ : Module.Dual R M}
    (hφ : ∀ x ∈ C, 0 ≤ φ x) (hψ : ∀ x ∈ C, φ x = 0 → 0 ≤ ψ x) :
    ∃ n : ℕ, ∀ x ∈ C, 0 ≤ ψ x + n • φ x := by
  obtain ⟨s, rfl⟩ := hC
  -- Each generator needs its own multiple of `φ`; the largest of them works for all of `C`.
  have hgen : ∀ v ∈ s, ∃ n : ℕ, 0 ≤ ψ v + n • φ v := by
    intro v hv
    have hvC : v ∈ PointedCone.hull R (s : Set M) := PointedCone.subset_hull hv
    rcases (hφ v hvC).eq_or_lt with h | h
    · exact ⟨0, by simpa using hψ v hvC h.symm⟩
    · obtain ⟨n, hn⟩ := Archimedean.arch (-ψ v) h
      exact ⟨n, by rwa [neg_le_iff_add_nonneg, add_comm] at hn⟩
  choose! n hn using hgen
  refine ⟨s.sup n, fun x hx ↦ ?_⟩
  induction hx using Submodule.span_induction with
  | mem v hv =>
    have hle : n v • φ v ≤ s.sup n • φ v :=
      nsmul_le_nsmul_left (hφ v (Submodule.subset_span hv)) (Finset.le_sup hv)
    exact (hn v hv).trans (add_le_add_right hle _)
  | zero => simp
  | add x y _ _ hx hy =>
    rw [map_add, map_add, smul_add, add_add_add_comm]
    exact add_nonneg hx hy
  | smul c x _ hx =>
    rw [← Nonneg.coe_smul]
    calc
      0 ≤ (c : R) * (ψ x + s.sup n • φ x) := mul_nonneg c.2 hx
      _ = ψ ((c : R) • x) + s.sup n • φ ((c : R) • x) := by
        simp only [map_smul, smul_eq_mul, ← mul_smul_comm, mul_add]

end

end PointedCone

namespace PointedCone.IsFaceOf

variable {K V : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  [AddCommGroup V] [Module K V] {C F : PointedCone K V}

/-- Every face of a finitely generated cone is cut out by a linear functional
nonnegative on the cone. Cones with lineality and the full face are included. -/
theorem exists_nonneg_linear_inf_ker (hF : F.IsFaceOf C) (hC : C.FG) :
    ∃ f : Module.Dual K V, (∀ x ∈ C, 0 ≤ f x) ∧
      C ⊓ PointedCone.ofSubmodule (LinearMap.ker f) = F := by
  classical
  obtain ⟨s, hs⟩ := hC
  let J := {j : s // (j : V) ∈ F}
  let a : s ⊕ J → V := Sum.elim Subtype.val (fun j => -(j.val : V))
  obtain ⟨c, f, hc, hsum, hf, hpos⟩ :=
    TauCeti.exists_nonneg_sum_smul_eq_zero_and_forall_coeff_add_dual_pos (K := K) a
  have hsC : (s : Set V) ⊆ C := by
    rw [← hs]
    exact Submodule.subset_span
  have hsumF : (∑ j : s, c (.inl j) • (j : V)) ∈ F := by
    have heq : (∑ j : s, c (.inl j) • (j : V)) =
        ∑ j : J, c (.inr j) • (j.val : V) := by
      have h := hsum
      simp only [Fintype.sum_sum_type, a, Sum.elim_inl, Sum.elim_inr, smul_neg,
        Finset.sum_neg_distrib] at h
      exact sub_eq_zero.mp (by simpa only [sub_eq_add_neg] using h)
    rw [heq]
    exact F.sum_mem fun j _ => PointedCone.smul_mem F (hc (.inr j)) j.property
  have houtside (j : s) (hj : (j : V) ∉ F) : c (.inl j) = 0 := by
    by_contra hne
    have hp : 0 < c (.inl j) := lt_of_le_of_ne (hc (.inl j)) (Ne.symm hne)
    exact hj (hF.mem_of_sum_smul_mem
      (fun k : s => hsC k.property) (fun k => hc (.inl k)) hsumF j hp)
  have hfacezero (j : s) (hj : (j : V) ∈ F) : f (j : V) = 0 := by
    have hp : 0 ≤ f (j : V) := hf (.inl j)
    have hn : 0 ≤ -f (j : V) := by
      simpa only [a, Sum.elim_inr, map_neg] using hf (.inr ⟨j, hj⟩)
    exact le_antisymm (neg_nonneg.mp hn) hp
  have hfgen : ∀ x ∈ s, 0 ≤ f x := fun x hx => hf (.inl ⟨x, hx⟩)
  have hzgen : ∀ x ∈ s, f x = 0 ↔ x ∈ F := by
    intro x hx
    constructor
    · intro hzero
      by_contra hxF
      have hp := hpos (.inl ⟨x, hx⟩)
      have hc0 := houtside ⟨x, hx⟩ hxF
      simp only [hc0, zero_add, a, Sum.elim_inl, hzero, lt_self_iff_false] at hp
    · exact hfacezero ⟨x, hx⟩
  have hfC : ∀ x ∈ C, 0 ≤ f x := by
    have hdual : f ∈ PointedCone.dual (Module.Dual.eval K V) (s : Set V) :=
      fun _ hx => hfgen _ hx
    rw [← PointedCone.dual_hull, PointedCone.hull, hs] at hdual
    exact fun _ hx => hdual hx
  exact ⟨f, hfC, PointedCone.inf_ker_eq_of_eq_hull hs.symm hF hfgen hzgen⟩

/-- The exposing functional vanishes precisely on the chosen face, among all
points of the original finitely generated cone. -/
theorem exists_nonneg_linear_zero_iff (hF : F.IsFaceOf C) (hC : C.FG) :
    ∃ f : Module.Dual K V, (∀ x ∈ C, 0 ≤ f x) ∧
      ∀ x ∈ C, f x = 0 ↔ x ∈ F := by
  obtain ⟨f, hf, heq⟩ := hF.exists_nonneg_linear_inf_ker hC
  refine ⟨f, hf, fun x hx => ?_⟩
  constructor
  · intro hzero
    rw [← heq]
    exact ⟨hx, hzero⟩
  · intro hxF
    rw [← heq] at hxF
    exact hxF.2

end PointedCone.IsFaceOf

namespace IsExposed

variable {K V : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  [TopologicalSpace K] [AddCommGroup V] [TopologicalSpace V] [Module K V]
  {C : PointedCone K V} {S : Set V}

/-- Every nonempty exposed subset of a pointed cone is the carrier of a cone face.
No finite-generation or closedness assumption is needed in this direction. -/
theorem exists_isFaceOf_coe_eq (hS : IsExposed K (C : Set V) S) (hne : S.Nonempty) :
    ∃ F : PointedCone K V, F.IsFaceOf C ∧ (F : Set V) = S := by
  obtain ⟨l, hl⟩ := hS hne
  have hzero (x : V) (hx : x ∈ S) : l x = 0 := by
    have hm : x ∈ {x ∈ C | ∀ y ∈ C, l y ≤ l x} := hl ▸ hx
    have h₀ := hm.2 0 C.zero_mem
    have h₂ := hm.2 (2 • x) (C.smul_mem (by norm_num : (0 : K) ≤ 2) hm.1)
    simp only [map_zero] at h₀
    simp only [map_smul, smul_eq_mul] at h₂
    linarith
  obtain ⟨p, hp⟩ := hne
  have hnonpos (x : V) (hx : x ∈ C) : l x ≤ 0 := by
    have hm : p ∈ {x ∈ C | ∀ y ∈ C, l y ≤ l x} := hl ▸ hp
    simpa only [hzero p hp] using hm.2 x hx
  let f : Module.Dual K V := -l.toLinearMap
  have hf : ∀ x ∈ C, 0 ≤ f x := fun x hx => neg_nonneg.mpr (hnonpos x hx)
  refine ⟨C ⊓ PointedCone.ofSubmodule (LinearMap.ker f),
    PointedCone.isFaceOf_inf_ker hf, ?_⟩
  ext x
  constructor
  · rintro ⟨hx, hfx⟩
    have hxzero : l x = 0 := neg_eq_zero.mp hfx
    rw [hl]
    exact ⟨hx, fun y hy => (hnonpos y hy).trans_eq hxzero.symm⟩
  · intro hx
    exact ⟨hS.subset hx, by simpa [f] using hzero x hx⟩

end IsExposed

namespace PointedCone.IsFaceOf

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
  {C F : PointedCone ℝ V}

/-- Every face of a finitely generated cone in a real normed space is exposed
in Mathlib's continuous-functional sense. Finite generation provides continuity
on the span of the generators, and Hahn–Banach extends the exposing functional. -/
theorem isExposed_of_fg (hF : F.IsFaceOf C) (hC : C.FG) :
    IsExposed ℝ (C : Set V) (F : Set V) := by
  intro _
  obtain ⟨f, hf, hzero⟩ := hF.exists_nonneg_linear_zero_iff hC
  obtain ⟨s, hs⟩ := hC
  let P : Submodule ℝ V := Submodule.span ℝ (s : Set V)
  have hP : P.FG := Submodule.fg_span s.finite_toSet
  let : FiniteDimensional ℝ P := (Submodule.fg_iff_finiteDimensional P).mp hP
  have hCP : C ≤ P.restrictScalars (Nonneg ℝ) := by
    rw [← hs]
    exact Submodule.span_le.mpr fun x hx => Submodule.subset_span hx
  let lP : P →L[ℝ] ℝ :=
    ⟨(-f).domRestrict P, ((-f).domRestrict P).continuous_of_finiteDimensional⟩
  obtain ⟨l, hl, _⟩ := exists_extension_norm_eq P lP
  have hlC (x : V) (hx : x ∈ C) : l x = -f x := hl ⟨x, hCP hx⟩
  refine ⟨l, ?_⟩
  ext x
  constructor
  · intro hxF
    refine ⟨hF.le hxF, fun y hy => ?_⟩
    rw [hlC y hy, hlC x (hF.le hxF), (hzero x (hF.le hxF)).mpr hxF, neg_zero]
    exact neg_nonpos.mpr (hf y hy)
  · rintro ⟨hxC, hmax⟩
    have hmaxzero := hmax 0 C.zero_mem
    have hlx : 0 ≤ -f x := by
      simpa only [map_zero, hlC x hxC] using hmaxzero
    exact (hzero x hxC).mp (le_antisymm (neg_nonneg.mp hlx) (hf x hxC))

end PointedCone.IsFaceOf
