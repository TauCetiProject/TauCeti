module

public import Mathlib.Geometry.Convex.Cone.Face.Lattice
public import Mathlib.RingTheory.Finiteness.Basic

/-!
# Face generation and finiteness of the face lattice

A face of a cone generated by a set is generated by the members of that set which it contains.
Consequently, a finitely generated pointed cone has only finitely many faces: each face is
determined by a subset of any fixed finite generating set.

## Main declarations

* `PointedCone.IsFaceOf.eq_hull_inter_of_eq_hull`: a face of the hull of a set is the hull of the
  generators lying in that face.
* `PointedCone.IsFaceOf.eq_bot_or_eq_of_hull_singleton`: a face of a singly generated cone is
  either the zero cone or the whole cone.
* `PointedCone.FG.finite_face`: the face lattice of a finitely generated pointed cone is finite.

## References

This is the elementary face description for polyhedral cones; see D. Cox, J. Little and
H. Schenck, *Toric Varieties*, Proposition 1.2.2.
-/

public section

namespace PointedCone

variable {R M : Type*} [Semiring R] [PartialOrder R] [IsOrderedRing R]
  [AddCommGroup M] [Module R M]

namespace IsFaceOf

variable {C F : PointedCone R M} {s : Set M}

/-- A face of a cone generated by a set is generated by precisely the members of the generating
set which lie in the face. -/
theorem eq_hull_inter_of_eq_hull (hF : F.IsFaceOf C) (hC : C = hull R s) :
    F = hull R (s ∩ F) := by
  subst hC
  refine le_antisymm (fun x hxF ↦ ?_) (Submodule.span_le.2 fun _ hx ↦ hx.2)
  induction hF.le hxF using Submodule.span_induction with
  | mem x hx => exact subset_hull ⟨hx, hxF⟩
  | zero => exact zero_mem _
  | add x y hx hy ihx ihy =>
    obtain ⟨hxF, hyF⟩ := (hF.add_mem_iff_mem hx hy).1 hxF
    exact add_mem (ihx hxF) (ihy hyF)
  | smul a x hx ih =>
    obtain ⟨a, ha0⟩ := a
    obtain rfl | ha := ha0.eq_or_lt
    · simp
    · exact Submodule.smul_mem _ _
        (ih (hF.mem_of_smul_add_mem hx (zero_mem _) ha (by simpa using hxF)))

/-- A face of a cone generated by one vector is either the zero cone or the whole cone. -/
theorem eq_bot_or_eq_of_hull_singleton (v : M) (hF : F.IsFaceOf (hull R {v})) :
    F = ⊥ ∨ F = hull R {v} := by
  have h := hF.eq_hull_inter_of_eq_hull rfl
  by_cases hv : v ∈ F
  · right
    simpa [hv] using h
  · left
    simpa [hv] using h

end IsFaceOf

namespace FG

variable {C : PointedCone R M}

/-- The face lattice of a finitely generated pointed cone is finite. -/
theorem finite_face (hC : C.FG) : Finite C.Face := by
  obtain ⟨s, hs⟩ := hC
  refine Finite.of_injective (fun F : C.Face ↦ ((↑) : ↥(s : Set M) → M) ⁻¹' F) fun F G h ↦ ?_
  have key (F : C.Face) : F.toPointedCone = hull R ((s : Set M) ∩ F) :=
    F.isFaceOf.eq_hull_inter_of_eq_hull hs.symm
  have hFG : F.toPointedCone = G.toPointedCone := by
    rw [key F, key G, Subtype.preimage_coe_eq_preimage_coe_iff.1 h]
  exact Face.ext (SetLike.ext_iff.1 hFG :)

end FG

end PointedCone
