/-!
# Homogenization of a set

The *homogenization* of a subset `P` of a real topological vector space `V` is the topological
closure in `V × ℝ` of the pointed cone generated by the height-one copy `P × {1}`. It is
defined from the carrier `P` alone, so it does not depend on any presentation of `P`. The
homogenization of a closed convex set is the cone over it, completed at height zero by the
directions in which the set is unbounded.

## Main declarations

* `Set.homogenization`: the closed pointed cone generated by `P × {1}`.
* `Set.homogenization_empty`: the homogenization of the empty set is the zero cone.
* `Convex.mem_homogenization_pos_iff`: for a closed convex `P` and `t > 0`, a point `(x, t)` lies
  in the homogenization iff `t⁻¹ • x ∈ P`; in particular `Convex.mem_homogenization_one_iff`
  recovers `P` as the height-one slice.
* `Convex.mem_homogenization_zero_iff`: for a nonempty closed convex `P`, the height-zero slice of
  the homogenization is the asymptotic cone of `P`.
* `Convex.mem_asymptoticCone_iff_forall_add_smul_mem`: the asymptotic cone of a closed convex set
  consists of the directions `v` for which one (equivalently, every) ray `p + t • v` with `p ∈ P`
  stays in `P`.

## Provenance

Adapted from `Mei/Geometry/Convex/Homogenization.lean` and `Mei/Geometry/Convex/Recession.lean`
in [yuma-mizuno-lean/Mei](https://github.com/yuma-mizuno-lean/Mei), commit
`3d2e9c869ee44c41ae9c7b5c6e2042898430d0ca`, licensed under Apache 2.0. The recession cone of
the source is replaced by Mathlib's `asymptoticCone`.
-/

public section

open Filter Set
open scoped Topology

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

section Asymptotic

variable [TopologicalSpace V] [IsTopologicalAddGroup V] [ContinuousSMul ℝ V] {P : Set V}

/-- If one ray in direction `v` based at `p` stays in `s`, then `v` is in the asymptotic cone
of `s`. The points `p + t • v = t • (v + t⁻¹ • p)` tend to infinity in directions tending
to `v`. -/
theorem mem_asymptoticCone_of_forall_add_smul_mem {p v : V}
    (h : ∀ t : ℝ, 0 ≤ t → p + t • v ∈ P) : v ∈ asymptoticCone ℝ P := by
  have hdir : Tendsto (fun t : ℝ => v + t⁻¹ • p) atTop (𝓝 v) := by
    simpa using tendsto_const_nhds.add ((tendsto_inv_atTop_zero (𝕜 := ℝ)).smul_const p)
  have hlim := tendsto_id.atTop_smul_nhds_tendsto_asymptoticNhds hdir
  refine hlim.frequently (((eventually_gt_atTop (0 : ℝ)).mono fun t ht => ?_).frequently)
  have hp := h t ht.le
  simpa [smul_add, smul_inv_smul₀ ht.ne', add_comm] using hp

/-- The asymptotic cone of a closed convex set `P` consists of the directions `v` such that the
ray `p + t • v`, `t ≥ 0`, stays in `P`, for any one base point `p ∈ P`. -/
theorem Convex.mem_asymptoticCone_iff_forall_add_smul_mem (hconvex : Convex ℝ P)
    (hclosed : IsClosed P) {p v : V} (hp : p ∈ P) :
    v ∈ asymptoticCone ℝ P ↔ ∀ t : ℝ, 0 ≤ t → p + t • v ∈ P :=
  ⟨fun hv t ht => by
    simpa [add_comm] using hconvex.smul_vadd_mem_of_isClosed_of_mem_asymptoticCone hclosed ht hv hp,
    mem_asymptoticCone_of_forall_add_smul_mem⟩

end Asymptotic

namespace Set

/-- A point of the cone hull of the height-one copy of a convex set is zero or a positive
multiple of a height-one point. No closure is taken in this statement. -/
theorem _root_.Convex.mem_hull_image_prodMk_one_iff {P : Set V} (hP : Convex ℝ P) {z : V × ℝ} :
    z ∈ PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P) ↔
      z = 0 ∨ ∃ t : ℝ, 0 < t ∧ ∃ p ∈ P, z = (t • p, t) := by
  constructor
  · intro hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨p, hp, rfl⟩ := hz
      exact Or.inr ⟨1, zero_lt_one, p, hp, by simp⟩
    | zero => exact Or.inl rfl
    | add z w hz hw iz iw =>
      rcases iz with rfl | ⟨t, ht, p, hp, rfl⟩
      · simpa using iw
      rcases iw with rfl | ⟨s, hs, q, hq, rfl⟩
      · exact Or.inr ⟨t, ht, p, hp, by simp⟩
      obtain ⟨r, hr, he⟩ := hP.exists_mem_add_smul_eq hp hq ht.le hs.le
      exact Or.inr ⟨t + s, add_pos ht hs, r, hr, Prod.ext he.symm rfl⟩
    | smul c z hz iz =>
      rcases iz with rfl | ⟨t, ht, p, hp, rfl⟩
      · exact Or.inl (smul_zero _)
      rcases eq_or_lt_of_le c.property with hc | hc
      · left
        simp only [← Nonneg.coe_smul, Prod.smul_mk, smul_eq_mul]
        simp [← hc]
      · right
        refine ⟨c.val * t, mul_pos hc ht, p, hp, ?_⟩
        simp only [← Nonneg.coe_smul, Prod.smul_mk, smul_eq_mul, smul_smul]
  · rintro (rfl | ⟨t, ht, p, hp, rfl⟩)
    · exact Submodule.zero_mem _
    · have hm := PointedCone.smul_mem
        (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P)) ht.le
        (PointedCone.subset_hull (Set.mem_image_of_mem _ hp))
      simpa using hm

variable [TopologicalSpace V] [IsTopologicalAddGroup V] [ContinuousSMul ℝ V]

/-- The *homogenization* of `P`: the closed pointed cone in `V × ℝ` generated by `P × {1}`. -/
def homogenization (P : Set V) : PointedCone ℝ (V × ℝ) :=
  (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P)).topologicalClosure

/-- Membership in the homogenization is membership in the closure of the cone hull of
`P × {1}`. -/
theorem mem_homogenization_iff {P : Set V} {z : V × ℝ} :
    z ∈ homogenization P ↔
      z ∈ closure (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P) : Set (V × ℝ)) :=
  (Iff.rfl)

/-- The homogenization is a closed cone. -/
theorem isClosed_homogenization (P : Set V) : IsClosed (homogenization P : Set (V × ℝ)) :=
  Submodule.isClosed_topologicalClosure _

/-- The height-one copy of `P` lies in its homogenization. -/
theorem mem_homogenization_one {P : Set V} {p : V} (hp : p ∈ P) :
    (p, (1 : ℝ)) ∈ homogenization P :=
  Submodule.le_topologicalClosure _ (PointedCone.subset_hull ⟨p, hp, rfl⟩)

/-- The homogenization is the least closed cone containing `P × {1}`: it lies in a closed cone
`C` exactly when `C` contains every height-one point over `P`. -/
theorem homogenization_le_iff {P : Set V} {C : PointedCone ℝ (V × ℝ)}
    (hC : IsClosed (C : Set (V × ℝ))) :
    homogenization P ≤ C ↔ ∀ p ∈ P, (p, (1 : ℝ)) ∈ C := by
  refine ⟨fun h p hp => h (mem_homogenization_one hp), fun h => ?_⟩
  apply Submodule.topologicalClosure_minimal _ _ hC
  apply Submodule.span_le.mpr
  rintro _ ⟨p, hp, rfl⟩
  exact h p hp

/-- The homogenization is monotone in the base set. -/
theorem homogenization_mono {P Q : Set V} (h : P ⊆ Q) :
    homogenization P ≤ homogenization Q :=
  Submodule.topologicalClosure_mono (Submodule.span_mono (Set.image_mono h))

/-- The homogenization of the empty set is the zero cone. -/
@[simp]
theorem homogenization_empty [T2Space V] : homogenization (∅ : Set V) = ⊥ := by
  apply SetLike.ext'
  simp [homogenization, Submodule.topologicalClosure_coe]

/-- The homogenization has no points of negative height. -/
theorem homogenization_snd_nonneg {P : Set V} {z : V × ℝ} (hz : z ∈ homogenization P) :
    0 ≤ z.2 := by
  have hle : homogenization P ≤ (PointedCone.positive ℝ ℝ).comap (LinearMap.snd ℝ V ℝ) :=
    (homogenization_le_iff (isClosed_le continuous_const continuous_snd)).mpr fun _ _ =>
      zero_le_one
  exact hle hz

/-- **The cone over a closed convex set.** For a closed convex `P` and a positive height `t`, the
point `(x, t)` lies in the homogenization of `P` iff `t⁻¹ • x ∈ P`. -/
theorem _root_.Convex.mem_homogenization_pos_iff {P : Set V} (hconvex : Convex ℝ P)
    (hclosed : IsClosed P) {x : V} {t : ℝ} (ht : 0 < t) :
    (x, t) ∈ homogenization P ↔ t⁻¹ • x ∈ P := by
  constructor
  · intro hz
    rw [mem_homogenization_iff] at hz
    have := mem_closure_iff_nhdsWithin_neBot.mp hz
    have hsnd : Tendsto (fun z : V × ℝ => z.2)
        (𝓝[PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P)] (x, t)) (𝓝 t) :=
      (continuous_snd.tendsto (x, t)).mono_left nhdsWithin_le_nhds
    have hfst : Tendsto (fun z : V × ℝ => z.1)
        (𝓝[PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P)] (x, t)) (𝓝 x) :=
      (continuous_fst.tendsto (x, t)).mono_left nhdsWithin_le_nhds
    have hpos := hsnd.eventually (lt_mem_nhds ht)
    apply hclosed.mem_of_tendsto ((hsnd.inv₀ ht.ne').smul hfst)
    filter_upwards [self_mem_nhdsWithin, hpos] with z hz hk
    rcases (hconvex.mem_hull_image_prodMk_one_iff).mp hz with he | ⟨s, hs, p, hp, he⟩
    · simp [he] at hk
    · simp only [he, inv_smul_smul₀ hs.ne']
      exact hp
  · intro hx
    have hm := PointedCone.smul_mem (homogenization P) ht.le (mem_homogenization_one hx)
    convert hm using 1
    simp [ht.ne']

/-- The height-one slice of the homogenization of a closed convex set is the set itself. -/
@[simp]
theorem _root_.Convex.mem_homogenization_one_iff {P : Set V} (hconvex : Convex ℝ P)
    (hclosed : IsClosed P) {x : V} :
    (x, (1 : ℝ)) ∈ homogenization P ↔ x ∈ P := by
  simpa using hconvex.mem_homogenization_pos_iff hclosed (x := x) zero_lt_one

/-- Over a nonempty set, every direction of its asymptotic cone occurs at height zero in the
homogenization. The approximants are `(v + ε • p, ε) = ε • (p + ε⁻¹ • v, 1)` for `ε > 0`. -/
theorem mem_homogenization_zero_of_mem_asymptoticCone {P : Set V}
    (hconvex : Convex ℝ P) (hclosed : IsClosed P) {p : V} (hp : p ∈ P) {v : V}
    (hv : v ∈ asymptoticCone ℝ P) : (v, (0 : ℝ)) ∈ homogenization P := by
  have hlim : Tendsto (fun ε : ℝ => (v + ε • p, ε)) (𝓝[>] 0) (𝓝 (v, (0 : ℝ))) := by
    have hf : Continuous (fun ε : ℝ => (v + ε • p, ε)) :=
      (continuous_const.add (continuous_id.smul continuous_const)).prodMk continuous_id
    simpa only [zero_smul, add_zero] using (hf.tendsto 0).mono_left nhdsWithin_le_nhds
  refine (isClosed_homogenization P).mem_of_tendsto hlim ?_
  filter_upwards [self_mem_nhdsWithin] with ε (hε : 0 < ε)
  have hpv : p + ε⁻¹ • v ∈ P := by
    simpa [add_comm] using hconvex.smul_vadd_mem_of_isClosed_of_mem_asymptoticCone hclosed
      (inv_nonneg.mpr hε.le) hv hp
  have hm := PointedCone.smul_mem (homogenization P) hε.le
    (mem_homogenization_one hpv)
  have he : (v + ε • p, ε) = ε • (p + ε⁻¹ • v, (1 : ℝ)) := by
    ext
    · simp only [Prod.smul_mk, smul_add, smul_inv_smul₀ hε.ne', add_comm]
    · simp
  rwa [he]

/-- A direction at height zero in the homogenization of a closed convex set keeps every ray based
in the set inside the set. -/
theorem _root_.Convex.add_smul_mem_of_mem_homogenization_zero {P : Set V}
    (hconvex : Convex ℝ P) (hclosed : IsClosed P) {v : V}
    (hv : (v, (0 : ℝ)) ∈ homogenization P) {p : V} (hp : p ∈ P) {t : ℝ} (ht : 0 ≤ t) :
    p + t • v ∈ P := by
  apply (hconvex.mem_homogenization_one_iff hclosed).mp
  simpa using (homogenization P).add_mem (mem_homogenization_one hp)
    (PointedCone.smul_mem (homogenization P) ht hv)

/-- **The height-zero slice of the homogenization.** For a nonempty closed convex set `P`, the
point `(v, 0)` lies in the homogenization iff `v` lies in the asymptotic cone of `P`, i.e. iff `P`
is unbounded in the direction `v`. -/
theorem _root_.Convex.mem_homogenization_zero_iff {P : Set V}
    (hconvex : Convex ℝ P) (hne : P.Nonempty) (hclosed : IsClosed P) {v : V} :
    (v, (0 : ℝ)) ∈ homogenization P ↔ v ∈ asymptoticCone ℝ P := by
  obtain ⟨p, hp⟩ := hne
  exact ⟨fun hv => mem_asymptoticCone_of_forall_add_smul_mem fun _ ht =>
      hconvex.add_smul_mem_of_mem_homogenization_zero hclosed hv hp ht,
    mem_homogenization_zero_of_mem_asymptoticCone hconvex hclosed hp⟩

end Set
