module

public import Mathlib.Geometry.Convex.Cone.Pointed
public import Mathlib.LinearAlgebra.Basis.Defs

/-!
# The cone generated by a basis

The pointed cone generated by a basis consists exactly of the vectors with nonnegative basis
coordinates. The index type need not be finite: each vector has finitely supported coordinates.
-/

public section

namespace Module.Basis

/-- A vector belongs to the cone generated by a basis if and only if all its basis coordinates
are nonnegative. -/
theorem mem_pointedCone_hull_range_iff {ι R M : Type*}
    [Semiring R] [PartialOrder R] [IsOrderedRing R] [AddCommMonoid M] [Module R M]
    (b : Basis ι R M) (v : M) :
    v ∈ PointedCone.hull R (Set.range b) ↔ ∀ j, 0 ≤ b.repr v j := by
  classical
  constructor
  · intro hv j
    induction hv using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨k, rfl⟩ := hw
      simp only [Module.Basis.repr_self_apply]
      split <;> simp
    | zero => simp
    | add w z _ _ hw hz => simpa using add_nonneg hw hz
    | smul a w _ hw =>
      simpa only [← Nonneg.coe_smul, map_smul, Finsupp.smul_apply, smul_eq_mul] using
        mul_nonneg a.2 hw
  · intro hv
    rw [← b.linearCombination_repr v, Finsupp.linearCombination_apply, Finsupp.sum]
    apply Submodule.sum_mem
    intro j _
    exact PointedCone.smul_mem _ (hv j) (PointedCone.subset_hull (Set.mem_range_self j))

end Module.Basis
