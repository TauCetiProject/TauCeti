/-!
# Lattice points of cones

The inverse image of a cone under an additive map is an additive monoid of lattice
points. Membership is unchanged by multiplication by a positive integer, so the lattice points of
any cone over a strictly ordered field form an `NSMulSaturated` submonoid. In particular, when a
positive multiple of a primitive vector lies in the cone, the primitive vector itself lies in the
cone. These statements require neither rationality nor salience, and the additive map need not be
injective. The monoid construction allows ordered semirings; the positive-multiple characterizations
use an ordered field.

When the cone is the rational cone generated by the image of an additive submonoid `s` under an
injective additive map `i` into a `ℚ`-module, clearing denominators in nonnegative rational linear
combinations identifies the lattice points of `PointedCone.hull ℚ (i '' s)` with the
positive-multiple saturation `s.nsmulSaturation` (`PointedCone.latticePoints_hull_rat_image`).
Restricting `i` to the subgroup generated by `s` identifies the lattice points in that subgroup with
the saturation of `s` inside its generated lattice.

## References

* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Chapter 2, rational cones and
  normal affine monoids.
* W. Fulton, *Introduction to Toric Varieties*, §1.2.

Adapted from `Mei/Geometry/Convex/Cone/LatticePoints.lean` in
[yuma-mizuno-lean/Mei](https://github.com/yuma-mizuno-lean/Mei), commit
`3d2e9c869ee44c41ae9c7b5c6e2042898430d0ca` (Apache 2.0).
-/

public section

namespace PointedCone

variable {R N V : Type*} [Semiring R] [PartialOrder R] [IsOrderedRing R]
  [AddCommMonoid N] [AddCommMonoid V] [Module R V]

/-- The additive monoid of vectors whose images under `i` belong to `σ`. -/
def latticePoints (σ : PointedCone R V) (i : N →+ V) : AddSubmonoid N :=
  σ.toAddSubmonoid.comap i

/-- The lattice-point monoid is the inverse image of the cone's additive monoid. -/
theorem latticePoints_def (σ : PointedCone R V) (i : N →+ V) :
    σ.latticePoints i = σ.toAddSubmonoid.comap i := (rfl)

/-- A vector is a lattice point of a cone exactly when its image belongs to the cone. -/
@[simp]
theorem mem_latticePoints {σ : PointedCone R V} {i : N →+ V} {n : N} :
    n ∈ σ.latticePoints i ↔ i n ∈ σ := Iff.rfl

/-- Enlarging the cone enlarges its lattice-point monoid. -/
@[gcongr]
theorem latticePoints_mono {σ τ : PointedCone R V} (h : σ ≤ τ) (i : N →+ V) :
    σ.latticePoints i ≤ τ.latticePoints i := fun _ hn ↦ h hn

/-- The lattice-point monoid is monotone in the cone. -/
theorem latticePoints_monotone (i : N →+ V) :
    Monotone (fun σ : PointedCone R V => σ.latticePoints i) := fun _ _ h ↦ latticePoints_mono h i

/-- Lattice points commute with intersection of cones. -/
@[simp]
theorem latticePoints_inf (σ τ : PointedCone R V) (i : N →+ V) :
    (σ ⊓ τ).latticePoints i = σ.latticePoints i ⊓ τ.latticePoints i := by
  ext n
  simp

/-- Every additive submonoid is contained in the lattice points of the cone generated by its
image. -/
theorem le_latticePoints_hull_image (s : AddSubmonoid N) (i : N →+ V) :
    s ≤ (PointedCone.hull R (i '' (s : Set N))).latticePoints i :=
  fun _ hx ↦ PointedCone.subset_hull (Set.mem_image_of_mem i hx)

/-- Passing from a generating set to its additive submonoid closure does not change the generated
cone. -/
@[simp]
theorem hull_image_closure (R : Type*) [Semiring R] [PartialOrder R] [IsOrderedRing R]
    {V : Type*} [AddCommMonoid V] [Module R V] (i : N →+ V) (t : Set N) :
    PointedCone.hull R (i '' (AddSubmonoid.closure t : Set N)) = PointedCone.hull R (i '' t) := by
  refine le_antisymm ?_ (Submodule.span_mono (Set.image_mono AddSubmonoid.subset_closure))
  rw [Submodule.span_le]
  rintro _ ⟨x, hx, rfl⟩
  exact (AddSubmonoid.closure_le (s := t)
    (S := (PointedCone.hull R (i '' t)).latticePoints i)).mpr
      (fun y hy ↦ PointedCone.subset_hull (Set.mem_image_of_mem i hy)) hx

variable {K W : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  [AddCommMonoid W] [Module K W]

/-- A positive natural multiple belongs to the lattice-point monoid exactly when
the original vector does. -/
theorem nsmul_mem_latticePoints_iff (σ : PointedCone K W) (i : N →+ W)
    {a : ℕ} (ha : 0 < a) (n : N) :
    a • n ∈ σ.latticePoints i ↔ n ∈ σ.latticePoints i := by
  simp only [mem_latticePoints, map_nsmul, ← Nat.cast_smul_eq_nsmul K]
  exact σ.smul_mem_iff (by exact_mod_cast ha)

/-- A positive integer multiple belongs to the lattice-point monoid exactly when
the original vector does. -/
theorem zsmul_mem_latticePoints_iff {G U : Type*} [AddCommGroup G]
    [AddCommGroup U] [Module K U]
    (σ : PointedCone K U) (i : G →+ U) {a : ℤ} (ha : 0 < a) (n : G) :
    a • n ∈ σ.latticePoints i ↔ n ∈ σ.latticePoints i := by
  simp only [mem_latticePoints, map_zsmul, ← Int.cast_smul_eq_zsmul K]
  exact σ.smul_mem_iff (by exact_mod_cast ha)

/-- The lattice points of a cone over a strictly ordered field form an `NSMulSaturated` additive
submonoid. -/
theorem nsmulSaturated_latticePoints (σ : PointedCone K W) (i : N →+ W) :
    (σ.latticePoints i).NSMulSaturated := by
  intro a n han
  by_cases ha : a = 0
  · exact .inl ha
  · exact .inr ((σ.nsmul_mem_latticePoints_iff i (Nat.pos_of_ne_zero ha) n).mp han)

/-- Over a strictly ordered field, the saturation of `s` is contained in the lattice points of the
cone generated by `i '' s`. -/
theorem nsmulSaturation_le_latticePoints_hull_image (s : AddSubmonoid N) (i : N →+ W) :
    s.nsmulSaturation ≤ (PointedCone.hull K (i '' (s : Set N))).latticePoints i :=
  (AddSubmonoid.nsmulSaturation_le_iff_le (nsmulSaturated_latticePoints _ i)).mpr
    (le_latticePoints_hull_image s i)

section Rational

/-- **Integral points of the rational cone equal the saturation.** For an injective additive map
`i : N →+ U` into a `ℚ`-module `U`, the lattice points of the rational cone generated by `i '' s`
are exactly the positive-multiple saturation `s.nsmulSaturation`. -/
theorem latticePoints_hull_rat_image {U : Type*} [AddCommMonoid U] [Module ℚ U] {i : N →+ U}
    (hi : Function.Injective i) (s : AddSubmonoid N) :
    (PointedCone.hull ℚ (i '' (s : Set N))).latticePoints i = s.nsmulSaturation := by
  refine le_antisymm ?_ (nsmulSaturation_le_latticePoints_hull_image s i)
  intro x hx
  obtain ⟨c, hc_supp, hc_nonneg, hc_sum⟩ := PointedCone.mem_hull_set.mp hx
  -- Clear all denominators in the rational conical combination simultaneously.
  let d : ℕ := ∏ y ∈ c.support, (c y).den
  have hd : 0 < d := Finset.prod_pos fun y _ ↦ (c y).den_pos
  choose a ha_mem ha_eq using fun y : c.support ↦ hc_supp y.2
  choose m hm using fun y : c.support ↦ Finset.dvd_prod_of_mem (fun z ↦ (c z).den) y.2
  let k : c.support → ℕ := fun y ↦ m y * (c y.1).num.toNat
  have hk (y : c.support) : ((k y : ℕ) : ℚ) = (d : ℚ) * c y.1 := by
    have hnum : (((c y.1).num.toNat : ℕ) : ℚ) = (c y.1).num := by
      exact_mod_cast Int.toNat_of_nonneg (Rat.num_nonneg.mpr (hc_nonneg y.1))
    have hden : ((c y.1).den : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (c y.1).den_ne_zero
    have hd_eq : (d : ℚ) = (c y.1).den * m y := by exact_mod_cast hm y
    conv_rhs => rw [← (c y.1).num_div_den, hd_eq]
    rw [Nat.cast_mul, hnum]
    field_simp [hden]
  refine AddSubmonoid.mem_nsmulSaturation.mpr ⟨d, hd, ?_⟩
  have hsum_eq : d • x = ∑ y ∈ c.support.attach, k y • a y := hi <| by
    rw [map_nsmul, ← hc_sum, Finsupp.sum, ← Nat.cast_smul_eq_nsmul ℚ, Finset.smul_sum,
      ← Finset.sum_attach c.support (fun y ↦ (d : ℚ) • c y • y), map_sum]
    refine Finset.sum_congr rfl fun y _ ↦ ?_
    rw [map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ, hk y, ha_eq y, smul_smul]
  rw [hsum_eq]
  exact sum_mem fun y _ ↦ nsmul_mem (ha_mem y) _

/-- For an injective additive map `i : N →+ U` into a `ℚ`-module, the lattice points of the
rational cone generated by `i '' t` equal the saturation of `AddSubmonoid.closure t`. -/
theorem latticePoints_hull_rat_image_set {U : Type*} [AddCommMonoid U] [Module ℚ U] {i : N →+ U}
    (hi : Function.Injective i) (t : Set N) :
    (PointedCone.hull ℚ (i '' t)).latticePoints i = (AddSubmonoid.closure t).nsmulSaturation := by
  rw [← hull_image_closure ℚ i t, latticePoints_hull_rat_image hi]

/-- Restricting an injective rational embedding `i : G →+ U` to the subgroup `L_S` generated by `S`
identifies the lattice points of the rational cone inside `L_S` with the saturation of `S` inside
`L_S`. -/
theorem latticePoints_hull_rat_image_comp_groupClosure {G U : Type*} [AddCommGroup G]
    [AddCommMonoid U] [Module ℚ U] {i : G →+ U} (hi : Function.Injective i)
    (S : AddSubmonoid G) :
    (PointedCone.hull ℚ (i '' (S : Set G))).latticePoints
        (i.comp (AddSubgroup.closure (S : Set G)).subtype) =
      (S.comap (AddSubgroup.closure (S : Set G)).subtype).nsmulSaturation := by
  have himg : (i.comp (AddSubgroup.closure (S : Set G)).subtype) ''
      ((S.comap (AddSubgroup.closure (S : Set G)).subtype : AddSubmonoid _) : Set _) =
      i '' (S : Set G) := by
    ext u
    simp only [Set.mem_image, AddMonoidHom.coe_comp, Function.comp_apply, SetLike.mem_coe,
      AddSubmonoid.mem_comap, AddSubgroup.coe_subtype, Subtype.exists]
    exact ⟨fun ⟨g, _, hgS, hgu⟩ ↦ ⟨g, hgS, hgu⟩,
      fun ⟨g, hgS, hgu⟩ ↦ ⟨g, AddSubgroup.subset_closure hgS, hgS, hgu⟩⟩
  have hinj : Function.Injective (i.comp (AddSubgroup.closure (S : Set G)).subtype) := by
    rw [AddMonoidHom.coe_comp]
    exact hi.comp (AddSubgroup.closure (S : Set G)).subtype_injective
  rw [← himg]
  exact latticePoints_hull_rat_image hinj _

/-- In the canonical rational vector space `DivisibleHull G` of a torsion-free abelian group `G`,
the lattice points of the rational cone generated by `S` equal `S.nsmulSaturation`. -/
theorem latticePoints_hull_rat_divisibleHull {G : Type*} [AddCommGroup G] [HasUniqueDiv G]
    (S : AddSubmonoid G) :
    (PointedCone.hull ℚ (DivisibleHull.coeAddMonoidHom G '' (S : Set G))).latticePoints
        (DivisibleHull.coeAddMonoidHom G) =
      S.nsmulSaturation :=
  latticePoints_hull_rat_image DivisibleHull.coe_injective S

end Rational

end PointedCone
