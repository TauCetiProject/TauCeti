module

public import Mathlib.Algebra.Order.Field.Rat
public import Mathlib.Geometry.Convex.Cone.Pointed
public import TauCeti.Algebra.Group.Submonoid.NSMulSaturation
import Mathlib.Data.Rat.Lemmas

/-!
# Lattice points of cones

The inverse image of a cone under an additive map is an additive monoid of lattice
points. Membership is unchanged by multiplication by a positive integer. In
particular, when a positive multiple of a primitive vector lies in the cone,
the primitive vector itself lies in the cone. These statements require neither
rationality nor salience, and the additive map need not be injective.
The monoid construction allows ordered semirings; the positive-multiple
characterizations use an ordered field.

Consequently, over any linearly ordered field, `σ.latticePoints i` is saturated under positive
natural multiples (`PointedCone.latticePoints_nsmulSaturated`). Over `ℚ`, when `i` is injective,
clearing denominators identifies the lattice points of the rational cone generated by `i '' S`
with `S.nsmulSaturation` (`PointedCone.latticePoints_hull_rat_image`).

Adapted from `Mei/Geometry/Convex/Cone/LatticePoints.lean` in
[yuma-mizuno-lean/Mei](https://github.com/yuma-mizuno-lean/Mei), commit
`3d2e9c869ee44c41ae9c7b5c6e2042898430d0ca` (Apache 2.0).
-/

public section

namespace PointedCone

variable {R N V : Type*} [Semiring R] [PartialOrder R] [IsOrderedRing R]
  [AddCommMonoid N] [AddCommMonoid V] [Module R V]

/-- The additive monoid of vectors whose images under `i` belong to `σ`. -/
def latticePoints (σ : PointedCone R V) (i : N →+ V) : AddSubmonoid N :=
  σ.toAddSubmonoid.comap i

/-- The lattice-point monoid is the inverse image of the cone's additive monoid. -/
theorem latticePoints_def (σ : PointedCone R V) (i : N →+ V) :
    σ.latticePoints i = σ.toAddSubmonoid.comap i := (rfl)

/-- A vector is a lattice point of a cone exactly when its image belongs to the cone. -/
@[simp]
theorem mem_latticePoints {σ : PointedCone R V} {i : N →+ V} {n : N} :
    n ∈ σ.latticePoints i ↔ i n ∈ σ := Iff.rfl

/-- Enlarging the cone enlarges its lattice-point monoid. -/
@[gcongr]
theorem latticePoints_mono {σ τ : PointedCone R V} (h : σ ≤ τ) (i : N →+ V) :
    σ.latticePoints i ≤ τ.latticePoints i := fun _ hn ↦ h hn

/-- The lattice-point monoid is monotone in the cone. -/
theorem latticePoints_monotone (i : N →+ V) :
    Monotone (fun σ : PointedCone R V => σ.latticePoints i) := fun _ _ h ↦ latticePoints_mono h i

/-- Lattice points commute with intersection of cones. -/
@[simp]
theorem latticePoints_inf (σ τ : PointedCone R V) (i : N →+ V) :
    (σ ⊓ τ).latticePoints i = σ.latticePoints i ⊓ τ.latticePoints i := by
  ext n
  simp

/-- The cone hull of the image of `AddSubmonoid.closure s` agrees with that of `i '' s`. -/
@[simp]
theorem hull_image_coe_addSubmonoid_closure (i : N →+ V) (s : Set N) :
    hull R (i '' (AddSubmonoid.closure s : Set N)) = hull R (i '' s) := by
  rw [← AddSubmonoid.coe_map, AddMonoidHom.map_mclosure]
  exact Submodule.span_closure

variable {K W : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  [AddCommMonoid W] [Module K W]

/-- A positive natural multiple belongs to the lattice-point monoid exactly when
the original vector does. -/
theorem nsmul_mem_latticePoints_iff (σ : PointedCone K W) (i : N →+ W)
    {a : ℕ} (ha : 0 < a) (n : N) :
    a • n ∈ σ.latticePoints i ↔ n ∈ σ.latticePoints i := by
  simp only [mem_latticePoints, map_nsmul, ← Nat.cast_smul_eq_nsmul K]
  exact σ.smul_mem_iff (by exact_mod_cast ha)

/-- Over a linearly ordered field, the lattice-point monoid of any pointed cone is saturated under
positive natural multiples. -/
theorem latticePoints_nsmulSaturated (σ : PointedCone K W) (i : N →+ W) :
    (σ.latticePoints i).NSMulSaturated := fun _ n han ↦
  or_iff_not_imp_left.mpr fun ha ↦
    (σ.nsmul_mem_latticePoints_iff i (Nat.pos_of_ne_zero ha) n).mp han

/-- Every element in the saturation of `S` maps into the cone hull of `i '' S`. -/
theorem nsmulSaturation_le_latticePoints_hull_image (i : N →+ W) (S : AddSubmonoid N) :
    S.nsmulSaturation ≤ (hull K (i '' (S : Set N))).latticePoints i :=
  (AddSubmonoid.nsmulSaturation_le_iff_le (latticePoints_nsmulSaturated _ i)).mpr
    fun _ hx ↦ subset_hull (Set.mem_image_of_mem i hx)

/-- Clearing denominators identifies the lattice points of the rational cone generated by `i '' S`
with the positive-multiple saturation of `S`, whenever `i` is injective. -/
theorem latticePoints_hull_rat_image {Q : Type*} [AddCommMonoid Q] [Module ℚ Q]
    {i : N →+ Q} (hi : Function.Injective i) (S : AddSubmonoid N) :
    (hull ℚ (i '' (S : Set N))).latticePoints i = S.nsmulSaturation := by
  refine le_antisymm (fun n hn ↦ ?_) (nsmulSaturation_le_latticePoints_hull_image i S)
  obtain ⟨c, hc_supp, hc₀, hc_sum⟩ := mem_hull_set.mp hn
  choose s hs_mem hs_eq using fun y : c.support ↦ hc_supp y.2
  let D : ℕ := ∏ y : c.support, (c y.1).den
  have hD_pos : 0 < D :=
    Nat.pos_of_ne_zero (Finset.prod_ne_zero_iff.mpr fun y _ ↦ (c y.1).den_ne_zero)
  let k : c.support → ℕ := fun y ↦ (c y.1).num.toNat * (D / (c y.1).den)
  have hk (y : c.support) : (k y : ℚ) = (D : ℚ) * c y.1 := by
    have hdvd : (c y.1).den ∣ D :=
      Finset.dvd_prod_of_mem (fun z : c.support ↦ (c z.1).den) (Finset.mem_univ y)
    have hnum : ((c y.1).num.toNat : ℤ) = (c y.1).num :=
      Int.toNat_of_nonneg (Rat.num_nonneg.mpr (hc₀ y.1))
    have hden : ((c y.1).den : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (c y.1).den_ne_zero
    calc
      (k y : ℚ) = ((c y.1).num.toNat : ℤ) * (D / (c y.1).den : ℕ) := by
          dsimp only [k]; push_cast; rfl
      _ = ((c y.1).num : ℚ) * (D / (c y.1).den : ℕ) := by rw [hnum]
      _ = (((c y.1).den * (D / (c y.1).den) : ℕ) : ℚ) * (((c y.1).num : ℚ) / (c y.1).den) := by
          push_cast
          field_simp [hden]
      _ = (D : ℚ) * c y.1 := by rw [Nat.mul_div_cancel' hdvd, (c y.1).num_div_den]
  refine AddSubmonoid.mem_nsmulSaturation.mpr ⟨D, hD_pos, ?_⟩
  have hsum : i (D • n) = i (∑ y : c.support, k y • s y) := by
    rw [map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ, ← hc_sum, Finsupp.sum, Finset.smul_sum,
      ← Finset.sum_coe_sort c.support (fun y ↦ (D : ℚ) • c y • y), map_sum]
    refine Finset.sum_congr rfl fun y _ ↦ ?_
    rw [smul_smul, ← hk y, Nat.cast_smul_eq_nsmul, ← hs_eq y, map_nsmul]
  rw [hi hsum]
  exact S.sum_mem fun y _ ↦ nsmul_mem (hs_mem y) _

/-- A positive integer multiple belongs to the lattice-point monoid exactly when
the original vector does. -/
theorem zsmul_mem_latticePoints_iff {G U : Type*} [AddCommGroup G]
    [AddCommGroup U] [Module K U]
    (σ : PointedCone K U) (i : G →+ U) {a : ℤ} (ha : 0 < a) (n : G) :
    a • n ∈ σ.latticePoints i ↔ n ∈ σ.latticePoints i := by
  simp only [mem_latticePoints, map_zsmul, ← Int.cast_smul_eq_zsmul K]
  exact σ.smul_mem_iff (by exact_mod_cast ha)

end PointedCone
