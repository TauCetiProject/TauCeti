/-!
# Rational cones, linear separation, and Gordan's lemma for submonoid saturations

For an additive submonoid `S` mapped injectively into a `ℚ`-vector space `V` along `i : M →+ V`,
the positive-multiple saturation `S.nsmulSaturation` coincides with the lattice points of the
pointed rational cone generated by `i '' S`. Specializing `V` to `DivisibleHull` realizes this cone
intrinsically both in an ambient torsion-free abelian group `G` and in the subgroup
`AddSubgroup.closure (S : Set G)` generated by `S`, without enlarging the lattice.

When `S` is finitely generated in a finite-rank torsion-free abelian group `L`, two further
finiteness and duality properties hold:
* **Integral linear separation**: an element `x : L` belongs to `S.nsmulSaturation` if and only if
  every additive functional `m : L →+ ℤ` that is nonnegative on `S` is also nonnegative at `x`.
  This follows from Tucker's theorem over the integers (`TauCeti.Geometry.Convex.Cone.Alternative`).
* **Bounded shifts and Gordan's lemma**: Euclidean division of natural generator coefficients bounds
  representatives of `S.nsmulSaturation` modulo `S` inside a finite coordinate box, yielding a
  finite set `F ⊆ S.nsmulSaturation` with `S.nsmulSaturation = F + S`. Consequently
  `S.nsmulSaturation` is finitely generated, and for any finitely generated submonoid `S` of an
  arbitrary torsion-free abelian group `G`, its saturation inside `AddSubgroup.closure (S : Set G)`
  is finitely generated.

## Main results

* `PointedCone.comap_hull_rat_image_eq_nsmulSaturation`: the preimage of
  `PointedCone.hull ℚ (i '' S)` along an injective homomorphism `i : M →+ V` is
  `S.nsmulSaturation`.
* `PointedCone.comap_hull_rat_divisibleHull_groupClosure_eq`: saturation of `S` inside
  `AddSubgroup.closure (S : Set G)` equals the integral points of its rational cone in
  `DivisibleHull (AddSubgroup.closure (S : Set G))`.
* `AddSubmonoid.FG.mem_nsmulSaturation_iff_forall_nonneg`: integral linear-form characterization of
  `S.nsmulSaturation`.
* `AddSubmonoid.FG.exists_finset_subset_nsmulSaturation_add`: `S.nsmulSaturation` is covered by
  finitely many shifts of `S`.
* `AddSubmonoid.FG.nsmulSaturation` and `AddSubmonoid.FG.nsmulSaturation_inf_closure`: Gordan's
  finiteness theorem for the saturation of a finitely generated submonoid.

## References

* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Chapter 2, affine monoids and
  Gordan's lemma.
* W. Fulton, *Introduction to Toric Varieties*, §1.2, Proposition 1.
* D. Cox, J. Little and H. Schenck, *Toric Varieties*, §1.2, Proposition 1.2.17.
-/

public section

namespace PointedCone

section RationalHull

variable {M V : Type*} [AddCommMonoid M] [AddCommMonoid V] [Module ℚ V]

private theorem image_closure_subset_hull_rat (i : M →+ V) (s : Set M) :
    ∀ {y : M}, y ∈ AddSubmonoid.closure s → i y ∈ hull ℚ (i '' s) := by
  intro y hy
  induction hy using AddSubmonoid.closure_induction with
  | mem z hz => exact subset_hull ⟨z, hz, rfl⟩
  | zero => simp
  | add z₁ z₂ _ _ ih₁ ih₂ =>
    rw [map_add]
    exact add_mem ih₁ ih₂

private theorem exists_pos_nsmul_eq_image_of_mem_hull_rat (i : M →+ V) (s : Set M) {v : V}
    (hv : v ∈ hull ℚ (i '' s)) :
    ∃ n : ℕ, 0 < n ∧ ∃ y ∈ AddSubmonoid.closure s, n • v = i y := by
  induction hv using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨y, hy, rfl⟩ := hw
    exact ⟨1, Nat.one_pos, y, AddSubmonoid.subset_closure hy, one_nsmul _⟩
  | zero => exact ⟨1, Nat.one_pos, 0, zero_mem _, by simp⟩
  | add v₁ v₂ _ _ ih₁ ih₂ =>
    obtain ⟨n₁, hn₁, y₁, hy₁, h₁⟩ := ih₁
    obtain ⟨n₂, hn₂, y₂, hy₂, h₂⟩ := ih₂
    refine ⟨n₁ * n₂, Nat.mul_pos hn₁ hn₂, n₂ • y₁ + n₁ • y₂,
      add_mem (nsmul_mem hy₁ _) (nsmul_mem hy₂ _), ?_⟩
    rw [nsmul_add, mul_comm n₁ n₂, mul_smul, h₁, mul_comm n₂ n₁, mul_smul, h₂,
      map_add, map_nsmul, map_nsmul]
  | smul q w _ ih =>
    obtain ⟨n, hn, y, hy, h⟩ := ih
    let d : ℕ := q.1.den
    let a : ℕ := q.1.num.toNat
    have ha : (a : ℚ) = q.1.num := by
      exact_mod_cast Int.toNat_of_nonneg (Rat.num_nonneg.mpr q.2)
    have hden : (d : ℚ) * q.1 = (a : ℚ) := by
      rw [mul_comm, ha]
      exact q.1.mul_den_eq_num
    refine ⟨n * d, Nat.mul_pos hn q.1.den_pos, a • y, nsmul_mem hy _, ?_⟩
    have hqw : q • w = q.1 • w := rfl
    rw [hqw, mul_smul, ← Nat.cast_smul_eq_nsmul ℚ d, smul_smul, hden,
      Nat.cast_smul_eq_nsmul ℚ a, smul_comm n a w, h, map_nsmul]

/-- Along an injective homomorphism `i : M →+ V` into a `ℚ`-module, an element `x : M` maps into
the rational cone hull of `i '' s` if and only if it belongs to the saturation of
`AddSubmonoid.closure s`. -/
theorem mem_hull_rat_image_iff_mem_nsmulSaturation_closure {i : M →+ V}
    (hi : Function.Injective i) (s : Set M) {x : M} :
    i x ∈ hull ℚ (i '' s) ↔ x ∈ (AddSubmonoid.closure s).nsmulSaturation := by
  refine ⟨fun hx => ?_, fun hx => ?_⟩
  · obtain ⟨n, hn, y, hy, hnx⟩ := exists_pos_nsmul_eq_image_of_mem_hull_rat i s hx
    rw [← map_nsmul] at hnx
    exact AddSubmonoid.mem_nsmulSaturation.mpr ⟨n, hn, hi hnx ▸ hy⟩
  · obtain ⟨n, hn, hnx⟩ := AddSubmonoid.mem_nsmulSaturation.mp hx
    have hmem : i (n • x) ∈ hull ℚ (i '' s) := image_closure_subset_hull_rat i s hnx
    let c : {r : ℚ // 0 ≤ r} := ⟨(n : ℚ)⁻¹, by positivity⟩
    have hsmul : c • i (n • x) = i x := by
      have hc : c • i (n • x) = (n : ℚ)⁻¹ • i (n • x) := rfl
      rw [hc, map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ n, smul_smul,
        inv_mul_cancel₀ (Nat.cast_ne_zero.mpr hn.ne'), one_smul]
    exact hsmul ▸ Submodule.smul_mem _ c hmem

/-- Along an injective homomorphism `i : M →+ V` into a `ℚ`-module, `i x` belongs to the rational
cone generated by `i '' S` if and only if `x` lies in `S.nsmulSaturation`. -/
theorem mem_hull_rat_image_iff_mem_nsmulSaturation {i : M →+ V} (hi : Function.Injective i)
    (S : AddSubmonoid M) {x : M} :
    i x ∈ hull ℚ (i '' (S : Set M)) ↔ x ∈ S.nsmulSaturation := by
  simpa [S.closure_eq] using mem_hull_rat_image_iff_mem_nsmulSaturation_closure hi (S : Set M)

/-- The integral points of the rational cone generated by `i '' S` along an injective homomorphism
`i : M →+ V` form the saturation `S.nsmulSaturation`. -/
theorem comap_hull_rat_image_eq_nsmulSaturation {i : M →+ V} (hi : Function.Injective i)
    (S : AddSubmonoid M) :
    (hull ℚ (i '' (S : Set M))).toAddSubmonoid.comap i = S.nsmulSaturation :=
  AddSubmonoid.ext fun _ => mem_hull_rat_image_iff_mem_nsmulSaturation hi S

/-- Intersecting the pullback of the rational cone generated by `i '' S` with the subgroup
generated by `S` gives the saturation of `S` inside its generated subgroup. -/
theorem comap_hull_rat_image_inf_closure_eq {G : Type*} [AddCommGroup G] {i : G →+ V}
    (hi : Function.Injective i) (S : AddSubmonoid G) :
    (hull ℚ (i '' (S : Set G))).toAddSubmonoid.comap i ⊓
        (AddSubgroup.closure (S : Set G)).toAddSubmonoid =
      S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid := by
  rw [comap_hull_rat_image_eq_nsmulSaturation hi S]

end RationalHull

section DivisibleHull

variable {G : Type*} [AddCommGroup G] [HasUniqueDiv G] (S : AddSubmonoid G)

/-- In a torsion-free abelian group `G`, the integral points of the rational cone generated by `S`
inside `DivisibleHull G` equal `S.nsmulSaturation`. -/
theorem comap_hull_rat_divisibleHull_eq_nsmulSaturation :
    (hull ℚ ((DivisibleHull.coeAddMonoidHom G) '' (S : Set G))).toAddSubmonoid.comap
        (DivisibleHull.coeAddMonoidHom G) =
      S.nsmulSaturation :=
  comap_hull_rat_image_eq_nsmulSaturation DivisibleHull.coe_injective S

/-- Inside the generated subgroup `L_S = AddSubgroup.closure (S : Set G)` of a torsion-free abelian
group, the saturation of `S` in `L_S` coincides with the integral points in `L_S` of the rational
cone generated by `S` inside `DivisibleHull L_S`. -/
theorem comap_hull_rat_divisibleHull_groupClosure_eq :
    (hull ℚ
          ((DivisibleHull.coeAddMonoidHom (AddSubgroup.closure (S : Set G))) ''
            (S.comap (AddSubgroup.closure (S : Set G)).subtype :
              Set (AddSubgroup.closure (S : Set G))))).toAddSubmonoid.comap
        (DivisibleHull.coeAddMonoidHom (AddSubgroup.closure (S : Set G))) =
      (S.comap (AddSubgroup.closure (S : Set G)).subtype).nsmulSaturation :=
  comap_hull_rat_image_eq_nsmulSaturation DivisibleHull.coe_injective
    (S.comap (AddSubgroup.closure (S : Set G)).subtype)

end DivisibleHull

end PointedCone

namespace AddSubmonoid

section SeparationAndGordan

variable {L : Type*} [AddCommGroup L] [Module.Finite ℤ L] [HasUniqueDiv L]

/-- **Integral linear-form separation for submonoid saturation.** In a finitely generated
torsion-free abelian group `L`, an element `x` lies in the saturation of a finitely generated
submonoid `S` if and only if every additive homomorphism `m : L →+ ℤ` nonnegative on `S` is also
nonnegative at `x`. -/
theorem FG.mem_nsmulSaturation_iff_forall_nonneg {S : AddSubmonoid L} (hS : S.FG) {x : L} :
    x ∈ S.nsmulSaturation ↔ ∀ m : L →+ ℤ, (∀ s ∈ S, 0 ≤ m s) → 0 ≤ m x := by
  refine ⟨fun hx m hm => ?_, fun h => ?_⟩
  · obtain ⟨n, hn, hnx⟩ := mem_nsmulSaturation.mp hx
    have hmul : 0 ≤ (n : ℤ) * m x := by simpa [map_nsmul, nsmul_eq_mul] using hm _ hnx
    exact nonneg_of_mul_nonneg_right hmul (by exact_mod_cast hn)
  · by_contra hx
    have : Module.Free ℤ L := Module.free_of_finite_type_torsion_free'
    obtain ⟨s, rfl⟩ := isAddFG_iff.mp hS
    obtain ⟨c, m, hsum, hm, hpos⟩ :=
      TauCeti.exists_nat_sum_nsmul_eq_zero_and_forall_coeff_add_dual_pos
        (Sum.elim (fun _ : Unit => -x) fun a : s => (a : L))
    simp only [Fintype.sum_sum_type, Fintype.univ_punit, Finset.sum_singleton, Sum.elim_inl,
      Sum.elim_inr, smul_neg, neg_add_eq_zero] at hsum
    have hcx : c (.inl ()) = 0 := by
      by_contra hc0
      refine hx (mem_nsmulSaturation.mpr ⟨c (.inl ()), Nat.pos_of_ne_zero hc0, ?_⟩)
      rw [hsum]
      exact _root_.sum_mem fun (a : s) _ => nsmul_mem (subset_closure a.2) _
    have hmS : ∀ y ∈ closure (s : Set L), 0 ≤ m y := by
      intro y hy
      induction hy using closure_induction with
      | mem z hz => simpa using hm (.inr ⟨z, hz⟩)
      | zero => simp
      | add _ _ _ _ ih₁ ih₂ =>
        rw [map_add]
        exact add_nonneg ih₁ ih₂
    have hneg : m x < 0 := by
      have hp := hpos (.inl ())
      simp only [hcx, Nat.cast_zero, zero_add, Sum.elim_inl, map_neg] at hp
      lia
    exact hneg.not_ge (h m hmS)

omit [Module.Finite ℤ L] [HasUniqueDiv L] in
private theorem abs_repr_le_of_nsmul_eq_sum {ι : Type*} (b : Module.Basis ι ℤ L)
    {m n : ℕ} (hn : 0 < n) (a : Fin m → L) (r : Fin m → ℕ) (hr : ∀ j, r j < n) {z : L}
    (hz : n • z = ∑ j, r j • a j) (i : ι) :
    |b.repr z i| ≤ ∑ j, |b.repr (a j) i| := by
  have h1 : (n : ℤ) * |b.repr z i| = |b.repr (n • z) i| := by
    rw [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul, abs_mul,
      abs_of_pos (by exact_mod_cast hn : (0 : ℤ) < n)]
  have h2 : |b.repr (n • z) i| ≤ (n : ℤ) * ∑ j, |b.repr (a j) i| := by
    rw [hz, map_sum, Finsupp.finsetSum_apply, Finset.mul_sum]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun j _ => ?_)
    rw [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul, abs_mul,
      abs_of_nonneg (Nat.cast_nonneg (r j))]
    exact mul_le_mul_of_nonneg_right (Int.ofNat_le.mpr (hr j).le) (abs_nonneg _)
  exact le_of_mul_le_mul_left (h1.trans_le h2) (by exact_mod_cast hn : (0 : ℤ) < n)

/-- **Bounded shifts for submonoid saturation.** If `S` is a finitely generated submonoid of a
finitely generated torsion-free abelian group `L`, there is a finite subset `F ⊆ S.nsmulSaturation`
such that every element of `S.nsmulSaturation` is of the form `z + s` with `z ∈ F` and `s ∈ S`. -/
theorem FG.exists_finset_subset_nsmulSaturation_add {S : AddSubmonoid L} (hS : S.FG) :
    ∃ F : Finset L, (F : Set L) ⊆ S.nsmulSaturation ∧
      ∀ x ∈ S.nsmulSaturation, ∃ z ∈ F, ∃ s ∈ S, x = z + s := by
  classical
  have : Module.Free ℤ L := Module.free_of_finite_type_torsion_free'
  let b := Module.Free.chooseBasis ℤ L
  let ι := Module.Free.ChooseBasisIndex ℤ L
  obtain ⟨m, g, hg⟩ := fg_iff_exists_fin_addMonoidHom.mp hS
  let a : Fin m → L := fun j => g (Pi.single j 1)
  have hg_eq (k : Fin m → ℕ) : g k = ∑ j, k j • a j := by
    have hk_sum : k = ∑ j, k j • Pi.single j 1 := by
      ext j
      simp [Finset.sum_apply, Pi.single_apply]
    conv_lhs => rw [hk_sum]
    rw [map_sum]
    exact Finset.sum_congr rfl fun j _ => map_nsmul g (k j) (Pi.single j 1)
  let B : ι → ℤ := fun i => ∑ j, |b.repr (a j) i|
  let box : Finset (ι → ℤ) := Fintype.piFinset fun i => Finset.Icc (-B i) (B i)
  let e : L ↪ (ι → ℤ) :=
    ⟨fun z i => b.repr z i, fun z₁ z₂ h => b.repr.injective (Finsupp.ext (congrFun h))⟩
  have hfin : {z : L | z ∈ S.nsmulSaturation ∧ ∀ i, |b.repr z i| ≤ B i}.Finite := by
    refine (box.finite_toSet.preimage_embedding e).subset fun z hz => ?_
    rw [Set.mem_preimage, Finset.mem_coe, Fintype.mem_piFinset]
    exact fun i => Finset.mem_Icc.mpr (abs_le.mp (hz.2 i))
  refine ⟨hfin.toFinset, fun z hz => ((Set.Finite.mem_toFinset hfin).mp hz).1, fun x hx => ?_⟩
  obtain ⟨n, hn, hnx⟩ := mem_nsmulSaturation.mp hx
  rw [← hg, AddMonoidHom.mem_mrange] at hnx
  obtain ⟨k, hk⟩ := hnx
  let q : Fin m → ℕ := fun j => k j / n
  let r : Fin m → ℕ := fun j => k j % n
  let s : L := g q
  let z : L := x - s
  have hnz : n • z = g r := by
    dsimp only [z, s]
    rw [smul_sub, ← hk, hg_eq k, hg_eq q, hg_eq r, Finset.smul_sum, sub_eq_iff_eq_add,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [smul_smul, ← add_smul, add_comm, Nat.div_add_mod]
  have hz_sat : z ∈ S.nsmulSaturation :=
    mem_nsmulSaturation.mpr ⟨n, hn, hnz ▸ hg ▸ ⟨r, rfl⟩⟩
  have hz_bound : ∀ i, |b.repr z i| ≤ B i :=
    abs_repr_le_of_nsmul_eq_sum b hn a r (fun j => Nat.mod_lt _ hn) (hnz.trans (hg_eq r))
  exact ⟨z, (Set.Finite.mem_toFinset hfin).mpr ⟨hz_sat, hz_bound⟩,
    s, hg ▸ ⟨q, rfl⟩, (sub_add_cancel x s).symm⟩

/-- **Gordan's lemma for submonoid saturation.** In a finitely generated torsion-free abelian
group `L`, the saturation of any finitely generated additive submonoid `S` is finitely generated. -/
theorem FG.nsmulSaturation {S : AddSubmonoid L} (hS : S.FG) : S.nsmulSaturation.FG := by
  classical
  obtain ⟨F, hF_sub, hF_add⟩ := hS.exists_finset_subset_nsmulSaturation_add
  obtain ⟨T, hT⟩ := isAddFG_iff.mp hS
  refine isAddFG_iff.mpr ⟨F ∪ T, le_antisymm ?_ (fun x hx => ?_)⟩
  · rw [closure_le, Finset.coe_union]
    exact Set.union_subset hF_sub (hT ▸ subset_closure |>.trans S.le_nsmulSaturation)
  · obtain ⟨z, hz, s, hs, rfl⟩ := hF_add x hx
    refine add_mem (subset_closure (Finset.mem_coe.mpr (Finset.mem_union_left _ hz))) ?_
    exact closure_mono (Finset.subset_union_right (s₁ := F)) (hT ▸ hs)

end SeparationAndGordan

section GeneratedGroup

variable {G : Type*}

/-- The subgroup generated by a finitely generated additive submonoid is finitely generated. -/
theorem FG.addSubgroup_closure [AddGroup G] {S : AddSubmonoid G} (hS : S.FG) :
    (AddSubgroup.closure (S : Set G)).FG := by
  obtain ⟨s, rfl⟩ := isAddFG_iff.mp hS
  have heq : AddSubgroup.closure ((closure (s : Set G) : AddSubmonoid G) : Set G) =
      AddSubgroup.closure (s : Set G) :=
    le_antisymm
      ((AddSubgroup.closure_le _).mpr <|
        (closure_le (s := (s : Set G)) (S := (AddSubgroup.closure (s : Set G)).toAddSubmonoid)).mpr
          AddSubgroup.subset_closure)
      (AddSubgroup.closure_mono subset_closure)
  exact (AddSubgroup.fg_iff _).mpr ⟨s, heq.symm, s.finite_toSet⟩

/-- Pulling back a finitely generated additive submonoid `S` to the subgroup it generates yields a
finitely generated additive submonoid. -/
theorem FG.comap_subtype_closure [AddGroup G] {S : AddSubmonoid G} (hS : S.FG) :
    (S.comap (AddSubgroup.closure (S : Set G)).subtype).FG := by
  have := hS
  rw [← S.mrange_toGroupClosure, AddMonoidHom.mrange_eq_map]
  exact AddMonoid.FG.fg_top.map S.toGroupClosure

variable [AddCommGroup G] [HasUniqueDiv G]

/-- In any torsion-free abelian group `G`, an element `x` of `AddSubgroup.closure (S : Set G)`
belongs to `S.nsmulSaturation` if and only if every `ℤ`-valued additive homomorphism on the
generated subgroup that is nonnegative on `S` is nonnegative at `x`. -/
theorem FG.mem_nsmulSaturation_inf_closure_iff {S : AddSubmonoid G} (hS : S.FG) {x : G}
    (hx : x ∈ AddSubgroup.closure (S : Set G)) :
    x ∈ S.nsmulSaturation ↔
      ∀ m : AddSubgroup.closure (S : Set G) →+ ℤ,
        (∀ s : S, 0 ≤ m (S.toGroupClosure s)) → 0 ≤ m ⟨x, hx⟩ := by
  have : Module.Finite ℤ (AddSubgroup.closure (S : Set G)) :=
    Module.Finite.iff_addGroup_fg.mpr hS.addSubgroup_closure
  have hiff := hS.comap_subtype_closure.mem_nsmulSaturation_iff_forall_nonneg (x := ⟨x, hx⟩)
  rw [nsmulSaturation_comap, mem_comap, AddSubgroup.coe_subtype] at hiff
  refine hiff.trans ⟨fun h m hm => h m fun y hy => ?_, fun h m hm => ?_⟩
  · have hy_eq : S.toGroupClosure ⟨y.1, hy⟩ = y := Subtype.ext (S.coe_toGroupClosure ⟨y.1, hy⟩)
    exact hy_eq ▸ hm ⟨y.1, hy⟩
  · refine h m fun s => hm (S.toGroupClosure s) ?_
    rw [mem_comap, AddSubgroup.coe_subtype, S.coe_toGroupClosure]
    exact s.2

/-- In any torsion-free abelian group `G`, the saturation of a finitely generated submonoid `S`
inside `AddSubgroup.closure (S : Set G)` is covered by finitely many shifts of `S`. -/
theorem FG.exists_finset_subset_nsmulSaturation_inf_closure_add {S : AddSubmonoid G} (hS : S.FG) :
    ∃ F : Finset G,
      (F : Set G) ⊆ S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid ∧
        ∀ x ∈ S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid,
          ∃ z ∈ F, ∃ s ∈ S, x = z + s := by
  classical
  have : Module.Finite ℤ (AddSubgroup.closure (S : Set G)) :=
    Module.Finite.iff_addGroup_fg.mpr hS.addSubgroup_closure
  obtain ⟨F₀, hF₀_sub, hF₀_add⟩ :=
    hS.comap_subtype_closure.exists_finset_subset_nsmulSaturation_add
  refine ⟨F₀.image Subtype.val, ?_, fun x hx => ?_⟩
  · rw [Finset.coe_image]
    rintro _ ⟨z, hz, rfl⟩
    have hz' := hF₀_sub hz
    rw [nsmulSaturation_comap] at hz'
    exact ⟨hz', z.2⟩
  · obtain ⟨hx1, hx2⟩ := mem_inf.mp hx
    have hx0 : (⟨x, hx2⟩ : AddSubgroup.closure (S : Set G)) ∈
        (S.comap (AddSubgroup.closure (S : Set G)).subtype).nsmulSaturation := by
      rw [nsmulSaturation_comap]
      exact hx1
    obtain ⟨z, hz, s, hs, heq⟩ := hF₀_add ⟨x, hx2⟩ hx0
    exact ⟨z.1, Finset.mem_image_of_mem Subtype.val hz, s.1, hs, congrArg Subtype.val heq⟩

/-- In any torsion-free abelian group `G`, the saturation of the pullback of a finitely generated
submonoid `S` to `AddSubgroup.closure (S : Set G)` is finitely generated. -/
theorem FG.nsmulSaturation_comap_subtype_closure {S : AddSubmonoid G} (hS : S.FG) :
    (S.comap (AddSubgroup.closure (S : Set G)).subtype).nsmulSaturation.FG := by
  have : Module.Finite ℤ (AddSubgroup.closure (S : Set G)) :=
    Module.Finite.iff_addGroup_fg.mpr hS.addSubgroup_closure
  exact hS.comap_subtype_closure.nsmulSaturation

/-- In any torsion-free abelian group `G`, the saturation of a finitely generated submonoid `S`
inside `AddSubgroup.closure (S : Set G)` is finitely generated. -/
theorem FG.nsmulSaturation_inf_closure {S : AddSubmonoid G} (hS : S.FG) :
    (S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid).FG := by
  have hmap : ((S.comap (AddSubgroup.closure (S : Set G)).subtype).nsmulSaturation).map
      (AddSubgroup.closure (S : Set G)).subtype =
      S.nsmulSaturation ⊓ (AddSubgroup.closure (S : Set G)).toAddSubmonoid := by
    ext x
    rw [mem_map, nsmulSaturation_comap, mem_inf]
    exact ⟨by rintro ⟨z, hz, rfl⟩; exact ⟨hz, z.2⟩,
      fun ⟨hx1, hx2⟩ => ⟨⟨x, hx2⟩, hx1, rfl⟩⟩
  exact hmap ▸ hS.nsmulSaturation_comap_subtype_closure.map _

end GeneratedGroup

end AddSubmonoid
