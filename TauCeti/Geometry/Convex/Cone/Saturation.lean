/-!
# Rational cones and integral linear-form separation for submonoid saturations

Over any linearly ordered field `K`, the underlying additive submonoid and any lattice-point
pullback of a pointed cone `σ : PointedCone K V` are `NSMulSaturated`
(`PointedCone.nsmulSaturated_toAddSubmonoid` and `PointedCone.nsmulSaturated_latticePoints`). In any
`ℚ`-vector space `V`, the underlying additive submonoid of the pointed rational cone
`PointedCone.hull ℚ s` generated by a subset `s : Set V` coincides with the positive-multiple
saturation `(AddSubmonoid.closure s).nsmulSaturation` (`PointedCone.toAddSubmonoid_hull_rat`), and
for an additive submonoid `S : AddSubmonoid V` we have
`(PointedCone.hull ℚ (S : Set V)).toAddSubmonoid = S.nsmulSaturation`
(`PointedCone.toAddSubmonoid_hull_rat_eq_nsmulSaturation`). Pulling back along an injective
homomorphism `i : M →+ V` identifies the lattice points of `PointedCone.hull ℚ (i '' s)` and
`PointedCone.hull ℚ (i '' S)` along `i` with `(AddSubmonoid.closure s).nsmulSaturation` and
`S.nsmulSaturation` (`PointedCone.latticePoints_hull_rat_image_eq_nsmulSaturation_closure` and
`PointedCone.latticePoints_hull_rat_image_eq_nsmulSaturation`).

When `S` is finitely generated in a free abelian group `L`, Tucker's theorem over the integers
(`TauCeti.Geometry.Convex.Cone.Alternative`) gives **integral linear separation**: an element
`x : L` belongs to `S.nsmulSaturation` if and only if every additive functional `m : L →+ ℤ` that is
nonnegative on `S` is also nonnegative at `x`
(`AddSubmonoid.FG.mem_nsmulSaturation_iff_forall_nonneg`). Passing to the generated subgroup
`AddSubgroup.closure (S : Set G)` extends this characterization to any torsion-free abelian group
`G` (`AddSubmonoid.FG.mem_nsmulSaturation_iff_forall_nonneg_of_mem_closure`).

## Main results

* `PointedCone.nsmulSaturated_toAddSubmonoid` and `PointedCone.nsmulSaturated_latticePoints`: over
  a linearly ordered field `K`, `σ.toAddSubmonoid` and `σ.latticePoints i` are `NSMulSaturated`.
* `PointedCone.toAddSubmonoid_hull_rat` and
  `PointedCone.toAddSubmonoid_hull_rat_eq_nsmulSaturation`: the additive submonoid of a rational
  pointed cone `PointedCone.hull ℚ s` (resp. `PointedCone.hull ℚ (S : Set V)`) equals
  `(AddSubmonoid.closure s).nsmulSaturation` (resp. `S.nsmulSaturation`).
* `PointedCone.latticePoints_hull_rat_image_eq_nsmulSaturation_closure` and
  `PointedCone.latticePoints_hull_rat_image_eq_nsmulSaturation`: the lattice points of
  `PointedCone.hull ℚ (i '' s)` (resp. `PointedCone.hull ℚ (i '' S)`) along an injective
  homomorphism `i : M →+ V` form `(AddSubmonoid.closure s).nsmulSaturation` (resp.
  `S.nsmulSaturation`).
* `AddSubmonoid.FG.mem_nsmulSaturation_iff_forall_nonneg`: integral linear-form characterization of
  `S.nsmulSaturation` in a free abelian group.
* `AddSubmonoid.FG.mem_nsmulSaturation_iff_forall_nonneg_of_mem_closure`: integral linear-form
  characterization inside `AddSubgroup.closure (S : Set G)` for an arbitrary torsion-free abelian
  group `G`.

## References

* W. Bruns and J. Gubeladze, *Polytopes, Rings, and K-Theory*, Chapter 2.
* W. Fulton, *Introduction to Toric Varieties*, §1.2.
* D. Cox, J. Little and H. Schenck, *Toric Varieties*, §1.2.
-/

public section

namespace PointedCone

section LinearOrderedField

variable {K M V : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  [AddCommMonoid M] [AddCommMonoid V] [Module K V]

/-- Over a linearly ordered field `K`, the underlying additive submonoid of any pointed cone is
`NSMulSaturated`. -/
@[simp]
theorem nsmulSaturated_toAddSubmonoid (σ : PointedCone K V) :
    σ.toAddSubmonoid.NSMulSaturated := fun n v hnv => by
  rcases eq_or_lt_of_le (Nat.zero_le n) with rfl | hn
  · exact Or.inl rfl
  · rw [Submodule.mem_toAddSubmonoid, ← Nat.cast_smul_eq_nsmul K] at hnv
    exact Or.inr ((σ.smul_mem_iff (by exact_mod_cast hn)).mp hnv)

/-- Over a linearly ordered field `K`, the lattice-point submonoid of any pointed cone along an
additive homomorphism `i : M →+ V` is `NSMulSaturated`. -/
@[simp]
theorem nsmulSaturated_latticePoints (σ : PointedCone K V) (i : M →+ V) :
    (σ.latticePoints i).NSMulSaturated := by
  rw [latticePoints_def]
  exact σ.nsmulSaturated_toAddSubmonoid.comap i

end LinearOrderedField

section RationalHull

variable {M V : Type*} [AddCommMonoid M] [AddCommMonoid V] [Module ℚ V]

/-- In a `ℚ`-module `V`, the underlying additive submonoid of the rational pointed cone generated
by `s` equals the positive-multiple saturation of `AddSubmonoid.closure s`. -/
theorem toAddSubmonoid_hull_rat (s : Set V) :
    (hull ℚ s).toAddSubmonoid = (AddSubmonoid.closure s).nsmulSaturation := by
  refine le_antisymm (fun v hv => ?_) ?_
  · induction hv using Submodule.span_induction with
    | mem w hw => exact (AddSubmonoid.closure s).le_nsmulSaturation (AddSubmonoid.subset_closure hw)
    | zero => exact zero_mem _
    | add _ _ _ _ ih₁ ih₂ => exact add_mem ih₁ ih₂
    | smul q w _ ih =>
      obtain ⟨n, hn, hnw⟩ := AddSubmonoid.mem_nsmulSaturation.mp ih
      let d : ℕ := q.1.den
      let a : ℕ := q.1.num.toNat
      have ha : (a : ℚ) = q.1.num := by
        exact_mod_cast Int.toNat_of_nonneg (Rat.num_nonneg.mpr q.2)
      have hden : (d : ℚ) * q.1 = (a : ℚ) := by
        rw [mul_comm, ha]
        exact q.1.mul_den_eq_num
      have hdw : d • (q • w) = a • w := by
        simp [← Nonneg.coe_smul, ← Nat.cast_smul_eq_nsmul ℚ, smul_smul, hden]
      refine AddSubmonoid.mem_nsmulSaturation.mpr ⟨n * d, Nat.mul_pos hn q.1.den_pos, ?_⟩
      rw [mul_smul, hdw, smul_comm n a]
      exact nsmul_mem hnw a
  · exact (AddSubmonoid.nsmulSaturation_le_iff_le (hull ℚ s).nsmulSaturated_toAddSubmonoid).mpr
      (AddSubmonoid.closure_le.mpr subset_hull)

/-- In a `ℚ`-module `V`, the underlying additive submonoid of the rational pointed cone generated
by an additive submonoid `S` equals `S.nsmulSaturation`. -/
theorem toAddSubmonoid_hull_rat_eq_nsmulSaturation (S : AddSubmonoid V) :
    (hull ℚ (S : Set V)).toAddSubmonoid = S.nsmulSaturation := by
  rw [toAddSubmonoid_hull_rat, S.closure_eq]

/-- In a `ℚ`-module `V`, a vector `v` belongs to `hull ℚ s` if and only if it belongs to the
saturation of `AddSubmonoid.closure s`. -/
theorem mem_hull_rat_iff_mem_nsmulSaturation_closure (s : Set V) {v : V} :
    v ∈ hull ℚ s ↔ v ∈ (AddSubmonoid.closure s).nsmulSaturation :=
  SetLike.ext_iff.mp (toAddSubmonoid_hull_rat s) v

/-- In a `ℚ`-module `V`, a vector `v` belongs to `hull ℚ (S : Set V)` for an additive submonoid `S`
if and only if it belongs to `S.nsmulSaturation`. -/
theorem mem_hull_rat_iff_mem_nsmulSaturation (S : AddSubmonoid V) {v : V} :
    v ∈ hull ℚ (S : Set V) ↔ v ∈ S.nsmulSaturation :=
  SetLike.ext_iff.mp (toAddSubmonoid_hull_rat_eq_nsmulSaturation S) v

/-- The lattice points of the rational cone generated by `i '' s` along an injective homomorphism
`i : M →+ V` form the saturation `(AddSubmonoid.closure s).nsmulSaturation`. -/
theorem latticePoints_hull_rat_image_eq_nsmulSaturation_closure {i : M →+ V}
    (hi : Function.Injective i) (s : Set M) :
    (hull ℚ (i '' s)).latticePoints i = (AddSubmonoid.closure s).nsmulSaturation := by
  rw [latticePoints_def, toAddSubmonoid_hull_rat, ← AddMonoidHom.map_mclosure,
    ← AddSubmonoid.nsmulSaturation_comap, AddSubmonoid.comap_map_eq_of_injective hi]

/-- The lattice points of the rational cone generated by `i '' S` along an injective homomorphism
`i : M →+ V` form the saturation `S.nsmulSaturation`. -/
theorem latticePoints_hull_rat_image_eq_nsmulSaturation {i : M →+ V} (hi : Function.Injective i)
    (S : AddSubmonoid M) :
    (hull ℚ (i '' (S : Set M))).latticePoints i = S.nsmulSaturation := by
  simpa [S.closure_eq] using latticePoints_hull_rat_image_eq_nsmulSaturation_closure hi (S : Set M)

/-- Along an injective homomorphism `i : M →+ V` into a `ℚ`-module, an element `x : M` maps into
the rational cone hull of `i '' s` if and only if it belongs to the saturation of
`AddSubmonoid.closure s`. -/
theorem mem_hull_rat_image_iff_mem_nsmulSaturation_closure {i : M →+ V}
    (hi : Function.Injective i) (s : Set M) {x : M} :
    i x ∈ hull ℚ (i '' s) ↔ x ∈ (AddSubmonoid.closure s).nsmulSaturation :=
  mem_latticePoints.symm.trans
    (SetLike.ext_iff.mp (latticePoints_hull_rat_image_eq_nsmulSaturation_closure hi s) x)

/-- Along an injective homomorphism `i : M →+ V` into a `ℚ`-module, `i x` belongs to the rational
cone generated by `i '' S` if and only if `x` lies in `S.nsmulSaturation`. -/
theorem mem_hull_rat_image_iff_mem_nsmulSaturation {i : M →+ V} (hi : Function.Injective i)
    (S : AddSubmonoid M) {x : M} :
    i x ∈ hull ℚ (i '' (S : Set M)) ↔ x ∈ S.nsmulSaturation :=
  mem_latticePoints.symm.trans
    (SetLike.ext_iff.mp (latticePoints_hull_rat_image_eq_nsmulSaturation hi S) x)

end RationalHull

end PointedCone

namespace AddSubmonoid

section Separation

variable {L : Type*} [AddCommGroup L] [Module.Free ℤ L]

/-- **Integral linear-form separation for submonoid saturation.** In a free abelian group `L`, an
element `x` lies in the saturation of a finitely generated submonoid `S` if and only if every
additive homomorphism `m : L →+ ℤ` nonnegative on `S` is also nonnegative at `x`. -/
theorem FG.mem_nsmulSaturation_iff_forall_nonneg {S : AddSubmonoid L} (hS : S.FG) {x : L} :
    x ∈ S.nsmulSaturation ↔ ∀ m : L →+ ℤ, (∀ s ∈ S, 0 ≤ m s) → 0 ≤ m x := by
  refine ⟨fun hx m hm => ?_, fun h => ?_⟩
  · obtain ⟨n, hn, hnx⟩ := mem_nsmulSaturation.mp hx
    have hmul : 0 ≤ (n : ℤ) * m x := by simpa [map_nsmul, nsmul_eq_mul] using hm _ hnx
    exact nonneg_of_mul_nonneg_right hmul (by exact_mod_cast hn)
  · by_contra hx
    obtain ⟨s, rfl⟩ := isAddFG_iff.mp hS
    obtain ⟨c, m, hsum, hm, hpos⟩ :=
      TauCeti.exists_nat_sum_nsmul_eq_zero_and_forall_coeff_add_dual_pos
        (Sum.elim (fun _ : Unit => -x) fun a : s => (a : L))
    simp only [Fintype.sum_sum_type, Fintype.univ_punit, Finset.sum_singleton, Sum.elim_inl,
      Sum.elim_inr, smul_neg, neg_add_eq_zero] at hsum
    have hcx : c (.inl ()) = 0 := by
      by_contra hc0
      refine hx (mem_nsmulSaturation.mpr ⟨c (.inl ()), Nat.pos_of_ne_zero hc0, ?_⟩)
      rw [hsum]
      exact _root_.sum_mem fun (a : s) _ => nsmul_mem (subset_closure a.2) _
    have hmS : ∀ y ∈ closure (s : Set L), 0 ≤ m y := by
      intro y hy
      induction hy using closure_induction with
      | mem z hz => simpa using hm (.inr ⟨z, hz⟩)
      | zero => simp
      | add _ _ _ _ ih₁ ih₂ =>
        rw [map_add]
        exact add_nonneg ih₁ ih₂
    have hneg : m x < 0 := by
      have hp := hpos (.inl ())
      simp only [hcx, Nat.cast_zero, zero_add, Sum.elim_inl, map_neg] at hp
      lia
    exact hneg.not_ge (h m hmS)

end Separation

section GeneratedGroup

variable {G : Type*} [AddCommGroup G] [HasUniqueDiv G]

/-- In any torsion-free abelian group `G`, an element `x` of `AddSubgroup.closure (S : Set G)`
belongs to the saturation `S.nsmulSaturation` of a finitely generated submonoid `S` if and only if
every `ℤ`-valued additive homomorphism on the generated subgroup that is nonnegative on `S` is
nonnegative at `x`. -/
theorem FG.mem_nsmulSaturation_iff_forall_nonneg_of_mem_closure {S : AddSubmonoid G} (hS : S.FG)
    {x : G} (hx : x ∈ AddSubgroup.closure (S : Set G)) :
    x ∈ S.nsmulSaturation ↔
      ∀ m : AddSubgroup.closure (S : Set G) →+ ℤ,
        (∀ s : S, 0 ≤ m (S.toGroupClosure s)) → 0 ≤ m ⟨x, hx⟩ := by
  have := hS.addSubgroupClosure
  have hiff := hS.comap_subtype_closure.mem_nsmulSaturation_iff_forall_nonneg (x := ⟨x, hx⟩)
  rw [nsmulSaturation_comap, mem_comap, AddSubgroup.coe_subtype] at hiff
  refine hiff.trans ⟨fun h m hm => h m fun y hy => ?_, fun h m hm => ?_⟩
  · have hy_eq : S.toGroupClosure ⟨y.1, hy⟩ = y := Subtype.ext (S.coe_toGroupClosure ⟨y.1, hy⟩)
    exact hy_eq ▸ hm ⟨y.1, hy⟩
  · refine h m fun s => hm (S.toGroupClosure s) ?_
    rw [mem_comap, AddSubgroup.coe_subtype, S.coe_toGroupClosure]
    exact s.2

end GeneratedGroup

end AddSubmonoid
