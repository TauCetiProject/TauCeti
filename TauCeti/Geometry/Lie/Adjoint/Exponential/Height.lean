module

public import TauCeti.Algebra.Lie.Coadjoint.RootPlane
public import TauCeti.Geometry.Lie.Adjoint.Exponential.Formula

/-!
# Heights along one-parameter adjoint orbits

Let `G` be a finite-dimensional real Lie group with Lie algebra `𝔤`, and let `B` be a bilinear
form on `𝔤`. For `X ∈ 𝔤` the **height** `f_X = B(·, X)` restricts to every adjoint orbit. This file
differentiates it along the orbit curve `t ↦ Ad_(exp tA) p` through `p` generated by `A ∈ 𝔤`:

`d/dt B(Ad_(exp tA) p, X) = B(⁅A, Ad_(exp tA) p⁆, X)`

(`TauCeti.Lie.hasDerivAt_apply_tangentAd_mulInvariantExp_smul`), so at `t = 0` the derivative is
`B(⁅A, p⁆, X)`, and the second derivative at `t = 0` is `B(⁅A, ⁅A, p⁆⁆, X)`
(`TauCeti.Lie.hasDerivAt_deriv_apply_tangentAd_mulInvariantExp_smul`).

For an invariant form, `B(⁅A, p⁆, X) = -B(⁅X, p⁆, A)` vanishes for every `A` as soon as
`⁅X, p⁆ = 0`, so such a `p` is a critical point of the height on its orbit, and the second
derivative is `B(⁅A, ⁅A, p⁆⁆, X) = -B(⁅A, p⁆, ⁅A, X⁆)`
(`TauCeti.Lie.hasDerivAt_deriv_apply_tangentAd_mulInvariantExp_smul_of_lieInvariant`). The orbit
curve has velocity `⁅A, p⁆` at `t = 0`, and every tangent vector of the orbit at `p` has this form,
so at the critical point `p` these second derivatives are the values `Hess_p f_X(⁅A, p⁆, ⁅A, p⁆)`
of the Hessian quadratic form of the height on the orbit.

On a root plane `E` of `t` with root `α` (`TauCeti.IsRootPlane`), and for `p, X ∈ t`, this second
derivative is `-α(p) α(X) B(A, A)`
(`TauCeti.Lie.hasDerivAt_deriv_apply_tangentAd_mulInvariantExp_smul_of_isRootPlane`). When
moreover `⁅X, p⁆ = 0` (for instance when `t` is abelian), `p` is critical and this is the Hessian
value `Hess_p f_X(q_p A, q_p A) = -α(X) α(p) B(A, A)` of `TauCeti.Algebra.Lie.Coadjoint.RootPlane`.

## Main results

* `TauCeti.Lie.hasDerivAt_apply_tangentAd_mulInvariantExp_smul`: the derivative of the height
  along the orbit curve.
* `TauCeti.Lie.hasDerivAt_apply_tangentAd_mulInvariantExp_smul_zero_of_lie_eq_zero`: a point
  commuting with `X` is critical for the height of an invariant form along every orbit curve.
* `TauCeti.Lie.hasDerivAt_deriv_apply_tangentAd_mulInvariantExp_smul`,
  `TauCeti.Lie.hasDerivAt_deriv_apply_tangentAd_mulInvariantExp_smul_of_lieInvariant`: the
  second derivative at `t = 0`.
* `TauCeti.Lie.hasDerivAt_deriv_apply_tangentAd_mulInvariantExp_smul_of_isRootPlane`: the second
  derivative along a root plane.

## References

* R. Bott, *An application of the Morse theory to the topology of Lie-groups*, Bull. Soc. Math.
  France 84 (1956), 251–281.
* M. Audin, *Torus Actions on Symplectic Manifolds*, 2nd ed., Progress in Mathematics 93,
  Birkhäuser, 2004, Chapter II.
-/

public section

noncomputable section

namespace TauCeti.Lie

open scoped ContDiff Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [FiniteDimensional ℝ E] [LieGroup I ∞ G] [T2Space G]

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold

variable (B : LinearMap.BilinForm ℝ (GroupLieAlgebra I G)) (A p X : GroupLieAlgebra I G)

/-- **The derivative of a height along a one-parameter adjoint orbit.** For a bilinear form `B`
on `𝔤`, `d/dt B(Ad_(exp tA) p, X) = B(⁅A, Ad_(exp tA) p⁆, X)` at every time. -/
theorem hasDerivAt_apply_tangentAd_mulInvariantExp_smul (s : ℝ) :
    HasDerivAt (fun t : ℝ ↦ B (tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (t • A)) p) X)
      (B ⁅A, tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (s • A)) p⁆ X) s := by
  -- `v ↦ B v X` as a continuous functional on the model space `E`, to which
  -- `GroupLieAlgebra I G` reduces definitionally; the normed derivative API is stated on `E`.
  let φ : E →L[ℝ] ℝ := LinearMap.toContinuousLinearMap (show E →ₗ[ℝ] ℝ from B.flip X)
  -- The derivative of the orbit curve is `ad A` applied to the curve, read on `E`; applying `φ`
  -- to it gives `B ⁅A, ·⁆ X` by definitional unfolding of these model-space readings.
  exact φ.hasFDerivAt.comp_hasDerivAt s
    (hasDerivAt_tangentAd_mulInvariantExp_smul_apply (I := I) (G := G) A p s)

/-- At `t = 0`, the derivative of the height `B(Ad_(exp tA) p, X)` is `B(⁅A, p⁆, X)`. -/
theorem hasDerivAt_apply_tangentAd_mulInvariantExp_smul_zero :
    HasDerivAt (fun t : ℝ ↦ B (tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (t • A)) p) X)
      (B ⁅A, p⁆ X) 0 := by
  simpa [mulInvariantExp_zero, adjointContinuousLinearMap_one] using
    hasDerivAt_apply_tangentAd_mulInvariantExp_smul B A p X 0

/-- **Points commuting with `X` are critical for the height.** For an invariant form `B` and
`⁅X, p⁆ = 0`, the height `B(Ad_(exp tA) p, X)` has derivative `0` at `t = 0` for every `A`. -/
theorem hasDerivAt_apply_tangentAd_mulInvariantExp_smul_zero_of_lie_eq_zero
    (hB : B.lieInvariant (GroupLieAlgebra I G)) (hXp : ⁅X, p⁆ = 0) :
    HasDerivAt (fun t : ℝ ↦ B (tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (t • A)) p) X)
      0 0 := by
  convert hasDerivAt_apply_tangentAd_mulInvariantExp_smul_zero B A p X using 1
  -- `B ⁅A, p⁆ X = -B p ⁅A, X⁆ = B p ⁅X, A⁆ = -B ⁅X, p⁆ A = 0` by invariance.
  have h₁ := hB A p X
  have h₂ := hB X p A
  rw [hXp, map_zero, LinearMap.zero_apply, ← lie_skew X A, map_neg, neg_neg] at h₂
  linear_combination -h₁ - h₂

/-- **The second derivative of a height along a one-parameter adjoint orbit.** At `t = 0`,
`d²/dt² B(Ad_(exp tA) p, X) = B(⁅A, ⁅A, p⁆⁆, X)`. -/
theorem hasDerivAt_deriv_apply_tangentAd_mulInvariantExp_smul :
    HasDerivAt
      (deriv fun t : ℝ ↦ B (tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (t • A)) p) X)
      (B ⁅A, ⁅A, p⁆⁆ X) 0 := by
  have hderiv : (deriv fun t : ℝ ↦
      B (tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (t • A)) p) X) =
      fun s ↦ B ⁅A, tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (s • A)) p⁆ X :=
    funext fun s ↦ (hasDerivAt_apply_tangentAd_mulInvariantExp_smul B A p X s).deriv
  rw [hderiv]
  -- `v ↦ B ⁅A, v⁆ X` as a continuous functional on the model space `E`, read as in
  -- `hasDerivAt_apply_tangentAd_mulInvariantExp_smul`.
  let ψ : E →L[ℝ] ℝ := LinearMap.toContinuousLinearMap
    (show E →ₗ[ℝ] ℝ from B.flip X ∘ₗ LieAlgebra.ad ℝ (GroupLieAlgebra I G) A)
  have h : HasDerivAt
      (fun s : ℝ ↦ B ⁅A, tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (s • A)) p⁆ X)
      (B ⁅A, ⁅A, tangentAd (I := I) (mulInvariantExp (I := I) (G := G) ((0 : ℝ) • A)) p⁆⁆ X) 0 :=
    -- As in `hasDerivAt_apply_tangentAd_mulInvariantExp_smul`, `ψ` applied to the model-space
    -- derivative of the orbit curve unfolds definitionally to `B ⁅A, ⁅A, ·⁆⁆ X`.
    ψ.hasFDerivAt.comp_hasDerivAt 0
      (hasDerivAt_tangentAd_mulInvariantExp_smul_apply (I := I) (G := G) A p 0)
  simpa [mulInvariantExp_zero, adjointContinuousLinearMap_one] using h

/-- **The second derivative of a height for an invariant form.** For an invariant form `B`, the
second derivative of `B(Ad_(exp tA) p, X)` at `t = 0` is `-B(⁅A, p⁆, ⁅A, X⁆)`. When `⁅X, p⁆ = 0`,
`p` is a critical point of the height on its orbit
(`TauCeti.Lie.hasDerivAt_apply_tangentAd_mulInvariantExp_smul_zero_of_lie_eq_zero`), and this is
the value of its Hessian quadratic form on the tangent vector `⁅A, p⁆`. -/
theorem hasDerivAt_deriv_apply_tangentAd_mulInvariantExp_smul_of_lieInvariant
    (hB : B.lieInvariant (GroupLieAlgebra I G)) :
    HasDerivAt
      (deriv fun t : ℝ ↦ B (tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (t • A)) p) X)
      (-B ⁅A, p⁆ ⁅A, X⁆) 0 := by
  rw [← hB]
  exact hasDerivAt_deriv_apply_tangentAd_mulInvariantExp_smul B A p X

/-- **The height Hessian along a root plane.** For an invariant form `B`, a root plane `E` of `t`
with root `α`, `p, X ∈ t` and `A ∈ E`, the second derivative of `B(Ad_(exp tA) p, X)` at `t = 0`
is `-α(p) α(X) B(A, A)`. When `⁅X, p⁆ = 0` (for instance when `t` is abelian), `p` is a critical
point of the height and this is the value of its Hessian quadratic form on `⁅A, p⁆`. -/
theorem hasDerivAt_deriv_apply_tangentAd_mulInvariantExp_smul_of_isRootPlane
    (hB : B.lieInvariant (GroupLieAlgebra I G)) {t : Submodule ℝ (GroupLieAlgebra I G)}
    {α : Module.Dual ℝ t} {V : Submodule ℝ (GroupLieAlgebra I G)} {J : Module.End ℝ V}
    (h : IsRootPlane B t α V J) (p X : t) (A : V) :
    HasDerivAt
      (deriv fun s : ℝ ↦ B (tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (s • (A : _)))
        (p : GroupLieAlgebra I G)) X)
      (-(α p * α X * B A A)) 0 := by
  rw [← h.apply_lie_lie p X A A]
  exact hasDerivAt_deriv_apply_tangentAd_mulInvariantExp_smul_of_lieInvariant B A p X hB

end TauCeti.Lie
