/-!
# The adjoint action on the Lie-group exponential

For a finite-dimensional real Lie group `G` with Lie algebra `𝔤`, the adjoint action of the
exponential of `X ∈ 𝔤` is the operator exponential of `ad X = ⁅X, ·⁆`:

`Ad (lieExp X) = exp (ad X)`.

This is the formula connecting the group adjoint `Ad` to the Lie-algebra adjoint `ad`, stated
here in two forms.  On the tangent space at the identity it reads
`tangentAd (exp X) Y = exp (ad X) Y` (`TauCeti.Lie.tangentAd_mulInvariantExp_apply`).  On
left-invariant derivations, the Lie algebra `LeftInvariantDerivation I G` on which `TauCeti.Lie.Ad`
and `TauCeti.Lie.lieExp` are defined, it is an identity of bounded operators
(`LeftInvariantDerivation.Ad_lieExp`).  The two forms correspond under evaluation at the
identity, which identifies a left-invariant derivation with its tangent vector at `1`, `Ad g`
with `tangentAd g`, and the bracket of derivations with the tangent bracket.

Consequently the one-parameter subgroup of `X` fixes every vector that brackets to zero with `X`;
on left-invariant derivations, derivations that bracket to zero have commuting exponentials, and
the exponential of their sum is the product of their exponentials.

## Main results

* `TauCeti.Lie.hasDerivAt_tangentAd_mulInvariantExp_smul_apply`: the tangent adjoint orbit solves
  the linear differential equation generated by `ad X` at every time.
* `TauCeti.Lie.tangentAd_mulInvariantExp_apply`: the tangent adjoint-exponential formula.
* `TauCeti.Lie.tangentAd_mulInvariantExp_smul_apply_eq_self_of_lie_eq_zero`: the generated
  one-parameter subgroup fixes every tangent vector bracketing to zero with its generator, under
  the tangent adjoint action; `TauCeti.Lie.tangentAd_mulInvariantExp_smul_self` is the case of the
  generator itself.
* `TauCeti.Lie.Ad_lieExp_smul_apply_eq_self_of_lie_eq_zero`,
  `TauCeti.Lie.commute_lieExp_of_lie_eq_zero` and `TauCeti.Lie.lieExp_add_of_lie_eq_zero`: on
  left-invariant derivations, two derivations that bracket to zero generate one-parameter
  subgroups fixing each other under `Ad`, hence commuting, and the exponential of their sum is
  the product of their exponentials.
* `LeftInvariantDerivation.Ad_lieExp`: **the adjoint-exponential formula
  `Ad (lieExp X) = exp (ad X)`** as an identity of bounded operators on left-invariant
  derivations, and `LeftInvariantDerivation.Ad_lieExp_apply` its pointwise form.

## References

* B. C. Hall, *Lie Groups, Lie Algebras, and Representations*, 2nd ed., Springer GTM 222 (2015),
  Chapter 3 (the identity `Ad (exp X) = exp (ad X)` for matrix Lie groups).
* A. Kirillov Jr., *An Introduction to Lie Groups and Lie Algebras*, Cambridge Studies in
  Advanced Mathematics 113 (2008), Chapter 3, Lemma 3.15.
* D. Bump, *Lie Groups*, 2nd ed., Springer GTM 225 (2013), Chapter 15 (Tori), Proposition 15.2.
-/

public section

noncomputable section

namespace TauCeti.Lie

open Set
open scoped ContDiff Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [FiniteDimensional ℝ E] [LieGroup I ∞ G]

attribute [local instance] LieGroup.minSmoothnessThree
attribute [local instance] ContMDiffMul.boundarylessManifold

/-- At every time, the tangent adjoint orbit solves the linear ODE generated by `ad X`. -/
theorem hasDerivAt_tangentAd_mulInvariantExp_smul_apply
    (X Y : GroupLieAlgebra I G) (t : ℝ) :
    let _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
    let f : ℝ → E := fun s => (show E from tangentAd (I := I)
      (mulInvariantExp (I := I) (G := G) (s • X)) Y)
    HasDerivAt f
      ((Module.End.toContinuousLinearMap E)
        ((groupLieAlgebraEquivModelVectorSpace (I := I) (G := G)).conj
          (LieAlgebra.ad ℝ (GroupLieAlgebra I G) X)) (f t)) t := by
  let _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
  dsimp only
  let f : ℝ → E := fun s => (show E from tangentAd (I := I)
    (mulInvariantExp (I := I) (G := G) (s • X)) Y)
  -- The orbit is model-space-valued because `GroupLieAlgebra I G` definitionally reduces to `E`;
  -- the explicit ascriptions below expose that boundary to the normed derivative API.
  have hzero := hasDerivAt_tangentAd_mulInvariantExp_smul_apply_zero
    (I := I) (G := G) X (show GroupLieAlgebra I G from f t)
  have hshift : f = fun s => (show E from tangentAd (I := I)
      (mulInvariantExp (I := I) (G := G) ((s - t) • X))
      (show GroupLieAlgebra I G from f t)) := by
    funext s
    -- Unfold the local orbit `f` and present both tangent values in the model space.
    change (show E from tangentAd (I := I)
        (mulInvariantExp (I := I) (G := G) (s • X)) Y) =
      (show E from tangentAd (I := I)
        (mulInvariantExp (I := I) (G := G) ((s - t) • X))
        (tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (t • X)) Y))
    calc
      _ = (show E from tangentAd (I := I)
          (mulInvariantExp (I := I) (G := G) (((s - t) + t) • X)) Y) := by
        rw [sub_add_cancel]
      _ = (show E from tangentAd (I := I)
          (mulInvariantExp (I := I) (G := G) ((s - t) • X) *
            mulInvariantExp (I := I) (G := G) (t • X)) Y) := by
        rw [mulInvariantExp_add_smul]
      _ = _ := by rw [tangentAd_mul, LieEquiv.trans_apply]
  have hcomp := hzero.scomp_of_eq t ((hasDerivAt_id t).sub_const t) (by simp)
  have hderiv : HasDerivAt
      (fun s => (show E from tangentAd (I := I)
        (mulInvariantExp (I := I) (G := G) ((s - t) • X))
        (show GroupLieAlgebra I G from f t)))
      (show E from LieAlgebra.ad ℝ (GroupLieAlgebra I G) X
        (show GroupLieAlgebra I G from f t)) t := by
    -- Expose the shifted curve produced by scalar composition in the same model-space form.
    change HasDerivAt
      (fun s => (show E from tangentAd (I := I)
        (mulInvariantExp (I := I) (G := G) ((s - t) • X))
        (show GroupLieAlgebra I G from f t))) _ t at hcomp
    convert hcomp using 1
    exact (one_smul ℝ (show E from LieAlgebra.ad ℝ (GroupLieAlgebra I G) X
      (show GroupLieAlgebra I G from f t))).symm
  rw [← hshift] at hderiv
  -- Fold the local orbit and bounded adjoint operator back into the theorem's target.
  change HasDerivAt f
    ((Module.End.toContinuousLinearMap E)
      ((groupLieAlgebraEquivModelVectorSpace (I := I) (G := G)).conj
        (LieAlgebra.ad ℝ (GroupLieAlgebra I G) X)) (f t)) t
  apply hderiv.congr_deriv
  rfl

/-- Applying the tangent operator exponential to `Y` solves the linear ODE generated by `ad X`. -/
private theorem hasDerivAt_exp_adContinuousLinearMap_apply
    (X Y : GroupLieAlgebra I G) (t : ℝ) :
    let A := (Module.End.toContinuousLinearMap E)
      ((groupLieAlgebraEquivModelVectorSpace (I := I) (G := G)).conj
        (LieAlgebra.ad ℝ (GroupLieAlgebra I G) X))
    HasDerivAt (fun s : ℝ => NormedSpace.exp (s • A) (show E from Y))
      (A (NormedSpace.exp (t • A) (show E from Y))) t := by
  dsimp only
  let A := (Module.End.toContinuousLinearMap E)
    ((groupLieAlgebraEquivModelVectorSpace (I := I) (G := G)).conj
      (LieAlgebra.ad ℝ (GroupLieAlgebra I G) X))
  -- `GroupLieAlgebra I G` is definitionally the model space `E`, while the normed operator
  -- exponential and its derivative are stated on `E`.
  have hexp := hasDerivAt_exp_smul_const' A t
  have heval := (ContinuousLinearMap.apply ℝ E (show E from Y)).hasFDerivAt
    |>.comp_hasDerivAt t hexp
  -- Evaluation of the operator exponential has the displayed derivative by definitional
  -- reduction of continuous-linear-map application.
  convert heval using 1 <;> rfl

/-- The tangent adjoint action of `mulInvariantExp X`, evaluated on `Y`, is the operator
exponential of `ad X`. -/
theorem tangentAd_mulInvariantExp_apply (X Y : GroupLieAlgebra I G) :
    let _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
    (show E from tangentAd (I := I) (mulInvariantExp (I := I) (G := G) X) Y) =
      NormedSpace.exp
        ((Module.End.toContinuousLinearMap E)
          ((groupLieAlgebraEquivModelVectorSpace (I := I) (G := G)).conj
            (LieAlgebra.ad ℝ (GroupLieAlgebra I G) X)))
        (show E from Y) := by
  let _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
  dsimp only
  let A := (Module.End.toContinuousLinearMap E)
    ((groupLieAlgebraEquivModelVectorSpace (I := I) (G := G)).conj
      (LieAlgebra.ad ℝ (GroupLieAlgebra I G) X))
  -- `GroupLieAlgebra I G` is definitionally the model space `E`, while the normed operator
  -- exponential is stated on `E`; the explicit ascriptions expose that boundary.
  let f : ℝ → E := fun t => (show E from tangentAd (I := I)
    (mulInvariantExp (I := I) (G := G) (t • X)) Y)
  let g : ℝ → E := fun t => NormedSpace.exp (t • A) (show E from Y)
  have hf (t : ℝ) : HasDerivAt f (A (f t)) t := by
    simpa only [f, A] using
      hasDerivAt_tangentAd_mulInvariantExp_smul_apply (I := I) (G := G) X Y t
  have hg (t : ℝ) : HasDerivAt g (A (g t)) t := by
    simpa only [g, A] using
      hasDerivAt_exp_adContinuousLinearMap_apply (I := I) (G := G) X Y t
  have hv : ∀ _ : ℝ, LipschitzOnWith ‖A‖₊ A univ :=
    fun _ => A.lipschitzWith.lipschitzOnWith
  have hinitial : f 0 = g 0 := by
    dsimp only [f, g]
    -- Expose the two local curve definitions at zero before applying their unit laws.
    change (show E from tangentAd (I := I)
      (mulInvariantExp (I := I) (G := G) (0 • X)) Y) =
      NormedSpace.exp (0 • A) (show E from Y)
    rw [zero_smul, mulInvariantExp_zero, tangentAd_one, LieEquiv.refl_apply]
    rw [zero_smul, NormedSpace.exp_zero, one_apply_eq_self]
  -- Both curves solve the linear ODE generated by `A` with the same initial value, so uniqueness
  -- of solutions identifies them.
  have hfg : f = g := ODE_solution_unique_univ (K := ‖A‖₊)
    (v := fun _ => A) (s := fun _ => univ) (t₀ := 0) hv
    (fun t => ⟨hf t, mem_univ _⟩) (fun t => ⟨hg t, mem_univ _⟩) hinitial
  simpa only [f, g, one_smul, A] using congrFun hfg 1

/-- The tangent adjoint action of the one-parameter subgroup generated by `X` fixes every tangent
vector that brackets to zero with `X`. -/
theorem tangentAd_mulInvariantExp_smul_apply_eq_self_of_lie_eq_zero {X Y : GroupLieAlgebra I G}
    (h : ⁅X, Y⁆ = 0) (t : ℝ) :
    let _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
    tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (t • X)) Y = Y := by
  let _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
  dsimp only
  let A := (Module.End.toContinuousLinearMap E)
    ((groupLieAlgebraEquivModelVectorSpace (I := I) (G := G)).conj
      (LieAlgebra.ad ℝ (GroupLieAlgebra I G) X))
  -- `GroupLieAlgebra I G` is definitionally the model space `E`, and `A` is `ad X` read on `E`
  -- through the identity conjugation, so applying `A` to `Y` is the bracket `⁅X, Y⁆` by
  -- definitional unfolding of `Module.End.toContinuousLinearMap` and `LinearEquiv.conj`.
  have hAY_eq_bracket : A (show E from Y) =
      (show E from LieAlgebra.ad ℝ (GroupLieAlgebra I G) X Y) := by
    rfl
  -- The zeros of `GroupLieAlgebra I G` and of `E` coincide definitionally.
  have hAY : A (show E from Y) = 0 := by
    rw [hAY_eq_bracket, LieAlgebra.ad_apply, h]
    rfl
  -- Restate the goal on `E`, which `GroupLieAlgebra I G` is definitionally, so that it matches
  -- the operator-exponential form `tangentAd_mulInvariantExp_apply`.
  change (show E from tangentAd (I := I)
    (mulInvariantExp (I := I) (G := G) (t • X)) Y) = (show E from Y)
  rw [tangentAd_mulInvariantExp_apply]
  simp only [map_smul]
  -- Re-expose the definitionally equal model representatives so that the eigenvector identity
  -- for the operator exponential matches this tangent-Lie-algebra goal; `Y` is an eigenvector of
  -- `A` with eigenvalue `0`.
  change NormedSpace.exp (t • A) (show E from Y) = (show E from Y)
  have hAY' : A (show E from Y) = (0 : ℝ) • (show E from Y) := by
    rw [zero_smul, hAY]
  rw [ContinuousLinearMap.exp_smul_apply_of_apply_eq_smul A hAY' t, mul_zero,
    NormedSpace.exp_zero, one_smul]

/-- The tangent adjoint action of the one-parameter subgroup generated by `X` fixes `X`. -/
theorem tangentAd_mulInvariantExp_smul_self (X : GroupLieAlgebra I G) (t : ℝ) :
    let _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
    tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (t • X)) X = X :=
  tangentAd_mulInvariantExp_smul_apply_eq_self_of_lie_eq_zero (lie_self X) t

/-! ### Derivations that bracket to zero -/

section Derivations

variable [T2Space G]

/-- **The adjoint action of a one-parameter subgroup fixes a derivation that brackets to zero with
its generator**: if `⁅X, Y⁆ = 0`, then `Ad (lieExp (s • X)) Y = Y` for every `s`. -/
theorem Ad_lieExp_smul_apply_eq_self_of_lie_eq_zero {X Y : LeftInvariantDerivation I G}
    (h : ⁅X, Y⁆ = 0) (s : ℝ) : Ad (I := I) (lieExp (I := I) (s • X)) Y = Y := by
  -- Transport the tangent-level statement along evaluation at the identity.
  refine EquivLike.injective (leftInvariantDerivationLieEquivGroupLieAlgebra (I := I) (G := G)
    (ContMDiffMul.isInteriorPoint (I := I) (n := ∞) (by simp) (1 : G))) ?_
  rw [leftInvariantDerivationLieEquivGroupLieAlgebra_Ad, lieExp_eq_mulInvariantExp, map_smul,
    ← leftInvariantDerivationLieEquivGroupLieAlgebra_apply]
  refine tangentAd_mulInvariantExp_smul_apply_eq_self_of_lie_eq_zero ?_ s
  rw [← LieEquiv.map_lie, h, map_zero]

/-- If `⁅X, Y⁆ = 0`, then `Ad (lieExp X) Y = Y`. -/
theorem Ad_lieExp_apply_eq_self_of_lie_eq_zero {X Y : LeftInvariantDerivation I G}
    (h : ⁅X, Y⁆ = 0) : Ad (I := I) (lieExp (I := I) X) Y = Y := by
  simpa only [one_smul] using Ad_lieExp_smul_apply_eq_self_of_lie_eq_zero h 1

/-- **Derivations that bracket to zero have commuting exponentials.** -/
theorem commute_lieExp_of_lie_eq_zero {X Y : LeftInvariantDerivation I G} (h : ⁅X, Y⁆ = 0) :
    Commute (lieExp (I := I) X) (lieExp (I := I) Y) := by
  have hconj := conj_lieExp (I := I) (lieExp (I := I) X) Y
  rw [Ad_lieExp_apply_eq_self_of_lie_eq_zero h] at hconj
  exact mul_inv_eq_iff_eq_mul.mp hconj

/-- **The exponential of a sum of derivations that bracket to zero is the product of the
exponentials.** -/
theorem lieExp_add_of_lie_eq_zero {X Y : LeftInvariantDerivation I G} (h : ⁅X, Y⁆ = 0) :
    lieExp (I := I) (X + Y) = lieExp (I := I) X * lieExp (I := I) Y :=
  lieExp_add_of_commute (I := I) (G := G) fun _ =>
    commute_lieExp_of_lie_eq_zero (by rw [smul_lie, lie_smul, h, smul_zero, smul_zero])

end Derivations

/-! ### The formula on left-invariant derivations -/

attribute [local instance] TauCeti.normedAlgebraRatOfReal

/-- **The adjoint-exponential formula** `Ad (lieExp X) = exp (ad X)`: the group adjoint of the
Lie-group exponential of a left-invariant derivation `X` is the operator exponential of Mathlib's
Lie-algebra adjoint `ad X = ⁅X, ·⁆`, as bounded operators on `LeftInvariantDerivation I G`. -/
theorem _root_.LeftInvariantDerivation.Ad_lieExp (X : LeftInvariantDerivation I G) :
    let _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
    let _ : FiniteDimensional ℝ (LeftInvariantDerivation I G) :=
      finiteDimensional_leftInvariantDerivation BoundarylessManifold.isInteriorPoint
    (Ad (I := I) (lieExp X)).toLinearEquiv.toContinuousLinearEquiv.toContinuousLinearMap =
      NormedSpace.exp (LinearMap.toContinuousLinearMap
        (LieAlgebra.ad ℝ (LeftInvariantDerivation I G) X)) := by
  let _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
  let _ : FiniteDimensional ℝ (LeftInvariantDerivation I G) :=
    finiteDimensional_leftInvariantDerivation BoundarylessManifold.isInteriorPoint
  dsimp only
  let e := leftInvariantDerivationLinearIsometryEquivModelVectorSpace (I := I) (G := G)
  let ε := leftInvariantDerivationLieEquivGroupLieAlgebra (I := I) (G := G)
    BoundarylessManifold.isInteriorPoint
  -- The tangent-level operator `ad (ε X)`, read on the model space `E`.
  let A := (Module.End.toContinuousLinearMap E)
    ((groupLieAlgebraEquivModelVectorSpace (I := I) (G := G)).conj
      (LieAlgebra.ad ℝ (GroupLieAlgebra I G) (ε X)))
  -- The isometric identification `e` used for the norm and the Lie equivalence `ε` used for the
  -- bracket are the same evaluation at the identity, read in `E` and in `GroupLieAlgebra I G`.
  have he : ∀ Z : LeftInvariantDerivation I G, (e Z : E) = ε Z := fun Z =>
    leftInvariantDerivationLinearIsometryEquivModelVectorSpace_apply_eq_lieEquiv_apply Z
  have had : e.toContinuousLinearEquiv.conjContinuousAlgEquiv (LinearMap.toContinuousLinearMap
      (LieAlgebra.ad ℝ (LeftInvariantDerivation I G) X)) = A := by
    ext Y
    rw [ContinuousLinearEquiv.conjContinuousAlgEquiv_apply_apply]
    simp only [LinearIsometryEquiv.coe_toContinuousLinearEquiv,
      LinearIsometryEquiv.coe_symm_toContinuousLinearEquiv, LinearMap.coe_toContinuousLinearMap',
      LieAlgebra.ad_apply]
    rw [he, LieEquiv.map_lie, ← he (e.symm Y), e.apply_symm_apply]
    -- `A Y` unfolds to the tangent bracket `⁅ε X, Y⁆`, `groupLieAlgebraEquivModelVectorSpace`
    -- being the identity of `E`.
    rfl
  -- Conjugate both sides by `e`: the exponential commutes with conjugation, the conjugate of
  -- `ad X` is `A`, and the conjugate of `Ad (lieExp X)` is the tangent adjoint of the exponential.
  apply e.toContinuousLinearEquiv.conjContinuousAlgEquiv.injective
  have hmap := NormedSpace.map_exp e.toContinuousLinearEquiv.conjContinuousAlgEquiv
    e.toContinuousLinearEquiv.conjContinuousAlgEquiv.continuous
    (LinearMap.toContinuousLinearMap (LieAlgebra.ad ℝ (LeftInvariantDerivation I G) X))
  rw [had] at hmap
  calc
    e.toContinuousLinearEquiv.conjContinuousAlgEquiv
        (Ad (I := I) (lieExp X)).toLinearEquiv.toContinuousLinearEquiv = NormedSpace.exp A := by
      ext Y
      rw [ContinuousLinearEquiv.conjContinuousAlgEquiv_apply_apply]
      simp only [LinearIsometryEquiv.coe_toContinuousLinearEquiv,
        LinearIsometryEquiv.coe_symm_toContinuousLinearEquiv,
        ContinuousLinearEquiv.coe_coe, LinearEquiv.coe_toContinuousLinearEquiv',
        LieEquiv.coe_toLinearEquiv]
      have hAd : e (Ad (I := I) (lieExp X) (e.symm Y)) =
          tangentAd (I := I) (lieExp X) (e (e.symm Y)) :=
        leftInvariantDerivationLinearIsometryEquivModelVectorSpace_Ad _ _
      rw [hAd, e.apply_symm_apply, lieExp_eq_mulInvariantExp,
        ← leftInvariantDerivationLieEquivGroupLieAlgebra_apply]
      exact tangentAd_mulInvariantExp_apply (ε X) Y
    _ = e.toContinuousLinearEquiv.conjContinuousAlgEquiv (NormedSpace.exp
          (LinearMap.toContinuousLinearMap
            (LieAlgebra.ad ℝ (LeftInvariantDerivation I G) X))) := hmap.symm

/-- **The adjoint-exponential formula, pointwise**: `Ad (lieExp X) Y = exp (ad X) Y` for
left-invariant derivations `X` and `Y`. -/
theorem _root_.LeftInvariantDerivation.Ad_lieExp_apply (X Y : LeftInvariantDerivation I G) :
    let _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
    let _ : FiniteDimensional ℝ (LeftInvariantDerivation I G) :=
      finiteDimensional_leftInvariantDerivation BoundarylessManifold.isInteriorPoint
    Ad (I := I) (lieExp X) Y =
      NormedSpace.exp (LinearMap.toContinuousLinearMap
        (LieAlgebra.ad ℝ (LeftInvariantDerivation I G) X)) Y :=
  DFunLike.congr_fun X.Ad_lieExp Y

end TauCeti.Lie
