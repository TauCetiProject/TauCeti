/-!
# The coadjoint stabilizer and its Lie algebra

For `ν ∈ 𝔤*` in the dual of the Lie algebra `𝔤 = GroupLieAlgebra I G` of a Lie group `G`, the
**coadjoint stabilizer** is the stabilizer of `ν` for the coadjoint representation,

`G_ν = {g ∈ G | Ad*_g ν = ν} = {g ∈ G | ν ∘ Ad_g = ν}`,

which is Mathlib's `Representation.stabilizer` of `TauCeti.Lie.coadjointRepresentation`. It is the
isotropy group of the coadjoint action at `ν`, so the coadjoint orbit through `ν` is the homogeneous
space `G / G_ν`; the stabilizer of a translate `Ad*_g ν` is the conjugate `g G_ν g⁻¹`
(`Representation.stabilizer_conj`).

This file proves that `G_ν` is a closed subgroup, hence an embedded Lie subgroup by the
closed-subgroup theorem, and computes its Lie algebra: it is the infinitesimal stabilizer

`𝔤_ν = {ξ ∈ 𝔤 | ⁅ξ, ν⁆ = 0} = {ξ ∈ 𝔤 | ν ⁅ξ, η⁆ = 0 for all η}`,

the kernel of the Kirillov form `ν ⁅·, ·⁆` (`TauCeti.lieAnnihilator`, see
`Module.Dual.ker_kirillovForm`). Consequently the algebraic tangent model `𝔤 ⧸ 𝔤_ν` of the orbit, on
which `Module.Dual.kksSymplecticForm` is the Kirillov–Kostant–Souriau form, is the quotient of `𝔤`
by the Lie algebra of the isotropy group.

The computation of the Lie algebra rests on the derivative of the curve
`t ↦ ν (Ad_{exp (t ξ)} η)`: it is `ν ⁅ξ, Ad_{exp (t ξ)} η⁆` at every time
(`TauCeti.Lie.hasDerivAt_tangentAd_mulInvariantExp_smul_apply`). If the one-parameter subgroup of
`ξ` fixes `ν` the curve is constant, and its derivative at `0` is `ν ⁅ξ, η⁆`; conversely, if
`ν ⁅ξ, ·⁆ = 0` the derivative vanishes identically and the curve is constant.

## Main results

* `TauCeti.Lie.mem_stabilizer_coadjointRepresentation_iff`: `g ∈ G_ν` exactly when
  `ν (Ad_g ξ) = ν ξ` for every `ξ`.
* `TauCeti.Lie.isClosed_stabilizer_coadjointRepresentation`: `G_ν` is closed.
* `TauCeti.Lie.isEmbeddedLieSubgroup_stabilizer_coadjointRepresentation`: `G_ν` is an embedded Lie
  subgroup.
* `TauCeti.Lie.mulInvariantExp_smul_mem_stabilizer_coadjointRepresentation_iff`: the
  one-parameter subgroup generated by `ξ ∈ 𝔤` lies in `G_ν` exactly when `ξ ∈ 𝔤_ν`.
* `TauCeti.Lie.lieSubalgebraOfSubgroup_stabilizer_coadjointRepresentation`: **the Lie algebra of
  `G_ν` is `𝔤_ν`**, transported to left-invariant derivations by evaluation at the identity.

## References

* A. A. Kirillov, *Lectures on the Orbit Method*, Graduate Studies in Mathematics 64, AMS, 2004,
  Section 1.2.
* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Section 22.
-/

public section

noncomputable section

namespace TauCeti.Lie

open scoped Manifold ContDiff

section General

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I 1 G]
  {ν : Module.Dual 𝕜 (GroupLieAlgebra I G)}

/-- An element `g` stabilizes `ν` under the coadjoint action exactly when `ν ∘ Ad_g = ν`. -/
theorem mem_stabilizer_coadjointRepresentation_iff {g : G} :
    g ∈ (coadjointRepresentation 𝕜 I G).stabilizer ν ↔
      ∀ ξ : GroupLieAlgebra I G, ν (adjointContinuousLinearMap (I := I) g ξ) = ν ξ := by
  rw [← Subgroup.inv_mem_iff, Representation.mem_stabilizer, LinearMap.ext_iff]
  simp only [coadjointRepresentation_apply, inv_inv]

end General

section Smooth

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]

variable (I) in
/-- **The coadjoint stabilizer is closed.** For a smooth real Lie group with finite-dimensional
model, `G_ν` is cut out by the continuous equations `(Ad*_g ν) ξ = ν ξ`, one for each `ξ`. -/
theorem isClosed_stabilizer_coadjointRepresentation (ν : Module.Dual ℝ (GroupLieAlgebra I G)) :
    IsClosed ((coadjointRepresentation ℝ I G).stabilizer ν : Set G) := by
  have : CompleteSpace E := FiniteDimensional.complete ℝ E
  have hset : ((coadjointRepresentation ℝ I G).stabilizer ν : Set G) =
      ⋂ ξ : GroupLieAlgebra I G, {g | coadjointRepresentation ℝ I G g ν ξ = ν ξ} := by
    ext g
    simp only [SetLike.mem_coe, Representation.mem_stabilizer, LinearMap.ext_iff, Set.mem_iInter,
      Set.mem_ofPred_eq]
  rw [hset]
  exact isClosed_iInter fun ξ ↦ isClosed_eq
    (contMDiff_coadjointRepresentation_apply ν ξ).continuous continuous_const

variable (I) in
/-- **The coadjoint stabilizer is a Lie group.** By the closed-subgroup theorem, `G_ν` is an
embedded Lie subgroup of `G`. -/
theorem isEmbeddedLieSubgroup_stabilizer_coadjointRepresentation
    (ν : Module.Dual ℝ (GroupLieAlgebra I G)) :
    IsEmbeddedLieSubgroup (I := I) ((coadjointRepresentation ℝ I G).stabilizer ν) :=
  isEmbeddedLieSubgroup_of_isClosed (isClosed_stabilizer_coadjointRepresentation I ν)

variable [T2Space G] {ν : Module.Dual ℝ (GroupLieAlgebra I G)}

/-- **The one-parameter subgroups of the coadjoint stabilizer.** The one-parameter subgroup
`t ↦ exp (t ξ)` generated by `ξ ∈ 𝔤` stabilizes `ν` exactly when `ξ` lies in the infinitesimal
stabilizer `𝔤_ν = {ξ | ⁅ξ, ν⁆ = 0}`, that is, when `ν ⁅ξ, η⁆ = 0` for every `η`. -/
theorem mulInvariantExp_smul_mem_stabilizer_coadjointRepresentation_iff
    {ξ : GroupLieAlgebra I G} :
    (∀ t : ℝ, mulInvariantExp (I := I) (t • ξ) ∈ (coadjointRepresentation ℝ I G).stabilizer ν) ↔
      ξ ∈ lieAnnihilator ℝ (GroupLieAlgebra I G) ν := by
  -- `ν` as a continuous functional on the model space `E`, to which `GroupLieAlgebra I G` reduces
  -- definitionally; the normed derivative API below is stated on `E`.
  let φ : E →L[ℝ] ℝ := LinearMap.toContinuousLinearMap (show E →ₗ[ℝ] ℝ from ν)
  -- The curve `t ↦ ν (Ad_{exp (t ξ)} η)` read through `φ`.
  let f : GroupLieAlgebra I G → ℝ → ℝ := fun η t ↦
    φ (show E from tangentAd (I := I) (mulInvariantExp (I := I) (G := G) (t • ξ)) η)
  have hf (η : GroupLieAlgebra I G) (t : ℝ) :
      f η t = ν (adjointContinuousLinearMap (I := I) (mulInvariantExp (I := I) (t • ξ)) η) := by
    simp only [f, φ, tangentAd_apply]
    -- `φ` is `ν` read on the model space `E`; the two applications agree definitionally.
    rfl
  simp only [mem_stabilizer_coadjointRepresentation_iff, mem_lieAnnihilator, LinearMap.ext_iff,
    Module.Dual.lie_apply, LinearMap.zero_apply, neg_eq_zero, ← hf]
  constructor
  · -- If the curve is constant, its derivative `ν ⁅ξ, η⁆` at `0` vanishes.
    intro h η
    have hderiv : HasDerivAt (f η) (ν ⁅ξ, η⁆) 0 :=
      φ.hasFDerivAt.comp_hasDerivAt 0
        (hasDerivAt_tangentAd_mulInvariantExp_smul_apply_zero (I := I) (G := G) ξ η)
    have hconst : f η = fun _ ↦ ν η := funext fun t ↦ h t η
    rw [hconst] at hderiv
    exact hderiv.unique (hasDerivAt_const 0 (ν η))
  · -- If `ν ⁅ξ, ·⁆ = 0`, the derivative `ν ⁅ξ, Ad_{exp (s ξ)} η⁆` vanishes at every time `s`.
    intro h t η
    have hderiv (s : ℝ) : HasDerivAt (f η) 0 s := by
      have hs := φ.hasFDerivAt.comp_hasDerivAt s
        (hasDerivAt_tangentAd_mulInvariantExp_smul_apply (I := I) (G := G) ξ η s)
      refine hs.congr_deriv ?_
      exact h _
    have hconst := is_const_of_deriv_eq_zero (fun s ↦ (hderiv s).differentiableAt)
      (fun s ↦ (hderiv s).deriv) t 0
    rw [hconst, hf, zero_smul, mulInvariantExp_zero, adjointContinuousLinearMap_one,
      ContinuousLinearMap.id_apply]

/-- **The Lie algebra of the coadjoint stabilizer is the infinitesimal stabilizer.** Under the
identification of left-invariant derivations with `𝔤` by evaluation at the identity, the Lie
algebra `TauCeti.Lie.lieSubalgebraOfSubgroup G_ν` of `G_ν` is `𝔤_ν = {ξ | ⁅ξ, ν⁆ = 0}`. -/
theorem lieSubalgebraOfSubgroup_stabilizer_coadjointRepresentation (h₁ : I.IsInteriorPoint 1) :
    lieSubalgebraOfSubgroup (I := I) ((coadjointRepresentation ℝ I G).stabilizer ν) =
      (lieAnnihilator ℝ (GroupLieAlgebra I G) ν).comap
        (leftInvariantDerivationLieEquivGroupLieAlgebra (I := I) (G := G) h₁).toLieHom := by
  ext X
  rw [mem_lieSubalgebraOfSubgroup (isClosed_stabilizer_coadjointRepresentation I ν),
    LieSubalgebra.mem_comap, LieEquiv.coe_toLieHom,
    leftInvariantDerivationLieEquivGroupLieAlgebra_apply,
    ← mulInvariantExp_smul_mem_stabilizer_coadjointRepresentation_iff]
  simp only [lieExp_eq_mulInvariantExp, map_smul]

end Smooth

end TauCeti.Lie
