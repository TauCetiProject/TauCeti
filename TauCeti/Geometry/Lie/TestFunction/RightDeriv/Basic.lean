/-!
# Right differentiation of test functions on a Lie group

Let `G` be a Lie group modelled on `I`, with Lie algebra `GroupLieAlgebra I G`. For `X` in the Lie
algebra, the right differentiation of a test function is `R(X) a (y) = d/dt|₀ a (y exp(tX))`, the
derivative of `a` along the left-invariant vector field `X^L` generated by `X`, whose flow is right
multiplication by `exp(tX)`. It is the infinitesimal form of the right translation
`R(y) a (x) = a (x * y)` (`TauCeti.LieTestFunction.rightTranslate`), and the counterpart of the
left differentiation `L_X` (`TauCeti.LieTestFunction.leftDeriv`), which differentiates along the
right-invariant vector field.

## Main definitions

* `TauCeti.LieTestFunction.rightDeriv X`: the right differentiation `R(X)` of test functions.

## Main results

* `TauCeti.LieTestFunction.hasDerivAt_apply_mul_mulInvariantExp_smul_zero`,
  `TauCeti.LieTestFunction.hasDerivAt_apply_mulInvariantExp_smul_mul_zero`: over a complete model
  space, right and left differentiation are the derivatives along exponential lines,
  `R(X) a (g) = d/dt|₀ a (g exp(tX))` and `L_X a (g) = d/dt|₀ a (exp(tX) g)`.
* `TauCeti.LieTestFunction.tsupport_rightDeriv_subset`: right differentiation does not enlarge
  supports.
* `TauCeti.LieTestFunction.rightDeriv_add`, `TauCeti.LieTestFunction.rightDeriv_smul`: `R(X)` is
  real linear in `X`.
* `TauCeti.LieTestFunction.rightDeriv_leftTranslate`: right differentiation commutes with left
  translation, `R(X) (L(g) a) = L(g) (R(X) a)`.
* `TauCeti.LieTestFunction.leftDeriv_rightDeriv`: left and right differentiation commute,
  `L_X (R(Y) a) = R(Y) (L_X a)`.
* `TauCeti.LieTestFunction.leftDerivWord_rightDeriv`: iterated left differentiation commutes with
  right differentiation, `L_w (R(X) a) = R(X) (L_w a)`.

## References

* J. Getz, *An introduction to automorphic representations*, course notes, §3.3, pp. 17–18.
-/

public section

noncomputable section

open Function Set
open scoped ContDiff Manifold

namespace TauCeti

namespace LieTestFunction

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]

/-- The **right differentiation** `R(X)` of test functions, `R(X) a (y) = d/dt|₀ a (y exp(tX))`:
the derivative of `a` along the left-invariant vector field generated by `X`, whose value at `y`
is the derivative at `t = 0` of `t ↦ y exp(tX)`. -/
def rightDeriv (X : GroupLieAlgebra I G) : LieTestFunction I G →ₗ[ℂ] LieTestFunction I G :=
  vectorFieldDeriv (mulInvariantVectorField X) (contMDiff_mulInvariantVectorField_infty X)

@[simp]
theorem rightDeriv_apply (X : GroupLieAlgebra I G) (a : LieTestFunction I G) (g : G) :
    rightDeriv X a g = mvfderiv I a g (mulInvariantVectorField X g) :=
  vectorFieldDeriv_apply _ _ a g

/-- Right differentiation does not enlarge the topological support. -/
theorem tsupport_rightDeriv_subset (X : GroupLieAlgebra I G) (a : LieTestFunction I G) :
    tsupport (rightDeriv X a) ⊆ tsupport a :=
  tsupport_vectorFieldDeriv_subset _ _ a

/-- Right differentiation is additive in the Lie algebra element. -/
theorem rightDeriv_add (X Y : GroupLieAlgebra I G) :
    rightDeriv (X + Y) = rightDeriv (I := I) (G := G) X + rightDeriv Y := by
  ext a g
  simp only [rightDeriv_apply, mulInvariantVectorField_add, Pi.add_apply, LinearMap.add_apply,
    add_apply, map_add]

/-- Right differentiation is real homogeneous in the Lie algebra element. -/
theorem rightDeriv_smul (c : ℝ) (X : GroupLieAlgebra I G) :
    rightDeriv (c • X) = (c : ℂ) • rightDeriv (I := I) (G := G) X := by
  ext a g
  simp only [rightDeriv_apply, mulInvariantVectorField_smul, Pi.smul_apply,
    LinearMap.smul_apply, smul_apply, map_smul, Complex.real_smul, smul_eq_mul]

/-- **Right differentiation commutes with left translation**: `R(X) (L(g) a) = L(g) (R(X) a)`,
since left translation preserves left-invariant vector fields. -/
theorem rightDeriv_leftTranslate (X : GroupLieAlgebra I G) (g : G) (a : LieTestFunction I G) :
    rightDeriv X (leftTranslate g a) = leftTranslate g (rightDeriv X a) := by
  ext y
  have hcoe : ⇑(leftTranslate g a) = a ∘ (fun x ↦ g⁻¹ * x) :=
    funext fun x ↦ leftTranslate_apply g a x
  rw [rightDeriv_apply, leftTranslate_apply, rightDeriv_apply, hcoe,
    mvfderiv_comp_apply y (a.contMDiff.mdifferentiableAt (by simp))
      (mdifferentiableAt_mul_left (a := g⁻¹) (b := y)),
    mfderiv_mul_left_mulInvariantVectorField]

/-- Left and right differentiation commute after any real linear functional on `ℂ`: the real
statement `TauCeti.Lie.mvfderiv_mulRightInvariantVectorField_mulInvariantVectorField_commute`
applied to `L ∘ a`. -/
private theorem apply_leftDeriv_rightDeriv [CompleteSpace E] (L : ℂ →L[ℝ] ℝ)
    (X Y : GroupLieAlgebra I G) (a : LieTestFunction I G) (g : G) :
    L (leftDeriv X (rightDeriv Y a) g) = L (rightDeriv Y (leftDeriv X a) g) := by
  let f : C^∞⟮I, G; ℝ⟯ := ⟨L ∘ a, L.contMDiff.comp a.contMDiff⟩
  have hL (b : LieTestFunction I G) (V : (x : G) → TangentSpace I x) (x : G) :
      mvfderiv I (L ∘ b) x (V x) = L (mvfderiv I b x (V x)) :=
    L.mvfderiv_comp_apply (b.contMDiff.mdifferentiableAt (by simp)) _
  have h1 : ⇑(tangentToLeftInvariantDerivation Y f) = L ∘ ⇑(rightDeriv Y a) :=
    funext fun x ↦ by
      rw [tangentToLeftInvariantDerivation_apply, comp_apply, rightDeriv_apply]
      exact hL a (mulInvariantVectorField Y) x
  have h2 : ⇑(rightInvariantDerivative X f) = L ∘ ⇑(leftDeriv X a) :=
    funext fun x ↦ by
      rw [rightInvariantDerivative_apply, comp_apply, leftDeriv_apply]
      exact hL a (mulRightInvariantVectorField X) x
  have h := Lie.mvfderiv_mulRightInvariantVectorField_mulInvariantVectorField_commute f g X Y
  rw [h1, h2, hL (rightDeriv Y a) (mulRightInvariantVectorField X),
    hL (leftDeriv X a) (mulInvariantVectorField Y)] at h
  rwa [leftDeriv_apply, rightDeriv_apply]

/-- **Left and right differentiation commute**: `L_X (R(Y) a) = R(Y) (L_X a)`, since left- and
right-invariant vector fields commute. -/
theorem leftDeriv_rightDeriv [CompleteSpace E] (X Y : GroupLieAlgebra I G)
    (a : LieTestFunction I G) :
    leftDeriv X (rightDeriv Y a) = rightDeriv Y (leftDeriv X a) := by
  ext g
  exact Complex.ext (apply_leftDeriv_rightDeriv Complex.reCLM X Y a g)
    (apply_leftDeriv_rightDeriv Complex.imCLM X Y a g)

/-- Iterated left differentiation commutes with right differentiation:
`L_w (R(X) a) = R(X) (L_w a)`. -/
theorem leftDerivWord_rightDeriv [CompleteSpace E] (w : List (GroupLieAlgebra I G))
    (X : GroupLieAlgebra I G) (a : LieTestFunction I G) :
    leftDerivWord w (rightDeriv X a) = rightDeriv X (leftDerivWord w a) := by
  induction w with
  | nil => simp
  | cons Y w ih => simp only [leftDerivWord_cons, LinearMap.comp_apply, ih, leftDeriv_rightDeriv]

/-! ### Differentiation along exponential lines -/

section ExponentialLine

variable [CompleteSpace E]

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField

local instance instContMDiffMulOneLieTestFunctionRightDeriv : ContMDiffMul I 1 G :=
  ContMDiffMul.of_le (m := 1) (n := ∞) (by norm_num)

local instance instBoundarylessManifoldLieTestFunctionRightDeriv : BoundarylessManifold I G :=
  ContMDiffMul.boundarylessManifold

/-- **Right differentiation is the derivative along right exponential lines**:
`R(X) a (g) = d/dt|₀ a (g exp(tX))`. -/
theorem hasDerivAt_apply_mul_mulInvariantExp_smul_zero (X : GroupLieAlgebra I G)
    (a : LieTestFunction I G) (g : G) :
    let _ : T2Space G := I.t2Space_of_lieGroup ∞
    HasDerivAt (fun t : ℝ ↦ a (g * mulInvariantExp (I := I) (G := G) (t • X)))
      (rightDeriv X a g) 0 := by
  let _ : T2Space G := I.t2Space_of_lieGroup ∞
  rw [rightDeriv_apply]
  exact (a.contMDiff.mdifferentiableAt (x := g) (by simp)).hasMFDerivAt
    |>.hasDerivAt_comp_mul_mulInvariantExp_smul_zero X

/-- **Left differentiation is the derivative along left exponential lines**:
`L_X a (g) = d/dt|₀ a (exp(tX) g)`. -/
theorem hasDerivAt_apply_mulInvariantExp_smul_mul_zero (X : GroupLieAlgebra I G)
    (a : LieTestFunction I G) (g : G) :
    let _ : T2Space G := I.t2Space_of_lieGroup ∞
    HasDerivAt (fun t : ℝ ↦ a (mulInvariantExp (I := I) (G := G) (t • X) * g))
      (leftDeriv X a g) 0 := by
  let _ : T2Space G := I.t2Space_of_lieGroup ∞
  rw [leftDeriv_apply]
  exact (a.contMDiff.mdifferentiableAt (x := g) (by simp)).hasMFDerivAt
    |>.hasDerivAt_comp_mulInvariantExp_smul_mul_zero X

end ExponentialLine

end LieTestFunction

end TauCeti
