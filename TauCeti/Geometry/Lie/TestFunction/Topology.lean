/-!
# The topology of test functions on a Lie group

Let `G` be a Lie group modelled on `I`, with Lie algebra `GroupLieAlgebra I G`, the tangent space
at the identity. For `X` in the Lie algebra, the left differentiation is
`L_X a (y) = d/dt|₀ a (exp(tX) y)`, the derivative of `a` along the right-invariant vector field
`X^R` generated by `X`, whose flow is left multiplication by `exp(tX)`. This file defines `L_X`
on test functions (`TauCeti.LieTestFunction.leftDeriv`) as the derivative along `X^R`, and its
iterates `L_{X_w} = L_{X₁} ⋯ L_{Xₖ}` along words `w = [X₁, …, Xₖ]`
(`TauCeti.LieTestFunction.leftDerivWord`).

For a set `C ⊆ G`, the test functions supported in `C` form the fixed-support space
`TauCeti.LieTestFunction.FixedSupport I G C`. It carries the topology of the seminorms
`a ↦ sup_{g ∈ C} |L_{X_w} a (g)|` (`TauCeti.LieTestFunction.fixedSupportSeminorm`), indexed by all
words `w` in the Lie algebra. The classical definition (Getz, Bernstein–Krötz) indexes them by
words in a basis; since `L_X` is linear in `X` the two families define the same topology, a
comparison not made in this file.
The space of all test functions carries the locally convex final topology of the inclusions of
the fixed-support spaces of the compact subsets of `G`, the LF topology
(`TauCeti.LieTestFunction.instTopologicalSpace`): a linear map out of it into a locally convex
space is continuous exactly when its restriction to every fixed-support space is
(`TauCeti.LieTestFunction.continuous_iff_continuous_comp`).

## Main definitions

* `TauCeti.LieTestFunction.vectorFieldDeriv V hV`: the derivative of test functions along a smooth
  vector field `V`.
* `TauCeti.LieTestFunction.leftDeriv X`: the left differentiation `L_X` of test functions.
* `TauCeti.LieTestFunction.leftDerivWord w`: the iterated left differentiation along a word `w`.
* `TauCeti.LieTestFunction.fixedSupportSeminorm w`: the seminorm `a ↦ sup_g |L_{X_w} a (g)|`.
* `TauCeti.LieTestFunction.supportedIn C`: the test functions supported in `C`.
* `TauCeti.LieTestFunction.FixedSupport I G C`: the fixed-support space with the topology of the
  fixed-support seminorms (`TauCeti.LieTestFunction.FixedSupport.withSeminorms`).
* `TauCeti.LieTestFunction.instTopologicalSpace`: the LF topology on test functions.

## Main results

* `TauCeti.LieTestFunction.tsupport_leftDerivWord_subset`: left differentiation does not enlarge
  supports.
* `TauCeti.LieTestFunction.fixedSupportSeminorm_le_of_tsupport_subset`: on test functions
  supported in `C`, the fixed-support seminorm is bounded by any bound on `C`; with
  `TauCeti.LieTestFunction.norm_leftDerivWord_le`, it is the supremum over `C`.
* `TauCeti.LieTestFunction.FixedSupport.instT1Space`: the fixed-support seminorms separate
  points, so the fixed-support topology is `T₁`, hence Hausdorff as that of a topological group.
* `TauCeti.LieTestFunction.FixedSupport.instLocallyConvexSpace`: the fixed-support topology is
  locally convex.
* `TauCeti.LieTestFunction.FixedSupport.continuous_inclusion`: the inclusions of the
  fixed-support spaces are continuous.
* `TauCeti.LieTestFunction.continuous_iff_continuous_comp`: the continuity criterion for linear
  maps out of the LF topology.
* `TauCeti.LieTestFunction.instContinuousSMul`: test functions form a complex topological vector
  space.

## References

* J. Getz, *An introduction to automorphic representations*, course notes, §3.3, pp. 17–18.
* J. Bernstein, B. Krötz, *Smooth Fréchet globalizations of Harish-Chandra modules*, §2.5,
  pp. 11–12.
-/

public section

noncomputable section

open Function Set TopologicalSpace
open scoped BoundedContinuousFunction ContDiff Manifold Topology

namespace TauCeti

namespace LieTestFunction

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G]

/-! ### Fixed-support spaces -/

variable (I G) in
/-- The test functions supported in a set `C`, as a subspace of all test functions. -/
def supportedIn (C : Set G) : Submodule ℂ (LieTestFunction I G) where
  carrier := {a | tsupport a ⊆ C}
  add_mem' {a b} ha hb := (tsupport_add (f := ⇑a) (g := ⇑b)).trans (union_subset ha hb)
  zero_mem' := by simp
  smul_mem' c a ha := (tsupport_smul_subset_right (fun _ ↦ c) a).trans ha

@[simp]
theorem mem_supportedIn {C : Set G} {a : LieTestFunction I G} :
    a ∈ supportedIn I G C ↔ tsupport a ⊆ C :=
  Iff.rfl

variable (I G) in
/-- The **fixed-support space** `LieTestFunction_C(G)` of test functions supported in `C`. It is a
type synonym for `supportedIn I G C`, carrying the topology of the fixed-support seminorms
(`TauCeti.LieTestFunction.FixedSupport.withSeminorms`) instead of a subspace topology. -/
def FixedSupport (C : Set G) : Type _ :=
  supportedIn I G C

namespace FixedSupport

variable {C : Set G}

instance : AddCommGroup (FixedSupport I G C) :=
  inferInstanceAs (AddCommGroup (supportedIn I G C))

instance : Module ℂ (FixedSupport I G C) :=
  inferInstanceAs (Module ℂ (supportedIn I G C))

instance : Module ℝ (FixedSupport I G C) :=
  inferInstanceAs (Module ℝ (supportedIn I G C))

instance : IsScalarTower ℝ ℂ (FixedSupport I G C) :=
  inferInstanceAs (IsScalarTower ℝ ℂ (supportedIn I G C))

variable (I G C) in
/-- The inclusion of the fixed-support space into all test functions. -/
def inclusion : FixedSupport I G C →ₗ[ℂ] LieTestFunction I G :=
  (supportedIn I G C).subtype

theorem tsupport_inclusion_subset (a : FixedSupport I G C) : tsupport (inclusion I G C a) ⊆ C :=
  -- `FixedSupport I G C` is by definition `supportedIn I G C`, so `a` is a subtype element.
  (show supportedIn I G C from a).property

/-- The element of the fixed-support space given by a test function supported in `C`. -/
def mk (a : LieTestFunction I G) (ha : tsupport a ⊆ C) : FixedSupport I G C :=
  (⟨a, ha⟩ : supportedIn I G C)

@[simp]
theorem inclusion_mk (a : LieTestFunction I G) (ha : tsupport a ⊆ C) :
    inclusion I G C (mk a ha) = a :=
  (rfl)

@[simp]
theorem mk_inclusion (a : FixedSupport I G C) :
    mk (inclusion I G C a) (tsupport_inclusion_subset a) = a :=
  (rfl)

theorem inclusion_injective : Injective (inclusion I G C) :=
  (supportedIn I G C).injective_subtype

@[ext]
theorem ext {a b : FixedSupport I G C} (h : inclusion I G C a = inclusion I G C b) : a = b :=
  inclusion_injective h

end FixedSupport

variable (I G) in
/-- A test function as a bounded continuous function. -/
def toBoundedContinuousFunction : LieTestFunction I G →ₗ[ℂ] G →ᵇ ℂ where
  toFun a := ofCompactSupport a a.continuous a.hasCompactSupport
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp]
theorem toBoundedContinuousFunction_apply (a : LieTestFunction I G) (g : G) :
    toBoundedContinuousFunction I G a g = a g :=
  (rfl)

/-! ### Differentiation along a vector field -/

section VectorFieldDeriv

variable [IsManifold I ∞ G]

/-- The derivative of test functions along a smooth vector field `V`,
`a ↦ (y ↦ da_y (V y))`. The left and right differentiations of test functions on a Lie group
(`TauCeti.LieTestFunction.leftDeriv`, `TauCeti.LieTestFunction.rightDeriv`) are its instances for
the right- and left-invariant vector fields. -/
def vectorFieldDeriv (V : ∀ x : G, TangentSpace I x)
    (hV : ContMDiff I I.tangent ∞ (fun x ↦ (V x : TangentBundle I G))) :
    LieTestFunction I G →ₗ[ℂ] LieTestFunction I G where
  toFun a :=
    { toFun g := mvfderiv I a g (V g)
      contMDiff' := (a.contMDiff.contMDiff_mvfderiv_apply (by simp)).comp hV
      hasCompactSupport' := a.hasCompactSupport.mono'
        (subset_tsupport _ |>.trans (tsupport_mvfderiv_apply_subset a _)) }
  map_add' a b := by
    ext g
    have ha := a.contMDiff.mdifferentiable (by simp) g
    have hb := b.contMDiff.mdifferentiable (by simp) g
    simp only [add_apply, coe_mk, FunLike.coe_add]
    rw [mvfderiv_add ha hb, add_apply]
  map_smul' c a := by
    ext g
    simp only [smul_apply, coe_mk, RingHom.id_apply, FunLike.coe_smul]
    rw [mvfderiv_const_smul_field, smul_apply]

@[simp]
theorem vectorFieldDeriv_apply (V : ∀ x : G, TangentSpace I x)
    (hV : ContMDiff I I.tangent ∞ (fun x ↦ (V x : TangentBundle I G))) (a : LieTestFunction I G)
    (g : G) : vectorFieldDeriv V hV a g = mvfderiv I a g (V g) :=
  (rfl)

/-- Differentiation along a vector field does not enlarge the topological support. -/
theorem tsupport_vectorFieldDeriv_subset (V : ∀ x : G, TangentSpace I x)
    (hV : ContMDiff I I.tangent ∞ (fun x ↦ (V x : TangentBundle I G))) (a : LieTestFunction I G) :
    tsupport (vectorFieldDeriv V hV a) ⊆ tsupport a :=
  tsupport_mvfderiv_apply_subset a V

end VectorFieldDeriv

variable [Group G] [LieGroup I ∞ G]

/-! ### Left differentiation -/

/-- The **left differentiation** `L_X` of test functions, `L_X a (y) = d/dt|₀ a (exp(tX) y)`: the
derivative of `a` along the right-invariant vector field generated by `X`, whose value at `y` is
the derivative at `t = 0` of `t ↦ exp(tX) y`. -/
def leftDeriv (X : GroupLieAlgebra I G) : LieTestFunction I G →ₗ[ℂ] LieTestFunction I G :=
  vectorFieldDeriv (mulRightInvariantVectorField X) (contMDiff_mulRightInvariantVectorField_infty X)

@[simp]
theorem leftDeriv_apply (X : GroupLieAlgebra I G) (a : LieTestFunction I G) (g : G) :
    leftDeriv X a g = mvfderiv I a g (mulRightInvariantVectorField X g) :=
  (rfl)

/-- Left differentiation does not enlarge the topological support. -/
theorem tsupport_leftDeriv_subset (X : GroupLieAlgebra I G) (a : LieTestFunction I G) :
    tsupport (leftDeriv X a) ⊆ tsupport a :=
  tsupport_vectorFieldDeriv_subset _ _ a

/-- Left differentiation is additive in the Lie algebra element. -/
theorem leftDeriv_add (X Y : GroupLieAlgebra I G) :
    leftDeriv (X + Y) = leftDeriv (I := I) (G := G) X + leftDeriv Y := by
  ext a g
  simp only [leftDeriv_apply, mulRightInvariantVectorField_add, Pi.add_apply, LinearMap.add_apply,
    add_apply, map_add]

/-- Left differentiation is real-linear in the Lie algebra element. -/
theorem leftDeriv_smul (c : ℝ) (X : GroupLieAlgebra I G) :
    leftDeriv (c • X) = (c : ℂ) • leftDeriv (I := I) (G := G) X := by
  ext a g
  simp only [leftDeriv_apply, mulRightInvariantVectorField_smul, Pi.smul_apply,
    LinearMap.smul_apply, smul_apply, map_smul, Complex.real_smul, smul_eq_mul]

/-- The iterated left differentiation `L_{X_w} = L_{X₁} ∘ ⋯ ∘ L_{Xₖ}` along a word
`w = [X₁, …, Xₖ]` in the Lie algebra; the empty word gives the identity. -/
def leftDerivWord : List (GroupLieAlgebra I G) → LieTestFunction I G →ₗ[ℂ] LieTestFunction I G
  | [] => LinearMap.id
  | X :: w => leftDeriv X ∘ₗ leftDerivWord w

@[simp]
theorem leftDerivWord_nil : leftDerivWord (I := I) (G := G) [] = LinearMap.id :=
  (rfl)

@[simp]
theorem leftDerivWord_cons (X : GroupLieAlgebra I G) (w : List (GroupLieAlgebra I G)) :
    leftDerivWord (X :: w) = leftDeriv X ∘ₗ leftDerivWord w :=
  (rfl)

/-- Left differentiation along a concatenated word is the composite of the two iterated left
differentiations. -/
theorem leftDerivWord_append (w v : List (GroupLieAlgebra I G)) :
    leftDerivWord (w ++ v) = leftDerivWord w ∘ₗ leftDerivWord v := by
  induction w with
  | nil => rw [List.nil_append, leftDerivWord_nil, LinearMap.id_comp]
  | cons X w ih =>
    rw [List.cons_append, leftDerivWord_cons, leftDerivWord_cons, ih, LinearMap.comp_assoc]

/-- Iterated left differentiation along a word does not enlarge the topological support. -/
theorem tsupport_leftDerivWord_subset (w : List (GroupLieAlgebra I G)) (a : LieTestFunction I G) :
    tsupport (leftDerivWord w a) ⊆ tsupport a := by
  induction w with
  | nil => exact subset_rfl
  | cons X w ih => exact (tsupport_leftDeriv_subset X _).trans ih

/-! ### The fixed-support seminorms -/

/-- The **fixed-support seminorm** `a ↦ sup_g |L_{X_w} a (g)|` of a word `w` in the Lie algebra.
On test functions supported in `C` it is bounded by any bound of `|L_{X_w} a|` on `C`
(`TauCeti.LieTestFunction.fixedSupportSeminorm_le_of_tsupport_subset`); with
`TauCeti.LieTestFunction.norm_leftDerivWord_le`, this makes it the supremum over `C`. -/
def fixedSupportSeminorm (w : List (GroupLieAlgebra I G)) : Seminorm ℂ (LieTestFunction I G) :=
  (normSeminorm ℂ (G →ᵇ ℂ)).comp (toBoundedContinuousFunction I G ∘ₗ leftDerivWord w)

theorem fixedSupportSeminorm_apply (w : List (GroupLieAlgebra I G)) (a : LieTestFunction I G) :
    fixedSupportSeminorm w a = ‖toBoundedContinuousFunction I G (leftDerivWord w a)‖ :=
  (rfl)

/-- The fixed-support seminorm of `L_X a` along `w` is that of `a` along `w ++ [X]`. -/
theorem fixedSupportSeminorm_leftDeriv (w : List (GroupLieAlgebra I G))
    (X : GroupLieAlgebra I G) (a : LieTestFunction I G) :
    fixedSupportSeminorm w (leftDeriv X a) = fixedSupportSeminorm (w ++ [X]) a := by
  simp only [fixedSupportSeminorm_apply, leftDerivWord_append, leftDerivWord_cons,
    leftDerivWord_nil, LinearMap.comp_id, LinearMap.comp_apply]

theorem norm_leftDerivWord_le (w : List (GroupLieAlgebra I G)) (a : LieTestFunction I G)
    (g : G) : ‖leftDerivWord w a g‖ ≤ fixedSupportSeminorm w a :=
  (toBoundedContinuousFunction I G (leftDerivWord w a)).norm_coe_le_norm g

theorem fixedSupportSeminorm_le_iff (w : List (GroupLieAlgebra I G)) (a : LieTestFunction I G)
    {c : ℝ} (hc : 0 ≤ c) :
    fixedSupportSeminorm w a ≤ c ↔ ∀ g, ‖leftDerivWord w a g‖ ≤ c := by
  rw [fixedSupportSeminorm_apply]
  exact BoundedContinuousFunction.norm_le hc

/-- On a test function supported in `C`, the fixed-support seminorm of `w` is bounded by any
bound of `|L_{X_w} a|` on `C`. With `TauCeti.LieTestFunction.norm_leftDerivWord_le`, this makes it
the supremum of `|L_{X_w} a|` over `C`. -/
theorem fixedSupportSeminorm_le_of_tsupport_subset (w : List (GroupLieAlgebra I G))
    {a : LieTestFunction I G} {C : Set G} (ha : tsupport a ⊆ C) {c : ℝ} (hc : 0 ≤ c)
    (h : ∀ g ∈ C, ‖leftDerivWord w a g‖ ≤ c) : fixedSupportSeminorm w a ≤ c := by
  refine (fixedSupportSeminorm_le_iff w a hc).2 fun g ↦ ?_
  by_cases hg : g ∈ C
  · exact h g hg
  · rw [image_eq_zero_of_notMem_tsupport fun hg' ↦ hg (ha (tsupport_leftDerivWord_subset w a hg')),
      norm_zero]
    exact hc

namespace FixedSupport

variable {C : Set G}

variable (I G C) in
/-- The fixed-support seminorms on the fixed-support space, indexed by words in the Lie
algebra. -/
def seminormFamily : SeminormFamily ℂ (FixedSupport I G C) (List (GroupLieAlgebra I G)) :=
  fun w ↦ (fixedSupportSeminorm w).comp (inclusion I G C)

@[simp]
theorem seminormFamily_apply (w : List (GroupLieAlgebra I G)) (a : FixedSupport I G C) :
    seminormFamily I G C w a = fixedSupportSeminorm w (inclusion I G C a) :=
  (rfl)

/-- The topology of the fixed-support space: the topology of the fixed-support seminorms
`seminormFamily I G C`, not the subspace topology from `LieTestFunction I G`. -/
instance instTopologicalSpace : TopologicalSpace (FixedSupport I G C) :=
  (seminormFamily I G C).moduleFilterBasis.topology

variable (I G C) in
/-- The topology of the fixed-support space is induced by the fixed-support seminorms
`seminormFamily I G C` over all words in the Lie algebra. -/
theorem withSeminorms : WithSeminorms (seminormFamily I G C) :=
  ⟨rfl⟩

instance : IsTopologicalAddGroup (FixedSupport I G C) :=
  (withSeminorms I G C).isTopologicalAddGroup

instance : ContinuousSMul ℂ (FixedSupport I G C) :=
  (withSeminorms I G C).continuousSMul

/-- **The fixed-support seminorms separate points**: the seminorm of the empty word is the
supremum norm. -/
instance instT1Space : T1Space (FixedSupport I G C) := by
  refine (withSeminorms I G C).T1_of_separating fun a ha ↦ ⟨[], fun h0 ↦ ha ?_⟩
  refine ext (LieTestFunction.ext fun g ↦ ?_)
  have hg := norm_leftDerivWord_le [] (inclusion I G C a) g
  rw [← seminormFamily_apply, h0] at hg
  simpa using norm_le_zero_iff.mp hg

/-- **The fixed-support topology is locally convex.** -/
instance instLocallyConvexSpace : LocallyConvexSpace ℝ (FixedSupport I G C) :=
  (withSeminorms I G C).toLocallyConvexSpace

end FixedSupport

/-! ### The LF topology -/

variable (I G) in
/-- The inclusions of the fixed-support spaces of the compact subsets of `G`, as real linear maps:
the generating family of the LF topology. -/
def inclusionFamily (C : Compacts G) : FixedSupport I G (C : Set G) →ₗ[ℝ] LieTestFunction I G :=
  (FixedSupport.inclusion I G (C : Set G)).restrictScalars ℝ

/-- The **LF topology** on test functions: the locally convex final topology of the inclusions of
the fixed-support spaces of the compact subsets of `G`. -/
instance instTopologicalSpace : TopologicalSpace (LieTestFunction I G) :=
  finalLocallyConvexTopology (inclusionFamily I G)

/-- The inclusion of the fixed-support space of a compact set is continuous. -/
theorem FixedSupport.continuous_inclusion (C : Compacts G) :
    Continuous (FixedSupport.inclusion I G (C : Set G)) :=
  FinalLocallyConvexTopology.continuous (inclusionFamily I G) C

/-- **The continuity criterion.** A linear map from test functions to a locally convex space is
continuous for the LF topology exactly when its restriction to the fixed-support space of every
compact set is continuous. -/
theorem continuous_iff_continuous_comp {F : Type*} [AddCommGroup F] [Module ℂ F]
    [TopologicalSpace F] [IsTopologicalAddGroup F] [ContinuousSMul ℝ F] [LocallyConvexSpace ℝ F]
    (T : LieTestFunction I G →ₗ[ℂ] F) :
    Continuous T ↔ ∀ C : Compacts G, Continuous (T ∘ₗ FixedSupport.inclusion I G (C : Set G)) :=
  FinalLocallyConvexTopology.continuous_iff_continuous_comp (inclusionFamily I G) T

/-- Test functions form a complex topological vector space. -/
instance instContinuousSMul : ContinuousSMul ℂ (LieTestFunction I G) :=
  FinalLocallyConvexTopology.continuousSMul (inclusionFamily I G) fun C c a ↦
    (FixedSupport.inclusion I G (C : Set G)).map_smul c a

end LieTestFunction

end TauCeti
