module

public import TauCeti.Geometry.Lie.TestFunction.Topology

/-!
# Continuity of operations on test functions on a Lie group

This file proves that the basic operations on test functions on a Lie group `G` are continuous for
the fixed-support topologies and the LF topology of `TauCeti.Geometry.Lie.TestFunction.Topology`,
and that the fixed-support seminorms along words in a basis of the Lie algebra already define the
fixed-support topology.

Left differentiation is linear in the Lie algebra element (`leftDeriv_add`, `leftDeriv_smul`), so
an iterated left differentiation along any word expands into iterated left differentiations along
words in a basis, with coefficients bounded by the coordinates of the letters.

Left differentiation commutes with right translation (`leftDeriv_rightTranslate`): the derivative
of `x ↦ x * g` carries the right-invariant vector field generated by `X` to itself. Hence right
translation preserves every fixed-support seminorm.

## Main definitions

* `TauCeti.LieTestFunction.FixedSupport.inclusionOfSubset`: the continuous inclusion of
  fixed-support spaces for a larger support.
* `TauCeti.LieTestFunction.FixedSupport.leftDeriv`: left differentiation `L_X` as a continuous
  linear map on a fixed-support space.
* `TauCeti.LieTestFunction.FixedSupport.rightTranslate`: right translation by `g` as a continuous
  linear map from the fixed-support space of `C` to that of `C g⁻¹`.

## Main results

* `TauCeti.LieTestFunction.continuous_leftDeriv`,
  `TauCeti.LieTestFunction.continuous_leftDerivWord`,
  `TauCeti.LieTestFunction.continuous_rightTranslate`: continuity for the LF topology.
* `TauCeti.LieTestFunction.FixedSupport.withSeminorms_basis`: the seminorms along words in a basis
  define the fixed-support topology.

## References

* J. Getz, *An introduction to automorphic representations*, course notes, §3.3, pp. 17–18.
-/

public section

noncomputable section

open Function Set TopologicalSpace
open scoped BoundedContinuousFunction ContDiff Manifold Topology Pointwise

namespace TauCeti

namespace LieTestFunction

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]

/-! ### Words and linearity in the Lie algebra -/

/-- Left differentiation along a concatenated word is the composite of the two iterated left
differentiations. -/
theorem leftDerivWord_append (w v : List (GroupLieAlgebra I G)) :
    leftDerivWord (w ++ v) = leftDerivWord w ∘ₗ leftDerivWord v := by
  induction w with
  | nil => rw [List.nil_append, leftDerivWord_nil, LinearMap.id_comp]
  | cons X w ih => rw [List.cons_append, leftDerivWord_cons, leftDerivWord_cons, ih]; rfl

/-- The fixed-support seminorm of `L_X a` along `w` is that of `a` along `w ++ [X]`. -/
theorem fixedSupportSeminorm_leftDeriv (w : List (GroupLieAlgebra I G))
    (X : GroupLieAlgebra I G) (a : LieTestFunction I G) :
    fixedSupportSeminorm w (leftDeriv X a) = fixedSupportSeminorm (w ++ [X]) a := by
  simp only [fixedSupportSeminorm_apply, leftDerivWord_append, leftDerivWord_cons,
    leftDerivWord_nil, LinearMap.comp_id, LinearMap.comp_apply]

/-- Left differentiation is additive in the Lie algebra element. -/
theorem leftDeriv_add (X Y : GroupLieAlgebra I G) :
    leftDeriv (X + Y) = leftDeriv (I := I) (G := G) X + leftDeriv Y := by
  ext a g
  simp only [leftDeriv_apply, mulRightInvariantVectorField_add, Pi.add_apply, LinearMap.add_apply,
    add_apply, map_add]

/-- Left differentiation is real-linear in the Lie algebra element. -/
theorem leftDeriv_smul (c : ℝ) (X : GroupLieAlgebra I G) :
    leftDeriv (c • X) = (c : ℂ) • leftDeriv (I := I) (G := G) X := by
  ext a g
  simp only [leftDeriv_apply, mulRightInvariantVectorField_smul, Pi.smul_apply,
    LinearMap.smul_apply, smul_apply, map_smul, Complex.real_smul, smul_eq_mul]

/-! ### Left differentiation commutes with right translation -/

/-- Right translation carries the right-invariant vector field generated by `X` to itself: the
derivative at `y` of `x ↦ x * g` sends `X^R(y)` to `X^R(y * g)`. -/
theorem mfderiv_mul_right_mulRightInvariantVectorField (X : GroupLieAlgebra I G) (y g : G) :
    mfderiv I I (· * g) y (mulRightInvariantVectorField X y) =
      mulRightInvariantVectorField X (y * g) := by
  rw [mulRightInvariantVectorField_apply, mulRightInvariantVectorField_apply,
    ← mfderiv_comp_apply_of_eq (1 : G) (mdifferentiableAt_mul_right (a := g) (b := y))
      (mdifferentiableAt_mul_right (a := y) (b := 1)) (one_mul y)]
  have h : (· * g) ∘ (· * y) = (fun x : G ↦ x * (y * g)) := by
    ext x
    simp [mul_assoc]
  rw [h]

/-- Left differentiation commutes with right translation: `L_X (R(g) a) = R(g) (L_X a)`. -/
theorem leftDeriv_rightTranslate (X : GroupLieAlgebra I G) (g : G) (a : LieTestFunction I G) :
    leftDeriv X (rightTranslate g a) = rightTranslate g (leftDeriv X a) := by
  ext y
  have hcoe : ⇑(rightTranslate g a) = a ∘ (· * g) := funext fun x ↦ rightTranslate_apply g a x
  rw [leftDeriv_apply, rightTranslate_apply, leftDeriv_apply, hcoe,
    mvfderiv_comp_apply y (a.contMDiff.mdifferentiableAt (by simp))
      (mdifferentiableAt_mul_right (a := g) (b := y)),
    mfderiv_mul_right_mulRightInvariantVectorField]

/-- Iterated left differentiation commutes with right translation. -/
theorem leftDerivWord_rightTranslate (w : List (GroupLieAlgebra I G)) (g : G)
    (a : LieTestFunction I G) :
    leftDerivWord w (rightTranslate g a) = rightTranslate g (leftDerivWord w a) := by
  induction w with
  | nil => simp
  | cons X w ih =>
    rw [leftDerivWord_cons, LinearMap.comp_apply, ih, leftDeriv_rightTranslate,
      LinearMap.comp_apply]

/-- Right translation preserves every fixed-support seminorm. -/
theorem fixedSupportSeminorm_rightTranslate (w : List (GroupLieAlgebra I G)) (g : G)
    (a : LieTestFunction I G) :
    fixedSupportSeminorm w (rightTranslate g a) = fixedSupportSeminorm w a := by
  refine le_antisymm ((fixedSupportSeminorm_le_iff w _ (apply_nonneg _ _)).2 fun x ↦ ?_)
    ((fixedSupportSeminorm_le_iff w _ (apply_nonneg _ _)).2 fun x ↦ ?_)
  · rw [leftDerivWord_rightTranslate, rightTranslate_apply]
    exact norm_leftDerivWord_le w a _
  · have h := norm_leftDerivWord_le w (rightTranslate g a) (x * g⁻¹)
    rwa [leftDerivWord_rightTranslate, rightTranslate_apply, inv_mul_cancel_right] at h

/-! ### Operations on fixed-support spaces -/

namespace FixedSupport

variable {C C' : Set G}

variable (I G) in
/-- The **inclusion** `LieTestFunction_C(G) → LieTestFunction_{C'}(G)` for `C ⊆ C'`, a continuous
linear map: every fixed-support seminorm is unchanged. -/
def inclusionOfSubset (h : C ⊆ C') : FixedSupport I G C →L[ℂ] FixedSupport I G C' :=
  let f : FixedSupport I G C →ₗ[ℂ] FixedSupport I G C' :=
    { toFun a := mk (inclusion I G C a) ((tsupport_inclusion_subset a).trans h)
      map_add' a b := ext (by simp)
      map_smul' c a := ext (by simp) }
  ⟨f, (withSeminorms I G C).continuous_of_isBounded (withSeminorms I G C') f
    (Seminorm.IsBounded.of_real fun w ↦ ⟨{w}, 1, fun a ↦ by simp [f]⟩)⟩

@[simp]
theorem inclusion_inclusionOfSubset (h : C ⊆ C') (a : FixedSupport I G C) :
    inclusion I G C' (inclusionOfSubset I G h a) = inclusion I G C a :=
  inclusion_mk _ _

/-- **Left differentiation** `L_X` on a fixed-support space, a continuous linear map: the
seminorm of `L_X a` along `w` is that of `a` along `w ++ [X]`. -/
def leftDeriv (X : GroupLieAlgebra I G) : FixedSupport I G C →L[ℂ] FixedSupport I G C :=
  let f : FixedSupport I G C →ₗ[ℂ] FixedSupport I G C :=
    { toFun a := mk (LieTestFunction.leftDeriv X (inclusion I G C a))
        ((tsupport_leftDeriv_subset X _).trans (tsupport_inclusion_subset a))
      map_add' a b := ext (by simp)
      map_smul' c a := ext (by simp) }
  ⟨f, (withSeminorms I G C).continuous_of_isBounded (withSeminorms I G C) f
    (Seminorm.IsBounded.of_real fun w ↦ ⟨{w ++ [X]}, 1, fun a ↦ by
      simp [f, fixedSupportSeminorm_leftDeriv]⟩)⟩

@[simp]
theorem inclusion_leftDeriv (X : GroupLieAlgebra I G) (a : FixedSupport I G C) :
    inclusion I G C (leftDeriv X a) = LieTestFunction.leftDeriv X (inclusion I G C a) :=
  inclusion_mk _ _

/-- **Right translation** by `g`, from the fixed-support space of `C` to that of `C g⁻¹`, a
continuous linear map: every fixed-support seminorm is unchanged. -/
def rightTranslate (g : G) :
    FixedSupport I G C →L[ℂ] FixedSupport I G (MulOpposite.op g⁻¹ • C) :=
  let f : FixedSupport I G C →ₗ[ℂ] FixedSupport I G (MulOpposite.op g⁻¹ • C) :=
    { toFun a := mk (LieTestFunction.rightTranslate g (inclusion I G C a)) (by
        rw [tsupport_rightTranslate]
        exact Set.smul_set_mono (tsupport_inclusion_subset a))
      map_add' a b := ext (by simp)
      map_smul' c a := ext (by simp) }
  ⟨f, (withSeminorms I G C).continuous_of_isBounded (withSeminorms I G _) f
    (Seminorm.IsBounded.of_real fun w ↦ ⟨{w}, 1, fun a ↦ by
      simp [f, fixedSupportSeminorm_rightTranslate]⟩)⟩

theorem inclusion_rightTranslate (g : G) (a : FixedSupport I G C) :
    inclusion I G (MulOpposite.op g⁻¹ • C) (rightTranslate g a) =
      LieTestFunction.rightTranslate g (inclusion I G C a) :=
  inclusion_mk _ _

end FixedSupport

/-! ### Continuity for the LF topology -/

/-- Left differentiation `L_X` is continuous for the LF topology. -/
theorem continuous_leftDeriv (X : GroupLieAlgebra I G) :
    Continuous (leftDeriv (I := I) (G := G) X) := by
  refine (continuous_iff_continuous_comp _).2 fun C ↦ ?_
  have h : leftDeriv X ∘ₗ FixedSupport.inclusion I G (C : Set G) =
      FixedSupport.inclusion I G (C : Set G) ∘ₗ (FixedSupport.leftDeriv X).toLinearMap :=
    LinearMap.ext fun a ↦ (FixedSupport.inclusion_leftDeriv X a).symm
  rw [h]
  exact (FixedSupport.continuous_inclusion C).comp (FixedSupport.leftDeriv X).continuous

/-- Iterated left differentiation `L_{X_w}` is continuous for the LF topology. -/
theorem continuous_leftDerivWord (w : List (GroupLieAlgebra I G)) :
    Continuous (leftDerivWord (I := I) (G := G) w) := by
  induction w with
  | nil =>
    rw [leftDerivWord_nil, LinearMap.id_coe]
    exact continuous_id
  | cons X w ih =>
    rw [leftDerivWord_cons, LinearMap.coe_comp]
    exact (continuous_leftDeriv X).comp ih

/-- Right translation is continuous for the LF topology. -/
theorem continuous_rightTranslate (g : G) :
    Continuous (rightTranslate (I := I) (G := G) g) := by
  have := topologicalGroup_of_lieGroup I ∞ (G := G)
  refine (continuous_iff_continuous_comp _).2 fun C ↦ ?_
  let C' : Compacts G := ⟨MulOpposite.op g⁻¹ • (C : Set G), C.isCompact.smul _⟩
  have h : rightTranslate g ∘ₗ FixedSupport.inclusion I G (C : Set G) =
      FixedSupport.inclusion I G (C' : Set G) ∘ₗ
        (FixedSupport.rightTranslate (C := (C : Set G)) g).toLinearMap :=
    LinearMap.ext fun a ↦ (FixedSupport.inclusion_rightTranslate g a).symm
  rw [h]
  exact (FixedSupport.continuous_inclusion C').comp (FixedSupport.rightTranslate g).continuous

/-! ### Seminorms along words in a basis -/

/-- Left differentiation along `X` expands in a basis of the Lie algebra. -/
theorem leftDeriv_eq_sum_basis {ι : Type*} [Fintype ι]
    (b : Module.Basis ι ℝ (GroupLieAlgebra I G)) (X : GroupLieAlgebra I G) :
    leftDeriv (I := I) (G := G) X = ∑ i, ((b.repr X i : ℝ) : ℂ) • leftDeriv (b i) := by
  have h := map_sum (AddMonoidHom.mk' (leftDeriv (I := I) (G := G)) leftDeriv_add)
    (fun i ↦ b.repr X i • b i) Finset.univ
  simp only [AddMonoidHom.mk'_apply, b.sum_repr] at h
  rw [h]
  simp only [leftDeriv_smul]

/-- A fixed-support seminorm along any word `u ++ w` whose prefix `u` is a word in a basis `b` of
the Lie algebra is bounded by finitely many fixed-support seminorms along words in `b`. -/
theorem exists_fixedSupportSeminorm_le_basis {ι : Type*} [Finite ι]
    (b : Module.Basis ι ℝ (GroupLieAlgebra I G)) (w : List (GroupLieAlgebra I G)) (u : List ι) :
    ∃ (s : Finset (List ι)) (C : ℝ), 0 ≤ C ∧ ∀ (a : LieTestFunction I G) (M : ℝ), 0 ≤ M →
      (∀ v ∈ s, fixedSupportSeminorm (v.map b) a ≤ M) →
        fixedSupportSeminorm (u.map b ++ w) a ≤ C * M := by
  classical
  have := Fintype.ofFinite ι
  induction w generalizing u with
  | nil =>
    exact ⟨{u}, 1, zero_le_one, fun a M _ h ↦ by simpa using h u (Finset.mem_singleton_self u)⟩
  | cons X w ih =>
    choose s C hC h using fun i : ι ↦ ih (u ++ [i])
    refine ⟨Finset.univ.biUnion s, ∑ i, ‖b.repr X i‖ * C i,
      Finset.sum_nonneg fun i _ ↦ mul_nonneg (norm_nonneg _) (hC i), fun a M hM hs ↦ ?_⟩
    have hword : leftDerivWord (u.map b ++ X :: w) a =
        ∑ i, ((b.repr X i : ℝ) : ℂ) • leftDerivWord ((u ++ [i]).map b ++ w) a := by
      simp only [leftDerivWord_append, LinearMap.comp_apply, leftDerivWord_cons,
        leftDeriv_eq_sum_basis b X, List.map_append, List.map_cons, List.map_nil,
        List.append_assoc, List.cons_append, List.nil_append, LinearMap.sum_apply,
        LinearMap.smul_apply, map_sum, map_smul]
    rw [fixedSupportSeminorm_apply, hword, map_sum]
    calc ‖∑ i, toBoundedContinuousFunction I G
          (((b.repr X i : ℝ) : ℂ) • leftDerivWord ((u ++ [i]).map b ++ w) a)‖
        ≤ ∑ i, ‖toBoundedContinuousFunction I G
          (((b.repr X i : ℝ) : ℂ) • leftDerivWord ((u ++ [i]).map b ++ w) a)‖ :=
          norm_sum_le _ _
      _ ≤ ∑ i, ‖b.repr X i‖ * (C i * M) := Finset.sum_le_sum fun i _ ↦ by
          rw [map_smul, norm_smul, Complex.norm_real, ← fixedSupportSeminorm_apply]
          exact mul_le_mul_of_nonneg_left (h i a M hM fun v hv ↦
            hs v (Finset.mem_biUnion.2 ⟨i, Finset.mem_univ _, hv⟩)) (norm_nonneg _)
      _ = (∑ i, ‖b.repr X i‖ * C i) * M := by
          rw [Finset.sum_mul]
          exact Finset.sum_congr rfl fun i _ ↦ (mul_assoc _ _ _).symm

/-- **Basis words suffice.** For a basis `b` of the Lie algebra, the fixed-support seminorms along
the words in `b` alone define the topology of the fixed-support space: since `L_X` is linear in
`X`, every word expands into basis words. -/
theorem FixedSupport.withSeminorms_basis {C : Set G} {ι : Type*} [Finite ι]
    (b : Module.Basis ι ℝ (GroupLieAlgebra I G)) :
    WithSeminorms fun v : List ι ↦ FixedSupport.seminormFamily I G C (v.map b) := by
  refine (FixedSupport.withSeminorms I G C).congr
    (Seminorm.IsBounded.of_real fun v ↦ ⟨{v.map b}, 1, fun a ↦ by simp⟩)
    (Seminorm.IsBounded.of_real fun w ↦ ?_)
  obtain ⟨s, K, -, h⟩ := exists_fixedSupportSeminorm_le_basis b w []
  refine ⟨s, K, fun a ↦ ?_⟩
  simpa using h (FixedSupport.inclusion I G C a) _ (apply_nonneg _ _) fun v hv ↦
    (FixedSupport.seminormFamily_apply _ a).symm.trans_le (Seminorm.le_finset_sup_apply
      (p := fun v : List ι ↦ FixedSupport.seminormFamily I G C (v.map b)) (x := a) hv)

end LieTestFunction

end TauCeti
