/-!
# Fundamental vector fields of Lie group actions

Let a Lie group `G` act on the left on a manifold `M`. Every element `ξ` of the tangent Lie algebra
`GroupLieAlgebra I G` generates the **fundamental vector field** (or infinitesimal generator)
`ξ_M`, whose value at `x` is the derivative at the identity of the orbit map `g ↦ g • x` applied
to `ξ`. These are the vector fields through which a group action enters infinitesimal
constructions, such as the defining equation `d⟨μ, ξ⟩ = ι_{ξ_M} ω` of a moment map.

## Main definitions

* `TauCeti.fundamentalVectorField I' ξ`: the fundamental vector field `ξ_M` on `M`.
* `TauCeti.InfinitesimalAction.fundamental I G I' M`: for a smooth action of a real Lie group,
  the infinitesimal action `ξ ↦ ξ_M` of its Lie algebra by fundamental vector fields.

## Main results

* `TauCeti.fundamentalVectorField_add`, `TauCeti.fundamentalVectorField_smul`: `ξ ↦ ξ_M` is
  linear.
* `TauCeti.contMDiff_fundamentalVectorField`: for a `C^n` action, `ξ_M` is a `C^m` vector field
  whenever `m + 1 ≤ n`.
* `TauCeti.fundamentalVectorField_eq_zero_of_forall_smul_eq`: `ξ_M` vanishes at fixed points.
* `TauCeti.fundamentalVectorField_eq_mulRightInvariantVectorField`: for the action of `G` on
  itself by left multiplication, `ξ_G` is the right-invariant vector field generated by `ξ`.
* `TauCeti.mfderiv_smul_mulRightInvariantVectorField`: each orbit map `g ↦ g • x` relates the
  right-invariant vector field of `ξ` on `G` to `ξ_M`.
* `TauCeti.mfderiv_smul_fundamentalVectorField`: equivariance, `g_* ξ_M = (Ad_g ξ)_M`.
* `TauCeti.isMIntegralCurve_mulInvariantExp_smul_smul`: the curve `t ↦ exp(t ξ) • x` is an
  integral curve of `ξ_M`, so `ξ_M` generates the flow `(t, x) ↦ exp(t ξ) • x`.
* `TauCeti.mlieBracket_fundamentalVectorField`: `[ξ_M, η_M] = -⁅ξ, η⁆_M`, so `ξ ↦ ξ_M` is an
  antihomomorphism of Lie algebras.

## References

* John M. Lee, *Introduction to Smooth Manifolds*, second edition, Chapter 20, infinitesimal
  generators of Lie group actions.
* Jerrold Marsden and Tudor Ratiu, *Introduction to Mechanics and Symmetry*, second edition, §9.3.
  The bracket identity `[ξ_M, η_M] = -⁅ξ, η⁆_M` appears there and in Lee, Chapter 20; the proof
  here pushes the bracket of right-invariant vector fields forward along an orbit map.
* The smoothness proof adapts Sébastien Gouëzel's proof of Mathlib's
  `contMDiff_mulInvariantVectorField`, as already adapted in
  `contMDiff_mulInvariantVectorField_modelSpace`.
-/

public section

noncomputable section

open Bundle Function Manifold
open scoped ContDiff Manifold

namespace TauCeti

section Field

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  {E' : Type*} [NormedAddCommGroup E'] [NormedSpace 𝕜 E']
  {H' : Type*} [TopologicalSpace H'] {I' : ModelWithCorners 𝕜 E' H'}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H' M] [MulAction G M]

variable (I') in
/-- The fundamental vector field `ξ_M` generated by `ξ` for a left action of `G` on `M`: its value
at `x` is the derivative at the identity of the orbit map `g ↦ g • x`, applied to `ξ`. -/
def fundamentalVectorField (ξ : GroupLieAlgebra I G) (x : M) : TangentSpace I' x :=
  mfderiv I I' (fun g : G => g • x) 1 ξ

/-- The value of `ξ_M` at `x` is the derivative of the orbit map of `x` applied to `ξ`. -/
theorem fundamentalVectorField_apply (ξ : GroupLieAlgebra I G) (x : M) :
    fundamentalVectorField I' ξ x = mfderiv I I' (fun g : G => g • x) 1 ξ :=
  (rfl)

/-- The zero element of the Lie algebra generates the zero vector field. -/
@[simp]
theorem fundamentalVectorField_zero :
    fundamentalVectorField I' (0 : GroupLieAlgebra I G) = (0 : (x : M) → TangentSpace I' x) := by
  ext x
  simp only [fundamentalVectorField_apply, map_zero]
  -- `TangentSpace I' x` inherits its zero from the model space `E'`.
  exact Eq.refl _

/-- The fundamental vector field of a sum is the sum of the fundamental vector fields. -/
theorem fundamentalVectorField_add (ξ η : GroupLieAlgebra I G) :
    fundamentalVectorField I' (ξ + η) =
      fundamentalVectorField I' ξ +
        (fundamentalVectorField I' η : (x : M) → TangentSpace I' x) := by
  ext x
  simp only [Pi.add_apply, fundamentalVectorField_apply, map_add]
  -- `TangentSpace I' x` inherits its addition from the model space `E'`.
  exact Eq.refl _

/-- The fundamental vector field construction commutes with scalar multiplication. -/
theorem fundamentalVectorField_smul (c : 𝕜) (ξ : GroupLieAlgebra I G) :
    fundamentalVectorField I' (c • ξ) =
      c • (fundamentalVectorField I' ξ : (x : M) → TangentSpace I' x) := by
  ext x
  simp only [Pi.smul_apply, fundamentalVectorField_apply, map_smul]
  -- `TangentSpace I' x` inherits its scalar multiplication from the model space `E'`.
  exact Eq.refl _

/-- The fundamental vector field of `-ξ` is the negative of that of `ξ`. -/
theorem fundamentalVectorField_neg (ξ : GroupLieAlgebra I G) :
    fundamentalVectorField I' (-ξ) =
      -(fundamentalVectorField I' ξ : (x : M) → TangentSpace I' x) := by
  ext x
  simp only [Pi.neg_apply, fundamentalVectorField_apply, map_neg]
  -- `TangentSpace I' x` inherits its negation from the model space `E'`.
  exact Eq.refl _

/-- Fundamental vector fields vanish at points fixed by the whole group. -/
theorem fundamentalVectorField_eq_zero_of_forall_smul_eq {x : M} (hx : ∀ g : G, g • x = x)
    (ξ : GroupLieAlgebra I G) : fundamentalVectorField I' ξ x = 0 := by
  rw [fundamentalVectorField_apply, show (fun g : G => g • x) = fun _ => x from funext hx,
    mfderiv_const]
  -- The zero continuous linear map evaluates to zero by definition.
  rfl

/-- For the action of `G` on itself by left multiplication, the fundamental vector field of `ξ` is
the right-invariant vector field generated by `ξ`. -/
theorem fundamentalVectorField_eq_mulRightInvariantVectorField (ξ : GroupLieAlgebra I G) :
    fundamentalVectorField I ξ = mulRightInvariantVectorField (I := I) ξ := by
  funext g
  rw [fundamentalVectorField_apply, mulRightInvariantVectorField_apply]
  -- Left multiplication `h • g` is `h * g` by definition of the action of a monoid on itself.
  rfl

/-- For a `C^n` action, the fundamental vector field of `ξ` is a `C^m` vector field when
`m + 1 ≤ n`. -/
theorem contMDiff_fundamentalVectorField {m n : ℕ∞ω} [IsManifold I 1 G] [IsManifold I' 1 M]
    [ContMDiffSMul I I' n G M] (hmn : m + 1 ≤ n) (ξ : GroupLieAlgebra I G) :
    ContMDiff I' I'.tangent m
      (fun x : M => (⟨x, fundamentalVectorField I' ξ x⟩ : TangentBundle I' M)) := by
  /- The value at `x` is the tangent map of the action `A : G × M → M` applied to the tangent
  vector `(ξ, 0)` at `(1, x)`, and the tangent map of a `C^n` map is `C^m`. -/
  have hA : ContMDiff (I.prod I') I' n (fun p : G × M => p.1 • p.2) :=
    ContMDiffSMul.contMDiff_smul
  have hT := (hA.contMDiff_tangentMap hmn).comp
    (contMDiff_equivTangentBundleProd_symm (I := I) (M := G) (I' := I') (M' := M))
  have hF : ContMDiff I' (I.tangent.prod I'.tangent) m
      (fun x : M => ((⟨1, ξ⟩ : TangentBundle I G), (⟨x, 0⟩ : TangentBundle I' M))) :=
    (contMDiff_tangentBundle_mk_constBase contMDiff_const (1 : G)).prodMk
      (contMDiff_tangentBundle_mk_zero contMDiff_id)
  refine (hT.comp hF).congr fun x => ?_
  have hdiff : MDifferentiableAt (I.prod I') I' (fun p : G × M => p.1 • p.2) (1, x) :=
    (hA.of_le (le_add_self.trans hmn)).mdifferentiableAt one_ne_zero
  have key : mfderiv (I.prod I') I' (fun p : G × M => p.1 • p.2) (1, x) (ξ, 0) =
      fundamentalVectorField I' ξ x := by
    refine (mfderiv_prod_eq_add_apply (v := ((ξ, 0) : E × E')) hdiff).trans ?_
    have h0 : mfderiv I' I' (fun z : M => (1 : G) • z) x (0 : E') = 0 :=
      ContinuousLinearMap.map_zero _
    dsimp only
    rw [h0, add_zero, fundamentalVectorField_apply]
  simp +instances only [comp_apply, tangentMap, equivTangentBundleProd, Equiv.coe_fn_symm_mk]
  -- The base point of the computed tangent vector is `1 • x`; generalize it to avoid a dependent
  -- rewrite.
  have hmk : ∀ (y : M) (v : E'), y = x → v = fundamentalVectorField I' ξ x →
      (⟨x, fundamentalVectorField I' ξ x⟩ : TangentBundle I' M) = ⟨y, v⟩ := by
    rintro y v rfl rfl
    rfl
  exact hmk _ _ (one_smul G x) key

/-- Each orbit map `h ↦ h • x` relates the right-invariant vector field of `ξ` on `G` to the
fundamental vector field `ξ_M`. -/
theorem mfderiv_smul_mulRightInvariantVectorField [ContMDiffMul I 1 G] [ContMDiffSMul I I' 1 G M]
    (ξ : GroupLieAlgebra I G) (g : G) (x : M) :
    mfderiv I I' (fun h : G => h • x) g (mulRightInvariantVectorField ξ g) =
      fundamentalVectorField I' ξ (g • x) := by
  have horbit (y : M) (h : G) : MDifferentiableAt I I' (fun k : G => k • y) h :=
    (ContMDiffSMul.contMDiff_smul_const (n := 1) y).mdifferentiableAt one_ne_zero
  rw [mulRightInvariantVectorField_apply, fundamentalVectorField_apply,
    ← mfderiv_comp_apply_of_eq (1 : G) (horbit x g) mdifferentiableAt_mul_right (one_mul g)]
  congr 2
  funext h
  simp [mul_smul]

end Field

section Bracket

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E] [CompleteSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I (minSmoothness 𝕜 3) G]
  {E' : Type*} [NormedAddCommGroup E'] [NormedSpace 𝕜 E'] [CompleteSpace E']
  {H' : Type*} [TopologicalSpace H'] {I' : ModelWithCorners 𝕜 E' H'}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H' M] [IsManifold I' (minSmoothness 𝕜 2) M]
  [MulAction G M] [ContMDiffSMul I I' (minSmoothness 𝕜 2) G M]

/-- **Fundamental vector fields form an antihomomorphism.** For a `C²` left action of a Lie group,
the Lie bracket of fundamental vector fields is `[ξ_M, η_M] = -⁅ξ, η⁆_M`. -/
theorem mlieBracket_fundamentalVectorField (ξ η : GroupLieAlgebra I G) :
    VectorField.mlieBracket I' (fundamentalVectorField (M := M) I' ξ)
        (fundamentalVectorField I' η) = -fundamentalVectorField I' ⁅ξ, η⁆ := by
  /- The orbit map `g ↦ g • x` relates the right-invariant vector fields `ξ^R, η^R` on `G` to
  `ξ_M, η_M`, so it carries `[ξ^R, η^R] 1 = -⁅ξ, η⁆` to `[ξ_M, η_M] x`. -/
  have h1 : (1 : ℕ∞ω) ≤ minSmoothness 𝕜 2 :=
    (show (1 : ℕ∞ω) ≤ 2 by norm_num).trans le_minSmoothness
  have h2 : (1 : ℕ∞ω) + 1 ≤ minSmoothness 𝕜 2 :=
    (show (1 : ℕ∞ω) + 1 ≤ 2 by norm_num).trans le_minSmoothness
  have : LieGroup I 1 G := LieGroup.of_le (I := I) (G := G) (m := 1) (n := minSmoothness 𝕜 3)
    ((show (1 : ℕ∞ω) ≤ 3 by norm_num).trans le_minSmoothness)
  have : IsManifold I' 1 M := .of_le h1
  have : ContMDiffSMul I I' 1 G M := ContMDiffSMul.of_le (M := M) h1
  have hfield (u : GroupLieAlgebra I G) (x : M) :
      MDifferentiableAt I' I'.tangent
        (fun y : M => (fundamentalVectorField I' u y : TangentBundle I' M)) x :=
    (contMDiff_fundamentalVectorField h2 u x).mdifferentiableAt one_ne_zero
  funext x
  have h := mfderiv_mlieBracket_of_eventually_related
    (ContMDiffSMul.contMDiff_smul_const (I := I) (I' := I') x 1) le_rfl
    (GroupLieAlgebra.mdifferentiableAt_mulRightInvariantVectorField ξ)
    (GroupLieAlgebra.mdifferentiableAt_mulRightInvariantVectorField η) (hfield ξ _) (hfield η _)
    (Filter.Eventually.of_forall fun g => mfderiv_smul_mulRightInvariantVectorField ξ g x)
    (Filter.Eventually.of_forall fun g => mfderiv_smul_mulRightInvariantVectorField η g x)
  rw [GroupLieAlgebra.mlieBracket_mulRightInvariantVectorField, Pi.neg_apply, map_neg,
    mulRightInvariantVectorField_one, ← fundamentalVectorField_apply] at h
  -- The tangent spaces of `M` are all the model space `E'`, so the bracket can be transported
  -- along `1 • x = x` as an `E'`-valued function.
  exact (congrArg (fun y : M => (VectorField.mlieBracket I' (fundamentalVectorField I' ξ)
    (fundamentalVectorField I' η) y : E')) (one_smul G x).symm).trans h.symm

end Bracket

section Real

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
  {H' : Type*} [TopologicalSpace H'] {I' : ModelWithCorners ℝ E' H'}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H' M] [MulAction G M]
  [ContMDiffSMul I I' 1 G M]

/-- **Equivariance of fundamental vector fields.** The derivative of `y ↦ g • y` carries the
fundamental vector field of `ξ` to that of `Ad_g ξ`. -/
theorem mfderiv_smul_fundamentalVectorField [LieGroup I 1 G] (g : G) (ξ : GroupLieAlgebra I G)
    (x : M) :
    mfderiv I' I' (fun y : M => g • y) x (fundamentalVectorField I' ξ x) =
      fundamentalVectorField I' (Lie.adjointContinuousLinearMap g ξ) (g • x) := by
  have horbit (y : M) (h : G) : MDifferentiableAt I I' (fun k : G => k • y) h :=
    (ContMDiffSMul.contMDiff_smul_const (n := 1) y).mdifferentiableAt one_ne_zero
  have hconj : MDifferentiableAt I I (Lie.conjDiffeomorph (I := I) (n := 1) g) 1 :=
    (Lie.conjDiffeomorph (I := I) (n := 1) g).mdifferentiable one_ne_zero _
  have hsmul : MDifferentiableAt I' I' (fun y : M => g • y) x :=
    (ContMDiffSMul.contMDiff_const_smul (I := I) (I' := I') (n := 1) g).mdifferentiableAt
      one_ne_zero
  have hfun : ((fun y : M => g • y) ∘ fun h : G => h • x) =
      (fun h : G => h • g • x) ∘ Lie.conjDiffeomorph (I := I) (n := 1) g := by
    funext h
    simp [mul_smul]
  rw [Lie.adjointContinuousLinearMap_apply]
  exact (mfderiv_comp_apply_of_eq (1 : G) hsmul (horbit x 1) (one_smul G x) ξ).symm.trans
    ((DFunLike.congr_fun (mfderiv_congr (I := I) (I' := I') (x := (1 : G)) hfun) ξ).trans
      (mfderiv_comp_apply_of_eq (1 : G) (horbit (g • x) 1) hconj
        (by simp : Lie.conjDiffeomorph (I := I) (n := 1) g 1 = 1) ξ))

/-- **The exponential flow.** For every `x`, the curve `t ↦ exp(t ξ) • x` is an integral curve of
the fundamental vector field `ξ_M`. -/
theorem isMIntegralCurve_mulInvariantExp_smul_smul [CompleteSpace E]
    [LieGroup I (minSmoothness ℝ 3) G] [IsManifold I 1 G] [T2Space G] [BoundarylessManifold I G]
    (ξ : GroupLieAlgebra I G) (x : M) :
    IsMIntegralCurve (fun t : ℝ => mulInvariantExp (t • ξ) • x) (fundamentalVectorField I' ξ) := by
  have horbit (y : M) (h : G) : MDifferentiableAt I I' (fun k : G => k • y) h :=
    (ContMDiffSMul.contMDiff_smul_const (n := 1) y).mdifferentiableAt one_ne_zero
  intro t
  set y := mulInvariantExp (t • ξ) • x
  /- Near time `t` the curve is `s ↦ exp((s - t) ξ) • y`: the exponential line, shifted by `t`,
  followed by the orbit map of `y`. -/
  have hshift : HasMFDerivAt 𝓘(ℝ, ℝ) 𝓘(ℝ, ℝ) (fun s : ℝ => s - t) t
      (ContinuousLinearMap.id ℝ ℝ) :=
    ((hasFDerivAt_id t).sub_const t).hasMFDerivAt
  have hline := hasMFDerivAt_mulInvariantExp_smul (I := I) (G := G) ξ (t - t)
  have hcurve := (horbit y (mulInvariantExp ((t - t) • ξ))).hasMFDerivAt.comp t
    (hline.comp (f := fun s : ℝ => s - t) t hshift)
  have hfun : ((fun g : G => g • y) ∘ (fun s : ℝ => mulInvariantExp (s • ξ)) ∘
      fun s : ℝ => s - t) = fun s : ℝ => mulInvariantExp (s • ξ) • x := by
    funext s
    simp only [comp_apply, y, ← mul_smul, ← mulInvariantExp_add_smul, sub_add_cancel]
  rw [hfun] at hcurve
  refine hcurve.congr_mfderiv ?_
  -- At the shifted time the exponential line is at the identity, where the left-invariant field
  -- is its generator; the point is generalized so that no dependent rewrite is needed.
  have key : ∀ e : G, e = 1 → mfderiv I I' (fun h : G => h • y) e (mulInvariantVectorField ξ e) =
      fundamentalVectorField I' ξ y := by
    rintro e rfl
    rw [mulInvariantVectorField_one]
    rfl
  refine ContinuousLinearMap.ext_ring ?_
  -- Both sides evaluate `smulRight 1 v` at `1`, which is definitionally `1 • v`.
  exact ((congrArg (mfderiv I I' (fun h : G => h • y) (mulInvariantExp ((t - t) • ξ)))
    (one_smul ℝ _)).trans (key (mulInvariantExp ((t - t) • ξ)) (by simp))).trans
      (one_smul ℝ _).symm

end Real

section InfinitesimalAction

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I (minSmoothness ℝ 3) G]
  {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E'] [CompleteSpace E']
  {H' : Type*} [TopologicalSpace H'] {I' : ModelWithCorners ℝ E' H'}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H' M] [IsManifold I' ∞ M] [MulAction G M]
  [ContMDiffSMul I I' ∞ G M]

variable (I G I' M) in
/-- The infinitesimal action `ξ ↦ ξ_M` of the Lie algebra of `G` on `M` by the fundamental vector
fields of a smooth left action. -/
def InfinitesimalAction.fundamental : InfinitesimalAction (GroupLieAlgebra I G) I' M where
  toLinearMap :=
    { toFun := fundamentalVectorField I'
      map_add' := fundamentalVectorField_add
      map_smul' := fundamentalVectorField_smul }
  contMDiff_toLinearMap' ξ := contMDiff_fundamentalVectorField (m := ∞) (n := ∞) (by simp) ξ
  toLinearMap_lie' ξ η := by
    have h2 : minSmoothness ℝ 2 ≤ ∞ := by
      rw [minSmoothness_of_isRCLikeNormedField]
      exact ENat.LEInfty.out
    have : IsManifold I' (minSmoothness ℝ 2) M := .of_le h2
    have : ContMDiffSMul I I' (minSmoothness ℝ 2) G M := ContMDiffSMul.of_le (M := M) h2
    simp only [LinearMap.coe_mk, AddHom.coe_mk, mlieBracket_fundamentalVectorField, neg_neg]

/-- The infinitesimal action of a group action generates the fundamental vector fields. -/
@[simp]
theorem InfinitesimalAction.fundamental_apply (ξ : GroupLieAlgebra I G) :
    InfinitesimalAction.fundamental I G I' M ξ = fundamentalVectorField I' ξ :=
  (rfl)

end InfinitesimalAction

end TauCeti
