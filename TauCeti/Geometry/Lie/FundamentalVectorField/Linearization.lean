module

public import TauCeti.Geometry.Lie.FundamentalVectorField
public import TauCeti.Geometry.Lie.Subgroup.OneParameter
public import TauCeti.Geometry.Manifold.Flow.RestPoint
import TauCeti.Analysis.Calculus.Deriv.FixedVector
import TauCeti.Topology.Algebra.ConstMulAction

/-!
# The linearization of a fundamental vector field at a zero

Let a Lie group `G` act smoothly on a manifold `M`, and let `ξ` be an element of its Lie algebra.
The curves `t ↦ exp (t ξ) • x` are the integral curves of the fundamental vector field `ξ_M`, so
the flow of `ξ_M` is the action of the one-parameter subgroup generated by `ξ`
(`TauCeti.flowOf_fundamentalVectorField`).

Now let `p` be a zero of `ξ_M`. Then every `exp (t ξ)` fixes `p`, and its differential at `p` is a
linear automorphism `d(exp (t ξ))_p` of the single tangent space `T_p M`: the restriction of the
tangent representation of the stabilizer of `p` to the one-parameter subgroup. Its derivative at
`t = 0` is the **linearization** of `ξ_M` at `p`, the derivative `L` of the coordinate expression
of `ξ_M` in the preferred chart at `p`
(`TauCeti.hasDerivAt_mfderiv_mulInvariantExp_smul_smul`). So `L` is the infinitesimal generator of
the isotropy representation along `ξ`: `d(exp (t ξ))_p = 1 + t L + o(t)`.

Since `t ↦ d(exp (t ξ))_p` is a one-parameter group of operators, a tangent vector `v` is killed
by `L` exactly when it is fixed by every `d(exp (t ξ))_p`
(`TauCeti.fderiv_mpullbackWithin_fundamentalVectorField_apply_eq_zero_iff`). Fixing a given
vector is a closed condition on the elements of the stabilizer of `p`, since the tangent
representation is continuous. Hence these are also the vectors fixed by the differential of every
element of the closure `T_ξ` of `{exp (t ξ) | t ∈ ℝ}`
(`TauCeti.forall_mem_closedOneParameterSubgroup_mfderiv_smul_apply_eq_iff`). For a torus and a
generic `ξ`, `T_ξ` is the whole torus.

At a zero of a Hamiltonian vector field, the linearization computes the Hessian of the
Hamiltonian, so these statements describe the Hessians of the components of a moment map at
fixed points.

## Main results

* `TauCeti.flowOf_fundamentalVectorField`: the flow of `ξ_M` is `(t, x) ↦ exp (t ξ) • x`.
* `TauCeti.hasDerivAt_mfderiv_mulInvariantExp_smul_smul`: at a zero `p` of `ξ_M`, the derivative
  of `t ↦ d(exp (t ξ))_p` at `t = 0` is the linearization of `ξ_M` at `p`.
* `TauCeti.fderiv_mpullbackWithin_fundamentalVectorField_apply_eq_zero_iff`: the kernel of the
  linearization consists of the vectors fixed by every `d(exp (t ξ))_p`.
* `TauCeti.forall_mem_closedOneParameterSubgroup_mfderiv_smul_apply_eq_iff`: these are the
  vectors fixed by the differential at `p` of every element of `T_ξ`.

## References

* M. F. Atiyah, *Convexity and commuting Hamiltonians*, Bull. London Math. Soc. 14 (1982), 1–15,
  § 2.
* M. W. Hirsch, S. Smale, R. L. Devaney, *Differential Equations, Dynamical Systems, and an
  Introduction to Chaos*, 3rd ed., Academic Press, 2013, Chapter 8 (linearization at
  equilibria).
-/

public section

open Function Set
open scoped Manifold ContDiff

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [LieGroup I (minSmoothness ℝ 3) G] [T2Space G] [BoundarylessManifold I G]
  {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E'] [CompleteSpace E']
  {H' : Type*} [TopologicalSpace H'] {I' : ModelWithCorners ℝ E' H'}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H' M] [MulAction G M] [T2Space M]

omit [CompleteSpace E'] in
/-- **The flow of a fundamental vector field.** For a `C²` action on a Hausdorff manifold without
boundary, the flow of the fundamental vector field `ξ_M` is the action of the one-parameter
subgroup generated by `ξ`: its time-`t` map is `x ↦ exp (t ξ) • x`. -/
theorem flowOf_fundamentalVectorField [IsManifold I' 1 M] [BoundarylessManifold I' M]
    [ContMDiffSMul I I' 2 G M] (ξ : GroupLieAlgebra I G) (t : ℝ) (x : M) :
    flowOf (fundamentalVectorField I' ξ) t x = mulInvariantExp (t • ξ) • x := by
  have : ContMDiffSMul I I' 1 G M := ContMDiffSMul.of_le (M := M) one_le_two
  simpa using flowOf_eq_of_isMIntegralCurve
    (contMDiff_fundamentalVectorField (m := 1) (n := 2) (by norm_num) ξ)
    (isMIntegralCurve_mulInvariantExp_smul_smul (I' := I') ξ x) t

omit [CompleteSpace E'] [T2Space M] in
/-- The time-zero map `x ↦ exp (0 • ξ) • x` is the identity, so its differential at every point is
the identity operator. -/
theorem mfderiv_mulInvariantExp_zero_smul_smul (ξ : GroupLieAlgebra I G) (p : M) :
    mfderiv I' I' (fun y : M ↦ mulInvariantExp ((0 : ℝ) • ξ) • y) p = (1 : E' →L[ℝ] E') := by
  have hid : (fun y : M ↦ mulInvariantExp ((0 : ℝ) • ξ) • y) = id := by
    funext y
    rw [zero_smul, mulInvariantExp_zero, one_smul, id]
  -- The two differentials are compared as operators on the model space `E'`.
  have h : (mfderiv I' I' (fun y : M ↦ mulInvariantExp ((0 : ℝ) • ξ) • y) p : E' →L[ℝ] E') =
      mfderiv I' I' id p := by
    rw [hid]
  exact h.trans mfderiv_id

variable [I'.Boundaryless] [IsManifold I' 2 M] [ContMDiffSMul I I' 3 G M]
  {ξ : GroupLieAlgebra I G} {p : M}

/-- **The linearization of a fundamental vector field at a zero.** Let `p` be a zero of the
fundamental vector field `ξ_M` of a `C³` action. The differentials `d(exp (t ξ))_p` of the
one-parameter subgroup, operators on `T_p M`, have derivative at `t = 0` the derivative of the
coordinate expression of `ξ_M` in the preferred chart at `p`. -/
theorem hasDerivAt_mfderiv_mulInvariantExp_smul_smul (hp : fundamentalVectorField I' ξ p = 0) :
    HasDerivAt (fun t : ℝ ↦
        (mfderiv I' I' (fun y : M ↦ mulInvariantExp (t • ξ) • y) p : E' →L[ℝ] E'))
      (fderiv ℝ (VectorField.mpullbackWithin 𝓘(ℝ, E') I' (extChartAt I' p).symm
        (fundamentalVectorField I' ξ) (range I')) (extChartAt I' p p)) 0 := by
  have : ContMDiffSMul I I' 2 G M := ContMDiffSMul.of_le (M := M) (m := 3) (by norm_num)
  refine (hasDerivAt_mfderiv_flowOf_of_eq_zero
    (contMDiff_fundamentalVectorField (m := 2) (n := 3) (by norm_num) ξ) hp).congr_of_eventuallyEq
      (Filter.Eventually.of_forall fun t ↦ ?_)
  -- The two differentials are compared as operators on the model space `E'`.
  exact congrArg (β := E' →L[ℝ] E') (fun f : M → M ↦ mfderiv I' I' f p)
    (funext (flowOf_fundamentalVectorField ξ t)).symm

/-- **The kernel of the linearization of a fundamental vector field.** At a zero `p` of the
fundamental vector field `ξ_M` of a `C³` action, a tangent vector is killed by the linearization
of `ξ_M` at `p` exactly when it is fixed by the differential at `p` of every `exp (t ξ)`. -/
theorem fderiv_mpullbackWithin_fundamentalVectorField_apply_eq_zero_iff
    (hp : fundamentalVectorField I' ξ p = 0) (v : TangentSpace I' p) :
    fderiv ℝ (VectorField.mpullbackWithin 𝓘(ℝ, E') I' (extChartAt I' p).symm
        (fundamentalVectorField I' ξ) (range I')) (extChartAt I' p p) v = 0 ↔
      ∀ t : ℝ, mfderiv I' I' (fun y : M ↦ mulInvariantExp (t • ξ) • y) p v = v := by
  have : ContMDiffSMul I I' 2 G M := ContMDiffSMul.of_le (M := M) (m := 3) (by norm_num)
  have : ContMDiffSMul I I' 1 G M := ContMDiffSMul.of_le (M := M) (m := 3) (by norm_num)
  have : IsManifold I' 1 M := IsManifold.of_le (n := 2) (by norm_num)
  have hfix := (mulInvariantExp_smul_smul_eq_iff (I' := I')).2 hp
  have hd : ∀ g ∈ MulAction.stabilizer G p, MDifferentiableAt I' I' (fun y : M ↦ g • y) p :=
    fun g _ ↦ (ContMDiffSMul.contMDiff_const_smul (I := I) (I' := I') (n := 1) g).mdifferentiableAt
      one_ne_zero
  -- The differentials `d(exp (t ξ))_p` are the tangent representation of the stabilizer of `p`
  -- along the one-parameter subgroup, so they form a one-parameter group of operators on `E'`.
  let φ : ℝ → MulAction.stabilizer G p := fun t ↦ ⟨_, hfix t⟩
  have hφadd (s t : ℝ) : φ (s + t) = φ s * φ t := Subtype.ext (mulInvariantExp_add_smul ξ s t)
  have hrep (t : ℝ) := tangentRepresentation_apply hd (φ t)
  -- `ContinuousLinearMap.mul_def` turns `*` into composition. The closing `rfl` only unfolds
  -- `TangentSpace I' p` to `E'`, which holds by definition, and the coercion of `φ t` to
  -- `mulInvariantExp (t • ξ)`.
  exact HasDerivAt.apply_eq_zero_iff_forall_apply_eq_self (F := E')
    (hasDerivAt_mfderiv_mulInvariantExp_smul_smul hp) (mfderiv_mulInvariantExp_zero_smul_smul ξ p)
    (fun s t ↦ (hrep (s + t)).symm.trans
      (by rw [hφadd, map_mul, ContinuousLinearMap.mul_def, hrep, hrep]; rfl)) (v : E')

omit [I'.Boundaryless] [IsManifold I' 2 M] [ContMDiffSMul I I' 3 G M] [CompleteSpace E'] in
/-- **Vectors fixed by a closed one-parameter subgroup.** Let every `exp (t ξ)` fix `p`. A tangent
vector at `p` is fixed by the differential at `p` of every element of the closure `T_ξ` of
`{exp (t ξ) | t ∈ ℝ}` exactly when it is fixed by the differential of every `exp (t ξ)`. -/
theorem forall_mem_closedOneParameterSubgroup_mfderiv_smul_apply_eq_iff [IsTopologicalGroup G]
    [IsManifold I' 1 M] [ContMDiffSMul I I' 1 G M]
    (hfix : ∀ t : ℝ, mulInvariantExp (t • ξ) • p = p) (v : TangentSpace I' p) :
    (∀ g ∈ Lie.closedOneParameterSubgroup ξ, mfderiv I' I' (fun y : M ↦ g • y) p v = v) ↔
      ∀ t : ℝ, mfderiv I' I' (fun y : M ↦ mulInvariantExp (t • ξ) • y) p v = v := by
  refine ⟨fun h t ↦ h _ (Lie.mulInvariantExp_smul_mem_closedOneParameterSubgroup ξ t),
    fun h ↦ ?_⟩
  have : ContinuousSMul G M := ContMDiffSMul.continuousSMul (I := I) (I' := I') 1
  have hd : ∀ g ∈ MulAction.stabilizer G p, MDifferentiableAt I' I' (fun y : M ↦ g • y) p :=
    fun g _ ↦ (ContMDiffSMul.contMDiff_const_smul (I := I) (I' := I') (n := 1) g).mdifferentiableAt
      one_ne_zero
  -- The elements of the stabilizer whose differential fixes `v` form a closed subset of `G`, by
  -- continuity of the tangent representation; it contains every `exp (t ξ)`, hence `T_ξ`.
  have hS : IsClosed (((↑) : MulAction.stabilizer G p → G) ''
      {g | tangentRepresentation hd g v = v}) :=
    (isClosed_eq ((ContinuousLinearMap.apply ℝ E' (E' := E') v).continuous.comp
      (continuous_tangentRepresentation I hd)) continuous_const).trans
      (isClosed_stabilizer (continuous_id.smul continuous_const))
  have hsub : (Lie.closedOneParameterSubgroup ξ : Set G) ⊆
      ((↑) : MulAction.stabilizer G p → G) '' {g | tangentRepresentation hd g v = v} := by
    rw [Lie.coe_closedOneParameterSubgroup]
    refine closure_minimal (range_subset_iff.2 fun t ↦ ⟨⟨_, hfix t⟩, ?_, rfl⟩) hS
    rw [mem_ofPred_eq, tangentRepresentation_apply]
    exact h t
  intro g hg
  obtain ⟨g', hg', rfl⟩ := hsub hg
  rw [mem_ofPred_eq, tangentRepresentation_apply] at hg'
  exact hg'

end TauCeti
