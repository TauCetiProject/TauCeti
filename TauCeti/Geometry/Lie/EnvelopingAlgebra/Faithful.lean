/-! ### Derivatives along exponential lines -/

/-- At time zero, a left-invariant derivation is the derivative along its exponential line
through `g`. -/
private theorem hasDerivAt_apply_mul_lieExp_smul_zero (X : LeftInvariantDerivation I G)
    (f : C^∞⟮I, G; ℝ⟯) (g : G) :
    HasDerivAt (fun t : ℝ ↦ f (g * lieExp (t • X))) (X f g) 0 := by
  set v := leftInvariantDerivationEquivGroupLieAlgebra (I := I) (G := G)
    BoundarylessManifold.isInteriorPoint X
  have hX : X = tangentToLeftInvariantDerivation v := by
    rw [← leftInvariantDerivationEquivGroupLieAlgebra_symm_apply
      BoundarylessManifold.isInteriorPoint, LinearEquiv.symm_apply_apply]
  have hf : HasMFDerivAt I 𝓘(ℝ, ℝ) f g (mfderiv I 𝓘(ℝ, ℝ) f g) :=
    (f.contMDiff.mdifferentiable (by simp)).mdifferentiableAt.hasMFDerivAt
  have hexp (t : ℝ) : lieExp (t • X) = mulInvariantExp (t • v) := by
    rw [lieExp_eq_mulInvariantExp, map_smul]
  simp only [hexp]
  convert hf.hasDerivAt_comp_mul_mulInvariantExp_smul_zero v using 1
  rw [hX, tangentToLeftInvariantDerivation_apply]
  -- `mvfderiv` into `ℝ` is `mfderiv` followed by the identification of a tangent space of `ℝ`
  -- with `ℝ`, which is the identity.
  rfl

/-- **A left-invariant derivation differentiates along its exponential lines.** The derivative of
`t ↦ f (g * lieExp (t • X))` at every time `t` is `X f` at the current point. -/
theorem hasDerivAt_apply_mul_lieExp_smul (X : LeftInvariantDerivation I G) (f : C^∞⟮I, G; ℝ⟯)
    (g : G) (t : ℝ) :
    HasDerivAt (fun s : ℝ ↦ f (g * lieExp (s • X))) (X f (g * lieExp (t • X))) t := by
  have h0 := hasDerivAt_apply_mul_lieExp_smul_zero X f (g * lieExp (t • X))
  rw [← sub_self t] at h0
  have h := HasDerivAt.comp_sub_const t t h0
  have hfun : (fun s : ℝ ↦ f (g * lieExp (t • X) * lieExp ((s - t) • X))) =
      fun s ↦ f (g * lieExp (s • X)) := by
    funext s
    rw [mul_assoc, ← lieExp_add_smul, add_sub_cancel]
  simpa only [hfun] using h

/-- The derivative of `f` along the exponential lines of `X` is `X f` along the same lines. -/
theorem deriv_apply_mul_lieExp_smul (X : LeftInvariantDerivation I G) (f : C^∞⟮I, G; ℝ⟯)
    (g : G) :
    deriv (fun s : ℝ ↦ f (g * lieExp (s • X))) = fun t ↦ X f (g * lieExp (t • X)) :=
  funext fun t ↦ (hasDerivAt_apply_mul_lieExp_smul X f g t).deriv

/-- **`Xⁿ` is the `n`-th derivative along the exponential lines of `X`.** The element
`ι X ^ n` of the enveloping algebra acts on `f` by the `n`-th derivative of
`t ↦ f (g * lieExp (t • X))`. -/
theorem iteratedDeriv_apply_mul_lieExp_smul (X : LeftInvariantDerivation I G)
    (f : C^∞⟮I, G; ℝ⟯) (g : G) (n : ℕ) :
    iteratedDeriv n (fun s : ℝ ↦ f (g * lieExp (s • X))) =
      fun t ↦ envelopingAction I G (UniversalEnvelopingAlgebra.ι ℝ X ^ n) f
        (g * lieExp (t • X)) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [iteratedDeriv_succ, ih, deriv_apply_mul_lieExp_smul, pow_succ', map_mul,
      mul_apply_eq_comp, envelopingAction_ι, leftInvariantDerivationToEnd_apply]

/-- On a function `f` with `f (lieExp Y) = exp (ℓ Y)` near `0`, the element `ι X ^ n` of the
enveloping algebra acts at the identity by `(ℓ X) ^ n`. -/
theorem envelopingAction_ι_pow_apply_one (X : LeftInvariantDerivation I G)
    (ℓ : Dual ℝ (LeftInvariantDerivation I G)) {f : C^∞⟮I, G; ℝ⟯}
    (hf : ∀ᶠ Y in 𝓝 0, f (lieExp Y) = Real.exp (ℓ Y)) (n : ℕ) :
    envelopingAction I G (UniversalEnvelopingAlgebra.ι ℝ X ^ n) f 1 = ℓ X ^ n := by
  set c := ℓ X
  let φ (k : ℕ) (t : ℝ) : ℝ :=
    envelopingAction I G (UniversalEnvelopingAlgebra.ι ℝ X ^ k) f (lieExp (t • X))
  have hφ (k : ℕ) : deriv (φ k) = φ (k + 1) := by
    have h := deriv_apply_mul_lieExp_smul X
      (envelopingAction I G (UniversalEnvelopingAlgebra.ι ℝ X ^ k) f) 1
    simp only [one_mul] at h
    simp only [φ, h, pow_succ', map_mul, mul_apply_eq_comp, envelopingAction_ι,
      leftInvariantDerivationToEnd_apply]
  have hexp (k : ℕ) (t : ℝ) :
      HasDerivAt (fun s ↦ c ^ k * Real.exp (s * c)) (c ^ (k + 1) * Real.exp (t * c)) t :=
    (((hasDerivAt_id' t).mul_const c).exp.const_mul (c ^ k)).congr_deriv (by ring)
  have hline : Tendsto (fun t : ℝ ↦ t • X) (𝓝 0) (𝓝 0) := by
    have hcont : Continuous fun t : ℝ ↦ t • X := continuous_id.smul continuous_const
    simpa only [zero_smul] using hcont.tendsto (0 : ℝ)
  have hevent (k : ℕ) : φ k =ᶠ[𝓝 0] fun t ↦ c ^ k * Real.exp (t * c) := by
    induction k with
    | zero =>
      filter_upwards [hline.eventually hf] with t ht
      simp only [φ, pow_zero, map_one, one_apply_eq_self, one_mul, ht, map_smul, smul_eq_mul,
        c]
    | succ k ih =>
      rw [← hφ k]
      exact ih.deriv.trans (Eventually.of_forall fun t ↦ (hexp k t).deriv)
  have h0 := (hevent n).eq_of_nhds
  simpa only [φ, zero_smul, lieExp_zero, zero_mul, Real.exp_zero, mul_one] using h0

end LeftInvariantDerivation

namespace TauCeti

/-! ### Test functions -/

/-- **Smooth functions with a prescribed germ along the exponential.** Every smooth function `φ`
on the Lie algebra is, near `0`, the composite of a globally smooth function on `G` with the
exponential. -/
theorem exists_contMDiffMap_eventually_apply_lieExp_eq {φ : LeftInvariantDerivation I G → ℝ}
    (hφ : ContDiff ℝ ∞ φ) :
    ∃ f : C^∞⟮I, G; ℝ⟯, ∀ᶠ Y in 𝓝 (0 : LeftInvariantDerivation I G), f (lieExp Y) = φ Y := by
  have hd := isLocalDiffeomorphAt_lieExp_zero (I := I) (G := G)
  have h1 : (1 : G) ∈ hd.localInverse.source := by
    simpa only [lieExp_zero] using hd.localInverse_mem_source
  obtain ⟨f, hf⟩ := (hφ.contMDiff.comp_contMDiffOn
    hd.contMDiffOn_localInverse).exists_contMDiffMap_eventuallyEq hd.localInverse_open_source h1
  refine ⟨f, ?_⟩
  have hexp : Tendsto (lieExp (I := I) (G := G)) (𝓝 0) (𝓝 1) := by
    simpa only [lieExp_zero] using
      ((contMDiff_lieExp (I := I) (G := G)).continuous.tendsto (0 : LeftInvariantDerivation I G))
  filter_upwards [hexp.eventually hf, hd.localInverse_eventuallyEq_left] with Y hY hY'
  rw [hY, comp_apply]
  exact congrArg φ hY'

/-! ### Faithfulness -/

/-- On a function `f` with `f (lieExp Y) = exp (ℓ Y)` near `0`, the symmetrization of a
homogeneous polynomial `p` acts at the identity by the value of `p` at `ℓ`. -/
private theorem envelopingAction_pbwHomogeneousSymmetrization_apply_one
    (ℓ : Dual ℝ (LeftInvariantDerivation I G)) {f : C^∞⟮I, G; ℝ⟯}
    (hf : ∀ᶠ Y in 𝓝 0, f (lieExp Y) = Real.exp (ℓ Y)) (n : ℕ) (hn : IsUnit (n.factorial : ℝ))
    (p : TauCeti.SymmetricAlgebra.homogeneousSubmodule ℝ (LeftInvariantDerivation I G) n) :
    envelopingAction I G
        (TauCeti.UniversalEnvelopingAlgebra.pbwHomogeneousSymmetrization ℝ _ n hn p) f 1 =
      SymmetricAlgebra.lift ℓ (p : SymmetricAlgebra ℝ (LeftInvariantDerivation I G)) := by
  -- Both sides are linear in `p`, and they agree on the spanning `n`-th powers.
  have hmem : (p : SymmetricAlgebra ℝ (LeftInvariantDerivation I G)) ∈
      Submodule.span ℝ
        (Set.range fun v ↦ SymmetricAlgebra.ι ℝ (LeftInvariantDerivation I G) v ^ n) := by
    rw [TauCeti.SymmetricAlgebra.span_pow_eq_homogeneousSubmodule]
    exact p.2
  suffices H : ∀ x ∈ Submodule.span ℝ
      (Set.range fun v ↦ SymmetricAlgebra.ι ℝ (LeftInvariantDerivation I G) v ^ n),
      ∃ h : x ∈ TauCeti.SymmetricAlgebra.homogeneousSubmodule ℝ (LeftInvariantDerivation I G) n,
        envelopingAction I G
            (TauCeti.UniversalEnvelopingAlgebra.pbwHomogeneousSymmetrization ℝ _ n hn ⟨x, h⟩) f 1 =
          SymmetricAlgebra.lift ℓ x by
    obtain ⟨_, hp⟩ := H _ hmem
    exact hp
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨v, rfl⟩ := hx
    have hv := SetLike.pow_mem_graded n
      (TauCeti.SymmetricAlgebra.ι_mem_homogeneousSubmodule ℝ (LeftInvariantDerivation I G) v)
    rw [smul_eq_mul, mul_one] at hv
    refine ⟨hv, ?_⟩
    rw [TauCeti.UniversalEnvelopingAlgebra.pbwHomogeneousSymmetrization_ι_pow,
      LeftInvariantDerivation.envelopingAction_ι_pow_apply_one v ℓ hf, map_pow,
      SymmetricAlgebra.lift_ι_apply]
  | zero =>
    refine ⟨zero_mem _, ?_⟩
    have h0 : (⟨0, zero_mem _⟩ :
        TauCeti.SymmetricAlgebra.homogeneousSubmodule ℝ (LeftInvariantDerivation I G) n) = 0 := rfl
    rw [h0, map_zero, map_zero, map_zero, LinearMap.zero_apply, ContMDiffMap.coe_zero,
      Pi.zero_apply]
  | add x y _ _ hx hy =>
    obtain ⟨hx, ex⟩ := hx
    obtain ⟨hy, ey⟩ := hy
    refine ⟨add_mem hx hy, ?_⟩
    have hsum : (⟨x + y, add_mem hx hy⟩ :
        TauCeti.SymmetricAlgebra.homogeneousSubmodule ℝ (LeftInvariantDerivation I G) n) =
        ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
    rw [hsum, map_add, map_add, LinearMap.add_apply, ContMDiffMap.coe_add, Pi.add_apply, ex, ey,
      map_add]
  | smul r x _ hx =>
    obtain ⟨hx, ex⟩ := hx
    refine ⟨Submodule.smul_mem _ r hx, ?_⟩
    have hsmul : (⟨r • x, Submodule.smul_mem _ r hx⟩ :
        TauCeti.SymmetricAlgebra.homogeneousSubmodule ℝ (LeftInvariantDerivation I G) n) =
        r • ⟨x, hx⟩ := rfl
    rw [hsmul, map_smul, map_smul, LinearMap.smul_apply, ContMDiffMap.coe_smul, Pi.smul_apply,
      ex, map_smul]

/-- **The enveloping algebra of a Lie group acts faithfully on its smooth functions.** An element
of `U(𝔤)` that kills every smooth function on `G` is zero. -/
theorem envelopingAction_injective : Injective (envelopingAction I G) := by
  have htest (ℓ : Dual ℝ (LeftInvariantDerivation I G)) :
      ∃ f : C^∞⟮I, G; ℝ⟯, ∀ᶠ Y in 𝓝 0, f (lieExp Y) = Real.exp (ℓ Y) :=
    exists_contMDiffMap_eventually_apply_lieExp_eq
      (Real.contDiff_exp.comp (LinearMap.toContinuousLinearMap ℓ).contDiff)
  choose f hf using htest
  have hn (n : ℕ) : IsUnit (n.factorial : ℝ) := (Nat.cast_ne_zero.2 n.factorial_ne_zero).isUnit
  rw [injective_iff_map_eq_zero]
  intro u hu
  have hmem : u ∈ ⨆ n, LinearMap.range
      (TauCeti.UniversalEnvelopingAlgebra.pbwHomogeneousSymmetrization ℝ
        (LeftInvariantDerivation I G) n (hn n)) := by
    simp only [TauCeti.UniversalEnvelopingAlgebra.range_pbwHomogeneousSymmetrization,
      TauCeti.UniversalEnvelopingAlgebra.iSup_range_pbwSymmetrization_eq_top, Submodule.mem_top]
  obtain ⟨F, hF, rfl⟩ := (Submodule.mem_iSup_iff_exists_finsupp _ _).1 hmem
  choose p hp using hF
  -- The polynomial `∑ pₙ` has value `0` at every linear form, so it is zero.
  have hP : ∑ n ∈ F.support, (p n : SymmetricAlgebra ℝ (LeftInvariantDerivation I G)) = 0 := by
    refine TauCeti.SymmetricAlgebra.eq_of_forall_lift_apply_eq fun ℓ ↦ ?_
    have hev (s : Finset ℕ) (g : ℕ → C^∞⟮I, G; ℝ⟯) : (∑ n ∈ s, g n) 1 = ∑ n ∈ s, g n 1 := by
      simpa using congrFun (map_sum ContMDiffMap.coeFnRingHom g s) 1
    have h := congrArg (fun T : Module.End ℝ C^∞⟮I, G; ℝ⟯ ↦ T (f ℓ) 1) hu
    simp only [Finsupp.sum, map_sum, ← hp, LinearMap.sum_apply, hev,
      envelopingAction_pbwHomogeneousSymmetrization_apply_one ℓ (hf ℓ), LinearMap.zero_apply,
      ContMDiffMap.coe_zero, Pi.zero_apply] at h
    rw [map_sum, h, map_zero]
  -- Its homogeneous components vanish, so every symmetrization in the sum is zero.
  have hp0 (m : ℕ) (hm : m ∈ F.support) : p m = 0 := by
    have h := congrArg
      (fun P ↦ (DirectSum.decompose
        (TauCeti.SymmetricAlgebra.homogeneousSubmodule ℝ (LeftInvariantDerivation I G)) P m :
          SymmetricAlgebra ℝ (LeftInvariantDerivation I G))) hP
    simp only [DirectSum.decompose_sum, DirectSum.sum_apply, Submodule.coe_sum,
      DirectSum.decompose_coe, DirectSum.decompose_zero, DirectSum.zero_apply,
      ZeroMemClass.coe_zero] at h
    rw [Finset.sum_eq_single m (fun n _ hnm ↦ by
      rw [DirectSum.of_eq_of_ne _ _ _ hnm.symm, ZeroMemClass.coe_zero])
      (fun h' ↦ absurd hm h')] at h
    exact Subtype.ext (by simpa using h)
  refine Finset.sum_eq_zero fun n hn' ↦ ?_
  rw [← hp, hp0 n hn', map_zero]

/-- **`U(𝔤)` is the algebra of operators generated by the left-invariant vector fields.** The
action on smooth functions identifies the universal enveloping algebra with the algebra of
operators on `C^∞⟮I, G; ℝ⟯` generated by the left-invariant derivations. -/
def envelopingAlgEquivAdjoin :
    UniversalEnvelopingAlgebra ℝ (LeftInvariantDerivation I G) ≃ₐ[ℝ]
      Algebra.adjoin ℝ (Set.range (leftInvariantDerivationToEnd I G)) :=
  (AlgEquiv.ofInjective _ envelopingAction_injective).trans
    (Subalgebra.equivOfEq _ _ range_envelopingAction)

/-- The isomorphism sends an element of `U(𝔤)` to its action on smooth functions. -/
@[simp]
theorem envelopingAlgEquivAdjoin_apply
    (u : UniversalEnvelopingAlgebra ℝ (LeftInvariantDerivation I G)) :
    (envelopingAlgEquivAdjoin u : Module.End ℝ C^∞⟮I, G; ℝ⟯) = envelopingAction I G u := by
  rfl

end TauCeti
