module

public import Mathlib.Algebra.Lie.UniversalEnveloping
public import Mathlib.Geometry.Manifold.Algebra.LeftInvariantDerivation
import TauCeti.Algebra.Lie.UniversalEnveloping.Basic

/-!
# The enveloping algebra of a Lie group acting on smooth functions

The Lie algebra of a Lie group `G` is, in Mathlib, the Lie algebra
`LeftInvariantDerivation I G` of left-invariant derivations of the algebra `C^∞⟮I, G; 𝕜⟯` of smooth
functions, whose bracket is the commutator of derivations. Each such derivation is in particular a
linear operator on `C^∞⟮I, G; 𝕜⟯`, and this gives a Lie algebra homomorphism into the operators
(`TauCeti.leftInvariantDerivationToEnd`). By the universal property of the universal enveloping
algebra `U(𝔤)` it extends uniquely to an algebra homomorphism

`TauCeti.envelopingAction : U(𝔤) →ₐ[𝕜] Module.End 𝕜 C^∞⟮I, G; 𝕜⟯`,

under which a monomial `X₁ ⋯ Xₙ` acts by applying the derivations `Xₙ, …, X₁` in turn.

Every operator in the image commutes with left translations
(`TauCeti.envelopingAction_apply_comp_smoothLeftMul`), and the image is the algebra
of operators generated by the left-invariant derivations
(`TauCeti.range_envelopingAction`). These operators are the left-invariant
differential operators built from the left-invariant vector fields. For a finite-dimensional real
Lie group the action is faithful, so that `U(𝔤)` is isomorphic to that algebra of operators; this
is proved in `TauCeti.Geometry.Lie.EnvelopingAlgebra.Faithful`.

## Main definitions

* `TauCeti.leftInvariantDerivationToEnd`: a left-invariant derivation as an operator on smooth
  functions, as a Lie algebra homomorphism.
* `TauCeti.envelopingAction`: the action of the universal enveloping algebra on smooth functions.

## Main results

* `LeftInvariantDerivation.envelopingAction_ι`: a Lie algebra element acts as its derivation.
* `TauCeti.envelopingAction_apply_comp_smoothLeftMul`: the action commutes with left translations.
* `TauCeti.range_envelopingAction`: the image of the action is the algebra generated by the
  left-invariant derivations.

## References

* S. Helgason, *Differential Geometry, Lie Groups, and Symmetric Spaces*, Chapter II, §4.
* F. W. Warner, *Foundations of Differentiable Manifolds and Lie Groups*, Exercise 3.22.
-/

public section

open scoped LieGroup Manifold ContDiff

noncomputable section

-- The commutator Lie ring on `Module.End` is not a global instance in Mathlib, which registers it
-- locally in the same way for `LieModule.toEnd`.
attribute [local instance 100] LieRing.ofAssociativeRing

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜] {E : Type*} [NormedAddCommGroup E]
  [NormedSpace 𝕜 E] {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H} {G : Type*}
  [TopologicalSpace G] [ChartedSpace H G] [Monoid G] [ContMDiffMul I ∞ G]

namespace TauCeti

variable (I G) in
/-- A left-invariant derivation acting as a linear operator on smooth functions. Since the bracket
of left-invariant derivations is their commutator, this is a Lie algebra homomorphism. -/
def leftInvariantDerivationToEnd :
    LeftInvariantDerivation I G →ₗ⁅𝕜⁆ Module.End 𝕜 C^∞⟮I, G; 𝕜⟯ where
  toFun X :=
    { toFun := X
      map_add' := map_add X
      map_smul' := map_smul X }
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  map_lie' {X Y} := by
    ext f
    simp only [LieRing.of_associative_ring_bracket, LinearMap.sub_apply, mul_apply_eq_comp,
      LinearMap.coe_mk, AddHom.coe_mk, LeftInvariantDerivation.commutator_apply]

variable (I G) in
/-- **The universal enveloping algebra acting on smooth functions.** The left-invariant derivations
act on `C^∞⟮I, G; 𝕜⟯`, and this action extends uniquely to an algebra homomorphism out of the
universal enveloping algebra of their Lie algebra. -/
def envelopingAction :
    UniversalEnvelopingAlgebra 𝕜 (LeftInvariantDerivation I G) →ₐ[𝕜]
      Module.End 𝕜 C^∞⟮I, G; 𝕜⟯ :=
  UniversalEnvelopingAlgebra.lift 𝕜 (leftInvariantDerivationToEnd I G)

end TauCeti

namespace LeftInvariantDerivation

open TauCeti

@[simp]
theorem leftInvariantDerivationToEnd_apply (X : LeftInvariantDerivation I G)
    (f : C^∞⟮I, G; 𝕜⟯) :
    leftInvariantDerivationToEnd I G X f = X f :=
  (rfl)

/-- A Lie algebra element acts on smooth functions as its derivation. -/
-- `simp`-normal form is `envelopingAction_mkAlgHom_ι`, as for `UniversalEnvelopingAlgebra.lift`.
theorem envelopingAction_ι (X : LeftInvariantDerivation I G) :
    envelopingAction I G (UniversalEnvelopingAlgebra.ι 𝕜 X) =
      leftInvariantDerivationToEnd I G X :=
  UniversalEnvelopingAlgebra.lift_ι_apply 𝕜 (leftInvariantDerivationToEnd I G) X

/-- `envelopingAction_ι` in `simp`-normal form, where the canonical map `ι` into `U(𝔤)` is written
through the tensor algebra. -/
@[simp]
theorem envelopingAction_mkAlgHom_ι (X : LeftInvariantDerivation I G) :
    envelopingAction I G
        (UniversalEnvelopingAlgebra.mkAlgHom 𝕜 (LeftInvariantDerivation I G)
          (TensorAlgebra.ι 𝕜 X)) =
      leftInvariantDerivationToEnd I G X :=
  UniversalEnvelopingAlgebra.lift_ι_apply' 𝕜 (leftInvariantDerivationToEnd I G) X

end LeftInvariantDerivation

namespace TauCeti

/-- **The action commutes with left translations.** For every element `u` of the enveloping
algebra, applying `u` and then translating on the left by `g` is the same as translating first:
the operators in the image are left-invariant. -/
theorem envelopingAction_apply_comp_smoothLeftMul (g : G)
    (u : UniversalEnvelopingAlgebra 𝕜 (LeftInvariantDerivation I G)) (f : C^∞⟮I, G; 𝕜⟯) :
    (envelopingAction I G u f).comp (𝑳 I g) = envelopingAction I G u (f.comp (𝑳 I g)) := by
  induction u using TauCeti.UniversalEnvelopingAlgebra.induction_ι generalizing f with
  | ι X =>
    simpa only [LeftInvariantDerivation.envelopingAction_ι,
      LeftInvariantDerivation.leftInvariantDerivationToEnd_apply] using
      LeftInvariantDerivation.comp_L g X f
  | algebraMap r =>
    ext x
    simp [Module.algebraMap_end_apply]
  | add a b ha hb =>
    ext x
    simp only [map_add, LinearMap.add_apply, ← ha, ← hb, ContMDiffMap.comp_apply,
      ContMDiffMap.coe_add, Pi.add_apply]
  | mul a b ha hb =>
    simp only [map_mul, mul_apply_eq_comp, ha, hb]

/-- **The image of the action is the algebra generated by the left-invariant derivations.** -/
theorem range_envelopingAction :
    (envelopingAction I G).range =
      Algebra.adjoin 𝕜 (Set.range (leftInvariantDerivationToEnd I G)) := by
  rw [← Algebra.map_top, ← TauCeti.UniversalEnvelopingAlgebra.adjoin_range_ι,
    AlgHom.map_adjoin, ← Set.range_comp]
  congr 2
  exact funext LeftInvariantDerivation.envelopingAction_ι

end TauCeti
