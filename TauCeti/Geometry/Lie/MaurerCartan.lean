module

public import TauCeti.Geometry.Lie.Adjoint.Basic
public import TauCeti.Geometry.Lie.LeftInvariantForm

/-!
# The left Maurer–Cartan form of a Lie group

The left Maurer–Cartan form of a Lie group `G` is the one-form `θ` with values in the Lie algebra
`𝔤 = T₁G` which translates every tangent vector back to the identity,

`θ_g (v) = d(L_{g⁻¹})_g v`

(`TauCeti.leftMaurerCartanForm`). It is the left-invariant extension of the identity of `𝔤`
(`TauCeti.leftInvariantSmoothForm`), so it is smooth and invariant under left translations, and it
takes the constant value `ξ` on the left-invariant vector field generated by `ξ`. Under right
translations it transforms by the adjoint representation,

`R_h^* θ = Ad(h⁻¹) ∘ θ`

(`TauCeti.leftMaurerCartanForm_apply_mfderiv_mul_right`). These are the two laws that make `θ` the
connection form of the trivial principal bundle, and the local model from which connection forms
on principal bundles are glued.

The Lie algebra `GroupLieAlgebra I G` is the model space `E` of `G`, which carries the norm, so
the form takes values in `E`, as `TauCeti.leftMaurerCartanEval` does.

## Main definitions

* `TauCeti.leftMaurerCartanForm I G`: the left Maurer–Cartan form, a smooth one-form with values
  in the Lie algebra.

## Main results

* `TauCeti.leftMaurerCartanForm_apply`: `θ_g (v) = d(L_{g⁻¹})_g v`.
* `TauCeti.leftMaurerCartanForm_apply_eq_leftMaurerCartanEval`: evaluated on a vector field `V`,
  `θ` is `TauCeti.leftMaurerCartanEval V`.
* `TauCeti.leftMaurerCartanForm_apply_mulInvariantVectorField`: `θ` takes the value `ξ` on the
  left-invariant vector field of `ξ`.
* `TauCeti.mpullback_mul_left_leftMaurerCartanForm`: left translations preserve `θ`.
* `TauCeti.leftMaurerCartanForm_apply_mfderiv_mul_right`: right translation by `h` transforms `θ`
  by `Ad(h⁻¹)`.

## References

* S. Kobayashi and K. Nomizu, *Foundations of Differential Geometry*, Vol. I, Interscience, 1963,
  Chapter I, §4 (the canonical one-form of a Lie group and its right translates).
-/

public section

noncomputable section

open scoped ContDiff Manifold

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [IsManifold I 1 G] [LieGroup I ∞ G]

variable (I G) in
/-- The **left Maurer–Cartan form** `θ_g (v) = d(L_{g⁻¹})_g v` of a Lie group, a smooth one-form
with values in the Lie algebra `GroupLieAlgebra I G`, which is the model space `E`. It is the
left-invariant extension of the identity of the Lie algebra. -/
def leftMaurerCartanForm : SmoothForm I G E 1 :=
  leftInvariantSmoothForm I G E 1
    (ContinuousAlternatingMap.ofSubsingleton ℝ (GroupLieAlgebra I G) E 0
      (ContinuousLinearMap.id ℝ E))

/-- The left Maurer–Cartan form translates a tangent vector at `g` back to the identity by the
differential of `x ↦ g⁻¹ * x`. -/
theorem leftMaurerCartanForm_apply (g : G) (v : TangentSpace I g) :
    (leftMaurerCartanForm I G).val g ![v] = mfderiv I I (g⁻¹ * ·) g v := by
  rw [leftMaurerCartanForm, leftInvariantSmoothForm_val, leftInvariantForm_apply]
  -- The Lie algebra is the model space `E` by definition, so the identity of `E` applied to the
  -- translated vector is that vector; `ofSubsingleton_apply_apply` does not fire syntactically.
  rfl

/-- Evaluated on a vector field `V`, the left Maurer–Cartan form is the function
`TauCeti.leftMaurerCartanEval V`. -/
theorem leftMaurerCartanForm_apply_eq_leftMaurerCartanEval (V : Π g : G, TangentSpace I g)
    (g : G) : (leftMaurerCartanForm I G).val g ![V g] = leftMaurerCartanEval V g := by
  rw [leftMaurerCartanForm_apply, leftMaurerCartanEval_apply]

/-- The left Maurer–Cartan form takes the value `ξ` on the left-invariant vector field generated
by `ξ`. -/
@[simp]
theorem leftMaurerCartanForm_apply_mulInvariantVectorField (ξ : GroupLieAlgebra I G) (g : G) :
    (leftMaurerCartanForm I G).val g ![mulInvariantVectorField ξ g] = ξ := by
  rw [leftMaurerCartanForm_apply, mfderiv_inv_mul_mulInvariantVectorField]

/-- Every left translation preserves the left Maurer–Cartan form. -/
@[simp]
theorem mpullback_mul_left_leftMaurerCartanForm (g : G) :
    SmoothForm.mpullback (g * ·) contMDiff_mul_left (leftMaurerCartanForm I G) =
      leftMaurerCartanForm I G :=
  mpullback_mul_left_leftInvariantSmoothForm _ g

/-- **Right translates of the Maurer–Cartan form.** Right translation by `h` transforms the left
Maurer–Cartan form by the adjoint action of `h⁻¹`: `θ_{g h}(d(R_h)_g v) = Ad(h⁻¹) (θ_g v)`, that
is `R_h^* θ = Ad(h⁻¹) ∘ θ`. -/
theorem leftMaurerCartanForm_apply_mfderiv_mul_right (g h : G) (v : TangentSpace I g) :
    (leftMaurerCartanForm I G).val (g * h) ![mfderiv I I (· * h) g v] =
      Lie.adjointContinuousLinearMap (I := I) h⁻¹ ((leftMaurerCartanForm I G).val g ![v]) := by
  obtain ⟨ξ, rfl⟩ := exists_mulInvariantVectorField_eq (I := I) (G := G) (g := g) v
  rw [Lie.mfderiv_mul_right_mulInvariantVectorField,
    leftMaurerCartanForm_apply_mulInvariantVectorField,
    leftMaurerCartanForm_apply_mulInvariantVectorField]

end TauCeti
