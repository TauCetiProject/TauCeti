module

public import TauCeti.Geometry.Lie.Subgroup.LieAlgebra

/-!
# The Lie algebra of a subgroup in the tangent Lie algebra

The Lie algebra `TauCeti.Lie.lieSubalgebraOfSubgroup K` of a subgroup `K` of a Lie group `G` lives
in the left-invariant derivations of `G`. Moment maps, the adjoint and coadjoint representations and
the differentials of homomorphisms are stated on the tangent Lie algebra `𝔤 = GroupLieAlgebra I G`
at the identity instead. This file transports the Lie algebra of `K` along evaluation at the
identity (`leftInvariantDerivationLieEquivGroupLieAlgebra`) to a Lie subalgebra
`𝔨 ⊆ 𝔤`, `Subgroup.groupLieSubalgebra K`, and records its one-parameter subgroup description
there: for a closed subgroup, `ξ ∈ 𝔨` exactly when `t ↦ exp (t ξ)` stays in `K`.

Its invariance under the adjoint action is in
`TauCeti.Geometry.Lie.Adjoint.Representation.Subgroup`, and its description as the range of the
differential of the inclusion is in `TauCeti.Geometry.Lie.Subgroup.Differential`.

## Main definitions

* `Subgroup.groupLieSubalgebra`: the Lie algebra of a subgroup, in the tangent Lie algebra.

## Main results

* `TauCeti.Lie.mem_groupLieSubalgebra`: for a closed subgroup, membership is the one-parameter
  subgroup condition.
* `TauCeti.Lie.groupLieSubalgebra_le_iff`: for any subgroup, the universal property of the Lie
  subalgebra generated by the one-parameter subgroups in `K`.
* `Subgroup.groupLieSubalgebra_mono`, `Subgroup.groupLieSubalgebra_inf`,
  `Subgroup.groupLieSubalgebra_bot`, `Subgroup.groupLieSubalgebra_top`: the Lie algebra is monotone
  in the subgroup, takes intersections of closed subgroups to intersections, and is `⊥` for the
  trivial subgroup and `⊤` for the whole group.

## References

* J. Hilgert and K.-H. Neeb, *Structure and Geometry of Lie Groups*, Springer (2012),
  Section 9.1.
* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd edition (2013), Theorem 20.12.
-/

public section

noncomputable section

namespace TauCeti.Lie

open scoped ContDiff Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [FiniteDimensional ℝ E] [LieGroup I ∞ G]

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold

/-- **The Lie algebra of a subgroup `K`, in the tangent Lie algebra** `𝔤 = GroupLieAlgebra I G`:
the image of `TauCeti.Lie.lieSubalgebraOfSubgroup K` under evaluation of left-invariant
derivations at the identity. The Hausdorff property that `TauCeti.Lie.lieSubalgebraOfSubgroup`
assumes holds for every Lie group (`ModelWithCorners.t2Space_of_lieGroup`), so it is not a
parameter here. -/
def _root_.Subgroup.groupLieSubalgebra (K : Subgroup G) : LieSubalgebra ℝ (GroupLieAlgebra I G) :=
  haveI := I.t2Space_of_lieGroup (G := G) ∞
  (lieSubalgebraOfSubgroup (I := I) K).map
    (leftInvariantDerivationLieEquivGroupLieAlgebra (I := I) (G := G)
      (ContMDiffMul.isInteriorPoint (I := I) (n := ∞) (by simp) (1 : G))).toLieHom

/-! The remaining statements involve `TauCeti.Lie.lieSubalgebraOfSubgroup` or the exponential
`mulInvariantExp`, which are stated for a Hausdorff `G`. -/

variable [T2Space G]

/-- The Lie algebra of `K` in the tangent Lie algebra is the image of
`TauCeti.Lie.lieSubalgebraOfSubgroup K` under evaluation at the identity, for any proof that the
identity is an interior point. -/
theorem _root_.Subgroup.groupLieSubalgebra_eq_map (K : Subgroup G)
    (h₁ : I.IsInteriorPoint (1 : G)) :
    K.groupLieSubalgebra (I := I) =
      (lieSubalgebraOfSubgroup (I := I) K).map
        (leftInvariantDerivationLieEquivGroupLieAlgebra (I := I) (G := G) h₁).toLieHom :=
  (rfl)

/-- A tangent vector lies in the Lie algebra of `K` exactly when its left-invariant derivation does.
-/
theorem mem_groupLieSubalgebra_iff {K : Subgroup G} {ξ : GroupLieAlgebra I G} :
    ξ ∈ K.groupLieSubalgebra (I := I) ↔
      tangentToLeftInvariantDerivation ξ ∈ lieSubalgebraOfSubgroup (I := I) K := by
  rw [Subgroup.groupLieSubalgebra, LieSubalgebra.mem_map,
    ← leftInvariantDerivationLieEquivGroupLieAlgebra_symm_apply
      (ContMDiffMul.isInteriorPoint (I := I) (n := ∞) (by simp) (1 : G))]
  constructor
  · rintro ⟨D, hD, rfl⟩
    rwa [LieEquiv.coe_toLieHom, LieEquiv.symm_apply_apply]
  · exact fun h ↦ ⟨_, h, LieEquiv.apply_symm_apply _ _⟩

/-- A tangent vector whose one-parameter subgroup lies in `K` lies in the Lie algebra of `K`. This
direction needs no hypothesis on `K`. -/
theorem mem_groupLieSubalgebra_of_forall {K : Subgroup G} {ξ : GroupLieAlgebra I G}
    (hξ : ∀ t : ℝ, mulInvariantExp (I := I) (t • ξ) ∈ K) :
    ξ ∈ K.groupLieSubalgebra (I := I) := by
  rw [mem_groupLieSubalgebra_iff]
  refine mem_lieSubalgebraOfSubgroup_of_forall fun t ↦ ?_
  rw [← map_smul, lieExp_tangentToLeftInvariantDerivation]
  exact hξ t

/-- **The universal property of the Lie algebra of a subgroup**, in the tangent Lie algebra: it is
the least Lie subalgebra containing every `ξ` whose one-parameter subgroup lies in `K`. No
hypothesis on `K` is needed. -/
theorem groupLieSubalgebra_le_iff {K : Subgroup G}
    {L : LieSubalgebra ℝ (GroupLieAlgebra I G)} :
    K.groupLieSubalgebra (I := I) ≤ L ↔
      ∀ ξ : GroupLieAlgebra I G, (∀ t : ℝ, mulInvariantExp (I := I) (t • ξ) ∈ K) → ξ ∈ L := by
  refine ⟨fun h ξ hξ ↦ h (mem_groupLieSubalgebra_of_forall hξ), fun h ↦ ?_⟩
  rw [Subgroup.groupLieSubalgebra, LieSubalgebra.map_le_iff_le_comap,
    lieSubalgebraOfSubgroup_le_iff]
  intro X hX
  rw [LieSubalgebra.mem_comap, LieEquiv.coe_toLieHom,
    leftInvariantDerivationLieEquivGroupLieAlgebra_apply]
  -- `lieExp X` is `mulInvariantExp` of the value of `X` at the identity.
  exact h _ fun t ↦ by simpa only [lieExp_eq_mulInvariantExp, map_smul] using hX t

/-- **The Lie algebra of a closed subgroup** in the tangent Lie algebra consists of the `ξ` whose
one-parameter subgroup `t ↦ exp (t ξ)` stays in `K`. -/
@[simp]
theorem mem_groupLieSubalgebra {K : Subgroup G} (hK : IsClosed (K : Set G))
    {ξ : GroupLieAlgebra I G} :
    ξ ∈ K.groupLieSubalgebra (I := I) ↔
      ∀ t : ℝ, mulInvariantExp (I := I) (t • ξ) ∈ K := by
  rw [mem_groupLieSubalgebra_iff, mem_lieSubalgebraOfSubgroup hK]
  simp only [← map_smul, lieExp_tangentToLeftInvariantDerivation]

/-! ### Order laws -/

omit [T2Space G] in
/-- **Monotonicity.** A larger subgroup has a larger Lie algebra in the tangent Lie algebra. -/
theorem _root_.Subgroup.groupLieSubalgebra_mono {K K' : Subgroup G} (h : K ≤ K') :
    K.groupLieSubalgebra (I := I) ≤ K'.groupLieSubalgebra (I := I) := by
  have := I.t2Space_of_lieGroup (G := G) ∞
  exact groupLieSubalgebra_le_iff.mpr fun _ hξ ↦
    mem_groupLieSubalgebra_of_forall fun t ↦ h (hξ t)

omit [T2Space G] in
/-- **The Lie algebra of an intersection of closed subgroups is the intersection of their Lie
algebras**, in the tangent Lie algebra. Without closedness only `≤` holds, by
`Subgroup.groupLieSubalgebra_mono`. -/
theorem _root_.Subgroup.groupLieSubalgebra_inf {K K' : Subgroup G} (hK : IsClosed (K : Set G))
    (hK' : IsClosed (K' : Set G)) :
    (K ⊓ K').groupLieSubalgebra (I := I) =
      K.groupLieSubalgebra (I := I) ⊓ K'.groupLieSubalgebra (I := I) := by
  have := I.t2Space_of_lieGroup (G := G) ∞
  have hinf : IsClosed ((K ⊓ K' : Subgroup G) : Set G) := by
    rw [Subgroup.coe_inf]
    exact hK.inter hK'
  ext ξ
  simp only [LieSubalgebra.mem_inf, mem_groupLieSubalgebra hinf, mem_groupLieSubalgebra hK,
    mem_groupLieSubalgebra hK', Subgroup.mem_inf, forall_and]

omit [T2Space G] in
/-- The Lie algebra of the trivial subgroup is zero. -/
@[simp]
theorem _root_.Subgroup.groupLieSubalgebra_bot :
    (⊥ : Subgroup G).groupLieSubalgebra (I := I) = ⊥ := by
  have := I.t2Space_of_lieGroup (G := G) ∞
  have h₁ := ContMDiffMul.isInteriorPoint (I := I) (n := ∞) (by simp) (1 : G)
  refine eq_bot_iff.mpr fun ξ hξ ↦ ?_
  rw [mem_groupLieSubalgebra_iff, lieSubalgebraOfSubgroup_eq_bot_of_isTotallyDisconnected
      (by simpa using isTotallyDisconnected_singleton), LieSubalgebra.mem_bot,
    ← leftInvariantDerivationLieEquivGroupLieAlgebra_symm_apply h₁] at hξ
  -- Evaluation at the identity inverts `tangentToLeftInvariantDerivation`.
  have h := congrArg (leftInvariantDerivationLieEquivGroupLieAlgebra (I := I) h₁) hξ
  rwa [LieEquiv.apply_symm_apply, map_zero, ← LieSubalgebra.mem_bot (R := ℝ)] at h

omit [T2Space G] in
/-- The Lie algebra of the whole group is the whole tangent Lie algebra. -/
@[simp]
theorem _root_.Subgroup.groupLieSubalgebra_top :
    (⊤ : Subgroup G).groupLieSubalgebra (I := I) = ⊤ := by
  have := I.t2Space_of_lieGroup (G := G) ∞
  exact eq_top_iff.mpr fun _ _ ↦ mem_groupLieSubalgebra_of_forall fun _ ↦ Subgroup.mem_top _

end TauCeti.Lie
