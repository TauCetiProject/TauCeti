module

public import TauCeti.Geometry.Lie.Adjoint.Units.Basic
public import TauCeti.Geometry.Lie.Subgroup.LieAlgebra

/-!
# The Lie algebra of a closed subgroup of the units of a normed algebra

For the Lie group `Rˣ` of units of a finite-dimensional real normed algebra, the canonical
identification `TauCeti.Lie.unitsLieAlgebraLieEquiv` of its Lie algebra with `R` turns the
abstract exponential into the Banach-algebra exponential `TauCeti.expUnit`. This file reads
`TauCeti.Lie.lieSubalgebraOfSubgroup` through that identification, so that a subgroup of `Rˣ` given
by a condition on algebra elements can have its Lie algebra computed entirely inside `R`.

## Main results

* `TauCeti.Lie.forall_lieExp_unitsLieAlgebraLieEquiv_symm_smul_mem_iff`: the abstract exponential
  line of `x : R` is the Banach-algebra exponential line.
* `TauCeti.Lie.unitsLieAlgebraLieEquiv_symm_mem_lieSubalgebraOfSubgroup_iff`: for a closed
  subgroup, membership in its Lie algebra is that exponential line staying inside the subgroup.
-/

public section

open Manifold
open scoped ContDiff Manifold

noncomputable section

namespace TauCeti.Lie

attribute [local instance] TauCeti.normedAlgebraRatOfReal

attribute [local instance 100] LieRing.ofAssociativeRing

variable {R : Type*} [NormedRing R] [NormedAlgebra ℝ R] [FiniteDimensional ℝ R]

local instance finiteDimensionalCompleteSpaceSubgroupUnits : CompleteSpace R :=
  FiniteDimensional.complete ℝ R

/-- Read through `TauCeti.Lie.unitsLieAlgebraLieEquiv`, the abstract one-parameter subgroup
generated by `x : R` is the Banach-algebra exponential line `t ↦ expUnit (t • x)`. No hypothesis on
the subgroup is needed. -/
theorem forall_lieExp_unitsLieAlgebraLieEquiv_symm_smul_mem_iff (K : Subgroup Rˣ) (x : R) :
    (∀ t : ℝ, lieExp ((unitsLieAlgebraLieEquiv (R := R)).symm (t • x)) ∈ K) ↔
      ∀ t : ℝ, TauCeti.expUnit (t • x) ∈ K := by
  simp only [unitsLieAlgebraLieEquiv_symm_apply, lieExp_eq_expUnit,
    LinearEquiv.apply_symm_apply]

/-- **The Lie algebra of a closed subgroup of `Rˣ`, in algebra coordinates.** An element of `R`
lies in the Lie algebra of a closed subgroup `K` exactly when the Banach-algebra exponential line
it generates stays inside `K`. -/
theorem unitsLieAlgebraLieEquiv_symm_mem_lieSubalgebraOfSubgroup_iff {K : Subgroup Rˣ}
    (hK : IsClosed (K : Set Rˣ)) (x : R) :
    (unitsLieAlgebraLieEquiv (R := R)).symm x ∈
        lieSubalgebraOfSubgroup (I := 𝓘(ℝ, R)) K ↔
      ∀ t : ℝ, TauCeti.expUnit (t • x) ∈ K := by
  rw [mem_lieSubalgebraOfSubgroup hK,
    ← forall_lieExp_unitsLieAlgebraLieEquiv_symm_smul_mem_iff K x]
  simp only [map_smul]

end TauCeti.Lie
