/-!
# Lie algebra of the real special orthogonal group

This file identifies the one-parameter subgroups of the real special orthogonal group in its
canonical general-linear coordinates. A real matrix generates such a subgroup exactly when it is
skew-symmetric.

For a skew-symmetric matrix, transposition of the matrix exponential proves orthogonality. Its
determinant is continuously constrained to the two square roots of one and equals one at the
identity, so the whole exponential line lies in the special orthogonal group. Conversely,
orthogonality of the exponential line identifies the exponential homomorphisms generated by the
transpose and the negative matrix; injectivity of the exponential-line construction then recovers
skew-symmetry.

## Main results

* `Matrix.forall_exp_smul_mem_specialOrthogonalGroup_iff_mem_so` characterizes the matrices whose
  exponential lines lie in the matrix special orthogonal group.
* `TauCeti.QuadraticMap.mem_range_specialOrthogonalToGeneralLinear_realCliffordForm_iff` identifies
  the existing quadratic-form carrier with the matrix special orthogonal group.
* `TauCeti.Lie.forall_lieExp_mem_realSpecialOrthogonal_iff_mem_so` combines these descriptions in
  the canonical Lie-algebra coordinates of the general linear group.
-/

public section

open Manifold NormedSpace
open scoped ContDiff Manifold Matrix Matrix.Norms.Operator

noncomputable section

namespace Matrix

variable {n : Type*} [Fintype n] [DecidableEq n]

private theorem exp_neg_mul_exp (A : Matrix n n ℝ) : exp (-A) * exp A = 1 := by
  rw [← Matrix.exp_add_of_commute (-A) A (Commute.refl A).neg_left]
  simp

private theorem det_exp_smul_eq_one_of_transpose_eq_neg (A : Matrix n n ℝ)
    (hA : Aᵀ = -A) (t : ℝ) : (exp (t • A)).det = 1 := by
  have horth : ∀ s : ℝ, exp (s • A) ∈ orthogonalGroup n ℝ := by
    intro s
    rw [mem_orthogonalGroup_iff']
    rw [← exp_transpose, transpose_smul, hA, smul_neg]
    exact exp_neg_mul_exp _
  have hsq : Set.EqOn ((fun s : ℝ => (exp (s • A)).det) ^ 2) 1 Set.univ := by
    intro s _
    change (exp (s • A)).det ^ 2 = 1
    have horth' := (Matrix.mem_orthogonalGroup_iff' (A := exp (s • A))).mp (horth s)
    have hdet := congrArg Matrix.det horth'
    simpa only [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one, pow_two] using hdet
  have hsq' : Set.EqOn ((fun s : ℝ => (exp (s • A)).det) ^ 2)
      ((fun _ : ℝ => (1 : ℝ)) ^ 2) Set.univ := by
    intro s hs
    simpa using hsq hs
  exact ((isPreconnected_univ : IsPreconnected (Set.univ : Set ℝ)).eq_of_sq_eq
    (f := fun s : ℝ => (exp (s • A)).det) (g := fun _ : ℝ => (1 : ℝ))
    ((differentiable_exp_smul_const ℝ A).continuous.matrix_det.continuousOn)
    continuous_const.continuousOn hsq' (by intro _ _; norm_num)
    (y := 0) (by simp) (by simp)) (Set.mem_univ t)

/-- A real matrix generates a one-parameter subgroup of the special orthogonal group exactly when
it is skew-symmetric. -/
theorem forall_exp_smul_mem_specialOrthogonalGroup_iff_mem_so (A : Matrix n n ℝ) :
    (∀ t : ℝ, exp (t • A) ∈ specialOrthogonalGroup n ℝ) ↔
      A ∈ LieAlgebra.Orthogonal.so n ℝ := by
  rw [LieAlgebra.Orthogonal.mem_so]
  constructor
  · intro h
    apply TauCeti.expUnitHom_injective (R := Matrix n n ℝ)
    apply ContinuousMonoidHom.ext
    intro t
    apply Units.ext
    rw [show t = Multiplicative.ofAdd (Multiplicative.toAdd t) by rfl]
    simp only [TauCeti.expUnitHom_apply, TauCeti.expUnit_coe]
    have horth := (Matrix.mem_specialOrthogonalGroup_iff.mp (h (Multiplicative.toAdd t))).1
    rw [Matrix.mem_orthogonalGroup_iff'] at horth
    calc
      exp ((Multiplicative.toAdd t) • Aᵀ) =
          exp (((Multiplicative.toAdd t) • A)ᵀ) := by rw [Matrix.transpose_smul]
      _ = (exp ((Multiplicative.toAdd t) • A))ᵀ := Matrix.exp_transpose _
      _ = exp ((Multiplicative.toAdd t) • (-A)) := by
        rw [smul_neg]
        apply (Matrix.isUnit_exp ((Multiplicative.toAdd t) • A)).mul_right_cancel
        exact horth.trans (exp_neg_mul_exp _).symm
  · intro hA t
    rw [Matrix.mem_specialOrthogonalGroup_iff]
    refine ⟨?_, det_exp_smul_eq_one_of_transpose_eq_neg A hA t⟩
    rw [Matrix.mem_orthogonalGroup_iff']
    rw [← Matrix.exp_transpose, Matrix.transpose_smul, hA, smul_neg]
    exact exp_neg_mul_exp _

end Matrix

namespace TauCeti.QuadraticMap

/-- Membership in the real quadratic-form special orthogonal carrier is matrix membership in the
special orthogonal group. -/
theorem mem_range_specialOrthogonalToGeneralLinear_realCliffordForm_iff
    (n : ℕ) (U : Matrix.GeneralLinearGroup (Fin n) ℝ) :
    U ∈ MonoidHom.range (specialOrthogonalToGeneralLinear (realCliffordForm n 0)) ↔
      (U : Matrix (Fin n) (Fin n) ℝ) ∈ Matrix.specialOrthogonalGroup (Fin n) ℝ := by
  classical
  rw [realCliffordForm_zero_eq_weightedSumSquares_one]
  constructor
  · rintro ⟨g, rfl⟩
    rw [show ((specialOrthogonalToGeneralLinear
        (_root_.QuadraticMap.weightedSumSquares ℝ (1 : Fin n → ℝ))) g :
          Matrix.GeneralLinearGroup (Fin n) ℝ) =
        LinearMap.toMatrix' (g : (Fin n → ℝ) ≃ₗ[ℝ] (Fin n → ℝ)).toLinearMap by
      ext i j
      rw [specialOrthogonalToGeneralLinear_apply]
      simp [LinearMap.toMatrix'_apply]]
    apply (TauCeti.toMatrix_mem_specialOrthogonalGroup_iff ℝ (Fin n)
      ((isUnit_of_invertible (2 : ℝ)).isSMulRegular ℝ) _).mpr
    simpa only [weightedSumSquares_eq_toQuadraticForm_diagonal, Matrix.diagonal_one'] using g.prop
  · intro hU
    let A : Matrix.specialOrthogonalGroup (Fin n) ℝ := ⟨(U : Matrix (Fin n) (Fin n) ℝ), hU⟩
    let V : Matrix.orthogonalGroup (Fin n) ℝ := ⟨A, A.prop.1⟩
    let e : (Fin n → ℝ) ≃ₗ[ℝ] (Fin n → ℝ) := Matrix.UnitaryGroup.toLinearEquiv V
    let g : specialOrthogonalGroup
        (_root_.QuadraticMap.weightedSumSquares ℝ (1 : Fin n → ℝ)) := ⟨e, by
      rw [weightedSumSquares_eq_toQuadraticForm_diagonal, Matrix.diagonal_one']
      apply (TauCeti.toMatrix_mem_specialOrthogonalGroup_iff ℝ (Fin n)
        ((isUnit_of_invertible (2 : ℝ)).isSMulRegular ℝ) e).mp
      simpa only [e, V, A, Matrix.UnitaryGroup.toLinearEquiv,
        Matrix.UnitaryGroup.toLin', LinearMap.toMatrix'_toLin'] using hU⟩
    refine ⟨g, ?_⟩
    apply Units.ext
    ext i j
    rw [specialOrthogonalToGeneralLinear_apply]
    simp [g, e, V, A, Matrix.UnitaryGroup.toLinearEquiv,
      Matrix.UnitaryGroup.toLin', Matrix.toLin'_apply, Matrix.mulVec]

end TauCeti.QuadraticMap

namespace TauCeti.Lie

attribute [local instance 100] LieRing.ofAssociativeRing

/-- In the canonical matrix coordinates of the general linear Lie algebra, an element generates a
one-parameter subgroup in the real special orthogonal carrier exactly when it is skew-symmetric. -/
theorem forall_lieExp_mem_realSpecialOrthogonal_iff_mem_so
    (n : ℕ) (A : Matrix (Fin n) (Fin n) ℝ) :
    (∀ t : ℝ, lieExp ((unitsLieAlgebraLieEquiv
        (R := Matrix (Fin n) (Fin n) ℝ)).symm (t • A)) ∈
      MonoidHom.range (QuadraticMap.specialOrthogonalToGeneralLinear
        (realCliffordForm n 0))) ↔
      A ∈ LieAlgebra.Orthogonal.so (Fin n) ℝ := by
  rw [← Matrix.forall_exp_smul_mem_specialOrthogonalGroup_iff_mem_so]
  constructor
  · intro h t
    have ht := h t
    rw [QuadraticMap.mem_range_specialOrthogonalToGeneralLinear_realCliffordForm_iff] at ht
    simpa only [unitsLieAlgebraLieEquiv_symm_apply,
      lieExp_generalLinearGroup_coe] using ht
  · intro h t
    rw [QuadraticMap.mem_range_specialOrthogonalToGeneralLinear_realCliffordForm_iff]
    simpa only [unitsLieAlgebraLieEquiv_symm_apply,
      lieExp_generalLinearGroup_coe] using h t

end TauCeti.Lie
