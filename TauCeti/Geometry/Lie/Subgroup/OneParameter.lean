/-!
# Closed one-parameter subgroups

For an element `ξ` of the Lie algebra `𝔤 = GroupLieAlgebra I G` of a Lie group `G`, the
**closed one-parameter subgroup** `T_ξ` generated by `ξ`
(`TauCeti.Lie.closedOneParameterSubgroup ξ`) is the topological closure of the one-parameter
subgroup `{exp (t ξ) | t ∈ ℝ}`. It is the smallest closed subgroup of `G` containing every
`exp (t ξ)`, and it is commutative and connected, so in a compact group it is a torus. It can be
much larger than the curve `t ↦ exp (t ξ)`: an irrational direction in a torus generates a dense
one-parameter subgroup.

A closed subgroup contains `T_ξ` exactly when it contains every `exp (t ξ)`
(`TauCeti.Lie.closedOneParameterSubgroup_le`). This is how `T_ξ` enters the fixed-point sets of
group actions: a point fixed by every `exp (t ξ)` is fixed by `T_ξ`, because stabilizers of
continuous actions are closed.

In a compact connected commutative Lie group, `exp (ξ)` is a topological generator for a dense set
of `ξ` by Kronecker's theorem (`TauCeti.closedZpowers_lieExp_eq_top_iff`), and the cyclic
subgroup it generates lies in `T_ξ`. Hence **the `ξ` with `T_ξ = G` are dense in `𝔤`**
(`TauCeti.Lie.dense_setOf_closedOneParameterSubgroup_eq_top`): a generic one-parameter subgroup of
a torus is dense in it.

## Main definitions

* `TauCeti.Lie.closedOneParameterSubgroup ξ`: the closure `T_ξ` of `{exp (t ξ) | t ∈ ℝ}`.

## Main results

* `TauCeti.Lie.range_mulInvariantOneParameterSubgroup`: the one-parameter subgroup generated by `ξ`
  is the curve `t ↦ exp (t ξ)`.
* `TauCeti.Lie.closedOneParameterSubgroup_le`: a closed subgroup contains `T_ξ` exactly when it
  contains every `exp (t ξ)`.
* `TauCeti.Lie.isConnected_closedOneParameterSubgroup` and
  `TauCeti.Lie.instIsMulCommutativeClosedOneParameterSubgroup`: `T_ξ` is connected and
  commutative.
* `TauCeti.Lie.isTorus_closedOneParameterSubgroup`: in a compact group, `T_ξ` is a torus.
* `TauCeti.Lie.closedOneParameterSubgroup_smul`: `T_{c ξ} = T_ξ` for `c ≠ 0`.
* `TauCeti.Lie.dense_setOf_closedOneParameterSubgroup_eq_top`: in a compact connected commutative
  Lie group, the `ξ` with `T_ξ = G` are dense.

## References

* T. Bröcker and T. tom Dieck, *Representations of Compact Lie Groups*, Springer GTM 98 (1985),
  Chapter I, § 4, Theorem (4.13) (Kronecker's theorem), and Chapter IV, § 1.
-/

public section

noncomputable section

open scoped ContDiff Manifold

namespace TauCeti.Lie

section Definition

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [LieGroup I (minSmoothness ℝ 3) G] [IsManifold I 1 G] [T2Space G] [BoundarylessManifold I G]
  [IsTopologicalGroup G]

omit [IsTopologicalGroup G] in
/-- The canonical one-parameter subgroup traces out the curve `t ↦ exp (t ξ)`. -/
theorem range_mulInvariantOneParameterSubgroup (ξ : GroupLieAlgebra I G) :
    Set.range (mulInvariantOneParameterSubgroup ξ) =
      Set.range fun t : ℝ ↦ mulInvariantExp (t • ξ) := by
  rw [← Multiplicative.ofAdd.surjective.range_comp]
  exact congrArg Set.range (funext (mulInvariantOneParameterSubgroup_eq_mulInvariantExp_smul ξ))

/-- The **closed one-parameter subgroup** `T_ξ` generated by `ξ ∈ 𝔤`: the topological closure of
the one-parameter subgroup `{exp (t ξ) | t ∈ ℝ}`. -/
def closedOneParameterSubgroup (ξ : GroupLieAlgebra I G) : Subgroup G :=
  (mulInvariantOneParameterSubgroup ξ).toMonoidHom.range.topologicalClosure

/-- The closed one-parameter subgroup is the closure of the range of the one-parameter
subgroup. -/
theorem closedOneParameterSubgroup_def (ξ : GroupLieAlgebra I G) :
    closedOneParameterSubgroup ξ =
      (mulInvariantOneParameterSubgroup ξ).toMonoidHom.range.topologicalClosure :=
  (rfl)

/-- As a set, `T_ξ` is the closure of the curve `t ↦ exp (t ξ)`. -/
theorem coe_closedOneParameterSubgroup (ξ : GroupLieAlgebra I G) :
    (closedOneParameterSubgroup ξ : Set G) =
      closure (Set.range fun t : ℝ ↦ mulInvariantExp (t • ξ)) := by
  rw [closedOneParameterSubgroup_def, Subgroup.topologicalClosure_coe, MonoidHom.coe_range,
    ContinuousMonoidHom.coe_toMonoidHom, MonoidHom.coe_ofClass,
    range_mulInvariantOneParameterSubgroup]

/-- The closed one-parameter subgroup is closed. -/
theorem isClosed_closedOneParameterSubgroup (ξ : GroupLieAlgebra I G) :
    IsClosed (closedOneParameterSubgroup ξ : Set G) :=
  Subgroup.isClosed_topologicalClosure _

/-- Every `exp (t ξ)` lies in `T_ξ`. -/
@[simp]
theorem mulInvariantExp_smul_mem_closedOneParameterSubgroup (ξ : GroupLieAlgebra I G) (t : ℝ) :
    mulInvariantExp (t • ξ) ∈ closedOneParameterSubgroup ξ := by
  rw [← SetLike.mem_coe, coe_closedOneParameterSubgroup]
  exact subset_closure ⟨t, rfl⟩

/-- `exp ξ` lies in `T_ξ`. -/
@[simp]
theorem mulInvariantExp_mem_closedOneParameterSubgroup (ξ : GroupLieAlgebra I G) :
    mulInvariantExp ξ ∈ closedOneParameterSubgroup ξ := by
  simpa using mulInvariantExp_smul_mem_closedOneParameterSubgroup ξ 1

/-- **`T_ξ` is the smallest closed subgroup containing every `exp (t ξ)`.** A closed subgroup
contains `T_ξ` exactly when it contains `exp (t ξ)` for every `t`. -/
theorem closedOneParameterSubgroup_le {ξ : GroupLieAlgebra I G} {K : Subgroup G}
    (hK : IsClosed (K : Set G)) :
    closedOneParameterSubgroup ξ ≤ K ↔ ∀ t : ℝ, mulInvariantExp (t • ξ) ∈ K := by
  refine ⟨fun h t ↦ h (mulInvariantExp_smul_mem_closedOneParameterSubgroup ξ t), fun h ↦ ?_⟩
  rw [← SetLike.coe_subset_coe, coe_closedOneParameterSubgroup]
  exact closure_minimal (Set.range_subset_iff.2 h) hK

/-- The closed cyclic subgroup generated by `exp ξ` lies in `T_ξ`. -/
theorem closedZpowers_mulInvariantExp_le (ξ : GroupLieAlgebra I G) :
    closedZpowers (mulInvariantExp ξ) ≤ closedOneParameterSubgroup ξ :=
  (closedZpowers_le (isClosed_closedOneParameterSubgroup ξ)).2
    (mulInvariantExp_mem_closedOneParameterSubgroup ξ)

/-- Rescaling the generator by a nonzero real number does not change the closed one-parameter
subgroup: `T_{c ξ} = T_ξ`. -/
theorem closedOneParameterSubgroup_smul {c : ℝ} (hc : c ≠ 0) (ξ : GroupLieAlgebra I G) :
    closedOneParameterSubgroup (c • ξ) = closedOneParameterSubgroup ξ := by
  -- Each one-parameter subgroup is a reparametrization of the other.
  have key : ∀ {c : ℝ} (ξ : GroupLieAlgebra I G),
      closedOneParameterSubgroup (c • ξ) ≤ closedOneParameterSubgroup ξ := fun {c} ξ ↦ by
    rw [closedOneParameterSubgroup_le (isClosed_closedOneParameterSubgroup ξ)]
    intro t
    simpa only [smul_smul] using mulInvariantExp_smul_mem_closedOneParameterSubgroup ξ (t * c)
  refine (key ξ).antisymm ?_
  simpa only [smul_smul, inv_mul_cancel₀ hc, one_smul] using key (c := c⁻¹) (c • ξ)

/-- The zero element generates the trivial closed one-parameter subgroup. -/
@[simp]
theorem closedOneParameterSubgroup_zero :
    closedOneParameterSubgroup (0 : GroupLieAlgebra I G) = ⊥ := by
  refine le_bot_iff.1 ((closedOneParameterSubgroup_le ?_).2 fun t ↦ ?_)
  · simp
  · rw [smul_zero, Subgroup.mem_bot, ← zero_smul ℝ (0 : GroupLieAlgebra I G),
      ← mulInvariantOneParameterSubgroup_eq_mulInvariantExp_smul, ofAdd_zero, map_one]

/-- The closed one-parameter subgroup is connected, as the closure of the image of `ℝ`. -/
theorem isConnected_closedOneParameterSubgroup (ξ : GroupLieAlgebra I G) :
    IsConnected (closedOneParameterSubgroup ξ : Set G) := by
  rw [coe_closedOneParameterSubgroup]
  exact (isConnected_range (((mulInvariantOneParameterSubgroup ξ).continuous.comp
    continuous_ofAdd).congr (mulInvariantOneParameterSubgroup_eq_mulInvariantExp_smul ξ))).closure

/-- The closed one-parameter subgroup is commutative, as the closure of the image of the
commutative group `ℝ`. -/
instance instIsMulCommutativeClosedOneParameterSubgroup (ξ : GroupLieAlgebra I G) :
    IsMulCommutative (closedOneParameterSubgroup ξ) := by
  have : IsMulCommutative (mulInvariantOneParameterSubgroup ξ).toMonoidHom.range := by
    rw [MonoidHom.range_eq_map]
    infer_instance
  rw [closedOneParameterSubgroup_def]
  infer_instance

/-- **In a compact group, the closed one-parameter subgroup is a torus.** -/
theorem isTorus_closedOneParameterSubgroup [CompactSpace G] (ξ : GroupLieAlgebra I G) :
    IsTorus (closedOneParameterSubgroup ξ) where
  isCompact := (isClosed_closedOneParameterSubgroup ξ).isCompact
  isConnected := isConnected_closedOneParameterSubgroup ξ
  isMulCommutative := inferInstance

end Definition

section Kronecker

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G] [T2Space G]
  [IsTopologicalGroup G]

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold

variable (I G) in
/-- **Generic one-parameter subgroups of a torus are dense.** In a compact connected commutative
Lie group `G`, the elements `ξ` of the Lie algebra whose one-parameter subgroup is dense in `G`,
`T_ξ = G`, form a dense subset of the Lie algebra. -/
theorem dense_setOf_closedOneParameterSubgroup_eq_top [IsMulCommutative G] [CompactSpace G]
    [PreconnectedSpace G] :
    Dense {ξ : GroupLieAlgebra I G | closedOneParameterSubgroup ξ = ⊤} := by
  have : FiniteDimensional ℝ (LeftInvariantDerivation I G) :=
    finiteDimensional_leftInvariantDerivation BoundarylessManifold.isInteriorPoint
  let e := leftInvariantDerivationEquivGroupLieAlgebra (I := I) (G := G)
    BoundarylessManifold.isInteriorPoint
  -- Kronecker: the derivations `X` with `Λ + ℤ X` dense, `Λ = ker exp`, form a dense set, and for
  -- each of them `exp X` is a topological generator of `G`.
  have hgen := AddSubgroup.dense_setOfPred_dense_sup
    (span_ker_lieExpAddMonoidHom_eq_top (I := I) (G := G))
  refine ((e.surjective.denseRange).dense_image (LinearMap.continuous_of_finiteDimensional
    e.toLinearMap) hgen).mono ?_
  rintro _ ⟨X, hX, rfl⟩
  have htop : closedZpowers (lieExp (I := I) X) = ⊤ := (closedZpowers_lieExp_eq_top_iff X).2 hX
  rw [lieExp_eq_mulInvariantExp] at htop
  exact top_le_iff.1 (htop ▸ closedZpowers_mulInvariantExp_le (e X))

end Kronecker

end TauCeti.Lie
