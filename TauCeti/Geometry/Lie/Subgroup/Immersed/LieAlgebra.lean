section Span

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G] [T2Space G]

/-- **The bracket of two directions of `K` lies in their span**, for every subgroup `K`: the
adjoint orbit `s ↦ Ad (lieExp (s • X)) Y` runs inside the directions of `K` and has derivative
`⁅X, Y⁆` at `0`, and the span is a closed subspace containing its difference quotients. -/
theorem lie_mem_span_setOf_forall_lieExp_smul_mem {K : Subgroup G}
    {X Y : LeftInvariantDerivation I G} (hX : ∀ t : ℝ, lieExp (I := I) (t • X) ∈ K)
    (hY : ∀ t : ℝ, lieExp (I := I) (t • Y) ∈ K) :
    ⁅X, Y⁆ ∈ Submodule.span ℝ {Z : LeftInvariantDerivation I G | ∀ t : ℝ, lieExp (t • Z) ∈ K} := by
  have : FiniteDimensional ℝ (LeftInvariantDerivation I G) :=
    finiteDimensional_leftInvariantDerivation BoundarylessManifold.isInteriorPoint
  set S := Submodule.span ℝ {Z : LeftInvariantDerivation I G | ∀ t : ℝ, lieExp (t • Z) ∈ K}
  set φ : ℝ → LeftInvariantDerivation I G := fun s ↦ Ad (I := I) (lieExp (I := I) (s • X)) Y
    with hφ
  have hφmem (s : ℝ) : φ s ∈ S :=
    Submodule.subset_span (lieExp_smul_Ad_mem (Subgroup.le_normalizer (hX s)) hY)
  have hφzero : φ 0 = Y := by simp [hφ]
  have hslope (s : ℝ) : slope φ 0 s ∈ S := by
    rw [slope_def_module]
    exact S.smul_mem _ (S.sub_mem (hφmem s) (hφzero ▸ hφmem 0))
  exact (Submodule.isClosed_of_finiteDimensional S).mem_of_tendsto
    (hasDerivAt_iff_tendsto_slope.mp (hasDerivAt_Ad_lieExp_smul_apply_zero X Y))
    (Filter.Eventually.of_forall hslope)

/-- **The Lie algebra of an arbitrary subgroup is the span of its directions.** For every
subgroup `K`, closed or not, the Lie subalgebra generated by the derivations whose one-parameter
subgroup lies in `K` is their linear span: the span is already closed under the bracket. -/
theorem lieSubalgebraOfSubgroup_toSubmodule (K : Subgroup G) :
    (lieSubalgebraOfSubgroup (I := I) K).toSubmodule =
      Submodule.span ℝ {Z : LeftInvariantDerivation I G | ∀ t : ℝ, lieExp (t • Z) ∈ K} := by
  set A := {Z : LeftInvariantDerivation I G | ∀ t : ℝ, lieExp (t • Z) ∈ K}
  -- The bracket, as a bilinear map, carries the span of `A` into itself.
  let f : LeftInvariantDerivation I G →ₗ[ℝ] LeftInvariantDerivation I G →ₗ[ℝ]
      LeftInvariantDerivation I G :=
    LinearMap.mk₂ ℝ (fun X Y ↦ ⁅X, Y⁆) add_lie smul_lie lie_add lie_smul
  have hmap₂ : Submodule.map₂ f (Submodule.span ℝ A) (Submodule.span ℝ A) ≤
      Submodule.span ℝ A := by
    rw [Submodule.map₂_span_span, Submodule.span_le]
    rintro _ ⟨X, hX, Y, hY, rfl⟩
    exact lie_mem_span_setOf_forall_lieExp_smul_mem hX hY
  let L : LieSubalgebra ℝ (LeftInvariantDerivation I G) :=
    { Submodule.span ℝ A with
      lie_mem' := fun {X Y} hX hY ↦ hmap₂ (Submodule.apply_mem_map₂ f hX hY) }
  refine le_antisymm ?_ (Submodule.span_le.mpr fun _ ↦ mem_lieSubalgebraOfSubgroup_of_forall)
  exact (lieSubalgebraOfSubgroup_le_iff (L := L)).mpr fun _ hX ↦ Submodule.subset_span hX

end Span

section Leaf

attribute [local instance] ImmersedLieSubgroupData.group
  ImmersedLieSubgroupData.topologicalSpace ImmersedLieSubgroupData.normedAddCommGroup
  ImmersedLieSubgroupData.normedSpace ImmersedLieSubgroupData.finiteDimensional
  ImmersedLieSubgroupData.modelTopology ImmersedLieSubgroupData.chartedSpace
  ImmersedLieSubgroupData.lieGroup ImmersedLieSubgroupData.connectedSpace

universe w

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {G : Type w} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]
  [SecondCountableTopology G] [T2Space G]

/-- **The integral leaf subgroup of the Lie algebra of `K` lies in `K`**, for every subgroup `K`,
closed or not. The leaf is a connected Lie group whose Lie algebra is spanned by the derivations
mapping to directions of `K`, so it is generated by their one-parameter subgroups, all of which
are carried into `K`. -/
theorem integralLeafSubgroup_lieSubalgebraOfSubgroup_le (K : Subgroup G) :
    (lieSubalgebraOfSubgroup (I := I) K).integralLeafSubgroup (I := I) ≤ K := by
  set S := lieSubalgebraOfSubgroup (I := I) K
  set d := S.integralLeafSubgroupData (I := I)
  set f := d.lieMapToHom.toLinearMap
  set A := {Y : LeftInvariantDerivation d.I' d.X | ∀ t : ℝ, lieExp (t • d.lieMapToHom Y) ∈ K}
  -- The derivations of the leaf mapping to directions of `K` span its Lie algebra.
  have hA : Submodule.span ℝ A = ⊤ := by
    refine Submodule.map_injective_of_injective (f := f) d.injective_lieMapToHom ?_
    rw [Submodule.map_span, Submodule.map_top]
    have himage : f '' A = {Z : LeftInvariantDerivation I G | ∀ t : ℝ, lieExp (t • Z) ∈ K} := by
      change f '' (f ⁻¹' {Z : LeftInvariantDerivation I G | ∀ t : ℝ, lieExp (t • Z) ∈ K}) = _
      refine image_preimage_eq_of_subset fun Z hZ ↦ ?_
      have hZS : Z ∈ d.lieMapToHom.range := by
        rw [S.range_lieMapToHom_integralLeafSubgroupData]
        exact mem_lieSubalgebraOfSubgroup_of_forall hZ
      exact hZS
    rw [himage, ← lieSubalgebraOfSubgroup_toSubmodule]
    have h := congrArg LieSubalgebra.toSubmodule S.range_lieMapToHom_integralLeafSubgroupData
    rw [LieHom.range_toSubmodule] at h
    exact h.symm
  -- So their one-parameter subgroups generate the leaf, and each is carried into `K`.
  have hle : Subgroup.closure (⋃ Y ∈ A, range fun t : ℝ ↦ lieExp (t • Y)) ≤ K.comap d.toHom := by
    rw [Subgroup.closure_le]
    rintro _ hg
    obtain ⟨Y, hY, t, rfl⟩ := mem_iUnion₂.mp hg
    simpa only [SetLike.mem_coe, Subgroup.mem_comap, d.toHom_lieExp, map_smul] using hY t
  rw [TauCeti.closure_iUnion_range_lieExp_smul_eq_top hA, top_le_iff] at hle
  rintro _ hg
  rw [← d.range_eq] at hg
  obtain ⟨x, rfl⟩ := hg
  exact Subgroup.mem_comap.mp (hle ▸ Subgroup.mem_top x)

/-- **The Lie algebra of an arbitrary subgroup.** For every subgroup `K` of a second-countable Lie
group, closed or not, a derivation lies in the Lie algebra of `K` exactly when its one-parameter
subgroup lies in `K`: the set of such derivations is already a Lie subalgebra. For closed `K` this
is `TauCeti.Lie.mem_lieSubalgebraOfSubgroup`. -/
theorem mem_lieSubalgebraOfSubgroup_iff (K : Subgroup G) (X : LeftInvariantDerivation I G) :
    X ∈ lieSubalgebraOfSubgroup (I := I) K ↔ ∀ t : ℝ, lieExp (I := I) (t • X) ∈ K :=
  ⟨fun hX t ↦ integralLeafSubgroup_lieSubalgebraOfSubgroup_le K
      (LieSubalgebra.lieExp_mem_integralLeafSubgroup (LieSubalgebra.smul_mem _ t hX)),
    mem_lieSubalgebraOfSubgroup_of_forall⟩

end Leaf

end TauCeti.Lie
