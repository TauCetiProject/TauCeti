public import TauCeti.Geometry.Lie.Subgroup.Immersed.Existence

/-!
# The Lie algebra of an arbitrary subgroup

For a subgroup `K` of a Lie group `G`, closed or not, let
`𝔨 = {X : 𝔤 | ∀ t : ℝ, lieExp (t • X) ∈ K}` be the set of derivations whose one-parameter subgroup
lies in `K`. `TauCeti.Lie.lieSubalgebraOfSubgroup K` is the Lie subalgebra generated by `𝔨`, and
for a closed `K` the generation adds nothing (`TauCeti.Lie.mem_lieSubalgebraOfSubgroup`). This
file proves that it adds nothing for every subgroup `K` of a second-countable `G`
(`TauCeti.Lie.mem_lieSubalgebraOfSubgroup_iff`): `𝔨` is itself a Lie subalgebra.

The proof has two steps.

* **The linear span of `𝔨` is a Lie subalgebra**, for every subgroup and with no countability
  hypothesis, so `S = Lie(K)` is that span (`TauCeti.Lie.lieSubalgebraOfSubgroup_toSubmodule`, in
  `TauCeti.Geometry.Lie.Subgroup.LieAlgebra`).
* **The integral leaf subgroup of `S = Lie(K)` lies in `K`**
  (`TauCeti.Lie.integralLeafSubgroup_lieSubalgebraOfSubgroup_le`). Present the leaf as a connected
  Lie group `L` with an injective immersive homomorphism `L → G` whose differential maps `Lie(L)`
  isomorphically onto `S`. The derivations of `L` whose image lies in `𝔨` span `Lie(L)`, since `𝔨`
  spans `S`, so their one-parameter subgroups generate `L`
  (`TauCeti.closure_biUnion_range_lieExp_smul_eq_top`). Each of those one-parameter subgroups is
  carried into `K`, hence so is all of `L`.

For `X ∈ S` the one-parameter subgroup of `X` lies in the integral leaf subgroup of `S`, hence in
`K`, which is the theorem. The integral leaf subgroup is used only for its Lie group structure,
which is where second countability of `G` enters.

## Main results

* `TauCeti.Lie.integralLeafSubgroup_lieSubalgebraOfSubgroup_le`: the integral leaf subgroup of the
  Lie algebra of `K` lies in `K`.
* `TauCeti.Lie.mem_lieSubalgebraOfSubgroup_iff` and
  `TauCeti.Lie.coe_lieSubalgebraOfSubgroup_of_secondCountableTopology`: for every subgroup `K`,
  closed or not, the Lie algebra of `K` is exactly `𝔨`.

## References

* K.-H. Neeb, *Towards a Lie theory of locally convex groups*, Jpn. J. Math. 1 (2006),
  Remark II.6.5(b), for finite-dimensional groups through Yamabe's theorem.
* J. Hilgert and K.-H. Neeb, *Structure and Geometry of Lie Groups*, Springer (2012),
  Section 9.1, for the Lie algebra of a subgroup.
* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Springer (2013), Theorem 19.26, for the
  connected Lie subgroup of a Lie subalgebra as an integral leaf.
-/

public section

noncomputable section

open Set
open scoped ContDiff Manifold

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold

namespace TauCeti.Lie

section Leaf

attribute [local instance] ImmersedLieSubgroupData.group
  ImmersedLieSubgroupData.topologicalSpace ImmersedLieSubgroupData.normedAddCommGroup
  ImmersedLieSubgroupData.normedSpace ImmersedLieSubgroupData.finiteDimensional
  ImmersedLieSubgroupData.modelTopology ImmersedLieSubgroupData.chartedSpace
  ImmersedLieSubgroupData.lieGroup ImmersedLieSubgroupData.connectedSpace

universe w

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {G : Type w} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]
  [SecondCountableTopology G] [T2Space G]

/-- **The integral leaf subgroup of the Lie algebra of `K` lies in `K`**, for every subgroup `K`,
closed or not. The leaf is a connected Lie group whose Lie algebra is spanned by the derivations
mapping to directions of `K`, so it is generated by their one-parameter subgroups, all of which
are carried into `K`. -/
theorem integralLeafSubgroup_lieSubalgebraOfSubgroup_le (K : Subgroup G) :
    (lieSubalgebraOfSubgroup (I := I) K).integralLeafSubgroup (I := I) ≤ K := by
  set S := lieSubalgebraOfSubgroup (I := I) K
  set d := S.integralLeafSubgroupData (I := I)
  set f := d.lieMapToHom.toLinearMap
  set A := f ⁻¹' {Z : LeftInvariantDerivation I G | ∀ t : ℝ, lieExp (t • Z) ∈ K}
  -- The derivations of the leaf mapping to directions of `K` span its Lie algebra.
  have hA : Submodule.span ℝ A = ⊤ := by
    refine Submodule.map_injective_of_injective (f := f) d.injective_lieMapToHom ?_
    rw [Submodule.map_span, Submodule.map_top]
    have himage : f '' A = {Z : LeftInvariantDerivation I G | ∀ t : ℝ, lieExp (t • Z) ∈ K} := by
      refine image_preimage_eq_of_subset fun Z hZ ↦ ?_
      have hZS : Z ∈ d.lieMapToHom.range := by
        rw [S.range_lieMapToHom_integralLeafSubgroupData]
        exact mem_lieSubalgebraOfSubgroup_of_forall hZ
      obtain ⟨Y, rfl⟩ := (LieHom.mem_range _ _).mp hZS
      exact ⟨Y, rfl⟩
    rw [himage, ← lieSubalgebraOfSubgroup_toSubmodule]
    have h := congrArg LieSubalgebra.toSubmodule S.range_lieMapToHom_integralLeafSubgroupData
    rw [LieHom.range_toSubmodule] at h
    exact h.symm
  -- So their one-parameter subgroups generate the leaf, and each is carried into `K`.
  have hle : Subgroup.closure (⋃ Y ∈ A, range fun t : ℝ ↦ lieExp (t • Y)) ≤ K.comap d.toHom := by
    rw [Subgroup.closure_le]
    rintro _ hg
    obtain ⟨Y, hY, t, rfl⟩ := mem_iUnion₂.mp hg
    have hY' : ∀ s : ℝ, lieExp (s • f Y) ∈ K := mem_preimage.mp hY
    simpa only [SetLike.mem_coe, Subgroup.mem_comap, d.toHom_lieExp, map_smul, f,
      LieHom.coe_toLinearMap] using hY' t
  rw [TauCeti.closure_biUnion_range_lieExp_smul_eq_top hA, top_le_iff] at hle
  rintro _ hg
  rw [← d.range_eq] at hg
  obtain ⟨x, rfl⟩ := hg
  exact Subgroup.mem_comap.mp (hle ▸ Subgroup.mem_top x)

/-- **The Lie algebra of an arbitrary subgroup.** For every subgroup `K` of a second-countable Lie
group, closed or not, a derivation lies in the Lie algebra of `K` exactly when its one-parameter
subgroup lies in `K`: the set of such derivations is already a Lie subalgebra. For closed `K` this
is `TauCeti.Lie.mem_lieSubalgebraOfSubgroup`. -/
@[simp]
theorem mem_lieSubalgebraOfSubgroup_iff (K : Subgroup G) {X : LeftInvariantDerivation I G} :
    X ∈ lieSubalgebraOfSubgroup (I := I) K ↔ ∀ t : ℝ, lieExp (I := I) (t • X) ∈ K :=
  ⟨fun hX t ↦ integralLeafSubgroup_lieSubalgebraOfSubgroup_le K
      (LieSubalgebra.lieExp_mem_integralLeafSubgroup (LieSubalgebra.smul_mem _ t hX)),
    mem_lieSubalgebraOfSubgroup_of_forall⟩

/-- **The Lie algebra of an arbitrary subgroup is exactly `𝔨`**, as sets, for a second-countable
`G`; for a closed `K` this is `TauCeti.Lie.coe_lieSubalgebraOfSubgroup`. -/
theorem coe_lieSubalgebraOfSubgroup_of_secondCountableTopology (K : Subgroup G) :
    (lieSubalgebraOfSubgroup (I := I) K : Set (LeftInvariantDerivation I G)) =
      {X : LeftInvariantDerivation I G | ∀ t : ℝ, lieExp (I := I) (t • X) ∈ K} :=
  Set.ext fun _ ↦ mem_lieSubalgebraOfSubgroup_iff K

end Leaf

end TauCeti.Lie
