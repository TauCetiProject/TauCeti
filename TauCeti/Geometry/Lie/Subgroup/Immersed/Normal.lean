/-!
# Normal immersed Lie subgroups and Lie ideals

Let `G` be a finite-dimensional real Lie group with Lie algebra `𝔤`. A connected immersed Lie
subgroup `K` of a connected `G` is normal exactly when its Lie algebra
`𝔨 = TauCeti.Lie.lieSubalgebraOfSubgroup K` is a Lie ideal of `𝔤`.

The route goes through the adjoint action. Conjugating by `g` carries the exponential of `X` to
the exponential of `Ad g X`, so a normal subgroup has an `Ad`-invariant Lie algebra
(`TauCeti.Lie.Ad_mem_lieSubalgebraOfSubgroup`), and conversely a connected immersed subgroup, being
generated by the exponentials of its Lie algebra, is normal once that Lie algebra is
`Ad`-invariant. Differentiating `s ↦ Ad (lieExp (s • X)) Y` at `0` turns `Ad`-invariance of a
subspace into invariance under every `ad X`. Conversely `Ad (lieExp X) = exp (ad X)` preserves a
subspace invariant under `ad X`, and a connected `G` is generated by exponentials, so for connected
`G` the two invariance conditions agree.

The forward implication, normal subgroup to ideal, holds for every subgroup of every Lie group,
with no connectedness or immersedness assumption. The converse needs the connectedness of `G`: in
`ℝ² ⋊ ℤ/2`, with `ℤ/2` swapping the coordinates, the Lie algebra `ℝ²` is abelian, so the Lie
algebra `ℝ × 0` of `K = ℝ × 0` is an ideal, but the swap moves `K` to `0 × ℝ`.

## Main results

* `TauCeti.Lie.lie_mem_of_forall_Ad_mem`: an `Ad`-invariant subspace of `𝔤` is invariant under
  every `ad X`.
* `TauCeti.Lie.forall_Ad_mem_iff_forall_lie_mem`: in a connected Lie group, a subspace of `𝔤` is
  `Ad`-invariant exactly when it is `ad`-invariant.
* `TauCeti.Lie.exists_lieIdeal_eq_lieSubalgebraOfSubgroup_of_normal`: the Lie algebra of a normal
  subgroup is a Lie ideal.
* `TauCeti.Lie.IsImmersedLieSubgroup.normal_iff_forall_Ad_mem`: a connected immersed Lie subgroup
  is normal exactly when its Lie algebra is `Ad`-invariant.
* `TauCeti.Lie.IsImmersedLieSubgroup.normal_iff_exists_lieIdeal`: in a connected Lie group, a
  connected immersed Lie subgroup is normal exactly when its Lie algebra is a Lie ideal.

## References

* A. Kirillov Jr., *An Introduction to Lie Groups and Lie Algebras*, Cambridge Studies in
  Advanced Mathematics 113 (2008), Theorem 3.19(2).
* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Springer (2013), Theorem 19.26.
-/

public section

noncomputable section

open Filter Set
open scoped ContDiff Manifold

namespace TauCeti.Lie

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold
attribute [local instance] TauCeti.normedAlgebraRatOfReal

/-- The exponential of a bounded operator preserving a closed subspace preserves it: the
operators preserving the subspace form a closed subalgebra. -/
private theorem exp_apply_mem_of_forall_apply_mem {V : Type*} [NormedAddCommGroup V]
    [NormedSpace ℝ V] {p : Submodule ℝ V} (hp : IsClosed (p : Set V))
    {A : V →L[ℝ] V} (hA : ∀ y ∈ p, A y ∈ p) {y : V} (hy : y ∈ p) :
    NormedSpace.exp A y ∈ p := by
  let s : Subalgebra ℝ (V →L[ℝ] V) :=
    { carrier := {T | ∀ y ∈ p, T y ∈ p}
      mul_mem' := fun hT hU y hy => hT _ (hU y hy)
      one_mem' := fun _ hy => hy
      add_mem' := fun hT hU y hy => p.add_mem (hT y hy) (hU y hy)
      zero_mem' := fun _ _ => p.zero_mem
      algebraMap_mem' := fun r y hy => by
        simpa [Algebra.algebraMap_eq_smul_one] using p.smul_mem r hy }
  have hs : IsClosed (s : Set (V →L[ℝ] V)) := by
    have hset : (s : Set (V →L[ℝ] V)) = ⋂ y ∈ p, (fun T : V →L[ℝ] V => T y) ⁻¹' p := by
      ext T
      simp only [Set.mem_iInter, Set.mem_preimage, SetLike.mem_coe]
      rfl
    rw [hset]
    exact isClosed_biInter fun y _ => hp.preimage (ContinuousLinearMap.apply ℝ V y).continuous
  have _ : IsScalarTower ℚ ℝ (V →L[ℝ] V) := IsScalarTower.of_algebraMap_eq fun _ => rfl
  exact NormedSpace.exp_mem (R := ℝ) (s := s) hs hA y hy

section Invariance

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]

/-- **An `Ad`-invariant subspace is `ad`-invariant.** If every `Ad g` preserves a subspace `S` of
`𝔤`, then so does every `ad X`: `⁅X, Y⁆` is the derivative at `0` of the curve
`s ↦ Ad (lieExp (s • X)) Y` in `S`, and `S` is closed, being finite-dimensional. -/
theorem lie_mem_of_forall_Ad_mem {S : Submodule ℝ (LeftInvariantDerivation I G)}
    (hS : ∀ g : G, ∀ Y ∈ S, Ad (I := I) g Y ∈ S) (X : LeftInvariantDerivation I G)
    {Y : LeftInvariantDerivation I G} (hY : Y ∈ S) : ⁅X, Y⁆ ∈ S := by
  have _ : T2Space G := I.t2Space_of_lieGroup ∞
  have _ : FiniteDimensional ℝ (LeftInvariantDerivation I G) :=
    finiteDimensional_leftInvariantDerivation BoundarylessManifold.isInteriorPoint
  refine S.isClosed_of_finiteDimensional.mem_of_tendsto
    (hasDerivAt_iff_tendsto_slope.mp (hasDerivAt_Ad_lieExp_smul_apply_zero X Y))
    (Eventually.of_forall fun s => ?_)
  rw [slope_def_module]
  exact S.smul_mem _ (S.sub_mem (hS _ _ hY) (hS _ _ hY))

/-- **The adjoint action of an exponential preserves an `ad`-invariant subspace**: if `ad X`
preserves `S`, then so does `Ad (lieExp X) = exp (ad X)`. -/
theorem Ad_lieExp_mem_of_forall_lie_mem [T2Space G]
    {S : Submodule ℝ (LeftInvariantDerivation I G)} {X : LeftInvariantDerivation I G}
    (hX : ∀ Y ∈ S, ⁅X, Y⁆ ∈ S) {Y : LeftInvariantDerivation I G} (hY : Y ∈ S) :
    Ad (I := I) (lieExp X) Y ∈ S := by
  have _ : FiniteDimensional ℝ (LeftInvariantDerivation I G) :=
    finiteDimensional_leftInvariantDerivation BoundarylessManifold.isInteriorPoint
  have h := LeftInvariantDerivation.Ad_lieExp_apply X Y
  dsimp only at h
  rw [h]
  exact exp_apply_mem_of_forall_apply_mem S.isClosed_of_finiteDimensional hX hY

/-- **In a connected Lie group, `Ad`-invariance is `ad`-invariance.** A subspace of `𝔤` is
preserved by every `Ad g` exactly when it is preserved by every `ad X`. The reverse implication
needs the connectedness of `G`: an `ad`-invariant subspace is preserved by `Ad` of the
exponentials, which generate the identity component only. -/
theorem forall_Ad_mem_iff_forall_lie_mem [PreconnectedSpace G]
    {S : Submodule ℝ (LeftInvariantDerivation I G)} :
    (∀ g : G, ∀ Y ∈ S, Ad (I := I) g Y ∈ S) ↔ ∀ X Y : LeftInvariantDerivation I G, Y ∈ S →
      ⁅X, Y⁆ ∈ S := by
  refine ⟨fun hS X _ hY => lie_mem_of_forall_Ad_mem hS X hY, fun h g => ?_⟩
  have _ : T2Space G := I.t2Space_of_lieGroup ∞
  have hg : g ∈ Subgroup.closure (range (lieExp (I := I) (G := G))) := by
    rw [closure_range_lieExp_eq_top]
    exact Subgroup.mem_top g
  induction hg using Subgroup.closure_induction'' with
  | mem x hx =>
    obtain ⟨X, rfl⟩ := hx
    exact fun Y hY => Ad_lieExp_mem_of_forall_lie_mem (h X) hY
  | inv_mem x hx =>
    obtain ⟨X, rfl⟩ := hx
    rw [← lieExp_neg]
    refine fun Y hY => Ad_lieExp_mem_of_forall_lie_mem (fun Z hZ => ?_) hY
    rw [neg_lie]
    exact S.neg_mem (h X Z hZ)
  | one => simp
  | mul x y _ _ hx hy =>
    intro Y hY
    rw [Ad_mul, LieEquiv.trans_apply]
    exact hx _ (hy Y hY)

variable [T2Space G]

/-- **The Lie algebra of a normal subgroup is a Lie ideal.** No hypothesis on the subgroup or on
`G` is needed: `Ad g` preserves the Lie algebra of `K` for every `g` in the normalizer of `K`, which
is all of `G`, and an `Ad`-invariant subspace is `ad`-invariant. -/
theorem exists_lieIdeal_eq_lieSubalgebraOfSubgroup_of_normal (K : Subgroup G) [K.Normal] :
    ∃ 𝔞 : LieIdeal ℝ (LeftInvariantDerivation I G),
      (𝔞 : LieSubalgebra ℝ (LeftInvariantDerivation I G)) = lieSubalgebraOfSubgroup (I := I) K := by
  rw [LieSubalgebra.exists_lieIdeal_coe_eq_iff]
  intro X Y hY
  refine lie_mem_of_forall_Ad_mem (S := (lieSubalgebraOfSubgroup (I := I) K).toSubmodule)
    (fun g Z hZ => Ad_mem_lieSubalgebraOfSubgroup ?_ hZ) X hY
  rw [Subgroup.normalizer_eq_top]
  exact Subgroup.mem_top g

end Invariance

section Immersed

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]
  [SecondCountableTopology G] [T2Space G]

/-- **A connected immersed Lie subgroup is normal exactly when its Lie algebra is `Ad`-invariant.**
Being generated by the exponentials of its Lie algebra `𝔨`, its conjugate by `g` is generated by
the exponentials of `Ad g 𝔨`. No connectedness of `G` is needed. -/
theorem IsImmersedLieSubgroup.normal_iff_forall_Ad_mem {K : Subgroup G}
    (hK : IsImmersedLieSubgroup (I := I) K) :
    K.Normal ↔ ∀ g : G, ∀ X ∈ lieSubalgebraOfSubgroup (I := I) K,
      Ad (I := I) g X ∈ lieSubalgebraOfSubgroup (I := I) K := by
  refine ⟨fun hN g X hX => Ad_mem_lieSubalgebraOfSubgroup ?_ hX, fun h => ⟨fun n hn g => ?_⟩⟩
  · rw [Subgroup.normalizer_eq_top]
    exact Subgroup.mem_top g
  have hcl : K = Subgroup.closure
      (lieExp '' (lieSubalgebraOfSubgroup (I := I) K : Set (LeftInvariantDerivation I G))) := by
    conv_lhs => rw [← hK.integralLeafSubgroup_lieSubalgebraOfSubgroup]
    exact LieSubalgebra.integralLeafSubgroup_eq_closure_lieExp_image _
  rw [hcl] at hn ⊢
  induction hn using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨X, hX, rfl⟩ := hx
    rw [conj_lieExp]
    exact Subgroup.subset_closure ⟨_, h g X hX, rfl⟩
  | one => simp
  | mul x y _ _ hx hy =>
    rw [show g * (x * y) * g⁻¹ = g * x * g⁻¹ * (g * y * g⁻¹) by group]
    exact mul_mem hx hy
  | inv x _ hx =>
    rw [show g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ by group]
    exact inv_mem hx

/-- **Normal subgroups and ideals** (Kirillov, Theorem 3.19(2)). In a connected Lie group, a
connected immersed Lie subgroup is normal exactly when its Lie algebra is a Lie ideal. The forward
implication holds in every Lie group (`exists_lieIdeal_eq_lieSubalgebraOfSubgroup_of_normal`). -/
theorem IsImmersedLieSubgroup.normal_iff_exists_lieIdeal [PreconnectedSpace G] {K : Subgroup G}
    (hK : IsImmersedLieSubgroup (I := I) K) :
    K.Normal ↔ ∃ 𝔞 : LieIdeal ℝ (LeftInvariantDerivation I G),
      (𝔞 : LieSubalgebra ℝ (LeftInvariantDerivation I G)) = lieSubalgebraOfSubgroup (I := I) K := by
  rw [hK.normal_iff_forall_Ad_mem, LieSubalgebra.exists_lieIdeal_coe_eq_iff]
  exact forall_Ad_mem_iff_forall_lie_mem (S := (lieSubalgebraOfSubgroup (I := I) K).toSubmodule)

end Immersed

end TauCeti.Lie
