/-!
# Normal immersed Lie subgroups and Lie ideals

Let `G` be a finite-dimensional real Lie group with Lie algebra `𝔤`. A connected immersed Lie
subgroup `K` of a connected `G` is normal exactly when its Lie algebra
`𝔨 = TauCeti.Lie.lieSubalgebraOfSubgroup K` is a Lie ideal of `𝔤`.

The route goes through the adjoint action. Conjugating by `g` carries the exponential of `X` to
the exponential of `Ad g X`, so a normal subgroup has an `Ad`-invariant Lie algebra
(`TauCeti.Lie.Ad_mem_lieSubalgebraOfSubgroup`), and conversely a connected immersed subgroup, being
generated by the exponentials of its Lie algebra, is normal once that Lie algebra is
`Ad`-invariant. Differentiating `s ↦ Ad (lieExp (s • X)) Y` at `0` turns `Ad`-invariance of a
subspace into invariance under every `ad X` (`TauCeti.Lie.lie_mem_of_forall_Ad_mem`). Conversely
`Ad (lieExp X) = exp (ad X)` preserves a subspace invariant under `ad X`
(`TauCeti.Lie.Ad_lieExp_mem_of_forall_lie_mem`), and a connected `G` is generated by
exponentials, so for connected `G` the two invariance conditions agree
(`TauCeti.Lie.forall_Ad_mem_iff_forall_lie_mem`).

The forward implication, normal subgroup to ideal, holds for every subgroup of every Lie group,
with no connectedness or immersedness assumption
(`TauCeti.Lie.exists_lieIdeal_eq_lieSubalgebraOfSubgroup_of_normal`). The converse needs the
connectedness of `G`: in `ℝ² ⋊ ℤ/2`, with `ℤ/2` swapping the coordinates, the Lie algebra `ℝ²` is
abelian, so the Lie algebra `ℝ × 0` of `K = ℝ × 0` is an ideal, but the swap moves `K` to
`0 × ℝ`.

## Main results

* `TauCeti.Lie.IsImmersedLieSubgroup.normal_iff_forall_Ad_mem`: a connected immersed Lie subgroup
  is normal exactly when its Lie algebra is `Ad`-invariant.
* `TauCeti.Lie.IsImmersedLieSubgroup.normal_iff_exists_lieIdeal`: in a connected Lie group, a
  connected immersed Lie subgroup is normal exactly when its Lie algebra is a Lie ideal.

## References

* A. Kirillov Jr., *An Introduction to Lie Groups and Lie Algebras*, Cambridge Studies in
  Advanced Mathematics 113 (2008), Theorem 3.19(2).
* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Springer (2013), Theorem 19.26.
-/

public section

noncomputable section

open scoped ContDiff Manifold

namespace TauCeti.Lie

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold

section Immersed

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]
  [SecondCountableTopology G] [T2Space G]

/-- **A connected immersed Lie subgroup is normal exactly when its Lie algebra is `Ad`-invariant.**
Being generated by the exponentials of its Lie algebra `𝔨`, its conjugate by `g` is generated by
the exponentials of `Ad g 𝔨`. No connectedness of `G` is needed. -/
theorem IsImmersedLieSubgroup.normal_iff_forall_Ad_mem {K : Subgroup G}
    (hK : IsImmersedLieSubgroup (I := I) K) :
    K.Normal ↔ ∀ g : G, ∀ X ∈ lieSubalgebraOfSubgroup (I := I) K,
      Ad (I := I) g X ∈ lieSubalgebraOfSubgroup (I := I) K := by
  refine ⟨fun _ g _ hX => Ad_mem_lieSubalgebraOfSubgroup_of_normal g hX, fun h => ?_⟩
  have hcl : K = Subgroup.closure
      (lieExp '' (lieSubalgebraOfSubgroup (I := I) K : Set (LeftInvariantDerivation I G))) := by
    conv_lhs => rw [← hK.integralLeafSubgroup_lieSubalgebraOfSubgroup]
    exact LieSubalgebra.integralLeafSubgroup_eq_closure_lieExp_image _
  rw [← Subgroup.normalizer_eq_top_iff, eq_top_iff, hcl]
  refine Subgroup.le_normalizer_closure_iff.mpr ?_
  rintro g - _ ⟨X, hX, rfl⟩
  rw [conj_lieExp]
  exact Subgroup.subset_closure ⟨_, h g X hX, rfl⟩

/-- **Normal subgroups and ideals** (Kirillov, Theorem 3.19(2)). In a connected Lie group, a
connected immersed Lie subgroup is normal exactly when its Lie algebra is a Lie ideal. The forward
implication holds in every Lie group (`exists_lieIdeal_eq_lieSubalgebraOfSubgroup_of_normal`). -/
theorem IsImmersedLieSubgroup.normal_iff_exists_lieIdeal [PreconnectedSpace G] {K : Subgroup G}
    (hK : IsImmersedLieSubgroup (I := I) K) :
    K.Normal ↔ ∃ 𝔞 : LieIdeal ℝ (LeftInvariantDerivation I G),
      (𝔞 : LieSubalgebra ℝ (LeftInvariantDerivation I G)) = lieSubalgebraOfSubgroup (I := I) K := by
  rw [hK.normal_iff_forall_Ad_mem, LieSubalgebra.exists_lieIdeal_coe_eq_iff]
  exact forall_Ad_mem_iff_forall_lie_mem (S := (lieSubalgebraOfSubgroup (I := I) K).toSubmodule)

end Immersed

end TauCeti.Lie
