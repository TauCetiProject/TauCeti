module

public import TauCeti.Geometry.Lie.Subgroup.Immersed.Existence
public import TauCeti.Geometry.Lie.Subgroup.Immersed.LieAlgebra

/-!
# The subalgebra–immersed-subgroup correspondence as an order isomorphism

Let `G` be a second-countable finite-dimensional real Lie group with Lie algebra `𝔤`. Sending a
Lie subalgebra `S ≤ 𝔤` to its integral leaf subgroup `LieSubalgebra.integralLeafSubgroup S` is an
order isomorphism from the Lie subalgebras of `𝔤` onto the connected immersed Lie subgroups of
`G`, with inverse `TauCeti.Lie.lieSubalgebraOfSubgroup`
(`TauCeti.Lie.integralLeafSubgroupOrderIso`).

The order on immersed subgroups is inclusion of underlying subgroups of `G`. Two presentations of
the same subgroup have equal differential ranges
(`TauCeti.Lie.ImmersedLieSubgroupData.lieSubalgebraOfSubgroup_eq_range_lieMapToHom`), so they are
diffeomorphic over `G` (`TauCeti.Lie.ImmersedLieSubgroupData.diffeomorphOfRangeEq`), and this is
the bijection with connected immersed subgroups up to isomorphism of presentations.

The correspondence is the restriction of a Galois coinsertion between Lie subalgebras and all
subgroups of `G` (`TauCeti.Lie.gc_integralLeafSubgroup_lieSubalgebraOfSubgroup`,
`TauCeti.Lie.gciIntegralLeafSubgroupLieSubalgebraOfSubgroup`): for every subgroup `Q`, closed or
not, `integralLeafSubgroup S ≤ Q ↔ S ≤ lieSubalgebraOfSubgroup Q`. Inclusion of Lie algebras gives
inclusion of subgroups because the integral leaf subgroup of `S` is generated by the exponentials
of `S` (`LieSubalgebra.integralLeafSubgroup_eq_closure_lieExp_image`), and `lieExp X ∈ Q` for
every `X ∈ lieSubalgebraOfSubgroup Q` (`TauCeti.Lie.mem_lieSubalgebraOfSubgroup_iff`). The
coinsertion property is that the Lie algebra of the integral leaf subgroup of `S` is exactly `S`
(`LieSubalgebra.lieSubalgebraOfSubgroup_integralLeafSubgroup`). The fixed points on the group side
are the connected immersed subgroups, and the lattice operations are read off the adjunction:
joins of integral leaf subgroups are the abstract subgroups they generate, the Lie algebra of an
intersection of arbitrary subgroups is the intersection of their Lie algebras, and the integral
leaf subgroup of the Lie algebra of `Q` is the largest connected immersed subgroup inside `Q`.

## Main results

* `TauCeti.Lie.ImmersedLieSubgroupData.lieSubalgebraOfSubgroup_eq_range_lieMapToHom`: the Lie
  algebra of a connected immersed Lie subgroup is the range of the differential of any of its
  presentations.
* `TauCeti.Lie.gc_integralLeafSubgroup_lieSubalgebraOfSubgroup` and
  `TauCeti.Lie.gciIntegralLeafSubgroupLieSubalgebraOfSubgroup`: the Galois connection and Galois
  coinsertion between Lie subalgebras and subgroups.
* `TauCeti.Lie.IsImmersedLieSubgroup.le_iff_lieSubalgebraOfSubgroup_le`: a connected immersed Lie
  subgroup lies in an arbitrary subgroup exactly when its Lie algebra does.
* `LieSubalgebra.integralLeafSubgroup_le_integralLeafSubgroup_iff` and
  `LieSubalgebra.integralLeafSubgroup_inj`: the integral leaf subgroup reflects inclusion and
  equality.
* `TauCeti.Lie.integralLeafSubgroupOrderIso`: the order isomorphism between Lie subalgebras of
  `𝔤` and connected immersed Lie subgroups of `G`.
* `LieSubalgebra.integralLeafSubgroup_iSup`, `LieSubalgebra.integralLeafSubgroup_sup` and
  `TauCeti.Lie.lieSubalgebraOfSubgroup_iInf`: joins and meets through the adjunction.
* `TauCeti.Lie.isGreatest_integralLeafSubgroup_lieSubalgebraOfSubgroup`,
  `TauCeti.Lie.integralLeafSubgroup_lieSubalgebraOfSubgroup_eq_iff` and
  `LieSubalgebra.isGreatest_integralLeafSubgroup_inf`: the largest connected immersed subgroup
  inside a subgroup, the fixed points of the coinsertion, and the meet of two connected immersed
  subgroups.

## References

* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Springer (2013), Theorem 19.26,
  pp. 506–507.
* A. Kirillov Jr., *An Introduction to Lie Groups and Lie Algebras*, Cambridge Studies in
  Advanced Mathematics 113 (2008), Theorem 3.40.
* K.-H. Neeb, *Towards a Lie theory of locally convex groups*, Jpn. J. Math. 1 (2006),
  Remark II.6.5(b), for the largest connected immersed subgroup of a subgroup.
-/

public section

noncomputable section

open Manifold TauCeti TauCeti.Lie
open scoped ContDiff Manifold

universe w

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {G : Type w} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]
  [SecondCountableTopology G] [T2Space G]

namespace TauCeti.Lie

/-- The Lie algebra of a connected immersed Lie subgroup is the range of the differential of any
of its presentations, with no closedness assumption on the subgroup. -/
theorem ImmersedLieSubgroupData.lieSubalgebraOfSubgroup_eq_range_lieMapToHom {K : Subgroup G}
    (d : ImmersedLieSubgroupData I K) :
    lieSubalgebraOfSubgroup (I := I) K = d.lieMapToHom.range := by
  have hK := d.eq_integralLeafSubgroup_of_range_lieMapToHom_eq rfl
  calc lieSubalgebraOfSubgroup (I := I) K
      = lieSubalgebraOfSubgroup (I := I) (d.lieMapToHom.range.integralLeafSubgroup (I := I)) := by
        rw [← hK]
    _ = d.lieMapToHom.range := LieSubalgebra.lieSubalgebraOfSubgroup_integralLeafSubgroup _

/-- A connected immersed Lie subgroup is the integral leaf subgroup of its Lie algebra. -/
theorem IsImmersedLieSubgroup.integralLeafSubgroup_lieSubalgebraOfSubgroup {K : Subgroup G}
    (hK : IsImmersedLieSubgroup (I := I) K) :
    (lieSubalgebraOfSubgroup (I := I) K).integralLeafSubgroup (I := I) = K := by
  obtain ⟨d⟩ := isImmersedLieSubgroup_iff.mp hK
  rw [d.lieSubalgebraOfSubgroup_eq_range_lieMapToHom]
  exact (d.eq_integralLeafSubgroup_of_range_lieMapToHom_eq rfl).symm

/-- **The Galois connection** between Lie subalgebras and subgroups: for every Lie subalgebra `𝔥`
and every subgroup `Q`, closed or not, `integralLeafSubgroup 𝔥 ≤ Q ↔ 𝔥 ≤ lieSubalgebraOfSubgroup Q`.
In particular the integral leaf subgroup of the Lie algebra of `Q` is the largest connected
immersed subgroup inside `Q` (`isGreatest_integralLeafSubgroup_lieSubalgebraOfSubgroup`). -/
theorem gc_integralLeafSubgroup_lieSubalgebraOfSubgroup :
    GaloisConnection
      (LieSubalgebra.integralLeafSubgroup (I := I) (G := G))
      (lieSubalgebraOfSubgroup (I := I)) := by
  intro 𝔥 Q
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · rw [← LieSubalgebra.lieSubalgebraOfSubgroup_integralLeafSubgroup 𝔥]
    exact lieSubalgebraOfSubgroup_mono h
  · rw [LieSubalgebra.integralLeafSubgroup_eq_closure_lieExp_image, Subgroup.closure_le]
    rintro _ ⟨X, hX, rfl⟩
    simpa using (mem_lieSubalgebraOfSubgroup_iff Q).mp (h hX) 1

/-- **The Galois coinsertion** between Lie subalgebras and subgroups: the Galois connection
`gc_integralLeafSubgroup_lieSubalgebraOfSubgroup`, whose left adjoint `integralLeafSubgroup` is
injective because the Lie algebra of the integral leaf subgroup of `𝔥` is `𝔥`. -/
def gciIntegralLeafSubgroupLieSubalgebraOfSubgroup :
    GaloisCoinsertion
      (LieSubalgebra.integralLeafSubgroup (I := I) (G := G))
      (lieSubalgebraOfSubgroup (I := I)) :=
  gc_integralLeafSubgroup_lieSubalgebraOfSubgroup.toGaloisCoinsertion fun 𝔥 ↦
    (LieSubalgebra.lieSubalgebraOfSubgroup_integralLeafSubgroup 𝔥).le

/-- A connected immersed Lie subgroup `K` lies in a subgroup `L` exactly when its Lie algebra lies
in that of `L`. Neither subgroup needs to be closed, and `L` need not be immersed. -/
theorem IsImmersedLieSubgroup.le_iff_lieSubalgebraOfSubgroup_le {K L : Subgroup G}
    (hK : IsImmersedLieSubgroup (I := I) K) :
    K ≤ L ↔ lieSubalgebraOfSubgroup (I := I) K ≤ lieSubalgebraOfSubgroup (I := I) L := by
  conv_lhs => rw [← hK.integralLeafSubgroup_lieSubalgebraOfSubgroup]
  exact gc_integralLeafSubgroup_lieSubalgebraOfSubgroup _ _

end TauCeti.Lie

namespace LieSubalgebra

/-- The integral leaf subgroup reflects inclusion: one integral leaf subgroup lies in another
exactly when the corresponding Lie subalgebras do. -/
@[simp]
theorem integralLeafSubgroup_le_integralLeafSubgroup_iff
    {S T : LieSubalgebra ℝ (LeftInvariantDerivation I G)} :
    S.integralLeafSubgroup (I := I) ≤ T.integralLeafSubgroup (I := I) ↔ S ≤ T :=
  gciIntegralLeafSubgroupLieSubalgebraOfSubgroup.l_le_l_iff

/-- The integral leaf subgroup is monotone in the Lie subalgebra. -/
theorem integralLeafSubgroup_monotone :
    Monotone (integralLeafSubgroup (I := I) : LieSubalgebra ℝ (LeftInvariantDerivation I G) →
      Subgroup G) :=
  gc_integralLeafSubgroup_lieSubalgebraOfSubgroup.monotone_l

/-- Distinct Lie subalgebras have distinct integral leaf subgroups. -/
theorem integralLeafSubgroup_injective :
    Function.Injective (integralLeafSubgroup (I := I) :
      LieSubalgebra ℝ (LeftInvariantDerivation I G) → Subgroup G) :=
  gciIntegralLeafSubgroupLieSubalgebraOfSubgroup.l_injective

/-- Two Lie subalgebras have the same integral leaf subgroup exactly when they are equal. -/
@[simp]
theorem integralLeafSubgroup_inj {S T : LieSubalgebra ℝ (LeftInvariantDerivation I G)} :
    S.integralLeafSubgroup (I := I) = T.integralLeafSubgroup (I := I) ↔ S = T :=
  integralLeafSubgroup_injective.eq_iff

end LieSubalgebra

namespace TauCeti.Lie

open LieSubalgebra

variable (I G) in
/-- **The subalgebra–immersed-subgroup correspondence** (Lee, Theorem 19.26). The integral leaf
subgroup is an order isomorphism from the Lie subalgebras of the Lie algebra of a second-countable
Lie group `G` onto its connected immersed Lie subgroups, ordered by inclusion. The inverse sends
a connected immersed Lie subgroup to its Lie algebra. -/
def integralLeafSubgroupOrderIso :
    LieSubalgebra ℝ (LeftInvariantDerivation I G) ≃o
      {K : Subgroup G // IsImmersedLieSubgroup (I := I) K} where
  toFun S := ⟨S.integralLeafSubgroup, S.isImmersedLieSubgroup_integralLeafSubgroup⟩
  invFun K := lieSubalgebraOfSubgroup (I := I) K.val
  left_inv S := S.lieSubalgebraOfSubgroup_integralLeafSubgroup
  right_inv K := Subtype.ext K.property.integralLeafSubgroup_lieSubalgebraOfSubgroup
  map_rel_iff' := by
    intro S T
    exact integralLeafSubgroup_le_integralLeafSubgroup_iff

/-- The integral leaf subgroup order isomorphism sends `S` to its integral leaf subgroup. -/
@[simp]
theorem coe_integralLeafSubgroupOrderIso_apply
    (S : LieSubalgebra ℝ (LeftInvariantDerivation I G)) :
    (integralLeafSubgroupOrderIso I G S : Subgroup G) = S.integralLeafSubgroup (I := I) :=
  (rfl)

/-- The inverse of the integral leaf subgroup order isomorphism sends a connected immersed Lie
subgroup to its Lie algebra. -/
@[simp]
theorem integralLeafSubgroupOrderIso_symm_apply
    (K : {K : Subgroup G // IsImmersedLieSubgroup (I := I) K}) :
    (integralLeafSubgroupOrderIso I G).symm K = lieSubalgebraOfSubgroup (I := I) K.val :=
  (rfl)

end TauCeti.Lie

/-! ### Lattice operations -/

namespace LieSubalgebra

/-- **Joins of connected immersed subgroups.** The integral leaf subgroup of a supremum of Lie
subalgebras is the subgroup generated by their integral leaf subgroups, with no closure taken: the
left adjoint of a Galois connection preserves suprema. -/
theorem integralLeafSubgroup_iSup {ι : Sort*}
    (S : ι → LieSubalgebra ℝ (LeftInvariantDerivation I G)) :
    (⨆ i, S i).integralLeafSubgroup (I := I) = ⨆ i, (S i).integralLeafSubgroup (I := I) :=
  gc_integralLeafSubgroup_lieSubalgebraOfSubgroup.l_iSup

/-- The integral leaf subgroup of the join of two Lie subalgebras is the subgroup generated by
their integral leaf subgroups. -/
theorem integralLeafSubgroup_sup (S T : LieSubalgebra ℝ (LeftInvariantDerivation I G)) :
    (S ⊔ T).integralLeafSubgroup (I := I) =
      S.integralLeafSubgroup (I := I) ⊔ T.integralLeafSubgroup (I := I) :=
  gc_integralLeafSubgroup_lieSubalgebraOfSubgroup.l_sup

end LieSubalgebra

namespace TauCeti.Lie

/-- **The Lie algebra of an intersection of subgroups**, closed or not, is the intersection of
their Lie algebras: the right adjoint of a Galois connection preserves infima. For two closed
subgroups and without second countability this is `TauCeti.Lie.lieSubalgebraOfSubgroup_inf`. -/
theorem lieSubalgebraOfSubgroup_iInf {ι : Sort*} (Q : ι → Subgroup G) :
    lieSubalgebraOfSubgroup (I := I) (⨅ i, Q i) = ⨅ i, lieSubalgebraOfSubgroup (I := I) (Q i) :=
  gc_integralLeafSubgroup_lieSubalgebraOfSubgroup.u_iInf

/-- **The largest connected immersed subgroup of a subgroup.** For every subgroup `Q`, closed or
not, the integral leaf subgroup of the Lie algebra of `Q` is the largest connected immersed Lie
subgroup contained in `Q`. -/
theorem isGreatest_integralLeafSubgroup_lieSubalgebraOfSubgroup (Q : Subgroup G) :
    IsGreatest {K : Subgroup G | IsImmersedLieSubgroup (I := I) K ∧ K ≤ Q}
      ((lieSubalgebraOfSubgroup (I := I) Q).integralLeafSubgroup (I := I)) :=
  ⟨⟨LieSubalgebra.isImmersedLieSubgroup_integralLeafSubgroup _,
      gc_integralLeafSubgroup_lieSubalgebraOfSubgroup.l_u_le Q⟩,
    fun _ ⟨hK, hKQ⟩ ↦ hK.le_iff_lieSubalgebraOfSubgroup_le.mpr <|
      (hK.le_iff_lieSubalgebraOfSubgroup_le.mp hKQ).trans_eq
        (LieSubalgebra.lieSubalgebraOfSubgroup_integralLeafSubgroup _).symm⟩

/-- **The fixed points of the Galois coinsertion** on the group side are the connected immersed
Lie subgroups: a subgroup is the integral leaf subgroup of its Lie algebra exactly when it is a
connected immersed Lie subgroup. -/
theorem integralLeafSubgroup_lieSubalgebraOfSubgroup_eq_iff {Q : Subgroup G} :
    (lieSubalgebraOfSubgroup (I := I) Q).integralLeafSubgroup (I := I) = Q ↔
      IsImmersedLieSubgroup (I := I) Q :=
  ⟨fun h ↦ h ▸ LieSubalgebra.isImmersedLieSubgroup_integralLeafSubgroup _,
    IsImmersedLieSubgroup.integralLeafSubgroup_lieSubalgebraOfSubgroup⟩

end TauCeti.Lie

namespace LieSubalgebra

/-- **Meets of connected immersed subgroups.** The integral leaf subgroup of `S ⊓ T` is the
largest connected immersed Lie subgroup contained in the intersection of the integral leaf
subgroups of `S` and `T`; the intersection itself need not be connected. -/
theorem isGreatest_integralLeafSubgroup_inf (S T : LieSubalgebra ℝ (LeftInvariantDerivation I G)) :
    IsGreatest {K : Subgroup G | IsImmersedLieSubgroup (I := I) K ∧
        K ≤ S.integralLeafSubgroup (I := I) ⊓ T.integralLeafSubgroup (I := I)}
      ((S ⊓ T).integralLeafSubgroup (I := I)) := by
  have h := TauCeti.Lie.isGreatest_integralLeafSubgroup_lieSubalgebraOfSubgroup (I := I)
    (S.integralLeafSubgroup (I := I) ⊓ T.integralLeafSubgroup (I := I))
  rwa [TauCeti.Lie.gc_integralLeafSubgroup_lieSubalgebraOfSubgroup.u_inf,
    LieSubalgebra.lieSubalgebraOfSubgroup_integralLeafSubgroup,
    LieSubalgebra.lieSubalgebraOfSubgroup_integralLeafSubgroup] at h

end LieSubalgebra
