  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [LieGroup I ∞ G]
  {K L M : Subgroup G}

attribute [local instance] ContMDiffMul.boundarylessManifold
attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField

section DifferentialImages

variable [FiniteDimensional ℝ E] [T2Space G]

/-- An immersed subgroup is generated by the exponentials of its differential range. The closure
here is algebraic subgroup generation. -/
theorem eq_closure_lieExp_image (d : ImmersedLieSubgroupData I K) :
    K = Subgroup.closure (lieExp '' (d.lieMapToHom.range : Set (LeftInvariantDerivation I G))) := by
  simpa only [toContMDiffMonoidMorphism_toMonoidHom, lieMap_toContMDiffMonoidMorphism,
    d.range_eq] using
    d.toContMDiffMonoidMorphism.range_eq_closure_lieExp_image

/-- Inclusion of differential ranges implies inclusion of connected immersed subgroup images.
No closedness or subspace-topology hypothesis is required. -/
theorem le_of_range_lieMapToHom_le (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range ≤ e.lieMapToHom.range) :
    K ≤ L := by
  rw [d.eq_closure_lieExp_image, e.eq_closure_lieExp_image]
  exact Subgroup.closure_mono (Set.image_mono h)

/-- Two connected immersed subgroup presentations with the same differential range have the
same image subgroup, even if these images are not closed. -/
theorem eq_of_range_lieMapToHom_eq (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range = e.lieMapToHom.range) :
    K = L := by
  exact le_antisymm (d.le_of_range_lieMapToHom_le e h.le)
    (e.le_of_range_lieMapToHom_le d h.ge)


end DifferentialImages

section SmoothFactorization

variable [FiniteDimensional ℝ E] [T2Space G]

/-- The canonical factorization is smooth when the differential ranges are included. -/
theorem contMDiff_homOfLe (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range ≤ e.lieMapToHom.range) :
    ContMDiff d.I' e.I' ∞ (d.homOfLe e (d.le_of_range_lieMapToHom_le e h)) := by
  let _ : T2Space d.X := d.I'.t2Space_of_lieGroup ∞
  let _ : T2Space e.X := e.I'.t2Space_of_lieGroup ∞
  apply contMDiff_of_map_lieExp (d.homOfLe e (d.le_of_range_lieMapToHom_le e h))
    (d.lieHomOfRangeLe e h).toLinearMap
  dsimp only
  intro X
  apply e.injective
  simp only [toHom_homOfLe_apply, toHom_lieExp, LieHom.coe_toLinearMap,
    lieMapToHom_apply, lieMap_lieHomOfRangeLe_apply]

/-- Included differential ranges give a unique smooth homomorphism commuting with the ambient
injections, without any closedness assumption on the images. -/
theorem existsUnique_contMDiff_monoidHom_of_range_lieMapToHom_le
    (d : ImmersedLieSubgroupData I K) (e : ImmersedLieSubgroupData I L)
    (h : d.lieMapToHom.range ≤ e.lieMapToHom.range) :
    ∃! φ : d.X →* e.X, ContMDiff d.I' e.I' ∞ φ ∧ ∀ x, e.toHom (φ x) = d.toHom x := by
  refine ⟨d.homOfLe e (d.le_of_range_lieMapToHom_le e h),
    ⟨d.contMDiff_homOfLe e h, d.toHom_homOfLe_apply e _⟩, ?_⟩
  intro φ hφ
  exact d.eq_homOfLe e _ φ hφ.2

/-- The canonical smooth factorization for included differential ranges. -/
noncomputable def contMDiffHomOfRangeLe (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range ≤ e.lieMapToHom.range) :
    ContMDiffMonoidMorphism d.I' e.I' ∞ d.X e.X where
  toMonoidHom := d.homOfLe e (d.le_of_range_lieMapToHom_le e h)
  contMDiff_toFun := d.contMDiff_homOfLe e h

/-- The bundled smooth factorization has the canonical algebraic factorization as its value. -/
@[simp]
theorem contMDiffHomOfRangeLe_apply (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range ≤ e.lieMapToHom.range)
    (x : d.X) : d.contMDiffHomOfRangeLe e h x =
      d.homOfLe e (d.le_of_range_lieMapToHom_le e h) x := by
  rfl

/-- The bundled factorization commutes with the presenting smooth morphisms. -/
@[simp]
theorem toContMDiffMonoidMorphism_comp_contMDiffHomOfRangeLe
    (d : ImmersedLieSubgroupData I K) (e : ImmersedLieSubgroupData I L)
    (h : d.lieMapToHom.range ≤ e.lieMapToHom.range) :
    e.toContMDiffMonoidMorphism.comp (d.contMDiffHomOfRangeLe e h) =
      d.toContMDiffMonoidMorphism := by
  apply DFunLike.ext
  intro x
  simp only [ContMDiffMonoidMorphism.coe_comp, Function.comp_apply, toContMDiffMonoidMorphism_apply,
    contMDiffHomOfRangeLe_apply, toHom_homOfLe_apply]

/-- The differential of the canonical smooth factorization is the canonical Lie factorization. -/
@[simp]
theorem lieMap_contMDiffHomOfRangeLe (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range ≤ e.lieMapToHom.range) :
    lieMap (d.contMDiffHomOfRangeLe e h) = d.lieHomOfRangeLe e h := by
  apply d.eq_lieHomOfRangeLe e h
  intro X
  rw [← LieHom.comp_apply, ← lieMap_comp,
    toContMDiffMonoidMorphism_comp_contMDiffHomOfRangeLe]

/-- The smooth factorization of a presentation through itself is the identity. -/
@[simp]
theorem contMDiffHomOfRangeLe_refl (d : ImmersedLieSubgroupData I K) :
    d.contMDiffHomOfRangeLe d le_rfl = ContMDiffMonoidMorphism.id := by
  apply DFunLike.ext
  intro x
  simp only [contMDiffHomOfRangeLe_apply, homOfLe_refl,
    MonoidHom.id_apply, ContMDiffMonoidMorphism.coe_id, id_eq]

/-- Canonical smooth factorizations compose according to differential-range inclusion. -/
@[simp]
theorem contMDiffHomOfRangeLe_comp (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (f : ImmersedLieSubgroupData I M)
    (hKL : d.lieMapToHom.range ≤ e.lieMapToHom.range)
    (hLM : e.lieMapToHom.range ≤ f.lieMapToHom.range) :
    (e.contMDiffHomOfRangeLe f hLM).comp (d.contMDiffHomOfRangeLe e hKL) =
      d.contMDiffHomOfRangeLe f (hKL.trans hLM) := by
  apply DFunLike.ext
  intro x
  apply f.injective
  simp only [ContMDiffMonoidMorphism.coe_comp, Function.comp_apply, contMDiffHomOfRangeLe_apply,
    toHom_homOfLe_apply]

end SmoothFactorization

section SmoothEquivalence

variable [FiniteDimensional ℝ E] [T2Space G]

/-- The canonical equivalence is smooth when its differential ranges agree. -/
theorem contMDiff_mulEquivOfEq (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range = e.lieMapToHom.range) :
    ContMDiff d.I' e.I' ∞ (d.mulEquivOfEq e (d.eq_of_range_lieMapToHom_eq e h)) := by
  have hs := d.contMDiff_homOfLe e h.le
  rw [← coe_mulEquivOfEq d e (d.eq_of_range_lieMapToHom_eq e h)] at hs
  exact hs

/-- The inverse canonical equivalence is smooth when its differential ranges agree. -/
theorem contMDiff_mulEquivOfEq_symm (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range = e.lieMapToHom.range) :
    ContMDiff e.I' d.I' ∞ (d.mulEquivOfEq e (d.eq_of_range_lieMapToHom_eq e h)).symm := by
  rw [mulEquivOfEq_symm]
  exact e.contMDiff_mulEquivOfEq d h.symm

/-- The canonical diffeomorphism between immersed presentations with equal differential ranges. -/
noncomputable def diffeomorphOfRangeEq (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range = e.lieMapToHom.range) :
    Diffeomorph d.I' e.I' d.X e.X ∞ where
  toEquiv := (d.mulEquivOfEq e (d.eq_of_range_lieMapToHom_eq e h)).toEquiv
  contMDiff_toFun := d.contMDiff_mulEquivOfEq e h
  contMDiff_invFun := d.contMDiff_mulEquivOfEq_symm e h

/-- The canonical diffeomorphism has the canonical algebraic equivalence as its value. -/
@[simp]
theorem diffeomorphOfRangeEq_apply (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range = e.lieMapToHom.range)
    (x : d.X) : d.diffeomorphOfRangeEq e h x =
      d.mulEquivOfEq e (d.eq_of_range_lieMapToHom_eq e h) x := by
  rfl

/-- The inverse canonical diffeomorphism is the canonical diffeomorphism in the other direction. -/
@[simp]
theorem diffeomorphOfRangeEq_symm (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range = e.lieMapToHom.range) :
    (d.diffeomorphOfRangeEq e h).symm = e.diffeomorphOfRangeEq d h.symm := by
  ext y
  exact congrArg (fun f => f y)
    (d.mulEquivOfEq_symm e (d.eq_of_range_lieMapToHom_eq e h))

/-- The canonical diffeomorphism preserves multiplication. -/
theorem diffeomorphOfRangeEq_mul (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range = e.lieMapToHom.range)
    (x y : d.X) : d.diffeomorphOfRangeEq e h (x * y) =
      d.diffeomorphOfRangeEq e h x * d.diffeomorphOfRangeEq e h y :=
  (d.mulEquivOfEq e (d.eq_of_range_lieMapToHom_eq e h)).map_mul x y

end SmoothEquivalence

end TauCeti.Lie.ImmersedLieSubgroupData
