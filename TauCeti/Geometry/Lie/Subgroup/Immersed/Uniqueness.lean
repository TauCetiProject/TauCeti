module

public import TauCeti.Geometry.Lie.Subgroup.Immersed.Differential
public import TauCeti.Geometry.Lie.Subgroup.Image

/-!
# Uniqueness of connected immersed subgroup images

The underlying subgroup of a connected immersed Lie subgroup is generated by exponentials of
its differential range. Thus two immersed presentations with the same differential range have
the same image subgroup. This statement uses each source's intrinsic Lie-group topology and
requires no closedness of either subgroup in the ambient group.

This is uniqueness of the image subgroup; it does not identify the two presenting manifolds.

## References

* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Springer (2013), Chapters 19–20.
-/

public section

open scoped ContDiff Manifold

namespace TauCeti.Lie.ImmersedLieSubgroupData

attribute [local instance] ImmersedLieSubgroupData.group
  ImmersedLieSubgroupData.topologicalSpace ImmersedLieSubgroupData.normedAddCommGroup
  ImmersedLieSubgroupData.normedSpace ImmersedLieSubgroupData.finiteDimensional
  ImmersedLieSubgroupData.modelTopology ImmersedLieSubgroupData.chartedSpace
  ImmersedLieSubgroupData.isManifold ImmersedLieSubgroupData.lieGroup
  ImmersedLieSubgroupData.connectedSpace

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [FiniteDimensional ℝ E] [LieGroup I ∞ G] [T2Space G]
  {K L : Subgroup G}

attribute [local instance] ContMDiffMul.boundarylessManifold
attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField

/-- An immersed subgroup is generated by the exponentials of its differential range. The closure
here is algebraic subgroup generation. -/
theorem eq_closure_lieExp_image (d : ImmersedLieSubgroupData I K) :
    K = Subgroup.closure (lieExp '' (d.lieMapToHom.range : Set (LeftInvariantDerivation I G))) := by
  simpa only [toContMDiffMonoidMorphism_toMonoidHom, lieMap_toContMDiffMonoidMorphism,
    d.range_eq] using
    d.toContMDiffMonoidMorphism.range_eq_closure_lieExp_image

/-- Two connected immersed subgroup presentations with the same differential range have the
same image subgroup, even if these images are not closed. -/
theorem eq_of_range_lieMapToHom_eq (d : ImmersedLieSubgroupData I K)
    (e : ImmersedLieSubgroupData I L) (h : d.lieMapToHom.range = e.lieMapToHom.range) :
    K = L := by
  rw [d.eq_closure_lieExp_image, e.eq_closure_lieExp_image, h]

end TauCeti.Lie.ImmersedLieSubgroupData
