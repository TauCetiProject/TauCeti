import TauCeti.Geometry.Manifold.MFDeriv.NormedSpace
public import Mathlib.Analysis.SpecialFunctions.Complex.Circle

/-!
# The real parametrization and immersed presentation of the circle

The homomorphism from the ordinary real line to complex units given by `t ↦ exp (it)` is a
smooth immersion onto the circle. It is not injective, and its source is not homeomorphic to
the circle. The circle itself, with its native sphere charts, gives a connected injective
immersed presentation of the same image. Thus a connected immersive parametrization alone
does not determine the source from its image.

## References

* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Springer GTM 218 (2013),
  Examples 7.3(f),(j), 7.4(a), and Proposition 7.17.
-/

public section

open Set Function
open scoped ContDiff Manifold

noncomputable section

namespace TauCeti.Lie.CircleParametrization

attribute [local instance] finrank_real_complex_fact'

/-- The real one-parameter subgroup of complex units generated by `i`. -/
def hom : Multiplicative ℝ →* ℂˣ := (TauCeti.expUnitHom Complex.I).toMonoidHom

/-- In complex coordinates, the parametrization is the ordinary exponential `exp (it)`. -/
@[simp]
theorem coe_hom_apply (t : Multiplicative ℝ) :
    (hom t : ℂ) = Complex.exp ((t.toAdd : ℂ) * Complex.I) :=
  TauCeti.coe_expUnitHom_complex Complex.I t.toAdd

/-- The real parametrization is the native circle exponential followed by its units inclusion. -/
@[simp]
theorem hom_ofAdd (t : ℝ) :
    hom (Multiplicative.ofAdd t) = Circle.toUnits (Circle.exp t) := by
  apply Units.ext
  rw [coe_hom_apply]
  simp [Circle.coe_exp]

/-- The real exponential parametrization has exactly the unit-circle image. -/
theorem range_hom : hom.range = Circle.toUnits.range := by
  apply le_antisymm
  · rintro z ⟨t, rfl⟩
    refine ⟨Circle.exp t.toAdd, ?_⟩
    simpa only [ofAdd_toAdd] using (hom_ofAdd t.toAdd).symm
  · rintro z ⟨u, rfl⟩
    obtain ⟨t, rfl⟩ := Circle.exp_surjective u
    exact ⟨Multiplicative.ofAdd t, hom_ofAdd t⟩

/-- The period `2π` makes the real exponential parametrization noninjective. -/
theorem hom_not_injective : ¬ Injective hom := by
  intro hi
  have hp : hom (Multiplicative.ofAdd (2 * Real.pi)) = hom 1 := by
    rw [hom_ofAdd, Circle.exp_two_pi, map_one, map_one]
  have h := congrArg Multiplicative.toAdd (hi hp)
  simp only [toAdd_ofAdd, toAdd_one] at h
  exact (mul_ne_zero (by norm_num : (2 : ℝ) ≠ 0) Real.pi_ne_zero) h

private theorem hom_ofAdd_isImmersion {m : ℕ∞ω} :
    Manifold.IsImmersion 𝓘(ℝ, ℝ) 𝓘(ℝ, ℂ) m
      (fun t : ℝ ↦ hom (Multiplicative.ofAdd t)) := by
  suffices h : Manifold.IsImmersion 𝓘(ℝ, ℝ) 𝓘(ℝ, ℂ) ω
      (fun t : ℝ ↦ hom (Multiplicative.ofAdd t)) from h.of_le le_top
  have hs : ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, ℂ) ω (fun t : ℝ ↦ hom (Multiplicative.ofAdd t)) :=
    TauCeti.contMDiff_expUnitHom Complex.I
  apply hs.isImmersion_units_of_injective_mfderiv_val (by simp)
  intro t
  have hi : Injective (mfderiv 𝓘(ℝ, ℝ) 𝓘(ℝ, ℂ)
      (fun s : ℝ ↦ (Circle.exp s : ℂ)) t) := by
    have hcoe : ContMDiff (𝓡 1) 𝓘(ℝ, ℂ) ω (fun z : Circle ↦ (z : ℂ)) :=
      contMDiff_coe_sphere
    have hcomp : mfderiv 𝓘(ℝ, ℝ) 𝓘(ℝ, ℂ) (fun s : ℝ ↦ (Circle.exp s : ℂ)) t =
        (mfderiv (𝓡 1) 𝓘(ℝ, ℂ) (fun z : Circle ↦ (z : ℂ)) (Circle.exp t)).comp
          (mfderiv 𝓘(ℝ, ℝ) (𝓡 1) Circle.exp t) := by
      simpa only [Function.comp_def] using mfderiv_comp t
        (hcoe.mdifferentiableAt (by simp))
        ((contMDiff_circleExp (m := ω)).mdifferentiableAt (by simp))
    rw [hcomp]
    have hc : Injective (mfderiv (𝓡 1) 𝓘(ℝ, ℂ)
        (fun z : Circle ↦ (z : ℂ)) (Circle.exp t)) :=
      (TauCeti.injective_mvfderiv_iff).mp
        (injective_mvfderiv_subtypeVal_sphere (E := ℂ) (n := 1) (Circle.exp t))
    exact hc.comp (TauCeti.injective_mfderiv_circleExp t)
  apply (TauCeti.injective_mvfderiv_iff).mp
  simpa [hom_ofAdd, Circle.toUnits_apply] using (TauCeti.injective_mvfderiv_iff).mpr hi

/-- The real exponential parametrization is an immersion at every differentiability order. -/
theorem isImmersion_hom {m : ℕ∞ω} : Manifold.IsImmersion 𝓘(ℝ, ℝ) 𝓘(ℝ, ℂ) m hom := by
  -- Multiplicative uses the ordinary real charts through the TypeTags manifold instances.
  exact hom_ofAdd_isImmersion

/-- The real source is not homeomorphic to the circle, since it is not compact. -/
theorem isEmpty_homeomorph_circle : IsEmpty (Multiplicative ℝ ≃ₜ Circle) := by
  refine ⟨fun e ↦ ?_⟩
  let _ : CompactSpace (Multiplicative ℝ) := e.symm.compactSpace
  exact noncompact_univ (Multiplicative ℝ) isCompact_univ

end TauCeti.Lie.CircleParametrization

namespace TauCeti.Lie

/-- The unit-circle image has a connected immersed presentation with the native circle source. -/
@[expose]
def immersedDataRangeCircleToUnits :
    TauCeti.Lie.ImmersedLieSubgroupData 𝓘(ℝ, ℂ) Circle.toUnits.range where
  X := Circle
  E' := EuclideanSpace ℝ (Fin 1)
  H' := EuclideanSpace ℝ (Fin 1)
  I' := 𝓡 1
  toHom := Circle.toUnits
  injective := unitSphereToUnits_injective (𝕜 := ℂ)
  range_eq := rfl
  isImmersion := Circle.isImmersion_toUnits

/-- The circle image satisfies the native connected immersed-subgroup predicate. -/
theorem isImmersedLieSubgroup_range_circleToUnits :
    TauCeti.Lie.IsImmersedLieSubgroup (I := 𝓘(ℝ, ℂ)) Circle.toUnits.range :=
  immersedDataRangeCircleToUnits.isImmersedLieSubgroup

end TauCeti.Lie
