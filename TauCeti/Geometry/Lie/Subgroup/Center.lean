import TauCeti.Topology.Algebra.Group.Subgroup

/-!
# The centre of a Lie group and its Lie algebra

Let `G` be a finite-dimensional real Lie group with Lie algebra `𝔤`. The centre `Z(G)` is a closed
subgroup, and its Lie algebra lies in the centre `𝔷(𝔤)` of `𝔤`: the adjoint orbit of `Y` along a
central one-parameter subgroup `s ↦ lieExp (s • X)` is constant, and its derivative at `0` is
`⁅X, Y⁆`. When `G` is connected the two agree, `Lie(Z(G)) = 𝔷(𝔤)`, and `Z(G)` is the kernel of the
adjoint representation. Both converses use that a connected Lie group is generated by any
neighbourhood of the identity, through
`TauCeti.Lie.mem_centralizer_iff_forall_Ad_apply_eq_self`, and that `Ad (lieExp (s • X))` fixes
every derivation bracketing to zero with `X`.

By the closed-subgroup theorem a closed subgroup is discrete exactly when its Lie algebra is
trivial (`TauCeti.Lie.discreteTopology_iff_lieSubalgebraOfSubgroup_eq_bot`). Hence `Z(G)` is
discrete as soon as `𝔷(𝔤) = 0`, for instance when `𝔤` is semisimple (`LieAlgebra.center_eq_bot`),
and then `Z(G)` is **finite when `G` is compact**, being a closed discrete subset of a compact
space. For compact connected `G`, finiteness of the centre is equivalent to `𝔷(𝔤) = 0`.

Connectedness is needed for the converses: the orthogonal group `O(2)` has centre `{±1}`, while
its Lie algebra `𝔰𝔬(2)` is abelian.

## Main results

* `TauCeti.Lie.lieSubalgebraOfSubgroup_center_le`: `Lie(Z(G)) ≤ 𝔷(𝔤)`.
* `TauCeti.Lie.lieSubalgebraOfSubgroup_center`: `Lie(Z(G)) = 𝔷(𝔤)` for connected `G`.
* `TauCeti.Lie.Ad_apply_eq_self_of_mem_center` and
  `TauCeti.Lie.mem_center_iff_forall_Ad_apply_eq_self`: the adjoint action of a central element
  is trivial, and for connected `G` the centre is the kernel of the adjoint representation.
* `TauCeti.Lie.discreteTopology_center_of_center_eq_bot` and
  `TauCeti.Lie.discreteTopology_center_iff`: the centre is discrete when `𝔷(𝔤) = 0`, and for
  connected `G` exactly then.
* `TauCeti.Lie.finite_center_of_center_eq_bot` and `TauCeti.Lie.finite_center_iff`: a compact Lie
  group with `𝔷(𝔤) = 0` has finite centre, and for compact connected `G` this characterizes
  `𝔷(𝔤) = 0`.

## References

* T. Bröcker, T. tom Dieck, *Representations of Compact Lie Groups*, Graduate Texts in
  Mathematics 98, Springer, 1985, Chapter V, §8.
* J. Hilgert and K.-H. Neeb, *Structure and Geometry of Lie Groups*, Springer (2012),
  Chapters 9 and 12.
* J.-F. Barraud, M. Damian, V. Humilière, A. Oancea, *Floer homology with DG coefficients.
  Applications to cotangent bundles*, arXiv:2404.07953, §6.4 (Example 6.30 and
  Proposition 6.31).
-/

public section

noncomputable section

namespace TauCeti.Lie

open LieAlgebra
open scoped ContDiff Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [FiniteDimensional ℝ E] [LieGroup I ∞ G] [T2Space G]

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold

/-- **The adjoint action of a central element is trivial.** -/
theorem Ad_apply_eq_self_of_mem_center {g : G} (hg : g ∈ Subgroup.center G)
    (X : LeftInvariantDerivation I G) : Ad (I := I) g X = X := by
  rw [← Subgroup.centralizer_univ, ← Subgroup.coe_top] at hg
  exact Ad_apply_eq_self_of_mem_centralizer hg (by simp)

/-- **The centre of a connected Lie group is the kernel of the adjoint representation**: an element
is central exactly when its adjoint action fixes every derivation. -/
theorem mem_center_iff_forall_Ad_apply_eq_self [PreconnectedSpace G] (g : G) :
    g ∈ Subgroup.center G ↔ ∀ X : LeftInvariantDerivation I G, Ad (I := I) g X = X := by
  refine ⟨fun hg => Ad_apply_eq_self_of_mem_center hg, fun h => ?_⟩
  rw [← Subgroup.centralizer_univ, ← Subgroup.coe_top,
    mem_centralizer_iff_forall_Ad_apply_eq_self (I := I)
    (by simp) (by simpa using isPreconnected_univ)]
  exact fun X _ => h X

/-- **The Lie algebra of the centre lies in the centre of the Lie algebra.** No connectedness is
needed. -/
theorem lieSubalgebraOfSubgroup_center_le :
    lieSubalgebraOfSubgroup (I := I) (Subgroup.center G) ≤
      (center ℝ (LeftInvariantDerivation I G) : LieSubalgebra ℝ (LeftInvariantDerivation I G)) := by
  intro X hX
  rw [← Subgroup.centralizer_univ, ← Subgroup.coe_top] at hX
  rw [LieIdeal.mem_toLieSubalgebra, LieModule.mem_maxTrivSubmodule]
  intro Y
  rw [← lie_skew, lie_eq_zero_of_mem_lieSubalgebraOfSubgroup_centralizer hX (by simp),
    neg_zero]

/-- **The Lie algebra of the centre of a connected Lie group is the centre of its Lie algebra.** -/
@[simp]
theorem lieSubalgebraOfSubgroup_center [PreconnectedSpace G] :
    lieSubalgebraOfSubgroup (I := I) (Subgroup.center G) =
      (center ℝ (LeftInvariantDerivation I G) : LieSubalgebra ℝ (LeftInvariantDerivation I G)) := by
  refine le_antisymm lieSubalgebraOfSubgroup_center_le fun X hX => ?_
  rw [LieIdeal.mem_toLieSubalgebra, LieModule.mem_maxTrivSubmodule] at hX
  refine mem_lieSubalgebraOfSubgroup_of_forall fun t => ?_
  rw [mem_center_iff_forall_Ad_apply_eq_self (I := I)]
  intro Y
  refine Ad_lieExp_smul_apply_eq_self_of_lie_eq_zero ?_ t
  rw [← lie_skew, hX Y, neg_zero]

/-- **The centre is discrete when the Lie algebra has trivial centre**, in particular when the Lie
algebra is semisimple (`LieAlgebra.center_eq_bot`). -/
theorem discreteTopology_center_of_center_eq_bot
    (h : center ℝ (LeftInvariantDerivation I G) = ⊥) : DiscreteTopology (Subgroup.center G) := by
  have : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  rw [discreteTopology_iff_lieSubalgebraOfSubgroup_eq_bot (I := I) Subgroup.isClosed_center,
    eq_bot_iff]
  intro X hX
  have hX' := lieSubalgebraOfSubgroup_center_le hX
  rw [LieIdeal.mem_toLieSubalgebra, h, LieSubmodule.mem_bot] at hX'
  rw [hX', LieSubalgebra.mem_bot]

/-- **The centre of a connected Lie group is discrete exactly when the Lie algebra has trivial
centre.** -/
theorem discreteTopology_center_iff [PreconnectedSpace G] :
    DiscreteTopology (Subgroup.center G) ↔ center ℝ (LeftInvariantDerivation I G) = ⊥ := by
  refine ⟨fun hd => ?_, discreteTopology_center_of_center_eq_bot⟩
  have : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  have hbot := (discreteTopology_iff_lieSubalgebraOfSubgroup_eq_bot (I := I)
    Subgroup.isClosed_center).mp hd
  rw [lieSubalgebraOfSubgroup_center] at hbot
  rw [eq_bot_iff]
  intro X hX
  have hX' : X ∈ (center ℝ (LeftInvariantDerivation I G) :
      LieSubalgebra ℝ (LeftInvariantDerivation I G)) := by
    rwa [LieIdeal.mem_toLieSubalgebra]
  rw [hbot, LieSubalgebra.mem_bot] at hX'
  rw [hX', LieSubmodule.mem_bot]

/-- **A compact Lie group whose Lie algebra has trivial centre has finite centre**, for instance a
compact Lie group with semisimple Lie algebra (`LieAlgebra.center_eq_bot`). -/
theorem finite_center_of_center_eq_bot [CompactSpace G]
    (h : center ℝ (LeftInvariantDerivation I G) = ⊥) : Finite (Subgroup.center G) := by
  have : DiscreteTopology (Subgroup.center G) := discreteTopology_center_of_center_eq_bot h
  have : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  have : CompactSpace (Subgroup.center G) :=
    isCompact_iff_compactSpace.mp Subgroup.isClosed_center.isCompact
  exact finite_of_compact_of_discrete

/-- **A compact connected Lie group has finite centre exactly when its Lie algebra has trivial
centre**. -/
theorem finite_center_iff [CompactSpace G] [PreconnectedSpace G] :
    Finite (Subgroup.center G) ↔ center ℝ (LeftInvariantDerivation I G) = ⊥ := by
  exact ⟨fun _ => discreteTopology_center_iff.mp inferInstance, finite_center_of_center_eq_bot⟩

end TauCeti.Lie
