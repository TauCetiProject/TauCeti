/-!
# Conjugacy of maximal tori

In a compact finite-dimensional real Lie group `G`, all maximal tori are conjugate, and every torus
is conjugate into any given maximal torus. So the dimension of a maximal torus, the rank of `G`,
does not depend on the torus. No connectedness of `G` is needed.

The proof is the classical maximization argument of Hunt, which needs no degree theory. Fix an
`Ad`-invariant inner product `B` on the Lie algebra `𝔤`. Given `X Y : 𝔤`, the function
`g ↦ B (Ad g X) Y` on the compact group `G` attains its maximum at some `g`, and differentiating
along one-parameter subgroups at the maximum, using that each `ad Z` is skew for `B`, gives
`⁅Ad g X, Y⁆ = 0` (`LeftInvariantDerivation.exists_Ad_lie_eq_zero`). Choose `Y` with `lieExp Y` a
topological generator of a maximal torus `T`. Then the one-parameter subgroup of `Ad g X`
centralizes `T`, so `Ad g X` lies in `Lie(T)`: every adjoint orbit in `𝔤` meets `Lie(T)`. Applying
this to an `X` whose exponential topologically generates another torus `S` conjugates `S` into `T`.

The conjugates of `T` therefore cover exactly the image of the exponential map
(`TauCeti.Lie.IsMaximalTorus.iUnion_map_conj_eq_range_lieExp`). For a compact connected `G` they
cover all of `G` as soon as `lieExp` is known to be surjective, which is a separate theorem.

## Main results

* `TauCeti.Lie.IsMaximalTorus.exists_Ad_mem_lieSubalgebraOfSubgroup`: every adjoint orbit meets the
  Lie algebra of a maximal torus.
* `TauCeti.Lie.IsMaximalTorus.iUnion_map_conj_eq_range_lieExp`: the conjugates of a maximal torus
  cover exactly the image of the exponential map.
* `TauCeti.Lie.IsMaximalTorus.exists_map_conj_le`: a torus is conjugate into any maximal torus.
* `TauCeti.Lie.IsMaximalTorus.exists_map_conj_eq`: **any two maximal tori are conjugate**.
* `TauCeti.Lie.IsMaximalTorus.exists_mem_map_conj_le_of_le`: a torus contained in a closed
  subgroup `K` is conjugate into a maximal torus contained in `K` by an element of `K`.
* `TauCeti.Lie.IsMaximalTorus.exists_mem_map_conj_eq_of_le`: two maximal tori contained in a closed
  subgroup `K` are conjugate by an element of `K`.
* `TauCeti.Lie.IsMaximalTorus.exists_mem_connectedComponentIn_map_conj_eq_of_le`: they are even
  conjugate by an element of the identity component of `K`.
* `TauCeti.Lie.IsMaximalTorus.exists_mem_connectedComponentIn_mul_mem_normalizer_of_le`: if a
  closed subgroup `K` contains `T` and `g T g⁻¹`, then `c g` normalizes `T` for some `c` in the
  identity component of `K`.
* `TauCeti.Lie.IsMaximalTorus.finrank_lieSubalgebraOfSubgroup_eq`: any two maximal tori have the
  same dimension.

## References

* G. A. Hunt, *A theorem of Élie Cartan*, Proc. Amer. Math. Soc. **7** (1956), 307–308.
* T. Bröcker and T. tom Dieck, *Representations of Compact Lie Groups*, Springer GTM 98 (1985),
  Chapter IV, § 1.
-/

public section

noncomputable section

namespace TauCeti.Lie

open scoped ContDiff Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [FiniteDimensional ℝ E] [LieGroup I ∞ G] [T2Space G] [CompactSpace G]

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold

/-- **Every adjoint orbit meets the Lie algebra of a maximal torus.** -/
theorem IsMaximalTorus.exists_Ad_mem_lieSubalgebraOfSubgroup {T : Subgroup G}
    (hT : IsMaximalTorus T) (X : LeftInvariantDerivation I G) :
    ∃ g : G, Ad (I := I) g X ∈ lieSubalgebraOfSubgroup (I := I) T := by
  let _ : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  -- `T` is generated by an element `lieExp Y`, and a translate of `X` brackets to zero with `Y`.
  obtain ⟨t, ht, hgen⟩ := hT.isTorus.exists_closedZpowers_eq I
  rw [← SetLike.mem_coe, ← hT.isTorus.image_lieExp_lieSubalgebraOfSubgroup (I := I)] at ht
  obtain ⟨Y, -, rfl⟩ := ht
  obtain ⟨g, hg⟩ := X.exists_Ad_lie_eq_zero Y
  refine ⟨g, ?_⟩
  -- So its one-parameter subgroup commutes with the generator, and hence with all of `T`.
  rw [← hT.lieSubalgebraOfSubgroup_centralizer,
    mem_lieSubalgebraOfSubgroup (Set.isClosed_centralizer (T : Set G))]
  intro s
  have hle : T ≤ Subgroup.centralizer
      ({lieExp (I := I) (s • Ad (I := I) g X)} : Set G) := by
    rw [← hgen, closedZpowers_le (Set.isClosed_centralizer _),
      Subgroup.mem_centralizer_singleton_iff]
    exact (commute_lieExp_of_lie_eq_zero (by rw [smul_lie, hg, smul_zero])).symm.eq
  rw [Subgroup.mem_centralizer_iff]
  exact fun t ht ↦ Subgroup.mem_centralizer_singleton_iff.mp (hle ht)

/-- **The conjugates of a maximal torus cover exactly the image of the exponential map.** -/
theorem IsMaximalTorus.iUnion_map_conj_eq_range_lieExp {T : Subgroup G} (hT : IsMaximalTorus T) :
    ⋃ g : G, (T.map (MulAut.conj g).toMonoidHom : Set G) =
      Set.range (lieExp (I := I) (G := G)) := by
  ext x
  simp only [Set.mem_iUnion, Subgroup.coe_map, Set.mem_image, SetLike.mem_coe, Set.mem_range]
  constructor
  · rintro ⟨g, t, ht, rfl⟩
    rw [← SetLike.mem_coe, ← hT.isTorus.image_lieExp_lieSubalgebraOfSubgroup (I := I)] at ht
    obtain ⟨Y, -, rfl⟩ := ht
    exact ⟨Ad (I := I) g Y, by rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, conj_lieExp]⟩
  · rintro ⟨X, rfl⟩
    obtain ⟨g, hg⟩ := hT.exists_Ad_mem_lieSubalgebraOfSubgroup (I := I) X
    refine ⟨g⁻¹, lieExp (I := I) (Ad (I := I) g X),
      lieExp_mem_of_mem_lieSubalgebraOfSubgroup hT.isTorus.isClosed hg, ?_⟩
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, ← conj_lieExp]
    group

section Conjugacy

variable (I)
include I

/-- **A torus is conjugate into any maximal torus.** -/
theorem IsMaximalTorus.exists_map_conj_le {S T : Subgroup G} (hT : IsMaximalTorus T)
    (hS : IsTorus S) : ∃ g : G, S.map (MulAut.conj g).toMonoidHom ≤ T := by
  let _ : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  -- `S` is generated by an element `lieExp X`, and `X` has an adjoint translate in `Lie(T)`.
  obtain ⟨s, hs, hgen⟩ := hS.exists_closedZpowers_eq I
  rw [← SetLike.mem_coe, ← hS.image_lieExp_lieSubalgebraOfSubgroup (I := I)] at hs
  obtain ⟨X, -, rfl⟩ := hs
  obtain ⟨g, hg⟩ := hT.exists_Ad_mem_lieSubalgebraOfSubgroup (I := I) X
  refine ⟨g, ?_⟩
  have hclosed : IsClosed (T.comap (MulAut.conj g).toMonoidHom : Set G) :=
    hT.isTorus.isClosed.preimage (IsTopologicalGroup.continuous_conj g)
  rw [Subgroup.map_le_iff_le_comap, ← hgen, closedZpowers_le hclosed, Subgroup.mem_comap,
    MulEquiv.coe_toMonoidHom, MulAut.conj_apply, conj_lieExp]
  exact lieExp_mem_of_mem_lieSubalgebraOfSubgroup hT.isTorus.isClosed hg

/-- **Conjugacy of maximal tori.** Any two maximal tori of a compact Lie group are conjugate. -/
theorem IsMaximalTorus.exists_map_conj_eq {S T : Subgroup G} (hS : IsMaximalTorus S)
    (hT : IsMaximalTorus T) : ∃ g : G, S.map (MulAut.conj g).toMonoidHom = T := by
  let _ : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  obtain ⟨g, hg⟩ := hT.exists_map_conj_le I hS.isTorus
  exact ⟨g, (hS.map_conj g).eq_of_le hT.isTorus hg⟩

/-- A torus contained in a closed subgroup `K` of a compact Lie group is conjugate into any maximal
torus contained in `K`, by an element of `K`. -/
theorem IsMaximalTorus.exists_mem_map_conj_le_of_le {K S T : Subgroup G}
    (hK : IsClosed (K : Set G)) (hT : IsMaximalTorus T) (hS : IsTorus S)
    (hSK : S ≤ K) (hTK : T ≤ K) : ∃ c ∈ K, S.map (MulAut.conj c).toMonoidHom ≤ T := by
  let _ : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  let _ : FiniteDimensional ℝ (LeftInvariantDerivation I G) :=
    finiteDimensional_leftInvariantDerivation
      (ContMDiffMul.isInteriorPoint (I := I) (n := ∞) (by simp) (1 : G))
  -- Cartan's theorem makes `K` a compact Lie group, whose conjugacy theorem applies; `K` need not
  -- be connected.
  let L := (lieSubalgebraOfSubgroup (I := I) K).toSubmodule
  obtain ⟨d⟩ := nonempty_embeddedLieSubgroupData_lieSubalgebraOfSubgroup_of_isClosed
    (I := I) (K := K) hK
  let _ : ChartedSpace L K := d.chartedSpace
  let _ : LieGroup 𝓘(ℝ, L) ∞ K := d.lieGroup
  let _ : CompactSpace K := isCompact_iff_compactSpace.mp hK.isCompact
  -- A maximal torus `S'` of `K` containing `S` is conjugate in `K` to `T`.
  obtain ⟨S', hS', hSS'⟩ := (hS.subgroupOf hSK).exists_isMaximalTorus_le 𝓘(ℝ, L)
  obtain ⟨c, hc⟩ := hS'.exists_map_conj_eq 𝓘(ℝ, L) (hT.subgroupOf hTK)
  refine ⟨c, c.property, ?_⟩
  rintro _ ⟨s, hs, rfl⟩
  have hmem : MulAut.conj c ⟨s, hSK hs⟩ ∈ T.subgroupOf K :=
    hc ▸ ⟨_, hSS' (Subgroup.mem_subgroupOf.mpr hs), rfl⟩
  simpa only [Subgroup.mem_subgroupOf, MulAut.conj_apply, Subgroup.coe_mul,
    InvMemClass.coe_inv, MulEquiv.coe_toMonoidHom] using hmem

/-- Two maximal tori of a compact Lie group that lie in a closed subgroup `K` are conjugate by an
element of `K`. -/
theorem IsMaximalTorus.exists_mem_map_conj_eq_of_le {K S T : Subgroup G}
    (hK : IsClosed (K : Set G)) (hS : IsMaximalTorus S) (hT : IsMaximalTorus T)
    (hSK : S ≤ K) (hTK : T ≤ K) : ∃ c ∈ K, S.map (MulAut.conj c).toMonoidHom = T := by
  let _ : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  obtain ⟨c, hc, hle⟩ := hT.exists_mem_map_conj_le_of_le I hK hS.isTorus hSK hTK
  exact ⟨c, hc, (hS.map_conj c).eq_of_le hT.isTorus hle⟩

/-- Two maximal tori of a compact Lie group that lie in a closed subgroup `K` are conjugate by an
element of the identity component of `K`. -/
theorem IsMaximalTorus.exists_mem_connectedComponentIn_map_conj_eq_of_le {K S T : Subgroup G}
    (hK : IsClosed (K : Set G)) (hS : IsMaximalTorus S) (hT : IsMaximalTorus T)
    (hSK : S ≤ K) (hTK : T ≤ K) :
    ∃ c ∈ connectedComponentIn (K : Set G) 1, S.map (MulAut.conj c).toMonoidHom = T := by
  let _ : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  -- The identity component of `K`, as a subgroup of `G`; it is closed because `K` is.
  let K₀ : Subgroup G := (Subgroup.connectedComponentOfOne K).map K.subtype
  have hK₀ : (K₀ : Set G) = connectedComponentIn (K : Set G) 1 := by
    rw [Subgroup.coe_map, Subgroup.coe_connectedComponentOfOne, Subgroup.coe_subtype,
      connectedComponentIn_eq_image K.one_mem]
    -- The identity `1 : K` is `⟨1, K.one_mem⟩` by definition.
    rfl
  have hK₀closed : IsClosed (K₀ : Set G) := hK₀ ▸ hK.connectedComponentIn
  -- A torus in `K` is connected and contains `1`, so it lies in `K₀`.
  have hle : ∀ {R : Subgroup G}, IsTorus R → R ≤ K → R ≤ K₀ := fun {R} hR hRK ↦ by
    rw [← SetLike.coe_subset_coe, hK₀]
    exact hR.isConnected.isPreconnected.subset_connectedComponentIn R.one_mem hRK
  obtain ⟨c, hc, hmap⟩ := hS.exists_mem_map_conj_eq_of_le I hK₀closed hT
    (hle hS.isTorus hSK) (hle hT.isTorus hTK)
  exact ⟨c, hK₀ ▸ hc, hmap⟩

/-- If a closed subgroup `K` contains a maximal torus `T` of a compact Lie group and its conjugate
`g T g⁻¹`, then `c g` normalizes `T` for some `c` in the identity component of `K`. -/
theorem IsMaximalTorus.exists_mem_connectedComponentIn_mul_mem_normalizer_of_le
    {K T : Subgroup G} (hK : IsClosed (K : Set G)) (hT : IsMaximalTorus T) (hTK : T ≤ K) {g : G}
    (hgK : T.map (MulAut.conj g).toMonoidHom ≤ K) :
    ∃ c ∈ connectedComponentIn (K : Set G) 1, c * g ∈ Subgroup.normalizer (T : Set G) := by
  let _ : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  obtain ⟨c, hc, hmap⟩ :=
    (hT.map_conj g).exists_mem_connectedComponentIn_map_conj_eq_of_le I hK hT hgK hTK
  refine ⟨c, hc, ?_⟩
  rw [Subgroup.mem_normalizer_iff_map_conj_eq, map_mul]
  exact (Subgroup.map_map _ _ _).symm.trans hmap

end Conjugacy

/-- **Any two maximal tori of a compact Lie group have the same dimension**, so the rank of the
group is well defined. -/
theorem IsMaximalTorus.finrank_lieSubalgebraOfSubgroup_eq {S T : Subgroup G}
    (hS : IsMaximalTorus S) (hT : IsMaximalTorus T) :
    Module.finrank ℝ (lieSubalgebraOfSubgroup (I := I) S) =
      Module.finrank ℝ (lieSubalgebraOfSubgroup (I := I) T) := by
  obtain ⟨g, rfl⟩ := hS.exists_map_conj_eq I hT
  rw [lieSubalgebraOfSubgroup_map_conj]
  exact ((Ad (I := I) g).lieSubalgebraMap _).toLinearEquiv.finrank_eq

end TauCeti.Lie
