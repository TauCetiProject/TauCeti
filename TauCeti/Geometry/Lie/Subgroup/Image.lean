module

public import TauCeti.Geometry.Lie.Functor
public import TauCeti.Geometry.Lie.Exponential.Generation

/-!
# Images of connected Lie groups

The image of a smooth homomorphism from a connected finite-dimensional real Lie group is the
subgroup generated by exponentials of the range of its differential. Consequently that range
determines the image, even when the image is not closed. Here `Subgroup.closure` means algebraic
subgroup generation, without taking a topological closure.

This supplies uniqueness of the underlying subgroup in the correspondence between Lie
subalgebras and connected immersed Lie subgroups. The source may have a topology finer than the
subspace topology on its image.

## References

* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Springer (2013), Chapter 20.
-/

public section

open Set
open scoped ContDiff Manifold

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold

namespace ContMDiffMonoidMorphism

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
  {H' : Type*} [TopologicalSpace H'] {I' : ModelWithCorners ℝ E' H'}
  {G' : Type*} [TopologicalSpace G'] [ChartedSpace H' G'] [Group G']
  [LieGroup I ∞ G] [LieGroup I' ∞ G']
  [FiniteDimensional ℝ E] [FiniteDimensional ℝ E'] [PreconnectedSpace G] [T2Space G']

/-- The image of a smooth homomorphism from a connected Lie group is generated by exponentials
of the range of its Lie map. No closedness of the image is required. -/
theorem range_eq_closure_lieExp_image (φ : ContMDiffMonoidMorphism I I' ∞ G G') :
    MonoidHom.range φ.toMonoidHom =
      Subgroup.closure (lieExp '' ((lieMap φ).range : Set (LeftInvariantDerivation I' G'))) := by
  let _ : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  let _ : T2Space G := I.t2Space_of_lieGroup ∞
  have himage : φ.toMonoidHom '' range (lieExp (I := I) (G := G)) =
      lieExp '' ((lieMap φ).range : Set (LeftInvariantDerivation I' G')) := by
    simp only [LieHom.coe_range, ← Set.range_comp']
    congr 1
    funext X
    exact map_lieExp φ X
  rw [← himage, ← MonoidHom.map_closure φ.toMonoidHom,
    TauCeti.closure_range_lieExp_eq_top (I := I) (G := G)]
  exact MonoidHom.range_eq_map φ.toMonoidHom

/-- A smooth homomorphism from a connected Lie group takes values in a subgroup exactly when
that subgroup contains the exponentials of every value of the Lie map. -/
theorem range_le_iff_forall_lieExp_mem (φ : ContMDiffMonoidMorphism I I' ∞ G G')
    (K : Subgroup G') :
    MonoidHom.range φ.toMonoidHom ≤ K ↔
      ∀ X, lieExp (lieMap φ X) ∈ K := by
  rw [φ.range_eq_closure_lieExp_image, Subgroup.closure_le, LieHom.coe_range,
    ← Set.range_comp', Set.range_subset_iff]
  simp only [SetLike.mem_coe]

end ContMDiffMonoidMorphism
