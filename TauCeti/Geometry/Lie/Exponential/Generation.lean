import TauCeti.Geometry.Manifold.Algebra.Monoid

/-!
# Generation of a Lie group by its exponential image

The exponential image of a finite-dimensional real Lie group is a neighbourhood of the identity,
and every value of the exponential lies on a one-parameter subgroup, hence in the identity
component.  Since a neighbourhood of the identity generates the identity component, the subgroup
generated by the exponential image is exactly the identity component, and it is the whole group
when the group is preconnected.

## Main results

* `lieExp_mem_connectedComponent_one`: the exponential takes values in the connected component
  of the identity.
* `range_lieExp_mem_nhds_one`: the exponential image is a neighbourhood of the identity.
* `closure_range_lieExp_eq_connectedComponentOfOne`: the subgroup generated by the exponential
  image is the identity component.
* `closure_range_lieExp_eq_top`: a preconnected Lie group is generated by its exponential image.
* `closure_biUnion_range_lieExp_smul_eq_top`: a preconnected Lie group is generated by the
  one-parameter subgroups of any spanning set of its Lie algebra, since the product of the
  one-parameter subgroups of a basis is a local diffeomorphism at the origin.

The identity component `Subgroup.connectedComponentOfOne G` is only defined for a topological
group, so `closure_range_lieExp_eq_connectedComponentOfOne` carries `[IsTopologicalGroup G]`
explicitly (as `TauCeti/Geometry/Lie/UniversalCover.lean` does); for a Lie group this instance is
`topologicalGroup_of_lieGroup I ∞`, which the preconnected statement uses internally.

## References

* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Proposition 7.14 (a connected Lie group
  is generated by any neighbourhood of the identity), Proposition 20.8 (properties of the
  exponential map) and Theorem 4.5 (the inverse function theorem for manifolds).
-/

public section

open Filter Set
open scoped ContDiff Manifold Topology

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [FiniteDimensional ℝ E] [LieGroup I ∞ G] [T2Space G] [BoundarylessManifold I G]

/-- The exponential takes values in the connected component of the identity. -/
@[simp]
theorem lieExp_mem_connectedComponent_one (X : LeftInvariantDerivation I G) :
    lieExp X ∈ connectedComponent (1 : G) := by
  have hcont : Continuous fun t : ℝ ↦ lieExp (t • X) := by
    simpa only [oneParameterSubgroup_apply] using
      (contMDiff_oneParameterSubgroup (I := I) X).continuous
  have h1 : (1 : G) ∈ range fun t : ℝ ↦ lieExp (t • X) := ⟨0, by simp⟩
  have hX : lieExp X ∈ range fun t : ℝ ↦ lieExp (t • X) := ⟨1, by simp⟩
  exact (isPreconnected_range hcont).subset_connectedComponent h1 hX

/-- The exponential image is a neighbourhood of the identity. -/
theorem range_lieExp_mem_nhds_one : range (lieExp (I := I) (G := G)) ∈ 𝓝 (1 : G) :=
  (eventually_lieExp_lieLog (I := I) (G := G)).mono fun _ hg ↦ ⟨_, hg⟩

/-! ### Generation by one-parameter subgroups -/

/-- The product `lieExp (t 0 • v 0) * ⋯ * lieExp (t (n - 1) • v (n - 1))` of the one-parameter
subgroups of `v 0, …, v (n - 1)` at independent times: coordinates of the second kind. -/
private noncomputable def lieExpProd {n : ℕ} (v : Fin n → LeftInvariantDerivation I G)
    (t : Fin n → ℝ) : G :=
  ((List.finRange n).map fun i ↦ lieExp (t i • v i)).prod

private theorem contMDiff_lieExpProd {n : ℕ} (v : Fin n → LeftInvariantDerivation I G) :
    ContMDiff 𝓘(ℝ, Fin n → ℝ) I ∞ (lieExpProd v) := by
  refine contMDiff_list_prod _ fun i _ ↦ ?_
  have hline := (contMDiff_oneParameterSubgroup (I := I) (v i)).comp
    (contDiff_apply ℝ (fun _ : Fin n ↦ ℝ) i).contMDiff
  simpa only [Function.comp_def, oneParameterSubgroup_apply] using hline

/-- Along the `i`-th coordinate axis the product is the one-parameter subgroup of `v i`. -/
private theorem lieExpProd_single {n : ℕ} (v : Fin n → LeftInvariantDerivation I G) (i : Fin n)
    (s : ℝ) : lieExpProd v (Pi.single i s) = lieExp (s • v i) := by
  rw [lieExpProd, List.prod_map_eq_pow_single i, List.count_finRange, pow_one, Pi.single_eq_same]
  intro j hj _
  rw [Pi.single_eq_of_ne hj, zero_smul, lieExp_zero]

/-- The differential at `0` of the product sends the `i`-th coordinate vector to `v i`, read in
the tangent space at the identity. -/
private theorem mfderiv_lieExpProd_single {n : ℕ} (v : Fin n → LeftInvariantDerivation I G)
    (i : Fin n) :
    mfderiv 𝓘(ℝ, Fin n → ℝ) I (lieExpProd v) 0 (Pi.single i 1) =
      leftInvariantDerivationEquivGroupLieAlgebra (I := I) (G := G)
        BoundarylessManifold.isInteriorPoint (v i) := by
  have hcomp := (((contMDiff_lieExpProd v).mdifferentiableAt (x := Pi.single i 0)
    (by simp)).hasMFDerivAt).comp 0
      (ContinuousLinearMap.single ℝ (fun _ : Fin n ↦ ℝ) i).hasMFDerivAt
  have hfun : lieExpProd v ∘ Pi.single i = fun s : ℝ ↦ mulInvariantExp (I := I) (G := G)
      (s • leftInvariantDerivationEquivGroupLieAlgebra (I := I) (G := G)
        BoundarylessManifold.isInteriorPoint (v i)) := by
    funext s
    simp only [Function.comp_apply, lieExpProd_single, lieExp_eq_mulInvariantExp, map_smul]
  have hexp : HasMFDerivAt 𝓘(ℝ, ℝ) I (lieExpProd v ∘ Pi.single i) 0
      ((1 : ℝ →L[ℝ] ℝ).smulRight (leftInvariantDerivationEquivGroupLieAlgebra (I := I) (G := G)
        BoundarylessManifold.isInteriorPoint (v i))) := by
    rw [hfun]
    exact hasMFDerivAt_mulInvariantExp_smul_zero (I := I) (G := G) _
  have h := congrArg (fun L : ℝ →L[ℝ] _ ↦ L 1) (hcomp.mfderiv.symm.trans hexp.mfderiv)
  rw [Pi.single_zero] at h
  -- The tangent space `TangentSpace I (lieExpProd v 0)` of the differential and the tangent space
  -- `GroupLieAlgebra I G` at `1` of the exponential line are the model space `E` only by unfolding
  -- `TangentSpace`, since `lieExpProd v 0 = 1` is not definitional. Rewriting with
  -- `ContinuousLinearMap.comp_apply` or `ContinuousLinearMap.smulRight_apply` builds motives that
  -- are not type correct across this identification, so both sides are evaluated by `change`:
  -- `comp` and `smulRight` applied to a vector reduce to the application and to `1 • _`.
  change mfderiv 𝓘(ℝ, Fin n → ℝ) I (lieExpProd v) 0 (Pi.single i 1) =
    (1 : ℝ) • leftInvariantDerivationEquivGroupLieAlgebra (I := I) (G := G)
      BoundarylessManifold.isInteriorPoint (v i) at h
  rwa [one_smul] at h

/-- The differential at `0` of the product of the one-parameter subgroups of a linearly
independent family is injective. -/
private theorem injective_mfderiv_lieExpProd {n : ℕ} {v : Fin n → LeftInvariantDerivation I G}
    (hv : LinearIndependent ℝ v) :
    Function.Injective (mfderiv 𝓘(ℝ, Fin n → ℝ) I (lieExpProd v) 0) := by
  let eG := leftInvariantDerivationEquivGroupLieAlgebra (I := I) (G := G)
    BoundarylessManifold.isInteriorPoint
  have h : (mfderiv 𝓘(ℝ, Fin n → ℝ) I (lieExpProd v) 0).toLinearMap =
      eG.toLinearMap ∘ₗ Fintype.linearCombination ℝ v :=
    (Pi.basisFun ℝ (Fin n)).ext fun i ↦ by
      rw [Pi.basisFun_apply]
      -- As in `mfderiv_lieExpProd_single`, the codomain `TangentSpace I (lieExpProd v 0)` is
      -- `GroupLieAlgebra I G` only by unfolding `TangentSpace`, so `LinearMap.comp_apply` and
      -- `ContinuousLinearMap.coe_coe` cannot rewrite here (their motives are not type correct);
      -- the two linear-map applications are unfolded by `change`.
      change mfderiv 𝓘(ℝ, Fin n → ℝ) I (lieExpProd v) 0 (Pi.single i 1) =
        eG (Fintype.linearCombination ℝ v (Pi.single i 1))
      rw [Fintype.linearCombination_apply_single, one_smul]
      exact mfderiv_lieExpProd_single v i
  have hinj : Function.Injective (eG.toLinearMap ∘ₗ Fintype.linearCombination ℝ v) :=
    eG.injective.comp (linearIndependent_iff_injective_fintypeLinearCombination.mp hv)
  rwa [← h] at hinj

/-- **A connected Lie group is generated by the one-parameter subgroups of a spanning set.** If
`A` spans the Lie algebra, the subgroup generated by the one-parameter subgroups
`t ↦ lieExp (t • X)`, `X ∈ A`, is the whole group: for a basis `X₁, …, Xₙ` chosen inside `A`, the
product `(t₁, …, tₙ) ↦ lieExp (t₁ • X₁) * ⋯ * lieExp (tₙ • Xₙ)` is a local diffeomorphism at `0`
by the inverse function theorem, so the subgroup is a neighbourhood of the identity. -/
theorem closure_biUnion_range_lieExp_smul_eq_top [PreconnectedSpace G]
    {A : Set (LeftInvariantDerivation I G)} (hA : Submodule.span ℝ A = ⊤) :
    Subgroup.closure (⋃ X ∈ A, range fun t : ℝ ↦ lieExp (t • X)) = ⊤ := by
  have := topologicalGroup_of_lieGroup I ∞ (G := G)
  have : FiniteDimensional ℝ (LeftInvariantDerivation I G) :=
    finiteDimensional_leftInvariantDerivation BoundarylessManifold.isInteriorPoint
  obtain ⟨b, hbA, hspan, hli⟩ := exists_linearIndependent ℝ A
  let v₀ : Module.Basis b ℝ (LeftInvariantDerivation I G) :=
    .mk hli (by rw [Subtype.range_coe, hspan, hA])
  let v := v₀.reindex (v₀.indexEquiv (Module.finBasis ℝ _))
  have hvA (i) : v i ∈ A := hbA (by simp [v, v₀])
  set U := Subgroup.closure (⋃ X ∈ A, range fun t : ℝ ↦ lieExp (I := I) (t • X))
  have hsub : range (lieExpProd v) ⊆ U := by
    rintro _ ⟨t, rfl⟩
    refine list_prod_mem fun g hg ↦ ?_
    obtain ⟨i, -, rfl⟩ := List.mem_map.mp hg
    exact Subgroup.subset_closure (mem_biUnion (hvA i) ⟨t i, rfl⟩)
  have hdim : Module.finrank ℝ (Fin (Module.finrank ℝ (LeftInvariantDerivation I G)) → ℝ) =
      Module.finrank ℝ E := by
    rw [Module.finrank_fin_fun]
    exact (leftInvariantDerivationLinearIsometryEquivModelVectorSpace (I := I) (G := G)
      ).toLinearEquiv.finrank_eq
  have hloc : IsLocalDiffeomorphAt _ I ∞ (lieExpProd v) 0 :=
    TauCeti.isLocalDiffeomorphAt_of_injective_mfderiv (contMDiff_lieExpProd v).contMDiffOn
      isOpen_univ (mem_univ 0) BoundarylessManifold.isInteriorPoint (by simp)
      (injective_mfderiv_lieExpProd v.linearIndependent) hdim
  have hone : lieExpProd v 0 = 1 := by simp [lieExpProd]
  have hnhds : range (lieExpProd v) ∈ 𝓝 (1 : G) := by
    rw [← hone]
    exact hloc.localInverse_eventuallyEq_right.mono fun y hy ↦ ⟨_, hy⟩
  have hU := Subgroup.closure_eq_top_of_mem_nhds_one (mem_of_superset hnhds hsub)
  rwa [Subgroup.closure_eq] at hU


variable [IsTopologicalGroup G]

/-- **The identity component is generated by the exponential image.** -/
theorem closure_range_lieExp_eq_connectedComponentOfOne :
    Subgroup.closure (range (lieExp (I := I) (G := G))) = Subgroup.connectedComponentOfOne G :=
  Subgroup.closure_eq_connectedComponentOfOne_of_mem_nhds_one_of_subset range_lieExp_mem_nhds_one
    (range_subset_iff.mpr fun X ↦ lieExp_mem_connectedComponent_one X)

omit [IsTopologicalGroup G] in
/-- **A preconnected Lie group is generated by its exponential image.** -/
theorem closure_range_lieExp_eq_top [PreconnectedSpace G] :
    Subgroup.closure (range (lieExp (I := I) (G := G))) = ⊤ := by
  have := topologicalGroup_of_lieGroup I ∞ (G := G)
  rw [closure_range_lieExp_eq_connectedComponentOfOne, Subgroup.connectedComponentOfOne_eq_top]

end TauCeti
