module
public import TauCeti.Geometry.Lie.Exponential.LocalInverse
public import TauCeti.Topology.Algebra.Group.Connected

/-!
# Generation of a Lie group by its exponential image

The exponential image of a finite-dimensional real Lie group is a neighbourhood of the identity,
and every value of the exponential lies on a one-parameter subgroup, hence in the identity
component.  Since a neighbourhood of the identity generates the identity component, the subgroup
generated by the exponential image is exactly the identity component, and it is the whole group
when the group is preconnected.

## Main results

* `lieExp_mem_connectedComponent_one`: the exponential takes values in the connected component
  of the identity.
* `range_lieExp_mem_nhds_one`: the exponential image is a neighbourhood of the identity.
* `closure_range_lieExp_eq_connectedComponentOfOne`: the subgroup generated by the exponential
  image is the identity component.
* `closure_range_lieExp_eq_top`: a preconnected Lie group is generated by its exponential image.

The identity component `Subgroup.connectedComponentOfOne G` is only defined for a topological
group, so the last two results carry `[IsTopologicalGroup G]` explicitly (as
`TauCeti/Geometry/Lie/UniversalCover.lean` does); for a Lie group this instance is
`topologicalGroup_of_lieGroup I ∞`.

## References

* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Proposition 7.14 (a connected Lie group
  is generated by any neighbourhood of the identity) and Proposition 20.8 (properties of the
  exponential map).
-/

public section

open Filter Set
open scoped ContDiff Topology

attribute [local instance] LieGroup.minSmoothnessThree

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [FiniteDimensional ℝ E] [LieGroup I ∞ G] [T2Space G] [BoundarylessManifold I G]

/-- The exponential takes values in the connected component of the identity. -/
@[simp]
theorem lieExp_mem_connectedComponent_one (X : LeftInvariantDerivation I G) :
    lieExp X ∈ connectedComponent (1 : G) := by
  have hcont : Continuous fun t : ℝ ↦ lieExp (t • X) := by
    simpa only [oneParameterSubgroup_apply] using
      (contMDiff_oneParameterSubgroup (I := I) X).continuous
  have h1 : (1 : G) ∈ range fun t : ℝ ↦ lieExp (t • X) := ⟨0, by simp⟩
  have hX : lieExp X ∈ range fun t : ℝ ↦ lieExp (t • X) := ⟨1, by simp⟩
  exact (isPreconnected_range hcont).subset_connectedComponent h1 hX

/-- The exponential image is a neighbourhood of the identity. -/
theorem range_lieExp_mem_nhds_one : range (lieExp (I := I) (G := G)) ∈ 𝓝 (1 : G) :=
  (eventually_lieExp_lieLog (I := I) (G := G)).mono fun _ hg ↦ ⟨_, hg⟩

variable [IsTopologicalGroup G]

/-- **The identity component is generated by the exponential image.** -/
theorem closure_range_lieExp_eq_connectedComponentOfOne :
    Subgroup.closure (range (lieExp (I := I) (G := G))) = Subgroup.connectedComponentOfOne G :=
  Subgroup.closure_eq_connectedComponentOfOne_of_mem_nhds_one_of_subset range_lieExp_mem_nhds_one
    (range_subset_iff.mpr fun X ↦ lieExp_mem_connectedComponent_one X)

/-- **A preconnected Lie group is generated by its exponential image.** -/
theorem closure_range_lieExp_eq_top [PreconnectedSpace G] :
    Subgroup.closure (range (lieExp (I := I) (G := G))) = ⊤ := by
  rw [closure_range_lieExp_eq_connectedComponentOfOne, Subgroup.connectedComponentOfOne_eq_top]

end TauCeti
