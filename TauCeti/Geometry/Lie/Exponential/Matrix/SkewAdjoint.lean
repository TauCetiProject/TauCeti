/-!
# Matrix exponential lines preserving a bilinear or quadratic form

For a square matrix `J` over a complete normed commutative `ℝ`-algebra `𝕜`, a matrix `A` generates
a real one-parameter exponential family `t ↦ exp (t • A)` preserving `J` in the sense
`(exp (t • A))ᵀ * J * exp (t • A) = J` if and only if `A` belongs to
`skewAdjointMatricesLieSubalgebra J` (`Aᵀ * J = J * (-A)`). Neither invertibility nor symmetry of
`J` is required: the derivative of `t ↦ (exp (t • A))ᵀ * J * exp (t • A)` is
`exp (t • Aᵀ) * (Aᵀ * J + J * A) * exp (t • A)`, which vanishes identically when `A` is
`J`-skew-adjoint and equals `Aᵀ * J + J * A` at `t = 0`.

When `J.det` is a non-zerodivisor in `𝕜`, cancelling `J.det` in the determinant of
`(exp (s • A))ᵀ * J * exp (s • A) = J` yields `(exp (s • A)).det ^ 2 = 1`, so
`s ↦ 2⁻¹ • (1 - (exp (s • A)).det)` is a continuous path of idempotents in `𝕜` starting at `0`.
Since `0` is clopen in the idempotents of any normed ring, connectedness of `ℝ` forces
`(exp A).det = 1`. Specializing `J` to the polar Gram matrix of a nondegenerate quadratic form `Q`
on `n → 𝕜` characterizes the real exponential lines in the general-linear range of `SO(Q)` as those
generated by `skewAdjointMatricesLieSubalgebra J`.

## Main results

* `Matrix.exp_transpose_mul_mul_exp_of_mem_skewAdjointMatricesLieSubalgebra`: `J`-skew-adjoint
  matrices exponentiate to `J`-preserving matrices, for arbitrary `J`.
* `Matrix.forall_exp_smul_transpose_mul_mul_eq_iff_mem_skewAdjointMatricesLieSubalgebra`: the real
  exponential line of `A` preserves `J` if and only if `A ∈ skewAdjointMatricesLieSubalgebra J`.
* `Matrix.det_exp_eq_one_of_mem_skewAdjointMatricesLieSubalgebra`: when `J.det ∈ nonZeroDivisors 𝕜`,
  the exponential of `A ∈ skewAdjointMatricesLieSubalgebra J` has determinant `1`.
* `Matrix.forall_exp_smul_transpose_mul_mul_eq_and_det_eq_one_iff`: combining `J`-invariance with
  unit determinant along the real exponential line gives the same `J`-skew-adjoint Lie subalgebra
  when `J.det ∈ nonZeroDivisors 𝕜`.
* `QuadraticMap.forall_expUnit_smul_mem_range_specialOrthogonalToGeneralLinear_iff`: for a
  nondegenerate quadratic form `Q` on `n → 𝕜`, `t ↦ expUnit (t • A)` stays in the coordinate range
  of `SO(Q)` if and only if `A ∈ skewAdjointMatricesLieSubalgebra (toMatrix' Q.polarBilin)`.
-/

public section

open NormedSpace
open scoped Matrix Matrix.Norms.Operator nonZeroDivisors

noncomputable section

namespace Matrix

variable {n : Type*} [Fintype n] [DecidableEq n]
  {𝕜 : Type*} [NormedCommRing 𝕜] [NormedAlgebra ℝ 𝕜] [CompleteSpace 𝕜]

attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance] Matrix.linftyOpTopologicalSpace TauCeti.normedAlgebraRatOfReal
attribute [local instance] NormedAlgebra.toNormedSpace

private theorem hasDerivAt_exp_smul_transpose_mul_mul_exp_smul
    (J A : Matrix n n 𝕜) (t : ℝ) :
    HasDerivAt
      (fun s : ℝ ↦ (exp (s • A))ᵀ * J * exp (s • A))
      (exp (t • Aᵀ) * (Aᵀ * J + J * A) * exp (t • A)) t := by
  have hexpT (B : Matrix n n 𝕜) : (exp B)ᵀ = exp Bᵀ := by
    convert (exp_transpose B).symm <;> exact Matrix.linftyOpTopologicalSpace_eq n n 𝕜
  have hfn : (fun s : ℝ ↦ (exp (s • A))ᵀ * J * exp (s • A)) =
      fun s : ℝ ↦ exp (s • Aᵀ) * J * exp (s • A) := by
    funext s
    rw [hexpT, ← IsScalarTower.algebraMap_smul 𝕜 s A, Matrix.transpose_smul,
      IsScalarTower.algebraMap_smul]
  rw [hfn]
  have hleft := (hasDerivAt_exp_smul_const Aᵀ t).mul_const J
  have hright := hasDerivAt_exp_smul_const' A t
  exact (hleft.fun_mul hright).congr_deriv (by noncomm_ring)

/-- The matrix exponential of an element of `skewAdjointMatricesLieSubalgebra J` preserves `J`,
without any invertibility or symmetry assumption on `J`. -/
theorem exp_transpose_mul_mul_exp_of_mem_skewAdjointMatricesLieSubalgebra
    (J A : Matrix n n 𝕜) (hA : A ∈ skewAdjointMatricesLieSubalgebra J) :
    (exp A)ᵀ * J * exp A = J := by
  have hskew : Aᵀ * J + J * A = 0 := by
    simp only [mem_skewAdjointMatricesLieSubalgebra, mem_skewAdjointMatricesSubmodule,
      Matrix.IsSkewAdjoint, Matrix.IsAdjointPair] at hA
    rw [hA, mul_neg, neg_add_cancel]
  let f : ℝ → Matrix n n 𝕜 := fun s ↦ (exp (s • A))ᵀ * J * exp (s • A)
  have hf (t : ℝ) : HasDerivAt f 0 t := by
    simpa only [f, hskew, mul_zero, zero_mul] using
      hasDerivAt_exp_smul_transpose_mul_mul_exp_smul J A t
  have hconst := _root_.is_const_of_deriv_eq_zero
    (fun t ↦ (hf t).differentiableAt) (fun t ↦ (hf t).deriv) 1 0
  simpa only [f, one_smul, zero_smul, exp_zero, transpose_one, one_mul, mul_one] using hconst

/-- A matrix `A` generates a `J`-preserving real exponential line if and only if `A` belongs to
`skewAdjointMatricesLieSubalgebra J`. -/
@[simp]
theorem forall_exp_smul_transpose_mul_mul_eq_iff_mem_skewAdjointMatricesLieSubalgebra
    (J A : Matrix n n 𝕜) :
    (∀ t : ℝ, (exp (t • A))ᵀ * J * exp (t • A) = J) ↔
      A ∈ skewAdjointMatricesLieSubalgebra J := by
  constructor
  · intro h
    have hconst : HasDerivAt (fun s : ℝ ↦ (exp (s • A))ᵀ * J * exp (s • A)) 0 0 := by
      simpa only [funext h] using hasDerivAt_const (0 : ℝ) J
    have h0 := (hasDerivAt_exp_smul_transpose_mul_mul_exp_smul J A 0).unique hconst
    simp only [zero_smul, exp_zero, one_mul, mul_one] at h0
    simp only [mem_skewAdjointMatricesLieSubalgebra, mem_skewAdjointMatricesSubmodule,
      Matrix.IsSkewAdjoint, Matrix.IsAdjointPair]
    rw [mul_neg, eq_neg_iff_add_eq_zero]
    exact h0
  · intro hA t
    refine exp_transpose_mul_mul_exp_of_mem_skewAdjointMatricesLieSubalgebra J (t • A) ?_
    rw [← IsScalarTower.algebraMap_smul 𝕜 t A]
    exact (skewAdjointMatricesLieSubalgebra J).smul_mem (algebraMap ℝ 𝕜 t) hA

omit [CompleteSpace 𝕜] in
private theorem eq_one_of_continuous_sq_eq_one {f : ℝ → 𝕜} (hf : Continuous f) (hf0 : f 0 = 1)
    (hsq : ∀ s : ℝ, f s ^ 2 = 1) (t : ℝ) : f t = 1 := by
  let e : ℝ → 𝕜 := fun s ↦ (2⁻¹ : ℝ) • (1 - f s)
  have he_cont : Continuous e := (continuous_const.sub hf).const_smul (2⁻¹ : ℝ)
  have he_idem (s : ℝ) : e s * e s = e s := by
    have hprod : (1 - f s) * (1 - f s) = (2 : ℝ) • (1 - f s) := by
      rw [two_smul]
      linear_combination hsq s
    calc
      e s * e s = ((2⁻¹ : ℝ) * (2⁻¹ : ℝ)) • ((1 - f s) * (1 - f s)) :=
        smul_mul_smul_comm _ _ _ _
      _ = ((2⁻¹ : ℝ) * (2⁻¹ : ℝ) * 2) • (1 - f s) := by rw [hprod, smul_smul]
      _ = e s := by norm_num [e]
  have hclopen : IsClopen {s : ℝ | e s = 0} := by
    refine ⟨isClosed_singleton.preimage he_cont, ?_⟩
    have hset : {s : ℝ | e s = 0} = e ⁻¹' Metric.ball 0 1 := by
      ext s
      simp only [Set.mem_ofPred_eq, Set.mem_preimage, Metric.mem_ball, dist_zero_right]
      refine ⟨fun hs ↦ by simp [hs], fun hlt ↦ by_contra fun hne ↦ ?_⟩
      have hpos : 0 < ‖e s‖ := norm_pos_iff.mpr hne
      have hle : ‖e s‖ * 1 ≤ ‖e s‖ * ‖e s‖ := by
        rw [mul_one]
        nth_rewrite 1 [← he_idem s]
        exact norm_mul_le (e s) (e s)
      exact not_lt_of_ge (le_of_mul_le_mul_left hle hpos) hlt
    rw [hset]
    exact Metric.isOpen_ball.preimage he_cont
  have ht : e t = 0 := by
    have huniv := hclopen.eq_univ ⟨0, by simp [e, hf0]⟩
    exact Set.eq_univ_iff_forall.mp huniv t
  have hsub : 1 - f t = 0 := by
    simpa [e, smul_smul] using congrArg ((2 : ℝ) • ·) ht
  exact (sub_eq_zero.mp hsub).symm

/-- When `J.det` is a non-zerodivisor in `𝕜`, the exponential of every
`A ∈ skewAdjointMatricesLieSubalgebra J` has determinant `1`. -/
theorem det_exp_eq_one_of_mem_skewAdjointMatricesLieSubalgebra
    {J : Matrix n n 𝕜} (hJ : J.det ∈ 𝕜⁰) (A : Matrix n n 𝕜)
    (hA : A ∈ skewAdjointMatricesLieSubalgebra J) :
    (exp A).det = 1 := by
  have hsq (s : ℝ) : (exp (s • A)).det ^ 2 = 1 := by
    have hs : (exp (s • A))ᵀ * J * exp (s • A) = J :=
      (forall_exp_smul_transpose_mul_mul_eq_iff_mem_skewAdjointMatricesLieSubalgebra J A).mpr hA s
    have hdet := congrArg Matrix.det hs
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, mul_right_comm, ← sq] at hdet
    have hzero : ((exp (s • A)).det ^ 2 - 1) * J.det = 0 := by linear_combination hdet
    exact sub_eq_zero.mp (mem_nonZeroDivisors_iff_right.mp hJ _ hzero)
  simpa using eq_one_of_continuous_sq_eq_one
    (differentiable_exp_smul_const (𝕂 := ℝ) A).continuous.matrix_det (by simp) hsq 1

/-- When `J.det` is a non-zerodivisor in `𝕜`, the real exponential line of `A` preserves `J` with
determinant `1` if and only if `A ∈ skewAdjointMatricesLieSubalgebra J`. -/
@[simp]
theorem forall_exp_smul_transpose_mul_mul_eq_and_det_eq_one_iff
    {J : Matrix n n 𝕜} (hJ : J.det ∈ 𝕜⁰) (A : Matrix n n 𝕜) :
    (∀ t : ℝ, (exp (t • A))ᵀ * J * exp (t • A) = J ∧ (exp (t • A)).det = 1) ↔
      A ∈ skewAdjointMatricesLieSubalgebra J := by
  constructor
  · intro h
    exact (forall_exp_smul_transpose_mul_mul_eq_iff_mem_skewAdjointMatricesLieSubalgebra J A).mp
      fun t ↦ (h t).1
  · intro hA t
    have htA : t • A ∈ skewAdjointMatricesLieSubalgebra J := by
      rw [← IsScalarTower.algebraMap_smul 𝕜 t A]
      exact (skewAdjointMatricesLieSubalgebra J).smul_mem (algebraMap ℝ 𝕜 t) hA
    exact ⟨exp_transpose_mul_mul_exp_of_mem_skewAdjointMatricesLieSubalgebra J (t • A) htA,
      det_exp_eq_one_of_mem_skewAdjointMatricesLieSubalgebra hJ (t • A) htA⟩

end Matrix

namespace QuadraticMap

variable {n : Type*} [Fintype n] [DecidableEq n]
  {𝕜 : Type*} [NormedCommRing 𝕜] [NormedAlgebra ℝ 𝕜] [CompleteSpace 𝕜]

attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance] Matrix.linftyOpTopologicalSpace TauCeti.normedAlgebraRatOfReal
attribute [local instance] NormedAlgebra.toNormedSpace

/-- For a nondegenerate quadratic form `Q` on `n → 𝕜` over a complete normed commutative
`ℝ`-algebra `𝕜`, the real exponential line `t ↦ expUnit (t • A)` lies in the coordinate range of
`SO(Q)` if and only if `A ∈ skewAdjointMatricesLieSubalgebra (toMatrix' Q.polarBilin)`. -/
-- Normalize the exponential-line predicate before range membership expands.
@[simp↓]
theorem forall_expUnit_smul_mem_range_specialOrthogonalToGeneralLinear_iff
    (Q : QuadraticForm 𝕜 (n → 𝕜)) (hQ : Q.Nondegenerate) (A : Matrix n n 𝕜) :
    (∀ t : ℝ, TauCeti.expUnit (t • A) ∈ MonoidHom.range Q.specialOrthogonalToGeneralLinear) ↔
      A ∈ skewAdjointMatricesLieSubalgebra (LinearMap.BilinForm.toMatrix' Q.polarBilin) := by
  let _ : Invertible (2 : 𝕜) :=
    ⟨algebraMap ℝ 𝕜 2⁻¹,
      by rw [← map_ofNat (algebraMap ℝ 𝕜) 2, ← map_mul, inv_mul_cancel₀ two_ne_zero, map_one],
      by rw [← map_ofNat (algebraMap ℝ 𝕜) 2, ← map_mul, mul_inv_cancel₀ two_ne_zero, map_one]⟩
  have h2 : IsSMulRegular 𝕜 (2 : 𝕜) := (isUnit_of_invertible (2 : 𝕜)).isRegular.left
  have hpolar : Q.polarBilin.Nondegenerate := QuadraticMap.nondegenerate_polar_iff.mpr hQ
  have hinj : Function.Injective (LinearMap.BilinForm.toMatrix' Q.polarBilin).mulVec := by
    intro x y hxy
    have hsub : (LinearMap.BilinForm.toMatrix' Q.polarBilin) *ᵥ (x - y) = 0 := by
      rw [Matrix.mulVec_sub, hxy, sub_self]
    refine sub_eq_zero.mp (hpolar.2 (x - y) fun v ↦ ?_)
    have hzero (i : n) :
        ∑ j, LinearMap.BilinForm.toMatrix' Q.polarBilin i j * (x - y) j = 0 :=
      congrFun hsub i
    rw [← Matrix.toBilin'_toMatrix' Q.polarBilin, Matrix.toBilin'_apply]
    simp_rw [mul_assoc, ← Finset.mul_sum, hzero, mul_zero, Finset.sum_const_zero]
  have hJ : (LinearMap.BilinForm.toMatrix' Q.polarBilin).det ∈ 𝕜⁰ :=
    Matrix.nonsingular_iff_det_mem_nonZeroDivisors.mp
      (.of_linearIndependent_col (Matrix.mulVec_injective_iff.mp hinj))
  simp only [Q.mem_range_specialOrthogonalToGeneralLinear_iff_polarBilin h2, TauCeti.expUnit_coe,
    Matrix.forall_exp_smul_transpose_mul_mul_eq_and_det_eq_one_iff hJ]

end QuadraticMap
