/-!
# Kronecker's theorem: topological generators of commutative Lie groups

A **topological generator** of a topological group is an element `g` whose closed cyclic subgroup
`closedZpowers g` is the whole group. For a connected commutative Lie group `G` with Lie algebra
`𝔤` and integral lattice `Λ = ker (lieExp : 𝔤 → G)`, the exponential of `X ∈ 𝔤` is a
topological generator exactly when `Λ + ℤ X` is dense in `𝔤`
(`closedZpowers_lieExp_eq_top_iff`), since the exponential is an open continuous surjection whose
fibres are the cosets of `Λ`. When `G` is compact, `Λ` spans `𝔤` and the vectors `X` with
`Λ + ℤ X` dense are dense in `𝔤` (`AddSubgroup.dense_setOfPred_dense_sup`, Kronecker's theorem),
so topological generators are dense in `G`.

## Main results

* `TauCeti.closedZpowers_lieExp_eq_top_iff`: `lieExp X` is a topological generator of a connected
  commutative Lie group if and only if `Λ + ℤ X` is dense in the Lie algebra.
* `TauCeti.dense_setOfPred_closedZpowers_eq_top` and `TauCeti.exists_closedZpowers_eq_top`:
  topological generators of a compact connected commutative Lie group are dense; in particular
  they exist.

## References

* T. Bröcker and T. tom Dieck, *Representations of Compact Lie Groups*, Springer GTM 98 (1985),
  Chapter I, § 4, Theorem (4.13) (Kronecker's theorem) and Proposition (4.14).
* D. Bump, *Lie Groups*, 2nd ed., Springer GTM 225 (2013), Chapter 15, Theorem 15.1 and
  Corollary 15.1.
-/

public section

noncomputable section

namespace TauCeti

open Set Topology
open scoped ContDiff Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]
  [FiniteDimensional ℝ E] [LieGroup I ∞ G] [T2Space G] [IsMulCommutative G]
  [IsTopologicalGroup G]

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold

omit [IsTopologicalGroup G] in
/-- The preimage under the exponential of the cyclic subgroup generated by `lieExp X` is
`Λ + ℤ X`. -/
private theorem preimage_lieExp_zpowers_lieExp (X : LeftInvariantDerivation I G) :
    lieExp (I := I) ⁻¹' (Subgroup.zpowers (lieExp (I := I) X) : Set G) =
      ((lieExpAddMonoidHom (I := I) (G := G)).ker ⊔ AddSubgroup.zmultiples X : AddSubgroup _) :=
  calc lieExp (I := I) ⁻¹' (Subgroup.zpowers (lieExp (I := I) X) : Set G)
      -- The exponential is the exponential homomorphism `f` followed by `Additive.toMul`.
      _ = lieExpAddMonoidHom (I := I) (G := G) ⁻¹'
          (Additive.ofMul '' (Subgroup.zpowers (lieExp (I := I) X) : Set G)) := by
        rw [coe_lieExpAddMonoidHom, Set.preimage_comp, Equiv.preimage_image]
      -- The cyclic subgroup of `lieExp X`, read in `Additive G`, is the image of `ℤ X` under `f`.
      _ = lieExpAddMonoidHom (I := I) (G := G) ⁻¹'
          ((AddSubgroup.zmultiples X).map (lieExpAddMonoidHom (I := I) (G := G)) :
            Set (Additive G)) := by
        rw [ofMul_image_zpowers_eq_zmultiples_ofMul, ← lieExpAddMonoidHom_apply,
          AddMonoidHom.map_zmultiples]
      -- The preimage of the image of a subgroup under a homomorphism is the subgroup plus the
      -- kernel.
      _ = _ := by
        rw [← AddSubgroup.coe_comap, AddSubgroup.comap_map_eq, sup_comm]

section Preconnected

variable [PreconnectedSpace G]

/-- **Kronecker's criterion**: `lieExp X` is a topological generator of a connected commutative
Lie group if and only if `Λ + ℤ X` is dense in the Lie algebra, `Λ` the kernel of the
exponential. -/
theorem closedZpowers_lieExp_eq_top_iff (X : LeftInvariantDerivation I G) :
    closedZpowers (lieExp (I := I) X) = ⊤ ↔
      Dense (((lieExpAddMonoidHom (I := I) (G := G)).ker ⊔ AddSubgroup.zmultiples X :
        AddSubgroup (LeftInvariantDerivation I G)) : Set (LeftInvariantDerivation I G)) := by
  rw [closedZpowers_def, ← Subgroup.dense_iff_topologicalClosure_eq_top,
    ← preimage_lieExp_zpowers_lieExp]
  exact (IsOpenQuotientMap.dense_preimage_iff ⟨lieExp_surjective_of_preconnectedSpace,
    (contMDiff_lieExp (I := I) (G := G)).continuous, isOpenMap_lieExp⟩).symm

end Preconnected

section Compact

variable [CompactSpace G] [PreconnectedSpace G]

/-- The Lie algebra is finite-dimensional; a local instance for the lattice argument. -/
private noncomputable local instance : FiniteDimensional ℝ (LeftInvariantDerivation I G) :=
  finiteDimensional_leftInvariantDerivation
    (ContMDiffMul.isInteriorPoint (I := I) (n := ∞) (by simp) (1 : G))

variable (I)
include I

/-- **Topological generators of a compact connected commutative Lie group are dense.** -/
theorem dense_setOfPred_closedZpowers_eq_top : Dense {g : G | closedZpowers g = ⊤} := by
  have hgen := AddSubgroup.dense_setOfPred_dense_sup
    (span_ker_lieExpAddMonoidHom_eq_top (I := I) (G := G))
  refine ((lieExp_surjective_of_preconnectedSpace (I := I) (G := G)).denseRange.dense_image
    (contMDiff_lieExp (I := I) (G := G)).continuous hgen).mono ?_
  rintro _ ⟨X, hX, rfl⟩
  exact (closedZpowers_lieExp_eq_top_iff X).mpr hX

/-- **A compact connected commutative Lie group has a topological generator.** -/
theorem exists_closedZpowers_eq_top : ∃ g : G, closedZpowers g = ⊤ :=
  (dense_setOfPred_closedZpowers_eq_top I (G := G)).nonempty

end Compact

end TauCeti
