module

public import TauCeti.Geometry.Lie.Functor
import TauCeti.Geometry.Lie.Adjoint.Exponential.Formula
import TauCeti.Geometry.Lie.Exponential.Generation

/-!
# Commuting Lie algebras integrate to commuting images

Let `φ : A → G` and `ψ : K → G` be smooth homomorphisms out of connected finite-dimensional real
Lie groups. If the images of their Lie maps bracket to zero, then every `φ a` commutes with every
`ψ k`. Both sources are generated by their exponential images (`closure_range_lieExp_eq_top`),
the homomorphisms carry exponentials to exponentials (`map_lieExp`), and the exponentials of
commuting elements of `𝔤` commute (`commute_lieExp_of_lie_eq_zero`).

## Main results

* `TauCeti.Lie.commute_of_lie_lieMap_eq_zero`: commuting Lie algebras integrate to commuting
  images.
-/

public section

noncomputable section

open Function Set
open scoped ContDiff Manifold

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold

namespace TauCeti.Lie

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {A : Type*} [TopologicalSpace A] [ChartedSpace H A] [Group A] [LieGroup I ∞ A]
  {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E'] [FiniteDimensional ℝ E']
  {H' : Type*} [TopologicalSpace H'] {I' : ModelWithCorners ℝ E' H'}
  {K : Type*} [TopologicalSpace K] [ChartedSpace H' K] [Group K] [LieGroup I' ∞ K]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {HF : Type*} [TopologicalSpace HF] {J : ModelWithCorners ℝ F HF}
  {G : Type*} [TopologicalSpace G] [ChartedSpace HF G] [Group G] [LieGroup J ∞ G]

/-- **Commuting Lie algebras integrate to commuting images.** If the Lie maps of two smooth
homomorphisms `φ : A → G` and `ψ : K → G` out of connected Lie groups have commuting images, then
every `φ a` commutes with every `ψ k`. -/
theorem commute_of_lie_lieMap_eq_zero [PreconnectedSpace A] [PreconnectedSpace K]
    (φ : ContMDiffMonoidMorphism I J ∞ A G) (ψ : ContMDiffMonoidMorphism I' J ∞ K G)
    (h : ∀ X Y, ⁅lieMap φ X, lieMap ψ Y⁆ = 0) (a : A) (k : K) : Commute (φ a) (ψ k) := by
  let _ : T2Space A := I.t2Space_of_lieGroup ∞
  let _ : T2Space K := I'.t2Space_of_lieGroup ∞
  let _ : T2Space G := J.t2Space_of_lieGroup ∞
  -- First for `a` an exponential, by induction on `k` in the subgroup generated by exponentials.
  have hexp (X : LeftInvariantDerivation I A) : Commute (φ (lieExp X)) (ψ k) := by
    have hk : k ∈ Subgroup.closure (range (lieExp (I := I') (G := K))) := by
      rw [closure_range_lieExp_eq_top]
      exact Subgroup.mem_top k
    induction hk using Subgroup.closure_induction with
    | mem k hk =>
      obtain ⟨Y, rfl⟩ := hk
      rw [map_lieExp φ X, map_lieExp ψ Y]
      exact commute_lieExp_of_lie_eq_zero (h X Y)
    | one => rw [map_one]; exact Commute.one_right _
    | mul k k' _ _ hk hk' => rw [map_mul]; exact hk.mul_right hk'
    | inv k _ hk => rw [map_inv]; exact hk.inv_right
  -- Then for every `a`, by induction in the subgroup generated by exponentials.
  have ha : a ∈ Subgroup.closure (range (lieExp (I := I) (G := A))) := by
    rw [closure_range_lieExp_eq_top]
    exact Subgroup.mem_top a
  induction ha using Subgroup.closure_induction with
  | mem a ha =>
    obtain ⟨X, rfl⟩ := ha
    exact hexp X
  | one => rw [map_one]; exact Commute.one_left _
  | mul a a' _ _ ha ha' => rw [map_mul]; exact ha.mul_left ha'
  | inv a _ ha => rw [map_inv]; exact ha.inv_left

end TauCeti.Lie
