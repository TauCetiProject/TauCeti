variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {A : Type*} [TopologicalSpace A] [ChartedSpace H A] [Group A] [LieGroup I ∞ A]
  {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E'] [FiniteDimensional ℝ E']
  {H' : Type*} [TopologicalSpace H'] {I' : ModelWithCorners ℝ E' H'}
  {K : Type*} [TopologicalSpace K] [ChartedSpace H' K] [Group K] [LieGroup I' ∞ K]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {HF : Type*} [TopologicalSpace HF] {J : ModelWithCorners ℝ F HF}
  {G : Type*} [TopologicalSpace G] [ChartedSpace HF G] [Group G] [LieGroup J ∞ G]

/-- **Commuting Lie algebras integrate to commuting images.** If the Lie maps of two smooth
homomorphisms `φ : A → G` and `ψ : K → G` out of connected Lie groups have commuting images, then
every `φ a` commutes with every `ψ k`. -/
theorem commute_of_lie_lieMap_eq_zero [PreconnectedSpace A] [PreconnectedSpace K]
    (φ : ContMDiffMonoidMorphism I J ∞ A G) (ψ : ContMDiffMonoidMorphism I' J ∞ K G)
    (h : ∀ X Y, ⁅lieMap φ X, lieMap ψ Y⁆ = 0) (a : A) (k : K) : Commute (φ a) (ψ k) := by
  let _ : T2Space A := I.t2Space_of_lieGroup ∞
  let _ : T2Space K := I'.t2Space_of_lieGroup ∞
  let _ : T2Space G := J.t2Space_of_lieGroup ∞
  -- First for `a` an exponential, by induction on `k` in the subgroup generated by exponentials.
  have hexp (X : LeftInvariantDerivation I A) : Commute (φ (lieExp X)) (ψ k) := by
    have hk : k ∈ Subgroup.closure (range (lieExp (I := I') (G := K))) := by
      rw [closure_range_lieExp_eq_top]
      exact Subgroup.mem_top k
    induction hk using Subgroup.closure_induction with
    | mem k hk =>
      obtain ⟨Y, rfl⟩ := hk
      rw [map_lieExp φ X, map_lieExp ψ Y]
      exact commute_lieExp_of_lie_eq_zero (h X Y)
    | one => rw [map_one]; exact Commute.one_right _
    | mul k k' _ _ hk hk' => rw [map_mul]; exact hk.mul_right hk'
    | inv k _ hk => rw [map_inv]; exact hk.inv_right
  -- Then for every `a`, by induction in the subgroup generated by exponentials.
  have ha : a ∈ Subgroup.closure (range (lieExp (I := I) (G := A))) := by
    rw [closure_range_lieExp_eq_top]
    exact Subgroup.mem_top a
  induction ha using Subgroup.closure_induction with
  | mem a ha =>
    obtain ⟨X, rfl⟩ := ha
    exact hexp X
  | one => rw [map_one]; exact Commute.one_left _
  | mul a a' _ _ ha ha' => rw [map_mul]; exact ha.mul_left ha'
  | inv a _ ha => rw [map_inv]; exact ha.inv_left

/-- The Lie map of the product `(a, k) ↦ φ a * ψ k` of two commuting smooth homomorphisms is
bijective when the Lie maps of `φ` and `ψ` are injective with complementary ranges. -/
theorem bijective_lieMap_noncommCoprod
    (φ : ContMDiffMonoidMorphism I J ∞ A G) (ψ : ContMDiffMonoidMorphism I' J ∞ K G)
    (h : ∀ a k, Commute (φ a) (ψ k)) (hφ : Injective (lieMap φ)) (hψ : Injective (lieMap ψ))
    (hc : IsCompl (LinearMap.range (lieMap φ).toLinearMap)
      (LinearMap.range (lieMap ψ).toLinearMap)) :
    Bijective (lieMap (φ.noncommCoprod ψ h)) := by
  let s : LeftInvariantDerivation I A × LeftInvariantDerivation I' K →
      LeftInvariantDerivation J G := fun p ↦ lieMap φ p.1 + lieMap ψ p.2
  have hs : Bijective s := by
    refine ⟨fun p q hpq ↦ ?_, fun D ↦ ?_⟩
    · have hmem : lieMap φ (p.1 - q.1) = lieMap ψ (q.2 - p.2) := by
        simp only [s] at hpq
        rw [map_sub, map_sub]
        linear_combination (norm := abel_nf) hpq
      have h0 : lieMap φ (p.1 - q.1) = 0 :=
        (Submodule.disjoint_def.mp hc.disjoint) _ (LinearMap.mem_range_self _ _)
          (hmem ▸ LinearMap.mem_range_self _ _)
      have h1 : p.1 = q.1 := sub_eq_zero.mp (hφ (h0.trans (map_zero _).symm))
      have h2 : p.2 = q.2 := (sub_eq_zero.mp (hψ ((hmem.symm.trans h0).trans
        (map_zero _).symm))).symm
      exact Prod.ext h1 h2
    · obtain ⟨_, ⟨X, rfl⟩, _, ⟨Y, rfl⟩, hXY⟩ :=
        Submodule.mem_sup.mp (hc.sup_eq_top ▸ Submodule.mem_top (x := D))
      exact ⟨(X, Y), hXY⟩
  have heq : ⇑(lieMap (φ.noncommCoprod ψ h)) = s ∘ prodLieEquiv := by
    ext D
    simp only [comp_apply, prodLieEquiv_apply, s, lieMap_noncommCoprod]
  rw [heq]
  exact hs.comp prodLieEquiv.bijective

variable [PreconnectedSpace A] [PreconnectedSpace K] [SimplyConnectedSpace G]

/-- **Splitting a simply connected Lie group into two commuting subgroups.** Let `φ : A → G` and
`ψ : K → G` be smooth homomorphisms out of connected Lie groups into a simply connected Lie group,
with commuting images, whose Lie maps are injective with complementary ranges. Then
`(a, k) ↦ φ a * ψ k` is an isomorphism of topological groups `A × K ≃ₜ* G`. -/
def noncommCoprodContinuousMulEquiv
    (φ : ContMDiffMonoidMorphism I J ∞ A G) (ψ : ContMDiffMonoidMorphism I' J ∞ K G)
    (h : ∀ a k, Commute (φ a) (ψ k)) (hφ : Injective (lieMap φ)) (hψ : Injective (lieMap ψ))
    (hc : IsCompl (LinearMap.range (lieMap φ).toLinearMap)
      (LinearMap.range (lieMap ψ).toLinearMap)) :
    A × K ≃ₜ* G :=
  have hL := bijective_lieMap_noncommCoprod φ ψ h hφ hψ hc
  let μ := φ.noncommCoprod ψ h
  ContinuousMulEquiv.mk'
    ((Equiv.ofBijective μ (μ.bijective_of_lieMap_bijective_of_simplyConnectedSpace hL)
      ).toHomeomorphOfContinuousOpen (map_continuous μ)
      (μ.isLocalDiffeomorph_of_lieMap_bijective hL).isLocalHomeomorph.isOpenMap)
    (map_mul μ)

@[simp]
theorem noncommCoprodContinuousMulEquiv_apply
    (φ : ContMDiffMonoidMorphism I J ∞ A G) (ψ : ContMDiffMonoidMorphism I' J ∞ K G)
    (h : ∀ a k, Commute (φ a) (ψ k)) (hφ : Injective (lieMap φ)) (hψ : Injective (lieMap ψ))
    (hc : IsCompl (LinearMap.range (lieMap φ).toLinearMap)
      (LinearMap.range (lieMap ψ).toLinearMap)) (p : A × K) :
    noncommCoprodContinuousMulEquiv φ ψ h hφ hψ hc p = φ p.1 * ψ p.2 :=
  φ.noncommCoprod_apply ψ h p

end Criterion

section Ideal

attribute [local instance] ImmersedLieSubgroupData.group
  ImmersedLieSubgroupData.topologicalSpace ImmersedLieSubgroupData.normedAddCommGroup
  ImmersedLieSubgroupData.normedSpace ImmersedLieSubgroupData.finiteDimensional
  ImmersedLieSubgroupData.modelTopology ImmersedLieSubgroupData.chartedSpace
  ImmersedLieSubgroupData.lieGroup ImmersedLieSubgroupData.connectedSpace

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]
  [SecondCountableTopology G]

/-- The Lie map of the integral leaf subgroup of `S` has range `S`, as a submodule. -/
private theorem range_lieMap_integralLeafSubgroupData
    (S : LieSubalgebra ℝ (LeftInvariantDerivation I G)) :
    LinearMap.range (lieMap (S.integralLeafSubgroupData (I := I)).toContMDiffMonoidMorphism
      ).toLinearMap = S.toSubmodule := by
  rw [← LieHom.range_toSubmodule, ImmersedLieSubgroupData.lieMap_toContMDiffMonoidMorphism,
    LieSubalgebra.range_lieMapToHom_integralLeafSubgroupData]

private theorem lieMap_integralLeafSubgroupData_mem
    (S : LieSubalgebra ℝ (LeftInvariantDerivation I G))
    (X : LeftInvariantDerivation (S.integralLeafSubgroupData (I := I)).I'
      (S.integralLeafSubgroupData (I := I)).X) :
    lieMap (S.integralLeafSubgroupData (I := I)).toContMDiffMonoidMorphism X ∈ S := by
  rw [← LieSubalgebra.mem_toSubmodule, ← range_lieMap_integralLeafSubgroupData]
  exact LinearMap.mem_range_self _ X

/-- The integral leaf subgroup of an abelian Lie subalgebra is commutative. -/
theorem commute_of_isLieAbelian (S : LieSubalgebra ℝ (LeftInvariantDerivation I G))
    [IsLieAbelian ↥S] (x y : (S.integralLeafSubgroupData (I := I)).X) : Commute x y := by
  have h := commute_of_lie_lieMap_eq_zero
    (S.integralLeafSubgroupData (I := I)).toContMDiffMonoidMorphism
    (S.integralLeafSubgroupData (I := I)).toContMDiffMonoidMorphism
    (fun X Y ↦ by
      simpa using congrArg Subtype.val (trivial_lie_zero S S
        ⟨_, lieMap_integralLeafSubgroupData_mem S X⟩
        ⟨_, lieMap_integralLeafSubgroupData_mem S Y⟩)) x y
  refine (S.integralLeafSubgroupData (I := I)).injective ?_
  simpa [ImmersedLieSubgroupData.toContMDiffMonoidMorphism_apply] using h.eq

omit [FiniteDimensional ℝ E] [I.Boundaryless] [SecondCountableTopology G] in
/-- Two ideals with zero intersection bracket to zero against each other. -/
private theorem lie_eq_zero_of_disjoint {𝔞 𝔨 : LieIdeal ℝ (LeftInvariantDerivation I G)}
    (hd : Disjoint 𝔞 𝔨) {x y : LeftInvariantDerivation I G} (hx : x ∈ 𝔞) (hy : y ∈ 𝔨) :
    ⁅x, y⁆ = 0 := by
  have hmem : ⁅x, y⁆ ∈ 𝔞 ⊓ 𝔨 :=
    ⟨lie_mem_left ℝ _ 𝔞 x y hx, lie_mem_right ℝ _ 𝔨 x y hy⟩
  rwa [hd.eq_bot, LieSubmodule.mem_bot] at hmem

variable [SimplyConnectedSpace G]

/-- **A simply connected Lie group is the product of the subgroups integrating two complementary
ideals.** If the Lie algebra `𝔤` of a simply connected Lie group `G` is the direct sum of two ideals
`𝔞` and `𝔨`, then `(a, k) ↦ a * k` identifies the product of their integral leaf subgroups, each
with its intrinsic Lie group structure, with `G` as a topological group. -/
def idealProdContinuousMulEquiv (𝔞 𝔨 : LieIdeal ℝ (LeftInvariantDerivation I G))
    (hc : IsCompl 𝔞 𝔨) :
    ((𝔞 : LieSubalgebra ℝ (LeftInvariantDerivation I G)).integralLeafSubgroupData (I := I)).X ×
      ((𝔨 : LieSubalgebra ℝ (LeftInvariantDerivation I G)).integralLeafSubgroupData (I := I)).X
      ≃ₜ* G :=
  noncommCoprodContinuousMulEquiv
    ((𝔞 : LieSubalgebra ℝ (LeftInvariantDerivation I G)).integralLeafSubgroupData
      (I := I)).toContMDiffMonoidMorphism
    ((𝔨 : LieSubalgebra ℝ (LeftInvariantDerivation I G)).integralLeafSubgroupData
      (I := I)).toContMDiffMonoidMorphism
    (commute_of_lie_lieMap_eq_zero _ _ fun X Y ↦ lie_eq_zero_of_disjoint hc.disjoint
      ((LieIdeal.mem_toLieSubalgebra ℝ _ 𝔞 _).mp (lieMap_integralLeafSubgroupData_mem _ X))
      ((LieIdeal.mem_toLieSubalgebra ℝ _ 𝔨 _).mp (lieMap_integralLeafSubgroupData_mem _ Y)))
    (by
      rw [ImmersedLieSubgroupData.lieMap_toContMDiffMonoidMorphism]
      exact ImmersedLieSubgroupData.injective_lieMapToHom _)
    (by
      rw [ImmersedLieSubgroupData.lieMap_toContMDiffMonoidMorphism]
      exact ImmersedLieSubgroupData.injective_lieMapToHom _)
    (by
      rw [range_lieMap_integralLeafSubgroupData, range_lieMap_integralLeafSubgroupData,
        LieIdeal.toLieSubalgebra_toSubmodule, LieIdeal.toLieSubalgebra_toSubmodule,
        LieSubmodule.isCompl_toSubmodule]
      exact hc)

@[simp]
theorem idealProdContinuousMulEquiv_apply (𝔞 𝔨 : LieIdeal ℝ (LeftInvariantDerivation I G))
    (hc : IsCompl 𝔞 𝔨)
    (p : ((𝔞 : LieSubalgebra ℝ (LeftInvariantDerivation I G)).integralLeafSubgroupData
      (I := I)).X ×
      ((𝔨 : LieSubalgebra ℝ (LeftInvariantDerivation I G)).integralLeafSubgroupData (I := I)).X) :
    idealProdContinuousMulEquiv 𝔞 𝔨 hc p =
      ((𝔞 : LieSubalgebra ℝ (LeftInvariantDerivation I G)).integralLeafSubgroupData
        (I := I)).toHom p.1 *
        ((𝔨 : LieSubalgebra ℝ (LeftInvariantDerivation I G)).integralLeafSubgroupData
          (I := I)).toHom p.2 := by
  rw [idealProdContinuousMulEquiv, noncommCoprodContinuousMulEquiv_apply,
    ImmersedLieSubgroupData.toContMDiffMonoidMorphism_apply,
    ImmersedLieSubgroupData.toContMDiffMonoidMorphism_apply]

/-- **The universal cover of a compact Lie group splits off its centre.** If the centre `𝔷` and
the derived algebra `[𝔤, 𝔤]` of the Lie algebra of a simply connected Lie group `G` are
complementary, as they are for the Lie algebra of a compact Lie group
(`TauCeti.Lie.isCompl_center_derivedSeries_one_of_compactSpace`), then `G` is, as a topological
group, the product of the commutative subgroup integrating `𝔷`
(`TauCeti.Lie.commute_of_isLieAbelian`) and the subgroup integrating `[𝔤, 𝔤]`. -/
def centerProdDerivedContinuousMulEquiv
    (hc : IsCompl (LieAlgebra.center ℝ (LeftInvariantDerivation I G))
      (LieAlgebra.derivedSeries ℝ (LeftInvariantDerivation I G) 1)) :
    ((LieAlgebra.center ℝ (LeftInvariantDerivation I G) :
        LieSubalgebra ℝ (LeftInvariantDerivation I G)).integralLeafSubgroupData (I := I)).X ×
      ((LieAlgebra.derivedSeries ℝ (LeftInvariantDerivation I G) 1 :
        LieSubalgebra ℝ (LeftInvariantDerivation I G)).integralLeafSubgroupData (I := I)).X
      ≃ₜ* G :=
  idealProdContinuousMulEquiv _ _ hc

omit [SimplyConnectedSpace G] in
/-- The integral leaf subgroup of the centre, the first factor of
`TauCeti.Lie.centerProdDerivedContinuousMulEquiv`, is commutative. -/
theorem commute_of_center (x y : ((LieAlgebra.center ℝ (LeftInvariantDerivation I G) :
    LieSubalgebra ℝ (LeftInvariantDerivation I G)).integralLeafSubgroupData (I := I)).X) :
    Commute x y :=
  have : IsLieAbelian ↥(LieAlgebra.center ℝ (LeftInvariantDerivation I G) :
      LieSubalgebra ℝ (LeftInvariantDerivation I G)) :=
    ⟨fun a b ↦ Subtype.ext <| by
      simpa using (LieModule.mem_maxTrivSubmodule ℝ _ _ (b : LeftInvariantDerivation I G)).mp
        b.property a⟩
  commute_of_isLieAbelian _ x y

end Ideal

