/-!
# The facet presentation ring of a Hirzebruch trapezoid

The Hirzebruch trapezoid `Δ = {0 ≤ x(e₁), 0 ≤ x(e₂) ≤ b, x(e₁) + k x(e₂) ≤ a}`, with inward
normals `u₀ = (1, 0)`, `u₁ = (0, 1)`, `u₂ = (0, -1)`, `u₃ = (-1, -k)` and support constants
`0`, `0`, `-b`, `-a` (`TauCeti.Toric.hirzebruchNormal`, `TauCeti.Toric.hirzebruchSupport`), is the
moment polytope of the Hirzebruch surface `H_k`, and of `S² × S²` when `k = 0`. This file computes
its facet presentation ring `TauCeti.Toric.FacetRing`, over any commutative ring `R` of
coefficients, together with the class of the support constants.

For `0 < b`, `0 < a` and `k b < a`, two facets of the trapezoid meet exactly when they are adjacent.
So the nonfaces (`TauCeti.Toric.IsNonface`) are the sets of facets containing one of the two
opposite pairs `{1, 2}` and `{0, 3}` (`TauCeti.Toric.isNonface_hirzebruch_iff`), and the
Stanley–Reisner ideal is generated by `D₁ D₂` and `D₀ D₃`
(`TauCeti.Toric.stanleyReisnerIdeal_hirzebruch`). A weight `φ` of `ℤ²` has the linear relation
`φ(e₁) (D₀ - D₃) + φ(e₂) (D₁ - D₂ - k D₃)`, so the linear relations are generated by `D₀ - D₃` and
`D₁ - D₂ - k D₃` (`TauCeti.Toric.linearRelationIdeal_hirzebruch`). Writing `x = D₀ = D₃` for the
class of a fibre and `y = D₂` for the class of the section of self-intersection `-k`, so that
`D₁ = y + k x` is the class of the section of self-intersection `k`, the facet ring is

`R[D₀, D₁, D₂, D₃] ⧸ (I_SR + J) ≃ R[x, y] ⧸ (x², y² + k x y)`

(`TauCeti.Toric.facetRingHirzebruchEquiv`), the cohomology ring of `H_k`. For `k = 0` it is
`R[x, y] ⧸ (x², y²)`, the cohomology ring of `S² × S²`.

The class `-∑ j, c j D j` of the support constants is `a x + b y`
(`TauCeti.Toric.facetRingHirzebruchEquiv_mk_neg_supportClass`), so the class
`-2π ∑ j, c j D j` of the reduced symplectic form is `2π (a x + b y)`. Its square is

`(a x + b y)² = 2 (a b - k b² / 2) x y`

(`TauCeti.Toric.sq_smul_add_smul_hirzebruch`), where `a b - k b² / 2` is the area of the trapezoid
(`TauCeti.Toric.dualMeasure_facetPolyhedron_hirzebruch`) and `x y` corresponds to the point class:
in this presentation the symplectic volume `[ω]² / 2` of `H_k` is `(2π)²` times the area of its
moment polytope.

## Main results

* `TauCeti.Toric.isNonface_hirzebruch_iff`: the nonfaces are the sets of facets containing an
  opposite pair.
* `TauCeti.Toric.stanleyReisnerIdeal_hirzebruch`,
  `TauCeti.Toric.linearRelationIdeal_hirzebruch`: generators of the two ideals.
* `TauCeti.Toric.facetRingHirzebruchEquiv`: the facet ring is `R[x, y] ⧸ (x², y² + k x y)`.
* `TauCeti.Toric.facetRingHirzebruchEquiv_mk_neg_supportClass`: the class `-∑ j, c j D j` is
  `a x + b y`.
* `TauCeti.Toric.sq_smul_add_smul_hirzebruch`: `(a x + b y)² = (2 a b - k b²) x y`, twice the area
  of the trapezoid times `x y`.

## References

* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Sections 28–29.
* V. Guillemin, *Moment Maps and Combinatorial Invariants of Hamiltonian `T^n`-spaces*,
  Birkhäuser, 1994, Chapter 1 and Appendix 2.
* W. Fulton, *Introduction to Toric Varieties*, Annals of Mathematics Studies 131, Princeton
  University Press, 1993, Sections 2.4 and 5.2.
-/

public section

noncomputable section

open Set MvPolynomial

namespace TauCeti.Toric

variable {k : ℤ} {a b : ℝ}

/-! ### Nonfaces and the Stanley–Reisner ideal -/

/-- A set of facets of the Hirzebruch trapezoid contained in one of the four adjacent pairs has a
common point: the pairs meet at the vertices `(0, 0)`, `(a, 0)`, `(0, b)` and `(a - k b, b)`. -/
private theorem not_isNonface_hirzebruch (hb : 0 < b) (ha : 0 < a) (hab : k * b < a)
    {s : Finset (Fin 4)} (h : s ⊆ {0, 1} ∨ s ⊆ {1, 3} ∨ s ⊆ {0, 2} ∨ s ⊆ {2, 3}) :
    ¬IsNonface ((Int.castAddHom ℝ).compLeft (Fin 2)) (hirzebruchNormal k) (hirzebruchSupport a b)
      s := by
  rw [isNonface_def]
  intro hs
  let pt (p q : ℝ) : StrongDual ℝ (Fin 2 → ℝ) :=
    p • ContinuousLinearMap.proj 0 + q • ContinuousLinearMap.proj 1
  have h₀ (p q : ℝ) : pt p q (Pi.single 0 1) = p := by simp [pt]
  have h₁ (p q : ℝ) : pt p q (Pi.single 1 1) = q := by simp [pt]
  have hmem (p q : ℝ) (hp : 0 ≤ p) (hq : 0 ≤ q) (hqb : q ≤ b) (hpq : p + k * q ≤ a) :
      pt p q ∈ facetPolyhedron ((Int.castAddHom ℝ).compLeft (Fin 2)) (hirzebruchNormal k)
        (hirzebruchSupport a b) := by
    rw [mem_facetPolyhedron_hirzebruch_iff, h₀, h₁]
    exact ⟨hp, hq, hqb, hpq⟩
  rcases h with h | h | h | h
  · refine hs (pt 0 0) (hmem 0 0 le_rfl le_rfl hb.le (by simpa using ha.le)) ?_
    intro j hj
    rcases Finset.mem_insert.1 (h hj) with rfl | hj
    · rw [zero_mem_activeSet_hirzebruch_iff, h₀]
    · rw [Finset.mem_singleton.1 hj, one_mem_activeSet_hirzebruch_iff, h₁]
  · refine hs (pt a 0) (hmem a 0 ha.le le_rfl hb.le (by simp)) ?_
    intro j hj
    rcases Finset.mem_insert.1 (h hj) with rfl | hj
    · rw [one_mem_activeSet_hirzebruch_iff, h₁]
    · rw [Finset.mem_singleton.1 hj, three_mem_activeSet_hirzebruch_iff, h₀, h₁]
      simp
  · refine hs (pt 0 b) (hmem 0 b le_rfl hb.le le_rfl (by simpa using hab.le)) ?_
    intro j hj
    rcases Finset.mem_insert.1 (h hj) with rfl | hj
    · rw [zero_mem_activeSet_hirzebruch_iff, h₀]
    · rw [Finset.mem_singleton.1 hj, two_mem_activeSet_hirzebruch_iff, h₁]
  · refine hs (pt (a - k * b) b) (hmem _ b (sub_nonneg.2 hab.le) hb.le le_rfl (by simp)) ?_
    intro j hj
    rcases Finset.mem_insert.1 (h hj) with rfl | hj
    · rw [two_mem_activeSet_hirzebruch_iff, h₁]
    · rw [Finset.mem_singleton.1 hj, three_mem_activeSet_hirzebruch_iff, h₀, h₁]
      ring

/-- **The nonfaces of the Hirzebruch trapezoid.** For `0 < b`, `0 < a` and `k b < a`, a set of
facets has no common point exactly when it contains one of the opposite pairs `{1, 2}` and
`{0, 3}`. -/
theorem isNonface_hirzebruch_iff (hb : 0 < b) (ha : 0 < a) (hab : k * b < a)
    {s : Finset (Fin 4)} :
    IsNonface ((Int.castAddHom ℝ).compLeft (Fin 2)) (hirzebruchNormal k) (hirzebruchSupport a b)
        s ↔ {1, 2} ⊆ s ∨ {0, 3} ⊆ s := by
  constructor
  · -- A set of facets containing neither opposite pair lies in one of the four adjacent pairs.
    intro hs
    by_contra hne
    have key : ∀ t : Finset (Fin 4), ¬({1, 2} ⊆ t ∨ {0, 3} ⊆ t) →
        t ⊆ {0, 1} ∨ t ⊆ {1, 3} ∨ t ⊆ {0, 2} ∨ t ⊆ {2, 3} := by
      decide
    exact not_isNonface_hirzebruch hb ha hab (key s hne) hs
  · -- The facets `{x(e₂) = 0}` and `{x(e₂) = b}` never meet, and neither do `{x(e₁) = 0}` and
    -- `{x(e₁) + k x(e₂) = a}`, since `k x(e₂) < a` on the trapezoid.
    rintro (h | h)
    · refine IsNonface.mono (isNonface_def.2 fun x _ hs ↦ ?_) h
      have h1 := one_mem_activeSet_hirzebruch_iff.1 (hs (by simp))
      have h2 := two_mem_activeSet_hirzebruch_iff.1 (hs (by simp))
      exact hb.ne (h1.symm.trans h2)
    · refine IsNonface.mono (isNonface_def.2 fun x hx hs ↦ ?_) h
      have h0 := zero_mem_activeSet_hirzebruch_iff.1 (hs (by simp))
      have h3 := three_mem_activeSet_hirzebruch_iff.1 (hs (by simp))
      obtain ⟨-, hq₀, hqb, -⟩ := mem_facetPolyhedron_hirzebruch_iff.1 hx
      rw [h0, zero_add] at h3
      exact (intCast_mul_lt_of_nonneg_of_le ha hab hq₀ hqb).ne h3

variable (R : Type*) [CommRing R]

/-- **The Stanley–Reisner ideal of the Hirzebruch trapezoid** is generated by the monomials
`D₁ D₂` and `D₀ D₃` of the two opposite pairs of facets. -/
theorem stanleyReisnerIdeal_hirzebruch (hb : 0 < b) (ha : 0 < a) (hab : k * b < a) :
    stanleyReisnerIdeal ((Int.castAddHom ℝ).compLeft (Fin 2)) (hirzebruchNormal k)
        (hirzebruchSupport a b) R =
      Ideal.span {X 1 * X 2, X 0 * X 3} := by
  apply le_antisymm
  · -- The monomial of a nonface is a multiple of the monomial of an opposite pair it contains.
    rw [stanleyReisnerIdeal_le_iff]
    intro s hs
    rcases (isNonface_hirzebruch_iff hb ha hab).1 hs with h | h
    · rw [← Finset.prod_sdiff h]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
    · rw [← Finset.prod_sdiff h]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
  · rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    · simpa using ((isNonface_hirzebruch_iff hb ha hab).2
        (Or.inl subset_rfl)).prod_mem_stanleyReisnerIdeal (k := R)
    · simpa using ((isNonface_hirzebruch_iff hb ha hab).2
        (Or.inr subset_rfl)).prod_mem_stanleyReisnerIdeal (k := R)

/-! ### The linear relations -/

/-- The linear relation of a weight `φ` of `ℤ²` for the Hirzebruch normals is
`φ(e₁) (D₀ - D₃) + φ(e₂) (D₁ - D₂ - k D₃)`. -/
theorem linearRelation_hirzebruch (φ : (Fin 2 → ℤ) →+ R) :
    linearRelation (hirzebruchNormal k) R φ =
      C (φ (Pi.single 0 1)) * (X 0 - X 3) + C (φ (Pi.single 1 1)) * (X 1 - X 2 - C (k : R) * X 3)
      := by
  have hφ (v : Fin 2 → ℤ) : φ v = v 0 • φ (Pi.single 0 1) + v 1 • φ (Pi.single 1 1) := by
    conv_lhs =>
      rw [show v = v 0 • Pi.single 0 1 + v 1 • Pi.single 1 1 by ext i; fin_cases i <;> simp]
    rw [map_add, map_zsmul, map_zsmul]
  have hu (j : Fin 4) : φ (hirzebruchNormal k j) =
      hirzebruchNormal k j 0 • φ (Pi.single 0 1) + hirzebruchNormal k j 1 • φ (Pi.single 1 1) :=
    hφ _
  simp only [linearRelation_def, Fin.sum_univ_four, hu]
  simp [hirzebruchNormal_def]
  ring

/-- **The linear relations of the Hirzebruch normals** are generated by `D₀ - D₃` and
`D₁ - D₂ - k D₃`. -/
theorem linearRelationIdeal_hirzebruch :
    linearRelationIdeal (hirzebruchNormal k) R =
      Ideal.span {X 0 - X 3, X 1 - X 2 - C (k : R) * X 3} := by
  apply le_antisymm
  · rw [linearRelationIdeal_le_iff]
    intro φ
    rw [linearRelation_hirzebruch]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
      (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
  · -- The two generators are the linear relations of the two coordinate weights.
    rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    · convert linearRelation_mem_linearRelationIdeal (hirzebruchNormal k) R
        ((Int.castAddHom R).comp (Pi.evalAddMonoidHom (fun _ : Fin 2 ↦ ℤ) 0)) using 1
      rw [linearRelation_hirzebruch]
      simp
    · convert linearRelation_mem_linearRelationIdeal (hirzebruchNormal k) R
        ((Int.castAddHom R).comp (Pi.evalAddMonoidHom (fun _ : Fin 2 ↦ ℤ) 1)) using 1
      rw [linearRelation_hirzebruch]
      simp

/-! ### The facet ring -/

/-- The ideal `(x², y² + k x y)` of `R[x, y]`, writing `x = X 0` and `y = X 1`. The quotient by it
is the cohomology ring of the Hirzebruch surface `H_k`, with `x` the class of a fibre and `y` the
class of the section of self-intersection `-k`. -/
def hirzebruchIdeal (R : Type*) [CommRing R] (k : ℤ) : Ideal (MvPolynomial (Fin 2) R) :=
  Ideal.span {X 0 ^ 2, X 1 ^ 2 + C (k : R) * X 0 * X 1}

theorem hirzebruchIdeal_def :
    hirzebruchIdeal R k = Ideal.span {X 0 ^ 2, X 1 ^ 2 + C (k : R) * X 0 * X 1} :=
  (rfl)

/-- The images `x`, `y + k x`, `y`, `x` in `R[x, y]` of the generators `D₀`, `D₁`, `D₂`, `D₃`. -/
private def hirzebruchGenerator (k : ℤ) : Fin 4 → MvPolynomial (Fin 2) R :=
  ![X 0, X 1 + C (k : R) * X 0, X 1, X 0]

/-- The map from `R[D₀, D₁, D₂, D₃]` to `R[x, y] ⧸ (x², y² + k x y)` sending `D₀`, `D₁`, `D₂`,
`D₃` to `x`, `y + k x`, `y`, `x`. -/
private def hirzebruchGeneratorHom (k : ℤ) :
    MvPolynomial (Fin 4) R →ₐ[R] MvPolynomial (Fin 2) R ⧸ hirzebruchIdeal R k :=
  (Ideal.Quotient.mkₐ R _).comp (aeval (hirzebruchGenerator R k))

private theorem hirzebruchGeneratorHom_X (j : Fin 4) :
    hirzebruchGeneratorHom R k (X j) = Ideal.Quotient.mk _ (hirzebruchGenerator R k j) := by
  simp [hirzebruchGeneratorHom, Ideal.Quotient.mkₐ_eq_mk]

/-- The relations of the facet ring of the Hirzebruch trapezoid hold in
`R[x, y] ⧸ (x², y² + k x y)`. -/
private theorem facetIdeal_hirzebruch_le_ker (hb : 0 < b) (ha : 0 < a) (hab : k * b < a) :
    facetIdeal ((Int.castAddHom ℝ).compLeft (Fin 2)) (hirzebruchNormal k)
        (hirzebruchSupport a b) R ≤
      RingHom.ker (hirzebruchGeneratorHom R k) := by
  rw [facetIdeal_le_iff, stanleyReisnerIdeal_hirzebruch R hb ha hab,
    linearRelationIdeal_hirzebruch, Ideal.span_le, Ideal.span_le]
  constructor
  · -- `D₁ D₂` goes to `(y + k x) y = y² + k x y` and `D₀ D₃` to `x²`.
    rintro _ (rfl | rfl) <;>
      simp only [SetLike.mem_coe, RingHom.mem_ker, hirzebruchGeneratorHom, AlgHom.comp_apply,
        Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem, hirzebruchIdeal_def]
    · exact Ideal.subset_span (Or.inr (by simp [hirzebruchGenerator]; ring))
    · exact Ideal.subset_span (Or.inl (by simp [hirzebruchGenerator, pow_two]))
  · rintro _ (rfl | rfl) <;> simp [hirzebruchGeneratorHom, hirzebruchGenerator]

/-- The map of the facet ring of the Hirzebruch trapezoid to `R[x, y] ⧸ (x², y² + k x y)`. -/
private def facetRingHirzebruchHom (hb : 0 < b) (ha : 0 < a) (hab : k * b < a) :
    FacetRing ((Int.castAddHom ℝ).compLeft (Fin 2)) (hirzebruchNormal k)
        (hirzebruchSupport a b) R →ₐ[R] MvPolynomial (Fin 2) R ⧸ hirzebruchIdeal R k :=
  Ideal.Quotient.liftₐ _ (hirzebruchGeneratorHom R k) fun _ hp ↦
    RingHom.mem_ker.1 (facetIdeal_hirzebruch_le_ker R hb ha hab hp)

private theorem facetRingHirzebruchHom_mk (hb : 0 < b) (ha : 0 < a) (hab : k * b < a)
    (p : MvPolynomial (Fin 4) R) :
    facetRingHirzebruchHom R hb ha hab (Ideal.Quotient.mk _ p) = hirzebruchGeneratorHom R k p := by
  rw [← Ideal.Quotient.mkₐ_eq_mk R, ← AlgHom.comp_apply, facetRingHirzebruchHom,
    Ideal.Quotient.liftₐ_comp]

/-- In the facet ring of the Hirzebruch normals, for any support constants, `D₀ = D₃`. -/
theorem mk_X_zero_hirzebruch (c : Fin 4 → ℝ) :
    Ideal.Quotient.mk (facetIdeal ((Int.castAddHom ℝ).compLeft (Fin 2)) (hirzebruchNormal k) c R)
      (X 0) = Ideal.Quotient.mk _ (X 3) := by
  rw [Ideal.Quotient.eq]
  exact linearRelationIdeal_le_facetIdeal _ _ _ R
    (by rw [linearRelationIdeal_hirzebruch]; exact Ideal.subset_span (by simp))

/-- In the facet ring of the Hirzebruch normals, for any support constants, `D₁ = D₂ + k D₃`. -/
theorem mk_X_one_hirzebruch (c : Fin 4 → ℝ) :
    Ideal.Quotient.mk (facetIdeal ((Int.castAddHom ℝ).compLeft (Fin 2)) (hirzebruchNormal k) c R)
      (X 1) = Ideal.Quotient.mk _ (X 2 + C (k : R) * X 3) := by
  rw [Ideal.Quotient.eq, show (X 1 - (X 2 + C (k : R) * X 3) : MvPolynomial (Fin 4) R) =
    X 1 - X 2 - C (k : R) * X 3 by ring]
  exact linearRelationIdeal_le_facetIdeal _ _ _ R
    (by rw [linearRelationIdeal_hirzebruch]; exact Ideal.subset_span (by simp))

/-- In the facet ring of the Hirzebruch trapezoid, the monomial `D_i D_j` of an opposite pair
vanishes. -/
private theorem mk_mul_hirzebruch (hb : 0 < b) (ha : 0 < a) (hab : k * b < a) {i j : Fin 4}
    (hij : i ≠ j) (h : ({i, j} : Finset (Fin 4)) = {1, 2} ∨ ({i, j} : Finset (Fin 4)) = {0, 3}) :
    Ideal.Quotient.mk (facetIdeal ((Int.castAddHom ℝ).compLeft (Fin 2)) (hirzebruchNormal k)
      (hirzebruchSupport a b) R) (X i * X j) = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem, ← Finset.prod_pair hij]
  exact stanleyReisnerIdeal_le_facetIdeal _ _ _ R
    ((isNonface_hirzebruch_iff hb ha hab).2 (h.imp (·.ge) (·.ge))).prod_mem_stanleyReisnerIdeal

/-- The map of `R[x, y] ⧸ (x², y² + k x y)` to the facet ring of the Hirzebruch trapezoid sending
`x` to `D₃` and `y` to `D₂`. -/
private def hirzebruchFacetRingHom (hb : 0 < b) (ha : 0 < a) (hab : k * b < a) :
    MvPolynomial (Fin 2) R ⧸ hirzebruchIdeal R k →ₐ[R]
      FacetRing ((Int.castAddHom ℝ).compLeft (Fin 2)) (hirzebruchNormal k)
        (hirzebruchSupport a b) R :=
  Ideal.Quotient.liftₐ _ ((Ideal.Quotient.mkₐ R _).comp (aeval ![X 3, X 2])) fun p hp ↦ by
    -- `x²` goes to `D₃² = D₀ D₃` and `y² + k x y` to `(D₂ + k D₃) D₂ = D₁ D₂`, both of which
    -- are monomials of nonfaces.
    have h₀ := mk_mul_hirzebruch R hb ha hab (i := 0) (j := 3) (by decide) (Or.inr rfl)
    have h₁ := mk_mul_hirzebruch R hb ha hab (i := 1) (j := 2) (by decide) (Or.inl rfl)
    rw [map_mul, mk_X_zero_hirzebruch R (hirzebruchSupport a b)] at h₀
    rw [map_mul, mk_X_one_hirzebruch R (hirzebruchSupport a b), map_add, map_mul] at h₁
    obtain ⟨c, d, rfl⟩ := Ideal.mem_span_pair.1 hp
    rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
    simp only [map_add, map_mul, map_pow, aeval_X, aeval_C, algebraMap_eq, Matrix.cons_val_zero,
      Matrix.cons_val_one]
    linear_combination Ideal.Quotient.mk _ (aeval ![X 3, X 2] c) * h₀ +
      Ideal.Quotient.mk _ (aeval ![X 3, X 2] d) * h₁

private theorem hirzebruchFacetRingHom_mk (hb : 0 < b) (ha : 0 < a) (hab : k * b < a)
    (p : MvPolynomial (Fin 2) R) :
    hirzebruchFacetRingHom R hb ha hab (Ideal.Quotient.mk _ p) =
      Ideal.Quotient.mk _ (aeval ![X 3, X 2] p) := by
  rw [← Ideal.Quotient.mkₐ_eq_mk R (hirzebruchIdeal R k), ← AlgHom.comp_apply,
    hirzebruchFacetRingHom, Ideal.Quotient.liftₐ_comp, AlgHom.comp_apply,
    Ideal.Quotient.mkₐ_eq_mk]

/-- **The facet ring of the Hirzebruch trapezoid.** For `0 < b`, `0 < a` and `k b < a`, the facet
presentation ring of the Hirzebruch trapezoid is `R[x, y] ⧸ (x², y² + k x y)`, the cohomology ring
of the Hirzebruch surface `H_k`. The generators `D₀`, `D₁`, `D₂`, `D₃` go to `x`, `y + k x`, `y`,
`x`. -/
def facetRingHirzebruchEquiv (hb : 0 < b) (ha : 0 < a) (hab : k * b < a) :
    FacetRing ((Int.castAddHom ℝ).compLeft (Fin 2)) (hirzebruchNormal k)
        (hirzebruchSupport a b) R ≃ₐ[R] MvPolynomial (Fin 2) R ⧸ hirzebruchIdeal R k :=
  AlgEquiv.ofAlgHom (facetRingHirzebruchHom R hb ha hab) (hirzebruchFacetRingHom R hb ha hab)
    (Ideal.Quotient.algHom_ext _ (MvPolynomial.algHom_ext fun i ↦ by
      fin_cases i <;>
        simp [Ideal.Quotient.mkₐ_eq_mk, hirzebruchFacetRingHom_mk, facetRingHirzebruchHom_mk,
          hirzebruchGeneratorHom_X, hirzebruchGenerator]))
    (Ideal.Quotient.algHom_ext _ (MvPolynomial.algHom_ext fun j ↦ by
      fin_cases j <;>
        simp [Ideal.Quotient.mkₐ_eq_mk, hirzebruchFacetRingHom_mk, facetRingHirzebruchHom_mk,
          hirzebruchGeneratorHom_X, hirzebruchGenerator,
          mk_X_zero_hirzebruch R (hirzebruchSupport a b),
          mk_X_one_hirzebruch R (hirzebruchSupport a b)]))

/-- The isomorphism `facetRingHirzebruchEquiv` sends `D₀`, `D₁`, `D₂`, `D₃` to `x`, `y + k x`,
`y`, `x`. -/
@[simp]
theorem facetRingHirzebruchEquiv_mk_X (hb : 0 < b) (ha : 0 < a) (hab : k * b < a) (j : Fin 4) :
    facetRingHirzebruchEquiv R hb ha hab (Ideal.Quotient.mk _ (X j)) =
      Ideal.Quotient.mk (hirzebruchIdeal R k) (![X 0, X 1 + C (k : R) * X 0, X 1, X 0] j) := by
  rw [← AlgEquiv.coe_toAlgHom, facetRingHirzebruchEquiv, AlgEquiv.toAlgHom_ofAlgHom,
    facetRingHirzebruchHom_mk, hirzebruchGeneratorHom_X, hirzebruchGenerator]

/-- The inverse of `facetRingHirzebruchEquiv` sends `x` to `D₃` and `y` to `D₂`. -/
@[simp]
theorem facetRingHirzebruchEquiv_symm_mk_X (hb : 0 < b) (ha : 0 < a) (hab : k * b < a)
    (i : Fin 2) :
    (facetRingHirzebruchEquiv R hb ha hab).symm (Ideal.Quotient.mk (hirzebruchIdeal R k) (X i)) =
      Ideal.Quotient.mk (facetIdeal ((Int.castAddHom ℝ).compLeft (Fin 2)) (hirzebruchNormal k)
        (hirzebruchSupport a b) R) (![X 3, X 2] i) := by
  rw [AlgEquiv.symm_apply_eq]
  fin_cases i <;> simp

/-! ### The class of the support constants -/

/-- The class `∑ j, c j D j` of the Hirzebruch trapezoid is `-(b D₂ + a D₃)`. -/
@[simp]
theorem supportClass_hirzebruch :
    supportClass (hirzebruchSupport a b) = -(C b * X 2 + C a * X 3) := by
  simp [supportClass_def, Fin.sum_univ_four, hirzebruchSupport_def]
  ring

/-- **The support class of the Hirzebruch trapezoid.** For `0 < b`, `0 < a` and `k b < a`, the
class `-∑ j, c j D j` is `a x + b y` in `ℝ[x, y] ⧸ (x², y² + k x y)`. So the class
`-2π ∑ j, c j D j`, which corresponds to the reduced symplectic form of the Hirzebruch surface, is
`2π (a x + b y)`. -/
theorem facetRingHirzebruchEquiv_mk_neg_supportClass (hb : 0 < b) (ha : 0 < a)
    (hab : k * b < a) :
    facetRingHirzebruchEquiv ℝ hb ha hab
        (Ideal.Quotient.mk _ (-supportClass (hirzebruchSupport a b))) =
      a • Ideal.Quotient.mk (hirzebruchIdeal ℝ k) (X 0) + b • Ideal.Quotient.mk _ (X 1) := by
  -- Write the class as the image of `b • D₂ + a • D₃` under the linear quotient map `mkₐ`.
  rw [supportClass_hirzebruch, neg_neg, C_mul', C_mul', ← Ideal.Quotient.mkₐ_eq_mk ℝ]
  simp only [map_add, map_smul]
  simp [add_comm]

/-- **The square of the class `a x + b y`.** In `R[x, y] ⧸ (x², y² + k x y)`,
`(a x + b y)² = (2 a b - k b²) x y`. For the support class of the Hirzebruch trapezoid
(`TauCeti.Toric.facetRingHirzebruchEquiv_mk_neg_supportClass`), `2 a b - k b²` is twice the area
`a b - k b² / 2` of the trapezoid (`TauCeti.Toric.dualMeasure_facetPolyhedron_hirzebruch`), and
`x y` corresponds to the point class of the Hirzebruch surface, so `[ω]² / 2` for
`[ω] = 2π (a x + b y)` is `(2π)²` times the area of the trapezoid times the point class. -/
theorem sq_smul_add_smul_hirzebruch (r s : R) :
    (r • Ideal.Quotient.mk (hirzebruchIdeal R k) (X 0) + s • Ideal.Quotient.mk _ (X 1)) ^ 2 =
      (2 * r * s - k * s ^ 2) • Ideal.Quotient.mk (hirzebruchIdeal R k) (X 0 * X 1) := by
  simp only [← Ideal.Quotient.mkₐ_eq_mk R, ← map_smul, ← map_add, ← map_pow]
  rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq, hirzebruchIdeal_def, Ideal.mem_span_pair]
  refine ⟨C (r ^ 2), C (s ^ 2), ?_⟩
  simp only [smul_eq_C_mul, map_mul, map_pow, map_sub, map_ofNat, map_intCast]
  ring

end TauCeti.Toric
