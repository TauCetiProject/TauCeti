/-!
# The facet presentation of a corner chop

Let `Δ = {x | c j ≤ ⟨x, u j⟩ for every j}` be a facet presentation in an integral lattice and `v`
a smooth vertex of `Δ`, at which the facets indexed by `s` meet. Chopping the corner `v` off `Δ` at
depth `ε` (`TauCeti.Toric.cornerChopNormal u s`, `TauCeti.Toric.cornerChopSupport c s ε`) adds one
facet, indexed by `none`; the old facets are indexed by `some j`. On the symplectic side this is the
toric symplectic blowup of the fixed point over `v`, the new facet being the moment image of the
exceptional divisor `E`. This file computes the nonfaces (`TauCeti.Toric.IsNonface`) and the
Stanley–Reisner ideal (`TauCeti.Toric.stanleyReisnerIdeal`) of the chopped polytope from those of
`Δ`, for every sufficiently small depth `ε > 0`.

Every finite set of facets of the chopped polytope is either a set `t.map some` of old facets or a
set `insertNone t` containing the new facet.

* A set of old facets is a nonface exactly when it is a nonface of `Δ` or contains all of `s`
  (`TauCeti.Toric.IsSmoothVertex.eventually_isNonface_cornerChop_map_some_iff`): the facets in `s`
  meet only at the corner, which is cut off, and every other face of `Δ` keeps a point of depth at
  least `ε` once `ε` is small. Faces strictly contained in `s` keep the point at depth `ε` on the
  edge of `Δ` from `v` along which they stay active.
* A set containing the new facet is a nonface exactly when its old facets do not form a proper
  subset of `s` (`TauCeti.Toric.IsSmoothVertex.eventually_isNonface_cornerChop_insertNone_iff`):
  near the corner the constraints inactive at `v` stay inactive, so the old facets meeting the new
  facet lie in `s`, and not all of them meet it, since their coordinates sum to `ε`.

So the Stanley–Reisner ideal of the chopped polytope is generated by the Stanley–Reisner ideal of
`Δ`, the monomial `∏_{j ∈ s} D j` and the monomials `E D j` for `j ∉ s`
(`TauCeti.Toric.IsSmoothVertex.eventually_stanleyReisnerIdeal_cornerChop`): the proper transforms
of the divisors through the blown-up point no longer meet all together, and the exceptional
divisor meets only the proper transforms of the divisors through that point.

The divisor of a facet through the blown-up point pulls back along the blowdown to its proper
transform plus `E`. The corresponding substitution `D j ↦ D (some j) + [j ∈ s] E`
(`TauCeti.Toric.cornerChopPullback`) sends the linear relation of each weight to its linear relation
after the chop (`TauCeti.Toric.cornerChopPullback_linearRelation`) and the facet ideal of `Δ` into
that of a small corner chop
(`TauCeti.Toric.IsSmoothVertex.eventually_facetIdeal_le_comap_cornerChopPullback`), so it induces a
map of facet rings. The class of the support constants of the chop at depth `ε` is the pullback of
that of `Δ` plus `ε E` (`TauCeti.Toric.supportClass_cornerChop`): the class `-2π ∑ j, c j D j` of
the reduced symplectic form of the blowup is `π^* [ω] - 2π ε E`.

No dimension hypothesis is needed: in rank zero the chopped polyhedron is empty and every set of
facets is a nonface, as both characterisations say.

## Main definitions

* `TauCeti.Toric.cornerChopPullback s k`: the blowdown substitution
  `D j ↦ D (some j) + [j ∈ s] D none`.

## Main results

* `TauCeti.Toric.IsSmoothVertex.eventually_isNonface_cornerChop_map_some_iff`,
  `TauCeti.Toric.IsSmoothVertex.eventually_isNonface_cornerChop_insertNone_iff`: the nonfaces of a
  small corner chop.
* `TauCeti.Toric.IsSmoothVertex.eventually_stanleyReisnerIdeal_cornerChop`: its Stanley–Reisner
  ideal.
* `TauCeti.Toric.IsSmoothVertex.eventually_facetIdeal_le_comap_cornerChopPullback`: the blowdown
  pullback respects the facet ideals.
* `TauCeti.Toric.supportClass_cornerChop`: the support class of a corner chop.

## References

* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Sections 28–29.
* V. Guillemin, *Moment Maps and Combinatorial Invariants of Hamiltonian `T^n`-spaces*,
  Birkhäuser, 1994, Chapter 1 and Appendix 2.
* W. Fulton, *Introduction to Toric Varieties*, Annals of Mathematics Studies 131, Princeton
  University Press, 1993, Sections 2.4 and 5.2.
-/

public section

noncomputable section

open Set Filter Topology MvPolynomial

namespace TauCeti.Toric

variable {ι N V : Type*} [AddCommGroup N] [NormedAddCommGroup V] [NormedSpace ℝ V]
  {i : N →+ V} {u : ι → N} {c : ι → ℝ} {s : Finset ι} {ε : ℝ}

/-! ### Nonfaces at every positive depth -/

/-- A nonface of the polyhedron stays a nonface, as a set of old facets, after chopping a
corner. -/
theorem IsNonface.cornerChop_map_some {t : Finset ι} (ht : IsNonface i u c t) :
    IsNonface i (cornerChopNormal u s) (cornerChopSupport c s ε) (t.map .some) := by
  refine isNonface_def.2 fun x hx hxt ↦ ?_
  refine isNonface_def.1 ht x (facetPolyhedron_cornerChop_subset hx) fun j hj ↦ ?_
  simpa using hxt (Finset.mem_coe.2 (Finset.mem_map_of_mem _ hj))

/-- For `ε > 0`, a set of old facets containing all the facets `s` at the chopped corner is a
nonface of the chopped polyhedron: on all of them the coordinates `⟨x, u j⟩ - c j`, `j ∈ s`,
vanish, so their sum is not at least `ε`. -/
theorem isNonface_cornerChop_map_some_of_subset (hε : 0 < ε) {t : Finset ι} (hst : s ⊆ t) :
    IsNonface i (cornerChopNormal u s) (cornerChopSupport c s ε) (t.map .some) := by
  refine isNonface_def.2 fun x hx hxt ↦ ?_
  have h0 : ∑ j ∈ s, (x (i (u j)) - c j) = 0 :=
    Finset.sum_eq_zero fun j hj ↦ sub_eq_zero.2 <| by
      simpa using hxt (Finset.mem_coe.2 (Finset.mem_map_of_mem _ (hst hj)))
  linarith [(mem_facetPolyhedron_cornerChop_iff.1 hx).2]

/-! ### Faces of a small corner chop -/

section Small

variable [Finite ι] {v : StrongDual ℝ V}

/-- For every small `ε > 0`, every proper subset `t` of the facets `s` at the smooth vertex `v` is
active at a point of the new facet of the polyhedron chopped at depth `ε`: the point at depth `ε`
on an edge from `v` along which `t` stays active. -/
private theorem eventually_exists_mem_cornerChop_edge (hi : IsIntegralLattice i)
    (hv : IsSmoothVertex i u c v) (hvP : v ∈ facetPolyhedron i u c)
    (hs : (s : Set ι) = activeSet (facetPairing i u) c v) :
    ∀ᶠ ε in 𝓝[>] 0, ∀ t ⊂ s,
      ∃ x ∈ facetPolyhedron i (cornerChopNormal u s) (cornerChopSupport c s ε),
        ∑ j ∈ s, (x (i (u j)) - c j) = ε ∧ (t : Set ι) ⊆ activeSet (facetPairing i u) c x := by
  classical
  obtain ⟨w, hw, -⟩ := hv.exists_coord hi hs
  have hvs (j) (hj : j ∈ s) : v (i (u j)) = c j := by
    rwa [← Finset.mem_coe, hs, mem_activeSet, facetPairing_apply] at hj
  filter_upwards [self_mem_nhdsWithin,
    (hv.eventually_forall_mem_facetPolyhedron hi hvP hs).filter_mono nhdsWithin_le_nhds]
    with ε (hε0 : 0 < ε) hε t hts
  obtain ⟨j₀, hj₀, hj₀t⟩ := Finset.not_subset.1 hts.2
  -- The point at depth `ε` on the edge has the coordinates `ε` at `j₀` and `0` elsewhere.
  have hy (j) (hj : j ∈ s) : (v + ε • w j₀) (i (u j)) - c j = if j = j₀ then ε else 0 := by
    by_cases h : j = j₀
    · subst h
      simp [hvs j hj, hw j hj j hj]
    · simp [h, hvs j hj, hw j₀ hj₀ j hj, Ne.symm h]
  have hsum : ∑ j ∈ s, ((v + ε • w j₀) (i (u j)) - c j) = ε := by
    rw [Finset.sum_congr rfl hy, Finset.sum_ite_eq', ite_eq_left hj₀]
  refine ⟨v + ε • w j₀, mem_facetPolyhedron_cornerChop_iff.2
    ⟨hε _ (fun j hj ↦ ?_) hsum.le, hsum.ge⟩, hsum, fun j hj ↦ ?_⟩
  · rw [← sub_nonneg, hy j hj]
    split_ifs <;> linarith
  · have := hy j (hts.1 hj)
    rw [ite_eq_right fun (hjj₀ : j = j₀) ↦ hj₀t (hjj₀ ▸ hj)] at this
    rw [mem_activeSet, facetPairing_apply]
    linarith

/-- For every small `ε > 0`, every face of the polyhedron not contained in the facets `s` at the
smooth vertex `v` meets the polyhedron chopped at depth `ε`: a point of the face lies off the
corner, so it has positive depth. -/
private theorem eventually_exists_mem_cornerChop_face (hi : IsIntegralLattice i)
    (hv : IsSmoothVertex i u c v) (hs : (s : Set ι) = activeSet (facetPairing i u) c v) :
    ∀ᶠ ε in 𝓝[>] 0, ∀ t : Finset ι, ¬IsNonface i u c t → ¬t ⊆ s →
      ∃ x ∈ facetPolyhedron i (cornerChopNormal u s) (cornerChopSupport c s ε),
        (t : Set ι) ⊆ activeSet (facetPairing i u) c x := by
  classical
  have := Fintype.ofFinite ι
  obtain ⟨w, -, hx⟩ := hv.exists_coord hi hs
  refine (eventually_all.2 fun t ↦ ?_).filter_mono nhdsWithin_le_nhds
  by_cases ht : IsNonface i u c t ∨ t ⊆ s
  · exact Eventually.of_forall fun _ h₁ h₂ ↦ (ht.elim h₁ h₂).elim
  rw [not_or] at ht
  obtain ⟨x, hxP, hxt⟩ : ∃ x ∈ facetPolyhedron i u c,
      (t : Set ι) ⊆ activeSet (facetPairing i u) c x := by
    simpa [isNonface_def] using ht.1
  obtain ⟨k, hkt, hks⟩ := Finset.not_subset.1 ht.2
  have hnn (j) (_ : j ∈ s) : 0 ≤ x (i (u j)) - c j := sub_nonneg.2 (mem_facetPolyhedron.1 hxP j)
  -- If the depth of `x` vanished, then `x` would be the corner, where `k ∉ s` is inactive.
  have hpos : 0 < ∑ j ∈ s, (x (i (u j)) - c j) := by
    refine (Finset.sum_nonneg hnn).lt_of_ne fun h ↦ hks ?_
    have h0 := (Finset.sum_eq_zero_iff_of_nonneg hnn).1 h.symm
    have hxv : x = v := by
      rw [hx x, Finset.sum_eq_zero fun j hj ↦ by rw [h0 j hj, zero_smul], add_zero]
    rw [← Finset.mem_coe, hs, ← hxv]
    exact hxt hkt
  exact (eventually_lt_nhds hpos).mono fun ε hε _ _ ↦
    ⟨x, mem_facetPolyhedron_cornerChop_iff.2 ⟨hxP, hε.le⟩, hxt⟩

/-- **The nonfaces among the old facets of a small corner chop.** Let `v` be a smooth vertex of the
polyhedron `Δ` in an integral lattice, at which the facets indexed by `s` meet. Then for every
sufficiently small `ε > 0`, a set `t` of old facets is a nonface of the polyhedron chopped at depth
`ε` exactly when it is a nonface of `Δ` or contains all the facets `s` at the corner. -/
theorem IsSmoothVertex.eventually_isNonface_cornerChop_map_some_iff (hi : IsIntegralLattice i)
    (hv : IsSmoothVertex i u c v) (hvP : v ∈ facetPolyhedron i u c)
    (hs : (s : Set ι) = activeSet (facetPairing i u) c v) :
    ∀ᶠ ε in 𝓝[>] 0, ∀ t : Finset ι,
      IsNonface i (cornerChopNormal u s) (cornerChopSupport c s ε) (t.map .some) ↔
        IsNonface i u c t ∨ s ⊆ t := by
  filter_upwards [self_mem_nhdsWithin, eventually_exists_mem_cornerChop_edge hi hv hvP hs,
    eventually_exists_mem_cornerChop_face hi hv hs] with ε (hε0 : 0 < ε) hedge hface t
  refine ⟨fun ht ↦ ?_, fun ht ↦ ht.elim IsNonface.cornerChop_map_some
    (isNonface_cornerChop_map_some_of_subset hε0)⟩
  by_contra h
  rw [not_or] at h
  -- A face of `Δ` not containing `s` keeps a point of the chopped polyhedron: on the edge from the
  -- corner if it lies in `s`, and anywhere on it otherwise.
  obtain ⟨x, hx, hxt⟩ : ∃ x ∈ facetPolyhedron i (cornerChopNormal u s) (cornerChopSupport c s ε),
      (t : Set ι) ⊆ activeSet (facetPairing i u) c x := by
    by_cases hts : t ⊆ s
    · obtain ⟨x, hx, -, hxt⟩ := hedge t ⟨hts, h.2⟩
      exact ⟨x, hx, hxt⟩
    · exact hface t h.1 hts
  refine isNonface_def.1 ht x hx fun o ho ↦ ?_
  obtain ⟨j, hj, rfl⟩ := Finset.mem_map.1 (Finset.mem_coe.1 ho)
  simpa using hxt hj

/-- **The nonfaces through the new facet of a small corner chop.** Let `v` be a smooth vertex of
the polyhedron `Δ` in an integral lattice, at which the facets indexed by `s` meet. Then for every
sufficiently small `ε > 0`, a set of facets of the polyhedron chopped at depth `ε` made of the new
facet and the old facets `t` is a nonface exactly when `t` is not a proper subset of `s`. -/
theorem IsSmoothVertex.eventually_isNonface_cornerChop_insertNone_iff (hi : IsIntegralLattice i)
    (hv : IsSmoothVertex i u c v) (hvP : v ∈ facetPolyhedron i u c)
    (hs : (s : Set ι) = activeSet (facetPairing i u) c v) :
    ∀ᶠ ε in 𝓝[>] 0, ∀ t : Finset ι,
      IsNonface i (cornerChopNormal u s) (cornerChopSupport c s ε) t.insertNone ↔ ¬t ⊂ s := by
  filter_upwards [self_mem_nhdsWithin, eventually_exists_mem_cornerChop_edge hi hv hvP hs,
    (hv.eventually_forall_lt_apply hi hvP hs).filter_mono nhdsWithin_le_nhds]
    with ε (hε0 : 0 < ε) hedge hslack t
  constructor
  · -- A proper subset of `s` meets the new facet on an edge from the corner.
    rintro ht hts
    obtain ⟨x, hx, hxε, hxt⟩ := hedge t hts
    refine isNonface_def.1 ht x hx fun o ho ↦ ?_
    cases o with
    | none => exact none_mem_activeSet_cornerChop_iff.2 hxε
    | some j => exact some_mem_activeSet_cornerChop_iff.2 (hxt (by simpa using ho))
  · -- On the new facet near the corner, only facets of `s` are active, and not all of them.
    refine fun hts ↦ isNonface_def.2 fun x hx hxt ↦ hts ?_
    have hnone : ∑ j ∈ s, (x (i (u j)) - c j) = ε :=
      none_mem_activeSet_cornerChop_iff.1 (hxt (by simp))
    have hxt' (j) (hj : j ∈ t) : x (i (u j)) = c j := by
      simpa using hxt (show some j ∈ (t.insertNone : Set (Option ι)) by simpa using hj)
    have hxΔ := mem_facetPolyhedron.1 (facetPolyhedron_cornerChop_subset hx)
    have hts' : t ⊆ s := fun j hj ↦ by
      by_contra hjs
      exact (hslack x (fun k _ ↦ hxΔ k) hnone.le j hjs).ne' (hxt' j hj)
    refine Finset.ssubset_iff_subset_ne.2 ⟨hts', ?_⟩
    rintro rfl
    rw [Finset.sum_eq_zero fun j hj ↦ by rw [hxt' j hj, sub_self]] at hnone
    exact hε0.ne hnone

/-- For every small `ε > 0`, the new facet of the polyhedron chopped at depth `ε` meets no old facet
outside the facets `s` at the corner: `D none * D (some j)` lies in its Stanley–Reisner ideal for
every `j ∉ s`. -/
private theorem IsSmoothVertex.eventually_X_none_mul_X_some_mem_stanleyReisnerIdeal (k : Type*)
    [CommRing k] (hi : IsIntegralLattice i) (hv : IsSmoothVertex i u c v)
    (hvP : v ∈ facetPolyhedron i u c) (hs : (s : Set ι) = activeSet (facetPairing i u) c v) :
    ∀ᶠ ε in 𝓝[>] 0, ∀ j ∉ s, X none * X (some j) ∈
      stanleyReisnerIdeal i (cornerChopNormal u s) (cornerChopSupport c s ε) k := by
  filter_upwards [hv.eventually_isNonface_cornerChop_insertNone_iff hi hvP hs] with ε hnone j hj
  have h : ¬{j} ⊂ s := fun h ↦ hj (h.subset (Finset.mem_singleton_self j))
  simpa using ((hnone {j}).2 h).prod_mem_stanleyReisnerIdeal (k := k)

/-- **The Stanley–Reisner ideal of a small corner chop.** Let `v` be a smooth vertex of the
polyhedron `Δ` in an integral lattice, at which the facets indexed by `s` meet. Then for every
sufficiently small `ε > 0`, the Stanley–Reisner ideal of the polyhedron chopped at depth `ε` is
generated by the Stanley–Reisner ideal of `Δ` on the old generators `D (some j)`, the monomial
`∏_{j ∈ s} D (some j)` and the monomials `D none * D (some j)` for `j ∉ s`. For the toric blowup at
the fixed point over `v`, with exceptional divisor `E = D none`: the proper transforms of the
divisors through the blown-up point no longer meet all together, and `E` meets only those proper
transforms. -/
theorem IsSmoothVertex.eventually_stanleyReisnerIdeal_cornerChop (k : Type*) [CommRing k]
    (hi : IsIntegralLattice i) (hv : IsSmoothVertex i u c v) (hvP : v ∈ facetPolyhedron i u c)
    (hs : (s : Set ι) = activeSet (facetPairing i u) c v) :
    ∀ᶠ ε in 𝓝[>] 0, stanleyReisnerIdeal i (cornerChopNormal u s) (cornerChopSupport c s ε) k =
      Ideal.map (rename some) (stanleyReisnerIdeal i u c k) ⊔
        Ideal.span (insert (∏ j ∈ s, X (some j)) ((fun j ↦ X none * X (some j)) '' (↑s)ᶜ)) := by
  classical
  filter_upwards [hv.eventually_isNonface_cornerChop_map_some_iff hi hvP hs,
    hv.eventually_isNonface_cornerChop_insertNone_iff hi hvP hs,
    hv.eventually_X_none_mul_X_some_mem_stanleyReisnerIdeal k hi hvP hs] with ε hsome hnone hE
  apply le_antisymm
  · -- Each nonface is a set of old facets or contains the new facet; its monomial is a multiple of
    -- one of the generators.
    rw [stanleyReisnerIdeal_le_iff]
    intro T hT
    by_cases hT0 : none ∈ T
    · rw [← Finset.insert_eq_of_mem hT0, ← Finset.insertNone_eraseNone, hnone] at hT
      rw [← Finset.insert_eq_of_mem hT0, ← Finset.insertNone_eraseNone, Finset.prod_insertNone]
      refine Ideal.mem_sup_right ?_
      by_cases hts : T.eraseNone ⊆ s
      · rw [(hts.eq_or_ssubset).resolve_right hT]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span (mem_insert _ _))
      · obtain ⟨j, hjT, hjs⟩ := Finset.not_subset.1 hts
        exact Ideal.mem_of_dvd _ (mul_dvd_mul_left _ (Finset.dvd_prod_of_mem _ hjT))
          (Ideal.subset_span (mem_insert_of_mem _
            (mem_image_of_mem _ (mem_compl (Finset.mem_coe.not.2 hjs)))))
    · rw [← Finset.erase_eq_of_notMem hT0, ← Finset.map_some_eraseNone, hsome] at hT
      rw [← Finset.erase_eq_of_notMem hT0, ← Finset.map_some_eraseNone, Finset.prod_map]
      rcases hT with hT | hT
      · refine Ideal.mem_sup_left ?_
        simpa [map_prod] using
          Ideal.mem_map_of_mem (rename some) (hT.prod_mem_stanleyReisnerIdeal (k := k))
      · exact Ideal.mem_sup_right (Ideal.mem_of_dvd _ (Finset.prod_dvd_prod_of_subset _ _ _ hT)
          (Ideal.subset_span (mem_insert _ _)))
  · -- Each generator is the monomial of a nonface.
    refine sup_le ?_ ?_
    · rw [Ideal.map_le_iff_le_comap, stanleyReisnerIdeal_le_iff]
      intro t ht
      simpa [map_prod] using ht.cornerChop_map_some.prod_mem_stanleyReisnerIdeal (k := k)
    · rw [Ideal.span_le]
      rintro _ (rfl | ⟨j, hj, rfl⟩)
      · simpa using ((hsome s).2 (Or.inr subset_rfl)).prod_mem_stanleyReisnerIdeal (k := k)
      · exact hE j hj

end Small

/-! ### Pulling back along the blowdown -/

section Pullback

variable [DecidableEq ι] (s) (k : Type*) [CommRing k]

/-- The pullback of divisor classes along the blowdown of the corner where the facets in `s` meet:
the substitution `D j ↦ D (some j) + [j ∈ s] D none`, since the divisor of a facet through the
blown-up point pulls back to its proper transform plus the exceptional divisor `E = D none`. -/
def cornerChopPullback : MvPolynomial ι k →ₐ[k] MvPolynomial (Option ι) k :=
  aeval fun j ↦ X (some j) + if j ∈ s then X none else 0

@[simp]
theorem cornerChopPullback_X (j : ι) :
    cornerChopPullback s k (X j) = X (some j) + if j ∈ s then X none else 0 :=
  aeval_X _ j

/-- Modulo the exceptional divisor `E = D none`, the blowdown pullback of a monomial is the same
monomial in the proper transforms. -/
private theorem X_none_dvd_cornerChopPullback_prod_sub (t : Finset ι) :
    X none ∣ cornerChopPullback s k (∏ j ∈ t, X j) - ∏ j ∈ t.map .some, X j := by
  rw [← Ideal.mem_span_singleton, ← Ideal.Quotient.eq, map_prod, Finset.prod_map, map_prod,
    map_prod]
  refine Finset.prod_congr rfl fun j _ ↦ ?_
  rw [Ideal.Quotient.eq, cornerChopPullback_X, Function.Embedding.some_apply, add_sub_cancel_left]
  split_ifs
  · exact Ideal.mem_span_singleton_self _
  · exact zero_mem _

variable [Fintype ι]

/-- The blowdown pullback of the linear relation of a weight `φ` is its linear relation after
chopping the corner, whose new normal is `∑ j ∈ s, u j`. -/
@[simp]
theorem cornerChopPullback_linearRelation (φ : N →+ k) :
    cornerChopPullback s k (linearRelation u k φ) = linearRelation (cornerChopNormal u s) k φ := by
  simp [linearRelation_def, Fintype.sum_option, mul_add, Finset.sum_add_distrib, add_comm,
    Finset.sum_mul]

/-- **The class of a corner chop.** Chopping the corner where the facets in `s` meet at depth `ε`
changes the class `∑ j, c j D j` of the support constants to its blowdown pullback plus `ε E`, with
`E = D none`. So the class `-2π ∑ j, c j D j` of the reduced symplectic form of the toric blowup is
`π^* [ω] - 2π ε E`. -/
theorem supportClass_cornerChop :
    supportClass (cornerChopSupport c s ε) =
      cornerChopPullback s ℝ (supportClass c) + C ε * X none := by
  simp [supportClass_def, Fintype.sum_option, mul_add, Finset.sum_add_distrib, add_mul,
    Finset.sum_mul]
  ring

variable {s k}

/-- **The blowdown pullback of the facet ring.** Let `v` be a smooth vertex of the polyhedron `Δ`
in an integral lattice, at which the facets indexed by `s` meet. Then for every sufficiently small
`ε > 0`, the blowdown pullback `D j ↦ D (some j) + [j ∈ s] D none` sends the ideal of the facet
presentation of `Δ` into that of the polyhedron chopped at depth `ε`, so it induces a map of facet
rings (`Ideal.quotientMapₐ`). -/
theorem IsSmoothVertex.eventually_facetIdeal_le_comap_cornerChopPullback
    (hi : IsIntegralLattice i) {v : StrongDual ℝ V} (hv : IsSmoothVertex i u c v)
    (hvP : v ∈ facetPolyhedron i u c) (hs : (s : Set ι) = activeSet (facetPairing i u) c v) :
    ∀ᶠ ε in 𝓝[>] 0, facetIdeal i u c k ≤
      (facetIdeal i (cornerChopNormal u s) (cornerChopSupport c s ε) k).comap
        (cornerChopPullback s k) := by
  filter_upwards [hv.eventually_X_none_mul_X_some_mem_stanleyReisnerIdeal k hi hvP hs] with ε hE
  rw [facetIdeal_le_iff, linearRelationIdeal_le_iff, stanleyReisnerIdeal_le_iff]
  refine ⟨fun t ht ↦ ?_, fun φ ↦ ?_⟩
  · -- A nonface `t` of `Δ` does not lie in `s`, the facets at the corner `v ∈ Δ`; pick `j₁ ∈ t`
    -- off `s`. Modulo `E`, the pullback of `∏_{j ∈ t.erase j₁} D j` is
    -- `∏_{j ∈ t.erase j₁} D (some j)`, and `D j₁` pulls back to `D (some j₁)`, so the pullback of
    -- `∏_{j ∈ t} D j` is `∏_{j ∈ t} D (some j)` modulo `E D (some j₁)`.
    obtain ⟨j₁, hj₁t, hj₁s⟩ : ∃ j₁ ∈ t, j₁ ∉ s := by
      by_contra! h
      exact isNonface_def.1 ht v hvP (fun j hj ↦ hs ▸ Finset.mem_coe.2 (h j hj))
    obtain ⟨r, hr⟩ := X_none_dvd_cornerChopPullback_prod_sub s k (t.erase j₁)
    have hprod : cornerChopPullback s k (∏ j ∈ t, X j) =
        ∏ j ∈ t.map .some, X j + r * (X none * X (some j₁)) := by
      rw [← Finset.mul_prod_erase _ _ hj₁t, map_mul, cornerChopPullback_X, ite_eq_right hj₁s,
        add_zero, ← Finset.mul_prod_erase _ _ (Finset.mem_map_of_mem .some hj₁t),
        ← Finset.map_erase, Function.Embedding.some_apply]
      linear_combination X (some j₁) * hr
    rw [Ideal.mem_comap, hprod]
    refine stanleyReisnerIdeal_le_facetIdeal _ _ _ k (add_mem ?_ (Ideal.mul_mem_left _ _ ?_))
    · exact ht.cornerChop_map_some.prod_mem_stanleyReisnerIdeal
    · exact hE j₁ hj₁s
  · rw [Ideal.mem_comap, cornerChopPullback_linearRelation]
    exact linearRelationIdeal_le_facetIdeal _ _ _ k (linearRelation_mem_linearRelationIdeal _ k φ)

end Pullback

end TauCeti.Toric
