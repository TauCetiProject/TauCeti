/-!
# The facet presentation ring of a product of polytopes

Let `Δ ⊆ V*` and `Δ' ⊆ V'*` be the polyhedra of facet presentations `(u, c)` and `(u', c')` in
lattices `i : N →+ V` and `i' : N' →+ V'`. Their product `Δ × Δ'` is the polyhedron of the product
presentation, with facets indexed by `ι ⊕ ι'`, normals `(u j, 0)` and `(0, u' j')`
(`TauCeti.Toric.prodNormal u u'`) and support constants `Sum.elim c c'`. For Delzant polytopes the
symplectic toric manifold of `Δ × Δ'` is the product `M_Δ × M_Δ'`, whose cohomology ring is, by
the Künneth formula, the tensor product of the cohomology rings of the factors. This file proves
the corresponding statement for the facet presentation rings
(`TauCeti.Toric.FacetRing`), over any commutative ring `k`:

`k[D] ⧸ I_(Δ × Δ') ≃ (k[D] ⧸ I_Δ) ⊗[k] (k[D'] ⧸ I_Δ')`,

the generator `D (inl j)` going to `D j ⊗ 1` and `D (inr j')` to `1 ⊗ D j'`
(`TauCeti.Toric.facetRingProdEquiv`). It holds for arbitrary facet presentations; no Delzant
hypothesis is needed.

Both kinds of relations split along the two factors, so the ideal of the product is generated by
the images of the ideals of the factors (`TauCeti.Toric.facetIdeal_prod`), and the isomorphism is
the general one for such quotients, `MvPolynomial.quotientTensorQuotientEquivSum`.

* A point of the product lies on all the facets of a set `s ⊆ ι ⊕ ι'` exactly when its two
  components lie on the facets of `s` from their own factor. So `s` is a nonface of the product
  exactly when its part `s.toLeft` in `ι` is a nonface of `Δ` or its part `s.toRight` in `ι'` is a
  nonface of `Δ'` (`TauCeti.Toric.isNonface_prod_iff`). The monomial of `s` is the product of the
  monomials of these two parts, so the Stanley–Reisner ideal of the product is generated by the
  images of those of the factors (`TauCeti.Toric.stanleyReisnerIdeal_prod`).
* A weight `φ` of `N × N'` is the sum of its restrictions to `N` and `N'`, and its linear relation
  is the sum of their linear relations. So the linear relation ideal of the product is generated by
  the images of those of the factors (`TauCeti.Toric.linearRelationIdeal_prod`).

The class `∑ j, c j D j` of the support constants of the product is the sum of the classes of the
factors (`TauCeti.Toric.supportClass_prod`), so under the isomorphism it is `[Σ c] ⊗ 1 + 1 ⊗ [Σ c']`
(`TauCeti.Toric.facetRingProdEquiv_mk_supportClass`), as the class of the product symplectic form
is the sum of the pullbacks of the classes of the factors.

For a product of two standard simplices of sizes `a, b > 0`, the moment polytope of
`ℂPᵐ × ℂPⁿ`, this gives `k[x] ⧸ (x ^ (m + 1)) ⊗[k] k[y] ⧸ (y ^ (n + 1))`
(`TauCeti.Toric.facetRingSimplexProdEquiv`), with `-∑ j, c j D j` going to `a x ⊗ 1 + b 1 ⊗ y`
(`TauCeti.Toric.facetRingSimplexProdEquiv_mk_neg_supportClass`). For `m = n = 1` the polytope is
the rectangle `[0, a] × [0, b]` of `S² × S²`, and the ring is `k[x] ⧸ (x ^ 2) ⊗[k] k[y] ⧸ (y ^ 2)`.

## Main results

* `TauCeti.Toric.isNonface_prod_iff`: the nonfaces of a product.
* `TauCeti.Toric.stanleyReisnerIdeal_prod`, `TauCeti.Toric.linearRelationIdeal_prod`,
  `TauCeti.Toric.facetIdeal_prod`: the ideals of a product are generated by those of the factors.
* `TauCeti.Toric.facetRingProdEquiv`: the facet ring of a product is the tensor product of the
  facet rings of the factors.
* `TauCeti.Toric.facetRingProdEquiv_mk_supportClass`: the support class of a product.
* `TauCeti.Toric.facetRingSimplexProdEquiv`: the facet ring of a product of two simplices.

## References

* V. Guillemin, *Moment Maps and Combinatorial Invariants of Hamiltonian `T^n`-spaces*,
  Birkhäuser, 1994, Chapter 1 and Appendix 2 (the cohomology ring of a toric manifold).
* W. Fulton, *Introduction to Toric Varieties*, Annals of Mathematics Studies 131, Princeton
  University Press, 1993, Section 5.2.
-/

public section

noncomputable section

open Set MvPolynomial
open scoped TensorProduct

namespace TauCeti.Toric

variable {ι ι' N N' V V' : Type*} [AddCommGroup N] [AddCommGroup N']
  [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedAddCommGroup V'] [NormedSpace ℝ V']
  {i : N →+ V} {i' : N' →+ V'} {u : ι → N} {u' : ι' → N'} {c : ι → ℝ} {c' : ι' → ℝ}
  (k : Type*) [CommRing k]

/-! ### The relations of a product -/

/-- **The nonfaces of a product.** A set `s` of facets of `Δ × Δ'` is a nonface exactly when its
facets from `Δ` form a nonface of `Δ` or its facets from `Δ'` form a nonface of `Δ'`. -/
theorem isNonface_prod_iff {s : Finset (ι ⊕ ι')} :
    IsNonface (i.prodMap i') (prodNormal u u') (Sum.elim c c') s ↔
      IsNonface i u c s.toLeft ∨ IsNonface i' u' c' s.toRight := by
  -- At `y.coprod y'`, the facets of `s` are active exactly when those of each factor are.
  have hsub (y : StrongDual ℝ V) (y' : StrongDual ℝ V') :
      (s : Set (ι ⊕ ι')) ⊆
          activeSet (facetPairing (i.prodMap i') (prodNormal u u')) (Sum.elim c c') (y.coprod y') ↔
        (s.toLeft : Set ι) ⊆ activeSet (facetPairing i u) c y ∧
          (s.toRight : Set ι') ⊆ activeSet (facetPairing i' u') c' y' := by
    simp only [activeSet_prod, Set.subset_def, Sum.forall, Finset.mem_coe, Finset.mem_toLeft,
      Finset.mem_toRight, mem_union, mem_image, Sum.inl.injEq, Sum.inr.injEq, reduceCtorEq,
      and_false, exists_false, or_false, false_or, exists_eq_right]
  rw [isNonface_def, isNonface_def, isNonface_def]
  constructor
  · intro hs
    by_contra! h
    obtain ⟨⟨y, hy, hys⟩, ⟨y', hy', hys'⟩⟩ := h
    exact hs _ ((coprod_mem_facetPolyhedron_prod_iff y y').2 ⟨hy, hy'⟩) ((hsub y y').2 ⟨hys, hys'⟩)
  · rintro h x hx hxs
    rw [← ContinuousLinearMap.coprod_comp_inl_inr x] at hx hxs
    rw [coprod_mem_facetPolyhedron_prod_iff] at hx
    rw [hsub] at hxs
    rcases h with h | h
    · exact h _ hx.1 hxs.1
    · exact h _ hx.2 hxs.2

/-- The image under `D j ↦ D (inl j)` of the monomial of a nonface of `Δ` is the monomial of a
nonface of `Δ × Δ'`. -/
private theorem rename_inl_prod_mem_stanleyReisnerIdeal {t : Finset ι} (ht : IsNonface i u c t) :
    rename Sum.inl (∏ j ∈ t, X j : MvPolynomial ι k) ∈
      stanleyReisnerIdeal (i.prodMap i') (prodNormal u u') (Sum.elim c c') k := by
  have h : IsNonface (i.prodMap i') (prodNormal u u') (Sum.elim c c') (t.disjSum ∅) :=
    isNonface_prod_iff.2 (Or.inl (by rwa [Finset.toLeft_disjSum]))
  simpa [Finset.prod_disjSum] using h.prod_mem_stanleyReisnerIdeal (k := k)

/-- The image under `D j' ↦ D (inr j')` of the monomial of a nonface of `Δ'` is the monomial of a
nonface of `Δ × Δ'`. -/
private theorem rename_inr_prod_mem_stanleyReisnerIdeal {t : Finset ι'}
    (ht : IsNonface i' u' c' t) :
    rename Sum.inr (∏ j ∈ t, X j : MvPolynomial ι' k) ∈
      stanleyReisnerIdeal (i.prodMap i') (prodNormal u u') (Sum.elim c c') k := by
  have h : IsNonface (i.prodMap i') (prodNormal u u') (Sum.elim c c') ((∅ : Finset ι).disjSum t) :=
    isNonface_prod_iff.2 (Or.inr (by rwa [Finset.toRight_disjSum]))
  simpa [Finset.prod_disjSum] using h.prod_mem_stanleyReisnerIdeal (k := k)

/-- **The Stanley–Reisner ideal of a product** is generated by the images of the Stanley–Reisner
ideals of the factors under `D j ↦ D (inl j)` and `D j' ↦ D (inr j')`. -/
theorem stanleyReisnerIdeal_prod :
    stanleyReisnerIdeal (i.prodMap i') (prodNormal u u') (Sum.elim c c') k =
      (stanleyReisnerIdeal i u c k).map (rename Sum.inl) ⊔
        (stanleyReisnerIdeal i' u' c' k).map (rename Sum.inr) := by
  apply le_antisymm
  · -- The monomial of a nonface is the product of the monomials of its two parts, one of which
    -- is the monomial of a nonface of its factor.
    rw [stanleyReisnerIdeal_le_iff]
    intro s hs
    rw [Finset.prod_sum_eq_prod_toLeft_mul_prod_toRight]
    rcases isNonface_prod_iff.1 hs with h | h
    · refine Ideal.mem_sup_left (Ideal.mul_mem_right _ _ ?_)
      simpa using Ideal.mem_map_of_mem (rename Sum.inl) (h.prod_mem_stanleyReisnerIdeal (k := k))
    · refine Ideal.mem_sup_right (Ideal.mul_mem_left _ _ ?_)
      simpa using Ideal.mem_map_of_mem (rename Sum.inr) (h.prod_mem_stanleyReisnerIdeal (k := k))
  · refine sup_le (Ideal.map_le_iff_le_comap.2 ?_) (Ideal.map_le_iff_le_comap.2 ?_) <;>
      rw [stanleyReisnerIdeal_le_iff] <;> intro t ht
    · exact rename_inl_prod_mem_stanleyReisnerIdeal k ht
    · exact rename_inr_prod_mem_stanleyReisnerIdeal k ht

variable [Fintype ι] [Fintype ι']

/-- The linear relation of a weight of `N × N'` is the sum of the images of the linear relations of
its restrictions to `N` and to `N'`. -/
theorem linearRelation_prod (φ : N × N' →+ k) :
    linearRelation (prodNormal u u') k φ =
      rename Sum.inl (linearRelation u k (φ.comp (AddMonoidHom.inl N N'))) +
        rename Sum.inr (linearRelation u' k (φ.comp (AddMonoidHom.inr N N'))) := by
  simp [linearRelation_def, Fintype.sum_sum_type]

/-- The image under `D j ↦ D (inl j)` of the linear relation of a weight `ψ` of `N` is the linear
relation of the weight `ψ ∘ fst` of `N × N'`. -/
theorem rename_inl_linearRelation (ψ : N →+ k) :
    rename Sum.inl (linearRelation u k ψ) =
      linearRelation (prodNormal u u') k (ψ.comp (AddMonoidHom.fst N N')) := by
  simp [linearRelation_def, Fintype.sum_sum_type]

/-- The image under `D j' ↦ D (inr j')` of the linear relation of a weight `ψ` of `N'` is the
linear relation of the weight `ψ ∘ snd` of `N × N'`. -/
theorem rename_inr_linearRelation (ψ : N' →+ k) :
    rename Sum.inr (linearRelation u' k ψ) =
      linearRelation (prodNormal u u') k (ψ.comp (AddMonoidHom.snd N N')) := by
  simp [linearRelation_def, Fintype.sum_sum_type]

/-- **The linear relations of a product** are generated by the images of the linear relations of
the factors under `D j ↦ D (inl j)` and `D j' ↦ D (inr j')`. -/
theorem linearRelationIdeal_prod :
    linearRelationIdeal (prodNormal u u') k =
      (linearRelationIdeal u k).map (rename Sum.inl) ⊔
        (linearRelationIdeal u' k).map (rename Sum.inr) := by
  apply le_antisymm
  · rw [linearRelationIdeal_le_iff]
    intro φ
    rw [linearRelation_prod]
    exact Submodule.add_mem_sup
      (Ideal.mem_map_of_mem _ (linearRelation_mem_linearRelationIdeal u k _))
      (Ideal.mem_map_of_mem _ (linearRelation_mem_linearRelationIdeal u' k _))
  · refine sup_le (Ideal.map_le_iff_le_comap.2 ?_) (Ideal.map_le_iff_le_comap.2 ?_) <;>
      rw [linearRelationIdeal_le_iff] <;> intro ψ
    · rw [Ideal.mem_comap, rename_inl_linearRelation (u' := u')]
      exact linearRelation_mem_linearRelationIdeal _ k _
    · rw [Ideal.mem_comap, rename_inr_linearRelation (u := u)]
      exact linearRelation_mem_linearRelationIdeal _ k _

/-- **The ideal of a product presentation** is generated by the images of the ideals of the
factors under `D j ↦ D (inl j)` and `D j' ↦ D (inr j')`. -/
theorem facetIdeal_prod :
    facetIdeal (i.prodMap i') (prodNormal u u') (Sum.elim c c') k =
      (facetIdeal i u c k).map (rename Sum.inl) ⊔ (facetIdeal i' u' c' k).map (rename Sum.inr) := by
  rw [facetIdeal_def, facetIdeal_def, facetIdeal_def, stanleyReisnerIdeal_prod,
    linearRelationIdeal_prod, Ideal.map_sup, Ideal.map_sup, sup_sup_sup_comm]

/-- The map `D j ↦ D (inl j)` sends the relations of `Δ` to relations of `Δ × Δ'`, so it induces a
map of facet rings `FacetRing Δ → FacetRing (Δ × Δ')`. -/
theorem facetIdeal_le_comap_rename_inl :
    facetIdeal i u c k ≤
      (facetIdeal (i.prodMap i') (prodNormal u u') (Sum.elim c c') k).comap (rename Sum.inl) := by
  rw [← Ideal.map_le_iff_le_comap, facetIdeal_prod]
  exact le_sup_left

/-- The map `D j' ↦ D (inr j')` sends the relations of `Δ'` to relations of `Δ × Δ'`, so it
induces a map of facet rings `FacetRing Δ' → FacetRing (Δ × Δ')`. -/
theorem facetIdeal_le_comap_rename_inr :
    facetIdeal i' u' c' k ≤
      (facetIdeal (i.prodMap i') (prodNormal u u') (Sum.elim c c') k).comap (rename Sum.inr) := by
  rw [← Ideal.map_le_iff_le_comap, facetIdeal_prod]
  exact le_sup_right

/-! ### The facet ring of a product -/

variable (i i' u u' c c')

/-- **The facet ring of a product** is the tensor product of the facet rings of the factors: the
generator `D (inl j)` of a facet of `Δ` goes to `D j ⊗ 1`, and the generator `D (inr j')` of a
facet of `Δ'` goes to `1 ⊗ D j'`. -/
def facetRingProdEquiv :
    FacetRing (i.prodMap i') (prodNormal u u') (Sum.elim c c') k ≃ₐ[k]
      FacetRing i u c k ⊗[k] FacetRing i' u' c' k :=
  (Ideal.quotientEquivAlgOfEq k (facetIdeal_prod k)).trans
    (MvPolynomial.quotientTensorQuotientEquivSum _ _).symm

/-- The isomorphism `facetRingProdEquiv` sends the class of the image of `p` under
`D j ↦ D (inl j)` to `[p] ⊗ 1`. -/
@[simp]
theorem facetRingProdEquiv_mk_rename_inl (p : MvPolynomial ι k) :
    facetRingProdEquiv i i' u u' c c' k (Ideal.Quotient.mk _ (rename Sum.inl p)) =
      Ideal.Quotient.mk _ p ⊗ₜ 1 := by
  rw [facetRingProdEquiv, AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk,
    MvPolynomial.quotientTensorQuotientEquivSum_symm_mk_rename_inl]

/-- The isomorphism `facetRingProdEquiv` sends the class of the image of `q` under
`D j' ↦ D (inr j')` to `1 ⊗ [q]`. -/
@[simp]
theorem facetRingProdEquiv_mk_rename_inr (q : MvPolynomial ι' k) :
    facetRingProdEquiv i i' u u' c c' k (Ideal.Quotient.mk _ (rename Sum.inr q)) =
      1 ⊗ₜ Ideal.Quotient.mk _ q := by
  rw [facetRingProdEquiv, AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk,
    MvPolynomial.quotientTensorQuotientEquivSum_symm_mk_rename_inr]

/-- The isomorphism `facetRingProdEquiv` sends the generator `D (inl j)` to `D j ⊗ 1`. -/
@[simp]
theorem facetRingProdEquiv_mk_X_inl (j : ι) :
    facetRingProdEquiv i i' u u' c c' k (Ideal.Quotient.mk _ (X (.inl j))) =
      Ideal.Quotient.mk _ (X j) ⊗ₜ 1 := by
  simpa using facetRingProdEquiv_mk_rename_inl i i' u u' c c' k (X j)

/-- The isomorphism `facetRingProdEquiv` sends the generator `D (inr j')` to `1 ⊗ D j'`. -/
@[simp]
theorem facetRingProdEquiv_mk_X_inr (j : ι') :
    facetRingProdEquiv i i' u u' c c' k (Ideal.Quotient.mk _ (X (.inr j))) =
      1 ⊗ₜ Ideal.Quotient.mk _ (X j) := by
  simpa using facetRingProdEquiv_mk_rename_inr i i' u u' c c' k (X j)

/-- The inverse of `facetRingProdEquiv` sends `[p] ⊗ [q]` to the class of the product of the
images of `p` and `q` under `D j ↦ D (inl j)` and `D j' ↦ D (inr j')`. -/
@[simp]
theorem facetRingProdEquiv_symm_tmul (p : MvPolynomial ι k) (q : MvPolynomial ι' k) :
    (facetRingProdEquiv i i' u u' c c' k).symm
        (Ideal.Quotient.mk _ p ⊗ₜ Ideal.Quotient.mk _ q) =
      Ideal.Quotient.mk _ (rename Sum.inl p * rename Sum.inr q) := by
  rw [AlgEquiv.symm_apply_eq, map_mul, map_mul, facetRingProdEquiv_mk_rename_inl,
    facetRingProdEquiv_mk_rename_inr, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

/-- The inverse of `facetRingProdEquiv` sends `[p] ⊗ 1` to the class of the image of `p` under
`D j ↦ D (inl j)`. -/
@[simp]
theorem facetRingProdEquiv_symm_tmul_one (p : MvPolynomial ι k) :
    (facetRingProdEquiv i i' u u' c c' k).symm (Ideal.Quotient.mk _ p ⊗ₜ 1) =
      Ideal.Quotient.mk _ (rename Sum.inl p) := by
  rw [AlgEquiv.symm_apply_eq, facetRingProdEquiv_mk_rename_inl]

/-- The inverse of `facetRingProdEquiv` sends `1 ⊗ [q]` to the class of the image of `q` under
`D j' ↦ D (inr j')`. -/
@[simp]
theorem facetRingProdEquiv_symm_one_tmul (q : MvPolynomial ι' k) :
    (facetRingProdEquiv i i' u u' c c' k).symm (1 ⊗ₜ Ideal.Quotient.mk _ q) =
      Ideal.Quotient.mk _ (rename Sum.inr q) := by
  rw [AlgEquiv.symm_apply_eq, facetRingProdEquiv_mk_rename_inr]

/-! ### The support class of a product -/

variable {c c'} in
/-- The class `∑ j, c j D j` of the product is the sum of the images of the classes of the
factors. -/
theorem supportClass_prod :
    supportClass (Sum.elim c c') =
      rename Sum.inl (supportClass c) + rename Sum.inr (supportClass c') := by
  simp [supportClass_def, Fintype.sum_sum_type]

/-- **The support class of a product.** Under `facetRingProdEquiv`, the class `∑ j, c j D j` of
the product is `[∑ j, c j D j] ⊗ 1 + 1 ⊗ [∑ j', c' j' D j']`. -/
theorem facetRingProdEquiv_mk_supportClass :
    facetRingProdEquiv i i' u u' c c' ℝ (Ideal.Quotient.mk _ (supportClass (Sum.elim c c'))) =
      Ideal.Quotient.mk _ (supportClass c) ⊗ₜ 1 + 1 ⊗ₜ Ideal.Quotient.mk _ (supportClass c') := by
  rw [supportClass_prod, map_add, map_add, facetRingProdEquiv_mk_rename_inl,
    facetRingProdEquiv_mk_rename_inr]

/-! ### Products of two simplices -/

section Simplex

variable {κ κ' : Type*} [DecidableEq κ] [Fintype κ] [DecidableEq κ'] [Fintype κ'] {a b : ℝ}

/-- **The facet ring of `ℂPᵐ × ℂPⁿ`.** For `a, b > 0`, the facet presentation ring of the product
of the standard simplices of sizes `a` in `ℝ^κ` and `b` in `ℝ^κ'` is
`k[x] ⧸ (x ^ (#κ + 1)) ⊗[k] k[y] ⧸ (y ^ (#κ' + 1))`, each generator `D (inl o)` going to `x ⊗ 1`
and each `D (inr o')` to `1 ⊗ y`. -/
def facetRingSimplexProdEquiv (ha : 0 < a) (hb : 0 < b) :
    FacetRing (((Int.castAddHom ℝ).compLeft κ).prodMap ((Int.castAddHom ℝ).compLeft κ'))
        (prodNormal (simplexNormal κ) (simplexNormal κ'))
        (Sum.elim (simplexSupport a) (simplexSupport b)) k ≃ₐ[k]
      (Polynomial k ⧸ Ideal.span {(Polynomial.X : Polynomial k) ^ (Fintype.card κ + 1)}) ⊗[k]
        (Polynomial k ⧸ Ideal.span {(Polynomial.X : Polynomial k) ^ (Fintype.card κ' + 1)}) :=
  (facetRingProdEquiv _ _ _ _ _ _ k).trans
    (Algebra.TensorProduct.congr (facetRingSimplexEquiv ha) (facetRingSimplexEquiv hb))

/-- The isomorphism `facetRingSimplexProdEquiv` sends every generator `D (inl o)` to `x ⊗ 1`. -/
@[simp]
theorem facetRingSimplexProdEquiv_mk_X_inl (ha : 0 < a) (hb : 0 < b) (o : Option κ) :
    facetRingSimplexProdEquiv (κ' := κ') k ha hb (Ideal.Quotient.mk _ (X (.inl o))) =
      Ideal.Quotient.mk _ Polynomial.X ⊗ₜ 1 := by
  simp [facetRingSimplexProdEquiv]

/-- The isomorphism `facetRingSimplexProdEquiv` sends every generator `D (inr o')` to `1 ⊗ y`. -/
@[simp]
theorem facetRingSimplexProdEquiv_mk_X_inr (ha : 0 < a) (hb : 0 < b) (o : Option κ') :
    facetRingSimplexProdEquiv (κ := κ) k ha hb (Ideal.Quotient.mk _ (X (.inr o))) =
      1 ⊗ₜ Ideal.Quotient.mk _ Polynomial.X := by
  simp [facetRingSimplexProdEquiv]

/-- The inverse of `facetRingSimplexProdEquiv` sends `x ⊗ 1` to the generator `D (inl none)`. -/
@[simp]
theorem facetRingSimplexProdEquiv_symm_mk_X_tmul_one (ha : 0 < a) (hb : 0 < b) :
    (facetRingSimplexProdEquiv (κ := κ) (κ' := κ') k ha hb).symm
        (Ideal.Quotient.mk _ Polynomial.X ⊗ₜ 1) =
      Ideal.Quotient.mk _ (X (.inl none)) := by
  rw [AlgEquiv.symm_apply_eq, facetRingSimplexProdEquiv_mk_X_inl]

/-- The inverse of `facetRingSimplexProdEquiv` sends `1 ⊗ y` to the generator `D (inr none)`. -/
@[simp]
theorem facetRingSimplexProdEquiv_symm_one_tmul_mk_X (ha : 0 < a) (hb : 0 < b) :
    (facetRingSimplexProdEquiv (κ := κ) (κ' := κ') k ha hb).symm
        (1 ⊗ₜ Ideal.Quotient.mk _ Polynomial.X) =
      Ideal.Quotient.mk _ (X (.inr none)) := by
  rw [AlgEquiv.symm_apply_eq, facetRingSimplexProdEquiv_mk_X_inr]

/-- **The support class of `ℂPᵐ × ℂPⁿ`.** For the product of the simplices of sizes `a, b > 0`,
the class `-∑ j, c j D j` is `a x ⊗ 1 + b 1 ⊗ y`. So `-2π ∑ j, c j D j`, which corresponds to the
class of the product symplectic form, is `2π (a x ⊗ 1 + b 1 ⊗ y)`. -/
theorem facetRingSimplexProdEquiv_mk_neg_supportClass (ha : 0 < a) (hb : 0 < b) :
    facetRingSimplexProdEquiv ℝ ha hb
        (Ideal.Quotient.mk _ (-supportClass (Sum.elim (simplexSupport (κ := κ) a)
          (simplexSupport (κ := κ') b)))) =
      a • (Ideal.Quotient.mk _ Polynomial.X ⊗ₜ 1) +
        b • (1 ⊗ₜ Ideal.Quotient.mk _ Polynomial.X) := by
  have ha' := facetRingSimplexEquiv_mk_neg_supportClass (κ := κ) ha
  have hb' := facetRingSimplexEquiv_mk_neg_supportClass (κ := κ') hb
  rw [map_neg] at ha' hb'
  rw [facetRingSimplexProdEquiv, AlgEquiv.trans_apply, map_neg, map_neg,
    facetRingProdEquiv_mk_supportClass, neg_add, ← TensorProduct.neg_tmul, ← TensorProduct.tmul_neg]
  simp only [map_add, Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul,
    AlgEquiv.coe_toAlgHom, ha', hb', map_one, TensorProduct.tmul_smul, TensorProduct.smul_tmul']

end Simplex

end TauCeti.Toric
