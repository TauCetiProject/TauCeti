module

public import TauCeti.Geometry.Toric.Delzant.Basic
public import TauCeti.Geometry.Toric.Algebraic.Lattice.Basic
public import TauCeti.Analysis.Convex.Polyhedron.TangentCone
public import TauCeti.Geometry.Convex.Cone.Basis
import Mathlib.LinearAlgebra.Dual.Basis

/-!
# Tangent cones at smooth vertices

At a smooth vertex of an integral facet presentation, the active inward normals form an integral
basis. Its real dual basis gives the normalized inward edge directions. The positive tangent cone
is exactly their conic hull, and the polyhedron locally agrees with its translate by the vertex.
In particular, this cone is simplicial. These are the corner coordinates used in local models of
symplectic toric manifolds.

The results require the point to lie in the polyhedron: the existing `IsSmoothVertex` predicate
only tests the active normals. No compactness or Delzant hypothesis on the whole presentation is
needed. Empty bases in rank zero are included.

The edge basis uses Mathlib's `IsBaseChange.basis` and `Module.Basis.dualBasis`, followed by the
finite-dimensional identification of the algebraic and continuous duals.

## References

* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Springer, 2001, Section 28.
* V. Guillemin, *Moment Maps and Combinatorial Invariants of Hamiltonian Tⁿ-spaces*,
  Birkhäuser, 1994, Chapter 1.
-/

public noncomputable section

open Set Filter
open scoped Topology NNReal

namespace TauCeti.Toric

variable {ι N V : Type*} [Finite ι] [AddCommGroup N]
  [NormedAddCommGroup V] [NormedSpace ℝ V]
  {i : N →+ V} {u : ι → N} {c : ι → ℝ} {x : StrongDual ℝ V}

namespace IsSmoothVertex

/-- The inward edge basis at a smooth vertex, dual to the real basis of active inward normals.
The normalization pairs an edge with its corresponding normal to `1`. -/
def edgeBasis (hx : IsSmoothVertex i u c x) (hi : IsIntegralLattice i) :
    Module.Basis (activeSet (facetPairing i u) c x) ℝ (StrongDual ℝ V) := by
  classical
  letI := hi.finiteDimensional
  exact (hi.isBaseChange.basis (Classical.choose (isSmoothVertex_def.1 hx))).dualBasis.map
    LinearMap.toContinuousLinearMap

/-- The edge coordinates of a covector are its values on the active normals. -/
@[simp]
theorem edgeBasis_repr (hx : IsSmoothVertex i u c x) (hi : IsIntegralLattice i)
    (v : StrongDual ℝ V) (j : activeSet (facetPairing i u) c x) :
    (hx.edgeBasis hi).repr v j = v (i (u j)) := by
  classical
  let := hi.finiteDimensional
  simp only [edgeBasis, Module.Basis.map_repr, LinearEquiv.trans_apply,
    LinearMap.coe_toContinuousLinearMap_symm, Module.Basis.dualBasis_repr,
    hi.isBaseChange.basis_apply, AddMonoidHom.coe_toIntLinearMap,
    Classical.choose_spec (isSmoothVertex_def.1 hx) j, ContinuousLinearMap.coe_coe]

/-- Edges and active normals pair as dual bases. -/
@[simp]
theorem edgeBasis_apply (hx : IsSmoothVertex i u c x) (hi : IsIntegralLattice i)
    [DecidableEq (activeSet (facetPairing i u) c x)]
    (j k : activeSet (facetPairing i u) c x) :
    hx.edgeBasis hi j (i (u k)) = (if j = k then 1 else 0 : ℝ) := by
  classical
  rw [← hx.edgeBasis_repr hi, Module.Basis.repr_self_apply]

/-- The conic hull of the edge basis is the set of covectors nonnegative on all active normals.
Thus its coefficients are read directly from the facet inequalities. -/
theorem mem_hull_range_edgeBasis_iff (hx : IsSmoothVertex i u c x) (hi : IsIntegralLattice i)
    (v : StrongDual ℝ V) :
    v ∈ PointedCone.hull ℝ (range (hx.edgeBasis hi)) ↔
      ∀ j ∈ activeSet (facetPairing i u) c x, 0 ≤ v (i (u j)) := by
  simp only [Module.Basis.mem_pointedCone_hull_range_iff, hx.edgeBasis_repr hi,
    Subtype.forall]

/-- The positive tangent cone at a feasible smooth vertex is generated by its inward edge basis.
This identifies the actual tangent cone, including its signs, with the simplicial corner model. -/
theorem posTangentConeAt_eq_hull (hx : IsSmoothVertex i u c x) (hi : IsIntegralLattice i)
    (hxP : x ∈ facetPolyhedron i u c) :
    posTangentConeAt (facetPolyhedron i u c) x =
      (PointedCone.hull ℝ (range (hx.edgeBasis hi)) : Set (StrongDual ℝ V)) := by
  rw [facetPolyhedron_eq_polyhedron] at hxP ⊢
  rw [posTangentConeAt_polyhedron (continuous_facetPairing i u) hxP]
  ext v
  simpa only [mem_ofPred_eq, facetPairing_apply, SetLike.mem_coe] using
    (hx.mem_hull_range_edgeBasis_iff hi v).symm

/-- Near a feasible smooth vertex, membership in the polyhedron is membership in the translated
edge cone. This is a local equality of sets, rather than just an equality of tangent cones. -/
theorem eventually_mem_facetPolyhedron_iff (hx : IsSmoothVertex i u c x)
    (hi : IsIntegralLattice i) (hxP : x ∈ facetPolyhedron i u c) :
    ∀ᶠ y in 𝓝 x, y ∈ facetPolyhedron i u c ↔
      y - x ∈ PointedCone.hull ℝ (range (hx.edgeBasis hi)) := by
  rw [facetPolyhedron_eq_polyhedron] at hxP ⊢
  have h := eventually_mem_polyhedron_iff (continuous_facetPairing i u) hxP
  filter_upwards [h] with y hy
  simp only [facetPairing_apply] at hy
  exact hy.trans (hx.mem_hull_range_edgeBasis_iff hi (y - x)).symm

end IsSmoothVertex

end TauCeti.Toric
