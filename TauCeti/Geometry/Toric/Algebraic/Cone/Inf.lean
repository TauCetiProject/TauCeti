import Mathlib.GroupTheory.Finiteness

/-!
# Intersections of toric cones

When the real-linear map `ℝ ⊗[ℤ] N →ₗ[ℝ] V` induced by `i : N →+ V` is injective, the
intersection of two lattice-rational cones is lattice rational, and the intersection of two toric
cones is a toric cone. This holds when `i` exhibits `V` as the extension of scalars of `N` from `ℤ`
to `ℝ` (Mathlib's `IsBaseChange ℝ i.toIntLinearMap`, for instance when `i` is an integral lattice),
by `IsBaseChange.liftBaseChange_injective`, but the image of `i` need not span `V`. The injectivity
hypothesis cannot be dropped: `TauCeti.Toric.not_isToricCone_sqrtTwoCone_inf` exhibits two toric
cones for an injective lattice map with dense image whose intersection is not even lattice
rational.

The proof describes the intersection through the relations between the generators. If `σ` is
generated by the images of `a₁, …, aₚ` and `τ` by those of `b₁, …, b_q`, a point of `σ ⊓ τ` is
`∑ cₖ i(aₖ) = ∑ dₗ i(bₗ)` for a nonnegative real relation `(c, d)` between the vectors `aₖ` and
`-bₗ`. The key step, `TauCeti.Toric.mem_hull_natCast_relations_iff_of_liftBaseChange_injective`,
is that the cone of nonnegative real relations among finitely many lattice vectors is generated
by the relations with natural-number coefficients. The relations with natural-number coefficients
form a finitely generated monoid by Mathlib's `AddSubmonoid.fg_eqLocusM` (a form of Gordan's
lemma), and the images of its finitely many generators generate `σ ⊓ τ`.

The key step is an induction on the number of nonzero coefficients. If the lattice vectors in the
support of a nonnegative real relation are linearly independent over `ℤ`, they are linearly
independent over `ℝ` (`TauCeti.Toric.linearIndependent_comp_iff_of_liftBaseChange_injective`),
so the relation vanishes. Otherwise there is an integral relation `k` supported there, and moving
from the given relation along `k` in either direction until a coefficient vanishes writes it as a
nonnegative combination of relations with smaller support and, when `k` is nonnegative, of `k`
itself.

## Main declarations

* `TauCeti.Toric.mem_hull_natCast_relations_iff_of_liftBaseChange_injective`: the nonnegative
  real relations among finitely many lattice vectors form the cone generated by the relations with
  natural-number coefficients.
* `TauCeti.Toric.IsLatticeRational.inf`: when `ℝ ⊗[ℤ] N →ₗ[ℝ] V` is injective, the intersection
  of two lattice-rational cones is lattice rational.
* `TauCeti.Toric.IsToricCone.inf`: when `ℝ ⊗[ℤ] N →ₗ[ℝ] V` is injective, the intersection of two
  toric cones is a toric cone.

## References

* W. Fulton, *Introduction to Toric Varieties*, §1.2, property (1) of rational convex polyhedral
  cones.
* D. Cox, J. Little and H. Schenck, *Toric Varieties*, §1.2.
-/

public section

namespace TauCeti.Toric

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V] {i : N →+ V}

/-- The induction step for `mem_hull_natCast_relations_iff_of_liftBaseChange_injective`: an
integral relation `k` among the `v j`, supported in the support of a nonnegative real relation `c`
and positive somewhere, writes `c` as a nonnegative combination of nonnegative real relations of
smaller support and, when `k` is nonnegative, of `k` itself. -/
private theorem mem_hull_natCast_relations_of_int_relation {ι : Type*} [Fintype ι] {v : ι → N}
    {c : ι → ℝ} (hc : 0 ≤ c) (hcv : ∑ j, c j • i (v j) = 0)
    (step : ∀ u : ι → ℝ, 0 ≤ u → ∑ j, u j • i (v j) = 0 → Function.support u ⊂ Function.support c →
      u ∈ PointedCone.hull ℝ ((fun k : ι → ℕ ↦ fun j ↦ (k j : ℝ)) '' {k | ∑ j, k j • v j = 0}))
    {k : ι → ℤ} (hkv : ∑ j, k j • v j = 0) (hk : ∀ j, c j = 0 → k j = 0) (hpos : ∃ j, 0 < k j) :
    c ∈ PointedCone.hull ℝ ((fun k : ι → ℕ ↦ fun j ↦ (k j : ℝ)) '' {k | ∑ j, k j • v j = 0}) := by
  set C := PointedCone.hull ℝ ((fun k : ι → ℕ ↦ fun j ↦ (k j : ℝ)) '' {k | ∑ j, k j • v j = 0})
  let kR : ι → ℝ := fun j ↦ (k j : ℝ)
  have hrel : ∀ s : ℝ, ∑ j, (c - s • kR) j • i (v j) = 0 := fun s ↦ by
    have hkR : ∑ j, kR j • i (v j) = 0 := by
      simpa only [kR, map_sum, map_zsmul, map_zero, Int.cast_smul_eq_zsmul] using congrArg i hkv
    simp [sub_smul, Finset.sum_sub_distrib, mul_smul, ← Finset.smul_sum, hcv, hkR]
  obtain ⟨s, hs, hu, hsub⟩ := TauCeti.exists_pos_sub_smul_nonneg_support_ssubset hc (Set.toFinite _)
    (k := kR) (fun j h ↦ by simp [kR, hk j h]) (let ⟨j, hj⟩ := hpos; ⟨j, by simpa [kR]⟩)
  have hu₁ := step _ hu (hrel s) hsub
  by_cases hneg : ∃ j, k j < 0
  · -- Both directions along `k` leave the cone: `c` lies between two smaller relations.
    obtain ⟨t, ht, hu', hsub'⟩ :=
      TauCeti.exists_pos_sub_smul_nonneg_support_ssubset hc (Set.toFinite _)
      (k := -kR) (fun j h ↦ by simp [kR, hk j h]) (let ⟨j, hj⟩ := hneg; ⟨j, by simpa [kR]⟩)
    have hu₂ := step _ hu' (by simpa [sub_eq_add_neg] using hrel (-t)) hsub'
    have hcomb : c = (t / (s + t)) • (c - s • kR) + (s / (s + t)) • (c - t • -kR) := by
      ext j
      simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, Pi.neg_apply, smul_eq_mul]
      field_simp
      ring
    rw [hcomb]
    exact C.add_mem (C.smul_mem (by positivity) hu₁) (C.smul_mem (by positivity) hu₂)
  · -- `k` itself is a natural-number relation, so `c` is a smaller relation plus `s • k`.
    simp only [not_exists, not_lt] at hneg
    have hk₀ : kR ∈ C := PointedCone.subset_hull ⟨fun j ↦ (k j).toNat, ?_, ?_⟩
    · rw [← sub_add_cancel c (s • kR)]
      exact C.add_mem hu₁ (C.smul_mem hs.le hk₀)
    · simpa [← natCast_zsmul, Int.toNat_of_nonneg (hneg _)] using hkv
    · ext j
      simp only [kR]
      exact_mod_cast Int.toNat_of_nonneg (hneg j)

/-- **Rational generation of nonnegative relations.** When the real-linear map
`ℝ ⊗[ℤ] N →ₗ[ℝ] V` induced by `i` is injective (for instance when `i` is an integral lattice, or
more generally extends scalars from `ℤ` to `ℝ`), for finitely many lattice vectors `v j`, a real
vector `c` is a nonnegative linear combination of natural-number relations `k` (those with
`∑ j, k j • v j = 0`) exactly when it is a nonnegative real relation among the vectors
`i (v j)`. -/
theorem mem_hull_natCast_relations_iff_of_liftBaseChange_injective
    (hi : Function.Injective (i.toIntLinearMap.liftBaseChange ℝ))
    {ι : Type*} [Fintype ι] (v : ι → N) {c : ι → ℝ} :
    c ∈ PointedCone.hull ℝ
        ((fun k : ι → ℕ ↦ fun j ↦ (k j : ℝ)) '' {k | ∑ j, k j • v j = 0}) ↔
      0 ≤ c ∧ ∑ j, c j • i (v j) = 0 := by
  classical
  refine ⟨i.nonneg_relation_of_mem_hull_natCast_relations, ?_⟩
  rintro ⟨hc, hcv⟩
  -- Strong induction on the number of nonzero coordinates of `c`.
  induction hn : (Function.support c).ncard using Nat.strong_induction_on generalizing c with
  | _ n ih =>
  have step : ∀ u : ι → ℝ, 0 ≤ u → ∑ j, u j • i (v j) = 0 →
      Function.support u ⊂ Function.support c → u ∈ PointedCone.hull ℝ
        ((fun k : ι → ℕ ↦ fun j ↦ (k j : ℝ)) '' {k | ∑ j, k j • v j = 0}) :=
    fun u hu huv hsub ↦ ih _ (hn ▸ Set.ncard_lt_ncard hsub (Set.toFinite _)) hu huv rfl
  by_cases hli : LinearIndependent ℤ fun j : {j // c j ≠ 0} ↦ v j
  · -- Independent vectors in the support admit no nonzero real relation, so `c = 0`.
    have hsupp : ∑ j : {j // c j ≠ 0}, c j • i (v j) = 0 := by
      rw [Fintype.sum_of_injective Subtype.val Subtype.val_injective
        (fun j : {j // c j ≠ 0} ↦ c j • i (v j)) (fun j ↦ c j • i (v j))
        (by simp +contextual) (by simp), hcv]
    have hzero := Fintype.linearIndependent_iff.1
      ((linearIndependent_comp_iff_of_liftBaseChange_injective hi).2 hli) (fun j ↦ c j) hsupp
    have : c = 0 := funext fun j ↦ by_contra fun hj ↦ hj (hzero ⟨j, hj⟩)
    exact this ▸ Submodule.zero_mem _
  · -- A dependence among the vectors in the support gives an integral relation.
    obtain ⟨g, hg, j₀, hj₀⟩ := Fintype.not_linearIndependent_iff.1 hli
    let k : ι → ℤ := fun j ↦ if h : c j ≠ 0 then g ⟨j, h⟩ else 0
    have hk : ∀ j, c j = 0 → k j = 0 := fun j h ↦ by simp [k, h]
    have hkg : ∀ j : {j // c j ≠ 0}, k j = g j := fun j ↦ by simp [k, j.2]
    have hkv : ∑ j, k j • v j = 0 := by
      rw [← Fintype.sum_of_injective Subtype.val Subtype.val_injective
        (fun j : {j // c j ≠ 0} ↦ g j • v j) (fun j ↦ k j • v j)
        (by simp +contextual [k]) (by simp [hkg])]
      exact hg
    have hkj₀ : k j₀ ≠ 0 := hkg j₀ ▸ hj₀
    rcases hkj₀.lt_or_gt with hlt | hgt
    · exact mem_hull_natCast_relations_of_int_relation hc hcv step (k := -k)
        (by simpa [neg_smul] using hkv) (fun j h ↦ by simp [hk j h]) ⟨j₀, by simpa using hlt⟩
    · exact mem_hull_natCast_relations_of_int_relation hc hcv step hkv hk ⟨j₀, hgt⟩

/-- **Intersections of lattice-rational cones.** When the real-linear map `ℝ ⊗[ℤ] N →ₗ[ℝ] V`
induced by `i` is injective (for instance when `i` is an integral lattice, or more generally
extends scalars from `ℤ` to `ℝ`), the intersection of two lattice-rational cones is lattice
rational. -/
theorem IsLatticeRational.inf {σ τ : PointedCone ℝ V}
    (hi : Function.Injective (i.toIntLinearMap.liftBaseChange ℝ))
    (hσ : IsLatticeRational i σ) (hτ : IsLatticeRational i τ) :
    IsLatticeRational i (σ ⊓ τ) := by
  classical
  obtain ⟨s, rfl⟩ := isLatticeRational_iff.1 hσ
  obtain ⟨t, rfl⟩ := isLatticeRational_iff.1 hτ
  -- The generators of the two cones, with those of `τ` negated, and their natural relations,
  -- which form a finitely generated monoid.
  let v : s ⊕ t → N := Sum.elim (fun a ↦ a) fun b ↦ -b
  let f : (s ⊕ t → ℕ) →+ N :=
    { toFun k := ∑ j, k j • v j
      map_zero' := by simp
      map_add' _ _ := by simp [add_smul, Finset.sum_add_distrib] }
  obtain ⟨G, hG, hGfin⟩ := (AddSubmonoid.fg_iff _).1 (AddSubmonoid.fg_eqLocusM f 0)
  -- A natural relation, read on the generators of `σ`, is also read on the generators of `τ`.
  let p : (s ⊕ t → ℕ) → N := fun k ↦ ∑ a : s, k (.inl a) • (a : N)
  have hrel : ∀ k ∈ G, p k = ∑ b : t, k (.inr b) • (b : N) := fun k hk ↦ by
    have hkf : k ∈ f.eqLocusM 0 := hG ▸ AddSubmonoid.subset_closure hk
    simpa [f, Fintype.sum_sum_type, v, p, add_neg_eq_zero] using AddMonoidHom.mem_eqLocusM.1 hkf
  refine isLatticeRational_iff.2 ⟨hGfin.toFinset.image p, le_antisymm ?_ ?_⟩
  · intro x hx
    simp only [Set.image_eq_range] at hx
    obtain ⟨c, hc, hcv, rfl⟩ := PointedCone.exists_nonneg_relation_of_mem_inf_hull_range
      (R := ℝ) (a := fun a : s ↦ i a) (b := fun b : t ↦ i b) hx
    -- `c` is a nonnegative combination of the finitely many natural relations in `G`.
    have hcG := (mem_hull_natCast_relations_iff_of_liftBaseChange_injective hi v).2
      ⟨hc, by simpa [v, Fintype.sum_sum_type] using hcv⟩
    have hK : {k : s ⊕ t → ℕ | ∑ j, k j • v j = 0} = AddSubmonoid.closure G := by
      ext k
      rw [hG, SetLike.mem_coe, AddMonoidHom.mem_eqLocusM]
      simp [f]
    -- Casting natural coordinates is an additive map, so taking additive closure does not
    -- change the cone hull of its image.
    have hcast : (fun k : s ⊕ t → ℕ ↦ fun j ↦ (k j : ℝ)) =
        ⇑(AddMonoidHom.compLeft (Nat.castAddMonoidHom ℝ) (s ⊕ t)) := rfl
    rw [hK, hcast, ← AddSubmonoid.coe_map, AddMonoidHom.map_mclosure,
      PointedCone.hull, Submodule.span_closure] at hcG
    -- Reading a real relation on the generators of `σ` carries the generators to `i '' p '' G`.
    let L : (s ⊕ t → ℝ) →ₗ[ℝ] V := ∑ a : s, (LinearMap.proj (.inl a)).smulRight (i a)
    have hL : ∀ d, L d = ∑ a : s, d (.inl a) • i a := fun d ↦ by simp [L]
    have hmap : PointedCone.hull ℝ ((fun k : s ⊕ t → ℕ ↦ fun j ↦ (k j : ℝ)) '' G) ≤
        (PointedCone.hull ℝ (i '' (hGfin.toFinset.image p : Set N))).comap
          (L.restrictScalars _) := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨k, hk, rfl⟩
      refine PointedCone.subset_hull ⟨p k, by simpa using ⟨k, hk, rfl⟩, ?_⟩
      simp [hL, p, ← Nat.cast_smul_eq_nsmul ℝ]
    rw [← hL]
    exact hmap hcG
  · refine Submodule.span_le.2 ?_
    rintro _ ⟨_, hu, rfl⟩
    obtain ⟨k, hk, rfl⟩ := Finset.mem_image.1 hu
    rw [hGfin.mem_toFinset] at hk
    refine ⟨?_, ?_⟩
    · rw [SetLike.mem_coe, map_sum]
      exact Submodule.sum_mem _ fun a _ ↦ by
        rw [map_nsmul]
        exact Submodule.smul_of_tower_mem _ _ (PointedCone.subset_hull ⟨a, a.2, rfl⟩)
    · rw [SetLike.mem_coe, hrel k hk, map_sum]
      exact Submodule.sum_mem _ fun b _ ↦ by
        rw [map_nsmul]
        exact Submodule.smul_of_tower_mem _ _ (PointedCone.subset_hull ⟨b, b.2, rfl⟩)

/-- **Intersections of toric cones.** When the real-linear map `ℝ ⊗[ℤ] N →ₗ[ℝ] V` induced by `i`
is injective, the intersection of two toric cones is a toric cone. For an integral lattice `hi`,
the hypothesis is `hi.isBaseChange.liftBaseChange_injective`. The injectivity hypothesis cannot be
dropped, by `TauCeti.Toric.not_isToricCone_sqrtTwoCone_inf`. -/
theorem IsToricCone.inf {σ τ : PointedCone ℝ V}
    (hi : Function.Injective (i.toIntLinearMap.liftBaseChange ℝ))
    (hσ : IsToricCone i σ) (hτ : IsToricCone i τ) : IsToricCone i (σ ⊓ τ) :=
  ⟨hσ.rational.inf hi hτ.rational, hσ.salient.anti fun _ hx ↦ hx.1⟩

end TauCeti.Toric
