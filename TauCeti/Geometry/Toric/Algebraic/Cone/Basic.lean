/-!
# Toric cones in a real vector space with a lattice map

A *toric cone* is the combinatorial datum from which an affine toric variety is built. Following
the convention that the ambient convex geometry stays on Mathlib's carriers, a toric cone here is
a **predicate** on a Mathlib `PointedCone ℝ V`, taken relative to a lattice map `i : N →+ V`: the
cone must be generated by the images of finitely many lattice vectors, and salient, that is, it
must contain no line.

Salience is the condition that distinguishes the cones of affine toric varieties from arbitrary
pointed cones: Mathlib's name `PointedCone` records only that `0` belongs to the cone, so a line
is a pointed cone but is never a toric cone.

## Main declarations

* `TauCeti.Toric.IsLatticeRational`: a pointed cone is generated by the images of finitely many
  lattice vectors.
* `TauCeti.Toric.IsToricCone`: lattice rationality and salience.
* `TauCeti.Toric.IsToricCone.of_isFaceOf` and `TauCeti.Toric.IsToricCone.face`: a face of a toric
  cone is a toric cone. Since the pairwise intersection of two cones of a fan is a face of each of
  them, this is also what makes those intersections toric.
* `TauCeti.Toric.IsToricCone.map`: an injective real-linear map compatible with a map of lattices
  carries toric cones to toric cones, and `TauCeti.Toric.isToricCone_map_equiv_iff` upgrades this
  to an equivalence along an isomorphism of lattices.
* `TauCeti.Toric.IsToricCone.prod`: a product of toric cones is a toric cone for the product
  lattice map.

## Implementation notes

Finite generation is not recorded as a field of `IsToricCone`: `IsLatticeRational.fg` already
derives it from lattice rationality, and `IsToricCone.fg` exposes it.

`IsLatticeRational` is an ordinary (unexposed) definition, so its body is not visible to
downstream modules; `isLatticeRational_iff` is the public introduction and elimination interface
that replaces the unavailable anonymous constructor there.

The lattice map `i : N →+ V` asks nothing of `N` beyond `AddZeroClass`, and lattice rationality
needs only an additive commutative monoid `V`; salience, and hence `IsToricCone`, needs `V` to be
an additive group. Freeness and finiteness of `N`, and finite dimensionality of `V`, play no role
in the definitions or preservation results here.

## References

The mathematics is Chapter 1 of D. Cox, J. Little and H. Schenck, *Toric Varieties*, and §1.2 of
W. Fulton, *Introduction to Toric Varieties*.
-/

public section

namespace TauCeti.Toric

/-! ### Lattice rationality -/

section LatticeRational

variable {N N' V V' : Type*} [AddZeroClass N] [AddZeroClass N'] [AddCommMonoid V]
  [AddCommMonoid V'] [Module ℝ V] [Module ℝ V'] {i : N →+ V} {i' : N' →+ V'}
  {σ τ : PointedCone ℝ V}

/-- A pointed cone `σ` in `V` is *lattice rational* for the lattice map `i : N →+ V` when it is
the cone hull of the images of finitely many lattice vectors. -/
def IsLatticeRational (i : N →+ V) (σ : PointedCone ℝ V) : Prop :=
  ∃ s : Finset N, σ = PointedCone.hull ℝ (i '' (s : Set N))

/-- The characteristic property of `IsLatticeRational`: a cone is lattice rational exactly when it
is the cone hull of the images of some finite set of lattice vectors. -/
theorem isLatticeRational_iff :
    IsLatticeRational i σ ↔ ∃ s : Finset N, σ = PointedCone.hull ℝ (i '' (s : Set N)) := (Iff.rfl)

/-- The cone hull of the images of a finite set of lattice vectors is lattice rational. -/
@[simp]
theorem isLatticeRational_hull_image (i : N →+ V) (s : Finset N) :
    IsLatticeRational i (PointedCone.hull ℝ (i '' (s : Set N))) := ⟨s, rfl⟩

/-- The zero cone is lattice rational. -/
@[simp]
theorem isLatticeRational_bot (i : N →+ V) : IsLatticeRational i (⊥ : PointedCone ℝ V) :=
  ⟨∅, by simp⟩

/-- A lattice-rational cone is finitely generated. -/
theorem IsLatticeRational.fg (h : IsLatticeRational i σ) : σ.FG := by
  obtain ⟨s, rfl⟩ := h
  exact Submodule.fg_span ((s : Set N).toFinite.image i)

/-- A lattice-rational cone other than the zero cone contains a nonzero image `i v` of a lattice
vector `v`. -/
theorem IsLatticeRational.exists_mem_ne_zero (h : IsLatticeRational i σ) (hσ : σ ≠ ⊥) :
    ∃ v : N, i v ∈ σ ∧ i v ≠ 0 := by
  obtain ⟨s, rfl⟩ := h
  obtain ⟨_, ⟨v, hv, rfl⟩, hv0⟩ := not_forall₂.1 (mt Submodule.span_eq_bot.2 hσ)
  exact ⟨v, PointedCone.subset_hull ⟨v, hv, rfl⟩, hv0⟩

/-- The join of two lattice-rational cones is lattice rational. Salience is not preserved, so this
is not a statement about toric cones. -/
theorem IsLatticeRational.sup (hσ : IsLatticeRational i σ) (hτ : IsLatticeRational i τ) :
    IsLatticeRational i (σ ⊔ τ) := by
  classical
  obtain ⟨s, rfl⟩ := hσ
  obtain ⟨t, rfl⟩ := hτ
  refine ⟨s ∪ t, ?_⟩
  rw [Finset.coe_union, Set.image_union]
  exact (Submodule.span_union _ _).symm

/-- The image of a lattice-rational cone under a real-linear map compatible with a map of lattices
is lattice rational. -/
theorem IsLatticeRational.map {f : N →+ N'} {g : V →ₗ[ℝ] V'} (hfg : ∀ n, g (i n) = i' (f n))
    (hσ : IsLatticeRational i σ) : IsLatticeRational i' (PointedCone.map g σ) := by
  classical
  obtain ⟨s, rfl⟩ := hσ
  refine ⟨s.image f, ?_⟩
  simp [PointedCone.map, Submodule.map_span, Set.image_image, hfg]

/-- A product of lattice-rational cones is lattice rational for the product lattice map. -/
theorem IsLatticeRational.prod {τ' : PointedCone ℝ V'} (hσ : IsLatticeRational i σ)
    (hτ' : IsLatticeRational i' τ') :
    IsLatticeRational (i.prodMap i') (σ.prod τ') := by
  classical
  obtain ⟨s, rfl⟩ := hσ
  obtain ⟨t, rfl⟩ := hτ'
  refine ⟨s ×ˢ {0} ∪ {0} ×ˢ t, ?_⟩
  rw [← LinearMap.span_inl_union_inr]
  simp [Set.image_union, Set.image_image]

end LatticeRational

section Toric

variable {N N' V V' : Type*} [AddZeroClass N] [AddZeroClass N'] [AddCommGroup V]
  [AddCommGroup V'] [Module ℝ V] [Module ℝ V'] {i : N →+ V} {i' : N' →+ V'}
  {σ τ : PointedCone ℝ V}

/-! ### Toric cones -/

/-- A *toric cone* for the lattice map `i : N →+ V` is a lattice-rational and salient Mathlib
pointed cone. Salience says that `σ ∩ (-σ) = {0}`; it is not implied by the name `PointedCone`,
which records only that the cone contains `0`. -/
structure IsToricCone (i : N →+ V) (σ : PointedCone ℝ V) : Prop where
  /-- A toric cone is generated by the images of finitely many lattice vectors. -/
  rational : IsLatticeRational i σ
  /-- A toric cone contains no line. -/
  salient : (σ : ConvexCone ℝ V).Salient

/-- A toric cone is finitely generated over the nonnegative reals. -/
theorem IsToricCone.fg (h : IsToricCone i σ) : σ.FG := h.rational.fg

/-- The zero cone is a toric cone; it is the cone whose affine chart is the dense torus. -/
@[simp]
theorem isToricCone_bot (i : N →+ V) : IsToricCone i (⊥ : PointedCone ℝ V) :=
  ⟨isLatticeRational_bot i, fun _ hx hx0 _ ↦ hx0 hx⟩

/-- The cone generated by a single lattice vector is a toric cone. -/
@[simp]
theorem isToricCone_hull_singleton (i : N →+ V) (v : N) :
    IsToricCone i (PointedCone.hull ℝ {i v}) :=
  ⟨⟨{v}, by simp⟩, PointedCone.salient_hull_singleton (i v)⟩

/-! ### Faces -/

/-- A face of a lattice-rational cone is lattice rational: it is generated by exactly those
lattice generators of the ambient cone that lie on the face. -/
theorem IsLatticeRational.of_isFaceOf (hσ : IsLatticeRational i σ) (hτ : τ.IsFaceOf σ) :
    IsLatticeRational i τ := by
  classical
  obtain ⟨s, rfl⟩ := hσ
  refine ⟨s.filter fun v ↦ i v ∈ τ,
    (PointedCone.Face.eq_hull_inter_of_eq_hull ⟨τ, hτ⟩ _ rfl).trans ?_⟩
  rw [Finset.coe_filter, ← Set.image_inter_preimage]
  -- The face `⟨τ, hτ⟩` has by definition the same members as `τ`.
  rfl

/-- A face of a toric cone is a toric cone. Since the pairwise intersection of two cones of a fan
is a face of each of them, this also supplies the toricity of those intersections. -/
theorem IsToricCone.of_isFaceOf (hσ : IsToricCone i σ) (hτ : τ.IsFaceOf σ) : IsToricCone i τ :=
  ⟨hσ.rational.of_isFaceOf hτ, hσ.salient.anti fun _ hx ↦ hτ.le hx⟩

/-- Every element of Mathlib's face lattice of a toric cone is a toric cone. -/
theorem IsToricCone.face (hσ : IsToricCone i σ) (F : σ.Face) :
    IsToricCone i F.toPointedCone :=
  hσ.of_isFaceOf F.isFaceOf

/-! ### Maps of lattices -/

/-- An injective real-linear map compatible with a map of lattices carries toric cones to toric
cones. Injectivity is what preserves salience. -/
theorem IsToricCone.map {f : N →+ N'} {g : V →ₗ[ℝ] V'} (hfg : ∀ n, g (i n) = i' (f n))
    (hg : Function.Injective g) (hσ : IsToricCone i σ) : IsToricCone i' (PointedCone.map g σ) :=
  ⟨hσ.rational.map hfg, hσ.salient.map hg⟩

/-- Toricity is invariant along an isomorphism of lattices: transporting a cone by a linear
equivalence compatible with an isomorphism of the lattices neither creates nor destroys toric
cones. -/
theorem isToricCone_map_equiv_iff {f : N ≃+ N'} {e : V ≃ₗ[ℝ] V'}
    (hfe : ∀ n, e (i n) = i' (f n)) :
    IsToricCone i' (PointedCone.map (e : V →ₗ[ℝ] V') σ) ↔ IsToricCone i σ := by
  refine ⟨fun h ↦ ?_, fun h ↦ h.map (f := (f : N →+ N')) hfe e.injective⟩
  have hsymm : ∀ n', e.symm (i' n') = i (f.symm n') := fun n' ↦ by
    simpa using (congrArg e.symm (hfe (f.symm n'))).symm
  have hmap := h.map (f := (f.symm : N' →+ N)) (g := (e.symm : V' →ₗ[ℝ] V)) hsymm e.symm.injective
  rwa [PointedCone.map_map, e.symm_comp, PointedCone.map_id] at hmap

/-! ### Products -/

/-- A product of toric cones is a toric cone for the product lattice map. -/
theorem IsToricCone.prod {τ' : PointedCone ℝ V'} (hσ : IsToricCone i σ)
    (hτ' : IsToricCone i' τ') : IsToricCone (i.prodMap i') (σ.prod τ') :=
  ⟨hσ.rational.prod hτ'.rational, hσ.salient.prod hτ'.salient⟩

end Toric

end TauCeti.Toric
