/-!
# Integral inequalities and lattice generators

**Rational Minkowski–Weyl for cones.** A real cone is generated by finitely many lattice vectors
exactly when it is cut out by finitely many integral-character inequalities
(`TauCeti.Toric.IsIntegralLattice.isLatticeRational_iff_exists_dual_image`). Lineality is allowed,
and no salience or topological hypothesis is needed. All inequalities here are homogeneous;
arbitrary real affine offsets are not part of this statement.

Integral halfspace cuts preserve lattice generators: the opposite-sign boundary combinations of
the generators are images of actual integer combinations of the original lattice vectors. Cutting
the whole space, which is lattice rational since it is generated by a basis and its negatives, by
finitely many integral halfspaces therefore gives a lattice-rational cone. Conversely the algebraic
dual of a lattice-rational cone is lattice rational for the dual lattice
(`TauCeti.Toric.IsIntegralLattice.dual`), and the bipolar theorem for finitely generated cones
recovers the cone from its dual.

## Attribution

Adapted from `Mei/Geometry/Toric/Algebraic/Cone/RationalDuality.lean` in Mei at commit
`3d2e9c869ee44c41ae9c7b5c6e2042898430d0ca`. Original copyright and author credit are retained.

Source: https://github.com/yuma-mizuno-lean/Mei/blob/3d2e9c869ee44c41ae9c7b5c6e2042898430d0ca/Mei/Geometry/Toric/Algebraic/Cone/RationalDuality.lean
-/

public section

namespace TauCeti.Toric

open scoped Pointwise

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {C : PointedCone ℝ V}

/-- A finite generating set contained in the image of the lattice generates a lattice-rational
cone. -/
theorem isLatticeRational_hull_of_forall_mem_range (s : Finset V)
    (hs : ∀ x ∈ s, ∃ n : N, i n = x) :
    IsLatticeRational i (PointedCone.hull ℝ (s : Set V)) := by
  classical
  have hs' : (s : Set V) ⊆ i '' (Set.univ : Set N) := by
    intro x hx
    obtain ⟨n, hn⟩ := hs x hx
    exact ⟨n, Set.mem_univ _, hn⟩
  obtain ⟨t, -, ht⟩ := Finset.subset_set_image_iff.mp hs'
  exact isLatticeRational_iff.mpr ⟨t, by rw [← Finset.coe_image, ht]⟩

/-- Cutting a lattice-rational cone by an integral-character halfspace keeps an actual finite
family of lattice generators, with lineality allowed. -/
theorem IsLatticeRational.inf_dual_singleton_realCharacter (hC : IsLatticeRational i C)
    (h : IsIntegralLattice i) (m : N →+ ℤ) :
    IsLatticeRational i (C ⊓ PointedCone.dual
      (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V) {h.realCharacter m}) := by
  classical
  obtain ⟨s, rfl⟩ := isLatticeRational_iff.mp hC
  rw [← Finset.coe_image, ← Finset.hull_halfspaceGenerators]
  apply isLatticeRational_hull_of_forall_mem_range
  intro x hx
  rcases Finset.mem_halfspaceGenerators_iff.mp hx with ⟨hx, _⟩ | ⟨u, hu, v, hv, _, _, rfl⟩
  · obtain ⟨n, _, rfl⟩ := Finset.mem_image.mp hx
    exact ⟨n, rfl⟩
  · obtain ⟨u, _, rfl⟩ := Finset.mem_image.mp hu
    obtain ⟨v, _, rfl⟩ := Finset.mem_image.mp hv
    refine ⟨(-m v) • u + m u • v, ?_⟩
    simp only [map_add, map_zsmul, LinearMap.boundaryCombination_def,
      h.realCharacter_apply, ← Int.cast_neg, Int.cast_smul_eq_zsmul]

/-- The whole space is generated as a cone by the images of a finite integral basis and its
negatives. -/
theorem IsIntegralLattice.isLatticeRational_top (h : IsIntegralLattice i) :
    IsLatticeRational i (⊤ : PointedCone ℝ V) := by
  classical
  let _ := h.free
  let _ := h.finite
  let b := Module.Free.chooseBasis ℤ N
  let B := h.isBaseChange.basis b
  let t : Finset N := Finset.univ.image b ∪ Finset.univ.image (fun j => -b j)
  have hB (j) : B j = i (b j) := by
    simpa only [B, AddMonoidHom.coe_toIntLinearMap] using h.isBaseChange.basis_apply b j
  have ht : i '' (t : Set N) = -Set.range B ∪ Set.range B := by
    simp only [t, Finset.coe_union, Finset.coe_image, Finset.coe_univ, Set.image_union,
      Set.image_image, map_neg, ← hB]
    simp only [Set.image_univ, Set.neg_range, Set.union_comm]
  apply isLatticeRational_iff.mpr
  refine ⟨t, ?_⟩
  rw [ht]
  calc
    ⊤ = (Submodule.span ℝ (Set.range B) : PointedCone ℝ V) := by
      rw [B.span_eq, PointedCone.ofSubmodule, Submodule.restrictScalars_top]
    _ = PointedCone.hull ℝ (-Set.range B) ⊔ PointedCone.hull ℝ (Set.range B) :=
      PointedCone.span_eq_hull_neg_sup_hull ℝ _
    _ = PointedCone.hull ℝ (-Set.range B ∪ Set.range B) := (Submodule.span_union _ _).symm

/-- A finite family of integral-character inequalities defines a lattice-rational cone. -/
theorem IsIntegralLattice.isLatticeRational_dual_image (h : IsIntegralLattice i)
    (s : Finset (N →+ ℤ)) :
    IsLatticeRational i (PointedCone.dual
      (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
      (h.realCharacter '' (s : Set (N →+ ℤ)))) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using h.isLatticeRational_top
  | @insert m s hm ih =>
    rw [Finset.coe_insert, Set.image_insert_eq, PointedCone.dual_insert, inf_comm]
    exact ih.inf_dual_singleton_realCharacter h m

/-- The algebraic dual of a lattice-rational cone is lattice rational for the dual lattice. Its
defining cuts are evaluations at lattice generators. -/
theorem IsLatticeRational.dual (hC : IsLatticeRational i C) (h : IsIntegralLattice i) :
    IsLatticeRational h.realCharacter (PointedCone.dual (Module.Dual.eval ℝ V) C) := by
  classical
  obtain ⟨s, rfl⟩ := isLatticeRational_iff.mp hC
  let t : Finset ((N →+ ℤ) →+ ℤ) := s.image (fun n => AddMonoidHom.eval n)
  have he : PointedCone.dual (Module.Dual.eval ℝ V)
      (PointedCone.hull ℝ (i '' (s : Set N))) =
      PointedCone.dual
        (LinearMap.id : Module.Dual ℝ (Module.Dual ℝ V) →ₗ[ℝ] Module.Dual ℝ (Module.Dual ℝ V))
        (h.dual.realCharacter '' (t : Set ((N →+ ℤ) →+ ℤ))) := by
    ext f
    simp [t, PointedCone.dual_hull, PointedCone.mem_dual, h.dual_realCharacter_eval]
  rw [he]
  exact h.dual.isLatticeRational_dual_image t

/-- **Rational Minkowski–Weyl for cones:** a cone is generated by finitely many lattice vectors
exactly when it is cut out by finitely many integral-character inequalities. No salience is
required. -/
theorem IsIntegralLattice.isLatticeRational_iff_exists_dual_image (h : IsIntegralLattice i) :
    IsLatticeRational i C ↔ ∃ s : Finset (N →+ ℤ),
      C = PointedCone.dual (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
        (h.realCharacter '' (s : Set (N →+ ℤ))) := by
  constructor
  · intro hC
    obtain ⟨s, hs⟩ := isLatticeRational_iff.mp (hC.dual h)
    have heval : (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V).flip =
        Module.Dual.eval ℝ V := by
      ext x f
      rfl
    have hbip := hC.fg.cone_dual_dual_flip_id
    rw [heval, hs, PointedCone.dual_hull] at hbip
    exact ⟨s, hbip.symm⟩
  · rintro ⟨s, rfl⟩
    exact h.isLatticeRational_dual_image s

/-- A rational halfspace through the origin is lattice rational, with no salience assumption. -/
theorem IsRationalFunctional.isLatticeRational_dual_singleton {h : IsIntegralLattice i}
    {f : Module.Dual ℝ V} (hf : IsRationalFunctional h f) :
    IsLatticeRational i (PointedCone.dual
      (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V) {f}) := by
  obtain ⟨q, m, rfl⟩ := IsRationalFunctional.iff_exists_character.mp hf
  rcases lt_trichotomy q 0 with hq | rfl | hq
  · have hneg : (q : ℝ) < 0 := by exact_mod_cast hq
    have heq : PointedCone.dual
        (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
        {(q : ℝ) • h.realCharacter m.toAddMonoidHom} =
        PointedCone.dual
          (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
          {h.realCharacter (-m.toAddMonoidHom)} := by
      ext x
      simp only [PointedCone.mem_dual, Set.mem_singleton_iff, forall_eq,
        LinearMap.id_apply, LinearMap.smul_apply, smul_eq_mul, map_neg,
        LinearMap.neg_apply]
      constructor <;> intro hx <;> nlinarith
    rw [heq]
    simpa using h.isLatticeRational_dual_image {-m.toAddMonoidHom}
  · simpa using h.isLatticeRational_top
  · have hpos : (0 : ℝ) < q := by exact_mod_cast hq
    have heq : PointedCone.dual
        (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
        {(q : ℝ) • h.realCharacter m.toAddMonoidHom} =
        PointedCone.dual
          (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
          {h.realCharacter m.toAddMonoidHom} := by
      ext x
      simp [mul_nonneg_iff_of_pos_left hpos]
    rw [heq]
    simpa using h.isLatticeRational_dual_image {m.toAddMonoidHom}

/-- A finite family of rational functionals cuts out a lattice-rational cone. -/
theorem IsIntegralLattice.isLatticeRational_dual_of_isRationalFunctional (h : IsIntegralLattice i)
    (s : Finset (Module.Dual ℝ V)) (hs : ∀ f ∈ s, IsRationalFunctional h f) :
    IsLatticeRational i (PointedCone.dual
      (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V) (s : Set (Module.Dual ℝ V))) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using h.isLatticeRational_top
  | @insert f s hf ih =>
    rw [Finset.coe_insert, PointedCone.dual_insert]
    exact IsLatticeRational.inf h.isBaseChange.equiv.injective
      (hs f (Finset.mem_insert_self f s)).isLatticeRational_dual_singleton
      (ih fun g hg => hs g (Finset.mem_insert_of_mem hg))

end TauCeti.Toric
