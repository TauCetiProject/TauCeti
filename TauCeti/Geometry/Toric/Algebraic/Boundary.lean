/-!
# The boundary of a regular toric chart over an arbitrary coefficient ring

A regular affine toric chart over a commutative ring `R` has coordinate ring
`R[x_1, …, x_r, y_1^{±1}, …, y_s^{±1}]`, the monoid algebra of `ℕ^r × ℤ^s`. Here it is the
additive monoid algebra `R[(ι →₀ ℕ) × G]`, with `ι` a finite type indexing the boundary
coordinates `x_i` and `G` an arbitrary additive commutative monoid of torus directions; the chart
is the case `G = κ →₀ ℤ`. The boundary divisors are the closed subschemes `x_i = 0`. Their
scheme-theoretic union is cut out by the intersection of their ideals, and this file shows that it
is the principal ideal generated by the monomial `t = x_1 ⋯ x_r`:

* a coefficient family lies in `(t)` exactly when it vanishes at every exponent with some
  `a_i = 0`, and a monomial is divisible by every `x_i` exactly when it is a multiple of `t`;
* the quotient `R[(ι →₀ ℕ) × G] ⧸ (t)` is a free `R`-module with basis the classes of the
  monomials `x^a y^b` with some `a_i = 0`, hence flat over `R`;
* the ideal `(t)` and this basis are compatible with every change of coefficients `R →+* S`, with
  no flatness or injectivity hypothesis, so nilpotent coefficients survive in the quotient;
* multiplication by `t` is injective, whatever `G` is;
* over a domain, and when `G` has unique sums (for instance `G = κ →₀ ℤ`), each `(x_i)` is prime
  and `(t)` is radical, so the boundary is reduced. Over a field this says that the boundary has
  reduced geometric fibres; over a nonreduced `R` the boundary itself is not reduced.

When `ι` is empty, `t = 1` and the boundary is empty. The intersection of the boundary divisors
indexed by a set `J` has the different ideal `(x_j : j ∈ J)`; only the union is treated here.

## Main declarations

* `TauCeti.Toric.boundaryCoordinate` and `TauCeti.Toric.boundaryMonomial`: the coordinates `x_i`
  and their product `t`, with `TauCeti.Toric.prod_boundaryCoordinate`.
* `TauCeti.Toric.mem_span_boundaryMonomial_iff` and
  `TauCeti.Toric.mem_span_boundaryCoordinate_iff`: membership in `(t)` and `(x_i)` by coefficients.
* `TauCeti.Toric.iInf_span_boundaryCoordinate`: the union of the boundary divisors is cut out
  by `t`.
* `TauCeti.Toric.boundaryMonomial_mem_nonZeroDivisors`: multiplication by `t` is injective.
* `TauCeti.Toric.boundaryQuotientBasis`: the monomial basis of the boundary quotient, with the
  `Module.Free` instance, and `TauCeti.Toric.boundaryQuotientBasis_repr_quotientMap` for its
  naturality in the coefficients.
* `TauCeti.Toric.map_span_boundaryMonomial`: the boundary ideal commutes with coefficient change.
* `TauCeti.Toric.isPrime_span_boundaryCoordinate`, `TauCeti.Toric.isRadical_span_boundaryMonomial`
  and the `IsReduced` instance on the boundary quotient over a domain.

## References

* M. Dimitrov, *Compactifications arithmétiques des variétés de Hilbert et formes modulaires de
  Hilbert pour Γ₁(c, n)*, in *Geometric Aspects of Dwork Theory*, de Gruyter, 2004, §2.
* K.-W. Lan, *Arithmetic Compactifications of PEL-Type Shimura Varieties*, London Mathematical
  Society Monographs 36, Princeton University Press, 2013, Theorem 6.1.2.8(5).
-/

public section

open AddMonoidAlgebra

namespace TauCeti.Toric

variable (R : Type*) {ι : Type*} (G : Type*)

section Semiring

variable [Semiring R] [AddMonoid G]

/-- The boundary coordinate `x_i` of the regular chart `R[(ι →₀ ℕ) × G]`: the coefficient-one
monomial with exponent `(eᵢ, 0)`. -/
noncomputable def boundaryCoordinate (i : ι) : AddMonoidAlgebra R ((ι →₀ ℕ) × G) :=
  single (Finsupp.single i 1, 0) 1

variable {R G} in
/-- An element lies in the ideal of the boundary divisor `x_i = 0` exactly when its coefficients
vanish at every exponent whose `i`-th boundary entry is `0`. -/
theorem mem_span_boundaryCoordinate_iff {p : AddMonoidAlgebra R ((ι →₀ ℕ) × G)} (i : ι) :
    p ∈ Ideal.span {boundaryCoordinate R G i} ↔ ∀ m : (ι →₀ ℕ) × G, m.1 i = 0 → p.coeff m = 0 := by
  rw [boundaryCoordinate, ← of'_apply, ← Set.image_singleton, mem_ideal_span_of'_image]
  simp only [Set.mem_singleton_iff, exists_eq_left, Finsupp.mem_support_iff]
  refine ⟨fun h m hm ↦ by_contra fun hp ↦ ?_, fun h m hm ↦ ?_⟩
  · obtain ⟨d, rfl⟩ := h m hp
    simp at hm
  · refine ⟨(m.1 - Finsupp.single i 1, m.2), Prod.ext ?_ (add_zero _).symm⟩
    have hmi : m.1 i ≠ 0 := fun h' ↦ hm (h m h')
    exact (tsub_add_cancel_of_le
      (Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr hmi))).symm

variable (ι) [Finite ι]

/-- The product `t = x_1 ⋯ x_r` of the boundary coordinates of the regular chart
`R[(ι →₀ ℕ) × G]`: the coefficient-one monomial with exponent `(1, …, 1; 0)`. It cuts out the
union of the boundary divisors. -/
noncomputable def boundaryMonomial : AddMonoidAlgebra R ((ι →₀ ℕ) × G) :=
  single (Finsupp.equivFunOnFinite.symm 1, 0) 1

variable {R ι G}

/-- Without boundary coordinates the boundary monomial is `1`, so the boundary is empty. -/
@[simp]
theorem boundaryMonomial_of_isEmpty [IsEmpty ι] : boundaryMonomial R ι G = 1 := by
  rw [boundaryMonomial, one_def, Prod.zero_eq_mk,
    Subsingleton.elim (Finsupp.equivFunOnFinite.symm 1 : ι →₀ ℕ) 0]

/-- An exponent is a translate of `(1, …, 1; 0)` exactly when all of its boundary entries are
nonzero. -/
private theorem exists_eq_add_iff (m : (ι →₀ ℕ) × G) :
    (∃ d, m = d + (Finsupp.equivFunOnFinite.symm 1, 0)) ↔ ∀ i, m.1 i ≠ 0 := by
  refine ⟨?_, fun h ↦ ⟨(m.1 - Finsupp.equivFunOnFinite.symm 1, m.2), ?_⟩⟩
  · rintro ⟨d, rfl⟩ i
    simp
  · refine Prod.ext ?_ (add_zero _).symm
    ext i
    simpa using (Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr (h i))).symm

/-- An element lies in the ideal `(t)` of the union of the boundary divisors exactly when its
coefficients vanish at every exponent with some boundary entry equal to `0`. -/
theorem mem_span_boundaryMonomial_iff {p : AddMonoidAlgebra R ((ι →₀ ℕ) × G)} :
    p ∈ Ideal.span {boundaryMonomial R ι G} ↔ ∀ m, (∃ i, m.1 i = 0) → p.coeff m = 0 := by
  rw [boundaryMonomial, ← of'_apply, ← Set.image_singleton, mem_ideal_span_of'_image]
  simp only [Set.mem_singleton_iff, exists_eq_left, exists_eq_add_iff, Finsupp.mem_support_iff]
  exact ⟨fun h m ⟨i, hi⟩ ↦ by_contra fun hp ↦ h m hp i hi, fun h m hp i hi ↦ hp (h m ⟨i, hi⟩)⟩

/-- **The union of the boundary divisors.** The intersection of the ideals `(x_i)` of the boundary
divisors is the principal ideal generated by `t = x_1 ⋯ x_r`: a monomial is divisible by every
`x_i` exactly when it is a multiple of `t`. -/
theorem iInf_span_boundaryCoordinate :
    ⨅ i, Ideal.span {boundaryCoordinate R G i} = Ideal.span {boundaryMonomial R ι G} := by
  ext p
  simp only [Submodule.mem_iInf, mem_span_boundaryCoordinate_iff, mem_span_boundaryMonomial_iff]
  exact ⟨fun h m ⟨i, hi⟩ ↦ h i m hi, fun h i m hi ↦ h m ⟨i, hi⟩⟩

/-- Multiplication by the boundary monomial `t` is injective, on either side: `t` is a
non-zero-divisor. No cancellativity of `G` is needed, since `t` has torus exponent `0`. -/
theorem boundaryMonomial_mem_nonZeroDivisors :
    boundaryMonomial R ι G ∈ nonZeroDivisors (AddMonoidAlgebra R ((ι →₀ ℕ) × G)) := by
  have he (m m' : (ι →₀ ℕ) × G) :
      m' + (Finsupp.equivFunOnFinite.symm 1, 0) = m + (Finsupp.equivFunOnFinite.symm 1, 0) ↔
        m' = m := by
    simp [Prod.ext_iff]
  have he' (m m' : (ι →₀ ℕ) × G) :
      (Finsupp.equivFunOnFinite.symm 1, 0) + m' = (Finsupp.equivFunOnFinite.symm 1, 0) + m ↔
        m' = m := by
    simp [Prod.ext_iff]
  refine mem_nonZeroDivisors_iff.mpr ⟨fun f hf ↦ ?_, fun f hf ↦ ?_⟩
  · ext m
    have h := congr(($hf).coeff ((Finsupp.equivFunOnFinite.symm 1, 0) + m))
    rwa [boundaryMonomial, coeff_single_mul_eq_mul_coeff m fun m' _ ↦ he' m m', one_mul,
      coeff_zero, Finsupp.coe_zero, Pi.zero_apply] at h
  · ext m
    have h := congr(($hf).coeff (m + (Finsupp.equivFunOnFinite.symm 1, 0)))
    rwa [boundaryMonomial, coeff_mul_single_eq_coeff_mul m fun m' _ ↦ he m m', mul_one,
      coeff_zero, Finsupp.coe_zero, Pi.zero_apply] at h

/-- Changing the coefficients along any ring homomorphism extends the boundary ideal `(t)` over
`R` to the boundary ideal over `S`. -/
@[simp]
theorem map_span_boundaryMonomial {S : Type*} [Semiring S] (φ : R →+* S) :
    (Ideal.span {boundaryMonomial R ι G}).map (mapRingHom _ φ) =
      Ideal.span {boundaryMonomial S ι G} := by
  simp [Ideal.map_span, boundaryMonomial]

/-- Changing the coefficients maps the boundary ideal over `R` into the boundary ideal over `S`. -/
theorem span_boundaryMonomial_le_comap_mapRingHom {S : Type*} [Semiring S] (φ : R →+* S) :
    Ideal.span {boundaryMonomial R ι G} ≤
      (Ideal.span {boundaryMonomial S ι G}).comap (mapRingHom ((ι →₀ ℕ) × G) φ) :=
  Ideal.map_le_iff_le_comap.mp (map_span_boundaryMonomial φ).le

end Semiring

section CommSemiring

variable {R G} [CommSemiring R] [AddCommMonoid G]

/-- The boundary monomial is the product of the boundary coordinates. -/
theorem prod_boundaryCoordinate [Fintype ι] :
    ∏ i, boundaryCoordinate R G i = boundaryMonomial R ι G := by
  simp only [boundaryCoordinate, boundaryMonomial, prod_single, Finset.prod_const_one]
  congr
  ext j
  · simp [Prod.fst_sum, Finsupp.finsetSum_apply]
  · simp [Prod.snd_sum]

end CommSemiring

section Prime

variable {R G} [CommSemiring R] [AddCommMonoid G] [NoZeroDivisors R] [Nontrivial R] [UniqueSums G]

/-- Over a coefficient semiring without zero divisors, and when `G` has unique sums (for instance
a lattice `κ →₀ ℤ`), each boundary divisor `x_i = 0` is integral: its ideal is prime. -/
theorem isPrime_span_boundaryCoordinate (i : ι) :
    (Ideal.span {boundaryCoordinate R G i}).IsPrime := by
  let F : AddSubmonoid ((ι →₀ ℕ) × G) :=
    AddMonoidHom.mker ((Finsupp.applyAddHom i).comp (AddMonoidHom.fst _ _))
  have hF : F.AddSaturated := fun x y hxy ↦ by
    simpa [F, AddMonoidHom.mem_mker] using hxy
  have : UniqueSums F :=
    UniqueSums.of_injective_addHom F.subtype.toAddHom Subtype.val_injective inferInstance
  have h : Ideal.span {boundaryCoordinate R G i} = F.faceIdeal R := by
    ext p
    rw [mem_span_boundaryCoordinate_iff, F.mem_faceIdeal_iff hF]
    exact ⟨fun h m ↦ h m m.property, fun h m hm ↦ h ⟨m, hm⟩⟩
  rw [h]
  exact F.faceIdeal_isPrime hF

end Prime

section Radical

variable {R G} [CommSemiring R] [AddCommMonoid G] [NoZeroDivisors R] [UniqueSums G] [Finite ι]

/-- Over a coefficient semiring without zero divisors, and when `G` has unique sums, the ideal
`(t)` of the union of the boundary divisors is radical. -/
theorem isRadical_span_boundaryMonomial :
    (Ideal.span {boundaryMonomial R ι G}).IsRadical := by
  -- Over the zero ring every ideal is radical, so the nontriviality needed for primality of the
  -- boundary divisors is not needed here.
  rcases subsingleton_or_nontrivial R with hR | hR
  · intro x _
    rw [Subsingleton.elim x 0]
    exact zero_mem _
  rw [← iInf_span_boundaryCoordinate]
  exact Ideal.isRadical_iInf _ fun i ↦ (isPrime_span_boundaryCoordinate i).isRadical

end Radical

section CommRing

variable [CommRing R] [AddCommMonoid G] (ι) [Finite ι]

/-- The ideal `(t)` is the monomial ideal of the exponents whose boundary entries are all
nonzero. -/
private theorem span_boundaryMonomial_eq :
    Ideal.span {boundaryMonomial R ι G} =
      Ideal.span (of' R _ '' {m : (ι →₀ ℕ) × G | ∀ i, m.1 i ≠ 0}) := by
  ext p
  rw [mem_span_boundaryMonomial_iff,
    mem_ideal_span_of'_image_iff fun d m hm i ↦ by simpa using fun _ ↦ hm i]
  simp

/-- **The integral toric boundary is free.** The quotient of the regular chart
`R[(ι →₀ ℕ) × G]` by the boundary ideal `(t)` is a free `R`-module, with basis the classes of the
monomials `x^a y^b` with some `a_i = 0`. -/
noncomputable def boundaryQuotientBasis :
    Module.Basis {m : (ι →₀ ℕ) × G // ∃ i, m.1 i = 0} R
      (AddMonoidAlgebra R ((ι →₀ ℕ) × G) ⧸ Ideal.span {boundaryMonomial R ι G}) :=
  ((quotientSpanOf'ImageBasis R fun d m hm i ↦ by simpa using fun _ ↦ hm i).map
      (Ideal.quotientEquivAlgOfEq R (span_boundaryMonomial_eq R ι G).symm).toLinearEquiv).reindex
    (Equiv.subtypeEquivRight fun m ↦ by simp)

variable {R ι G}

/-- The basis vector of the boundary quotient indexed by `m` is the class of the monomial
`x^a y^b` with exponent `m`. -/
@[simp]
theorem boundaryQuotientBasis_apply (m : {m : (ι →₀ ℕ) × G // ∃ i, m.1 i = 0}) :
    boundaryQuotientBasis R ι G m =
      Ideal.Quotient.mk (Ideal.span {boundaryMonomial R ι G}) (single (m : (ι →₀ ℕ) × G) 1) := by
  simp [boundaryQuotientBasis]

/-- The coordinates of the class of `p` in the monomial basis of the boundary quotient are the
coefficients of `p`. -/
@[simp]
theorem boundaryQuotientBasis_repr_mk (p : AddMonoidAlgebra R ((ι →₀ ℕ) × G))
    (m : {m : (ι →₀ ℕ) × G // ∃ i, m.1 i = 0}) :
    (boundaryQuotientBasis R ι G).repr (Ideal.Quotient.mk _ p) m = p.coeff m := by
  simp [boundaryQuotientBasis]

/-- The coordinate ring of the boundary of a regular chart is a free, hence flat,
`R`-module. -/
instance : Module.Free R
    (AddMonoidAlgebra R ((ι →₀ ℕ) × G) ⧸ Ideal.span {boundaryMonomial R ι G}) :=
  .of_basis (boundaryQuotientBasis R ι G)

/-- The formation of the boundary commutes with changing the coefficients: the map of boundary
quotients induced by `R →+* S` acts on the monomial coordinates coefficientwise. -/
@[simp]
theorem boundaryQuotientBasis_repr_quotientMap {S : Type*} [CommRing S] (φ : R →+* S)
    (x : AddMonoidAlgebra R ((ι →₀ ℕ) × G) ⧸ Ideal.span {boundaryMonomial R ι G}) :
    (boundaryQuotientBasis S ι G).repr (Ideal.quotientMap _ (mapRingHom ((ι →₀ ℕ) × G) φ)
        (span_boundaryMonomial_le_comap_mapRingHom φ) x) =
      Finsupp.mapRange φ φ.map_zero ((boundaryQuotientBasis R ι G).repr x) := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  ext m
  simp

/-- Over a coefficient ring without zero divisors, and when `G` has unique sums, the boundary of a
regular chart is reduced. Over a field this is reducedness of the geometric fibres of the
boundary. -/
instance [NoZeroDivisors R] [UniqueSums G] :
    IsReduced (AddMonoidAlgebra R ((ι →₀ ℕ) × G) ⧸ Ideal.span {boundaryMonomial R ι G}) :=
  (Ideal.isRadical_iff_quotient_reduced _).mp isRadical_span_boundaryMonomial

end CommRing

end TauCeti.Toric
