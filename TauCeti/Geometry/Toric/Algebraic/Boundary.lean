/-!
# The integral boundary of a regular toric chart

The coordinate ring of the affine toric chart of a regular cone with `r` rays is the monoid
algebra `R[(ι →₀ ℕ) × Q]`, with `ι` the set of rays and `Q` the torus directions, so that
`Q = κ →₀ ℤ` gives `R[x_1, …, x_r, y_1^{±1}, …, y_s^{±1}]`. The boundary divisors of the chart
are the coordinate hyperplanes `x_i = 0`. This file describes, over an arbitrary commutative
coefficient ring `R` (possibly zero or nonreduced), the closed subschemes cut out by their union
and by their partial intersections.

* The scheme-theoretic union of the boundary divisors has ideal `⨅ i, (x_i)`, and this is the
  principal ideal generated by `t = x_1 ⋯ x_r`
  (`TauCeti.Toric.iInf_span_boundaryCoordinate`): a polynomial lies in it exactly when its
  coefficients vanish at every exponent with some `a_i = 0`.
* The monomial `t` is a nonzerodivisor (`TauCeti.Toric.isRegular_boundaryMonomial`).
* The quotient by `(t)` is a free `R`-module whose basis is the classes of the monomials
  `x^a y^b` with some `a_i = 0` (`TauCeti.Toric.boundaryQuotientBasis`). In particular the
  boundary is flat over `R`.
* The ideal `(t)` is compatible with every change of coefficients
  (`TauCeti.Toric.map_span_boundaryMonomial`), with no flatness hypothesis.
* The intersection of the divisors indexed by `J ⊆ ι` has ideal `(x_j : j ∈ J)`, which is the
  monomial ideal of the face of exponents vanishing on `J`
  (`TauCeti.Toric.span_boundaryCoordinate_image`). Over a domain, when `Q` has unique sums, it is
  prime; consequently `(t)` is a radical ideal over every reduced coefficient ring
  (`TauCeti.Toric.isRadical_span_boundaryMonomial`). In particular, the boundary over any field
  is reduced.

The union ideal `(t)` and the intersection ideals `(x_j : j ∈ J)` are different ideals, and
neither is replaced by its radical. These are the coordinate descriptions of the boundary used by
the boundary ideal and the completed charts of toroidal compactifications.

## References

* M. Dimitrov, *Compactifications arithmétiques des variétés de Hilbert et formes modulaires de
  Hilbert pour Γ₁(c, n)*, in *Geometric Aspects of Dwork Theory*, de Gruyter, 2004, §2.
* K.-W. Lan, *Arithmetic Compactifications of PEL-Type Shimura Varieties*, London Mathematical
  Society Monographs 36, Princeton University Press, 2013, Theorem 6.1.2.8.
-/

public section

namespace TauCeti.Toric

open AddMonoidAlgebra

section Coordinate

variable (R : Type*) [CommSemiring R] {ι : Type*} (Q : Type*) [AddCommMonoid Q]

/-- The boundary coordinate `x_i` of the regular chart `R[(ι →₀ ℕ) × Q]`: the monomial whose
exponent is the `i`-th standard basis vector in the ray directions and zero in the torus
directions. Its zero locus is the `i`-th boundary divisor. -/
noncomputable def boundaryCoordinate (i : ι) : AddMonoidAlgebra R ((ι →₀ ℕ) × Q) :=
  single (Finsupp.single i 1, 0) 1

theorem boundaryCoordinate_def (i : ι) :
    boundaryCoordinate R Q i = single (Finsupp.single i 1, 0) 1 := (rfl)

/-- The face of exponents vanishing in every ray direction indexed by `J`. Its monomial ideal is
the ideal of the intersection of the boundary divisors indexed by `J`. -/
def boundaryFace (J : Set ι) : AddSubmonoid ((ι →₀ ℕ) × Q) where
  carrier := {p | ∀ j ∈ J, p.1 j = 0}
  add_mem' ha hb j hj := by simp [ha j hj, hb j hj]
  zero_mem' := by simp

variable {Q} in
@[simp]
theorem mem_boundaryFace_iff {J : Set ι} {p : (ι →₀ ℕ) × Q} :
    p ∈ boundaryFace Q J ↔ ∀ j ∈ J, p.1 j = 0 := Iff.rfl

/-- The exponents vanishing on `J` form a face: a sum vanishes on `J` only if both summands do. -/
theorem addSaturated_boundaryFace (J : Set ι) : (boundaryFace Q J).AddSaturated := by
  intro a b hab
  have h j (hj : j ∈ J) : a.1 j = 0 ∧ b.1 j = 0 := by
    simpa using hab j hj
  exact ⟨fun j hj ↦ (h j hj).1, fun j hj ↦ (h j hj).2⟩

variable {R Q}

/-- A polynomial lies in the ideal of the boundary divisors indexed by `J` exactly when its
coefficients vanish at every exponent vanishing on `J`. -/
theorem mem_span_boundaryCoordinate_image_iff {J : Set ι}
    {f : AddMonoidAlgebra R ((ι →₀ ℕ) × Q)} :
    f ∈ Ideal.span (boundaryCoordinate R Q '' J) ↔
      ∀ p : (ι →₀ ℕ) × Q, (∀ j ∈ J, p.1 j = 0) → f.coeff p = 0 := by
  have himage : boundaryCoordinate R Q '' J =
      of' R ((ι →₀ ℕ) × Q) '' ((·, (0 : Q)) '' ((Finsupp.single · 1) '' J)) := by
    simp only [Set.image_image, boundaryCoordinate_def, of'_apply]
  rw [himage, mem_ideal_span_of'_inl_image_iff]
  simp [Finsupp.single_le_iff, Nat.one_le_iff_ne_zero]

/-- The ideal generated by the boundary coordinates indexed by `J` is the monomial ideal of the
face of exponents vanishing on `J`. The quotient by it is therefore the monoid algebra of that
face (`AddSubmonoid.faceQuotientEquiv`), the coordinate ring of the intersection of the
boundary divisors indexed by `J`. -/
theorem span_boundaryCoordinate_image (J : Set ι) :
    Ideal.span (boundaryCoordinate R Q '' J) = (boundaryFace Q J).faceIdeal R := by
  ext f
  rw [mem_span_boundaryCoordinate_image_iff,
    (boundaryFace Q J).mem_faceIdeal_iff (addSaturated_boundaryFace Q J)]
  exact ⟨fun h p ↦ h p p.property, fun h p hp ↦ h ⟨p, hp⟩⟩

/-- A polynomial lies in the ideal of the `i`-th boundary divisor exactly when its coefficients
vanish at every exponent with `a_i = 0`. -/
theorem mem_span_boundaryCoordinate_iff {i : ι} {f : AddMonoidAlgebra R ((ι →₀ ℕ) × Q)} :
    f ∈ Ideal.span {boundaryCoordinate R Q i} ↔
      ∀ p : (ι →₀ ℕ) × Q, p.1 i = 0 → f.coeff p = 0 := by
  rw [← Set.image_singleton, mem_span_boundaryCoordinate_image_iff]
  simp

/-- Coefficient change sends boundary coordinates to boundary coordinates. -/
@[simp]
theorem mapRingHom_boundaryCoordinate {S : Type*} [CommSemiring S] (φ : R →+* S) (i : ι) :
    mapRingHom _ φ (boundaryCoordinate R Q i) = boundaryCoordinate S Q i := by
  simp [boundaryCoordinate]

end Coordinate

section Monomial

variable (R : Type*) [CommSemiring R] (ι : Type*) [Fintype ι] (Q : Type*) [AddCommMonoid Q]

/-- The boundary monomial `t = x_1 ⋯ x_r` of the regular chart `R[(ι →₀ ℕ) × Q]`. It cuts out the
union of the boundary divisors (`TauCeti.Toric.iInf_span_boundaryCoordinate`). -/
noncomputable def boundaryMonomial : AddMonoidAlgebra R ((ι →₀ ℕ) × Q) :=
  ∏ i, boundaryCoordinate R Q i

theorem boundaryMonomial_def : boundaryMonomial R ι Q = ∏ i, boundaryCoordinate R Q i := (rfl)

/-- The boundary monomial is the monomial whose exponent is `1` in every ray direction and `0`
in the torus directions. -/
theorem boundaryMonomial_eq_single :
    boundaryMonomial R ι Q = single (∑ i, Finsupp.single i 1, 0) 1 := by
  rw [boundaryMonomial_def]
  simp only [boundaryCoordinate_def]
  rw [prod_single, Finset.prod_const_one]
  congr 1
  ext <;> simp [Prod.fst_sum, Prod.snd_sum]

variable {R ι Q}

/-- A polynomial lies in the ideal generated by the boundary monomial exactly when its
coefficients vanish at every exponent with some `a_i = 0`. -/
theorem mem_span_boundaryMonomial_iff {f : AddMonoidAlgebra R ((ι →₀ ℕ) × Q)} :
    f ∈ Ideal.span {boundaryMonomial R ι Q} ↔
      ∀ (p : (ι →₀ ℕ) × Q) (i : ι), p.1 i = 0 → f.coeff p = 0 := by
  have hsingleton : {boundaryMonomial R ι Q} =
      of' R ((ι →₀ ℕ) × Q) '' ((·, (0 : Q)) '' {∑ i, Finsupp.single i 1}) := by
    simp only [Set.image_singleton, boundaryMonomial_eq_single, of'_apply]
  rw [hsingleton, mem_ideal_span_of'_inl_image_iff]
  simp [Finsupp.le_def, Finsupp.finsetSum_apply]

/-- The scheme-theoretic union of the boundary divisors of a regular chart is cut out by the
boundary monomial: the intersection of the ideals `(x_i)` is the principal ideal `(x_1 ⋯ x_r)`.
For `ι` empty both sides are the unit ideal. -/
theorem iInf_span_boundaryCoordinate :
    ⨅ i, Ideal.span {boundaryCoordinate R Q i} = Ideal.span {boundaryMonomial R ι Q} := by
  ext f
  simp only [Submodule.mem_iInf, mem_span_boundaryCoordinate_iff, mem_span_boundaryMonomial_iff]
  exact forall_comm

/-- As an `R`-module, the ideal generated by the boundary monomial is spanned by the monomials
divisible by every boundary coordinate. -/
theorem restrictScalars_span_boundaryMonomial :
    (Ideal.span {boundaryMonomial R ι Q}).restrictScalars R =
      AddMonoidAlgebra.supported R R {p : (ι →₀ ℕ) × Q | ∀ i, p.1 i ≠ 0} := by
  ext f
  rw [Submodule.restrictScalars_mem, mem_span_boundaryMonomial_iff, mem_supported']
  simp only [Set.mem_ofPred_eq, not_forall, not_not, forall_exists_index]

/-- A monomial is a multiple of the boundary monomial exactly when it is zero or divisible by
every boundary coordinate. -/
theorem single_mem_span_boundaryMonomial_iff {p : (ι →₀ ℕ) × Q} {r : R} :
    single p r ∈ Ideal.span {boundaryMonomial R ι Q} ↔ r = 0 ∨ ∀ i, p.1 i ≠ 0 := by
  classical
  rw [mem_span_boundaryMonomial_iff]
  by_cases hr : r = 0
  · simp [hr]
  simp only [hr, false_or]
  constructor
  · intro h i hpi
    simpa [hr] using h p i hpi
  · intro h q i hqi
    have hpq : p ≠ q := fun hpq ↦ h i (hpq ▸ hqi)
    simp [coeff_single, hpq]

/-- Multiplication by the boundary monomial is injective over every coefficient ring: the
boundary monomial is a nonzerodivisor. -/
theorem isRegular_boundaryMonomial : IsRegular (boundaryMonomial R ι Q) := by
  suffices IsLeftRegular (boundaryMonomial R ι Q) from
    ⟨this, this.right_of_commute <| Commute.all _⟩
  intro f g hfg
  have hcoeff : ∀ (h : AddMonoidAlgebra R ((ι →₀ ℕ) × Q)) (p : (ι →₀ ℕ) × Q),
      (boundaryMonomial R ι Q * h).coeff ((∑ i, Finsupp.single i 1, 0) + p) = h.coeff p := by
    intro h p
    rw [boundaryMonomial_eq_single, coeff_single_mul_eq_mul_coeff (R := R) p, one_mul]
    intro q _
    simp [Prod.ext_iff]
  have hfg' : boundaryMonomial R ι Q * f = boundaryMonomial R ι Q * g := hfg
  ext p
  rw [← hcoeff f p, ← hcoeff g p, hfg']

/-- Coefficient change sends the boundary monomial to the boundary monomial. -/
@[simp]
theorem mapRingHom_boundaryMonomial {S : Type*} [CommSemiring S] (φ : R →+* S) :
    mapRingHom _ φ (boundaryMonomial R ι Q) = boundaryMonomial S ι Q := by
  simp [boundaryMonomial_def, map_prod]

/-- The ideal of the boundary commutes with every change of coefficients, flat or not: its
extension along `R[(ι →₀ ℕ) × Q] → S[(ι →₀ ℕ) × Q]` is the ideal of the boundary over `S`. -/
theorem map_span_boundaryMonomial {S : Type*} [CommSemiring S] (φ : R →+* S) :
    Ideal.map (mapRingHom _ φ) (Ideal.span {boundaryMonomial R ι Q}) =
      Ideal.span {boundaryMonomial S ι Q} := by
  rw [Ideal.map_span, Set.image_singleton, mapRingHom_boundaryMonomial]

end Monomial

section Quotient

variable {R : Type*} [CommRing R] {ι : Type*} {Q : Type*} [AddCommMonoid Q]

/-- The coefficients of a polynomial at the exponents with some `a_i = 0`. Its kernel is the
ideal of the boundary. -/
private noncomputable def boundaryCoeffMap :
    AddMonoidAlgebra R ((ι →₀ ℕ) × Q) →ₗ[R] {p : (ι →₀ ℕ) × Q // ∃ i, p.1 i = 0} →₀ R :=
  Finsupp.lcomapDomain _ Subtype.val_injective ∘ₗ (coeffLinearEquiv R).toLinearMap

omit [AddCommMonoid Q] in
private theorem boundaryCoeffMap_apply (f : AddMonoidAlgebra R ((ι →₀ ℕ) × Q))
    (p : {p : (ι →₀ ℕ) × Q // ∃ i, p.1 i = 0}) :
    boundaryCoeffMap f p = f.coeff p := (rfl)

omit [AddCommMonoid Q] in
private theorem boundaryCoeffMap_surjective :
    Function.Surjective (boundaryCoeffMap (R := R) (ι := ι) (Q := Q)) := by
  intro c
  refine ⟨.ofCoeff (Finsupp.mapDomain Subtype.val c), ?_⟩
  ext p
  rw [boundaryCoeffMap_apply, coeff_ofCoeff]
  exact Finsupp.mapDomain_apply_of_injective Subtype.val_injective c p

variable [Fintype ι]

private theorem ker_boundaryCoeffMap :
    LinearMap.ker (boundaryCoeffMap (R := R) (ι := ι) (Q := Q)) =
      (Ideal.span {boundaryMonomial R ι Q}).restrictScalars R := by
  ext f
  rw [LinearMap.mem_ker, Submodule.restrictScalars_mem, mem_span_boundaryMonomial_iff]
  constructor
  · intro h p i hpi
    exact (boundaryCoeffMap_apply f ⟨p, i, hpi⟩).symm.trans (DFunLike.congr_fun h _)
  · intro h
    ext ⟨p, i, hpi⟩
    exact h p i hpi

/-- The coordinate ring of the boundary of a regular chart is a free `R`-module: the classes of
the monomials `x^a y^b` with some `a_i = 0` form a basis of `R[(ι →₀ ℕ) × Q] ⧸ (x_1 ⋯ x_r)`. -/
noncomputable def boundaryQuotientBasis :
    Module.Basis {p : (ι →₀ ℕ) × Q // ∃ i, p.1 i = 0} R
      (AddMonoidAlgebra R ((ι →₀ ℕ) × Q) ⧸ Ideal.span {boundaryMonomial R ι Q}) :=
  .ofRepr <| (Submodule.Quotient.restrictScalarsEquiv R _).symm ≪≫ₗ
    Submodule.quotEquivOfEq _ _ ker_boundaryCoeffMap.symm ≪≫ₗ
    (boundaryCoeffMap (R := R) (ι := ι) (Q := Q)).quotKerEquivOfSurjective
      boundaryCoeffMap_surjective

/-- The coordinates of a class in the boundary quotient basis are the coefficients of any
representative at the exponents with some `a_i = 0`. -/
@[simp]
theorem boundaryQuotientBasis_repr_mk (f : AddMonoidAlgebra R ((ι →₀ ℕ) × Q))
    (p : {p : (ι →₀ ℕ) × Q // ∃ i, p.1 i = 0}) :
    boundaryQuotientBasis.repr (Ideal.Quotient.mk _ f) p = f.coeff p := by
  simp [boundaryQuotientBasis, ← Ideal.Quotient.mk_eq_mk, boundaryCoeffMap_apply]

/-- The basis vectors of the boundary quotient are the classes of the monomials. -/
@[simp]
theorem boundaryQuotientBasis_apply (p : {p : (ι →₀ ℕ) × Q // ∃ i, p.1 i = 0}) :
    boundaryQuotientBasis p =
      Ideal.Quotient.mk (Ideal.span {boundaryMonomial R ι Q}) (single p.val 1) := by
  classical
  rw [Module.Basis.apply_eq_iff]
  ext q
  simp [coeff_single, Finsupp.single_apply, Subtype.ext_iff]

instance : Module.Free R
    (AddMonoidAlgebra R ((ι →₀ ℕ) × Q) ⧸ Ideal.span {boundaryMonomial R ι Q}) :=
  .of_basis boundaryQuotientBasis

end Quotient

section Radical

variable {ι : Type*} {Q : Type*} [AddCommMonoid Q] [UniqueSums Q]

/-- Over a nontrivial coefficient semiring without zero divisors, the intersection of the boundary
divisors indexed by any `J ⊆ ι` is integral when the torus directions have unique sums, as they do
for a lattice: its ideal is prime. -/
theorem isPrime_span_boundaryCoordinate_image {R : Type*} [CommSemiring R] [NoZeroDivisors R]
    [Nontrivial R] (J : Set ι) :
    (Ideal.span (boundaryCoordinate R Q '' J)).IsPrime := by
  have : UniqueSums (boundaryFace Q J) :=
    .of_injective_addHom (boundaryFace Q J).subtype.toAddHom Subtype.val_injective inferInstance
  rw [span_boundaryCoordinate_image]
  exact (boundaryFace Q J).faceIdeal_isPrime (addSaturated_boundaryFace Q J)

variable {R : Type*} [CommRing R] [Fintype ι]

/-- Over a reduced coefficient ring, the ideal of the boundary of a regular chart is radical,
when the torus directions have unique sums. In particular, the boundary over a field is
reduced. -/
theorem isRadical_span_boundaryMonomial [IsReduced R] :
    (Ideal.span {boundaryMonomial R ι Q}).IsRadical := by
  intro f ⟨n, hn⟩
  rw [mem_span_boundaryMonomial_iff]
  intro p i hpi
  suffices f.coeff p ∈ nilradical R by
    rwa [nilradical_eq_zero, Ideal.zero_eq_bot, Ideal.mem_bot] at this
  rw [nilradical_eq_sInf, Ideal.mem_sInf]
  intro P (hP : P.IsPrime)
  -- Over the domain `R ⧸ P` the boundary ideal is an intersection of primes, hence radical.
  have hrad : (Ideal.span {boundaryMonomial (R ⧸ P) ι Q}).IsRadical := by
    rw [← iInf_span_boundaryCoordinate]
    refine Ideal.isRadical_iInf _ fun j ↦ ?_
    rw [← Set.image_singleton]
    exact (isPrime_span_boundaryCoordinate_image _).isRadical
  have hmem : mapRingHom _ (Ideal.Quotient.mk P) f ∈ Ideal.span {boundaryMonomial (R ⧸ P) ι Q} := by
    refine hrad ⟨n, ?_⟩
    rw [← map_pow, ← map_span_boundaryMonomial (Ideal.Quotient.mk P)]
    exact Ideal.mem_map_of_mem _ hn
  have := mem_span_boundaryMonomial_iff.mp hmem p i hpi
  rwa [coeff_mapRingHom, Ideal.Quotient.eq_zero_iff_mem] at this

end Radical

end TauCeti.Toric
