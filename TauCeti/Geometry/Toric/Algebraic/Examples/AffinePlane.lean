/-!
# The standard affine-plane fan

The product of the two positive rank-one ray fans is the standard fan of the affine plane.
Its support is the product of the positive rays, and product regularity supplies the smooth
toric structure used by its algebraic and analytic realizations.

The star subdivision of the positive quadrant along the diagonal ray through `(1, 1)` is the fan
of the blow-up of the affine plane at the origin. Its two maximal cones are the lower cone
`{(x, y) | 0 ≤ y ≤ x}`, spanned by `(1, 0)` and `(1, 1)`, and the upper cone
`{(x, y) | 0 ≤ x ≤ y}`, spanned by `(0, 1)` and `(1, 1)`. They meet in the diagonal ray, and each
is the image of the positive quadrant under a unimodular shear, so the subdivided fan is regular.
It subdivides the affine-plane fan, and its cones mapped into the positive quadrant but into no
smaller cone are exactly those containing the diagonal ray.

## Main declarations

* `TauCeti.Toric.affinePlaneFan`: the standard fan of the affine plane.
* `TauCeti.Toric.affinePlaneBlowUpFan`: the star subdivision of `affinePlaneFan` along the
  diagonal ray, generated by `affinePlaneBlowUpLowerCone` and `affinePlaneBlowUpUpperCone`.
* `TauCeti.Toric.isRegular_affinePlaneBlowUpFan`: the star subdivision is regular.
* `TauCeti.Toric.affinePlaneBlowUpFan_isSubdivision`: it subdivides the affine-plane fan.
* `TauCeti.Toric.leastCone_affinePlaneBlowUpFan_eq_iff`: a cone of the star subdivision has the
  positive quadrant as least cone of the affine-plane fan exactly when it contains the diagonal
  ray `affinePlaneBlowUpDiagonalCone`.

## References

* W. Fulton, *Introduction to Toric Varieties*, §1.4, and §2.4 for the blow-up of the plane.
* D. Cox, J. Little and H. Schenck, *Toric Varieties*, §3.1, and §3.3 for star subdivisions and
  the blow-up of the plane.
-/

public section

namespace TauCeti.Toric

/-- The standard affine-plane fan in the product of two rank-one lattices. -/
abbrev affinePlaneFan := affineRayFan.prod affineRayFan

/-- The cones of the affine-plane fan are products of faces of the positive ray. -/
theorem mem_affinePlaneFan_cones {ξ : PointedCone ℝ ((Fin 1 → ℝ) × (Fin 1 → ℝ))} :
    ξ ∈ affinePlaneFan.cones ↔
      ∃ (σ τ : PointedCone ℝ (Fin 1 → ℝ)), σ.IsFaceOf affineRayCone ∧
        τ.IsFaceOf affineRayCone ∧ ξ = σ.prod τ := by
  simp only [affinePlaneFan, Fan.mem_prod_cones, mem_affineRayFan_cones]
  aesop

/-- The support of the affine-plane fan is the positive quadrant, expressed as a product of
the two positive rays. -/
theorem support_affinePlaneFan :
    affinePlaneFan.support = (affineRayCone : Set (Fin 1 → ℝ)) ×ˢ affineRayCone := by
  simp only [affinePlaneFan, Fan.support_prod, support_affineRayFan]

/-- The standard affine-plane fan is regular. -/
theorem isRegular_affinePlaneFan : affinePlaneFan.IsRegular :=
  Fan.IsRegular.prod affineRayFan affineRayFan isRegular_affineRayFan isRegular_affineRayFan

/-! ### The star subdivision along the diagonal -/

/-- The lower cone `{(x, y) | 0 ≤ y ≤ x}` of the star subdivision of the positive quadrant along
the diagonal, spanned by `(1, 0)` and `(1, 1)`. -/
def affinePlaneBlowUpLowerCone : PointedCone ℝ ((Fin 1 → ℝ) × (Fin 1 → ℝ)) :=
  PointedCone.hull ℝ {(1, 0), (1, 1)}

theorem affinePlaneBlowUpLowerCone_def :
    affinePlaneBlowUpLowerCone = PointedCone.hull ℝ {(1, 0), (1, 1)} := (rfl)

/-- The upper cone `{(x, y) | 0 ≤ x ≤ y}` of the star subdivision of the positive quadrant along
the diagonal, spanned by `(0, 1)` and `(1, 1)`. -/
def affinePlaneBlowUpUpperCone : PointedCone ℝ ((Fin 1 → ℝ) × (Fin 1 → ℝ)) :=
  PointedCone.hull ℝ {(0, 1), (1, 1)}

theorem affinePlaneBlowUpUpperCone_def :
    affinePlaneBlowUpUpperCone = PointedCone.hull ℝ {(0, 1), (1, 1)} := (rfl)

/-- The diagonal ray, spanned by `(1, 1)`: the ray along which the positive quadrant is
subdivided. -/
def affinePlaneBlowUpDiagonalCone : PointedCone ℝ ((Fin 1 → ℝ) × (Fin 1 → ℝ)) :=
  PointedCone.hull ℝ {(1, 1)}

theorem affinePlaneBlowUpDiagonalCone_def :
    affinePlaneBlowUpDiagonalCone = PointedCone.hull ℝ {(1, 1)} := (rfl)

/-- Membership in the lower cone: `0 ≤ y ≤ x`. -/
@[simp]
theorem mem_affinePlaneBlowUpLowerCone_iff (x : (Fin 1 → ℝ) × (Fin 1 → ℝ)) :
    x ∈ affinePlaneBlowUpLowerCone ↔ 0 ≤ x.2 0 ∧ x.2 0 ≤ x.1 0 := by
  rw [affinePlaneBlowUpLowerCone_def, Submodule.mem_span_pair]
  constructor
  · rintro ⟨a, b, rfl⟩
    simp [← Nonneg.coe_smul, a.2, b.2]
  · rintro ⟨h0, h1⟩
    refine ⟨⟨x.1 0 - x.2 0, sub_nonneg.2 h1⟩, ⟨x.2 0, h0⟩, ?_⟩
    ext j <;> simp [Nonneg.mk_smul, Subsingleton.elim j 0]

/-- Membership in the upper cone: `0 ≤ x ≤ y`. -/
@[simp]
theorem mem_affinePlaneBlowUpUpperCone_iff (x : (Fin 1 → ℝ) × (Fin 1 → ℝ)) :
    x ∈ affinePlaneBlowUpUpperCone ↔ 0 ≤ x.1 0 ∧ x.1 0 ≤ x.2 0 := by
  rw [affinePlaneBlowUpUpperCone_def, Submodule.mem_span_pair]
  constructor
  · rintro ⟨a, b, rfl⟩
    simp [← Nonneg.coe_smul, a.2, b.2]
  · rintro ⟨h0, h1⟩
    refine ⟨⟨x.2 0 - x.1 0, sub_nonneg.2 h1⟩, ⟨x.1 0, h0⟩, ?_⟩
    ext j <;> simp [Nonneg.mk_smul, Subsingleton.elim j 0]

/-- The lower blow-up cone lies in the positive quadrant. -/
theorem affinePlaneBlowUpLowerCone_le_prod :
    affinePlaneBlowUpLowerCone ≤ affineRayCone.prod affineRayCone := by
  intro x hx
  have hx' := (mem_affinePlaneBlowUpLowerCone_iff x).1 hx
  exact ⟨(mem_affineRayCone_iff _).2 (hx'.1.trans hx'.2),
    (mem_affineRayCone_iff _).2 hx'.1⟩

/-- The upper blow-up cone lies in the positive quadrant. -/
theorem affinePlaneBlowUpUpperCone_le_prod :
    affinePlaneBlowUpUpperCone ≤ affineRayCone.prod affineRayCone := by
  intro x hx
  have hx' := (mem_affinePlaneBlowUpUpperCone_iff x).1 hx
  exact ⟨(mem_affineRayCone_iff _).2 hx'.1,
    (mem_affineRayCone_iff _).2 (hx'.1.trans hx'.2)⟩

/-- Membership in the diagonal ray: `0 ≤ x = y`. -/
@[simp]
theorem mem_affinePlaneBlowUpDiagonalCone_iff (x : (Fin 1 → ℝ) × (Fin 1 → ℝ)) :
    x ∈ affinePlaneBlowUpDiagonalCone ↔ 0 ≤ x.1 0 ∧ x.1 0 = x.2 0 := by
  rw [affinePlaneBlowUpDiagonalCone_def, PointedCone.mem_hull_singleton]
  constructor
  · rintro ⟨r, hr, rfl⟩
    simpa using hr
  · rintro ⟨h0, h1⟩
    refine ⟨x.1 0, h0, ?_⟩
    ext j <;> simp [Subsingleton.elim j 0, h1]

/-- The lower and upper cones meet in the diagonal ray. -/
theorem affinePlaneBlowUpLowerCone_inf_affinePlaneBlowUpUpperCone :
    affinePlaneBlowUpLowerCone ⊓ affinePlaneBlowUpUpperCone = affinePlaneBlowUpDiagonalCone := by
  ext x
  simp only [Submodule.mem_inf, mem_affinePlaneBlowUpLowerCone_iff,
    mem_affinePlaneBlowUpUpperCone_iff, mem_affinePlaneBlowUpDiagonalCone_iff]
  constructor
  · rintro ⟨⟨-, h1⟩, h2, h3⟩
    exact ⟨h2, le_antisymm h3 h1⟩
  · rintro ⟨h0, h1⟩
    exact ⟨⟨h1 ▸ h0, h1.ge⟩, h0, h1.le⟩

/-- The upper cone is the image of the positive quadrant under the shear `(x, y) ↦ (x, y + x)`. -/
theorem affinePlaneBlowUpUpperCone_eq_map :
    affinePlaneBlowUpUpperCone = PointedCone.map
      ((LinearEquiv.skewProd (.refl ℝ (Fin 1 → ℝ)) (.refl ℝ (Fin 1 → ℝ)) LinearMap.id :
        ((Fin 1 → ℝ) × (Fin 1 → ℝ)) ≃ₗ[ℝ] (Fin 1 → ℝ) × (Fin 1 → ℝ)) :
        ((Fin 1 → ℝ) × (Fin 1 → ℝ)) →ₗ[ℝ] (Fin 1 → ℝ) × (Fin 1 → ℝ))
      (affineRayCone.prod affineRayCone) := by
  ext x
  rw [mem_affinePlaneBlowUpUpperCone_iff, PointedCone.mem_map]
  constructor
  · rintro ⟨h0, h1⟩
    refine ⟨(x.1, x.2 - x.1), ?_, ?_⟩
    · simp [Submodule.mem_prod, h0, h1]
    · simp
  · rintro ⟨y, hy, rfl⟩
    simp only [Submodule.mem_prod, mem_affineRayCone_iff] at hy
    simp [hy.1, hy.2]

/-- The lower cone is the image of the upper cone under the exchange of coordinates. -/
theorem affinePlaneBlowUpLowerCone_eq_map :
    affinePlaneBlowUpLowerCone = affinePlaneBlowUpUpperCone.map
      (LinearEquiv.prodComm ℝ (Fin 1 → ℝ) (Fin 1 → ℝ) :
        ((Fin 1 → ℝ) × (Fin 1 → ℝ)) →ₗ[ℝ] (Fin 1 → ℝ) × (Fin 1 → ℝ)) := by
  ext x
  rw [mem_affinePlaneBlowUpLowerCone_iff, PointedCone.mem_map]
  constructor
  · rintro ⟨h0, h1⟩
    exact ⟨x.swap, (mem_affinePlaneBlowUpUpperCone_iff _).2 ⟨h0, h1⟩, rfl⟩
  · rintro ⟨y, hy, rfl⟩
    exact (mem_affinePlaneBlowUpUpperCone_iff y).1 hy

/-- The upper cone is regular: its generators `(0, 1)` and `(1, 1)` form an integral basis. -/
theorem isRegularCone_affinePlaneBlowUpUpperCone :
    IsRegularCone
      (((Int.castAddHom ℝ).compLeft (Fin 1)).prodMap ((Int.castAddHom ℝ).compLeft (Fin 1)))
      affinePlaneBlowUpUpperCone := by
  rw [affinePlaneBlowUpUpperCone_eq_map]
  refine (isRegularCone_affineRayCone.prod isRegularCone_affineRayCone).map_equiv
    (f := (LinearEquiv.skewProd (.refl ℤ (Fin 1 → ℤ)) (.refl ℤ (Fin 1 → ℤ))
      LinearMap.id).toAddEquiv) fun n ↦ ?_
  ext j <;> simp

/-- The lower cone is regular: its generators `(1, 0)` and `(1, 1)` form an integral basis. -/
theorem isRegularCone_affinePlaneBlowUpLowerCone :
    IsRegularCone
      (((Int.castAddHom ℝ).compLeft (Fin 1)).prodMap ((Int.castAddHom ℝ).compLeft (Fin 1)))
      affinePlaneBlowUpLowerCone := by
  rw [affinePlaneBlowUpLowerCone_eq_map]
  exact isRegularCone_affinePlaneBlowUpUpperCone.map_equiv (f := AddEquiv.prodComm)
    fun _ ↦ rfl

/-- The diagonal ray is a face of the lower cone, on which it is the locus `x = y`. -/
theorem affinePlaneBlowUpDiagonalCone_isFaceOf_affinePlaneBlowUpLowerCone :
    affinePlaneBlowUpDiagonalCone.IsFaceOf affinePlaneBlowUpLowerCone := by
  let φ : Module.Dual ℝ ((Fin 1 → ℝ) × (Fin 1 → ℝ)) :=
    (LinearMap.proj 0).comp (LinearMap.fst ℝ _ _) - (LinearMap.proj 0).comp (LinearMap.snd ℝ _ _)
  have h := PointedCone.isFaceOf_inf_ker (C := affinePlaneBlowUpLowerCone) (φ := φ) fun x hx ↦ by
    simpa [φ] using ((mem_affinePlaneBlowUpLowerCone_iff x).1 hx).2
  convert h using 1
  ext x
  simp only [mem_affinePlaneBlowUpDiagonalCone_iff, Submodule.mem_inf,
    mem_affinePlaneBlowUpLowerCone_iff, PointedCone.mem_ofSubmodule_iff, LinearMap.mem_ker,
    φ, LinearMap.sub_apply, LinearMap.comp_apply, LinearMap.fst_apply, LinearMap.snd_apply,
    LinearMap.proj_apply, sub_eq_zero]
  constructor
  · rintro ⟨h0, h1⟩
    exact ⟨⟨h1 ▸ h0, h1.ge⟩, h1⟩
  · rintro ⟨⟨h0, -⟩, h1⟩
    exact ⟨h1 ▸ h0, h1⟩

/-- The diagonal ray is a face of the upper cone, on which it is the locus `x = y`. -/
theorem affinePlaneBlowUpDiagonalCone_isFaceOf_affinePlaneBlowUpUpperCone :
    affinePlaneBlowUpDiagonalCone.IsFaceOf affinePlaneBlowUpUpperCone := by
  let φ : Module.Dual ℝ ((Fin 1 → ℝ) × (Fin 1 → ℝ)) :=
    (LinearMap.proj 0).comp (LinearMap.snd ℝ _ _) - (LinearMap.proj 0).comp (LinearMap.fst ℝ _ _)
  have h := PointedCone.isFaceOf_inf_ker (C := affinePlaneBlowUpUpperCone) (φ := φ) fun x hx ↦ by
    simpa [φ] using ((mem_affinePlaneBlowUpUpperCone_iff x).1 hx).2
  convert h using 1
  ext x
  simp only [mem_affinePlaneBlowUpDiagonalCone_iff, Submodule.mem_inf,
    mem_affinePlaneBlowUpUpperCone_iff, PointedCone.mem_ofSubmodule_iff, LinearMap.mem_ker,
    φ, LinearMap.sub_apply, LinearMap.comp_apply, LinearMap.fst_apply, LinearMap.snd_apply,
    LinearMap.proj_apply, sub_eq_zero]
  constructor
  · rintro ⟨h0, h1⟩
    exact ⟨⟨h0, h1.le⟩, h1.symm⟩
  · rintro ⟨⟨h0, -⟩, h1⟩
    exact ⟨h0, h1.symm⟩

/-- The star subdivision of the affine-plane fan along the diagonal ray: the fan of the faces of
the lower and upper cones. It is the fan of the blow-up of the affine plane at the origin. -/
def affinePlaneBlowUpFan :
    Fan (((Int.castAddHom ℝ).compLeft (Fin 1)).prodMap ((Int.castAddHom ℝ).compLeft (Fin 1))) :=
  Fan.ofCones affinePlaneFan.lattice {affinePlaneBlowUpLowerCone, affinePlaneBlowUpUpperCone}
    (Set.toFinite _)
    (by
      rintro σ (rfl | rfl)
      exacts [isRegularCone_affinePlaneBlowUpLowerCone.toIsToricCone,
        isRegularCone_affinePlaneBlowUpUpperCone.toIsToricCone])
    (by
      rintro σ τ (rfl | rfl) (rfl | rfl)
      · simpa only [inf_idem] using PointedCone.IsFaceOf.refl _
      · rw [affinePlaneBlowUpLowerCone_inf_affinePlaneBlowUpUpperCone]
        exact affinePlaneBlowUpDiagonalCone_isFaceOf_affinePlaneBlowUpLowerCone
      · rw [inf_comm, affinePlaneBlowUpLowerCone_inf_affinePlaneBlowUpUpperCone]
        exact affinePlaneBlowUpDiagonalCone_isFaceOf_affinePlaneBlowUpUpperCone
      · simpa only [inf_idem] using PointedCone.IsFaceOf.refl _)

/-- The cones of the blow-up fan are the faces of the lower and of the upper cone. -/
@[simp]
theorem mem_affinePlaneBlowUpFan_cones {σ : PointedCone ℝ ((Fin 1 → ℝ) × (Fin 1 → ℝ))} :
    σ ∈ affinePlaneBlowUpFan.cones ↔
      σ.IsFaceOf affinePlaneBlowUpLowerCone ∨ σ.IsFaceOf affinePlaneBlowUpUpperCone := by
  simp [affinePlaneBlowUpFan]

/-- The diagonal ray is a cone of the blow-up fan. -/
theorem affinePlaneBlowUpDiagonalCone_mem_affinePlaneBlowUpFan_cones :
    affinePlaneBlowUpDiagonalCone ∈ affinePlaneBlowUpFan.cones :=
  mem_affinePlaneBlowUpFan_cones.2
    (Or.inl affinePlaneBlowUpDiagonalCone_isFaceOf_affinePlaneBlowUpLowerCone)

/-- The blow-up fan is regular. -/
theorem isRegular_affinePlaneBlowUpFan : affinePlaneBlowUpFan.IsRegular := by
  rw [affinePlaneBlowUpFan, Fan.isRegular_ofCones_iff]
  rintro σ (rfl | rfl)
  exacts [isRegularCone_affinePlaneBlowUpLowerCone, isRegularCone_affinePlaneBlowUpUpperCone]

/-- The support of the blow-up fan is the positive quadrant. -/
theorem support_affinePlaneBlowUpFan :
    affinePlaneBlowUpFan.support = (affineRayCone : Set (Fin 1 → ℝ)) ×ˢ affineRayCone := by
  ext x
  simp only [affinePlaneBlowUpFan, Fan.support_ofCones, Set.mem_insert_iff,
    Set.mem_singleton_iff, Set.iUnion_iUnion_eq_or_left, Set.iUnion_iUnion_eq_left,
    Set.mem_union, SetLike.mem_coe, mem_affinePlaneBlowUpLowerCone_iff,
    mem_affinePlaneBlowUpUpperCone_iff, Set.mem_prod, mem_affineRayCone_iff]
  constructor
  · rintro (⟨h0, h1⟩ | ⟨h0, h1⟩)
    exacts [⟨h0.trans h1, h0⟩, ⟨h0, h0.trans h1⟩]
  · rintro ⟨h0, h1⟩
    exact (le_total (x.2 0) (x.1 0)).imp (fun h ↦ ⟨h1, h⟩) fun h ↦ ⟨h0, h⟩

/-- The blow-up fan subdivides the affine-plane fan. -/
theorem affinePlaneBlowUpFan_isSubdivision :
    affinePlaneBlowUpFan.IsSubdivision affinePlaneFan where
  exists_cone_le σ hσ := by
    refine ⟨affineRayCone.prod affineRayCone,
      mem_affinePlaneFan_cones.2 ⟨_, _, .refl _, .refl _, rfl⟩, fun x hx ↦ ?_⟩
    have hx' := affinePlaneBlowUpFan.subset_support hσ hx
    rw [support_affinePlaneBlowUpFan] at hx'
    exact hx'
  support_eq := by rw [support_affinePlaneBlowUpFan, support_affinePlaneFan]

/-- A face of the positive ray containing `1` is the whole ray. -/
private theorem eq_affineRayCone_of_isFaceOf {σ : PointedCone ℝ (Fin 1 → ℝ)}
    (hσ : σ.IsFaceOf affineRayCone) (h1 : (1 : Fin 1 → ℝ) ∈ σ) : σ = affineRayCone := by
  rw [affineRayCone_def] at hσ ⊢
  refine (hσ.eq_bot_or_eq_of_hull_singleton 1).resolve_left fun h ↦ ?_
  rw [h, Submodule.mem_bot] at h1
  exact one_ne_zero h1

/-- A face of the lower cone which misses `(1, 1)` lies on the first coordinate axis. -/
private theorem snd_eq_zero_of_isFaceOf_affinePlaneBlowUpLowerCone
    {σ : PointedCone ℝ ((Fin 1 → ℝ) × (Fin 1 → ℝ))} (hσ : σ.IsFaceOf affinePlaneBlowUpLowerCone)
    (h : ((1, 1) : (Fin 1 → ℝ) × (Fin 1 → ℝ)) ∉ σ) {x : (Fin 1 → ℝ) × (Fin 1 → ℝ)}
    (hx : x ∈ σ) : x.2 = 0 := by
  -- The face is spanned by the generators of the lower cone which it contains.
  have hle : σ ≤ PointedCone.hull ℝ {((1 : Fin 1 → ℝ), (0 : Fin 1 → ℝ))} := by
    refine (PointedCone.Face.eq_hull_inter_of_eq_hull ⟨σ, hσ⟩ _
      affinePlaneBlowUpLowerCone_def).le.trans (Submodule.span_mono ?_)
    rintro y ⟨rfl | rfl, hy⟩
    exacts [rfl, absurd hy h]
  obtain ⟨r, -, rfl⟩ := PointedCone.mem_hull_singleton.1 (hle hx)
  simp

/-- A face of the upper cone which misses `(1, 1)` lies on the second coordinate axis. -/
private theorem fst_eq_zero_of_isFaceOf_affinePlaneBlowUpUpperCone
    {σ : PointedCone ℝ ((Fin 1 → ℝ) × (Fin 1 → ℝ))} (hσ : σ.IsFaceOf affinePlaneBlowUpUpperCone)
    (h : ((1, 1) : (Fin 1 → ℝ) × (Fin 1 → ℝ)) ∉ σ) {x : (Fin 1 → ℝ) × (Fin 1 → ℝ)}
    (hx : x ∈ σ) : x.1 = 0 := by
  -- The face is spanned by the generators of the upper cone which it contains.
  have hle : σ ≤ PointedCone.hull ℝ {((0 : Fin 1 → ℝ), (1 : Fin 1 → ℝ))} := by
    refine (PointedCone.Face.eq_hull_inter_of_eq_hull ⟨σ, hσ⟩ _
      affinePlaneBlowUpUpperCone_def).le.trans (Submodule.span_mono ?_)
    rintro y ⟨rfl | rfl, hy⟩
    exacts [rfl, absurd hy h]
  obtain ⟨r, -, rfl⟩ := PointedCone.mem_hull_singleton.1 (hle hx)
  simp

/-- The least cone of the affine-plane fan containing a cone of the blow-up fan is the positive
quadrant exactly when that cone contains the diagonal ray. The other cones of the blow-up fan lie
on a coordinate axis. -/
theorem leastCone_affinePlaneBlowUpFan_eq_iff
    {σ : PointedCone ℝ ((Fin 1 → ℝ) × (Fin 1 → ℝ))} (hσ : σ ∈ affinePlaneBlowUpFan.cones) :
    affinePlaneBlowUpFan_isSubdivision.toFanHom.leastCone hσ =
        affineRayCone.prod affineRayCone ↔
      affinePlaneBlowUpDiagonalCone ≤ σ := by
  set f := affinePlaneBlowUpFan_isSubdivision.toFanHom
  have hbot : (⊥ : PointedCone ℝ (Fin 1 → ℝ)).IsFaceOf affineRayCone :=
    isRegularCone_affineRayCone.toIsToricCone.salient.bot_isFaceOf
  rw [affinePlaneBlowUpDiagonalCone_def, Submodule.span_singleton_le_iff_mem]
  constructor
  · intro hL
    by_contra hd
    -- Otherwise `σ` lies on a coordinate axis, a cone of the affine-plane fan missing `(1, 1)`.
    have hQ : ((1, 1) : (Fin 1 → ℝ) × (Fin 1 → ℝ)) ∈ f.leastCone hσ := by
      rw [hL]
      simp [Submodule.mem_prod]
    rcases mem_affinePlaneBlowUpFan_cones.1 hσ with hσ' | hσ'
    · have hle : f.leastCone hσ ≤ affineRayCone.prod ⊥ := by
        refine f.leastCone_le hσ (mem_affinePlaneFan_cones.2 ⟨_, _, .refl _, hbot, rfl⟩) ?_
        rw [Fan.IsSubdivision.toFanHom_realMap, PointedCone.map_id]
        intro x hx
        have h2 := snd_eq_zero_of_isFaceOf_affinePlaneBlowUpLowerCone hσ' hd hx
        have h1 := (mem_affinePlaneBlowUpLowerCone_iff x).1 (hσ'.le hx)
        rw [h2] at h1
        exact ⟨(mem_affineRayCone_iff _).2 (by simpa using h1.2), h2⟩
      exact one_ne_zero ((Submodule.mem_bot _).1 (hle hQ).2)
    · have hle : f.leastCone hσ ≤ (⊥ : PointedCone ℝ (Fin 1 → ℝ)).prod affineRayCone := by
        refine f.leastCone_le hσ (mem_affinePlaneFan_cones.2 ⟨_, _, hbot, .refl _, rfl⟩) ?_
        rw [Fan.IsSubdivision.toFanHom_realMap, PointedCone.map_id]
        intro x hx
        have h2 := fst_eq_zero_of_isFaceOf_affinePlaneBlowUpUpperCone hσ' hd hx
        have h1 := (mem_affinePlaneBlowUpUpperCone_iff x).1 (hσ'.le hx)
        rw [h2] at h1
        exact ⟨h2, (mem_affineRayCone_iff _).2 (by simpa using h1.2)⟩
      exact one_ne_zero ((Submodule.mem_bot _).1 (hle hQ).1)
  · intro hd
    obtain ⟨σ₁, σ₂, h₁, h₂, hL⟩ := mem_affinePlaneFan_cones.1 (f.leastCone_mem hσ)
    have h := f.mapsTo_leastCone hσ hd
    rw [Fan.IsSubdivision.toFanHom_realMap, hL] at h
    rw [hL, eq_affineRayCone_of_isFaceOf h₁ h.1, eq_affineRayCone_of_isFaceOf h₂ h.2]

/-- The diagonal cone spans a line. -/
private theorem finrank_span_affinePlaneBlowUpDiagonalCone :
    Module.finrank ℝ (Submodule.span ℝ
      (affinePlaneBlowUpDiagonalCone : Set ((Fin 1 → ℝ) × (Fin 1 → ℝ)))) = 1 := by
  have h : ((1, 1) : (Fin 1 → ℝ) × (Fin 1 → ℝ)) ≠ 0 := by
    simp [Prod.ext_iff]
  rw [affinePlaneBlowUpDiagonalCone_def, Submodule.span_span_of_tower,
    finrank_span_singleton h]

/-- The diagonal ray as a ray of the blow-up fan: the ray introduced by the star subdivision. -/
def affinePlaneBlowUpDiagonalRay : affinePlaneBlowUpFan.Ray :=
  ⟨⟨affinePlaneBlowUpDiagonalCone, affinePlaneBlowUpDiagonalCone_mem_affinePlaneBlowUpFan_cones⟩,
    finrank_span_affinePlaneBlowUpDiagonalCone⟩

/-- The cone underlying the diagonal fan ray is the diagonal ray. -/
@[simp]
theorem coe_toCone_affinePlaneBlowUpDiagonalRay :
    (affinePlaneBlowUpDiagonalRay.toCone : PointedCone ℝ ((Fin 1 → ℝ) × (Fin 1 → ℝ))) =
      affinePlaneBlowUpDiagonalCone := (rfl)

end TauCeti.Toric
