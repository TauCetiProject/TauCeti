module

public import Mathlib.AlgebraicGeometry.AffineSpace
public import TauCeti.Geometry.Toric.Algebraic.Fan.AffineSpace.Basic
public import TauCeti.Geometry.Toric.Algebraic.Fan.Over

/-!
# The toric scheme of the fan of affine space

Let `b` be an integral basis of the lattice `N`, indexed by a finite type `ι`. The dual semigroup
of the positive orthant spanned by `b` is freely generated by the coordinate characters
`b.coord j`, so the coordinate ring of its affine toric scheme is the polynomial ring
`MvPolynomial ι ℂ`, with `b.coord j` as the variable `X j`. Since every cone of the fan of affine
space is a face of the orthant, the toric scheme of that fan is the affine toric scheme of the
orthant. Together these identify the toric scheme of the fan of affine space with Mathlib's affine
space `𝔸(ι; Spec ℂ)` over `Spec ℂ`. Its coordinate functions are the monomials of the coordinate
characters `b.coord j`.

This is the algebraic counterpart of `TauCeti.Toric.Fan.affineSpaceHomeomorph`, which identifies
the analytic realization of the same fan with `ι → ℂ` through the character functions of
`b.coord j`.

## Main declarations

* `TauCeti.Toric.Fan.affineSpaceDualSemigroupEquiv`: the dual semigroup of the orthant is
  `ι →₀ ℕ`, the exponent of `j` being the pairing with `b j`.
* `TauCeti.Toric.Fan.affineSpaceCoordinateRingEquiv`: the coordinate ring of the orthant is the
  polynomial ring `MvPolynomial ι ℂ`.
* `TauCeti.Toric.Fan.affineSpaceAlgebraicIso`: the toric scheme of the fan of affine space is
  isomorphic to `𝔸(ι; Spec ℂ)`, by an isomorphism over `Spec ℂ`
  (`TauCeti.Toric.Fan.isOver_affineSpaceAlgebraicIso_hom`).
* `TauCeti.Toric.Fan.affineToricChartι_comp_affineSpaceAlgebraicIso_hom_appTop_coord`: the
  coordinate `j` of `𝔸(ι; Spec ℂ)` pulls back to the monomial of `b.coord j` on the chart of the
  orthant.

## References

* W. Fulton, *Introduction to Toric Varieties*, §§1.1 and 1.3.
* D. Cox, J. Little and H. Schenck, *Toric Varieties*, §§1.2 and 3.1.
-/

public section

open AlgebraicGeometry CategoryTheory Multiplicative

namespace TauCeti.Toric.Fan

/-! ### The coordinate ring of the orthant -/

section CoordinateRing

variable {N V ι : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  [Fintype ι] (b : Module.Basis ι ℤ N) {i : N →+ V} (hi : IsIntegralLattice i)

/-- The dual semigroup of the positive orthant spanned by an integral basis `b` is freely
generated by the coordinate characters: a character is recorded by its pairings with the basis
vectors. -/
noncomputable def affineSpaceDualSemigroupEquiv :
    dualSemigroup hi (projectiveSpaceCone b i {none}ᶜ) ≃+ (ι →₀ ℕ) :=
  (projectiveSpaceDualSemigroupEquiv b hi none).trans <|
    (LinearEquiv.piCongrLeft ℕ (fun _ ↦ ℕ) ((Equiv.optionIsSomeEquiv ι).symm.trans
      (Equiv.subtypeEquivRight fun _ ↦ Option.isSome_iff_ne_none))).symm.toAddEquiv.trans
      (Finsupp.linearEquivFunOnFinite ℕ ℕ ι).symm.toAddEquiv

/-- The exponent of `j` of a character of the orthant is its pairing with the basis vector `b j`. -/
@[simp]
theorem affineSpaceDualSemigroupEquiv_apply
    (m : dualSemigroup hi (projectiveSpaceCone b i {none}ᶜ)) (j : ι) :
    affineSpaceDualSemigroupEquiv b hi m j = ((m : N →+ ℤ) (b j)).toNat := by
  simp [affineSpaceDualSemigroupEquiv, LinearEquiv.piCongrLeft]

/-- The coordinate character `b.coord j` is the `j`-th free generator of the dual semigroup of the
orthant. -/
@[simp]
theorem affineSpaceDualSemigroupEquiv_coord (j : ι) :
    affineSpaceDualSemigroupEquiv b hi ⟨(b.coord j).toAddMonoidHom,
      coord_mem_dualSemigroup_affineSpace b hi j (affineSpaceMaximalCone b hi)⟩ =
      Finsupp.single j 1 := by
  classical
  ext k
  by_cases hjk : j = k <;> simp [hjk]

/-- The coordinate ring of the affine toric scheme of the positive orthant is the polynomial ring
on `ι`: the monomial of a character becomes the monomial whose exponents are its pairings with
the basis vectors. -/
noncomputable def affineSpaceCoordinateRingEquiv :
    affineCoordinateRing hi (projectiveSpaceCone b i {none}ᶜ) ≃ₐ[ℂ] MvPolynomial ι ℂ :=
  (MonoidAlgebra.domCongr ℂ ℂ (affineSpaceDualSemigroupEquiv b hi).toMultiplicative).trans
    (AddMonoidAlgebra.toMultiplicativeAlgEquiv ℂ ℂ (ι →₀ ℕ)).symm

/-- The monomial of a character of the orthant is the monomial with exponents its pairings with
the basis vectors. -/
@[simp]
theorem affineSpaceCoordinateRingEquiv_single
    (m : dualSemigroup hi (projectiveSpaceCone b i {none}ᶜ)) (z : ℂ) :
    affineSpaceCoordinateRingEquiv b hi (MonoidAlgebra.single (ofAdd m) z) =
      MvPolynomial.monomial (affineSpaceDualSemigroupEquiv b hi m) z := by
  rw [affineSpaceCoordinateRingEquiv, AlgEquiv.trans_apply, AlgEquiv.symm_apply_eq,
    ← MvPolynomial.single_eq_monomial, AddMonoidAlgebra.toMultiplicativeAlgEquiv_single]
  simp

/-- The variable `X j` corresponds to the monomial of the coordinate character `b.coord j`. -/
@[simp]
theorem affineSpaceCoordinateRingEquiv_symm_X (j : ι) :
    (affineSpaceCoordinateRingEquiv b hi).symm (MvPolynomial.X j) =
      MonoidAlgebra.single (ofAdd ⟨(b.coord j).toAddMonoidHom,
        coord_mem_dualSemigroup_affineSpace b hi j (affineSpaceMaximalCone b hi)⟩) 1 := by
  rw [AlgEquiv.symm_apply_eq, affineSpaceCoordinateRingEquiv_single,
    affineSpaceDualSemigroupEquiv_coord, MvPolynomial.X]

end CoordinateRing

/-! ### The toric scheme of affine space -/

section Scheme

variable {N ι : Type} {V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  [Fintype ι] (b : Module.Basis ι ℤ N) {i : N →+ V} (hi : IsIntegralLattice i)

/-- The toric scheme of the fan of affine space is the affine space `𝔸(ι; Spec ℂ)`. It is the
inverse of the chart inclusion of the orthant, followed by the spectrum of the polynomial
coordinate ring `affineSpaceCoordinateRingEquiv`. -/
noncomputable def affineSpaceAlgebraicIso :
    (affineSpace b hi).algebraicRealization ≅ 𝔸(ι; Spec (.of ℂ)) :=
  (asIso ((affineSpace b hi).affineToricChartι (affineSpaceMaximalCone b hi))).symm ≪≫
    Scheme.Spec.mapIso
      (affineSpaceCoordinateRingEquiv b hi).toRingEquiv.toCommRingCatIso.symm.op ≪≫
    (AffineSpace.SpecIso ι (.of ℂ)).symm

/-- On the chart of the orthant, the identification with affine space is the spectrum of the
polynomial coordinate ring. -/
@[reassoc]
theorem affineToricChartι_comp_affineSpaceAlgebraicIso_hom :
    (affineSpace b hi).affineToricChartι (affineSpaceMaximalCone b hi) ≫
        (affineSpaceAlgebraicIso b hi).hom =
      Spec.map (CommRingCat.ofHom (affineSpaceCoordinateRingEquiv b hi).symm.toRingHom) ≫
        (AffineSpace.SpecIso ι (.of ℂ)).inv := by
  simp [affineSpaceAlgebraicIso]

/-- The identification of the toric scheme of the fan of affine space with `𝔸(ι; Spec ℂ)` is a
morphism over `Spec ℂ`. -/
instance isOver_affineSpaceAlgebraicIso_hom :
    (affineSpaceAlgebraicIso b hi).hom.IsOver (Spec (.of ℂ)) where
  comp_over := by
    rw [← cancel_epi ((affineSpace b hi).affineToricChartι (affineSpaceMaximalCone b hi)),
      affineToricChartι_comp_affineSpaceAlgebraicIso_hom_assoc,
      AffineSpace.SpecIso_inv_over, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      comp_over]
    congr 2
    exact (affineSpaceCoordinateRingEquiv b hi).symm.toAlgHom.comp_algebraMap

/-- On the chart of the orthant, the coordinate `j` of `𝔸(ι; Spec ℂ)` is the monomial of the
coordinate character `b.coord j`. -/
theorem affineToricChartι_comp_affineSpaceAlgebraicIso_hom_appTop_coord (j : ι) :
    ((affineSpace b hi).affineToricChartι (affineSpaceMaximalCone b hi) ≫
        (affineSpaceAlgebraicIso b hi).hom).appTop (AffineSpace.coord _ j) =
      (Scheme.ΓSpecIso _).inv (MonoidAlgebra.single
        (ofAdd ⟨(b.coord j).toAddMonoidHom,
          coord_mem_dualSemigroup_affineSpace b hi j (affineSpaceMaximalCone b hi)⟩) 1) := by
  rw [affineToricChartι_comp_affineSpaceAlgebraicIso_hom, Scheme.Hom.comp_appTop,
    CommRingCat.comp_apply, AffineSpace.SpecIso_inv_appTop_coord,
    ← affineSpaceCoordinateRingEquiv_symm_X]
  -- Naturality of `Scheme.ΓSpecIso` for the polynomial coordinate ring map, evaluated at `X j`.
  exact (ConcreteCategory.congr_hom (Scheme.ΓSpecIso_inv_naturality
    (CommRingCat.ofHom (affineSpaceCoordinateRingEquiv b hi).symm.toRingHom))
    (MvPolynomial.X j)).symm

end Scheme

end TauCeti.Toric.Fan
