/-!
# Ray boundary points of toric schemes

A ray of a fan cuts out a monomial prime on each affine chart whose cone contains the ray.
The face of the dual semigroup consists of the characters that pair to zero with the primitive
ray generator. The generic point of the corresponding closed subscheme is of codimension one:
on the ray's own chart the ideal is generated by any monomial of pairing one.

The points agree under face restriction, lie in precisely the charts whose cones contain the
ray, and are preserved by injective coefficient change. Over a Noetherian domain, they give a
bijection between the rays and the codimension-one points outside the dense-torus chart.

## References

* W. Fulton, *Introduction to Toric Varieties*, §3.1 and §3.3.
* P. Scholze, *Perfectoid spaces*, Publ. Math. IHÉS 116 (2012), §8,
  Definition/Proposition 8.4.
-/

public section

open AlgebraicGeometry AddMonoidAlgebra CategoryTheory
open TauCeti.AlgebraicGeometry (CodimensionOnePoint)
open scoped AlgebraMonoidAlgebra

namespace TauCeti.Toric.Fan.Ray

universe u

variable {N : Type u} {V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {Φ : Fan i} {σ τ : Φ.cones} (ρ : Φ.Ray)

/-- The chart characters orthogonal to the primitive ray generator form a submonoid.
It is a saturated additive face when the chart cone contains the ray. -/
noncomputable def boundaryFace (σ : Φ.cones) : AddSubmonoid (dualSemigroup Φ.lattice σ.val) :=
  (⊥ : AddSubmonoid ℤ).comap
    ((AddMonoidHom.eval ρ.primitiveGenerator).comp (dualSemigroup Φ.lattice σ.val).subtype)

@[simp]
theorem mem_boundaryFace (m : dualSemigroup Φ.lattice σ.val) :
    m ∈ ρ.boundaryFace σ ↔ (m : N →+ ℤ) ρ.primitiveGenerator = 0 := by
  simp [boundaryFace]

/-- When the chart cone contains the ray, vanishing of a sum of pairings forces both pairings
to vanish. -/
theorem addSaturated_boundaryFace (h : ρ.toCone ≤ σ) : (ρ.boundaryFace σ).AddSaturated := by
  intro a b hab
  have ha := (Φ.mem_dualSemigroup_iff_forall_ray_le σ a).1 a.property ρ h
  have hb := (Φ.mem_dualSemigroup_iff_forall_ray_le σ b).1 b.property ρ h
  simp only [mem_boundaryFace, AddSubmonoid.coe_add, AddMonoidHom.add_apply] at hab ⊢
  omega

/-- On the ray chart the ideal of the boundary is generated by any character of pairing one. -/
theorem faceIdeal_boundaryFace_eq_span_singleton (R : Type u) [CommSemiring R]
    (m : dualSemigroup Φ.lattice ρ.toCone.val)
    (hm : (m : N →+ ℤ) ρ.primitiveGenerator = 1) :
    (ρ.boundaryFace ρ.toCone).faceIdeal R = Ideal.span {single m (1 : R)} := by
  apply le_antisymm
  · rw [AddSubmonoid.faceIdeal_def]
    refine Ideal.span_le.2 ?_
    rintro _ ⟨a, ha, rfl⟩
    have ha₀ := (ρ.mem_dualSemigroup_iff a).1 a.property
    have ha₁ : (a : N →+ ℤ) ρ.primitiveGenerator ≠ 0 := mt (ρ.mem_boundaryFace a).2 ha
    have hsub : (a : N →+ ℤ) - m ∈ dualSemigroup Φ.lattice ρ.toCone.val := by
      rw [ρ.mem_dualSemigroup_iff, AddMonoidHom.sub_apply, hm]
      omega
    let b : dualSemigroup Φ.lattice ρ.toCone.val := ⟨_, hsub⟩
    refine Ideal.mem_span_singleton.2 ⟨single b 1, ?_⟩
    have hab : m + b = a := Subtype.ext (add_sub_cancel _ _)
    simp [single_mul_single, hab]
  · apply (Ideal.span_singleton_le_iff_mem _).2
    exact ((ρ.boundaryFace ρ.toCone).single_mem_faceIdeal_iff
      (ρ.addSaturated_boundaryFace le_rfl) m 1).2 (Or.inr (by simp [hm]))

variable (R : Type u) [CommRing R] [IsDomain R]

/-- The monomial prime giving the generic point of the ray boundary in a chart containing the
ray. Its quotient keeps exactly the characters orthogonal to the primitive generator. -/
noncomputable def boundaryChartPoint (h : ρ.toCone ≤ σ) : affineChart R Φ.lattice σ :=
  ⟨(ρ.boundaryFace σ).faceIdeal R,
    (ρ.boundaryFace σ).faceIdeal_isPrime (ρ.addSaturated_boundaryFace h)⟩

@[simp]
theorem asIdeal_boundaryChartPoint (h : ρ.toCone ≤ σ) :
    (ρ.boundaryChartPoint R h).asIdeal = (ρ.boundaryFace σ).faceIdeal R :=
  (rfl)

/-- On a chart containing the ray, a nonzero monomial vanishes at the boundary point exactly
when its pairing with the ray is positive. -/
theorem single_mem_asIdeal_boundaryChartPoint (h : ρ.toCone ≤ σ)
    (m : dualSemigroup Φ.lattice σ.val) {c : R} (hc : c ≠ 0) :
    single m c ∈ (ρ.boundaryChartPoint R h).asIdeal ↔
      0 < (m : N →+ ℤ) ρ.primitiveGenerator := by
  have hm := (Φ.mem_dualSemigroup_iff_forall_ray_le σ m).1 m.property ρ h
  rw [asIdeal_boundaryChartPoint, AddSubmonoid.single_mem_faceIdeal_iff _
    (ρ.addSaturated_boundaryFace h), ρ.mem_boundaryFace, or_iff_right hc]
  omega

variable [IsNoetherianRing R] in
/-- The monomial prime in the ray's own chart has height one. -/
theorem coheight_boundaryChartPoint :
    Order.coheight (α := affineChart R Φ.lattice ρ.toCone.val)
      (ρ.boundaryChartPoint R le_rfl) = 1 := by
  have : AddMonoid.FG (dualSemigroup Φ.lattice ρ.toCone.val) :=
    (Φ.isToricCone ρ.toCone.property).fg_dualSemigroup Φ.lattice
  have : IsNoetherianRing (affineChartRing R Φ.lattice ρ.toCone.val) :=
    Algebra.FiniteType.isNoetherianRing R _
  obtain ⟨m, hm⟩ := isPrimitive_def.1 ρ.primitiveGenerator_isPrimitive
  let a : dualSemigroup Φ.lattice ρ.toCone.val :=
    ⟨m.toAddMonoidHom, (ρ.mem_dualSemigroup_iff m.toAddMonoidHom).2 (by simp [hm])⟩
  have ha : (a : N →+ ℤ) ρ.primitiveGenerator = 1 := hm
  have hp := (ρ.boundaryChartPoint R le_rfl).isPrime
  rw [asIdeal_boundaryChartPoint, ρ.faceIdeal_boundaryFace_eq_span_singleton R a ha] at hp
  have hh : (Ideal.span {single a (1 : R)}).height = 1 :=
    Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero (single_ne_zero.2 one_ne_zero))
      (fun hu ↦ hp.ne_top (Ideal.span_singleton_eq_top.2 hu))
  exact (idealHeight_eq_coheight (.of _) (ρ.boundaryChartPoint R le_rfl)).symm.trans
    (by simpa only [asIdeal_boundaryChartPoint, ρ.faceIdeal_boundaryFace_eq_span_singleton R a ha]
      using hh)

/-- The generic point of a ray boundary is preserved by restriction between charts containing
the ray. -/
@[simp]
theorem faceAffineChartMap_boundaryChartPoint (hρ : ρ.toCone ≤ τ)
    (hτσ : τ.val.IsFaceOf σ.val) :
    faceAffineChartMap R Φ.lattice hτσ (ρ.boundaryChartPoint R hρ) =
      ρ.boundaryChartPoint R (hρ.trans hτσ.le) := by
  rw [faceAffineChartMap_def, Spec.map_apply, CommRingCat.hom_ofHom]
  apply PrimeSpectrum.ext
  refine (PrimeSpectrum.comap_asIdeal (faceAffineChartRingMap R Φ.lattice hτσ).toRingHom
    (ρ.boundaryChartPoint R hρ)).trans ?_
  rw [asIdeal_boundaryChartPoint, asIdeal_boundaryChartPoint, toRingHom_faceAffineChartRingMap]
  let j := AddSubmonoid.inclusion (dualSemigroup_anti Φ.lattice hτσ.le)
  have hface : (ρ.boundaryFace τ).comap j = ρ.boundaryFace σ := by
    ext m
    simp only [AddSubmonoid.mem_comap, mem_boundaryFace, j, AddSubmonoid.coe_inclusion]
  rw [← hface]
  exact (ρ.boundaryFace τ).faceIdeal_comap_mapDomainRingHom_of_injective
    (ρ.addSaturated_boundaryFace hρ) j (AddSubmonoid.inclusion_injective _)

/-- For a face inclusion, the boundary point is in the open image precisely when the face
contains the ray. -/
theorem boundaryChartPoint_mem_range_faceAffineChartMap_iff (hρ : ρ.toCone ≤ σ)
    (hτσ : τ.val.IsFaceOf σ.val) :
    ρ.boundaryChartPoint R hρ ∈ Set.range (faceAffineChartMap R Φ.lattice hτσ) ↔
      ρ.toCone ≤ τ := by
  refine ⟨?_, fun h ↦ ⟨_, ρ.faceAffineChartMap_boundaryChartPoint R h hτσ⟩⟩
  intro hx
  obtain ⟨m, hm, heq⟩ :=
    (Φ.isToricCone σ.property).rational.exists_mem_dualSemigroup_inf_ker_eq
      Φ.lattice hτσ
  let a : dualSemigroup Φ.lattice σ.val := ⟨m, hm⟩
  rw [range_faceAffineChartMap_of_eq R Φ.lattice (Φ.isToricCone σ.property).fg hτσ a heq] at hx
  have hnot := (PrimeSpectrum.mem_basicOpen (single a (1 : R)) (ρ.boundaryChartPoint R hρ)).1 hx
  rw [ρ.single_mem_asIdeal_boundaryChartPoint R hρ a one_ne_zero] at hnot
  by_contra hτ
  exact hnot (Φ.apply_primitiveGenerator_pos_of_inf_ker_eq_face hm heq hρ hτ)

section Noetherian

variable [IsNoetherianRing R]

/-- The generic point of the boundary divisor of a ray, as a native codimension-one point of
the toric scheme. -/
noncomputable def boundaryPoint : CodimensionOnePoint (Φ.finiteFanScheme R) :=
  CodimensionOnePoint.mapOfIsOpenImmersion
    (Φ.affineChartι R ρ.toCone)
    ⟨ρ.boundaryChartPoint R le_rfl, ρ.coheight_boundaryChartPoint R⟩

/-- In any chart containing the ray, the corresponding monomial prime represents the global
boundary point. -/
@[simp]
theorem affineChartι_boundaryChartPoint (h : ρ.toCone ≤ σ) :
    Φ.affineChartι R σ (ρ.boundaryChartPoint R h) =
      (ρ.boundaryPoint R : Φ.finiteFanScheme R) := by
  let hface := Φ.isFaceOf_of_le σ.property ρ.toCone.property h
  rw [boundaryPoint, CodimensionOnePoint.coe_mapOfIsOpenImmersion,
    ← Φ.faceAffineChartMap_comp_affineChartι R hface, Scheme.Hom.comp_apply,
    ρ.faceAffineChartMap_boundaryChartPoint R le_rfl hface]

/-- The boundary point belongs precisely to the affine charts whose cones contain its ray. -/
theorem boundaryPoint_mem_range_affineChartι_iff :
    (ρ.boundaryPoint R : Φ.finiteFanScheme R) ∈ Set.range (Φ.affineChartι R σ) ↔
      ρ.toCone ≤ σ := by
  refine ⟨?_, fun h ↦ ⟨_, ρ.affineChartι_boundaryChartPoint R h⟩⟩
  rintro ⟨y, hy⟩
  rw [← ρ.affineChartι_boundaryChartPoint R le_rfl] at hy
  obtain ⟨z, _, hz⟩ := (Φ.affineChartι_apply_eq_affineChartι_apply_iff R _ _).1 hy
  let hface := Φ.inf_isFaceOf_right σ.property ρ.toCone.property
  have hle : ρ.toCone ≤ σ ⊓ ρ.toCone :=
    (ρ.boundaryChartPoint_mem_range_faceAffineChartMap_iff R le_rfl hface).1 ⟨z, hz⟩
  exact hle.trans inf_le_left

/-- Distinct rays give distinct codimension-one points of the toric scheme. -/
theorem boundaryPoint_injective : Function.Injective (boundaryPoint (Φ := Φ) (R := R)) := by
  intro ρ₁ ρ₂ h
  dsimp only at h
  have h₁ := (ρ₁.boundaryPoint_mem_range_affineChartι_iff R (σ := ρ₂.toCone)).1 (by
    rw [h]
    exact (ρ₂.boundaryPoint_mem_range_affineChartι_iff R).2 le_rfl)
  have h₂ := (ρ₂.boundaryPoint_mem_range_affineChartι_iff R (σ := ρ₁.toCone)).1 (by
    rw [← h]
    exact (ρ₁.boundaryPoint_mem_range_affineChartι_iff R).2 le_rfl)
  exact Subtype.ext (le_antisymm h₁ h₂)

/-- On a chart containing the ray, the closure of its global boundary point has the
monomial face ideal as its defining prime. -/
theorem preimage_closure_boundaryPoint (h : ρ.toCone ≤ σ) :
    Φ.affineChartι R σ ⁻¹' closure ({(ρ.boundaryPoint R : Φ.finiteFanScheme R)} : Set _) =
      PrimeSpectrum.zeroLocus ((ρ.boundaryFace σ).faceIdeal R : Set _) := by
  rw [← ρ.affineChartι_boundaryChartPoint R h, ← Set.image_singleton]
  have hj := (Φ.affineChartι R σ).isOpenEmbedding
  rw [hj.isOpenMap.preimage_closure_eq_closure_preimage hj.continuous,
    Set.preimage_image_eq _ hj.injective]
  have hclosure := PrimeSpectrum.closure_singleton (ρ.boundaryChartPoint R h)
  rw [asIdeal_boundaryChartPoint] at hclosure
  exact hclosure

end Noetherian

variable (S : Type u) [CommRing S] [IsDomain S] [Algebra R S] [FaithfulSMul R S]

/-- Under an injective coefficient map the boundary point on a chart maps to the boundary point
for the same ray. -/
@[simp]
theorem specAlgebraMap_boundaryChartPoint (h : ρ.toCone ≤ σ) :
    Spec.algebraMap (affineChartRing R Φ.lattice σ) (affineChartRing S Φ.lattice σ)
      (ρ.boundaryChartPoint S h) = ρ.boundaryChartPoint R h := by
  rw [Spec.map_apply, CommRingCat.hom_ofHom]
  apply PrimeSpectrum.ext
  refine (PrimeSpectrum.comap_asIdeal
    (algebraMap (affineChartRing R Φ.lattice σ) (affineChartRing S Φ.lattice σ))
    (ρ.boundaryChartPoint S h)).trans ?_
  rw [asIdeal_boundaryChartPoint, asIdeal_boundaryChartPoint, AddMonoidAlgebra.algebraMap_def]
  exact (ρ.boundaryFace σ).faceIdeal_comap_mapRingHom_of_injective
    (ρ.addSaturated_boundaryFace h) (algebraMap R S) (FaithfulSMul.algebraMap_injective R S)

variable [IsNoetherianRing R] [IsNoetherianRing S] in
/-- Injective coefficient change sends each global boundary point to the point for the same
ray. -/
@[simp]
theorem finiteFanSchemeMap_boundaryPoint :
    Φ.finiteFanSchemeMap R S (ρ.boundaryPoint S) =
      (ρ.boundaryPoint R : Φ.finiteFanScheme R) := by
  rw [← ρ.affineChartι_boundaryChartPoint S le_rfl,
    ← Scheme.Hom.comp_apply, Φ.affineChartι_finiteFanSchemeMap R S, Scheme.Hom.comp_apply,
    ρ.specAlgebraMap_boundaryChartPoint R S, ρ.affineChartι_boundaryChartPoint R le_rfl]

end TauCeti.Toric.Fan.Ray

namespace TauCeti.Toric.Fan

variable {N : Type u} {V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {Φ : Fan i} (R : Type u) [CommRing R]

/-- On a minimal cone chart containing a point, every monomial that pairs positively with
some ray of the cone vanishes at the point. -/
private theorem single_mem_asIdeal_of_minimal_chart {x : Φ.finiteFanScheme R} {σ : Φ.cones}
    (hσ : Minimal (fun τ ↦ x ∈ Set.range (Φ.affineChartι R τ)) σ)
    (y : affineChart R Φ.lattice σ) (hy : Φ.affineChartι R σ y = x)
    {ρ : Φ.Ray} (hρ : ρ.toCone ≤ σ) (m : dualSemigroup Φ.lattice σ.val)
    (hm : 0 < (m : N →+ ℤ) ρ.primitiveGenerator) : single m (1 : R) ∈ y.asIdeal := by
  let hface := PointedCone.isFaceOf_inf_ker ((mem_dualSemigroup Φ.lattice m).1 m.property)
  let τ : Φ.cones := ⟨_, Φ.mem_of_isFaceOf σ.property hface⟩
  have hτlt : τ < σ := lt_of_le_not_ge hface.le fun h ↦ by
    have hv : i ρ.primitiveGenerator ∈ τ.val :=
      h (hρ ρ.primitiveGenerator_mem)
    have hm₀ := (PointedCone.mem_ofSubmodule_iff.mp (SetLike.mem_coe.mp hv).2)
    exact hm.ne' (by simpa only [LinearMap.mem_ker, Φ.lattice.realCharacter_apply,
      Int.cast_eq_zero] using hm₀)
  by_contra hnot
  have hyopen : y ∈ Set.range (faceAffineChartMap R Φ.lattice hface) := by
    rw [range_faceAffineChartMap R Φ.lattice (Φ.isToricCone σ.property).fg m]
    exact (PrimeSpectrum.mem_basicOpen (single m (1 : R)) y).2 hnot
  obtain ⟨z, hz⟩ := hyopen
  apply hσ.not_lt (y := τ) ⟨z, ?_⟩ hτlt
  rw [← hy, ← Φ.faceAffineChartMap_comp_affineChartι R hface, Scheme.Hom.comp_apply, hz]

variable [IsDomain R] [IsNoetherianRing R] in
/-- The ray boundary points are exactly the codimension-one points outside the dense-torus
chart, namely the chart of the zero cone. -/
theorem range_boundaryPoint (h₀ : (⊥ : PointedCone ℝ V) ∈ Φ.cones) :
    Set.range (fun ρ : Φ.Ray ↦ ρ.boundaryPoint R) =
      {x : CodimensionOnePoint (Φ.finiteFanScheme R) |
        (x : Φ.finiteFanScheme R) ∉ Set.range (Φ.affineChartι R ⟨⊥, h₀⟩)} := by
  ext x
  constructor
  · rintro ⟨ρ, rfl⟩ hx
    have h := (ρ.boundaryPoint_mem_range_affineChartι_iff R).1 hx
    exact ρ.toCone_ne_bot Φ (le_antisymm h bot_le)
  · intro hx
    have : WellFoundedLT Φ.cones := Finite.wellFounded_of_trans_of_irrefl _
    obtain ⟨σ, hσ⟩ := exists_minimal_of_wellFoundedLT
      (fun τ ↦ (x : Φ.finiteFanScheme R) ∈ Set.range (Φ.affineChartι R τ))
      (Φ.exists_affineChartι_apply_eq R x)
    obtain ⟨y, hy⟩ := hσ.prop
    have hne : σ.val ≠ ⊥ := fun heq ↦ by
      have heq' : σ = (⟨⊥, h₀⟩ : Φ.cones) := Subtype.ext heq
      exact hx (heq' ▸ hσ.prop)
    obtain ⟨ρ, hρ⟩ := Φ.exists_ray_le_of_ne_bot σ hne
    have hle : (ρ.boundaryChartPoint R hρ).asIdeal ≤ y.asIdeal := by
      rw [Ray.asIdeal_boundaryChartPoint, AddSubmonoid.faceIdeal_def]
      refine Ideal.span_le.2 ?_
      rintro _ ⟨m, hm, rfl⟩
      rw [of'_apply]
      have hm₀ := (Φ.mem_dualSemigroup_iff_forall_ray_le σ m).1 m.property ρ hρ
      have hm₁ : (m : N →+ ℤ) ρ.primitiveGenerator ≠ 0 := mt (ρ.mem_boundaryFace m).2 hm
      exact single_mem_asIdeal_of_minimal_chart R hσ y hy hρ m (lt_of_le_of_ne hm₀ hm₁.symm)
    have hspec := (PrimeSpectrum.le_iff_specializes _ _).1
      ((PrimeSpectrum.asIdeal_le_asIdeal _ _).1 hle)
    have hglobal := hspec.map (Φ.affineChartι R σ).continuous
    rw [ρ.affineChartι_boundaryChartPoint R hρ, hy] at hglobal
    exact ⟨ρ, CodimensionOnePoint.eq_of_specializes hglobal⟩

end TauCeti.Toric.Fan
