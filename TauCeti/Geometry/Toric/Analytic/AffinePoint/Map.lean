module

public import TauCeti.Geometry.Toric.Analytic.AffinePoint.Basic

/-!
# Functoriality of the complex points of an affine semigroup

A homomorphism `f : S →+ T` of commutative additive monoids induces the algebra homomorphism
`MonoidAlgebra.mapDomainAlgHom ℂ ℂ f.toMultiplicative` of monoid algebras, and restricting a
complex point of `T` along it gives a complex point of `S`. This file constructs that
contravariant map, `affinePointMap`, records the functor laws, and proves that it is continuous
for the monomial-embedding topologies of `AffinePoint.Basic`.

Continuity is stated for an arbitrary pair of finite generating families, one for the source and
one for the target monoid. Since `affinePointTopology_eq` identifies the topologies induced by
any two families, this is continuity for the topologies themselves: no compatibility between the
two chosen families is required, and neither choice matters.

A surjection of monoids presents a closed subspace: for such an `f` the map is a closed
embedding, and its image is the locus where the monomial coordinates respect the identifications
that `f` makes. An isomorphism of monoids gives a homeomorphism.

## Main declarations

* `TauCeti.Toric.affinePointMap`: the complex points of an affine semigroup, contravariantly in
  the semigroup.
* `TauCeti.Toric.affinePointMap_id`, `TauCeti.Toric.affinePointMap_comp`: the functor laws.
* `TauCeti.Toric.induced_affinePointMap_eq_iInf`: the topology pulled back along the map is the
  topology of the monomials in the image of `f`.
* `TauCeti.Toric.continuous_affinePointMap`: continuity for the monomial-embedding topologies.
* `TauCeti.Toric.range_affinePointMap`: for a surjection, the image is cut out by the monomial
  relations of the identifications it makes.
* `TauCeti.Toric.isClosedEmbedding_affinePointMap`: a surjection of monoids induces a closed
  embedding of complex points.
* `TauCeti.Toric.isHomeomorph_affinePointMap`: an isomorphism of monoids induces a
  homeomorphism of complex points.

## References

* D. Cox, J. Little and H. Schenck, *Toric Varieties*, §§1.1–1.3.
* W. Fulton, *Introduction to Toric Varieties*, §1.2.
-/

public section

open Multiplicative Topology

namespace TauCeti.Toric

variable {S T U : Type*} [AddCommMonoid S] [AddCommMonoid T] [AddCommMonoid U] {r r' : ℕ}

/-- The complex points of an affine semigroup, contravariantly in the semigroup: a complex point
of `T` is restricted along the map of monoid algebras induced by `f : S →+ T`. -/
noncomputable def affinePointMap (f : S →+ T) :
    AffineSemigroupComplexPoint T → AffineSemigroupComplexPoint S := fun x ↦
  x.comp (MonoidAlgebra.mapDomainAlgHom ℂ ℂ f.toMultiplicative)

/-- `affinePointMap` is restriction along the monoid-algebra map of `f`. -/
theorem affinePointMap_eq_comp (f : S →+ T) (x : AffineSemigroupComplexPoint T) :
    affinePointMap f x =
      x.comp (MonoidAlgebra.mapDomainAlgHom ℂ ℂ f.toMultiplicative) := (rfl)

/-- On monomials, `affinePointMap f` is evaluation at the image monomial. -/
@[simp]
theorem affinePointMap_apply_single (f : S →+ T) (x : AffineSemigroupComplexPoint T) (s : S) :
    affinePointMap f x (MonoidAlgebra.single (ofAdd s) 1) =
      x (MonoidAlgebra.single (ofAdd (f s)) 1) := by
  simp [affinePointMap, MonoidAlgebra.mapDomain_single]

/-- The identity homomorphism induces the identity map of complex points. -/
@[simp]
theorem affinePointMap_id : affinePointMap (AddMonoidHom.id S) = id :=
  funext fun _ ↦ affinePoint_ext fun _ ↦ by simp

/-- A composite of homomorphisms induces the composite map of complex points, in the opposite
order. -/
@[simp]
theorem affinePointMap_comp (g : T →+ U) (f : S →+ T) :
    affinePointMap (g.comp f) = affinePointMap f ∘ affinePointMap g :=
  funext fun _ ↦ affinePoint_ext fun _ ↦ by simp

/-- A surjection of monoids induces an injection of complex points. -/
theorem affinePointMap_injective (f : S →+ T) (hf : Function.Surjective f) :
    Function.Injective (affinePointMap f) := by
  intro x y hxy
  refine affinePoint_ext fun t ↦ ?_
  obtain ⟨s, rfl⟩ := hf t
  simpa using congrArg (fun z : AffineSemigroupComplexPoint S ↦
    z (MonoidAlgebra.single (ofAdd s) 1)) hxy

/-- Pulling the monomial-embedding topology of `S` back along `affinePointMap f` gives the
topology generated by evaluation at the monomials that lie in the image of `f`. -/
theorem induced_affinePointMap_eq_iInf (f : S →+ T) (g : AddGeneratingFamily S r) :
    TopologicalSpace.induced (affinePointMap f) (affinePointTopology g) =
      ⨅ s : S, TopologicalSpace.induced
        (fun x : AffineSemigroupComplexPoint T ↦ x (MonoidAlgebra.single (ofAdd (f s)) 1))
        inferInstance := by
  have key : ∀ s : S,
      (fun y : AffineSemigroupComplexPoint S ↦ y (MonoidAlgebra.single (ofAdd s) 1)) ∘
          affinePointMap f =
        fun x : AffineSemigroupComplexPoint T ↦ x (MonoidAlgebra.single (ofAdd (f s)) 1) :=
    fun s ↦ funext fun x ↦ by simp
  rw [affinePointTopology_eq_iInf g, induced_iInf]
  simp only [induced_compose, key]

/-- `affinePointMap f` is continuous for the monomial-embedding topologies: each monomial
coordinate of the image is a monomial coordinate of the argument. -/
theorem continuous_affinePointMap (f : S →+ T) (g : AddGeneratingFamily S r)
    (h : AddGeneratingFamily T r') :
    Continuous[affinePointTopology h, affinePointTopology g] (affinePointMap f) := by
  rw [continuous_iff_le_induced, induced_affinePointMap_eq_iInf f g]
  exact le_iInf fun s ↦ (continuous_apply_single h (f s)).le_induced

/-- The image of `affinePointMap f`, for a surjection `f`, is the set of complex points whose
monomial values agree wherever `f` identifies two monoid elements. -/
theorem range_affinePointMap (f : S →+ T) (hf : Function.Surjective f) :
    Set.range (affinePointMap f) =
      {y : AffineSemigroupComplexPoint S | ∀ s s' : S, f s = f s' →
        y (MonoidAlgebra.single (ofAdd s) 1) = y (MonoidAlgebra.single (ofAdd s') 1)} := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩ s s' hss'
    simp [hss']
  · intro hy
    choose σ hσ using hf
    -- `σ` chooses a preimage of each element of `T`; the relations satisfied by `y` make the
    -- value of `y` at the monomial of `σ t` independent of that choice, hence a character of `T`
    refine ⟨MonoidAlgebra.lift ℂ ℂ (Multiplicative T)
      ⟨⟨fun t ↦ y (MonoidAlgebra.single (ofAdd (σ (toAdd t))) 1), ?_⟩, fun t t' ↦ ?_⟩,
      affinePoint_ext fun s ↦ ?_⟩
    · refine (hy (σ (toAdd (1 : Multiplicative T))) 0 (by simp [hσ])).trans ?_
      simp [← MonoidAlgebra.one_def]
    · refine (hy (σ (toAdd (t * t'))) (σ (toAdd t) + σ (toAdd t')) (by simp [hσ])).trans ?_
      simpa using map_mul y (MonoidAlgebra.single (ofAdd (σ (toAdd t))) 1)
        (MonoidAlgebra.single (ofAdd (σ (toAdd t'))) 1)
    · simpa using hy (σ (f s)) s (hσ (f s))

/-- The image of a surjection is closed: it is cut out by equations between evaluations at
monomials, each of which is continuous. -/
theorem isClosed_range_affinePointMap (f : S →+ T) (hf : Function.Surjective f)
    (g : AddGeneratingFamily S r) :
    letI := affinePointTopology g
    IsClosed (Set.range (affinePointMap f)) := by
  let _ := affinePointTopology g
  rw [range_affinePointMap f hf]
  have hinter : {y : AffineSemigroupComplexPoint S | ∀ s s' : S, f s = f s' →
      y (MonoidAlgebra.single (ofAdd s) 1) = y (MonoidAlgebra.single (ofAdd s') 1)} =
      ⋂ s : S, ⋂ s' : S, ⋂ _ : f s = f s',
        {y : AffineSemigroupComplexPoint S |
          y (MonoidAlgebra.single (ofAdd s) 1) = y (MonoidAlgebra.single (ofAdd s') 1)} := by
    ext y; simp
  rw [hinter]
  exact isClosed_iInter fun s ↦ isClosed_iInter fun s' ↦ isClosed_iInter fun _ ↦
    isClosed_eq (continuous_apply_single g s) (continuous_apply_single g s')

/-- A surjection of monoids induces an embedding of complex points: every monomial of the target
monoid already occurs in the image of `f`, so the two monomial-embedding topologies agree. -/
theorem isInducing_affinePointMap (f : S →+ T) (hf : Function.Surjective f)
    (g : AddGeneratingFamily S r) (h : AddGeneratingFamily T r') :
    letI := affinePointTopology g
    letI := affinePointTopology h
    IsInducing (affinePointMap f) := by
  let _ := affinePointTopology g
  let _ := affinePointTopology h
  refine ⟨?_⟩
  rw [induced_affinePointMap_eq_iInf f g, affinePointTopology_eq_iInf h]
  exact (hf.iInf_comp fun t : T ↦ TopologicalSpace.induced
    (fun x : AffineSemigroupComplexPoint T ↦ x (MonoidAlgebra.single (ofAdd t) 1))
    inferInstance).symm

/-- A surjection of monoids induces a closed embedding of complex points, onto the closed subset
described by `range_affinePointMap`. -/
theorem isClosedEmbedding_affinePointMap (f : S →+ T) (hf : Function.Surjective f)
    (g : AddGeneratingFamily S r) (h : AddGeneratingFamily T r') :
    letI := affinePointTopology g
    letI := affinePointTopology h
    IsClosedEmbedding (affinePointMap f) := by
  let _ := affinePointTopology g
  let _ := affinePointTopology h
  exact ⟨⟨isInducing_affinePointMap f hf g h, affinePointMap_injective f hf⟩,
    isClosed_range_affinePointMap f hf g⟩

/-- An isomorphism of monoids induces a homeomorphism of complex points, so the complex points
depend only on the monoid and not on a presentation of it. -/
theorem isHomeomorph_affinePointMap (e : S ≃+ T) (g : AddGeneratingFamily S r)
    (h : AddGeneratingFamily T r') :
    letI := affinePointTopology g
    letI := affinePointTopology h
    IsHomeomorph (affinePointMap e.toAddMonoidHom) := by
  let _ := affinePointTopology g
  let _ := affinePointTopology h
  have hleft : e.symm.toAddMonoidHom.comp e.toAddMonoidHom = AddMonoidHom.id S :=
    AddMonoidHom.ext fun s ↦ by simp
  have hright : e.toAddMonoidHom.comp e.symm.toAddMonoidHom = AddMonoidHom.id T :=
    AddMonoidHom.ext fun t ↦ by simp
  have hTT : affinePointMap e.symm.toAddMonoidHom ∘ affinePointMap e.toAddMonoidHom =
      (id : AffineSemigroupComplexPoint T → AffineSemigroupComplexPoint T) := by
    rw [← affinePointMap_comp, hright, affinePointMap_id]
  have hSS : affinePointMap e.toAddMonoidHom ∘ affinePointMap e.symm.toAddMonoidHom =
      (id : AffineSemigroupComplexPoint S → AffineSemigroupComplexPoint S) := by
    rw [← affinePointMap_comp, hleft, affinePointMap_id]
  exact isHomeomorph_iff_exists_inverse.mpr
    ⟨continuous_affinePointMap _ g h, affinePointMap e.symm.toAddMonoidHom,
      congrFun hTT, congrFun hSS, continuous_affinePointMap _ h g⟩

end TauCeti.Toric
