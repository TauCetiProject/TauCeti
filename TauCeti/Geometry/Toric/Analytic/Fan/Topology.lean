module

public import TauCeti.Geometry.Toric.Algebraic.DualSemigroup.Separation
public import TauCeti.Geometry.Toric.Analytic.Fan.GlueData
public import TauCeti.Topology.Category.TopCat.GlueData

/-!
# Topology of the analytic realization of a regular fan

The analytic realization of a regular fan is Hausdorff, second countable and locally compact.

Second countability and local compactness hold because the realization is covered by finitely
many open affine analytic charts, each of which has these properties. Hausdorffness is where the
fan axioms enter. A space glued from open charts is Hausdorff exactly when the gluing relation
between any two charts is closed in their product. For the charts of two cones `σ` and `τ`, a point
of the first and a point of the second are identified exactly when they are restrictions of a
point of the chart of `σ ⊓ τ`. By the separation lemma the dual semigroup of `σ ⊓ τ` is generated
by those of `σ` and `τ`, so this happens exactly when the two points satisfy the binomial equations
`x(χˢ) y(χᵗ) = x(χˢ') y(χᵗ')` for `s + t = s' + t'`. These equations are closed conditions.

## Main declarations

* `TauCeti.Toric.Fan.isClosed_setOf_analyticAffineChartι_eq`: the gluing relation between two
  affine analytic charts is closed.
* `TauCeti.Toric.Fan.t2Space_analyticRealization`: the analytic realization is Hausdorff.
* `TauCeti.Toric.Fan.secondCountableTopology_analyticRealization` and
  `TauCeti.Toric.Fan.locallyCompactSpace_analyticRealization`: it is second countable and
  locally compact.

## References

* W. Fulton, *Introduction to Toric Varieties*, §1.4.
* D. Cox, J. Little and H. Schenck, *Toric Varieties*, §3.1.
-/

public section

open CategoryTheory Topology

namespace TauCeti.Toric.Fan

universe u

variable {N V : Type u} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} (Φ : Fan i) (hΦ : Φ.IsRegular)

/-- The points of the affine analytic charts of two cones `σ` and `τ` that are identified in the
analytic realization form a closed subset of the product of the two charts. -/
theorem isClosed_setOf_analyticAffineChartι_eq (σ τ : Φ.cones) :
    IsClosed {p : (Φ.analyticAffineChartDiagram).obj σ ×
        (Φ.analyticAffineChartDiagram).obj τ |
      Φ.analyticAffineChartι hΦ σ p.1 = Φ.analyticAffineChartι hΦ τ p.2} := by
  -- The overlap inclusions restrict points along the inclusions of dual semigroups, and the dual
  -- semigroup of `σ ⊓ τ` is generated by those of `σ` and `τ`.
  have hL : ∀ z, Φ.analyticOverlapLeft σ τ z = AffineSemigroupComplexPoint.comap
      (AddSubmonoid.inclusion (dualSemigroup_anti Φ.lattice inf_le_left)) z := fun z ↦ by
    rw [analyticOverlapLeft_def, analyticAffineChartDiagram_map_apply]
  have hR : ∀ z, Φ.analyticOverlapRight σ τ z = AffineSemigroupComplexPoint.comap
      (AddSubmonoid.inclusion (dualSemigroup_anti Φ.lattice inf_le_right)) z := fun z ↦ by
    rw [analyticOverlapRight_def, analyticAffineChartDiagram_map_apply]
  simp only [analyticAffineChartι_eq_analyticAffineChartι_iff, hL, hR]
  exact AffineSemigroupComplexPoint.isClosed_setOf_exists_comap_inclusion_eq _ _
    (Φ.dualSemigroup_inf_eq_sup σ.2 τ.2).le _ _

/-- The analytic realization of a regular fan is Hausdorff. -/
instance t2Space_analyticRealization : T2Space (Φ.analyticRealization hΦ) :=
  -- The indices are ascribed the type `Φ.cones` so that the chart inclusions can be rewritten.
  (Φ.analyticGlueData hΦ).t2Space_iff_isClosed_chartRel.2 fun (σ τ : Φ.cones) ↦ by
    have h : (Φ.analyticGlueData hΦ).chartRel σ τ =
        {p | Φ.analyticAffineChartι hΦ σ p.1 = Φ.analyticAffineChartι hΦ τ p.2} :=
      Set.ext fun _ ↦ by
        rw [Set.mem_ofPred_eq, analyticAffineChartι_def, analyticAffineChartι_def]
        exact (Φ.analyticGlueData hΦ).mem_chartRel_iff
    rw [h]
    exact Φ.isClosed_setOf_analyticAffineChartι_eq hΦ σ τ

/-- The analytic realization of a regular fan is second countable: it is covered by finitely many
second countable affine analytic charts. -/
instance secondCountableTopology_analyticRealization :
    SecondCountableTopology (Φ.analyticRealization hΦ) := by
  have : Countable (Φ.analyticGlueData hΦ).J := inferInstanceAs (Countable Φ.cones)
  have (σ : (Φ.analyticGlueData hΦ).J) : SecondCountableTopology ((Φ.analyticGlueData hΦ).U σ) :=
    Φ.secondCountableTopology_analyticAffineChart σ
  exact (Φ.analyticGlueData hΦ).secondCountableTopology

/-- The analytic realization of a regular fan is locally compact. -/
instance locallyCompactSpace_analyticRealization :
    LocallyCompactSpace (Φ.analyticRealization hΦ) := by
  have (σ : (Φ.analyticGlueData hΦ).J) : LocallyCompactSpace ((Φ.analyticGlueData hΦ).U σ) :=
    Φ.locallyCompactSpace_analyticAffineChart σ
  exact (Φ.analyticGlueData hΦ).locallyCompactSpace

end TauCeti.Toric.Fan
