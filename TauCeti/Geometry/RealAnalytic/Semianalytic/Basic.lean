/-!
# Semianalytic sets

A subset `s` of a real normed space `E` is *semianalytic at* a point `x` if, on some neighbourhood
`U` of `x`, it agrees with a finite Boolean combination of zero sets `{y | f y = 0}` and positivity
sets `{y | 0 < f y}` of real functions `f` analytic on `U`. The functions, the neighbourhood and the
Boolean formula may all depend on `x`. The set `s` is *semianalytic* if it is semianalytic at every
point of `E`, including the points outside `s` and its frontier points.

We record the finite Boolean combinations over a fixed set `U` as
`TauCeti.IsAnalyticBooleanCombination U t`: membership of `t` in the algebra of sets
(`MeasureTheory.generateSetAlgebra`) generated by the zero sets and positivity sets of the functions
analytic on `U`, in the same way as `TauCeti.IsSemialgebraic` is defined from polynomials.

## Main declarations

* `TauCeti.IsAnalyticBooleanCombination U t`: `t` is a finite Boolean combination of zero sets and
  positivity sets of functions analytic on `U`.
* `TauCeti.SemianalyticAt s x`: `s` is semianalytic at `x`.
* `TauCeti.IsSemianalytic s`: `s` is semianalytic at every point.

## Main results

* `TauCeti.IsAnalyticBooleanCombination.exists_eq_setOf_sign`: the *sign-condition normal form*;
  a finite Boolean combination over `U` is described by a condition on the signs of finitely many
  functions analytic on `U`.
* `TauCeti.SemianalyticAt.exists_subset`: a presentation exists on every sufficiently small
  neighbourhood, and `TauCeti.semianalyticAt_congr`: being semianalytic at `x` depends only on the
  germ of the set at `x`.
* `TauCeti.semianalyticAt_iff_exists_iUnion`: *equivalence of presentations*; near `x` a set is
  semianalytic if and only if it is a finite union of sets `{f = 0, g₁ > 0, …, gₖ > 0}` with
  `f, g₁, …, gₖ` analytic on the neighbourhood.
* Finite Boolean operations: `TauCeti.isSetAlgebra_setOf_semianalyticAt` and
  `TauCeti.isSetAlgebra_setOf_isSemianalytic`, with the named consequences, and
  `LocallyFinite.isSemianalytic_iUnion` for locally finite unions.
* `TauCeti.SemianalyticAt.preimage_of_analyticOnNhd`, `TauCeti.SemianalyticAt.preimage` and
  `TauCeti.IsSemianalytic.preimage`: preimages under analytic maps;
  `TauCeti.isSemianalytic_image_equiv_iff`: invariance under analytic isomorphisms, and
  `PartialEquiv.semianalyticAt_preimage_symm_iff`: its pointwise form for local analytic
  isomorphisms such as charts.
* `TauCeti.IsSemialgebraic.isSemianalytic`: semialgebraic subsets of `σ → ℝ` are semianalytic.

## References

S. Łojasiewicz, *Triangulation of semi-analytic sets*, Annali della Scuola Normale Superiore di Pisa
(3) 18 (1964), 449–474, §1, for the definition of semianalytic sets.

E. Bierstone and P. D. Milman, *Semianalytic and subanalytic sets*, Publications Mathématiques de
l'IHÉS 67 (1988), 5–42, §2, for the normal form with a single equation in each conjunct.
-/

public section

open Filter MeasureTheory Set Topology

namespace TauCeti

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-! ### Finite Boolean combinations of analytic sign conditions -/

/-- A set `t ⊆ E` is a *finite Boolean combination of analytic sign conditions on `U`* if it
belongs to the algebra of sets generated by the zero sets `{x | f x = 0}` and the positivity sets
`{x | 0 < f x}` of the real functions `f` analytic on `U`. Only the part of `t` inside `U` is
meaningful for semianalyticity. -/
def IsAnalyticBooleanCombination (U t : Set E) : Prop :=
  t ∈ generateSetAlgebra
    ({t | ∃ f : E → ℝ, AnalyticOnNhd ℝ f U ∧ t = {x | f x = 0}} ∪
      {t | ∃ f : E → ℝ, AnalyticOnNhd ℝ f U ∧ t = {x | 0 < f x}})

/-- A set is a finite Boolean combination of analytic sign conditions on `U` if and only if it
belongs to the algebra of sets generated by the zero sets and positivity sets of the functions
analytic on `U`. -/
theorem isAnalyticBooleanCombination_def {U t : Set E} :
    IsAnalyticBooleanCombination U t ↔ t ∈ generateSetAlgebra
      ({t | ∃ f : E → ℝ, AnalyticOnNhd ℝ f U ∧ t = {x | f x = 0}} ∪
        {t | ∃ f : E → ℝ, AnalyticOnNhd ℝ f U ∧ t = {x | 0 < f x}}) :=
  Iff.rfl

/-- The zero set of a function analytic on `U` is a Boolean combination of analytic sign
conditions on `U`. -/
theorem isAnalyticBooleanCombination_setOf_eq_zero {U : Set E} {f : E → ℝ}
    (hf : AnalyticOnNhd ℝ f U) : IsAnalyticBooleanCombination U {x | f x = 0} :=
  self_subset_generateSetAlgebra (Or.inl ⟨f, hf, rfl⟩)

/-- The positivity set of a function analytic on `U` is a Boolean combination of analytic sign
conditions on `U`. -/
theorem isAnalyticBooleanCombination_setOf_pos {U : Set E} {f : E → ℝ}
    (hf : AnalyticOnNhd ℝ f U) : IsAnalyticBooleanCombination U {x | 0 < f x} :=
  self_subset_generateSetAlgebra (Or.inr ⟨f, hf, rfl⟩)

/-- The finite Boolean combinations of analytic sign conditions on `U` form an algebra of sets. -/
theorem isSetAlgebra_setOf_isAnalyticBooleanCombination (U : Set E) :
    IsSetAlgebra {t : Set E | IsAnalyticBooleanCombination U t} :=
  isSetAlgebra_generateSetAlgebra

/-- The finite Boolean combinations of analytic sign conditions on `U` form the smallest algebra of
sets containing the zero set and the positivity set of every function analytic on `U`. -/
theorem setOf_isAnalyticBooleanCombination_subset {U : Set E} {ℬ : Set (Set E)}
    (hℬ : IsSetAlgebra ℬ)
    (eq_zero : ∀ f : E → ℝ, AnalyticOnNhd ℝ f U → {x | f x = 0} ∈ ℬ)
    (pos : ∀ f : E → ℝ, AnalyticOnNhd ℝ f U → {x | 0 < f x} ∈ ℬ) :
    {t : Set E | IsAnalyticBooleanCombination U t} ⊆ ℬ :=
  hℬ.generateSetAlgebra_subset <| union_subset (fun _ ⟨f, hf, h⟩ => h ▸ eq_zero f hf)
    (fun _ ⟨f, hf, h⟩ => h ▸ pos f hf)

/-- The empty set is a Boolean combination of analytic sign conditions. -/
@[simp]
theorem isAnalyticBooleanCombination_empty (U : Set E) :
    IsAnalyticBooleanCombination U (∅ : Set E) :=
  (isSetAlgebra_setOf_isAnalyticBooleanCombination U).empty_mem

/-- The whole space is a Boolean combination of analytic sign conditions. -/
@[simp]
theorem isAnalyticBooleanCombination_univ (U : Set E) :
    IsAnalyticBooleanCombination U (univ : Set E) :=
  (isSetAlgebra_setOf_isAnalyticBooleanCombination U).univ_mem

namespace IsAnalyticBooleanCombination

variable {U V t t' : Set E}

/-- The complement of a Boolean combination of analytic sign conditions is one. -/
theorem compl (ht : IsAnalyticBooleanCombination U t) : IsAnalyticBooleanCombination U tᶜ :=
  (isSetAlgebra_setOf_isAnalyticBooleanCombination U).compl_mem ht

/-- The union of two Boolean combinations of analytic sign conditions is one. -/
theorem union (ht : IsAnalyticBooleanCombination U t) (ht' : IsAnalyticBooleanCombination U t') :
    IsAnalyticBooleanCombination U (t ∪ t') :=
  (isSetAlgebra_setOf_isAnalyticBooleanCombination U).union_mem ht ht'

/-- The intersection of two Boolean combinations of analytic sign conditions is one. -/
theorem inter (ht : IsAnalyticBooleanCombination U t) (ht' : IsAnalyticBooleanCombination U t') :
    IsAnalyticBooleanCombination U (t ∩ t') :=
  (isSetAlgebra_setOf_isAnalyticBooleanCombination U).inter_mem ht ht'

/-- The difference of two Boolean combinations of analytic sign conditions is one. -/
theorem sdiff (ht : IsAnalyticBooleanCombination U t) (ht' : IsAnalyticBooleanCombination U t') :
    IsAnalyticBooleanCombination U (t \ t') :=
  (isSetAlgebra_setOf_isAnalyticBooleanCombination U).sdiff_mem ht ht'

/-- A finite union of Boolean combinations of analytic sign conditions is one. -/
protected theorem biUnion {ι : Type*} {I : Set ι} (hI : I.Finite) {t : ι → Set E}
    (ht : ∀ i ∈ I, IsAnalyticBooleanCombination U (t i)) :
    IsAnalyticBooleanCombination U (⋃ i ∈ I, t i) := by
  simpa using (isSetAlgebra_setOf_isAnalyticBooleanCombination U).biUnion_mem hI.toFinset
    fun i hi => ht i (hI.mem_toFinset.1 hi)

/-- A finite intersection of Boolean combinations of analytic sign conditions is one. -/
protected theorem biInter {ι : Type*} {I : Set ι} (hI : I.Finite) {t : ι → Set E}
    (ht : ∀ i ∈ I, IsAnalyticBooleanCombination U (t i)) :
    IsAnalyticBooleanCombination U (⋂ i ∈ I, t i) := by
  simpa using (isSetAlgebra_setOf_isAnalyticBooleanCombination U).biInter_mem hI.toFinset
    fun i hi => ht i (hI.mem_toFinset.1 hi)

/-- The union of a finite family of Boolean combinations of analytic sign conditions is one. -/
protected theorem iUnion {ι : Type*} [Finite ι] {t : ι → Set E}
    (ht : ∀ i, IsAnalyticBooleanCombination U (t i)) :
    IsAnalyticBooleanCombination U (⋃ i, t i) := by
  simpa using IsAnalyticBooleanCombination.biUnion finite_univ fun i (_ : i ∈ univ) => ht i

/-- The intersection of a finite family of Boolean combinations of analytic sign conditions is
one. -/
protected theorem iInter {ι : Type*} [Finite ι] {t : ι → Set E}
    (ht : ∀ i, IsAnalyticBooleanCombination U (t i)) :
    IsAnalyticBooleanCombination U (⋂ i, t i) := by
  simpa using IsAnalyticBooleanCombination.biInter finite_univ fun i (_ : i ∈ univ) => ht i

/-- A Boolean combination of sign conditions of functions analytic on `U` is also one for
functions analytic on any smaller set `V ⊆ U`. -/
theorem mono (ht : IsAnalyticBooleanCombination U t) (hVU : V ⊆ U) :
    IsAnalyticBooleanCombination V t :=
  setOf_isAnalyticBooleanCombination_subset (isSetAlgebra_setOf_isAnalyticBooleanCombination V)
    (fun _ hf => isAnalyticBooleanCombination_setOf_eq_zero (hf.mono hVU))
    (fun _ hf => isAnalyticBooleanCombination_setOf_pos (hf.mono hVU)) ht

/-- The preimage of a Boolean combination of analytic sign conditions on `U` under a map `g`
analytic on `V` and mapping `V` into `U` is a Boolean combination of analytic sign conditions
on `V`. -/
theorem preimage {U : Set F} {t : Set F} (ht : IsAnalyticBooleanCombination U t) {g : E → F}
    (hg : AnalyticOnNhd ℝ g V) (hgVU : MapsTo g V U) :
    IsAnalyticBooleanCombination V (g ⁻¹' t) := by
  refine setOf_isAnalyticBooleanCombination_subset (ℬ := {t | IsAnalyticBooleanCombination V
    (g ⁻¹' t)}) ⟨?_, fun s hs => ?_, fun s s' hs hs' => ?_⟩
    (fun f hf => isAnalyticBooleanCombination_setOf_eq_zero (hf.comp hg hgVU))
    (fun f hf => isAnalyticBooleanCombination_setOf_pos (hf.comp hg hgVU)) ht
  · exact isAnalyticBooleanCombination_empty V
  · exact IsAnalyticBooleanCombination.compl hs
  · exact IsAnalyticBooleanCombination.union hs hs'

end IsAnalyticBooleanCombination

/-- The set where a function analytic on `U` has a prescribed sign is a Boolean combination of
analytic sign conditions on `U`. -/
theorem isAnalyticBooleanCombination_setOf_sign_eq {U : Set E} {f : E → ℝ}
    (hf : AnalyticOnNhd ℝ f U) (ε : SignType) :
    IsAnalyticBooleanCombination U {x | SignType.sign (f x) = ε} := by
  rcases ε with _ | _ | _
  · simpa only [SignType.zero_eq_zero, sign_eq_zero_iff] using
      isAnalyticBooleanCombination_setOf_eq_zero hf
  · simpa only [SignType.neg_eq_neg_one, sign_eq_neg_one_iff, Pi.neg_apply, neg_pos] using
      isAnalyticBooleanCombination_setOf_pos hf.neg
  · simpa only [SignType.pos_eq_one, sign_eq_one_iff] using
      isAnalyticBooleanCombination_setOf_pos hf

/-- A condition on the signs of finitely many functions analytic on `U` defines a Boolean
combination of analytic sign conditions on `U`. -/
theorem isAnalyticBooleanCombination_setOf_sign {U : Set E} {ι : Type*} [Finite ι]
    {f : ι → E → ℝ} (hf : ∀ i, AnalyticOnNhd ℝ (f i) U) (Φ : (ι → SignType) → Prop) :
    IsAnalyticBooleanCombination U {x | Φ fun i => SignType.sign (f i x)} := by
  rw [setOf_apply_eq_biUnion_iInter (fun i x => SignType.sign (f i x))]
  exact .biUnion (toFinite _) fun ε _ =>
    .iInter fun i => isAnalyticBooleanCombination_setOf_sign_eq (hf i) (ε i)

/-- **Sign-condition normal form.** A Boolean combination of analytic sign conditions on `U` is
described by a condition on the signs of finitely many functions analytic on `U`. -/
theorem IsAnalyticBooleanCombination.exists_eq_setOf_sign {U t : Set E}
    (ht : IsAnalyticBooleanCombination U t) :
    ∃ (m : ℕ) (f : Fin m → E → ℝ), (∀ i, AnalyticOnNhd ℝ (f i) U) ∧
      ∃ Φ : (Fin m → SignType) → Prop, t = {x | Φ fun i => SignType.sign (f i x)} :=
  exists_eq_setOf_sign_of_mem_generateSetAlgebra ht

/-! ### Semianalyticity at a point -/

/-- A set `s ⊆ E` is *semianalytic at* `x` if on some neighbourhood `U` of `x` it agrees with a
finite Boolean combination of zero sets and positivity sets of real functions analytic on `U`. -/
def SemianalyticAt (s : Set E) (x : E) : Prop :=
  ∃ U ∈ 𝓝 x, ∃ t, IsAnalyticBooleanCombination U t ∧ s ∩ U = t ∩ U

/-- A set is semianalytic at `x` if and only if on some neighbourhood `U` of `x` it agrees with a
finite Boolean combination of zero sets and positivity sets of real functions analytic on `U`. -/
theorem semianalyticAt_def {s : Set E} {x : E} :
    SemianalyticAt s x ↔ ∃ U ∈ 𝓝 x, ∃ t, IsAnalyticBooleanCombination U t ∧ s ∩ U = t ∩ U :=
  Iff.rfl

/-- **Shrinking invariance.** If `s` is semianalytic at `x`, then it has a presentation on a
neighbourhood of `x` inside any prescribed neighbourhood `V` of `x`. -/
theorem SemianalyticAt.exists_subset {s V : Set E} {x : E} (hs : SemianalyticAt s x)
    (hV : V ∈ 𝓝 x) :
    ∃ U ∈ 𝓝 x, U ⊆ V ∧ ∃ t, IsAnalyticBooleanCombination U t ∧ s ∩ U = t ∩ U := by
  obtain ⟨U, hU, t, ht, hst⟩ := hs
  refine ⟨U ∩ V, inter_mem hU hV, inter_subset_right, t, ht.mono inter_subset_left, ?_⟩
  rw [← inter_assoc, hst, inter_assoc]

/-- Being semianalytic at `x` only depends on the germ of the set at `x`. -/
theorem SemianalyticAt.congr {s s' : Set E} {x : E} (hs : SemianalyticAt s x)
    (h : s =ᶠ[𝓝 x] s') : SemianalyticAt s' x := by
  obtain ⟨U, hU, hUs, t, ht, hst⟩ := hs.exists_subset (eventuallyEqSet_iff.1 h)
  refine ⟨U, hU, t, ht, ?_⟩
  rw [← hst]
  ext y
  simp only [mem_inter_iff, and_congr_left_iff]
  exact fun hy => (hUs hy).symm

/-- Being semianalytic at `x` only depends on the germ of the set at `x`. -/
theorem semianalyticAt_congr {s s' : Set E} {x : E} (h : s =ᶠ[𝓝 x] s') :
    SemianalyticAt s x ↔ SemianalyticAt s' x :=
  ⟨fun hs => hs.congr h, fun hs => hs.congr h.symm⟩

/-- The zero set of a function analytic at `x` is semianalytic at `x`. -/
theorem _root_.AnalyticAt.semianalyticAt_setOf_eq_zero {f : E → ℝ} {x : E}
    (hf : AnalyticAt ℝ f x) : SemianalyticAt {y | f y = 0} x :=
  let ⟨U, hU, hfU⟩ := hf.exists_mem_nhds_analyticOnNhd
  ⟨U, hU, _, isAnalyticBooleanCombination_setOf_eq_zero hfU, rfl⟩

/-- The positivity set of a function analytic at `x` is semianalytic at `x`. -/
theorem _root_.AnalyticAt.semianalyticAt_setOf_pos {f : E → ℝ} {x : E}
    (hf : AnalyticAt ℝ f x) : SemianalyticAt {y | 0 < f y} x :=
  let ⟨U, hU, hfU⟩ := hf.exists_mem_nhds_analyticOnNhd
  ⟨U, hU, _, isAnalyticBooleanCombination_setOf_pos hfU, rfl⟩

/-- The sets semianalytic at a point form an algebra of sets. -/
theorem isSetAlgebra_setOf_semianalyticAt (x : E) :
    IsSetAlgebra {s : Set E | SemianalyticAt s x} where
  empty_mem := ⟨univ, univ_mem, ∅, isAnalyticBooleanCombination_empty univ, rfl⟩
  compl_mem := by
    rintro s ⟨U, hU, t, ht, hst⟩
    refine ⟨U, hU, tᶜ, ht.compl, ?_⟩
    ext y
    have := Set.ext_iff.1 hst y
    simp only [mem_inter_iff, mem_compl_iff] at this ⊢
    tauto
  union_mem := by
    rintro s s' hs ⟨U', hU', t', ht', hst'⟩
    obtain ⟨U, hU, hUU', t, ht, hst⟩ := hs.exists_subset hU'
    refine ⟨U, hU, t ∪ t', ht.union (ht'.mono hUU'), ?_⟩
    ext y
    have h₁ := Set.ext_iff.1 hst y
    have h₂ := Set.ext_iff.1 hst' y
    have h₃ := @hUU' y
    simp only [mem_inter_iff, mem_union] at h₁ h₂ ⊢
    tauto

section SemianalyticAt

variable {s s' : Set E} {x : E}

/-- The empty set is semianalytic at every point. -/
@[simp]
theorem semianalyticAt_empty : SemianalyticAt (∅ : Set E) x :=
  (isSetAlgebra_setOf_semianalyticAt x).empty_mem

/-- The whole space is semianalytic at every point. -/
@[simp]
theorem semianalyticAt_univ : SemianalyticAt (univ : Set E) x :=
  (isSetAlgebra_setOf_semianalyticAt x).univ_mem

/-- The complement of a set semianalytic at `x` is semianalytic at `x`. -/
theorem SemianalyticAt.compl (hs : SemianalyticAt s x) : SemianalyticAt sᶜ x :=
  (isSetAlgebra_setOf_semianalyticAt x).compl_mem hs

/-- A set is semianalytic at `x` if and only if its complement is. -/
@[simp]
theorem semianalyticAt_compl_iff : SemianalyticAt sᶜ x ↔ SemianalyticAt s x :=
  ⟨fun hs => compl_compl s ▸ hs.compl, SemianalyticAt.compl⟩

/-- The union of two sets semianalytic at `x` is semianalytic at `x`. -/
theorem SemianalyticAt.union (hs : SemianalyticAt s x) (hs' : SemianalyticAt s' x) :
    SemianalyticAt (s ∪ s') x :=
  (isSetAlgebra_setOf_semianalyticAt x).union_mem hs hs'

/-- The intersection of two sets semianalytic at `x` is semianalytic at `x`. -/
theorem SemianalyticAt.inter (hs : SemianalyticAt s x) (hs' : SemianalyticAt s' x) :
    SemianalyticAt (s ∩ s') x :=
  (isSetAlgebra_setOf_semianalyticAt x).inter_mem hs hs'

/-- The difference of two sets semianalytic at `x` is semianalytic at `x`. -/
theorem SemianalyticAt.sdiff (hs : SemianalyticAt s x) (hs' : SemianalyticAt s' x) :
    SemianalyticAt (s \ s') x :=
  (isSetAlgebra_setOf_semianalyticAt x).sdiff_mem hs hs'

/-- A finite union of sets semianalytic at `x` is semianalytic at `x`. -/
theorem SemianalyticAt.biUnion {ι : Type*} {I : Set ι} (hI : I.Finite) {s : ι → Set E}
    (hs : ∀ i ∈ I, SemianalyticAt (s i) x) : SemianalyticAt (⋃ i ∈ I, s i) x := by
  simpa using (isSetAlgebra_setOf_semianalyticAt x).biUnion_mem hI.toFinset
    fun i hi => hs i (hI.mem_toFinset.1 hi)

/-- A finite intersection of sets semianalytic at `x` is semianalytic at `x`. -/
theorem SemianalyticAt.biInter {ι : Type*} {I : Set ι} (hI : I.Finite) {s : ι → Set E}
    (hs : ∀ i ∈ I, SemianalyticAt (s i) x) : SemianalyticAt (⋂ i ∈ I, s i) x := by
  simpa using (isSetAlgebra_setOf_semianalyticAt x).biInter_mem hI.toFinset
    fun i hi => hs i (hI.mem_toFinset.1 hi)

/-- The union of a finite family of sets semianalytic at `x` is semianalytic at `x`. -/
theorem SemianalyticAt.iUnion {ι : Type*} [Finite ι] {s : ι → Set E}
    (hs : ∀ i, SemianalyticAt (s i) x) : SemianalyticAt (⋃ i, s i) x := by
  simpa using SemianalyticAt.biUnion finite_univ fun i (_ : i ∈ univ) => hs i

/-- The intersection of a finite family of sets semianalytic at `x` is semianalytic at `x`. -/
theorem SemianalyticAt.iInter {ι : Type*} [Finite ι] {s : ι → Set E}
    (hs : ∀ i, SemianalyticAt (s i) x) : SemianalyticAt (⋂ i, s i) x := by
  simpa using SemianalyticAt.biInter finite_univ fun i (_ : i ∈ univ) => hs i

/-- **Analytic preimages.** The preimage of a set semianalytic at `g x` under a map `g` analytic
on a neighbourhood `W` of `x` is semianalytic at `x`. -/
theorem SemianalyticAt.preimage_of_analyticOnNhd {s : Set F} {g : E → F} {W : Set E}
    (hs : SemianalyticAt s (g x)) (hW : W ∈ 𝓝 x) (hg : AnalyticOnNhd ℝ g W) :
    SemianalyticAt (g ⁻¹' s) x := by
  obtain ⟨U, hU, t, ht, hst⟩ := hs
  refine ⟨W ∩ g ⁻¹' U,
    inter_mem hW ((hg x (mem_of_mem_nhds hW)).continuousAt.preimage_mem_nhds hU), g ⁻¹' t,
    ht.preimage (hg.mono inter_subset_left) fun _ hy => hy.2, ?_⟩
  ext y
  have := Set.ext_iff.1 hst (g y)
  simp only [mem_inter_iff, mem_preimage] at this ⊢
  tauto

/-- **Analytic preimages.** The preimage of a set semianalytic at `g x` under a map `g` analytic
at `x` is semianalytic at `x`. -/
theorem SemianalyticAt.preimage [CompleteSpace F] {s : Set F} {g : E → F}
    (hs : SemianalyticAt s (g x)) (hg : AnalyticAt ℝ g x) : SemianalyticAt (g ⁻¹' s) x :=
  let ⟨_, hW, hgW⟩ := hg.exists_mem_nhds_analyticOnNhd
  hs.preimage_of_analyticOnNhd hW hgW

end SemianalyticAt

/-! ### Equivalence of presentations -/

/-- **Equivalence of presentations.** A set is semianalytic at `x` if and only if, on some
neighbourhood `U` of `x`, it agrees with a finite union of sets
`{y | f y = 0 ∧ 0 < g₁ y ∧ ⋯ ∧ 0 < gₖ y}` with `f, g₁, …, gₖ` analytic on `U`. -/
theorem semianalyticAt_iff_exists_iUnion {s : Set E} {x : E} :
    SemianalyticAt s x ↔ ∃ U ∈ 𝓝 x, ∃ (m k : ℕ) (f : Fin m → E → ℝ)
      (g : Fin m → Fin k → E → ℝ), (∀ i, AnalyticOnNhd ℝ (f i) U) ∧
        (∀ i j, AnalyticOnNhd ℝ (g i j) U) ∧
          s ∩ U = (⋃ i, {y | f i y = 0} ∩ ⋂ j, {y | 0 < g i j y}) ∩ U := by
  refine ⟨fun ⟨U, hU, t, ht, hst⟩ => ?_, fun ⟨U, hU, m, k, f, g, hf, hg, hst⟩ => ⟨U, hU, _,
    ?_, hst⟩⟩
  · obtain ⟨n, f, hf, Φ, rfl⟩ := ht.exists_eq_setOf_sign
    let e := Finite.equivFin {ε : Fin n → SignType // Φ ε}
    refine ⟨U, hU, _, n, fun i y => ∑ j with (e.symm i).1 j = 0, f j y ^ 2,
      fun i j => if (e.symm i).1 j = 0 then fun _ => 1 else fun y => ((e.symm i).1 j : ℝ) * f j y,
      fun i => Finset.analyticOnNhd_fun_sum _ fun j _ => (hf j).pow 2, fun i j => ?_, ?_⟩
    · dsimp only
      split_ifs
      exacts [analyticOnNhd_const, analyticOnNhd_const.mul (hf j)]
    · rw [hst]
      congr 1
      ext y
      simp only [mem_ofPred_eq, mem_iUnion, mem_inter_iff, mem_iInter]
      refine ⟨fun h => ⟨e ⟨_, h⟩, ?_⟩, fun ⟨i, h⟩ => ?_⟩
      · simpa [apply_ite (fun g : E → ℝ => g y)] using
          (forall_sign_eq_iff_sum_sq_eq_zero_and_pos (fun j => f j y) _).1 fun _ => rfl
      · have hε := (forall_sign_eq_iff_sum_sq_eq_zero_and_pos (fun j => f j y) (e.symm i).1).2
          (by simpa [apply_ite (fun g : E → ℝ => g y)] using h)
        exact (funext hε : (fun j => SignType.sign (f j y)) = _) ▸ (e.symm i).2
  · exact .iUnion fun i => (isAnalyticBooleanCombination_setOf_eq_zero (hf i)).inter
      (.iInter fun j => isAnalyticBooleanCombination_setOf_pos (hg i j))

/-! ### Semianalytic sets -/

/-- A set `s ⊆ E` is *semianalytic* if it is semianalytic at every point of `E`: near every point,
it agrees with a finite Boolean combination of zero sets and positivity sets of real analytic
functions defined near that point. -/
def IsSemianalytic (s : Set E) : Prop :=
  ∀ x, SemianalyticAt s x

/-- A set is semianalytic if and only if it is semianalytic at every point. -/
theorem isSemianalytic_iff {s : Set E} : IsSemianalytic s ↔ ∀ x, SemianalyticAt s x :=
  Iff.rfl

/-- A semianalytic set is semianalytic at every point. -/
theorem IsSemianalytic.semianalyticAt {s : Set E} (hs : IsSemianalytic s) (x : E) :
    SemianalyticAt s x :=
  hs x

/-- The zero set of a real analytic function is semianalytic. -/
theorem _root_.AnalyticOnNhd.isSemianalytic_setOf_eq_zero {f : E → ℝ}
    (hf : AnalyticOnNhd ℝ f univ) : IsSemianalytic {x | f x = 0} :=
  fun x => (hf x (mem_univ x)).semianalyticAt_setOf_eq_zero

/-- The positivity set of a real analytic function is semianalytic. -/
theorem _root_.AnalyticOnNhd.isSemianalytic_setOf_pos {f : E → ℝ}
    (hf : AnalyticOnNhd ℝ f univ) : IsSemianalytic {x | 0 < f x} :=
  fun x => (hf x (mem_univ x)).semianalyticAt_setOf_pos

variable (E) in
/-- The semianalytic sets form an algebra of sets. -/
theorem isSetAlgebra_setOf_isSemianalytic : IsSetAlgebra {s : Set E | IsSemianalytic s} where
  empty_mem _ := semianalyticAt_empty
  compl_mem _ hs x := (hs x).compl
  union_mem _ _ hs hs' x := (hs x).union (hs' x)

/-- The empty set is semianalytic. -/
@[simp]
theorem isSemianalytic_empty : IsSemianalytic (∅ : Set E) :=
  (isSetAlgebra_setOf_isSemianalytic E).empty_mem

/-- The whole space is semianalytic. -/
@[simp]
theorem isSemianalytic_univ : IsSemianalytic (univ : Set E) :=
  (isSetAlgebra_setOf_isSemianalytic E).univ_mem

namespace IsSemianalytic

variable {s s' : Set E}

/-- The complement of a semianalytic set is semianalytic. -/
protected theorem compl (hs : IsSemianalytic s) : IsSemianalytic sᶜ :=
  fun x => (hs x).compl

/-- The union of two semianalytic sets is semianalytic. -/
protected theorem union (hs : IsSemianalytic s) (hs' : IsSemianalytic s') :
    IsSemianalytic (s ∪ s') :=
  fun x => (hs x).union (hs' x)

/-- The intersection of two semianalytic sets is semianalytic. -/
protected theorem inter (hs : IsSemianalytic s) (hs' : IsSemianalytic s') :
    IsSemianalytic (s ∩ s') :=
  fun x => (hs x).inter (hs' x)

/-- The difference of two semianalytic sets is semianalytic. -/
protected theorem sdiff (hs : IsSemianalytic s) (hs' : IsSemianalytic s') :
    IsSemianalytic (s \ s') :=
  fun x => (hs x).sdiff (hs' x)

/-- A finite union of semianalytic sets is semianalytic. -/
protected theorem biUnion {ι : Type*} {I : Set ι} (hI : I.Finite) {s : ι → Set E}
    (hs : ∀ i ∈ I, IsSemianalytic (s i)) : IsSemianalytic (⋃ i ∈ I, s i) :=
  fun x => .biUnion hI fun i hi => hs i hi x

/-- A finite intersection of semianalytic sets is semianalytic. -/
protected theorem biInter {ι : Type*} {I : Set ι} (hI : I.Finite) {s : ι → Set E}
    (hs : ∀ i ∈ I, IsSemianalytic (s i)) : IsSemianalytic (⋂ i ∈ I, s i) :=
  fun x => .biInter hI fun i hi => hs i hi x

/-- The union of a finite family of semianalytic sets is semianalytic. -/
protected theorem iUnion {ι : Type*} [Finite ι] {s : ι → Set E}
    (hs : ∀ i, IsSemianalytic (s i)) : IsSemianalytic (⋃ i, s i) :=
  fun x => .iUnion fun i => hs i x

/-- The intersection of a finite family of semianalytic sets is semianalytic. -/
protected theorem iInter {ι : Type*} [Finite ι] {s : ι → Set E}
    (hs : ∀ i, IsSemianalytic (s i)) : IsSemianalytic (⋂ i, s i) :=
  fun x => .iInter fun i => hs i x

/-- **Analytic preimages.** The preimage of a semianalytic set under a real analytic map is
semianalytic. -/
protected theorem preimage {s : Set F} (hs : IsSemianalytic s) {g : E → F}
    (hg : AnalyticOnNhd ℝ g univ) : IsSemianalytic (g ⁻¹' s) :=
  fun x => (hs (g x)).preimage_of_analyticOnNhd univ_mem hg

end IsSemianalytic

/-- A set is semianalytic if and only if its complement is. -/
@[simp]
theorem isSemianalytic_compl_iff {s : Set E} : IsSemianalytic sᶜ ↔ IsSemianalytic s :=
  forall_congr' fun _ => semianalyticAt_compl_iff

/-- **Locally finite unions.** The union of a locally finite family of semianalytic sets is
semianalytic. -/
theorem _root_.LocallyFinite.isSemianalytic_iUnion {ι : Type*} {s : ι → Set E}
    (hfin : LocallyFinite s) (hs : ∀ i, IsSemianalytic (s i)) : IsSemianalytic (⋃ i, s i) := by
  intro x
  obtain ⟨V, hV, hI⟩ := hfin x
  refine (SemianalyticAt.biUnion hI fun i _ => hs i x).congr ?_
  filter_upwards [hV] with y hy
  simp only [eq_iff_iff, mem_iUnion, exists_prop]
  exact ⟨fun ⟨i, hi, hy⟩ => ⟨i, hy⟩, fun ⟨i, hyi⟩ => ⟨i, ⟨y, hyi, hy⟩, hyi⟩⟩

/-- **Analytic isomorphisms, locally.** For a partial equivalence `e` whose source is a
neighbourhood of `x`, with `e` analytic at `x` and its inverse analytic at `e x`, the set
`e.symm ⁻¹' s` is semianalytic at `e x` if and only if `s` is semianalytic at `x`. This applies to
charts and other local analytic isomorphisms. -/
theorem _root_.PartialEquiv.semianalyticAt_preimage_symm_iff [CompleteSpace E] [CompleteSpace F]
    {s : Set E} {x : E} (e : PartialEquiv E F) (hx : e.source ∈ 𝓝 x) (he : AnalyticAt ℝ e x)
    (he' : AnalyticAt ℝ e.symm (e x)) :
    SemianalyticAt (e.symm ⁻¹' s) (e x) ↔ SemianalyticAt s x := by
  have hxx : e.symm (e x) = x := e.left_inv (mem_of_mem_nhds hx)
  refine ⟨fun hs => (hs.preimage he).congr ?_, fun hs => .preimage (by rwa [hxx]) he'⟩
  filter_upwards [hx] with y hy
  simp [e.left_inv hy]

/-- **Analytic isomorphisms, locally.** For a bijection `e` analytic at `x` whose inverse is
analytic at `e x`, the image `e '' s` is semianalytic at `e x` if and only if `s` is semianalytic
at `x`. -/
theorem semianalyticAt_image_equiv_iff [CompleteSpace E] [CompleteSpace F] {s : Set E} {x : E}
    (e : E ≃ F) (he : AnalyticAt ℝ e x)
    (he' : AnalyticAt ℝ e.symm (e x)) : SemianalyticAt (e '' s) (e x) ↔ SemianalyticAt s x := by
  rw [e.image_eq_preimage_symm]
  exact e.toPartialEquiv.semianalyticAt_preimage_symm_iff univ_mem he he'

/-- **Analytic isomorphisms.** For a bijection `e` that is analytic with analytic inverse, the
image `e '' s` is semianalytic if and only if `s` is semianalytic. -/
theorem isSemianalytic_image_equiv_iff {s : Set E} (e : E ≃ F) (he : AnalyticOnNhd ℝ e univ)
    (he' : AnalyticOnNhd ℝ e.symm univ) : IsSemianalytic (e '' s) ↔ IsSemianalytic s := by
  rw [e.image_eq_preimage_symm]
  refine ⟨fun hs => ?_, fun hs => hs.preimage he'⟩
  simpa [preimage_preimage] using hs.preimage he

/-- A semialgebraic subset of `σ → ℝ`, for a finite type `σ`, is semianalytic: polynomial
functions are analytic. -/
theorem IsSemialgebraic.isSemianalytic {σ : Type*} [Fintype σ] {s : Set (σ → ℝ)}
    (hs : IsSemialgebraic s) : IsSemianalytic s :=
  setOf_isSemialgebraic_subset (isSetAlgebra_setOf_isSemianalytic (σ → ℝ))
    (fun p => (AnalyticOnNhd.eval_mvPolynomial p).isSemianalytic_setOf_eq_zero)
    (fun p => (AnalyticOnNhd.eval_mvPolynomial p).isSemianalytic_setOf_pos) hs

end TauCeti
