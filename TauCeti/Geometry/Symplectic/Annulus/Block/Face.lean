/-!
# Boundary momenta of configurations of a chain of strip maps

Let `F_i`, `i ∈ ℤ/N`, be maps of the plane generated by functions `S_i` in the strip convention
`y = -∂₁ S_i(x, X)`, `Y = ∂₂ S_i(x, X)` (`TauCeti.IsStripGenerating`), such as the twist factors of
a lift of an area-preserving map of the annulus `(ℝ / ℤ) × [0, 1]`. A configuration
`q : ℤ/N → ℝ` with every edge `(q_i, q_(i+1))` in the generating set `W_i`
(`TauCeti.cyclicBlock`) has the input momenta `y_i = -∂₁ S_i(q_i, q_(i+1))` and the output
momenta `Y_i = ∂₂ S_i(q_i, q_(i+1))`, with `F_i(q_i, y_i) = (q_(i+1), Y_i)`. In the
generating-function proof of the Poincaré–Birkhoff theorem the configurations with all momenta in
`[0, 1]` form the compact block on which the negative gradient flow of the cyclic action
`W = Σ_i S_i(q_i, q_(i+1))` is studied; its boundary consists of the configurations with some
momentum `y_k ∈ {0, 1}`, on a boundary line of the strip which every factor maps into itself. This
file describes the momenta of configurations on such a line `y = c`.

* **Input and output momenta.** If `F` maps the line `y = c` into itself, an input momentum `c`
  gives the output momentum `c`
  (`TauCeti.IsStripGenerating.stripGeneratingTarget_snd_eq`). If moreover `F` is injective and
  maps the line onto itself, the converse holds: `y = c` exactly when `Y = c`
  (`TauCeti.IsStripGenerating.stripGeneratingSource_snd_eq_iff`).
* **Full runs are boundary orbits.** If every momentum of a configuration is `c`, then `q` is the
  orbit of `(q_0, c)` along the line, `F_i(q_i, c) = (q_(i+1), c)`
  (`TauCeti.apply_mk_eq_of_forall_stripGeneratingSource_snd_eq`), and `q` is a critical point of
  the cyclic action (`TauCeti.fderiv_cyclicAction_eq_zero_of_forall_stripGeneratingSource_snd_eq`).
  So if no orbit of the chain along the line returns to its starting position, as when the
  composite displaces the boundary line strictly, some momentum differs from `c`
  (`TauCeti.exists_stripGeneratingSource_snd_ne`): a cyclic run of momenta equal to `c` is never
  the full cycle.
* **Boundary momenta spread along critical points.** At a critical point of the cyclic action every
  output momentum is the next input momentum, `Y_(i-1) = y_i`, so one momentum equal to `c` makes
  all of them `c` (`TauCeti.stripGeneratingSource_snd_eq_of_fderiv_cyclicAction_eq_zero`). Hence,
  when no boundary orbit closes up, no critical point has a momentum on the line
  (`TauCeti.stripGeneratingSource_snd_ne_of_fderiv_cyclicAction_eq_zero`), and when the chain
  displaces the lower boundary line strictly to the left and the upper one strictly to the right,
  no critical point of the action lies on the boundary of the block
  (`TauCeti.stripGeneratingSource_snd_mem_Ioo_of_fderiv_cyclicAction_eq_zero`).
* **The velocity of a momentum on a face.** The momentum `y_k` of a configuration has derivative
  `v ↦ -∂²S_k((v_k, v_(k+1)), (1, 0))` (`TauCeti.hasFDerivAt_stripGeneratingSource_snd`), and the
  input and output momenta are `Cⁿ` where `S_k` is `Cⁿ⁺¹`
  (`TauCeti.contDiffAt_stripGeneratingSource_snd`, `TauCeti.contDiffAt_stripGeneratingTarget_snd`).
  Along the negative gradient `v_i = y_i - Y_(i-1)` of the cyclic action
  (`TauCeti.fderiv_cyclicAction_apply`), for the band generating function `S_k` of a twist factor
  and a momentum `y_k = c` on a line the factor preserves, this is `(B_k'(q_k) (Y_(k-1) - c) +
  (y_(k+1) - c)) / ∂_y X_k(q_k, c)`, where `B_k(x) = X_k(x, c)`
  (`TauCeti.fderiv_stripGeneratingSource_snd_apply_neg_gradient_of_snd_eq`). When the neighbouring
  momenta lie on one side of `c`, the boundary graph is increasing and the preceding factor
  preserves the line bijectively, it vanishes exactly when both neighbouring **input** momenta are
  `c`, `y_(k-1) = c` and `y_(k+1) = c`
  (`TauCeti.fderiv_stripGeneratingSource_snd_apply_neg_gradient_eq_zero_iff`). So at the end of a
  maximal cyclic run of momenta equal to `c`, the momentum leaves the face with nonzero velocity, in
  the direction given by the sign of the twist
  (`TauCeti.mul_neg_fderiv_fderiv_stripBandGeneratingFunction_apply_face_nonneg`,
  `TauCeti.mul_neg_fderiv_fderiv_stripBandGeneratingFunction_apply_face_nonpos`).

## References

* C. Conley and E. Zehnder, *The Birkhoff–Lewis fixed point theorem and a conjecture of
  V. I. Arnold*, Invent. Math. 73 (1983), 33–49.
-/

public section

open Set ContinuousLinearMap

namespace TauCeti

/-! ### Momenta on a preserved line -/

namespace IsStripGenerating

variable {S : ℝ × ℝ → ℝ} {F : ℝ × ℝ → ℝ × ℝ} {D W : Set (ℝ × ℝ)} {x : ℝ × ℝ} {c : ℝ}

/-- **A preserved line carries the input momentum to the output momentum.** If `S` generates `F`
over `W` and `F` maps the line `y = c` into itself, then over a pair of positions in `W` with input
momentum `y = -∂₁ S` equal to `c`, the output momentum `Y = ∂₂ S` is `c` too. -/
theorem stripGeneratingTarget_snd_eq (h : IsStripGenerating S F D W) (hx : x ∈ W)
    (hc : ∀ s, (F (s, c)).2 = c) (hy : (stripGeneratingSource S x).2 = c) :
    (stripGeneratingTarget S x).2 = c := by
  have hsrc : stripGeneratingSource S x = ((stripGeneratingSource S x).1, c) := Prod.ext rfl hy
  rw [← h.apply_stripGeneratingSource hx, hsrc, hc]

/-- **Input and output momenta on a preserved line.** Let `S` generate `F` on `D` over `W`, let `F`
be injective on `D` and map the line `y = c` onto itself, every position `X` being the image of a
point `(s, c)` of `D`. Then over a pair of positions in `W` the input momentum `y = -∂₁ S` is `c`
exactly when the output momentum `Y = ∂₂ S` is `c`. -/
theorem stripGeneratingSource_snd_eq_iff (h : IsStripGenerating S F D W) (hx : x ∈ W)
    (hinj : InjOn F D) (hc : ∀ s, (F (s, c)).2 = c)
    (hsurj : ∀ X, ∃ s, (s, c) ∈ D ∧ (F (s, c)).1 = X) :
    (stripGeneratingSource S x).2 = c ↔ (stripGeneratingTarget S x).2 = c := by
  refine ⟨h.stripGeneratingTarget_snd_eq hx hc, fun hY ↦ ?_⟩
  obtain ⟨s, hs, hsX⟩ := hsurj x.2
  have hF : F (stripGeneratingSource S x) = F (s, c) := by
    rw [h.apply_stripGeneratingSource hx]
    exact Prod.ext (by rw [stripGeneratingTarget_fst, hsX]) (by rw [hY, hc])
  rw [hinj (h.stripGeneratingSource_mem hx) hs hF]

end IsStripGenerating

/-! ### Configurations with momenta on a preserved line -/

variable {N : ℕ} [NeZero N] {S : ZMod N → ℝ × ℝ → ℝ} {F : ZMod N → ℝ × ℝ → ℝ × ℝ}
  {D W : ZMod N → Set (ℝ × ℝ)} {q : ZMod N → ℝ} {c : ℝ}

omit [NeZero N] in
/-- **A configuration with every momentum on a preserved line is an orbit along the line.** Let
`S_i` generate `F_i` over `W_i` and let every `F_i` map the line `y = c` into itself. If every input
momentum `y_i = -∂₁ S_i(q_i, q_(i+1))` of a configuration `q` with edges in the `W_i` is `c`, then
`F_i(q_i, c) = (q_(i+1), c)` for every `i`. -/
theorem apply_mk_eq_of_forall_stripGeneratingSource_snd_eq
    (hgen : ∀ i, IsStripGenerating (S i) (F i) (D i) (W i)) (hq : q ∈ cyclicBlock W)
    (hc : ∀ i s, (F i (s, c)).2 = c)
    (hy : ∀ i, (stripGeneratingSource (S i) (q i, q (i + 1))).2 = c) (i : ZMod N) :
    F i (q i, c) = (q (i + 1), c) := by
  have hi := mem_cyclicBlock.1 hq i
  have hsrc : stripGeneratingSource (S i) (q i, q (i + 1)) = (q i, c) :=
    Prod.ext (stripGeneratingSource_fst _) (hy i)
  rw [← hsrc, (hgen i).apply_stripGeneratingSource hi]
  exact Prod.ext (stripGeneratingTarget_fst _)
    ((hgen i).stripGeneratingTarget_snd_eq hi (hc i) (hy i))

/-- **A configuration with every momentum on a preserved line is critical.** Let `S_i` generate
`F_i` over `W_i` and let every `F_i` map the line `y = c` into itself. If every input momentum of a
configuration `q` with edges in the `W_i` is `c`, then `q` is a critical point of the cyclic action
`Σ_i S_i(q_i, q_(i+1))`: every output momentum is `c` as well, so `Y_(i-1) = y_i`. -/
theorem fderiv_cyclicAction_eq_zero_of_forall_stripGeneratingSource_snd_eq
    (hgen : ∀ i, IsStripGenerating (S i) (F i) (D i) (W i)) (hq : q ∈ cyclicBlock W)
    (hc : ∀ i s, (F i (s, c)).2 = c)
    (hy : ∀ i, (stripGeneratingSource (S i) (q i, q (i + 1))).2 = c) :
    fderiv ℝ (cyclicAction S) q = 0 := by
  refine (fderiv_cyclicAction_eq_zero_iff fun i ↦
    (hgen i).differentiableAt (mem_cyclicBlock.1 hq i)).2 fun i ↦
      Prod.ext (by simp) ?_
  have hi := mem_cyclicBlock.1 hq (i - 1)
  rw [sub_add_cancel] at hi
  rw [(hgen (i - 1)).stripGeneratingTarget_snd_eq hi (hc (i - 1)) (by simpa using hy (i - 1)),
    hy i]

/-- **Boundary momenta spread along critical points.** Let `S_i` generate `F_i` over `W_i` and let
every `F_i` map the line `y = c` into itself. At a critical point `q` of the cyclic action with
edges in the `W_i`, if one input momentum `y_k` is `c`, then every input momentum is `c`: the
output momentum `Y_k` is `c`, and criticality makes it the next input momentum `y_(k+1)`. -/
theorem stripGeneratingSource_snd_eq_of_fderiv_cyclicAction_eq_zero
    (hgen : ∀ i, IsStripGenerating (S i) (F i) (D i) (W i)) (hq : q ∈ cyclicBlock W)
    (hcrit : fderiv ℝ (cyclicAction S) q = 0) (hc : ∀ i s, (F i (s, c)).2 = c) {k : ZMod N}
    (hk : (stripGeneratingSource (S k) (q k, q (k + 1))).2 = c) (i : ZMod N) :
    (stripGeneratingSource (S i) (q i, q (i + 1))).2 = c := by
  have hcrit' := (fderiv_cyclicAction_eq_zero_iff fun i ↦
    (hgen i).differentiableAt (mem_cyclicBlock.1 hq i)).1 hcrit
  -- Propagate from `k` to `k + j` by induction on `j`.
  have key (j : ZMod N) :
      (stripGeneratingSource (S (k + j)) (q (k + j), q (k + j + 1))).2 = c := by
    refine ZMod.induction_on j (by simpa using hk) fun j ih ↦ ?_
    have h := hcrit' (k + j + 1)
    rw [add_sub_cancel_right] at h
    rw [← add_assoc, ← h]
    exact (hgen _).stripGeneratingTarget_snd_eq (mem_cyclicBlock.1 hq _) (hc _) ih
  simpa using key (i - k)

/-- **A cyclic run of boundary momenta is never the full cycle.** Let `S_i` generate `F_i` over
`W_i` and let every `F_i` map the line `y = c` into itself. Suppose no orbit of the chain along the
line returns to its starting position: whenever `z_(k+1) = F_k(z_k)` for `k < N` with
`z_0 = (x, c)`, the position of `z_N` is not `x`. Then every configuration with edges in the `W_i`
has an input momentum different from `c`. -/
theorem exists_stripGeneratingSource_snd_ne
    (hgen : ∀ i, IsStripGenerating (S i) (F i) (D i) (W i)) (hq : q ∈ cyclicBlock W)
    (hc : ∀ i s, (F i (s, c)).2 = c)
    (hdisp : ∀ (x : ℝ) (z : ℕ → ℝ × ℝ), (∀ k < N, z (k + 1) = F k (z k)) → z 0 = (x, c) →
      (z N).1 ≠ x) :
    ∃ i, (stripGeneratingSource (S i) (q i, q (i + 1))).2 ≠ c := by
  by_contra! hy
  -- The configuration is an orbit along the line which closes up after `N` steps.
  refine hdisp (q 0) (fun k : ℕ ↦ (q k, c)) (fun k _ ↦ ?_) (by simp) (by simp)
  simp only [Nat.cast_succ, apply_mk_eq_of_forall_stripGeneratingSource_snd_eq hgen hq hc hy]

/-- **No critical point has a momentum on a line whose orbits do not close.** Let `S_i` generate
`F_i` over `W_i` and let every `F_i` map the line `y = c` into itself, with no orbit of the chain
along the line returning to its starting position. Then no input momentum of a critical point of
the cyclic action with edges in the `W_i` is `c`. -/
theorem stripGeneratingSource_snd_ne_of_fderiv_cyclicAction_eq_zero
    (hgen : ∀ i, IsStripGenerating (S i) (F i) (D i) (W i)) (hq : q ∈ cyclicBlock W)
    (hcrit : fderiv ℝ (cyclicAction S) q = 0) (hc : ∀ i s, (F i (s, c)).2 = c)
    (hdisp : ∀ (x : ℝ) (z : ℕ → ℝ × ℝ), (∀ k < N, z (k + 1) = F k (z k)) → z 0 = (x, c) →
      (z N).1 ≠ x) (i : ZMod N) :
    (stripGeneratingSource (S i) (q i, q (i + 1))).2 ≠ c := fun hi ↦
  have ⟨j, hj⟩ := exists_stripGeneratingSource_snd_ne hgen hq hc hdisp
  hj (stripGeneratingSource_snd_eq_of_fderiv_cyclicAction_eq_zero hgen hq hcrit hc hi j)

/-- **No critical point of the action lies on the boundary of the block.** Let `S_i` generate `F_i`
over `W_i`, let every `F_i` map the lines `y = 0` and `y = 1` into themselves, and let the chain
displace the lower line strictly to the left and the upper line strictly to the right: an orbit
`z_(k+1) = F_k(z_k)`, `k < N`, starting at `(x, 0)` ends at a position less than `x`, and one
starting at `(x, 1)` at a position greater than `x`. Then at a critical point of the cyclic action
with edges in the `W_i` and all input momenta in `[0, 1]`, every input momentum lies in `(0, 1)`. -/
theorem stripGeneratingSource_snd_mem_Ioo_of_fderiv_cyclicAction_eq_zero
    (hgen : ∀ i, IsStripGenerating (S i) (F i) (D i) (W i)) (hq : q ∈ cyclicBlock W)
    (hcrit : fderiv ℝ (cyclicAction S) q = 0) (h₀ : ∀ i s, (F i (s, 0)).2 = 0)
    (h₁ : ∀ i s, (F i (s, 1)).2 = 1)
    (hdisp₀ : ∀ (x : ℝ) (z : ℕ → ℝ × ℝ), (∀ k < N, z (k + 1) = F k (z k)) → z 0 = (x, 0) →
      (z N).1 < x)
    (hdisp₁ : ∀ (x : ℝ) (z : ℕ → ℝ × ℝ), (∀ k < N, z (k + 1) = F k (z k)) → z 0 = (x, 1) →
      x < (z N).1)
    {i : ZMod N} (hi : (stripGeneratingSource (S i) (q i, q (i + 1))).2 ∈ Icc 0 1) :
    (stripGeneratingSource (S i) (q i, q (i + 1))).2 ∈ Ioo 0 1 :=
  ⟨hi.1.lt_of_ne' (stripGeneratingSource_snd_ne_of_fderiv_cyclicAction_eq_zero hgen hq hcrit h₀
      (fun x z hz hz0 ↦ (hdisp₀ x z hz hz0).ne) i),
    hi.2.lt_of_ne (stripGeneratingSource_snd_ne_of_fderiv_cyclicAction_eq_zero hgen hq hcrit h₁
      (fun x z hz hz0 ↦ (hdisp₁ x z hz hz0).ne') i)⟩

/-! ### The velocity of a momentum on a face -/

/-- **The derivative of a momentum of a configuration.** If the derivative of `S` is differentiable
at the edge `(q_k, q_(k+1))`, the input momentum `q ↦ -∂₁ S(q_k, q_(k+1))` of configurations has
derivative `v ↦ -∂²S((v_k, v_(k+1)), (1, 0))` at `q`. -/
theorem hasFDerivAt_stripGeneratingSource_snd {S : ℝ × ℝ → ℝ} {k : ZMod N}
    (hS : DifferentiableAt ℝ (fderiv ℝ S) (q k, q (k + 1))) :
    HasFDerivAt (fun q' : ZMod N → ℝ ↦ (stripGeneratingSource S (q' k, q' (k + 1))).2)
      (-((apply ℝ ℝ ((1, 0) : ℝ × ℝ)).comp
        ((fderiv ℝ (fderiv ℝ S) (q k, q (k + 1))).comp ((proj k).prod (proj (k + 1)))))) q := by
  have hL : HasFDerivAt (fun q' : ZMod N → ℝ ↦ (q' k, q' (k + 1)))
      ((proj k).prod (proj (k + 1)) : (ZMod N → ℝ) →L[ℝ] ℝ × ℝ) q :=
    (hasFDerivAt_apply k q).prodMk (hasFDerivAt_apply (k + 1) q)
  have hfun : (fun q' : ZMod N → ℝ ↦ (stripGeneratingSource S (q' k, q' (k + 1))).2) =
      -⇑(apply ℝ ℝ ((1, 0) : ℝ × ℝ)) ∘ fderiv ℝ S ∘ fun q' : ZMod N → ℝ ↦ (q' k, q' (k + 1)) := by
    funext q'
    simp
  rw [hfun]
  exact ((apply ℝ ℝ ((1, 0) : ℝ × ℝ)).hasFDerivAt.comp q (hS.hasFDerivAt.comp q hL)).neg

/-- The derivative of the input momentum `q ↦ -∂₁ S(q_k, q_(k+1))` of configurations in the
direction `v` is `-∂²S((v_k, v_(k+1)), (1, 0))`. -/
theorem fderiv_stripGeneratingSource_snd_apply {S : ℝ × ℝ → ℝ} {k : ZMod N}
    (hS : DifferentiableAt ℝ (fderiv ℝ S) (q k, q (k + 1))) (v : ZMod N → ℝ) :
    fderiv ℝ (fun q' : ZMod N → ℝ ↦ (stripGeneratingSource S (q' k, q' (k + 1))).2) q v =
      -fderiv ℝ (fderiv ℝ S) (q k, q (k + 1)) (v k, v (k + 1)) (1, 0) := by
  rw [(hasFDerivAt_stripGeneratingSource_snd hS).fderiv]
  simp

/-- The input momentum `q ↦ -∂₁ S(q_k, q_(k+1))` of configurations is `Cⁿ` at `q` when `S` is
`Cⁿ⁺¹` at the edge `(q_k, q_(k+1))`. -/
theorem contDiffAt_stripGeneratingSource_snd {S : ℝ × ℝ → ℝ} {k : ZMod N} {n : WithTop ℕ∞}
    (hS : ContDiffAt ℝ (n + 1) S (q k, q (k + 1))) :
    ContDiffAt ℝ n (fun q' : ZMod N → ℝ ↦ (stripGeneratingSource S (q' k, q' (k + 1))).2) q := by
  have hL : ContDiffAt ℝ n (fun q' : ZMod N → ℝ ↦ (q' k, q' (k + 1))) q := by
    fun_prop
  simpa only [stripGeneratingSource_snd, Function.comp_apply] using
    (((hS.fderiv_right le_rfl).comp q hL).clm_apply contDiffAt_const).neg

/-- The output momentum `q ↦ ∂₂ S(q_k, q_(k+1))` of configurations is `Cⁿ` at `q` when `S` is
`Cⁿ⁺¹` at the edge `(q_k, q_(k+1))`. -/
theorem contDiffAt_stripGeneratingTarget_snd {S : ℝ × ℝ → ℝ} {k : ZMod N} {n : WithTop ℕ∞}
    (hS : ContDiffAt ℝ (n + 1) S (q k, q (k + 1))) :
    ContDiffAt ℝ n (fun q' : ZMod N → ℝ ↦ (stripGeneratingTarget S (q' k, q' (k + 1))).2) q := by
  have hL : ContDiffAt ℝ n (fun q' : ZMod N → ℝ ↦ (q' k, q' (k + 1))) q := by
    fun_prop
  simpa only [stripGeneratingTarget_snd, Function.comp_apply] using
    ((hS.fderiv_right le_rfl).comp q hL).clm_apply contDiffAt_const

variable {J : Set ℝ} {k : ZMod N}

/-- Along the negative gradient of the cyclic action, the derivative of a momentum `y_k = c` on a
line which the twist factor `F_k` preserves is minus the second derivative of its band generating
function at the twist coordinates of `(q_k, c)`, against `(c - Y_(k-1), y_(k+1) - c)` and
`(1, 0)`. -/
private theorem fderiv_stripGeneratingSource_snd_apply_neg_gradient_eq (hJ : IsOpen J)
    (hJc : J.OrdConnected) (h0 : 0 ∈ J) (hF : ∀ q ∈ Prod.snd ⁻¹' J, ContDiffAt ℝ 2 (F k) q)
    (hY : ∀ x, (F k (x, 0)).2 = 0) (hdet : ∀ q ∈ Prod.snd ⁻¹' J, (fderiv ℝ (F k) q).det = 1)
    (htwist : ∀ q ∈ Prod.snd ⁻¹' J, (fderiv ℝ (F k) q (0, 1)).1 ≠ 0) (hcJ : c ∈ J)
    (hface : ∀ s, (F k (s, c)).2 = c)
    (hSk : S k = stripBandGeneratingFunction (F k) J (stripGeneratingFunction (F k)))
    (hgen : IsStripGenerating (S k) (F k) (D k) (W k)) (hqk : (q k, q (k + 1)) ∈ W k)
    (hk : (stripGeneratingSource (S k) (q k, q (k + 1))).2 = c) :
    fderiv ℝ (fun q' : ZMod N → ℝ ↦ (stripGeneratingSource (S k) (q' k, q' (k + 1))).2) q
        (fun i ↦ (stripGeneratingSource (S i) (q i, q (i + 1))).2 -
          (stripGeneratingTarget (S (i - 1)) (q (i - 1), q i)).2) =
      -fderiv ℝ (fderiv ℝ (stripBandGeneratingFunction (F k) J (stripGeneratingFunction (F k))))
        (stripTwistCoord (F k) (q k, c))
        (c - (stripGeneratingTarget (S (k - 1)) (q (k - 1), q k)).2,
          (stripGeneratingSource (S (k + 1)) (q (k + 1), q (k + 1 + 1))).2 - c) (1, 0) := by
  -- The source point of the edge is `(q_k, c)`, so the edge is its twist coordinates.
  have hsrc : stripGeneratingSource (S k) (q k, q (k + 1)) = (q k, c) :=
    Prod.ext (stripGeneratingSource_fst _) hk
  have hX : (F k (q k, c)).1 = q (k + 1) := by
    rw [← hsrc, hgen.apply_stripGeneratingSource hqk, stripGeneratingTarget_fst]
  have hedge : (q k, q (k + 1)) = stripTwistCoord (F k) (q k, c) := by
    rw [stripTwistCoord_apply, hX]
  have hYk := hgen.stripGeneratingTarget_snd_eq hqk hface hk
  have hdiff : DifferentiableAt ℝ (fderiv ℝ (S k)) (q k, q (k + 1)) := by
    rw [hSk, hedge]
    exact differentiableAt_fderiv_stripBandGeneratingFunction hJ hJc h0 hF hY hdet htwist hcJ
  rw [fderiv_stripGeneratingSource_snd_apply hdiff, add_sub_cancel_right, hk, hYk, hSk, hedge]

/-- **The velocity of a momentum on a face.** Let `F_k = (X_k, Y_k)` be `C²` on a strip `ℝ × J`
over an open interval `J ∋ 0`, twist, preserve area and the line `y = 0`, and map the line `y = c`,
`c ∈ J`, into itself, with boundary graph `B_k(x) = X_k(x, c)`, and let `S_k` be its band generating
function, generating it over `W_k`. At a configuration `q` with `(q_k, q_(k+1)) ∈ W_k` and input
momentum `y_k = c`, the derivative of `y_k` along the negative gradient `v_i = y_i - Y_(i-1)` of the
cyclic action is

`(B_k'(q_k) (Y_(k-1) - c) + (y_(k+1) - c)) / ∂_y X_k(q_k, c)`. -/
theorem fderiv_stripGeneratingSource_snd_apply_neg_gradient_of_snd_eq (hJ : IsOpen J)
    (hJc : J.OrdConnected) (h0 : 0 ∈ J) (hF : ∀ q ∈ Prod.snd ⁻¹' J, ContDiffAt ℝ 2 (F k) q)
    (hY : ∀ x, (F k (x, 0)).2 = 0) (hdet : ∀ q ∈ Prod.snd ⁻¹' J, (fderiv ℝ (F k) q).det = 1)
    (htwist : ∀ q ∈ Prod.snd ⁻¹' J, (fderiv ℝ (F k) q (0, 1)).1 ≠ 0) (hcJ : c ∈ J)
    (hface : ∀ s, (F k (s, c)).2 = c)
    (hSk : S k = stripBandGeneratingFunction (F k) J (stripGeneratingFunction (F k)))
    (hgen : IsStripGenerating (S k) (F k) (D k) (W k)) (hqk : (q k, q (k + 1)) ∈ W k)
    (hk : (stripGeneratingSource (S k) (q k, q (k + 1))).2 = c) :
    fderiv ℝ (fun q' : ZMod N → ℝ ↦ (stripGeneratingSource (S k) (q' k, q' (k + 1))).2) q
        (fun i ↦ (stripGeneratingSource (S i) (q i, q (i + 1))).2 -
          (stripGeneratingTarget (S (i - 1)) (q (i - 1), q i)).2) =
      (deriv (fun s ↦ (F k (s, c)).1) (q k) *
          ((stripGeneratingTarget (S (k - 1)) (q (k - 1), q k)).2 - c) +
        ((stripGeneratingSource (S (k + 1)) (q (k + 1), q (k + 1 + 1))).2 - c)) /
        (fderiv ℝ (F k) (q k, c) (0, 1)).1 := by
  rw [fderiv_stripGeneratingSource_snd_apply_neg_gradient_eq hJ hJc h0 hF hY hdet htwist hcJ hface
    hSk hgen hqk hk, neg_fderiv_fderiv_stripBandGeneratingFunction_apply_face hJ hJc h0 hF hY hdet
    htwist hcJ]

/-- **A momentum on a face is stationary exactly inside a run.** In the setting of
`TauCeti.fderiv_stripGeneratingSource_snd_apply_neg_gradient_of_snd_eq`, let the boundary graph be
increasing at `q_k`, `B_k'(q_k) > 0`, and let the neighbouring momenta `Y_(k-1)` and `y_(k+1)` lie
on one side of `c`. Let the preceding factor `F_(k-1)`, generated by `S_(k-1)` on `D_(k-1)` over
`W_(k-1)` with `(q_(k-1), q_k) ∈ W_(k-1)`, be injective on `D_(k-1)` and map the line `y = c` onto
itself. Then the derivative of `y_k` along the negative gradient of the cyclic
action vanishes exactly when both neighbouring input momenta are `c`: `y_(k-1) = c` and
`y_(k+1) = c`. -/
theorem fderiv_stripGeneratingSource_snd_apply_neg_gradient_eq_zero_iff (hJ : IsOpen J)
    (hJc : J.OrdConnected) (h0 : 0 ∈ J) (hF : ∀ q ∈ Prod.snd ⁻¹' J, ContDiffAt ℝ 2 (F k) q)
    (hY : ∀ x, (F k (x, 0)).2 = 0) (hdet : ∀ q ∈ Prod.snd ⁻¹' J, (fderiv ℝ (F k) q).det = 1)
    (htwist : ∀ q ∈ Prod.snd ⁻¹' J, (fderiv ℝ (F k) q (0, 1)).1 ≠ 0) (hcJ : c ∈ J)
    (hface : ∀ s, (F k (s, c)).2 = c)
    (hSk : S k = stripBandGeneratingFunction (F k) J (stripGeneratingFunction (F k)))
    (hgen : IsStripGenerating (S k) (F k) (D k) (W k)) (hqk : (q k, q (k + 1)) ∈ W k)
    (hk : (stripGeneratingSource (S k) (q k, q (k + 1))).2 = c)
    (hB : 0 < deriv (fun s ↦ (F k (s, c)).1) (q k))
    (hside : c ≤ (stripGeneratingTarget (S (k - 1)) (q (k - 1), q k)).2 ∧
        c ≤ (stripGeneratingSource (S (k + 1)) (q (k + 1), q (k + 1 + 1))).2 ∨
      (stripGeneratingTarget (S (k - 1)) (q (k - 1), q k)).2 ≤ c ∧
        (stripGeneratingSource (S (k + 1)) (q (k + 1), q (k + 1 + 1))).2 ≤ c)
    (hgen' : IsStripGenerating (S (k - 1)) (F (k - 1)) (D (k - 1)) (W (k - 1)))
    (hqk' : (q (k - 1), q k) ∈ W (k - 1))
    (hinj : InjOn (F (k - 1)) (D (k - 1))) (hface' : ∀ s, (F (k - 1) (s, c)).2 = c)
    (hsurj : ∀ X, ∃ s, (s, c) ∈ D (k - 1) ∧ (F (k - 1) (s, c)).1 = X) :
    fderiv ℝ (fun q' : ZMod N → ℝ ↦ (stripGeneratingSource (S k) (q' k, q' (k + 1))).2) q
        (fun i ↦ (stripGeneratingSource (S i) (q i, q (i + 1))).2 -
          (stripGeneratingTarget (S (i - 1)) (q (i - 1), q i)).2) = 0 ↔
      (stripGeneratingSource (S (k - 1)) (q (k - 1), q k)).2 = c ∧
        (stripGeneratingSource (S (k + 1)) (q (k + 1), q (k + 1 + 1))).2 = c := by
  rw [fderiv_stripGeneratingSource_snd_apply_neg_gradient_eq hJ hJc h0 hF hY hdet htwist hcJ hface
      hSk hgen hqk hk,
    neg_fderiv_fderiv_stripBandGeneratingFunction_apply_face_eq_zero_iff hJ hJc h0 hF hY hdet
      htwist hcJ hB hside,
    hgen'.stripGeneratingSource_snd_eq_iff hqk' hinj hface' hsurj]

end TauCeti
