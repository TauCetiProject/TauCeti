/-!
# Factoring an area-preserving isotopy of the strip into twist maps

Let `I ⊆ ℝ` be compact, for instance `[0, 1]`, so that `ℝ × I` is the universal cover of the
annulus `(ℝ / ℤ) × I`, and let `k_t`, `t ∈ [0, 1]`, be a family of lifts to `ℝ × I` of
diffeomorphisms of the annulus: open partial homeomorphisms of the plane whose sources and targets
contain the strip, which commute with the deck translation `(x, y) ↦ (x + 1, y)` and whose
derivatives are invertible and depend continuously on `(t, p)`. This file factors `k_1 ∘ k_0⁻¹`
into finitely many twist maps of the strip.

The positive twist is the shear `R_c (x, y) = (x + c y, y)` (`TauCeti.stripShear c`), for `c > 0`:
the first component of its image increases with `y`. A map `H` whose derivative is within `δ` of
the identity in operator norm, with `δ (1 + c) < min 1 c`, is `H = R_c ∘ N` with `N = R_c⁻¹ ∘ H`
a *negative* twist with positive horizontal derivative: writing `N = (X, Y)`, `∂ₓ X > 0` and
`∂_y X < 0`
(`TauCeti.fst_stripShear_symm_apply_one_zero_pos`,
`TauCeti.fst_stripShear_symm_apply_zero_one_neg`).

On the compact parameter set `[0, 1]` and the compact fundamental domain `[0, 1] × I`, the
relative increment `D k_{t'}(q) ∘ D k_t(q)⁻¹` of the derivatives is uniformly close to the
identity when `t'` is close to `t` (`IsCompact.exists_forall_norm_comp_inverse_sub_id_lt`). By the
chain rule it is the derivative of the increment `k_{t'} ∘ k_t⁻¹` at `k_t(q)`, and by periodicity
the estimate holds on the whole strip
(`TauCeti.exists_forall_norm_fderiv_comp_symm_sub_id_lt`). So for a fine enough partition
`t_i = i / n` every increment is a product `R_c ∘ N_i` as above, and

`k_{t_{i+1}} = R_c ∘ N_i ∘ k_{t_i}` on the strip, `i = 0, …, n - 1`

(`TauCeti.exists_stripShear_comp_twist_factorization`). When `k_0` is the identity on the strip,
these identities write `k_1` there as the composite of `2n` factors, alternately negative twists
`N_i` and positive twists `R_c`, every one of them with positive horizontal derivative `∂ₓ X`.
When every `k_t` preserves area and maps the strip into itself, so does every factor, and each
factor commutes with the deck translation.

Each such factor is a twist map of the strip, generated by a function `S(x, X)` of the mixed
coordinates `(x, X)` (`TauCeti.stripGeneratingFunction`), and the finite factorization is what
turns fixed points of `k_1` into critical points of the finite action `∑ S_i(x_i, x_{i+1})` in the
generating-function proof of the Poincaré–Birkhoff theorem.

## Main definitions

* `TauCeti.stripShear c`: the shear `(x, y) ↦ (x + c y, y)`, as a linear equivalence of the plane.

## Main results

* `TauCeti.fst_stripShear_symm_apply_one_zero_pos`,
  `TauCeti.fst_stripShear_symm_apply_zero_one_neg`: a linear map `D` with
  `‖D - 1‖ (1 + c) < min 1 c` becomes a negative twist with positive horizontal derivative after
  the inverse shear.
* `TauCeti.exists_forall_norm_fderiv_comp_symm_sub_id_lt`: the increments `k_{t'} ∘ k_t⁻¹` of a
  continuous family are uniformly `C¹`-close to the identity on the strip for `t'` close to `t`.
* `TauCeti.exists_stripShear_comp_twist_factorization`: the factorization of an area-preserving
  family into alternating negative twists and positive shears.

## References

* C. Conley and E. Zehnder, *The Birkhoff–Lewis fixed point theorem and a conjecture of
  V. I. Arnold*, Invent. Math. 73 (1983), 33–49.
* P. Le Calvez and J. Wang, *Some remarks on the Poincaré–Birkhoff theorem*, Proc. Amer. Math.
  Soc. 138 (2010), 703–715.
-/

public section

noncomputable section

open Set Filter
open scoped Topology

namespace TauCeti

/-! ### The shear -/

/-- The **shear** `(x, y) ↦ (x + c y, y)` of the plane, the transvection `p ↦ p + c p.2 • (1, 0)`.
It preserves area and every horizontal line, and commutes with horizontal translations; for
`c > 0` it is a positive twist map of every horizontal strip. -/
def stripShear (c : ℝ) : (ℝ × ℝ) ≃L[ℝ] ℝ × ℝ :=
  (LinearEquiv.transvection (f := c • LinearMap.snd ℝ ℝ ℝ) (v := ((1 : ℝ), (0 : ℝ)))
    (by simp)).toContinuousLinearEquiv

@[simp]
theorem stripShear_apply (c : ℝ) (p : ℝ × ℝ) : stripShear c p = (p.1 + c * p.2, p.2) := by
  ext <;> simp [stripShear, LinearMap.transvection.apply]

theorem stripShear_symm (c : ℝ) : (stripShear c).symm = stripShear (-c) := by
  refine ContinuousLinearEquiv.ext (funext fun p ↦ ?_)
  rw [ContinuousLinearEquiv.symm_apply_eq]
  ext <;> simp

@[simp]
theorem stripShear_symm_apply (c : ℝ) (p : ℝ × ℝ) :
    (stripShear c).symm p = (p.1 - c * p.2, p.2) := by
  simp [stripShear_symm, sub_eq_add_neg]

/-- The shear preserves area. -/
@[simp]
theorem det_stripShear (c : ℝ) : (stripShear c : ℝ × ℝ →L[ℝ] ℝ × ℝ).det = 1 := by
  simp [stripShear, ContinuousLinearMap.det]

/-! ### Maps close to the identity -/

section Twist

variable {c : ℝ} {D : ℝ × ℝ →L[ℝ] ℝ × ℝ}

/-- The coordinates of `D v - v` are bounded by `‖D - 1‖ ‖v‖`. -/
private theorem abs_sub_le_of_norm_sub_id (v : ℝ × ℝ) :
    |(D v).1 - v.1| ≤ ‖D - ContinuousLinearMap.id ℝ (ℝ × ℝ)‖ * ‖v‖ ∧
      |(D v).2 - v.2| ≤ ‖D - ContinuousLinearMap.id ℝ (ℝ × ℝ)‖ * ‖v‖ := by
  have h := (D - ContinuousLinearMap.id ℝ (ℝ × ℝ)).le_opNorm v
  simp only [sub_apply, ContinuousLinearMap.id_apply] at h
  exact ⟨(norm_fst_le _).trans h, (norm_snd_le _).trans h⟩

/-- **A map close to the identity has positive horizontal derivative after the inverse shear.** If
`‖D - 1‖ (1 + c) < 1` with `c ≥ 0`, the first component of `R_c⁻¹ ∘ D` increases along `(1, 0)`. -/
theorem fst_stripShear_symm_apply_one_zero_pos (hc : 0 ≤ c)
    (hD : ‖D - ContinuousLinearMap.id ℝ (ℝ × ℝ)‖ * (1 + c) < 1) :
    0 < ((stripShear c).symm (D (1, 0))).1 := by
  obtain ⟨h₁, h₂⟩ := abs_sub_le_of_norm_sub_id (D := D) (1, 0)
  simp only [Prod.norm_mk, norm_one, norm_zero, max_eq_left zero_le_one, mul_one, sub_zero] at h₁ h₂
  rw [stripShear_symm_apply]
  nlinarith [abs_le.1 h₁, abs_le.1 h₂]

/-- **A map close to the identity is a negative twist after the inverse shear.** If
`‖D - 1‖ (1 + c) < c`, the first component of `R_c⁻¹ ∘ D` decreases along `(0, 1)`. -/
theorem fst_stripShear_symm_apply_zero_one_neg (hc : 0 ≤ c)
    (hD : ‖D - ContinuousLinearMap.id ℝ (ℝ × ℝ)‖ * (1 + c) < c) :
    ((stripShear c).symm (D (0, 1))).1 < 0 := by
  obtain ⟨h₁, h₂⟩ := abs_sub_le_of_norm_sub_id (D := D) (0, 1)
  simp only [Prod.norm_mk, norm_one, norm_zero, max_eq_right zero_le_one, mul_one,
    sub_zero] at h₁ h₂
  rw [stripShear_symm_apply]
  nlinarith [abs_le.1 h₁, abs_le.1 h₂]

end Twist

/-! ### Increments of a continuous family -/

variable {I : Set ℝ} {k : ℝ → OpenPartialHomeomorph (ℝ × ℝ) (ℝ × ℝ)}

/-- If an open partial homeomorphism `f` whose source contains the strip `ℝ × I` commutes with the
translation by `(1, 0)` on its source, its derivative at the points of the strip is invariant under
integer translations. -/
private theorem fderiv_add_intCast {f : OpenPartialHomeomorph (ℝ × ℝ) (ℝ × ℝ)}
    (hsource : univ ×ˢ I ⊆ f.source) (hdeck : ∀ q ∈ f.source, f (q + (1, 0)) = f q + (1, 0))
    {q : ℝ × ℝ} (hq : q ∈ univ ×ˢ I) (m : ℤ) : fderiv ℝ f (q + ((m : ℝ), 0)) = fderiv ℝ f q := by
  have hmem (q : ℝ × ℝ) (hq : q ∈ univ ×ˢ I) (r : ℝ) : q + (r, 0) ∈ univ ×ˢ I :=
    ⟨trivial, by simpa using hq.2⟩
  -- One translation step, from the commutation near the point.
  have hstep (q : ℝ × ℝ) (hq : q ∈ univ ×ˢ I) : fderiv ℝ f (q + (1, 0)) = fderiv ℝ f q := by
    have h : (fun q' ↦ f (q' + (1, 0))) =ᶠ[𝓝 q] fun q' ↦ f q' + (1, 0) :=
      eventually_of_mem (f.open_source.mem_nhds (hsource hq)) hdeck
    simpa only [fderiv_comp_add_right, fderiv_add_const] using h.fderiv_eq (𝕜 := ℝ)
  have hnat (q : ℝ × ℝ) (hq : q ∈ univ ×ˢ I) (n : ℕ) :
      fderiv ℝ f (q + ((n : ℝ), 0)) = fderiv ℝ f q := by
    induction n with
    | zero => simp only [Nat.cast_zero, Prod.mk_zero_zero, add_zero]
    | succ n ih =>
      have h : q + (((n + 1 : ℕ) : ℝ), 0) = q + ((n : ℝ), 0) + (1, 0) := by
        ext <;> simp [add_assoc]
      rw [h, hstep _ (hmem q hq n), ih]
  obtain ⟨n, rfl | rfl⟩ := m.eq_nat_or_neg
  · exact_mod_cast hnat q hq n
  · have h := hnat (q + ((-n : ℝ), 0)) (hmem q hq _) n
    have hq' : q + ((-n : ℝ), 0) + ((n : ℝ), 0) = q := by ext <;> simp
    rw [hq'] at h
    push_cast
    exact h.symm

/-- The transition `g ∘ f⁻¹` between two open partial homeomorphisms commuting with the
translation by `(1, 0)`, whose sources contain the strip `ℝ × I`, commutes with that translation
on the strip. -/
private theorem comp_symm_add_one_zero {f g : OpenPartialHomeomorph (ℝ × ℝ) (ℝ × ℝ)}
    (hfs : univ ×ˢ I ⊆ f.source) (hft : univ ×ˢ I ⊆ f.target)
    (hsymm : MapsTo f.symm (univ ×ˢ I) (univ ×ˢ I)) (hgs : univ ×ˢ I ⊆ g.source)
    (hf : ∀ q ∈ f.source, f (q + (1, 0)) = f q + (1, 0))
    (hg : ∀ q ∈ g.source, g (q + (1, 0)) = g q + (1, 0)) {p : ℝ × ℝ} (hp : p ∈ univ ×ˢ I) :
    g (f.symm (p + (1, 0))) = g (f.symm p) + (1, 0) := by
  have hq := hsymm hp
  have hq' : f.symm p + (1, 0) ∈ univ ×ˢ I := ⟨trivial, by simpa using hq.2⟩
  -- The inverse of `f` commutes with the translation at `p`.
  have hfq : f (f.symm p + (1, 0)) = p + (1, 0) := by rw [hf _ (hfs hq), f.right_inv (hft hp)]
  rw [← hfq, f.left_inv (hfs hq'), hg _ (hgs hq)]

/-- **The increments of a continuous family are uniformly `C¹`-close to the identity.** Let
`k_t`, `t ∈ [a, b]`, be open partial homeomorphisms of the plane whose sources and targets contain
the strip `ℝ × I`, for a compact `I`, whose inverses map the strip into itself, which commute with
the translation by `(1, 0)`, and whose derivatives on the strip are invertible and jointly
continuous in `(t, p)`. Then for every `ε > 0` the increments `k_{t'} ∘ k_t⁻¹` have derivative
within `ε` of the identity at every point of the strip, as soon as `t'` is close enough to `t`. -/
theorem exists_forall_norm_fderiv_comp_symm_sub_id_lt (hI : IsCompact I) {a b : ℝ}
    (hsource : ∀ t ∈ Icc a b, univ ×ˢ I ⊆ (k t).source)
    (htarget : ∀ t ∈ Icc a b, univ ×ˢ I ⊆ (k t).target)
    (hsymm : ∀ t ∈ Icc a b, MapsTo (k t).symm (univ ×ˢ I) (univ ×ˢ I))
    (hdiff : ∀ t ∈ Icc a b, ∀ q ∈ univ ×ˢ I, DifferentiableAt ℝ (k t) q)
    (hcont : ContinuousOn (fun z : ℝ × (ℝ × ℝ) ↦ fderiv ℝ (k z.1) z.2) (Icc a b ×ˢ (univ ×ˢ I)))
    (hinv : ∀ t ∈ Icc a b, ∀ q ∈ univ ×ˢ I, (fderiv ℝ (k t) q).IsInvertible)
    (hdeck : ∀ t ∈ Icc a b, ∀ q ∈ (k t).source, k t (q + (1, 0)) = k t q + (1, 0))
    {ε : ℝ} (hε : 0 < ε) :
    ∃ δ > 0, ∀ t ∈ Icc a b, ∀ t' ∈ Icc a b, |t' - t| < δ → ∀ p ∈ univ ×ˢ I,
      ‖fderiv ℝ (k t' ∘ (k t).symm) p - ContinuousLinearMap.id ℝ (ℝ × ℝ)‖ < ε := by
  -- Uniform closeness of the relative increments of the derivatives on the compact set
  -- `[a, b] × ([0, 1] × I)`, a fundamental domain of the strip for the deck translation.
  have hsub : Icc a b ×ˢ (Icc (0 : ℝ) 1 ×ˢ I) ⊆ Icc a b ×ˢ (univ ×ˢ I) :=
    prod_mono subset_rfl (prod_mono (subset_univ _) subset_rfl)
  obtain ⟨δ, hδ, h⟩ := IsCompact.exists_forall_norm_comp_inverse_sub_id_lt
    (isCompact_Icc.prod (isCompact_Icc.prod hI)) (hcont.mono hsub)
    (fun z hz ↦ hinv z.1 hz.1 z.2 (hsub hz).2) hε
  refine ⟨δ, hδ, fun t ht t' ht' htt' p hp ↦ ?_⟩
  set q := (k t).symm p
  have hq : q ∈ univ ×ˢ I := hsymm t ht hp
  -- By the chain rule, the increment has derivative `D k_{t'} q ∘ (D k_t q)⁻¹` at `p = k_t q`.
  rw [((k t).hasFDerivAt_comp_symm (htarget t ht hp) (hdiff t ht q hq) (hinv t ht q hq)
    (hdiff t' ht' q hq)).fderiv]
  -- By periodicity, the derivatives at `q` are those at its representative `q₀ ∈ [0, 1) × I`.
  set q₀ : ℝ × ℝ := (Int.fract q.1, q.2)
  have hq₀ : q₀ ∈ Icc (0 : ℝ) 1 ×ˢ I := ⟨⟨Int.fract_nonneg _, (Int.fract_lt_one _).le⟩, hq.2⟩
  have hqq₀ : q = q₀ + (((⌊q.1⌋ : ℤ) : ℝ), 0) := by ext <;> simp [q₀, Int.fract_add_floor]
  have hper (s : ℝ) (hs : s ∈ Icc a b) : fderiv ℝ (k s) q = fderiv ℝ (k s) q₀ := by
    rw [hqq₀]
    exact fderiv_add_intCast (q := q₀) (hsource s hs) (hdeck s hs) ⟨trivial, hq.2⟩ _
  rw [hper t ht, hper t' ht']
  refine h (t, q₀) ⟨ht, hq₀⟩ (t', q₀) ⟨ht', hq₀⟩ ?_
  rwa [Prod.dist_eq, dist_self, max_eq_left dist_nonneg, Real.dist_eq, abs_sub_comm]

/-- **Factorization of an area-preserving family into twist maps.** Let `k_t`, `t ∈ [0, 1]`, be
open partial homeomorphisms of the plane whose sources and targets contain the strip `ℝ × I`, for
a compact `I`, which together with their inverses map the strip into itself, commute with the
translation by `(1, 0)`, and preserve area, with derivatives on the strip jointly continuous in
`(t, p)`. Let `c > 0`. Then for some `n > 0` and every `i < n`, with `t = i / n` and
`t' = (i + 1) / n`, the increment `k_{t'} ∘ k_t⁻¹` is the shear `R_c = stripShear c` after the map
`N = R_c⁻¹ ∘ k_{t'} ∘ k_t⁻¹`:

`k_{t'} = R_c ∘ N ∘ k_t` on the strip,

and `N = (X, Y)` is a negative twist map of the strip with positive horizontal derivative,
`∂ₓ X > 0` and `∂_y X < 0`, which preserves area, maps the strip into itself and commutes with the
translation by `(1, 0)`. Read in turn for `i = 0, …, n - 1`, these identities express `k_1` on
the strip as `k_0` followed by the `2 n` factors `N` and `R_c`, taken alternately. -/
theorem exists_stripShear_comp_twist_factorization (hI : IsCompact I)
    (hsource : ∀ t ∈ Icc (0 : ℝ) 1, univ ×ˢ I ⊆ (k t).source)
    (htarget : ∀ t ∈ Icc (0 : ℝ) 1, univ ×ˢ I ⊆ (k t).target)
    (hmaps : ∀ t ∈ Icc (0 : ℝ) 1, MapsTo (k t) (univ ×ˢ I) (univ ×ˢ I))
    (hsymm : ∀ t ∈ Icc (0 : ℝ) 1, MapsTo (k t).symm (univ ×ˢ I) (univ ×ˢ I))
    (hdiff : ∀ t ∈ Icc (0 : ℝ) 1, ∀ q ∈ univ ×ˢ I, DifferentiableAt ℝ (k t) q)
    (hcont : ContinuousOn (fun z : ℝ × (ℝ × ℝ) ↦ fderiv ℝ (k z.1) z.2)
      (Icc 0 1 ×ˢ (univ ×ˢ I)))
    (hdet : ∀ t ∈ Icc (0 : ℝ) 1, ∀ q ∈ univ ×ˢ I, (fderiv ℝ (k t) q).det = 1)
    (hdeck : ∀ t ∈ Icc (0 : ℝ) 1, ∀ q ∈ (k t).source, k t (q + (1, 0)) = k t q + (1, 0))
    {c : ℝ} (hc : 0 < c) :
    ∃ n : ℕ, 0 < n ∧ ∀ i < n,
      (∀ q ∈ univ ×ˢ I, k ((i + 1) / n) q =
        stripShear c (((stripShear c).symm ∘ k ((i + 1) / n) ∘ (k (i / n)).symm) (k (i / n) q))) ∧
      MapsTo ((stripShear c).symm ∘ k ((i + 1) / n) ∘ (k (i / n)).symm) (univ ×ˢ I)
        (univ ×ˢ I) ∧
      ∀ p ∈ univ ×ˢ I,
        0 < (fderiv ℝ ((stripShear c).symm ∘ k ((i + 1) / n) ∘ (k (i / n)).symm) p (1, 0)).1 ∧
        (fderiv ℝ ((stripShear c).symm ∘ k ((i + 1) / n) ∘ (k (i / n)).symm) p (0, 1)).1 < 0 ∧
        (fderiv ℝ ((stripShear c).symm ∘ k ((i + 1) / n) ∘ (k (i / n)).symm) p).det = 1 ∧
        ((stripShear c).symm ∘ k ((i + 1) / n) ∘ (k (i / n)).symm) (p + (1, 0)) =
          ((stripShear c).symm ∘ k ((i + 1) / n) ∘ (k (i / n)).symm) p + (1, 0) := by
  have hinv (t : ℝ) (ht : t ∈ Icc (0 : ℝ) 1) (q : ℝ × ℝ) (hq : q ∈ univ ×ˢ I) :
      (fderiv ℝ (k t) q).IsInvertible :=
    ⟨_, ContinuousLinearMap.coe_toContinuousLinearEquivOfDetNeZero _
      (by rw [hdet t ht q hq]; exact one_ne_zero)⟩
  have hmin : 0 < min 1 c := lt_min one_pos hc
  obtain ⟨δ, hδ, h⟩ := exists_forall_norm_fderiv_comp_symm_sub_id_lt hI hsource htarget hsymm
    hdiff hcont hinv hdeck (div_pos hmin (by positivity : (0 : ℝ) < 1 + c))
  obtain ⟨n, hn⟩ := exists_nat_one_div_lt hδ
  refine ⟨n + 1, n.succ_pos, fun i hi ↦ ?_⟩
  have hn₀ : (0 : ℝ) < (n + 1 : ℕ) := by positivity
  have hi' : (i : ℝ) + 1 ≤ (n + 1 : ℕ) := by exact_mod_cast hi
  set t : ℝ := i / (n + 1 : ℕ)
  set t' : ℝ := (i + 1) / (n + 1 : ℕ)
  have ht : t ∈ Icc (0 : ℝ) 1 := ⟨by positivity, (div_le_one hn₀).2 (by linarith)⟩
  have ht' : t' ∈ Icc (0 : ℝ) 1 := ⟨by positivity, (div_le_one hn₀).2 hi'⟩
  have htt' : |t' - t| < δ := by
    rw [← sub_div, add_sub_cancel_left, abs_of_pos (by positivity)]
    simpa using hn
  refine ⟨fun q hq ↦ ?_, fun p hp ↦ ⟨trivial, ?_⟩, fun p hp ↦ ?_⟩
  · simp [(k t).left_inv (hsource t ht hq)]
  · simpa using (hmaps t' ht' (hsymm t ht hp)).2
  set q := (k t).symm p
  have hq : q ∈ univ ×ˢ I := hsymm t ht hp
  have hD := (k t).hasFDerivAt_comp_symm (htarget t ht hp) (hdiff t ht q hq) (hinv t ht q hq)
    (hdiff t' ht' q hq)
  -- The derivative of `N` is the inverse shear after that of the increment, which is close to the
  -- identity.
  have hN : fderiv ℝ ((stripShear c).symm ∘ k t' ∘ (k t).symm) p =
      ((stripShear c).symm : ℝ × ℝ →L[ℝ] ℝ × ℝ) ∘L fderiv ℝ (k t' ∘ (k t).symm) p :=
    (stripShear c).symm.comp_fderiv
  have hclose := (lt_div_iff₀ (by positivity : (0 : ℝ) < 1 + c)).1 (h t ht t' ht' htt' p hp)
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hN]
    exact fst_stripShear_symm_apply_one_zero_pos hc.le (hclose.trans_le (min_le_left _ _))
  · rw [hN]
    exact fst_stripShear_symm_apply_zero_one_neg hc.le (hclose.trans_le (min_le_right _ _))
  · obtain ⟨e, he⟩ := hinv t ht q hq
    have hdete : (e : ℝ × ℝ →L[ℝ] ℝ × ℝ).det = 1 := he ▸ hdet t ht q hq
    rw [hN, hD.fderiv, ← he, ContinuousLinearMap.inverse_equiv]
    simpa [hdete] using hdet t' ht' q hq
  · simp only [Function.comp_apply, comp_symm_add_one_zero (hsource t ht) (htarget t ht)
      (hsymm t ht) (hsource t' ht') (hdeck t ht) (hdeck t' ht') hp, map_add, stripShear_symm_apply,
      mul_zero, sub_zero]

