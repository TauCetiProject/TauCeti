/-!
# The compact block of the cyclic action and its cut-off gradient flow

Let `S_i`, `i ∈ ℤ/N`, be generating functions of a chain of strip maps, in the convention
`y = -∂₁ S_i(x, X)`, `Y = ∂₂ S_i(x, X)`, invariant under the diagonal translation
`(x, X) ↦ (x + 1, X + 1)`, and let `W(q) = Σ_i S_i(q_i, q_(i+1))` be their cyclic action. In the
generating-function proof of the Poincaré–Birkhoff theorem, the critical points of `W` are counted
inside a compact *block* of configurations, by the negative gradient flow of `W` on the quotient of
the configuration space by the diagonal integers. This file constructs the block and a complete
flow which is the negative gradient flow near it.

**The block.** For sets `W_i` of pairs of positions, such as the bands of the twist factors, the
block `TauCeti.cyclicBlock W` is the set of configurations `q` whose every edge `(q_i, q_(i+1))`
lies in `W_i`. When every `W_i` is the band `{(x, X(x, y)) | y ∈ [0, 1]}` of a strip map `F_i`
generated by `S_i`, these are the configurations whose momenta `y_i = -∂₁ S_i(q_i, q_(i+1))` all
lie in `[0, 1]`. The block is closed when the `W_i` are (`TauCeti.isClosed_cyclicBlock`), and
invariant under the diagonal integer translations when the `W_i` are invariant under
`(x, X) ↦ (x + 1, X + 1)` (`TauCeti.add_zsmul_one_mem_cyclicBlock_iff`). Its image
`TauCeti.quotientCyclicBlock W` in the diagonal quotient `(ℤ/N → ℝ) ⧸ ℤ 1` is compact when moreover
the displacements `X - x` are bounded on every `W_i` (`TauCeti.isCompact_quotientCyclicBlock`),
although the block itself is not bounded: the first position lives on a circle and the others are
bounded relative to it. The band of a continuous
strip map commuting with `(x, y) ↦ (x + 1, y)` satisfies all three hypotheses
(`TauCeti.isClosed_image_stripTwistCoord_preimage_snd_Icc`,
`TauCeti.add_mem_image_stripTwistCoord_iff`,
`TauCeti.exists_forall_mem_image_stripTwistCoord_abs_sub_le`), so the block of the bands of lifts
of annulus maps is compact in the diagonal quotient
(`TauCeti.isCompact_quotientCyclicBlock_image_stripTwistCoord`).

**The cut-off flow.** The generating functions are only smooth near their bands, so the negative
gradient of the descended action is only a vector field near the block, and need not be complete.
If every `S_i` is `C^(n+1)`, `1 ≤ n`, on an open set `U_i`, then on the open set
`TauCeti.quotientCyclicBlock U` the negative gradient is `C^n`, and every compact subset `K` of it,
such as the block, has a complete `C^n` vector field `V` on the whole quotient which is `-grad W`
near `K`, a multiple `c • (-grad W)` with `c ∈ [0, 1]` everywhere, and zero off a compact subset of
`TauCeti.quotientCyclicBlock U`
(`TauCeti.exists_isCompleteVectorField_eventuallyEq_neg_mgradient_quotientCyclicAction`). Its global
flow `TauCeti.globalFlow` is a complete flow whose trajectories are negative gradient trajectories
of `W` while they stay near `K`; in particular its rest points in `K` are the critical points of
`W` there. For every such field the action `W` is a Lyapunov function: it never increases along an
integral curve of `V` (`TauCeti.antitone_quotientCyclicAction_comp`), and it strictly decreases
along a trajectory after any time at which `V` does not vanish
(`TauCeti.quotientCyclicAction_lt_of_ne_zero`). Thus `W` strictly decreases along every
nonconstant trajectory.

## Main definitions

* `TauCeti.quotientCyclicBlock W`: the image in the diagonal quotient of the block
  `TauCeti.cyclicBlock W` of configurations whose every edge `(q_i, q_(i+1))` lies in `W_i`.

## Main results

* `TauCeti.isCompact_quotientCyclicBlock`: the block is compact in the diagonal quotient.
* `TauCeti.isCompact_quotientCyclicBlock_image_stripTwistCoord`: in particular the block of the
  bands of lifts of annulus maps is compact.
* `TauCeti.exists_isCompleteVectorField_eventuallyEq_neg_mgradient_quotientCyclicAction`: the
  complete cut-off negative gradient field.
* `TauCeti.antitone_quotientCyclicAction_comp`, `TauCeti.quotientCyclicAction_lt_of_ne_zero`: the
  cyclic action is a Lyapunov function for the cut-off flow.

## References

* C. C. Conley and E. Zehnder, *The Birkhoff–Lewis fixed point theorem and a conjecture of
  V. I. Arnold*, Inventiones Mathematicae 73 (1983), 33–49 (the isolating block of the gradient
  flow of the action on broken configurations).
-/

public section

noncomputable section

open Bundle Set Topology TauCeti.Manifold
open scoped Manifold ContDiff

namespace TauCeti

/-! ### The block of configurations -/

section Block

variable {N : ℕ} {W W' : ZMod N → Set (ℝ × ℝ)}

/-- The block is monotone in the sets of edges. -/
@[gcongr]
theorem cyclicBlock_mono (h : ∀ i, W i ⊆ W' i) : cyclicBlock W ⊆ cyclicBlock W' :=
  fun _ hq ↦ mem_cyclicBlock.2 fun i ↦ h i (mem_cyclicBlock.1 hq i)

/-- The block is the intersection over `i` of the preimages of `W_i` under the edge maps
`q ↦ (q_i, q_(i+1))`. -/
theorem cyclicBlock_eq_iInter :
    cyclicBlock W = ⋂ i, (fun q : ZMod N → ℝ ↦ (q i, q (i + 1))) ⁻¹' W i := by
  ext q
  simp

/-- The block of closed sets is closed. -/
theorem isClosed_cyclicBlock (h : ∀ i, IsClosed (W i)) : IsClosed (cyclicBlock W) := by
  rw [cyclicBlock_eq_iInter]
  exact isClosed_iInter fun i ↦
    (h i).preimage ((continuous_apply i).prodMk (continuous_apply (i + 1)))

/-- The block of open sets is open. -/
theorem isOpen_cyclicBlock [NeZero N] (h : ∀ i, IsOpen (W i)) : IsOpen (cyclicBlock W) := by
  rw [cyclicBlock_eq_iInter]
  exact isOpen_iInter_of_finite fun i ↦
    (h i).preimage ((continuous_apply i).prodMk (continuous_apply (i + 1)))

/-- The image of the block in the quotient of the configuration space by the diagonal integers. -/
def quotientCyclicBlock (W : ZMod N → Set (ℝ × ℝ)) :
    Set ((ZMod N → ℝ) ⧸ AddSubgroup.zmultiples (1 : ZMod N → ℝ)) :=
  QuotientAddGroup.mk '' cyclicBlock W

/-- The block of the diagonal quotient is the image of the block. -/
theorem quotientCyclicBlock_def :
    quotientCyclicBlock W = QuotientAddGroup.mk '' cyclicBlock W :=
  (rfl)

/-- The block of the diagonal quotient is monotone in the sets of edges. -/
@[gcongr]
theorem quotientCyclicBlock_mono (h : ∀ i, W i ⊆ W' i) :
    quotientCyclicBlock W ⊆ quotientCyclicBlock W' :=
  image_mono (cyclicBlock_mono h)

/-- A configuration has its class in the block of the diagonal quotient exactly when it lies in
the block, if every `W_i` is invariant under `(x, X) ↦ (x + 1, X + 1)`. -/
theorem coe_mem_quotientCyclicBlock_iff (hW : ∀ i z, z + (1, 1) ∈ W i ↔ z ∈ W i)
    (q : ZMod N → ℝ) :
    (q : (ZMod N → ℝ) ⧸ AddSubgroup.zmultiples (1 : ZMod N → ℝ)) ∈ quotientCyclicBlock W ↔
      q ∈ cyclicBlock W := by
  refine ⟨fun ⟨p, hp, hpq⟩ ↦ ?_, fun hq ↦ ⟨q, hq, rfl⟩⟩
  obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 (QuotientAddGroup.eq.1 hpq)
  rw [show q = p + k • (1 : ZMod N → ℝ) by rw [hk, add_neg_cancel_left]]
  exact (add_zsmul_one_mem_cyclicBlock_iff hW p k).2 hp

/-- The block of open sets is open in the diagonal quotient. -/
theorem isOpen_quotientCyclicBlock [NeZero N] (h : ∀ i, IsOpen (W i)) :
    IsOpen (quotientCyclicBlock W) :=
  QuotientAddGroup.isOpenMap_coe _ (isOpen_cyclicBlock h)

/-- **The block is compact in the diagonal quotient.** If every `W_i` is closed, invariant under
the diagonal translation `(x, X) ↦ (x + 1, X + 1)`, and has bounded displacement `|X - x| ≤ C_i`,
then the image of the block in the quotient of the configuration space by the diagonal integers is
compact. -/
theorem isCompact_quotientCyclicBlock [NeZero N] (hWc : ∀ i, IsClosed (W i))
    (hW : ∀ i z, z + (1, 1) ∈ W i ↔ z ∈ W i) (hWC : ∀ i, ∃ C, ∀ z ∈ W i, |z.2 - z.1| ≤ C) :
    IsCompact (quotientCyclicBlock W) := by
  choose C hC using hWC
  set D := ∑ i, |C i|
  have hD : 0 ≤ D := Finset.sum_nonneg fun i _ ↦ abs_nonneg (C i)
  -- every edge of a configuration of the block has displacement at most `D`, so every position is
  -- within `N D` of `q_0`
  refine isCompact_image_mk_of_forall_abs_sub_le (isClosed_cyclicBlock hWc)
    (fun q hq k ↦ (add_zsmul_one_mem_cyclicBlock_iff hW q k).2 hq) 0 (C := N * D)
    fun q hq i ↦ ?_
  have hstep (j : ZMod N) : |q (j + 1) - q j| ≤ D :=
    (hC j _ (mem_cyclicBlock.1 hq j)).trans ((le_abs_self _).trans
      (Finset.single_le_sum (fun j _ ↦ abs_nonneg (C j)) (Finset.mem_univ j)))
  have hm (m : ℕ) : |q m - q 0| ≤ m * D := by
    induction m with
    | zero => simp
    | succ m ih =>
      have h := abs_sub_le (q ((m : ZMod N) + 1)) (q m) (q 0)
      push_cast
      linarith [hstep m]
  have h := hm i.val
  rw [ZMod.natCast_zmod_val] at h
  exact h.trans (mul_le_mul_of_nonneg_right (by exact_mod_cast (ZMod.val_lt i).le) hD)

/-- **The block of the bands of strip maps is compact.** Let every `F_i = (X_i, Y_i)` be continuous
on the closed strip `ℝ × [c, d]` and commute there with the deck translation
`(x, y) ↦ (x + 1, y)`, as the lifts of annulus maps do for `[c, d] = [0, 1]`. Then the block of the
bands `{(x, X_i(x, y)) | y ∈ [c, d]}` is compact in the diagonal quotient. -/
theorem isCompact_quotientCyclicBlock_image_stripTwistCoord [NeZero N]
    {F : ZMod N → ℝ × ℝ → ℝ × ℝ} {c d : ℝ}
    (hF : ∀ i, ContinuousOn (F i) (Prod.snd ⁻¹' Icc c d))
    (hF1 : ∀ i, ∀ q ∈ Prod.snd ⁻¹' Icc c d, F i (q + (1, 0)) = F i q + (1, 0)) :
    IsCompact (quotientCyclicBlock fun i ↦ stripTwistCoord (F i) '' (Prod.snd ⁻¹' Icc c d)) :=
  isCompact_quotientCyclicBlock (fun i ↦ isClosed_image_stripTwistCoord_preimage_snd_Icc (hF i))
    (fun i ↦ add_mem_image_stripTwistCoord_iff (hF1 i))
    fun i ↦ exists_forall_mem_image_stripTwistCoord_abs_sub_le (hF i) (hF1 i)

end Block

/-! ### The cut-off negative gradient flow -/

section Flow

variable {N : ℕ} [NeZero N] {S : ZMod N → ℝ × ℝ → ℝ} (hS : ∀ i, Function.Periodic (S i) (1, 1))
  {U : ZMod N → Set (ℝ × ℝ)}

/-- **The cut-off negative gradient field of the cyclic action.** Let every generating function
`S_i` be `C^(n+1)`, `1 ≤ n`, on an open set `U_i`, and let `K` be a compact subset of the block of
the `U_i` in the diagonal quotient, such as the block of the bands of the factors. Then there is a
complete `C^n` vector field `V` on the diagonal quotient which equals the negative gradient
`-grad W` of the descended cyclic action on a neighbourhood of `K`, is a multiple `c • (-grad W)`,
`c ∈ [0, 1]`, of it at every point, and vanishes off a compact subset of the block of the `U_i`. -/
theorem exists_isCompleteVectorField_eventuallyEq_neg_mgradient_quotientCyclicAction {n : ℕ∞}
    (hn : 1 ≤ n) (hU : ∀ i, IsOpen (U i)) (hSU : ∀ i, ContDiffOn ℝ (n + 1) (S i) (U i))
    {K : Set ((ZMod N → ℝ) ⧸ AddSubgroup.zmultiples (1 : ZMod N → ℝ))} (hK : IsCompact K)
    (hKU : K ⊆ quotientCyclicBlock U) :
    letI := diagonalQuotientRiemannianBundle (ZMod N)
    ∃ V : (y : (ZMod N → ℝ) ⧸ AddSubgroup.zmultiples (1 : ZMod N → ℝ)) →
        TangentSpace 𝓘(ℝ, ZMod N → ℝ) y,
      ContMDiff 𝓘(ℝ, ZMod N → ℝ) 𝓘(ℝ, ZMod N → ℝ).tangent n
        (fun y ↦ (⟨y, V y⟩ : TangentBundle 𝓘(ℝ, ZMod N → ℝ) _)) ∧
      IsCompleteVectorField V ∧
      (∀ᶠ y in 𝓝ˢ K, V y = -mgradient 𝓘(ℝ, ZMod N → ℝ) (quotientCyclicAction hS) y) ∧
      (∀ y, ∃ c ∈ Icc (0 : ℝ) 1,
        V y = c • -mgradient 𝓘(ℝ, ZMod N → ℝ) (quotientCyclicAction hS) y) ∧
      ∃ C, IsCompact C ∧ C ⊆ quotientCyclicBlock U ∧ ∀ y ∉ C, V y = 0 := by
  let := diagonalQuotientRiemannianBundle (ZMod N)
  -- the negative gradient is `C^n` on the open block of the `U_i`
  have hgrad : ContMDiffOn 𝓘(ℝ, ZMod N → ℝ) 𝓘(ℝ, ZMod N → ℝ).tangent n
      (fun y ↦ (⟨y, -mgradient 𝓘(ℝ, ZMod N → ℝ) (quotientCyclicAction hS) y⟩ :
        TangentBundle 𝓘(ℝ, ZMod N → ℝ) _)) (quotientCyclicBlock U) := by
    rintro _ ⟨q, hq, rfl⟩
    exact (contMDiffAt_neg_mgradient_quotientCyclicAction hS fun i ↦
      (hSU i).contDiffAt ((hU i).mem_nhds (mem_cyclicBlock.1 hq i))).contMDiffWithinAt
  exact hK.exists_isCompleteVectorField_eventuallyEq hn (isOpen_quotientCyclicBlock hU) hgrad hKU

/-- The descended cyclic action is differentiable on the block of open sets on which the generating
functions are `C¹`, and decreases along nonnegative multiples of its negative gradient there. -/
private theorem mdifferentiableAt_quotientCyclicAction_and_mvfderiv_nonpos
    (hU : ∀ i, IsOpen (U i)) (hSU : ∀ i, ContDiffOn ℝ 1 (S i) (U i))
    {y : (ZMod N → ℝ) ⧸ AddSubgroup.zmultiples (1 : ZMod N → ℝ)}
    (hy : y ∈ quotientCyclicBlock U) (c : ℝ) :
    letI := diagonalQuotientRiemannianBundle (ZMod N)
    MDifferentiableAt 𝓘(ℝ, ZMod N → ℝ) 𝓘(ℝ) (quotientCyclicAction hS) y ∧
      mvfderiv 𝓘(ℝ, ZMod N → ℝ) (quotientCyclicAction hS) y
          (c • -mgradient 𝓘(ℝ, ZMod N → ℝ) (quotientCyclicAction hS) y) =
        -(c * ‖mgradient 𝓘(ℝ, ZMod N → ℝ) (quotientCyclicAction hS) y‖ ^ 2) := by
  let := diagonalQuotientRiemannianBundle (ZMod N)
  obtain ⟨q, hq, rfl⟩ := hy
  refine ⟨(contMDiffAt_quotientCyclicAction hS (n := 1) fun i ↦ (hSU i).contDiffAt
    ((hU i).mem_nhds (mem_cyclicBlock.1 hq i))).mdifferentiableAt one_ne_zero, ?_⟩
  rw [map_smul, mvfderiv_apply_neg_mgradient, smul_eq_mul, mul_neg]

/-- **The cyclic action is a Lyapunov function for the cut-off flow.** Let every generating
function `S_i` be `C¹` on an open set `U_i`, and let `V` be a `C¹` vector field on the diagonal
quotient which is a nonnegative multiple of the negative gradient of the descended cyclic action
`W` at every point and vanishes off the block of the `U_i`, such as the field of
`TauCeti.exists_isCompleteVectorField_eventuallyEq_neg_mgradient_quotientCyclicAction`. Then `W`
never increases along an integral curve of `V`. -/
theorem antitone_quotientCyclicAction_comp (hU : ∀ i, IsOpen (U i))
    (hSU : ∀ i, ContDiffOn ℝ 1 (S i) (U i))
    {V : (y : (ZMod N → ℝ) ⧸ AddSubgroup.zmultiples (1 : ZMod N → ℝ)) →
      TangentSpace 𝓘(ℝ, ZMod N → ℝ) y}
    (hV : ContMDiff 𝓘(ℝ, ZMod N → ℝ) 𝓘(ℝ, ZMod N → ℝ).tangent 1
      (fun y ↦ (⟨y, V y⟩ : TangentBundle 𝓘(ℝ, ZMod N → ℝ) _)))
    (hVc : letI := diagonalQuotientRiemannianBundle (ZMod N)
      ∀ y, ∃ c : ℝ, 0 ≤ c ∧ V y = c • -mgradient 𝓘(ℝ, ZMod N → ℝ) (quotientCyclicAction hS) y)
    (hV0 : ∀ y ∉ quotientCyclicBlock U, V y = 0) {γ : ℝ → _} (hγ : IsMIntegralCurve γ V) :
    Antitone (quotientCyclicAction hS ∘ γ) := by
  let := diagonalQuotientRiemannianBundle (ZMod N)
  have hmem (y) (hy : V y ≠ 0) : y ∈ quotientCyclicBlock U := by_contra fun h ↦ hy (hV0 y h)
  refine hγ.antitone_comp_of_ne_zero hV
    (fun y hy ↦ (mdifferentiableAt_quotientCyclicAction_and_mvfderiv_nonpos hS hU hSU
      (hmem y hy) 0).1) fun y hy ↦ ?_
  obtain ⟨c, hc, hcy⟩ := hVc y
  rw [hcy, (mdifferentiableAt_quotientCyclicAction_and_mvfderiv_nonpos hS hU hSU
    (hmem y hy) c).2, neg_nonpos]
  positivity

/-- **The cyclic action strictly decreases along nonconstant trajectories of the cut-off flow.**
Under the hypotheses of `TauCeti.antitone_quotientCyclicAction_comp`, if `V` does not vanish at the
point `γ s` of an integral curve `γ` of `V`, then `W(γ t) < W(γ s)` for every `t > s`. -/
theorem quotientCyclicAction_lt_of_ne_zero (hU : ∀ i, IsOpen (U i))
    (hSU : ∀ i, ContDiffOn ℝ 1 (S i) (U i))
    {V : (y : (ZMod N → ℝ) ⧸ AddSubgroup.zmultiples (1 : ZMod N → ℝ)) →
      TangentSpace 𝓘(ℝ, ZMod N → ℝ) y}
    (hV : ContMDiff 𝓘(ℝ, ZMod N → ℝ) 𝓘(ℝ, ZMod N → ℝ).tangent 1
      (fun y ↦ (⟨y, V y⟩ : TangentBundle 𝓘(ℝ, ZMod N → ℝ) _)))
    (hVc : letI := diagonalQuotientRiemannianBundle (ZMod N)
      ∀ y, ∃ c : ℝ, 0 ≤ c ∧ V y = c • -mgradient 𝓘(ℝ, ZMod N → ℝ) (quotientCyclicAction hS) y)
    (hV0 : ∀ y ∉ quotientCyclicBlock U, V y = 0) {γ : ℝ → _} (hγ : IsMIntegralCurve γ V)
    {s t : ℝ} (hs : V (γ s) ≠ 0) (hst : s < t) :
    quotientCyclicAction hS (γ t) < quotientCyclicAction hS (γ s) := by
  let := diagonalQuotientRiemannianBundle (ZMod N)
  have hmem (y) (hy : V y ≠ 0) : y ∈ quotientCyclicBlock U := by_contra fun h ↦ hy (hV0 y h)
  have hd (y) (hy : V y ≠ 0) := fun c ↦
    mdifferentiableAt_quotientCyclicAction_and_mvfderiv_nonpos hS hU hSU (hmem y hy) c
  refine hγ.lt_of_mvfderiv_apply_lt_zero_of_ne_zero hV (fun y hy ↦ (hd y hy 0).1)
    (fun y hy ↦ ?_) ?_ hst
  · obtain ⟨c, hc, hcy⟩ := hVc y
    rw [hcy, (hd y hy c).2, neg_nonpos]
    positivity
  · -- at `γ s` both the multiple and the gradient are nonzero, since `V (γ s) ≠ 0`
    obtain ⟨c, hc0, hcy⟩ := hVc (γ s)
    have hc : c ≠ 0 := fun h ↦ hs (by rw [hcy, h, zero_smul])
    have hg : mgradient 𝓘(ℝ, ZMod N → ℝ) (quotientCyclicAction hS) (γ s) ≠ 0 :=
      fun h ↦ hs (by rw [hcy, h, neg_zero, smul_zero])
    rw [hcy, (hd _ hs c).2, neg_lt_zero]
    exact mul_pos (lt_of_le_of_ne hc0 hc.symm) (pow_pos (norm_pos_iff.2 hg) 2)

end Flow

end TauCeti
