/-!
# The symplectic shear of the plane

The shear `S(q, p) = (q + p, p)` of `ℝ²` (`TauCeti.linearPlaneShear`), the shear of the strip
with twist `1` (`TauCeti.linearPlaneShear_eq_stripShear_one`), preserves the standard symplectic
form `ω = dq ∧ dp` (`TauCeti.isSymplectomorphism_linearPlaneShear`). It shows what goes wrong in the
fixed-locus theorem for groups of symplectomorphisms when no invariant metric is assumed:

* its fixed points form the line `p = 0` (`TauCeti.fixedSubmodule_linearPlaneShear`), which is
  Lagrangian (`TauCeti.isLagrangian_fixedSubmodule_linearPlaneShear`), not symplectic;
* it preserves no positive definite form: since `(S - 1)² = 0` and `S ≠ 1`, a form preserved by
  `S` has an isotropic vector (`TauCeti.not_isIsometry_linearPlaneShear`, from
  `TauCeti.BilinForm.IsIsometry.eq_one_of_isNilpotent_sub_one`);
* hence, reading the derivative of `S` at its fixed point `0`, it preserves no Riemannian metric
  on `ℝ²`, smooth or not (`TauCeti.not_forall_inner_mfderiv_linearPlaneShear`, through the
  fixed-point form `TauCeti.fixedPointDerivative_eq_one_of_isNilpotent_sub_one`).

For a group `K` of symplectomorphisms preserving a Riemannian metric, the common fixed set is a
union of symplectic submanifolds, with tangent spaces the common fixed subspaces of the
differentials (`TauCeti.SmoothTwoForm.IsNondegenerate.isSymplectic_fixedTangentSubspace`). The
infinite cyclic group generated by the shear preserves `ω` and has the Lagrangian line `p = 0` as
its fixed set, so the preserved metric cannot be dropped from that theorem:

* the fixed set of the group is the line `p = 0` (`TauCeti.fixedPoints_zpowers_linearPlaneShear`),
  at each of whose points the fixed tangent subspace is the same line
  (`TauCeti.fixedTangentSubspace_zpowers_linearPlaneShear`), of dimension one
  (`TauCeti.fixedPointsOfFinrank_zpowers_linearPlaneShear`);
* that line is Lagrangian, not symplectic, for the constant form `ω`
  (`TauCeti.isLagrangian_fixedTangentSubspace_zpowers_linearPlaneShear`,
  `TauCeti.not_isSymplectic_fixedTangentSubspace_zpowers_linearPlaneShear`);
* the isometry hypothesis of the theorem fails for every Riemannian metric
  (`TauCeti.not_forall_inner_mfderiv_smul_zpowers_linearPlaneShear`).

## References

* Ana Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Homework 21, exercise 2 (fixed loci of groups of symplectomorphisms preserving
  a metric).
-/

public section

noncomputable section

open Manifold MulAction

namespace TauCeti

/-- The shear `(q, p) ↦ (q + p, p)` of the plane: the shear of the strip with twist `1`. -/
def linearPlaneShear : (ℝ × ℝ) ≃L[ℝ] ℝ × ℝ :=
  stripShear 1

/-- The shear of the plane is the shear of the strip with twist `1`, so the `stripShear` API
(inverse, composition, determinant) applies to it. -/
theorem linearPlaneShear_eq_stripShear_one : linearPlaneShear = stripShear 1 :=
  (rfl)

@[simp]
theorem linearPlaneShear_apply (x : ℝ × ℝ) : linearPlaneShear x = (x.1 + x.2, x.2) := by
  simp [linearPlaneShear]

@[simp]
theorem linearPlaneShear_symm_apply (x : ℝ × ℝ) : linearPlaneShear.symm x = (x.1 - x.2, x.2) := by
  simp [linearPlaneShear]

/-- The shear preserves the standard symplectic form `ω = dq ∧ dp` of the plane. -/
theorem isSymplectomorphism_linearPlaneShear :
    SymplecticForm.IsSymplectomorphism stdSymplecticForm stdSymplecticForm
      linearPlaneShear.toLinearEquiv := by
  rw [SymplecticForm.isSymplectomorphism_iff]
  intro v w
  simp only [ContinuousLinearEquiv.coe_toLinearEquiv, linearPlaneShear_apply,
    stdSymplecticForm_apply, RCLike.inner_apply, conj_trivial]
  ring

/-- The fixed points of the shear form the line `p = 0`, that is `ℝ × {0}`. -/
theorem fixedSubmodule_linearPlaneShear :
    LinearMap.fixedSubmodule (linearPlaneShear : (ℝ × ℝ) →ₗ[ℝ] ℝ × ℝ) =
      (⊤ : Submodule ℝ ℝ).prod ⊥ := by
  ext x
  simp [LinearMap.mem_fixedSubmodule_iff, Prod.ext_iff]

/-- The fixed line `p = 0` of the shear is Lagrangian for `ω = dq ∧ dp`. -/
theorem isLagrangian_fixedSubmodule_linearPlaneShear :
    (stdSymplecticForm (V := ℝ)).IsLagrangian
      (LinearMap.fixedSubmodule (linearPlaneShear : (ℝ × ℝ) →ₗ[ℝ] ℝ × ℝ)) := by
  rw [fixedSubmodule_linearPlaneShear]
  exact SymplecticForm.isLagrangian_prod_top_bot

/-- The shear preserves no anisotropic bilinear form, in particular no inner product of the plane:
it is unipotent, `(S - 1)² = 0`, and not the identity. -/
theorem not_isIsometry_linearPlaneShear {B : LinearMap.BilinForm ℝ (ℝ × ℝ)}
    (hB : B.toQuadraticMap.Anisotropic) :
    ¬ BilinForm.IsIsometry B (linearPlaneShear : (ℝ × ℝ) →ₗ[ℝ] ℝ × ℝ) := by
  intro h
  have hN : ((linearPlaneShear : (ℝ × ℝ) →ₗ[ℝ] ℝ × ℝ) - 1) ^ 2 = 0 := by
    refine LinearMap.ext fun x ↦ ?_
    simp [pow_two, Prod.ext_iff]
  have h1 := LinearMap.congr_fun (h.eq_one_of_isNilpotent_sub_one hB ⟨2, hN⟩) (0, 1)
  simp at h1

/-- **The shear preserves no Riemannian metric.** For every family `g` of inner products on the
tangent spaces of the plane, the differential of the shear `(q, p) ↦ (q + p, p)` fails to carry
`g` to itself. No continuity or smoothness of `g` is used. -/
theorem not_forall_inner_mfderiv_linearPlaneShear
    (g : Bundle.RiemannianMetric (fun x : ℝ × ℝ ↦ TangentSpace 𝓘(ℝ, ℝ × ℝ) x)) :
    ¬ ∀ (x : ℝ × ℝ) (v w : TangentSpace 𝓘(ℝ, ℝ × ℝ) x),
      g.inner (linearPlaneShear x) (mfderiv 𝓘(ℝ, ℝ × ℝ) 𝓘(ℝ, ℝ × ℝ) linearPlaneShear x v)
        (mfderiv 𝓘(ℝ, ℝ × ℝ) 𝓘(ℝ, ℝ × ℝ) linearPlaneShear x w) = g.inner x v w := by
  intro h
  let : Bundle.RiemannianBundle (fun x : ℝ × ℝ ↦ TangentSpace 𝓘(ℝ, ℝ × ℝ) x) := ⟨g⟩
  -- At the fixed point `0`, the differential of the shear is the shear itself, which is unipotent
  -- and not the identity.
  let x₀ : {x // linearPlaneShear x = x} := ⟨0, map_zero _⟩
  have hD₀ : fixedPointDerivative 𝓘(ℝ, ℝ × ℝ) linearPlaneShear x₀ =
      (linearPlaneShear : (ℝ × ℝ) →ₗ[ℝ] ℝ × ℝ) :=
    linearPlaneShear.hasFDerivAt.hasMFDerivAt.fixedPointDerivative_eq
  have hN : IsNilpotent ((linearPlaneShear : (ℝ × ℝ) →ₗ[ℝ] ℝ × ℝ) - 1) :=
    ⟨2, LinearMap.ext fun x ↦ by simp [pow_two, Prod.ext_iff]⟩
  have h1 := LinearMap.congr_fun (hD₀ ▸ fixedPointDerivative_eq_one_of_isNilpotent_sub_one x₀
    (fun v w ↦ h 0 v w) (hD₀ ▸ hN)) (0, 1)
  have h2 : linearPlaneShear ((0, 1) : ℝ × ℝ) = (0, 1) := h1
  simp at h2


/-! ### The group generated by the shear -/

/-- **The fixed set of the shear.** The points of the plane fixed by the group generated by the
shear `(q, p) ↦ (q + p, p)` are those of the line `p = 0`. -/
theorem fixedPoints_zpowers_linearPlaneShear :
    fixedPoints (Subgroup.zpowers linearPlaneShear.toLinearEquiv) (ℝ × ℝ) = {x | x.2 = 0} := by
  ext x
  simp only [mem_fixedPoints, Subtype.forall, Subgroup.smul_def, Subgroup.forall_mem_zpowers,
    ← mem_fixedBy, mem_fixedBy_zpowers_iff_mem_fixedBy]
  simp [Prod.ext_iff]

/-- The vectors of the plane invariant under the group generated by the shear are the vectors
fixed by the shear. -/
theorem invariants_zpowers_linearPlaneShear :
    (Representation.ofDistribMulAction ℝ (Subgroup.zpowers linearPlaneShear.toLinearEquiv)
        (ℝ × ℝ)).invariants =
      LinearMap.fixedSubmodule (linearPlaneShear : (ℝ × ℝ) →ₗ[ℝ] ℝ × ℝ) := by
  ext x
  have := Set.ext_iff.1 fixedPoints_zpowers_linearPlaneShear x
  simp only [mem_fixedPoints, Set.mem_ofPred_eq] at this
  simpa [Representation.mem_invariants, LinearMap.mem_fixedSubmodule_iff, Prod.ext_iff] using this

section Manifold

/-- The group generated by the shear acts on the plane by continuous linear maps. -/
local instance : ContinuousConstSMul (Subgroup.zpowers linearPlaneShear.toLinearEquiv) (ℝ × ℝ) :=
  ⟨fun k ↦ (k : (ℝ × ℝ) ≃ₗ[ℝ] ℝ × ℝ).toLinearMap.continuous_of_finiteDimensional⟩

/-- **The fixed tangent subspaces of the shear.** At a point of the line `p = 0`, the fixed tangent
subspace of the group generated by the shear is that line itself, the tangent space of the plane
being the plane. -/
theorem fixedTangentSubspace_zpowers_linearPlaneShear {x : ℝ × ℝ} (hx : x.2 = 0) :
    fixedTangentSubspace 𝓘(ℝ, ℝ × ℝ) (Subgroup.zpowers linearPlaneShear.toLinearEquiv) x =
      (⊤ : Submodule ℝ ℝ).prod ⊥ := by
  have h := map_fromTangentSpace_fixedTangentSubspace
    (K := Subgroup.zpowers linearPlaneShear.toLinearEquiv)
    (show x ∈ fixedPoints _ (ℝ × ℝ) by rwa [fixedPoints_zpowers_linearPlaneShear])
  rw [invariants_zpowers_linearPlaneShear, fixedSubmodule_linearPlaneShear] at h
  -- The canonical identification of the tangent space at `x` with the plane is the identity.
  rw [← h]
  ext v
  exact ⟨fun hv ↦ ⟨v, hv, rfl⟩, fun ⟨_, hw, hwv⟩ ↦ hwv ▸ hw⟩

/-- **The fixed set of the shear has tangent dimension one.** The fixed set `p = 0` of the group
generated by the shear is the part of its fixed set at which the fixed tangent subspace has
dimension `1`. -/
theorem fixedPointsOfFinrank_zpowers_linearPlaneShear :
    fixedPointsOfFinrank 𝓘(ℝ, ℝ × ℝ) (Subgroup.zpowers linearPlaneShear.toLinearEquiv) (ℝ × ℝ) 1 =
      {x | x.2 = 0} := by
  have h1 : Module.finrank ℝ (Representation.ofDistribMulAction ℝ
      (Subgroup.zpowers linearPlaneShear.toLinearEquiv) (ℝ × ℝ)).invariants = 1 := by
    rw [invariants_zpowers_linearPlaneShear, fixedSubmodule_linearPlaneShear,
      show (⊤ : Submodule ℝ ℝ).prod ⊥ = LinearMap.range (LinearMap.inl ℝ ℝ ℝ) by
        ext; simp [LinearMap.range_inl],
      LinearMap.finrank_range_of_inj LinearMap.inl_injective, Module.finrank_self]
  rw [← h1, fixedPointsOfFinrank_finrank_invariants, fixedPoints_zpowers_linearPlaneShear]

/-- **The fixed tangent subspaces of the shear are Lagrangian.** At every point of the fixed line
`p = 0` of the group generated by the shear, the fixed tangent subspace is Lagrangian for the
constant symplectic form `ω = dq ∧ dp`. So the fixed set of a group of linear symplectomorphisms
need not be a symplectic submanifold when the group preserves no metric. -/
theorem isLagrangian_fixedTangentSubspace_zpowers_linearPlaneShear {x : ℝ × ℝ} (hx : x.2 = 0) :
    ((SymplecticForm.isNondegenerate_constSmooth
        stdSymplecticForm).symplecticFormAt x).IsLagrangian
      (fixedTangentSubspace 𝓘(ℝ, ℝ × ℝ) (Subgroup.zpowers linearPlaneShear.toLinearEquiv) x) := by
  -- `symplecticFormAt x` is `ω` on the tangent space at `x`, which is the plane.
  rw [SymplecticForm.isNondegenerate_constSmooth_symplecticFormAt,
    fixedTangentSubspace_zpowers_linearPlaneShear hx, ← fixedSubmodule_linearPlaneShear]
  exact isLagrangian_fixedSubmodule_linearPlaneShear

/-- At every point of the fixed line of the group generated by the shear, the fixed tangent
subspace is not a symplectic subspace for `ω = dq ∧ dp`. -/
theorem not_isSymplectic_fixedTangentSubspace_zpowers_linearPlaneShear {x : ℝ × ℝ}
    (hx : x.2 = 0) :
    ¬ ((SymplecticForm.isNondegenerate_constSmooth
        stdSymplecticForm).symplecticFormAt x).IsSymplectic
      (fixedTangentSubspace 𝓘(ℝ, ℝ × ℝ) (Subgroup.zpowers linearPlaneShear.toLinearEquiv) x) := by
  intro hs
  have hbot := (isLagrangian_fixedTangentSubspace_zpowers_linearPlaneShear hx).isIsotropic
    |>.eq_bot_of_isSymplectic hs
  have h10 : (show TangentSpace 𝓘(ℝ, ℝ × ℝ) x from (1, 0)) ∈ fixedTangentSubspace 𝓘(ℝ, ℝ × ℝ)
      (Subgroup.zpowers linearPlaneShear.toLinearEquiv) x := by
    rw [fixedTangentSubspace_zpowers_linearPlaneShear hx]
    exact Submodule.mem_prod.2 ⟨Submodule.mem_top, Submodule.zero_mem _⟩
  rw [hbot, Submodule.mem_bot] at h10
  exact one_ne_zero (congrArg Prod.fst h10)

/-- **The group generated by the shear preserves no Riemannian metric.** For every Riemannian
metric `g` on the plane, smooth or not, the differentials of the group generated by the shear do
not all preserve `g`, so the isometry hypothesis of
`TauCeti.SmoothTwoForm.IsNondegenerate.isSymplectic_fixedTangentSubspace` fails. -/
theorem not_forall_inner_mfderiv_smul_zpowers_linearPlaneShear
    (g : Bundle.RiemannianMetric (fun x : ℝ × ℝ ↦ TangentSpace 𝓘(ℝ, ℝ × ℝ) x)) :
    ¬ ∀ (k : Subgroup.zpowers linearPlaneShear.toLinearEquiv) (x : ℝ × ℝ)
        (v w : TangentSpace 𝓘(ℝ, ℝ × ℝ) x),
      g.inner (k • x) (mfderiv 𝓘(ℝ, ℝ × ℝ) 𝓘(ℝ, ℝ × ℝ) (k • ·) x v)
          (mfderiv 𝓘(ℝ, ℝ × ℝ) 𝓘(ℝ, ℝ × ℝ) (k • ·) x w) =
        g.inner x v w :=
  fun h ↦ not_forall_inner_mfderiv_linearPlaneShear g
    (h ⟨_, Subgroup.mem_zpowers linearPlaneShear.toLinearEquiv⟩)

end Manifold

end TauCeti
