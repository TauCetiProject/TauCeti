module

public import TauCeti.LinearAlgebra.PerfectPairing.TrilinearProduct
public import TauCeti.RingTheory.NovikovSeries.Multiplication

/-!
# The quantum relation of complex projective space

The rational cohomology of `CPⁿ`, `n ≥ 1`, has the basis `x^0 = 1, x^1 = x, …, x^n` of powers of
the hyperplane class `x`, and the Poincaré pairing `∫ x^i ⌣ x^j` is `1` when `i + j = n` and `0`
otherwise. The small quantum product is read off from the three-point correlator
`I(a, b, c) = ∑_A q^A ⟨a, b, c⟩_(0,3,A)` through this pairing,
`a ⋆ b = LinearMap.trilinearProduct p I a b = ∑_j I(a, b, x^j) x^(n - j)`, the left dual of
`x^j` being `x^(n - j)` (`LinearMap.leftDualBasis_eq_comp_rev`). This file proves that two axioms
of the three-point classes reduce the whole product to one number, the count
`⟨x, x^n, x^n⟩_L` of lines through two points meeting a hyperplane, and that
`x^(⋆(n+1)) = q^L ⟨x, x^n, x^n⟩_L · 1`. With the line count `1` this is the quantum relation
`x^(⋆(n+1)) = q^L` of `CPⁿ`.

* **The degree-selection form**, over any commutative semiring `R`. Suppose the correlator on the
  basis is `1` when `a + b + c = n` and vanishes unless `a + b + c = n` or `a + b + c = 2n + 1`.
  Then `x^a ⋆ x^b = x^(a+b)` when `a + b ≤ n`
  (`LinearMap.trilinearProduct_apply_eq_of_add_le`), and
  `x^a ⋆ x^b = I(x^a, x^b, x^(2n+1-a-b)) x^(a+b-n-1)` when `a + b > n`
  (`LinearMap.trilinearProduct_apply_eq_smul_of_lt_add`). Hence the left powers of `x` are
  `x^(⋆k) = x^k` for `k ≤ n` (`LinearMap.trilinearProduct_pow_apply_eq_of_le`), and
  `x^(⋆(n+1)) = I(x, x^n, x^n) · 1` (`LinearMap.trilinearProduct_pow_succ_apply_eq_smul`).
* **The Gromov–Witten form**, over the Novikov ring `Λ = NovikovSeries K S ω` of a class group
  `S` with area `ω`. Let `S` be generated by a class `L` of Chern number `c(L) = n + 1`, as
  `H₂(CPⁿ; ℤ)` is by the line class. The *degree axiom* says that the coefficient of `q^A` in
  `I(x^a, x^b, x^d)` vanishes unless `2(a + b + d) = 2n + 2c(A)`, the degree of the insertions
  matching the dimension of the moduli space; the *mapping-to-a-point axiom* says that the
  coefficient of `q^0` is the classical triple intersection `∫ x^(a+b+d)`, which is `1` when
  `a + b + d = n`.
  Since `0 ≤ a + b + d ≤ 3n` and `c(k L) = k(n + 1)`, only the classes `0` and `L` contribute:
  the correlator is `1` when `a + b + d = n`, the monomial `q^L ⟨x^a, x^b, x^d⟩_L` when
  `a + b + d = 2n + 1`, and `0` otherwise (`LinearMap.apply_apply_apply_eq_ite`). Therefore
  `x^(⋆(n+1)) = q^L ⟨x, x^n, x^n⟩_L · 1`
  (`LinearMap.trilinearProduct_pow_succ_apply_eq_single_smul`), and in general
  `x^a ⋆ x^b = q^L ⟨x^a, x^b, x^(2n+1-a-b)⟩_L x^(a+b-n-1)` when `a + b > n`
  (`LinearMap.trilinearProduct_apply_eq_single_smul_of_lt_add`).

No associativity is assumed: `x^(⋆k)` is the left power `x ⋆ (x ⋆ (⋯ ⋆ 1))`, the `k`-th power of
left multiplication by `x` applied to `1`. The pairing hypothesis already makes `p` a perfect
pairing (`Module.Basis.isPerfPair_of_apply_eq_ite` with the reversal `Fin.revPerm`); the
instance is only needed to state the product.

The two axioms are hypotheses here, as are the correlator and the pairing: this file
constructs no Gromov–Witten invariant, and it does not compute the line count. For `CPⁿ` the class
group is `H₂(CPⁿ; ℤ)`, generated by the Hurewicz class of the generator of `π₂(CPⁿ)`
(`TauCeti.ComplexProjectiveSpace.zmultiples_hurewiczIntHom_pi2MulEquivInt_symm`), which is the
hypothesis on `L` once its Chern number is identified with `n + 1`.

## References

* W. Fulton and R. Pandharipande, *Notes on stable maps and quantum cohomology*,
  Proc. Sympos. Pure Math. 62 (1997), Part 2, 45–96, Section 10, on the quantum cohomology of
  `CPⁿ`.
* M. Kontsevich and Yu. Manin, *Gromov–Witten classes, quantum cohomology, and enumerative
  geometry*, Comm. Math. Phys. **164** (1994), 525–562, Section 2, for the degree and
  mapping-to-a-point axioms.
-/

public section

noncomputable section

namespace LinearMap

open Module

variable {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M] {n : ℕ}

/-- **The left dual of the power basis is the reversed power basis.** If `p (x^i) (x^j)` is `1`
when `i + j = n` and `0` otherwise, as for the Poincaré pairing on the cohomology of `CPⁿ`, then
the left dual of `x^j` is `x^(n - j)`. -/
theorem leftDualBasis_eq_comp_rev (p : M →ₗ[R] M →ₗ[R] R) [p.IsPerfPair]
    {x : Basis (Fin (n + 1)) R M}
    (hp : ∀ i j : Fin (n + 1), p (x i) (x j) = if (i : ℕ) + j = n then 1 else 0) :
    ⇑(p.leftDualBasis x) = x ∘ Fin.rev := by
  refine ((p.eq_leftDualBasis_iff x).2 fun i j ↦ ?_).symm
  rw [Function.comp_apply, hp]
  refine if_congr ?_ rfl rfl
  rw [Fin.val_rev, Fin.ext_iff]
  omega

section DegreeSelection

variable (p : M →ₗ[R] M →ₗ[R] R) [p.IsPerfPair] {x : Basis (Fin (n + 1)) R M}
  {I : M →ₗ[R] M →ₗ[R] M →ₗ[R] R}

/-- **The product below the top degree.** If the correlator on the power basis is `1` when
`a + b + d = n` and vanishes unless `a + b + d` is `n` or `2n + 1`, then `x^a ⋆ x^b = x^(a+b)`
whenever `a + b ≤ n`. -/
theorem trilinearProduct_apply_eq_of_add_le
    (hp : ∀ i j : Fin (n + 1), p (x i) (x j) = if (i : ℕ) + j = n then 1 else 0)
    (h₀ : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d = n → I (x a) (x b) (x d) = 1)
    (h₁ : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d ≠ n → (a : ℕ) + b + d ≠ 2 * n + 1 →
      I (x a) (x b) (x d) = 0)
    {a b : Fin (n + 1)} (hab : (a : ℕ) + b ≤ n) :
    p.trilinearProduct I (x a) (x b) = x ⟨a + b, by omega⟩ := by
  rw [p.trilinearProduct_apply_eq_sum x, p.leftDualBasis_eq_comp_rev hp,
    Finset.sum_eq_single ⟨n - (a + b), by omega⟩]
  · rw [h₀ _ _ _ (by simp only; omega), one_smul, Function.comp_apply]
    congr 1
    ext
    simp only [Fin.val_rev]
    omega
  · intro j _ hj
    rw [h₁ _ _ _ (fun h ↦ hj (Fin.ext (by simp only; omega))) (by omega), zero_smul]
  · simp

/-- **The product above the top degree.** If the correlator on the power basis vanishes unless
`a + b + d` is `n` or `2n + 1`, then `x^a ⋆ x^b = I(x^a, x^b, x^(2n+1-a-b)) x^(a+b-n-1)` whenever
`a + b > n`. -/
theorem trilinearProduct_apply_eq_smul_of_lt_add
    (hp : ∀ i j : Fin (n + 1), p (x i) (x j) = if (i : ℕ) + j = n then 1 else 0)
    (h₁ : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d ≠ n → (a : ℕ) + b + d ≠ 2 * n + 1 →
      I (x a) (x b) (x d) = 0)
    {a b : Fin (n + 1)} (hab : n < (a : ℕ) + b) :
    p.trilinearProduct I (x a) (x b) =
      I (x a) (x b) (x ⟨2 * n + 1 - (a + b), by omega⟩) • x ⟨a + b - (n + 1), by omega⟩ := by
  rw [p.trilinearProduct_apply_eq_sum x, p.leftDualBasis_eq_comp_rev hp,
    Finset.sum_eq_single ⟨2 * n + 1 - (a + b), by omega⟩]
  · rw [Function.comp_apply]
    congr 2
    ext
    simp only [Fin.val_rev]
    omega
  · intro j _ hj
    rw [h₁ _ _ _ (by omega) (fun h ↦ hj (Fin.ext (by simp only; omega))), zero_smul]
  · simp

/-- **The powers of the hyperplane class below the top degree.** Under the hypotheses of
`LinearMap.trilinearProduct_apply_eq_of_add_le`, the left powers of `x = x^1` are
`x^(⋆k) = x ⋆ (x ⋆ (⋯ ⋆ 1)) = x^k` for every `k ≤ n`. -/
theorem trilinearProduct_pow_apply_eq_of_le
    (hp : ∀ i j : Fin (n + 1), p (x i) (x j) = if (i : ℕ) + j = n then 1 else 0)
    (h₀ : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d = n → I (x a) (x b) (x d) = 1)
    (h₁ : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d ≠ n → (a : ℕ) + b + d ≠ 2 * n + 1 →
      I (x a) (x b) (x d) = 0)
    {k : ℕ} (hk : k ≤ n) :
    (p.trilinearProduct I (x 1) ^ k) (x 0) = x ⟨k, by omega⟩ := by
  induction k with
  | zero => rfl
  | succ k ih =>
    have h1 : ((1 : Fin (n + 1)) : ℕ) = 1 := by
      rw [Fin.val_one']
      exact Nat.mod_eq_of_lt (by omega)
    rw [pow_succ', mul_apply_eq_comp, ih (by omega),
      p.trilinearProduct_apply_eq_of_add_le hp h₀ h₁ (by simp only [h1]; omega)]
    congr 2
    simp only [h1]
    omega

/-- **The `(n+1)`-st power of the hyperplane class.** Under the hypotheses of
`LinearMap.trilinearProduct_apply_eq_of_add_le`, for `n ≥ 1` the left power
`x^(⋆(n+1)) = x ⋆ (x ⋆ (⋯ ⋆ 1))` is `I(x, x^n, x^n) · 1`. -/
theorem trilinearProduct_pow_succ_apply_eq_smul
    (hp : ∀ i j : Fin (n + 1), p (x i) (x j) = if (i : ℕ) + j = n then 1 else 0)
    (h₀ : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d = n → I (x a) (x b) (x d) = 1)
    (h₁ : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d ≠ n → (a : ℕ) + b + d ≠ 2 * n + 1 →
      I (x a) (x b) (x d) = 0)
    (hn : n ≠ 0) :
    (p.trilinearProduct I (x 1) ^ (n + 1)) (x 0) =
      I (x 1) (x (Fin.last n)) (x (Fin.last n)) • x 0 := by
  have h1 : ((1 : Fin (n + 1)) : ℕ) = 1 := by
    rw [Fin.val_one']
    exact Nat.mod_eq_of_lt (by omega)
  rw [pow_succ', mul_apply_eq_comp, p.trilinearProduct_pow_apply_eq_of_le hp h₀ h₁ le_rfl,
    p.trilinearProduct_apply_eq_smul_of_lt_add hp h₁ (by simp only [h1]; omega)]
  congr 3 <;> simp only [Fin.ext_iff, h1, Fin.val_last, Nat.zero_mod] <;> omega

end DegreeSelection

section GromovWitten

open TauCeti TauCeti.NovikovSeries

variable {K S : Type*} [CommSemiring K] [AddCommGroup S] {ω : S →+ ℝ}
  [Module (NovikovSeries K S ω) M] {x : Basis (Fin (n + 1)) (NovikovSeries K S ω) M}
  {c : S →+ ℤ} {L : S}

/-- If `S` is generated by a class `L` with `c L = n + 1`, then a class `A` whose Chern number
satisfies `c A = e - n` for some `e ≤ 3n` is `0` (when `e = n`) or `L` (when `e = 2n + 1`). -/
private theorem eq_zero_or_eq_of_chern_eq (hL : AddSubgroup.zmultiples L = ⊤)
    (hcL : c L = n + 1) {A : S} {e : ℕ} (he : e ≤ 3 * n) (hA : (e : ℤ) = n + c A) :
    (A = 0 ∧ e = n) ∨ (A = L ∧ e = 2 * n + 1) := by
  obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 (hL ▸ AddSubgroup.mem_top A)
  rw [map_zsmul, hcL, smul_eq_mul] at hA
  have hk₀ : 0 ≤ k := by nlinarith
  have hk₁ : k ≤ 1 := by nlinarith
  obtain rfl | rfl : k = 0 ∨ k = 1 := by omega
  · exact .inl ⟨zero_zsmul L, by omega⟩
  · exact .inr ⟨one_zsmul L, by omega⟩

/-- **The correlator of `CPⁿ` on the power basis.** Let the class group `S` be generated by a class
`L` with `c L = n + 1`. Suppose that the coefficient of `q^A` in `I(x^a, x^b, x^d)` vanishes unless
`a + b + d = n + c(A)` (the degree axiom), and that its coefficient of `q^0` is `1` when
`a + b + d = n` (the mapping-to-a-point axiom). Then `I(x^a, x^b, x^d)` is `1` when
`a + b + d = n`, the monomial `q^L ⟨x^a, x^b, x^d⟩_L` when `a + b + d = 2n + 1`, and `0`
otherwise. -/
theorem apply_apply_apply_eq_ite (I : M →ₗ[NovikovSeries K S ω] M →ₗ[NovikovSeries K S ω]
      M →ₗ[NovikovSeries K S ω] NovikovSeries K S ω)
    (hL : AddSubgroup.zmultiples L = ⊤) (hcL : c L = n + 1)
    (hdeg : ∀ (a b d : Fin (n + 1)) (A : S), (I (x a) (x b) (x d)).coeff A ≠ 0 →
      ((a + b + d : ℕ) : ℤ) = n + c A)
    (hpt : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d = n → (I (x a) (x b) (x d)).coeff 0 = 1)
    (a b d : Fin (n + 1)) :
    I (x a) (x b) (x d) =
      if (a : ℕ) + b + d = n then 1
      else if (a : ℕ) + b + d = 2 * n + 1 then
        NovikovSeries.single L ((I (x a) (x b) (x d)).coeff L)
      else 0 := by
  classical
  have hn : (a : ℕ) + b + d ≤ 3 * n := by omega
  ext A
  by_cases hA : (I (x a) (x b) (x d)).coeff A = 0
  · rw [hA]
    split_ifs with h₀ h₁
    · rw [NovikovSeries.coeff_one]
      split_ifs with hA0
      · subst hA0
        exact hA.symm.trans (hpt a b d h₀)
      · rfl
    · rw [coeff_single, Pi.single_apply]
      split_ifs with hAL
      · exact hAL ▸ hA.symm
      · rfl
    · rfl
  · rcases eq_zero_or_eq_of_chern_eq hL hcL hn (hdeg a b d A hA) with ⟨rfl, h⟩ | ⟨rfl, h⟩
    · rw [ite_eq_left h, NovikovSeries.coeff_one, ite_eq_left rfl, hpt a b d h]
    · rw [ite_eq_right (by omega), ite_eq_left h, coeff_single_same]

variable (p : M →ₗ[NovikovSeries K S ω] M →ₗ[NovikovSeries K S ω] NovikovSeries K S ω)
  [p.IsPerfPair]
  {I : M →ₗ[NovikovSeries K S ω] M →ₗ[NovikovSeries K S ω]
    M →ₗ[NovikovSeries K S ω] NovikovSeries K S ω}

/-- **The quantum product of `CPⁿ` above the top degree.** Under the degree and mapping-to-a-point
axioms of `LinearMap.apply_apply_apply_eq_ite`, for `a + b > n` the product is
`x^a ⋆ x^b = q^L ⟨x^a, x^b, x^(2n+1-a-b)⟩_L x^(a+b-n-1)`. -/
theorem trilinearProduct_apply_eq_single_smul_of_lt_add
    (hp : ∀ i j : Fin (n + 1), p (x i) (x j) = if (i : ℕ) + j = n then 1 else 0)
    (hL : AddSubgroup.zmultiples L = ⊤) (hcL : c L = n + 1)
    (hdeg : ∀ (a b d : Fin (n + 1)) (A : S), (I (x a) (x b) (x d)).coeff A ≠ 0 →
      ((a + b + d : ℕ) : ℤ) = n + c A)
    (hpt : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d = n → (I (x a) (x b) (x d)).coeff 0 = 1)
    {a b : Fin (n + 1)} (hab : n < (a : ℕ) + b) :
    p.trilinearProduct I (x a) (x b) =
      (NovikovSeries.single L ((I (x a) (x b) (x ⟨2 * n + 1 - (a + b), by omega⟩)).coeff L) :
        NovikovSeries K S ω) •
        x ⟨a + b - (n + 1), by omega⟩ := by
  have h₁ : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d ≠ n → (a : ℕ) + b + d ≠ 2 * n + 1 →
      I (x a) (x b) (x d) = 0 := fun a b d h h' ↦ by
    rw [I.apply_apply_apply_eq_ite hL hcL hdeg hpt, ite_eq_right h, ite_eq_right h']
  rw [p.trilinearProduct_apply_eq_smul_of_lt_add hp h₁ hab,
    I.apply_apply_apply_eq_ite hL hcL hdeg hpt, ite_eq_right (by simp only; omega),
    ite_eq_left (by simp only; omega), coeff_single_same]

/-- **The quantum relation of `CPⁿ`.** Under the degree and mapping-to-a-point axioms of
`LinearMap.apply_apply_apply_eq_ite`, for `n ≥ 1` the left power
`x^(⋆(n+1)) = x ⋆ (x ⋆ (⋯ ⋆ 1))` of the hyperplane class is `q^L ⟨x, x^n, x^n⟩_L · 1`. When the
line count `⟨x, x^n, x^n⟩_L` is `1` this is the relation `x^(⋆(n+1)) = q^L`. The lower powers are
`x^(⋆k) = x^k` for `k ≤ n` (`LinearMap.trilinearProduct_pow_apply_eq_of_le`). -/
theorem trilinearProduct_pow_succ_apply_eq_single_smul
    (hp : ∀ i j : Fin (n + 1), p (x i) (x j) = if (i : ℕ) + j = n then 1 else 0)
    (hL : AddSubgroup.zmultiples L = ⊤) (hcL : c L = n + 1)
    (hdeg : ∀ (a b d : Fin (n + 1)) (A : S), (I (x a) (x b) (x d)).coeff A ≠ 0 →
      ((a + b + d : ℕ) : ℤ) = n + c A)
    (hpt : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d = n → (I (x a) (x b) (x d)).coeff 0 = 1)
    (hn : n ≠ 0) :
    (p.trilinearProduct I (x 1) ^ (n + 1)) (x 0) =
      (NovikovSeries.single L ((I (x 1) (x (Fin.last n)) (x (Fin.last n))).coeff L) :
        NovikovSeries K S ω) • x 0 := by
  have h1 : ((1 : Fin (n + 1)) : ℕ) = 1 := by
    rw [Fin.val_one']
    exact Nat.mod_eq_of_lt (by omega)
  have h₀ : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d = n → I (x a) (x b) (x d) = 1 :=
    fun a b d h ↦ by rw [I.apply_apply_apply_eq_ite hL hcL hdeg hpt, ite_eq_left h]
  have h₁ : ∀ a b d : Fin (n + 1), (a : ℕ) + b + d ≠ n → (a : ℕ) + b + d ≠ 2 * n + 1 →
      I (x a) (x b) (x d) = 0 := fun a b d h h' ↦ by
    rw [I.apply_apply_apply_eq_ite hL hcL hdeg hpt, ite_eq_right h, ite_eq_right h']
  rw [p.trilinearProduct_pow_succ_apply_eq_smul hp h₀ h₁ hn,
    I.apply_apply_apply_eq_ite hL hcL hdeg hpt,
    ite_eq_right (by simp only [h1, Fin.val_last]; omega),
    ite_eq_left (by simp only [h1, Fin.val_last]; omega), coeff_single_same]

end GromovWitten

end LinearMap
