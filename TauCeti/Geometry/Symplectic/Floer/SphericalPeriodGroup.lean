module

public import TauCeti.AlgebraicTopology.Homotopy.Hurewicz.Spherical
public import TauCeti.Geometry.Symplectic.Floer.PeriodGroup

/-!
# The period group of the spherical classes of a space

Let `X` be a topological space and let `ω : H₂(X; ℤ) →+ ℝ` and `c : H₂(X; ℤ) →+ ℤ` be
homomorphisms on its integral second singular homology: for a symplectic manifold, integration
of the symplectic form and evaluation of the first Chern class. Capped Hamiltonian Floer theory
uses a Novikov coefficient ring whose exponents lie in the period group

`Γ = S ⧸ (ker ω ⊓ ker c)`

of the group `S ⊆ H₂(X; ℤ)` of spherical classes (`TauCeti.sphericalClasses`): the subgroup
generated by the images of the Hurewicz homomorphisms `π₂(X, x) → H₂(X; ℤ)` at all base points
`x`, which is the image of the Hurewicz homomorphism at any single base point when `X` is
path-connected (`TauCeti.sphericalClasses_eq_range`). This file instantiates the abstract period
group `TauCeti.Floer.PeriodGroup` of `TauCeti.Geometry.Symplectic.Floer.PeriodGroup` with this
group, as `TauCeti.Floer.SphericalPeriodGroup ω c`, and describes it in terms of spheres.

* Every element `a ∈ π₂(X, x)` has a class `SphericalPeriodGroup.ofHomotopyGroup ω c x a` in `Γ`,
  with area `ω` and Chern number `c` of its Hurewicz class. This is the class by which a cap of a
  contractible loop through `x` changes when a sphere representing `a` is glued to it. It does not
  depend on the base point along paths
  (`SphericalPeriodGroup.ofHomotopyGroup_homotopyGroupTransport`), and on a path-connected space
  every element of `Γ` is the class of a sphere at any given base point
  (`SphericalPeriodGroup.ofHomotopyGroup_surjective`).
* `Γ` is trivial exactly when `ω` and `c` vanish on the Hurewicz classes of all spheres
  (`SphericalPeriodGroup.subsingleton_iff`), that is, for symplectically aspherical targets with
  vanishing first Chern class on spheres.
* A continuous map `f : X → Y` along which `ω` and `c` pull back on spherical classes induces a
  homomorphism of period groups (`SphericalPeriodGroup.map`), compatible with the classes of spheres
  (`SphericalPeriodGroup.map_ofHomotopyGroup`).

The homomorphisms `ω` and `c` are arbitrary: the results here do not use that they come from a
symplectic form and an almost complex structure.

## References

* H. Hofer and D. A. Salamon, *Floer homology and Novikov rings*, in *The Floer memorial
  volume*, Progr. Math. 133 (1995), 483–524.
* D. McDuff and D. Salamon, *J-holomorphic curves and symplectic topology*, Section 11.1, on
  spherical classes and the Novikov ring of a symplectic manifold.
-/

public section

noncomputable section

open CategoryTheory AlgebraicTopology HomotopyGroup

namespace TauCeti.Floer

variable {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]
  {ω : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj (ModuleCat.of ℤ ℤ)).obj
    (TopCat.of X) →+ ℝ}
  {c : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj (ModuleCat.of ℤ ℤ)).obj
    (TopCat.of X) →+ ℤ}

variable (ω c) in
/-- The **period group of the spherical classes** of a space `X`, with respect to homomorphisms
`ω` and `c` on `H₂(X; ℤ)`: the quotient of the group of spherical classes in `H₂(X; ℤ)` by the
joint kernel of `ω` and `c`. -/
abbrev SphericalPeriodGroup : Type :=
  PeriodGroup (ω.comp (sphericalClasses X 1).subtype) (c.comp (sphericalClasses X 1).subtype)

namespace SphericalPeriodGroup

variable (ω c) in
/-- The class in the period group of an element of `π₂(X, x)`: the class of its Hurewicz class. -/
def ofHomotopyGroup (x : X) : Additive (HomotopyGroup (Fin 2) X x) →+ SphericalPeriodGroup ω c :=
  (QuotientAddGroup.mk' _).comp ((hurewiczIntHom X x 1).codRestrict _
    (hurewiczIntHom_mem_sphericalClasses x))

/-- The area of the class of a sphere is the value of `ω` on its Hurewicz class. -/
@[simp]
theorem area_ofHomotopyGroup (x : X) (a : Additive (HomotopyGroup (Fin 2) X x)) :
    PeriodGroup.area _ _ (ofHomotopyGroup ω c x a) = ω (hurewiczIntHom X x 1 a) := by
  simp [ofHomotopyGroup]

/-- The first Chern number of the class of a sphere is the value of `c` on its Hurewicz class. -/
@[simp]
theorem chern_ofHomotopyGroup (x : X) (a : Additive (HomotopyGroup (Fin 2) X x)) :
    PeriodGroup.chern _ _ (ofHomotopyGroup ω c x a) = c (hurewiczIntHom X x 1 a) := by
  simp [ofHomotopyGroup]

/-- Two spheres have the same class exactly when their Hurewicz classes have the same area and the
same first Chern number. -/
theorem ofHomotopyGroup_eq_ofHomotopyGroup_iff {x y : X}
    {a : Additive (HomotopyGroup (Fin 2) X x)} {b : Additive (HomotopyGroup (Fin 2) X y)} :
    ofHomotopyGroup ω c x a = ofHomotopyGroup ω c y b ↔
      ω (hurewiczIntHom X x 1 a) = ω (hurewiczIntHom X y 1 b) ∧
        c (hurewiczIntHom X x 1 a) = c (hurewiczIntHom X y 1 b) := by
  simp [PeriodGroup.ext_iff]

/-- The class of a sphere does not depend on the base point: transporting it along a path does
not change its class. -/
@[simp]
theorem ofHomotopyGroup_homotopyGroupTransport {x y : X} (γ : Path x y)
    (a : HomotopyGroup (Fin 2) X x) :
    ofHomotopyGroup ω c y (Additive.ofMul (homotopyGroupTransport γ a)) =
      ofHomotopyGroup ω c x (Additive.ofMul a) := by
  rw [ofHomotopyGroup_eq_ofHomotopyGroup_iff]
  simp

/-- **On a path-connected space every class of the period group is the class of a sphere** at any
given base point. -/
theorem ofHomotopyGroup_surjective [PathConnectedSpace X] (x : X) :
    Function.Surjective (ofHomotopyGroup ω c x) := by
  intro γ
  induction γ using QuotientAddGroup.induction_on with
  | H s =>
    obtain ⟨a, ha⟩ := (mem_sphericalClasses_iff x).1 s.2
    exact ⟨a, congrArg _ (Subtype.ext ha)⟩

/-- **The period group is trivial exactly when `ω` and `c` vanish on all spheres**, as they do for
a symplectically aspherical manifold whose first Chern class vanishes on spheres. -/
theorem subsingleton_iff :
    Subsingleton (SphericalPeriodGroup ω c) ↔
      ∀ x (a : Additive (HomotopyGroup (Fin 2) X x)),
        ω (hurewiczIntHom X x 1 a) = 0 ∧ c (hurewiczIntHom X x 1 a) = 0 := by
  rw [PeriodGroup.subsingleton_iff]
  refine ⟨fun h x a ↦ h ⟨_, hurewiczIntHom_mem_sphericalClasses x a⟩, fun h s ↦ ?_⟩
  -- The joint kernel of `ω` and `c` contains every Hurewicz class, hence every spherical class.
  have hle : sphericalClasses X 1 ≤ (ω.prod c).ker :=
    sphericalClasses_le_iff.2 fun x a ↦ by simpa using h x a
  simpa using hle s.2

section Map

variable {ω' : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj (ModuleCat.of ℤ ℤ)).obj
    (TopCat.of Y) →+ ℝ}
  {c' : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj (ModuleCat.of ℤ ℤ)).obj
    (TopCat.of Y) →+ ℤ}
  (f : C(X, Y))

variable (hω : (ω'.comp (sphericalClasses Y 1).subtype).comp (sphericalClassesMap f 1) =
    ω.comp (sphericalClasses X 1).subtype)
  (hc : (c'.comp (sphericalClasses Y 1).subtype).comp (sphericalClassesMap f 1) =
    c.comp (sphericalClasses X 1).subtype)

/-- The homomorphism of period groups induced by a continuous map `f : X → Y` along which `ω` and
`c` are pulled back from `ω'` and `c'` on spherical classes. -/
def map : SphericalPeriodGroup ω c →+ SphericalPeriodGroup ω' c' :=
  PeriodGroup.map (sphericalClassesMap f 1) hω hc

/-- The induced map of period groups preserves area. -/
@[simp]
theorem area_map (γ : SphericalPeriodGroup ω c) :
    PeriodGroup.area _ _ (map f hω hc γ) = PeriodGroup.area _ _ γ :=
  PeriodGroup.area_map _ _ _ γ

/-- The induced map of period groups preserves the first Chern number. -/
@[simp]
theorem chern_map (γ : SphericalPeriodGroup ω c) :
    PeriodGroup.chern _ _ (map f hω hc γ) = PeriodGroup.chern _ _ γ :=
  PeriodGroup.chern_map _ _ _ γ

/-- The induced map of period groups sends the class of a sphere `a` to the class of its image
`f_* a`. -/
@[simp]
theorem map_ofHomotopyGroup (x : X) (a : HomotopyGroup (Fin 2) X x) :
    map f hω hc (ofHomotopyGroup ω c x (Additive.ofMul a)) =
      ofHomotopyGroup ω' c' (f x) (Additive.ofMul (HomotopyGroup.map f rfl a)) :=
  PeriodGroup.ext
    (by
      simpa [sphericalClassesMap_hurewiczIntHom] using
        (DFunLike.congr_fun hω ⟨_, hurewiczIntHom_mem_sphericalClasses x (Additive.ofMul a)⟩).symm)
    (by
      simpa [sphericalClassesMap_hurewiczIntHom] using
        (DFunLike.congr_fun hc ⟨_, hurewiczIntHom_mem_sphericalClasses x (Additive.ofMul a)⟩).symm)

end Map

end SphericalPeriodGroup

end TauCeti.Floer
