/-!
# The period group of the spherical classes of a space

Let `X` be a topological space and let `ω : H₂(X; ℤ) →+ ℝ` and `c : H₂(X; ℤ) →+ ℤ` be
homomorphisms on its integral second singular homology: for a symplectic manifold, integration
of the symplectic form and evaluation of the first Chern class. Capped Hamiltonian Floer theory
uses a Novikov coefficient ring whose exponents lie in the period group

`Γ = S ⧸ (ker ω ⊓ ker c)`

of the group `S ⊆ H₂(X; ℤ)` of spherical classes (`TauCeti.sphericalClasses`): the subgroup
generated by the images of the Hurewicz homomorphisms `π₂(X, x) → H₂(X; ℤ)` at all base points
`x`, which is the image of the Hurewicz homomorphism at any single base point when `X` is
path-connected (`TauCeti.sphericalClasses_eq_range`). This file instantiates the abstract period
group `TauCeti.Floer.PeriodGroup` of `TauCeti.Geometry.Symplectic.Floer.PeriodGroup` with this
group, as `TauCeti.Floer.SphericalPeriodGroup ω c`, and describes it in terms of spheres.

* Every element `a ∈ π₂(X, x)` has a class `SphericalPeriodGroup.ofHomotopyGroup ω c x a` in `Γ`,
  with area `ω` and Chern number `c` of its Hurewicz class. This is the class by which a cap of a
  contractible loop through `x` changes when a sphere representing `a` is glued to it. It does not
  depend on the base point along paths
  (`SphericalPeriodGroup.ofHomotopyGroup_homotopyGroupTransport`) or along equalities of points
  (`SphericalPeriodGroup.ofHomotopyGroup_map_id`), and on a path-connected space
  every element of `Γ` is the class of a sphere at any given base point
  (`SphericalPeriodGroup.ofHomotopyGroup_surjective`).
* `Γ` is trivial exactly when `ω` and `c` vanish on the Hurewicz classes of all spheres
  (`SphericalPeriodGroup.subsingleton_iff`), that is, for symplectically aspherical targets with
  vanishing first Chern class on spheres. In particular it is trivial when every sphere is
  null-homotopic (`SphericalPeriodGroup.subsingleton_of_forall_subsingleton`), as on every
  aspherical space, such as a torus (`SphericalPeriodGroup.subsingleton_of_isAspherical`).
* If `H₂(X; ℤ)` is generated by the Hurewicz class of a single sphere `a`, as on the two-sphere and
  on complex projective space, the class of `a` generates `Γ`
  (`SphericalPeriodGroup.zmultiples_ofHomotopyGroup_eq_top`). Then `Γ` is trivial exactly when
  both periods of `a` vanish (`SphericalPeriodGroup.subsingleton_iff_of_zmultiples_eq_top`), and
  otherwise the class map `H₂(X; ℤ) → Γ` is an isomorphism
  (`SphericalPeriodGroup.ofSingularHomology_injective_of_zmultiples_eq_top`). If the first Chern
  number of `a` is nonzero, `X` is spherically monotone
  (`SphericalPeriodGroup.area_eq_mul_chern_of_zmultiples_eq_top`).
* A continuous map `f : X → Y` along which `ω` and `c` pull back on spherical classes induces a
  homomorphism of period groups (`SphericalPeriodGroup.map`), compatible with the classes of spheres
  (`SphericalPeriodGroup.map_ofHomotopyGroup`).

The homomorphisms `ω` and `c` are arbitrary: the results here do not use that they come from a
symplectic form and an almost complex structure.

## References

* H. Hofer and D. A. Salamon, *Floer homology and Novikov rings*, in *The Floer memorial
  volume*, Progr. Math. 133 (1995), 483–524.
* D. McDuff and D. Salamon, *J-holomorphic curves and symplectic topology*, Section 11.1, on
  spherical classes and the Novikov ring of a symplectic manifold.
-/

public section

noncomputable section

open CategoryTheory AlgebraicTopology HomotopyGroup

namespace TauCeti.Floer

variable {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]
  {ω : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj (ModuleCat.of ℤ ℤ)).obj
    (TopCat.of X) →+ ℝ}
  {c : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj (ModuleCat.of ℤ ℤ)).obj
    (TopCat.of X) →+ ℤ}

variable (ω c) in
/-- The **period group of the spherical classes** of a space `X`, with respect to homomorphisms
`ω` and `c` on `H₂(X; ℤ)`: the quotient of the group of spherical classes in `H₂(X; ℤ)` by the
joint kernel of `ω` and `c`. -/
abbrev SphericalPeriodGroup : Type :=
  PeriodGroup (ω.comp (sphericalClasses X 1).subtype) (c.comp (sphericalClasses X 1).subtype)

namespace SphericalPeriodGroup

variable (ω c) in
/-- The class in the period group of an element of `π₂(X, x)`: the class of its Hurewicz class. -/
def ofHomotopyGroup (x : X) : Additive (HomotopyGroup (Fin 2) X x) →+ SphericalPeriodGroup ω c :=
  (QuotientAddGroup.mk' _).comp ((hurewiczIntHom X x 1).codRestrict _
    (hurewiczIntHom_mem_sphericalClasses x))

/-- The area of the class of a sphere is the value of `ω` on its Hurewicz class. -/
@[simp]
theorem area_ofHomotopyGroup (x : X) (a : Additive (HomotopyGroup (Fin 2) X x)) :
    PeriodGroup.area _ _ (ofHomotopyGroup ω c x a) = ω (hurewiczIntHom X x 1 a) := by
  simp [ofHomotopyGroup]

/-- The first Chern number of the class of a sphere is the value of `c` on its Hurewicz class. -/
@[simp]
theorem chern_ofHomotopyGroup (x : X) (a : Additive (HomotopyGroup (Fin 2) X x)) :
    PeriodGroup.chern _ _ (ofHomotopyGroup ω c x a) = c (hurewiczIntHom X x 1 a) := by
  simp [ofHomotopyGroup]

/-- Two spheres have the same class exactly when their Hurewicz classes have the same area and the
same first Chern number. -/
theorem ofHomotopyGroup_eq_ofHomotopyGroup_iff {x y : X}
    {a : Additive (HomotopyGroup (Fin 2) X x)} {b : Additive (HomotopyGroup (Fin 2) X y)} :
    ofHomotopyGroup ω c x a = ofHomotopyGroup ω c y b ↔
      ω (hurewiczIntHom X x 1 a) = ω (hurewiczIntHom X y 1 b) ∧
        c (hurewiczIntHom X x 1 a) = c (hurewiczIntHom X y 1 b) := by
  simp [PeriodGroup.ext_iff]

/-- The class of a sphere does not depend on the base point: transporting it along a path does
not change its class. -/
@[simp]
theorem ofHomotopyGroup_homotopyGroupTransport {x y : X} (γ : Path x y)
    (a : HomotopyGroup (Fin 2) X x) :
    ofHomotopyGroup ω c y (Additive.ofMul (homotopyGroupTransport γ a)) =
      ofHomotopyGroup ω c x (Additive.ofMul a) := by
  rw [ofHomotopyGroup_eq_ofHomotopyGroup_iff]
  simp

/-- The class of a sphere does not change when its base point is renamed along an equality of
points, by `HomotopyGroup.map` of the identity. -/
@[simp]
theorem ofHomotopyGroup_map_id {x y : X} (h : ContinuousMap.id X x = y)
    (a : HomotopyGroup (Fin 2) X x) :
    ofHomotopyGroup ω c y (Additive.ofMul (HomotopyGroup.map (ContinuousMap.id X) h a)) =
      ofHomotopyGroup ω c x (Additive.ofMul a) :=
  HomotopyGroup.apply_map_id (fun y b => ofHomotopyGroup ω c y (Additive.ofMul b)) h a

/-- **On a path-connected space every class of the period group is the class of a sphere** at any
given base point. -/
theorem ofHomotopyGroup_surjective [PathConnectedSpace X] (x : X) :
    Function.Surjective (ofHomotopyGroup ω c x) := by
  intro γ
  induction γ using QuotientAddGroup.induction_on with
  | H s =>
    obtain ⟨a, ha⟩ := (mem_sphericalClasses_iff x).1 s.property
    exact ⟨a, congrArg _ (Subtype.ext ha)⟩

/-- **The period group is trivial exactly when `ω` and `c` vanish on all spheres**, as they do for
a symplectically aspherical manifold whose first Chern class vanishes on spheres. -/
theorem subsingleton_iff :
    Subsingleton (SphericalPeriodGroup ω c) ↔
      ∀ x (a : Additive (HomotopyGroup (Fin 2) X x)),
        ω (hurewiczIntHom X x 1 a) = 0 ∧ c (hurewiczIntHom X x 1 a) = 0 := by
  rw [PeriodGroup.subsingleton_iff]
  refine ⟨fun h x a ↦ h ⟨_, hurewiczIntHom_mem_sphericalClasses x a⟩, fun h s ↦ ?_⟩
  -- The joint kernel of `ω` and `c` contains every Hurewicz class, hence every spherical class.
  have hle : sphericalClasses X 1 ≤ (ω.prod c).ker :=
    sphericalClasses_le_iff.2 fun x a ↦ by simpa using h x a
  simpa using hle s.property

/-- **If every sphere is null-homotopic, the period group is trivial**, whatever `ω` and `c`
are. -/
theorem subsingleton_of_forall_subsingleton
    (h : ∀ y : X, Subsingleton (HomotopyGroup (Fin 2) X y)) :
    Subsingleton (SphericalPeriodGroup ω c) :=
  subsingleton_iff.2 fun y a => by
    have := h y
    rw [Subsingleton.elim a 0, map_zero, map_zero, map_zero]
    exact ⟨rfl, rfl⟩

/-- **On an aspherical space the period group is trivial**, whatever `ω` and `c` are. This covers
tori (`AddCircle.isAspherical_pi`). -/
theorem subsingleton_of_isAspherical {x : X} (h : IsAspherical X x) :
    Subsingleton (SphericalPeriodGroup ω c) :=
  subsingleton_of_forall_subsingleton fun y => (h.of_basepoint y).subsingleton_homotopyGroup 0

section SingularHomology

variable (h : sphericalClasses X 1 = ⊤)

variable (ω c) in
/-- The class in the period group of a class of `H₂(X; ℤ)`, when every class of `H₂(X; ℤ)` is
spherical, as on the two-sphere (`TauCeti.sphericalClasses_sphere_eq_top`). It is the class
projection of the coefficient comparison `q^A ↦ e^(-[A])` for Gromov–Witten series indexed by
`H₂(X; ℤ)`. -/
def ofSingularHomology :
    ((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj (ModuleCat.of ℤ ℤ)).obj (TopCat.of X) →+
      SphericalPeriodGroup ω c :=
  (QuotientAddGroup.mk' _).comp ((AddMonoidHom.id _).codRestrict _ fun A => by simp [h])

/-- The area of the class of `A ∈ H₂(X; ℤ)` is `ω A`. -/
@[simp]
theorem area_ofSingularHomology (A) : PeriodGroup.area _ _ (ofSingularHomology ω c h A) = ω A := by
  simp [ofSingularHomology]

/-- The first Chern number of the class of `A ∈ H₂(X; ℤ)` is `c A`. -/
@[simp]
theorem chern_ofSingularHomology (A) :
    PeriodGroup.chern _ _ (ofSingularHomology ω c h A) = c A := by
  simp [ofSingularHomology]

/-- The class of the Hurewicz class of a sphere is the class of the sphere. -/
@[simp]
theorem ofSingularHomology_hurewiczIntHom (x : X) (a : Additive (HomotopyGroup (Fin 2) X x)) :
    ofSingularHomology ω c h (hurewiczIntHom X x 1 a) = ofHomotopyGroup ω c x a :=
  PeriodGroup.ext (by simp) (by simp)

/-- Every class of the period group is the class of a class of `H₂(X; ℤ)`. -/
theorem ofSingularHomology_surjective : Function.Surjective (ofSingularHomology ω c h) := by
  intro γ
  induction γ using QuotientAddGroup.induction_on with
  | H s => exact ⟨s, PeriodGroup.ext (by simp) (by simp)⟩

end SingularHomology

section Generator

/-! ### A period group generated by one sphere

On the two-sphere and on complex projective space, `H₂(X; ℤ)` is generated by the Hurewicz class
of a single sphere `a`. Then the period group is cyclic, generated by the class of `a`, and both
of its periods are read off from that class. -/

variable {x : X} {a : Additive (HomotopyGroup (Fin 2) X x)}

/-- The class of a spherical class `s = k [a]` is `k` times the class of the sphere `a`. -/
theorem mk_eq_zsmul_ofHomotopyGroup {s : sphericalClasses X 1} {k : ℤ}
    (hs : k • hurewiczIntHom X x 1 a = s) :
    (s : SphericalPeriodGroup ω c) = k • ofHomotopyGroup ω c x a :=
  PeriodGroup.ext (by simp [← hs]) (by simp [← hs])

/-- The class of a sphere is nonzero when one of its periods is. -/
theorem ofHomotopyGroup_ne_zero
    (hσ : PeriodGroup.area _ _ (ofHomotopyGroup ω c x a) ≠ 0 ∨
      PeriodGroup.chern _ _ (ofHomotopyGroup ω c x a) ≠ 0) :
    ofHomotopyGroup ω c x a ≠ 0 :=
  fun h0 => by simp [h0] at hσ

/-- **The multiples of the class of a sphere are distinct** when one of its periods is nonzero,
since the period group is torsion-free. -/
theorem zsmul_ofHomotopyGroup_injective
    (hσ : PeriodGroup.area _ _ (ofHomotopyGroup ω c x a) ≠ 0 ∨
      PeriodGroup.chern _ _ (ofHomotopyGroup ω c x a) ≠ 0) :
    Function.Injective fun k : ℤ => k • ofHomotopyGroup ω c x a :=
  IsAddTorsionFree.zsmul_left_injective (ofHomotopyGroup_ne_zero hσ)

variable (ha : AddSubgroup.zmultiples (hurewiczIntHom X x 1 a) = ⊤)
include ha

/-- **The class of a sphere whose Hurewicz class generates `H₂(X; ℤ)` generates the period
group.** -/
theorem zmultiples_ofHomotopyGroup_eq_top :
    AddSubgroup.zmultiples (ofHomotopyGroup ω c x a) = ⊤ := by
  refine (AddSubgroup.eq_top_iff' _).2 fun γ => ?_
  induction γ using QuotientAddGroup.induction_on with
  | H s =>
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 ((AddSubgroup.eq_top_iff' _).1 ha (s : _))
    exact AddSubgroup.mem_zmultiples_iff.2 ⟨k, (mk_eq_zsmul_ofHomotopyGroup hk).symm⟩

/-- If the Hurewicz class of `a` generates `H₂(X; ℤ)`, every class of the period group is an
integer multiple of the class of `a`. -/
theorem exists_zsmul_ofHomotopyGroup_eq (γ : SphericalPeriodGroup ω c) :
    ∃ k : ℤ, k • ofHomotopyGroup ω c x a = γ :=
  AddSubgroup.mem_zmultiples_iff.1
    ((AddSubgroup.eq_top_iff' _).1 (zmultiples_ofHomotopyGroup_eq_top ha) γ)

/-- If the Hurewicz class of a sphere generates `H₂(X; ℤ)`, the period group is cyclic. -/
theorem isAddCyclic_of_zmultiples_eq_top : IsAddCyclic (SphericalPeriodGroup ω c) :=
  ⟨⟨_, exists_zsmul_ofHomotopyGroup_eq ha⟩⟩

/-- **If the Hurewicz class of a sphere `a` generates `H₂(X; ℤ)`, the period group is trivial
exactly when both periods of `a` vanish.** -/
theorem subsingleton_iff_of_zmultiples_eq_top :
    Subsingleton (SphericalPeriodGroup ω c) ↔
      PeriodGroup.area _ _ (ofHomotopyGroup ω c x a) = 0 ∧
        PeriodGroup.chern _ _ (ofHomotopyGroup ω c x a) = 0 := by
  refine ⟨fun _ => ⟨by rw [Subsingleton.elim (ofHomotopyGroup ω c x a) 0, map_zero],
    by rw [Subsingleton.elim (ofHomotopyGroup ω c x a) 0, map_zero]⟩, fun ⟨harea, hchern⟩ => ?_⟩
  refine ⟨fun γ γ' => ?_⟩
  obtain ⟨k, rfl⟩ := exists_zsmul_ofHomotopyGroup_eq ha γ
  obtain ⟨l, rfl⟩ := exists_zsmul_ofHomotopyGroup_eq ha γ'
  exact PeriodGroup.ext (by simp [harea]) (by simp [hchern])

/-- **If the Hurewicz class of a sphere `a` generates `H₂(X; ℤ)`, the class map `H₂(X; ℤ) → Γ` is
injective unless both periods of `a` vanish**, so `SphericalPeriodGroup.ofSingularHomology` is an
isomorphism `H₂(X; ℤ) ≅ Γ`. -/
theorem ofSingularHomology_injective_of_zmultiples_eq_top (h : sphericalClasses X 1 = ⊤)
    (hσ : PeriodGroup.area _ _ (ofHomotopyGroup ω c x a) ≠ 0 ∨
      PeriodGroup.chern _ _ (ofHomotopyGroup ω c x a) ≠ 0) :
    Function.Injective (ofSingularHomology ω c h) := by
  intro A B hAB
  obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 ((AddSubgroup.eq_top_iff' _).1 ha A)
  obtain ⟨l, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 ((AddSubgroup.eq_top_iff' _).1 ha B)
  rw [map_zsmul, map_zsmul, ofSingularHomology_hurewiczIntHom] at hAB
  rw [zsmul_ofHomotopyGroup_injective hσ hAB]

/-- **If the Hurewicz class of a sphere `a` with nonzero area generates `H₂(X; ℤ)`, area is
injective on the period group**, so a cap class is determined by its action alone
(`TauCeti.Floer.eq_iff_action_eq_of_area_injective`). -/
theorem area_injective_of_zmultiples_eq_top
    (h : PeriodGroup.area _ _ (ofHomotopyGroup ω c x a) ≠ 0) :
    Function.Injective (PeriodGroup.area _ _ : SphericalPeriodGroup ω c → ℝ) := fun γ γ' hγ =>
  congrArg Subtype.val <| (PeriodGroup.area _ _).comp_zmultiples_subtype_injective h
    (a₁ := ⟨γ, zmultiples_ofHomotopyGroup_eq_top ha ▸ AddSubgroup.mem_top γ⟩)
    (a₂ := ⟨γ', zmultiples_ofHomotopyGroup_eq_top ha ▸ AddSubgroup.mem_top γ'⟩) hγ

/-- **If the Hurewicz class of a sphere `a` with nonzero first Chern number generates `H₂(X; ℤ)`,
`X` is spherically monotone**: on spherical classes `ω = τ c` with `τ = ω [a] / c [a]`. This is the
hypothesis of the monotone Laurent model `TauCeti.Floer.NovikovRing.toLaurentSeries`. -/
theorem area_eq_mul_chern_of_zmultiples_eq_top
    (h : PeriodGroup.chern _ _ (ofHomotopyGroup ω c x a) ≠ 0) (s : sphericalClasses X 1) :
    ω.comp (sphericalClasses X 1).subtype s =
      PeriodGroup.area _ _ (ofHomotopyGroup ω c x a) /
          PeriodGroup.chern _ _ (ofHomotopyGroup ω c x a) *
        c.comp (sphericalClasses X 1).subtype s := by
  obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 ((AddSubgroup.eq_top_iff' _).1 ha (s : _))
  have h' : (c (hurewiczIntHom X x 1 a) : ℝ) ≠ 0 := by
    exact_mod_cast (chern_ofHomotopyGroup (ω := ω) x a) ▸ h
  simp only [AddMonoidHom.coe_comp, AddSubgroup.coe_subtype, Function.comp_apply, ← hk,
    map_zsmul, zsmul_eq_mul, area_ofHomotopyGroup, chern_ofHomotopyGroup, Int.cast_mul]
  field_simp
  push_cast
  ring

/-- **If the Hurewicz class of a sphere `a` with nonzero first Chern number generates
`H₂(X; ℤ)`, the Chern number is injective on the period group**, so a cap class is determined by
its grading alone (`TauCeti.Floer.eq_iff_index_eq_of_chern_injective`). -/
theorem chern_injective_of_zmultiples_eq_top
    (h : PeriodGroup.chern _ _ (ofHomotopyGroup ω c x a) ≠ 0) :
    Function.Injective (PeriodGroup.chern _ _ : SphericalPeriodGroup ω c → ℤ) :=
  PeriodGroup.chern_injective_of_area_eq_mul_chern (area_eq_mul_chern_of_zmultiples_eq_top ha h)

end Generator

section Map

variable {ω' : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj (ModuleCat.of ℤ ℤ)).obj
    (TopCat.of Y) →+ ℝ}
  {c' : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj (ModuleCat.of ℤ ℤ)).obj
    (TopCat.of Y) →+ ℤ}
  (f : C(X, Y))

variable (hω : (ω'.comp (sphericalClasses Y 1).subtype).comp (sphericalClassesMap f 1) =
    ω.comp (sphericalClasses X 1).subtype)
  (hc : (c'.comp (sphericalClasses Y 1).subtype).comp (sphericalClassesMap f 1) =
    c.comp (sphericalClasses X 1).subtype)

/-- The homomorphism of period groups induced by a continuous map `f : X → Y` along which `ω` and
`c` are pulled back from `ω'` and `c'` on spherical classes. -/
def map : SphericalPeriodGroup ω c →+ SphericalPeriodGroup ω' c' :=
  PeriodGroup.map (sphericalClassesMap f 1) hω hc

/-- The induced map of period groups preserves area. -/
@[simp]
theorem area_map (γ : SphericalPeriodGroup ω c) :
    PeriodGroup.area _ _ (map f hω hc γ) = PeriodGroup.area _ _ γ :=
  PeriodGroup.area_map _ _ _ γ

/-- The induced map of period groups preserves the first Chern number. -/
@[simp]
theorem chern_map (γ : SphericalPeriodGroup ω c) :
    PeriodGroup.chern _ _ (map f hω hc γ) = PeriodGroup.chern _ _ γ :=
  PeriodGroup.chern_map _ _ _ γ

/-- The induced map of period groups sends the class of a sphere `a` to the class of its image
`f_* a`. -/
@[simp]
theorem map_ofHomotopyGroup (x : X) (a : HomotopyGroup (Fin 2) X x) :
    map f hω hc (ofHomotopyGroup ω c x (Additive.ofMul a)) =
      ofHomotopyGroup ω' c' (f x) (Additive.ofMul (HomotopyGroup.map f rfl a)) :=
  PeriodGroup.ext
    (by
      simpa [sphericalClassesMap_hurewiczIntHom] using
        (DFunLike.congr_fun hω ⟨_, hurewiczIntHom_mem_sphericalClasses x (Additive.ofMul a)⟩).symm)
    (by
      simpa [sphericalClassesMap_hurewiczIntHom] using
        (DFunLike.congr_fun hc ⟨_, hurewiczIntHom_mem_sphericalClasses x (Additive.ofMul a)⟩).symm)

end Map

end SphericalPeriodGroup

end TauCeti.Floer
