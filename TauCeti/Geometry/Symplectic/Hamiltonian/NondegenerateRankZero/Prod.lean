/-!
# Direct sums of nondegenerate quadratic families

Let `(V, ω₁)` and `(W, ω₂)` be finite-dimensional real symplectic vector spaces, and give `V × W`
the direct-sum form `ω₁ ⊕ ω₂` (`TauCeti.SymplecticForm.prod`). A family `Q₁` of quadratic forms
on `V` and a family `Q₂` on `W` combine into the family on `V × W` made of the forms
`(v, w) ↦ Q₁ i v` and `(v, w) ↦ Q₂ j w`. Williamson's normal forms of nondegenerate rank-zero
points of integrable systems are such direct sums of elliptic, hyperbolic and focus-focus blocks,
and this file shows how nondegeneracy, in the sense of
`TauCeti.SymplecticForm.IsNondegenerateQuadraticFamily`, passes to direct sums.

The Hamiltonian endomorphism of `Q₁ ⊕ Q₂` is the block-diagonal endomorphism `A_{Q₁} × A_{Q₂}`
(`TauCeti.SymplecticForm.hamiltonianEnd_prod`). Nondegeneracy is certified by a regular element:
a quadratic form `P` whose Hamiltonian endomorphism has its Engel subalgebra inside the Lie
subalgebra generated by the family
(`TauCeti.SymplecticForm.isNondegenerateQuadraticFamily_of_engel_le`).
Suppose `P₁` and `P₂` are such certificates for `Q₁` and `Q₂`, and that `A_{P₁}` and `A_{P₂}` are
annihilated by coprime polynomials (for instance their characteristic polynomials are coprime,
that is they share no complex eigenvalue). Then `P₁ ⊕ P₂` certifies the combined family
(`TauCeti.SymplecticForm.engel_hamiltonianEndEquiv_prod_le`). Indeed, an element `X` of
`sp(V × W, ω₁ ⊕ ω₂)` in the Engel subalgebra of `A = A_{P₁} × A_{P₂}` has off-diagonal blocks
`X₁₂ : W → V`, `X₂₁ : V → W` killed by a power of the Sylvester operators
`Z ↦ A_{P₁} Z - Z A_{P₂}` and `Z ↦ A_{P₂} Z - Z A_{P₁}`, which are injective by coprimality
(`Module.End.eq_zero_of_comp_eq_of_isCoprime`). So `X` is block diagonal, and its diagonal blocks
lie in the Engel subalgebras of `A_{P₁}` and `A_{P₂}`.

Since the certificate is again of the same kind, this applies iteratively to sums of any number
of blocks. As an instance, any two nondegenerate quadratic forms on symplectic planes give a
nondegenerate pair on their direct sum
(`TauCeti.SymplecticForm.isNondegenerateQuadraticFamily_prod_of_finrank_eq_two`): these are the
elliptic-elliptic, elliptic-hyperbolic and hyperbolic-hyperbolic models of Williamson's
classification in dimension four, including the resonant case of equal frequencies.

## Main results

* `TauCeti.SymplecticForm.hamiltonianEnd_prod`: `A_{Q₁ ⊕ Q₂} = A_{Q₁} × A_{Q₂}`.
* `TauCeti.SymplecticForm.engel_hamiltonianEndEquiv_prod_le`: regular certificates with coprime
  annihilating polynomials combine into a regular certificate of the direct-sum family.
* `TauCeti.SymplecticForm.isNondegenerateQuadraticFamily_sumElim_of_engel_le`: the direct-sum
  family is then nondegenerate.
* `TauCeti.SymplecticForm.isNondegenerateQuadraticFamily_prod_of_finrank_eq_two`: two
  nondegenerate quadratic forms on symplectic planes form a nondegenerate pair on the direct sum.

## References

* J. Williamson, *On the algebraic problem concerning the normal forms of linear dynamical
  systems*, American Journal of Mathematics 58 (1936), 141–163.
* A. V. Bolsinov and A. T. Fomenko, *Integrable Hamiltonian Systems: Geometry, Topology,
  Classification*, Chapman & Hall/CRC, 2004, Chapter 1.
-/

public section

open LieSubalgebra Module Polynomial

-- `sp(V, ω)` is a Lie subalgebra of `Module.End ℝ V` for the commutator bracket, as in Mathlib's
-- `Mathlib.Algebra.Lie.SkewAdjoint`.
attribute [local instance 100] LieRing.ofAssociativeRing

namespace TauCeti.SymplecticForm

variable {V W : Type*} [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]
  {ω₁ : SymplecticForm V} {ω₂ : SymplecticForm W}

/-! ### Block decomposition of the symplectic Lie algebra of a direct sum -/

/-- The upper-left block of an element of `sp(V × W, ω₁ ⊕ ω₂)` lies in `sp(V, ω₁)`. -/
private theorem fst_comp_comp_inl_mem {X : Module.End ℝ (V × W)}
    (hX : X ∈ skewAdjointLieSubalgebra (ω₁.prod ω₂).toBilinForm) :
    LinearMap.fst ℝ V W ∘ₗ X ∘ₗ LinearMap.inl ℝ V W ∈
      skewAdjointLieSubalgebra ω₁.toBilinForm := by
  refine (LinearMap.mem_skewAdjointSubmodule _).2 fun v w ↦ ?_
  simpa using (LinearMap.mem_skewAdjointSubmodule _).1 hX (v, 0) (w, 0)

/-- The lower-right block of an element of `sp(V × W, ω₁ ⊕ ω₂)` lies in `sp(W, ω₂)`. -/
private theorem snd_comp_comp_inr_mem {X : Module.End ℝ (V × W)}
    (hX : X ∈ skewAdjointLieSubalgebra (ω₁.prod ω₂).toBilinForm) :
    LinearMap.snd ℝ V W ∘ₗ X ∘ₗ LinearMap.inr ℝ V W ∈
      skewAdjointLieSubalgebra ω₂.toBilinForm := by
  refine (LinearMap.mem_skewAdjointSubmodule _).2 fun v w ↦ ?_
  simpa using (LinearMap.mem_skewAdjointSubmodule _).1 hX (0, v) (0, w)

variable (ω₁ ω₂) in
/-- The embedding `X ↦ X × 0` of `sp(V, ω₁)` into `sp(V × W, ω₁ ⊕ ω₂)`. -/
private def inlSkewAdjoint :
    skewAdjointLieSubalgebra ω₁.toBilinForm →ₗ⁅ℝ⁆
      skewAdjointLieSubalgebra (ω₁.prod ω₂).toBilinForm where
  toFun X := ⟨(X : Module.End ℝ V).prodMap 0,
    (LinearMap.mem_skewAdjointSubmodule _).2 fun v w ↦ by
      simpa using (LinearMap.mem_skewAdjointSubmodule _).1 X.2 v.1 w.1⟩
  map_add' X Y := Subtype.ext (by ext <;> simp)
  map_smul' c X := Subtype.ext (by ext <;> simp)
  map_lie' {X Y} := Subtype.ext (by ext <;> simp [Ring.lie_def])

variable (ω₁ ω₂) in
/-- The embedding `X ↦ 0 × X` of `sp(W, ω₂)` into `sp(V × W, ω₁ ⊕ ω₂)`. -/
private def inrSkewAdjoint :
    skewAdjointLieSubalgebra ω₂.toBilinForm →ₗ⁅ℝ⁆
      skewAdjointLieSubalgebra (ω₁.prod ω₂).toBilinForm where
  toFun X := ⟨(0 : Module.End ℝ V).prodMap (X : Module.End ℝ W),
    (LinearMap.mem_skewAdjointSubmodule _).2 fun v w ↦ by
      simpa using (LinearMap.mem_skewAdjointSubmodule _).1 X.2 v.2 w.2⟩
  map_add' X Y := Subtype.ext (by ext <;> simp)
  map_smul' c X := Subtype.ext (by ext <;> simp)
  map_lie' {X Y} := Subtype.ext (by ext <;> simp [Ring.lie_def])

/-- Block-diagonal endomorphisms with commuting blocks commute. -/
private theorem commute_prodMap {A A' : Module.End ℝ V} {B B' : Module.End ℝ W}
    (hA : Commute A A') (hB : Commute B B') : Commute (A.prodMap B) (A'.prodMap B') :=
  (Commute.prod (x := (A, B)) (y := (A', B')) hA hB).map (LinearMap.prodMapAlgHom ℝ V W)

/-- The four blocks of the commutator of `A × B` with an endomorphism `Y` of `V × W`. -/
private theorem blocks_lie_prodMap (A : Module.End ℝ V) (B : Module.End ℝ W)
    (Y : Module.End ℝ (V × W)) :
    LinearMap.fst ℝ V W ∘ₗ ⁅A.prodMap B, Y⁆ ∘ₗ LinearMap.inl ℝ V W =
        ⁅A, LinearMap.fst ℝ V W ∘ₗ Y ∘ₗ LinearMap.inl ℝ V W⁆ ∧
      LinearMap.snd ℝ V W ∘ₗ ⁅A.prodMap B, Y⁆ ∘ₗ LinearMap.inr ℝ V W =
        ⁅B, LinearMap.snd ℝ V W ∘ₗ Y ∘ₗ LinearMap.inr ℝ V W⁆ ∧
      LinearMap.fst ℝ V W ∘ₗ ⁅A.prodMap B, Y⁆ ∘ₗ LinearMap.inr ℝ V W =
        A ∘ₗ (LinearMap.fst ℝ V W ∘ₗ Y ∘ₗ LinearMap.inr ℝ V W) -
          (LinearMap.fst ℝ V W ∘ₗ Y ∘ₗ LinearMap.inr ℝ V W) ∘ₗ B ∧
      LinearMap.snd ℝ V W ∘ₗ ⁅A.prodMap B, Y⁆ ∘ₗ LinearMap.inl ℝ V W =
        B ∘ₗ (LinearMap.snd ℝ V W ∘ₗ Y ∘ₗ LinearMap.inl ℝ V W) -
          (LinearMap.snd ℝ V W ∘ₗ Y ∘ₗ LinearMap.inl ℝ V W) ∘ₗ A := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> ext <;> simp [Ring.lie_def]

/-- If `A` and `B` are annihilated by coprime polynomials and a power of `ad (A × B)` kills `Y`,
then `Y` is block diagonal and the same power of `ad A`, `ad B` kills its diagonal blocks. -/
private theorem blocks_of_ad_pow_eq_zero {A : Module.End ℝ V} {B : Module.End ℝ W}
    {p₁ p₂ : ℝ[X]} (hp : IsCoprime p₁ p₂) (hp₁ : aeval A p₁ = 0) (hp₂ : aeval B p₂ = 0) :
    ∀ (n : ℕ) (Y : Module.End ℝ (V × W)),
      (LieAlgebra.ad ℝ (Module.End ℝ (V × W)) (A.prodMap B) ^ n) Y = 0 →
        (LieAlgebra.ad ℝ (Module.End ℝ V) A ^ n)
            (LinearMap.fst ℝ V W ∘ₗ Y ∘ₗ LinearMap.inl ℝ V W) = 0 ∧
          (LieAlgebra.ad ℝ (Module.End ℝ W) B ^ n)
            (LinearMap.snd ℝ V W ∘ₗ Y ∘ₗ LinearMap.inr ℝ V W) = 0 ∧
          LinearMap.fst ℝ V W ∘ₗ Y ∘ₗ LinearMap.inr ℝ V W = 0 ∧
          LinearMap.snd ℝ V W ∘ₗ Y ∘ₗ LinearMap.inl ℝ V W = 0 := by
  intro n
  induction n with
  | zero =>
    intro Y hY
    simp only [pow_zero, one_apply_eq_self] at hY
    simp [hY]
  | succ n ih =>
    intro Y hY
    rw [pow_succ, mul_apply_eq_comp, LieAlgebra.ad_apply] at hY
    obtain ⟨h₁₁, h₂₂, h₁₂, h₂₁⟩ := ih _ hY
    obtain ⟨e₁₁, e₂₂, e₁₂, e₂₁⟩ := blocks_lie_prodMap A B Y
    rw [e₁₂, sub_eq_zero] at h₁₂
    rw [e₂₁, sub_eq_zero] at h₂₁
    refine ⟨?_, ?_, Module.End.eq_zero_of_comp_eq_of_isCoprime h₁₂ hp hp₁ hp₂,
      Module.End.eq_zero_of_comp_eq_of_isCoprime h₂₁ hp.symm hp₂ hp₁⟩
    · rwa [pow_succ, mul_apply_eq_comp, LieAlgebra.ad_apply, ← e₁₁]
    · rwa [pow_succ, mul_apply_eq_comp, LieAlgebra.ad_apply, ← e₂₂]

/-! ### Hamiltonian endomorphisms of direct sums -/

variable [FiniteDimensional ℝ V] [FiniteDimensional ℝ W]

/-- The Hamiltonian endomorphism of the direct sum `Q₁ ⊕ Q₂` is the block-diagonal endomorphism
`A_{Q₁} × A_{Q₂}`. -/
@[simp]
theorem hamiltonianEnd_prod (Q₁ : QuadraticForm ℝ V) (Q₂ : QuadraticForm ℝ W) :
    (ω₁.prod ω₂).hamiltonianEnd (Q₁.prod Q₂) =
      (ω₁.hamiltonianEnd Q₁).prodMap (ω₂.hamiltonianEnd Q₂) := by
  refine ((ω₁.prod ω₂).eq_hamiltonianEnd_iff.2 fun v w ↦ ?_).symm
  simp [apply_hamiltonianEnd]

/-- The Hamiltonian endomorphism of `(v, w) ↦ Q v` is `A_Q × 0`. -/
@[simp]
theorem hamiltonianEnd_comp_fst (Q : QuadraticForm ℝ V) :
    (ω₁.prod ω₂).hamiltonianEnd (Q.comp (LinearMap.fst ℝ V W)) =
      (ω₁.hamiltonianEnd Q).prodMap 0 := by
  refine ((ω₁.prod ω₂).eq_hamiltonianEnd_iff.2 fun v w ↦ ?_).symm
  simp [apply_hamiltonianEnd, QuadraticMap.polar]

/-- The Hamiltonian endomorphism of `(v, w) ↦ Q w` is `0 × A_Q`. -/
@[simp]
theorem hamiltonianEnd_comp_snd (Q : QuadraticForm ℝ W) :
    (ω₁.prod ω₂).hamiltonianEnd (Q.comp (LinearMap.snd ℝ V W)) =
      (0 : Module.End ℝ V).prodMap (ω₂.hamiltonianEnd Q) := by
  refine ((ω₁.prod ω₂).eq_hamiltonianEnd_iff.2 fun v w ↦ ?_).symm
  simp [apply_hamiltonianEnd, QuadraticMap.polar]

/-! ### Regular certificates of direct sums -/

/-- **Regular certificates of direct sums.** Let `P₁` certify the family `Q₁` on `(V, ω₁)`, in the
sense that the Engel subalgebra of `A_{P₁}` lies in the Lie subalgebra generated by the `A_{Q₁ i}`,
and likewise `P₂` certify `Q₂` on `(W, ω₂)`. If `A_{P₁}` and `A_{P₂}` are annihilated by coprime
polynomials, then `P₁ ⊕ P₂` certifies the family on `V × W` made of the forms
`(v, w) ↦ Q₁ i v` and `(v, w) ↦ Q₂ j w`. -/
theorem engel_hamiltonianEndEquiv_prod_le {ι κ : Type*} {Q₁ : ι → QuadraticForm ℝ V}
    {Q₂ : κ → QuadraticForm ℝ W} {P₁ : QuadraticForm ℝ V} {P₂ : QuadraticForm ℝ W}
    (h₁ : engel ℝ (ω₁.hamiltonianEndEquiv P₁) ≤ lieSpan ℝ (skewAdjointLieSubalgebra ω₁.toBilinForm)
      (Set.range fun i ↦ ω₁.hamiltonianEndEquiv (Q₁ i)))
    (h₂ : engel ℝ (ω₂.hamiltonianEndEquiv P₂) ≤ lieSpan ℝ (skewAdjointLieSubalgebra ω₂.toBilinForm)
      (Set.range fun j ↦ ω₂.hamiltonianEndEquiv (Q₂ j)))
    {p₁ p₂ : ℝ[X]} (hp : IsCoprime p₁ p₂) (hp₁ : aeval (ω₁.hamiltonianEnd P₁) p₁ = 0)
    (hp₂ : aeval (ω₂.hamiltonianEnd P₂) p₂ = 0) :
    engel ℝ ((ω₁.prod ω₂).hamiltonianEndEquiv (P₁.prod P₂)) ≤
      lieSpan ℝ (skewAdjointLieSubalgebra (ω₁.prod ω₂).toBilinForm)
        (Set.range fun k ↦ (ω₁.prod ω₂).hamiltonianEndEquiv
          (Sum.elim (fun i ↦ (Q₁ i).comp (LinearMap.fst ℝ V W))
            (fun j ↦ (Q₂ j).comp (LinearMap.snd ℝ V W)) k)) := by
  set S := lieSpan ℝ (skewAdjointLieSubalgebra (ω₁.prod ω₂).toBilinForm)
    (Set.range fun k ↦ (ω₁.prod ω₂).hamiltonianEndEquiv
      (Sum.elim (fun i ↦ (Q₁ i).comp (LinearMap.fst ℝ V W))
        (fun j ↦ (Q₂ j).comp (LinearMap.snd ℝ V W)) k))
  -- The two embeddings carry the generators of each factor to generators of `S`.
  have hl : lieSpan ℝ (skewAdjointLieSubalgebra ω₁.toBilinForm)
      (Set.range fun i ↦ ω₁.hamiltonianEndEquiv (Q₁ i)) ≤ S.comap (inlSkewAdjoint ω₁ ω₂) := by
    rw [lieSpan_le]
    rintro _ ⟨i, rfl⟩
    refine subset_lieSpan ⟨Sum.inl i, Subtype.ext ?_⟩
    simp [inlSkewAdjoint, coe_hamiltonianEndEquiv_apply, hamiltonianEnd_comp_fst]
  have hr : lieSpan ℝ (skewAdjointLieSubalgebra ω₂.toBilinForm)
      (Set.range fun j ↦ ω₂.hamiltonianEndEquiv (Q₂ j)) ≤ S.comap (inrSkewAdjoint ω₁ ω₂) := by
    rw [lieSpan_le]
    rintro _ ⟨j, rfl⟩
    refine subset_lieSpan ⟨Sum.inr j, Subtype.ext ?_⟩
    simp [inrSkewAdjoint, coe_hamiltonianEndEquiv_apply, hamiltonianEnd_comp_snd]
  intro X hX
  obtain ⟨n, hn⟩ := (mem_engel_iff ℝ _ X).1 hX
  have hn' := congrArg Subtype.val hn
  rw [coe_ad_pow, coe_hamiltonianEndEquiv_apply, hamiltonianEnd_prod,
    ZeroMemClass.coe_zero] at hn'
  obtain ⟨h₁₁, h₂₂, h₁₂, h₂₁⟩ := blocks_of_ad_pow_eq_zero hp hp₁ hp₂ n X hn'
  -- The diagonal blocks of `X`, as elements of `sp(V, ω₁)` and `sp(W, ω₂)`.
  set X₁ : skewAdjointLieSubalgebra ω₁.toBilinForm :=
    ⟨_, fst_comp_comp_inl_mem X.2⟩
  set X₂ : skewAdjointLieSubalgebra ω₂.toBilinForm :=
    ⟨_, snd_comp_comp_inr_mem X.2⟩
  have hX₁ : X₁ ∈ engel ℝ (ω₁.hamiltonianEndEquiv P₁) := by
    refine (mem_engel_iff ℝ _ _).2 ⟨n, Subtype.ext ?_⟩
    rw [coe_ad_pow, coe_hamiltonianEndEquiv_apply]
    exact h₁₁
  have hX₂ : X₂ ∈ engel ℝ (ω₂.hamiltonianEndEquiv P₂) := by
    refine (mem_engel_iff ℝ _ _).2 ⟨n, Subtype.ext ?_⟩
    rw [coe_ad_pow, coe_hamiltonianEndEquiv_apply]
    exact h₂₂
  -- Since its off-diagonal blocks vanish, `X` is the sum of the embedded diagonal blocks.
  have hXeq : X = inlSkewAdjoint ω₁ ω₂ X₁ + inrSkewAdjoint ω₁ ω₂ X₂ := by
    refine Subtype.ext (LinearMap.ext fun x ↦ ?_)
    have e₁₂ := LinearMap.congr_fun h₁₂ x.2
    have e₂₁ := LinearMap.congr_fun h₂₁ x.1
    simp only [LinearMap.comp_apply, LinearMap.inr_apply, LinearMap.inl_apply,
      LinearMap.fst_apply, LinearMap.snd_apply, LinearMap.zero_apply] at e₁₂ e₂₁
    have hx : (X : Module.End ℝ (V × W)) x =
        (X : Module.End ℝ (V × W)) (x.1, 0) + (X : Module.End ℝ (V × W)) (0, x.2) := by
      rw [← map_add, Prod.mk_add_mk, add_zero, zero_add]
    ext <;> simp [hx, X₁, X₂, inlSkewAdjoint, inrSkewAdjoint, e₁₂, e₂₁]
  rw [hXeq]
  exact add_mem (hl (h₁ hX₁)) (hr (h₂ hX₂))

/-- **Direct sums of nondegenerate families.** Let `Q₁` be a Poisson-commuting family on
`(V, ω₁)` certified by `P₁` and `Q₂` a Poisson-commuting family on `(W, ω₂)` certified by `P₂`. If
`A_{P₁}` and `A_{P₂}` are annihilated by coprime polynomials, the family on `V × W` made of the
forms `(v, w) ↦ Q₁ i v` and `(v, w) ↦ Q₂ j w` is nondegenerate. -/
theorem isNondegenerateQuadraticFamily_sumElim_of_engel_le {ι κ : Type*}
    {Q₁ : ι → QuadraticForm ℝ V} {Q₂ : κ → QuadraticForm ℝ W}
    (hQ₁ : ∀ i i', ω₁.quadraticPoissonBracket (Q₁ i) (Q₁ i') = 0)
    (hQ₂ : ∀ j j', ω₂.quadraticPoissonBracket (Q₂ j) (Q₂ j') = 0)
    {P₁ : QuadraticForm ℝ V} {P₂ : QuadraticForm ℝ W}
    (h₁ : engel ℝ (ω₁.hamiltonianEndEquiv P₁) ≤ lieSpan ℝ (skewAdjointLieSubalgebra ω₁.toBilinForm)
      (Set.range fun i ↦ ω₁.hamiltonianEndEquiv (Q₁ i)))
    (h₂ : engel ℝ (ω₂.hamiltonianEndEquiv P₂) ≤ lieSpan ℝ (skewAdjointLieSubalgebra ω₂.toBilinForm)
      (Set.range fun j ↦ ω₂.hamiltonianEndEquiv (Q₂ j)))
    {p₁ p₂ : ℝ[X]} (hp : IsCoprime p₁ p₂) (hp₁ : aeval (ω₁.hamiltonianEnd P₁) p₁ = 0)
    (hp₂ : aeval (ω₂.hamiltonianEnd P₂) p₂ = 0) :
    (ω₁.prod ω₂).IsNondegenerateQuadraticFamily
      (Sum.elim (fun i ↦ (Q₁ i).comp (LinearMap.fst ℝ V W))
        (fun j ↦ (Q₂ j).comp (LinearMap.snd ℝ V W))) := by
  refine isNondegenerateQuadraticFamily_of_engel_le ?_ (P₁.prod P₂)
    (engel_hamiltonianEndEquiv_prod_le h₁ h₂ hp hp₁ hp₂)
  rintro (i | j) (i' | j') <;>
    simp only [Sum.elim_inl, Sum.elim_inr, quadraticPoissonBracket_eq_zero_iff,
      hamiltonianEnd_comp_fst, hamiltonianEnd_comp_snd] at hQ₁ hQ₂ ⊢
  · exact commute_prodMap (hQ₁ i i') (Commute.zero_left 0)
  · exact commute_prodMap (Commute.zero_right _) (Commute.zero_left _)
  · exact commute_prodMap (Commute.zero_left _) (Commute.zero_right _)
  · exact commute_prodMap (Commute.zero_left 0) (hQ₂ j j')

/-! ### Pairs of planes -/

section Plane

variable {U : Type*} [AddCommGroup U] [Module ℝ U] [FiniteDimensional ℝ U] {ω : SymplecticForm U}

/-- On a symplectic plane, the Hamiltonian endomorphism of a nondegenerate quadratic form squares
to a nonzero homothety. -/
private theorem exists_mul_self_eq_smul_one_of_nondegenerate (hU : finrank ℝ U = 2)
    {Q : QuadraticForm ℝ U} (hQ : Q.Nondegenerate) :
    ∃ c : ℝ, c ≠ 0 ∧ ω.hamiltonianEnd Q * ω.hamiltonianEnd Q = c • 1 := by
  have : Nontrivial U := Module.nontrivial_of_finrank_pos (R := ℝ) (by omega)
  obtain ⟨c, hc⟩ := exists_mul_self_eq_smul_one hU (ω.hamiltonianEndEquiv Q)
  rw [coe_hamiltonianEndEquiv_apply] at hc
  refine ⟨c, ?_, hc⟩
  rintro rfl
  rw [QuadraticMap.nondegenerate_iff_radical_eq_bot, ← ker_hamiltonianEnd ω,
    LinearMap.ker_eq_bot] at hQ
  obtain ⟨v, hv⟩ := exists_ne (0 : U)
  refine hv ((hQ.comp hQ) ?_)
  simp only [Function.comp_apply, ← mul_apply_eq_comp, hc, zero_smul, map_zero,
    LinearMap.zero_apply]

/-- On a symplectic plane, a quadratic form whose Hamiltonian endomorphism squares to a nonzero
homothety certifies itself. -/
private theorem engel_le_of_mul_self_eq_smul_one (hU : finrank ℝ U = 2) {Q : QuadraticForm ℝ U}
    {c : ℝ} (hc : c ≠ 0) (hQc : ω.hamiltonianEnd Q * ω.hamiltonianEnd Q = c • 1) :
    engel ℝ (ω.hamiltonianEndEquiv Q) ≤ lieSpan ℝ (skewAdjointLieSubalgebra ω.toBilinForm)
      (Set.range fun _ : Unit ↦ ω.hamiltonianEndEquiv Q) := by
  rw [Set.range_const]
  exact engel_le_lieSpan_singleton hU hc (by rwa [coe_hamiltonianEndEquiv_apply])

end Plane

/-- **Nondegenerate pairs on a sum of two planes.** If `Q₁` and `Q₂` are nondegenerate quadratic
forms on two-dimensional symplectic spaces `(V, ω₁)` and `(W, ω₂)`, then the pair of forms
`(v, w) ↦ Q₁ v` and `(v, w) ↦ Q₂ w` on `V × W` is a nondegenerate family. Each `Qᵢ` is elliptic or
hyperbolic, and no condition relates their frequencies. -/
theorem isNondegenerateQuadraticFamily_prod_of_finrank_eq_two (hV : finrank ℝ V = 2)
    (hW : finrank ℝ W = 2) {Q₁ : QuadraticForm ℝ V} {Q₂ : QuadraticForm ℝ W}
    (hQ₁ : Q₁.Nondegenerate) (hQ₂ : Q₂.Nondegenerate) :
    (ω₁.prod ω₂).IsNondegenerateQuadraticFamily
      ![Q₁.comp (LinearMap.fst ℝ V W), Q₂.comp (LinearMap.snd ℝ V W)] := by
  obtain ⟨c₁, hc₁, h₁⟩ := exists_mul_self_eq_smul_one_of_nondegenerate (ω := ω₁) hV hQ₁
  obtain ⟨c₂, hc₂, h₂⟩ := exists_mul_self_eq_smul_one_of_nondegenerate (ω := ω₂) hW hQ₂
  -- Rescale `Q₂` by `t ∈ {2, 3}` so that `c₁ ≠ t² c₂`, making `X² - c₁` and `X² - t² c₂` coprime.
  obtain ⟨t, ht0, ht⟩ : ∃ t : ℝ, t ≠ 0 ∧ c₁ ≠ t ^ 2 * c₂ := by
    by_cases h : c₁ = 2 ^ 2 * c₂
    · exact ⟨3, by norm_num, fun h' ↦ hc₂ (by linarith)⟩
    · exact ⟨2, by norm_num, h⟩
  have h₂' : ω₂.hamiltonianEnd (t • Q₂) * ω₂.hamiltonianEnd (t • Q₂) = (t ^ 2 * c₂) • 1 := by
    rw [map_smul, smul_mul_smul_comm, h₂, smul_smul, sq]
  have hcop : IsCoprime (X ^ 2 - C c₁) (X ^ 2 - C (t ^ 2 * c₂)) := by
    refine ⟨C (t ^ 2 * c₂ - c₁)⁻¹, -C (t ^ 2 * c₂ - c₁)⁻¹, ?_⟩
    rw [neg_mul, ← sub_eq_add_neg, ← mul_sub, sub_sub_sub_cancel_left, ← C_sub, ← C_mul,
      inv_mul_cancel₀ (sub_ne_zero.2 (Ne.symm ht)), C_1]
  have hsum := isNondegenerateQuadraticFamily_sumElim_of_engel_le (ω₁ := ω₁) (ω₂ := ω₂)
    (Q₁ := fun _ : Unit ↦ Q₁) (Q₂ := fun _ : Unit ↦ t • Q₂)
    (fun _ _ ↦ by simp [quadraticPoissonBracket_eq_zero_iff])
    (fun _ _ ↦ by simp [quadraticPoissonBracket_eq_zero_iff])
    (engel_le_of_mul_self_eq_smul_one hV hc₁ h₁)
    (engel_le_of_mul_self_eq_smul_one hW (mul_ne_zero (pow_ne_zero 2 ht0) hc₂) h₂') hcop
    (by rw [map_sub, map_pow, aeval_X, aeval_C, sq, h₁, Algebra.algebraMap_eq_smul_one, sub_self])
    (by rw [map_sub, map_pow, aeval_X, aeval_C, sq, h₂', Algebra.algebraMap_eq_smul_one, sub_self])
  -- The rescaled pair spans the same space as the original pair.
  refine (isNondegenerateQuadraticFamily_iff_of_span_eq ?_).1 hsum
  have hr : Set.range (Sum.elim (fun _ : Unit ↦ Q₁.comp (LinearMap.fst ℝ V W))
      (fun _ : Unit ↦ (t • Q₂).comp (LinearMap.snd ℝ V W))) =
      {Q₁.comp (LinearMap.fst ℝ V W), t • Q₂.comp (LinearMap.snd ℝ V W)} := by
    have : (t • Q₂).comp (LinearMap.snd ℝ V W) = t • Q₂.comp (LinearMap.snd ℝ V W) :=
      QuadraticMap.ext fun x ↦ by simp [QuadraticMap.comp_apply]
    rw [Set.Sum.elim_range, Set.range_const, Set.range_const, Set.singleton_union, this,
      Set.pair_comm]
  rw [hr, Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty,
    Set.singleton_union, Set.pair_comm, Submodule.span_insert, Submodule.span_insert,
    Submodule.span_singleton_smul_eq (IsUnit.mk0 t ht0), sup_comm]

end TauCeti.SymplecticForm
