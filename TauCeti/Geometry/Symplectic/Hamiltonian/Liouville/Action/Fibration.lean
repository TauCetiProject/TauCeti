import Mathlib.Algebra.Group.Subgroup.Finsupp
import TauCeti.Geometry.Manifold.RegularValue.Section

/-!
# Action coordinates on the base of a regular Lagrangian torus fibration

Let `σ` be a symplectic form on a boundaryless manifold `M` and let `π : M → B` be a regular
Lagrangian torus fibration (`TauCeti.SmoothTwoForm.IsNondegenerate.IsLagrangianTorusFibration`)
onto a boundaryless Hausdorff manifold `B` of dimension `n`, with period lattices
`Λ_b ⊆ T*_b B` (`IsLagrangianTorusFibration.periodLattice`). This file proves that every point
`b₀` of `B` has an open neighbourhood `V` and
**action coordinates** `a = (a₁, …, aₙ) : B → ℝⁿ`, injective on `V` and a local diffeomorphism at
every point of `V`, such that

`Λ_b = 2π (ℤ da₁ + ⋯ + ℤ daₙ)` at every `b ∈ V`

(`IsLagrangianTorusFibration.exists_periodLattice_eq_closure_mvfderiv`). So the period lattice is
locally spanned by exact one-forms, and in the coordinates `a` it is the standard lattice
`2π ℤⁿ ⊆ (ℝⁿ)*` at every point of `V`. These are the local action coordinates on the base of
Duistermaat, Section 2.

The proof chooses coordinates `κ : B → ℝⁿ` around the fibre over `b₀`
(`IsLagrangianTorusFibration.exists_coordinates`) and a smooth local section `s` of
`F = κ ∘ π` through a point of that fibre (`TauCeti.IsRegularPoint.exists_contMDiffOn_section`).
The action variables `A` of the integrable system `F` along `s`
(`TauCeti.SmoothTwoForm.IsSymplectic.exists_isLocalDiffeomorphAt_action_of_isCompact`) describe the
periods of `s c` as the transpose lattice `2π (DA_c)ᵀ ℤⁿ`, and `a = A ∘ κ`. Near `b₀` the point
`s (κ b)` lies over `b`, and the covector `v ⬝ᵥ dκ_b` acts on the fibre over `b` as the vector `v`
acts on `s (κ b)` by the Hamiltonian flows of `F`, so it is a period exactly when `v` is a period of
`s (κ b)`. Since `dκ_b` is invertible, this identifies `Λ_b` with the lattice of periods of
`s (κ b)`, and the chain rule turns the generators of the latter into the covectors `2π daᵢ`.

## Main results

* `IsLagrangianTorusFibration.exists_periodLattice_eq_closure_mvfderiv`: local action coordinates
  on the base, in which `Λ_b = 2π (ℤ da₁ + ⋯ + ℤ daₙ)`. It is in the namespace
  `TauCeti.SmoothTwoForm.IsNondegenerate`.

## References

* J. J. Duistermaat, *On global action-angle coordinates*, Comm. Pure Appl. Math. 33 (1980),
  687–706, Section 2 (the integral affine structure of the base).
-/

public section

open Function Set Module Filter
open ContinuousLinearMap (proj)
open scoped ContDiff Manifold Topology Matrix

namespace TauCeti.SmoothTwoForm.IsNondegenerate.IsLagrangianTorusFibration

variable {E H M F H' B : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [T2Space M] [BoundarylessManifold I M] [I.Boundaryless]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] [TopologicalSpace H']
  {J : ModelWithCorners ℝ F H'} [TopologicalSpace B] [ChartedSpace H' B] [IsManifold J ∞ B]
  [T2Space B]
  {σ : SmoothTwoForm I M} {hσ : σ.IsNondegenerate} {π : M → B}

variable (h : hσ.IsLagrangianTorusFibration J π) (hσc : σ.IsClosed)

/-- **The period lattice in action coordinates, at one point.** Let `κ : B → ℝ^ι` be smooth with
invertible differential `D` at `b`, let `y` be a point of the fibre over `b`, and suppose that the
periods of `y` for the Hamiltonian flows of `κ ∘ π` are the integral combinations of vectors `p i`,
and that `A : ℝ^ι → ℝ^ι` has differentials `dAᵢ = (2π)⁻¹ ∑ⱼ pᵢⱼ dcⱼ` at `κ b`. Then the period
lattice at `b` is generated by the covectors `2π d(Aᵢ ∘ κ)_b`. -/
private theorem periodLattice_eq_closure_mvfderiv_comp {ι : Type*} [Fintype ι] {κ : B → ι → ℝ}
    (hκ : ContMDiff J 𝓘(ℝ, ι → ℝ) ∞ κ)
    {b : B} (y : π ⁻¹' {b}) {D : F ≃L[ℝ] (ι → ℝ)}
    (hD : (D : F →L[ℝ] ι → ℝ) = mfderiv J 𝓘(ℝ, ι → ℝ) κ b) {p : ι → ι → ℝ}
    (hstab : (⟨hσc, hσ⟩ : σ.IsSymplectic).hamiltonianFlowStabilizer (hκ.comp h.contMDiff)
      (h.poissonBracket_comp_apply_eq_zero_of_mdifferentiable (hκ.mdifferentiable (by simp)))
      (h.isCompleteVectorField_hamiltonianVectorField_comp_apply (hκ.of_le (by simp)))
      y = AddSubgroup.closure (range p))
    {A : (ι → ℝ) → ι → ℝ}
    (hA : ∀ i, HasFDerivAt (fun c ↦ A c i)
      ((2 * Real.pi)⁻¹ • ∑ j, p i j • (proj j : (ι → ℝ) →L[ℝ] ℝ)) (κ b)) :
    h.periodLattice hσc b = AddSubgroup.closure
      (range fun i ↦ ((2 * Real.pi) • mvfderiv J (fun c ↦ A (κ c) i) b : F →L[ℝ] ℝ)) := by
  classical
  -- The covectors `v ⬝ᵥ dκ_b`, as a linear equivalence `ℝ^ι ≃ T*_b B`.
  let L : (ι → ℝ) ≃ₗ[ℝ] (F →L[ℝ] ℝ) :=
    ((dotProductEquiv ℝ ι).trans LinearMap.toContinuousLinearMap).trans
      (D.symm.arrowCongr (ContinuousLinearEquiv.refl ℝ ℝ)).toLinearEquiv
  have hLw (v : ι → ℝ) (w : F) : L v w = v ⬝ᵥ D w := by
    simp [L]
  have hκb : MDifferentiableAt J 𝓘(ℝ, ι → ℝ) κ b := (hκ b).mdifferentiableAt (by simp)
  -- `dκ_b = D` on tangent vectors.
  have hdκ (w : TangentSpace J b) : mvfderiv J κ b w = D w := by
    rw [mvfderiv_apply_eq_mfderiv_apply, ← hD]
    exact congrFun D.coe_coe w
  -- `d(v ⬝ᵥ κ)_b = L v`, by the chain rule for the linear map `v ⬝ᵥ ·`.
  have hLv (v : ι → ℝ) : mvfderiv J (fun c ↦ v ⬝ᵥ κ c) b = L v :=
    ContinuousLinearMap.ext fun w ↦
      ((LinearMap.toContinuousLinearMap (dotProductEquiv ℝ ι v)).mvfderiv_comp_apply hκb w).trans
        ((congrArg _ (hdκ w)).trans (hLw v w).symm)
  -- `2π daᵢ = L (p i)`, by the chain rule and the formula for `dAᵢ`.
  have hLp (i : ι) : (2 * Real.pi) • mvfderiv J (fun c ↦ A (κ c) i) b = L (p i) := by
    refine ContinuousLinearMap.ext fun w ↦ ?_
    have h1 : mvfderiv J (fun c ↦ A (κ c) i) b w = (2 * Real.pi)⁻¹ * (p i ⬝ᵥ D w) := by
      rw [← fderiv_apply_eq_of_hasFDerivAt_action (hA i), ← hdκ]
      exact mvfderiv_comp_apply_of_differentiableAt (hA i).differentiableAt hκb w
    refine Eq.trans ?_ (hLw _ _).symm
    rw [smul_apply, h1, smul_eq_mul]
    field_simp
  -- Both lattices are images under `L` of the lattice of periods of `y`.
  simp only [hLp]
  ext α
  rw [h.mem_periodLattice_iff_mem_hamiltonianFlowStabilizer hσc b hκ y (L.symm α)
      ((hLv _).trans (L.apply_symm_apply α)), hstab, AddSubgroup.mem_closure_range_iff_of_fintype]
  refine (exists_congr fun n ↦ ?_).trans
    (AddSubgroup.mem_closure_range_iff_of_fintype (f := fun i ↦ L (p i))).symm
  simp_rw [L.symm_apply_eq, map_sum, map_zsmul]

variable [BoundarylessManifold J B]

/-- **Local action coordinates on the base of a regular Lagrangian torus fibration.** Every point
`b₀` of the base has an open neighbourhood `V` and a map `a : B → ℝⁿ`, `n = dim B`, injective on
`V` and a local diffeomorphism at every point of `V`, such that at every `b ∈ V` the period lattice
is generated by the covectors `2π daᵢ`:

`Λ_b = 2π (ℤ da₁ + ⋯ + ℤ daₙ)`.

So the period lattice is locally spanned by exact one-forms, and in the coordinates `a` it is the
standard lattice `2π ℤⁿ` at every point of `V`. -/
theorem exists_periodLattice_eq_closure_mvfderiv (b₀ : B) :
    ∃ (a : B → Fin (finrank ℝ F) → ℝ) (V : Set B), IsOpen V ∧ b₀ ∈ V ∧ InjOn a V ∧
      (∀ b ∈ V, IsLocalDiffeomorphAt J 𝓘(ℝ, Fin (finrank ℝ F) → ℝ) ∞ a b) ∧
      ∀ b ∈ V, h.periodLattice hσc b =
        AddSubgroup.closure
          (range fun i ↦ ((2 * Real.pi) • mvfderiv J (fun c ↦ a c i) b : F →L[ℝ] ℝ)) := by
  classical
  set ι := Fin (finrank ℝ F)
  have hσS : σ.IsSymplectic := ⟨hσc, hσ⟩
  obtain ⟨x₀, hx₀⟩ := (h.isConnected_preimage_singleton b₀).nonempty
  have : Nonempty M := ⟨x₀⟩
  have hπx₀ : π x₀ = b₀ := hx₀
  -- Coordinates `κ` around the fibre over `b₀`, and the integrable system `G = κ ∘ π`.
  obtain ⟨κ, e, hκ, hdκ, hreg, hcomp⟩ := h.exists_coordinates b₀
  set G : M → ι → ℝ := κ ∘ π with hGdef
  have hG : ContMDiff I 𝓘(ℝ, ι → ℝ) ∞ G := hκ.comp h.contMDiff
  have hcomm : ∀ i j x, σ.poissonBracket (G · i) (G · j) x = 0 :=
    h.poissonBracket_comp_apply_eq_zero_of_mdifferentiable (hκ.mdifferentiable (by simp))
  have hc : ∀ i, IsCompleteVectorField (σ.hamiltonianVectorField (G · i)) :=
    h.isCompleteVectorField_hamiltonianVectorField_comp_apply (hκ.of_le (by simp))
  -- A smooth local section `s` of `G` through `x₀`.
  obtain ⟨t, ht, hxt, s, hsx, hs, hGs⟩ :=
    (hreg x₀ hx₀).exists_contMDiffOn_section hG.contMDiffOn isOpen_univ (mem_univ _) (by simp)
  -- The action variables `A` of `G` along `s`.
  have hL : connectedComponentIn (G ⁻¹' {G x₀}) x₀ = π ⁻¹' {b₀} := hcomp x₀ hx₀
  obtain ⟨p, A, hA, hev⟩ := hσS.exists_isLocalDiffeomorphAt_action_of_isCompact hG hcomm hc
    h.two_mul_card_fin_finrank (x := x₀) (fun y hy ↦ hreg y (hL ▸ hy))
    (hL ▸ h.isCompact_preimage_singleton b₀) ht hxt hsx hs hGs
  have hGx₀ : G x₀ = κ b₀ := by rw [hGdef, comp_apply, hπx₀]
  rw [hGx₀] at hA hev hxt hsx
  -- `κ` and the action coordinates `a = A ∘ κ` are local diffeomorphisms at `b₀`.
  have hκloc : IsLocalDiffeomorphAt J 𝓘(ℝ, ι → ℝ) ∞ κ b₀ :=
    isLocalDiffeomorphAt_of_mfderiv_eq hκ.contMDiffOn isOpen_univ (mem_univ _)
      BoundarylessManifold.isInteriorPoint (by simp) (e := e) hdκ.symm
  have haloc : IsLocalDiffeomorphAt J 𝓘(ℝ, ι → ℝ) ∞ (fun b ↦ A (κ b)) b₀ :=
    IsLocalDiffeomorphAt.comp (hf := hκloc) (hg := hA)
  -- An open neighbourhood `O` of `b₀` on which `κ` and `a` are injective local diffeomorphisms.
  obtain ⟨Tκ, hTκ, hκinj⟩ := hκloc.exists_mem_nhds_injOn
  obtain ⟨Ta, hTa, hainj⟩ := haloc.exists_mem_nhds_injOn
  obtain ⟨O, hOsub, hOo, hb₀O⟩ := mem_nhds_iff.1
    ((eventually_mem_set.2 (inter_mem hTκ hTa)).and (hκloc.eventually.and haloc.eventually))
  obtain ⟨U, hUsub, hUo, hκU⟩ := mem_nhds_iff.1 (hev.and (ht.mem_nhds hxt))
  -- The neighbourhood `V`, on which `s (κ b)` lies over `b`.
  set W := O ∩ κ ⁻¹' U
  have hWo : IsOpen W := hOo.inter (hUo.preimage hκ.continuous)
  have hsκ : ContinuousOn (fun b ↦ π (s (κ b))) W :=
    h.contMDiff.continuous.comp_continuousOn <| (hs.continuousOn.mono fun c hc ↦
      (hUsub hc).2).comp hκ.continuous.continuousOn fun _ hb ↦ hb.2
  set V := W ∩ (fun b ↦ π (s (κ b))) ⁻¹' O
  have hVo : IsOpen V := hsκ.isOpen_inter_preimage hWo hOo
  have hb₀V : b₀ ∈ V := ⟨⟨hb₀O, hκU⟩, by simpa [hsx, hπx₀] using hb₀O⟩
  have hπs (b : B) (hb : b ∈ V) : π (s (κ b)) = b :=
    hκinj (hOsub hb.2).1.1 (hOsub hb.1.1).1.1 (hGs (κ b) (hUsub hb.1.2).2)
  refine ⟨fun b ↦ A (κ b), V, hVo, hb₀V,
    fun b hb b' hb' ↦ hainj (hOsub hb.1.1).1.2 (hOsub hb'.1.1).1.2,
    fun b hb ↦ (hOsub hb.1.1).2.2, fun b hb ↦ ?_⟩
  -- At `b`, the point `s (κ b)` lies over `b`, its periods are generated by the `p i (κ b)`, and
  -- the differential of `κ` is invertible.
  obtain ⟨-, -, hstab, hAd, -⟩ := (hUsub hb.1.2).1
  exact h.periodLattice_eq_closure_mvfderiv_comp hσc hκ ⟨s (κ b), hπs b hb⟩
    (IsLocalDiffeomorphAt.mfderivToContinuousLinearEquiv_coe (hOsub hb.1.1).2.1 (by simp)) hstab
    hAd

end TauCeti.SmoothTwoForm.IsNondegenerate.IsLagrangianTorusFibration
