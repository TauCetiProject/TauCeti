module

public import TauCeti.Geometry.Symplectic.Hamiltonian.Complete
public import TauCeti.Geometry.Symplectic.Hamiltonian.Opens
import TauCeti.Topology.ConnectedComponents

/-!
# Complete Hamiltonian flows near a compact component of a level

Let `σ` be a nondegenerate two-form on a finite-dimensional boundaryless manifold `M`, and let
`F : M → (ι → ℝ)` be a smooth family of pairwise Poisson-commuting functions, with the conventions
`ι_{X_f} σ = df` and `{f, g} = σ(X_f, X_g) = df(X_g)`. The Hamiltonian vector fields `X_{Fᵢ}` need
not be complete on `M`. This file shows that they are complete near every compact connected
component `L` of a common level `F⁻¹(c)`: there is an open neighbourhood `W` of `L`, inside any
prescribed open set, such that the Hamiltonian vector fields of the restrictions `Fᵢ|_W` for the
restricted form `σ|_W` are complete
(`TauCeti.SmoothTwoForm.IsNondegenerate.exists_opens_isCompleteVectorField_hamiltonianVectorField`).
No regularity of `F` is needed.

The neighbourhood is built from an open set `V ⊇ L` with compact closure whose frontier does not
meet the level `F⁻¹(c)` (`IsClosed.exists_isOpen_isCompact_closure_disjoint_frontier`). The values
of `F` on the compact frontier of `V` then avoid a neighbourhood `D` of `c`, and
`W = V ∩ F⁻¹(D)`. For each `c' ∈ D`, the points of `closure V` in the level `F⁻¹(c')` all lie in
`V`, so the level `{y ∈ W | F y = c'}` of the restriction is the compact set
`closure V ∩ F⁻¹(c')`. Each `Fⱼ|_W` is a first integral of each `Fᵢ|_W`, because Poisson brackets
are local and the restricted functions still Poisson-commute
(`TauCeti.SmoothTwoForm.IsNondegenerate.poissonBracket_comp_subtype_val_eq_zero`), so a maximal
integral curve of `X_{Fᵢ|_W}` stays in one of these compact levels and is defined for all time.

This is how the global results about the action of `ι → ℝ` generated by complete
Poisson-commuting flows (`TauCeti.SmoothTwoForm.IsSymplectic.hamiltonianFlowAction`) apply to a
compact regular component `L` when the flows are complete only along `L`: they are applied to
the restricted system on `W`.

## References

* V. I. Arnold, *Mathematical Methods of Classical Mechanics*, 2nd ed., Graduate Texts in
  Mathematics 60, Springer, 1989, Section 49.
* J. J. Duistermaat, *On global action-angle coordinates*, Communications on Pure and Applied
  Mathematics 33 (1980), 687–706, Section 1.
-/

public section

open Set TopologicalSpace
open scoped ContDiff Manifold

namespace TauCeti.SmoothTwoForm.IsNondegenerate

variable {E H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [TopologicalSpace M] [ChartedSpace H M]
  [IsManifold I ∞ M] [T2Space M] [BoundarylessManifold I M]
  {σ : SmoothTwoForm I M} (hσ : σ.IsNondegenerate)
  {ι : Type*} [Fintype ι] {F : M → ι → ℝ}

include hσ in
/-- **Poisson-commuting Hamiltonian flows are complete near a compact component of a level.** Let
`F` be a smooth family of pairwise Poisson-commuting functions for a nondegenerate form `σ`, and
let the connected component `L` of `x` in its level `F⁻¹(F x)` be compact. Then every open set
containing `L` contains an open neighbourhood `W` of `L` on which the Hamiltonian vector fields of
the restrictions of the `Fᵢ`, for the restricted form, are complete. -/
theorem exists_opens_isCompleteVectorField_hamiltonianVectorField
    (hF : ContMDiff I 𝓘(ℝ, ι → ℝ) ∞ F)
    (hcomm : ∀ i j x, σ.poissonBracket (F · i) (F · j) x = 0) {x : M}
    (hL : IsCompact (connectedComponentIn (F ⁻¹' {F x}) x)) {U : Set M} (hU : IsOpen U)
    (hLU : connectedComponentIn (F ⁻¹' {F x}) x ⊆ U) :
    ∃ W : Opens M, connectedComponentIn (F ⁻¹' {F x}) x ⊆ W ∧ (W : Set M) ⊆ U ∧
      ∀ i, IsCompleteVectorField (SmoothTwoForm.hamiltonianVectorField
        (SmoothForm.mpullback (Subtype.val : W → M) contMDiff_subtype_val σ)
          fun y : W ↦ F y i) := by
  have hFc : Continuous F := hF.continuous
  have : LocallyCompactSpace M := Manifold.locallyCompact_of_finiteDimensional I
  obtain ⟨V, hV, hLV, hVU, hVc, hVF⟩ := (isClosed_singleton.preimage hFc)
    |>.exists_isOpen_isCompact_closure_disjoint_frontier hL hU hLU
  have hVS : closure V ∩ F ⁻¹' {F x} ⊆ V := fun y hy ↦ by
    by_contra hyV
    exact disjoint_left.1 hVF (hV.frontier_eq ▸ ⟨hy.1, hyV⟩) hy.2
  -- The values of `F` on the compact frontier `closure V \ V` avoid the open set `D`, and every
  -- level of `F` over a value in `D` meets `closure V` only inside `V`.
  set D := (F '' (closure V \ V))ᶜ
  have hD : IsOpen D := ((hVc.diff hV).image hFc).isClosed.isOpen_compl
  have hlevel {c : ι → ℝ} (hc : c ∈ D) : closure V ∩ F ⁻¹' {c} ⊆ V := fun y hy ↦ by
    by_contra hyV
    exact hc ⟨y, ⟨hy.1, hyV⟩, hy.2⟩
  let W : Opens M := ⟨V ∩ F ⁻¹' D, hV.inter (hD.preimage hFc)⟩
  refine ⟨W, fun y hy ↦ ⟨hLV hy, ?_⟩, fun y hy ↦ hVU (subset_closure hy.1), fun i ↦ ?_⟩
  · -- `F y = F x`, and `F x` is not a value of `F` on the frontier of `V`.
    rintro ⟨z, ⟨hzV, hzV'⟩, hz⟩
    exact hzV' (hVS ⟨hzV, hz.trans (connectedComponentIn_subset _ _ hy)⟩)
  have hFW (j : ι) : ContMDiff I 𝓘(ℝ) ∞ (fun y : W ↦ F y j) :=
    contMDiff_pi_module_iff.1 (hF.comp contMDiff_subtype_val) j
  have hσW := hσ.mpullback_subtype_val W
  rw [isCompleteVectorField_iff_maximalIntegralCurveInterval]
  intro y
  refine maximalIntegralCurveInterval_eq_univ_of_isCompact_of_mapsTo
    (hσW.contMDiff_hamiltonianVectorField (n := 1) (by simp) ((hFW i).of_le (by simp)))
    (K := {w : W | F w = F y}) ?_ fun t ht ↦ ?_
  · -- The level of `y` in `W` is the compact set `closure V ∩ F⁻¹(F y)`.
    have hK : ((↑) '' {w : W | F w = F y} : Set M) = closure V ∩ F ⁻¹' {F y} := by
      ext z
      refine ⟨fun ⟨w, hw, hwz⟩ ↦ hwz ▸ ⟨subset_closure w.2.1, hw⟩, fun hz ↦ ?_⟩
      have hzD : F z ∈ D := (hz.2 : F z = F y) ▸ y.2.2
      exact ⟨⟨z, hlevel hzD ⟨hz.1, rfl⟩, hzD⟩, hz.2, rfl⟩
    rw [Subtype.isCompact_iff, hK]
    exact hVc.inter_right (isClosed_singleton.preimage hFc)
  · -- Each `Fⱼ|_W` is a first integral of `Fᵢ|_W`, so it is constant along the curve.
    refine funext fun j ↦ (isFirstIntegral_iff.2 fun z ↦ ?_).apply_maximalIntegralCurve hσW
      ((hFW i).of_le (by simp)) ((hFW j).mdifferentiable (by simp)) ht
    exact hσ.poissonBracket_comp_subtype_val_eq_zero W (hF.mdifferentiable (by simp)) hcomm j i z

end TauCeti.SmoothTwoForm.IsNondegenerate
