/-!
# The period lattice of the spherical pendulum

The energy `H(q, p) = ‖p‖² / 2 + q₃` and the vertical angular momentum `J(q, p) = q₁ p₂ - q₂ p₁` of
the spherical pendulum Poisson-commute and have complete Hamiltonian flows, so they generate an
action of `ℝ²` on the phase space `T*S²` (`TauCeti.sphericalPendulumFlowAction`): the vector
`(s, t)` acts by the time-`s` map of the energy flow after the time-`t` map of the rotation flow,
the flow of `J`. This file determines the stabilizer of this action, the **period lattice**, at
every point of a fibre `F⁻¹(h, j)` of `F = (H, J)` lying strictly above the curve of relative
equilibria (`j ≠ 0` and `h` above the minimum of the effective potential). These are the values
`(h, j)` with `j ≠ 0` whose fibres are nonempty and consist of regular points of `F`.

* **The oscillation of the height.** Along a motion defined at all times, the height `z = q₃`
  stays between the turning points `z₋ < z₊`, and the vertical momentum `p₃` vanishes exactly
  at them. While `p₃ ≠ 0` the height is monotone, so such a passage lasts at most
  `∫_{z₋}^{z₊} dz / √(2 (h - z) (1 - z²) - j²)`, which is finite because `z₋` and `z₊` are
  simple roots of the radicand
  (`TauCeti.intervalIntegrable_inv_sqrt_two_mul_sub_mul_one_sub_sq_sub_sq`). At a turning point
  `p₃' = 3 z² - 2 h z - 1` does not vanish, so `p₃` changes sign there. Hence every motion
  reaches `z₋`
  (`TauCeti.exists_apply_two_eq_sphericalPendulumLowerTurningPoint_of_isMIntegralCurve`), and from
  `z₋` the height rises to `z₊` and falls back to `z₋` in exactly the period `T(h, j)`
  (`TauCeti.exists_mem_Ioo_apply_two_eq_sphericalPendulumUpperTurningPoint_of_isMIntegralCurve`).
* **The first return on the whole fibre.** Combined with the first-return identity
  `TauCeti.apply_add_sphericalPendulumPeriod_eq_apply_sphericalPendulumRotationAngle`, which
  starts at the lower turning point, and the commutation of the two flows, the time-`T(h, j)` map
  of the energy flow agrees with the rotation by the angle `Θ(h, j)` at every point of the fibre.
* **The period lattice.** The rotation flow has period `2π` and fixes a point off the vertical
  axis only at the multiples of `2π`; along the energy flow the pair `(z, p₃)` returns to its
  initial value only at the multiples of `T(h, j)`. So the stabilizer of every point of the fibre
  is the lattice spanned by `(T(h, j), -Θ(h, j))` and `(0, 2π)`
  (`TauCeti.hamiltonianFlowStabilizer_sphericalPendulumEnergyMomentum_eq_closure`).

The second basis vector does not depend on `(h, j)`, while the first one varies with `(h, j)`
through the period and the rotation angle. Continuing the first one around the focus–focus value
`(1, 0)` of `F` along a continuous lift of `Θ`, which decreases by `2π` once around that value
(`TauCeti.sub_eq_neg_two_mul_pi_of_coe_eq_sphericalPendulumRotationAngle`), is the classical
computation of the Hamiltonian monodromy of the pendulum; that transport is not carried out here.

## Main results

* `TauCeti.exists_apply_two_eq_sphericalPendulumLowerTurningPoint_of_isMIntegralCurve`: every
  motion reaches the lower turning point.
* `TauCeti.exists_mem_Ioo_apply_two_eq_sphericalPendulumUpperTurningPoint_of_isMIntegralCurve`:
  one oscillation of the height takes the period `T(h, j)`.
* `TauCeti.sphericalPendulumFlowAction`: the action of `ℝ²` generated by the flows of `H` and `J`.
* `TauCeti.hamiltonianFlowStabilizer_sphericalPendulumEnergyMomentum_eq_closure`: the period
  lattice of a regular fibre with `j ≠ 0` is spanned by `(T(h, j), -Θ(h, j))` and `(0, 2π)`.

## References

* R. H. Cushman and L. M. Bates, *Global Aspects of Classical Integrable Systems*, 2nd ed.,
  Birkhäuser, 2015, Chapter IV (the spherical pendulum, its rotation number and monodromy).
* J. J. Duistermaat, *On global action-angle coordinates*, Comm. Pure Appl. Math. 33 (1980),
  687–706 (the period lattice and the monodromy of the spherical pendulum).
* K. Efstathiou, A. Giacobbe, P. Mardešić and D. Sugny, *Rotation forms and local Hamiltonian
  monodromy*, arXiv:1608.01579, Section III.
-/

public section

open Function Set Filter MeasureTheory Complex
open scoped Topology InnerProductSpace Manifold ContDiff Real

namespace TauCeti

/-! ### The oscillation of the height along a motion -/

section Oscillation

variable {h j z₀ : ℝ} {γ : ℝ → sphericalPendulumPhaseSpace} {t₀ : ℝ}
  (hj : j ≠ 0) (hz₀ : z₀ ∈ Ioo (-1) 1) (hV : sphericalPendulumEffectivePotential j z₀ < h)
  (hγ : IsMIntegralCurve γ (sphericalPendulumSymplecticForm.hamiltonianVectorField
    fun y ↦ sphericalPendulumHamiltonian y))
  (hF : sphericalPendulumEnergyMomentum (γ t₀) = (h, j))

include hγ hF in
/-- A motion defined at all times stays in the fibre `F⁻¹(h, j)` through its value at one time. -/
private theorem energyMomentum_eq (t : ℝ) : sphericalPendulumEnergyMomentum (γ t) = (h, j) :=
  (sphericalPendulumEnergyMomentum_eq_of_isMIntegralCurveOn isPreconnected_univ
    (hγ.isMIntegralCurveOn univ) (mem_univ t₀) (mem_univ t)).trans hF

include hj hz₀ hV hγ hF in
/-- The height of a motion stays between the turning points. -/
private theorem height_mem_Icc (t : ℝ) :
    (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 ∈
      Icc (sphericalPendulumLowerTurningPoint h j) (sphericalPendulumUpperTurningPoint h j) := by
  rw [← image_apply_two_preimage_sphericalPendulumEnergyMomentum_eq_Icc hj hz₀ hV]
  exact ⟨γ t, ⟨(γ t).property, energyMomentum_eq hγ hF t⟩, rfl⟩

include hj hz₀ hV hγ hF in
/-- The vertical momentum of a motion vanishes exactly when its height is a turning point. -/
private theorem momentum_ne_zero_iff (t : ℝ) :
    (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 ≠ 0 ↔
      (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 ∈
        Ioo (sphericalPendulumLowerTurningPoint h j) (sphericalPendulumUpperTurningPoint h j) := by
  have hsq := sq_snd_two_eq_of_mem_sphericalPendulumPhaseSpace (γ t).property
  rw [energyMomentum_eq hγ hF t] at hsq
  refine ⟨fun hp ↦ ?_, fun hz hp ↦ ?_⟩
  · by_contra hz
    have := two_mul_sub_mul_one_sub_sq_sub_sq_nonpos hj hz₀ hV
      ((height_mem_Icc hj hz₀ hV hγ hF t).2.trans
        (sphericalPendulumUpperTurningPoint_lt_one hj hz₀ hV).le) hz
    exact hp (pow_eq_zero_iff two_ne_zero |>.1 (le_antisymm (hsq ▸ this) (sq_nonneg _)))
  · have := two_mul_sub_mul_one_sub_sq_sub_sq_pos hj hz₀ hV hz
    rw [← hsq, hp] at this
    simp at this

include hj hz₀ hV hγ hF in
/-- Where the vertical momentum of a motion vanishes, its height is one of the turning points. -/
private theorem height_eq_or_eq (t : ℝ)
    (hp : (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 = 0) :
    (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
        sphericalPendulumLowerTurningPoint h j ∨
      (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
        sphericalPendulumUpperTurningPoint h j := by
  have hz := height_mem_Icc hj hz₀ hV hγ hF t
  have hnot := mt (momentum_ne_zero_iff hj hz₀ hV hγ hF t).2 (not_not.2 hp)
  rcases hz.1.eq_or_lt with hz₁ | hz₁
  · exact Or.inl hz₁.symm
  · exact Or.inr (le_antisymm hz.2 (not_lt.1 fun hz₂ ↦ hnot ⟨hz₁, hz₂⟩))

include hγ in
/-- Along a motion defined at all times, the height `q₃` moves with velocity `p₃`. -/
private theorem hasDerivAt_height (t : ℝ) :
    HasDerivAt (fun t ↦ (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2)
      ((γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2) t :=
  hasDerivWithinAt_univ.1 <| hasDerivWithinAt_fst_apply_two_of_isMIntegralCurveOn_sphericalPendulum
    (hγ.isMIntegralCurveOn univ) (mem_univ t)

include hγ hF in
/-- Along a motion of energy `h` defined at all times, the vertical momentum `p₃` moves with
velocity `3 q₃² - 2 h q₃ - 1`, half the derivative of the radicand `2 (h - z) (1 - z²) - j²` at the
height `z = q₃`. -/
private theorem hasDerivAt_momentum (t : ℝ) :
    HasDerivAt (fun t ↦ (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2)
      (3 * (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 ^ 2 -
        2 * h * (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 - 1) t := by
  have hH : ‖(γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2‖ ^ 2 / 2 +
      (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 = h := by
    have hE (x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)) :
        (sphericalPendulumEnergyMomentum x).1 = ‖x.2‖ ^ 2 / 2 + x.1 2 := by
      rw [← Prod.mk.eta (p := x), sphericalPendulumEnergyMomentum_apply]
    rw [← hE, energyMomentum_eq hγ hF t]
  refine (hasDerivWithinAt_univ.1 <|
    hasDerivWithinAt_snd_apply_two_of_isMIntegralCurveOn_sphericalPendulum
      (hγ.isMIntegralCurveOn univ) (mem_univ t)).congr_deriv ?_
  linear_combination (-2 * (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2) * hH

include hj hz₀ hV in
/-- The vertical momentum increases at the lower turning point: `3 z₋² - 2 h z₋ - 1 > 0`. -/
private theorem turning_lower_pos :
    0 < 3 * sphericalPendulumLowerTurningPoint h j ^ 2 -
      2 * h * sphericalPendulumLowerTurningPoint h j - 1 := by
  have hfac := two_mul_sub_mul_one_sub_sq_sub_sq_eq hj hz₀ hV
  have hab := sphericalPendulumLowerTurningPoint_lt_sphericalPendulumUpperTurningPoint hj hz₀ hV
  have hb := sphericalPendulumUpperTurningPoint_lt_one hj hz₀ hV
  have hc := one_lt_sub_sphericalPendulumLowerTurningPoint_sub_sphericalPendulumUpperTurningPoint
    hj hz₀ hV
  set a := sphericalPendulumLowerTurningPoint h j
  set b := sphericalPendulumUpperTurningPoint h j
  -- Comparing coefficients in the factorization, `3 z₋² - 2 h z₋ - 1 = (z₊ - z₋) (z₃ - z₋)`.
  have : 3 * a ^ 2 - 2 * h * a - 1 = (b - a) * (h - a - b - a) := by
    linear_combination (hfac 1 - hfac (-1)) / 4
  rw [this]
  exact mul_pos (by linarith) (by linarith)

include hj hz₀ hV in
/-- The vertical momentum decreases at the upper turning point: `3 z₊² - 2 h z₊ - 1 < 0`. -/
private theorem turning_upper_neg :
    3 * sphericalPendulumUpperTurningPoint h j ^ 2 -
      2 * h * sphericalPendulumUpperTurningPoint h j - 1 < 0 := by
  have hfac := two_mul_sub_mul_one_sub_sq_sub_sq_eq hj hz₀ hV
  have hab := sphericalPendulumLowerTurningPoint_lt_sphericalPendulumUpperTurningPoint hj hz₀ hV
  have hb := sphericalPendulumUpperTurningPoint_lt_one hj hz₀ hV
  have hc := one_lt_sub_sphericalPendulumLowerTurningPoint_sub_sphericalPendulumUpperTurningPoint
    hj hz₀ hV
  set a := sphericalPendulumLowerTurningPoint h j
  set b := sphericalPendulumUpperTurningPoint h j
  -- Comparing coefficients in the factorization, `3 z₊² - 2 h z₊ - 1 = -(z₊ - z₋) (z₃ - z₊)`.
  have : 3 * b ^ 2 - 2 * h * b - 1 = -((b - a) * (h - a - b - b)) := by
    linear_combination (hfac 1 - hfac (-1)) / 4
  rw [this, neg_lt_zero]
  exact mul_pos (by linarith) (by linarith)

include hγ in
/-- While the vertical momentum is positive, the height of a motion increases strictly. -/
private theorem strictMonoOn_height {s t : ℝ}
    (hp : ∀ u ∈ Ioo s t, 0 < (γ u : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2) :
    StrictMonoOn (fun t ↦ (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2)
      (Icc s t) :=
  strictMonoOn_of_deriv_pos (convex_Icc s t)
    (fun u _ ↦ (hasDerivAt_height hγ u).continuousAt.continuousWithinAt) fun u hu ↦ by
      rw [interior_Icc] at hu
      rw [(hasDerivAt_height hγ u).deriv]
      exact hp u hu

include hγ in
/-- While the vertical momentum is negative, the height of a motion decreases strictly. -/
private theorem strictAntiOn_height {s t : ℝ}
    (hp : ∀ u ∈ Ioo s t, (γ u : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 < 0) :
    StrictAntiOn (fun t ↦ (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2)
      (Icc s t) :=
  strictAntiOn_of_deriv_neg (convex_Icc s t)
    (fun u _ ↦ (hasDerivAt_height hγ u).continuousAt.continuousWithinAt) fun u hu ↦ by
      rw [interior_Icc] at hu
      rw [(hasDerivAt_height hγ u).deriv]
      exact hp u hu

include hj hz₀ hV hγ hF in
/-- **Passages are short.** During a time interval on which the vertical momentum of a motion does
not vanish, its height runs monotonically between the turning points, so the length of the interval
is at most the half period `∫_{z₋}^{z₊} dz / √(2 (h - z) (1 - z²) - j²)`. -/
private theorem sub_le_integral {s t : ℝ} (hst : s ≤ t)
    (hp : ∀ u ∈ Ioo s t, (γ u : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 ≠ 0) :
    t - s ≤ ∫ z in (sphericalPendulumLowerTurningPoint h j)..
      (sphericalPendulumUpperTurningPoint h j), (√(2 * (h - z) * (1 - z ^ 2) - j ^ 2))⁻¹ := by
  have hab := sphericalPendulumLowerTurningPoint_lt_sphericalPendulumUpperTurningPoint hj hz₀ hV
  have hint := intervalIntegrable_inv_sqrt_two_mul_sub_mul_one_sub_sq_sub_sq hj hz₀ hV
  have hnn : 0 ≤ᵐ[volume.restrict (Ioc (sphericalPendulumLowerTurningPoint h j)
      (sphericalPendulumUpperTurningPoint h j))] fun z ↦ (√(2 * (h - z) * (1 - z ^ 2) - j ^ 2))⁻¹ :=
    ae_of_all _ fun z ↦ inv_nonneg.2 (Real.sqrt_nonneg _)
  have hpos (z₁ z₂ : ℝ) (h₁ : sphericalPendulumLowerTurningPoint h j ≤ z₁)
      (h₂ : z₂ ≤ sphericalPendulumUpperTurningPoint h j) :
      ∀ z ∈ Ioo z₁ z₂, 0 < 2 * (h - z) * (1 - z ^ 2) - j ^ 2 := fun z hz ↦
    two_mul_sub_mul_one_sub_sq_sub_sq_pos hj hz₀ hV ⟨h₁.trans_lt hz.1, hz.2.trans_le h₂⟩
  have hz := height_mem_Icc hj hz₀ hV hγ hF
  have hFs := energyMomentum_eq hγ hF s
  set z := fun t ↦ (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2
  set p := fun t ↦ (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2
  -- The vertical momentum has a constant sign on `(s, t)`.
  have hpc : Continuous p := continuous_iff_continuousAt.2 fun u ↦
    (hasDerivAt_momentum hγ hF u).continuousAt
  have hsign {u w : ℝ} (hu : u ∈ Ioo s t) (hw : w ∈ Ioo s t) :
      SignType.sign (p u) = SignType.sign (p w) :=
    isPreconnected_Ioo.sign_eq_of_continuousOn hpc.continuousOn hp hu hw
  rcases hst.eq_or_lt with rfl | hst'
  · rw [sub_self]
    exact intervalIntegral.integral_nonneg hab.le fun z _ ↦ inv_nonneg.2 (Real.sqrt_nonneg _)
  have hm : (s + t) / 2 ∈ Ioo s t := ⟨by linarith, by linarith⟩
  rcases (hp _ hm).lt_or_gt with hneg | hpos'
  · -- The height decreases from `z s` to `z t`.
    have hanti := strictAntiOn_height hγ fun u hu ↦
      sign_eq_neg_one_iff.1 ((hsign hu hm).trans (sign_eq_neg_one_iff.2 hneg))
    have hst₁ : z t < z s := hanti ⟨le_rfl, hst⟩ ⟨hst, le_rfl⟩ hst'
    rw [sub_eq_integral_inv_sqrt_of_isMIntegralCurveOn_sphericalPendulum hst
      (hγ.isMIntegralCurveOn _) hFs (hpos (z t) (z s) (hz t).1 (hz s).2) (Or.inr ⟨rfl, rfl⟩)
      fun u hu ↦ ⟨hanti (Ioo_subset_Icc_self hu) ⟨hst, le_rfl⟩ hu.2,
        hanti ⟨le_rfl, hst⟩ (Ioo_subset_Icc_self hu) hu.1⟩]
    exact intervalIntegral.integral_mono_interval (hz t).1 hst₁.le (hz s).2 hnn hint
  · -- The height increases from `z s` to `z t`.
    have hmono := strictMonoOn_height hγ fun u hu ↦
      sign_eq_one_iff.1 ((hsign hu hm).trans (sign_eq_one_iff.2 hpos'))
    have hst₁ : z s < z t := hmono ⟨le_rfl, hst⟩ ⟨hst, le_rfl⟩ hst'
    rw [sub_eq_integral_inv_sqrt_of_isMIntegralCurveOn_sphericalPendulum hst
      (hγ.isMIntegralCurveOn _) hFs (hpos (z s) (z t) (hz s).1 (hz t).2) (Or.inl ⟨rfl, rfl⟩)
      fun u hu ↦ ⟨hmono ⟨le_rfl, hst⟩ (Ioo_subset_Icc_self hu) hu.1,
        hmono (Ioo_subset_Icc_self hu) ⟨hst, le_rfl⟩ hu.2⟩]
    exact intervalIntegral.integral_mono_interval (hz s).1 hst₁.le (hz t).2 hnn hint

include hj hz₀ hV hγ hF in
/-- **The next turning time.** If the vertical momentum `p₃` of a motion vanishes at time `t₀` and
`σ p₃` has positive derivative there, then `p₃` vanishes again at a later time `t₁`, and `σ p₃` is
positive in between. -/
private theorem exists_next_turning {σ t₁ : ℝ} (hσ : σ ≠ 0)
    (hp₀ : (γ t₁ : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 = 0)
    (hd : 0 < σ * (3 * (γ t₁ : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 ^ 2 -
      2 * h * (γ t₁ : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 - 1)) :
    ∃ t₂, t₁ < t₂ ∧ (γ t₂ : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 = 0 ∧
      ∀ u ∈ Ioo t₁ t₂, 0 < σ * (γ u : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 := by
  set f := fun t ↦ σ * (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 with hfdef
  have hfd (t : ℝ) := (hasDerivAt_momentum hγ hF t).const_mul σ
  have hfc : Continuous f := continuous_iff_continuousAt.2 fun t ↦ (hfd t).continuousAt
  have hf₀ : f t₁ = 0 := by simp [hfdef, hp₀]
  -- `f` is positive right after `t₁`, since its slopes at `t₁` tend to `f'(t₁) > 0`.
  obtain ⟨u, hu, hfu⟩ : ∃ u ∈ Ioi t₁, ∀ w ∈ Ioo t₁ u, 0 < f w := by
    have hslope := ((hasDerivAt_iff_tendsto_slope.1 (hfd t₁)).mono_left
      (nhdsGT_le_nhdsNE t₁)).eventually (eventually_gt_nhds hd)
    obtain ⟨u, hu, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hslope
    refine ⟨u, hu, fun w hw ↦ ?_⟩
    have : 0 < slope f t₁ w := hsub hw
    rw [slope_def_field, hf₀, sub_zero] at this
    exact (div_pos_iff_of_pos_right (sub_pos.2 hw.1)).1 this
  set c := (t₁ + u) / 2
  have hc₁ : t₁ < c := by simp only [c]; linarith [mem_Ioi.1 hu]
  have hcu : c < u := by simp only [c]; linarith [mem_Ioi.1 hu]
  -- The first time after `c` at which `f ≤ 0` exists, since passages are short.
  set S := {t | c ≤ t ∧ f t ≤ 0}
  have hS : IsClosed S := (isClosed_le continuous_const continuous_id).inter
    (isClosed_le hfc continuous_const)
  have hbdd : BddBelow S := ⟨c, fun _ ht ↦ ht.1⟩
  have hL : 0 ≤ ∫ z in (sphericalPendulumLowerTurningPoint h j)..
      (sphericalPendulumUpperTurningPoint h j), (√(2 * (h - z) * (1 - z ^ 2) - j ^ 2))⁻¹ :=
    intervalIntegral.integral_nonneg
      (sphericalPendulumLowerTurningPoint_lt_sphericalPendulumUpperTurningPoint hj hz₀ hV).le
      fun z _ ↦ inv_nonneg.2 (Real.sqrt_nonneg _)
  have hne : S.Nonempty := by
    by_contra hne
    have hfpos (w : ℝ) (hw : t₁ < w) : 0 < f w := by
      rcases lt_or_ge w u with hwu | hwu
      · exact hfu w ⟨hw, hwu⟩
      · exact not_le.1 fun hfw ↦ hne ⟨w, hcu.le.trans hwu, hfw⟩
    have := sub_le_integral hj hz₀ hV hγ hF (s := t₁)
      (t := t₁ + 1 + ∫ z in (sphericalPendulumLowerTurningPoint h j)..
        (sphericalPendulumUpperTurningPoint h j), (√(2 * (h - z) * (1 - z ^ 2) - j ^ 2))⁻¹)
      (by linarith)
      fun w hw ↦ right_ne_zero_of_mul (hfpos w hw.1).ne'
    linarith
  have ht₂ : sInf S ∈ S := hS.csInf_mem hne hbdd
  have hpos : ∀ w ∈ Ioo t₁ (sInf S), 0 < f w := fun w hw ↦ by
    rcases lt_or_ge w u with hwu | hwu
    · exact hfu w ⟨hw.1, hwu⟩
    · exact not_le.1 fun hfw ↦ notMem_of_lt_csInf hw.2 hbdd ⟨hcu.le.trans hwu, hfw⟩
  have h₁₂ : t₁ < sInf S := hc₁.trans_le ht₂.1
  have hge : 0 ≤ f (sInf S) := ge_of_tendsto ((hfc.tendsto _).mono_left nhdsWithin_le_nhds)
    (eventually_of_mem (Ioo_mem_nhdsLT h₁₂) fun w hw ↦ (hpos w hw).le)
  refine ⟨sInf S, h₁₂, ?_, hpos⟩
  exact (mul_eq_zero.1 (le_antisymm ht₂.2 hge)).resolve_left hσ

include hj hz₀ hV hγ hF in
/-- From the lower turning point the height rises to the upper turning point, with positive
vertical momentum in between. -/
private theorem exists_upper {t₁ : ℝ}
    (h₁ : (γ t₁ : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
      sphericalPendulumLowerTurningPoint h j) :
    ∃ t₂, t₁ < t₂ ∧ (γ t₂ : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
        sphericalPendulumUpperTurningPoint h j ∧
      ∀ u ∈ Ioo t₁ t₂, 0 < (γ u : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 := by
  have hp₁ : (γ t₁ : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 = 0 :=
    not_not.1 fun hp ↦ ((momentum_ne_zero_iff hj hz₀ hV hγ hF t₁).1 hp).1.ne' h₁
  obtain ⟨t₂, h₁₂, hp₂, hpos⟩ := exists_next_turning hj hz₀ hV hγ hF one_ne_zero hp₁
    (by rw [one_mul, h₁]; exact turning_lower_pos hj hz₀ hV)
  simp only [one_mul] at hpos
  refine ⟨t₂, h₁₂, ?_, hpos⟩
  refine (height_eq_or_eq hj hz₀ hV hγ hF t₂ hp₂).resolve_left fun h₂ ↦ ?_
  have := strictMonoOn_height hγ hpos ⟨le_rfl, h₁₂.le⟩ ⟨h₁₂.le, le_rfl⟩ h₁₂
  simp only [h₁, h₂, lt_self_iff_false] at this

include hj hz₀ hV hγ hF in
/-- From the upper turning point the height falls to the lower turning point, with negative
vertical momentum in between. -/
private theorem exists_lower {t₂ : ℝ}
    (h₂ : (γ t₂ : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
      sphericalPendulumUpperTurningPoint h j) :
    ∃ t₃, t₂ < t₃ ∧ (γ t₃ : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
        sphericalPendulumLowerTurningPoint h j ∧
      ∀ u ∈ Ioo t₂ t₃, (γ u : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 < 0 := by
  have hp₂ : (γ t₂ : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 = 0 :=
    not_not.1 fun hp ↦ ((momentum_ne_zero_iff hj hz₀ hV hγ hF t₂).1 hp).2.ne h₂
  obtain ⟨t₃, h₂₃, hp₃, hneg⟩ := exists_next_turning hj hz₀ hV hγ hF (neg_ne_zero.2 one_ne_zero)
    hp₂ (by rw [h₂, neg_one_mul, neg_pos]; exact turning_upper_neg hj hz₀ hV)
  simp only [neg_one_mul, neg_pos] at hneg
  refine ⟨t₃, h₂₃, ?_, hneg⟩
  refine (height_eq_or_eq hj hz₀ hV hγ hF t₃ hp₃).resolve_right fun h₃ ↦ ?_
  have := strictAntiOn_height hγ hneg ⟨le_rfl, h₂₃.le⟩ ⟨h₂₃.le, le_rfl⟩ h₂₃
  simp only [h₂, h₃, lt_self_iff_false] at this

include hj hz₀ hV hγ hF in
/-- **Every motion reaches the lower turning point.** Above the curve of relative equilibria, a
motion of the spherical pendulum defined at all times has a time at which its height is the lower
turning point `z₋`. -/
theorem exists_apply_two_eq_sphericalPendulumLowerTurningPoint_of_isMIntegralCurve :
    ∃ t, (γ t : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
      sphericalPendulumLowerTurningPoint h j := by
  have hL : 0 ≤ ∫ z in (sphericalPendulumLowerTurningPoint h j)..
      (sphericalPendulumUpperTurningPoint h j), (√(2 * (h - z) * (1 - z ^ 2) - j ^ 2))⁻¹ :=
    intervalIntegral.integral_nonneg
      (sphericalPendulumLowerTurningPoint_lt_sphericalPendulumUpperTurningPoint hj hz₀ hV).le
      fun z _ ↦ inv_nonneg.2 (Real.sqrt_nonneg _)
  -- Passages are short, so the vertical momentum vanishes at some time, at a turning point.
  obtain ⟨u, -, hu⟩ : ∃ u ∈ Ioo t₀ (t₀ + 1 + ∫ z in (sphericalPendulumLowerTurningPoint h j)..
      (sphericalPendulumUpperTurningPoint h j), (√(2 * (h - z) * (1 - z ^ 2) - j ^ 2))⁻¹),
      (γ u : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 = 0 := by
    by_contra! hne
    have := sub_le_integral hj hz₀ hV hγ hF (by linarith) hne
    linarith
  rcases height_eq_or_eq hj hz₀ hV hγ hF u hu with hu' | hu'
  · exact ⟨u, hu'⟩
  · obtain ⟨t, -, ht, -⟩ := exists_lower hj hz₀ hV hγ hF hu'
    exact ⟨t, ht⟩

include hj hz₀ hV hγ hF in
/-- **One oscillation of the height.** Above the curve of relative equilibria, let a motion of the
spherical pendulum defined at all times have its height at the lower turning point `z₋` at time
`t₁`. Then the height rises to the upper turning point `z₊` at a time `t₂` with
`t₁ < t₂ < t₁ + T(h, j)`, with positive vertical momentum `p₃` in between, and falls back to `z₋`
at time `t₁ + T(h, j)`, with negative `p₃` in between. -/
theorem exists_mem_Ioo_apply_two_eq_sphericalPendulumUpperTurningPoint_of_isMIntegralCurve
    {t₁ : ℝ} (h₁ : (γ t₁ : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
      sphericalPendulumLowerTurningPoint h j) :
    ∃ t₂ ∈ Ioo t₁ (t₁ + sphericalPendulumPeriod h j),
      (γ t₂ : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
        sphericalPendulumUpperTurningPoint h j ∧
      (γ (t₁ + sphericalPendulumPeriod h j) :
          EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
        sphericalPendulumLowerTurningPoint h j ∧
      (∀ u ∈ Ioo t₁ t₂, 0 < (γ u : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2) ∧
      ∀ u ∈ Ioo t₂ (t₁ + sphericalPendulumPeriod h j),
        (γ u : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 < 0 := by
  obtain ⟨t₂, h₁₂, h₂, hpos⟩ := exists_upper hj hz₀ hV hγ hF h₁
  obtain ⟨t₃, h₂₃, h₃, hneg⟩ := exists_lower hj hz₀ hV hγ hF h₂
  have hT := sub_eq_sphericalPendulumPeriod_of_isMIntegralCurveOn hj hz₀ hV h₁₂.le h₂₃.le
    (hγ.isMIntegralCurveOn _) (energyMomentum_eq hγ hF t₁) h₁ h₂ h₃ fun u hu ↦
      (momentum_ne_zero_iff hj hz₀ hV hγ hF u).1 <| hu.elim (fun hu ↦ (hpos u hu).ne')
        fun hu ↦ (hneg u hu).ne
  obtain rfl : t₃ = t₁ + sphericalPendulumPeriod h j := by linarith
  exact ⟨t₂, ⟨h₁₂, h₂₃⟩, h₂, h₃, hpos, hneg⟩

end Oscillation

/-! ### The flow action and its stabilizers -/

section PeriodLattice

/-- The **flow action of the spherical pendulum**: the action of `ℝ²` on the phase space generated
by the commuting Hamiltonian flows of the energy `H` and of the vertical angular momentum `J`.
The vector `(s, t)` acts by the time-`s` map of the flow of `H` after the time-`t` map of the flow
of `J` (`TauCeti.sphericalPendulumFlowAction_apply`). This is the Hamiltonian flow action of the
energy–momentum map `F = (H, J)`, whose flows are complete because `F` is proper. -/
noncomputable abbrev sphericalPendulumFlowAction :
    (Fin 2 → ℝ) →+ Additive (sphericalPendulumPhaseSpace ≃ₘ^∞⟮𝓘(ℝ, Fin 4 → ℝ), 𝓘(ℝ, Fin 4 → ℝ)⟯
      sphericalPendulumPhaseSpace) :=
  isSymplectic_sphericalPendulumSymplecticForm.hamiltonianFlowAction
    isIntegrableSystem_sphericalPendulumEnergyMomentum.contMDiff
    isIntegrableSystem_sphericalPendulumEnergyMomentum.poissonBracket_eq_zero
    (isIntegrableSystem_sphericalPendulumEnergyMomentum
      |>.isCompleteVectorField_hamiltonianVectorField_of_isProperMap
        isSymplectic_sphericalPendulumSymplecticForm.isNondegenerate
        isProperMap_sphericalPendulumEnergyMomentum)

/-- The vector `(s, t)` acts by the time-`s` map of the energy flow after the time-`t` map of the
rotation flow. -/
theorem sphericalPendulumFlowAction_apply (v : Fin 2 → ℝ) (x : sphericalPendulumPhaseSpace) :
    (sphericalPendulumFlowAction v).toMul x =
      (sphericalPendulumFlowAction (Pi.single 0 (v 0))).toMul
        ((sphericalPendulumFlowAction (Pi.single 1 (v 1))).toMul x) := by
  rw [← isSymplectic_sphericalPendulumSymplecticForm.hamiltonianFlowAction_add_apply]
  congr
  ext i
  fin_cases i <;> simp

/-- The flow action preserves the energy–momentum map. -/
@[simp]
theorem sphericalPendulumEnergyMomentum_sphericalPendulumFlowAction (v : Fin 2 → ℝ)
    (x : sphericalPendulumPhaseSpace) :
    sphericalPendulumEnergyMomentum ((sphericalPendulumFlowAction v).toMul x) =
      sphericalPendulumEnergyMomentum x := by
  have h := isSymplectic_sphericalPendulumSymplecticForm.apply_hamiltonianFlowAction
    isIntegrableSystem_sphericalPendulumEnergyMomentum.contMDiff
    isIntegrableSystem_sphericalPendulumEnergyMomentum.poissonBracket_eq_zero
    (isIntegrableSystem_sphericalPendulumEnergyMomentum
      |>.isCompleteVectorField_hamiltonianVectorField_of_isProperMap
        isSymplectic_sphericalPendulumSymplecticForm.isNondegenerate
        isProperMap_sphericalPendulumEnergyMomentum) v x
  exact Prod.ext (by simpa using congrFun h 0) (by simpa using congrFun h 1)

/-- The first axis of the flow action is the flow of the energy: `t ↦ (t, 0) • x` is a motion of the
pendulum. -/
theorem isMIntegralCurve_sphericalPendulumFlowAction_single_zero (x : sphericalPendulumPhaseSpace) :
    IsMIntegralCurve (fun t ↦ (sphericalPendulumFlowAction (Pi.single 0 t)).toMul x)
      (sphericalPendulumSymplecticForm.hamiltonianVectorField
        fun y ↦ sphericalPendulumHamiltonian y) := by
  have hv := isSymplectic_sphericalPendulumSymplecticForm.isNondegenerate
    |>.contMDiff_hamiltonianVectorField (n := 1) (by simp) ((contMDiff_pi_module_iff.1
      isIntegrableSystem_sphericalPendulumEnergyMomentum.contMDiff 0).of_le (by simp))
  simp only [isSymplectic_sphericalPendulumSymplecticForm.hamiltonianFlowAction_single_apply _ _ _ 0
    _ hv]
  exact isMIntegralCurve_globalFlow hv (isIntegrableSystem_sphericalPendulumEnergyMomentum
    |>.isCompleteVectorField_hamiltonianVectorField_of_isProperMap
      isSymplectic_sphericalPendulumSymplecticForm.isNondegenerate
      isProperMap_sphericalPendulumEnergyMomentum 0) x

/-- The second axis of the flow action is the flow of the vertical angular momentum, the rotation
flow: `t ↦ (0, t) • x` is an integral curve of its Hamiltonian vector field. -/
theorem isMIntegralCurve_sphericalPendulumFlowAction_single_one (x : sphericalPendulumPhaseSpace) :
    IsMIntegralCurve (fun t ↦ (sphericalPendulumFlowAction (Pi.single 1 t)).toMul x)
      (sphericalPendulumSymplecticForm.hamiltonianVectorField fun y ↦
        angularMomentum (EuclideanSpace.single 0 1) (EuclideanSpace.single 1 1)
          (y : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3))) := by
  have hv := isSymplectic_sphericalPendulumSymplecticForm.isNondegenerate
    |>.contMDiff_hamiltonianVectorField (n := 1) (by simp) ((contMDiff_pi_module_iff.1
      isIntegrableSystem_sphericalPendulumEnergyMomentum.contMDiff 1).of_le (by simp))
  simp only [isSymplectic_sphericalPendulumSymplecticForm.hamiltonianFlowAction_single_apply _ _ _ 1
    _ hv]
  exact isMIntegralCurve_globalFlow hv (isIntegrableSystem_sphericalPendulumEnergyMomentum
    |>.isCompleteVectorField_hamiltonianVectorField_of_isProperMap
      isSymplectic_sphericalPendulumSymplecticForm.isNondegenerate
      isProperMap_sphericalPendulumEnergyMomentum 1) x

/-- The vector `0` acts as the identity. -/
private theorem flowAction_single_zero_apply (i : Fin 2) (x : sphericalPendulumPhaseSpace) :
    (sphericalPendulumFlowAction (Pi.single i 0)).toMul x = x := by
  rw [Pi.single_zero]
  exact isSymplectic_sphericalPendulumSymplecticForm.hamiltonianFlowAction_zero_apply _ _ _ x

/-- The rotation flow multiplies the horizontal coordinates `x₁ + x₂ i` of positions and momenta
by `exp (t i)` and fixes their vertical coordinates. -/
private theorem rotation_spec (t : ℝ) (x : sphericalPendulumPhaseSpace) :
    (((((sphericalPendulumFlowAction (Pi.single 1 t)).toMul x :
        EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 0 : ℂ) +
        ((sphericalPendulumFlowAction (Pi.single 1 t)).toMul x :
          EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 1 * I =
      exp ((t : ℂ) * I) * (((x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 0 : ℂ) +
        (x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 1 * I)) ∧
      ((sphericalPendulumFlowAction (Pi.single 1 t)).toMul x :
          EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
        (x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2) ∧
    ((((sphericalPendulumFlowAction (Pi.single 1 t)).toMul x :
        EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 0 : ℂ) +
        ((sphericalPendulumFlowAction (Pi.single 1 t)).toMul x :
          EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 1 * I =
      exp ((t : ℂ) * I) * (((x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 0 : ℂ) +
        (x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 1 * I)) ∧
      ((sphericalPendulumFlowAction (Pi.single 1 t)).toMul x :
          EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 =
        (x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 := by
  have h := horizontal_eq_exp_mul_and_apply_two_eq_of_isMIntegralCurveOn_angularMomentum
    isPreconnected_univ
    ((isMIntegralCurve_sphericalPendulumFlowAction_single_one x).isMIntegralCurveOn univ)
    (mem_univ 0) (mem_univ t)
  beta_reduce at h
  rwa [flowAction_single_zero_apply, sub_zero] at h

/-- The rotation flow fixes the heights and the vertical momenta. -/
private theorem rotation_heightMomentum (t : ℝ) (x : sphericalPendulumPhaseSpace) :
    (((sphericalPendulumFlowAction (Pi.single 1 t)).toMul x :
        EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2,
      ((sphericalPendulumFlowAction (Pi.single 1 t)).toMul x :
        EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2) =
      ((x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2,
        (x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2) :=
  Prod.ext (rotation_spec t x).1.2 (rotation_spec t x).2.2

/-- **The rotation flow has period `2π`.** -/
private theorem rotation_two_pi (x : sphericalPendulumPhaseSpace) :
    (sphericalPendulumFlowAction (Pi.single 1 (2 * π))).toMul x = x := by
  obtain ⟨⟨h₁, h₂⟩, h₃, h₄⟩ := rotation_spec (2 * π) x
  have hexp : exp (((2 * π : ℝ) : ℂ) * I) = 1 := by
    push_cast
    exact exp_two_pi_mul_I
  rw [hexp, one_mul] at h₁ h₃
  refine Subtype.ext (Prod.ext ?_ ?_) <;> ext i <;> fin_cases i
  · simpa using congrArg re h₁
  · simpa using congrArg im h₁
  · exact h₂
  · simpa using congrArg re h₃
  · simpa using congrArg im h₃
  · exact h₄

/-- A point with nonzero vertical angular momentum is off the vertical axis, so the rotation flow
fixes it only at the multiples of `2π`. -/
private theorem exists_eq_mul_two_pi_of_rotation_eq {t : ℝ} {x : sphericalPendulumPhaseSpace}
    (hJ : (sphericalPendulumEnergyMomentum x).2 ≠ 0)
    (hx : (sphericalPendulumFlowAction (Pi.single 1 t)).toMul x = x) :
    ∃ n : ℤ, t = n * (2 * π) := by
  have h := (rotation_spec t x).1.1
  rw [hx] at h
  have hQ : ((x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 0 : ℂ) +
      (x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 1 * I ≠ 0 := by
    intro hQ
    have h₀ := congrArg re hQ
    have h₁ := congrArg im hQ
    simp only [add_re, ofReal_re, mul_re, I_re, mul_zero, ofReal_im, I_im, mul_one, sub_self,
      add_zero, zero_re, add_im, mul_im, zero_add, zero_im] at h₀ h₁
    apply hJ
    rw [← Prod.mk.eta (p := (x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3))),
      sphericalPendulumEnergyMomentum_apply, h₀, h₁]
    ring
  have hexp : exp ((t : ℂ) * I) = 1 := by
    have : (exp ((t : ℂ) * I) - 1) *
        (((x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 0 : ℂ) +
          (x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 1 * I) = 0 := by
      linear_combination -h
    exact sub_eq_zero.1 ((mul_eq_zero.1 this).resolve_right hQ)
  obtain ⟨n, hn⟩ := exp_eq_one_iff.1 hexp
  refine ⟨n, ofReal_injective ?_⟩
  push_cast
  exact mul_right_cancel₀ I_ne_zero (hn.trans (by ring))

/-- **The first return of the spherical pendulum, at every point of a regular fibre.** Above the
curve of relative equilibria, the time-`T(h, j)` map of the energy flow agrees on the fibre
`F⁻¹(h, j)` with the rotation by the angle `Θ(h, j)`. -/
private theorem firstReturn {h j z₀ : ℝ} (hj : j ≠ 0) (hz₀ : z₀ ∈ Ioo (-1) 1)
    (hV : sphericalPendulumEffectivePotential j z₀ < h) {x : sphericalPendulumPhaseSpace}
    (hx : sphericalPendulumEnergyMomentum x = (h, j)) :
    (sphericalPendulumFlowAction (Pi.single 0 (sphericalPendulumPeriod h j))).toMul x =
      (sphericalPendulumFlowAction (Pi.single 1 (sphericalPendulumRotationAngle h j))).toMul x := by
  have hγ := isMIntegralCurve_sphericalPendulumFlowAction_single_zero x
  have hF : sphericalPendulumEnergyMomentum
      ((sphericalPendulumFlowAction (Pi.single 0 0)).toMul x) = (h, j) := by
    rw [flowAction_single_zero_apply, hx]
  obtain ⟨t₁, h₁⟩ :=
    exists_apply_two_eq_sphericalPendulumLowerTurningPoint_of_isMIntegralCurve hj hz₀ hV hγ hF
  obtain ⟨t₂, ⟨h₁₂, h₂₃⟩, h₂, h₃, hpos, hneg⟩ :=
    exists_mem_Ioo_apply_two_eq_sphericalPendulumUpperTurningPoint_of_isMIntegralCurve
      hj hz₀ hV hγ hF h₁
  have hret := apply_add_sphericalPendulumPeriod_eq_apply_sphericalPendulumRotationAngle hj hz₀ hV
    h₁₂.le h₂₃.le (hγ.isMIntegralCurveOn _) (energyMomentum_eq hγ hF t₁) h₁ h₂ h₃
    (fun u hu ↦ (momentum_ne_zero_iff hj hz₀ hV hγ hF u).1 <|
      hu.elim (fun hu ↦ (hpos u hu).ne') fun hu ↦ (hneg u hu).ne)
    ((isMIntegralCurve_sphericalPendulumFlowAction_single_one _).isMIntegralCurveOn _)
    (flowAction_single_zero_apply 1 _)
  -- Both sides are images of the two sides of the claim under the time-`t₁` map of the energy flow.
  have e₁ : (sphericalPendulumFlowAction (Pi.single 0 (t₁ + sphericalPendulumPeriod h j))).toMul x =
      (sphericalPendulumFlowAction (Pi.single 0 t₁)).toMul
        ((sphericalPendulumFlowAction (Pi.single 0 (sphericalPendulumPeriod h j))).toMul x) := by
    rw [Pi.single_add, isSymplectic_sphericalPendulumSymplecticForm.hamiltonianFlowAction_add_apply]
  have e₂ : (sphericalPendulumFlowAction (Pi.single 1 (sphericalPendulumRotationAngle h j))).toMul
        ((sphericalPendulumFlowAction (Pi.single 0 t₁)).toMul x) =
      (sphericalPendulumFlowAction (Pi.single 0 t₁)).toMul
        ((sphericalPendulumFlowAction (Pi.single 1 (sphericalPendulumRotationAngle h j))).toMul
          x) := by
    rw [← isSymplectic_sphericalPendulumSymplecticForm.hamiltonianFlowAction_add_apply,
      ← isSymplectic_sphericalPendulumSymplecticForm.hamiltonianFlowAction_add_apply, add_comm]
  rw [e₁, e₂] at hret
  exact (sphericalPendulumFlowAction (Pi.single 0 t₁)).toMul.injective hret

/-- Along the energy flow through a point of a regular fibre, the height and the vertical momentum
are periodic with period `T(h, j)`: the first return is a rotation, which fixes them. -/
private theorem periodic_heightMomentum {h j z₀ : ℝ} (hj : j ≠ 0) (hz₀ : z₀ ∈ Ioo (-1) 1)
    (hV : sphericalPendulumEffectivePotential j z₀ < h) {x : sphericalPendulumPhaseSpace}
    (hx : sphericalPendulumEnergyMomentum x = (h, j)) :
    Periodic (fun u ↦ (((sphericalPendulumFlowAction (Pi.single 0 u)).toMul x :
        EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2,
      ((sphericalPendulumFlowAction (Pi.single 0 u)).toMul x :
        EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2))
      (sphericalPendulumPeriod h j) := fun u ↦ by
  have hy : sphericalPendulumEnergyMomentum
      ((sphericalPendulumFlowAction (Pi.single 0 u)).toMul x) = (h, j) := by
    rw [sphericalPendulumEnergyMomentum_sphericalPendulumFlowAction, hx]
  dsimp only
  rw [add_comm, Pi.single_add,
    isSymplectic_sphericalPendulumSymplecticForm.hamiltonianFlowAction_add_apply,
    firstReturn hj hz₀ hV hy, rotation_heightMomentum]

/-- Over one oscillation of the height, starting from the lower turning point, the energy flow
through a point of a regular fibre takes no value of the height and the vertical momentum twice:
the height increases while `p₃ > 0` and decreases while `p₃ < 0`. -/
private theorem injOn_heightMomentum {h j z₀ : ℝ} (hj : j ≠ 0) (hz₀ : z₀ ∈ Ioo (-1) 1)
    (hV : sphericalPendulumEffectivePotential j z₀ < h) {x : sphericalPendulumPhaseSpace}
    (hx : sphericalPendulumEnergyMomentum x = (h, j)) {t₁ : ℝ}
    (h₁ : ((sphericalPendulumFlowAction (Pi.single 0 t₁)).toMul x :
      EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
        sphericalPendulumLowerTurningPoint h j) :
    InjOn (fun u ↦ (((sphericalPendulumFlowAction (Pi.single 0 u)).toMul x :
        EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2,
      ((sphericalPendulumFlowAction (Pi.single 0 u)).toMul x :
        EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2))
      (Ico t₁ (t₁ + sphericalPendulumPeriod h j)) := by
  have hγ := isMIntegralCurve_sphericalPendulumFlowAction_single_zero x
  have hF : sphericalPendulumEnergyMomentum
      ((sphericalPendulumFlowAction (Pi.single 0 0)).toMul x) = (h, j) := by
    rw [flowAction_single_zero_apply, hx]
  obtain ⟨t₂, -, -, -, hpos, hneg⟩ :=
    exists_mem_Ioo_apply_two_eq_sphericalPendulumUpperTurningPoint_of_isMIntegralCurve
      hj hz₀ hV hγ hF h₁
  have hp₁ : ((sphericalPendulumFlowAction (Pi.single 0 t₁)).toMul x :
      EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 = 0 :=
    not_not.1 fun hp ↦ ((momentum_ne_zero_iff hj hz₀ hV hγ hF t₁).1 hp).1.ne' h₁
  -- Two times `v < w` of the oscillation give different values.
  have hlt (v w : ℝ) (hv : v ∈ Ico t₁ (t₁ + sphericalPendulumPeriod h j))
      (hw : w ∈ Ico t₁ (t₁ + sphericalPendulumPeriod h j)) (hvw : v < w)
      (hz : ((sphericalPendulumFlowAction (Pi.single 0 v)).toMul x :
        EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2 =
        ((sphericalPendulumFlowAction (Pi.single 0 w)).toMul x :
          EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2)
      (hp : ((sphericalPendulumFlowAction (Pi.single 0 v)).toMul x :
        EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2 =
        ((sphericalPendulumFlowAction (Pi.single 0 w)).toMul x :
          EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2) : False := by
    rcases le_or_gt w t₂ with hw₂ | hw₂
    · exact (strictMonoOn_height hγ hpos ⟨hv.1, (hvw.trans_le hw₂).le⟩ ⟨hv.1.trans hvw.le, hw₂⟩
        hvw).ne hz
    rcases le_or_gt t₂ v with hv₂ | hv₂
    · exact (strictAntiOn_height hγ hneg ⟨hv₂, hvw.le.trans hw.2.le⟩ ⟨hv₂.trans hvw.le, hw.2.le⟩
        hvw).ne' hz
    have hpw := hneg w ⟨hw₂, hw.2⟩
    rcases hv.1.eq_or_lt with rfl | hv₁
    · rw [hp₁] at hp
      exact hpw.ne hp.symm
    · exact lt_asymm (hpos v ⟨hv₁, hv₂⟩) (hp.trans_lt hpw)
  intro v hv w hw hvw
  rcases lt_trichotomy v w with hvw' | rfl | hvw'
  · exact (hlt v w hv hw hvw' (congrArg Prod.fst hvw) (congrArg Prod.snd hvw)).elim
  · rfl
  · exact (hlt w v hw hv hvw' (congrArg Prod.fst hvw).symm (congrArg Prod.snd hvw).symm).elim

/-- Along the energy flow through a point of a regular fibre, the height and the vertical momentum
return to their initial values only at the multiples of the period `T(h, j)`. -/
private theorem exists_eq_mul_period {h j z₀ : ℝ} (hj : j ≠ 0) (hz₀ : z₀ ∈ Ioo (-1) 1)
    (hV : sphericalPendulumEffectivePotential j z₀ < h) {x : sphericalPendulumPhaseSpace}
    (hx : sphericalPendulumEnergyMomentum x = (h, j)) {u : ℝ}
    (hu : (((sphericalPendulumFlowAction (Pi.single 0 u)).toMul x :
        EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2,
      ((sphericalPendulumFlowAction (Pi.single 0 u)).toMul x :
        EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2) =
      ((x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).1 2,
        (x : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3)).2 2)) :
    ∃ m : ℤ, u = m * sphericalPendulumPeriod h j := by
  have hT := sphericalPendulumPeriod_pos hj hz₀ hV
  have hF : sphericalPendulumEnergyMomentum
      ((sphericalPendulumFlowAction (Pi.single 0 0)).toMul x) = (h, j) := by
    rw [flowAction_single_zero_apply, hx]
  obtain ⟨t₁, h₁⟩ := exists_apply_two_eq_sphericalPendulumLowerTurningPoint_of_isMIntegralCurve
    hj hz₀ hV (isMIntegralCurve_sphericalPendulumFlowAction_single_zero x) hF
  -- Reduce both times modulo the period into one oscillation from the lower turning point.
  have hmod (v : ℝ) := (periodic_heightMomentum hj hz₀ hV hx).sub_zsmul_eq (x := v)
    (toIcoDiv hT t₁ v)
  simp only [self_sub_toIcoDiv_zsmul] at hmod
  obtain ⟨n, hn⟩ := (toIcoMod_eq_toIcoMod hT).1 <|
    injOn_heightMomentum hj hz₀ hV hx h₁ (toIcoMod_mem_Ico hT t₁ u) (toIcoMod_mem_Ico hT t₁ 0) <| by
      beta_reduce
      rw [hmod, hmod, hu, flowAction_single_zero_apply]
  exact ⟨-n, by rw [zsmul_eq_mul] at hn; push_cast; linarith⟩

/-- **The period lattice of the spherical pendulum.** Above the curve of relative equilibria, the
stabilizer of every point `x` of the fibre `F⁻¹(h, j)` under the flow action of `F = (H, J)` is
the lattice of `ℝ²` spanned by

* `(T(h, j), -Θ(h, j))`: flowing for the period `T` of the height under the energy flow and then
  rotating back by the rotation angle `Θ` returns every point of the fibre to itself;
* `(0, 2π)`: the rotation flow has period `2π`.

Equivalently, `(s, t)` fixes `x` exactly when `(s, t) = m (T, -Θ) + n (0, 2π)` for integers `m`
and `n` (`AddSubgroup.mem_closure_pair`). -/
theorem hamiltonianFlowStabilizer_sphericalPendulumEnergyMomentum_eq_closure {h j z₀ : ℝ}
    (hj : j ≠ 0) (hz₀ : z₀ ∈ Ioo (-1) 1) (hV : sphericalPendulumEffectivePotential j z₀ < h)
    {x : sphericalPendulumPhaseSpace} (hx : sphericalPendulumEnergyMomentum x = (h, j)) :
    isSymplectic_sphericalPendulumSymplecticForm.hamiltonianFlowStabilizer
        isIntegrableSystem_sphericalPendulumEnergyMomentum.contMDiff
        isIntegrableSystem_sphericalPendulumEnergyMomentum.poissonBracket_eq_zero
        (isIntegrableSystem_sphericalPendulumEnergyMomentum
          |>.isCompleteVectorField_hamiltonianVectorField_of_isProperMap
            isSymplectic_sphericalPendulumSymplecticForm.isNondegenerate
            isProperMap_sphericalPendulumEnergyMomentum) x =
      AddSubgroup.closure
        {![sphericalPendulumPeriod h j, -sphericalPendulumRotationAngle h j], ![0, 2 * π]} := by
  set Λ := isSymplectic_sphericalPendulumSymplecticForm.hamiltonianFlowStabilizer
    isIntegrableSystem_sphericalPendulumEnergyMomentum.contMDiff
    isIntegrableSystem_sphericalPendulumEnergyMomentum.poissonBracket_eq_zero
    (isIntegrableSystem_sphericalPendulumEnergyMomentum
      |>.isCompleteVectorField_hamiltonianVectorField_of_isProperMap
        isSymplectic_sphericalPendulumSymplecticForm.isNondegenerate
        isProperMap_sphericalPendulumEnergyMomentum) x
  have hmem (v : Fin 2 → ℝ) : v ∈ Λ ↔ (sphericalPendulumFlowAction v).toMul x = x :=
    isSymplectic_sphericalPendulumSymplecticForm.mem_hamiltonianFlowStabilizer _ _ _
  have h₁ : ![sphericalPendulumPeriod h j, -sphericalPendulumRotationAngle h j] ∈ Λ := by
    have := (isSymplectic_sphericalPendulumSymplecticForm.hamiltonianFlowAction_apply_eq_iff
      _ _ _).1 (firstReturn hj hz₀ hV hx)
    convert neg_mem this using 1
    ext i
    fin_cases i <;> simp
  have h₂ : ![0, 2 * π] ∈ Λ := by
    rw [hmem, sphericalPendulumFlowAction_apply]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one]
    rw [rotation_two_pi, flowAction_single_zero_apply]
  ext v
  rw [AddSubgroup.mem_closure_pair]
  refine ⟨fun hv ↦ ?_, fun ⟨m, n, hmn⟩ ↦ hmn ▸ add_mem (zsmul_mem h₁ m) (zsmul_mem h₂ n)⟩
  -- The energy component of `v` is a multiple `m T` of the period, since the rotation by `v₁`
  -- fixes the height and the vertical momentum.
  have hy : sphericalPendulumEnergyMomentum
      ((sphericalPendulumFlowAction (Pi.single 1 (v 1))).toMul x) = (h, j) := by
    rw [sphericalPendulumEnergyMomentum_sphericalPendulumFlowAction, hx]
  obtain ⟨m, hm⟩ := exists_eq_mul_period hj hz₀ hV hy (u := v 0) <| by
    have := (hmem v).1 hv
    rw [sphericalPendulumFlowAction_apply] at this
    rw [this]
    exact (rotation_heightMomentum _ _).symm
  -- What remains of `v` after subtracting `m (T, -Θ)` is a rotation fixing `x`, by a multiple of
  -- `2π` since `x` lies off the vertical axis.
  have hw : v - m • ![sphericalPendulumPeriod h j, -sphericalPendulumRotationAngle h j] ∈ Λ :=
    sub_mem hv (zsmul_mem h₁ m)
  have hw' : v - m • ![sphericalPendulumPeriod h j, -sphericalPendulumRotationAngle h j] =
      Pi.single 1 (v 1 + m * sphericalPendulumRotationAngle h j) := by
    ext i
    fin_cases i <;> simp [hm]
  rw [hw', hmem] at hw
  obtain ⟨n, hn⟩ := exists_eq_mul_two_pi_of_rotation_eq (by rw [hx]; exact hj) hw
  refine ⟨m, n, ?_⟩
  ext i
  fin_cases i <;> simp [hm]
  linarith

end PeriodLattice

end TauCeti
