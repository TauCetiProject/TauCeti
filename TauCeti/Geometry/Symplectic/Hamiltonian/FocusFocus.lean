/-!
# The focus-focus block is nondegenerate

Let `(V, ω)` be a four-dimensional real symplectic vector space with Darboux coordinates
`(q₁, p₁, q₂, p₂)`. The **focus-focus block** of Williamson's classification is the pair of
quadratic Hamiltonians

`Q₁ = q₁ p₁ + q₂ p₂`,  `Q₂ = q₁ p₂ - q₂ p₁`.

This file proves that it is a nondegenerate family
(`TauCeti.SymplecticForm.IsDarbouxBasis.isNondegenerateQuadraticFamily_focusFocus`): the
Hamiltonian endomorphisms `A₁ = A_{Q₁}` and `A₂ = A_{Q₂}` span a Cartan subalgebra of `sp(V, ω)`.
In Williamson's classification of nondegenerate rank-zero singularities of integrable systems,
it is the block that occurs besides the elliptic and hyperbolic planes (the two-dimensional case
of `TauCeti.SymplecticForm.isNondegenerateQuadraticFamily_const_iff`). Focus-focus singularities
occur for instance at the upper equilibrium of the spherical pendulum.

The proof only uses the algebraic structure of the pair. The flow of `A₁` is the hyperbolic
scaling `(q, p) ↦ (eᵗ q, e⁻ᵗ p)` and the flow of `A₂` rotates both the `q`- and the `p`-plane, so

`A₁² = 1`,  `A₂² = -1`,  `A₁ A₂ = A₂ A₁`.

Any commuting pair `A₁, A₂ ∈ sp(V, ω)` with these relations, in dimension four, spans a Cartan
subalgebra:

* the commutant of `A₁` and `A₂` in `sp(V, ω)` is the plane they span
  (`TauCeti.SymplecticForm.exists_eq_smul_add_smul_of_commute`). A vector `v₊ + v₋` with
  `A₁ v₊ = v₊` and `A₁ v₋ = -v₋` nonzero is cyclic for the commutative algebra
  `span(1, A₁, A₂, A₁ A₂)`, so an endomorphism commuting with `A₁` and `A₂` lies in this algebra;
  the elements `1` and `A₁ A₂` are `ω`-self-adjoint, so the skew-adjoint part is `span(A₁, A₂)`;
* `A₁ + A₂` is a regular element: its Engel subalgebra is `span(A₁, A₂)`
  (`TauCeti.SymplecticForm.engel_le_lieSpan_pair`). Indeed `ad A₁` and `ad A₂` satisfy the cubics
  `(ad A₁)³ = 4 ad A₁` and `(ad A₂)³ = -4 ad A₂`, which force every element killed by a power of
  `ad (A₁ + A₂)` to commute with `A₁` and `A₂`
  (`LieSubalgebra.lie_eq_zero_and_lie_eq_zero_of_mem_engel_add`).

For quadratic forms this gives `TauCeti.SymplecticForm.isNondegenerateQuadraticFamily_pair`, with
the regular certificate `TauCeti.SymplecticForm.engel_hamiltonianEndEquiv_add_le`: the Engel
subalgebra of `A_{Q₁ + Q₂}` lies in the Lie subalgebra generated by `A_{Q₁}` and `A_{Q₂}`.

## References

* J. Williamson, *On the algebraic problem concerning the normal forms of linear dynamical
  systems*, American Journal of Mathematics 58 (1936), 141–163.
* A. V. Bolsinov and A. T. Fomenko, *Integrable Hamiltonian Systems: Geometry, Topology,
  Classification*, Chapman & Hall/CRC, 2004, Section 1.8.
-/

public section

noncomputable section

open LieSubalgebra Module

-- `sp(V, ω)` is a Lie subalgebra of `Module.End ℝ V` for the commutator bracket, as in Mathlib's
-- `Mathlib.Algebra.Lie.SkewAdjoint`.
attribute [local instance 100] LieRing.ofAssociativeRing

namespace TauCeti.SymplecticForm

variable {V : Type*} [AddCommGroup V] [Module ℝ V] {ω : SymplecticForm V}

/-! ### Commuting square roots of `1` and `-1` in `sp(V, ω)` -/

/-- An element of `sp(V, ω)` squaring to `1` has a nonzero fixed vector. -/
private theorem exists_ne_zero_apply_eq_self [Nontrivial V]
    {A : skewAdjointLieSubalgebra ω.toBilinForm} (hA : (A : Module.End ℝ V) * A = 1) :
    ∃ v ≠ 0, (A : Module.End ℝ V) v = v := by
  by_contra! h
  -- Every `u + A u` is fixed by `A`, so it vanishes: `A = -1`, which is not skew-adjoint.
  have hfix : ∀ u, u + (A : Module.End ℝ V) u = 0 := fun u ↦ by
    by_contra hne
    refine h _ hne ?_
    rw [map_add, ← mul_apply_eq_comp, hA, one_apply_eq_self, add_comm]
  have hA' : (A : Module.End ℝ V) = (-1 : ℝ) • 1 := LinearMap.ext fun u ↦ by
    rw [LinearMap.smul_apply, one_apply_eq_self, neg_one_smul]
    exact eq_neg_of_add_eq_zero_right (hfix u)
  have := eq_zero_of_smul_one_mem (ω := ω) (hA' ▸ A.2)
  norm_num at this

/-- If `A₁, A₂ ∈ sp(V, ω)` commute with `A₁² = 1` and `A₂² = -1`, some vector `v` makes
`v, A₁ v, A₂ v, A₁ A₂ v` linearly independent. -/
private theorem exists_linearIndependent_of_commute [Nontrivial V]
    {A₁ A₂ : skewAdjointLieSubalgebra ω.toBilinForm} (h₁ : (A₁ : Module.End ℝ V) * A₁ = 1)
    (h₂ : (A₂ : Module.End ℝ V) * A₂ = -1) (h₁₂ : Commute (A₁ : Module.End ℝ V) A₂) :
    ∃ v, LinearIndependent ℝ ![v, (A₁ : Module.End ℝ V) v, (A₂ : Module.End ℝ V) v,
      (A₁ : Module.End ℝ V) ((A₂ : Module.End ℝ V) v)] := by
  obtain ⟨vp, hvp, hp⟩ := exists_ne_zero_apply_eq_self h₁
  obtain ⟨vm, hvm, hm⟩ := exists_ne_zero_apply_eq_self (A := -A₁) (by
    rw [NegMemClass.coe_neg, neg_mul_neg, h₁])
  rw [NegMemClass.coe_neg, LinearMap.neg_apply, neg_eq_iff_eq_neg] at hm
  set a₁ : Module.End ℝ V := (A₁ : Module.End ℝ V)
  set a₂ : Module.End ℝ V := (A₂ : Module.End ℝ V)
  have comm : ∀ u, a₁ (a₂ u) = a₂ (a₁ u) := fun u ↦ by
    rw [← mul_apply_eq_comp, h₁₂.eq, mul_apply_eq_comp]
  have hp₂ : a₁ (a₂ vp) = a₂ vp := by rw [comm, hp]
  have hm₂ : a₁ (a₂ vm) = -a₂ vm := by rw [comm, hm, map_neg]
  refine ⟨vp + vm, Fintype.linearIndependent_iff.2 fun g hg ↦ ?_⟩
  simp only [Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons, map_add, hp, hm, hp₂, hm₂] at hg
  -- Split `hg` into its `A₁`-fixed and `A₁`-negated components.
  have e₁ : (g 0 + g 1) • vp + (g 2 + g 3) • a₂ vp + ((g 0 - g 1) • vm + (g 2 - g 3) • a₂ vm) =
      0 := by
    linear_combination (norm := module) hg
  have e₂ := congrArg a₁ e₁
  simp only [map_add, map_smul, hp, hm, hp₂, hm₂, map_zero] at e₂
  have ep : (g 0 + g 1) • vp + (g 2 + g 3) • a₂ vp = 0 := by
    have : (2 : ℝ) • ((g 0 + g 1) • vp + (g 2 + g 3) • a₂ vp) = 0 := by
      linear_combination (norm := module) e₁ + e₂
    exact (smul_eq_zero.1 this).resolve_left two_ne_zero
  have em : (g 0 - g 1) • vm + (g 2 - g 3) • a₂ vm = 0 := by
    have : (2 : ℝ) • ((g 0 - g 1) • vm + (g 2 - g 3) • a₂ vm) = 0 := by
      linear_combination (norm := module) e₁ - e₂
    exact (smul_eq_zero.1 this).resolve_left two_ne_zero
  -- `A₂` is a complex structure, so `(v, A₂ v)` is linearly independent for `v ≠ 0`.
  let J : AlmostComplexStructure V := ⟨a₂, by rw [← Module.End.mul_eq_comp, h₂]; rfl⟩
  obtain ⟨hp₀, hp₁⟩ := LinearIndependent.pair_iff.1 (J.linearIndependent_pair hvp) _ _ ep
  obtain ⟨hm₀, hm₁⟩ := LinearIndependent.pair_iff.1 (J.linearIndependent_pair hvm) _ _ em
  intro i
  fin_cases i <;> simp <;> linarith

/-- **The commutant of a focus-focus pair.** In a four-dimensional symplectic vector space, let
`A₁, A₂ ∈ sp(V, ω)` commute, with `A₁² = 1` and `A₂² = -1`. Then every element of `sp(V, ω)`
commuting with `A₁` and `A₂` is a linear combination of `A₁` and `A₂`. -/
theorem exists_eq_smul_add_smul_of_commute (hV : finrank ℝ V = 4)
    {A₁ A₂ B : skewAdjointLieSubalgebra ω.toBilinForm} (h₁ : (A₁ : Module.End ℝ V) * A₁ = 1)
    (h₂ : (A₂ : Module.End ℝ V) * A₂ = -1) (h₁₂ : Commute (A₁ : Module.End ℝ V) A₂)
    (hB₁ : Commute (A₁ : Module.End ℝ V) B) (hB₂ : Commute (A₂ : Module.End ℝ V) B) :
    ∃ s t : ℝ, B = s • A₁ + t • A₂ := by
  have : Nontrivial V := Module.nontrivial_of_finrank_pos (R := ℝ) (by omega)
  obtain ⟨v, hli⟩ := exists_linearIndependent_of_commute h₁ h₂ h₁₂
  set a₁ : Module.End ℝ V := (A₁ : Module.End ℝ V)
  set a₂ : Module.End ℝ V := (A₂ : Module.End ℝ V)
  set β : Module.End ℝ V := (B : Module.End ℝ V)
  let b := basisOfLinearIndependentOfCardEqFinrank hli (by simp [hV])
  -- Write `B v = c₀ v + c₁ A₁ v + c₂ A₂ v + c₃ A₁ A₂ v`.
  set c := b.repr (β v)
  let C : Module.End ℝ V := c 0 • 1 + c 1 • a₁ + c 2 • a₂ + c 3 • (a₁ * a₂)
  have hC₁ : Commute a₁ C :=
    ((((Commute.one_right _).smul_right _).add_right ((Commute.refl _).smul_right _)).add_right
      (h₁₂.smul_right _)).add_right (((Commute.refl _).mul_right h₁₂).smul_right _)
  have hC₂ : Commute a₂ C :=
    ((((Commute.one_right _).smul_right _).add_right (h₁₂.symm.smul_right _)).add_right
      ((Commute.refl _).smul_right _)).add_right
      ((h₁₂.symm.mul_right (Commute.refl _)).smul_right _)
  have hv : β v = C v := by
    have := b.sum_repr (β v)
    simp only [Fin.sum_univ_four, b, coe_basisOfLinearIndependentOfCardEqFinrank,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
      Matrix.head_cons, Matrix.tail_cons] at this
    rw [← this]
    simp [C, c, b, mul_apply_eq_comp]
  -- Two endomorphisms commuting with `A₁` and `A₂` that agree on `v` agree on the basis.
  have hBC : β = C := by
    have key : ∀ X : Module.End ℝ V, Commute X β → Commute X C → β (X v) = C (X v) := by
      intro X hXβ hXC
      rw [← mul_apply_eq_comp, ← hXβ.eq, mul_apply_eq_comp, hv, ← mul_apply_eq_comp, hXC.eq,
        mul_apply_eq_comp]
    refine b.ext fun i ↦ ?_
    fin_cases i
    · simpa [b] using hv
    · simpa [b] using key a₁ hB₁ hC₁
    · simpa [b] using key a₂ hB₂ hC₂
    · simpa [b, mul_apply_eq_comp] using key (a₁ * a₂) (hB₁.mul_left hB₂) (hC₁.mul_left hC₂)
  -- `D = B - c₁ A₁ - c₂ A₂ = c₀ + c₃ A₁ A₂` is both skew-adjoint and self-adjoint, hence zero.
  set D : skewAdjointLieSubalgebra ω.toBilinForm := B - c 1 • A₁ - c 2 • A₂ with hD_def
  have hD : (D : Module.End ℝ V) = c 0 • 1 + c 3 • (a₁ * a₂) := by
    have hBC' : (B : Module.End ℝ V) = C := hBC
    rw [hD_def, AddSubgroupClass.coe_sub, AddSubgroupClass.coe_sub, SetLike.val_smul,
      SetLike.val_smul, hBC']
    simp only [C, a₁, a₂]
    abel
  have hDsymm : ∀ u w, ω.toBilinForm ((D : Module.End ℝ V) u) w =
      ω.toBilinForm u ((D : Module.End ℝ V) w) := by
    intro u w
    have k₁ : ω.toBilinForm (a₁ (a₂ u)) w = -ω.toBilinForm (a₂ u) (a₁ w) :=
      skewAdjointLieSubalgebra.apply_left A₁ _ _
    have k₂ : ω.toBilinForm (a₂ u) (a₁ w) = -ω.toBilinForm u (a₂ (a₁ w)) :=
      skewAdjointLieSubalgebra.apply_left A₂ _ _
    have k₃ : a₂ (a₁ w) = a₁ (a₂ w) := by
      rw [← mul_apply_eq_comp, ← h₁₂.eq, mul_apply_eq_comp]
    simp only [hD, LinearMap.add_apply, LinearMap.smul_apply, one_apply_eq_self,
      mul_apply_eq_comp, map_add, map_smul, smul_eq_mul]
    rw [k₁, k₂, k₃, neg_neg]
  have hD0 : D = 0 := by
    refine Subtype.ext (LinearMap.ext fun u ↦ ω.nondegenerate.1 _ fun w ↦ ?_)
    linarith [skewAdjointLieSubalgebra.apply_left D u w, hDsymm u w]
  refine ⟨c 1, c 2, ?_⟩
  rw [← sub_eq_zero, ← sub_sub, ← hD_def, hD0]

/-- **A regular element of a focus-focus pair.** In a four-dimensional symplectic vector space, let
`A₁, A₂ ∈ sp(V, ω)` commute, with `A₁² = 1` and `A₂² = -1`. Then the Engel subalgebra of
`A₁ + A₂` is contained in the Lie subalgebra generated by `A₁` and `A₂`, which is the plane they
span. In particular this plane is a Cartan subalgebra of `sp(V, ω)`. -/
theorem engel_le_lieSpan_pair (hV : finrank ℝ V = 4)
    {A₁ A₂ : skewAdjointLieSubalgebra ω.toBilinForm} (h₁ : (A₁ : Module.End ℝ V) * A₁ = 1)
    (h₂ : (A₂ : Module.End ℝ V) * A₂ = -1) (h₁₂ : Commute (A₁ : Module.End ℝ V) A₂) :
    engel ℝ (A₁ + A₂) ≤ lieSpan ℝ (skewAdjointLieSubalgebra ω.toBilinForm) {A₁, A₂} := by
  intro B hB
  obtain ⟨hB₁, hB₂⟩ :=
    lie_eq_zero_and_lie_eq_zero_of_mem_engel_add h₁ h₂ (commute_coe_iff.1 h₁₂) hB
  obtain ⟨s, t, rfl⟩ := exists_eq_smul_add_smul_of_commute hV h₁ h₂ h₁₂ (commute_coe_iff.2 hB₁)
    (commute_coe_iff.2 hB₂)
  exact add_mem (SMulMemClass.smul_mem s (subset_lieSpan (by simp)))
    (SMulMemClass.smul_mem t (subset_lieSpan (by simp)))

/-! ### Quadratic forms -/

variable [FiniteDimensional ℝ V]

/-- **The regular certificate of a focus-focus pair of quadratic forms.** On a four-dimensional
symplectic vector space, let `Q₁`, `Q₂` be Poisson-commuting quadratic forms whose Hamiltonian
endomorphisms satisfy `A_{Q₁}² = 1` and `A_{Q₂}² = -1`. Then the Engel subalgebra of
`A_{Q₁ + Q₂}` is contained in the Lie subalgebra generated by `A_{Q₁}` and `A_{Q₂}`. -/
theorem engel_hamiltonianEndEquiv_add_le (hV : finrank ℝ V = 4) {Q₁ Q₂ : QuadraticForm ℝ V}
    (h₁ : ω.hamiltonianEnd Q₁ * ω.hamiltonianEnd Q₁ = 1)
    (h₂ : ω.hamiltonianEnd Q₂ * ω.hamiltonianEnd Q₂ = -1)
    (h₁₂ : ω.quadraticPoissonBracket Q₁ Q₂ = 0) :
    engel ℝ (ω.hamiltonianEndEquiv (Q₁ + Q₂)) ≤
      lieSpan ℝ (skewAdjointLieSubalgebra ω.toBilinForm)
        (Set.range fun i ↦ ω.hamiltonianEndEquiv (![Q₁, Q₂] i)) := by
  rw [map_add]
  refine (engel_le_lieSpan_pair hV (by simpa using h₁) (by simpa using h₂)
    (by simpa using (quadraticPoissonBracket_eq_zero_iff ω).1 h₁₂)).trans (lieSpan_mono ?_)
  rintro _ (rfl | rfl)
  exacts [⟨0, rfl⟩, ⟨1, rfl⟩]

/-- **A focus-focus pair of quadratic forms is nondegenerate.** On a four-dimensional symplectic
vector space, let `Q₁`, `Q₂` be Poisson-commuting quadratic forms whose Hamiltonian endomorphisms
satisfy `A_{Q₁}² = 1` and `A_{Q₂}² = -1`. Then `A_{Q₁}` and `A_{Q₂}` span a Cartan subalgebra
of `sp(V, ω)`. -/
theorem isNondegenerateQuadraticFamily_pair (hV : finrank ℝ V = 4) {Q₁ Q₂ : QuadraticForm ℝ V}
    (h₁ : ω.hamiltonianEnd Q₁ * ω.hamiltonianEnd Q₁ = 1)
    (h₂ : ω.hamiltonianEnd Q₂ * ω.hamiltonianEnd Q₂ = -1)
    (h₁₂ : ω.quadraticPoissonBracket Q₁ Q₂ = 0) :
    ω.IsNondegenerateQuadraticFamily ![Q₁, Q₂] := by
  have hc := (quadraticPoissonBracket_eq_zero_iff ω).1 h₁₂
  refine isNondegenerateQuadraticFamily_of_engel_le (fun i j ↦ ?_) (Q₁ + Q₂)
    (engel_hamiltonianEndEquiv_add_le hV h₁ h₂ h₁₂)
  fin_cases i <;> fin_cases j <;> simp only [Fin.zero_eta, Fin.mk_one, Matrix.cons_val_zero,
    Matrix.cons_val_one, ω.quadraticPoissonBracket_eq_zero_iff]
  exacts [Commute.refl _, hc, hc.symm, Commute.refl _]

/-! ### The focus-focus block in Darboux coordinates -/

/-- The Hamiltonian endomorphism of `Q` sends `u` to `z` as soon as `ω z` and `polar Q u` agree
on a basis. -/
private theorem hamiltonianEnd_apply_eq_of_basis {ι : Type*} (b : Basis ι ℝ V)
    {Q : QuadraticForm ℝ V} {u z : V}
    (h : ∀ c, ω z (b c) = QuadraticMap.polar Q u (b c)) : ω.hamiltonianEnd Q u = z := by
  have hzero : ω.toBilinForm (ω.hamiltonianEnd Q u - z) = 0 := b.ext fun c ↦ by
    rw [map_sub, LinearMap.sub_apply, LinearMap.zero_apply, sub_eq_zero]
    exact (ω.apply_hamiltonianEnd Q u (b c)).trans (h c).symm
  exact sub_eq_zero.1 (ω.nondegenerate.1 _ fun w ↦ by rw [hzero, LinearMap.zero_apply])

variable {b : Basis (Fin 2 × Fin 2) ℝ V}

/-- In a Darboux basis `(q₁, p₁, q₂, p₂)`, the Hamiltonian endomorphism of `q₁ p₁ + q₂ p₂` fixes
the `qᵢ` and negates the `pᵢ`. -/
private theorem IsDarbouxBasis.hamiltonianEnd_focusFocus_fst (hb : ω.IsDarbouxBasis b)
    (a : Fin 2 × Fin 2) :
    ω.hamiltonianEnd (QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (0, 1)) +
      QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (1, 1))) (b a) =
        if a.2 = 0 then b a else -b a := by
  refine hamiltonianEnd_apply_eq_of_basis b fun c ↦ ?_
  obtain ⟨i, j⟩ := a
  obtain ⟨k, l⟩ := c
  have h₁ := hb.apply_fst_fst
  have h₂ := hb.apply_snd_snd
  have h₃ := hb.apply_fst_snd
  have h₄ := hb.apply_snd_fst
  fin_cases i <;> fin_cases j <;> fin_cases k <;> fin_cases l <;>
    simp [QuadraticMap.polar, h₁, h₂, h₃, h₄]

/-- In a Darboux basis `(q₁, p₁, q₂, p₂)`, the Hamiltonian endomorphism of `q₁ p₂ - q₂ p₁` sends
`q₁ ↦ q₂ ↦ -q₁` and `p₁ ↦ p₂ ↦ -p₁`. -/
private theorem IsDarbouxBasis.hamiltonianEnd_focusFocus_snd (hb : ω.IsDarbouxBasis b)
    (a : Fin 2 × Fin 2) :
    ω.hamiltonianEnd (QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (1, 1)) -
      QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (0, 1))) (b a) =
        if a.1 = 0 then b (1, a.2) else -b (0, a.2) := by
  refine hamiltonianEnd_apply_eq_of_basis b fun c ↦ ?_
  obtain ⟨i, j⟩ := a
  obtain ⟨k, l⟩ := c
  have h₁ := hb.apply_fst_fst
  have h₂ := hb.apply_snd_snd
  have h₃ := hb.apply_fst_snd
  have h₄ := hb.apply_snd_fst
  fin_cases i <;> fin_cases j <;> fin_cases k <;> fin_cases l <;>
    simp [QuadraticMap.polar, h₁, h₂, h₃, h₄]

/-- In a Darboux basis, the Hamiltonian endomorphisms of the focus-focus pair satisfy
`A₁² = 1`, `A₂² = -1` and commute. -/
private theorem IsDarbouxBasis.focusFocus_relations (hb : ω.IsDarbouxBasis b) :
    ω.hamiltonianEnd (QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (0, 1)) +
        QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (1, 1))) *
      ω.hamiltonianEnd (QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (0, 1)) +
        QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (1, 1))) = 1 ∧
    ω.hamiltonianEnd (QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (1, 1)) -
        QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (0, 1))) *
      ω.hamiltonianEnd (QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (1, 1)) -
        QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (0, 1))) = -1 ∧
    ω.quadraticPoissonBracket
      (QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (0, 1)) +
        QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (1, 1)))
      (QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (1, 1)) -
        QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (0, 1))) = 0 := by
  have e₁ := hb.hamiltonianEnd_focusFocus_fst
  have e₂ := hb.hamiltonianEnd_focusFocus_snd
  refine ⟨b.ext fun a ↦ ?_, b.ext fun a ↦ ?_, (quadraticPoissonBracket_eq_zero_iff ω).2 ?_⟩
  · obtain ⟨i, j⟩ := a
    fin_cases i <;> fin_cases j <;> simp [mul_apply_eq_comp, e₁, -map_add]
  · obtain ⟨i, j⟩ := a
    fin_cases i <;> fin_cases j <;> simp [mul_apply_eq_comp, e₂, -map_sub]
  · refine b.ext fun a ↦ ?_
    obtain ⟨i, j⟩ := a
    fin_cases i <;> fin_cases j <;> simp [mul_apply_eq_comp, e₁, e₂, -map_add, -map_sub]

/-- **The focus-focus block is nondegenerate.** In a Darboux basis `(q₁, p₁, q₂, p₂)` of a
four-dimensional symplectic vector space, the quadratic forms `q₁ p₁ + q₂ p₂` and `q₁ p₂ - q₂ p₁`
form a nondegenerate family: their Hamiltonian endomorphisms span a Cartan subalgebra of
`sp(V, ω)`. -/
theorem IsDarbouxBasis.isNondegenerateQuadraticFamily_focusFocus (hb : ω.IsDarbouxBasis b) :
    ω.IsNondegenerateQuadraticFamily
      ![QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (0, 1)) +
          QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (1, 1)),
        QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (1, 1)) -
          QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (0, 1))] := by
  obtain ⟨h₁, h₂, h₁₂⟩ := hb.focusFocus_relations
  exact isNondegenerateQuadraticFamily_pair (by simp [finrank_eq_card_basis b]) h₁ h₂ h₁₂

/-- **The regular certificate of the focus-focus block.** In a Darboux basis `(q₁, p₁, q₂, p₂)`,
with `Q₁ = q₁ p₁ + q₂ p₂` and `Q₂ = q₁ p₂ - q₂ p₁`, the Engel subalgebra of `A_{Q₁ + Q₂}` is
contained in the Lie subalgebra generated by `A_{Q₁}` and `A_{Q₂}`. -/
theorem IsDarbouxBasis.engel_hamiltonianEndEquiv_focusFocus_le (hb : ω.IsDarbouxBasis b) :
    engel ℝ (ω.hamiltonianEndEquiv
      ((QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (0, 1)) +
          QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (1, 1))) +
        (QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (1, 1)) -
          QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (0, 1))))) ≤
      lieSpan ℝ (skewAdjointLieSubalgebra ω.toBilinForm)
        (Set.range fun i ↦ ω.hamiltonianEndEquiv
          (![QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (0, 1)) +
              QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (1, 1)),
            QuadraticMap.linMulLin (b.coord (0, 0)) (b.coord (1, 1)) -
              QuadraticMap.linMulLin (b.coord (1, 0)) (b.coord (0, 1))] i)) := by
  obtain ⟨h₁, h₂, h₁₂⟩ := hb.focusFocus_relations
  exact engel_hamiltonianEndEquiv_add_le (by simp [finrank_eq_card_basis b]) h₁ h₂ h₁₂

end TauCeti.SymplecticForm
