/-!
# Hamiltonian flows are symplectic, and Poisson-commuting flows commute

Let `σ` be a smooth two-form on a finite-dimensional boundaryless manifold `M`, with the
conventions `ι_{X_f} σ = df` and `{f, g} = σ(X_f, X_g) = df(X_g)`.

If `σ` is closed, the flow `ψ` of a complete `C²` vector field `X` with closed contraction
`ι_X σ` preserves it, `ψₜ^* σ = σ`, because Cartan's formula gives `L_X σ = d(ι_X σ) = 0`
(`TauCeti.SmoothTwoForm.mpullback_globalFlow_of_mextDeriv_interior_eq_zero`). In particular
Hamiltonian flows are symplectic, since `d(ι_{X_f} σ) = d(df) = 0`
(`TauCeti.SmoothTwoForm.IsHamiltonianVectorField.mpullback_globalFlow`).

For a nondegenerate `σ`, a smooth map `φ` with surjective differentials that pulls `σ` back to
itself and preserves a function `g` carries Hamiltonian vector fields of `g` to themselves, hence
commutes with the flow of `g`
(`TauCeti.SmoothTwoForm.IsNondegenerate.apply_globalFlow_hamiltonianVectorField`). Applied to the
flow of a function `f` with `{g, f} = 0`, which is symplectic and preserves `g`, this shows that
**the Hamiltonian flows of Poisson-commuting smooth functions commute**
(`TauCeti.SmoothTwoForm.IsSymplectic.commute_globalFlowDiffeomorph`).

Consequently a finite family `F : M → (ι → ℝ)` of pairwise Poisson-commuting smooth functions with
complete Hamiltonian vector fields generates an action of the vector group `ι → ℝ` on `M` by
symplectic diffeomorphisms (`TauCeti.SmoothTwoForm.IsSymplectic.hamiltonianAction`): the vector
`v` acts by the composite of the time-`vᵢ` maps of the flows of the `Fᵢ`, in any order. It
restricts to the flow of `Fᵢ` on the `i`-th coordinate axis, preserves `σ` and preserves every
`Fᵢ`, and it is the unique such homomorphism with these restrictions
(`TauCeti.SmoothTwoForm.IsSymplectic.eq_hamiltonianAction`). For a completely integrable system
`F` (`TauCeti.SmoothTwoForm.IsIntegrableSystem`) that is a proper map, the completeness hypothesis
holds (`IsIntegrableSystem.isCompleteVectorField_hamiltonianVectorField_of_isProperMap`), and this
is the action of `ℝⁿ` on the fibres of `F` from which the Liouville–Arnold theorem
identifies a compact connected regular fibre with a torus.

## Main results

* `TauCeti.SmoothTwoForm.mpullback_globalFlow_of_mextDeriv_interior_eq_zero`: for closed `σ`,
  `ψₜ^* σ = σ` for the flow of a complete vector field with closed contraction.
* `TauCeti.SmoothTwoForm.IsHamiltonianVectorField.mpullback_globalFlow`: the case of a
  Hamiltonian vector field.
* `TauCeti.SmoothTwoForm.IsNondegenerate.apply_globalFlow_hamiltonianVectorField`: symplectic maps
  preserving `g` commute with the flow of `g`.
* `TauCeti.SmoothTwoForm.IsSymplectic.commute_globalFlowDiffeomorph`: if `{g, f} = 0`, the flows
  of `f` and `g` commute.
* `TauCeti.SmoothTwoForm.IsSymplectic.hamiltonianAction`: the action of `ι → ℝ` generated by
  pairwise Poisson-commuting Hamiltonian flows, with
  `TauCeti.SmoothTwoForm.IsSymplectic.hamiltonianAction_single`,
  `TauCeti.SmoothTwoForm.IsSymplectic.eq_hamiltonianAction`,
  `TauCeti.SmoothTwoForm.IsSymplectic.mpullback_hamiltonianAction` and
  `TauCeti.SmoothTwoForm.IsSymplectic.apply_hamiltonianAction`.

## References

* V. I. Arnold, *Mathematical Methods of Classical Mechanics*, 2nd ed., Graduate Texts in
  Mathematics 60, Springer, 1989, Chapter 8 (Hamiltonian flows preserve the symplectic structure)
  and Section 49 (the action of commuting flows in the Liouville–Arnold theorem).
* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Section 18 (Hamiltonian vector fields and integrable systems).
-/

public section

noncomputable section

open Function
open scoped ContDiff Manifold

namespace TauCeti

namespace SmoothTwoForm

variable {E H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [TopologicalSpace M] [ChartedSpace H M]
  [IsManifold I ∞ M] [T2Space M] [BoundarylessManifold I M]
  {σ : SmoothTwoForm I M} {f g : M → ℝ} {X : (x : M) → TangentSpace I x}


/-! ### Symplectic maps commute with Hamiltonian flows -/

/-- **Symplectic maps preserving a function commute with its Hamiltonian flow.** Let `σ` be
nondegenerate and let `φ` be a smooth map with surjective differentials such that `φ^* σ = σ` and
`g ∘ φ = g`. Then `φ` carries the Hamiltonian vector field of `g` to itself, and so commutes with
the flow of a complete Hamiltonian vector field of `g`. -/
theorem IsNondegenerate.apply_globalFlow_hamiltonianVectorField (h : σ.IsNondegenerate)
    {φ : M → M} (hφ : ContMDiff I I ∞ φ) (hφσ : SmoothForm.mpullback φ hφ σ = σ)
    (hφd : ∀ x, Surjective (mfderiv I I φ x)) (hg : MDifferentiable I 𝓘(ℝ) g) (hgφ : g ∘ φ = g)
    (hv : ContMDiff I I.tangent 1
      (fun y ↦ (⟨y, σ.hamiltonianVectorField g y⟩ : TangentBundle I M)))
    (hc : IsCompleteVectorField (σ.hamiltonianVectorField g)) (t : ℝ) (x : M) :
    φ (globalFlow _ hv hc t x) = globalFlow _ hv hc t (φ x) := by
  -- `t ↦ φ (ψₜ x)` is an integral curve of `X_g`, because `dφ (X_g) = X_{g ∘ φ} ∘ φ = X_g ∘ φ`.
  have hγ : IsMIntegralCurve (fun t ↦ φ (globalFlow _ hv hc t x))
      (σ.hamiltonianVectorField g) := fun s ↦ by
    set y := globalFlow _ hv hc s x
    have hX := h.mfderiv_hamiltonianVectorField_comp h hφ hφσ (hφd y) (hg (φ y))
    rw [hgφ] at hX
    have hcomp :
        (mfderiv I I φ y).comp ((1 : ℝ →L[ℝ] ℝ).smulRight (σ.hamiltonianVectorField g y)) =
          (1 : ℝ →L[ℝ] ℝ).smulRight (σ.hamiltonianVectorField g (φ y)) :=
      ContinuousLinearMap.ext fun _ ↦ by simp [hX]
    exact (((hφ y).mdifferentiableAt (by simp)).hasMFDerivAt.comp s
      (isMIntegralCurve_globalFlow hv hc x s)).congr_mfderiv hcomp
  simpa only [Flow.map_zero_apply] using (globalFlow_eq_of_isMIntegralCurve hv hc hγ t).symm

/-! ### Hamiltonian flows are symplectic -/

variable [I.Boundaryless]

/-- **Flows of symplectic vector fields are symplectic.** For a closed two-form `σ`, the flow `ψ`
of a complete `C²` vector field `X` whose contraction `ι_X σ` is closed satisfies `ψₜ^* σ = σ` for
every time `t`. No nondegeneracy is needed. -/
theorem mpullback_globalFlow_of_mextDeriv_interior_eq_zero (hσ : σ.IsClosed)
    (hX : mextDeriv (RoughForm.interior X σ.1) = 0) (hc : IsCompleteVectorField X)
    (hv : ContMDiff I I.tangent 2 (fun y ↦ (⟨y, X y⟩ : TangentBundle I M))) (t : ℝ) :
    mpullback I I (globalFlow X (hv.of_le one_le_two) hc t) σ.1 = σ.1 := by
  -- Cartan's formula: `L_X σ = d(ι_X σ) = 0`.
  have hL : mlieDerivForm X σ.1 = (0 : ℝ) • σ.1 := by
    rw [zero_smul, SmoothForm.mlieDerivForm_eq_mextDeriv_interior
      (hv.mdifferentiable two_ne_zero) hσ, hX]
  simpa only [zero_mul, Real.exp_zero, one_smul] using
    mpullback_globalFlow_eq_exp_smul hc hv σ.mdifferentiable hL t

/-- **Hamiltonian flows are symplectic.** For a closed two-form `σ`, the flow `ψ` of a complete
`C²` Hamiltonian vector field of a `C²` function satisfies `ψₜ^* σ = σ` for every time `t`, since
`ι_X σ = df` is closed. No nondegeneracy is needed. -/
theorem IsHamiltonianVectorField.mpullback_globalFlow (hX : σ.IsHamiltonianVectorField f X)
    (hσ : σ.IsClosed) (hf : ContMDiff I 𝓘(ℝ) 2 f) (hc : IsCompleteVectorField X)
    (hv : ContMDiff I I.tangent 2 (fun y ↦ (⟨y, X y⟩ : TangentBundle I M))) (t : ℝ) :
    TauCeti.mpullback I I (globalFlow X (hv.of_le one_le_two) hc t) σ.1 = σ.1 :=
  mpullback_globalFlow_of_mextDeriv_interior_eq_zero hσ
    (by rw [isHamiltonianVectorField_iff_interior_eq.1 hX, mextDeriv_mextDeriv_ofFunction hf]) hc
    hv t

/-! ### Poisson-commuting Hamiltonian flows commute -/

namespace IsSymplectic

variable (hσ : σ.IsSymplectic)
include hσ

/-- **The time-`t` maps of a Hamiltonian flow are symplectic diffeomorphisms.** For a symplectic
form `σ` and a smooth function `f` with complete Hamiltonian vector field, every time-`t` map
`ψₜ` of its flow satisfies `ψₜ^* σ = σ`. -/
theorem mpullback_globalFlowDiffeomorph (hf : ContMDiff I 𝓘(ℝ) ∞ f)
    (hc : IsCompleteVectorField (σ.hamiltonianVectorField f))
    (hv : ContMDiff I I.tangent (⊤ : ℕ∞)
      (fun y ↦ (⟨y, σ.hamiltonianVectorField f y⟩ : TangentBundle I M))) (t : ℝ) :
    SmoothForm.mpullback (globalFlowDiffeomorph hc le_top hv t)
      (globalFlowDiffeomorph hc le_top hv t).contMDiff σ = σ := by
  refine Subtype.ext ?_
  rw [SmoothForm.coe_mpullback]
  convert
    (hσ.isNondegenerate.isHamiltonianVectorField_hamiltonianVectorField f).mpullback_globalFlow
      hσ.isClosed (hf.of_le (by simp)) hc (hv.of_le (by simp)) t using 3
  ext x
  rw [globalFlowDiffeomorph_apply]

/-- **Poisson-commuting Hamiltonian flows commute.** For a symplectic form `σ` and smooth functions
`f` and `g` with complete Hamiltonian vector fields, if `g` is a first integral of `f`,
`{g, f} = 0`, then the time-`s` map of the flow of `f` commutes with the time-`t` map of the flow
of `g`. -/
theorem commute_globalFlowDiffeomorph (hf : ContMDiff I 𝓘(ℝ) ∞ f) (hg : ContMDiff I 𝓘(ℝ) ∞ g)
    (hfg : σ.IsFirstIntegral f g) (hcf : IsCompleteVectorField (σ.hamiltonianVectorField f))
    (hcg : IsCompleteVectorField (σ.hamiltonianVectorField g))
    (hvf : ContMDiff I I.tangent (⊤ : ℕ∞)
      (fun y ↦ (⟨y, σ.hamiltonianVectorField f y⟩ : TangentBundle I M)))
    (hvg : ContMDiff I I.tangent (⊤ : ℕ∞)
      (fun y ↦ (⟨y, σ.hamiltonianVectorField g y⟩ : TangentBundle I M))) (s t : ℝ) :
    Commute (globalFlowDiffeomorph hcf le_top hvf s) (globalFlowDiffeomorph hcg le_top hvg t) := by
  set ψ := globalFlowDiffeomorph hcf le_top hvf s
  -- The flow of `f` preserves `g`, which is a first integral of `f`.
  have hgψ : g ∘ ψ = g := funext fun x ↦ by
    rw [comp_apply, globalFlowDiffeomorph_apply, globalFlow_apply]
    exact hfg.apply_maximalIntegralCurve hσ.isNondegenerate (hf.of_le (by simp))
      (hg.mdifferentiable (by simp)) (hcf.mem_maximalIntegralCurveInterval x s)
  refine Diffeomorph.ext fun x ↦ ?_
  rw [Diffeomorph.mul_apply, Diffeomorph.mul_apply, globalFlowDiffeomorph_apply hcg le_top hvg t,
    globalFlowDiffeomorph_apply hcg le_top hvg t]
  exact hσ.isNondegenerate.apply_globalFlow_hamiltonianVectorField ψ.contMDiff
    (hσ.mpullback_globalFlowDiffeomorph hf hcf hvf s)
    (fun y ↦ (ψ.isInvertible_mfderiv (x := y) (by simp)).surjective)
    (hg.mdifferentiable (by simp)) hgψ _ hcg t x

/-! ### The action generated by Poisson-commuting Hamiltonian flows -/

variable {ι : Type*} [Fintype ι] {F : M → ι → ℝ} (hF : ContMDiff I 𝓘(ℝ, ι → ℝ) ∞ F)
  (hcomm : ∀ i j x, σ.poissonBracket (F · i) (F · j) x = 0)
  (hc : ∀ i, IsCompleteVectorField (σ.hamiltonianVectorField (F · i)))

omit [I.Boundaryless] [T2Space M] [BoundarylessManifold I M] in
include hF in
/-- The Hamiltonian vector fields of the components of a smooth family of functions are smooth. -/
private theorem contMDiff_hamiltonianVectorField_apply (i : ι) :
    ContMDiff I I.tangent (⊤ : ℕ∞)
      (fun y ↦ (⟨y, σ.hamiltonianVectorField (F · i) y⟩ : TangentBundle I M)) :=
  hσ.isNondegenerate.contMDiff_hamiltonianVectorField le_rfl
    (by simpa using contMDiff_pi_module_iff.1 hF i)

include hF hcomm hc in
/-- **The action of `ι → ℝ` generated by Poisson-commuting Hamiltonian flows.** Let `σ` be
symplectic and let `F : M → (ι → ℝ)` be a smooth finite family of pairwise Poisson-commuting
functions whose Hamiltonian vector fields are complete. Their flows pairwise commute, so `v : ι → ℝ`
acts on `M` by the composite, in any order, of the time-`vᵢ` maps of the flows of the `Fᵢ`. This
is a homomorphism to the group of smooth self-diffeomorphisms of `M`, written additively as for
`AddAction.toPermHom`: `v + w` acts as `v` after `w`. -/
def hamiltonianAction : (ι → ℝ) →+ Additive (M ≃ₘ^∞⟮I, I⟯ M) :=
  AddMonoidHom.noncommPiCoprod
    (fun i ↦ globalFlowDiffeomorphHom (hc i) le_top
      (contMDiff_hamiltonianVectorField_apply hσ hF i))
    fun i j _ s t ↦ (addCommute_iff_eq _ _).2 <| Additive.toMul.injective <| by
      simpa only [toMul_add, toMul_globalFlowDiffeomorphHom] using
        (hσ.commute_globalFlowDiffeomorph (contMDiff_pi_module_iff.1 hF i)
          (contMDiff_pi_module_iff.1 hF j) (isFirstIntegral_iff.2 fun x ↦ hcomm j i x) (hc i)
          (hc j) (contMDiff_hamiltonianVectorField_apply hσ hF i)
          (contMDiff_hamiltonianVectorField_apply hσ hF j) s t).eq

/-- **The Hamiltonian action restricts to the flows on the coordinate axes.** The vector `t eᵢ`
acts by the time-`t` map of the flow of `Fᵢ`. -/
theorem hamiltonianAction_single [DecidableEq ι] (i : ι) (t : ℝ)
    (hv : ContMDiff I I.tangent (⊤ : ℕ∞)
      (fun y ↦ (⟨y, σ.hamiltonianVectorField (F · i) y⟩ : TangentBundle I M))) :
    hσ.hamiltonianAction hF hcomm hc (Pi.single i t) =
      globalFlowDiffeomorphHom (hc i) le_top hv t :=
  AddMonoidHom.noncommPiCoprod_single (N := fun _ ↦ ℝ) _ i t

/-- The vector `t eᵢ` moves each point along the flow of `Fᵢ` for time `t`. -/
theorem hamiltonianAction_single_apply [DecidableEq ι] (i : ι) (t : ℝ)
    (hv : ContMDiff I I.tangent 1
      (fun y ↦ (⟨y, σ.hamiltonianVectorField (F · i) y⟩ : TangentBundle I M))) (x : M) :
    (hσ.hamiltonianAction hF hcomm hc (Pi.single i t)).toMul x =
      globalFlow (σ.hamiltonianVectorField (F · i)) hv (hc i) t x := by
  rw [hσ.hamiltonianAction_single hF hcomm hc i t (contMDiff_hamiltonianVectorField_apply hσ hF i),
    toMul_globalFlowDiffeomorphHom, globalFlowDiffeomorph_apply]

/-- **Uniqueness of the Hamiltonian action.** A homomorphism from `ι → ℝ` to the smooth
self-diffeomorphisms of `M` that sends each vector `t eᵢ` to the time-`t` map of the flow of `Fᵢ`
is the Hamiltonian action. -/
theorem eq_hamiltonianAction [DecidableEq ι] (Φ : (ι → ℝ) →+ Additive (M ≃ₘ^∞⟮I, I⟯ M))
    (hv : ∀ i, ContMDiff I I.tangent (⊤ : ℕ∞)
      (fun y ↦ (⟨y, σ.hamiltonianVectorField (F · i) y⟩ : TangentBundle I M)))
    (hΦ : ∀ i t, Φ (Pi.single i t) = globalFlowDiffeomorphHom (hc i) le_top (hv i) t) :
    Φ = hσ.hamiltonianAction hF hcomm hc := by
  -- Both are determined by their restrictions to the coordinate axes.
  refine (AddMonoidHom.noncommPiCoprodEquiv (N := fun _ ↦ ℝ)).symm.injective
    (Subtype.ext (funext fun i ↦ AddMonoidHom.ext fun t ↦ ?_))
  simp only [AddMonoidHom.noncommPiCoprodEquiv, Equiv.coe_fn_symm_mk, AddMonoidHom.coe_comp,
    comp_apply, AddMonoidHom.single_apply, hΦ, hσ.hamiltonianAction_single hF hcomm hc i t (hv i)]

/-- Every element of the range of the Hamiltonian action has a property `P` of
self-diffeomorphisms that is preserved by the identity and by composition and that every time-`t`
map of the flow of every `Fᵢ` has. -/
private theorem hamiltonianAction_mem (P : (M ≃ₘ^∞⟮I, I⟯ M) → Prop) (hP₁ : P 1)
    (hPmul : ∀ a b, P a → P b → P (a * b))
    (hPflow : ∀ i t, P (globalFlowDiffeomorph (hc i) le_top
      (contMDiff_hamiltonianVectorField_apply hσ hF i) t)) (v : ι → ℝ) :
    P (hσ.hamiltonianAction hF hcomm hc v).toMul := by
  let S : AddSubmonoid (Additive (M ≃ₘ^∞⟮I, I⟯ M)) :=
    { carrier := {a | P a.toMul}
      add_mem' := fun ha hb ↦ hPmul _ _ ha hb
      zero_mem' := hP₁ }
  -- The range of `noncommPiCoprod` is generated by the ranges of the flows.
  have hle : AddMonoidHom.mrange (hσ.hamiltonianAction hF hcomm hc) ≤ S :=
    (AddMonoidHom.noncommPiCoprod_mrange (N := fun _ ↦ ℝ) _).trans_le <| iSup_le fun i ↦ by
      rintro _ ⟨t, rfl⟩
      have h := hPflow i t
      rw [← toMul_globalFlowDiffeomorphHom] at h
      exact h
  exact hle ⟨v, rfl⟩

/-- **The Hamiltonian action is symplectic.** Every element of `ι → ℝ` acts by a diffeomorphism
`φ` with `φ^* σ = σ`. -/
theorem mpullback_hamiltonianAction (v : ι → ℝ) :
    SmoothForm.mpullback (hσ.hamiltonianAction hF hcomm hc v).toMul
      (hσ.hamiltonianAction hF hcomm hc v).toMul.contMDiff σ = σ := by
  refine hσ.hamiltonianAction_mem hF hcomm hc
    (fun a ↦ SmoothForm.mpullback a a.contMDiff σ = σ) ?_ (fun a b ha hb ↦ ?_)
    (fun i t ↦ hσ.mpullback_globalFlowDiffeomorph (contMDiff_pi_module_iff.1 hF i) (hc i) _ t) v
  · simp only [Diffeomorph.coe_one, SmoothForm.mpullback_id, LinearMap.id_apply]
  · simp only [Diffeomorph.coe_mul, SmoothForm.mpullback_comp _ _ b.contMDiff a.contMDiff,
      LinearMap.comp_apply, ha, hb]

/-- **The Hamiltonian action preserves the integrals.** Every element of `ι → ℝ` moves each point
within its common level set of the functions `Fᵢ`. -/
theorem apply_hamiltonianAction (v : ι → ℝ) (x : M) :
    F ((hσ.hamiltonianAction hF hcomm hc v).toMul x) = F x := by
  refine congrFun (hσ.hamiltonianAction_mem hF hcomm hc (fun a ↦ F ∘ a = F) rfl
    (fun a b ha hb ↦ ?_) (fun i t ↦ funext fun y ↦ funext fun j ↦ ?_) v) x
  · rw [Diffeomorph.coe_mul, ← comp_assoc, ha, hb]
  · rw [comp_apply, globalFlowDiffeomorph_apply, globalFlow_apply]
    exact (isFirstIntegral_iff.2 fun x ↦ hcomm j i x).apply_maximalIntegralCurve
      hσ.isNondegenerate ((contMDiff_pi_module_iff.1 hF i).of_le (by simp))
      ((contMDiff_pi_module_iff.1 hF j).mdifferentiable (by simp))
      ((hc i).mem_maximalIntegralCurveInterval y t)

end IsSymplectic

end SmoothTwoForm

end TauCeti
