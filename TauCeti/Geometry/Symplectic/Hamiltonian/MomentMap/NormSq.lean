/-!
# The norm square of a moment map

Let `μ : M → 𝔤*` be a moment map of an infinitesimal action `Z ↦ Z_M` of a finite-dimensional
real Lie algebra on a manifold with a two-form `σ`, so that `dμ^Z = ι_{Z_M} σ` for every
component `μ^Z = ⟨μ, Z⟩`. Fix a linear map `K : 𝔤* → 𝔤` that is symmetric,
`⟨ν, K ν'⟩ = ⟨ν', K ν⟩`, such as the inverse of `X ↦ B X` for an inner product, or any
nondegenerate symmetric form, `B` on `𝔤` (`LinearMap.BilinForm.IsSymm.apply_toDual_symm_comm`).
The **norm square** of `μ` is the function

`f = ‖μ‖² : x ↦ ⟨μ x, K (μ x)⟩`

(`TauCeti.momentNormSq μ K`), which is `B(β x, β x)` for `β x = K (μ x)`, the point of `𝔤`
corresponding to `μ x` (`TauCeti.momentNormSq_toDual_symm`). Kirwan's Morse theory of `f` is the
source of the norm-square stratification of a Hamiltonian space, and this file computes its first
variation.

Differentiating `⟨μ, K μ⟩` and using the symmetry of `K`, the differential of `f` at `x` is twice
the differential of the component of `μ` along the frozen element `β x`:

`df_x = 2 dμ^{β x}_x = 2 σ((β x)_M x, ·)`

(`TauCeti.SmoothTwoForm.IsMomentMap.mvfderiv_momentNormSq`,
`TauCeti.SmoothTwoForm.IsMomentMap.mvfderiv_momentNormSq_apply`). Consequently:

* `x` is a critical point of `f` exactly when it is a critical point of `μ^{β x}`, with no
  nondegeneracy assumption, so the critical set of `f` is the union over `ν ∈ 𝔤*` of the parts
  `μ⁻¹(ν) ∩ Crit(μ^{K ν})`
  (`TauCeti.SmoothTwoForm.IsMomentMap.criticalPoints_momentNormSq_eq_iUnion`);
* where `σ` is nondegenerate, `x` is a critical point of `f` exactly when the vector field
  generated by `β x` vanishes at `x`, `(β x)_M x = 0`
  (`TauCeti.SmoothTwoForm.IsMomentMap.mem_criticalPoints_momentNormSq_iff`,
  `TauCeti.SmoothTwoForm.IsMomentMap.criticalPoints_momentNormSq_eq`);
* for a smooth action of a Lie group with `σ` nondegenerate, the critical set of `f` is the union
  over `ν` of `μ⁻¹(ν) ∩ M^{T_{K ν}}`, where `M^{T_ξ}` is the fixed-point set of the closure of the
  one-parameter subgroup generated by `ξ`
  (`TauCeti.SmoothTwoForm.IsMomentMap.criticalPoints_momentNormSq_eq_iUnion_fixedPoints`).
  These are Kirwan's critical sets `Z_β ∩ μ⁻¹(β)`;
* for a Riemannian metric and a field of endomorphisms `J` with `⟪J u, v⟫ = σ(u, v)`, as for the
  metric `σ(·, J ·)` of an almost complex structure `J` compatible with `σ`, the gradient of `f`
  is `2 J (β x)_M x` (`TauCeti.SmoothTwoForm.IsMomentMap.mgradient_momentNormSq`). This is the
  vector field whose negative flow drives the norm-square stratification.

The norm square is smooth (`TauCeti.SmoothTwoForm.IsMomentMap.contMDiff_momentNormSq`). For a
representation `ρ` of a group on `𝔤`, a `ρ.dual`-equivariant `μ` and a `K` intertwining `ρ.dual`
with `ρ`, as the inverse of a nondegenerate `ρ`-invariant form does
(`TauCeti.Representation.IsInvariantForm.toDual_symm_dual_apply`), `f` is invariant under the
group (`TauCeti.momentNormSq_smul`). For the adjoint representation, whose dual is the coadjoint
representation, this covers a coadjoint-equivariant `μ` and an `Ad`-invariant inner product.

## Main definitions

* `TauCeti.momentNormSq μ K`: the norm square `x ↦ ⟨μ x, K (μ x)⟩`.

## Main results

* `TauCeti.SmoothTwoForm.IsMomentMap.mvfderiv_momentNormSq`: `d‖μ‖²_x = 2 dμ^{K (μ x)}_x`.
* `TauCeti.SmoothTwoForm.IsMomentMap.criticalPoints_momentNormSq_eq_iUnion`: the critical set of
  `‖μ‖²` is `⋃ ν, μ⁻¹(ν) ∩ Crit(μ^{K ν})`.
* `TauCeti.SmoothTwoForm.IsMomentMap.mem_criticalPoints_momentNormSq_iff`: for a nondegenerate
  `σ`, `x` is critical for `‖μ‖²` exactly when `(K (μ x))_M x = 0`.
* `TauCeti.SmoothTwoForm.IsMomentMap.criticalPoints_momentNormSq_eq_iUnion_fixedPoints`: for a
  group action, the critical set of `‖μ‖²` is `⋃ ν, μ⁻¹(ν) ∩ M^{T_{K ν}}`.
* `TauCeti.SmoothTwoForm.IsMomentMap.mgradient_momentNormSq`: the gradient of `‖μ‖²` is
  `2 J (K (μ x))_M x`.
* `TauCeti.momentNormSq_smul`: `‖μ‖²` is invariant under the group.

## References

* F. C. Kirwan, *Cohomology of Quotients in Symplectic and Algebraic Geometry*, Mathematical
  Notes 31, Princeton University Press, 1984 (the critical points of `‖μ‖²`).
* E. Lerman, *Gradient flow of the norm squared of a moment map*, L'Enseignement
  Mathématique 51 (2005), 117–127.
-/

public section

open Bundle
open scoped ContDiff Manifold

namespace TauCeti

section Defs

variable {M 𝔤 : Type*} [AddCommGroup 𝔤] [Module ℝ 𝔤]

/-- The **norm square** `x ↦ ⟨μ x, K (μ x)⟩` of a map `μ : M → 𝔤*`, for a linear map
`K : 𝔤* → 𝔤`. When `K` is the inverse of `X ↦ B X` for a symmetric nondegenerate form `B` on `𝔤`,
such as an `Ad`-invariant inner product, this is `B(K (μ x), K (μ x))`, the square of the length
of `μ x` (`TauCeti.momentNormSq_toDual_symm`). -/
def momentNormSq (μ : M → Module.Dual ℝ 𝔤) (K : Module.Dual ℝ 𝔤 →ₗ[ℝ] 𝔤) (x : M) : ℝ :=
  μ x (K (μ x))

@[simp]
theorem momentNormSq_apply (μ : M → Module.Dual ℝ 𝔤) (K : Module.Dual ℝ 𝔤 →ₗ[ℝ] 𝔤) (x : M) :
    momentNormSq μ K x = μ x (K (μ x)) :=
  (rfl)

/-- Expanding `ν` in the dual basis of a finite basis `b` of `𝔤`:
`Σ i, ⟨ν, b i⟩ ⟨D, K (b.coord i)⟩ = ⟨D, K ν⟩`. -/
private theorem sum_apply_mul_apply_coord {ι : Type*} [Fintype ι] (b : Module.Basis ι ℝ 𝔤)
    (K : Module.Dual ℝ 𝔤 →ₗ[ℝ] 𝔤) (ν D : Module.Dual ℝ 𝔤) :
    ∑ i, ν (b i) * D (K (b.coord i)) = D (K ν) := by
  conv_rhs => rw [← b.sum_dual_apply_smul_coord ν]
  simp only [map_sum, map_smul, smul_eq_mul]

/-- Expanding `μ x` in the dual basis of a finite basis `b` of `𝔤` writes the norm square as
`Σ i, ⟨μ x, b i⟩ ⟨μ x, K (b.coord i)⟩`, a sum of products of components of `μ`. -/
private theorem momentNormSq_eq_sum {ι : Type*} [Fintype ι] (b : Module.Basis ι ℝ 𝔤)
    (μ : M → Module.Dual ℝ 𝔤) (K : Module.Dual ℝ 𝔤 →ₗ[ℝ] 𝔤) :
    momentNormSq μ K = fun x ↦ ∑ i, μ x (b i) * μ x (K (b.coord i)) :=
  funext fun x ↦ (sum_apply_mul_apply_coord b K (μ x) (μ x)).symm

end Defs

/-- The norm square for the inverse of a nondegenerate form `B` is `B(β x, β x)`, where
`β x = K (μ x)` is the point of `𝔤` corresponding to `μ x`. -/
theorem momentNormSq_toDual_symm {M 𝔤 : Type*} [AddCommGroup 𝔤] [Module ℝ 𝔤]
    [FiniteDimensional ℝ 𝔤] {B : LinearMap.BilinForm ℝ 𝔤} (hB : B.Nondegenerate)
    (μ : M → Module.Dual ℝ 𝔤) (x : M) :
    momentNormSq μ (B.toDual hB).symm x =
      B ((B.toDual hB).symm (μ x)) ((B.toDual hB).symm (μ x)) := by
  simp

namespace SmoothTwoForm.IsMomentMap

section Infinitesimal

variable {E H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  {𝔤 : Type*} [LieRing 𝔤] [LieAlgebra ℝ 𝔤] [FiniteDimensional ℝ 𝔤]
  {σ : SmoothTwoForm I M} {a : InfinitesimalAction 𝔤 I M} {μ : M → Module.Dual ℝ 𝔤}
  {K : Module.Dual ℝ 𝔤 →ₗ[ℝ] 𝔤}

/-- The norm square of a moment map is smooth. -/
theorem contMDiff_momentNormSq (h : σ.IsMomentMap a μ) :
    ContMDiff I 𝓘(ℝ) ∞ (momentNormSq μ K) := by
  let b := Module.finBasis ℝ 𝔤
  rw [momentNormSq_eq_sum b μ K]
  exact contMDiff_finsetSum fun i _ ↦ (h.contMDiff (b i)).mul (h.contMDiff (K (b.coord i)))

/-- **The differential of the norm square of a moment map.** For a symmetric `K`, the
differential of `‖μ‖² = ⟨μ, K μ⟩` at `x` is twice the differential of the component `μ^{β x}` of
`μ` along the frozen element `β x = K (μ x)`. -/
theorem mvfderiv_momentNormSq (h : σ.IsMomentMap a μ)
    (hK : ∀ ν ν' : Module.Dual ℝ 𝔤, ν (K ν') = ν' (K ν)) (x : M) :
    mvfderiv I (momentNormSq μ K) x = (2 : ℝ) • mvfderiv I (fun y ↦ μ y (K (μ x))) x := by
  let b := Module.finBasis ℝ 𝔤
  ext v
  -- Expand `‖μ‖²` as `Σ i, μ^{b i} μ^{K (b.coord i)}` and differentiate each product.
  rw [momentNormSq_eq_sum b μ K, mvfderiv_fun_sum (f := fun i y ↦ μ y (b i) * μ y (K (b.coord i)))
      fun i _ ↦ (h.mdifferentiableAt _ x).mul (h.mdifferentiableAt _ x)]
  simp only [FunLike.coe_sum, Finset.sum_apply,
    mvfderiv_fun_mul (h.mdifferentiableAt _ x) (h.mdifferentiableAt _ x),
    add_apply, FunLike.coe_smul, Pi.smul_apply, smul_eq_mul,
    ← h.differential_apply, Finset.sum_add_distrib]
  -- Both sums are the component of `dμ_x v` along `K (μ x)`.
  set D := h.differential x v
  have h₂ : ∑ i, μ x (K (b.coord i)) * D (b i) = D (K (μ x)) := by
    rw [hK D, ← sum_apply_mul_apply_coord b K D (μ x)]
    exact Finset.sum_congr rfl fun _ _ ↦ mul_comm _ _
  rw [sum_apply_mul_apply_coord, h₂, h.differential_apply]
  ring

/-- **The differential of the norm square of a moment map, through `σ`.** For a symmetric `K`,
`d‖μ‖²_x (v) = 2 σ((K (μ x))_M x, v)`. -/
theorem mvfderiv_momentNormSq_apply (h : σ.IsMomentMap a μ)
    (hK : ∀ ν ν' : Module.Dual ℝ 𝔤, ν (K ν') = ν' (K ν)) (x : M) (v : TangentSpace I x) :
    mvfderiv I (momentNormSq μ K) x v = 2 * SmoothBundleForm.eval₂ σ x (a (K (μ x)) x) v := by
  rw [h.mvfderiv_momentNormSq hK, smul_apply, h.eval₂_apply, smul_eq_mul]

/-- A point is critical for the norm square `‖μ‖²` exactly when it is critical for the component
`μ^{K (μ x)}` of `μ` along `K (μ x)`. No nondegeneracy of `σ` is needed. -/
theorem mem_criticalPoints_momentNormSq_iff_mem_criticalPoints (h : σ.IsMomentMap a μ)
    (hK : ∀ ν ν' : Module.Dual ℝ 𝔤, ν (K ν') = ν' (K ν)) {x : M} :
    x ∈ criticalPoints I (momentNormSq μ K) ↔
      x ∈ criticalPoints I (fun y ↦ μ y (K (μ x))) := by
  rw [mem_criticalPoints, mem_criticalPoints, h.mvfderiv_momentNormSq hK,
    smul_eq_zero, or_iff_right two_ne_zero]

/-- **The critical set of the norm square of a moment map.** The critical set of `‖μ‖²` is the
union over `ν ∈ 𝔤*` of the points of the level `μ⁻¹(ν)` that are critical for the component
`μ^{K ν}`. No nondegeneracy of `σ` is needed. -/
theorem criticalPoints_momentNormSq_eq_iUnion (h : σ.IsMomentMap a μ)
    (hK : ∀ ν ν' : Module.Dual ℝ 𝔤, ν (K ν') = ν' (K ν)) :
    criticalPoints I (momentNormSq μ K) =
      ⋃ ν, μ ⁻¹' {ν} ∩ criticalPoints I (fun y ↦ μ y (K ν)) := by
  ext x
  simp only [Set.mem_iUnion, Set.mem_inter_iff, Set.mem_preimage, Set.mem_singleton_iff]
  rw [h.mem_criticalPoints_momentNormSq_iff_mem_criticalPoints hK]
  exact ⟨fun hx ↦ ⟨μ x, rfl, hx⟩, fun ⟨_, hν, hx⟩ ↦ hν ▸ hx⟩

/-- **Critical points of the norm square of a moment map.** At a point `x` where `σ` is
nondegenerate, `x` is a critical point of `‖μ‖²` exactly when the vector field generated by
`K (μ x)` vanishes at `x`. -/
theorem mem_criticalPoints_momentNormSq_iff (h : σ.IsMomentMap a μ)
    (hK : ∀ ν ν' : Module.Dual ℝ 𝔤, ν (K ν') = ν' (K ν)) {x : M}
    (hσ : (σ.bilinFormAt x).Nondegenerate) :
    x ∈ criticalPoints I (momentNormSq μ K) ↔ a (K (μ x)) x = 0 := by
  rw [h.mem_criticalPoints_momentNormSq_iff_mem_criticalPoints hK,
    h.mem_criticalPoints_iff hσ]

/-- For a nondegenerate `σ`, the critical set of `‖μ‖²` is `{x | (K (μ x))_M x = 0}`. -/
theorem criticalPoints_momentNormSq_eq (h : σ.IsMomentMap a μ)
    (hK : ∀ ν ν' : Module.Dual ℝ 𝔤, ν (K ν') = ν' (K ν)) (hσ : σ.IsNondegenerate) :
    criticalPoints I (momentNormSq μ K) = {x | a (K (μ x)) x = 0} :=
  Set.ext fun _ ↦ h.mem_criticalPoints_momentNormSq_iff hK (hσ.nondegenerate_bilinFormAt _)

/-- **The gradient of the norm square of a moment map.** Let `M` carry a Riemannian metric and
let `J` be an endomorphism of `T_x M` with `⟪J u, v⟫ = σ(u, v)`, as for the metric `σ(·, J ·)` of
an almost complex structure `J` compatible with `σ`. Then the gradient of `‖μ‖²` at `x` is
`2 J (K (μ x))_M x`. -/
theorem mgradient_momentNormSq [FiniteDimensional ℝ E]
    [RiemannianBundle (fun x : M ↦ TangentSpace I x)] (h : σ.IsMomentMap a μ)
    (hK : ∀ ν ν' : Module.Dual ℝ 𝔤, ν (K ν') = ν' (K ν)) {x : M}
    (J : TangentSpace I x →ₗ[ℝ] TangentSpace I x)
    (hJ : ∀ u v, inner ℝ (J u) v = SmoothBundleForm.eval₂ σ x u v) :
    Manifold.mgradient I (momentNormSq μ K) x = (2 : ℝ) • J (a (K (μ x)) x) := by
  refine (Manifold.eq_mgradient_iff.2 fun v ↦ ?_).symm
  rw [real_inner_smul_left, hJ, h.mvfderiv_momentNormSq_apply hK]

end Infinitesimal

section Group

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G] [T2Space G]
  [IsTopologicalGroup G]
  {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E'] [CompleteSpace E']
  {H' : Type*} [TopologicalSpace H'] {I' : ModelWithCorners ℝ E' H'}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H' M] [IsManifold I' ∞ M] [T2Space M]
  [BoundarylessManifold I' M] [MulAction G M] [ContMDiffSMul I I' ∞ G M]
  {σ : SmoothTwoForm I' M} {μ : M → Module.Dual ℝ (GroupLieAlgebra I G)}
  {K : Module.Dual ℝ (GroupLieAlgebra I G) →ₗ[ℝ] GroupLieAlgebra I G}

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
attribute [local instance] ContMDiffMul.boundarylessManifold

/-- **Kirwan's critical sets of the norm square.** For a moment map of a smooth action of a Lie
group `G` on `(M, σ)` with `σ` nondegenerate, the critical set of `‖μ‖²` is the union over
`ν ∈ 𝔤*` of the points of the level `μ⁻¹(ν)` fixed by the closure `T_{K ν}` of the one-parameter
subgroup generated by `K ν`. -/
theorem criticalPoints_momentNormSq_eq_iUnion_fixedPoints
    (h : σ.IsMomentMap (InfinitesimalAction.fundamental I G I' M) μ)
    (hK : ∀ ν ν' : Module.Dual ℝ (GroupLieAlgebra I G), ν (K ν') = ν' (K ν))
    (hσ : σ.IsNondegenerate) :
    criticalPoints I' (momentNormSq μ K) =
      ⋃ ν, μ ⁻¹' {ν} ∩ MulAction.fixedPoints (Lie.closedOneParameterSubgroup (K ν)) M := by
  have : FiniteDimensional ℝ (GroupLieAlgebra I G) := inferInstanceAs (FiniteDimensional ℝ E)
  simp_rw [h.criticalPoints_momentNormSq_eq_iUnion hK, h.criticalPoints_eq_fixedPoints hσ]

end Group

end SmoothTwoForm.IsMomentMap

section Invariance

variable {G M 𝔤 : Type*} [Group G] [AddCommGroup 𝔤] [Module ℝ 𝔤] [SMul G M]
  {ρ : Representation ℝ G 𝔤} {μ : M → Module.Dual ℝ 𝔤} {K : Module.Dual ℝ 𝔤 →ₗ[ℝ] 𝔤}

/-- **Invariance of the norm square.** If `μ` is equivariant for the dual `ρ.dual` of a
representation `ρ` of `G` on `𝔤` and `K` intertwines `ρ.dual` with `ρ`,
`K (ρ.dual g ν) = ρ g (K ν)`, then `‖μ‖²` is invariant under `G`. For the adjoint
representation, whose dual is the coadjoint representation, this is the invariance under a
coadjoint-equivariant moment map. -/
theorem momentNormSq_smul (hμ : ∀ (g : G) x, μ (g • x) = ρ.dual g (μ x))
    (hK : ∀ g ν, K (ρ.dual g ν) = ρ g (K ν)) (g : G) (x : M) :
    momentNormSq μ K (g • x) = momentNormSq μ K x := by
  simp only [momentNormSq_apply, hμ, hK]
  simp [Module.Dual.transpose_apply]

end Invariance

end TauCeti
