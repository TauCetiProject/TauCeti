/-!
# The unitary moment map of complex projective space

Complex projective space `CPⁿ` (`TauCeti.ComplexProjectiveSpace n`) is the space of complex lines
`L` in `ℂⁿ⁺¹`. Identify each line with the orthogonal projector `Π_L` onto it, a Hermitian matrix
(`TauCeti.ComplexProjectiveSpace.projector`), and the dual of the unitary Lie algebra `𝔲(n + 1)`
of skew-Hermitian matrices with the Hermitian matrices by the trace pairing
`⟨H, X⟩ = -i tr(H X)` (`TauCeti.unitaryTracePairing`). This file proves that the inclusion

`μ(L) = ⟨Π_L, ·⟩` (`TauCeti.ComplexProjectiveSpace.unitaryMomentMap`)

is a moment map of the action of `U(n + 1)` on `CPⁿ` by `A • [y] = [A y]`, for the symplectic form
`σ = -2π ω_FS`, where `ω_FS` is the Fubini–Study form of total area one on a line
(`TauCeti.ComplexProjectiveSpace.fubiniStudyForm`). With the convention `ι_(X_f) σ = df`:

* In homogeneous coordinates, `μ([y])(X) = Im ⟪y, X y⟫` for a unit vector `y`
  (`TauCeti.ComplexProjectiveSpace.unitaryMomentMap_mk_apply`), since `Π_[y] = y y*`.
* The Hamiltonian vector field of the component `μ_X` at `[y]` is the image under the
  differential of the Hopf projection `mk : S²ⁿ⁺¹ → CPⁿ` of the tangent vector `X y` of the sphere
  (`TauCeti.ComplexProjectiveSpace.hamiltonianVectorField_unitaryMomentMap_mk`), the infinitesimal
  form `[y] ↦ [X y]` of the action `A • [y] = [A y]`. Both sides of `σ(X_μ, w) = dμ_X(w)` are
  `-2 Im ⟪X y, v⟫` on the image `w` of a tangent vector `v` of the sphere: the left side since
  `ω_FS = π⁻¹ Im ⟪·, ·⟫` on the sphere, the right side since `X` is skew-Hermitian.
* These Hamiltonians close under the Poisson bracket, `{μ_X, μ_Y} = μ_⁅X, Y⁆`. So their Hamiltonian
  vector fields form an infinitesimal action of `𝔲(n + 1)`
  (`TauCeti.ComplexProjectiveSpace.unitaryAction`), generated by `X ↦ [X y]`
  (`TauCeti.ComplexProjectiveSpace.unitaryAction_apply_mk`), with moment map `μ`
  (`TauCeti.ComplexProjectiveSpace.isMomentMap_unitaryMomentMap`). It is infinitesimally
  equivariant (`TauCeti.ComplexProjectiveSpace.momentCocycle_unitaryAction`) and coadjoint
  equivariant at group level, `μ(A • L) = Ad*_A μ(L)`
  (`TauCeti.ComplexProjectiveSpace.unitaryMomentMap_smul`), because `Π_(A L) = A Π_L A*`.
* Restricted to the diagonal torus, `μ` is the diagonal of the projector,
  `[y] ↦ (|y₀|², …, |yₙ|²)` for a unit vector `y`
  (`TauCeti.ComplexProjectiveSpace.unitaryTorusRestriction_unitaryMomentMap_mk`).

The factor `-2π` fixes the sign and the normalization of `σ`, as for the diagonal torus acting on
the Riemann sphere model of `CP¹` (`OnePoint.isMomentMap_fubiniStudyMoment`).

## Main definitions

* `TauCeti.ComplexProjectiveSpace.projector`: the orthogonal projector `Π_L` of a line.
* `TauCeti.ComplexProjectiveSpace.unitaryMomentMap`: the covector `⟨Π_L, ·⟩ ∈ 𝔲(n + 1)*`.
* `TauCeti.ComplexProjectiveSpace.unitaryAction`: the infinitesimal action of `𝔲(n + 1)`.

## Main results

* `TauCeti.ComplexProjectiveSpace.hamiltonianVectorField_unitaryMomentMap_mk`: the Hamiltonian
  vector field of `μ_X` for `-2π ω_FS` is `[y] ↦ [X y]`.
* `TauCeti.ComplexProjectiveSpace.isMomentMap_unitaryMomentMap`: `μ` is a moment map.
* `TauCeti.ComplexProjectiveSpace.unitaryMomentMap_smul`: `μ` is coadjoint equivariant.

## References

* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Lecture 22 and Section 27.1 (the moment map of the unitary action on complex
  projective space).
* V. Guillemin and S. Sternberg, *Convexity properties of the moment mapping*, Invent. Math. 67
  (1982), 491–513 (the projector as the moment map on coadjoint orbits of `U(n)`).
-/

public section

noncomputable section

open Complex (I)
open Function Matrix Metric WithLp
open scoped ContDiff Manifold InnerProductSpace

namespace TauCeti.ComplexProjectiveSpace

variable {n : ℕ}

/-! ### The orthogonal projector of a line -/

variable (n) in
/-- The **orthogonal projector** `Π_L` onto a line `L` of `ℂⁿ⁺¹`, as a Hermitian matrix: the
Hermitian projector `y y* / (y* y)` of any vector `y` spanning `L`
(`Projectivization.hermitianProjector`). -/
def projector (x : ComplexProjectiveSpace n) :
    selfAdjoint.submodule ℝ (Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) :=
  ⟨(homeomorphProjectivization n x).hermitianProjector,
    (mem_hermitianProjectorLocus.mp
      (Projectivization.hermitianProjector_mem_hermitianProjectorLocus _)).1.isSelfAdjoint⟩

theorem coe_projector (x : ComplexProjectiveSpace n) :
    (projector n x : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) =
      (homeomorphProjectivization n x).hermitianProjector :=
  (rfl)

/-- The projector onto the line spanned by a unit vector `y` is the Hermitian projector of `y`,
the matrix `y y*`. -/
@[simp]
theorem coe_projector_mk (y : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1) :
    (projector n (mk n y) : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) =
      rankOneHermitianProjector (ofLp (y : EuclideanSpace ℂ (Fin (n + 1)))) := by
  rw [coe_projector, homeomorphProjectivization_mk, Projectivization.hermitianProjector_mk]

/-- **The projector is unitarily equivariant**: moving a line by a unitary matrix `A` conjugates
its projector by `A`, `Π_(A L) = A Π_L A*`. -/
theorem coe_projector_smul (A : unitaryGroup (Fin (n + 1)) ℂ) (x : ComplexProjectiveSpace n) :
    (projector n (A • x) : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) =
      A * projector n x * star (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) := by
  induction x using ComplexProjectiveSpace.inductionOn with
  | h y =>
    rw [smul_mk, coe_projector_mk, coe_projector_mk, LinearIsometryEquiv.coe_smul_unitSphere,
      UnitaryGroup.toLinearIsometryEquiv_apply, ofLp_toLp,
      rankOneHermitianProjector_unitary_mulVec A.property]

/-! ### The moment map -/

variable (n) in
/-- The **moment map of the unitary action** on `CPⁿ`: the line `L` goes to the covector
`⟨Π_L, ·⟩ = -i tr(Π_L ·)` on the unitary Lie algebra `𝔲(n + 1)`. It is a moment map of the
infinitesimal action `TauCeti.ComplexProjectiveSpace.unitaryAction` for the symplectic form
`-2π ω_FS` (`TauCeti.ComplexProjectiveSpace.isMomentMap_unitaryMomentMap`). -/
def unitaryMomentMap (x : ComplexProjectiveSpace n) :
    Module.Dual ℝ (unitaryLieAlgebra (Fin (n + 1))) :=
  unitaryTracePairing (Fin (n + 1)) (projector n x)

theorem unitaryMomentMap_def (x : ComplexProjectiveSpace n) :
    unitaryMomentMap n x = unitaryTracePairing (Fin (n + 1)) (projector n x) :=
  (rfl)

/-- The inner product of a unit vector of `ℂⁿ⁺¹` with itself is one. -/
private theorem star_dotProduct_self_eq_one (y : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1) :
    star (ofLp (y : EuclideanSpace ℂ (Fin (n + 1)))) ⬝ᵥ ofLp (y : EuclideanSpace ℂ (Fin (n + 1))) =
      1 := by
  have h := inner_self_eq_norm_sq_to_K (𝕜 := ℂ) (y : EuclideanSpace ℂ (Fin (n + 1)))
  rw [norm_eq_of_mem_sphere y, EuclideanSpace.inner_eq_star_dotProduct, dotProduct_comm] at h
  simpa using h

/-- **The moment map in homogeneous coordinates**: for a unit vector `y`,
`⟨Π_[y], X⟩ = Im ⟪y, X y⟫`. -/
theorem unitaryMomentMap_mk_apply (y : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1)
    (X : unitaryLieAlgebra (Fin (n + 1))) :
    unitaryMomentMap n (mk n y) X =
      (⟪(y : EuclideanSpace ℂ (Fin (n + 1))),
        toEuclideanCLM (𝕜 := ℂ) (X : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) y⟫_ℂ).im := by
  rw [unitaryMomentMap_def, unitaryTracePairing_apply, coe_projector_mk,
    rankOneHermitianProjector_def, star_dotProduct_self_eq_one, inv_one, one_smul, vecMulVec_mul,
    trace_vecMulVec, EuclideanSpace.inner_eq_star_dotProduct, ofLp_toEuclideanCLM, dotProduct_comm,
    ← dotProduct_mulVec, dotProduct_comm]
  simp

/-- **The moment map is coadjoint equivariant**: `μ(A • L) = Ad*_A μ(L)` for every unitary
matrix `A`. -/
theorem unitaryMomentMap_smul (A : unitaryGroup (Fin (n + 1)) ℂ) (x : ComplexProjectiveSpace n) :
    unitaryMomentMap n (A • x) =
      unitaryCoadjointRepresentation (Fin (n + 1)) A (unitaryMomentMap n x) := by
  rw [unitaryMomentMap_def, unitaryMomentMap_def,
    unitaryCoadjointRepresentation_unitaryTracePairing]
  congr 1
  exact Subtype.ext (coe_projector_smul A x)

/-- **Restricted to the diagonal torus, the moment map is the diagonal of the projector**: in the
coordinates `θ` of `i diag(θ)`, the line spanned by a unit vector `y` goes to
`(|y₀|², …, |yₙ|²)`. -/
theorem unitaryTorusRestriction_unitaryMomentMap_mk
    (y : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1) :
    unitaryTorusRestriction (Fin (n + 1)) (unitaryMomentMap n (mk n y)) =
      fun k ↦ ‖(y : EuclideanSpace ℂ (Fin (n + 1))) k‖ ^ 2 := by
  ext k
  rw [unitaryMomentMap_def, unitaryTorusRestriction_unitaryTracePairing]
  simp only [coe_projector_mk, rankOneHermitianProjector_apply, star_dotProduct_self_eq_one,
    div_one, RCLike.star_def, Complex.mul_conj, Complex.ofReal_re, Complex.normSq_eq_norm_sq]

/-! ### The skew-Hermitian operators -/

/-- A skew-Hermitian matrix acts on `ℂⁿ⁺¹` by a skew-adjoint operator. -/
private theorem inner_toEuclideanCLM_left (X : unitaryLieAlgebra (Fin (n + 1)))
    (u v : EuclideanSpace ℂ (Fin (n + 1))) :
    ⟪toEuclideanCLM (𝕜 := ℂ) (X : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) u, v⟫_ℂ =
      -⟪u, toEuclideanCLM (𝕜 := ℂ) (X : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) v⟫_ℂ := by
  rw [← ContinuousLinearMap.adjoint_inner_left, adjoint_toEuclideanCLM,
    conjTranspose_coe_unitaryLieAlgebra, map_neg, neg_apply, inner_neg_left,
    neg_neg]

/-- The function `w ↦ Im ⟪w, X w⟫` on `ℂⁿ⁺¹`, whose restriction to the sphere descends to the
component `μ_X` of the moment map. -/
private def imInnerApply (X : unitaryLieAlgebra (Fin (n + 1)))
    (w : EuclideanSpace ℂ (Fin (n + 1))) : ℝ :=
  (⟪w, toEuclideanCLM (𝕜 := ℂ) (X : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) w⟫_ℂ).im

private theorem contDiff_imInnerApply (X : unitaryLieAlgebra (Fin (n + 1))) :
    ContDiff ℝ ∞ (imInnerApply X) :=
  Complex.imCLM.contDiff.comp (contDiff_id.inner ℂ
    ((toEuclideanCLM (𝕜 := ℂ) (X : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ)).restrictScalars
      ℝ).contDiff)

/-- The derivative of `w ↦ Im ⟪w, X w⟫` at `y` in the direction `v` is `-2 Im ⟪X y, v⟫`, since
`X` is skew-Hermitian. -/
private theorem fderiv_imInnerApply_apply (X : unitaryLieAlgebra (Fin (n + 1)))
    (y v : EuclideanSpace ℂ (Fin (n + 1))) :
    fderiv ℝ (imInnerApply X) y v =
      -2 * (⟪toEuclideanCLM (𝕜 := ℂ) (X : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) y, v⟫_ℂ).im := by
  set A := toEuclideanCLM (𝕜 := ℂ) (X : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ)
  have h : HasFDerivAt (imInnerApply X)
      (Complex.imCLM.comp ((fderivInnerCLM ℂ (y, A y)).comp
        ((ContinuousLinearMap.id ℝ _).prod (A.restrictScalars ℝ)))) y :=
    Complex.imCLM.hasFDerivAt.comp y ((hasFDerivAt_id y).inner ℂ (A.restrictScalars ℝ).hasFDerivAt)
  rw [h.fderiv]
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.prod_apply,
    ContinuousLinearMap.id_apply, ContinuousLinearMap.coe_restrictScalars', fderivInnerCLM_apply,
    Complex.imCLM_apply]
  -- `⟪y, X v⟫ = -⟪X y, v⟫` and `⟪v, X y⟫ = conj ⟪X y, v⟫`.
  rw [← neg_neg ⟪y, A v⟫_ℂ, ← inner_toEuclideanCLM_left, ← inner_conj_symm v]
  simp only [Complex.add_im, Complex.neg_im, Complex.conj_im]
  ring

/-- The tangent vector `X y` of the sphere at `y`: since `X` is skew-Hermitian, `X y` is real
orthogonal to `y`. -/
theorem exists_mvfderiv_coe_eq_toEuclideanCLM (X : unitaryLieAlgebra (Fin (n + 1)))
    (y : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1) :
    ∃ u : TangentSpace (𝓡 (2 * n + 1)) y,
      mvfderiv (𝓡 (2 * n + 1))
          ((↑) : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1 → EuclideanSpace ℂ (Fin (n + 1)))
          y u =
        toEuclideanCLM (𝕜 := ℂ) (X : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) y := by
  refine exists_mvfderiv_coe_sphere_eq y ?_
  rw [EuclideanSpace.real_inner_eq_re_inner]
  -- `⟪y, X y⟫ = -conj ⟪y, X y⟫`, so its real part vanishes.
  have h := inner_toEuclideanCLM_left X y y
  rw [← inner_conj_symm] at h
  have h' := congrArg Complex.re h
  simp only [Complex.conj_re, Complex.neg_re] at h'
  linarith

/-- On the sphere, the component `μ_X` of the moment map is the restriction of
`w ↦ Im ⟪w, X w⟫`. -/
private theorem unitaryMomentMap_apply_comp_mk (X : unitaryLieAlgebra (Fin (n + 1))) :
    (fun x ↦ unitaryMomentMap n x X) ∘ mk n =
      imInnerApply X ∘ ((↑) : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1 → _) :=
  funext fun y ↦ unitaryMomentMap_mk_apply y X

/-- The components of the moment map are smooth: on the sphere they are restrictions of the
smooth functions `w ↦ Im ⟪w, X w⟫`, and the Hopf projection is a surjective submersion. -/
theorem contMDiff_unitaryMomentMap_apply (X : unitaryLieAlgebra (Fin (n + 1))) :
    ContMDiff 𝓘(ℝ, Fin n → ℂ) 𝓘(ℝ) ∞ fun x ↦ unitaryMomentMap n x X := by
  rw [← (isSubmersion_mk ∞).contMDiff_comp_iff (mk_surjective n) le_rfl,
    unitaryMomentMap_apply_comp_mk]
  exact (contDiff_imInnerApply X).contMDiff.comp contMDiff_coe_sphere

/-! ### The Hamiltonian vector fields -/

/-- `-2π ω_FS` is a symplectic form on `CPⁿ`. -/
theorem isSymplectic_neg_two_pi_smul_fubiniStudyForm :
    ((-(2 * Real.pi)) • fubiniStudyForm n).IsSymplectic :=
  isSymplectic_fubiniStudyForm.smul _ (by simp [Real.pi_ne_zero])

/-- The form `-2π ω_FS` on the images of tangent vectors `u, w` of the sphere, read in `ℂⁿ⁺¹`, is
`-2 Im ⟪u, w⟫`. -/
private theorem eval₂_neg_two_pi_smul_fubiniStudyForm_mfderiv_mk
    (y : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1) (u w : TangentSpace (𝓡 (2 * n + 1)) y) :
    SmoothBundleForm.eval₂ ((-(2 * Real.pi)) • fubiniStudyForm n) (mk n y)
        (mfderiv (𝓡 (2 * n + 1)) 𝓘(ℝ, Fin n → ℂ) (mk n) y u)
        (mfderiv (𝓡 (2 * n + 1)) 𝓘(ℝ, Fin n → ℂ) (mk n) y w) =
      -2 * (⟪mvfderiv (𝓡 (2 * n + 1))
          ((↑) : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1 → EuclideanSpace ℂ (Fin (n + 1)))
          y u,
        mvfderiv (𝓡 (2 * n + 1))
          ((↑) : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1 → EuclideanSpace ℂ (Fin (n + 1)))
          y w⟫_ℂ).im := by
  rw [SmoothForm.eval₂_smul, eval₂_fubiniStudyForm_mfderiv_mk, smul_eq_mul]
  field_simp

/-- The derivative of the component `μ_X` on the image of a tangent vector `v` of the sphere is
`-2 Im ⟪X y, v⟫`. -/
private theorem mvfderiv_unitaryMomentMap_mfderiv_mk (X : unitaryLieAlgebra (Fin (n + 1)))
    (y : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1) (v : TangentSpace (𝓡 (2 * n + 1)) y) :
    mvfderiv 𝓘(ℝ, Fin n → ℂ) (fun x ↦ unitaryMomentMap n x X) (mk n y)
        (mfderiv (𝓡 (2 * n + 1)) 𝓘(ℝ, Fin n → ℂ) (mk n) y v) =
      -2 * (⟪toEuclideanCLM (𝕜 := ℂ) (X : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) y,
        mvfderiv (𝓡 (2 * n + 1))
          ((↑) : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1 → EuclideanSpace ℂ (Fin (n + 1)))
          y v⟫_ℂ).im := by
  have hμy : MDifferentiableAt 𝓘(ℝ, Fin n → ℂ) 𝓘(ℝ) (fun x ↦ unitaryMomentMap n x X) (mk n y) :=
    (contMDiff_unitaryMomentMap_apply X _).mdifferentiableAt (by simp)
  have hmk : MDifferentiableAt (𝓡 (2 * n + 1)) 𝓘(ℝ, Fin n → ℂ) (mk n) y :=
    ((contMDiff_mk ∞) y).mdifferentiableAt (by simp)
  have hcoe : MDifferentiableAt (𝓡 (2 * n + 1)) 𝓘(ℝ, EuclideanSpace ℂ (Fin (n + 1)))
      ((↑) : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1 → EuclideanSpace ℂ (Fin (n + 1))) y :=
    (contMDiff_coe_sphere (m := 1) y).mdifferentiableAt one_ne_zero
  have hg : Differentiable ℝ (imInnerApply X) := (contDiff_imInnerApply X).differentiable (by simp)
  rw [← mvfderiv_comp_apply y hμy hmk, unitaryMomentMap_apply_comp_mk,
    mvfderiv_comp_apply_of_differentiableAt (hg _) hcoe,
    fderiv_imInnerApply_apply]

/-- **The Hamiltonian vector field of a component of the moment map**: for `σ = -2π ω_FS` and
`X ∈ 𝔲(n + 1)`, the Hamiltonian vector field of `μ_X` at the line spanned by a unit vector `y`
is the image under the differential of the Hopf projection of the tangent vector `X y` of the
sphere. -/
theorem hamiltonianVectorField_unitaryMomentMap_mk (X : unitaryLieAlgebra (Fin (n + 1)))
    (y : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1) {u : TangentSpace (𝓡 (2 * n + 1)) y}
    (hu : mvfderiv (𝓡 (2 * n + 1))
        ((↑) : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1 → EuclideanSpace ℂ (Fin (n + 1)))
        y u =
      toEuclideanCLM (𝕜 := ℂ) (X : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) y) :
    ((-(2 * Real.pi)) • fubiniStudyForm n).hamiltonianVectorField
        (fun x ↦ unitaryMomentMap n x X) (mk n y) =
      mfderiv (𝓡 (2 * n + 1)) 𝓘(ℝ, Fin n → ℂ) (mk n) y u := by
  have hinv := isSymplectic_neg_two_pi_smul_fubiniStudyForm.isNondegenerate.isInvertible_flat
    (mk n y)
  refine hinv.injective ?_
  rw [SmoothTwoForm.flat_hamiltonianVectorField_of_isInvertible hinv]
  refine ContinuousLinearMap.ext fun w ↦ ?_
  obtain ⟨v, rfl⟩ := surjective_mfderiv_mk y w
  rw [SmoothTwoForm.flat_apply, eval₂_neg_two_pi_smul_fubiniStudyForm_mfderiv_mk,
    mvfderiv_unitaryMomentMap_mfderiv_mk, hu]

/-- **The components of the moment map close under the Poisson bracket** of `-2π ω_FS`:
`{μ_X, μ_Y} = μ_⁅X, Y⁆`. At `[y]` both sides are `-2 Im ⟪X y, Y y⟫`. -/
theorem poissonBracket_unitaryMomentMap (X Y : unitaryLieAlgebra (Fin (n + 1))) :
    ((-(2 * Real.pi)) • fubiniStudyForm n).poissonBracket (fun x ↦ unitaryMomentMap n x X)
        (fun x ↦ unitaryMomentMap n x Y) =
      fun x ↦ unitaryMomentMap n x ⁅X, Y⁆ := by
  funext x
  induction x using ComplexProjectiveSpace.inductionOn with
  | h y =>
    obtain ⟨u, hu⟩ := exists_mvfderiv_coe_eq_toEuclideanCLM X y
    obtain ⟨u', hu'⟩ := exists_mvfderiv_coe_eq_toEuclideanCLM Y y
    set A := toEuclideanCLM (𝕜 := ℂ) (X : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ)
    set B := toEuclideanCLM (𝕜 := ℂ) (Y : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ)
    have hXY : ((⁅X, Y⁆ : unitaryLieAlgebra (Fin (n + 1))) : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) =
        X * Y - Y * X := by
      simp only [LieSubalgebra.coe_bracket, Ring.lie_def]
    -- `⟪y, X Y y⟫ = -⟪X y, Y y⟫` and `⟪y, Y X y⟫ = -⟪Y y, X y⟫ = -conj ⟪X y, Y y⟫`.
    have h₁ : ⟪(y : EuclideanSpace ℂ (Fin (n + 1))), A (B y)⟫_ℂ = -⟪A y, B y⟫_ℂ := by
      rw [inner_toEuclideanCLM_left, neg_neg]
    have h₂ : ⟪(y : EuclideanSpace ℂ (Fin (n + 1))), B (A y)⟫_ℂ =
        -(starRingEnd ℂ) ⟪A y, B y⟫_ℂ := by
      rw [inner_conj_symm, inner_toEuclideanCLM_left, neg_neg]
    rw [SmoothTwoForm.poissonBracket_def, hamiltonianVectorField_unitaryMomentMap_mk X y hu,
      hamiltonianVectorField_unitaryMomentMap_mk Y y hu',
      eval₂_neg_two_pi_smul_fubiniStudyForm_mfderiv_mk, hu, hu', unitaryMomentMap_mk_apply, hXY,
      map_sub, map_mul, map_mul, sub_apply, mul_apply_eq_comp,
      mul_apply_eq_comp, inner_sub_right, h₁, h₂]
    simp only [Complex.sub_im, Complex.neg_im, Complex.conj_im]
    ring

/-! ### The infinitesimal action of the unitary Lie algebra -/

variable (n) in
/-- The **infinitesimal action of `𝔲(n + 1)` on `CPⁿ`**, the infinitesimal form of the action
`A • [y] = [A y]` of `U(n + 1)`: `X ∈ 𝔲(n + 1)` generates the vector field `[y] ↦ [X y]`, the
image under the differential of the Hopf projection of the tangent vector `X y` of the sphere
(`TauCeti.ComplexProjectiveSpace.unitaryAction_apply_mk`). It is the action generated by the
components of the moment map `μ(L) = ⟨Π_L, ·⟩` for the symplectic form `-2π ω_FS`. -/
def unitaryAction :
    InfinitesimalAction (unitaryLieAlgebra (Fin (n + 1))) 𝓘(ℝ, Fin n → ℂ)
      (ComplexProjectiveSpace n) :=
  isSymplectic_neg_two_pi_smul_fubiniStudyForm.comomentAction (unitaryMomentMap n)
    contMDiff_unitaryMomentMap_apply poissonBracket_unitaryMomentMap

/-- **The generators of the unitary action**: the vector field generated by `X ∈ 𝔲(n + 1)` takes
at the line spanned by a unit vector `y` the value `[X y]`, the image under the differential of
the Hopf projection of the tangent vector `X y` of the sphere. -/
theorem unitaryAction_apply_mk (X : unitaryLieAlgebra (Fin (n + 1)))
    (y : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1) {u : TangentSpace (𝓡 (2 * n + 1)) y}
    (hu : mvfderiv (𝓡 (2 * n + 1))
        ((↑) : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1 → EuclideanSpace ℂ (Fin (n + 1)))
        y u =
      toEuclideanCLM (𝕜 := ℂ) (X : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) y) :
    unitaryAction n X (mk n y) = mfderiv (𝓡 (2 * n + 1)) 𝓘(ℝ, Fin n → ℂ) (mk n) y u := by
  rw [unitaryAction, SmoothTwoForm.IsSymplectic.comomentAction_apply,
    hamiltonianVectorField_unitaryMomentMap_mk X y hu]

/-- **The projector is a moment map of the unitary action**: for the symplectic form
`-2π ω_FS`, the component `L ↦ ⟨Π_L, X⟩` of `μ` has Hamiltonian vector field
`[y] ↦ [X y]` for every `X ∈ 𝔲(n + 1)`. -/
theorem isMomentMap_unitaryMomentMap :
    ((-(2 * Real.pi)) • fubiniStudyForm n).IsMomentMap (unitaryAction n) (unitaryMomentMap n) :=
  isSymplectic_neg_two_pi_smul_fubiniStudyForm.isMomentMap_comomentAction _ _ _

/-- The moment map of the unitary action is infinitesimally equivariant: its cocycle vanishes at
every point. -/
theorem momentCocycle_unitaryAction (x : ComplexProjectiveSpace n) :
    ((-(2 * Real.pi)) • fubiniStudyForm n).momentCocycle (unitaryAction n) (unitaryMomentMap n) x =
      0 :=
  isSymplectic_neg_two_pi_smul_fubiniStudyForm.momentCocycle_comomentAction _ _ _ x

end TauCeti.ComplexProjectiveSpace
