module

public import TauCeti.Geometry.Symplectic.Hamiltonian.MomentMap
import TauCeti.Geometry.Symplectic.Hamiltonian.Bracket

/-!
# The infinitesimal action generated by a comoment map

Let `σ` be a symplectic form on a finite-dimensional manifold `M`, and let `μ : M → 𝔤*` be a map
whose components `μ_Z = fun x ↦ μ x Z` are smooth. Suppose that `Z ↦ μ_Z` is a homomorphism of Lie
algebras into the smooth functions with the Poisson bracket,

`{μ_Z, μ_Z'} = μ_{⁅Z, Z'⁆}`.

Then the Hamiltonian vector fields `Z ↦ X_{μ_Z}` form an infinitesimal action of `𝔤` on `M`
(`TauCeti.SmoothTwoForm.IsSymplectic.comomentAction`): they are smooth, linear in `Z`, and form
an antihomomorphism of Lie algebras, because `X_{{f, g}} = -[X_f, X_g]`
(`TauCeti.SmoothTwoForm.IsNondegenerate.hamiltonianVectorField_poissonBracket`). By construction
`μ` is a moment map of this action
(`TauCeti.SmoothTwoForm.IsSymplectic.isMomentMap_comomentAction`), and it is infinitesimally
equivariant: its cocycle vanishes everywhere
(`TauCeti.SmoothTwoForm.IsSymplectic.momentCocycle_comomentAction`).

This is how a Hamiltonian action is read off from its moment map alone, for instance for the
rotations of a coadjoint orbit, where the components of the moment map are restrictions of
linear functions.

## References

* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Lecture 22 (the comoment map of a Hamiltonian action).
* D. McDuff, D. Salamon, *Introduction to Symplectic Topology*, 3rd ed., Oxford, 2017,
  Section 5.2.
-/

public section

noncomputable section

open scoped ContDiff Manifold

namespace TauCeti

namespace SmoothTwoForm

namespace IsSymplectic

variable {E H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [TopologicalSpace M] [ChartedSpace H M]
  [IsManifold I ∞ M] {𝔤 : Type*} [LieRing 𝔤] [LieAlgebra ℝ 𝔤]
  {σ : SmoothTwoForm I M} (hσ : σ.IsSymplectic) (μ : M → Module.Dual ℝ 𝔤)
  (hμ : ∀ Z, ContMDiff I 𝓘(ℝ) ∞ fun x ↦ μ x Z)
  (hbr : ∀ Z Z', σ.poissonBracket (fun x ↦ μ x Z) (fun x ↦ μ x Z') = fun x ↦ μ x ⁅Z, Z'⁆)

/-- The **infinitesimal action generated by a comoment map**: for a symplectic form `σ` and a map
`μ : M → 𝔤*` with smooth components satisfying `{μ_Z, μ_Z'} = μ_{⁅Z, Z'⁆}`, the Hamiltonian vector
fields `Z ↦ X_{μ_Z}`. The map `μ` is a moment map of this action
(`TauCeti.SmoothTwoForm.IsSymplectic.isMomentMap_comomentAction`). -/
def comomentAction : InfinitesimalAction 𝔤 I M where
  toLinearMap :=
    { toFun Z := σ.hamiltonianVectorField fun x ↦ μ x Z
      map_add' Z Z' := funext fun x ↦ by
        have hadd : (fun y ↦ μ y (Z + Z')) = (fun y ↦ μ y Z) + fun y ↦ μ y Z' :=
          funext fun y ↦ map_add (μ y) Z Z'
        rw [hadd, hamiltonianVectorField_add ((hμ Z).mdifferentiableAt (by simp))
          ((hμ Z').mdifferentiableAt (by simp))]
        rfl
      map_smul' c Z := funext fun x ↦ by
        have hsmul : (fun y ↦ μ y (c • Z)) = c • fun y ↦ μ y Z :=
          funext fun y ↦ map_smul (μ y) c Z
        rw [hsmul, hamiltonianVectorField_const_smul]
        rfl }
  contMDiff_toLinearMap' Z :=
    hσ.isNondegenerate.contMDiff_hamiltonianVectorField le_rfl (by simpa using hμ Z)
  toLinearMap_lie' Z Z' := by
    simp only [LinearMap.coe_mk, AddHom.coe_mk]
    rw [← hbr, hσ.isNondegenerate.hamiltonianVectorField_poissonBracket hσ.isClosed
      ((hμ Z).of_le (by simp)) ((hμ Z').of_le (by simp))]

/-- The infinitesimal action generated by a comoment map sends `Z` to the Hamiltonian vector field
of the component `μ_Z`. -/
@[simp]
theorem comomentAction_apply (Z : 𝔤) :
    (hσ.comomentAction μ hμ hbr) Z = σ.hamiltonianVectorField fun x ↦ μ x Z :=
  (rfl)

/-- **A comoment map is a moment map** of the infinitesimal action it generates. -/
theorem isMomentMap_comomentAction : σ.IsMomentMap (hσ.comomentAction μ hμ hbr) μ where
  contMDiff := hμ
  isHamiltonianVectorField Z :=
    hσ.isNondegenerate.isHamiltonianVectorField_hamiltonianVectorField fun x ↦ μ x Z

/-- A comoment map is infinitesimally equivariant for the action it generates: its cocycle
vanishes at every point. -/
theorem momentCocycle_comomentAction (x : M) :
    σ.momentCocycle (hσ.comomentAction μ hμ hbr) μ x = 0 := by
  refine momentCocycle_eq_zero_iff.2 fun Z Z' ↦ ?_
  rw [comomentAction_apply, comomentAction_apply, ← poissonBracket_def, hbr]

/-- An infinitesimal action with a moment map `μ` satisfying `{μ_Z, μ_Z'} = μ_{⁅Z, Z'⁆}` is the
action generated by `μ`: for a symplectic form a moment map determines its action. -/
theorem eq_comomentAction {a : InfinitesimalAction 𝔤 I M} (ha : σ.IsMomentMap a μ) :
    a = hσ.comomentAction μ hμ hbr :=
  InfinitesimalAction.ext fun Z ↦ by
    rw [comomentAction_apply, ha.hamiltonianVectorField_eq hσ.isNondegenerate]

end IsSymplectic

end SmoothTwoForm

end TauCeti
