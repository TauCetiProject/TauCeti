import TauCeti.Geometry.Manifold.MFDeriv.Curve
import TauCeti.Geometry.Manifold.MFDeriv.NormedSpace

/-!
# Constant vector fields on a torus are symplectic but not Hamiltonian

For a finite family of positive periods `p i`, let `Tⁿ = ∀ i, AddCircle (p i)` be the torus, with
coordinate time forms `dt_j` (`TauCeti.torusTimeForm p j`), and let `σ` be a two-form on `Tⁿ` with
constant coefficients `β` in the product charts, such as the area form `A dt_0 ∧ dt_1` of the
two-torus. For a real vector `v`, the constant vector field `v`
(`TauCeti.torusConstVectorField p v`) has the constant contraction

`ι_v σ = β(v, ·) = ∑ j, β(v, e_j) dt_j`

(`TauCeti.interiorₗ_torusConstVectorField`), a closed one-form. So `v` is a symplectic vector field
(`TauCeti.torusConstVectorField_mem_symplecticVectorFields`), and its de Rham class `[ι_v σ]` is
`∑ j, β(v, e_j) [dt_j]` (`TauCeti.interiorClass_torusConstVectorField`). Since the classes
`[dt_j]` are linearly independent, this class vanishes exactly when `β(v, ·) = 0`
(`TauCeti.interiorClass_torusConstVectorField_eq_zero_iff`).

The same condition decides whether `v` is a Hamiltonian vector field, `ι_v σ = df`, for any
function `f : Tⁿ → ℝ` at all, with no regularity assumed
(`TauCeti.exists_isHamiltonianVectorField_torusConstVectorField_iff`). If `β(v, e_j) ≠ 0`, the
differential of such an `f` along the `j`-th coordinate circle would be the nonzero constant
`β(v, e_j)`, so `f` would increase by `β(v, e_j) p j ≠ 0` around that closed circle. Equivalently,
the de Rham class of `ι_v σ` is detected by its period `β(v, e_j) p j` on the `j`-th coordinate
circle.

On the two-torus with the area form `A dt_0 ∧ dt_1` the contraction is
`ι_v σ = A (v 0 dt_1 - v 1 dt_0)`
(`TauCeti.interiorₗ_torusConstVectorField_smul_torusVolumeForm`), so for unit periods the field
`∂_x` has `ι_(∂_x) (dx ∧ dy) = dy`, whose period on the circle `s ↦ (0, s)` is `1`. Hence the
constant field `v` is Hamiltonian exactly when `A = 0` or `v = 0`
(`TauCeti.exists_isHamiltonianVectorField_torusConstVectorField_smul_torusVolumeForm_iff`): for
`A ≠ 0` the field `∂_x` is symplectic but not of the form `-X_f`. On the plane `ℝ²` the same
constant field is Hamiltonian, with the linear Hamiltonian `x ↦ ω(v, x)`
(`TauCeti.SymplecticForm.isMomentMap_translationMomentMap`), and `H¹_dR(ℝ²) = 0`: the class
`[ι_v σ] ∈ H¹_dR` is exactly what separates the two. The constant field generates the translations
`x ↦ x + [t v]` (`TauCeti.isMIntegralCurve_torusConstVectorField`), whose flux is this class
(`TauCeti.flux_torusTranslationDiffeotopy_smul_torusVolumeForm`).

## Main results

* `TauCeti.eval₂_torusConstVectorField`: a constant-coefficient two-form `β` pairs the constant
  vector field `v` with a tangent vector `w` to `β(v, w)`.
* `TauCeti.interiorₗ_torusConstVectorField`: the contraction of a constant-coefficient two-form
  with a constant vector field is `∑ j, β(v, e_j) dt_j`.
* `TauCeti.interiorₗ_torusConstVectorField_eq_fluxForm`: this contraction is the flux form of
  the translation diffeotopy generated by `v`.
* `TauCeti.torusConstVectorField_mem_symplecticVectorFields`: constant vector fields are
  symplectic for constant-coefficient two-forms.
* `TauCeti.interiorClass_torusConstVectorField`,
  `TauCeti.interiorClass_torusConstVectorField_eq_zero_iff`: the class `[ι_v σ]`, and when it
  vanishes.
* `TauCeti.exists_isHamiltonianVectorField_torusConstVectorField_iff`: a constant vector field is
  Hamiltonian, for any function, exactly when `β(v, ·) = 0`.
* `TauCeti.interiorₗ_torusConstVectorField_smul_torusVolumeForm`,
  `TauCeti.interiorClass_torusConstVectorField_smul_torusVolumeForm`,
  `TauCeti.exists_isHamiltonianVectorField_torusConstVectorField_smul_torusVolumeForm_iff`: the
  two-torus with the area form `A dt_0 ∧ dt_1`.

## References

* D. McDuff, D. Salamon, *Introduction to Symplectic Topology*, 3rd ed., Oxford, 2017,
  Section 3.1 (symplectic vector fields that are not Hamiltonian on the torus).
* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Section 18 (Hamiltonian and symplectic vector fields).
-/

public section

noncomputable section

open Function
open scoped Manifold ContDiff

namespace TauCeti

variable {ι : Type*} [Fintype ι] (p : ι → ℝ) [∀ i, Fact (0 < p i)] (v : ι → ℝ)

section Constant

variable {p v} {σ : SmoothTwoForm (ModelWithCorners.pi fun _ : ι ↦ 𝓘(ℝ)) (∀ i, AddCircle (p i))}
  {β : (ι → ℝ) [⋀^Fin 2]→L[ℝ] ℝ}

variable (hσ : ∀ x, (σ.val x : (ι → ℝ) [⋀^Fin 2]→L[ℝ] ℝ) = β)
include hσ

/-- For a two-form `σ` on the torus with constant coefficients `β`, pairing the constant vector
field `v` with a tangent vector `w` gives `β(v, w)`. -/
theorem eval₂_torusConstVectorField (x : ∀ i, AddCircle (p i))
    (w : TangentSpace (ModelWithCorners.pi fun _ : ι ↦ 𝓘(ℝ)) x) :
    SmoothBundleForm.eval₂ σ x (torusConstVectorField p v x) w = β ![v, w] := by
  rw [SmoothBundleForm.eval₂_apply, torusConstVectorField_apply, hσ]
  -- The two sides differ only in that `w` is read in `ι → ℝ` or in the tangent space at `x`.
  rfl

/-- **The contraction with a constant vector field.** For a two-form `σ` on the torus with constant
coefficients `β`, the contraction `ι_v σ` of the constant vector field `v` is the constant one-form
`∑ j, β(v, e_j) dt_j`. -/
theorem interiorₗ_torusConstVectorField [DecidableEq ι] :
    σ.interiorₗ (torusConstVectorField p v) =
      ∑ j, β ![v, Pi.single j 1] • torusTimeForm p j := by
  refine SmoothForm.degreeOneEquiv.injective (ContMDiffSection.ext fun x ↦
    ContinuousLinearMap.ext fun w ↦ ?_)
  rw [SmoothTwoForm.degreeOneEquiv_interiorₗ, SmoothForm.degreeOneEquiv_apply_apply,
    SmoothTwoForm.flat_apply, eval₂_torusConstVectorField hσ, sum_smul_torusTimeForm_apply]
  -- Both sides are `∑ j, β(v, e_j) w j`, with `w` read in `ι → ℝ`.
  exact (β.apply_vecCons_eq_sum_single_right v (w : ι → ℝ)).trans (by simp [mul_comm])

/-- **The contraction with a constant vector field is the flux form of its translations.** For a
two-form `σ` on the torus with constant coefficients, the contraction `ι_v σ` of the constant
vector field `v` is the flux form of the translation diffeotopy `x ↦ x + [t v]`, the isotopy
generated by `v`. -/
theorem interiorₗ_torusConstVectorField_eq_fluxForm :
    σ.interiorₗ (torusConstVectorField p v) = (torusTranslationDiffeotopy p v).fluxForm σ := by
  refine SmoothForm.degreeOneEquiv.injective (ContMDiffSection.ext fun x ↦
    ContinuousLinearMap.ext fun w ↦ ?_)
  rw [SmoothTwoForm.degreeOneEquiv_interiorₗ, SmoothForm.degreeOneEquiv_apply_apply_vec,
    SmoothTwoForm.flat_apply, eval₂_torusConstVectorField hσ,
    fluxForm_torusTranslationDiffeotopy_apply p v hσ x]
  -- Both sides evaluate `β` on the pair `(v, w)`.
  exact (ContinuousAlternatingMap.curryLeft_apply_apply β v ![w]).symm

/-- **Constant vector fields are symplectic.** For a two-form on the torus with constant
coefficients, the contraction with a constant vector field is closed. -/
theorem torusConstVectorField_mem_symplecticVectorFields :
    torusConstVectorField p v ∈ σ.symplecticVectorFields := by
  classical
  rw [SmoothTwoForm.mem_symplecticVectorFields_iff, ← SmoothTwoForm.coe_interiorₗ,
    interiorₗ_torusConstVectorField hσ]
  exact (SmoothForm.isClosed_def _).1 (isClosed_sum_smul_torusTimeForm p _)

/-- **The de Rham class of a constant vector field.** For a two-form `σ` on the torus with constant
coefficients `β`, the class `[ι_v σ]` of the constant vector field `v` is
`∑ j, β(v, e_j) [dt_j]`. -/
theorem interiorClass_torusConstVectorField [DecidableEq ι] :
    σ.interiorClass ⟨torusConstVectorField p v,
        torusConstVectorField_mem_symplecticVectorFields hσ⟩ =
      ∑ j, β ![v, Pi.single j 1] •
        deRhamCohomology.mk (ModelWithCorners.pi fun _ : ι ↦ 𝓘(ℝ)) 1 (torusTimeClosedForm p j) := by
  simp_rw [SmoothTwoForm.interiorClass_apply, ← map_smul, ← map_sum]
  congr 1
  refine Subtype.ext ?_
  simp only [Submodule.coe_sum, Submodule.coe_smul, coe_torusTimeClosedForm]
  exact interiorₗ_torusConstVectorField hσ

/-- The class `[ι_v σ]` of a constant vector field vanishes exactly when `β(v, ·) = 0`: the
classes of the coordinate time forms are linearly independent. -/
theorem interiorClass_torusConstVectorField_eq_zero_iff :
    σ.interiorClass ⟨torusConstVectorField p v,
        torusConstVectorField_mem_symplecticVectorFields hσ⟩ = 0 ↔ ∀ w, β ![v, w] = 0 := by
  classical
  rw [SmoothTwoForm.interiorClass_apply, deRhamCohomology.mk_eq_zero_iff]
  rw [Subtype.coe_mk, interiorₗ_torusConstVectorField hσ, sum_smul_torusTimeForm_mem_exactForms_iff]
  refine ⟨fun h w ↦ ?_, fun h ↦ funext fun j ↦ h _⟩
  rw [β.apply_vecCons_eq_sum_single_right]
  simp [show ∀ j, β ![v, Pi.single j 1] = 0 from congrFun h]

/-- **Constant vector fields are not Hamiltonian.** For a two-form `σ` on the torus with constant
coefficients `β`, the constant vector field `v` is the Hamiltonian vector field of some function,
`ι_v σ = df`, exactly when `β(v, ·) = 0`; then `f = 0` works. No regularity of `f` is assumed:
if `β(v, e_j) ≠ 0`, the derivative of `f` along the `j`-th coordinate circle would be the nonzero
constant `β(v, e_j)`, which is impossible on a closed curve. -/
theorem exists_isHamiltonianVectorField_torusConstVectorField_iff :
    (∃ f : (∀ i, AddCircle (p i)) → ℝ,
        σ.IsHamiltonianVectorField f (torusConstVectorField p v)) ↔ ∀ w, β ![v, w] = 0 := by
  classical
  refine ⟨fun ⟨f, hf⟩ ↦ ?_, fun h ↦
    ⟨0, SmoothTwoForm.isHamiltonianVectorField_iff.2 fun x w ↦ ?_⟩⟩
  · -- It suffices that `β(v, e_j) = 0` for every coordinate direction `j`.
    suffices hj : ∀ j, β ![v, Pi.single j 1] = 0 from
      fun w ↦ by rw [β.apply_vecCons_eq_sum_single_right]; simp [hj]
    intro j
    by_contra hj
    -- Along the `j`-th coordinate circle `γ s = 0 + [s e_j]`, `f` has derivative `β(v, e_j)`.
    let γ : ℝ → ∀ i, AddCircle (p i) :=
      fun s ↦ 0 + fun i ↦ ((s * Pi.single (M := fun _ : ι ↦ ℝ) j 1 i : ℝ) : AddCircle (p i))
    have hd (s : ℝ) : HasDerivAt (fun s ↦ f (γ s) - β ![v, Pi.single j 1] * s) 0 s := by
      have hval : mvfderiv (ModelWithCorners.pi fun _ : ι ↦ 𝓘(ℝ)) f (γ s) (Pi.single j 1) =
          β ![v, Pi.single j 1] :=
        (SmoothTwoForm.isHamiltonianVectorField_iff.1 hf (γ s) (Pi.single j 1)).symm.trans
          (eval₂_torusConstVectorField hσ (γ s) _)
      have hγ := isMIntegralCurve_torusConstVectorField p (Pi.single j 1) 0 s
      rw [torusConstVectorField_apply] at hγ
      have hfγ := Manifold.hasDerivAt_comp_curve
        (mdifferentiableAt_of_mvfderiv_apply_ne_zero (hval ▸ hj)) hγ
      rw [hval] at hfγ
      exact (hfγ.sub ((hasDerivAt_id s).const_mul (β ![v, Pi.single j 1]))).congr_deriv
        (by simp)
    -- So `f ∘ γ` grows linearly, while `γ` is periodic of period `p j`.
    have hconst := is_const_of_deriv_eq_zero (fun s ↦ (hd s).differentiableAt)
      (fun s ↦ (hd s).deriv) (p j) 0
    have hper : γ (p j) = γ 0 := funext fun i ↦ by
      by_cases hij : i = j
      · subst hij
        simp [γ, AddCircle.coe_period]
      · simp [γ, Pi.single_apply, hij]
    simp only [hper, mul_zero, sub_zero, sub_eq_self, mul_eq_zero] at hconst
    exact hconst.elim hj (Fact.out : 0 < p j).ne'
  · refine (eval₂_torusConstVectorField hσ x w).trans ?_
    rw [mvfderiv_zero]
    exact h w

end Constant

section Area

variable (p : Fin 2 → ℝ) [∀ i, Fact (0 < p i)] (v : Fin 2 → ℝ) (A : ℝ)

/-- **The contraction with a constant vector field on the two-torus.** For the area form
`A dt_0 ∧ dt_1`, the contraction with the constant vector field `v` is
`A (v 0 dt_1 - v 1 dt_0)`. For unit periods, `ι_(∂_x) (dx ∧ dy) = dy`. -/
theorem interiorₗ_torusConstVectorField_smul_torusVolumeForm :
    SmoothTwoForm.interiorₗ (A • torusVolumeForm p) (torusConstVectorField p v) =
      A • (v 0 • torusTimeForm p 1 - v 1 • torusTimeForm p 0) := by
  rw [interiorₗ_torusConstVectorField_eq_fluxForm (smul_torusVolumeForm_apply_eq_apply_zero p A),
    fluxForm_torusTranslationDiffeotopy_smul_torusVolumeForm]

/-- Constant vector fields on the two-torus are symplectic for the area form `A dt_0 ∧ dt_1`. -/
theorem torusConstVectorField_mem_symplecticVectorFields_smul_torusVolumeForm :
    torusConstVectorField p v ∈ SmoothTwoForm.symplecticVectorFields (A • torusVolumeForm p) :=
  torusConstVectorField_mem_symplecticVectorFields (smul_torusVolumeForm_apply_eq_apply_zero p A)

/-- **The de Rham class of a constant vector field on the two-torus.** For the area form
`A dt_0 ∧ dt_1`, the class of the constant vector field `v` is `A (v 0 [dt_1] - v 1 [dt_0])`. -/
theorem interiorClass_torusConstVectorField_smul_torusVolumeForm :
    SmoothTwoForm.interiorClass (A • torusVolumeForm p) ⟨torusConstVectorField p v,
        torusConstVectorField_mem_symplecticVectorFields_smul_torusVolumeForm p v A⟩ =
      A • (v 0 • deRhamCohomology.mk (ModelWithCorners.pi fun _ : Fin 2 ↦ 𝓘(ℝ)) 1
          (torusTimeClosedForm p 1) -
        v 1 • deRhamCohomology.mk (ModelWithCorners.pi fun _ : Fin 2 ↦ 𝓘(ℝ)) 1
          (torusTimeClosedForm p 0)) := by
  rw [SmoothTwoForm.interiorClass_apply, ← map_smul, ← map_smul, ← map_sub, ← map_smul]
  congr 1
  refine Subtype.ext ?_
  simp only [Submodule.coe_smul, Submodule.coe_sub, coe_torusTimeClosedForm]
  exact interiorₗ_torusConstVectorField_smul_torusVolumeForm p v A

/-- **Constant vector fields on the two-torus are not Hamiltonian.** For the area form
`A dt_0 ∧ dt_1`, the constant vector field `v` is the Hamiltonian vector field of some function
exactly when `A = 0` or `v = 0`. In particular, for unit periods and `A = 1`, the field `∂_x` is
symplectic but not Hamiltonian, although the constant field `∂_x` of the plane is the Hamiltonian
vector field of `y`. -/
theorem exists_isHamiltonianVectorField_torusConstVectorField_smul_torusVolumeForm_iff :
    (∃ f : (∀ i, AddCircle (p i)) → ℝ,
        SmoothTwoForm.IsHamiltonianVectorField (A • torusVolumeForm p) f
          (torusConstVectorField p v)) ↔
      A = 0 ∨ v = 0 := by
  rw [exists_isHamiltonianVectorField_torusConstVectorField_iff
    (smul_torusVolumeForm_apply_eq_apply_zero p A)]
  -- The coefficients of the area form are `A (v 0 w 1 - w 0 v 1)`.
  have key (w : Fin 2 → ℝ) :
      ((A • torusVolumeForm p).val 0 : (Fin 2 → ℝ) [⋀^Fin 2]→L[ℝ] ℝ) ![v, w] =
        A * (v 0 * w 1 - w 0 * v 1) := by
    rw [Submodule.coe_smul, Pi.smul_apply, ContinuousAlternatingMap.smul_apply, smul_eq_mul]
    -- The tangent space at `0` is the model space `Fin 2 → ℝ`, where `v` and `w` live.
    exact congrArg (A * ·) (torusVolumeForm_fin_two_apply p 0 v w)
  refine ⟨fun h ↦ or_iff_not_imp_left.2 fun hA ↦ funext fun i ↦ ?_, fun hAv w ↦ ?_⟩
  · -- Test against `e_1` and `e_0`.
    have h₀ := ((key ![0, 1]).symm.trans (h ![0, 1]))
    have h₁ := ((key ![1, 0]).symm.trans (h ![1, 0]))
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, mul_one, mul_zero, zero_mul, one_mul,
      sub_zero, zero_sub, neg_eq_zero, mul_eq_zero, hA, false_or] at h₀ h₁
    fin_cases i
    · exact h₀
    · exact h₁
  · refine (key w).trans ?_
    rcases hAv with rfl | rfl <;> simp

end Area

end TauCeti
