import TauCeti.Geometry.Manifold.MFDeriv.Pi

/-!
# Chains of generating functions and the cyclic discrete action

Let `S_0, …, S_(N-1)`, `N ≥ 1`, be real functions on `Q × Q` for a manifold `Q`, indexed by
`i ∈ ℤ/N`. Each generates the cotangent relation `p = d₁S_i(q, Q)`, `P = -d₂S_i(q, Q)`, whose
source and target points are `TauCeti.CotangentBundle.generatingSource` and
`TauCeti.CotangentBundle.generatingTarget`. The **cyclic discrete action**

`A(q_0, …, q_(N-1)) = Σ_i S_i(q_i, q_(i+1))`, indices mod `N`

(`TauCeti.cyclicAction`) is a function on the finite product `ℤ/N → Q`, a manifold for
`ModelWithCorners.pi`. Where each `S_i` is differentiable at `(q_i, q_(i+1))`, its differential is

`dA_q(v) = Σ_i (d₁S_i(q_i, q_(i+1)) + d₂S_(i-1)(q_(i-1), q_i)) (v_i)`

(`TauCeti.mvfderiv_cyclicAction_apply`). So `q` is a critical point of `A` exactly when at every
vertex the outgoing covector of edge `i - 1` equals the incoming covector of edge `i`,
`-d₂S_(i-1)(q_(i-1), q_i) = d₁S_i(q_i, q_(i+1))`; equivalently, the target point of the relation
of `S_(i-1)` over `(q_(i-1), q_i)` is the source point of the relation of `S_i` over
`(q_i, q_(i+1))` (`TauCeti.CotangentBundle.mvfderiv_cyclicAction_eq_zero_iff`).

Suppose now that, over a set `W_i ⊆ Q × Q`, the relation of `S_i` is the graph of a map `φ_i`
defined on a set `D_i` of covectors: every `z ∈ D_i` has its base pair `(π z, π (φ_i z))` in `W_i`
and `(z, φ_i z)` is the point of the relation over it, and every point of `W_i` is such a base
pair. Then the **chain dictionary** (`TauCeti.CotangentBundle.exists_equiv_periodic_of_generating`)
identifies the cyclic sequences `z_i`, `i ∈ ℤ/N`, with `z_i ∈ D_i` and `φ_i(z_i) = z_(i+1)`, that
is, the phase points fixed by `φ_(N-1) ∘ ⋯ ∘ φ_0` together with their intermediate states, with
the critical points of `A` on the configuration domain `{q | ∀ i, (q_i, q_(i+1)) ∈ W_i}`. The
bijection sends a sequence to its base points, and a critical configuration to the source points
`(q_i, d₁S_i(q_i, q_(i+1)))`. It uses neither finite dimension, nor a boundaryless model, nor the
symplecticity or smoothness of the maps `φ_i`. With equal summands `S_i = S` it identifies the
marked `N`-periodic points of a generated map, with all intermediate iterates defined, with the
critical points of `Σ_i S(q_i, q_(i+1))`.

With a single vertex, the differential of `ψ(q) = S(q, q)` is `d₁S(q, q) + d₂S(q, q)`
(`TauCeti.mvfderiv_diag_eq_add`), and the dictionary identifies the fixed points of a map
generated by `S` with the critical points of `ψ`
(`TauCeti.CotangentBundle.exists_equiv_fixedPoints_of_generating`).

## References

* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Section 5.1 (periodic points), Propositions 5.1 and 5.2.
-/

public section

noncomputable section

open Bundle Manifold
open scoped Manifold ContDiff

namespace TauCeti

variable {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {Q : Type*} [TopologicalSpace Q] [ChartedSpace H Q]
  {N : ℕ} [NeZero N]

/-- The **cyclic discrete action** `A(q) = Σ_i S_i(q_i, q_(i+1))` of a family of functions
`S_i : Q × Q → ℝ` indexed by `ℤ/N`, on configurations `q : ℤ/N → Q`. -/
def cyclicAction (S : ZMod N → Q × Q → ℝ) (q : ZMod N → Q) : ℝ :=
  ∑ i, S i (q i, q (i + 1))

omit [TopologicalSpace Q] in
/-- The cyclic discrete action is the sum of the generating functions over the edges. -/
theorem cyclicAction_apply (S : ZMod N → Q × Q → ℝ) (q : ZMod N → Q) :
    cyclicAction S q = ∑ i, S i (q i, q (i + 1)) :=
  (rfl)

/-- The edge `(q_i, q_(i+1))` of a configuration has derivative `v ↦ (v_i, v_(i+1))`. -/
private theorem hasMFDerivAt_edge (i : ZMod N) (q : ZMod N → Q) :
    HasMFDerivAt (ModelWithCorners.pi fun _ : ZMod N ↦ I) (I.prod I)
      (fun q : ZMod N → Q ↦ (q i, q (i + 1))) q
      ((ContinuousLinearMap.proj i).prod (ContinuousLinearMap.proj (i + 1))) :=
  (hasMFDerivAt_apply (M := fun _ : ZMod N ↦ Q) i q).prodMk
    (hasMFDerivAt_apply (M := fun _ : ZMod N ↦ Q) (i + 1) q)

/-- **The differential of the cyclic discrete action.** If each `S_i` is differentiable at the
edge `(q_i, q_(i+1))`, the differential of `A` at `q` pairs a tangent vector `v` with
`Σ_i (d₁S_i(q_i, q_(i+1)) + d₂S_(i-1)(q_(i-1), q_i)) (v_i)`. -/
theorem mvfderiv_cyclicAction_apply {S : ZMod N → Q × Q → ℝ} {q : ZMod N → Q}
    (hS : ∀ i, MDifferentiableAt (I.prod I) 𝓘(ℝ) (S i) (q i, q (i + 1)))
    (v : ZMod N → E) :
    mvfderiv (ModelWithCorners.pi fun _ : ZMod N ↦ I) (cyclicAction S) q v =
      ∑ i, (mvfderiv I (fun x ↦ S i (x, q (i + 1))) (q i) (v i) +
        mvfderiv I (fun x ↦ S (i - 1) (q (i - 1), x)) (q i) (v i)) := by
  -- Each summand of `A` is `S_i` composed with the edge map, whose differential is
  -- `v ↦ (v_i, v_(i+1))`.
  have hfun : cyclicAction S =
      fun q' ↦ ∑ i, (S i ∘ fun q : ZMod N → Q ↦ (q i, q (i + 1))) q' := by
    ext q'
    simp [cyclicAction_apply]
  have hd : mvfderiv (ModelWithCorners.pi fun _ : ZMod N ↦ I) (cyclicAction S) q v =
      ∑ i, mvfderiv (I.prod I) (S i) (q i, q (i + 1)) (v i, v (i + 1)) := by
    rw [hfun, mvfderiv_fun_sum fun i _ ↦
      (hS i).comp q (hasMFDerivAt_edge (I := I) i q).mdifferentiableAt]
    refine (sum_apply (F := (ZMod N → E) →L[ℝ] ℝ) Finset.univ _ v).trans
      (Finset.sum_congr rfl fun i _ ↦ ?_)
    refine (mvfderiv_comp_apply q (hS i) (hasMFDerivAt_edge (I := I) i q).mdifferentiableAt
      v).trans ?_
    rw [(hasMFDerivAt_edge (I := I) i q).mfderiv]
    -- The differential `(proj i).prod (proj (i + 1))` of the edge map sends `v` to
    -- `(v i, v (i + 1))`; `simp` cannot rewrite it across the tangent-space type synonyms.
    exact congrArg _ (ContinuousLinearMap.prod_apply _ _ v)
  -- Split each derivative of `S_i` into its two partial derivatives, then shift the index of the
  -- second partial derivative by one.
  rw [hd]
  calc ∑ i, mvfderiv (I.prod I) (S i) (q i, q (i + 1)) (v i, v (i + 1))
      = ∑ i, (mvfderiv I (fun x ↦ S i (x, q (i + 1))) (q i) (v i) +
          mvfderiv I (fun x ↦ S i (q i, x)) (q (i + 1)) (v (i + 1))) :=
        Finset.sum_congr rfl fun i _ ↦ (hS i).mvfderiv_prod_eq_add_apply (v i, v (i + 1))
    _ = _ := by
        rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
        congr 1
        refine Fintype.sum_equiv (Equiv.addRight 1) _ _ fun i ↦ ?_
        dsimp only [Equiv.coe_addRight]
        simp only [add_sub_cancel_right]

namespace CotangentBundle

/-- **Critical points of the cyclic discrete action.** If each `S_i` is differentiable at the
edge `(q_i, q_(i+1))`, then `q` is a critical point of `A(q) = Σ_i S_i(q_i, q_(i+1))` exactly
when at every vertex the outgoing covector of edge `i - 1` equals the incoming covector of edge
`i`: the target point `(q_i, -d₂S_(i-1)(q_(i-1), q_i))` of the relation generated by `S_(i-1)`
is the source point `(q_i, d₁S_i(q_i, q_(i+1)))` of the relation generated by `S_i`. -/
theorem mvfderiv_cyclicAction_eq_zero_iff {S : ZMod N → Q × Q → ℝ} {q : ZMod N → Q}
    (hS : ∀ i, MDifferentiableAt (I.prod I) 𝓘(ℝ) (S i) (q i, q (i + 1))) :
    mvfderiv (ModelWithCorners.pi fun _ : ZMod N ↦ I) (cyclicAction S) q = 0 ↔
      ∀ i, generatingTarget I (S (i - 1)) (q (i - 1), q i) =
        generatingSource I (S i) (q i, q (i + 1)) := by
  have key (i : ZMod N) : generatingTarget I (S (i - 1)) (q (i - 1), q i) =
      generatingSource I (S i) (q i, q (i + 1)) ↔
        mvfderiv I (fun x ↦ S i (x, q (i + 1))) (q i) +
          mvfderiv I (fun x ↦ S (i - 1) (q (i - 1), x)) (q i) = 0 := by
    rw [generatingTarget_eq_generatingSource_iff, neg_eq_iff_add_eq_zero, add_comm]
  simp only [key]
  constructor
  · -- Test the vanishing differential on tangent vectors supported at a single vertex. The
    -- covectors are read in `E →L[ℝ] ℝ`, the common type of the cotangent spaces of `Q`.
    have hsingle {A B : ZMod N → E →L[ℝ] ℝ}
        (hAB : ∀ v : ZMod N → E, ∑ i, (A i (v i) + B i (v i)) = 0) (i : ZMod N) :
        A i + B i = 0 := by
      ext w
      have hi := hAB (Pi.single i w)
      rw [Fintype.sum_eq_single i fun j hj ↦ by simp [Pi.single_eq_of_ne hj]] at hi
      simpa using hi
    intro h
    exact hsingle fun v ↦ (mvfderiv_cyclicAction_apply hS v).symm.trans (by rw [h]; rfl)
  · intro h
    refine ContinuousLinearMap.ext fun v : ZMod N → E ↦ ?_
    rw [mvfderiv_cyclicAction_apply hS]
    refine (Finset.sum_eq_zero fun i _ ↦ ?_).trans rfl
    -- Evaluate the matching equation at vertex `i` on the component `v_i`.
    exact (add_apply (mvfderiv I (fun x ↦ S i (x, q (i + 1))) (q i))
      (mvfderiv I (fun x ↦ S (i - 1) (q (i - 1), x)) (q i)) (v i)).symm.trans
        ((congrArg (fun L ↦ L (v i)) (h i)).trans
          (zero_apply (F := TangentSpace I (q i) →L[ℝ] ℝ) (v i)))

/-- **The chain dictionary.** Let `S_i`, `i ∈ ℤ/N`, be real functions on `Q × Q`, differentiable on
sets `W_i`, and suppose that over `W_i` the cotangent relation generated by `S_i` is the graph of
a map `φ_i` defined on a set `D_i` of covectors: every `z ∈ D_i` has its base pair
`(π z, π (φ_i z))` in `W_i`, with `(z, φ_i z)` the point of the relation over it, and every point
of `W_i` is such a base pair. Then taking base points is a bijection from the cyclic sequences
`z_i ∈ D_i` with `φ_i(z_i) = z_(i+1)`, the periodic chains of the `φ_i`, onto the critical points
of the cyclic action `Σ_i S_i(q_i, q_(i+1))` on the configurations with every edge
`(q_i, q_(i+1))` in `W_i`. Its inverse sends a critical configuration to the source points
`(q_i, d₁S_i(q_i, q_(i+1)))`. -/
theorem exists_equiv_periodic_of_generating {S : ZMod N → Q × Q → ℝ} {W : ZMod N → Set (Q × Q)}
    {D : ZMod N → Set (CotangentBundle I Q)}
    {φ : ZMod N → CotangentBundle I Q → CotangentBundle I Q}
    (hS : ∀ i, ∀ x ∈ W i, MDifferentiableAt (I.prod I) 𝓘(ℝ) (S i) x)
    (hD : ∀ i, ∀ z ∈ D i, (z.proj, (φ i z).proj) ∈ W i ∧
      generatingCorrespondence I I (S i) (z.proj, (φ i z).proj) = (z, φ i z))
    (hW : ∀ i, ∀ x ∈ W i, ∃ z ∈ D i, (z.proj, (φ i z).proj) = x) :
    ∃ e : {z : ZMod N → CotangentBundle I Q // ∀ i, z i ∈ D i ∧ φ i (z i) = z (i + 1)} ≃
        {q : ZMod N → Q // (∀ i, (q i, q (i + 1)) ∈ W i) ∧
          mvfderiv (ModelWithCorners.pi fun _ : ZMod N ↦ I) (cyclicAction S) q = 0},
      (∀ z i, (e z : ZMod N → Q) i = (z.1 i).proj) ∧
        ∀ q i, (e.symm q : ZMod N → CotangentBundle I Q) i =
          generatingSource I (S i) (q.1 i, q.1 (i + 1)) := by
  -- Along a periodic chain, each state is the source point and the next state the target point
  -- of the relation over the base pair of consecutive states.
  have hchain (z : ZMod N → CotangentBundle I Q) (hz : ∀ i, z i ∈ D i ∧ φ i (z i) = z (i + 1))
      (i : ZMod N) : ((z i).proj, (z (i + 1)).proj) ∈ W i ∧
        generatingSource I (S i) ((z i).proj, (z (i + 1)).proj) = z i ∧
        generatingTarget I (S i) ((z i).proj, (z (i + 1)).proj) = z (i + 1) := by
    have h := hD i _ (hz i).1
    rw [(hz i).2, generatingCorrespondence_apply, Prod.mk.injEq] at h
    exact ⟨h.1, h.2⟩
  -- Over each edge of a configuration in the domain, the source point lies in `D_i` and `φ_i`
  -- sends it to the target point.
  have hedge (i : ZMod N) (x : Q × Q) (hx : x ∈ W i) :
      generatingSource I (S i) x ∈ D i ∧
        φ i (generatingSource I (S i) x) = generatingTarget I (S i) x := by
    obtain ⟨z, hz, rfl⟩ := hW i x hx
    have h := (hD i z hz).2
    rw [generatingCorrespondence_apply, Prod.mk.injEq] at h
    rw [h.1, h.2]
    exact ⟨hz, rfl⟩
  refine ⟨
    { toFun := fun z ↦ ⟨fun i ↦ (z.1 i).proj, fun i ↦ (hchain z.1 z.2 i).1,
        (mvfderiv_cyclicAction_eq_zero_iff fun i ↦ hS i _ (hchain z.1 z.2 i).1).2 fun i ↦ by
          have h := (hchain z.1 z.2 (i - 1)).2.2
          rw [sub_add_cancel] at h
          rw [h, (hchain z.1 z.2 i).2.1]⟩
      invFun := fun q ↦ ⟨fun i ↦ generatingSource I (S i) (q.1 i, q.1 (i + 1)), fun i ↦ by
        refine ⟨(hedge i _ (q.2.1 i)).1, (hedge i _ (q.2.1 i)).2.trans ?_⟩
        have h := (mvfderiv_cyclicAction_eq_zero_iff fun i ↦ hS i _ (q.2.1 i)).1 q.2.2 (i + 1)
        rwa [add_sub_cancel_right] at h⟩
      left_inv := fun z ↦ Subtype.ext <| funext fun i ↦ (hchain z.1 z.2 i).2.1
      right_inv := fun q ↦ Subtype.ext <| funext fun i ↦ proj_generatingSource _ },
    fun _ _ ↦ rfl, fun _ _ ↦ rfl⟩

/-- **Fixed points and critical points.** Suppose that over a set `W ⊆ Q × Q`, on which `S` is
differentiable, the cotangent relation generated by `S` is the graph of a map `φ` defined on a set
`D` of covectors, as in `exists_equiv_periodic_of_generating`. Then taking base points is a
bijection from the fixed points of `φ` in `D` onto the critical points of `ψ(q) = S(q, q)` on
`{q | (q, q) ∈ W}`, with inverse `q ↦ (q, d₁S(q, q))`. This is the chain dictionary with a single
vertex. -/
theorem exists_equiv_fixedPoints_of_generating {S : Q × Q → ℝ} {W : Set (Q × Q)}
    {D : Set (CotangentBundle I Q)} {φ : CotangentBundle I Q → CotangentBundle I Q}
    (hS : ∀ x ∈ W, MDifferentiableAt (I.prod I) 𝓘(ℝ) S x)
    (hD : ∀ z ∈ D, (z.proj, (φ z).proj) ∈ W ∧
      generatingCorrespondence I I S (z.proj, (φ z).proj) = (z, φ z))
    (hW : ∀ x ∈ W, ∃ z ∈ D, (z.proj, (φ z).proj) = x) :
    ∃ e : {z : CotangentBundle I Q // z ∈ D ∧ φ z = z} ≃
        {q : Q // (q, q) ∈ W ∧ mvfderiv I (fun x ↦ S (x, x)) q = 0},
      (∀ z, (e z : Q) = z.1.proj) ∧
        ∀ q, (e.symm q : CotangentBundle I Q) = generatingSource I S (q.1, q.1) := by
  obtain ⟨e, he, he'⟩ := exists_equiv_periodic_of_generating (N := 1) (S := fun _ ↦ S)
    (W := fun _ ↦ W) (D := fun _ ↦ D) (φ := fun _ ↦ φ) (fun _ ↦ hS) (fun _ ↦ hD) (fun _ ↦ hW)
  -- On `ℤ/1` every index is `0`; in particular `0 + 1 = 0`.
  have h1 : (0 : ZMod 1) + 1 = 0 := Subsingleton.elim _ _
  -- A constant configuration is critical for the cyclic action exactly when its value is
  -- critical for `ψ`: both say that the target and source points over `(q, q)` agree.
  have hcrit (q : Q) (hq : (q, q) ∈ W) :
      mvfderiv (ModelWithCorners.pi fun _ : ZMod 1 ↦ I) (cyclicAction (N := 1) fun _ ↦ S)
          (fun _ ↦ q) = 0 ↔ mvfderiv I (fun x ↦ S (x, x)) q = 0 := by
    rw [mvfderiv_cyclicAction_eq_zero_iff (N := 1) (S := fun _ ↦ S) (q := fun _ ↦ q)
        fun _ ↦ hS _ hq, mvfderiv_diag_eq_add (hS _ hq),
      add_comm, ← neg_eq_iff_add_eq_zero]
    simp only [generatingTarget_eq_generatingSource_iff, forall_const]
  let e₁ : {z : CotangentBundle I Q // z ∈ D ∧ φ z = z} ≃
      {z : ZMod 1 → CotangentBundle I Q // ∀ i, z i ∈ D ∧ φ (z i) = z (i + 1)} :=
    { toFun := fun z ↦ ⟨fun _ ↦ z.1, fun _ ↦ z.2⟩
      invFun := fun z ↦ ⟨z.1 0, by simpa only [h1] using z.2 0⟩
      left_inv := fun _ ↦ rfl
      right_inv := fun z ↦ Subtype.ext <| funext fun i ↦ congrArg z.1 (Subsingleton.elim 0 i) }
  let e₂ : {q : ZMod 1 → Q // (∀ i, (q i, q (i + 1)) ∈ W) ∧
        mvfderiv (ModelWithCorners.pi fun _ : ZMod 1 ↦ I) (cyclicAction (N := 1) fun _ ↦ S) q = 0} ≃
      {q : Q // (q, q) ∈ W ∧ mvfderiv I (fun x ↦ S (x, x)) q = 0} :=
    { toFun := fun q ↦ ⟨q.1 0, by simpa only [h1] using q.2.1 0, by
        have hq : (q.1 0, q.1 0) ∈ W := by simpa only [h1] using q.2.1 0
        have hq' : (fun _ ↦ q.1 0) = q.1 := funext fun i ↦ congrArg q.1 (Subsingleton.elim 0 i)
        rw [← hcrit _ hq, hq']
        exact q.2.2⟩
      invFun := fun q ↦ ⟨fun _ ↦ q.1, fun _ ↦ q.2.1, (hcrit _ q.2.1).2 q.2.2⟩
      left_inv := fun q ↦ Subtype.ext <| funext fun i ↦ congrArg q.1 (Subsingleton.elim 0 i)
      right_inv := fun _ ↦ rfl }
  exact ⟨e₁.trans (e.trans e₂), fun z ↦ he _ 0, fun q ↦ he' _ 0⟩

end CotangentBundle

end TauCeti
