/-!
# The local canonical transformation generated by a function on a product of manifolds

A smooth real function `S(q, Q)` on a product `M × N` of manifolds generates the Lagrangian
correspondence `p = d_q S`, `P = -d_Q S` between `T*M` and `T*N`, parametrized by `(q, Q)` through
its source projection `src (q, Q) = (q, d_q S)` and its target projection
`tgt (q, Q) = (Q, -d_Q S)` (`TauCeti.CotangentBundle.generatingCorrespondence`). This file shows
that where the mixed Hessian `d_Q (d_q S)` (`TauCeti.mixedHessian`) is invertible, the
correspondence is the graph of a local symplectomorphism `φ` of cotangent bundles, with `S` as its
primitive. This is the manifold version of `TauCeti.cotangentGeneratedMap` on normed spaces.

* **The differential of the source projection.** It keeps the base coordinate, and on the second
  factor it is the mixed Hessian, a vertical covector
  (`TauCeti.CotangentBundle.fst_comp_mfderiv_generatingSource`,
  `TauCeti.CotangentBundle.mfderiv_generatingSource_comp_inr`). So it is block triangular, and
  invertible exactly when the mixed Hessian is
  (`TauCeti.CotangentBundle.isInvertible_mfderiv_generatingSource_iff`). By the inverse function
  theorem, the source projection is a local diffeomorphism at an interior point exactly when the
  mixed Hessian there is invertible
  (`TauCeti.CotangentBundle.isLocalDiffeomorphAt_generatingSource_iff`).
* **Every local branch generates a canonical transformation.** Let `β` be a local right inverse of
  the source projection near a covector `z`, differentiable at `z`. Then `φ = tgt ∘ β` pulls the
  canonical form `ω_N` back to `ω_M` at `z`
  (`TauCeti.CotangentBundle.mpullback_generatingTarget_comp_symplecticForm`), and
  `λ_M - φ^*λ_N = d(S ∘ β)` at `z`
  (`TauCeti.CotangentBundle.liouvilleForm_sub_mpullback_generatingTarget_comp`). Both follow by
  pulling the corresponding identities of the generated correspondence back along `β`: near `z`
  the correspondence composed with `β` is the graph of `φ`.
* **The generated map.** For finite-dimensional boundaryless `M` and `N` and an invertible mixed
  Hessian at `x`, an invertible mixed Hessian identifies `T_Q N` with the dual of `T_q M`, so the
  two cotangent bundles have the same dimension and the target projection is a local
  diffeomorphism at `x` as well (`TauCeti.CotangentBundle.isLocalDiffeomorphAt_generatingTarget`).
  The **branch** `TauCeti.CotangentBundle.generatingBranch` is the local inverse of the source
  projection through `x`. It is unique as a germ: every continuous local right inverse of the
  source projection through `x` agrees with it near `src x`
  (`TauCeti.CotangentBundle.eventuallyEq_generatingBranch`). The **generated map**
  `TauCeti.CotangentBundle.generatedMap` is the partial diffeomorphism `tgt ∘ branch`, between an
  open neighbourhood of `src x` in `T*M` and an open subset of `T*N`. Near `x` its graph is the
  generated correspondence (`TauCeti.CotangentBundle.eventually_generatedMap_generatingSource`).
  At every point of its source it preserves the canonical symplectic form
  (`TauCeti.CotangentBundle.mpullback_generatedMap_symplecticForm`) and satisfies
  `λ_M - φ^*λ_N = d(S ∘ branch)`
  (`TauCeti.CotangentBundle.liouvilleForm_sub_mpullback_generatedMap`).

No global canonical transformation is asserted: the branch and the generated map are local near
the chosen point.

## References

* V. I. Arnold, *Mathematical Methods of Classical Mechanics*, second edition, Springer, 1989,
  §48 (generating functions).
* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Section 4 (generating functions).
-/

public section

noncomputable section

open Bundle Filter Manifold Module Set
open scoped Manifold ContDiff Topology

namespace TauCeti.CotangentBundle

variable {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  {F H' : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [TopologicalSpace H']
  {J : ModelWithCorners ℝ F H'} {N : Type*} [TopologicalSpace N] [ChartedSpace H' N]
  {S : M × N → ℝ} [IsManifold I ∞ M] [IsManifold J ∞ N]

/-! ### The differential of the source projection -/

section Differential

/-- The differential of the source projection keeps the base coordinate: the source projection
lies over the first projection of `M × N`. -/
theorem fst_comp_mfderiv_generatingSource (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S) (x : M × N) :
    ContinuousLinearMap.fst ℝ E (E →L[ℝ] ℝ) ∘L
        mfderiv (I.prod J) (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (generatingSource I S) x =
      ContinuousLinearMap.fst ℝ E F := by
  have hcomp := mfderiv_comp x
    ((contMDiff_proj (fun y : M ↦ TangentSpace I y →L[ℝ] ℝ) _).mdifferentiableAt one_ne_zero)
    ((contMDiff_generatingSource hS x).mdifferentiableAt (by simp))
  have hπ : π (E →L[ℝ] ℝ) (fun y : M ↦ TangentSpace I y →L[ℝ] ℝ) ∘ generatingSource I S =
      Prod.fst :=
    funext proj_generatingSource
  rw [hπ, Bundle.mfderiv_proj, mfderiv_fst] at hcomp
  exact hcomp.symm

/-- **The differential of the source projection on the second factor is the mixed Hessian.** A
tangent vector `w` at `Q` is sent to the vertical covector `d_Q (d_q S) w` at `q`, read in the
preferred chart at the source point. -/
theorem mfderiv_generatingSource_comp_inr (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S) (x : M × N) :
    mfderiv (I.prod J) (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (generatingSource I S) x ∘L
        ContinuousLinearMap.inr ℝ E F =
      ContinuousLinearMap.inr ℝ E (E →L[ℝ] ℝ) ∘L mixedHessian I J S x := by
  obtain ⟨q, Q⟩ := x
  -- On the slice through `q`, the source projection is `Q' ↦ (q, D Q')`, a map into the fibre
  -- over `q`, where `D Q' = d_q S(·, Q')` has derivative the mixed Hessian at `Q`.
  set D : N → E →L[ℝ] ℝ := fun Q' ↦ mvfderiv I (fun q' ↦ S (q', Q')) q
  have hD : MDifferentiableAt J 𝓘(ℝ, E →L[ℝ] ℝ) D Q :=
    (Manifold.contMDiffAt_mvfderiv_of_contMDiffAt_uncurry (n := ∞) (m := 1)
      (G := fun Q' q' ↦ S (q', Q')) ((hS.comp (contMDiff_snd.prodMk contMDiff_fst)) (Q, q))
      (by simp)).mdifferentiableAt one_ne_zero
  have hfun : generatingSource I S ∘ (fun Q' ↦ (q, Q')) =
      fun Q' ↦ TotalSpace.mk' (E →L[ℝ] ℝ) (E := fun x : M ↦ TangentSpace I x →L[ℝ] ℝ) q (D Q') :=
    funext fun Q' ↦ CotangentBundle.ext (proj_generatingSource (q, Q')) fun v ↦ by
      rw [Function.comp_apply, generatingSource_snd]
      -- Both sides are `d_q S(·, Q')` at `q`: the right one is `D Q'` by definition of `D`.
      rfl
  have h₁ := hasMFDerivAt_mk (I := I) q hD.hasMFDerivAt
  rw [← hfun] at h₁
  have hslice : HasMFDerivAt J (I.prod J) (fun Q' ↦ (q, Q')) Q (ContinuousLinearMap.inr ℝ E F) := by
    have h := (mdifferentiableAt_const.prodMk mdifferentiableAt_id :
      MDifferentiableAt J (I.prod J) (fun Q' : N ↦ (q, Q')) Q).hasMFDerivAt
    rwa [mfderiv_prod_right] at h
  have h₂ := ((contMDiff_generatingSource hS (q, Q)).mdifferentiableAt
    (by simp)).hasMFDerivAt.comp Q hslice
  -- The mixed Hessian is `mvfderiv J D Q`, the derivative of `D` read in its model space.
  have hH : mfderiv J 𝓘(ℝ, E →L[ℝ] ℝ) D Q = mixedHessian I J S (q, Q) :=
    ContinuousLinearMap.ext fun w ↦ (mvfderiv_apply_eq_mfderiv_apply D Q w).symm.trans
      (DFunLike.congr_fun (mixedHessian_def S (q, Q)) w).symm
  rw [← hH]
  exact (HasMFDerivAt.mfderiv h₂).symm.trans h₁.mfderiv

/-- **The differential of the source projection is invertible exactly where the mixed Hessian
is.** In the preferred charts the differential is block triangular, keeping the base coordinate
and acting on the second factor by the mixed Hessian. The argument is that of
`TauCeti.isInvertible_mfderiv_legendreMap_iff` for the Legendre map. -/
theorem isInvertible_mfderiv_generatingSource_iff (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S)
    (x : M × N) :
    (mfderiv (I.prod J) (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (generatingSource I S) x).IsInvertible ↔
      (mixedHessian I J S x).IsInvertible := by
  -- Read the differential as a map between the model spaces of the charts.
  obtain ⟨T, hT⟩ : ∃ T : E × F →L[ℝ] E × (E →L[ℝ] ℝ),
      mfderiv (I.prod J) (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (generatingSource I S) x = T := ⟨_, rfl⟩
  have hfst : ContinuousLinearMap.fst ℝ E (E →L[ℝ] ℝ) ∘L T = ContinuousLinearMap.fst ℝ E F :=
    hT ▸ fst_comp_mfderiv_generatingSource hS x
  have hblock : ContinuousLinearMap.snd ℝ E (E →L[ℝ] ℝ) ∘L T ∘L ContinuousLinearMap.inr ℝ E F =
      mixedHessian I J S x := by
    have hcomp : T ∘L ContinuousLinearMap.inr ℝ E F =
        ContinuousLinearMap.inr ℝ E (E →L[ℝ] ℝ) ∘L mixedHessian I J S x :=
      hT ▸ mfderiv_generatingSource_comp_inr hS x
    exact ContinuousLinearMap.ext fun w ↦ congrArg Prod.snd (DFunLike.congr_fun hcomp w)
  rw [hT]
  refine (ContinuousLinearMap.isInvertible_iff_of_fst_comp_eq hfst).trans ?_
  rw [hblock]
  -- The two sides differ only in reading `T_Q N` as its model space `F`.
  exact Iff.rfl

variable [CompleteSpace E] [CompleteSpace F] in
/-- **The source projection is a local diffeomorphism exactly where the mixed Hessian is
invertible.** At an interior point `x` of `M × N`, the source projection `(q, Q) ↦ (q, d_q S)`
of the relation generated by a smooth `S` is a smooth local diffeomorphism at `x` exactly when
the mixed Hessian of `S` at `x` is invertible. -/
theorem isLocalDiffeomorphAt_generatingSource_iff (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S)
    {x : M × N} (hx : (I.prod J).IsInteriorPoint x) :
    IsLocalDiffeomorphAt (I.prod J) (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) ∞ (generatingSource I S) x ↔
      (mixedHessian I J S x).IsInvertible := by
  rw [← isInvertible_mfderiv_generatingSource_iff hS x]
  exact isLocalDiffeomorphAt_iff_exists_mfderiv_eq (contMDiff_generatingSource hS).contMDiffOn
    isOpen_univ (mem_univ x) hx (by simp)

end Differential

/-! ### Local branches of the source projection -/

section Branch

variable {β : CotangentBundle I M → M × N} {z : CotangentBundle I M}

/-- **`S` is the primitive of the map generated through any branch.** If `β` is a right inverse of
the source projection near `z`, differentiable at `z`, then `φ = tgt ∘ β` satisfies
`λ_M - φ^*λ_N = d(S ∘ β)` at `z`. -/
theorem liouvilleForm_sub_mpullback_generatingTarget_comp (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S)
    (hβ : MDifferentiableAt (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (I.prod J) β z)
    (hsrc : ∀ᶠ z' in 𝓝 z, generatingSource I S (β z') = z') :
    (liouvilleForm I M).1 z -
        mpullback (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (J.prod 𝓘(ℝ, F →L[ℝ] ℝ)) (generatingTarget J S ∘ β)
          (liouvilleForm J N).1 z =
      mextDeriv (RoughForm.ofFunction (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (S ∘ β)) z := by
  have hcorr := (contMDiff_generatingCorrespondence hS (β z)).mdifferentiableAt (by simp)
  have htgt : MDifferentiableAt (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (J.prod 𝓘(ℝ, F →L[ℝ] ℝ))
      (generatingTarget J S ∘ β) z :=
    ((contMDiff_generatingTarget hS (β z)).mdifferentiableAt (by simp)).comp z hβ
  -- Pull the exactness of the generated relation back along `β`.
  have key := congrArg (fun α ↦ mpullback (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (I.prod J) β α z)
    (mpullback_generatingCorrespondence_liouvilleForm hS)
  rw [← mpullback_comp_at hβ hcorr, mpullback_mextDeriv_ofFunction_apply hβ
    ((hS (β z)).mdifferentiableAt (by simp))] at key
  -- Near `z` the relation along `β` is the graph of `tgt ∘ β`.
  have hgraph : generatingCorrespondence I J S ∘ β =ᶠ[𝓝 z]
      fun z' ↦ (z', (generatingTarget J S ∘ β) z') :=
    hsrc.mono fun z' h ↦ by rw [Function.comp_apply, generatingCorrespondence_apply, h]; rfl
  rwa [hgraph.mpullback_eq, SmoothForm.mpullback_graph_mpullback_fst_sub_mpullback_snd _ _ htgt]
    at key

/-- **The map generated through any branch is symplectic.** If `β` is a right inverse of the
source projection near `z`, differentiable at `z`, then `φ = tgt ∘ β` pulls the canonical
symplectic form `ω_N` back to `ω_M` at `z`. -/
theorem mpullback_generatingTarget_comp_symplecticForm (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S)
    (hβ : MDifferentiableAt (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (I.prod J) β z)
    (hsrc : ∀ᶠ z' in 𝓝 z, generatingSource I S (β z') = z') :
    mpullback (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (J.prod 𝓘(ℝ, F →L[ℝ] ℝ)) (generatingTarget J S ∘ β)
        (symplecticForm J N).1 z = (symplecticForm I M).1 z := by
  have hcorr := (contMDiff_generatingCorrespondence hS (β z)).mdifferentiableAt (by simp)
  have htgt : MDifferentiableAt (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (J.prod 𝓘(ℝ, F →L[ℝ] ℝ))
      (generatingTarget J S ∘ β) z :=
    ((contMDiff_generatingTarget hS (β z)).mdifferentiableAt (by simp)).comp z hβ
  -- The generated relation is exact, hence isotropic, so it pulls the twisted product back to
  -- zero.
  have hiso := (SmoothTwoForm.IsNondegenerate.isIsotropicMap_iff_mpullback_eq_zero
    (contMDiff_generatingCorrespondence hS)).1
    (SmoothTwoForm.IsNondegenerate.isIsotropicMap_of_mpullback_eq_mextDeriv
      (hσ := (isSymplectic_symplecticForm (I := I) (M := M)).isNondegenerate.twistedProd
        (isSymplectic_symplecticForm (I := J) (M := N)).isNondegenerate)
      (twistedProd_symplecticForm I M J N) (contMDiff_generatingCorrespondence hS)
      (hS.of_le (by simp)) (mpullback_generatingCorrespondence_liouvilleForm hS))
  have key := congrArg (fun α ↦ mpullback (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (I.prod J) β α.1 z) hiso
  simp only [SmoothForm.coe_mpullback] at key
  rw [← mpullback_comp_at hβ hcorr] at key
  -- Near `z` the relation along `β` is the graph of `tgt ∘ β`.
  have hgraph : generatingCorrespondence I J S ∘ β =ᶠ[𝓝 z]
      fun z' ↦ (z', (generatingTarget J S ∘ β) z') :=
    hsrc.mono fun z' h ↦ by rw [Function.comp_apply, generatingCorrespondence_apply, h]; rfl
  rw [hgraph.mpullback_eq, SmoothTwoForm.twistedProd_def,
    SmoothForm.mpullback_graph_mpullback_fst_sub_mpullback_snd _ _ htgt, ZeroMemClass.coe_zero,
    mpullback_zero, Pi.zero_apply, sub_eq_zero] at key
  exact key.symm

end Branch

/-! ### The generated map -/

section Generated

variable [FiniteDimensional ℝ E] [FiniteDimensional ℝ F] [BoundarylessManifold I M]
  [BoundarylessManifold J N] {x : M × N}

/-- **The target projection is a local diffeomorphism where the mixed Hessian is invertible.**
The invertible mixed Hessian makes `T*M` and `T*N` of the same dimension, and along the isotropic
generated relation, the target projection is a local diffeomorphism wherever the source projection
is. -/
theorem isLocalDiffeomorphAt_generatingTarget (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S)
    (hx : (mixedHessian I J S x).IsInvertible) :
    IsLocalDiffeomorphAt (I.prod J) (J.prod 𝓘(ℝ, F →L[ℝ] ℝ)) ∞ (generatingTarget J S) x := by
  obtain ⟨e, he⟩ := hx
  -- The invertible mixed Hessian identifies `T_Q N` with the dual of `T_q M`.
  have hEF : finrank ℝ (E × (E →L[ℝ] ℝ)) = finrank ℝ (F × (F →L[ℝ] ℝ)) := by
    have h : finrank ℝ F = finrank ℝ E :=
      e.toLinearEquiv.finrank_eq.trans ContinuousLinearMap.dual_finrank_eq
    simp only [finrank_prod, ContinuousLinearMap.dual_finrank_eq, h]
  -- The generated relation, the pair of the two projections, is isotropic.
  have hiso := SmoothTwoForm.IsNondegenerate.isIsotropicMap_iff_forall.1
    (isExactLagrangianMap_generatingCorrespondence hS).isLagrangianMap.isIsotropicMap x
  rw [show generatingCorrespondence I J S = fun y ↦ (generatingSource I S y, generatingTarget J S y)
    from funext generatingCorrespondence_apply] at hiso
  exact SmoothTwoForm.IsNondegenerate.isLocalDiffeomorphAt_of_isIsotropic
    (isSymplectic_symplecticForm (I := I) (M := M)).isNondegenerate
    (isSymplectic_symplecticForm (I := J) (M := N)).isNondegenerate hEF
    hiso
    ((isLocalDiffeomorphAt_generatingSource_iff hS BoundarylessManifold.isInteriorPoint).2
      ⟨e, he⟩)
    (contMDiff_generatingTarget hS).contMDiffOn isOpen_univ (mem_univ x)
    BoundarylessManifold.isInteriorPoint

variable (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S) (hx : (mixedHessian I J S x).IsInvertible)

/-- The **branch of the relation generated by `S`** through `x`: a local inverse of the source
projection `(q, Q) ↦ (q, d_q S)` near `(q₀, d_q S(q₀, Q₀))`, which exists because the mixed Hessian
at `x = (q₀, Q₀)` is invertible. It is unique as a germ
(`TauCeti.CotangentBundle.eventuallyEq_generatingBranch`). -/
def generatingBranch :
    PartialDiffeomorph (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (I.prod J) (CotangentBundle I M) (M × N) ∞ :=
  ((isLocalDiffeomorphAt_generatingSource_iff hS BoundarylessManifold.isInteriorPoint).2
    hx).localInverse

/-- The **map generated by `S`** near `x`: the local canonical transformation `(q, p) ↦ (Q, P)`
determined by `p = d_q S(q, Q)` and `P = -d_Q S(q, Q)`, the target projection composed with the
branch through `x`. It is a partial diffeomorphism between an open neighbourhood of
`(q₀, d_q S(q₀, Q₀))` in `T*M` and an open subset of `T*N`. -/
def generatedMap :
    PartialDiffeomorph (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (J.prod 𝓘(ℝ, F →L[ℝ] ℝ)) (CotangentBundle I M)
      (CotangentBundle J N) ∞ :=
  (generatingBranch hS hx).trans (isLocalDiffeomorphAt_generatingTarget hS hx).localInverse.symm

/-- The source point `(q₀, d_q S(q₀, Q₀))` lies in the source of the branch. -/
@[simp]
theorem mem_generatingBranch_source : generatingSource I S x ∈ (generatingBranch hS hx).source :=
  IsLocalDiffeomorphAt.localInverse_mem_source _

/-- The branch is a right inverse of the source projection on its source. -/
theorem generatingSource_generatingBranch {z : CotangentBundle I M}
    (hz : z ∈ (generatingBranch hS hx).source) :
    generatingSource I S (generatingBranch hS hx z) = z :=
  IsLocalDiffeomorphAt.localInverse_right_inv _ hz

/-- Near a point of its source, the branch is a right inverse of the source projection. -/
theorem eventually_generatingSource_generatingBranch {z : CotangentBundle I M}
    (hz : z ∈ (generatingBranch hS hx).source) :
    ∀ᶠ z' in 𝓝 z, generatingSource I S (generatingBranch hS hx z') = z' :=
  eventually_of_mem ((generatingBranch hS hx).open_source.mem_nhds hz)
    fun _ hz' ↦ generatingSource_generatingBranch hS hx hz'

/-- The branch is a left inverse of the source projection on its target. -/
theorem generatingBranch_generatingSource_of_mem_target {y : M × N}
    (hy : y ∈ (generatingBranch hS hx).target) :
    generatingBranch hS hx (generatingSource I S y) = y :=
  IsLocalDiffeomorphAt.localInverse_left_inv _ hy

/-- Near `x`, the branch is a left inverse of the source projection. -/
theorem eventually_generatingBranch_generatingSource :
    ∀ᶠ y in 𝓝 x, generatingBranch hS hx (generatingSource I S y) = y :=
  IsLocalDiffeomorphAt.localInverse_eventuallyEq_left _

/-- The branch sends the source point back to `x`. -/
@[simp]
theorem generatingBranch_generatingSource : generatingBranch hS hx (generatingSource I S x) = x :=
  (eventually_generatingBranch_generatingSource hS hx).self_of_nhds

/-- **Uniqueness of the branch.** Every right inverse `β` of the source projection near
`(q₀, d_q S(q₀, Q₀))`, continuous there and sending it to `x`, agrees with the branch near that
point. -/
theorem eventuallyEq_generatingBranch {β : CotangentBundle I M → M × N}
    (hβ : ContinuousAt β (generatingSource I S x)) (hβx : β (generatingSource I S x) = x)
    (hsrc : ∀ᶠ z in 𝓝 (generatingSource I S x), generatingSource I S (β z) = z) :
    β =ᶠ[𝓝 (generatingSource I S x)] generatingBranch hS hx := by
  set hf := (isLocalDiffeomorphAt_generatingSource_iff hS BoundarylessManifold.isInteriorPoint).2 hx
  -- Near `src x`, `β` takes values in the target of the branch, on which the branch inverts `src`.
  have hT : ∀ᶠ z in 𝓝 (generatingSource I S x), β z ∈ hf.localInverse.target :=
    hβ.preimage_mem_nhds (by
      rw [hβx]
      exact hf.localInverse.open_target.mem_nhds hf.localInverse_mem_target)
  filter_upwards [hT, hsrc] with z hz hz'
  rw [← generatingBranch_generatingSource_of_mem_target hS hx hz, hz']

/-- The source point `(q₀, d_q S(q₀, Q₀))` lies in the source of the generated map. -/
@[simp]
theorem mem_generatedMap_source : generatingSource I S x ∈ (generatedMap hS hx).source := by
  refine ⟨mem_generatingBranch_source hS hx, ?_⟩
  have h : (generatingBranch hS hx).toPartialEquiv (generatingSource I S x) = x :=
    generatingBranch_generatingSource hS hx
  simp only [mem_preimage, OpenPartialHomeomorph.symm_symm,
    PartialDiffeomorph.toFun'_toOpenPartialHomeomorph, h]
  exact (isLocalDiffeomorphAt_generatingTarget hS hx).localInverse_mem_target

/-- The source of the generated map lies in the source of the branch. -/
theorem generatedMap_source_subset :
    (generatedMap hS hx).source ⊆ (generatingBranch hS hx).source :=
  fun _ hz ↦ hz.1

/-- On its source, the generated map is the target projection composed with the branch. -/
theorem generatedMap_apply {z : CotangentBundle I M} (hz : z ∈ (generatedMap hS hx).source) :
    generatedMap hS hx z = generatingTarget J S (generatingBranch hS hx z) := by
  set Ψ := (isLocalDiffeomorphAt_generatingTarget hS hx).localInverse
  -- `generatedMap = Ψ⁻¹ ∘ branch`, where `Ψ` is a local inverse of the target projection, and
  -- `Ψ⁻¹` agrees with the target projection on the target of `Ψ`.
  have hy : generatingBranch hS hx z ∈ Ψ.target := hz.2
  calc generatedMap hS hx z = generatingTarget J S (Ψ (Ψ.symm (generatingBranch hS hx z))) :=
        ((isLocalDiffeomorphAt_generatingTarget hS hx).localInverse_right_inv
          (Ψ.map_target hy)).symm
    _ = generatingTarget J S (generatingBranch hS hx z) := congrArg _ (Ψ.right_inv hy)

/-- **Near `x`, the graph of the generated map is the generated relation:** it sends
`(q, d_q S(q, Q))` to `(Q, -d_Q S(q, Q))`. -/
theorem eventually_generatedMap_generatingSource :
    ∀ᶠ y in 𝓝 x, generatedMap hS hx (generatingSource I S y) = generatingTarget J S y := by
  have hsrc : ContinuousAt (generatingSource I S) x :=
    (contMDiff_generatingSource hS).continuous.continuousAt
  filter_upwards [hsrc.preimage_mem_nhds ((generatedMap hS hx).open_source.mem_nhds
    (mem_generatedMap_source hS hx)), eventually_generatingBranch_generatingSource hS hx]
    with y hy hy'
  rw [generatedMap_apply hS hx hy, hy']

/-- Near a point of its source, the generated map is the target projection composed with the
branch. -/
theorem eventuallyEq_generatedMap {z : CotangentBundle I M}
    (hz : z ∈ (generatedMap hS hx).source) :
    generatedMap hS hx =ᶠ[𝓝 z] generatingTarget J S ∘ generatingBranch hS hx :=
  eventuallyEq_of_mem ((generatedMap hS hx).open_source.mem_nhds hz)
    fun _ hz' ↦ generatedMap_apply hS hx hz'

/-- **The generated map is a canonical transformation.** At every point of its source, the map
generated by `S` pulls the canonical symplectic form `ω_N = -dλ_N` back to `ω_M`. -/
theorem mpullback_generatedMap_symplecticForm {z : CotangentBundle I M}
    (hz : z ∈ (generatedMap hS hx).source) :
    mpullback (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (J.prod 𝓘(ℝ, F →L[ℝ] ℝ)) (generatedMap hS hx)
        (symplecticForm J N).1 z = (symplecticForm I M).1 z := by
  rw [(eventuallyEq_generatedMap hS hx hz).mpullback_eq]
  exact mpullback_generatingTarget_comp_symplecticForm hS
    ((generatingBranch hS hx).mdifferentiableAt (by simp) (generatedMap_source_subset hS hx hz))
    (eventually_generatingSource_generatingBranch hS hx (generatedMap_source_subset hS hx hz))

/-- **`S` is the primitive of the generated map.** At every point of its source, the map `φ`
generated by `S` satisfies `λ_M - φ^*λ_N = d(S ∘ branch)`. -/
theorem liouvilleForm_sub_mpullback_generatedMap {z : CotangentBundle I M}
    (hz : z ∈ (generatedMap hS hx).source) :
    (liouvilleForm I M).1 z -
        mpullback (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (J.prod 𝓘(ℝ, F →L[ℝ] ℝ)) (generatedMap hS hx)
          (liouvilleForm J N).1 z =
      mextDeriv
        (RoughForm.ofFunction (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (S ∘ generatingBranch hS hx)) z := by
  rw [(eventuallyEq_generatedMap hS hx hz).mpullback_eq]
  exact liouvilleForm_sub_mpullback_generatingTarget_comp hS
    ((generatingBranch hS hx).mdifferentiableAt (by simp) (generatedMap_source_subset hS hx hz))
    (eventually_generatingSource_generatingBranch hS hx (generatedMap_source_subset hS hx hz))

end Generated

