/-!
# Generating functions of the first kind

A real function `S(q, Q)` on a product `V × W` of normed spaces determines a relation between the
linear cotangent spaces `V × V'` and `W × W'` (with `V'`, `W'` the continuous duals),

`p = ∂_q S(q, Q)`, `P = -∂_Q S(q, Q)`.

It is parametrized by `(q, Q)` through its two projections, the source projection
`(q, Q) ↦ (q, ∂_q S)` (`TauCeti.cotangentGeneratingSource`) and the target projection
`(q, Q) ↦ (Q, -∂_Q S)` (`TauCeti.cotangentGeneratingTarget`). It is the graph of `dS` in the
cotangent space of `V × W` with the sign of the second covector reversed. The reversed
relation is generated by `TauCeti.cotangentGeneratingReverse S`, the function
`(Q, q) ↦ -S(q, Q)`, whose source and target projections are the original target and source
projections (`TauCeti.cotangentGeneratingSource_reverse`,
`TauCeti.cotangentGeneratingTarget_reverse`). With the convention
`λ_(q,p)(δq, δp) = p(δq)` and `ω = -dλ`:

* the relation is exact with primitive `S`: the Liouville form of the source minus that of the
  target pulls back to `dS` (`TauCeti.cotangentLiouvilleForm_cotangentGeneratingSource_sub`);
* where the second derivative of `S` is symmetric, the two projections pull the symplectic forms
  back to the same form, so the relation is isotropic for `ω_V - ω_W`
  (`TauCeti.strongDualCotangentSymplecticForm_fderiv_cotangentGeneratingSource`).

The source projection has invertible derivative exactly when the mixed Hessian
`∂_Q ∂_q S : W → V'` (`TauCeti.cotangentMixedHessian`) is invertible
(`TauCeti.isInvertible_fderiv_cotangentGeneratingSource_iff`). For a `C²` function on Banach
spaces with invertible mixed Hessian at `x₀`, the inverse function theorem then gives a local
branch `(q, p) ↦ (q, Q(q, p))` of the inverse of the source projection near its value at `x₀`
(`TauCeti.cotangentGeneratingBranch`), unique as a germ, and the **map generated by `S`**
(`TauCeti.cotangentGeneratedMap`), `(q, p) ↦ (Q, P)`, is the target projection composed with this
branch. Near the source point it preserves `ω`
(`TauCeti.eventually_strongDualCotangentSymplecticForm_fderiv_cotangentGeneratedMap`) and
satisfies `λ - φ^*λ = d(S ∘ branch)`
(`TauCeti.eventually_cotangentLiouvilleForm_sub_cotangentGeneratedMap`).

When `V` and `W` are finite-dimensional, the derivative of the generated map is invertible near the
source point (`TauCeti.eventually_isInvertible_fderiv_cotangentGeneratedMap`), so by the inverse
function theorem the generated map is a local canonical transformation. On general Banach spaces
the invertibility of the mixed Hessian does not give this: for a nonreflexive `V`, `W = V'` and
`S(q, Q) = Q(q)`, the mixed Hessian is the identity of `V'`, while the generated map
`(q, p) ↦ (p, -ι q)`, with `ι : V → V''` the canonical embedding, is not surjective.

On a real Hilbert space, the free-particle generating function `S(q, Q) = -‖q - Q‖² / (2t)`
(`TauCeti.freeParticleGeneratingFunction`) with `t ≠ 0` generates the map `(q, p) ↦ (q + t p♯, p)`,
where `p♯` is the Riesz representative of `p`: the motion of a free particle of unit mass for time
`t`
(`TauCeti.cotangentGeneratingTarget_freeParticleGeneratingFunction_eq_cotangentGeneratingSource` and
`TauCeti.cotangentGeneratedMap_freeParticleGeneratingFunction_eventuallyEq`).

## References

* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Section 4 (generating functions).
-/

public section

open ContinuousAlternatingMap ContinuousLinearMap Filter
open scoped Topology

noncomputable section

namespace TauCeti

variable {V W : Type*}

/-- Reversing a generated cotangent relation replaces `S(q,Q)` by `-S(q,Q)`
and interchanges its position variables. -/
def cotangentGeneratingReverse (S : V × W → ℝ) (y : W × V) : ℝ := -S y.swap

@[simp]
theorem cotangentGeneratingReverse_apply (S : V × W → ℝ) (y : W × V) :
    cotangentGeneratingReverse S y = -S y.swap :=
  (rfl)

/-- Reversing a generating function twice recovers the original function. -/
@[simp]
theorem cotangentGeneratingReverse_reverse (S : V × W → ℝ) :
    cotangentGeneratingReverse (cotangentGeneratingReverse S) = S := by
  funext x
  simp

variable [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedAddCommGroup W]
  [NormedSpace ℝ W]

/-! ### The two projections of the generated relation -/

/-- The **source projection** of the relation generated by `S`: `(q, Q) ↦ (q, ∂_q S(q, Q))`. -/
def cotangentGeneratingSource (S : V × W → ℝ) (x : V × W) : V × StrongDual ℝ V :=
  (x.1, (fderiv ℝ S x).comp (inl ℝ V W))

/-- The **target projection** of the relation generated by `S`: `(q, Q) ↦ (Q, -∂_Q S(q, Q))`. -/
def cotangentGeneratingTarget (S : V × W → ℝ) (x : V × W) : W × StrongDual ℝ W :=
  (x.2, -(fderiv ℝ S x).comp (inr ℝ V W))

variable {S : V × W → ℝ} {x : V × W}

@[simp]
theorem cotangentGeneratingSource_fst (S : V × W → ℝ) (x : V × W) :
    (cotangentGeneratingSource S x).1 = x.1 :=
  (rfl)

@[simp]
theorem cotangentGeneratingSource_snd_apply (S : V × W → ℝ) (x : V × W) (a : V) :
    (cotangentGeneratingSource S x).2 a = fderiv ℝ S x (a, 0) :=
  (rfl)

@[simp]
theorem cotangentGeneratingTarget_fst (S : V × W → ℝ) (x : V × W) :
    (cotangentGeneratingTarget S x).1 = x.2 :=
  (rfl)

@[simp]
theorem cotangentGeneratingTarget_snd_apply (S : V × W → ℝ) (x : V × W) (b : W) :
    (cotangentGeneratingTarget S x).2 b = -fderiv ℝ S x (0, b) :=
  (rfl)

/-- The differential of the generating function of the reversed relation. -/
theorem fderiv_cotangentGeneratingReverse (S : V × W → ℝ) (x : V × W)
    (u : W × V) :
    fderiv ℝ (cotangentGeneratingReverse S) x.swap u = -fderiv ℝ S x u.swap := by
  let e := ContinuousLinearEquiv.prodComm ℝ W V
  have hdef : cotangentGeneratingReverse S = fun y ↦ -(S ∘ e) y := by
    funext y
    simp [e]
  rw [hdef, fderiv_fun_neg, e.comp_right_fderiv]
  simp [e]

/-- Reversal preserves the differentiability order. -/
theorem contDiffAt_cotangentGeneratingReverse {S : V × W → ℝ} {x : V × W}
    {n : WithTop ℕ∞} (hS : ContDiffAt ℝ n S x) :
    ContDiffAt ℝ n (cotangentGeneratingReverse S) x.swap :=
  (hS.comp x.swap (ContinuousLinearEquiv.prodComm ℝ W V).contDiff.contDiffAt).neg

/-- The source of the reversed relation is the original target. -/
@[simp]
theorem cotangentGeneratingSource_reverse (S : V × W → ℝ) (x : V × W) :
    cotangentGeneratingSource (cotangentGeneratingReverse S) x.swap =
      cotangentGeneratingTarget S x := by
  ext a
  · simp
  · simp [fderiv_cotangentGeneratingReverse S x]

/-- The target of the reversed relation is the original source. -/
@[simp]
theorem cotangentGeneratingTarget_reverse (S : V × W → ℝ) (x : V × W) :
    cotangentGeneratingTarget (cotangentGeneratingReverse S) x.swap =
      cotangentGeneratingSource S x := by
  ext a
  · simp
  · simp [fderiv_cotangentGeneratingReverse S x]

/-- If `S` is `C^(n+1)` at `x`, its source projection is `C^n` there. -/
theorem contDiffAt_cotangentGeneratingSource {n : WithTop ℕ∞}
    (hS : ContDiffAt ℝ (n + 1) S x) : ContDiffAt ℝ n (cotangentGeneratingSource S) x :=
  contDiffAt_fst.prodMk ((hS.fderiv_right le_rfl).clm_comp contDiffAt_const)

/-- If `S` is `C^(n+1)` at `x`, its target projection is `C^n` there. -/
theorem contDiffAt_cotangentGeneratingTarget {n : WithTop ℕ∞}
    (hS : ContDiffAt ℝ (n + 1) S x) : ContDiffAt ℝ n (cotangentGeneratingTarget S) x :=
  contDiffAt_snd.prodMk ((hS.fderiv_right le_rfl).clm_comp contDiffAt_const).neg

/-- The source projection, with the restriction of covectors written as a continuous linear map. -/
private theorem cotangentGeneratingSource_eq_precomp (S : V × W → ℝ) :
    cotangentGeneratingSource S = fun y ↦ (y.1, precomp ℝ (inl ℝ V W) (fderiv ℝ S y)) := by
  funext y
  simp [cotangentGeneratingSource]

/-- The derivative of the source projection: `(δq, δQ) ↦ (δq, D²S (δq, δQ) (·, 0))`. -/
theorem hasFDerivAt_cotangentGeneratingSource (hS : DifferentiableAt ℝ (fderiv ℝ S) x) :
    HasFDerivAt (cotangentGeneratingSource S)
      ((fst ℝ V W).prod (precomp ℝ (inl ℝ V W) ∘L fderiv ℝ (fderiv ℝ S) x)) x := by
  rw [cotangentGeneratingSource_eq_precomp]
  exact hasFDerivAt_fst.prodMk ((precomp ℝ (inl ℝ V W)).hasFDerivAt.comp x hS.hasFDerivAt)

/-- The derivative of the target projection: `(δq, δQ) ↦ (δQ, -D²S (δq, δQ) (0, ·))`. -/
theorem hasFDerivAt_cotangentGeneratingTarget (hS : DifferentiableAt ℝ (fderiv ℝ S) x) :
    HasFDerivAt (cotangentGeneratingTarget S)
      ((snd ℝ V W).prod (-(precomp ℝ (inr ℝ V W) ∘L fderiv ℝ (fderiv ℝ S) x))) x := by
  have h : cotangentGeneratingTarget S = fun y ↦ (y.2, -precomp ℝ (inr ℝ V W) (fderiv ℝ S y)) := by
    funext y
    simp [cotangentGeneratingTarget]
  rw [h]
  exact hasFDerivAt_snd.prodMk ((precomp ℝ (inr ℝ V W)).hasFDerivAt.comp x hS.hasFDerivAt).neg

@[simp]
theorem fderiv_cotangentGeneratingSource_apply (hS : DifferentiableAt ℝ (fderiv ℝ S) x)
    (u : V × W) :
    fderiv ℝ (cotangentGeneratingSource S) x u =
      (u.1, (fderiv ℝ (fderiv ℝ S) x u).comp (inl ℝ V W)) := by
  simp [(hasFDerivAt_cotangentGeneratingSource hS).fderiv]

@[simp]
theorem fderiv_cotangentGeneratingTarget_apply (hS : DifferentiableAt ℝ (fderiv ℝ S) x)
    (u : V × W) :
    fderiv ℝ (cotangentGeneratingTarget S) x u =
      (u.2, -(fderiv ℝ (fderiv ℝ S) x u).comp (inr ℝ V W)) := by
  simp [(hasFDerivAt_cotangentGeneratingTarget hS).fderiv]

/-- **The generated relation is exact with primitive `S`.** The Liouville form of the source
minus that of the target pulls back along the two projections to `dS`:
`p δq - P δQ = dS(δq, δQ)`. -/
theorem cotangentLiouvilleForm_cotangentGeneratingSource_sub
    (hS : DifferentiableAt ℝ (fderiv ℝ S) x) :
    (cotangentLiouvilleForm (cotangentGeneratingSource S x)).compContinuousLinearMap
        (fderiv ℝ (cotangentGeneratingSource S) x) -
      (cotangentLiouvilleForm (cotangentGeneratingTarget S x)).compContinuousLinearMap
        (fderiv ℝ (cotangentGeneratingTarget S) x) =
      differentialOneForm S x := by
  ext v
  rw [eq_const_of_subsingleton v 0, ← Function.const_def]
  simp only [ContinuousAlternatingMap.sub_apply, compContinuousLinearMap_apply,
    cotangentLiouvilleForm_apply, Function.comp_apply, fderiv_cotangentGeneratingSource_apply hS,
    fderiv_cotangentGeneratingTarget_apply hS, cotangentGeneratingSource_snd_apply,
    cotangentGeneratingTarget_snd_apply, differentialOneForm_apply, sub_neg_eq_add, ← map_add,
    Prod.mk_add_mk, add_zero, zero_add]

/-- **The generated relation is isotropic for `ω_V - ω_W`.** Where the second derivative of `S`
is symmetric, the source and target projections pull the canonical symplectic forms back to the
same form. -/
theorem strongDualCotangentSymplecticForm_fderiv_cotangentGeneratingSource
    (hS : DifferentiableAt ℝ (fderiv ℝ S) x) (hsymm : IsSymmSndFDerivAt ℝ S x) (u v : V × W) :
    strongDualCotangentSymplecticForm (fderiv ℝ (cotangentGeneratingSource S) x u)
        (fderiv ℝ (cotangentGeneratingSource S) x v) =
      strongDualCotangentSymplecticForm (fderiv ℝ (cotangentGeneratingTarget S) x u)
        (fderiv ℝ (cotangentGeneratingTarget S) x v) := by
  obtain ⟨a, b⟩ := u
  obtain ⟨c, d⟩ := v
  simp only [strongDualCotangentSymplecticForm_apply, fderiv_cotangentGeneratingSource_apply hS,
    fderiv_cotangentGeneratingTarget_apply hS, _root_.neg_apply, comp_apply, inl_apply,
    inr_apply]
  -- Both sides are `D²S(v, u) - D²S(u, v)`, split along the two factors of `u` and `v`.
  have h := hsymm (a, b) (c, d)
  rw [show ((a, b) : V × W) = (a, 0) + (0, b) by simp,
    show ((c, d) : V × W) = (c, 0) + (0, d) by simp] at h ⊢
  simp only [map_add, _root_.add_apply] at h ⊢
  linarith

/-! ### The mixed Hessian -/

/-- The **mixed Hessian** `∂_Q ∂_q S` of `S` at `x`, as a map from the second factor to covectors
on the first: `δQ ↦ D²S (0, δQ) (·, 0)`. -/
def cotangentMixedHessian (S : V × W → ℝ) (x : V × W) : W →L[ℝ] StrongDual ℝ V :=
  precomp ℝ (inl ℝ V W) ∘L fderiv ℝ (fderiv ℝ S) x ∘L inr ℝ V W

@[simp]
theorem cotangentMixedHessian_apply_apply (S : V × W → ℝ) (x : V × W) (b : W) (a : V) :
    cotangentMixedHessian S x b a = fderiv ℝ (fderiv ℝ S) x (0, b) (a, 0) :=
  (rfl)

/-- **The mixed Hessian criterion.** The source projection has invertible derivative at `x`
exactly when the mixed Hessian of `S` at `x` is invertible. -/
theorem isInvertible_fderiv_cotangentGeneratingSource_iff
    (hS : DifferentiableAt ℝ (fderiv ℝ S) x) :
    (fderiv ℝ (cotangentGeneratingSource S) x).IsInvertible ↔
      (cotangentMixedHessian S x).IsInvertible := by
  rw [(hasFDerivAt_cotangentGeneratingSource hS).fderiv]
  set M := cotangentMixedHessian S x
  set H : V →L[ℝ] StrongDual ℝ V := precomp ℝ (inl ℝ V W) ∘L fderiv ℝ (fderiv ℝ S) x ∘L inl ℝ V W
  set A := (fst ℝ V W).prod (precomp ℝ (inl ℝ V W) ∘L fderiv ℝ (fderiv ℝ S) x)
  -- The derivative is block triangular: `A (a, b) = (a, H a + M b)`.
  have hA (a : V) (b : W) : A (a, b) = (a, H a + M b) := by
    have h : fderiv ℝ (fderiv ℝ S) x (a, b) =
        fderiv ℝ (fderiv ℝ S) x (a, 0) + fderiv ℝ (fderiv ℝ S) x (0, b) := by
      rw [← map_add, Prod.mk_add_mk, add_zero, zero_add]
    ext c
    · simp [A]
    · simp [A, H, M, cotangentMixedHessian, h]
  constructor
  · rintro ⟨e, he⟩
    have he' (z : V × W) : e z = A z := DFunLike.congr_fun he z
    -- The inverse of `M` reads off the second component of `e⁻¹ (0, α)`.
    refine IsInvertible.of_inverse (g := snd ℝ V W ∘L (e.symm : _ →L[ℝ] V × W) ∘L
      inr ℝ V (StrongDual ℝ V)) (ContinuousLinearMap.ext fun α ↦ ?_)
      (ContinuousLinearMap.ext fun b ↦ ?_)
    · have h := e.apply_symm_apply (0, α)
      rw [he', ← Prod.mk.eta (p := e.symm (0, α)), hA, Prod.mk.injEq] at h
      simpa [h.1] using h.2
    · have h : e (0, b) = (0, M b) := by simp [he', hA, H, Prod.mk_zero_zero]
      simp [← h]
  · rintro ⟨e, he⟩
    have he' (b : W) : e b = M b := DFunLike.congr_fun he b
    refine ⟨(ContinuousLinearEquiv.refl ℝ V).skewProd e H,
      ContinuousLinearMap.ext fun z ↦ ?_⟩
    simpa [he', add_comm] using (hA z.1 z.2).symm

/-! ### The generated map -/

/-- A `C²` function has a source projection which is strictly differentiable. -/
theorem hasStrictFDerivAt_cotangentGeneratingSource (hS : ContDiffAt ℝ 2 S x) :
    HasStrictFDerivAt (cotangentGeneratingSource S)
      (fderiv ℝ (cotangentGeneratingSource S) x) x :=
  (contDiffAt_cotangentGeneratingSource (n := 1) hS).hasStrictFDerivAt one_ne_zero

/-- The derivative of the source projection, as a continuous linear equivalence, when the mixed
Hessian is invertible. -/
private def sourceDerivEquiv (hS : ContDiffAt ℝ 2 S x)
    (hM : (cotangentMixedHessian S x).IsInvertible) :
    (V × W) ≃L[ℝ] V × StrongDual ℝ V :=
  ((isInvertible_fderiv_cotangentGeneratingSource_iff
    ((hS.fderiv_right (m := 1) le_rfl).differentiableAt one_ne_zero)).2 hM).choose

private theorem coe_sourceDerivEquiv (hS : ContDiffAt ℝ 2 S x)
    (hM : (cotangentMixedHessian S x).IsInvertible) :
    (sourceDerivEquiv hS hM : V × W →L[ℝ] V × StrongDual ℝ V) =
      fderiv ℝ (cotangentGeneratingSource S) x :=
  ((isInvertible_fderiv_cotangentGeneratingSource_iff
    ((hS.fderiv_right (m := 1) le_rfl).differentiableAt one_ne_zero)).2 hM).choose_spec

private theorem hasStrictFDerivAt_sourceDerivEquiv (hS : ContDiffAt ℝ 2 S x)
    (hM : (cotangentMixedHessian S x).IsInvertible) :
    HasStrictFDerivAt (cotangentGeneratingSource S)
      (sourceDerivEquiv hS hM : V × W →L[ℝ] V × StrongDual ℝ V) x := by
  rw [coe_sourceDerivEquiv]
  exact hasStrictFDerivAt_cotangentGeneratingSource hS

section Generated

variable [CompleteSpace V] [CompleteSpace W] {x₀ : V × W}

/-- **The branch of the generated relation.** For `S` of class `C²` at `x₀` with invertible mixed
Hessian there, this is the local inverse `(q, p) ↦ (q, Q(q, p))` of the source projection near
`(q₀, ∂_q S(x₀))`, given by the inverse function theorem. Away from that neighbourhood it carries
no meaning. -/
def cotangentGeneratingBranch (hS : ContDiffAt ℝ 2 S x₀)
    (hM : (cotangentMixedHessian S x₀).IsInvertible) : V × StrongDual ℝ V → V × W :=
  (hasStrictFDerivAt_sourceDerivEquiv hS hM).localInverse _ _ _

/-- **The map generated by `S`** near `x₀`: `(q, p) ↦ (Q, P)`, the target projection composed with
the branch of the inverse of the source projection. It preserves the canonical symplectic form,
and in finite dimensions it is a local canonical transformation
(`TauCeti.eventually_isInvertible_fderiv_cotangentGeneratedMap`). -/
def cotangentGeneratedMap (hS : ContDiffAt ℝ 2 S x₀)
    (hM : (cotangentMixedHessian S x₀).IsInvertible) :
    V × StrongDual ℝ V → W × StrongDual ℝ W :=
  cotangentGeneratingTarget S ∘ cotangentGeneratingBranch hS hM

variable (hS : ContDiffAt ℝ 2 S x₀) (hM : (cotangentMixedHessian S x₀).IsInvertible)
include hS hM

theorem cotangentGeneratedMap_def :
    cotangentGeneratedMap hS hM = cotangentGeneratingTarget S ∘ cotangentGeneratingBranch hS hM :=
  (rfl)

@[simp]
theorem cotangentGeneratingBranch_cotangentGeneratingSource :
    cotangentGeneratingBranch hS hM (cotangentGeneratingSource S x₀) = x₀ :=
  (hasStrictFDerivAt_sourceDerivEquiv hS hM).localInverse_apply_image

/-- The branch is a left inverse of the source projection near `x₀`. -/
theorem eventually_cotangentGeneratingBranch_cotangentGeneratingSource :
    ∀ᶠ x in 𝓝 x₀, cotangentGeneratingBranch hS hM (cotangentGeneratingSource S x) = x :=
  (hasStrictFDerivAt_sourceDerivEquiv hS hM).eventually_left_inverse

/-- The branch is a right inverse of the source projection near its value at `x₀`. -/
theorem eventually_cotangentGeneratingSource_cotangentGeneratingBranch :
    ∀ᶠ y in 𝓝 (cotangentGeneratingSource S x₀),
      cotangentGeneratingSource S (cotangentGeneratingBranch hS hM y) = y :=
  (hasStrictFDerivAt_sourceDerivEquiv hS hM).eventually_right_inverse

/-- The branch has strict derivative inverse to the source derivative at its value at `x₀`. -/
theorem hasStrictFDerivAt_cotangentGeneratingBranch
    (e : (V × W) ≃L[ℝ] V × StrongDual ℝ V)
    (he : (e : V × W →L[ℝ] V × StrongDual ℝ V) =
      fderiv ℝ (cotangentGeneratingSource S) x₀) :
    HasStrictFDerivAt (cotangentGeneratingBranch hS hM)
      (e.symm : V × StrongDual ℝ V →L[ℝ] V × W) (cotangentGeneratingSource S x₀) := by
  have hs : HasStrictFDerivAt (cotangentGeneratingSource S)
      (e : V × W →L[ℝ] V × StrongDual ℝ V) x₀ := by
    rw [he]
    exact hasStrictFDerivAt_cotangentGeneratingSource hS
  exact hs.to_local_left_inverse
    (eventually_cotangentGeneratingBranch_cotangentGeneratingSource hS hM)

/-- The branch tends to `x₀` at `(q₀, ∂_q S(x₀))`. -/
theorem tendsto_cotangentGeneratingBranch :
    Tendsto (cotangentGeneratingBranch hS hM) (𝓝 (cotangentGeneratingSource S x₀)) (𝓝 x₀) :=
  (hasStrictFDerivAt_sourceDerivEquiv hS hM).localInverse_tendsto

/-- **Uniqueness of the branch.** Every local left inverse of the source projection near `x₀`
agrees with the branch near `(q₀, ∂_q S(x₀))`. -/
theorem eventuallyEq_cotangentGeneratingBranch {g : V × StrongDual ℝ V → V × W}
    (hg : ∀ᶠ x in 𝓝 x₀, g (cotangentGeneratingSource S x) = x) :
    g =ᶠ[𝓝 (cotangentGeneratingSource S x₀)] cotangentGeneratingBranch hS hM :=
  (hasStrictFDerivAt_sourceDerivEquiv hS hM).localInverse_unique hg

/-- If `S` is `C^(n+1)` at `x₀` with `n ≠ 0`, the branch is `C^n` at `(q₀, ∂_q S(x₀))`. -/
theorem contDiffAt_cotangentGeneratingBranch {n : WithTop ℕ∞} (hSn : ContDiffAt ℝ (n + 1) S x₀)
    (hn : n ≠ 0) :
    ContDiffAt ℝ n (cotangentGeneratingBranch hS hM) (cotangentGeneratingSource S x₀) := by
  have h : ContDiffAt ℝ n (cotangentGeneratingSource S) x₀ :=
    contDiffAt_cotangentGeneratingSource hSn
  -- Mathlib's `C^n` local inverse is the strict-derivative local inverse defining the branch.
  exact h.to_localInverse (hasStrictFDerivAt_sourceDerivEquiv hS hM).hasFDerivAt hn

@[simp]
theorem cotangentGeneratedMap_cotangentGeneratingSource :
    cotangentGeneratedMap hS hM (cotangentGeneratingSource S x₀) =
      cotangentGeneratingTarget S x₀ := by
  simp [cotangentGeneratedMap_def]

/-- Near `x₀`, the generated map carries the source projection to the target projection: it
sends `(q, ∂_q S(q, Q))` to `(Q, -∂_Q S(q, Q))`. -/
theorem eventually_cotangentGeneratedMap_cotangentGeneratingSource :
    ∀ᶠ x in 𝓝 x₀, cotangentGeneratedMap hS hM (cotangentGeneratingSource S x) =
      cotangentGeneratingTarget S x := by
  filter_upwards [eventually_cotangentGeneratingBranch_cotangentGeneratingSource hS hM] with x hx
  rw [cotangentGeneratedMap_def, Function.comp_apply, hx]

/-- If `S` is `C^(n+1)` at `x₀` with `n ≠ 0`, the generated map is `C^n` at `(q₀, ∂_q S(x₀))`. -/
theorem contDiffAt_cotangentGeneratedMap {n : WithTop ℕ∞} (hSn : ContDiffAt ℝ (n + 1) S x₀)
    (hn : n ≠ 0) :
    ContDiffAt ℝ n (cotangentGeneratedMap hS hM) (cotangentGeneratingSource S x₀) := by
  have h : ContDiffAt ℝ n (cotangentGeneratingTarget S) x₀ :=
    contDiffAt_cotangentGeneratingTarget hSn
  rw [cotangentGeneratedMap_def]
  refine ContDiffAt.comp _ ?_ (contDiffAt_cotangentGeneratingBranch hS hM hSn hn)
  rwa [cotangentGeneratingBranch_cotangentGeneratingSource]

/-- The two main identities at the source point of `x`, where the branch has derivative inverse to
that of the source projection: the generated map preserves `ω` and satisfies
`λ - φ^*λ = d(S ∘ branch)` there. -/
private theorem generatedMap_identities {x : V × W} (hSx : ContDiffAt ℝ 2 S x)
    (e : (V × W) ≃L[ℝ] V × StrongDual ℝ V)
    (he : (e : V × W →L[ℝ] V × StrongDual ℝ V) = fderiv ℝ (cotangentGeneratingSource S) x)
    (hbranch : HasFDerivAt (cotangentGeneratingBranch hS hM)
      (e.symm : V × StrongDual ℝ V →L[ℝ] V × W) (cotangentGeneratingSource S x))
    (hx : cotangentGeneratingBranch hS hM (cotangentGeneratingSource S x) = x) :
    (∀ u v, strongDualCotangentSymplecticForm
        (fderiv ℝ (cotangentGeneratedMap hS hM) (cotangentGeneratingSource S x) u)
        (fderiv ℝ (cotangentGeneratedMap hS hM) (cotangentGeneratingSource S x) v) =
      strongDualCotangentSymplecticForm u v) ∧
    cotangentLiouvilleForm (cotangentGeneratingSource S x) -
        (cotangentLiouvilleForm
          (cotangentGeneratedMap hS hM (cotangentGeneratingSource S x))).compContinuousLinearMap
          (fderiv ℝ (cotangentGeneratedMap hS hM) (cotangentGeneratingSource S x)) =
      differentialOneForm (S ∘ cotangentGeneratingBranch hS hM)
        (cotangentGeneratingSource S x) := by
  have hd := (hSx.fderiv_right (m := 1) le_rfl).differentiableAt one_ne_zero
  have hφ : fderiv ℝ (cotangentGeneratedMap hS hM) (cotangentGeneratingSource S x) =
      fderiv ℝ (cotangentGeneratingTarget S) x ∘L (e.symm : V × StrongDual ℝ V →L[ℝ] V × W) := by
    have ht := (hasFDerivAt_cotangentGeneratingTarget hd).differentiableAt.hasFDerivAt
    rw [← hx] at ht
    rw [cotangentGeneratedMap_def, (ht.comp _ hbranch).fderiv, hx]
  have hSb : fderiv ℝ (S ∘ cotangentGeneratingBranch hS hM) (cotangentGeneratingSource S x) =
      fderiv ℝ S x ∘L (e.symm : V × StrongDual ℝ V →L[ℝ] V × W) := by
    have hs := (hSx.differentiableAt two_ne_zero).hasFDerivAt
    rw [← hx] at hs
    rw [(hs.comp _ hbranch).fderiv, hx]
  have hsource : ⇑(fderiv ℝ (cotangentGeneratingSource S) x) ∘
      ⇑(e.symm : V × StrongDual ℝ V →L[ℝ] V × W) = id := by
    funext w
    simp [← he]
  rw [cotangentGeneratedMap_def, Function.comp_apply, hx, ← cotangentGeneratedMap_def, hφ]
  refine ⟨fun u v ↦ ?_, ?_⟩
  · rw [comp_apply, comp_apply,
      ← strongDualCotangentSymplecticForm_fderiv_cotangentGeneratingSource hd
        (hSx.isSymmSndFDerivAt (by simp))]
    simp only [← Function.comp_apply (f := ⇑(fderiv ℝ (cotangentGeneratingSource S) x)), hsource,
      id]
  · -- Compose the exactness of the relation at `x` with the inverse of the source derivative.
    have hdS : differentialOneForm (S ∘ cotangentGeneratingBranch hS hM)
        (cotangentGeneratingSource S x) = (differentialOneForm S x).compContinuousLinearMap
          (e.symm : V × StrongDual ℝ V →L[ℝ] V × W) := by
      ext v
      rw [eq_const_of_subsingleton v 0, ← Function.const_def]
      rw [differentialOneForm_apply, hSb, compContinuousLinearMap_apply]
      simp [Function.comp_def]
    rw [hdS, ← cotangentLiouvilleForm_cotangentGeneratingSource_sub hd]
    ext v
    simp only [ContinuousAlternatingMap.sub_apply, compContinuousLinearMap_apply, coe_comp]
    rw [← Function.comp_assoc, hsource, Function.id_comp, Function.comp_assoc]

/-- Near `(q₀, ∂_q S(x₀))`, every point is the source of a point near `x₀` at which `S` is `C²`
and the branch has derivative inverse to that of the source projection. -/
private theorem eventually_hasFDerivAt_cotangentGeneratingBranch :
    ∀ᶠ y in 𝓝 (cotangentGeneratingSource S x₀),
      ∃ x : V × W, ∃ e : (V × W) ≃L[ℝ] V × StrongDual ℝ V,
      y = cotangentGeneratingSource S x ∧ ContDiffAt ℝ 2 S x ∧
      (e : V × W →L[ℝ] V × StrongDual ℝ V) = fderiv ℝ (cotangentGeneratingSource S) x ∧
      HasFDerivAt (cotangentGeneratingBranch hS hM)
        (e.symm : V × StrongDual ℝ V →L[ℝ] V × W) (cotangentGeneratingSource S x) ∧
      cotangentGeneratingBranch hS hM (cotangentGeneratingSource S x) = x := by
  have h₁ : ∀ᶠ x in 𝓝 x₀, ContDiffAt ℝ 2 S x := hS.eventually (by simp)
  have h₂ : ∀ᶠ x in 𝓝 x₀, (fderiv ℝ (cotangentGeneratingSource S) x).IsInvertible := by
    have hc : ContDiffAt ℝ 1 (cotangentGeneratingSource S) x₀ :=
      contDiffAt_cotangentGeneratingSource hS
    refine (hc.continuousAt_fderiv one_ne_zero).eventually ?_
    rw [← coe_sourceDerivEquiv hS hM]
    exact isInvertible_equiv.eventually_nhds
  have h₃ := (eventually_cotangentGeneratingBranch_cotangentGeneratingSource hS hM).eventually_nhds
  filter_upwards [(tendsto_cotangentGeneratingBranch hS hM).eventually (h₁.and (h₂.and h₃)),
    eventually_cotangentGeneratingSource_cotangentGeneratingBranch hS hM]
    with y ⟨hSx, ⟨e, he⟩, hinv⟩ hy
  set x := cotangentGeneratingBranch hS hM y
  have hstrict : HasStrictFDerivAt (cotangentGeneratingSource S)
      (e : V × W →L[ℝ] V × StrongDual ℝ V) x := by
    rw [he]
    exact hasStrictFDerivAt_cotangentGeneratingSource hSx
  exact ⟨x, e, hy.symm, hSx, he, (hstrict.to_local_left_inverse hinv).hasFDerivAt,
    hinv.self_of_nhds⟩

/-- **The generated map preserves `ω`.** Near `(q₀, ∂_q S(x₀))` the derivative of the map
generated by `S` preserves the canonical symplectic form. -/
theorem eventually_strongDualCotangentSymplecticForm_fderiv_cotangentGeneratedMap :
    ∀ᶠ y in 𝓝 (cotangentGeneratingSource S x₀), ∀ u v,
      strongDualCotangentSymplecticForm (fderiv ℝ (cotangentGeneratedMap hS hM) y u)
          (fderiv ℝ (cotangentGeneratedMap hS hM) y v) =
        strongDualCotangentSymplecticForm u v := by
  filter_upwards [eventually_hasFDerivAt_cotangentGeneratingBranch hS hM] with y hy
  obtain ⟨x, e, rfl, hSx, he, hb, hx⟩ := hy
  exact (generatedMap_identities hS hM hSx e he hb hx).1

/-- **`S` is the primitive of the generated map.** Near `(q₀, ∂_q S(x₀))` the map `φ` generated
by `S` satisfies `λ - φ^*λ = d(S ∘ branch)`. -/
theorem eventually_cotangentLiouvilleForm_sub_cotangentGeneratedMap :
    ∀ᶠ y in 𝓝 (cotangentGeneratingSource S x₀),
      cotangentLiouvilleForm y - (cotangentLiouvilleForm
          (cotangentGeneratedMap hS hM y)).compContinuousLinearMap
          (fderiv ℝ (cotangentGeneratedMap hS hM) y) =
        differentialOneForm (S ∘ cotangentGeneratingBranch hS hM) y := by
  filter_upwards [eventually_hasFDerivAt_cotangentGeneratingBranch hS hM] with y hy
  obtain ⟨x, e, rfl, hSx, he, hb, hx⟩ := hy
  exact (generatedMap_identities hS hM hSx e he hb hx).2

/-- **In finite dimensions the generated map is a local diffeomorphism.** Near `(q₀, ∂_q S(x₀))`
the derivative of the map generated by `S` is invertible: it preserves the nondegenerate form `ω`,
so it is injective, and the invertible mixed Hessian `W ≃ V'` makes source and target of the same
dimension. -/
theorem eventually_isInvertible_fderiv_cotangentGeneratedMap [FiniteDimensional ℝ V]
    [FiniteDimensional ℝ W] :
    ∀ᶠ y in 𝓝 (cotangentGeneratingSource S x₀),
      (fderiv ℝ (cotangentGeneratedMap hS hM) y).IsInvertible := by
  have hW : Module.finrank ℝ W = Module.finrank ℝ V := by
    obtain ⟨e, -⟩ := hM
    exact e.toLinearEquiv.finrank_eq.trans ContinuousLinearMap.dual_finrank_eq
  have hdim : Module.finrank ℝ (V × StrongDual ℝ V) = Module.finrank ℝ (W × StrongDual ℝ W) := by
    simp only [Module.finrank_prod, ContinuousLinearMap.dual_finrank_eq, hW]
  filter_upwards [eventually_strongDualCotangentSymplecticForm_fderiv_cotangentGeneratedMap hS hM]
    with y hy
  have hinj : Function.Injective (fderiv ℝ (cotangentGeneratedMap hS hM) y) := by
    refine (injective_iff_map_eq_zero _).2 fun u hu ↦
      strongDualCotangentSymplecticForm.separatingLeft u fun v ↦ ?_
    rw [← hy u v, hu]
    simp
  exact ⟨((fderiv ℝ (cotangentGeneratedMap hS hM) y : _ →ₗ[ℝ] _).linearEquivOfInjective hinj
    hdim).toContinuousLinearEquiv, ContinuousLinearMap.ext fun _ ↦ by simp⟩

end Generated

/-! ### The free particle -/

section FreeParticle

open InnerProductSpace
open scoped RealInnerProductSpace

variable {E : Type*} [NormedAddCommGroup E]

/-- The generating function `S(q, Q) = -‖q - Q‖² / (2t)` of the free motion for time `t` of a
particle of unit mass. -/
def freeParticleGeneratingFunction (t : ℝ) (x : E × E) : ℝ :=
  -‖x.1 - x.2‖ ^ 2 / (2 * t)

theorem freeParticleGeneratingFunction_apply (t : ℝ) (x : E × E) :
    freeParticleGeneratingFunction t x = -‖x.1 - x.2‖ ^ 2 / (2 * t) :=
  (rfl)

variable [InnerProductSpace ℝ E]

theorem contDiff_freeParticleGeneratingFunction {n : WithTop ℕ∞} (t : ℝ) :
    ContDiff ℝ n (freeParticleGeneratingFunction (E := E) t) :=
  ((contDiff_norm_sq ℝ).comp (contDiff_fst.sub contDiff_snd)).neg.div_const _

/-- The derivative of the free-particle generating function, as a function of the base point. -/
private theorem fderiv_freeParticleGeneratingFunction_eq_linearMap (t : ℝ) :
    fderiv ℝ (freeParticleGeneratingFunction (E := E) t) =
      ⇑((-t⁻¹) • (precomp ℝ (fst ℝ E E - snd ℝ E E)).comp
        ((innerSL ℝ : E →L[ℝ] StrongDual ℝ E).comp (fst ℝ E E - snd ℝ E E))) := by
  funext y
  set L := fst ℝ E E - snd ℝ E E
  have h : HasFDerivAt (fun y ↦ ‖L y‖ ^ 2) (2 • (innerSL ℝ (L y)).comp L) y :=
    HasFDerivAt.norm_sq L.hasFDerivAt
  have hS : freeParticleGeneratingFunction (E := E) t = fun y ↦ -(2 * t)⁻¹ * ‖L y‖ ^ 2 := by
    funext y
    simp [freeParticleGeneratingFunction_apply, L, div_eq_inv_mul]
  rw [hS, (h.const_mul _).fderiv]
  refine ContinuousLinearMap.ext fun u ↦ ?_
  simp only [_root_.smul_apply, coe_comp, Function.comp_apply, precomp_apply,
    innerSL_apply_apply, smul_eq_mul, nsmul_eq_mul]
  ring

/-- The derivative of `S(q, Q) = -‖q - Q‖² / (2t)` applied to a variation `(δq, δQ)`. -/
theorem fderiv_freeParticleGeneratingFunction (t : ℝ) (y u : E × E) :
    fderiv ℝ (freeParticleGeneratingFunction t) y u =
      -t⁻¹ * ⟪y.1 - y.2, u.1 - u.2⟫ := by
  simp only [fderiv_freeParticleGeneratingFunction_eq_linearMap, _root_.smul_apply, coe_comp,
    Function.comp_apply, precomp_apply, _root_.sub_apply, coe_fst', coe_snd', innerSL_apply_apply,
    smul_eq_mul]

/-- The mixed Hessian of the free-particle generating function is `t⁻¹ ⟪δQ, δq⟫`. -/
theorem cotangentMixedHessian_freeParticleGeneratingFunction_apply_apply (t : ℝ) (x : E × E)
    (b a : E) : cotangentMixedHessian (freeParticleGeneratingFunction t) x b a = t⁻¹ * ⟪b, a⟫ := by
  rw [cotangentMixedHessian_apply_apply, fderiv_freeParticleGeneratingFunction_eq_linearMap,
    ContinuousLinearMap.fderiv]
  simp only [_root_.smul_apply, coe_comp, Function.comp_apply, precomp_apply, _root_.sub_apply,
    coe_fst', coe_snd', innerSL_apply_apply, smul_eq_mul, zero_sub, sub_zero, inner_neg_left,
    mul_neg, neg_mul, neg_neg]

variable [CompleteSpace E]

/-- The source projection of the free-particle generating function: `p = (Q - q)♭ / t`, where
`v♭ = ⟪v, ·⟫`. -/
@[simp]
theorem cotangentGeneratingSource_freeParticleGeneratingFunction (t : ℝ) (q Q : E) :
    cotangentGeneratingSource (freeParticleGeneratingFunction t) (q, Q) =
      (q, t⁻¹ • toDual ℝ E (Q - q)) := by
  ext a
  · simp
  · simp only [cotangentGeneratingSource_snd_apply, fderiv_freeParticleGeneratingFunction,
      _root_.smul_apply, smul_eq_mul, sub_zero, toDual_apply_apply]
    rw [← neg_sub Q q, inner_neg_left]
    ring

/-- The target projection of the free-particle generating function: `P = (Q - q)♭ / t`. -/
@[simp]
theorem cotangentGeneratingTarget_freeParticleGeneratingFunction (t : ℝ) (q Q : E) :
    cotangentGeneratingTarget (freeParticleGeneratingFunction t) (q, Q) =
      (Q, t⁻¹ • toDual ℝ E (Q - q)) := by
  ext b
  · simp
  · simp only [cotangentGeneratingTarget_snd_apply, fderiv_freeParticleGeneratingFunction,
      _root_.smul_apply, smul_eq_mul, zero_sub, toDual_apply_apply]
    rw [← neg_sub Q q, inner_neg_left, inner_neg_right, neg_neg]
    ring

variable {t : ℝ}

/-- For `t ≠ 0` the mixed Hessian of the free-particle generating function is invertible: it is
`t⁻¹` times the Riesz isomorphism. -/
theorem isInvertible_cotangentMixedHessian_freeParticleGeneratingFunction (ht : t ≠ 0)
    (x : E × E) : (cotangentMixedHessian (freeParticleGeneratingFunction t) x).IsInvertible := by
  let e : E ≃L[ℝ] StrongDual ℝ E := (toDual ℝ E).toContinuousLinearEquiv
  refine ⟨(Units.mk0 t⁻¹ (inv_ne_zero ht)) • e,
    ContinuousLinearMap.ext fun b ↦ ContinuousLinearMap.ext fun a ↦ ?_⟩
  simpa [e] using (cotangentMixedHessian_freeParticleGeneratingFunction_apply_apply t x b a).symm

/-- **The free particle.** The generating function `-‖q - Q‖² / (2t)` relates `(q, p)` to
`(q + t p♯, p)`, where `p♯` is the Riesz representative of `p`. -/
theorem cotangentGeneratingTarget_freeParticleGeneratingFunction_eq_cotangentGeneratingSource
    (ht : t ≠ 0) (x : E × E) :
    cotangentGeneratingTarget (freeParticleGeneratingFunction t) x =
      ((cotangentGeneratingSource (freeParticleGeneratingFunction t) x).1 +
          t • (toDual ℝ E).symm (cotangentGeneratingSource (freeParticleGeneratingFunction t) x).2,
        (cotangentGeneratingSource (freeParticleGeneratingFunction t) x).2) := by
  obtain ⟨q, Q⟩ := x
  have h : (toDual ℝ E).symm (t⁻¹ • toDual ℝ E (Q - q)) = t⁻¹ • (Q - q) :=
    ext_inner_right ℝ fun a ↦ by simp [real_inner_smul_left]
  rw [cotangentGeneratingSource_freeParticleGeneratingFunction,
    cotangentGeneratingTarget_freeParticleGeneratingFunction, h, smul_smul, mul_inv_cancel₀ ht,
    one_smul, add_sub_cancel]

/-- **The map generated by the free-particle generating function** is, near
each point, the free motion `(q, p) ↦ (q + t p♯, p)`. -/
theorem cotangentGeneratedMap_freeParticleGeneratingFunction_eventuallyEq (ht : t ≠ 0)
    {x₀ : E × E} (hS : ContDiffAt ℝ 2 (freeParticleGeneratingFunction t) x₀)
    (hM : (cotangentMixedHessian (freeParticleGeneratingFunction t) x₀).IsInvertible) :
    cotangentGeneratedMap hS hM
      =ᶠ[𝓝 (cotangentGeneratingSource (freeParticleGeneratingFunction t) x₀)]
        fun y ↦ (y.1 + t • (toDual ℝ E).symm y.2, y.2) := by
  filter_upwards [eventually_cotangentGeneratingSource_cotangentGeneratingBranch hS hM] with y hy
  rw [cotangentGeneratedMap_def, Function.comp_apply,
    cotangentGeneratingTarget_freeParticleGeneratingFunction_eq_cotangentGeneratingSource ht, hy]

end FreeParticle

end TauCeti
