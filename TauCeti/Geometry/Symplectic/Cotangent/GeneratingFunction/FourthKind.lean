module

public import TauCeti.Geometry.Symplectic.Cotangent.GeneratingFunction.Basic

/-!
# Generating functions of the fourth kind

For a first-kind generating function `S(q,Q)`, put `p = ∂_q S` and `P = -∂_Q S`.
When the signed full Hessian is invertible, the momentum projection `(q,Q) ↦ (p,P)`
is a local change of coordinates. On its inverse branch define
`F₄(p,P) = S(q,Q) - p(q) + P(Q)`.

This file constructs the momentum chart, specifies its open source and target, and
proves uniqueness of the inverse germ and the transition formula
`dF₄(δp,δP) = -δp(q) + δP(Q)`. In particular `q = -∂_p F₄` and `Q = ∂_P F₄`,
expressed by evaluation on covectors without identifying a space with its double dual.
The full Hessian condition is separate from the mixed Hessian condition for a
generated canonical transformation: this construction changes coordinates on the
generated relation even when its source projection is singular.

The statements apply to real Banach spaces, hence to finite-dimensional cotangent
models. Values of the transform outside the chart target carry no geometric meaning.
The local inverse construction follows the second-kind chart in
`TauCeti.Geometry.Symplectic.Cotangent.GeneratingFunction.Legendre`, using Mathlib's
inverse function theorem directly for the full momentum projection.

## References

* V. I. Arnold, *Mathematical Methods of Classical Mechanics*, second edition,
  Springer, 1989, §48 (generating functions).
-/

public section

noncomputable section

open ContinuousLinearMap Filter
open scoped Topology

namespace TauCeti

variable {V W : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
  [NormedAddCommGroup W] [NormedSpace ℝ W]

/-- The momentum projection of the relation generated by `S`:
`(q,Q) ↦ (∂_q S, -∂_Q S)`. -/
def cotangentMomentumProjection (S : V × W → ℝ) (x : V × W) :
    StrongDual ℝ V × StrongDual ℝ W :=
  ((cotangentGeneratingSource S x).2, (cotangentGeneratingTarget S x).2)

@[simp]
theorem cotangentMomentumProjection_fst (S : V × W → ℝ) (x : V × W) :
    (cotangentMomentumProjection S x).1 = (cotangentGeneratingSource S x).2 :=
  (rfl)

@[simp]
theorem cotangentMomentumProjection_snd (S : V × W → ℝ) (x : V × W) :
    (cotangentMomentumProjection S x).2 = (cotangentGeneratingTarget S x).2 :=
  (rfl)

/-- The full Hessian with the target momentum sign reversed. Its invertibility
is the nondegeneracy condition for the fourth-kind momentum chart. -/
def cotangentMomentumHessian (S : V × W → ℝ) (x : V × W) :
    (V × W) →L[ℝ] StrongDual ℝ V × StrongDual ℝ W :=
  (precomp ℝ (inl ℝ V W) ∘L fderiv ℝ (fderiv ℝ S) x).prod
    (-(precomp ℝ (inr ℝ V W) ∘L fderiv ℝ (fderiv ℝ S) x))

@[simp]
theorem cotangentMomentumHessian_apply (S : V × W → ℝ) (x u : V × W) :
    cotangentMomentumHessian S x u =
      ((fderiv ℝ (fderiv ℝ S) x u).comp (inl ℝ V W),
        -(fderiv ℝ (fderiv ℝ S) x u).comp (inr ℝ V W)) :=
  (rfl)

variable {S : V × W → ℝ} {x : V × W}

/-- A `C^(n+1)` generating function has a `C^n` momentum projection. -/
theorem contDiffAt_cotangentMomentumProjection {n : WithTop ℕ∞}
    (hS : ContDiffAt ℝ (n + 1) S x) : ContDiffAt ℝ n (cotangentMomentumProjection S) x :=
  (contDiffAt_cotangentGeneratingSource hS).snd.prodMk
    (contDiffAt_cotangentGeneratingTarget hS).snd

/-- The derivative of the momentum projection is the signed full Hessian. -/
theorem hasFDerivAt_cotangentMomentumProjection
    (hS : DifferentiableAt ℝ (fderiv ℝ S) x) :
    HasFDerivAt (cotangentMomentumProjection S) (cotangentMomentumHessian S x) x :=
  (hasFDerivAt_cotangentGeneratingSource hS).snd.prodMk
    (hasFDerivAt_cotangentGeneratingTarget hS).snd

private theorem hasStrictFDerivAt_momentumDerivEquiv (hS : ContDiffAt ℝ 2 S x)
    (hH : (cotangentMomentumHessian S x).IsInvertible) :
    HasStrictFDerivAt (cotangentMomentumProjection S)
      (hH.choose : (V × W) →L[ℝ] StrongDual ℝ V × StrongDual ℝ W) x := by
  rw [hH.choose_spec, ← (hasFDerivAt_cotangentMomentumProjection
    ((hS.fderiv_right (m := 1) le_rfl).differentiableAt one_ne_zero)).fderiv]
  exact (contDiffAt_cotangentMomentumProjection (n := 1) hS).hasStrictFDerivAt one_ne_zero

section Chart

variable [CompleteSpace V] [CompleteSpace W] {x₀ : V × W}

/-- The fourth-kind coordinate chart `(q,Q) ↦ (p,P)` near a point with
invertible signed full Hessian. Its source and target are open neighborhoods. -/
def cotangentMomentumChart (hS : ContDiffAt ℝ 2 S x₀)
    (hH : (cotangentMomentumHessian S x₀).IsInvertible) :
    OpenPartialHomeomorph (V × W) (StrongDual ℝ V × StrongDual ℝ W) :=
  (hasStrictFDerivAt_momentumDerivEquiv hS hH).toOpenPartialHomeomorph _

variable (hS : ContDiffAt ℝ 2 S x₀) (hH : (cotangentMomentumHessian S x₀).IsInvertible)

@[simp]
theorem coe_cotangentMomentumChart :
    ⇑(cotangentMomentumChart hS hH) = cotangentMomentumProjection S :=
  (rfl)

/-- The base point belongs to the position-coordinate domain. -/
theorem mem_cotangentMomentumChart_source : x₀ ∈ (cotangentMomentumChart hS hH).source :=
  (hasStrictFDerivAt_momentumDerivEquiv hS hH).mem_toOpenPartialHomeomorph_source

/-- Its momentum projection belongs to the momentum-coordinate domain. -/
theorem image_mem_cotangentMomentumChart_target :
    cotangentMomentumProjection S x₀ ∈ (cotangentMomentumChart hS hH).target :=
  (hasStrictFDerivAt_momentumDerivEquiv hS hH).image_mem_toOpenPartialHomeomorph_target

/-- The inverse momentum chart has the regularity of the first derivatives of `S`. -/
theorem contDiffAt_cotangentMomentumChart_symm {n : WithTop ℕ∞}
    (hSn : ContDiffAt ℝ (n + 1) S x₀) (hn : n ≠ 0) :
    ContDiffAt ℝ n (cotangentMomentumChart hS hH).symm (cotangentMomentumProjection S x₀) :=
  (contDiffAt_cotangentMomentumProjection hSn).to_localInverse
    (hasStrictFDerivAt_momentumDerivEquiv hS hH).hasFDerivAt hn

/-- Any local inverse of the momentum projection agrees with this branch as a germ. -/
theorem eventuallyEq_cotangentMomentumChart_symm
    {g : StrongDual ℝ V × StrongDual ℝ W → V × W}
    (hg : ∀ᶠ x in 𝓝 x₀, g (cotangentMomentumProjection S x) = x) :
    g =ᶠ[𝓝 (cotangentMomentumProjection S x₀)] (cotangentMomentumChart hS hH).symm :=
  (hasStrictFDerivAt_momentumDerivEquiv hS hH).localInverse_unique hg

/-- The fourth-kind transform `F₄(p,P) = S(q,Q) - p(q) + P(Q)` on the
inverse momentum branch. Only its restriction to the momentum chart target
represents a change of generating function. -/
def cotangentFourthKind (y : StrongDual ℝ V × StrongDual ℝ W) : ℝ :=
  S ((cotangentMomentumChart hS hH).symm y) -
    y.1 ((cotangentMomentumChart hS hH).symm y).1 +
    y.2 ((cotangentMomentumChart hS hH).symm y).2

theorem cotangentFourthKind_def (y : StrongDual ℝ V × StrongDual ℝ W) :
    cotangentFourthKind hS hH y =
      S ((cotangentMomentumChart hS hH).symm y) -
        y.1 ((cotangentMomentumChart hS hH).symm y).1 +
        y.2 ((cotangentMomentumChart hS hH).symm y).2 :=
  (rfl)

/-- The value transition formula in the original position coordinates. -/
theorem cotangentFourthKind_cotangentMomentumProjection {x : V × W}
    (hx : x ∈ (cotangentMomentumChart hS hH).source) :
    cotangentFourthKind hS hH (cotangentMomentumProjection S x) =
      S x - (cotangentGeneratingSource S x).2 x.1 +
        (cotangentGeneratingTarget S x).2 x.2 := by
  have hb : (cotangentMomentumChart hS hH).symm (cotangentMomentumProjection S x) = x := by
    simpa only [coe_cotangentMomentumChart] using (cotangentMomentumChart hS hH).left_inv hx
  rw [cotangentFourthKind_def, hb, cotangentMomentumProjection_fst,
    cotangentMomentumProjection_snd]

/-- The fourth-kind transform has the regularity of the first derivatives of `S`. -/
theorem contDiffAt_cotangentFourthKind {n : WithTop ℕ∞}
    (hSn : ContDiffAt ℝ (n + 1) S x₀) (hn : n ≠ 0) :
    ContDiffAt ℝ n (cotangentFourthKind hS hH) (cotangentMomentumProjection S x₀) := by
  have hb := contDiffAt_cotangentMomentumChart_symm hS hH hSn hn
  have hx : (cotangentMomentumChart hS hH).symm (cotangentMomentumProjection S x₀) = x₀ :=
    (hasStrictFDerivAt_momentumDerivEquiv hS hH).localInverse_apply_image
  exact (((hx ▸ hSn.of_le (by simp)).comp _ hb).sub
    (contDiffAt_fst.clm_apply hb.fst)).add (contDiffAt_snd.clm_apply hb.snd)

/-- **The fourth-kind transition identities.** Near the distinguished momentum point,
`dF₄(δp,δP) = -δp(q) + δP(Q)`, where `(q,Q)` is the inverse momentum branch. -/
theorem eventually_fderiv_cotangentFourthKind :
    ∀ᶠ y in 𝓝 (cotangentMomentumProjection S x₀), ∀ u : StrongDual ℝ V × StrongDual ℝ W,
      fderiv ℝ (cotangentFourthKind hS hH) y u =
        -u.1 ((cotangentMomentumChart hS hH).symm y).1 +
          u.2 ((cotangentMomentumChart hS hH).symm y).2 := by
  let b := (cotangentMomentumChart hS hH).symm
  have hb := contDiffAt_cotangentMomentumChart_symm hS hH hS one_ne_zero
  have hi : ∀ᶠ y in 𝓝 (cotangentMomentumProjection S x₀),
      cotangentMomentumProjection S (b y) = y :=
    (hasStrictFDerivAt_momentumDerivEquiv hS hH).eventually_right_inverse
  have hs : ∀ᶠ y in 𝓝 (cotangentMomentumProjection S x₀), ContDiffAt ℝ 2 S (b y) :=
    (hasStrictFDerivAt_momentumDerivEquiv hS hH).localInverse_tendsto.eventually
      (hS.eventually (by simp))
  filter_upwards [hb.eventually (by simp), hs, hi] with y hby hSy hiy
  have hb' : DifferentiableAt ℝ b y := hby.differentiableAt one_ne_zero
  have hp (a : V) : fderiv ℝ S (b y) (a, 0) = y.1 a := by
    simpa only [cotangentMomentumProjection_fst, cotangentGeneratingSource_snd_apply] using
      congrArg (fun z : StrongDual ℝ V × StrongDual ℝ W ↦ z.1 a) hiy
  have hP (c : W) : fderiv ℝ S (b y) (0, c) = -y.2 c := by
    have h := congrArg (fun z : StrongDual ℝ V × StrongDual ℝ W ↦ z.2 c) hiy
    simpa only [cotangentMomentumProjection_snd, cotangentGeneratingTarget_snd_apply,
      neg_eq_iff_eq_neg] using h
  have hd := (((hSy.differentiableAt two_ne_zero).hasFDerivAt.comp y hb'.hasFDerivAt).sub
    (hasFDerivAt_fst.clm_apply hb'.hasFDerivAt.fst)).add
      (hasFDerivAt_snd.clm_apply hb'.hasFDerivAt.snd)
  simp only [Function.comp_def, Pi.sub_def, Pi.add_def] at hd
  have hdef : cotangentFourthKind hS hH = fun z ↦ S (b z) - z.1 (b z).1 + z.2 (b z).2 :=
    funext (cotangentFourthKind_def hS hH)
  intro u
  rw [hdef, hd.fderiv]
  have hsplit (v : V × W) : fderiv ℝ S (b y) v = y.1 v.1 - y.2 v.2 := by
    have hv : v = (v.1, 0) + (0, v.2) := by simp
    rw [hv, map_add, hp, hP]
    simp [sub_eq_add_neg]
  simp only [_root_.add_apply, _root_.sub_apply, coe_comp, Function.comp_apply,
    coe_fst', coe_snd', flip_apply]
  rw [hsplit]
  ring

end Chart

end TauCeti
