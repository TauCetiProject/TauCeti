/-!
# The Lagrangian correspondence generated by a function on a product of manifolds

A smooth real function `S(q, Q)` on a product `M × N` of manifolds generates the cotangent
relation

`p = d_q S(q, Q)`, `P = -d_Q S(q, Q)`

between `T*M` and `T*N`. It is parametrized by `(q, Q)` through its source projection
`(q, Q) ↦ (q, d_q S)` (`TauCeti.CotangentBundle.generatingSource`) and its target projection
`(q, Q) ↦ (Q, -d_Q S)` (`TauCeti.CotangentBundle.generatingTarget`); together they form the map
`TauCeti.CotangentBundle.generatingCorrespondence I J S : M × N → T*M × T*N`. This is the manifold
version of the linear relation of `TauCeti.cotangentGeneratingSource` and
`TauCeti.cotangentGeneratingTarget`.

* The relation is the graph of `dS` in `T*(M × N)` with the second covector reversed: the
  identification `T*(M × N) ≃ T*M × T*N` of `TauCeti.CotangentBundle.prodDiffeomorph` sends the
  covector `dS` at `(q, Q)` to the pair `(d_q S, d_Q S)`
  (`TauCeti.CotangentBundle.prodDiffeomorph_mk_mvfderiv`).
* On `T*M × T*N`, the one-form `pr₁^*λ_M - pr₂^*λ_N` is a primitive of the twisted product
  `pr₁^*ω_M - pr₂^*ω_N` of the canonical symplectic forms
  (`TauCeti.CotangentBundle.twistedProd_symplecticForm`), and the relation pulls it back to `dS`
  (`TauCeti.CotangentBundle.mpullback_generatingCorrespondence_liouvilleForm`).
* Hence, for finite-dimensional `M` and `N`, the relation is an exact Lagrangian map for this
  primitive with primitive `S`
  (`TauCeti.CotangentBundle.isExactLagrangianMap_generatingCorrespondence`). Since the pair of
  base points is a smooth left inverse, for boundaryless `M` and `N` it is a smooth embedding, so
  it is a Lagrangian correspondence `T*M ⇝ T*N`
  (`TauCeti.CotangentBundle.isLagrangianEmbedding_generatingCorrespondence`).
* Exchanging the factors and replacing `S` by `(Q, q) ↦ -S(q, Q)`
  (`TauCeti.cotangentGeneratingReverse`) generates the transposed relation
  (`TauCeti.CotangentBundle.generatingCorrespondence_cotangentGeneratingReverse`).

No nondegeneracy of the mixed Hessian is needed for these statements: they concern the relation as
a submanifold of `T*M × T*N`, not its local description as the graph of a canonical
transformation.

## References

* V. I. Arnold, *Mathematical Methods of Classical Mechanics*, second edition, Springer, 1989,
  §48 (generating functions).
* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Section 4 (generating functions).
* A. Weinstein, *Symplectic categories*, Portugaliae Mathematica 67 (2010), 261–278.
-/

public section

noncomputable section

open Bundle Manifold Module
open scoped Manifold ContDiff

namespace TauCeti.CotangentBundle

variable {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  {F H' : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [TopologicalSpace H']
  {J : ModelWithCorners ℝ F H'} {N : Type*} [TopologicalSpace N] [ChartedSpace H' N]
  {S : M × N → ℝ}

/-! ### The two projections of the generated relation -/

variable (I) in
/-- The **source projection** `(q, Q) ↦ (q, d_q S)` of the cotangent relation generated by a real
function `S` on `M × N`: the covector at `q` is the differential of `S(·, Q)`. -/
def generatingSource (S : M × N → ℝ) (x : M × N) : CotangentBundle I M :=
  TotalSpace.mk' (E →L[ℝ] ℝ) x.1 (mvfderiv I (fun q ↦ S (q, x.2)) x.1)

variable (J) in
/-- The **target projection** `(q, Q) ↦ (Q, -d_Q S)` of the cotangent relation generated by a real
function `S` on `M × N`: the covector at `Q` is minus the differential of `S(q, ·)`. -/
def generatingTarget (S : M × N → ℝ) (x : M × N) : CotangentBundle J N :=
  TotalSpace.mk' (F →L[ℝ] ℝ) x.2 (-mvfderiv J (fun Q ↦ S (x.1, Q)) x.2)

variable (I J) in
/-- The **cotangent relation generated by** a real function `S` on `M × N`, parametrized by
`(q, Q)` as `((q, d_q S), (Q, -d_Q S)) ∈ T*M × T*N`. For smooth `S` on finite-dimensional
boundaryless manifolds it is a Lagrangian correspondence `T*M ⇝ T*N`
(`TauCeti.CotangentBundle.isLagrangianEmbedding_generatingCorrespondence`). -/
def generatingCorrespondence (S : M × N → ℝ) (x : M × N) :
    CotangentBundle I M × CotangentBundle J N :=
  (generatingSource I S x, generatingTarget J S x)

omit [TopologicalSpace N] in
/-- The source projection lies over the first base point. -/
@[simp]
theorem proj_generatingSource (x : M × N) : (generatingSource I S x).proj = x.1 :=
  (rfl)

omit [TopologicalSpace N] in
/-- The source projection carries the differential of `S` in the first variable. -/
@[simp]
theorem generatingSource_snd (x : M × N) :
    (generatingSource I S x).2 = mvfderiv I (fun q ↦ S (q, x.2)) x.1 :=
  (rfl)

omit [TopologicalSpace M] in
/-- The target projection lies over the second base point. -/
@[simp]
theorem proj_generatingTarget (x : M × N) : (generatingTarget J S x).proj = x.2 :=
  (rfl)

omit [TopologicalSpace M] in
/-- The target projection carries minus the differential of `S` in the second variable. -/
@[simp]
theorem generatingTarget_snd (x : M × N) :
    (generatingTarget J S x).2 = -mvfderiv J (fun Q ↦ S (x.1, Q)) x.2 :=
  (rfl)

/-- The generated relation is the pair of its source and target projections. -/
@[simp]
theorem generatingCorrespondence_apply (x : M × N) :
    generatingCorrespondence I J S x = (generatingSource I S x, generatingTarget J S x) :=
  (rfl)

/-- **Transposing a generated relation.** The function `(Q, q) ↦ -S(q, Q)` on `N × M` generates
the transpose of the relation generated by `S`: its source and target projections are the target
and source projections of `S`. -/
theorem generatingCorrespondence_cotangentGeneratingReverse (y : N × M) :
    generatingCorrespondence J I (cotangentGeneratingReverse S) y =
      (generatingCorrespondence I J S y.swap).swap := by
  -- `d(-f) = -df` holds for every function, differentiable or not.
  refine Prod.ext (congrArg (TotalSpace.mk' (F →L[ℝ] ℝ) y.1) ?_)
    (congrArg (TotalSpace.mk' (E →L[ℝ] ℝ) y.2) ?_) <;>
    simp only [cotangentGeneratingReverse_apply, Prod.swap_prod_mk, mvfderiv_fun_neg, neg_neg,
      Prod.fst_swap, Prod.snd_swap]

/-! ### The relation as the graph of `dS` -/

variable [IsManifold I 2 M] [IsManifold J 2 N]

/-- **The generated relation is the graph of `dS` with the second covector reversed.** The
identification `T*(M × N) ≃ T*M × T*N` sends the covector `dS` at `x = (q, Q)` to the pair
`(d_q S, d_Q S)`, whose first component is the source projection of the generated relation and
whose second component is the negative of the covector of its target projection. -/
theorem prodDiffeomorph_mk_mvfderiv {x : M × N} (hS : MDifferentiableAt (I.prod J) 𝓘(ℝ) S x) :
    prodDiffeomorph I J M N (TotalSpace.mk' (E × F →L[ℝ] ℝ) x (mvfderiv (I.prod J) S x)) =
      (generatingSource I S x,
        TotalSpace.mk' (F →L[ℝ] ℝ) x.2 (mvfderiv J (fun Q ↦ S (x.1, Q)) x.2)) := by
  -- Each component is the restriction of `dS` along a slice inclusion, by the chain rule.
  refine Prod.ext ((prodDiffeomorph_fst _).trans (TotalSpace.ext rfl (heq_of_eq ?_)))
    ((prodDiffeomorph_snd _).trans (TotalSpace.ext rfl (heq_of_eq ?_)))
  · ext v
    exact (mvfderiv_comp_apply_of_eq x.1 hS (mdifferentiableAt_id.prodMk mdifferentiableAt_const)
      rfl v).symm
  · ext v
    exact (mvfderiv_comp_apply_of_eq x.2 hS (mdifferentiableAt_const.prodMk mdifferentiableAt_id)
      rfl v).symm

/-- The source projection of the relation generated by a smooth function is smooth. -/
theorem contMDiff_generatingSource (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S) :
    ContMDiff (I.prod J) (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) ∞ (generatingSource I S) :=
  (ContMDiff.contMDiff_totalSpaceMk_mvfderiv_uncurry (f := fun Q q ↦ S (q, Q)) (n := ∞)
    (hS.comp (contMDiff_snd.prodMk contMDiff_fst))).comp (contMDiff_snd.prodMk contMDiff_fst)

/-- The target projection of the relation generated by a smooth function is smooth. -/
theorem contMDiff_generatingTarget (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S) :
    ContMDiff (I.prod J) (J.prod 𝓘(ℝ, F →L[ℝ] ℝ)) ∞ (generatingTarget J S) := by
  have h := (vectorBundleScalarDiffeomorph (I := J) (F := F →L[ℝ] ℝ)
    (V := fun y : N ↦ TangentSpace J y →L[ℝ] ℝ) (fun _ ↦ (-1 : ℝ)) (contMDiff_const (n := ∞))
    fun _ ↦ by norm_num).contMDiff.comp
      (ContMDiff.contMDiff_totalSpaceMk_mvfderiv_uncurry (f := fun q Q ↦ S (q, Q)) (n := ∞) hS)
  -- Reversing the fibre of `(q, Q) ↦ (Q, d_Q S)` gives the target.
  refine h.congr fun x ↦ ?_
  rw [Function.comp_apply, vectorBundleScalarDiffeomorph_apply]
  exact TotalSpace.ext rfl (heq_of_eq (neg_one_smul ℝ _).symm)

/-- The relation generated by a smooth function is smooth. -/
theorem contMDiff_generatingCorrespondence (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S) :
    ContMDiff (I.prod J) ((I.prod 𝓘(ℝ, E →L[ℝ] ℝ)).prod (J.prod 𝓘(ℝ, F →L[ℝ] ℝ))) ∞
      (generatingCorrespondence I J S) :=
  (contMDiff_generatingSource hS).prodMk (contMDiff_generatingTarget hS)

/-! ### Exactness -/

/-- **The generated relation is exact with primitive `S`.** The relation generated by a smooth
function `S` pulls the one-form `pr₁^*λ_M - pr₂^*λ_N` on `T*M × T*N` back to `dS`. -/
theorem mpullback_generatingCorrespondence_liouvilleForm
    (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S) :
    mpullback (I.prod J) ((I.prod 𝓘(ℝ, E →L[ℝ] ℝ)).prod (J.prod 𝓘(ℝ, F →L[ℝ] ℝ)))
        (generatingCorrespondence I J S)
        (SmoothForm.mpullback Prod.fst contMDiff_fst (liouvilleForm I M) -
          SmoothForm.mpullback Prod.snd contMDiff_snd (liouvilleForm J N)).1 =
      mextDeriv (RoughForm.ofFunction (I.prod J) S) := by
  have hf := contMDiff_generatingCorrespondence hS
  rw [← SmoothForm.coe_mpullback _ hf, map_sub, SmoothForm.mpullback_mpullback,
    SmoothForm.mpullback_mpullback]
  funext x
  ext v
  rw [Submodule.coe_sub, Pi.sub_apply, ContinuousAlternatingMap.sub_apply,
    SmoothForm.coe_mpullback, SmoothForm.coe_mpullback,
    mpullback_liouvilleForm_apply_of_proj_comp_eq (ψ := Prod.fst ∘ generatingCorrespondence I J S)
      (g := Prod.fst) (fun _ ↦ rfl)
      ((contMDiff_generatingSource hS x).mdifferentiableAt (by simp)),
    mpullback_liouvilleForm_apply_of_proj_comp_eq (ψ := Prod.snd ∘ generatingCorrespondence I J S)
      (g := Prod.snd) (fun _ ↦ rfl)
      ((contMDiff_generatingTarget hS x).mdifferentiableAt (by simp)),
    mextDeriv_ofFunction, ContinuousAlternatingMap.ofSubsingleton_apply_apply,
    ((hS x).mdifferentiableAt (by simp)).mvfderiv_prod_eq_add_apply, mfderiv_fst, mfderiv_snd,
    sub_eq_add_neg]
  -- The two partial differentials of `S` add up to `dS`. The covectors live in fibres that depend
  -- on the point, so the projection lemmas are applied by `DFunLike.congr_fun`, not rewritten.
  exact congrArg₂ (· + ·) (DFunLike.congr_fun (generatingSource_snd (I := I) (S := S) x) _)
    ((congrArg Neg.neg ((DFunLike.congr_fun (generatingTarget_snd (J := J) (S := S) x) _).trans
      (neg_apply (mvfderiv J (fun Q ↦ S (x.1, Q)) x.2) _))).trans (neg_neg _))

/-! ### The relation as a Lagrangian correspondence -/

section Symplectic

variable [IsManifold I ∞ M] [IsManifold J ∞ N] [FiniteDimensional ℝ E] [FiniteDimensional ℝ F]

/-- **The generated relation is an exact Lagrangian map.** On finite-dimensional manifolds, the
relation generated by a smooth function `S` is an exact Lagrangian map into `T*M × T*N` for the
twisted product `pr₁^*ω_M - pr₂^*ω_N` and its primitive `pr₁^*λ_M - pr₂^*λ_N`, with primitive
`S`. -/
theorem isExactLagrangianMap_generatingCorrespondence (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S) :
    ((isSymplectic_symplecticForm (I := I) (M := M)).isNondegenerate.twistedProd
        (isSymplectic_symplecticForm (I := J) (M := N)).isNondegenerate).IsExactLagrangianMap
      (I.prod J)
      (SmoothForm.mpullback Prod.fst contMDiff_fst (liouvilleForm I M) -
        SmoothForm.mpullback Prod.snd contMDiff_snd (liouvilleForm J N))
      (generatingCorrespondence I J S) S := by
  refine (SmoothTwoForm.IsNondegenerate.isExactLagrangianMap_iff_of_finrank
    (twistedProd_symplecticForm I M J N) (contMDiff_generatingCorrespondence hS) (fun x ↦ ?_)
    ?_).mpr ⟨hS, mpullback_generatingCorrespondence_liouvilleForm hS⟩
  · -- The pair of base points is a left inverse of the relation.
    exact mfderiv_injective_of_leftInverse (g := Prod.map TotalSpace.proj TotalSpace.proj)
      (((contMDiff_proj _).prodMap (contMDiff_proj _) _).mdifferentiableAt one_ne_zero)
      ((contMDiff_generatingCorrespondence hS x).mdifferentiableAt (by simp)) fun _ ↦ rfl
  · simp only [finrank_prod, ContinuousLinearMap.dual_finrank_eq]
    ring

/-- **The generated relation is a Lagrangian correspondence.** On finite-dimensional boundaryless
manifolds, the relation `(q, Q) ↦ ((q, d_q S), (Q, -d_Q S))` generated by a smooth function `S` is
a Lagrangian embedding of `M × N` into `T*M × T*N` for the twisted product
`pr₁^*ω_M - pr₂^*ω_N`, that is, a Lagrangian correspondence `T*M ⇝ T*N`. -/
theorem isLagrangianEmbedding_generatingCorrespondence [I.Boundaryless] [J.Boundaryless]
    (hS : ContMDiff (I.prod J) 𝓘(ℝ) ∞ S) :
    ((isSymplectic_symplecticForm (I := I) (M := M)).isNondegenerate.twistedProd
        (isSymplectic_symplecticForm (I := J) (M := N)).isNondegenerate).IsLagrangianEmbedding
      (I.prod J) (generatingCorrespondence I J S) := by
  refine (SmoothTwoForm.IsNondegenerate.isLagrangianEmbedding_iff_of_isSmoothEmbedding ?_).mpr
    (isExactLagrangianMap_generatingCorrespondence hS).isLagrangianMap
  -- The pair of base points is a smooth left inverse of the relation.
  exact (contMDiff_generatingCorrespondence hS).isSmoothEmbedding_of_leftInverse (by simp)
    ((contMDiff_proj _).prodMap (contMDiff_proj _)) (g := Prod.map TotalSpace.proj TotalSpace.proj)
    fun _ ↦ rfl

end Symplectic

end TauCeti.CotangentBundle
