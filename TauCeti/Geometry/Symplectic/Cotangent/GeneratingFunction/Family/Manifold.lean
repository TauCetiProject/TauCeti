/-!
# Generating families on manifolds

A real function `S(q, a)` on the product `M × A` of a manifold `M` and a normed space `A` of
*auxiliary variables* is a **generating family** for a Lagrangian immersion into the cotangent
bundle `T*M`. Its *fibre derivative* is the differential of `S` in the auxiliary variables,

`∂_a S : M × A → A'`, `(q, a) ↦ d(S(q, ·))(a)`

(`TauCeti.CotangentBundle.familyFiberDeriv`), and its *fibre-critical set* is the zero set
`Σ_S = {(q, a) | ∂_a S(q, a) = 0}`. On `Σ_S` the source projection
`ι_S (q, a) = (q, d_q S(q, a))` of the cotangent relation generated by `S`
(`TauCeti.CotangentBundle.generatingSource`) lands in `T*M`. This file is the manifold version of
`TauCeti.isLagrangianImmersion_cotangentGeneratingSource_comp_coe`, which treats a normed space in
place of `M`.

* **The second derivatives.** The differential of `∂_a S` at `(q, a)` sends `(u, b)` to the
  covector `c ↦ d_Q (d_q S)(c)(u) + ∂²_a S(b, c)`, whose first term is the intrinsic mixed Hessian
  `TauCeti.mixedHessian` (`TauCeti.CotangentBundle.mvfderiv_familyFiberDeriv_apply_apply`). So no
  chart enters the statement.
* **Injectivity.** The differential of `ι_S` keeps the base component and acts on the auxiliary
  directions by the mixed Hessian. If `S` is *transverse* at `(q, a)`, that is the differential of
  `∂_a S` is surjective there, then the differential of `ι_S` is injective on the kernel of the
  differential of `∂_a S` (`TauCeti.CotangentBundle.injOn_mfderiv_generatingSource_ker`): a vector
  `(0, b)` of that kernel with zero mixed Hessian pairs to zero with every value of the
  differential of `∂_a S`, by the symmetry of second derivatives.
* **The fibre-critical set.** If `S` is smooth and transverse along `Σ_S`, then `0` is a regular
  value of `∂_a S`, and `Σ_S` is a regular fibre. With the atlas of
  `TauCeti.regularFiberChartedSpace`
  (`TauCeti.CotangentBundle.familyCriticalSetChartedSpace`) it is a smooth manifold of dimension
  `dim M` (`TauCeti.CotangentBundle.finrank_familyCriticalSet_model`), embedded in `M × A` with
  tangent spaces the kernels of the differential of `∂_a S`
  (`TauCeti.CotangentBundle.isManifold_familyCriticalSet`,
  `TauCeti.CotangentBundle.isSmoothEmbedding_coe_familyCriticalSet`,
  `TauCeti.CotangentBundle.range_mfderiv_coe_familyCriticalSet`).
* **Exactness.** Along `Σ_S` the Liouville form of `T*M` pulls back by `ι_S` to the differential
  of the restriction of `S`, because there `dS(u, b) = d_q S(u)`
  (`TauCeti.CotangentBundle.mpullback_generatingSource_comp_coe_liouvilleForm`).
* **The Lagrangian immersion.** Hence `ι_S` restricted to `Σ_S` is an exact Lagrangian map for the
  canonical symplectic form `ω = -dλ` of `T*M`, with primitive the restriction of `S`
  (`TauCeti.CotangentBundle.isExactLagrangianMap_generatingSource_comp_coe`), and a Lagrangian
  immersion (`TauCeti.CotangentBundle.isLagrangianImmersion_generatingSource_comp_coe`).

Its image need not be embedded: distinct fibre-critical points with the same image under `ι_S` are
self-intersections, so embeddedness is an additional hypothesis on the family. The auxiliary
variables range over a finite-dimensional normed space, as for the normed-space statement; the
base `M` is a finite-dimensional boundaryless manifold.

## References

* L. Hörmander, *Fourier integral operators. I*, Acta Math. 127 (1971), 79–183, Section 3.1, for
  the Lagrangian defined by a nondegenerate phase function.
* A. Weinstein, *Lectures on Symplectic Manifolds*, CBMS Regional Conference Series in
  Mathematics 29, AMS, 1977, for generating families (Morse families).
-/

public section

noncomputable section

open Bundle Function Manifold Module
open scoped Manifold ContDiff Topology

namespace TauCeti.CotangentBundle

variable {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {M : Type*}
  {A : Type*} [NormedAddCommGroup A] [NormedSpace ℝ A] {S : M × A → ℝ}

/-! ### The fibre derivative -/

/-- The **fibre derivative** `∂_a S(q, a) = d(S(q, ·))(a)` of a generating family `S` on `M × A`:
the differential of `S` in the auxiliary variables. -/
def familyFiberDeriv (S : M × A → ℝ) (x : M × A) : A →L[ℝ] ℝ :=
  fderiv ℝ (fun a ↦ S (x.1, a)) x.2

/-- The fibre derivative is the derivative of `S` along the slice through `x`. -/
theorem familyFiberDeriv_def (S : M × A → ℝ) (x : M × A) :
    familyFiberDeriv S x = fderiv ℝ (fun a ↦ S (x.1, a)) x.2 :=
  (rfl)

/-- The fibre derivative at `x` evaluated at `b` is the derivative of `S` along the slice through
`x`, in the direction `b`. -/
@[simp]
theorem familyFiberDeriv_apply (S : M × A → ℝ) (x : M × A) (b : A) :
    familyFiberDeriv S x b = fderiv ℝ (fun a ↦ S (x.1, a)) x.2 b :=
  (rfl)

/-- The fibre derivative is minus the covector of the target projection of the relation generated
by `S`. So the fibre-critical points are those whose target covector vanishes. -/
theorem familyFiberDeriv_apply_eq_neg_generatingTarget_snd_apply (x : M × A) (b : A) :
    familyFiberDeriv S x b = -(generatingTarget 𝓘(ℝ, A) S x).2 b := by
  have h : generatingTarget 𝓘(ℝ, A) S x =
      TotalSpace.mk' (A →L[ℝ] ℝ) x.2 (-mvfderiv 𝓘(ℝ, A) (fun a ↦ S (x.1, a)) x.2) :=
    TotalSpace.ext (proj_generatingTarget x) (heq_of_eq (generatingTarget_snd x))
  have h₂ : mvfderiv 𝓘(ℝ, A) (fun a ↦ S (x.1, a)) x.2 b = familyFiberDeriv S x b :=
    mvfderiv_eq_fderiv_apply _ _ b
  rw [h, ← h₂]
  -- The covector acts on the tangent space at `x.2` while `b : A`, so `rw [neg_apply]` and
  -- `simp` find no instance of the pattern; `neg_apply _ b` elaborates `b` at the tangent type.
  exact (neg_neg _).symm.trans (congrArg Neg.neg (neg_apply _ b).symm)

variable [TopologicalSpace M] [ChartedSpace H M]

/-- The fibre derivative of a jointly `C^m` generating family is jointly `C^n` when
`n + 1 ≤ m`. -/
theorem contMDiff_familyFiberDeriv [IsManifold I 1 M] {m n : ℕ∞ω}
    (hS : ContMDiff (I.prod 𝓘(ℝ, A)) 𝓘(ℝ) m S) (hnm : n + 1 ≤ m) :
    ContMDiff (I.prod 𝓘(ℝ, A)) 𝓘(ℝ, A →L[ℝ] ℝ) n (familyFiberDeriv S) :=
  fun x ↦ ContMDiffAt.fderiv_right (g := fun q a ↦ S (q, a)) (hS x) hnm

/-- **The differential of the fibre derivative.** For `S` of class `C²` at `x = (q, a)`, the
differential of `∂_a S` sends `(u, b)` to the covector
`c ↦ d_Q (d_q S)(c)(u) + ∂²_a S(b, c)`, the first term being the intrinsic mixed Hessian. -/
theorem mvfderiv_familyFiberDeriv_apply_apply [I.Boundaryless] [IsManifold I 2 M] {x : M × A}
    (hS : ContMDiffAt (I.prod 𝓘(ℝ, A)) 𝓘(ℝ) 2 S x) (w : TangentSpace (I.prod 𝓘(ℝ, A)) x)
    (c : A) :
    mvfderiv (I.prod 𝓘(ℝ, A)) (familyFiberDeriv S) x w c =
      mixedHessian I 𝓘(ℝ, A) S x c w.1 +
        fderiv ℝ (fderiv ℝ fun a ↦ S (x.1, a)) x.2 w.2 c := by
  have hF : MDifferentiableAt (I.prod 𝓘(ℝ, A)) 𝓘(ℝ, A →L[ℝ] ℝ) (familyFiberDeriv S) x :=
    (ContMDiffAt.fderiv_right (g := fun q a ↦ S (q, a)) (n := 1) hS
      (by norm_num)).mdifferentiableAt one_ne_zero
  -- Along the slice through `a`, the fibre derivative is the differential in the auxiliary
  -- variables that defines the mixed Hessian of the swapped function.
  have hslice : (fun q ↦ familyFiberDeriv S (q, x.2)) =
      fun q ↦ mvfderiv 𝓘(ℝ, A) (fun a ↦ (S ∘ Prod.swap) (a, q)) x.swap.1 := by
    funext q
    ext b
    exact (mvfderiv_eq_fderiv_apply _ _ b).symm
  rw [hF.mvfderiv_prod_eq_add_apply, add_apply]
  congr 1
  · refine Eq.trans ?_ (mixedHessian_comp_swap_apply hS w.1 c)
    rw [mixedHessian_def, ← hslice, Prod.snd_swap]
  · exact congrArg (fun L : A →L[ℝ] ℝ ↦ L c) (mvfderiv_eq_fderiv_apply _ _ _)

/-! ### Injectivity of the source projection along the fibre-critical set -/

/-- **The source projection is injective on the tangent directions of the fibre-critical set.**
If the generating family `S` is smooth and transverse at `x`, that is the differential of `∂_a S`
is surjective there, then the differential of `ι_S (q, a) = (q, d_q S)` is injective on the kernel
of the differential of `∂_a S`. -/
theorem injOn_mfderiv_generatingSource_ker [I.Boundaryless] [IsManifold I ∞ M]
    (hS : ContMDiff (I.prod 𝓘(ℝ, A)) 𝓘(ℝ) ∞ S) {x : M × A}
    (hsurj : Surjective (mfderiv (I.prod 𝓘(ℝ, A)) 𝓘(ℝ, A →L[ℝ] ℝ) (familyFiberDeriv S) x)) :
    Set.InjOn (mfderiv (I.prod 𝓘(ℝ, A)) (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) (generatingSource I S) x)
      (mfderiv (I.prod 𝓘(ℝ, A)) 𝓘(ℝ, A →L[ℝ] ℝ) (familyFiberDeriv S) x).ker := by
  have hS2 : ContMDiffAt (I.prod 𝓘(ℝ, A)) 𝓘(ℝ) 2 S x := (hS x).of_le (by simp)
  -- The second derivative of `S` in the auxiliary variables is symmetric.
  have hsymm : IsSymmSndFDerivAt ℝ (fun a ↦ S (x.1, a)) x.2 :=
    (contMDiffAt_iff_contDiffAt.mp ((hS.comp (contMDiff_const.prodMk contMDiff_id)) x.2)
      ).isSymmSndFDerivAt (by simp)
  -- The tangent spaces of `M × A`, `T*M` and `A'` are their model spaces, so the differentials
  -- are read as maps between model spaces in the linear-algebra lemma.
  exact injOn_ker_of_forall_apply (H := mixedHessian I 𝓘(ℝ, A) S x)
    (B := fderiv ℝ (fderiv ℝ fun a ↦ S (x.1, a)) x.2)
    (fun w ↦ DFunLike.congr_fun (fst_comp_mfderiv_generatingSource hS x) w)
    (fun b ↦ DFunLike.congr_fun (mfderiv_generatingSource_comp_inr hS x) b) hsymm
    (fun w c ↦ (congrArg (fun L : A →L[ℝ] ℝ ↦ L c)
      (mvfderiv_apply_eq_mfderiv_apply _ _ w)).symm.trans
        (mvfderiv_familyFiberDeriv_apply_apply hS2 w c)) hsurj

/-! ### The fibre-critical set as a manifold -/

section CriticalSet

variable [FiniteDimensional ℝ E] [FiniteDimensional ℝ A] [I.Boundaryless] [IsManifold I ∞ M]

/-- The **fibre-critical set** `{x | ∂_a S x = 0}` of a smooth generating family `S` for which `0`
is a regular value of `∂_a S`, as a charted space: it is a regular fibre of the fibre derivative,
with the atlas of `TauCeti.regularFiberChartedSpace`. -/
@[instance_reducible]
def familyCriticalSetChartedSpace (hS : ContMDiff (I.prod 𝓘(ℝ, A)) 𝓘(ℝ) ∞ S)
    (hreg : IsRegularValue (I.prod 𝓘(ℝ, A)) 𝓘(ℝ, A →L[ℝ] ℝ) (familyFiberDeriv S) 0) :
    ChartedSpace (Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ)
      {x : M × A // familyFiberDeriv S x = 0} :=
  regularFiberChartedSpace (m := ∞) (by simp) (contMDiff_familyFiberDeriv (n := ∞) hS (by simp))
    BoundarylessManifold.isInteriorPoint hreg

variable (hS : ContMDiff (I.prod 𝓘(ℝ, A)) 𝓘(ℝ) ∞ S)
  (hreg : IsRegularValue (I.prod 𝓘(ℝ, A)) 𝓘(ℝ, A →L[ℝ] ℝ) (familyFiberDeriv S) 0)

/-- The fibre-critical set of a smooth transverse generating family is a smooth manifold. -/
theorem isManifold_familyCriticalSet :
    letI := familyCriticalSetChartedSpace hS hreg
    IsManifold 𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ) ∞
      {x : M × A // familyFiberDeriv S x = 0} :=
  isManifold_regularFiber (by simp) (contMDiff_familyFiberDeriv (n := ∞) hS (by simp))
    BoundarylessManifold.isInteriorPoint hreg

/-- The inclusion of the fibre-critical set of a smooth transverse generating family is a smooth
embedding. -/
theorem isSmoothEmbedding_coe_familyCriticalSet :
    letI := familyCriticalSetChartedSpace hS hreg
    IsSmoothEmbedding 𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ)
      (I.prod 𝓘(ℝ, A)) ∞ (Subtype.val : {x : M × A // familyFiberDeriv S x = 0} → M × A) :=
  isSmoothEmbedding_coe_regularFiber (by simp) (contMDiff_familyFiberDeriv (n := ∞) hS (by simp))
    BoundarylessManifold.isInteriorPoint hreg

/-- The tangent space of the fibre-critical set at `z` is the kernel of the differential of the
fibre derivative there. -/
theorem range_mfderiv_coe_familyCriticalSet (z : {x : M × A // familyFiberDeriv S x = 0}) :
    letI := familyCriticalSetChartedSpace hS hreg
    (mfderiv 𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ) (I.prod 𝓘(ℝ, A))
      (Subtype.val : {x : M × A // familyFiberDeriv S x = 0} → M × A) z).range =
      (mfderiv (I.prod 𝓘(ℝ, A)) 𝓘(ℝ, A →L[ℝ] ℝ) (familyFiberDeriv S) z.1).ker :=
  range_mfderiv_coe_regularFiber (by simp) (contMDiff_familyFiberDeriv (n := ∞) hS (by simp))
    BoundarylessManifold.isInteriorPoint hreg z

omit [I.Boundaryless] in
/-- The model space of the fibre-critical set has the dimension of the model space `E` of the base
manifold `M`. -/
theorem finrank_familyCriticalSet_model :
    finrank ℝ (Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ) = finrank ℝ E := by
  rw [finrank_fin_fun, finrank_prod, ContinuousLinearMap.dual_finrank_eq]
  omega

omit [I.Boundaryless] in
/-- The model space of the fibre-critical set has half the dimension of the model space `E × E'`
of `T*M`. -/
private theorem two_mul_finrank_familyCriticalSet_model :
    2 * finrank ℝ (Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ) =
      finrank ℝ (E × (E →L[ℝ] ℝ)) := by
  rw [finrank_familyCriticalSet_model, finrank_prod, ContinuousLinearMap.dual_finrank_eq]
  omega

/-- The source projection restricted to the fibre-critical set is smooth. -/
theorem contMDiff_generatingSource_comp_coe :
    letI := familyCriticalSetChartedSpace hS hreg
    ContMDiff 𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ)
      (I.prod 𝓘(ℝ, E →L[ℝ] ℝ)) ∞
      (generatingSource I S ∘ (Subtype.val : {x : M × A // familyFiberDeriv S x = 0} → M × A)) :=
  letI := familyCriticalSetChartedSpace hS hreg
  (contMDiff_generatingSource hS).comp (isSmoothEmbedding_coe_familyCriticalSet hS hreg).contMDiff

/-- **The differential of the source projection along the fibre-critical set is injective.** -/
theorem injective_mfderiv_generatingSource_comp_coe
    (z : {x : M × A // familyFiberDeriv S x = 0}) :
    letI := familyCriticalSetChartedSpace hS hreg
    Injective (mfderiv 𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ)
      (I.prod 𝓘(ℝ, E →L[ℝ] ℝ))
      (generatingSource I S ∘ (Subtype.val : {x : M × A // familyFiberDeriv S x = 0} → M × A))
      z) := by
  let := familyCriticalSetChartedSpace hS hreg
  have hemb := isSmoothEmbedding_coe_familyCriticalSet hS hreg
  have hcoe := (hemb.contMDiff z).mdifferentiableAt (by simp)
  rw [mfderiv_comp z ((contMDiff_generatingSource hS z.1).mdifferentiableAt (by simp)) hcoe]
  -- The inclusion is injective with tangent image the kernel, on which `dι_S` is injective.
  intro v w hvw
  have hmem : ∀ v, mfderiv 𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ)
      (I.prod 𝓘(ℝ, A)) (Subtype.val : {x : M × A // familyFiberDeriv S x = 0} → M × A) z v ∈
      (mfderiv (I.prod 𝓘(ℝ, A)) 𝓘(ℝ, A →L[ℝ] ℝ) (familyFiberDeriv S) z.1).ker := fun v ↦ by
    rw [← range_mfderiv_coe_familyCriticalSet hS hreg z]
    exact ⟨v, rfl⟩
  exact hemb.isImmersion.mfderiv_injective (by simp) z
    (injOn_mfderiv_generatingSource_ker hS (isRegularPoint_iff.mp (hreg.isRegularPoint z.2))
      (hmem v) (hmem w) hvw)

/-- **The fibre-critical set is exact.** Along the fibre-critical set of a smooth transverse
generating family `S`, the source projection `ι_S (q, a) = (q, d_q S(q, a))` pulls the Liouville
form of `T*M` back to the differential of the restriction of `S`. -/
theorem mpullback_generatingSource_comp_coe_liouvilleForm :
    letI := familyCriticalSetChartedSpace hS hreg
    mpullback 𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ)
        (I.prod 𝓘(ℝ, E →L[ℝ] ℝ))
        (generatingSource I S ∘ (Subtype.val : {x : M × A // familyFiberDeriv S x = 0} → M × A))
        (liouvilleForm I M).1 =
      mextDeriv (RoughForm.ofFunction 𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ)
        (S ∘ (Subtype.val : {x : M × A // familyFiberDeriv S x = 0} → M × A))) := by
  let := familyCriticalSetChartedSpace hS hreg
  have hcoe := (isSmoothEmbedding_coe_familyCriticalSet hS hreg).contMDiff
  funext z
  ext v
  have hcoez := (hcoe z).mdifferentiableAt (by simp)
  have hSz := (hS z.1).mdifferentiableAt (n := ∞) (by simp)
  have hfst : mfderiv 𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ) I
      (Prod.fst ∘ Subtype.val) z (v 0) =
      (mfderiv 𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ) (I.prod 𝓘(ℝ, A))
        Subtype.val z (v 0)).1 := by
    rw [mfderiv_comp z mdifferentiableAt_fst hcoez, mfderiv_fst]
    -- `fst` is typed on `T_z₁M × T_z₂A` but composed with a map into `T_z(M × A)`, so
    -- `rw [comp_apply]` and `simp` fail; the term below elaborates against both types.
    exact (ContinuousLinearMap.comp_apply _ _ _).trans
      (congrFun (ContinuousLinearMap.coe_fst' (R := ℝ)) _)
  -- On the fibre-critical set the derivative of `S` in the auxiliary variables vanishes.
  have hz₀ : mvfderiv 𝓘(ℝ, A) (fun a ↦ S (z.1.1, a)) z.1.2 = 0 := by
    ext b
    rw [mvfderiv_eq_fderiv_apply, ← familyFiberDeriv_def, z.2]
    exact zero_apply _
  have hz : mvfderiv 𝓘(ℝ, A) (fun a ↦ S (z.1.1, a)) z.1.2
      (mfderiv 𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ) (I.prod 𝓘(ℝ, A))
        Subtype.val z (v 0)).2 = 0 := by
    rw [hz₀]
    exact zero_apply _
  -- The covector of `ι_S z` lives over `(ι_S z).proj`, not syntactically `z.1.1`, so
  -- `rw [generatingSource_snd]` is ill-typed; apply that equation pointwise instead.
  rw [mpullback_liouvilleForm_apply_of_proj_comp_eq
      (ψ := generatingSource I S ∘ Subtype.val) (g := Prod.fst ∘ Subtype.val)
      (fun _ ↦ proj_generatingSource _)
      ((contMDiff_generatingSource_comp_coe hS hreg z).mdifferentiableAt (by simp)),
    mextDeriv_ofFunction, ContinuousAlternatingMap.ofSubsingleton_apply_apply,
    mvfderiv_comp_apply z hSz hcoez, hSz.mvfderiv_prod_eq_add_apply, hz, add_zero]
  exact (DFunLike.congr_fun (generatingSource_snd (I := I) (S := S) z.1) _).trans
    (congrArg (mvfderiv I (fun q ↦ S (q, z.1.2)) z.1.1) hfst)

/-- **The fibre-critical set of a generating family is an exact Lagrangian.** Let `S` be a smooth
generating family on `M × A`, for a finite-dimensional boundaryless manifold `M` and a
finite-dimensional normed space `A`, which is transverse along its fibre-critical set: `0` is a
regular value of `∂_a S`. With its manifold structure as a regular fibre, the fibre-critical set
maps to `T*M` by `ι_S (q, a) = (q, d_q S(q, a))` as an exact Lagrangian map for the canonical
symplectic form `ω = -dλ`, with primitive the restriction of `S`. -/
theorem isExactLagrangianMap_generatingSource_comp_coe :
    letI := familyCriticalSetChartedSpace hS hreg
    (isSymplectic_symplecticForm (I := I) (M := M)).isNondegenerate.IsExactLagrangianMap
      𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ) (liouvilleForm I M)
      (generatingSource I S ∘ (Subtype.val : {x : M × A // familyFiberDeriv S x = 0} → M × A))
      (S ∘ (Subtype.val : {x : M × A // familyFiberDeriv S x = 0} → M × A)) := by
  let := familyCriticalSetChartedSpace hS hreg
  have := isManifold_familyCriticalSet hS hreg
  refine (SmoothTwoForm.IsNondegenerate.isExactLagrangianMap_iff_of_finrank
    (symplecticForm_eq_neg_mextDerivₗ (I := I) (M := M))
    (contMDiff_generatingSource_comp_coe hS hreg)
    (injective_mfderiv_generatingSource_comp_coe hS hreg) ?_).mpr
    ⟨hS.comp (isSmoothEmbedding_coe_familyCriticalSet hS hreg).contMDiff,
      mpullback_generatingSource_comp_coe_liouvilleForm hS hreg⟩
  exact two_mul_finrank_familyCriticalSet_model

/-- **The fibre-critical set of a generating family is a Lagrangian immersion.** For a smooth
generating family `S` on `M × A` for which `0` is a regular value of `∂_a S`, the fibre-critical
set, with its manifold structure as a regular fibre, maps to `T*M` by
`ι_S (q, a) = (q, d_q S(q, a))` as a Lagrangian immersion for the canonical symplectic form. -/
theorem isLagrangianImmersion_generatingSource_comp_coe :
    letI := familyCriticalSetChartedSpace hS hreg
    (isSymplectic_symplecticForm (I := I) (M := M)).isNondegenerate.IsLagrangianImmersion
      𝓘(ℝ, Fin (finrank ℝ (E × A) - finrank ℝ (A →L[ℝ] ℝ)) → ℝ)
      (generatingSource I S ∘ (Subtype.val : {x : M × A // familyFiberDeriv S x = 0} → M × A)) := by
  let := familyCriticalSetChartedSpace hS hreg
  have := isManifold_familyCriticalSet hS hreg
  have hL := isExactLagrangianMap_generatingSource_comp_coe hS hreg
  refine ⟨(contMDiff_generatingSource_comp_coe hS hreg).isImmersion_of_injective_mfderiv (by simp)
    (injective_mfderiv_generatingSource_comp_coe hS hreg), hL.isLagrangianMap.isIsotropicMap, ?_⟩
  exact two_mul_finrank_familyCriticalSet_model

end CriticalSet

end TauCeti.CotangentBundle
