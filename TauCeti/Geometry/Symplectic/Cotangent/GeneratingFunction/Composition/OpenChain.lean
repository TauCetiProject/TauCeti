/-!
# Elimination of the internal vertices of an open chain of generating functions

Let `S_0, …, S_(n+1)` be generating functions on `E × E`, with the convention `p = ∂_q S`,
`P = -∂_Q S`. An **open chain** with endpoints `q`, `Q` and internal vertices
`a = (a_0, …, a_n)` has vertices `q_0 = q`, `q_(i+1) = a_i`, `q_(n+2) = Q` and edges
`(q_k, q_(k+1))` (`TauCeti.openChainEdge`), and its **open-chain action** is

`F(q, Q, a) = Σ_k S_k(q_k, q_(k+1))`

(`TauCeti.openChainAction`). Its derivative in the internal vertices vanishes exactly when the
outgoing covector of each edge equals the incoming covector of the next one,
`-∂_2 S_i(q_i, q_(i+1)) = ∂_1 S_(i+1)(q_(i+1), q_(i+2))`, that is, when the target point of the
relation of `S_i` over the edge `i` is the source point of the relation of `S_(i+1)` over the edge
`i + 1` (`TauCeti.cotangentGeneratingTarget_openChainAction_snd_eq_zero_iff`).

At such a stationary configuration, if the full negative Hessian of `F` in the internal vertices
is invertible, the implicit function theorem gives a stationary branch `b(q, Q)` through `a`, and
the **eliminated generating function** `R(q, Q) = F(q, Q, b(q, Q))`
(`TauCeti.exists_openChainElimination`). Near `(q, Q)` the branch is the only stationary
configuration close to `a`, and `R` has the endpoint covectors of the chain: its source covector
is that of `S_0` over the first edge and its target covector is that of `S_(n+1)` over the last
edge. The elimination is the composition `TauCeti.exists_cotangentGeneratingComposition` of the
first edge with the rest of the chain, whose intermediate Hessian is the full Hessian of `F`; no
invertibility of the Hessians of partial eliminations is assumed.

If every `S_k` has an invertible mixed Hessian, so does `R`
(`TauCeti.injective_cotangentMixedHessian_openChain` in any dimension,
`TauCeti.isInvertible_cotangentMixedHessian_openChain` for finite-dimensional `E`): differentiating
the matching equations along the branch, a variation `δQ` with `M_R δQ = 0` forces the variations
of the vertices to vanish one edge after the other, ending with `δQ = 0`. Near the source point
the map generated by `R` is then the composite `φ_(n+1) ∘ ⋯ ∘ φ_0` of the maps generated by the
`S_k` (`TauCeti.cotangentGeneratedMap_eventuallyEq_foldl_openChain`).
`TauCeti.exists_openChainElimination_generatedMap` collects these statements for `C²` generating
functions on a finite-dimensional space. With one internal vertex (`n = 0`) the action is
`S_0(q, a_0) + S_1(a_0, Q)` (`TauCeti.openChainAction_fin_two`), as in the composition of two
generating functions `TauCeti.exists_cotangentGeneratingComposition_generatedMap`; with two
internal vertices (`n = 1`) it is `S_0(q, a_0) + S_1(a_0, a_1) + S_2(a_1, Q)`
(`TauCeti.openChainAction_fin_three`), and the elimination gives the generating function of the
composite of three canonical transformations, such as the third iterate of one of them.

All statements are local: they concern the stationary branch through the chosen internal
configuration, not other critical points of `a ↦ F(q, Q, a)`.

## Main definitions

* `TauCeti.openChainEdge k`: the edge `(q_k, q_(k+1))` of an open chain, as a continuous linear
  function of the endpoints and internal vertices.
* `TauCeti.openChainAction S`: the open-chain action `Σ_k S_k(q_k, q_(k+1))`.

## Main results

* `TauCeti.cotangentGeneratingTarget_openChainAction_snd_eq_zero_iff`: stationarity in the internal
  vertices is matching of covectors at every internal vertex.
* `TauCeti.exists_openChainElimination`: the stationary branch and the eliminated generating
  function, with its endpoint covectors.
* `TauCeti.isInvertible_cotangentMixedHessian_openChain`: the eliminated generating function has an
  invertible mixed Hessian.
* `TauCeti.cotangentGeneratedMap_eventuallyEq_foldl_openChain`: it generates the composite of the
  maps generated by the edges.

## References

* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Section 5.1 (Proposition 5.2 and the exercise following it, the generating
  functions of the second and third iterates).
* V. I. Arnold, *Mathematical Methods of Classical Mechanics*, second edition,
  Springer, 1989, §48 (composition of canonical transformations).
-/

public section

noncomputable section

open ContinuousLinearMap Filter
open scoped Topology

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {n : ℕ}

/-! ### Open chains and their action -/

/-- The edge `(q_k, q_(k+1))` of the open chain with vertices `q_0 = q`, `q_(i+1) = a_i` for
`i ≤ n` and `q_(n+2) = Q`, as a continuous linear function of `((q, Q), a)`. -/
def openChainEdge (k : Fin (n + 2)) : ((E × E) × (Fin (n + 1) → E)) →L[ℝ] E × E :=
  (Fin.cases (motive := fun _ ↦ ((E × E) × (Fin (n + 1) → E)) →L[ℝ] E)
      ((fst ℝ E E).comp (fst ℝ (E × E) (Fin (n + 1) → E)))
      (fun i ↦ (proj i).comp (snd ℝ (E × E) (Fin (n + 1) → E))) k).prod
    (Fin.lastCases (motive := fun _ ↦ ((E × E) × (Fin (n + 1) → E)) →L[ℝ] E)
      ((snd ℝ E E).comp (fst ℝ (E × E) (Fin (n + 1) → E)))
      (fun i ↦ (proj i).comp (snd ℝ (E × E) (Fin (n + 1) → E))) k)

/-- The first edge starts at the endpoint `q`. -/
@[simp]
theorem fst_openChainEdge_zero (x : (E × E) × (Fin (n + 1) → E)) :
    (openChainEdge 0 x).1 = x.1.1 := by
  simp [openChainEdge]

/-- The edge `i + 1` starts at the internal vertex `a_i`. -/
@[simp]
theorem fst_openChainEdge_succ (i : Fin (n + 1)) (x : (E × E) × (Fin (n + 1) → E)) :
    (openChainEdge i.succ x).1 = x.2 i := by
  simp [openChainEdge]

/-- The edge `i` ends at the internal vertex `a_i`. -/
@[simp]
theorem snd_openChainEdge_castSucc (i : Fin (n + 1)) (x : (E × E) × (Fin (n + 1) → E)) :
    (openChainEdge i.castSucc x).2 = x.2 i := by
  simp [openChainEdge]

/-- The last edge ends at the endpoint `Q`. -/
@[simp]
theorem snd_openChainEdge_last (x : (E × E) × (Fin (n + 1) → E)) :
    (openChainEdge (Fin.last (n + 1)) x).2 = x.1.2 := by
  simp [openChainEdge]

/-- The first edge is `(q, a_0)`. -/
theorem openChainEdge_zero (x : (E × E) × (Fin (n + 1) → E)) :
    openChainEdge 0 x = (x.1.1, x.2 0) := by
  rw [← Fin.castSucc_zero, Prod.ext_iff, snd_openChainEdge_castSucc, Fin.castSucc_zero,
    fst_openChainEdge_zero]
  exact ⟨rfl, rfl⟩

/-- The last edge is `(a_n, Q)`. -/
theorem openChainEdge_last (x : (E × E) × (Fin (n + 1) → E)) :
    openChainEdge (Fin.last (n + 1)) x = (x.2 (Fin.last n), x.1.2) := by
  rw [Prod.ext_iff, snd_openChainEdge_last, ← Fin.succ_last, fst_openChainEdge_succ]
  exact ⟨rfl, rfl⟩

/-- The internal edge `i + 1` joins the internal vertices `a_i` and `a_(i+1)`. -/
theorem openChainEdge_succ_castSucc (i : Fin n) (x : (E × E) × (Fin (n + 1) → E)) :
    openChainEdge i.castSucc.succ x = (x.2 i.castSucc, x.2 i.succ) := by
  rw [Prod.ext_iff, fst_openChainEdge_succ, Fin.succ_castSucc, snd_openChainEdge_castSucc]
  exact ⟨rfl, rfl⟩

/-- The edges after the first do not involve the endpoint `q`. -/
theorem openChainEdge_succ_apply_eq (i : Fin (n + 1)) (q q' Q : E) (a : Fin (n + 1) → E) :
    openChainEdge i.succ ((q, Q), a) = openChainEdge i.succ ((q', Q), a) := by
  refine Prod.ext (by simp) ?_
  induction i using Fin.lastCases with
  | last => simp only [Fin.succ_last, snd_openChainEdge_last]
  | cast j => simp only [Fin.succ_castSucc, snd_openChainEdge_castSucc]

/-- The **open-chain action** `F(q, Q, a) = Σ_k S_k(q_k, q_(k+1))` of the generating functions
`S_0, …, S_(n+1)`, on the chain with vertices `q_0 = q`, `q_(i+1) = a_i` and `q_(n+2) = Q`. -/
def openChainAction (S : Fin (n + 2) → E × E → ℝ) (x : (E × E) × (Fin (n + 1) → E)) : ℝ :=
  ∑ k, S k (openChainEdge k x)

/-- The open-chain action is the sum of the generating functions over the edges. -/
theorem openChainAction_apply (S : Fin (n + 2) → E × E → ℝ) (x : (E × E) × (Fin (n + 1) → E)) :
    openChainAction S x = ∑ k, S k (openChainEdge k x) :=
  (rfl)

/-- With one internal vertex, the open-chain action is `S_0(q, a_0) + S_1(a_0, Q)`. -/
theorem openChainAction_fin_two (S : Fin 2 → E × E → ℝ) (q Q : E) (a : Fin 1 → E) :
    openChainAction S ((q, Q), a) = S 0 (q, a 0) + S 1 (a 0, Q) := by
  rw [openChainAction_apply, Fin.sum_univ_two, openChainEdge_zero]
  exact congrArg (fun e ↦ S 0 (q, a 0) + S 1 e) (openChainEdge_last _)

/-- With two internal vertices, the open-chain action is
`S_0(q, a_0) + S_1(a_0, a_1) + S_2(a_1, Q)`. -/
theorem openChainAction_fin_three (S : Fin 3 → E × E → ℝ) (q Q : E) (a : Fin 2 → E) :
    openChainAction S ((q, Q), a) = S 0 (q, a 0) + S 1 (a 0, a 1) + S 2 (a 1, Q) := by
  rw [openChainAction_apply, Fin.sum_univ_three, openChainEdge_zero]
  exact congrArg₂ (fun e e' ↦ S 0 (q, a 0) + S 1 e + S 2 e')
    (openChainEdge_succ_castSucc (0 : Fin 1) _) (openChainEdge_last _)

/-- Smoothness of the open-chain action, from that of the generating functions on the edges. -/
theorem contDiffAt_openChainAction {S : Fin (n + 2) → E × E → ℝ}
    {x : (E × E) × (Fin (n + 1) → E)} {m : WithTop ℕ∞}
    (hS : ∀ k, ContDiffAt ℝ m (S k) (openChainEdge k x)) :
    ContDiffAt ℝ m (openChainAction S) x :=
  ContDiffAt.sum fun k _ ↦ (hS k).comp x (openChainEdge (E := E) k).contDiff.contDiffAt

/-- **The differential of the open-chain action**: the sum over the edges of the differentials of
the generating functions, each applied to the variation of its edge. -/
theorem fderiv_openChainAction_apply {S : Fin (n + 2) → E × E → ℝ}
    {x : (E × E) × (Fin (n + 1) → E)} (hS : ∀ k, DifferentiableAt ℝ (S k) (openChainEdge k x))
    (u : (E × E) × (Fin (n + 1) → E)) :
    fderiv ℝ (openChainAction S) x u =
      ∑ k, fderiv ℝ (S k) (openChainEdge k x) (openChainEdge k u) := by
  have hd : HasFDerivAt (openChainAction S)
      (∑ k, fderiv ℝ (S k) (openChainEdge k x) ∘L openChainEdge k) x :=
    HasFDerivAt.fun_sum fun k _ ↦ (hS k).hasFDerivAt.comp x (openChainEdge (E := E) k).hasFDerivAt
  rw [hd.fderiv, sum_apply]
  simp only [ContinuousLinearMap.comp_apply]

/-- The differential of the open-chain action in the internal vertices, grouped by vertex: the
variation `c_i` of `a_i` enters through the second argument of `S_i` and the first argument of
`S_(i+1)`. -/
theorem fderiv_openChainAction_apply_internal {S : Fin (n + 2) → E × E → ℝ}
    {x : (E × E) × (Fin (n + 1) → E)} (hS : ∀ k, DifferentiableAt ℝ (S k) (openChainEdge k x))
    (c : Fin (n + 1) → E) :
    fderiv ℝ (openChainAction S) x (0, c) =
      ∑ i, (fderiv ℝ (S i.castSucc) (openChainEdge i.castSucc x) (0, c i) +
        fderiv ℝ (S i.succ) (openChainEdge i.succ x) (c i, 0)) := by
  rw [fderiv_openChainAction_apply hS]
  -- Split the variation of each edge into its two endpoints.
  have hsplit (k : Fin (n + 2)) :
      fderiv ℝ (S k) (openChainEdge k x) (openChainEdge k (0, c)) =
        fderiv ℝ (S k) (openChainEdge k x) ((openChainEdge k (0, c)).1, 0) +
          fderiv ℝ (S k) (openChainEdge k x) (0, (openChainEdge k (0, c)).2) := by
    rw [← map_add, Prod.mk_add_mk, add_zero, zero_add]
  simp only [hsplit, Finset.sum_add_distrib]
  -- The first endpoints are the vertices `q, a_0, …, a_n`, the second ones `a_0, …, a_n, Q`.
  rw [Fin.sum_univ_succ (f := fun k ↦ fderiv ℝ (S k) (openChainEdge k x)
      ((openChainEdge k (0, c)).1, 0)),
    Fin.sum_univ_castSucc (f := fun k ↦ fderiv ℝ (S k) (openChainEdge k x)
      (0, (openChainEdge k (0, c)).2))]
  simp only [fst_openChainEdge_zero, fst_openChainEdge_succ, snd_openChainEdge_castSucc,
    snd_openChainEdge_last, Prod.fst_zero, Prod.snd_zero, Prod.mk_zero_zero, map_zero, zero_add,
    add_zero]
  rw [add_comm]

/-- **Stationary open chains are matched chains.** The derivative of the open-chain action in the
internal vertices vanishes exactly when, at every internal vertex, the target point of the
relation of the incoming edge is the source point of the relation of the outgoing edge:
`-∂_2 S_i(q_i, q_(i+1)) = ∂_1 S_(i+1)(q_(i+1), q_(i+2))`. -/
theorem cotangentGeneratingTarget_openChainAction_snd_eq_zero_iff
    {S : Fin (n + 2) → E × E → ℝ} {x : (E × E) × (Fin (n + 1) → E)}
    (hS : ∀ k, DifferentiableAt ℝ (S k) (openChainEdge k x)) :
    (cotangentGeneratingTarget (openChainAction S) x).2 = 0 ↔
      ∀ i : Fin (n + 1),
        cotangentGeneratingTarget (S i.castSucc) (openChainEdge i.castSucc x) =
          cotangentGeneratingSource (S i.succ) (openChainEdge i.succ x) := by
  have hzero : (cotangentGeneratingTarget (openChainAction S) x).2 = 0 ↔
      ∀ c, fderiv ℝ (openChainAction S) x (0, c) = 0 := by
    simp only [ContinuousLinearMap.ext_iff, cotangentGeneratingTarget_snd_apply,
      _root_.zero_apply, neg_eq_zero]
  rw [hzero]
  constructor
  · intro h i
    refine Prod.ext (by simp) (ContinuousLinearMap.ext fun y ↦ ?_)
    have hy := h (Pi.single i y)
    rw [fderiv_openChainAction_apply_internal hS, Finset.sum_eq_single i (fun j _ hj ↦ by
      simp [Pi.single_eq_of_ne hj, Prod.mk_zero_zero]) (by simp)] at hy
    simp only [Pi.single_eq_same] at hy
    simp only [cotangentGeneratingTarget_snd_apply, cotangentGeneratingSource_snd_apply]
    linarith
  · intro h c
    rw [fderiv_openChainAction_apply_internal hS]
    refine Finset.sum_eq_zero fun i _ ↦ ?_
    have hi := congrArg (fun p ↦ p.2 (c i)) (h i)
    simp only [cotangentGeneratingTarget_snd_apply, cotangentGeneratingSource_snd_apply] at hi
    linarith

/-! ### The first edge and the rest of the chain -/

/-- The first edge `S_0(q, a_0)` of an open chain, as a function of `(q, a)`. -/
private def openChainHead (S : Fin (n + 2) → E × E → ℝ) (y : E × (Fin (n + 1) → E)) : ℝ :=
  S 0 (y.1, y.2 0)

/-- The projection `(q, a) ↦ (q, a_0)` onto the first edge. -/
private def openChainHeadProj : E × (Fin (n + 1) → E) →L[ℝ] E × E :=
  (fst ℝ E (Fin (n + 1) → E)).prod ((proj 0).comp (snd ℝ E (Fin (n + 1) → E)))

/-- The map `(a, Q) ↦ ((0, Q), a)`, through which the rest of the chain reads its edges. -/
private def openChainTailIncl : (Fin (n + 1) → E) × E →L[ℝ] (E × E) × (Fin (n + 1) → E) :=
  ((0 : (Fin (n + 1) → E) × E →L[ℝ] E).prod (snd ℝ (Fin (n + 1) → E) E)).prod
    (fst ℝ (Fin (n + 1) → E) E)

/-- The edges after the first, `Σ_i S_(i+1)(a_i, q_(i+2))`, as a function of `(a, Q)`. -/
private def openChainTail (S : Fin (n + 2) → E × E → ℝ) (y : (Fin (n + 1) → E) × E) : ℝ :=
  ∑ i : Fin (n + 1), S i.succ (openChainEdge i.succ (openChainTailIncl y))

/-- The open-chain action is the sum of its first edge and the rest of the chain. -/
private theorem openChainAction_eq_cotangentGeneratingSum (S : Fin (n + 2) → E × E → ℝ) :
    openChainAction S = cotangentGeneratingSum (openChainHead S) (openChainTail S) := by
  funext ⟨⟨q, Q⟩, a⟩
  simp [openChainAction_apply, Fin.sum_univ_succ, openChainEdge_zero, openChainHead, openChainTail,
    openChainTailIncl, openChainEdge_succ_apply_eq _ q 0]

/-- The rest of the chain reads the edge `i + 1` of `x` at `(x.2, x.1.2)`. -/
private theorem openChainEdge_succ_openChainTailIncl (i : Fin (n + 1))
    (x : (E × E) × (Fin (n + 1) → E)) :
    openChainEdge i.succ (openChainTailIncl (x.2, x.1.2)) = openChainEdge i.succ x := by
  obtain ⟨⟨q, Q⟩, a⟩ := x
  simpa [openChainTailIncl] using openChainEdge_succ_apply_eq i 0 q Q a

private theorem hasFDerivAt_openChainHead {S : Fin (n + 2) → E × E → ℝ}
    {x : (E × E) × (Fin (n + 1) → E)} (hS : DifferentiableAt ℝ (S 0) (openChainEdge 0 x)) :
    HasFDerivAt (openChainHead S) (fderiv ℝ (S 0) (openChainEdge 0 x) ∘L openChainHeadProj)
      (x.1.1, x.2) := by
  rw [openChainEdge_zero] at hS ⊢
  exact hS.hasFDerivAt.comp (x.1.1, x.2) (openChainHeadProj (E := E) (n := n)).hasFDerivAt

private theorem hasFDerivAt_openChainTail {S : Fin (n + 2) → E × E → ℝ}
    {x : (E × E) × (Fin (n + 1) → E)}
    (hS : ∀ i : Fin (n + 1), DifferentiableAt ℝ (S i.succ) (openChainEdge i.succ x)) :
    HasFDerivAt (openChainTail S)
      (∑ i : Fin (n + 1), fderiv ℝ (S i.succ) (openChainEdge i.succ x) ∘L
        (openChainEdge i.succ ∘L openChainTailIncl)) (x.2, x.1.2) := by
  refine HasFDerivAt.fun_sum fun i _ ↦ ?_
  have h := hS i
  rw [← openChainEdge_succ_openChainTailIncl i x] at h ⊢
  exact h.hasFDerivAt.comp (x.2, x.1.2)
    ((openChainEdge (E := E) i.succ).comp openChainTailIncl).hasFDerivAt

private theorem contDiffAt_openChainHead {S : Fin (n + 2) → E × E → ℝ}
    {x : (E × E) × (Fin (n + 1) → E)} {m : WithTop ℕ∞}
    (hS : ContDiffAt ℝ m (S 0) (openChainEdge 0 x)) :
    ContDiffAt ℝ m (openChainHead S) (x.1.1, x.2) := by
  rw [openChainEdge_zero] at hS
  exact hS.comp (x.1.1, x.2) (openChainHeadProj (E := E) (n := n)).contDiff.contDiffAt

private theorem contDiffAt_openChainTail {S : Fin (n + 2) → E × E → ℝ}
    {x : (E × E) × (Fin (n + 1) → E)} {m : WithTop ℕ∞}
    (hS : ∀ i : Fin (n + 1), ContDiffAt ℝ m (S i.succ) (openChainEdge i.succ x)) :
    ContDiffAt ℝ m (openChainTail S) (x.2, x.1.2) := by
  refine ContDiffAt.sum fun i _ ↦ ?_
  have h := hS i
  rw [← openChainEdge_succ_openChainTailIncl i x] at h
  exact h.comp (x.2, x.1.2)
    ((openChainEdge (E := E) i.succ).comp openChainTailIncl).contDiff.contDiffAt

/-- The source covector of the first edge, read as a function of all internal vertices, is the
source covector of `S_0` over `(q, a_0)`. -/
private theorem cotangentGeneratingSource_openChainHead {S : Fin (n + 2) → E × E → ℝ}
    {x : (E × E) × (Fin (n + 1) → E)} (hS : DifferentiableAt ℝ (S 0) (openChainEdge 0 x)) :
    cotangentGeneratingSource (openChainHead S) (x.1.1, x.2) =
      cotangentGeneratingSource (S 0) (x.1.1, x.2 0) := by
  refine Prod.ext (by simp) (ContinuousLinearMap.ext fun v ↦ ?_)
  simp [cotangentGeneratingSource_snd_apply, (hasFDerivAt_openChainHead hS).fderiv,
    openChainHeadProj, openChainEdge_zero]

/-- The target covector of the rest of the chain is the target covector of the last edge
`S_(n+1)` over `(a_n, Q)`. -/
private theorem cotangentGeneratingTarget_openChainTail {S : Fin (n + 2) → E × E → ℝ}
    {x : (E × E) × (Fin (n + 1) → E)}
    (hS : ∀ i : Fin (n + 1), DifferentiableAt ℝ (S i.succ) (openChainEdge i.succ x)) :
    cotangentGeneratingTarget (openChainTail S) (x.2, x.1.2) =
      cotangentGeneratingTarget (S (Fin.last (n + 1))) (x.2 (Fin.last n), x.1.2) := by
  refine Prod.ext (by simp) (ContinuousLinearMap.ext fun v ↦ ?_)
  simp only [cotangentGeneratingTarget_snd_apply, (hasFDerivAt_openChainTail hS).fderiv,
    sum_apply, ContinuousLinearMap.comp_apply]
  -- Only the last edge involves `Q`.
  rw [Fin.sum_univ_castSucc]
  have hcs (j : Fin n) :
      openChainEdge j.castSucc.succ (openChainTailIncl ((0 : Fin (n + 1) → E), v)) = 0 := by
    refine Prod.ext ?_ ?_
    · simp [openChainTailIncl]
    · rw [Fin.succ_castSucc, snd_openChainEdge_castSucc]
      simp [openChainTailIncl]
  have hlast : openChainEdge (Fin.last (n + 1)) (openChainTailIncl ((0 : Fin (n + 1) → E), v)) =
      (0, v) := by
    rw [openChainEdge_last]
    simp [openChainTailIncl]
  simp only [hcs, map_zero, Finset.sum_const_zero, zero_add]
  rw [Fin.succ_last, hlast, openChainEdge_last]

/-- At a configuration where all generating functions are differentiable on their edges, the
matching of the first edge with the rest of the chain is the matching at every internal vertex. -/
private theorem openChainHead_match_iff {S : Fin (n + 2) → E × E → ℝ}
    {x : (E × E) × (Fin (n + 1) → E)} (hS : ∀ k, DifferentiableAt ℝ (S k) (openChainEdge k x)) :
    cotangentGeneratingTarget (openChainHead S) (x.1.1, x.2) =
        cotangentGeneratingSource (openChainTail S) (x.2, x.1.2) ↔
      ∀ i : Fin (n + 1),
        cotangentGeneratingTarget (S i.castSucc) (openChainEdge i.castSucc x) =
          cotangentGeneratingSource (S i.succ) (openChainEdge i.succ x) := by
  rw [← cotangentGeneratingTarget_sum_snd_eq_zero_iff
      (hasFDerivAt_openChainHead (hS 0)).differentiableAt
      (hasFDerivAt_openChainTail fun i ↦ hS i.succ).differentiableAt,
    ← openChainAction_eq_cotangentGeneratingSum,
    cotangentGeneratingTarget_openChainAction_snd_eq_zero_iff hS]

/-! ### Nondegeneracy of the eliminated generating function -/

section MixedHessian

variable {S : Fin (n + 2) → E × E → ℝ} {q Q : E} {a : Fin (n + 1) → E}
  {b : E × E → Fin (n + 1) → E} {R : E × E → ℝ}

/-- **The eliminated generating function is nondegenerate.** Let `b` be a branch of matched
configurations of an open chain near `(q, Q)`, differentiable at `(q, Q)` with `b(q, Q) = a`, along
which `R` has the source covector of the first edge. If every `S_k` has an injective mixed Hessian
on its edge of `((q, Q), a)`, then so does `R` at `(q, Q)`. -/
theorem injective_cotangentMixedHessian_openChain
    (hS : ∀ k, DifferentiableAt ℝ (fderiv ℝ (S k)) (openChainEdge k ((q, Q), a)))
    (hM : ∀ k, Function.Injective (cotangentMixedHessian (S k) (openChainEdge k ((q, Q), a))))
    (hR : DifferentiableAt ℝ (fderiv ℝ R) (q, Q)) (hb : DifferentiableAt ℝ b (q, Q))
    (hb₀ : b (q, Q) = a)
    (hrel : ∀ᶠ y in 𝓝 (q, Q),
      (∀ i : Fin (n + 1),
        cotangentGeneratingTarget (S i.castSucc) (openChainEdge i.castSucc (y, b y)) =
          cotangentGeneratingSource (S i.succ) (openChainEdge i.succ (y, b y))) ∧
      cotangentGeneratingSource R y = cotangentGeneratingSource (S 0) (y.1, b y 0)) :
    Function.Injective (cotangentMixedHessian R (q, Q)) := by
  subst hb₀
  -- Differentiating the matching equations along the branch, a variation `δQ` with
  -- `M_R δQ = 0` forces the variations of the edges to vanish one after the other, the last one
  -- being `(0, δQ)`.
  refine (injective_iff_map_eq_zero (cotangentMixedHessian R (q, Q))).2 fun δQ hδ ↦ ?_
  -- The variation of the edges along the branch in the direction `(0, δQ)`.
  set D := fderiv ℝ b (q, Q) (0, δQ)
  set ε : Fin (n + 2) → E × E := fun k ↦ openChainEdge k ((0, δQ), D)
  have hg (k : Fin (n + 2)) : HasFDerivAt (fun y ↦ openChainEdge k (y, b y))
      (openChainEdge k ∘L (ContinuousLinearMap.id ℝ (E × E)).prod (fderiv ℝ b (q, Q))) (q, Q) :=
    (openChainEdge (E := E) k).hasFDerivAt.comp (q, Q) ((hasFDerivAt_id _).prodMk hb.hasFDerivAt)
  -- Differentiating the matching equation at the vertex `i` along the branch.
  have hvertex (i : Fin (n + 1)) (v : E) :
      -fderiv ℝ (fderiv ℝ (S i.castSucc)) (openChainEdge i.castSucc ((q, Q), b (q, Q)))
          (ε i.castSucc) (0, v) =
        fderiv ℝ (fderiv ℝ (S i.succ)) (openChainEdge i.succ ((q, Q), b (q, Q)))
          (ε i.succ) (v, 0) := by
    have hT := (hasFDerivAt_cotangentGeneratingTarget (hS i.castSucc)).comp (q, Q) (hg i.castSucc)
    have hU := (hasFDerivAt_cotangentGeneratingSource (hS i.succ)).comp (q, Q) (hg i.succ)
    have heq := hT.unique (hU.congr_of_eventuallyEq (hrel.mono fun y hy ↦ hy.1 i))
    have h := congrArg (fun L ↦ (L (0, δQ)).2 v) heq
    simpa [ε, D] using h
  -- The source covector of `R` is that of `S_0` along the branch, so `M_R δQ = M_{S_0} D_0`.
  have hb0 : HasFDerivAt (fun y ↦ b y 0) (proj 0 ∘L fderiv ℝ b (q, Q)) (q, Q) :=
    (proj (R := ℝ) (φ := fun _ : Fin (n + 1) ↦ E) 0).hasFDerivAt.comp (q, Q) hb.hasFDerivAt
  have hS0 : DifferentiableAt ℝ (fderiv ℝ (S 0)) (q, b (q, Q) 0) := by
    simpa [openChainEdge_zero] using hS 0
  have hMR := cotangentMixedHessian_eq_comp_fderiv_comp_inr (S := S 0) hS0 hR
    hb0.differentiableAt rfl (hrel.mono fun y hy ↦ hy.2)
  have hD0 : D 0 = 0 := by
    have hinj := hM 0
    rw [openChainEdge_zero] at hinj
    refine hinj ?_
    rw [map_zero, ← hδ, hMR]
    simp [hb0.fderiv, D]
  -- The variations of the edges vanish one after the other.
  have hε : ∀ k, ε k = 0 := by
    intro k
    induction k using Fin.induction with
    | zero => simp [ε, openChainEdge_zero, hD0]
    | succ i ih =>
      have h1 : (ε i.succ).1 = 0 := by
        have := congrArg Prod.snd ih
        simpa [ε] using this
      refine Prod.ext h1 (hM i.succ ?_)
      ext v
      have hv := hvertex i v
      rw [ih] at hv
      simp only [map_zero, _root_.zero_apply, neg_zero] at hv
      have hsplit : ε i.succ = (0, (ε i.succ).2) := Prod.ext h1 rfl
      rw [hsplit] at hv
      simp [cotangentMixedHessian_apply_apply, ← hv]
  simpa [ε] using congrArg Prod.snd (hε (Fin.last (n + 1)))

/-- **The eliminated generating function is of the first kind.** In finite dimension, if every
`S_k` has an invertible mixed Hessian on its edge, so does the eliminated generating function `R`;
see `TauCeti.injective_cotangentMixedHessian_openChain`. -/
theorem isInvertible_cotangentMixedHessian_openChain [FiniteDimensional ℝ E]
    (hS : ∀ k, DifferentiableAt ℝ (fderiv ℝ (S k)) (openChainEdge k ((q, Q), a)))
    (hM : ∀ k, (cotangentMixedHessian (S k) (openChainEdge k ((q, Q), a))).IsInvertible)
    (hR : DifferentiableAt ℝ (fderiv ℝ R) (q, Q)) (hb : DifferentiableAt ℝ b (q, Q))
    (hb₀ : b (q, Q) = a)
    (hrel : ∀ᶠ y in 𝓝 (q, Q),
      (∀ i : Fin (n + 1),
        cotangentGeneratingTarget (S i.castSucc) (openChainEdge i.castSucc (y, b y)) =
          cotangentGeneratingSource (S i.succ) (openChainEdge i.succ (y, b y))) ∧
      cotangentGeneratingSource R y = cotangentGeneratingSource (S 0) (y.1, b y 0)) :
    (cotangentMixedHessian R (q, Q)).IsInvertible :=
  ContinuousLinearMap.isInvertible_of_injective <|
    injective_cotangentMixedHessian_openChain hS
      (fun k ↦ by obtain ⟨e, he⟩ := hM k; rw [← he]; exact e.injective) hR hb hb₀ hrel

end MixedHessian

/-! ### Elimination of the internal vertices -/

section Elimination

variable [CompleteSpace E] {S : Fin (n + 2) → E × E → ℝ} {q Q : E} {a : Fin (n + 1) → E}

/-- **Elimination of the internal vertices of an open chain.** Let the open chain with endpoints
`q`, `Q` and internal vertices `a` be matched at every internal vertex, and let the negative
Hessian `-∂_a ∂_a F` of the open-chain action in the internal vertices be invertible there. Then
there is a `C^(m+1)` branch `b(q, Q)` through `a` along which the chain stays matched near `(q, Q)`,
and the generating function `R(q, Q) = F(q, Q, b(q, Q))` is `C^(m+2)`. Near `(q, Q)` its source
covector is that of `S_0` over `(q, b_0)` and its target covector is that of `S_(n+1)` over
`(b_n, Q)`. Near `((q, Q), a)`, the matched configurations are exactly the points of the graph of
`b`. -/
theorem exists_openChainElimination {m : WithTop ℕ∞}
    (hS : ∀ k, ContDiffAt ℝ (m + 2) (S k) (openChainEdge k ((q, Q), a)))
    (hmatch : ∀ i : Fin (n + 1),
      cotangentGeneratingTarget (S i.castSucc) (openChainEdge i.castSucc ((q, Q), a)) =
        cotangentGeneratingSource (S i.succ) (openChainEdge i.succ ((q, Q), a)))
    (hH : (cotangentLegendreHessian (openChainAction S) ((q, Q), a)).IsInvertible) :
    ∃ (b : E × E → Fin (n + 1) → E) (R : E × E → ℝ), b (q, Q) = a ∧
      (∀ y, R y = openChainAction S (y, b y)) ∧
      ContDiffAt ℝ (m + 1) b (q, Q) ∧ ContDiffAt ℝ (m + 2) R (q, Q) ∧
      (∀ᶠ y in 𝓝 (q, Q),
        (∀ i : Fin (n + 1),
          cotangentGeneratingTarget (S i.castSucc) (openChainEdge i.castSucc (y, b y)) =
            cotangentGeneratingSource (S i.succ) (openChainEdge i.succ (y, b y))) ∧
        cotangentGeneratingSource R y = cotangentGeneratingSource (S 0) (y.1, b y 0) ∧
        cotangentGeneratingTarget R y =
          cotangentGeneratingTarget (S (Fin.last (n + 1))) (b y (Fin.last n), y.2)) ∧
      (∀ᶠ x in 𝓝 ((q, Q), a),
        (∀ i : Fin (n + 1),
          cotangentGeneratingTarget (S i.castSucc) (openChainEdge i.castSucc x) =
            cotangentGeneratingSource (S i.succ) (openChainEdge i.succ x)) ↔ b x.1 = x.2) := by
  have hS₂ (k : Fin (n + 2)) : ContDiffAt ℝ 2 (S k) (openChainEdge k ((q, Q), a)) :=
    (hS k).of_le (by simp)
  have hdiff (k : Fin (n + 2)) :
      ∀ᶠ e in 𝓝 (openChainEdge k ((q, Q), a)), DifferentiableAt ℝ (S k) e :=
    (hS₂ k).eventually_differentiableAt (by norm_num)
  -- Eliminate the internal vertices from the first edge plus the rest of the chain.
  have hH' : (cotangentLegendreHessian
      (cotangentGeneratingSum (openChainHead S) (openChainTail S)) ((q, Q), a)).IsInvertible := by
    rwa [← openChainAction_eq_cotangentGeneratingSum]
  obtain ⟨b, R, D, hDo, hmem, hb₀, hRdef, hb, hR, hrelD, huniq⟩ :=
    exists_cotangentGeneratingComposition (contDiffAt_openChainHead (x := ((q, Q), a)) (hS 0))
      (contDiffAt_openChainTail (x := ((q, Q), a)) fun i ↦ hS i.succ)
      ((openChainHead_match_iff fun k ↦ (hS₂ k).differentiableAt two_ne_zero).2 hmatch) hH'
  have hto (k : Fin (n + 2)) : Tendsto (fun y ↦ openChainEdge k (y, b y)) (𝓝 (q, Q))
      (𝓝 (openChainEdge k ((q, Q), a))) := by
    have h := ((openChainEdge (E := E) k).continuous.tendsto _).comp
      (continuousAt_id.prodMk (hb.continuousAt (n := m + 1))).tendsto
    simpa only [Function.comp_def, id_eq, hb₀] using h
  refine ⟨b, R, hb₀, fun ⟨y₁, y₂⟩ ↦ by
    rw [hRdef, openChainAction_eq_cotangentGeneratingSum, cotangentGeneratingSum_apply], hb, hR, ?_,
    ?_⟩
  · filter_upwards [hDo.mem_nhds hmem, eventually_all.2 fun k ↦ (hto k).eventually (hdiff k)]
      with y hyD hy
    obtain ⟨h₁, h₂, h₃⟩ := hrelD y hyD
    exact ⟨(openChainHead_match_iff (x := (y, b y)) hy).1 h₁,
      h₂.trans (cotangentGeneratingSource_openChainHead (x := (y, b y)) (hy 0)),
      h₃.trans (cotangentGeneratingTarget_openChainTail (x := (y, b y)) fun i ↦ hy i.succ)⟩
  · filter_upwards [huniq, eventually_all.2 fun k ↦
      ((openChainEdge (E := E) k).continuous.tendsto _).eventually (hdiff k)] with x hx hxd
    exact (openChainHead_match_iff hxd).symm.trans hx

/-- **The eliminated generating function generates the composite.** Let `R` be a `C²` generating
function with invertible mixed Hessian whose source and target covectors are those of the first
and last edges along a branch `b` of matched configurations of an open chain, continuous at
`(q₀, Q₀)`. If every `S_k` is `C²` with invertible mixed Hessian on its edge, then near the source
point the map generated by `R` is the composite `φ_(n+1) ∘ ⋯ ∘ φ_0` of the maps generated by the
`S_k`. -/
theorem cotangentGeneratedMap_eventuallyEq_foldl_openChain
    {b : E × E → Fin (n + 1) → E} {R : E × E → ℝ}
    (hS : ∀ k, ContDiffAt ℝ 2 (S k) (openChainEdge k ((q, Q), a)))
    (hM : ∀ k, (cotangentMixedHessian (S k) (openChainEdge k ((q, Q), a))).IsInvertible)
    (hR : ContDiffAt ℝ 2 R (q, Q)) (hMR : (cotangentMixedHessian R (q, Q)).IsInvertible)
    (hb : ContinuousAt b (q, Q)) (hb₀ : b (q, Q) = a)
    (hrel : ∀ᶠ y in 𝓝 (q, Q),
      (∀ i : Fin (n + 1),
        cotangentGeneratingTarget (S i.castSucc) (openChainEdge i.castSucc (y, b y)) =
          cotangentGeneratingSource (S i.succ) (openChainEdge i.succ (y, b y))) ∧
      cotangentGeneratingSource R y = cotangentGeneratingSource (S 0) (y.1, b y 0) ∧
      cotangentGeneratingTarget R y =
        cotangentGeneratingTarget (S (Fin.last (n + 1))) (b y (Fin.last n), y.2)) :
    cotangentGeneratedMap hR hMR =ᶠ[𝓝 (cotangentGeneratingSource R (q, Q))]
      Fin.foldl (n + 2) (fun g k ↦ cotangentGeneratedMap (hS k) (hM k) ∘ g) id := by
  have hto (k : Fin (n + 2)) : Tendsto (fun y ↦ openChainEdge k (y, b y)) (𝓝 (q, Q))
      (𝓝 (openChainEdge k ((q, Q), a))) := by
    have h := ((openChainEdge (E := E) k).continuous.tendsto _).comp
      (continuousAt_id.prodMk hb).tendsto
    simpa only [Function.comp_def, id_eq, hb₀] using h
  -- A composite of maps sends the first state of a chain of states to the last one.
  have hfold : ∀ (l : ℕ) (φ : Fin l → E × StrongDual ℝ E → E × StrongDual ℝ E)
      (w : Fin (l + 1) → E × StrongDual ℝ E), (∀ k, w k.succ = φ k (w k.castSucc)) →
        Fin.foldl l (fun g k ↦ φ k ∘ g) id (w 0) = w (Fin.last l) := by
    intro l
    induction l with
    | zero => intro φ w _; rfl
    | succ l ih =>
      intro φ w hw
      rw [Fin.foldl_succ_last, Function.comp_apply, ← Fin.castSucc_zero,
        ih (fun k ↦ φ k.castSucc) (fun k ↦ w k.castSucc)
          (fun k ↦ by simpa only [Fin.succ_castSucc] using hw k.castSucc),
        ← hw, Fin.succ_last]
  -- On the source projection of `R`, both maps send `src R y` to `tgt R y`.
  have hsrc : ∀ᶠ y in 𝓝 (q, Q),
      cotangentGeneratedMap hR hMR (cotangentGeneratingSource R y) =
        Fin.foldl (n + 2) (fun g k ↦ cotangentGeneratedMap (hS k) (hM k) ∘ g) id
          (cotangentGeneratingSource R y) := by
    filter_upwards [hrel, eventually_cotangentGeneratedMap_cotangentGeneratingSource hR hMR,
      eventually_all.2 fun k ↦ (hto k).eventually
        (eventually_cotangentGeneratedMap_cotangentGeneratingSource (hS k) (hM k))]
      with y ⟨hmatch, hsrcR, htgtR⟩ hRy hky
    -- The states of the chain: the source points of the edges, then the target point of the last.
    let w : Fin (n + 3) → E × StrongDual ℝ E :=
      Fin.snoc (fun k : Fin (n + 2) ↦ cotangentGeneratingSource (S k) (openChainEdge k (y, b y)))
        (cotangentGeneratingTarget (S (Fin.last (n + 1)))
          (openChainEdge (Fin.last (n + 1)) (y, b y)))
    have hw0 : w 0 = cotangentGeneratingSource R y := by
      rw [hsrcR, ← Fin.castSucc_zero]
      simp [w, openChainEdge_zero]
    have hwl : w (Fin.last (n + 2)) = cotangentGeneratingTarget R y := by
      rw [htgtR]
      simp [w, openChainEdge_last]
    rw [hRy, ← hw0, hfold _ _ w ?_, hwl]
    intro k
    induction k using Fin.lastCases with
    | last => simp [w, hky]
    | cast j =>
      rw [Fin.succ_castSucc]
      simp only [w, Fin.snoc_castSucc, hky]
      exact (hmatch j).symm
  filter_upwards [(tendsto_cotangentGeneratingBranch hR hMR).eventually hsrc,
    eventually_cotangentGeneratingSource_cotangentGeneratingBranch hR hMR] with z hz hz'
  rwa [hz'] at hz

/-- **Elimination of the internal vertices of an open chain of generating functions of the first
kind.** Let `S_0, …, S_(n+1)` be `C²` generating functions on a finite-dimensional space, with
invertible mixed Hessians on the edges of an open chain with endpoints `q`, `Q` and internal
vertices `a`, matched at every internal vertex, and let the negative Hessian of the open-chain
action in the internal vertices be invertible there. Then there is a `C¹` branch `b(q, Q)` through
`a` along which the chain stays matched near `(q, Q)`, and the generating function
`R(q, Q) = F(q, Q, b(q, Q))` has, near `(q, Q)`, the source covector of `S_0` and the target
covector of `S_(n+1)` along the branch. It is `C²` with invertible mixed Hessian, and near the
source point the map it generates is the composite `φ_(n+1) ∘ ⋯ ∘ φ_0` of the maps generated by the
`S_k`. -/
theorem exists_openChainElimination_generatedMap [FiniteDimensional ℝ E]
    (hS : ∀ k, ContDiffAt ℝ 2 (S k) (openChainEdge k ((q, Q), a)))
    (hM : ∀ k, (cotangentMixedHessian (S k) (openChainEdge k ((q, Q), a))).IsInvertible)
    (hmatch : ∀ i : Fin (n + 1),
      cotangentGeneratingTarget (S i.castSucc) (openChainEdge i.castSucc ((q, Q), a)) =
        cotangentGeneratingSource (S i.succ) (openChainEdge i.succ ((q, Q), a)))
    (hH : (cotangentLegendreHessian (openChainAction S) ((q, Q), a)).IsInvertible) :
    ∃ (b : E × E → Fin (n + 1) → E) (R : E × E → ℝ), b (q, Q) = a ∧
      (∀ y, R y = openChainAction S (y, b y)) ∧ ContDiffAt ℝ 1 b (q, Q) ∧
      (∀ᶠ y in 𝓝 (q, Q),
        (∀ i : Fin (n + 1),
          cotangentGeneratingTarget (S i.castSucc) (openChainEdge i.castSucc (y, b y)) =
            cotangentGeneratingSource (S i.succ) (openChainEdge i.succ (y, b y))) ∧
        cotangentGeneratingSource R y = cotangentGeneratingSource (S 0) (y.1, b y 0) ∧
        cotangentGeneratingTarget R y =
          cotangentGeneratingTarget (S (Fin.last (n + 1))) (b y (Fin.last n), y.2)) ∧
      ∃ (hR : ContDiffAt ℝ 2 R (q, Q)) (hMR : (cotangentMixedHessian R (q, Q)).IsInvertible),
        cotangentGeneratedMap hR hMR =ᶠ[𝓝 (cotangentGeneratingSource R (q, Q))]
          Fin.foldl (n + 2) (fun g k ↦ cotangentGeneratedMap (hS k) (hM k) ∘ g) id := by
  obtain ⟨b, R, hb₀, hRdef, hb, hR, hrel, -⟩ :=
    exists_openChainElimination (m := 0) (by simpa using hS) hmatch hH
  have hb₁ : ContDiffAt ℝ 1 b (q, Q) := by simpa using hb
  have hR₂ : ContDiffAt ℝ 2 R (q, Q) := by simpa using hR
  have hMR := isInvertible_cotangentMixedHessian_openChain
    (fun k ↦ ((hS k).fderiv_right (m := 1) le_rfl).differentiableAt one_ne_zero) hM
    ((hR₂.fderiv_right (m := 1) le_rfl).differentiableAt one_ne_zero)
    (hb₁.differentiableAt one_ne_zero) hb₀ (hrel.mono fun _ h ↦ ⟨h.1, h.2.1⟩)
  exact ⟨b, R, hb₀, hRdef, hb₁, hrel, hR₂, hMR,
    cotangentGeneratedMap_eventuallyEq_foldl_openChain hS hM hR₂ hMR hb₁.continuousAt hb₀ hrel⟩

end Elimination

end TauCeti
