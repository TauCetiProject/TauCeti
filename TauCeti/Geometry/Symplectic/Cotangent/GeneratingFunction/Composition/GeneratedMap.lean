public import TauCeti.Geometry.Symplectic.Cotangent.GeneratingFunction.Composition.Basic
import TauCeti.Analysis.Calculus.ContDiff.Differentiable

/-!
# The mixed Hessian and the generated map of a composite generating function

Let `S(q, a)` on `V × W` and `T(a, Q)` on `W × U` be generating functions, with the convention
`p = ∂_q S`, `P = -∂_Q S`. Eliminating the intermediate position `a` from `S(q, a) + T(a, Q)` along
a stationary branch `b(q, Q)` gives the composite generating function

`R(q, Q) = S(q, b(q, Q)) + T(b(q, Q), Q)`

(`TauCeti.exists_cotangentGeneratingComposition`), whose source covector is that of `S` and whose
target covector is that of `T` along the branch. This file computes the mixed Hessian of `R` and
identifies the canonical transformation it generates with the composite of those generated by `S`
and `T`.

Write `L` for the negative intermediate Hessian `-∂_a ∂_a (S + T)` at the matched point
(`TauCeti.cotangentLegendreHessian` of `TauCeti.cotangentGeneratingSum S T`), and `M_S`, `M_T`,
`M_R` for the mixed Hessians `∂_a ∂_q S`, `∂_Q ∂_a T`, `∂_Q ∂_q R`
(`TauCeti.cotangentMixedHessian`).

* **The derivative of the branch.** Differentiating the stationary equation along the branch in
  the direction of `Q` gives `L ∘ ∂_Q b = M_T`
  (`TauCeti.cotangentLegendreHessian_comp_fderiv_comp_inr`).
* **The mixed Hessian of the composite.** Differentiating `∂_q R(q, Q) = ∂_q S(q, b(q, Q))` gives
  `M_R = M_S ∘ ∂_Q b` (`TauCeti.cotangentMixedHessian_eq_comp_fderiv_comp_inr`). When `L` is
  invertible, which is the nondegeneracy hypothesis of the elimination, this is

  `M_R = M_S ∘ L⁻¹ ∘ M_T`

  (`TauCeti.cotangentMixedHessian_eq_comp_inverse_comp`). So if `S` and `T` have invertible mixed
  Hessians, so does `R` (`TauCeti.isInvertible_cotangentMixedHessian_of_comp`): the composite of
  two generating functions of the first kind is again of the first kind near the matched point.
* **The generated map of the composite.** Near the source point, the map generated by `R` is the
  composite of the maps generated by `S` and by `T`
  (`TauCeti.cotangentGeneratedMap_eventuallyEq_comp`).

`TauCeti.exists_cotangentGeneratingComposition_generatedMap` combines these statements with the
elimination `TauCeti.exists_cotangentGeneratingComposition`: for `C²` generating functions with
invertible mixed Hessians at a matched point and an invertible intermediate Hessian, it gives a
stationary branch through the intermediate position along which the composite generating function
is `C²`, has the source covector of `S` and the target covector of `T`, has invertible mixed
Hessian `M_S ∘ L⁻¹ ∘ M_T` and generates the composite canonical transformation near the source
point. This is the case `N = 2` of the elimination of the internal variables of
an open chain `S₀(q₀, q₁) + ⋯ + S_(N-1)(q_(N-1), q_N)`.

All statements are local: they concern the stationary branch through the chosen intermediate
position, not other critical points of `a ↦ S(q, a) + T(a, Q)`.

## References

* V. I. Arnold, *Mathematical Methods of Classical Mechanics*, second edition,
  Springer, 1989, §48 (composition of canonical transformations).
* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Section 5 (Proposition 5.2, the generating function of the second iterate).
-/

public section

noncomputable section

open ContinuousLinearMap Filter
open scoped Topology

namespace TauCeti

variable {V W U : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
  [NormedAddCommGroup W] [NormedSpace ℝ W] [NormedAddCommGroup U] [NormedSpace ℝ U]
  {S : V × W → ℝ} {T : W × U → ℝ} {b : V × U → W} {R : V × U → ℝ} {q : V} {a : W} {Q : U}

/-! ### The derivative of the stationary branch and the mixed Hessian of the composite -/

/-- **The derivative of the stationary branch.** If `b(q, Q)` solves the stationary equation
`∂_a S(q, b) + ∂_a T(b, Q) = 0` near `(q₀, Q₀)` and is differentiable there, then its derivative in
the direction of `Q` solves `L ∘ ∂_Q b = M_T`, where `L = -∂_a ∂_a (S + T)` is the negative
intermediate Hessian and `M_T = ∂_Q ∂_a T` the mixed Hessian of `T`. -/
theorem cotangentLegendreHessian_comp_fderiv_comp_inr
    (hS : ContDiffAt ℝ 2 S (q, a)) (hT : ContDiffAt ℝ 2 T (a, Q))
    (hb : DifferentiableAt ℝ b (q, Q)) (hb₀ : b (q, Q) = a)
    (hmatch : ∀ᶠ y in 𝓝 (q, Q),
      cotangentGeneratingTarget S (y.1, b y) = cotangentGeneratingSource T (b y, y.2)) :
    cotangentLegendreHessian (cotangentGeneratingSum S T) ((q, Q), a) ∘L
        (fderiv ℝ b (q, Q) ∘L inr ℝ V U) =
      cotangentMixedHessian T (a, Q) := by
  subst hb₀
  set F := cotangentGeneratingSum S T
  set G : (V × U) × W → StrongDual ℝ W := fun x ↦ (cotangentGeneratingTarget F x).2
  have hF : ContDiffAt ℝ 2 F ((q, Q), b (q, Q)) := contDiffAt_cotangentGeneratingSum hS hT
  -- The stationary equation is `G (y, b y) = 0`.
  have hG : HasFDerivAt G ((snd ℝ W (StrongDual ℝ W)).comp
      ((snd ℝ (V × U) W).prod (-(precomp ℝ (inr ℝ (V × U) W) ∘L
        fderiv ℝ (fderiv ℝ F) ((q, Q), b (q, Q)))))) ((q, Q), b (q, Q)) :=
    (hasFDerivAt_cotangentGeneratingTarget
      ((hF.fderiv_right (m := 1) le_rfl).differentiableAt one_ne_zero)).snd
  have hgraph : HasFDerivAt (fun y : V × U ↦ (y, b y))
      ((ContinuousLinearMap.id ℝ (V × U)).prod (fderiv ℝ b (q, Q))) (q, Q) :=
    (hasFDerivAt_id _).prodMk hb.hasFDerivAt
  have hcomp := hG.comp (q, Q) hgraph
  -- Along the branch the stationary equation holds identically, so its derivative vanishes.
  have hto₁ : Tendsto (fun y : V × U ↦ (y.1, b y)) (𝓝 (q, Q)) (𝓝 (q, b (q, Q))) :=
    (continuousAt_fst.prodMk hb.continuousAt).tendsto
  have hto₂ : Tendsto (fun y : V × U ↦ (b y, y.2)) (𝓝 (q, Q)) (𝓝 (b (q, Q), Q)) :=
    (hb.continuousAt.prodMk continuousAt_snd).tendsto
  have hzero : (fun y ↦ G (y, b y)) =ᶠ[𝓝 (q, Q)] fun _ ↦ 0 := by
    filter_upwards [hmatch, hto₁.eventually (hS.eventually_differentiableAt (by norm_num)),
      hto₂.eventually (hT.eventually_differentiableAt (by norm_num))] with y hy hSy hTy
    exact (cotangentGeneratingTarget_sum_snd_eq_zero_iff (x := (y, b y)) hSy hTy).2 hy
  have hD := hcomp.unique ((hasFDerivAt_const (0 : StrongDual ℝ W) (q, Q)).congr_of_eventuallyEq
    hzero)
  refine ContinuousLinearMap.ext fun δQ ↦ ContinuousLinearMap.ext fun c ↦ ?_
  have h := congrArg (fun L ↦ L (0, δQ) c) hD
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.prod_apply, coe_snd',
    ContinuousLinearMap.id_apply, _root_.neg_apply, precomp_apply, inr_apply,
    _root_.zero_apply, F] at h
  rw [fderiv_fderiv_cotangentGeneratingSum_apply (x := ((q, Q), b (q, Q))) hS hT] at h
  simp only [F, ContinuousLinearMap.comp_apply, inr_apply,
    cotangentLegendreHessian_cotangentGeneratingSum_apply_apply hS hT,
    cotangentMixedHessian_apply_apply]
  -- Split the variation `(∂_Q b δQ, δQ)` of `T` into its two components.
  have hsplit : fderiv ℝ (fderiv ℝ T) (b (q, Q), Q) (fderiv ℝ b (q, Q) (0, δQ), δQ) =
      fderiv ℝ (fderiv ℝ T) (b (q, Q), Q) (fderiv ℝ b (q, Q) (0, δQ), 0) +
        fderiv ℝ (fderiv ℝ T) (b (q, Q), Q) (0, δQ) := by
    rw [← map_add, Prod.mk_add_mk, add_zero, zero_add]
  simp only [hsplit, _root_.add_apply, Prod.fst_zero, Prod.snd_zero] at h
  linarith

/-- **The mixed Hessian of the composite generating function.** If the source covector of `R` is
that of `S` along a branch `b` differentiable at `(q₀, Q₀)`, that is
`∂_q R(q, Q) = ∂_q S(q, b(q, Q))` near `(q₀, Q₀)`, then `M_R = M_S ∘ ∂_Q b`. -/
theorem cotangentMixedHessian_eq_comp_fderiv_comp_inr
    (hS : DifferentiableAt ℝ (fderiv ℝ S) (q, a)) (hR : DifferentiableAt ℝ (fderiv ℝ R) (q, Q))
    (hb : DifferentiableAt ℝ b (q, Q)) (hb₀ : b (q, Q) = a)
    (hsrc : ∀ᶠ y in 𝓝 (q, Q),
      cotangentGeneratingSource R y = cotangentGeneratingSource S (y.1, b y)) :
    cotangentMixedHessian R (q, Q) =
      cotangentMixedHessian S (q, a) ∘L (fderiv ℝ b (q, Q) ∘L inr ℝ V U) := by
  subst hb₀
  have hR' := (hasFDerivAt_cotangentGeneratingSource hR).snd
  have hS' := (hasFDerivAt_cotangentGeneratingSource hS).snd
  have hgraph : HasFDerivAt (fun y : V × U ↦ (y.1, b y))
      ((fst ℝ V U).prod (fderiv ℝ b (q, Q))) (q, Q) :=
    hasFDerivAt_fst.prodMk hb.hasFDerivAt
  have hcomp := hS'.comp (q, Q) hgraph
  have hD := hR'.unique (hcomp.congr_of_eventuallyEq
    (hsrc.mono fun y hy ↦ congrArg Prod.snd hy))
  refine ContinuousLinearMap.ext fun δQ ↦ ContinuousLinearMap.ext fun δq ↦ ?_
  have h := congrArg (fun L ↦ L (0, δQ) δq) hD
  simpa only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.prod_apply, coe_snd', coe_fst',
    precomp_apply, inl_apply, inr_apply, cotangentMixedHessian_apply_apply] using h

/-- **The mixed Hessian of the composite generating function**, when the intermediate Hessian is
invertible: `M_R = M_S ∘ L⁻¹ ∘ M_T`. -/
theorem cotangentMixedHessian_eq_comp_inverse_comp
    (hS : ContDiffAt ℝ 2 S (q, a)) (hT : ContDiffAt ℝ 2 T (a, Q))
    (hR : DifferentiableAt ℝ (fderiv ℝ R) (q, Q))
    (hb : DifferentiableAt ℝ b (q, Q)) (hb₀ : b (q, Q) = a)
    (hL : (cotangentLegendreHessian (cotangentGeneratingSum S T) ((q, Q), a)).IsInvertible)
    (hrel : ∀ᶠ y in 𝓝 (q, Q),
      cotangentGeneratingTarget S (y.1, b y) = cotangentGeneratingSource T (b y, y.2) ∧
      cotangentGeneratingSource R y = cotangentGeneratingSource S (y.1, b y)) :
    cotangentMixedHessian R (q, Q) =
      cotangentMixedHessian S (q, a) ∘L
        (cotangentLegendreHessian (cotangentGeneratingSum S T) ((q, Q), a)).inverse ∘L
          cotangentMixedHessian T (a, Q) := by
  rw [cotangentMixedHessian_eq_comp_fderiv_comp_inr
      ((hS.fderiv_right (m := 1) le_rfl).differentiableAt one_ne_zero) hR hb hb₀
      (hrel.mono fun _ h ↦ h.2),
    ← cotangentLegendreHessian_comp_fderiv_comp_inr hS hT hb hb₀ (hrel.mono fun _ h ↦ h.1)]
  obtain ⟨e, he⟩ := hL
  rw [← he, inverse_equiv]
  ext δQ δq
  simp

/-- **The composite of generating functions of the first kind is of the first kind.** If `S` and
`T` have invertible mixed Hessians at the matched point and the intermediate Hessian is
invertible, then the composite generating function `R` has an invertible mixed Hessian. -/
theorem isInvertible_cotangentMixedHessian_of_comp
    (hS : ContDiffAt ℝ 2 S (q, a)) (hT : ContDiffAt ℝ 2 T (a, Q))
    (hR : DifferentiableAt ℝ (fderiv ℝ R) (q, Q))
    (hb : DifferentiableAt ℝ b (q, Q)) (hb₀ : b (q, Q) = a)
    (hL : (cotangentLegendreHessian (cotangentGeneratingSum S T) ((q, Q), a)).IsInvertible)
    (hMS : (cotangentMixedHessian S (q, a)).IsInvertible)
    (hMT : (cotangentMixedHessian T (a, Q)).IsInvertible)
    (hrel : ∀ᶠ y in 𝓝 (q, Q),
      cotangentGeneratingTarget S (y.1, b y) = cotangentGeneratingSource T (b y, y.2) ∧
      cotangentGeneratingSource R y = cotangentGeneratingSource S (y.1, b y)) :
    (cotangentMixedHessian R (q, Q)).IsInvertible := by
  rw [cotangentMixedHessian_eq_comp_inverse_comp hS hT hR hb hb₀ hL hrel]
  obtain ⟨e, he⟩ := hL
  refine hMS.comp (IsInvertible.comp ?_ hMT)
  rw [← he, inverse_equiv]
  exact isInvertible_equiv

/-! ### The generated map of the composite -/

section Generated

variable [CompleteSpace V] [CompleteSpace W] [CompleteSpace U]

/-- **The composite generating function generates the composite canonical transformation.**
Let `R` be a generating function whose source covector is that of `S` and whose target covector
is that of `T` along a branch `b` of the matching equation `-∂_a S(q, b) = ∂_a T(b, Q)`. If `S`,
`T` and `R` are `C²` with invertible mixed Hessians at the matched points, then near the source
point the map generated by `R` is the map generated by `T` after the map generated by `S`. -/
theorem cotangentGeneratedMap_eventuallyEq_comp
    (hS : ContDiffAt ℝ 2 S (q, a)) (hMS : (cotangentMixedHessian S (q, a)).IsInvertible)
    (hT : ContDiffAt ℝ 2 T (a, Q)) (hMT : (cotangentMixedHessian T (a, Q)).IsInvertible)
    (hR : ContDiffAt ℝ 2 R (q, Q)) (hMR : (cotangentMixedHessian R (q, Q)).IsInvertible)
    (hb : ContinuousAt b (q, Q)) (hb₀ : b (q, Q) = a)
    (hrel : ∀ᶠ y in 𝓝 (q, Q),
      cotangentGeneratingTarget S (y.1, b y) = cotangentGeneratingSource T (b y, y.2) ∧
      cotangentGeneratingSource R y = cotangentGeneratingSource S (y.1, b y) ∧
      cotangentGeneratingTarget R y = cotangentGeneratingTarget T (b y, y.2)) :
    cotangentGeneratedMap hR hMR =ᶠ[𝓝 (cotangentGeneratingSource R (q, Q))]
      cotangentGeneratedMap hT hMT ∘ cotangentGeneratedMap hS hMS := by
  have hto₁ : Tendsto (fun y : V × U ↦ (y.1, b y)) (𝓝 (q, Q)) (𝓝 (q, a)) := by
    simpa only [hb₀] using (continuousAt_fst.prodMk hb).tendsto
  have hto₂ : Tendsto (fun y : V × U ↦ (b y, y.2)) (𝓝 (q, Q)) (𝓝 (a, Q)) := by
    simpa only [hb₀] using (hb.prodMk continuousAt_snd).tendsto
  -- On the source projection of `R`, both maps send `src R y` to `tgt R y`.
  have hsrc : ∀ᶠ y in 𝓝 (q, Q),
      cotangentGeneratedMap hR hMR (cotangentGeneratingSource R y) =
        (cotangentGeneratedMap hT hMT ∘ cotangentGeneratedMap hS hMS)
          (cotangentGeneratingSource R y) := by
    filter_upwards [hrel, eventually_cotangentGeneratedMap_cotangentGeneratingSource hR hMR,
      hto₁.eventually (eventually_cotangentGeneratedMap_cotangentGeneratingSource hS hMS),
      hto₂.eventually (eventually_cotangentGeneratedMap_cotangentGeneratingSource hT hMT)]
      with y ⟨hmatch, hsrcR, htgtR⟩ hRy hSy hTy
    rw [hRy, Function.comp_apply, hsrcR, hSy, hmatch, hTy, htgtR]
  -- Every point near the source point is the source projection of a point near `(q₀, Q₀)`.
  filter_upwards [(tendsto_cotangentGeneratingBranch hR hMR).eventually hsrc,
    eventually_cotangentGeneratingSource_cotangentGeneratingBranch hR hMR] with z hz hz'
  rwa [hz'] at hz

end Generated

/-! ### Elimination with the generated map -/

variable [CompleteSpace V] [CompleteSpace W] [CompleteSpace U]

/-- **Composition of generating functions of the first kind.** Let `S(q, a)` and `T(a, Q)` be `C²`
generating functions with invertible mixed Hessians at a matched point, where the target covector
of `S` at `(q₀, a₀)` is the source covector of `T` at `(a₀, Q₀)`, and let the negative intermediate
Hessian `L = -∂_a ∂_a (S + T)` be invertible there. Then there is a `C¹` branch `b(q, Q)` through
`a₀` that is stationary near `(q₀, Q₀)`: there the target covector of `S` at `(q, b)` is the source
covector of `T` at `(b, Q)`. The function `R(q, Q) = S(q, b) + T(b, Q)` has, near `(q₀, Q₀)`, the
source covector of `S` and the target covector of `T` along the branch. It is a `C²` generating
function with invertible mixed Hessian `M_R = M_S ∘ L⁻¹ ∘ M_T`, and near the source point the map
generated by `R` is the map generated by `T` after the map generated by `S`. -/
theorem exists_cotangentGeneratingComposition_generatedMap
    (hS : ContDiffAt ℝ 2 S (q, a)) (hMS : (cotangentMixedHessian S (q, a)).IsInvertible)
    (hT : ContDiffAt ℝ 2 T (a, Q)) (hMT : (cotangentMixedHessian T (a, Q)).IsInvertible)
    (hmatch : cotangentGeneratingTarget S (q, a) = cotangentGeneratingSource T (a, Q))
    (hL : (cotangentLegendreHessian (cotangentGeneratingSum S T) ((q, Q), a)).IsInvertible) :
    ∃ (b : V × U → W) (R : V × U → ℝ), b (q, Q) = a ∧
      (∀ y, R y = S (y.1, b y) + T (b y, y.2)) ∧ ContDiffAt ℝ 1 b (q, Q) ∧
      (∀ᶠ y in 𝓝 (q, Q),
        cotangentGeneratingTarget S (y.1, b y) = cotangentGeneratingSource T (b y, y.2) ∧
        cotangentGeneratingSource R y = cotangentGeneratingSource S (y.1, b y) ∧
        cotangentGeneratingTarget R y = cotangentGeneratingTarget T (b y, y.2)) ∧
      ∃ (hR : ContDiffAt ℝ 2 R (q, Q)) (hMR : (cotangentMixedHessian R (q, Q)).IsInvertible),
        cotangentMixedHessian R (q, Q) =
          cotangentMixedHessian S (q, a) ∘L
            (cotangentLegendreHessian (cotangentGeneratingSum S T) ((q, Q), a)).inverse ∘L
              cotangentMixedHessian T (a, Q) ∧
        cotangentGeneratedMap hR hMR =ᶠ[𝓝 (cotangentGeneratingSource R (q, Q))]
          cotangentGeneratedMap hT hMT ∘ cotangentGeneratedMap hS hMS := by
  obtain ⟨b, R, D, hD, hmem, hb₀, hRdef, hb, hR₂, hrelD, -⟩ :=
    exists_cotangentGeneratingComposition (n := 0) (by simpa using hS) (by simpa using hT) hmatch hL
  have hb₁ : ContDiffAt ℝ 1 b (q, Q) := by simpa using hb
  have hR : ContDiffAt ℝ 2 R (q, Q) := by simpa using hR₂
  have hrel : ∀ᶠ y in 𝓝 (q, Q),
      cotangentGeneratingTarget S (y.1, b y) = cotangentGeneratingSource T (b y, y.2) ∧
      cotangentGeneratingSource R y = cotangentGeneratingSource S (y.1, b y) ∧
      cotangentGeneratingTarget R y = cotangentGeneratingTarget T (b y, y.2) :=
    Filter.mem_of_superset (hD.mem_nhds hmem) fun y hy ↦ hrelD y hy
  have hbd : DifferentiableAt ℝ b (q, Q) := hb₁.differentiableAt one_ne_zero
  have hRd : DifferentiableAt ℝ (fderiv ℝ R) (q, Q) :=
    (hR.fderiv_right (m := 1) le_rfl).differentiableAt one_ne_zero
  have hrel' : ∀ᶠ y in 𝓝 (q, Q),
      cotangentGeneratingTarget S (y.1, b y) = cotangentGeneratingSource T (b y, y.2) ∧
      cotangentGeneratingSource R y = cotangentGeneratingSource S (y.1, b y) :=
    hrel.mono fun _ h ↦ ⟨h.1, h.2.1⟩
  have hMR := isInvertible_cotangentMixedHessian_of_comp hS hT hRd hbd hb₀ hL hMS hMT hrel'
  exact ⟨b, R, hb₀, hRdef, hb₁, hrel, hR, hMR,
    cotangentMixedHessian_eq_comp_inverse_comp hS hT hRd hbd hb₀ hL hrel',
    cotangentGeneratedMap_eventuallyEq_comp hS hMS hT hMT hR hMR hb₁.continuousAt hb₀ hrel⟩

end TauCeti
