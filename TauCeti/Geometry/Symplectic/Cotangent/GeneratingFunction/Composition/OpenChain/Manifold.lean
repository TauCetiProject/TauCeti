module

public import TauCeti.Geometry.Symplectic.Cotangent.GeneratingFunction.Composition.Manifold
import TauCeti.Geometry.Manifold.MFDeriv.NormedSpace

/-!
# Elimination of the internal vertices of an open chain of three generating functions on manifolds

Let `S₀(q, a)` on `M₁ × M₂`, `S₁(a, c)` on `M₂ × M₃` and `S₂(c, Q)` on `M₃ × M₄` be real
functions. They generate cotangent relations `T*M₁ ⇝ T*M₂ ⇝ T*M₃ ⇝ T*M₄`, with the convention
`p = d_q S`, `P = -d_Q S` (`TauCeti.CotangentBundle.generatingSource`,
`TauCeti.CotangentBundle.generatingTarget`). The **open chain** with endpoints `q`, `Q` and
internal vertices `a`, `c` has the action

`F(q, Q, (a, c)) = S₀(q, a) + S₁(a, c) + S₂(c, Q)`.

Composing the three relations means matching the cotangent points at both internal vertices:

`-d_a S₀(q, a) = d_a S₁(a, c)` and `-d_c S₁(a, c) = d_c S₂(c, Q)`,

that is, `(a, c)` is a critical point of `(a', c') ↦ F(q, Q, (a', c'))` on `M₂ × M₃`.

When this critical point is nondegenerate at `(q₀, (a₀, c₀), Q₀)`, the internal vertices can be
eliminated near `(q₀, Q₀)` (`TauCeti.CotangentBundle.exists_generatingComposition_three`): there is
a stationary branch `b(q, Q) = (a, c) ∈ M₂ × M₃` through `(a₀, c₀)`, along which both matching
equations hold near `(q₀, Q₀)`, and the function `R(q, Q) = F(q, Q, b(q, Q))` generates the
composite relation. Near `(q₀, Q₀)`,

`d_q R(q, Q) = d_q S₀(q, a)`,  `d_Q R(q, Q) = d_Q S₂(c, Q)`,  where `(a, c) = b(q, Q)`,

and near `((q₀, Q₀), (a₀, c₀))` the two matching equations hold exactly on the graph of `b`. The
nondegeneracy hypothesis is on the full Hessian in both internal vertices jointly; neither vertex
needs to be nondegenerate on its own, so the chain is not eliminated one vertex at a time.

The proof groups the chain as a composition of two generating functions with one internal vertex
in the product `M₂ × M₃`: the head `(q, (a, c)) ↦ S₀(q, a) + S₁(a, c)` and the tail
`((a, c), Q) ↦ S₂(c, Q)`. Their intermediate critical point equation is the critical point
equation of `F` in `(a, c)`, so the composition theorem
`TauCeti.CotangentBundle.exists_generatingComposition` eliminates `(a, c)`. A covector on
`M₂ × M₃` vanishes exactly when both of its partial covectors do
(`MDifferentiableAt.mvfderiv_prod_eq_zero_iff`), which splits the matching of the head and tail
into the two matching equations of the chain. This is the manifold version, with two internal
vertices in arbitrary manifolds, of the normed-space elimination
`TauCeti.exists_openChainElimination`, whose proof also groups the chain into two generating
functions, the first edge and the rest of the chain.

When the three functions are smooth generating functions of the first kind and `R` is too, the
map generated by `R` is near the source point the composite `φ₂ ∘ φ₁ ∘ φ₀` of the maps generated
by `S₀`, `S₁` and `S₂` (`TauCeti.CotangentBundle.generatedMap_eventuallyEq_comp_three`). With
`S₀ = S₁ = S₂` this is the generating function of the third iterate of a canonical
transformation.

All conclusions are local. No assertion is made about critical points of the action outside the
chosen neighbourhood, nor about a globally defined composite relation.

## Main results

* `TauCeti.CotangentBundle.exists_generatingComposition_three`: elimination of the two internal
  vertices along a stationary branch, with the endpoint covectors of the eliminated generating
  function.
* `TauCeti.CotangentBundle.generatedMap_eventuallyEq_comp_three`: the eliminated generating
  function generates the composite of the three canonical transformations.

## References

* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Section 5.1 (Proposition 5.2 and the exercise following it, the generating
  functions of the second and third iterates).
* V. I. Arnold, *Mathematical Methods of Classical Mechanics*, second edition,
  Springer, 1989, §48 (composition of canonical transformations).
-/

public section

noncomputable section

open Bundle Filter Function Set
open scoped Manifold ContDiff Topology

namespace TauCeti.CotangentBundle

variable {E₁ E₂ E₃ E₄ H₁ H₂ H₃ H₄ M₁ M₂ M₃ M₄ : Type*}
  [NormedAddCommGroup E₁] [NormedSpace ℝ E₁] [TopologicalSpace H₁] {I₁ : ModelWithCorners ℝ E₁ H₁}
  [TopologicalSpace M₁] [ChartedSpace H₁ M₁]
  [NormedAddCommGroup E₂] [NormedSpace ℝ E₂] [TopologicalSpace H₂] {I₂ : ModelWithCorners ℝ E₂ H₂}
  [TopologicalSpace M₂] [ChartedSpace H₂ M₂]
  [NormedAddCommGroup E₃] [NormedSpace ℝ E₃] [TopologicalSpace H₃] {I₃ : ModelWithCorners ℝ E₃ H₃}
  [TopologicalSpace M₃] [ChartedSpace H₃ M₃]
  [NormedAddCommGroup E₄] [NormedSpace ℝ E₄] [TopologicalSpace H₄] {I₄ : ModelWithCorners ℝ E₄ H₄}
  [TopologicalSpace M₄] [ChartedSpace H₄ M₄]
  {S₀ : M₁ × M₂ → ℝ} {S₁ : M₂ × M₃ → ℝ} {S₂ : M₃ × M₄ → ℝ}

/-! ### Grouping the chain as a composition of two generating functions -/

/-- The head `(q, (a, c)) ↦ S₀(q, a) + S₁(a, c)` of the chain: its first two edges, as a
generating function on `M₁ × (M₂ × M₃)`. -/
private def chainHead (S₀ : M₁ × M₂ → ℝ) (S₁ : M₂ × M₃ → ℝ) (x : M₁ × (M₂ × M₃)) : ℝ :=
  S₀ (x.1, x.2.1) + S₁ x.2

/-- The tail `((a, c), Q) ↦ S₂(c, Q)` of the chain: its last edge, as a generating function on
`(M₂ × M₃) × M₄`. -/
private def chainTail (S₂ : M₃ × M₄ → ℝ) (x : (M₂ × M₃) × M₄) : ℝ :=
  S₂ (x.1.2, x.2)

omit [TopologicalSpace M₂] [TopologicalSpace M₃] in
/-- The source covector of the head is that of the first edge: `S₁` does not depend on `q`. -/
private theorem generatingSource_chainHead (x : M₁ × (M₂ × M₃)) :
    generatingSource I₁ (chainHead S₀ S₁) x = generatingSource I₁ S₀ (x.1, x.2.1) := by
  simp only [generatingSource_eq_mk, chainHead, mvfderiv_add_const]

omit [TopologicalSpace M₁] [TopologicalSpace M₂] [TopologicalSpace M₃] in
/-- The target covector of the tail is that of the last edge. -/
private theorem generatingTarget_chainTail (x : (M₂ × M₃) × M₄) :
    generatingTarget I₄ (chainTail S₂) x = generatingTarget I₄ S₂ (x.1.2, x.2) := by
  simp only [generatingTarget_eq_mk, chainTail]

/-- **Matching of the head and the tail.** The target point of the head over `(q, (a, c))` is the
source point of the tail over `((a, c), Q)` exactly when the chain is matched at both internal
vertices `a` and `c`. -/
private theorem generatingTarget_chainHead_eq_generatingSource_chainTail_iff {q : M₁}
    {p : M₂ × M₃} {Q : M₄} (hS₀ : MDifferentiableAt (I₁.prod I₂) 𝓘(ℝ) S₀ (q, p.1))
    (hS₁ : MDifferentiableAt (I₂.prod I₃) 𝓘(ℝ) S₁ p)
    (hS₂ : MDifferentiableAt (I₃.prod I₄) 𝓘(ℝ) S₂ (p.2, Q)) :
    generatingTarget (I₂.prod I₃) (chainHead S₀ S₁) (q, p) =
        generatingSource (I₂.prod I₃) (chainTail S₂) (p, Q) ↔
      generatingTarget I₂ S₀ (q, p.1) = generatingSource I₂ S₁ p ∧
        generatingTarget I₃ S₁ p = generatingSource I₃ S₂ (p.2, Q) := by
  obtain ⟨a, c⟩ := p
  -- The slices of the three edges through the internal vertices.
  have h₀ : MDifferentiableAt I₂ 𝓘(ℝ) (fun a' ↦ S₀ (q, a')) a :=
    hS₀.comp a (mdifferentiableAt_const.prodMk mdifferentiableAt_id)
  have h₁a : MDifferentiableAt I₂ 𝓘(ℝ) (fun a' ↦ S₁ (a', c)) a :=
    hS₁.comp a (mdifferentiableAt_id.prodMk mdifferentiableAt_const)
  have h₁c : MDifferentiableAt I₃ 𝓘(ℝ) (fun c' ↦ S₁ (a, c')) c :=
    hS₁.comp c (mdifferentiableAt_const.prodMk mdifferentiableAt_id)
  have h₂ : MDifferentiableAt I₃ 𝓘(ℝ) (fun c' ↦ S₂ (c', Q)) c :=
    hS₂.comp c (mdifferentiableAt_id.prodMk mdifferentiableAt_const)
  -- The slices of the head and the tail through `(a, c)`.
  have hH : MDifferentiableAt (I₂.prod I₃) 𝓘(ℝ) (fun x ↦ chainHead S₀ S₁ (q, x)) (a, c) :=
    (hS₀.comp (a, c) (mdifferentiableAt_const.prodMk mdifferentiableAt_fst)).add hS₁
  have hT : MDifferentiableAt (I₂.prod I₃) 𝓘(ℝ) (fun x ↦ chainTail S₂ (x, Q)) (a, c) :=
    hS₂.comp (a, c) (mdifferentiableAt_snd.prodMk mdifferentiableAt_const)
  have hF : MDifferentiableAt (I₂.prod I₃) 𝓘(ℝ)
      (fun x ↦ chainHead S₀ S₁ (q, x) + chainTail S₂ (x, Q)) (a, c) :=
    hH.add hT
  rw [generatingTarget_eq_generatingSource_iff hH hT, hF.mvfderiv_prod_eq_zero_iff,
    generatingTarget_eq_generatingSource_iff h₀ h₁a,
    generatingTarget_eq_generatingSource_iff h₁c h₂]
  -- In each internal vertex, the action differs from the matching sum by a constant.
  simp only [chainHead, chainTail, add_assoc (S₀ (q, a)), mvfderiv_add_const, mvfderiv_const_add]

/-! ### Elimination of the internal vertices -/

section Elimination

variable [I₁.Boundaryless] [I₂.Boundaryless] [I₃.Boundaryless] [I₄.Boundaryless]
  [IsManifold I₁ 1 M₁] [IsManifold I₂ 1 M₂] [IsManifold I₃ 1 M₃] [IsManifold I₄ 1 M₄]

/-- **Elimination of the two internal vertices of an open chain on manifolds.**

Let `S₀` on `M₁ × M₂`, `S₁` on `M₂ × M₃` and `S₂` on `M₃ × M₄` be `C^(n+2)` at `(q₀, a₀)`,
`(a₀, c₀)` and `(c₀, Q₀)`, and let `(a₀, c₀)` be a nondegenerate critical point of the open-chain
action `(a, c) ↦ S₀(q₀, a) + S₁(a, c) + S₂(c, Q₀)` on `M₂ × M₃`, so that the relations they
generate match at both internal vertices. Then there are a stationary branch
`b : M₁ × M₄ → M₂ × M₃` through `(a₀, c₀)`, `C^(n+1)` at `(q₀, Q₀)`, and the generating function
`R(q, Q) = S₀(q, a) + S₁(a, c) + S₂(c, Q)` with `(a, c) = b(q, Q)`, `C^(n+2)` at `(q₀, Q₀)`. Near
`(q₀, Q₀)` the chain is matched at both internal vertices along `b`, and `R` has source covector
`d_q S₀(q, a)` and target covector `-d_Q S₂(c, Q)`. Near `((q₀, Q₀), (a₀, c₀))`, the chain is
matched exactly on the graph of `b`.

All assertions except the value at `(q₀, Q₀)` are local. -/
theorem exists_generatingComposition_three [CompleteSpace E₁] [CompleteSpace E₂]
    [CompleteSpace E₃] [CompleteSpace E₄] {n : WithTop ℕ∞} {q₀ : M₁} {a₀ : M₂} {c₀ : M₃}
    {Q₀ : M₄} (hS₀ : ContMDiffAt (I₁.prod I₂) 𝓘(ℝ) (n + 2) S₀ (q₀, a₀))
    (hS₁ : ContMDiffAt (I₂.prod I₃) 𝓘(ℝ) (n + 2) S₁ (a₀, c₀))
    (hS₂ : ContMDiffAt (I₃.prod I₄) 𝓘(ℝ) (n + 2) S₂ (c₀, Q₀))
    (h : IsManifoldNondegenerateCriticalPoint (I₂.prod I₃)
      (fun x : M₂ × M₃ ↦ S₀ (q₀, x.1) + S₁ x + S₂ (x.2, Q₀)) (a₀, c₀)) :
    ∃ (b : M₁ × M₄ → M₂ × M₃) (R : M₁ × M₄ → ℝ), b (q₀, Q₀) = (a₀, c₀) ∧
      (∀ y, R y = S₀ (y.1, (b y).1) + S₁ (b y) + S₂ ((b y).2, y.2)) ∧
      ContMDiffAt (I₁.prod I₄) (I₂.prod I₃) (n + 1) b (q₀, Q₀) ∧
      ContMDiffAt (I₁.prod I₄) 𝓘(ℝ) (n + 2) R (q₀, Q₀) ∧
      (∀ᶠ y in 𝓝 (q₀, Q₀),
        generatingTarget I₂ S₀ (y.1, (b y).1) = generatingSource I₂ S₁ (b y) ∧
        generatingTarget I₃ S₁ (b y) = generatingSource I₃ S₂ ((b y).2, y.2) ∧
        generatingSource I₁ R y = generatingSource I₁ S₀ (y.1, (b y).1) ∧
        generatingTarget I₄ R y = generatingTarget I₄ S₂ ((b y).2, y.2)) ∧
      (∀ᶠ x in 𝓝 ((q₀, Q₀), (a₀, c₀)),
        (generatingTarget I₂ S₀ (x.1.1, x.2.1) = generatingSource I₂ S₁ x.2 ∧
          generatingTarget I₃ S₁ x.2 = generatingSource I₃ S₂ (x.2.2, x.1.2)) ↔
        b x.1 = x.2) := by
  /- Step 1: eliminate `(a, c)` from the composition of the head with the tail. -/
  have hH : ContMDiffAt (I₁.prod (I₂.prod I₃)) 𝓘(ℝ) (n + 2) (chainHead S₀ S₁) (q₀, (a₀, c₀)) :=
    (hS₀.comp_of_eq (contMDiffAt_fst.prodMk (contMDiffAt_fst.comp _ contMDiffAt_snd)) rfl).add
      (hS₁.comp_of_eq contMDiffAt_snd rfl)
  have hT : ContMDiffAt ((I₂.prod I₃).prod I₄) 𝓘(ℝ) (n + 2) (chainTail S₂) ((a₀, c₀), Q₀) :=
    hS₂.comp_of_eq ((contMDiffAt_snd.comp _ contMDiffAt_fst).prodMk contMDiffAt_snd) rfl
  obtain ⟨b, R, D, hDo, hDmem, hb₀, hRdef, hb, hR, hrel, huniq⟩ :=
    exists_generatingComposition hH hT h
  /- Step 2: the three edges are differentiable near their base points, which the splitting of the
  matching equation needs. -/
  have h1 : (1 : WithTop ℕ∞) ≤ n + 2 := le_add_left one_le_two
  have hd₀ : ∀ᶠ z in 𝓝 (q₀, a₀), MDifferentiableAt (I₁.prod I₂) 𝓘(ℝ) S₀ z :=
    ((contMDiffAt_iff_contMDiffAt_nhds (by simp)).1 (hS₀.of_le h1)).mono
      fun _ hz ↦ hz.mdifferentiableAt one_ne_zero
  have hd₁ : ∀ᶠ z in 𝓝 (a₀, c₀), MDifferentiableAt (I₂.prod I₃) 𝓘(ℝ) S₁ z :=
    ((contMDiffAt_iff_contMDiffAt_nhds (by simp)).1 (hS₁.of_le h1)).mono
      fun _ hz ↦ hz.mdifferentiableAt one_ne_zero
  have hd₂ : ∀ᶠ z in 𝓝 (c₀, Q₀), MDifferentiableAt (I₃.prod I₄) 𝓘(ℝ) S₂ z :=
    ((contMDiffAt_iff_contMDiffAt_nhds (by simp)).1 (hS₂.of_le h1)).mono
      fun _ hz ↦ hz.mdifferentiableAt one_ne_zero
  refine ⟨b, R, hb₀, hRdef, hb, hR, ?_, ?_⟩
  /- Step 3: split the matching of the head and the tail along the branch. -/
  · have hbc : ContinuousAt b (q₀, Q₀) := hb.continuousAt
    have hto₀ : Tendsto (fun y : M₁ × M₄ ↦ (y.1, (b y).1)) (𝓝 (q₀, Q₀)) (𝓝 (q₀, a₀)) := by
      simpa only [hb₀] using (continuousAt_fst.prodMk hbc.fst).tendsto
    have hto₁ : Tendsto b (𝓝 (q₀, Q₀)) (𝓝 (a₀, c₀)) := by
      simpa only [hb₀] using hbc.tendsto
    have hto₂ : Tendsto (fun y : M₁ × M₄ ↦ ((b y).2, y.2)) (𝓝 (q₀, Q₀)) (𝓝 (c₀, Q₀)) := by
      simpa only [hb₀] using (hbc.snd.prodMk continuousAt_snd).tendsto
    filter_upwards [hDo.mem_nhds hDmem, hto₀.eventually hd₀, hto₁.eventually hd₁,
      hto₂.eventually hd₂] with y hyD hy₀ hy₁ hy₂
    obtain ⟨hmatch, hsrc, htgt⟩ := hrel y hyD
    obtain ⟨hm₁, hm₂⟩ :=
      (generatingTarget_chainHead_eq_generatingSource_chainTail_iff hy₀ hy₁ hy₂).1 hmatch
    exact ⟨hm₁, hm₂, hsrc.trans (generatingSource_chainHead _),
      htgt.trans (generatingTarget_chainTail _)⟩
  /- Step 4: split the matching of the head and the tail near the base configuration. -/
  · have hφ : ContinuousAt (fun x : (M₁ × M₄) × (M₂ × M₃) ↦ (x.1.1, x.2.1))
        ((q₀, Q₀), (a₀, c₀)) := by fun_prop
    have hψ : ContinuousAt (fun x : (M₁ × M₄) × (M₂ × M₃) ↦ (x.2.2, x.1.2))
        ((q₀, Q₀), (a₀, c₀)) := by fun_prop
    filter_upwards [huniq, hφ.eventually hd₀, continuousAt_snd.eventually hd₁,
      hψ.eventually hd₂] with x hx hx₀ hx₁ hx₂
    exact (generatingTarget_chainHead_eq_generatingSource_chainTail_iff hx₀ hx₁ hx₂).symm.trans hx

end Elimination

/-! ### The generated map of the eliminated chain -/

section GeneratedMap

variable [IsManifold I₁ ∞ M₁] [IsManifold I₂ ∞ M₂] [IsManifold I₃ ∞ M₃] [IsManifold I₄ ∞ M₄]
  [FiniteDimensional ℝ E₁] [FiniteDimensional ℝ E₂] [FiniteDimensional ℝ E₃]
  [FiniteDimensional ℝ E₄] [BoundarylessManifold I₁ M₁] [BoundarylessManifold I₂ M₂]
  [BoundarylessManifold I₃ M₃] [BoundarylessManifold I₄ M₄]

/-- **The eliminated chain generates the composite of three canonical transformations.** Let `S₀`
on `M₁ × M₂`, `S₁` on `M₂ × M₃`, `S₂` on `M₃ × M₄` and `R` on `M₁ × M₄` be smooth, with invertible
mixed Hessians at `(q, a)`, `(a, c)`, `(c, Q)` and `(q, Q)`, and let `b` be a branch through
`(a, c)`, continuous at `(q, Q)`, along which, near `(q, Q)`, the chain is matched at both internal
vertices and `R` has the source covector of `S₀` and the target covector of `S₂`. Then near the
source point `(q, d_q R(q, Q))` the map generated by `R` is `φ₂ ∘ φ₁ ∘ φ₀`, where `φᵢ` is the map
generated by `Sᵢ`.

These are the relations of the eliminated generating function of
`TauCeti.CotangentBundle.exists_generatingComposition_three`. Generated maps are defined for
globally smooth generating functions, so here `R` is any smooth function on `M₁ × M₄` with these
relations near `(q, Q)`. -/
theorem generatedMap_eventuallyEq_comp_three {R : M₁ × M₄ → ℝ} {b : M₁ × M₄ → M₂ × M₃}
    {q : M₁} {a : M₂} {c : M₃} {Q : M₄} (hS₀ : ContMDiff (I₁.prod I₂) 𝓘(ℝ) ∞ S₀)
    (hM₀ : (mixedHessian I₁ I₂ S₀ (q, a)).IsInvertible)
    (hS₁ : ContMDiff (I₂.prod I₃) 𝓘(ℝ) ∞ S₁)
    (hM₁ : (mixedHessian I₂ I₃ S₁ (a, c)).IsInvertible)
    (hS₂ : ContMDiff (I₃.prod I₄) 𝓘(ℝ) ∞ S₂)
    (hM₂ : (mixedHessian I₃ I₄ S₂ (c, Q)).IsInvertible)
    (hR : ContMDiff (I₁.prod I₄) 𝓘(ℝ) ∞ R) (hMR : (mixedHessian I₁ I₄ R (q, Q)).IsInvertible)
    (hb : ContinuousAt b (q, Q)) (hb₀ : b (q, Q) = (a, c))
    (hrel : ∀ᶠ y in 𝓝 (q, Q),
      generatingTarget I₂ S₀ (y.1, (b y).1) = generatingSource I₂ S₁ (b y) ∧
      generatingTarget I₃ S₁ (b y) = generatingSource I₃ S₂ ((b y).2, y.2) ∧
      generatingSource I₁ R y = generatingSource I₁ S₀ (y.1, (b y).1) ∧
      generatingTarget I₄ R y = generatingTarget I₄ S₂ ((b y).2, y.2)) :
    generatedMap hR hMR =ᶠ[𝓝 (generatingSource I₁ R (q, Q))]
      generatedMap hS₂ hM₂ ∘ generatedMap hS₁ hM₁ ∘ generatedMap hS₀ hM₀ := by
  have hto₀ : Tendsto (fun y : M₁ × M₄ ↦ (y.1, (b y).1)) (𝓝 (q, Q)) (𝓝 (q, a)) := by
    simpa only [hb₀] using (continuousAt_fst.prodMk hb.fst).tendsto
  have hto₁ : Tendsto b (𝓝 (q, Q)) (𝓝 (a, c)) := by
    simpa only [hb₀] using hb.tendsto
  have hto₂ : Tendsto (fun y : M₁ × M₄ ↦ ((b y).2, y.2)) (𝓝 (q, Q)) (𝓝 (c, Q)) := by
    simpa only [hb₀] using (hb.snd.prodMk continuousAt_snd).tendsto
  -- On the source projection of `R`, both maps send `src R y` to `tgt R y`.
  have hsrc : ∀ᶠ y in 𝓝 (q, Q),
      generatedMap hR hMR (generatingSource I₁ R y) =
        (generatedMap hS₂ hM₂ ∘ generatedMap hS₁ hM₁ ∘ generatedMap hS₀ hM₀)
          (generatingSource I₁ R y) := by
    filter_upwards [hrel, eventually_generatedMap_generatingSource hR hMR,
      hto₀.eventually (eventually_generatedMap_generatingSource hS₀ hM₀),
      hto₁.eventually (eventually_generatedMap_generatingSource hS₁ hM₁),
      hto₂.eventually (eventually_generatedMap_generatingSource hS₂ hM₂)]
      with y ⟨hm₁, hm₂, hsrcR, htgtR⟩ hRy hy₀ hy₁ hy₂
    rw [hRy, comp_apply, comp_apply, hsrcR, hy₀, hm₁, hy₁, hm₂, hy₂, htgtR]
  -- Every point near the source point is the source projection of a point near `(q, Q)`, its
  -- image under the branch of `R`.
  have hβ : Tendsto (generatingBranch hR hMR) (𝓝 (generatingSource I₁ R (q, Q))) (𝓝 (q, Q)) := by
    have hc := ((generatingBranch hR hMR).mdifferentiableAt (by simp)
      (mem_generatingBranch_source hR hMR)).continuousAt
    simpa only [generatingBranch_generatingSource] using hc.tendsto
  filter_upwards [hβ.eventually hsrc, eventually_generatingSource_generatingBranch hR hMR
    (mem_generatingBranch_source hR hMR)] with z hz hz'
  rwa [hz'] at hz

end GeneratedMap

end TauCeti.CotangentBundle
