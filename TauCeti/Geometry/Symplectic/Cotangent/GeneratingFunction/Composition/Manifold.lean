section Charts

variable [I₁.Boundaryless] [I₂.Boundaryless] [I₃.Boundaryless]
  [IsManifold I₁ 1 M₁] [IsManifold I₂ 1 M₂] [IsManifold I₃ 1 M₃]

omit [I₁.Boundaryless] [I₂.Boundaryless] [I₃.Boundaryless] [IsManifold I₁ 1 M₁]
  [IsManifold I₃ 1 M₃] in
/-- The matching equation of `TauCeti.CotangentBundle.generatingTarget_eq_generatingSource_iff`
read in extended charts at arbitrary base points: where the coordinate expressions of `S` and `T`
are differentiable, it holds on the manifolds exactly when it holds for these expressions. -/
private theorem generatingTarget_eq_generatingSource_iff_extChartAt
    (x₁ : M₁) (x₂ : M₂) (x₃ : M₃) {q : M₁} {a : M₂} {Q : M₃}
    (hq : q ∈ (extChartAt I₁ x₁).source) (ha : a ∈ (extChartAt I₂ x₂).source)
    (hQ : Q ∈ (extChartAt I₃ x₃).source)
    (hS : DifferentiableAt ℝ
      (fun z : E₁ × E₂ ↦ S ((extChartAt I₁ x₁).symm z.1, (extChartAt I₂ x₂).symm z.2))
      (extChartAt I₁ x₁ q, extChartAt I₂ x₂ a))
    (hT : DifferentiableAt ℝ
      (fun z : E₂ × E₃ ↦ T ((extChartAt I₂ x₂).symm z.1, (extChartAt I₃ x₃).symm z.2))
      (extChartAt I₂ x₂ a, extChartAt I₃ x₃ Q)) :
    generatingTarget I₂ S (q, a) = generatingSource I₂ T (a, Q) ↔
      cotangentGeneratingTarget
          (fun z : E₁ × E₂ ↦ S ((extChartAt I₁ x₁).symm z.1, (extChartAt I₂ x₂).symm z.2))
          (extChartAt I₁ x₁ q, extChartAt I₂ x₂ a) =
        cotangentGeneratingSource
          (fun z : E₂ × E₃ ↦ T ((extChartAt I₂ x₂).symm z.1, (extChartAt I₃ x₃).symm z.2))
          (extChartAt I₂ x₂ a, extChartAt I₃ x₃ Q) := by
  set e₁ := extChartAt I₁ x₁
  set e₂ := extChartAt I₂ x₂
  set e₃ := extChartAt I₃ x₃
  set S' : E₁ × E₂ → ℝ := fun z ↦ S (e₁.symm z.1, e₂.symm z.2)
  set T' : E₂ × E₃ → ℝ := fun z ↦ T (e₂.symm z.1, e₃.symm z.2)
  -- The two slices through `a`, read in the chart at `x₂`, are slices of `S'` and `T'`.
  have hSa : DifferentiableAt ℝ ((fun a' ↦ S (q, a')) ∘ e₂.symm) (e₂ a) := by
    have hfun : (fun a' ↦ S (q, a')) ∘ e₂.symm = fun w ↦ S' (e₁ q, w) := by
      funext w
      simp only [comp_apply, S', e₁.left_inv hq]
    rw [hfun]
    exact DifferentiableAt.comp (g := S') (e₂ a) hS
      ((differentiableAt_const _).prodMk differentiableAt_id)
  have hTa : DifferentiableAt ℝ ((fun a' ↦ T (a', Q)) ∘ e₂.symm) (e₂ a) := by
    have hfun : (fun a' ↦ T (a', Q)) ∘ e₂.symm = fun w ↦ T' (w, e₃ Q) := by
      funext w
      simp only [comp_apply, T', e₃.left_inv hQ]
    rw [hfun]
    exact DifferentiableAt.comp (g := T') (e₂ a) hT
      (differentiableAt_id.prodMk (differentiableAt_const _))
  -- A function on `M₂` is differentiable at `a` when its expression in the chart at `x₂` is.
  have hmd {f : M₂ → ℝ} (hf : DifferentiableAt ℝ (f ∘ e₂.symm) (e₂ a)) :
      MDifferentiableAt I₂ 𝓘(ℝ) f a :=
    (mdifferentiableAt_iff_source_of_mem_source (by simpa [e₂] using ha)).2
      hf.mdifferentiableAt.mdifferentiableWithinAt
  have hsum : DifferentiableAt ℝ ((fun a' ↦ S (q, a') + T (a', Q)) ∘ e₂.symm) (e₂ a) :=
    hSa.add hTa
  have hcoord : (fun a' ↦ S (q, a') + T (a', Q)) ∘ e₂.symm =
      fun w ↦ S' (e₁ q, w) + T' (w, e₃ Q) := by
    funext w
    simp only [comp_apply, S', T', e₁.left_inv hq, e₃.left_inv hQ]
  rw [generatingTarget_eq_generatingSource_iff (hmd hSa) (hmd hTa),
    cotangentGeneratingTarget_eq_cotangentGeneratingSource_iff hS hT, mvfderiv_eq_zero_iff,
    mfderiv_eq_zero_iff_fderiv_comp_extChartAt_symm_eq_zero ha hsum, hcoord]

omit [TopologicalSpace M₂] [TopologicalSpace M₃] [I₁.Boundaryless] [I₂.Boundaryless]
  [I₃.Boundaryless] [IsManifold I₂ 1 M₂] [IsManifold I₃ 1 M₃] in
/-- The source covectors of `f` at `(q, c)` and of `g` at `(q, d)` agree when, near the image of
`q` in the extended chart at `x₁`, the slices of `f` and `g` through `q` read as slices of
coordinate expressions `f'` and `g'` that have the same source covector. -/
private theorem generatingSource_eq_of_extChartAt (x₁ : M₁) {f : M₁ × M₃ → ℝ}
    {g : M₁ × M₂ → ℝ} {f' : E₁ × E₃ → ℝ} {g' : E₁ × E₂ → ℝ} {q : M₁} {c : M₃} {d : M₂}
    {c' : E₃} {d' : E₂} (hq : q ∈ (extChartAt I₁ x₁).source)
    (hf : (fun q' ↦ f (q', c)) ∘ (extChartAt I₁ x₁).symm =ᶠ[𝓝 (extChartAt I₁ x₁ q)]
      fun v ↦ f' (v, c'))
    (hg : (fun q' ↦ g (q', d)) ∘ (extChartAt I₁ x₁).symm =ᶠ[𝓝 (extChartAt I₁ x₁ q)]
      fun v ↦ g' (v, d'))
    (hf' : DifferentiableAt ℝ f' (extChartAt I₁ x₁ q, c'))
    (hg' : DifferentiableAt ℝ g' (extChartAt I₁ x₁ q, d'))
    (h : cotangentGeneratingSource f' (extChartAt I₁ x₁ q, c') =
      cotangentGeneratingSource g' (extChartAt I₁ x₁ q, d')) :
    generatingSource I₁ f (q, c) = generatingSource I₁ g (q, d) := by
  have hmv : mvfderiv I₁ (fun q' ↦ f (q', c)) q = mvfderiv I₁ (fun q' ↦ g (q', d)) q := by
    refine (mvfderiv_eq_iff_fderiv_comp_extChartAt_symm_eq hq hf hg
      (hf'.comp (extChartAt I₁ x₁ q) (differentiableAt_id.prodMk (differentiableAt_const _)))
      (hg'.comp (extChartAt I₁ x₁ q) (differentiableAt_id.prodMk (differentiableAt_const _)))).2 ?_
    rw [fderiv_slice_left hf', fderiv_slice_left hg']
    ext w
    simpa only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.inl_apply,
      cotangentGeneratingSource_snd_apply] using congr($h.2 w)
  exact CotangentBundle.ext (by simp) fun v ↦ by
    rw [generatingSource_snd, generatingSource_snd]
    exact congr($hmv v)

omit [TopologicalSpace M₁] [TopologicalSpace M₂] [I₁.Boundaryless] [I₂.Boundaryless]
  [I₃.Boundaryless] [IsManifold I₁ 1 M₁] [IsManifold I₂ 1 M₂] in
/-- The target covectors of `f` at `(c, Q)` and of `g` at `(d, Q)` agree when, near the image of
`Q` in the extended chart at `x₃`, the slices of `f` and `g` through `Q` read as slices of
coordinate expressions `f'` and `g'` that have the same target covector. -/
private theorem generatingTarget_eq_of_extChartAt (x₃ : M₃) {f : M₁ × M₃ → ℝ}
    {g : M₂ × M₃ → ℝ} {f' : E₁ × E₃ → ℝ} {g' : E₂ × E₃ → ℝ} {Q : M₃} {c : M₁} {d : M₂}
    {c' : E₁} {d' : E₂} (hQ : Q ∈ (extChartAt I₃ x₃).source)
    (hf : (fun Q' ↦ f (c, Q')) ∘ (extChartAt I₃ x₃).symm =ᶠ[𝓝 (extChartAt I₃ x₃ Q)]
      fun u ↦ f' (c', u))
    (hg : (fun Q' ↦ g (d, Q')) ∘ (extChartAt I₃ x₃).symm =ᶠ[𝓝 (extChartAt I₃ x₃ Q)]
      fun u ↦ g' (d', u))
    (hf' : DifferentiableAt ℝ f' (c', extChartAt I₃ x₃ Q))
    (hg' : DifferentiableAt ℝ g' (d', extChartAt I₃ x₃ Q))
    (h : cotangentGeneratingTarget f' (c', extChartAt I₃ x₃ Q) =
      cotangentGeneratingTarget g' (d', extChartAt I₃ x₃ Q)) :
    generatingTarget I₃ f (c, Q) = generatingTarget I₃ g (d, Q) := by
  have hmv : mvfderiv I₃ (fun Q' ↦ f (c, Q')) Q = mvfderiv I₃ (fun Q' ↦ g (d, Q')) Q := by
    refine (mvfderiv_eq_iff_fderiv_comp_extChartAt_symm_eq hQ hf hg
      (hf'.comp (extChartAt I₃ x₃ Q) ((differentiableAt_const _).prodMk differentiableAt_id))
      (hg'.comp (extChartAt I₃ x₃ Q) ((differentiableAt_const _).prodMk differentiableAt_id))).2 ?_
    rw [fderiv_slice_right hf', fderiv_slice_right hg']
    ext w
    simpa only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.inr_apply,
      cotangentGeneratingTarget_snd_apply, neg_inj] using congr($h.2 w)
  exact CotangentBundle.ext (by simp) fun v ↦ by
    rw [generatingTarget_snd, generatingTarget_snd]
    exact congr((-$hmv) v)

omit [TopologicalSpace M₂] [TopologicalSpace M₃] [I₁.Boundaryless] [I₂.Boundaryless]
  [I₃.Boundaryless] [IsManifold I₂ 1 M₂] [IsManifold I₃ 1 M₃] in
/-- Conversely to `generatingSource_eq_of_extChartAt`, equal source covectors of `f` at `(q, c)`
and of `g` at `(q, d)` give equal source covectors of coordinate expressions `f'` and `g'` whose
slices through the image of `q` in the extended chart at `x₁` read the slices of `f` and `g`. -/
private theorem cotangentGeneratingSource_eq_of_extChartAt (x₁ : M₁) {f : M₁ × M₃ → ℝ}
    {g : M₁ × M₂ → ℝ} {f' : E₁ × E₃ → ℝ} {g' : E₁ × E₂ → ℝ} {q : M₁} {c : M₃} {d : M₂}
    {c' : E₃} {d' : E₂} (hq : q ∈ (extChartAt I₁ x₁).source)
    (hf : (fun q' ↦ f (q', c)) ∘ (extChartAt I₁ x₁).symm =ᶠ[𝓝 (extChartAt I₁ x₁ q)]
      fun v ↦ f' (v, c'))
    (hg : (fun q' ↦ g (q', d)) ∘ (extChartAt I₁ x₁).symm =ᶠ[𝓝 (extChartAt I₁ x₁ q)]
      fun v ↦ g' (v, d'))
    (hf' : DifferentiableAt ℝ f' (extChartAt I₁ x₁ q, c'))
    (hg' : DifferentiableAt ℝ g' (extChartAt I₁ x₁ q, d'))
    (h : generatingSource I₁ f (q, c) = generatingSource I₁ g (q, d)) :
    cotangentGeneratingSource f' (extChartAt I₁ x₁ q, c') =
      cotangentGeneratingSource g' (extChartAt I₁ x₁ q, d') := by
  -- Both source points lie over `q`, so their covectors, the differentials of the slices, agree.
  have hmv : mvfderiv I₁ (fun q' ↦ f (q', c)) q = mvfderiv I₁ (fun q' ↦ g (q', d)) q := by
    have h₂ : (generatingSource I₁ f (q, c)).snd = (generatingSource I₁ g (q, d)).snd
        := congr(($h).snd)
    rwa [generatingSource_snd, generatingSource_snd] at h₂
  have hfd := (mvfderiv_eq_iff_fderiv_comp_extChartAt_symm_eq hq hf hg
    (hf'.comp (extChartAt I₁ x₁ q) (differentiableAt_id.prodMk (differentiableAt_const _)))
    (hg'.comp (extChartAt I₁ x₁ q) (differentiableAt_id.prodMk (differentiableAt_const _)))).1 hmv
  rw [fderiv_slice_left hf', fderiv_slice_left hg'] at hfd
  refine Prod.ext (by simp) (ContinuousLinearMap.ext fun w ↦ ?_)
  simpa only [cotangentGeneratingSource_snd_apply, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.inl_apply] using congr($hfd w)

omit [I₁.Boundaryless] [I₂.Boundaryless] [I₃.Boundaryless] [IsManifold I₁ 1 M₁]
  [IsManifold I₂ 1 M₂] [IsManifold I₃ 1 M₃] in
/-- A nondegenerate critical point `a` of `a' ↦ S(q, a') + T(a', Q)`, read in the preferred charts
at `q`, `a` and `Q`: the image of `a` is a nondegenerate critical point of the corresponding sum of
slices of the coordinate expressions of `S` and `T`. -/
private theorem isNondegenerateCriticalPoint_extChartAt {q : M₁} {a : M₂} {Q : M₃}
    (h : IsManifoldNondegenerateCriticalPoint I₂ (fun a' ↦ S (q, a') + T (a', Q)) a) :
    IsNondegenerateCriticalPoint
      (fun w ↦ S ((extChartAt I₁ q).symm (extChartAt I₁ q q), (extChartAt I₂ a).symm w) +
        T ((extChartAt I₂ a).symm w, (extChartAt I₃ Q).symm (extChartAt I₃ Q Q)))
      (extChartAt I₂ a a) := by
  simpa only [Function.comp_def, extChartAt_to_inv] using
    (isManifoldNondegenerateCriticalPoint_iff I₂).mp h

omit [IsManifold I₁ 1 M₁] [IsManifold I₂ 1 M₂] [IsManifold I₃ 1 M₃] in
/-- At a nondegenerate critical point `a` of `a' ↦ S(q, a') + T(a', Q)`, the negative intermediate
Hessian of the coordinate expressions of `S` and `T` in the preferred charts at `q`, `a` and `Q`
is invertible. -/
private theorem isInvertible_cotangentLegendreHessian_extChartAt {q : M₁} {a : M₂} {Q : M₃}
    (hS : ContMDiffAt (I₁.prod I₂) 𝓘(ℝ) 2 S (q, a))
    (hT : ContMDiffAt (I₂.prod I₃) 𝓘(ℝ) 2 T (a, Q))
    (h : IsManifoldNondegenerateCriticalPoint I₂ (fun a' ↦ S (q, a') + T (a', Q)) a) :
    (cotangentLegendreHessian (cotangentGeneratingSum
        (fun z : E₁ × E₂ ↦ S ((extChartAt I₁ q).symm z.1, (extChartAt I₂ a).symm z.2))
        (fun z : E₂ × E₃ ↦ T ((extChartAt I₂ a).symm z.1, (extChartAt I₃ Q).symm z.2)))
      ((extChartAt I₁ q q, extChartAt I₃ Q Q), extChartAt I₂ a a)).IsInvertible := by
  set e₁ := extChartAt I₁ q
  set e₂ := extChartAt I₂ a
  set e₃ := extChartAt I₃ Q
  set S' : E₁ × E₂ → ℝ := fun z ↦ S (e₁.symm z.1, e₂.symm z.2)
  set T' : E₂ × E₃ → ℝ := fun z ↦ T (e₂.symm z.1, e₃.symm z.2)
  have hsum : ContDiffAt ℝ 2 (cotangentGeneratingSum S' T') ((e₁ q, e₃ Q), e₂ a) :=
    contDiffAt_cotangentGeneratingSum hS.contDiffAt_comp_prod_extChartAt_symm
      hT.contDiffAt_comp_prod_extChartAt_symm
  have hcrit : IsNondegenerateCriticalPoint (fun w ↦ S' (e₁ q, w) + T' (w, e₃ Q)) (e₂ a) :=
    isNondegenerateCriticalPoint_extChartAt h
  -- The negative intermediate Hessian is minus the Hessian of the slice through `(q, Q)`.
  have hslice : (fun w ↦ cotangentGeneratingSum S' T' ((e₁ q, e₃ Q), w)) =
      fun w ↦ S' (e₁ q, w) + T' (w, e₃ Q) :=
    funext fun w ↦ cotangentGeneratingSum_apply S' T' (e₁ q) (e₃ Q) w
  have heq : cotangentLegendreHessian (cotangentGeneratingSum S' T') ((e₁ q, e₃ Q), e₂ a) =
      (ContinuousLinearEquiv.neg ℝ : (E₂ →L[ℝ] ℝ) ≃L[ℝ] (E₂ →L[ℝ] ℝ)) ∘L
        fderiv ℝ (fderiv ℝ (fun w ↦ S' (e₁ q, w) + T' (w, e₃ Q))) (e₂ a) := by
    ext v w
    rw [cotangentLegendreHessian_apply_apply, ← fderiv_fderiv_slice_right_apply hsum v w, hslice]
    simp
  rw [heq, ContinuousLinearMap.isInvertible_equiv_comp]
  exact hcrit.isInvertible

/-- **Composition of generating functions on manifolds by stationary elimination.**

Let `S` on `M₁ × M₂` and `T` on `M₂ × M₃` be `C^(n+2)` at `(q₀, a₀)` and `(a₀, Q₀)`, and let
`a₀` be a nondegenerate critical point of `a ↦ S(q₀, a) + T(a, Q₀)`, so that the relations they
generate match at `(q₀, a₀, Q₀)`. Then there are a stationary branch `b : M₁ × M₃ → M₂` through
`a₀`, `C^(n+1)` at `(q₀, Q₀)`, and the generating function `R(q, Q) = S(q, b) + T(b, Q)` of the
composite relation, `C^(n+2)` at `(q₀, Q₀)`: on an open neighbourhood `D` of `(q₀, Q₀)` the
intermediate cotangent points match along `b`, and `R` has source covector `d_q S(q, b)` and
target covector `-d_Q T(b, Q)`.
Near `((q₀, Q₀), a₀)`, the matching equation holds exactly on the graph of `b`.

All assertions except the value at `(q₀, Q₀)` are local; no global composite relation and no
uniqueness of critical points outside this neighbourhood is asserted. -/
theorem exists_generatingComposition [CompleteSpace E₁] [CompleteSpace E₂] [CompleteSpace E₃]
    {n : WithTop ℕ∞} {q₀ : M₁} {a₀ : M₂} {Q₀ : M₃}
    (hS : ContMDiffAt (I₁.prod I₂) 𝓘(ℝ) (n + 2) S (q₀, a₀))
    (hT : ContMDiffAt (I₂.prod I₃) 𝓘(ℝ) (n + 2) T (a₀, Q₀))
    (h : IsManifoldNondegenerateCriticalPoint I₂ (fun a ↦ S (q₀, a) + T (a, Q₀)) a₀) :
    ∃ (b : M₁ × M₃ → M₂) (R : M₁ × M₃ → ℝ) (D : Set (M₁ × M₃)),
      IsOpen D ∧ (q₀, Q₀) ∈ D ∧ b (q₀, Q₀) = a₀ ∧
      (∀ y, R y = S (y.1, b y) + T (b y, y.2)) ∧
      ContMDiffAt (I₁.prod I₃) I₂ (n + 1) b (q₀, Q₀) ∧
      ContMDiffAt (I₁.prod I₃) 𝓘(ℝ) (n + 2) R (q₀, Q₀) ∧
      (∀ y ∈ D,
        generatingTarget I₂ S (y.1, b y) = generatingSource I₂ T (b y, y.2) ∧
        generatingSource I₁ R y = generatingSource I₁ S (y.1, b y) ∧
        generatingTarget I₃ R y = generatingTarget I₃ T (b y, y.2)) ∧
      (∀ᶠ x in 𝓝 ((q₀, Q₀), a₀),
        generatingTarget I₂ S (x.1.1, x.2) = generatingSource I₂ T (x.2, x.1.2) ↔
          b x.1 = x.2) := by
  set e₁ := extChartAt I₁ q₀
  set e₂ := extChartAt I₂ a₀
  set e₃ := extChartAt I₃ Q₀
  let S' : E₁ × E₂ → ℝ := fun z ↦ S (e₁.symm z.1, e₂.symm z.2)
  let T' : E₂ × E₃ → ℝ := fun z ↦ T (e₂.symm z.1, e₃.symm z.2)
  -- `S'` and `T'` are `S` and `T` read in the product charts at the base points.
  have hS' : ContDiffAt ℝ (n + 2) S' (e₁ q₀, e₂ a₀) := hS.contDiffAt_comp_prod_extChartAt_symm
  have hT' : ContDiffAt ℝ (n + 2) T' (e₂ a₀, e₃ Q₀) := hT.contDiffAt_comp_prod_extChartAt_symm
  have h1 : (1 : WithTop ℕ∞) ≤ n + 2 := le_add_left one_le_two
  have h2 : (2 : WithTop ℕ∞) ≤ n + 2 := le_add_self
  /- Step 1: the hypotheses of the normed-space composition theorem, read in the charts. -/
  have hcrit : IsNondegenerateCriticalPoint (fun w ↦ S' (e₁ q₀, w) + T' (w, e₃ Q₀)) (e₂ a₀) :=
    isNondegenerateCriticalPoint_extChartAt h
  have hmatch : cotangentGeneratingTarget S' (e₁ q₀, e₂ a₀) =
      cotangentGeneratingSource T' (e₂ a₀, e₃ Q₀) :=
    (cotangentGeneratingTarget_eq_cotangentGeneratingSource_iff
      (hS'.differentiableAt (by simp)) (hT'.differentiableAt (by simp))).2
      hcrit.fderiv_eq_zero
  have hH : (cotangentLegendreHessian (cotangentGeneratingSum S' T')
      ((e₁ q₀, e₃ Q₀), e₂ a₀)).IsInvertible :=
    isInvertible_cotangentLegendreHessian_extChartAt (hS.of_le h2) (hT.of_le h2) h
  /- Step 2: eliminate the intermediate position in the charts. -/
  obtain ⟨b', R', D', hD'o, hD'mem, hb'₀, hR'def, hb', hR', hrel, huniq⟩ :=
    exists_cotangentGeneratingComposition hS' hT' hmatch hH
  let b : M₁ × M₃ → M₂ := fun y ↦ e₂.symm (b' (e₁ y.1, e₃ y.2))
  let R : M₁ × M₃ → ℝ := fun y ↦ S (y.1, b y) + T (b y, y.2)
  have hb₀ : b (q₀, Q₀) = a₀ := by
    simp only [b, hb'₀, e₂, extChartAt_to_inv]
  have htarget : ∀ᶠ y' in 𝓝 (e₁ q₀, e₃ Q₀), b' y' ∈ e₂.target :=
    hb'.continuousAt.preimage_mem_nhds (hb'₀ ▸ extChartAt_target_mem_nhds a₀)
  -- `b` is `b'` read back through the product chart at `(q₀, Q₀)` and the chart at `a₀`.
  have hb : ContMDiffAt (I₁.prod I₃) I₂ (n + 1) b (q₀, Q₀) := by
    simpa only [extChartAt_prod, PartialEquiv.prod_coe] using
      ContDiffAt.contMDiffAt_extChartAt_symm_comp_extChartAt (I := I₁.prod I₃) (x := (q₀, Q₀))
        (by simpa only [extChartAt_prod, PartialEquiv.prod_coe] using hb')
        (by simpa only [extChartAt_prod, PartialEquiv.prod_coe] using hb'₀)
  -- Read in the product chart at `(q₀, Q₀)`, `R` is `R'` near the chart image.
  have hR : ContMDiffAt (I₁.prod I₃) 𝓘(ℝ) (n + 2) R (q₀, Q₀) := by
    have heq : (fun z : E₁ × E₃ ↦ R (e₁.symm z.1, e₃.symm z.2)) =ᶠ[𝓝 (e₁ q₀, e₃ Q₀)] R' := by
      filter_upwards [prod_mem_nhds (extChartAt_target_mem_nhds q₀)
        (extChartAt_target_mem_nhds Q₀)] with z hz
      simp only [R, b, hR'def, S', T', e₁.right_inv hz.1, e₃.right_inv hz.2]
    rw [contMDiffAt_iff_contDiffAt_comp_extChartAt_symm]
    simpa only [extChartAt_prod, PartialEquiv.prod_coe_symm, PartialEquiv.prod_coe,
      Function.comp_def] using hR'.congr_of_eventuallyEq heq
  /- Step 3: shrink the coordinate domain so that the branch stays in the chart at `a₀` and the
  coordinate expressions stay differentiable. -/
  have hev : ∀ᶠ y' in 𝓝 (e₁ q₀, e₃ Q₀), y' ∈ D' ∧ b' y' ∈ e₂.target ∧
      DifferentiableAt ℝ R' y' ∧ DifferentiableAt ℝ S' (y'.1, b' y') ∧
        DifferentiableAt ℝ T' (b' y', y'.2) := by
    have hSd := hS'.eventually_differentiableAt h1
    have hTd := hT'.eventually_differentiableAt h1
    rw [← hb'₀] at hSd hTd
    filter_upwards [hD'o.mem_nhds hD'mem, htarget,
      ContDiffAt.eventually_differentiableAt hR' (one_le_two.trans le_add_self),
      (continuousAt_fst.prodMk hb'.continuousAt).eventually hSd,
      (hb'.continuousAt.prodMk continuousAt_snd).eventually hTd] with y' h₁ h₂ h₃ h₄ h₅
    exact ⟨h₁, h₂, h₃, h₄, h₅⟩
  obtain ⟨U, hUsub, hUo, hUmem⟩ := mem_nhds_iff.mp hev
  let D : Set (M₁ × M₃) := (e₁.source ×ˢ e₃.source) ∩ (fun y ↦ (e₁ y.1, e₃ y.2)) ⁻¹' U
  have hDo : IsOpen D :=
    ((continuousOn_extChartAt q₀).prodMap (continuousOn_extChartAt Q₀)).isOpen_inter_preimage
      ((isOpen_extChartAt_source q₀).prod (isOpen_extChartAt_source Q₀)) hUo
  have hDmem : (q₀, Q₀) ∈ D :=
    ⟨⟨mem_extChartAt_source q₀, mem_extChartAt_source Q₀⟩, hUmem⟩
  refine ⟨b, R, D, hDo, hDmem, hb₀, fun _ ↦ rfl, hb, hR, ?_, ?_⟩
  /- Step 4: transport the three relations from the charts. -/
  · rintro ⟨q, Q⟩ ⟨⟨hq, hQ⟩, hU⟩
    set y' : E₁ × E₃ := (e₁ q, e₃ Q)
    have hy' : y' ∈ D' ∧ b' y' ∈ e₂.target ∧ DifferentiableAt ℝ R' y' ∧
        DifferentiableAt ℝ S' (y'.1, b' y') ∧ DifferentiableAt ℝ T' (b' y', y'.2) := hUsub hU
    obtain ⟨hy'D, hby', hRy', hS'y, hT'y⟩ := hy'
    obtain ⟨hr₁, hr₂, hr₃⟩ := hrel y' hy'D
    have hbs : b (q, Q) ∈ e₂.source := e₂.map_target hby'
    have hbe : e₂ (b (q, Q)) = b' y' := e₂.right_inv hby'
    have hq' : e₁ q ∈ e₁.target := e₁.map_source hq
    have hQ' : e₃ Q ∈ e₃.target := e₃.map_source hQ
    -- Near `y'`, the coordinate expressions of `R` and of its two slices are `R'` and its slices.
    have hReq : ∀ᶠ z in 𝓝 y', R (e₁.symm z.1, e₃.symm z.2) = R' z := by
      filter_upwards [hUo.mem_nhds hU, prod_mem_nhds (extChartAt_target_mem_nhds' hq')
        (extChartAt_target_mem_nhds' hQ')] with z _ hz
      simp only [R, b, hR'def, S', T', e₁.right_inv hz.1, e₃.right_inv hz.2]
    refine ⟨?_, ?_, ?_⟩
    · rw [generatingTarget_eq_generatingSource_iff_extChartAt q₀ a₀ Q₀ hq hbs hQ
        (by rwa [hbe]) (by rwa [hbe]), hbe]
      exact hr₁
    -- By definition of `b`, `S'` and `T'`, the slices of `S` and `T` through `b (q, Q)` read in
    -- the charts as the slices of `S'` and `T'` through `b' y'`.
    · have hslice : (fun q' ↦ R (q', Q)) ∘ e₁.symm =ᶠ[𝓝 (e₁ q)] fun v ↦ R' (v, e₃ Q) := by
        have hcont : ContinuousAt (fun v : E₁ ↦ (v, e₃ Q)) (e₁ q) := by fun_prop
        filter_upwards [hcont.eventually hReq] with v hv
        simpa only [comp_apply, e₃.left_inv hQ] using hv
      exact generatingSource_eq_of_extChartAt q₀ hq hslice (g' := S') (d' := b' y') .rfl hRy'
        hS'y hr₂
    · have hslice : (fun Q' ↦ R (q, Q')) ∘ e₃.symm =ᶠ[𝓝 (e₃ Q)] fun u ↦ R' (e₁ q, u) := by
        have hcont : ContinuousAt (fun u : E₃ ↦ (e₁ q, u)) (e₃ Q) := by fun_prop
        filter_upwards [hcont.eventually hReq] with u hu
        simpa only [comp_apply, e₁.left_inv hq] using hu
      exact generatingTarget_eq_of_extChartAt Q₀ hQ hslice (g' := T') (d' := b' y') .rfl hRy'
        hT'y hr₃
  /- Step 5: transport the local uniqueness of the stationary branch. -/
  · have hmap : ContinuousAt (fun x : (M₁ × M₃) × M₂ ↦ ((e₁ x.1.1, e₃ x.1.2), e₂ x.2))
        ((q₀, Q₀), a₀) :=
      (((continuousAt_extChartAt (I := I₁) q₀).comp
          (continuousAt_fst.comp continuousAt_fst)).prodMk
        ((continuousAt_extChartAt (I := I₃) Q₀).comp
          (continuousAt_snd.comp continuousAt_fst))).prodMk
        ((continuousAt_extChartAt (I := I₂) a₀).comp continuousAt_snd)
    have hsrc : ∀ᶠ x : (M₁ × M₃) × M₂ in 𝓝 ((q₀, Q₀), a₀),
        x ∈ (e₁.source ×ˢ e₃.source) ×ˢ e₂.source :=
      prod_mem_nhds (prod_mem_nhds (extChartAt_source_mem_nhds q₀)
        (extChartAt_source_mem_nhds Q₀)) (extChartAt_source_mem_nhds a₀)
    filter_upwards [hmap.eventually huniq, hsrc, hmap.fst.preimage_mem_nhds (hUo.mem_nhds hUmem),
      (hmap.fst.fst.prodMk hmap.snd).eventually (hS'.eventually_differentiableAt h1),
      (hmap.snd.prodMk hmap.fst.snd).eventually (hT'.eventually_differentiableAt h1)]
      with x hx hs hU hSx hTx
    rw [generatingTarget_eq_generatingSource_iff_extChartAt q₀ a₀ Q₀ hs.1.1 hs.2 hs.1.2 hSx hTx]
    exact hx.trans (e₂.symm_apply_eq hs.2 (hUsub hU).2.1).symm

end Charts

/-! ### The mixed Hessian of the composite -/

section MixedHessian

variable [I₁.Boundaryless] [I₂.Boundaryless] [I₃.Boundaryless]
  [IsManifold I₁ 2 M₁] [IsManifold I₂ 2 M₂] [IsManifold I₃ 2 M₃]

omit [IsManifold I₃ 2 M₃] in
/-- The relations along a branch `b`, read in the preferred charts at `q`, `b (q, Q)` and `Q`: near
the chart image of `(q, Q)`, the intermediate covectors of the coordinate expressions of `S` and `T`
match along the coordinate expression of `b`, and the coordinate expression of `R` has the source
covector of that of `S` there. -/
private theorem eventually_cotangentGenerating_extChartAt {R : M₁ × M₃ → ℝ} {b : M₁ × M₃ → M₂}
    {q : M₁} {Q : M₃} (hS : ContMDiffAt (I₁.prod I₂) 𝓘(ℝ) 2 S (q, b (q, Q)))
    (hT : ContMDiffAt (I₂.prod I₃) 𝓘(ℝ) 2 T (b (q, Q), Q))
    (hR : ContMDiffAt (I₁.prod I₃) 𝓘(ℝ) 2 R (q, Q))
    (hb : MDifferentiableAt (I₁.prod I₃) I₂ b (q, Q))
    (hrel : ∀ᶠ y in 𝓝 (q, Q),
      generatingTarget I₂ S (y.1, b y) = generatingSource I₂ T (b y, y.2) ∧
      generatingSource I₁ R y = generatingSource I₁ S (y.1, b y)) :
    let e₁ := extChartAt I₁ q
    let e₂ := extChartAt I₂ (b (q, Q))
    let e₃ := extChartAt I₃ Q
    let S' : E₁ × E₂ → ℝ := fun z ↦ S (e₁.symm z.1, e₂.symm z.2)
    let T' : E₂ × E₃ → ℝ := fun z ↦ T (e₂.symm z.1, e₃.symm z.2)
    let R' : E₁ × E₃ → ℝ := fun z ↦ R (e₁.symm z.1, e₃.symm z.2)
    let b' : E₁ × E₃ → E₂ := fun z ↦ e₂ (b (e₁.symm z.1, e₃.symm z.2))
    ∀ᶠ z in 𝓝 (e₁ q, e₃ Q),
      cotangentGeneratingTarget S' (z.1, b' z) = cotangentGeneratingSource T' (b' z, z.2) ∧
      cotangentGeneratingSource R' z = cotangentGeneratingSource S' (z.1, b' z) := by
  intro e₁ e₂ e₃ S' T' R' b'
  have hb' : DifferentiableAt ℝ b' (e₁ q, e₃ Q) := hb.differentiableAt_comp_prod_extChartAt_symm
  have hb'₀ : b' (e₁ q, e₃ Q) = e₂ (b (q, Q)) := by
    simp only [b', e₁, e₃, extChartAt_to_inv]
  have hφ : Tendsto (fun z : E₁ × E₃ ↦ (e₁.symm z.1, e₃.symm z.2)) (𝓝 (e₁ q, e₃ Q))
      (𝓝 (q, Q)) := by
    have hc : ContinuousAt (fun z : E₁ × E₃ ↦ (e₁.symm z.1, e₃.symm z.2)) (e₁ q, e₃ Q) :=
      ((continuousAt_extChartAt_symm q).comp_of_eq continuousAt_fst rfl).prodMk
        ((continuousAt_extChartAt_symm Q).comp_of_eq continuousAt_snd rfl)
    simpa only [e₁, e₃, extChartAt_to_inv] using hc.tendsto
  have hSd := hS.contDiffAt_comp_prod_extChartAt_symm.eventually_differentiableAt one_le_two
  have hTd := hT.contDiffAt_comp_prod_extChartAt_symm.eventually_differentiableAt one_le_two
  rw [← hb'₀] at hSd hTd
  filter_upwards [hφ.eventually hrel,
    hφ.eventually (hb.continuousAt.preimage_mem_nhds
      (extChartAt_source_mem_nhds (I := I₂) (b (q, Q)))),
    hR.contDiffAt_comp_prod_extChartAt_symm.eventually_differentiableAt one_le_two,
    (continuousAt_fst.prodMk hb'.continuousAt).eventually hSd,
    (hb'.continuousAt.prodMk continuousAt_snd).eventually hTd,
    prod_mem_nhds (extChartAt_target_mem_nhds q) (extChartAt_target_mem_nhds Q)]
    with z ⟨hmatch, hsrc⟩ hbs hRz hSz hTz hz
  have hq : e₁.symm z.1 ∈ e₁.source := e₁.map_target hz.1
  have hz₁ : e₁ (e₁.symm z.1) = z.1 := e₁.right_inv hz.1
  have hz₃ : e₃ (e₃.symm z.2) = z.2 := e₃.right_inv hz.2
  refine ⟨?_, ?_⟩
  · have key := (generatingTarget_eq_generatingSource_iff_extChartAt q (b (q, Q)) Q hq hbs
      (e₃.map_target hz.2) (by rwa [hz₁]) (by rwa [hz₃])).1 hmatch
    rwa [hz₁, hz₃] at key
  · -- The slice of `S'` through `b' z` reads the slice of `S` through `b` at the point.
    have hslice : (fun q' ↦ S (q', b (e₁.symm z.1, e₃.symm z.2))) ∘ e₁.symm =
        fun v ↦ S' (v, b' z) := by
      funext v
      simp only [comp_apply, S', b', e₂.left_inv hbs]
    have key := cotangentGeneratingSource_eq_of_extChartAt q hq (f' := R') (c' := z.2)
      (g' := S') (d' := b' z) (Eventually.of_forall fun _ ↦ rfl)
      (Eventually.of_forall (congrFun hslice))
      (by rwa [hz₁]) (by rwa [hz₁]) hsrc
    rwa [hz₁] at key

/-- **The composite of generating functions of the first kind is of the first kind.** Let `S` on
`M₁ × M₂` and `T` on `M₂ × M₃` have invertible mixed Hessians at `(q, a)` and `(a, Q)`, where `a`
is a nondegenerate critical point of `a' ↦ S(q, a') + T(a', Q)`. Let `b` be a branch through `a`,
differentiable at `(q, Q)`, along which the intermediate cotangent points match near `(q, Q)`, and
let `R` be `C²` at `(q, Q)` with the source covector of `S` along the branch there. Then the mixed
Hessian of `R` at `(q, Q)` is invertible.

In the preferred charts it is `M_S ∘ L⁻¹ ∘ M_T`, where `L` is the negative intermediate Hessian
(`TauCeti.cotangentMixedHessian_eq_comp_inverse_comp`). -/
theorem isInvertible_mixedHessian_of_comp {R : M₁ × M₃ → ℝ} {b : M₁ × M₃ → M₂} {q : M₁} {a : M₂}
    {Q : M₃} (hS : ContMDiffAt (I₁.prod I₂) 𝓘(ℝ) 2 S (q, a))
    (hT : ContMDiffAt (I₂.prod I₃) 𝓘(ℝ) 2 T (a, Q))
    (hR : ContMDiffAt (I₁.prod I₃) 𝓘(ℝ) 2 R (q, Q))
    (hb : MDifferentiableAt (I₁.prod I₃) I₂ b (q, Q)) (hb₀ : b (q, Q) = a)
    (h : IsManifoldNondegenerateCriticalPoint I₂ (fun a' ↦ S (q, a') + T (a', Q)) a)
    (hMS : (mixedHessian I₁ I₂ S (q, a)).IsInvertible)
    (hMT : (mixedHessian I₂ I₃ T (a, Q)).IsInvertible)
    (hrel : ∀ᶠ y in 𝓝 (q, Q),
      generatingTarget I₂ S (y.1, b y) = generatingSource I₂ T (b y, y.2) ∧
      generatingSource I₁ R y = generatingSource I₁ S (y.1, b y)) :
    (mixedHessian I₁ I₃ R (q, Q)).IsInvertible := by
  subst hb₀
  -- Read the mixed Hessians in the preferred charts. `Function.comp_def` and `Prod.map_apply'`
  -- rewrite the coordinate expression `S ∘ Prod.map (extChartAt I₁ q).symm (extChartAt I₂ a).symm`
  -- of `mixedHessian_eq_cotangentMixedHessian_extChartAt` into the form
  -- `fun z ↦ S ((extChartAt I₁ q).symm z.1, (extChartAt I₂ a).symm z.2)` of the chart lemmas.
  rw [mixedHessian_eq_cotangentMixedHessian_extChartAt hS] at hMS
  rw [mixedHessian_eq_cotangentMixedHessian_extChartAt hT] at hMT
  rw [mixedHessian_eq_cotangentMixedHessian_extChartAt hR]
  simp only [Function.comp_def, Prod.map_apply'] at hMS hMT ⊢
  -- Read `R` and `b` in the preferred charts too and apply the normed-space statement.
  have hMR' := isInvertible_cotangentMixedHessian_of_comp hS.contDiffAt_comp_prod_extChartAt_symm
    hT.contDiffAt_comp_prod_extChartAt_symm
    ((hR.contDiffAt_comp_prod_extChartAt_symm.fderiv_right (m := 1) le_rfl).differentiableAt
      one_ne_zero) hb.differentiableAt_comp_prod_extChartAt_symm
    (by simp only [extChartAt_to_inv])
    (isInvertible_cotangentLegendreHessian_extChartAt hS hT h) hMS hMT
    (eventually_cotangentGenerating_extChartAt hS hT hR hb hrel)
  -- The goal is stated on the tangent spaces `TangentSpace I₁ q` and `TangentSpace I₃ Q`, which
  -- are by definition the model spaces `E₁` and `E₃` of `hMR'`.
  exact hMR'

/-- **Composition of generating functions of the first kind on manifolds.** Let `S` on `M₁ × M₂`
and `T` on `M₂ × M₃` be `C²` with invertible mixed Hessians at `(q₀, a₀)` and `(a₀, Q₀)`, and let
`a₀` be a nondegenerate critical point of `a ↦ S(q₀, a) + T(a, Q₀)`. Then the composite
generating function `R(q, Q) = S(q, b) + T(b, Q)` of
`TauCeti.CotangentBundle.exists_generatingComposition`, along a `C¹` stationary branch `b` through
`a₀`, is `C²` at `(q₀, Q₀)` with invertible mixed Hessian there: it is again a generating function
of the first kind. Near `(q₀, Q₀)` the intermediate cotangent points match along `b`, and `R`
has the source covector of `S` and the target covector of `T` along the branch. -/
theorem exists_generatingComposition_isInvertible_mixedHessian [CompleteSpace E₁]
    [CompleteSpace E₂] [CompleteSpace E₃] {q₀ : M₁} {a₀ : M₂} {Q₀ : M₃}
    (hS : ContMDiffAt (I₁.prod I₂) 𝓘(ℝ) 2 S (q₀, a₀))
    (hMS : (mixedHessian I₁ I₂ S (q₀, a₀)).IsInvertible)
    (hT : ContMDiffAt (I₂.prod I₃) 𝓘(ℝ) 2 T (a₀, Q₀))
    (hMT : (mixedHessian I₂ I₃ T (a₀, Q₀)).IsInvertible)
    (h : IsManifoldNondegenerateCriticalPoint I₂ (fun a ↦ S (q₀, a) + T (a, Q₀)) a₀) :
    ∃ (b : M₁ × M₃ → M₂) (R : M₁ × M₃ → ℝ), b (q₀, Q₀) = a₀ ∧
      (∀ y, R y = S (y.1, b y) + T (b y, y.2)) ∧
      ContMDiffAt (I₁.prod I₃) I₂ 1 b (q₀, Q₀) ∧ ContMDiffAt (I₁.prod I₃) 𝓘(ℝ) 2 R (q₀, Q₀) ∧
      (∀ᶠ y in 𝓝 (q₀, Q₀),
        generatingTarget I₂ S (y.1, b y) = generatingSource I₂ T (b y, y.2) ∧
        generatingSource I₁ R y = generatingSource I₁ S (y.1, b y) ∧
        generatingTarget I₃ R y = generatingTarget I₃ T (b y, y.2)) ∧
      (mixedHessian I₁ I₃ R (q₀, Q₀)).IsInvertible := by
  obtain ⟨b, R, D, hD, hmem, hb₀, hRdef, hb, hR, hrelD, -⟩ :=
    exists_generatingComposition (n := 0) (by simpa using hS) (by simpa using hT) h
  have hb₁ : ContMDiffAt (I₁.prod I₃) I₂ 1 b (q₀, Q₀) := by simpa using hb
  have hR₂ : ContMDiffAt (I₁.prod I₃) 𝓘(ℝ) 2 R (q₀, Q₀) := by simpa using hR
  have hrel : ∀ᶠ y in 𝓝 (q₀, Q₀),
      generatingTarget I₂ S (y.1, b y) = generatingSource I₂ T (b y, y.2) ∧
      generatingSource I₁ R y = generatingSource I₁ S (y.1, b y) ∧
      generatingTarget I₃ R y = generatingTarget I₃ T (b y, y.2) :=
    Filter.mem_of_superset (hD.mem_nhds hmem) fun y hy ↦ hrelD y hy
  exact ⟨b, R, hb₀, hRdef, hb₁, hR₂, hrel, isInvertible_mixedHessian_of_comp hS hT hR₂
    (hb₁.mdifferentiableAt one_ne_zero) hb₀ h hMS hMT (hrel.mono fun _ h ↦ ⟨h.1, h.2.1⟩)⟩

end MixedHessian

/-! ### The generated map of the composite -/

section GeneratedMap

variable [IsManifold I₁ ∞ M₁] [IsManifold I₂ ∞ M₂] [IsManifold I₃ ∞ M₃]
  [FiniteDimensional ℝ E₁] [FiniteDimensional ℝ E₂] [FiniteDimensional ℝ E₃]
  [BoundarylessManifold I₁ M₁] [BoundarylessManifold I₂ M₂] [BoundarylessManifold I₃ M₃]

/-- **The composite generating function generates the composite canonical transformation.** Let
`S` on `M₁ × M₂`, `T` on `M₂ × M₃` and `R` on `M₁ × M₃` be smooth, with invertible mixed Hessians
at `(q, a)`, `(a, Q)` and `(q, Q)`, and let `b` be a branch through `a`, continuous at `(q, Q)`,
along which, near `(q, Q)`, the intermediate cotangent points of `S` and `T` match and `R` has the
source covector of `S` and the target covector of `T`. Then near the source point
`(q, d_q R(q, Q))` the map generated by `R` is the map generated by `T` after the map generated
by `S`.

These are the relations of the composite generating function of
`TauCeti.CotangentBundle.exists_generatingComposition_isInvertible_mixedHessian`. Generated maps
are defined for globally smooth generating functions, so here `R` is any smooth function on
`M₁ × M₃` with these relations near `(q, Q)`. -/
theorem generatedMap_eventuallyEq_comp {R : M₁ × M₃ → ℝ} {b : M₁ × M₃ → M₂} {q : M₁} {a : M₂}
    {Q : M₃} (hS : ContMDiff (I₁.prod I₂) 𝓘(ℝ) ∞ S)
    (hMS : (mixedHessian I₁ I₂ S (q, a)).IsInvertible) (hT : ContMDiff (I₂.prod I₃) 𝓘(ℝ) ∞ T)
    (hMT : (mixedHessian I₂ I₃ T (a, Q)).IsInvertible) (hR : ContMDiff (I₁.prod I₃) 𝓘(ℝ) ∞ R)
    (hMR : (mixedHessian I₁ I₃ R (q, Q)).IsInvertible)
    (hb : ContinuousAt b (q, Q)) (hb₀ : b (q, Q) = a)
    (hrel : ∀ᶠ y in 𝓝 (q, Q),
      generatingTarget I₂ S (y.1, b y) = generatingSource I₂ T (b y, y.2) ∧
      generatingSource I₁ R y = generatingSource I₁ S (y.1, b y) ∧
      generatingTarget I₃ R y = generatingTarget I₃ T (b y, y.2)) :
    generatedMap hR hMR =ᶠ[𝓝 (generatingSource I₁ R (q, Q))]
      generatedMap hT hMT ∘ generatedMap hS hMS := by
  have hto₁ : Tendsto (fun y : M₁ × M₃ ↦ (y.1, b y)) (𝓝 (q, Q)) (𝓝 (q, a)) := by
    simpa only [hb₀] using (continuousAt_fst.prodMk hb).tendsto
  have hto₂ : Tendsto (fun y : M₁ × M₃ ↦ (b y, y.2)) (𝓝 (q, Q)) (𝓝 (a, Q)) := by
    simpa only [hb₀] using (hb.prodMk continuousAt_snd).tendsto
  -- On the source projection of `R`, both maps send `src R y` to `tgt R y`.
  have hsrc : ∀ᶠ y in 𝓝 (q, Q),
      generatedMap hR hMR (generatingSource I₁ R y) =
        (generatedMap hT hMT ∘ generatedMap hS hMS) (generatingSource I₁ R y) := by
    filter_upwards [hrel, eventually_generatedMap_generatingSource hR hMR,
      hto₁.eventually (eventually_generatedMap_generatingSource hS hMS),
      hto₂.eventually (eventually_generatedMap_generatingSource hT hMT)]
      with y ⟨hmatch, hsrcR, htgtR⟩ hRy hSy hTy
    rw [hRy, Function.comp_apply, hsrcR, hSy, hmatch, hTy, htgtR]
  -- Every point near the source point is the source projection of a point near `(q, Q)`, its
  -- image under the branch of `R`.
  have hβ : Tendsto (generatingBranch hR hMR) (𝓝 (generatingSource I₁ R (q, Q))) (𝓝 (q, Q)) := by
    have hc := ((generatingBranch hR hMR).mdifferentiableAt (by simp)
      (mem_generatingBranch_source hR hMR)).continuousAt
    simpa only [generatingBranch_generatingSource] using hc.tendsto
  filter_upwards [hβ.eventually hsrc, eventually_generatingSource_generatingBranch hR hMR
    (mem_generatingBranch_source hR hMR)] with z hz hz'
  rwa [hz'] at hz

end GeneratedMap

end TauCeti.CotangentBundle
