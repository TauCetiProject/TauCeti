module

public import TauCeti.Geometry.Manifold.Morse.Sphere.Hessian
public import TauCeti.Geometry.Symplectic.Coadjoint.Sphere

import TauCeti.Geometry.Manifold.Morse.ScalarComposition

/-!
# Height functions on the coadjoint spheres of `SO(3)`

Identify `so(3)` with `ℝ³` by the hat map `ξ ↦ ξ̂` (`TauCeti.soThreeEquiv`), with bracket the cross
product, and `so(3)*` with `ℝ³` by the dot product, `ν_n(ξ̂) = n ⬝ ξ` (`TauCeti.soThreeDualEquiv`).
Normalize the invariant inner product `B` of `so(3)` to the dot product under the hat map,
`B(ξ̂, η̂) = ξ ⬝ η`; it identifies `so(3)` with `so(3)*`, and `ν_n(X) = B(n̂, X)`. The coadjoint
orbit of radius `r` is parametrized by the unit sphere `S² ⊂ ℝ³` through `x ↦ r x`, with moment map
`x ↦ ν_{r x}` and KKS form `r σ` (`TauCeti.isMomentMap_sphereRotationAction`,
`TauCeti.mul_eval₂_sphereAreaForm_sphereRotationAction`). The height function of `X ∈ so(3)` on
this orbit is

`f_X(x) = ν_{r x}(X) = B(r x̂, X)`.

Let `Z` be a unit vector, so that `Ẑ` generates the rotations about `Z`, of period `2π`, and let
`X = a Ẑ`. Then `f_X(x) = r a ⟪x, Z⟫` is `r a` times the height function `x ↦ ⟪x, Z⟫` of the
sphere (`TauCeti.soThreeDualEquiv_smul_apply_soThreeEquiv_smul`). Hence, for `r a ≠ 0`:

* the critical points of `f_X` are the poles `±Z`, which parametrize the points `p = ± r Z` of the
  orbit (`TauCeti.criticalPoints_soThreeDualEquiv_smul_apply_soThreeEquiv_smul`);
* at the critical point `x`, the critical Hessian of `f_X` is `-r a ⟪x, Z⟫` times the inner
  product of tangent vectors read in `ℝ³`
  (`TauCeti.criticalHessian_soThreeDualEquiv_smul_apply_soThreeEquiv_smul`);
* in particular, at `p = r Z` with `r ≠ 0`, `Hess = -(a / r) B` on the tangent plane of the orbit,
  whose tangent vectors are the images `r v` of the tangent vectors `v` of `S²` read in `ℝ³`
  (`TauCeti.criticalHessian_soThreeDualEquiv_smul_apply_soThreeEquiv_smul_self`);
* `f_X` is a Morse function, and its Morse index is `2` at the maximum and `0` at the minimum:
  at `Z` it is `2` when `r a > 0` and `0` when `r a < 0`, and the reverse at `-Z`
  (`TauCeti.manifoldMorseIndex_soThreeDualEquiv_smul_apply_soThreeEquiv_smul_self`,
  `TauCeti.manifoldMorseIndex_soThreeDualEquiv_smul_apply_soThreeEquiv_smul_neg`).

This is the rank-one case of the root-plane Hessian formula `Hess_p(f_X) = -α(X) B / α(p)` on the
real root plane of a coadjoint orbit: for `p = r Z` and the positive root of the torus generated by
`Ẑ`, `α(X) / α(p) = a / r`.

## References

* A. A. Kirillov, *Lectures on the Orbit Method*, Graduate Studies in Mathematics 64, AMS, 2004,
  Section 1.2.
-/

public section

noncomputable section

open Metric Module Matrix WithLp LieAlgebra.Orthogonal
open scoped Manifold ContDiff InnerProductSpace

namespace TauCeti

/-- Euclidean three-space. -/
local notation "ℝ³" => EuclideanSpace ℝ (Fin 3)

/-- The unit sphere of `ℝ³`. -/
local notation "S²" => sphere (0 : ℝ³) 1

/-- The inclusion of the unit sphere into `ℝ³`. -/
local notation "ι" => ((↑) : S² → ℝ³)

/-- The dimension of `ℝ³`, in the form used by the sphere lemmas. -/
private theorem fact_finrank_euclideanSpace_three : Fact (finrank ℝ ℝ³ = 2 + 1) :=
  ⟨finrank_euclideanSpace_fin⟩

attribute [local instance] fact_finrank_euclideanSpace_three

/-- The height of `X = a Ẑ` on the coadjoint sphere of radius `r`, at the point `r x`, is `r a`
times the height `⟪x, Z⟫` of the unit sphere. -/
theorem soThreeDualEquiv_smul_apply_soThreeEquiv_smul (r a : ℝ) (Z x : S²) :
    soThreeDualEquiv ℝ (r • ofLp (x : ℝ³)) (soThreeEquiv ℝ (a • ofLp (Z : ℝ³))) =
      r * a * sphereHeight Z x := by
  rw [soThreeDualEquiv_apply_soThreeEquiv, smul_dotProduct, dotProduct_smul, sphereHeight_apply,
    EuclideanSpace.inner_eq_star_dotProduct, star_trivial, dotProduct_comm, smul_eq_mul,
    smul_eq_mul]
  ring

/-- The height of `X = a Ẑ` on the coadjoint sphere of radius `r`, as a function on `S²`, is the
height function of the unit sphere in the direction `Z`, rescaled by `r a`. -/
private theorem soThreeDualEquiv_smul_apply_soThreeEquiv_smul_eq_comp (r a : ℝ) (Z : S²) :
    (fun x : S² ↦ soThreeDualEquiv ℝ (r • ofLp (x : ℝ³)) (soThreeEquiv ℝ (a • ofLp (Z : ℝ³)))) =
      (fun t ↦ r * a * t) ∘ sphereHeight Z :=
  funext fun x ↦ soThreeDualEquiv_smul_apply_soThreeEquiv_smul r a Z x

/-- **The critical points of a height on a coadjoint sphere of `SO(3)`.** For `r a ≠ 0`, the
height of `X = a Ẑ` on the coadjoint sphere of radius `r` has exactly the two critical points
`±Z`, which parametrize the points `± r Z` of the orbit. -/
theorem criticalPoints_soThreeDualEquiv_smul_apply_soThreeEquiv_smul {r a : ℝ} (hra : r * a ≠ 0)
    (Z : S²) :
    criticalPoints (𝓡 2)
        (fun x : S² ↦ soThreeDualEquiv ℝ (r • ofLp (x : ℝ³)) (soThreeEquiv ℝ (a • ofLp (Z : ℝ³)))) =
      {Z, -Z} := by
  ext x
  rw [soThreeDualEquiv_smul_apply_soThreeEquiv_smul_eq_comp,
    mem_criticalPoints_scalar_comp_iff ((contMDiff_sphereHeight (m := 1) Z x).mdifferentiableAt
      one_ne_zero) (by simpa using hra), criticalPoints_sphereHeight]

/-- **The Hessian of a height on a coadjoint sphere of `SO(3)`.** At a critical point `x = ±Z` of
the height of `X = a Ẑ` on the coadjoint sphere of radius `r`, the critical Hessian is
`-r a ⟪x, Z⟫` times the inner product of tangent vectors read in `ℝ³`. -/
theorem criticalHessian_soThreeDualEquiv_smul_apply_soThreeEquiv_smul (r a : ℝ) {Z x : S²}
    (hx : x ∈ criticalPoints (𝓡 2) (sphereHeight Z)) (v w : TangentSpace (𝓡 2) x) :
    criticalHessian (𝓡 2)
        (fun y : S² ↦ soThreeDualEquiv ℝ (r • ofLp (y : ℝ³)) (soThreeEquiv ℝ (a • ofLp (Z : ℝ³))))
        x v w =
      -(r * a * sphereHeight Z x) * ⟪mvfderiv (𝓡 2) ι x v, mvfderiv (𝓡 2) ι x w⟫_ℝ := by
  rw [soThreeDualEquiv_smul_apply_soThreeEquiv_smul_eq_comp]
  exact criticalHessian_mul_sphereHeight (r * a) hx v w

/-- **The Hessian `-aB/r` at the top of a coadjoint sphere of `SO(3)`.** On the coadjoint sphere of
radius `r ≠ 0`, at `p = r Z`, the critical Hessian of the height of `X = a Ẑ` is `-(a / r) B` on
the tangent plane of the orbit: a tangent vector `v` of `S²` at `Z` is the tangent vector `r v` of
the orbit, read in `ℝ³ ≅ so(3)`, and `B` is the dot product. -/
theorem criticalHessian_soThreeDualEquiv_smul_apply_soThreeEquiv_smul_self {r : ℝ} (hr : r ≠ 0)
    (a : ℝ) (Z : S²) (v w : TangentSpace (𝓡 2) Z) :
    criticalHessian (𝓡 2)
        (fun y : S² ↦ soThreeDualEquiv ℝ (r • ofLp (y : ℝ³)) (soThreeEquiv ℝ (a • ofLp (Z : ℝ³))))
        Z v w =
      -(a / r) * ⟪r • mvfderiv (𝓡 2) ι Z v, r • mvfderiv (𝓡 2) ι Z w⟫_ℝ := by
  rw [criticalHessian_soThreeDualEquiv_smul_apply_soThreeEquiv_smul r a
    (by simp : Z ∈ criticalPoints (𝓡 2) (sphereHeight Z)), sphereHeight_self, real_inner_smul_left,
    real_inner_smul_right]
  field_simp

/-- For `r a ≠ 0`, the height of `X = a Ẑ` on the coadjoint sphere of radius `r` is a Morse
function. -/
theorem isMorse_soThreeDualEquiv_smul_apply_soThreeEquiv_smul {r a : ℝ} (hra : r * a ≠ 0)
    (Z : S²) :
    IsMorse (𝓡 2)
      fun y : S² ↦ soThreeDualEquiv ℝ (r • ofLp (y : ℝ³)) (soThreeEquiv ℝ (a • ofLp (Z : ℝ³))) := by
  rw [soThreeDualEquiv_smul_apply_soThreeEquiv_smul_eq_comp]
  exact (isMorse_sphereHeight Z).scalar_comp (fun _ ↦ (contDiff_const.mul contDiff_id).contDiffAt)
    fun _ ↦ by simpa using hra

/-- The Morse index of the height of `X = a Ẑ` on the coadjoint sphere of radius `r` at `Z` is
`2` when `r a > 0`, where `Z` is the maximum, and `0` when `r a < 0`, where it is the minimum. -/
theorem manifoldMorseIndex_soThreeDualEquiv_smul_apply_soThreeEquiv_smul_self {r a : ℝ}
    (hra : r * a ≠ 0) (Z : S²) :
    manifoldMorseIndex (𝓡 2)
        (fun y : S² ↦ soThreeDualEquiv ℝ (r • ofLp (y : ℝ³)) (soThreeEquiv ℝ (a • ofLp (Z : ℝ³))))
        Z =
      if 0 < r * a then 2 else 0 := by
  rw [soThreeDualEquiv_smul_apply_soThreeEquiv_smul_eq_comp]
  exact (manifoldMorseIndex_mul_sphereHeight hra (by simp)).trans
    (by rw [sphereHeight_self, mul_one])

/-- The Morse index of the height of `X = a Ẑ` on the coadjoint sphere of radius `r` at `-Z` is
`0` when `r a > 0`, where `-Z` is the minimum, and `2` when `r a < 0`, where it is the maximum. -/
theorem manifoldMorseIndex_soThreeDualEquiv_smul_apply_soThreeEquiv_smul_neg {r a : ℝ}
    (hra : r * a ≠ 0) (Z : S²) :
    manifoldMorseIndex (𝓡 2)
        (fun y : S² ↦ soThreeDualEquiv ℝ (r • ofLp (y : ℝ³)) (soThreeEquiv ℝ (a • ofLp (Z : ℝ³))))
        (-Z) =
      if 0 < r * a then 0 else 2 := by
  rw [soThreeDualEquiv_smul_apply_soThreeEquiv_smul_eq_comp]
  refine (manifoldMorseIndex_mul_sphereHeight hra (by simp)).trans ?_
  rw [sphereHeight_neg_self, mul_neg_one]
  rcases lt_or_gt_of_ne hra with h | h
  · simp [neg_pos.2 h, h.not_gt]
  · simp [(neg_neg_of_pos h).not_gt, h]

end TauCeti
