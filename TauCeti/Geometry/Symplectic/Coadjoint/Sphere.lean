/-!
# The coadjoint spheres of `so(3)` and their Kirillov–Kostant–Souriau form

Through the hat map `ξ ↦ ξ̂` and the dot product, `so(3)` and its dual are both identified with
`ℝ³` (`TauCeti.soThreeEquiv`, `TauCeti.soThreeDualEquiv`), the bracket becomes the cross product
and the coadjoint action of `ξ̂` becomes the infinitesimal rotation `n ↦ ξ ⨯₃ n`
(`TauCeti.lie_soThreeEquiv_soThreeDualEquiv`). So the orbit tangent vector generated by `ξ̂` at
`ν_n` is `ξ ⨯₃ n`, and the orbit tangent plane at `ν_n` is `n^⊥`
(`TauCeti.soThreeDualEquiv_mem_range_coadjointTangentMap_iff`), the tangent plane of the sphere of
radius `‖n‖`. That sphere is the coadjoint orbit of the rotation group `SO(3)` through `ν_n`, a
fact about the group action that is not formalized here.

This file puts the Kirillov–Kostant–Souriau form `ω_ν([ξ̂], [η̂]) = ν ⁅ξ̂, η̂⁆` on these spheres
as a smooth two-form, read on the unit sphere `S²` through the dilation `u ↦ r u` onto the sphere
of radius `|r|`. The dilation carries the tangent vector `ξ ⨯₃ u` at `u` to the orbit tangent
vector `ξ ⨯₃ (r u)` at `ν_(r u)`, so the pulled-back KKS form is the two-form
`TauCeti.kksSphereForm r` determined by

`kksSphereForm r (ξ ⨯₃ u, η ⨯₃ u) = ν_(r u) ⁅ξ̂, η̂⁆ = r u ⬝ᵥ (ξ ⨯₃ η)`

(`TauCeti.eval₂_kksSphereForm_eq_kksForm_of_cross`). Every tangent vector `a` of `S²` at `u` is
the infinitesimal rotation `ξ ⨯₃ u` with `ξ = u ⨯₃ a`, so this identity determines the form
(`TauCeti.eval₂_kksSphereForm_eq_kksForm`). In ambient coordinates it is `r` times the area form
`(a, b) ↦ u ⬝ᵥ (a ⨯₃ b)` of the round sphere (`TauCeti.eval₂_kksSphereForm`).

The form is symplectic exactly when `r ≠ 0` (`TauCeti.isSymplectic_kksSphereForm_iff`): it is
closed because the sphere is two-dimensional, and nondegenerate because the area form vanishes
nowhere. Since the unit sphere has area `4π`
(`Orientation.integralTopForm_sphereOrientation_sphereTopForm`), the coadjoint sphere of radius
`r > 0` has KKS area `4π r` (`TauCeti.integralTopForm_kksSphereForm`), not the Euclidean area
`4π r²`: on the sphere of radius `r` the KKS form is `1 / r` times the Euclidean area form.

## Main definitions

* `TauCeti.kksSphereForm r`: the KKS form of the coadjoint sphere of radius `r` of `so(3)`, read
  on the unit sphere.

## Main results

* `TauCeti.eval₂_kksSphereForm`: `kksSphereForm r (a, b) = r u ⬝ᵥ (a ⨯₃ b)` at `u`.
* `TauCeti.eval₂_kksSphereForm_eq_kksForm_of_cross`, `TauCeti.eval₂_kksSphereForm_eq_kksForm`: it
  is the KKS form `ω_ν` of `so(3)` at `ν = ν_(r u)` on the orbit tangent vectors.
* `TauCeti.isSymplectic_kksSphereForm_iff`: it is symplectic exactly when `r ≠ 0`.
* `TauCeti.integralTopForm_kksSphereForm`: its integral over the outward-oriented sphere is `4π r`.

## References

* J. E. Marsden and T. S. Ratiu, *Introduction to Mechanics and Symmetry*, second edition, Texts
  in Applied Mathematics 17, Springer, 1999, Section 14.6 (the coadjoint orbits of `SO(3)` and
  their symplectic form).
* A. A. Kirillov, *Lectures on the Orbit Method*, Graduate Studies in Mathematics 64, AMS, 2004,
  Section 1.2.
-/

public section

noncomputable section

open Metric Module Matrix
open scoped Manifold ContDiff

namespace TauCeti

attribute [local instance] finrank_euclideanSpace_fin_succ_fact

local notation "ℝ³" => EuclideanSpace ℝ (Fin 3)
local notation "S²" => sphere (0 : ℝ³) 1

/-- The **Kirillov–Kostant–Souriau form of the coadjoint sphere of radius `r`** of `so(3)`, read
on the unit sphere through the dilation `u ↦ r u`: `r` times the outward-normal area form,
`(a, b) ↦ r u ⬝ᵥ (a ⨯₃ b)` at `u`. On the orbit tangent vectors `ξ ⨯₃ u` and `η ⨯₃ u` it is the
KKS form `ν_(r u) ⁅ξ̂, η̂⁆` of `so(3)` (`TauCeti.eval₂_kksSphereForm_eq_kksForm_of_cross`). -/
def kksSphereForm (r : ℝ) : SmoothTwoForm (𝓡 2) S² :=
  r • ⟨(EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.orientation.sphereTopForm,
    (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.orientation.isSmoothForm_sphereTopForm
      |>.mem_smoothBundleForms⟩

/-- The KKS sphere form is `r` times the outward-normal area form of the unit sphere. -/
@[simp]
theorem coe_kksSphereForm (r : ℝ) :
    ((kksSphereForm r : SmoothForm (𝓡 2) S² ℝ 2) : RoughForm (𝓡 2) S² ℝ 2) =
      r • (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.orientation.sphereTopForm :=
  (rfl)

/-- **The KKS sphere form in ambient coordinates.** At `u`, it pairs two tangent vectors, read in
`ℝ³` through the derivative of the inclusion, to `r u ⬝ᵥ (a ⨯₃ b)`. -/
theorem eval₂_kksSphereForm (r : ℝ) (u : S²) (a b : TangentSpace (𝓡 2) u) :
    SmoothBundleForm.eval₂ (kksSphereForm r) u a b =
      r * ((u : ℝ³).ofLp ⬝ᵥ (mvfderiv (𝓡 2) ((↑) : S² → ℝ³) u a).ofLp ⨯₃
        (mvfderiv (𝓡 2) ((↑) : S² → ℝ³) u b).ofLp) := by
  rw [SmoothBundleForm.eval₂_apply, coe_kksSphereForm, Pi.smul_apply,
    ContinuousAlternatingMap.smul_apply, Orientation.sphereTopForm_apply, smul_eq_mul,
    ← EuclideanSpace.volumeForm_eq_dotProduct_cross]
  congr 2
  ext i
  fin_cases i <;> rfl

private theorem dotProduct_self_ofLp_of_mem_sphere (u : S²) :
    (u : ℝ³).ofLp ⬝ᵥ (u : ℝ³).ofLp = 1 := by
  have h := real_inner_self_eq_norm_sq (u : ℝ³)
  rw [norm_eq_of_mem_sphere u, one_pow, EuclideanSpace.inner_eq_star_dotProduct] at h
  simpa using h

/-- A tangent vector of the unit sphere at `u`, read in `ℝ³`, is orthogonal to `u`. -/
private theorem dotProduct_ofLp_mvfderiv_coe_sphere (u : S²) (a : TangentSpace (𝓡 2) u) :
    (mvfderiv (𝓡 2) ((↑) : S² → ℝ³) u a).ofLp ⬝ᵥ (u : ℝ³).ofLp = 0 := by
  have h : mvfderiv (𝓡 2) ((↑) : S² → ℝ³) u a ∈ (ℝ ∙ (u : ℝ³))ᗮ := by
    rw [← range_mvfderiv_subtypeVal (n := 2)]
    exact LinearMap.mem_range_self _ a
  rw [Submodule.mem_orthogonal_singleton_iff_inner_right,
    EuclideanSpace.inner_eq_star_dotProduct] at h
  simpa using h

/-- **The KKS sphere form is the KKS form of `so(3)`.** On the tangent vectors `ξ ⨯₃ u` and
`η ⨯₃ u` at `u`, the infinitesimal rotations generated by `ξ̂` and `η̂`, it takes the value
`ω_ν([ξ̂], [η̂]) = ν ⁅ξ̂, η̂⁆` of the KKS form at the point `ν = ν_(r u)` of `so(3)*`. -/
theorem eval₂_kksSphereForm_eq_kksForm_of_cross (r : ℝ) (u : S²)
    {a b : TangentSpace (𝓡 2) u} {ξ η : Fin 3 → ℝ}
    (ha : (mvfderiv (𝓡 2) ((↑) : S² → ℝ³) u a).ofLp = ξ ⨯₃ (u : ℝ³).ofLp)
    (hb : (mvfderiv (𝓡 2) ((↑) : S² → ℝ³) u b).ofLp = η ⨯₃ (u : ℝ³).ofLp) :
    SmoothBundleForm.eval₂ (kksSphereForm r) u a b =
      (soThreeDualEquiv ℝ (r • (u : ℝ³).ofLp)).kksForm
        (Submodule.Quotient.mk (soThreeEquiv ℝ ξ)) (Submodule.Quotient.mk (soThreeEquiv ℝ η)) := by
  -- `(ξ ⨯₃ u) ⨯₃ (η ⨯₃ u) = (ξ ⬝ᵥ η ⨯₃ u) • u` and `u ⬝ᵥ u = 1`.
  rw [eval₂_kksSphereForm, ha, hb, kksForm_soThreeDualEquiv_mk, cross_cross_cross_eq_smul,
    dotProduct_smul, dotProduct_self_ofLp_of_mem_sphere, smul_eq_mul, mul_one, smul_dotProduct,
    smul_eq_mul, triple_product_permutation (u : ℝ³).ofLp ξ η]

/-- **The KKS sphere form is the KKS form of `so(3)`, on every pair of tangent vectors.** A tangent
vector `a` at `u` is the infinitesimal rotation `ξ ⨯₃ u` generated by `ξ = u ⨯₃ a`, so the form
is `ω_ν([(u ⨯₃ a)^], [(u ⨯₃ b)^])` at `ν = ν_(r u)`. -/
theorem eval₂_kksSphereForm_eq_kksForm (r : ℝ) (u : S²) (a b : TangentSpace (𝓡 2) u) :
    SmoothBundleForm.eval₂ (kksSphereForm r) u a b =
      (soThreeDualEquiv ℝ (r • (u : ℝ³).ofLp)).kksForm
        (Submodule.Quotient.mk (soThreeEquiv ℝ
          ((u : ℝ³).ofLp ⨯₃ (mvfderiv (𝓡 2) ((↑) : S² → ℝ³) u a).ofLp)))
        (Submodule.Quotient.mk (soThreeEquiv ℝ
          ((u : ℝ³).ofLp ⨯₃ (mvfderiv (𝓡 2) ((↑) : S² → ℝ³) u b).ofLp))) := by
  -- `(u ⨯₃ a) ⨯₃ u = (u ⬝ᵥ u) • a - (a ⬝ᵥ u) • u = a`.
  refine eval₂_kksSphereForm_eq_kksForm_of_cross r u ?_ ?_ <;>
  · rw [cross_cross_eq_smul_sub_smul, dotProduct_self_ofLp_of_mem_sphere, one_smul,
      dotProduct_ofLp_mvfderiv_coe_sphere, zero_smul, sub_zero]

/-- **The coadjoint spheres of `so(3)` are symplectic.** The KKS sphere form of radius `r` is
closed and nondegenerate exactly when `r ≠ 0`. -/
theorem isSymplectic_kksSphereForm_iff {r : ℝ} :
    SmoothTwoForm.IsSymplectic (kksSphereForm r) ↔ r ≠ 0 := by
  rw [SmoothTwoForm.isSymplectic_iff_forall_ne_zero_of_finrank_eq_two finrank_euclideanSpace_fin]
  refine ⟨fun h hr ↦ ?_, fun hr u ↦ ?_⟩
  · let u : S² := ⟨EuclideanSpace.single 0 1, by simp⟩
    exact h u (by rw [coe_kksSphereForm, hr, zero_smul, Pi.zero_apply])
  · rw [coe_kksSphereForm, Pi.smul_apply]
    exact smul_ne_zero hr
      ((EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.orientation.sphereTopForm_ne_zero u)

/-- **The KKS area of the coadjoint sphere of radius `r` is `4π r`.** The KKS sphere form
integrates to `4π r` over the unit sphere with its outward-normal orientation. -/
theorem integralTopForm_kksSphereForm (r : ℝ) :
    integralTopForm (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.orientation.sphereOrientation
      ((kksSphereForm r : SmoothForm (𝓡 2) S² ℝ 2) : RoughForm (𝓡 2) S² ℝ 2) =
        4 * Real.pi * r := by
  rw [coe_kksSphereForm, integralTopForm_smul,
    Orientation.integralTopForm_sphereOrientation_sphereTopForm, mul_comm]

end TauCeti
