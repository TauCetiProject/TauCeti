module

public import TauCeti.Geometry.Diffeomorphism.Diffeotopy.Basic
public import TauCeti.Geometry.Manifold.IntegralCurve.CompactSupport
public import TauCeti.Geometry.Manifold.IntegralCurve.GlobalFlow
import Mathlib.Geometry.Manifold.Algebra.SmoothFunctions

/-!
# Diffeotopies generated by complete vector fields

A complete `C^n` vector field, `1 ≤ n`, generates a diffeotopy on a
possibly noncompact finite-dimensional boundaryless manifold. The motion at time `t ∈ [0,1]`
is the field's flow at time `a * t`, for an arbitrary real duration `a`.
Its inverse uses time `-(a * t)`.
Every zero of the field is fixed throughout. In particular, a field vanishing outside a
compact set generates a motion supported in the same set.

This converts cut-off local vector fields into ambient motions with controlled support.
It does not assert extension of an arbitrary isotopy through embeddings.

Reference: J. M. Lee, *Introduction to Smooth Manifolds*, second edition,
Theorems 9.12 and 9.16.
-/

public section

noncomputable section

open Set
open scoped Manifold ContDiff

namespace TauCeti

variable {E H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  [TopologicalSpace M] [ChartedSpace H M] [T2Space M]
  [BoundarylessManifold I M] {n : ℕ∞} [IsManifold I n M] [IsManifold I 1 M]
  {v : (x : M) → TangentSpace I x} {K : Set M}

/-- Run a complete `C^n` vector field for duration `a`, starting at the identity.
The ambient manifold need not be compact, and negative durations are allowed. -/
def globalFlowDiffeotopy (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : ∀ x, maximalIntegralCurveInterval v x = univ) (a : ℝ) :
    Diffeotopy I n M := by
  let hv₁ : CMDiff 1 (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)) :=
    hv.of_le (by exact_mod_cast hn)
  let φ := globalFlow v hv₁ hcomplete
  have hs := contMDiff_globalFlow_uncurry hcomplete hn hv
  have ht : ContMDiff ((𝓡∂ 1).prod I) 𝓘(ℝ) n
      (fun p : unitInterval × M => a * (p.1 : ℝ)) :=
    contMDiff_const.mul (contMDiff_subtypeVal_Icc.comp contMDiff_fst)
  exact
    { toDiffeomorph :=
        { toEquiv :=
            { toFun := fun p => (p.1, φ (a * p.1) p.2)
              invFun := fun p => (p.1, φ (-(a * p.1)) p.2)
              left_inv := fun p => by simp [← φ.map_add]
              right_inv := fun p => by simp [← φ.map_add] }
          contMDiff_toFun := contMDiff_fst.prodMk (hs.comp (ht.prodMk contMDiff_snd))
          contMDiff_invFun := contMDiff_fst.prodMk (hs.comp (ht.neg.prodMk contMDiff_snd)) }
      fst_apply := fun _ => rfl
      snd_apply_zero' := fun x => by simp [← Diffeomorph.coe_toEquiv] }

/-- The motion is the maximal integral curve of the field at the rescaled time. -/
@[simp] theorem globalFlowDiffeotopy_apply (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : ∀ x, maximalIntegralCurveInterval v x = univ)
    (a : ℝ) (p : unitInterval × M) :
    globalFlowDiffeotopy hn hv hcomplete a p =
      maximalIntegralCurve v p.2 (a * p.1) := by
  simp [globalFlowDiffeotopy, ← Diffeomorph.coe_toEquiv, globalFlow_apply]

/-- The inverse motion runs the same field for the opposite duration. -/
@[simp] theorem globalFlowDiffeotopy_toDiffeomorph_symm_apply (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : ∀ x, maximalIntegralCurveInterval v x = univ)
    (a : ℝ) (p : unitInterval × M) :
    (globalFlowDiffeotopy hn hv hcomplete a).toDiffeomorph.symm p =
      (p.1, maximalIntegralCurve v p.2 (-(a * p.1))) := by
  simp [globalFlowDiffeotopy,
    ← Diffeomorph.coe_toEquiv, globalFlow_apply]

/-- Every zero of the generating field is fixed throughout the diffeotopy. -/
theorem globalFlowDiffeotopy_apply_of_eq_zero (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : ∀ x, maximalIntegralCurveInterval v x = univ) (a : ℝ)
    {x : M} (hx : v x = 0) (t : unitInterval) :
    globalFlowDiffeotopy hn hv hcomplete a (t, x) = x := by
  rw [globalFlowDiffeotopy_apply]
  have h := globalFlow_eq_of_isMIntegralCurve (hv.of_le (by exact_mod_cast hn))
    hcomplete (isMIntegralCurve_const hx) (a * t)
  simpa only [globalFlow_apply] using h

/-- Run a compactly supported `C^n` vector field for duration `a`, starting at the identity.
The ambient manifold need not be compact, and negative durations are allowed. -/
def compactlySupportedFlowDiffeotopy (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hK : IsCompact K) (hzero : ∀ y ∉ K, v y = 0) (a : ℝ) : Diffeotopy I n M :=
  globalFlowDiffeotopy hn hv (fun _ =>
    maximalIntegralCurveInterval_eq_univ_of_isCompact_of_eq_zero_off
      (hv.of_le (by exact_mod_cast hn)) hK hzero) a

/-- The compactly supported motion is the maximal integral curve at the rescaled time. -/
@[simp] theorem compactlySupportedFlowDiffeotopy_apply (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hK : IsCompact K) (hzero : ∀ y ∉ K, v y = 0) (a : ℝ) (p : unitInterval × M) :
    compactlySupportedFlowDiffeotopy hn hv hK hzero a p =
      maximalIntegralCurve v p.2 (a * p.1) := by
  simp [compactlySupportedFlowDiffeotopy]

/-- The inverse compactly supported motion runs the field for the opposite duration. -/
@[simp] theorem compactlySupportedFlowDiffeotopy_toDiffeomorph_symm_apply (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hK : IsCompact K) (hzero : ∀ y ∉ K, v y = 0) (a : ℝ) (p : unitInterval × M) :
    (compactlySupportedFlowDiffeotopy hn hv hK hzero a).toDiffeomorph.symm p =
      (p.1, maximalIntegralCurve v p.2 (-(a * p.1))) := by
  simp [compactlySupportedFlowDiffeotopy]

/-- Every zero of a compactly supported generating field is fixed throughout the motion. -/
theorem compactlySupportedFlowDiffeotopy_apply_of_eq_zero (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hK : IsCompact K) (hzero : ∀ y ∉ K, v y = 0) (a : ℝ)
    {x : M} (hx : v x = 0) (t : unitInterval) :
    compactlySupportedFlowDiffeotopy hn hv hK hzero a (t, x) = x := by
  rw [compactlySupportedFlowDiffeotopy]
  exact globalFlowDiffeotopy_apply_of_eq_zero hn hv _ a hx t

/-- The entire motion fixes the complement of the prescribed compact support set. -/
theorem compactlySupportedFlowDiffeotopy_eqOn_compl (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hK : IsCompact K) (hzero : ∀ y ∉ K, v y = 0) (a : ℝ) (t : unitInterval) :
    EqOn (fun x => compactlySupportedFlowDiffeotopy hn hv hK hzero a (t, x)) id Kᶜ :=
  fun x hx => compactlySupportedFlowDiffeotopy_apply_of_eq_zero hn hv hK hzero a
    (hzero x hx) t

end TauCeti
