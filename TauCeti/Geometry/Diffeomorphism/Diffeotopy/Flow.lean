import Mathlib.Geometry.Manifold.Algebra.SmoothFunctions

/-!
# Diffeotopies generated by complete vector fields

A complete `C^n` vector field, `1 ≤ n`, generates a diffeotopy on a
possibly noncompact finite-dimensional boundaryless manifold. More generally, for a `C^n` time
function `A : ℝ → ℝ` with `A 0 = 0`, the motion at time `t ∈ [0,1]` may be taken to be the field's
flow `ψ_(A t)` at time `A t` (`TauCeti.globalFlowDiffeotopyAlong`,
`TauCeti.Diffeotopy.timeSlice_globalFlowDiffeotopyAlong`), with inverse `ψ_(-A t)`. Read on the
cylinder, the motion `(x, t) ↦ ψ_(A t) x` has time derivative `A'(t) v` and spatial derivative
`dψ_(A t)` (`TauCeti.Diffeotopy.mfderiv_cylinderMap_globalFlowDiffeotopyAlong_time`,
`TauCeti.Diffeotopy.mfderiv_cylinderMap_globalFlowDiffeotopyAlong_space`), so its velocity
field at time `t` is `A'(t) v` (`TauCeti.Diffeotopy.velocity_globalFlowDiffeotopyAlong`). The
constant-speed case `A t = a t` runs the field for an arbitrary real duration `a`
(`TauCeti.globalFlowDiffeotopy`, `TauCeti.Diffeotopy.timeSlice_globalFlowDiffeotopy`), whose
velocity field is the time-independent field `a v`
(`TauCeti.Diffeotopy.velocity_globalFlowDiffeotopy`).
Every zero of the field is fixed throughout. In particular, a field vanishing outside a
compact set generates a motion supported in the same set.

A time-dependent `C^n` vector field `X` whose suspension is complete generates a diffeotopy
too (`TauCeti.timeDependentFlowDiffeotopy`): the motion at time `t ∈ [0,1]` is its
time-dependent flow from time `0` to time `t`, with inverse the flow from `t` back to `0`. This
holds in particular when `X` vanishes outside a fixed compact set at all times
(`TauCeti.isCompleteVectorField_timeDependentSuspensionField`). Read on the cylinder, its motion
`(x, t) ↦ φ_{0, t} x` has time derivative `X t (φ_{0, t} x)`
(`TauCeti.Diffeotopy.mfderiv_cylinderMap_timeDependentFlowDiffeotopy_time`). Points at which `X`
vanishes at all times are fixed throughout.

This converts cut-off local vector fields into ambient motions with controlled support. The
isotopy extension theorem runs the time-dependent diffeotopy of the ambient velocity field of an
isotopy through embeddings.

Reference: J. M. Lee, *Introduction to Smooth Manifolds*, second edition,
Theorems 9.12, 9.16 and 9.48.
-/

public section

noncomputable section

open Set
open scoped Manifold ContDiff

namespace TauCeti

variable {E H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  [TopologicalSpace M] [ChartedSpace H M] [T2Space M]
  [BoundarylessManifold I M] {n : ℕ∞} [IsManifold I n M] [IsManifold I 1 M]
  {v : (x : M) → TangentSpace I x} {K : Set M}

/-- Run a complete `C^n` vector field along a `C^n` time function `A` with `A 0 = 0`: the motion
at time `t ∈ [0, 1]` is the flow of the field for time `A t`, and its inverse is the flow for time
`-A t`. The ambient manifold need not be compact. -/
def globalFlowDiffeotopyAlong (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : IsCompleteVectorField v) (A : ℝ → ℝ) (hA : ContDiff ℝ n A) (hA₀ : A 0 = 0) :
    Diffeotopy I n M := by
  let hv₁ : CMDiff 1 (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)) :=
    hv.of_le (by exact_mod_cast hn)
  let φ := globalFlow v hv₁ hcomplete
  have hs := contMDiff_globalFlow_uncurry hcomplete hn hv
  have ht : ContMDiff ((𝓡∂ 1).prod I) 𝓘(ℝ) n (fun p : unitInterval × M => A p.1) :=
    hA.contMDiff.comp (contMDiff_subtypeVal_Icc.comp contMDiff_fst)
  exact
    { toDiffeomorph :=
        { toEquiv :=
            { toFun := fun p => (p.1, φ (A p.1) p.2)
              invFun := fun p => (p.1, φ (-A p.1) p.2)
              left_inv := fun p => by simp [← φ.map_add]
              right_inv := fun p => by simp [← φ.map_add] }
          contMDiff_toFun := contMDiff_fst.prodMk (hs.comp (ht.prodMk contMDiff_snd))
          contMDiff_invFun := contMDiff_fst.prodMk (hs.comp (ht.neg.prodMk contMDiff_snd)) }
      fst_apply := fun _ => rfl
      snd_apply_zero' := fun x => by simp [hA₀, ← Diffeomorph.coe_toEquiv] }

section Along

variable (hn : 1 ≤ n) (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
  (hcomplete : IsCompleteVectorField v) (A : ℝ → ℝ) (hA : ContDiff ℝ n A) (hA₀ : A 0 = 0)

/-- The motion along a time function `A` is the maximal integral curve at time `A t`. -/
@[simp] theorem globalFlowDiffeotopyAlong_apply (p : unitInterval × M) :
    globalFlowDiffeotopyAlong hn hv hcomplete A hA hA₀ p =
      maximalIntegralCurve v p.2 (A p.1) := by
  simp [globalFlowDiffeotopyAlong, ← Diffeomorph.coe_toEquiv, globalFlow_apply]

/-- The inverse motion along a time function `A` runs the field for time `-A t`. -/
@[simp] theorem globalFlowDiffeotopyAlong_toDiffeomorph_symm_apply (p : unitInterval × M) :
    (globalFlowDiffeotopyAlong hn hv hcomplete A hA hA₀).toDiffeomorph.symm p =
      (p.1, maximalIntegralCurve v p.2 (-A p.1)) := by
  simp [globalFlowDiffeotopyAlong, ← Diffeomorph.coe_toEquiv, globalFlow_apply]

/-- Every zero of the generating field is fixed throughout the motion along a time function. -/
theorem globalFlowDiffeotopyAlong_apply_of_eq_zero {x : M} (hx : v x = 0) (t : unitInterval) :
    globalFlowDiffeotopyAlong hn hv hcomplete A hA hA₀ (t, x) = x := by
  rw [globalFlowDiffeotopyAlong_apply]
  have h := globalFlow_eq_of_isMIntegralCurve (hv.of_le (by exact_mod_cast hn))
    hcomplete (isMIntegralCurve_const hx) (A t)
  simpa only [globalFlow_apply] using h

namespace Diffeotopy

/-- The time-`t` map of the motion along a time function `A` is the flow of the field for time
`A t`. -/
theorem timeSlice_globalFlowDiffeotopyAlong (t : unitInterval) :
    ⇑((globalFlowDiffeotopyAlong hn hv hcomplete A hA hA₀).timeSlice t) = flowOf v (A t) := by
  funext x
  rw [timeSlice_apply, globalFlowDiffeotopyAlong_apply, flowOf_apply]

/-- The motion along a time function `A`, read on the cylinder: at `(x, t)` it is the flow of
the field for time `A t`. -/
theorem cylinderMap_globalFlowDiffeotopyAlong :
    (globalFlowDiffeotopyAlong hn hv hcomplete A hA hA₀).cylinderMap =
      fun p : M × unitInterval ↦ flowOf v (A p.2) p.1 := by
  funext p
  rw [cylinderMap_apply, globalFlowDiffeotopyAlong_apply, flowOf_apply]

/-- **The velocity of the motion along a time function.** The motion `(x, t) ↦ ψ_(A t) x` along a
time function `A` of the flow `ψ` of a complete vector field `v` sends the unit time vector `∂ₜ`
at `(x, t)` to `A'(t) v (ψ_(A t) x)`. -/
theorem mfderiv_cylinderMap_globalFlowDiffeotopyAlong_time (p : M × unitInterval) :
    mfderiv (I.prod (𝓡∂ 1)) I (globalFlowDiffeotopyAlong hn hv hcomplete A hA hA₀).cylinderMap p
      ((0 : E), (1 : TangentSpace (𝓡∂ 1) p.2)) = deriv A p.2 • v (flowOf v (A p.2) p.1) := by
  have hv₁ : CMDiff 1 (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)) :=
    hv.of_le (by exact_mod_cast hn)
  have hval : MDifferentiableAt (𝓡∂ 1) 𝓘(ℝ) (Subtype.val : unitInterval → ℝ) p.2 :=
    (contMDiff_subtypeVal_Icc (n := 1)).mdifferentiableAt one_ne_zero
  have hAd : MDifferentiableAt 𝓘(ℝ) 𝓘(ℝ) A p.2 :=
    ((hA.differentiable (by exact_mod_cast (zero_lt_one.trans_le hn).ne')) p.2).mdifferentiableAt
  have htraj : MDifferentiableAt 𝓘(ℝ) I (fun s ↦ flowOf v s p.1) (A p.2) :=
    mdifferentiableAt_flowOf hv₁ (hcomplete.mem_flowDomain _ _)
  -- The time `t ↦ A t` has derivative `A' t`, since the inclusion of the interval sends `∂ₜ` to
  -- `1`.
  have hscale : mfderiv (𝓡∂ 1) 𝓘(ℝ) (fun z : unitInterval ↦ A z) p.2
      (1 : TangentSpace (𝓡∂ 1) p.2) = deriv A p.2 := by
    have hcomp : (fun z : unitInterval ↦ A z) = A ∘ Subtype.val := rfl
    rw [hcomp, mfderiv_comp p.2 hAd hval, ContinuousLinearMap.comp_apply,
      mfderiv_subtypeVal_Icc_one, mfderiv_eq_fderiv]
    exact fderiv_apply_one_eq_deriv (𝕜 := ℝ) (f := A) (x := (p.2 : ℝ))
  -- So the trajectory `t ↦ ψ_(A t) x` has velocity `A' t • v`.
  have htime : mfderiv (𝓡∂ 1) I (fun z : unitInterval ↦ flowOf v (A z) p.1) p.2
      (1 : TangentSpace (𝓡∂ 1) p.2) = deriv A p.2 • v (flowOf v (A p.2) p.1) := by
    have hcomp : (fun z : unitInterval ↦ flowOf v (A z) p.1) =
        (fun s ↦ flowOf v s p.1) ∘ fun z : unitInterval ↦ A z := rfl
    rw [hcomp, mfderiv_comp (f := fun z : unitInterval ↦ A z) p.2 htraj (hAd.comp p.2 hval),
      ContinuousLinearMap.comp_apply, hscale,
      mfderiv_flowOf_trajectory_apply hv₁ (hcomplete.mem_flowDomain _ _)]
  refine (mfderiv_prod_eq_add_apply ((globalFlowDiffeotopyAlong hn hv hcomplete A hA
    hA₀).contMDiff_cylinderMap.mdifferentiableAt
      (zero_lt_one.trans_le (by exact_mod_cast hn)).ne')).trans ?_
  rw [cylinderMap_globalFlowDiffeotopyAlong]
  exact (congrArg₂ (· + ·) (map_zero _) htime).trans (zero_add _)

/-- The motion `(x, t) ↦ ψ_(A t) x` along a time function acts on spatial tangent vectors at
`(x, t)` by the differential of the time-`A t` map `ψ_(A t)`. -/
theorem mfderiv_cylinderMap_globalFlowDiffeotopyAlong_space (p : M × unitInterval) (w : E) :
    mfderiv (I.prod (𝓡∂ 1)) I (globalFlowDiffeotopyAlong hn hv hcomplete A hA hA₀).cylinderMap p
      (w, (0 : EuclideanSpace ℝ (Fin 1))) = mfderiv I I (flowOf v (A p.2)) p.1 w :=
  ((globalFlowDiffeotopyAlong hn hv hcomplete A hA hA₀).mfderiv_cylinderMap_inl
    (by exact_mod_cast hn) p w).trans
    (by rw [timeSlice_globalFlowDiffeotopyAlong])

/-- **The velocity field of the motion along a time function.** Running a complete vector field
`v` along a time function `A` has the velocity field `A'(t) v` at time `t`. -/
@[simp]
theorem velocity_globalFlowDiffeotopyAlong (t : unitInterval) (x : M) :
    (globalFlowDiffeotopyAlong hn hv hcomplete A hA hA₀).velocity t x = deriv A t • v x := by
  set Φ := globalFlowDiffeotopyAlong hn hv hcomplete A hA hA₀
  obtain ⟨y, rfl⟩ : ∃ y, Φ (t, y) = x := ⟨Φ.symm (t, x), Φ.apply_mk_symm_apply t x⟩
  rw [velocity_apply, mfderiv_cylinderMap_globalFlowDiffeotopyAlong_time,
    globalFlowDiffeotopyAlong_apply, flowOf_apply]

end Diffeotopy

end Along

/-- Run a complete `C^n` vector field for duration `a`, starting at the identity: the motion along
the time function `t ↦ a t`. The ambient manifold need not be compact, and negative durations are
allowed. -/
def globalFlowDiffeotopy (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : IsCompleteVectorField v) (a : ℝ) :
    Diffeotopy I n M :=
  globalFlowDiffeotopyAlong hn hv hcomplete (a * ·) (contDiff_const.mul contDiff_id) (mul_zero a)

/-- The diffeotopy running a field for duration `a` is its motion along the time function
`t ↦ a t`. -/
theorem globalFlowDiffeotopy_eq_globalFlowDiffeotopyAlong (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : IsCompleteVectorField v) (a : ℝ) :
    globalFlowDiffeotopy hn hv hcomplete a = globalFlowDiffeotopyAlong hn hv hcomplete (a * ·)
      (contDiff_const.mul contDiff_id) (mul_zero a) :=
  (rfl)

/-- The motion is the maximal integral curve of the field at the rescaled time. -/
@[simp] theorem globalFlowDiffeotopy_apply (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : IsCompleteVectorField v)
    (a : ℝ) (p : unitInterval × M) :
    globalFlowDiffeotopy hn hv hcomplete a p =
      maximalIntegralCurve v p.2 (a * p.1) :=
  globalFlowDiffeotopyAlong_apply hn hv hcomplete _ _ _ p

/-- The inverse motion runs the same field for the opposite duration. -/
@[simp] theorem globalFlowDiffeotopy_toDiffeomorph_symm_apply (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : IsCompleteVectorField v)
    (a : ℝ) (p : unitInterval × M) :
    (globalFlowDiffeotopy hn hv hcomplete a).toDiffeomorph.symm p =
      (p.1, maximalIntegralCurve v p.2 (-(a * p.1))) :=
  globalFlowDiffeotopyAlong_toDiffeomorph_symm_apply hn hv hcomplete _ _ _ p

/-- Every zero of the generating field is fixed throughout the diffeotopy. -/
theorem globalFlowDiffeotopy_apply_of_eq_zero (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : IsCompleteVectorField v) (a : ℝ)
    {x : M} (hx : v x = 0) (t : unitInterval) :
    globalFlowDiffeotopy hn hv hcomplete a (t, x) = x :=
  globalFlowDiffeotopyAlong_apply_of_eq_zero hn hv hcomplete _ _ _ hx t

namespace Diffeotopy

/-- The time-`t` map of the diffeotopy generated by a complete vector field is the flow of the
field for time `a t`. -/
theorem timeSlice_globalFlowDiffeotopy (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : IsCompleteVectorField v) (a : ℝ) (t : unitInterval) :
    ⇑((globalFlowDiffeotopy hn hv hcomplete a).timeSlice t) = flowOf v (a * t) :=
  timeSlice_globalFlowDiffeotopyAlong hn hv hcomplete _ _ _ t

/-- The motion of the diffeotopy generated by a complete vector field, read on the cylinder: at
`(x, t)` it is the flow of the field for time `a t`. -/
theorem cylinderMap_globalFlowDiffeotopy (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : IsCompleteVectorField v) (a : ℝ) :
    (globalFlowDiffeotopy hn hv hcomplete a).cylinderMap =
      fun p : M × unitInterval ↦ flowOf v (a * p.2) p.1 :=
  cylinderMap_globalFlowDiffeotopyAlong hn hv hcomplete _ _ _

/-- **The velocity of the flow diffeotopy.** The motion `(x, t) ↦ ψ_(a t) x` of the diffeotopy
generated by a complete vector field `v` sends the unit time vector `∂ₜ` at `(x, t)` to
`a v (ψ_(a t) x)`. -/
theorem mfderiv_cylinderMap_globalFlowDiffeotopy_time (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : IsCompleteVectorField v) (a : ℝ) (p : M × unitInterval) :
    mfderiv (I.prod (𝓡∂ 1)) I (globalFlowDiffeotopy hn hv hcomplete a).cylinderMap p
      ((0 : E), (1 : TangentSpace (𝓡∂ 1) p.2)) = a • v (flowOf v (a * p.2) p.1) := by
  rw [globalFlowDiffeotopy_eq_globalFlowDiffeotopyAlong,
    mfderiv_cylinderMap_globalFlowDiffeotopyAlong_time]
  congr 1
  simp

/-- The motion `(x, t) ↦ ψ_(a t) x` of the diffeotopy generated by a complete vector field acts
on spatial tangent vectors at `(x, t)` by the differential of the time-`a t` map `ψ_(a t)`. -/
theorem mfderiv_cylinderMap_globalFlowDiffeotopy_space (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : IsCompleteVectorField v) (a : ℝ) (p : M × unitInterval) (w : E) :
    mfderiv (I.prod (𝓡∂ 1)) I (globalFlowDiffeotopy hn hv hcomplete a).cylinderMap p
      (w, (0 : EuclideanSpace ℝ (Fin 1))) = mfderiv I I (flowOf v (a * p.2)) p.1 w :=
  mfderiv_cylinderMap_globalFlowDiffeotopyAlong_space hn hv hcomplete _ _ _ p w

/-- **The velocity field of the flow diffeotopy.** The diffeotopy which runs a complete vector field
`v` for duration `a` has the time-independent velocity field `a v`. -/
@[simp]
theorem velocity_globalFlowDiffeotopy (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hcomplete : IsCompleteVectorField v) (a : ℝ) (t : unitInterval) (x : M) :
    (globalFlowDiffeotopy hn hv hcomplete a).velocity t x = a • v x := by
  rw [globalFlowDiffeotopy_eq_globalFlowDiffeotopyAlong, velocity_globalFlowDiffeotopyAlong]
  congr 1
  simp

end Diffeotopy

/-- Run a compactly supported `C^n` vector field for duration `a`, starting at the identity.
The ambient manifold need not be compact, and negative durations are allowed. -/
def compactlySupportedFlowDiffeotopy (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hK : IsCompact K) (hzero : ∀ y ∉ K, v y = 0) (a : ℝ) : Diffeotopy I n M :=
  globalFlowDiffeotopy hn hv
    (isCompleteVectorField_of_isCompact_of_eq_zero_off (hv.of_le (by exact_mod_cast hn)) hK
      hzero) a

/-- The compactly supported motion is the maximal integral curve at the rescaled time. -/
@[simp] theorem compactlySupportedFlowDiffeotopy_apply (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hK : IsCompact K) (hzero : ∀ y ∉ K, v y = 0) (a : ℝ) (p : unitInterval × M) :
    compactlySupportedFlowDiffeotopy hn hv hK hzero a p =
      maximalIntegralCurve v p.2 (a * p.1) := by
  simp [compactlySupportedFlowDiffeotopy]

/-- The inverse compactly supported motion runs the field for the opposite duration. -/
@[simp] theorem compactlySupportedFlowDiffeotopy_toDiffeomorph_symm_apply (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hK : IsCompact K) (hzero : ∀ y ∉ K, v y = 0) (a : ℝ) (p : unitInterval × M) :
    (compactlySupportedFlowDiffeotopy hn hv hK hzero a).toDiffeomorph.symm p =
      (p.1, maximalIntegralCurve v p.2 (-(a * p.1))) := by
  simp [compactlySupportedFlowDiffeotopy]

/-- Every zero of a compactly supported generating field is fixed throughout the motion. -/
theorem compactlySupportedFlowDiffeotopy_apply_of_eq_zero (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hK : IsCompact K) (hzero : ∀ y ∉ K, v y = 0) (a : ℝ)
    {x : M} (hx : v x = 0) (t : unitInterval) :
    compactlySupportedFlowDiffeotopy hn hv hK hzero a (t, x) = x := by
  rw [compactlySupportedFlowDiffeotopy]
  exact globalFlowDiffeotopy_apply_of_eq_zero hn hv _ a hx t

/-- The entire motion fixes the complement of the prescribed compact support set. -/
theorem compactlySupportedFlowDiffeotopy_eqOn_compl (hn : 1 ≤ n)
    (hv : CMDiff n (fun y ↦ (⟨y, v y⟩ : TangentBundle I M)))
    (hK : IsCompact K) (hzero : ∀ y ∉ K, v y = 0) (a : ℝ) (t : unitInterval) :
    EqOn (fun x => compactlySupportedFlowDiffeotopy hn hv hK hzero a (t, x)) id Kᶜ :=
  fun x hx => compactlySupportedFlowDiffeotopy_apply_of_eq_zero hn hv hK hzero a
    (hzero x hx) t

/-! ### Time-dependent vector fields -/

section TimeDependent

variable {X : ℝ → (x : M) → TangentSpace I x}

/-- Run a time-dependent `C^n` vector field with complete suspension, `1 ≤ n`, from time `0`: the
motion at time `t ∈ [0, 1]` is the time-dependent flow of `X` from time `0` to time `t`. -/
def timeDependentFlowDiffeotopy (hn : 1 ≤ n)
    (hX : ContMDiff (𝓘(ℝ, ℝ).prod I) I.tangent n
      (fun p : ℝ × M ↦ (⟨p.2, X p.1 p.2⟩ : TangentBundle I M)))
    (hcomplete : IsCompleteVectorField (timeDependentSuspensionField X)) :
    Diffeotopy I n M := by
  have hX₁ := hX.of_le (m := 1) (by exact_mod_cast hn)
  have hs := contMDiff_timeDependentFlowOf hcomplete hn hX
  have ht : ContMDiff (𝓡∂ 1) 𝓘(ℝ) n (fun t : unitInterval => (t : ℝ)) :=
    contMDiff_subtypeVal_Icc
  exact
    { toDiffeomorph :=
        { toEquiv :=
            { toFun := fun p => (p.1, timeDependentFlowOf X 0 p.1 p.2)
              invFun := fun p => (p.1, timeDependentFlowOf X p.1 0 p.2)
              left_inv := fun p => by
                simp [timeDependentFlowOf_trans hcomplete hX₁, timeDependentFlowOf_self]
              right_inv := fun p => by
                simp [timeDependentFlowOf_trans hcomplete hX₁, timeDependentFlowOf_self] }
          contMDiff_toFun := contMDiff_fst.prodMk (hs.comp
            ((contMDiff_const.prodMk (ht.comp contMDiff_fst)).prodMk contMDiff_snd))
          contMDiff_invFun := contMDiff_fst.prodMk (hs.comp
            (((ht.comp contMDiff_fst).prodMk contMDiff_const).prodMk contMDiff_snd)) }
      fst_apply := fun _ => rfl
      snd_apply_zero' := fun x => timeDependentFlowOf_self X 0 x }

variable (hn : 1 ≤ n)
  (hX : ContMDiff (𝓘(ℝ, ℝ).prod I) I.tangent n
    (fun p : ℝ × M ↦ (⟨p.2, X p.1 p.2⟩ : TangentBundle I M)))
  (hcomplete : IsCompleteVectorField (timeDependentSuspensionField X))

/-- The time-dependent motion at time `t` is the time-dependent flow from `0` to `t`. -/
@[simp] theorem timeDependentFlowDiffeotopy_apply (p : unitInterval × M) :
    timeDependentFlowDiffeotopy hn hX hcomplete p = timeDependentFlowOf X 0 p.1 p.2 :=
  (rfl)

/-- The inverse time-dependent motion at time `t` is the time-dependent flow from `t` back
to `0`. -/
@[simp] theorem timeDependentFlowDiffeotopy_toDiffeomorph_symm_apply (p : unitInterval × M) :
    (timeDependentFlowDiffeotopy hn hX hcomplete).toDiffeomorph.symm p =
      (p.1, timeDependentFlowOf X p.1 0 p.2) :=
  (rfl)

/-- A point at which the field vanishes at all times is fixed throughout the time-dependent
motion. -/
theorem timeDependentFlowDiffeotopy_apply_of_forall_eq_zero {x : M} (hx : ∀ u, X u x = 0)
    (t : unitInterval) : timeDependentFlowDiffeotopy hn hX hcomplete (t, x) = x :=
  timeDependentFlowOf_eq_self_of_forall_eq_zero (hX.of_le (by exact_mod_cast hn)) hx 0 t

namespace Diffeotopy

/-- The motion of the time-dependent diffeotopy, read on the cylinder: at `(x, t)` it is the
time-dependent flow of the field from time `0` to time `t`. -/
theorem cylinderMap_timeDependentFlowDiffeotopy :
    (timeDependentFlowDiffeotopy hn hX hcomplete).cylinderMap =
      fun p : M × unitInterval ↦ timeDependentFlowOf X 0 p.2 p.1 :=
  funext fun p ↦ by rw [cylinderMap_apply, timeDependentFlowDiffeotopy_apply]

/-- **The velocity of the time-dependent diffeotopy.** The motion `(x, t) ↦ φ_{0, t} x` of the
diffeotopy generated by a time-dependent field `X` sends the unit time vector `∂ₜ` at `(x, t)` to
`X t (φ_{0, t} x)`. -/
theorem mfderiv_cylinderMap_timeDependentFlowDiffeotopy_time (p : M × unitInterval) :
    mfderiv (I.prod (𝓡∂ 1)) I (timeDependentFlowDiffeotopy hn hX hcomplete).cylinderMap p
      ((0 : E), (1 : TangentSpace (𝓡∂ 1) p.2)) =
        X p.2 ((timeDependentFlowDiffeotopy hn hX hcomplete).cylinderMap p) := by
  have hX₁ := hX.of_le (m := 1) (by exact_mod_cast hn)
  have hval : MDifferentiableAt (𝓡∂ 1) 𝓘(ℝ) (Subtype.val : unitInterval → ℝ) p.2 :=
    (contMDiff_subtypeVal_Icc (n := 1)).mdifferentiableAt one_ne_zero
  have htraj := hasMFDerivAt_timeDependentFlowOf hX₁
    (mem_timeDependentFlowDomain.2 (hcomplete.mem_flowDomain _ _)) (s := 0) (t := p.2) (x := p.1)
  -- The trajectory `t ↦ φ_{0, t} x` has velocity `X t`, and the inclusion of the interval sends
  -- `∂ₜ` to `1`.
  have htime : mfderiv (𝓡∂ 1) I (fun z : unitInterval ↦ timeDependentFlowOf X 0 z p.1) p.2
      (1 : TangentSpace (𝓡∂ 1) p.2) = X p.2 (timeDependentFlowOf X 0 p.2 p.1) := by
    have hcomp : (fun z : unitInterval ↦ timeDependentFlowOf X 0 z p.1) =
        (fun s ↦ timeDependentFlowOf X 0 s p.1) ∘ Subtype.val := rfl
    rw [hcomp, mfderiv_comp p.2 htraj.mdifferentiableAt hval, ContinuousLinearMap.comp_apply,
      mfderiv_subtypeVal_Icc_one, htraj.mfderiv]
    exact one_smul ℝ _
  refine (mfderiv_prod_eq_add_apply ((timeDependentFlowDiffeotopy hn hX
    hcomplete).contMDiff_cylinderMap.mdifferentiableAt
      (zero_lt_one.trans_le (by exact_mod_cast hn)).ne')).trans ?_
  rw [cylinderMap_timeDependentFlowDiffeotopy]
  exact (congrArg₂ (· + ·) (map_zero _) htime).trans (zero_add _)

end Diffeotopy

