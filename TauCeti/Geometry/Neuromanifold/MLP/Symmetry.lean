module

public import TauCeti.Geometry.Neuromanifold.Basic
public import TauCeti.Geometry.Neuromanifold.MLP.Basic

/-!
# Hidden-neuron symmetries of MLPs

For an MLP specification `A` of depth `L + 1`, the hidden layers are indexed by `i : Fin L`:
hidden layer `i + 1` is produced by the weights `Wᵢ₊₁` at `i.castSucc` and consumed by the
weights `Wᵢ₊₂` at `i.succ`. Two transformations of bias-free weights act on one hidden layer
and leave all other weights unchanged.

* `MLPSpec.permuteHidden A i σ` relabels the neurons of hidden layer `i + 1` by a permutation
  `σ`: it replaces `Wᵢ₊₁` by `P Wᵢ₊₁` and `Wᵢ₊₂` by `Wᵢ₊₂ P⁻¹`, where `P` is the
  permutation matrix of `σ`. These are `Matrix.submatrix` reindexings; Mathlib's
  `PEquiv.toMatrix_toPEquiv_mul` and `PEquiv.mul_toMatrix_toPEquiv` identify them with
  the matrix products. It preserves the realization for every choice of activations.
* `MLPSpec.scaleHidden A i e c` rescales the neurons of hidden layer `i + 1` by units `c`:
  it replaces `Wᵢ₊₁` by `D Wᵢ₊₁` and `Wᵢ₊₂` by `Wᵢ₊₂ D⁻ᵉ`, where `D` is the invertible diagonal
  matrix with entries `c` and the power is taken entrywise. It preserves the realization when
  the activation of that hidden layer is `t ↦ t ^ e`.

The width of hidden layer `i + 1` is written both `A.width i.castSucc.succ` and
`A.width i.succ.castSucc`. These are the same index by definition (`Fin.castSucc_succ` is
`rfl`), so one permutation or scaling acts on the rows of `Wᵢ₊₁` and the columns of `Wᵢ₊₂`.

Both come with their identity, composition, and inverse laws. Given exponents `e`,
`MLPSpec.hiddenSymmetrySetoid A e` is the equivalence relation on bias-free weights generated by
all permutations and by the scalings of hidden layer `i + 1` with exponent `e i`. When every
hidden activation is `t ↦ t ^ e i`, as for `MLPSpec.monomial d e`, its classes lie in the
realization fibres. No converse is asserted. Identifiability modulo these symmetries is
`IdentifiableAt` from `TauCeti.Geometry.Neuromanifold.Basic`. A one-layer network has no
hidden neurons and is identifiable at every parameter.

## References

* Bella Finkel, Jose Israel Rodriguez, Chenxi Wu, and Thomas Yahl, *Activation degree
  thresholds and expressiveness of polynomial neural networks*,
  [arXiv:2408.04569v4](https://arxiv.org/abs/2408.04569v4), Lemma 4 and equation (6).
-/

public section

open Matrix

namespace TauCeti.Neuromanifold

namespace MLPSpec

variable {K : Type*} {L : ℕ}

/-! ### Permutations of hidden neurons -/

/-- Relabel the neurons of hidden layer `i + 1` by `σ`: the rows of `Wᵢ₊₁` and the columns of
`Wᵢ₊₂` are permuted by `σ`, and all other weights are unchanged. -/
def permuteHidden (A : MLPSpec K (L + 1)) (i : Fin L)
    (σ : Equiv.Perm (Fin (A.width i.castSucc.succ))) (w : A.Weights) : A.Weights :=
  Function.update (Function.update w i.castSucc ((w i.castSucc).submatrix σ id)) i.succ
    ((w i.succ).submatrix id σ)

/-- A permutation of hidden layer `i + 1` permutes the rows of `Wᵢ₊₁`. -/
@[simp]
theorem permuteHidden_apply_castSucc (A : MLPSpec K (L + 1)) (i : Fin L)
    (σ : Equiv.Perm (Fin (A.width i.castSucc.succ))) (w : A.Weights) :
    A.permuteHidden i σ w i.castSucc = (w i.castSucc).submatrix σ id := by
  rw [permuteHidden, Function.update_of_ne Fin.castSucc_lt_succ.ne, Function.update_self]

/-- A permutation of hidden layer `i + 1` permutes the columns of `Wᵢ₊₂`. -/
@[simp]
theorem permuteHidden_apply_succ (A : MLPSpec K (L + 1)) (i : Fin L)
    (σ : Equiv.Perm (Fin (A.width i.castSucc.succ))) (w : A.Weights) :
    A.permuteHidden i σ w i.succ = (w i.succ).submatrix id σ :=
  Function.update_self ..

/-- A permutation of hidden layer `i + 1` leaves the other weights unchanged. -/
theorem permuteHidden_apply_of_ne (A : MLPSpec K (L + 1)) (i : Fin L)
    (σ : Equiv.Perm (Fin (A.width i.castSucc.succ))) (w : A.Weights) {j : Fin (L + 1)}
    (h₁ : j ≠ i.castSucc) (h₂ : j ≠ i.succ) : A.permuteHidden i σ w j = w j := by
  rw [permuteHidden, Function.update_of_ne h₂, Function.update_of_ne h₁]

/-- The identity permutation acts trivially. -/
@[simp]
theorem permuteHidden_one (A : MLPSpec K (L + 1)) (i : Fin L) (w : A.Weights) :
    A.permuteHidden i 1 w = w := by
  simp [permuteHidden]

/-- Permuting by `σ` and then by `τ` is permuting by `σ * τ`. -/
@[simp]
theorem permuteHidden_permuteHidden (A : MLPSpec K (L + 1)) (i : Fin L)
    (σ τ : Equiv.Perm (Fin (A.width i.castSucc.succ))) (w : A.Weights) :
    A.permuteHidden i τ (A.permuteHidden i σ w) = A.permuteHidden i (σ * τ) w := by
  funext j
  by_cases h₁ : j = i.castSucc
  · subst h₁
    simp [Function.comp_def]
  by_cases h₂ : j = i.succ
  · subst h₂
    simp [Function.comp_def]
  simp only [permuteHidden_apply_of_ne _ _ _ _ h₁ h₂]

/-- Permuting by `σ⁻¹` undoes permuting by `σ`. -/
theorem permuteHidden_inv_permuteHidden (A : MLPSpec K (L + 1)) (i : Fin L)
    (σ : Equiv.Perm (Fin (A.width i.castSucc.succ))) (w : A.Weights) :
    A.permuteHidden i σ⁻¹ (A.permuteHidden i σ w) = w := by
  simp

/-- Permuting by `σ` undoes permuting by `σ⁻¹`. -/
theorem permuteHidden_permuteHidden_inv (A : MLPSpec K (L + 1)) (i : Fin L)
    (σ : Equiv.Perm (Fin (A.width i.castSucc.succ))) (w : A.Weights) :
    A.permuteHidden i σ (A.permuteHidden i σ⁻¹ w) = w := by
  simp

/-! ### Realization of hidden-neuron transformations -/

section Weights

variable [NonUnitalNonAssocSemiring K]

/-- Two bias-free weight tuples that differ only at the two layers around hidden layer `i + 1`
realize the same function once the pre-activations of the following layer agree. -/
private theorem realizeWeights_eq_of_mulVec_evalPrefix_eq (A : MLPSpec K (L + 1))
    {w w' : A.Weights} (i : Fin L) (hw : ∀ j, j ≠ i.castSucc → j ≠ i.succ → w' j = w j)
    (hpre : ∀ x, w' i.succ *ᵥ A.evalPrefix (A.zeroBias w') x i.castSucc.succ =
      w i.succ *ᵥ A.evalPrefix (A.zeroBias w) x i.castSucc.succ) :
    A.realizeWeights w' = A.realizeWeights w := by
  funext x
  rw [realizeWeights_def, Function.comp_apply, Function.comp_apply, realize_def, realize_def]
  refine A.evalPrefix_congr_of_le (k := i.succ.succ) ?_ (fun j hj => ?_) (Fin.le_last _)
  · rw [evalPrefix_succ, evalPrefix_succ]
    simp only [zeroBias_apply, Pi.zero_apply, add_zero]
    exact funext fun j => congrArg _ (congrFun (hpre x) j)
  · rw [zeroBias_apply, zeroBias_apply, hw j]
    all_goals
      intro hji
      subst hji
      simp only [Fin.le_def, Fin.val_succ, Fin.val_castSucc] at hj
      omega

/-- Changing only the weights at or above layer `i + 1` leaves the prefix at layer `i + 1`
determined by the new weights `Wᵢ₊₁` alone. -/
private theorem evalPrefix_castSucc_succ (A : MLPSpec K (L + 1)) {w w' : A.Weights}
    (i : Fin L) (hw : ∀ j, j ≠ i.castSucc → j ≠ i.succ → w' j = w j)
    (x : Fin (A.width 0) → K) :
    A.evalPrefix (A.zeroBias w') x i.castSucc.succ =
      fun j => A.activation i ((w' i.castSucc *ᵥ A.evalPrefix (A.zeroBias w) x
        i.castSucc.castSucc) j) := by
  rw [evalPrefix_succ, A.evalPrefix_congr (θ' := A.zeroBias w) x i.castSucc.castSucc
    fun j hj => ?_]
  · simp
  · rw [zeroBias_apply, zeroBias_apply, hw j]
    all_goals
      intro hji
      subst hji
      simp [Fin.lt_def] at hj

/-- After a permutation of hidden layer `i + 1`, that hidden layer is permuted by `σ`. -/
theorem evalPrefix_zeroBias_permuteHidden (A : MLPSpec K (L + 1)) (i : Fin L)
    (σ : Equiv.Perm (Fin (A.width i.castSucc.succ))) (w : A.Weights)
    (x : Fin (A.width 0) → K) :
    A.evalPrefix (A.zeroBias (A.permuteHidden i σ w)) x i.castSucc.succ =
      A.evalPrefix (A.zeroBias w) x i.castSucc.succ ∘ σ := by
  rw [evalPrefix_castSucc_succ A i (fun j => permuteHidden_apply_of_ne A i σ w) x,
    permuteHidden_apply_castSucc, evalPrefix_succ]
  ext j
  simp [mulVec, dotProduct]

/-- Permuting the neurons of a hidden layer preserves the bias-free realization, for every
choice of activations. -/
@[simp]
theorem realizeWeights_permuteHidden (A : MLPSpec K (L + 1)) (i : Fin L)
    (σ : Equiv.Perm (Fin (A.width i.castSucc.succ))) (w : A.Weights) :
    A.realizeWeights (A.permuteHidden i σ w) = A.realizeWeights w := by
  refine realizeWeights_eq_of_mulVec_evalPrefix_eq A i
    (fun j => permuteHidden_apply_of_ne A i σ w) fun x => ?_
  rw [evalPrefix_zeroBias_permuteHidden, permuteHidden_apply_succ, submatrix_mulVec_equiv]
  simp [Function.comp_assoc]

end Weights

/-! ### Scalings of hidden neurons -/

section Scaling

variable [CommSemiring K]

/-- Rescale the neurons of hidden layer `i + 1` by the units `c`, compensating for an
activation `t ↦ t ^ e`: `Wᵢ₊₁` becomes `D Wᵢ₊₁` and `Wᵢ₊₂` becomes `Wᵢ₊₂ D⁻ᵉ`, where `D` is the
diagonal matrix with entries `c`. All other weights are unchanged. -/
def scaleHidden (A : MLPSpec K (L + 1)) (i : Fin L) (e : ℕ)
    (c : Fin (A.width i.castSucc.succ) → Kˣ) (w : A.Weights) : A.Weights :=
  Function.update
    (Function.update w i.castSucc (diagonal (fun j => (c j : K)) * w i.castSucc)) i.succ
    (w i.succ * diagonal (fun j : Fin (A.width i.succ.castSucc) => (((c j)⁻¹ ^ e : Kˣ) : K)))

/-- A scaling of hidden layer `i + 1` multiplies `Wᵢ₊₁` on the left by `D`. -/
@[simp]
theorem scaleHidden_apply_castSucc (A : MLPSpec K (L + 1)) (i : Fin L) (e : ℕ)
    (c : Fin (A.width i.castSucc.succ) → Kˣ) (w : A.Weights) :
    A.scaleHidden i e c w i.castSucc = diagonal (fun j => (c j : K)) * w i.castSucc := by
  rw [scaleHidden, Function.update_of_ne Fin.castSucc_lt_succ.ne, Function.update_self]

/-- A scaling of hidden layer `i + 1` multiplies `Wᵢ₊₂` on the right by `D⁻ᵉ`. -/
@[simp]
theorem scaleHidden_apply_succ (A : MLPSpec K (L + 1)) (i : Fin L) (e : ℕ)
    (c : Fin (A.width i.castSucc.succ) → Kˣ) (w : A.Weights) :
    A.scaleHidden i e c w i.succ =
      w i.succ * diagonal (fun j : Fin (A.width i.succ.castSucc) => (((c j)⁻¹ ^ e : Kˣ) : K)) :=
  Function.update_self ..

/-- A scaling of hidden layer `i + 1` leaves the other weights unchanged. -/
theorem scaleHidden_apply_of_ne (A : MLPSpec K (L + 1)) (i : Fin L) (e : ℕ)
    (c : Fin (A.width i.castSucc.succ) → Kˣ) (w : A.Weights) {j : Fin (L + 1)}
    (h₁ : j ≠ i.castSucc) (h₂ : j ≠ i.succ) : A.scaleHidden i e c w j = w j := by
  rw [scaleHidden, Function.update_of_ne h₂, Function.update_of_ne h₁]

/-- Scaling by the unit vector `1` acts trivially. -/
@[simp]
theorem scaleHidden_one (A : MLPSpec K (L + 1)) (i : Fin L) (e : ℕ) (w : A.Weights) :
    A.scaleHidden i e 1 w = w := by
  simp [scaleHidden]

/-- Scaling by `c` and then by `c'` is scaling by `c' * c`. -/
@[simp]
theorem scaleHidden_scaleHidden (A : MLPSpec K (L + 1)) (i : Fin L) (e : ℕ)
    (c c' : Fin (A.width i.castSucc.succ) → Kˣ) (w : A.Weights) :
    A.scaleHidden i e c' (A.scaleHidden i e c w) = A.scaleHidden i e (c' * c) w := by
  funext j
  by_cases h₁ : j = i.castSucc
  · subst h₁
    simp [← Matrix.mul_assoc, diagonal_mul_diagonal]
  by_cases h₂ : j = i.succ
  · subst h₂
    simp [Matrix.mul_assoc, diagonal_mul_diagonal, mul_comm, mul_pow]
  simp only [scaleHidden_apply_of_ne _ _ _ _ _ h₁ h₂]

/-- Scaling by `c⁻¹` undoes scaling by `c`. -/
theorem scaleHidden_inv_scaleHidden (A : MLPSpec K (L + 1)) (i : Fin L) (e : ℕ)
    (c : Fin (A.width i.castSucc.succ) → Kˣ) (w : A.Weights) :
    A.scaleHidden i e c⁻¹ (A.scaleHidden i e c w) = w := by
  simp

/-- Scaling by `c` undoes scaling by `c⁻¹`. -/
theorem scaleHidden_scaleHidden_inv (A : MLPSpec K (L + 1)) (i : Fin L) (e : ℕ)
    (c : Fin (A.width i.castSucc.succ) → Kˣ) (w : A.Weights) :
    A.scaleHidden i e c (A.scaleHidden i e c⁻¹ w) = w := by
  simp

/-- After a scaling of hidden layer `i + 1` whose activation is `t ↦ t ^ e`, that hidden layer
is multiplied coordinatewise by `cᵉ`. -/
theorem evalPrefix_zeroBias_scaleHidden (A : MLPSpec K (L + 1)) (i : Fin L) {e : ℕ}
    (he : ∀ t, A.activation i t = t ^ e) (c : Fin (A.width i.castSucc.succ) → Kˣ)
    (w : A.Weights) (x : Fin (A.width 0) → K) :
    A.evalPrefix (A.zeroBias (A.scaleHidden i e c w)) x i.castSucc.succ =
      fun j => (c j : K) ^ e * A.evalPrefix (A.zeroBias w) x i.castSucc.succ j := by
  rw [evalPrefix_castSucc_succ A i (fun j => scaleHidden_apply_of_ne A i e c w) x,
    scaleHidden_apply_castSucc, evalPrefix_succ]
  ext j
  simp [he, ← mulVec_mulVec, mulVec_diagonal, mul_pow]

/-- Rescaling the neurons of a hidden layer whose activation is `t ↦ t ^ e`, with the
compensating power on the next layer, preserves the bias-free realization. -/
theorem realizeWeights_scaleHidden (A : MLPSpec K (L + 1)) (i : Fin L) {e : ℕ}
    (he : ∀ t, A.activation i t = t ^ e) (c : Fin (A.width i.castSucc.succ) → Kˣ)
    (w : A.Weights) :
    A.realizeWeights (A.scaleHidden i e c w) = A.realizeWeights w := by
  refine realizeWeights_eq_of_mulVec_evalPrefix_eq A i
    (fun j => scaleHidden_apply_of_ne A i e c w) fun x => ?_
  rw [evalPrefix_zeroBias_scaleHidden A i he, scaleHidden_apply_succ, ← mulVec_mulVec]
  congr 1
  ext j
  simp [mulVec_diagonal, ← mul_assoc, ← mul_pow]

/-! ### The hidden-neuron symmetry equivalence -/

/-- The hidden-neuron symmetry relation with exponents `e`: the equivalence relation on
bias-free weights generated by permuting the neurons of any hidden layer, and by rescaling the
neurons of hidden layer `i + 1` with the compensating power `e i`. For the monomial
specification `MLPSpec.monomial d r` the exponents are `r`. -/
def hiddenSymmetrySetoid (A : MLPSpec K (L + 1)) (e : Fin L → ℕ) : Setoid A.Weights :=
  Relation.EqvGen.setoid fun w v =>
    (∃ i σ, v = A.permuteHidden i σ w) ∨ ∃ i c, v = A.scaleHidden i (e i) c w

/-- A permutation of hidden neurons is a hidden-neuron symmetry. -/
theorem hiddenSymmetrySetoid_permuteHidden (A : MLPSpec K (L + 1)) (e : Fin L → ℕ) (i : Fin L)
    (σ : Equiv.Perm (Fin (A.width i.castSucc.succ))) (w : A.Weights) :
    A.hiddenSymmetrySetoid e w (A.permuteHidden i σ w) :=
  Relation.EqvGen.rel _ _ (.inl ⟨i, σ, rfl⟩)

/-- A rescaling of hidden neurons with the compensating power `e i` is a hidden-neuron
symmetry. -/
theorem hiddenSymmetrySetoid_scaleHidden (A : MLPSpec K (L + 1)) (e : Fin L → ℕ) (i : Fin L)
    (c : Fin (A.width i.castSucc.succ) → Kˣ) (w : A.Weights) :
    A.hiddenSymmetrySetoid e w (A.scaleHidden i (e i) c w) :=
  Relation.EqvGen.rel _ _ (.inr ⟨i, c, rfl⟩)

/-- The hidden-neuron symmetry relation is the smallest equivalence relation relating every
weight tuple to its permutations and rescalings of hidden neurons. -/
theorem hiddenSymmetrySetoid_le_iff (A : MLPSpec K (L + 1)) (e : Fin L → ℕ)
    {s : Setoid A.Weights} :
    A.hiddenSymmetrySetoid e ≤ s ↔
      (∀ i σ w, s w (A.permuteHidden i σ w)) ∧ ∀ i c w, s w (A.scaleHidden i (e i) c w) := by
  refine ⟨fun h => ⟨fun i σ w => h (A.hiddenSymmetrySetoid_permuteHidden e i σ w),
    fun i c w => h (A.hiddenSymmetrySetoid_scaleHidden e i c w)⟩, fun ⟨hp, hs⟩ => ?_⟩
  refine Setoid.eqvGen_le fun w v hwv => ?_
  rcases hwv with ⟨i, σ, rfl⟩ | ⟨i, c, rfl⟩
  exacts [hp i σ w, hs i c w]

/-- When hidden layer `i + 1` has activation `t ↦ t ^ e i` for every `i`, as for
`MLPSpec.monomial`, hidden-neuron symmetries preserve the bias-free realization: each symmetry
class lies in a realization fibre. -/
theorem hiddenSymmetrySetoid_le_parameterSetoid (A : MLPSpec K (L + 1)) {e : Fin L → ℕ}
    (he : ∀ i t, A.activation i t = t ^ e i) :
    A.hiddenSymmetrySetoid e ≤ parameterSetoid A.realizeWeights :=
  (A.hiddenSymmetrySetoid_le_iff e).2
    ⟨fun i σ w => (parameterSetoid_iff _ _ _).2 (A.realizeWeights_permuteHidden i σ w).symm,
      fun i c w => (parameterSetoid_iff _ _ _).2 (A.realizeWeights_scaleHidden i (he i) c w).symm⟩

/-- The hidden-neuron symmetries of a monomial MLP preserve its bias-free realization. -/
theorem monomial_hiddenSymmetrySetoid_le_parameterSetoid (d : Fin (L + 2) → ℕ)
    (r : Fin L → ℕ) :
    (monomial d r : MLPSpec K (L + 1)).hiddenSymmetrySetoid r ≤
      parameterSetoid (monomial d r : MLPSpec K (L + 1)).realizeWeights :=
  hiddenSymmetrySetoid_le_parameterSetoid _ (monomial_activation d r)

/-- An MLP with one layer has no hidden neurons, and is identifiable modulo hidden-neuron
symmetries at every parameter: its bias-free realization `x ↦ W₁ x` determines `W₁`. -/
theorem identifiableAt_hiddenSymmetrySetoid_of_depth_one (A : MLPSpec K 1) (e : Fin 0 → ℕ)
    (w : A.Weights) : IdentifiableAt A.realizeWeights (A.hiddenSymmetrySetoid e) w := by
  refine (identifiableAt_iff_fiber_subset
    (A.hiddenSymmetrySetoid_le_parameterSetoid fun i => i.elim0)).2 fun v hv => ?_
  have h0 : v 0 = w 0 := mulVec_injective (funext fun x => by
    simpa using congrFun ((mem_fiber _ _ _).1 hv) x)
  have hvw : v = w := funext fun j => by rwa [Subsingleton.elim (α := Fin 1) j 0]
  exact hvw ▸ (A.hiddenSymmetrySetoid e).refl v

end Scaling

end MLPSpec

end TauCeti.Neuromanifold
