module

public import TauCeti.Topology.Instances.AddCircle.Cover
public import TauCeti.Geometry.Manifold.Instances.AddCircle
public import TauCeti.Geometry.Manifold.LocalDiffeomorph.Basic

/-!
# Covering maps between circles

When the period `p` is an integer multiple of the period `q`, the classes modulo `p` refine the
classes modulo `q`, so reducing modulo `q` descends to an additive map

`AddCircle p → AddCircle q`, `[t]_p ↦ [t]_q`

(`AddCircle.coverMap`). For positive periods `p` and `q` with `p = k q` and `k` a positive integer,
it is the covering of a circle by a circle of `k` times its length: its kernel is the cyclic group
of order `k` generated by the class of `q`
(`AddCircle.ker_coverMap`, `AddCircle.natCard_ker_coverMap`).

For positive periods `p` and `q`, read in the charts of the two circles, which are local real lifts,
the covering map is the identity of `ℝ`. So it is analytic, has derivative the identity of `ℝ`
at every point, and is an analytic
local diffeomorphism, hence a covering map since `AddCircle p` is compact. These are the facts
used when a periodic curve parametrized by `AddCircle q` is traversed several times, as a curve
parametrized by the longer circle `AddCircle p`. Its pullback of the time form and its orientation
behaviour are recorded with the time form (`AddCircle.mpullback_coverMap_timeForm`) and the
orientation of the circle (`AddCircle.isOrientationPreservingAt_coverMap`).

## Main definitions

* `AddCircle.coverMap h`: for `h : p ∈ AddSubgroup.zmultiples q`, the additive covering map
  `AddCircle p → AddCircle q`, `[t]_p ↦ [t]_q`.

## Main results

* `AddCircle.coverMap_coe`, `AddCircle.coverMap_surjective`: the covering map reduces classes
  modulo `q`, and it is surjective.
* `AddCircle.ker_coverMap`, `AddCircle.natCard_ker_coverMap`: its kernel is generated by the class
  of `q`, and has `k` elements when `p = k q` with positive `p` and `k`.
* `AddCircle.contMDiff_coverMap`, `AddCircle.mfderiv_coverMap`,
  `AddCircle.isLocalDiffeomorph_coverMap`: it is analytic, has derivative the identity of `ℝ`,
  and is an analytic local diffeomorphism.
* `AddCircle.isCoveringMap_coverMap`: for positive periods, it is a covering map.
-/

public section

noncomputable section

open scoped Manifold ContDiff

namespace AddCircle

variable {p q : ℝ}

variable (h : p ∈ AddSubgroup.zmultiples q) [Fact (0 < p)] [Fact (0 < q)]

/-- The covering map is analytic. -/
theorem contMDiff_coverMap (n : ℕ∞ω) : ContMDiff 𝓘(ℝ) 𝓘(ℝ) n (coverMap h) :=
  contMDiff_of_comp_coe_eq (coverMap_comp_coe h) contDiff_id

/-- The covering map has derivative the identity of `ℝ` at every point. -/
theorem hasMFDerivAt_coverMap (x : AddCircle p) :
    HasMFDerivAt 𝓘(ℝ) 𝓘(ℝ) (coverMap h) x (ContinuousLinearMap.id ℝ ℝ) := by
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective x
  exact hasMFDerivAt_of_comp_coe_eq (coverMap_comp_coe h) (hasFDerivAt_id t)

/-- The covering map has derivative the identity of `ℝ` at every point. -/
@[simp]
theorem mfderiv_coverMap (x : AddCircle p) :
    mfderiv 𝓘(ℝ) 𝓘(ℝ) (coverMap h) x = ContinuousLinearMap.id ℝ ℝ :=
  (hasMFDerivAt_coverMap h x).mfderiv

/-- The covering map is an analytic local diffeomorphism. -/
theorem isLocalDiffeomorph_coverMap (n : ℕ∞ω) :
    IsLocalDiffeomorph 𝓘(ℝ) 𝓘(ℝ) n (coverMap h) := by
  intro x
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective x
  have hcomp : IsLocalDiffeomorphAt 𝓘(ℝ) 𝓘(ℝ) n (coverMap h ∘ ((↑) : ℝ → AddCircle p)) t := by
    rw [coverMap_comp_coe]
    exact isLocalDiffeomorph_coe q n t
  exact hcomp.of_comp_right (isLocalDiffeomorph_coe p n t)

/-- The covering map `AddCircle p → AddCircle q` is a covering map in the topological sense. -/
theorem isCoveringMap_coverMap : IsCoveringMap (coverMap h) :=
  isLocalHomeomorph_iff_isCoveringMap.mp (isLocalDiffeomorph_coverMap h 1).isLocalHomeomorph

end AddCircle
