module

public import TauCeti.Geometry.Manifold.Complex.StructureSheaf.Germ
public import TauCeti.Geometry.Manifold.Complex.StructureSheaf.NodeLocalRing
import TauCeti.Analysis.Analytic.ConstantOrder.Basic
import TauCeti.Geometry.Manifold.ContMDiff.Analytic

/-!
# The node ring as the analytic local ring of the plane node

The local ring of a node is defined in `TauCeti.holomorphicStructureSheaf.nodeLocalRing` as pairs
of holomorphic germs on the two branches with equal values at the node. This file identifies it,
for the node of the two coordinate axes of `ℂ²`, with the analytic local ring `ℂ{x, y}/(xy)` of
the plane curve `xy = 0`. Here `ℂ{x, y}` is the ring of holomorphic germs at the origin of
`ℂ × ℂ`, the stalk of its holomorphic structure sheaf.

A germ `F` at the origin of `ℂ²` restricts to the germs `z ↦ F (z, 0)` and `w ↦ F (0, w)` on the
two axes, which have the same value `F (0, 0)`. This defines a ring homomorphism
`TauCeti.holomorphicStructureSheaf.nodeLocalRing.ofPlaneGerm` from `ℂ{x, y}` to the node ring
of the points `0 ∈ ℂ` and `0 ∈ ℂ`. It sends the coordinates `x` and `y` to the two branch
coordinates of the node.

* It is surjective: two branch germs `g` and `h` with `g 0 = h 0` are the restrictions of
  `(x, y) ↦ g x + h y - g 0`.
* Its kernel is the principal ideal generated by `xy`
  (`TauCeti.holomorphicStructureSheaf.nodeLocalRing.ker_ofPlaneGerm`): a germ vanishing on both
  axes is `xy` times a holomorphic germ, by dividing first by `y` and then by `x`
  (`AnalyticAt.exists_eventuallyEq_mul_smul`).

Hence `TauCeti.holomorphicStructureSheaf.nodeLocalRing.planeNodeEquiv` is a ring isomorphism
`ℂ{x, y}/(xy) ≃+* nodeLocalRing 𝓘(ℂ) 𝓘(ℂ) 0 0`, so the branch description of the node ring and
its description by the local equation `xy = 0` agree.

## References

* Joel W. Robbin and Dietmar A. Salamon, *A construction of the Deligne–Mumford orbifold*,
  J. Eur. Math. Soc. 8 (2006), 611–699, for nodes as pairs of branches.
* Robert C. Gunning and Hugo Rossi, *Analytic Functions of Several Complex Variables*,
  Chapter II, for the local rings of holomorphic germs in several variables.
-/

public noncomputable section

open CategoryTheory Filter IsManifold Topology
open scoped ContDiff Manifold

namespace TauCeti.holomorphicStructureSheaf

/-- The germ at the origin of a function analytic on all of `ℂ × ℂ`. -/
private def planeGerm (F : ℂ × ℂ → ℂ) (hF : ContMDiff 𝓘(ℂ, ℂ × ℂ) 𝓘(ℂ) ω F) :
    (holomorphicStructureSheaf 𝓘(ℂ, ℂ × ℂ) (ℂ × ℂ)).presheaf.stalk ((0 : ℂ), (0 : ℂ)) :=
  ConcreteCategory.hom
    ((holomorphicStructureSheaf 𝓘(ℂ, ℂ × ℂ) (ℂ × ℂ)).presheaf.germ ⊤ _ trivial)
    (ofContMDiff (fun q : (⊤ : TopologicalSpace.Opens (ℂ × ℂ)) ↦ F q.1)
      (hF.comp contMDiff_subtype_val))

private theorem toFilterGerm_planeGerm (F : ℂ × ℂ → ℂ)
    (hF : ContMDiff 𝓘(ℂ, ℂ × ℂ) 𝓘(ℂ) ω F) :
    toFilterGerm 𝓘(ℂ, ℂ × ℂ) (ℂ × ℂ) _ (𝓝 ((0 : ℂ), (0 : ℂ))) le_rfl (planeGerm F hF) = F := by
  unfold planeGerm
  exact toFilterGerm_germ (U := ⊤) le_rfl trivial _ F fun q ↦ ofContMDiff_apply _ _ q

/-- The germ of the coordinate `x` at the origin of `ℂ²`. -/
def planeFstCoordinate :
    (holomorphicStructureSheaf 𝓘(ℂ, ℂ × ℂ) (ℂ × ℂ)).presheaf.stalk ((0 : ℂ), (0 : ℂ)) :=
  planeGerm Prod.fst (contMDiff_iff_contDiff.2 contDiff_fst)

/-- The germ of the coordinate `y` at the origin of `ℂ²`. -/
def planeSndCoordinate :
    (holomorphicStructureSheaf 𝓘(ℂ, ℂ × ℂ) (ℂ × ℂ)).presheaf.stalk ((0 : ℂ), (0 : ℂ)) :=
  planeGerm Prod.snd (contMDiff_iff_contDiff.2 contDiff_snd)

/-- The coordinate germ `x` is the germ of the first projection. -/
@[simp]
theorem toFilterGerm_planeFstCoordinate :
    toFilterGerm 𝓘(ℂ, ℂ × ℂ) (ℂ × ℂ) _ (𝓝 ((0 : ℂ), (0 : ℂ))) le_rfl planeFstCoordinate =
      (Prod.fst : ℂ × ℂ → ℂ) :=
  toFilterGerm_planeGerm _ _

/-- The coordinate germ `y` is the germ of the second projection. -/
@[simp]
theorem toFilterGerm_planeSndCoordinate :
    toFilterGerm 𝓘(ℂ, ℂ × ℂ) (ℂ × ℂ) _ (𝓝 ((0 : ℂ), (0 : ℂ))) le_rfl planeSndCoordinate =
      (Prod.snd : ℂ × ℂ → ℂ) :=
  toFilterGerm_planeGerm _ _

namespace nodeLocalRing

/-- Restriction of holomorphic germs at the origin of `ℂ²` to the two coordinate axes, as a
homomorphism to the local ring of the node obtained by gluing `0 ∈ ℂ` to `0 ∈ ℂ`: the germ of `F`
goes to the pair of germs of `z ↦ F (z, 0)` and `w ↦ F (0, w)`. -/
def ofPlaneGerm :
    (holomorphicStructureSheaf 𝓘(ℂ, ℂ × ℂ) (ℂ × ℂ)).presheaf.stalk ((0 : ℂ), (0 : ℂ)) →+*
      nodeLocalRing 𝓘(ℂ) 𝓘(ℂ) (0 : ℂ) (0 : ℂ) :=
  lift (stalkPrecomp 𝓘(ℂ) ℂ (fun z ↦ (z, 0))
      (contMDiff_iff_contDiff.2 (contDiff_id.prodMk contDiff_const)) 0)
    (stalkPrecomp 𝓘(ℂ) ℂ (fun w ↦ (0, w))
      (contMDiff_iff_contDiff.2 (contDiff_const.prodMk contDiff_id)) 0) fun s ↦
      (eval_stalkPrecomp 𝓘(ℂ) ℂ (fun z ↦ (z, 0)) _ 0 s).trans
        (eval_stalkPrecomp 𝓘(ℂ) ℂ (fun w ↦ (0, w)) _ 0 s).symm

variable (s : (holomorphicStructureSheaf 𝓘(ℂ, ℂ × ℂ) (ℂ × ℂ)).presheaf.stalk ((0 : ℂ), (0 : ℂ)))

/-- The first branch germ of `ofPlaneGerm F` is the restriction of `F` to the axis `y = 0`. -/
@[simp]
theorem fst_ofPlaneGerm :
    fst 𝓘(ℂ) 𝓘(ℂ) (0 : ℂ) (0 : ℂ) (ofPlaneGerm s) =
      stalkPrecomp 𝓘(ℂ) ℂ (fun z ↦ (z, 0))
        (contMDiff_iff_contDiff.2 (contDiff_id.prodMk contDiff_const)) 0 s :=
  fst_lift _ _ _ s

/-- The second branch germ of `ofPlaneGerm F` is the restriction of `F` to the axis `x = 0`. -/
@[simp]
theorem snd_ofPlaneGerm :
    snd 𝓘(ℂ) 𝓘(ℂ) (0 : ℂ) (0 : ℂ) (ofPlaneGerm s) =
      stalkPrecomp 𝓘(ℂ) ℂ (fun w ↦ (0, w))
        (contMDiff_iff_contDiff.2 (contDiff_const.prodMk contDiff_id)) 0 s :=
  snd_lift _ _ _ s

/-- The germ along `𝓝 0` of the first branch germ of `ofPlaneGerm F` is `z ↦ F (z, 0)`. -/
theorem toFilterGerm_fst_ofPlaneGerm :
    toFilterGerm 𝓘(ℂ) ℂ 0 (𝓝 0) le_rfl (fst 𝓘(ℂ) 𝓘(ℂ) (0 : ℂ) (0 : ℂ) (ofPlaneGerm s)) =
      (toFilterGerm 𝓘(ℂ, ℂ × ℂ) (ℂ × ℂ) _ (𝓝 ((0 : ℂ), (0 : ℂ))) le_rfl s).compTendsto
        (fun z : ℂ ↦ (z, (0 : ℂ))) ((Continuous.prodMk_left (0 : ℂ)).tendsto' 0 _ rfl) := by
  rw [fst_ofPlaneGerm]
  exact toFilterGerm_stalkPrecomp (fun z : ℂ ↦ (z, (0 : ℂ))) _ 0 s

/-- The germ along `𝓝 0` of the second branch germ of `ofPlaneGerm F` is `w ↦ F (0, w)`. -/
theorem toFilterGerm_snd_ofPlaneGerm :
    toFilterGerm 𝓘(ℂ) ℂ 0 (𝓝 0) le_rfl (snd 𝓘(ℂ) 𝓘(ℂ) (0 : ℂ) (0 : ℂ) (ofPlaneGerm s)) =
      (toFilterGerm 𝓘(ℂ, ℂ × ℂ) (ℂ × ℂ) _ (𝓝 ((0 : ℂ), (0 : ℂ))) le_rfl s).compTendsto
        (fun w : ℂ ↦ ((0 : ℂ), w)) ((Continuous.prodMk_right (0 : ℂ)).tendsto' 0 _ rfl) := by
  rw [snd_ofPlaneGerm]
  exact toFilterGerm_stalkPrecomp (fun w : ℂ ↦ ((0 : ℂ), w)) _ 0 s

/-- The germ of the identity chart of `ℂ` at `0` is the germ of the identity. -/
private theorem toFilterGerm_holomorphicCoordinateGerm_chartAt :
    toFilterGerm 𝓘(ℂ) ℂ 0 (𝓝 0) le_rfl ((chartAt ℂ (0 : ℂ)).holomorphicCoordinateGerm
      (chart_mem_maximalAtlas (I := 𝓘(ℂ)) (n := 1) (0 : ℂ)) 0 (mem_chart_source ℂ (0 : ℂ))) =
      (id : ℂ → ℂ) := by
  rw [OpenPartialHomeomorph.holomorphicCoordinateGerm_def,
    toFilterGerm_germ le_rfl (mem_chart_source ℂ (0 : ℂ)) _ id fun y ↦ by
      rw [OpenPartialHomeomorph.holomorphicCoordinateSection_apply]
      simp]

/-- The coordinate `x` of `ℂ²` restricts to the coordinate of the first branch. -/
@[simp]
theorem ofPlaneGerm_planeFstCoordinate :
    ofPlaneGerm planeFstCoordinate = fstCoordinate (q := (0 : ℂ))
      (chart_mem_maximalAtlas (I := 𝓘(ℂ)) (n := 1) (0 : ℂ)) (mem_chart_source ℂ (0 : ℂ)) := by
  refine ext (toFilterGerm_nhds_injective 0 ?_) (toFilterGerm_nhds_injective 0 ?_)
  · rw [toFilterGerm_fst_ofPlaneGerm, toFilterGerm_planeFstCoordinate, Germ.coe_compTendsto,
      fst_fstCoordinate, toFilterGerm_holomorphicCoordinateGerm_chartAt]
    rfl
  · rw [toFilterGerm_snd_ofPlaneGerm, toFilterGerm_planeFstCoordinate, Germ.coe_compTendsto,
      snd_fstCoordinate, map_zero, ← Germ.coe_zero]
    rfl

/-- The coordinate `y` of `ℂ²` restricts to the coordinate of the second branch. -/
@[simp]
theorem ofPlaneGerm_planeSndCoordinate :
    ofPlaneGerm planeSndCoordinate = sndCoordinate (p := (0 : ℂ))
      (chart_mem_maximalAtlas (I := 𝓘(ℂ)) (n := 1) (0 : ℂ)) (mem_chart_source ℂ (0 : ℂ)) := by
  refine ext (toFilterGerm_nhds_injective 0 ?_) (toFilterGerm_nhds_injective 0 ?_)
  · rw [toFilterGerm_fst_ofPlaneGerm, toFilterGerm_planeSndCoordinate, Germ.coe_compTendsto,
      fst_sndCoordinate, map_zero, ← Germ.coe_zero]
    rfl
  · rw [toFilterGerm_snd_ofPlaneGerm, toFilterGerm_planeSndCoordinate, Germ.coe_compTendsto,
      snd_sndCoordinate, toFilterGerm_holomorphicCoordinateGerm_chartAt]
    rfl

/-- Every germ at the node is the restriction of a holomorphic germ at the origin of `ℂ²`: the
branch germs `g` and `h` are the restrictions of `(x, y) ↦ g x + h y - g 0`. -/
theorem ofPlaneGerm_surjective : Function.Surjective ofPlaneGerm := by
  intro n
  obtain ⟨g, hg, hgn⟩ := exists_toFilterGerm_eq 0 (fst 𝓘(ℂ) 𝓘(ℂ) (0 : ℂ) (0 : ℂ) n)
  obtain ⟨h, hh, hhn⟩ := exists_toFilterGerm_eq 0 (snd 𝓘(ℂ) 𝓘(ℂ) (0 : ℂ) (0 : ℂ) n)
  have hgh : g 0 = h 0 := by
    rw [← eval_eq_of_toFilterGerm_eq (hgn _ le_rfl), ← eval_eq_of_toFilterGerm_eq (hhn _ le_rfl),
      eval_fst, eval_snd]
  set F : ℂ × ℂ → ℂ := fun q ↦ g q.1 + h q.2 - g 0
  have hF : ∀ᶠ q in 𝓝 ((0 : ℂ), (0 : ℂ)), ContMDiffAt 𝓘(ℂ, ℂ × ℂ) 𝓘(ℂ) ω F q := by
    filter_upwards [continuousAt_fst.eventually hg, continuousAt_snd.eventually hh]
      with q hgq hhq
    rw [contMDiffAt_modelSpace_omega_iff_analyticAt] at hgq hhq ⊢
    exact ((hgq.comp analyticAt_fst).add (hhq.comp analyticAt_snd)).sub analyticAt_const
  obtain ⟨s, hs⟩ := exists_toFilterGerm_eq_of_eventually_contMDiffAt hF
  refine ⟨s, ext (toFilterGerm_nhds_injective 0 ?_) (toFilterGerm_nhds_injective 0 ?_)⟩
  · rw [toFilterGerm_fst_ofPlaneGerm, hs _ le_rfl, Germ.coe_compTendsto, hgn _ le_rfl]
    congr 1
    funext z
    simp [F, hgh]
  · rw [toFilterGerm_snd_ofPlaneGerm, hs _ le_rfl, Germ.coe_compTendsto, hhn _ le_rfl]
    congr 1
    funext w
    simp [F]

/-- The kernel of the restriction to the two axes is generated by `xy`: a holomorphic germ at the
origin of `ℂ²` vanishing on both coordinate axes is `xy` times a holomorphic germ. -/
theorem ker_ofPlaneGerm :
    RingHom.ker ofPlaneGerm = Ideal.span {planeFstCoordinate * planeSndCoordinate} := by
  refine le_antisymm (fun s hs ↦ ?_) ((Ideal.span_singleton_le_iff_mem _).2 ?_)
  · rw [RingHom.mem_ker] at hs
    obtain ⟨F, hF, hFs⟩ := exists_toFilterGerm_eq _ s
    -- The restrictions of `F` to the two axes vanish near the origin.
    have h₁ : ∀ᶠ z in 𝓝 (0 : ℂ), F (z, 0) = 0 := by
      have := toFilterGerm_fst_ofPlaneGerm s
      rw [hs, map_zero, map_zero, hFs _ le_rfl, Germ.coe_compTendsto, ← Germ.coe_zero,
        Germ.coe_eq] at this
      exact this.symm
    have h₂ : ∀ᶠ w in 𝓝 (0 : ℂ), F (0, w) = 0 := by
      have := toFilterGerm_snd_ofPlaneGerm s
      rw [hs, map_zero, map_zero, hFs _ le_rfl, Germ.coe_compTendsto, ← Germ.coe_zero,
        Germ.coe_eq] at this
      exact this.symm
    have hFa : AnalyticAt ℂ F (0, 0) :=
      contMDiffAt_modelSpace_omega_iff_analyticAt.1 hF.self_of_nhds
    obtain ⟨K, hK, hFK⟩ := hFa.exists_eventuallyEq_mul_smul h₁ h₂
    obtain ⟨k, hk⟩ := exists_toFilterGerm_eq_of_eventually_contMDiffAt
      (hK.eventually_analyticAt.mono fun _ ↦ contMDiffAt_modelSpace_omega_iff_analyticAt.2)
    refine Ideal.mem_span_singleton'.2 ⟨k, toFilterGerm_nhds_injective _ ?_⟩
    rw [map_mul, map_mul, toFilterGerm_planeFstCoordinate, toFilterGerm_planeSndCoordinate,
      hk _ le_rfl, hFs _ le_rfl, ← Germ.coe_mul, ← Germ.coe_mul, Germ.coe_eq]
    filter_upwards [hFK] with q hq
    rw [hq, smul_eq_mul, sub_zero, sub_zero, Pi.mul_apply, Pi.mul_apply, mul_comm]
  · rw [RingHom.mem_ker, map_mul, ofPlaneGerm_planeFstCoordinate, ofPlaneGerm_planeSndCoordinate,
      fstCoordinate_mul_sndCoordinate]

/-- **The node ring is `ℂ{x, y}/(xy)`.** Restriction to the two coordinate axes identifies the
quotient of the ring of holomorphic germs at the origin of `ℂ²` by `xy` with the ring of pairs of
branch germs with equal values at the node. -/
def planeNodeEquiv :
    (holomorphicStructureSheaf 𝓘(ℂ, ℂ × ℂ) (ℂ × ℂ)).presheaf.stalk ((0 : ℂ), (0 : ℂ)) ⧸
      Ideal.span {planeFstCoordinate * planeSndCoordinate} ≃+*
      nodeLocalRing 𝓘(ℂ) 𝓘(ℂ) (0 : ℂ) (0 : ℂ) :=
  (Ideal.quotEquivOfEq ker_ofPlaneGerm.symm).trans
    (RingHom.quotientKerEquivOfSurjective ofPlaneGerm_surjective)

/-- The isomorphism `ℂ{x, y}/(xy) ≃+* nodeLocalRing 𝓘(ℂ) 𝓘(ℂ) 0 0` sends the class of a germ to
its restriction to the two coordinate axes. -/
@[simp]
theorem planeNodeEquiv_mk :
    planeNodeEquiv (Ideal.Quotient.mk _ s) = ofPlaneGerm s := by
  rw [planeNodeEquiv, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk]

end nodeLocalRing

end TauCeti.holomorphicStructureSheaf
