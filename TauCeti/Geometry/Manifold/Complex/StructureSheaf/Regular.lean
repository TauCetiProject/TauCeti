module

public import TauCeti.Geometry.Manifold.Complex.StructureSheaf.Noetherian
public import Mathlib.RingTheory.RegularLocalRing.Defs

import Mathlib.Algebra.Module.SpanRankOperations
import TauCeti.Geometry.Manifold.Complex.StructureSheaf.Cotangent
import TauCeti.Geometry.Manifold.Complex.StructureSheaf.Dimension

/-!
# Holomorphic stalks are regular local rings

The ring `𝒪_{X, x}` of germs of holomorphic functions at a point of a complex manifold without
boundary, modelled on a complex vector space of finite dimension `n`, is a regular local ring of
Krull dimension `n`.

The proof combines three facts. The stalk is Noetherian
(`TauCeti.holomorphicStructureSheaf.stalkIsNoetherianRing`), so by Krull's height theorem its
dimension is at most the minimal number of generators of its maximal ideal, which is the
dimension of the cotangent space `𝔪/𝔪²` (Mathlib's `ringKrullDim_le_spanFinrank_maximalIdeal` and
`IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace`). Differentiation in a chart
identifies that cotangent space with the dual of the model, so it has dimension `n`
(`OpenPartialHomeomorph.finrank_cotangentSpace_holomorphicStalk`); equivalently, the `n` centred
coordinate germs of a chart generate the maximal ideal. Conversely, restricting germs to
coordinate hyperplanes gives a chain of primes of length `n`
(`TauCeti.holomorphicStructureSheaf.finrank_le_ringKrullDim_stalk`). So the dimension is exactly
`n`, and the maximal ideal is generated by that many elements.

The argument is carried out on `Fin d → ℂ` and transported to any point in the domain of a
single holomorphic chart (`OpenPartialHomeomorph.isRegularLocalRing_holomorphicStalk`,
`OpenPartialHomeomorph.ringKrullDim_holomorphicStalk`) without a global manifold instance, then
specialized to a complex manifold via `chartAt`
(`TauCeti.holomorphicStructureSheaf.stalkIsRegularLocalRing`,
`TauCeti.holomorphicStructureSheaf.ringKrullDim_stalk`). Through the comparison of holomorphic and
complex-smooth germs, the same holds for the stalks of Mathlib's complex-smooth structure sheaf.

## Main declarations

* `OpenPartialHomeomorph.isRegularLocalRing_holomorphicStalk`,
  `OpenPartialHomeomorph.ringKrullDim_holomorphicStalk`: chart-local regularity and Krull
  dimension without a global manifold assumption.
* `TauCeti.holomorphicStructureSheaf.stalkIsRegularLocalRing`: holomorphic stalks are regular
  local rings.
* `TauCeti.holomorphicStructureSheaf.ringKrullDim_stalk`: their Krull dimension is the complex
  dimension of the model.
* `TauCeti.holomorphicStructureSheaf.smoothStalkIsRegularLocalRing`,
  `TauCeti.holomorphicStructureSheaf.ringKrullDim_smoothStalk`: the same for the stalks of the
  complex-smooth structure sheaf.

## References

* J.-P. Demailly, *Complex Analytic and Differential Geometry*, Chapter II, §2.
* R. C. Gunning, H. Rossi, *Analytic Functions of Several Complex Variables*, Chapter II.
-/

public noncomputable section

open Filter Module Topology
open scoped ContDiff Manifold

namespace TauCeti.holomorphicStructureSheaf

section ModelSpace

variable {V : Type} [NormedAddCommGroup V] [NormedSpace ℂ V] [FiniteDimensional ℂ V]

/-- The maximal ideal of a holomorphic stalk of a finite-dimensional complex vector space is
generated by as many elements as the dimension of the space, and by no fewer. -/
private theorem spanFinrank_maximalIdeal_stalk_modelSpace (v : V) :
    (IsLocalRing.maximalIdeal
        ((holomorphicStructureSheaf 𝓘(ℂ, V) V).presheaf.stalk v)).spanFinrank = finrank ℂ V := by
  rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
  exact (chartAt V v).finrank_cotangentSpace_holomorphicStalk v (mem_chart_source V v)
    (IsManifold.chart_mem_maximalAtlas v)

/-- Holomorphic stalks of a finite-dimensional complex vector space are regular local rings. -/
private theorem isRegularLocalRing_stalk_modelSpace (v : V) :
    IsRegularLocalRing ((holomorphicStructureSheaf 𝓘(ℂ, V) V).presheaf.stalk v) :=
  .of_spanFinrank_maximalIdeal_le _ <| by
    rw [spanFinrank_maximalIdeal_stalk_modelSpace]
    exact finrank_le_ringKrullDim_stalk_modelSpace v

/-- The holomorphic stalks of a finite-dimensional complex vector space have Krull dimension equal
to the dimension of the space. -/
private theorem ringKrullDim_stalk_modelSpace (v : V) :
    ringKrullDim ((holomorphicStructureSheaf 𝓘(ℂ, V) V).presheaf.stalk v) = finrank ℂ V := by
  have := isRegularLocalRing_stalk_modelSpace v
  rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, spanFinrank_maximalIdeal_stalk_modelSpace]

end ModelSpace

end TauCeti.holomorphicStructureSheaf

namespace OpenPartialHomeomorph

open TauCeti TauCeti.holomorphicStructureSheaf

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [FiniteDimensional ℂ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℂ E H} [I.Boundaryless]
  {X : Type} [TopologicalSpace X] [ChartedSpace H X]

/-- Identifies the holomorphic stalk at a point of a chart with a stalk on `Fin d → ℂ`. -/
private def holomorphicStalkEquivFin (e : OpenPartialHomeomorph X H)
    (he : e ∈ IsManifold.maximalAtlas I 1 X) {x : X} (hx : x ∈ e.source) :
    (holomorphicStructureSheaf I X).presheaf.stalk x ≃+*
      (holomorphicStructureSheaf 𝓘(ℂ, Fin (finrank ℂ E) → ℂ)
        (Fin (finrank ℂ E) → ℂ)).presheaf.stalk
        ((ContinuousLinearEquiv.ofFinrankEq (by simp) :
          E ≃L[ℂ] Fin (finrank ℂ E) → ℂ) (e.extend I x)) :=
  e.holomorphicStalkEquivModelSpace (V := Fin (finrank ℂ E) → ℂ)
    ((IsManifold.maximalAtlas_eq_of_ne_zero one_ne_zero (by simp)).subset he) x hx
    (ContinuousLinearEquiv.ofFinrankEq (by simp))

/-- The holomorphic stalk at any point in the domain of a holomorphic chart is a regular local
ring, with no global manifold assumption beyond the chart itself. -/
theorem isRegularLocalRing_holomorphicStalk (e : OpenPartialHomeomorph X H)
    (he : e ∈ IsManifold.maximalAtlas I 1 X) {x : X} (hx : x ∈ e.source) :
    IsRegularLocalRing ((holomorphicStructureSheaf I X).presheaf.stalk x) := by
  have := isRegularLocalRing_stalk_modelSpace (V := Fin (finrank ℂ E) → ℂ)
    ((ContinuousLinearEquiv.ofFinrankEq (by simp) :
      E ≃L[ℂ] Fin (finrank ℂ E) → ℂ) (e.extend I x))
  exact IsRegularLocalRing.of_ringEquiv (e.holomorphicStalkEquivFin he hx).symm

/-- The Krull dimension of the holomorphic stalk at any point in the domain of a holomorphic chart
equals `Module.finrank ℂ E`. -/
theorem ringKrullDim_holomorphicStalk (e : OpenPartialHomeomorph X H)
    (he : e ∈ IsManifold.maximalAtlas I 1 X) {x : X} (hx : x ∈ e.source) :
    ringKrullDim ((holomorphicStructureSheaf I X).presheaf.stalk x) = finrank ℂ E := by
  rw [← ringKrullDim_eq_of_ringEquiv (e.holomorphicStalkEquivFin he hx).symm,
    ringKrullDim_stalk_modelSpace]
  simp

end OpenPartialHomeomorph

namespace TauCeti.holomorphicStructureSheaf

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [FiniteDimensional ℂ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℂ E H} [I.Boundaryless]
  {X : Type} [TopologicalSpace X] [ChartedSpace H X] [IsManifold I 1 X]

/-- **Holomorphic stalks are regular local rings.** The stalk of holomorphic functions at any
point of a finite-dimensional complex manifold without boundary is a Noetherian local ring whose
maximal ideal is generated by as many elements as its Krull dimension. -/
instance stalkIsRegularLocalRing (x : X) :
    IsRegularLocalRing ((holomorphicStructureSheaf I X).presheaf.stalk x) :=
  (chartAt H x).isRegularLocalRing_holomorphicStalk
    (IsManifold.chart_mem_maximalAtlas x) (mem_chart_source H x)

/-- The Krull dimension of the holomorphic stalk at any point of a finite-dimensional complex
manifold without boundary is the complex dimension of its model. -/
theorem ringKrullDim_stalk (x : X) :
    ringKrullDim ((holomorphicStructureSheaf I X).presheaf.stalk x) = finrank ℂ E :=
  (chartAt H x).ringKrullDim_holomorphicStalk
    (IsManifold.chart_mem_maximalAtlas x) (mem_chart_source H x)

/-- A stalk of Mathlib's complex-smooth structure sheaf on a finite-dimensional complex manifold
without boundary is a regular local ring, via its comparison with holomorphic germs. -/
instance smoothStalkIsRegularLocalRing (x : X) :
    IsRegularLocalRing ((smoothSheafCommRing I 𝓘(ℂ) X ℂ).presheaf.stalk x) :=
  .of_ringEquiv (smoothStalkIso I X x).commRingCatIsoToRingEquiv

/-- The Krull dimension of a stalk of Mathlib's complex-smooth structure sheaf on a
finite-dimensional complex manifold without boundary is the complex dimension of its model. -/
theorem ringKrullDim_smoothStalk (x : X) :
    ringKrullDim ((smoothSheafCommRing I 𝓘(ℂ) X ℂ).presheaf.stalk x) = finrank ℂ E := by
  rw [← ringKrullDim_eq_of_ringEquiv (smoothStalkIso I X x).commRingCatIsoToRingEquiv,
    ringKrullDim_stalk]

end TauCeti.holomorphicStructureSheaf
