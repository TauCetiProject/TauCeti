module

public import TauCeti.Geometry.Manifold.Complex.StructureSheaf.Completion.Basic
public import TauCeti.Geometry.Manifold.Complex.StructureSheaf.ClosedSubspace
public import TauCeti.RingTheory.AdicCompletion.AlgHom
import TauCeti.RingTheory.AdicCompletion.Finite
import Mathlib.RingTheory.MvPowerSeries.Equiv
import TauCeti.RingTheory.MvPowerSeries.Ideal

/-!
# Completed local rings of closed analytic subspaces

Taylor expansion identifies the completion of a quotient `𝒪ₓ/J` of a holomorphic stalk
with the quotient of the formal power series ring by the ideal generated by the Taylor
series of elements of `J`. The ideal is not radicalized: the equations, including their
multiplicities and nilpotents, survive completion.

`TauCeti.holomorphicStructureSheaf.adicCompletionQuotientEquiv` gives this comparison for
every ideal of the holomorphic stalk on a finite coordinate space. The topology on the
quotient is induced by the maximal ideal of the ambient stalk; for a proper ideal this
is its own maximal-ideal topology. Its value on a germ is the class of its Taylor series.
`TauCeti.closedAnalyticSubspace.adicCompletionStalkEquiv` applies the comparison to the
native stalk of a closed analytic subspace, using `closedAnalyticSubspace.stalkEquiv`.

The analytic input is the ambient completion comparison `adicCompletionEquiv`.
Faithful flatness contracts the extended defining ideal, and Taylor polynomials give
surjectivity on every finite jet quotient. Completeness of finite modules over a
complete Noetherian ring then identifies the inverse limit with the formal quotient.

## References

* A. Grothendieck et al., *Revêtements étales et groupe fondamental* (SGA 1), Exposé XII,
  Théorème et définition 1.1 and its proof.
* Gerd Fischer, *Complex Analytic Geometry*, Chapter 0 (local models of complex spaces).
-/

public noncomputable section

open CategoryTheory Topology MvPowerSeries
open scoped ContDiff Manifold

namespace TauCeti.holomorphicStructureSheaf

variable {ι : Type} [Fintype ι] (x : ι → ℂ)

local notation "A" => TopCat.Presheaf.stalk (C := CommRingCat)
  (TopCat.Sheaf.presheaf (holomorphicStructureSheaf 𝓘(ℂ, ι → ℂ) (ι → ℂ))) x
local notation "S" => MvPowerSeries ι ℂ
local notation "𝔪" => IsLocalRing.maximalIdeal A
local notation "𝔫" => IsLocalRing.maximalIdeal S

variable (J : Ideal ((holomorphicStructureSheaf 𝓘(ℂ, ι → ℂ) (ι → ℂ)).presheaf.stalk x))

private theorem comap_quotientTaylorSeries_maximalIdeal_pow (n : ℕ) :
    (((𝔫).map (Ideal.Quotient.mk (J.map (taylorSeries x)))) ^ n).comap
        (Ideal.quotientMap (J.map (taylorSeries x)) (taylorSeries x) Ideal.le_comap_map) =
      ((𝔪).map (Ideal.Quotient.mk J)) ^ n := by
  let := (taylorSeries x).toAlgebra
  have : Module.FaithfullyFlat A S := taylorSeries_faithfullyFlat x
  have hcontract (K : Ideal A) : (K.map (taylorSeries x)).comap (taylorSeries x) = K :=
    K.comap_map_eq_self_of_faithfullyFlat (B := S)
  apply Ideal.comap_injective_of_surjective (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  -- Pull both ideals back to the ambient stalk, where faithful flatness contracts them.
  rw [Ideal.comap_comap, Ideal.quotientMap_comp_mk, ← Ideal.comap_comap]
  simp only [← Ideal.map_pow,
    Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
    ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
  simpa only [Ideal.map_sup, Ideal.map_pow, map_taylorSeries_maximalIdeal] using
    hcontract (𝔪 ^ n ⊔ J)

private theorem quotientTaylorSeries_jet_bijective (n : ℕ) :
    Function.Bijective (Ideal.quotientMap
      (((𝔫).map (Ideal.Quotient.mk (J.map (taylorSeries x)))) ^ n)
      (Ideal.quotientMap (J.map (taylorSeries x)) (taylorSeries x) Ideal.le_comap_map)
      (comap_quotientTaylorSeries_maximalIdeal_pow x J n).ge) := by
  refine ⟨Ideal.quotientMap_injective'
    (comap_quotientTaylorSeries_maximalIdeal_pow x J n).le, ?_⟩
  intro y
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
    (AdicCompletion.evalₐ 𝔪 n ((adicCompletionEquiv x).symm s))
  have hs : Ideal.Quotient.mk (𝔫 ^ n) (taylorSeries x a) = Ideal.Quotient.mk (𝔫 ^ n) s := by
    have h := mk_adicCompletionEquiv x n ((adicCompletionEquiv x).symm s)
    simpa [← ha] using h.symm
  refine ⟨Ideal.Quotient.mk _ (Ideal.Quotient.mk J a), ?_⟩
  rw [Ideal.quotientMap_mk, Ideal.quotientMap_mk, Ideal.Quotient.eq, ← map_sub]
  rw [← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ (Ideal.Quotient.eq.mp hs)

/-- The completion of `𝒪ₓ/J` at the image of the ambient maximal ideal is the formal
power series ring modulo the Taylor series of `J`, without taking radicals. -/
def adicCompletionQuotientEquiv :
    AdicCompletion ((𝔪).map (Ideal.Quotient.mk J)) (A ⧸ J) ≃+*
      S ⧸ J.map (taylorSeries x) := by
  letI := (Ideal.quotientMap (J.map (taylorSeries x)) (taylorSeries x) Ideal.le_comap_map).toAlgebra
  haveI : IsAdicComplete 𝔫 S := by
    rw [maximalIdeal_eq_span_range_X]
    infer_instance
  haveI : IsAdicComplete 𝔫 (S ⧸ J.map (taylorSeries x)) := .of_finite _ _
  haveI : IsAdicComplete ((𝔫).map (Ideal.Quotient.mk (J.map (taylorSeries x))))
      (S ⧸ J.map (taylorSeries x)) := (IsAdicComplete.map_algebraMap_iff _ _).mpr inferInstance
  have hmap : ((𝔪).map (Ideal.Quotient.mk J)).map
      (Ideal.quotientMap (J.map (taylorSeries x)) (taylorSeries x) Ideal.le_comap_map) =
        (𝔫).map (Ideal.Quotient.mk (J.map (taylorSeries x))) := by
    rw [Ideal.map_map, Ideal.quotientMap_comp_mk,
      ← Ideal.map_map, map_taylorSeries_maximalIdeal]
  exact (RingEquiv.ofBijective
    (AdicCompletion.mapₐ (Algebra.ofId (A ⧸ J) _)
      (Ideal.map_le_iff_le_comap.mp hmap.le))
    (AdicCompletion.mapₐ_bijective _ _ (quotientTaylorSeries_jet_bijective x J))).trans
      (AdicCompletion.ofAlgEquiv _).symm.toRingEquiv

/-- The completed quotient comparison sends an original germ to its Taylor series
modulo the defining equations. -/
@[simp]
theorem adicCompletionQuotientEquiv_of (s : A ⧸ J) :
    adicCompletionQuotientEquiv x J
      (AdicCompletion.of ((𝔪).map (Ideal.Quotient.mk J)) _ s) =
        Ideal.quotientMap (J.map (taylorSeries x)) (taylorSeries x) Ideal.le_comap_map s := by
  simp [adicCompletionQuotientEquiv, RingHom.algebraMap_toAlgebra]

end TauCeti.holomorphicStructureSheaf

namespace TauCeti.closedAnalyticSubspace

variable {ι : Type} [Fintype ι]
  (J : Ideal ((holomorphicStructureSheaf 𝓘(ℂ, ι → ℂ) (ι → ℂ)).presheaf.obj
    (Opposite.op ⊤))) (z : zeroLocus J)

local notation "A" => TopCat.Presheaf.stalk (C := CommRingCat)
  (TopCat.Sheaf.presheaf (holomorphicStructureSheaf 𝓘(ℂ, ι → ℂ) (ι → ℂ))) z.val
local notation "B" => TopCat.Presheaf.stalk (C := CommRingCat)
  (AlgebraicGeometry.PresheafedSpace.presheaf
    (AlgebraicGeometry.SheafedSpace.toPresheafedSpace
      (AlgebraicGeometry.LocallyRingedSpace.toSheafedSpace (closedAnalyticSubspace J)))) z
local notation "K" => TopCat.Presheaf.stalkIdeal
  (TopCat.Sheaf.presheaf (holomorphicStructureSheaf 𝓘(ℂ, ι → ℂ) (ι → ℂ))) J z.val

local instance : IsLocalRing ((closedAnalyticSubspace J).presheaf.stalk z) :=
  (closedAnalyticSubspace J).isLocalRing z

/-- The maximal-ideal completion of the native stalk of a closed analytic subspace
is the formal power series ring modulo the Taylor expansions of its defining ideal.
In particular, the quotient retains nonradical equations. -/
def adicCompletionStalkEquiv :
    AdicCompletion (IsLocalRing.maximalIdeal B) B ≃+*
      MvPowerSeries ι ℂ ⧸ (K).map (holomorphicStructureSheaf.taylorSeries z.val) := by
  letI : Nontrivial (A ⧸ K) :=
    Ideal.Quotient.nontrivial_iff.mpr (stalkIdeal_ne_top_iff.mpr z.property)
  letI : IsLocalRing (A ⧸ K) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk K) Ideal.Quotient.mk_surjective
  have hmap : (IsLocalRing.maximalIdeal B).map (stalkEquiv J z) =
      (IsLocalRing.maximalIdeal A).map (Ideal.Quotient.mk K) := by
    rw [IsLocalRing.map_ringEquiv_maximalIdeal,
      IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]
  exact (AdicCompletion.congrₐ (stalkEquiv J z).toIntAlgEquiv hmap).toRingEquiv.trans
    (holomorphicStructureSheaf.adicCompletionQuotientEquiv z.val K)

/-- On an original stalk element the completed local-model comparison is the quotient
Taylor map, after the canonical identification with the quotient of the ambient stalk. -/
@[simp]
theorem adicCompletionStalkEquiv_of (s : (closedAnalyticSubspace J).presheaf.stalk z) :
    adicCompletionStalkEquiv J z (AdicCompletion.of (IsLocalRing.maximalIdeal B) B s) =
      Ideal.quotientMap ((K).map (holomorphicStructureSheaf.taylorSeries z.val))
        (holomorphicStructureSheaf.taylorSeries z.val) Ideal.le_comap_map (stalkEquiv J z s) := by
  dsimp only [adicCompletionStalkEquiv, RingEquiv.trans_apply]
  -- The closed-subspace carrier is exposed but semireducible.
  erw [AdicCompletion.congrₐ_of, holomorphicStructureSheaf.adicCompletionQuotientEquiv_of]
  rfl

end TauCeti.closedAnalyticSubspace
