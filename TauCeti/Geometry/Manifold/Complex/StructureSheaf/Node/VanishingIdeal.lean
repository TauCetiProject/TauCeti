module

public import TauCeti.Geometry.Manifold.Complex.StructureSheaf.OffNodeChart
import TauCeti.Analysis.Complex.NodeDivision

/-!
# The local ring of `xy = s(b)` is the ring of restricted holomorphic germs

The local model for smoothing a node over a base `E` is the hypersurface
`N_s = {(b, x, y) ∈ E × ℂ × ℂ | xy = s(b)}`, for a holomorphic base germ `s`. Its local ring at a
point `p` is the quotient of the holomorphic germs at `p` on `E × ℂ × ℂ` by the local equation
`xy - s(b)` (`TauCeti.holomorphicStructureSheaf.smoothingEquation`). This file identifies this
quotient with the ring of germs at `p` of functions on `N_s` that are restrictions of ambient
holomorphic functions:

* `TauCeti.holomorphicStructureSheaf.mem_span_smoothingEquation_iff`: a holomorphic germ lies in
  the ideal generated by `xy - s(b)` exactly when it vanishes on `N_s` near `p`;
* `TauCeti.holomorphicStructureSheaf.ker_toFilterGerm_nhdsWithin_smoothingEquation`: restricting
  holomorphic germs to germs of functions on `N_s` has kernel generated by `xy - s(b)`;
* `TauCeti.holomorphicStructureSheaf.smoothingQuotientEquivRange`: hence the local ring of `N_s` at
  `p` is isomorphic to the ring of these restricted germs.

These hold at every point `p` and for every holomorphic `s`. At the nodes `x = y = 0` the total
space can be singular, for instance when `s` vanishes identically (a permanent node) or as in
`xy = b²`, and the germs on `N_s` there are not germs on a manifold. The analytic input is
`AnalyticAt.exists_eventuallyEq_mul_sub_mul`, the analytic Nullstellensatz for `N_s`. Since the
quotient embeds in a ring of germs of functions, the ideal `(xy - s(b))` is radical at every point
(`TauCeti.holomorphicStructureSheaf.isRadical_span_smoothingEquation`), strengthening the
reducedness of the node equations (`TauCeti.holomorphicStructureSheaf.isRadical_span_nodeEquation`).

## References

* J. W. Robbin and D. A. Salamon, *A construction of the Deligne–Mumford orbifold*,
  J. Eur. Math. Soc. **8** (2006), 611–699, for the local models `xy = a` of nodal families.
* R. C. Gunning and H. Rossi, *Analytic Functions of Several Complex Variables*, Chapter II,
  for the local rings of analytic subvarieties.
-/

public noncomputable section

open Filter Topology
open scoped ContDiff Manifold

namespace TauCeti.holomorphicStructureSheaf

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℂ E] [FiniteDimensional ℂ E]

/-- **The ideal of `N_s`.** At any point `p` of `E × ℂ × ℂ`, a holomorphic germ `g` lies in the
ideal generated by the local equation `xy - s(b)` exactly when a representative `G` of `g`
vanishes at the points of `N_s` near `p`. Here `S` is a representative of `s`. -/
theorem mem_span_smoothingEquation_iff {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S)
    {g : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p}
    {G : E × ℂ × ℂ → ℂ} (hgG : toFilterGerm 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p (𝓝 p) le_rfl g = G) :
    g ∈ Ideal.span {smoothingEquation p s} ↔
      ∀ᶠ q in 𝓝 p, q.2.1 * q.2.2 = S q.1 → G q = 0 := by
  rw [mem_span_smoothingEquation_iff_of_division hS nhdsWithin_le_nhds self_mem_nhdsWithin
    (fun G hG h0 ↦ hG.exists_eventuallyEq_mul_sub_mul
      (exists_toFilterGerm_nhds_eq_iff_analyticAt.1 ⟨s, hS⟩) (eventually_nhdsWithin_iff.1 h0))
    hgG, eventually_nhdsWithin_iff]
  simp only [Set.mem_ofPred_eq]

/-- **Restriction to `N_s` has kernel `(xy - s(b))`.** At any point `p` of `E × ℂ × ℂ`, the
holomorphic germs at `p` whose restrictions to `N_s = {xy = S(b)}` have zero germ at `p` form the
ideal generated by the local equation `xy - s(b)`. Here `S` is a representative of `s`. -/
theorem ker_toFilterGerm_nhdsWithin_smoothingEquation (p : E × ℂ × ℂ)
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S) :
    RingHom.ker (toFilterGerm 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p
        (𝓝[{q | q.2.1 * q.2.2 = S q.1}] p) nhdsWithin_le_nhds) =
      Ideal.span {smoothingEquation p s} := by
  ext g
  obtain ⟨G, -, hG⟩ := exists_toFilterGerm_eq p g
  rw [RingHom.mem_ker, mem_span_smoothingEquation_iff hS (hG _ le_rfl), hG, ← Germ.coe_zero,
    Germ.coe_eq, EventuallyEq, eventually_nhdsWithin_iff]
  simp only [Set.mem_ofPred_eq, Pi.zero_apply]

/-- **The local ring of `N_s` is the ring of restricted holomorphic germs.** At any point `p` of
`E × ℂ × ℂ`, restricting germs to `N_s = {xy = S(b)}` identifies the local ring
`𝒪_p ⧸ (xy - s(b))` with the ring of germs at `p` of functions on `N_s` which are restrictions of
holomorphic functions near `p`. Here `S` is a representative of `s`. -/
def smoothingQuotientEquivRange (p : E × ℂ × ℂ)
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S) :
    ((holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p ⧸
        Ideal.span {smoothingEquation p s}) ≃+*
      (toFilterGerm 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p
        (𝓝[{q | q.2.1 * q.2.2 = S q.1}] p) nhdsWithin_le_nhds).range :=
  (Ideal.quotEquivOfEq (ker_toFilterGerm_nhdsWithin_smoothingEquation p hS).symm).trans
    (RingHom.quotientKerEquivRange _)

/-- The class of a germ goes to its restriction to `N_s`. -/
@[simp]
theorem smoothingQuotientEquivRange_mk (p : E × ℂ × ℂ)
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S)
    (g : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p) :
    smoothingQuotientEquivRange p hS (Ideal.Quotient.mk _ g) =
      (toFilterGerm 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p
        (𝓝[{q | q.2.1 * q.2.2 = S q.1}] p) nhdsWithin_le_nhds).rangeRestrict g := by
  simp only [smoothingQuotientEquivRange, RingHom.quotientKerEquivRange, RingEquiv.trans_apply,
    Ideal.quotEquivOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk]

/-- The class of a germ goes to its restriction to `N_s`, as a germ along `N_s`. -/
theorem coe_smoothingQuotientEquivRange_mk (p : E × ℂ × ℂ)
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S)
    (g : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p) :
    (smoothingQuotientEquivRange p hS (Ideal.Quotient.mk _ g) : Germ _ ℂ) =
      toFilterGerm 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p
        (𝓝[{q | q.2.1 * q.2.2 = S q.1}] p) nhdsWithin_le_nhds g := by
  rw [smoothingQuotientEquivRange_mk, RingHom.coe_rangeRestrict]

/-- The inverse isomorphism sends the restriction of a germ to `N_s` to the class of the germ. -/
@[simp]
theorem smoothingQuotientEquivRange_symm_rangeRestrict (p : E × ℂ × ℂ)
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S)
    (g : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p) :
    (smoothingQuotientEquivRange p hS).symm ((toFilterGerm 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p
        (𝓝[{q | q.2.1 * q.2.2 = S q.1}] p) nhdsWithin_le_nhds).rangeRestrict g) =
      Ideal.Quotient.mk _ g := by
  rw [RingEquiv.symm_apply_eq, smoothingQuotientEquivRange_mk]

/-- **`N_s` is reduced.** At any point `p` of `E × ℂ × ℂ`, the ideal generated by the local
equation `xy - s(b)` is radical. -/
theorem isRadical_span_smoothingEquation (p : E × ℂ × ℂ)
    (s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1) :
    (Ideal.span {smoothingEquation p s}).IsRadical := by
  rintro g ⟨n, hn⟩
  obtain ⟨S, -, hS⟩ := exists_toFilterGerm_eq p.1 s
  obtain ⟨G, -, hG⟩ := exists_toFilterGerm_eq p g
  rw [mem_span_smoothingEquation_iff (hS _ le_rfl) (G := G ^ n)
    (by rw [map_pow, hG _ le_rfl, Germ.coe_pow])] at hn
  rw [mem_span_smoothingEquation_iff (hS _ le_rfl) (hG _ le_rfl)]
  filter_upwards [hn] with q hq hqS
  exact eq_zero_of_pow_eq_zero (hq hqS)

end TauCeti.holomorphicStructureSheaf
