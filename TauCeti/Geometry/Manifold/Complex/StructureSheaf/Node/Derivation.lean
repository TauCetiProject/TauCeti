/-!
# The smoothing ideal of a node is intrinsic

Let `Q = 𝒪 ⧸ (xy - s(b))` be the local ring at the node `((b, 0), 0)` of the smoothing family
`xy = s(b)`, an algebra over the base germs `𝒪_{E, b}` by pullback. This file shows that the
ideal `(s)` of the base is determined by this algebra alone. Hence two node families over the
same base germ whose local rings at the node are isomorphic over the base have smoothing
parameters that differ by a unit
(`TauCeti.holomorphicStructureSheaf.associated_of_ringEquiv_nodeEquation`).
No choice of node coordinates enters, and `s` may vanish identically (a permanent node) or to
any order, as in `xy = b²`.

The invariant is the ideal of `Q` generated by the values of all derivations of `Q` over the
base (`TauCeti.derivationIdeal`). It equals the image of the coordinate critical ideal
`(xy - s, x, y)` (`TauCeti.holomorphicStructureSheaf.derivationIdeal_nodeEquation`), so it pulls
back to `(s)` on the base (`TauCeti.holomorphicStructureSheaf.comap_derivationIdeal_nodeEquation`).

* Every derivation `D` over the base takes values in `(x, y)`. Differentiating `xy = s` gives
  `x D y + y D x = 0`. Restricting this relation to the plane `y = 0`, and then to the plane
  `x = 0`, shows that the values of `D y` and `D x` on the zero section are divisible by `s`,
  so both lie in `(x, y)`; the Leibniz rule handles every other germ.
* Conversely the Euler field `x ∂ₓ - y ∂ᵧ` is tangent to `xy = s(b)` and kills the base, so it
  induces a derivation of `Q` over the base sending `x` to `x` and `y` to `-y`.

## References

* J. W. Robbin and D. A. Salamon, *A construction of the Deligne–Mumford orbifold*,
  J. Eur. Math. Soc. **8** (2006), 611–699, for the local models `xy = a` of nodal families.
* R. C. Gunning and H. Rossi, *Analytic Functions of Several Complex Variables*, Chapter II,
  for restriction and division of holomorphic germs.
-/

public noncomputable section

open Filter Topology
open scoped ContDiff Manifold

namespace TauCeti.holomorphicStructureSheaf

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℂ E] (b : E)

local notation "A" => TopCat.Presheaf.stalk (C := CommRingCat)
  (TopCat.Sheaf.presheaf (holomorphicStructureSheaf 𝓘(ℂ, E) E)) b
local notation "B" => TopCat.Presheaf.stalk (C := CommRingCat)
  (TopCat.Sheaf.presheaf (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ))) (b, (0 : ℂ))
local notation "R" => TopCat.Presheaf.stalk (C := CommRingCat)
  (TopCat.Sheaf.presheaf (holomorphicStructureSheaf 𝓘(ℂ, (E × ℂ) × ℂ)
    ((E × ℂ) × ℂ))) ((b, (0 : ℂ)), (0 : ℂ))

/-! ### Restriction to the two coordinate planes -/

/-- Restriction of an ambient node-chart germ to the plane `x = 0`, with coordinates `(b, y)`. -/
private def restrictFstZero : R →+* B :=
  stalkPrecomp 𝓘(ℂ, E × ℂ) (E × ℂ) (fun w ↦ ((w.1, (0 : ℂ)), w.2))
    (contMDiff_iff_contDiff.mpr (by fun_prop)) (b, 0)

private theorem restrictFstZero_nodeFstCoordinate :
    restrictFstZero b (nodeFstCoordinate b) = 0 := by
  apply toFilterGerm_nhds_injective (b, (0 : ℂ))
  rw [restrictFstZero, toFilterGerm_stalkPrecomp, toFilterGerm_nodeFstCoordinate,
    Germ.coe_compTendsto, map_zero]
  rfl

private theorem restrictFstZero_nodeSndCoordinate :
    restrictFstZero b (nodeSndCoordinate b) = hyperplaneCoordinateGerm b 0 := by
  apply toFilterGerm_nhds_injective (b, (0 : ℂ))
  rw [restrictFstZero, toFilterGerm_stalkPrecomp, toFilterGerm_nodeSndCoordinate,
    Germ.coe_compTendsto, OpenPartialHomeomorph.toFilterGerm_holomorphicLinearCoordinateGerm]
  congr 1
  funext w
  simp

private theorem restrictFstZero_nodeBaseExtension (a : A) :
    restrictFstZero b (nodeBaseExtension b a) =
      stalkPrecomp 𝓘(ℂ, E × ℂ) (E × ℂ) Prod.fst contDiff_fst.contMDiff (b, 0) a := by
  obtain ⟨f, _, hf⟩ := exists_toFilterGerm_eq b a
  apply toFilterGerm_nhds_injective (b, (0 : ℂ))
  rw [restrictFstZero, toFilterGerm_stalkPrecomp, toFilterGerm_nodeBaseExtension b (hf _ le_rfl),
    toFilterGerm_stalkPrecomp, hf _ le_rfl, Germ.coe_compTendsto, Germ.coe_compTendsto]
  rfl

private theorem restrictHyperplane_nodeFstCoordinate :
    restrictHyperplane (b, (0 : ℂ)) 0 (nodeFstCoordinate b) = hyperplaneCoordinateGerm b 0 := by
  apply toFilterGerm_nhds_injective (b, (0 : ℂ))
  rw [toFilterGerm_restrictHyperplane, toFilterGerm_nodeFstCoordinate, Germ.coe_compTendsto,
    OpenPartialHomeomorph.toFilterGerm_holomorphicLinearCoordinateGerm]
  congr 1
  funext w
  simp

private theorem restrictHyperplane_nodeSndCoordinate :
    restrictHyperplane (b, (0 : ℂ)) 0 (nodeSndCoordinate b) = 0 := by
  apply toFilterGerm_nhds_injective (b, (0 : ℂ))
  rw [toFilterGerm_restrictHyperplane, toFilterGerm_nodeSndCoordinate, Germ.coe_compTendsto,
    map_zero]
  rfl

private theorem restrictHyperplane_nodeBaseExtension (a : A) :
    restrictHyperplane (b, (0 : ℂ)) 0 (nodeBaseExtension b a) =
      stalkPrecomp 𝓘(ℂ, E × ℂ) (E × ℂ) Prod.fst contDiff_fst.contMDiff (b, 0) a := by
  obtain ⟨f, _, hf⟩ := exists_toFilterGerm_eq b a
  apply toFilterGerm_nhds_injective (b, (0 : ℂ))
  rw [toFilterGerm_restrictHyperplane, toFilterGerm_nodeBaseExtension b (hf _ le_rfl),
    toFilterGerm_stalkPrecomp, hf _ le_rfl, Germ.coe_compTendsto, Germ.coe_compTendsto]
  rfl

/-! ### Derivations take values in `(x, y)` -/

section Divisibility

variable [FiniteDimensional ℂ E] {b}

/-- In the coordinates `(b, w)` of `E × ℂ`, if `a w ∈ (w², s)` for base germs `a` and `s`, then
`s` divides `a`. -/
private theorem dvd_of_mul_hyperplaneCoordinateGerm_eq {a s : A} {u v : B}
    (h : stalkPrecomp 𝓘(ℂ, E × ℂ) (E × ℂ) Prod.fst contDiff_fst.contMDiff (b, 0) a *
        hyperplaneCoordinateGerm b 0 = hyperplaneCoordinateGerm b 0 ^ 2 * u +
      stalkPrecomp 𝓘(ℂ, E × ℂ) (E × ℂ) Prod.fst contDiff_fst.contMDiff (b, 0) s * v) :
    s ∣ a := by
  have hT : hyperplaneCoordinateGerm b 0 ≠ 0 := hyperplaneCoordinateGerm_ne_zero b 0
  rcases eq_or_ne s 0 with rfl | hs
  · have hu : stalkPrecomp 𝓘(ℂ, E × ℂ) (E × ℂ) Prod.fst contDiff_fst.contMDiff (b, 0) a =
        hyperplaneCoordinateGerm b 0 * u := mul_right_cancel₀ hT (by rw [h, map_zero]; ring)
    have ha := congrArg (restrictHyperplane b 0) hu
    rw [restrictHyperplane_stalkPrecomp_fst, map_mul, restrictHyperplane_hyperplaneCoordinateGerm,
      zero_mul] at ha
    rw [ha]
  · have hr := congrArg (restrictHyperplane b 0) h
    rw [map_add, map_mul, map_mul, map_mul, map_pow, restrictHyperplane_stalkPrecomp_fst,
      restrictHyperplane_stalkPrecomp_fst, restrictHyperplane_hyperplaneCoordinateGerm] at hr
    have hv : restrictHyperplane b 0 v = 0 :=
      (mul_eq_zero.1 (by linear_combination -hr)).resolve_left hs
    obtain ⟨w, rfl⟩ : hyperplaneCoordinateGerm b 0 ∣ v := by
      rw [← Ideal.mem_span_singleton, ← ker_restrictHyperplane]
      exact hv
    have hw : stalkPrecomp 𝓘(ℂ, E × ℂ) (E × ℂ) Prod.fst contDiff_fst.contMDiff (b, 0) a =
        hyperplaneCoordinateGerm b 0 * u +
          stalkPrecomp 𝓘(ℂ, E × ℂ) (E × ℂ) Prod.fst contDiff_fst.contMDiff (b, 0) s * w :=
      mul_right_cancel₀ hT (by rw [h]; ring)
    have ha := congrArg (restrictHyperplane b 0) hw
    rw [map_add, map_mul, map_mul, restrictHyperplane_stalkPrecomp_fst,
      restrictHyperplane_stalkPrecomp_fst, restrictHyperplane_hyperplaneCoordinateGerm, zero_mul,
      zero_add] at ha
    exact ⟨_, ha⟩

/-- If `P f + P' c ∈ (xy - s)`, where restriction `ρ` to a coordinate plane sends `P` to the
remaining fibre coordinate and kills `P'`, then the value of `f` on the zero section is divisible
by `s`. Here `{P, P'}` is `{x, y}` in either order. -/
private theorem dvd_nodeBaseRestriction_of_mem {ρ : R →+* B}
    (hρ : ∀ a, ρ (nodeBaseExtension b a) =
      stalkPrecomp 𝓘(ℂ, E × ℂ) (E × ℂ) Prod.fst contDiff_fst.contMDiff (b, 0) a)
    {P P' : R} (hP : ρ P = hyperplaneCoordinateGerm b 0) (hP' : ρ P' = 0)
    (hspan : Ideal.span {P, P'} = Ideal.span {nodeFstCoordinate b, nodeSndCoordinate b})
    (hPP' : P * P' = nodeFstCoordinate b * nodeSndCoordinate b) {s : A} {f c : R}
    (h : P * f + P' * c ∈ Ideal.span {nodeEquation b 0 0 s}) :
    s ∣ nodeBaseRestriction b f := by
  set a := nodeBaseRestriction b f
  have hker : f - nodeBaseExtension b a ∈ Ideal.span {P, P'} := by
    rw [hspan, ← ker_nodeBaseRestriction, RingHom.mem_ker, map_sub,
      nodeBaseRestriction_nodeBaseExtension, sub_self]
  obtain ⟨g, g', hg⟩ := Ideal.mem_span_pair.1 hker
  obtain ⟨k, hk⟩ := Ideal.mem_span_singleton'.1 h
  have hf : f = nodeBaseExtension b a + (g * P + g' * P') := by rw [hg]; ring
  have hρk := congrArg ρ hk
  rw [nodeEquation_eq_mul_sub, ← hPP', hf] at hρk
  simp only [map_mul, map_add, map_sub, hP, hP', hρ] at hρk
  exact dvd_of_mul_hyperplaneCoordinateGerm_eq (u := -ρ g) (v := -ρ k)
    (by linear_combination -hρk)

end Divisibility

/-- The image of the coordinate critical ideal in the local ring of the node is `(x, y)`. -/
private theorem map_nodeCriticalIdeal (s : A) :
    (nodeCriticalIdeal b s).map (Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 s})) =
      Ideal.span {Ideal.Quotient.mk _ (nodeFstCoordinate b),
        Ideal.Quotient.mk _ (nodeSndCoordinate b)} := by
  rw [nodeCriticalIdeal_eq_span_sup_ker, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq,
    ker_nodeBaseRestriction, Ideal.map_span, Set.image_pair]

/-- The ideal pulled back from the image of the coordinate critical ideal is `(s)`. -/
private theorem comap_map_nodeCriticalIdeal (s : A) :
    ((nodeCriticalIdeal b s).map (Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 s}))).comap
      ((Ideal.Quotient.mk _).comp (nodeBaseExtension b)) = Ideal.span {s} := by
  rw [← Ideal.comap_comap, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
    ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.2,
    comap_nodeBaseExtension_nodeCriticalIdeal]
  rw [nodeCriticalIdeal_eq_span_sup_ker]
  exact le_sup_left

/-! ### The Euler derivation -/

/-- The Euler vector field `x ∂ₓ - y ∂ᵧ` on the node chart, tangent to every `xy = s(b)`. -/
private def nodeEulerField : ((E × ℂ) × ℂ) →L[ℂ] (E × ℂ) × ℂ :=
  ((ContinuousLinearMap.inr ℂ E ℂ).comp
    ((ContinuousLinearMap.snd ℂ E ℂ).comp (ContinuousLinearMap.fst ℂ (E × ℂ) ℂ))).prod
      (-ContinuousLinearMap.snd ℂ (E × ℂ) ℂ)

private theorem nodeEulerField_apply (z : (E × ℂ) × ℂ) :
    nodeEulerField z = ((0, z.1.2), -z.2) :=
  (rfl)

/-- The Euler field differentiates holomorphic germs at the node. -/
private def nodeEulerDerivation : Derivation ℤ R R :=
  stalkDerivative nodeEulerField ((nodeEulerField (E := E)).analyticAt _)

private theorem nodeEulerDerivation_nodeFstCoordinate :
    nodeEulerDerivation b (nodeFstCoordinate b) = nodeFstCoordinate b := by
  apply toFilterGerm_nhds_injective ((b, (0 : ℂ)), (0 : ℂ))
  rw [nodeEulerDerivation, toFilterGerm_stalkDerivative _ (toFilterGerm_nodeFstCoordinate b),
    toFilterGerm_nodeFstCoordinate]
  congr 1
  funext z
  -- The first fibre coordinate is a continuous linear map.
  rw [show (fun z : (E × ℂ) × ℂ ↦ z.1.2) = (ContinuousLinearMap.snd ℂ E ℂ).comp
    (ContinuousLinearMap.fst ℂ (E × ℂ) ℂ) from rfl, ContinuousLinearMap.fderiv]
  simp [nodeEulerField_apply]

private theorem nodeEulerDerivation_nodeSndCoordinate :
    nodeEulerDerivation b (nodeSndCoordinate b) = -nodeSndCoordinate b := by
  apply toFilterGerm_nhds_injective ((b, (0 : ℂ)), (0 : ℂ))
  rw [nodeEulerDerivation, toFilterGerm_stalkDerivative _ (toFilterGerm_nodeSndCoordinate b),
    map_neg, toFilterGerm_nodeSndCoordinate, ← Germ.coe_neg]
  congr 1
  funext z
  -- The second fibre coordinate is a continuous linear map.
  rw [show (fun z : (E × ℂ) × ℂ ↦ z.2) = ContinuousLinearMap.snd ℂ (E × ℂ) ℂ from rfl,
    ContinuousLinearMap.fderiv]
  simp [nodeEulerField_apply]

private theorem nodeEulerDerivation_nodeBaseExtension (a : A) :
    nodeEulerDerivation b (nodeBaseExtension b a) = 0 := by
  obtain ⟨f, hfa, hf⟩ := exists_analyticAt_toFilterGerm_eq b a
  apply toFilterGerm_nhds_injective ((b, (0 : ℂ)), (0 : ℂ))
  rw [nodeEulerDerivation,
    toFilterGerm_stalkDerivative _ (toFilterGerm_nodeBaseExtension b (hf _ le_rfl)), map_zero,
    ← Germ.coe_zero, Germ.coe_eq]
  have hb : Tendsto (fun z : (E × ℂ) × ℂ ↦ z.1.1) (𝓝 ((b, (0 : ℂ)), (0 : ℂ))) (𝓝 b) :=
    continuous_fst.fst.continuousAt.tendsto
  filter_upwards [hb.eventually hfa.eventually_analyticAt] with z hz
  -- The base projection is a continuous linear map killing the Euler field.
  let π := (ContinuousLinearMap.fst ℂ E ℂ).comp (ContinuousLinearMap.fst ℂ (E × ℂ) ℂ)
  rw [show (fun z : (E × ℂ) × ℂ ↦ f z.1.1) = f ∘ π from rfl,
    fderiv_comp z hz.differentiableAt π.differentiableAt, π.fderiv]
  simp [π, nodeEulerField_apply]

/-- The Euler derivation is tangent to the node family: it kills its defining equation. -/
private theorem nodeEulerDerivation_nodeEquation (s : A) :
    nodeEulerDerivation b (nodeEquation b 0 0 s) = 0 := by
  rw [nodeEquation_eq_mul_sub, map_sub, Derivation.leibniz, nodeEulerDerivation_nodeFstCoordinate,
    nodeEulerDerivation_nodeSndCoordinate, nodeEulerDerivation_nodeBaseExtension, smul_eq_mul,
    smul_eq_mul]
  ring

/-- The Euler derivation descended to the local ring of the node. -/
private def nodeEulerQuotientDerivation (s : A) :
    Derivation ℤ (R ⧸ Ideal.span {nodeEquation b 0 0 s}) (R ⧸ Ideal.span {nodeEquation b 0 0 s}) :=
  ((Algebra.linearMap R _).compDer (nodeEulerDerivation b)).liftQuotient _ fun _ hf ↦
    Derivation.apply_eq_zero_of_mem_span _
      (fun _ ha m ↦ by
        rw [Set.mem_singleton_iff.1 ha, Algebra.smul_def, Ideal.Quotient.algebraMap_eq,
          Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span rfl), zero_mul])
      (fun _ ha ↦ by
        rw [Set.mem_singleton_iff.1 ha]
        simp [Derivation.coe_comp, nodeEulerDerivation_nodeEquation]) hf

private theorem nodeEulerQuotientDerivation_mk (s : A) (f : R) :
    nodeEulerQuotientDerivation b s (Ideal.Quotient.mk _ f) =
      Ideal.Quotient.mk _ (nodeEulerDerivation b f) := by
  simp [nodeEulerQuotientDerivation, Derivation.coe_comp]

/-- The local ring of the node has derivations over the base reaching both branch coordinates. -/
private theorem le_derivationIdeal_nodeEquation (s : A) :
    letI := ((Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 s})).comp
      (nodeBaseExtension b)).toAlgebra
    (nodeCriticalIdeal b s).map (Ideal.Quotient.mk _) ≤
      derivationIdeal A (R ⧸ Ideal.span {nodeEquation b 0 0 s}) :=
  letI := ((Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 s})).comp
    (nodeBaseExtension b)).toAlgebra
  by
  rw [map_nodeCriticalIdeal, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
  -- The descended Euler derivation sends `x` to `x` and `y` to `-y`, and kills the base.
  have hD (f : R) : Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 s})
      (nodeEulerDerivation b f) ∈ derivationIdeal A (R ⧸ Ideal.span {nodeEquation b 0 0 s}) := by
    rw [← nodeEulerQuotientDerivation_mk]
    exact apply_mem_derivationIdeal_of_map_algebraMap _ (fun a : A ↦
      (nodeEulerQuotientDerivation_mk b s (nodeBaseExtension b a)).trans (by
        rw [nodeEulerDerivation_nodeBaseExtension, map_zero])) _
  have hx := hD (nodeFstCoordinate b)
  have hy := hD (nodeSndCoordinate b)
  rw [nodeEulerDerivation_nodeFstCoordinate] at hx
  rw [nodeEulerDerivation_nodeSndCoordinate, map_neg, neg_mem_iff] at hy
  exact ⟨hx, hy⟩

variable [FiniteDimensional ℂ E]

/-- An additive derivation of the local ring `R ⧸ I` of the node that kills the base germs takes
values in the image of the coordinate critical ideal `(xy - s, x, y)`. -/
private theorem derivation_apply_mem_map_nodeCriticalIdeal {s : A} {I : Ideal R}
    (hI : I = Ideal.span {nodeEquation b 0 0 s}) (D : Derivation ℤ (R ⧸ I) (R ⧸ I))
    (hbase : ∀ a, D (Ideal.Quotient.mk I (nodeBaseExtension b a)) = 0) (q : R ⧸ I) :
    D q ∈ (nodeCriticalIdeal b s).map (Ideal.Quotient.mk I) := by
  subst hI
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective q
  set J := (nodeCriticalIdeal b s).map (Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 s}))
  set π := Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 s})
  set x := nodeFstCoordinate b
  set y := nodeSndCoordinate b
  -- A germ whose value on the zero section is divisible by `s` lies in the critical ideal.
  have hdvd (f : R) (hf : s ∣ nodeBaseRestriction b f) : π f ∈ J :=
    Ideal.mem_map_of_mem _ ((mem_nodeCriticalIdeal_iff b s f).2 hf)
  have hx : π x ∈ J := hdvd x (by simp [x])
  have hy : π y ∈ J := hdvd y (by simp [y])
  have hxy : π x * π y = π (nodeBaseExtension b s) := by
    rw [← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem,
      ← nodeEquation_eq_mul_sub]
    exact Ideal.subset_span rfl
  obtain ⟨c, hc⟩ : ∃ c, π c = D (π x) := Ideal.Quotient.mk_surjective _
  obtain ⟨d, hd⟩ : ∃ d, π d = D (π y) := Ideal.Quotient.mk_surjective _
  -- Differentiating `xy = s` gives `x D y + y D x = 0`.
  have hrel : x * d + y * c ∈ Ideal.span {nodeEquation b 0 0 s} := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_add, map_mul, map_mul, hc, hd, ← smul_eq_mul,
      ← smul_eq_mul, ← D.leibniz, hxy, hbase]
  have hDx : D (π x) ∈ J := hc ▸ hdvd c
    (dvd_nodeBaseRestriction_of_mem (restrictFstZero_nodeBaseExtension b)
      (restrictFstZero_nodeSndCoordinate b) (restrictFstZero_nodeFstCoordinate b)
      Ideal.span_pair_comm (mul_comm _ _) (by rwa [add_comm] at hrel))
  have hDy : D (π y) ∈ J := hd ▸ hdvd d
    (dvd_nodeBaseRestriction_of_mem (restrictHyperplane_nodeBaseExtension b)
      (restrictHyperplane_nodeFstCoordinate b) (restrictHyperplane_nodeSndCoordinate b) rfl rfl
      hrel)
  -- Decompose the representative `f` as a base germ plus an element of `(x, y)`.
  have hker : f - nodeBaseExtension b (nodeBaseRestriction b f) ∈ Ideal.span {x, y} := by
    rw [← ker_nodeBaseRestriction, RingHom.mem_ker, map_sub,
      nodeBaseRestriction_nodeBaseExtension, sub_self]
  obtain ⟨g, g', hg⟩ := Ideal.mem_span_pair.1 hker
  have hf : f = nodeBaseExtension b (nodeBaseRestriction b f) + (g * x + g' * y) := by
    rw [hg]; ring
  rw [hf]
  simp only [map_add, map_mul, Derivation.leibniz, smul_eq_mul, hbase, zero_add]
  -- Each Leibniz term has a factor `x`, `y`, `D x` or `D y`, all of which lie in `J`.
  repeat' apply J.add_mem
  all_goals first
    | exact J.mul_mem_left _ hDx | exact J.mul_mem_left _ hDy
    | exact J.mul_mem_right _ hx | exact J.mul_mem_right _ hy

/-- Every derivation of the local ring of the node over the base takes values in the image of the
coordinate critical ideal `(xy - s, x, y)`. -/
private theorem derivationIdeal_nodeEquation_le (s : A) :
    letI := ((Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 s})).comp
      (nodeBaseExtension b)).toAlgebra
    derivationIdeal A (R ⧸ Ideal.span {nodeEquation b 0 0 s}) ≤
      (nodeCriticalIdeal b s).map (Ideal.Quotient.mk _) :=
  letI := ((Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 s})).comp
    (nodeBaseExtension b)).toAlgebra
  derivationIdeal_le_iff.2 fun D ↦ derivation_apply_mem_map_nodeCriticalIdeal b rfl
    (D.restrictScalars ℤ) fun a ↦ D.map_algebraMap a

/-! ### The intrinsic smoothing ideal -/

/-- **Derivations of the node ring.** The ideal generated by the values of all derivations of the
local ring `𝒪 ⧸ (xy - s(b))` of the node over the base germs is the image of the coordinate critical
ideal `(xy - s, x, y)`, that is, the ideal `(x, y)` of the node. -/
theorem derivationIdeal_nodeEquation (s : A) :
    letI := ((Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 s})).comp
      (nodeBaseExtension b)).toAlgebra
    derivationIdeal A (R ⧸ Ideal.span {nodeEquation b 0 0 s}) =
      (nodeCriticalIdeal b s).map (Ideal.Quotient.mk _) :=
  le_antisymm (derivationIdeal_nodeEquation_le b s) (le_derivationIdeal_nodeEquation b s)

/-- **The smoothing ideal from derivations.** The ideal of the node ring generated by the values of
its derivations over the base pulls back to the ideal `(s)` of the base. -/
theorem comap_derivationIdeal_nodeEquation (s : A) :
    letI := ((Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 s})).comp
      (nodeBaseExtension b)).toAlgebra
    (derivationIdeal A (R ⧸ Ideal.span {nodeEquation b 0 0 s})).comap
      (algebraMap A (R ⧸ Ideal.span {nodeEquation b 0 0 s})) = Ideal.span {s} := by
  rw [derivationIdeal_nodeEquation, RingHom.algebraMap_toAlgebra, comap_map_nodeCriticalIdeal]

/-- **The smoothing parameter is intrinsic up to a unit.** If the local rings at the node of
`xy = s(b)` and of `xy = t(b)` are isomorphic as algebras over the base germs at `b`, then `s` and
`t` differ by a unit. The isomorphism need not respect any choice of node coordinates. -/
theorem associated_of_ringEquiv_nodeEquation {s t : A}
    (e : R ⧸ Ideal.span {nodeEquation b 0 0 s} ≃+* R ⧸ Ideal.span {nodeEquation b 0 0 t})
    (he : ∀ a, e (Ideal.Quotient.mk _ (nodeBaseExtension b a)) =
      Ideal.Quotient.mk _ (nodeBaseExtension b a)) :
    Associated s t :=
  letI := ((Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 s})).comp
    (nodeBaseExtension b)).toAlgebra
  letI := ((Ideal.Quotient.mk (Ideal.span {nodeEquation b 0 0 t})).comp
    (nodeBaseExtension b)).toAlgebra
  -- The base ideals cut out by the derivations of the two isomorphic algebras agree.
  Ideal.span_singleton_eq_span_singleton.1 <| (comap_derivationIdeal_nodeEquation b s).symm.trans <|
    (comap_algebraMap_derivationIdeal ({ e with commutes' := he } : _ ≃ₐ[A] _)).symm.trans
      (comap_derivationIdeal_nodeEquation b t)

end TauCeti.holomorphicStructureSheaf
