module

public import TauCeti.Geometry.Manifold.Complex.StructureSheaf.Germ
import TauCeti.Analysis.Analytic.ConstantOrder.Basic
import TauCeti.Geometry.Manifold.ContMDiff.Analytic

/-!
# Product charts of the smoothing family `xy = s(b)` off its nodes

The local model for smoothing a node over a base `E` is the hypersurface
`N_s = {(b, x, y) ∈ E × ℂ × ℂ | xy = s(b)}`, for a holomorphic smoothing parameter `s` on `E`.
Its local ring at a point `p` is the quotient of the ring of holomorphic germs at `p` on
`E × ℂ × ℂ` by the local equation `xy - s(b)`
(`TauCeti.holomorphicStructureSheaf.smoothingEquation`; here `s` is a holomorphic germ at the base
point of `p`). The total space can be singular, at the points with `x = y = 0`. This file shows
that away from these points `N_s` is a product chart:

* where `x ≠ 0`, the projection `(b, x, y) ↦ (b, x)` identifies the local ring of `N_s` with the
  ring of holomorphic germs on `E × ℂ` (`TauCeti.holomorphicStructureSheaf.offNodeChartFstEquiv`);
  in this chart `N_s` is the graph `y = s(b)/x`;
* where `y ≠ 0`, the projection `(b, x, y) ↦ (b, y)` does the same
  (`TauCeti.holomorphicStructureSheaf.offNodeChartSndEquiv`), with `N_s` the graph `x = s(b)/y`.

No condition is imposed on `s`: it may vanish identically (permanent nodes) or to higher order.

Both statements are instances of a general fact
(`TauCeti.holomorphicStructureSheaf.quotientMk_comp_stalkPrecomp_bijective`): if an ideal of the
holomorphic germs at `p` consists exactly of the germs vanishing along a holomorphic local section
`σ` through `p` of a holomorphic map `π`, then pulling back along `π` identifies the germs at
`π p` with the quotient by that ideal. For `N_s` the ideal generated by `xy - s(b)` is of this kind
by Hadamard's lemma along the graph (`AnalyticAt.exists_eventuallyEq_sub_smul_of_graph`): a germ
vanishing on `y = s(b)/x` is `(y - s(b)/x)` times a holomorphic germ, that is `(xy - s(b))` times
one since `x` is invertible near `p` (`AnalyticAt.exists_eventuallyEq_mul_sub_smul_of_fst_ne_zero`).
The inverse charts restrict a germ to the graph
(`TauCeti.holomorphicStructureSheaf.toFilterGerm_offNodeChartFstEquiv_symm`).

## References

* J. W. Robbin and D. A. Salamon, *A construction of the Deligne–Mumford orbifold*,
  J. Eur. Math. Soc. **8** (2006), 611–699, for the local models `xy = a` of nodal families.
* R. C. Gunning and H. Rossi, *Analytic Functions of Several Complex Variables*, Chapter II,
  for the local rings of holomorphic germs in several variables.
-/

public noncomputable section

open CategoryTheory Filter Function Topology
open scoped ContDiff Manifold

namespace TauCeti.holomorphicStructureSheaf

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-! ### The local equation -/

/-- The local equation `xy - s(b)` of the smoothing family `N_s` at a point `p = (b, x, y)` of
`E × ℂ × ℂ`, as a holomorphic germ at `p`, for the germ `s` of the smoothing parameter at the base
point `b`. -/
def smoothingEquation (p : E × ℂ × ℂ)
    (s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1) :
    (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p :=
  germOfContMDiff (fun q : E × ℂ × ℂ ↦ q.2.1 * q.2.2) (contMDiff_iff_contDiff.2 (by fun_prop)) p -
    stalkPrecomp 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) Prod.fst (contMDiff_iff_contDiff.2 contDiff_fst) p s

/-- If `S` represents the germ `s`, then `xy - S(b)` represents the local equation. -/
theorem toFilterGerm_smoothingEquation {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S) :
    toFilterGerm 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p (𝓝 p) le_rfl (smoothingEquation p s) =
      (fun q : E × ℂ × ℂ ↦ q.2.1 * q.2.2 - S q.1) := by
  rw [smoothingEquation, map_sub, toFilterGerm_germOfContMDiff, toFilterGerm_stalkPrecomp, hS,
    Germ.coe_compTendsto, ← Germ.coe_sub]
  rfl

/-- The value of the local equation at `p = (b, x, y)` is `xy - s(b)`; it vanishes exactly when
`p` lies on `N_s`. -/
@[simp]
theorem eval_smoothingEquation (p : E × ℂ × ℂ)
    (s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1) :
    eval 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p (smoothingEquation p s) =
      p.2.1 * p.2.2 - eval 𝓘(ℂ, E) E p.1 s := by
  obtain ⟨S, -, hS⟩ := exists_toFilterGerm_eq p.1 s
  rw [eval_eq_of_toFilterGerm_eq (toFilterGerm_smoothingEquation (hS _ le_rfl)),
    eval_eq_of_toFilterGerm_eq (hS _ le_rfl)]

/-! ### The ideal of the local equation along a graph -/

/-- Membership in the ideal generated by the local equation, for a graph `σ` inside `N_s` along
which the division lemma holds. -/
private theorem mem_span_smoothingEquation_iff {V : Type*} [TopologicalSpace V] {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S) {σ : V → E × ℂ × ℂ} {w₀ : V}
    (hσ : Tendsto σ (𝓝 w₀) (𝓝 p)) (hσS : ∀ᶠ w in 𝓝 w₀, (σ w).2.1 * (σ w).2.2 = S (σ w).1)
    (hdiv : ∀ G : E × ℂ × ℂ → ℂ, AnalyticAt ℂ G p → (∀ᶠ w in 𝓝 w₀, G (σ w) = 0) →
      ∃ K : E × ℂ × ℂ → ℂ, AnalyticAt ℂ K p ∧
        ∀ᶠ q in 𝓝 p, G q = (q.2.1 * q.2.2 - S q.1) * K q)
    (g : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p)
    (G : E × ℂ × ℂ → ℂ) (hgG : toFilterGerm 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p (𝓝 p) le_rfl g = G) :
    g ∈ Ideal.span {smoothingEquation p s} ↔ ∀ᶠ w in 𝓝 w₀, G (σ w) = 0 := by
  have heq := toFilterGerm_smoothingEquation hS
  constructor
  · rw [Ideal.mem_span_singleton']
    rintro ⟨k, rfl⟩
    obtain ⟨K, -, hK⟩ := exists_toFilterGerm_eq p k
    rw [map_mul, hK _ le_rfl, heq, ← Germ.coe_mul, Germ.coe_eq] at hgG
    filter_upwards [hσ.eventually hgG, hσS] with w hw hwS
    rw [← hw, Pi.mul_apply, hwS, sub_self, mul_zero]
  · intro h0
    obtain ⟨G', hG', hgG'⟩ := exists_toFilterGerm_eq p g
    rw [hgG' _ le_rfl, Germ.coe_eq] at hgG
    obtain ⟨K, hK, hGK⟩ := hdiv G'
      (contMDiffAt_modelSpace_omega_iff_analyticAt.1 hG'.self_of_nhds)
      (by filter_upwards [hσ.eventually hgG, h0] with w hw hw0; rw [hw, hw0])
    obtain ⟨k, hk⟩ := exists_toFilterGerm_eq_of_eventually_contMDiffAt
      (hK.eventually_analyticAt.mono fun _ ↦ contMDiffAt_modelSpace_omega_iff_analyticAt.2)
    refine Ideal.mem_span_singleton'.2 ⟨k, toFilterGerm_nhds_injective p ?_⟩
    rw [map_mul, hk _ le_rfl, heq, hgG' _ le_rfl, ← Germ.coe_mul, Germ.coe_eq]
    filter_upwards [hGK] with q hq
    rw [hq, Pi.mul_apply, mul_comm]

/-- Any representative `S` of the germ `s` at a point of `N_s` is analytic at the base point,
where its value is `xy`. -/
private theorem contDiffAt_and_eq_of_toFilterGerm_eq {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1}
    (hs : eval 𝓘(ℂ, E) E p.1 s = p.2.1 * p.2.2) {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S) :
    ContDiffAt ℂ ω S p.1 ∧ S p.1 = p.2.1 * p.2.2 :=
  ⟨contMDiffAt_iff_contDiffAt.1 (exists_toFilterGerm_nhds_eq_iff.1 ⟨s, hS⟩).self_of_nhds,
    (eval_eq_of_toFilterGerm_eq hS).symm.trans hs⟩

/-- Where `x ≠ 0`, the graph `(b, x) ↦ (b, x, S(b)/x)` is analytic and passes through `p`. -/
private theorem graph_of_fst_ne_zero {p : E × ℂ × ℂ} {S : E → ℂ} (hSa : ContDiffAt ℂ ω S p.1)
    (hSp : S p.1 = p.2.1 * p.2.2) (hx : p.2.1 ≠ 0) :
    ContDiffAt ℂ ω (fun w : E × ℂ ↦ (w.1, w.2, S w.1 / w.2)) (p.1, p.2.1) ∧
      (p.1, p.2.1, S p.1 / p.2.1) = p :=
  ⟨contDiffAt_fst.prodMk (contDiffAt_snd.prodMk
    ((hSa.comp (p.1, p.2.1) contDiffAt_fst).div contDiffAt_snd hx)),
    by rw [hSp, mul_div_cancel_left₀ _ hx]⟩

/-- Where `y ≠ 0`, the graph `(b, y) ↦ (b, S(b)/y, y)` is analytic and passes through `p`. -/
private theorem graph_of_snd_ne_zero {p : E × ℂ × ℂ} {S : E → ℂ} (hSa : ContDiffAt ℂ ω S p.1)
    (hSp : S p.1 = p.2.1 * p.2.2) (hy : p.2.2 ≠ 0) :
    ContDiffAt ℂ ω (fun w : E × ℂ ↦ (w.1, S w.1 / w.2, w.2)) (p.1, p.2.2) ∧
      (p.1, S p.1 / p.2.2, p.2.2) = p :=
  ⟨contDiffAt_fst.prodMk (((hSa.comp (p.1, p.2.2) contDiffAt_fst).div contDiffAt_snd hy).prodMk
    contDiffAt_snd), by rw [hSp, mul_div_cancel_right₀ _ hy]⟩

/-- At a point of `N_s` where `x ≠ 0`, a germ lies in the ideal of the local equation exactly when
it vanishes on the graph `y = S(b)/x`, for representatives `G` of the germ and `S` of `s`. -/
theorem mem_span_smoothingEquation_iff_of_fst_ne_zero {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} (hx : p.2.1 ≠ 0)
    (hs : eval 𝓘(ℂ, E) E p.1 s = p.2.1 * p.2.2) {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S)
    (g : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p)
    (G : E × ℂ × ℂ → ℂ) (hgG : toFilterGerm 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p (𝓝 p) le_rfl g = G) :
    g ∈ Ideal.span {smoothingEquation p s} ↔
      ∀ᶠ w in 𝓝 (p.1, p.2.1), G (w.1, w.2, S w.1 / w.2) = 0 := by
  obtain ⟨hSa, hSp⟩ := contDiffAt_and_eq_of_toFilterGerm_eq hs hS
  obtain ⟨hσ, hσp⟩ := graph_of_fst_ne_zero hSa hSp hx
  have hσt := hσ.continuousAt.tendsto
  rw [hσp] at hσt
  refine mem_span_smoothingEquation_iff hS hσt ?_ (fun G hG h0 ↦ by
    simpa only [smul_eq_mul] using
      hG.exists_eventuallyEq_mul_sub_smul_of_fst_ne_zero hSa.analyticAt hx hSp h0) g G hgG
  filter_upwards [continuous_snd.continuousAt.eventually_ne hx] with w hw
  exact mul_div_cancel₀ _ hw

/-- At a point of `N_s` where `y ≠ 0`, a germ lies in the ideal of the local equation exactly when
it vanishes on the graph `x = S(b)/y`, for representatives `G` of the germ and `S` of `s`. -/
theorem mem_span_smoothingEquation_iff_of_snd_ne_zero {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} (hy : p.2.2 ≠ 0)
    (hs : eval 𝓘(ℂ, E) E p.1 s = p.2.1 * p.2.2) {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S)
    (g : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p)
    (G : E × ℂ × ℂ → ℂ) (hgG : toFilterGerm 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p (𝓝 p) le_rfl g = G) :
    g ∈ Ideal.span {smoothingEquation p s} ↔
      ∀ᶠ w in 𝓝 (p.1, p.2.2), G (w.1, S w.1 / w.2, w.2) = 0 := by
  obtain ⟨hSa, hSp⟩ := contDiffAt_and_eq_of_toFilterGerm_eq hs hS
  obtain ⟨hσ, hσp⟩ := graph_of_snd_ne_zero hSa hSp hy
  have hσt := hσ.continuousAt.tendsto
  rw [hσp] at hσt
  refine mem_span_smoothingEquation_iff hS hσt ?_ (fun G hG h0 ↦ by
    simpa only [smul_eq_mul] using
      hG.exists_eventuallyEq_mul_sub_smul_of_snd_ne_zero hSa.analyticAt hy hSp h0) g G hgG
  filter_upwards [continuous_snd.continuousAt.eventually_ne hy] with w hw
  exact div_mul_cancel₀ _ hw

/-! ### The chart `x ≠ 0` -/

/-- Pullback along the projection `(b, x, y) ↦ (b, x)`, followed by restriction to `N_s`: the
holomorphic germs at `(b, x)` on `E × ℂ` map to the local ring of `N_s` at `p = (b, x, y)`. -/
def offNodeChartFst (p : E × ℂ × ℂ)
    (s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1) :
    (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (p.1, p.2.1) →+*
      (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p ⧸
        Ideal.span {smoothingEquation p s} :=
  (Ideal.Quotient.mk _).comp (stalkPrecomp 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)
    (fun q : E × ℂ × ℂ ↦ (q.1, q.2.1)) (contMDiff_iff_contDiff.2 (by fun_prop)) p)

/-- `offNodeChartFst` is the class of the pullback along `(b, x, y) ↦ (b, x)`. -/
@[simp]
theorem offNodeChartFst_apply (p : E × ℂ × ℂ)
    (s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1)
    (h : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (p.1, p.2.1)) :
    offNodeChartFst p s h = Ideal.Quotient.mk _ (stalkPrecomp 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)
      (fun q : E × ℂ × ℂ ↦ (q.1, q.2.1)) (contMDiff_iff_contDiff.2 (by fun_prop)) p h) :=
  (rfl)

/-- **Product chart where `x ≠ 0`.** At a point `p = (b, x, y)` of `N_s` with `x ≠ 0`, the
projection `(b, x, y) ↦ (b, x)` identifies the local ring of `N_s` with the holomorphic germs on
`E × ℂ` at `(b, x)`. -/
theorem offNodeChartFst_bijective {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} (hx : p.2.1 ≠ 0)
    (hs : eval 𝓘(ℂ, E) E p.1 s = p.2.1 * p.2.2) : Bijective (offNodeChartFst p s) := by
  obtain ⟨S, -, hS⟩ := exists_toFilterGerm_eq p.1 s
  obtain ⟨hSa, hSp⟩ := contDiffAt_and_eq_of_toFilterGerm_eq hs (hS _ le_rfl)
  obtain ⟨hσ, hσp⟩ := graph_of_fst_ne_zero hSa hSp hx
  exact quotientMk_comp_stalkPrecomp_bijective _ hσ hσp (Eventually.of_forall fun _ ↦ rfl) _
    (mem_span_smoothingEquation_iff_of_fst_ne_zero hx hs (hS _ le_rfl))

/-- **Product chart where `x ≠ 0`**, as a ring isomorphism between the holomorphic germs on
`E × ℂ` at `(b, x)` and the local ring of `N_s` at `p = (b, x, y)`. -/
def offNodeChartFstEquiv {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} (hx : p.2.1 ≠ 0)
    (hs : eval 𝓘(ℂ, E) E p.1 s = p.2.1 * p.2.2) :
    (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (p.1, p.2.1) ≃+*
      (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p ⧸
        Ideal.span {smoothingEquation p s} :=
  RingEquiv.ofBijective _ (offNodeChartFst_bijective hx hs)

/-- The isomorphism `offNodeChartFstEquiv` is the map `offNodeChartFst`. -/
@[simp]
theorem offNodeChartFstEquiv_apply {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} (hx : p.2.1 ≠ 0)
    (hs : eval 𝓘(ℂ, E) E p.1 s = p.2.1 * p.2.2)
    (h : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (p.1, p.2.1)) :
    offNodeChartFstEquiv hx hs h = offNodeChartFst p s h :=
  (rfl)

/-- **The inverse chart where `x ≠ 0`** restricts to the graph `y = s(b)/x`: if `G` represents
`g` and `S` represents `s`, then the germ corresponding to the class of `g` is represented by
`(b, x) ↦ G (b, x, S(b)/x)`. -/
theorem toFilterGerm_offNodeChartFstEquiv_symm {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} (hx : p.2.1 ≠ 0)
    (hs : eval 𝓘(ℂ, E) E p.1 s = p.2.1 * p.2.2) {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S)
    {g : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p}
    {G : E × ℂ × ℂ → ℂ} (hgG : toFilterGerm 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p (𝓝 p) le_rfl g = G) :
    toFilterGerm 𝓘(ℂ, E × ℂ) (E × ℂ) (p.1, p.2.1) (𝓝 (p.1, p.2.1)) le_rfl
        ((offNodeChartFstEquiv hx hs).symm (Ideal.Quotient.mk _ g)) =
      (fun w : E × ℂ ↦ G (w.1, w.2, S w.1 / w.2)) :=
  toFilterGerm_eq_comp_of_quotientMk_stalkPrecomp_eq (π := fun q : E × ℂ × ℂ ↦ (q.1, q.2.1))
    (σ := fun w : E × ℂ ↦ (w.1, w.2, S w.1 / w.2)) _ (Eventually.of_forall fun _ ↦ rfl) _
    (mem_span_smoothingEquation_iff_of_fst_ne_zero hx hs hS) hgG
    ((offNodeChartFstEquiv hx hs).apply_symm_apply _)

/-! ### The chart `y ≠ 0` -/

/-- Pullback along the projection `(b, x, y) ↦ (b, y)`, followed by restriction to `N_s`: the
holomorphic germs at `(b, y)` on `E × ℂ` map to the local ring of `N_s` at `p = (b, x, y)`. -/
def offNodeChartSnd (p : E × ℂ × ℂ)
    (s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1) :
    (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (p.1, p.2.2) →+*
      (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p ⧸
        Ideal.span {smoothingEquation p s} :=
  (Ideal.Quotient.mk _).comp (stalkPrecomp 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)
    (fun q : E × ℂ × ℂ ↦ (q.1, q.2.2)) (contMDiff_iff_contDiff.2 (by fun_prop)) p)

/-- `offNodeChartSnd` is the class of the pullback along `(b, x, y) ↦ (b, y)`. -/
@[simp]
theorem offNodeChartSnd_apply (p : E × ℂ × ℂ)
    (s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1)
    (h : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (p.1, p.2.2)) :
    offNodeChartSnd p s h = Ideal.Quotient.mk _ (stalkPrecomp 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)
      (fun q : E × ℂ × ℂ ↦ (q.1, q.2.2)) (contMDiff_iff_contDiff.2 (by fun_prop)) p h) :=
  (rfl)

/-- **Product chart where `y ≠ 0`.** At a point `p = (b, x, y)` of `N_s` with `y ≠ 0`, the
projection `(b, x, y) ↦ (b, y)` identifies the local ring of `N_s` with the holomorphic germs on
`E × ℂ` at `(b, y)`. -/
theorem offNodeChartSnd_bijective {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} (hy : p.2.2 ≠ 0)
    (hs : eval 𝓘(ℂ, E) E p.1 s = p.2.1 * p.2.2) : Bijective (offNodeChartSnd p s) := by
  obtain ⟨S, -, hS⟩ := exists_toFilterGerm_eq p.1 s
  obtain ⟨hSa, hSp⟩ := contDiffAt_and_eq_of_toFilterGerm_eq hs (hS _ le_rfl)
  obtain ⟨hσ, hσp⟩ := graph_of_snd_ne_zero hSa hSp hy
  exact quotientMk_comp_stalkPrecomp_bijective _ hσ hσp (Eventually.of_forall fun _ ↦ rfl) _
    (mem_span_smoothingEquation_iff_of_snd_ne_zero hy hs (hS _ le_rfl))

/-- **Product chart where `y ≠ 0`**, as a ring isomorphism between the holomorphic germs on
`E × ℂ` at `(b, y)` and the local ring of `N_s` at `p = (b, x, y)`. -/
def offNodeChartSndEquiv {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} (hy : p.2.2 ≠ 0)
    (hs : eval 𝓘(ℂ, E) E p.1 s = p.2.1 * p.2.2) :
    (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (p.1, p.2.2) ≃+*
      (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p ⧸
        Ideal.span {smoothingEquation p s} :=
  RingEquiv.ofBijective _ (offNodeChartSnd_bijective hy hs)

/-- The isomorphism `offNodeChartSndEquiv` is the map `offNodeChartSnd`. -/
@[simp]
theorem offNodeChartSndEquiv_apply {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} (hy : p.2.2 ≠ 0)
    (hs : eval 𝓘(ℂ, E) E p.1 s = p.2.1 * p.2.2)
    (h : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (p.1, p.2.2)) :
    offNodeChartSndEquiv hy hs h = offNodeChartSnd p s h :=
  (rfl)

/-- **The inverse chart where `y ≠ 0`** restricts to the graph `x = s(b)/y`: if `G` represents
`g` and `S` represents `s`, then the germ corresponding to the class of `g` is represented by
`(b, y) ↦ G (b, S(b)/y, y)`. -/
theorem toFilterGerm_offNodeChartSndEquiv_symm {p : E × ℂ × ℂ}
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk p.1} (hy : p.2.2 ≠ 0)
    (hs : eval 𝓘(ℂ, E) E p.1 s = p.2.1 * p.2.2) {S : E → ℂ}
    (hS : toFilterGerm 𝓘(ℂ, E) E p.1 (𝓝 p.1) le_rfl s = S)
    {g : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ)).presheaf.stalk p}
    {G : E × ℂ × ℂ → ℂ} (hgG : toFilterGerm 𝓘(ℂ, E × ℂ × ℂ) (E × ℂ × ℂ) p (𝓝 p) le_rfl g = G) :
    toFilterGerm 𝓘(ℂ, E × ℂ) (E × ℂ) (p.1, p.2.2) (𝓝 (p.1, p.2.2)) le_rfl
        ((offNodeChartSndEquiv hy hs).symm (Ideal.Quotient.mk _ g)) =
      (fun w : E × ℂ ↦ G (w.1, S w.1 / w.2, w.2)) :=
  toFilterGerm_eq_comp_of_quotientMk_stalkPrecomp_eq (π := fun q : E × ℂ × ℂ ↦ (q.1, q.2.2))
    (σ := fun w : E × ℂ ↦ (w.1, S w.1 / w.2, w.2)) _ (Eventually.of_forall fun _ ↦ rfl) _
    (mem_span_smoothingEquation_iff_of_snd_ne_zero hy hs hS) hgG
    ((offNodeChartSndEquiv hy hs).apply_symm_apply _)

end TauCeti.holomorphicStructureSheaf
