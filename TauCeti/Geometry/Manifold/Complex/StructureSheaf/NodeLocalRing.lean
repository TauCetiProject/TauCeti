import Mathlib.Algebra.Category.Ring.FilteredColimits

/-!
# The local ring of a node

A node of a nodal complex curve is obtained by gluing a point `p` of one normalized component
to a point `q` of another (or of the same) component. A function near the node is a pair of
holomorphic germs, one on each branch, taking the same value at the node. This file defines the
local ring of the node in exactly this form, directly from the holomorphic stalks of the two
branches and without any hypersurface chart:

* `TauCeti.holomorphicStructureSheaf.nodeLocalRing I J p q` is the subring of
  `𝒪_{X,p} × 𝒪_{Y,q}` of pairs of germs with equal values, with componentwise operations.
  It is the fibre product of the two stalk evaluations to `ℂ`, and `nodeLocalRing.lift` is its
  universal property.
* `nodeLocalRing.fst` and `nodeLocalRing.snd` restrict a germ at the node to its two branches;
  `nodeLocalRing.eval` is the value at the node.
* A germ at the node is a unit exactly when its value is nonzero (`nodeLocalRing.isUnit_iff`).
  Hence the node ring is a local ring, its maximal ideal is the kernel of evaluation, and its
  residue field is `ℂ`. The branch restrictions are local homomorphisms.

The definition and these properties hold for complex manifolds of any dimension. On complex
curves a centered chart at each branch point gives the two coordinate germs
`nodeLocalRing.fstCoordinate` and `nodeLocalRing.sndCoordinate`: a coordinate of one branch,
extended by zero on the other. Their product is zero, so the node ring is not an integral
domain, and together they generate the maximal ideal
(`nodeLocalRing.maximalIdeal_eq_span_coordinate`). The kernel of each branch restriction is
generated by the coordinate of the other branch. These are the relations `xy = 0` and
`𝔪 = (x, y)` of the analytic local ring `ℂ{x, y}/(xy)` of the plane node, here derived from
the branch description.

The fibre product of the two stalk evaluations is the concrete form of the pullback in
`CommRingCat` described by Mathlib's `CommRingCat.pullbackCone`.

## References

* Otto Forster, *Lectures on Riemann Surfaces*, §§1 and 6, for the local rings of holomorphic
  germs.
* Joel W. Robbin and Dietmar A. Salamon, *A construction of the Deligne–Mumford orbifold*,
  J. Eur. Math. Soc. 8 (2006), for nodal Riemann surfaces as smooth surfaces with paired
  nodal points.
-/

public noncomputable section

open IsLocalRing IsManifold
open scoped Manifold

namespace TauCeti.holomorphicStructureSheaf

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  {H : Type*} [TopologicalSpace H] (I : ModelWithCorners ℂ E H)
  {X : Type} [TopologicalSpace X] [ChartedSpace H X]
  {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℂ E']
  {H' : Type*} [TopologicalSpace H'] (J : ModelWithCorners ℂ E' H')
  {Y : Type} [TopologicalSpace Y] [ChartedSpace H' Y]

/-- The local ring of the node obtained by gluing `p` to `q`: pairs of holomorphic germs at the
two branch points with equal values, under componentwise operations. -/
def nodeLocalRing (p : X) (q : Y) :
    Subring ((holomorphicStructureSheaf I X).presheaf.stalk p ×
      (holomorphicStructureSheaf J Y).presheaf.stalk q) :=
  ((eval I X p).comp (RingHom.fst _ _)).eqLocus ((eval J Y q).comp (RingHom.snd _ _))

variable {I J}

/-- A pair of branch germs is a germ at the node exactly when the two germs have equal values. -/
@[simp]
theorem mem_nodeLocalRing {p : X} {q : Y}
    (f : (holomorphicStructureSheaf I X).presheaf.stalk p ×
      (holomorphicStructureSheaf J Y).presheaf.stalk q) :
    f ∈ nodeLocalRing I J p q ↔ eval I X p f.1 = eval J Y q f.2 := Iff.rfl

namespace nodeLocalRing

variable (I J) (p : X) (q : Y)

/-- Restriction of a germ at the node to its branch at `p`. -/
def fst : nodeLocalRing I J p q →+* (holomorphicStructureSheaf I X).presheaf.stalk p :=
  (RingHom.fst _ _).comp (nodeLocalRing I J p q).subtype

/-- Restriction of a germ at the node to its branch at `q`. -/
def snd : nodeLocalRing I J p q →+* (holomorphicStructureSheaf J Y).presheaf.stalk q :=
  (RingHom.snd _ _).comp (nodeLocalRing I J p q).subtype

/-- The value of a germ at the node. -/
def eval : nodeLocalRing I J p q →+* ℂ :=
  (holomorphicStructureSheaf.eval I X p).comp (fst I J p q)

variable {I J p q}

/-- The first branch restriction is the first component of the pair of germs. -/
theorem fst_apply (f : nodeLocalRing I J p q) : fst I J p q f = f.1.1 := (rfl)

/-- The second branch restriction is the second component of the pair of germs. -/
theorem snd_apply (f : nodeLocalRing I J p q) : snd I J p q f = f.1.2 := (rfl)

/-- The value at the node is the value of the first branch germ at `p`. -/
@[simp]
theorem eval_fst (f : nodeLocalRing I J p q) :
    holomorphicStructureSheaf.eval I X p (fst I J p q f) = eval I J p q f := (rfl)

/-- The value at the node is the value of the second branch germ at `q`. -/
@[simp]
theorem eval_snd (f : nodeLocalRing I J p q) :
    holomorphicStructureSheaf.eval J Y q (snd I J p q f) = eval I J p q f :=
  f.2.symm

/-- A germ at the node is determined by its two branch germs. -/
@[ext]
theorem ext {f g : nodeLocalRing I J p q} (hfst : fst I J p q f = fst I J p q g)
    (hsnd : snd I J p q f = snd I J p q g) : f = g :=
  Subtype.ext (Prod.ext hfst hsnd)

/-- Two branch germs with equal values glue to a germ at the node. -/
def mk (f : (holomorphicStructureSheaf I X).presheaf.stalk p)
    (g : (holomorphicStructureSheaf J Y).presheaf.stalk q)
    (h : holomorphicStructureSheaf.eval I X p f = holomorphicStructureSheaf.eval J Y q g) :
    nodeLocalRing I J p q :=
  ⟨(f, g), h⟩

/-- The first branch germ of a glued germ. -/
@[simp]
theorem fst_mk (f : (holomorphicStructureSheaf I X).presheaf.stalk p)
    (g : (holomorphicStructureSheaf J Y).presheaf.stalk q)
    (h : holomorphicStructureSheaf.eval I X p f = holomorphicStructureSheaf.eval J Y q g) :
    fst I J p q (mk f g h) = f := (rfl)

/-- The second branch germ of a glued germ. -/
@[simp]
theorem snd_mk (f : (holomorphicStructureSheaf I X).presheaf.stalk p)
    (g : (holomorphicStructureSheaf J Y).presheaf.stalk q)
    (h : holomorphicStructureSheaf.eval I X p f = holomorphicStructureSheaf.eval J Y q g) :
    snd I J p q (mk f g h) = g := (rfl)

/-- Every holomorphic germ on the first branch extends to a germ at the node. -/
theorem fst_surjective : Function.Surjective (fst I J p q) := fun f ↦ by
  obtain ⟨g, hg⟩ := eval_surjective J Y q (holomorphicStructureSheaf.eval I X p f)
  exact ⟨mk f g hg.symm, rfl⟩

/-- Every holomorphic germ on the second branch extends to a germ at the node. -/
theorem snd_surjective : Function.Surjective (snd I J p q) := fun g ↦ by
  obtain ⟨f, hf⟩ := eval_surjective I X p (holomorphicStructureSheaf.eval J Y q g)
  exact ⟨mk f g hf, rfl⟩

/-- Every complex number is the value at the node of some germ. -/
theorem eval_surjective : Function.Surjective (eval I J p q) :=
  (holomorphicStructureSheaf.eval_surjective I X p).comp fst_surjective

section Lift

variable {R : Type*} [CommRing R]

/-- The universal property of the node ring as a fibre product: two ring homomorphisms to the
branch stalks with equal values at the node combine into a ring homomorphism to the node ring. -/
def lift (φ : R →+* (holomorphicStructureSheaf I X).presheaf.stalk p)
    (ψ : R →+* (holomorphicStructureSheaf J Y).presheaf.stalk q)
    (h : ∀ r, holomorphicStructureSheaf.eval I X p (φ r) =
      holomorphicStructureSheaf.eval J Y q (ψ r)) :
    R →+* nodeLocalRing I J p q :=
  (φ.prod ψ).codRestrict _ h

/-- The first branch germ of a lifted element. -/
@[simp]
theorem fst_lift (φ : R →+* (holomorphicStructureSheaf I X).presheaf.stalk p)
    (ψ : R →+* (holomorphicStructureSheaf J Y).presheaf.stalk q)
    (h : ∀ r, holomorphicStructureSheaf.eval I X p (φ r) =
      holomorphicStructureSheaf.eval J Y q (ψ r)) (r : R) :
    fst I J p q (lift φ ψ h r) = φ r := (rfl)

/-- The second branch germ of a lifted element. -/
@[simp]
theorem snd_lift (φ : R →+* (holomorphicStructureSheaf I X).presheaf.stalk p)
    (ψ : R →+* (holomorphicStructureSheaf J Y).presheaf.stalk q)
    (h : ∀ r, holomorphicStructureSheaf.eval I X p (φ r) =
      holomorphicStructureSheaf.eval J Y q (ψ r)) (r : R) :
    snd I J p q (lift φ ψ h r) = ψ r := (rfl)

/-- Ring homomorphisms to the node ring agree when both of their branch restrictions agree. -/
theorem ringHom_ext {φ ψ : R →+* nodeLocalRing I J p q}
    (hfst : (fst I J p q).comp φ = (fst I J p q).comp ψ)
    (hsnd : (snd I J p q).comp φ = (snd I J p q).comp ψ) : φ = ψ :=
  RingHom.ext fun r ↦ ext (RingHom.congr_fun hfst r) (RingHom.congr_fun hsnd r)

/-- A ring homomorphism to the node ring is the lift of its two branch restrictions. -/
theorem lift_fst_comp_snd_comp (φ : R →+* nodeLocalRing I J p q) :
    lift ((fst I J p q).comp φ) ((snd I J p q).comp φ)
      (fun r ↦ (eval_fst (φ r)).trans (eval_snd (φ r)).symm) = φ :=
  ringHom_ext rfl rfl

end Lift

/-- A germ at the node is a unit exactly when its value at the node is nonzero. -/
theorem isUnit_iff (f : nodeLocalRing I J p q) : IsUnit f ↔ eval I J p q f ≠ 0 := by
  refine ⟨fun hf ↦ (hf.map (eval I J p q)).ne_zero, fun hf ↦ ?_⟩
  have hfst : IsUnit (fst I J p q f) := by rwa [isUnit_stalk_iff, eval_fst]
  have hsnd : IsUnit (snd I J p q f) := by rwa [isUnit_stalk_iff, eval_snd]
  obtain ⟨u, hu⟩ := hfst
  obtain ⟨v, hv⟩ := hsnd
  -- The inverse is the pair of inverse branch germs, whose values are again equal.
  refine IsUnit.of_mul_eq_one (mk (↑u⁻¹ : (holomorphicStructureSheaf I X).presheaf.stalk p)
      (↑v⁻¹ : (holomorphicStructureSheaf J Y).presheaf.stalk q) ?_) ?_
  · rw [map_units_inv, map_units_inv, hu, hv, eval_fst, eval_snd]
  · ext
    · rw [map_mul, fst_mk, ← hu, Units.mul_inv, map_one]
    · rw [map_mul, snd_mk, ← hv, Units.mul_inv, map_one]

/-- Evaluation at the node detects units. -/
instance isLocalHom_eval : IsLocalHom (eval I J p q) where
  map_nonunit f hf := (isUnit_iff f).mpr hf.ne_zero

/-- The node ring is a local ring. -/
instance instIsLocalRing : IsLocalRing (nodeLocalRing I J p q) :=
  (eval I J p q).domain_isLocalRing

/-- The nonunits of the node ring are exactly the germs vanishing at the node. -/
theorem nonunits_eq_ker_eval : nonunits (nodeLocalRing I J p q) = RingHom.ker (eval I J p q) := by
  ext f
  simp [mem_nonunits_iff, isUnit_iff]

/-- The maximal ideal of the node ring consists of the germs vanishing at the node. -/
@[simp]
theorem maximalIdeal_eq_ker_eval :
    maximalIdeal (nodeLocalRing I J p q) = RingHom.ker (eval I J p q) :=
  (IsLocalRing.ker_eq_maximalIdeal (eval I J p q) eval_surjective).symm

/-- Restricting a germ at the node to its first branch is a local homomorphism. -/
instance isLocalHom_fst : IsLocalHom (fst I J p q) where
  map_nonunit f hf := by
    rw [isUnit_iff, ← eval_fst, ← isUnit_stalk_iff]
    exact hf

/-- Restricting a germ at the node to its second branch is a local homomorphism. -/
instance isLocalHom_snd : IsLocalHom (snd I J p q) where
  map_nonunit f hf := by
    rw [isUnit_iff, ← eval_snd, ← isUnit_stalk_iff]
    exact hf

variable (I J p q) in
/-- Evaluation identifies the residue field of the node ring with `ℂ`. -/
def residueFieldEquiv : ResidueField (nodeLocalRing I J p q) ≃+* ℂ :=
  (Ideal.quotEquivOfEq maximalIdeal_eq_ker_eval).trans
    ((eval I J p q).quotientKerEquivOfSurjective eval_surjective)

/-- The residue-field comparison sends the residue of a germ to its value at the node. -/
@[simp]
theorem residueFieldEquiv_residue (f : nodeLocalRing I J p q) :
    residueFieldEquiv I J p q (residue _ f) = eval I J p q f :=
  (congrArg ((eval I J p q).quotientKerEquivOfSurjective eval_surjective)
    (Ideal.quotEquivOfEq_mk maximalIdeal_eq_ker_eval f)).trans
      (RingHom.quotientKerEquivOfSurjective_apply_mk eval_surjective f)

/-! ### Branch coordinates at a node of complex curves -/

section Curve

section Fst

variable {X Y : Type} [TopologicalSpace X] [ChartedSpace ℂ X] [IsManifold 𝓘(ℂ) 1 X]
  [TopologicalSpace Y] [ChartedSpace ℂ Y] {p : X} {q : Y}
  {e : OpenPartialHomeomorph X ℂ} (he : e ∈ maximalAtlas 𝓘(ℂ) 1 X) (hp : p ∈ e.source)

/-- A centered coordinate of the first branch, extended by zero on the second branch. -/
def fstCoordinate : nodeLocalRing 𝓘(ℂ) 𝓘(ℂ) p q :=
  mk (e.holomorphicCoordinateGerm he p hp) 0 (by simp)

/-- The first branch germ of the first coordinate is the chart coordinate. -/
@[simp]
theorem fst_fstCoordinate :
    fst 𝓘(ℂ) 𝓘(ℂ) p q (fstCoordinate (q := q) he hp) = e.holomorphicCoordinateGerm he p hp :=
  (rfl)

/-- The first branch coordinate vanishes at the node. -/
@[simp]
theorem eval_fstCoordinate : eval 𝓘(ℂ) 𝓘(ℂ) p q (fstCoordinate (q := q) he hp) = 0 := by
  rw [← eval_fst, fst_fstCoordinate, e.eval_holomorphicCoordinateGerm he p hp]

/-- The first coordinate vanishes on the second branch. -/
@[simp]
theorem snd_fstCoordinate : snd 𝓘(ℂ) 𝓘(ℂ) p q (fstCoordinate (q := q) he hp) = 0 := (rfl)

/-- The first branch coordinate is nonzero. -/
theorem fstCoordinate_ne_zero : fstCoordinate (q := q) he hp ≠ 0 := fun h ↦
  e.holomorphicCoordinateGerm_ne_zero he p hp (by
    simpa using congrArg (fst 𝓘(ℂ) 𝓘(ℂ) p q) h)

/-- The germs at the node vanishing on the second branch are the multiples of the first branch
coordinate. -/
theorem ker_snd_eq_span_fstCoordinate :
    RingHom.ker (snd 𝓘(ℂ) 𝓘(ℂ) p q) = Ideal.span {fstCoordinate (q := q) he hp} := by
  refine le_antisymm (fun f hf ↦ ?_) ((Ideal.span_singleton_le_iff_mem _).mpr (by simp))
  rw [RingHom.mem_ker] at hf
  -- The first branch germ vanishes at `p`, so it is a multiple of the coordinate there.
  have hp0 : holomorphicStructureSheaf.eval 𝓘(ℂ) X p (fst 𝓘(ℂ) 𝓘(ℂ) p q f) = 0 := by
    rw [eval_fst, ← eval_snd, hf, map_zero]
  obtain ⟨g, hg⟩ :=
    (e.holomorphicCoordinateGerm_dvd_iff_eval_eq_zero he p hp _).mpr hp0
  obtain ⟨g', rfl⟩ : ∃ g', fst 𝓘(ℂ) 𝓘(ℂ) p q g' = g := fst_surjective g
  refine Ideal.mem_span_singleton'.mpr ⟨g', ext ?_ ?_⟩
  · rw [map_mul, fst_fstCoordinate, hg, mul_comm]
  · rw [map_mul, snd_fstCoordinate, mul_zero, hf]

end Fst

section Snd

variable {X Y : Type} [TopologicalSpace X] [ChartedSpace ℂ X]
  [TopologicalSpace Y] [ChartedSpace ℂ Y] [IsManifold 𝓘(ℂ) 1 Y] {p : X} {q : Y}
  {e' : OpenPartialHomeomorph Y ℂ} (he' : e' ∈ maximalAtlas 𝓘(ℂ) 1 Y) (hq : q ∈ e'.source)

/-- A centered coordinate of the second branch, extended by zero on the first branch. -/
def sndCoordinate : nodeLocalRing 𝓘(ℂ) 𝓘(ℂ) p q :=
  mk 0 (e'.holomorphicCoordinateGerm he' q hq) (by simp)

/-- The second coordinate vanishes on the first branch. -/
@[simp]
theorem fst_sndCoordinate : fst 𝓘(ℂ) 𝓘(ℂ) p q (sndCoordinate (p := p) he' hq) = 0 := (rfl)

/-- The second branch germ of the second coordinate is the chart coordinate. -/
@[simp]
theorem snd_sndCoordinate :
    snd 𝓘(ℂ) 𝓘(ℂ) p q (sndCoordinate (p := p) he' hq) = e'.holomorphicCoordinateGerm he' q hq :=
  (rfl)

/-- The second branch coordinate vanishes at the node. -/
@[simp]
theorem eval_sndCoordinate : eval 𝓘(ℂ) 𝓘(ℂ) p q (sndCoordinate (p := p) he' hq) = 0 := by
  rw [← eval_snd, snd_sndCoordinate, e'.eval_holomorphicCoordinateGerm he' q hq]

/-- The second branch coordinate is nonzero. -/
theorem sndCoordinate_ne_zero : sndCoordinate (p := p) he' hq ≠ 0 := fun h ↦
  e'.holomorphicCoordinateGerm_ne_zero he' q hq (by
    simpa using congrArg (snd 𝓘(ℂ) 𝓘(ℂ) p q) h)

/-- The germs at the node vanishing on the first branch are the multiples of the second branch
coordinate. -/
theorem ker_fst_eq_span_sndCoordinate :
    RingHom.ker (fst 𝓘(ℂ) 𝓘(ℂ) p q) = Ideal.span {sndCoordinate (p := p) he' hq} := by
  refine le_antisymm (fun f hf ↦ ?_) ((Ideal.span_singleton_le_iff_mem _).mpr (by simp))
  rw [RingHom.mem_ker] at hf
  -- The second branch germ vanishes at `q`, so it is a multiple of the coordinate there.
  have hq0 : holomorphicStructureSheaf.eval 𝓘(ℂ) Y q (snd 𝓘(ℂ) 𝓘(ℂ) p q f) = 0 := by
    rw [eval_snd, ← eval_fst, hf, map_zero]
  obtain ⟨g, hg⟩ :=
    (e'.holomorphicCoordinateGerm_dvd_iff_eval_eq_zero he' q hq _).mpr hq0
  obtain ⟨g', rfl⟩ : ∃ g', snd 𝓘(ℂ) 𝓘(ℂ) p q g' = g := snd_surjective g
  refine Ideal.mem_span_singleton'.mpr ⟨g', ext ?_ ?_⟩
  · rw [map_mul, fst_sndCoordinate, mul_zero, hf]
  · rw [map_mul, snd_sndCoordinate, hg, mul_comm]

end Snd

variable {X Y : Type} [TopologicalSpace X] [ChartedSpace ℂ X] [IsManifold 𝓘(ℂ) 1 X]
  [TopologicalSpace Y] [ChartedSpace ℂ Y] [IsManifold 𝓘(ℂ) 1 Y] {p : X} {q : Y}
  {e : OpenPartialHomeomorph X ℂ} (he : e ∈ maximalAtlas 𝓘(ℂ) 1 X) (hp : p ∈ e.source)
  {e' : OpenPartialHomeomorph Y ℂ} (he' : e' ∈ maximalAtlas 𝓘(ℂ) 1 Y) (hq : q ∈ e'.source)

/-- The two branch coordinates multiply to zero: the node equation `xy = 0`. -/
@[simp]
theorem fstCoordinate_mul_sndCoordinate :
    fstCoordinate (q := q) he hp * sndCoordinate (p := p) he' hq = 0 := by
  ext <;> simp

/-- The node ring has zero divisors, so it is not an integral domain. -/
theorem not_isDomain : ¬ IsDomain (nodeLocalRing 𝓘(ℂ) 𝓘(ℂ) p q) := fun _ ↦ by
  rcases mul_eq_zero.mp (fstCoordinate_mul_sndCoordinate
    (chart_mem_maximalAtlas p (I := 𝓘(ℂ)) (n := 1)) (mem_chart_source ℂ p)
    (chart_mem_maximalAtlas q (I := 𝓘(ℂ)) (n := 1)) (mem_chart_source ℂ q)) with h | h
  · exact fstCoordinate_ne_zero _ _ h
  · exact sndCoordinate_ne_zero _ _ h

/-- The maximal ideal of the node ring is generated by the two branch coordinates. -/
theorem maximalIdeal_eq_span_coordinate :
    maximalIdeal (nodeLocalRing 𝓘(ℂ) 𝓘(ℂ) p q) =
      Ideal.span {fstCoordinate (q := q) he hp, sndCoordinate (p := p) he' hq} := by
  refine le_antisymm (fun f hf ↦ ?_) (Ideal.span_le.mpr ?_)
  · rw [maximalIdeal_eq_ker_eval, RingHom.mem_ker] at hf
    -- Split off a multiple of the first coordinate; the rest vanishes on the first branch.
    obtain ⟨g, hg⟩ := (e.holomorphicCoordinateGerm_dvd_iff_eval_eq_zero he p hp _).mpr
      ((eval_fst f).trans hf)
    obtain ⟨g', rfl⟩ : ∃ g', fst 𝓘(ℂ) 𝓘(ℂ) p q g' = g := fst_surjective g
    have hrest : f - fstCoordinate he hp * g' ∈ RingHom.ker (fst 𝓘(ℂ) 𝓘(ℂ) p q) := by
      rw [RingHom.mem_ker, map_sub, map_mul, fst_fstCoordinate, hg, sub_self]
    rw [ker_fst_eq_span_sndCoordinate he' hq, Ideal.mem_span_singleton'] at hrest
    obtain ⟨k, hk⟩ := hrest
    rw [Ideal.span_insert, Submodule.mem_sup]
    exact ⟨fstCoordinate he hp * g', Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _),
      k * sndCoordinate he' hq, Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _),
      by rw [hk, add_sub_cancel]⟩
  · rintro f (rfl | rfl) <;> simp

end Curve

end nodeLocalRing

end TauCeti.holomorphicStructureSheaf
