import TauCeti.RingTheory.RegularLocalRing.CohenMacaulay

/-!
# Holomorphic stalks are regular local rings

At every point `x` of a finite-dimensional complex manifold `X` without boundary modelled on `E`,
the stalk `𝒪_{X, x}` of the holomorphic structure sheaf is a regular local ring of Krull dimension
`Module.finrank ℂ E`. On the model space, centered linear coordinates span the maximal ideal and
identify the algebraic cotangent space `𝔪 / 𝔪²` with `StrongDual ℂ E`, bounding the minimal number
of generators of `𝔪` above by `Module.finrank ℂ E`, while iterated hyperplane restriction bounds
the Krull dimension below by `Module.finrank ℂ E`. Pulling back along an extended chart transfers
both regularity and the exact dimension to every complex manifold without boundary, and
`smoothStalkIso` transfers them to the stalks of Mathlib's complex-smooth structure sheaf.

In a holomorphic chart `e` at `x`, combining regularity of `𝒪_{X, x}` with the derivative
description of `𝔪²` (`OpenPartialHomeomorph.holomorphicStalkFDeriv_eq_zero_iff`) gives the
analytic Jacobian criterion for hypersurface germs: a nonzero germ vanishing at `x` cuts out a
regular local quotient ring if and only if its complex derivative in `e` does not vanish, in which
case it is a prime element and its quotient has Krull dimension `Module.finrank ℂ E - 1`. Moreover,
the centered coordinate germs along any ordered basis of `E` generate `𝔪` and form an
`𝒪_{X, x}`-regular sequence of length `Module.finrank ℂ E`.

## Main declarations

* `TauCeti.holomorphicStructureSheaf.stalkIsRegularLocalRing`,
  `TauCeti.holomorphicStructureSheaf.smoothStalkIsRegularLocalRing`: holomorphic and
  complex-smooth stalks on a finite-dimensional complex manifold without boundary are regular local
  rings.
* `TauCeti.holomorphicStructureSheaf.ringKrullDim_stalk`,
  `TauCeti.holomorphicStructureSheaf.ringKrullDim_smoothStalk`: their Krull dimension equals
  `Module.finrank ℂ E`.
* `TauCeti.holomorphicStructureSheaf.spanFinrank_maximalIdeal_stalk`,
  `TauCeti.holomorphicStructureSheaf.finrank_cotangentSpace_stalk` (and smooth counterparts): the
  maximal ideal is minimally generated by `Module.finrank ℂ E` elements, matching the embedding
  dimension.
* `OpenPartialHomeomorph.isRegularLocalRing_quotient_span_singleton_iff`: a nonzero germ vanishing
  at `x` defines a regular local hypersurface quotient if and only if its chart derivative at `x`
  is nonzero.
* `OpenPartialHomeomorph.prime_of_eval_eq_zero_of_holomorphicStalkFDeriv_ne_zero`,
  `OpenPartialHomeomorph.prime_holomorphicLinearCoordinateGerm`: germs vanishing at `x` with
  nonvanishing derivative—in particular nonzero centered linear coordinates—are prime in `𝒪_{X, x}`.
* `OpenPartialHomeomorph.ofList_ofFn_holomorphicLinearCoordinateGerm`,
  `OpenPartialHomeomorph.isRegular_ofFn_holomorphicLinearCoordinateGerm`: the centered coordinate
  germs along any ordered basis `Module.Basis (Fin n) ℂ E` generate the maximal ideal of `𝒪_{X, x}`
  and form a regular sequence on `𝒪_{X, x}`.

## References

* J.-P. Demailly, *Complex Analytic and Differential Geometry*, Chapter II, §2.
* R. C. Gunning, H. Rossi, *Analytic Functions of Several Complex Variables*, Chapter II.
* H. Grauert, R. Remmert, *Coherent Analytic Sheaves*, Chapter 2.
-/

public noncomputable section

open IsManifold Module
open scoped ContDiff Manifold

namespace TauCeti.holomorphicStructureSheaf

section ModelSpace

variable {V : Type} [NormedAddCommGroup V] [NormedSpace ℂ V] [FiniteDimensional ℂ V]

/-- On a finite-dimensional complex normed space, the minimal number of generators of the maximal
ideal of a holomorphic stalk equals the complex dimension. -/
private theorem spanFinrank_maximalIdeal_stalk_modelSpace (z : V) :
    (IsLocalRing.maximalIdeal
        ((holomorphicStructureSheaf 𝓘(ℂ, V) V).presheaf.stalk z)).spanFinrank =
      finrank ℂ V := by
  rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
  exact (chartAt V z).finrank_cotangentSpace_holomorphicStalk z (mem_chart_source V z)
    (chart_mem_maximalAtlas z)

/-- Holomorphic stalks on a finite-dimensional complex normed space are regular local rings. -/
private theorem isRegularLocalRing_stalk_modelSpace (z : V) :
    IsRegularLocalRing ((holomorphicStructureSheaf 𝓘(ℂ, V) V).presheaf.stalk z) := by
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  rw [spanFinrank_maximalIdeal_stalk_modelSpace]
  exact finrank_le_ringKrullDim_stalk_modelSpace z

/-- On a finite-dimensional complex normed space, every holomorphic stalk has Krull dimension
equal to `Module.finrank ℂ V`. -/
private theorem ringKrullDim_stalk_modelSpace (z : V) :
    ringKrullDim ((holomorphicStructureSheaf 𝓘(ℂ, V) V).presheaf.stalk z) = finrank ℂ V := by
  have := isRegularLocalRing_stalk_modelSpace z
  rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, spanFinrank_maximalIdeal_stalk_modelSpace]

end ModelSpace

section Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [FiniteDimensional ℂ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℂ E H} [I.Boundaryless]
  {X : Type} [TopologicalSpace X] [ChartedSpace H X] [IsManifold I 1 X]

/-- Pullback along an extended chart followed by a linear equivalence identifies a manifold stalk
with a model-space stalk in `Type`. -/
private def modelStalkRingEquiv {V : Type} [NormedAddCommGroup V] [NormedSpace ℂ V]
    (x : X) (e : E ≃L[ℂ] V) :
    have : IsManifold I ω X := IsManifold.of_ne_zero ω one_ne_zero inferInstance
    (holomorphicStructureSheaf 𝓘(ℂ, V) V).presheaf.stalk ((e ∘ extChartAt I x) x) ≃+*
      (holomorphicStructureSheaf I X).presheaf.stalk x :=
  have : IsManifold I ω X := IsManifold.of_ne_zero ω one_ne_zero inferInstance
  RingEquiv.ofBijective _ (stalkPullback_comp_extChartAt_bijective x e)

/-- The stalk of holomorphic functions at any point of a finite-dimensional complex manifold
without boundary is a regular local ring. -/
instance stalkIsRegularLocalRing (x : X) :
    IsRegularLocalRing ((holomorphicStructureSheaf I X).presheaf.stalk x) := by
  let e : E ≃L[ℂ] Fin (finrank ℂ E) → ℂ := ContinuousLinearEquiv.ofFinrankEq (by simp)
  have := isRegularLocalRing_stalk_modelSpace ((e ∘ extChartAt I x) x)
  exact IsRegularLocalRing.of_ringEquiv (modelStalkRingEquiv x e)

/-- The Krull dimension of the holomorphic stalk at any point of a finite-dimensional complex
manifold without boundary equals the complex dimension of its model. -/
@[simp]
theorem ringKrullDim_stalk (x : X) :
    ringKrullDim ((holomorphicStructureSheaf I X).presheaf.stalk x) = finrank ℂ E := by
  let e : E ≃L[ℂ] Fin (finrank ℂ E) → ℂ := ContinuousLinearEquiv.ofFinrankEq (by simp)
  rw [← ringKrullDim_eq_of_ringEquiv (modelStalkRingEquiv x e), ringKrullDim_stalk_modelSpace]
  simp

/-- The maximal ideal of a holomorphic stalk on a finite-dimensional complex manifold without
boundary is minimally generated by `Module.finrank ℂ E` elements. -/
theorem spanFinrank_maximalIdeal_stalk (x : X) :
    (IsLocalRing.maximalIdeal ((holomorphicStructureSheaf I X).presheaf.stalk x)).spanFinrank =
      finrank ℂ E := by
  exact_mod_cast (IsRegularLocalRing.spanFinrank_maximalIdeal
    (R := (holomorphicStructureSheaf I X).presheaf.stalk x)).trans (ringKrullDim_stalk x)

/-- The algebraic cotangent space of a holomorphic stalk on a finite-dimensional complex manifold
without boundary has dimension `Module.finrank ℂ E` over the residue field. -/
theorem finrank_cotangentSpace_stalk (x : X) :
    finrank
        (IsLocalRing.ResidueField ((holomorphicStructureSheaf I X).presheaf.stalk x))
        (IsLocalRing.CotangentSpace ((holomorphicStructureSheaf I X).presheaf.stalk x)) =
      finrank ℂ E := by
  rw [← IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace,
    spanFinrank_maximalIdeal_stalk]

/-- A stalk of Mathlib's complex-smooth structure sheaf on a finite-dimensional complex manifold
without boundary is a regular local ring, via its comparison with holomorphic germs. -/
instance smoothStalkIsRegularLocalRing (x : X) :
    IsRegularLocalRing ((smoothSheafCommRing I 𝓘(ℂ) X ℂ).presheaf.stalk x) :=
  IsRegularLocalRing.of_ringEquiv (smoothStalkIso I X x).commRingCatIsoToRingEquiv

/-- The Krull dimension of a complex-smooth stalk on a finite-dimensional complex manifold without
boundary equals the complex dimension of its model. -/
@[simp]
theorem ringKrullDim_smoothStalk (x : X) :
    ringKrullDim ((smoothSheafCommRing I 𝓘(ℂ) X ℂ).presheaf.stalk x) = finrank ℂ E := by
  rw [← (smoothStalkIso I X x).commRingCatIsoToRingEquiv.ringKrullDim, ringKrullDim_stalk]

/-- The maximal ideal of a complex-smooth stalk on a finite-dimensional complex manifold without
boundary is minimally generated by `Module.finrank ℂ E` elements. -/
theorem spanFinrank_maximalIdeal_smoothStalk (x : X) :
    (IsLocalRing.maximalIdeal ((smoothSheafCommRing I 𝓘(ℂ) X ℂ).presheaf.stalk x)).spanFinrank =
      finrank ℂ E := by
  exact_mod_cast (IsRegularLocalRing.spanFinrank_maximalIdeal
    (R := (smoothSheafCommRing I 𝓘(ℂ) X ℂ).presheaf.stalk x)).trans (ringKrullDim_smoothStalk x)

/-- The algebraic cotangent space of a complex-smooth stalk on a finite-dimensional complex
manifold without boundary has dimension `Module.finrank ℂ E` over the residue field. -/
theorem finrank_cotangentSpace_smoothStalk (x : X) :
    finrank
        (IsLocalRing.ResidueField ((smoothSheafCommRing I 𝓘(ℂ) X ℂ).presheaf.stalk x))
        (IsLocalRing.CotangentSpace ((smoothSheafCommRing I 𝓘(ℂ) X ℂ).presheaf.stalk x)) =
      finrank ℂ E := by
  rw [← IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace,
    spanFinrank_maximalIdeal_smoothStalk]

end Manifold

end TauCeti.holomorphicStructureSheaf

namespace OpenPartialHomeomorph

open TauCeti TauCeti.holomorphicStructureSheaf

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [FiniteDimensional ℂ E]
  {X : Type} [TopologicalSpace X] [ChartedSpace E X] [IsManifold 𝓘(ℂ, E) 1 X]
  (e : OpenPartialHomeomorph X E) (x : X) (hx : x ∈ e.source)
  (he : e ∈ maximalAtlas 𝓘(ℂ, E) ω X)

include he in
/-- **Jacobian regularity criterion for holomorphic hypersurface germs.** A nonzero holomorphic
germ `s` vanishing at `x` cuts out a regular local quotient `𝒪_{X, x} ⧸ (s)` if and only if its
complex derivative at `x` in the chart `e` is nonzero. -/
theorem isRegularLocalRing_quotient_span_singleton_iff
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x}
    (hs : eval 𝓘(ℂ, E) X x s = 0) (hs0 : s ≠ 0) :
    IsRegularLocalRing
        ((holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x ⧸ Ideal.span {s}) ↔
      e.holomorphicStalkFDeriv x hx s ≠ 0 := by
  have hsm : s ∈ IsLocalRing.maximalIdeal
      ((holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x) := by
    simpa only [maximalIdeal_stalk, RingHom.mem_ker] using hs
  rw [TauCeti.IsRegularLocalRing.quotient_span_singleton_iff hsm hs0, ne_eq,
    e.holomorphicStalkFDeriv_eq_zero_iff x hx he ⟨s, hsm⟩]

include he in
/-- A holomorphic germ vanishing at `x` with nonvanishing chart derivative cuts out a regular
local quotient ring. -/
theorem isRegularLocalRing_quotient_span_singleton_of_holomorphicStalkFDeriv_ne_zero
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x}
    (hs : eval 𝓘(ℂ, E) X x s = 0) (hd : e.holomorphicStalkFDeriv x hx s ≠ 0) :
    IsRegularLocalRing
      ((holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x ⧸ Ideal.span {s}) := by
  refine (e.isRegularLocalRing_quotient_span_singleton_iff x hx he hs ?_).2 hd
  rintro rfl
  exact hd (e.holomorphicStalkFDeriv_zero x hx)

/-- A holomorphic germ vanishing at `x` with nonvanishing chart derivative cuts out a hypersurface
local ring of Krull dimension `Module.finrank ℂ E - 1`. -/
theorem ringKrullDim_quotient_span_singleton_of_holomorphicStalkFDeriv_ne_zero
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x}
    (hs : eval 𝓘(ℂ, E) X x s = 0) (hd : e.holomorphicStalkFDeriv x hx s ≠ 0) :
    ringKrullDim ((holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x ⧸ Ideal.span {s}) =
      (Module.finrank ℂ E - 1 : ℕ) := by
  have hs0 : s ≠ 0 := by
    rintro rfl
    exact hd (e.holomorphicStalkFDeriv_zero x hx)
  have hsm : s ∈ IsLocalRing.maximalIdeal
      ((holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x) := by
    simpa only [maximalIdeal_stalk, RingHom.mem_ker] using hs
  have hpos : 0 < Module.finrank ℂ E := by
    by_contra! h0
    have : Subsingleton E := Module.finrank_zero_iff.mp (Nat.eq_zero_of_le_zero h0)
    exact hd (Subsingleton.elim _ _)
  have hdim := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_of_ne_zero hs0) hsm
  rw [ringKrullDim_stalk, ← Nat.sub_add_cancel hpos, Nat.cast_add, Nat.cast_one,
    ENat.WithBot.add_one_cancel] at hdim
  exact hdim

include he in
/-- A holomorphic germ vanishing at `x` with nonvanishing chart derivative is prime in `𝒪_{X, x}`.
-/
theorem prime_of_eval_eq_zero_of_holomorphicStalkFDeriv_ne_zero
    {s : (holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x}
    (hs : eval 𝓘(ℂ, E) X x s = 0) (hd : e.holomorphicStalkFDeriv x hx s ≠ 0) :
    Prime s := by
  have hs0 : s ≠ 0 := by
    rintro rfl
    exact hd (e.holomorphicStalkFDeriv_zero x hx)
  have hsm : s ∈ IsLocalRing.maximalIdeal
      ((holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x) := by
    simpa only [maximalIdeal_stalk, RingHom.mem_ker] using hs
  have hsq : s ∉ IsLocalRing.maximalIdeal
      ((holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x) ^ 2 :=
    (e.holomorphicStalkFDeriv_eq_zero_iff x hx he ⟨s, hsm⟩).not.1 hd
  exact (Ideal.span_singleton_prime hs0).1
    (TauCeti.IsRegularLocalRing.span_singleton_isPrime_of_notMem_sq hsm hsq)

/-- Every nonzero centered linear coordinate germ cuts out a regular local quotient ring of Krull
dimension `Module.finrank ℂ E - 1`. -/
theorem isRegularLocalRing_quotient_span_holomorphicLinearCoordinateGerm
    {ℓ : StrongDual ℂ E} (hℓ : ℓ ≠ 0) :
    IsRegularLocalRing ((holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x ⧸
      Ideal.span {e.holomorphicLinearCoordinateGerm he x ℓ hx}) :=
  e.isRegularLocalRing_quotient_span_singleton_of_holomorphicStalkFDeriv_ne_zero x hx he
    (e.eval_holomorphicLinearCoordinateGerm he x ℓ hx)
    (by simpa using hℓ)

/-- The quotient of `𝒪_{X, x}` by any nonzero centered linear coordinate germ has Krull dimension
`Module.finrank ℂ E - 1`. -/
theorem ringKrullDim_quotient_span_holomorphicLinearCoordinateGerm
    {ℓ : StrongDual ℂ E} (hℓ : ℓ ≠ 0) :
    ringKrullDim ((holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x ⧸
        Ideal.span {e.holomorphicLinearCoordinateGerm he x ℓ hx}) =
      (Module.finrank ℂ E - 1 : ℕ) :=
  e.ringKrullDim_quotient_span_singleton_of_holomorphicStalkFDeriv_ne_zero x hx
    (e.eval_holomorphicLinearCoordinateGerm he x ℓ hx)
    (by simpa using hℓ)

/-- Every nonzero centered linear coordinate germ is a prime element of `𝒪_{X, x}`. -/
theorem prime_holomorphicLinearCoordinateGerm {ℓ : StrongDual ℂ E} (hℓ : ℓ ≠ 0) :
    Prime (e.holomorphicLinearCoordinateGerm he x ℓ hx) :=
  e.prime_of_eval_eq_zero_of_holomorphicStalkFDeriv_ne_zero x hx he
    (e.eval_holomorphicLinearCoordinateGerm he x ℓ hx)
    (by simpa using hℓ)

/-- Every nonzero centered linear coordinate germ is irreducible in `𝒪_{X, x}`, generalizing
`OpenPartialHomeomorph.irreducible_holomorphicCoordinateGerm` from curves to arbitrary dimension. -/
theorem irreducible_holomorphicLinearCoordinateGerm {ℓ : StrongDual ℂ E} (hℓ : ℓ ≠ 0) :
    Irreducible (e.holomorphicLinearCoordinateGerm he x ℓ hx) :=
  (e.prime_holomorphicLinearCoordinateGerm x hx he hℓ).irreducible

omit [IsManifold 𝓘(ℂ, E) 1 X] in
/-- The list of centered coordinate germs along any ordered basis `Module.Basis (Fin n) ℂ E`
generates the maximal ideal of `𝒪_{X, x}`. -/
theorem ofList_ofFn_holomorphicLinearCoordinateGerm {n : ℕ} (b : Module.Basis (Fin n) ℂ E) :
    Ideal.ofList (List.ofFn fun i ↦
        e.holomorphicLinearCoordinateGerm he x (LinearMap.toContinuousLinearMap (b.coord i)) hx) =
      IsLocalRing.maximalIdeal ((holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x) := by
  rw [maximalIdeal_stalk, e.ker_eval_eq_span_holomorphicLinearCoordinateGerm he b hx, Ideal.ofList]
  congr 1
  ext s
  simp [List.mem_ofFn]

/-- **Local holomorphic coordinates form a regular system of parameters.** Along any ordered basis
`Module.Basis (Fin n) ℂ E`, the centered coordinate germs in a holomorphic chart `e` at `x` form a
regular sequence on `𝒪_{X, x}`. -/
theorem isRegular_ofFn_holomorphicLinearCoordinateGerm {n : ℕ} (b : Module.Basis (Fin n) ℂ E) :
    RingTheory.Sequence.IsRegular ((holomorphicStructureSheaf 𝓘(ℂ, E) X).presheaf.stalk x)
      (List.ofFn fun i ↦ e.holomorphicLinearCoordinateGerm he x
        (LinearMap.toContinuousLinearMap (b.coord i)) hx) := by
  apply TauCeti.IsRegularLocalRing.isRegular_of_ofList_eq_maximalIdeal
    (e.ofList_ofFn_holomorphicLinearCoordinateGerm x hx he b)
  rw [List.length_ofFn, spanFinrank_maximalIdeal_stalk, Module.finrank_eq_card_basis b,
    Fintype.card_fin]

end OpenPartialHomeomorph
