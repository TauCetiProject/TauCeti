public import Mathlib.Topology.Sheaves.LocalPredicate

/-!
# Closed analytic subspaces cut out by ideals of holomorphic functions

Let `X` be a complex manifold and `J` an ideal of the ring `𝒪(X)` of holomorphic functions on
`X`. The closed analytic subspace cut out by `J` is the locally ringed space
`(V(J), (𝒪_X ⧸ J 𝒪_X)|_{V(J)})`: its points form the common zero locus `V(J)` of the functions in
`J`, and its stalk at a point `x` is the quotient `𝒪_{X,x} ⧸ J_x` of the holomorphic stalk by the
ideal `J_x` generated by the germs of the functions in `J`. Nothing is radicalized, so nilpotent
functions survive: for `J = (z²)` on `ℂ` the zero locus is the origin, while the stalk there is
`ℂ{z} ⧸ (z²)`, in which the class of `z` is nonzero.

For an open subset `X` of `ℂⁿ` and a finitely generated `J` these are the local models of complex
analytic spaces. The node chart `{(b, x, y) | xy = s(b)}` of a nodal family is the case
`J = (xy - s(b))` on a product manifold, and the zero ideal cuts out all of `X` with its
holomorphic stalks.

The structure sheaf is built concretely, as for the structure sheaf of a prime spectrum. A section
over an open subset `W` of `V(J)` is a family of classes `f w ∈ 𝒪_{X,w} ⧸ J_w`, `w ∈ W`, that is
locally the family of classes of the germs of a single holomorphic function
(`TauCeti.closedAnalyticSubspace.isLocallyRestriction`). Restricting holomorphic functions gives
the ring homomorphisms `TauCeti.closedAnalyticSubspace.restrictRingHom`, the sheaf components of
the inclusion of the subspace. Evaluation of germs identifies the stalks with the quotients
`𝒪_{X,x} ⧸ J_x` (`TauCeti.closedAnalyticSubspace.stalkEquiv`). The key point for injectivity is
that membership in `J_x` spreads: a germ in `J_x` has a representative whose germs at all nearby
points `w` lie in `J_w` (`TauCeti.closedAnalyticSubspace.exists_germ_eq_forall_germ_mem`).

## Main definitions

* `TauCeti.closedAnalyticSubspace.zeroLocus J`: the common zero locus `V(J)`, a closed subset.
* `TauCeti.closedAnalyticSubspace.stalkIdeal J x`: the ideal `J_x` of `𝒪_{X,x}`.
* `TauCeti.closedAnalyticSubspace.sheaf J`: the sheaf of rings `(𝒪_X ⧸ J 𝒪_X)|_{V(J)}`, with
  `TauCeti.closedAnalyticSubspace.sectionsEquiv` reading its sections as families of classes.
* `TauCeti.closedAnalyticSubspace.restrictRingHom J U`: restriction of holomorphic functions on
  `U` to sections over `U ∩ V(J)`.
* `TauCeti.closedAnalyticSubspace J`: the locally ringed space `(V(J), (𝒪_X ⧸ J 𝒪_X)|_{V(J)})`.

## Main results

* `TauCeti.closedAnalyticSubspace.zeroLocus_span`: the zero locus of a generated ideal is the
  common zero set of the generators.
* `TauCeti.closedAnalyticSubspace.stalkIdeal_ne_top_iff`: `J_x` is proper exactly at the points
  of `V(J)`.
* `TauCeti.closedAnalyticSubspace.exists_germ_eq_forall_germ_mem`: membership in `J_x` spreads to
  the stalk ideals at nearby points.
* `TauCeti.closedAnalyticSubspace.stalkEquiv`: the stalk at `x` is `𝒪_{X,x} ⧸ J_x`.
* `TauCeti.closedAnalyticSubspace.zeroLocus_bot`, `TauCeti.closedAnalyticSubspace.stalkIdeal_bot`
  and `TauCeti.closedAnalyticSubspace.zeroLocus_top`: the zero ideal cuts out all of `X` with its
  holomorphic stalks, and the unit ideal cuts out the empty space.
* `TauCeti.closedAnalyticSubspace.not_isReduced_stalk_span_sq`: the ideal `(f²)` cuts out a
  nonreduced space wherever the germ of `f` is nonzero.

## References

* Gerd Fischer, *Complex Analytic Geometry*, Lecture Notes in Mathematics 538, Springer, 1976,
  Chapter 0 (local models of complex spaces).
* Hans Grauert and Reinhold Remmert, *Coherent Analytic Sheaves*, Grundlehren der mathematischen
  Wissenschaften 265, Springer, 1984, Chapter 1.
* The construction of the sheaf by a local predicate and of the stalk map by evaluation follows
  `AlgebraicGeometry.StructureSheaf` in `Mathlib/AlgebraicGeometry/StructureSheaf.lean`, by Johan
  Commelin, Kevin Buzzard, Kim Morrison and Eric Wieser.
-/

public noncomputable section

open CategoryTheory Opposite TopologicalSpace Topology AlgebraicGeometry
open scoped ContDiff Manifold

namespace TauCeti.closedAnalyticSubspace

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℂ E H}
  {X : Type} [TopologicalSpace X] [ChartedSpace H X]
  (J : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤)))

/-! ### The zero locus and the stalk ideals -/

/-- The common zero locus `V(J)` of an ideal `J` of holomorphic functions on `X`. -/
def zeroLocus : Set X :=
  {x | ∀ f ∈ J, f ⟨x, trivial⟩ = 0}

variable {J} in
/-- A point lies on `V(J)` when every function in `J` vanishes there. -/
@[simp]
theorem mem_zeroLocus_iff {x : X} : x ∈ zeroLocus J ↔ ∀ f ∈ J, f ⟨x, trivial⟩ = 0 :=
  Iff.rfl

/-- The zero locus of an ideal of holomorphic functions is closed. -/
theorem isClosed_zeroLocus : IsClosed (zeroLocus J) := by
  have : zeroLocus J = ⋂ f ∈ J, {x : X | f ⟨x, trivial⟩ = 0} := by
    ext x
    simp
  rw [this]
  exact isClosed_biInter fun f _ ↦ isClosed_eq
    ((holomorphicStructureSheaf.contMDiff f).continuous.comp
      (continuous_id.subtype_mk fun _ ↦ trivial)) continuous_const

variable {J} in
/-- A larger ideal has a smaller zero locus. -/
theorem zeroLocus_anti_mono {J' : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤))}
    (h : J ≤ J') : zeroLocus J' ⊆ zeroLocus J :=
  fun _ hx f hf ↦ hx f (h hf)

/-- The zero locus of the ideal generated by a set of functions is their common zero locus. -/
theorem zeroLocus_span (s : Set ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤))) :
    zeroLocus (Ideal.span s) = {x | ∀ f ∈ s, f ⟨x, trivial⟩ = 0} := by
  ext x
  refine ⟨fun hx f hf ↦ hx f (Ideal.subset_span hf), fun hx f hf ↦ ?_⟩
  -- The functions vanishing at `x` form the kernel of evaluation of germs at `x`.
  have hle : Ideal.span s ≤ RingHom.ker ((holomorphicStructureSheaf.eval I X x).comp
      ((holomorphicStructureSheaf I X).presheaf.germ ⊤ x (Opens.mem_top x)).hom) :=
    Ideal.span_le.mpr fun g hg ↦ by
      rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply,
        holomorphicStructureSheaf.eval_germ]
      exact hx g hg
  have hfx := hle hf
  rwa [RingHom.mem_ker, RingHom.comp_apply, holomorphicStructureSheaf.eval_germ] at hfx

/-- The zero locus of the ideal generated by one function is its zero set. -/
@[simp]
theorem zeroLocus_span_singleton (f : (holomorphicStructureSheaf I X).presheaf.obj (op ⊤)) :
    zeroLocus (Ideal.span {f}) = {x | f ⟨x, trivial⟩ = 0} := by
  rw [zeroLocus_span]
  simp only [Set.mem_singleton_iff, forall_eq]

/-- The zero ideal cuts out all of `X`. -/
@[simp]
theorem zeroLocus_bot :
    zeroLocus (⊥ : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤))) = Set.univ :=
  Set.eq_univ_of_forall fun _ f hf ↦ by
    rw [(Submodule.mem_bot _).mp hf]
    exact holomorphicStructureSheaf.zero_apply _

/-- The unit ideal cuts out the empty set. -/
@[simp]
theorem zeroLocus_top :
    zeroLocus (⊤ : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤))) = ∅ :=
  Set.eq_empty_of_forall_notMem fun _ hx ↦ one_ne_zero
    ((holomorphicStructureSheaf.one_apply _).symm.trans (hx 1 Submodule.mem_top))

/-- The ideal `J_x` of the holomorphic stalk at `x` generated by the germs of the functions
in `J`. -/
def stalkIdeal (x : X) : Ideal ((holomorphicStructureSheaf I X).presheaf.stalk x) :=
  J.map ((holomorphicStructureSheaf I X).presheaf.germ ⊤ x (Opens.mem_top x)).hom

variable {J} in
/-- The germ of a function in `J` lies in each stalk ideal of `J`. -/
theorem germ_mem_stalkIdeal {f : (holomorphicStructureSheaf I X).presheaf.obj (op ⊤)}
    (hf : f ∈ J) (x : X) :
    (holomorphicStructureSheaf I X).presheaf.germ ⊤ x (Opens.mem_top x) f ∈ stalkIdeal J x :=
  Ideal.mem_map_of_mem _ hf

/-- The stalk ideal of the ideal generated by a set of functions is generated by their germs. -/
theorem stalkIdeal_span (s : Set ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤))) (x : X) :
    stalkIdeal (Ideal.span s) x =
      Ideal.span ((holomorphicStructureSheaf I X).presheaf.germ ⊤ x (Opens.mem_top x) '' s) :=
  Ideal.map_span _ s

/-- The zero ideal has zero stalk ideals, so the closed analytic subspace it cuts out has the
holomorphic stalks of `X`. -/
@[simp]
theorem stalkIdeal_bot (x : X) :
    stalkIdeal (⊥ : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤))) x = ⊥ :=
  Ideal.map_bot

variable {J} in
/-- The stalk ideal is proper exactly at the points of the zero locus. -/
theorem stalkIdeal_ne_top_iff {x : X} : stalkIdeal J x ≠ ⊤ ↔ x ∈ zeroLocus J := by
  constructor
  · intro hx f hf
    by_contra hfx
    refine hx (Ideal.eq_top_of_isUnit_mem _ (germ_mem_stalkIdeal hf x) ?_)
    rw [holomorphicStructureSheaf.isUnit_stalk_iff, holomorphicStructureSheaf.eval_germ]
    exact hfx
  · intro hx htop
    have hle : stalkIdeal J x ≤ RingHom.ker (holomorphicStructureSheaf.eval I X x) := by
      refine Ideal.map_le_iff_le_comap.mpr fun f hf ↦ ?_
      rw [Ideal.mem_comap, RingHom.mem_ker, holomorphicStructureSheaf.eval_germ]
      exact hx f hf
    have h1 := hle (htop ▸ Submodule.mem_top : (1 : _) ∈ stalkIdeal J x)
    rw [RingHom.mem_ker, map_one] at h1
    exact one_ne_zero h1

/-- The germs at `x` with a representative near `x` whose germs at every point `w` of its domain
lie in `J_w`. -/
private def spreadIdeal (x : X) : Ideal ((holomorphicStructureSheaf I X).presheaf.stalk x) where
  carrier := {s | ∃ (U : Opens X) (hx : x ∈ U)
    (g : (holomorphicStructureSheaf I X).presheaf.obj (op U)),
    (holomorphicStructureSheaf I X).presheaf.germ U x hx g = s ∧
      ∀ (w : X) (hw : w ∈ U), (holomorphicStructureSheaf I X).presheaf.germ U w hw g ∈
        stalkIdeal J w}
  zero_mem' := ⟨⊤, trivial, 0, map_zero _, fun w _ ↦ by
    rw [map_zero]
    exact zero_mem _⟩
  add_mem' := by
    rintro - - ⟨U, hxU, g, rfl, hg⟩ ⟨V, hxV, h, rfl, hh⟩
    refine ⟨U ⊓ V, Opens.mem_inf.2 ⟨hxU, hxV⟩,
      (holomorphicStructureSheaf I X).presheaf.map (homOfLE inf_le_left).op g +
        (holomorphicStructureSheaf I X).presheaf.map (homOfLE inf_le_right).op h,
      ?_, fun w hw ↦ ?_⟩
    · rw [map_add, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply]
    · rw [map_add, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply]
      exact add_mem (hg w (Opens.mem_inf.1 hw).1) (hh w (Opens.mem_inf.1 hw).2)
  smul_mem' := by
    rintro c - ⟨U, hxU, g, rfl, hg⟩
    obtain ⟨V, hxV, h, rfl⟩ := (holomorphicStructureSheaf I X).presheaf.exists_germ_eq c
    refine ⟨V ⊓ U, Opens.mem_inf.2 ⟨hxV, hxU⟩,
      (holomorphicStructureSheaf I X).presheaf.map (homOfLE inf_le_left).op h *
        (holomorphicStructureSheaf I X).presheaf.map (homOfLE inf_le_right).op g,
      ?_, fun w hw ↦ ?_⟩
    · rw [map_mul, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply, smul_eq_mul]
    · rw [map_mul, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply]
      exact Ideal.mul_mem_left _ _ (hg w (Opens.mem_inf.1 hw).2)

variable {J} in
/-- **Membership in the stalk ideals spreads.** A germ in `J_x` is the germ of a holomorphic
function near `x` whose germs at all points `w` of its domain lie in `J_w`. -/
theorem exists_germ_eq_forall_germ_mem {x : X}
    {s : (holomorphicStructureSheaf I X).presheaf.stalk x} (hs : s ∈ stalkIdeal J x) :
    ∃ (U : Opens X) (hx : x ∈ U) (g : (holomorphicStructureSheaf I X).presheaf.obj (op U)),
      (holomorphicStructureSheaf I X).presheaf.germ U x hx g = s ∧
        ∀ (w : X) (hw : w ∈ U), (holomorphicStructureSheaf I X).presheaf.germ U w hw g ∈
          stalkIdeal J w := by
  have hle : stalkIdeal J x ≤ spreadIdeal J x :=
    Ideal.map_le_iff_le_comap.mpr fun f hf ↦ ⟨⊤, trivial, f, rfl, fun w _ ↦
      germ_mem_stalkIdeal hf w⟩
  exact hle hs

/-- The stalk `𝒪_{X,x} ⧸ J_x` of the closed analytic subspace at a point of the zero locus. -/
abbrev Fiber (z : zeroLocus J) : Type :=
  (holomorphicStructureSheaf I X).presheaf.stalk (z : X) ⧸ stalkIdeal J z

instance (z : zeroLocus J) : Nontrivial (Fiber J z) :=
  Ideal.Quotient.nontrivial_iff.mpr (stalkIdeal_ne_top_iff.mpr z.property)

instance (z : zeroLocus J) : IsLocalRing (Fiber J z) :=
  IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

/-! ### The structure sheaf -/

/-- A family of classes in the stalks `𝒪_{X,w} ⧸ J_w` over an open subset `W` of the zero locus
is a restriction if it is the family of classes of the germs of one holomorphic function. -/
private def isRestriction :
    TopCat.PrelocalPredicate (fun z : TopCat.of (zeroLocus J) ↦ Fiber J z) where
  pred {W} f := ∃ (U : Opens X) (hU : ∀ w : W, w.val.val ∈ U)
    (g : (holomorphicStructureSheaf I X).presheaf.obj (op U)),
    ∀ w : W, f w = Ideal.Quotient.mk _
      ((holomorphicStructureSheaf I X).presheaf.germ U w.val.val (hU w) g)
  res {_ _} i _ := fun ⟨U, hU, g, h⟩ ↦
    ⟨U, fun w ↦ hU (Set.inclusion i.le w), g, fun w ↦ h (Set.inclusion i.le w)⟩

/-- The sections of `(𝒪_X ⧸ J 𝒪_X)|_{V(J)}`: families of classes which are locally restrictions
of holomorphic functions. -/
def isLocallyRestriction :
    TopCat.LocalPredicate (fun z : TopCat.of (zeroLocus J) ↦ Fiber J z) :=
  (isRestriction J).sheafify

variable {J} in
/-- A family is a section exactly when, near each point, it is the family of classes of the germs
of one holomorphic function. -/
theorem isLocallyRestriction_pred_iff {W : Opens (TopCat.of (zeroLocus J))}
    {f : ∀ w : W, Fiber J w.val} :
    (isLocallyRestriction J).pred f ↔ ∀ w : W, ∃ (V : Opens (TopCat.of (zeroLocus J)))
      (_ : w.val ∈ V) (i : V ⟶ W) (U : Opens X) (hU : ∀ v : V, v.val.val ∈ U)
      (g : (holomorphicStructureSheaf I X).presheaf.obj (op U)),
      ∀ v : V, f (Set.inclusion i.le v) = Ideal.Quotient.mk _
        ((holomorphicStructureSheaf I X).presheaf.germ U v.val.val (hU v) g) :=
  Iff.rfl

/-- The ring of sections over an open subset `W` of the zero locus. -/
def sectionsSubring (W : Opens (TopCat.of (zeroLocus J))) :
    Subring (∀ w : W, Fiber J w.val) where
  carrier := {f | (isLocallyRestriction J).pred f}
  zero_mem' := TopCat.PrelocalPredicate.sheafifyOf ⟨⊤, fun _ ↦ trivial, 0, fun _ ↦ by
    rw [map_zero, map_zero]
    rfl⟩
  one_mem' := TopCat.PrelocalPredicate.sheafifyOf ⟨⊤, fun _ ↦ trivial, 1, fun _ ↦ by
    rw [map_one, map_one]
    rfl⟩
  add_mem' {a b} ha hb := by
    refine (isRestriction J).sheafify_inductionOn₂' (isRestriction J) (isRestriction J)
      (fun s t ↦ s + t) ?_ ha hb
    rintro U V a b ⟨P, hP, g, hg⟩ ⟨Q, hQ, h, hh⟩
    refine ⟨P ⊓ Q, fun w ↦ Opens.mem_inf.2
      ⟨hP ⟨w.val, (Opens.mem_inf.1 w.property).1⟩, hQ ⟨w.val, (Opens.mem_inf.1 w.property).2⟩⟩,
      (holomorphicStructureSheaf I X).presheaf.map (homOfLE inf_le_left).op g +
        (holomorphicStructureSheaf I X).presheaf.map (homOfLE inf_le_right).op h, fun w ↦ ?_⟩
    simp only [hg, hh]
    rw [map_add, map_add, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply]
  neg_mem' {a} ha := by
    refine (isRestriction J).sheafify_inductionOn' (fun s ↦ -s) ?_ ha
    rintro U a ⟨P, hP, g, hg⟩
    exact ⟨P, hP, -g, fun w ↦ by simp only [hg, map_neg]⟩
  mul_mem' {a b} ha hb := by
    refine (isRestriction J).sheafify_inductionOn₂' (isRestriction J) (isRestriction J)
      (fun s t ↦ s * t) ?_ ha hb
    rintro U V a b ⟨P, hP, g, hg⟩ ⟨Q, hQ, h, hh⟩
    refine ⟨P ⊓ Q, fun w ↦ Opens.mem_inf.2
      ⟨hP ⟨w.val, (Opens.mem_inf.1 w.property).1⟩, hQ ⟨w.val, (Opens.mem_inf.1 w.property).2⟩⟩,
      (holomorphicStructureSheaf I X).presheaf.map (homOfLE inf_le_left).op g *
        (holomorphicStructureSheaf I X).presheaf.map (homOfLE inf_le_right).op h, fun w ↦ ?_⟩
    simp only [hg, hh]
    rw [map_mul, map_mul, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply]

variable {J} in
/-- Membership in the ring of sections is the local predicate of sections. -/
@[simp]
theorem mem_sectionsSubring_iff {W : Opens (TopCat.of (zeroLocus J))}
    {f : ∀ w : W, Fiber J w.val} :
    f ∈ sectionsSubring J W ↔ (isLocallyRestriction J).pred f :=
  Iff.rfl

/-- The presheaf of rings of sections of `(𝒪_X ⧸ J 𝒪_X)|_{V(J)}`, with restriction of
families. -/
private def presheaf : TopCat.Presheaf CommRingCat (TopCat.of (zeroLocus J)) where
  obj W := CommRingCat.of (sectionsSubring J W.unop)
  map {_ _} i := CommRingCat.ofHom
    { toFun f := ⟨fun w ↦ f.val (Set.inclusion i.unop.le w),
        (isLocallyRestriction J).res i.unop f.val f.property⟩
      map_one' := rfl
      map_mul' _ _ := rfl
      map_zero' := rfl
      map_add' _ _ := rfl }
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The sheaf of rings `(𝒪_X ⧸ J 𝒪_X)|_{V(J)}` on the zero locus of `J`. Its sections over `W`
are the families of classes in `𝒪_{X,w} ⧸ J_w`, `w ∈ W`, which are locally the classes of the
germs of one holomorphic function. -/
def sheaf : TopCat.Sheaf CommRingCat (TopCat.of (zeroLocus J)) where
  obj := presheaf J
  property := by
    rw [Presheaf.isSheaf_iff_isSheaf_forget _ _ (forget CommRingCat)]
    -- The underlying presheaf of sets is the subsheaf cut out by the local predicate.
    exact TopCat.Presheaf.isSheaf_of_iso (NatIso.ofComponents (fun _ ↦ (Equiv.refl _).toIso)
      fun _ ↦ rfl) (TopCat.subsheafToTypes (isLocallyRestriction J)).property

/-- Read a section of the structure sheaf over `W` as a family in `sectionsSubring J W`. -/
def sectionsEquiv (W : Opens (TopCat.of (zeroLocus J))) :
    (sheaf J).presheaf.obj (op W) ≃+* sectionsSubring J W :=
  RingEquiv.refl _

variable {J} in
/-- Restriction of sections is restriction of families. -/
@[simp]
theorem sectionsEquiv_map_apply {W V : Opens (TopCat.of (zeroLocus J))} (i : V ⟶ W)
    (f : (sheaf J).presheaf.obj (op W)) (v : V) :
    (sectionsEquiv J V ((sheaf J).presheaf.map i.op f)).val v =
      (sectionsEquiv J W f).val (Set.inclusion i.le v) :=
  (rfl)

variable {J} in
/-- Sections of the structure sheaf are equal when they have the same classes at every point. -/
theorem sheaf_ext {W : Opens (TopCat.of (zeroLocus J))} {f g : (sheaf J).presheaf.obj (op W)}
    (h : ∀ w : W, (sectionsEquiv J W f).val w = (sectionsEquiv J W g).val w) : f = g :=
  (sectionsEquiv J W).injective (Subtype.ext (funext h))

/-- Restricting a holomorphic function on `U` to the family of classes of its germs at the points
of `U ∩ V(J)`. -/
private def restrictToSections (U : Opens X) :
    (holomorphicStructureSheaf I X).presheaf.obj (op U) →+*
      sectionsSubring J (Opens.comap ⟨Subtype.val, continuous_subtypeVal⟩ U) where
  toFun g := ⟨fun w ↦ Ideal.Quotient.mk _
      ((holomorphicStructureSheaf I X).presheaf.germ U w.val.val w.property g),
    TopCat.PrelocalPredicate.sheafifyOf (P := isRestriction J)
      ⟨U, fun w ↦ w.property, g, fun _ ↦ rfl⟩⟩
  map_one' := Subtype.ext <| funext fun _ ↦
    (congrArg (Ideal.Quotient.mk _) (map_one _)).trans (map_one _)
  map_mul' g h := Subtype.ext <| funext fun _ ↦
    (congrArg (Ideal.Quotient.mk _) (map_mul _ g h)).trans (map_mul _ _ _)
  map_zero' := Subtype.ext <| funext fun _ ↦
    (congrArg (Ideal.Quotient.mk _) (map_zero _)).trans (map_zero _)
  map_add' g h := Subtype.ext <| funext fun _ ↦
    (congrArg (Ideal.Quotient.mk _) (map_add _ g h)).trans (map_add _ _ _)

/-- The ring homomorphism restricting holomorphic functions on an open subset `U` of `X` to the
trace `U ∩ V(J)`: a function goes to the family of classes of its germs. These are the sheaf
components of the inclusion of the closed analytic subspace into `X`. -/
def restrictRingHom (U : Opens X) :
    (holomorphicStructureSheaf I X).presheaf.obj (op U) →+*
      (sheaf J).presheaf.obj (op (Opens.comap ⟨Subtype.val, continuous_subtypeVal⟩ U)) :=
  (sectionsEquiv J _).symm.toRingHom.comp (restrictToSections J U)

variable {J} in
/-- The restriction of a holomorphic function has, at each point, the class of its germ. -/
@[simp]
theorem sectionsEquiv_restrictRingHom_apply (U : Opens X)
    (g : (holomorphicStructureSheaf I X).presheaf.obj (op U))
    (w : Opens.comap ⟨Subtype.val, continuous_subtypeVal⟩ U) :
    (sectionsEquiv J _ (restrictRingHom J U g)).val w =
      Ideal.Quotient.mk _
        ((holomorphicStructureSheaf I X).presheaf.germ U w.val.val w.property g) :=
  (rfl)

variable {J} in
/-- Restriction of holomorphic functions commutes with restriction to smaller open sets, so the
maps `restrictRingHom J U` are the components of a morphism of presheaves. -/
theorem restrictRingHom_map {U V : Opens X} (h : V ≤ U)
    (g : (holomorphicStructureSheaf I X).presheaf.obj (op U)) :
    restrictRingHom J V ((holomorphicStructureSheaf I X).presheaf.map (homOfLE h).op g) =
      (sheaf J).presheaf.map (homOfLE (Opens.comap_mono _ h)).op (restrictRingHom J U g) :=
  sheaf_ext fun w ↦ by
    rw [sectionsEquiv_restrictRingHom_apply, sectionsEquiv_map_apply,
      sectionsEquiv_restrictRingHom_apply]
    exact congrArg (Ideal.Quotient.mk _)
      ((holomorphicStructureSheaf I X).presheaf.germ_res_apply (homOfLE h) w.val.val w.property g)

/-! ### Stalks -/

/-- Evaluation of germs of sections at their base point, with values in `𝒪_{X,z} ⧸ J_z`. -/
private def stalkToFiberRingHom (z : zeroLocus J) :
    (sheaf J).presheaf.stalk z ⟶ CommRingCat.of (Fiber J z) :=
  Limits.colimit.desc ((OpenNhds.inclusion (X := TopCat.of (zeroLocus J)) z).op ⋙
      (sheaf J).presheaf)
    { pt := CommRingCat.of (Fiber J z)
      ι :=
        { app W := CommRingCat.ofHom ((Pi.evalRingHom (fun w : W.unop.val ↦ Fiber J w.val)
            ⟨z, W.unop.property⟩).comp ((sectionsSubring J W.unop.val).subtype.comp
              (sectionsEquiv J W.unop.val).toRingHom))
          naturality _ _ _ := rfl } }

variable {J} in
private theorem stalkToFiberRingHom_germ {z : zeroLocus J} {W : Opens (TopCat.of (zeroLocus J))}
    (hz : z ∈ W) (f : (sheaf J).presheaf.obj (op W)) :
    stalkToFiberRingHom J z ((sheaf J).presheaf.germ W z hz f) =
      (sectionsEquiv J W f).val ⟨z, hz⟩ := by
  rw [← ConcreteCategory.comp_apply]
  exact ConcreteCategory.congr_hom (Limits.colimit.ι_desc
    (F := (OpenNhds.inclusion (X := TopCat.of (zeroLocus J)) z).op ⋙ (sheaf J).presheaf) _
    (op ⟨W, hz⟩)) f

private theorem stalkToFiberRingHom_surjective (z : zeroLocus J) :
    Function.Surjective (stalkToFiberRingHom J z) := by
  intro t
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective t
  obtain ⟨U, hzU, g, rfl⟩ := (holomorphicStructureSheaf I X).presheaf.exists_germ_eq s
  exact ⟨(sheaf J).presheaf.germ _ z hzU (restrictRingHom J U g),
    stalkToFiberRingHom_germ hzU _⟩

private theorem stalkToFiberRingHom_injective (z : zeroLocus J) :
    Function.Injective (stalkToFiberRingHom J z) := by
  refine (injective_iff_map_eq_zero (stalkToFiberRingHom J z).hom).mpr fun s hs ↦ ?_
  obtain ⟨W, hzW, f, rfl⟩ := (sheaf J).presheaf.exists_germ_eq s
  have hfz : (sectionsEquiv J W f).val ⟨z, hzW⟩ = 0 :=
    (stalkToFiberRingHom_germ hzW f).symm.trans hs
  -- Near `z`, the section `f` is the family of classes of the germs of some `g`.
  obtain ⟨V, hzV, iV, U, hU, g, hg⟩ := (sectionsEquiv J W f).property ⟨z, hzW⟩
  have hgz : (holomorphicStructureSheaf I X).presheaf.germ U z.val (hU ⟨z, hzV⟩) g ∈
      stalkIdeal J z := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    exact (hg ⟨z, hzV⟩).symm.trans hfz
  -- The germ of `g` at `z` lies in `J_z`, so the germs of `g` lie in `J_w` near `z`.
  obtain ⟨U', hzU', g', hgg', hg'⟩ := exists_germ_eq_forall_germ_mem hgz
  obtain ⟨U'', hzU'', i', i, hU''⟩ :=
    (holomorphicStructureSheaf I X).presheaf.germ_eq z.val hzU' (hU ⟨z, hzV⟩) g' g hgg'
  let N : Opens (TopCat.of (zeroLocus J)) :=
    V ⊓ Opens.comap ⟨Subtype.val, continuous_subtypeVal⟩ U''
  have hzN : z ∈ N := Opens.mem_inf.2 ⟨hzV, hzU''⟩
  have hNW : N ≤ W := inf_le_left.trans iV.le
  have hres : (sheaf J).presheaf.map (homOfLE hNW).op f = 0 := by
    refine sheaf_ext fun w ↦ ?_
    have hwU'' : w.val.val ∈ U'' := (Opens.mem_inf.1 w.property).2
    -- The germs of `g` and `g'` at `w` agree, since `g` and `g'` agree on `U''`.
    have hw : (holomorphicStructureSheaf I X).presheaf.germ U w.val.val
        (hU ⟨w.val, (Opens.mem_inf.1 w.property).1⟩) g ∈ stalkIdeal J w.val :=
      (((holomorphicStructureSheaf I X).presheaf.germ_res_apply i w.val.val hwU'' g).symm.trans
        ((congrArg _ hU''.symm).trans
          ((holomorphicStructureSheaf I X).presheaf.germ_res_apply i' w.val.val hwU'' g'))) ▸
        hg' w.val.val (i'.le hwU'')
    rw [sectionsEquiv_map_apply, map_zero]
    exact (hg ⟨w.val, (Opens.mem_inf.1 w.property).1⟩).trans (Ideal.Quotient.eq_zero_iff_mem.mpr hw)
  rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE hNW) z hzN f, hres, map_zero]

/-- **The stalks of a closed analytic subspace.** Evaluation of germs identifies the stalk of
`(𝒪_X ⧸ J 𝒪_X)|_{V(J)}` at `z` with the quotient `𝒪_{X,z} ⧸ J_z`. -/
def stalkEquiv (z : zeroLocus J) : (sheaf J).presheaf.stalk z ≃+* Fiber J z :=
  RingEquiv.ofBijective (stalkToFiberRingHom J z).hom
    ⟨stalkToFiberRingHom_injective J z, stalkToFiberRingHom_surjective J z⟩

variable {J} in
/-- The stalk isomorphism sends the germ of a section to its class at the base point. -/
@[simp]
theorem stalkEquiv_germ {z : zeroLocus J} {W : Opens (TopCat.of (zeroLocus J))} (hz : z ∈ W)
    (f : (sheaf J).presheaf.obj (op W)) :
    stalkEquiv J z ((sheaf J).presheaf.germ W z hz f) = (sectionsEquiv J W f).val ⟨z, hz⟩ :=
  stalkToFiberRingHom_germ hz f

instance isLocalRing_stalk (z : zeroLocus J) : IsLocalRing ((sheaf J).presheaf.stalk z) :=
  (stalkEquiv J z).symm.isLocalRing

end closedAnalyticSubspace

/-- **The closed analytic subspace cut out by an ideal of holomorphic functions.** The locally
ringed space `(V(J), (𝒪_X ⧸ J 𝒪_X)|_{V(J)})`, whose stalk at `x` is `𝒪_{X,x} ⧸ J_x`
(`TauCeti.closedAnalyticSubspace.stalkEquiv`). -/
abbrev closedAnalyticSubspace {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℂ E H}
    {X : Type} [TopologicalSpace X] [ChartedSpace H X]
    (J : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤))) : LocallyRingedSpace where
  carrier := TopCat.of (closedAnalyticSubspace.zeroLocus J)
  presheaf := (closedAnalyticSubspace.sheaf J).presheaf
  IsSheaf := (closedAnalyticSubspace.sheaf J).property
  isLocalRing := closedAnalyticSubspace.isLocalRing_stalk J

namespace closedAnalyticSubspace

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℂ E H}
  {X : Type} [TopologicalSpace X] [ChartedSpace H X]

/-! ### Nilpotents survive -/

/-- If `f` vanishes at `x` but has a nonzero germ there, the germ of `f` does not lie in the ideal
generated by the germ of `f ^ 2`. -/
private theorem germ_notMem_stalkIdeal_span_sq
    {f : (holomorphicStructureSheaf I X).presheaf.obj (op ⊤)} {x : X} (hfx : f ⟨x, trivial⟩ = 0)
    (hf : (holomorphicStructureSheaf I X).presheaf.germ ⊤ x (Opens.mem_top x) f ≠ 0) :
    (holomorphicStructureSheaf I X).presheaf.germ ⊤ x (Opens.mem_top x) f ∉
      stalkIdeal (Ideal.span {f ^ 2}) x := by
  rw [stalkIdeal_span, Set.image_singleton, map_pow, Ideal.mem_span_singleton']
  rintro ⟨b, hb⟩
  set t := (holomorphicStructureSheaf I X).presheaf.germ ⊤ x (Opens.mem_top x) f
  -- From `t = b t²` we get `t (1 - b t) = 0`, and `1 - b t` is a unit because `t(x) = 0`.
  have hunit : IsUnit (1 - b * t) := by
    rw [holomorphicStructureSheaf.isUnit_stalk_iff, map_sub, map_one, map_mul,
      holomorphicStructureSheaf.eval_germ, hfx, mul_zero, sub_zero]
    exact one_ne_zero
  refine hf ((IsUnit.mul_left_eq_zero hunit).mp ?_)
  linear_combination -hb

/-- **Nilpotents survive.** If `f` has a nonzero germ at a point `z` of the zero locus of `f ^ 2`,
then the stalk of the closed analytic subspace cut out by `f ^ 2` at `z` is not reduced: the class
of the germ of `f` is a nonzero nilpotent. For `f = z` on `ℂ` this is the double point, with
stalk `ℂ{z} ⧸ (z²)` at the origin, although its only point is the origin. -/
theorem not_isReduced_stalk_span_sq {f : (holomorphicStructureSheaf I X).presheaf.obj (op ⊤)}
    (z : zeroLocus (Ideal.span {f ^ 2}))
    (hf : (holomorphicStructureSheaf I X).presheaf.germ ⊤ z.val (Opens.mem_top _) f ≠ 0) :
    ¬ IsReduced ((closedAnalyticSubspace (Ideal.span {f ^ 2})).presheaf.stalk z) := by
  intro hred
  have hfz : f ⟨z.val, trivial⟩ = 0 := by
    have hz := z.property (f ^ 2) (Ideal.subset_span rfl)
    rw [holomorphicStructureSheaf.pow_apply] at hz
    exact pow_eq_zero_iff two_ne_zero |>.mp hz
  have hnil : IsNilpotent (Ideal.Quotient.mk (stalkIdeal (Ideal.span {f ^ 2}) z.val)
      ((holomorphicStructureSheaf I X).presheaf.germ ⊤ z.val (Opens.mem_top _) f)) :=
    ⟨2, by
      rw [← map_pow, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
      exact germ_mem_stalkIdeal (Ideal.subset_span rfl) z.val⟩
  refine germ_notMem_stalkIdeal_span_sq hfz hf (Ideal.Quotient.eq_zero_iff_mem.mp ?_)
  exact (stalkEquiv _ z).symm.injective
    (((hnil.map (stalkEquiv _ z).symm).eq_zero).trans (map_zero _).symm)

end TauCeti.closedAnalyticSubspace
