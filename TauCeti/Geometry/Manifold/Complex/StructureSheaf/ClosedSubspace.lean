/-!
# Closed analytic subspaces cut out by ideals of holomorphic functions

Let `X` be a complex manifold and `J` an ideal of the ring `𝒪(X)` of holomorphic functions on
`X`. The closed analytic subspace cut out by `J` is the locally ringed space
`(V(J), (𝒪_X ⧸ J 𝒪_X)|_{V(J)})`: its points form the common zero locus `V(J)` of the functions in
`J`, and its stalk at a point `x` is the quotient `𝒪_{X,x} ⧸ J_x` of the holomorphic stalk by the
ideal `J_x` generated by the germs of the functions in `J`. Nothing is radicalized, so nilpotent
functions survive: for `J = (z²)` on `ℂ` the zero locus is the origin, while the stalk there is
`ℂ{z} ⧸ (z²)`, in which the class of `z` is a nonzero nilpotent.

For an open subset `X` of `ℂⁿ` and a finitely generated `J` these are the local models of complex
analytic spaces. The node chart `{(b, x, y) | xy = s(b)}` of a nodal family is the case
`J = (xy - s(b))` on a product manifold.

The structure sheaf is the sheaf `TopCat.Presheaf.quotientIdealSheaf` of the holomorphic structure
sheaf, `J` and `V(J)`, which reads the stalks as the quotients `𝒪_{X,x} ⧸ J_x`
(`TauCeti.closedAnalyticSubspace.stalkEquiv`). What is specific to holomorphic functions is
that `J_x` is proper exactly at the points of `V(J)` (`stalkIdeal_ne_top_iff`), so that these
stalks are local rings.

## Main definitions

* `TauCeti.closedAnalyticSubspace.zeroLocus J`: the common zero locus `V(J)`, a closed subset.
* `TauCeti.closedAnalyticSubspace J`: the locally ringed space `(V(J), (𝒪_X ⧸ J 𝒪_X)|_{V(J)})`.
* `TauCeti.closedAnalyticSubspace.stalkEquiv J z`: its stalk at `z` is `𝒪_{X,z} ⧸ J_z`.

## Main results

* `TauCeti.closedAnalyticSubspace.zeroLocus_span`: the zero locus of a generated ideal is the
  common zero set of the generators.
* `TauCeti.closedAnalyticSubspace.stalkIdeal_le_ker_eval_iff`: the germs of `J` at `x` vanish at
  `x` exactly when `x ∈ V(J)`.
* `TauCeti.closedAnalyticSubspace.stalkIdeal_ne_top_iff`: `J_x` is proper exactly at the points
  of `V(J)`.
* `TauCeti.closedAnalyticSubspace.zeroLocus_bot` and `TopCat.Presheaf.stalkIdeal_bot`: the zero
  ideal cuts out all of `X`, with zero stalk ideals; `TauCeti.closedAnalyticSubspace.zeroLocus_top`:
  the unit ideal cuts out the empty set.
* `TauCeti.closedAnalyticSubspace.not_isReduced_stalk_span_sq`: the ideal `(f²)` cuts out a
  nonreduced space wherever the germ of `f` is nonzero.
* `TauCeti.closedAnalyticSubspace.zeroLocus_span_sq_of_apply_eq` and
  `TauCeti.closedAnalyticSubspace.not_isReduced_stalk_span_sq_of_apply_eq`: the double point. For
  the coordinate `z` on `ℂ`, the ideal `(z²)` cuts out the single point `0`, with nonreduced stalk.

## References

* Gerd Fischer, *Complex Analytic Geometry*, Lecture Notes in Mathematics 538, Springer, 1976,
  Chapter 0 (local models of complex spaces).
* Hans Grauert and Reinhold Remmert, *Coherent Analytic Sheaves*, Grundlehren der mathematischen
  Wissenschaften 265, Springer, 1984, Chapter 1.
-/

public noncomputable section

open CategoryTheory Opposite TopologicalSpace Topology AlgebraicGeometry Filter
open scoped ContDiff Manifold

namespace TauCeti.closedAnalyticSubspace

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℂ E H}
  {X : Type} [TopologicalSpace X] [ChartedSpace H X]
  (J : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤)))

/-! ### The zero locus -/

/-- The common zero locus `V(J)` of an ideal `J` of holomorphic functions on `X`. -/
def zeroLocus : Set X :=
  {x | ∀ f ∈ J, f ⟨x, trivial⟩ = 0}

variable {J} in
/-- A point lies on `V(J)` when every function in `J` vanishes there. -/
@[simp]
theorem mem_zeroLocus_iff {x : X} : x ∈ zeroLocus J ↔ ∀ f ∈ J, f ⟨x, trivial⟩ = 0 :=
  Iff.rfl

/-- The zero locus of an ideal of holomorphic functions is closed. -/
theorem isClosed_zeroLocus : IsClosed (zeroLocus J) := by
  have : zeroLocus J = ⋂ f ∈ J, {x : X | f ⟨x, trivial⟩ = 0} := by
    ext x
    simp
  rw [this]
  exact isClosed_biInter fun f _ ↦ isClosed_eq
    ((holomorphicStructureSheaf.contMDiff f).continuous.comp
      (continuous_id.subtype_mk fun _ ↦ trivial)) continuous_const

variable {J} in
/-- A larger ideal has a smaller zero locus. -/
theorem zeroLocus_anti_mono {J' : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤))}
    (h : J ≤ J') : zeroLocus J' ⊆ zeroLocus J :=
  fun _ hx f hf ↦ hx f (h hf)

variable {J} in
/-- The germs at `x` of the functions in `J` vanish at `x` exactly when `x` lies on `V(J)`. -/
theorem stalkIdeal_le_ker_eval_iff {x : X} :
    (holomorphicStructureSheaf I X).presheaf.stalkIdeal J x ≤
        RingHom.ker (holomorphicStructureSheaf.eval I X x) ↔ x ∈ zeroLocus J := by
  refine TopCat.Presheaf.stalkIdeal_le_iff.trans (forall₂_congr fun f _ ↦ ?_)
  rw [Ideal.mem_comap, RingHom.mem_ker, holomorphicStructureSheaf.eval_germ]

/-- The zero locus of the ideal generated by a set of functions is their common zero locus. -/
theorem zeroLocus_span (s : Set ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤))) :
    zeroLocus (Ideal.span s) = {x | ∀ f ∈ s, f ⟨x, trivial⟩ = 0} := by
  ext x
  refine ⟨fun hx f hf ↦ hx f (Ideal.subset_span hf), fun hx f hf ↦ ?_⟩
  -- The functions vanishing at `x` form an ideal containing `s`.
  induction hf using Submodule.span_induction with
  | mem g hg => exact hx g hg
  | zero => exact holomorphicStructureSheaf.zero_apply _
  | add g h _ _ hg hh => rw [holomorphicStructureSheaf.add_apply, hg, hh, add_zero]
  | smul a g _ hg => rw [smul_eq_mul, holomorphicStructureSheaf.mul_apply, hg, mul_zero]

/-- The zero locus of the ideal generated by one function is its zero set. -/
@[simp]
theorem zeroLocus_span_singleton (f : (holomorphicStructureSheaf I X).presheaf.obj (op ⊤)) :
    zeroLocus (Ideal.span {f}) = {x | f ⟨x, trivial⟩ = 0} := by
  rw [zeroLocus_span]
  simp only [Set.mem_singleton_iff, forall_eq]

/-- The zero ideal cuts out all of `X`. -/
@[simp]
theorem zeroLocus_bot :
    zeroLocus (⊥ : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤))) = Set.univ :=
  Set.eq_univ_of_forall fun _ f hf ↦ by
    rw [(Submodule.mem_bot _).mp hf]
    exact holomorphicStructureSheaf.zero_apply _

/-- The unit ideal cuts out the empty set. -/
@[simp]
theorem zeroLocus_top :
    zeroLocus (⊤ : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤))) = ∅ :=
  Set.eq_empty_of_forall_notMem fun _ hx ↦ one_ne_zero
    ((holomorphicStructureSheaf.one_apply _).symm.trans (hx 1 Submodule.mem_top))

variable {J} in
/-- The stalk ideal is proper exactly at the points of the zero locus. -/
theorem stalkIdeal_ne_top_iff {x : X} :
    (holomorphicStructureSheaf I X).presheaf.stalkIdeal J x ≠ ⊤ ↔ x ∈ zeroLocus J := by
  refine ⟨fun hx f hf ↦ ?_, fun hx h1 ↦ ?_⟩
  · by_contra hfx
    refine hx (Ideal.eq_top_of_isUnit_mem _ (TopCat.Presheaf.germ_mem_stalkIdeal hf x) ?_)
    rw [holomorphicStructureSheaf.isUnit_stalk_iff, holomorphicStructureSheaf.eval_germ]
    exact hfx
  · have h1 := stalkIdeal_le_ker_eval_iff.mpr hx ((Ideal.eq_top_iff_one _).mp h1)
    rw [RingHom.mem_ker, map_one] at h1
    exact one_ne_zero h1

end closedAnalyticSubspace

/-- **The closed analytic subspace cut out by an ideal of holomorphic functions.** The locally
ringed space `(V(J), (𝒪_X ⧸ J 𝒪_X)|_{V(J)})`, whose stalk at `x` is `𝒪_{X,x} ⧸ J_x`
(`TauCeti.closedAnalyticSubspace.stalkEquiv`).

The body is exposed so that the points of `closedAnalyticSubspace J` are definitionally those of
`TauCeti.closedAnalyticSubspace.zeroLocus J`, and its structure sheaf is
`TopCat.Presheaf.quotientIdealSheaf` (`TauCeti.closedAnalyticSubspace_carrier`,
`TauCeti.closedAnalyticSubspace_presheaf`). -/
@[expose] def closedAnalyticSubspace {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℂ E H}
    {X : Type} [TopologicalSpace X] [ChartedSpace H X]
    (J : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤))) : LocallyRingedSpace where
  carrier := TopCat.of (closedAnalyticSubspace.zeroLocus J)
  presheaf :=
    ((holomorphicStructureSheaf I X).presheaf.quotientIdealSheaf J
      (closedAnalyticSubspace.zeroLocus J)).presheaf
  IsSheaf := ((holomorphicStructureSheaf I X).presheaf.quotientIdealSheaf J
    (closedAnalyticSubspace.zeroLocus J)).property
  isLocalRing z := TopCat.Presheaf.quotientIdealSheaf.isLocalRing_stalk
    (closedAnalyticSubspace.stalkIdeal_ne_top_iff.mpr z.property)

section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℂ E H}
  {X : Type} [TopologicalSpace X] [ChartedSpace H X]
  (J : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤)))

/-- The points of the closed analytic subspace cut out by `J` are the points of `V(J)`. -/
theorem closedAnalyticSubspace_carrier :
    (closedAnalyticSubspace J).carrier = TopCat.of (closedAnalyticSubspace.zeroLocus J) :=
  (rfl)

/-- The structure sheaf of the closed analytic subspace cut out by `J` is `(𝒪_X ⧸ J 𝒪_X)|_{V(J)}`.
-/
theorem closedAnalyticSubspace_presheaf :
    (closedAnalyticSubspace J).presheaf =
      ((holomorphicStructureSheaf I X).presheaf.quotientIdealSheaf J
        (closedAnalyticSubspace.zeroLocus J)).presheaf :=
  (rfl)

end

namespace closedAnalyticSubspace

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℂ E H}
  {X : Type} [TopologicalSpace X] [ChartedSpace H X]

/-! ### Stalks -/

section

variable (J : Ideal ((holomorphicStructureSheaf I X).presheaf.obj (op ⊤)))

/-- **The stalks of a closed analytic subspace.** The stalk at a point `z` of `V(J)` of the closed
analytic subspace cut out by `J` is the quotient `𝒪_{X,z} ⧸ J_z`. -/
def stalkEquiv (z : zeroLocus J) :
    (closedAnalyticSubspace J).presheaf.stalk z ≃+*
      (holomorphicStructureSheaf I X).presheaf.stalk z.val ⧸
        (holomorphicStructureSheaf I X).presheaf.stalkIdeal J z.val :=
  TopCat.Presheaf.quotientIdealSheaf.stalkEquiv _ J (zeroLocus J) z

variable {J} in
/-- The stalk isomorphism sends the germ of a section to its class at the base point. -/
@[simp]
theorem stalkEquiv_germ {z : zeroLocus J} {W : Opens (TopCat.of (zeroLocus J))} (hz : z ∈ W)
    (f : (closedAnalyticSubspace J).presheaf.obj (op W)) :
    stalkEquiv J z ((closedAnalyticSubspace J).presheaf.germ W z hz f) =
      (TopCat.Presheaf.quotientIdealSheaf.sectionsEquiv _ J (zeroLocus J) W f).val ⟨z, hz⟩ :=
  TopCat.Presheaf.quotientIdealSheaf.stalkEquiv_germ hz f

end

/-! ### Nilpotents survive -/

/-- If `f` vanishes at `x` but has a nonzero germ there, the germ of `f` does not lie in the ideal
generated by the germ of `f ^ 2`. -/
private theorem germ_notMem_stalkIdeal_span_sq
    {f : (holomorphicStructureSheaf I X).presheaf.obj (op ⊤)} {x : X} (hfx : f ⟨x, trivial⟩ = 0)
    (hf : (holomorphicStructureSheaf I X).presheaf.germ ⊤ x (Opens.mem_top x) f ≠ 0) :
    (holomorphicStructureSheaf I X).presheaf.germ ⊤ x (Opens.mem_top x) f ∉
      (holomorphicStructureSheaf I X).presheaf.stalkIdeal (Ideal.span {f ^ 2}) x := by
  rw [TopCat.Presheaf.stalkIdeal_span, Set.image_singleton, map_pow,
    Ideal.mem_span_singleton']
  rintro ⟨b, hb⟩
  set t := (holomorphicStructureSheaf I X).presheaf.germ ⊤ x (Opens.mem_top x) f
  -- From `t = b t²` we get `t (1 - b t) = 0`, and `1 - b t` is a unit because `t(x) = 0`.
  have hunit : IsUnit (1 - b * t) := by
    rw [holomorphicStructureSheaf.isUnit_stalk_iff, map_sub, map_one, map_mul,
      holomorphicStructureSheaf.eval_germ, hfx, mul_zero, sub_zero]
    exact one_ne_zero
  refine hf ((IsUnit.mul_left_eq_zero hunit).mp ?_)
  linear_combination -hb

/-- **Nilpotents survive.** If `f` has a nonzero germ at a point `z` of the zero locus of `f ^ 2`,
then the stalk of the closed analytic subspace cut out by `f ^ 2` at `z` is not reduced: the class
of the germ of `f` is a nonzero nilpotent. -/
theorem not_isReduced_stalk_span_sq {f : (holomorphicStructureSheaf I X).presheaf.obj (op ⊤)}
    (z : zeroLocus (Ideal.span {f ^ 2}))
    (hf : (holomorphicStructureSheaf I X).presheaf.germ ⊤ z.val (Opens.mem_top _) f ≠ 0) :
    ¬ IsReduced ((closedAnalyticSubspace (Ideal.span {f ^ 2})).presheaf.stalk z) := by
  intro hred
  have hfz : f ⟨z.val, trivial⟩ = 0 := by
    have hz := z.property (f ^ 2) (Ideal.subset_span rfl)
    rw [holomorphicStructureSheaf.pow_apply] at hz
    exact pow_eq_zero_iff two_ne_zero |>.mp hz
  have hnil : IsNilpotent (Ideal.Quotient.mk
      ((holomorphicStructureSheaf I X).presheaf.stalkIdeal (Ideal.span {f ^ 2}) z.val)
      ((holomorphicStructureSheaf I X).presheaf.germ ⊤ z.val (Opens.mem_top _) f)) :=
    ⟨2, by
      rw [← map_pow, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
      exact TopCat.Presheaf.germ_mem_stalkIdeal (F := (holomorphicStructureSheaf I X).presheaf)
        (Ideal.subset_span rfl) z.val⟩
  let e := stalkEquiv (Ideal.span {f ^ 2}) z
  refine germ_notMem_stalkIdeal_span_sq hfz hf (Ideal.Quotient.eq_zero_iff_mem.mp ?_)
  exact e.symm.injective (((hnil.map e.symm).eq_zero).trans (map_zero _).symm)

/-! ### The double point -/

variable {f : (holomorphicStructureSheaf 𝓘(ℂ) ℂ).presheaf.obj (op ⊤)}

/-- The coordinate `z` on `ℂ` has a nonzero germ at `0`: it is not zero near `0`. -/
private theorem germ_ne_zero_of_apply_eq (hf : ∀ x : ℂ, f ⟨x, trivial⟩ = x) :
    (holomorphicStructureSheaf 𝓘(ℂ) ℂ).presheaf.germ ⊤ (0 : ℂ) (Opens.mem_top _) f ≠ 0 := by
  rw [Ne, holomorphicStructureSheaf.eq_zero_iff_of_toFilterGerm_eq
    (holomorphicStructureSheaf.toFilterGerm_germ le_rfl (Opens.mem_top _) f id fun y ↦ hf y)]
  intro h
  obtain ⟨y, hy, hy0⟩ :=
    ((h.filter_mono nhdsWithin_le_nhds).and (self_mem_nhdsWithin (s := {0}ᶜ))).exists
  exact hy0 hy

/-- **The double point is one point.** For the coordinate `f = z` on `ℂ`, the ideal `(z²)` cuts out
the single point `0`. -/
theorem zeroLocus_span_sq_of_apply_eq (hf : ∀ x : ℂ, f ⟨x, trivial⟩ = x) :
    zeroLocus (Ideal.span {f ^ 2}) = {0} := by
  rw [zeroLocus_span_singleton]
  ext x
  simp [hf]

/-- **The double point is not reduced.** For the coordinate `f = z` on `ℂ`, the closed analytic
subspace cut out by `(z²)` has a nonreduced stalk `ℂ{z} ⧸ (z²)` at its only point `0`: the class
of `z` is a nonzero nilpotent. -/
theorem not_isReduced_stalk_span_sq_of_apply_eq (hf : ∀ x : ℂ, f ⟨x, trivial⟩ = x) :
    ¬ IsReduced ((closedAnalyticSubspace (Ideal.span {f ^ 2})).presheaf.stalk
      ⟨0, (zeroLocus_span_sq_of_apply_eq hf).ge (Set.mem_singleton 0)⟩) :=
  not_isReduced_stalk_span_sq _ (germ_ne_zero_of_apply_eq hf)

end TauCeti.closedAnalyticSubspace
