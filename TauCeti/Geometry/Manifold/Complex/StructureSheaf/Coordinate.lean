module

public import TauCeti.Geometry.Manifold.Complex.StructureSheaf.Basic
import Mathlib.Algebra.Category.Ring.FilteredColimits
import Mathlib.Analysis.Analytic.IsolatedZeros
import Mathlib.RingTheory.Ideal.Span

/-!
# A local coordinate generates the ideal of vanishing holomorphic germs

On a complex curve, a chart centered at a point gives a holomorphic germ vanishing at that
point. Every holomorphic germ vanishing there is divisible by this coordinate germ. Thus
the kernel of stalk evaluation is the principal ideal generated by any centered chart.
This is the local defining equation for the ideal sheaf of a point, and the local algebra
used in twisting a divisor sheaf by a point.

The division is holomorphic even at the center: Mathlib's `dslope` extends the difference
quotient analytically there. The statements apply to charts of the maximal differentiable
atlas and need neither compactness nor connectedness of the curve.

## References

* Otto Forster, *Lectures on Riemann Surfaces*, §§1, 6 and 16.
-/

public noncomputable section

open CategoryTheory Filter IsManifold Opposite Set TopologicalSpace Topology
open scoped ContDiff Manifold
open TauCeti TauCeti.holomorphicStructureSheaf

namespace OpenPartialHomeomorph

variable {X : Type} [TopologicalSpace X] [ChartedSpace ℂ X] [IsManifold 𝓘(ℂ) 1 X]
  (e : OpenPartialHomeomorph X ℂ) (he : e ∈ maximalAtlas 𝓘(ℂ) 1 X) (x : X)

/-- The chart coordinate translated by `z`, as a holomorphic section on the chart source. -/
def holomorphicCoordinateSection (z : ℂ) :
    (holomorphicStructureSheaf 𝓘(ℂ) X).obj.obj (op ⟨e.source, e.open_source⟩) :=
  ofMDifferentiable (fun y => e y - z) fun y =>
    ((mdifferentiableAt_of_mem_maximalAtlas he y.2).comp y
      (contMDiff_subtype_val (n := 1).mdifferentiable one_ne_zero y)).sub mdifferentiableAt_const

/-- The translated coordinate section evaluates at `y` to `e y - z`. -/
-- Index on evaluation rather than the unexposed section carrier and its dependent open set.
@[simp]
theorem holomorphicCoordinateSection_apply (z : ℂ)
    (y : (⟨e.source, e.open_source⟩ : Opens X)) :
    toFun 𝓘(ℂ) X (no_index (op ⟨e.source, e.open_source⟩))
      (no_index (holomorphicCoordinateSection e he z)) y = e y - z := (by
  rw [holomorphicCoordinateSection]
  exact ofMDifferentiable_apply (U := ⟨e.source, e.open_source⟩) _ _ y)

/-- The germ at `x` of a centered chart coordinate. -/
def holomorphicCoordinateGerm (hx : x ∈ e.source) :
    (holomorphicStructureSheaf 𝓘(ℂ) X).presheaf.stalk x :=
  (holomorphicStructureSheaf 𝓘(ℂ) X).presheaf.germ ⟨e.source, e.open_source⟩ x hx
    (holomorphicCoordinateSection e he (e x))

/-- The centered coordinate germ is the germ of the translated coordinate section. -/
theorem holomorphicCoordinateGerm_def (hx : x ∈ e.source) :
    holomorphicCoordinateGerm e he x hx =
      (holomorphicStructureSheaf 𝓘(ℂ) X).presheaf.germ ⟨e.source, e.open_source⟩ x hx
        (holomorphicCoordinateSection e he (e x)) := (rfl)

/-- The germ of a centered chart coordinate evaluates to zero at its center. -/
@[simp]
theorem eval_holomorphicCoordinateGerm (hx : x ∈ e.source) :
    eval 𝓘(ℂ) X x (holomorphicCoordinateGerm e he x hx) = 0 := by
  rw [holomorphicCoordinateGerm, eval_germ]
  exact (holomorphicCoordinateSection_apply e he (e x) ⟨x, hx⟩).trans (sub_self _)

/-- A centered coordinate has a nonzero germ: a chart cannot be constant on a neighborhood
of its center. -/
@[simp]
theorem holomorphicCoordinateGerm_ne_zero (hx : x ∈ e.source) :
    holomorphicCoordinateGerm e he x hx ≠ 0 := by
  intro h
  rw [holomorphicCoordinateGerm, ← map_zero
    ((holomorphicStructureSheaf 𝓘(ℂ) X).presheaf.germ ⟨e.source, e.open_source⟩ x hx).hom] at h
  obtain ⟨V, hxV, i, j, hij⟩ :=
    (holomorphicStructureSheaf 𝓘(ℂ) X).presheaf.germ_eq x hx hx _ _ h
  have heq (y : V) : e y = e x := by
    have hy := congrArg (fun s => toFun 𝓘(ℂ) X (op V) s y) hij
    simp only [map_apply, holomorphicStructureSheaf.zero_apply] at hy
    rw [holomorphicCoordinateSection_apply e he (e x) (Opens.inclusion (leOfHom i) y)] at hy
    exact sub_eq_zero.mp hy
  have hconst : ∀ᶠ z in 𝓝 (e x), z = e x := by
    filter_upwards [(e.tendsto_symm hx).eventually (V.isOpen.mem_nhds hxV),
      e.open_target.mem_nhds (e.map_source hx)] with z hzV hz
    exact (e.right_inv hz).symm.trans (heq ⟨e.symm z, hzV⟩)
  have hne : ∀ᶠ z in 𝓝[≠] (e x), z ≠ e x := self_mem_nhdsWithin
  obtain ⟨z, hz, hez⟩ := (hne.and (hconst.filter_mono nhdsWithin_le_nhds)).exists
  exact hz hez

omit [IsManifold 𝓘(ℂ) 1 X] in
include he in
/-- A holomorphic section, extended by zero outside its domain and written in
a local chart, is analytic at every point of its domain in the chart source. -/
theorem analyticAt_holomorphicSection_extend_comp_symm (hx : x ∈ e.source)
    (U : Opens X) (hxU : x ∈ U)
    (s : (holomorphicStructureSheaf 𝓘(ℂ) X).obj.obj (op U)) :
    AnalyticAt ℂ ((Function.extend Subtype.val s (fun _ => 0)) ∘ e.symm) (e x) := by
  let F : X → ℂ := Function.extend Subtype.val s (fun _ => 0)
  have hF (y : U) : F y = s y := Subtype.val_injective.extend_apply _ _ y
  have hFa : ∀ᶠ y in 𝓝 x, MDifferentiableAt 𝓘(ℂ) 𝓘(ℂ) F y := by
    filter_upwards [U.isOpen.mem_nhds hxU] with y hy
    have hdiff : ContMDiffAt 𝓘(ℂ) 𝓘(ℂ) ω (fun z : U => F z) ⟨y, hy⟩ :=
      (contMDiff s).contMDiffAt.congr_of_eventuallyEq (.of_forall hF)
    exact (contMDiffAt_subtype_iff.mp hdiff).mdifferentiableAt (by simp)
  simpa only [mfld_simps, Function.comp_def] using
    analyticAt_chart_comp_comp_symm he (chart_mem_maximalAtlas (F x)) hx
      (mem_chart_source ℂ (F x)) hFa

/-- A holomorphic germ is divisible by a centered chart coordinate exactly when it vanishes
at the center. The quotient is holomorphic also at the coordinate's zero. -/
@[simp]
theorem holomorphicCoordinateGerm_dvd_iff_eval_eq_zero (hx : x ∈ e.source)
    (f : (holomorphicStructureSheaf 𝓘(ℂ) X).presheaf.stalk x) :
    holomorphicCoordinateGerm e he x hx ∣ f ↔ eval 𝓘(ℂ) X x f = 0 := by
  constructor
  · rintro ⟨q, rfl⟩
    simp only [map_mul, eval_holomorphicCoordinateGerm, zero_mul]
  intro hf
  classical
  -- Represent the germ by a section and write that section in the chosen chart.
  let S := (holomorphicStructureSheaf 𝓘(ℂ) X).presheaf
  obtain ⟨U, hxU, s, rfl⟩ := S.exists_germ_eq f
  dsimp only [S] at *
  have hs0 : s ⟨x, hxU⟩ = 0 := by
    simpa only [eval_germ] using hf
  let F : X → ℂ := Function.extend Subtype.val s (fun _ => 0)
  have hF (y : U) : F y = s y := Subtype.val_injective.extend_apply _ _ y
  let A : ℂ → ℂ := F ∘ e.symm
  have hA : AnalyticAt ℂ A (e x) :=
    analyticAt_holomorphicSection_extend_comp_symm e he x hx U hxU s
  obtain ⟨p, hp⟩ := hA
  -- The difference quotient extends analytically across the center.
  have hD : AnalyticAt ℂ (dslope A (e x)) (e x) :=
    ⟨p.fslope, hp.dslope_fslope⟩
  have hDnear : ∀ᶠ y in 𝓝 x, AnalyticAt ℂ (dslope A (e x)) (e y) :=
    (e.continuousAt hx).tendsto.eventually hD.eventually_analyticAt
  have hnear : ∀ᶠ y in 𝓝 x,
      y ∈ U ∧ y ∈ e.source ∧ AnalyticAt ℂ (dslope A (e x)) (e y) := by
    filter_upwards [U.isOpen.mem_nhds hxU, e.open_source.mem_nhds hx, hDnear]
      with y hyU hye hyD
    exact ⟨hyU, hye, hyD⟩
  obtain ⟨V, hV, hVopen, hxV⟩ := eventually_nhds_iff.mp hnear
  let W : Opens X := ⟨V, hVopen⟩
  have hWU : W ≤ U := fun y hy => (hV y hy).1
  have hWe : W ≤ (⟨e.source, e.open_source⟩ : Opens X) := fun y hy => (hV y hy).2.1
  let q := ofMDifferentiable (fun y : W => dslope A (e x) (e y)) (by
    intro y
    exact ((hV y y.2).2.2.differentiableAt.mdifferentiableAt).comp y
      ((mdifferentiableAt_of_mem_maximalAtlas he (hWe y.2)).comp y
        (contMDiff_subtype_val (n := 1).mdifferentiable one_ne_zero y)))
  -- The division identity on this neighborhood passes through the ring germ map.
  have hmul : S.map (homOfLE hWe).op (holomorphicCoordinateSection e he (e x)) * q =
      S.map (homOfLE hWU).op s := by
    dsimp only [S]
    apply holomorphicStructureSheaf.ext
    intro y
    simp only [holomorphicStructureSheaf.mul_apply, map_apply]
    rw [holomorphicCoordinateSection_apply e he (e x) (Opens.inclusion hWe y)]
    have hq : q y = dslope A (e x) (e y) :=
      ofMDifferentiable_apply (U := W) _ _ y
    rw [hq]
    have hAx : A (e x) = 0 := by
      dsimp only [A, Function.comp_def]
      rw [e.left_inv hx, hF ⟨x, hxU⟩, hs0]
    have hAy : A (e y) = s (Opens.inclusion hWU y) := by
      dsimp only [A, Function.comp_def]
      rw [e.left_inv (hWe y.2)]
      exact hF (Opens.inclusion hWU y)
    simpa only [smul_eq_mul, hAx, hAy, sub_zero] using sub_smul_dslope A (e x) (e y)
  refine ⟨S.germ W x hxV q, ?_⟩
  rw [holomorphicCoordinateGerm, ← S.germ_res_apply (homOfLE hWe) x hxV,
    ← map_mul, hmul, S.germ_res_apply]

/-- The ideal of holomorphic germs vanishing at `x` is generated by any centered local chart
coordinate. This identifies the local ideal of a point without a choice of preferred chart. -/
theorem ker_eval_eq_span_holomorphicCoordinateGerm (hx : x ∈ e.source) :
    RingHom.ker (eval 𝓘(ℂ) X x) = Ideal.span {holomorphicCoordinateGerm e he x hx} := by
  apply le_antisymm
  · intro f hf
    exact Ideal.mem_span_singleton.mpr
      ((holomorphicCoordinateGerm_dvd_iff_eval_eq_zero e he x hx f).mpr (RingHom.mem_ker.mp hf))
  · exact (Ideal.span_singleton_le_iff_mem _).mpr
      (RingHom.mem_ker.mpr (eval_holomorphicCoordinateGerm e he x hx))

end OpenPartialHomeomorph
