module

public import TauCeti.Geometry.Manifold.Complex.StructureSheaf.MaximalIdeal
public import TauCeti.Geometry.Manifold.Complex.StructureSheaf.Domain
public import Mathlib.RingTheory.Ideal.Quotient.Operations
import TauCeti.Analysis.Analytic.ConstantOrder.Basic
import TauCeti.Geometry.Manifold.ContMDiff.Analytic

/-!
# Restriction of holomorphic germs to a coordinate hyperplane

Restriction from `E × ℂ` to the hyperplane `w = b` is a surjective homomorphism of
holomorphic stalks. Its kernel is the principal ideal generated by the coordinate germ
`w - b`. Consequently the quotient by this coordinate is canonically the holomorphic
stalk on `E`. The inverse extends a germ constantly in the last variable.

This identifies the local ring of a coordinate hypersurface with the ambient local ring
modulo its defining equation. The defining coordinate germ is always nonzero. In finite
dimensions it is prime, hence a non-zero-divisor with an integral-domain quotient.
These are the basic coordinate reductions used in the local algebra of holomorphic functions.

All constructions use the existing holomorphic stalk, its function-germ comparison and
`stalkPrecomp`. The kernel computation uses the analytic Hadamard lemma in a distinguished
variable, `AnalyticAt.exists_eventuallyEq_sub_smul`.

## References

* R. C. Gunning and H. Rossi, *Analytic Functions of Several Complex Variables*, Chapter II.
* J.-P. Demailly, *Complex Analytic and Differential Geometry*, Chapter II.
-/

public noncomputable section

open CategoryTheory Filter IsManifold Opposite Set TopologicalSpace Topology
open scoped ContDiff Manifold

namespace TauCeti.holomorphicStructureSheaf

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℂ E] (a : E) (b : ℂ)

/-- Restriction of holomorphic germs at `(a,b)` to the coordinate hyperplane `w = b`. -/
def restrictHyperplane :
    (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (a, b) →+*
      (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk a :=
  stalkPrecomp 𝓘(ℂ, E) E (fun z ↦ (z, b)) ((contDiff_id.prodMk contDiff_const).contMDiff) a

/-- Restriction to a hyperplane composes any function representative with its inclusion. -/
theorem toFilterGerm_restrictHyperplane
    (s : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (a, b)) :
    toFilterGerm 𝓘(ℂ, E) E a (𝓝 a) le_rfl (restrictHyperplane a b s) =
      (toFilterGerm 𝓘(ℂ, E × ℂ) (E × ℂ) (a, b) (𝓝 (a, b)) le_rfl s).compTendsto
        (fun z ↦ (z, b)) (continuous_id.prodMk continuous_const).continuousAt.tendsto := by
  rw [restrictHyperplane, toFilterGerm_stalkPrecomp]

/-- Extending constantly in the last variable is a right inverse to hyperplane restriction. -/
@[simp]
theorem restrictHyperplane_stalkPrecomp_fst
    (s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk a) :
    restrictHyperplane a b
      (stalkPrecomp 𝓘(ℂ, E × ℂ) (E × ℂ) Prod.fst contDiff_fst.contMDiff (a, b) s) = s := by
  rw [restrictHyperplane, ← stalkPrecomp_comp]
  -- The composite of the inclusion with the projection is literally the identity.
  exact RingHom.congr_fun (stalkPrecomp_id 𝓘(ℂ, E) E a) s

/-- Every holomorphic germ on the hyperplane extends constantly in its normal coordinate. -/
theorem restrictHyperplane_surjective : Function.Surjective (restrictHyperplane a b) :=
  fun s ↦ ⟨stalkPrecomp 𝓘(ℂ, E × ℂ) (E × ℂ) Prod.fst contDiff_fst.contMDiff (a, b) s,
    restrictHyperplane_stalkPrecomp_fst a b s⟩

/-- The centered last-coordinate germ at `(a,b)`, using the linear coordinate of the identity
chart. Its zero set is the coordinate hyperplane `w = b`. -/
abbrev hyperplaneCoordinateGerm :=
  (OpenPartialHomeomorph.refl (E × ℂ)).holomorphicLinearCoordinateGerm
    (by simpa using chart_mem_maximalAtlas (I := 𝓘(ℂ, E × ℂ)) (n := ω) (a, b))
    (a, b) (ContinuousLinearMap.snd ℂ E ℂ) (by trivial)

/-- The defining coordinate vanishes on the hyperplane. -/
@[simp]
theorem restrictHyperplane_hyperplaneCoordinateGerm :
    restrictHyperplane a b (hyperplaneCoordinateGerm a b) = 0 := by
  apply toFilterGerm_nhds_injective a
  rw [toFilterGerm_restrictHyperplane,
    OpenPartialHomeomorph.toFilterGerm_holomorphicLinearCoordinateGerm,
    Germ.coe_compTendsto, map_zero, ← Germ.coe_zero, Germ.coe_eq]
  exact .of_forall fun _ ↦ sub_self b

/-- A centered normal coordinate has nonzero holomorphic germ, also when `E` has dimension zero. -/
@[simp]
theorem hyperplaneCoordinateGerm_ne_zero : hyperplaneCoordinateGerm a b ≠ 0 := by
  intro h
  have hev : (fun p : E × ℂ ↦ p.2 - b) =ᶠ[𝓝 (a, b)] 0 := by
    apply Germ.coe_eq.1
    have h' := congrArg (toFilterGerm 𝓘(ℂ, E × ℂ) (E × ℂ) (a, b) (𝓝 (a, b)) le_rfl) h
    simpa [hyperplaneCoordinateGerm, ← Germ.coe_zero] using h'
  have hi : Tendsto (fun w : ℂ ↦ (a, w)) (𝓝 b) (𝓝 (a, b)) :=
    (continuous_const.prodMk continuous_id).continuousAt.tendsto
  have hconst : ∀ᶠ w in 𝓝 b, w = b := (hi.eventually hev).mono fun w hw ↦ sub_eq_zero.1 hw
  have hne : ∀ᶠ w in 𝓝[≠] b, w ≠ b := self_mem_nhdsWithin
  obtain ⟨w, hw, hwb⟩ := (hne.and (hconst.filter_mono nhdsWithin_le_nhds)).exists
  exact hw hwb

/-- A holomorphic germ vanishes on a coordinate hyperplane exactly when its defining
coordinate divides that germ. The quotient is holomorphic across the hyperplane. -/
theorem restrictHyperplane_eq_zero_iff
    (s : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (a, b)) :
    restrictHyperplane a b s = 0 ↔ hyperplaneCoordinateGerm a b ∣ s := by
  constructor
  · intro hs
    obtain ⟨f, hf, hfs⟩ := exists_toFilterGerm_eq (a, b) s
    have hfa : AnalyticAt ℂ f (a, b) :=
      contMDiffAt_modelSpace_omega_iff_analyticAt.1 hf.self_of_nhds
    have h0 : ∀ᶠ z in 𝓝 a, f (z, b) = 0 := by
      have heq := congrArg (toFilterGerm 𝓘(ℂ, E) E a (𝓝 a) le_rfl) hs
      rw [toFilterGerm_restrictHyperplane, hfs, Germ.coe_compTendsto, map_zero,
        ← Germ.coe_zero, Germ.coe_eq] at heq
      exact heq
    obtain ⟨g, hg, hfg⟩ := hfa.exists_eventuallyEq_sub_smul h0
    obtain ⟨q, hq⟩ := exists_toFilterGerm_eq_of_eventually_contMDiffAt
      (hg.eventually_analyticAt.mono fun p hp ↦ hp.contDiffAt.contMDiffAt)
    refine ⟨q, toFilterGerm_nhds_injective (a, b) ?_⟩
    rw [map_mul, OpenPartialHomeomorph.toFilterGerm_holomorphicLinearCoordinateGerm,
      hq, hfs, ← Germ.coe_mul, Germ.coe_eq]
    exact hfg
  · rintro ⟨q, rfl⟩
    simp

/-- The ideal of holomorphic germs vanishing on `w = b` is generated by `w - b`. -/
theorem ker_restrictHyperplane :
    RingHom.ker (restrictHyperplane a b) = Ideal.span {hyperplaneCoordinateGerm a b} := by
  ext s
  rw [RingHom.mem_ker, restrictHyperplane_eq_zero_iff, Ideal.mem_span_singleton]

/-- The holomorphic local ring of a coordinate hyperplane is the ambient holomorphic local
ring modulo its defining coordinate. -/
def hyperplaneQuotientEquiv :
    ((holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (a, b) ⧸
      Ideal.span {hyperplaneCoordinateGerm a b}) ≃+*
      (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk a :=
  (Ideal.quotEquivOfEq (ker_restrictHyperplane a b).symm).trans
    ((restrictHyperplane a b).quotientKerEquivOfSurjective (restrictHyperplane_surjective a b))

/-- The quotient equivalence sends the class of a germ to its hyperplane restriction. -/
@[simp]
theorem hyperplaneQuotientEquiv_mk
    (s : (holomorphicStructureSheaf 𝓘(ℂ, E × ℂ) (E × ℂ)).presheaf.stalk (a, b)) :
    hyperplaneQuotientEquiv a b (Ideal.Quotient.mk _ s) = restrictHyperplane a b s := by
  simp [hyperplaneQuotientEquiv]

/-- The inverse quotient equivalence extends a germ constantly in the normal direction and
takes its class modulo the normal coordinate. -/
theorem hyperplaneQuotientEquiv_symm_apply
    (s : (holomorphicStructureSheaf 𝓘(ℂ, E) E).presheaf.stalk a) :
    (hyperplaneQuotientEquiv a b).symm s = Ideal.Quotient.mk _
      (stalkPrecomp 𝓘(ℂ, E × ℂ) (E × ℂ) Prod.fst contDiff_fst.contMDiff (a, b) s) := by
  apply (hyperplaneQuotientEquiv a b).injective
  rw [RingEquiv.apply_symm_apply, hyperplaneQuotientEquiv_mk]
  exact (restrictHyperplane_stalkPrecomp_fst a b s).symm

variable [FiniteDimensional ℂ E]

/-- The defining coordinate of a hyperplane is prime in the holomorphic local ring. -/
theorem prime_hyperplaneCoordinateGerm : Prime (hyperplaneCoordinateGerm a b) := by
  apply (Ideal.span_singleton_prime (hyperplaneCoordinateGerm_ne_zero a b)).1
  rw [← ker_restrictHyperplane]
  exact RingHom.ker_isPrime (restrictHyperplane a b)

end TauCeti.holomorphicStructureSheaf
