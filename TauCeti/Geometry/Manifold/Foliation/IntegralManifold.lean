/-!
# Integral carriers of foliation leaves

For a bijective integral immersion, the image of the connected component over a point is exactly
the existing foliation leaf through that point. The source may carry a finer topology than the
ambient manifold, as occurs for the topology generated by all integral plaques. No countability
assumption on the source is needed.

## Main results

* `TauCeti.Foliation.connectedComponent_eq_of_sameLeaf`: tangent-curve chains lift into a single
  connected component.
* `TauCeti.Foliation.leaf_eq_image_connectedComponent`: the existing leaf equals the image of
  that component.
* `TauCeti.Foliation.leaf_eq_image_connectedComponent_of_coinduced`: apply the comparison to
  the intrinsic atlas generated by any injective integral cover.

## References

* J. M. Lee, *Introduction to Smooth Manifolds*, second edition, Springer GTM 218 (2013),
  Chapter 19, Theorem 19.21 and Lemma 19.22, pp.502–505, for integral leaves and their intrinsic
  topology.
-/

public noncomputable section

open Set Function Filter Topology
open scoped Manifold ContDiff

namespace TauCeti.Foliation

open TauCeti.Manifold

section Carrier

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {N : Type*} [TopologicalSpace N] [ChartedSpace H' N]
  {m : ℕ∞} [IsManifold I ((m : ℕ∞ω) + 1) M] [IsManifold J m N]
  [BoundarylessManifold I M] [BoundarylessManifold J N] {f : N → M} {k : ℕ}

/-- Points in the same foliation leaf lift to the same connected component of a bijective
integral immersion, even when its source has a finer topology than the ambient manifold. -/
theorem connectedComponent_eq_of_sameLeaf (L : Foliation I m M k)
    (hf : IsIntegralManifold J m L.distribution f) (hbij : Bijective f)
    {x y : M} (hxy : L.SameLeaf x y) :
    connectedComponent ((Equiv.ofBijective f hbij).symm x) =
      connectedComponent ((Equiv.ofBijective f hbij).symm y) := by
  let _ : Nonempty N := hf.nonempty
  have hm : 1 ≤ m := by exact_mod_cast L.one_le
  have hr : Equivalence (fun x y : M ↦
      connectedComponent ((Equiv.ofBijective f hbij).symm x) =
        connectedComponent ((Equiv.ofBijective f hbij).symm y)) :=
    ⟨fun _ ↦ rfl, fun h ↦ h.symm, fun h₁ h₂ ↦ h₁.trans h₂⟩
  apply (L.sameLeaf_le hr ?_) x y hxy
  intro u v huv
  obtain ⟨γ, hγ, htan, h₀, h₁⟩ := Foliation.joinedByTangentCurve_iff.mp huv
  let g : ℝ → N := (Equiv.ofBijective f hbij).symm ∘ γ
  have hcomp : f ∘ g = γ := funext fun t ↦ (Equiv.ofBijective f hbij).apply_symm_apply (γ t)
  have hc : ContinuousOn g (Icc 0 1) :=
    hf.continuousOn_factor_of_tangent_curve hm hbij.injective le_rfl
      L.isInvolutiveDistribution L.isContMDiffDistribution zero_lt_one
      (hγ.mdifferentiableOn one_ne_zero) htan hcomp
  have hmem : g 1 ∈ connectedComponent (g 0) :=
    ((isPreconnected_Icc.image g hc).subset_connectedComponent
      (mem_image_of_mem g (by simp : (0 : ℝ) ∈ Icc 0 1)))
      (mem_image_of_mem g (by simp : (1 : ℝ) ∈ Icc 0 1))
  simpa only [g, comp_apply, h₀, h₁] using connectedComponent_eq hmem

/-- In a boundaryless finite-dimensional real ambient manifold, a foliation leaf is the image
of a connected component of a bijective integral immersion from a boundaryless manifold.
The integral carrier keeps its own topology and need not be second countable. -/
theorem leaf_eq_image_connectedComponent (L : Foliation I m M k)
    (hf : IsIntegralManifold J m L.distribution f) (hbij : Bijective f) (x : M) :
    L.leaf x = f '' connectedComponent ((Equiv.ofBijective f hbij).symm x) := by
  let _ : Nonempty N := hf.nonempty
  let _ : LocallyPathConnectedSpace N := J.locallyPathConnectedSpace_of_chartedSpace N
  have hm : (1 : ℕ∞ω) ≤ m := L.one_le
  let _ : IsManifold J 1 N := .of_le hm
  let C : TopologicalSpace.Opens N :=
    ⟨connectedComponent ((Equiv.ofBijective f hbij).symm x), isOpen_connectedComponent⟩
  let _ : Nonempty C := ⟨⟨(Equiv.ofBijective f hbij).symm x, mem_connectedComponent⟩⟩
  let _ : ConnectedSpace C := isConnected_iff_connectedSpace.mp isConnected_connectedComponent
  have hi : IsLocalDiffeomorph J J m (Subtype.val : C → N) :=
    TauCeti.isLocalDiffeomorph_subtype_val
  have hparam := hf.comp_isLocalDiffeomorph (ne_of_gt (zero_lt_one.trans_le hm)) hi
  have hhor : IsHorizontalMap J L.distribution (f ∘ (Subtype.val : C → N)) :=
    isHorizontalMap_iff_range_mfderiv_le.mpr fun z ↦ (hparam.range_mfderiv z).le
  have hfd : ContMDiff J I 1 (f ∘ (Subtype.val : C → N)) :=
    ((hf.contMDiff).of_le hm).comp (hi.contMDiff.of_le hm)
  let x0 : C := ⟨(Equiv.ofBijective f hbij).symm x, mem_connectedComponent⟩
  have hx0 : (f ∘ (Subtype.val : C → N)) x0 = x := (Equiv.ofBijective f hbij).apply_symm_apply x
  have hrange := L.range_subset_leaf_of_isHorizontalMap hhor hfd x0
  rw [hx0] at hrange
  ext y
  constructor
  · intro hy
    have heq := connectedComponent_eq_of_sameLeaf L hf hbij (Foliation.mem_leaf.mp hy)
    refine ⟨(Equiv.ofBijective f hbij).symm y, ?_, (Equiv.ofBijective f hbij).apply_symm_apply y⟩
    rw [heq]
    exact mem_connectedComponent
  · rintro ⟨z, hz, rfl⟩
    exact hrange ⟨⟨z, hz⟩, rfl⟩

end Carrier

section Coinduced

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [tM : TopologicalSpace M] [ChartedSpace H M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {m : ℕ∞} [IsManifold I ((m : ℕ∞ω) + 1) M] [BoundarylessManifold I M] {k : ℕ}
  {ι : Type*} {U : ι → Type*} [∀ i, TopologicalSpace (U i)] [∀ i, ChartedSpace H' (U i)]
  [∀ i, IsManifold J m (U i)] [∀ i, BoundarylessManifold J (U i)] {f : ∀ i, U i → M}

/-- The components of the intrinsic topology generated by an injective integral cover have
exactly the existing foliation leaves as their ambient images. The pieces may use any common
model with corners, provided each piece is boundaryless, and need not form a countable family. -/
theorem leaf_eq_image_connectedComponent_of_coinduced (L : Foliation I m M k)
    (hf : ∀ i, IsIntegralManifold J m L.distribution (f i))
    (hinj : ∀ i, Injective (f i)) (hcover : ∀ x, ∃ i y, f i y = x) (x : M) :
    L.leaf x = WithTopology.ofTopology
        (t := ⨆ i, TopologicalSpace.coinduced (f i) inferInstance) ''
      connectedComponent
        (WithTopology.toTopology (⨆ i, TopologicalSpace.coinduced (f i) inferInstance) x) := by
  have hm : 1 ≤ m := by exact_mod_cast L.one_le
  let _ : Nonempty M := ⟨x⟩
  let t := ⨆ i, TopologicalSpace.coinduced (f i) inferInstance
  let _ : TopologicalSpace M := tM
  let _ : ChartedSpace H' (WithTopology M t) :=
    chartedSpaceOfIntegralManifolds hf hm le_rfl L.isInvolutiveDistribution
      L.isContMDiffDistribution hinj hcover
  let _ : IsManifold J m (WithTopology M t) :=
    isManifold_chartedSpaceOfIntegralManifolds hf hm le_rfl L.isInvolutiveDistribution
      L.isContMDiffDistribution hinj hcover
  let _ : BoundarylessManifold J (WithTopology M t) := ⟨fun z ↦ by
    obtain ⟨i, y, hy⟩ := hcover (WithTopology.ofTopology z)
    have hez : (WithTopology.toTopology t ∘ f i) y = z := by
      simpa only [comp_apply, WithTopology.toTopology_ofTopology] using
        congrArg (WithTopology.toTopology t) hy
    rw [← hez]
    exact ((isLocalDiffeomorph_chartedSpaceOfIntegralManifolds hf hm le_rfl
      L.isInvolutiveDistribution L.isContMDiffDistribution hinj hcover i y).isInteriorPoint_iff
      (by exact_mod_cast (ne_of_gt (zero_lt_one.trans_le hm)))).mp
      BoundarylessManifold.isInteriorPoint⟩
  have hback := isIntegralManifold_ofTopology hf hm le_rfl L.isInvolutiveDistribution
    L.isContMDiffDistribution hinj hcover
  let e := Equiv.ofBijective (WithTopology.ofTopology (X := M) (t := t))
    (WithTopology.ofTopology_bijective t)
  have he : e.symm x = WithTopology.toTopology t x :=
    (WithTopology.ofTopology_injective t) (e.apply_symm_apply x)
  have hleaf := L.leaf_eq_image_connectedComponent hback
    (WithTopology.ofTopology_bijective t) x
  -- Identify the inverse of the underlying bijection with the canonical topology transfer.
  change L.leaf x = WithTopology.ofTopology '' connectedComponent (e.symm x) at hleaf
  simpa only [he] using hleaf

end Coinduced

end TauCeti.Foliation
