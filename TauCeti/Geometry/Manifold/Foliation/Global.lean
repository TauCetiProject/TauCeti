/-!
# Maximal intrinsic integral leaves

For a finite-dimensional real foliation with boundaryless ambient model, each existing leaf
has a connected intrinsic manifold structure. Its parametrizing immersion is injective and
has exactly that leaf as its image. The carrier uses the connected component of the topology
generated by integral plaques, which can be finer than the ambient subspace topology.

Every connected integral immersion through the base point factors uniquely through this manifold
by a `C^m` map. The source of the factorization may use an arbitrary model with corners whose
carrier is boundaryless.

## Main results

* `TauCeti.Foliation.leafThrough`: a packaged intrinsic integral manifold over the existing leaf.
* `TauCeti.Foliation.connectedSpace_leafThrough` and `leafThrough_map_injective`: its carrier is
  connected and its parametrization is injective.
* `TauCeti.Foliation.range_leafThrough_map`: its image is the existing foliation leaf.
* `TauCeti.Foliation.existsUnique_contMDiff_factor_leafThrough`: `C^m` maximality.
* `TauCeti.Foliation.leafThroughBasePoint`, `map_leafThroughBasePoint`, and
  `leafThrough_map_eq_self_iff`: the intrinsic base point and its unique ambient image.
* `TauCeti.Foliation.liftToLeafThrough`, `contMDiff_liftToLeafThrough`, `map_liftToLeafThrough`,
  `liftToLeafThrough_unique`, and `liftToLeafThrough_eq_leafThroughBasePoint`: the canonical
  `C^m` factor, its characteristic properties, and its value over the base point.
* `TauCeti.Foliation.secondCountableTopology_of_isLindelof_range`: a connected injective integral
  carrier with Lindelof image is second countable.
* `TauCeti.Foliation.secondCountableTopology_leafThrough`: second countability of the canonical
  leaf under ambient second countability.

## References

* J. M. Lee, *Introduction to Smooth Manifolds*, second edition, Springer GTM 218 (2013),
  Theorem 19.21 and Lemma 19.22, pp.502–505, for global integral leaves and their intrinsic atlas.
-/

public noncomputable section

open Set Function TopologicalSpace Topology
open scoped Manifold ContDiff Topology

universe uE uH uM uN

namespace TauCeti.Foliation

variable {E : Type uE} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type uH} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {M : Type uM} [tM : TopologicalSpace M] [ChartedSpace H M]
  {m : ℕ∞} [IsManifold I ((m : ℕ∞ω) + 1) M] {k : ℕ} (L : Foliation I m M k)

private theorem exists_integral_cover :
    ∃ (U : M → Opens (EuclideanSpace ℝ (Fin k))) (f : ∀ x, U x → M),
      (∀ x, IsIntegralManifold (𝓡 k) m L.distribution (f x)) ∧
        (∀ x, Injective (f x)) ∧ (∀ y, ∃ x z, f x z = y) := by
  classical
  have hm : 1 ≤ m := by exact_mod_cast L.one_le
  let _ : IsManifold I 1 M := .of_le (show (1 : ℕ∞ω) ≤ (m : ℕ∞ω) + 1 from le_add_self)
  have hlocal (x : M) := L.isInvolutiveDistribution.exists_isIntegralManifold hm le_rfl
    L.isContMDiffDistribution x
  choose W _ U u f hW _ _ hfu _ hemb _ hf using hlocal
  let A (x : M) : W x ≃L[ℝ] EuclideanSpace ℝ (Fin k) :=
    ContinuousLinearEquiv.ofFinrankEq (by simpa only [finrank_euclideanSpace_fin] using hW x)
  let V (x : M) : Opens (EuclideanSpace ℝ (Fin k)) :=
    ⟨(A x).symm ⁻¹' U x, (U x).isOpen.preimage (A x).symm.continuous⟩
  let es (x : M) : (V x) ≃ₘ^∞⟮𝓡 k, 𝓘(ℝ, W x)⟯ U x :=
    (A x).symm.toDiffeomorph.subtype (fun _ ↦ Iff.rfl)
  let e (x : M) : (V x) ≃ₘ^m⟮𝓡 k, 𝓘(ℝ, W x)⟯ U x :=
    { (es x).toEquiv with
      contMDiff_toFun := (es x).contMDiff.of_le (by simp)
      contMDiff_invFun := (es x).symm.contMDiff.of_le (by simp) }
  refine ⟨V, fun x ↦ f x ∘ e x, ?_, ?_, ?_⟩
  · intro x
    exact (hf x).comp_diffeomorph_of_image_range_eq
      (by exact_mod_cast (ne_of_gt (zero_lt_one.trans_le hm))) (A x).symm (by simp) (e x)
  · intro x
    exact (hemb x).injective.comp (e x).injective
  · intro x
    refine ⟨x, (e x).symm (u x), ?_⟩
    simpa only [comp_apply, Diffeomorph.apply_symm_apply] using hfu x

private def domains : M → Opens (EuclideanSpace ℝ (Fin k)) :=
  Classical.choose (exists_integral_cover L)

private def parametrizations : ∀ x, domains L x → M :=
  Classical.choose (Classical.choose_spec (exists_integral_cover L))

private theorem parametrizations_properties :
    (∀ x, IsIntegralManifold (𝓡 k) m L.distribution (parametrizations L x)) ∧
      (∀ x, Injective (parametrizations L x)) ∧
      (∀ y, ∃ x z, parametrizations L x z = y) :=
  Classical.choose_spec (Classical.choose_spec (exists_integral_cover L))

private abbrev intrinsicTopology : TopologicalSpace M :=
  ⨆ i, coinduced (parametrizations L i) inferInstance

private abbrev intrinsicCarrier := WithTopology M (intrinsicTopology L)

private instance intrinsicChartedSpace :
    ChartedSpace (EuclideanSpace ℝ (Fin k)) (intrinsicCarrier L) :=
  chartedSpaceOfIntegralManifolds (parametrizations_properties L).1
    (by exact_mod_cast L.one_le) le_rfl L.isInvolutiveDistribution
    L.isContMDiffDistribution (parametrizations_properties L).2.1
    (parametrizations_properties L).2.2

private instance intrinsicIsManifold : IsManifold (𝓡 k) m (intrinsicCarrier L) :=
  isManifold_chartedSpaceOfIntegralManifolds (parametrizations_properties L).1
    (by exact_mod_cast L.one_le) le_rfl L.isInvolutiveDistribution
    L.isContMDiffDistribution (parametrizations_properties L).2.1
    (parametrizations_properties L).2.2

private theorem integral_ofTopology [Nonempty M] :
    IsIntegralManifold (I := I) (𝓡 k) m L.distribution
    (WithTopology.ofTopology (t := intrinsicTopology L)) :=
  isIntegralManifold_ofTopology (parametrizations_properties L).1
    (by exact_mod_cast L.one_le) le_rfl L.isInvolutiveDistribution
    L.isContMDiffDistribution (parametrizations_properties L).2.1
    (parametrizations_properties L).2.2

private theorem isOpenEmbedding_toTopology
    {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ V H'}
    {N : Type*} [TopologicalSpace N] [ChartedSpace H' N] [IsManifold J m N]
    [BoundarylessManifold J N] {g : N → M}
    (hg : IsIntegralManifold J m L.distribution g) (hgi : Injective g) :
    IsOpenEmbedding (WithTopology.toTopology (intrinsicTopology L) ∘ g) := by
  let _ : Nonempty M := Nonempty.map g hg.nonempty
  have hm : 1 ≤ m := by exact_mod_cast L.one_le
  have hlocal : IsLocalDiffeomorph J (𝓡 k) m
      (WithTopology.toTopology (intrinsicTopology L) ∘ g) := fun z ↦
    hg.isLocalDiffeomorphAt_of_comp_eq (integral_ofTopology L) hm le_rfl
      L.isInvolutiveDistribution L.isContMDiffDistribution
      (WithTopology.ofTopology_injective (intrinsicTopology L))
      (fun z ↦ WithTopology.ofTopology_toTopology (intrinsicTopology L) (g z))
      BoundarylessManifold.isInteriorPoint BoundarylessManifold.isInteriorPoint
      BoundarylessManifold.isInteriorPoint
  exact isOpenEmbedding_iff_continuous_injective_isOpenMap.mpr
    ⟨hlocal.contMDiff.continuous,
      (WithTopology.toTopology_injective (intrinsicTopology L)).comp hgi,
      hlocal.isLocalHomeomorph.isOpenMap⟩

private def leafData (x : M) :
    {N : IntegralManifold.{uM, uM, uE, uH} (I := I) m L.distribution k //
      ConnectedSpace N.carrier ∧ Injective N.map ∧ range N.map = L.leaf x} := by
  let _ : Nonempty M := ⟨x⟩
  have hm : 1 ≤ m := by exact_mod_cast L.one_le
  have hp := parametrizations_properties L
  let _ : LocallyConnectedSpace (intrinsicCarrier L) :=
    ChartedSpace.locallyConnectedSpace (EuclideanSpace ℝ (Fin k)) (intrinsicCarrier L)
  let xp : intrinsicCarrier L := WithTopology.toTopology (intrinsicTopology L) x
  let C : Opens (intrinsicCarrier L) := ⟨connectedComponent xp, isOpen_connectedComponent⟩
  have hback := integral_ofTopology L
  obtain ⟨hparam, hconn⟩ := hback.comp_subtype_connectedComponent
    (by exact_mod_cast (ne_of_gt (zero_lt_one.trans_le hm))) xp
  let _ : Nonempty C := hparam.nonempty
  let _ : ConnectedSpace C := hconn
  let N : IntegralManifold.{uM, uM, uE, uH} (I := I) m L.distribution k :=
    { carrier := C
      map := WithTopology.ofTopology ∘ Subtype.val
      isImmersion := hparam.isImmersion
      range_mfderiv := hparam.range_mfderiv }
  refine ⟨N, inferInstance,
    (WithTopology.ofTopology_injective (intrinsicTopology L)).comp Subtype.val_injective, ?_⟩
  rw [L.leaf_eq_image_connectedComponent_of_coinduced hp.1 hp.2.1 hp.2.2]
  ext z
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨y.val, y.property, rfl⟩
  · rintro ⟨y, hy, rfl⟩
    exact ⟨⟨y, hy⟩, rfl⟩

/-- The intrinsic connected integral manifold through a point, over the existing foliation leaf.
Its carrier has the topology generated by integral plaques. The ambient model is
finite-dimensional and boundaryless, and the foliation has finite or smooth regularity. -/
def leafThrough (x : M) : IntegralManifold.{uM, uM, uE, uH} (I := I) m L.distribution k :=
  (leafData L x).val

/-- The intrinsic leaf carrier is connected. -/
instance connectedSpace_leafThrough (x : M) : ConnectedSpace (L.leafThrough x).carrier :=
  (leafData L x).property.1

/-- The intrinsic leaf parametrization is injective. -/
theorem leafThrough_map_injective (x : M) : Injective (L.leafThrough x).map :=
  (leafData L x).property.2.1

/-- The intrinsic leaf parametrization has exactly the existing foliation leaf as its image. -/
@[simp]
theorem range_leafThrough_map (x : M) : range (L.leafThrough x).map = L.leaf x :=
  (leafData L x).property.2.2

/-- The base point in the intrinsic leaf, characterized by its ambient image. -/
def leafThroughBasePoint (x : M) : (L.leafThrough x).carrier :=
  Classical.choose (show x ∈ range (L.leafThrough x).map from by simp)

/-- The intrinsic base point maps to the original ambient point. -/
@[simp]
theorem map_leafThroughBasePoint (x : M) :
    (L.leafThrough x).map (L.leafThroughBasePoint x) = x :=
  Classical.choose_spec (show x ∈ range (L.leafThrough x).map from by simp)

/-- The chosen intrinsic base point is the unique point over the ambient base point. -/
@[simp]
theorem leafThrough_map_eq_self_iff (x : M) {y : (L.leafThrough x).carrier} :
    (L.leafThrough x).map y = x ↔ y = L.leafThroughBasePoint x := by
  constructor
  · intro hy
    exact L.leafThrough_map_injective x (hy.trans (L.map_leafThroughBasePoint x).symm)
  · rintro rfl
    exact L.map_leafThroughBasePoint x

/-- If the ambient manifold is Hausdorff, so is the intrinsic leaf. -/
instance t2Space_leafThrough [T2Space M] (x : M) : T2Space (L.leafThrough x).carrier :=
  T2Space.of_injective_continuous (L.leafThrough_map_injective x)
    (L.leafThrough x).contMDiff_map.continuous

/-- Every preconnected integral immersion through the base point factors uniquely by a `C^m` map
through the intrinsic leaf. The source keeps its own model with corners and topology, provided
its carrier is boundaryless. -/
theorem existsUnique_contMDiff_factor_leafThrough (x : M)
    {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ V H'}
    {N : Type uN} [TopologicalSpace N] [ChartedSpace H' N] [IsManifold J m N]
    [BoundarylessManifold J N] [PreconnectedSpace N] {f : N → M}
    (hf : IsIntegralManifold J m L.distribution f) (hx : x ∈ range f) :
    ∃! g : N → (L.leafThrough x).carrier,
      ContMDiff J (𝓡 k) m g ∧ (L.leafThrough x).map ∘ g = f := by
  classical
  have hm : (1 : ℕ∞ω) ≤ m := L.one_le
  let _ : IsManifold J 1 N := .of_le hm
  have hhor : IsHorizontalMap J L.distribution f :=
    isHorizontalMap_iff_range_mfderiv_le.mpr fun y ↦ (hf.range_mfderiv y).le
  obtain ⟨z, hz⟩ := hx
  have hsub := L.range_subset_leaf_of_isHorizontalMap hhor (hf.contMDiff.of_le hm) z
  rw [hz, ← L.range_leafThrough_map x] at hsub
  choose g hg using (fun y ↦ hsub (mem_range_self y))
  have hlocal : IsLocalDiffeomorph J (𝓡 k) m g := fun y ↦
    hf.isLocalDiffeomorphAt_of_comp_eq (L.leafThrough x).isIntegralManifold
      (by exact_mod_cast hm) le_rfl L.isInvolutiveDistribution L.isContMDiffDistribution
      (L.leafThrough_map_injective x) hg BoundarylessManifold.isInteriorPoint
      BoundarylessManifold.isInteriorPoint BoundarylessManifold.isInteriorPoint
  refine ⟨g, ⟨hlocal.contMDiff, funext hg⟩, ?_⟩
  intro q hq
  funext y
  exact L.leafThrough_map_injective x ((congrFun hq.2 y).trans (hg y).symm)

section Lift

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ V H'}
  {N : Type uN} [TopologicalSpace N] [ChartedSpace H' N] [IsManifold J m N]
  [BoundarylessManifold J N] [PreconnectedSpace N] {f : N → M}

/-- The unique `C^m` factor of an integral immersion through the intrinsic leaf. -/
def liftToLeafThrough (x : M) (hf : IsIntegralManifold J m L.distribution f)
    (hx : x ∈ range f) : N → (L.leafThrough x).carrier :=
  Classical.choose (L.existsUnique_contMDiff_factor_leafThrough x hf hx)

/-- The canonical factor through the intrinsic leaf is `C^m`. -/
theorem contMDiff_liftToLeafThrough (x : M) (hf : IsIntegralManifold J m L.distribution f)
    (hx : x ∈ range f) : ContMDiff J (𝓡 k) m (L.liftToLeafThrough x hf hx) :=
  (Classical.choose_spec (L.existsUnique_contMDiff_factor_leafThrough x hf hx)).1.1

/-- The canonical factor has the original ambient map. -/
@[simp]
theorem map_liftToLeafThrough (x : M) (hf : IsIntegralManifold J m L.distribution f)
    (hx : x ∈ range f) (y : N) : (L.leafThrough x).map (L.liftToLeafThrough x hf hx y) = f y :=
  congrFun (Classical.choose_spec
    (L.existsUnique_contMDiff_factor_leafThrough x hf hx)).1.2 y

/-- Any `C^m` factor through the intrinsic leaf equals the canonical factor. -/
theorem liftToLeafThrough_unique (x : M) (hf : IsIntegralManifold J m L.distribution f)
    (hx : x ∈ range f) {g : N → (L.leafThrough x).carrier}
    (hg : ContMDiff J (𝓡 k) m g) (hcomp : (L.leafThrough x).map ∘ g = f) :
    g = L.liftToLeafThrough x hf hx :=
  (Classical.choose_spec (L.existsUnique_contMDiff_factor_leafThrough x hf hx)).2 g ⟨hg, hcomp⟩

/-- The canonical lift sends every preimage of the base point to the intrinsic base point. -/
@[simp]
theorem liftToLeafThrough_eq_leafThroughBasePoint (x : M)
    (hf : IsIntegralManifold J m L.distribution f) (hx : x ∈ range f) {z : N}
    (hz : f z = x) : L.liftToLeafThrough x hf hx z = L.leafThroughBasePoint x := by
  apply (L.leafThrough_map_eq_self_iff x).mp
  simpa only [L.map_liftToLeafThrough x hf hx] using hz

end Lift

private theorem exists_disjoint_integral_cover
    (Φ : PartialDiffeomorph I 𝓘(ℝ, E) M E m) (W : Submodule ℝ E)
    (hflat : ∀ y ∈ Φ.source,
      (L.distribution y).map (mfderiv I 𝓘(ℝ, E) Φ y).toLinearMap = W) :
    ∃ (P : Type uE) (U : P → Opens W) (f : ∀ q, U q → M),
      (∀ q, IsIntegralManifold 𝓘(ℝ, W) m L.distribution (f q)) ∧
      (∀ q, IsEmbedding (f q)) ∧
      (∀ q r, q ≠ r → Disjoint (range (f q)) (range (f r))) ∧
      (⋃ q, range (f q)) = Φ.source := by
  classical
  have hm : (1 : ℕ∞ω) ≤ m := L.one_le
  let _ : IsManifold I m M :=
    .of_le (show (m : ℕ∞ω) ≤ (m : ℕ∞ω) + 1 from le_self_add)
  -- Quotient labels distinguish disjoint plaques in one flat box.
  let P : Set (E ⧸ W) := range fun x : Φ.source ↦ (Submodule.Quotient.mk (Φ x.val) : E ⧸ W)
  have hrep (q : P) :
      ∃ x : Φ.source, (Submodule.Quotient.mk (Φ x.val) : E ⧸ W) = q.val := q.property
  choose x hx using hrep
  have hlocal (q : P) :=
    Φ.exists_isIntegralManifold hm W L.distribution hflat (x q).val (x q).property
  choose U _ f _ hsrc hemb hslice hf using hlocal
  have hlabel (q : P) (y : M) (hy : y ∈ Φ.source) :
      y ∈ range (f q) ↔ (Submodule.Quotient.mk (Φ y) : E ⧸ W) = q.val := by
    have hs : y ∈ range (f q) ↔ Φ y ∈ range (fun w : W ↦ Φ (x q).val + (w : E)) := by
      simpa only [PartialDiffeomorph.toFun'_toOpenPartialHomeomorph] using
        (hslice q).mem_iff hy
    rw [hs]
    constructor
    · rintro ⟨w, hw⟩
      have heq : (Submodule.Quotient.mk (Φ y) : E ⧸ W) =
          Submodule.Quotient.mk (Φ (x q).val) := by
        apply (Submodule.Quotient.eq W).mpr
        rw [← hw]
        simp
      exact heq.trans (hx q)
    · intro hq
      have hmem : Φ y - Φ (x q).val ∈ W :=
        (Submodule.Quotient.eq W).mp (hq.trans (hx q).symm)
      exact ⟨⟨Φ y - Φ (x q).val, hmem⟩, by simp⟩
  refine ⟨P, U, f, hf, hemb, ?_, ?_⟩
  · intro q r hqr
    apply Set.disjoint_left.mpr
    intro y hyq hyr
    have hy := hsrc q hyq
    exact hqr (Subtype.ext (((hlabel q y hy).mp hyq).symm.trans ((hlabel r y hy).mp hyr)))
  · ext y
    constructor
    · intro hy
      obtain ⟨q, hq⟩ := mem_iUnion.mp hy
      exact hsrc q hq
    · intro hy
      let q : P := ⟨Submodule.Quotient.mk (Φ y), ⟨⟨y, hy⟩, rfl⟩⟩
      exact mem_iUnion.mpr ⟨q, (hlabel q y hy).mpr rfl⟩

private theorem exists_countably_colored_integral_cover (A : Set M) (hA : IsLindelof A) :
    ∃ B : Set M, B.Countable ∧
      ∃ (W : B → Submodule ℝ E) (P : B → Type uE)
        (U : ∀ b, P b → Opens (W b)) (f : ∀ b q, U b q → M),
        (∀ b q, IsIntegralManifold 𝓘(ℝ, W b) m L.distribution (f b q)) ∧
        (∀ b q, IsEmbedding (f b q)) ∧
        (∀ b q r, q ≠ r → Disjoint (range (f b q)) (range (f b r))) ∧
        (∀ x ∈ A, ∃ b q y, f b q y = x) := by
  classical
  have hm : 1 ≤ m := by exact_mod_cast L.one_le
  let _ : IsManifold I 1 M := .of_le (show (1 : ℕ∞ω) ≤ (m : ℕ∞ω) + 1 from le_add_self)
  have hlocal (x : M) := L.isInvolutiveDistribution.exists_isIntegralManifold hm le_rfl
    L.isContMDiffDistribution x
  choose W₀ Φ _ _ _ _ hxΦ hflat _ _ _ _ _ using hlocal
  have hboxes : (⋃ x, (Φ x).source) = Set.univ :=
    iUnion_eq_univ_iff.mpr fun x ↦ ⟨x, hxΦ x⟩
  -- Lindelofness selects countably many boxes, each still containing arbitrarily many plaques.
  obtain ⟨B, hBc, hB⟩ := hA.elim_countable_subcover (fun x ↦ (Φ x).source)
    (fun x ↦ (Φ x).open_source) (by rw [hboxes]; exact subset_univ A)
  let W (b : B) := W₀ b.val
  have hplaque (b : B) := L.exists_disjoint_integral_cover (Φ b.val) (W b) (hflat b.val)
  choose P U f hf he hd hc using hplaque
  refine ⟨B, hBc, W, P, U, f, hf, he, hd, ?_⟩
  intro x hxA
  obtain ⟨b, hb, hx⟩ := mem_iUnion₂.mp (hB hxA)
  have hxp : x ∈ ⋃ q, range (f ⟨b, hb⟩ q) := (hc ⟨b, hb⟩).symm ▸ hx
  obtain ⟨q, u, hu⟩ := mem_iUnion.mp hxp
  exact ⟨⟨b, hb⟩, q, u, hu⟩

/-- An injective connected integral immersion with Lindelof ambient image has a second-countable
source. No second countability of the ambient manifold or agreement with its subspace topology
is assumed. The source may use any model with corners whose carrier is boundaryless. -/
theorem secondCountableTopology_of_isLindelof_range
    {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
    {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ E' H'}
    {N : Type uN} [TopologicalSpace N] [ChartedSpace H' N] [IsManifold J m N]
    [BoundarylessManifold J N] [ConnectedSpace N] {g : N → M}
    (hg : IsIntegralManifold J m L.distribution g) (hgi : Injective g)
    (hr : IsLindelof (range g)) : SecondCountableTopology N := by
  -- Embed the source and plaques into the intrinsic atlas, where their overlaps are open.
  -- Lindelofness selects countably many flat boxes. Within each box the plaques are disjoint,
  -- so a second-countable plaque meets only countably many of them; apply the cover criterion.
  let _ : Nonempty N := hg.nonempty
  let _ : Nonempty M := Nonempty.map g inferInstance
  obtain ⟨B, hBc, W, P, U, f, hf, hi, hd, hc⟩ :=
    L.exists_countably_colored_integral_cover _ hr
  let _ : Countable B := hBc.to_subtype
  -- Compare both integral carriers in the intrinsic atlas, rather than the ambient topology.
  let ρ : N → intrinsicCarrier L := WithTopology.toTopology (intrinsicTopology L) ∘ g
  have hρe : IsOpenEmbedding ρ := isOpenEmbedding_toTopology L hg hgi
  let φ (i : Σ b : B, P b) : U i.fst i.snd → intrinsicCarrier L :=
    WithTopology.toTopology (intrinsicTopology L) ∘ f i.fst i.snd
  have hφe (i : Σ b : B, P b) : IsOpenEmbedding (φ i) :=
    isOpenEmbedding_toTopology L (hf i.fst i.snd) (hi i.fst i.snd).injective
  let V (i : Σ b : B, P b) : Set N := ρ ⁻¹' range (φ i)
  let _ (i : Σ b : B, P b) : SecondCountableTopology (range (φ i)) :=
    (hφe i).isEmbedding.toHomeomorph.symm.isEmbedding.secondCountableTopology
  let _ (i : Σ b : B, P b) : SecondCountableTopology (V i) :=
    ((hρe.isEmbedding.comp IsEmbedding.subtypeVal).codRestrict (range (φ i))
      (fun z ↦ z.property)).secondCountableTopology
  have ho (i : Σ b : B, P b) : IsOpen (V i) :=
    (hφe i).isOpen_range.preimage hρe.continuous
  have hdV : ∀ (i j : Σ b : B, P b), i ≠ j → i.fst = j.fst →
      Disjoint (V i) (V j) := by
    rintro ⟨b, p⟩ ⟨c, q⟩ hne heq
    obtain rfl : b = c := heq
    apply Set.disjoint_left.mpr
    intro z hzp hzq
    obtain ⟨u, hu⟩ := hzp
    obtain ⟨v, hv⟩ := hzq
    have huv : f b p u = f b q v :=
      WithTopology.toTopology_injective (intrinsicTopology L) (hu.trans hv.symm)
    exact Set.disjoint_left.mp (hd b p q (fun h ↦ hne (by cases h; rfl)))
      ⟨u, rfl⟩ ⟨v, huv.symm⟩
  have hcover : ⋃ i, V i = Set.univ := by
    apply iUnion_eq_univ_iff.mpr
    intro z
    obtain ⟨b, q, u, hu⟩ := hc (g z) (mem_range_self z)
    exact ⟨⟨b, q⟩, u, congrArg (WithTopology.toTopology (intrinsicTopology L)) hu⟩
  apply TauCeti.secondCountableTopology_of_starCountable_cover V ho hcover
  intro i
  -- A second-countable plaque meets only countably many disjoint open plaques in each box.
  let A : B → Set (Σ b : B, P b) := fun b ↦ {j | j.fst = b ∧ (V i ∩ V j).Nonempty}
  have ha (b : B) : (A b).Countable := by
    let O : (Σ b : B, P b) → Set (V i) := fun j ↦ Subtype.val ⁻¹' V j
    have hdisj : (A b).PairwiseDisjoint O := by
      intro j hj q hq hjq
      exact (hdV j q hjq (hj.1.trans hq.1.symm)).preimage Subtype.val
    apply hdisj.countable_of_isOpen
    · intro j _
      exact (ho j).preimage continuous_subtype_val
    · intro j hj
      obtain ⟨z, hzi, hzj⟩ := hj.2
      exact ⟨⟨z, hzi⟩, hzj⟩
  have heq : {j | (V i ∩ V j).Nonempty} = ⋃ b, A b := by
    ext j
    simp [A]
  rw [heq]
  exact countable_iUnion ha

/-- Intrinsic leaves in a second-countable ambient manifold are second countable. -/
instance secondCountableTopology_leafThrough [SecondCountableTopology M] (x : M) :
    SecondCountableTopology (L.leafThrough x).carrier :=
  L.secondCountableTopology_of_isLindelof_range (L.leafThrough x).isIntegralManifold
    (L.leafThrough_map_injective x) (isLindelof_iff_lindelofSpace.mpr inferInstance)

end TauCeti.Foliation
