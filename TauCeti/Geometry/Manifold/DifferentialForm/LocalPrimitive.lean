/-!
# Local primitives of closed `1`-forms and their covering space

A function `g` is a primitive of a `1`-form `φ` on an open set `U` (`TauCeti.IsPrimitiveOn`) when
it is differentiable there with `d g = φ`. By the Poincaré lemma
(`TauCeti.exists_mextDeriv_eq_nhds`) a closed `C^r` `1`-form (`1 ≤ r`) has a `C^r` primitive near
every point (`TauCeti.exists_contMDiff_isPrimitiveOn`), and two primitives on a common open set
differ by a locally constant function.

Pairs `(x, a)` of a point and a value, with the topology generated by the graphs
`{(y, g y) | y ∈ U}` of the primitives `g` of `φ` on open sets `U`, make up the space
`TauCeti.PrimitiveSpace φ`.
For closed `φ` the projection to the point is a covering map
(`TauCeti.PrimitiveSpace.isCoveringMap_proj`): over an open set carrying a primitive `g`, the sheets
are the graphs of the translates `g + c`. Translating the value is a continuous map of this space
over `M` (`TauCeti.PrimitiveSpace.translate`).

This covering space is the integration theory of closed `1`-forms along continuous paths: a lift of
a path is a primitive of the form along the path, and its monodromy is the integral. It gives the
exactness of closed `1`-forms on simply connected manifolds and the period homomorphism of a closed
`1`-form on the fundamental group.

## Main declarations

* `TauCeti.IsPrimitiveOn φ g U`: `g` is a primitive of `φ` on the open set `U`.
* `TauCeti.PrimitiveSpace φ`: the space of points and values with the topology of local primitives.
* `TauCeti.PrimitiveSpace.isCoveringMap_proj`: its projection is a covering map when `φ` is closed.
* `TauCeti.PrimitiveSpace.exists_isPrimitiveOn_eventually_value_eq`: near each parameter, a
  continuous map into `PrimitiveSpace φ` runs along the graph of a translate of a local primitive.

## References

* John M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Chapter 11, section *Conservative
  Covector Fields*.
* Allen Hatcher, *Algebraic Topology*, Section 1.3 (covering spaces and the lifting criterion).
-/

public section

noncomputable section

open Set Filter
open scoped Manifold ContDiff Topology

namespace TauCeti

variable {E H M F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} [TopologicalSpace M] [ChartedSpace H M]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-! ### Local primitives -/

/-- `g` is a primitive of the `1`-form `φ` on the open set `U`: it is differentiable on `U` and
its differential agrees with `φ` there. -/
structure IsPrimitiveOn (φ : RoughForm I M F 1) (g : M → F) (U : Set M) : Prop where
  isOpen : IsOpen U
  mdifferentiableOn : MDifferentiableOn I 𝓘(ℝ, F) g U
  mextDeriv_eq : ∀ y ∈ U, mextDeriv (RoughForm.ofFunction I g) y = φ y

variable {φ ψ : RoughForm I M F 1} {g h : M → F} {U V : Set M}

theorem IsPrimitiveOn.mono (hg : IsPrimitiveOn φ g U) (hV : IsOpen V) (hVU : V ⊆ U) :
    IsPrimitiveOn φ g V :=
  ⟨hV, hg.mdifferentiableOn.mono hVU, fun y hy ↦ hg.mextDeriv_eq y (hVU hy)⟩

theorem IsPrimitiveOn.add_const (hg : IsPrimitiveOn φ g U) (c : F) :
    IsPrimitiveOn φ (fun y ↦ g y + c) U := by
  refine ⟨hg.isOpen, hg.mdifferentiableOn.add mdifferentiableOn_const, fun y hy ↦ ?_⟩
  rw [mextDeriv_ofFunction_eq_of_eventuallyEq_add_const
    ((hg.mdifferentiableOn y hy).mdifferentiableAt (hg.isOpen.mem_nhds hy))
    (Eventually.of_forall fun _ ↦ rfl)]
  exact hg.mextDeriv_eq y hy

/-- The sum of primitives of `φ` and `ψ` is a primitive of `φ + ψ` on the intersection. -/
theorem IsPrimitiveOn.add (hg : IsPrimitiveOn φ g U) (hh : IsPrimitiveOn ψ h V) :
    IsPrimitiveOn (φ + ψ) (g + h) (U ∩ V) := by
  refine ⟨hg.isOpen.inter hh.isOpen, (hg.mdifferentiableOn.mono inter_subset_left).add
    (hh.mdifferentiableOn.mono inter_subset_right), fun y ⟨hyU, hyV⟩ ↦ ?_⟩
  have hgy := (hg.mdifferentiableOn y hyU).mdifferentiableAt (hg.isOpen.mem_nhds hyU)
  have hhy := (hh.mdifferentiableOn y hyV).mdifferentiableAt (hh.isOpen.mem_nhds hyV)
  rw [Pi.add_apply, ← hg.mextDeriv_eq y hyU, ← hh.mextDeriv_eq y hyV]
  ext v
  simp only [mextDeriv_ofFunction, ContinuousAlternatingMap.add_apply,
    ContinuousAlternatingMap.ofSubsingleton_apply_apply, mvfderiv_apply_eq_mfderiv_apply,
    mfderiv_add hgy hhy]
  -- `NormedSpace.fromTangentSpace` is the identity of `F`
  rfl

/-- A scalar multiple of a primitive of `φ` is a primitive of the scalar multiple of `φ`. -/
theorem IsPrimitiveOn.const_smul (hg : IsPrimitiveOn φ g U) (c : ℝ) :
    IsPrimitiveOn (c • φ) (c • g) U := by
  refine ⟨hg.isOpen, hg.mdifferentiableOn.const_smul c, fun y hy ↦ ?_⟩
  rw [RoughForm.ofFunction_smul, mextDeriv_smul, Pi.smul_apply, Pi.smul_apply, hg.mextDeriv_eq y hy]

/-- The set where two primitives of the same `1`-form agree is open: their difference has zero
differential, so it is locally constant. -/
theorem IsPrimitiveOn.isOpen_setOf_eq [IsManifold I 1 M] (hg : IsPrimitiveOn φ g U)
    (hh : IsPrimitiveOn φ h V) : IsOpen {y | y ∈ U ∧ y ∈ V ∧ g y = h y} := by
  rw [isOpen_iff_mem_nhds]
  rintro y ⟨hyU, hyV, hy⟩
  have hUV : IsOpen (U ∩ V) := hg.isOpen.inter hh.isOpen
  have hdiff : MDifferentiableOn I 𝓘(ℝ, F) (g - h) (U ∩ V) :=
    (hg.mdifferentiableOn.mono inter_subset_left).sub (hh.mdifferentiableOn.mono inter_subset_right)
  have hzero : ∀ z ∈ U ∩ V, mfderiv I 𝓘(ℝ, F) (g - h) z = 0 := by
    rintro z ⟨hzU, hzV⟩
    rw [mfderiv_sub ((hg.mdifferentiableOn z hzU).mdifferentiableAt (hg.isOpen.mem_nhds hzU))
      ((hh.mdifferentiableOn z hzV).mdifferentiableAt (hh.isOpen.mem_nhds hzV))]
    ext v
    have := congrArg (fun A ↦ A fun _ ↦ v)
      ((hg.mextDeriv_eq z hzU).trans (hh.mextDeriv_eq z hzV).symm)
    simp only [mextDeriv_ofFunction, mvfderiv] at this
    -- `NormedSpace.fromTangentSpace` is the identity of `F`
    exact sub_eq_zero.mpr this
  filter_upwards [hdiff.eventuallyEq_const_of_mfderiv_eq_zero hUV hzero ⟨hyU, hyV⟩,
    hUV.mem_nhds ⟨hyU, hyV⟩] with z hz hzUV
  refine ⟨hzUV.1, hzUV.2, ?_⟩
  simpa [hy, sub_eq_zero] using hz

/-! ### The covering space of local primitives -/

/-- Pairs of a point and a value, with the topology generated by the graphs of the primitives of
`φ` on open sets. -/
def PrimitiveSpace (_φ : RoughForm I M F 1) : Type _ := M × F

namespace PrimitiveSpace

variable (φ) in
/-- The point underlying an element of `PrimitiveSpace φ`. -/
def proj (e : PrimitiveSpace φ) : M := Prod.fst (α := M) (β := F) e

variable (φ) in
/-- The value underlying an element of `PrimitiveSpace φ`. -/
def value (e : PrimitiveSpace φ) : F := Prod.snd (α := M) (β := F) e

variable (φ) in
/-- The graph of a function, as a map into `PrimitiveSpace φ`. -/
def graph (g : M → F) (y : M) : PrimitiveSpace φ := ((y, g y) : M × F)

instance : TopologicalSpace (PrimitiveSpace φ) :=
  .generateFrom {S | ∃ g U, IsPrimitiveOn φ g U ∧ S = graph φ g '' U}

@[simp]
theorem proj_graph (y : M) : proj φ (graph φ g y) = y := (rfl)

@[simp]
theorem value_graph (y : M) : value φ (graph φ g y) = g y := (rfl)

/-- Elements of `PrimitiveSpace φ` are determined by their point and value. -/
@[ext]
theorem ext {e e' : PrimitiveSpace φ} (hp : proj φ e = proj φ e') (hv : value φ e = value φ e') :
    e = e' :=
  Prod.ext hp hv

/-- Every element of `PrimitiveSpace φ` lies on the graph of the constant function at its
value. -/
theorem eq_graph (e : PrimitiveSpace φ) : e = graph φ (fun _ ↦ value φ e) (proj φ e) := (rfl)

theorem isOpen_image_graph (hg : IsPrimitiveOn φ g U) : IsOpen (graph φ g '' U) :=
  TopologicalSpace.GenerateOpen.basic _ ⟨g, U, hg, rfl⟩

/-- The graph of a primitive on an open set is continuous there. -/
theorem continuousOn_graph [IsManifold I 1 M] (hg : IsPrimitiveOn φ g U) :
    ContinuousOn (graph φ g) U := by
  refine fun y hy ↦ ContinuousAt.continuousWithinAt ?_
  refine TopologicalSpace.tendsto_nhds_generateFrom_iff.mpr ?_
  rintro _ ⟨h, V, hh, rfl⟩ ⟨w, hwV, hw⟩
  simp only [PrimitiveSpace.ext_iff, proj_graph, value_graph] at hw
  obtain ⟨rfl, hwy⟩ := hw
  filter_upwards [(hg.isOpen_setOf_eq hh).mem_nhds ⟨hy, hwV, hwy.symm⟩] with z hz
  exact ⟨z, hz.2.1, ext (by simp) (by simp [hz.2.2])⟩

/-- A map into `PrimitiveSpace φ` which, near a parameter `t`, runs along the graph of a primitive
`g` on an open set containing the point at `t`, is continuous at `t`. -/
theorem continuousAt_of_eventually_value_eq [IsManifold I 1 M] {X : Type*} [TopologicalSpace X]
    {Γ : X → PrimitiveSpace φ} {t : X} (hΓ : ContinuousAt (fun s ↦ proj φ (Γ s)) t)
    (hg : IsPrimitiveOn φ g U) (ht : proj φ (Γ t) ∈ U)
    (hval : ∀ᶠ s in 𝓝 t, value φ (Γ s) = g (proj φ (Γ s))) : ContinuousAt Γ t := by
  have hc : ContinuousAt (fun s ↦ graph φ g (proj φ (Γ s))) t :=
    ((continuousOn_graph hg).continuousAt (hg.isOpen.mem_nhds ht)).comp
      (f := fun s ↦ proj φ (Γ s)) hΓ
  refine hc.congr ?_
  filter_upwards [hval] with s hs
  exact ext rfl hs.symm

variable (φ) in
/-- Translation of the value by `c`, as a map of `PrimitiveSpace φ` over `M`. -/
def translate (c : F) (e : PrimitiveSpace φ) : PrimitiveSpace φ :=
  graph φ (fun _ ↦ value φ e + c) (proj φ e)

@[simp]
theorem proj_translate (c : F) (e : PrimitiveSpace φ) : proj φ (translate φ c e) = proj φ e :=
  (rfl)

@[simp]
theorem value_translate (c : F) (e : PrimitiveSpace φ) :
    value φ (translate φ c e) = value φ e + c :=
  (rfl)

/-- Translation of the value is continuous: it carries the graph of a primitive `g` to the graph
of the primitive `g + c`. -/
theorem continuous_translate (c : F) : Continuous (translate φ c) := by
  refine continuous_generateFrom_iff.mpr ?_
  rintro _ ⟨g, U, hg, rfl⟩
  convert isOpen_image_graph (hg.add_const (-c)) using 1
  ext e
  simp only [mem_preimage, mem_image, PrimitiveSpace.ext_iff, proj_graph, value_graph,
    proj_translate, value_translate]
  constructor
  · rintro ⟨_, hy, rfl, hv⟩
    exact ⟨_, hy, rfl, by rw [hv, add_neg_cancel_right]⟩
  · rintro ⟨_, hy, rfl, hv⟩
    exact ⟨_, hy, rfl, by rw [← hv, neg_add_cancel_right]⟩

end PrimitiveSpace

variable [FiniteDimensional ℝ E] [T2Space M] [IsManifold I ∞ M] [CompleteSpace F]

/-- By the Poincaré lemma, a closed `C^r` `1`-form has a `C^r` primitive near every point. -/
theorem exists_contMDiff_isPrimitiveOn {r : ℕ∞} (hr : 1 ≤ r)
    (hφ : IsSmoothForm I r φ) (hclosed : mextDeriv φ = 0) (x : M) :
    ∃ g : M → F, ContMDiff I 𝓘(ℝ, F) r g ∧ ∃ U, x ∈ U ∧ IsPrimitiveOn φ g U := by
  obtain ⟨U, hU, ψ, hψ, hdψ⟩ :=
    exists_mextDeriv_eq_nhds hr hφ (x := x) (Eventually.of_forall fun y ↦ congrFun hclosed y)
  rw [RoughForm.eq_ofFunction ψ] at hψ hdψ
  have hg := isSmoothForm_ofFunction_iff.mp hψ
  refine ⟨_, hg, interior U, mem_interior_iff_mem_nhds.mpr hU, isOpen_interior,
    (hg.mdifferentiable (by simpa using (zero_lt_one.trans_le hr).ne')).mdifferentiableOn,
    fun y hy ↦ hdψ y (interior_subset hy)⟩

namespace PrimitiveSpace

/-- Projecting `PrimitiveSpace φ` to the point is a covering map when `φ` is closed. Over an open
set `U` carrying a primitive `g`, the sheets are the graphs of the translates `g + c`. -/
theorem isCoveringMap_proj {r : ℕ∞} (hr : 1 ≤ r) (hφ : IsSmoothForm I r φ)
    (hclosed : mextDeriv φ = 0) : IsCoveringMap (proj φ) := by
  choose g _hg U hxU hgU using exists_contMDiff_isPrimitiveOn hr hφ hclosed
  have : Nonempty (M → PrimitiveSpace φ) := ⟨graph φ 0⟩
  -- the translation constant of a sheet, read in `F`
  let c (i : WithDiscreteTopology F) : F := WithTopology.ofTopology i
  let sheet (x : M) (i : WithDiscreteTopology F) : Set (PrimitiveSpace φ) :=
    graph φ (fun y ↦ g x y + c i) '' U x
  refine IsCoveringMap.mk _ _ (fun x ↦ (hgU x).isOpen.trivializationDiscrete (sheet x) (U x)
    (fun i W hWU ↦ ⟨fun hW ↦ ?_, fun hW ↦ ?_⟩) (fun _ ↦ InjOn.image_of_comp (injOn_id _))
    (fun i y hy ↦ ⟨_, mem_image_of_mem _ hy, proj_graph y⟩) (fun i j hij ↦ ?_) ?_) hxU
  · -- an open subset of `U x` has open preimage in each sheet
    rw [← LeftInvOn.image_inter' (fun _ _ ↦ rfl : LeftInvOn (proj φ) (graph φ _) (U x)),
      inter_eq_left.mpr hWU]
    exact isOpen_image_graph (((hgU x).add_const (c i)).mono hW hWU)
  · -- conversely, an open trace on a sheet comes from an open subset of `U x`
    convert (continuousOn_graph ((hgU x).add_const (c i))).isOpen_inter_preimage (hgU x).isOpen hW
      using 1
    ext y
    simp only [mem_inter_iff, mem_preimage, proj_graph]
    exact ⟨fun hy ↦ ⟨hWU hy, hy, mem_image_of_mem _ (hWU hy)⟩, fun hy ↦ hy.2.1⟩
  · -- distinct translates have disjoint graphs
    refine disjoint_left.mpr ?_
    rintro _ ⟨y, -, rfl⟩ ⟨z, -, hzy⟩
    simp only [PrimitiveSpace.ext_iff, proj_graph, value_graph] at hzy
    obtain ⟨rfl, hzy⟩ := hzy
    exact hij (WithTopology.ofTopology_injective _ (add_left_cancel hzy).symm)
  · -- every point over `U x` lies on the sheet through its value
    intro e he
    refine mem_iUnion.mpr ⟨WithTopology.toTopology _ (value φ e - g x (proj φ e)), proj φ e, he,
      ext rfl ?_⟩
    simp only [value_graph, c, WithTopology.ofTopology_toTopology, add_sub_cancel]

/-- **Lifts run along local primitives.** Near each parameter `t`, a continuous map `Γ` into
`PrimitiveSpace φ`, for a closed `C^r` form `φ` (`1 ≤ r`), runs along the graph of a translate
`g + c` of a `C^r` primitive `g` of `φ` on an open set `U` containing the point at `t`. -/
theorem exists_isPrimitiveOn_eventually_value_eq {r : ℕ∞} (hr : 1 ≤ r)
    (hφ : IsSmoothForm I r φ) (hclosed : mextDeriv φ = 0) {X : Type*} [TopologicalSpace X]
    {Γ : X → PrimitiveSpace φ} {t : X} (hΓ : ContinuousAt Γ t) :
    ∃ g : M → F, ContMDiff I 𝓘(ℝ, F) r g ∧ ∃ U, proj φ (Γ t) ∈ U ∧ IsPrimitiveOn φ g U ∧
      ∃ c : F, ∀ᶠ s in 𝓝 t, proj φ (Γ s) ∈ U ∧ value φ (Γ s) = g (proj φ (Γ s)) + c := by
  obtain ⟨g, hg, U, hxU, hgU⟩ := exists_contMDiff_isPrimitiveOn hr hφ hclosed (proj φ (Γ t))
  refine ⟨g, hg, U, hxU, hgU, value φ (Γ t) - g (proj φ (Γ t)), ?_⟩
  have hmem : Γ t ∈ graph φ (fun y ↦ g y + (value φ (Γ t) - g (proj φ (Γ t)))) '' U :=
    ⟨_, hxU, ext rfl (by simp)⟩
  filter_upwards [hΓ.preimage_mem_nhds ((isOpen_image_graph (hgU.add_const _)).mem_nhds hmem)]
    with s ⟨y, hy, hys⟩
  rw [← hys]
  exact ⟨hy, rfl⟩

end PrimitiveSpace

end TauCeti
