/-!
# Local primitives of `1`-forms and their covering space

A function `g` is a primitive of a `1`-form `φ` on an open set `U` (`TauCeti.IsPrimitiveOn`) when
it is differentiable there with `d g = φ`. Two primitives on a common open set differ locally by a
constant (`TauCeti.IsPrimitiveOn.eventuallyEq_add_const`), and on a preconnected open set by a
single constant (`TauCeti.IsPrimitiveOn.exists_eqOn_add_const`). Having local primitives is local
on open covers (`TauCeti.forall_exists_isPrimitiveOn_iff_of_openCover`) and passes to sums,
coefficient maps (`TauCeti.IsPrimitiveOn.mapCoeff`), commuting scalar multiples
(`TauCeti.IsPrimitiveOn.const_smul`), and pullbacks along differentiable maps
(`TauCeti.IsPrimitiveOn.mpullback`). By the Poincaré lemma (`TauCeti.exists_mextDeriv_eq_nhds`), a
closed `C^r` `1`-form (`1 ≤ r`) with complete coefficients on a finite-dimensional Hausdorff smooth
manifold has a `C^r` primitive near every point (`TauCeti.exists_contMDiff_isPrimitiveOn`).

Pairs `(x, a)` of a point and a value, with the topology generated by the graphs
`{(y, g y) | y ∈ U}` of the primitives `g` of `φ` on open sets `U`, make up the space
`TauCeti.PrimitiveSpace φ`.
Whenever `φ` has local primitives on a `C¹` manifold `M`, the projection to the point is a covering
map (`TauCeti.PrimitiveSpace.isCoveringMap_proj_of_localPrimitives`): over an open set carrying a
primitive `g`, the sheets are the graphs of the translates `g + c`. No finite dimensionality,
Hausdorff property, completeness of coefficients, or regularity of `φ` is required. For closed
`C^r` forms this specializes to `TauCeti.PrimitiveSpace.isCoveringMap_proj`. Translating the value
is a continuous map of this space over `M` (`TauCeti.PrimitiveSpace.translate`).

This covering space is the integration theory of `1`-forms with local primitives along continuous
paths: a lift of a path is a primitive of the form along the path, and its monodromy is the
integral. It gives the exactness of `1`-forms with local primitives on simply connected `C¹`
manifolds and the period homomorphism of a closed `1`-form on the fundamental group.

## Main declarations

* `TauCeti.IsPrimitiveOn φ g U`: `g` is a primitive of `φ` on the open set `U`.
* `TauCeti.IsPrimitiveOn.mapCoeff`, `TauCeti.IsPrimitiveOn.const_smul`,
  `TauCeti.IsPrimitiveOn.neg`, `TauCeti.IsPrimitiveOn.sub`: functoriality in coefficients and
  linearity of local primitives.
* `TauCeti.IsPrimitiveOn.mpullback`: composing with a differentiable map gives a primitive of the
  pulled back form.
* `IsLocalDiffeomorphAt.isPrimitiveOn_comp_localInverse`: conversely, a primitive of a form pulled
  back along a local diffeomorphism descends along its local inverse.
* `TauCeti.IsPrimitiveOn.exists_eqOn_add_const`: two primitives on a preconnected open set differ
  by a single constant.
* `TauCeti.forall_exists_isPrimitiveOn_iff_of_openCover`: having local primitives is local on open
  covers, read on the open submanifolds.
* `TauCeti.isPrimitiveOn_ofSubsingleton_iff`, `TauCeti.IsPrimitiveOn.hasFDerivAt_symm`: on a real
  normed space, `IsPrimitiveOn` matches pointwise `HasFDerivAt` on an open set, and the derivative
  of a differentiable covector field with a local primitive is symmetric.
* `TauCeti.PrimitiveSpace φ`: the space of points and values with the topology of local primitives.
* `TauCeti.PrimitiveSpace.isCoveringMap_proj_of_localPrimitives`: its projection is a covering map
  whenever `φ` has local primitives on a `C¹` manifold; `TauCeti.PrimitiveSpace.isCoveringMap_proj`
  is the closed `C^r` specialization.
* `TauCeti.PrimitiveSpace.eventually_value_eq_of_isPrimitiveOn`,
  `TauCeti.PrimitiveSpace.exists_isPrimitiveOn_eventually_value_eq_of_localPrimitives`, and
  `TauCeti.PrimitiveSpace.exists_isPrimitiveOn_eventually_value_eq`: near each parameter, a
  continuous map into `PrimitiveSpace φ` runs along the graph of a translate of a local primitive.

## References

* John M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Chapter 11, section *Conservative
  Covector Fields*.
* Allen Hatcher, *Algebraic Topology*, Section 1.3 (covering spaces and the lifting criterion).
-/

public section

noncomputable section

open Set Filter
open scoped Manifold ContDiff Topology

namespace TauCeti

variable {E H M F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} [TopologicalSpace M] [ChartedSpace H M]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-! ### Local primitives -/

/-- `g` is a primitive of the `1`-form `φ` on the open set `U`: it is differentiable on `U` and
its differential agrees with `φ` there. -/
structure IsPrimitiveOn (φ : RoughForm I M F 1) (g : M → F) (U : Set M) : Prop where
  isOpen : IsOpen U
  mdifferentiableOn : MDifferentiableOn I 𝓘(ℝ, F) g U
  mextDeriv_eq : ∀ y ∈ U, mextDeriv (RoughForm.ofFunction I g) y = φ y

variable {φ ψ : RoughForm I M F 1} {g h : M → F} {U V : Set M}

/-- A differentiable function whose differential is `φ` is a primitive of `φ` on the whole space. -/
theorem isPrimitiveOn_univ_of_mextDeriv_eq (hg : MDifferentiable I 𝓘(ℝ, F) g)
    (h : mextDeriv (RoughForm.ofFunction I g) = φ) : IsPrimitiveOn φ g univ :=
  ⟨isOpen_univ, hg.mdifferentiableOn, fun y _ ↦ congrFun h y⟩

/-- The zero function is a primitive of the zero `1`-form on any open set. -/
theorem isPrimitiveOn_zero (hU : IsOpen U) :
    IsPrimitiveOn (0 : RoughForm I M F 1) (0 : M → F) U :=
  ⟨hU, mdifferentiableOn_const, fun y _ ↦ by simp [mextDeriv_ofFunction_zero]⟩

theorem IsPrimitiveOn.mono (hg : IsPrimitiveOn φ g U) (hV : IsOpen V) (hVU : V ⊆ U) :
    IsPrimitiveOn φ g V :=
  ⟨hV, hg.mdifferentiableOn.mono hVU, fun y hy ↦ hg.mextDeriv_eq y (hVU hy)⟩

/-- If two `1`-forms agree on `U`, a primitive of one on `U` is a primitive of the other. -/
theorem IsPrimitiveOn.congr (hg : IsPrimitiveOn φ g U) (hφψ : ∀ y ∈ U, φ y = ψ y) :
    IsPrimitiveOn ψ g U :=
  ⟨hg.isOpen, hg.mdifferentiableOn, fun y hy ↦ (hg.mextDeriv_eq y hy).trans (hφψ y hy)⟩

theorem IsPrimitiveOn.add_const (hg : IsPrimitiveOn φ g U) (c : F) :
    IsPrimitiveOn φ (fun y ↦ g y + c) U := by
  refine ⟨hg.isOpen, hg.mdifferentiableOn.add mdifferentiableOn_const, fun y hy ↦ ?_⟩
  rw [mextDeriv_ofFunction_eq_of_eventuallyEq_add_const
    (Eventually.of_forall fun _ ↦ rfl)]
  exact hg.mextDeriv_eq y hy

/-- The sum of primitives of `φ` and `ψ` is a primitive of `φ + ψ` on the intersection. -/
theorem IsPrimitiveOn.add (hg : IsPrimitiveOn φ g U) (hh : IsPrimitiveOn ψ h V) :
    IsPrimitiveOn (φ + ψ) (g + h) (U ∩ V) := by
  refine ⟨hg.isOpen.inter hh.isOpen, (hg.mdifferentiableOn.mono inter_subset_left).add
    (hh.mdifferentiableOn.mono inter_subset_right), fun y ⟨hyU, hyV⟩ ↦ ?_⟩
  have hgy := (hg.mdifferentiableOn y hyU).mdifferentiableAt (hg.isOpen.mem_nhds hyU)
  have hhy := (hh.mdifferentiableOn y hyV).mdifferentiableAt (hh.isOpen.mem_nhds hyV)
  rw [Pi.add_apply, ← hg.mextDeriv_eq y hyU, ← hh.mextDeriv_eq y hyV]
  ext v
  simp only [mextDeriv_ofFunction, ContinuousAlternatingMap.add_apply,
    ContinuousAlternatingMap.ofSubsingleton_apply_apply, mvfderiv_apply_eq_mfderiv_apply,
    mfderiv_add hgy hhy]
  -- `NormedSpace.fromTangentSpace` is the identity of `F`
  rfl

/-- Postcomposing a primitive of `φ` with a continuous real-linear coefficient map `L : F →L[ℝ] G`
gives a primitive of `RoughForm.mapCoeff L φ`. -/
theorem IsPrimitiveOn.mapCoeff {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G]
    (L : F →L[ℝ] G) (hg : IsPrimitiveOn φ g U) :
    IsPrimitiveOn (RoughForm.mapCoeff L φ) (L ∘ g) U := by
  refine ⟨hg.isOpen,
    ((L.contDiff (n := 1)).contMDiff.mdifferentiable one_ne_zero).comp_mdifferentiableOn
      hg.mdifferentiableOn, fun y hy ↦ ?_⟩
  have hgy := (hg.mdifferentiableOn y hy).mdifferentiableAt (hg.isOpen.mem_nhds hy)
  ext v
  rw [mextDeriv_ofFunction, ContinuousAlternatingMap.ofSubsingleton_apply_apply,
    RoughForm.mapCoeff_apply, ← hg.mextDeriv_eq y hy, mextDeriv_ofFunction,
    ContinuousAlternatingMap.ofSubsingleton_apply_apply]
  simpa only [L.hasFDerivAt.fderiv] using
    mvfderiv_comp_apply_of_differentiableAt (L.differentiableAt (x := g y)) hgy (v 0)

/-- A scalar multiple of a primitive of `φ` (by any scalar action commuting with `ℝ`) is a
primitive of the scalar multiple of `φ`. -/
theorem IsPrimitiveOn.const_smul {S : Type*} [Monoid S] [DistribMulAction S F]
    [ContinuousConstSMul S F] [SMulCommClass ℝ S F] (hg : IsPrimitiveOn φ g U) (c : S) :
    IsPrimitiveOn (c • φ) (c • g) U := by
  rw [RoughForm.smul_eq_mapCoeff]
  exact hg.mapCoeff (c • ContinuousLinearMap.id ℝ F)

/-- The negation of a primitive of `φ` is a primitive of `-φ`. -/
theorem IsPrimitiveOn.neg (hg : IsPrimitiveOn φ g U) : IsPrimitiveOn (-φ) (-g) U := by
  simpa using hg.const_smul (-1 : ℝ)

/-- The difference of primitives of `φ` and `ψ` is a primitive of `φ - ψ` on the intersection. -/
theorem IsPrimitiveOn.sub (hg : IsPrimitiveOn φ g U) (hh : IsPrimitiveOn ψ h V) :
    IsPrimitiveOn (φ - ψ) (g - h) (U ∩ V) := by
  simpa only [sub_eq_add_neg] using hg.add hh.neg

section Chart

variable [I.Boundaryless] [IsManifold I 1 M]
  {α : RoughForm I M F 1} {f : M → F} {x : M}

/-- Near a point of its domain, the chart expression of a locally exact one-form is the
ordinary derivative of its local primitive, read as an alternating map of one vector. -/
theorem IsPrimitiveOn.inChartAt_eventuallyEq_fderiv (hf : IsPrimitiveOn α f U) (hx : x ∈ U) :
    α.inChartAt x =ᶠ[𝓝 (extChartAt I x x)] fun z ↦
      ContinuousAlternatingMap.ofSubsingleton ℝ E F (0 : Fin 1)
        (fderiv ℝ (f ∘ (extChartAt I x).symm) z) := by
  have hU : (extChartAt I x).symm ⁻¹' U ∈ 𝓝 (extChartAt I x x) := by
    apply (continuousAt_extChartAt_symm (I := I) x).preimage_mem_nhds
    exact hf.isOpen.mem_nhds (by simpa using hx)
  filter_upwards [hU, extChartAt_target_mem_nhds (I := I) x] with z hzU hz
  have hd := (hf.mdifferentiableOn _ hzU).mdifferentiableAt (hf.isOpen.mem_nhds hzU)
  have hψ := mdifferentiableWithinAt_extChartAt_symm (I := I) hz
  rw [I.range_eq_univ] at hψ
  have hcomp := mvfderiv_comp z hd (hψ.mdifferentiableAt univ_mem)
  rw [mvfderiv_eq_fderiv] at hcomp
  ext v
  rw [RoughForm.inChartAt_apply, ← hf.mextDeriv_eq _ hzU, mextDeriv_ofFunction,
    ContinuousAlternatingMap.ofSubsingleton_apply_apply,
    ContinuousAlternatingMap.ofSubsingleton_apply_apply]
  rw [I.range_eq_univ, mfderivWithin_univ]
  -- The tangent identification of the model space is the identity.
  exact congrArg (fun L ↦ L (v 0)) hcomp.symm

/-- The derivative of a locally exact one-form in a preferred chart is the second derivative
of its primitive, followed by the identification of linear maps with degree-one alternating
maps. No critical-point assumption is needed for this coordinate formula. -/
theorem IsPrimitiveOn.hasFDerivAt_inChartAt (hf : IsPrimitiveOn α f U) (hx : x ∈ U)
    (hf₂ : ContMDiffAt I 𝓘(ℝ, F) 2 f x) :
    HasFDerivAt (α.inChartAt x)
      ((ContinuousAlternatingMap.ofSubsingletonLIE (𝕜 := ℝ) (E := E) (F := F)
          (0 : Fin 1)).toContinuousLinearEquiv.toContinuousLinearMap.comp
        (fderiv ℝ (fderiv ℝ (f ∘ (extChartAt I x).symm)) (extChartAt I x x)))
      (extChartAt I x x) := by
  have hD := (hf₂.contDiffAt_comp_extChartAt_symm.fderiv_right
    (by norm_num : (1 : ℕ∞ω) + 1 ≤ 2)).differentiableAt one_ne_zero
  exact ((ContinuousAlternatingMap.ofSubsingletonLIE (𝕜 := ℝ) (E := E) (F := F)
    (0 : Fin 1)).toContinuousLinearEquiv.hasFDerivAt.comp _ hD.hasFDerivAt).congr_of_eventuallyEq
      (hf.inChartAt_eventuallyEq_fderiv hx)

end Chart

section Pullback

variable {E' H' M' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E'] [TopologicalSpace H']
  {I' : ModelWithCorners ℝ E' H'} [TopologicalSpace M'] [ChartedSpace H' M']

/-- Composing a primitive `g` of `θ` on `U` with a map `f` that is differentiable on an open set
`W` gives a primitive of the pullback of `θ` along `f` on `W ∩ f ⁻¹' U`. -/
theorem IsPrimitiveOn.mpullback_of_mdifferentiableOn {θ : RoughForm I' M' F 1} {g : M' → F}
    {U : Set M'} (hg : IsPrimitiveOn θ g U) {f : M → M'} {W : Set M} (hW : IsOpen W)
    (hf : MDifferentiableOn I I' f W) :
    IsPrimitiveOn (mpullback I I' f θ) (g ∘ f) (W ∩ f ⁻¹' U) := by
  have hfx (x : M) (hx : x ∈ W) : MDifferentiableAt I I' f x :=
    (hf x hx).mdifferentiableAt (hW.mem_nhds hx)
  have hgf (x : M) (hx : x ∈ f ⁻¹' U) : MDifferentiableAt I' 𝓘(ℝ, F) g (f x) :=
    (hg.mdifferentiableOn (f x) hx).mdifferentiableAt (hg.isOpen.mem_nhds hx)
  refine ⟨hf.continuousOn.isOpen_inter_preimage hW hg.isOpen,
    fun x hx ↦ ((hgf x hx.2).comp x (hfx x hx.1)).mdifferentiableWithinAt, fun x hx ↦ ?_⟩
  ext v
  rw [← mpullback_mextDeriv_ofFunction_apply (hfx x hx.1) (hgf x hx.2), mpullback_apply,
    mpullback_apply, hg.mextDeriv_eq (f x) hx.2]

/-- Composing a primitive `g` of `θ` on `U` with a differentiable map `f` gives a primitive of the
pullback of `θ` along `f` on the preimage of `U`. -/
theorem IsPrimitiveOn.mpullback {θ : RoughForm I' M' F 1} {g : M' → F} {U : Set M'}
    (hg : IsPrimitiveOn θ g U) {f : M → M'} (hf : MDifferentiable I I' f) :
    IsPrimitiveOn (mpullback I I' f θ) (g ∘ f) (f ⁻¹' U) := by
  simpa using hg.mpullback_of_mdifferentiableOn isOpen_univ hf.mdifferentiableOn

/-- **Primitives descend along a local inverse.** If `π` is a `C^n` local diffeomorphism at `x`
(`n ≠ 0`) and `g` is a primitive of the pullback `π^* θ` on `V`, then `g ∘ s` is a primitive of
`θ` on `s.source ∩ s ⁻¹' V`, for the local inverse `s` of `π` near `x`. -/
theorem _root_.IsLocalDiffeomorphAt.isPrimitiveOn_comp_localInverse {n : WithTop ℕ∞}
    {θ : RoughForm I' M' F 1} {π : M → M'} {x : M} (hπ : IsLocalDiffeomorphAt I I' n π x)
    (hn : n ≠ 0) {g : M → F} {V : Set M} (hg : IsPrimitiveOn (mpullback I I' π θ) g V) :
    IsPrimitiveOn θ (g ∘ hπ.localInverse) (hπ.localInverse.source ∩ hπ.localInverse ⁻¹' V) := by
  set s := hπ.localInverse
  -- On the open set `s.target`, `π` agrees with the differentiable map `s.symm`.
  have hπs (y : M) (hy : y ∈ s.target) : MDifferentiableAt I I' π y := by
    refine ((s.symm.mdifferentiableAt hn hy).congr_of_eventuallyEq ?_)
    filter_upwards [s.open_target.mem_nhds hy] with w hw
    conv_lhs => rw [← s.right_inv hw]
    exact hπ.localInverse_right_inv (s.map_target hw)
  have hgs := hg.mpullback_of_mdifferentiableOn s.open_source (s.mdifferentiableOn hn)
  refine ⟨hgs.isOpen, hgs.mdifferentiableOn, fun z hz ↦ ?_⟩
  -- Near `z`, `π ∘ s` is the identity, so `s^* π^* θ = θ` at `z`.
  have hid : π ∘ s =ᶠ[𝓝 z] id :=
    eventuallyEq_of_mem (s.open_source.mem_nhds hz.1) hπ.localInverse_eqOn_right
  rw [hgs.mextDeriv_eq z hz, ← mpullback_comp_at (s.mdifferentiableAt hn hz.1)
    (hπs _ (s.map_source hz.1)), hid.mpullback_eq, mpullback_id]

end Pullback

/-! ### Locality on open submanifolds and open covers -/

section Opens

open TopologicalSpace

/-- Restricting a primitive of `φ` on `V` to an open submanifold `U` gives a primitive of the
restricted form on `Subtype.val ⁻¹' V`. -/
theorem IsPrimitiveOn.mpullback_subtypeVal {U : Opens M} (hg : IsPrimitiveOn φ g V) :
    IsPrimitiveOn (TauCeti.mpullback I I (Subtype.val : U → M) φ) (g ∘ Subtype.val)
      ((Subtype.val : U → M) ⁻¹' V) :=
  hg.mpullback (contMDiff_subtypeVal.mdifferentiable one_ne_zero)

/-- A primitive `g` of the restriction of `φ` to an open submanifold `U` on an open subset
`V ⊆ U` extends by `0` outside `U` to a primitive of `φ` on `Subtype.val '' V`. -/
theorem IsPrimitiveOn.of_mpullback_subtypeVal {U : Opens M} {g : U → F} {V : Set U}
    (hg : IsPrimitiveOn (TauCeti.mpullback I I (Subtype.val : U → M) φ) g V) :
    IsPrimitiveOn φ (Function.extend (Subtype.val : U → M) g 0)
      ((Subtype.val : U → M) '' V) := by
  have hopen : IsOpen ((Subtype.val : U → M) '' V) := U.isOpen.isOpenMap_subtypeVal V hg.isOpen
  have hloc (y : U) (hy : y ∈ V) :
      ∃ W : Set M, (y : M) ∈ W ∧ IsPrimitiveOn φ (Function.extend (Subtype.val : U → M) g 0) W := by
    have hπ := isLocalDiffeomorph_subtype_val (I := I) (n := 1) (U := U) y
    have hgs := hπ.isPrimitiveOn_comp_localInverse one_ne_zero hg
    have hyW : (y : M) ∈ hπ.localInverse.source ∩ hπ.localInverse ⁻¹' V :=
      ⟨hπ.localInverse_mem_source, by
        simpa [hπ.localInverse_left_inv hπ.localInverse_mem_target] using hy⟩
    have heq (z : M) (hz : z ∈ hπ.localInverse.source) :
        Function.extend (Subtype.val : U → M) g 0 =ᶠ[𝓝 z] g ∘ hπ.localInverse := by
      filter_upwards [hπ.localInverse.open_source.mem_nhds hz] with w hw
      have hrw : (hπ.localInverse w : M) = w := hπ.localInverse_eqOn_right hw
      conv_lhs => rw [← hrw]
      exact Subtype.val_injective.extend_apply g 0 (hπ.localInverse w)
    refine ⟨hπ.localInverse.source ∩ hπ.localInverse ⁻¹' V, hyW, hgs.isOpen, ?_, ?_⟩
    · intro z hz
      have hdz := (hgs.mdifferentiableOn z hz).mdifferentiableAt (hgs.isOpen.mem_nhds hz)
      exact (hdz.congr_of_eventuallyEq (heq z hz.1)).mdifferentiableWithinAt
    · intro z hz
      rw [mextDeriv_ofFunction_eq_of_eventuallyEq_add_const (g := g ∘ hπ.localInverse) (c := 0)
        ((heq z hz.1).mono fun w hw ↦ by simp [hw])]
      exact hgs.mextDeriv_eq z hz
  refine ⟨hopen, ?_, ?_⟩
  · rintro _ ⟨y, hy, rfl⟩
    obtain ⟨W, hyW, hW⟩ := hloc y hy
    exact ((hW.mdifferentiableOn _ hyW).mdifferentiableAt
      (hW.isOpen.mem_nhds hyW)).mdifferentiableWithinAt
  · rintro _ ⟨y, hy, rfl⟩
    obtain ⟨W, hyW, hW⟩ := hloc y hy
    exact hW.mextDeriv_eq _ hyW

/-- Having a local primitive near a point `x` of an open submanifold `U` is equivalent for `φ` on
`M` and its restriction to `U`. -/
theorem exists_isPrimitiveOn_mpullback_subtypeVal_iff {U : Opens M} (φ : RoughForm I M F 1)
    (x : U) :
    (∃ (g : U → F) (V : Set U), x ∈ V ∧
        IsPrimitiveOn (mpullback I I (Subtype.val : U → M) φ) g V) ↔
      ∃ (g : M → F) (V : Set M), (x : M) ∈ V ∧ IsPrimitiveOn φ g V := by
  constructor
  · rintro ⟨g, V, hxV, hgV⟩
    exact ⟨Function.extend Subtype.val g 0, Subtype.val '' V, mem_image_of_mem _ hxV,
      hgV.of_mpullback_subtypeVal⟩
  · rintro ⟨g, V, hxV, hgV⟩
    exact ⟨g ∘ Subtype.val, Subtype.val ⁻¹' V, hxV, hgV.mpullback_subtypeVal⟩

/-- The restriction of `φ` to an open submanifold `U` has local primitives iff `φ` has local
primitives near every point of `U`. -/
theorem forall_exists_isPrimitiveOn_mpullback_subtypeVal_iff {U : Opens M} (φ : RoughForm I M F 1) :
    (∀ x : U, ∃ (g : U → F) (V : Set U), x ∈ V ∧
        IsPrimitiveOn (mpullback I I (Subtype.val : U → M) φ) g V) ↔
      ∀ x ∈ (U : Set M), ∃ (g : M → F) (V : Set M), x ∈ V ∧ IsPrimitiveOn φ g V :=
  ⟨fun h x hx ↦ (exists_isPrimitiveOn_mpullback_subtypeVal_iff φ ⟨x, hx⟩).mp (h ⟨x, hx⟩),
    fun h x ↦ (exists_isPrimitiveOn_mpullback_subtypeVal_iff φ x).mpr (h x x.property)⟩

/-- **Locality of local primitives on an open cover.** A `1`-form `φ` on `M` has local primitives
iff its restriction to every member of an open cover has local primitives on that open
submanifold. -/
theorem forall_exists_isPrimitiveOn_iff_of_openCover {ι : Type*} {U : ι → Opens M}
    (hcover : ∀ x : M, ∃ i, x ∈ U i) (φ : RoughForm I M F 1) :
    (∀ x : M, ∃ (g : M → F) (V : Set M), x ∈ V ∧ IsPrimitiveOn φ g V) ↔
      ∀ i, ∀ x : U i, ∃ (g : U i → F) (V : Set (U i)), x ∈ V ∧
        IsPrimitiveOn (mpullback I I (Subtype.val : U i → M) φ) g V := by
  simp only [forall_exists_isPrimitiveOn_mpullback_subtypeVal_iff]
  exact ⟨fun h _ x _ ↦ h x, fun h x ↦ let ⟨i, hi⟩ := hcover x; h i x hi⟩

end Opens

/-! ### Normed spaces -/

section NormedSpace

/-- On a real normed space `E`, `IsPrimitiveOn` for the degree-one alternating form associated to a
covector field `α : E → E →L[ℝ] F` is equivalent to `U` being open and `HasFDerivAt g (α x) x` on
`U`. -/
theorem isPrimitiveOn_ofSubsingleton_iff {α : E → E →L[ℝ] F} {g : E → F} {U : Set E} :
    IsPrimitiveOn (I := 𝓘(ℝ, E))
        ((fun x ↦ ContinuousAlternatingMap.ofSubsingleton ℝ E F (0 : Fin 1) (α x)) :
          RoughForm 𝓘(ℝ, E) E F 1) g U ↔
      IsOpen U ∧ ∀ x ∈ U, HasFDerivAt g (α x) x := by
  constructor
  · rintro ⟨hU, hdiff, heq⟩
    refine ⟨hU, fun x hx ↦ ?_⟩
    have hdx : DifferentiableAt ℝ g x :=
      mdifferentiableAt_iff_differentiableAt.mp ((hdiff x hx).mdifferentiableAt (hU.mem_nhds hx))
    have hfx : fderiv ℝ g x = α x := by
      have h := heq x hx
      rw [mextDeriv_ofFunction, mvfderiv_eq_fderiv] at h
      exact (ContinuousAlternatingMap.ofSubsingletonLIE (𝕜 := ℝ) (E := E) (F := F)
        (0 : Fin 1)).injective h
    exact hfx ▸ hdx.hasFDerivAt
  · rintro ⟨hU, hd⟩
    refine ⟨hU, fun x hx ↦ (mdifferentiableAt_iff_differentiableAt.mpr
        (hd x hx).differentiableAt).mdifferentiableWithinAt, fun x hx ↦ ?_⟩
    ext v
    have h := (hd x hx).fderiv
    simp only [mextDeriv_ofFunction, ContinuousAlternatingMap.ofSubsingleton_apply_apply,
      mvfderiv_eq_fderiv, h]
    -- `NormedSpace.fromTangentSpace` is the identity of `E`, and `ofSubsingleton` evaluates at `0`.
    rfl

/-- On an open submanifold `U : TopologicalSpace.Opens E` of a real normed space, the restriction of
the `1`-form associated to `α : E → E →L[ℝ] F` has a global primitive iff `α` admits a Fréchet
primitive `g : E → F` on `U`. -/
theorem exists_isPrimitiveOn_univ_mpullback_subtypeVal_ofSubsingleton_iff
    {U : TopologicalSpace.Opens E} {α : E → E →L[ℝ] F} :
    (∃ g : U → F, IsPrimitiveOn
        (mpullback 𝓘(ℝ, E) 𝓘(ℝ, E) (Subtype.val : U → E)
          ((fun x ↦ ContinuousAlternatingMap.ofSubsingleton ℝ E F (0 : Fin 1) (α x)) :
            RoughForm 𝓘(ℝ, E) E F 1))
        g univ) ↔
      ∃ g : E → F, ∀ x ∈ (U : Set E), HasFDerivAt g (α x) x := by
  constructor
  · rintro ⟨g, hg⟩
    have hset : (Subtype.val : U → E) '' univ = (U : Set E) := by ext x; simp
    have hg' : IsPrimitiveOn (I := 𝓘(ℝ, E))
        ((fun x ↦ ContinuousAlternatingMap.ofSubsingleton ℝ E F (0 : Fin 1) (α x)) :
          RoughForm 𝓘(ℝ, E) E F 1) (Function.extend Subtype.val g 0) (U : Set E) := by
      simpa only [hset] using hg.of_mpullback_subtypeVal
    exact ⟨Function.extend Subtype.val g 0, (isPrimitiveOn_ofSubsingleton_iff.mp hg').2⟩
  · rintro ⟨g, hg⟩
    have hU : IsPrimitiveOn (I := 𝓘(ℝ, E))
        ((fun x ↦ ContinuousAlternatingMap.ofSubsingleton ℝ E F (0 : Fin 1) (α x)) :
          RoughForm 𝓘(ℝ, E) E F 1) g U :=
      isPrimitiveOn_ofSubsingleton_iff.mpr ⟨U.isOpen, hg⟩
    refine ⟨g ∘ Subtype.val, ?_⟩
    convert hU.mpullback_subtypeVal (U := U)
    exact (Subtype.coe_preimage_self (U : Set E)).symm

/-- Symmetry of second derivatives obstructs local primitives: if a covector field
`α : E → E →L[ℝ] F` has Fréchet derivative `A` at `x ∈ U` and admits a primitive on `U`, then `A`
is symmetric. -/
theorem IsPrimitiveOn.hasFDerivAt_symm {α : E → E →L[ℝ] F} {A : E →L[ℝ] E →L[ℝ] F}
    {g : E → F} {U : Set E} {x : E}
    (hg : IsPrimitiveOn (I := 𝓘(ℝ, E))
      ((fun p ↦ ContinuousAlternatingMap.ofSubsingleton ℝ E F (0 : Fin 1) (α p)) :
        RoughForm 𝓘(ℝ, E) E F 1) g U)
    (hx : x ∈ U) (hα : HasFDerivAt α A x) (v w : E) :
    A v w = A w v := by
  rw [isPrimitiveOn_ofSubsingleton_iff] at hg
  exact second_derivative_symmetric_of_eventually_of_real
    (Filter.eventually_of_mem (hg.1.mem_nhds hx) hg.2) hα v w

end NormedSpace

/-! ### Uniqueness up to a constant -/

/-- The set where two primitives of the same `1`-form agree is open: their difference has zero
differential, so it is locally constant. -/
theorem IsPrimitiveOn.isOpen_setOf_eq [IsManifold I 1 M] (hg : IsPrimitiveOn φ g U)
    (hh : IsPrimitiveOn φ h V) : IsOpen {y | y ∈ U ∧ y ∈ V ∧ g y = h y} := by
  rw [isOpen_iff_mem_nhds]
  rintro y ⟨hyU, hyV, hy⟩
  have hUV : IsOpen (U ∩ V) := hg.isOpen.inter hh.isOpen
  have hdiff : MDifferentiableOn I 𝓘(ℝ, F) (g - h) (U ∩ V) :=
    (hg.mdifferentiableOn.mono inter_subset_left).sub (hh.mdifferentiableOn.mono inter_subset_right)
  have hzero : ∀ z ∈ U ∩ V, mfderiv I 𝓘(ℝ, F) (g - h) z = 0 := by
    rintro z ⟨hzU, hzV⟩
    rw [mfderiv_sub ((hg.mdifferentiableOn z hzU).mdifferentiableAt (hg.isOpen.mem_nhds hzU))
      ((hh.mdifferentiableOn z hzV).mdifferentiableAt (hh.isOpen.mem_nhds hzV))]
    ext v
    have := congrArg (fun A ↦ A fun _ ↦ v)
      ((hg.mextDeriv_eq z hzU).trans (hh.mextDeriv_eq z hzV).symm)
    simp only [mextDeriv_ofFunction, mvfderiv] at this
    -- `NormedSpace.fromTangentSpace` is the identity of `F`
    exact sub_eq_zero.mpr this
  filter_upwards [hdiff.eventuallyEq_const_of_mfderiv_eq_zero hUV hzero ⟨hyU, hyV⟩,
    hUV.mem_nhds ⟨hyU, hyV⟩] with z hz hzUV
  refine ⟨hzUV.1, hzUV.2, ?_⟩
  simpa [hy, sub_eq_zero] using hz

/-- Two primitives of the same one-form differ near a common point by their difference
at that point. No connectedness of their domains is required. -/
theorem IsPrimitiveOn.eventuallyEq_add_const [IsManifold I 1 M]
    (hg : IsPrimitiveOn φ g U) (hh : IsPrimitiveOn φ h V) {x : M}
    (hxU : x ∈ U) (hxV : x ∈ V) :
    g =ᶠ[𝓝 x] fun y ↦ h y + (g x - h x) := by
  have hx : x ∈ {y | y ∈ U ∧ y ∈ V ∧ g y = h y + (g x - h x)} :=
    ⟨hxU, hxV, by abel⟩
  filter_upwards [(hg.isOpen_setOf_eq (hh.add_const (g x - h x))).mem_nhds hx]
    with y hy using hy.2.2

/-- Two primitives of the same `1`-form on a preconnected open set have the same increments between
any two points of that set. -/
theorem IsPrimitiveOn.sub_eq_sub_of_isPreconnected [IsManifold I 1 M] (hg : IsPrimitiveOn φ g U)
    (hh : IsPrimitiveOn φ h U) (hU : IsPreconnected U) {x y : M} (hx : x ∈ U) (hy : y ∈ U) :
    g y - g x = h y - h x := by
  have : PreconnectedSpace U := isPreconnected_iff_preconnectedSpace.mp hU
  have hlc : IsLocallyConstant (fun z : U ↦ g z - h z) := by
    rw [IsLocallyConstant.iff_eventually_eq]
    intro z
    filter_upwards [continuous_subtypeVal.continuousAt.preimage_mem_nhds
      (hg.eventuallyEq_add_const hh z.property z.property)] with w hw
    rw [hw]
    abel
  have hxy : g y - h y = g x - h x := hlc.apply_eq_of_preconnectedSpace ⟨y, hy⟩ ⟨x, hx⟩
  rw [sub_eq_sub_iff_sub_eq_sub]
  exact hxy

/-- Two primitives of the same `1`-form on a preconnected open set differ by a single constant. -/
theorem IsPrimitiveOn.exists_eqOn_add_const [IsManifold I 1 M] (hg : IsPrimitiveOn φ g U)
    (hh : IsPrimitiveOn φ h U) (hU : IsPreconnected U) :
    ∃ c : F, EqOn g (fun y ↦ h y + c) U := by
  rcases U.eq_empty_or_nonempty with rfl | ⟨x₀, hx₀⟩
  · exact ⟨0, by simp⟩
  · refine ⟨g x₀ - h x₀, fun y hy ↦ ?_⟩
    have hxy := hg.sub_eq_sub_of_isPreconnected hh hU hx₀ hy
    exact eq_add_of_sub_eq' (sub_eq_sub_iff_sub_eq_sub.mp hxy)

/-- Two global primitives of the same `1`-form on a preconnected `C¹` manifold differ by a single
constant. -/
theorem IsPrimitiveOn.exists_eq_add_const [IsManifold I 1 M] [PreconnectedSpace M]
    (hg : IsPrimitiveOn φ g univ) (hh : IsPrimitiveOn φ h univ) :
    ∃ c : F, ∀ y, g y = h y + c := by
  obtain ⟨c, hc⟩ := hg.exists_eqOn_add_const hh isPreconnected_univ
  exact ⟨c, fun y ↦ hc (mem_univ y)⟩

/-! ### The covering space of local primitives -/

/-- Pairs of a point and a value, with the topology generated by the graphs of the primitives of
`φ` on open sets. -/
def PrimitiveSpace (_φ : RoughForm I M F 1) : Type _ := M × F

namespace PrimitiveSpace

variable (φ) in
/-- The point underlying an element of `PrimitiveSpace φ`. -/
def proj (e : PrimitiveSpace φ) : M := Prod.fst (α := M) (β := F) e

variable (φ) in
/-- The value underlying an element of `PrimitiveSpace φ`. -/
def value (e : PrimitiveSpace φ) : F := Prod.snd (α := M) (β := F) e

variable (φ) in
/-- The graph of a function, as a map into `PrimitiveSpace φ`. -/
def graph (g : M → F) (y : M) : PrimitiveSpace φ := ((y, g y) : M × F)

instance : TopologicalSpace (PrimitiveSpace φ) :=
  .generateFrom {S | ∃ g U, IsPrimitiveOn φ g U ∧ S = graph φ g '' U}

@[simp]
theorem proj_graph (y : M) : proj φ (graph φ g y) = y := (rfl)

@[simp]
theorem value_graph (y : M) : value φ (graph φ g y) = g y := (rfl)

/-- Elements of `PrimitiveSpace φ` are determined by their point and value. -/
@[ext]
theorem ext {e e' : PrimitiveSpace φ} (hp : proj φ e = proj φ e') (hv : value φ e = value φ e') :
    e = e' :=
  Prod.ext hp hv

/-- Every element of `PrimitiveSpace φ` lies on the graph of the constant function at its
value. -/
theorem eq_graph (e : PrimitiveSpace φ) : e = graph φ (fun _ ↦ value φ e) (proj φ e) := (rfl)

theorem isOpen_image_graph (hg : IsPrimitiveOn φ g U) : IsOpen (graph φ g '' U) :=
  TopologicalSpace.GenerateOpen.basic _ ⟨g, U, hg, rfl⟩

/-- The graph of a primitive on an open set is continuous there. -/
theorem continuousOn_graph [IsManifold I 1 M] (hg : IsPrimitiveOn φ g U) :
    ContinuousOn (graph φ g) U := by
  refine fun y hy ↦ ContinuousAt.continuousWithinAt ?_
  refine TopologicalSpace.tendsto_nhds_generateFrom_iff.mpr ?_
  rintro _ ⟨h, V, hh, rfl⟩ ⟨w, hwV, hw⟩
  simp only [PrimitiveSpace.ext_iff, proj_graph, value_graph] at hw
  obtain ⟨rfl, hwy⟩ := hw
  filter_upwards [(hg.isOpen_setOf_eq hh).mem_nhds ⟨hy, hwV, hwy.symm⟩] with z hz
  exact ⟨z, hz.2.1, ext (by simp) (by simp [hz.2.2])⟩

/-- A map into `PrimitiveSpace φ` which, near a parameter `t`, runs along the graph of a primitive
`g` on an open set containing the point at `t`, is continuous at `t`. -/
theorem continuousAt_of_eventually_value_eq [IsManifold I 1 M] {X : Type*} [TopologicalSpace X]
    {Γ : X → PrimitiveSpace φ} {t : X} (hΓ : ContinuousAt (fun s ↦ proj φ (Γ s)) t)
    (hg : IsPrimitiveOn φ g U) (ht : proj φ (Γ t) ∈ U)
    (hval : ∀ᶠ s in 𝓝 t, value φ (Γ s) = g (proj φ (Γ s))) : ContinuousAt Γ t := by
  have hc : ContinuousAt (fun s ↦ graph φ g (proj φ (Γ s))) t :=
    ((continuousOn_graph hg).continuousAt (hg.isOpen.mem_nhds ht)).comp
      (f := fun s ↦ proj φ (Γ s)) hΓ
  refine hc.congr ?_
  filter_upwards [hval] with s hs
  exact ext rfl hs.symm

variable (φ) in
/-- Translation of the value by `c`, as a map of `PrimitiveSpace φ` over `M`. -/
def translate (c : F) (e : PrimitiveSpace φ) : PrimitiveSpace φ :=
  graph φ (fun _ ↦ value φ e + c) (proj φ e)

@[simp]
theorem proj_translate (c : F) (e : PrimitiveSpace φ) : proj φ (translate φ c e) = proj φ e :=
  (rfl)

@[simp]
theorem value_translate (c : F) (e : PrimitiveSpace φ) :
    value φ (translate φ c e) = value φ e + c :=
  (rfl)

/-- Translation of the value is continuous: it carries the graph of a primitive `g` to the graph
of the primitive `g + c`. -/
theorem continuous_translate (c : F) : Continuous (translate φ c) := by
  refine continuous_generateFrom_iff.mpr ?_
  rintro _ ⟨g, U, hg, rfl⟩
  convert isOpen_image_graph (hg.add_const (-c)) using 1
  ext e
  simp only [mem_preimage, mem_image, PrimitiveSpace.ext_iff, proj_graph, value_graph,
    proj_translate, value_translate]
  constructor
  · rintro ⟨_, hy, rfl, hv⟩
    exact ⟨_, hy, rfl, by rw [hv, add_neg_cancel_right]⟩
  · rintro ⟨_, hy, rfl, hv⟩
    exact ⟨_, hy, rfl, by rw [← hv, neg_add_cancel_right]⟩

/-- Projecting `PrimitiveSpace φ` to the point is a covering map whenever `φ` has local primitives
on a `C¹` manifold. Over an open set `U` carrying a primitive `g`, the sheets are the graphs of the
translates `g + c`. No finite dimensionality, Hausdorff property, completeness of `F`, or
regularity of `φ` is assumed. -/
theorem isCoveringMap_proj_of_localPrimitives [IsManifold I 1 M]
    (hφ : ∀ x : M, ∃ (g : M → F) (U : Set M), x ∈ U ∧ IsPrimitiveOn φ g U) :
    IsCoveringMap (proj φ) := by
  choose g U hxU hgU using hφ
  have : Nonempty (M → PrimitiveSpace φ) := ⟨graph φ 0⟩
  -- the translation constant of a sheet, read in `F`
  let c (i : WithDiscreteTopology F) : F := WithTopology.ofTopology i
  let sheet (x : M) (i : WithDiscreteTopology F) : Set (PrimitiveSpace φ) :=
    graph φ (fun y ↦ g x y + c i) '' U x
  refine IsCoveringMap.mk _ _ (fun x ↦ (hgU x).isOpen.trivializationDiscrete (sheet x) (U x)
    (fun i W hWU ↦ ⟨fun hW ↦ ?_, fun hW ↦ ?_⟩) (fun _ ↦ InjOn.image_of_comp (injOn_id _))
    (fun i y hy ↦ ⟨_, mem_image_of_mem _ hy, proj_graph y⟩) (fun i j hij ↦ ?_) ?_) hxU
  · -- an open subset of `U x` has open preimage in each sheet
    rw [← LeftInvOn.image_inter' (fun _ _ ↦ rfl : LeftInvOn (proj φ) (graph φ _) (U x)),
      inter_eq_left.mpr hWU]
    exact isOpen_image_graph (((hgU x).add_const (c i)).mono hW hWU)
  · -- conversely, an open trace on a sheet comes from an open subset of `U x`
    convert (continuousOn_graph ((hgU x).add_const (c i))).isOpen_inter_preimage (hgU x).isOpen hW
      using 1
    ext y
    simp only [mem_inter_iff, mem_preimage, proj_graph]
    exact ⟨fun hy ↦ ⟨hWU hy, hy, mem_image_of_mem _ (hWU hy)⟩, fun hy ↦ hy.2.1⟩
  · -- distinct translates have disjoint graphs
    refine disjoint_left.mpr ?_
    rintro _ ⟨y, -, rfl⟩ ⟨z, -, hzy⟩
    simp only [PrimitiveSpace.ext_iff, proj_graph, value_graph] at hzy
    obtain ⟨rfl, hzy⟩ := hzy
    exact hij (WithTopology.ofTopology_injective _ (add_left_cancel hzy).symm)
  · -- every point over `U x` lies on the sheet through its value
    intro e he
    refine mem_iUnion.mpr ⟨WithTopology.toTopology _ (value φ e - g x (proj φ e)), proj φ e, he,
      ext rfl ?_⟩
    simp only [value_graph, c, WithTopology.ofTopology_toTopology, add_sub_cancel]

/-- **Lifts run along any local primitive.** If `Γ` is continuous at `t` into `PrimitiveSpace φ`
and `g` is a primitive of `φ` on an open set `U` containing `proj φ (Γ t)`, then near `t` the
value of `Γ` agrees with `g + (value φ (Γ t) - g (proj φ (Γ t)))`. -/
theorem eventually_value_eq_of_isPrimitiveOn {X : Type*} [TopologicalSpace X]
    {Γ : X → PrimitiveSpace φ} {t : X} (hΓ : ContinuousAt Γ t) (hgU : IsPrimitiveOn φ g U)
    (ht : proj φ (Γ t) ∈ U) :
    ∀ᶠ s in 𝓝 t, proj φ (Γ s) ∈ U ∧
      value φ (Γ s) = g (proj φ (Γ s)) + (value φ (Γ t) - g (proj φ (Γ t))) := by
  have hmem : Γ t ∈ graph φ (fun y ↦ g y + (value φ (Γ t) - g (proj φ (Γ t)))) '' U :=
    ⟨_, ht, ext rfl (by simp)⟩
  filter_upwards [hΓ.preimage_mem_nhds ((isOpen_image_graph (hgU.add_const _)).mem_nhds hmem)]
    with s ⟨y, hy, hys⟩
  rw [← hys]
  exact ⟨hy, rfl⟩

/-- Near each parameter `t`, a continuous map `Γ` into `PrimitiveSpace φ`, for a form `φ` with
local primitives, runs along the graph of a translate `g + c` of a local primitive `g` of `φ`. -/
theorem exists_isPrimitiveOn_eventually_value_eq_of_localPrimitives
    (hφ : ∀ x : M, ∃ (g : M → F) (U : Set M), x ∈ U ∧ IsPrimitiveOn φ g U)
    {X : Type*} [TopologicalSpace X] {Γ : X → PrimitiveSpace φ} {t : X} (hΓ : ContinuousAt Γ t) :
    ∃ (g : M → F) (U : Set M), proj φ (Γ t) ∈ U ∧ IsPrimitiveOn φ g U ∧
      ∃ c : F, ∀ᶠ s in 𝓝 t, proj φ (Γ s) ∈ U ∧ value φ (Γ s) = g (proj φ (Γ s)) + c := by
  obtain ⟨g, U, hxU, hgU⟩ := hφ (proj φ (Γ t))
  exact ⟨g, U, hxU, hgU, value φ (Γ t) - g (proj φ (Γ t)),
    eventually_value_eq_of_isPrimitiveOn hΓ hgU hxU⟩

end PrimitiveSpace

variable [FiniteDimensional ℝ E] [T2Space M] [IsManifold I ∞ M] [CompleteSpace F]

/-- By the Poincaré lemma, a closed `C^r` `1`-form has a `C^r` primitive near every point. -/
theorem exists_contMDiff_isPrimitiveOn {r : ℕ∞} (hr : 1 ≤ r)
    (hφ : IsSmoothForm I r φ) (hclosed : mextDeriv φ = 0) (x : M) :
    ∃ g : M → F, ContMDiff I 𝓘(ℝ, F) r g ∧ ∃ U, x ∈ U ∧ IsPrimitiveOn φ g U := by
  obtain ⟨U, hU, ψ, hψ, hdψ⟩ :=
    exists_mextDeriv_eq_nhds hr hφ (x := x) (Eventually.of_forall fun y ↦ congrFun hclosed y)
  rw [RoughForm.eq_ofFunction ψ] at hψ hdψ
  have hg := isSmoothForm_ofFunction_iff.mp hψ
  refine ⟨_, hg, interior U, mem_interior_iff_mem_nhds.mpr hU, isOpen_interior,
    (hg.mdifferentiable (by simpa using (zero_lt_one.trans_le hr).ne')).mdifferentiableOn,
    fun y hy ↦ hdψ y (interior_subset hy)⟩

namespace PrimitiveSpace

/-- Projecting `PrimitiveSpace φ` to the point is a covering map when `φ` is closed. Over an open
set `U` carrying a primitive `g`, the sheets are the graphs of the translates `g + c`. -/
theorem isCoveringMap_proj {r : ℕ∞} (hr : 1 ≤ r) (hφ : IsSmoothForm I r φ)
    (hclosed : mextDeriv φ = 0) : IsCoveringMap (proj φ) :=
  isCoveringMap_proj_of_localPrimitives fun x ↦
    let ⟨g, _, U, hxU, hgU⟩ := exists_contMDiff_isPrimitiveOn hr hφ hclosed x
    ⟨g, U, hxU, hgU⟩

/-- **Lifts run along local primitives.** Near each parameter `t`, a continuous map `Γ` into
`PrimitiveSpace φ`, for a closed `C^r` form `φ` (`1 ≤ r`), runs along the graph of a translate
`g + c` of a `C^r` primitive `g` of `φ` on an open set `U` containing the point at `t`. -/
theorem exists_isPrimitiveOn_eventually_value_eq {r : ℕ∞} (hr : 1 ≤ r)
    (hφ : IsSmoothForm I r φ) (hclosed : mextDeriv φ = 0) {X : Type*} [TopologicalSpace X]
    {Γ : X → PrimitiveSpace φ} {t : X} (hΓ : ContinuousAt Γ t) :
    ∃ g : M → F, ContMDiff I 𝓘(ℝ, F) r g ∧ ∃ U, proj φ (Γ t) ∈ U ∧ IsPrimitiveOn φ g U ∧
      ∃ c : F, ∀ᶠ s in 𝓝 t, proj φ (Γ s) ∈ U ∧ value φ (Γ s) = g (proj φ (Γ s)) + c := by
  obtain ⟨g, hg, U, hxU, hgU⟩ := exists_contMDiff_isPrimitiveOn hr hφ hclosed (proj φ (Γ t))
  exact ⟨g, hg, U, hxU, hgU, value φ (Γ t) - g (proj φ (Γ t)),
    eventually_value_eq_of_isPrimitiveOn hΓ hgU hxU⟩

end PrimitiveSpace

end TauCeti
