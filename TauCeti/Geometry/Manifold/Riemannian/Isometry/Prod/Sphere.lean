module

public import TauCeti.Geometry.Manifold.Riemannian.Isometry.Prod.Classification
public import TauCeti.Geometry.Manifold.Riemannian.Sphere.Curvature
import TauCeti.Geometry.Sphere.Connected

/-!
# The full isometry group of a sphere crossed with a line

Every Riemannian self-isometry of `Sⁿ × ℝ`, for the round sphere `Sⁿ` with `n ≥ 2`, is uniquely
the product of an isometry of the sphere and an isometry of the line. Thus the full isometry
group of this product geometry is the direct product of the factor isometry groups. In
particular, taking `n = 2` identifies the full group of the three-dimensional geometry `S² × ℝ`.

The classification specializes the distinct-Ricci-constant product theorem in
`Isometry.Prod.Classification`: the round sphere has Ricci tensor `(n - 1) g`
(`TauCeti.ricciTensor_sphere`) and the line is flat. The restriction `n ≥ 2` is needed for
this argument, which uses that the sphere is connected and not Ricci-flat. For `n = 0` the
statement is false, since the two lines of `S⁰ × ℝ` can be translated independently.

Reference: P. Scott, *The geometries of 3-manifolds*, Bull. London Math. Soc.
15 (1983), 401–487, Section 4 (the product geometries).
-/

public section

noncomputable section

open Bundle Manifold Metric Module
open scoped Manifold ContDiff TauCeti

namespace TauCeti.RiemannianIsometry

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {n : ℕ}
  [Fact (finrank ℝ E = n + 1)]

local notation "S" => sphere (0 : E) 1
local notation "prodModel" => ModelWithCorners.prod (𝓡 n) 𝓘(ℝ)

private theorem connectedSpace_sphere (hn : 2 ≤ n) : ConnectedSpace S :=
  Subtype.connectedSpace (TauCeti.isConnected_sphere_of_one_le (E := E) (n := n) (by omega))

/-- The full isometry group of `Sⁿ × ℝ`, for `n ≥ 2`, is the direct product of the factor
isometry groups. The forward map takes a pair to its product isometry. -/
def sphereProdRealIsomMulEquiv (hn : 2 ≤ n) :
    (Isom (𝓡 n) S × Isom 𝓘(ℝ) ℝ) ≃* Isom prodModel (S × ℝ) := by
  let := connectedSpace_sphere (E := E) hn
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  exact prodIsomMulEquivOfRicciTensorEqSmulInner (a := (n : ℝ) - 1) (b := 0)
    ricciTensor_sphere (by simp) (by linarith)

/-- The group equivalence acts by the two factor isometries. -/
@[simp] theorem sphereProdRealIsomMulEquiv_apply (hn : 2 ≤ n)
    (Φ : Isom (𝓡 n) S × Isom 𝓘(ℝ) ℝ) :
    sphereProdRealIsomMulEquiv hn Φ = Φ.1.prodCongr Φ.2 := by
  let := connectedSpace_sphere (E := E) hn
  exact prodIsomMulEquivOfRicciTensorEqSmulInner_apply _ _ _ Φ

/-- The full isometry group of `Sⁿ × ℝ`, for `n ≥ 2`, is generated by products of factor
isometries: the product homomorphism is surjective. Preservation of the factors follows from
Ricci curvature rather than being assumed. -/
theorem prodCongrHom_surjective_sphere_prod_real (hn : 2 ≤ n) :
    Function.Surjective (prodCongrHom (𝓡 n) S 𝓘(ℝ) ℝ) := by
  intro Q
  obtain ⟨Φ, hΦ⟩ := (sphereProdRealIsomMulEquiv hn).surjective Q
  refine ⟨Φ, ?_⟩
  rw [prodCongrHom_apply, ← sphereProdRealIsomMulEquiv_apply hn Φ]
  exact hΦ

/-- The factors recovered by the inverse equivalence act independently on the two
coordinates of every point. -/
theorem sphereProdRealIsomMulEquiv_symm_apply (hn : 2 ≤ n) (Q : Isom prodModel (S × ℝ))
    (p : S × ℝ) :
    (((sphereProdRealIsomMulEquiv hn).symm Q).1 p.1,
      ((sphereProdRealIsomMulEquiv hn).symm Q).2 p.2) = Q p := by
  let := connectedSpace_sphere (E := E) hn
  exact prodIsomMulEquivOfRicciTensorEqSmulInner_symm_apply _ _ _ Q p

/-- Recovering the factors of a product returns the original pair. -/
@[simp] theorem sphereProdRealIsomMulEquiv_symm_prodCongr (hn : 2 ≤ n)
    (Φ : Isom (𝓡 n) S) (Ψ : Isom 𝓘(ℝ) ℝ) :
    (sphereProdRealIsomMulEquiv hn).symm (Φ.prodCongr Ψ) = (Φ, Ψ) := by
  rw [← sphereProdRealIsomMulEquiv_apply hn (Φ, Ψ)]
  exact (sphereProdRealIsomMulEquiv hn).symm_apply_apply (Φ, Ψ)

end TauCeti.RiemannianIsometry
