module

public import TauCeti.Geometry.Manifold.Riemannian.Isometry.Prod.Hyperbolic.Basic
public import TauCeti.Geometry.Manifold.Riemannian.Isometry.Prod.Factorization
public import TauCeti.Geometry.Manifold.MFDeriv.Separation

/-!
# The full isometry group of hyperbolic space crossed with a line

Every Riemannian self-isometry of `ℍⁿ × ℝ`, for `n ≥ 2`, is uniquely the product of
an isometry of hyperbolic space and an isometry of the line. Thus the full isometry
group of this product geometry is the direct product of the factor isometry groups.
In particular, taking the horizontal coordinate space to be `ℝ` identifies the full
group of the three-dimensional geometry `ℍ² × ℝ`.

The infinitesimal splitting follows from the distinct Ricci constants, as proved in
`Isometry.Prod.Hyperbolic.Basic`. The global splitting uses
`MDifferentiable.eq_prodMap_iff_mfderiv_mixed_eq_zero` and the factor isometries are
recovered by `RiemannianIsometry.exists_prodCongr_of_eq_prodMap`.
The restriction `n ≥ 2` is essential: `ℍ¹ × ℝ` is a flat plane and has rotations
mixing its two tangent factors.

Reference: P. Scott, *The geometries of 3-manifolds*, Bull. London Math. Soc.
15 (1983), 401–487, Section 4 (the product geometries).
-/

public section

noncomputable section

open Bundle Manifold
open scoped Manifold ContDiff TauCeti

namespace TauCeti.RiemannianIsometry

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [Nontrivial E]

local notation "H" => UpperHalfSpace E
local notation "hypModel" => 𝓘(ℝ, WithLp 2 (E × ℝ))
local notation "prodModel" => ModelWithCorners.prod hypModel 𝓘(ℝ)

/-- The full isometry group of `ℍⁿ × ℝ`, for `n ≥ 2`, is generated by products
of factor isometries: the product homomorphism is surjective. Preservation of the
factors follows from Ricci curvature rather than being assumed. -/
theorem prodCongrHom_surjective_hyperbolic_prod_real :
    Function.Surjective (prodCongrHom hypModel H 𝓘(ℝ) ℝ) := by
  intro Q
  let x₀ : H := UpperHalfSpace.mk (WithLp.toLp 2 (0, 1)) (by simp)
  have hsep := (Q.mdifferentiable.eq_prodMap_iff_mfderiv_mixed_eq_zero x₀ 0).mpr
    ⟨fun p v => (Q.fst_mfderiv_eq_zero_iff_hyperbolic_prod_real p (0, v)).mpr rfl,
      fun p v => (Q.snd_mfderiv_eq_zero_iff_hyperbolic_prod_real p (v, 0)).mpr rfl⟩
  obtain ⟨Φ, Ψ, h⟩ := Q.exists_prodCongr_of_eq_prodMap _ _ hsep
  exact ⟨(Φ, Ψ), by simpa only [prodCongrHom_apply] using h⟩

/-- The full isometry group of `ℍⁿ × ℝ`, for `n ≥ 2`, is the direct product of
the factor isometry groups. The forward map takes a pair to its product isometry. -/
def hyperbolicProdRealIsomMulEquiv :
    (Isom hypModel H × Isom 𝓘(ℝ) ℝ) ≃* Isom prodModel (H × ℝ) :=
  MulEquiv.ofBijective (prodCongrHom hypModel H 𝓘(ℝ) ℝ)
    ⟨prodCongrHom_injective, prodCongrHom_surjective_hyperbolic_prod_real⟩

/-- The group equivalence acts by the two factor isometries. -/
@[simp] theorem hyperbolicProdRealIsomMulEquiv_apply
    (Φ : Isom hypModel H × Isom 𝓘(ℝ) ℝ) :
    hyperbolicProdRealIsomMulEquiv Φ = Φ.1.prodCongr Φ.2 :=
  prodCongrHom_apply Φ

/-- The factors recovered by the inverse equivalence act independently on the two
coordinates of every point. -/
theorem hyperbolicProdRealIsomMulEquiv_symm_apply
    (Q : Isom prodModel (H × ℝ)) (p : H × ℝ) :
    ((hyperbolicProdRealIsomMulEquiv.symm Q).1 p.1,
      (hyperbolicProdRealIsomMulEquiv.symm Q).2 p.2) = Q p := by
  have h := congrArg (fun Φ : Isom prodModel (H × ℝ) => Φ p)
    (hyperbolicProdRealIsomMulEquiv.apply_symm_apply Q)
  simpa only [hyperbolicProdRealIsomMulEquiv_apply, prodCongr_apply] using h

/-- Recovering the factors of a product returns the original pair. -/
@[simp] theorem hyperbolicProdRealIsomMulEquiv_symm_prodCongr
    (Φ : Isom hypModel H) (Ψ : Isom 𝓘(ℝ) ℝ) :
    hyperbolicProdRealIsomMulEquiv.symm (Φ.prodCongr Ψ) = (Φ, Ψ) := by
  rw [← hyperbolicProdRealIsomMulEquiv_apply (Φ, Ψ)]
  exact hyperbolicProdRealIsomMulEquiv.symm_apply_apply (Φ, Ψ)

end TauCeti.RiemannianIsometry
