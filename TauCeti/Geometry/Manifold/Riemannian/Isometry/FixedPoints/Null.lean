module

public import TauCeti.Geometry.Manifold.GroupAction.FixedTangentSubspace
public import TauCeti.Geometry.Manifold.Measure.Differentiable
public import TauCeti.Geometry.Manifold.Riemannian.Invariant
public import TauCeti.Geometry.Manifold.Riemannian.Isometry.FixedPoints
import TauCeti.GroupTheory.GroupAction.FixedPoints

/-!
# Fixed sets of isometries are null or have interior

Let a group `K` act on a Riemannian manifold `M` by smooth isometries. Near each point `p` of the
fixed set `M^K`, the Riemannian logarithm at `p` is a smooth chart carrying `M^K` onto the linear
subspace `V_p ⊆ T_p M` of vectors fixed by the differentials at `p`
(`TauCeti.exists_isSliceChart_fixedPoints`). Either `V_p` is all of `T_p M`, and then a whole
neighbourhood of `p` is fixed, or it is a proper subspace, which is null for Lebesgue measure, and
then so is its image under the smooth inverse chart. Hence the fixed set is a null set
(`TauCeti.IsNullSet`) exactly when it has empty interior
(`TauCeti.isNullSet_fixedPoints_iff`).

A compact Lie group acting smoothly on a σ-compact manifold preserves a smooth Riemannian metric
(`TauCeti.of_forall_riemannianBundle_inner_mfderiv`), and the fixed set of one of its elements `g`
is the fixed set of the subgroup generated by `g`. So the fixed set of every element of a compact
group acting smoothly is null exactly when it has empty interior
(`TauCeti.isNullSet_fixedBy_iff_of_compactSpace`), with no metric given in advance. For an element
of finite order acting nontrivially on a connected manifold the interior is empty
(`TauCeti.interior_fixedBy_eq_empty`), so such fixed sets are null; measures with densities, such
as Liouville measures, do not see them.

## Main results

* `TauCeti.isNullSet_fixedPoints_iff`: the fixed set of a group of isometries is null exactly when
  it has empty interior.
* `TauCeti.isNullSet_fixedBy_iff_of_compactSpace`: the fixed set of an element of a compact group
  acting smoothly is null exactly when it has empty interior.

## References

* S. Kobayashi, *Fixed points of isometries*, Nagoya Mathematical Journal 13 (1958), 63–68.
-/

public section

open Bundle MeasureTheory Set MulAction
open scoped ContDiff Manifold

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E] [BorelSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M] [T2Space M]

section Isometry

variable [RiemannianBundle (fun x : M ↦ TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M ↦ TangentSpace I x)]
  {K : Type*} [Group K] [MulAction K M] [ContMDiffConstSMul I ∞ K M]

/-- **The fixed set of a group of isometries is null or has interior.** For a group acting on a
Riemannian manifold by smooth isometries, the fixed set is null exactly when it has empty
interior. -/
theorem isNullSet_fixedPoints_iff
    (hK : ∀ (k : K) (x : M) (u w : TangentSpace I x),
      inner ℝ (mfderiv I I (k • ·) x u) (mfderiv I I (k • ·) x w) = inner ℝ u w) :
    IsNullSet I (fixedPoints K M) ↔ interior (fixedPoints K M) = ∅ := by
  refine ⟨IsNullSet.interior_eq_empty, fun h ↦ isNullSet_iff_forall_exists_nhds.2 fun p hp ↦ ?_⟩
  obtain ⟨φ, hpφ, -, -, hφ⟩ := exists_isSliceChart_fixedPoints hK hp
  refine ⟨φ.source, φ.open_source.mem_nhds hpφ, ?_⟩
  -- In the chart at `p`, the fixed set is the fixed tangent subspace `V_p`.
  set V := fixedTangentSubspace I K p
  have hslice (y : M) (hy : y ∈ φ.source) : y ∈ fixedPoints K M ↔ φ y ∈ V := by
    rw [isSliceChart_iff.1 hφ y hy, mem_fixedTangentSubspace_iff_of_mem_fixedPoints hp]
    rfl
  -- `V_p` is a proper subspace: otherwise the whole chart source would be fixed.
  have hV : V ≠ ⊤ := by
    intro hV
    have hsub : φ.source ⊆ fixedPoints K M := fun y hy ↦ (hslice y hy).2 (hV ▸ Submodule.mem_top)
    have hp' : p ∈ interior (fixedPoints K M) :=
      interior_mono hsub (φ.open_source.interior_eq.symm ▸ hpφ)
    simp [h] at hp'
  -- `T_p M`, normed by the metric, is linearly homeomorphic to the model space `E`, and `V_p` goes
  -- to a proper subspace of `E`, which is null.
  let e : TangentSpace I p ≃L[ℝ] E :=
    (LinearEquiv.refl ℝ E : TangentSpace I p ≃ₗ[ℝ] E).toContinuousLinearEquiv
  have hV' : V.map (e.toLinearEquiv : TangentSpace I p →ₗ[ℝ] E) ≠ ⊤ := by
    rwa [Ne, Submodule.map_eq_top_iff]
  have hnull : IsNullSet 𝓘(ℝ, E) (e '' (φ.target ∩ V)) :=
    (isNullSet_modelWithCornersSelf_iff Measure.addHaar).2
      (measure_mono_null (image_mono inter_subset_right) (Measure.addHaar_submodule _ _ hV'))
  have hsymm : MDifferentiableOn 𝓘(ℝ, E) I (φ.symm ∘ e.symm) (e '' (φ.target ∩ V)) := by
    rintro _ ⟨v, hv, rfl⟩
    refine ((φ.symm.mdifferentiableAt (by simp) ?_).comp _
      e.symm.mdifferentiableAt).mdifferentiableWithinAt
    simpa using hv.1
  refine (hnull.image_of_mdifferentiableOn le_rfl hsymm).mono ?_
  rintro y ⟨hy, hyφ⟩
  exact ⟨e (φ y), ⟨φ y, ⟨φ.map_source hyφ, (hslice y hyφ).1 hy⟩, rfl⟩,
    by simp [φ.left_inv hyφ]⟩

end Isometry

section Compact

variable [SigmaCompactSpace M] {EG : Type*} [NormedAddCommGroup EG] [NormedSpace ℝ EG]
  {HG : Type*} [TopologicalSpace HG] (IG : ModelWithCorners ℝ EG HG)
  {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
  [ChartedSpace HG G] [IsManifold IG ∞ G] [MulAction G M] [ContMDiffSMul IG I ∞ G M]

include IG in
/-- **The fixed set of an element of a compact group is null or has interior.** For a smooth
action of a compact group on a σ-compact manifold without boundary, the fixed set of each element
is null exactly when it has empty interior. -/
theorem isNullSet_fixedBy_iff_of_compactSpace (g : G) :
    IsNullSet I (fixedBy M g) ↔ interior (fixedBy M g) = ∅ :=
  of_forall_riemannianBundle_inner_mfderiv IG G fun hG ↦ by
    -- The fixed set of `g` is that of the subgroup it generates, which acts by isometries.
    have : ContMDiffConstSMul I ∞ (Subgroup.zpowers g) M :=
      ⟨fun k ↦ ContMDiffSMul.contMDiff_const_smul (I := IG) (k : G)⟩
    rw [← fixedPoints_zpowers]
    exact isNullSet_fixedPoints_iff fun k ↦ hG k

end Compact

end TauCeti
