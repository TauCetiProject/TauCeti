namespace TauCeti

open TauCeti.Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  [RiemannianBundle (fun x : M ↦ TangentSpace I x)]

/-- In any module over a division ring of characteristic zero (such as `ℝ`), `-v = v` implies
`v = 0`. -/
theorem eq_zero_of_neg_eq_self (𝕜 : Type*) {V : Type*} [DivisionRing 𝕜] [CharZero 𝕜]
    [AddCommGroup V] [Module 𝕜 V] {v : V} (h : -v = v) : v = 0 := by
  rwa [neg_eq_iff_add_eq_zero, ← two_smul 𝕜, smul_eq_zero, or_iff_right (two_ne_zero' 𝕜)] at h

/-! ### Geodesic symmetries at a point -/

/-- A Riemannian self-isometry `Φ` of `M` is a **geodesic symmetry** (or **point reflection**) at
`p : M` if it fixes `p`, is an involution (`Φ * Φ = 1`), and has differential `-id` on `T_p M`. -/
structure IsGeodesicSymmetryAt (Φ : Isom I M) (p : M) : Prop where
  /-- A geodesic symmetry at `p` fixes `p`. -/
  apply_eq : Φ p = p
  /-- A geodesic symmetry is an involution. -/
  mul_self : Φ * Φ = 1
  /-- The differential of a geodesic symmetry at `p` is `-id`. -/
  mfderiv_eq : mfderiv I I Φ p = -ContinuousLinearMap.id ℝ (TangentSpace I p)

namespace IsGeodesicSymmetryAt

variable {Φ Ψ : Isom I M} {p : M}

/-- Applying a geodesic symmetry twice returns every point to itself. -/
theorem apply_apply (hΦ : IsGeodesicSymmetryAt Φ p) (x : M) : Φ (Φ x) = x := by
  simpa only [RiemannianIsometry.mul_apply, RiemannianIsometry.one_apply] using
    DFunLike.congr_fun hΦ.mul_self x

/-- A geodesic symmetry is an involutive map of `M`. -/
theorem involutive (hΦ : IsGeodesicSymmetryAt Φ p) : Function.Involutive Φ :=
  hΦ.apply_apply

/-- A geodesic symmetry is its own inverse in `Isom I M`. -/
theorem inv_eq (hΦ : IsGeodesicSymmetryAt Φ p) : Φ⁻¹ = Φ :=
  inv_eq_of_mul_eq_one_left hΦ.mul_self

/-- A geodesic symmetry equals its inverse Riemannian isometry. -/
theorem symm_eq (hΦ : IsGeodesicSymmetryAt Φ p) : Φ.symm = Φ :=
  hΦ.inv_eq

/-- The differential of a geodesic symmetry at `p` negates every tangent vector at `p`. -/
theorem mfderiv_apply (hΦ : IsGeodesicSymmetryAt Φ p) (v : TangentSpace I p) :
    mfderiv I I Φ p v = -v :=
  apply_of_eq_neg_id hΦ.apply_eq hΦ.mfderiv_eq v

/-- Conjugating a geodesic symmetry at `p` by a Riemannian isometry `Ψ : M → N` produces a
geodesic symmetry at `Ψ p`. -/
theorem conj {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {G : Type*} [TopologicalSpace G] {J : ModelWithCorners ℝ F G}
    {N : Type*} [TopologicalSpace N] [ChartedSpace G N]
    [RiemannianBundle (fun y : N ↦ TangentSpace J y)]
    (hΦ : IsGeodesicSymmetryAt Φ p) (Ψ : RiemannianIsometry I J M N) :
    IsGeodesicSymmetryAt (Ψ.symm.trans (Φ.trans Ψ)) (Ψ p) where
  apply_eq := by
    simp [hΦ.apply_eq]
  mul_self := by
    ext y
    simp [hΦ.apply_apply]
  mfderiv_eq := by
    have hcomp : ⇑(Ψ.symm.trans (Φ.trans Ψ)) = Ψ ∘ (Φ ∘ Ψ.symm) := by
      funext y
      simp
    have hd1 : MDifferentiableAt J I Ψ.symm (Ψ p) := Ψ.symm.mdifferentiableAt (Ψ p)
    have hd2 : MDifferentiableAt I I Φ (Ψ.symm (Ψ p)) := Φ.mdifferentiableAt _
    have hd3 : MDifferentiableAt I J Ψ ((Φ ∘ Ψ.symm) (Ψ p)) := Ψ.mdifferentiableAt _
    have hΦΨ : (Φ ∘ Ψ.symm) (Ψ p) = p := by simp [hΦ.apply_eq]
    rw [hcomp, mfderiv_comp (Ψ p) hd3 (hd2.comp (Ψ p) hd1),
      mfderiv_comp (Ψ p) hd2 hd1]
    refine eq_neg_id_of_apply (by simp [hΦ.apply_eq]) fun v ↦ ?_
    simp only [ContinuousLinearMap.comp_apply, Function.comp_apply]
    let w : TangentSpace I (Ψ.symm (Ψ p)) := mfderiv J I Ψ.symm (Ψ p) v
    let u : TangentSpace I p := tangentSpaceCast I (Ψ.symm (Ψ p)) p w
    have hwu : (w : E) = u := (coe_tangentSpaceCast I (Ψ.symm (Ψ p)) p w).symm
    have hv : (mfderiv I I Φ (Ψ.symm (Ψ p)) w : E) = (-u : TangentSpace I p) :=
      (mfderiv_apply_congr_point (Ψ.symm_apply_apply p) hwu).trans (hΦ.mfderiv_apply u)
    have hid : (mfderiv I J Ψ p u : F) = v := by
      have hcomp_id : (⇑Ψ ∘ ⇑Ψ.symm : N → N) = id := funext Ψ.apply_symm_apply
      have h := mfderiv_apply_mfderiv_of_eventuallyEq_comp (.of_eq hcomp_id)
        (Ψ.mdifferentiableAt (Ψ.symm (Ψ p))) hd1 v
      rw [mfderiv_id, ContinuousLinearMap.id_apply] at h
      exact (mfderiv_apply_congr_point (Ψ.symm_apply_apply p) hwu).symm.trans h
    exact (mfderiv_apply_congr_point hΦΨ hv).trans
      ((map_neg (mfderiv I J Ψ p) u).trans (congrArg Neg.neg hid))

/-- Conjugating a geodesic symmetry at `p` by `Ψ ∈ Isom I M` gives a geodesic symmetry at
`Ψ p`. -/
theorem conj_isom (hΦ : IsGeodesicSymmetryAt Φ p) (Ψ : Isom I M) :
    IsGeodesicSymmetryAt (Ψ * Φ * Ψ⁻¹) (Ψ p) :=
  hΦ.conj Ψ

/-- The product of geodesic symmetries at `p` and `q` is a geodesic symmetry at `(p, q)` for the
product metric. -/
theorem prodCongr {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {G : Type*} [TopologicalSpace G] {J : ModelWithCorners ℝ F G}
    {N : Type*} [TopologicalSpace N] [ChartedSpace G N]
    [RiemannianBundle (fun y : N ↦ TangentSpace J y)]
    {Ψ : Isom J N} {q : N}
    (hΦ : IsGeodesicSymmetryAt Φ p) (hΨ : IsGeodesicSymmetryAt Ψ q) :
    IsGeodesicSymmetryAt (Φ.prodCongr Ψ) (p, q) where
  apply_eq := by
    rw [RiemannianIsometry.prodCongr_apply]
    exact Prod.ext hΦ.apply_eq hΨ.apply_eq
  mul_self := by
    ext x <;> simp [hΦ.apply_apply, hΨ.apply_apply]
  mfderiv_eq := by
    rw [RiemannianIsometry.coe_prodCongr,
      mfderiv_prodMap (Φ.mdifferentiableAt p) (Ψ.mdifferentiableAt q)]
    ext v
    · exact hΦ.mfderiv_apply v.1
    · exact hΨ.mfderiv_apply v.2

end IsGeodesicSymmetryAt

/-! ### Uniqueness, isolated fixed points, geodesics, and curvature -/

section Smooth

variable [FiniteDimensional ℝ E] [IsManifold I ∞ M] [T2Space M]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M ↦ TangentSpace I x)]

namespace IsGeodesicSymmetryAt

/-- **Vanishing of `∇R` at the centre of a geodesic symmetry.** If `M` admits a geodesic symmetry
at `p`, then the covariant derivative of the curvature tensor of the Levi-Civita connection
vanishes at `p`. -/
theorem derivCurvatureTensor_eq_zero {Φ : Isom I M} {p : M} (hΦ : IsGeodesicSymmetryAt Φ p) :
    (leviCivitaConnection I M).derivCurvatureTensor (leviCivitaConnection I M) p = 0 := by
  -- Naturality of `∇R` under `dΦ_p = -id` negates the output while multiplying the four
  -- multilinear inputs by `(-1) ^ 4 = 1`, forcing `(∇R)_p = -(∇R)_p`.
  ext v u w s
  simp only [LinearMap.zero_apply]
  have hnat := Φ.isLocalRiemannianIsometry.mfderiv_derivCurvatureTensor p v u w s
  have h : -((leviCivitaConnection I M).derivCurvatureTensor (leviCivitaConnection I M) p
      v u w s) =
      (leviCivitaConnection I M).derivCurvatureTensor (leviCivitaConnection I M) p
        v u w s := by
    have h1 :
        (-((leviCivitaConnection I M).derivCurvatureTensor (leviCivitaConnection I M) p
          v u w s) : E) =
        (leviCivitaConnection I M).derivCurvatureTensor (leviCivitaConnection I M) p
          (-v) (-u) (-w) (-s) :=
      (hΦ.mfderiv_apply _).symm.trans (hnat.trans
        (derivCurvatureTensor_tangentSpace_congr (leviCivitaConnection I M)
          (leviCivitaConnection I M) hΦ.apply_eq (hΦ.mfderiv_apply v) (hΦ.mfderiv_apply u)
          (hΦ.mfderiv_apply w) (hΦ.mfderiv_apply s)))
    simpa only [map_neg, LinearMap.neg_apply, neg_neg] using h1
  exact eq_zero_of_neg_eq_self ℝ h

end IsGeodesicSymmetryAt

variable [I.Boundaryless]

/-- On a preconnected smooth Riemannian manifold, an isometry fixing `p` whose differential at `p`
is `-id` is automatically involutive, hence a geodesic symmetry at `p`. -/
theorem isGeodesicSymmetryAt_of_mfderiv_eq_neg_id [PreconnectedSpace M] {Φ : Isom I M} {p : M}
    (hp : Φ p = p) (hd : mfderiv I I Φ p = -ContinuousLinearMap.id ℝ (TangentSpace I p)) :
    IsGeodesicSymmetryAt Φ p where
  apply_eq := hp
  mul_self := by
    refine RiemannianIsometry.ext_of_mfderiv_eq (Φ * Φ) 1 (p := p) (by simp [hp]) ?_
    have hf : HasMFDerivAt I I Φ p (-ContinuousLinearMap.id ℝ (TangentSpace I p)) :=
      hd ▸ (Φ.mdifferentiableAt p).hasMFDerivAt
    have hf2 := (hf.iterate hp 2).mfderiv
    rw [Function.iterate_succ, Function.iterate_one, sq, ContinuousLinearMap.mul_def,
      ContinuousLinearMap.neg_comp, ContinuousLinearMap.comp_neg, neg_neg,
      ContinuousLinearMap.id_comp] at hf2
    rw [RiemannianIsometry.coe_mul, RiemannianIsometry.coe_one, hf2, mfderiv_id]
  mfderiv_eq := hd

namespace IsGeodesicSymmetryAt

variable {Φ Ψ : Isom I M} {p : M}

/-- **Uniqueness of the geodesic symmetry.** On a preconnected smooth Riemannian manifold, there is
at most one geodesic symmetry at a given point `p`. -/
theorem eq [PreconnectedSpace M] (hΦ : IsGeodesicSymmetryAt Φ p)
    (hΨ : IsGeodesicSymmetryAt Ψ p) : Φ = Ψ :=
  RiemannianIsometry.ext_of_mfderiv_eq Φ Ψ (hΦ.apply_eq.trans hΨ.apply_eq.symm)
    (hΦ.mfderiv_eq.trans hΨ.mfderiv_eq.symm)

/-- **`p` is an isolated fixed point of a geodesic symmetry at `p`.** Every fixed point of `Φ` in a
sufficiently small neighbourhood of `p` equals `p`. -/
theorem exists_nhds_eq_of_apply_eq (hΦ : IsGeodesicSymmetryAt Φ p) :
    ∃ U ∈ 𝓝 p, ∀ q ∈ U, Φ q = q → q = p := by
  obtain ⟨r, -, hU⟩ := exists_isNormalDomain_ball (I := I) (M := M) p
  refine ⟨riemannianExp I M p '' Metric.ball 0 r, hU.image_mem_nhds, ?_⟩
  rintro q ⟨v, hv, rfl⟩ hq
  have hΦv : (mfderiv I I Φ p v : TangentSpace I p) ∈ Metric.ball (0 : TangentSpace I p) r :=
    mfderiv_mem_ball_of_apply_eq_self hΦ.apply_eq (Φ.inner_mfderiv p) hv
  have hv_neg : -v = v := by
    rw [← hΦ.mfderiv_apply]
    exact (Φ.apply_riemannianExp_eq_self_iff hU hΦ.apply_eq hv hΦv).1 hq
  rw [eq_zero_of_neg_eq_self ℝ hv_neg, riemannianExp_zero]

/-- In a punctured neighbourhood of `p`, a geodesic symmetry at `p` has no fixed points. -/
theorem eventually_apply_ne (hΦ : IsGeodesicSymmetryAt Φ p) :
    ∀ᶠ q in 𝓝[≠] p, Φ q ≠ q := by
  obtain ⟨U, hU, hfix⟩ := hΦ.exists_nhds_eq_of_apply_eq
  filter_upwards [nhdsWithin_le_nhds hU, self_mem_nhdsWithin] with q hqU hqne hfixq
  exact hqne (hfix q hqU hfixq)

omit [T2Space M] [I.Boundaryless] in
/-- A geodesic symmetry at `p` equates the maximal geodesic intervals of `v` and `-v`. -/
theorem geodesicInterval_neg_eq (hΦ : IsGeodesicSymmetryAt Φ p) (v : TangentSpace I p) :
    geodesicInterval I M p (-v) = geodesicInterval I M p v := by
  rw [← Φ.geodesicInterval_mfderiv p v]
  exact (geodesicInterval_congr hΦ.apply_eq (hΦ.mfderiv_apply v)).symm

omit [T2Space M] [I.Boundaryless] in
/-- The maximal geodesic interval of any tangent vector at `p` is symmetric about `0` whenever `p`
admits a geodesic symmetry. -/
theorem neg_mem_geodesicInterval_iff (hΦ : IsGeodesicSymmetryAt Φ p) {v : TangentSpace I p}
    {t : ℝ} : -t ∈ geodesicInterval I M p v ↔ t ∈ geodesicInterval I M p v := by
  have h := mem_geodesicInterval_smul_iff (I := I) (M := M) (p := p) (v := v) (t := t)
    (show (-1 : ℝ) ≠ 0 by norm_num)
  rw [neg_one_smul, neg_one_mul, hΦ.geodesicInterval_neg_eq] at h
  exact h.symm

/-- **Geodesic reversal.** A geodesic symmetry at `p` reverses every maximal geodesic through `p`:
`Φ (γ_{p, v}(t)) = γ_{p, v}(-t)` for all `t : ℝ`. -/
theorem apply_maximalGeodesic (hΦ : IsGeodesicSymmetryAt Φ p) (v : TangentSpace I p) (t : ℝ) :
    Φ (maximalGeodesic I M p v t) = maximalGeodesic I M p v (-t) := by
  by_cases ht : t ∈ geodesicInterval I M p v
  · rw [← Φ.maximalGeodesic_mfderiv p v t,
      maximalGeodesic_congr hΦ.apply_eq (hΦ.mfderiv_apply v) t]
    have hneg : t ∈ geodesicInterval I M p ((-1 : ℝ) • v) := by
      rwa [neg_one_smul, hΦ.geodesicInterval_neg_eq]
    simpa [neg_one_smul] using maximalGeodesic_smul (I := I) (M := M) hneg
  · have hnt : -t ∉ geodesicInterval I M p v := by
      rwa [hΦ.neg_mem_geodesicInterval_iff]
    rw [maximalGeodesic_def, maximalGeodesic_def,
      maximalIntegralCurve_eq_of_not_mem (by rwa [maximalIntegralCurveInterval_geodesicSpray]),
      maximalIntegralCurve_eq_of_not_mem (by rwa [maximalIntegralCurveInterval_geodesicSpray]),
      hΦ.apply_eq]

/-- A geodesic symmetry at `p` intertwines the exponential map at `p` with negation on `T_p M`:
`Φ (exp_p v) = exp_p (-v)`. -/
theorem apply_riemannianExp (hΦ : IsGeodesicSymmetryAt Φ p) (v : TangentSpace I p) :
    Φ (riemannianExp I M p v) = riemannianExp I M p (-v) := by
  rw [← Φ.riemannianExp_mfderiv p v]
  exact riemannianExp_congr hΦ.apply_eq (hΦ.mfderiv_apply v)

/-- A geodesic symmetry at `γ a` reflects an all-time geodesic `γ` about parameter `a`:
`Φ (γ t) = γ (2 * a - t)`. -/
theorem apply_isGeodesicCurve {γ : ℝ → M} {a : ℝ} (hΦ : IsGeodesicSymmetryAt Φ (γ a))
    (hγ : IsGeodesicCurve I γ) (t : ℝ) : Φ (γ t) = γ (2 * a - t) := by
  have hgeo : IsGeodesicCurveOnFrom I (γ ∘ fun u : ℝ ↦ u + a) univ (γ a)
      (curveVelocity I γ a) := by
    refine ⟨?_, mem_univ 0, ?_⟩
    · simpa [one_mul, isGeodesicCurveOn_univ] using hγ.comp_affine 1 a
    · have hd : HasDerivAt (fun u : ℝ ↦ u + a) 1 0 := (hasDerivAt_id (0 : ℝ)).add_const a
      have hγa : MDifferentiableAt 𝓘(ℝ, ℝ) I γ (0 + a) := by
        simpa only [zero_add] using
          (mdifferentiableOn_univ.1 (isGeodesicCurveOn_univ.2 hγ).mdifferentiableOn) a
      rw [curveVelocityWithin_univ, curveVelocity_comp hd hγa, one_smul, Function.comp_apply]
      exact congrArg (fun u : ℝ ↦ TotalSpace.mk' E (γ u) (curveVelocity I γ u)) (zero_add a)
  have hmax : ∀ u : ℝ,
      γ (u + a) = maximalGeodesic I M (γ a) (curveVelocity I γ a) u := fun u ↦
    (hgeo.eq_maximalGeodesic_of_univ u).symm
  calc
    Φ (γ t) = Φ (γ ((t - a) + a)) := by rw [sub_add_cancel]
    _ = Φ (maximalGeodesic I M (γ a) (curveVelocity I γ a) (t - a)) := by rw [hmax]
    _ = maximalGeodesic I M (γ a) (curveVelocity I γ a) (-(t - a)) :=
      hΦ.apply_maximalGeodesic _ _
    _ = γ (-(t - a) + a) := (hmax _).symm
    _ = γ (2 * a - t) := by ring_nf

/-- **Geodesic translation by a transvection.** If `Φ` is a geodesic symmetry at `γ a` and `Ψ` is
a geodesic symmetry at `γ b` along an all-time geodesic `γ`, then `Ψ * Φ` translates `γ` by
`2 * (b - a)`. -/
theorem mul_apply_isGeodesicCurve {γ : ℝ → M} {a b : ℝ}
    (hΦ : IsGeodesicSymmetryAt Φ (γ a)) (hΨ : IsGeodesicSymmetryAt Ψ (γ b))
    (hγ : IsGeodesicCurve I γ) (t : ℝ) : (Ψ * Φ) (γ t) = γ (t + 2 * (b - a)) := by
  rw [RiemannianIsometry.mul_apply, hΦ.apply_isGeodesicCurve hγ, hΨ.apply_isGeodesicCurve hγ]
  ring_nf

/-- **Action of a geodesic symmetry on parallel fields along a geodesic.** If `Φ` is a geodesic
symmetry at `γ a` and `V` is a parallel tangent field along an all-time geodesic `γ`, then `dΦ`
maps `(γ t, V t)` to `(γ (2 * a - t), -V (2 * a - t))`. -/
theorem tangentMap_of_alongCurve_eq_zero {γ : ℝ → M} {a : ℝ}
    (hΦ : IsGeodesicSymmetryAt Φ (γ a)) (hγ : IsGeodesicCurve I γ)
    {V : ∀ r, TangentSpace I (γ r)}
    (hV : ∀ t, DifferentiableAt ℝ (sectionCoord ℝ (F := E) γ V (γ t)) t)
    (hV₀ : ∀ t, alongCurve (leviCivitaConnection I M) γ V t = 0) (t : ℝ) :
    tangentMap I I Φ (TotalSpace.mk' E (γ t) (V t)) =
      TotalSpace.mk' E (γ (2 * a - t)) (-V (2 * a - t)) := by
  have hγd : MDifferentiable 𝓘(ℝ, ℝ) I γ :=
    mdifferentiableOn_univ.1 (isGeodesicCurveOn_univ.2 hγ).mdifferentiableOn
  have hΦγ : Φ ∘ γ = fun r ↦ γ (2 * a - r) :=
    funext fun r ↦ hΦ.apply_isGeodesicCurve hγ r
  have hdiff₁ : ∀ r, DifferentiableAt ℝ
      (sectionCoord ℝ (F := E) (Φ ∘ γ) (fun s ↦ mfderiv I I Φ (γ s) (V s))
        ((Φ ∘ γ) r)) r := by
    intro r
    rw [← differentiableWithinAt_univ]
    exact Φ.toDiffeomorph.contMDiff.contMDiffAt.differentiableWithinAt_sectionCoord_mfderiv
      (by simp) (hγd r).mdifferentiableWithinAt (hV r).differentiableWithinAt
  have hdiff₂ : ∀ r, DifferentiableAt ℝ
      (sectionCoord ℝ (F := E) (fun s ↦ γ (2 * a - s)) (fun s ↦ -V (2 * a - s))
        (γ (2 * a - r))) r := by
    intro r
    have hsc : sectionCoord ℝ (F := E) (fun s ↦ γ (2 * a - s)) (fun s ↦ -V (2 * a - s))
        (γ (2 * a - r)) =
        fun s ↦ -(sectionCoord ℝ (F := E) γ V (γ (2 * a - r)) (2 * a - s)) := by
      funext s
      simp [sectionCoord_apply]
    rw [hsc]
    exact ((hV (2 * a - r)).comp r ((differentiableAt_const (2 * a)).sub differentiableAt_id)).neg
  have hpar₁ : ∀ r, alongCurve (leviCivitaConnection I M) (Φ ∘ γ)
      (fun s ↦ mfderiv I I Φ (γ s) (V s)) r = 0 := fun r ↦ by
    rw [← Φ.isLocalRiemannianIsometry.mfderiv_alongCurve (hγd r) (hV r),
      hV₀ r, map_zero]
  have hpar₂ : ∀ r, alongCurve (leviCivitaConnection I M) (fun s ↦ γ (2 * a - s))
      (fun s ↦ -V (2 * a - s)) r = 0 := fun r ↦ by
    have hneg : (fun s ↦ -V (2 * a - s)) = fun s ↦ (-1 : ℝ) • V (2 * a - s) := by
      funext s
      exact (neg_one_smul ℝ _).symm
    rw [hneg, alongCurve_const_smul, alongCurve_comp_const_sub, hV₀ (2 * a - r), neg_zero,
      smul_zero]
  have hinit : TotalSpace.mk' E ((Φ ∘ γ) a) (mfderiv I I Φ (γ a) (V a)) =
      TotalSpace.mk' E (γ (2 * a - a)) (-V (2 * a - a)) := by
    have h2a : 2 * a - a = a := by ring
    refine TotalSpace.ext ?_ ?_
    · rw [Function.comp_apply, hΦ.apply_eq, h2a]
    · rw [h2a]
      exact heq_of_eq (hΦ.mfderiv_apply (V a))
  exact (isMetricCompatible_leviCivitaConnection (I := I) (M := M)
    ).totalSpace_eq_of_alongCurve_eq_zero isPreconnected_univ hΦγ
    (fun r _ ↦ (Φ.mdifferentiableAt (γ r)).comp r (hγd r))
    (fun r _ ↦ hdiff₁ r) (fun r _ ↦ hdiff₂ r) (fun r _ ↦ hpar₁ r) (fun r _ ↦ hpar₂ r)
    (mem_univ a) (mem_univ t) hinit

/-- **Transvections realize parallel transport along geodesics.** If `Φ` is a geodesic symmetry at
`γ a`, `Ψ` is a geodesic symmetry at `γ b`, and `V` is a parallel tangent field along an all-time
geodesic `γ`, then the differential of the transvection `Ψ * Φ` maps `(γ t, V t)` to
`(γ (t + 2 * (b - a)), V (t + 2 * (b - a)))`. -/
theorem tangentMap_mul_of_alongCurve_eq_zero {γ : ℝ → M} {a b : ℝ}
    (hΦ : IsGeodesicSymmetryAt Φ (γ a)) (hΨ : IsGeodesicSymmetryAt Ψ (γ b))
    (hγ : IsGeodesicCurve I γ) {V : ∀ r, TangentSpace I (γ r)}
    (hV : ∀ t, DifferentiableAt ℝ (sectionCoord ℝ (F := E) γ V (γ t)) t)
    (hV₀ : ∀ t, alongCurve (leviCivitaConnection I M) γ V t = 0) (t : ℝ) :
    tangentMap I I (Ψ * Φ) (TotalSpace.mk' E (γ t) (V t)) =
      TotalSpace.mk' E (γ (t + 2 * (b - a))) (V (t + 2 * (b - a))) := by
  have hnegV : ∀ r, DifferentiableAt ℝ
      (sectionCoord ℝ (F := E) γ (fun s ↦ -V s) (γ r)) r := fun r ↦ by
    have hsc : sectionCoord ℝ (F := E) γ (fun s ↦ -V s) (γ r) =
        fun s ↦ -(sectionCoord ℝ (F := E) γ V (γ r) s) := by
      funext s
      simp [sectionCoord_apply]
    rw [hsc]
    exact (hV r).neg
  have hnegV₀ :
      ∀ r, alongCurve (leviCivitaConnection I M) γ (fun s ↦ -V s) r = 0 := fun r ↦ by
    have hneg : (fun s ↦ -V s) = fun s ↦ (-1 : ℝ) • V s := by
      funext s
      exact (neg_one_smul ℝ _).symm
    rw [hneg, alongCurve_const_smul, hV₀ r, smul_zero]
  rw [RiemannianIsometry.coe_mul,
    tangentMap_comp_at _ (Ψ.mdifferentiableAt _) (Φ.mdifferentiableAt _),
    hΦ.tangentMap_of_alongCurve_eq_zero hγ hV hV₀ t,
    hΨ.tangentMap_of_alongCurve_eq_zero hγ hnegV hnegV₀ (2 * a - t)]
  have hparam : 2 * b - (2 * a - t) = t + 2 * (b - a) := by ring
  simp only [neg_neg]
  exact congrArg (fun r ↦ TotalSpace.mk' E (γ r) (V r)) hparam

end IsGeodesicSymmetryAt

end Smooth

/-! ### Riemannian symmetric spaces -/

/-- A Riemannian manifold `M` modelled on `I` is a **Riemannian symmetric space** if every point
`p : M` admits a global geodesic symmetry in `Isom I M`. -/
class IsRiemannianSymmetricSpace {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {H : Type*} [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
    (M : Type*) [TopologicalSpace M] [ChartedSpace H M]
    [RiemannianBundle (fun x : M ↦ TangentSpace I x)] : Prop where
  /-- Every point admits a global geodesic symmetry. -/
  exists_isGeodesicSymmetryAt (p : M) : ∃ Φ : Isom I M, IsGeodesicSymmetryAt Φ p

variable (I M) in
/-- A chosen geodesic symmetry `s_p ∈ Isom(M)` at `p : M` on a Riemannian symmetric space. On a
preconnected smooth Riemannian manifold this is the unique geodesic symmetry at `p`. -/
def geodesicSymmetry [IsRiemannianSymmetricSpace I M] (p : M) : Isom I M :=
  Classical.choose (IsRiemannianSymmetricSpace.exists_isGeodesicSymmetryAt (I := I) p)

/-- The chosen geodesic symmetry at `p` is a geodesic symmetry at `p`. -/
theorem isGeodesicSymmetryAt_geodesicSymmetry [IsRiemannianSymmetricSpace I M] (p : M) :
    IsGeodesicSymmetryAt (geodesicSymmetry I M p) p :=
  Classical.choose_spec (IsRiemannianSymmetricSpace.exists_isGeodesicSymmetryAt (I := I) p)

/-- The geodesic symmetry at `p` fixes `p`. -/
@[simp]
theorem geodesicSymmetry_apply_self [IsRiemannianSymmetricSpace I M] (p : M) :
    geodesicSymmetry I M p p = p :=
  (isGeodesicSymmetryAt_geodesicSymmetry (I := I) p).apply_eq

/-- The geodesic symmetry at `p` is an involution in `Isom I M`. -/
@[simp]
theorem geodesicSymmetry_mul_self [IsRiemannianSymmetricSpace I M] (p : M) :
    geodesicSymmetry I M p * geodesicSymmetry I M p = 1 :=
  (isGeodesicSymmetryAt_geodesicSymmetry (I := I) p).mul_self

/-- Applying the geodesic symmetry at `p` twice is the identity on `M`. -/
@[simp]
theorem geodesicSymmetry_apply_apply [IsRiemannianSymmetricSpace I M] (p x : M) :
    geodesicSymmetry I M p (geodesicSymmetry I M p x) = x :=
  (isGeodesicSymmetryAt_geodesicSymmetry (I := I) p).apply_apply x

/-- The geodesic symmetry at `p` is its own inverse in `Isom I M`. -/
@[simp]
theorem geodesicSymmetry_inv [IsRiemannianSymmetricSpace I M] (p : M) :
    (geodesicSymmetry I M p)⁻¹ = geodesicSymmetry I M p :=
  (isGeodesicSymmetryAt_geodesicSymmetry (I := I) p).inv_eq

/-- The differential of the geodesic symmetry at `p` is `-id`. -/
@[simp]
theorem mfderiv_geodesicSymmetry [IsRiemannianSymmetricSpace I M] (p : M) :
    mfderiv I I (geodesicSymmetry I M p) p = -ContinuousLinearMap.id ℝ (TangentSpace I p) :=
  (isGeodesicSymmetryAt_geodesicSymmetry (I := I) p).mfderiv_eq

/-- The differential of the geodesic symmetry at `p` negates every tangent vector at `p`. -/
theorem mfderiv_geodesicSymmetry_apply [IsRiemannianSymmetricSpace I M] (p : M)
    (v : TangentSpace I p) : mfderiv I I (geodesicSymmetry I M p) p v = -v :=
  (isGeodesicSymmetryAt_geodesicSymmetry (I := I) p).mfderiv_apply v

/-- A homogeneous Riemannian manifold admitting a geodesic symmetry at a single point is a
Riemannian symmetric space. -/
theorem isRiemannianSymmetricSpace_of_isPretransitive [MulAction.IsPretransitive (Isom I M) M]
    {p₀ : M} {Φ : Isom I M} (hΦ : IsGeodesicSymmetryAt Φ p₀) :
    IsRiemannianSymmetricSpace I M where
  exists_isGeodesicSymmetryAt p := by
    obtain ⟨Ψ, rfl⟩ := MulAction.exists_smul_eq (Isom I M) p₀ p
    exact ⟨Ψ * Φ * Ψ⁻¹, hΦ.conj_isom Ψ⟩

/-- A Riemannian manifold isometric to a Riemannian symmetric space is a Riemannian symmetric
space. -/
theorem RiemannianIsometry.isRiemannianSymmetricSpace
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {G : Type*} [TopologicalSpace G] {J : ModelWithCorners ℝ F G}
    {N : Type*} [TopologicalSpace N] [ChartedSpace G N]
    [RiemannianBundle (fun y : N ↦ TangentSpace J y)]
    (Ψ : RiemannianIsometry I J M N) [IsRiemannianSymmetricSpace I M] :
    IsRiemannianSymmetricSpace J N where
  exists_isGeodesicSymmetryAt q := by
    obtain ⟨Φ, hΦ⟩ :=
      IsRiemannianSymmetricSpace.exists_isGeodesicSymmetryAt (I := I) (Ψ.symm q)
    refine ⟨Ψ.symm.trans (Φ.trans Ψ), ?_⟩
    simpa [Ψ.apply_symm_apply q] using hΦ.conj Ψ

/-- Riemannian isometric manifolds are symmetric spaces together. -/
theorem RiemannianIsometry.isRiemannianSymmetricSpace_iff
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {G : Type*} [TopologicalSpace G] {J : ModelWithCorners ℝ F G}
    {N : Type*} [TopologicalSpace N] [ChartedSpace G N]
    [RiemannianBundle (fun y : N ↦ TangentSpace J y)]
    (Ψ : RiemannianIsometry I J M N) :
    IsRiemannianSymmetricSpace I M ↔ IsRiemannianSymmetricSpace J N :=
  ⟨fun _ ↦ Ψ.isRiemannianSymmetricSpace, fun _ ↦ Ψ.symm.isRiemannianSymmetricSpace⟩

/-- A product of Riemannian symmetric spaces is a Riemannian symmetric space for the product
metric. -/
instance instIsRiemannianSymmetricSpaceProd
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {G : Type*} [TopologicalSpace G] {J : ModelWithCorners ℝ F G}
    {N : Type*} [TopologicalSpace N] [ChartedSpace G N]
    [RiemannianBundle (fun y : N ↦ TangentSpace J y)]
    [IsRiemannianSymmetricSpace I M] [IsRiemannianSymmetricSpace J N] :
    IsRiemannianSymmetricSpace (I.prod J) (M × N) where
  exists_isGeodesicSymmetryAt p := by
    obtain ⟨Φ, hΦ⟩ := IsRiemannianSymmetricSpace.exists_isGeodesicSymmetryAt (I := I) p.1
    obtain ⟨Ψ, hΨ⟩ := IsRiemannianSymmetricSpace.exists_isGeodesicSymmetryAt (I := J) p.2
    exact ⟨Φ.prodCongr Ψ, hΦ.prodCongr hΨ⟩

/-! ### Symmetry and transvection subgroups -/

variable (I M) in
/-- The subgroup of `Isom I M` generated by all geodesic symmetries of `M`. -/
def symmetrySubgroup : Subgroup (Isom I M) :=
  Subgroup.closure {Φ : Isom I M | ∃ p : M, IsGeodesicSymmetryAt Φ p}

variable (I M) in
/-- The **transvection group** of `M`: the subgroup of `Isom I M` generated by products `Φ * Ψ` of
pairs of geodesic symmetries. -/
def transvectionSubgroup : Subgroup (Isom I M) :=
  Subgroup.closure
    {Θ : Isom I M | ∃ p q : M, ∃ Φ Ψ : Isom I M,
      IsGeodesicSymmetryAt Φ p ∧ IsGeodesicSymmetryAt Ψ q ∧ Θ = Φ * Ψ}

/-- Any geodesic symmetry belongs to `symmetrySubgroup`. -/
theorem IsGeodesicSymmetryAt.mem_symmetrySubgroup {Φ : Isom I M} {p : M}
    (hΦ : IsGeodesicSymmetryAt Φ p) : Φ ∈ symmetrySubgroup I M :=
  Subgroup.subset_closure ⟨p, hΦ⟩

/-- Any product of two geodesic symmetries belongs to `transvectionSubgroup`. -/
theorem IsGeodesicSymmetryAt.mul_mem_transvectionSubgroup {Φ Ψ : Isom I M} {p q : M}
    (hΦ : IsGeodesicSymmetryAt Φ p) (hΨ : IsGeodesicSymmetryAt Ψ q) :
    Φ * Ψ ∈ transvectionSubgroup I M :=
  Subgroup.subset_closure ⟨p, q, Φ, Ψ, hΦ, hΨ, rfl⟩

/-- The chosen geodesic symmetry at `p` belongs to `symmetrySubgroup`. -/
theorem geodesicSymmetry_mem_symmetrySubgroup [IsRiemannianSymmetricSpace I M] (p : M) :
    geodesicSymmetry I M p ∈ symmetrySubgroup I M :=
  (isGeodesicSymmetryAt_geodesicSymmetry (I := I) p).mem_symmetrySubgroup

/-- The product of two chosen geodesic symmetries belongs to `transvectionSubgroup`. -/
theorem geodesicSymmetry_mul_mem_transvectionSubgroup [IsRiemannianSymmetricSpace I M]
    (p q : M) :
    geodesicSymmetry I M p * geodesicSymmetry I M q ∈ transvectionSubgroup I M :=
  (isGeodesicSymmetryAt_geodesicSymmetry (I := I) p).mul_mem_transvectionSubgroup
    (isGeodesicSymmetryAt_geodesicSymmetry (I := I) q)

/-- Every transvection lies in the subgroup generated by geodesic symmetries. -/
theorem transvectionSubgroup_le_symmetrySubgroup :
    transvectionSubgroup I M ≤ symmetrySubgroup I M := by
  refine (Subgroup.closure_le _).2 ?_
  rintro _ ⟨p, q, Φ, Ψ, hΦ, hΨ, rfl⟩
  exact mul_mem hΦ.mem_symmetrySubgroup hΨ.mem_symmetrySubgroup

/-- The subgroup generated by geodesic symmetries is normal in `Isom I M`. -/
instance instNormalSymmetrySubgroup : (symmetrySubgroup I M).Normal :=
  Subgroup.closure_normal_of_forall_conj_mem fun Ψ _ ⟨p, hΦ⟩ ↦ ⟨Ψ p, hΦ.conj_isom Ψ⟩

/-- The transvection group is normal in `Isom I M`. -/
instance instNormalTransvectionSubgroup : (transvectionSubgroup I M).Normal := by
  refine Subgroup.closure_normal_of_forall_conj_mem ?_
  rintro Ψ _ ⟨p, q, Φ₁, Φ₂, h₁, h₂, rfl⟩
  exact ⟨Ψ p, Ψ q, Ψ * Φ₁ * Ψ⁻¹, Ψ * Φ₂ * Ψ⁻¹,
    h₁.conj_isom Ψ, h₂.conj_isom Ψ, by group⟩

/-! ### Main theorems for Riemannian symmetric spaces -/

section SymmetricSpaceTheorems

variable [FiniteDimensional ℝ E] [IsManifold I ∞ M] [T2Space M]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M ↦ TangentSpace I x)]

/-- **Every Riemannian symmetric space has parallel curvature (`∇R = 0`),** hence is locally
symmetric. -/
theorem hasParallelCurvature_leviCivitaConnection_of_isRiemannianSymmetricSpace
    [IsRiemannianSymmetricSpace I M] :
    (leviCivitaConnection I M).HasParallelCurvature :=
  (hasParallelCurvature_iff _).2 fun p ↦
    (isGeodesicSymmetryAt_geodesicSymmetry (I := I) p).derivCurvatureTensor_eq_zero

variable [I.Boundaryless]

/-- On a preconnected smooth Riemannian symmetric space, any geodesic symmetry at `p` coincides
with `geodesicSymmetry I M p`. -/
theorem IsGeodesicSymmetryAt.eq_geodesicSymmetry [PreconnectedSpace M]
    [IsRiemannianSymmetricSpace I M] {Φ : Isom I M} {p : M}
    (hΦ : IsGeodesicSymmetryAt Φ p) : Φ = geodesicSymmetry I M p :=
  hΦ.eq (isGeodesicSymmetryAt_geodesicSymmetry (I := I) p)

/-- On a preconnected smooth Riemannian symmetric space, conjugation by `Ψ ∈ Isom I M` sends the
geodesic symmetry at `p` to the geodesic symmetry at `Ψ p`. -/
theorem geodesicSymmetry_conj [PreconnectedSpace M] [IsRiemannianSymmetricSpace I M]
    (Ψ : Isom I M) (p : M) :
    Ψ * geodesicSymmetry I M p * Ψ⁻¹ = geodesicSymmetry I M (Ψ p) :=
  ((isGeodesicSymmetryAt_geodesicSymmetry (I := I) p).conj_isom Ψ).eq_geodesicSymmetry

/-- **Maximal geodesic intervals are all of `ℝ` on a Riemannian symmetric space.** For every base
point `p` and initial velocity `v`, `geodesicInterval I M p v = Set.univ`. -/
theorem geodesicInterval_eq_univ_of_isRiemannianSymmetricSpace
    [IsRiemannianSymmetricSpace I M] (p : M) (v : TangentSpace I p) :
    geodesicInterval I M p v = univ := by
  -- If `geodesicInterval I M p v` had a finite supremum `b > 0`, reflecting the geodesic at
  -- `t₀ ∈ (b / 2, b)` via the geodesic symmetry at `γ(t₀)` would give `2 * t₀ ∈ J`,
  -- contradicting `2 * t₀ > b`.
  have hsym : ∀ t : ℝ, -t ∈ geodesicInterval I M p v ↔ t ∈ geodesicInterval I M p v :=
    fun _ ↦ (isGeodesicSymmetryAt_geodesicSymmetry (I := I) p).neg_mem_geodesicInterval_iff
  have hup : ¬ BddAbove (geodesicInterval I M p v) := by
    intro hbdd
    have hlub := isLUB_csSup ⟨0, zero_mem_geodesicInterval⟩ hbdd
    obtain ⟨a, ha, hb0, hsub⟩ := exists_Ioo_subset_geodesicInterval_of_isLUB hlub
    let b : ℝ := sSup (geodesicInterval I M p v)
    let t₀ : ℝ := max (3 * b / 4) ((a + b) / 2)
    have ht₀_gt_a : a < t₀ := lt_of_lt_of_le (by linarith) (le_max_right _ _)
    have ht₀_lt_b : t₀ < b := max_lt (by linarith) (by linarith)
    have ht₀_mem : t₀ ∈ geodesicInterval I M p v := hsub ⟨ht₀_gt_a, ht₀_lt_b⟩
    have hneg_mem : -t₀ ∈ geodesicInterval I M (maximalGeodesic I M p v t₀)
        (curveVelocityWithin I (maximalGeodesic I M p v) (geodesicInterval I M p v) t₀) := by
      rw [mem_geodesicInterval_maximalGeodesic_iff ht₀_mem, add_neg_cancel]
      exact zero_mem_geodesicInterval
    have hpos_mem : t₀ ∈ geodesicInterval I M (maximalGeodesic I M p v t₀)
        (curveVelocityWithin I (maximalGeodesic I M p v) (geodesicInterval I M p v) t₀) :=
      (isGeodesicSymmetryAt_geodesicSymmetry (I := I) _).neg_mem_geodesicInterval_iff.1 hneg_mem
    rw [mem_geodesicInterval_maximalGeodesic_iff ht₀_mem] at hpos_mem
    have hle : t₀ + t₀ ≤ b := hlub.1 hpos_mem
    have hgt : b < t₀ + t₀ := by
      have : 3 * b / 4 ≤ t₀ := le_max_left _ _
      linarith
    exact not_lt_of_ge hle hgt
  have hlow : ¬ BddBelow (geodesicInterval I M p v) := by
    rintro ⟨c, hc⟩
    refine hup ⟨-c, fun t ht ↦ ?_⟩
    have hle : c ≤ -t := hc ((hsym t).2 ht)
    linarith
  rw [← maximalIntegralCurveInterval_geodesicSpray] at hup hlow ⊢
  exact maximalIntegralCurveInterval_eq_univ_of_not_bddAbove_not_bddBelow hup hlow

/-- **Every Riemannian symmetric space is geodesically complete.** -/
theorem isGeodesicallyCompleteAt_of_isRiemannianSymmetricSpace
    [IsRiemannianSymmetricSpace I M] (p : M) :
    IsGeodesicallyCompleteAt I M p :=
  isGeodesicallyCompleteAt_iff_forall_one_mem_geodesicInterval.2 fun v ↦ by
    rw [geodesicInterval_eq_univ_of_isRiemannianSymmetricSpace p v]
    exact mem_univ 1

/-- The geodesic symmetry at `p` intertwines the exponential map at `p` with negation on `T_p M`. -/
@[simp]
theorem geodesicSymmetry_apply_riemannianExp [IsRiemannianSymmetricSpace I M] (p : M)
    (v : TangentSpace I p) :
    geodesicSymmetry I M p (riemannianExp I M p v) = riemannianExp I M p (-v) :=
  (isGeodesicSymmetryAt_geodesicSymmetry (I := I) p).apply_riemannianExp v

/-- The exponential map of a Riemannian symmetric space is defined on the whole tangent space at
every point. -/
theorem expDomain_eq_univ_of_isRiemannianSymmetricSpace [IsRiemannianSymmetricSpace I M] (p : M) :
    expDomain I M p = univ :=
  expDomain_eq_univ_iff.2 (isGeodesicallyCompleteAt_of_isRiemannianSymmetricSpace p)

/-- On a Riemannian symmetric space, every maximal geodesic is an all-time geodesic. -/
theorem isGeodesicCurve_maximalGeodesic_of_isRiemannianSymmetricSpace
    [IsRiemannianSymmetricSpace I M] (p : M) (v : TangentSpace I p) :
    IsGeodesicCurve I (maximalGeodesic I M p v) := by
  rw [← isGeodesicCurveOn_univ, ← geodesicInterval_eq_univ_of_isRiemannianSymmetricSpace p v]
  exact (isGeodesicCurveOnFrom_maximalGeodesic (I := I) (M := M) p v).isGeodesicCurveOn

/-- On a preconnected smooth Riemannian symmetric space, any two points `p` and `q` are swapped by
the geodesic symmetry at the midpoint of a connecting geodesic. -/
theorem exists_geodesicSymmetry_apply_eq [PreconnectedSpace M] [IsRiemannianSymmetricSpace I M]
    (p q : M) : ∃ m : M, geodesicSymmetry I M m p = q := by
  have := Manifold.locallyCompact_of_finiteDimensional (M := M) I
  have := IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle (IB := I) (n := ∞)
    (F := E) (V := fun x : M ↦ TangentSpace I x)
  let : MetricSpace M := MetricSpace.ofRiemannianMetric I M
  obtain ⟨v, hvq, -⟩ := exists_riemannianExp_eq_and_norm_eq_dist
    (expDomain_eq_univ_of_isRiemannianSymmetricSpace (I := I) p) q
  let γ : ℝ → M := maximalGeodesic I M p v
  have hγ : IsGeodesicCurve I γ :=
    isGeodesicCurve_maximalGeodesic_of_isRiemannianSymmetricSpace p v
  refine ⟨γ (1 / 2), ?_⟩
  have hswap := (isGeodesicSymmetryAt_geodesicSymmetry (I := I) (γ (1 / 2))).apply_isGeodesicCurve
    hγ 0
  have h0 : γ 0 = p := maximalGeodesic_zero (I := I) (M := M) p v
  have h1 : γ 1 = q := by
    rw [riemannianExp_def] at hvq
    exact hvq
  have h2 : 2 * ((1 : ℝ) / 2) - 0 = 1 := by norm_num
  rw [h0, h2, h1] at hswap
  exact hswap

/-- **Transitivity of the transvection group.** On a preconnected smooth Riemannian symmetric space,
the subgroup generated by products of pairs of geodesic symmetries acts transitively. -/
theorem isPretransitive_transvectionSubgroup [PreconnectedSpace M]
    [IsRiemannianSymmetricSpace I M] :
    MulAction.IsPretransitive (transvectionSubgroup I M) M where
  exists_smul_eq p q := by
    obtain ⟨m, hm⟩ := exists_geodesicSymmetry_apply_eq (I := I) p q
    refine ⟨⟨geodesicSymmetry I M m * geodesicSymmetry I M p,
      geodesicSymmetry_mul_mem_transvectionSubgroup (I := I) m p⟩, ?_⟩
    rw [Subgroup.smul_def, RiemannianIsometry.smul_def, RiemannianIsometry.mul_apply,
      geodesicSymmetry_apply_self, hm]

/-- On a preconnected smooth Riemannian symmetric space, the subgroup generated by geodesic
symmetries acts transitively. -/
theorem isPretransitive_symmetrySubgroup [PreconnectedSpace M] [IsRiemannianSymmetricSpace I M] :
    MulAction.IsPretransitive (symmetrySubgroup I M) M where
  exists_smul_eq p q := by
    obtain ⟨⟨Θ, hΘ⟩, hΘp⟩ :=
      (isPretransitive_transvectionSubgroup (I := I) (M := M)).exists_smul_eq p q
    exact ⟨⟨Θ, transvectionSubgroup_le_symmetrySubgroup hΘ⟩, hΘp⟩

/-- **Every connected Riemannian symmetric space is homogeneous:** its full isometry group acts
transitively. -/
theorem isPretransitive_isom_of_isRiemannianSymmetricSpace [PreconnectedSpace M]
    [IsRiemannianSymmetricSpace I M] :
    MulAction.IsPretransitive (Isom I M) M where
  exists_smul_eq p q := by
    obtain ⟨⟨Θ, _⟩, hΘp⟩ :=
      (isPretransitive_transvectionSubgroup (I := I) (M := M)).exists_smul_eq p q
    exact ⟨Θ, hΘp⟩

end SymmetricSpaceTheorems

section AmbientMetric

variable {M : Type*} [MetricSpace M] [ChartedSpace H M]
  [FiniteDimensional ℝ E] [I.Boundaryless] [IsManifold I ∞ M]
  [RiemannianBundle (fun x : M ↦ TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M ↦ TangentSpace I x)]
  [IsRiemannianManifold I M]

/-- A Riemannian symmetric space carrying a compatible Riemannian metric space structure is
proper. -/
theorem properSpace_of_isRiemannianSymmetricSpace [IsRiemannianSymmetricSpace I M] :
    ProperSpace M := by
  rcases isEmpty_or_nonempty M with _ | ⟨⟨p⟩⟩
  · infer_instance
  · have := IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle (IB := I) (n := ∞)
      (F := E) (V := fun x : M ↦ TangentSpace I x)
    exact properSpace_of_expDomain_eq_univ
      (expDomain_eq_univ_of_isRiemannianSymmetricSpace (I := I) p)

/-- A Riemannian symmetric space carrying a compatible Riemannian metric space structure is
metrically complete. -/
theorem completeSpace_of_isRiemannianSymmetricSpace [IsRiemannianSymmetricSpace I M] :
    CompleteSpace M := by
  rcases isEmpty_or_nonempty M with _ | ⟨⟨p⟩⟩
  · infer_instance
  · exact (completeSpace_iff_isGeodesicallyCompleteAt (I := I) p).2
      (isGeodesicallyCompleteAt_of_isRiemannianSymmetricSpace p)

end AmbientMetric

section IntrinsicMetric

variable {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [T3Space M] [PreconnectedSpace M]
  [FiniteDimensional ℝ E] [I.Boundaryless] [IsManifold I ∞ M]
  [RiemannianBundle (fun x : M ↦ TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M ↦ TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M ↦ TangentSpace I x)]

/-- **Every connected Riemannian symmetric space is metrically complete** for its intrinsic
Riemannian distance `MetricSpace.ofRiemannianMetric`. -/
theorem completeSpace_ofRiemannianMetric_of_isRiemannianSymmetricSpace
    [IsRiemannianSymmetricSpace I M] :
    letI : MetricSpace M := MetricSpace.ofRiemannianMetric I M
    CompleteSpace M := by
  let : MetricSpace M := MetricSpace.ofRiemannianMetric I M
  exact completeSpace_of_isRiemannianSymmetricSpace (I := I)

end IntrinsicMetric

