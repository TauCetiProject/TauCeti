module

public import TauCeti.Geometry.Manifold.DeRham.HomologyPeriod
public import TauCeti.Geometry.Manifold.DifferentialForm.AddCircle
public import Mathlib.Topology.Covering.FundamentalGroupCircle
public import TauCeti.AlgebraicTopology.Singular.AddCircle
public import TauCeti.AlgebraicTopology.Cohomology.AddCircle

/-!
# The periods of the time form of a circle

For a positive real `p`, the time form `dt_p` of the circle `AddCircle p = ℝ / pℤ`
(`AddCircle.timeForm p`) integrates to `p` along one circuit. Since the fundamental group of the
circle is generated by that circuit, the period of `dt_p` along a loop is `p` times its winding
number (`AddCircle.periodHom_timeForm`). In particular the circuit class
`AddCircle.fundamentalClass p` has period `p`
(`AddCircle.homologyPeriodHom_timeForm_fundamentalClass`). Since the circuit class generates the
first singular homology group `H₁(ℝ / pℤ; ℤ)`, the period of `dt_p` on a class is `p` times its
winding number (`AddCircle.homologyPeriodHom_timeForm`), an integer multiple of `p`.

The winding number of a class is its value on the angular class `θ_p ∈ H¹(ℝ / pℤ; ℤ)`
(`AddCircle.angularClass`). So `dt_p` integrates to `p ⟨θ_p, c⟩` over every class `c`
(`AddCircle.homologyPeriodHom_timeForm_eq_singularKronecker_angularClass_mul`): the angular class
is the integral singular class of `dt_p / p`, and for `p = 1` that of the angle form `ds` of
`(ℝ / ℤ)_s`.

## Main results

* `AddCircle.periodHom_timeForm`: the period of `dt_p` along a loop class is `windingNumber · p`.
* `AddCircle.homologyPeriodHom_timeForm_fundamentalClass`: the circuit class has period `p`.
* `AddCircle.homologyPeriodHom_timeForm`: the period of `dt_p` on a class of `H₁(ℝ / pℤ; ℤ)` is
  `p` times its winding number.
* `AddCircle.exists_homologyPeriodHom_timeForm_eq_intCast_mul`: the periods of `dt_p` on
  `H₁(ℝ / pℤ; ℤ)` lie in `pℤ`.
* `AddCircle.homologyPeriodHom_timeForm_eq_singularKronecker_angularClass_mul`: the angular class
  is the class of `dt_p / p`.
-/

public section

noncomputable section

open TauCeti TauCeti.HurewiczOne
open scoped Manifold ContDiff

namespace AddCircle

variable {p : ℝ} [Fact (0 < p)]

/-- **The periods of the time form are the winding numbers.** Along a loop class `g` based at the
image of a real number `x`, the time form `dt_p` of `ℝ / pℤ` integrates to `p` times the winding
number of `g`. -/
theorem periodHom_timeForm (x : ℝ) (g : FundamentalGroup (AddCircle p) (x : AddCircle p)) :
    periodHom (timeForm p).val (x : AddCircle p) (Additive.ofMul g) = windingNumber g * p := by
  -- `g` is the class of the loop winding `windingNumber g` times.
  have hg : g = FundamentalGroup.fromPath (.mk (zsmulLoop p x (windingNumber g))) := by
    apply (windingNumberIso (x : AddCircle p)).injective
    apply Multiplicative.toAdd.injective
    exact (windingNumber_zsmulLoop x (windingNumber g)).symm
  generalize windingNumber g = n at hg ⊢
  subst hg
  have hsmooth : ContMDiff 𝓘(ℝ) 𝓘(ℝ) 1 fun t : ℝ ↦ ((n * p * t + x : ℝ) : AddCircle p) :=
    (contMDiff_coe p 1).comp (contDiff_const.mul contDiff_id |>.add contDiff_const).contMDiff
  rw [periodHom_ofMul_eq_pathIntegral ((timeForm p).isSmoothForm.of_le (by simp))
      ((SmoothForm.isClosed_def _).1 (isClosed_timeForm p)) hsmooth
      (fun t ↦ by rw [zsmulLoop_apply, ← coe_zsmul, ← coe_add, zsmul_eq_mul]; ring_nf),
    pathIntegral_comp_mul_add ((timeForm p).isSmoothForm.of_le (by simp))
      ((contMDiff_coe p ∞).of_le (by simp)), pathIntegral_timeForm_coe]
  ring

/-- **The circuit class has period `p`.** The time form `dt_p` integrates to `p` over the circuit
class of `ℝ / pℤ`. -/
@[simp]
theorem homologyPeriodHom_timeForm_fundamentalClass :
    homologyPeriodHom (timeForm p).val (fundamentalClass p) = p := by
  have h := periodHom_timeForm (p := p) 0 (FundamentalGroup.fromPath (.mk (zsmulLoop p 0 1)))
  rw [windingNumber_zsmulLoop, periodHom_apply] at h
  rw [fundamentalClass_def, homologyPeriodHom_loopClass]
  simpa using h

/-- **The periods of the time form are the winding numbers.** The time form `dt_p` integrates to
`p` times the winding number over every class of `H₁(ℝ / pℤ; ℤ)`. -/
theorem homologyPeriodHom_timeForm
    (c : ((singularChains ℤ).obj (TopCat.of (AddCircle p))).homology 1) :
    homologyPeriodHom (timeForm p).val c = firstHomologyAddEquiv p c * p := by
  conv_lhs => rw [eq_firstHomologyAddEquiv_zsmul_fundamentalClass p c]
  rw [map_zsmul, homologyPeriodHom_timeForm_fundamentalClass, zsmul_eq_mul]

/-- **The homology periods of the time form lie in `pℤ`.** -/
theorem exists_homologyPeriodHom_timeForm_eq_intCast_mul
    (c : ((singularChains ℤ).obj (TopCat.of (AddCircle p))).homology 1) :
    ∃ n : ℤ, homologyPeriodHom (timeForm p).val c = n * p :=
  ⟨_, homologyPeriodHom_timeForm c⟩

-- `AddCircle.angularClass` is stated with the linear structure of `ModuleCat ℤ` as a category of
-- modules over a commutative ring, which instance search would otherwise not find.
attribute [local instance 1100] ModuleCat.instLinear in
/-- **The angular class is the class of the angular form.** The time form `dt_p` integrates to `p`
times the value of the angular class `θ_p ∈ H¹(ℝ / pℤ; ℤ)` over every class of `H₁(ℝ / pℤ; ℤ)`.
So `θ_p` is the integral singular class of `dt_p / p`; for `p = 1` it is the class of `ds`. -/
theorem homologyPeriodHom_timeForm_eq_singularKronecker_angularClass_mul
    (c : ((singularChains ℤ).obj (TopCat.of (AddCircle p))).homology 1) :
    homologyPeriodHom (timeForm p).val c =
      ((TopCat.of (AddCircle p)).singularKronecker ℤ 1 (angularClass p) c : ℤ) * p := by
  rw [homologyPeriodHom_timeForm, singularKronecker_angularClass]

end AddCircle
