module

public import TauCeti.Geometry.Manifold.DeRham.HomologyPeriod
public import TauCeti.Geometry.Manifold.DifferentialForm.AddCircle
public import Mathlib.Topology.Covering.FundamentalGroupCircle

/-!
# The periods of the time form of a circle

For a positive real `p`, the time form `dt_p` of the circle `AddCircle p = ℝ / pℤ`
(`AddCircle.timeForm p`) integrates to `p` along one circuit. Since the fundamental group of the
circle is generated by that circuit, the period of `dt_p` along a loop is `p` times its winding
number (`AddCircle.periodHom_timeForm`). Consequently every period of `dt_p` on the first singular
homology group `H₁(ℝ / pℤ; ℤ)` is an integer multiple of `p`
(`AddCircle.exists_homologyPeriodHom_timeForm_eq_intCast_mul`).

## Main results

* `AddCircle.periodHom_timeForm`: the period of `dt_p` along a loop class is `windingNumber · p`.
* `AddCircle.exists_homologyPeriodHom_timeForm_eq_intCast_mul`: the periods of `dt_p` on
  `H₁(ℝ / pℤ; ℤ)` lie in `pℤ`.
-/

public section

noncomputable section

open TauCeti TauCeti.HurewiczOne
open scoped Manifold ContDiff

namespace AddCircle

variable {p : ℝ} [Fact (0 < p)]

/-- **The periods of the time form are the winding numbers.** Along a loop class `g` based at the
image of a real number `x`, the time form `dt_p` of `ℝ / pℤ` integrates to `p` times the winding
number of `g`. -/
theorem periodHom_timeForm (x : ℝ) (g : FundamentalGroup (AddCircle p) (x : AddCircle p)) :
    periodHom (timeForm p).1 (x : AddCircle p) (Additive.ofMul g) = windingNumber g * p := by
  -- `g` is the class of the loop winding `windingNumber g` times.
  have hg : g = FundamentalGroup.fromPath (.mk (zsmulLoop p x (windingNumber g))) := by
    apply (windingNumberIso (x : AddCircle p)).injective
    apply Multiplicative.toAdd.injective
    exact (windingNumber_zsmulLoop x (windingNumber g)).symm
  generalize windingNumber g = n at hg ⊢
  subst hg
  have hsmooth : ContMDiff 𝓘(ℝ) 𝓘(ℝ) 1 fun t : ℝ ↦ ((n * p * t + x : ℝ) : AddCircle p) :=
    (contMDiff_coe p 1).comp (contDiff_const.mul contDiff_id |>.add contDiff_const).contMDiff
  rw [periodHom_ofMul_eq_pathIntegral ((timeForm p).isSmoothForm.of_le (by simp))
      ((SmoothForm.isClosed_def _).1 (isClosed_timeForm p)) hsmooth
      (fun t ↦ by rw [zsmulLoop_apply, ← coe_zsmul, ← coe_add, zsmul_eq_mul]; ring_nf),
    pathIntegral_comp_mul_add ((timeForm p).isSmoothForm.of_le (by simp))
      ((contMDiff_coe p ∞).of_le (by simp)), pathIntegral_timeForm_coe]
  ring

/-- **The homology periods of the time form lie in `pℤ`.** Every class of `H₁(ℝ / pℤ; ℤ)` is the
Hurewicz image of a loop class, along which `dt_p` integrates to `p` times the winding number. -/
theorem exists_homologyPeriodHom_timeForm_eq_intCast_mul
    (c : ((singularChains ℤ).obj (TopCat.of (AddCircle p))).homology 1) :
    ∃ n : ℤ, homologyPeriodHom (timeForm p).1 c = n * p := by
  obtain ⟨a, rfl⟩ := (hurewiczHomologyAddEquiv (X := TopCat.of (AddCircle p))
    ((0 : ℝ) : AddCircle p)).surjective c
  obtain ⟨a, rfl⟩ := Additive.ofMul.surjective a
  obtain ⟨g, rfl⟩ := Quot.exists_rep a
  rw [Abelianization.mk_eq_of]
  exact ⟨windingNumber g, by rw [homologyPeriodHom_hurewiczHomologyAddEquiv, periodHom_timeForm]⟩

end AddCircle
