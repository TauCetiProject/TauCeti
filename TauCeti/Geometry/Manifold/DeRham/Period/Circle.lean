module

public import TauCeti.AlgebraicTopology.UniversalCover.Circle.FundamentalGroup
public import TauCeti.Geometry.Manifold.DeRham.Circle
public import TauCeti.Geometry.Manifold.DeRham.Period

/-!
# First de Rham cohomology of the circle through periods

A first de Rham class on a connected manifold is determined by its periods
(`TauCeti.deRhamCohomology.period_injective`). The fundamental group of the circle is infinite
cyclic, generated by the counterclockwise loop `Circle.expLoop`, so a first de Rham class on the
circle is determined by its period on that loop. The angular class `[dθ]` has period `2π` there,
hence every class is `(p / 2π) • [dθ]`, where `p` is its period: `H¹_dR(S¹)` is the line spanned by
`[dθ]`.

## Main results

* `TauCeti.deRhamCohomology.eq_of_period_expLoop_eq`: two classes on the circle with the same
  period on `Circle.expLoop` are equal.
* `TauCeti.deRhamCohomology.period_mk_circleAngularClosedForm_expLoop`: the angular class has
  period `2π` on `Circle.expLoop`.
* `TauCeti.deRhamCohomology.eq_smul_mk_circleAngularClosedForm`: every class on the circle is
  `(2π)⁻¹ p • [dθ]`, `p` its period on `Circle.expLoop`.

## References

This file is adapted from Riccardo Brasca's Codex-assisted formalization.

* R. Bott and L. W. Tu, *Differential Forms in Algebraic Topology*, Springer, 1982, Chapter I.
-/

public noncomputable section

open scoped Manifold

namespace TauCeti.deRhamCohomology

/-- A first de Rham class on the circle is determined by its period on the counterclockwise loop
`Circle.expLoop`. -/
theorem eq_of_period_expLoop_eq {c d : deRhamCohomology (𝓡 1) Circle 1}
    (h : period (I := 𝓡 1) (1 : Circle) c
        (Additive.ofMul (FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk Circle.expLoop))) =
      period (I := 𝓡 1) (1 : Circle) d
        (Additive.ofMul (FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk Circle.expLoop)))) :
    c = d := by
  apply period_injective (I := 𝓡 1) (1 : Circle)
  refine AddMonoidHom.ext fun q ↦ ?_
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp
    (Circle.zpowers_fromPath_expLoop ▸ Subgroup.mem_top (Additive.toMul q))
  rw [← ofMul_toMul q, ← hk, ofMul_zpow, map_zsmul, map_zsmul, h]

/-- The angular class `[dθ]` has period `2π` on the counterclockwise loop. -/
theorem period_mk_circleAngularClosedForm_expLoop :
    period (I := 𝓡 1) (1 : Circle) (mk (𝓡 1) 1 circleAngularClosedForm)
        (Additive.ofMul (FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk Circle.expLoop))) =
      2 * Real.pi := by
  rw [period_mk]
  have hclosed : mextDeriv circleAngularForm = 0 := by
    simpa only [coe_circleAngularClosedForm] using
      (mem_closedForms (𝓡 1) _).mp circleAngularClosedForm.property
  have hcurve : ContMDiff 𝓘(ℝ, ℝ) (𝓡 1) 1 (fun t : ℝ ↦ Circle.exp (2 * Real.pi * t)) :=
    (contMDiff_circleExp (m := 1)).comp
      ((contDiff_const.mul contDiff_id).contMDiff :
        ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, ℝ) 1 (fun t : ℝ ↦ 2 * Real.pi * t))
  rw [coe_circleAngularClosedForm,
    periodHom_ofMul_eq_pathIntegral (isSmoothForm_circleAngularForm.of_le (by norm_num))
      hclosed hcurve (fun t ↦ Circle.expLoop_apply t)]
  have h := pathIntegral_comp_mul_add (isSmoothForm_circleAngularForm.of_le (by norm_num))
    (contMDiff_circleExp (m := 1)) (2 * Real.pi) 0 0 1
  simp only [add_zero, mul_zero, mul_one] at h
  rw [h, pathIntegral_circleAngularForm_circleExp]
  ring

/-- **`H¹_dR(S¹)` is spanned by the angular class.** Every first de Rham class on the circle is
`(2π)⁻¹ p • [dθ]`, where `p` is its period on the counterclockwise loop. -/
theorem eq_smul_mk_circleAngularClosedForm (c : deRhamCohomology (𝓡 1) Circle 1) :
    c = ((2 * Real.pi)⁻¹ * period (I := 𝓡 1) (1 : Circle) c
        (Additive.ofMul (FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk Circle.expLoop)))) •
      mk (𝓡 1) 1 circleAngularClosedForm := by
  apply eq_of_period_expLoop_eq
  rw [map_smul, AddMonoidHom.smul_apply, smul_eq_mul, period_mk_circleAngularClosedForm_expLoop]
  field_simp [Real.pi_ne_zero]

end TauCeti.deRhamCohomology
