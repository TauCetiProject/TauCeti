/-!
# The first de Rham cohomology of the Kodaira–Thurston manifold

The Kodaira–Thurston manifold `TauCeti.KodairaThurston` is the quotient of `ℝ⁴`, with coordinates
`(x, y, z, t)`, by the deck group `H(ℤ) × ℤ` acting by
`((a, b, c), n) • (x, y, z, t) = (a + x, b + y, c + z + a y, n + t)`. The coordinate differentials
`dx`, `dy` and `dt` are invariant under these affine maps, so they descend to closed one-forms on
the Kodaira–Thurston manifold (`TauCeti.KodairaThurston.dxForm`, `dyForm`, `dtForm`); the
differential `dz` does not descend, as the deck group shears `z` by `a y`.

A closed one-form is integrated along the loop `TauCeti.KodairaThurston.deckLoop g`, covered by the
straight segment from `0` to `g • 0`, as its pullback to the cover along this segment. So for
`g = ((a, b, c), n)`, the periods of `dx`, `dy` and `dt` on this loop are `a`, `b` and `n`. The
first homology group is `ℤ³`, generated by the classes of the loops of `((1, 0, 0), 0)`,
`((0, 1, 0), 0)` and `((0, 0, 0), 1)` (`TauCeti.KodairaThurston.firstHomologyAddEquiv`), and a de
Rham class of degree one is determined by its periods on first homology
(`TauCeti.deRhamCohomology.homologyPeriod_injective`). Hence the periods on these three loops
identify the first de Rham cohomology with `ℝ³`:

  `H¹_dR(KT) ≃ₗ[ℝ] ℝ³` (`TauCeti.KodairaThurston.deRhamCohomologyOneEquiv`),

and the classes `[dx]`, `[dy]`, `[dt]` correspond to the standard basis. In particular **the first
Betti number of the Kodaira–Thurston manifold is three**
(`TauCeti.KodairaThurston.finrank_deRhamCohomology_one`). Since the odd Betti numbers of a compact
Kähler manifold are even, this is Thurston's obstruction to a Kähler structure on this compact
symplectic four-manifold; the Hodge-theoretic parity theorem itself is not proved here.

## Main definitions

* `TauCeti.KodairaThurston.dxForm`, `TauCeti.KodairaThurston.dyForm`,
  `TauCeti.KodairaThurston.dtForm`: the closed one-forms descended from `dx`, `dy` and `dt`.
* `TauCeti.KodairaThurston.deRhamCohomologyOneEquiv`: the periods on the three generating loops,
  a linear equivalence `H¹_dR(KT) ≃ₗ[ℝ] ℝ × ℝ × ℝ`.

## Main results

* `TauCeti.KodairaThurston.pathClassIntegral_dxForm_deckLoop` and its analogues for `dy` and `dt`:
  the periods of the descended coordinate forms on `deckLoop g`.
* `TauCeti.KodairaThurston.deRhamCohomologyOneEquiv_mk_dxForm` and its analogues: the classes of
  `dx`, `dy` and `dt` correspond to the standard basis of `ℝ³`.
* `TauCeti.KodairaThurston.finrank_deRhamCohomology_one`: the first Betti number is three.

## References

* W. P. Thurston, *Some simple examples of symplectic manifolds*, Proceedings of the American
  Mathematical Society 55 (1976), 467–468.
* John M. Lee, *Introduction to Smooth Manifolds*, second edition, Graduate Texts in
  Mathematics 218, Springer, 2013, Chapter 17 (de Rham cohomology and periods of closed forms).
-/

public section

noncomputable section

open TauCeti.HurewiczOne
open scoped Manifold ContDiff

namespace TauCeti

namespace KodairaThurston

open Cover

/-! ### Coordinate one-forms on the cover -/

/-- The differential of a linear functional `ℓ` on the cover, the pullback along `ℓ` of the
coordinate one-form of the real line. -/
private def coverForm (ℓ : Cover →L[ℝ] ℝ) : SmoothForm 𝓘(ℝ, Cover) Cover ℝ 1 :=
  SmoothForm.mpullback ℓ ℓ.contMDiff SmoothForm.realLineCoordForm

/-- The differential of `ℓ`, as a rough form. -/
private theorem coe_coverForm (ℓ : Cover →L[ℝ] ℝ) :
    (coverForm ℓ).1 = mextDeriv (RoughForm.ofFunction 𝓘(ℝ, Cover) ℓ) := by
  rw [coverForm, SmoothForm.coe_mpullback, SmoothForm.mpullback_realLineCoordForm]

/-- The differential of a functional is closed. -/
private theorem isClosed_coverForm (ℓ : Cover →L[ℝ] ℝ) : (coverForm ℓ).IsClosed := by
  rw [SmoothForm.isClosed_def, coe_coverForm]
  exact SmoothForm.mextDeriv_mextDeriv
    ⟨_, (isSmoothForm_ofFunction_iff.mpr ℓ.contMDiff).mem_smoothBundleForms⟩

/-- A functional invariant under the shears gives a one-form invariant under the deck group: each
element of the deck group is affine with linear part a shear. -/
private theorem mpullback_smul_coverForm {ℓ : Cover →L[ℝ] ℝ} (hℓ : ∀ a p, ℓ (shear a p) = ℓ p)
    (γ : DeckGroup) :
    SmoothForm.mpullback (γ • ·) (contMDiff_const_smul γ) (coverForm ℓ) = coverForm ℓ := by
  refine SmoothBundleForm.ext fun p v ↦ ?_
  rw [SmoothForm.mpullback_apply, mfderiv_smul, coverForm, SmoothForm.mpullback_apply,
    SmoothForm.mpullback_apply, SmoothForm.realLineCoordForm_apply,
    SmoothForm.realLineCoordForm_apply, ℓ.mfderiv_eq, ℓ.mfderiv_eq]
  exact hℓ _ _

/-- The closed one-form on the Kodaira–Thurston manifold descended from the differential of a
functional invariant under the shears. -/
private def descForm (ℓ : Cover →L[ℝ] ℝ) (hℓ : ∀ a p, ℓ (shear a p) = ℓ p) :
    closedForms 𝓘(ℝ, Cover) KodairaThurston 1 :=
  ⟨SmoothForm.descend (coverForm ℓ) (mpullback_smul_coverForm hℓ),
    (mem_closedForms _ _).2 <| (SmoothForm.isClosed_def _).1 <|
      SmoothForm.isClosed_descend_iff.2 (isClosed_coverForm ℓ)⟩

/-- The descended form pulls back to the differential of `ℓ` on the cover. -/
private theorem mpullback_mk_descForm (ℓ : Cover →L[ℝ] ℝ) (hℓ : ∀ a p, ℓ (shear a p) = ℓ p) :
    SmoothForm.mpullback mk isLocalDiffeomorph_mk.contMDiff (descForm ℓ hℓ).1 =
      coverForm ℓ :=
  SmoothForm.mpullback_quotientMk_descend

/-- The integral of the descended form along `deckLoop g` is `ℓ (g • 0)`: it is the integral of
`dℓ` along the straight segment from `0` to `g • 0` in the cover. -/
private theorem pathClassIntegral_descForm_deckLoop (ℓ : Cover →L[ℝ] ℝ)
    (hℓ : ∀ a p, ℓ (shear a p) = ℓ p) (g : DeckGroup) :
    pathClassIntegral (descForm ℓ hℓ).1.1
        (.mk (deckLoop g)) = ℓ (g • 0) := by
  set θ := (descForm ℓ hℓ).1.1
  have hθ : IsSmoothForm 𝓘(ℝ, Cover) 1 θ :=
    (descForm ℓ hℓ).1.isSmoothForm.of_le (by simp)
  have hclosed : mextDeriv θ = 0 := (mem_closedForms _ _).1 (descForm ℓ hℓ).2
  have hpull : TauCeti.mpullback 𝓘(ℝ, Cover) 𝓘(ℝ, Cover) mk θ =
      mextDeriv (RoughForm.ofFunction 𝓘(ℝ, Cover) ℓ) := by
    rw [← coe_coverForm, ← mpullback_mk_descForm ℓ hℓ, SmoothForm.coe_mpullback]
  have h := pathClassIntegral_mpullback (isLocalDiffeomorph_mk (n := 2)).contMDiff hθ hclosed
    (.mk (deckPath g))
  rw [hpull, pathClassIntegral_mextDeriv_ofFunction ℓ.contMDiff, map_zero, sub_zero,
    ← Path.Homotopic.Quotient.mk_map] at h
  -- Recasting the endpoints of a path does not change the integral along it.
  have hcast : ∀ {y y' : KodairaThurston} (τ : Path (mk 0) y) (hy : y' = y),
      pathClassIntegral θ (.mk (τ.cast rfl hy)) = pathClassIntegral θ (.mk τ) := by
    rintro y y' τ rfl
    rw [Path.cast_rfl_rfl]
  rw [deckLoop_eq_cast_map, hcast, ← h]

/-! ### The coordinate one-forms of the Kodaira–Thurston manifold -/

/-- The `x`-coordinate of the cover, as a linear functional. -/
private def xL : Cover →L[ℝ] ℝ := (ContinuousLinearMap.fst ℝ ℝ _).comp toProd.toContinuousLinearMap

/-- The `y`-coordinate of the cover, as a linear functional. -/
private def yL : Cover →L[ℝ] ℝ :=
  ((ContinuousLinearMap.fst ℝ ℝ _).comp (ContinuousLinearMap.snd ℝ ℝ _)).comp
    toProd.toContinuousLinearMap

/-- The `t`-coordinate of the cover, as a linear functional. -/
private def tL : Cover →L[ℝ] ℝ :=
  ((ContinuousLinearMap.snd ℝ ℝ _).comp ((ContinuousLinearMap.snd ℝ ℝ _).comp
    (ContinuousLinearMap.snd ℝ ℝ _))).comp toProd.toContinuousLinearMap

private theorem xL_apply (p : Cover) : xL p = p.x := by simp [xL]

private theorem yL_apply (p : Cover) : yL p = p.y := by simp [yL]

private theorem tL_apply (p : Cover) : tL p = p.t := by simp [tL]

private theorem coe_xL : ((xL : Cover →L[ℝ] ℝ) : Cover → ℝ) = x := funext xL_apply

private theorem coe_yL : ((yL : Cover →L[ℝ] ℝ) : Cover → ℝ) = y := funext yL_apply

private theorem coe_tL : ((tL : Cover →L[ℝ] ℝ) : Cover → ℝ) = t := funext tL_apply

/-- The closed one-form `dx` of the Kodaira–Thurston manifold, descended from the differential of
the `x`-coordinate of the cover. -/
def dxForm : closedForms 𝓘(ℝ, Cover) KodairaThurston 1 :=
  descForm xL fun _ _ ↦ by simp [xL_apply]

/-- The closed one-form `dy` of the Kodaira–Thurston manifold, descended from the differential of
the `y`-coordinate of the cover. -/
def dyForm : closedForms 𝓘(ℝ, Cover) KodairaThurston 1 :=
  descForm yL fun _ _ ↦ by simp [yL_apply]

/-- The closed one-form `dt` of the Kodaira–Thurston manifold, descended from the differential of
the `t`-coordinate of the cover. -/
def dtForm : closedForms 𝓘(ℝ, Cover) KodairaThurston 1 :=
  descForm tL fun _ _ ↦ by simp [tL_apply]

/-- `dx` pulls back to the differential of the `x`-coordinate of the cover. -/
theorem mpullback_mk_dxForm :
    TauCeti.mpullback 𝓘(ℝ, Cover) 𝓘(ℝ, Cover) mk dxForm.1.1 =
      mextDeriv (RoughForm.ofFunction 𝓘(ℝ, Cover) x) := by
  rw [← SmoothForm.coe_mpullback _ isLocalDiffeomorph_mk.contMDiff, dxForm,
    mpullback_mk_descForm, coe_coverForm, coe_xL]

/-- `dy` pulls back to the differential of the `y`-coordinate of the cover. -/
theorem mpullback_mk_dyForm :
    TauCeti.mpullback 𝓘(ℝ, Cover) 𝓘(ℝ, Cover) mk dyForm.1.1 =
      mextDeriv (RoughForm.ofFunction 𝓘(ℝ, Cover) y) := by
  rw [← SmoothForm.coe_mpullback _ isLocalDiffeomorph_mk.contMDiff, dyForm,
    mpullback_mk_descForm, coe_coverForm, coe_yL]

/-- `dt` pulls back to the differential of the `t`-coordinate of the cover. -/
theorem mpullback_mk_dtForm :
    TauCeti.mpullback 𝓘(ℝ, Cover) 𝓘(ℝ, Cover) mk dtForm.1.1 =
      mextDeriv (RoughForm.ofFunction 𝓘(ℝ, Cover) t) := by
  rw [← SmoothForm.coe_mpullback _ isLocalDiffeomorph_mk.contMDiff, dtForm,
    mpullback_mk_descForm, coe_coverForm, coe_tL]

/-! ### Periods and the first de Rham cohomology -/

/-- The first homology class of the loop `deckLoop g`. -/
private abbrev deckClass (g : DeckGroup) :
    ((singularChains ℤ).obj (TopCat.of KodairaThurston)).homology 1 :=
  H₁AddEquivHomology _ (loopClass (X := TopCat.of KodairaThurston) (deckLoop g))

/-- The period of `dx` on the loop `deckLoop g`, the integral along it, is the first Heisenberg
coordinate of `g`. -/
@[simp]
theorem pathClassIntegral_dxForm_deckLoop (g : DeckGroup) :
    pathClassIntegral dxForm.1.1 (.mk (deckLoop g)) = g.1.x := by
  rw [dxForm, pathClassIntegral_descForm_deckLoop, xL_apply]
  simp

/-- The period of `dy` on the loop `deckLoop g`, the integral along it, is the second Heisenberg
coordinate of `g`. -/
@[simp]
theorem pathClassIntegral_dyForm_deckLoop (g : DeckGroup) :
    pathClassIntegral dyForm.1.1 (.mk (deckLoop g)) = g.1.y := by
  rw [dyForm, pathClassIntegral_descForm_deckLoop, yL_apply]
  simp

/-- The period of `dt` on the loop `deckLoop g`, the integral along it, is the integer
coordinate of `g`. -/
@[simp]
theorem pathClassIntegral_dtForm_deckLoop (g : DeckGroup) :
    pathClassIntegral dtForm.1.1 (.mk (deckLoop g)) = g.2.toAdd := by
  rw [dtForm, pathClassIntegral_descForm_deckLoop, tL_apply]
  simp

/-- The generator `((1, 0, 0), 0)` of the deck group. -/
private abbrev gx : DeckGroup := (⟨1, 0, 0⟩, 1)

/-- The generator `((0, 1, 0), 0)` of the deck group. -/
private abbrev gy : DeckGroup := (⟨0, 1, 0⟩, 1)

/-- The generator `((0, 0, 0), 1)` of the deck group. -/
private abbrev gt : DeckGroup := (1, .ofAdd 1)

/-- The periods of a de Rham class on the loops of the three generators `((1, 0, 0), 0)`,
`((0, 1, 0), 0)` and `((0, 0, 0), 1)` of the deck group. -/
private def periods :
    deRhamCohomology 𝓘(ℝ, Cover) KodairaThurston 1 →ₗ[ℝ] ℝ × ℝ × ℝ where
  toFun c := (deRhamCohomology.homologyPeriod c (deckClass gx),
    deRhamCohomology.homologyPeriod c (deckClass gy),
    deRhamCohomology.homologyPeriod c (deckClass gt))
  map_add' _ _ := by simp
  map_smul' _ _ := by simp

/-- A de Rham class with vanishing periods on the three generating loops vanishes: its periods on
the first homology group `ℤ³` vanish on a basis. -/
private theorem periods_injective : Function.Injective periods := by
  refine (injective_iff_map_eq_zero _).2 fun c hc ↦ deRhamCohomology.homologyPeriod_injective ?_
  simp only [periods, LinearMap.coe_mk, AddHom.coe_mk, Prod.mk_eq_zero] at hc
  obtain ⟨hx, hy, ht⟩ := hc
  rw [map_zero]
  -- Read the periods on `ℤ³` through `firstHomologyAddEquiv`.
  have key : (deRhamCohomology.homologyPeriod c).comp
      firstHomologyAddEquiv.symm.toAddMonoidHom = 0 := by
    have e (v : ℤ × ℤ × ℤ) (g : DeckGroup)
        (hg : ((⟨v.1, v.2.1, 0⟩, .ofAdd v.2.2) : DeckGroup) = g) :
        firstHomologyAddEquiv.symm v = deckClass g := by
      rw [firstHomologyAddEquiv_symm_apply, hg]
    have e₁ := e (1, 0, 0) gx (by ext <;> simp)
    have e₂ := e (0, 1, 0) gy (by ext <;> simp)
    have e₃ := e (0, 0, 1) gt (by ext <;> simp)
    ext ⟨m, n, k⟩
    have hv : ((m, n, k) : ℤ × ℤ × ℤ) = m • (1, 0, 0) + n • (0, 1, 0) + k • (0, 0, 1) := by
      ext <;> simp
    simp only [AddMonoidHom.coe_comp, AddEquiv.coe_toAddMonoidHom, Function.comp_apply,
      AddMonoidHom.zero_apply]
    simp only [hv, map_add, map_zsmul, e₁, e₂, e₃, hx, hy, ht, smul_zero, add_zero]
  ext z
  simpa using DFunLike.congr_fun key (firstHomologyAddEquiv z)

/-- The periods of `dx`, `dy` and `dt` on the generating loops are the standard basis of `ℝ³`. -/
private theorem periods_surjective : Function.Surjective periods := by
  rintro ⟨a, b, s⟩
  refine ⟨a • deRhamCohomology.mk _ 1 dxForm + b • deRhamCohomology.mk _ 1 dyForm +
    s • deRhamCohomology.mk _ 1 dtForm, ?_⟩
  simp [periods]

/-- **The first de Rham cohomology of the Kodaira–Thurston manifold is `ℝ³`**: a class is
determined by its periods on the loops of the generators `((1, 0, 0), 0)`, `((0, 1, 0), 0)` and
`((0, 0, 0), 1)` of the deck group, and every triple of periods is attained. -/
def deRhamCohomologyOneEquiv :
    deRhamCohomology 𝓘(ℝ, Cover) KodairaThurston 1 ≃ₗ[ℝ] ℝ × ℝ × ℝ :=
  LinearEquiv.ofBijective periods ⟨periods_injective, periods_surjective⟩

/-- The coordinates of a de Rham class are its periods on the loops of the generators
`((1, 0, 0), 0)`, `((0, 1, 0), 0)` and `((0, 0, 0), 1)` of the deck group. -/
theorem deRhamCohomologyOneEquiv_apply (c : deRhamCohomology 𝓘(ℝ, Cover) KodairaThurston 1) :
    deRhamCohomologyOneEquiv c =
      (deRhamCohomology.homologyPeriod c (H₁AddEquivHomology _
          (loopClass (X := TopCat.of KodairaThurston) (deckLoop (⟨1, 0, 0⟩, 1)))),
        deRhamCohomology.homologyPeriod c (H₁AddEquivHomology _
          (loopClass (X := TopCat.of KodairaThurston) (deckLoop (⟨0, 1, 0⟩, 1)))),
        deRhamCohomology.homologyPeriod c (H₁AddEquivHomology _
          (loopClass (X := TopCat.of KodairaThurston) (deckLoop (1, .ofAdd 1))))) := by
  simp only [deRhamCohomologyOneEquiv, LinearEquiv.ofBijective_apply, periods, LinearMap.coe_mk,
    AddHom.coe_mk]

/-- The class of `dx` corresponds to the first standard basis vector of `ℝ³`. -/
@[simp]
theorem deRhamCohomologyOneEquiv_mk_dxForm :
    deRhamCohomologyOneEquiv (deRhamCohomology.mk _ 1 dxForm) = (1, 0, 0) := by
  simp [deRhamCohomologyOneEquiv, periods]

/-- The class of `dy` corresponds to the second standard basis vector of `ℝ³`. -/
@[simp]
theorem deRhamCohomologyOneEquiv_mk_dyForm :
    deRhamCohomologyOneEquiv (deRhamCohomology.mk _ 1 dyForm) = (0, 1, 0) := by
  simp [deRhamCohomologyOneEquiv, periods]

/-- The class of `dt` corresponds to the third standard basis vector of `ℝ³`. -/
@[simp]
theorem deRhamCohomologyOneEquiv_mk_dtForm :
    deRhamCohomologyOneEquiv (deRhamCohomology.mk _ 1 dtForm) = (0, 0, 1) := by
  simp [deRhamCohomologyOneEquiv, periods]

/-- **The first Betti number of the Kodaira–Thurston manifold is three.** -/
theorem finrank_deRhamCohomology_one :
    Module.finrank ℝ (deRhamCohomology 𝓘(ℝ, Cover) KodairaThurston 1) = 3 := by
  rw [deRhamCohomologyOneEquiv.finrank_eq]
  simp

end KodairaThurston

end TauCeti
