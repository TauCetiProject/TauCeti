/-!
# Smooth maps on a manifold form a Montel space

Let `M` be a boundaryless manifold modelled on a finite-dimensional real normed space and `F` a
finite-dimensional real normed space. This file proves that the smooth maps `M → F`, with the
weak Whitney topology of uniform convergence of every coordinate derivative on compact subsets of
chart targets, form a Montel space: every closed von Neumann bounded set of smooth maps is compact
(`ContMDiffMap.montelSpace_manifoldWeakWhitney`). By Mathlib's
`ContinuousLinearEquiv.toCompactConvergenceCLM`, the strong topology on the continuous dual of this
space is then the topology of uniform convergence on compact sets.

The weak Whitney topology is generated by the compact chart derivative seminorms, so a set `s` of
smooth maps is bounded exactly when, on each compact subset `K` of each chart target, each
coordinate derivative of the maps in `s` is bounded on `K` uniformly over `s`
(`ContMDiffMap.isVonNBounded_iff_forall_exists_norm_chartIteratedFDeriv_le`).

## The argument

The topology is induced by the compact chart jet `ContMDiffMap.compactChartJet`, which records
every coordinate derivative restricted to every compact subset of a chart target, with values in
supremum-norm spaces of continuous maps. Let `s` be closed and bounded.

* **Equicontinuity.** A bound on the derivatives of order `m + 1` on compact sets is a local
  Lipschitz bound for the derivatives of order `m`, by the mean value inequality, so the
  coordinate derivatives of order `m` of the maps in `s` are equicontinuous
  (`ContMDiffMap.equicontinuous_chartIteratedFDeriv_of_isVonNBounded`). This is where smoothness,
  rather than finite regularity, is used.
* **Arzelà–Ascoli and Tychonoff.** The values of these derivatives lie in a closed ball of a
  finite-dimensional space, so each component of the jet of `s` has compact closure, and the jet
  of `s` lies in a compact product. It is therefore totally bounded.
* **Completeness.** The jet is a uniform embedding of topological groups, so `s` is totally
  bounded. It is closed in the complete space of smooth maps
  (`ContMDiffMap.completeSpace_manifoldWeakWhitney`), hence compact.

## References

* F. Trèves, *Topological Vector Spaces, Distributions and Kernels*, Chapter 34 (Montel spaces,
  and Proposition 34.4 for the space of smooth functions on an open subset of `ℝⁿ`).
* M. Hirsch, *Differential Topology*, GTM 33, Chapter 2, §1, for the weak topology.
-/

public section

open Set Filter Topology Bornology
open scoped Manifold ContDiff TauCeti.ManifoldWeakWhitney

namespace ContMDiffMap

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- On a boundaryless manifold modelled on a finite-dimensional real space, the coordinate
derivatives of each order of a von Neumann bounded set of smooth maps are equicontinuous on each
chart target. -/
theorem equicontinuous_chartIteratedFDeriv_of_isVonNBounded {s : Set C^∞⟮I, M; 𝓘(ℝ, F), F⟯}
    (hs : IsVonNBounded ℝ s) (x : M) (m : ℕ) (hm : m ≤ ∞) :
    Equicontinuous fun f : s ↦ ⇑(chartIteratedFDeriv (f : C^∞⟮I, M; 𝓘(ℝ, F), F⟯) x m hm) := by
  set T := (extChartAt I x).target
  have hT : IsOpen T := isOpen_extChartAt_target x
  have hbd := isVonNBounded_iff_forall_exists_norm_chartIteratedFDeriv_le.mp hs x (m + 1)
    (ENat.natCast_le_of_coe_top_le_withTop le_rfl (m + 1))
  -- The chart derivatives are derivatives within the chart target, read on the target.
  have hcoe (k : ℕ) (hk : k ≤ ∞) (f : C^∞⟮I, M; 𝓘(ℝ, F), F⟯) (y : T) :
      chartIteratedFDeriv f x k hk y =
        iteratedFDerivWithin ℝ k (writtenInExtChartAt I 𝓘(ℝ, F) x f) T y :=
    chartIteratedFDeriv_apply f x k hk y
  let u : s → E → E [×m]→L[ℝ] F := fun f ↦
    iteratedFDerivWithin ℝ m (writtenInExtChartAt I 𝓘(ℝ, F) x (f : C^∞⟮I, M; 𝓘(ℝ, F), F⟯)) T
  have hu : EquicontinuousOn u T := by
    refine TauCeti.equicontinuousOn_of_forall_isCompact_norm_fderiv_le hT (fun f ↦ ?_)
      fun C hC hCT ↦ ?_
    · exact ((f : C^∞⟮I, M; 𝓘(ℝ, F), F⟯).contMDiff.comp_contMDiffOn
        (contMDiffOn_extChartAt_symm x)).contDiffOn.differentiableOn_iteratedFDerivWithin
        (ENat.natCast_lt_of_coe_top_le_withTop le_rfl m) (uniqueDiffOn_extChartAt_target x)
    · -- The coordinate set `C` as a compact subset of the chart target.
      have hK : IsCompact (Subtype.val ⁻¹' C : Set T) := by
        rw [Topology.IsEmbedding.subtypeVal.isCompact_iff, Subtype.image_preimage_coe,
          inter_eq_right.mpr hCT]
        exact hC
      obtain ⟨R, hR⟩ := hbd ⟨_, hK⟩
      refine ⟨R, fun f y hy ↦ ?_⟩
      rw [← fderivWithin_of_isOpen hT (hCT hy), norm_fderivWithin_iteratedFDerivWithin]
      have hRy := hR f f.property ⟨y, hCT hy⟩ hy
      rw [hcoe] at hRy
      exact hRy
  convert (equicontinuous_restrict_iff u).mpr hu using 1
  funext f y
  exact hcoe m hm f y

variable [FiniteDimensional ℝ F]

/-- On a boundaryless manifold modelled on a finite-dimensional real space, every closed von
Neumann bounded set of smooth maps into a finite-dimensional real space is compact in the weak
Whitney topology. -/
theorem montelSpace_manifoldWeakWhitney : MontelSpace ℝ C^∞⟮I, M; 𝓘(ℝ, F), F⟯ where
  heine_borel s hsc hs := by
    -- Each component of the compact chart jet of `s` has compact closure, by Arzelà–Ascoli.
    have hc (i : Σ x : M, {m : ℕ // (m : WithTop ℕ∞) ≤ ∞} ×
        TopologicalSpace.Compacts (extChartAt I x).target) :
        IsCompact (closure (range fun f : s ↦ compactChartJet (f : C^∞⟮I, M; 𝓘(ℝ, F), F⟯) i)) := by
      obtain ⟨x, ⟨m, hm⟩, K⟩ := i
      -- A component of the jet is a restricted chart derivative.
      have hJ (f : C^∞⟮I, M; 𝓘(ℝ, F), F⟯) (y : K) :
          compactChartJet f ⟨x, ⟨m, hm⟩, K⟩ y = chartIteratedFDeriv f x m hm y :=
        congrArg (fun g : C(K, E [×m]→L[ℝ] F) ↦ g y) (compactChartJet_apply f ⟨x, ⟨m, hm⟩, K⟩)
      obtain ⟨R, hR⟩ :=
        isVonNBounded_iff_forall_exists_norm_chartIteratedFDeriv_le.mp hs x m hm K
      refine ArzelaAscoli.isCompact_closure_range_of_equicontinuous ?_ fun y ↦
        ⟨Metric.closedBall 0 R, isCompact_closedBall 0 R, fun f ↦ ?_⟩
      · have heq := equicontinuous_chartIteratedFDeriv_of_isVonNBounded hs x m hm
        intro y U hU
        filter_upwards [(continuous_subtypeVal.tendsto y).eventually (heq (y : _) U hU)]
          with z hz f
        rw [hJ, hJ]
        exact hz f
      · rw [hJ, mem_closedBall_zero_iff]
        exact hR f f.property y y.property
    -- The jet of `s` lies in a compact product, so it is totally bounded.
    have hsub : compactChartJet (I := I) (n := ∞) '' s ⊆ univ.pi fun i ↦
        closure (range fun f : s ↦ compactChartJet (f : C^∞⟮I, M; 𝓘(ℝ, F), F⟯) i) := by
      rintro _ ⟨f, hf, rfl⟩ i -
      exact subset_closure ⟨⟨f, hf⟩, rfl⟩
    have htb := (isCompact_univ_pi hc).totallyBounded.subset hsub
    -- The jet is a uniform embedding into the product, and smooth maps form a complete space.
    let := IsTopologicalAddGroup.rightUniformSpace C^∞⟮I, M; 𝓘(ℝ, F), F⟯
    have := isUniformAddGroup_of_addCommGroup (G := C^∞⟮I, M; 𝓘(ℝ, F), F⟯)
    have := completeSpace_manifoldWeakWhitney (I := I) (M := M) (F := F) (n := ∞)
    have hu := AddMonoidHom.isUniformInducing_of_isInducing
      (isInducing_compactChartJet (I := I) (M := M) (F := F) (n := ∞))
    exact ((totallyBounded_image_iff hu).mp htb).isCompact_of_isClosed hsc

end ContMDiffMap

namespace TauCeti

-- The Montel property travels with the scoped weak Whitney topology.
scoped[TauCeti.ManifoldWeakWhitney] attribute [instance]
  ContMDiffMap.montelSpace_manifoldWeakWhitney

end TauCeti
