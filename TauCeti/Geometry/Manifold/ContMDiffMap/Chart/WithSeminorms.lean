import TauCeti.Geometry.Manifold.ContMDiffMap.Basic

/-!
# The compact chart seminorm topology

For vector-valued maps, the weak Whitney topology is generated by the compact chart derivative
seminorms. In particular it is polynormable, and over the real numbers it is locally convex. The
constant maps depend continuously on their value
(`ContMDiffMap.continuous_const_manifoldWeakWhitney`).
The topological vector-space instances use the same `TauCeti.ManifoldWeakWhitney` scope as the
topology itself. No local compactness of the source model is needed.

This comparison allows the native `WithSeminorms` continuity and boundedness criteria to be used
on smooth maps, and on their fixed-support submodules with the induced topology. In particular, a
set of smooth maps is von Neumann bounded exactly when each coordinate derivative is bounded on
each compact subset of each chart target, uniformly over the set
(`ContMDiffMap.isVonNBounded_iff_forall_exists_norm_chartIteratedFDeriv_le`). The comparison does
not put an inductive-limit topology on compactly supported maps.

The proof identifies the topology with the one induced by all compact restrictions of chart
jets, valued in native supremum-norm continuous-map spaces. It uses Mathlib's
`withSeminorms_pi` and `Topology.IsInducing.withSeminorms` to transport their norm seminorms.
The underlying compact chart tests follow Hirsch, *Differential Topology*, Chapter 2, §1.
-/

public section

open Set Topology
open scoped Manifold TauCeti.ManifoldWeakWhitney

namespace ContMDiffMap

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace 𝕜 F]
  {n : WithTop ℕ∞} [IsManifold I n M]

/-- All compact chart derivative seminorms, indexed by a chart center, an admissible derivative
order, and a compact subset of the extended chart target. -/
noncomputable def chartSeminormFamily :
    SeminormFamily 𝕜 C^n⟮I, M; 𝓘(𝕜, F), F⟯
      (Σ x : M, {m : ℕ // m ≤ n} × TopologicalSpace.Compacts (extChartAt I x).target) :=
  fun i ↦ chartDerivativeSeminorm i.1 i.2.2 i.2.1.val i.2.1.property

/-- An entry of the chart seminorm family is the corresponding compact derivative seminorm. -/
@[simp]
theorem chartSeminormFamily_apply (x : M) (m : ℕ) (hm : m ≤ n)
    (K : TopologicalSpace.Compacts (extChartAt I x).target) :
    chartSeminormFamily (I := I) (F := F) ⟨x, ⟨m, hm⟩, K⟩ =
      chartDerivativeSeminorm x K m hm := (rfl)

/-- The weak Whitney topology on vector-valued manifold maps is precisely the topology generated
by all compact chart derivative seminorms. This applies also to boundary and corner charts,
empty compact sets, and finite regularity. -/
theorem withSeminorms_manifoldWeakWhitney :
    WithSeminorms (chartSeminormFamily (I := I) (M := M) (F := F) (n := n)) := by
  let J := Σ x : M, {m : ℕ // m ≤ n} × TopologicalSpace.Compacts (extChartAt I x).target
  let V (i : J) := C(i.2.2, E [×i.2.1.val]→L[𝕜] F)
  let e : J ≃ (Σ _ : J, Unit) := (Equiv.sigmaUnique _ _).symm
  have hp := (isInducing_compactChartJet (I := I) (M := M) (F := F) (n := n)).withSeminorms
    ((withSeminorms_pi fun i : J ↦ norm_withSeminorms 𝕜 (V i)).congr_equiv e)
  convert hp using 1
  ext i f
  exact (chartDerivativeSeminorm_apply i.1 i.2.2 i.2.1.val i.2.1.property f).trans
    (congrArg norm (compactChartJet_apply f i).symm)

/-- A set of vector-valued maps is von Neumann bounded in the weak Whitney topology exactly when,
on each compact subset of each chart target, each coordinate derivative of its members is bounded
uniformly over the set. -/
theorem isVonNBounded_iff_forall_exists_norm_chartIteratedFDeriv_le
    {s : Set C^n⟮I, M; 𝓘(𝕜, F), F⟯} :
    Bornology.IsVonNBounded 𝕜 s ↔ ∀ (x : M) (m : ℕ) (hm : m ≤ n)
      (K : TopologicalSpace.Compacts (extChartAt I x).target),
      ∃ R, ∀ f ∈ s, ∀ y ∈ K, ‖chartIteratedFDeriv f x m hm y‖ ≤ R := by
  rw [withSeminorms_manifoldWeakWhitney.isVonNBounded_iff_seminorm_bounded]
  constructor
  · rintro h x m hm K
    obtain ⟨r, -, hr⟩ := h ⟨x, ⟨m, hm⟩, K⟩
    refine ⟨r, fun f hf y hy ↦ ?_⟩
    have hle := ContinuousMap.norm_coe_le_norm
      ((chartIteratedFDeriv f x m hm).restrict (K : Set _)) ⟨y, hy⟩
    have hrf := hr f hf
    rw [chartSeminormFamily_apply, chartDerivativeSeminorm_apply] at hrf
    exact hle.trans hrf.le
  · rintro h ⟨x, ⟨m, hm⟩, K⟩
    obtain ⟨R, hR⟩ := h x m hm K
    refine ⟨max R 0 + 1, by positivity, fun f hf ↦ ?_⟩
    rw [chartSeminormFamily_apply, chartDerivativeSeminorm_apply]
    refine ((ContinuousMap.norm_le _ (le_max_right R 0)).2 fun y ↦ ?_).trans_lt
      (lt_add_one _)
    exact (hR f hf y y.property).trans (le_max_left R 0)

/-- Addition and negation are continuous for the vector-valued weak Whitney topology. -/
theorem isTopologicalAddGroup_manifoldWeakWhitney :
    IsTopologicalAddGroup C^n⟮I, M; 𝓘(𝕜, F), F⟯ :=
  withSeminorms_manifoldWeakWhitney.isTopologicalAddGroup

/-- Vector-valued weak Whitney map spaces are polynormable, so scalar multiplication is
continuous over every coefficient field; over `ℝ` they are also locally convex. -/
theorem polynormableSpace_manifoldWeakWhitney :
    PolynormableSpace 𝕜 C^n⟮I, M; 𝓘(𝕜, F), F⟯ :=
  withSeminorms_manifoldWeakWhitney.toPolynormableSpace

/-- Every compact chart `C^k` seminorm is continuous for the native weak Whitney topology. -/
theorem continuous_chartCkSeminorm (x : M)
    (K : TopologicalSpace.Compacts (extChartAt I x).target) (k : ℕ) (hk : k ≤ n) :
    Continuous (chartCkSeminorm (I := I) (F := F) x K k hk) := by
  have := isTopologicalAddGroup_manifoldWeakWhitney (I := I) (M := M) (F := F) (n := n)
  exact Seminorm.continuous_of_forall fun r hr ↦
    ball_chartCkSeminorm_mem_nhds x K k hk 0 hr

/-- **The constant maps depend continuously on their value** in the weak Whitney topology: every
compact chart derivative seminorm of the constant map at `v` is at most `‖v‖`. -/
theorem continuous_const_manifoldWeakWhitney :
    Continuous fun v : F ↦ (const v : C^n⟮I, M; 𝓘(𝕜, F), F⟯) := by
  refine continuous_iff_continuousAt.mpr fun v ↦
    (withSeminorms_manifoldWeakWhitney.tendsto_nhds _ _).mpr fun ⟨x, ⟨m, hm⟩, K⟩ ε hε ↦ ?_
  filter_upwards [Metric.ball_mem_nhds v hε] with w hw
  have hsub : (const w : C^n⟮I, M; 𝓘(𝕜, F), F⟯) - const v = const (w - v) :=
    ContMDiffMap.ext fun _ ↦ by simp
  rw [chartSeminormFamily_apply, hsub]
  -- The order `m` seminorm is bounded by the compact chart `C^m` seminorm.
  have hle := chartCkSeminorm_const_le x K m hm (w - v)
  refine lt_of_le_of_lt ?_ (mem_ball_iff_norm.mp hw)
  exact (chartDerivativeSeminorm_le_iff x K m hm _ (norm_nonneg _)).mpr fun z hz ↦
    (chartCkSeminorm_le_iff x K m hm _ (norm_nonneg _)).mp hle m le_rfl z hz

end ContMDiffMap

namespace TauCeti

section ChartDerivatives

open Bornology ContMDiffMap Filter _root_.Manifold
open scoped ContDiff

variable {𝕜 E H M F : Type*} [NontriviallyNormedField 𝕜]
  [NormedAddCommGroup E] [NormedSpace 𝕜 E] [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  [TopologicalSpace M] [ChartedSpace H M] [NormedAddCommGroup F] [NormedSpace 𝕜 F]
  {n : ℕ∞ω} [IsManifold I n M]

/-- Eventual bounds for the coordinate derivatives on compact subsets of chart targets imply that
the range of the sequence is bounded in the weak Whitney topology. -/
theorem isVonNBounded_range_of_eventually_norm_iteratedFDerivWithin_le
    (f : ℕ → C^n⟮I, M; 𝓘(𝕜, F), F⟯)
    (hb : ∀ (x : M) (K : Set E), IsCompact K → K ⊆ (extChartAt I x).target →
      ∀ m : ℕ, m ≤ n → ∃ R : ℝ, ∀ᶠ i in atTop, ∀ y ∈ K,
        ‖iteratedFDerivWithin 𝕜 m (f i ∘ (extChartAt I x).symm) (extChartAt I x).target y‖ ≤ R) :
    IsVonNBounded 𝕜 (range f) := by
  apply isVonNBounded_iff_forall_exists_norm_chartIteratedFDeriv_le.2
  intro x m hm K
  let T := (extChartAt I x).target
  let K' := Subtype.val '' (K : Set T)
  have hK' : IsCompact K' := K.isCompact.image continuous_subtypeVal
  obtain ⟨R, hR⟩ := hb x K' hK' (image_val_subset (γ := (K : Set T))) m hm
  let p (i : ℕ) := chartDerivativeSeminorm x K m hm (f i)
  have hp : IsBoundedUnder (· ≤ ·) atTop p := by
    refine ⟨max 0 R, hR.mono fun i hi ↦ ?_⟩
    exact (chartDerivativeSeminorm_le_iff x K m hm (f i) (le_max_left ..)).mpr
      fun y hy ↦ by
        rw [chartIteratedFDeriv_self_target_apply]
        exact (hi y ⟨y, hy, rfl⟩).trans (le_max_right ..)
  obtain ⟨C, hC⟩ := hp.bddAbove_range
  refine ⟨max 0 C, ?_⟩
  rintro _ ⟨i, rfl⟩
  exact (chartDerivativeSeminorm_le_iff x K m hm (f i) (le_max_left ..)).mp
    ((hC (mem_range_self i)).trans (le_max_right ..))

end ChartDerivatives

-- The vector-space structure travels with the scoped weak Whitney topology.
scoped[TauCeti.ManifoldWeakWhitney] attribute [instance]
  ContMDiffMap.isTopologicalAddGroup_manifoldWeakWhitney
  ContMDiffMap.polynormableSpace_manifoldWeakWhitney

end TauCeti
