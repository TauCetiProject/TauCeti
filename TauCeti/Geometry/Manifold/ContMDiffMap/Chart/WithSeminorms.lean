module

public import TauCeti.Geometry.Manifold.ContMDiffMap.Chart.Seminorm
public import Mathlib.Analysis.LocallyConvex.WithSeminorms

/-!
# The compact chart seminorm topology

For vector-valued maps, the weak Whitney topology is generated by the compact chart derivative
seminorms. In particular it is polynormable, and over the real numbers it is locally convex.
The topological vector-space instances use the same `TauCeti.ManifoldWeakWhitney` scope as the
topology itself. No local compactness of the source model is needed.

This comparison allows the native `WithSeminorms` continuity and boundedness criteria to be used
on smooth maps, and on their fixed-support submodules with the induced topology. It does not
put an inductive-limit topology on compactly supported maps.

The proof identifies the topology with the one induced by all compact restrictions of chart
jets, valued in native supremum-norm continuous-map spaces. It uses Mathlib's
`withSeminorms_pi` and `Topology.IsInducing.withSeminorms` to transport their norm seminorms.
The underlying compact chart tests follow Hirsch, *Differential Topology*, Chapter 2, §1.
-/

public section

open Set Topology
open scoped Manifold TauCeti.ManifoldWeakWhitney

namespace ContMDiffMap

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace 𝕜 F]
  {n : WithTop ℕ∞} [IsManifold I n M]

/-- All compact chart derivative seminorms, indexed by a chart center, an admissible derivative
order, and a compact subset of the extended chart target. -/
noncomputable def chartSeminormFamily :
    SeminormFamily 𝕜 C^n⟮I, M; 𝓘(𝕜, F), F⟯
      (Σ x : M, {m : ℕ // m ≤ n} × TopologicalSpace.Compacts (extChartAt I x).target) :=
  fun i ↦ chartDerivativeSeminorm i.1 i.2.2 i.2.1.1 i.2.1.2

/-- An entry of the chart seminorm family is the corresponding compact derivative seminorm. -/
@[simp]
theorem chartSeminormFamily_apply (x : M) (m : ℕ) (hm : m ≤ n)
    (K : TopologicalSpace.Compacts (extChartAt I x).target) :
    chartSeminormFamily (I := I) (F := F) ⟨x, ⟨m, hm⟩, K⟩ =
      chartDerivativeSeminorm x K m hm := (rfl)

/-- The weak Whitney topology on vector-valued manifold maps is precisely the topology generated
by all compact chart derivative seminorms. This applies also to boundary and corner charts,
empty compact sets, and finite regularity. -/
theorem withSeminorms_manifoldWeakWhitney :
    WithSeminorms (chartSeminormFamily (I := I) (M := M) (F := F) (n := n)) := by
  let J := Σ x : M, {m : ℕ // m ≤ n} × TopologicalSpace.Compacts (extChartAt I x).target
  let V (i : J) := C(i.2.2, E [×i.2.1.1]→L[𝕜] F)
  let e : J ≃ (Σ _ : J, Unit) := (Equiv.sigmaUnique _ _).symm
  have hp := (isInducing_compactChartJet (I := I) (M := M) (F := F) (n := n)).withSeminorms
    ((withSeminorms_pi fun i : J ↦ norm_withSeminorms 𝕜 (V i)).congr_equiv e)
  convert hp using 1
  ext i f
  exact (chartDerivativeSeminorm_apply i.1 i.2.2 i.2.1.1 i.2.1.2 f).trans
    (congrArg norm (compactChartJet_apply f i).symm)

/-- Addition and negation are continuous for the vector-valued weak Whitney topology. -/
theorem isTopologicalAddGroup_manifoldWeakWhitney :
    IsTopologicalAddGroup C^n⟮I, M; 𝓘(𝕜, F), F⟯ :=
  withSeminorms_manifoldWeakWhitney.isTopologicalAddGroup

/-- Vector-valued weak Whitney map spaces are polynormable, so scalar multiplication is
continuous over every coefficient field; over `ℝ` they are also locally convex. -/
theorem polynormableSpace_manifoldWeakWhitney :
    PolynormableSpace 𝕜 C^n⟮I, M; 𝓘(𝕜, F), F⟯ :=
  withSeminorms_manifoldWeakWhitney.toPolynormableSpace

/-- Every compact chart `C^k` seminorm is continuous for the native weak Whitney topology. -/
theorem continuous_chartCkSeminorm (x : M)
    (K : TopologicalSpace.Compacts (extChartAt I x).target) (k : ℕ) (hk : k ≤ n) :
    Continuous (chartCkSeminorm (I := I) (F := F) x K k hk) := by
  have := isTopologicalAddGroup_manifoldWeakWhitney (I := I) (M := M) (F := F) (n := n)
  exact Seminorm.continuous_of_forall fun r hr ↦
    ball_chartCkSeminorm_mem_nhds x K k hk 0 hr

end ContMDiffMap

namespace TauCeti

-- The vector-space structure travels with the scoped weak Whitney topology.
scoped[TauCeti.ManifoldWeakWhitney] attribute [instance]
  ContMDiffMap.isTopologicalAddGroup_manifoldWeakWhitney
  ContMDiffMap.polynormableSpace_manifoldWeakWhitney

end TauCeti
