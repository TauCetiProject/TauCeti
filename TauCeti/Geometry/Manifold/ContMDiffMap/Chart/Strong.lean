module

public import TauCeti.Geometry.Manifold.ContMDiffMap.Chart.Seminorm
public import Mathlib.Topology.Compactness.LocallyFinite
public import Mathlib.Topology.MetricSpace.Thickening

/-!
# The strong Whitney topology for vector-valued maps

The weak Whitney topology controls the coordinate derivatives of a map on finitely many compact
coordinate sets at a time. The strong (or fine) Whitney topology allows infinitely many at once:
a strong `C^k` neighbourhood of `f` is given by a locally finite family of compact sets `Kᵢ` in
the targets of preferred extended charts, one derivative order `k`, and a positive tolerance `εᵢ`
for each member. It consists of the maps `g` whose coordinate derivatives of order at most `k`
are `εᵢ`-close to those of `f` on every `Kᵢ`. On a noncompact manifold the tolerances may tend to
zero at infinity, so these neighbourhoods prescribe how fast an approximation must improve near
infinity. This is the topology in which approximation theorems on noncompact manifolds, such as
the density of Morse functions, are stated.

The data of such a neighbourhood are bundled as `ContMDiffMap.StrongCkControl`, and the
neighbourhood of `f` itself is `ContMDiffMap.StrongCkControl.ball`, the intersection of the compact
chart `C^k` seminorm balls `ContMDiffMap.chartCkSeminorm` of its members. Each basic neighbourhood
uses a single finite derivative order; the order is not allowed to grow from chart to chart.
The strong Whitney topology `ContMDiffMap.manifoldStrongWhitneyTopology` is generated by all these
neighbourhoods, for every finite order at most `n`.

## Main results

* `ContMDiffMap.hasBasis_nhds_manifoldStrongWhitney`: the strong `C^k` neighbourhoods of `f`
  form a basis of its neighbourhood filter, and each is open
  (`ContMDiffMap.StrongCkControl.isOpen_ball`).
* `ContMDiffMap.manifoldStrongWhitneyTopology_le_manifoldWeakWhitneyTopology`: the strong
  topology is finer than the weak Whitney topology; in particular it is Hausdorff.
* `ContMDiffMap.manifoldStrongWhitneyTopology_eq_manifoldWeakWhitneyTopology`: on a compact
  manifold the two topologies agree, so that compact chart `C^k` seminorm balls generate the
  strong topology there.

The topology is not a global instance; use `open scoped TauCeti.ManifoldStrongWhitney` to select
it.

## References

* M. Hirsch, *Differential Topology*, Graduate Texts in Mathematics 33, Springer, 1976,
  Chapter 2, §1, pp. 34–36, for the strong `C^r` topology and its agreement with the weak
  topology on compact manifolds.
-/

public section

open Set Topology Filter TopologicalSpace
open scoped Manifold

universe u

namespace ContMDiffMap

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {M : Type u} [TopologicalSpace M] [ChartedSpace H M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace 𝕜 F]
  {n : WithTop ℕ∞}

variable (I M n) in
/-- The data of a strong `C^k` neighbourhood: compact sets `compact i` in the targets of the
preferred extended charts at points `center i`, whose images in `M` form a locally finite family,
a derivative order `order` at most `n`, and a positive tolerance for each member. -/
structure StrongCkControl where
  /-- The index type of the family of compact coordinate sets. -/
  ι : Type u
  /-- The point whose preferred extended chart carries the `i`th compact set. -/
  center : ι → M
  /-- The `i`th compact coordinate set, in the target of the preferred chart at `center i`. -/
  compact : ∀ i, Compacts (extChartAt I (center i)).target
  /-- The derivative order controlled on every member of the family. -/
  order : ℕ
  /-- The derivative order is one at which the maps are differentiable. -/
  order_le : (order : WithTop ℕ∞) ≤ n
  /-- The tolerance on the `i`th compact coordinate set. -/
  tolerance : ι → ℝ
  /-- Every tolerance is positive. -/
  tolerance_pos : ∀ i, 0 < tolerance i
  /-- The images in `M` of the compact coordinate sets form a locally finite family. -/
  locallyFinite : LocallyFinite fun i ↦ (extChartAt I (center i)).symm ''
    (Subtype.val '' (compact i : Set (extChartAt I (center i)).target))

namespace StrongCkControl

attribute [simp] tolerance_pos

variable [IsManifold I n M]

/-- The strong `C^k` neighbourhood of `f` determined by a control: the maps whose coordinate
derivatives through order `c.order` differ from those of `f` by less than `c.tolerance i` on
`c.compact i`, for every `i`. -/
noncomputable def ball (c : StrongCkControl I M n) (f : C^n⟮I, M; 𝓘(𝕜, F), F⟯) :
    Set C^n⟮I, M; 𝓘(𝕜, F), F⟯ :=
  ⋂ i, (chartCkSeminorm (c.center i) (c.compact i) c.order c.order_le).ball f (c.tolerance i)

/-- Membership in a strong `C^k` neighbourhood is control by every compact chart `C^k` seminorm
of the family. -/
@[simp]
theorem mem_ball {c : StrongCkControl I M n} {f g : C^n⟮I, M; 𝓘(𝕜, F), F⟯} :
    g ∈ c.ball f ↔
      ∀ i, chartCkSeminorm (c.center i) (c.compact i) c.order c.order_le (g - f) <
        c.tolerance i := by
  simp only [ball, mem_iInter, Seminorm.mem_ball]

/-- Membership in a strong `C^k` neighbourhood is strict control of every coordinate derivative
through the prescribed order on every compact coordinate set. -/
theorem mem_ball_iff_forall_norm_sub_lt {c : StrongCkControl I M n}
    {f g : C^n⟮I, M; 𝓘(𝕜, F), F⟯} :
    g ∈ c.ball f ↔
      ∀ i (m : ℕ) (hm : m ≤ c.order), ∀ z ∈ c.compact i,
        ‖chartIteratedFDeriv g (c.center i) m ((Nat.cast_le.mpr hm).trans c.order_le) z -
          chartIteratedFDeriv f (c.center i) m ((Nat.cast_le.mpr hm).trans c.order_le) z‖ <
            c.tolerance i := by
  simp only [ball, mem_iInter]
  exact forall_congr' fun i ↦ mem_ball_chartCkSeminorm_iff _ _ _ _ f g (c.tolerance_pos i)

/-- A strong `C^k` neighbourhood of `f` contains `f`. -/
theorem mem_ball_self (c : StrongCkControl I M n) (f : C^n⟮I, M; 𝓘(𝕜, F), F⟯) :
    f ∈ c.ball f := by
  simp

/-- The same family and order, with the tolerances reduced by the distance of `g` from `f`. -/
noncomputable def shrink (c : StrongCkControl I M n) {f g : C^n⟮I, M; 𝓘(𝕜, F), F⟯}
    (hg : g ∈ c.ball f) : StrongCkControl I M n where
  ι := c.ι
  center := c.center
  compact := c.compact
  order := c.order
  order_le := c.order_le
  tolerance i := c.tolerance i - chartCkSeminorm (c.center i) (c.compact i) c.order c.order_le
    (g - f)
  tolerance_pos i := sub_pos.mpr (mem_ball.mp hg i)
  locallyFinite := c.locallyFinite

/-- A strong `C^k` neighbourhood of `f` contains a strong `C^k` neighbourhood of each of its
points. -/
theorem ball_shrink_subset (c : StrongCkControl I M n) {f g : C^n⟮I, M; 𝓘(𝕜, F), F⟯}
    (hg : g ∈ c.ball f) : (c.shrink hg).ball g ⊆ c.ball f := by
  intro h hh
  refine mem_ball.mpr fun i ↦ ?_
  have hi : chartCkSeminorm (c.center i) (c.compact i) c.order c.order_le (h - g) <
      c.tolerance i - chartCkSeminorm (c.center i) (c.compact i) c.order c.order_le (g - f) :=
    mem_ball.mp hh i
  calc chartCkSeminorm (c.center i) (c.compact i) c.order c.order_le (h - f)
      = chartCkSeminorm (c.center i) (c.compact i) c.order c.order_le ((h - g) + (g - f)) := by
        rw [sub_add_sub_cancel]
    _ ≤ _ := map_add_le_add _ _ _
    _ < c.tolerance i := by linarith

/-- The union of two controls: both families, with the larger derivative order. -/
def sup (c₁ c₂ : StrongCkControl I M n) : StrongCkControl I M n where
  ι := c₁.ι ⊕ c₂.ι
  center := Sum.elim c₁.center c₂.center
  compact
    | .inl i => c₁.compact i
    | .inr i => c₂.compact i
  order := max c₁.order c₂.order
  order_le := by
    rcases le_total c₁.order c₂.order with h | h
    · rw [max_eq_right h]
      exact c₂.order_le
    · rw [max_eq_left h]
      exact c₁.order_le
  tolerance := Sum.elim c₁.tolerance c₂.tolerance
  tolerance_pos
    | .inl i => c₁.tolerance_pos i
    | .inr i => c₂.tolerance_pos i
  locallyFinite := locallyFinite_sum.mpr ⟨c₁.locallyFinite, c₂.locallyFinite⟩

/-- The neighbourhood of the union of two controls lies in that of the first. -/
theorem ball_sup_subset_left (c₁ c₂ : StrongCkControl I M n) (f : C^n⟮I, M; 𝓘(𝕜, F), F⟯) :
    (c₁.sup c₂).ball f ⊆ c₁.ball f := by
  intro g hg
  refine mem_ball.mpr fun i ↦ ?_
  have hi := mem_ball.mp hg (.inl i)
  exact (chartCkSeminorm_le_of_le (c₁.center i) (c₁.compact i) (le_max_left c₁.order c₂.order)
    (c₁.sup c₂).order_le (g - f)).trans_lt hi

/-- The neighbourhood of the union of two controls lies in that of the second. -/
theorem ball_sup_subset_right (c₁ c₂ : StrongCkControl I M n) (f : C^n⟮I, M; 𝓘(𝕜, F), F⟯) :
    (c₁.sup c₂).ball f ⊆ c₂.ball f := by
  intro g hg
  refine mem_ball.mpr fun i ↦ ?_
  have hi := mem_ball.mp hg (.inr i)
  exact (chartCkSeminorm_le_of_le (c₂.center i) (c₂.compact i) (le_max_right c₁.order c₂.order)
    (c₁.sup c₂).order_le (g - f)).trans_lt hi

/-- The control of the single compact coordinate set `K`, at order `m`, with tolerance `ε`. -/
def single (x : M) (K : Compacts (extChartAt I x).target) (m : ℕ) (hm : m ≤ n) {ε : ℝ}
    (hε : 0 < ε) : StrongCkControl I M n where
  ι := PUnit
  center _ := x
  compact _ := K
  order := m
  order_le := hm
  tolerance _ := ε
  tolerance_pos _ := hε
  locallyFinite := locallyFinite_of_finite _

/-- The neighbourhood of a single-set control is a compact chart `C^k` seminorm ball. -/
@[simp]
theorem ball_single (x : M) (K : Compacts (extChartAt I x).target) (m : ℕ) (hm : m ≤ n)
    {ε : ℝ} (hε : 0 < ε) (f : C^n⟮I, M; 𝓘(𝕜, F), F⟯) :
    (single x K m hm hε).ball f = (chartCkSeminorm x K m hm).ball f ε := by
  simp only [ball, single]
  exact iInter_const _

/-- The control with no compact coordinate sets; its neighbourhoods are the whole space. -/
def empty : StrongCkControl I M n where
  ι := PEmpty
  center := PEmpty.elim
  compact i := i.elim
  order := 0
  order_le := by simp
  tolerance := PEmpty.elim
  tolerance_pos i := i.elim
  locallyFinite := locallyFinite_of_finite _

@[simp]
theorem ball_empty (f : C^n⟮I, M; 𝓘(𝕜, F), F⟯) :
    (empty : StrongCkControl I M n).ball f = univ :=
  eq_univ_of_forall fun _ ↦ mem_ball.mpr fun i ↦ i.elim

end StrongCkControl

variable [IsManifold I n M]

/-- The strong Whitney topology on vector-valued `C^n` maps, generated by the strong `C^k`
neighbourhoods `ContMDiffMap.StrongCkControl.ball` of all finite orders `k ≤ n`. -/
@[instance_reducible]
noncomputable def manifoldStrongWhitneyTopology : TopologicalSpace C^n⟮I, M; 𝓘(𝕜, F), F⟯ :=
  .generateFrom {s | ∃ (c : StrongCkControl I M n) (f : C^n⟮I, M; 𝓘(𝕜, F), F⟯), s = c.ball f}

/-- A compact chart derivative test, passed by `f`, contains a single-chart strong neighbourhood
of `f`: the derivative of `f` on the compact set stays a positive distance inside the open set
of the test. -/
theorem exists_ball_single_subset_chartJetSet (x : M) (y : F) {m : ℕ} (hm : m ≤ n)
    {K : Set (extChartAt I x).target} (hK : IsCompact K) {V : Set (E [×m]→L[𝕜] F)}
    (hV : IsOpen V) {f : C^n⟮I, M; 𝓘(𝕜, F), F⟯} (hf : f ∈ chartJetSet x y m K V) :
    ∃ (ε : ℝ) (hε : 0 < ε),
      (StrongCkControl.single x ⟨K, hK⟩ m hm hε).ball f ⊆ chartJetSet x y m K V := by
  rw [chartJetSet_self_target x y m hm] at hf ⊢
  have hmaps : MapsTo (chartIteratedFDeriv f x m hm) K V := hf
  obtain ⟨ε, hε, hsub⟩ := (hK.image (chartIteratedFDeriv f x m hm).continuous
    ).exists_thickening_subset_open hV hmaps.image_subset
  refine ⟨ε, hε, fun g hg z hz ↦ hsub (Metric.mem_thickening_iff.mpr
    ⟨_, mem_image_of_mem _ hz, ?_⟩)⟩
  rw [dist_eq_norm]
  exact (StrongCkControl.mem_ball_iff_forall_norm_sub_lt.mp hg) PUnit.unit m le_rfl z hz

section Strong

attribute [local instance] manifoldStrongWhitneyTopology

/-- Every strong `C^k` neighbourhood is open in the strong Whitney topology. -/
theorem StrongCkControl.isOpen_ball (c : StrongCkControl I M n) (f : C^n⟮I, M; 𝓘(𝕜, F), F⟯) :
    IsOpen (c.ball f) :=
  isOpen_generateFrom_of_mem ⟨c, f, rfl⟩

/-- The strong `C^k` neighbourhoods form a basis of the strong Whitney topology. -/
theorem isTopologicalBasis_manifoldStrongWhitney :
    IsTopologicalBasis {s : Set C^n⟮I, M; 𝓘(𝕜, F), F⟯ |
      ∃ (c : StrongCkControl I M n) (f : C^n⟮I, M; 𝓘(𝕜, F), F⟯), s = c.ball f} where
  exists_subset_inter := by
    rintro _ ⟨c₁, f₁, rfl⟩ _ ⟨c₂, f₂, rfl⟩ g ⟨hg₁, hg₂⟩
    refine ⟨((c₁.shrink hg₁).sup (c₂.shrink hg₂)).ball g, ⟨_, g, rfl⟩,
      StrongCkControl.mem_ball_self _ g, fun h hh ↦ ⟨?_, ?_⟩⟩
    · exact c₁.ball_shrink_subset hg₁ (StrongCkControl.ball_sup_subset_left _ _ g hh)
    · exact c₂.ball_shrink_subset hg₂ (StrongCkControl.ball_sup_subset_right _ _ g hh)
  sUnion_eq := sUnion_eq_univ_iff.mpr fun f ↦
    ⟨StrongCkControl.empty.ball f, ⟨_, f, rfl⟩, StrongCkControl.mem_ball_self _ f⟩
  eq_generateFrom := rfl

/-- The strong `C^k` neighbourhoods of `f`, over all controls, form a basis of the neighbourhood
filter of `f` in the strong Whitney topology. -/
theorem hasBasis_nhds_manifoldStrongWhitney (f : C^n⟮I, M; 𝓘(𝕜, F), F⟯) :
    (𝓝 f).HasBasis (fun _ : StrongCkControl I M n ↦ True) fun c ↦ c.ball f := by
  refine ⟨fun s ↦ ?_⟩
  rw [isTopologicalBasis_manifoldStrongWhitney.mem_nhds_iff]
  constructor
  · rintro ⟨_, ⟨c, f', rfl⟩, hf, hs⟩
    exact ⟨c.shrink hf, trivial, (c.ball_shrink_subset hf).trans hs⟩
  · rintro ⟨c, -, hs⟩
    exact ⟨c.ball f, ⟨c, f, rfl⟩, c.mem_ball_self f, hs⟩

/-- A set is a strong Whitney neighbourhood of `f` exactly when it contains a strong `C^k`
neighbourhood of `f`. -/
theorem mem_nhds_manifoldStrongWhitney_iff {f : C^n⟮I, M; 𝓘(𝕜, F), F⟯}
    {s : Set C^n⟮I, M; 𝓘(𝕜, F), F⟯} :
    s ∈ 𝓝 f ↔ ∃ c : StrongCkControl I M n, c.ball f ⊆ s := by
  simp [(hasBasis_nhds_manifoldStrongWhitney f).mem_iff]

/-- **The strong Whitney topology is finer than the weak one.** -/
theorem manifoldStrongWhitneyTopology_le_manifoldWeakWhitneyTopology :
    (manifoldStrongWhitneyTopology : TopologicalSpace C^n⟮I, M; 𝓘(𝕜, F), F⟯) ≤
      manifoldWeakWhitneyTopology := by
  rw [← continuous_id_iff_le]
  refine continuous_manifoldWeakWhitney_iff.mpr fun x y m hm K hK V hV ↦ ?_
  refine isOpen_iff_mem_nhds.mpr fun f hf ↦ ?_
  obtain ⟨ε, hε, hsub⟩ := exists_ball_single_subset_chartJetSet x y hm hK hV hf
  exact mem_nhds_manifoldStrongWhitney_iff.mpr ⟨_, hsub⟩

end Strong

/-- The strong Whitney topology is Hausdorff. -/
theorem t2Space_manifoldStrongWhitney :
    @T2Space C^n⟮I, M; 𝓘(𝕜, F), F⟯ manifoldStrongWhitneyTopology :=
  t2Space_antitone manifoldStrongWhitneyTopology_le_manifoldWeakWhitneyTopology
    t2Space_manifoldWeakWhitney

section Compact

open scoped TauCeti.ManifoldWeakWhitney

/-- On a compact manifold a strong `C^k` neighbourhood is a finite intersection of compact chart
`C^k` seminorm balls, since only finitely many members of a locally finite family are nonempty.
In particular it is open in the weak Whitney topology. -/
theorem StrongCkControl.isOpen_ball_manifoldWeakWhitney [CompactSpace M]
    (c : StrongCkControl I M n) (f : C^n⟮I, M; 𝓘(𝕜, F), F⟯) :
    IsOpen (c.ball f) := by
  have hfin : {i | (c.compact i : Set (extChartAt I (c.center i)).target).Nonempty}.Finite := by
    simpa only [image_nonempty] using c.locallyFinite.finite_nonempty_of_compact
  have hball : c.ball f =
      ⋂ i ∈ {i | (c.compact i : Set (extChartAt I (c.center i)).target).Nonempty},
        (chartCkSeminorm (F := F) (c.center i) (c.compact i) c.order c.order_le).ball f
          (c.tolerance i) := by
    refine Subset.antisymm (fun g hg ↦ mem_iInter₂.mpr fun i _ ↦ mem_iInter.mp hg i) ?_
    refine fun g hg ↦ mem_iInter.mpr fun i ↦ ?_
    by_cases hi : (c.compact i : Set (extChartAt I (c.center i)).target).Nonempty
    · exact mem_iInter₂.mp hg i hi
    · exact (mem_ball_chartCkSeminorm_iff _ _ _ _ f g (c.tolerance_pos i)).mpr
        fun m hm z hz ↦ absurd ⟨z, hz⟩ hi
  rw [hball]
  exact hfin.isOpen_biInter fun i _ ↦ isOpen_ball_chartCkSeminorm _ _ _ _ f _

/-- **On a compact manifold the strong and weak Whitney topologies agree.** -/
theorem manifoldStrongWhitneyTopology_eq_manifoldWeakWhitneyTopology [CompactSpace M] :
    (manifoldStrongWhitneyTopology : TopologicalSpace C^n⟮I, M; 𝓘(𝕜, F), F⟯) =
      manifoldWeakWhitneyTopology :=
  le_antisymm manifoldStrongWhitneyTopology_le_manifoldWeakWhitneyTopology <|
    le_generateFrom <| by
      rintro _ ⟨c, f, rfl⟩
      exact c.isOpen_ball_manifoldWeakWhitney f

end Compact

end ContMDiffMap

namespace TauCeti

-- Select the strong Whitney topology on vector-valued maps.
scoped[TauCeti.ManifoldStrongWhitney] attribute [instance 1100]
  ContMDiffMap.manifoldStrongWhitneyTopology

-- Separation travels with the topology the scope selects.
scoped[TauCeti.ManifoldStrongWhitney] attribute [instance]
  ContMDiffMap.t2Space_manifoldStrongWhitney

end TauCeti
