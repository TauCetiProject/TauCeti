module

public import Mathlib.Geometry.Manifold.Algebra.SmoothFunctions
public import TauCeti.Geometry.Manifold.Algebra.SmoothFunctions
public import TauCeti.RingTheory.Derivation.Coordinates
import Mathlib.Analysis.Calculus.FDeriv.Symmetric
import TauCeti.Geometry.Manifold.ContMDiffMap.Hadamard

/-!
# Differential operators on a finite-dimensional space in coordinates

Let `E` be a finite-dimensional real normed space with a basis `b`, indexed by a finite type `ι`.
On the algebra `C^∞(E)` of smooth real functions, the coordinate functions `uᵢ` of `b`
(`Module.Basis.smoothCoord`) and the partial derivatives `∂ᵢ f = df(bᵢ)` along the basis vectors
(`TauCeti.lineDerivation`) are dual: `∂ᵢ uⱼ = δᵢⱼ`, and the `∂ᵢ` commute by the symmetry of
second derivatives. By Hadamard's lemma the functions vanishing at a point `x` form the ideal
generated by the `uᵢ - uᵢ(x)`, and a smooth function vanishing at every point is zero.

These are the hypotheses of `TauCeti.mem_differentialOperators_iff_exists_eq_coordinateOperator`,
so a linear endomorphism `D` of `C^∞(E)` is a differential operator of order at most `m` in
Grothendieck's sense, that is, all its `(m + 1)`-fold commutators with multiplication operators
vanish, if and only if it is a finite coordinate expression

`D f = ∑_{|α| ≤ m} c_α ∂^α f`

with smooth coefficients `c_α`; the coefficients are unique. No continuity of `D` is assumed.

## Main definitions

* `TauCeti.lineDerivation 𝕜 v`: the derivation `f ↦ (x ↦ df_x v)` of `C^∞(E)`.
* `Module.Basis.smoothCoord b i`: the `i`-th coordinate function of `b`, as a smooth function.

## Main results

* `Module.Basis.eq_coordinateOperator_coordinateCoeff`: a differential operator of order at most
  `m` is the coordinate expression with the explicit coefficients `TauCeti.coordinateCoeff`.
* `Module.Basis.mem_differentialOperators_iff_exists_eq_coordinateOperator`: the differential
  operators of order at most `m` are exactly the coordinate expressions of order `m`.
* `Module.Basis.coordinateOperator_eq_zero_iff`: the coefficients of a coordinate expression of
  order `m` are unique.

## References

* I. Kolář, P. W. Michor, J. Slovák, *Natural Operations in Differential Geometry*, Springer,
  1993, §§12, 19.
* A. Grothendieck, *Éléments de géométrie algébrique IV*, Quatrième partie, §16.8.
-/

public section

open Finset
open scoped ContDiff Manifold

noncomputable section

namespace TauCeti

section LineDerivation

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜] {E : Type*} [NormedAddCommGroup E]
  [NormedSpace 𝕜 E]

variable (𝕜) in
/-- Differentiation of smooth functions on `E` in the direction `v`, `f ↦ (x ↦ df_x v)`, as a
derivation of `C^∞(E)`. -/
def lineDerivation (v : E) : Derivation 𝕜 C^∞⟮𝓘(𝕜, E), E; 𝕜⟯ C^∞⟮𝓘(𝕜, E), E; 𝕜⟯ :=
  Derivation.mk'
    { toFun := fun f ↦ ⟨fun x ↦ fderiv 𝕜 f x v,
        ((f.contMDiff.contDiff.fderiv_right (m := ∞) (by simp)).clm_apply
          contDiff_const).contMDiff⟩
      map_add' := fun f g ↦ by
        ext x
        -- Unfold the smooth-function wrappers to use linearity of `fderiv`.
        change fderiv 𝕜 (⇑f + ⇑g) x v = fderiv 𝕜 f x v + fderiv 𝕜 g x v
        rw [fderiv_add ((f.contMDiff.contDiff.differentiable (by simp)) x)
          ((g.contMDiff.contDiff.differentiable (by simp)) x)]
        rfl
      map_smul' := fun c f ↦ by
        ext x
        -- Unfold the smooth-function wrappers to use homogeneity of `fderiv`.
        change fderiv 𝕜 (c • ⇑f) x v = c • fderiv 𝕜 f x v
        rw [fderiv_const_smul ((f.contMDiff.contDiff.differentiable (by simp)) x)]
        rfl }
    fun f g ↦ by
      ext x
      -- Unfold the smooth-function wrappers to use the product rule for `fderiv`.
      change fderiv 𝕜 (⇑f * ⇑g) x v = f x * fderiv 𝕜 g x v + g x * fderiv 𝕜 f x v
      rw [fderiv_mul ((f.contMDiff.contDiff.differentiable (by simp)) x)
        ((g.contMDiff.contDiff.differentiable (by simp)) x)]
      simp

@[simp]
theorem lineDerivation_apply_apply (v : E) (f : C^∞⟮𝓘(𝕜, E), E; 𝕜⟯) (x : E) :
    lineDerivation 𝕜 v f x = fderiv 𝕜 f x v :=
  (rfl)

/-- Directional derivatives of smooth functions commute, by the symmetry of second
derivatives. -/
theorem commute_lineDerivation {𝕜 : Type*} [RCLike 𝕜] {E : Type*} [NormedAddCommGroup E]
    [NormedSpace 𝕜 E] (v w : E) :
    Commute (lineDerivation 𝕜 v : Module.End 𝕜 C^∞⟮𝓘(𝕜, E), E; 𝕜⟯) (lineDerivation 𝕜 w) := by
  refine LinearMap.ext fun f ↦ ContMDiffMap.ext fun x ↦ ?_
  have hf : ContDiff 𝕜 ∞ f := f.contMDiff.contDiff
  have hdf : DifferentiableAt 𝕜 (fderiv 𝕜 f) x :=
    (hf.fderiv_right (m := ∞) (by simp)).differentiable (by simp) x
  simp only [mul_apply_eq_comp, Derivation.coeFn_coe, lineDerivation_apply_apply]
  -- Unfold the smooth-function wrappers to the iterated directional derivatives.
  change fderiv 𝕜 (fun y ↦ fderiv 𝕜 f y w) x v = fderiv 𝕜 (fun y ↦ fderiv 𝕜 f y v) x w
  rw [fderiv_clm_apply hdf (differentiableAt_const w),
    fderiv_clm_apply hdf (differentiableAt_const v)]
  simp [(hf.contDiffAt.isSymmSndFDerivAt (by simp)).eq v w]

end LineDerivation

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- A smooth function on `E` lying in `ker (ev x) • C^∞(E)` for every point `x` is zero. -/
theorem _root_.ContMDiffMap.eq_zero_of_forall_mem_ker_evalAlgHom_smul_top
    (f : C^∞⟮𝓘(ℝ, E), E; ℝ⟯)
    (hf : ∀ x, f ∈ RingHom.ker (ContMDiffMap.evalAlgHom x : C^∞⟮𝓘(ℝ, E), E; ℝ⟯ →ₐ[ℝ] ℝ) •
      (⊤ : Submodule C^∞⟮𝓘(ℝ, E), E; ℝ⟯ C^∞⟮𝓘(ℝ, E), E; ℝ⟯)) :
    f = 0 := by
  ext x
  have := hf x
  rw [Ideal.smul_eq_mul, Ideal.mul_top] at this
  simpa using this

end TauCeti

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

namespace Module.Basis

variable [FiniteDimensional ℝ E] {ι : Type*} (b : Module.Basis ι ℝ E)

/-- The `i`-th coordinate function of a basis `b` of a finite-dimensional space, as a smooth
function. -/
def smoothCoord (i : ι) : C^∞⟮𝓘(ℝ, E), E; ℝ⟯ :=
  ⟨b.coord i, (LinearMap.toContinuousLinearMap (b.coord i)).contDiff.contMDiff⟩

@[simp]
theorem smoothCoord_apply (i : ι) (x : E) : b.smoothCoord i x = b.coord i x :=
  (rfl)

/-- The partial derivatives along a basis are dual to its coordinate functions. -/
theorem lineDerivation_smoothCoord [DecidableEq ι] (i j : ι) :
    TauCeti.lineDerivation ℝ (b i) (b.smoothCoord j) = if j = i then 1 else 0 := by
  ext x
  have : fderiv ℝ (b.coord j) x = LinearMap.toContinuousLinearMap (b.coord j) :=
    (LinearMap.toContinuousLinearMap (b.coord j)).fderiv
  rw [TauCeti.lineDerivation_apply_apply]
  -- Unfold the smooth coordinate function to the linear coordinate functional.
  change fderiv ℝ (b.coord j) x (b i) = _
  rw [this, LinearMap.coe_toContinuousLinearMap', coord_apply, repr_self]
  split_ifs with h <;> simp [h]

/-- **Hadamard's lemma.** The smooth functions vanishing at `x` form the ideal generated by the
coordinate functions of `b`, each taken relative to its value at `x`. -/
theorem ker_evalAlgHom_le_span [Finite ι] (x : E) :
    RingHom.ker (ContMDiffMap.evalAlgHom x : C^∞⟮𝓘(ℝ, E), E; ℝ⟯ →ₐ[ℝ] ℝ) ≤
      Ideal.span (Set.range fun i ↦ b.smoothCoord i -
        algebraMap ℝ C^∞⟮𝓘(ℝ, E), E; ℝ⟯ (ContMDiffMap.evalAlgHom x (b.smoothCoord i))) := by
  have : Fintype ι := Fintype.ofFinite ι
  intro f hf
  rw [RingHom.mem_ker, ContMDiffMap.evalAlgHom_apply] at hf
  obtain ⟨a, -, ha⟩ := ContMDiffMap.exists_hadamard_coords f x b
  have h := TauCeti.sub_algebraMap_eq_sum_mul_sub_algebraMap x f a b.smoothCoord ha
  rw [hf, map_zero, sub_zero] at h
  rw [h]
  exact sum_mem fun i _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, by simp⟩)

variable [Fintype ι] [DecidableEq ι]

/-- **Differential operators in coordinates.** A differential operator of order at most `m` on
`C^∞(E)`, in the sense of iterated commutators with multiplication operators, is the coordinate
expression `f ↦ ∑_{|α| ≤ m} c_α ∂^α f` in the partial derivatives along the basis `b`, with the
smooth coefficients `c = TauCeti.coordinateCoeff b.smoothCoord D`. -/
theorem eq_coordinateOperator_coordinateCoeff {D : C^∞⟮𝓘(ℝ, E), E; ℝ⟯ →ₗ[ℝ] C^∞⟮𝓘(ℝ, E), E; ℝ⟯}
    {m : ℕ} (hD : D ∈ TauCeti.differentialOperators ℝ C^∞⟮𝓘(ℝ, E), E; ℝ⟯ C^∞⟮𝓘(ℝ, E), E; ℝ⟯
      C^∞⟮𝓘(ℝ, E), E; ℝ⟯ m) :
    D = TauCeti.coordinateOperator (fun i ↦ TauCeti.lineDerivation ℝ (b i))
      (fun i j ↦ TauCeti.commute_lineDerivation (b i) (b j)) m
      (TauCeti.coordinateCoeff b.smoothCoord D) :=
  TauCeti.eq_coordinateOperator_coordinateCoeff _ _ b.lineDerivation_smoothCoord
    (fun x : E ↦ ContMDiffMap.evalAlgHom x) b.ker_evalAlgHom_le_span
    ContMDiffMap.eq_zero_of_forall_mem_ker_evalAlgHom_smul_top hD

/-- **Differential operators in coordinates.** A linear endomorphism of `C^∞(E)` is a
differential operator of order at most `m`, in the sense of iterated commutators with
multiplication operators, if and only if it is a coordinate expression
`f ↦ ∑_{|α| ≤ m} c_α ∂^α f` with smooth coefficients, in the partial derivatives along the
basis `b`. -/
theorem mem_differentialOperators_iff_exists_eq_coordinateOperator
    {D : C^∞⟮𝓘(ℝ, E), E; ℝ⟯ →ₗ[ℝ] C^∞⟮𝓘(ℝ, E), E; ℝ⟯} {m : ℕ} :
    D ∈ TauCeti.differentialOperators ℝ C^∞⟮𝓘(ℝ, E), E; ℝ⟯ C^∞⟮𝓘(ℝ, E), E; ℝ⟯
        C^∞⟮𝓘(ℝ, E), E; ℝ⟯ m ↔
      ∃ c, D = TauCeti.coordinateOperator (fun i ↦ TauCeti.lineDerivation ℝ (b i))
        (fun i j ↦ TauCeti.commute_lineDerivation (b i) (b j)) m c :=
  TauCeti.mem_differentialOperators_iff_exists_eq_coordinateOperator _ _
    b.lineDerivation_smoothCoord (fun x : E ↦ ContMDiffMap.evalAlgHom x) b.ker_evalAlgHom_le_span
    ContMDiffMap.eq_zero_of_forall_mem_ker_evalAlgHom_smul_top

/-- **Uniqueness of coordinate expressions.** A coordinate expression of order `m` on `C^∞(E)`
in the partial derivatives along `b` vanishes only when its coefficients `c_α`, `|α| ≤ m`,
vanish. -/
theorem coordinateOperator_eq_zero_iff {m : ℕ} {c : (ι → ℕ) → C^∞⟮𝓘(ℝ, E), E; ℝ⟯} :
    TauCeti.coordinateOperator (fun i ↦ TauCeti.lineDerivation ℝ (b i))
        (fun i j ↦ TauCeti.commute_lineDerivation (b i) (b j)) m c = 0 ↔
      ∀ α : ι → ℕ, ∑ i, α i ≤ m → c α = 0 :=
  TauCeti.coordinateOperator_eq_zero_iff _ _ b.lineDerivation_smoothCoord
    (fun x : E ↦ ContMDiffMap.evalAlgHom x)
    ContMDiffMap.eq_zero_of_forall_mem_ker_evalAlgHom_smul_top

end Module.Basis
