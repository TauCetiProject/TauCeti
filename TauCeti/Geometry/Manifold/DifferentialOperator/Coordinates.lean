module

public import TauCeti.Geometry.Manifold.Algebra.SmoothFunctions
public import TauCeti.Geometry.Manifold.VectorField.Derivation
public import TauCeti.RingTheory.Derivation.Coordinates
import TauCeti.Geometry.Manifold.Algebra.VanishingIdeal.Basic

/-!
# Differential operators on a finite-dimensional space in coordinates

Let `E` be a finite-dimensional real normed space with a basis `b`, indexed by a finite type `ι`.
On the algebra `C^∞(E)` of smooth real functions, the coordinate functions `uᵢ` of `b`
(`Module.Basis.smoothCoord`) and the partial derivatives `∂ᵢ f = df(bᵢ)` along the basis vectors
(`TauCeti.lineDerivation`) are dual: `∂ᵢ uⱼ = δᵢⱼ`, and the `∂ᵢ` commute by the symmetry of
second derivatives. By Hadamard's lemma the functions vanishing at a point `x` form the ideal
generated by the `uᵢ - uᵢ(x)`, and a smooth function vanishing at every point is zero.

These are the hypotheses of `TauCeti.mem_differentialOperators_iff_exists_eq_coordinateOperator`,
so a linear endomorphism `D` of `C^∞(E)` is a differential operator of order at most `m` in
Grothendieck's sense, that is, all its `(m + 1)`-fold commutators with multiplication operators
vanish, if and only if it is a finite coordinate expression

`D f = ∑_{|α| ≤ m} c_α ∂^α f`

with smooth coefficients `c_α`; the coefficients are unique. No continuity of `D` is assumed.

## Main results

* `Module.Basis.eq_coordinateOperator_coordinateCoeff`: a differential operator of order at most
  `m` is the coordinate expression with the explicit coefficients `TauCeti.coordinateCoeff`.
* `Module.Basis.mem_differentialOperators_iff_exists_eq_coordinateOperator`: the differential
  operators of order at most `m` are exactly the coordinate expressions of order `m`.
* `Module.Basis.coordinateOperator_eq_zero_iff`: the coefficients of a coordinate expression of
  order `m` are unique.

## References

* I. Kolář, P. W. Michor, J. Slovák, *Natural Operations in Differential Geometry*, Springer,
  1993, §§12, 19.
* A. Grothendieck, *Éléments de géométrie algébrique IV*, Quatrième partie, §16.8.
-/

public section

open Finset
open scoped ContDiff Manifold

noncomputable section

namespace Module.Basis

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {ι : Type*} [Fintype ι] [DecidableEq ι] (b : Module.Basis ι ℝ E)

omit [Fintype ι] [DecidableEq ι] in
/-- Hadamard's lemma in the form used by the algebraic characterization: the kernel of
evaluation at `x` lies in the ideal generated by the coordinate functions of `b`, each taken
relative to its value at `x`. -/
private theorem ker_evalAlgHom_le_span [Finite ι] (x : E) :
    RingHom.ker (ContMDiffMap.evalAlgHom x : C^∞⟮𝓘(ℝ, E), E; ℝ⟯ →ₐ[ℝ] ℝ) ≤
      Ideal.span (Set.range fun i ↦ b.smoothCoord i -
        algebraMap ℝ C^∞⟮𝓘(ℝ, E), E; ℝ⟯ (ContMDiffMap.evalAlgHom x (b.smoothCoord i))) :=
  fun f hf ↦ (b.smoothVanishingIdeal_eq_span x).le <| TauCeti.mem_smoothVanishingIdeal_iff.2 <|
    (ContMDiffMap.evalAlgHom_apply ℝ x f).symm.trans (RingHom.mem_ker.1 hf)

/-- **Differential operators in coordinates.** A differential operator of order at most `m` on
`C^∞(E)`, in the sense of iterated commutators with multiplication operators, is the coordinate
expression `f ↦ ∑_{|α| ≤ m} c_α ∂^α f` in the partial derivatives along the basis `b`, with the
smooth coefficients `c = TauCeti.coordinateCoeff b.smoothCoord D`. -/
theorem eq_coordinateOperator_coordinateCoeff {D : C^∞⟮𝓘(ℝ, E), E; ℝ⟯ →ₗ[ℝ] C^∞⟮𝓘(ℝ, E), E; ℝ⟯}
    {m : ℕ} (hD : D ∈ TauCeti.differentialOperators ℝ C^∞⟮𝓘(ℝ, E), E; ℝ⟯ C^∞⟮𝓘(ℝ, E), E; ℝ⟯
      C^∞⟮𝓘(ℝ, E), E; ℝ⟯ m) :
    D = TauCeti.coordinateOperator (fun i ↦ TauCeti.lineDerivation ℝ (b i))
      (fun i j ↦ TauCeti.commute_lineDerivation (b i) (b j)) m
      (TauCeti.coordinateCoeff b.smoothCoord D) :=
  TauCeti.eq_coordinateOperator_coordinateCoeff _ _ b.lineDerivation_smoothCoord
    (fun x : E ↦ ContMDiffMap.evalAlgHom x) b.ker_evalAlgHom_le_span
    ContMDiffMap.eq_zero_of_forall_mem_ker_evalAlgHom_smul_top hD

/-- **Differential operators in coordinates.** A linear endomorphism of `C^∞(E)` is a
differential operator of order at most `m`, in the sense of iterated commutators with
multiplication operators, if and only if it is a coordinate expression
`f ↦ ∑_{|α| ≤ m} c_α ∂^α f` with smooth coefficients, in the partial derivatives along the
basis `b`. -/
theorem mem_differentialOperators_iff_exists_eq_coordinateOperator
    {D : C^∞⟮𝓘(ℝ, E), E; ℝ⟯ →ₗ[ℝ] C^∞⟮𝓘(ℝ, E), E; ℝ⟯} {m : ℕ} :
    D ∈ TauCeti.differentialOperators ℝ C^∞⟮𝓘(ℝ, E), E; ℝ⟯ C^∞⟮𝓘(ℝ, E), E; ℝ⟯
        C^∞⟮𝓘(ℝ, E), E; ℝ⟯ m ↔
      ∃ c, D = TauCeti.coordinateOperator (fun i ↦ TauCeti.lineDerivation ℝ (b i))
        (fun i j ↦ TauCeti.commute_lineDerivation (b i) (b j)) m c :=
  TauCeti.mem_differentialOperators_iff_exists_eq_coordinateOperator _ _
    b.lineDerivation_smoothCoord (fun x : E ↦ ContMDiffMap.evalAlgHom x)
    b.ker_evalAlgHom_le_span
    ContMDiffMap.eq_zero_of_forall_mem_ker_evalAlgHom_smul_top

/-- **Uniqueness of coordinate expressions.** A coordinate expression of order `m` on `C^∞(E)`
in the partial derivatives along `b` vanishes only when its coefficients `c_α`, `|α| ≤ m`,
vanish. -/
theorem coordinateOperator_eq_zero_iff {m : ℕ} {c : (ι → ℕ) → C^∞⟮𝓘(ℝ, E), E; ℝ⟯} :
    TauCeti.coordinateOperator (fun i ↦ TauCeti.lineDerivation ℝ (b i))
        (fun i j ↦ TauCeti.commute_lineDerivation (b i) (b j)) m c = 0 ↔
      ∀ α : ι → ℕ, ∑ i, α i ≤ m → c α = 0 :=
  TauCeti.coordinateOperator_eq_zero_iff _ _ b.lineDerivation_smoothCoord
    (fun x : E ↦ ContMDiffMap.evalAlgHom x)
    ContMDiffMap.eq_zero_of_forall_mem_ker_evalAlgHom_smul_top

end Module.Basis
