import TauCeti.Geometry.Manifold.VectorField.Regularity

/-!
# The translation flow of the circle `AddCircle p`

For a positive real `p`, the real line acts on the circle `AddCircle p = ℝ ⧸ pℤ` by translation:
time `t` moves `x` to `x + [t]`. This is a flow of `ℝ` on the circle
(`AddCircle.translationFlow p`), jointly analytic in time and point, and periodic with period `p`:
the time-`t` map fixes a point, equivalently is the identity, exactly when `t` is an integer
multiple of `p`.

The flow is generated by the unit vector field `∂_t` of the circle
(`AddCircle.timeVectorField p`). The charts of `AddCircle p` are local real lifts, so each tangent
space of `AddCircle p` is the real line, and `∂_t` is the constant vector `1`. The quotient map
`ℝ → AddCircle p` has derivative the identity (`AddCircle.mfderiv_coe`), so it sends the coordinate
field of `ℝ` to `∂_t`. The field `∂_t` is analytic and dual to the time form, `dt_p(∂_t) = 1`, and
its integral curves are the translation orbits. So it is complete, and its flow is
`translationFlow p`. Its time-`t` maps are therefore the translations `x ↦ x + [t]`, as
diffeomorphisms of the circle (`TauCeti.globalFlowDiffeomorph`).

The translation flows of different circles are compatible with the maps between them: the
rescaling `AddCircle p ≃ AddCircle q` conjugates the time-`t` translation of `AddCircle p` to the
time-`(p⁻¹ * q) t` translation of `AddCircle q`, multiplication by an integer `k` intertwines
time `t` with time `k t`, and the covering map `AddCircle p → AddCircle q`, for `p` a multiple
of `q`, intertwines the two flows at equal times.

## Main definitions

* `AddCircle.translationFlow p`: the flow `(t, x) ↦ x + [t]` of `ℝ` on `AddCircle p`.
* `AddCircle.timeVectorField p`: the unit vector field `∂_t` of `AddCircle p`.

## Main results

* `AddCircle.contMDiff_translationFlow`: the translation flow is jointly `C^n` for every `n`,
  including analytic.
* `AddCircle.translationFlow_apply_eq_self_iff`, `AddCircle.translationFlow_eq_id_iff`,
  `AddCircle.translationFlow_add_period`: the time-`t` map fixes a point, equivalently is the
  identity, exactly when `t ∈ pℤ`; in particular the flow has period `p`.
* `AddCircle.hasMFDerivAt_add_coe_comp`: the velocity of a curve `s ↦ x + [f s]`.
* `AddCircle.isMIntegralCurve_translationFlow`: the orbits of the flow are integral curves of
  `∂_t`.
* `AddCircle.contMDiff_timeVectorField`: `∂_t` is a `C^n` section of the tangent bundle for every
  `n`, including analytic.
* `AddCircle.timeForm_apply_timeVectorField`: `dt_p(∂_t) = 1`.
* `AddCircle.isCompleteVectorField_timeVectorField`, `AddCircle.globalFlow_timeVectorField`:
  `∂_t` is complete, and its flow is the translation flow.
* `AddCircle.diffeomorphAddCircle_translationFlow`, `AddCircle.zsmul_translationFlow`,
  `AddCircle.coverMap_translationFlow`: the rescalings, integer multiplications and covering maps
  intertwine the translation flows, rescaling time by `p⁻¹ * q`, `k` and `1` respectively.

## References

* John M. Lee, *Introduction to Smooth Manifolds*, second edition, Graduate Texts in
  Mathematics 218, Springer, 2013, Chapter 9 (flows and their infinitesimal generators).
-/

public section

noncomputable section

open Function
open scoped Manifold ContDiff

namespace AddCircle

variable (p : ℝ)

/-! ### The translation flow -/

/-- The translation flow of the circle `AddCircle p`: time `t` moves `x` to `x + [t]`. -/
def translationFlow : Flow ℝ (AddCircle p) where
  toFun t x := x + (t : AddCircle p)
  cont' := continuous_snd.add (continuous_quotient_mk'.comp continuous_fst)
  map_add' t s x := by
    rw [coe_add]
    abel
  map_zero' x := by simp

/-- The translation flow at time `t` adds the class of `t`. -/
@[simp]
theorem translationFlow_apply (t : ℝ) (x : AddCircle p) :
    translationFlow p t x = x + (t : AddCircle p) :=
  (rfl)

/-- The time-`t` map of the translation flow fixes the point `x` exactly when `t` is an integer
multiple of the period `p`. -/
theorem translationFlow_apply_eq_self_iff {t : ℝ} {x : AddCircle p} :
    translationFlow p t x = x ↔ t ∈ AddSubgroup.zmultiples p := by
  rw [translationFlow_apply, add_eq_left, coe_eq_zero_iff, AddSubgroup.mem_zmultiples_iff]

/-- The time-`t` map of the translation flow is the identity exactly when `t` is an integer
multiple of the period `p`. -/
theorem translationFlow_eq_id_iff {t : ℝ} :
    translationFlow p t = id ↔ t ∈ AddSubgroup.zmultiples p :=
  ⟨fun h ↦ (translationFlow_apply_eq_self_iff p).1 (congrFun h 0),
    fun h ↦ funext fun _ ↦ (translationFlow_apply_eq_self_iff p).2 h⟩

/-- The translation flow has period `p`. -/
@[simp]
theorem translationFlow_add_period (t : ℝ) :
    translationFlow p (t + p) = translationFlow p t := by
  funext x
  simp

/-- Multiplication by an integer `k` intertwines the time-`t` translation of `AddCircle p` with the
time-`k t` translation. -/
theorem zsmul_translationFlow (k : ℤ) (t : ℝ) (x : AddCircle p) :
    k • translationFlow p t x = translationFlow p (k * t) (k • x) := by
  rw [translationFlow_apply, translationFlow_apply, smul_add, ← coe_zsmul, zsmul_eq_mul]

/-- For `p` an integer multiple of `q`, the covering map `AddCircle p → AddCircle q` intertwines
the translation flows of the two circles at equal times. -/
theorem coverMap_translationFlow {q : ℝ} (h : p ∈ AddSubgroup.zmultiples q)
    (t : ℝ) (x : AddCircle p) :
    coverMap h (translationFlow p t x) = translationFlow q t (coverMap h x) := by
  rw [translationFlow_apply, map_add, coverMap_coe, translationFlow_apply]

variable [Fact (0 < p)]

/-- The translation flow is jointly `C^n` in time and point, for every `n`, including analytic. -/
theorem contMDiff_translationFlow {n : ℕ∞ω} :
    ContMDiff (𝓘(ℝ).prod 𝓘(ℝ)) 𝓘(ℝ) n (uncurry (translationFlow p)) :=
  contMDiff_snd.add ((contMDiff_coe p n).comp contMDiff_fst)

/-! ### The unit vector field -/

/-- The unit vector field `∂_t` of the circle `AddCircle p`. Each tangent space of `AddCircle p`
is the real line, read through the charts, which are local real lifts, and `∂_t` is the constant
vector `1`. It generates the translation flow (`AddCircle.globalFlow_timeVectorField`). -/
def timeVectorField (x : AddCircle p) : TangentSpace 𝓘(ℝ) x :=
  (1 : ℝ)

/-- The unit vector field `∂_t` is the vector `1` of each tangent line. -/
@[simp]
theorem timeVectorField_apply (x : AddCircle p) : timeVectorField p x = (1 : ℝ) :=
  (rfl)

/-- The time form is dual to the unit vector field: `dt_p(∂_t) = 1`. -/
theorem timeForm_apply_timeVectorField (x : AddCircle p) :
    (timeForm p).1 x ![timeVectorField p x] = 1 := by
  simp

variable {p} in
/-- If `f : ℝ → ℝ` has derivative `f'` at `t`, the curve `s ↦ x + [f s]` of `AddCircle p` has
velocity `f'` at `t`, read in the tangent line of `AddCircle p`. -/
theorem hasMFDerivAt_add_coe_comp {f : ℝ → ℝ} {f' t : ℝ} (hf : HasDerivAt f f' t)
    (x : AddCircle p) :
    HasMFDerivAt 𝓘(ℝ) 𝓘(ℝ) (fun s ↦ x + (f s : AddCircle p)) t
      ((1 : ℝ →L[ℝ] ℝ).smulRight f') := by
  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk_surjective x
  -- The curve is the image of the real curve `s ↦ a + f s` under the quotient map, whose
  -- derivative is the identity.
  have h : (fun s ↦ (a : AddCircle p) + (f s : AddCircle p)) =
      ((↑) : ℝ → AddCircle p) ∘ fun s ↦ a + f s :=
    funext fun s ↦ (coe_add p a (f s)).symm
  rw [h]
  exact ((hasMFDerivAt_coe p (a + f t)).comp t
    (hf.const_add a).hasFDerivAt.hasMFDerivAt).congr_mfderiv (ContinuousLinearMap.id_comp _)

/-- The orbits of the translation flow are integral curves of the unit vector field `∂_t`, defined
for all time. -/
theorem isMIntegralCurve_translationFlow (x : AddCircle p) :
    IsMIntegralCurve (fun t ↦ translationFlow p t x) (timeVectorField p) :=
  fun t ↦ hasMFDerivAt_add_coe_comp (hasDerivAt_id t) x

/-- The unit vector field `∂_t` is a `C^n` section of the tangent bundle of `AddCircle p`, for
every `n`, including analytic. -/
theorem contMDiff_timeVectorField {n : ℕ∞ω} :
    ContMDiff 𝓘(ℝ) 𝓘(ℝ).tangent n
      (fun x ↦ (⟨x, timeVectorField p x⟩ : TangentBundle 𝓘(ℝ) (AddCircle p))) := by
  -- Through the quotient map, a surjective analytic local diffeomorphism, the field is the
  -- lifted derivative `t ↦ ([t], d(↑)_t 1)` of the quotient map.
  rw [← (isLocalDiffeomorph_coe p ω).contMDiff_comp_iff QuotientAddGroup.mk_surjective le_top]
  refine (contMDiffOn_univ.1 (((contMDiff_coe p ω).contMDiffOn (s := Set.univ)
    ).contMDiffOn_totalSpaceMk_mfderiv_apply (m := n) le_top isOpen_univ (1 : ℝ))).congr
    fun t ↦ ?_
  rw [mfderiv_coe]
  rfl

/-- The unit vector field `∂_t` of the circle is complete. -/
theorem isCompleteVectorField_timeVectorField : TauCeti.IsCompleteVectorField (timeVectorField p) :=
  TauCeti.isCompleteVectorField_of_compactSpace ((contMDiff_timeVectorField p).of_le le_top)

/-- The flow of the unit vector field `∂_t` is the translation flow. Hence the time-`t` maps
`TauCeti.globalFlowDiffeomorph` of the flow of `∂_t` are the translations `x ↦ x + [t]`. -/
@[simp]
theorem globalFlow_timeVectorField :
    TauCeti.globalFlow (timeVectorField p) ((contMDiff_timeVectorField p).of_le le_top)
      (isCompleteVectorField_timeVectorField p) = translationFlow p :=
  Flow.ext fun t x ↦ by
    simpa using TauCeti.globalFlow_eq_of_isMIntegralCurve
      ((contMDiff_timeVectorField p).of_le le_top) (isCompleteVectorField_timeVectorField p)
      (isMIntegralCurve_translationFlow p x) t

/-! ### Compatibility with maps of circles -/

/-- The rescaling `AddCircle p ≃ AddCircle q` conjugates the time-`t` translation of `AddCircle p`
to the time-`(p⁻¹ * q) t` translation of `AddCircle q`. -/
theorem diffeomorphAddCircle_translationFlow (q : ℝ) [Fact (0 < q)] (n : ℕ∞ω) (t : ℝ)
    (x : AddCircle p) :
    diffeomorphAddCircle p q n (translationFlow p t x) =
      translationFlow q (t * (p⁻¹ * q)) (diffeomorphAddCircle p q n x) := by
  rw [translationFlow_apply, diffeomorphAddCircle_add, diffeomorphAddCircle_apply_mk,
    translationFlow_apply]

end AddCircle
