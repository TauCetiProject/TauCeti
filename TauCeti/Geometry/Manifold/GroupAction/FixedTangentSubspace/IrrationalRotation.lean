module

public import Mathlib.Analysis.Complex.Isometry
public import Mathlib.NumberTheory.Real.Irrational
public import TauCeti.Geometry.Manifold.GroupAction.FixedTangentSubspace

import Mathlib.Data.ZMod.QuotientGroup
import Mathlib.LinearAlgebra.Complex.FiniteDimensional
import TauCeti.Analysis.Complex.Circle.Basic
import TauCeti.Topology.Algebra.ConstMulAction
import TauCeti.Topology.Algebra.Module.FiniteDimension

/-!
# The fixed set of a rotation of the first factor of `ℂ × ℂ`

For a unit complex number `c`, the map `(z, w) ↦ (c z, w)` (`TauCeti.rotationFst c`) rotates the
first factor of `ℂ × ℂ` and fixes the second. Let `K` be the cyclic group it generates, acting on
`ℂ × ℂ` by real linear maps. For `c ≠ 1`:

* the fixed set of `K` is the complex line `{0} × ℂ`
  (`TauCeti.fixedPoints_zpowers_rotationFst`);
* at each of its points the tangent vectors fixed by the differentials of `K` form the real plane
  `{0} × ℂ`, so the fixed set is the part of dimension `2` of the fixed set
  (`TauCeti.fixedPointsOfFinrank_zpowers_rotationFst`).

For `c = exp (2π i θ)` the group `K` is infinite exactly when `θ` is irrational
(`TauCeti.infinite_zpowers_rotationFst_exp_iff`). So an irrational rotation generates an infinite
cyclic group whose fixed set is a complex line, of constant tangent dimension `2`. Since the
rotation is unitary, it preserves the Euclidean metric and the standard symplectic form of `ℂ²`:
this is an instance of the fixed set of a group of symplectic isometries, which is a union of
symplectic submanifolds with tangent spaces the fixed tangent subspaces whether or not the group
is compact.

## Main definitions

* `TauCeti.rotationFst`: the rotation `(z, w) ↦ (c z, w)` of the first factor of `ℂ × ℂ`, as a
  homomorphism from the circle group.

## Main results

* `TauCeti.fixedPoints_zpowers_rotationFst`: for `c ≠ 1` the fixed set is `{0} × ℂ`.
* `TauCeti.fixedPointsOfFinrank_zpowers_rotationFst`: it is the part of dimension `2`.
* `TauCeti.infinite_zpowers_rotationFst_exp_iff`: the rotation by `exp (2π i θ)` generates an
  infinite group exactly when `θ` is irrational.

## References

* A. Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Homework 21, exercise 2 (fixed points of a group of symplectic isometries).
-/

public section

open Complex MulAction Set
open scoped Manifold

noncomputable section

namespace TauCeti

/-- The rotation `(z, w) ↦ (c z, w)` of the first factor of `ℂ × ℂ` by a unit complex number `c`,
as a real linear automorphism. -/
def rotationFst : Circle →* (ℂ × ℂ) ≃ₗ[ℝ] (ℂ × ℂ) where
  toFun c := (rotation c).toLinearEquiv.prodCongr (LinearEquiv.refl ℝ ℂ)
  map_one' := by ext <;> simp
  map_mul' c d := by ext <;> simp

@[simp]
theorem rotationFst_apply (c : Circle) (p : ℂ × ℂ) : rotationFst c p = (c * p.1, p.2) := (rfl)

theorem rotationFst_injective : Function.Injective rotationFst := fun c d h ↦
  Circle.ext (by simpa using congrArg (fun e : (ℂ × ℂ) ≃ₗ[ℝ] (ℂ × ℂ) ↦ (e (1, 0)).1) h)

/-- **The fixed set of a rotation of the first factor.** For `c ≠ 1`, the points of `ℂ × ℂ` fixed
by the group generated by `(z, w) ↦ (c z, w)` are those with first coordinate `0`. -/
theorem fixedPoints_zpowers_rotationFst {c : Circle} (hc : c ≠ 1) :
    fixedPoints (Subgroup.zpowers (rotationFst c)) (ℂ × ℂ) = {p | p.1 = 0} := by
  have hc' : (c : ℂ) ≠ 1 := fun h ↦ hc (Circle.ext (by simpa using h))
  ext p
  simp only [mem_fixedPoints, Subtype.forall, Subgroup.smul_def, Subgroup.forall_mem_zpowers,
    ← mem_fixedBy]
  rw [mem_fixedBy_zpowers_iff_mem_fixedBy, mem_fixedBy, LinearEquiv.smul_def,
    rotationFst_apply, Prod.ext_iff]
  simp only [and_true, mem_ofPred_eq]
  constructor
  · intro h
    have : ((c : ℂ) - 1) * p.1 = 0 := by linear_combination h
    exact (mul_eq_zero.1 this).resolve_left (sub_ne_zero.2 hc')
  · intro h
    simp [h]

/-- For `c ≠ 1`, the vectors of `ℂ × ℂ` invariant under the group generated by
`(z, w) ↦ (c z, w)` form the kernel of the first projection. -/
theorem invariants_zpowers_rotationFst {c : Circle} (hc : c ≠ 1) :
    (Representation.ofDistribMulAction ℝ (Subgroup.zpowers (rotationFst c)) (ℂ × ℂ)).invariants =
      LinearMap.ker (LinearMap.fst ℝ ℂ ℂ) := by
  ext p
  have := Set.ext_iff.1 (fixedPoints_zpowers_rotationFst hc) p
  simp only [mem_fixedPoints, mem_ofPred_eq] at this
  simpa [Representation.mem_invariants] using this

/-- **The fixed set of a rotation of the first factor has tangent dimension two.** For `c ≠ 1`,
the fixed set `{0} × ℂ` of the group generated by `(z, w) ↦ (c z, w)` is the part of its fixed set
at which the fixed tangent subspace has real dimension `2`. -/
theorem fixedPointsOfFinrank_zpowers_rotationFst {c : Circle} (hc : c ≠ 1) :
    fixedPointsOfFinrank 𝓘(ℝ, ℂ × ℂ) (Subgroup.zpowers (rotationFst c)) (ℂ × ℂ) 2 =
      {p | p.1 = 0} := by
  have h2 : Module.finrank ℝ (Representation.ofDistribMulAction ℝ
      (Subgroup.zpowers (rotationFst c)) (ℂ × ℂ)).invariants = 2 := by
    rw [invariants_zpowers_rotationFst hc, LinearMap.ker_fst,
      LinearMap.finrank_range_of_inj LinearMap.inr_injective, Complex.finrank_real_complex]
  rw [← h2, fixedPointsOfFinrank_finrank_invariants, fixedPoints_zpowers_rotationFst hc]

/-- **Irrational rotations generate infinite cyclic groups.** The rotation of the first factor of
`ℂ × ℂ` by `exp (2π i θ)` generates an infinite group exactly when `θ` is irrational. -/
theorem infinite_zpowers_rotationFst_exp_iff (θ : ℝ) :
    Infinite (Subgroup.zpowers (rotationFst (Circle.exp (2 * Real.pi * θ)))) ↔ Irrational θ := by
  rw [infinite_zpowers, rotationFst_injective.isOfFinOrder_iff,
    Circle.isOfFinOrder_exp_two_pi_mul_iff, not_not]

end TauCeti
