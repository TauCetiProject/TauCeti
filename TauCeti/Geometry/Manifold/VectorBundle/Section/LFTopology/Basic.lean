/-!
# Chart-generated LF topology on bundle test sections

This file identifies the fixed-compact inductive topology on compactly supported smooth bundle
sections (`ContMDiffSection.compactlySupportedTopology`) with the final locally convex topology
generated by chart extensions of native Euclidean test functions
(`ContMDiffSection.chartTestTopology`).

For a smooth chart `c : OpenPartialHomeomorph M E` subordinate to a smooth bundle frame `t`,
reverse chart extraction `Bundle.Trivialization.chartTestSupportedIn` is continuous from each
fixed-compact stage `supportedIn I F n V K` (with the compact derivative subspace topology) into
the native fixed-support test-function space `𝓓^{n}_{c '' K}(E, F)`
(`Bundle.Trivialization.continuous_chartTestSupportedIn`). On a finite-dimensional Hausdorff `C^n`
manifold (`n : ℕ∞`), a finite `C^n` partition of unity subordinate to any covering family of `C^n`
charts and frames decomposes every fixed-compact stage continuously into finitely many chart test
spaces, proving `ContMDiffSection.chartTestTopology_eq_compactlySupportedTopology`.

Consequently, a linear map from compactly supported smooth sections into any locally convex real
topological vector space is continuous if and only if its precomposition with every chart extension
is continuous on the corresponding Euclidean `TestFunction` space
(`ContMDiffSection.continuous_compactlySupportedTopology_iff_chartTestSection`, and its
cover-independent boundaryless form
`ContMDiffSection.continuous_compactlySupportedTopology_iff_forall_chartTestSection`).

## References

* L. Schwartz, *Théorie des distributions*, Hermann, 1966, Chapter I–III (LF test-function
  topologies and localizations).
* M. Hirsch, *Differential Topology*, GTM 33, Chapter 2, §1 (weak Whitney topologies).
-/

public noncomputable section

open Bundle Set Filter TopologicalSpace Topology
open scoped ContDiff Manifold Distributions TauCeti.ManifoldWeakWhitney

/-! ### Continuity of reverse chart extraction -/

namespace Bundle.Trivialization

open ContMDiffSection

variable {E H M F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  [TopologicalSpace M] [ChartedSpace H M]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {V : M → Type*} [∀ x, AddCommGroup (V x)] [∀ x, Module ℝ (V x)]
  [∀ x, TopologicalSpace (V x)] [TopologicalSpace (TotalSpace F V)]
  [FiberBundle F V] [VectorBundle ℝ F V]
  {n : ℕ∞} [ContMDiffVectorBundle n F V I]
  (t : Trivialization F (π F V)) [MemTrivializationAtlas t]
  (c : OpenPartialHomeomorph M E)
  (hc_symm : ContMDiffOn 𝓘(ℝ, E) I n c.symm c.target) (hct : c.source ⊆ t.baseSet)

private def chartSymmMap : C^n⟮𝓘(ℝ, E), (⟨c.target, c.open_target⟩ : Opens E);
    I, (⟨c.source, c.open_source⟩ : Opens M)⟯ :=
  ⟨fun y ↦ ⟨c.symm y, c.map_target y.2⟩,
    (TauCeti.ContMDiff.subtypeVal_comp_iff ⟨c.source, c.open_source⟩ _).mp
      (hc_symm.comp_contMDiff contMDiff_subtype_val fun y ↦ y.2)⟩

private theorem continuous_chartFrameCoordinates
    [LocallyCompactSpace E] [IsManifold I n M]
    {ι : Type*} (e : ι → Trivialization F (π F V)) [∀ i, MemTrivializationAtlas (e i)]
    (U : ι → Opens M) (hU : ∀ i, (U i : Set M) ⊆ (e i).baseSet)
    (hcover : ∀ x : M, ∃ i, x ∈ U i) :
    letI := frameTopology (I := I) (n := n) e U hU
    Continuous (fun s : Cₛ^n⟮I; F, V⟯ ↦
      (t.frameCoordinates (U := ⟨c.source, c.open_source⟩) hct s).comp
        (chartSymmMap c hc_symm)) := by
  let := frameTopology (I := I) (n := n) e U hU
  exact ContMDiffMap.continuous_comp_manifoldWeakWhitney.comp
    ((continuous_frameCoordinates_of_cover e U hU hcover t ⟨c.source, c.open_source⟩ hct).prodMk
      continuous_const)

private theorem chartIteratedFDeriv_chartFrameCoordinates_eq
    {K : Compacts M} (hK : (K : Set M) ⊆ c.source)
    (w₀ : (⟨c.target, c.open_target⟩ : Opens E)) (m : ℕ) (hm : (m : ℕ∞ω) ≤ (n : ℕ∞ω))
    (s : supportedIn I F n V K) (z : (extChartAt 𝓘(ℝ, E) w₀).target) :
    ContMDiffMap.chartIteratedFDeriv
        ((t.frameCoordinates (U := ⟨c.source, c.open_source⟩) hct s.1).comp
          (chartSymmMap c hc_symm)) w₀ m hm z =
      iteratedFDeriv ℝ m (t.chartTestSupportedIn c hc_symm hct hK s) z.1 := by
  have htarg : (extChartAt 𝓘(ℝ, E) w₀).target = c.target :=
    Opens.extChartAt_opens_target ⟨c.target, c.open_target⟩ w₀
  have hzt : (z : E) ∈ c.target := (Set.ext_iff.1 htarg z.1).1 z.2
  have hopen : IsOpen (extChartAt 𝓘(ℝ, E) w₀).target := by
    rw [htarg]
    exact c.open_target
  rw [ContMDiffMap.chartIteratedFDeriv_self_target_apply,
    iteratedFDerivWithin_of_isOpen m hopen z.2]
  refine (Filter.EventuallyEq.iteratedFDeriv ℝ ?_ m).self_of_nhds
  filter_upwards [c.open_target.mem_nhds hzt] with y hy
  simp only [Function.comp_apply, ContMDiffMap.comp_apply, frameCoordinates_apply,
    chartTestSupportedIn_apply_of_mem t c hc_symm hct hK s hy]
  rw [Opens.extChartAt_opens_symm_apply ⟨c.target, c.open_target⟩ w₀ hy]
  simp only [chartSymmMap, ContMDiffMap.coeFn_mk]
  exact (t.continuousLinearMapAt_apply_of_mem (R := ℝ) (hct (c.map_target hy))
    (s.1 (c.symm y))).symm

/-- Reverse chart extraction is continuous from the compact derivative subspace topology on a
fixed-compact stage `K ⊆ c.source` to the native fixed-support test-function space
`𝓓^{n}_{c '' K}(E, F)`. -/
theorem continuous_chartTestSupportedIn
    [LocallyCompactSpace E] [IsManifold I n M]
    {K : Compacts M} (hK : (K : Set M) ⊆ c.source)
    {ι : Type*} (e : ι → Trivialization F (π F V)) [∀ i, MemTrivializationAtlas (e i)]
    (U : ι → Opens M) (hU : ∀ i, (U i : Set M) ⊆ (e i).baseSet)
    (hcover : ∀ x : M, ∃ i, x ∈ U i) :
    letI := frameTopology (I := I) (n := n) e U hU
    Continuous (t.chartTestSupportedIn c hc_symm hct hK) := by
  let := frameTopology (I := I) (n := n) e U hU
  let := isTopologicalAddGroup_frameTopology (I := I) (n := n) e U hU
  let K' : Compacts E := c.compactsImage K hK
  have hK't : (K' : Set E) ⊆ c.target := c.compactsImage_subset_target K hK
  refine WithSeminorms.continuous_of_continuous_comp
    (ContDiffMapSupportedIn.withSeminorms ℝ E F n K') (t.chartTestSupportedIn c hc_symm hct hK)
    fun m ↦ ?_
  by_cases hm : (m : ℕ∞) ≤ n
  · rcases (K' : Set E).eq_empty_or_nonempty with hEmpty | ⟨y₀, hy₀⟩
    · refine (continuous_const (y := (0 : ℝ))).congr fun s ↦
        (le_antisymm ?_ (apply_nonneg _ _)).symm
      exact (ContDiffMapSupportedIn.seminorm_le_iff ℝ le_rfl m _).2 fun _ y hy ↦ by
        have hy' : y ∈ (K' : Set E) := hy
        rw [hEmpty] at hy'
        exact hy'.elim
    · let w₀ : (⟨c.target, c.open_target⟩ : Opens E) := ⟨y₀, hK't hy₀⟩
      have hψ : Continuous (fun s : supportedIn I F n V K ↦
          (t.frameCoordinates (U := ⟨c.source, c.open_source⟩) hct s.1).comp
            (chartSymmMap c hc_symm)) :=
        (continuous_chartFrameCoordinates t c hc_symm hct e U hU hcover).comp continuous_subtype_val
      have htarg : (extChartAt 𝓘(ℝ, E) w₀).target = c.target :=
        Opens.extChartAt_opens_target ⟨c.target, c.open_target⟩ w₀
      let K_tgt : Compacts (extChartAt 𝓘(ℝ, E) w₀).target :=
        ⟨Subtype.val ⁻¹' (K' : Set E),
          IsInducing.subtypeVal.isCompact_preimage' K'.isCompact fun y hy ↦
            ⟨⟨y, htarg.symm ▸ hK't hy⟩, rfl⟩⟩
      have hm' : (m : ℕ∞ω) ≤ (n : ℕ∞ω) := mod_cast hm
      refine ((ContMDiffMap.continuous_chartDerivativeSeminorm w₀ K_tgt m hm').comp hψ).congr
        fun s ↦ le_antisymm ?_ ?_
      · refine (ContMDiffMap.chartDerivativeSeminorm_le_iff w₀ K_tgt m hm' _
          (apply_nonneg _ _)).2 fun z _ ↦ ?_
        rw [chartIteratedFDeriv_chartFrameCoordinates_eq t c hc_symm hct hK w₀ m hm' s z]
        exact ContDiffMapSupportedIn.norm_iteratedFDeriv_apply_le_seminorm ℝ hm
      · refine (ContDiffMapSupportedIn.seminorm_le_iff ℝ (apply_nonneg _ _) m _).2
          fun _ y hy ↦ ?_
        let z : (extChartAt 𝓘(ℝ, E) w₀).target := ⟨y, htarg.symm ▸ hK't hy⟩
        rw [← chartIteratedFDeriv_chartFrameCoordinates_eq t c hc_symm hct hK w₀ m hm' s z]
        exact (ContMDiffMap.chartDerivativeSeminorm_le_iff w₀ K_tgt m hm' _
          (apply_nonneg _ _)).1 le_rfl z hy
  · refine (continuous_const (y := (0 : ℝ))).congr fun s ↦ ?_
    simp [ContDiffMapSupportedIn.seminorm_eq_bot_of_gt ℝ (not_le.1 hm)]

end Bundle.Trivialization

/-! ### Chart-generated LF topology and partition-of-unity identification -/

namespace ContMDiffSection

section ChartTestTopology

variable {E H M F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  [TopologicalSpace M] [ChartedSpace H M] [T2Space M]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {V : M → Type*} [∀ x, AddCommGroup (V x)] [∀ x, Module ℝ (V x)]
  [∀ x, TopologicalSpace (V x)] [TopologicalSpace (TotalSpace F V)]
  [FiberBundle F V] [VectorBundle ℝ F V]
  {n : ℕ∞} [ContMDiffVectorBundle n F V I]
  {κ : Type*} (t : κ → Trivialization F (π F V)) [∀ j, MemTrivializationAtlas (t j)]
  (c : κ → OpenPartialHomeomorph M E)
  (hc : ∀ j, ContMDiffOn I 𝓘(ℝ, E) n (c j) (c j).source)
  (hct : ∀ j, (c j).source ⊆ (t j).baseSet)

/-- The final locally convex topology on compactly supported bundle sections generated by a family
of chart extensions of native Euclidean test functions. -/
@[instance_reducible]
def chartTestTopology : TopologicalSpace (compactlySupported I F n V) :=
  TauCeti.finalLocallyConvexTopology fun j ↦ (t j).chartTestSection (c j) (hc j) (hct j)

/-- Unfolding lemma expressing `chartTestTopology` as the final locally convex topology of the
generating chart extensions. -/
theorem chartTestTopology_eq_finalLocallyConvexTopology :
    chartTestTopology (I := I) (n := n) t c hc hct =
      TauCeti.finalLocallyConvexTopology fun j ↦ (t j).chartTestSection (c j) (hc j) (hct j) :=
  (rfl)

/-- Addition and negation are continuous for `chartTestTopology`. -/
theorem isTopologicalAddGroup_chartTestTopology :
    letI := chartTestTopology (I := I) (n := n) t c hc hct
    IsTopologicalAddGroup (compactlySupported I F n V) := by
  unfold chartTestTopology
  exact inferInstance

/-- Real scalar multiplication is continuous for `chartTestTopology`. -/
theorem continuousSMul_chartTestTopology :
    letI := chartTestTopology (I := I) (n := n) t c hc hct
    ContinuousSMul ℝ (compactlySupported I F n V) := by
  unfold chartTestTopology
  exact inferInstance

/-- The chart-generated LF topology on compactly supported sections is locally convex. -/
theorem locallyConvexSpace_chartTestTopology :
    letI := chartTestTopology (I := I) (n := n) t c hc hct
    LocallyConvexSpace ℝ (compactlySupported I F n V) := by
  unfold chartTestTopology
  exact inferInstance

/-- Every generating chart extension is continuous for `chartTestTopology`. -/
theorem continuous_chartTestSection_chartTestTopology (j : κ) :
    letI := chartTestTopology (I := I) (n := n) t c hc hct
    Continuous ((t j).chartTestSection (c j) (hc j) (hct j)) :=
  TauCeti.FinalLocallyConvexTopology.continuous
    (fun j ↦ (t j).chartTestSection (c j) (hc j) (hct j)) j

/-- Universal property of `chartTestTopology` for linear maps over any `ℝ`-algebra into a locally
convex real topological vector space. -/
theorem continuous_chartTestTopology_iff {𝕜' G : Type*} [Semiring 𝕜'] [Algebra ℝ 𝕜']
    [Module 𝕜' (compactlySupported I F n V)] [IsScalarTower ℝ 𝕜' (compactlySupported I F n V)]
    [AddCommGroup G] [Module ℝ G] [Module 𝕜' G] [IsScalarTower ℝ 𝕜' G]
    [TopologicalSpace G] [IsTopologicalAddGroup G] [ContinuousSMul ℝ G] [LocallyConvexSpace ℝ G]
    (g : compactlySupported I F n V →ₗ[𝕜'] G) :
    letI := chartTestTopology (I := I) (n := n) t c hc hct
    Continuous g ↔ ∀ j, Continuous (g ∘ (t j).chartTestSection (c j) (hc j) (hct j)) :=
  TauCeti.FinalLocallyConvexTopology.continuous_iff_continuous_comp
    (fun j ↦ (t j).chartTestSection (c j) (hc j) (hct j)) g

/-- Any chart-generated LF topology is at least as fine as the fixed-compact inductive topology,
since every chart extension is continuous for `compactlySupportedTopology`. -/
theorem chartTestTopology_le_compactlySupportedTopology [LocallyCompactSpace E] [IsManifold I n M]
    {ι : Type*} (e : ι → Trivialization F (π F V)) [∀ i, MemTrivializationAtlas (e i)]
    (U : ι → Opens M) (hU : ∀ i, (U i : Set M) ⊆ (e i).baseSet) :
    chartTestTopology (I := I) (n := n) t c hc hct ≤
      compactlySupportedTopology (I := I) (n := n) e U hU := by
  let := compactlySupportedTopology (I := I) (n := n) e U hU
  let := isTopologicalAddGroup_compactlySupportedTopology (I := I) (n := n) e U hU
  let := continuousSMul_compactlySupportedTopology (I := I) (n := n) e U hU
  let := locallyConvexSpace_compactlySupportedTopology (I := I) (n := n) e U hU
  exact (TauCeti.FinalLocallyConvexTopology.le_iff
    (fun j ↦ (t j).chartTestSection (c j) (hc j) (hct j)) _).2 fun j ↦
    (t j).continuous_chartTestSection (c j) (hc j) (hct j) e U hU

end ChartTestTopology

section PartitionOfUnity

variable {E H M F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  [TopologicalSpace M] [ChartedSpace H M] [T2Space M]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {V : M → Type*} [∀ x, AddCommGroup (V x)] [∀ x, Module ℝ (V x)]
  [∀ x, TopologicalSpace (V x)] [TopologicalSpace (TotalSpace F V)]
  [FiberBundle F V] [VectorBundle ℝ F V]
  {n : ℕ∞} [ContMDiffVectorBundle n F V I] [IsManifold I n M]

/-- **Chart-generated LF topology equals the fixed-compact inductive topology.** On a
finite-dimensional Hausdorff `C^n` manifold (`n : ℕ∞`), the final locally convex topology generated
by any covering family of `C^n` charts and frames coincides with the fixed-compact inductive
topology `compactlySupportedTopology`. -/
theorem chartTestTopology_eq_compactlySupportedTopology
    {ι : Type*} (e : ι → Trivialization F (π F V)) [∀ i, MemTrivializationAtlas (e i)]
    (U : ι → Opens M) (hU : ∀ i, (U i : Set M) ⊆ (e i).baseSet)
    (hcover_e : ∀ x : M, ∃ i, x ∈ U i)
    {κ : Type*} (t : κ → Trivialization F (π F V)) [∀ j, MemTrivializationAtlas (t j)]
    (c : κ → OpenPartialHomeomorph M E)
    (hc : ∀ j, ContMDiffOn I 𝓘(ℝ, E) n (c j) (c j).source)
    (hc_symm : ∀ j, ContMDiffOn 𝓘(ℝ, E) I n (c j).symm (c j).target)
    (hct : ∀ j, (c j).source ⊆ (t j).baseSet)
    (hcover_c : ∀ x : M, ∃ j, x ∈ (c j).source) :
    chartTestTopology (I := I) (n := n) t c hc hct =
      compactlySupportedTopology (I := I) (n := n) e U hU := by
  refine le_antisymm (chartTestTopology_le_compactlySupportedTopology t c hc hct e U hU) ?_
  rw [compactlySupportedTopology_eq_finalLocallyConvexTopology]
  let := frameTopology (I := I) (n := n) e U hU
  -- Factor every fixed-compact inclusion `ofSupportedIn K` as a finite sum through chart spaces.
  refine TauCeti.FinalLocallyConvexTopology.le_of_sum_factor _ _ fun K ↦ ?_
  -- Step 1: Take a finite `C^n` partition of unity on `K` subordinate to the chart sources.
  obtain ⟨s, η, hη_supp, _, _, hη_sum, _⟩ :=
    K.isCompact.exists_finset_contMDiff_sum_eq_one_on I (n := n) (fun j ↦ (c j).open_source)
      fun x _ ↦ mem_iUnion.2 (hcover_c x)
  let L : κ → Compacts M := fun j ↦
    ⟨_root_.tsupport (η j) ∩ (K : Set M),
      K.isCompact.of_isClosed_subset
        ((_root_.isClosed_tsupport (η j)).inter K.isCompact.isClosed) inter_subset_right⟩
  have hL : ∀ j, (L j : Set M) ⊆ (c j).source := fun j ↦ inter_subset_left.trans (hη_supp j)
  -- Step 2: Localize into `L j ⊆ (c j).source` and extract into `𝓓^{n}((c j).target, F)`.
  let loc : ∀ j, supportedIn I F n V K →ₗ[ℝ] supportedIn I F n V (L j) := fun j ↦
    (smulLinearMap (I := I) (F := F) (V := V) (n := n) (η j)).restrict fun u hu ↦
      mem_supportedIn.2 <| (tsupport_smul_function_subset (η j) u).trans
        (inter_subset_inter_right _ (mem_supportedIn.1 hu))
  have hL' : ∀ j, ((c j).compactsImage (L j) (hL j) : Set E) ⊆ (c j).target := fun j ↦
    (c j).compactsImage_subset_target (L j) (hL j)
  let a : ∀ j, supportedIn I F n V K →ₗ[ℝ] 𝓓^{n}(⟨(c j).target, (c j).open_target⟩, F) := fun j ↦
    (TestFunction.ofSupportedInCLM ℝ
        (Ω := ⟨(c j).target, (c j).open_target⟩) (hL' j)).toLinearMap ∘ₗ
      ((t j).chartTestSupportedIn (c j) (hc_symm j) (hct j) (hL j)) ∘ₗ loc j
  refine ⟨s, a, fun j _ ↦ ?_, ?_⟩
  · exact (TestFunction.ofSupportedInCLM ℝ (Ω := ⟨(c j).target, (c j).open_target⟩)
      (hL' j)).continuous.comp
      (((t j).continuous_chartTestSupportedIn (c j) (hc_symm j) (hct j) (hL j) e U hU
        hcover_e).comp (((continuous_smulLinearMap_frameTopology e U hU (η j)).comp
          continuous_subtype_val).subtype_mk _))
  · -- Step 3: Re-extending each extracted piece yields `η j • u`, summing to `u` on `K`.
    ext u x
    have hterm : ∀ j, (((t j).chartTestSection (c j) (hc j) (hct j) (a j u)).1 : Cₛ^n⟮I; F, V⟯) =
        η j • u.1 := fun j ↦ by
      have hre := (t j).chartTestSection_ofSupportedIn_chartTestSupportedIn
        (c j) (hc_symm j) (hct j) (hc j) (hL j) (loc j u)
      simpa only [a, LinearMap.comp_apply, ContinuousLinearMap.coe_coe,
        TestFunction.coe_ofSupportedInCLM, ofSupportedIn_apply, loc, LinearMap.restrict_apply,
        smulLinearMap_eq_smul] using congrArg Subtype.val hre
    rw [LinearMap.coe_sum, Finset.sum_apply, Submodule.coe_sum, ← ContMDiffSection.coeAddHom_apply,
      map_sum, Finset.sum_apply, ofSupportedIn_apply]
    simp_rw [ContMDiffSection.coeAddHom_apply, LinearMap.comp_apply, hterm, smul_apply,
      ← Finset.sum_smul]
    have hsum_val : (∑ j ∈ s, η j x) • u.1 x = ((∑ j ∈ s, η j) • u.1) x := by
      simp [smul_apply]
    rw [hsum_val, smul_function_eq_self (∑ j ∈ s, η j) u.1 (fun y hy ↦ by
      rw [ContMDiffMap.coe_sum, Finset.sum_apply]
      exact hη_sum y (mem_supportedIn.1 u.2 hy))]

/-- Any two covering families of `C^n` charts and frames generate the same LF topology on
compactly supported sections. -/
theorem chartTestTopology_eq_of_covers
    {κ₁ : Type*} (t₁ : κ₁ → Trivialization F (π F V)) [∀ j, MemTrivializationAtlas (t₁ j)]
    (c₁ : κ₁ → OpenPartialHomeomorph M E)
    (hc₁ : ∀ j, ContMDiffOn I 𝓘(ℝ, E) n (c₁ j) (c₁ j).source)
    (hc₁_symm : ∀ j, ContMDiffOn 𝓘(ℝ, E) I n (c₁ j).symm (c₁ j).target)
    (hct₁ : ∀ j, (c₁ j).source ⊆ (t₁ j).baseSet)
    (hcover₁ : ∀ x : M, ∃ j, x ∈ (c₁ j).source)
    {κ₂ : Type*} (t₂ : κ₂ → Trivialization F (π F V)) [∀ j, MemTrivializationAtlas (t₂ j)]
    (c₂ : κ₂ → OpenPartialHomeomorph M E)
    (hc₂ : ∀ j, ContMDiffOn I 𝓘(ℝ, E) n (c₂ j) (c₂ j).source)
    (hc₂_symm : ∀ j, ContMDiffOn 𝓘(ℝ, E) I n (c₂ j).symm (c₂ j).target)
    (hct₂ : ∀ j, (c₂ j).source ⊆ (t₂ j).baseSet)
    (hcover₂ : ∀ x : M, ∃ j, x ∈ (c₂ j).source) :
    chartTestTopology (I := I) (n := n) t₁ c₁ hc₁ hct₁ =
      chartTestTopology (I := I) (n := n) t₂ c₂ hc₂ hct₂ := by
  let e : M → Trivialization F (π F V) := fun x ↦ trivializationAt F V x
  let U : M → Opens M := fun x ↦ ⟨(e x).baseSet, (e x).open_baseSet⟩
  have hU : ∀ x, (U x : Set M) ⊆ (e x).baseSet := fun _ ↦ Subset.rfl
  have hcover : ∀ x : M, ∃ i, x ∈ U i := fun x ↦ ⟨x, mem_baseSet_trivializationAt F V x⟩
  exact (chartTestTopology_eq_compactlySupportedTopology e U hU hcover t₁ c₁ hc₁ hc₁_symm hct₁
      hcover₁).trans
    (chartTestTopology_eq_compactlySupportedTopology e U hU hcover t₂ c₂ hc₂ hc₂_symm hct₂
      hcover₂).symm

/-- **Universal continuity criterion in terms of charts.** A linear map from compactly supported
`C^n` bundle sections into any locally convex real topological vector space is continuous if and
only if its precomposition with every chart extension in a covering chart-frame family is
continuous on the corresponding native `TestFunction` space. -/
theorem continuous_compactlySupportedTopology_iff_chartTestSection
    {ι : Type*} (e : ι → Trivialization F (π F V)) [∀ i, MemTrivializationAtlas (e i)]
    (U : ι → Opens M) (hU : ∀ i, (U i : Set M) ⊆ (e i).baseSet)
    (hcover_e : ∀ x : M, ∃ i, x ∈ U i)
    {κ : Type*} (t : κ → Trivialization F (π F V)) [∀ j, MemTrivializationAtlas (t j)]
    (c : κ → OpenPartialHomeomorph M E)
    (hc : ∀ j, ContMDiffOn I 𝓘(ℝ, E) n (c j) (c j).source)
    (hc_symm : ∀ j, ContMDiffOn 𝓘(ℝ, E) I n (c j).symm (c j).target)
    (hct : ∀ j, (c j).source ⊆ (t j).baseSet)
    (hcover_c : ∀ x : M, ∃ j, x ∈ (c j).source)
    {𝕜' G : Type*} [Semiring 𝕜'] [Algebra ℝ 𝕜']
    [Module 𝕜' (compactlySupported I F n V)] [IsScalarTower ℝ 𝕜' (compactlySupported I F n V)]
    [AddCommGroup G] [Module ℝ G] [Module 𝕜' G] [IsScalarTower ℝ 𝕜' G]
    [TopologicalSpace G] [IsTopologicalAddGroup G] [ContinuousSMul ℝ G] [LocallyConvexSpace ℝ G]
    (g : compactlySupported I F n V →ₗ[𝕜'] G) :
    letI := compactlySupportedTopology (I := I) (n := n) e U hU
    Continuous g ↔ ∀ j, Continuous (g ∘ (t j).chartTestSection (c j) (hc j) (hct j)) := by
  rw [← chartTestTopology_eq_compactlySupportedTopology e U hU hcover_e t c hc hc_symm hct hcover_c]
  exact continuous_chartTestTopology_iff t c hc hct g

/-- On a boundaryless finite-dimensional Hausdorff `C^n` manifold (`n : ℕ∞`), a linear map from
compactly supported `C^n` bundle sections into any locally convex real topological vector space is
continuous if and only if its precomposition with every `C^n` chart extension is continuous. -/
theorem continuous_compactlySupportedTopology_iff_forall_chartTestSection
    [I.Boundaryless]
    {ι : Type*} (e : ι → Trivialization F (π F V)) [∀ i, MemTrivializationAtlas (e i)]
    (U : ι → Opens M) (hU : ∀ i, (U i : Set M) ⊆ (e i).baseSet)
    (hcover_e : ∀ x : M, ∃ i, x ∈ U i)
    {𝕜' G : Type*} [Semiring 𝕜'] [Algebra ℝ 𝕜']
    [Module 𝕜' (compactlySupported I F n V)] [IsScalarTower ℝ 𝕜' (compactlySupported I F n V)]
    [AddCommGroup G] [Module ℝ G] [Module 𝕜' G] [IsScalarTower ℝ 𝕜' G]
    [TopologicalSpace G] [IsTopologicalAddGroup G] [ContinuousSMul ℝ G] [LocallyConvexSpace ℝ G]
    (g : compactlySupported I F n V →ₗ[𝕜'] G) :
    letI := compactlySupportedTopology (I := I) (n := n) e U hU
    Continuous g ↔
      ∀ (t : Trivialization F (π F V)) [MemTrivializationAtlas t]
        (c : OpenPartialHomeomorph M E)
        (hc : ContMDiffOn I 𝓘(ℝ, E) n c c.source)
        (hct : c.source ⊆ t.baseSet),
        Continuous (g ∘ t.chartTestSection c hc hct) := by
  let := compactlySupportedTopology (I := I) (n := n) e U hU
  constructor
  · intro hg t _ c hc hct
    exact hg.comp (t.continuous_chartTestSection c hc hct e U hU)
  · intro h
    let t : M → Trivialization F (π F V) := fun x ↦ trivializationAt F V x
    let c : M → OpenPartialHomeomorph M E := fun x ↦ (t x).restrExtChartAt I x
    exact (continuous_compactlySupportedTopology_iff_chartTestSection
      e U hU hcover_e t c
      (fun x ↦ (t x).contMDiffOn_restrExtChartAt x)
      (fun x ↦ (t x).contMDiffOn_restrExtChartAt_symm x)
      (fun x ↦ (t x).restrExtChartAt_source_subset_baseSet I x)
      (fun x ↦ ⟨x, (t x).mem_restrExtChartAt_source I (mem_baseSet_trivializationAt F V x)⟩)
      g).2 fun x ↦ h (t x) (c x) _ _

end PartitionOfUnity

end ContMDiffSection
