section ChartRead

variable {E H M F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  [TopologicalSpace M] [ChartedSpace H M]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {V : M → Type*} [∀ x, AddCommGroup (V x)] [∀ x, Module ℝ (V x)]
  [∀ x, TopologicalSpace (V x)] [TopologicalSpace (TotalSpace F V)]
  [FiberBundle F V] [VectorBundle ℝ F V]
  {n : ℕ∞}
  (t : Trivialization F (π F V)) [MemTrivializationAtlas t]
  (c : OpenPartialHomeomorph M E)
  (hc_symm : ContMDiffOn 𝓘(ℝ, E) I n c.symm c.target)
  (hct : c.source ⊆ t.baseSet)

private def chartReadFun (s : Cₛ^n⟮I; F, V⟯) (y : E) : F := by
  classical
  exact if y ∈ c.target then t.continuousLinearMapAt ℝ (c.symm y) (s (c.symm y)) else 0

private theorem chartReadFun_of_mem (s : Cₛ^n⟮I; F, V⟯) {y : E} (hy : y ∈ c.target) :
    chartReadFun t c s y = t.continuousLinearMapAt ℝ (c.symm y) (s (c.symm y)) := by
  simp [chartReadFun, hy]

private theorem chartReadFun_of_notMem (s : Cₛ^n⟮I; F, V⟯) {y : E} (hy : y ∉ c.target) :
    chartReadFun t c s y = 0 := by
  simp [chartReadFun, hy]

private theorem chartReadFun_eq_zero_of_notMem_image {K : Set M} {s : Cₛ^n⟮I; F, V⟯}
    (hs : s.tsupport ⊆ K) {y : E} (hy : y ∉ c '' K) :
    chartReadFun t c s y = 0 := by
  by_cases hyt : y ∈ c.target
  · have hsymm : c.symm y ∉ s.tsupport := fun hmem ↦ hy ⟨c.symm y, hs hmem, c.right_inv hyt⟩
    rw [chartReadFun_of_mem t c s hyt, s.eq_zero_of_notMem_tsupport hsymm, map_zero]
  · exact chartReadFun_of_notMem t c s hyt

variable [ContMDiffVectorBundle n F V I]

include hc_symm hct in
private theorem contDiff_chartReadFun {K : Compacts M} (hKc : (K : Set M) ⊆ c.source)
    (s : supportedIn I F n V K) :
    ContDiff ℝ n (chartReadFun t c s.1) := by
  have hK' : IsCompact (c '' (K : Set M)) :=
    K.isCompact.image_of_continuousOn (c.continuousOn.mono hKc)
  refine contDiff_iff_contDiffAt.2 fun y ↦ ?_
  by_cases hy : y ∈ c.target
  · have hsec : ContMDiffAt I 𝓘(ℝ, F) n (fun x ↦ (t ⟨x, s.1 x⟩).2) (c.symm y) :=
      (t.contMDiffAt_section_iff (hct (c.map_target hy))).1 (s.1.contMDiff (c.symm y))
    have hcomp : ContDiffAt ℝ n (fun z ↦ (t ⟨c.symm z, s.1 (c.symm z)⟩).2) y :=
      contMDiffAt_iff_contDiffAt.1
        (hsec.comp y (hc_symm.contMDiffAt (c.open_target.mem_nhds hy)))
    refine hcomp.congr_of_eventuallyEq ?_
    filter_upwards [c.open_target.mem_nhds hy] with z hz
    rw [chartReadFun_of_mem t c s.1 hz,
      t.continuousLinearMapAt_apply_of_mem (R := ℝ) (hct (c.map_target hz))]
  · have hyK' : y ∉ c '' (K : Set M) := fun ⟨x, hxK, hxy⟩ ↦ hy (hxy ▸ c.map_source (hKc hxK))
    refine (contDiffAt_const (c := (0 : F))).congr_of_eventuallyEq ?_
    filter_upwards [hK'.isClosed.isOpen_compl.mem_nhds hyK'] with z hz
    exact chartReadFun_eq_zero_of_notMem_image t c (mem_supportedIn.1 s.2) hz

private def chartReadSupportedInFun {K : Compacts M} (hKc : (K : Set M) ⊆ c.source)
    (s : supportedIn I F n V K) :
    𝓓^{n}_{⟨c '' (K : Set M), K.isCompact.image_of_continuousOn (c.continuousOn.mono hKc)⟩}(E,
      F) :=
  ⟨chartReadFun t c s.1, contDiff_chartReadFun t c hc_symm hct hKc s,
    fun _ hy ↦ chartReadFun_eq_zero_of_notMem_image t c (mem_supportedIn.1 s.2) hy⟩

@[simp]
private theorem chartReadSupportedInFun_apply {K : Compacts M} (hKc : (K : Set M) ⊆ c.source)
    (s : supportedIn I F n V K) (y : E) :
    chartReadSupportedInFun t c hc_symm hct hKc s y = chartReadFun t c s.1 y :=
  rfl

/-- Read a `C^n` bundle section supported in a compact subset `K ⊆ c.source` in the coordinate
chart `c` and bundle frame `t`, extending by zero outside `c '' K`. -/
def chartReadSupportedIn {K : Compacts M} (hKc : (K : Set M) ⊆ c.source) :
    supportedIn I F n V K →ₗ[ℝ]
      𝓓^{n}_{⟨c '' (K : Set M), K.isCompact.image_of_continuousOn (c.continuousOn.mono hKc)⟩}(E,
        F) where
  toFun := chartReadSupportedInFun t c hc_symm hct hKc
  map_add' s₁ s₂ := by
    ext y
    by_cases hy : y ∈ c.target <;> simp [chartReadFun, hy]
  map_smul' a s := by
    ext y
    by_cases hy : y ∈ c.target <;> simp [chartReadFun, hy]

/-- On the chart target, `chartReadSupportedIn` reads the section in `t` along `c.symm`. -/
theorem chartReadSupportedIn_apply_of_mem {K : Compacts M} (hKc : (K : Set M) ⊆ c.source)
    (s : supportedIn I F n V K) {y : E} (hy : y ∈ c.target) :
    t.chartReadSupportedIn c hc_symm hct hKc s y =
      t.continuousLinearMapAt ℝ (c.symm y) (s.1 (c.symm y)) :=
  chartReadFun_of_mem t c s.1 hy

/-- Outside the chart target, `chartReadSupportedIn` vanishes. -/
@[simp]
theorem chartReadSupportedIn_apply_of_notMem {K : Compacts M} (hKc : (K : Set M) ⊆ c.source)
    (s : supportedIn I F n V K) {y : E} (hy : y ∉ c.target) :
    t.chartReadSupportedIn c hc_symm hct hKc s y = 0 :=
  chartReadFun_of_notMem t c s.1 hy

/-- Read a `C^n` bundle section supported in a compact subset `K ⊆ c.source` as a native test
function on the chart target `c.target`. -/
def chartReadTestFunction {K : Compacts M} (hKc : (K : Set M) ⊆ c.source) :
    supportedIn I F n V K →ₗ[ℝ] 𝓓^{n}(⟨c.target, c.open_target⟩, F) :=
  let K' : Compacts E :=
    ⟨c '' (K : Set M), K.isCompact.image_of_continuousOn (c.continuousOn.mono hKc)⟩
  have hK't : (K' : Set E) ⊆ (⟨c.target, c.open_target⟩ : Opens E) :=
    image_subset_iff.2 fun _ hx ↦ c.map_source (hKc hx)
  (TestFunction.ofSupportedInCLM ℝ hK't).toLinearMap.comp
    (t.chartReadSupportedIn c hc_symm hct hKc)

/-- On the chart target, `chartReadTestFunction` reads the section in `t` along `c.symm`. -/
theorem chartReadTestFunction_apply_of_mem {K : Compacts M} (hKc : (K : Set M) ⊆ c.source)
    (s : supportedIn I F n V K) {y : E} (hy : y ∈ c.target) :
    t.chartReadTestFunction c hc_symm hct hKc s y =
      t.continuousLinearMapAt ℝ (c.symm y) (s.1 (c.symm y)) :=
  t.chartReadSupportedIn_apply_of_mem c hc_symm hct hKc s hy

/-- Outside the chart target, `chartReadTestFunction` vanishes. -/
@[simp]
theorem chartReadTestFunction_apply_of_notMem {K : Compacts M} (hKc : (K : Set M) ⊆ c.source)
    (s : supportedIn I F n V K) {y : E} (hy : y ∉ c.target) :
    t.chartReadTestFunction c hc_symm hct hKc s y = 0 :=
  t.chartReadSupportedIn_apply_of_notMem c hc_symm hct hKc s hy

/-- Extending `chartReadTestFunction` by zero recovers the original section supported in `K`. -/
@[simp]
theorem chartTestSection_chartReadTestFunction [T2Space M]
    (hc : ContMDiffOn I 𝓘(ℝ, E) n c c.source) {K : Compacts M} (hKc : (K : Set M) ⊆ c.source)
    (s : supportedIn I F n V K) :
    t.chartTestSection c hc hct (t.chartReadTestFunction c hc_symm hct hKc s) =
      ofSupportedIn K s := by
  apply Subtype.ext
  ext x
  by_cases hx : x ∈ c.source
  · rw [t.chartTestSection_apply_of_mem c hc hct _ hx,
      t.chartReadTestFunction_apply_of_mem c hc_symm hct hKc s (c.map_source hx),
      c.left_inv hx, t.symmL_continuousLinearMapAt (hct hx), ofSupportedIn_apply]
  · rw [t.chartTestSection_apply_of_notMem c hc hct _ hx, ofSupportedIn_apply]
    exact (s.1.eq_zero_of_notMem_tsupport fun h ↦ hx (hKc (mem_supportedIn.1 s.2 h))).symm

/-- Multiply an arbitrary `C^n` section by a compactly supported `C^n` cutoff `ρ` with
`tsupport ρ ⊆ c.source` and read the localized section as a native test function on `c.target`. -/
def chartCutoffTestFunction (ρ : C^n⟮I, M; ℝ⟯) (hρc : HasCompactSupport ρ)
    (hρs : _root_.tsupport ρ ⊆ c.source) :
    Cₛ^n⟮I; F, V⟯ →ₗ[ℝ] 𝓓^{n}(⟨c.target, c.open_target⟩, F) :=
  let Kρ : Compacts M := ⟨_root_.tsupport ρ, hρc⟩
  (t.chartReadTestFunction c hc_symm hct (K := Kρ) hρs).comp
    ((smulLinearMap ρ).codRestrict (supportedIn I F n V Kρ) fun s ↦
      mem_supportedIn.2 ((tsupport_smul_function_subset ρ s).trans inter_subset_left))

/-- On the chart target, `chartCutoffTestFunction` evaluates to the cutoff-weighted frame
coordinates along `c.symm`. -/
theorem chartCutoffTestFunction_apply_of_mem (ρ : C^n⟮I, M; ℝ⟯) (hρc : HasCompactSupport ρ)
    (hρs : _root_.tsupport ρ ⊆ c.source) (s : Cₛ^n⟮I; F, V⟯) {y : E} (hy : y ∈ c.target) :
    t.chartCutoffTestFunction c hc_symm hct ρ hρc hρs s y =
      ρ (c.symm y) • t.continuousLinearMapAt ℝ (c.symm y) (s (c.symm y)) := by
  rw [chartCutoffTestFunction, LinearMap.comp_apply,
    t.chartReadTestFunction_apply_of_mem c hc_symm hct hρs _ hy, LinearMap.codRestrict_apply,
    smulLinearMap_eq_smul, ContMDiffSection.smul_apply, map_smul]

/-- Outside the chart target, `chartCutoffTestFunction` vanishes. -/
@[simp]
theorem chartCutoffTestFunction_apply_of_notMem (ρ : C^n⟮I, M; ℝ⟯) (hρc : HasCompactSupport ρ)
    (hρs : _root_.tsupport ρ ⊆ c.source) (s : Cₛ^n⟮I; F, V⟯) {y : E} (hy : y ∉ c.target) :
    t.chartCutoffTestFunction c hc_symm hct ρ hρc hρs s y = 0 :=
  t.chartReadTestFunction_apply_of_notMem c hc_symm hct hρs _ hy

/-- Extending `chartCutoffTestFunction` by zero yields the localized section `ρ • s`. -/
@[simp]
theorem chartTestSection_chartCutoffTestFunction [T2Space M]
    (hc : ContMDiffOn I 𝓘(ℝ, E) n c c.source) (ρ : C^n⟮I, M; ℝ⟯) (hρc : HasCompactSupport ρ)
    (hρs : _root_.tsupport ρ ⊆ c.source) (s : Cₛ^n⟮I; F, V⟯) :
    t.chartTestSection c hc hct (t.chartCutoffTestFunction c hc_symm hct ρ hρc hρs s) =
      ⟨ρ • s, smul_function_mem_compactlySupported_of_hasCompactSupport ρ hρc s⟩ := by
  rw [chartCutoffTestFunction, LinearMap.comp_apply,
    t.chartTestSection_chartReadTestFunction c hc_symm hct hc hρs]
  apply Subtype.ext
  rw [ofSupportedIn_apply, LinearMap.codRestrict_apply, smulLinearMap_eq_smul]

private def chartTestSectionInv (hc_univ : c.source = univ) :
    compactlySupported I F n V →ₗ[ℝ] 𝓓^{n}(⟨c.target, c.open_target⟩, F) where
  toFun s :=
    t.chartReadTestFunction c hc_symm hct (K := ⟨s.1.tsupport, mem_compactlySupported.1 s.2⟩)
      ((subset_univ _).trans hc_univ.symm.subset) ⟨s.1, mem_supportedIn.2 Subset.rfl⟩
  map_add' s₁ s₂ := by
    ext y
    by_cases hy : y ∈ c.target
    · simp [t.chartReadTestFunction_apply_of_mem _ _ _ _ _ hy]
    · simp [t.chartReadTestFunction_apply_of_notMem _ _ _ _ _ hy]
  map_smul' a s := by
    ext y
    by_cases hy : y ∈ c.target
    · simp [t.chartReadTestFunction_apply_of_mem _ _ _ _ _ hy]
    · simp [t.chartReadTestFunction_apply_of_notMem _ _ _ _ _ hy]

private theorem chartTestSectionInv_apply (hc_univ : c.source = univ)
    (s : compactlySupported I F n V) :
    t.chartTestSectionInv c hc_symm hct hc_univ s =
      t.chartReadTestFunction c hc_symm hct (K := ⟨s.1.tsupport, mem_compactlySupported.1 s.2⟩)
        ((subset_univ _).trans hc_univ.symm.subset) ⟨s.1, mem_supportedIn.2 Subset.rfl⟩ :=
  rfl

section Continuity

variable [LocallyCompactSpace E] [IsManifold I n M]
  {ι : Type*} (e : ι → Trivialization F (π F V)) [∀ i, MemTrivializationAtlas (e i)]
  (U : ι → Opens M) (hU : ∀ i, (U i : Set M) ⊆ (e i).baseSet)
  (hcover : ∀ x : M, ∃ i, x ∈ U i)

include hcover in
/-- Reading sections supported in a compact subset `K ⊆ c.source` in a smooth chart with `C^n`
inverse is continuous from any covering smooth frame topology into `𝓓^{n}_{c '' K}(E, F)`. -/
theorem continuous_chartReadSupportedIn {K : Compacts M} (hKc : (K : Set M) ⊆ c.source) :
    letI := frameTopology (I := I) (n := n) e U hU
    Continuous (t.chartReadSupportedIn c hc_symm hct hKc) := by
  let := frameTopology (I := I) (n := n) e U hU
  let K' : Compacts E := ⟨c '' (K : Set M), K.isCompact.image_of_continuousOn
    (c.continuousOn.mono hKc)⟩
  refine ContDiffMapSupportedIn.continuous_iff_toContMDiffMap.2 ?_
  suffices h : Continuous (fun s : supportedIn I F n V K ↦
      ContDiffMapSupportedIn.toContMDiffMap (t.chartReadSupportedIn c hc_symm hct hKc s)) by
    rwa [ContMDiffMap.manifoldWeakWhitneyTopology_self] at h
  let W : Bool → Opens E := fun b ↦
    bif b then ⟨c.target, c.open_target⟩ else ⟨(K' : Set E)ᶜ, K'.isCompact.isClosed.isOpen_compl⟩
  have hW : ∀ y : E, ∃ b, y ∈ W b := fun y ↦ by
    by_cases hy : y ∈ c.target
    · exact ⟨true, hy⟩
    · exact ⟨false, fun ⟨x, hxK, hxy⟩ ↦ hy (hxy ▸ c.map_source (hKc hxK))⟩
  refine ContMDiffMap.continuous_of_forall_continuous_restrict W hW fun b ↦ ?_
  cases b with
  | false =>
    convert continuous_const (y := (0 : C^n⟮𝓘(ℝ, E), W false; 𝓘(ℝ, F), F⟯)) using 1
    funext s
    ext y
    rw [ContMDiffMap.restrict_apply, ContDiffMapSupportedIn.coe_toContMDiffMap,
      (t.chartReadSupportedIn c hc_symm hct hKc s).zero_on_compl y.2]
    simp
  | true =>
    let Uc : Opens M := ⟨c.source, c.open_source⟩
    let j : C^n⟮𝓘(ℝ, E), W true; I, Uc⟯ :=
      ⟨fun y ↦ ⟨c.symm y, c.map_target y.2⟩,
        (TauCeti.ContMDiff.subtypeVal_comp_iff Uc _).mp
          (hc_symm.comp_contMDiff contMDiff_subtype_val fun y ↦ y.2)⟩
    have hcoord : Continuous (fun s : supportedIn I F n V K ↦
        t.frameCoordinates (I := I) (n := n) (U := Uc) hct s.1) :=
      (continuous_frameCoordinates_of_cover e U hU hcover t Uc hct).comp continuous_subtype_val
    refine (ContMDiffMap.continuous_comp_manifoldWeakWhitney.comp
      (hcoord.prodMk (continuous_const (y := j)))).congr fun s ↦ ?_
    ext y
    rw [Function.comp_apply, ContMDiffMap.comp_apply, frameCoordinates_apply,
      ContMDiffMap.restrict_apply, ContDiffMapSupportedIn.coe_toContMDiffMap,
      t.chartReadSupportedIn_apply_of_mem c hc_symm hct hKc s y.2,
      t.continuousLinearMapAt_apply_of_mem (R := ℝ) (hct (c.map_target y.2))]
    rfl

include hcover in
/-- Reading sections supported in `K ⊆ c.source` as native test functions on `c.target` is
continuous from any covering smooth frame topology. -/
theorem continuous_chartReadTestFunction {K : Compacts M} (hKc : (K : Set M) ⊆ c.source) :
    letI := frameTopology (I := I) (n := n) e U hU
    Continuous (t.chartReadTestFunction c hc_symm hct hKc) := by
  let := frameTopology (I := I) (n := n) e U hU
  let K' : Compacts E :=
    ⟨c '' (K : Set M), K.isCompact.image_of_continuousOn (c.continuousOn.mono hKc)⟩
  have hK't : (K' : Set E) ⊆ (⟨c.target, c.open_target⟩ : Opens E) :=
    image_subset_iff.2 fun _ hx ↦ c.map_source (hKc hx)
  exact (TestFunction.ofSupportedInCLM ℝ hK't).continuous.comp
    (t.continuous_chartReadSupportedIn c hc_symm hct e U hU hcover hKc)

include hcover in
/-- Localizing sections by a compactly supported `C^n` cutoff `ρ` with `tsupport ρ ⊆ c.source`
and reading the result in `t` and `c` is continuous from any covering smooth frame topology into
`𝓓^{n}(⟨c.target, c.open_target⟩, F)`. -/
theorem continuous_chartCutoffTestFunction (ρ : C^n⟮I, M; ℝ⟯) (hρc : HasCompactSupport ρ)
    (hρs : _root_.tsupport ρ ⊆ c.source) :
    letI := frameTopology (I := I) (n := n) e U hU
    Continuous (t.chartCutoffTestFunction c hc_symm hct ρ hρc hρs) := by
  let := frameTopology (I := I) (n := n) e U hU
  exact (t.continuous_chartReadTestFunction c hc_symm hct e U hU hcover hρs).comp
    ((continuous_smulLinearMap e U hU ρ).subtype_mk _)

include hcover in
private theorem continuous_chartTestSectionInv (hc_univ : c.source = univ) :
    letI := compactlySupportedTopology (I := I) (n := n) e U hU
    Continuous (t.chartTestSectionInv c hc_symm hct hc_univ) := by
  let := frameTopology (I := I) (n := n) e U hU
  let := compactlySupportedTopology (I := I) (n := n) e U hU
  refine (continuous_compactlySupportedTopology_iff e U hU
    (t.chartTestSectionInv c hc_symm hct hc_univ)).2 fun K ↦ ?_
  refine (t.continuous_chartReadTestFunction c hc_symm hct e U hU hcover
    ((subset_univ _).trans hc_univ.symm.subset)).congr fun s ↦ ?_
  ext y
  by_cases hy : y ∈ c.target
  · simp [chartTestSectionInv_apply, t.chartReadTestFunction_apply_of_mem _ _ _ _ _ hy]
  · simp [chartTestSectionInv_apply, t.chartReadTestFunction_apply_of_notMem _ _ _ _ _ hy]

/-- When a two-sided `C^n` chart `c` subordinate to a smooth bundle trivialization `t` has
`c.source = univ`, extending native test functions by `t.chartTestSection` is a continuous linear
equivalence onto `compactlySupported I F n V` with its fixed-compact inductive topology. -/
def chartTestSectionEquiv [T2Space M] (hc : ContMDiffOn I 𝓘(ℝ, E) n c c.source)
    (hc_univ : c.source = univ) :
    letI := compactlySupportedTopology (I := I) (n := n) e U hU
    𝓓^{n}(⟨c.target, c.open_target⟩, F) ≃L[ℝ] compactlySupported I F n V :=
  letI := compactlySupportedTopology (I := I) (n := n) e U hU
  { toLinearEquiv :=
      { toLinearMap := t.chartTestSection c hc hct
        invFun := t.chartTestSectionInv c hc_symm hct hc_univ
        left_inv φ := by
          ext y
          -- Normalize `LinearEquiv` structure field projection `(t.chartTestSection ...).toFun`
          -- to the `LinearMap` coercion before rewriting with `chartTestSectionInv_apply`.
          change t.chartTestSectionInv c hc_symm hct hc_univ (t.chartTestSection c hc hct φ) y = φ y
          rw [t.chartTestSectionInv_apply]
          by_cases hy : y ∈ c.target
          · rw [t.chartReadTestFunction_apply_of_mem _ _ _ _ _ hy,
              t.continuousLinearMapAt_chartTestSection c hc hct φ (c.map_target hy),
              c.right_inv hy]
          · rw [t.chartReadTestFunction_apply_of_notMem _ _ _ _ _ hy]
            exact (φ.zero_on_compl hy).symm
        right_inv s := by
          -- Normalize `LinearEquiv` structure field projection `(t.chartTestSection ...).toFun`
          -- to the `LinearMap` coercion before rewriting with `chartTestSectionInv_apply`.
          change t.chartTestSection c hc hct (t.chartTestSectionInv c hc_symm hct hc_univ s) = s
          rw [t.chartTestSectionInv_apply,
            t.chartTestSection_chartReadTestFunction c hc_symm hct hc]
          exact Subtype.ext (ofSupportedIn_apply _ _) }
    continuous_toFun := t.continuous_chartTestSection c hc hct e U hU
    continuous_invFun := t.continuous_chartTestSectionInv c hc_symm hct e U hU hcover hc_univ }

@[simp]
theorem chartTestSectionEquiv_apply [T2Space M] (hc : ContMDiffOn I 𝓘(ℝ, E) n c c.source)
    (hc_univ : c.source = univ) (φ : 𝓓^{n}(⟨c.target, c.open_target⟩, F)) :
    t.chartTestSectionEquiv c hc_symm hct e U hU hcover hc hc_univ φ =
      t.chartTestSection c hc hct φ :=
  (rfl)

/-- On the chart target, the inverse of `chartTestSectionEquiv` reads the section in `t` along
`c.symm`. -/
theorem chartTestSectionEquiv_symm_apply_of_mem [T2Space M]
    (hc : ContMDiffOn I 𝓘(ℝ, E) n c c.source) (hc_univ : c.source = univ)
    (s : compactlySupported I F n V) {y : E} (hy : y ∈ c.target) :
    letI := compactlySupportedTopology (I := I) (n := n) e U hU
    (t.chartTestSectionEquiv c hc_symm hct e U hU hcover hc hc_univ).symm s y =
      t.continuousLinearMapAt ℝ (c.symm y) (s.1 (c.symm y)) := by
  let := compactlySupportedTopology (I := I) (n := n) e U hU
  exact t.chartReadTestFunction_apply_of_mem c hc_symm hct _ _ hy

end Continuity

end ChartRead

end Bundle.Trivialization

namespace ContMDiffSection

section ChartTestDatum

variable {E H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
  [TopologicalSpace M] [ChartedSpace H M]
  (F : Type*) [TopologicalSpace F] (n : ℕ∞) (V : M → Type*)
  [∀ x, TopologicalSpace (V x)] [TopologicalSpace (TotalSpace F V)]
  [FiberBundle F V]

/-- A `C^n` coordinate chart on `M` subordinate to an atlas trivialization of `V`, packaging the
datum of a native test-function extension map `Bundle.Trivialization.chartTestSection`. Only
forward `C^n` regularity of the chart is required. -/
structure ChartTestDatum where
  /-- The bundle trivialization in which native test functions are read. -/
  triv : Trivialization F (π F V)
  /-- Membership of the trivialization in the bundle atlas. -/
  mem_atlas : MemTrivializationAtlas triv := by infer_instance
  /-- The coordinate chart with values in the model vector space `E`. -/
  chart : OpenPartialHomeomorph M E
  /-- Forward `C^n` regularity of `chart` on its source. -/
  contMDiffOn_chart : ContMDiffOn I 𝓘(ℝ, E) n chart chart.source
  /-- Containment of the chart source in the trivialization base set. -/
  source_subset_baseSet : chart.source ⊆ triv.baseSet

attribute [instance] ChartTestDatum.mem_atlas

namespace ChartTestDatum

variable {I F n V}

/-- The open target of the coordinate chart in the model vector space `E`. The body is exposed so
that `ChartTestDatum.chartTestSection` is definitionally compatible with
`Bundle.Trivialization.chartTestSection`. -/
@[expose]
def targetOpens (d : ChartTestDatum I F n V) : Opens E :=
  ⟨d.chart.target, d.chart.open_target⟩

@[simp]
theorem coe_targetOpens (d : ChartTestDatum I F n V) :
    (d.targetOpens : Set E) = d.chart.target :=
  (rfl)

end ChartTestDatum

end ChartTestDatum

section PreferredChartAt

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E H M : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  [TopologicalSpace H] (I : ModelWithCorners 𝕜 E H) [I.Boundaryless]
  [TopologicalSpace M] [ChartedSpace H M]
  (F : Type*) [TopologicalSpace F] (V : M → Type*)
  [∀ x, TopologicalSpace (V x)] [TopologicalSpace (TotalSpace F V)]
  [FiberBundle F V]

/-- On a boundaryless manifold, the preferred chart at `x` restricted to the base set of
`trivializationAt F V x` and read in the model vector space `E`. -/
def preferredChartAt (x : M) : OpenPartialHomeomorph M E :=
  ((chartAt H x).restr (trivializationAt F V x).baseSet).extendTrans I (Homeomorph.refl E)

variable {I F V}

@[simp]
theorem preferredChartAt_source (x : M) :
    (preferredChartAt I F V x).source =
      (chartAt H x).source ∩ (trivializationAt F V x).baseSet := by
  rw [preferredChartAt, OpenPartialHomeomorph.extendTrans_source,
    (chartAt H x).restr_source' _ (trivializationAt F V x).open_baseSet]

/-- Each point `x` belongs to the source of `preferredChartAt I F V x`. -/
theorem mem_preferredChartAt_source (x : M) : x ∈ (preferredChartAt I F V x).source := by
  rw [preferredChartAt_source]
  exact ⟨mem_chart_source H x, mem_baseSet_trivializationAt F V x⟩

/-- The source of `preferredChartAt I F V x` lies inside the base set of
`trivializationAt F V x`. -/
theorem preferredChartAt_source_subset_baseSet (x : M) :
    (preferredChartAt I F V x).source ⊆ (trivializationAt F V x).baseSet := by
  rw [preferredChartAt_source]
  exact inter_subset_right

/-- Forward `C^n` regularity of `preferredChartAt I F V x` on its source. -/
theorem contMDiffOn_preferredChartAt {n : ℕ∞ω} [IsManifold I n M] (x : M) :
    ContMDiffOn I 𝓘(𝕜, E) n (preferredChartAt I F V x) (preferredChartAt I F V x).source :=
  OpenPartialHomeomorph.contMDiffOn_extendTrans _
    (restr_mem_maximalAtlas _ (IsManifold.chart_mem_maximalAtlas x)
      (trivializationAt F V x).open_baseSet)
    contDiff_id

/-- Inverse `C^n` regularity of `preferredChartAt I F V x` on its target. -/
theorem contMDiffOn_preferredChartAt_symm {n : ℕ∞ω} [IsManifold I n M] (x : M) :
    ContMDiffOn 𝓘(𝕜, E) I n (preferredChartAt I F V x).symm (preferredChartAt I F V x).target :=
  OpenPartialHomeomorph.contMDiffOn_extendTrans_symm _
    (restr_mem_maximalAtlas _ (IsManifold.chart_mem_maximalAtlas x)
      (trivializationAt F V x).open_baseSet)
    contDiff_id

end PreferredChartAt

section ChartTestTopology

variable {E H M F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  [TopologicalSpace M] [ChartedSpace H M] [T2Space M]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {V : M → Type*} [∀ x, AddCommGroup (V x)] [∀ x, Module ℝ (V x)]
  [∀ x, TopologicalSpace (V x)] [TopologicalSpace (TotalSpace F V)]
  [FiberBundle F V] [VectorBundle ℝ F V]
  {n : ℕ∞} [ContMDiffVectorBundle n F V I]

/-- The linear extension-by-zero map sending native test functions on `d.targetOpens` to compactly
supported `C^n` bundle sections. -/
def ChartTestDatum.chartTestSection (d : ChartTestDatum I F n V) :
    𝓓^{n}(d.targetOpens, F) →ₗ[ℝ] compactlySupported I F n V :=
  d.triv.chartTestSection d.chart d.contMDiffOn_chart d.source_subset_baseSet

@[simp]
theorem ChartTestDatum.chartTestSection_eq (d : ChartTestDatum I F n V) :
    d.chartTestSection =
      d.triv.chartTestSection d.chart d.contMDiffOn_chart d.source_subset_baseSet :=
  (rfl)

/-- **The chart-extension final locally convex topology on compactly supported bundle sections.**
It is the finest locally convex real vector topology on `compactlySupported I F n V` making all
native test-function chart/frame extension maps `Bundle.Trivialization.chartTestSection`
continuous. Unlike `compactlySupportedTopology`, it takes no frame-cover parameter. -/
@[instance_reducible]
def chartTestTopology : TopologicalSpace (compactlySupported I F n V) :=
  TauCeti.finalLocallyConvexTopology
    (ChartTestDatum.chartTestSection (I := I) (F := F) (n := n) (V := V))

/-- Unfolding equation expressing `chartTestTopology` as the final locally convex topology of all
smooth chart/frame extension maps. -/
theorem chartTestTopology_eq_finalLocallyConvexTopology :
    chartTestTopology (I := I) (F := F) (n := n) (V := V) =
      TauCeti.finalLocallyConvexTopology
        (ChartTestDatum.chartTestSection (I := I) (F := F) (n := n) (V := V)) :=
  (rfl)

/-- Addition and negation are continuous in `chartTestTopology`. -/
theorem isTopologicalAddGroup_chartTestTopology :
    letI := chartTestTopology (I := I) (F := F) (n := n) (V := V)
    IsTopologicalAddGroup (compactlySupported I F n V) := by
  let := chartTestTopology (I := I) (F := F) (n := n) (V := V)
  infer_instance

/-- Real scalar multiplication is jointly continuous in `chartTestTopology`. -/
theorem continuousSMul_chartTestTopology :
    letI := chartTestTopology (I := I) (F := F) (n := n) (V := V)
    ContinuousSMul ℝ (compactlySupported I F n V) := by
  let := chartTestTopology (I := I) (F := F) (n := n) (V := V)
  infer_instance

/-- Compactly supported bundle sections with `chartTestTopology` form a locally convex real
topological vector space. -/
theorem locallyConvexSpace_chartTestTopology :
    letI := chartTestTopology (I := I) (F := F) (n := n) (V := V)
    LocallyConvexSpace ℝ (compactlySupported I F n V) := by
  let := chartTestTopology (I := I) (F := F) (n := n) (V := V)
  infer_instance

/-- Every native chart/frame test-function extension map is continuous into `chartTestTopology`. -/
theorem continuous_chartTestSection_chartTestTopology
    (t : Trivialization F (π F V)) [MemTrivializationAtlas t]
    (c : OpenPartialHomeomorph M E) (hc : ContMDiffOn I 𝓘(ℝ, E) n c c.source)
    (hct : c.source ⊆ t.baseSet) :
    letI := chartTestTopology (I := I) (F := F) (n := n) (V := V)
    Continuous (t.chartTestSection c hc hct) :=
  TauCeti.FinalLocallyConvexTopology.continuous
    (ChartTestDatum.chartTestSection (I := I) (F := F) (n := n) (V := V))
    ⟨t, inferInstance, c, hc, hct⟩

/-- **Universal continuity criterion for `chartTestTopology`.** A linear map (over `ℝ` or any
`ℝ`-algebra `𝕜`) from compactly supported sections into a locally convex real topological vector
space is continuous if and only if its precomposition with every native chart/frame extension map
`t.chartTestSection c hc hct` is continuous. -/
theorem continuous_chartTestTopology_iff {G : Type*} [AddCommGroup G] [Module ℝ G]
    [TopologicalSpace G] [IsTopologicalAddGroup G] [ContinuousSMul ℝ G] [LocallyConvexSpace ℝ G]
    {𝕜 : Type*} [Semiring 𝕜] [Algebra ℝ 𝕜]
    [Module 𝕜 (compactlySupported I F n V)] [IsScalarTower ℝ 𝕜 (compactlySupported I F n V)]
    [Module 𝕜 G] [IsScalarTower ℝ 𝕜 G]
    (g : compactlySupported I F n V →ₗ[𝕜] G) :
    letI := chartTestTopology (I := I) (F := F) (n := n) (V := V)
    Continuous g ↔
      ∀ (t : Trivialization F (π F V)) [MemTrivializationAtlas t]
        (c : OpenPartialHomeomorph M E) (hc : ContMDiffOn I 𝓘(ℝ, E) n c c.source)
        (hct : c.source ⊆ t.baseSet),
        Continuous (g ∘ t.chartTestSection c hc hct) :=
  (TauCeti.FinalLocallyConvexTopology.continuous_iff_continuous_comp
    (ChartTestDatum.chartTestSection (I := I) (F := F) (n := n) (V := V)) g).trans
    ⟨fun h t _ c hc hct ↦ h ⟨t, inferInstance, c, hc, hct⟩,
      fun h d ↦ h d.triv d.chart d.contMDiffOn_chart d.source_subset_baseSet⟩

section ExtensionScalars

variable {𝕜' : Type*} [NontriviallyNormedField 𝕜'] [NormedAlgebra ℝ 𝕜']
  [NormedSpace 𝕜' F] [IsScalarTower ℝ 𝕜' F]
  [∀ x, Module 𝕜' (V x)] [∀ x, IsScalarTower ℝ 𝕜' (V x)] [VectorBundle 𝕜' F V]

/-- Constant multiplication by an extension scalar `a : 𝕜'` is continuous for `chartTestTopology`,
without any boundarylessness, local-compactness, or manifold-regularity hypothesis on `M`. -/
theorem continuousConstSMul_chartTestTopology_ofNormedAlgebra :
    letI := chartTestTopology (I := I) (F := F) (n := n) (V := V)
    ContinuousConstSMul 𝕜' (compactlySupported I F n V) := by
  let := chartTestTopology (I := I) (F := F) (n := n) (V := V)
  let := isTopologicalAddGroup_chartTestTopology (I := I) (F := F) (n := n) (V := V)
  let := continuousSMul_chartTestTopology (I := I) (F := F) (n := n) (V := V)
  let := locallyConvexSpace_chartTestTopology (I := I) (F := F) (n := n) (V := V)
  refine ⟨fun a ↦ ?_⟩
  let la : compactlySupported I F n V →ₗ[ℝ] compactlySupported I F n V :=
    { toFun s := a • s
      map_add' := smul_add a
      map_smul' r s := by
        rw [RingHom.id_apply, ← algebraMap_smul 𝕜' r (a • s), ← algebraMap_smul 𝕜' r s,
          smul_smul, mul_comm, mul_smul] }
  refine (continuous_chartTestTopology_iff la).2 fun t _ c hc hct ↦ ?_
  have hsmul : Continuous (fun φ : 𝓓^{n}(⟨c.target, c.open_target⟩, F) ↦ a • φ) :=
    (TestFunction.postcompCLM (𝕜 := ℝ)
      (ContinuousLinearMap.lsmul ℝ 𝕜' a : F →L[ℝ] F)).continuous
  exact ((continuous_chartTestSection_chartTestTopology t c hc hct).comp hsmul).congr fun φ ↦
    t.chartTestSection_smul_ofNormedAlgebra c hc hct a φ

/-- When the extension field `𝕜'` is finite-dimensional over `ℝ` (in particular `𝕜' = ℂ`), scalar
multiplication by `𝕜'` is jointly continuous for `chartTestTopology`. -/
theorem continuousSMul_chartTestTopology_ofNormedAlgebra [FiniteDimensional ℝ 𝕜'] :
    letI := chartTestTopology (I := I) (F := F) (n := n) (V := V)
    ContinuousSMul 𝕜' (compactlySupported I F n V) := by
  let := chartTestTopology (I := I) (F := F) (n := n) (V := V)
  let := isTopologicalAddGroup_chartTestTopology (I := I) (F := F) (n := n) (V := V)
  let := continuousSMul_chartTestTopology (I := I) (F := F) (n := n) (V := V)
  let := continuousConstSMul_chartTestTopology_ofNormedAlgebra
    (𝕜' := 𝕜') (I := I) (F := F) (n := n) (V := V)
  let b := Module.finBasis ℝ 𝕜'
  have hb : Continuous b.equivFun :=
    LinearMap.continuous_of_finiteDimensional b.equivFun.toLinearMap
  refine ⟨(continuous_finsetSum Finset.univ fun i _ ↦
    Continuous.smul (f := fun p : 𝕜' × compactlySupported I F n V ↦ b.equivFun p.1 i)
      (g := fun p : 𝕜' × compactlySupported I F n V ↦ b i • p.2)
      ((continuous_apply i).comp (hb.comp continuous_fst))
      ((continuous_const_smul (b i)).comp continuous_snd)).congr fun p ↦ ?_⟩
  conv_rhs => rw [← b.sum_equivFun p.1, Finset.sum_smul]
  simp only [smul_assoc]
  rfl

end ExtensionScalars

section ChartCoverComparison

variable [FiniteDimensional ℝ E] [IsManifold I n M]
  {ι : Type*} (e : ι → Trivialization F (π F V)) [∀ i, MemTrivializationAtlas (e i)]
  (U : ι → Opens M) (hU : ∀ i, (U i : Set M) ⊆ (e i).baseSet)
  (hcover : ∀ x : M, ∃ i, x ∈ U i)
  {κ : Type*} (t : κ → Trivialization F (π F V)) [∀ j, MemTrivializationAtlas (t j)]
  (c : κ → OpenPartialHomeomorph M E)
  (hc : ∀ j, ContMDiffOn I 𝓘(ℝ, E) n (c j) (c j).source)
  (hc_symm : ∀ j, ContMDiffOn 𝓘(ℝ, E) I n (c j).symm (c j).target)
  (hct : ∀ j, (c j).source ⊆ (t j).baseSet)
  (hchart_cover : ∀ x : M, ∃ j, x ∈ (c j).source)

include hcover hc_symm hchart_cover in
private theorem compactlySupportedTopology_le_finalLocallyConvexTopology_chartTestSection :
    compactlySupportedTopology (I := I) (n := n) e U hU ≤
      TauCeti.finalLocallyConvexTopology
        (fun j ↦ (t j).chartTestSection (c j) (hc j) (hct j)) := by
  let := frameTopology (I := I) (n := n) e U hU
  let := TauCeti.finalLocallyConvexTopology (fun j ↦ (t j).chartTestSection (c j) (hc j) (hct j))
  rw [compactlySupportedTopology_eq_finalLocallyConvexTopology e U hU]
  refine (TauCeti.FinalLocallyConvexTopology.le_iff
    (ofSupportedIn (I := I) (F := F) (V := V) (n := n)) _).2 fun K ↦ ?_
  obtain ⟨α, hfin, r, χ, hχc, hχs, -, -, hχsum⟩ :=
    K.isCompact.exists_contMDiffMap_partitionOfUnity I (n := n)
      (U := fun j ↦ (c j).source) fun x _ ↦
        let ⟨j, hj⟩ := hchart_cover x
        ⟨j, (c j).open_source.mem_nhds hj⟩
  have hterm (a : α) :
      Continuous (fun s : supportedIn I F n V K ↦
        (t (r a)).chartTestSection (c (r a)) (hc (r a)) (hct (r a))
          ((t (r a)).chartCutoffTestFunction (c (r a)) (hc_symm (r a)) (hct (r a))
            (χ a) (hχc a) (hχs a) s.1)) :=
    (TauCeti.FinalLocallyConvexTopology.continuous
      (fun j ↦ (t j).chartTestSection (c j) (hc j) (hct j)) (r a)).comp
      (((t (r a)).continuous_chartCutoffTestFunction (c (r a)) (hc_symm (r a)) (hct (r a))
        e U hU hcover (χ a) (hχc a) (hχs a)).comp continuous_subtype_val)
  refine (continuous_finsetSum Finset.univ fun a _ ↦ hterm a).congr fun s ↦ ?_
  apply Subtype.ext
  ext x
  have hcoe : ((∑ a : α, (t (r a)).chartTestSection (c (r a)) (hc (r a)) (hct (r a))
        ((t (r a)).chartCutoffTestFunction (c (r a)) (hc_symm (r a)) (hct (r a))
          (χ a) (hχc a) (hχs a) s.1) : compactlySupported I F n V) : Cₛ^n⟮I; F, V⟯) =
      ∑ a : α, χ a • s.1 := by
    rw [Submodule.coe_sum]
    exact Finset.sum_congr rfl fun a _ ↦ congrArg Subtype.val
      ((t (r a)).chartTestSection_chartCutoffTestFunction (c (r a)) (hc_symm (r a))
        (hct (r a)) (hc (r a)) (χ a) (hχc a) (hχs a) s.1)
  have heval : (∑ a : α, χ a • s.1 : Cₛ^n⟮I; F, V⟯) x = ∑ a : α, (χ a • s.1) x := by
    have h := congrFun (map_sum (coeAddHom I F n V) (fun a : α ↦ χ a • s.1) Finset.univ) x
    simp only [coeAddHom_apply, Finset.sum_apply] at h
    exact h
  rw [hcoe, heval, ofSupportedIn_apply]
  simp only [ContMDiffSection.smul_apply, ← Finset.sum_smul]
  by_cases hx : x ∈ (K : Set M)
  · rw [hχsum x hx, one_smul]
  · rw [s.1.eq_zero_of_notMem_tsupport fun h ↦ hx (mem_supportedIn.1 s.2 h), smul_zero]

include hcover hc_symm hchart_cover in
/-- Any covering family of two-sided `C^n` charts subordinate to smooth bundle trivializations
generates the fixed-compact inductive topology on `compactlySupported I F n V` as a final locally
convex topology. -/
theorem compactlySupportedTopology_eq_finalLocallyConvexTopology_chartTestSection :
    compactlySupportedTopology (I := I) (n := n) e U hU =
      TauCeti.finalLocallyConvexTopology
        (fun j ↦ (t j).chartTestSection (c j) (hc j) (hct j)) := by
  let := frameTopology (I := I) (n := n) e U hU
  apply le_antisymm
  · exact compactlySupportedTopology_le_finalLocallyConvexTopology_chartTestSection
      e U hU hcover t c hc hc_symm hct hchart_cover
  · rw [compactlySupportedTopology_eq_finalLocallyConvexTopology e U hU]
    refine (TauCeti.FinalLocallyConvexTopology.le_iff _
      (TauCeti.finalLocallyConvexTopology
        (ofSupportedIn (I := I) (F := F) (V := V) (n := n)))).2 fun j ↦ ?_
    rw [← compactlySupportedTopology_eq_finalLocallyConvexTopology e U hU]
    exact (t j).continuous_chartTestSection (c j) (hc j) (hct j) e U hU

include hcover hc hc_symm hct hchart_cover in
/-- Whenever `M` admits a covering family of two-sided `C^n` charts subordinate to smooth bundle
trivializations, the fixed-compact inductive topology of any covering smooth frame system equals
`chartTestTopology`. -/
theorem compactlySupportedTopology_eq_chartTestTopology_of_chart_cover :
    compactlySupportedTopology (I := I) (n := n) e U hU =
      chartTestTopology (I := I) (F := F) (n := n) (V := V) := by
  let := frameTopology (I := I) (n := n) e U hU
  have h1 : compactlySupportedTopology (I := I) (n := n) e U hU ≤
      TauCeti.finalLocallyConvexTopology (fun j ↦ (t j).chartTestSection (c j) (hc j) (hct j)) :=
    compactlySupportedTopology_le_finalLocallyConvexTopology_chartTestSection
      e U hU hcover t c hc hc_symm hct hchart_cover
  have h2 : TauCeti.finalLocallyConvexTopology
        (fun j ↦ (t j).chartTestSection (c j) (hc j) (hct j)) ≤
      chartTestTopology (I := I) (F := F) (n := n) (V := V) :=
    (TauCeti.FinalLocallyConvexTopology.le_iff _
      (chartTestTopology (I := I) (F := F) (n := n) (V := V))).2 fun j ↦
      continuous_chartTestSection_chartTestTopology (t j) (c j) (hc j) (hct j)
  have h3 : chartTestTopology (I := I) (F := F) (n := n) (V := V) ≤
      compactlySupportedTopology (I := I) (n := n) e U hU := by
    rw [compactlySupportedTopology_eq_finalLocallyConvexTopology e U hU]
    refine (TauCeti.FinalLocallyConvexTopology.le_iff _
      (TauCeti.finalLocallyConvexTopology
        (ofSupportedIn (I := I) (F := F) (V := V) (n := n)))).2 fun d ↦ ?_
    rw [← compactlySupportedTopology_eq_finalLocallyConvexTopology e U hU]
    exact d.triv.continuous_chartTestSection
      d.chart d.contMDiffOn_chart d.source_subset_baseSet e U hU
  exact le_antisymm (h1.trans h2) h3

end ChartCoverComparison

section Boundaryless

variable [I.Boundaryless] [FiniteDimensional ℝ E] [IsManifold I n M]

section FrameCover

variable {ι : Type*} (e : ι → Trivialization F (π F V)) [∀ i, MemTrivializationAtlas (e i)]
  (U : ι → Opens M) (hU : ∀ i, (U i : Set M) ⊆ (e i).baseSet)
  (hcover : ∀ x : M, ∃ i, x ∈ U i)

include hcover in
/-- **Equality of the chart-extension final topology and the fixed-compact inductive limit.** On a
boundaryless Hausdorff finite-dimensional `C^n` manifold, `chartTestTopology` coincides with
`compactlySupportedTopology` for every covering smooth frame system. -/
theorem chartTestTopology_eq_compactlySupportedTopology :
    chartTestTopology (I := I) (F := F) (n := n) (V := V) =
      compactlySupportedTopology (I := I) (n := n) e U hU :=
  (compactlySupportedTopology_eq_chartTestTopology_of_chart_cover e U hU hcover
    (fun x ↦ trivializationAt F V x) (preferredChartAt I F V)
    (contMDiffOn_preferredChartAt (I := I) (F := F) (V := V) (n := n))
    (contMDiffOn_preferredChartAt_symm (I := I) (F := F) (V := V) (n := n))
    preferredChartAt_source_subset_baseSet
    (fun x ↦ ⟨x, mem_preferredChartAt_source x⟩)).symm

include hcover in
/-- Each fixed-compact support stage embeds topologically into `compactlySupported I F n V` with
`chartTestTopology`. -/
theorem isEmbedding_ofSupportedIn_chartTestTopology (K : Compacts M) :
    letI := frameTopology (I := I) (n := n) e U hU
    letI := chartTestTopology (I := I) (F := F) (n := n) (V := V)
    Topology.IsEmbedding (ofSupportedIn (I := I) (F := F) (V := V) (n := n) K) := by
  let := frameTopology (I := I) (n := n) e U hU
  have h : @Topology.IsEmbedding _ _ _
      (chartTestTopology (I := I) (F := F) (n := n) (V := V))
      (ofSupportedIn (I := I) (F := F) (V := V) (n := n) K) := by
    rw [chartTestTopology_eq_compactlySupportedTopology e U hU hcover]
    exact isEmbedding_ofSupportedIn e U hU K
  exact h

include hcover in
/-- Every fixed-compact support inclusion is continuous into `chartTestTopology`. -/
theorem continuous_ofSupportedIn_chartTestTopology (K : Compacts M) :
    letI := frameTopology (I := I) (n := n) e U hU
    letI := chartTestTopology (I := I) (F := F) (n := n) (V := V)
    Continuous (ofSupportedIn (I := I) (F := F) (V := V) (n := n) K) := by
  let := frameTopology (I := I) (n := n) e U hU
  let := chartTestTopology (I := I) (F := F) (n := n) (V := V)
  exact (isEmbedding_ofSupportedIn_chartTestTopology e U hU hcover K).continuous

include hcover in
/-- On a compact boundaryless manifold, `chartTestTopology` equals the subspace topology induced
by any covering smooth frame topology on all sections. -/
theorem chartTestTopology_eq_induced [CompactSpace M] :
    chartTestTopology (I := I) (F := F) (n := n) (V := V) =
      TopologicalSpace.induced (Subtype.val : compactlySupported I F n V → Cₛ^n⟮I; F, V⟯)
        (frameTopology (I := I) (n := n) e U hU) := by
  rw [chartTestTopology_eq_compactlySupportedTopology e U hU hcover,
    compactlySupportedTopology_eq_induced]

include hcover in
/-- On a boundaryless Hausdorff finite-dimensional `C^n` manifold, a linear map out of
`compactlySupportedTopology` into a locally convex space is continuous if and only if its
compositions with all native chart/frame test-function extension maps are continuous. -/
theorem continuous_compactlySupportedTopology_iff_chartTestSection {G : Type*} [AddCommGroup G]
    [Module ℝ G] [TopologicalSpace G] [IsTopologicalAddGroup G] [ContinuousSMul ℝ G]
    [LocallyConvexSpace ℝ G] {𝕜 : Type*} [Semiring 𝕜] [Algebra ℝ 𝕜]
    [Module 𝕜 (compactlySupported I F n V)] [IsScalarTower ℝ 𝕜 (compactlySupported I F n V)]
    [Module 𝕜 G] [IsScalarTower ℝ 𝕜 G]
    (g : compactlySupported I F n V →ₗ[𝕜] G) :
    letI := compactlySupportedTopology (I := I) (n := n) e U hU
    Continuous g ↔
      ∀ (t : Trivialization F (π F V)) [MemTrivializationAtlas t]
        (c : OpenPartialHomeomorph M E) (hc : ContMDiffOn I 𝓘(ℝ, E) n c c.source)
        (hct : c.source ⊆ t.baseSet),
        Continuous (g ∘ t.chartTestSection c hc hct) :=
  (Eq.to_iff (congrArg (fun τ ↦ @Continuous _ _ τ _ g)
    (chartTestTopology_eq_compactlySupportedTopology (I := I) (n := n) e U hU hcover).symm)).trans
    (continuous_chartTestTopology_iff g)

end FrameCover

/-- On a boundaryless Hausdorff finite-dimensional `C^n` manifold, `chartTestTopology` is already
generated as a final locally convex topology by the preferred chart extensions at points of `M`. -/
theorem chartTestTopology_eq_finalLocallyConvexTopology_preferredChartAt :
    chartTestTopology (I := I) (F := F) (n := n) (V := V) =
      TauCeti.finalLocallyConvexTopology (fun x : M ↦
        (trivializationAt F V x).chartTestSection (preferredChartAt I F V x)
          (contMDiffOn_preferredChartAt x) (preferredChartAt_source_subset_baseSet x)) := by
  let e₀ (x : M) := trivializationAt F V x
  let U₀ (x : M) : Opens M := ⟨(e₀ x).baseSet, (e₀ x).open_baseSet⟩
  have hU₀ (x : M) : (U₀ x : Set M) ⊆ (e₀ x).baseSet := Subset.rfl
  have hcover₀ : ∀ x : M, ∃ y : M, x ∈ U₀ y := fun x ↦ ⟨x, mem_baseSet_trivializationAt F V x⟩
  rw [chartTestTopology_eq_compactlySupportedTopology e₀ U₀ hU₀ hcover₀]
  exact compactlySupportedTopology_eq_finalLocallyConvexTopology_chartTestSection
    e₀ U₀ hU₀ hcover₀ e₀ (preferredChartAt I F V)
    (contMDiffOn_preferredChartAt (I := I) (F := F) (V := V) (n := n))
    (contMDiffOn_preferredChartAt_symm (I := I) (F := F) (V := V) (n := n))
    preferredChartAt_source_subset_baseSet
    (fun x ↦ ⟨x, mem_preferredChartAt_source x⟩)

/-- Universal continuity criterion on a boundaryless manifold in terms of preferred charts alone:
a linear map into a locally convex space is continuous for `chartTestTopology` if and only if its
compositions with the preferred chart extensions at all points `x : M` are continuous. -/
theorem continuous_chartTestTopology_iff_preferredChartAt {G : Type*} [AddCommGroup G]
    [Module ℝ G] [TopologicalSpace G] [IsTopologicalAddGroup G] [ContinuousSMul ℝ G]
    [LocallyConvexSpace ℝ G] {𝕜 : Type*} [Semiring 𝕜] [Algebra ℝ 𝕜]
    [Module 𝕜 (compactlySupported I F n V)] [IsScalarTower ℝ 𝕜 (compactlySupported I F n V)]
    [Module 𝕜 G] [IsScalarTower ℝ 𝕜 G]
    (g : compactlySupported I F n V →ₗ[𝕜] G) :
    letI := chartTestTopology (I := I) (F := F) (n := n) (V := V)
    Continuous g ↔
      ∀ x : M, Continuous (g ∘ (trivializationAt F V x).chartTestSection
        (preferredChartAt I F V x) (contMDiffOn_preferredChartAt x)
        (preferredChartAt_source_subset_baseSet x)) :=
  (Eq.to_iff (congrArg (fun τ ↦ @Continuous _ _ τ _ g)
    chartTestTopology_eq_finalLocallyConvexTopology_preferredChartAt)).trans
    (TauCeti.FinalLocallyConvexTopology.continuous_iff_continuous_comp _ g)

/-- Forgetting compact support is continuous from `chartTestTopology` into any smooth frame
topology, even if the chosen frame domains do not cover `M`. -/
theorem continuous_val_chartTestTopology
    {ι : Type*} (e : ι → Trivialization F (π F V)) [∀ i, MemTrivializationAtlas (e i)]
    (U : ι → Opens M) (hU : ∀ i, (U i : Set M) ⊆ (e i).baseSet) :
    letI := frameTopology (I := I) (n := n) e U hU
    letI := chartTestTopology (I := I) (F := F) (n := n) (V := V)
    Continuous (Subtype.val : compactlySupported I F n V → Cₛ^n⟮I; F, V⟯) := by
  let e₀ (x : M) := trivializationAt F V x
  let U₀ (x : M) : Opens M := ⟨(e₀ x).baseSet, (e₀ x).open_baseSet⟩
  have hU₀ (x : M) : (U₀ x : Set M) ⊆ (e₀ x).baseSet := Subset.rfl
  have hcover₀ : ∀ x : M, ∃ y : M, x ∈ U₀ y := fun x ↦ ⟨x, mem_baseSet_trivializationAt F V x⟩
  have hval : @Continuous _ _ (chartTestTopology (I := I) (F := F) (n := n) (V := V))
      (frameTopology (I := I) (n := n) e₀ U₀ hU₀)
      (Subtype.val : compactlySupported I F n V → Cₛ^n⟮I; F, V⟯) := by
    rw [chartTestTopology_eq_compactlySupportedTopology (I := I) (n := n) e₀ U₀ hU₀ hcover₀]
    exact continuous_val_compactlySupportedTopology (I := I) (n := n) e₀ U₀ hU₀
  exact continuous_le_rng
    (frameTopology_le_of_cover (I := I) (n := n) e₀ U₀ hU₀ hcover₀ e U hU) hval

/-- On a boundaryless Hausdorff finite-dimensional `C^n` manifold, `chartTestTopology` is
Hausdorff, with no auxiliary frame-cover parameter. -/
theorem t2Space_chartTestTopology :
    letI := chartTestTopology (I := I) (F := F) (n := n) (V := V)
    T2Space (compactlySupported I F n V) := by
  let e₀ (x : M) := trivializationAt F V x
  let U₀ (x : M) : Opens M := ⟨(e₀ x).baseSet, (e₀ x).open_baseSet⟩
  have hU₀ (x : M) : (U₀ x : Set M) ⊆ (e₀ x).baseSet := Subset.rfl
  have hcover₀ : ∀ x : M, ∃ y : M, x ∈ U₀ y := fun x ↦ ⟨x, mem_baseSet_trivializationAt F V x⟩
  have h : @T2Space _ (chartTestTopology (I := I) (F := F) (n := n) (V := V)) := by
    rw [chartTestTopology_eq_compactlySupportedTopology (I := I) (n := n) e₀ U₀ hU₀ hcover₀]
    exact t2Space_compactlySupportedTopology e₀ U₀ hU₀ hcover₀
  exact h

end Boundaryless

end ChartTestTopology

