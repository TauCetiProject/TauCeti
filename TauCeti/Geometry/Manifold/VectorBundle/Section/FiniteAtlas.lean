public import TauCeti.Geometry.Manifold.VectorBundle.Section.WithSeminorms
public import TauCeti.Geometry.Manifold.ExtChartAt
import TauCeti.Analysis.Calculus.ContDiff.Bounds
import TauCeti.Geometry.Manifold.ContMDiffMap.Chart.CountableSeminorms

/-!
# Finite frame-atlas `C^k` norms on bundle sections

Let `V` be a `C^k` vector bundle over a manifold `M`, with smooth frames `e i` on open frame
domains `U i`. The compact derivative topology `ContMDiffSection.frameTopology` on the sections
`Cₛ^k⟮I; F, V⟯` is generated by the compact chart seminorms of the frame coefficients, one for
every frame, chart centre, order and compact coordinate set. This file shows that, when `M` is
compact and `k` is finite, finitely many of them suffice: the space of `C^k` sections is a
normable space (`ContMDiffSection.isNormableSpace_frameTopology`). This is the bundle analogue of
the normability of `C^k` functions, `ContMDiffMap.isNormableSpace_of_compactSpace`. Under the
hypotheses of `ContMDiffSection.completeSpace_frameTopology`, a complete model fibre over a
boundaryless model with locally compact model space, the space is also complete, hence a Banach
space. Spaces of `C^k` sections of tensor bundles over a compact manifold, such as symmetric
bilinear forms or endomorphisms of the tangent bundle, are the spaces of finite-regularity
Riemannian metrics and almost complex structures to which Banach-space methods such as the
Sard–Smale theorem apply.

The comparison of two compact chart seminorms of sections, taken in different frames and charts,
is `Bundle.Trivialization.exists_chartCkSeminorm_le_chartCkSeminorm`. On the overlap, the
coefficients in the first frame and chart are those in the second, transported by the transition
of the frames and composed with the change of coordinates, and the compact Leibniz and
Faà di Bruno estimate `ContDiffOn.exists_norm_iteratedFDerivWithin_clm_apply_comp_le` bounds their
derivatives through order `k`. No bound on the transition or on the chart changes away from the
compact set is needed.

A *finite frame atlas* is a finite family of frames `e (r j)` with chart centres `c j` in their
frame domains and compact coordinate pieces `K j` in the charts of `U (r j)` at `c j`. Its
`C^k` seminorm (`ContMDiffSection.finiteFrameSeminorm`) is the largest compact chart `C^k`
seminorm of the coefficients over the pieces. When the relative interiors of the pieces cover
`M`, every compact chart seminorm of the frame topology is bounded by a multiple of it
(`ContMDiffSection.exists_chartCkSeminorm_le_finiteFrameSeminorm`), so any two such atlases give
equivalent norms (`ContMDiffSection.exists_finiteFrameSeminorm_le`) and the seminorm generates
the frame topology (`ContMDiffSection.withSeminorms_finiteFrameSeminorm`). It is a norm when its
pieces cover `M` (`ContMDiffSection.finiteFrameSeminorm_eq_zero_iff`). A compact manifold
modelled on a locally compact space has such an atlas for every covering family of frame domains
(`TauCeti.exists_finite_subordinate_compact_chart_cover`).

The coordinate pieces may lie in boundary or corner charts, the model fibre may be infinite
dimensional, and the frames need not be bounded.

## Main definitions

* `ContMDiffSection.finiteFrameSeminorm`: the `C^k` seminorm of a finite frame atlas.

## Main results

* `Bundle.Trivialization.exists_chartCkSeminorm_le_chartCkSeminorm`: a compact chart `C^k`
  seminorm of sections is bounded by a multiple of one in another frame and chart covering it.
* `ContMDiffSection.exists_chartCkSeminorm_le_finiteFrameSeminorm`: every compact chart `C^k`
  seminorm of sections is bounded by a multiple of the seminorm of a covering finite frame atlas.
* `ContMDiffSection.exists_finiteFrameSeminorm_le`: equivalence of finite frame-atlas norms.
* `ContMDiffSection.finiteFrameSeminorm_eq_zero_iff`: the finite frame-atlas seminorm is a norm.
* `ContMDiffSection.withSeminorms_finiteFrameSeminorm`: it generates the frame topology.
* `ContMDiffSection.isNormableSpace_frameTopology`: on a compact manifold, the space of `C^k`
  sections is normable.

## References

* M. Hirsch, *Differential Topology*, GTM 33, Chapter 2, §1, for the `C^k` topology defined by
  finitely many charts on a compact manifold.
* R. Palais, *Foundations of Global Non-linear Analysis*, Benjamin, 1968, for the Banach spaces
  of `C^k` sections of a vector bundle over a compact manifold.
-/

public section

noncomputable section

open Bundle Set Filter Topology TopologicalSpace IsManifold
open scoped ContDiff Manifold TauCeti.ManifoldWeakWhitney

namespace Bundle.Trivialization

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace 𝕜 F]
  {V : M → Type*} [∀ x, AddCommGroup (V x)] [∀ x, Module 𝕜 (V x)]
  [∀ x, TopologicalSpace (V x)] [TopologicalSpace (TotalSpace F V)]
  [FiberBundle F V] [VectorBundle 𝕜 F V]
  {n : ℕ∞ω} [ContMDiffVectorBundle n F V I] [IsManifold I n M]
  (e e' : Trivialization F (π F V)) [MemTrivializationAtlas e] [MemTrivializationAtlas e']
  {U U' : Opens M} (hU : (U : Set M) ⊆ e.baseSet) (hU' : (U' : Set M) ⊆ e'.baseSet)

/-- The coordinates, in the ambient chart at `x`, of the points of the overlap of the frame
domains `U` and `U'` lying in the ambient chart at `y`. -/
private abbrev chartOverlap (U U' : Opens M) (x y : M) : Set E :=
  (extChartAt I x).target ∩ (extChartAt I x).symm ⁻¹' ((U : Set M) ∩ U' ∩ (extChartAt I y).source)

omit [IsManifold I n M] in
private theorem chartOverlap_subset (x : U) (y : M) :
    chartOverlap (I := I) U U' x y ⊆ (extChartAt I x).target := fun z hz ↦ by
  rw [U.extChartAt_target_eq x]
  exact ⟨hz.1, hz.2.1.1⟩

omit [IsManifold I n M] in
private theorem uniqueDiffOn_chartOverlap (x y : M) :
    UniqueDiffOn 𝕜 (chartOverlap (I := I) U U' x y) := by
  obtain ⟨u, hu, hEq⟩ := continuousOn_iff'.mp (continuousOn_extChartAt_symm (I := I) x) _
    ((U.isOpen.inter U'.isOpen).inter (isOpen_extChartAt_source (I := I) y))
  rw [chartOverlap, inter_comm, hEq, inter_comm]
  exact (uniqueDiffOn_extChartAt_target x).inter hu

omit [IsManifold I n M] in
/-- The coordinate overlap is a neighbourhood, within the chart target of `U` at `x`, of the
coordinates of every point of `U'` in the chart at `y`. -/
private theorem chartOverlap_mem_nhdsWithin (x : U) (y : M) {z : E}
    (hz : z ∈ (extChartAt I x).target) (hzU' : (extChartAt I (x : M)).symm z ∈ U')
    (hzy : (extChartAt I (x : M)).symm z ∈ (extChartAt I y).source) :
    chartOverlap (I := I) U U' x y ∈ 𝓝[(extChartAt I x).target] z := by
  have hc : ContinuousWithinAt (extChartAt I (x : M)).symm (extChartAt I x).target z :=
    ((continuousOn_extChartAt_symm (I := I) (x : M)).mono (U.extChartAt_target_subset x)) z hz
  have hO := hc.preimage_mem_nhdsWithin
    ((U'.isOpen.inter (isOpen_extChartAt_source (I := I) y)).mem_nhds ⟨hzU', hzy⟩)
  refine mem_of_superset (inter_mem self_mem_nhdsWithin hO) fun w ⟨hwt, hwO⟩ ↦ ?_
  rw [U.extChartAt_target_eq x] at hwt
  exact ⟨hwt.1, ⟨hwt.2, hwO.1⟩, hwO.2⟩

omit [IsManifold I n M] in
/-- On the coordinate overlap, the coefficients of a section in the frame `e`, read in the chart
at `x`, are its coefficients in the frame `e'`, read in the chart at `y` after the change of
coordinates and transported by the transition of the frames. -/
private theorem eqOn_frameCoordinates_comp_extChartAt_symm (x : U) (y : U')
    (s : Cₛ^n⟮I; F, V⟯) :
    EqOn ((e.frameCoordinates hU s) ∘ (extChartAt I x).symm)
      (fun z ↦ (e'.coordChangeL 𝕜 e ((extChartAt I (x : M)).symm z) : F →L[𝕜] F)
        (((e'.frameCoordinates hU' s) ∘ (extChartAt I y).symm)
          ((extChartAt I (y : M) ∘ (extChartAt I (x : M)).symm) z)))
      (chartOverlap (I := I) U U' x y) := by
  intro z hz
  have hy : extChartAt I (y : M) ((extChartAt I (x : M)).symm z) ∈ (extChartAt I y).target := by
    rw [U'.extChartAt_target_eq y, mem_inter_iff, mem_preimage,
      (extChartAt I (y : M)).left_inv hz.2.2]
    exact ⟨(extChartAt I (y : M)).map_source hz.2.2, hz.2.1.2⟩
  have hq : ((extChartAt I y).symm (extChartAt I (y : M) ((extChartAt I (x : M)).symm z)) : M) =
      (extChartAt I (x : M)).symm z :=
    (U'.coe_extChartAt_symm_apply y hy).trans ((extChartAt I (y : M)).left_inv hz.2.2)
  simp only [Function.comp_apply, frameCoordinates_apply]
  rw [U.coe_extChartAt_symm_apply x (chartOverlap_subset x y hz), hq, ContinuousLinearEquiv.coe_coe,
    e'.coordChangeL_apply e ⟨hU' hz.2.1.2, hU hz.2.1.1⟩, e'.symm_apply_apply_mk (hU' hz.2.1.2)]

/-- The derivative of order `m` of the coefficients in the frame `e` and the chart at `x`, at the
points of `L`, is bounded by a multiple of the order-`m` seminorm on `K` of the coefficients in the
frame `e'` and the chart at `y`. -/
private theorem exists_norm_chartIteratedFDeriv_le (x : U) (y : U')
    (L : Compacts (extChartAt I x).target) (K : Compacts (extChartAt I y).target)
    (hL : ∀ z ∈ L, ((extChartAt I x).symm z : M) ∈ U' ∧
      ((extChartAt I x).symm z : M) ∈ (extChartAt I (y : M)).source ∧
      extChartAt I (y : M) ((extChartAt I x).symm z) ∈
        Subtype.val '' (K : Set (extChartAt I y).target))
    (m : ℕ) (hm : m ≤ n) :
    ∃ C : ℝ, ∀ s : Cₛ^n⟮I; F, V⟯, ∀ z ∈ L,
      ‖ContMDiffMap.chartIteratedFDeriv (e.frameCoordinates hU s) x m hm z‖ ≤
        C * e'.chartCkSeminorm hU' y K m hm s := by
  set φ := extChartAt I (x : M)
  set ψ := extChartAt I (y : M)
  set S := chartOverlap (I := I) U U' x y
  have hsymm (z : (extChartAt I x).target) : ((extChartAt I x).symm z : M) = φ.symm z :=
    U.coe_extChartAt_symm_apply x z.2
  have hLS : Subtype.val '' (L : Set (extChartAt I x).target) ⊆ S := by
    rintro _ ⟨z, hz, rfl⟩
    obtain ⟨h₁, h₂, -⟩ := hL z hz
    refine ⟨(Set.ext_iff.mp (U.extChartAt_target_eq (I := I) x) (z : E)).mp z.2 |>.1, ?_⟩
    rw [mem_preimage, ← hsymm z]
    exact ⟨⟨((extChartAt I x).symm z).2, h₁⟩, h₂⟩
  -- The transition of the frames read in the chart at `x`, and the change of coordinates.
  have hA : ContDiffOn 𝕜 m (fun z ↦ (e'.coordChangeL 𝕜 e (φ.symm z) : F →L[𝕜] F)) S :=
    (contMDiffOn_iff_contDiffOn.mp ((contMDiffOn_coordChangeL (IB := I) (n := n) e' e).comp
      ((contMDiffOn_extChartAt_symm (I := I) (n := n) (x : M)).mono inter_subset_left)
      fun z (hz : z ∈ S) ↦ ⟨hU' hz.2.1.2, hU hz.2.1.1⟩)).of_le hm
  have hτ : ContDiffOn 𝕜 m (ψ ∘ φ.symm) S :=
    ((I.contDiffOn_extendCoordChange (chart_mem_maximalAtlas (I := I) (n := n) (x : M))
      (chart_mem_maximalAtlas (y : M))).mono fun z (hz : z ∈ S) ↦ by
        rw [PartialEquiv.trans_source, PartialEquiv.symm_source]
        exact ⟨hz.1, hz.2.2⟩).of_le hm
  have hτT : MapsTo (ψ ∘ φ.symm) S (extChartAt I y).target := fun z (hz : z ∈ S) ↦ by
    rw [U'.extChartAt_target_eq y, mem_inter_iff, mem_preimage, Function.comp_apply,
      ψ.left_inv hz.2.2]
    exact ⟨ψ.map_source hz.2.2, hz.2.1.2⟩
  obtain ⟨C, hC⟩ := ContDiffOn.exists_norm_iteratedFDerivWithin_clm_apply_comp_le hA hτ
    (uniqueDiffOn_chartOverlap (U := U) (U' := U') (x : M) (y : M))
    (uniqueDiffOn_extChartAt_target y) hτT
    (L.isCompact.image continuous_subtype_val) hLS
  refine ⟨C, fun s z hz ↦ ?_⟩
  obtain ⟨h₁, h₂, -⟩ := hL z hz
  have hG := (ContMDiffMap.contDiffOn_comp_extend_symm (e'.frameCoordinates hU' s)
    (chart_mem_maximalAtlas (I := I) y)).of_le hm
  rw [ContMDiffMap.chartIteratedFDeriv_self_target_apply, ← iteratedFDerivWithin_inter'
    (chartOverlap_mem_nhdsWithin x y z.2 (hsymm z ▸ h₁) (hsymm z ▸ h₂)),
    inter_eq_right.mpr (chartOverlap_subset x y), iteratedFDerivWithin_congr
      (eqOn_frameCoordinates_comp_extChartAt_symm e e' hU hU' x y s) (hLS ⟨z, hz, rfl⟩)]
  -- The coefficients in `e'` are bounded on `K` through order `m` by their seminorm there.
  refine hC _ hG _ (fun i hi w hw ↦ ?_) z ⟨z, hz, rfl⟩
  obtain ⟨w, hwL, rfl⟩ := hw
  obtain ⟨-, -, w', hw'K, hw'⟩ := hL w hwL
  have h := (chartCkSeminorm_le_iff e' hU' y K m hm s (apply_nonneg _ _)).mp le_rfl i hi w' hw'K
  rw [ContMDiffMap.chartIteratedFDeriv_self_target_apply, hw', hsymm w] at h
  exact h

/-- **Change of frame and chart for compact chart seminorms of sections.** Let `L` be a compact
coordinate set in the chart of the frame domain `U` at `x`, whose points lie in the frame domain
`U'` and in the chart at `y`, with coordinates there in the compact set `K`. Then the compact chart
`C^k` seminorm of the coefficients of sections in the frame `e` on `L` is bounded by a multiple of
that of their coefficients in the frame `e'` on `K`. The constant does not depend on the
section. -/
theorem exists_chartCkSeminorm_le_chartCkSeminorm (x : U) (y : U')
    (L : Compacts (extChartAt I x).target) (K : Compacts (extChartAt I y).target)
    (hL : ∀ z ∈ L, ((extChartAt I x).symm z : M) ∈ U' ∧
      ((extChartAt I x).symm z : M) ∈ (extChartAt I (y : M)).source ∧
      extChartAt I (y : M) ((extChartAt I x).symm z) ∈
        Subtype.val '' (K : Set (extChartAt I y).target))
    (k : ℕ) (hk : k ≤ n) :
    ∃ C : ℝ, 0 < C ∧ ∀ s : Cₛ^n⟮I; F, V⟯,
      e.chartCkSeminorm hU x L k hk s ≤ C * e'.chartCkSeminorm hU' y K k hk s := by
  have hb (m : Fin (k + 1)) := exists_norm_chartIteratedFDeriv_le e e' hU hU' x y L K hL m
    ((Nat.cast_le.mpr (Nat.le_of_lt_succ m.isLt)).trans hk)
  choose C hC using hb
  refine ⟨∑ m, |C m| + 1, by positivity, fun s ↦ ?_⟩
  refine (chartCkSeminorm_le_iff e hU x L k hk s (by positivity)).mpr fun m hm z hz ↦ ?_
  let m' : Fin (k + 1) := ⟨m, by omega⟩
  calc _ ≤ C m' * e'.chartCkSeminorm hU' y K m ((Nat.cast_le.mpr hm).trans hk) s := hC m' s z hz
    _ ≤ |C m'| * e'.chartCkSeminorm hU' y K k hk s := by
        gcongr
        · exact le_abs_self _
        · exact chartCkSeminorm_le_of_le e' hU' y K hm hk s
    _ ≤ (∑ j, |C j| + 1) * e'.chartCkSeminorm hU' y K k hk s := by
        gcongr
        exact (Finset.single_le_sum (fun j _ ↦ abs_nonneg (C j)) (Finset.mem_univ m')).trans
          (le_add_of_nonneg_right zero_le_one)

end Bundle.Trivialization

namespace ContMDiffSection

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace 𝕜 F]
  {V : M → Type*} [∀ x, AddCommGroup (V x)] [∀ x, Module 𝕜 (V x)]
  [∀ x, TopologicalSpace (V x)] [TopologicalSpace (TotalSpace F V)]
  [FiberBundle F V] [VectorBundle 𝕜 F V]
  {n : ℕ∞ω} [ContMDiffVectorBundle n F V I] [IsManifold I n M]
  {ι : Type*} (e : ι → Trivialization F (π F V))
  [∀ i, MemTrivializationAtlas (e i)]
  (U : ι → Opens M) (hU : ∀ i, (U i : Set M) ⊆ (e i).baseSet)
  {J : Type*} [Fintype J] (r : J → ι) (c : ∀ j, U (r j))
  (K : ∀ j, Compacts (extChartAt I (c j)).target)

/-- The `C^k` seminorm of a finite frame atlas: finitely many frames `e (r j)`, with chart
centres `c j` in their frame domains and compact coordinate pieces `K j` in the charts at `c j`.
It is the largest coordinate derivative of order at most `k` of the frame coefficients on the
pieces. -/
def finiteFrameSeminorm (k : ℕ) (hk : k ≤ n) : Seminorm 𝕜 Cₛ^n⟮I; F, V⟯ :=
  Finset.univ.sup fun j ↦ (e (r j)).chartCkSeminorm (hU (r j)) (c j) (K j) k hk

/-- Each chart seminorm of a finite frame atlas is bounded by its finite frame-atlas seminorm. -/
theorem chartCkSeminorm_le_finiteFrameSeminorm (k : ℕ) (hk : k ≤ n) (j : J) :
    (e (r j)).chartCkSeminorm (hU (r j)) (c j) (K j) k hk ≤
      finiteFrameSeminorm e U hU r c K k hk :=
  Finset.le_sup (f := fun j ↦ (e (r j)).chartCkSeminorm (hU (r j)) (c j) (K j) k hk)
    (Finset.mem_univ j)

/-- A nonnegative bound on the finite frame-atlas seminorm is a bound on every coordinate
derivative of order at most `k` of the frame coefficients on every piece. -/
theorem finiteFrameSeminorm_le_iff (k : ℕ) (hk : k ≤ n) (s : Cₛ^n⟮I; F, V⟯) {ρ : ℝ}
    (hρ : 0 ≤ ρ) :
    finiteFrameSeminorm e U hU r c K k hk s ≤ ρ ↔
      ∀ j (m : ℕ) (hm : m ≤ k), ∀ z ∈ K j,
        ‖ContMDiffMap.chartIteratedFDeriv ((e (r j)).frameCoordinates (hU (r j)) s) (c j) m
          ((Nat.cast_le.mpr hm).trans hk) z‖ ≤ ρ := by
  constructor
  · intro h j
    exact ((e (r j)).chartCkSeminorm_le_iff (hU (r j)) (c j) (K j) k hk s hρ).mp
      ((chartCkSeminorm_le_finiteFrameSeminorm e U hU r c K k hk j s).trans h)
  · intro h
    exact Seminorm.finset_sup_apply_le hρ fun j _ ↦
      ((e (r j)).chartCkSeminorm_le_iff (hU (r j)) (c j) (K j) k hk s hρ).mpr (h j)

/-- The finite frame-atlas seminorm is continuous for the frame topology. -/
theorem continuous_finiteFrameSeminorm (k : ℕ) (hk : k ≤ n) :
    let _ := frameTopology (I := I) (n := n) e U hU
    Continuous (finiteFrameSeminorm e U hU r c K k hk) := by
  let _ := frameTopology (I := I) (n := n) e U hU
  let _ := (withSeminorms_frameSeminormFamily (I := I) (n := n) e U hU).isTopologicalAddGroup
  refine Seminorm.continuous_finsetSup fun j _ ↦ ?_
  refine ((ContMDiffMap.continuous_chartCkSeminorm (c j) (K j) k hk).comp
    (continuous_frameCoordinates e U hU (r j))).congr fun s ↦ ?_
  exact ((e (r j)).chartCkSeminorm_apply (hU (r j)) (c j) (K j) k hk s).symm

section Cover

variable {r c K}
variable (hK : ∀ y : M, ∃ j, ∃ hy : y ∈ U (r j),
  ∃ hy' : (⟨y, hy⟩ : U (r j)) ∈ (extChartAt I (c j)).source,
    (⟨extChartAt I (c j) ⟨y, hy⟩, (extChartAt I (c j)).map_source hy'⟩ :
      (extChartAt I (c j)).target) ∈ interior (K j : Set (extChartAt I (c j)).target))

include hK in
/-- If the relative interiors of the pieces of a finite frame atlas cover the manifold, every
compact chart `C^k` seminorm of sections, in any frame of the system, is bounded by a positive
multiple of the finite frame-atlas seminorm. -/
theorem exists_chartCkSeminorm_le_finiteFrameSeminorm (i : ι) (x : U i)
    (L : Compacts (extChartAt I x).target) (k : ℕ) (hk : k ≤ n) :
    ∃ C : ℝ, 0 < C ∧ ∀ s : Cₛ^n⟮I; F, V⟯,
      (e i).chartCkSeminorm (hU i) x L k hk s ≤ C * finiteFrameSeminorm e U hU r c K k hk s := by
  classical
  -- The points of `M` represented in the interior of the piece `K j`.
  let Ω (j : J) : Set M := Subtype.val '' {w : U (r j) | ∃ hw : w ∈ (extChartAt I (c j)).source,
    (⟨extChartAt I (c j) w, (extChartAt I (c j)).map_source hw⟩ : (extChartAt I (c j)).target) ∈
      interior (K j : Set (extChartAt I (c j)).target)}
  have hΩ (j : J) : IsOpen (Ω j) := (U (r j)).isOpen.isOpenMap_subtype_val _
    (TauCeti.isOpen_setOf_extChartAt_mem (c j) isOpen_interior)
  -- The coordinate points of the chart at `x` represented in the interior of `K j`.
  let W (j : J) : Set (extChartAt I x).target :=
    (fun z ↦ ((extChartAt I x).symm z : M)) ⁻¹' Ω j
  have hs : Continuous (fun z : (extChartAt I x).target ↦ ((extChartAt I x).symm z : M)) :=
    continuous_subtype_val.comp
      (continuousOn_iff_continuous_domRestrict.mp (continuousOn_extChartAt_symm x))
  have hcov : (L : Set (extChartAt I x).target) ⊆ ⋃ j ∈ Finset.univ, W j := fun z _ ↦ by
    obtain ⟨j, hy, hy', hyK⟩ := hK ((extChartAt I x).symm z : M)
    exact mem_biUnion (Finset.mem_univ j) ⟨⟨_, hy⟩, ⟨hy', hyK⟩, rfl⟩
  obtain ⟨P, hP, hPW, hLP⟩ :=
    L.isCompact.finite_compact_cover Finset.univ W (fun j _ ↦ (hΩ j).preimage hs) hcov
  have hb (j : J) : ∃ C : ℝ, 0 < C ∧ ∀ s : Cₛ^n⟮I; F, V⟯,
      (e i).chartCkSeminorm (hU i) x ⟨P j, hP j⟩ k hk s ≤
        C * (e (r j)).chartCkSeminorm (hU (r j)) (c j) (K j) k hk s := by
    refine (e i).exists_chartCkSeminorm_le_chartCkSeminorm (e (r j)) (hU i) (hU (r j)) x (c j)
      ⟨P j, hP j⟩ (K j) (fun z hz ↦ ?_) k hk
    obtain ⟨w, ⟨hw, hwK⟩, hwz⟩ := hPW j hz
    beta_reduce at hwz
    refine ⟨hwz ▸ w.2, ?_, ?_⟩
    · rw [← hwz]
      exact (Set.ext_iff.mp ((U (r j)).extChartAt_source_eq (I := I) (c j)) w).mp hw
    · rw [← hwz, ← (U (r j)).extChartAt_apply (c j) w]
      exact ⟨_, interior_subset hwK, rfl⟩
  choose C hC hbound using hb
  have hsum : 0 ≤ ∑ j, C j := Finset.sum_nonneg fun j _ ↦ (hC j).le
  refine ⟨1 + ∑ j, C j, by positivity, fun s ↦ ?_⟩
  rw [Trivialization.chartCkSeminorm_apply]
  refine ContMDiffMap.chartCkSeminorm_le_of_subset_biUnion (x : U i) L Finset.univ
    (fun j ↦ ⟨P j, hP j⟩) hLP.subset k hk (fun j _ ↦ (hC j).le) _
    (apply_nonneg (finiteFrameSeminorm e U hU r c K k hk) s) fun j _ ↦ ?_
  rw [← Trivialization.chartCkSeminorm_apply]
  exact (hbound j s).trans (mul_le_mul_of_nonneg_left
    (chartCkSeminorm_le_finiteFrameSeminorm e U hU r c K k hk j s) (hC j).le)

include hK in
/-- **Equivalence of finite frame-atlas norms.** The `C^k` seminorm of any finite frame atlas is
bounded by a positive multiple of that of a finite frame atlas whose interiors cover the
manifold. -/
theorem exists_finiteFrameSeminorm_le {J' : Type*} [Fintype J'] (r' : J' → ι)
    (c' : ∀ j, U (r' j)) (K' : ∀ j, Compacts (extChartAt I (c' j)).target) (k : ℕ) (hk : k ≤ n) :
    ∃ C : ℝ, 0 < C ∧ ∀ s : Cₛ^n⟮I; F, V⟯,
      finiteFrameSeminorm e U hU r' c' K' k hk s ≤ C * finiteFrameSeminorm e U hU r c K k hk s := by
  choose C hC hbound using fun j ↦
    exists_chartCkSeminorm_le_finiteFrameSeminorm e U hU hK (r' j) (c' j) (K' j) k hk
  have hsum : 0 ≤ ∑ j, C j := Finset.sum_nonneg fun j _ ↦ (hC j).le
  refine ⟨1 + ∑ j, C j, by positivity, fun s ↦ ?_⟩
  calc finiteFrameSeminorm e U hU r' c' K' k hk s
      ≤ ∑ j, (e (r' j)).chartCkSeminorm (hU (r' j)) (c' j) (K' j) k hk s := by
        refine (Seminorm.finset_sup_le_sum
          (fun j ↦ (e (r' j)).chartCkSeminorm (hU (r' j)) (c' j) (K' j) k hk) Finset.univ
          s).trans_eq ?_
        simp only [sum_apply]
    _ ≤ ∑ j, C j * finiteFrameSeminorm e U hU r c K k hk s :=
        Finset.sum_le_sum fun j _ ↦ hbound j s
    _ = (∑ j, C j) * finiteFrameSeminorm e U hU r c K k hk s := (Finset.sum_mul _ _ _).symm
    _ ≤ (1 + ∑ j, C j) * finiteFrameSeminorm e U hU r c K k hk s :=
        mul_le_mul_of_nonneg_right (le_add_of_nonneg_left zero_le_one) (apply_nonneg _ _)

end Cover

/-- **The finite frame-atlas seminorm is a norm**: it vanishes only on the zero section when the
pieces cover the manifold, since its derivatives of order zero are the frame coefficients. -/
theorem finiteFrameSeminorm_eq_zero_iff
    (hK : ∀ y : M, ∃ j, ∃ hy : y ∈ U (r j),
      ∃ hy' : (⟨y, hy⟩ : U (r j)) ∈ (extChartAt I (c j)).source,
        (⟨extChartAt I (c j) ⟨y, hy⟩, (extChartAt I (c j)).map_source hy'⟩ :
          (extChartAt I (c j)).target) ∈ K j)
    (k : ℕ) (hk : k ≤ n) (s : Cₛ^n⟮I; F, V⟯) :
    finiteFrameSeminorm e U hU r c K k hk s = 0 ↔ s = 0 := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ map_zero _⟩
  ext y
  obtain ⟨j, hy, hy', hyK⟩ := hK y
  have h₀ : (e (r j)).chartDerivativeSeminorm (hU (r j)) (c j) (K j) 0 (by simp) s = 0 := by
    refine le_antisymm (((e (r j)).chartDerivativeSeminorm_le_iff (hU (r j)) (c j) (K j) 0
      (by simp) s le_rfl).mpr fun z hz ↦ ?_) (apply_nonneg _ _)
    exact ((finiteFrameSeminorm_le_iff e U hU r c K k hk s le_rfl).mp h.le j 0 (Nat.zero_le k)
      z hz)
  have hv := ((e (r j)).chartDerivativeSeminorm_zero_eq_zero_iff (hU (r j)) (c j) (K j) s).mp h₀ _
    hyK
  rwa [(extChartAt I (c j)).left_inv hy'] at hv

section Topology

variable (k : ℕ) [ContMDiffVectorBundle k F V I] [IsManifold I k M]

/-- **The finite frame-atlas norm generates the frame topology** on `C^k` sections, when the
relative interiors of its pieces cover the manifold. -/
theorem withSeminorms_finiteFrameSeminorm
    (hK : ∀ y : M, ∃ j, ∃ hy : y ∈ U (r j),
      ∃ hy' : (⟨y, hy⟩ : U (r j)) ∈ (extChartAt I (c j)).source,
        (⟨extChartAt I (c j) ⟨y, hy⟩, (extChartAt I (c j)).map_source hy'⟩ :
          (extChartAt I (c j)).target) ∈ interior (K j : Set (extChartAt I (c j)).target)) :
    let _ := frameTopology (I := I) (n := k) e U hU
    WithSeminorms fun _ : Unit ↦ finiteFrameSeminorm (n := k) e U hU r c K k le_rfl := by
  let _ := frameTopology (I := I) (n := k) e U hU
  have hp := withSeminorms_frameSeminormFamily (I := I) (n := k) e U hU
  let _ := hp.isTopologicalAddGroup
  refine hp.congr ?_ (Seminorm.IsBounded.of_real ?_)
  · intro _
    obtain ⟨t, C, -, hbound⟩ := Seminorm.bound_of_continuous hp _
      (continuous_finiteFrameSeminorm (n := k) e U hU r c K k le_rfl)
    exact ⟨t, C, by simpa only [Seminorm.comp_id] using hbound⟩
  · rintro ⟨i, x, ⟨m, hm⟩, L⟩
    have hmk : m ≤ k := by exact_mod_cast hm
    obtain ⟨C, -, hbound⟩ :=
      exists_chartCkSeminorm_le_finiteFrameSeminorm (n := k) e U hU hK i x L k le_rfl
    refine ⟨{()}, C, fun s ↦ ?_⟩
    simpa only [LinearMap.id_apply, frameSeminormFamily_apply, Finset.sup_singleton] using
      ((e i).chartDerivativeSeminorm_le_chartCkSeminorm (hU i) x L hm le_rfl hmk s).trans
        (hbound s)

/-- **Normability of `C^k` sections on a compact manifold.** For a covering system of smooth frames
of a vector bundle over a compact manifold modelled on a locally compact space, the frame topology
on `C^k` sections is generated by a single seminorm, the `C^k` seminorm of a finite frame atlas. -/
theorem isNormableSpace_frameTopology [CompactSpace M] [LocallyCompactSpace H]
    (hcover : ∀ y : M, ∃ i, y ∈ U i) :
    let _ := frameTopology (I := I) (n := k) e U hU
    IsNormableSpace 𝕜 Cₛ^k⟮I; F, V⟯ := by
  let _ := frameTopology (I := I) (n := k) e U hU
  obtain ⟨t, r, c, K, hK⟩ := TauCeti.exists_finite_subordinate_compact_chart_cover (I := I) U hcover
  exact ⟨⟨_, withSeminorms_finiteFrameSeminorm e U hU r c K k hK⟩⟩

end Topology

end ContMDiffSection
