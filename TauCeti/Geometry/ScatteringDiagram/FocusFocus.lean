/-!
# The focus-focus model algebra and its theta multiplication law

At finite order `k : ℕ` over a commutative ring `K`, the local slab algebra attached to a
focus-focus affine singularity with wall function `1 + w` is modeled by the quotient

`ModelAlgebra K k = K[t, w, w⁻¹, x, y] / (w w⁻¹ - 1, t ^ (k + 1), x y - t (1 + w))`.

Setting `BaseRing K k = K[t] / (t ^ (k + 1))` (represented via `AdjoinRoot (X ^ (k + 1))`) and
`slabParam K k = t (1 + w)` inside the Laurent polynomial ring `(BaseRing K k)[T;T⁻¹]`, we
construct the `K`-algebra isomorphism

`modelSlabEquiv K k : ModelAlgebra K k ≃ₐ[K] NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)`.

Under `modelSlabEquiv K k`, the focus-focus theta elements `modelTheta K k n b` (`x^{-n} w^b` for
`n < 0`, `w^b` for `n = 0`, and `y^n w^b` for `n > 0`) correspond to the normal-form slab elements
`NodeAlgebra.Z (slabParam K k) n * algebraMap (BaseRing K k)[T;T⁻¹] _ (T b)`. Combining
`NodeAlgebra.Z_mul` with the binomial expansion of `(1 + w)^r` yields:

* freeness of `ModelAlgebra K k` over `K` (`FocusFocus.instModuleFree`) and, over any nontrivial
  ring `K`, the explicit `K`-basis `t^i ϑ_{n,b}` (`FocusFocus.modelBasis`) and nonvanishing of
  every `modelTheta K k n b`;
* the focus-focus theta multiplication formula (`FocusFocus.modelTheta_mul`): for
  `r = (|n| + |m| - |n + m|) / 2`,
  `ϑ_{n,b} * ϑ_{m,c} = t^r * ∑_{j = 0}^r binom(r, j) ϑ_{n + m, b + c + j}`;
* positivity of structure constants as evaluations of monomials in `ℕ[X]` at `t`
  (`FocusFocus.modelTheta_mul_eval₂_nat`), functoriality along ring homomorphisms `K →+* K'`
  (`FocusFocus.mapRingHom`), and compatibility with order truncation `k' ≤ k`
  (`FocusFocus.truncAlgHom`).

## Main definitions and results

* `TauCeti.FocusFocus.Coordinate`, `TauCeti.FocusFocus.Ambient`, `TauCeti.FocusFocus.modelIdeal`,
  `TauCeti.FocusFocus.modelIdeal_le_iff`, `TauCeti.FocusFocus.ModelAlgebra`,
  `TauCeti.FocusFocus.coordinate`: ambient polynomial ring and order-`k` focus-focus model algebra.
* `TauCeti.FocusFocus.modelW`, `TauCeti.FocusFocus.map_modelW_zpow`,
  `TauCeti.FocusFocus.modelTheta`: the tangential unit `w`, unit-power transport, and theta
  elements `ϑ_{n,b}`.
* `TauCeti.FocusFocus.slabParam`, `TauCeti.FocusFocus.modelSlabEquiv`: `K`-algebra isomorphism
  with `NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)`.
* `TauCeti.FocusFocus.modelBasis`, `TauCeti.FocusFocus.instModuleFree`: `K`-basis `t^i ϑ_{n,b}` and
  freeness over `K`.
* `TauCeti.FocusFocus.modelTheta_mul`, `TauCeti.FocusFocus.rightChamberMap_binomial`: the
  focus-focus theta product formula and the binomial right-chamber expansion for `q = t (1 + w)`.
* `TauCeti.FocusFocus.mapRingHom`, `TauCeti.FocusFocus.truncAlgHom`: base-change and truncation
  homomorphisms preserving `modelTheta`.

## References

* M. Gross and B. Siebert, *An Invitation to Toric Degenerations*, §§2.2–2.3, arXiv:0808.2749v2.
* M. Gross, P. Hacking, and B. Siebert, *Theta functions on varieties with effective
  anti-canonical class*, Definition 3.3, Proposition 3.5, and Lemma 3.7, arXiv:1601.07081v4.
-/

public section

namespace TauCeti

namespace FocusFocus

noncomputable section

/-- Coordinates for `K[t, w, w⁻¹, x, y]`, with the inverse relation imposed in the quotient. -/
inductive Coordinate where
  | t | w | wInv | x | y
  deriving DecidableEq

open Coordinate
open LaurentPolynomial
  (C T T_pow T_add T_zero C_eq_algebraMap single_eq_C_mul_T eval₂ eval₂_C eval₂_T)
open scoped LaurentPolynomial

variable (K : Type*) [CommRing K]

/-- The polynomial ring `K[t, w, w⁻¹, x, y]` before imposing the focus-focus slab relations. -/
abbrev Ambient := MvPolynomial Coordinate K

/-- The focus-focus model ideal generated by `w w⁻¹ - 1`, `t ^ (k + 1)`, and `x y - t (1 + w)`. -/
def modelIdeal (k : ℕ) : Ideal (Ambient K) :=
  Ideal.span {MvPolynomial.X w * MvPolynomial.X wInv - 1,
    MvPolynomial.X t ^ (k + 1),
    MvPolynomial.X x * MvPolynomial.X y - MvPolynomial.X t * (1 + MvPolynomial.X w)}

theorem w_mul_wInv_sub_one_mem_modelIdeal (k : ℕ) :
    MvPolynomial.X w * MvPolynomial.X wInv - 1 ∈ modelIdeal K k :=
  Ideal.subset_span (Set.mem_insert _ _)

theorem t_pow_succ_mem_modelIdeal (k : ℕ) :
    MvPolynomial.X t ^ (k + 1) ∈ modelIdeal K k :=
  Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))

theorem x_mul_y_sub_mem_modelIdeal (k : ℕ) :
    MvPolynomial.X x * MvPolynomial.X y - MvPolynomial.X t * (1 + MvPolynomial.X w) ∈
      modelIdeal K k :=
  Ideal.subset_span
    (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

/-- An ideal of `Ambient K` contains `modelIdeal K k` if and only if it contains the three defining
relations `w w⁻¹ - 1`, `t ^ (k + 1)`, and `x y - t (1 + w)`. -/
theorem modelIdeal_le_iff (k : ℕ) {I : Ideal (Ambient K)} :
    modelIdeal K k ≤ I ↔
      MvPolynomial.X w * MvPolynomial.X wInv - 1 ∈ I ∧
        MvPolynomial.X t ^ (k + 1) ∈ I ∧
        MvPolynomial.X x * MvPolynomial.X y - MvPolynomial.X t * (1 + MvPolynomial.X w) ∈ I := by
  rw [modelIdeal, Ideal.span_le]
  simp [Set.insert_subset_iff]

/-- The focus-focus model algebra `K[t, w^{±1}, x, y] / (t^{k + 1}, x y - t (1 + w))` at
order `k`. -/
abbrev ModelAlgebra (k : ℕ) := Ambient K ⧸ modelIdeal K k

/-- The residue class of an ambient coordinate in a quotient of `Ambient K`. -/
def coordinate (I : Ideal (Ambient K)) (c : Coordinate) : Ambient K ⧸ I :=
  Ideal.Quotient.mk I (MvPolynomial.X c)

/-- The tangential coordinate `w` as a unit of `ModelAlgebra K k`, with inverse `w⁻¹`. -/
def modelW (k : ℕ) : (ModelAlgebra K k)ˣ :=
  Units.mkOfMulEqOne (coordinate K (modelIdeal K k) w) (coordinate K (modelIdeal K k) wInv) <| by
    rw [coordinate, coordinate, ← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq]
    exact w_mul_wInv_sub_one_mem_modelIdeal K k

@[simp] theorem val_modelW (k : ℕ) :
    ((modelW K k : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) =
      coordinate K (modelIdeal K k) w := (rfl)

@[simp] theorem val_inv_modelW (k : ℕ) :
    (((modelW K k)⁻¹ : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) =
      coordinate K (modelIdeal K k) wInv := (rfl)

/-- A monoid homomorphism sending `w` to a unit `u` sends `modelW K k ^ b` to `u ^ b`. -/
theorem map_modelW_zpow {M F : Type*} [Monoid M] (k : ℕ)
    [FunLike F (ModelAlgebra K k) M] [MonoidHomClass F (ModelAlgebra K k) M]
    (f : F) (u : Mˣ) (hu : f (coordinate K (modelIdeal K k) w) = u) (b : ℤ) :
    f ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) = ((u ^ b : Mˣ) : M) := by
  have hmap : Units.map (f : ModelAlgebra K k →* M) (modelW K k) = u := Units.ext hu
  rw [← hmap, ← map_zpow, Units.coe_map, MonoidHom.coe_ofClass]

theorem coordinate_t_pow_succ_eq_zero (k : ℕ) :
    coordinate K (modelIdeal K k) t ^ (k + 1) = 0 := by
  rw [coordinate, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact t_pow_succ_mem_modelIdeal K k

theorem coordinate_x_mul_y (k : ℕ) :
    coordinate K (modelIdeal K k) x * coordinate K (modelIdeal K k) y =
      coordinate K (modelIdeal K k) t * (1 + coordinate K (modelIdeal K k) w) := by
  rw [coordinate, coordinate, coordinate, coordinate, ← map_mul, ← map_one (Ideal.Quotient.mk _),
    ← map_add, ← map_mul, Ideal.Quotient.eq]
  exact x_mul_y_sub_mem_modelIdeal K k

/-- The model theta element `ϑ_{n,b}` in `ModelAlgebra K k`, equal to `x^{-n} w^b` for `n < 0`,
`w^b` for `n = 0`, and `y^n w^b` for `n > 0`. -/
def modelTheta (k : ℕ) (n b : ℤ) : ModelAlgebra K k :=
  (if n < 0 then coordinate K (modelIdeal K k) x ^ n.natAbs
    else coordinate K (modelIdeal K k) y ^ n.natAbs) *
    ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)

theorem modelTheta_def (k : ℕ) (n b : ℤ) :
    modelTheta K k n b =
      (if n < 0 then coordinate K (modelIdeal K k) x ^ n.natAbs
        else coordinate K (modelIdeal K k) y ^ n.natAbs) *
        ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := (rfl)

theorem modelTheta_of_neg (k : ℕ) {n : ℤ} (hn : n < 0) (b : ℤ) :
    modelTheta K k n b =
      coordinate K (modelIdeal K k) x ^ n.natAbs *
        ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := by
  simp [modelTheta_def, hn]

theorem modelTheta_of_nonneg (k : ℕ) {n : ℤ} (hn : 0 ≤ n) (b : ℤ) :
    modelTheta K k n b =
      coordinate K (modelIdeal K k) y ^ n.natAbs *
        ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := by
  simp [modelTheta_def, not_lt.mpr hn]

@[simp] theorem modelTheta_zero_left (k : ℕ) (b : ℤ) :
    modelTheta K k 0 b = ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := by
  simp [modelTheta_def]

theorem modelTheta_zero (k : ℕ) : modelTheta K k 0 0 = 1 := by simp

@[simp] theorem modelTheta_natCast (k : ℕ) (a : ℕ) (b : ℤ) :
    modelTheta K k (a : ℤ) b =
      coordinate K (modelIdeal K k) y ^ a *
        ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := by
  rw [modelTheta_of_nonneg K k (Int.natCast_nonneg a), Int.natAbs_natCast]

@[simp] theorem modelTheta_neg_natCast (k : ℕ) (a : ℕ) (b : ℤ) :
    modelTheta K k (-(a : ℤ)) b =
      coordinate K (modelIdeal K k) x ^ a *
        ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := by
  rcases eq_or_ne a 0 with rfl | ha <;>
    [simp; rw [modelTheta_of_neg K k (by omega), Int.natAbs_neg, Int.natAbs_natCast]]

/-! ### Identification with `NodeAlgebra` over `(K[t] / (t^{k + 1}))[w, w⁻¹]` -/

/-- The truncated polynomial base ring `K[t] / (t ^ (k + 1))` at order `k`. -/
abbrev BaseRing (k : ℕ) := AdjoinRoot (Polynomial.X ^ (k + 1) : Polynomial K)

/-- The focus-focus slab parameter `t (1 + w)` in `(BaseRing K k)[T;T⁻¹]`. -/
def slabParam (k : ℕ) : (BaseRing K k)[T;T⁻¹] :=
  C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)) * (1 + T 1)

/-- Unfold the focus-focus slab parameter `slabParam K k = t (1 + w)`. -/
theorem slabParam_def (k : ℕ) :
    slabParam K k =
      C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)) * (1 + T 1) := (rfl)

private abbrev TargetSlab (k : ℕ) := NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)

private def coordToSlab (k : ℕ) : Coordinate → TargetSlab K k
  | t => algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k)
      (C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)))
  | w => algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T 1)
  | wInv => algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T (-1))
  | x => NodeAlgebra.coord (slabParam K k) 0
  | y => NodeAlgebra.coord (slabParam K k) 1

private def modelToSlab (k : ℕ) : ModelAlgebra K k →ₐ[K] TargetSlab K k :=
  Ideal.Quotient.liftₐ (modelIdeal K k) (MvPolynomial.aeval (coordToSlab K k)) (by
    have hle : modelIdeal K k ≤
        RingHom.ker (MvPolynomial.aeval (coordToSlab K k)).toRingHom := by
      rw [modelIdeal_le_iff]; refine ⟨?_, ?_, ?_⟩
      · simp only [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_sub, map_mul,
          map_one, MvPolynomial.aeval_X, coordToSlab]
        rw [← map_mul, ← T_add]; simp
      · have hroot : AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K) ^ (k + 1) = 0 := by
          simpa using AdjoinRoot.eval₂_root (Polynomial.X ^ (k + 1) : Polynomial K)
        simp only [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_pow,
          MvPolynomial.aeval_X, coordToSlab]
        rw [← map_pow, ← map_pow, hroot, map_zero, map_zero]
      · simp only [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_sub, map_mul,
          map_add, map_one, MvPolynomial.aeval_X, coordToSlab,
          NodeAlgebra.coord_zero_mul_coord_one, slabParam_def, sub_self]
    exact fun _ ha => hle ha)

@[simp] private theorem modelToSlab_coordinate (k : ℕ) (c : Coordinate) :
    modelToSlab K k (coordinate K (modelIdeal K k) c) = coordToSlab K k c :=
  MvPolynomial.aeval_X (coordToSlab K k) c

private def baseToModel (k : ℕ) : BaseRing K k →ₐ[K] ModelAlgebra K k :=
  AdjoinRoot.liftAlgHom (Polynomial.X ^ (k + 1) : Polynomial K)
    (Algebra.ofId K (ModelAlgebra K k)) (coordinate K (modelIdeal K k) t)
    (by simp [coordinate_t_pow_succ_eq_zero])

private def slabToModel (k : ℕ) : TargetSlab K k →ₐ[K] ModelAlgebra K k :=
  { NodeAlgebra.liftRingHom (eval₂ (baseToModel K k).toRingHom (modelW K k))
      (coordinate K (modelIdeal K k) x) (coordinate K (modelIdeal K k) y)
      (by
        simp only [slabParam_def, map_mul, map_add, map_one, eval₂_C, eval₂_T,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, baseToModel, AdjoinRoot.liftAlgHom_root,
          zpow_one, val_modelW]
        exact coordinate_x_mul_y K k) with
    commutes' r := by
      rw [RingHom.toFun_eq_coe, IsScalarTower.algebraMap_apply K (BaseRing K k)[T;T⁻¹],
        NodeAlgebra.liftRingHom_algebraMap, IsScalarTower.algebraMap_apply K (BaseRing K k),
        ← C_eq_algebraMap, eval₂_C, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      exact (baseToModel K k).commutes r }

private theorem modelToSlab_baseToModel (k : ℕ) (a : BaseRing K k) :
    modelToSlab K k (baseToModel K k a) =
      algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (C a) :=
  AlgHom.congr_fun (AdjoinRoot.algHom_ext
    (g₁ := (modelToSlab K k).comp (baseToModel K k))
    (g₂ := (IsScalarTower.toAlgHom K (BaseRing K k)[T;T⁻¹] (TargetSlab K k)).comp
      (IsScalarTower.toAlgHom K (BaseRing K k) (BaseRing K k)[T;T⁻¹])) (by
    simp only [AlgHom.comp_apply, IsScalarTower.coe_toAlgHom', baseToModel,
      AdjoinRoot.liftAlgHom_root, modelToSlab_coordinate, coordToSlab, C_eq_algebraMap])) a

private theorem modelToSlab_modelW_zpow (k : ℕ) (n : ℤ) :
    modelToSlab K k (((modelW K k ^ n : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)) =
      algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T n) := by
  let u : (TargetSlab K k)ˣ :=
    Units.map (algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k)).toMonoidHom
      (LaurentPolynomial.genericUnit (BaseRing K k))
  have hmap : modelToSlab K k (((modelW K k ^ n : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)) =
      ((u ^ n : (TargetSlab K k)ˣ) : TargetSlab K k) :=
    map_modelW_zpow K k (modelToSlab K k) u (by simp [u, coordToSlab]) n
  rw [hmap, ← map_zpow, Units.coe_map, LaurentPolynomial.genericUnit_zpow_val]; rfl

/-- Canonical `K`-algebra isomorphism between `ModelAlgebra K k` and the nodal slab algebra
`NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)` over `BaseRing K k = K[t] / (t ^ (k + 1))`. -/
def modelSlabEquiv (k : ℕ) :
    ModelAlgebra K k ≃ₐ[K] NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k) :=
  AlgEquiv.ofAlgHom (modelToSlab K k) (slabToModel K k)
    (NodeAlgebra.algHom_ext_of_algebra
      (fun p => by
        simp only [AlgHom.comp_apply, AlgHom.id_apply, slabToModel, AlgHom.coe_mk,
          NodeAlgebra.liftRingHom_algebraMap]
        induction p using AddMonoidAlgebra.induction_linear with
        | zero => simp
        | add f g hf hg => rw [map_add, map_add, hf, hg, map_add]
        | single n a =>
          rw [single_eq_C_mul_T, map_mul, map_mul, eval₂_C, eval₂_T, AlgHom.toRingHom_eq_coe,
            RingHom.coe_coe, modelToSlab_baseToModel, modelToSlab_modelW_zpow, ← map_mul])
      (by simp [slabToModel, coordToSlab])
      (by simp [slabToModel, coordToSlab]))
    (Ideal.Quotient.algHom_ext _ <| MvPolynomial.algHom_ext fun c => by
      rw [AlgHom.comp_apply, AlgHom.comp_apply, AlgHom.comp_apply, AlgHom.id_apply,
        Ideal.Quotient.mkₐ_eq_mk, ← coordinate]
      cases c <;> simp [slabToModel, coordToSlab, baseToModel])

@[simp] theorem modelSlabEquiv_coordinate_t (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) t) =
      algebraMap (BaseRing K k)[T;T⁻¹] (NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
        (C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K))) := by
  simp [modelSlabEquiv, coordToSlab]

@[simp] theorem modelSlabEquiv_coordinate_w (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) w) =
      algebraMap (BaseRing K k)[T;T⁻¹] (NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
        (T 1) := by simp [modelSlabEquiv, coordToSlab]

@[simp] theorem modelSlabEquiv_coordinate_wInv (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) wInv) =
      algebraMap (BaseRing K k)[T;T⁻¹] (NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
        (T (-1)) := by simp [modelSlabEquiv, coordToSlab]

@[simp] theorem modelSlabEquiv_coordinate_x (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) x) =
      NodeAlgebra.coord (slabParam K k) 0 := by
  simp [modelSlabEquiv, coordToSlab]

@[simp] theorem modelSlabEquiv_coordinate_y (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) y) =
      NodeAlgebra.coord (slabParam K k) 1 := by
  simp [modelSlabEquiv, coordToSlab]

@[simp] theorem modelSlabEquiv_modelW_zpow (k : ℕ) (b : ℤ) :
    modelSlabEquiv K k (((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)) =
      algebraMap (BaseRing K k)[T;T⁻¹] (NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
        (T b) := modelToSlab_modelW_zpow K k b

/-- Image of `modelTheta K k n b` under `modelSlabEquiv K k`: it equals the slab basis element
`NodeAlgebra.Z (slabParam K k) n` multiplied by the tangential Laurent monomial `T b`. -/
@[simp] theorem modelSlabEquiv_modelTheta (k : ℕ) (n b : ℤ) :
    modelSlabEquiv K k (modelTheta K k n b) =
      NodeAlgebra.Z (slabParam K k) n *
        algebraMap (BaseRing K k)[T;T⁻¹] (NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
          (T b) := by
  rw [modelTheta_def, map_mul, modelSlabEquiv_modelW_zpow]
  split_ifs with hn
  · simp [NodeAlgebra.Z_of_lt_zero (slabParam K k) hn]
  · simp [NodeAlgebra.Z_of_nonneg (slabParam K k) (not_lt.mp hn)]

@[simp] theorem modelSlabEquiv_symm_Z_mul_T (k : ℕ) (n b : ℤ) :
    (modelSlabEquiv K k).symm
      (NodeAlgebra.Z (slabParam K k) n *
        algebraMap (BaseRing K k)[T;T⁻¹] (NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
          (T b)) = modelTheta K k n b := by
  rw [← modelSlabEquiv_modelTheta, AlgEquiv.symm_apply_apply]

/-! ### Module freeness and the `K`-basis `t^i ϑ_{n,b}` -/

/-- `ModelAlgebra K k` is a free `K`-module for every commutative ring `K` and order `k`. -/
instance instModuleFree (k : ℕ) : Module.Free K (ModelAlgebra K k) :=
  Module.Free.of_basis <|
    (((AdjoinRoot.powerBasis' (Polynomial.monic_X_pow (k + 1) :
      (Polynomial.X ^ (k + 1) : Polynomial K).Monic)).basis.smulTower
        (AddMonoidAlgebra.basis ℤ (BaseRing K k))).smulTower
      (NodeAlgebra.slabBasis (slabParam K k))).map (modelSlabEquiv K k).symm.toLinearEquiv

/-- Over any nontrivial commutative ring `K`, the monomials `t^i * ϑ_{n,b}`
(`i : Fin (k + 1)`, `n b : ℤ`) form a `K`-basis of `ModelAlgebra K k`. -/
def modelBasis [Nontrivial K] (k : ℕ) :
    Module.Basis (Fin (k + 1) × ℤ × ℤ) K (ModelAlgebra K k) := by
  let pb := AdjoinRoot.powerBasis'
    (Polynomial.monic_X_pow (k + 1) : (Polynomial.X ^ (k + 1) : Polynomial K).Monic)
  let bBase : Module.Basis (Fin (k + 1)) K (BaseRing K k) :=
    pb.basis.reindex (finCongr (by simp [pb]))
  let bTheta : Module.Basis (ℤ × ℤ) (BaseRing K k)
      (NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)) :=
    (AddMonoidAlgebra.basis ℤ (BaseRing K k)).smulTower' (NodeAlgebra.slabBasis (slabParam K k))
  exact (bBase.smulTower bTheta).map (modelSlabEquiv K k).symm.toLinearEquiv

@[simp] theorem modelBasis_apply [Nontrivial K] (k : ℕ) (i : Fin (k + 1)) (n b : ℤ) :
    modelBasis K k (i, n, b) =
      coordinate K (modelIdeal K k) t ^ (i : ℕ) * modelTheta K k n b := by
  apply (modelSlabEquiv K k).injective
  simp only [modelBasis, Module.Basis.map_apply, AlgEquiv.toLinearEquiv_apply,
    AlgEquiv.apply_symm_apply, Module.Basis.smulTower_apply, Module.Basis.smulTower'_apply,
    Module.Basis.reindex_apply, finCongr_symm, finCongr_apply, Fin.val_cast,
    PowerBasis.coe_basis, AdjoinRoot.powerBasis'_gen, AddMonoidAlgebra.basis_apply,
    NodeAlgebra.slabBasis_apply, map_mul, map_pow, modelSlabEquiv_coordinate_t,
    modelSlabEquiv_modelTheta]
  have hT : (AddMonoidAlgebra.single b (1 : BaseRing K k) : (BaseRing K k)[T;T⁻¹]) = T b := by
    rw [single_eq_C_mul_T, map_one, one_mul]
  have hsmul₁ : (T b : (BaseRing K k)[T;T⁻¹]) • NodeAlgebra.Z (slabParam K k) n =
      algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T b) *
        NodeAlgebra.Z (slabParam K k) n :=
    Algebra.smul_def (T b : (BaseRing K k)[T;T⁻¹]) (NodeAlgebra.Z (slabParam K k) n)
  have hsmul₂ (r : BaseRing K k) (z : TargetSlab K k) :
      r • z = algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (C r) * z := by
    rw [← IsScalarTower.algebraMap_smul (BaseRing K k)[T;T⁻¹] r z,
      Algebra.smul_def (algebraMap (BaseRing K k) (BaseRing K k)[T;T⁻¹] r) z, ← C_eq_algebraMap]
  rw [hT, hsmul₁, hsmul₂, map_pow, map_pow]; ring

/-- Over a nontrivial commutative ring `K`, every theta basis element `modelTheta K k n b` is
nonzero in `ModelAlgebra K k`. -/
theorem modelTheta_ne_zero [Nontrivial K] (k : ℕ) (n b : ℤ) :
    modelTheta K k n b ≠ 0 := by
  have h0 : modelBasis K k (0, n, b) = modelTheta K k n b := by simp [modelBasis_apply]
  rw [← h0]; exact (modelBasis K k).ne_zero (0, n, b)

/-! ### The focus-focus theta multiplication formula -/

/-- **Focus-focus theta multiplication formula**: for `r = (|n| + |m| - |n + m|) / 2`,
`ϑ_{n,b} * ϑ_{m,c} = t^r * ∑_{j = 0}^r binom(r, j) ϑ_{n + m, b + c + j}` in `ModelAlgebra K k`. -/
theorem modelTheta_mul (k : ℕ) (n m b c : ℤ) :
    let r := (n.natAbs + m.natAbs - (n + m).natAbs) / 2
    modelTheta K k n b * modelTheta K k m c =
      coordinate K (modelIdeal K k) t ^ r *
        ∑ j ∈ Finset.range (r + 1), (r.choose j : ModelAlgebra K k) *
          modelTheta K k (n + m) (b + c + j) := by
  intro r; apply (modelSlabEquiv K k).injective
  let A := TargetSlab K k
  have hparam : slabParam K k ^ r * (T b * T c) =
      C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)) ^ r *
        ∑ j ∈ Finset.range (r + 1), (r.choose j : (BaseRing K k)[T;T⁻¹]) * T (b + c + j) := by
    rw [slabParam_def, mul_pow, ← T_add, mul_assoc, LaurentPolynomial.one_add_T_pow_mul_T]
    simp_rw [mul_one]
  calc modelSlabEquiv K k (modelTheta K k n b * modelTheta K k m c)
      = (NodeAlgebra.Z (slabParam K k) n * NodeAlgebra.Z (slabParam K k) m) *
          algebraMap (BaseRing K k)[T;T⁻¹] A (T b * T c) := by
        rw [map_mul, modelSlabEquiv_modelTheta, modelSlabEquiv_modelTheta, map_mul]; ring
    _ = algebraMap (BaseRing K k)[T;T⁻¹] A (slabParam K k ^ r * (T b * T c)) *
          NodeAlgebra.Z (slabParam K k) (n + m) := by
        simp only [NodeAlgebra.Z_mul, map_mul]; ring
    _ = modelSlabEquiv K k (coordinate K (modelIdeal K k) t ^ r *
          ∑ j ∈ Finset.range (r + 1), (r.choose j : ModelAlgebra K k) *
            modelTheta K k (n + m) (b + c + j)) := by
        rw [hparam]
        simp only [map_mul, map_pow, map_sum, map_natCast, modelSlabEquiv_coordinate_t,
          modelSlabEquiv_modelTheta, Finset.mul_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl fun j _ => ?_; ring

/-- Positivity of the focus-focus theta structure constants: every coefficient in
`modelTheta_mul` is the evaluation at `t` of
`Polynomial.monomial r (r.choose j) : Polynomial ℕ`. -/
theorem modelTheta_mul_eval₂_nat (k : ℕ) (n m b c : ℤ) :
    let r := (n.natAbs + m.natAbs - (n + m).natAbs) / 2
    modelTheta K k n b * modelTheta K k m c =
      ∑ j ∈ Finset.range (r + 1),
        Polynomial.eval₂ (Nat.castRingHom (ModelAlgebra K k))
          (coordinate K (modelIdeal K k) t) (Polynomial.monomial r (r.choose j)) *
          modelTheta K k (n + m) (b + c + j) := by
  intro r; rw [modelTheta_mul K k n m b c, Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  simp only [Polynomial.eval₂_monomial, eq_natCast]; ring

/-- Opposite-ray product check: `ϑ_{-1, 0} * ϑ_{1, 0} = t * ϑ_{0, 0} + t * ϑ_{0, 1}`
(for instance over `K = ℤ` at order `k = 2`). -/
theorem modelTheta_neg_one_mul_one (k : ℕ) :
    modelTheta K k (-1) 0 * modelTheta K k 1 0 =
      coordinate K (modelIdeal K k) t * modelTheta K k 0 0 +
        coordinate K (modelIdeal K k) t * modelTheta K k 0 1 := by
  rw [modelTheta_mul K k (-1) 1 0 0]; simp [Finset.sum_range_succ, mul_add]

/-! ### Binomial wall-crossing expansion for `q = t (1 + w)` -/

/-- In the nodal slab algebra `S[w, w⁻¹][x, y] / (x y - t (1 + w))` (with `w = T 1` in
`S[T;T⁻¹]` and `y = T 1` in `(S[T;T⁻¹])[T;T⁻¹]`), the incoming left monomial `x^a w^b` maps in
the right chamber to `t^a y^{-a} ∑_{j=0}^a binom(a, j) w^{b + j}`. -/
theorem rightChamberMap_binomial {S : Type*} [CommRing S] (t : S) (a : ℕ) (b : ℤ) :
    let q : S[T;T⁻¹] := C t * (1 + T 1)
    NodeAlgebra.rightChamberMap q
        (NodeAlgebra.coord q 0 ^ a * algebraMap S[T;T⁻¹] (NodeAlgebra S[T;T⁻¹] q) (T b)) =
      C (C (t ^ a)) * T (-(a : ℤ)) *
        ∑ j ∈ Finset.range (a + 1),
          (a.choose j : (S[T;T⁻¹])[T;T⁻¹]) * C (T (b + j)) := by
  intro q
  calc NodeAlgebra.rightChamberMap q
          (NodeAlgebra.coord q 0 ^ a * algebraMap S[T;T⁻¹] (NodeAlgebra S[T;T⁻¹] q) (T b))
      = C (C (t ^ a) * ((1 + T 1 : S[T;T⁻¹]) ^ a * T b)) * T (-(a : ℤ)) := by
        rw [map_mul, map_pow, NodeAlgebra.rightChamberMap_coord_zero, AlgHom.commutes,
          ← C_eq_algebraMap, mul_pow, T_pow, mul_neg_one,
          mul_right_comm (C q ^ a) (T (-(a : ℤ))) (C (T b)), ← map_pow, ← map_mul]
        simp [q, mul_pow, mul_assoc]
    _ = C (C (t ^ a)) * T (-(a : ℤ)) *
          ∑ j ∈ Finset.range (a + 1),
            (a.choose j : (S[T;T⁻¹])[T;T⁻¹]) * C (T (b + j)) := by
        rw [LaurentPolynomial.one_add_T_pow_mul_T, map_mul, map_sum, mul_right_comm]
        exact congrArg _ (Finset.sum_congr rfl fun _ _ => by rw [mul_one, map_mul, map_natCast])

end

/-! ### Functoriality in the coefficient ring `K` and order truncation `k' ≤ k` -/

noncomputable section

open Coordinate

/-- Mapping coefficients along `φ : K →+* K'` carries `modelIdeal K k` into `modelIdeal K' k`. -/
theorem modelIdeal_le_comap_map {K K' : Type*} [CommRing K] [CommRing K']
    (φ : K →+* K') (k : ℕ) :
    modelIdeal K k ≤ (modelIdeal K' k).comap (MvPolynomial.map φ) := by
  rw [modelIdeal_le_iff]; refine ⟨?_, ?_, ?_⟩
  · simpa [Ideal.mem_comap] using w_mul_wInv_sub_one_mem_modelIdeal K' k
  · simpa [Ideal.mem_comap] using t_pow_succ_mem_modelIdeal K' k
  · simpa [Ideal.mem_comap] using x_mul_y_sub_mem_modelIdeal K' k

/-- Ring homomorphism `ModelAlgebra K k →+* ModelAlgebra K' k` induced by a scalar ring
homomorphism `φ : K →+* K'`. -/
def mapRingHom {K K' : Type*} [CommRing K] [CommRing K'] (φ : K →+* K') (k : ℕ) :
    ModelAlgebra K k →+* ModelAlgebra K' k :=
  Ideal.quotientMap (modelIdeal K' k) (MvPolynomial.map φ) (modelIdeal_le_comap_map φ k)

@[simp] theorem mapRingHom_coordinate {K K' : Type*} [CommRing K] [CommRing K']
    (φ : K →+* K') (k : ℕ) (c : Coordinate) :
    mapRingHom φ k (coordinate K (modelIdeal K k) c) = coordinate K' (modelIdeal K' k) c := by
  rw [mapRingHom, coordinate, Ideal.quotientMap_mk, MvPolynomial.map_X, coordinate]

@[simp] theorem mapRingHom_algebraMap {K K' : Type*} [CommRing K] [CommRing K']
    (φ : K →+* K') (k : ℕ) (r : K) :
    mapRingHom φ k (algebraMap K (ModelAlgebra K k) r) =
      algebraMap K' (ModelAlgebra K' k) (φ r) := by
  rw [mapRingHom, IsScalarTower.algebraMap_apply K (Ambient K), MvPolynomial.algebraMap_eq,
    Ideal.Quotient.algebraMap_eq, Ideal.quotientMap_mk, MvPolynomial.map_C,
    IsScalarTower.algebraMap_apply K' (Ambient K'), MvPolynomial.algebraMap_eq,
    Ideal.Quotient.algebraMap_eq]

private theorem map_modelTheta_of_coordinate {K K' : Type*} [CommRing K] [CommRing K']
    {k k' : ℕ} (f : ModelAlgebra K k →+* ModelAlgebra K' k')
    (hc : ∀ c, f (coordinate K (modelIdeal K k) c) = coordinate K' (modelIdeal K' k') c)
    (n b : ℤ) : f (modelTheta K k n b) = modelTheta K' k' n b := by
  rw [modelTheta_def, modelTheta_def, map_mul, map_modelW_zpow K k f (modelW K' k') (hc w) b]
  split_ifs <;> simp [hc]

@[simp] theorem mapRingHom_modelTheta {K K' : Type*} [CommRing K] [CommRing K']
    (φ : K →+* K') (k : ℕ) (n b : ℤ) :
    mapRingHom φ k (modelTheta K k n b) = modelTheta K' k n b :=
  map_modelTheta_of_coordinate (mapRingHom φ k) (mapRingHom_coordinate φ k) n b

@[simp] theorem mapRingHom_id (K : Type*) [CommRing K] (k : ℕ) :
    mapRingHom (RingHom.id K) k = RingHom.id (ModelAlgebra K k) :=
  Ideal.Quotient.ringHom_ext <| MvPolynomial.ringHom_ext
    (mapRingHom_algebraMap (RingHom.id K) k) (mapRingHom_coordinate (RingHom.id K) k)

theorem mapRingHom_comp {K K' K'' : Type*} [CommRing K] [CommRing K'] [CommRing K'']
    (ψ : K' →+* K'') (φ : K →+* K') (k : ℕ) :
    mapRingHom (ψ.comp φ) k = (mapRingHom ψ k).comp (mapRingHom φ k) :=
  Ideal.Quotient.ringHom_ext <| MvPolynomial.ringHom_ext
    (fun r => by simp [mapRingHom]) (fun c => by simp [mapRingHom])

/-- The focus-focus model ideals are antitone in the truncation order `k`. -/
theorem modelIdeal_anti (K : Type*) [CommRing K] : Antitone (modelIdeal K) := by
  intro k' k hk; rw [modelIdeal_le_iff]
  refine ⟨w_mul_wInv_sub_one_mem_modelIdeal K k', ?_, x_mul_y_sub_mem_modelIdeal K k'⟩
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
  rw [Nat.add_right_comm, pow_add _ (k' + 1) d]
  exact Ideal.mul_mem_right _ _ (t_pow_succ_mem_modelIdeal K k')

/-- Order-truncation `K`-algebra homomorphism `ModelAlgebra K k →ₐ[K] ModelAlgebra K k'` for
`k' ≤ k`. -/
def truncAlgHom (K : Type*) [CommRing K] {k' k : ℕ} (hk : k' ≤ k) :
    ModelAlgebra K k →ₐ[K] ModelAlgebra K k' :=
  Ideal.Quotient.factorₐ K (modelIdeal_anti K hk)

@[simp] theorem truncAlgHom_coordinate (K : Type*) [CommRing K] {k' k : ℕ} (hk : k' ≤ k)
    (c : Coordinate) :
    truncAlgHom K hk (coordinate K (modelIdeal K k) c) = coordinate K (modelIdeal K k') c :=
  Ideal.Quotient.factorₐ_apply_mk K (modelIdeal_anti K hk) (MvPolynomial.X c)

@[simp] theorem truncAlgHom_modelTheta (K : Type*) [CommRing K] {k' k : ℕ} (hk : k' ≤ k) (n b : ℤ) :
    truncAlgHom K hk (modelTheta K k n b) = modelTheta K k' n b :=
  map_modelTheta_of_coordinate (truncAlgHom K hk).toRingHom (truncAlgHom_coordinate K hk) n b

@[simp] theorem truncAlgHom_refl (K : Type*) [CommRing K] (k : ℕ) :
    truncAlgHom K (le_refl k) = AlgHom.id K (ModelAlgebra K k) :=
  Ideal.Quotient.factorₐ_refl (modelIdeal K k)

theorem truncAlgHom_trans (K : Type*) [CommRing K] {k'' k' k : ℕ}
    (hk' : k'' ≤ k') (hk : k' ≤ k) :
    truncAlgHom K (hk'.trans hk) = (truncAlgHom K hk').comp (truncAlgHom K hk) :=
  (Ideal.Quotient.factorₐ_comp K (modelIdeal_anti K hk) (modelIdeal_anti K hk')).symm

end

