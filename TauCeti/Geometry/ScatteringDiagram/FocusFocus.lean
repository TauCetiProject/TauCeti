/-!
# The focus-focus model algebra and its theta multiplication law

At finite order `k : ℕ` over a commutative ring `K`, the local slab algebra attached to a
focus-focus affine singularity with wall function `1 + w` is modeled by the quotient

`ModelAlgebra K k = K[t, w, w⁻¹, x, y] / (w w⁻¹ - 1, t ^ (k + 1), x y - t (1 + w))`.

Setting `BaseRing K k = K[t] / (t ^ (k + 1))` (represented via `AdjoinRoot (X ^ (k + 1))`) and
`slabParam K k = t (1 + w)` inside the Laurent polynomial ring `(BaseRing K k)[T;T⁻¹]`, we
construct the `K`-algebra isomorphism

`modelSlabEquiv K k : ModelAlgebra K k ≃ₐ[K] SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)`.

Under `modelSlabEquiv K k`, the focus-focus theta elements `modelTheta K k n b` (`x^{-n} w^b` for
`n < 0`, `w^b` for `n = 0`, and `y^n w^b` for `n > 0`) correspond to the normal-form slab elements
`Z (slabParam K k) n * algebraMap (BaseRing K k)[T;T⁻¹] _ (T b)`. Combining `SlabAlgebra.Z_mul`
with the binomial expansion of `(1 + w)^r` yields:

* freeness of `ModelAlgebra K k` over `K` (`FocusFocus.instModuleFree`) and, over any nontrivial
  ring `K`, the explicit `K`-basis `t^i ϑ_{n,b}` (`FocusFocus.modelBasis`) and nonvanishing of
  every `modelTheta K k n b`;
* the focus-focus theta multiplication formula (`FocusFocus.modelTheta_mul`): for
  `r = (|n| + |m| - |n + m|) / 2`,
  `ϑ_{n,b} * ϑ_{m,c} = t^r * ∑_{j = 0}^r binom(r, j) ϑ_{n + m, b + c + j}`;
* positivity of structure constants as evaluations of monomials in `ℕ[X]` at `t`
  (`FocusFocus.modelTheta_mul_eval₂_nat`), functoriality along ring homomorphisms `K →+* K'`
  (`FocusFocus.mapRingHom`), and compatibility with order truncation `k' ≤ k`
  (`FocusFocus.truncAlgHom`).

## Main definitions and results

* `TauCeti.FocusFocus.Coordinate`, `TauCeti.FocusFocus.Ambient`, `TauCeti.FocusFocus.modelIdeal`,
  `TauCeti.FocusFocus.ModelAlgebra`, `TauCeti.FocusFocus.coordinate`: ambient polynomial ring and
  order-`k` focus-focus model algebra.
* `TauCeti.FocusFocus.modelW`, `TauCeti.FocusFocus.modelTheta`: the tangential unit `w` and theta
  elements `ϑ_{n,b}`.
* `TauCeti.FocusFocus.modelSlabEquiv`: `K`-algebra isomorphism with
  `SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)`.
* `TauCeti.FocusFocus.modelBasis`, `TauCeti.FocusFocus.instModuleFree`: `K`-basis `t^i ϑ_{n,b}` and
  freeness over `K`.
* `TauCeti.FocusFocus.modelTheta_mul`: the focus-focus theta product formula.
* `TauCeti.FocusFocus.mapRingHom`, `TauCeti.FocusFocus.truncAlgHom`: base-change and truncation
  homomorphisms preserving `modelTheta`.

## References

* M. Gross and B. Siebert, *An Invitation to Toric Degenerations*, §§2.2–2.3, arXiv:0808.2749v2.
* M. Gross, P. Hacking, and B. Siebert, *Theta functions on varieties with effective
  anti-canonical class*, Definition 3.3, Proposition 3.5, and Lemma 3.7, arXiv:1601.07081v4.
-/

public section

namespace TauCeti

namespace FocusFocus

noncomputable section

/-- Coordinates for `K[t, w, w⁻¹, x, y]`, with the inverse relation imposed in the quotient. -/
inductive Coordinate where
  | t | w | wInv | x | y
  deriving DecidableEq

open Coordinate
open LaurentPolynomial
  (C T T_pow T_add T_zero C_eq_algebraMap single_eq_C_mul_T eval₂ eval₂_C eval₂_T)
open scoped LaurentPolynomial

variable (K : Type*) [CommRing K]

/-- The polynomial ring `K[t, w, w⁻¹, x, y]` before imposing the focus-focus slab relations. -/
abbrev Ambient := MvPolynomial Coordinate K

/-- The focus-focus model ideal generated by `w w⁻¹ - 1`, `t ^ (k + 1)`, and `x y - t (1 + w)`. -/
def modelIdeal (k : ℕ) : Ideal (Ambient K) :=
  Ideal.span {MvPolynomial.X w * MvPolynomial.X wInv - 1,
    MvPolynomial.X t ^ (k + 1),
    MvPolynomial.X x * MvPolynomial.X y - MvPolynomial.X t * (1 + MvPolynomial.X w)}

/-- The focus-focus model algebra `K[t, w^{±1}, x, y] / (t^{k + 1}, x y - t (1 + w))` at
order `k`. -/
abbrev ModelAlgebra (k : ℕ) := Ambient K ⧸ modelIdeal K k

/-- The residue class of an ambient coordinate in a quotient of `Ambient K`. -/
def coordinate (I : Ideal (Ambient K)) (c : Coordinate) : Ambient K ⧸ I :=
  Ideal.Quotient.mk I (MvPolynomial.X c)

/-- The tangential coordinate `w` as a unit of `ModelAlgebra K k`, with inverse `w⁻¹`. -/
def modelW (k : ℕ) : (ModelAlgebra K k)ˣ where
  val := coordinate K (modelIdeal K k) w
  inv := coordinate K (modelIdeal K k) wInv
  val_inv := by
    rw [coordinate, coordinate, ← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_insert _ _)
  inv_val := by
    rw [coordinate, coordinate, ← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq,
      mul_comm]
    exact Ideal.subset_span (Set.mem_insert _ _)

@[simp]
theorem val_modelW (k : ℕ) :
    ((modelW K k : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) =
      coordinate K (modelIdeal K k) w := by
  rfl

@[simp]
theorem val_inv_modelW (k : ℕ) :
    (((modelW K k)⁻¹ : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) =
      coordinate K (modelIdeal K k) wInv := by
  rfl

theorem coordinate_t_pow_succ_eq_zero (k : ℕ) :
    coordinate K (modelIdeal K k) t ^ (k + 1) = 0 := by
  rw [coordinate, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))

theorem coordinate_x_mul_y (k : ℕ) :
    coordinate K (modelIdeal K k) x * coordinate K (modelIdeal K k) y =
      coordinate K (modelIdeal K k) t * (1 + coordinate K (modelIdeal K k) w) := by
  rw [coordinate, coordinate, coordinate, coordinate, ← map_mul, ← map_one (Ideal.Quotient.mk _),
    ← map_add, ← map_mul, Ideal.Quotient.eq]
  exact Ideal.subset_span
    (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

/-- The model theta element `ϑ_{n,b}` in `ModelAlgebra K k`, equal to `x^{-n} w^b` for `n < 0`,
`w^b` for `n = 0`, and `y^n w^b` for `n > 0`. -/
def modelTheta (k : ℕ) (n b : ℤ) : ModelAlgebra K k :=
  (if n < 0 then coordinate K (modelIdeal K k) x ^ n.natAbs
    else coordinate K (modelIdeal K k) y ^ n.natAbs) *
    ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)

@[simp]
theorem modelTheta_zero_left (k : ℕ) (b : ℤ) :
    modelTheta K k 0 b = ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := by
  simp [modelTheta]

theorem modelTheta_zero (k : ℕ) : modelTheta K k 0 0 = 1 := by
  simp

/-! ### Identification with `SlabAlgebra` over `(K[t] / (t^{k + 1}))[w, w⁻¹]` -/

/-- The truncated polynomial base ring `K[t] / (t ^ (k + 1))` at order `k`. -/
abbrev BaseRing (k : ℕ) := AdjoinRoot (Polynomial.X ^ (k + 1) : Polynomial K)

/-- The focus-focus slab parameter `t (1 + w)` in `(BaseRing K k)[T;T⁻¹]`. -/
def slabParam (k : ℕ) : (BaseRing K k)[T;T⁻¹] :=
  C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)) * (1 + T 1)

private abbrev TargetSlab (k : ℕ) := SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)

private def coordToSlab (k : ℕ) : Coordinate → TargetSlab K k
  | t => algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k)
      (C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)))
  | w => algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T 1)
  | wInv => algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T (-1))
  | x => SlabAlgebra.X (slabParam K k)
  | y => SlabAlgebra.Y (slabParam K k)

private def modelToSlab (k : ℕ) : ModelAlgebra K k →ₐ[K] TargetSlab K k :=
  Ideal.Quotient.liftₐ (modelIdeal K k) (MvPolynomial.aeval (coordToSlab K k)) (by
    have hle : modelIdeal K k ≤ RingHom.ker (MvPolynomial.aeval (coordToSlab K k)).toRingHom := by
      rw [modelIdeal, Ideal.span_le]
      intro p hp
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
      rw [SetLike.mem_coe, RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rcases hp with rfl | rfl | rfl
      · rw [map_sub, map_mul, map_one, MvPolynomial.aeval_X, MvPolynomial.aeval_X, coordToSlab,
          coordToSlab, ← map_mul, ← T_add]
        simp
      · have hroot : AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K) ^ (k + 1) = 0 := by
          simpa using AdjoinRoot.eval₂_root (Polynomial.X ^ (k + 1) : Polynomial K)
        rw [map_pow, MvPolynomial.aeval_X, coordToSlab, ← map_pow, ← map_pow, hroot, map_zero,
          map_zero]
      · have hpar : slabParam K k =
            C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)) * (1 + T 1) := rfl
        rw [map_sub, map_mul, map_mul, map_add, map_one, MvPolynomial.aeval_X,
          MvPolynomial.aeval_X, MvPolynomial.aeval_X, MvPolynomial.aeval_X,
          coordToSlab, coordToSlab, coordToSlab, coordToSlab, SlabAlgebra.X_mul_Y,
          ← map_one (algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k)),
          ← map_add, ← map_mul, ← hpar, sub_self]
    intro a ha
    exact hle ha)

@[simp]
private theorem modelToSlab_coordinate (k : ℕ) (c : Coordinate) :
    modelToSlab K k (coordinate K (modelIdeal K k) c) = coordToSlab K k c := by
  exact MvPolynomial.aeval_X (coordToSlab K k) c

private def baseToModel (k : ℕ) : BaseRing K k →ₐ[K] ModelAlgebra K k :=
  AdjoinRoot.liftAlgHom (Polynomial.X ^ (k + 1) : Polynomial K)
    (Algebra.ofId K (ModelAlgebra K k))
    (coordinate K (modelIdeal K k) t)
    (by simp [coordinate_t_pow_succ_eq_zero])

private def slabToModel (k : ℕ) : TargetSlab K k →ₐ[K] ModelAlgebra K k :=
  { SlabAlgebra.liftRingHom (eval₂ (baseToModel K k).toRingHom (modelW K k))
      (coordinate K (modelIdeal K k) x)
      (coordinate K (modelIdeal K k) y)
      (by
        simp only [slabParam, map_mul, map_add, map_one, eval₂_C, eval₂_T,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, baseToModel, AdjoinRoot.liftAlgHom_root,
          zpow_one, val_modelW]
        exact coordinate_x_mul_y K k) with
    commutes' r := by
      rw [RingHom.toFun_eq_coe, IsScalarTower.algebraMap_apply K (BaseRing K k)[T;T⁻¹],
        SlabAlgebra.liftRingHom_algebraMap, IsScalarTower.algebraMap_apply K (BaseRing K k),
        ← C_eq_algebraMap, eval₂_C, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      exact (baseToModel K k).commutes r }

private theorem modelToSlab_baseToModel (k : ℕ) (a : BaseRing K k) :
    modelToSlab K k (baseToModel K k a) =
      algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (C a) := by
  have hK (r : K) : algebraMap K (TargetSlab K k) r =
      algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k)
        (C (AdjoinRoot.of (Polynomial.X ^ (k + 1) : Polynomial K) r)) := by
    rw [← AdjoinRoot.algebraMap_eq, C_eq_algebraMap,
      ← IsScalarTower.algebraMap_apply K (BaseRing K k) (BaseRing K k)[T;T⁻¹] r,
      ← IsScalarTower.algebraMap_apply K (BaseRing K k)[T;T⁻¹] (TargetSlab K k) r]
  induction a using AdjoinRoot.induction_on with
  | ih f =>
    induction f using Polynomial.induction_on' with
    | add p₁ p₂ hp₁ hp₂ => simp [hp₁, hp₂]
    | monomial d r =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow,
        AdjoinRoot.mk_C, AdjoinRoot.mk_X]
      simp [baseToModel, coordToSlab, hK]

private theorem modelToSlab_modelW_zpow (k : ℕ) (n : ℤ) :
    modelToSlab K k (((modelW K k ^ n : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)) =
      algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T n) := by
  let u : (TargetSlab K k)ˣ := Units.map (modelToSlab K k).toMonoidHom (modelW K k)
  have hu : (u : TargetSlab K k) =
      algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T 1) := by
    simp [u, modelW, coordToSlab]
  have hu_inv : ((u⁻¹ : (TargetSlab K k)ˣ) : TargetSlab K k) =
      algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T (-1)) := by
    simp [u, modelW, coordToSlab]
  have hmap : modelToSlab K k
      (((modelW K k ^ n : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)) =
      ((u ^ n : (TargetSlab K k)ˣ) : TargetSlab K k) :=
    (Units.coe_map (modelToSlab K k).toMonoidHom (modelW K k ^ n)).symm.trans
      (congrArg Units.val (map_zpow (Units.map (modelToSlab K k).toMonoidHom)
        (modelW K k) n))
  rw [hmap]
  cases n with
  | ofNat d =>
    simp [zpow_natCast, Units.val_pow_eq_pow_val, hu, ← map_pow, T_pow]
  | negSucc d =>
    rw [zpow_negSucc, ← inv_pow, Units.val_pow_eq_pow_val, hu_inv, ← map_pow, T_pow]
    congr 2
    omega

/-- Canonical `K`-algebra isomorphism between `ModelAlgebra K k` and the slab algebra
`SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)` over `BaseRing K k = K[t] / (t ^ (k + 1))`. -/
def modelSlabEquiv (k : ℕ) :
    ModelAlgebra K k ≃ₐ[K] SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k) :=
  AlgEquiv.ofAlgHom (modelToSlab K k) (slabToModel K k)
    (by
      refine SlabAlgebra.algHom_ext_of_algebra (fun p => ?_)
        (by simp [slabToModel, coordToSlab]) (by simp [slabToModel, coordToSlab])
      simp only [AlgHom.comp_apply, AlgHom.id_apply, slabToModel, AlgHom.coe_mk,
        SlabAlgebra.liftRingHom_algebraMap]
      induction p using AddMonoidAlgebra.induction_linear with
      | zero => simp
      | add f g hf hg => rw [map_add, map_add, hf, hg, map_add]
      | single n a =>
        rw [single_eq_C_mul_T, map_mul, map_mul, eval₂_C, eval₂_T,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, modelToSlab_baseToModel,
          modelToSlab_modelW_zpow, ← map_mul])
    (by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro c
      rw [AlgHom.comp_apply, AlgHom.comp_apply, AlgHom.comp_apply, AlgHom.id_apply,
        Ideal.Quotient.mkₐ_eq_mk, ← coordinate]
      cases c <;> simp [slabToModel, coordToSlab, baseToModel])

@[simp]
theorem modelSlabEquiv_coordinate_t (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) t) =
      algebraMap (BaseRing K k)[T;T⁻¹] (SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
        (C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K))) := by
  simp [modelSlabEquiv, coordToSlab]

@[simp]
theorem modelSlabEquiv_coordinate_w (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) w) =
      algebraMap (BaseRing K k)[T;T⁻¹] (SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
        (T 1) := by
  simp [modelSlabEquiv, coordToSlab]

@[simp]
theorem modelSlabEquiv_coordinate_wInv (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) wInv) =
      algebraMap (BaseRing K k)[T;T⁻¹] (SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
        (T (-1)) := by
  simp [modelSlabEquiv, coordToSlab]

@[simp]
theorem modelSlabEquiv_coordinate_x (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) x) = SlabAlgebra.X (slabParam K k) := by
  simp [modelSlabEquiv, coordToSlab]

@[simp]
theorem modelSlabEquiv_coordinate_y (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) y) = SlabAlgebra.Y (slabParam K k) := by
  simp [modelSlabEquiv, coordToSlab]

@[simp]
theorem modelSlabEquiv_modelW_zpow (k : ℕ) (b : ℤ) :
    modelSlabEquiv K k (((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)) =
      algebraMap (BaseRing K k)[T;T⁻¹] (SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
        (T b) :=
  modelToSlab_modelW_zpow K k b

/-- Image of `modelTheta K k n b` under `modelSlabEquiv K k`: it equals the slab basis element
`SlabAlgebra.Z (slabParam K k) n` multiplied by the tangential Laurent monomial `T b`. -/
@[simp]
theorem modelSlabEquiv_modelTheta (k : ℕ) (n b : ℤ) :
    modelSlabEquiv K k (modelTheta K k n b) =
      SlabAlgebra.Z (slabParam K k) n *
        algebraMap (BaseRing K k)[T;T⁻¹] (SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
          (T b) := by
  rw [modelTheta, map_mul, modelSlabEquiv_modelW_zpow]
  split_ifs with hn
  · simp [SlabAlgebra.Z_of_lt_zero (slabParam K k) hn]
  · simp [SlabAlgebra.Z_of_nonneg (slabParam K k) (not_lt.mp hn)]

@[simp]
theorem modelSlabEquiv_symm_Z_mul_T (k : ℕ) (n b : ℤ) :
    (modelSlabEquiv K k).symm
      (SlabAlgebra.Z (slabParam K k) n *
        algebraMap (BaseRing K k)[T;T⁻¹] (SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
          (T b)) =
      modelTheta K k n b := by
  rw [← modelSlabEquiv_modelTheta, AlgEquiv.symm_apply_apply]

/-! ### Module freeness and the `K`-basis `t^i ϑ_{n,b}` -/

/-- `ModelAlgebra K k` is a free `K`-module for every commutative ring `K` and order `k`. -/
instance instModuleFree (k : ℕ) : Module.Free K (ModelAlgebra K k) := by
  let bBase := (AdjoinRoot.powerBasis' (Polynomial.monic_X_pow (k + 1) :
    (Polynomial.X ^ (k + 1) : Polynomial K).Monic)).basis
  let bLaur := bBase.smulTower (AddMonoidAlgebra.basis ℤ (BaseRing K k))
  let bSlab := bLaur.smulTower (SlabAlgebra.slabBasis (slabParam K k))
  exact Module.Free.of_basis (bSlab.map (modelSlabEquiv K k).symm.toLinearEquiv)

/-- Over any nontrivial commutative ring `K`, the monomials `t^i * ϑ_{n,b}`
(`i : Fin (k + 1)`, `n b : ℤ`) form a `K`-basis of `ModelAlgebra K k`. -/
def modelBasis [Nontrivial K] (k : ℕ) :
    Module.Basis (Fin (k + 1) × ℤ × ℤ) K (ModelAlgebra K k) := by
  let pb := AdjoinRoot.powerBasis'
    (Polynomial.monic_X_pow (k + 1) : (Polynomial.X ^ (k + 1) : Polynomial K).Monic)
  let bBase : Module.Basis (Fin (k + 1)) K (BaseRing K k) :=
    pb.basis.reindex (finCongr (by simp [pb]))
  let bTheta : Module.Basis (ℤ × ℤ) (BaseRing K k)
      (SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)) :=
    (AddMonoidAlgebra.basis ℤ (BaseRing K k)).smulTower'
      (SlabAlgebra.slabBasis (slabParam K k))
  exact (bBase.smulTower bTheta).map (modelSlabEquiv K k).symm.toLinearEquiv

@[simp]
theorem modelBasis_apply [Nontrivial K] (k : ℕ) (i : Fin (k + 1)) (n b : ℤ) :
    modelBasis K k (i, n, b) =
      coordinate K (modelIdeal K k) t ^ (i : ℕ) * modelTheta K k n b := by
  apply (modelSlabEquiv K k).injective
  simp only [modelBasis, Module.Basis.map_apply, AlgEquiv.toLinearEquiv_apply,
    AlgEquiv.apply_symm_apply, Module.Basis.smulTower_apply, Module.Basis.smulTower'_apply,
    Module.Basis.reindex_apply, finCongr_symm, finCongr_apply, Fin.val_cast,
    PowerBasis.coe_basis, AdjoinRoot.powerBasis'_gen, AddMonoidAlgebra.basis_apply,
    SlabAlgebra.slabBasis_apply, map_mul, map_pow, modelSlabEquiv_coordinate_t,
    modelSlabEquiv_modelTheta]
  have hT : (AddMonoidAlgebra.single b (1 : BaseRing K k) : (BaseRing K k)[T;T⁻¹]) = T b := rfl
  have hsmul₁ : (T b : (BaseRing K k)[T;T⁻¹]) • SlabAlgebra.Z (slabParam K k) n =
      algebraMap (BaseRing K k)[T;T⁻¹] (SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
        (T b) * SlabAlgebra.Z (slabParam K k) n :=
    Algebra.smul_def (T b : (BaseRing K k)[T;T⁻¹]) (SlabAlgebra.Z (slabParam K k) n)
  have hsmul₂ (r : BaseRing K k)
      (z : SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)) :
      r • z =
        algebraMap (BaseRing K k)[T;T⁻¹] (SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k))
          (C r) * z := by
    rw [← IsScalarTower.algebraMap_smul (BaseRing K k)[T;T⁻¹] r z,
      Algebra.smul_def (algebraMap (BaseRing K k) (BaseRing K k)[T;T⁻¹] r) z,
      ← C_eq_algebraMap]
  rw [hT, hsmul₁, hsmul₂, map_pow, map_pow]
  ring

/-- Over a nontrivial commutative ring `K`, every theta basis element `modelTheta K k n b` is
nonzero in `ModelAlgebra K k`. -/
theorem modelTheta_ne_zero [Nontrivial K] (k : ℕ) (n b : ℤ) :
    modelTheta K k n b ≠ 0 := by
  have h0 : modelBasis K k (0, n, b) = modelTheta K k n b := by
    simp [modelBasis_apply]
  rw [← h0]
  exact (modelBasis K k).ne_zero (0, n, b)

/-! ### The focus-focus theta multiplication formula -/

/-- **Focus-focus theta multiplication formula**: for `r = (|n| + |m| - |n + m|) / 2`,
`ϑ_{n,b} * ϑ_{m,c} = t^r * ∑_{j = 0}^r binom(r, j) ϑ_{n + m, b + c + j}` in `ModelAlgebra K k`. -/
theorem modelTheta_mul (k : ℕ) (n m b c : ℤ) :
    let r := (n.natAbs + m.natAbs - (n + m).natAbs) / 2
    modelTheta K k n b * modelTheta K k m c =
      coordinate K (modelIdeal K k) t ^ r *
        ∑ j ∈ Finset.range (r + 1), (r.choose j : ModelAlgebra K k) *
          modelTheta K k (n + m) (b + c + j) := by
  intro r
  apply (modelSlabEquiv K k).injective
  let A := SlabAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)
  have h1T : (1 + T 1 : (BaseRing K k)[T;T⁻¹]) ^ r * T (b + c) =
      ∑ j ∈ Finset.range (r + 1),
        (r.choose j : (BaseRing K k)[T;T⁻¹]) * T (b + c + j) := by
    rw [add_comm (1 : (BaseRing K k)[T;T⁻¹]) (T 1), add_pow, Finset.sum_mul]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [one_pow, mul_one, T_pow, mul_one, mul_comm _ (r.choose j : (BaseRing K k)[T;T⁻¹]),
      mul_assoc, ← T_add, add_comm (j : ℤ) (b + c)]
  have hparam : slabParam K k ^ r * (T b * T c) =
      C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)) ^ r *
        ∑ j ∈ Finset.range (r + 1),
          (r.choose j : (BaseRing K k)[T;T⁻¹]) * T (b + c + j) := by
    rw [slabParam, mul_pow, ← T_add, mul_assoc, h1T]
  have hZmul : SlabAlgebra.Z (slabParam K k) n * SlabAlgebra.Z (slabParam K k) m =
      algebraMap (BaseRing K k)[T;T⁻¹] A (slabParam K k ^ r) *
        SlabAlgebra.Z (slabParam K k) (n + m) :=
    SlabAlgebra.Z_mul (slabParam K k) n m
  calc
    modelSlabEquiv K k (modelTheta K k n b * modelTheta K k m c)
        = (SlabAlgebra.Z (slabParam K k) n * SlabAlgebra.Z (slabParam K k) m) *
            algebraMap (BaseRing K k)[T;T⁻¹] A (T b * T c) := by
          rw [map_mul, modelSlabEquiv_modelTheta, modelSlabEquiv_modelTheta, map_mul]
          ring
    _ = algebraMap (BaseRing K k)[T;T⁻¹] A (slabParam K k ^ r * (T b * T c)) *
          SlabAlgebra.Z (slabParam K k) (n + m) := by
          simp only [hZmul, map_mul]
          ring
    _ = modelSlabEquiv K k (coordinate K (modelIdeal K k) t ^ r *
          ∑ j ∈ Finset.range (r + 1), (r.choose j : ModelAlgebra K k) *
            modelTheta K k (n + m) (b + c + j)) := by
          rw [hparam, map_mul, map_pow, map_sum, mul_right_comm, mul_assoc, Finset.mul_sum,
            map_mul, map_pow, modelSlabEquiv_coordinate_t, map_sum]
          congr 1
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [map_mul, map_natCast, map_mul, map_natCast, modelSlabEquiv_modelTheta]
          ring

/-- Positivity of the focus-focus theta structure constants: every coefficient in
`modelTheta_mul` is the evaluation at `t` of
`Polynomial.monomial r (r.choose j) : Polynomial ℕ`. -/
theorem modelTheta_mul_eval₂_nat (k : ℕ) (n m b c : ℤ) :
    let r := (n.natAbs + m.natAbs - (n + m).natAbs) / 2
    modelTheta K k n b * modelTheta K k m c =
      ∑ j ∈ Finset.range (r + 1),
        Polynomial.eval₂ (Nat.castRingHom (ModelAlgebra K k))
          (coordinate K (modelIdeal K k) t) (Polynomial.monomial r (r.choose j)) *
          modelTheta K k (n + m) (b + c + j) := by
  intro r
  rw [modelTheta_mul K k n m b c, Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  simp only [Polynomial.eval₂_monomial, eq_natCast]
  ring

/-- Opposite-ray product check: `ϑ_{-1, 0} * ϑ_{1, 0} = t * ϑ_{0, 0} + t * ϑ_{0, 1}`
(for instance over `K = ℤ` at order `k = 2`). -/
theorem modelTheta_neg_one_mul_one (k : ℕ) :
    modelTheta K k (-1) 0 * modelTheta K k 1 0 =
      coordinate K (modelIdeal K k) t * modelTheta K k 0 0 +
        coordinate K (modelIdeal K k) t * modelTheta K k 0 1 := by
  rw [modelTheta_mul K k (-1) 1 0 0]
  simp [Finset.sum_range_succ, mul_add]

end

/-! ### Functoriality in the coefficient ring `K` and order truncation `k' ≤ k` -/

noncomputable section

open Coordinate

/-- Ring homomorphism `ModelAlgebra K k →+* ModelAlgebra K' k` induced by a scalar ring
homomorphism `φ : K →+* K'`. -/
def mapRingHom {K K' : Type*} [CommRing K] [CommRing K'] (φ : K →+* K') (k : ℕ) :
    ModelAlgebra K k →+* ModelAlgebra K' k :=
  Ideal.Quotient.lift (modelIdeal K k)
    ((Ideal.Quotient.mk (modelIdeal K' k)).comp (MvPolynomial.map φ)) (by
      have hle : modelIdeal K k ≤
          RingHom.ker ((Ideal.Quotient.mk (modelIdeal K' k)).comp (MvPolynomial.map φ)) := by
        rw [modelIdeal, Ideal.span_le]
        intro p hp
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
        rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem,
          modelIdeal]
        rcases hp with rfl | rfl | rfl
        · simp only [map_sub, map_mul, map_one, MvPolynomial.map_X]
          exact Ideal.subset_span (Set.mem_insert _ _)
        · simp only [map_pow, MvPolynomial.map_X]
          exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
        · simp only [map_sub, map_mul, map_add, map_one, MvPolynomial.map_X]
          exact Ideal.subset_span
            (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
      intro a ha
      exact hle ha)

@[simp]
theorem mapRingHom_coordinate {K K' : Type*} [CommRing K] [CommRing K']
    (φ : K →+* K') (k : ℕ) (c : Coordinate) :
    mapRingHom φ k (coordinate K (modelIdeal K k) c) = coordinate K' (modelIdeal K' k) c := by
  exact congrArg (Ideal.Quotient.mk (modelIdeal K' k)) (MvPolynomial.map_X φ c)

@[simp]
theorem mapRingHom_algebraMap {K K' : Type*} [CommRing K] [CommRing K']
    (φ : K →+* K') (k : ℕ) (r : K) :
    mapRingHom φ k (algebraMap K (ModelAlgebra K k) r) =
      algebraMap K' (ModelAlgebra K' k) (φ r) := by
  exact congrArg (Ideal.Quotient.mk (modelIdeal K' k)) (MvPolynomial.map_C φ r)

@[simp]
theorem mapRingHom_modelTheta {K K' : Type*} [CommRing K] [CommRing K']
    (φ : K →+* K') (k : ℕ) (n b : ℤ) :
    mapRingHom φ k (modelTheta K k n b) = modelTheta K' k n b := by
  have hw : Units.map (mapRingHom φ k).toMonoidHom (modelW K k) = modelW K' k := by
    ext
    simp [modelW]
  have hzb : mapRingHom φ k (((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)) =
      ((modelW K' k ^ b : (ModelAlgebra K' k)ˣ) : ModelAlgebra K' k) :=
    (Units.coe_map (mapRingHom φ k).toMonoidHom (modelW K k ^ b)).symm.trans
      (congrArg Units.val (by rw [map_zpow, hw]))
  rw [modelTheta, modelTheta, map_mul, hzb]
  split_ifs with hn <;> simp

@[simp]
theorem mapRingHom_id (K : Type*) [CommRing K] (k : ℕ) :
    mapRingHom (RingHom.id K) k = RingHom.id (ModelAlgebra K k) := by
  apply Ideal.Quotient.ringHom_ext
  apply MvPolynomial.ringHom_ext
  · intro r
    exact mapRingHom_algebraMap (RingHom.id K) k r
  · intro c
    exact mapRingHom_coordinate (RingHom.id K) k c

theorem mapRingHom_comp {K K' K'' : Type*} [CommRing K] [CommRing K'] [CommRing K'']
    (ψ : K' →+* K'') (φ : K →+* K') (k : ℕ) :
    mapRingHom (ψ.comp φ) k = (mapRingHom ψ k).comp (mapRingHom φ k) := by
  apply Ideal.Quotient.ringHom_ext
  apply MvPolynomial.ringHom_ext
  · intro r
    simp only [RingHom.comp_apply]
    exact (mapRingHom_algebraMap (ψ.comp φ) k r).trans
      ((mapRingHom_algebraMap ψ k (φ r)).symm.trans
        (congrArg (mapRingHom ψ k) (mapRingHom_algebraMap φ k r).symm))
  · intro c
    simp only [RingHom.comp_apply]
    exact (mapRingHom_coordinate (ψ.comp φ) k c).trans
      ((mapRingHom_coordinate ψ k c).symm.trans
        (congrArg (mapRingHom ψ k) (mapRingHom_coordinate φ k c).symm))

/-- Order-truncation `K`-algebra homomorphism `ModelAlgebra K k →ₐ[K] ModelAlgebra K k'` for
`k' ≤ k`. -/
def truncAlgHom (K : Type*) [CommRing K] {k' k : ℕ} (hk : k' ≤ k) :
    ModelAlgebra K k →ₐ[K] ModelAlgebra K k' :=
  Ideal.Quotient.liftₐ (modelIdeal K k) (Ideal.Quotient.mkₐ K (modelIdeal K k')) (by
    have hle : modelIdeal K k ≤
        RingHom.ker (Ideal.Quotient.mkₐ K (modelIdeal K k')).toRingHom := by
      rw [modelIdeal, Ideal.span_le]
      intro p hp
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
      rw [SetLike.mem_coe, RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem, modelIdeal]
      rcases hp with rfl | rfl | rfl
      · exact Ideal.subset_span (Set.mem_insert _ _)
      · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
        have hpow : (MvPolynomial.X t : Ambient K) ^ (k' + d + 1) =
            MvPolynomial.X t ^ (k' + 1) * MvPolynomial.X t ^ d := by
          rw [← pow_add]
          congr 1
          omega
        rw [hpow]
        exact Ideal.mul_mem_right _ _
          (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))
      · exact Ideal.subset_span
          (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    intro a ha
    exact hle ha)

@[simp]
theorem truncAlgHom_coordinate (K : Type*) [CommRing K] {k' k : ℕ} (hk : k' ≤ k)
    (c : Coordinate) :
    truncAlgHom K hk (coordinate K (modelIdeal K k) c) = coordinate K (modelIdeal K k') c := by
  rfl

@[simp]
theorem truncAlgHom_modelTheta (K : Type*) [CommRing K] {k' k : ℕ} (hk : k' ≤ k) (n b : ℤ) :
    truncAlgHom K hk (modelTheta K k n b) = modelTheta K k' n b := by
  have hw : Units.map (truncAlgHom K hk).toMonoidHom (modelW K k) = modelW K k' := by
    ext
    simp [modelW]
  have hzb : truncAlgHom K hk (((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)) =
      ((modelW K k' ^ b : (ModelAlgebra K k')ˣ) : ModelAlgebra K k') :=
    (Units.coe_map (truncAlgHom K hk).toMonoidHom (modelW K k ^ b)).symm.trans
      (congrArg Units.val (by rw [map_zpow, hw]))
  rw [modelTheta, modelTheta, map_mul, hzb]
  split_ifs with hn <;> simp

@[simp]
theorem truncAlgHom_refl (K : Type*) [CommRing K] (k : ℕ) :
    truncAlgHom K (le_refl k) = AlgHom.id K (ModelAlgebra K k) := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  intro c
  rw [AlgHom.comp_apply, AlgHom.comp_apply, AlgHom.id_apply, Ideal.Quotient.mkₐ_eq_mk,
    ← coordinate, truncAlgHom_coordinate]

theorem truncAlgHom_trans (K : Type*) [CommRing K] {k'' k' k : ℕ}
    (hk' : k'' ≤ k') (hk : k' ≤ k) :
    truncAlgHom K (hk'.trans hk) = (truncAlgHom K hk').comp (truncAlgHom K hk) := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  intro c
  rw [AlgHom.comp_apply, AlgHom.comp_apply, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
    ← coordinate, truncAlgHom_coordinate, truncAlgHom_coordinate, truncAlgHom_coordinate]

end

end FocusFocus

