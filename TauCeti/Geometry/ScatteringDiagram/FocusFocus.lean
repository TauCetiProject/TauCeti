/-!
# The focus-focus model algebra and its theta multiplication law

At finite order `k : ℕ` over a commutative ring `K`, the focus-focus model algebra with wall
function `1 + w` is
`ModelAlgebra K k = K[t, w, w⁻¹, x, y] / (w w⁻¹ - 1, t ^ (k + 1), x y - t (1 + w))`.
With `BaseRing K k = K[t] / (t ^ (k + 1))` and `slabParam K k = t (1 + w)` in
`(BaseRing K k)[T;T⁻¹]`, we construct the `BaseRing K k`-algebra isomorphism
`modelSlabEquivBase K k` from `ModelAlgebra K k` to
`NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)` (and its `K`-restriction
`modelSlabEquiv K k`), identifying theta elements `modelTheta K k n b` with
`NodeAlgebra.Z (slabParam K k) n * algebraMap _ _ (T b)`. From `NodeAlgebra.Z_mul` and
`LaurentPolynomial.one_add_T_pow_mul_T` we obtain:
* freeness over `K` (`FocusFocus.instModuleFree`), the `K`-basis `t^i ϑ_{n,b}`
  (`FocusFocus.modelBasis`) over nontrivial `K`, and nonvanishing of `modelTheta`;
* the theta product formula (`FocusFocus.modelTheta_mul`) and structure-constant positivity
  (`FocusFocus.modelTheta_mul_eval₂_nat`);
* functoriality in `K` (`FocusFocus.mapRingHom`), order truncation `k' ≤ k`
  (`FocusFocus.truncAlgHom`), and naturality of `modelSlabEquiv`.

## References

* M. Gross and B. Siebert, *An Invitation to Toric Degenerations*, §§2.2–2.3, arXiv:0808.2749v2.
* M. Gross, P. Hacking, and B. Siebert, *Theta functions on varieties with effective
  anti-canonical class*, Definition 3.3, Proposition 3.5, and Lemma 3.7, arXiv:1601.07081v4.
-/

public section

namespace TauCeti

namespace FocusFocus

noncomputable section

/-- Coordinates for `K[t, w, w⁻¹, x, y]`, with the inverse relation imposed in the quotient. -/
inductive Coordinate where
  | t | w | wInv | x | y
  deriving DecidableEq

open Coordinate
open LaurentPolynomial
  (C T T_pow T_add T_zero C_eq_algebraMap single_eq_C_mul_T eval₂ eval₂_C eval₂_T)
open scoped LaurentPolynomial

section

variable (K : Type*) [CommRing K]

/-- The polynomial ring `K[t, w, w⁻¹, x, y]` before imposing the focus-focus slab relations. -/
abbrev Ambient := MvPolynomial Coordinate K

/-- The model ideal generated by `w w⁻¹ - 1`, `t ^ (k + 1)`, and `x y - t (1 + w)`. -/
def modelIdeal (k : ℕ) : Ideal (Ambient K) :=
  Ideal.span {MvPolynomial.X w * MvPolynomial.X wInv - 1, MvPolynomial.X t ^ (k + 1),
    MvPolynomial.X x * MvPolynomial.X y - MvPolynomial.X t * (1 + MvPolynomial.X w)}

theorem w_mul_wInv_sub_one_mem_modelIdeal (k : ℕ) :
    MvPolynomial.X w * MvPolynomial.X wInv - 1 ∈ modelIdeal K k :=
  Ideal.subset_span (Set.mem_insert _ _)

theorem t_pow_succ_mem_modelIdeal (k : ℕ) : MvPolynomial.X t ^ (k + 1) ∈ modelIdeal K k :=
  Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))

theorem x_mul_y_sub_mem_modelIdeal (k : ℕ) :
    MvPolynomial.X x * MvPolynomial.X y - MvPolynomial.X t * (1 + MvPolynomial.X w) ∈
      modelIdeal K k :=
  Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

/-- An ideal of `Ambient K` contains `modelIdeal K k` if and only if it contains the three defining
relations `w w⁻¹ - 1`, `t ^ (k + 1)`, and `x y - t (1 + w)`. -/
theorem modelIdeal_le_iff (k : ℕ) {I : Ideal (Ambient K)} :
    modelIdeal K k ≤ I ↔ MvPolynomial.X w * MvPolynomial.X wInv - 1 ∈ I ∧
      MvPolynomial.X t ^ (k + 1) ∈ I ∧
      MvPolynomial.X x * MvPolynomial.X y - MvPolynomial.X t * (1 + MvPolynomial.X w) ∈ I := by
  rw [modelIdeal, Ideal.span_le]; simp [Set.insert_subset_iff]

/-- The focus-focus model algebra `K[t, w^{±1}, x, y] / (t^{k + 1}, x y - t (1 + w))` at
order `k`. -/
abbrev ModelAlgebra (k : ℕ) := Ambient K ⧸ modelIdeal K k

/-- The residue class of an ambient coordinate in a quotient of `Ambient K`. -/
def coordinate (I : Ideal (Ambient K)) (c : Coordinate) : Ambient K ⧸ I :=
  Ideal.Quotient.mk I (MvPolynomial.X c)

/-- Unfold `coordinate K I c` to its quotient representative
`Ideal.Quotient.mk I (MvPolynomial.X c)`. -/
theorem coordinate_def (I : Ideal (Ambient K)) (c : Coordinate) :
    coordinate K I c = Ideal.Quotient.mk I (MvPolynomial.X c) := (rfl)

@[simp] theorem coordinate_w_mul_wInv (k : ℕ) :
    coordinate K (modelIdeal K k) w * coordinate K (modelIdeal K k) wInv = 1 := by
  rw [coordinate_def, coordinate_def, ← map_mul,
    ← map_one (Ideal.Quotient.mk (modelIdeal K k)), Ideal.Quotient.eq]
  exact w_mul_wInv_sub_one_mem_modelIdeal K k

/-- The tangential coordinate `w` as a unit of `ModelAlgebra K k`, with inverse `w⁻¹`. -/
def modelW (k : ℕ) : (ModelAlgebra K k)ˣ :=
  Units.mkOfMulEqOne (coordinate K (modelIdeal K k) w) (coordinate K (modelIdeal K k) wInv)
    (coordinate_w_mul_wInv K k)

@[simp] theorem val_modelW (k : ℕ) :
    ((modelW K k : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) = coordinate K (modelIdeal K k) w :=
  (rfl)

@[simp] theorem val_inv_modelW (k : ℕ) :
    (((modelW K k)⁻¹ : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) =
      coordinate K (modelIdeal K k) wInv := (rfl)

/-- A monoid homomorphism sending `w` to a unit `u` sends `modelW K k ^ b` to `u ^ b`. -/
theorem map_modelW_zpow {M F : Type*} [Monoid M] (k : ℕ)
    [FunLike F (ModelAlgebra K k) M] [MonoidHomClass F (ModelAlgebra K k) M]
    (f : F) (u : Mˣ) (hu : f (coordinate K (modelIdeal K k) w) = u) (b : ℤ) :
    f ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) = ((u ^ b : Mˣ) : M) := by
  have hmap : Units.map (f : ModelAlgebra K k →* M) (modelW K k) = u := Units.ext hu
  rw [← hmap, ← map_zpow, Units.coe_map, MonoidHom.coe_ofClass]

@[simp] theorem coordinate_t_pow_succ_eq_zero (k : ℕ) :
    coordinate K (modelIdeal K k) t ^ (k + 1) = 0 := by
  rw [coordinate_def, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact t_pow_succ_mem_modelIdeal K k

@[simp] theorem coordinate_x_mul_y (k : ℕ) :
    coordinate K (modelIdeal K k) x * coordinate K (modelIdeal K k) y =
      coordinate K (modelIdeal K k) t * (1 + coordinate K (modelIdeal K k) w) := by
  rw [coordinate_def, coordinate_def, coordinate_def, coordinate_def, ← map_mul,
    ← map_one (Ideal.Quotient.mk _), ← map_add, ← map_mul, Ideal.Quotient.eq]
  exact x_mul_y_sub_mem_modelIdeal K k

/-- Construct a `K`-algebra homomorphism out of `ModelAlgebra K k` from five coordinate images
satisfying `w' * wInv' = 1`, `t' ^ (k + 1) = 0`, and `x' * y' = t' * (1 + w')`. -/
def liftAlgHom (k : ℕ) {A : Type*} [CommSemiring A] [Algebra K A] (t' w' wInv' x' y' : A)
    (hw : w' * wInv' = 1) (ht : t' ^ (k + 1) = 0) (hxy : x' * y' = t' * (1 + w')) :
    ModelAlgebra K k →ₐ[K] A :=
  let φ : Coordinate → A := fun | t => t' | w => w' | wInv => wInv' | x => x' | y => y'
  Ideal.Quotient.liftₐ (modelIdeal K k) (MvPolynomial.aeval φ) (fun _ ha => by
    have hsub : ∀ {a b : Ambient K}, MvPolynomial.aeval φ a = MvPolynomial.aeval φ b →
        MvPolynomial.aeval φ (a - b) = 0 := fun {a b} h => by
      calc MvPolynomial.aeval φ (a - b)
          = MvPolynomial.aeval φ a + MvPolynomial.aeval φ (-1) * MvPolynomial.aeval φ b := by
            rw [sub_eq_add_neg, ← neg_one_mul b, map_add, map_mul]
        _ = (MvPolynomial.aeval φ 1 + MvPolynomial.aeval φ (-1)) * MvPolynomial.aeval φ b := by
            rw [h, map_one, add_mul, one_mul]
        _ = 0 := by rw [← map_add, add_neg_cancel, map_zero, zero_mul]
    have hle : modelIdeal K k ≤ RingHom.ker (MvPolynomial.aeval φ).toRingHom := by
      rw [modelIdeal_le_iff]
      refine ⟨RingHom.mem_ker.mpr <| hsub (by simpa [φ] using hw),
        by simp [φ, ht],
        RingHom.mem_ker.mpr <| hsub (by simpa [φ] using hxy)⟩
    exact RingHom.mem_ker.mp (hle ha))

@[simp] theorem liftAlgHom_coordinate (k : ℕ) {A : Type*} [CommSemiring A] [Algebra K A]
    (t' w' wInv' x' y' : A) (hw : w' * wInv' = 1) (ht : t' ^ (k + 1) = 0)
    (hxy : x' * y' = t' * (1 + w')) (c : Coordinate) :
    liftAlgHom K k t' w' wInv' x' y' hw ht hxy (coordinate K (modelIdeal K k) c) =
      match c with | t => t' | w => w' | wInv => wInv' | x => x' | y => y' :=
  MvPolynomial.aeval_X _ c

/-- Two `K`-algebra homomorphisms out of `ModelAlgebra K k` agree if they agree on the five
coordinates `t`, `w`, `wInv`, `x`, `y`. -/
@[ext] theorem algHom_ext {A : Type*} [Semiring A] [Algebra K A] {k : ℕ}
    {f g : ModelAlgebra K k →ₐ[K] A}
    (ht : f (coordinate K (modelIdeal K k) t) = g (coordinate K (modelIdeal K k) t))
    (hw : f (coordinate K (modelIdeal K k) w) = g (coordinate K (modelIdeal K k) w))
    (hwInv : f (coordinate K (modelIdeal K k) wInv) = g (coordinate K (modelIdeal K k) wInv))
    (hx : f (coordinate K (modelIdeal K k) x) = g (coordinate K (modelIdeal K k) x))
    (hy : f (coordinate K (modelIdeal K k) y) = g (coordinate K (modelIdeal K k) y)) :
    f = g := by
  apply Ideal.Quotient.algHom_ext; apply MvPolynomial.algHom_ext; intro c; cases c <;> assumption

/-- The model theta element `ϑ_{n,b}` in `ModelAlgebra K k`, equal to `x^{-n} w^b` for `n < 0`,
`w^b` for `n = 0`, and `y^n w^b` for `n > 0`. -/
def modelTheta (k : ℕ) (n b : ℤ) : ModelAlgebra K k :=
  (if n < 0 then coordinate K (modelIdeal K k) x ^ n.natAbs
    else coordinate K (modelIdeal K k) y ^ n.natAbs) *
    ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)

theorem modelTheta_def (k : ℕ) (n b : ℤ) :
    modelTheta K k n b =
      (if n < 0 then coordinate K (modelIdeal K k) x ^ n.natAbs
        else coordinate K (modelIdeal K k) y ^ n.natAbs) *
        ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := (rfl)

theorem modelTheta_of_neg (k : ℕ) {n : ℤ} (hn : n < 0) (b : ℤ) :
    modelTheta K k n b = coordinate K (modelIdeal K k) x ^ n.natAbs *
      ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := by simp [modelTheta_def, hn]

theorem modelTheta_of_nonneg (k : ℕ) {n : ℤ} (hn : 0 ≤ n) (b : ℤ) :
    modelTheta K k n b = coordinate K (modelIdeal K k) y ^ n.natAbs *
      ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := by
  simp [modelTheta_def, not_lt.mpr hn]

@[simp] theorem modelTheta_zero_left (k : ℕ) (b : ℤ) :
    modelTheta K k 0 b = ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := by
  simp [modelTheta_def]

theorem modelTheta_zero (k : ℕ) : modelTheta K k 0 0 = 1 := by simp

@[simp] theorem modelTheta_natCast (k : ℕ) (a : ℕ) (b : ℤ) :
    modelTheta K k (a : ℤ) b = coordinate K (modelIdeal K k) y ^ a *
      ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := by
  rw [modelTheta_of_nonneg K k (Int.natCast_nonneg a), Int.natAbs_natCast]

@[simp] theorem modelTheta_neg_natCast (k : ℕ) (a : ℕ) (b : ℤ) :
    modelTheta K k (-(a : ℤ)) b = coordinate K (modelIdeal K k) x ^ a *
      ((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k) := by
  rcases eq_or_ne a 0 with rfl | ha <;>
    [simp; rw [modelTheta_of_neg K k (by omega), Int.natAbs_neg, Int.natAbs_natCast]]

/-! ### Identification with `NodeAlgebra` over `(K[t] / (t^{k + 1}))[w, w⁻¹]` -/

/-- The truncated polynomial base ring `K[t] / (t ^ (k + 1))` at order `k`. -/
abbrev BaseRing (k : ℕ) := AdjoinRoot (Polynomial.X ^ (k + 1) : Polynomial K)

/-- Canonical `K`-algebra homomorphism embedding `BaseRing K k = K[t] / (t ^ (k + 1))` into
`ModelAlgebra K k` by sending the root `t` to `coordinate K (modelIdeal K k) t`. -/
def baseToModel (k : ℕ) : BaseRing K k →ₐ[K] ModelAlgebra K k :=
  AdjoinRoot.liftAlgHom (Polynomial.X ^ (k + 1) : Polynomial K)
    (Algebra.ofId K (ModelAlgebra K k)) (coordinate K (modelIdeal K k) t) (by simp)

@[simp] theorem baseToModel_root (k : ℕ) :
    baseToModel K k (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)) =
      coordinate K (modelIdeal K k) t :=
  AdjoinRoot.liftAlgHom_root _ _ _ _

/-- `BaseRing K k`-algebra structure on `ModelAlgebra K k` sending `AdjoinRoot.root _` to
`coordinate K (modelIdeal K k) t`. -/
instance instAlgebraBaseRing (k : ℕ) : Algebra (BaseRing K k) (ModelAlgebra K k) :=
  RingHom.toAlgebra (baseToModel K k).toRingHom

instance instIsScalarTowerBaseRing (k : ℕ) :
    IsScalarTower K (BaseRing K k) (ModelAlgebra K k) :=
  IsScalarTower.of_algebraMap_eq' (baseToModel K k).comp_algebraMap.symm

@[simp] theorem algebraMap_baseRing_apply (k : ℕ) (a : BaseRing K k) :
    algebraMap (BaseRing K k) (ModelAlgebra K k) a = baseToModel K k a := (rfl)

/-- The focus-focus slab parameter `t (1 + w)` in `(BaseRing K k)[T;T⁻¹]`. -/
def slabParam (k : ℕ) : (BaseRing K k)[T;T⁻¹] :=
  C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)) * (1 + T 1)

/-- Unfold the focus-focus slab parameter `slabParam K k = t (1 + w)`. -/
theorem slabParam_def (k : ℕ) :
    slabParam K k = C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)) * (1 + T 1) :=
  (rfl)

private abbrev TargetSlab (k : ℕ) := NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)

private def modelToSlab (k : ℕ) : ModelAlgebra K k →ₐ[K] TargetSlab K k :=
  liftAlgHom K k
    (algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k)
      (C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K))))
    (algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T 1))
    (algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T (-1)))
    (NodeAlgebra.coord (slabParam K k) 0) (NodeAlgebra.coord (slabParam K k) 1)
    (by rw [← map_mul, ← T_add]; simp)
    (by
      have hroot : AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K) ^ (k + 1) = 0 := by
        simpa using AdjoinRoot.eval₂_root (Polynomial.X ^ (k + 1) : Polynomial K)
      rw [← map_pow, ← map_pow, hroot, map_zero, map_zero])
    (by simp [NodeAlgebra.coord_zero_mul_coord_one, slabParam_def])

private theorem modelToSlab_baseToModel (k : ℕ) (a : BaseRing K k) :
    modelToSlab K k (baseToModel K k a) =
      algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (C a) :=
  AlgHom.congr_fun (AdjoinRoot.algHom_ext
    (g₁ := (modelToSlab K k).comp (baseToModel K k))
    (g₂ := (IsScalarTower.toAlgHom K (BaseRing K k)[T;T⁻¹] (TargetSlab K k)).comp
      (IsScalarTower.toAlgHom K (BaseRing K k) (BaseRing K k)[T;T⁻¹])) (by
      simp only [AlgHom.comp_apply, IsScalarTower.coe_toAlgHom', baseToModel_root, modelToSlab,
        liftAlgHom_coordinate, C_eq_algebraMap])) a

private def modelToSlabBase (k : ℕ) : ModelAlgebra K k →ₐ[BaseRing K k] TargetSlab K k where
  toRingHom := (modelToSlab K k).toRingHom
  commutes' a := by
    rw [RingHom.toFun_eq_coe, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, algebraMap_baseRing_apply,
      modelToSlab_baseToModel,
      IsScalarTower.algebraMap_apply (BaseRing K k) (BaseRing K k)[T;T⁻¹], C_eq_algebraMap]

private theorem modelToSlabBase_apply (k : ℕ) (u : ModelAlgebra K k) :
    modelToSlabBase K k u = modelToSlab K k u := (rfl)

private def slabToModelBase (k : ℕ) : TargetSlab K k →ₐ[BaseRing K k] ModelAlgebra K k where
  toRingHom := NodeAlgebra.liftRingHom (eval₂ (baseToModel K k).toRingHom (modelW K k))
    (coordinate K (modelIdeal K k) x) (coordinate K (modelIdeal K k) y) (by
      rw [slabParam_def, map_mul, map_add, map_one, eval₂_C, eval₂_T,
        AlgHom.toRingHom_eq_coe, RingHom.coe_coe, baseToModel_root, zpow_one, val_modelW]
      exact coordinate_x_mul_y K k)
  commutes' a := by
    rw [IsScalarTower.algebraMap_apply (BaseRing K k) (BaseRing K k)[T;T⁻¹],
      RingHom.toFun_eq_coe, NodeAlgebra.liftRingHom_algebraMap, ← C_eq_algebraMap, eval₂_C,
      AlgHom.toRingHom_eq_coe, RingHom.coe_coe, algebraMap_baseRing_apply]

private theorem modelToSlab_modelW_zpow (k : ℕ) (n : ℤ) :
    modelToSlab K k (((modelW K k ^ n : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)) =
      algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T n) := by
  let u : (TargetSlab K k)ˣ :=
    Units.map (algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k)).toMonoidHom
      (LaurentPolynomial.genericUnit (BaseRing K k))
  rw [map_modelW_zpow K k (modelToSlab K k) u (by simp [u, modelToSlab]) n,
    ← map_zpow, Units.coe_map, LaurentPolynomial.genericUnit_zpow_val]; simp

/-- Canonical `BaseRing K k`-algebra isomorphism between `ModelAlgebra K k` and the nodal slab
algebra `NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)`. -/
def modelSlabEquivBase (k : ℕ) :
    ModelAlgebra K k ≃ₐ[BaseRing K k] NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k) :=
  AlgEquiv.ofAlgHom (modelToSlabBase K k) (slabToModelBase K k)
    (NodeAlgebra.algHom_ext_of_algebra (fun p => by
      simp only [AlgHom.comp_apply, AlgHom.id_apply, modelToSlabBase_apply, slabToModelBase,
        AlgHom.coe_mk, NodeAlgebra.liftRingHom_algebraMap]
      induction p using AddMonoidAlgebra.induction_linear with
      | zero => simp
      | add f g hf hg => rw [map_add, map_add, hf, hg, map_add]
      | single n a =>
        rw [single_eq_C_mul_T, map_mul, map_mul, eval₂_C, eval₂_T, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe, modelToSlab_baseToModel, modelToSlab_modelW_zpow, ← map_mul])
      (by simp [modelToSlabBase_apply, modelToSlab, slabToModelBase])
      (by simp [modelToSlabBase_apply, modelToSlab, slabToModelBase]))
    (AlgHom.restrictScalars_injective K <| by
      refine algHom_ext K ?_ ?_ ?_ ?_ ?_ <;>
        simp [modelToSlabBase_apply, modelToSlab, slabToModelBase])

/-- Canonical `K`-algebra isomorphism between `ModelAlgebra K k` and the nodal slab
algebra `NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)` over `K[t] / (t ^ (k + 1))`. -/
def modelSlabEquiv (k : ℕ) :
    ModelAlgebra K k ≃ₐ[K] NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k) :=
  (modelSlabEquivBase K k).restrictScalars K

/-- `modelSlabEquiv K k` is the restriction of scalars of `modelSlabEquivBase K k` from
`BaseRing K k` to `K`. -/
theorem modelSlabEquiv_eq_restrictScalars (k : ℕ) :
    modelSlabEquiv K k = (modelSlabEquivBase K k).restrictScalars K := (rfl)

/-- `modelSlabEquivBase` and `modelSlabEquiv` have the same underlying function. -/
@[simp] theorem modelSlabEquivBase_apply (k : ℕ) (u : ModelAlgebra K k) :
    modelSlabEquivBase K k u = modelSlabEquiv K k u := (rfl)

/-- `(modelSlabEquivBase K k).symm` and `(modelSlabEquiv K k).symm` have the same underlying
function. -/
@[simp] theorem modelSlabEquivBase_symm_apply (k : ℕ)
    (u : NodeAlgebra (BaseRing K k)[T;T⁻¹] (slabParam K k)) :
    (modelSlabEquivBase K k).symm u = (modelSlabEquiv K k).symm u := (rfl)

private theorem modelSlabEquiv_apply (k : ℕ) (u : ModelAlgebra K k) :
    modelSlabEquiv K k u = modelToSlab K k u := (rfl)

@[simp] theorem modelSlabEquiv_coordinate_t (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) t) =
      algebraMap (BaseRing K k)[T;T⁻¹] _
        (C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K))) := by
  rw [modelSlabEquiv_apply, modelToSlab, liftAlgHom_coordinate]

@[simp] theorem modelSlabEquiv_coordinate_w (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) w) =
      algebraMap (BaseRing K k)[T;T⁻¹] _ (T 1) := by
  rw [modelSlabEquiv_apply, modelToSlab, liftAlgHom_coordinate]

@[simp] theorem modelSlabEquiv_coordinate_wInv (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) wInv) =
      algebraMap (BaseRing K k)[T;T⁻¹] _ (T (-1)) := by
  rw [modelSlabEquiv_apply, modelToSlab, liftAlgHom_coordinate]

@[simp] theorem modelSlabEquiv_coordinate_x (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) x) = NodeAlgebra.coord (slabParam K k) 0 := by
  rw [modelSlabEquiv_apply, modelToSlab, liftAlgHom_coordinate]

@[simp] theorem modelSlabEquiv_coordinate_y (k : ℕ) :
    modelSlabEquiv K k (coordinate K (modelIdeal K k) y) = NodeAlgebra.coord (slabParam K k) 1 := by
  rw [modelSlabEquiv_apply, modelToSlab, liftAlgHom_coordinate]

@[simp] theorem modelSlabEquiv_modelW_zpow (k : ℕ) (b : ℤ) :
    modelSlabEquiv K k (((modelW K k ^ b : (ModelAlgebra K k)ˣ) : ModelAlgebra K k)) =
      algebraMap (BaseRing K k)[T;T⁻¹] _ (T b) :=
  (modelSlabEquiv_apply K k _).trans (modelToSlab_modelW_zpow K k b)

/-- Image of `modelTheta K k n b` under `modelSlabEquiv K k`: it equals the slab basis element
`NodeAlgebra.Z (slabParam K k) n` multiplied by the tangential Laurent monomial `T b`. -/
@[simp] theorem modelSlabEquiv_modelTheta (k : ℕ) (n b : ℤ) :
    modelSlabEquiv K k (modelTheta K k n b) =
      NodeAlgebra.Z (slabParam K k) n *
        algebraMap (BaseRing K k)[T;T⁻¹] _ (T b) := by
  rw [modelTheta_def, map_mul, modelSlabEquiv_modelW_zpow]
  split_ifs with hn
  · simp [NodeAlgebra.Z_of_neg (slabParam K k) hn]
  · simp [NodeAlgebra.Z_of_nonneg (slabParam K k) (not_lt.mp hn)]

@[simp] theorem modelSlabEquiv_symm_Z_mul_T (k : ℕ) (n b : ℤ) :
    (modelSlabEquiv K k).symm (NodeAlgebra.Z (slabParam K k) n *
        algebraMap (BaseRing K k)[T;T⁻¹] _ (T b)) =
      modelTheta K k n b := by
  rw [← modelSlabEquiv_modelTheta, AlgEquiv.symm_apply_apply]

/-! ### Module freeness and the `K`-basis `t^i ϑ_{n,b}` -/

/-- `ModelAlgebra K k` is a free `K`-module for every commutative ring `K` and order `k`. -/
instance instModuleFree (k : ℕ) : Module.Free K (ModelAlgebra K k) :=
  have := AdjoinRoot.free_X_pow (R := K) (k + 1)
  have : Module.Free (BaseRing K k) (BaseRing K k)[T;T⁻¹] := .of_basis (AddMonoidAlgebra.basis _ _)
  have : Module.Free (BaseRing K k) (TargetSlab K k) := .trans (S := (BaseRing K k)[T;T⁻¹])
  have : Module.Free K (TargetSlab K k) := .trans (S := BaseRing K k)
  .of_equiv (modelSlabEquiv K k).symm.toLinearEquiv

private def baseBasis [Nontrivial K] (k : ℕ) : Module.Basis (Fin (k + 1)) K (BaseRing K k) :=
  (AdjoinRoot.powerBasis'
    (Polynomial.monic_X_pow (k + 1) : (Polynomial.X ^ (k + 1) : Polynomial K).Monic)).basis.reindex
    (finCongr (by simp [AdjoinRoot.powerBasis']))

private theorem baseBasis_apply [Nontrivial K] (k : ℕ) (i : Fin (k + 1)) :
    baseBasis K k i = AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K) ^ (i : ℕ) := by
  simp [baseBasis]

private def tangentialSlabBasis (k : ℕ) :
    Module.Basis (ℤ × ℤ) (BaseRing K k) (TargetSlab K k) :=
  (AddMonoidAlgebra.basis ℤ (BaseRing K k)).smulTower' (NodeAlgebra.slabBasis (slabParam K k))

private theorem tangentialSlabBasis_apply (k : ℕ) (n b : ℤ) :
    tangentialSlabBasis K k (n, b) = NodeAlgebra.Z (slabParam K k) n *
      algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T b) := by
  rw [tangentialSlabBasis, Module.Basis.smulTower'_apply, AddMonoidAlgebra.basis_apply,
    NodeAlgebra.slabBasis_apply, Algebra.smul_def, single_eq_C_mul_T, map_one, one_mul, mul_comm]

/-- Over any nontrivial commutative ring `K`, the monomials `t^i * ϑ_{n,b}`
(`i : Fin (k + 1)`, `n b : ℤ`) form a `K`-basis of `ModelAlgebra K k`. -/
def modelBasis [Nontrivial K] (k : ℕ) :
    Module.Basis (Fin (k + 1) × ℤ × ℤ) K (ModelAlgebra K k) :=
  ((baseBasis K k).smulTower (tangentialSlabBasis K k)).map
    (modelSlabEquiv K k).symm.toLinearEquiv

@[simp] theorem modelBasis_apply [Nontrivial K] (k : ℕ) (i : Fin (k + 1)) (n b : ℤ) :
    modelBasis K k (i, n, b) =
      coordinate K (modelIdeal K k) t ^ (i : ℕ) * modelTheta K k n b := by
  apply (modelSlabEquiv K k).injective
  simp [modelBasis, baseBasis_apply, tangentialSlabBasis_apply, Algebra.smul_def,
    IsScalarTower.algebraMap_apply (BaseRing K k) (BaseRing K k)[T;T⁻¹] (TargetSlab K k)]

/-- Over a nontrivial commutative ring `K`, every theta basis element `modelTheta K k n b` is
nonzero in `ModelAlgebra K k`. -/
theorem modelTheta_ne_zero [Nontrivial K] (k : ℕ) (n b : ℤ) : modelTheta K k n b ≠ 0 := by
  simpa using (modelBasis K k).ne_zero (0, n, b)

/-! ### The focus-focus theta multiplication formula -/

/-- **Focus-focus theta multiplication formula**: for `r = (|n| + |m| - |n + m|) / 2`,
`ϑ_{n,b} * ϑ_{m,c} = t^r * ∑_{j = 0}^r binom(r, j) ϑ_{n + m, b + c + j}`
in `ModelAlgebra K k`. -/
theorem modelTheta_mul (k : ℕ) (n m b c : ℤ) :
    let r := (n.natAbs + m.natAbs - (n + m).natAbs) / 2
    modelTheta K k n b * modelTheta K k m c = coordinate K (modelIdeal K k) t ^ r *
      ∑ j ∈ Finset.range (r + 1), (r.choose j : ModelAlgebra K k) *
        modelTheta K k (n + m) (b + c + j) := by
  intro r; apply (modelSlabEquiv K k).injective
  have hparam : slabParam K k ^ r * (T b * T c) =
      C (AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)) ^ r *
        ∑ j ∈ Finset.range (r + 1),
          (r.choose j : (BaseRing K k)[T;T⁻¹]) * T (b + c + j) := by
    rw [slabParam_def, mul_pow, ← T_add, mul_assoc, LaurentPolynomial.one_add_T_pow_mul_T]
    simp_rw [mul_one]
  calc modelSlabEquiv K k (modelTheta K k n b * modelTheta K k m c)
      = (NodeAlgebra.Z (slabParam K k) n * NodeAlgebra.Z (slabParam K k) m) *
          algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (T b * T c) := by
        rw [map_mul, modelSlabEquiv_modelTheta, modelSlabEquiv_modelTheta, map_mul]; ring
    _ = algebraMap (BaseRing K k)[T;T⁻¹] (TargetSlab K k) (slabParam K k ^ r * (T b * T c)) *
          NodeAlgebra.Z (slabParam K k) (n + m) := by simp only [NodeAlgebra.Z_mul, map_mul]; ring
    _ = modelSlabEquiv K k (coordinate K (modelIdeal K k) t ^ r * ∑ j ∈ Finset.range (r + 1),
          (r.choose j : ModelAlgebra K k) * modelTheta K k (n + m) (b + c + j)) := by
        rw [hparam]; simp only [map_mul, map_pow, map_sum, map_natCast, modelSlabEquiv_coordinate_t,
          modelSlabEquiv_modelTheta, Finset.mul_sum, Finset.sum_mul]
        exact Finset.sum_congr rfl fun j _ => by ring

/-- Positivity of the focus-focus theta structure constants: every coefficient in
`modelTheta_mul` is the evaluation at `t` of
`Polynomial.monomial r (r.choose j) : Polynomial ℕ`. -/
theorem modelTheta_mul_eval₂_nat (k : ℕ) (n m b c : ℤ) :
    let r := (n.natAbs + m.natAbs - (n + m).natAbs) / 2
    modelTheta K k n b * modelTheta K k m c = ∑ j ∈ Finset.range (r + 1),
      Polynomial.eval₂ (Nat.castRingHom (ModelAlgebra K k)) (coordinate K (modelIdeal K k) t)
        (Polynomial.monomial r (r.choose j)) * modelTheta K k (n + m) (b + c + j) := by
  intro r; rw [modelTheta_mul K k n m b c, Finset.mul_sum]
  exact Finset.sum_congr rfl fun j _ => by simp only [Polynomial.eval₂_monomial, eq_natCast]; ring

/-- Opposite-ray product check: `ϑ_{-1, 0} * ϑ_{1, 0} = t * ϑ_{0, 0} + t * ϑ_{0, 1}`
(for instance over `K = ℤ` at order `k = 2`). -/
theorem modelTheta_neg_one_mul_one (k : ℕ) :
    modelTheta K k (-1) 0 * modelTheta K k 1 0 =
      coordinate K (modelIdeal K k) t * modelTheta K k 0 0 +
        coordinate K (modelIdeal K k) t * modelTheta K k 0 1 := by
  rw [modelTheta_mul K k (-1) 1 0 0]; simp [Finset.sum_range_succ, mul_add]

end

/-! ### Functoriality in the coefficient ring `K` and order truncation `k' ≤ k` -/

/-- Mapping coefficients along `φ : K →+* K'` carries `modelIdeal K k` into `modelIdeal K' k`. -/
theorem modelIdeal_le_comap_map {K K' : Type*} [CommRing K] [CommRing K'] (φ : K →+* K')
    (k : ℕ) : modelIdeal K k ≤ (modelIdeal K' k).comap (MvPolynomial.map φ) :=
  (modelIdeal_le_iff K k).mpr
    ⟨by simpa [Ideal.mem_comap] using w_mul_wInv_sub_one_mem_modelIdeal K' k,
      by simpa [Ideal.mem_comap] using t_pow_succ_mem_modelIdeal K' k,
      by simpa [Ideal.mem_comap] using x_mul_y_sub_mem_modelIdeal K' k⟩

/-- Ring homomorphism `ModelAlgebra K k →+* ModelAlgebra K' k` induced by a scalar ring
homomorphism `φ : K →+* K'`. -/
def mapRingHom {K K' : Type*} [CommRing K] [CommRing K'] (φ : K →+* K') (k : ℕ) :
    ModelAlgebra K k →+* ModelAlgebra K' k :=
  Ideal.quotientMap (modelIdeal K' k) (MvPolynomial.map φ) (modelIdeal_le_comap_map φ k)

@[simp] theorem mapRingHom_coordinate {K K' : Type*} [CommRing K] [CommRing K']
    (φ : K →+* K') (k : ℕ) (c : Coordinate) :
    mapRingHom φ k (coordinate K (modelIdeal K k) c) = coordinate K' (modelIdeal K' k) c := by
  rw [mapRingHom, coordinate_def, Ideal.quotientMap_mk, MvPolynomial.map_X, coordinate_def]

@[simp] theorem mapRingHom_algebraMap {K K' : Type*} [CommRing K] [CommRing K']
    (φ : K →+* K') (k : ℕ) (r : K) :
    mapRingHom φ k (algebraMap K (ModelAlgebra K k) r) =
      algebraMap K' (ModelAlgebra K' k) (φ r) := by
  simp [mapRingHom, IsScalarTower.algebraMap_apply K (Ambient K),
    IsScalarTower.algebraMap_apply K' (Ambient K'), MvPolynomial.algebraMap_eq]

private theorem map_modelTheta_of_coordinate {K K' : Type*} [CommRing K] [CommRing K']
    {k k' : ℕ} (f : ModelAlgebra K k →+* ModelAlgebra K' k')
    (hc : ∀ c, f (coordinate K (modelIdeal K k) c) = coordinate K' (modelIdeal K' k') c)
    (n b : ℤ) : f (modelTheta K k n b) = modelTheta K' k' n b := by
  rw [modelTheta_def, modelTheta_def, map_mul, map_modelW_zpow K k f (modelW K' k') (hc w) b]
  split_ifs <;> simp [hc]

@[simp] theorem mapRingHom_modelTheta {K K' : Type*} [CommRing K] [CommRing K']
    (φ : K →+* K') (k : ℕ) (n b : ℤ) :
    mapRingHom φ k (modelTheta K k n b) = modelTheta K' k n b :=
  map_modelTheta_of_coordinate (mapRingHom φ k) (mapRingHom_coordinate φ k) n b

@[simp] theorem mapRingHom_id (K : Type*) [CommRing K] (k : ℕ) :
    mapRingHom (RingHom.id K) k = RingHom.id (ModelAlgebra K k) :=
  Ideal.Quotient.ringHom_ext <| MvPolynomial.ringHom_ext
    (mapRingHom_algebraMap (RingHom.id K) k) (mapRingHom_coordinate (RingHom.id K) k)

theorem mapRingHom_comp {K K' K'' : Type*} [CommRing K] [CommRing K'] [CommRing K'']
    (ψ : K' →+* K'') (φ : K →+* K') (k : ℕ) :
    mapRingHom (ψ.comp φ) k = (mapRingHom ψ k).comp (mapRingHom φ k) :=
  Ideal.Quotient.ringHom_ext <| MvPolynomial.ringHom_ext
    (fun r => by simp [mapRingHom]) (fun c => by simp [mapRingHom])

/-- The focus-focus model ideals are antitone in the truncation order `k`. -/
theorem modelIdeal_anti (K : Type*) [CommRing K] : Antitone (modelIdeal K) := by
  intro k' k hk; rw [modelIdeal_le_iff]
  refine ⟨w_mul_wInv_sub_one_mem_modelIdeal K k', ?_, x_mul_y_sub_mem_modelIdeal K k'⟩
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
  rw [Nat.add_right_comm, pow_add _ (k' + 1) d]
  exact Ideal.mul_mem_right _ _ (t_pow_succ_mem_modelIdeal K k')

/-- Order-truncation `K`-algebra homomorphism `ModelAlgebra K k →ₐ[K] ModelAlgebra K k'` for
`k' ≤ k`. -/
def truncAlgHom (K : Type*) [CommRing K] {k' k : ℕ} (hk : k' ≤ k) :
    ModelAlgebra K k →ₐ[K] ModelAlgebra K k' :=
  Ideal.Quotient.factorₐ K (modelIdeal_anti K hk)

@[simp] theorem truncAlgHom_coordinate (K : Type*) [CommRing K] {k' k : ℕ} (hk : k' ≤ k)
    (c : Coordinate) :
    truncAlgHom K hk (coordinate K (modelIdeal K k) c) = coordinate K (modelIdeal K k') c :=
  Ideal.Quotient.factorₐ_apply_mk K (modelIdeal_anti K hk) (MvPolynomial.X c)

@[simp] theorem truncAlgHom_modelTheta (K : Type*) [CommRing K] {k' k : ℕ} (hk : k' ≤ k)
    (n b : ℤ) : truncAlgHom K hk (modelTheta K k n b) = modelTheta K k' n b :=
  map_modelTheta_of_coordinate (truncAlgHom K hk).toRingHom (truncAlgHom_coordinate K hk) n b

@[simp] theorem truncAlgHom_refl (K : Type*) [CommRing K] (k : ℕ) :
    truncAlgHom K (le_refl k) = AlgHom.id K (ModelAlgebra K k) :=
  Ideal.Quotient.factorₐ_refl (modelIdeal K k)

theorem truncAlgHom_trans (K : Type*) [CommRing K] {k'' k' k : ℕ} (hk' : k'' ≤ k')
    (hk : k' ≤ k) :
    truncAlgHom K (hk'.trans hk) = (truncAlgHom K hk').comp (truncAlgHom K hk) :=
  (Ideal.Quotient.factorₐ_comp K (modelIdeal_anti K hk) (modelIdeal_anti K hk')).symm

/-- Naturality of `modelSlabEquiv` with respect to coefficient ring homomorphisms
`φ : K →+* K'`. -/
theorem modelSlabEquiv_mapRingHom {K K' : Type*} [CommRing K] [CommRing K']
    (φ : K →+* K') (k : ℕ) (u : ModelAlgebra K k) :
    let fBase : BaseRing K k →+* BaseRing K' k :=
      AdjoinRoot.map φ (Polynomial.X ^ (k + 1)) (Polynomial.X ^ (k + 1)) (by simp)
    let fLaur : (BaseRing K k)[T;T⁻¹] →+* (BaseRing K' k)[T;T⁻¹] :=
      AddMonoidAlgebra.mapRingHom ℤ fBase
    modelSlabEquiv K' k (mapRingHom φ k u) = NodeAlgebra.mapRingHom fLaur (by
      simp only [fLaur, slabParam_def, map_mul, map_add, map_one, ← LaurentPolynomial.single_eq_C,
        LaurentPolynomial.T, AddMonoidAlgebra.mapRingHom_single, fBase, AdjoinRoot.map_root,
        map_one]) (modelSlabEquiv K k u) := by
  intro fBase fLaur
  refine RingHom.congr_fun
    (f := (modelSlabEquiv K' k).toRingHom.comp (mapRingHom φ k))
    (g := (NodeAlgebra.mapRingHom fLaur _).comp (modelSlabEquiv K k).toRingHom)
    (Ideal.Quotient.ringHom_ext <| MvPolynomial.ringHom_ext (fun r => ?_) (fun c => ?_)) u
  · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
      AlgEquiv.coe_toRingEquiv, ← MvPolynomial.algebraMap_eq, ← Ideal.Quotient.algebraMap_eq,
      ← IsScalarTower.algebraMap_apply K (Ambient K) (ModelAlgebra K k),
      mapRingHom_algebraMap, AlgEquiv.commutes,
      IsScalarTower.algebraMap_apply K (BaseRing K k)[T;T⁻¹] (TargetSlab K k),
      IsScalarTower.algebraMap_apply K' (BaseRing K' k)[T;T⁻¹] (TargetSlab K' k),
      NodeAlgebra.mapRingHom_algebraMap,
      IsScalarTower.algebraMap_apply K (BaseRing K k) (BaseRing K k)[T;T⁻¹],
      IsScalarTower.algebraMap_apply K' (BaseRing K' k) (BaseRing K' k)[T;T⁻¹],
      ← C_eq_algebraMap, ← LaurentPolynomial.single_eq_C, AdjoinRoot.algebraMap_eq,
      fLaur, AddMonoidAlgebra.mapRingHom_single, fBase, AdjoinRoot.map_of]
  · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
      AlgEquiv.coe_toRingEquiv, ← coordinate_def, mapRingHom_coordinate]
    cases c <;> simp only [modelSlabEquiv_coordinate_t, modelSlabEquiv_coordinate_w,
      modelSlabEquiv_coordinate_wInv, modelSlabEquiv_coordinate_x, modelSlabEquiv_coordinate_y,
      NodeAlgebra.mapRingHom_algebraMap, NodeAlgebra.mapRingHom_coord,
      ← LaurentPolynomial.single_eq_C, LaurentPolynomial.T, fLaur,
      AddMonoidAlgebra.mapRingHom_single, fBase, AdjoinRoot.map_root, map_one]

/-- Naturality of `modelSlabEquiv` with respect to order truncation `k' ≤ k`. -/
theorem modelSlabEquiv_truncAlgHom (K : Type*) [CommRing K] {k' k : ℕ} (hk : k' ≤ k)
    (u : ModelAlgebra K k) :
    let fBase : BaseRing K k →ₐ[K] BaseRing K k' :=
      AdjoinRoot.algHomOfDvd K (Polynomial.X ^ (k + 1) : Polynomial K)
        (Polynomial.X ^ (k' + 1) : Polynomial K) (pow_dvd_pow _ (Nat.succ_le_succ hk))
    let fLaur : (BaseRing K k)[T;T⁻¹] →ₐ[K] (BaseRing K k')[T;T⁻¹] :=
      AddMonoidAlgebra.mapAlgHom ℤ fBase
    modelSlabEquiv K k' (truncAlgHom K hk u) = NodeAlgebra.mapAlgHom fLaur (by
      simp only [fLaur, slabParam_def, map_mul, map_add, map_one, LaurentPolynomial.mapAlgHom_C,
        LaurentPolynomial.mapAlgHom_T, fBase, AdjoinRoot.algHomOfDvd_root])
      (modelSlabEquiv K k u) := by
  intro fBase fLaur
  refine AlgHom.congr_fun (algHom_ext K
    (f := (modelSlabEquiv K k').toAlgHom.comp (truncAlgHom K hk))
    (g := (NodeAlgebra.mapAlgHom fLaur _).comp (modelSlabEquiv K k).toAlgHom)
    ?_ ?_ ?_ ?_ ?_) u <;> simp [fLaur, fBase]

end

