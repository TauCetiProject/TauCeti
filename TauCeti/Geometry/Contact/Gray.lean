/-!
# Gray stability for families of contact forms

Let `α` be a smooth one-form on `ℝ × M` whose slices `α_t = ι_t^* α`, pulled back along the
inclusions `ι_t : x ↦ (t, x)`, are contact forms on `M`. The Reeb and horizontal contact-Moser
vector fields of the slices then depend smoothly on `t`
(`TauCeti.SmoothForm.contMDiff_reebVectorField_mpullback_prodMk`,
`TauCeti.SmoothForm.contMDiff_contactMoserVectorField_mpullback_prodMk`).

This gives **Gray stability** on a compact manifold: a smooth family of contact forms
`α_t` is generated by an isotopy. Take the horizontal contact-Moser field `Y_t` of `α_t` and the
time derivative `β_t = ι_t^* L_{∂_t} α`, the unique vector field in `ker α_t` with
`(ι_{Y_t} dα_t + β_t)|ker α_t = 0`. It is jointly smooth in `(t, x)`, so on a compact manifold its
time-dependent flow `ψ_t` exists for all times and consists of diffeomorphisms. The Moser equation
makes the rate `β_t + L_{Y_t} α_t` equal to `β_t(R_{α_t}) α_t`, a multiple of `α_t`, so by Moser's
principle for families of forms
(`TauCeti.mpullback_timeDependentFlowOf_mpullback_prodMk_apply_eq_exp_integral_smul`)

`ψ_t^* α_t = exp (∫₀ᵗ β_u(R_{α_u}) ∘ ψ_u du) α_0`.

Thus every `ψ_t` is a contactomorphism from `ker α_0` to `ker α_t` preserving the coorientations
given by the forms (`TauCeti.SmoothForm.exists_isotopy_preservesCoorientation_of_isContactForm`),
and the isotopy is jointly smooth in time and space. This is Gray's theorem for a smooth family of
contact forms on a compact manifold; the version relative to a closed subset, for contact
structures without a global defining family of forms, is not treated here.

## Main results

* `TauCeti.SmoothForm.exists_isotopy_preservesCoorientation_of_isContactForm`: **Gray stability.**
  On a compact boundaryless manifold, a smooth family `α_t` of contact forms admits a smooth
  isotopy `ψ_t` with `ψ_0 = id` and `ψ_t^* α_t` a positive multiple of `α_0` at every point.
* `TauCeti.SmoothForm.exists_isotopy_isContactomorphism_of_isContactForm`: in particular each
  `ψ_t` carries the contact structure `ker α_0` to `ker α_t`.

## References

* J. W. Gray, *Some global properties of contact structures*, Annals of Mathematics 69 (1959),
  421–450.
* H. Geiges, *An Introduction to Contact Topology*, Cambridge University Press, 2008,
  Theorem 2.2.2 and its proof.
-/

public section

noncomputable section

open Bundle Set Function
open scoped ContDiff Manifold Topology

namespace TauCeti.SmoothForm

variable {E H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]

/-! ### Gray stability -/

section Gray

/-- The unit vector field `∂_t` of the time coordinate of `ℝ × M`, as a smooth section. -/
private def unitTimeField :
    Cₛ^∞⟮𝓘(ℝ, ℝ).prod I; ℝ × E, TangentSpace (𝓘(ℝ, ℝ).prod I) (M := ℝ × M)⟯ :=
  ⟨fun _ ↦ ((1 : ℝ), (0 : E)), contMDiff_const_prod_field (X := 0) 1
    ((contMDiff_zeroSection ℝ (TangentSpace I)).comp contMDiff_snd)⟩

/-- The function `α(∂_t)` of a smooth one-form on `ℝ × M` is smooth. -/
private theorem contMDiff_interior_unitTimeField (α : SmoothForm (𝓘(ℝ, ℝ).prod I) (ℝ × M) ℝ 1) :
    ContMDiff (𝓘(ℝ, ℝ).prod I) 𝓘(ℝ, ℝ) ∞
      fun p ↦ RoughForm.interior (unitTimeField (I := I)) α.1 p 0 := by
  have h := (degreeOneEquiv α).contMDiff.clm_bundle_apply (unitTimeField (I := I)).contMDiff
  intro p
  refine ((contMDiffAt_totalSpace.1 (h p)).2.congr_of_eventuallyEq
    (.of_forall fun q ↦ ?_))
  simp only [Trivial.eq_trivialization, Trivial.trivialization_apply]
  rw [RoughForm.interior_apply, degreeOneEquiv_apply_apply_vec]
  congr 1
  funext i
  fin_cases i
  -- Both sides are the value `(1, 0)` of the unit time field.
  rfl

/-- The function `α(∂_t)` of a smooth one-form on `ℝ × M`, as a smooth `0`-form. -/
private def timeComponent (α : SmoothForm (𝓘(ℝ, ℝ).prod I) (ℝ × M) ℝ 1) :
    SmoothForm (𝓘(ℝ, ℝ).prod I) (ℝ × M) ℝ 0 :=
  ⟨RoughForm.interior unitTimeField α.1, by
    rw [RoughForm.eq_ofFunction (RoughForm.interior _ _)]
    exact (isSmoothForm_ofFunction_iff.mpr
      (contMDiff_interior_unitTimeField α)).mem_smoothBundleForms⟩

/-- The time derivative `L_{∂_t} α` of a smooth one-form `α` on `ℝ × M`, as a smooth one-form,
assembled by Cartan's formula `L_{∂_t} α = ι_{∂_t} dα + d(α(∂_t))`. -/
private def timeDerivative (α : SmoothForm (𝓘(ℝ, ℝ).prod I) (ℝ × M) ℝ 1) :
    SmoothForm (𝓘(ℝ, ℝ).prod I) (ℝ × M) ℝ 1 :=
  SmoothTwoForm.interiorₗ (mextDerivₗ (𝓘(ℝ, ℝ).prod I) 1 α) unitTimeField +
    mextDerivₗ (𝓘(ℝ, ℝ).prod I) 0 (timeComponent α)

private theorem coe_unitTimeField :
    ⇑(unitTimeField (I := I) (M := M)) = fun _ ↦ ((1 : ℝ), (0 : E)) :=
  (rfl)

private theorem coe_timeDerivative (α : SmoothForm (𝓘(ℝ, ℝ).prod I) (ℝ × M) ℝ 1) :
    (timeDerivative α).1 = mlieDerivForm (unitTimeField (I := I)) α.1 := by
  rw [SmoothForm.mlieDerivForm_eq_interior_mextDeriv_add (φ := α)
    ((unitTimeField (I := I)).contMDiff.mdifferentiable (by simp)), timeDerivative,
    Submodule.coe_add, SmoothTwoForm.coe_interiorₗ, mextDerivₗ_apply, mextDerivₗ_apply]
  -- The `0`-form `timeComponent α` is, by its definition in this file, `ι_{∂_t} α`.
  rfl

variable [FiniteDimensional ℝ E] [I.Boundaryless] [T2Space M] [CompactSpace M]

/-- **Gray stability.** Let `α` be a smooth one-form on `ℝ × M`, for a compact boundaryless
manifold `M`, whose slices `α_t = ι_t^* α` are all contact forms. Then there is an isotopy `ψ_t` of
`M`, jointly smooth in `(t, x)`, with `ψ_0 = id`, such that every `ψ_t` pulls `α_t` back to a
positive multiple of `α_0` at every point. -/
theorem exists_isotopy_preservesCoorientation_of_isContactForm
    (α : SmoothForm (𝓘(ℝ, ℝ).prod I) (ℝ × M) ℝ 1)
    (hα : ∀ t, (mpullback (Prod.mk t) (contMDiff_const.prodMk contMDiff_id) α).IsContactForm) :
    ∃ ψ : ℝ → M ≃ₘ⟮I, I⟯ M, ContMDiff (𝓘(ℝ, ℝ).prod I) I ∞ (fun p : ℝ × M ↦ ψ p.1 p.2) ∧
      (∀ x, ψ 0 x = x) ∧ ∀ t, (ψ t).PreservesCoorientation
        (mpullback (Prod.mk 0) (contMDiff_const.prodMk contMDiff_id) α)
        (mpullback (Prod.mk t) (contMDiff_const.prodMk contMDiff_id) α) := by
  -- The time-dependent field `X_t` is the contact-Moser field of `α_t` and `β_t = ι_t^* L_{∂_t} α`.
  set X : ℝ → (x : M) → TangentSpace I x := fun t ↦
    (mpullback (Prod.mk t) (contMDiff_const.prodMk contMDiff_id) α).contactMoserVectorField
      (mpullback (Prod.mk t) (contMDiff_const.prodMk contMDiff_id) (timeDerivative α)) with hXdef
  have hX : ContMDiff (𝓘(ℝ, ℝ).prod I) I.tangent ∞
      (fun p : ℝ × M ↦ (⟨p.2, X p.1 p.2⟩ : TangentBundle I M)) :=
    contMDiff_contactMoserVectorField_mpullback_prodMk α (timeDerivative α) hα
  have hX₁ := hX.of_le (m := 1) (by simp)
  have hc : IsCompleteVectorField (timeDependentSuspensionField X) :=
    isCompleteVectorField_timeDependentSuspensionField hX₁ isCompact_univ
      fun _ _ hy ↦ (hy (mem_univ _)).elim
  refine ⟨fun t ↦ timeDependentFlowDiffeomorph hc (n := ⊤) le_top hX 0 t, ?_, fun x ↦ ?_,
    fun t ↦ Diffeomorph.preservesCoorientation_def.2 fun x ↦ ?_⟩
  · simp only [timeDependentFlowDiffeomorph_apply]
    exact (contMDiff_timeDependentFlowOf hc (n := ⊤) le_top hX).comp
      ((contMDiff_const.prodMk contMDiff_fst).prodMk contMDiff_snd)
  · rw [timeDependentFlowDiffeomorph_apply]
    exact timeDependentFlowOf_self hX₁ 0 x
  -- The rate `ι_t^* L_{∂_t} α + L_{X_t} α_t` is `g_t α_t`, with `g_t = β_t(R_{α_t})`.
  set g : ℝ × M → ℝ := fun p ↦
    (mpullback (Prod.mk p.1) (contMDiff_const.prodMk contMDiff_id) (timeDerivative α)).1 p.2
      ![(mpullback (Prod.mk p.1) (contMDiff_const.prodMk contMDiff_id) α).reebVectorField p.2]
  have hg : Continuous g := by
    refine ContMDiff.continuous (I := 𝓘(ℝ, ℝ).prod I) (I' := 𝓘(ℝ)) (n := ∞) fun p ↦ ?_
    have hβ := (contMDiffAt_sectionAlong_degreeOneEquiv_iff (b := Prod.snd) (α := fun q : ℝ × M ↦
      mpullback (Prod.mk q.1) (contMDiff_const.prodMk contMDiff_id) (timeDerivative α))).2
        (contMDiff_mpullback_prodMk (timeDerivative α) p)
    have h := (contMDiffAt_totalSpace.1 (ContMDiffAt.clm_bundle_apply (E₂ := Trivial M ℝ) hβ
      (contMDiff_reebVectorField_mpullback_prodMk α hα p))).2
    simpa [g, Trivial.eq_trivialization, degreeOneEquiv_apply_apply_vec] using h
  have hL (t : ℝ) : TauCeti.mpullback I (𝓘(ℝ, ℝ).prod I) (Prod.mk t)
        (mlieDerivForm (fun _ ↦ ((1 : ℝ), (0 : E))) α.1) +
      mlieDerivForm (X t) (TauCeti.mpullback I (𝓘(ℝ, ℝ).prod I) (Prod.mk t) α.1) =
      fun y ↦ g (t, y) • TauCeti.mpullback I (𝓘(ℝ, ℝ).prod I) (Prod.mk t) α.1 y := by
    funext y
    ext v
    have h := (hα t).mlieDerivForm_contactMoserVectorField_add
      (mpullback (Prod.mk t) (contMDiff_const.prodMk contMDiff_id) (timeDerivative α)) y (v 0)
    have hv : ![v 0] = v := by
      ext i
      fin_cases i
      rfl
    rw [hv] at h
    rw [Pi.add_apply, ContinuousAlternatingMap.add_apply, add_comm,
      ContinuousAlternatingMap.smul_apply, smul_eq_mul, hXdef]
    simp only [g]
    rw [coe_mpullback, coe_mpullback, coe_timeDerivative, coe_unitTimeField] at h
    rwa [coe_mpullback, coe_timeDerivative, coe_unitTimeField]
  have hflow := mpullback_timeDependentFlowOf_mpullback_prodMk_apply_eq_exp_integral_smul
    (hX.of_le (by simp)) hc hg (α.contMDiff.of_le (by simp)) hL 0 t x
  have hψ : ⇑(timeDependentFlowDiffeomorph hc (n := ⊤) le_top hX 0 t) =
      timeDependentFlowOf X 0 t :=
    funext (timeDependentFlowDiffeomorph_apply hc le_top hX 0 t)
  refine ⟨Real.exp (∫ u in (0 : ℝ)..t, g (u, timeDependentFlowOf X 0 u x)), Real.exp_pos _, ?_⟩
  simp only [coe_mpullback, hψ]
  exact hflow

/-- **Gray stability**, for contact structures. Let `α` be a smooth one-form on `ℝ × M`, for a
compact boundaryless manifold `M`, whose slices `α_t = ι_t^* α` are all contact forms. Then there is
an isotopy `ψ_t` of `M`, jointly smooth in `(t, x)`, with `ψ_0 = id`, such that every `ψ_t` is a
contactomorphism from `ker α_0` to `ker α_t`. -/
theorem exists_isotopy_isContactomorphism_of_isContactForm
    (α : SmoothForm (𝓘(ℝ, ℝ).prod I) (ℝ × M) ℝ 1)
    (hα : ∀ t, (mpullback (Prod.mk t) (contMDiff_const.prodMk contMDiff_id) α).IsContactForm) :
    ∃ ψ : ℝ → M ≃ₘ⟮I, I⟯ M, ContMDiff (𝓘(ℝ, ℝ).prod I) I ∞ (fun p : ℝ × M ↦ ψ p.1 p.2) ∧
      (∀ x, ψ 0 x = x) ∧ ∀ t, (ψ t).IsContactomorphism
        (mpullback (Prod.mk 0) (contMDiff_const.prodMk contMDiff_id) α)
        (mpullback (Prod.mk t) (contMDiff_const.prodMk contMDiff_id) α) := by
  obtain ⟨ψ, hψ, hψ₀, hψα⟩ := exists_isotopy_preservesCoorientation_of_isContactForm α hα
  exact ⟨ψ, hψ, hψ₀, fun t ↦ (hψα t).isContactomorphism⟩

end Gray

end TauCeti.SmoothForm
