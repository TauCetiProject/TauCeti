/-!
# Bidegree Grading and Finite-Order Filtration of the Polynomial Variational Bicomplex

This file equips the relative polynomial variational bicomplex
`TauCeti.RelJetAlgebra.Bicomplex B ι α` with its horizontal-vertical bidegree decomposition and
its ascending filtration by finite jet order.

## Main definitions

* `TauCeti.RelJetAlgebra.Bicomplex.bidegree B ι α p q`: the `RelJetAlgebra B ι α`-submodule of
  forms of horizontal degree `p` and vertical (contact) degree `q`.
* `TauCeti.RelJetAlgebra.Bicomplex.stageForm B ι α r`: the `B`-subalgebra of forms of finite jet
  order at most `r`, generated by embedded vertical forms in `vertStage B ι α r` and the horizontal
  coordinate one-forms `dx μ`.

## Main results

* `TauCeti.RelJetAlgebra.Bicomplex.mul_mem_bidegree`: wedge multiplication respects bidegree.
* `TauCeti.RelJetAlgebra.Bicomplex.dV_mem_bidegree`: `dV` has bidegree `(0, 1)`.
* `TauCeti.RelJetAlgebra.Bicomplex.dH_mem_bidegree`: `dH δ` has bidegree `(1, 0)`.
* `TauCeti.RelJetAlgebra.Bicomplex.iSup_bidegree`: the bidegree submodules span the entire
  bicomplex.
* `TauCeti.RelJetAlgebra.Bicomplex.exists_mem_stageForm`: every bicomplex form lies in some finite
  jet-order stage.
* `TauCeti.RelJetAlgebra.Bicomplex.dV_mem_stageForm`: `dV` preserves every finite stage
  `stageForm B ι α r`.
* `TauCeti.RelJetAlgebra.Bicomplex.dH_mem_stageForm`: `dH δ` raises the stage by at most one,
  mapping `stageForm B ι α r` into `stageForm B ι α (r + 1)`.
* `TauCeti.RelJetAlgebra.Bicomplex.dH_algebraMap_X_not_mem_stageForm`: over any nontrivial base
  ring `B`, `dH δ` does not preserve finite stages: for `I.degree = r`, `dH δ (uᵃ_I)` leaves
  `stageForm B ι α r`.

## References

* I. M. Anderson, *The Variational Bicomplex*, Utah State University technical report (1989).
* R. E. Borcherds, *Quantum Field Theory* (lecture notes), p. 49.
-/

open MvPolynomial
open scoped ExteriorAlgebra TensorProduct

namespace TauCeti

namespace RelJetAlgebra

namespace Bicomplex

noncomputable section

public section

section Bidegree

variable (B ι α : Type*) [CommRing B]

/-- The `RelJetAlgebra B ι α`-submodule of forms of horizontal degree `p` and vertical (contact)
degree `q` in `Bicomplex B ι α`. -/
def bidegree (p q : ℕ) : Submodule (RelJetAlgebra B ι α) (Bicomplex B ι α) :=
  Submodule.span (RelJetAlgebra B ι α)
    {z | ∃ β ∈ ⋀[B]^p (ι →₀ B),
      ∃ ω ∈ ⋀[RelJetAlgebra B ι α]^q (Ω[RelJetAlgebra B ι α⁄B]),
      z = includeHoriz B ι α B β * includeVert B ι α ω}

variable {B ι α}

/-- A horizontal-first pure wedge of a vertical `q`-form and a horizontal `p`-form has bidegree
`(p, q)`. -/
theorem horizFirstWedge_mem_bidegree {R : Type*} [CommRing R] [Algebra R B] {p q : ℕ}
    {ω : VertForms B ι α} {β : ExteriorAlgebra R (ι →₀ R)}
    (hω : ω ∈ ⋀[RelJetAlgebra B ι α]^q (Ω[RelJetAlgebra B ι α⁄B]))
    (hβ : β ∈ ⋀[R]^p (ι →₀ R)) :
    horizFirstWedge R B ι α (ω ⊗ₜ[R] β) ∈ bidegree B ι α p q := by
  rw [horizFirstWedge_tmul, includeHoriz_eq_base]
  exact Submodule.subset_span
    ⟨horizChangeRing R B ι β, horizChangeRing_mem_exteriorPower hβ, ω, hω, rfl⟩

/-- A vertical-first pure wedge of a vertical `q`-form and a horizontal `p`-form has bidegree
`(p, q)`. -/
theorem vertFirstWedge_mem_bidegree {R : Type*} [CommRing R] [Algebra R B] {p q : ℕ}
    {ω : VertForms B ι α} {β : ExteriorAlgebra R (ι →₀ R)}
    (hω : ω ∈ ⋀[RelJetAlgebra B ι α]^q (Ω[RelJetAlgebra B ι α⁄B]))
    (hβ : β ∈ ⋀[R]^p (ι →₀ R)) :
    vertFirstWedge R B ι α (ω ⊗ₜ[R] β) ∈ bidegree B ι α p q := by
  have h := horizFirstWedge_tmul_eq_neg_one_pow_smul_vertFirstWedge hω hβ
  have h' : vertFirstWedge R B ι α (ω ⊗ₜ[R] β) =
      (-1 : ℤ) ^ (p * q) • horizFirstWedge R B ι α (ω ⊗ₜ[R] β) := by
    rw [h, smul_smul, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_smul]
  rw [h', ← Int.cast_smul_eq_zsmul (RelJetAlgebra B ι α)]
  exact Submodule.smul_mem _ _ (horizFirstWedge_mem_bidegree hω hβ)

private theorem includeVert_mem_bidegree {q : ℕ} {ω : VertForms B ι α}
    (hω : ω ∈ ⋀[RelJetAlgebra B ι α]^q (Ω[RelJetAlgebra B ι α⁄B])) :
    includeVert B ι α ω ∈ bidegree B ι α 0 q := by
  have h1 : (1 : ExteriorAlgebra B (ι →₀ B)) ∈ ⋀[B]^0 (ι →₀ B) := by
    rw [ExteriorAlgebra.exteriorPower, pow_zero, Submodule.mem_one]
    exact ⟨1, map_one _⟩
  have heq : includeVert B ι α ω =
      horizFirstWedge B B ι α (ω ⊗ₜ[B] (1 : ExteriorAlgebra B (ι →₀ B))) := by
    rw [horizFirstWedge_tmul, map_one, one_mul]
  rw [heq]
  exact horizFirstWedge_mem_bidegree hω h1

private theorem includeHoriz_mem_bidegree {p : ℕ} {β : ExteriorAlgebra B (ι →₀ B)}
    (hβ : β ∈ ⋀[B]^p (ι →₀ B)) :
    includeHoriz B ι α B β ∈ bidegree B ι α p 0 := by
  have h1 : (1 : VertForms B ι α) ∈ ⋀[RelJetAlgebra B ι α]^0 (Ω[RelJetAlgebra B ι α⁄B]) := by
    rw [ExteriorAlgebra.exteriorPower, pow_zero, Submodule.mem_one]
    exact ⟨1, map_one _⟩
  have heq : includeHoriz B ι α B β =
      horizFirstWedge B B ι α ((1 : VertForms B ι α) ⊗ₜ[B] β) := by
    rw [horizFirstWedge_tmul, map_one, mul_one]
  rw [heq]
  exact horizFirstWedge_mem_bidegree h1 hβ

/-- Zero-forms `p : RelJetAlgebra B ι α` lie in bidegree `(0, 0)`. -/
theorem algebraMap_mem_bidegree (p : RelJetAlgebra B ι α) :
    algebraMap (RelJetAlgebra B ι α) (Bicomplex B ι α) p ∈ bidegree B ι α 0 0 := by
  have hp : algebraMap (RelJetAlgebra B ι α) (VertForms B ι α) p ∈
      ⋀[RelJetAlgebra B ι α]^0 (Ω[RelJetAlgebra B ι α⁄B]) := by
    rw [ExteriorAlgebra.exteriorPower, pow_zero, Submodule.mem_one]
    exact ⟨p, rfl⟩
  rw [← includeVert_algebraMap]
  exact includeVert_mem_bidegree hp

/-- Horizontal coordinate one-forms `dx μ` lie in bidegree `(1, 0)`. -/
theorem dx_mem_bidegree (μ : ι) : dx B ι α μ ∈ bidegree B ι α 1 0 := by
  rw [← includeHoriz_ι_single (R := B)]
  exact includeHoriz_mem_bidegree (TauCeti.ExteriorAlgebra.ι_mem_exteriorPower_one _)

/-- Contact coordinate one-forms `θᵃ_I` lie in bidegree `(0, 1)`. -/
theorem theta_mem_bidegree (a : α) (I : ι →₀ ℕ) :
    theta B ι α a I ∈ bidegree B ι α 0 1 := by
  rw [← includeVert_ι_D_X]
  exact includeVert_mem_bidegree (TauCeti.ExteriorAlgebra.ι_mem_exteriorPower_one _)

/-- Forms of bidegree `(p, q)` have total exterior degree `p + q`. -/
theorem bidegree_le_exteriorPower (p q : ℕ) :
    bidegree B ι α p q ≤
      ⋀[RelJetAlgebra B ι α]^(p + q)
        ((ι →₀ RelJetAlgebra B ι α) × Ω[RelJetAlgebra B ι α⁄B]) := by
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨β, hβ, ω, hω, rfl⟩
  rw [ExteriorAlgebra.exteriorPower, pow_add]
  exact Submodule.mul_mem_mul (includeHoriz_mem_exteriorPower hβ) (includeVert_mem_exteriorPower hω)

/-- Wedge multiplication maps `bidegree p₁ q₁ × bidegree p₂ q₂` into
`bidegree (p₁ + p₂) (q₁ + q₂)`. -/
theorem mul_mem_bidegree {p₁ q₁ p₂ q₂ : ℕ} {ω₁ ω₂ : Bicomplex B ι α}
    (h₁ : ω₁ ∈ bidegree B ι α p₁ q₁) (h₂ : ω₂ ∈ bidegree B ι α p₂ q₂) :
    ω₁ * ω₂ ∈ bidegree B ι α (p₁ + p₂) (q₁ + q₂) := by
  induction h₁ using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨β₁, hβ₁, α₁, hα₁, rfl⟩ := hx
    induction h₂ using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨β₂, hβ₂, α₂, hα₂, rfl⟩ := hy
      have hcomm :
          includeVert B ι α α₁ * includeHoriz B ι α B β₂ =
            ((-1 : RelJetAlgebra B ι α) ^ (p₂ * q₁)) •
              (includeHoriz B ι α B β₂ * includeVert B ι α α₁) :=
        TauCeti.ExteriorAlgebra.mul_eq_neg_one_pow_smul_mul_of_mem
          (includeVert_mem_exteriorPower hα₁) (includeHoriz_mem_exteriorPower hβ₂)
      have hmul :
          (includeHoriz B ι α B β₁ * includeVert B ι α α₁) *
              (includeHoriz B ι α B β₂ * includeVert B ι α α₂) =
            ((-1 : RelJetAlgebra B ι α) ^ (p₂ * q₁)) •
              (includeHoriz B ι α B (β₁ * β₂) * includeVert B ι α (α₁ * α₂)) := by
        rw [mul_assoc (includeHoriz B ι α B β₁), ← mul_assoc (includeVert B ι α α₁), hcomm,
          smul_mul_assoc, mul_smul_comm]
        congr 1
        rw [← mul_assoc (includeHoriz B ι α B β₁), ← mul_assoc (includeHoriz B ι α B β₁),
          mul_assoc (includeHoriz B ι α B β₁ * includeHoriz B ι α B β₂),
          ← map_mul (includeHoriz B ι α B), ← map_mul (includeVert B ι α)]
      rw [hmul]
      refine Submodule.smul_mem _ _ (Submodule.subset_span ⟨β₁ * β₂, ?_, α₁ * α₂, ?_, rfl⟩)
      · rw [ExteriorAlgebra.exteriorPower, pow_add]
        exact Submodule.mul_mem_mul hβ₁ hβ₂
      · rw [ExteriorAlgebra.exteriorPower, pow_add]
        exact Submodule.mul_mem_mul hα₁ hα₂
    | zero => rw [mul_zero]; exact zero_mem _
    | add y₁ y₂ _ _ hy₁ hy₂ => rw [mul_add]; exact add_mem hy₁ hy₂
    | smul f y _ hy => rw [mul_smul_comm]; exact Submodule.smul_mem _ f hy
  | zero => rw [zero_mul]; exact zero_mem _
  | add x₁ x₂ _ _ hx₁ hx₂ => rw [add_mul]; exact add_mem hx₁ hx₂
  | smul f x _ hx => rw [smul_mul_assoc]; exact Submodule.smul_mem _ f hx

/-- The vertical differential `dV` has bidegree `(0, 1)`. -/
theorem dV_mem_bidegree {p q : ℕ} {ω : Bicomplex B ι α} (hω : ω ∈ bidegree B ι α p q) :
    dV B ι α ω ∈ bidegree B ι α p (q + 1) := by
  induction hω using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨β, hβ, α', hα', rfl⟩ := hx
    rw [← horizFirstWedge_tmul (R := B), dV_horizFirstWedge_of_mem_exteriorPower α' hβ,
      dAlgTensor_tmul, ← Int.cast_smul_eq_zsmul (RelJetAlgebra B ι α)]
    exact Submodule.smul_mem _ _
      (horizFirstWedge_mem_bidegree (MvPolynomialDeRham.d_mem_exteriorPower hα') hβ)
  | zero => rw [map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul f x hx ihx =>
    rw [Algebra.smul_def, dV_mul, AlgHom.commutes, ← Algebra.smul_def]
    refine add_mem ?_ (Submodule.smul_mem _ f ihx)
    have hdf : dV B ι α (algebraMap (RelJetAlgebra B ι α) (Bicomplex B ι α) f) ∈
        bidegree B ι α 0 1 := by
      have hf0 : algebraMap (RelJetAlgebra B ι α) (VertForms B ι α) f ∈
          ⋀[RelJetAlgebra B ι α]^0 (Ω[RelJetAlgebra B ι α⁄B]) := by
        rw [ExteriorAlgebra.exteriorPower, pow_zero, Submodule.mem_one]
        exact ⟨f, rfl⟩
      rw [← includeVert_algebraMap, dV_includeVert]
      exact includeVert_mem_bidegree (MvPolynomialDeRham.d_mem_exteriorPower hf0)
    have hprod := mul_mem_bidegree hdf hx
    rwa [Nat.zero_add, Nat.add_comm 1 q] at hprod

/-- The horizontal differential `dH δ` has bidegree `(1, 0)`. -/
theorem dH_mem_bidegree {R : Type*} [CommRing R] [Algebra R B] [Fintype ι]
    (δ : ι → Derivation R B B) {p q : ℕ} {ω : Bicomplex B ι α}
    (hω : ω ∈ bidegree B ι α p q) :
    dH δ ω ∈ bidegree B ι α (p + 1) q := by
  have hdH_alg (f : RelJetAlgebra B ι α) :
      dH δ (algebraMap (RelJetAlgebra B ι α) (Bicomplex B ι α) f) ∈ bidegree B ι α 1 0 := by
    rw [dH_algebraMap]
    exact sum_mem fun μ _ ↦ Submodule.smul_mem _ _ (dx_mem_bidegree μ)
  have hdH_horiz : ∀ {p : ℕ} {β : ExteriorAlgebra B (ι →₀ B)}, β ∈ ⋀[B]^p (ι →₀ B) →
      dH δ (includeHoriz B ι α B β) ∈ bidegree B ι α (p + 1) 0 := by
    intro p β hβ
    induction hβ using Submodule.pow_induction_on_left' with
    | algebraMap b =>
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply B (RelJetAlgebra B ι α)]
      exact hdH_alg (algebraMap B (RelJetAlgebra B ι α) b)
    | add x y _ _ _ hx hy =>
      rw [map_add, map_add]
      exact add_mem hx hy
    | mem_mul m hm i x hx ihx =>
      obtain ⟨v, rfl⟩ := hm
      have hv_dH : dH δ (includeHoriz B ι α B (ExteriorAlgebra.ι B v)) ∈
          bidegree B ι α 2 0 := by
        induction v using Finsupp.induction_linear with
        | zero =>
          rw [map_zero, map_zero, map_zero]
          exact zero_mem _
        | add v₁ v₂ hv₁ hv₂ =>
          rw [map_add, map_add, map_add]
          exact add_mem hv₁ hv₂
        | single ν b =>
          have hsingle : ExteriorAlgebra.ι B (Finsupp.single ν b) =
              b • ExteriorAlgebra.ι B (Finsupp.single ν (1 : B)) := by
            rw [← map_smul, Finsupp.smul_single, smul_eq_mul, mul_one]
          rw [hsingle, map_smul, includeHoriz_ι_single, Algebra.smul_def,
            IsScalarTower.algebraMap_apply B (RelJetAlgebra B ι α) (Bicomplex B ι α),
            dH_mul, dH_dx, mul_zero, add_zero]
          have hprod := mul_mem_bidegree (hdH_alg (algebraMap B (RelJetAlgebra B ι α) b))
            (dx_mem_bidegree ν)
          exact hprod
      have hv_bideg : includeHoriz B ι α B (ExteriorAlgebra.ι B v) ∈ bidegree B ι α 1 0 :=
        includeHoriz_mem_bidegree (TauCeti.ExteriorAlgebra.ι_mem_exteriorPower_one v)
      have hx_bideg : includeHoriz B ι α B x ∈ bidegree B ι α i 0 :=
        includeHoriz_mem_bidegree hx
      rw [map_mul, dH_mul]
      refine add_mem ?_ ?_
      · have h1 := mul_mem_bidegree hv_dH hx_bideg
        rwa [show 2 + i = i + 1 + 1 by omega] at h1
      · rw [includeHoriz_involute, CliffordAlgebra.involute_ι, map_neg, neg_mul]
        have h2 := mul_mem_bidegree hv_bideg ihx
        rw [show 1 + (i + 1) = i + 1 + 1 by omega] at h2
        exact neg_mem h2
  induction hω using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨β, hβ, α', hα', rfl⟩ := hx
    rw [dH_mul]
    have hα'_bideg : includeVert B ι α α' ∈ bidegree B ι α 0 q :=
      includeVert_mem_bidegree hα'
    have hβ_bideg : includeHoriz B ι α B β ∈ bidegree B ι α p 0 :=
      includeHoriz_mem_bidegree hβ
    refine add_mem ?_ ?_
    · have h1 := mul_mem_bidegree (hdH_horiz hβ) hα'_bideg
      rwa [Nat.add_zero, Nat.zero_add] at h1
    · rw [TauCeti.ExteriorAlgebra.involute_of_mem_exteriorPower (includeHoriz_mem_exteriorPower hβ),
        smul_mul_assoc]
      refine Submodule.smul_mem _ _ ?_
      have hdH_α' : dH δ (includeVert B ι α α') ∈ bidegree B ι α 1 q := by
        rw [dH_includeVert]
        refine sum_mem fun μ _ ↦ ?_
        have hterm := mul_mem_bidegree (dx_mem_bidegree μ)
          (includeVert_mem_bidegree (totalDerivForm_mem_exteriorPower δ μ hα'))
        rwa [Nat.add_zero, Nat.zero_add] at hterm
      have h2 := mul_mem_bidegree hβ_bideg hdH_α'
      rwa [Nat.zero_add] at h2
  | zero => rw [map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul f x hx ihx =>
    rw [Algebra.smul_def, dH_mul, AlgHom.commutes, ← Algebra.smul_def]
    refine add_mem ?_ (Submodule.smul_mem _ f ihx)
    have hprod := mul_mem_bidegree (hdH_alg f) hx
    rwa [Nat.add_comm 1 p, Nat.zero_add] at hprod

/-- The bidegree submodules span `Bicomplex B ι α`. -/
theorem iSup_bidegree : ⨆ p : ℕ, ⨆ q : ℕ, bidegree B ι α p q = ⊤ := by
  rw [Submodule.eq_top_iff']
  intro ω
  obtain ⟨u, rfl⟩ := (horizFirstWedge B B ι α).surjective ω
  induction u using TensorProduct.inductionOn with
  | tmul α' β =>
    induction β using DirectSum.Decomposition.inductionOn fun p ↦ ⋀[B]^p (ι →₀ B) with
    | zero =>
      rw [TensorProduct.tmul_zero, map_zero]
      exact zero_mem _
    | @homogeneous p w =>
      obtain ⟨γ, hγ⟩ := w
      induction α' using DirectSum.Decomposition.inductionOn
          fun q ↦ ⋀[RelJetAlgebra B ι α]^q (Ω[RelJetAlgebra B ι α⁄B]) with
      | zero =>
        rw [TensorProduct.zero_tmul, map_zero]
        exact zero_mem _
      | @homogeneous q v =>
        obtain ⟨η, hη⟩ := v
        exact Submodule.mem_iSup_of_mem p
          (Submodule.mem_iSup_of_mem q (horizFirstWedge_mem_bidegree hη hγ))
      | add η₁ η₂ ih₁ ih₂ =>
        rw [TensorProduct.add_tmul, map_add]
        exact add_mem ih₁ ih₂
    | add γ₁ γ₂ ih₁ ih₂ =>
      rw [TensorProduct.tmul_add, map_add]
      exact add_mem ih₁ ih₂
  | add x y hx hy =>
    rw [map_add]
    exact add_mem hx hy

end Bidegree

section StageFiltration

variable (B ι α : Type*) [CommRing B]

/-- The `B`-subalgebra of forms of finite jet order at most `r`, generated by embedded vertical
forms in `vertStage B ι α r` and the horizontal coordinate one-forms `dx μ`. -/
def stageForm (r : ℕ) : Subalgebra B (Bicomplex B ι α) :=
  Algebra.adjoin B
    ((includeVert B ι α '' (vertStage B ι α r : Set (VertForms B ι α))) ∪
      Set.range (dx B ι α))

variable {B ι α}

/-- `stageForm B ι α r` is the `B`-subalgebra generated by embedded vertical forms of order at
most `r` and the horizontal coordinate one-forms `dx μ`. -/
theorem stageForm_eq_adjoin (r : ℕ) :
    stageForm B ι α r = Algebra.adjoin B
      ((includeVert B ι α '' (vertStage B ι α r : Set (VertForms B ι α))) ∪
        Set.range (dx B ι α)) := by
  rfl

/-- Increasing the jet-order bound enlarges `stageForm`. -/
theorem stageForm_mono : Monotone (stageForm B ι α) := by
  intro r s hrs
  exact Algebra.adjoin_mono
    (Set.union_subset_union_left _ (Set.image_mono (vertStage_mono hrs)))

/-- Every embedded vertical form of order at most `r` belongs to `stageForm B ι α r`. -/
theorem includeVert_mem_stageForm {r : ℕ} {ω : VertForms B ι α}
    (hω : ω ∈ vertStage B ι α r) : includeVert B ι α ω ∈ stageForm B ι α r :=
  Algebra.subset_adjoin (Or.inl ⟨ω, hω, rfl⟩)

/-- Every horizontal coordinate one-form `dx μ` belongs to every finite stage `stageForm B ι α r`.
-/
theorem dx_mem_stageForm (r : ℕ) (μ : ι) : dx B ι α μ ∈ stageForm B ι α r :=
  Algebra.subset_adjoin (Or.inr ⟨μ, rfl⟩)

/-- Zero-forms of order at most `r` belong to `stageForm B ι α r`. -/
theorem algebraMap_mem_stageForm {r : ℕ} {p : RelJetAlgebra B ι α} (hp : p ∈ stage B ι α r) :
    algebraMap (RelJetAlgebra B ι α) (Bicomplex B ι α) p ∈ stageForm B ι α r := by
  rw [← includeVert_algebraMap]
  exact includeVert_mem_stageForm (algebraMap_mem_vertStage hp)

/-- Contact coordinate one-forms `θᵃ_I` with `I.degree ≤ r` belong to `stageForm B ι α r`. -/
theorem theta_mem_stageForm {r : ℕ} {a : α} {I : ι →₀ ℕ} (hI : I.degree ≤ r) :
    theta B ι α a I ∈ stageForm B ι α r := by
  rw [← includeVert_ι_D_X]
  exact includeVert_mem_stageForm (ι_D_X_mem_vertStage hI)

/-- Constant-coefficient horizontal forms belong to every finite stage `stageForm B ι α r`. -/
theorem includeHoriz_mem_stageForm {R : Type*} [CommRing R] [Algebra R B] (r : ℕ)
    (β : ExteriorAlgebra R (ι →₀ R)) :
    includeHoriz B ι α R β ∈ stageForm B ι α r := by
  induction β using CliffordAlgebra.induction with
  | algebraMap c =>
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R B (Bicomplex B ι α)]
    exact (stageForm B ι α r).algebraMap_mem (algebraMap R B c)
  | ι v =>
    induction v using Finsupp.induction_linear with
    | zero =>
      rw [map_zero, map_zero]
      exact zero_mem _
    | add v₁ v₂ hv₁ hv₂ =>
      rw [map_add, map_add]
      exact add_mem hv₁ hv₂
    | single μ c =>
      have hsingle : ExteriorAlgebra.ι R (Finsupp.single μ c) =
          c • ExteriorAlgebra.ι R (Finsupp.single μ (1 : R)) := by
        rw [← map_smul, Finsupp.smul_single, smul_eq_mul, mul_one]
      rw [hsingle, map_smul, includeHoriz_ι_single, ← algebraMap_smul B]
      exact Subalgebra.smul_mem (stageForm B ι α r) (dx_mem_stageForm r μ) (algebraMap R B c)
  | mul x y hx hy =>
    rw [map_mul]
    exact mul_mem hx hy
  | add x y hx hy =>
    rw [map_add]
    exact add_mem hx hy

/-- Every form in `Bicomplex B ι α` belongs to some finite jet-order stage. -/
theorem exists_mem_stageForm (ω : Bicomplex B ι α) : ∃ r, ω ∈ stageForm B ι α r := by
  obtain ⟨u, rfl⟩ := (horizFirstWedge B B ι α).surjective ω
  induction u using TensorProduct.inductionOn with
  | tmul α' β =>
    obtain ⟨r, hr⟩ := exists_mem_vertStage α'
    rw [horizFirstWedge_tmul]
    exact ⟨r, mul_mem (includeHoriz_mem_stageForm r β) (includeVert_mem_stageForm hr)⟩
  | add x y hx hy =>
    obtain ⟨r, hr⟩ := hx
    obtain ⟨s, hs⟩ := hy
    rw [map_add]
    exact ⟨max r s, add_mem (stageForm_mono (le_max_left r s) hr)
      (stageForm_mono (le_max_right r s) hs)⟩

/-- The grade involution preserves every finite stage `stageForm B ι α r`. -/
theorem involute_mem_stageForm {r : ℕ} {ω : Bicomplex B ι α} (hω : ω ∈ stageForm B ι α r) :
    CliffordAlgebra.involute (Q := (0 : QuadraticForm (RelJetAlgebra B ι α) _)) ω ∈
      stageForm B ι α r := by
  induction hω using Algebra.adjoin_induction with
  | mem x hx =>
    rcases hx with ⟨η, hη, rfl⟩ | ⟨μ, rfl⟩
    · rw [includeVert_involute]
      exact includeVert_mem_stageForm (involute_mem_vertStage hη)
    · rw [involute_dx]
      exact neg_mem (dx_mem_stageForm r μ)
  | algebraMap b =>
    rw [IsScalarTower.algebraMap_apply B (RelJetAlgebra B ι α) (Bicomplex B ι α),
      AlgHom.commutes,
      ← IsScalarTower.algebraMap_apply B (RelJetAlgebra B ι α) (Bicomplex B ι α)]
    exact (stageForm B ι α r).algebraMap_mem b
  | add x y _ _ hx hy =>
    rw [map_add]
    exact add_mem hx hy
  | mul x y _ _ hx hy =>
    rw [map_mul]
    exact mul_mem hx hy

/-- **Finite-stage closure of `d_V`**: the vertical differential preserves every finite jet-order
stage `stageForm B ι α r`. -/
theorem dV_mem_stageForm {r : ℕ} {ω : Bicomplex B ι α} (hω : ω ∈ stageForm B ι α r) :
    dV B ι α ω ∈ stageForm B ι α r := by
  induction hω using Algebra.adjoin_induction with
  | mem x hx =>
    rcases hx with ⟨η, hη, rfl⟩ | ⟨μ, rfl⟩
    · rw [dV_includeVert]
      exact includeVert_mem_stageForm (dAlg_mem_vertStage hη)
    · rw [dV_dx]
      exact zero_mem (stageForm B ι α r)
  | algebraMap b =>
    rw [IsScalarTower.algebraMap_apply B (RelJetAlgebra B ι α) (Bicomplex B ι α),
      dV_algebraMap, MvPolynomial.algebraMap_eq, MvPolynomial.derivation_C, map_zero, map_zero]
    exact zero_mem (stageForm B ι α r)
  | add x y _ _ hx hy =>
    rw [map_add]
    exact add_mem hx hy
  | mul x y hx hy ihx ihy =>
    rw [dV_mul]
    exact add_mem (mul_mem ihx hy) (mul_mem (involute_mem_stageForm hx) ihy)

/-- **Finite-stage shift of `d_H`**: the horizontal differential raises jet order by at most one,
mapping `stageForm B ι α r` into `stageForm B ι α (r + 1)`. -/
theorem dH_mem_stageForm {R : Type*} [CommRing R] [Algebra R B] [Fintype ι]
    (δ : ι → Derivation R B B) {r : ℕ} {ω : Bicomplex B ι α}
    (hω : ω ∈ stageForm B ι α r) :
    dH δ ω ∈ stageForm B ι α (r + 1) := by
  induction hω using Algebra.adjoin_induction with
  | mem x hx =>
    rcases hx with ⟨η, hη, rfl⟩ | ⟨μ, rfl⟩
    · rw [dH_includeVert]
      exact sum_mem fun μ _ ↦ mul_mem (dx_mem_stageForm (r + 1) μ)
        (includeVert_mem_stageForm (totalDerivForm_mem_vertStage δ μ hη))
    · rw [dH_dx]
      exact zero_mem (stageForm B ι α (r + 1))
  | algebraMap b =>
    rw [IsScalarTower.algebraMap_apply B (RelJetAlgebra B ι α) (Bicomplex B ι α),
      dH_algebraMap, MvPolynomial.algebraMap_eq]
    refine sum_mem fun μ _ ↦ ?_
    rw [totalDeriv_C, ← MvPolynomial.algebraMap_eq, algebraMap_smul]
    exact Subalgebra.smul_mem (stageForm B ι α (r + 1)) (dx_mem_stageForm (r + 1) μ) (δ μ b)
  | add x y _ _ hx hy =>
    rw [map_add]
    exact add_mem hx hy
  | mul x y hx hy ihx ihy =>
    rw [dH_mul]
    exact add_mem (mul_mem ihx (stageForm_mono (Nat.le_succ r) hy))
      (mul_mem (stageForm_mono (Nat.le_succ r) (involute_mem_stageForm hx)) ihy)

/-- **Sharp non-closure of finite stages under `d_H`**: over any nontrivial base ring `B`, if
`I.degree = r` and `μ : ι` is any base direction, then `dH δ (uᵃ_I)` does not belong to
`stageForm B ι α r` (even though `uᵃ_I ∈ stageForm B ι α r`). -/
theorem dH_algebraMap_X_not_mem_stageForm [Nontrivial B] {R : Type*} [CommRing R] [Algebra R B]
    [Fintype ι] (δ : ι → Derivation R B B) {r : ℕ} {a : α} {I : ι →₀ ℕ} (hI : I.degree = r)
    (μ : ι) :
    dH δ (algebraMap (RelJetAlgebra B ι α) (Bicomplex B ι α) (X (a, I))) ∉
      stageForm B ι α r := by
  classical
  let P := RelJetAlgebra B ι α
  let f : ((ι →₀ P) × Ω[P⁄B]) →ₗ[P] TrivSqZeroExt P P :=
    (TrivSqZeroExt.inrHom P P).comp ((Finsupp.lapply μ).comp (LinearMap.fst P _ _))
  let ev : Bicomplex B ι α →ₐ[P] TrivSqZeroExt P P :=
    ExteriorAlgebra.lift P ⟨f, by intro m; exact TrivSqZeroExt.inr_mul_inr (R := P) (M := P) _ _⟩
  have hev_ι (m : (ι →₀ P) × Ω[P⁄B]) :
      ev (ExteriorAlgebra.ι P m) = TrivSqZeroExt.inr (m.1 μ) :=
    ExteriorAlgebra.lift_ι_apply P f _ m
  have hev_stage : ∀ ω ∈ stageForm B ι α r,
      (ev ω).fst ∈ stage B ι α r ∧ (ev ω).snd ∈ stage B ι α r := by
    intro ω hω
    induction hω using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with ⟨η, hη, rfl⟩ | ⟨ν, rfl⟩
      · rw [vertStage_eq_supportedForms, MvPolynomialDeRham.supportedForms_eq_adjoin] at hη
        induction hη using Algebra.adjoin_induction with
        | mem y hy =>
          rcases hy with ⟨p, hp, rfl⟩ | ⟨aJ, _, rfl⟩
          · rw [includeVert_algebraMap, AlgHom.commutes, TrivSqZeroExt.algebraMap_eq_inl]
            exact ⟨by simpa [stage_eq_supported] using hp, zero_mem _⟩
          · rw [includeVert_ι_D_X, theta_eq_ι, hev_ι]
            exact ⟨zero_mem _, zero_mem _⟩
        | algebraMap b =>
          rw [IsScalarTower.algebraMap_apply B P (VertForms B ι α), includeVert_algebraMap,
            AlgHom.commutes, TrivSqZeroExt.algebraMap_eq_inl]
          exact ⟨(stage B ι α r).algebraMap_mem b, zero_mem _⟩
        | add y₁ y₂ _ _ hy₁ hy₂ =>
          rw [map_add, map_add, TrivSqZeroExt.fst_add, TrivSqZeroExt.snd_add]
          exact ⟨add_mem hy₁.1 hy₂.1, add_mem hy₁.2 hy₂.2⟩
        | mul y₁ y₂ _ _ hy₁ hy₂ =>
          rw [map_mul, map_mul, TrivSqZeroExt.fst_mul, TrivSqZeroExt.snd_mul]
          exact ⟨mul_mem hy₁.1 hy₂.1, add_mem (mul_mem hy₁.1 hy₂.2) (mul_mem hy₁.2 hy₂.1)⟩
      · rw [dx_eq_ι, hev_ι, TrivSqZeroExt.fst_inr, TrivSqZeroExt.snd_inr]
        refine ⟨zero_mem _, ?_⟩
        by_cases hν : ν = μ
        · subst hν
          simp
        · rw [Finsupp.single_eq_of_ne (Ne.symm hν)]
          exact zero_mem _
    | algebraMap b =>
      rw [IsScalarTower.algebraMap_apply B P (Bicomplex B ι α), AlgHom.commutes,
        TrivSqZeroExt.algebraMap_eq_inl]
      exact ⟨(stage B ι α r).algebraMap_mem b, zero_mem _⟩
    | add x y _ _ hx hy =>
      rw [map_add, TrivSqZeroExt.fst_add, TrivSqZeroExt.snd_add]
      exact ⟨add_mem hx.1 hy.1, add_mem hx.2 hy.2⟩
    | mul x y _ _ hx hy =>
      rw [map_mul, TrivSqZeroExt.fst_mul, TrivSqZeroExt.snd_mul]
      exact ⟨mul_mem hx.1 hy.1, add_mem (mul_mem hx.1 hy.2) (mul_mem hx.2 hy.1)⟩
  intro hmem
  have hsnd : (ev (dH δ (algebraMap P (Bicomplex B ι α) (X (a, I))))).snd ∈ stage B ι α r :=
    (hev_stage _ hmem).2
  have heval :
      (ev (dH δ (algebraMap P (Bicomplex B ι α) (X (a, I))))).snd =
        (X (a, I + Finsupp.single μ 1) : P) := by
    change TrivSqZeroExt.sndHom P P (ev (dH δ (algebraMap P (Bicomplex B ι α) (X (a, I))))) = _
    rw [dH_algebraMap, map_sum, map_sum]
    calc
      ∑ ν : ι, TrivSqZeroExt.sndHom P P (ev (totalDeriv δ ν (X (a, I)) • dx B ι α ν))
          = ∑ ν : ι, X (a, I + Finsupp.single ν 1) * Finsupp.single ν (1 : P) μ := by
            refine Finset.sum_congr rfl fun ν _ ↦ ?_
            rw [totalDeriv_X, map_smul, map_smul, dx_eq_ι, hev_ι, TrivSqZeroExt.sndHom_apply,
              TrivSqZeroExt.snd_inr, smul_eq_mul]
      _ = X (a, I + Finsupp.single μ 1) := by
            rw [Finset.sum_eq_single μ]
            · simp
            · intro ν _ hν
              rw [Finsupp.single_eq_of_ne hν.symm, mul_zero]
            · intro hμ
              exact (hμ (Finset.mem_univ μ)).elim
  rw [heval, X_mem_stage_iff] at hsnd
  have hdeg : (I + Finsupp.single μ 1).degree = r + 1 := by
    simp [hI]
  omega

end StageFiltration

