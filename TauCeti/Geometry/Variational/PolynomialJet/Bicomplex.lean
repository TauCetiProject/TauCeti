/-!
# The variational bicomplex of polynomial jets

Differential forms on polynomial jet expressions are the algebraic de Rham complex
`PolynomialJet.Forms R ι α = Λ Ω[PolynomialJet R ι α⁄R]`, with exterior derivative `d`
(`TauCeti.KaehlerDeRham.extDeriv`). Besides the horizontal coframe `dxⁱ`
(`PolynomialJet.horizontalForm`) it carries the contact forms

`θᵃ_I = duᵃ_I - ∑ᵢ uᵃ_(I+eᵢ) dxⁱ`

(`PolynomialJet.contactForm`), the vertical parts of the differentials `duᵃ_I`. The total
derivative `Dᵢ` acts on forms as the Lie derivative along the total derivation
(`PolynomialJet.totalLieDeriv`); it annihilates `dxʲ`, sends `θᵃ_I` to `θᵃ_(I+eᵢ)`, and these
operators commute with each other and with `d`. For a finite-dimensional base the horizontal
differential is

`d_H ω = ∑ᵢ dxⁱ ∧ Dᵢ ω`

(`PolynomialJet.horizontalDiff`) and the vertical differential is `d_V = d - d_H`
(`PolynomialJet.verticalDiff`). On generators they are given by the defining formulas of the
variational bicomplex,

* `d_H f = ∑ᵢ (Dᵢ f) dxⁱ`, `d_H dxʲ = 0`, `d_H θᵃ_I = ∑ᵢ dxⁱ ∧ θᵃ_(I+eᵢ)`;
* `d_V f = ∑_(a,I) (∂f/∂uᵃ_I) θᵃ_I`, `d_V dxʲ = 0`, `d_V θᵃ_I = 0`,

and both obey the graded Leibniz rule. The bicomplex identities

`d_H² = 0`, `d_V² = 0`, `d_H d_V + d_V d_H = 0`

hold on all forms, over an arbitrary commutative ring. Since every polynomial expression involves
finitely many jet coordinates, this is the colimit over all jet orders; no finite stage is claimed
to be closed under `d_H`.

## Main definitions

* `TauCeti.PolynomialJet.Forms`: differential forms on polynomial jets.
* `TauCeti.PolynomialJet.horizontalForm`, `TauCeti.PolynomialJet.contactForm`: the horizontal
  coframe `dxⁱ` and the contact forms `θᵃ_I`.
* `TauCeti.PolynomialJet.totalLieDeriv`: the total derivative acting on forms.
* `TauCeti.PolynomialJet.horizontalDiff`, `TauCeti.PolynomialJet.verticalDiff`: the horizontal and
  vertical differentials.

## Main results

* `PolynomialJet.horizontalDiff_algebraMap`, `PolynomialJet.horizontalDiff_horizontalForm`,
  `PolynomialJet.horizontalDiff_contactForm`, `PolynomialJet.verticalDiff_algebraMap`,
  `PolynomialJet.verticalDiff_horizontalForm`, `PolynomialJet.verticalDiff_contactForm`: the
  formulas on generators.
* `PolynomialJet.horizontalDiff_mul`, `PolynomialJet.verticalDiff_mul`: the graded Leibniz rules.
* `PolynomialJet.horizontalDiff_horizontalDiff`, `PolynomialJet.verticalDiff_verticalDiff`,
  `PolynomialJet.verticalDiff_horizontalDiff`: the bicomplex identities.
* `PolynomialJet.isDGAlgebra_horizontalDiff`, `PolynomialJet.isDGAlgebra_verticalDiff`: with
  either differential, the forms are a differential graded algebra for the exterior degree.

## References

* I. M. Anderson, *The Variational Bicomplex* (1989), Chapter 1, §§A–B, for contact forms, the
  total Lie derivative and the decomposition `d = d_H + d_V`.
* P. J. Olver, *Applications of Lie Groups to Differential Equations*, 2nd ed. (1993), §5.4.
-/

public section

namespace TauCeti

namespace PolynomialJet

open MvPolynomial KaehlerDeRham CliffordAlgebra

noncomputable section

variable {R ι α : Type*} [CommRing R]

variable (R ι α) in
/-- Differential forms on polynomial jet expressions: the algebraic de Rham complex of the
polynomial jet algebra, generated by functions and the differentials of the base and field
coordinates. -/
abbrev Forms := ExteriorAlgebra (PolynomialJet R ι α) Ω[PolynomialJet R ι α⁄R]

variable (R α) in
/-- The horizontal coframe form `dxⁱ`, the differential of the base coordinate `xⁱ`. -/
def horizontalForm (i : ι) : Forms R ι α :=
  ExteriorAlgebra.ι _ (KaehlerDifferential.D R _ (X (Sum.inl i)))

theorem horizontalForm_def (i : ι) :
    horizontalForm R α i = ExteriorAlgebra.ι _ (KaehlerDifferential.D R _ (X (Sum.inl i))) :=
  (rfl)

/-- The horizontal coframe form `dxⁱ` is the exterior derivative of the base coordinate. -/
theorem extDeriv_algebraMap_X_base (i : ι) :
    extDeriv R (PolynomialJet R ι α) (algebraMap (PolynomialJet R ι α) (Forms R ι α)
      (X (Sum.inl i))) = horizontalForm R α i :=
  extDeriv_algebraMap _

/-- The horizontal coframe forms are closed. -/
@[simp]
theorem extDeriv_horizontalForm (i : ι) :
    extDeriv R (PolynomialJet R ι α) (horizontalForm R α i) = 0 :=
  extDeriv_ι_D _

/-- The horizontal coframe forms square to zero. -/
@[simp]
theorem horizontalForm_mul_self (i : ι) : horizontalForm R α i * horizontalForm R α i = 0 :=
  ExteriorAlgebra.ι_sq_zero _

/-- The horizontal coframe forms have exterior degree one. -/
theorem horizontalForm_mem_grading (i : ι) :
    horizontalForm R α i ∈ grading R (PolynomialJet R ι α) 1 :=
  ι_mem_grading_one _

/-! ### The total derivative on forms -/

/-- The total derivative `Dᵢ` acting on forms: the Lie derivative along the total derivation
`PolynomialJet.totalDeriv i`. It extends `Dᵢ` on functions, commutes with `d`, annihilates `dxʲ`
and sends `duᵃ_I` to `duᵃ_(I+eᵢ)`. -/
def totalLieDeriv (i : ι) : Module.End R (Forms R ι α) :=
  (totalDeriv i).deRhamLieDeriv (Derivation.D_apply_algebraMap_eq_zero (totalDeriv i))

@[simp]
theorem totalLieDeriv_algebraMap (i : ι) (f : PolynomialJet R ι α) :
    totalLieDeriv i (algebraMap (PolynomialJet R ι α) (Forms R ι α) f) =
      algebraMap _ _ (totalDeriv i f) :=
  Derivation.deRhamLieDeriv_algebraMap _ _ f

@[simp]
theorem totalLieDeriv_ι_D (i : ι) (f : PolynomialJet R ι α) :
    totalLieDeriv i (ExteriorAlgebra.ι _ (KaehlerDifferential.D R _ f) : Forms R ι α) =
      ExteriorAlgebra.ι _ (KaehlerDifferential.D R _ (totalDeriv i f)) := by
  simp [totalLieDeriv, Derivation.kaehlerLieDeriv_D]

@[simp]
theorem totalLieDeriv_mul (i : ι) (x y : Forms R ι α) :
    totalLieDeriv i (x * y) = totalLieDeriv i x * y + x * totalLieDeriv i y :=
  Derivation.deRhamLieDeriv_mul _ _ x y

@[simp]
theorem totalLieDeriv_smul (i : ι) (f : PolynomialJet R ι α) (x : Forms R ι α) :
    totalLieDeriv i (f • x) = totalDeriv i f • x + f • totalLieDeriv i x :=
  Derivation.deRhamLieDeriv_smul _ _ f x

/-- The total derivative on forms commutes with the exterior derivative. -/
theorem extDeriv_totalLieDeriv (i : ι) (x : Forms R ι α) :
    extDeriv R _ (totalLieDeriv i x) = totalLieDeriv i (extDeriv R _ x) :=
  Derivation.extDeriv_deRhamLieDeriv _ _ x

/-- Total derivatives on forms commute. -/
theorem totalLieDeriv_comm (i j : ι) (x : Forms R ι α) :
    totalLieDeriv i (totalLieDeriv j x) = totalLieDeriv j (totalLieDeriv i x) :=
  Derivation.commute_deRhamLieDeriv_of_lie_eq_zero _ _
    (Derivation.ext fun p ↦ by simp [Derivation.commutator_apply, totalDeriv_comm]) x

/-- The total derivative on forms preserves the exterior degree. -/
theorem totalLieDeriv_mem_grading (i : ι) {p : ℤ} {x : Forms R ι α}
    (hx : x ∈ grading R (PolynomialJet R ι α) p) :
    totalLieDeriv i x ∈ grading R (PolynomialJet R ι α) p :=
  Derivation.deRhamLieDeriv_mem_grading _ _ hx

/-- The total derivative annihilates the horizontal coframe, `Dᵢ dxʲ = 0`. -/
@[simp]
theorem totalLieDeriv_horizontalForm (i j : ι) :
    totalLieDeriv i (horizontalForm R α j) = 0 := by
  classical
  rw [horizontalForm, totalLieDeriv_ι_D, totalDeriv_X_base]
  split <;> simp

/-! ### Contact forms -/

variable [Fintype ι]

variable (R) in
/-- The contact form `θᵃ_I = duᵃ_I - ∑ᵢ uᵃ_(I+eᵢ) dxⁱ`, the vertical part of `duᵃ_I`. -/
def contactForm (a : α) (I : ι →₀ ℕ) : Forms R ι α :=
  ExteriorAlgebra.ι _ (KaehlerDifferential.D R _ (X (Sum.inr (a, I)))) -
    ∑ i, (X (Sum.inr (a, I + Finsupp.single i 1)) : PolynomialJet R ι α) • horizontalForm R α i

theorem contactForm_def (a : α) (I : ι →₀ ℕ) :
    contactForm R a I =
      ExteriorAlgebra.ι _ (KaehlerDifferential.D R _ (X (Sum.inr (a, I)))) -
        ∑ i, (X (Sum.inr (a, I + Finsupp.single i 1)) : PolynomialJet R ι α) •
          horizontalForm R α i :=
  (rfl)

/-- The total derivative of a contact form raises its multi-index. -/
@[simp]
theorem totalLieDeriv_contactForm (i : ι) (a : α) (I : ι →₀ ℕ) :
    totalLieDeriv i (contactForm R a I) = contactForm R a (I + Finsupp.single i 1) := by
  simp only [contactForm, map_sub, map_sum, totalLieDeriv_ι_D, totalDeriv_X_field,
    totalLieDeriv_smul, totalLieDeriv_horizontalForm, smul_zero, add_zero]
  simp only [add_right_comm I]

/-- Contact forms have exterior degree one. -/
theorem contactForm_mem_grading (a : α) (I : ι →₀ ℕ) :
    contactForm R a I ∈ grading R (PolynomialJet R ι α) 1 :=
  sub_mem (ι_mem_grading_one _) <| Submodule.sum_mem _ fun i _ ↦ mem_grading_iff.mpr <|
    Submodule.smul_mem _ _ (mem_grading_iff.mp (horizontalForm_mem_grading i))

/-! ### The horizontal differential -/

variable (R ι α) in
/-- The horizontal differential `d_H ω = ∑ᵢ dxⁱ ∧ Dᵢ ω` of the variational bicomplex. -/
def horizontalDiff : Module.End R (Forms R ι α) :=
  ∑ i, LinearMap.mulLeft R (horizontalForm R α i) ∘ₗ totalLieDeriv i

theorem horizontalDiff_apply (ω : Forms R ι α) :
    horizontalDiff R ι α ω = ∑ i, horizontalForm R α i * totalLieDeriv i ω := by
  simp [horizontalDiff]

/-- The horizontal differential of a function is `d_H f = ∑ᵢ (Dᵢ f) dxⁱ`. -/
@[simp]
theorem horizontalDiff_algebraMap (f : PolynomialJet R ι α) :
    horizontalDiff R ι α (algebraMap _ (Forms R ι α) f) =
      ∑ i, totalDeriv i f • horizontalForm R α i := by
  simp only [horizontalDiff_apply, totalLieDeriv_algebraMap, Algebra.smul_def, Algebra.commutes]

/-- The horizontal coframe is `d_H`-closed, `d_H dxʲ = 0`. -/
@[simp]
theorem horizontalDiff_horizontalForm (j : ι) :
    horizontalDiff R ι α (horizontalForm R α j) = 0 := by
  simp [horizontalDiff_apply]

/-- The horizontal differential of a contact form is `d_H θᵃ_I = ∑ᵢ dxⁱ ∧ θᵃ_(I+eᵢ)`. -/
@[simp]
theorem horizontalDiff_contactForm (a : α) (I : ι →₀ ℕ) :
    horizontalDiff R ι α (contactForm R a I) =
      ∑ i, horizontalForm R α i * contactForm R a (I + Finsupp.single i 1) := by
  simp [horizontalDiff_apply]

/-- **The graded Leibniz rule** for the horizontal differential. -/
theorem horizontalDiff_mul (x y : Forms R ι α) :
    horizontalDiff R ι α (x * y) =
      horizontalDiff R ι α x * y + involute (Q := 0) x * horizontalDiff R ι α y := by
  simp only [horizontalDiff_apply, totalLieDeriv_mul, mul_add, Finset.sum_add_distrib,
    Finset.sum_mul, Finset.mul_sum, ← mul_assoc]
  congr 1
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [horizontalForm, ExteriorAlgebra.ι_mul_eq_involute_mul]

/-- The horizontal differential raises the exterior degree by one. -/
theorem horizontalDiff_mem_grading {p : ℤ} {x : Forms R ι α}
    (hx : x ∈ grading R (PolynomialJet R ι α) p) :
    horizontalDiff R ι α x ∈ grading R (PolynomialJet R ι α) (p + 1) := by
  rw [horizontalDiff_apply]
  exact Submodule.sum_mem _ fun i _ ↦ mem_grading_iff.mpr <|
    TauCeti.ExteriorAlgebra.ι_mul_mem_integerGrading _
      (mem_grading_iff.mp (totalLieDeriv_mem_grading i hx))

/-- **The horizontal differential squares to zero**: `d_H² = 0`. -/
@[simp]
theorem horizontalDiff_horizontalDiff (ω : Forms R ι α) :
    horizontalDiff R ι α (horizontalDiff R ι α ω) = 0 := by
  simp only [horizontalDiff_apply, map_sum, totalLieDeriv_mul, totalLieDeriv_horizontalForm,
    zero_mul, zero_add, ← mul_assoc]
  refine Finset.sum_sum_eq_zero_of_diag _ (fun i _ ↦ by simp) fun i _ j _ _ ↦ ?_
  rw [totalLieDeriv_comm j i, ← add_mul, horizontalForm, horizontalForm,
    ExteriorAlgebra.ι_add_mul_swap, zero_mul]

/-- **The horizontal differential anticommutes with the exterior derivative**. -/
theorem extDeriv_horizontalDiff (ω : Forms R ι α) :
    extDeriv R _ (horizontalDiff R ι α ω) = -horizontalDiff R ι α (extDeriv R _ ω) := by
  simp [horizontalDiff_apply, extDeriv_mul, horizontalForm_def, extDeriv_totalLieDeriv]

/-! ### The vertical differential -/

variable (R ι α) in
/-- The vertical differential `d_V = d - d_H` of the variational bicomplex. -/
def verticalDiff : Module.End R (Forms R ι α) :=
  extDeriv R (PolynomialJet R ι α) - horizontalDiff R ι α

theorem verticalDiff_apply (ω : Forms R ι α) :
    verticalDiff R ι α ω = extDeriv R _ ω - horizontalDiff R ι α ω := by
  rw [verticalDiff, LinearMap.sub_apply]

/-- The exterior derivative splits as `d = d_H + d_V`. -/
theorem horizontalDiff_add_verticalDiff :
    horizontalDiff R ι α + verticalDiff R ι α = extDeriv R (PolynomialJet R ι α) :=
  add_sub_cancel _ _

/-- **The graded Leibniz rule** for the vertical differential. -/
theorem verticalDiff_mul (x y : Forms R ι α) :
    verticalDiff R ι α (x * y) =
      verticalDiff R ι α x * y + involute (Q := 0) x * verticalDiff R ι α y := by
  simp only [verticalDiff_apply, extDeriv_mul, horizontalDiff_mul, sub_mul, mul_sub]
  abel

/-- The vertical differential raises the exterior degree by one. -/
theorem verticalDiff_mem_grading {p : ℤ} {x : Forms R ι α}
    (hx : x ∈ grading R (PolynomialJet R ι α) p) :
    verticalDiff R ι α x ∈ grading R (PolynomialJet R ι α) (p + 1) :=
  sub_mem (extDeriv_mem_grading hx) (horizontalDiff_mem_grading hx)

/-- **The vertical differential squares to zero**: `d_V² = 0`. -/
@[simp]
theorem verticalDiff_verticalDiff (ω : Forms R ι α) :
    verticalDiff R ι α (verticalDiff R ι α ω) = 0 := by
  simp only [verticalDiff_apply, map_sub, extDeriv_extDeriv, extDeriv_horizontalDiff,
    horizontalDiff_horizontalDiff]
  abel

/-- **The horizontal and vertical differentials anticommute**: `d_V d_H = -d_H d_V`. -/
theorem verticalDiff_horizontalDiff (ω : Forms R ι α) :
    verticalDiff R ι α (horizontalDiff R ι α ω) =
      -horizontalDiff R ι α (verticalDiff R ι α ω) := by
  simp only [verticalDiff_apply, map_sub, extDeriv_horizontalDiff, horizontalDiff_horizontalDiff]
  abel

/-- Base coordinates are `d_V`-closed, `d_V xⁱ = 0`. -/
@[simp]
theorem verticalDiff_algebraMap_X_base (i : ι) :
    verticalDiff R ι α (algebraMap (PolynomialJet R ι α) (Forms R ι α) (X (Sum.inl i))) =
      0 := by
  classical
  simp [verticalDiff_apply, totalDeriv_X_base, horizontalForm_def]

/-- The vertical differential of a field coordinate is its contact form, `d_V uᵃ_I = θᵃ_I`. -/
@[simp]
theorem verticalDiff_algebraMap_X_field (a : α) (I : ι →₀ ℕ) :
    verticalDiff R ι α (algebraMap (PolynomialJet R ι α) (Forms R ι α) (X (Sum.inr (a, I)))) =
      contactForm R a I := by
  simp [verticalDiff_apply, contactForm, extDeriv_algebraMap]

/-- The horizontal coframe is `d_V`-closed, `d_V dxⁱ = 0`. -/
@[simp]
theorem verticalDiff_horizontalForm (i : ι) :
    verticalDiff R ι α (horizontalForm R α i) = 0 := by
  simp [verticalDiff_apply]

/-- Contact forms are `d_V`-closed, `d_V θᵃ_I = 0`. -/
@[simp]
theorem verticalDiff_contactForm (a : α) (I : ι →₀ ℕ) :
    verticalDiff R ι α (contactForm R a I) = 0 := by
  rw [← verticalDiff_algebraMap_X_field, verticalDiff_verticalDiff]

/-- On functions the vertical differential is a derivation. -/
private def verticalDiffDerivation :
    Derivation R (PolynomialJet R ι α) (Forms R ι α) :=
  Derivation.mk' (verticalDiff R ι α ∘ₗ (Algebra.linearMap _ _).restrictScalars R) fun f g ↦ by
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.coe_restrictScalars,
      Algebra.linearMap_apply, map_mul, verticalDiff_mul, AlgHom.commutes, Algebra.smul_def]
    rw [Algebra.commutes g, add_comm]

private theorem verticalDiffDerivation_apply (f : PolynomialJet R ι α) :
    verticalDiffDerivation f = verticalDiff R ι α (algebraMap _ (Forms R ι α) f) :=
  rfl

/-- The vertical differential of a function is `d_V f = ∑_(a,I) (∂f/∂uᵃ_I) θᵃ_I`, the sum running
over the field coordinates occurring in `f`. -/
theorem verticalDiff_algebraMap (f : PolynomialJet R ι α) :
    verticalDiff R ι α (algebraMap _ (Forms R ι α) f) =
      ∑ aI ∈ f.vars.toRight, pderiv (Sum.inr aI) f • contactForm R aI.1 aI.2 := by
  classical
  -- the derivation `g ↦ ∑ v ∈ f.vars, (∂g/∂v) • d_V v` agrees with `d_V` on the variables of `f`
  set c : _ → Forms R ι α := fun v ↦ verticalDiffDerivation (X v) with hc
  have key : verticalDiffDerivation f = ∑ v ∈ f.vars, pderiv v f • c v := by
    let D : Derivation R (PolynomialJet R ι α) (Forms R ι α) :=
      ∑ v ∈ f.vars, (LinearMap.toSpanSingleton _ _ (c v)).compDer (pderiv v)
    have hD : ∀ g, D g = ∑ v ∈ f.vars, pderiv v g • c v := fun g ↦ by simp [D]
    rw [← hD]
    refine derivation_eq_of_forall_mem_vars fun i hi ↦ ?_
    simp [hD, hc, pderiv_X, Pi.single_apply, hi]
  rw [← verticalDiffDerivation_apply, key]
  conv_lhs => rw [← f.vars.toLeft_disjSum_toRight, Finset.sum_disjSum]
  simp only [hc, verticalDiffDerivation_apply, verticalDiff_algebraMap_X_base, smul_zero,
    Finset.sum_const_zero, zero_add]
  exact Finset.sum_congr rfl fun aI _ ↦ by rw [← verticalDiff_algebraMap_X_field]

/-! ### The bicomplex as differential graded algebras -/

/-- **The horizontal differential makes the forms a differential graded algebra** for the exterior
degree. -/
theorem isDGAlgebra_horizontalDiff :
    TauCeti.IsDGAlgebra (grading R (PolynomialJet R ι α)) (horizontalDiff R ι α) where
  map_mem := horizontalDiff_mem_grading
  sq_zero := horizontalDiff_horizontalDiff
  leibniz hx y := by rw [horizontalDiff_mul, involute_of_mem_grading hx, smul_mul_assoc]

/-- **The vertical differential makes the forms a differential graded algebra** for the exterior
degree. -/
theorem isDGAlgebra_verticalDiff :
    TauCeti.IsDGAlgebra (grading R (PolynomialJet R ι α)) (verticalDiff R ι α) where
  map_mem := verticalDiff_mem_grading
  sq_zero := verticalDiff_verticalDiff
  leibniz hx y := by rw [verticalDiff_mul, involute_of_mem_grading hx, smul_mul_assoc]

end

end PolynomialJet

end TauCeti
