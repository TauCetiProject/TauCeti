module

public import TauCeti.RingTheory.FormalGlueing.Lifting

/-!
# Gluing module homomorphisms across a formal neighbourhood

Let `R → S` be faithfully flat and induce an isomorphism `R/I ≅ S/IS`, where `I` is generated
by a finite set `G`. A homomorphism between two `R`-modules is uniquely determined by its base
change to `S` and its localizations at the elements of `G`. Conversely, homomorphisms on these
pieces glue whenever they agree after localization of the base change.

`LinearMap.existsUnique_formalGlueing_lift` proves this morphism-reconstruction assertion
without finiteness assumptions on either module. It is the full-faithfulness part of formal
module gluing for faithfully flat maps, in particular for completion of a Noetherian local ring.
The assertion concerns morphisms between modules already defined over `R`; constructing a
module from compatible modules on the pieces is a separate essential-surjectivity assertion.

The compatibility square is stated using `IsLocalizedModule.map` on the canonical localized
modules. Maps between localized modules are written as `R`-linear maps;
they automatically respect inverse multiplication by the elements being inverted.

## References

* The Stacks Project, Proposition 15.91.16 (05ER), full faithfulness, here for faithfully flat
  ring maps. The element-reconstruction input is Lemma 15.91.9 (05EK), as implemented by
  `TensorProduct.mem_range_mk_one_iff_locally_mem_range`.
-/

public section

open TensorProduct Function

namespace LinearMap

variable {R S M N : Type*} [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  [Module.FaithfullyFlat R S] {G : Finset R}

/-- **Gluing module homomorphisms.** Suppose `R → S` is faithfully flat and induces an
isomorphism modulo the ideal generated by `G`. An `S`-linear map on the base changes and maps
on the localizations at the generators come from a unique `R`-linear map if their localization
squares commute. Neither module needs to be finitely generated. -/
@[stacks 05ER "full faithfulness for faithfully flat ring maps"]
theorem existsUnique_formalGlueing_lift
    (fS : S ⊗[R] M →ₗ[S] S ⊗[R] N)
    (fg : (g : G) → LocalizedModule (.powers g.1) M →ₗ[R] LocalizedModule (.powers g.1) N)
    (hI : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hcompat : ∀ g : G,
      IsLocalizedModule.map (.powers g.1)
          (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] M))
          (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] N)) (fS.restrictScalars R) ∘ₗ
        IsLocalizedModule.map (.powers g.1) (LocalizedModule.mkLinearMap (.powers g.1) M)
          (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] M)) (TensorProduct.mk R S M 1) =
        IsLocalizedModule.map (.powers g.1) (LocalizedModule.mkLinearMap (.powers g.1) N)
          (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] N)) (TensorProduct.mk R S N 1) ∘ₗ
            fg g) :
    ∃! f : M →ₗ[R] N, f.baseChange S = fS ∧
      ∀ g : G, IsLocalizedModule.map (.powers g.1)
        (LocalizedModule.mkLinearMap (.powers g.1) M)
        (LocalizedModule.mkLinearMap (.powers g.1) N) f = fg g := by
  have hη := Module.FaithfullyFlat.tensorProduct_mk_injective (A := R) (B := S) N
  -- Apply element reconstruction to the image of each element of the source.
  have hex (m : M) := (TensorProduct.existsUnique_formalGlueing_lift (fS (1 ⊗ₜ m))
    (fun g ↦ fg g (LocalizedModule.mkLinearMap (.powers g.1) M m)) hI (fun g ↦ by
      have h := congrArg (fun k ↦ k (LocalizedModule.mkLinearMap (.powers g.1) M m))
        (hcompat g)
      simpa only [LinearMap.comp_apply, IsLocalizedModule.map_apply,
        LinearMap.restrictScalars_apply, TensorProduct.mk_apply] using h.symm)).exists
  choose f hf using hex
  -- Faithful flatness makes the pointwise lift linear.
  let F : M →ₗ[R] N :=
    { toFun := f
      map_add' := fun x y ↦ hη (by simp [fun m ↦ (hf m).1, tmul_add])
      map_smul' := fun r m ↦ hη (by simp [fun m ↦ (hf m).1, tmul_smul]) }
  have hF (m : M) : (1 : S) ⊗ₜ[R] F m = fS (1 ⊗ₜ m) := (hf m).1
  have hbase : F.baseChange S = fS := by
    ext m
    exact hF m
  have hloc (g : G) : IsLocalizedModule.map (.powers g.1)
      (LocalizedModule.mkLinearMap (.powers g.1) M)
      (LocalizedModule.mkLinearMap (.powers g.1) N) F = fg g := by
    apply IsLocalizedModule.linearMap_ext (.powers g.1)
      (LocalizedModule.mkLinearMap (.powers g.1) M)
      (LocalizedModule.mkLinearMap (.powers g.1) N)
    ext m
    simpa only [LinearMap.comp_apply, IsLocalizedModule.map_apply, F,
      LinearMap.coe_mk, AddHom.coe_mk] using (hf m).2 g
  refine ⟨F, ⟨hbase, hloc⟩, fun F' hF' ↦ ?_⟩
  ext m
  apply hη
  have h := LinearMap.congr_fun (hF'.1.trans hbase.symm) (1 ⊗ₜ[R] m)
  simpa using h

end LinearMap
