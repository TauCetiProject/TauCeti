/-!
# Formal glueing of algebras

Let `R → S` be flat and induce an isomorphism `R/I ≅ S/IS`, where `I` is generated by a finite
set `G ⊆ R`. A glueing datum of algebras consists of an `R`-algebra `M`, thought of as the
functions on the open complement of `V(I)`, an `S`-algebra `N` on the formal neighbourhood of
`V(I)`, and algebra maps `f : M → P` and `g : N → P` into an `S`-algebra `P`, where `f` exhibits
`P` as the base change `S ⊗[R] M` and `g` becomes bijective after inverting each element of `G`.

The glued algebra `B` is the fibre product of `M` and `N` over `P`: the subalgebra
`AlgHom.equalizer (f.comp (AlgHom.fst R M N)) ((g.restrictScalars R).comp (AlgHom.snd R M N))`
of `M × N` consisting of the pairs `(m, n)` with `f m = g n`. Its underlying submodule is the
module of compatible pairs `ker (f.coprod (-g))` reconstructed in
`TauCeti.RingTheory.FormalGlueing.Reconstruction` (`AlgHom.toSubmodule_equalizer_eq_ker_coprod`),
so module reconstruction applies to it: the second projection exhibits `N` as the base change of
`B` to `S`, and the first projection becomes bijective after inverting any element of `R` whose
image in `S` makes `g` bijective. Through `IsBaseChange.algEquiv` and
`AlgHom.algEquivOfLocalizedBijective` these give algebra isomorphisms `S ⊗[R] B ≃ₐ[S] N` and
`R_r ⊗[R] B ≃ₐ[R_r] R_r ⊗[R] M`. The glued algebra is finite over `R` when `N` and the
localizations `M_r`, `r ∈ G`, are finite, and étale when they are moreover étale.

The main example is the completion `R̂` of a Noetherian ring `R` along an ideal `I`. The
statements for the completion choose a finite generating set of `I` and assume `g` bijective after
inverting every element of `I`. For a Noetherian local ring `A` and `I` its maximal ideal, this is
the algebraic step in extending a finite cover `V` of the punctured spectrum of `A` from the
completion: `M` is the ring of functions of `V`, whose localization at `r` is the ring of
functions of the part of `V` over the basic open `D(r)`, and `N` is the ring of a finite cover of
`Spec Â` restricting to the base change of `V`.

## Main results

* `AlgHom.bijective_localizedMap_fst_equalizer`: the fibre product recovers `M` after inverting
  any submonoid at which `g` becomes bijective.
* `AlgHom.isBaseChange_snd_equalizer_of_formalGlueing`: the formal piece `N` is the base change of
  the glued algebra.
* `AlgHom.finite_equalizer_of_formalGlueing`, `AlgHom.etale_equalizer_of_formalGlueing`:
  finiteness and étaleness of the glued algebra.
* `AlgHom.isBaseChange_snd_equalizer_of_adicCompletion`,
  `AlgHom.finite_equalizer_of_adicCompletion`, `AlgHom.etale_equalizer_of_adicCompletion`: the
  same along the completion of a Noetherian ring.

## References

* [The Stacks Project, Proposition 15.91.16](https://stacks.math.columbia.edu/tag/05ER), formal
  glueing of modules.
* [The Stacks Project, Remark 15.91.20](https://stacks.math.columbia.edu/tag/05EU), formal glueing
  of algebras and of finite algebras.
* [The Stacks Project, Lemma 58.19.3](https://stacks.math.columbia.edu/tag/0BLH), extension of
  finite covers of the punctured spectrum from the completion.
-/

public section

open Function TensorProduct

namespace AlgHom

section Ring

variable {R S M N P : Type*} [CommRing R] [CommRing S] [Algebra R S]
  [Ring M] [Algebra R M] [Ring N] [Algebra R N] [Algebra S N] [IsScalarTower R S N]
  [Ring P] [Algebra R P] [Algebra S P] [IsScalarTower R S P]

/-- The subalgebra of pairs `(m, n)` with `f m = g n` has underlying submodule the kernel of
`f.coprod (-g)`, the module of compatible pairs of formal glueing. -/
theorem toSubmodule_equalizer_eq_ker_coprod (f : M →ₐ[R] P) (g : N →ₐ[S] P) :
    Subalgebra.toSubmodule
        (equalizer (f.comp (fst R M N)) ((g.restrictScalars R).comp (snd R M N))) =
      (f.toLinearMap.coprod (-g.toLinearMap.restrictScalars R)).ker := by
  ext x
  simp [mem_equalizer, add_neg_eq_zero]

/-- The identification of the subalgebra of compatible pairs with the module of compatible
pairs, as a linear equivalence that is the identity on underlying pairs. -/
private noncomputable def equalizerLinearEquivKer (f : M →ₐ[R] P) (g : N →ₐ[S] P) :
    equalizer (f.comp (fst R M N)) ((g.restrictScalars R).comp (snd R M N)) ≃ₗ[R]
      (f.toLinearMap.coprod (-g.toLinearMap.restrictScalars R)).ker :=
  (Subalgebra.toSubmoduleEquiv _).symm.trans
    (LinearEquiv.ofEq _ _ (toSubmodule_equalizer_eq_ker_coprod f g))

-- `equalizerLinearEquivKer` is the identity on underlying pairs, so both sides send a compatible
-- pair to its second component, by definition.
private theorem snd_comp_equalizer_val (f : M →ₐ[R] P) (g : N →ₐ[S] P) :
    ((snd R M N).comp
        (equalizer (f.comp (fst R M N)) ((g.restrictScalars R).comp (snd R M N))).val).toLinearMap =
      (LinearMap.snd R M N).domRestrict
          (f.toLinearMap.coprod (-g.toLinearMap.restrictScalars R)).ker ∘ₗ
        (equalizerLinearEquivKer f g).toLinearMap :=
  rfl

-- As for `snd_comp_equalizer_val`, both sides send a compatible pair to its first component.
private theorem fst_comp_equalizer_val (f : M →ₐ[R] P) (g : N →ₐ[S] P) :
    ((fst R M N).comp
        (equalizer (f.comp (fst R M N)) ((g.restrictScalars R).comp (snd R M N))).val).toLinearMap =
      (LinearMap.fst R M N).domRestrict
          (f.toLinearMap.coprod (-g.toLinearMap.restrictScalars R)).ker ∘ₗ
        (equalizerLinearEquivKer f g).toLinearMap :=
  rfl

/-- **Localization of a fibre product of algebras.** If `g : N → P` becomes bijective after
inverting the image of a submonoid `T` of `R`, then so does the first projection to `M` from the
subalgebra of pairs `(m, n)` with `f m = g n`. -/
theorem bijective_localizedMap_fst_equalizer (f : M →ₐ[R] P) (g : N →ₐ[S] P)
    (T : Submonoid R)
    (hg : Bijective (LocalizedModule.map (Algebra.algebraMapSubmonoid S T) g.toLinearMap)) :
    Bijective (LocalizedModule.map T ((fst R M N).comp
      (equalizer (f.comp (fst R M N))
        ((g.restrictScalars R).comp (snd R M N))).val).toLinearMap) := by
  rw [fst_comp_equalizer_val, LocalizedModule.map_comp]
  exact (LinearMap.bijective_localizedMap_fst_ker_coprod _ _ T hg).comp
    ⟨LocalizedModule.map_injective _ _ (equalizerLinearEquivKer f g).injective,
      LocalizedModule.map_surjective _ _ (equalizerLinearEquivKer f g).surjective⟩

/-- The algebra isomorphism `R_r ⊗[R] B ≃ₐ[R_r] R_r ⊗[R] M` induced by the first projection from
the subalgebra `B` of pairs `(m, n)` with `f m = g n`, when `g` becomes bijective after inverting
the image of `r`. -/
private noncomputable def equalizerAwayAlgEquiv (f : M →ₐ[R] P) (g : N →ₐ[S] P) (r : R)
    (hg : Bijective (LocalizedModule.map (.powers (algebraMap R S r)) g.toLinearMap)) :
    Localization.Away r ⊗[R] equalizer (f.comp (fst R M N))
        ((g.restrictScalars R).comp (snd R M N)) ≃ₐ[Localization.Away r]
      Localization.Away r ⊗[R] M :=
  (fst R M N).comp _ |>.algEquivOfLocalizedBijective (.powers r) (Localization.Away r)
    (bijective_localizedMap_fst_equalizer f g _ (by rwa [Algebra.algebraMapSubmonoid_powers]))

variable [Module.Flat R S]

/-- **Formal glueing of algebras.** Let `R → S` be flat and induce `R/I ≅ S/IS`, with `I`
generated by a finite set `G`. Let `f : M → P` exhibit the `S`-algebra `P` as the base change of
an `R`-algebra `M`, and let `g : N → P` be a map of `S`-algebras that becomes bijective after
inverting each element of `G`. Then the second projection to `N` from the subalgebra of pairs
`(m, n)` with `f m = g n` exhibits `N` as its base change to `S`. -/
@[stacks 05EU "the formal piece of a glueing datum of algebras is the base change of the glued
algebra"]
theorem isBaseChange_snd_equalizer_of_formalGlueing (f : M →ₐ[R] P) (g : N →ₐ[S] P)
    (hf : IsBaseChange S f.toLinearMap) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ r ∈ G,
      Bijective (LocalizedModule.map (.powers (algebraMap R S r)) g.toLinearMap)) :
    IsBaseChange S ((snd R M N).comp
      (equalizer (f.comp (fst R M N))
        ((g.restrictScalars R).comp (snd R M N))).val).toLinearMap := by
  rw [snd_comp_equalizer_val]
  exact IsBaseChange.comp_equiv _ _
    (LinearMap.isBaseChange_snd_ker_coprod_of_formalGlueing _ _ hf G hG hloc)

/-- **Finiteness of an algebra glued from finite pieces.** In the situation of
`AlgHom.isBaseChange_snd_equalizer_of_formalGlueing`, if `N` is finite over `S` and the
localization of `M` at each element of `G` is finite, then the subalgebra of pairs `(m, n)` with
`f m = g n` is finite over `R`. -/
@[stacks 05EU "finiteness of the algebra glued from finite pieces"]
theorem finite_equalizer_of_formalGlueing (f : M →ₐ[R] P) (g : N →ₐ[S] P)
    (hf : IsBaseChange S f.toLinearMap) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ r ∈ G, Bijective (LocalizedModule.map (.powers (algebraMap R S r)) g.toLinearMap))
    [Module.Finite S N]
    (hM : ∀ r ∈ G, Module.Finite (Localization.Away r) (Localization.Away r ⊗[R] M)) :
    Module.Finite R
      (equalizer (f.comp (fst R M N)) ((g.restrictScalars R).comp (snd R M N))) :=
  (isBaseChange_snd_equalizer_of_formalGlueing f g hf G hG hloc).finite_of_formalGlueing G hG
    (fun r hr ↦ (equalizerAwayAlgEquiv f g r (hloc r hr)).toLinearEquiv) hM

end Ring

section CommRing

variable {R S M N P : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
  [CommRing M] [Algebra R M] [CommRing N] [Algebra R N] [Algebra S N] [IsScalarTower R S N]
  [Ring P] [Algebra R P] [Algebra S P] [IsScalarTower R S P]

/-- **Étaleness of an algebra glued from finite étale pieces.** In the situation of
`AlgHom.isBaseChange_snd_equalizer_of_formalGlueing`, if `N` is finite étale over `S` and the
localization of `M` at each element of `G` is finite étale, then the subalgebra of pairs `(m, n)`
with `f m = g n` is étale over `R`; it is finite by `AlgHom.finite_equalizer_of_formalGlueing`. -/
@[stacks 05EU "étaleness of the algebra glued from finite étale pieces"]
theorem etale_equalizer_of_formalGlueing (f : M →ₐ[R] P) (g : N →ₐ[S] P)
    (hf : IsBaseChange S f.toLinearMap) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ r ∈ G, Bijective (LocalizedModule.map (.powers (algebraMap R S r)) g.toLinearMap))
    [Module.Finite S N] [Algebra.Etale S N]
    (hM : ∀ r ∈ G, Module.Finite (Localization.Away r) (Localization.Away r ⊗[R] M) ∧
      Algebra.Etale (Localization.Away r) (Localization.Away r ⊗[R] M)) :
    Algebra.Etale R
      (equalizer (f.comp (fst R M N)) ((g.restrictScalars R).comp (snd R M N))) :=
  (IsBaseChange.finite_etale_of_formalGlueing
    (isBaseChange_snd_equalizer_of_formalGlueing f g hf G hG hloc) G hG
    (fun r hr ↦ equalizerAwayAlgEquiv f g r (hloc r hr)) hM).2

end CommRing

section AdicCompletion

/-- A finite generating set `G` of an ideal `I` of a Noetherian ring, together with the bijectivity
of `R ⧸ (G) → R̂ ⧸ (G) R̂`, in the form in which the formal glueing theorems take it. -/
private theorem exists_finset_span_eq_bijective_quotientMap {R : Type*} [CommRing R]
    [IsNoetherianRing R] (I : Ideal R) :
    ∃ G : Finset R, Ideal.span (G : Set R) = I ∧
      Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map
        (algebraMap R (AdicCompletion I R))) (algebraMap R (AdicCompletion I R))
          Ideal.le_comap_map) := by
  obtain ⟨G, rfl⟩ := (IsNoetherian.noetherian I : I.FG)
  exact ⟨G, rfl, AdicCompletion.quotientMap_algebraMap_bijective_one
    (Submodule.fg_span G.finite_toSet)⟩

section Ring

variable {R M N P : Type*} [CommRing R] [IsNoetherianRing R] {I : Ideal R}
  [Ring M] [Algebra R M] [Ring N] [Algebra R N] [Algebra (AdicCompletion I R) N]
  [IsScalarTower R (AdicCompletion I R) N] [Ring P] [Algebra R P]
  [Algebra (AdicCompletion I R) P] [IsScalarTower R (AdicCompletion I R) P]

/-- **Formal glueing of algebras along the completion.** Let `R` be Noetherian with completion `R̂`
along an ideal `I`. Let `f : M → P` exhibit the `R̂`-algebra `P` as the base change of an
`R`-algebra `M`, and let `g : N → P` be a map of `R̂`-algebras that becomes bijective after
inverting each element of `I`. Then the second projection to `N` from the subalgebra of pairs
`(m, n)` with `f m = g n` exhibits `N` as its base change to `R̂`. -/
@[stacks 05EU "the formal piece of a glueing datum of algebras along the completion"]
theorem isBaseChange_snd_equalizer_of_adicCompletion (f : M →ₐ[R] P)
    (g : N →ₐ[AdicCompletion I R] P) (hf : IsBaseChange (AdicCompletion I R) f.toLinearMap)
    (hloc : ∀ r ∈ I, Bijective (LocalizedModule.map
      (.powers (algebraMap R (AdicCompletion I R) r)) g.toLinearMap)) :
    IsBaseChange (AdicCompletion I R) ((snd R M N).comp
      (equalizer (f.comp (fst R M N))
        ((g.restrictScalars R).comp (snd R M N))).val).toLinearMap := by
  obtain ⟨G, hGI, hG⟩ := exists_finset_span_eq_bijective_quotientMap I
  exact isBaseChange_snd_equalizer_of_formalGlueing f g hf G hG
    fun r hr ↦ hloc r (hGI.le (Ideal.subset_span hr))

/-- **Finiteness of an algebra glued along the completion.** In the situation of
`AlgHom.isBaseChange_snd_equalizer_of_adicCompletion`, if `N` is finite over `R̂` and the
localization of `M` at each element of `I` is finite, then the subalgebra of pairs `(m, n)` with
`f m = g n` is finite over `R`. -/
@[stacks 0BLH "the algebraic step: the glued algebra is finite"]
theorem finite_equalizer_of_adicCompletion (f : M →ₐ[R] P)
    (g : N →ₐ[AdicCompletion I R] P) (hf : IsBaseChange (AdicCompletion I R) f.toLinearMap)
    (hloc : ∀ r ∈ I, Bijective (LocalizedModule.map
      (.powers (algebraMap R (AdicCompletion I R) r)) g.toLinearMap))
    [Module.Finite (AdicCompletion I R) N]
    (hM : ∀ r ∈ I, Module.Finite (Localization.Away r) (Localization.Away r ⊗[R] M)) :
    Module.Finite R
      (equalizer (f.comp (fst R M N)) ((g.restrictScalars R).comp (snd R M N))) := by
  obtain ⟨G, hGI, hG⟩ := exists_finset_span_eq_bijective_quotientMap I
  exact finite_equalizer_of_formalGlueing f g hf G hG
    (fun r hr ↦ hloc r (hGI.le (Ideal.subset_span hr)))
    fun r hr ↦ hM r (hGI.le (Ideal.subset_span hr))

end Ring

section CommRing

variable {R M N P : Type*} [CommRing R] [IsNoetherianRing R] {I : Ideal R}
  [CommRing M] [Algebra R M] [CommRing N] [Algebra R N] [Algebra (AdicCompletion I R) N]
  [IsScalarTower R (AdicCompletion I R) N] [Ring P] [Algebra R P]
  [Algebra (AdicCompletion I R) P] [IsScalarTower R (AdicCompletion I R) P]

/-- **Étaleness of an algebra glued along the completion.** In the situation of
`AlgHom.isBaseChange_snd_equalizer_of_adicCompletion`, if `N` is finite étale over `R̂` and the
localization of `M` at each element of `I` is finite étale, then the subalgebra of pairs `(m, n)`
with `f m = g n` is étale over `R`; it is finite by `AlgHom.finite_equalizer_of_adicCompletion`. -/
@[stacks 05EU "étaleness of the algebra glued along the completion from finite étale pieces"]
theorem etale_equalizer_of_adicCompletion (f : M →ₐ[R] P)
    (g : N →ₐ[AdicCompletion I R] P) (hf : IsBaseChange (AdicCompletion I R) f.toLinearMap)
    (hloc : ∀ r ∈ I, Bijective (LocalizedModule.map
      (.powers (algebraMap R (AdicCompletion I R) r)) g.toLinearMap))
    [Module.Finite (AdicCompletion I R) N] [Algebra.Etale (AdicCompletion I R) N]
    (hM : ∀ r ∈ I, Module.Finite (Localization.Away r) (Localization.Away r ⊗[R] M) ∧
      Algebra.Etale (Localization.Away r) (Localization.Away r ⊗[R] M)) :
    Algebra.Etale R
      (equalizer (f.comp (fst R M N)) ((g.restrictScalars R).comp (snd R M N))) := by
  obtain ⟨G, hGI, hG⟩ := exists_finset_span_eq_bijective_quotientMap I
  exact etale_equalizer_of_formalGlueing f g hf G hG
    (fun r hr ↦ hloc r (hGI.le (Ideal.subset_span hr)))
    fun r hr ↦ hM r (hGI.le (Ideal.subset_span hr))

end CommRing

end AdicCompletion

end AlgHom
