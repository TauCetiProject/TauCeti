module

public import TauCeti.RingTheory.FormalGlueing.Finiteness
public import Mathlib.RingTheory.Etale.Basic
import Mathlib.RingTheory.Extension.Cotangent.BaseChange
import Mathlib.RingTheory.Finiteness.ModuleFinitePresentation
import Mathlib.RingTheory.Kaehler.TensorProduct

/-!
# Detecting finite étaleness on formal-glueing pieces

Let `R → S` be flat and induce an isomorphism `R/I → S/IS`, where `I` is generated by a
finite set `G`. An `R`-algebra is finite étale if and only if its base changes to `S` and
to each `R[1/g]`, for `g ∈ G`, are finite étale. Neither ring needs to be Noetherian, and
`R → S` need not be faithfully flat.

This criterion checks that an algebra reconstructed by formal glueing is finite étale.
It does not construct that algebra. Formal étaleness is detected without any finiteness
hypothesis: both the module of Kähler differentials and the first cotangent homology
vanish if they vanish on all the pieces. Their base-change comparisons are Mathlib's
`KaehlerDifferential.tensorKaehlerEquivBase` and `Algebra.tensorH1CotangentOfFlat`.
Finite presentation is then detected by the module-theoretic formal-glueing criterion.
The argument adapts Christian Merten's faithfully flat descent proofs in Mathlib's
`RingTheory.Etale.Descent`, replacing faithfully flat reflection of zero modules by
joint detection on the formal-glueing pieces.

## References

* The Stacks Project, Proposition 15.91.16 (05ER), formal glueing of modules.
* The Stacks Project, Remark 15.91.20 (05EU), preservation of finiteness and tensor products.
* The Stacks Project, Lemmas 58.19.3 (0BLH) and 58.20.4 (0BLL), finite extensions from
  the completion and detection of extension of finite étale covers.
-/

public section

open TensorProduct Function

namespace TauCeti

variable {R S A : Type*} [CommRing R] [CommRing S] [CommRing A]
  [Algebra R S] [Algebra R A] [Module.Flat R S] {G : Finset R}

/-- Formal étaleness is detected after a flat base change preserving `R/(G)`, together
with localization at every generator of `(G)`. No finiteness of the algebra is required. -/
theorem formallyEtale_iff_baseChange_and_localized
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map)) :
    Algebra.FormallyEtale R A ↔ Algebra.FormallyEtale S (S ⊗[R] A) ∧
      ∀ g ∈ G, Algebra.FormallyEtale (Localization.Away g) (Localization.Away g ⊗[R] A) := by
  refine ⟨fun _ ↦ ⟨inferInstance, fun _ _ ↦ inferInstance⟩, ?_⟩
  rintro ⟨hS, hloc⟩
  let _ : Algebra A (S ⊗[R] A) := Algebra.TensorProduct.rightAlgebra
  have : Subsingleton (S ⊗[R] Ω[A⁄R]) :=
    (KaehlerDifferential.tensorKaehlerEquivBase R S A (S ⊗[R] A)).subsingleton
  have hΩ : Subsingleton Ω[A⁄R] := subsingleton_of_baseChange_and_localized hG fun g hg ↦ by
    have := hloc g hg
    let _ : Algebra A (Localization.Away g ⊗[R] A) := Algebra.TensorProduct.rightAlgebra
    have : Subsingleton (Localization.Away g ⊗[R] Ω[A⁄R]) :=
      (KaehlerDifferential.tensorKaehlerEquivBase R (Localization.Away g) A
        (Localization.Away g ⊗[R] A)).subsingleton
    exact (LocalizedModule.isBaseChange (.powers g) Ω[A⁄R]).equiv.symm.subsingleton
  have : Subsingleton (S ⊗[R] Algebra.H1Cotangent R A) :=
    (Algebra.tensorH1CotangentOfFlat R A S).subsingleton
  refine ⟨hΩ, subsingleton_of_baseChange_and_localized hG fun g hg ↦ ?_⟩
  have := hloc g hg
  have : Subsingleton (Localization.Away g ⊗[R] Algebra.H1Cotangent R A) :=
    (Algebra.tensorH1CotangentOfFlat R A (Localization.Away g)).subsingleton
  exact (LocalizedModule.isBaseChange (.powers g) (Algebra.H1Cotangent R A)).equiv.symm.subsingleton

/-- Finite étaleness is detected on the formal-glueing pieces. This applies in particular
to the `I`-adic completion of a Noetherian ring and the principal opens complementary to `I`.
In general, any flat `R → S` inducing `R/I ≃ S/IS` suffices: neither ring needs to be
Noetherian, and completeness and faithful flatness are not required. -/
theorem finite_etale_iff_baseChange_and_localized
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map)) :
    (Module.Finite R A ∧ Algebra.Etale R A) ↔
      (Module.Finite S (S ⊗[R] A) ∧ Algebra.Etale S (S ⊗[R] A)) ∧
        ∀ g ∈ G, Module.Finite (Localization.Away g) (Localization.Away g ⊗[R] A) ∧
          Algebra.Etale (Localization.Away g) (Localization.Away g ⊗[R] A) := by
  refine ⟨fun ⟨_, _⟩ ↦ ⟨⟨inferInstance, inferInstance⟩, fun _ _ ↦
    ⟨inferInstance, inferInstance⟩⟩, ?_⟩
  rintro ⟨⟨hfin, het⟩, hloc⟩
  have : Module.Finite R A := (finite_iff_baseChange_and_localized hG).mpr
    ⟨hfin, fun g hg ↦ (hloc g hg).1⟩
  have : Module.FinitePresentation R A := (finitePresentation_iff_baseChange_and_localized hG).mpr
    ⟨Module.FinitePresentation.of_finite_of_finitePresentation S (S ⊗[R] A), fun g hg ↦ by
      obtain ⟨_, _⟩ := hloc g hg
      exact Module.FinitePresentation.of_finite_of_finitePresentation _ _⟩
  have : Algebra.FormallyEtale R A := (formallyEtale_iff_baseChange_and_localized hG).mpr
    ⟨inferInstance, fun g hg ↦ by have := (hloc g hg).2; infer_instance⟩
  have : Algebra.FinitePresentation R A := Algebra.FinitePresentation.of_finitePresentation R A
  exact ⟨inferInstance, ⟨inferInstance, inferInstance⟩⟩

end TauCeti
