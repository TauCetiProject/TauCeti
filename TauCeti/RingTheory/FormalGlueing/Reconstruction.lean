/-!
# Reconstructing modules and subalgebras by formal glueing

Let `R → S` be flat and induce `R/I ≅ S/IS`, with `I` generated by a finite set `G`, as for the
completion of a Noetherian ring along `I`. A module over `R` is glued from three pieces: an
`R`-module `M`, thought of as the sections on the open complement of `V(I)`; an `S`-module `N`
on the formal neighbourhood of `V(I)`; and an `S`-linear map `g : N → P` into the base change
`P = S ⊗[R] M` (presented by a map `f : M → P` exhibiting the base change), which is an
isomorphism after inverting each generator of `I`. The glued module is the module of compatible
pairs `{(m, n) | f m = g n}`, the kernel of `f.coprod (-g)`.

The main result, `LinearMap.isBaseChange_snd_ker_coprod_of_formalGlueing`, is that the projection
of the compatible pairs to `N` exhibits `N` as their base change to `S`: the formal piece is
recovered from the glued module. The complementary piece is recovered as well: after inverting a
generator of `I`, projection of the compatible pairs to `M` is a localization
(`LinearMap.isLocalizedModule_fst_ker_coprod_restrictScalars`). Together they say that every such
glueing datum comes from an `R`-module. In particular the glued module is finite over `R` as soon
as `N` is finite over `S` and `M` is finite after inverting each generator of `I`
(`LinearMap.finite_ker_coprod_of_formalGlueing`), the finiteness needed to reconstruct a finite
algebra over `R` from a finite algebra over its completion.

The comparison `S ⊗[R] K → N` from the compatible pairs `K` is injective by
`LinearMap.injective_liftBaseChange_snd_ker_coprod_of_formalGlueing`. For surjectivity, the
cokernel of `g` is `I`-power torsion, as `g` is surjective off `V(I)`, so it is unchanged by base
change to `S` (`LinearMap.isBaseChange_coker_of_localized_surjective`). The general linear
algebra, `LinearMap.surjective_liftBaseChange_snd_ker_coprod`, then lifts the image of `g`
through the elements of `M` whose image in `P` lies in that image, and the remaining error lies
in the kernel of `g`, whose elements are compatible pairs with first component zero.

When `R → S` is moreover faithfully flat, projection from `K` to `N` is injective, realizing the
glued module directly as an `R`-submodule `E ≤ N` with `IsBaseChange S E.subtype` and an `R`-linear
map `E →ₗ[R] M` compatible with `f` and `g` that becomes bijective after inverting each `r ∈ G`
(`TauCeti.exists_submodule_isBaseChange_of_formalGlueing`). When `M`, `B'`, `P` are commutative
algebras and `f`, `g` are algebra homomorphisms, compatible pairs of units and products upgrade `E`
to an `R`-subalgebra `B ≤ B'` with `Algebra.IsPushout R S B B'` and an `R`-algebra homomorphism
`B →ₐ[R] M` that becomes bijective on each localization away from `G`
(`TauCeti.exists_subalgebra_isPushout_of_formalGlueing`).

## Main results

* `LinearMap.surjective_liftBaseChange_snd_ker_coprod_of_formalGlueing`: the comparison from
  compatible pairs to the formal piece is surjective.
* `LinearMap.isBaseChange_snd_ker_coprod_of_formalGlueing`: projection from compatible pairs to
  the formal piece is a base change.
* `LinearMap.finite_ker_coprod_of_formalGlueing`: the compatible pairs form a finite `R`-module
  when the formal piece and the localizations of the complementary piece are finite.
* `TauCeti.exists_submodule_isBaseChange_of_formalGlueing`: submodule model inside `N` under
  faithful flatness and `IsBaseChange S f`.
* `TauCeti.exists_subalgebra_isPushout_of_formalGlueing`: subalgebra model inside an `S`-algebra
  `B'` under faithful flatness and `IsBaseChange S f.toLinearMap`.

## References

* [The Stacks Project, Proposition 15.91.16](https://stacks.math.columbia.edu/tag/05ER),
  formal glueing of modules.
* [The Stacks Project, Lemma 15.91.3](https://stacks.math.columbia.edu/tag/05EC), base change of
  ideal-power torsion modules.
* [The Stacks Project, Remark 15.91.20](https://stacks.math.columbia.edu/tag/05EU), finiteness and
  algebra structure of the glued module.
-/

public section

open Function

namespace LinearMap

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
  {M N P : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  [Module S N] [IsScalarTower R S N] [AddCommGroup P] [Module R P] [Module S P]
  [IsScalarTower R S P]

/-- For formal-glueing data, the scalar-extension comparison from the module of compatible
pairs to the prescribed `S`-module is surjective. Only surjectivity of the comparison for `f`
and of the map on the complementary principal opens is needed. -/
theorem surjective_liftBaseChange_snd_ker_coprod_of_formalGlueing
    (f : M →ₗ[R] P) (g : N →ₗ[S] P) (hf : Surjective (f.liftBaseChange S)) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ r ∈ G, Surjective (LocalizedModule.map (.powers (algebraMap R S r)) g)) :
    Surjective (((LinearMap.snd R M N).domRestrict
      (f.coprod (-g.restrictScalars R)).ker).liftBaseChange S) :=
  surjective_liftBaseChange_snd_ker_coprod f g hf
    (isBaseChange_coker_of_localized_surjective g G hG hloc).liftBaseChange_injective

/-- **Formal glueing of modules.** Let `R → S` be flat and induce `R/I ≅ S/IS`, with `I` generated
by a finite set `G`. Let `f : M → P` exhibit `P` as the base change of an `R`-module `M`, and let
`g : N → P` be an `S`-linear map that becomes bijective after inverting each element of `G`.
Then projection from the module of compatible pairs `{(m, n) | f m = g n}` to `N` exhibits `N`
as the base change of these pairs to `S`. -/
@[stacks 05ER "the formal piece of a glueing datum is the base change of its compatible pairs"]
theorem isBaseChange_snd_ker_coprod_of_formalGlueing
    (f : M →ₗ[R] P) (g : N →ₗ[S] P) (hf : IsBaseChange S f) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ r ∈ G, Bijective (LocalizedModule.map (.powers (algebraMap R S r)) g)) :
    IsBaseChange S ((LinearMap.snd R M N).domRestrict (f.coprod (-g.restrictScalars R)).ker) :=
  IsBaseChange.iff_liftBaseChange_bijective.mpr
    ⟨injective_liftBaseChange_snd_ker_coprod_of_formalGlueing f g hf.liftBaseChange_injective G
      hG fun r hr ↦ (hloc r hr).1,
    surjective_liftBaseChange_snd_ker_coprod_of_formalGlueing f g hf.liftBaseChange_bijective.2 G
      hG fun r hr ↦ (hloc r hr).2⟩

/-- **Finiteness of a module glued from finite pieces.** In the situation of
`LinearMap.isBaseChange_snd_ker_coprod_of_formalGlueing`, if `N` is finite over `S` and the
localization of `M` at each element of `G` is finite, then the module of compatible pairs is
finite over `R`. -/
@[stacks 05EU "finiteness of the module glued from finite pieces"]
theorem finite_ker_coprod_of_formalGlueing
    (f : M →ₗ[R] P) (g : N →ₗ[S] P) (hf : IsBaseChange S f) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ r ∈ G, Bijective (LocalizedModule.map (.powers (algebraMap R S r)) g))
    [Module.Finite S N]
    (hM : ∀ r ∈ G, Module.Finite (Localization.Away r) (LocalizedModule (.powers r) M)) :
    Module.Finite R (f.coprod (-g.restrictScalars R)).ker := by
  refine (TauCeti.finite_iff_baseChange_and_localized hG).mpr ⟨?_, fun r hr ↦ ?_⟩
  · exact .equiv (isBaseChange_snd_ker_coprod_of_formalGlueing f g hf G hG hloc).equiv.symm
  · have := isLocalizedModule_fst_ker_coprod_restrictScalars f g r (hloc r hr)
    have := hM r hr
    exact .equiv (IsLocalizedModule.isBaseChange (.powers r) (Localization.Away r)
      (LocalizedModule.mkLinearMap (.powers r) M ∘ₗ
        LinearMap.fst R M N ∘ₗ (f.coprod (-g.restrictScalars R)).ker.subtype)).equiv.symm

end LinearMap

namespace TauCeti

section FaithfullyFlat

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.FaithfullyFlat R S]

/-- **Submodule reconstruction by formal glueing.** Suppose `R → S` is faithfully flat and induces
`R/I ≅ S/IS` for `I = Ideal.span G`, `f : M →ₗ[R] P` exhibits `P` as `S ⊗[R] M`, and
`g : N →ₗ[S] P` becomes bijective after inverting the image of each `r ∈ G`. Then there exist an
`R`-submodule `E ≤ N` whose inclusion exhibits `N` as `S ⊗[R] E` and an `R`-linear map
`ψ : E →ₗ[R] M` compatible with `f` and `g` that becomes bijective after inverting each `r ∈ G`. -/
@[stacks 05ER "submodule realization for faithfully flat ring maps"]
theorem exists_submodule_isBaseChange_of_formalGlueing {G : Finset R}
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    {M N P : Type*} [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]
    [AddCommGroup P] [Module R P] [Module S P] [IsScalarTower R S P]
    (f : M →ₗ[R] P) (hf : IsBaseChange S f) (g : N →ₗ[S] P)
    (hg : ∀ r ∈ G, Bijective (LocalizedModule.map (.powers (algebraMap R S r)) g)) :
    ∃ (E : Submodule R N) (ψ : E →ₗ[R] M),
      IsBaseChange S E.subtype ∧
        f ∘ₗ ψ = g.restrictScalars R ∘ₗ E.subtype ∧
        (∀ m : M, ∀ y : N, f m = g y → y ∈ E) ∧
        ∀ r ∈ G, Bijective (LocalizedModule.map (.powers r) ψ) := by
  let K := (f.coprod (-g.restrictScalars R)).ker
  let fstK : K →ₗ[R] M := (LinearMap.fst R M N).domRestrict K
  let sndK : K →ₗ[R] N := (LinearMap.snd R M N).domRestrict K
  have hsnd_bc : IsBaseChange S sndK :=
    LinearMap.isBaseChange_snd_ker_coprod_of_formalGlueing f g hf G hG hg
  have hsnd_inj : Injective sndK :=
    hsnd_bc.injective_of_tensorProduct_mk_injective
      (Module.FaithfullyFlat.tensorProduct_mk_injective K)
  let E : Submodule R N := LinearMap.range sndK
  let e : K ≃ₗ[R] E := LinearEquiv.ofInjective sndK hsnd_inj
  let ψ : E →ₗ[R] M := fstK ∘ₗ e.symm.toLinearMap
  refine ⟨E, ψ,
    (by ext x; exact congrArg Subtype.val (e.apply_symm_apply x) :
      sndK ∘ₗ e.symm.toLinearMap = E.subtype) ▸ hsnd_bc.comp_equiv e.symm sndK,
    ?_, ?_, fun r hr ↦ ?_⟩
  · ext x
    have hx : (e (e.symm x) : N) = (x : N) := congrArg Subtype.val (e.apply_symm_apply x)
    exact (LinearMap.apply_fst_ker_coprod_eq f g (e.symm x)).trans (congrArg g hx)
  · intro m y hmy
    exact ⟨⟨(m, y), by simp [K, LinearMap.mem_ker, hmy]⟩, rfl⟩
  · rw [LocalizedModule.map_comp]
    have hfst : Bijective (LocalizedModule.map (.powers r) fstK) :=
      LinearMap.bijective_localizedMap_fst_ker_coprod f g (.powers r)
        (by rw [Algebra.algebraMapSubmonoid_powers]; exact hg r hr)
    exact hfst.comp ⟨LocalizedModule.map_injective _ _ e.symm.injective,
      LocalizedModule.map_surjective _ _ e.symm.surjective⟩

/-- **Subalgebra reconstruction by formal glueing.** Let `R → S` be faithfully flat and induce
`R/I ≅ S/IS` for `I = Ideal.span G`. Let `M` be a commutative `R`-algebra, `B'` and `P` commutative
`S`-algebras, `f : M →ₐ[R] P` an `R`-algebra homomorphism exhibiting `P` as `S ⊗[R] M`, and
`g : B' →ₐ[S] P` an `S`-algebra homomorphism whose underlying linear map becomes bijective after
inverting the image of each `r ∈ G`. Then there exist an `R`-subalgebra `B ≤ B'` with
`Algebra.IsPushout R S B B'` and an `R`-algebra homomorphism `ψ : B →ₐ[R] M` compatible with `f`
and `g` whose underlying linear map becomes bijective after inverting each `r ∈ G`. -/
@[stacks 05EU "algebra reconstruction for faithfully flat ring maps"]
theorem exists_subalgebra_isPushout_of_formalGlueing {G : Finset R}
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    {M B' P : Type*} [CommRing M] [Algebra R M]
    [CommRing B'] [Algebra R B'] [Algebra S B'] [IsScalarTower R S B']
    [CommRing P] [Algebra R P] [Algebra S P] [IsScalarTower R S P]
    (f : M →ₐ[R] P) (hf : IsBaseChange S f.toLinearMap) (g : B' →ₐ[S] P)
    (hg : ∀ r ∈ G, Bijective (LocalizedModule.map (.powers (algebraMap R S r)) g.toLinearMap)) :
    ∃ (B : Subalgebra R B') (ψ : B →ₐ[R] M),
      Algebra.IsPushout R S B B' ∧
        f.comp ψ = (g.restrictScalars R).comp B.val ∧
        ∀ r ∈ G, Bijective (LocalizedModule.map (.powers r) ψ.toLinearMap) := by
  obtain ⟨E, ψ₀, hE_bc, hψ₀_comp, hpair_mem, hψ₀_loc⟩ :=
    exists_submodule_isBaseChange_of_formalGlueing hG f.toLinearMap hf g.toLinearMap hg
  have hf_inj : Injective f :=
    hf.injective_of_tensorProduct_mk_injective
      (Module.FaithfullyFlat.tensorProduct_mk_injective M)
  have hψ₀_apply (x : E) : f (ψ₀ x) = g x.val := congr($hψ₀_comp x)
  have hone : (1 : B') ∈ E := hpair_mem 1 1 (by simp)
  have hmul {x y : B'} (hx : x ∈ E) (hy : y ∈ E) : x * y ∈ E :=
    hpair_mem (ψ₀ ⟨x, hx⟩ * ψ₀ ⟨y, hy⟩) (x * y) (by
      simp only [AlgHom.toLinearMap_apply, map_mul, hψ₀_apply])
  let B : Subalgebra R B' := E.toSubalgebra hone @hmul
  let bEquivE : B ≃ₗ[R] E := (Subalgebra.toSubmoduleEquiv B).symm
  have hbEquivE (x : B) : (bEquivE x : B') = (x : B') := rfl
  have hψ_one : (ψ₀ ∘ₗ bEquivE.toLinearMap) 1 = 1 :=
    hf_inj (by simp [hψ₀_apply, hbEquivE])
  have hψ_mul (x y : B) :
      (ψ₀ ∘ₗ bEquivE.toLinearMap) (x * y) =
        (ψ₀ ∘ₗ bEquivE.toLinearMap) x * (ψ₀ ∘ₗ bEquivE.toLinearMap) y :=
    hf_inj (by simp [hψ₀_apply, hbEquivE, map_mul])
  let ψ : B →ₐ[R] M := AlgHom.ofLinearMap (ψ₀ ∘ₗ bEquivE.toLinearMap) hψ_one hψ_mul
  have hval_eq :
      E.subtype.comp bEquivE.toLinearMap = (IsScalarTower.toAlgHom R B B').toLinearMap := by
    ext x
    exact hbEquivE x
  have hpush : Algebra.IsPushout R S B B' :=
    ⟨hval_eq ▸ hE_bc.comp_equiv bEquivE E.subtype⟩
  have hcomp : f.comp ψ = (g.restrictScalars R).comp B.val := by
    ext x
    exact hψ₀_apply (bEquivE x)
  have hψ_loc (r : R) (hr : r ∈ G) : Bijective (LocalizedModule.map (.powers r) ψ.toLinearMap) := by
    rw [AlgHom.toLinearMap_ofLinearMap, LocalizedModule.map_comp]
    exact (hψ₀_loc r hr).comp
      ⟨LocalizedModule.map_injective _ _ bEquivE.injective,
        LocalizedModule.map_surjective _ _ bEquivE.surjective⟩
  exact ⟨B, ψ, hpush, hcomp, hψ_loc⟩

end FaithfullyFlat

end TauCeti
