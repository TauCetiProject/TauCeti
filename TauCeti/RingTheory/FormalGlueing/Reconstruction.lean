module

public import TauCeti.RingTheory.FormalGlueing.Cokernel
public import TauCeti.RingTheory.FormalGlueing.Finiteness
public import TauCeti.RingTheory.FormalGlueing.Injectivity
public import TauCeti.RingTheory.TensorProduct.IsBaseChange
import TauCeti.Algebra.Module.LocalizedModule.Pullback
import TauCeti.RingTheory.Flat.IsBaseChange

/-!
# Reconstructing a module by formal glueing

Let `R → S` be flat and induce `R/I ≅ S/IS`, with `I` generated by a finite set `G`, as for the
completion of a Noetherian ring along `I`. A module over `R` is glued from three pieces: an
`R`-module `M`, thought of as the sections on the open complement of `V(I)`; an `S`-module `N`
on the formal neighbourhood of `V(I)`; and an `S`-linear map `g : N → P` into the base change
`P = S ⊗[R] M` (presented by a map `f : M → P` exhibiting the base change), which is an
isomorphism after inverting each generator of `I`. The glued module is the module of compatible
pairs `{(m, n) | f m = g n}`, the kernel of `f.coprod (-g)`.

The main result, `LinearMap.isBaseChange_snd_ker_coprod_of_formalGlueing`, is that the projection
of the compatible pairs to `N` exhibits `N` as their base change to `S`: the formal piece is
recovered from the glued module. The complementary piece is recovered as well: after inverting a
generator of `I`, projection of the compatible pairs to `M` is a localization
(`LinearMap.isLocalizedModule_fst_ker_coprod_restrictScalars`). Together they say that every such
glueing datum comes from an `R`-module. In particular the glued module is finite over `R` as soon
as `N` is finite over `S` and `M` is finite after inverting each generator of `I`
(`LinearMap.finite_ker_coprod_of_formalGlueing`), the finiteness needed to reconstruct a finite
algebra over `R` from a finite algebra over its completion.

The comparison `S ⊗[R] K → N` from the compatible pairs `K` is injective by
`LinearMap.injective_liftBaseChange_snd_ker_coprod_of_formalGlueing`. For surjectivity, the
cokernel of `g` is `I`-power torsion, as `g` is surjective off `V(I)`, so it is unchanged by base
change to `S` (`LinearMap.isBaseChange_coker_of_localized_surjective`). The general linear
algebra, `LinearMap.surjective_liftBaseChange_snd_ker_coprod`, then lifts the image of `g`
through the elements of `M` whose image in `P` lies in that image, and the remaining error lies
in the kernel of `g`, whose elements are compatible pairs with first component zero.

## Main results

* `LinearMap.surjective_liftBaseChange_snd_ker_coprod_of_formalGlueing`: the comparison from
  compatible pairs to the formal piece is surjective.
* `LinearMap.isBaseChange_snd_ker_coprod_of_formalGlueing`: projection from compatible pairs to
  the formal piece is a base change.
* `LinearMap.finite_ker_coprod_of_formalGlueing`: the compatible pairs form a finite `R`-module
  when the formal piece and the localizations of the complementary piece are finite.

## References

* [The Stacks Project, Proposition 15.91.16](https://stacks.math.columbia.edu/tag/05ER),
  formal glueing of modules.
* [The Stacks Project, Lemma 15.91.3](https://stacks.math.columbia.edu/tag/05EC), base change of
  ideal-power torsion modules.
* [The Stacks Project, Remark 15.91.20](https://stacks.math.columbia.edu/tag/05EU), finiteness of
  the glued module.
-/

public section

open Function

namespace LinearMap

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
  {M N P : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  [Module S N] [IsScalarTower R S N] [AddCommGroup P] [Module R P] [Module S P]
  [IsScalarTower R S P]

/-- For formal-glueing data, the scalar-extension comparison from the module of compatible
pairs to the prescribed `S`-module is surjective. Only surjectivity of the comparison for `f`
and of the map on the complementary principal opens is needed. -/
theorem surjective_liftBaseChange_snd_ker_coprod_of_formalGlueing
    (f : M →ₗ[R] P) (g : N →ₗ[S] P) (hf : Surjective (f.liftBaseChange S)) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ r ∈ G, Surjective (LocalizedModule.map (.powers (algebraMap R S r)) g)) :
    Surjective (((LinearMap.snd R M N).domRestrict
      (f.coprod (-g.restrictScalars R)).ker).liftBaseChange S) :=
  surjective_liftBaseChange_snd_ker_coprod f g hf
    (isBaseChange_coker_of_localized_surjective g G hG hloc).liftBaseChange_injective

/-- **Formal glueing of modules.** Let `R → S` be flat and induce `R/I ≅ S/IS`, with `I` generated
by a finite set `G`. Let `f : M → P` exhibit `P` as the base change of an `R`-module `M`, and let
`g : N → P` be an `S`-linear map that becomes bijective after inverting each element of `G`.
Then projection from the module of compatible pairs `{(m, n) | f m = g n}` to `N` exhibits `N`
as the base change of these pairs to `S`. -/
@[stacks 05ER "the formal piece of a glueing datum is the base change of its compatible pairs"]
theorem isBaseChange_snd_ker_coprod_of_formalGlueing
    (f : M →ₗ[R] P) (g : N →ₗ[S] P) (hf : IsBaseChange S f) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ r ∈ G, Bijective (LocalizedModule.map (.powers (algebraMap R S r)) g)) :
    IsBaseChange S ((LinearMap.snd R M N).domRestrict (f.coprod (-g.restrictScalars R)).ker) :=
  IsBaseChange.iff_liftBaseChange_bijective.mpr
    ⟨injective_liftBaseChange_snd_ker_coprod_of_formalGlueing f g hf.liftBaseChange_injective G
      hG fun r hr ↦ (hloc r hr).1,
    surjective_liftBaseChange_snd_ker_coprod_of_formalGlueing f g hf.liftBaseChange_bijective.2 G
      hG fun r hr ↦ (hloc r hr).2⟩

/-- **Finiteness of a module glued from finite pieces.** In the situation of
`LinearMap.isBaseChange_snd_ker_coprod_of_formalGlueing`, if `N` is finite over `S` and the
localization of `M` at each element of `G` is finite, then the module of compatible pairs is
finite over `R`. -/
@[stacks 05EU "finiteness of the module glued from finite pieces"]
theorem finite_ker_coprod_of_formalGlueing
    (f : M →ₗ[R] P) (g : N →ₗ[S] P) (hf : IsBaseChange S f) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ r ∈ G, Bijective (LocalizedModule.map (.powers (algebraMap R S r)) g))
    [Module.Finite S N]
    (hM : ∀ r ∈ G, Module.Finite (Localization.Away r) (LocalizedModule (.powers r) M)) :
    Module.Finite R (f.coprod (-g.restrictScalars R)).ker := by
  refine (TauCeti.finite_iff_baseChange_and_localized hG).mpr ⟨?_, fun r hr ↦ ?_⟩
  · exact .equiv (isBaseChange_snd_ker_coprod_of_formalGlueing f g hf G hG hloc).equiv.symm
  · have := isLocalizedModule_fst_ker_coprod_restrictScalars f g r (hloc r hr)
    have := hM r hr
    exact .equiv (IsLocalizedModule.isBaseChange (.powers r) (Localization.Away r)
      (LocalizedModule.mkLinearMap (.powers r) M ∘ₗ
        LinearMap.fst R M N ∘ₗ (f.coprod (-g.restrictScalars R)).ker.subtype)).equiv.symm

end LinearMap
