module

public import TauCeti.RingTheory.FormalGlueing.Morphisms
public import Mathlib.RingTheory.TensorProduct.Maps

/-!
# Gluing algebra homomorphisms across a formal neighbourhood

Let `R → S` be faithfully flat and induce an isomorphism modulo an ideal generated by a finite
set `G`. Algebra homomorphisms defined after base change to `S` and after localization at the
elements of `G` glue uniquely if they agree on the overlaps. No finiteness hypothesis on the
algebras is needed.

`AlgHom.existsUnique_formalGlueing_lift` is the algebra version of
`LinearMap.existsUnique_formalGlueing_lift`: it reconstructs the underlying linear map and
ensures that it preserves multiplication and the unit. This supplies the morphism part of
formal gluing for affine schemes, including finite morphisms.
`AlgEquiv.existsUnique_formalGlueing_lift` reconstructs isomorphisms: it suffices that the map
over `S` be invertible, without separately requiring inverses on the principal opens.
The source and target algebras are already defined over `R`; reconstruction of objects is a
separate assertion.

Localizations are written as `LocalizedModule`, whose existing ring and algebra structures
allow the same compatibility square as for module morphisms. The conclusion specifies the
localized map on the images of elements of the original algebra; those images determine a map
out of the localization uniquely.

## References

* The Stacks Project, Proposition 15.91.16 (05ER) and Remark 15.91.20 (05EU), here the
  full-faithfulness assertion for algebras and faithfully flat ring maps.
-/

public section

open TensorProduct Function

namespace AlgHom

variable {R S A B : Type*} [CommRing R] [CommRing S] [Algebra R S]
  [Ring A] [Ring B] [Algebra R A] [Algebra R B]
  [Module.FaithfullyFlat R S] {G : Finset R}

/-- Compatible algebra homomorphisms on a faithfully flat formal neighbourhood and the
complementary principal opens glue to a unique algebra homomorphism. The ideal generated by
`G` must have the same quotient before and after base change. Compatibility and the localized
conclusion are specified on elements of the original source algebra. -/
@[stacks 05EU "full faithfulness for algebras and faithfully flat ring maps"]
theorem existsUnique_formalGlueing_lift
    (fS : S ⊗[R] A →ₐ[S] S ⊗[R] B)
    (fg : (g : G) → LocalizedModule (.powers g.1) A →ₐ[R] LocalizedModule (.powers g.1) B)
    (hI : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hcompat : ∀ (g : G) (a : A),
      LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] B) (fS (1 ⊗ₜ a)) =
        IsLocalizedModule.map (.powers g.1) (LocalizedModule.mkLinearMap (.powers g.1) B)
          (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] B)) (TensorProduct.mk R S B 1)
          (fg g (LocalizedModule.mkLinearMap (.powers g.1) A a))) :
    ∃! f : A →ₐ[R] B, Algebra.TensorProduct.map (AlgHom.id S S) f = fS ∧
      ∀ (g : G) (a : A), LocalizedModule.mkLinearMap (.powers g.1) B (f a) =
        fg g (LocalizedModule.mkLinearMap (.powers g.1) A a) := by
  have hcompat' (g : G) :
      IsLocalizedModule.map (.powers g.1)
          (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] A))
          (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] B))
          (fS.toLinearMap.restrictScalars R) ∘ₗ
        IsLocalizedModule.map (.powers g.1) (LocalizedModule.mkLinearMap (.powers g.1) A)
          (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] A)) (TensorProduct.mk R S A 1) =
        IsLocalizedModule.map (.powers g.1) (LocalizedModule.mkLinearMap (.powers g.1) B)
          (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] B)) (TensorProduct.mk R S B 1) ∘ₗ
            (fg g).toLinearMap := by
    apply IsLocalizedModule.linearMap_ext (.powers g.1)
      (LocalizedModule.mkLinearMap (.powers g.1) A)
      (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] B))
    ext a
    simpa only [LinearMap.comp_apply, IsLocalizedModule.map_apply,
      LinearMap.restrictScalars_apply, AlgHom.toLinearMap_apply, TensorProduct.mk_apply]
      using hcompat g a
  obtain ⟨F, ⟨hbase, hloc⟩, _⟩ := LinearMap.existsUnique_formalGlueing_lift
    fS.toLinearMap (fun g ↦ (fg g).toLinearMap) hI hcompat'
  have hF (a : A) : (1 : S) ⊗ₜ[R] F a = fS (1 ⊗ₜ a) := by
    simpa only [LinearMap.baseChange_tmul, AlgHom.toLinearMap_apply] using
      LinearMap.congr_fun hbase (1 ⊗ₜ a)
  have hη := Module.FaithfullyFlat.tensorProduct_mk_injective (A := R) (B := S) B
  -- Faithful flatness detects the algebra laws for the reconstructed linear map.
  have hone : F 1 = 1 := by
    apply hη
    simp only [TensorProduct.mk_apply, hF, ← Algebra.TensorProduct.one_def, map_one]
  have hmul (a b : A) : F (a * b) = F a * F b := by
    apply hη
    simp only [TensorProduct.mk_apply]
    calc
      1 ⊗ₜ[R] F (a * b) = fS (1 ⊗ₜ (a * b)) := hF _
      _ = fS (1 ⊗ₜ a) * fS (1 ⊗ₜ b) := by
        rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      _ = 1 ⊗ₜ (F a * F b) := by
        rw [← hF, ← hF, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
  let f : A →ₐ[R] B := AlgHom.ofLinearMap F hone hmul
  have hbase' : Algebra.TensorProduct.map (AlgHom.id S S) f = fS := by
    ext a
    exact hF a
  refine ⟨f, ⟨hbase', ?_⟩, ?_⟩
  · intro g a
    simpa only [IsLocalizedModule.map_apply, AlgHom.toLinearMap_apply, f,
      AlgHom.ofLinearMap_apply] using
      LinearMap.congr_fun (hloc g) (LocalizedModule.mkLinearMap (.powers g.1) A a)
  · intro f' hf'
    ext a
    apply hη
    have h := DFunLike.congr_fun (hf'.1.trans hbase'.symm) (1 ⊗ₜ a)
    simpa only [TensorProduct.mk_apply, Algebra.TensorProduct.map_tmul, AlgHom.id_apply] using h

end AlgHom

namespace AlgEquiv

variable {R S A B : Type*} [CommRing R] [CommRing S] [Algebra R S]
  [Ring A] [Ring B] [Algebra R A] [Algebra R B]
  [Module.FaithfullyFlat R S] {G : Finset R}

/-- Compatible local algebra maps glue to a unique algebra isomorphism if their map over the
faithfully flat formal neighbourhood is an isomorphism. The maps on the principal opens need
not be supplied with inverses: invertibility is detected after the faithfully flat base change.
This applies in particular to gluing compatible isomorphisms of finite affine schemes. -/
theorem existsUnique_formalGlueing_lift
    (eS : S ⊗[R] A ≃ₐ[S] S ⊗[R] B)
    (fg : (g : G) → LocalizedModule (.powers g.1) A →ₐ[R] LocalizedModule (.powers g.1) B)
    (hI : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hcompat : ∀ (g : G) (a : A),
      LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] B) (eS (1 ⊗ₜ a)) =
        IsLocalizedModule.map (.powers g.1) (LocalizedModule.mkLinearMap (.powers g.1) B)
          (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] B)) (TensorProduct.mk R S B 1)
          (fg g (LocalizedModule.mkLinearMap (.powers g.1) A a))) :
    ∃! e : A ≃ₐ[R] B, Algebra.TensorProduct.congr (AlgEquiv.refl : S ≃ₐ[S] S) e = eS ∧
      ∀ (g : G) (a : A), LocalizedModule.mkLinearMap (.powers g.1) B (e a) =
        fg g (LocalizedModule.mkLinearMap (.powers g.1) A a) := by
  obtain ⟨f, hf, huniq⟩ := AlgHom.existsUnique_formalGlueing_lift eS.toAlgHom fg hI hcompat
  have hlin : f.toLinearMap.baseChange S = eS.toLinearEquiv.toLinearMap := by
    ext a
    exact DFunLike.congr_fun hf.1 (1 ⊗ₜ a)
  have hbij : Bijective (f.toLinearMap.baseChange S) := by
    rw [hlin]
    exact eS.bijective
  rw [LinearMap.baseChange_eq_lTensor,
    Module.FaithfullyFlat.lTensor_bijective_iff_bijective] at hbij
  let e := AlgEquiv.ofBijective f hbij
  refine ⟨e, ⟨?_, hf.2⟩, ?_⟩
  · apply AlgEquiv.coe_toAlgHom_injective
    exact hf.1
  · intro e' he'
    apply AlgEquiv.coe_toAlgHom_injective
    apply huniq
    refine ⟨?_, he'.2⟩
    ext a
    exact DFunLike.congr_fun he'.1 (1 ⊗ₜ a)

end AlgEquiv
