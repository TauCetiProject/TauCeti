/-!
# Surjectivity of formal-gluing comparison maps

Let `R → S` be flat and induce `R/I ≅ S/IS`, where `I` is generated by a finite set `G`.
Formal-gluing data consist of an `R`-module `M` of sections on the complement of `V(I)`, an
`S`-module `N` on the formal neighbourhood, an `S`-module `P` on their overlap, and maps
`f : M → P` and `g : N → P`. Suppose that `f` exhibits `P` as the base change of `M`, that `g`
becomes an isomorphism after inverting any generator, and that `M` is the module of sections of
its own restriction to the cover by the basic opens `D(a)`, `a ∈ G`: it has no `I`-power torsion,
and every family `(mₐ)` with `aⁿ m_b = bⁿ mₐ` is `(aⁿ x)` for some `x`. Then the module of
compatible pairs `K = ker (f.coprod (-g))` reconstructs `N`: the comparison map `S ⊗[R] K → N`
is an isomorphism (`LinearMap.isBaseChange_snd_ker_coprod_of_formalGlueing`). On a basic open
where `g` becomes an isomorphism, `LinearMap.isLocalizedModule_fst_ker_coprod` identifies the
localization of the compatible pairs with that of `M`; together these reconstruct a module from
formal-gluing data.

Injectivity of the comparison map is
`LinearMap.injective_liftBaseChange_snd_ker_coprod_of_formalGlueing`. For surjectivity, the
cokernel `Q` of the comparison map is `I`-power torsion, so the extension
`0 → S ⊗[R] K → N → Q → 0` descends to an extension `0 → K → E → Q → 0` of `R`-modules with
`S ⊗[R] E ≅ N` (`LinearMap.exists_isBaseChange_comp_eq_of_primaryComponent_eq_top`), by the
degree-one Ext comparison `RingHom.mapExt_one_bijective_of_primaryComponent_eq_top`. The gluing
property of `M` extends the first projection `K → M` across `E`
(`LinearMap.existsUnique_comp_eq_of_primaryComponent_eq_top`), giving a map `E → K`
compatible with the maps to `N`, so the comparison map is onto.

## Main results

* `LinearMap.isBaseChange_snd_ker_coprod_of_formalGlueing`: the module of compatible pairs
  reconstructs the prescribed module on the formal neighbourhood.

## References

* [The Stacks Project, Proposition 15.91.16](https://stacks.math.columbia.edu/tag/05ER),
  essential surjectivity of formal gluing of modules.
* [The Stacks Project, Lemma 15.91.8](https://stacks.math.columbia.edu/tag/05EG), the
  extension comparison used to descend the extension.
-/

public section

open Function TensorProduct

universe u

namespace LinearMap

section FormalGlueing

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
  {M N P : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  [Module S N] [IsScalarTower R S N] [AddCommGroup P] [Module R P] [Module S P]
  [IsScalarTower R S P]

/-- On the principal open of `a`, the comparison map from compatible pairs is surjective:
a power of `a` moves every element of the prescribed `S`-module into its image. -/
private theorem exists_pow_smul_mem_range_liftBaseChange_snd_ker_coprod
    (f : M →ₗ[R] P) (g : N →ₗ[S] P) (hf : IsBaseChange S f) (a : R)
    (hloc : Bijective (LocalizedModule.map (.powers (algebraMap R S a)) g)) (y : N) :
    ∃ j : ℕ, a ^ j • y ∈ range (((snd R M N).domRestrict
      (f.coprod (-g.restrictScalars R)).ker).liftBaseChange S) := by
  set K := (f.coprod (-g.restrictScalars R)).ker
  set c := ((snd R M N).domRestrict K).liftBaseChange S
  set T := Submonoid.powers (algebraMap R S a)
  have hK (k : K) : f (k : M × N).1 = g (k : M × N).2 := by
    simpa only [K, LinearMap.mem_ker, LinearMap.coprod_apply, LinearMap.neg_apply,
      LinearMap.coe_restrictScalars, sub_eq_zero, ← sub_eq_add_neg] using k.property
  have hc (k : K) : c (1 ⊗ₜ k) = (k : M × N).2 := by simp [c]
  -- Every element of `M` becomes a first coordinate of a compatible pair after scaling by `aʲ`.
  have hfst (m : M) : ∃ (j : ℕ) (k : K), (k : M × N).1 = a ^ j • m := by
    obtain ⟨z, hz⟩ := hloc.2 (LocalizedModule.mk (f m) 1)
    induction z using LocalizedModule.induction_on with | h n s => ?_
    rw [LocalizedModule.map_mk, LocalizedModule.mk_eq] at hz
    obtain ⟨u, hu⟩ := hz
    obtain ⟨j, hj⟩ := (u * s).2
    replace hj : algebraMap R S a ^ j = ((u * s : T) : S) := hj
    have hpair : f (a ^ j • m) = g ((u : S) • n) := by
      rw [map_smul, ← algebraMap_smul S, map_pow, hj, map_smul]
      simpa [Submonoid.smul_def, mul_smul] using hu.symm
    exact ⟨j, ⟨(a ^ j • m, (u : S) • n), by simp [K, hpair]⟩, rfl⟩
  -- Hence every element of `P = S ⊗ M` is in the image of `g ∘ c` after scaling.
  have hP (p : P) : ∃ (j : ℕ) (x : S ⊗[R] K), algebraMap R S a ^ j • p = g (c x) := by
    refine hf.inductionOn p (fun m ↦ ?_) (fun s p ⟨j, x, h⟩ ↦ ⟨j, s • x, ?_⟩)
      (fun p p' ⟨j, x, h⟩ ⟨j', x', h'⟩ ↦
        ⟨j + j', algebraMap R S a ^ j' • x + algebraMap R S a ^ j • x', ?_⟩)
    · obtain ⟨j, k, hk⟩ := hfst m
      refine ⟨j, 1 ⊗ₜ k, ?_⟩
      rw [hc, ← hK, hk, map_smul, ← map_pow, algebraMap_smul]
    · rw [smul_comm, h, map_smul, map_smul]
    · rw [map_add, map_smul, map_smul, map_add, map_smul, map_smul, ← h, ← h', smul_add,
        smul_smul, smul_smul, ← pow_add, ← pow_add, add_comm j']
  -- The defect lies in `ker g`, which vanishes on the principal open of `a`.
  obtain ⟨j, x, h⟩ := hP (g y)
  have hz : LocalizedModule.mkLinearMap T N (algebraMap R S a ^ j • y - c x) = 0 := by
    apply hloc.1
    rw [map_zero, LocalizedModule.mkLinearMap_apply, LocalizedModule.map_mk, map_sub, map_smul,
      h, sub_self, LocalizedModule.zero_mk]
  obtain ⟨⟨_, j', rfl⟩, hu⟩ := (IsLocalizedModule.eq_zero_iff T _).mp hz
  refine ⟨j' + j, algebraMap R S a ^ j' • x, ?_⟩
  rw [Submonoid.smul_def, smul_sub, sub_eq_zero] at hu
  replace hu : algebraMap R S a ^ j' • algebraMap R S a ^ j • y =
      algebraMap R S a ^ j' • c x := hu
  rw [map_smul, ← hu, ← map_pow, ← map_pow, algebraMap_smul, algebraMap_smul, pow_add,
    mul_smul]

-- Mathlib's `ModuleCat.extendRestrictScalarsAdj`, which underlies the Ext comparison, relates
-- modules in one universe.
variable {R S : Type u} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
  {M N P : Type u} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  [Module S N] [IsScalarTower R S N] [AddCommGroup P] [Module R P] [Module S P]
  [IsScalarTower R S P]

/-- **Formal gluing reconstructs modules.** Let `R → S` be flat and induce `R/I ≅ S/IS`, where
`I` is generated by a finite set `G`. Let `f : M → P` exhibit `P` as the base change of `M`, and
let `g : N → P` be `S`-linear and bijective after inverting each generator. Suppose `M` has no
`I`-power torsion and every family `(mₐ)_{a ∈ G}` with `aⁿ m_b = bⁿ mₐ` is `(aⁿ x)` for some
`x ∈ M`. Then the projection from the module of compatible pairs `ker (f.coprod (-g))` to `N`
exhibits `N` as its base change. No Noetherian or faithful flatness hypothesis is needed. -/
@[stacks 05ER "essential surjectivity, for the module of compatible pairs"]
theorem isBaseChange_snd_ker_coprod_of_formalGlueing
    (f : M →ₗ[R] P) (g : N →ₗ[S] P) (hf : IsBaseChange S f) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ a ∈ G, Bijective (LocalizedModule.map (.powers (algebraMap R S a)) g))
    (hM : (Ideal.span (G : Set R)).primaryComponent M = ⊥)
    (hglue : ∀ (n : ℕ) (m : G → M), (∀ a b : G, (a : R) ^ n • m b = (b : R) ^ n • m a) →
      ∃ x : M, ∀ a : G, (a : R) ^ n • x = m a) :
    IsBaseChange S ((snd R M N).domRestrict (f.coprod (-g.restrictScalars R)).ker) := by
  set I := Ideal.span (G : Set R)
  set K := (f.coprod (-g.restrictScalars R)).ker
  set c := ((snd R M N).domRestrict K).liftBaseChange S
  have hK (k : K) : f (k : M × N).1 = g (k : M × N).2 := by
    simpa only [K, LinearMap.mem_ker, LinearMap.coprod_apply, LinearMap.neg_apply,
      LinearMap.coe_restrictScalars, sub_eq_zero, ← sub_eq_add_neg] using k.property
  have hc_inj : Injective c := injective_liftBaseChange_snd_ker_coprod_of_formalGlueing f g
    hf.liftBaseChange_injective G hG fun a ha ↦ (hloc a ha).1
  -- The cokernel of the comparison map is `I`-power torsion.
  have hQ : I.primaryComponent (N ⧸ range c) = ⊤ := by
    refine eq_top_iff.mpr fun q _ ↦ (Ideal.mem_primaryComponent_span_iff G).mpr fun a ha ↦ ?_
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ q
    obtain ⟨j, hj⟩ := exists_pow_smul_mem_range_liftBaseChange_snd_ker_coprod f g hf a
      (hloc a ha) y
    exact ⟨j, by rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]; exact hj⟩
  -- So `N` is the base change of an `R`-module `E ⊇ K` with `I`-power torsion quotient.
  obtain ⟨E, i, ε, hi, hE, hεi, hε⟩ :=
    exists_isBaseChange_comp_eq_of_primaryComponent_eq_top _ G hG hc_inj hQ
  -- The first projection `K → M` extends to `E`, by the gluing property of `M`.
  obtain ⟨ψ, hψ, -⟩ := existsUnique_comp_eq_of_primaryComponent_eq_top i hi G hE hM
    hglue ((fst R M N).domRestrict K)
  -- The two extensions land in the compatible pairs, since `P` has no `I`-power torsion.
  have hPtors : I.primaryComponent P = ⊥ := by
    classical
    refine eq_bot_iff.mpr fun p hp ↦ ?_
    have hmem : hf.equiv.symm p ∈ (I.map (algebraMap R S)).primaryComponent (S ⊗[R] M) := by
      rw [Ideal.map_span, ← Finset.coe_image, Ideal.mem_primaryComponent_span_iff]
      intro s hs
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hs
      obtain ⟨n, hn⟩ := (Ideal.mem_primaryComponent_span_iff G).mp hp a ha
      exact ⟨n, by rw [← map_smul, ← map_pow, algebraMap_smul, hn, map_zero]⟩
    rw [TauCeti.primaryComponent_map_tensorProduct_eq_bot ⟨G, rfl⟩ hM, Submodule.mem_bot] at hmem
    simpa using congrArg hf.equiv hmem
  have hψi (k : K) : ψ (i k) = (k : M × N).1 := LinearMap.congr_fun hψ k
  have hεi (k : K) : ε (i k) = (k : M × N).2 := LinearMap.congr_fun hεi k
  have hmem (x : E) : f (ψ x) = g (ε x) := by
    obtain ⟨n, hn⟩ := exists_forall_exists_eq_pow_smul i G hE x
    have hx : f (ψ x) - g (ε x) ∈ I.primaryComponent P := by
      refine (Ideal.mem_primaryComponent_span_iff G).mpr fun a ha ↦ ⟨n, ?_⟩
      obtain ⟨k, hk⟩ := hn a ha
      rw [smul_sub, ← map_smul, ← map_smul_of_tower g, ← map_smul, ← map_smul, ← hk, hψi, hεi,
        hK, sub_self]
    rwa [hPtors, Submodule.mem_bot, sub_eq_zero] at hx
  let r : E →ₗ[R] K := (ψ.prod ε).codRestrict K fun x ↦ by
    simp [K, LinearMap.mem_ker, hmem x]
  -- Hence `c ∘ (S ⊗ r)` is the base-change isomorphism of `ε`, and `c` is surjective.
  have hc_surj : Surjective c := by
    have hrange (t : S ⊗[R] E) : ε.liftBaseChange S t ∈ range c := by
      induction t with
      | tmul s x => exact ⟨s ⊗ₜ r x, by simp [c, r]⟩
      | add t t' ht ht' => simpa only [map_add] using add_mem ht ht'
    intro y
    obtain ⟨t, rfl⟩ := hε.liftBaseChange_bijective.2 y
    exact hrange t
  exact IsBaseChange.iff_liftBaseChange_bijective.2 ⟨hc_inj, hc_surj⟩

end FormalGlueing

end LinearMap
