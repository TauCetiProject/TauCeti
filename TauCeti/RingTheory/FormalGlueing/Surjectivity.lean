module

public import TauCeti.RingTheory.FormalGlueing.Torsion
public import Mathlib.RingTheory.Localization.Module
import TauCeti.RingTheory.FormalGlueing.Cokernel
import TauCeti.RingTheory.FormalGlueing.Injectivity
import TauCeti.RingTheory.Flat.IsBaseChange
import TauCeti.RingTheory.TensorProduct.IsBaseChange

/-!
# Surjectivity of formal-gluing comparison maps

Let `R → S` be flat and induce `R/I ≅ S/IS`, where `I` is generated by a finite set `G`.
Formal-gluing data consist of an `R`-module `M`, an `S`-module `N` on the formal neighbourhood,
an `S`-module `P` on their overlap, and maps `f : M → P` and `g : N → P`. Suppose that `f`
exhibits `P` as the base change of `M` and that `g` becomes an isomorphism after inverting any
generator. Then the module of compatible pairs `K = ker (f.coprod (-g))` reconstructs `N`: the
comparison map `S ⊗[R] K → N` is an isomorphism
(`LinearMap.isBaseChange_snd_ker_coprod_of_formalGlueing`). On a basic open where `g` becomes an
isomorphism, `LinearMap.isLocalizedModule_fst_ker_coprod` identifies the localization of the
compatible pairs with that of `M`; together these reconstruct a module from formal-gluing data.

Injectivity of the comparison map is
`LinearMap.injective_liftBaseChange_snd_ker_coprod_of_formalGlueing`. For surjectivity, the
cokernel `Q = P ⧸ range g` is `I`-power torsion, hence its own base change
(`LinearMap.isBaseChange_coker_of_localized_surjective`). Flat base change of the left exact
sequence `0 → f⁻¹(range g) → M → Q` then shows that `f` exhibits `range g` as the base change of
`f⁻¹(range g)` (`IsBaseChange.of_left_exact_of_injective`). Every element of `f⁻¹(range g)` is
a first coordinate of a compatible pair, so `g ∘ c` is onto `range g`, and the difference lies
in `ker g`, which consists of compatible pairs with first coordinate `0`.

## Main results

* `LinearMap.isBaseChange_snd_ker_coprod_of_formalGlueing`: the module of compatible pairs
  reconstructs the prescribed module on the formal neighbourhood.

## References

* [The Stacks Project, Proposition 15.91.16](https://stacks.math.columbia.edu/tag/05ER),
  essential surjectivity of formal gluing of modules.
-/

public section

open Function TensorProduct

namespace LinearMap

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
  {M N P : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  [Module S N] [IsScalarTower R S N] [AddCommGroup P] [Module R P] [Module S P]
  [IsScalarTower R S P]

/-- **Formal gluing reconstructs modules.** Let `R → S` be flat and induce `R/I ≅ S/IS`, where
`I` is generated by a finite set `G`. Let `f : M → P` exhibit `P` as the base change of `M`, and
let `g : N → P` be `S`-linear and bijective after inverting each generator. Then the projection
from the module of compatible pairs `ker (f.coprod (-g))` to `N` exhibits `N` as its base change.
No Noetherian, faithful flatness or torsion-freeness hypothesis is needed. -/
@[stacks 05ER "essential surjectivity, for the module of compatible pairs"]
theorem isBaseChange_snd_ker_coprod_of_formalGlueing
    (f : M →ₗ[R] P) (g : N →ₗ[S] P) (hf : IsBaseChange S f) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ a ∈ G, Bijective (LocalizedModule.map (.powers (algebraMap R S a)) g)) :
    IsBaseChange S ((snd R M N).domRestrict (f.coprod (-g.restrictScalars R)).ker) := by
  set K := (f.coprod (-g.restrictScalars R)).ker
  set c := ((snd R M N).domRestrict K).liftBaseChange S
  have hK (k : K) : f (k : M × N).1 = g (k : M × N).2 := by
    simpa only [K, LinearMap.mem_ker, LinearMap.coprod_apply, LinearMap.neg_apply,
      LinearMap.coe_restrictScalars, sub_eq_zero, ← sub_eq_add_neg] using k.property
  have hc_inj : Injective c := injective_liftBaseChange_snd_ker_coprod_of_formalGlueing f g
    hf.liftBaseChange_injective G hG fun a ha ↦ (hloc a ha).1
  -- The preimage `K'` of `range g` in `M` has base change `range g`, since the cokernel of `g`
  -- is its own base change.
  let q : M →ₗ[R] P ⧸ range g := (range g).mkQ.restrictScalars R ∘ₗ f
  let K' := ker q
  let h : K' →ₗ[R] range g := (f ∘ₗ K'.subtype).codRestrict ((range g).restrictScalars R)
    fun m ↦ (Submodule.Quotient.mk_eq_zero _).mp (mem_ker.mp m.2)
  have hh : IsBaseChange S h :=
    IsBaseChange.of_left_exact_of_injective S (f := K'.subtype) (g := q)
      (f' := (range g).subtype) (g' := (range g).mkQ) (h₃ := LinearMap.id.restrictScalars R)
      rfl rfl hf (isBaseChange_coker_of_localized_surjective g G hG
        fun a ha ↦ (hloc a ha).2).liftBaseChange_injective
      (exact_subtype_ker_map q) K'.injective_subtype
      (exact_subtype_mkQ (range g)) (range g).injective_subtype
  -- Every element of `K'` is the first coordinate of a compatible pair.
  let p : K →ₗ[R] K' := ((fst R M N).domRestrict K).codRestrict K' fun k ↦ by
    simp [K', q, hK k]
  have hp : Surjective p := by
    rintro ⟨m, hm⟩
    obtain ⟨n, hn⟩ : f m ∈ range g := by simpa [K', q] using hm
    exact ⟨⟨(m, n), by simp [K, hn]⟩, rfl⟩
  -- `h ∘ p` is `f` applied to the first coordinate, by unfolding both codomain restrictions;
  -- on compatible pairs this agrees with `g` applied to the second coordinate.
  have hhp (k : K) : (h (p k) : P) = g (k : M × N).2 := hK k
  have hgc (t : S ⊗[R] K) : g (c t) = (h.liftBaseChange S (p.baseChange S t) : P) := by
    induction t with
    | tmul s k => simp [c, hhp]
    | add t t' ht ht' => simp only [map_add, Submodule.coe_add, ht, ht']
  -- Hence `c` reaches `range g` modulo `ker g`, and `ker g` lies in its image.
  have hc_surj : Surjective c := by
    intro y
    obtain ⟨t, ht⟩ := hh.liftBaseChange_bijective.2 ⟨g y, mem_range_self g y⟩
    obtain ⟨u, rfl⟩ := p.lTensor_surjective S hp t
    have hy : g (y - c u) = 0 := by
      rw [map_sub, hgc, baseChange_eq_lTensor, ht, sub_self]
    refine ⟨u + 1 ⊗ₜ ⟨(0, y - c u), by simp [K, hy]⟩, ?_⟩
    simp [c]
  exact IsBaseChange.iff_liftBaseChange_bijective.2 ⟨hc_inj, hc_surj⟩

end LinearMap
