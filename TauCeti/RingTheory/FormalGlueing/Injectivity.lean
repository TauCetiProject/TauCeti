module

public import TauCeti.RingTheory.FormalGlueing.Torsion
public import Mathlib.Algebra.Module.LocalizedModule.Basic
import TauCeti.RingTheory.Flat.IsBaseChange
import TauCeti.Algebra.Module.Torsion.Localization
import TauCeti.Algebra.Module.LocalizedModule.Submodule

/-!
# Injectivity of formal-gluing comparison maps

Let `R → S` be flat and induce `R/I ≅ S/IS`, with `I` generated by a finite set `G`.
For an `R`-linear map `f : M → N` into an `S`-module, consider the comparison map
`f.liftBaseChange S : S ⊗[R] M → N`. It is injective if and only if its localizations at
the images of the generators are injective and `f` is injective on the `I`-power torsion
of `M`.

This criterion applies to the comparison from reconstructed compatible elements to the
prescribed module on the formal neighbourhood. Once the comparison is an isomorphism on
the complementary principal opens, its kernel is ideal-power torsion. The torsion comparison
`TauCeti.primaryComponentEquivTensorProduct` identifies every element of that kernel with
`1 ⊗ m` for an ideal-power torsion element `m` of the reconstruction. Injectivity on these
elements then kills the kernel. Surjectivity, and hence reconstruction of arbitrary gluing
objects, is a separate assertion.

For the actual compatible-pairs module `ker (f.coprod (-g))`, the comparison to the
prescribed module is injective whenever the comparison for `f` and the localizations of
`g` are injective. The kernel of `g` is ideal-power torsion, so its multiplication
comparison is an isomorphism by `TauCeti.isBaseChange_of_primaryComponent_eq_top`.
The general linear-algebra step is `LinearMap.injective_liftBaseChange_snd_ker_coprod`.

Unlike detection for `f.baseChange S`, the target here is the prescribed `S`-module `N`, not
`S ⊗[R] N`. Neither faithful flatness nor finite generation of either module is required.

## References

* [The Stacks Project, Proposition 15.91.16](https://stacks.math.columbia.edu/tag/05ER),
  the kernel-vanishing step for the comparison from compatible elements.
* [The Stacks Project, Lemma 15.91.3](https://stacks.math.columbia.edu/tag/05EC),
  comparison of ideal-power torsion under base change.
-/

public section

open Function TensorProduct

namespace LinearMap

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
  {M N : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  [Module S N] [IsScalarTower R S N]

/-- For a flat map preserving `R/(G)`, a scalar-extension comparison is injective exactly
when it is injective on each complementary principal open and the original map is injective
on the `(G)`-power torsion. The target is an arbitrary `S`-module, not a scalar extension. -/
theorem injective_liftBaseChange_iff_primaryComponent_and_localized (f : M →ₗ[R] N)
    (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map)) :
    Injective (f.liftBaseChange S) ↔
      Injective (f.domRestrict ((Ideal.span (G : Set R)).primaryComponent M)) ∧
        ∀ g ∈ G, Injective (LocalizedModule.map (.powers (algebraMap R S g))
          (f.liftBaseChange S)) := by
  classical
  let I := Ideal.span (G : Set R)
  have hIfg : I.FG := ⟨G, rfl⟩
  let e := TauCeti.primaryComponentEquivTensorProduct (S := S) (M := M) hG hIfg
  refine ⟨fun hf ↦ ⟨?_, fun g _ ↦ LocalizedModule.map_injective _ _ hf⟩, ?_⟩
  · refine (injective_iff_map_eq_zero _).mpr fun m hm ↦ ?_
    have hm' : f (m : M) = 0 := hm
    have ht : (1 : S) ⊗ₜ[R] (m : M) = 0 :=
      (injective_iff_map_eq_zero _).mp hf _ (by simp [hm'])
    have he : e m = 0 := Subtype.ext (by
      rw [TauCeti.coe_primaryComponentEquivTensorProduct_apply]
      exact ht)
    exact e.injective (he.trans (map_zero e).symm)
  · rintro ⟨htors, hloc⟩
    refine (injective_iff_map_eq_zero _).mpr fun x hx ↦ ?_
    have hxloc (g : R) (hg : g ∈ G) :
        LocalizedModule.mkLinearMap (.powers (algebraMap R S g)) (S ⊗[R] M) x = 0 := by
      apply (injective_iff_map_eq_zero _).mp (hloc g hg)
      simp [hx]
    have hxtors : x ∈ (I.map (algebraMap R S)).primaryComponent (S ⊗[R] M) := by
      rw [Ideal.map_span, ← Finset.coe_image, Ideal.mem_primaryComponent_span_iff_localized]
      simpa only [Finset.forall_mem_image] using hxloc
    obtain ⟨m, hm⟩ := e.surjective ⟨x, hxtors⟩
    have hmx : (1 : S) ⊗ₜ[R] (m : M) = x := by
      simpa only [e, TauCeti.coe_primaryComponentEquivTensorProduct_apply] using
        congrArg Subtype.val hm
    have hmzero : f.domRestrict (I.primaryComponent M) m = 0 := by
      simpa using (congrArg (f.liftBaseChange S) hmx).trans hx
    have : m = 0 := (injective_iff_map_eq_zero _).mp htors m hmzero
    simpa [this] using hmx.symm

variable {P : Type*} [AddCommGroup P] [Module R P] [Module S P] [IsScalarTower R S P]

/-- For formal-gluing data, the scalar-extension comparison from the module of compatible
pairs to the prescribed `S`-module is injective. Only injectivity of the comparison for `f`
and of the map on the complementary principal opens is needed. -/
theorem injective_liftBaseChange_snd_ker_coprod_of_formalGlueing
    (f : M →ₗ[R] P) (g : N →ₗ[S] P) (hf : Injective (f.liftBaseChange S)) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ r ∈ G, Injective (LocalizedModule.map (.powers (algebraMap R S r)) g)) :
    Injective (((LinearMap.snd R M N).domRestrict
      (f.coprod (-g.restrictScalars R)).ker).liftBaseChange S) := by
  classical
  have ht : ((Ideal.span (G : Set R)).map (algebraMap R S)).primaryComponent g.ker = ⊤ := by
    rw [Ideal.map_span, ← Finset.coe_image,
      Ideal.primaryComponent_span_eq_top_iff_subsingleton_localized]
    intro s hs
    obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hs
    exact (LinearMap.localizedMap_injective_iff_subsingleton_localized_ker _ g).mp (hloc r hr)
  have hg := TauCeti.isBaseChange_of_primaryComponent_eq_top hG ht
  exact injective_liftBaseChange_snd_ker_coprod f g hf hg.1

end LinearMap
