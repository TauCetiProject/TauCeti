module

public import TauCeti.RingTheory.FormalGlueing.Detection
import TauCeti.Algebra.Module.Torsion.PrimaryComponent

/-!
# Lifting compatible elements in formal glueing

Let `R → S` be flat, and let `I` be generated by a finite set `G`, with
`R/I → S/IS` an isomorphism. An element of `S ⊗[R] M` comes from `M` if it comes from
`M_g` after localization at every `g ∈ G`. No faithful flatness or finiteness assumption
on the module is needed for this image criterion.

If `R → S` is moreover faithfully flat, compatible elements over `S` and the basic opens
`D(g)` have a unique common lift to `M`. This applies to completion of a Noetherian local
ring at its maximal ideal. Without faithful flatness, the image criterion does not assert
that arbitrarily prescribed local lifts can be realized simultaneously.

`IsBaseChange.mem_range_iff_locally_mem_range` gives the corresponding membership criterion
for any map exhibiting a faithfully flat base change, rather than only for the canonical map
into a tensor product.

The Amitsur differential of a locally liftable element is ideal-power torsion. Base change
identifies that torsion with the original torsion, and the multiplication retraction kills
the differential. The element's class in the cokernel of `M → S ⊗ M` then vanishes both
after base change and on the basic opens, so joint detection makes it zero.

## References

* The Stacks Project, Lemma 15.91.9 (05EK), exactness at the middle term of the formal-glueing
  complex. The image criterion applies to flat ring maps; simultaneous reconstruction of
  prescribed local elements is stated for faithfully flat maps, using localized modules
  rather than a separate complex.
-/

public section

open TensorProduct Function Submodule

namespace TauCeti

variable {R S M : Type*} [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M]

/-- The Amitsur differential vanishes on an element which becomes a base-change element
on each basic open, provided `R/I → S/IS` is bijective. -/
private theorem amitsur_differential_eq_zero_of_locally_in_range
    [Module.Flat R S] (G : Finset R)
    (hI : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (y : S ⊗[R] M)
    (hy : ∀ g ∈ G, ∃ z : LocalizedModule (.powers g) M,
      IsLocalizedModule.map (.powers g) (LocalizedModule.mkLinearMap (.powers g) M)
        (LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] M)) (TensorProduct.mk R S M 1) z =
          LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] M) y) :
    ((TensorProduct.mk R S M 1).lTensor S - TensorProduct.mk R S (S ⊗[R] M) 1) y = 0 := by
  classical
  let η := TensorProduct.mk R S M 1
  let d := η.lTensor S - TensorProduct.mk R S (S ⊗[R] M) 1
  have hd : d ∘ₗ η = 0 := by ext m; simp [d, η]
  -- The local lifts kill the Amitsur obstruction on every basic open, making it torsion.
  have ht : d y ∈ ((Ideal.span (G : Set R)).map (algebraMap R S)).primaryComponent
      (S ⊗[R] (S ⊗[R] M)) := by
    rw [Ideal.map_span, ← Finset.coe_image, Ideal.mem_primaryComponent_span_iff]
    intro s hs
    obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp hs
    obtain ⟨z, hz⟩ := hy g hg
    have hz' : LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] (S ⊗[R] M)) (d y) = 0 := by
      have h := congr(IsLocalizedModule.map (.powers g)
        (LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] M))
        (LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] (S ⊗[R] M))) d $hz)
      have hcomp := (IsLocalizedModule.map_comp' (.powers g)
        (LocalizedModule.mkLinearMap (.powers g) M)
        (LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] M))
        (LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] (S ⊗[R] M))) η d).symm
      rw [hd, map_zero] at hcomp
      have hzero := h.symm.trans (LinearMap.congr_fun hcomp z)
      simpa only [IsLocalizedModule.map_apply, LinearMap.zero_apply] using hzero
    obtain ⟨a, ha⟩ := (IsLocalizedModule.eq_zero_iff (.powers g) _).mp hz'
    obtain ⟨n, hn⟩ := a.2
    rw [Submonoid.smul_def, ← hn] at ha
    refine ⟨n, ?_⟩
    rw [← map_pow, algebraMap_smul]
    exact ha
  let e := primaryComponentEquivTensorProduct (M := S ⊗[R] M) hI
    (Submodule.fg_span G.finite_toSet)
  obtain ⟨z, hz⟩ := e.surjective ⟨d y, ht⟩
  have hz' : (1 : S) ⊗ₜ[R] (z : S ⊗[R] M) = d y :=
    (coe_primaryComponentEquivTensorProduct_apply hI
      (Submodule.fg_span G.finite_toSet) z).symm.trans (congrArg Subtype.val hz)
  -- Multiplication retracts `1 ⊗ -` and annihilates the Amitsur obstruction.
  let μ := TensorProduct.lift (Algebra.lsmul R R (A := S) (S ⊗[R] M)).toLinearMap
  have hμ : μ ∘ₗ d = 0 := by ext s m; simp [μ, d, η, smul_tmul']
  have hz0 : (z : S ⊗[R] M) = 0 := by
    have h := congr(μ $hz')
    have hμy : μ (d y) = 0 := LinearMap.congr_fun hμ y
    simpa [μ] using h.trans hμy
  rw [← hz', hz0, tmul_zero]

end TauCeti

namespace TensorProduct

variable {R S M : Type*} [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M] [Module.Flat R S] {G : Finset R}

/-- **Descent of membership in the base-change image.** Suppose `R → S` is flat and
`R/I → S/IS` is bijective, where `I` is generated by `G`. An element of `S ⊗ M` comes from `M`
if and only if it comes from `M_g` after localization at each `g ∈ G`. -/
theorem mem_range_mk_one_iff_locally_mem_range (y : S ⊗[R] M)
    (hI : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map)) :
    y ∈ LinearMap.range (TensorProduct.mk R S M 1) ↔
      ∀ g ∈ G, LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] M) y ∈
        LinearMap.range (IsLocalizedModule.map (.powers g)
          (LocalizedModule.mkLinearMap (.powers g) M)
          (LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] M))
          (TensorProduct.mk R S M 1)) := by
  constructor
  · rintro ⟨m, rfl⟩ g _
    exact ⟨LocalizedModule.mkLinearMap (.powers g) M m, IsLocalizedModule.map_apply ..⟩
  · intro hy
    let η : M →ₗ[R] S ⊗[R] M := TensorProduct.mk R S M 1
    let Q := (S ⊗[R] M) ⧸ η.range
    let q : S ⊗[R] M →ₗ[R] Q := η.range.mkQ
    have hqη : q ∘ₗ η = 0 := LinearMap.range_mkQ_comp η
    have hd := TauCeti.amitsur_differential_eq_zero_of_locally_in_range G hI y hy
    have heq : η.lTensor S y = (1 : S) ⊗ₜ[R] y := sub_eq_zero.mp hd
    -- In the cokernel of `η`, the Amitsur identity kills the base-change image of `y`.
    have hcomp0 : q.lTensor S ∘ₗ η.lTensor S = 0 := by
      rw [← LinearMap.lTensor_comp, hqη, LinearMap.lTensor_zero]
    have hS : (1 : S) ⊗ₜ[R] q y = 0 := by
      calc
        (1 : S) ⊗ₜ[R] q y = q.lTensor S ((1 : S) ⊗ₜ[R] y) := by simp
        _ = q.lTensor S (η.lTensor S y) := congrArg (q.lTensor S) heq.symm
        _ = 0 := LinearMap.congr_fun hcomp0 y
    have hzero : q y = 0 := by
      apply TauCeti.eq_zero_of_one_tmul_eq_zero_of_localized hI (q y) hS
      intro g hg
      obtain ⟨z, hz⟩ := hy g hg
      let locM := LocalizedModule.mkLinearMap (.powers g) M
      let locSM := LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] M)
      let locQ := LocalizedModule.mkLinearMap (.powers g) Q
      have hcomp := IsLocalizedModule.map_comp' (.powers g) locM locSM locQ η q
      rw [hqη, map_zero] at hcomp
      calc
        locQ (q y) = IsLocalizedModule.map (.powers g) locSM locQ q (locSM y) :=
          (IsLocalizedModule.map_apply ..).symm
        _ = IsLocalizedModule.map (.powers g) locSM locQ q
            (IsLocalizedModule.map (.powers g) locM locSM η z) :=
          congrArg (IsLocalizedModule.map (.powers g) locSM locQ q) hz.symm
        _ = 0 := (LinearMap.congr_fun hcomp z).symm
    exact (Submodule.Quotient.mk_eq_zero _).mp hzero

variable [Module.FaithfullyFlat R S]

omit [Module.Flat R S] in
/-- **Reconstruction from compatible formal-glueing elements.** For a faithfully flat map
`R → S` inducing `R/I ≅ S/IS`, an element over `S` and elements over each `D(g)`, for a finite
generating set `G` of `I`, have a unique common lift if their images agree over `S_g`.
Pairwise compatibility on the intersections `D(g h)` follows from faithful flatness and need
not be assumed separately. -/
@[stacks 05EK "exactness at the middle term, for faithfully flat ring maps"]
theorem existsUnique_formalGlueing_lift (y : S ⊗[R] M)
    (z : (g : G) → LocalizedModule (.powers g.1) M)
    (hI : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hz : ∀ g : G, IsLocalizedModule.map (.powers g.1)
      (LocalizedModule.mkLinearMap (.powers g.1) M)
      (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] M))
      (TensorProduct.mk R S M 1) (z g) =
        LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] M) y) :
    ∃! m : M, (1 : S) ⊗ₜ[R] m = y ∧
      ∀ g : G, LocalizedModule.mkLinearMap (.powers g.1) M m = z g := by
  have hη := Module.FaithfullyFlat.tensorProduct_mk_injective (A := R) (B := S) M
  obtain ⟨m, hm⟩ := (mem_range_mk_one_iff_locally_mem_range y hI).mpr
    (fun g hg ↦ ⟨z ⟨g, hg⟩, hz ⟨g, hg⟩⟩)
  refine ⟨m, ⟨hm, fun g ↦ ?_⟩, fun m' hm' ↦ hη (hm'.1.trans hm.symm)⟩
  apply IsLocalizedModule.map_injective (.powers g.1)
    (LocalizedModule.mkLinearMap (.powers g.1) M)
    (LocalizedModule.mkLinearMap (.powers g.1) (S ⊗[R] M)) _ hη
  rw [IsLocalizedModule.map_apply, hm, hz]

end TensorProduct

namespace IsBaseChange

variable {R S M N : Type*} [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [Module S N]
  [IsScalarTower R S N] [Module.FaithfullyFlat R S] {G : Finset R} {f : M →ₗ[R] N}

/-- A module model inside its faithfully flat base change is determined by its localizations
away from the ideal defining the formal neighbourhood. The map `f` need not be the canonical
map to a tensor product. -/
theorem mem_range_iff_locally_mem_range (hf : IsBaseChange S f)
    (hI : Function.Bijective (Ideal.quotientMap
      ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map)) (y : N) :
    y ∈ LinearMap.range f ↔ ∀ g ∈ G,
      LocalizedModule.mkLinearMap (.powers g) N y ∈ LinearMap.range
        (IsLocalizedModule.map (.powers g) (LocalizedModule.mkLinearMap (.powers g) M)
          (LocalizedModule.mkLinearMap (.powers g) N) f) := by
  let e := hf.equiv.restrictScalars R
  have he : e.toLinearMap ∘ₗ TensorProduct.mk R S M 1 = f := by
    ext m
    simp [e, IsBaseChange.equiv_tmul]
  constructor
  · rintro ⟨m, rfl⟩ g _
    exact ⟨LocalizedModule.mkLinearMap (.powers g) M m, IsLocalizedModule.map_apply ..⟩
  · intro hy
    have hlocal : ∀ g ∈ G,
        LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] M) (hf.equiv.symm y) ∈
          LinearMap.range (IsLocalizedModule.map (.powers g)
            (LocalizedModule.mkLinearMap (.powers g) M)
            (LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] M))
            (TensorProduct.mk R S M 1)) := by
      intro g hg
      obtain ⟨z, hz⟩ := hy g hg
      refine ⟨z, ?_⟩
      apply IsLocalizedModule.map_injective (.powers g)
        (LocalizedModule.mkLinearMap (.powers g) (S ⊗[R] M))
        (LocalizedModule.mkLinearMap (.powers g) N) e.toLinearMap e.injective
      rw [← LinearMap.comp_apply, ← IsLocalizedModule.map_comp', he, hz,
        IsLocalizedModule.map_apply]
      simp [e]
    obtain ⟨m, hm⟩ := (TensorProduct.mem_range_mk_one_iff_locally_mem_range
      (hf.equiv.symm y) hI).mpr hlocal
    exact ⟨m, by simpa [IsBaseChange.equiv_tmul] using congr(hf.equiv $hm)⟩

end IsBaseChange
