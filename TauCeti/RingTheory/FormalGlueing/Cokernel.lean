module

public import TauCeti.RingTheory.FormalGlueing.Torsion
public import TauCeti.Algebra.Module.Torsion.Localization
public import Mathlib.Algebra.Module.LocalizedModule.Submodule

/-!
# Cokernels supported on a formal neighbourhood

Let `R → S` be flat and induce an isomorphism `R/I ≅ S/IS`, where `I` is generated by a finite
set `G`. If a map of `S`-modules is surjective after inverting the image of each generator,
its cokernel is unchanged by base change from `R` to `S`: the canonical multiplication map
`S ⊗[R] Q → Q` is an isomorphism.

This applies to the comparison map `S ⊗[R] M → N` in formal module gluing. Once its principal
localizations are isomorphisms and it is injective, the resulting short exact sequence has
cokernel `Q` canonically identified with the base change of its underlying `R`-module. This
is the identification needed to descend that extension. It does not assert that the comparison
map itself is surjective.

## References

* The Stacks Project, proof of Proposition 15.91.16
  ([Tag 05ER](https://stacks.math.columbia.edu/tag/05ER)), the identification `Q = Q ⊗ S`.
* The torsion base-change input is `TauCeti.isBaseChange_of_primaryComponent_eq_top`
  (Stacks, Lemma 15.91.3, Tag 05EC).
-/

public section

open Function

namespace LinearMap

variable {R S M N : Type*} [CommRing R] [CommRing S] [Algebra R S]
  [Module.Flat R S] [AddCommGroup M] [Module S M] [AddCommGroup N]
  [Module R N] [Module S N] [IsScalarTower R S N]

/-- If an `S`-linear map is surjective off the formal neighbourhood defined by `(G)`, then
its cokernel is the base change of its underlying `R`-module. Neither module needs to be finite,
and `R → S` need not be faithfully flat. The base-change isomorphism is the canonical
multiplication map, not merely an unspecified isomorphism of modules. -/
theorem isBaseChange_coker_of_localized_surjective (f : M →ₗ[S] N) (G : Finset R)
    (hG : Bijective (Ideal.quotientMap ((Ideal.span (G : Set R)).map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ g ∈ G,
      Surjective (LocalizedModule.map (.powers (algebraMap R S g)) f)) :
    IsBaseChange S ((LinearMap.id : (N ⧸ f.range) →ₗ[S] (N ⧸ f.range)).restrictScalars R) := by
  classical
  have hQ : ((Ideal.span (G : Set R)).map (algebraMap R S)).primaryComponent
      (N ⧸ f.range) = ⊤ := by
    rw [Ideal.map_span, ← Finset.coe_image,
      Ideal.primaryComponent_span_eq_top_iff_subsingleton_localized]
    intro s hs
    obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp hs
    exact (f.localizedMap_surjective_iff_subsingleton_localized_coker _).mp (hloc g hg)
  exact TauCeti.isBaseChange_of_primaryComponent_eq_top hG hQ

end LinearMap
