module

public import Mathlib.RingTheory.Finiteness.Defs
public import Mathlib.RingTheory.LocalRing.Pullback
public import Mathlib.RingTheory.Localization.Away.Basic
public import TauCeti.RingTheory.Localization.Away.CommonIdeal

/-!
# Fibre products of rings along a surjection

Let `p : B →+* C` and `q : A' →+* C` be ring maps, and let

`A = B ×_C A' = {(b, a') | p b = q a'}`

be their fibre product, Mathlib's `RingHom.pullback p q`, with projections `A → B` and
`A → A'`. When `p` is surjective, Ferrand calls `Spec A` the pinching of `Spec B` along the
closed subscheme `Spec C` via `Spec C → Spec A'`: `Spec A` is obtained from `Spec B` by
contracting `Spec C` onto `Spec A'`. This file proves the ring-theoretic properties of `A`
behind this description.

* The kernel `I` of `A → A'` consists of the pairs `(b, 0)` with `p b = 0`, so the projection
  `A → B` maps `I` bijectively onto the ideal `ker p` of `B`. When `p` is surjective, Mathlib
  shows that `A → A'` is surjective (`RingHom.surjective_pullbackSnd_of_surjective`), so
  `A' ≅ A / I`.
* Hence for `t ∈ I` the map of localizations `A_t → B_t` is bijective: away from the
  pinched locus, `Spec B → Spec A` is an isomorphism.
* If `p` is surjective and `q` is finite, then `A → B` is finite.

None of this needs a Noetherian or reducedness hypothesis. That the fibre product square is
also a pushout square when `p` is surjective, so that `B ⊗_A A' ≅ C`, is
`RingHom.isPushout_pullback` in `TauCeti.Algebra.Category.Ring.Pullback`.

## Main results

* `RingHom.image_pullbackFst_ker_pullbackSnd`: the projection to `B` maps the kernel of the
  projection to `A'` onto `ker p`; it is injective there by
  `RingHom.ker_pullbackFst_inf_ker_pullbackSnd`.
* `RingHom.away_map_pullbackFst_bijective`: for `t` in that kernel, `A_t → B_t` is bijective.
* `RingHom.finite_pullbackFst`: if `p` is surjective and `q` is finite, then `A → B` is finite.

## References

* D. Ferrand, *Conducteur, descente et pincement*, Bull. Soc. Math. France 131 (2003),
  553–585, §§1.1–1.3 and Théorème 5.1.
-/

public section

namespace RingHom

section Ring

variable {R S T : Type*} [Ring R] [Ring S] [Semiring T] (f : R →+* T) (g : S →+* T)

/-- The two projections out of the fibre product `R ×_T S` have no common kernel. -/
@[simp]
theorem ker_pullbackFst_inf_ker_pullbackSnd :
    ker (f.pullbackFst g) ⊓ ker (f.pullbackSnd g) = ⊥ := by
  refine eq_bot_iff.mpr fun x ⟨h₁, h₂⟩ ↦ Ideal.mem_bot.mpr ?_
  exact Subtype.ext (Prod.ext (mem_ker.mp h₁) (mem_ker.mp h₂))

/-- The first projection maps the kernel of the second projection out of `R ×_T S` onto the
kernel of `f`: that kernel consists of the pairs `(r, 0)` with `f r = 0`. -/
theorem image_pullbackFst_ker_pullbackSnd :
    f.pullbackFst g '' (ker (f.pullbackSnd g) : Set (f.pullback g)) = ker f := by
  ext r
  refine ⟨?_, fun hr ↦ ⟨⟨(r, 0), by simpa using hr⟩, by simp, rfl⟩⟩
  rintro ⟨⟨⟨r, s⟩, hrs⟩, hs, rfl⟩
  obtain rfl : s = 0 := hs
  simpa using hrs

/-- The ideal of `R` generated by the image of the kernel of the second projection out of
`R ×_T S` is the kernel of `f`. This is `RingHom.map_pullbackSnd_ker_pullbackFst_eq` with the
roles of the two projections exchanged. -/
theorem map_pullbackFst_ker_pullbackSnd_eq :
    (ker (f.pullbackSnd g)).map (f.pullbackFst g) = ker f := by
  rw [Ideal.map, image_pullbackFst_ker_pullbackSnd, Ideal.span_eq]

end Ring

section CommRing

variable {B C A' : Type*} [CommRing B] [CommRing A'] [Semiring C] (p : B →+* C) (q : A' →+* C)

/-- **Ferrand's localization of a fibre product.** For `t` in the kernel of the projection
`B ×_C A' → A'`, the projection to `B` induces a bijection `(B ×_C A')_t → B_t` of
localizations away from `t` and its image. Geometrically, `Spec B → Spec (B ×_C A')` is an
isomorphism away from the closed subscheme `Spec A'`. -/
theorem away_map_pullbackFst_bijective {t : p.pullback q} (ht : t ∈ ker (p.pullbackSnd q))
    (S Q : Type*) [CommRing S] [CommRing Q] [Algebra (p.pullback q) S] [Algebra B Q]
    [IsLocalization.Away t S] [IsLocalization.Away (p.pullbackFst q t) Q] :
    Function.Bijective (IsLocalization.Away.map S Q (p.pullbackFst q) t) := by
  refine IsLocalization.Away.map_bijective_of_mem_ideal S Q
    (ker_pullbackFst_inf_ker_pullbackSnd p q) ?_ ht
  rw [map_pullbackFst_ker_pullbackSnd_eq p q, ← image_pullbackFst_ker_pullbackSnd p q]
  exact Set.image_subset_range _ _

end CommRing

section Finite

variable {B C A' : Type*} [CommRing B] [CommRing C] [CommRing A'] (p : B →+* C) (q : A' →+* C)

/-- If `p : B →+* C` is surjective and `q : A' →+* C` is finite, then `B` is finite over the
fibre product `B ×_C A'`. Lifts to `B` of generators of `C` over `A'`, together with `1`,
generate `B`. -/
theorem finite_pullbackFst (hp : Function.Surjective p) (hq : q.Finite) :
    (p.pullbackFst q).Finite := by
  algebraize [p.pullbackFst q, q]
  obtain ⟨n, c, hc⟩ := Module.Finite.exists_fin (R := A') (M := C)
  choose b hb using fun i ↦ hp (c i)
  refine ⟨Submodule.fg_def.mpr ⟨_, (Set.finite_range b).insert 1, eq_top_iff.mpr ?_⟩⟩
  intro x _
  -- write `p x = ∑ aᵢ' cᵢ` and lift the coefficients `aᵢ'` to the fibre product
  obtain ⟨a', ha'⟩ := Submodule.mem_span_range_iff_exists_fun A' |>.mp
    (hc ▸ Submodule.mem_top : p x ∈ Submodule.span A' (Set.range c))
  choose a ha using fun i ↦ surjective_pullbackSnd_of_surjective p q hp (a' i)
  -- the remainder lies in `ker p`, which is the image of an ideal of the fibre product
  have hy : x - ∑ i, a i • b i ∈ ker p := by
    simp only [mem_ker, map_sub, map_sum, Algebra.smul_def, map_mul, algebraMap_toAlgebra]
    rw [← ha', sub_eq_zero]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [Algebra.smul_def, algebraMap_toAlgebra, hb, ← ha i]
    exact congrArg (· * c i) (RingHom.congr_fun (pullback_comm_sq p q) (a i)).symm
  obtain ⟨a₀, -, ha₀⟩ : x - ∑ i, a i • b i ∈ p.pullbackFst q '' ker (p.pullbackSnd q) := by
    rwa [image_pullbackFst_ker_pullbackSnd p q]
  rw [← sub_add_cancel x (∑ i, a i • b i), ← ha₀]
  refine add_mem ?_ (Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _
    (Submodule.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)))
  have h := Submodule.smul_mem _ a₀
    (Submodule.subset_span (Set.mem_insert (1 : B) (Set.range b)))
  rwa [Algebra.smul_def, mul_one, algebraMap_toAlgebra] at h

end Finite

end RingHom
