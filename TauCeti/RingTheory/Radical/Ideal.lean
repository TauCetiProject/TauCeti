module

public import Mathlib.RingTheory.DedekindDomain.PID
public import Mathlib.RingTheory.Radical.Basic

/-!
# The radical of a principal ideal

In a principal ideal domain `R`, both `R` and its monoid of ideals are unique factorisation
monoids, so each has a radical `UniqueFactorizationMonoid.radical`, the product of the distinct
normalised prime factors. This file proves that the two radicals correspond under
`x ↦ Ideal.span {x}`:

`radical (Ideal.span {x}) = Ideal.span {radical x}`.

Ideal-valued invariants over a Dedekind domain, such as the radical of a discriminant or
conductor ideal, can therefore be read as elements once the ring is principal, for instance
over `ℤ`. Mathlib's `Ideal.radical_span_singleton_eq_span_radical` is the analogous statement
for the ideal-theoretic radical `Ideal.radical`.

## Main results

* `UniqueFactorizationMonoid.radical_span_singleton`: in a principal ideal domain,
  `radical (Ideal.span {x}) = Ideal.span {radical x}`.
-/

public section

namespace UniqueFactorizationMonoid

variable {R : Type*} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R] [NormalizationMonoid R]

/-- **In a principal ideal domain, the radical of a principal ideal is generated by the radical
of its generator.** Both radicals are taken in the sense of `UniqueFactorizationMonoid.radical`,
on the left in the monoid of ideals and on the right in `R`. -/
theorem radical_span_singleton (x : R) :
    radical (Ideal.span {x}) = Ideal.span {radical x} := by
  rcases eq_or_ne x 0 with rfl | hx
  · rw [Ideal.span_singleton_eq_bot.2 rfl, ← Ideal.zero_eq_bot, radical_zero, radical_zero,
      Ideal.span_singleton_one, Ideal.one_eq_top]
  have hx' : Ideal.span {x} ≠ 0 := by
    rwa [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]
  -- `Ideal.span {radical x}` is radical in the monoid of ideals, since every ideal is principal
  -- and `radical x` is radical in `R`.
  have hrad : IsRadical (Ideal.span {radical x}) := by
    intro n J hJ
    rw [← Ideal.span_singleton_generator J, Ideal.span_singleton_pow,
      Ideal.span_singleton_dvd_span_singleton_iff_dvd] at hJ
    rw [← Ideal.span_singleton_generator J, Ideal.span_singleton_dvd_span_singleton_iff_dvd]
    exact isRadical_radical n _ hJ
  refine dvd_antisymm ?_ ((dvd_radical_iff hrad hx').2
    (Ideal.span_singleton_dvd_span_singleton_iff_dvd.2 radical_dvd_self))
  -- `x` divides a power of `radical x`, so the radical of `Ideal.span {x}` divides that of
  -- `Ideal.span {radical x}`, which divides `Ideal.span {radical x}`.
  obtain ⟨n, hn⟩ := exists_dvd_radical_self_pow hx
  have hn' : Ideal.span {x} ∣ Ideal.span {radical x} ^ n := by
    rwa [Ideal.span_singleton_pow, Ideal.span_singleton_dvd_span_singleton_iff_dvd]
  have h0 : Ideal.span {radical x} ^ n ≠ 0 := by
    refine pow_ne_zero n ?_
    rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]
    exact radical_ne_zero
  exact ((radical_dvd_radical hn' h0).trans radical_pow_dvd).trans radical_dvd_self

end UniqueFactorizationMonoid

end
