/-!
# The relative ideal norm over a discrete valuation ring

Let `A` be a discrete valuation ring and `B` a Dedekind domain, finite and torsion-free over `A`.
For a nonzero ideal `J` of `B`, the relative norm of `J` is the power of the maximal ideal of `A`
given by the length of `B ⧸ J`: `relNorm A J = 𝔪_A ^ length_A (B ⧸ J)`. This expresses the
norm exponent over `A` as a length, which is how ideal norms are compared with other
length-valued invariants, such as determinants of lattices. (Applying this at the localization
`R_p` of a global Dedekind domain `R` also needs `relNorm` to commute with localization, which is
not proved here.) By `Ideal.length_quotient_eq_finsum_count_normalizedFactors_mul`, this
exponent is `Σ_m v_m(J) [κ(m) : κ(A)]`, the sum over the maximal ideals `m` of `B`.

The proof uses that `B` is semilocal, hence a principal ideal domain, so `J = bB`; then
`relNorm A J` is generated by the norm of `b`, whose order is the length of `B ⧸ bB`
(`TauCeti.length_quotient_span_singleton_eq_ord_norm`). No separability of the extension of
fraction fields is needed.

## Main results

* `Ideal.relNorm_eq_maximalIdeal_pow_length`: over a discrete valuation ring `A`,
  `relNorm A J = 𝔪_A ^ length_A (B ⧸ J)`.

## References

* J.-P. Serre, *Local Fields*, Chapter I, §5 (the norm of an ideal) and Chapter III, §1.
-/

public section

namespace Ideal

section DiscreteValuationRing

variable {A B : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [CommRing B]
  [IsDedekindDomain B] [Algebra A B] [Module.Finite A B] [Module.IsTorsionFree A B]

/-- **The relative norm over a discrete valuation ring is a power of the maximal ideal given by a
length.** Let `B` be a Dedekind domain, finite and torsion-free over a discrete valuation ring `A`.
For a nonzero ideal `J` of `B`, `relNorm A J = 𝔪_A ^ length_A (B ⧸ J)`. Equivalently the exponent
of the relative norm is `Σ_m v_m(J) [κ(m) : κ(A)]`
(`Ideal.length_quotient_eq_finsum_count_normalizedFactors_mul`). -/
theorem relNorm_eq_maximalIdeal_pow_length {J : Ideal B} (hJ : J ≠ ⊥) :
    relNorm A J = IsLocalRing.maximalIdeal A ^ (Module.length A (B ⧸ J)).toNat := by
  -- `B` is semilocal, hence a principal ideal domain, and free over `A`.
  have := TauCeti.finite_maximalSpectrum_of_isIntegral_of_quasiFinite A (B := B)
  have : IsPrincipalIdealRing B := IsPrincipalIdealRing.of_finite_maximals <|
    (Set.finite_range MaximalSpectrum.asIdeal).subset fun I hI ↦ ⟨⟨I, hI⟩, rfl⟩
  have : Module.Free A B := Module.free_of_finite_type_torsion_free'
  obtain ⟨b, rfl⟩ := Submodule.IsPrincipal.principal J
  rw [submodule_span_eq] at hJ ⊢
  have hb : Algebra.norm A b ≠ 0 := by
    rw [Ne, Algebra.norm_eq_zero_iff]
    rintro rfl
    exact hJ (by simp)
  rw [relNorm_singleton, Algebra.intNorm_eq_norm,
    TauCeti.length_quotient_span_singleton_eq_ord_norm hb, Ring.ord]
  exact eq_maximalIdeal_pow_length_quotient _ (by simpa using hb)

end DiscreteValuationRing

end Ideal
