import TauCeti.RingTheory.Jacobson.Basic

/-!
# The relative Dennis–Stein group of an ideal

For an ideal `I` of a commutative ring `R`, the relative Dennis–Stein group `D(R, I)` is the
abelian group generated by symbols `⟨r, s⟩` for the pairs with `r ∈ I` or `s ∈ I`, subject only
to the guarded relations

* (D1) `⟨r, s⟩ + ⟨s, r⟩ = 0`;
* (D2) `⟨r, s⟩ + ⟨r, t⟩ = ⟨r, s + t - r * s * t⟩` when all three displayed pairs are relative
  generators, that is when `r ∈ I`, or `s ∈ I` and `t ∈ I`;
* (D3) `⟨r, s * t⟩ = ⟨r * s, t⟩ + ⟨r * t, s⟩` when `r ∈ I`, `s ∈ I` or `t ∈ I`.

The guard on D3 is a condition on the inputs `r, s, t`, and is stronger than asking that the three
displayed pairs be relative generators: over `𝔽₃[x, y] / (x², y²)` with `I = (x * y)`, the triple
`(x, y, x + y)` displays only relative generators, yet no input lies in `I`, and this instance of
D3 is not a relation of `D(R, I)`.

The group `D(R, I)` is a presentation of the relative group `K₂(R, I)` when `I` lies in the
Jacobson radical (Keune). In that case every relative generator `(r, s)` is admissible, since
`r * s ∈ I`, and the generator map `D(R, I) →+ D(R)` of
`TauCeti.RelativeDennisSteinGroup.toDennisSteinGroup` is defined.

As for the absolute group, `TauCeti.RelativeDennisSteinGroup.symbol I r s` is defined for every
pair and is `0` when neither entry lies in `I`.

## Main definitions

* `TauCeti.RelativeDennisSteinGroup I`: the group `D(R, I)`.
* `TauCeti.RelativeDennisSteinGroup.symbol`: the relative symbol `⟨r, s⟩`.
* `TauCeti.RelativeDennisSteinGroup.lift`: the universal property of `D(R, I)`.
* `TauCeti.RelativeDennisSteinGroup.toDennisSteinGroup`: the generator map `D(R, I) →+ D(R)`
  for `I` contained in the Jacobson radical.

## Main results

* `TauCeti.RelativeDennisSteinGroup.symbol_add_symbol_swap`,
  `TauCeti.RelativeDennisSteinGroup.symbol_add_symbol` and
  `TauCeti.RelativeDennisSteinGroup.symbol_mul_right`: the guarded relations D1–D3.
* `TauCeti.RelativeDennisSteinGroup.instSubsingletonBot`: the group `D(R, ⊥)` is trivial.

## References

* F. Keune, *The relativization of K₂*, J. Algebra 54 (1978), 159–177, Theorem 15.
* W. van der Kallen, *The K₂ of rings with many units*, Ann. Sci. École Norm. Sup. (4) 10 (1977),
  473–515.
* C. A. Weibel, *The K-book*, Graduate Studies in Mathematics 145, AMS (2013), III.5.11.1(b).
-/

public section

namespace TauCeti

variable {R : Type*} [CommRing R] (I : Ideal R)

namespace RelativeDennisSteinGroup

/-- A relative Dennis–Stein generator for the ideal `I`: a pair `(r, s)` with `r ∈ I` or
`s ∈ I`. -/
structure Pair where
  /-- The first entry `r`. -/
  fst : R
  /-- The second entry `s`. -/
  snd : R
  /-- One of the two entries lies in `I`. -/
  mem : fst ∈ I ∨ snd ∈ I

/-- The guarded Dennis–Stein relations among relative generators: D1 `⟨r, s⟩ + ⟨s, r⟩`; D2
`⟨r, s⟩ + ⟨r, t⟩ - ⟨r, s + t - r s t⟩` when the three displayed pairs are relative generators; D3
`⟨r, s t⟩ - ⟨r s, t⟩ - ⟨r t, s⟩` when one of the inputs `r, s, t` lies in `I`. -/
def relations : Set (FreeAddCommGroup (Pair I)) :=
  {x | (∃ (r s : R) (h : r ∈ I ∨ s ∈ I) (h' : s ∈ I ∨ r ∈ I),
      x = .of ⟨r, s, h⟩ + .of ⟨s, r, h'⟩) ∨
    (∃ (r s t : R) (hs : r ∈ I ∨ s ∈ I) (ht : r ∈ I ∨ t ∈ I)
      (h : r ∈ I ∨ s + t - r * s * t ∈ I),
      x = .of ⟨r, s, hs⟩ + .of ⟨r, t, ht⟩ - .of ⟨r, s + t - r * s * t, h⟩) ∨
    (∃ r s t : R, (r ∈ I ∨ s ∈ I ∨ t ∈ I) ∧
      ∃ (h : r ∈ I ∨ s * t ∈ I) (h₁ : r * s ∈ I ∨ t ∈ I) (h₂ : r * t ∈ I ∨ s ∈ I),
        x = .of ⟨r, s * t, h⟩ - .of ⟨r * s, t, h₁⟩ - .of ⟨r * t, s, h₂⟩)}

end RelativeDennisSteinGroup

/-- The **relative Dennis–Stein group** `D(R, I)` of an ideal `I` of a commutative ring: the free
abelian group on the pairs with an entry in `I`, modulo the guarded relations D1–D3. -/
@[expose] def RelativeDennisSteinGroup : Type _ :=
  FreeAddCommGroup (RelativeDennisSteinGroup.Pair I) ⧸
    AddSubgroup.closure (RelativeDennisSteinGroup.relations I)

namespace RelativeDennisSteinGroup

noncomputable instance : AddCommGroup (RelativeDennisSteinGroup I) :=
  inferInstanceAs (AddCommGroup (FreeAddCommGroup (Pair I) ⧸ AddSubgroup.closure (relations I)))

variable {I}

/-- The class of a relative generator in `D(R, I)`. -/
private def mk (p : Pair I) : RelativeDennisSteinGroup I :=
  QuotientAddGroup.mk (s := AddSubgroup.closure (relations I)) (FreeAddCommGroup.of p)

variable (I) in
open scoped Classical in
/-- The **relative Dennis–Stein symbol** `⟨r, s⟩ ∈ D(R, I)`. It is the generator attached to
`(r, s)` when `r ∈ I` or `s ∈ I`, and `0` otherwise. -/
noncomputable def symbol (r s : R) : RelativeDennisSteinGroup I :=
  if h : r ∈ I ∨ s ∈ I then mk ⟨r, s, h⟩ else 0

private theorem mk_eq_symbol (p : Pair I) : mk p = symbol I p.fst p.snd := by
  simp [symbol, p.mem]

private theorem mk_eq_symbol' {r s : R} (h : r ∈ I ∨ s ∈ I) : mk ⟨r, s, h⟩ = symbol I r s :=
  mk_eq_symbol _

/-- A pair with no entry in `I` has symbol `0`. -/
theorem symbol_eq_zero_of_notMem {r s : R} (hr : r ∉ I) (hs : s ∉ I) : symbol I r s = 0 := by
  simp [symbol, hr, hs]

private theorem mk_eq_zero_of_mem {x : FreeAddCommGroup (Pair I)} (hx : x ∈ relations I) :
    (QuotientAddGroup.mk (s := AddSubgroup.closure (relations I)) x :
      RelativeDennisSteinGroup I) = 0 :=
  (QuotientAddGroup.eq_zero_iff x).2 (AddSubgroup.subset_closure hx)

/-- **D1** for relative symbols: `⟨r, s⟩ + ⟨s, r⟩ = 0`. -/
theorem symbol_add_symbol_swap (r s : R) : symbol I r s + symbol I s r = 0 := by
  by_cases h : r ∈ I ∨ s ∈ I
  · rw [← mk_eq_symbol' h, ← mk_eq_symbol' h.symm]
    exact mk_eq_zero_of_mem (Or.inl ⟨r, s, h, h.symm, rfl⟩)
  · rw [not_or] at h
    rw [symbol_eq_zero_of_notMem h.1 h.2, symbol_eq_zero_of_notMem h.2 h.1, add_zero]

/-- D1 for relative symbols in the form `⟨s, r⟩ = -⟨r, s⟩`. -/
theorem symbol_swap (r s : R) : symbol I s r = -symbol I r s :=
  eq_neg_of_add_eq_zero_right (symbol_add_symbol_swap r s)

/-- **D2** for relative symbols: `⟨r, s⟩ + ⟨r, t⟩ = ⟨r, s + t - r * s * t⟩` when `r ∈ I`, or
`s ∈ I` and `t ∈ I`. -/
theorem symbol_add_symbol {r s t : R} (h : r ∈ I ∨ s ∈ I ∧ t ∈ I) :
    symbol I r s + symbol I r t = symbol I r (s + t - r * s * t) := by
  have hs : r ∈ I ∨ s ∈ I := h.imp_right And.left
  have ht : r ∈ I ∨ t ∈ I := h.imp_right And.right
  have hst : r ∈ I ∨ s + t - r * s * t ∈ I := h.imp_right fun h =>
    I.sub_mem (I.add_mem h.1 h.2) (I.mul_mem_right t (I.mul_mem_left r h.1))
  rw [← mk_eq_symbol' hs, ← mk_eq_symbol' ht, ← mk_eq_symbol' hst, ← sub_eq_zero]
  exact mk_eq_zero_of_mem (Or.inr (Or.inl ⟨r, s, t, hs, ht, hst, rfl⟩))

/-- **D3** for relative symbols: `⟨r, s * t⟩ = ⟨r * s, t⟩ + ⟨r * t, s⟩` when `r ∈ I`, `s ∈ I` or
`t ∈ I`. -/
theorem symbol_mul_right {r s t : R} (h : r ∈ I ∨ s ∈ I ∨ t ∈ I) :
    symbol I r (s * t) = symbol I (r * s) t + symbol I (r * t) s := by
  have h₀ : r ∈ I ∨ s * t ∈ I :=
    h.imp_right (Or.rec (I.mul_mem_right t) (I.mul_mem_left s))
  have h₁ : r * s ∈ I ∨ t ∈ I :=
    (h.imp_left (I.mul_mem_right s)).elim Or.inl
      (Or.rec (fun hs => Or.inl (I.mul_mem_left r hs)) Or.inr)
  have h₂ : r * t ∈ I ∨ s ∈ I :=
    (h.imp_left (I.mul_mem_right t)).elim Or.inl
      (Or.rec Or.inr (fun ht => Or.inl (I.mul_mem_left r ht)))
  rw [← mk_eq_symbol' h₀, ← mk_eq_symbol' h₁, ← mk_eq_symbol' h₂, ← sub_eq_zero, ← sub_sub]
  exact mk_eq_zero_of_mem (Or.inr (Or.inr ⟨r, s, t, h, h₀, h₁, h₂, rfl⟩))

/-- `⟨r, 0⟩ = 0` in `D(R, I)`, by D2 with `s = t = 0`. -/
@[simp]
theorem symbol_zero_right (r : R) : symbol I r (0 : R) = 0 := by
  have := symbol_add_symbol (I := I) (r := r) (s := 0) (t := 0) (Or.inr ⟨I.zero_mem, I.zero_mem⟩)
  simpa using this

/-- `⟨0, s⟩ = 0` in `D(R, I)`, by D1 and `⟨s, 0⟩ = 0`. -/
@[simp]
theorem symbol_zero_left (s : R) : symbol I (0 : R) s = 0 := by
  rw [symbol_swap, symbol_zero_right, neg_zero]

/-- **Induction principle**: a predicate on `D(R, I)` that holds for `0` and for every relative
symbol, and is preserved by addition and negation, holds everywhere. -/
@[elab_as_elim]
theorem induction_on {P : RelativeDennisSteinGroup I → Prop} (x : RelativeDennisSteinGroup I)
    (zero : P 0) (symbol : ∀ r s, r ∈ I ∨ s ∈ I → P (symbol I r s))
    (add : ∀ x y, P x → P y → P (x + y)) (neg : ∀ x, P x → P (-x)) : P x := by
  induction x using QuotientAddGroup.induction_on with | H z => ?_
  induction z using FreeAddCommGroup.induction_on with
  | zero => exact zero
  | of p =>
    -- The class of the generator `FreeAddCommGroup.of p` is `mk p` by definition.
    change P (mk p)
    rw [mk_eq_symbol]
    exact symbol _ _ p.mem
  | neg p hp =>
    rw [QuotientAddGroup.mk_neg]
    exact neg _ hp
  | add x y hx hy =>
    rw [QuotientAddGroup.mk_add]
    exact add _ _ hx hy

/-- Additive maps out of `D(R, I)` agreeing on every relative symbol are equal. -/
@[ext]
theorem hom_ext {G : Type*} [AddGroup G] {f g : RelativeDennisSteinGroup I →+ G}
    (h : ∀ r s, r ∈ I ∨ s ∈ I → f (symbol I r s) = g (symbol I r s)) : f = g := by
  ext x
  induction x using induction_on with
  | zero => simp
  | symbol r s hrs => exact h r s hrs
  | add x y hx hy => simp [hx, hy]
  | neg x hx => simp [hx]

/-- The relative group of the zero ideal is trivial: every generator has a zero entry. -/
instance instSubsingletonBot : Subsingleton (RelativeDennisSteinGroup (⊥ : Ideal R)) := by
  refine ⟨fun x y => ?_⟩
  suffices h : ∀ z : RelativeDennisSteinGroup (⊥ : Ideal R), z = 0 by rw [h x, h y]
  intro z
  induction z using induction_on with
  | zero => rfl
  | symbol r s hrs =>
    rcases hrs with hr | hs
    · rw [Ideal.mem_bot.1 hr, symbol_zero_left]
    · rw [Ideal.mem_bot.1 hs, symbol_zero_right]
  | add x y hx hy => rw [hx, hy, add_zero]
  | neg x hx => rw [hx, neg_zero]

section lift

variable {G : Type*} [AddCommGroup G] (f : R → R → G)
  (h₁ : ∀ r s, r ∈ I ∨ s ∈ I → f r s + f s r = 0)
  (h₂ : ∀ r s t, r ∈ I ∨ s ∈ I ∧ t ∈ I → f r s + f r t = f r (s + t - r * s * t))
  (h₃ : ∀ r s t, r ∈ I ∨ s ∈ I ∨ t ∈ I → f r (s * t) = f (r * s) t + f (r * t) s)

/-- **Universal property of `D(R, I)`**: a function on pairs satisfying the guarded relations
D1–D3 induces an additive map `D(R, I) →+ G` sending each relative symbol `⟨r, s⟩` to `f r s`. -/
noncomputable def lift : RelativeDennisSteinGroup I →+ G :=
  QuotientAddGroup.lift (AddSubgroup.closure (relations I))
    (FreeAddCommGroup.lift fun p : Pair I => f p.fst p.snd) <| by
      rw [AddSubgroup.closure_le]
      rintro x (⟨r, s, h, -, rfl⟩ | ⟨r, s, t, hs, ht, -, rfl⟩ | ⟨r, s, t, h, -, -, -, rfl⟩) <;>
        simp only [SetLike.mem_coe, AddMonoidHom.mem_ker, map_add, map_sub,
          FreeAddCommGroup.lift_apply_of]
      · exact h₁ r s h
      · -- The three pairs of D2 are relative exactly when `r ∈ I`, or `s ∈ I` and `t ∈ I`.
        have h : r ∈ I ∨ s ∈ I ∧ t ∈ I := by
          rcases hs with hr | hs
          · exact Or.inl hr
          · exact ht.imp_right fun ht => ⟨hs, ht⟩
        rw [h₂ r s t h, sub_self]
      · rw [h₃ r s t h, sub_sub, sub_self]

/-- The value of `TauCeti.RelativeDennisSteinGroup.lift` on a relative symbol. -/
@[simp]
theorem lift_symbol {r s : R} (h : r ∈ I ∨ s ∈ I) :
    lift f h₁ h₂ h₃ (symbol I r s) = f r s := by
  rw [← mk_eq_symbol' h]
  exact FreeAddCommGroup.lift_apply_of _ _

end lift

/-- The **generator map** `D(R, I) →+ D(R)` for an ideal `I` contained in the Jacobson radical,
sending each relative symbol `⟨r, s⟩` to the Dennis–Stein symbol `⟨r, s⟩`, which is admissible
because `r * s ∈ I` (`Ideal.isUnit_one_sub_mul_of_le_jacobson`). -/
noncomputable def toDennisSteinGroup (hI : I ≤ Ring.jacobson R) :
    RelativeDennisSteinGroup I →+ DennisSteinGroup R :=
  lift DennisSteinGroup.symbol (fun r s _ => DennisSteinGroup.symbol_add_symbol_swap r s)
    (fun _ _ _ h => DennisSteinGroup.symbol_add_symbol
      (Ideal.isUnit_one_sub_mul_of_le_jacobson hI (h.imp_right And.left))
      (Ideal.isUnit_one_sub_mul_of_le_jacobson hI (h.imp_right And.right)))
    (fun r s t _ => DennisSteinGroup.symbol_mul_right r s t)

/-- The generator map sends the relative symbol `⟨r, s⟩` to the Dennis–Stein symbol `⟨r, s⟩`. -/
@[simp]
theorem toDennisSteinGroup_symbol (hI : I ≤ Ring.jacobson R) {r s : R} (h : r ∈ I ∨ s ∈ I) :
    toDennisSteinGroup hI (symbol I r s) = DennisSteinGroup.symbol r s :=
  lift_symbol _ _ _ _ h

end RelativeDennisSteinGroup

end TauCeti
