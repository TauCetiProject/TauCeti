import Mathlib.Tactic.Ring

/-!
# The Dennis–Stein presentation group of a commutative ring

For a commutative ring `A`, a pair `(r, s)` of elements is *admissible* when `1 - r * s` is a
unit. The Dennis–Stein group `D(A)` is the abelian group generated by symbols `⟨r, s⟩`, one for
each admissible pair, subject only to the relations

* (D1) `⟨r, s⟩ + ⟨s, r⟩ = 0`;
* (D2) `⟨r, s⟩ + ⟨r, t⟩ = ⟨r, s + t - r * s * t⟩` when `(r, s)` and `(r, t)` are admissible;
* (D3) `⟨r, s * t⟩ = ⟨r * s, t⟩ + ⟨r * t, s⟩` when `(r, s * t)` is admissible.

These are the relations satisfied by the Dennis–Stein symbols in `K₂(A)`, in the modern
convention where `⟨r, s⟩` is defined when `1 - r * s` (rather than `1 + r * s`) is a unit and
`⟨u, s⟩ = {u, 1 - u * s}` for a unit `u`. The group `D(A)` is the source of the generator map to
`K₂(A)`, which is an isomorphism for fields and for commutative local rings.

In D2 the third pair is admissible because
`1 - r * (s + t - r * s * t) = (1 - r * s) * (1 - r * t)`, and in D3 all three pairs are
admissible together since `A` is commutative.

To avoid carrying admissibility proofs around, `TauCeti.DennisSteinGroup.symbol r s` is defined
for every pair and is `0` when `(r, s)` is not admissible. With this convention D1 and D3 hold
without hypotheses.

## Main definitions

* `TauCeti.DennisSteinGroup A`: the group `D(A)`, the free abelian group on the admissible pairs
  modulo D1–D3.
* `TauCeti.DennisSteinGroup.symbol`: the symbol `⟨r, s⟩`.
* `TauCeti.DennisSteinGroup.lift`: the universal property; a function on pairs satisfying D1–D3
  on admissible pairs induces an additive map out of `D(A)`.
* `TauCeti.DennisSteinGroup.map`: functoriality in ring homomorphisms.

## Main results

* `TauCeti.DennisSteinGroup.symbol_add_symbol_swap`, `TauCeti.DennisSteinGroup.symbol_add_symbol`
  and `TauCeti.DennisSteinGroup.symbol_mul_right`: the relations D1–D3.
* `TauCeti.DennisSteinGroup.symbol_zero_left`, `TauCeti.DennisSteinGroup.symbol_zero_right`,
  `TauCeti.DennisSteinGroup.symbol_one_left` and `TauCeti.DennisSteinGroup.symbol_one_right`:
  symbols with an entry `0` or `1` vanish.
* `TauCeti.DennisSteinGroup.hom_ext`: additive maps out of `D(A)` are determined by their values
  on admissible symbols.

## References

* R. K. Dennis, M. R. Stein, *K₂ of radical ideals and semi-local rings*, in *Algebraic K-theory
  II*, Lecture Notes in Math. 342 (1973), Proposition 1.1.
* W. van der Kallen, H. Maazen, J. Stienstra, *A presentation for some K₂(n, R)*, Bull. Amer.
  Math. Soc. 81 (1975), 934–936.
* C. A. Weibel, *The K-book*, Graduate Studies in Mathematics 145, AMS (2013), III.5.11.
-/

public section

namespace TauCeti

variable (A : Type*) [CommRing A]

namespace DennisSteinGroup

/-- An admissible Dennis–Stein pair: a pair `(r, s)` with `1 - r * s` a unit. -/
structure Pair where
  /-- The first entry `r`. -/
  fst : A
  /-- The second entry `s`. -/
  snd : A
  /-- Admissibility: `1 - r * s` is a unit. -/
  isUnit_one_sub_mul : IsUnit (1 - fst * snd)

/-- The Dennis–Stein relations D1–D3 among admissible pairs, each imposed exactly when all the
pairs it displays are admissible: `⟨r, s⟩ + ⟨s, r⟩`, `⟨r, s⟩ + ⟨r, t⟩ - ⟨r, s + t - r s t⟩` and
`⟨r, s t⟩ - ⟨r s, t⟩ - ⟨r t, s⟩`. -/
def relations : Set (FreeAddCommGroup (Pair A)) :=
  {x | (∃ (r s : A) (h : IsUnit (1 - r * s)) (h' : IsUnit (1 - s * r)),
      x = .of ⟨r, s, h⟩ + .of ⟨s, r, h'⟩) ∨
    (∃ (r s t : A) (hs : IsUnit (1 - r * s)) (ht : IsUnit (1 - r * t))
      (h : IsUnit (1 - r * (s + t - r * s * t))),
      x = .of ⟨r, s, hs⟩ + .of ⟨r, t, ht⟩ - .of ⟨r, s + t - r * s * t, h⟩) ∨
    (∃ (r s t : A) (h : IsUnit (1 - r * (s * t))) (h₁ : IsUnit (1 - r * s * t))
      (h₂ : IsUnit (1 - r * t * s)),
      x = .of ⟨r, s * t, h⟩ - .of ⟨r * s, t, h₁⟩ - .of ⟨r * t, s, h₂⟩)}

end DennisSteinGroup

/-- The **Dennis–Stein group** `D(A)` of a commutative ring: the free abelian group on the
admissible pairs `(r, s)`, those with `1 - r * s` a unit, modulo the relations D1–D3. -/
@[expose] def DennisSteinGroup : Type _ :=
  FreeAddCommGroup (DennisSteinGroup.Pair A) ⧸
    AddSubgroup.closure (DennisSteinGroup.relations A)

namespace DennisSteinGroup

noncomputable instance : AddCommGroup (DennisSteinGroup A) :=
  inferInstanceAs (AddCommGroup (FreeAddCommGroup (Pair A) ⧸ AddSubgroup.closure (relations A)))

variable {A}

/-- The class of an admissible pair in `D(A)`. -/
private def mk (p : Pair A) : DennisSteinGroup A :=
  QuotientAddGroup.mk (s := AddSubgroup.closure (relations A)) (FreeAddCommGroup.of p)

open scoped Classical in
/-- The **Dennis–Stein symbol** `⟨r, s⟩ ∈ D(A)`. It is the generator attached to `(r, s)` when
`1 - r * s` is a unit, and `0` otherwise. -/
noncomputable def symbol (r s : A) : DennisSteinGroup A :=
  if h : IsUnit (1 - r * s) then mk ⟨r, s, h⟩ else 0

private theorem mk_eq_symbol (p : Pair A) : mk p = symbol p.fst p.snd := by
  simp [symbol, p.isUnit_one_sub_mul]

private theorem mk_eq_symbol' {r s : A} (h : IsUnit (1 - r * s)) :
    mk ⟨r, s, h⟩ = symbol r s :=
  mk_eq_symbol _

/-- A non-admissible pair has symbol `0`. -/
theorem symbol_eq_zero_of_not_isUnit {r s : A} (h : ¬IsUnit (1 - r * s)) :
    symbol r s = 0 := by
  simp [symbol, h]

private theorem mk_eq_zero_of_mem {x : FreeAddCommGroup (Pair A)} (hx : x ∈ relations A) :
    (QuotientAddGroup.mk (s := AddSubgroup.closure (relations A)) x : DennisSteinGroup A) = 0 :=
  (QuotientAddGroup.eq_zero_iff x).2 (AddSubgroup.subset_closure hx)

/-- **D1**: `⟨r, s⟩ + ⟨s, r⟩ = 0`. No hypothesis is needed, since `(r, s)` is admissible exactly
when `(s, r)` is. -/
theorem symbol_add_symbol_swap (r s : A) : symbol r s + symbol s r = 0 := by
  by_cases h : IsUnit (1 - r * s)
  · have h' : IsUnit (1 - s * r) := by rwa [mul_comm]
    rw [← mk_eq_symbol' h, ← mk_eq_symbol' h']
    exact mk_eq_zero_of_mem (Or.inl ⟨r, s, h, h', rfl⟩)
  · have h' : ¬IsUnit (1 - s * r) := by rwa [mul_comm]
    rw [symbol_eq_zero_of_not_isUnit h, symbol_eq_zero_of_not_isUnit h', add_zero]

/-- D1 in the form `⟨s, r⟩ = -⟨r, s⟩`. -/
theorem symbol_swap (r s : A) : symbol s r = -symbol r s :=
  eq_neg_of_add_eq_zero_right (symbol_add_symbol_swap r s)

/-- The identity behind D2: `1 - r * (s + t - r * s * t) = (1 - r * s) * (1 - r * t)`. -/
private theorem one_sub_mul_add_sub (r s t : A) :
    1 - r * (s + t - r * s * t) = (1 - r * s) * (1 - r * t) := by
  ring

/-- **D2**: `⟨r, s⟩ + ⟨r, t⟩ = ⟨r, s + t - r * s * t⟩` when `(r, s)` and `(r, t)` are admissible. -/
theorem symbol_add_symbol {r s t : A} (hs : IsUnit (1 - r * s)) (ht : IsUnit (1 - r * t)) :
    symbol r s + symbol r t = symbol r (s + t - r * s * t) := by
  have h : IsUnit (1 - r * (s + t - r * s * t)) := by
    rw [one_sub_mul_add_sub]
    exact hs.mul ht
  rw [← mk_eq_symbol' hs, ← mk_eq_symbol' ht, ← mk_eq_symbol' h, ← sub_eq_zero]
  exact mk_eq_zero_of_mem (Or.inr (Or.inl ⟨r, s, t, hs, ht, h, rfl⟩))

/-- **D3**: `⟨r, s * t⟩ = ⟨r * s, t⟩ + ⟨r * t, s⟩`. No hypothesis is needed, since the three
pairs are admissible together. -/
theorem symbol_mul_right (r s t : A) :
    symbol r (s * t) = symbol (r * s) t + symbol (r * t) s := by
  have h₁ : r * s * t = r * (s * t) := mul_assoc r s t
  have h₂ : r * t * s = r * (s * t) := by ring
  by_cases h : IsUnit (1 - r * (s * t))
  · have hu₁ : IsUnit (1 - r * s * t) := by rwa [h₁]
    have hu₂ : IsUnit (1 - r * t * s) := by rwa [h₂]
    rw [← mk_eq_symbol' h, ← mk_eq_symbol' hu₁, ← mk_eq_symbol' hu₂, ← sub_eq_zero, ← sub_sub]
    exact mk_eq_zero_of_mem (Or.inr (Or.inr ⟨r, s, t, h, hu₁, hu₂, rfl⟩))
  · have hu₁ : ¬IsUnit (1 - r * s * t) := by rwa [h₁]
    have hu₂ : ¬IsUnit (1 - r * t * s) := by rwa [h₂]
    rw [symbol_eq_zero_of_not_isUnit h, symbol_eq_zero_of_not_isUnit hu₁,
      symbol_eq_zero_of_not_isUnit hu₂, add_zero]

/-- `⟨r, 0⟩ = 0`, by D2 with `s = t = 0`. -/
@[simp]
theorem symbol_zero_right (r : A) : symbol r (0 : A) = 0 := by
  have h : IsUnit (1 - r * 0) := by simp
  have := symbol_add_symbol h h
  simpa using this

/-- `⟨0, s⟩ = 0`, by D1 and `⟨s, 0⟩ = 0`. -/
@[simp]
theorem symbol_zero_left (s : A) : symbol (0 : A) s = 0 := by
  rw [symbol_swap, symbol_zero_right, neg_zero]

/-- `⟨r, 1⟩ = 0`, by D3 with `s = t = 1`. -/
@[simp]
theorem symbol_one_right (r : A) : symbol r (1 : A) = 0 := by
  have := symbol_mul_right r (1 : A) 1
  simpa using this

/-- `⟨1, s⟩ = 0`, by D1 and `⟨s, 1⟩ = 0`. -/
@[simp]
theorem symbol_one_left (s : A) : symbol (1 : A) s = 0 := by
  rw [symbol_swap, symbol_one_right, neg_zero]

/-- **Induction principle**: a predicate on `D(A)` that holds for `0` and for every admissible
symbol, and is preserved by addition and negation, holds everywhere. -/
@[elab_as_elim]
theorem induction_on {P : DennisSteinGroup A → Prop} (x : DennisSteinGroup A) (zero : P 0)
    (symbol : ∀ r s, IsUnit (1 - r * s) → P (symbol r s))
    (add : ∀ x y, P x → P y → P (x + y)) (neg : ∀ x, P x → P (-x)) : P x := by
  induction x using QuotientAddGroup.induction_on with | H z => ?_
  induction z using FreeAddCommGroup.induction_on with
  | zero => exact zero
  | of p =>
    -- The class of the generator `FreeAddCommGroup.of p` is `mk p` by definition.
    change P (mk p)
    rw [mk_eq_symbol]
    exact symbol _ _ p.isUnit_one_sub_mul
  | neg p hp =>
    rw [QuotientAddGroup.mk_neg]
    exact neg _ hp
  | add x y hx hy =>
    rw [QuotientAddGroup.mk_add]
    exact add _ _ hx hy

/-- Additive maps out of `D(A)` agreeing on every admissible symbol are equal. -/
@[ext]
theorem hom_ext {G : Type*} [AddGroup G] {f g : DennisSteinGroup A →+ G}
    (h : ∀ r s, IsUnit (1 - r * s) → f (symbol r s) = g (symbol r s)) : f = g := by
  ext x
  induction x using induction_on with
  | zero => simp
  | symbol r s hrs => exact h r s hrs
  | add x y hx hy => simp [hx, hy]
  | neg x hx => simp [hx]

section lift

variable {G : Type*} [AddCommGroup G] (f : A → A → G)
  (h₁ : ∀ r s, IsUnit (1 - r * s) → f r s + f s r = 0)
  (h₂ : ∀ r s t, IsUnit (1 - r * s) → IsUnit (1 - r * t) →
    f r s + f r t = f r (s + t - r * s * t))
  (h₃ : ∀ r s t, IsUnit (1 - r * (s * t)) → f r (s * t) = f (r * s) t + f (r * t) s)

/-- **Universal property of `D(A)`**: a function on pairs satisfying D1–D3 on admissible pairs
induces an additive map `D(A) →+ G` sending each admissible symbol `⟨r, s⟩` to `f r s`. Its values
on non-admissible pairs play no role. -/
noncomputable def lift : DennisSteinGroup A →+ G :=
  QuotientAddGroup.lift (AddSubgroup.closure (relations A))
    (FreeAddCommGroup.lift fun p : Pair A => f p.fst p.snd) <| by
      rw [AddSubgroup.closure_le]
      rintro x (⟨r, s, h, h', rfl⟩ | ⟨r, s, t, hs, ht, h, rfl⟩ | ⟨r, s, t, h, -, -, rfl⟩) <;>
        simp only [SetLike.mem_coe, AddMonoidHom.mem_ker, map_add, map_sub,
          FreeAddCommGroup.lift_apply_of]
      · exact h₁ r s h
      · rw [h₂ r s t hs ht, sub_self]
      · rw [h₃ r s t h, sub_sub, sub_self]

/-- The value of `TauCeti.DennisSteinGroup.lift` on an admissible symbol. -/
@[simp]
theorem lift_symbol {r s : A} (h : IsUnit (1 - r * s)) :
    lift f h₁ h₂ h₃ (symbol r s) = f r s := by
  rw [← mk_eq_symbol' h]
  exact FreeAddCommGroup.lift_apply_of _ _

end lift

section map

variable {B C : Type*} [CommRing B] [CommRing C]

/-- The map `D(A) →+ D(B)` induced by a ring homomorphism `A →+* B`, sending `⟨r, s⟩` to
`⟨f r, f s⟩` on admissible pairs. -/
noncomputable def map (f : A →+* B) : DennisSteinGroup A →+ DennisSteinGroup B :=
  lift (fun r s => symbol (f r) (f s)) (fun r s _ => symbol_add_symbol_swap _ _)
    (fun r s t hs ht => by
      rw [symbol_add_symbol (by simpa using hs.map f) (by simpa using ht.map f)]
      simp)
    (fun r s t _ => by simpa using symbol_mul_right (f r) (f s) (f t))

/-- `TauCeti.DennisSteinGroup.map` on an admissible symbol. The admissibility hypothesis cannot
be dropped: a pair that is not admissible over `A` can become admissible over `B`. -/
@[simp]
theorem map_symbol (f : A →+* B) {r s : A} (h : IsUnit (1 - r * s)) :
    map f (symbol r s) = symbol (f r) (f s) :=
  lift_symbol _ _ _ _ h

variable (A) in
/-- The identity ring homomorphism induces the identity of `D(A)`. -/
@[simp]
theorem map_id : map (RingHom.id A) = AddMonoidHom.id (DennisSteinGroup A) := by
  ext r s h
  simp [h]

/-- `TauCeti.DennisSteinGroup.map` respects composition of ring homomorphisms. -/
theorem map_comp (g : B →+* C) (f : A →+* B) : map (g.comp f) = (map g).comp (map f) := by
  ext r s h
  have h' : IsUnit (1 - f r * f s) := by simpa using h.map f
  simp [h, h']

/-- `TauCeti.DennisSteinGroup.map` respects composition, elementwise. -/
theorem map_map (g : B →+* C) (f : A →+* B) (x : DennisSteinGroup A) :
    map g (map f x) = map (g.comp f) x := by
  rw [map_comp, AddMonoidHom.comp_apply]

end map

end DennisSteinGroup

end TauCeti
