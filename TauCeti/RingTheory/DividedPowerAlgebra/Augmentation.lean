/-!
# The augmentation of a divided power algebra

For a module `M` over a commutative semiring `R`, the divided power algebra `Γ_R(M)` carries a
canonical `R`-algebra map `ε : Γ_R(M) → R`, the *augmentation*, sending `dp R 0 m` to `1` and
every `dp R n m` with `n > 0` to `0`. It is the lift of the zero linear map `M → R` into the zero
ideal of `R`, equipped with its canonical divided powers. Its kernel is the augmentation ideal
`Γ_R(M)₊`, the ideal on which the divided powers of `Γ_R(M)` live; it is the input to divided
power envelopes and crystalline constructions.

Over a commutative semiring, `Γ_R(M)₊` is the ideal generated by the positive divided powers
`dp R n m`, `n > 0`. The degree-one generators `dp R 1 m` do not suffice in general: over
`ZMod 2`, an ordinary algebra map to the dual numbers detects `dp 2 1` and kills every `dp 1 m`.

Over a commutative ring, `Γ_R(M)` splits as `R × Γ_R(M)₊`, and for every ideal `I` of `R` the
extended ideal `IΓ` meets `Γ_R(M)₊` exactly in `IΓ · Γ_R(M)₊`. These are instances of the general
facts about the kernel of an augmentation `A →ₐ[R] R` in `TauCeti.RingTheory.Ideal.IsAugmentation`,
stated here for the augmentation ideal.

No freeness, finiteness or characteristic hypothesis is imposed on `M`.

## Main declarations

* `DividedPowerAlgebra.augmentation`: the augmentation `Γ_R(M) →ₐ[R] R`.
* `DividedPowerAlgebra.augmentation_dp`: its value on the generators `dp R n m`.
* `DividedPowerAlgebra.augmentation_map`: compatibility with `DividedPowerAlgebra.map`.
* `DividedPowerAlgebra.augmentation_unique`: an algebra map to `R` killing the positive
  generators is the augmentation.
* `DividedPowerAlgebra.augmentationIdeal`: the augmentation ideal `Γ_R(M)₊`.
* `DividedPowerAlgebra.augmentationIdeal_eq_span`: `Γ_R(M)₊` is generated by the `dp R n m` with
  `n ≠ 0`.
* `DividedPowerAlgebra.augmentationSplitting`: the `R`-linear splitting `Γ_R(M) ≃ R × Γ_R(M)₊`.
* `DividedPowerAlgebra.map_algebraMap_inf_augmentationIdeal_eq_mul`: `IΓ ∩ Γ_R(M)₊ = IΓ · Γ_R(M)₊`
  for every ideal `I` of `R`.
* `DividedPowerAlgebra.dp_two_not_mem_span_dp_one`: in `Γ_{𝔽₂}(𝔽₂)`, `dp 2 1` is not in the ideal
  generated by the degree-one elements.

## References

* Mathlib's `DividedPowerAlgebra` and `dividedPowersBot`, from the divided powers formalization of
  A. Chambert-Loir and M. I. de Frutos-Fernández; the augmentation is their `lift` along the zero
  map.
* N. Roby, *Lois polynomes et lois formelles en théorie des modules*, Ann. Sci. ÉNS 80 (1963),
  III §§1–2.
* [Stacks: Divided power algebra, Tag 07H4](https://stacks.math.columbia.edu/tag/07H4) and
  [Lemma 07H5](https://stacks.math.columbia.edu/tag/07H5).
-/

public section

noncomputable section

namespace DividedPowerAlgebra

section CommSemiring

variable (R M : Type*) [CommSemiring R] [AddCommMonoid M] [Module R M]

/-- The augmentation `Γ_R(M) →ₐ[R] R` of the divided power algebra, sending `dp R 0 m` to `1` and
`dp R n m` to `0` for `n ≠ 0`. It is the lift of the zero map `M → R` into the zero ideal of `R`
with its canonical divided powers. -/
def augmentation : DividedPowerAlgebra R M →ₐ[R] R :=
  lift (dividedPowersBot R) (0 : M →ₗ[R] R) fun _ ↦ Ideal.zero_mem _

theorem augmentation_eq_lift :
    augmentation R M =
      lift (dividedPowersBot R) (0 : M →ₗ[R] R) fun _ ↦ Ideal.zero_mem _ :=
  (rfl)

variable {R M}

/-- The augmentation is `1` on `dp R 0 m` and `0` on every `dp R n m` with `n ≠ 0`. -/
@[simp]
theorem augmentation_dp (n : ℕ) (m : M) :
    augmentation R M (dp R n m) = if n = 0 then 1 else 0 := by
  classical
  simp [augmentation_eq_lift, dividedPowersBot_dpow_eq]

theorem augmentation_dp_of_ne_zero {n : ℕ} (hn : n ≠ 0) (m : M) :
    augmentation R M (dp R n m) = 0 := by
  simp [hn]

/-- The augmentation is surjective, being a retraction of `algebraMap R (Γ_R(M))`. -/
theorem augmentation_surjective : Function.Surjective (augmentation R M) :=
  fun r ↦ ⟨algebraMap R _ r, AlgHom.commutes _ r⟩

/-- An `R`-algebra map `Γ_R(M) → R` killing every `dp R n m` with `n ≠ 0` is the augmentation. -/
theorem augmentation_unique {f : DividedPowerAlgebra R M →ₐ[R] R}
    (hf : ∀ n m, n ≠ 0 → f (dp R n m) = 0) : f = augmentation R M :=
  algHom_ext fun n m ↦ by
    rcases eq_or_ne n 0 with rfl | hn
    · simp [dp_zero]
    · rw [hf n m hn, augmentation_dp_of_ne_zero hn]

section Map

variable {S : Type*} [CommSemiring S] [Algebra R S] {N : Type*} [AddCommMonoid N] [Module R N]
  [Module S N] [IsScalarTower R S N] (f : M →ₗ[R] N)

/-- The augmentation is natural: `ε_S ∘ Γ(f) = algebraMap R S ∘ ε_R`. -/
theorem augmentation_comp_map :
    ((augmentation S N).restrictScalars R).comp (map S f) =
      (Algebra.ofId R S).comp (augmentation R M) :=
  algHom_ext fun n m ↦ by
    simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply, map_apply_dp, augmentation_dp,
      Algebra.ofId_apply]
    split_ifs <;> simp

/-- Elementwise naturality of the augmentation along `DividedPowerAlgebra.map`. -/
@[simp]
theorem augmentation_map (z : DividedPowerAlgebra R M) :
    augmentation S N (map S f z) = algebraMap R S (augmentation R M z) :=
  AlgHom.congr_fun (augmentation_comp_map f) z

end Map

variable (R M) in
/-- The augmentation ideal `Γ_R(M)₊` of the divided power algebra, the kernel of the
augmentation. -/
def augmentationIdeal : Ideal (DividedPowerAlgebra R M) :=
  RingHom.ker (augmentation R M)

variable (R M) in
theorem augmentationIdeal_eq_ker : augmentationIdeal R M = RingHom.ker (augmentation R M) :=
  (rfl)

@[simp]
theorem mem_augmentationIdeal {z : DividedPowerAlgebra R M} :
    z ∈ augmentationIdeal R M ↔ augmentation R M z = 0 := by
  rw [augmentationIdeal_eq_ker, RingHom.mem_ker]

theorem dp_mem_augmentationIdeal {n : ℕ} (hn : n ≠ 0) (m : M) :
    dp R n m ∈ augmentationIdeal R M := by
  simp [hn]

/-- A scalar lies in the augmentation ideal exactly when it is zero. -/
theorem algebraMap_mem_augmentationIdeal_iff {r : R} :
    algebraMap R (DividedPowerAlgebra R M) r ∈ augmentationIdeal R M ↔ r = 0 := by
  simp

/-- Over a nontrivial ring the augmentation ideal is proper. -/
theorem augmentationIdeal_ne_top [Nontrivial R] : augmentationIdeal R M ≠ ⊤ :=
  RingHom.ker_ne_top _

/-- The map `Γ(f)` carries the augmentation ideal into the augmentation ideal. -/
theorem map_mem_augmentationIdeal {S : Type*} [CommSemiring S] [Algebra R S] {N : Type*}
    [AddCommMonoid N] [Module R N] [Module S N] [IsScalarTower R S N] (f : M →ₗ[R] N)
    {z : DividedPowerAlgebra R M} (hz : z ∈ augmentationIdeal R M) :
    map S f z ∈ augmentationIdeal S N := by
  simp_all

/-- The augmentation ideal is generated by the positive divided powers `dp R n m`, `n ≠ 0`. -/
theorem augmentationIdeal_eq_span :
    augmentationIdeal R M = Ideal.span {x | ∃ n m, n ≠ 0 ∧ dp R n m = x} := by
  let I : Ideal (DividedPowerAlgebra R M) :=
    Ideal.span {x | ∃ n m, n ≠ 0 ∧ dp R n m = x}
  have decompose (z : DividedPowerAlgebra R M) :
      ∃ w ∈ I, z = algebraMap R _ (augmentation R M z) + w := by
    induction z using DividedPowerAlgebra.induction_on with
    | C r => exact ⟨0, I.zero_mem, by simp⟩
    | add z w hz hw =>
      obtain ⟨z', hz', hzeq⟩ := hz
      obtain ⟨w', hw', hweq⟩ := hw
      refine ⟨z' + w', I.add_mem hz' hw', ?_⟩
      rw [map_add, map_add]
      calc
        z + w = (algebraMap R _ (augmentation R M z) + z') +
            (algebraMap R _ (augmentation R M w) + w') := congrArg₂ (· + ·) hzeq hweq
        _ = (algebraMap R _ (augmentation R M z) + algebraMap R _ (augmentation R M w)) +
            (z' + w') := by ac_rfl
    | dp z n m hz =>
      rcases eq_or_ne n 0 with rfl | hn
      · simpa [dp_zero] using hz
      · refine ⟨z * dp R n m, ?_, ?_⟩
        · exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨n, m, hn, rfl⟩)
        · rw [map_mul, augmentation_dp_of_ne_zero hn, mul_zero, map_zero, zero_add]
  refine le_antisymm (fun z hz ↦ ?_) (Ideal.span_le.mpr ?_)
  · obtain ⟨w, hw, hzw⟩ := decompose z
    have : z = w := by simpa [(mem_augmentationIdeal).mp hz] using hzw
    rwa [this]
  · rintro _ ⟨n, m, hn, rfl⟩
    exact dp_mem_augmentationIdeal hn m

end CommSemiring

section CommRing

variable {R M : Type*} [CommRing R] [AddCommMonoid M] [Module R M]

/-- Every element differs from the scalar given by its augmentation by an element of the ideal
generated by the positive divided powers `dp R n m`, `n ≠ 0`. -/
theorem sub_algebraMap_augmentation_mem_span (z : DividedPowerAlgebra R M) :
    z - algebraMap R _ (augmentation R M z) ∈
      Ideal.span {x | ∃ n m, n ≠ 0 ∧ dp R n m = x} := by
  rw [← augmentationIdeal_eq_span]
  simp

variable (R M) in
/-- The splitting of `Γ_R(M)` into scalars and the augmentation ideal, as `R`-modules:
`z ↦ (ε z, z - algebraMap R _ (ε z))`, with inverse `(r, u) ↦ algebraMap R _ r + u`. -/
noncomputable def augmentationSplitting :
    DividedPowerAlgebra R M ≃ₗ[R] R × augmentationIdeal R M :=
  (augmentation R M).equivProdKer

@[simp]
theorem augmentationSplitting_apply_fst (z : DividedPowerAlgebra R M) :
    (augmentationSplitting R M z).1 = augmentation R M z :=
  (augmentation R M).equivProdKer_apply_fst z

@[simp]
theorem coe_augmentationSplitting_apply_snd (z : DividedPowerAlgebra R M) :
    ((augmentationSplitting R M z).2 : DividedPowerAlgebra R M) =
      z - algebraMap R _ (augmentation R M z) :=
  (augmentation R M).coe_equivProdKer_apply_snd z

@[simp]
theorem augmentationSplitting_symm_apply (p : R × augmentationIdeal R M) :
    (augmentationSplitting R M).symm p = algebraMap R _ p.1 + p.2 :=
  (augmentation R M).equivProdKer_symm_apply p

/-- For an ideal `I` of `R`, the remainder `z - algebraMap R _ (ε z)` of an element `z` of the
extended ideal `IΓ` lies in `IΓ · Γ_R(M)₊`. -/
theorem sub_algebraMap_augmentation_mem_map_mul {I : Ideal R} {z : DividedPowerAlgebra R M}
    (hz : z ∈ I.map (algebraMap R _)) :
    z - algebraMap R _ (augmentation R M z) ∈ I.map (algebraMap R _) * augmentationIdeal R M :=
  (augmentation R M).sub_algebraMap_apply_mem_map_mul_ker hz

/-- For an ideal `I` of `R`, the extended ideal `IΓ` meets the augmentation ideal exactly in
`IΓ · Γ_R(M)₊`. -/
theorem map_algebraMap_inf_augmentationIdeal_eq_mul (I : Ideal R) :
    I.map (algebraMap R (DividedPowerAlgebra R M)) ⊓ augmentationIdeal R M =
      I.map (algebraMap R _) * augmentationIdeal R M :=
  (augmentation R M).map_algebraMap_inf_ker_eq_mul I

end CommRing

section CharTwo

open TrivSqZeroExt

/-- The values of the degree-two detector `Γ_{𝔽₂}(𝔽₂) → 𝔽₂[ε]` on the generators: `1` in degree
zero, `inr a` in degree two and zero otherwise. -/
private def detectorFun (p : ℕ × ZMod 2) : TrivSqZeroExt (ZMod 2) (ZMod 2) :=
  if p.1 = 0 then 1 else if p.1 = 2 then inr p.2 else 0

private theorem detectorFun_mul_eq_zero {k l : ℕ} (h : 3 ≤ k + l) (u v : ZMod 2) :
    detectorFun (k, u) * detectorFun (l, v) = 0 := by
  unfold detectorFun
  split_ifs <;> first | omega | simp [inr_mul_inr]

private theorem detectorFun_smul (n : ℕ) (r m : ZMod 2) :
    detectorFun (n, r • m) = r ^ n • detectorFun (n, m) := by
  have hr : r ^ 2 = r := by fin_cases r <;> rfl
  rcases eq_or_ne n 0 with rfl | h₀
  · simp [detectorFun]
  rcases eq_or_ne n 2 with rfl | h₂
  · simp [detectorFun, hr, -smul_eq_mul, inr_smul]
  · simp [detectorFun, h₀, h₂]

private theorem detectorFun_mul (n p : ℕ) (m : ZMod 2) :
    detectorFun (n, m) * detectorFun (p, m) = (n + p).choose n • detectorFun (n + p, m) := by
  rcases eq_or_ne n 0 with rfl | hn
  · simp [detectorFun]
  rcases eq_or_ne p 0 with rfl | hp
  · simp [detectorFun]
  rcases le_or_gt 3 (n + p) with h | h
  · rw [detectorFun_mul_eq_zero h]
    have hne : n + p ≠ 2 := by omega
    simp [detectorFun, hn, hne]
  · obtain ⟨rfl, rfl⟩ : n = 1 ∧ p = 1 := by omega
    have h2 : (2 : ZMod 2) = 0 := rfl
    simp [detectorFun, ← inr_smul, h2]

private theorem detectorFun_add (n : ℕ) (u v : ZMod 2) :
    detectorFun (n, u + v) =
      (Finset.antidiagonal n).sum fun (k, l) ↦ detectorFun (k, u) * detectorFun (l, v) := by
  match n with
  | 0 => simp [detectorFun]
  | 1 => simp [detectorFun, Finset.Nat.antidiagonal_succ]
  | 2 => simp [detectorFun, Finset.Nat.antidiagonal_succ, inr_add, add_comm]
  | n + 3 =>
    rw [Finset.sum_eq_zero fun kl hkl ↦ detectorFun_mul_eq_zero
      (by rw [Finset.mem_antidiagonal] at hkl; omega) u v]
    simp [detectorFun]

/-- An ordinary `𝔽₂`-algebra map `Γ_{𝔽₂}(𝔽₂) → 𝔽₂[ε]` sending `dp 2 a` to `inr a` and every other
positive divided power to zero. It does not respect divided powers. -/
private def detector :
    DividedPowerAlgebra (ZMod 2) (ZMod 2) →ₐ[ZMod 2] TrivSqZeroExt (ZMod 2) (ZMod 2) :=
  lift' (f := detectorFun) (fun _ ↦ by simp [detectorFun]) detectorFun_smul detectorFun_mul
    detectorFun_add

/-- In characteristic two there is an ordinary algebra map `Γ_{𝔽₂}(𝔽₂) → 𝔽₂[ε]` to the dual
numbers sending `dp 0 a` to `1`, `dp 2 a` to `inr a`, and every other `dp n a` to `0`. -/
theorem exists_algHom_trivSqZeroExt_dp :
    ∃ f : DividedPowerAlgebra (ZMod 2) (ZMod 2) →ₐ[ZMod 2] TrivSqZeroExt (ZMod 2) (ZMod 2),
      ∀ n a, f (dp (ZMod 2) n a) = if n = 0 then 1 else if n = 2 then inr a else 0 :=
  ⟨detector, fun n a ↦ by simp [detector, detectorFun]⟩

/-- The degree-one elements do not generate the augmentation ideal: in `Γ_{𝔽₂}(𝔽₂)`, `dp 2 1` is
not in the ideal generated by the `dp 1 m`. -/
theorem dp_two_not_mem_span_dp_one :
    dp (ZMod 2) 2 (1 : ZMod 2) ∉ Ideal.span (Set.range fun m : ZMod 2 ↦ dp (ZMod 2) 1 m) := by
  obtain ⟨f, hf⟩ := exists_algHom_trivSqZeroExt_dp
  intro h
  have hle : Ideal.span (Set.range fun m : ZMod 2 ↦ dp (ZMod 2) 1 m) ≤ RingHom.ker f :=
    Ideal.span_le.mpr <| by
      rintro _ ⟨m, rfl⟩
      simp [hf]
  have h₂ := (RingHom.mem_ker).mp (hle h)
  rw [hf] at h₂
  simpa using inr_injective (R := ZMod 2) (h₂.trans (inr_zero (R := ZMod 2)).symm)

end CharTwo

end DividedPowerAlgebra
