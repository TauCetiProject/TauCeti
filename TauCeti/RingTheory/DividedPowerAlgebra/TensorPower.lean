module

public import TauCeti.RingTheory.DividedPowerAlgebra.Representability
public import TauCeti.LinearAlgebra.TensorPower.PolynomialLaw
import TauCeti.Data.Finsupp.Multiset

/-!
# The integral comparison from divided powers to tensor powers

`DividedPowerAlgebra.toTensorPower d` represents the diagonal tensor law. It takes `γ_d(m)`
to `m ⊗ ⋯ ⊗ m`, with coefficient one, over any commutative semiring and for any module.
Its defining property is an equality on every scalar extension, not just on ground points:
ground values alone do not characterize a polynomial law in positive characteristic.
Naturality and the mixed-coefficient formula are obtained from Roby representability. Reading off
that coefficient, the image of `∏ⱼ dp R lⱼ mⱼ` is the sum of `m_{w 0} ⊗ ⋯ ⊗ m_{w (d - 1)}` over the
words `w` in which each letter `j` occurs exactly `lⱼ` times
(`DividedPowerAlgebra.toTensorPower_prod_dp_eq_sum_tprod`).

This is the canonical map used in the comparison of divided powers of free modules with
symmetric tensors. This file constructs the map; it does not assert injectivity, surjectivity,
or a description of its image.

## References

* N. Roby, *Lois polynômes et lois formelles en théorie des modules* (1963), Chapter IV,
  Theorems 1 and 2.
* The construction uses `DividedPowerAlgebra.homogeneousLawEquiv` and
  `TensorPower.diagonalLaw`. The underlying divided power algebra and polynomial laws are
  Mathlib's formalizations by Antoine Chambert-Loir and María Inés de Frutos-Fernández.
-/

public noncomputable section

open TensorProduct

universe u

namespace DividedPowerAlgebra

variable {R : Type u} [CommSemiring R] {M N : Type*}
  [AddCommMonoid M] [Module R M] [AddCommMonoid N] [Module R N]

/-- The integral linear comparison taking a divided power to a pure tensor power. It is
characterized by its scalar extensions on the universal degree-`d` law. -/
def toTensorPower (d : ℕ) :
    homogeneousSubmodule (R := R) (M := M) d →ₗ[R] TensorPower R d M :=
  (homogeneousLawEquiv R M (TensorPower R d M) d).symm
    ⟨TensorPower.diagonalLaw R M d, PolynomialLaw.mem_homogeneousSubmodule.mpr
      (TensorPower.isHomogeneousOfDegree_diagonalLaw d)⟩

/-- Composition with the universal law is the diagonal tensor law, on every scalar algebra. -/
@[simp]
theorem toPolynomialLaw_toTensorPower_comp_gamma (d : ℕ) :
    (toTensorPower (R := R) (M := M) d).toPolynomialLaw.comp (gamma R M d) =
      TensorPower.diagonalLaw R M d := by
  have h := congrArg Subtype.val
    ((homogeneousLawEquiv R M (TensorPower R d M) d).apply_symm_apply
      ⟨TensorPower.diagonalLaw R M d, PolynomialLaw.mem_homogeneousSubmodule.mpr
        (TensorPower.isHomogeneousOfDegree_diagonalLaw d)⟩)
  simpa only [homogeneousLawEquiv_apply, coe_homogeneousLawMap_apply, toTensorPower] using h

/-- The scalar extension of the comparison takes the universal divided-power law to the
diagonal tensor law. -/
@[simp]
theorem toTensorPower_baseChange_gamma (d : ℕ) (S : Type*) [CommSemiring S] [Algebra R S]
    (x : S ⊗[R] M) :
    (toTensorPower d).baseChange S ((gamma R M d).toFun S x) =
      (TensorPower.diagonalLaw R M d).toFun S x := by
  have h := congrArg (fun f : M →ₚₗ[R] TensorPower R d M ↦ f.toFun S x)
    (toPolynomialLaw_toTensorPower_comp_gamma (R := R) (M := M) d)
  simpa only [PolynomialLaw.toFun_comp_apply, LinearMap.toPolynomialLaw_toFun] using h

/-- A divided-power generator maps to a pure tensor, with no factorial factor. -/
@[simp]
theorem toTensorPower_dp (d : ℕ) (m : M) :
    toTensorPower d ⟨dp R d m, dp_mem_homogeneousSubmodule d m⟩ =
      PiTensorProduct.tprod R (fun _ : Fin d ↦ m) := by
  simp only [toTensorPower, homogeneousLawEquiv_symm_apply_dp, TensorPower.ground_diagonalLaw]

/-- The comparison is uniquely characterized by its scalar extensions on `γ_d`. -/
theorem toTensorPower_unique (d : ℕ)
    (f : homogeneousSubmodule (R := R) (M := M) d →ₗ[R] TensorPower R d M)
    (h : ∀ (S : Type u) [CommSemiring S] [Algebra R S] (x : S ⊗[R] M),
      f.baseChange S ((gamma R M d).toFun S x) =
        (TensorPower.diagonalLaw R M d).toFun S x) :
    f = toTensorPower d := by
  apply homogeneousLawMap_injective d
  apply Subtype.ext
  rw [coe_homogeneousLawMap_apply, coe_homogeneousLawMap_apply,
    toPolynomialLaw_toTensorPower_comp_gamma]
  ext S _ _ x
  simpa only [PolynomialLaw.comp_toFun', Function.comp_apply,
    LinearMap.toPolynomialLaw_toFun', ← PolynomialLaw.toFun'_eq_toFun] using h S x

/-- The image of a product of divided powers is a mixed coefficient of the diagonal law.
This specifies all spanning generators, including those not generated by pure powers. -/
theorem toTensorPower_prod_dp (d : ℕ) {ι : Type*} [Fintype ι] (m : ι → M)
    (k : ι →₀ ℕ) (hk : ∑ i, k i = d) :
    toTensorPower d
        ⟨∏ i, dp R (k i) (m i), prod_dp_mem_homogeneousSubmodule_of_sum_eq m k hk⟩ =
      TensorProduct.lid R _ ((MvPolynomial.lcoeff R k).rTensor _
        ((TensorAlgebra.tensorPowerProjection d).baseChange (MvPolynomial ι R)
          ((∑ i, MvPolynomial.X i ⊗ₜ[R] TensorAlgebra.ι R (m i)) ^ d))) := by
  rw [toTensorPower, homogeneousLawEquiv_symm_apply_prod_dp d _ m k hk,
    PolynomialLaw.coeff_apply, TensorPower.diagonalLaw_toFun]
  simp only [map_sum, LinearMap.baseChange_tmul]

open MvPolynomial PiTensorProduct in
/-- The product formula for `toTensorPower`: for exponents `l` supported in a finite set `F` of
total degree `d`, the image of `∏_{j ∈ F} dp R lⱼ mⱼ` is the sum of `m_{w 0} ⊗ ⋯ ⊗ m_{w (d - 1)}`
over all words `w : Fin d → ι` in which each letter `j` occurs exactly `lⱼ` times. -/
theorem toTensorPower_prod_dp_eq_sum_tprod (d : ℕ) {ι : Type*} [DecidableEq ι] (F : Finset ι)
    (m : ι → M) (l : ι →₀ ℕ) (hF : l.support ⊆ F) (hl : ∑ j ∈ F, l j = d) :
    toTensorPower d
        ⟨∏ j ∈ F, dp R (l j) (m j), prod_dp_mem_homogeneousSubmodule_of_sum_finset_eq F m l hl⟩ =
      ∑ w ∈ Fintype.piFinset (fun _ : Fin d ↦ F) with ∑ t, Finsupp.single (w t) 1 = l,
        tprod R fun t ↦ m (w t) := by
  classical
  -- pass to the finite index type `F`, where representability computes the value as the
  -- coefficient of `∏ⱼ Xⱼ ^ lⱼ` in `(∑_{j ∈ F} Xⱼ ⊗ mⱼ) ^ ⊗d`
  set k : F →₀ ℕ := l.subtypeDomain (· ∈ F)
  have hk : ∑ j, k j = d := by
    simpa only [k, Finsupp.subtypeDomain_apply] using (Finset.sum_coe_sort F l).trans hl
  have hprod : (⟨∏ j ∈ F, dp R (l j) (m j),
      prod_dp_mem_homogeneousSubmodule_of_sum_finset_eq F m l hl⟩ :
        homogeneousSubmodule (R := R) (M := M) d) =
      ⟨∏ j, dp R (k j) (m j), prod_dp_mem_homogeneousSubmodule_of_sum_eq _ k hk⟩ :=
    Subtype.ext (Finset.prod_coe_sort F fun j ↦ dp R (l j) (m j)).symm
  have hX (w : Fin d → F) : ∏ t, (X (w t) : MvPolynomial F R) =
      monomial (∑ t, Finsupp.single (w t) 1) 1 := by
    -- `X n` is by definition the monomial `monomial (single n 1) 1`
    rw [monomial_sum_one]
    simp only [X]
  have hlaw := TensorPower.diagonalLaw_toFun_sum_tmul (R := R) d (MvPolynomial F R) Finset.univ X
    fun j : F ↦ m j
  simp only [TensorPower.diagonalLaw_toFun, map_sum, LinearMap.baseChange_tmul] at hlaw
  rw [hprod, toTensorPower_prod_dp d _ k hk, hlaw]
  simp only [map_sum, LinearMap.rTensor_tmul, TensorProduct.lid_tmul, hX, lcoeff_apply,
    coeff_monomial, ite_smul, one_smul, zero_smul, Finset.sum_ite, Finset.sum_const_zero,
    add_zero]
  -- a word in `F` is a word in `ι` with letters in `F`, with the same letter counts
  have hcount (w : Fin d → F) :
      ∑ t, Finsupp.single (w t) 1 = k ↔ ∑ t, Finsupp.single (w t : ι) 1 = l := by
    refine ⟨fun h ↦ Finsupp.ext fun j ↦ ?_, fun h ↦ Finsupp.ext fun j ↦ ?_⟩
    · by_cases hj : j ∈ F
      · have h' := DFunLike.congr_fun h ⟨j, hj⟩
        simp only [Finsupp.sum_single_one_apply, k, Finsupp.subtypeDomain_apply,
          Subtype.ext_iff] at h'
        rw [Finsupp.sum_single_one_apply, h']
      · -- letters outside `F` occur neither in the word nor in `l`
        rw [Finsupp.notMem_support_iff.mp fun h' ↦ hj (hF h')]
        by_contra h'
        obtain ⟨t, rfl⟩ := Finsupp.sum_single_one_apply_ne_zero_iff.mp h'
        exact hj (w t).2
    · simp only [k, Finsupp.subtypeDomain_apply, ← h, Finsupp.sum_single_one_apply, Subtype.ext_iff]
  refine Finset.sum_bij (fun w _ t ↦ w t) (fun w hw ↦ ?_) (fun v _ w _ h ↦ ?_) (fun w hw ↦ ?_)
    fun _ _ ↦ rfl
  · rw [Finset.mem_filter] at hw ⊢
    exact ⟨Fintype.mem_piFinset.mpr fun t ↦ (w t).2, (hcount w).mp hw.2⟩
  · exact funext fun t ↦ Subtype.ext (congrFun h t)
  · rw [Finset.mem_filter, Fintype.mem_piFinset] at hw
    exact ⟨fun t ↦ ⟨w t, hw.1 t⟩, Finset.mem_filter.mpr ⟨Fintype.mem_piFinset.mpr fun _ ↦
      Finset.mem_univ _, (hcount _).mpr hw.2⟩, rfl⟩

/-- The integral comparison commutes with every linear map of modules. -/
theorem toTensorPower_comp_mapHomogeneousSubmodule (d : ℕ) (f : M →ₗ[R] N) :
    toTensorPower d ∘ₗ mapHomogeneousSubmodule f d =
      (PiTensorProduct.map fun _ : Fin d ↦ f) ∘ₗ toTensorPower d := by
  exact (homogeneousLawEquiv_symm_comp_mapHomogeneousSubmodule_eq_iff d f
    (PiTensorProduct.map fun _ : Fin d ↦ f) _ _).mpr
      (TensorPower.diagonalLaw_comp_toPolynomialLaw d f)

end DividedPowerAlgebra
