module

public import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
public import Mathlib.RingTheory.Henselian
public import TauCeti.RingTheory.KrullSchmidt.Noetherian
import TauCeti.RingTheory.Henselian.Integral

/-!
# Krull-Schmidt cancellation over a Henselian local ring

Let `R` be a Henselian local ring, such as a complete Noetherian local ring, and `A` an `R`-algebra,
for instance the group algebra `ℤ_p[G]` of a finite group over the `p`-adic integers. For modules
that are finitely generated over `R`, the input of the Krull-Schmidt theorem is available even
though such modules need not have finite length: the endomorphism ring of an indecomposable one is
local. Consequently these modules cancel from direct sums when `R` is moreover Noetherian.

For an `A`-module `M` finite over `R`, the endomorphism ring `End_A(M)` embeds in `End_R(M)`,
which is integral over `R` by Cayley-Hamilton. Thus `End_A(M)` is an integral `R`-algebra.
Indecomposability of `M` leaves it only the trivial idempotents, so it is local by
`TauCeti.isLocalRing_of_isIntegral_of_forall_isIdempotentElem`. That theorem internally reduces
to the commutative subalgebras `R[s]` generated by individual elements.

The Henselian hypothesis is stated as `HenselianRing R (maximalIdeal R)`, which holds both for a
ring with Mathlib's `HenselianLocalRing` and for a local ring complete along its maximal ideal.

⚠ The Henselian hypothesis is essential: over `ℤ` the analogous cancellation fails for integral
group rings (Swan's stably free non-free modules over generalized quaternion groups).

## Main results

* `TauCeti.isLocalRing_end_of_isIndecomposable_of_henselianRing`: an indecomposable `A`-module
  that is finite over a Henselian local ring `R` has a local endomorphism ring.
* `TauCeti.nonempty_linearEquiv_of_prod_linearEquiv_of_henselianRing`: **Krull-Schmidt
  cancellation** for a summand that is finite over a Henselian Noetherian local ring.

## References

* C. W. Curtis, I. Reiner, *Methods of Representation Theory, Vol. I*, §6.
* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, second edition,
  Proposition (5.6.10)(i).
-/

public section

open IsLocalRing

namespace TauCeti

variable (R : Type*) [CommRing R] [IsLocalRing R] [HenselianRing R (maximalIdeal R)]
  {A : Type*} [Ring A] [Algebra R A]

include R in
/-- **Indecomposable modules over a Henselian local ring have local endomorphism rings.** Let `R`
be a Henselian local ring and `A` an `R`-algebra. The endomorphism ring of an indecomposable
`A`-module that is finitely generated over `R` is local. No Noetherian hypothesis is needed. -/
theorem isLocalRing_end_of_isIndecomposable_of_henselianRing {M : Type*} [AddCommGroup M]
    [Module A M] [Module R M] [IsScalarTower R A M] [Module.Finite R M]
    (hM : IsIndecomposableModule A M) : IsLocalRing (Module.End A M) := by
  have := hM.nontrivial
  let ρ : Module.End A M →ₐ[R] Module.End R M :=
    { toFun g := g.restrictScalars R
      map_one' := rfl
      map_mul' _ _ := rfl
      map_zero' := rfl
      map_add' _ _ := rfl
      commutes' _ := rfl }
  have : Algebra.IsIntegral R (Module.End A M) :=
    .of_injective ρ fun _ _ h ↦ LinearMap.restrictScalars_injective R h
  exact isLocalRing_of_isIntegral_of_forall_isIdempotentElem R (Module.End A M) fun _ hf ↦
    hM.eq_zero_or_eq_one_of_isIdempotentElem hf

include R in
/-- **Krull-Schmidt cancellation over a Henselian local ring.** Let `R` be a Henselian Noetherian
local ring and `A` an `R`-algebra. If `P` is an `A`-module that is finitely generated over `R`, a
linear equivalence `M × P ≃ N × P` of `A`-modules induces a linear equivalence `M ≃ N`. No
hypothesis is placed on `M` and `N`. -/
theorem nonempty_linearEquiv_of_prod_linearEquiv_of_henselianRing [IsNoetherianRing R]
    {M N P : Type*} [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    [AddCommGroup P] [Module A P] [Module R P] [IsScalarTower R A P] [Module.Finite R P]
    (h : Nonempty ((M × P) ≃ₗ[A] (N × P))) : Nonempty (M ≃ₗ[A] N) := by
  have : IsNoetherian A P := isNoetherian_of_tower R inferInstance
  refine nonempty_linearEquiv_of_prod_linearEquiv_of_isNoetherian (fun Q _ _ hQ ↦ ?_) h
  have : Module.Finite R Q :=
    .of_injective (Q.subtype.restrictScalars R) Subtype.val_injective
  exact isLocalRing_end_of_isIndecomposable_of_henselianRing R hQ

end TauCeti
