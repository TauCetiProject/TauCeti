/-!
# Matsumoto's presentation of `K₂` and the universal degree-two symbol group

For a commutative semiring `R`, the **Matsumoto group** (universal degree-two symbol group)
`TauCeti.MatsumotoGroup R` is the tensor square `Additive Rˣ ⊗[ℤ] Additive Rˣ` of the unit
group, written additively, modulo `TauCeti.MatsumotoGroup.steinbergRelations R`, the submodule
generated by the tensors `x ⊗ y` with `x + y = 1`. The class of `x ⊗ y` is the
**Steinberg symbol** `{x, y}`. For a field `F`, Matsumoto's theorem identifies it with `K₂(F)`.

This file develops the commutative-semiring presentation:

* bilinearity and the Steinberg relation `{x, y} = 0` for `x + y = 1`, packaged as
  `TauCeti.MatsumotoGroup.isSteinbergPairing_symbol`;
* universal properties for biadditive Steinberg pairings (`TauCeti.MatsumotoGroup.lift`,
  `TauCeti.MatsumotoGroup.liftPairing`, `TauCeti.MatsumotoGroup.liftEquiv`);
* functoriality under ring homomorphisms (`TauCeti.MatsumotoGroup.map`).

Field-specific identities and finite-field vanishing live in
`TauCeti.FieldTheory.MatsumotoGroup.Basic`.

## Main definitions

* `TauCeti.MatsumotoGroup.steinbergRelations R`: the submodule spanned by `x ⊗ y` with
  `x + y = 1`.
* `TauCeti.MatsumotoGroup R`: the quotient of `Additive Rˣ ⊗[ℤ] Additive Rˣ` by
  `steinbergRelations R`.
* `TauCeti.MatsumotoGroup.symbol x y`: the Steinberg symbol `{x, y}`, the class of `x ⊗ y`.
* `TauCeti.MatsumotoGroup.lift`, `TauCeti.MatsumotoGroup.liftPairing`,
  `TauCeti.MatsumotoGroup.liftEquiv`: universal property of `MatsumotoGroup R`.
* `TauCeti.MatsumotoGroup.map`: functorial `ℤ`-linear map induced by a ring homomorphism.

## Main results

* `TauCeti.MatsumotoGroup.symbol_of_add_eq_one`: `{x, y} = 0` when `x + y = 1`.
* `TauCeti.MatsumotoGroup.isSteinbergPairing_symbol`: `symbol` is a Steinberg pairing.
* `TauCeti.MatsumotoGroup.induction_on`: the group is generated by the symbols.
* `TauCeti.MatsumotoGroup.hom_ext`, `TauCeti.MatsumotoGroup.linearMap_ext`: homomorphisms out of
  the group agree when they agree on symbols.
* `TauCeti.MatsumotoGroup.two_nsmul_symbol_neg_one`: `{x, -1}` has order dividing two over any
  commutative ring.

## References

* H. Matsumoto, *Sur les sous-groupes arithmétiques des groupes semi-simples déployés*,
  Ann. Sci. École Norm. Sup. (4) 2 (1969).
* J. Milnor, *Introduction to Algebraic K-Theory*, §§9 and 11.
* C. Weibel, *The K-book*, Chapter III, Theorem 6.1.
-/

public section

open TensorProduct

namespace TauCeti

section Defs

variable (R : Type*) [CommSemiring R]

/-- The `ℤ`-submodule of `Additive Rˣ ⊗[ℤ] Additive Rˣ` spanned by the Steinberg relations
`Additive.ofMul x ⊗ₜ Additive.ofMul y` with `(x : R) + y = 1`. -/
def MatsumotoGroup.steinbergRelations :
    Submodule ℤ (Additive Rˣ ⊗[ℤ] Additive Rˣ) :=
  Submodule.span ℤ
    {t | ∃ x y : Rˣ, (x : R) + y = 1 ∧
      t = TensorProduct.tmul ℤ (Additive.ofMul x) (Additive.ofMul y)}

/-- Definitional unfolding of `MatsumotoGroup.steinbergRelations`. -/
theorem MatsumotoGroup.steinbergRelations_def :
    MatsumotoGroup.steinbergRelations R = Submodule.span ℤ
      {t | ∃ x y : Rˣ, (x : R) + y = 1 ∧
        t = TensorProduct.tmul ℤ (Additive.ofMul x) (Additive.ofMul y)} :=
  (rfl)

/-- The group of Matsumoto's presentation of a commutative semiring `R`: the tensor square
`Additive Rˣ ⊗[ℤ] Additive Rˣ`, written additively, modulo the subgroup generated by the `x ⊗ y`
with `x + y = 1`. -/
abbrev MatsumotoGroup :=
  TensorProduct ℤ (Additive Rˣ) (Additive Rˣ) ⧸ MatsumotoGroup.steinbergRelations R

end Defs

namespace MatsumotoGroup

section CommSemiring

variable {R : Type*} [CommSemiring R]

/-- The Steinberg symbol `{x, y}` in the Matsumoto group: the class of `x ⊗ y`. -/
def symbol (x y : Rˣ) : MatsumotoGroup R :=
  Submodule.Quotient.mk (Additive.ofMul x ⊗ₜ[ℤ] Additive.ofMul y)

/-- The class of a pure tensor of units is their Steinberg symbol. -/
@[simp]
theorem mk_tmul (x y : Rˣ) :
    (Submodule.Quotient.mk (Additive.ofMul x ⊗ₜ[ℤ] Additive.ofMul y) : MatsumotoGroup R) =
      symbol x y :=
  (rfl)

/-- **The Steinberg relation.** `{x, y} = 0` when `x + y = 1`. -/
theorem symbol_of_add_eq_one {x y : Rˣ} (h : (x : R) + y = 1) : symbol x y = 0 :=
  (Submodule.Quotient.mk_eq_zero _).2 (Submodule.subset_span ⟨x, y, h, rfl⟩)

@[simp]
theorem symbol_mul_left (x x' y : Rˣ) : symbol (x * x') y = symbol x y + symbol x' y := by
  simp only [symbol, ofMul_mul, add_tmul, Submodule.Quotient.mk_add]

@[simp]
theorem symbol_mul_right (x y y' : Rˣ) : symbol x (y * y') = symbol x y + symbol x y' := by
  simp only [symbol, ofMul_mul, tmul_add, Submodule.Quotient.mk_add]

/-- `symbol` is a Steinberg pairing on `R`. -/
theorem isSteinbergPairing_symbol : IsSteinbergPairing (symbol (R := R)) where
  map_mul_left := symbol_mul_left
  map_mul_right := symbol_mul_right
  steinberg := symbol_of_add_eq_one

@[simp]
theorem symbol_one_left (y : Rˣ) : symbol 1 y = 0 := by
  simp only [symbol, ofMul_one, zero_tmul, Submodule.Quotient.mk_zero]

@[simp]
theorem symbol_one_right (x : Rˣ) : symbol x 1 = 0 := by
  simp only [symbol, ofMul_one, tmul_zero, Submodule.Quotient.mk_zero]

@[simp]
theorem symbol_inv_left (x y : Rˣ) : symbol x⁻¹ y = -symbol x y := by
  simp only [symbol, ofMul_inv, neg_tmul, Submodule.Quotient.mk_neg]

@[simp]
theorem symbol_inv_right (x y : Rˣ) : symbol x y⁻¹ = -symbol x y := by
  simp only [symbol, ofMul_inv, tmul_neg, Submodule.Quotient.mk_neg]

@[simp]
theorem symbol_zpow_left (x y : Rˣ) (n : ℤ) : symbol (x ^ n) y = n • symbol x y := by
  rw [symbol, symbol, ofMul_zpow, ← Submodule.Quotient.mk_smul, smul_tmul']

@[simp]
theorem symbol_zpow_right (x y : Rˣ) (n : ℤ) : symbol x (y ^ n) = n • symbol x y := by
  rw [symbol, symbol, ofMul_zpow, ← Submodule.Quotient.mk_smul, ← tmul_smul]

@[simp]
theorem symbol_pow_left (x y : Rˣ) (n : ℕ) : symbol (x ^ n) y = n • symbol x y := by
  rw [← zpow_natCast, symbol_zpow_left, natCast_zsmul]

@[simp]
theorem symbol_pow_right (x y : Rˣ) (n : ℕ) : symbol x (y ^ n) = n • symbol x y := by
  rw [← zpow_natCast, symbol_zpow_right, natCast_zsmul]

/-- **Induction on the Matsumoto group.** The group is generated by the Steinberg symbols, so a
property that holds for every symbol and is closed under addition holds everywhere. -/
@[elab_as_elim]
theorem induction_on {P : MatsumotoGroup R → Prop} (q : MatsumotoGroup R)
    (symbol : ∀ x y : Rˣ, P (symbol x y)) (add : ∀ a b, P a → P b → P (a + b)) : P q := by
  obtain ⟨t, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  induction t using TensorProduct.inductionOn with
  | tmul a b =>
    obtain ⟨x, rfl⟩ := Additive.ofMul.surjective a
    obtain ⟨y, rfl⟩ := Additive.ofMul.surjective b
    rw [mk_tmul]
    exact symbol x y
  | add s t hs ht => exact add _ _ hs ht

/-- Homomorphisms out of the Matsumoto group are determined by their values on the Steinberg
symbols. -/
@[ext]
theorem hom_ext {A : Type*} [AddMonoid A] {f g : MatsumotoGroup R →+ A}
    (h : ∀ x y : Rˣ, f (symbol x y) = g (symbol x y)) : f = g := by
  ext q
  induction q using induction_on with
  | symbol x y => exact h x y
  | add a b ha hb => simp only [map_add, ha, hb]

/-- Two `ℤ`-linear maps out of `MatsumotoGroup R` agreeing on every symbol are equal. -/
@[ext]
theorem linearMap_ext {A : Type*} [AddCommGroup A] {f g : MatsumotoGroup R →ₗ[ℤ] A}
    (h : ∀ x y : Rˣ, f (symbol x y) = g (symbol x y)) : f = g :=
  LinearMap.ext fun q ↦
    DFunLike.congr_fun (hom_ext (f := f.toAddMonoidHom) (g := g.toAddMonoidHom) h) q

/-- **The universal property of the Matsumoto group.** A biadditive pairing `c` on `Rˣ` that
satisfies the Steinberg relation, `c x y = 0` whenever `x + y = 1`, induces a homomorphism
`{x, y} ↦ c x y` on the Matsumoto group; it is unique by `hom_ext`. -/
def lift {A : Type*} [AddCommGroup A] (c : Additive Rˣ →+ Additive Rˣ →+ A)
    (hc : ∀ x y : Rˣ, (x : R) + y = 1 → c (Additive.ofMul x) (Additive.ofMul y) = 0) :
    MatsumotoGroup R →+ A :=
  (Submodule.liftQ _ (liftAddHom c fun r m n ↦ by simp).toIntLinearMap <| by
    rw [steinbergRelations_def, Submodule.span_le]
    rintro _ ⟨x, y, hxy, rfl⟩
    simpa using hc x y hxy).toAddMonoidHom

@[simp]
theorem lift_symbol {A : Type*} [AddCommGroup A] (c : Additive Rˣ →+ Additive Rˣ →+ A)
    (hc : ∀ x y : Rˣ, (x : R) + y = 1 → c (Additive.ofMul x) (Additive.ofMul y) = 0)
    (x y : Rˣ) : lift c hc (symbol x y) = c (Additive.ofMul x) (Additive.ofMul y) := by
  rw [lift, ← mk_tmul]
  simp [-mk_tmul]

private def pairingToAddMonoidHom {A : Type*} [AddCommGroup A] (c : Rˣ → Rˣ → A)
    (hc : IsSteinbergPairing c) : Additive Rˣ →+ Additive Rˣ →+ A where
  toFun u :=
    ⟨⟨fun v ↦ c (Additive.toMul u) (Additive.toMul v), by simp [hc.map_one_right]⟩,
      fun v₁ v₂ ↦ by simp [hc.map_mul_right]⟩
  map_zero' := AddMonoidHom.ext fun v ↦ by simp [hc.map_one_left]
  map_add' u₁ u₂ := AddMonoidHom.ext fun v ↦ by simp [hc.map_mul_left]

/-- Lift a Steinberg pairing `c : Rˣ → Rˣ → A` to a `ℤ`-linear map `MatsumotoGroup R →ₗ[ℤ] A`. -/
def liftPairing {A : Type*} [AddCommGroup A] (c : Rˣ → Rˣ → A) (hc : IsSteinbergPairing c) :
    MatsumotoGroup R →ₗ[ℤ] A :=
  (lift (pairingToAddMonoidHom c hc) fun _ _ hab ↦ by
    simpa [pairingToAddMonoidHom] using hc.steinberg hab).toIntLinearMap

/-- On generators, `MatsumotoGroup.liftPairing c hc` evaluates `c`. -/
@[simp]
theorem liftPairing_symbol {A : Type*} [AddCommGroup A] (c : Rˣ → Rˣ → A)
    (hc : IsSteinbergPairing c) (a b : Rˣ) :
    liftPairing c hc (symbol a b) = c a b := by
  rw [liftPairing, AddMonoidHom.coe_toIntLinearMap, lift_symbol]
  simp [pairingToAddMonoidHom]

/-- The universal equivalence between `ℤ`-linear maps `MatsumotoGroup R →ₗ[ℤ] A` and Steinberg
pairings `Rˣ → Rˣ → A`. -/
def liftEquiv {A : Type*} [AddCommGroup A] :
    (MatsumotoGroup R →ₗ[ℤ] A) ≃ {c : Rˣ → Rˣ → A // IsSteinbergPairing c} where
  toFun f :=
    ⟨fun a b ↦ f (symbol a b), isSteinbergPairing_symbol.comp_addMonoidHom f.toAddMonoidHom⟩
  invFun c := liftPairing c.val c.property
  left_inv _ := linearMap_ext fun a b ↦ liftPairing_symbol _ _ a b
  right_inv c := Subtype.ext <| funext fun a ↦ funext fun b ↦
    liftPairing_symbol c.val c.property a b

/-- Evaluating `liftEquiv f` on a pair of units applies `f` to their Steinberg symbol. -/
@[simp]
theorem liftEquiv_apply_coe {A : Type*} [AddCommGroup A] (f : MatsumotoGroup R →ₗ[ℤ] A)
    (a b : Rˣ) : (liftEquiv f : Rˣ → Rˣ → A) a b = f (symbol a b) := by
  dsimp [liftEquiv]

/-- Applying `(liftEquiv).symm` to a Steinberg pairing recovers `liftPairing`. -/
@[simp]
theorem liftEquiv_symm_apply {A : Type*} [AddCommGroup A]
    (c : {c : Rˣ → Rˣ → A // IsSteinbergPairing c}) :
    (liftEquiv (R := R) (A := A)).symm c = liftPairing c.val c.property := by
  dsimp [liftEquiv]

end CommSemiring

section CommRing

variable {R : Type*} [CommRing R]

/-- The symbol `{x, -1}` has order dividing two. -/
theorem two_nsmul_symbol_neg_one (x : Rˣ) : 2 • symbol x (-1) = 0 := by
  rw [← symbol_pow_right, neg_one_sq, symbol_one_right]

end CommRing

section Functoriality

variable {R : Type*} [CommSemiring R] {S : Type*} [CommSemiring S] {T : Type*} [CommSemiring T]

/-- Functorial `ℤ`-linear map `MatsumotoGroup R →ₗ[ℤ] MatsumotoGroup S` induced by `f : R →+* S`. -/
def map (f : R →+* S) : MatsumotoGroup R →ₗ[ℤ] MatsumotoGroup S :=
  liftPairing (fun a b ↦ symbol (Units.map f.toMonoidHom a) (Units.map f.toMonoidHom b))
    (isSteinbergPairing_symbol.comp_ringHom f)

/-- `MatsumotoGroup.map f` sends `{a, b}` to `{f a, f b}`. -/
@[simp]
theorem map_symbol (f : R →+* S) (a b : Rˣ) :
    map f (symbol a b) = symbol (Units.map f.toMonoidHom a) (Units.map f.toMonoidHom b) :=
  liftPairing_symbol _ _ a b

/-- `MatsumotoGroup.map` preserves the identity ring homomorphism. -/
@[simp]
theorem map_id : map (RingHom.id R) = LinearMap.id := linearMap_ext fun _ _ ↦ by simp

/-- `MatsumotoGroup.map` preserves composition of ring homomorphisms. -/
theorem map_comp (g : S →+* T) (f : R →+* S) : map (g.comp f) = (map g).comp (map f) :=
  linearMap_ext fun a b ↦ by
    have hcomp : (g.comp f).toMonoidHom = g.toMonoidHom.comp f.toMonoidHom :=
      MonoidHom.ext (RingHom.comp_apply g f)
    simp only [map_symbol, LinearMap.comp_apply, hcomp, Units.map_comp, MonoidHom.comp_apply]

end Functoriality

end MatsumotoGroup

end TauCeti
