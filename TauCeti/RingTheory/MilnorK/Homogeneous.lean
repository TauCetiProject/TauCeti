/-!
# Homogeneity of the Steinberg ideal

The Milnor K-ring `TauCeti.MilnorK R` of a commutative ring `R` is the quotient of the tensor
algebra `T` over `ℤ` of `U = Additive Rˣ` by the two-sided ideal `I` generated by the Steinberg
products `a ⊗ b` with `a + b = 1`. These generators are homogeneous of degree two, so `I` is a
homogeneous ideal. This file makes the resulting degree-by-degree presentation of Milnor K-theory
explicit.

For each `n`, the **Steinberg relation module** `R_n` (`TauCeti.MilnorK.steinbergRelations R n`)
is the subgroup of the tensor power `T_n = U^{⊗ n}` spanned by the pure tensors `a₁ ⊗ ⋯ ⊗ aₙ` of
units with two neighbouring entries adding up to one. Equivalently, it is the sum over
`i + j = n - 2` of the images of `T_i ⊗ R_2 ⊗ T_j` under concatenation, and `R_0 = R_1 = 0`.
The degree-`n` tensors map onto the degree-`n` Milnor K-group `K_nᴹ(R)` by
`TauCeti.MilnorK.ofTensorPower`, `a₁ ⊗ ⋯ ⊗ aₙ ↦ {a₁, …, aₙ}`.

The presentation `K_nᴹ(R) ≅ T_n / R_n` transports statements about tensor powers to Milnor
K-groups; for instance, `TauCeti.RingTheory.MilnorK.Divisible` uses it to show that the Milnor
K-groups of an algebraically closed field are uniquely divisible in degrees at least two.

## Main definitions

* `TauCeti.MilnorK.steinbergRelations R n`: the Steinberg relation module `R_n ⊆ U^{⊗ n}`.
* `TauCeti.MilnorK.ofTensorPower R n`: the map `U^{⊗ n} → K_*ᴹ(R)` onto `K_nᴹ(R)`.
* `TauCeti.MilnorK.degreeEquiv R n`: the presentation `U^{⊗ n} / R_n ≃ K_nᴹ(R)`.
* `TauCeti.MilnorK.instGradedRingDegree`: the grading of `K_*ᴹ(R)` by the `K_nᴹ(R)`.

## Main results

* `TauCeti.MilnorK.mk_eq_zero_iff`: a tensor lies in `I` exactly when each of its homogeneous
  components, in the sense of `TensorAlgebra.toDirectSum`, lies in the corresponding `R_n`.
* `TauCeti.MilnorK.isHomogeneous_ker_mk`: `I` is a homogeneous ideal for the grading
  `TensorAlgebra.gradedAlgebra`.
* `TauCeti.MilnorK.ofTensorPower_eq_zero_iff`, `TauCeti.MilnorK.ker_ofTensorPower`:
  `I ∩ T_n = R_n`.
* `TauCeti.MilnorK.gMul_mem_steinbergRelations_left`,
  `TauCeti.MilnorK.gMul_mem_steinbergRelations_right`: `T_i R_j + R_i T_j ⊆ R_{i + j}`.
* `TauCeti.MilnorK.steinbergRelations_eq_bot`: `R_0 = R_1 = 0`.
* `TauCeti.MilnorK.range_ofTensorPower`: the image of `T_n` is `K_nᴹ(R)`.
* `TauCeti.MilnorK.isInternal_degree`: `K_*ᴹ(R)` is the internal direct sum of the `K_nᴹ(R)`.
* `TauCeti.MilnorK.coe_decompose_mk`: the degree-`n` component of the class of a tensor is the
  image of its degree-`n` component.

## Implementation notes

The tensors whose homogeneous components all lie in the relation modules form a two-sided ideal,
because `R_•` is stable under multiplication by tensors of any degree on either side. It contains
the generators `a ⊗ b`, so it contains `I`; the converse inclusion holds generator by generator.

## References

* J. Milnor, *Algebraic K-theory and quadratic forms*, Invent. Math. 9 (1970), 318–344, §1.
* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter III, Definition 7.1.
-/

public section

noncomputable section

open TensorAlgebra DirectSum
open scoped TensorProduct

namespace TauCeti

namespace MilnorK

variable (R : Type*) [CommRing R]

/-- The degree-`n` **Steinberg relation module** `R_n ⊆ (Additive Rˣ)^{⊗ n}`: the span of the pure
tensors `a₁ ⊗ ⋯ ⊗ aₙ` of units in which two neighbouring entries add up to one. -/
def steinbergRelations (n : ℕ) : Submodule ℤ (⨂[ℤ]^n (Additive Rˣ)) :=
  Submodule.span ℤ {t | ∃ (f : Fin n → Rˣ) (i : ℕ) (hi : i + 1 < n),
    (f ⟨i, Nat.lt_of_succ_lt hi⟩ : R) + f ⟨i + 1, hi⟩ = 1 ∧
      t = PiTensorProduct.tprod ℤ fun k ↦ Additive.ofMul (f k)}

/-- `R_n` is spanned by the pure tensors of units with two neighbouring entries adding up to one. -/
theorem steinbergRelations_eq_span (n : ℕ) :
    steinbergRelations R n = Submodule.span ℤ {t | ∃ (f : Fin n → Rˣ) (i : ℕ) (hi : i + 1 < n),
      (f ⟨i, Nat.lt_of_succ_lt hi⟩ : R) + f ⟨i + 1, hi⟩ = 1 ∧
        t = PiTensorProduct.tprod ℤ fun k ↦ Additive.ofMul (f k)} :=
  (rfl)

variable {R}

/-- A pure tensor of units with two neighbouring entries adding up to one is a Steinberg
relation. -/
theorem tprod_mem_steinbergRelations {n : ℕ} (f : Fin n → Rˣ) (i : ℕ) (hi : i + 1 < n)
    (h : (f ⟨i, Nat.lt_of_succ_lt hi⟩ : R) + f ⟨i + 1, hi⟩ = 1) :
    (PiTensorProduct.tprod ℤ fun k ↦ Additive.ofMul (f k)) ∈ steinbergRelations R n :=
  Submodule.subset_span ⟨f, i, hi, h, rfl⟩

/-- The multiplication `⨂^i ⊗ ⨂^j → ⨂^(i + j)` of tensor powers, as a bilinear map. -/
private abbrev gMulBilin (i j : ℕ) :
    ⨂[ℤ]^i (Additive Rˣ) →ₗ[ℤ] ⨂[ℤ]^j (Additive Rˣ) →ₗ[ℤ] ⨂[ℤ]^(i + j) (Additive Rˣ) :=
  (TensorProduct.mk ℤ _ _).compr₂ (TensorPower.mulEquiv : _ ≃ₗ[ℤ] ⨂[ℤ]^(i + j) _).toLinearMap

private theorem gMulBilin_apply {i j : ℕ} (a : ⨂[ℤ]^i (Additive Rˣ)) (b : ⨂[ℤ]^j (Additive Rˣ)) :
    gMulBilin i j a b = GradedMonoid.GMul.mul (A := fun n ↦ ⨂[ℤ]^n (Additive Rˣ)) a b :=
  (TensorPower.gMul_eq_coe_linearMap a b).symm

private theorem ofMul_toMul_comp {n : ℕ} (g : Fin n → Additive Rˣ) :
    g = fun k ↦ Additive.ofMul (g k).toMul :=
  funext fun k ↦ (ofMul_toMul (g k)).symm

/-- Left multiplication by a tensor of degree `i` maps `R_j` into `R_{i + j}`. -/
theorem gMul_mem_steinbergRelations_left {i j : ℕ} (a : ⨂[ℤ]^i (Additive Rˣ))
    {x : ⨂[ℤ]^j (Additive Rˣ)} (hx : x ∈ steinbergRelations R j) :
    GradedMonoid.GMul.mul (A := fun n ↦ ⨂[ℤ]^n (Additive Rˣ)) a x ∈
      steinbergRelations R (i + j) := by
  refine (?_ : Submodule.map₂ (gMulBilin i j) ⊤ (steinbergRelations R j) ≤ _)
    (Submodule.apply_mem_map₂ _ Submodule.mem_top hx)
  rw [← PiTensorProduct.span_tprod_eq_top, steinbergRelations_eq_span R j,
    Submodule.map₂_span_span, Submodule.span_le]
  rintro _ ⟨_, ⟨g, rfl⟩, _, ⟨f, l, hl, h, rfl⟩, rfl⟩
  simp only [SetLike.mem_coe, gMulBilin_apply]
  rw [ofMul_toMul_comp g, TensorPower.tprod_mul_tprod, ← Function.comp_def Additive.ofMul,
    ← Function.comp_def Additive.ofMul, ← Fin.comp_append]
  refine tprod_mem_steinbergRelations _ (i + l) (by omega) ?_
  -- The entries `i + l` and `i + l + 1` of the concatenation are the entries `l` and `l + 1`
  -- of its right block `f`.
  have e₀ : (⟨i + l, by omega⟩ : Fin (i + j)) = Fin.natAdd i ⟨l, Nat.lt_of_succ_lt hl⟩ := by
    ext; simp
  have e₁ : (⟨i + l + 1, by omega⟩ : Fin (i + j)) = Fin.natAdd i ⟨l + 1, hl⟩ := by
    ext; simp [Nat.add_assoc]
  rwa [e₀, e₁, Fin.append_right, Fin.append_right]

/-- Right multiplication by a tensor of degree `j` maps `R_i` into `R_{i + j}`. -/
theorem gMul_mem_steinbergRelations_right {i j : ℕ} {x : ⨂[ℤ]^i (Additive Rˣ)}
    (hx : x ∈ steinbergRelations R i) (b : ⨂[ℤ]^j (Additive Rˣ)) :
    GradedMonoid.GMul.mul (A := fun n ↦ ⨂[ℤ]^n (Additive Rˣ)) x b ∈
      steinbergRelations R (i + j) := by
  refine (?_ : Submodule.map₂ (gMulBilin i j) (steinbergRelations R i) ⊤ ≤ _)
    (Submodule.apply_mem_map₂ _ hx Submodule.mem_top)
  rw [← PiTensorProduct.span_tprod_eq_top, steinbergRelations_eq_span R i,
    Submodule.map₂_span_span, Submodule.span_le]
  rintro _ ⟨_, ⟨f, l, hl, h, rfl⟩, _, ⟨g, rfl⟩, rfl⟩
  simp only [SetLike.mem_coe, gMulBilin_apply]
  rw [ofMul_toMul_comp g, TensorPower.tprod_mul_tprod, ← Function.comp_def Additive.ofMul,
    ← Function.comp_def Additive.ofMul, ← Fin.comp_append]
  refine tprod_mem_steinbergRelations _ l (by omega) ?_
  -- The entries `l` and `l + 1` of the concatenation are those of its left block `f`.
  have e₀ : (⟨l, by omega⟩ : Fin (i + j)) = Fin.castAdd j ⟨l, Nat.lt_of_succ_lt hl⟩ := by
    ext; simp
  have e₁ : (⟨l + 1, by omega⟩ : Fin (i + j)) = Fin.castAdd j ⟨l + 1, hl⟩ := by
    ext; simp
  rwa [e₀, e₁, Fin.append_left, Fin.append_left]

/-- There are no Steinberg relations in degrees zero and one. -/
theorem steinbergRelations_eq_bot {n : ℕ} (hn : n < 2) : steinbergRelations R n = ⊥ := by
  rw [steinbergRelations_eq_span, Submodule.span_eq_bot]
  rintro _ ⟨f, i, hi, -, rfl⟩
  omega

/-! ### The kernel of the quotient map is homogeneous -/

/-- The direct sums of tensors all of whose components are Steinberg relations. -/
private def relSum : Submodule ℤ (⨁ n, ⨂[ℤ]^n (Additive Rˣ)) where
  carrier := {d | ∀ n, d n ∈ steinbergRelations R n}
  zero_mem' n := by simp
  add_mem' hd he n := by simpa using add_mem (hd n) (he n)
  smul_mem' c d hd n := by rw [DirectSum.smul_apply]; exact zsmul_mem (hd n) c

private theorem mem_relSum {d : ⨁ n, ⨂[ℤ]^n (Additive Rˣ)} :
    d ∈ relSum (R := R) ↔ ∀ n, d n ∈ steinbergRelations R n :=
  Iff.rfl

private theorem of_mem_relSum {n : ℕ} {y : ⨂[ℤ]^n (Additive Rˣ)}
    (hy : y ∈ steinbergRelations R n) : of _ n y ∈ relSum (R := R) := fun m ↦ by
  by_cases h : n = m
  · subst h
    simpa using hy
  · simp [of_eq_of_ne _ _ _ (Ne.symm h)]

/-- Induction on an element of `relSum`, through its decomposition into homogeneous
components. -/
private theorem relSum_induction {P : (⨁ n, ⨂[ℤ]^n (Additive Rˣ)) → Prop} (h0 : P 0)
    (hadd : ∀ d e, P d → P e → P (d + e))
    (hof : ∀ n (y : ⨂[ℤ]^n (Additive Rˣ)), y ∈ steinbergRelations R n → P (of _ n y))
    {d : ⨁ n, ⨂[ℤ]^n (Additive Rˣ)} (hd : d ∈ relSum (R := R)) : P d := by
  classical
  rw [← sum_support_of d]
  induction d.support using Finset.induction_on with
  | empty => simpa using h0
  | insert n s hn ih => rw [Finset.sum_insert hn]; exact hadd _ _ (hof n _ (hd n)) ih

private theorem mul_mem_relSum_left (e : ⨁ n, ⨂[ℤ]^n (Additive Rˣ))
    {d : ⨁ n, ⨂[ℤ]^n (Additive Rˣ)} (hd : d ∈ relSum (R := R)) : e * d ∈ relSum (R := R) := by
  refine relSum_induction (P := fun d ↦ e * d ∈ relSum (R := R)) (by simp)
    (fun d d' hd hd' ↦ by simpa [mul_add] using add_mem hd hd') (fun n y hy ↦ ?_) hd
  induction e using DirectSum.induction_on with
  | zero => simp
  | of m a => rw [of_mul_of]; exact of_mem_relSum (gMul_mem_steinbergRelations_left a hy)
  | add a b ha hb => simpa [add_mul] using add_mem ha hb

private theorem mul_mem_relSum_right {d : ⨁ n, ⨂[ℤ]^n (Additive Rˣ)}
    (hd : d ∈ relSum (R := R)) (e : ⨁ n, ⨂[ℤ]^n (Additive Rˣ)) : d * e ∈ relSum (R := R) := by
  refine relSum_induction (P := fun d ↦ d * e ∈ relSum (R := R)) (by simp)
    (fun d d' hd hd' ↦ by simpa [add_mul] using add_mem hd hd') (fun n y hy ↦ ?_) hd
  induction e using DirectSum.induction_on with
  | zero => simp
  | of m a => rw [of_mul_of]; exact of_mem_relSum (gMul_mem_steinbergRelations_right hy a)
  | add a b ha hb => simpa [mul_add] using add_mem ha hb

/-- The tensors all of whose homogeneous components are Steinberg relations form a two-sided
ideal. -/
private def relIdeal : TwoSidedIdeal (TensorAlgebra ℤ (Additive Rˣ)) :=
  TwoSidedIdeal.mk' (relSum.comap (toDirectSum (R := ℤ) (M := Additive Rˣ)).toLinearMap)
    (zero_mem _) add_mem neg_mem
    (fun {t _} hu ↦ by simpa using mul_mem_relSum_left (toDirectSum t) hu)
    (fun {_ u} ht ↦ by simpa using mul_mem_relSum_right ht (toDirectSum u))

private theorem mem_relIdeal {t : TensorAlgebra ℤ (Additive Rˣ)} :
    t ∈ relIdeal (R := R) ↔ ∀ n, toDirectSum t n ∈ steinbergRelations R n := by
  rw [relIdeal, TwoSidedIdeal.mem_mk', SetLike.mem_coe, Submodule.mem_comap,
    AlgHom.toLinearMap_apply, mem_relSum]

variable (R) in
/-- The `ℤ`-linear map `(Additive Rˣ)^{⊗ n} → K_*ᴹ(R)` sending `a₁ ⊗ ⋯ ⊗ aₙ` to the Milnor symbol
`{a₁, …, aₙ}`. Its range is `K_nᴹ(R)` and its kernel is `R_n`. -/
def ofTensorPower (n : ℕ) : ⨂[ℤ]^n (Additive Rˣ) →ₗ[ℤ] MilnorK R :=
  (mk (R := R)).toIntAlgHom.toLinearMap ∘ₗ TensorPower.toTensorAlgebra

/-- `ofTensorPower` is the quotient map `TauCeti.MilnorK.mk` on the image of the tensor power in
the tensor algebra. -/
theorem ofTensorPower_apply {n : ℕ} (x : ⨂[ℤ]^n (Additive Rˣ)) :
    ofTensorPower R n x = mk (TensorPower.toTensorAlgebra x) :=
  (rfl)

/-- `ofTensorPower` sends the pure tensor of units `a₁ ⊗ ⋯ ⊗ aₙ` to the symbol `{a₁, …, aₙ}`. -/
@[simp]
theorem ofTensorPower_tprod {n : ℕ} (f : Fin n → Rˣ) :
    ofTensorPower R n (PiTensorProduct.tprod ℤ fun k ↦ Additive.ofMul (f k)) =
      symbol (List.ofFn f) := by
  rw [ofTensorPower_apply, TensorPower.toTensorAlgebra_tprod, TensorAlgebra.tprod_apply,
    map_list_prod, List.map_ofFn]
  induction n with
  | zero => simp
  | succ n ih => simp [List.ofFn_succ, ← ih (fun i ↦ f i.succ), Function.comp_def]

/-- `ofTensorPower` turns the multiplication of tensor powers into the product of the Milnor
K-ring. -/
@[simp]
theorem ofTensorPower_gMul {i j : ℕ} (a : ⨂[ℤ]^i (Additive Rˣ)) (b : ⨂[ℤ]^j (Additive Rˣ)) :
    ofTensorPower R (i + j) (GradedMonoid.GMul.mul (A := fun n ↦ ⨂[ℤ]^n (Additive Rˣ)) a b) =
      ofTensorPower R i a * ofTensorPower R j b := by
  simp [ofTensorPower_apply]

private theorem ofTensorPower_eq_zero_of_mem {n : ℕ} {x : ⨂[ℤ]^n (Additive Rˣ)}
    (hx : x ∈ steinbergRelations R n) : ofTensorPower R n x = 0 := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨f, i, hi, h, rfl⟩ := hx
    have h₁ : i < (List.ofFn f).length := by simp; omega
    have h₂ : i + 1 < (List.ofFn f).length := by simpa using hi
    rw [ofTensorPower_tprod, ← List.take_append_drop i (List.ofFn f),
      List.drop_eq_getElem_cons h₁, List.drop_eq_getElem_cons h₂]
    exact symbol_append_cons_cons_of_add_eq_one _ _ (by simpa using h)
  | zero => simp
  | add x y _ _ hx hy => simp [hx, hy]
  | smul r x _ hx => simp [hx]

/-- **Homogeneity of the Steinberg ideal.** A tensor `t` vanishes in the Milnor K-ring exactly when
each of its homogeneous components is a Steinberg relation. -/
theorem mk_eq_zero_iff {t : TensorAlgebra ℤ (Additive Rˣ)} :
    mk t = 0 ↔ ∀ n, toDirectSum t n ∈ steinbergRelations R n := by
  classical
  constructor
  · intro ht
    have hle : ringConGen (milnorRel R) ≤ (relIdeal (R := R)).ringCon :=
      RingCon.ringConGen_le.2 fun x y hxy ↦ by
        obtain ⟨a, b, h, rfl, rfl⟩ := (milnorRel_iff R).1 hxy
        simp only [TwoSidedIdeal.rel_iff, sub_zero, mem_relIdeal, map_mul, toDirectSum_ι,
          of_mul_of, ← mem_relSum]
        refine of_mem_relSum ?_
        rw [TensorPower.tprod_mul_tprod]
        refine tprod_mem_steinbergRelations (fun k ↦ Fin.append (fun _ ↦ a) (fun _ ↦ b) k) 0
          (by norm_num) ?_
        -- The entries `0` and `1` of the concatenation of `a` and `b` are `a` and `b`.
        have e₀ : (⟨0, by norm_num⟩ : Fin (1 + 1)) = Fin.castAdd 1 0 := by ext; simp
        have e₁ : (⟨0 + 1, by norm_num⟩ : Fin (1 + 1)) = Fin.natAdd 1 0 := by ext; simp
        rwa [e₀, e₁, Fin.append_left, Fin.append_right]
    have := hle (mk_eq_mk_iff.1 (ht.trans (map_zero mk).symm))
    rwa [TwoSidedIdeal.rel_iff, sub_zero, mem_relIdeal] at this
  · intro ht
    rw [← ofDirectSum_toDirectSum t, ← sum_support_of (toDirectSum t), map_sum, map_sum]
    exact Finset.sum_eq_zero fun n _ ↦ by
      rw [ofDirectSum_of, ← ofTensorPower_apply, ofTensorPower_eq_zero_of_mem (ht n)]

/-- **`I ∩ T_n = R_n`.** A degree-`n` tensor vanishes in the Milnor K-ring exactly when it is a
Steinberg relation. -/
theorem ofTensorPower_eq_zero_iff {n : ℕ} {x : ⨂[ℤ]^n (Additive Rˣ)} :
    ofTensorPower R n x = 0 ↔ x ∈ steinbergRelations R n := by
  refine ⟨fun hx ↦ ?_, ofTensorPower_eq_zero_of_mem⟩
  simpa [toDirectSum_toTensorAlgebra] using mk_eq_zero_iff.1 hx n

/-- The kernel of `T_n → K_*ᴹ(R)` is the Steinberg relation module `R_n`. -/
theorem ker_ofTensorPower (n : ℕ) :
    LinearMap.ker (ofTensorPower R n) = steinbergRelations R n :=
  Submodule.ext fun _ ↦ ofTensorPower_eq_zero_iff

/-- **Homogeneity of the Steinberg ideal.** For the grading `TensorAlgebra.gradedAlgebra` of the
tensor algebra by the powers `range ι ^ n`, every homogeneous component of an element of the
kernel of `TauCeti.MilnorK.mk` lies in the kernel. -/
theorem isHomogeneous_ker_mk :
    (RingHom.ker (mk (R := R))).IsHomogeneous
      (fun n : ℕ ↦ LinearMap.range (ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ)) ^ n) :=
  fun n t ht ↦ by
    rw [RingHom.mem_ker] at ht ⊢
    rw [coe_decompose_eq_toTensorAlgebra_toDirectSum, ← ofTensorPower_apply,
      ofTensorPower_eq_zero_iff]
    exact mk_eq_zero_iff.1 ht n

/-! ### The degree-`n` presentation -/

/-- The image of the degree-`n` tensors in the Milnor K-ring is `K_nᴹ(R)`. -/
theorem range_ofTensorPower (n : ℕ) : LinearMap.range (ofTensorPower R n) = degree R n := by
  refine le_antisymm ?_ ?_
  · rw [LinearMap.range_eq_map, ← PiTensorProduct.span_tprod_eq_top, Submodule.map_span,
      Submodule.span_le]
    rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
    have h := ofTensorPower_tprod (R := R) fun k ↦ (x k).toMul
    simp only [ofMul_toMul] at h
    rw [h]
    simpa using symbol_mem_degree (List.ofFn fun k ↦ (x k).toMul)
  · rw [degree_eq_span, Submodule.span_le]
    rintro _ ⟨l, rfl, rfl⟩
    exact ⟨PiTensorProduct.tprod ℤ fun k ↦ Additive.ofMul (l.get k), by
      rw [ofTensorPower_tprod, List.ofFn_get]⟩

variable (R) in
/-- **The degree-`n` Milnor K-group is `T_n / R_n`**: the quotient of the `n`-th tensor power of
`Additive Rˣ` by the Steinberg relation module is `K_nᴹ(R)`, the class of `a₁ ⊗ ⋯ ⊗ aₙ` going to
the symbol `{a₁, …, aₙ}`. -/
def degreeEquiv (n : ℕ) :
    ((⨂[ℤ]^n (Additive Rˣ)) ⧸ steinbergRelations R n) ≃ₗ[ℤ] degree R n :=
  (Submodule.quotEquivOfEq _ _ (ker_ofTensorPower n).symm).trans
    ((ofTensorPower R n).quotKerEquivRange.trans (LinearEquiv.ofEq _ _ (range_ofTensorPower n)))

/-- `degreeEquiv` sends the class of a degree-`n` tensor to its image in the Milnor K-ring. -/
@[simp]
theorem coe_degreeEquiv_mk {n : ℕ} (x : ⨂[ℤ]^n (Additive Rˣ)) :
    (degreeEquiv R n (Submodule.Quotient.mk x) : MilnorK R) = ofTensorPower R n x := by
  simp [degreeEquiv, Submodule.quotEquivOfEq_mk, LinearMap.quotKerEquivRange_apply_mk]

/-- The inverse of `degreeEquiv` sends a symbol `{a₁, …, aₙ}` to the class of `a₁ ⊗ ⋯ ⊗ aₙ`. -/
@[simp]
theorem degreeEquiv_symm_symbol {n : ℕ} (f : Fin n → Rˣ) :
    (degreeEquiv R n).symm ⟨symbol (List.ofFn f), by simpa using symbol_mem_degree (List.ofFn f)⟩ =
      Submodule.Quotient.mk (PiTensorProduct.tprod ℤ fun k ↦ Additive.ofMul (f k)) := by
  rw [LinearEquiv.symm_apply_eq]
  ext
  simp

/-! ### The direct sum decomposition -/

/-- The map sending a tensor to the family of images in `K_nᴹ(R)` of its homogeneous components. -/
private def toDegrees : TensorAlgebra ℤ (Additive Rˣ) →ₗ[ℤ] ⨁ n, degree R n :=
  lmap (fun n ↦ (ofTensorPower R n).codRestrict (degree R n) fun x ↦
    range_ofTensorPower (R := R) n ▸ LinearMap.mem_range_self _ x) ∘ₗ
    (toDirectSum (R := ℤ)).toLinearMap

private theorem toDegrees_eq_zero_iff {t : TensorAlgebra ℤ (Additive Rˣ)} :
    toDegrees t = 0 ↔ mk t = 0 := by
  simp [toDegrees, DirectSum.ext_iff, mk_eq_zero_iff, Subtype.ext_iff, ofTensorPower_eq_zero_iff]

private theorem toDegrees_surjective : Function.Surjective (toDegrees (R := R)) := by
  refine ((lmap_surjective _).2 fun n ↦ ?_).comp fun d ↦ ⟨ofDirectSum d, toDirectSum_ofDirectSum d⟩
  rintro ⟨x, hx⟩
  obtain ⟨y, rfl⟩ := (range_ofTensorPower (R := R) n).ge hx
  exact ⟨y, rfl⟩

private theorem coeLinearMap_toDegrees (t : TensorAlgebra ℤ (Additive Rˣ)) :
    coeLinearMap (degree R) (toDegrees t) = mk t := by
  conv_rhs => rw [← ofDirectSum_toDirectSum t]
  refine LinearMap.congr_fun (f := coeLinearMap (degree R) ∘ₗ lmap _)
    (g := (mk (R := R)).toIntAlgHom.toLinearMap ∘ₗ (ofDirectSum (R := ℤ)).toLinearMap)
    (linearMap_ext ℤ fun n ↦ LinearMap.ext fun x ↦ ?_) (toDirectSum t)
  simp [lof_eq_of, ofDirectSum_of, ofTensorPower_apply]

/-- **The Milnor K-ring is the direct sum of its degree pieces** `K_nᴹ(R)`. Together with
`TauCeti.MilnorK.degreeEquiv`, its additive group is the direct sum of the quotients `T_n / R_n`. -/
theorem isInternal_degree : IsInternal (degree R) := by
  -- `IsInternal` is the bijectivity of `coeAddMonoidHom`, the additive map underlying
  -- `coeLinearMap`.
  suffices Function.Bijective (coeLinearMap (degree R)) from this
  refine ⟨(injective_iff_map_eq_zero _).2 fun y hy ↦ ?_, fun x ↦ ?_⟩
  · obtain ⟨t, rfl⟩ := toDegrees_surjective (R := R) y
    rw [coeLinearMap_toDegrees] at hy
    exact toDegrees_eq_zero_iff.2 hy
  · obtain ⟨t, rfl⟩ := mk_surjective x
    exact ⟨toDegrees t, coeLinearMap_toDegrees t⟩

/-- The Milnor K-ring is graded by the degree pieces `K_nᴹ(R)`. -/
instance instGradedRingDegree : GradedRing (degree R) where
  __ := instGradedMonoidDegree
  __ := isInternal_degree.chooseDecomposition

/-- The degree-`n` component of the class of a tensor `t` in the grading
`TauCeti.MilnorK.instGradedRingDegree` is the image in `K_nᴹ(R)` of the degree-`n` component of
`t`. -/
@[simp]
theorem coe_decompose_mk (t : TensorAlgebra ℤ (Additive Rˣ)) (n : ℕ) :
    (decompose (degree R) (mk t) n : MilnorK R) = ofTensorPower R n (toDirectSum t n) := by
  -- `coeLinearMap` is inverse to the decomposition: `Decomposition.right_inv` is stated for
  -- `coeAddMonoidHom`, the additive map underlying `coeLinearMap`.
  have h (y : ⨁ n, degree R n) : decompose (degree R) (coeLinearMap (degree R) y) = y :=
    Decomposition.right_inv y
  rw [← coeLinearMap_toDegrees t, h]
  simp [toDegrees]

end MilnorK

end TauCeti
