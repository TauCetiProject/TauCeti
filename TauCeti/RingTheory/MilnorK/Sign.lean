/-!
# The sign of Milnor symbols over an ordered ring

Let `R` be a linearly ordered commutative ring, such as `ℤ` or an ordered field like `ℝ`, and
write `ε a ∈ ZMod 2` for `1` if the unit `a` is negative and `0` if it is positive. The additive
map `a ↦ ε a • X` into the polynomial ring `(ZMod 2)[X]` kills the Steinberg products, because two
units adding up to one are not both negative. So it induces a ring homomorphism, the
**sign polynomial** `K_*ᴹ(R) →+* (ZMod 2)[X]`, sending a symbol `{a₁, …, aₙ}` to `X ^ n` when
every entry is negative and to `0` otherwise. Its coefficient of `X ^ n` is the **sign map**
`K_nᴹ(R) →+ ZMod 2`.

The sign polynomial detects the symbols `{-1, …, -1}`: they are nonzero in every degree, and of
order exactly two in every positive degree. In particular the Milnor K-ring is not an exterior
algebra. For `n ≠ 0`, let `Dₙ` be the subgroup of `K_nᴹ(R)` spanned by the symbols of length `n`
with at least one positive entry. Then

* `Dₙ` is exactly the kernel of the sign map on `K_nᴹ(R)`;
* every class of `K_nᴹ(R)` is uniquely `ε • {-1, …, -1} + d` with `ε ∈ ZMod 2` and `d ∈ Dₙ`,
  which gives a splitting `K_nᴹ(R) ≃ₗ[ℤ] ZMod 2 × Dₙ`;
* if `R` is a real closed field, for instance `R = ℝ`, then `Dₙ` is divisible;
* if every positive unit of `R` is the square of a unit, for instance if `R` is `ℤ` or a real
  closed field, then the sign polynomial identifies `K_*ᴹ(R) / 2` with `(ZMod 2)[X]`, the class
  of `{-1}` going to `X`.

For `R = ℝ` this is Milnor's computation of the Milnor K-theory of the real numbers: `K_nᴹ(ℝ)`,
`n ≥ 1`, is the direct sum of the group of order two generated by `{-1, …, -1}` and a divisible
group, and `K_*ᴹ(ℝ) / 2` is a polynomial ring on the class of `{-1}`. The degree-two case of the
splitting, stated on the Matsumoto group of an ordered field, is
`TauCeti.MatsumotoGroup.positiveEntryEquiv`.

## Main definitions

* `TauCeti.MilnorK.signPolynomial R`: the ring homomorphism `K_*ᴹ(R) →+* (ZMod 2)[X]`.
* `TauCeti.MilnorK.sign R n`: the sign map `K_*ᴹ(R) →+ ZMod 2` in degree `n`.
* `TauCeti.MilnorK.positiveEntrySpan R n`: the span `Dₙ` of the symbols of length `n` with a
  positive entry.
* `TauCeti.MilnorK.positiveEntryEquiv R hn`: the splitting
  `degree R n ≃ₗ[ℤ] ZMod 2 × positiveEntrySpan R n`, for `n ≠ 0`.
* `TauCeti.MilnorK.modTwoEquiv R hsq`: the ring isomorphism `K_*ᴹ(R) / 2 ≃+* (ZMod 2)[X]` when
  every positive unit is a square, where `K_*ᴹ(R) / 2` is the Milnor K-ring modulo two
  `TauCeti.MilnorK.ModTwo R`.

## Main results

* `TauCeti.MilnorK.signPolynomial_symbol`, `TauCeti.MilnorK.sign_symbol`: the values on symbols.
* `TauCeti.MilnorK.ofUnit_neg_one_pow_ne_zero`, `TauCeti.MilnorK.addOrderOf_ofUnit_neg_one_pow`:
  `{-1, …, -1} ≠ 0`, of order two in positive degree.
* `TauCeti.MilnorK.sign_eq_zero_iff`: the kernel of the sign map on `K_nᴹ(R)` is `Dₙ`.
* `TauCeti.MilnorK.positiveEntrySpan_nsmul_right_surjective`: over a real closed field,
  multiplication by every `m ≠ 0` is surjective on `Dₙ`.

## References

* J. Milnor, *Algebraic K-theory and quadratic forms*, Invent. Math. 9 (1970), 318–344, §1.
* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter III, Example 6.2.1 and Example 7.2(c).
-/

public section

noncomputable section

open Polynomial

namespace TauCeti

namespace MilnorK

variable {R : Type*} [CommRing R] [LinearOrder R] [IsStrictOrderedRing R]

/-! ### The sign polynomial and the sign maps -/

variable (R) in
/-- The **sign polynomial** of the Milnor K-ring of a linearly ordered commutative ring: the ring
homomorphism `K_*ᴹ(R) →+* (ZMod 2)[X]` sending the degree-one class `{a}` to `X` if `a < 0` and
to `0` if `a > 0`. It sends a symbol `{a₁, …, aₙ}` to `X ^ n` when every entry is negative, and
to `0` otherwise (`TauCeti.MilnorK.signPolynomial_symbol`). -/
def signPolynomial : MilnorK R →+* (ZMod 2)[X] :=
  lift ((monomial 1).toAddMonoidHom.comp (Units.signAddHom R)) fun a b h ↦ by
    -- Two units adding up to one are not both negative.
    have hab : ¬((a : R) < 0 ∧ (b : R) < 0) := fun hab ↦ by linarith [hab.1, hab.2]
    simp only [AddMonoidHom.comp_apply, LinearMap.toAddMonoidHom_coe, monomial_mul_monomial,
      Units.signAddHom_ofMul]
    split_ifs <;> simp_all

@[simp]
theorem signPolynomial_ofUnit (a : Rˣ) :
    signPolynomial R (ofUnit a) = if (a : R) < 0 then X else 0 := by
  rw [signPolynomial, lift_ofUnit, AddMonoidHom.comp_apply, Units.signAddHom_ofMul]
  split_ifs <;> simp [monomial_one_one_eq_X]

@[simp]
theorem signPolynomial_symbol (l : List Rˣ) :
    signPolynomial R (symbol l) = if ∀ a ∈ l, (a : R) < 0 then X ^ l.length else 0 := by
  induction l with
  | nil => simp
  | cons a l ih =>
    rw [symbol_cons, map_mul, ih, signPolynomial_ofUnit]
    by_cases ha : (a : R) < 0 <;> by_cases hl : ∀ b ∈ l, (b : R) < 0 <;>
      simp [ha, hl, pow_succ']

variable (R) in
/-- The **sign map** in degree `n` of the Milnor K-ring of a linearly ordered commutative ring: the
coefficient of `X ^ n` in the sign polynomial. It sends a symbol of length `n` to `1` if every
entry is negative and to `0` otherwise (`TauCeti.MilnorK.sign_symbol`). On `K_nᴹ(R)` with `n ≠ 0`
its kernel is the positive-entry span (`TauCeti.MilnorK.sign_eq_zero_iff`). -/
def sign (n : ℕ) : MilnorK R →+ ZMod 2 :=
  (lcoeff (ZMod 2) n).toAddMonoidHom.comp (signPolynomial R).toAddMonoidHom

theorem sign_apply (n : ℕ) (x : MilnorK R) : sign R n x = (signPolynomial R x).coeff n :=
  (rfl)

@[simp]
theorem sign_symbol (n : ℕ) (l : List Rˣ) :
    sign R n (symbol l) = if l.length = n ∧ ∀ a ∈ l, (a : R) < 0 then 1 else 0 := by
  rw [sign_apply, signPolynomial_symbol]
  by_cases hl : ∀ a ∈ l, (a : R) < 0
  · simp only [eq_true hl, and_true, ite_true, coeff_X_pow, eq_comm]
  · simp only [eq_false hl, and_false, ite_false, coeff_zero]

@[simp]
theorem sign_ofUnit (n : ℕ) (a : Rˣ) :
    sign R n (ofUnit a) = if n = 1 ∧ (a : R) < 0 then 1 else 0 := by
  rw [← symbol_singleton, sign_symbol]
  simp [eq_comm]

@[simp]
theorem sign_ofUnit_pow (n k : ℕ) (a : Rˣ) :
    sign R n (ofUnit a ^ k) = if k = n ∧ (k = 0 ∨ (a : R) < 0) then 1 else 0 := by
  rw [← symbol_replicate, sign_symbol]
  simp [or_iff_not_imp_left]

/-- The sign map in degree `n` sends `{-1, …, -1}`, with `n` entries, to `1`. -/
theorem sign_ofUnit_neg_one_pow (n : ℕ) : sign R n (ofUnit (-1 : Rˣ) ^ n) = 1 := by
  simp

/-- **The symbol `{-1, …, -1}` is nonzero** in every degree of the Milnor K-ring of a linearly
ordered commutative ring: the sign map in degree `n` sends it to `1`. -/
theorem ofUnit_neg_one_pow_ne_zero (n : ℕ) : ofUnit (-1 : Rˣ) ^ n ≠ 0 := fun h ↦ by
  simpa [h] using sign_ofUnit_neg_one_pow (R := R) n

/-- **The symbol `{-1, …, -1}` has order exactly two** in every positive degree of the Milnor
K-ring of a linearly ordered commutative ring. -/
theorem addOrderOf_ofUnit_neg_one_pow {n : ℕ} (hn : n ≠ 0) :
    addOrderOf (ofUnit (-1 : Rˣ) ^ n) = 2 := by
  have := Fact.mk Nat.prime_two
  exact addOrderOf_eq_prime (two_nsmul_ofUnit_neg_one_pow hn) (ofUnit_neg_one_pow_ne_zero n)

/-! ### The positive-entry span -/

variable (R) in
/-- The subgroup `Dₙ` of the Milnor K-ring of a linearly ordered commutative ring spanned by the
symbols of length `n` with at least one positive entry. It lies in `K_nᴹ(R)`, where for `n ≠ 0`
it is the kernel of the sign map (`TauCeti.MilnorK.sign_eq_zero_iff`), and it is divisible when
`R` is a real closed field (`TauCeti.MilnorK.positiveEntrySpan_nsmul_right_surjective`). -/
def positiveEntrySpan (n : ℕ) : Submodule ℤ (MilnorK R) :=
  Submodule.span ℤ (symbol '' {l : List Rˣ | l.length = n ∧ ∃ a ∈ l, 0 < (a : R)})

omit [IsStrictOrderedRing R] in
variable (R) in
theorem positiveEntrySpan_def (n : ℕ) :
    positiveEntrySpan R n =
      Submodule.span ℤ (symbol '' {l : List Rˣ | l.length = n ∧ ∃ a ∈ l, 0 < (a : R)}) :=
  (rfl)

omit [IsStrictOrderedRing R] in
/-- The universal property of the positive-entry span: it lies in a subgroup exactly when every
symbol of length `n` with a positive entry does. -/
theorem positiveEntrySpan_le_iff {n : ℕ} {p : Submodule ℤ (MilnorK R)} :
    positiveEntrySpan R n ≤ p ↔
      ∀ l : List Rˣ, l.length = n → (∃ a ∈ l, 0 < (a : R)) → symbol l ∈ p := by
  rw [positiveEntrySpan_def, Submodule.span_le, Set.image_subset_iff]
  exact ⟨fun h l hl hpos ↦ h ⟨hl, hpos⟩, fun h l hl ↦ h l hl.1 hl.2⟩

omit [IsStrictOrderedRing R] in
theorem symbol_mem_positiveEntrySpan {l : List Rˣ} (h : ∃ a ∈ l, 0 < (a : R)) :
    symbol l ∈ positiveEntrySpan R l.length :=
  Submodule.subset_span ⟨l, ⟨rfl, h⟩, rfl⟩

omit [IsStrictOrderedRing R] in
variable (R) in
theorem positiveEntrySpan_le_degree (n : ℕ) : positiveEntrySpan R n ≤ degree R n :=
  positiveEntrySpan_le_iff.2 fun l hl _ ↦ hl ▸ symbol_mem_degree l

/-- The sign polynomial vanishes on the positive-entry span. -/
theorem signPolynomial_eq_zero_of_mem_positiveEntrySpan {n : ℕ} {x : MilnorK R}
    (hx : x ∈ positiveEntrySpan R n) : signPolynomial R x = 0 := by
  refine positiveEntrySpan_le_iff (p := LinearMap.ker (signPolynomial R).toIntAlgHom.toLinearMap)
    |>.2 (fun l _ ⟨a, ha, hpos⟩ ↦ ?_) hx
  have hneg : ¬∀ b ∈ l, (b : R) < 0 := fun h ↦ (h a ha).not_gt hpos
  simp [hneg]

theorem sign_eq_zero_of_mem_positiveEntrySpan (m : ℕ) {n : ℕ} {x : MilnorK R}
    (hx : x ∈ positiveEntrySpan R n) : sign R m x = 0 := by
  rw [sign_apply, signPolynomial_eq_zero_of_mem_positiveEntrySpan hx, coeff_zero]

/-- The symbol `{-1, …, -1}` lies in no positive-entry span: its sign is `1`. -/
theorem ofUnit_neg_one_pow_notMem_positiveEntrySpan (n m : ℕ) :
    ofUnit (-1 : Rˣ) ^ n ∉ positiveEntrySpan R m := fun h ↦ by
  simpa using sign_eq_zero_of_mem_positiveEntrySpan n h

omit [IsStrictOrderedRing R] in
/-- Left multiplication by `K_iᴹ(R)` maps `Dⱼ` into `D_{i+j}`. -/
theorem mul_mem_positiveEntrySpan_left {i j : ℕ} {x y : MilnorK R} (hx : x ∈ degree R i)
    (hy : y ∈ positiveEntrySpan R j) : x * y ∈ positiveEntrySpan R (i + j) := by
  refine (?_ : degree R i * positiveEntrySpan R j ≤ _) (Submodule.mul_mem_mul hx hy)
  rw [degree_eq_span, positiveEntrySpan_def, Submodule.span_mul_span, Submodule.span_le]
  rintro _ ⟨_, ⟨l₁, hl₁, rfl⟩, _, ⟨l₂, ⟨hl₂, a, ha, hpos⟩, rfl⟩, rfl⟩
  dsimp only
  rw [← symbol_append]
  exact Submodule.subset_span
    ⟨l₁ ++ l₂, ⟨by rw [List.length_append, hl₁, hl₂], a, List.mem_append_right l₁ ha, hpos⟩, rfl⟩

omit [IsStrictOrderedRing R] in
/-- Right multiplication by `K_jᴹ(R)` maps `Dᵢ` into `D_{i+j}`. -/
theorem mul_mem_positiveEntrySpan_right {i j : ℕ} {x y : MilnorK R}
    (hx : x ∈ positiveEntrySpan R i) (hy : y ∈ degree R j) :
    x * y ∈ positiveEntrySpan R (i + j) := by
  refine (?_ : positiveEntrySpan R i * degree R j ≤ _) (Submodule.mul_mem_mul hx hy)
  rw [degree_eq_span, positiveEntrySpan_def, Submodule.span_mul_span, Submodule.span_le]
  rintro _ ⟨_, ⟨l₁, ⟨hl₁, a, ha, hpos⟩, rfl⟩, _, ⟨l₂, hl₂, rfl⟩, rfl⟩
  dsimp only
  rw [← symbol_append]
  exact Submodule.subset_span
    ⟨l₁ ++ l₂, ⟨by rw [List.length_append, hl₁, hl₂], a, List.mem_append_left l₂ ha, hpos⟩, rfl⟩

/-- Every symbol is congruent modulo the positive-entry span to `{-1, …, -1}` if all its entries
are negative, and to `0` otherwise. -/
theorem symbol_sub_mem_positiveEntrySpan (l : List Rˣ) :
    symbol l - (if ∀ a ∈ l, (a : R) < 0 then ofUnit (-1 : Rˣ) ^ l.length else 0) ∈
      positiveEntrySpan R l.length := by
  induction l with
  | nil => simp
  | cons a l ih =>
    rcases (Units.ne_zero a).lt_or_gt with ha | ha
    · -- Write `a = (-1) * (-a)`: then `{a, l} = {-1} {l} + {-a, l}`, where `-a > 0`.
      have hpos : 0 < ((-a : Rˣ) : R) := by simpa using ha
      have hsplit : symbol (a :: l) = ofUnit (-1) * symbol l + symbol ((-a) :: l) := by
        rw [symbol_cons, symbol_cons, ← add_mul, ofUnit_neg_one_add_ofUnit_neg]
      have h₁ := mul_mem_positiveEntrySpan_left (ofUnit_mem_degree_one (-1)) ih
      have h₂ := symbol_mem_positiveEntrySpan (l := (-a) :: l) ⟨-a, List.mem_cons_self, hpos⟩
      rw [Nat.add_comm 1] at h₁
      rw [List.length_cons] at h₂ ⊢
      convert add_mem h₁ h₂ using 1
      rw [hsplit]
      by_cases hl : ∀ b ∈ l, (b : R) < 0
      · rw [ite_eq_left (List.forall_mem_cons (p := fun b : Rˣ ↦ (b : R) < 0) |>.2 ⟨ha, hl⟩),
          ite_eq_left hl, pow_succ', mul_sub]
        abel
      · rw [ite_eq_right fun h ↦ hl (List.forall_mem_cons.1 h).2, ite_eq_right hl, sub_zero,
          sub_zero]
    · simpa [ha.not_gt] using
        symbol_mem_positiveEntrySpan (l := a :: l) ⟨a, List.mem_cons_self, ha⟩

/-! ### The splitting -/

omit [LinearOrder R] [IsStrictOrderedRing R] in
/-- For `n ≠ 0`, the homomorphism `ZMod 2 →+ MilnorK R` sending `1` to `{-1, …, -1}`, well
defined since `{-1, …, -1}` is killed by `2`. -/
private def signSection {n : ℕ} (hn : n ≠ 0) : ZMod 2 →+ MilnorK R :=
  ZMod.lift 2 ⟨zmultiplesHom _ (ofUnit (-1 : Rˣ) ^ n), by
    simpa [two_zsmul, ← two_nsmul] using two_nsmul_ofUnit_neg_one_pow (R := R) hn⟩

omit [LinearOrder R] [IsStrictOrderedRing R] in
private theorem signSection_apply {n : ℕ} (hn : n ≠ 0) (ε : ZMod 2) :
    signSection (R := R) hn ε = ε.val • ofUnit (-1 : Rˣ) ^ n := by
  conv_lhs => rw [← ZMod.natCast_zmod_val ε, ← Int.cast_natCast]
  rw [signSection, ZMod.lift_coe, zmultiplesHom_apply, natCast_zsmul]

omit [LinearOrder R] [IsStrictOrderedRing R] in
private theorem signSection_mem_degree {n : ℕ} (hn : n ≠ 0) (ε : ZMod 2) :
    signSection (R := R) hn ε ∈ degree R n := by
  rw [signSection_apply]
  exact Submodule.smul_of_tower_mem _ _ (ofUnit_pow_mem_degree _ n)

private theorem sign_signSection {n : ℕ} (hn : n ≠ 0) (ε : ZMod 2) :
    sign R n (signSection hn ε) = ε := by
  rw [signSection_apply, map_nsmul, ← symbol_replicate, sign_symbol]
  simp

/-- An element of `K_nᴹ(R)` is congruent modulo the positive-entry span to the multiple of
`{-1, …, -1}` given by its sign. -/
private theorem sub_signSection_mem_positiveEntrySpan {n : ℕ} (hn : n ≠ 0) {x : MilnorK R}
    (hx : x ∈ degree R n) : x - signSection hn (sign R n x) ∈ positiveEntrySpan R n := by
  rw [degree_eq_span] at hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, rfl, rfl⟩ := hx
    convert symbol_sub_mem_positiveEntrySpan l using 2
    by_cases hl : ∀ a ∈ l, (a : R) < 0
    · simp [eq_true hl, signSection_apply, ZMod.val_one'' (n := 2) (by decide)]
    · simp [eq_false hl, signSection_apply]
  | zero => simp
  | add x y _ _ hx hy =>
    convert add_mem hx hy using 1
    rw [map_add, map_add]
    abel
  | smul z x _ hx =>
    convert Submodule.smul_mem _ z hx using 1
    rw [map_zsmul, map_zsmul, smul_sub]

/-- **The kernel of the sign map on `K_nᴹ(R)` is the positive-entry span**, for `n ≠ 0`. -/
theorem sign_eq_zero_iff {n : ℕ} (hn : n ≠ 0) {x : MilnorK R} (hx : x ∈ degree R n) :
    sign R n x = 0 ↔ x ∈ positiveEntrySpan R n := by
  refine ⟨fun h ↦ ?_, sign_eq_zero_of_mem_positiveEntrySpan n⟩
  -- Modulo the span, `x` is congruent to `signSection (sign x)`, which is zero here.
  simpa [h] using sub_signSection_mem_positiveEntrySpan hn hx

theorem ker_sign_comp_subtype {n : ℕ} (hn : n ≠ 0) :
    ((sign R n).comp (degree R n).subtype.toAddMonoidHom).ker =
      ((positiveEntrySpan R n).comap (degree R n).subtype).toAddSubgroup := by
  ext x
  exact sign_eq_zero_iff hn x.property

variable (R) in
/-- **The splitting of the Milnor K-group `K_nᴹ(R)` of a linearly ordered commutative ring**, for
`n ≠ 0`: every class is uniquely `ε • {-1, …, -1} + d` with `ε ∈ ZMod 2` and `d` in the
positive-entry span. The first component is the sign map. -/
def positiveEntryEquiv {n : ℕ} (hn : n ≠ 0) :
    degree R n ≃ₗ[ℤ] ZMod 2 × positiveEntrySpan R n :=
  AddEquiv.toIntLinearEquiv
    { toFun x := (sign R n x, ⟨(x : MilnorK R) - signSection hn (sign R n x),
        (sign_eq_zero_iff hn (sub_mem x.property (signSection_mem_degree hn _))).1
          (by rw [map_sub, sign_signSection, sub_self])⟩)
      invFun p := ⟨signSection hn p.1 + (p.2 : MilnorK R),
        add_mem (signSection_mem_degree hn _) (positiveEntrySpan_le_degree R n p.2.property)⟩
      left_inv x := Subtype.ext (add_sub_cancel _ _)
      right_inv p := by
        obtain ⟨ε, d, hd⟩ := p
        ext
        · simp [sign_signSection, sign_eq_zero_of_mem_positiveEntrySpan n hd]
        · simp [sign_signSection, sign_eq_zero_of_mem_positiveEntrySpan n hd]
      map_add' x y := by
        ext
        · simp
        · simp only [Submodule.coe_add, map_add, Prod.snd_add]
          abel }

@[simp]
theorem positiveEntryEquiv_apply_fst {n : ℕ} (hn : n ≠ 0) (x : degree R n) :
    (positiveEntryEquiv R hn x).1 = sign R n x :=
  (rfl)

@[simp]
theorem coe_positiveEntryEquiv_apply_snd {n : ℕ} (hn : n ≠ 0) (x : degree R n) :
    ((positiveEntryEquiv R hn x).2 : MilnorK R) =
      x - (sign R n x).val • ofUnit (-1 : Rˣ) ^ n :=
  congrArg ((x : MilnorK R) - ·) (signSection_apply hn _)

@[simp]
theorem coe_positiveEntryEquiv_symm_apply {n : ℕ} (hn : n ≠ 0) (ε : ZMod 2)
    (d : positiveEntrySpan R n) :
    ((positiveEntryEquiv R hn).symm (ε, d) : MilnorK R) = ε.val • ofUnit (-1 : Rˣ) ^ n + d :=
  congrArg (· + (d : MilnorK R)) (signSection_apply hn ε)

/-- The splitting sends `{-1, …, -1}` to `(1, 0)`. -/
@[simp]
theorem positiveEntryEquiv_ofUnit_neg_one_pow {n : ℕ} (hn : n ≠ 0) :
    positiveEntryEquiv R hn ⟨ofUnit (-1 : Rˣ) ^ n, ofUnit_pow_mem_degree _ n⟩ = (1, 0) := by
  rw [← LinearEquiv.eq_symm_apply]
  ext
  simp [ZMod.val_one'' (n := 2) (by decide)]

/-- The splitting sends an element `d` of the positive-entry span to `(0, d)`. -/
@[simp]
theorem positiveEntryEquiv_inclusion {n : ℕ} (hn : n ≠ 0) (d : positiveEntrySpan R n) :
    positiveEntryEquiv R hn (Submodule.inclusion (positiveEntrySpan_le_degree R n) d) = (0, d) := by
  rw [← LinearEquiv.eq_symm_apply]
  ext
  simp

/-! ### The Milnor K-ring modulo two -/

/-- The sign polynomial, descended to the Milnor K-ring modulo two. -/
private def modTwoToPolynomial : ModTwo R →+* (ZMod 2)[X] :=
  ModTwo.lift (signPolynomial R) <| by
    rw [map_ofNat]
    exact CharTwo.two_eq_zero

private theorem modTwoToPolynomial_mk (x : MilnorK R) :
    modTwoToPolynomial (ModTwo.mk x) = signPolynomial R x :=
  ModTwo.lift_mk _ _ x

/-- The ring homomorphism `(ZMod 2)[X] →+* K_*ᴹ(R) / 2` sending `X` to the class of `{-1}`. -/
private def polynomialToModTwo : (ZMod 2)[X] →+* ModTwo R :=
  eval₂RingHom' (ZMod.castHom (dvd_refl 2) _) (ModTwo.mk (ofUnit (-1))) fun a ↦ by
    rw [ZMod.castHom_apply, ZMod.cast_eq_val]
    exact Nat.cast_commute _ _

/-- If every positive unit is a square, then modulo two the class of `{a}` is the class of
`{-1}` when `a < 0` and is zero when `a > 0`. -/
private theorem ModTwo.mk_ofUnit (hsq : ∀ a : Rˣ, 0 < (a : R) → IsSquare a) (a : Rˣ) :
    ModTwo.mk (ofUnit a) = if (a : R) < 0 then ModTwo.mk (ofUnit (-1)) else 0 := by
  -- A positive unit is the square of a unit, so its class is twice another class.
  have hpos (b : Rˣ) (hb : 0 < (b : R)) : ModTwo.mk (ofUnit b) = 0 := by
    obtain ⟨c, rfl⟩ := hsq b hb
    rw [ofUnit_mul, ← two_mul, map_mul, map_ofNat, ModTwo.two_eq_zero, zero_mul]
  split_ifs with ha
  · have hneg : 0 < ((-a : Rˣ) : R) := by simpa using ha
    rw [← ofUnit_neg_one_add_ofUnit_neg a, map_add, hpos _ hneg, add_zero]
  · exact hpos a (lt_of_le_of_ne (not_lt.1 ha) (Units.ne_zero a).symm)

private theorem modTwoToPolynomial_comp_polynomialToModTwo :
    (modTwoToPolynomial (R := R)).comp polynomialToModTwo = RingHom.id (ZMod 2)[X] := by
  refine ringHom_ext' (RingHom.ext_zmod _ _) ?_
  simp [polynomialToModTwo, modTwoToPolynomial_mk]

private theorem polynomialToModTwo_comp_modTwoToPolynomial
    (hsq : ∀ a : Rˣ, 0 < (a : R) → IsSquare a) :
    (polynomialToModTwo (R := R)).comp modTwoToPolynomial = RingHom.id _ := by
  refine ModTwo.ringHom_ext fun a ↦ ?_
  simp only [RingHom.comp_apply, RingHom.id_apply, modTwoToPolynomial_mk, signPolynomial_ofUnit]
  rw [ModTwo.mk_ofUnit hsq]
  split_ifs <;> simp [polynomialToModTwo]

variable (R) in
/-- **The Milnor K-ring modulo two of a linearly ordered commutative ring in which every positive
unit is the square of a unit**, such as `ℤ` or a real closed field, is the polynomial ring
`(ZMod 2)[X]`: the sign polynomial induces a ring isomorphism `K_*ᴹ(R) / 2 ≃+* (ZMod 2)[X]`
sending the class of `{-1}` to `X`. -/
def modTwoEquiv (hsq : ∀ a : Rˣ, 0 < (a : R) → IsSquare a) : ModTwo R ≃+* (ZMod 2)[X] :=
  RingEquiv.ofRingHom modTwoToPolynomial polynomialToModTwo
    modTwoToPolynomial_comp_polynomialToModTwo
    (polynomialToModTwo_comp_modTwoToPolynomial hsq)

@[simp]
theorem modTwoEquiv_mk (hsq : ∀ a : Rˣ, 0 < (a : R) → IsSquare a) (x : MilnorK R) :
    modTwoEquiv R hsq (ModTwo.mk x) = signPolynomial R x :=
  modTwoToPolynomial_mk x

@[simp]
theorem modTwoEquiv_symm_X (hsq : ∀ a : Rˣ, 0 < (a : R) → IsSquare a) :
    (modTwoEquiv R hsq).symm X = ModTwo.mk (ofUnit (-1)) := by
  rw [RingEquiv.symm_apply_eq, modTwoEquiv_mk, signPolynomial_ofUnit]
  simp

/-! ### Divisibility over a real closed field -/

section RealClosed

variable {F : Type*} [Field F] [LinearOrder F] [IsStrictOrderedRing F] [IsRealClosed F]

/-- Over a real closed field, a symbol with a positive entry is an `m`-th multiple of a symbol of
the same length with a positive entry, for every `m ≠ 0`: the positive entry is the `m`-th power
of a positive element. -/
private theorem exists_mem_positiveEntrySpan_nsmul_eq_symbol {m : ℕ}
    (hm : m ≠ 0) {l : List Fˣ} (h : ∃ a ∈ l, 0 < (a : F)) :
    ∃ z ∈ positiveEntrySpan F l.length, m • z = symbol l := by
  obtain ⟨a, ha, hpos⟩ := h
  obtain ⟨l₁, l₂, rfl⟩ := List.append_of_mem ha
  obtain ⟨r, hr, hra⟩ := IsRealClosed.exists_pos_pow_eq_of_pos hpos hm
  obtain rfl : Units.mk0 r hr.ne' ^ m = a := Units.ext (by simpa using hra)
  refine ⟨symbol (l₁ ++ Units.mk0 r hr.ne' :: l₂), ?_, ?_⟩
  · simpa using symbol_mem_positiveEntrySpan (l := l₁ ++ Units.mk0 r hr.ne' :: l₂)
      ⟨Units.mk0 r hr.ne', by simp, hr⟩
  · exact (symbol_append_cons_pow l₁ l₂ _ m).symm

/-- **The positive-entry span is divisible** over a real closed field such as `ℝ`: multiplication
by every `m ≠ 0` is surjective on it. -/
theorem positiveEntrySpan_nsmul_right_surjective (n : ℕ) {m : ℕ} (hm : m ≠ 0) :
    Function.Surjective fun d : positiveEntrySpan F n ↦ m • d := by
  rintro ⟨x, hx⟩
  suffices h : ∃ z ∈ positiveEntrySpan F n, m • z = x by
    obtain ⟨z, hz, rfl⟩ := h
    exact ⟨⟨z, hz⟩, rfl⟩
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, ⟨rfl, h⟩, rfl⟩ := hx
    exact exists_mem_positiveEntrySpan_nsmul_eq_symbol hm h
  | zero => exact ⟨0, zero_mem _, smul_zero m⟩
  | add a b _ _ ha hb =>
    obtain ⟨z, hz, rfl⟩ := ha
    obtain ⟨w, hw, rfl⟩ := hb
    exact ⟨z + w, add_mem hz hw, smul_add m z w⟩
  | smul k a _ ha =>
    obtain ⟨z, hz, rfl⟩ := ha
    exact ⟨k • z, Submodule.smul_mem _ k hz, (smul_comm k m z).symm⟩

end RealClosed

