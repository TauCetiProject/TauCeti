module

public import Mathlib.FieldTheory.RatFunc.Basic
public import TauCeti.RingTheory.MilnorK.Basic
import Mathlib.FieldTheory.RatFunc.AsPolynomial

/-!
# The polynomial filtration of Milnor K-groups of a rational function field

Let `F` be a field and `F(t) = RatFunc F`. For natural numbers `n` and `d`, let
`L_d = TauCeti.MilnorK.polynomialFiltration F n d` be the subgroup of `K_nᴹ(F(t))` generated by
the symbols `{f₁, …, fₙ}` whose entries are nonzero polynomials of degree at most `d`. These
subgroups form an increasing filtration of `K_nᴹ(F(t))`, which is Milnor's induction on the degree
behind the exact sequence `0 → K_nᴹ(F) → K_nᴹ(F(t)) → ⊕_π K_{n-1}ᴹ(F[t]/π) → 0`: its bottom step
is the image of `K_nᴹ(F)`, and each step up adds only symbols with a single monic irreducible entry
of the new top degree.

For two distinct monic polynomials `e₁, e₂` of the same degree `d`, the difference `h = e₁ - e₂` is
a nonzero polynomial of degree less than `d`, and
`{e₁, e₂} = {h, e₂} - {h, e₁} + {e₁, -1}` (`TauCeti.MilnorK.ofUnit_mul_ofUnit_eq_of_sub_eq`).
Together with `{e, e} = {e, -1}`, unique factorization and graded commutativity, this shows that
modulo `L_d` the group `L_{d+1}` is generated by the symbols `{a₁, …, a_{n-1}, π}` with `π` monic
irreducible of degree `d + 1` and every `aᵢ` a polynomial of degree at most `d`. The monic
irreducible entry is placed last, matching residues taken with the uniformizer in the last slot.

The analogue of this statement in the source, Weibel's Exercise III.6.2, admits only `e₁` as an
entry of top degree and is false as printed; the identity above is what the proof of Weibel's
Lemma III.7.4.2 actually uses.

## Main definitions

* `TauCeti.MilnorK.polynomialFiltration F n d`: the subgroup `L_d` of `K_nᴹ(F(t))` generated by
  the symbols of `n` nonzero polynomials of degree at most `d`.

## Main results

* `TauCeti.MilnorK.polynomialFiltration_mono`, `TauCeti.MilnorK.polynomialFiltration_le_degree`:
  the `L_d` increase with `d` and lie in `K_nᴹ(F(t))`.
* `TauCeti.MilnorK.iSup_polynomialFiltration`: the `L_d` exhaust `K_nᴹ(F(t))`.
* `TauCeti.MilnorK.polynomialFiltration_zero`: `L_0` is the image of `K_nᴹ(F)`.
* `TauCeti.MilnorK.polynomialFiltration_succ`: `L_{d+1}` is generated by `L_d` together with the
  symbols `{a₁, …, aₙ, π}` with `π` monic irreducible of degree `d + 1` and every `aᵢ` a nonzero
  polynomial of degree at most `d`.

## References

* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter III, Lemma 6.1.4, Exercise 6.2, and Lemma 7.4.2 with its
  proof.
* J. Milnor, *Algebraic K-theory and quadratic forms*, Invent. Math. 9 (1970), 318–344, §2.
-/

public section

noncomputable section

open Polynomial

namespace TauCeti

namespace MilnorK

variable (F : Type*) [Field F]

/-- The **polynomial filtration** `L_d` of the Milnor K-group `K_nᴹ(F(t))` of the rational
function field `F(t) = RatFunc F`: the subgroup generated by the symbols `{f₁, …, fₙ}` whose
entries are nonzero polynomials of degree at most `d`. -/
def polynomialFiltration (n d : ℕ) : Submodule ℤ (MilnorK (RatFunc F)) :=
  Submodule.span ℤ (symbol '' {l : List (RatFunc F)ˣ | l.length = n ∧
    ∀ u ∈ l, ∃ p : F[X], p.natDegree ≤ d ∧ algebraMap F[X] (RatFunc F) p = u})

variable {F}

/-- A symbol of `n` nonzero polynomials of degree at most `d` lies in `L_d`. -/
theorem symbol_mem_polynomialFiltration {n d : ℕ} {l : List (RatFunc F)ˣ} (hl : l.length = n)
    (h : ∀ u ∈ l, ∃ p : F[X], p.natDegree ≤ d ∧ algebraMap F[X] (RatFunc F) p = u) :
    symbol l ∈ polynomialFiltration F n d :=
  Submodule.subset_span ⟨l, ⟨hl, h⟩, rfl⟩

/-- The polynomial filtration is increasing: `L_d ≤ L_e` for `d ≤ e`. -/
theorem polynomialFiltration_mono (n : ℕ) : Monotone (polynomialFiltration F n) :=
  fun _ _ hd ↦ Submodule.span_mono <| Set.image_mono fun _ hl ↦
    ⟨hl.1, fun u hu ↦ (hl.2 u hu).imp fun _ hp ↦ ⟨hp.1.trans hd, hp.2⟩⟩

/-- Each `L_d` is a subgroup of the Milnor K-group `K_nᴹ(F(t))`. -/
theorem polynomialFiltration_le_degree (n d : ℕ) :
    polynomialFiltration F n d ≤ degree (RatFunc F) n := by
  rw [degree_eq_span]
  exact Submodule.span_mono <| Set.image_mono fun _ hl ↦ hl.1

/-- The units of `F(t)` that are polynomials of degree at most `d`. -/
private def polyUnits (d : ℕ) : Set (RatFunc F)ˣ :=
  {u | ∃ p : F[X], p.natDegree ≤ d ∧ algebraMap F[X] (RatFunc F) p = u}

/-- The units of `F(t)` that are monic irreducible polynomials of degree `d`. -/
private def monicIrreducibleUnits (d : ℕ) : Set (RatFunc F)ˣ :=
  {u | ∃ π : F[X], π.Monic ∧ Irreducible π ∧ π.natDegree = d ∧ algebraMap F[X] (RatFunc F) π = u}

/-- The unit of `F(t)` given by a nonzero polynomial. -/
private def polyUnit (p : F[X]) (hp : p ≠ 0) : (RatFunc F)ˣ :=
  Units.mk0 (algebraMap F[X] (RatFunc F) p) (RatFunc.algebraMap_ne_zero hp)

private theorem polyUnit_mem_polyUnits {p : F[X]} (hp : p ≠ 0) {d : ℕ} (hd : p.natDegree ≤ d) :
    polyUnit p hp ∈ polyUnits d :=
  ⟨p, hd, rfl⟩

private theorem ofUnit_mem_span_polyUnits {d : ℕ} {u : (RatFunc F)ˣ} (hu : u ∈ polyUnits d) :
    ofUnit u ∈ Submodule.span ℤ (ofUnit '' polyUnits d) :=
  Submodule.subset_span ⟨u, hu, rfl⟩

private theorem polyUnits_mono {d e : ℕ} (hde : d ≤ e) : polyUnits (F := F) d ⊆ polyUnits e :=
  fun _ ⟨p, hp, hpu⟩ ↦ ⟨p, hp.trans hde, hpu⟩

private theorem neg_one_mem_polyUnits (d : ℕ) : (-1 : (RatFunc F)ˣ) ∈ polyUnits d :=
  ⟨-1, by simp, by simp⟩

/-- The polynomial behind a unit of `F(t)` is nonzero. -/
private theorem ne_zero_of_algebraMap_eq {p : F[X]} {u : (RatFunc F)ˣ}
    (hpu : algebraMap F[X] (RatFunc F) p = u) : p ≠ 0 := by
  rintro rfl
  exact u.ne_zero (by simpa using hpu.symm)

private theorem polynomialFiltration_eq_pow (n d : ℕ) :
    polynomialFiltration F n d = Submodule.span ℤ (ofUnit '' polyUnits d) ^ n :=
  span_symbol_eq_pow (polyUnits d) n

/-- A polynomial of degree `d + 1` is either a constant times a monic irreducible polynomial of
degree `d + 1`, or a product of two polynomials of degree at most `d`; so its degree-one class lies
in the span of the classes of polynomials of degree at most `d` and of monic irreducible ones of
degree `d + 1`. -/
private theorem span_polyUnits_succ (d : ℕ) :
    Submodule.span ℤ (ofUnit '' polyUnits (F := F) (d + 1)) =
      Submodule.span ℤ (ofUnit '' polyUnits d) ⊔
        Submodule.span ℤ (ofUnit '' monicIrreducibleUnits (d + 1)) := by
  refine le_antisymm (Submodule.span_le.2 ?_) (sup_le
    (Submodule.span_mono (Set.image_mono (polyUnits_mono d.le_succ)))
    (Submodule.span_mono (Set.image_mono fun _ ⟨π, _, _, hπ, hπu⟩ ↦ ⟨π, hπ.le, hπu⟩)))
  rintro _ ⟨u, ⟨p, hp, hpu⟩, rfl⟩
  have hp0 := ne_zero_of_algebraMap_eq hpu
  rcases Nat.lt_or_eq_of_le hp with hp | hp
  · exact Submodule.mem_sup_left (ofUnit_mem_span_polyUnits ⟨p, Nat.le_of_lt_succ hp, hpu⟩)
  by_cases hirr : Irreducible p
  · -- `p = c π` with `c` its leading coefficient and `π` monic irreducible of degree `d + 1`.
    have hc : p.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.2 hp0
    have hC : C p.leadingCoeff ≠ 0 := C_ne_zero.2 hc
    have hπ : p * C p.leadingCoeff⁻¹ ≠ 0 := (monic_mul_leadingCoeff_inv hp0).ne_zero
    have hu : u = polyUnit _ hC * polyUnit _ hπ := by
      ext
      simp only [polyUnit, Units.val_mul, Units.val_mk0, ← map_mul, ← hpu]
      rw [mul_left_comm, ← C_mul, mul_inv_cancel₀ hc, C_1, mul_one]
    rw [hu, ofUnit_mul]
    refine add_mem (Submodule.mem_sup_left (ofUnit_mem_span_polyUnits
      (polyUnit_mem_polyUnits hC (by simp)))) (Submodule.mem_sup_right (Submodule.subset_span
      ⟨_, ⟨_, monic_mul_leadingCoeff_inv hp0, irreducible_mul_leadingCoeff_inv.2 hirr, ?_, rfl⟩,
        rfl⟩))
    rw [natDegree_mul_C (inv_ne_zero hc), hp]
  · -- `p = a b` with `a, b` nonconstant, hence both of degree at most `d`.
    have hunit : ¬IsUnit p := fun h ↦ by simp [natDegree_eq_zero_of_isUnit h] at hp
    obtain ⟨a, b, rfl, ha, hb⟩ : ∃ a b, p = a * b ∧ ¬IsUnit a ∧ ¬IsUnit b := by
      simpa [irreducible_iff, hunit] using hirr
    have ha0 : a ≠ 0 := left_ne_zero_of_mul hp0
    have hb0 : b ≠ 0 := right_ne_zero_of_mul hp0
    have hab := natDegree_mul ha0 hb0
    have ha1 : 0 < a.natDegree := natDegree_pos_iff_degree_pos.2 <|
      lt_of_le_of_ne (zero_le_degree_iff.2 ha0) fun h ↦ ha (isUnit_iff_degree_eq_zero.2 h.symm)
    have hb1 : 0 < b.natDegree := natDegree_pos_iff_degree_pos.2 <|
      lt_of_le_of_ne (zero_le_degree_iff.2 hb0) fun h ↦ hb (isUnit_iff_degree_eq_zero.2 h.symm)
    have hu : u = polyUnit a ha0 * polyUnit b hb0 := by
      ext
      simp [polyUnit, ← hpu]
    rw [hu, ofUnit_mul]
    exact Submodule.mem_sup_left (add_mem
      (ofUnit_mem_span_polyUnits (polyUnit_mem_polyUnits ha0 (by omega)))
      (ofUnit_mem_span_polyUnits (polyUnit_mem_polyUnits hb0 (by omega))))

/-- Modulo the classes of polynomials of degree at most `d`, a class of a monic irreducible
polynomial of degree `d + 1` can be moved to the right of a class of a polynomial of degree at
most `d`. -/
private theorem span_monicIrreducibleUnits_mul_le (d : ℕ) :
    Submodule.span ℤ (ofUnit '' monicIrreducibleUnits (F := F) (d + 1)) *
        Submodule.span ℤ (ofUnit '' polyUnits d) ≤
      Submodule.span ℤ (ofUnit '' polyUnits d) *
        Submodule.span ℤ (ofUnit '' monicIrreducibleUnits (d + 1)) := by
  rw [Submodule.span_mul_span, Submodule.span_le]
  rintro _ ⟨_, ⟨v, hv, rfl⟩, _, ⟨u, hu, rfl⟩, rfl⟩
  dsimp only
  rw [ofUnit_mul_ofUnit_comm]
  exact neg_mem (Submodule.mul_mem_mul (Submodule.subset_span ⟨u, hu, rfl⟩)
    (Submodule.subset_span ⟨v, hv, rfl⟩))

/-- The product of the classes of two monic irreducible polynomials of degree `d + 1` is a sum of
products of a class of a polynomial of degree at most `d` with a class of a monic irreducible
polynomial of degree `d + 1`: use `{e, e} = {e, -1}` for equal entries, and
`{e₁, e₂} = {h, e₂} - {h, e₁} + {e₁, -1}` with `h = e₁ - e₂` for distinct ones. -/
private theorem span_monicIrreducibleUnits_mul_self_le (d : ℕ) :
    Submodule.span ℤ (ofUnit '' monicIrreducibleUnits (F := F) (d + 1)) *
        Submodule.span ℤ (ofUnit '' monicIrreducibleUnits (d + 1)) ≤
      Submodule.span ℤ (ofUnit '' polyUnits d) *
        Submodule.span ℤ (ofUnit '' monicIrreducibleUnits (d + 1)) := by
  rw [Submodule.span_mul_span, Submodule.span_le]
  rintro _ ⟨_, ⟨u₁, hu₁, rfl⟩, _, ⟨u₂, hu₂, rfl⟩, rfl⟩
  dsimp only
  have hmem {v w : (RatFunc F)ˣ} (hv : v ∈ polyUnits d) (hw : w ∈ monicIrreducibleUnits (d + 1)) :
      ofUnit v * ofUnit w ∈ Submodule.span ℤ (ofUnit '' polyUnits d) *
        Submodule.span ℤ (ofUnit '' monicIrreducibleUnits (d + 1)) :=
    Submodule.mul_mem_mul (Submodule.subset_span ⟨v, hv, rfl⟩) (Submodule.subset_span ⟨w, hw, rfl⟩)
  have hneg {w : (RatFunc F)ˣ} (hw : w ∈ monicIrreducibleUnits (d + 1)) :
      ofUnit w * ofUnit (-1) ∈ Submodule.span ℤ (ofUnit '' polyUnits d) *
        Submodule.span ℤ (ofUnit '' monicIrreducibleUnits (d + 1)) := by
    rw [ofUnit_mul_ofUnit_comm]
    exact neg_mem (hmem (neg_one_mem_polyUnits d) hw)
  by_cases h₁₂ : u₁ = u₂
  · subst h₁₂
    rw [ofUnit_mul_ofUnit_self]
    exact hneg hu₁
  obtain ⟨π₁, hm₁, hi₁, hd₁, hπ₁⟩ := hu₁
  obtain ⟨π₂, hm₂, hi₂, hd₂, hπ₂⟩ := hu₂
  have hπ : π₁ - π₂ ≠ 0 := sub_ne_zero.2 fun h ↦ h₁₂ (Units.ext (by rw [← hπ₁, ← hπ₂, h]))
  have hdeg : (π₁ - π₂).natDegree ≤ d := by
    have hlt := natDegree_lt_natDegree hπ (degree_sub_lt_left
      (by rw [degree_eq_natDegree hm₁.ne_zero, degree_eq_natDegree hm₂.ne_zero, hd₁, hd₂])
      hm₁.ne_zero
      (by rw [hm₁.leadingCoeff, hm₂.leadingCoeff]))
    omega
  have hsub : (u₁ : RatFunc F) - u₂ = polyUnit _ hπ := by
    simp [polyUnit, ← hπ₁, ← hπ₂]
  rw [ofUnit_mul_ofUnit_eq_of_sub_eq hsub]
  exact add_mem (sub_mem (hmem (polyUnit_mem_polyUnits hπ hdeg) ⟨π₂, hm₂, hi₂, hd₂, hπ₂⟩)
    (hmem (polyUnit_mem_polyUnits hπ hdeg) ⟨π₁, hm₁, hi₁, hd₁, hπ₁⟩))
    (hneg ⟨π₁, hm₁, hi₁, hd₁, hπ₁⟩)

/-- The polynomial filtration exhausts `K_nᴹ(F(t))`: every rational function is a quotient of two
polynomials, so every symbol lies in some `L_d`. -/
theorem iSup_polynomialFiltration (n : ℕ) :
    ⨆ d, polynomialFiltration F n d = degree (RatFunc F) n := by
  refine le_antisymm (iSup_le (polynomialFiltration_le_degree n)) ?_
  have key (l : List (RatFunc F)ˣ) : ∃ D, ∀ d, D ≤ d →
      symbol l ∈ Submodule.span ℤ (ofUnit '' polyUnits d) ^ l.length := by
    induction l with
    | nil => exact ⟨0, fun _ _ ↦ by simp⟩
    | cons a l ih =>
      obtain ⟨D, hD⟩ := ih
      have hnum : (a : RatFunc F).num ≠ 0 := RatFunc.num_ne_zero a.ne_zero
      have ha : a = polyUnit _ hnum / polyUnit _ (a : RatFunc F).denom_ne_zero := by
        ext
        simp [polyUnit, RatFunc.num_div_denom]
      refine ⟨max D (max (a : RatFunc F).num.natDegree (a : RatFunc F).denom.natDegree),
        fun d hd ↦ ?_⟩
      rw [symbol_cons, List.length_cons, pow_succ']
      refine Submodule.mul_mem_mul ?_ (hD d (le_of_max_le_left hd))
      rw [ha, ofUnit_div]
      exact sub_mem
        (ofUnit_mem_span_polyUnits (polyUnit_mem_polyUnits _ (by omega)))
        (ofUnit_mem_span_polyUnits (polyUnit_mem_polyUnits _ (by omega)))
  rw [degree_eq_span, Submodule.span_le]
  rintro _ ⟨l, rfl, rfl⟩
  obtain ⟨D, hD⟩ := key l
  exact Submodule.mem_iSup_of_mem D
    ((polynomialFiltration_eq_pow (F := F) l.length D).symm ▸ hD D le_rfl)

/-- The bottom step `L_0` of the polynomial filtration is the image of `K_nᴹ(F)` under the
inclusion of the constants `F → F(t)`. -/
theorem polynomialFiltration_zero (n : ℕ) :
    polynomialFiltration F n 0 =
      (degree F n).map (map (algebraMap F (RatFunc F))).toIntAlgHom.toLinearMap := by
  rw [polynomialFiltration_eq_pow, degree_eq_span_pow, Submodule.map_pow, Submodule.map_span]
  congr 2
  ext x
  simp only [Set.mem_image, Set.mem_range, exists_exists_eq_and, AlgHom.toLinearMap_apply,
    RingHom.toIntAlgHom_apply, map_ofUnit]
  constructor
  · rintro ⟨u, ⟨p, hp, hpu⟩, rfl⟩
    have hp0 := ne_zero_of_algebraMap_eq hpu
    rw [eq_C_of_natDegree_le_zero hp] at hpu hp0
    refine ⟨Units.mk0 _ (C_ne_zero.1 hp0), congrArg ofUnit (Units.ext ?_)⟩
    simpa using hpu
  · rintro ⟨v, rfl⟩
    exact ⟨_, ⟨C (v : F), by simp, by simp⟩, rfl⟩

/-- **Generation of the polynomial filtration by monic irreducible entries.** For `d : ℕ`, the
subgroup `L_{d+1}` of `K_{n+1}ᴹ(F(t))` is generated by `L_d` together with the symbols
`{a₁, …, aₙ, π}` with `π` a monic irreducible polynomial of degree `d + 1` and every `aᵢ` a nonzero
polynomial of degree at most `d` (Weibel, Exercise III.6.2 as used in the proof of
Lemma III.7.4.2). -/
theorem polynomialFiltration_succ (n d : ℕ) :
    polynomialFiltration F (n + 1) (d + 1) = polynomialFiltration F (n + 1) d ⊔
      Submodule.span ℤ (Set.image2 (fun l u ↦ symbol (l ++ [u]))
        {l : List (RatFunc F)ˣ | l.length = n ∧
          ∀ u ∈ l, ∃ p : F[X], p.natDegree ≤ d ∧ algebraMap F[X] (RatFunc F) p = u}
        {u : (RatFunc F)ˣ | ∃ π : F[X], π.Monic ∧ Irreducible π ∧ π.natDegree = d + 1 ∧
          algebraMap F[X] (RatFunc F) π = u}) := by
  set U := Submodule.span ℤ (ofUnit '' polyUnits (F := F) d)
  set V := Submodule.span ℤ (ofUnit '' monicIrreducibleUnits (F := F) (d + 1))
  have hgen : Submodule.span ℤ (Set.image2 (fun l u ↦ symbol (l ++ [u]))
      {l : List (RatFunc F)ˣ | l.length = n ∧
        ∀ u ∈ l, ∃ p : F[X], p.natDegree ≤ d ∧ algebraMap F[X] (RatFunc F) p = u}
      {u : (RatFunc F)ˣ | ∃ π : F[X], π.Monic ∧ Irreducible π ∧ π.natDegree = d + 1 ∧
        algebraMap F[X] (RatFunc F) π = u}) = U ^ n * V := by
    rw [← polynomialFiltration_eq_pow, polynomialFiltration, Submodule.span_mul_span]
    congr 1
    ext x
    simp only [Set.mem_image2, Set.mem_mul, Set.mem_image, symbol_append, symbol_singleton]
    constructor
    · rintro ⟨l, hl, u, hu, rfl⟩
      exact ⟨_, ⟨l, hl, rfl⟩, _, ⟨u, hu, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨l, hl, rfl⟩, _, ⟨u, hu, rfl⟩, rfl⟩
      exact ⟨l, hl, u, hu, rfl⟩
  -- Expanding `(U ⊔ V) ^ (m + 1)`, every product with two factors from `V` falls into `U ^ m V`.
  have key (m : ℕ) : (U ⊔ V) ^ (m + 1) ≤ U ^ (m + 1) ⊔ U ^ m * V := by
    induction m with
    | zero => simp
    | succ m ih =>
      calc (U ⊔ V) ^ (m + 2) = (U ⊔ V) ^ (m + 1) * (U ⊔ V) := pow_succ _ _
        _ ≤ (U ^ (m + 1) ⊔ U ^ m * V) * (U ⊔ V) := mul_le_mul' ih le_rfl
        _ ≤ U ^ (m + 2) ⊔ U ^ (m + 1) * V := by
          rw [Submodule.sup_mul, Submodule.mul_sup, Submodule.mul_sup]
          refine sup_le (sup_le (le_sup_of_le_left (pow_succ U (m + 1)).ge) le_sup_right)
            (sup_le (le_sup_of_le_right ?_) (le_sup_of_le_right ?_))
          · calc U ^ m * V * U = U ^ m * (V * U) := mul_assoc _ _ _
              _ ≤ U ^ m * (U * V) := mul_le_mul' le_rfl (span_monicIrreducibleUnits_mul_le d)
              _ = U ^ (m + 1) * V := by rw [← mul_assoc, ← pow_succ]
          · calc U ^ m * V * V = U ^ m * (V * V) := mul_assoc _ _ _
              _ ≤ U ^ m * (U * V) :=
                mul_le_mul' le_rfl (span_monicIrreducibleUnits_mul_self_le d)
              _ = U ^ (m + 1) * V := by rw [← mul_assoc, ← pow_succ]
  refine (polynomialFiltration_eq_pow _ _).trans ?_
  rw [span_polyUnits_succ, polynomialFiltration_eq_pow, hgen]
  refine le_antisymm (key n) (sup_le (pow_le_pow_left' le_sup_left _) ?_)
  rw [pow_succ]
  exact mul_le_mul' (pow_le_pow_left' le_sup_left _) le_sup_right

end MilnorK

end TauCeti
