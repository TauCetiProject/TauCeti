module

public import TauCeti.FieldTheory.MatsumotoGroup
public import TauCeti.RingTheory.MilnorK.Basic

/-!
# Degree two of Milnor K-theory is the Matsumoto group

For a field `F`, the degree-two Milnor K-group `K_2ᴹ(F)` (`TauCeti.MilnorK.degree F 2`) is cut out
of the tensor algebra `T(Fˣ)` by the two-sided ideal generated by the Steinberg products, while the
Matsumoto group `TauCeti.MatsumotoGroup F` is the quotient `(Fˣ ⊗ Fˣ) / ⟨x ⊗ y : x + y = 1⟩` of the
degree-two tensors alone. This file identifies the two:
`TauCeti.MilnorK.degreeTwoEquiv : MatsumotoGroup F ≃ₗ[ℤ] degree F 2` sends the Steinberg symbol
`{a, b}` to the Milnor symbol `{a, b} = {a} {b}`.

The map from the Matsumoto group is the universal property of the Matsumoto group. The inverse is
the degree-two component `TauCeti.MilnorK.toMatsumotoGroup : MilnorK F →+ MatsumotoGroup F`, which
sends `{a, b}` to `{a, b}` and kills every other homogeneous degree. It comes from the universal
property of the Milnor ring: `K_*ᴹ(F)` acts on `ℤ × Fˣ × MatsumotoGroup F`, a model of the
quotient of the Milnor ring by its elements of degree at least three, by letting `{a}` act as
`(n, u, q) ↦ (0, n a, {a, u})`. Two such operators compose to zero when `a + b = 1`, which is why
the action descends from the tensor algebra.

The identification makes the universal property of the Matsumoto group available for `K_2ᴹ(F)`:
every Steinberg pairing on `Fˣ` induces a homomorphism out of `K_2ᴹ(F)`, and so does every
homomorphism out of the Matsumoto group. As a first application, Milnor K-groups of finite fields
vanish in every degree at least two, because the Matsumoto group of a finite field is trivial.

## Main definitions

* `TauCeti.MilnorK.toMatsumotoGroup`: the degree-two component `K_*ᴹ(F) → MatsumotoGroup F`.
* `TauCeti.MilnorK.degreeTwoEquiv`: the equivalence `MatsumotoGroup F ≃ₗ[ℤ] K_2ᴹ(F)`.

## Main results

* `TauCeti.MilnorK.toMatsumotoGroup_ofUnit_mul_ofUnit`: the degree-two component of `{a} {b}` is
  the Steinberg symbol `{a, b}`.
* `TauCeti.MilnorK.toMatsumotoGroup_eq_zero_of_mem_degree`: the degree-two component vanishes on
  every other degree.
* `TauCeti.MilnorK.coe_degreeTwoEquiv_symbol`,
  `TauCeti.MilnorK.degreeTwoEquiv_symm_ofUnit_mul_ofUnit`: the equivalence and its inverse on
  symbols.
* `TauCeti.MilnorK.degree_eq_bot_of_finite`: `K_nᴹ(F) = 0` for a finite field `F` and `n ≥ 2`.

## References

* J. Milnor, *Algebraic K-theory and quadratic forms*, Invent. Math. 9 (1970), 318–344, §1.
* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Chapter III, Theorem 6.1, Definition 7.1 and Example 7.2(a).
-/

public section

noncomputable section

namespace TauCeti

namespace MilnorK

variable {F : Type*} [Field F]

/-! ### The truncated action -/

section Action

variable (F) in
/-- The additive group `ℤ × Fˣ × MatsumotoGroup F`, a model of the Milnor ring modulo its elements
of degree at least three, on which the Milnor ring acts by truncated left multiplication. -/
private abbrev Truncated : Type _ :=
  ℤ × Additive Fˣ × MatsumotoGroup F

/-- Left multiplication by the degree-one class of `a` on `Truncated F`:
`(n, u, q) ↦ (0, n a, {a, u})`. -/
private def act : Additive Fˣ →ₗ[ℤ] Module.End ℤ (Truncated F) :=
  LinearMap.mk₂ ℤ
    (fun a x ↦ ((0 : ℤ), x.1 • a, MatsumotoGroup.symbol a.toMul x.2.1.toMul))
    (fun a b x ↦ by simp [zsmul_add])
    (fun c a x ↦ by simp [smul_comm c x.1 a])
    (fun a x y ↦ by simp [add_zsmul])
    (fun c a x ↦ by simp [mul_smul])

private theorem act_apply (a : Additive Fˣ) (x : Truncated F) :
    act a x = ((0 : ℤ), x.1 • a, MatsumotoGroup.symbol a.toMul x.2.1.toMul) :=
  (rfl)

private theorem act_mul_act_of_add_eq_one {a b : Fˣ} (h : (a : F) + b = 1) :
    act (.ofMul a) * act (.ofMul b) = 0 := by
  ext x <;> simp [act_apply, MatsumotoGroup.symbol_of_add_eq_one h]

/-- The action of the Milnor ring on `Truncated F`. -/
private def actRingHom : MilnorK F →+* Module.End ℤ (Truncated F) :=
  lift act.toAddMonoidHom fun _ _ h ↦ act_mul_act_of_add_eq_one h

private theorem actRingHom_ofUnit (a : Fˣ) : actRingHom (ofUnit a) = act (.ofMul a) :=
  lift_ofUnit _ _ a

end Action

/-! ### The degree-two component -/

/-- The **degree-two component** `K_*ᴹ(F) → MatsumotoGroup F`: it sends the Milnor symbol `{a, b}`
to the Steinberg symbol `{a, b}` (`TauCeti.MilnorK.toMatsumotoGroup_ofUnit_mul_ofUnit`) and kills
every homogeneous element of degree other than two
(`TauCeti.MilnorK.toMatsumotoGroup_eq_zero_of_mem_degree`). -/
def toMatsumotoGroup : MilnorK F →+ MatsumotoGroup F where
  toFun x := (actRingHom x (1, 0, 0)).2.2
  map_zero' := by simp
  map_add' x y := by simp

/-- The degree-two component of the Milnor symbol `{a} {b}` is the Steinberg symbol `{a, b}`. -/
@[simp]
theorem toMatsumotoGroup_ofUnit_mul_ofUnit (a b : Fˣ) :
    toMatsumotoGroup (ofUnit a * ofUnit b) = MatsumotoGroup.symbol a b := by
  simp [toMatsumotoGroup, actRingHom_ofUnit, act_apply]

/-- The degree-two component of a homogeneous element of degree `n ≠ 2` is zero. -/
theorem toMatsumotoGroup_eq_zero_of_mem_degree {n : ℕ} (hn : n ≠ 2) {x : MilnorK F}
    (hx : x ∈ degree F n) : toMatsumotoGroup x = 0 := by
  rw [degree_eq_span] at hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, rfl, rfl⟩ := hx
    match l, hn with
    | [], _ => simp [toMatsumotoGroup]
    | [a], _ => simp [toMatsumotoGroup, actRingHom_ofUnit, act_apply]
    | a :: b :: c :: l, _ => simp [toMatsumotoGroup, actRingHom_ofUnit, act_apply]
  | zero => simp
  | add x y _ _ hx hy => simp [hx, hy]
  | smul r x _ hx => rw [map_zsmul, hx, smul_zero]

/-! ### The equivalence -/

/-- The Steinberg pairing `(a, b) ↦ {a} {b}` with values in the Milnor ring. -/
private def ofUnitPairing : Additive Fˣ →+ Additive Fˣ →+ MilnorK F :=
  AddMonoidHom.mk' (fun a ↦ AddMonoidHom.mk' (fun b ↦ ofUnit a.toMul * ofUnit b.toMul)
    fun b b' ↦ by simp [mul_add]) fun a a' ↦ by ext b; simp [add_mul]

private theorem ofUnitPairing_apply (a b : Additive Fˣ) :
    ofUnitPairing a b = ofUnit a.toMul * ofUnit b.toMul :=
  (rfl)

/-- The Steinberg symbols of the Matsumoto group go to the degree-two Milnor symbols. -/
private def ofMatsumotoGroup : MatsumotoGroup F →+ MilnorK F :=
  MatsumotoGroup.lift ofUnitPairing fun _ _ h ↦ by
    rw [ofUnitPairing_apply]
    exact ofUnit_mul_ofUnit_of_add_eq_one h

private theorem ofMatsumotoGroup_symbol (a b : Fˣ) :
    ofMatsumotoGroup (MatsumotoGroup.symbol a b) = ofUnit a * ofUnit b := by
  rw [ofMatsumotoGroup, MatsumotoGroup.lift_symbol, ofUnitPairing_apply, toMul_ofMul,
    toMul_ofMul]

private theorem ofMatsumotoGroup_mem_degree_two (q : MatsumotoGroup F) :
    ofMatsumotoGroup q ∈ degree F 2 := by
  induction q using MatsumotoGroup.induction_on with
  | symbol a b => simpa [ofMatsumotoGroup_symbol] using ofUnit_mul_ofUnit_mem_degree_two a b
  | add q r hq hr => simpa using add_mem hq hr

private theorem toMatsumotoGroup_ofMatsumotoGroup (q : MatsumotoGroup F) :
    toMatsumotoGroup (ofMatsumotoGroup q) = q := by
  induction q using MatsumotoGroup.induction_on with
  | symbol a b => simp [ofMatsumotoGroup_symbol]
  | add q r hq hr => simp [hq, hr]

private theorem ofMatsumotoGroup_toMatsumotoGroup {x : MilnorK F} (hx : x ∈ degree F 2) :
    ofMatsumotoGroup (toMatsumotoGroup x) = x := by
  rw [degree_eq_span] at hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, hl, rfl⟩ := hx
    obtain ⟨a, b, rfl⟩ := List.length_eq_two.1 hl
    simp [ofMatsumotoGroup_symbol]
  | zero => simp
  | add x y _ _ hx hy => simp [hx, hy]
  | smul r x _ hx => rw [map_zsmul, map_zsmul, hx]

/-- **Degree two of Milnor K-theory is the Matsumoto group**: the equivalence
`MatsumotoGroup F ≃ₗ[ℤ] K_2ᴹ(F)` sending the Steinberg symbol `{a, b}` to the Milnor symbol
`{a} {b}`. Its inverse is the degree-two component `TauCeti.MilnorK.toMatsumotoGroup`. -/
def degreeTwoEquiv : MatsumotoGroup F ≃ₗ[ℤ] degree F 2 :=
  AddEquiv.toIntLinearEquiv
    { toFun q := ⟨ofMatsumotoGroup q, ofMatsumotoGroup_mem_degree_two q⟩
      invFun x := toMatsumotoGroup x
      left_inv := toMatsumotoGroup_ofMatsumotoGroup
      right_inv x := Subtype.ext (ofMatsumotoGroup_toMatsumotoGroup x.property)
      map_add' q r := Subtype.ext (map_add ofMatsumotoGroup q r) }

/-- `TauCeti.MilnorK.degreeTwoEquiv` sends the Steinberg symbol `{a, b}` to `{a} {b}`. -/
@[simp]
theorem coe_degreeTwoEquiv_symbol (a b : Fˣ) :
    (degreeTwoEquiv (MatsumotoGroup.symbol a b) : MilnorK F) = ofUnit a * ofUnit b :=
  ofMatsumotoGroup_symbol a b

/-- The inverse of `TauCeti.MilnorK.degreeTwoEquiv` is the degree-two component. -/
@[simp]
theorem degreeTwoEquiv_symm_apply (x : degree F 2) :
    degreeTwoEquiv.symm x = toMatsumotoGroup (x : MilnorK F) :=
  (rfl)

/-- The degree-two component of `TauCeti.MilnorK.degreeTwoEquiv q` is `q`. -/
@[simp]
theorem toMatsumotoGroup_coe_degreeTwoEquiv (q : MatsumotoGroup F) :
    toMatsumotoGroup (degreeTwoEquiv q : MilnorK F) = q :=
  degreeTwoEquiv.symm_apply_apply q

/-- `TauCeti.MilnorK.degreeTwoEquiv` sends the degree-two component of `x ∈ K_2ᴹ(F)` back
to `x`. -/
@[simp]
theorem degreeTwoEquiv_toMatsumotoGroup (x : degree F 2) :
    degreeTwoEquiv (toMatsumotoGroup (x : MilnorK F)) = x :=
  degreeTwoEquiv.apply_symm_apply x

/-- The inverse of `TauCeti.MilnorK.degreeTwoEquiv` sends `{a} {b}` to the Steinberg symbol
`{a, b}`. -/
theorem degreeTwoEquiv_symm_ofUnit_mul_ofUnit (a b : Fˣ) :
    degreeTwoEquiv.symm ⟨ofUnit a * ofUnit b, ofUnit_mul_ofUnit_mem_degree_two a b⟩ =
      MatsumotoGroup.symbol a b := by
  simp

/-! ### Finite fields -/

/-- Over a finite field, the degree-one classes multiply to zero: `{a, b} = 0` in `K_2ᴹ(F)`. -/
theorem ofUnit_mul_ofUnit_eq_zero_of_finite [Finite F] (a b : Fˣ) : ofUnit a * ofUnit b = 0 := by
  rw [← coe_degreeTwoEquiv_symbol, Subsingleton.elim (MatsumotoGroup.symbol a b) 0, map_zero,
    Submodule.coe_zero]

/-- **Milnor K-groups of a finite field vanish in degrees at least two**: `K_nᴹ(F) = 0` for
`n ≥ 2` (Weibel, Example III.7.2(a)). -/
theorem degree_eq_bot_of_finite [Finite F] {n : ℕ} (hn : 2 ≤ n) : degree F n = ⊥ := by
  rw [degree_eq_span, Submodule.span_eq_bot]
  rintro _ ⟨l, rfl, rfl⟩
  obtain _ | ⟨a, _ | ⟨b, l⟩⟩ := l
  · simp at hn
  · simp at hn
  · simp [← mul_assoc, ofUnit_mul_ofUnit_eq_zero_of_finite]

end MilnorK

end TauCeti
