module

public import Mathlib.RingTheory.TwoSidedIdeal.Kernel
public import TauCeti.RingTheory.MilnorK.Homogeneous
public import TauCeti.RingTheory.MilnorK.Residue
public import TauCeti.RingTheory.Valuation.Discrete.UnitPart

/-!
# The kernel of Serre's map is generated by the principal units

Let `v : F → ℤᵐ⁰` be a valuation on a field `F` with valuation ring `𝒪_v`, maximal ideal `𝔪_v` and
residue field `k`, and let `t ∈ Fˣ` have order one. Serre's map
`d_t : K_*ᴹ(F) → L(k)` (`Valuation.serreMap`) sends `{u tⁱ}` to `{ū} + i Π`. Its kernel is
generated by the classes of the **principal units** `U¹ = 1 + 𝔪_v`
(`ValuationSubring.principalUnitGroup`):

* as a two-sided ideal, `ker d_t` is generated by the classes `{a}` with `a ∈ U¹`
  (`Valuation.ker_serreMap`);
* in each degree `n + 1`, the kernel of `d_t` on `K_{n+1}ᴹ(F)` is `U¹ · K_nᴹ(F)`, the subgroup
  spanned by the products `{a} y` with `a ∈ U¹` and `y ∈ K_nᴹ(F)`
  (`Valuation.serreMap_eq_zero_iff_of_mem_degree`). In degree one this says that
  `f ↦ ({ū}, ord_v f)` has kernel `U¹` (`Valuation.serreMap_ofUnit_eq_zero_iff`).

In particular the kernel does not depend on `t`. Writing `d_t = λ_t + ∂_v Π`, the kernel of the
specialization `λ_t` on `K_{n+1}ᴹ(F)` is `U¹ · K_nᴹ(F) + {t} · K_nᴹ(F)`
(`Valuation.milnorSpecialization_eq_zero_iff_of_mem_degree`).

## Implementation notes

The inclusion of `U¹ · K_*ᴹ(F)` in the kernel holds because `d_t{a} = {ā} = 0` for `a ∈ U¹`. For
the converse we construct a left inverse of `d_t` modulo the ideal `J` generated by the `{a}`. Two
units of `𝒪_v` with the same residue differ by a principal unit, so `ū ↦ {u}` is a well-defined
homomorphism `kˣ → K_*ᴹ(F) / J`. It satisfies the Steinberg relation because a residue relation
`ū + d = 1` lifts to `u + (1 - u) = 1`, where `1 - u` reduces to `d`. The class of `{t}` satisfies
the defining relations `Π x = σ(x) Π` and `Π Π = {-1} Π` of Serre's algebra, so the universal
property of `L(k)` gives a ring homomorphism `ψ : L(k) → K_*ᴹ(F) / J` with `ψ ∘ d_t` the quotient
map. The graded statement follows by taking homogeneous components, since `x {a} = {a} σ(x)`
shows that `J` is `U¹ · K_*ᴹ(F)`.

## Main results

* `Valuation.serreMap_ofUnit_eq_zero_iff`: `d_t{f} = 0` exactly when `f ∈ U¹`.
* `Valuation.ker_serreMap`: the kernel of `d_t` is the two-sided ideal generated by the `{a}`,
  `a ∈ U¹`.
* `Valuation.serreMap_eq_zero_iff_of_mem_degree`: on `K_{n+1}ᴹ(F)`, the kernel of `d_t` is
  `U¹ · K_nᴹ(F)`.
* `Valuation.milnorSpecialization_eq_zero_iff_of_mem_degree`: on `K_{n+1}ᴹ(F)`, the kernel of
  `λ_t` is `U¹ · K_nᴹ(F) + {t} · K_nᴹ(F)`.

## References

* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Graduate Studies in
  Mathematics 145 (2013), Exercise III.7.2 and the proof of Theorem III.7.3.
-/

public section

open TauCeti MilnorK Submodule

open scoped WithZero

namespace Valuation

variable {F : Type*} [Field F] (v : Valuation F ℤᵐ⁰) (t : Fˣ) (ht : v.ord (t : F) = 1)

/-! ### Degree one -/

/-- Serre's map vanishes on `{f}` exactly when `f` is a principal unit: the kernel of
`f ↦ ({ū}, ord_v f)` is `U¹ = 1 + 𝔪_v`. -/
theorem serreMap_ofUnit_eq_zero_iff {f : Fˣ} :
    v.serreMap t ht (ofUnit f) = 0 ↔ f ∈ v.valuationSubring.principalUnitGroup := by
  have hd : v.serreMap t ht (ofUnit f) = 0 ↔
      v.unitPartResidue t ht f = 1 ∧ v.ord (f : F) = 0 := by
    simp [SerreAlgebra.ext_iff]
  rw [hd]
  refine ⟨fun ⟨hres, hord⟩ ↦ (v.unitPartResidue_eq_one_iff_of_ord_eq_zero t ht hord).1 hres,
    fun hf ↦ ?_⟩
  have hord :=
    (v.mem_unitGroup_iff_ord_eq_zero f).1 (v.valuationSubring.principal_units_le_units hf)
  exact ⟨(v.unitPartResidue_eq_one_iff_of_ord_eq_zero t ht hord).2 hf, hord⟩

/-! ### A left inverse of Serre's map modulo the principal units -/

/-- The two-sided ideal of `K_*ᴹ(F)` generated by the classes `{a}` of principal units. -/
private abbrev principalIdeal : TwoSidedIdeal (MilnorK F) :=
  TwoSidedIdeal.span (ofUnit '' (v.valuationSubring.principalUnitGroup : Set Fˣ))

/-- The quotient map `K_*ᴹ(F) → K_*ᴹ(F) / J` by the ideal generated by the principal units. -/
private noncomputable abbrev quotMk : MilnorK F →+* (v.principalIdeal).ringCon.Quotient :=
  (v.principalIdeal).ringCon.mk'

private theorem quotMk_eq_zero_iff {x : MilnorK F} : v.quotMk x = 0 ↔ x ∈ v.principalIdeal := by
  rw [← TwoSidedIdeal.mem_ker, TwoSidedIdeal.ker_ringCon_mk']

/-- Two units of the valuation ring with the same residue have the same class modulo the
principal units. -/
private theorem quotMk_ofUnit_eq_of_residue_eq {u w : v.valuationSubring.unitGroup}
    (h : v.valuationSubring.unitGroupToResidueFieldUnits u =
      v.valuationSubring.unitGroupToResidueFieldUnits w) :
    v.quotMk (ofUnit (u : Fˣ)) = v.quotMk (ofUnit (w : Fˣ)) := by
  have hker : u * w⁻¹ ∈ v.valuationSubring.unitGroupToResidueFieldUnits.ker := by
    rw [MonoidHom.mem_ker, _root_.map_mul, _root_.map_inv, h, mul_inv_cancel]
  rw [ValuationSubring.ker_unitGroupToResidueFieldUnits, Subgroup.mem_comap] at hker
  have hJ : v.quotMk (ofUnit ((u * w⁻¹ : v.valuationSubring.unitGroup) : Fˣ)) = 0 :=
    (v.quotMk_eq_zero_iff).2 (TwoSidedIdeal.subset_span ⟨_, hker, rfl⟩)
  have hu : ((u : v.valuationSubring.unitGroup) : Fˣ) =
      (w : Fˣ) * ((u * w⁻¹ : v.valuationSubring.unitGroup) : Fˣ) := by
    simp
  rw [hu, ofUnit_mul, map_add, hJ, add_zero]

/-- A chosen unit of the valuation ring with given residue. -/
private noncomputable def residueLift (c : (IsLocalRing.ResidueField v.valuationSubring)ˣ) :
    v.valuationSubring.unitGroup :=
  Function.surjInv v.valuationSubring.surjective_unitGroupToResidueFieldUnits c

private theorem unitGroupToResidueFieldUnits_residueLift
    (c : (IsLocalRing.ResidueField v.valuationSubring)ˣ) :
    v.valuationSubring.unitGroupToResidueFieldUnits (v.residueLift c) = c :=
  Function.surjInv_eq _ c

/-- The homomorphism `kˣ → K_*ᴹ(F) / J`, `ū ↦ {u}`. -/
private noncomputable def residueUnitsHom :
    Additive (IsLocalRing.ResidueField v.valuationSubring)ˣ →+
      (v.principalIdeal).ringCon.Quotient :=
  AddMonoidHom.mk' (fun c ↦ v.quotMk (ofUnit (v.residueLift c.toMul : Fˣ))) fun c d ↦ by
    rw [← map_add, ← ofUnit_mul, ← Subgroup.coe_mul]
    exact v.quotMk_ofUnit_eq_of_residue_eq (by
      simp [unitGroupToResidueFieldUnits_residueLift])

private theorem residueUnitsHom_residue (u : v.valuationSubring.unitGroup) :
    v.residueUnitsHom (.ofMul (v.valuationSubring.unitGroupToResidueFieldUnits u)) =
      v.quotMk (ofUnit (u : Fˣ)) :=
  v.quotMk_ofUnit_eq_of_residue_eq (v.unitGroupToResidueFieldUnits_residueLift _)

/-- A residue relation `ū + d = 1` lifts to the relation `u + (1 - u) = 1` in `F`. -/
private theorem residueUnitsHom_mul_of_add_eq_one
    {c d : (IsLocalRing.ResidueField v.valuationSubring)ˣ}
    (h : (c : IsLocalRing.ResidueField v.valuationSubring) + d = 1) :
    v.residueUnitsHom (.ofMul c) * v.residueUnitsHom (.ofMul d) = 0 := by
  obtain ⟨u, rfl⟩ := v.valuationSubring.surjective_unitGroupToResidueFieldUnits c
  rw [ValuationSubring.coe_unitGroupToResidueFieldUnits_apply, ← IsLocalRing.residue_def] at h
  -- The element `1 - u` of the valuation ring reduces to `d ≠ 0`, so it is a unit.
  have hd : IsLocalRing.residue v.valuationSubring
      (1 - (v.valuationSubring.unitGroupMulEquiv u : v.valuationSubring)) = d := by
    rw [_root_.map_sub, _root_.map_one, ← h, add_sub_cancel_left]
  obtain ⟨b, hb⟩ : IsUnit (1 - (v.valuationSubring.unitGroupMulEquiv u : v.valuationSubring)) :=
    (IsLocalRing.residue_ne_zero_iff_isUnit _).1 (by rw [hd]; exact d.ne_zero)
  have hw : v.valuationSubring.unitGroupToResidueFieldUnits
      (v.valuationSubring.unitGroupMulEquiv.symm b) = d := by
    ext
    rw [ValuationSubring.coe_unitGroupToResidueFieldUnits_apply, ← IsLocalRing.residue_def,
      MulEquiv.apply_symm_apply, hb, hd]
  have hsum : ((u : Fˣ) : F) + ((v.valuationSubring.unitGroupMulEquiv.symm b : Fˣ) : F) = 1 := by
    rw [ValuationSubring.coe_unitGroupMulEquiv_symm_apply, hb,
      ← ValuationSubring.coe_unitGroupMulEquiv_apply]
    push_cast
    ring
  rw [← hw, residueUnitsHom_residue, residueUnitsHom_residue, ← _root_.map_mul,
    ofUnit_mul_ofUnit_of_add_eq_one hsum, _root_.map_zero]

/-- The ring homomorphism `K_*ᴹ(k) → K_*ᴹ(F) / J`, `{ū} ↦ {u}`. -/
private noncomputable def residueHom :
    MilnorK (IsLocalRing.ResidueField v.valuationSubring) →+*
      (v.principalIdeal).ringCon.Quotient :=
  MilnorK.lift v.residueUnitsHom fun _ _ h ↦ v.residueUnitsHom_mul_of_add_eq_one h

private theorem residueHom_ofUnit_residue (u : v.valuationSubring.unitGroup) :
    v.residueHom (ofUnit (v.valuationSubring.unitGroupToResidueFieldUnits u)) =
      v.quotMk (ofUnit (u : Fˣ)) := by
  rw [residueHom, lift_ofUnit, residueUnitsHom_residue]

private theorem residueHom_ofUnit_neg_one :
    v.residueHom (ofUnit (-1)) = v.quotMk (ofUnit (-1)) := by
  have h : v.valuationSubring.unitGroupToResidueFieldUnits
      ⟨-1, v.valuationSubring.neg_one_mem_unitGroup⟩ = -1 := by
    ext
    simp
  rw [← h, residueHom_ofUnit_residue]

/-- The class of `{t}` commutes with the image of `K_*ᴹ(k)` up to the grade involution, as `Π`
does in Serre's algebra. -/
private theorem quotMk_ofUnit_mul_residueHom (x : MilnorK (IsLocalRing.ResidueField
    v.valuationSubring)) :
    v.quotMk (ofUnit t) * v.residueHom x = v.residueHom (involute x) * v.quotMk (ofUnit t) := by
  have hx : x ∈ Submodule.span ℤ (Set.range (symbol (R := IsLocalRing.ResidueField
      v.valuationSubring))) := by
    simp [span_range_symbol]
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, rfl⟩ := hx
    induction l with
    | nil => simp
    | cons c l ih =>
      -- Write `c = ū` and move `{t}` past `{u}`, which cancels the sign from `σ{c} = -{c}`.
      obtain ⟨u, rfl⟩ := v.valuationSubring.surjective_unitGroupToResidueFieldUnits c
      have hc : v.quotMk (ofUnit t) * v.residueHom (ofUnit
          (v.valuationSubring.unitGroupToResidueFieldUnits u)) =
          -(v.residueHom (ofUnit (v.valuationSubring.unitGroupToResidueFieldUnits u)) *
            v.quotMk (ofUnit t)) := by
        rw [residueHom_ofUnit_residue, ← _root_.map_mul, ofUnit_mul_ofUnit_comm, _root_.map_neg,
          _root_.map_mul]
      rw [symbol_cons, map_mul, ← mul_assoc, hc, neg_mul, mul_assoc, ih, map_mul, map_mul,
        involute_ofUnit, _root_.map_neg]
      simp only [neg_mul, mul_assoc]
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, map_add, mul_add, hx, hy, map_add, add_mul]
  | smul r x _ hx => rw [map_zsmul, map_zsmul, mul_smul_comm, hx, map_zsmul, smul_mul_assoc]

/-- The class of `{t}` satisfies the relation `Π Π = {-1} Π` of Serre's algebra. -/
private theorem quotMk_ofUnit_mul_self :
    v.quotMk (ofUnit t) * v.quotMk (ofUnit t) =
      v.residueHom (ofUnit (-1)) * v.quotMk (ofUnit t) := by
  rw [residueHom_ofUnit_neg_one, ← map_mul, ← map_mul, ofUnit_mul_ofUnit_self,
    ofUnit_mul_ofUnit_comm, ← neg_mul, neg_ofUnit_neg_one]

/-- The ring homomorphism `L(k) → K_*ᴹ(F) / J`, `{ū} + i Π ↦ {u} + i {t}`. -/
private noncomputable def serreInverse :
    SerreAlgebra (IsLocalRing.ResidueField v.valuationSubring) →+*
      (v.principalIdeal).ringCon.Quotient :=
  SerreAlgebra.lift v.residueHom (v.quotMk (ofUnit t)) (v.quotMk_ofUnit_mul_residueHom t)
    (v.quotMk_ofUnit_mul_self t)

/-- `ψ` sends `{ū} ∈ K_*ᴹ(k)` to the class of `{u}`. -/
private theorem serreInverse_C (y : MilnorK (IsLocalRing.ResidueField v.valuationSubring)) :
    v.serreInverse t (SerreAlgebra.C y) = v.residueHom y :=
  SerreAlgebra.lift_C ..

/-- `ψ` sends `Π` to the class of `{t}`. -/
private theorem serreInverse_X : v.serreInverse t SerreAlgebra.X = v.quotMk (ofUnit t) :=
  SerreAlgebra.lift_X ..

/-- Serre's map is injective modulo the principal units: `ψ ∘ d_t` is the quotient map. -/
private theorem serreInverse_serreMap (x : MilnorK F) :
    v.serreInverse t (v.serreMap t ht x) = v.quotMk x := by
  have h : (v.serreInverse t).comp (v.serreMap t ht) = v.quotMk := by
    refine MilnorK.ringHom_ext fun f ↦ ?_
    -- Both sides are computed on the decomposition `f = t ^ ord f * u_f`.
    conv_rhs => rw [v.eq_zpow_mul_unitPart t ht f, ofUnit_mul, ofUnit_zpow, map_add, map_zsmul]
    rw [RingHom.comp_apply, serreMap_ofUnit, map_add, map_zsmul, serreInverse_C, serreInverse_X,
      unitPartResidue_apply, residueHom_ofUnit_residue, add_comm]
  exact DFunLike.congr_fun h x

/-- Every element of `K_nᴹ(k)` is sent by `{ū} ↦ {u}` to the class of an element of `K_nᴹ(F)`. -/
private theorem exists_mem_degree_quotMk_eq_residueHom {n : ℕ}
    {y : MilnorK (IsLocalRing.ResidueField v.valuationSubring)} (hy : y ∈ degree _ n) :
    ∃ w ∈ degree F n, v.quotMk w = v.residueHom y := by
  rw [degree_eq_span] at hy
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨l, rfl, rfl⟩ := hy
    suffices ∃ l' : List Fˣ, l'.length = l.length ∧ v.quotMk (symbol l') = v.residueHom (symbol l)
      by obtain ⟨l', hl', h⟩ := this; exact ⟨symbol l', hl' ▸ symbol_mem_degree l', h⟩
    induction l with
    | nil => exact ⟨[], rfl, by simp⟩
    | cons c l ih =>
      obtain ⟨l', hl', h⟩ := ih
      obtain ⟨u, rfl⟩ := v.valuationSubring.surjective_unitGroupToResidueFieldUnits c
      refine ⟨(u : Fˣ) :: l', by simp [hl'], ?_⟩
      rw [symbol_cons, symbol_cons, _root_.map_mul, _root_.map_mul, h, residueHom_ofUnit_residue]
  | zero => exact ⟨0, zero_mem _, by simp⟩
  | add y y' _ _ hy hy' =>
    obtain ⟨w, hw, h⟩ := hy
    obtain ⟨w', hw', h'⟩ := hy'
    exact ⟨w + w', add_mem hw hw', by rw [_root_.map_add, _root_.map_add, h, h']⟩
  | smul r y _ hy =>
    obtain ⟨w, hw, h⟩ := hy
    exact ⟨r • w, Submodule.smul_mem _ r hw, by rw [map_zsmul, map_zsmul, h]⟩

/-! ### The kernel of Serre's map -/

/-- **The kernel of Serre's map** `d_t : K_*ᴹ(F) → L(k)` is the two-sided ideal generated by the
classes `{a}` of the principal units `a ∈ U¹ = 1 + 𝔪_v`. -/
theorem ker_serreMap : TwoSidedIdeal.ker (v.serreMap t ht) =
    TwoSidedIdeal.span (ofUnit '' (v.valuationSubring.principalUnitGroup : Set Fˣ)) := by
  refine le_antisymm (fun x hx ↦ ?_) ?_
  · rw [TwoSidedIdeal.mem_ker] at hx
    rw [← quotMk_eq_zero_iff, ← v.serreInverse_serreMap t ht, hx, map_zero]
  · rw [TwoSidedIdeal.span_le]
    rintro _ ⟨a, ha, rfl⟩
    exact (TwoSidedIdeal.mem_ker _).2 ((v.serreMap_ofUnit_eq_zero_iff t ht).2 ha)

open scoped Pointwise in
/-- Every element of the two-sided ideal generated by the principal unit classes is a sum of
products `{a} y` with `a ∈ U¹`: a class `{a}` moves to the left past any `x` at the cost of the
grade involution. -/
private theorem mem_span_mul_top_of_mem_principalIdeal {x : MilnorK F}
    (hx : x ∈ v.principalIdeal) :
    x ∈ span ℤ (ofUnit '' (v.valuationSubring.principalUnitGroup : Set Fˣ)) * ⊤ := by
  rw [TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hx
  induction hx using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨_, ⟨r, -, _, ⟨a, ha, rfl⟩, rfl⟩, r', -, rfl⟩ := hx
    dsimp only
    rw [← ofUnit_mul_involute, mul_assoc]
    exact mul_mem_mul (subset_span ⟨a, ha, rfl⟩) mem_top
  | zero => exact zero_mem _
  | add x y _ _ hx hy => exact add_mem hx hy
  | neg x _ hx => exact neg_mem hx

/-- The degree-`(n + 1)` component of an element of `U¹ · K_*ᴹ(F)` lies in `U¹ · K_nᴹ(F)`. -/
private theorem decompose_mem_span_mul_degree {n : ℕ} {x : MilnorK F}
    (hx : x ∈ span ℤ (ofUnit '' (v.valuationSubring.principalUnitGroup : Set Fˣ)) * ⊤) :
    (DirectSum.decompose (degree F) x (n + 1) : MilnorK F) ∈
      span ℤ (ofUnit '' (v.valuationSubring.principalUnitGroup : Set Fˣ)) * degree F n := by
  refine Submodule.mul_induction_on hx (fun m hm y _ ↦ ?_) fun x y hx hy ↦ ?_
  · have hm1 : m ∈ degree F 1 := (span_le.2 (by
      rintro _ ⟨a, -, rfl⟩
      exact ofUnit_mem_degree_one a)) hm
    rw [DirectSum.coe_decompose_mul_of_left_mem_of_le (degree F) hm1 (by omega),
      Nat.add_sub_cancel]
    exact mul_mem_mul hm (SetLike.coe_mem _)
  · rw [DirectSum.decompose_add, DirectSum.add_apply, AddMemClass.coe_add]
    exact add_mem hx hy

/-- An element of `K_{n+1}ᴹ(F)` in the two-sided ideal generated by the principal unit classes
lies in `U¹ · K_nᴹ(F)`. -/
private theorem mem_span_mul_degree_of_mem_principalIdeal {n : ℕ} {x : MilnorK F}
    (hx : x ∈ degree F (n + 1)) (hJ : x ∈ v.principalIdeal) :
    x ∈ span ℤ (ofUnit '' (v.valuationSubring.principalUnitGroup : Set Fˣ)) * degree F n := by
  rw [← DirectSum.decompose_of_mem_same (degree F) hx]
  exact v.decompose_mem_span_mul_degree (v.mem_span_mul_top_of_mem_principalIdeal hJ)

/-- Products `{a} y` with `a` a principal unit are killed by Serre's map. -/
private theorem serreMap_eq_zero_of_mem_span_mul {x : MilnorK F} {N : Submodule ℤ (MilnorK F)}
    (hx : x ∈ span ℤ (ofUnit '' (v.valuationSubring.principalUnitGroup : Set Fˣ)) * N) :
    v.serreMap t ht x = 0 := by
  rw [← TwoSidedIdeal.mem_ker, ker_serreMap]
  refine Submodule.mul_induction_on hx (fun m hm y _ ↦ ?_) fun x y hx hy ↦ add_mem hx hy
  refine TwoSidedIdeal.mul_mem_right _ _ _ ?_
  induction hm using Submodule.span_induction with
  | mem m hm => exact TwoSidedIdeal.subset_span hm
  | zero => exact zero_mem _
  | add m m' _ _ hm hm' => exact add_mem hm hm'
  | smul r m _ hm => exact TwoSidedIdeal.zsmul_mem _ r hm

/-- **The kernel of Serre's map in degree `n + 1`**: an element `x ∈ K_{n+1}ᴹ(F)` satisfies
`d_t(x) = 0` exactly when it lies in `U¹ · K_nᴹ(F)`, the subgroup spanned by the products `{a} y`
with `a` a principal unit and `y ∈ K_nᴹ(F)`. -/
theorem serreMap_eq_zero_iff_of_mem_degree {n : ℕ} {x : MilnorK F}
    (hx : x ∈ degree F (n + 1)) :
    v.serreMap t ht x = 0 ↔
      x ∈ span ℤ (ofUnit '' (v.valuationSubring.principalUnitGroup : Set Fˣ)) * degree F n := by
  refine ⟨fun h ↦ v.mem_span_mul_degree_of_mem_principalIdeal hx ?_,
    v.serreMap_eq_zero_of_mem_span_mul t ht⟩
  have hker : x ∈ TwoSidedIdeal.ker (v.serreMap t ht) := (TwoSidedIdeal.mem_ker _).2 h
  rwa [ker_serreMap] at hker

/-! ### The kernel of the specialization -/

/-- **The kernel of the specialization in degree `n + 1`**: an element `x ∈ K_{n+1}ᴹ(F)` satisfies
`λ_t(x) = 0` exactly when it lies in `U¹ · K_nᴹ(F) + {t} · K_nᴹ(F)`. -/
theorem milnorSpecialization_eq_zero_iff_of_mem_degree {n : ℕ} {x : MilnorK F}
    (hx : x ∈ degree F (n + 1)) :
    v.milnorSpecialization t ht x = 0 ↔
      x ∈ span ℤ (ofUnit '' (v.valuationSubring.principalUnitGroup : Set Fˣ)) * degree F n ⊔
        span ℤ {ofUnit t} * degree F n := by
  constructor
  · intro h
    -- Since `λ_t(x) = 0`, `d_t(x) = ∂_v(x) Π`, so modulo the principal units `x` is `w {t}` for
    -- any lift `w ∈ K_nᴹ(F)` of `∂_v(x)`.
    obtain ⟨w, hw, hw'⟩ :=
      v.exists_mem_degree_quotMk_eq_residueHom (v.milnorResidue_mem_degree t ht hx)
    have hwt : w * ofUnit t ∈ degree F (n + 1) :=
      SetLike.mul_mem_graded hw (ofUnit_mem_degree_one t)
    have hJ : x - w * ofUnit t ∈ v.principalIdeal := by
      rw [← quotMk_eq_zero_iff, _root_.map_sub, ← v.serreInverse_serreMap t ht,
        ← C_milnorSpecialization_add_C_milnorResidue_mul_X, h, _root_.map_zero, zero_add,
        _root_.map_mul, serreInverse_C, serreInverse_X, ← hw', _root_.map_mul, sub_self]
    have hx' : x = (x - w * ofUnit t) + ofUnit t * involute w := by
      rw [ofUnit_mul_involute, sub_add_cancel]
    rw [hx']
    exact add_mem (mem_sup_left (v.mem_span_mul_degree_of_mem_principalIdeal (sub_mem hx hwt) hJ))
      (mem_sup_right (mul_mem_mul (subset_span rfl) (involute_mem_degree hw)))
  · intro h
    obtain ⟨y, hy, z, hz, rfl⟩ := mem_sup.1 h
    rw [_root_.map_add, milnorSpecialization_apply, v.serreMap_eq_zero_of_mem_span_mul t ht hy,
      SerreAlgebra.fst_zero, zero_add]
    refine Submodule.mul_induction_on hz (fun m hm y _ ↦ ?_) fun y y' hy hy' ↦ by
      rw [_root_.map_add, hy, hy', add_zero]
    obtain ⟨r, rfl⟩ := mem_span_singleton.1 hm
    simp

end Valuation
