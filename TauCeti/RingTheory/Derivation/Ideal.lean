/-!
# Derivations and ideals

A derivation `D : A → M` satisfies the Leibniz rule `D (a * b) = a • D b + b • D a`, so it maps
the power `I ^ (n + 1)` of an ideal `I` of `A` into `I ^ n • M`. This is what makes every
derivation continuous for the `I`-adic topologies. For `n = 1`, it maps the square `I ^ 2` into
`I • M`; in particular, an element `f` of an ideal `I` with `D f ∉ I` does not lie in `I ^ 2`.

This is the elementary half of the Jacobian criterion: if a partial derivative of `f` does not
vanish at a point, then `f` is not in the square of the maximal ideal there. When the ambient
local ring at the point is regular, `f` is therefore a regular parameter and the hypersurface
`f = 0` is regular at the point.

A derivation also vanishes on an ideal generated by elements on which it vanishes, provided
those generators annihilate the target module. This applies in particular to derivations at a
point and generators vanishing at that point.

Finally, if the iterates of order at most `K` of a derivation `D : A → A` at each of `n`
factors map under a ring homomorphism `φ` into an ideal `J`, then those at their product, times
an arbitrary cofactor, map into `J ^ n`. The general Leibniz rule writes the `k`-th iterate of a
product as a sum of products with one iterate of each factor, of orders at most `k`, so each term
contributes one factor from `J` per factor of the product. No factorial is cancelled and the
order bound `K` is unrestricted.

## Main results

* `Derivation.apply_mem_pow_smul_top_of_mem_pow_succ`: a derivation maps `I ^ (n + 1)` into
  `I ^ n • M`.
* `Derivation.apply_mem_smul_top_of_mem_sq`: a derivation maps `I ^ 2` into `I • M`.
* `Derivation.apply_mem_of_mem_sq`: a derivation of `A` into itself maps `I ^ 2` into `I`.
* `Derivation.apply_eq_zero_of_mem_span`: vanishing on generators that annihilate the target
  extends to their ideal span.
* `Derivation.iterate_mul_mem_ideal_mul`, `Derivation.iterate_mul_prod_mem_ideal_pow`: iterates
  of a derivation followed by a ring homomorphism at a product with a cofactor lie in the product
  of the ideals containing those at the factors.
* `Ideal.derivationIdeal`: the ideal generated by `I` and all values `D f` of `k`-derivations
  `D : Derivation k R R` on elements `f ∈ I`.
* `Ideal.derivationIdeal_le_iff`, `Ideal.derivationIdeal_span`, `Ideal.derivationIdeal_mul_le`,
  `Ideal.derivationIdeal_le_pow_of_le_pow_succ`: universal property, generators, product rule,
  and power bound for `Ideal.derivationIdeal`.
-/

public section

namespace Derivation

variable {R A M : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A] [AddCommMonoid M]
  [Module A M] [Module R M]

/-- A derivation which vanishes on generators that annihilate its target module vanishes on
the ideal they generate. -/
theorem apply_eq_zero_of_mem_span (D : Derivation R A M) {S : Set A}
    (hsmul : ∀ a ∈ S, ∀ m : M, a • m = 0)
    (hd : ∀ a ∈ S, D a = 0) {x : A} (hx : x ∈ Ideal.span S) : D x = 0 := by
  suffices D x = 0 ∧ ∀ m : M, x • m = 0 from this.1
  induction hx using Submodule.span_induction with
  | mem a ha => exact ⟨hd a ha, hsmul a ha⟩
  | zero => simp
  | add a b _ _ ha hb => simp [map_add, add_smul, ha, hb]
  | smul a b _ hb => simp [smul_eq_mul, D.leibniz, mul_smul, hb]

/-- A derivation maps the power `I ^ (n + 1)` of an ideal `I` into `I ^ n • M`. -/
theorem apply_mem_pow_smul_top_of_mem_pow_succ (D : Derivation R A M) {I : Ideal A} {n : ℕ}
    {x : A} (hx : x ∈ I ^ (n + 1)) : D x ∈ I ^ n • (⊤ : Submodule A M) := by
  induction n generalizing x with
  | zero => simp
  | succ n ih =>
    rw [pow_succ'] at hx
    refine Submodule.mul_induction_on hx (fun a ha b hb ↦ ?_) fun x y hx hy ↦ ?_
    · -- `a • D b ∈ I • I ^ n • M` and `b • D a ∈ I ^ (n + 1) • M`
      rw [D.leibniz, pow_succ', Submodule.mul_smul]
      refine add_mem (Submodule.smul_mem_smul ha (ih hb)) ?_
      rw [← Submodule.mul_smul, ← pow_succ']
      exact Submodule.smul_mem_smul hb Submodule.mem_top
    · rw [map_add]
      exact add_mem hx hy

/-- A derivation maps the square of an ideal `I` into `I • M`. -/
theorem apply_mem_smul_top_of_mem_sq (D : Derivation R A M) {I : Ideal A} {x : A}
    (hx : x ∈ I ^ 2) : D x ∈ I • (⊤ : Submodule A M) := by
  simpa using D.apply_mem_pow_smul_top_of_mem_pow_succ (n := 1) hx

/-- A derivation of `A` into itself maps the square of an ideal `I` into `I`. -/
theorem apply_mem_of_mem_sq (D : Derivation R A A) {I : Ideal A} {x : A} (hx : x ∈ I ^ 2) :
    D x ∈ I := by
  simpa [smul_eq_mul] using D.apply_mem_smul_top_of_mem_sq hx

section Iterate

variable {R A S ι : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A] [CommSemiring S]

/-- If the iterates of order at most `K` of a derivation `D` at `x` and at `y` map under `φ` into
the ideals `I` and `I'`, then those at `x * y` map into `I * I'`. -/
theorem iterate_mul_mem_ideal_mul (D : Derivation R A A) (φ : A →+* S) {I I' : Ideal S}
    {K : ℕ} {x y : A} (hx : ∀ k ≤ K, φ (D^[k] x) ∈ I) (hy : ∀ k ≤ K, φ (D^[k] y) ∈ I') :
    ∀ k ≤ K, φ (D^[k] (x * y)) ∈ I * I' := by
  intro k hk
  rw [D.iterate_apply_mul, map_sum]
  refine sum_mem fun ij hij => ?_
  have hij := Finset.mem_antidiagonal.1 hij
  rw [map_nsmul, map_mul]
  exact Submodule.smul_of_tower_mem _ _
    (Ideal.mul_mem_mul (hx _ (by omega)) (hy _ (by omega)))

/-- **Derivatives of a product in an ideal power.** If the iterates of order at most `K` of a
derivation `D` at each of the `card ι` factors `f i` map under `φ` into an ideal `J`, then the
iterates of order at most `K` at their product with an arbitrary cofactor `g` map into
`J ^ card ι`. Iwaniec and Kowalski, *Analytic Number Theory*, Lemma 11.14 and (11.22), p. 283,
state this for Hasse derivatives of polynomials; the proof here adapts theirs to iterates of a
derivation, using the general Leibniz rule in place of the Hasse product formula. -/
theorem iterate_mul_prod_mem_ideal_pow [Fintype ι] (D : Derivation R A A) (φ : A →+* S)
    (f : ι → A) (g : A) (J : Ideal S) (K : ℕ) (hf : ∀ i, ∀ k ≤ K, φ (D^[k] (f i)) ∈ J) :
    ∀ k ≤ K, φ (D^[k] (g * ∏ i, f i)) ∈ J ^ Fintype.card ι :=
  Ideal.pow_card_mul_prod_induction (fun I x => ∀ k ≤ K, φ (D^[k] x) ∈ I)
    (fun _ _ _ => Submodule.mem_top) (D.iterate_mul_mem_ideal_mul φ) hf g

end Iterate

end Derivation

namespace Ideal

variable (k : Type*) [CommSemiring k] {R : Type*} [CommSemiring R] [Algebra k R]
  {I J : Ideal R}

/-- The derivation ideal of an ideal `I` of a `k`-algebra `R`: the ideal generated by `I` and the
values `D f` of all `k`-derivations `D : Derivation k R R` on elements `f ∈ I`. -/
noncomputable def derivationIdeal (I : Ideal R) : Ideal R :=
  I ⊔ span (⋃ D : Derivation k R R, D '' I)

/-- The defining expression of `Ideal.derivationIdeal`. -/
theorem derivationIdeal_def (I : Ideal R) :
    I.derivationIdeal k = I ⊔ span (⋃ D : Derivation k R R, D '' I) :=
  (rfl)

/-- Every ideal is contained in its derivation ideal. -/
theorem le_derivationIdeal (I : Ideal R) : I ≤ I.derivationIdeal k :=
  le_sup_left

/-- The derivation ideal contains `D f` for every `f ∈ I` and every `k`-derivation `D`. -/
theorem apply_mem_derivationIdeal (D : Derivation k R R) {f : R} (hf : f ∈ I) :
    D f ∈ I.derivationIdeal k :=
  mem_sup_right (subset_span (Set.mem_iUnion.mpr ⟨D, Set.mem_image_of_mem _ hf⟩))

/-- The derivation ideal of `I` is the smallest ideal containing `I` and `D f` for every
`k`-derivation `D` and every `f ∈ I`. -/
theorem derivationIdeal_le_iff :
    I.derivationIdeal k ≤ J ↔ I ≤ J ∧ ∀ D : Derivation k R R, ∀ f ∈ I, D f ∈ J := by
  rw [derivationIdeal_def, sup_le_iff, span_le, Set.iUnion_subset_iff]
  simp only [Set.subset_def, Set.forall_mem_image, SetLike.mem_coe]

/-- Taking derivation ideals is monotone with respect to ideal inclusion. -/
theorem derivationIdeal_mono : Monotone (derivationIdeal k (R := R)) :=
  fun _ _ h ↦ (derivationIdeal_le_iff k).mpr
    ⟨h.trans (le_derivationIdeal k _), fun D _ hf ↦ apply_mem_derivationIdeal k D (h hf)⟩

/-- The derivation ideal of the zero ideal is the zero ideal. -/
@[simp]
theorem derivationIdeal_bot : (⊥ : Ideal R).derivationIdeal k = ⊥ :=
  le_bot_iff.mp <| (derivationIdeal_le_iff k).mpr
    ⟨le_rfl, fun _ _ hf ↦ by simp [mem_bot.mp hf]⟩

/-- The derivation ideal of the unit ideal is the unit ideal. -/
@[simp]
theorem derivationIdeal_top : (⊤ : Ideal R).derivationIdeal k = ⊤ :=
  top_le_iff.mp (le_derivationIdeal k ⊤)

/-- The derivation ideal commutes with arbitrary suprema of ideals. -/
@[simp]
theorem derivationIdeal_iSup {ι : Sort*} (I : ι → Ideal R) :
    (⨆ i, I i).derivationIdeal k = ⨆ i, (I i).derivationIdeal k := by
  refine le_antisymm ?_ (iSup_le fun i ↦ derivationIdeal_mono k (le_iSup I i))
  refine (derivationIdeal_le_iff k).mpr
    ⟨iSup_mono fun i ↦ le_derivationIdeal k (I i), fun D f hf ↦ ?_⟩
  induction hf using Submodule.iSup_induction' with
  | mem i x hx =>
    exact le_iSup (fun i ↦ (I i).derivationIdeal k) i (apply_mem_derivationIdeal k D hx)
  | zero => simp
  | add x y _ _ hx hy => simpa using add_mem hx hy

/-- The derivation ideal of a sum of two ideals is the sum of their derivation ideals. -/
@[simp]
theorem derivationIdeal_sup (I J : Ideal R) :
    (I ⊔ J).derivationIdeal k = I.derivationIdeal k ⊔ J.derivationIdeal k := by
  rw [sup_eq_iSup, derivationIdeal_iSup, sup_eq_iSup]
  congr 1
  funext b
  cases b <;> rfl

/-- The derivation ideal of the ideal generated by a set `s` is generated by `s` together with the
values of all `k`-derivations on `s`. -/
theorem derivationIdeal_span (s : Set R) :
    (span s).derivationIdeal k = span (s ∪ ⋃ D : Derivation k R R, D '' s) := by
  refine le_antisymm ((derivationIdeal_le_iff k).mpr ⟨span_mono Set.subset_union_left, ?_⟩) ?_
  · intro D f hf
    induction hf using Submodule.span_induction with
    | mem x hx =>
      exact subset_span (Or.inr (Set.mem_iUnion.mpr ⟨D, Set.mem_image_of_mem _ hx⟩))
    | zero => simp
    | add x y _ _ hx hy => simpa using add_mem hx hy
    | smul a x hx' hx =>
      rw [smul_eq_mul, D.leibniz, smul_eq_mul, smul_eq_mul]
      exact add_mem (mul_mem_left _ _ hx)
        (mul_mem_right _ _ (span_mono Set.subset_union_left hx'))
  · refine span_le.mpr (Set.union_subset (subset_span.trans (le_derivationIdeal k _)) ?_)
    simp only [Set.iUnion_subset_iff, Set.image_subset_iff]
    exact fun D f hf ↦ apply_mem_derivationIdeal k D (subset_span hf)

/-- The derivation ideal of a product satisfies the Leibniz inclusion
`(I * J).derivationIdeal k ≤ I.derivationIdeal k * J ⊔ I * J.derivationIdeal k`. -/
theorem derivationIdeal_mul_le (I J : Ideal R) :
    (I * J).derivationIdeal k ≤ I.derivationIdeal k * J ⊔ I * J.derivationIdeal k := by
  refine (derivationIdeal_le_iff k).mpr ⟨?_, fun D f hf ↦ ?_⟩
  · exact le_sup_of_le_left (Ideal.mul_mono (le_derivationIdeal k I) le_rfl)
  · refine Submodule.mul_induction_on hf (fun a ha b hb ↦ ?_) fun x y hx hy ↦ ?_
    · rw [D.leibniz, smul_eq_mul, smul_eq_mul, add_comm]
      exact add_mem
        (mem_sup_left (mul_comm b (D a) ▸
          Ideal.mul_mem_mul (apply_mem_derivationIdeal k D ha) hb))
        (mem_sup_right (Ideal.mul_mem_mul ha (apply_mem_derivationIdeal k D hb)))
    · rw [map_add]
      exact add_mem hx hy

/-- Every derivation lowers powers of an ideal by at most one: if `I ≤ J ^ (n + 1)` then
`I.derivationIdeal k ≤ J ^ n`. -/
theorem derivationIdeal_le_pow_of_le_pow_succ {n : ℕ} (h : I ≤ J ^ (n + 1)) :
    I.derivationIdeal k ≤ J ^ n := by
  refine (derivationIdeal_le_iff k).mpr ⟨h.trans (Ideal.pow_le_pow_right n.le_succ), ?_⟩
  intro D f hf
  simpa using D.apply_mem_pow_smul_top_of_mem_pow_succ (h hf)

end Ideal
