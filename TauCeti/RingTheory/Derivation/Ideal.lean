module

public import Mathlib.RingTheory.Derivation.Basic
public import Mathlib.RingTheory.Ideal.Operations
import TauCeti.RingTheory.Derivation.Basic
import TauCeti.RingTheory.Ideal.Operations

/-!
# Derivations and ideals

A derivation `D : A → M` satisfies the Leibniz rule `D (a * b) = a • D b + b • D a`, so it maps
the power `I ^ (n + 1)` of an ideal `I` of `A` into `I ^ n • M`. This is what makes every
derivation continuous for the `I`-adic topologies. For `n = 1`, it maps the square `I ^ 2` into
`I • M`; in particular, an element `f` of an ideal `I` with `D f ∉ I` does not lie in `I ^ 2`.

This is the elementary half of the Jacobian criterion: if a partial derivative of `f` does not
vanish at a point, then `f` is not in the square of the maximal ideal there. When the ambient
local ring at the point is regular, `f` is therefore a regular parameter and the hypersurface
`f = 0` is regular at the point.

A derivation also vanishes on an ideal generated by elements on which it vanishes, provided
those generators annihilate the target module. This applies in particular to derivations at a
point and generators vanishing at that point.

Finally, if the iterates of order at most `K` of a derivation `D : A → A` at each of `n`
factors map under a ring homomorphism `φ` into an ideal `J`, then those at their product, times
an arbitrary cofactor, map into `J ^ n`. The general Leibniz rule writes the `k`-th iterate of a
product as a sum of products with one iterate of each factor, of orders at most `k`, so each term
contributes one factor from `J` per factor of the product. No factorial is cancelled and the
order bound `K` is unrestricted.

## Main results

* `Derivation.apply_mem_pow_smul_top_of_mem_pow_succ`: a derivation maps `I ^ (n + 1)` into
  `I ^ n • M`.
* `Derivation.apply_mem_smul_top_of_mem_sq`: a derivation maps `I ^ 2` into `I • M`.
* `Derivation.apply_mem_of_mem_sq`: a derivation of `A` into itself maps `I ^ 2` into `I`.
* `Derivation.apply_eq_zero_of_mem_span`: vanishing on generators that annihilate the target
  extends to their ideal span.
* `Derivation.iterate_mul_mem_ideal_mul`, `Derivation.iterate_mul_prod_mem_ideal_pow`: iterates
  of a derivation followed by a ring homomorphism at a product with a cofactor lie in the product
  of the ideals containing those at the factors.
-/

public section

namespace Derivation

variable {R A M : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A] [AddCommMonoid M]
  [Module A M] [Module R M]

/-- A derivation which vanishes on generators that annihilate its target module vanishes on
the ideal they generate. -/
theorem apply_eq_zero_of_mem_span (D : Derivation R A M) {S : Set A}
    (hsmul : ∀ a ∈ S, ∀ m : M, a • m = 0)
    (hd : ∀ a ∈ S, D a = 0) {x : A} (hx : x ∈ Ideal.span S) : D x = 0 := by
  suffices D x = 0 ∧ ∀ m : M, x • m = 0 from this.1
  induction hx using Submodule.span_induction with
  | mem a ha => exact ⟨hd a ha, hsmul a ha⟩
  | zero => simp
  | add a b _ _ ha hb => simp [map_add, add_smul, ha, hb]
  | smul a b _ hb => simp [smul_eq_mul, D.leibniz, mul_smul, hb]

/-- A derivation maps the power `I ^ (n + 1)` of an ideal `I` into `I ^ n • M`. -/
theorem apply_mem_pow_smul_top_of_mem_pow_succ (D : Derivation R A M) {I : Ideal A} {n : ℕ}
    {x : A} (hx : x ∈ I ^ (n + 1)) : D x ∈ I ^ n • (⊤ : Submodule A M) := by
  induction n generalizing x with
  | zero => simp
  | succ n ih =>
    rw [pow_succ'] at hx
    refine Submodule.mul_induction_on hx (fun a ha b hb ↦ ?_) fun x y hx hy ↦ ?_
    · -- `a • D b ∈ I • I ^ n • M` and `b • D a ∈ I ^ (n + 1) • M`
      rw [D.leibniz, pow_succ', Submodule.mul_smul]
      refine add_mem (Submodule.smul_mem_smul ha (ih hb)) ?_
      rw [← Submodule.mul_smul, ← pow_succ']
      exact Submodule.smul_mem_smul hb Submodule.mem_top
    · rw [map_add]
      exact add_mem hx hy

/-- A derivation maps the square of an ideal `I` into `I • M`. -/
theorem apply_mem_smul_top_of_mem_sq (D : Derivation R A M) {I : Ideal A} {x : A}
    (hx : x ∈ I ^ 2) : D x ∈ I • (⊤ : Submodule A M) := by
  simpa using D.apply_mem_pow_smul_top_of_mem_pow_succ (n := 1) hx

/-- A derivation of `A` into itself maps the square of an ideal `I` into `I`. -/
theorem apply_mem_of_mem_sq (D : Derivation R A A) {I : Ideal A} {x : A} (hx : x ∈ I ^ 2) :
    D x ∈ I := by
  simpa [smul_eq_mul] using D.apply_mem_smul_top_of_mem_sq hx

section Iterate

variable {R A S ι : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A] [CommSemiring S]

/-- If the iterates of order at most `K` of a derivation `D` at `x` and at `y` map under `φ` into
the ideals `I` and `I'`, then those at `x * y` map into `I * I'`. -/
theorem iterate_mul_mem_ideal_mul (D : Derivation R A A) (φ : A →+* S) {I I' : Ideal S}
    {K : ℕ} {x y : A} (hx : ∀ k ≤ K, φ (D^[k] x) ∈ I) (hy : ∀ k ≤ K, φ (D^[k] y) ∈ I') :
    ∀ k ≤ K, φ (D^[k] (x * y)) ∈ I * I' := by
  intro k hk
  rw [D.iterate_apply_mul, map_sum]
  refine sum_mem fun ij hij => ?_
  have hij := Finset.mem_antidiagonal.1 hij
  rw [map_nsmul, map_mul]
  exact Submodule.smul_of_tower_mem _ _
    (Ideal.mul_mem_mul (hx _ (by omega)) (hy _ (by omega)))

/-- **Derivatives of a product in an ideal power.** If the iterates of order at most `K` of a
derivation `D` at each of the `card ι` factors `f i` map under `φ` into an ideal `J`, then the
iterates of order at most `K` at their product with an arbitrary cofactor `g` map into
`J ^ card ι`. Iwaniec and Kowalski, *Analytic Number Theory*, Lemma 11.14 and (11.22), p. 283,
state this for Hasse derivatives of polynomials; the proof here adapts theirs to iterates of a
derivation, using the general Leibniz rule in place of the Hasse product formula. -/
theorem iterate_mul_prod_mem_ideal_pow [Fintype ι] (D : Derivation R A A) (φ : A →+* S)
    (f : ι → A) (g : A) (J : Ideal S) (K : ℕ) (hf : ∀ i, ∀ k ≤ K, φ (D^[k] (f i)) ∈ J) :
    ∀ k ≤ K, φ (D^[k] (g * ∏ i, f i)) ∈ J ^ Fintype.card ι :=
  Ideal.pow_card_mul_prod_induction (fun I x => ∀ k ≤ K, φ (D^[k] x) ∈ I)
    (fun _ _ _ => Submodule.mem_top) (D.iterate_mul_mem_ideal_mul φ) hf g

end Iterate

end Derivation
