module

public import Mathlib.Data.Matrix.Basic
public import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Tactic.FinCases

/-!
# Twisted derivations from lower-triangular `2 × 2` matrix lifts

Given an `R`-algebra `A` with an `R`-algebra endomorphism `σ : A →ₐ[R] A`, matrices of the form
`!![a, 0; d a, σ a]` in `Matrix (Fin 2) (Fin 2) A` multiply according to the `σ`-twisted Leibniz
rule `d (a * b) = d a * b + σ a * d b`. Consequently, when `A` is generated as an `R`-algebra by
the image of `gen : V →ₗ[R] A` and the lower-triangular assignment
`x ↦ !![gen x, 0; δ x, σ (gen x)]` extends to an `R`-algebra homomorphism
`F : A →ₐ[R] Matrix (Fin 2) (Fin 2) A`, the `(1, 0)` entry of `F` is an `R`-linear endomorphism of
`A` extending `δ` and satisfying the `σ`-twisted Leibniz rule.

This provides the grading-independent matrix scaffolding shared by the odd derivation extensions on
`TauCeti.SignedSym` and `TauCeti.ParitySignedSym`.

## Main definitions

* `TauCeti.lowerTriangularDerivationMatrix`: the `R`-linear map sending `x : V` to
  `!![gen x, 0; δ x, σ (gen x)]`.
* `TauCeti.lowerTriangularDerivation`: the `(1, 0)` entry of an algebra map
  `F : A →ₐ[R] Matrix (Fin 2) (Fin 2) A` as an `R`-linear endomorphism of `A`.

## Main results

* `TauCeti.lowerTriangularDerivationMatrix_mul_eq_zsmul`: criteria on `gen` and `δ` for two
  lower-triangular generator matrices to commute up to an integer scalar `n`.
* `TauCeti.lowerTriangularDerivationLift_apply`: on an `R`-algebra generated by `gen`, an algebra
  lift `F` of `lowerTriangularDerivationMatrix` has `(0, 0)`, `(0, 1)`, and `(1, 1)` entries `a`,
  `0`, and `σ a`.
* `TauCeti.lowerTriangularDerivation_generator` and `TauCeti.lowerTriangularDerivation_mul`: the
  extracted `(1, 0)` entry extends `δ` on `gen` and satisfies the `σ`-twisted Leibniz rule.
-/

public section

namespace TauCeti

universe u v w

section Module

variable {R : Type u} {A : Type v} {V : Type w}
  [Semiring R] [AddCommMonoid A] [Module R A] [AddCommMonoid V] [Module R V]

/-- The `R`-linear map sending `x : V` to the `2 × 2` lower-triangular matrix
`!![gen x, 0; δ x, σ (gen x)]`. When `σ` comes from an algebra endomorphism of `A`, an algebra map
`A →ₐ[R] Matrix (Fin 2) (Fin 2) A` extending this assignment along `gen` carries a `σ`-twisted
derivation in its `(1, 0)` entry. -/
def lowerTriangularDerivationMatrix (gen δ : V →ₗ[R] A) (σ : A →ₗ[R] A) :
    V →ₗ[R] Matrix (Fin 2) (Fin 2) A where
  toFun x := !![gen x, 0; δ x, σ (gen x)]
  map_add' x y := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp
  map_smul' r x := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp

/-- `lowerTriangularDerivationMatrix` evaluates to `!![gen x, 0; δ x, σ (gen x)]`. -/
@[simp]
theorem lowerTriangularDerivationMatrix_apply (gen δ : V →ₗ[R] A) (σ : A →ₗ[R] A) (x : V) :
    lowerTriangularDerivationMatrix gen δ σ x = !![gen x, 0; δ x, σ (gen x)] :=
  (rfl)

end Module

section CommSemiring

variable {R : Type u} {A : Type v} {V : Type w}
  [CommSemiring R] [Semiring A] [Algebra R A] [AddCommMonoid V] [Module R V]

/-- If `A` is generated as an `R`-algebra by `gen` (expressed by its 4-case induction principle)
and `F : A →ₐ[R] Matrix (Fin 2) (Fin 2) A` extends `lowerTriangularDerivationMatrix gen δ σ`, then
`F a` has diagonal entries `a` and `σ a` and upper-right entry `0`. -/
theorem lowerTriangularDerivationLift_apply {gen δ : V →ₗ[R] A} {σ : A →ₐ[R] A}
    {F : A →ₐ[R] Matrix (Fin 2) (Fin 2) A}
    (ind : ∀ {P : A → Prop}, (∀ r, P (algebraMap R A r)) → (∀ x, P (gen x)) →
      (∀ a b, P a → P b → P (a * b)) → (∀ a b, P a → P b → P (a + b)) → ∀ a, P a)
    (hF : ∀ x, F (gen x) = lowerTriangularDerivationMatrix gen δ σ.toLinearMap x) (a : A) :
    F a 0 0 = a ∧ F a 0 1 = 0 ∧ F a 1 1 = σ a := by
  refine ind (P := fun a ↦ F a 0 0 = a ∧ F a 0 1 = 0 ∧ F a 1 1 = σ a)
    (fun r ↦ by simp [Matrix.algebraMap_matrix_apply]) (fun x ↦ by simp [hF])
    (fun a b ha hb ↦ ?_) (fun a b ha hb ↦ ?_) a
  · simp [Matrix.mul_apply, Fin.sum_univ_two, ha.1, ha.2.1, ha.2.2, hb.1, hb.2.1, hb.2.2]
  · simp [ha.1, ha.2.1, ha.2.2, hb.1, hb.2.1, hb.2.2]

/-- The `(1, 0)` entry of an algebra map `F : A →ₐ[R] Matrix (Fin 2) (Fin 2) A`, packaged as an
`R`-linear endomorphism of `A`. -/
def lowerTriangularDerivation (F : A →ₐ[R] Matrix (Fin 2) (Fin 2) A) : A →ₗ[R] A :=
  Matrix.entryLinearMap R A 1 0 ∘ₗ F.toLinearMap

/-- `lowerTriangularDerivation F` reads the `(1, 0)` entry of `F a`. -/
@[simp]
theorem lowerTriangularDerivation_apply (F : A →ₐ[R] Matrix (Fin 2) (Fin 2) A) (a : A) :
    lowerTriangularDerivation F a = F a 1 0 :=
  (rfl)

/-- `lowerTriangularDerivation F` annihilates the image of the base semiring. -/
theorem lowerTriangularDerivation_algebraMap (F : A →ₐ[R] Matrix (Fin 2) (Fin 2) A) (r : R) :
    lowerTriangularDerivation F (algebraMap R A r) = 0 := by
  simp [lowerTriangularDerivation_apply, Matrix.algebraMap_matrix_apply]

/-- `lowerTriangularDerivation F` annihilates `1`. -/
theorem lowerTriangularDerivation_one (F : A →ₐ[R] Matrix (Fin 2) (Fin 2) A) :
    lowerTriangularDerivation F 1 = 0 := by
  simp

/-- If `F` extends `lowerTriangularDerivationMatrix gen δ σ`, then `lowerTriangularDerivation F`
agrees with `δ` on generators. -/
theorem lowerTriangularDerivation_generator {gen δ : V →ₗ[R] A} {σ : A →ₗ[R] A}
    {F : A →ₐ[R] Matrix (Fin 2) (Fin 2) A}
    (hF : ∀ x, F (gen x) = lowerTriangularDerivationMatrix gen δ σ x) (x : V) :
    lowerTriangularDerivation F (gen x) = δ x := by
  simp [lowerTriangularDerivation_apply, hF]

/-- **Twisted Leibniz rule**: when `F` extends `lowerTriangularDerivationMatrix gen δ σ` on an
`R`-algebra generated by `gen`, `lowerTriangularDerivation F` satisfies
`d (a * b) = d a * b + σ a * d b`. -/
theorem lowerTriangularDerivation_mul {gen δ : V →ₗ[R] A} {σ : A →ₐ[R] A}
    {F : A →ₐ[R] Matrix (Fin 2) (Fin 2) A}
    (ind : ∀ {P : A → Prop}, (∀ r, P (algebraMap R A r)) → (∀ x, P (gen x)) →
      (∀ a b, P a → P b → P (a * b)) → (∀ a b, P a → P b → P (a + b)) → ∀ a, P a)
    (hF : ∀ x, F (gen x) = lowerTriangularDerivationMatrix gen δ σ.toLinearMap x) (a b : A) :
    lowerTriangularDerivation F (a * b) =
      lowerTriangularDerivation F a * b + σ a * lowerTriangularDerivation F b := by
  have ha := lowerTriangularDerivationLift_apply ind hF a
  have hb := lowerTriangularDerivationLift_apply ind hF b
  simp only [lowerTriangularDerivation_apply, map_mul, Matrix.mul_apply, Fin.sum_univ_two,
    ha.2.2, hb.1]

end CommSemiring

section Ring

variable {R : Type u} {A : Type v} {V : Type w}
  [CommSemiring R] [Ring A] [Algebra R A] [AddCommMonoid V] [Module R V]

/-- Two lower-triangular generator matrices commute up to `n : ℤ` as soon as their generators do
and the twisted Leibniz cross-term identity holds for `x` and `y`. -/
theorem lowerTriangularDerivationMatrix_mul_eq_zsmul
    (gen δ : V →ₗ[R] A) (σ : A →ₐ[R] A) {x y : V} {n : ℤ}
    (hgen : gen x * gen y = n • (gen y * gen x))
    (hδ : δ x * gen y + σ (gen x) * δ y = n • (δ y * gen x + σ (gen y) * δ x)) :
    lowerTriangularDerivationMatrix gen δ σ.toLinearMap x *
        lowerTriangularDerivationMatrix gen δ σ.toLinearMap y =
      n • (lowerTriangularDerivationMatrix gen δ σ.toLinearMap y *
        lowerTriangularDerivationMatrix gen δ σ.toLinearMap x) := by
  ext i j
  fin_cases i <;> fin_cases j
  · simpa [Matrix.mul_apply, zsmul_eq_mul] using hgen
  · simp [Matrix.mul_apply]
  · simpa [Matrix.mul_apply, Fin.sum_univ_two, zsmul_eq_mul] using hδ
  · have hσ : σ (gen x) * σ (gen y) = n • (σ (gen y) * σ (gen x)) := by
      rw [← map_mul σ, ← map_mul σ, hgen, map_zsmul]
    simpa [Matrix.mul_apply, Fin.sum_univ_two, zsmul_eq_mul] using hσ

end Ring

end TauCeti
