module

public import Mathlib.RingTheory.Derivation.Basic
public import Mathlib.Topology.Algebra.Nonarchimedean.AdicTopology
import TauCeti.RingTheory.Derivation.Ideal

/-!
# Derivations are continuous for adic topologies

Let `I` be an ideal of a commutative ring `A` and `M` an `A`-module. Every derivation
`D : A → M` is continuous for the `I`-adic topology on `A` and the `I`-adic topology on `M`, with
no further hypothesis: by the Leibniz rule `D` maps `I ^ (n + 1)` into `I ^ n • M`
(`Derivation.apply_mem_pow_smul_top_of_mem_pow_succ`), and these sets are bases of neighbourhoods
of zero.

For `A = K⟦X⟧` and `I = (X)` this says that every `K`-derivation of formal power series is
`X`-adically continuous, in every characteristic, although `K⟦X⟧` is far from being generated by
`X` as an algebra.

## Main results

* `Derivation.continuous_adic`: a derivation `A → M` is continuous for the `I`-adic topologies.
-/

public section

namespace Derivation

variable {R A M : Type*} [CommSemiring R] [CommRing A] [Algebra R A] [AddCommGroup M] [Module A M]
  [Module R M]

/-- Every derivation `D : A → M` is continuous for the `I`-adic topologies on `A` and on `M`,
since it maps `I ^ (n + 1)` into `I ^ n • M`. -/
theorem continuous_adic (D : Derivation R A M) (I : Ideal A) :
    @Continuous A M I.adicTopology (I.adicModuleTopology M) D := by
  let := I.adicTopology
  let B := I.ringFilterBasis.moduleFilterBasis (I.adic_module_basis M)
  let := I.adicModuleTopology M
  have := B.isTopologicalAddGroup
  refine continuous_of_continuousAt_zero D.toAddMonoidHom ?_
  rw [ContinuousAt, map_zero]
  refine (I.hasBasis_nhds_zero_adic.tendsto_iff B.nhds_zero_hasBasis).mpr ?_
  rintro _ ⟨n, rfl⟩
  exact ⟨n + 1, trivial, fun x hx ↦ D.apply_mem_pow_smul_top_of_mem_pow_succ hx⟩

end Derivation
