/-!
# Derivation ideals and Zariski closedness of ideal order loci

For an algebra `R` over a commutative semiring `k` and an ideal `I` of `R`, `I.derivationIdeal k`
is the ideal generated by `I` and `D f` for all `f ∈ I` and `D : Derivation k R R` (defined in
`TauCeti.RingTheory.Derivation.Ideal`).

When `k` and `R` are commutative rings, the Leibniz rule and extension of derivations to
localizations show that every `k`-derivation lowers order at a prime by at most one, in every
characteristic and with no regularity or finiteness hypothesis:
`I.orderAt p ≤ (I.derivationIdeal k).orderAt p + 1`
(`Ideal.orderAt_le_orderAt_derivationIdeal_add_one` in
`TauCeti.RingTheory.Derivation.Localization`).

When `k` is a characteristic-zero **field**, `Ω[R⁄k]` is finitely generated and projective over `R`,
and `R_p` is regular local, the order satisfies `(I.derivationIdeal k).orderAt p = I.orderAt p - 1`
(truncated subtraction in `ℕ∞`, so finite positive order drops by one while `0` and `⊤` remain
fixed). The proof uses formal smoothness of the residue field `κ(p)` over the characteristic-zero
field `k` to inject `𝔪_p ⧸ 𝔪_p²` into `κ(p) ⊗[R_p] Ω[R_p⁄k]`, lifts dual `κ(p)`-linear
functionals to global `k`-derivations of `R` up to a denominator outside `p`
(`Derivation.exists_dual_derivation`), and applies the associated-graded polynomial equivalence
`TauCeti.IsRegularLocalRing.associatedGradedEquiv` together with Euler's homogeneous identity in
`κ(p)[X₁, …, Xᵣ]`.

Iterating `n` times gives
`((n + 1 : ℕ) : ℕ∞) ≤ I.orderAt p ↔ (derivationIdeal k)^[n] I ≤ p.asIdeal`.
Consequently, on a regular ring with finitely generated projective Kähler differentials over a
characteristic-zero field — in particular on any smooth algebra or any regular finite-type algebra
over a characteristic-zero field — every order-threshold locus `{p | c ≤ I.orderAt p}` is Zariski
closed.

## Main results

* `Ideal.mem_maximalIdeal_pow_add_two_of_forall_derivation`: elementwise order-increase test in a
  regular local localization over a characteristic-zero field.
* `Ideal.orderAt_derivationIdeal`: over a characteristic-zero field, at a regular prime of an
  algebra with finitely generated projective differentials,
  `(I.derivationIdeal k).orderAt p = I.orderAt p - 1`.
* `Ideal.orderAt_derivationIdeal_iterate`: iterated version
  `((derivationIdeal k)^[n] I).orderAt p = I.orderAt p - n`.
* `Ideal.natCast_add_one_le_orderAt_iff_iterate_derivationIdeal_le`: threshold characterization
  via iterated derivation ideals over a characteristic-zero field.
* `Ideal.isClosed_setOf_le_orderAt`: every order-threshold locus `{p | c ≤ I.orderAt p}` is
  Zariski closed.
* `Ideal.isClosed_setOf_le_orderAt_of_smooth`, `Ideal.isClosed_setOf_le_orderAt_of_finiteType`:
  closedness for smooth algebras and regular finite-type algebras over characteristic-zero fields.

## References

* E. Bierstone and P. D. Milman, *Canonical desingularization in characteristic zero by blowing
  up the maximum strata of a local invariant*, Invent. Math. 128 (1997), §4.1–4.2 and
  Proposition 4.12.
-/

public section

open IsLocalRing MvPolynomial

namespace Ideal

section SmoothCharZero

/-- A derivation `Dloc` of a local `k`-algebra `A` that is dual modulo `𝔪` to coordinate `i` of
`t : Fin r → A` (up to `s : A`) acts on a degree-`(n + 1)` homogeneous form `F(t)` as
`(pderiv i F).eval t * s` modulo `𝔪 ^ (n + 1)`. -/
private theorem apply_eval_sub_pderiv_mul_mem_pow_succ {k A : Type*} [CommRing k] [CommRing A]
    [Algebra k A] [IsLocalRing A] (Dloc : Derivation k A A) {r : ℕ} {t : Fin r → A}
    (htmem : ∀ j, t j ∈ maximalIdeal A) {n : ℕ} {F : MvPolynomial (Fin r) A}
    (hF : F.IsHomogeneous (n + 1)) {i : Fin r} {s : A}
    (hDt : ∀ j : Fin r, residue A (Dloc (t j)) = if j = i then residue A s else 0) :
    Dloc (F.eval t) - (pderiv i F).eval t * s ∈ maximalIdeal A ^ (n + 1) := by
  classical
  have hcoeff_mem :
      (∑ e ∈ F.support, Dloc (F.coeff e) * ∏ j, t j ^ e j) ∈ maximalIdeal A ^ (n + 1) :=
    Ideal.sum_mem _ fun e he ↦ Ideal.mul_mem_left _ _ (hF.prod_pow_mem_pow htmem he)
  have hderiv_mem (j : Fin r) : (pderiv j F).eval t ∈ maximalIdeal A ^ n :=
    hF.pderiv.eval_mem_pow htmem
  have htail_mem :
      (∑ j, (pderiv j F).eval t * Dloc (t j)) - (pderiv i F).eval t * s ∈
        maximalIdeal A ^ (n + 1) := by
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ i), add_sub_right_comm, ← mul_sub]
    refine Ideal.add_mem _ ?_ (Ideal.sum_mem _ fun j hj ↦ ?_)
    · rw [pow_succ]
      refine Ideal.mul_mem_mul (hderiv_mem i) ((residue_eq_zero_iff _).mp ?_)
      simp [hDt i]
    · rw [pow_succ]
      refine Ideal.mul_mem_mul (hderiv_mem j) ((residue_eq_zero_iff _).mp ?_)
      simp [hDt j, Finset.ne_of_mem_erase hj]
  rw [Dloc.apply_eval_mvPolynomial F t, add_sub_assoc]
  exact Ideal.add_mem _ hcoeff_mem htail_mem

/-- If a homogeneous form `F` of degree `n + 1` in a regular system of parameters `rs` of `A` has
every global derivation sending `F(rs)` into `𝔪 ^ (n + 1)`, then every partial derivative of
`F.map (residue A)` vanishes. -/
private theorem pderiv_map_residue_eq_zero {k R A : Type*} [Field k] [PerfectField k]
    [CommRing R] [CommRing A] [Algebra k R] [Algebra R A] [Algebra k A] [IsScalarTower k R A]
    [Module.Projective R Ω[R⁄k]] [Module.Finite R Ω[R⁄k]]
    (S : Submonoid R) [IsLocalization S A] [IsRegularLocalRing A]
    {rs : List A} (hofList : ofList rs = maximalIdeal A)
    (hlen : rs.length = (maximalIdeal A).spanFinrank)
    {n : ℕ} {F : MvPolynomial (Fin rs.length) A} (hF : F.IsHomogeneous (n + 1))
    (hD : ∀ δ : Derivation k R R,
      (((Algebra.linearMap R A).compDer δ).extendOfIsLocalization S) (F.eval fun j ↦ rs[j]) ∈
        maximalIdeal A ^ (n + 1)) (i : Fin rs.length) :
    pderiv i (F.map (residue A)) = 0 := by
  classical
  let t : Fin rs.length → A := fun j ↦ rs[j]
  have ht : span (Set.range t) = maximalIdeal A := by
    rw [← hofList, ofList_eq_span_range_getElem]
  have htmem (j : Fin rs.length) : t j ∈ maximalIdeal A := ht ▸ subset_span ⟨j, rfl⟩
  obtain ⟨s, δ, hDt⟩ := Derivation.exists_dual_derivation (k := k) S ht hlen.symm i
  let Dloc : Derivation k A A := ((Algebra.linearMap R A).compDer δ).extendOfIsLocalization S
  have hcongr := apply_eval_sub_pderiv_mul_mem_pow_succ Dloc htmem hF hDt
  have hmul_mem : (pderiv i F).eval t * algebraMap R A s ∈ maximalIdeal A ^ (n + 1) := by
    simpa [Dloc, t] using Ideal.sub_mem _ (hD δ) hcongr
  have hp_eval : (pderiv i F).eval t ∈ maximalIdeal A ^ (n + 1) :=
    (Ideal.mul_unit_mem_iff_mem _ (IsLocalization.map_units A s)).mp hmul_mem
  have hmk : AssociatedGraded.mk (maximalIdeal A) n
      ⟨(pderiv i F).eval t, hF.pderiv.eval_mem_pow htmem⟩ = 0 :=
    (AssociatedGraded.mk_eq_zero_iff _).mpr hp_eval
  rw [pderiv_map, ← TauCeti.IsRegularLocalRing.associatedGradedEquiv_symm_mk_eval hofList hlen.le
    hF.pderiv]
  simpa [t] using congrArg (TauCeti.IsRegularLocalRing.associatedGradedEquiv hofList hlen.le).symm
    hmk

/-- In a regular local localization `A` of `R` with `Ω[R⁄k]` finite projective over a
characteristic-zero field `k`, if `y ∈ 𝔪 ^ (n + 1)` has `D_loc y ∈ 𝔪 ^ (n + 1)` for every global
`k`-derivation `δ : Derivation k R R`, then `y ∈ 𝔪 ^ (n + 2)`. -/
theorem mem_maximalIdeal_pow_add_two_of_forall_derivation {k R A : Type*} [Field k]
    [CharZero k] [CommRing R] [CommRing A] [Algebra k R] [Algebra R A] [Algebra k A]
    [IsScalarTower k R A] [Module.Projective R Ω[R⁄k]] [Module.Finite R Ω[R⁄k]]
    (S : Submonoid R) [IsLocalization S A] [IsRegularLocalRing A] {n : ℕ} {y : A}
    (hy : y ∈ maximalIdeal A ^ (n + 1))
    (hD : ∀ δ : Derivation k R R,
      (((Algebra.linearMap R A).compDer δ).extendOfIsLocalization S) y ∈ maximalIdeal A ^ (n + 1)) :
    y ∈ maximalIdeal A ^ (n + 2) := by
  classical
  -- Choose a regular system of parameters `rs` of `A` and write `y = F(rs)` with `F` homogeneous.
  obtain ⟨U, hcard, hU⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank
    (maximalIdeal A).fg_of_isNoetherianRing
  let rs : List A := U.toList
  have hofList : ofList rs = maximalIdeal A := by
    simpa [rs, ofList] using hU
  have hlen : rs.length = (maximalIdeal A).spanFinrank := by simp [rs, hcard]
  let t : Fin rs.length → A := fun i ↦ rs[i]
  have ht : span (Set.range t) = maximalIdeal A := by
    rw [← hofList, ofList_eq_span_range_getElem]
  obtain ⟨F, hF, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous t y).mp (ht.symm ▸ hy)
  -- Every partial derivative of `F.map (residue A)` vanishes, so Euler's identity kills it.
  have hpderiv_zero := pderiv_map_residue_eq_zero (k := k) S hofList hlen hF hD
  have hchar : CharZero (IsLocalRing.ResidueField A) :=
    charZero_of_injective_algebraMap (algebraMap k (IsLocalRing.ResidueField A)).injective
  have heuler := (hF.map (residue A)).sum_X_mul_pderiv
  simp only [hpderiv_zero, mul_zero, Finset.sum_const_zero] at heuler
  have hFmap : F.map (residue A) = 0 := by
    have hcast : ((n + 1 : ℕ) : IsLocalRing.ResidueField A) • F.map (residue A) = 0 := by
      simpa [← Nat.cast_smul_eq_nsmul (IsLocalRing.ResidueField A)] using heuler.symm
    exact (smul_eq_zero.mp hcast).resolve_left (Nat.cast_ne_zero.mpr (Nat.succ_ne_zero n))
  -- Passing back through the associated graded equivalence puts `F(t)` in `𝔪 ^ (n + 2)`.
  rw [← TauCeti.IsRegularLocalRing.associatedGradedEquiv_symm_mk_eval hofList hlen.le hF,
    map_eq_zero_iff _
      (TauCeti.IsRegularLocalRing.associatedGradedEquiv hofList hlen.le).symm.injective,
    AssociatedGraded.mk_eq_zero_iff] at hFmap
  simpa [t] using hFmap

variable (k : Type*) [Field k] [CharZero k] {R : Type*} [CommRing R] [Algebra k R]

/-- **Over a characteristic-zero field, the derivation ideal satisfies
`(I.derivationIdeal k).orderAt p = I.orderAt p - 1` at a regular prime** (truncated subtraction
in `ℕ∞`, so finite positive order drops by one while `0` and `⊤` remain fixed), assuming
`Ω[R⁄k]` is finitely generated and projective over `R` and `R_p` is regular local. -/
@[simp]
theorem orderAt_derivationIdeal [Module.Projective R Ω[R⁄k]] [Module.Finite R Ω[R⁄k]]
    (I : Ideal R) (p : PrimeSpectrum R) [IsRegularLocalRing (Localization.AtPrime p.asIdeal)] :
    (I.derivationIdeal k).orderAt p = I.orderAt p - 1 := by
  refine le_antisymm ?_
    (tsub_le_iff_right.mpr (orderAt_le_orderAt_derivationIdeal_add_one k I p))
  refine ENat.forall_natCast_le_iff_le.mp fun m hm ↦ ?_
  cases m with
  | zero => simp
  | succ n =>
    refine ENat.le_sub_of_add_le_right ENat.one_ne_top ?_
    have hle : ((n + 2 : ℕ) : ℕ∞) ≤ I.orderAt p := by
      rw [natCast_le_orderAt_iff] at hm ⊢
      rw [Ideal.map_le_iff_le_comap]
      intro f hf
      rw [mem_comap]
      refine mem_maximalIdeal_pow_add_two_of_forall_derivation (k := k) p.asIdeal.primeCompl
        (hm (mem_map_of_mem _ (le_derivationIdeal k I hf))) fun δ ↦ ?_
      rw [Derivation.extendOfIsLocalization_algebraMap]
      exact hm (mem_map_of_mem _ (apply_mem_derivationIdeal k δ hf))
    exact_mod_cast hle

/-- Over a characteristic-zero field, at a regular prime of an algebra with finitely generated
projective differentials, `((derivationIdeal k)^[n] I).orderAt p = I.orderAt p - n`
(truncated subtraction in `ℕ∞`). -/
@[simp]
theorem orderAt_derivationIdeal_iterate [Module.Projective R Ω[R⁄k]] [Module.Finite R Ω[R⁄k]]
    (I : Ideal R) (p : PrimeSpectrum R) [IsRegularLocalRing (Localization.AtPrime p.asIdeal)]
    (n : ℕ) :
    ((derivationIdeal k)^[n] I).orderAt p = I.orderAt p - n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Function.iterate_succ_apply', orderAt_derivationIdeal, ih, tsub_tsub, Nat.cast_succ]

/-- Over a characteristic-zero field, at a regular prime of an algebra with finitely generated
projective differentials, an ideal has order at least `n + 1` precisely when its `n`-th iterated
derivation ideal lies in that prime. -/
theorem natCast_add_one_le_orderAt_iff_iterate_derivationIdeal_le [Module.Projective R Ω[R⁄k]]
    [Module.Finite R Ω[R⁄k]] (I : Ideal R) (p : PrimeSpectrum R)
    [IsRegularLocalRing (Localization.AtPrime p.asIdeal)] (n : ℕ) :
    ((n + 1 : ℕ) : ℕ∞) ≤ I.orderAt p ↔ (derivationIdeal k)^[n] I ≤ p.asIdeal := by
  rw [← one_le_orderAt_iff, orderAt_derivationIdeal_iterate k]
  cases h : I.orderAt p with
  | top => simp
  | coe a =>
    rw [← ENat.natCast_sub]
    norm_cast
    omega

/-- Over a characteristic-zero field, on a regular ring with finitely generated projective
differentials, the order-threshold locus `{p | n + 1 ≤ I.orderAt p}` is the zero locus of the
`n`-th iterated derivation ideal. -/
theorem setOf_natCast_add_one_le_orderAt_eq_zeroLocus [Module.Projective R Ω[R⁄k]]
    [Module.Finite R Ω[R⁄k]] [IsRegularRing R] (I : Ideal R) (n : ℕ) :
    {p : PrimeSpectrum R | ((n + 1 : ℕ) : ℕ∞) ≤ I.orderAt p} =
      PrimeSpectrum.zeroLocus (((derivationIdeal k)^[n] I) : Set R) := by
  ext p
  simp only [Set.mem_ofPred_eq, PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
  exact natCast_add_one_le_orderAt_iff_iterate_derivationIdeal_le k I p n

/-- **Order-threshold loci are Zariski closed.** Over a characteristic-zero field, on a regular
ring with finitely generated projective differentials, `{p | c ≤ I.orderAt p}` is closed in
`PrimeSpectrum R` for every `c : ℕ∞` (including `c = ⊤`). -/
theorem isClosed_setOf_le_orderAt [Module.Projective R Ω[R⁄k]] [Module.Finite R Ω[R⁄k]]
    [IsRegularRing R] (I : Ideal R) (c : ℕ∞) :
    IsClosed {p : PrimeSpectrum R | c ≤ I.orderAt p} := by
  cases c with
  | top =>
    have heq : {p : PrimeSpectrum R | (⊤ : ℕ∞) ≤ I.orderAt p} =
        ⋂ n : ℕ, {p : PrimeSpectrum R | ((n + 1 : ℕ) : ℕ∞) ≤ I.orderAt p} := by
      ext p
      simp only [Set.mem_ofPred_eq, Set.mem_iInter, top_le_iff]
      cases h : I.orderAt p with
      | top => simp
      | coe a =>
        simp only [ENat.natCast_ne_top, false_iff, not_forall]
        exact ⟨a, by norm_cast; omega⟩
    rw [heq]
    refine isClosed_iInter fun n ↦ ?_
    rw [setOf_natCast_add_one_le_orderAt_eq_zeroLocus k I n]
    exact PrimeSpectrum.isClosed_zeroLocus _
  | coe d =>
    cases d with
    | zero => simp
    | succ n =>
      rw [setOf_natCast_add_one_le_orderAt_eq_zeroLocus k I n]
      exact PrimeSpectrum.isClosed_zeroLocus _

/-- On a smooth algebra over a characteristic-zero field, every order-threshold locus
`{p | c ≤ I.orderAt p}` is Zariski closed. -/
theorem isClosed_setOf_le_orderAt_of_smooth [Algebra.Smooth k R] (I : Ideal R) (c : ℕ∞) :
    IsClosed {p : PrimeSpectrum R | c ≤ I.orderAt p} := by
  have : IsRegularRing R := TauCeti.IsRegularRing.of_smooth (R := k)
  exact isClosed_setOf_le_orderAt k I c

/-- On a regular algebra of finite type over a characteristic-zero field, every order-threshold
locus `{p | c ≤ I.orderAt p}` is Zariski closed. -/
theorem isClosed_setOf_le_orderAt_of_finiteType [Algebra.FiniteType k R] [IsRegularRing R]
    (I : Ideal R) (c : ℕ∞) :
    IsClosed {p : PrimeSpectrum R | c ≤ I.orderAt p} := by
  have : Algebra.Smooth k R := TauCeti.smooth_of_isRegularRing (k := k)
  exact isClosed_setOf_le_orderAt k I c

end SmoothCharZero

end Ideal
