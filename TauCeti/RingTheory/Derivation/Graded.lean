module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.Algebra.DirectSum.Decomposition
public import Mathlib.Algebra.GradedMonoid
import Mathlib.Algebra.GroupWithZero.Action.Defs

/-!
# Vanishing of graded Leibniz maps on generated algebras

A linear map `D : B →ₗ[R] A` out of an `R`-algebra `B` that satisfies a graded Leibniz rule along
a unital map `f : B → A`,

`D (a * b) = D a * f b + s i • (f a * D b)` for `a ∈ ℬ i`,

with invertible scalar signs `s i` acting on `A`, annihilates `1` (setting `a = b = 1` in the
degree-`0` piece `ℬ 0`) and therefore annihilates every product of homogeneous elements on which
`D` vanishes. By `Submonoid.closure_induction_left` and `Algebra.adjoin_eq_span`, `D` vanishes on
the entire subalgebra generated by any set `t` of homogeneous elements on which it vanishes.

Only left-factor homogeneity and `1 ∈ ℬ 0` (`SetLike.GradedOne ℬ`) are used: neither a direct-sum
decomposition nor graded multiplicativity of `ℬ` is required on `B`. When `B` is generated by the
image of an additive homomorphism `gen` out of a directly decomposed source `𝒱` sending each piece
into homogeneous elements of `ℬ`, vanishing on the homogeneous generators `gen x` (`x ∈ 𝒱 k`)
implies `D = 0`.

This provides the grading-independent uniqueness scaffolding shared by odd derivations of
`TauCeti.SignedSym` and `TauCeti.ParitySignedSym`.

## Main results

* `TauCeti.apply_eq_zero_of_mem_adjoin_of_leibniz`: a graded Leibniz map vanishing on a set of
  homogeneous elements vanishes on the subalgebra they generate.
* `TauCeti.eq_zero_of_adjoin_eq_top_of_leibniz`: a graded Leibniz map vanishing on a homogeneous
  generating set of the algebra is zero.
* `TauCeti.eq_zero_of_adjoin_range_eq_top_of_leibniz`: a graded Leibniz map on an algebra generated
  by an additive map from a directly decomposed source is zero once it vanishes on the images of
  homogeneous elements.
-/

public section

namespace TauCeti

section Adjoin

variable {ι R B A G σ : Type*} [Zero ι] [CommSemiring R] [Semiring B] [Algebra R B]
  [NonAssocSemiring A] [IsLeftCancelAdd A] [Module R A]
  [Group G] [DistribMulAction G A] [SetLike σ B]
  {ℬ : ι → σ} [SetLike.GradedOne ℬ]

/-- A linear map out of an `R`-algebra satisfying a graded Leibniz rule along a unital map
`f : B → A`, with invertible scalar signs `s i` acting on the target, vanishes on the subalgebra
generated by any set `t` of homogeneous elements on which it vanishes. -/
theorem apply_eq_zero_of_mem_adjoin_of_leibniz
    (s : ι → G) (f : B → A) (hf1 : f 1 = 1) {D : B →ₗ[R] A}
    (hD : ∀ {i : ι} {a : B}, a ∈ ℬ i → ∀ b : B, D (a * b) = D a * f b + s i • (f a * D b))
    {t : Set B} (hhom : ∀ a ∈ t, SetLike.IsHomogeneousElem ℬ a) (ht : ∀ a ∈ t, D a = 0)
    {a : B} (ha : a ∈ Algebra.adjoin R t) : D a = 0 := by
  have hone : D 1 = 0 := by
    have h := hD (SetLike.one_mem_graded ℬ) 1
    simp only [hf1, mul_one, one_mul, left_eq_add] at h
    exact (smul_eq_zero_iff_eq (s 0)).1 h
  have hmon : ∀ x ∈ Submonoid.closure t, D x = 0 := by
    intro x hx
    induction hx using Submonoid.closure_induction_left with
    | one => exact hone
    | mul_left y hy z _ hz =>
      obtain ⟨i, hi⟩ := hhom y hy
      rw [hD hi z, ht y hy, hz, zero_mul, mul_zero, zero_add, smul_zero]
  have hle : Submodule.span R (Submonoid.closure t : Set B) ≤ LinearMap.ker D :=
    Submodule.span_le.2 fun x hx ↦ hmon x hx
  exact hle (by rwa [← Algebra.adjoin_eq_span])

/-- A linear map out of an `R`-algebra satisfying a graded Leibniz rule along a unital map
`f : B → A`, with invertible scalar signs `s i`, is zero as soon as it vanishes on a generating
set of homogeneous elements. -/
theorem eq_zero_of_adjoin_eq_top_of_leibniz
    (s : ι → G) (f : B → A) (hf1 : f 1 = 1) {D : B →ₗ[R] A}
    (hD : ∀ {i : ι} {a : B}, a ∈ ℬ i → ∀ b : B, D (a * b) = D a * f b + s i • (f a * D b))
    {t : Set B} (htop : Algebra.adjoin R t = ⊤)
    (hhom : ∀ a ∈ t, SetLike.IsHomogeneousElem ℬ a) (ht : ∀ a ∈ t, D a = 0) : D = 0 :=
  LinearMap.ext fun _ ↦
    apply_eq_zero_of_mem_adjoin_of_leibniz (ℬ := ℬ) s f hf1 hD hhom ht
      (htop.symm ▸ Algebra.mem_top)

end Adjoin

section Decomposition

variable {ι κ R V B A G σ τ F : Type*} [Zero ι] [DecidableEq κ] [CommSemiring R] [Semiring B]
  [Algebra R B] [NonAssocSemiring A] [IsLeftCancelAdd A] [Module R A]
  [Group G] [DistribMulAction G A] [AddCommMonoid V]
  [SetLike σ B] [SetLike τ V] [AddSubmonoidClass τ V]
  [FunLike F V B] [AddMonoidHomClass F V B]
  {ℬ : ι → σ} [SetLike.GradedOne ℬ]

/-- A linear map out of an `R`-algebra generated by the image of an additive homomorphism `gen`
from a directly decomposed source `𝒱`, satisfying a graded Leibniz rule along a unital map
`f : B → A` with invertible scalar signs `s i`, is zero as soon as it vanishes on the homogeneous
generators `gen x` (`x ∈ 𝒱 k`). -/
theorem eq_zero_of_adjoin_range_eq_top_of_leibniz
    (𝒱 : κ → τ) [DirectSum.Decomposition 𝒱]
    (s : ι → G) (f : B → A) (hf1 : f 1 = 1) (gen : F)
    (htop : Algebra.adjoin R (Set.range gen) = ⊤)
    (hgen_mem : ∀ {k : κ} {x : V}, x ∈ 𝒱 k → SetLike.IsHomogeneousElem ℬ (gen x))
    {D : B →ₗ[R] A}
    (hD : ∀ {i : ι} {a : B}, a ∈ ℬ i → ∀ b : B, D (a * b) = D a * f b + s i • (f a * D b))
    (hgen : ∀ {k : κ} {x : V}, x ∈ 𝒱 k → D (gen x) = 0) : D = 0 := by
  have htop' : Algebra.adjoin R (⋃ k : κ, gen '' (𝒱 k : Set V)) = ⊤ := by
    rw [← htop]
    refine le_antisymm
      (Algebra.adjoin_mono (Set.iUnion_subset fun _ ↦ Set.image_subset_range _ _)) ?_
    rw [Algebra.adjoin_le_iff]
    rintro _ ⟨x, rfl⟩
    change gen x ∈ Algebra.adjoin R (⋃ k : κ, gen '' (𝒱 k : Set V))
    induction x using DirectSum.Decomposition.inductionOn 𝒱 with
    | zero => simp
    | @homogeneous k x => exact Algebra.subset_adjoin (Set.mem_iUnion.2 ⟨k, x, x.2, rfl⟩)
    | add x y hx hy => simpa only [map_add] using add_mem hx hy
  refine eq_zero_of_adjoin_eq_top_of_leibniz (ℬ := ℬ) s f hf1 hD htop' ?_ ?_
  · rintro _ ⟨_, ⟨k, rfl⟩, x, hx, rfl⟩
    exact hgen_mem hx
  · rintro _ ⟨_, ⟨k, rfl⟩, x, hx, rfl⟩
    exact hgen hx

end Decomposition

end TauCeti
