/-!
# Differential operators in coordinates

Let `A` be a commutative algebra over a commutative ring `R` containing `ℚ`, with *coordinates*
`uᵢ ∈ A` indexed by a finite type `ι` and pairwise commuting derivations `∂ᵢ` of `A` dual to
them, `∂ᵢ uⱼ = δᵢⱼ`. Suppose that `A` has a family of *points* `ev x : A →ₐ[R] R` at which
Hadamard's lemma holds: the kernel of `ev x` is the ideal generated by the `uᵢ - uᵢ(x)`. The
model is the algebra of smooth functions on `ℝⁿ`, with the coordinate functions, the partial
derivatives and the evaluations at points.

If the points separate an `A`-module `N`, in the sense that an element of `N` lying in
`ker (ev x) • N` for every `x` is zero, then the differential operators `A → N` of order at most
`m`, in Grothendieck's sense of iterated commutators with multiplication operators
(`TauCeti.differentialOperators`), are exactly the finite coordinate expressions

`f ↦ ∑_{|α| ≤ m} (∂^α f) • c_α`,

with coefficients `c_α ∈ N` that are uniquely determined, and explicit: at a point `x`, `c_α`
agrees with `D ((u - u(x)) ^ α) / α!` modulo `ker (ev x) • N`. The proof goes through jets:
modulo the `(m + 1)`-st power of the kernel of a point, every element is a combination of the
monomials of degree at most `m` in the `uᵢ - uᵢ(x)`, on which `∂^α` evaluates at `x` to
`α! δ_{αβ}`.

## Main definitions

* `TauCeti.multiIndexDeriv d hd α`: the monomial `∂^α = ∏ᵢ ∂ᵢ ^ αᵢ` in commuting derivations.
* `TauCeti.coordinateOperator d hd m c`: the coordinate expression
  `f ↦ ∑_{|α| ≤ m} (∂^α f) • c α`.
* `TauCeti.coordinateCoeff u D α`: the coefficient
  `(α!)⁻¹ ∑_{γ ≤ α} (α choose γ) (-u) ^ (α - γ) • D (u ^ γ)` of `D`.

## Main results

* `TauCeti.multiIndexDeriv_mem_differentialOperators`,
  `TauCeti.coordinateOperator_mem_differentialOperators`: coordinate expressions of order `m`
  are differential operators of order at most `m`.
* `TauCeti.apply_multiIndexDeriv_prod_pow`: `∂^α` of a monomial `t ^ β` in coordinates vanishing
  at a point evaluates there to `β!` if `α = β`, and to zero otherwise.
* `TauCeti.exists_sub_mem_pow_succ`: jets at a point are spanned by monomials in the coordinates.
* `TauCeti.eq_coordinateOperator_coordinateCoeff`: a differential operator of order at most `m`
  is the coordinate expression with coefficients `TauCeti.coordinateCoeff u D`.
* `TauCeti.mem_differentialOperators_iff_exists_eq_coordinateOperator`: the characterization.
* `TauCeti.coordinateOperator_eq_zero_iff`: uniqueness of the coefficients.

## References

* I. Kolář, P. W. Michor, J. Slovák, *Natural Operations in Differential Geometry*, Springer,
  1993, §§12, 19.
* A. Grothendieck, *Éléments de géométrie algébrique IV*, Quatrième partie, §16.8.
-/

public section

open Finset
open scoped Nat

noncomputable section

namespace TauCeti

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] {ι : Type*} [Fintype ι]

/-! ### Monomials in commuting derivations -/

/-- The monomial `∂^α = ∏ᵢ ∂ᵢ ^ αᵢ` in pairwise commuting derivations `∂ᵢ` of `A`, for a
multi-index `α : ι → ℕ`, as an `R`-linear endomorphism of `A`. -/
def multiIndexDeriv (d : ι → Derivation R A A)
    (hd : ∀ i j, Commute (d i : Module.End R A) (d j)) (α : ι → ℕ) : Module.End R A :=
  univ.noncommProd (fun i ↦ (d i : Module.End R A) ^ α i)
    (by intro i _ j _ _; exact (hd i j).pow_pow (α i) (α j))

variable (d : ι → Derivation R A A) (hd : ∀ i j, Commute (d i : Module.End R A) (d j))

@[simp]
theorem multiIndexDeriv_zero : multiIndexDeriv d hd 0 = 1 :=
  (noncommProd_eq_pow_card _ _ _ 1 fun _ _ ↦ pow_zero _).trans (one_pow _)

/-- Monomials in commuting derivations multiply by adding their multi-indices. -/
theorem multiIndexDeriv_add (α β : ι → ℕ) :
    multiIndexDeriv d hd (α + β) = multiIndexDeriv d hd α * multiIndexDeriv d hd β := by
  have comm (γ : ι → ℕ) : ((univ : Finset ι) : Set ι).Pairwise
      (Function.onFun Commute fun j ↦ (d j : Module.End R A) ^ γ j) :=
    fun j _ k _ _ ↦ (hd j k).pow_pow _ _
  calc multiIndexDeriv d hd (α + β)
      = univ.noncommProd
          ((fun j ↦ (d j : Module.End R A) ^ α j) * fun j ↦ (d j : Module.End R A) ^ β j)
          (noncommProd_mul_distrib_aux (comm α) (comm β) fun j _ k _ _ ↦ (hd j k).pow_pow _ _) :=
        noncommProd_congr rfl (fun j _ ↦ by simp [pow_add]) _
    _ = multiIndexDeriv d hd α * multiIndexDeriv d hd β :=
        noncommProd_mul_distrib _ _ (comm α) (comm β) fun j _ k _ _ ↦ (hd j k).pow_pow _ _

@[simp]
theorem multiIndexDeriv_single [DecidableEq ι] (i : ι) (k : ℕ) :
    multiIndexDeriv d hd (Pi.single i k) = d i ^ k := by
  refine (mul_noncommProd_erase univ (mem_univ i)
    (fun j ↦ (d j : Module.End R A) ^ Pi.single i k j)
    fun j _ l _ _ ↦ (hd j l).pow_pow _ _).symm.trans ?_
  refine (congrArg (_ * ·) (Finset.noncommProd_eq_pow_card _ _ _ 1
    fun j hj ↦ by simp [ne_of_mem_erase hj])).trans ?_
  simp

theorem multiIndexDeriv_add_single [DecidableEq ι] (α : ι → ℕ) (i : ι) :
    multiIndexDeriv d hd (α + Pi.single i 1) = multiIndexDeriv d hd α * d i := by
  rw [multiIndexDeriv_add, multiIndexDeriv_single, pow_one]

/-- A monomial `∂^α` in derivations is a differential operator of order at most `|α|`. -/
theorem multiIndexDeriv_mem_differentialOperators (α : ι → ℕ) :
    multiIndexDeriv d hd α ∈ differentialOperators R A A A (∑ i, α i) := by
  classical
  suffices h : ∀ (s : Finset ι) (comm),
      s.noncommProd (fun i ↦ (d i : Module.End R A) ^ α i) comm ∈
        differentialOperators R A A A (∑ i ∈ s, α i) from h univ _
  intro s
  induction s using Finset.induction_on with
  | empty => intro; simpa using SetLike.one_mem_graded (differentialOperators R A A A)
  | insert i s hi ih =>
    intro comm
    rw [noncommProd_insert_of_notMem _ _ _ _ hi, sum_insert hi]
    refine SetLike.mul_mem_graded ?_ (ih _)
    simpa using SetLike.pow_mem_graded (α i) (d i).mem_differentialOperators_one

/-! ### Monomials in the coordinates -/

/-- A derivation dual to the `i`-th coordinate differentiates a monomial `∏ⱼ tⱼ ^ βⱼ` in the
coordinates to `βᵢ ∏ⱼ tⱼ ^ (β - eᵢ)ⱼ`. -/
theorem _root_.Derivation.apply_prod_pow_of_apply_eq [DecidableEq ι] (δ : Derivation R A A)
    {t : ι → A} {i : ι} (ht : ∀ j, δ (t j) = if j = i then 1 else 0) (β : ι → ℕ) :
    δ (∏ j, t j ^ β j) = β i • ∏ j, t j ^ (β - Pi.single i 1 : ι → ℕ) j := by
  have hrest : δ (∏ j ∈ univ.erase i, t j ^ β j) = 0 :=
    prod_induction _ (fun a ↦ δ a = 0) (fun a b ha hb ↦ by simp [Derivation.leibniz, ha, hb])
      (by simp) fun j hj ↦ by simp [Derivation.leibniz_pow, ht, ne_of_mem_erase hj]
  have hcongr : ∏ j ∈ univ.erase i, t j ^ (β - Pi.single i 1 : ι → ℕ) j =
      ∏ j ∈ univ.erase i, t j ^ β j :=
    prod_congr rfl fun j hj ↦ by simp [ne_of_mem_erase hj]
  rw [← mul_prod_erase univ _ (mem_univ i), ← mul_prod_erase univ _ (mem_univ i), hcongr,
    Derivation.leibniz, hrest, Derivation.leibniz_pow, ht]
  simp only [ite_true, smul_eq_mul, mul_one, nsmul_eq_mul, Pi.sub_apply,
    Pi.single_eq_same]
  ring

/-- At a point `χ` where the coordinates `tⱼ` vanish, `∂^α` of the monomial `∏ⱼ tⱼ ^ βⱼ` is
`β! = ∏ⱼ βⱼ!` when `α = β` and zero otherwise. -/
theorem apply_multiIndexDeriv_prod_pow [DecidableEq ι] (χ : A →ₐ[R] R) {t : ι → A}
    (hdt : ∀ i j, d i (t j) = if j = i then 1 else 0) (ht : ∀ j, χ (t j) = 0)
    (α β : ι → ℕ) :
    χ (multiIndexDeriv d hd α (∏ j, t j ^ β j)) =
      if α = β then ((∏ j, (β j)! : ℕ) : R) else 0 := by
  -- Induction on `|α|`: for `α = α' + eᵢ`, first apply `∂ᵢ`, which turns `t ^ β` into
  -- `βᵢ t ^ (β - eᵢ)`, then use the claim for `α'` and `β - eᵢ`.
  induction h : ∑ j, α j generalizing α β with
  | zero =>
    obtain rfl : α = 0 := funext fun j ↦ (sum_eq_zero_iff.1 h) j (mem_univ j)
    simp only [multiIndexDeriv_zero, one_apply_eq_self, map_prod, map_pow, ht]
    split_ifs with hβ
    · subst hβ
      simp
    · obtain ⟨j, hj⟩ : ∃ j, β j ≠ 0 := by
        by_contra! hc
        exact hβ (funext fun j ↦ (hc j).symm)
      exact prod_eq_zero (mem_univ j) (zero_pow hj)
  | succ n ih =>
    obtain ⟨i, hi⟩ : ∃ i, α i ≠ 0 := by
      by_contra! hc
      simp [hc] at h
    set α' := α - Pi.single i 1
    have hα : α = α' + Pi.single i 1 := by
      ext j
      by_cases hj : j = i
      · subst hj
        simp [α']
        omega
      · simp [α', hj]
    have hα' : ∑ j, α' j = n := by
      simp only [hα, Pi.add_apply, sum_add_distrib, Fintype.sum_pi_single'] at h
      omega
    rw [hα, multiIndexDeriv_add_single, mul_apply_eq_comp, Derivation.coeFn_coe,
      (d i).apply_prod_pow_of_apply_eq (hdt i), map_nsmul, map_nsmul, ih α' _ hα']
    by_cases hβ : β i = 0
    · rw [hβ, zero_smul, eq_comm, ite_eq_right_iff]
      intro h
      have := congrFun h i
      simp [hβ] at this
    have hiff : α' = β - Pi.single i 1 ↔ α' + Pi.single i 1 = β := by
      constructor
      · intro h
        rw [h]
        ext j
        by_cases hj : j = i
        · subst hj
          simp
          omega
        · simp [hj]
      · intro h
        rw [← h]
        ext j
        simp
    simp only [hiff]
    -- It remains to check `βᵢ (β - eᵢ)! = β!`.
    split_ifs
    · rw [nsmul_eq_mul, ← Nat.cast_mul, ← mul_prod_erase univ _ (mem_univ i),
        ← mul_prod_erase univ _ (mem_univ i), ← mul_assoc]
      congr 2
      · simp only [Pi.sub_apply, Pi.single_eq_same]
        exact Nat.mul_factorial_pred hβ
      · exact prod_congr rfl fun j hj ↦ by simp [ne_of_mem_erase hj]
    · simp

/-! ### Jets at a point are spanned by monomials -/

section Point

variable {χ : A →ₐ[R] R} {t : ι → A}

/-- If the kernel of a point `χ : A →ₐ[R] R` is generated by elements `tⱼ` vanishing at `χ`,
then every element of its `n`-th power agrees, modulo the `(n + 1)`-st power, with an `R`-linear
combination of the monomials of degree `n` in the `tⱼ`. -/
theorem exists_sub_mem_pow_succ (ht : ∀ j, χ (t j) = 0)
    (hI : RingHom.ker χ ≤ Ideal.span (Set.range t)) (n : ℕ) {g : A}
    (hg : g ∈ RingHom.ker χ ^ n) :
    ∃ q ∈ Submodule.span R {a | ∃ β : ι → ℕ, ∑ j, β j = n ∧ ∏ j, t j ^ β j = a},
      g - q ∈ RingHom.ker χ ^ (n + 1) := by
  classical
  set I := RingHom.ker χ
  have htI (j : ι) : t j ∈ I := ht j
  have hsubI (a : A) : a - algebraMap R A (χ a) ∈ I := by simp [I]
  induction n generalizing g with
  | zero =>
    refine ⟨χ g • ∏ j, t j ^ (0 : ι → ℕ) j,
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨0, by simp, rfl⟩), ?_⟩
    simpa [Algebra.smul_def] using hsubI g
  | succ n ih =>
    rw [pow_succ] at hg
    refine Submodule.mul_induction_on hg (fun a ha b hb ↦ ?_) fun x y ⟨q, hq, hxq⟩ ⟨q', hq', hyq⟩ ↦
      ⟨q + q', add_mem hq hq', by simpa [sub_add_sub_comm] using add_mem hxq hyq⟩
    obtain ⟨q, hq, haq⟩ := ih ha
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun A).1 (hI hb)
    have hqI : q ∈ I ^ n := by
      refine (Submodule.span_le (p := (I ^ n).restrictScalars R)).2 ?_ hq
      rintro _ ⟨β, hβ, rfl⟩
      simpa [hβ, prod_pow_eq_pow_sum] using Ideal.prod_mem_prod (s := univ)
        (I := fun j ↦ I ^ β j) fun j _ ↦ Ideal.pow_mem_pow (htI j) _
    refine ⟨∑ j, χ (c j) • (q * t j), sum_mem fun j _ ↦ Submodule.smul_mem _ _ ?_, ?_⟩
    · refine Submodule.span_induction (p := fun q _ ↦ q * t j ∈ Submodule.span R
        {a | ∃ β : ι → ℕ, ∑ j, β j = n + 1 ∧ ∏ j, t j ^ β j = a}) ?_ (by simp)
        (fun x y _ _ hx hy ↦ by simpa [add_mul] using add_mem hx hy)
        (fun r x _ hx ↦ by simpa [smul_mul_assoc] using Submodule.smul_mem _ r hx) hq
      rintro _ ⟨β, hβ, rfl⟩
      refine Submodule.subset_span ⟨β + Pi.single j 1, by simp [sum_add_distrib, hβ], ?_⟩
      simp only [Pi.add_apply, pow_add, prod_mul_distrib]
      congr 1
      rw [prod_eq_single j (fun k _ hk ↦ by simp [hk]) (by simp)]
      simp
    · have key : a * ∑ j, c j • t j - ∑ j, χ (c j) • (q * t j) =
          ∑ j, ((a - q) * c j * t j + q * (c j - algebraMap R A (χ (c j))) * t j) := by
        rw [mul_sum, ← sum_sub_distrib]
        refine sum_congr rfl fun j _ ↦ ?_
        rw [smul_eq_mul, Algebra.smul_def]
        ring
      rw [key, pow_succ]
      refine sum_mem fun j _ ↦ add_mem (Ideal.mul_mem_mul (Ideal.mul_mem_right _ _ haq) (htI j))
        (Ideal.mul_mem_mul ?_ (htI j))
      rw [pow_succ]
      exact Ideal.mul_mem_mul hqI (hsubI (c j))

variable {N : Type*} [AddCommGroup N] [Module A N] [Module R N] [IsScalarTower R A N]

/-- Modulo `ker χ • N`, the action of `a` on `N` agrees with that of its value `χ a`. -/
theorem _root_.AlgHom.smul_sub_smul_mem_smul_top (χ : A →ₐ[R] R) (a : A) (x : N) :
    a • x - χ a • x ∈ RingHom.ker χ • (⊤ : Submodule A N) := by
  rw [← algebraMap_smul A (χ a) x, ← sub_smul]
  exact Submodule.smul_mem_smul (by simp) Submodule.mem_top

/-- Let the kernel of a point `χ` be generated by elements `tⱼ` vanishing at `χ`. If a
differential operator of order at most `m` maps every monomial of degree at most `m` in the `tⱼ`
into `ker χ • N`, then it maps every element into `ker χ • N`: modulo `ker χ`, its values only
depend on `m`-jets at `χ`, which are spanned by these monomials. -/
theorem apply_mem_smul_top_of_forall_prod_pow_mem {m : ℕ} {D : A →ₗ[R] N}
    (hD : D ∈ differentialOperators R A A N m) (ht : ∀ j, χ (t j) = 0)
    (hI : RingHom.ker χ ≤ Ideal.span (Set.range t))
    (hmono : ∀ β : ι → ℕ, ∑ j, β j ≤ m →
      D (∏ j, t j ^ β j) ∈ RingHom.ker χ • (⊤ : Submodule A N)) (f : A) :
    D f ∈ RingHom.ker χ • (⊤ : Submodule A N) := by
  set I := RingHom.ker χ
  let K : Submodule R A := ((I • ⊤ : Submodule A N).restrictScalars R).comap D
  -- Downward induction on the power of `I`: `I ^ (m + 1)` lies in `K`, and each lower power is
  -- spanned modulo the next one by monomials of degree at most `m`.
  have hpow : ∀ k ≤ m + 1, ∀ g ∈ I ^ (m + 1 - k), g ∈ K := by
    intro k
    induction k with
    | zero =>
      intro _ g hg
      refine apply_mem_smul_top_of_mem_pow_smul_top hD I ?_
      rwa [Ideal.smul_eq_mul, Ideal.mul_top]
    | succ k ih =>
      intro hk g hg
      obtain ⟨q, hq, hgq⟩ := exists_sub_mem_pow_succ ht hI (m + 1 - (k + 1)) hg
      have hqK : q ∈ K := by
        refine Submodule.span_le.2 ?_ hq
        rintro _ ⟨β, hβ, rfl⟩
        exact hmono β (by omega)
      have hgqK : g - q ∈ K := ih (by omega) _ (by rwa [show m + 1 - (k + 1) + 1 = m + 1 - k by
        omega] at hgq)
      simpa using add_mem hgqK hqK
  exact hpow (m + 1) le_rfl f (by simp)

end Point

/-! ### Coordinate expressions -/

section CoordinateOperator

variable [DecidableEq ι] {N : Type*} [AddCommGroup N] [Module A N] [Module R N]
  [IsScalarTower R A N]

/-- The coordinate expression `f ↦ ∑_{|α| ≤ m} (∂^α f) • c α` of order `m` with coefficients
`c α ∈ N`, where `|α| = ∑ᵢ αᵢ`. Only the coefficients with `|α| ≤ m` enter. -/
def coordinateOperator (m : ℕ) (c : (ι → ℕ) → N) : A →ₗ[R] N :=
  ∑ k ∈ range (m + 1), ∑ α ∈ piAntidiag univ k,
    (LinearMap.toSpanSingleton A N (c α)).restrictScalars R ∘ₗ multiIndexDeriv d hd α

@[simp]
theorem coordinateOperator_apply (m : ℕ) (c : (ι → ℕ) → N) (f : A) :
    coordinateOperator d hd m c f =
      ∑ k ∈ range (m + 1), ∑ α ∈ piAntidiag univ k, multiIndexDeriv d hd α f • c α := by
  simp [coordinateOperator]

/-- A coordinate expression of order `m` is a differential operator of order at most `m`. -/
theorem coordinateOperator_mem_differentialOperators (m : ℕ) (c : (ι → ℕ) → N) :
    coordinateOperator d hd m c ∈ differentialOperators R A A N m := by
  refine sum_mem fun k hk ↦ sum_mem fun α hα ↦ ?_
  rw [mem_piAntidiag] at hα
  refine differentialOperators_mono (show k ≤ m by simpa [Nat.lt_succ_iff] using hk) ?_
  simpa [hα.1] using comp_mem_differentialOperators
    (LinearMap.restrictScalars_mem_differentialOperators_zero _)
    (multiIndexDeriv_mem_differentialOperators d hd α)

/-- At a point `χ` where the coordinates `tⱼ` dual to the `∂ᵢ` vanish, a coordinate expression
sends the monomial `∏ⱼ tⱼ ^ βⱼ`, `|β| ≤ m`, to `β! • c β` modulo `ker χ • N`. -/
theorem coordinateOperator_apply_prod_pow_sub_mem {χ : A →ₐ[R] R} {t : ι → A}
    (hdt : ∀ i j, d i (t j) = if j = i then 1 else 0) (ht : ∀ j, χ (t j) = 0) {m : ℕ}
    (c : (ι → ℕ) → N) {β : ι → ℕ} (hβ : ∑ j, β j ≤ m) :
    coordinateOperator d hd m c (∏ j, t j ^ β j) - ((∏ j, (β j)! : ℕ) : R) • c β ∈
      RingHom.ker χ • (⊤ : Submodule A N) := by
  have hcollapse : ∑ k ∈ range (m + 1), ∑ α ∈ piAntidiag univ k,
      χ (multiIndexDeriv d hd α (∏ j, t j ^ β j)) • c α = ((∏ j, (β j)! : ℕ) : R) • c β := by
    simp only [apply_multiIndexDeriv_prod_pow d hd χ hdt ht, ite_smul, zero_smul, sum_ite_eq',
      mem_piAntidiag, mem_univ, implies_true, and_true]
    rw [sum_ite_eq]
    simp [hβ]
  rw [coordinateOperator_apply, ← hcollapse, ← sum_sub_distrib]
  exact sum_mem fun k _ ↦ by
    rw [← sum_sub_distrib]
    exact sum_mem fun α _ ↦ χ.smul_sub_smul_mem_smul_top _ _

variable [Algebra ℚ R]

/-- The coefficients of the coordinate expression of `D : A →ₗ[R] N` in the coordinates `u`:
`c α = (α!)⁻¹ ∑_{γ ≤ α} (α choose γ) (-u) ^ (α - γ) • D (u ^ γ)`. At a point `χ` this is
`D ((u - χ u) ^ α) / α!` modulo `ker χ • N`
(`TauCeti.factorial_smul_coordinateCoeff_sub_apply_mem`). -/
def coordinateCoeff (u : ι → A) (D : A →ₗ[R] N) (α : ι → ℕ) : N :=
  algebraMap ℚ R ((∏ i, (α i)! : ℕ) : ℚ)⁻¹ • ∑ γ ∈ Fintype.piFinset fun i ↦ range (α i + 1),
    (∏ i, ((α i).choose (γ i) : A) * (-u i) ^ (α i - γ i)) • D (∏ i, u i ^ γ i)

omit [IsScalarTower R A N] in
/-- The defining formula of `TauCeti.coordinateCoeff`. -/
theorem coordinateCoeff_def (u : ι → A) (D : A →ₗ[R] N) (α : ι → ℕ) :
    coordinateCoeff u D α =
      algebraMap ℚ R ((∏ i, (α i)! : ℕ) : ℚ)⁻¹ • ∑ γ ∈ Fintype.piFinset fun i ↦ range (α i + 1),
        (∏ i, ((α i).choose (γ i) : A) * (-u i) ^ (α i - γ i)) • D (∏ i, u i ^ γ i) :=
  (rfl)

/-- At a point `χ`, `α! • c α` agrees with `D` applied to the monomial `(u - χ u) ^ α` modulo
`ker χ • N`. -/
theorem factorial_smul_coordinateCoeff_sub_apply_mem (χ : A →ₐ[R] R) (u : ι → A)
    (D : A →ₗ[R] N) (α : ι → ℕ) :
    ((∏ i, (α i)! : ℕ) : R) • coordinateCoeff u D α -
        D (∏ i, (u i - algebraMap R A (χ (u i))) ^ α i) ∈
      RingHom.ker χ • (⊤ : Submodule A N) := by
  set coef : (ι → ℕ) → A := fun γ ↦ ∏ i, ((α i).choose (γ i) : A) * (-u i) ^ (α i - γ i)
  have hbin : ∏ i, (u i - algebraMap R A (χ (u i))) ^ α i =
      ∑ γ ∈ Fintype.piFinset fun i ↦ range (α i + 1), χ (coef γ) • ∏ i, u i ^ γ i := by
    simp only [sub_eq_add_neg, add_pow, prod_univ_sum]
    refine sum_congr rfl fun γ _ ↦ ?_
    simp only [coef, map_prod, map_mul, map_pow, map_neg, map_natCast, Algebra.smul_def,
      ← prod_mul_distrib]
    exact prod_congr rfl fun i _ ↦ by ring
  have hfac : ((∏ i, (α i)! : ℕ) : R) * algebraMap ℚ R ((∏ i, (α i)! : ℕ) : ℚ)⁻¹ = 1 := by
    rw [← map_natCast (algebraMap ℚ R), ← map_mul, mul_inv_cancel₀ (by positivity), map_one]
  rw [coordinateCoeff_def, smul_smul, hfac, one_smul, hbin, map_sum, ← sum_sub_distrib]
  exact sum_mem fun γ _ ↦ by
    rw [map_smul]
    exact χ.smul_sub_smul_mem_smul_top _ _

/-! ### The characterization -/

variable {u : ι → A} (hdu : ∀ i j, d i (u j) = if j = i then 1 else 0)
  {X : Type*} (ev : X → A →ₐ[R] R)
  (hker : ∀ x, RingHom.ker (ev x) ≤
    Ideal.span (Set.range fun i ↦ u i - algebraMap R A (ev x (u i))))
  (hsep : ∀ y : N, (∀ x, y ∈ RingHom.ker (ev x) • (⊤ : Submodule A N)) → y = 0)

include hdu hker hsep in
/-- **Differential operators in coordinates.** Let `uᵢ ∈ A` be coordinates with dual commuting
derivations `∂ᵢ`, and let the points `ev x` of `A` have kernels generated by the `uᵢ - uᵢ(x)` and
separate `N`. Then every differential operator `A → N` of order at most `m`, in the sense of
iterated commutators, is the coordinate expression `f ↦ ∑_{|α| ≤ m} (∂^α f) • c α` with the
coefficients `c = TauCeti.coordinateCoeff u D`. -/
theorem eq_coordinateOperator_coordinateCoeff {D : A →ₗ[R] N} {m : ℕ}
    (hD : D ∈ differentialOperators R A A N m) :
    D = coordinateOperator d hd m (coordinateCoeff u D) := by
  ext f
  rw [← sub_eq_zero]
  refine hsep _ fun x ↦ ?_
  have hdt (i j : ι) : d i (u j - algebraMap R A (ev x (u j))) = if j = i then 1 else 0 := by
    simp [hdu]
  have ht (j : ι) : ev x (u j - algebraMap R A (ev x (u j))) = 0 := by simp
  have hT := sub_mem hD (coordinateOperator_mem_differentialOperators d hd m (coordinateCoeff u D))
  refine apply_mem_smul_top_of_forall_prod_pow_mem hT ht (hker x) (fun β hβ ↦ ?_) f
  have h₁ := factorial_smul_coordinateCoeff_sub_apply_mem (ev x) u D β
  have h₂ := coordinateOperator_apply_prod_pow_sub_mem d hd hdt ht (coordinateCoeff u D) hβ
  rw [LinearMap.sub_apply]
  convert neg_mem (add_mem h₂ h₁) using 1
  abel

include hdu hsep in
/-- **Uniqueness of the coordinate expression.** If the points `ev x` of `A`, at which the dual
coordinates `uᵢ - uᵢ(x)` vanish, separate `N`, then a coordinate expression of order `m`
vanishes only when all its coefficients with `|α| ≤ m` vanish. -/
theorem coordinateOperator_eq_zero_iff {m : ℕ} {c : (ι → ℕ) → N} :
    coordinateOperator d hd m c = 0 ↔ ∀ α : ι → ℕ, ∑ i, α i ≤ m → c α = 0 := by
  refine ⟨fun h α hα ↦ hsep _ fun x ↦ ?_, fun h ↦ ?_⟩
  · have hdt (i j : ι) : d i (u j - algebraMap R A (ev x (u j))) = if j = i then 1 else 0 := by
      simp [hdu]
    have ht (j : ι) : ev x (u j - algebraMap R A (ev x (u j))) = 0 := by simp
    have hmem := coordinateOperator_apply_prod_pow_sub_mem d hd hdt ht c hα
    rw [h, LinearMap.zero_apply, zero_sub, neg_mem_iff] at hmem
    have hfac : algebraMap ℚ R ((∏ i, (α i)! : ℕ) : ℚ)⁻¹ * ((∏ i, (α i)! : ℕ) : R) = 1 := by
      rw [← map_natCast (algebraMap ℚ R), ← map_mul, inv_mul_cancel₀ (by positivity), map_one]
    have := Submodule.smul_of_tower_mem _ (algebraMap ℚ R ((∏ i, (α i)! : ℕ) : ℚ)⁻¹) hmem
    rwa [smul_smul, hfac, one_smul] at this
  · ext f
    simp only [coordinateOperator_apply, LinearMap.zero_apply]
    refine sum_eq_zero fun k hk ↦ sum_eq_zero fun α hα ↦ ?_
    rw [mem_piAntidiag] at hα
    rw [h α (by simpa [hα.1, Nat.lt_succ_iff] using hk), smul_zero]

include hdu hker hsep in
/-- **Differential operators in coordinates.** Under the hypotheses of
`TauCeti.eq_coordinateOperator_coordinateCoeff`, the differential operators `A → N` of order at
most `m` are exactly the coordinate expressions `f ↦ ∑_{|α| ≤ m} (∂^α f) • c α`. -/
theorem mem_differentialOperators_iff_exists_eq_coordinateOperator {D : A →ₗ[R] N} {m : ℕ} :
    D ∈ differentialOperators R A A N m ↔ ∃ c, D = coordinateOperator d hd m c :=
  ⟨fun hD ↦ ⟨_, eq_coordinateOperator_coordinateCoeff d hd hdu ev hker hsep hD⟩,
    fun ⟨c, hc⟩ ↦ hc ▸ coordinateOperator_mem_differentialOperators d hd m c⟩

end CoordinateOperator

end TauCeti
