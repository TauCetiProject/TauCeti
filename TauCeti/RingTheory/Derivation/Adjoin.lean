module

public import Mathlib.RingTheory.Derivation.Basic
public import Mathlib.RingTheory.Adjoin.Basic

/-!
# Derivation-stable generated subalgebras

To check stability under a derivation, it suffices to differentiate the algebra generators.
-/

public section

namespace Derivation

/-- The subalgebra generated by `s` is stable under `D` if and only if the derivatives of the
members of `s` belong to it. -/
theorem mapsTo_adjoin_iff {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]
    (D : Derivation R A A) (s : Set A) :
    Set.MapsTo D (Algebra.adjoin R s) (Algebra.adjoin R s) ↔
      Set.MapsTo D s (Algebra.adjoin R s) := by
  constructor
  · exact fun h _ hx ↦ h (Algebra.subset_adjoin hx)
  · intro h x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact h hx
    | algebraMap r => simp
    | add x y _ _ hx hy => exact map_add D x y ▸ (Algebra.adjoin R s).add_mem hx hy
    | mul x y hx hy hDx hDy =>
        rw [D.leibniz, smul_eq_mul, smul_eq_mul]
        exact (Algebra.adjoin R s).add_mem (mul_mem hx hDy) (mul_mem hy hDx)

end Derivation
