module

public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.Derivation.Basic
import TauCeti.RingTheory.Derivation.Basic

/-!
# Local nilpotence of a derivation on generators

A derivation `D` of a commutative algebra `A` is *locally nilpotent* when every element is killed
by some iterate of `D`. The elements killed by an iterate of `D` are closed under sums and, by the
general Leibniz rule, under products, and they contain the scalars. So local nilpotence can be
checked on a generating set of the algebra.

This is the form in which local nilpotence is verified for the invariant vector fields of
nilpotent tangent vectors of matrix groups, where the coordinate algebra is generated by matrix
entries and a few further coordinates.

## Main results

* `Derivation.exists_iterate_mul_eq_zero`: a product of elements killed by iterates of `D` is
  killed by an iterate of `D`.
* `Derivation.exists_iterate_eq_zero_of_mem_adjoin`: every element of the subalgebra generated by
  a set of elements killed by iterates of `D` is killed by an iterate of `D`.
* `Derivation.exists_iterate_eq_zero_of_adjoin_eq_top`: a derivation which is locally nilpotent on
  a generating set is locally nilpotent.

## References

* G. Freudenburg, *Algebraic Theory of Locally Nilpotent Derivations*, Encyclopaedia of
  Mathematical Sciences 136, Springer (2006), §1.1.
-/

public section

namespace Derivation

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A] (D : Derivation R A A)

/-- Once an iterate of a derivation kills an element, every later iterate kills it too. -/
private theorem iterate_eq_zero_of_le {a : A} {m k : ℕ} (ha : D^[m] a = 0) (hmk : m ≤ k) :
    D^[k] a = 0 := by
  rw [← Nat.sub_add_cancel hmk, Function.iterate_add_apply, ha]
  exact Function.iterate_fixed (map_zero D) _

/-- A product of two elements killed by iterates of a derivation is killed by an iterate of the
derivation: if `Dᵐ a = 0` and `Dⁿ b = 0`, then `Dᵐ⁺ⁿ (a * b) = 0`. -/
theorem exists_iterate_mul_eq_zero {a b : A} (ha : ∃ m, D^[m] a = 0) (hb : ∃ n, D^[n] b = 0) :
    ∃ k, D^[k] (a * b) = 0 := by
  obtain ⟨m, hm⟩ := ha
  obtain ⟨n, hn⟩ := hb
  refine ⟨m + n, ?_⟩
  rw [iterate_apply_mul]
  refine Finset.sum_eq_zero fun ij hij => ?_
  rw [Finset.mem_antidiagonal] at hij
  rcases le_or_gt m ij.1 with h | h
  · rw [D.iterate_eq_zero_of_le hm h, zero_mul, smul_zero]
  · rw [D.iterate_eq_zero_of_le hn (by omega), mul_zero, smul_zero]

/-- Every element of the subalgebra generated by elements killed by iterates of a derivation is
itself killed by an iterate of the derivation. -/
theorem exists_iterate_eq_zero_of_mem_adjoin {s : Set A} (hs : ∀ x ∈ s, ∃ n, D^[n] x = 0)
    {a : A} (ha : a ∈ Algebra.adjoin R s) : ∃ n, D^[n] a = 0 := by
  induction ha using Algebra.adjoin_induction with
  | mem x hx => exact hs x hx
  | algebraMap r => exact ⟨1, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨m, hm⟩ := hx
    obtain ⟨n, hn⟩ := hy
    refine ⟨max m n, ?_⟩
    rw [iterate_map_add, D.iterate_eq_zero_of_le hm (le_max_left m n),
      D.iterate_eq_zero_of_le hn (le_max_right m n), add_zero]
  | mul x y _ _ hx hy => exact D.exists_iterate_mul_eq_zero hx hy

/-- **Local nilpotence can be checked on generators.** A derivation which is locally nilpotent on
a set of generators of the algebra is locally nilpotent. -/
theorem exists_iterate_eq_zero_of_adjoin_eq_top {s : Set A} (hgen : Algebra.adjoin R s = ⊤)
    (hs : ∀ x ∈ s, ∃ n, D^[n] x = 0) (a : A) : ∃ n, D^[n] a = 0 :=
  D.exists_iterate_eq_zero_of_mem_adjoin hs (hgen ▸ Algebra.mem_top)

end Derivation
