module

public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.Derivation.Basic

/-!
# Local nilpotence of a derivation on generators

A derivation `D` of an algebra `A` is *locally nilpotent* when every element is killed by some
iterate of `D`. The elements killed by an iterate of `D` are closed under sums and, by the Leibniz
rule, under products, and they contain the scalars. So local nilpotence can be checked on a
generating set of the algebra.

The argument uses only linearity and the Leibniz rule, so it is stated once for linear
endomorphisms satisfying the Leibniz rule, over semirings and without associativity or
commutativity for the product lemma. It specialises both to Mathlib's `Derivation` and to the
derivations of noncommutative algebras in `TauCeti.derivationLieAlgebra`.

This is the form in which local nilpotence is verified for the invariant vector fields of
nilpotent tangent vectors of matrix groups, where the coordinate algebra is generated by matrix
entries and a few further coordinates.

## Main results

* `Module.End.pow_apply_mul_eq_zero_of_leibniz`: if `fⁿ x = 0` and `fᵐ y = 0` for a Leibniz
  endomorphism `f`, then `fⁿ⁺ᵐ (x * y) = 0`.
* `Module.End.exists_pow_apply_eq_zero_of_mem_adjoin_of_leibniz`: local nilpotence of a Leibniz
  endomorphism on a set extends to the subalgebra it generates.
* `Derivation.exists_iterate_mul_eq_zero`: a product of elements killed by iterates of `D` is
  killed by an iterate of `D`.
* `Derivation.exists_iterate_eq_zero_of_mem_adjoin`: every element of the subalgebra generated by
  a set of elements killed by iterates of `D` is killed by an iterate of `D`.
* `Derivation.exists_iterate_eq_zero_of_adjoin_eq_top`: a derivation which is locally nilpotent on
  a generating set is locally nilpotent.

## References

* G. Freudenburg, *Algebraic Theory of Locally Nilpotent Derivations*, Encyclopaedia of
  Mathematical Sciences 136, Springer (2006), §1.1.
-/

public section

namespace Module.End

section NonUnitalNonAssoc

variable {R A : Type*} [CommSemiring R] [NonUnitalNonAssocSemiring A] [Module R A]

/-- If powers `n` and `m` of a linear endomorphism satisfying the Leibniz rule kill the two
factors, power `n + m` kills their product. Neither associativity nor commutativity of
multiplication is required. -/
theorem pow_apply_mul_eq_zero_of_leibniz {f : Module.End R A}
    (hf : ∀ x y : A, f (x * y) = f x * y + x * f y) {x y : A} {n m : ℕ}
    (hx : (f ^ n) x = 0) (hy : (f ^ m) y = 0) :
    (f ^ (n + m)) (x * y) = 0 := by
  induction n generalizing x y m with
  | zero =>
    simp only [pow_zero, Module.End.one_apply] at hx
    simp [hx]
  | succ n ih =>
    induction m generalizing y with
    | zero =>
      simp only [pow_zero, Module.End.one_apply] at hy
      simp [hy]
    | succ m ihm =>
      have hx' : (f ^ n) (f x) = 0 := by
        simpa only [pow_succ, Module.End.mul_apply] using hx
      have hy' : (f ^ m) (f y) = 0 := by
        simpa only [pow_succ, Module.End.mul_apply] using hy
      rw [Nat.succ_add, pow_succ, Module.End.mul_apply, hf, map_add]
      rw [ih hx' hy, Nat.add_succ, ← Nat.succ_add, ihm hy', add_zero]

end NonUnitalNonAssoc

section Semiring

variable {R A : Type*} [CommSemiring R] [Semiring A] [Algebra R A]

/-- Local nilpotence of a linear endomorphism satisfying the Leibniz rule and killing `1`, on a
set of generators, extends to the subalgebra they generate. -/
theorem exists_pow_apply_eq_zero_of_mem_adjoin_of_leibniz {f : Module.End R A}
    (hf : ∀ x y : A, f (x * y) = f x * y + x * f y) (hf1 : f 1 = 0) {s : Set A}
    (hs : ∀ x ∈ s, ∃ n : ℕ, (f ^ n) x = 0) {a : A} (ha : a ∈ Algebra.adjoin R s) :
    ∃ n : ℕ, (f ^ n) a = 0 := by
  induction ha using Algebra.adjoin_induction with
  | mem a ha => exact hs a ha
  | algebraMap r =>
    refine ⟨1, ?_⟩
    simp only [pow_one, Algebra.algebraMap_eq_smul_one, map_smul, hf1, smul_zero]
  | add a b _ _ ha hb =>
    obtain ⟨n, hn⟩ := ha
    obtain ⟨m, hm⟩ := hb
    exact ⟨max n m, by rw [map_add,
      Module.End.pow_map_zero_of_le (le_max_left _ _) hn,
      Module.End.pow_map_zero_of_le (le_max_right _ _) hm, add_zero]⟩
  | mul a b _ _ ha hb =>
    obtain ⟨n, hn⟩ := ha
    obtain ⟨m, hm⟩ := hb
    exact ⟨n + m, pow_apply_mul_eq_zero_of_leibniz hf hn hm⟩

end Semiring

end Module.End

namespace Derivation

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A] (D : Derivation R A A)

private theorem exists_pow_toLinearMap_iff {a : A} :
    (∃ n, ((D : Module.End R A) ^ n) a = 0) ↔ ∃ n, D^[n] a = 0 := by
  simp [Module.End.pow_apply]

private theorem leibniz_toLinearMap (x y : A) :
    (D : Module.End R A) (x * y) = (D : Module.End R A) x * y + x * (D : Module.End R A) y := by
  simp [D.leibniz, add_comm, mul_comm]

/-- A product of two elements killed by iterates of a derivation is killed by an iterate of the
derivation. -/
theorem exists_iterate_mul_eq_zero {a b : A} (ha : ∃ m, D^[m] a = 0) (hb : ∃ n, D^[n] b = 0) :
    ∃ k, D^[k] (a * b) = 0 := by
  obtain ⟨m, hm⟩ := (D.exists_pow_toLinearMap_iff).2 ha
  obtain ⟨n, hn⟩ := (D.exists_pow_toLinearMap_iff).2 hb
  exact D.exists_pow_toLinearMap_iff.1
    ⟨m + n, Module.End.pow_apply_mul_eq_zero_of_leibniz D.leibniz_toLinearMap hm hn⟩

/-- Every element of the subalgebra generated by elements killed by iterates of a derivation is
itself killed by an iterate of the derivation. -/
theorem exists_iterate_eq_zero_of_mem_adjoin {s : Set A} (hs : ∀ x ∈ s, ∃ n, D^[n] x = 0)
    {a : A} (ha : a ∈ Algebra.adjoin R s) : ∃ n, D^[n] a = 0 :=
  D.exists_pow_toLinearMap_iff.1 <|
    Module.End.exists_pow_apply_eq_zero_of_mem_adjoin_of_leibniz D.leibniz_toLinearMap
      (by simp) (fun x hx => D.exists_pow_toLinearMap_iff.2 (hs x hx)) ha

/-- **Local nilpotence can be checked on generators.** A derivation which is locally nilpotent on
a set of generators of the algebra is locally nilpotent. -/
theorem exists_iterate_eq_zero_of_adjoin_eq_top {s : Set A} (hgen : Algebra.adjoin R s = ⊤)
    (hs : ∀ x ∈ s, ∃ n, D^[n] x = 0) (a : A) : ∃ n, D^[n] a = 0 :=
  D.exists_iterate_eq_zero_of_mem_adjoin hs (hgen ▸ Algebra.mem_top)

end Derivation
