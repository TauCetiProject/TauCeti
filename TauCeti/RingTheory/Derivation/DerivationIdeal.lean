module

public import Mathlib.RingTheory.Derivation.Basic
public import Mathlib.RingTheory.Ideal.Maps

/-!
# The ideal generated by the values of derivations

For an `R`-algebra `A`, `TauCeti.derivationIdeal R A` is the ideal of `A` generated by the values
`D a` of all `R`-linear derivations `D : A → A`. It depends only on the `R`-algebra `A`, so an
`R`-algebra isomorphism `A ≃ₐ[R] B` carries it to the corresponding ideal of `B`
(`AlgEquiv.map_derivationIdeal`). Pulled back to `R`, it gives an ideal of the base which is an
isomorphism invariant of the algebra (`AlgEquiv.comap_algebraMap_derivationIdeal`).

For a hypersurface `xy = s` over a base, the derivations vanish exactly along the singular
locus `x = y = 0`, and the ideal pulled back to the base is `(s)`; this recovers a smoothing
parameter from the algebra alone.

Two constructions of derivations feed this ideal. A derivation over any scalars which vanishes on
the image of `R` is `R`-linear (`Derivation.ofMapAlgebraMap`), so its values also lie in the
derivation ideal (`Derivation.apply_mem_derivationIdeal_of_map_algebraMap`). An `R`-algebra
isomorphism `e : A ≃ₐ[R] B` transports derivations of `A` to derivations `e ∘ D ∘ e⁻¹` of `B`
(`Derivation.mapAlgEquiv`).
-/

public section

namespace Derivation

section OfMapAlgebraMap

variable {S R A M : Type*} [CommSemiring S] [CommSemiring R] [CommSemiring A] [AddCommMonoid M]
  [Algebra S A] [Algebra R A] [Module A M] [Module S M] [Module R M] [IsScalarTower R A M]

/-- A derivation over `S` that vanishes on the image of `R` is `R`-linear. -/
@[expose] def ofMapAlgebraMap (D : Derivation S A M) (hD : ∀ r : R, D (algebraMap R A r) = 0) :
    Derivation R A M where
  toFun := D
  map_add' := D.map_add
  map_smul' r a := by
    rw [RingHom.id_apply, Algebra.smul_def, D.leibniz, hD, smul_zero, add_zero, algebraMap_smul]
  map_one_eq_zero' := D.map_one_eq_zero
  leibniz' := D.leibniz

@[simp]
theorem coe_ofMapAlgebraMap (D : Derivation S A M) (hD : ∀ r : R, D (algebraMap R A r) = 0) :
    ⇑(D.ofMapAlgebraMap hD) = D :=
  rfl

end OfMapAlgebraMap

section MapAlgEquiv

variable {R A B : Type*} [CommSemiring R] [CommSemiring A] [CommSemiring B] [Algebra R A]
  [Algebra R B]

/-- A derivation of `A` transported along an `R`-algebra isomorphism `e : A ≃ₐ[R] B`: the
derivation `e ∘ D ∘ e⁻¹` of `B`. -/
@[expose] def mapAlgEquiv (D : Derivation R A A) (e : A ≃ₐ[R] B) : Derivation R B B where
  toLinearMap := (e.toLinearMap : A →ₗ[R] B) ∘ₗ D.toLinearMap ∘ₗ (e.symm.toLinearMap : B →ₗ[R] A)
  map_one_eq_zero' := by simp
  leibniz' x y := by simp [D.leibniz, smul_eq_mul]

@[simp]
theorem mapAlgEquiv_apply (D : Derivation R A A) (e : A ≃ₐ[R] B) (x : B) :
    D.mapAlgEquiv e x = e (D (e.symm x)) :=
  rfl

end MapAlgEquiv

end Derivation

namespace TauCeti

variable (R A : Type*) [CommSemiring R] [CommSemiring A] [Algebra R A]

/-- The ideal of `A` generated by the values of all `R`-linear derivations of `A`. -/
def derivationIdeal : Ideal A :=
  Ideal.span (⋃ D : Derivation R A A, Set.range D)

end TauCeti

open TauCeti

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]

/-- Every value of an `R`-linear derivation lies in the derivation ideal. -/
theorem Derivation.apply_mem_derivationIdeal (D : Derivation R A A) (a : A) :
    D a ∈ derivationIdeal R A :=
  Ideal.subset_span (Set.mem_iUnion.2 ⟨D, a, rfl⟩)

/-- The derivation ideal is contained in `I` exactly when every derivation takes values in `I`. -/
theorem TauCeti.derivationIdeal_le_iff {I : Ideal A} :
    derivationIdeal R A ≤ I ↔ ∀ (D : Derivation R A A) (a : A), D a ∈ I := by
  refine ⟨fun h D a ↦ h (D.apply_mem_derivationIdeal a), fun h ↦ Ideal.span_le.2 ?_⟩
  rintro _ ⟨_, ⟨D, rfl⟩, a, rfl⟩
  exact h D a

/-- A derivation over any scalars that vanishes on the image of `R` is `R`-linear, so its values
lie in the derivation ideal. -/
theorem Derivation.apply_mem_derivationIdeal_of_map_algebraMap {S : Type*} [CommSemiring S]
    [Algebra S A] (D : Derivation S A A) (hD : ∀ r : R, D (algebraMap R A r) = 0) (a : A) :
    D a ∈ derivationIdeal R A :=
  (D.ofMapAlgebraMap hD).apply_mem_derivationIdeal a

variable {B : Type*} [CommSemiring B] [Algebra R B]

/-- An `R`-algebra isomorphism carries the derivation ideal of `A` into that of `B`, by
conjugating derivations. -/
private theorem AlgEquiv.map_derivationIdeal_le (e : A ≃ₐ[R] B) :
    (derivationIdeal R A).map e ≤ derivationIdeal R B := by
  rw [derivationIdeal, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨_, ⟨D, rfl⟩, a, rfl⟩, rfl⟩
  simpa using (D.mapAlgEquiv e).apply_mem_derivationIdeal (e a)

/-- An `R`-algebra isomorphism carries the derivation ideal of `A` onto that of `B`. -/
theorem AlgEquiv.map_derivationIdeal (e : A ≃ₐ[R] B) :
    (derivationIdeal R A).map e = derivationIdeal R B := by
  refine le_antisymm e.map_derivationIdeal_le fun y hy ↦ ?_
  simpa using Ideal.mem_map_of_mem e
    (e.symm.map_derivationIdeal_le (Ideal.mem_map_of_mem e.symm hy))

/-- The derivation ideal pulled back to the base is an invariant of the `R`-algebra: isomorphic
algebras have the same one. -/
theorem AlgEquiv.comap_algebraMap_derivationIdeal (e : A ≃ₐ[R] B) :
    (derivationIdeal R B).comap (algebraMap R B) =
      (derivationIdeal R A).comap (algebraMap R A) := by
  ext r
  rw [Ideal.mem_comap, Ideal.mem_comap, ← e.map_derivationIdeal, Ideal.mem_map_of_equiv]
  constructor
  · rintro ⟨x, hx, hxr⟩
    rwa [← e.injective (hxr.trans (e.commutes r).symm)]
  · exact fun h ↦ ⟨_, h, e.commutes r⟩
