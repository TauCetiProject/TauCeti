import TauCeti.RingTheory.Derivation.Ideal

/-!
# Derivation ideals

For an `R`-algebra `A`, `TauCeti.derivationIdeal R A` is the ideal of `A` generated by the values
`D a` of all `R`-linear derivations `D : A → A`. It depends only on the `R`-algebra `A`, so an
`R`-algebra isomorphism `A ≃ₐ[R] B` carries it to the corresponding ideal of `B`
(`AlgEquiv.map_derivationIdeal`). Pulled back to `R`, it gives an ideal of the base which is an
isomorphism invariant of the algebra (`AlgEquiv.comap_algebraMap_derivationIdeal`).

For a hypersurface `xy = s` over a base, the derivations vanish exactly along the singular
locus `x = y = 0`, and the ideal pulled back to the base is `(s)`; this recovers a smoothing
parameter from the algebra alone.

A derivation over any scalars which vanishes on the image of `R` is `R`-linear
(`Derivation.ofMapAlgebraMap`), so its values also lie in the derivation ideal
(`Derivation.apply_mem_derivationIdeal_of_map_algebraMap`). Invariance under isomorphisms comes
from transporting derivations along them (`Derivation.conjAlgEquiv`).

Relative to an ideal `I` of a `k`-algebra `R`, `Ideal.derivativeIdeal k I` is the ideal
generated by `I` together with all values `D f` of `k`-derivations `D : Derivation k R R` on
elements `f ∈ I` (`Ideal.derivativeIdeal_def`). It satisfies the universal property
`Ideal.derivativeIdeal_le_iff`, commutes with suprema (`Ideal.derivativeIdeal_iSup`,
`Ideal.derivativeIdeal_sup`), has explicit generators `Ideal.derivativeIdeal_span`, satisfies the
Leibniz inclusion `Ideal.derivativeIdeal_mul_le`, and lowers ideal powers by at most one
(`Ideal.derivativeIdeal_le_pow_of_le_pow_succ`).
-/

public section

namespace TauCeti

variable (R A : Type*) [CommSemiring R] [CommSemiring A] [Algebra R A]

/-- The ideal of `A` generated by the values of all `R`-linear derivations of `A`. -/
def derivationIdeal : Ideal A :=
  Ideal.span (⋃ D : Derivation R A A, Set.range D)

end TauCeti

section

open TauCeti

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]

/-- Every value of an `R`-linear derivation lies in the derivation ideal. -/
theorem Derivation.apply_mem_derivationIdeal (D : Derivation R A A) (a : A) :
    D a ∈ derivationIdeal R A :=
  Ideal.subset_span (Set.mem_iUnion.2 ⟨D, a, rfl⟩)

/-- The derivation ideal is contained in `I` exactly when every derivation takes values in `I`. -/
theorem TauCeti.derivationIdeal_le_iff {I : Ideal A} :
    derivationIdeal R A ≤ I ↔ ∀ (D : Derivation R A A) (a : A), D a ∈ I := by
  refine ⟨fun h D a ↦ h (D.apply_mem_derivationIdeal a), fun h ↦ Ideal.span_le.2 ?_⟩
  rintro _ ⟨_, ⟨D, rfl⟩, a, rfl⟩
  exact h D a

/-- A derivation over any scalars that vanishes on the image of `R` is `R`-linear, so its values
lie in the derivation ideal. -/
theorem Derivation.apply_mem_derivationIdeal_of_map_algebraMap {S : Type*} [CommSemiring S]
    [Algebra S A] (D : Derivation S A A) (hD : ∀ r : R, D (algebraMap R A r) = 0) (a : A) :
    D a ∈ derivationIdeal R A := by
  simpa using (D.ofMapAlgebraMap hD).apply_mem_derivationIdeal a

variable {B : Type*} [CommSemiring B] [Algebra R B]

/-- An `R`-algebra isomorphism carries the derivation ideal of `A` into that of `B`, by
conjugating derivations. -/
private theorem AlgEquiv.map_derivationIdeal_le (e : A ≃ₐ[R] B) :
    (derivationIdeal R A).map e ≤ derivationIdeal R B := by
  rw [derivationIdeal, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨_, ⟨D, rfl⟩, a, rfl⟩, rfl⟩
  simpa using (D.conjAlgEquiv e).apply_mem_derivationIdeal (e a)

/-- An `R`-algebra isomorphism carries the derivation ideal of `A` onto that of `B`. -/
theorem AlgEquiv.map_derivationIdeal (e : A ≃ₐ[R] B) :
    (derivationIdeal R A).map e = derivationIdeal R B := by
  refine le_antisymm e.map_derivationIdeal_le fun y hy ↦ ?_
  simpa using Ideal.mem_map_of_mem e
    (e.symm.map_derivationIdeal_le (Ideal.mem_map_of_mem e.symm hy))

/-- The derivation ideal pulled back to the base is an invariant of the `R`-algebra: isomorphic
algebras have the same one. -/
theorem AlgEquiv.comap_algebraMap_derivationIdeal (e : A ≃ₐ[R] B) :
    (derivationIdeal R B).comap (algebraMap R B) =
      (derivationIdeal R A).comap (algebraMap R A) := by
  ext r
  rw [Ideal.mem_comap, Ideal.mem_comap, ← e.map_derivationIdeal, Ideal.mem_map_of_equiv]
  constructor
  · rintro ⟨x, hx, hxr⟩
    rwa [← e.injective (hxr.trans (e.commutes r).symm)]
  · exact fun h ↦ ⟨_, h, e.commutes r⟩

end

namespace Ideal

variable (k : Type*) [CommSemiring k] {R : Type*} [CommSemiring R] [Algebra k R]
  {I J : Ideal R}

/-- The derivative ideal of an ideal `I` of a `k`-algebra `R`: the ideal generated by `I` and the
values `D f` of all `k`-derivations `D : Derivation k R R` on elements `f ∈ I`. -/
noncomputable def derivativeIdeal (I : Ideal R) : Ideal R :=
  I ⊔ span (⋃ D : Derivation k R R, D '' I)

/-- The defining expression of `Ideal.derivativeIdeal`. -/
theorem derivativeIdeal_def (I : Ideal R) :
    I.derivativeIdeal k = I ⊔ span (⋃ D : Derivation k R R, D '' I) :=
  (rfl)

/-- Every ideal is contained in its derivative ideal. -/
theorem le_derivativeIdeal (I : Ideal R) : I ≤ I.derivativeIdeal k :=
  le_sup_left

/-- The derivative ideal contains `D f` for every `f ∈ I` and every `k`-derivation `D`. -/
theorem apply_mem_derivativeIdeal (D : Derivation k R R) {f : R} (hf : f ∈ I) :
    D f ∈ I.derivativeIdeal k :=
  mem_sup_right (subset_span (Set.mem_iUnion.mpr ⟨D, Set.mem_image_of_mem _ hf⟩))

/-- The derivative ideal of `I` is the smallest ideal containing `I` and `D f` for every
`k`-derivation `D` and every `f ∈ I`. -/
theorem derivativeIdeal_le_iff :
    I.derivativeIdeal k ≤ J ↔ I ≤ J ∧ ∀ D : Derivation k R R, ∀ f ∈ I, D f ∈ J := by
  rw [derivativeIdeal_def, sup_le_iff, span_le, Set.iUnion_subset_iff]
  simp only [Set.subset_def, Set.forall_mem_image, SetLike.mem_coe]

/-- Taking derivative ideals is monotone with respect to ideal inclusion. -/
theorem derivativeIdeal_mono : Monotone (derivativeIdeal k (R := R)) :=
  fun _ _ h ↦ (derivativeIdeal_le_iff k).mpr
    ⟨h.trans (le_derivativeIdeal k _), fun D _ hf ↦ apply_mem_derivativeIdeal k D (h hf)⟩

/-- The derivative ideal of the zero ideal is the zero ideal. -/
@[simp]
theorem derivativeIdeal_bot : (⊥ : Ideal R).derivativeIdeal k = ⊥ :=
  le_bot_iff.mp <| (derivativeIdeal_le_iff k).mpr
    ⟨le_rfl, fun _ _ hf ↦ by simp [mem_bot.mp hf]⟩

/-- The derivative ideal of the unit ideal is the unit ideal. -/
@[simp]
theorem derivativeIdeal_top : (⊤ : Ideal R).derivativeIdeal k = ⊤ :=
  top_le_iff.mp (le_derivativeIdeal k ⊤)

/-- The derivative ideal commutes with arbitrary suprema of ideals. -/
@[simp]
theorem derivativeIdeal_iSup {ι : Sort*} (I : ι → Ideal R) :
    (⨆ i, I i).derivativeIdeal k = ⨆ i, (I i).derivativeIdeal k := by
  refine le_antisymm ?_ (iSup_le fun i ↦ derivativeIdeal_mono k (le_iSup I i))
  refine (derivativeIdeal_le_iff k).mpr
    ⟨iSup_mono fun i ↦ le_derivativeIdeal k (I i), fun D f hf ↦ ?_⟩
  induction hf using Submodule.iSup_induction' with
  | mem i x hx =>
    exact le_iSup (fun i ↦ (I i).derivativeIdeal k) i (apply_mem_derivativeIdeal k D hx)
  | zero => simp
  | add x y _ _ hx hy => simpa using add_mem hx hy

/-- The derivative ideal of a sum of two ideals is the sum of their derivative ideals. -/
@[simp]
theorem derivativeIdeal_sup (I J : Ideal R) :
    (I ⊔ J).derivativeIdeal k = I.derivativeIdeal k ⊔ J.derivativeIdeal k := by
  refine le_antisymm ((derivativeIdeal_le_iff k).mpr ⟨?_, fun D f hf ↦ ?_⟩)
    (sup_le (derivativeIdeal_mono k le_sup_left) (derivativeIdeal_mono k le_sup_right))
  · exact sup_le (le_sup_of_le_left (le_derivativeIdeal k I))
      (le_sup_of_le_right (le_derivativeIdeal k J))
  · rcases Submodule.mem_sup.mp hf with ⟨a, ha, b, hb, rfl⟩
    rw [map_add]
    exact add_mem (mem_sup_left (apply_mem_derivativeIdeal k D ha))
      (mem_sup_right (apply_mem_derivativeIdeal k D hb))

/-- The derivative ideal of the ideal generated by a set `s` is generated by `s` together with the
values of all `k`-derivations on `s`. -/
theorem derivativeIdeal_span (s : Set R) :
    (span s).derivativeIdeal k = span (s ∪ ⋃ D : Derivation k R R, D '' s) := by
  refine le_antisymm ((derivativeIdeal_le_iff k).mpr ⟨span_mono Set.subset_union_left, ?_⟩) ?_
  · intro D f hf
    induction hf using Submodule.span_induction with
    | mem x hx =>
      exact subset_span (Or.inr (Set.mem_iUnion.mpr ⟨D, Set.mem_image_of_mem _ hx⟩))
    | zero => simp
    | add x y _ _ hx hy => simpa using add_mem hx hy
    | smul a x hx' hx =>
      rw [smul_eq_mul, D.leibniz, smul_eq_mul, smul_eq_mul]
      exact add_mem (mul_mem_left _ _ hx)
        (mul_mem_right _ _ (span_mono Set.subset_union_left hx'))
  · refine span_le.mpr (Set.union_subset (subset_span.trans (le_derivativeIdeal k _)) ?_)
    simp only [Set.iUnion_subset_iff, Set.image_subset_iff]
    exact fun D f hf ↦ apply_mem_derivativeIdeal k D (subset_span hf)

/-- The derivative ideal of a product satisfies the Leibniz inclusion
`(I * J).derivativeIdeal k ≤ I.derivativeIdeal k * J ⊔ I * J.derivativeIdeal k`. -/
theorem derivativeIdeal_mul_le (I J : Ideal R) :
    (I * J).derivativeIdeal k ≤ I.derivativeIdeal k * J ⊔ I * J.derivativeIdeal k := by
  refine (derivativeIdeal_le_iff k).mpr ⟨?_, fun D f hf ↦ ?_⟩
  · exact le_sup_of_le_left (Ideal.mul_mono (le_derivativeIdeal k I) le_rfl)
  · refine Submodule.mul_induction_on hf (fun a ha b hb ↦ ?_) fun x y hx hy ↦ ?_
    · rw [D.leibniz, smul_eq_mul, smul_eq_mul, add_comm]
      exact add_mem
        (mem_sup_left (mul_comm b (D a) ▸
          Ideal.mul_mem_mul (apply_mem_derivativeIdeal k D ha) hb))
        (mem_sup_right (Ideal.mul_mem_mul ha (apply_mem_derivativeIdeal k D hb)))
    · rw [map_add]
      exact add_mem hx hy

/-- Every derivation lowers powers of an ideal by at most one: if `I ≤ J ^ (n + 1)` then
`I.derivativeIdeal k ≤ J ^ n`. -/
theorem derivativeIdeal_le_pow_of_le_pow_succ {n : ℕ} (h : I ≤ J ^ (n + 1)) :
    I.derivativeIdeal k ≤ J ^ n := by
  refine (derivativeIdeal_le_iff k).mpr ⟨h.trans (Ideal.pow_le_pow_right n.le_succ), ?_⟩
  intro D f hf
  simpa using D.apply_mem_pow_smul_top_of_mem_pow_succ (h hf)

end Ideal
