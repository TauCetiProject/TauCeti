module

public import Mathlib.RingTheory.DiscreteValuationRing.Basic

/-!
# The length of a discrete valuation ring over itself

The length of a ring over itself is the supremum of the finite chains of ideals it contains, and in
a discrete valuation ring those chains are the powers of the maximal ideal, whose lengths Mathlib
computes in `IsDiscreteValuationRing.length_quotient_pow_maximalIdeal`. Since the maximal ideal of
a discrete valuation ring is generated by a uniformizer, its powers are nonzero and their lengths
are unbounded, so the length of the ring over itself is infinite. This is the fact that a length
computed along a discrete valuation ring — a length of a quotient, or an order of vanishing read as
a length — is infinite unless something forces it to be finite.

## Main results

* `TauCeti.IsDiscreteValuationRing.length_self_eq_top`: a discrete valuation ring has infinite
  length over itself.
-/

public section

open IsLocalRing

namespace TauCeti.IsDiscreteValuationRing

variable {A : Type*} [CommRing A] [IsDomain A] [_root_.IsDiscreteValuationRing A]

/-- **A discrete valuation ring has infinite length over itself.** The powers of the maximal ideal
are nonzero and have lengths `n` by `IsDiscreteValuationRing.length_quotient_pow_maximalIdeal`, so
the length of the ring over itself is unbounded, that is, `⊤`. -/
theorem length_self_eq_top : Module.length A A = ⊤ := by
  by_contra hne
  -- a ring of finite length is both noetherian and Artinian as a module over itself
  obtain ⟨hNoe, hArt⟩ := isFiniteLength_iff_isNoetherian_isArtinian.mp
    (Module.length_ne_top_iff.mp hne)
  let _ : IsNoetherian A A := hNoe
  let _ : IsArtinian A A := hArt
  refine absurd (ENat.eq_top_iff_forall_ge.mpr fun n => ?_) hne
  -- a discrete valuation ring has finite length over itself modulo a power of its maximal
  -- ideal, and the powers are nonzero, so its length is unbounded
  obtain ⟨ϖ, hϖ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible A
  have hpow : (maximalIdeal A : Submodule A A) ^ (n + 1) ≠ ⊥ := by
    intro hbot
    have hmem : (ϖ : A) ^ (n + 1) ∈ maximalIdeal A ^ (n + 1) := by
      rw [hϖ.maximalIdeal_eq, Ideal.span_singleton_pow]
      exact Submodule.mem_span_singleton_self _
    rw [hbot, Submodule.mem_bot] at hmem
    exact pow_ne_zero (n + 1) hϖ.ne_zero hmem
  have hlt := Submodule.length_quotient_lt (maximalIdeal A ^ (n + 1)) hpow
  rw [_root_.IsDiscreteValuationRing.length_quotient_pow_maximalIdeal] at hlt
  exact (Nat.cast_le.mpr (Nat.le_succ n)).trans hlt.le

end TauCeti.IsDiscreteValuationRing
