import TauCeti.RingTheory.Valuation.Orthogonality

/-!
# Powers of the maximal ideal of a discrete valuation ring

The maximal ideal of a discrete valuation ring is generated by a uniformizer, so membership in its
`n`-th power is the inequality `n ≤ v x` for the additive valuation
`IsDiscreteValuationRing.addVal`, and the principal ideal generated by a nonzero `x` is
`𝔪 ^ (v x)`; in particular the residue of `x` vanishes exactly when the uniformizer divides
`x`, and the uniformizers are the elements with `v x = 1`. Mathlib inlines these rewrites where
it needs them; this file states them once. Since the powers of a uniformizer are pairwise
distinct, a discrete valuation ring is also infinite. Writing elements as a unit times a power of a
uniformizer `x` also shows that a ring map to a reduced semiring is injective as soon as it does
not kill `x`, that a ring map to a cancellative commutative semiring reflects divisibility when
it sends `x` to a nonzero nonunit, and that an algebra map between discrete valuation rings
extending `𝔪` to `𝔪' ^ e` (`e ≠ 0`) is injective and multiplies `addVal` by `e` (so powers
`1, ϖ, …, ϖ ^ (n - 1)` of a uniformizer `ϖ` with `n ≤ e` are valuation-orthogonal).

## Main results

* `TauCeti.IsDiscreteValuationRing.mem_maximalIdeal_of_mul_pow_mem_maximalIdeal_pow_succ`: if
  `c * ϖ ^ n ∈ 𝔪 ^ (n + 1)` for a uniformizer `ϖ`, then `c ∈ 𝔪`.
* `TauCeti.IsDiscreteValuationRing.mem_maximalIdeal_pow_iff_le_addVal`: `x ∈ 𝔪 ^ n` is
  `n ≤ addVal x`.
* `TauCeti.IsDiscreteValuationRing.addVal_eq_multiplicity_span_singleton`: for `x ≠ 0`,
  `addVal x` is the multiplicity of `𝔪` in the ideal `(x)`.
* `TauCeti.IsDiscreteValuationRing.addVal_eq_one_iff_irreducible`: the uniformizers are the
  elements of additive valuation `1`.
* `TauCeti.IsDiscreteValuationRing.natCard_quotient_maximalIdeal_pow`: the quotient by `𝔪 ^ n`
  has cardinality `Nat.card (ResidueField S) ^ n`.
* `TauCeti.IsDiscreteValuationRing.hasFiniteQuotients`: if the residue field is finite, so is
  the quotient by any nonzero ideal.
* `TauCeti.IsDiscreteValuationRing.relIndex_maximalIdeal_pow_add`: `𝔪 ^ (k + e)` has index
  `Nat.card (ResidueField S) ^ e` in `𝔪 ^ k`.
* `TauCeti.IsDiscreteValuationRing.natCard_map_maximalIdeal_pow`: the graded piece
  `𝔪 ^ n / 𝔪 ^ (n + 1)` has as many elements as the residue field.
* `TauCeti.IsDiscreteValuationRing.quotient_mk_eq_iff_le_addVal`: equality modulo `𝔪 ^ n` is
  equivalent to `n ≤ addVal (x - y)`.
* `Irreducible.residue_eq_zero_iff_dvd`: for a uniformizer `ϖ`, the residue of `x` vanishes
  exactly when `ϖ ∣ x`.
* `Irreducible.smodEq_maximalIdeal_pow_iff_dvd`: for a uniformizer `ϖ`, congruence modulo
  `𝔪 ^ n` is divisibility of the difference by `ϖ ^ n`.
* `TauCeti.IsDiscreteValuationRing.infinite`: a discrete valuation ring is infinite, since the
  powers of a uniformizer are pairwise distinct.
* `TauCeti.IsDiscreteValuationRing.injective_of_map_ne_zero`: a ring map to a reduced semiring
  that sends a uniformizer `x` to a nonzero element is injective.
* `TauCeti.IsDiscreteValuationRing.map_dvd_iff`: a ring map to a cancellative commutative
  semiring that sends a uniformizer `x` to a nonzero nonunit reflects divisibility.
* `TauCeti.IsDiscreteValuationRing.algebraMap_injective_of_map_maximalIdeal_eq_pow`,
  `TauCeti.IsDiscreteValuationRing.algebraMap_injective_of_map_maximalIdeal_eq`: an algebra map
  between DVRs sending `maximalIdeal S` to `maximalIdeal R' ^ e` is injective.
* `TauCeti.IsDiscreteValuationRing.addVal_algebraMap_of_map_maximalIdeal_eq_pow`,
  `TauCeti.IsDiscreteValuationRing.addVal_algebraMap_of_map_maximalIdeal_eq`: such a map (`e ≠ 0`)
  multiplies `addVal` by `e` (and preserves `addVal` when `e = 1`).
* `TauCeti.IsDiscreteValuationRing.addVal_sum_algebraMap_mul_pow_of_irreducible`,
  `TauCeti.IsDiscreteValuationRing.addVal_aeval_of_natDegree_lt`: uniformizer-power orthogonality
  for DVR extensions scaling `addVal` by `e`.
-/

public section

open IsLocalRing

namespace TauCeti.IsDiscreteValuationRing

variable {S : Type*} [CommRing S] [IsDomain S] [_root_.IsDiscreteValuationRing S]

/-- Cancelling a uniformizer power from membership in the next maximal-ideal power leaves
the coefficient in the maximal ideal. -/
theorem mem_maximalIdeal_of_mul_pow_mem_maximalIdeal_pow_succ {ϖ c : S} {n : ℕ}
    (hϖ : Irreducible ϖ) (h : c * ϖ ^ n ∈ maximalIdeal S ^ (n + 1)) :
    c ∈ maximalIdeal S := by
  rw [hϖ.maximalIdeal_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton, pow_succ',
    mul_dvd_mul_iff_right (pow_ne_zero n hϖ.ne_zero)] at h
  rwa [hϖ.maximalIdeal_eq, Ideal.mem_span_singleton]

/-- Membership in a power of the maximal ideal of a discrete valuation ring, read on the additive
valuation. -/
theorem mem_maximalIdeal_pow_iff_le_addVal {n : ℕ} {x : S} :
    x ∈ maximalIdeal S ^ n ↔ (n : ℕ∞) ≤ _root_.IsDiscreteValuationRing.addVal S x := by
  obtain ⟨ϖ, hϖ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible S
  rw [hϖ.maximalIdeal_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton,
    ← _root_.IsDiscreteValuationRing.addVal_le_iff_dvd, hϖ.addVal_pow]

/-- Equality of two classes modulo a maximal-ideal power is measured by the additive valuation
of the difference of their representatives. -/
theorem quotient_mk_eq_iff_le_addVal {n : ℕ} {x y : S} :
    Ideal.Quotient.mk (maximalIdeal S ^ n) x = Ideal.Quotient.mk (maximalIdeal S ^ n) y ↔
      (n : ℕ∞) ≤ _root_.IsDiscreteValuationRing.addVal S (x - y) := by
  rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem, mem_maximalIdeal_pow_iff_le_addVal]

/-- The quotient by the `n`-th power of the maximal ideal has cardinality equal to the `n`-th
power of the residue cardinality. No finiteness assumption on the residue field is needed. -/
theorem natCard_quotient_maximalIdeal_pow (n : ℕ) :
    Nat.card (S ⧸ maximalIdeal S ^ n) = Nat.card (ResidueField S) ^ n := by
  rw [← Submodule.cardQuot_apply, cardQuot_pow_of_prime
    (_root_.IsDiscreteValuationRing.not_a_field S), Submodule.cardQuot_apply]
  -- The residue field is defined as the quotient by the maximal ideal.
  rfl

/-- **A discrete valuation ring with finite residue field has finite quotients**: a nonzero ideal
is a power of the maximal ideal. -/
instance hasFiniteQuotients [Finite (ResidueField S)] : Ring.HasFiniteQuotients S where
  finiteQuotient {I} hI := by
    obtain ⟨ϖ, hϖ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible S
    obtain ⟨n, hn⟩ := _root_.IsDiscreteValuationRing.ideal_eq_span_pow_irreducible hI hϖ
    rw [hn, ← Ideal.span_singleton_pow, ← hϖ.maximalIdeal_eq]
    infer_instance

/-- The index of `𝔪 ^ (k + e)` in `𝔪 ^ k` is `Nat.card (ResidueField S) ^ e`: multiplication by
the `k`-th power of a uniformizer carries `S ⊇ 𝔪 ^ e` isomorphically onto `𝔪 ^ k ⊇ 𝔪 ^ (k + e)`.
No finiteness assumption on the residue field is needed. -/
theorem relIndex_maximalIdeal_pow_add (k e : ℕ) :
    (maximalIdeal S ^ (k + e)).toAddSubgroup.relIndex (maximalIdeal S ^ k).toAddSubgroup =
      Nat.card (ResidueField S) ^ e := by
  obtain ⟨ϖ, hϖ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible S
  have hpow (j : ℕ) : maximalIdeal S ^ j = Ideal.span {ϖ ^ j} := by
    rw [hϖ.maximalIdeal_eq, Ideal.span_singleton_pow]
  let μ : S →+ S := AddMonoidHom.mulLeft (ϖ ^ k)
  have hrange : μ.range = (maximalIdeal S ^ k).toAddSubgroup := by
    ext x
    simp [μ, hpow, Ideal.mem_span_singleton, dvd_def, eq_comm]
  have hcomap : (maximalIdeal S ^ (k + e)).toAddSubgroup.comap μ =
      (maximalIdeal S ^ e).toAddSubgroup := by
    ext x
    simp [μ, hpow, Ideal.mem_span_singleton, pow_add,
      mul_dvd_mul_iff_left (pow_ne_zero k hϖ.ne_zero)]
  rw [← hrange, ← AddSubgroup.index_comap, hcomap, ← natCard_quotient_maximalIdeal_pow,
    ← Submodule.cardQuot_apply, Submodule.cardQuot]

/-- The graded piece `𝔪 ^ n / 𝔪 ^ (n + 1)` of a discrete valuation ring, viewed as an ideal of
`S ⧸ 𝔪 ^ (n + 1)`, has as many elements as the residue field. -/
theorem natCard_map_maximalIdeal_pow (n : ℕ) :
    Nat.card ((maximalIdeal S ^ n).map (Ideal.Quotient.mk (maximalIdeal S ^ (n + 1)))) =
      Nat.card (ResidueField S) :=
  (Nat.card_congr (((maximalIdeal S).quotEquivPowQuotPowSuccEquiv
    (IsPrincipalIdealRing.principal _) _root_.IsDiscreteValuationRing.not_a_field' n).trans
      ((maximalIdeal S).powQuotPowSuccEquivMapMkPowSuccPow n))).symm

/-- The additive valuation of a nonzero element of a discrete valuation ring is the multiplicity
of the maximal ideal in the principal ideal it generates. -/
theorem addVal_eq_multiplicity_span_singleton {x : S} (hx : x ≠ 0) :
    _root_.IsDiscreteValuationRing.addVal S x =
      multiplicity (maximalIdeal S) (Ideal.span {x}) := by
  obtain ⟨ϖ, hϖ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible S
  obtain ⟨n, u, rfl⟩ := _root_.IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx hϖ
  rw [_root_.IsDiscreteValuationRing.addVal_def _ u hϖ n rfl,
    Ideal.span_singleton_mul_left_unit u.isUnit, ← Ideal.span_singleton_pow,
    ← hϖ.maximalIdeal_eq, multiplicity_pow_self_of_prime
      (Ideal.prime_of_isPrime (_root_.IsDiscreteValuationRing.not_a_field S) inferInstance)]

/-- An element of a discrete valuation ring is a uniformizer exactly when its additive valuation
is `1`. The reverse direction is Mathlib's `IsDiscreteValuationRing.addVal_uniformizer`. -/
theorem addVal_eq_one_iff_irreducible {x : S} :
    _root_.IsDiscreteValuationRing.addVal S x = 1 ↔ Irreducible x := by
  refine ⟨fun hx ↦ ?_, _root_.IsDiscreteValuationRing.addVal_uniformizer⟩
  obtain ⟨ϖ, hϖ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible S
  have hx0 : x ≠ 0 := by
    rintro rfl
    simp at hx
  obtain ⟨n, u, rfl⟩ := _root_.IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx0 hϖ
  rw [_root_.IsDiscreteValuationRing.addVal_def' u hϖ n, Nat.cast_eq_one] at hx
  rw [hx, pow_one]
  exact (irreducible_units_mul u).2 hϖ

/-- For a uniformizer `ϖ` of a discrete valuation ring, the residue of `x` vanishes exactly when
`ϖ` divides `x`: the maximal ideal is generated by `ϖ`. -/
theorem _root_.Irreducible.residue_eq_zero_iff_dvd {ϖ : S} (hϖ : Irreducible ϖ) (x : S) :
    residue S x = 0 ↔ ϖ ∣ x := by
  rw [residue_eq_zero_iff, hϖ.maximalIdeal_eq, Ideal.mem_span_singleton]

/-- For a uniformizer `ϖ` of a discrete valuation ring, two elements are congruent modulo
`𝔪 ^ n` exactly when `ϖ ^ n` divides their difference. -/
theorem _root_.Irreducible.smodEq_maximalIdeal_pow_iff_dvd {ϖ : S} (hϖ : Irreducible ϖ)
    {n : ℕ} {x y : S} :
    x ≡ y [SMOD maximalIdeal S ^ n] ↔ ϖ ^ n ∣ x - y := by
  rw [SModEq.sub_mem, hϖ.maximalIdeal_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton]

/-- A discrete valuation ring is infinite: a finite domain is a field, and a discrete valuation
ring is not. -/
instance infinite : Infinite S :=
  not_finite_iff_infinite.mp fun _ ↦
    _root_.IsDiscreteValuationRing.not_isField S (Finite.isField_of_domain S)

section Map

variable {T F : Type*} [FunLike F S T] {x : S}

/-- A ring map from a discrete valuation ring to a reduced semiring is injective as soon as it
does not kill a uniformizer. -/
theorem injective_of_map_ne_zero [Semiring T] [IsReduced T] [RingHomClass F S T] (f : F)
    (hx : Irreducible x) (hfx : f x ≠ 0) : Function.Injective f := by
  refine (injective_iff_map_eq_zero f).mpr fun t ht ↦ by_contra fun ht₀ ↦ ?_
  obtain ⟨j, w, rfl⟩ := _root_.IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ht₀ hx
  rw [map_mul, map_pow, (w.isUnit.map f).mul_right_eq_zero] at ht
  exact pow_ne_zero j hfx ht

/-- Let `f` be a ring map from a discrete valuation ring to a cancellative commutative semiring
sending a uniformizer `x` to a nonzero nonunit. Then `f a` divides `f b` exactly when `a`
divides `b`. -/
theorem map_dvd_iff [CommSemiring T] [IsCancelMulZero T] [RingHomClass F S T] (f : F)
    (hx : Irreducible x) (hfx : ¬IsUnit (f x)) (hfx₀ : f x ≠ 0) {a b : S} :
    f a ∣ f b ↔ a ∣ b := by
  refine ⟨fun h ↦ ?_, map_dvd f⟩
  rcases eq_or_ne b 0 with rfl | hb
  · exact dvd_zero _
  rcases eq_or_ne a 0 with rfl | ha
  · rw [map_zero, zero_dvd_iff, ← map_zero f] at h
    exact absurd (injective_of_map_ne_zero f hx hfx₀ h) hb
  obtain ⟨i, v, rfl⟩ := _root_.IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha hx
  obtain ⟨j, w, rfl⟩ := _root_.IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb hx
  simp only [map_mul, map_pow, (v.isUnit.map f).mul_left_dvd, (w.isUnit.map f).dvd_mul_left,
    v.isUnit.mul_left_dvd, w.isUnit.dvd_mul_left] at h ⊢
  exact pow_dvd_pow x ((pow_dvd_pow_iff hfx₀ hfx).mp h)

/-- If `(maximalIdeal S).map (algebraMap S R') = maximalIdeal R' ^ e` between discrete valuation
rings, then `algebraMap S R'` is injective. -/
theorem algebraMap_injective_of_map_maximalIdeal_eq_pow {R' : Type*} [CommRing R'] [IsDomain R']
    [_root_.IsDiscreteValuationRing R'] [Algebra S R'] {e : ℕ}
    (h : (maximalIdeal S).map (algebraMap S R') = maximalIdeal R' ^ e) :
    Function.Injective (algebraMap S R') := by
  obtain ⟨π, hπ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible S
  refine injective_of_map_ne_zero (algebraMap S R') hπ fun h0 ↦ ?_
  have hbot : maximalIdeal R' ^ e = ⊥ := by
    rw [← h, hπ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton, h0,
      Ideal.span_singleton_eq_bot]
  exact pow_ne_zero e (_root_.IsDiscreteValuationRing.not_a_field R') hbot

/-- If `(maximalIdeal S).map (algebraMap S R') = maximalIdeal R'` between discrete valuation rings,
then `algebraMap S R'` is injective. -/
theorem algebraMap_injective_of_map_maximalIdeal_eq {R' : Type*} [CommRing R'] [IsDomain R']
    [_root_.IsDiscreteValuationRing R'] [Algebra S R']
    (h : (maximalIdeal S).map (algebraMap S R') = maximalIdeal R') :
    Function.Injective (algebraMap S R') :=
  algebraMap_injective_of_map_maximalIdeal_eq_pow (e := 1) (by simpa using h)

/-- If `(maximalIdeal S).map (algebraMap S R') = maximalIdeal R' ^ e` (`e ≠ 0`) between discrete
valuation rings, then `algebraMap S R'` multiplies the normalized additive valuation by `e`. -/
theorem addVal_algebraMap_of_map_maximalIdeal_eq_pow {R' : Type*} [CommRing R'] [IsDomain R']
    [_root_.IsDiscreteValuationRing R'] [Algebra S R'] {e : ℕ} (he : e ≠ 0)
    (h : (maximalIdeal S).map (algebraMap S R') = maximalIdeal R' ^ e) (a : S) :
    _root_.IsDiscreteValuationRing.addVal R' (algebraMap S R' a) =
      e • _root_.IsDiscreteValuationRing.addVal S a := by
  rcases eq_or_ne a 0 with rfl | ha
  · simp [he]
  obtain ⟨π, hπ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible S
  obtain ⟨ϖ, hϖ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible R'
  have hspan : Ideal.span {algebraMap S R' π} = Ideal.span {ϖ ^ e} := by
    rw [← Ideal.span_singleton_pow, ← hϖ.maximalIdeal_eq, ← h, hπ.maximalIdeal_eq,
      Ideal.map_span, Set.image_singleton]
  obtain ⟨v, hv⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan.symm
  have hπval : _root_.IsDiscreteValuationRing.addVal R' (algebraMap S R' π) = e :=
    _root_.IsDiscreteValuationRing.addVal_def _ v hϖ e (mul_comm (ϖ ^ e) (v : R') ▸ hv.symm)
  obtain ⟨k, u, rfl⟩ := _root_.IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha hπ
  have hu' : _root_.IsDiscreteValuationRing.addVal R' (algebraMap S R' u) = 0 :=
    _root_.IsDiscreteValuationRing.addVal_eq_zero_iff.mpr (u.isUnit.map _)
  rw [map_mul, map_pow, _root_.IsDiscreteValuationRing.addVal_mul,
    _root_.IsDiscreteValuationRing.addVal_pow, hu', zero_add, hπval,
    _root_.IsDiscreteValuationRing.addVal_def' u hπ k, nsmul_eq_mul, nsmul_eq_mul, mul_comm]

/-- If `(maximalIdeal S).map (algebraMap S R') = maximalIdeal R'` between discrete valuation rings,
then `algebraMap S R'` preserves the normalized additive valuation `addVal`. -/
theorem addVal_algebraMap_of_map_maximalIdeal_eq {R' : Type*} [CommRing R'] [IsDomain R']
    [_root_.IsDiscreteValuationRing R'] [Algebra S R']
    (h : (maximalIdeal S).map (algebraMap S R') = maximalIdeal R') (a : S) :
    _root_.IsDiscreteValuationRing.addVal R' (algebraMap S R' a) =
      _root_.IsDiscreteValuationRing.addVal S a := by
  simpa using addVal_algebraMap_of_map_maximalIdeal_eq_pow one_ne_zero (by simpa using h) a

/-- **Orthogonality of powers of a uniformizer.** Let `S → R'` be an algebra map between discrete
valuation rings scaling `addVal` by `e`, let `ϖ` be a uniformizer of `R'`, and let `n ≤ e`. For
any `c : Fin n → S`, the terms `algebraMap S R' (c i) * ϖ ^ (i : ℕ)` lie in distinct residue
classes modulo `e`, so the additive valuation of their sum is the minimum of their valuations. -/
theorem addVal_sum_algebraMap_mul_pow_of_irreducible {R' : Type*} [CommRing R'] [IsDomain R']
    [_root_.IsDiscreteValuationRing R'] [Algebra S R'] {e : ℕ}
    (hscale : ∀ a : S, _root_.IsDiscreteValuationRing.addVal R' (algebraMap S R' a) =
      e • _root_.IsDiscreteValuationRing.addVal S a)
    {ϖ : R'} (hϖ : Irreducible ϖ) {n : ℕ} (hn : n ≤ e) (c : Fin n → S) :
    _root_.IsDiscreteValuationRing.addVal R'
        (∑ i, algebraMap S R' (c i) * ϖ ^ (i : ℕ)) =
      ⨅ i, e • _root_.IsDiscreteValuationRing.addVal S (c i) + (i : ℕ) := by
  classical
  obtain ⟨π, hπ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible S
  have hterm (i : Fin n) :
      _root_.IsDiscreteValuationRing.addVal R' (algebraMap S R' (c i) * ϖ ^ (i : ℕ)) =
        e • _root_.IsDiscreteValuationRing.addVal S (c i) + (i : ℕ) := by
    rw [_root_.IsDiscreteValuationRing.addVal_mul, _root_.IsDiscreteValuationRing.addVal_pow,
      hscale, _root_.IsDiscreteValuationRing.addVal_uniformizer hϖ, nsmul_one]
  have hdistinct : ∀ i ∈ Finset.univ, ∀ j ∈ Finset.univ, i ≠ j →
      _root_.IsDiscreteValuationRing.addVal R' (algebraMap S R' (c i) * ϖ ^ (i : ℕ)) ≠ ⊤ →
      _root_.IsDiscreteValuationRing.addVal R' (algebraMap S R' (c j) * ϖ ^ (j : ℕ)) ≠ ⊤ →
      _root_.IsDiscreteValuationRing.addVal R' (algebraMap S R' (c i) * ϖ ^ (i : ℕ)) ≠
        _root_.IsDiscreteValuationRing.addVal R' (algebraMap S R' (c j) * ϖ ^ (j : ℕ)) := by
    intro i _ j _ hij hi0 hj0 hval
    have hci : c i ≠ 0 := fun h ↦ hi0 (by simp [h])
    have hcj : c j ≠ 0 := fun h ↦ hj0 (by simp [h])
    obtain ⟨ni, ui, hci'⟩ := _root_.IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hci hπ
    obtain ⟨nj, uj, hcj'⟩ := _root_.IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hcj hπ
    rw [hterm, hterm, hci', hcj', _root_.IsDiscreteValuationRing.addVal_def' ui hπ ni,
      _root_.IsDiscreteValuationRing.addVal_def' uj hπ nj] at hval
    have hnat : e * ni + (i : ℕ) = e * nj + (j : ℕ) := by
      have hval' : ((e * ni + (i : ℕ) : ℕ) : ℕ∞) = e * nj + (j : ℕ) := by
        simpa [nsmul_eq_mul] using hval
      exact_mod_cast hval'
    have hmod := congrArg (· % e) hnat
    have hijval : (i : ℕ) = (j : ℕ) := by
      simpa [Nat.add_mod, Nat.mod_eq_of_lt (i.isLt.trans_le hn),
        Nat.mod_eq_of_lt (j.isLt.trans_le hn)] using hmod
    exact hij (Fin.ext hijval)
  rw [AddValuation.map_sum_eq_inf_of_ne _ _ _ hdistinct, Finset.inf_univ_eq_iInf]
  exact iInf_congr hterm

/-- Polynomial evaluation form of `addVal_sum_algebraMap_mul_pow_of_irreducible`: for an algebra
map `S → R'` between discrete valuation rings scaling `addVal` by `e`, a uniformizer `ϖ` of `R'`,
and `p : Polynomial S` with `p.natDegree < e`, the valuation of `aeval ϖ p` is the minimum of
`e • addVal S (p.coeff i) + i` for `i : Fin e`. -/
theorem addVal_aeval_of_natDegree_lt {R' : Type*} [CommRing R'] [IsDomain R']
    [_root_.IsDiscreteValuationRing R'] [Algebra S R'] {e : ℕ}
    (hscale : ∀ a : S, _root_.IsDiscreteValuationRing.addVal R' (algebraMap S R' a) =
      e • _root_.IsDiscreteValuationRing.addVal S a)
    {ϖ : R'} (hϖ : Irreducible ϖ) {p : Polynomial S} (hp : p.natDegree < e) :
    _root_.IsDiscreteValuationRing.addVal R' (Polynomial.aeval ϖ p) =
      ⨅ i : Fin e, e • _root_.IsDiscreteValuationRing.addVal S (p.coeff i) + (i : ℕ) := by
  have hsum : Polynomial.aeval ϖ p =
      ∑ i : Fin e, algebraMap S R' (p.coeff i) * ϖ ^ (i : ℕ) := by
    rw [Polynomial.aeval_eq_sum_range' hp, ← Fin.sum_univ_eq_sum_range (fun i ↦ p.coeff i • ϖ ^ i)]
    exact Finset.sum_congr rfl fun i _ ↦ by rw [Algebra.smul_def]
  rw [hsum, addVal_sum_algebraMap_mul_pow_of_irreducible hscale hϖ le_rfl]

end Map

end TauCeti.IsDiscreteValuationRing
