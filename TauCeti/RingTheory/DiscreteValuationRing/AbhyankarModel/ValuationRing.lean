/-!
# Valuation rings generated by a root of a uniformizer

Let `A → B` be a local map of discrete valuation rings with uniformizers `π` and `ϖ`, and write
`π = u ϖ ^ e` with `u` a unit and `e` invertible in `B`. Let `S` be a valuation ring over `B`,
with local and injective structure map, and let `t ∈ S` be the image of the root of the Kummer
ring `A[T]/(T ^ (e d) − π)` under an `A`-algebra map. Suppose every element of `S` becomes an
element of `B[t]` after multiplication by a nonzero element of `B`; for instance, `S` is a local
ring of the integral closure of `B` in `L(t)`, where `L` is the fraction field of `B`.

Then `S` is a quotient of a localization of the Abhyankar model
`D = (B[y]/(y ^ e − u))[x]/(x ^ d − ϖ y)` (`TauCeti.abhyankarModel`) at a maximal ideal. The
element `y` maps to `t ^ d / ϖ`, which lies in `S` because `S` is a valuation ring and
`(t ^ d / ϖ) ^ e = u`. The localization `D_M` is a valuation ring with the same fractions as
`S`, so the local map `D_M → S` is onto. As `D_M` is formally unramified over the Kummer ring
when `A → B` is essentially of finite type with separable residue extension
(`TauCeti.formallyUnramified_abhyankarModelKummerHom`), so is `S`
(`TauCeti.formallyUnramified_of_valuationRing`).

Applied to the local rings of the integral closure in `L(π ^ (1 / n))`, for a finite separable
extension `L` of the fraction field of `A` and `n` a multiple of the ramification index, this is
the local computation in Abhyankar's lemma for discrete valuation rings.

## References

* A. Grothendieck, *Revêtements étales et groupe fondamental* (SGA 1), Exposé X, Lemme 3.6.
* [Stacks Project, Lemma 15.116.4](https://stacks.math.columbia.edu/tag/0BRM).
-/

public section

open Polynomial IsLocalRing

namespace TauCeti

section Root

variable {S : Type*} [CommRing S] [IsDomain S] [ValuationRing S]

/-- In a valuation ring, an `e d`-th root `t` of `u ϖ ^ e` with `ϖ ≠ 0` gives an `e`-th root
`t ^ d / ϖ` of `u`: the element `t ^ d` is divisible by `ϖ`. -/
private theorem exists_pow_eq_mul_of_pow_mul_eq {ϖ u t : S} (hϖ : ϖ ≠ 0) {e d : ℕ}
    (he : e ≠ 0) (ht : t ^ (e * d) = u * ϖ ^ e) : ∃ s : S, t ^ d = ϖ * s ∧ s ^ e = u := by
  have key (s : S) (hs : t ^ d = ϖ * s) : s ^ e = u := by
    refine mul_left_cancel₀ (pow_ne_zero e hϖ) ?_
    rw [← mul_pow, ← hs, ← pow_mul, mul_comm d e, ht, mul_comm]
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_one.mpr (Nat.pos_of_ne_zero he)
  obtain ⟨c, hc | hc⟩ := ValuationRing.cond ϖ (t ^ d)
  · exact ⟨c, hc.symm, key c hc.symm⟩
  -- Otherwise `t ^ d * c = ϖ`, so `u * c ^ (k + 1) = 1` and `t ^ d = ϖ * (u * c ^ k)`.
  have h1 : u * c ^ (k + 1) = 1 := by
    refine mul_left_cancel₀ (pow_ne_zero (k + 1) hϖ) ?_
    calc ϖ ^ (k + 1) * (u * c ^ (k + 1)) = t ^ ((k + 1) * d) * c ^ (k + 1) := by rw [ht]; ring
      _ = (t ^ d * c) ^ (k + 1) := by ring
      _ = ϖ ^ (k + 1) * 1 := by rw [hc, mul_one]
  have hs : t ^ d = ϖ * (u * c ^ k) :=
    calc t ^ d = t ^ d * (u * c ^ (k + 1)) := by rw [h1, mul_one]
      _ = t ^ d * c * (u * c ^ k) := by ring
      _ = ϖ * (u * c ^ k) := by rw [hc]
  exact ⟨u * c ^ k, hs, key _ hs⟩

end Root

section Lift

variable {B S : Type*} [CommRing B] [CommRing S] [Algebra B S] {ϖ u : B} {e d : ℕ}

/-- The `B`-algebra map from the Abhyankar model `(B[y]/(y ^ e − u))[x]/(x ^ d − ϖ y)` sending
`y` to `s` and `x` to `t`, for `s ^ e = u` and `t ^ d = ϖ s`. -/
private noncomputable def abhyankarModelLift {s t : S} (hs : s ^ e = algebraMap B S u)
    (ht : t ^ d = algebraMap B S ϖ * s) : abhyankarModel ϖ u e d →ₐ[B] S :=
  AdjoinRoot.liftAlgHom _ (AdjoinRoot.liftAlgHom (X ^ e - C u) (Algebra.ofId B S) s (by simp [hs]))
    t (by simp [ht])

private theorem abhyankarModelLift_root {s t : S} (hs : s ^ e = algebraMap B S u)
    (ht : t ^ d = algebraMap B S ϖ * s) :
    abhyankarModelLift hs ht (abhyankarModelRoot ϖ u e d) = t :=
  AdjoinRoot.liftAlgHom_root ..

end Lift

variable {A B S : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
  [CommRing B] [IsDomain B] [IsDiscreteValuationRing B] [Algebra A B]
  [CommRing S] [IsDomain S] [ValuationRing S] [Algebra B S] [IsLocalHom (algebraMap B S)]
  [FaithfulSMul B S] [Algebra A S] [IsScalarTower A B S]
  {π : A} {ϖ u : B} {e d : ℕ}

/-- **Abhyankar's lemma for a valuation ring.** Let `A → B` be a local map of discrete valuation
rings, essentially of finite type with separable residue extension, with uniformizers `π` and
`ϖ` such that `π = u ϖ ^ e` with `u` a unit and `e` invertible in `B`. Let `S` be a valuation
ring over `B`, with local and injective structure map, and let `f` be an `A`-algebra map from
the Kummer ring `A[T]/(T ^ (e d) − π)` to `S`, for `d ≠ 0`. If every element of `S` lies in
`B[f(T)]` after multiplication by a nonzero element of `B`, then `f` is formally unramified. -/
theorem formallyUnramified_of_valuationRing [IsLocalHom (algebraMap A B)]
    [Algebra.EssFiniteType A B] [Algebra.IsSeparable (ResidueField A) (ResidueField B)]
    (hπ : Irreducible π) (hϖ : Irreducible ϖ) (hu : IsUnit u) (he : IsUnit (e : B))
    (hd : d ≠ 0) (hπB : algebraMap A B π = u * ϖ ^ e)
    (f : standardTameCover A π (e * d) →ₐ[A] S)
    (hgen : ∀ z : S, ∃ b : B, b ≠ 0 ∧
      algebraMap B S b * z ∈ Algebra.adjoin B {f (AdjoinRoot.root _)}) :
    f.toRingHom.FormallyUnramified := by
  set t := f (AdjoinRoot.root _)
  let D := abhyankarModel ϖ u e d
  have he₀ : e ≠ 0 := he.neZero_natCast.out
  have hinj := FaithfulSMul.algebraMap_injective B S
  have hbS {b : B} (hb : b ≠ 0) : algebraMap B S b ≠ 0 := (map_ne_zero_iff _ hinj).mpr hb
  -- `t` is an `e d`-th root of `u ϖ ^ e`, so `y = t ^ d / ϖ` lies in the valuation ring `S`.
  have ht : t ^ (e * d) = algebraMap B S u * algebraMap B S ϖ ^ e := by
    rw [← map_pow, AdjoinRoot.root_X_pow_sub_C_pow, ← AdjoinRoot.algebraMap_eq, AlgHom.commutes,
      IsScalarTower.algebraMap_apply A B S, hπB, map_mul, map_pow]
  obtain ⟨s, hts, hs⟩ := exists_pow_eq_mul_of_pow_mul_eq (hbS hϖ.ne_zero) he₀ ht
  set φ := abhyankarModelLift hs hts
  have hφx : φ (abhyankarModelRoot ϖ u e d) = t := abhyankarModelLift_root hs hts
  -- The kernel of `D → S → κ(S)` is a maximal ideal `M`, lying over the closed point of `B`.
  let M := (maximalIdeal S).comap φ
  have : M.IsMaximal := by
    obtain ⟨_, hrank⟩ := abhyankarModel_free ϖ u (Nat.pos_of_ne_zero he₀) (Nat.pos_of_ne_zero hd)
    have : Module.Finite B D :=
      Module.finite_of_finrank_pos (hrank ▸ Nat.pos_of_ne_zero (mul_ne_zero he₀ hd))
    apply Ideal.isMaximal_of_isIntegral_of_isMaximal_under (R := B)
    have : M.under B = maximalIdeal B := by
      ext b
      simp only [M, Ideal.under_def, Ideal.mem_comap, AlgHom.commutes]
      rw [← Ideal.mem_comap, maximalIdeal_comap]
    rw [this]
    infer_instance
  let DM := Localization.AtPrime M
  have := isRegularLocalRing_abhyankarModel DM M hϖ hu he hd
  have := isDiscreteValuationRing_abhyankarModel DM M hϖ hu he hd
  -- `φ` extends to the localization `D_M`, by a local homomorphism.
  have hunit (y : M.primeCompl) : IsUnit (φ y) := by
    by_contra h
    exact y.2 ((mem_maximalIdeal _).mpr h)
  let φM : DM →+* S := IsLocalization.lift (M := M.primeCompl) hunit
  have hφM (a : D) : φM (algebraMap D DM a) = φ a := IsLocalization.lift_eq hunit a
  have : IsLocalHom φM := IsLocalization.AtPrime.isLocalHom_lift M hunit le_rfl
  -- The valuation ring `D_M` maps onto `S`, which has the same fractions.
  have hsurj : Function.Surjective φM := by
    intro z
    obtain ⟨b, hb, hbz⟩ := hgen z
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hbz
    obtain ⟨p, hp⟩ := hbz
    have hw : φM (algebraMap D DM (aeval (abhyankarModelRoot ϖ u e d) p)) =
        algebraMap B S b * z := by
      rw [hφM, ← Polynomial.aeval_algHom_apply, hφx]
      exact hp
    have hb' : φM (algebraMap D DM (algebraMap B D b)) = algebraMap B S b := by
      rw [hφM, AlgHom.commutes]
    obtain ⟨c, hc | hc⟩ := ValuationRing.cond (algebraMap D DM (algebraMap B D b))
      (algebraMap D DM (aeval (abhyankarModelRoot ϖ u e d) p))
    · refine ⟨c, mul_left_cancel₀ (hbS hb) ?_⟩
      calc algebraMap B S b * φM c = φM (algebraMap D DM (algebraMap B D b) * c) := by
            rw [map_mul φM, hb']
        _ = algebraMap B S b * z := by rw [hc, hw]
    · have hzc : z * φM c = 1 := by
        refine mul_left_cancel₀ (hbS hb) ?_
        calc algebraMap B S b * (z * φM c)
            _ = φM (algebraMap D DM (aeval (abhyankarModelRoot ϖ u e d) p) * c) := by
              rw [map_mul φM, hw, mul_assoc]
            _ = algebraMap B S b * 1 := by rw [hc, hb', mul_one]
      have hcu : IsUnit c := isUnit_of_map_unit φM c (IsUnit.of_mul_eq_one_right _ hzc)
      refine ⟨↑hcu.unit⁻¹, mul_right_cancel₀ (IsUnit.of_mul_eq_one_right _ hzc).ne_zero ?_⟩
      rw [hzc, ← map_mul, IsUnit.val_inv_mul, map_one]
  -- `f` factors through `D_M`, which is formally unramified over the Kummer ring.
  have hcomp : f.toRingHom =
      φM.comp ((algebraMap D DM).comp (abhyankarModelKummerHom (d := d) hπB).toRingHom) := by
    refine AdjoinRoot.ringHom_ext (RingHom.ext fun a ↦ ?_) ?_
    · simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        ← AdjoinRoot.algebraMap_eq, AlgHom.commutes, hφM, IsScalarTower.algebraMap_apply A B S]
      rw [IsScalarTower.algebraMap_apply A B (abhyankarModel ϖ u e d), AlgHom.commutes]
    · simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        abhyankarModelKummerHom_root, hφM, hφx, t]
  rw [hcomp]
  exact .comp (formallyUnramified_abhyankarModelKummerHom hπ hϖ hu he hd hπB M)
    (.of_surjective hsurj)

end TauCeti
