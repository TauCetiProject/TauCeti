import TauCeti.RingTheory.RamificationInertia.DiscreteValuationRing

/-!
# Norms in a finite free extension of discrete valuation rings

Let `S` be a discrete valuation ring which is a finite free algebra over a discrete valuation ring
`R`, with ramification index `e` and residue degree `f` (Mathlib's `Ideal.ramificationIdx` and
`Ideal.inertiaDeg` of the maximal ideal of `S`). This file computes the valuation and the residue of
the determinant norm `N = Algebra.norm R : S → R`:

* `v_R(N x) = f · v_S(x)` for every `x ∈ S`;
* `res_R(N x) = N_{l/k}(res_S x) ^ e` for every `x ∈ S`, where `k` and `l` are the residue fields.

No separability of the fraction field extension or of the residue field extension is assumed, so
these apply to complete discrete valuation rings with imperfect residue fields. They are the
integral inputs for the residue of a norm of a symbol under a finite extension of discretely valued
fields.

The residue formula is proved in `S ⧸ 𝔪_R S = S ⧸ ϖᵉ S` (the identity `𝔪_R S = 𝔪_S ^ e` is
`TauCeti.IsDiscreteValuationRing.map_maximalIdeal_eq_pow_ramificationIdx`), a finite algebra over
`k` whose filtration by the powers of a uniformizer `ϖ` has `e` successive quotients, each the
residue field `l` (`TauCeti.Algebra.norm_eq_norm_mk_span_singleton_pow`). The valuation formula
follows from the fundamental identity `e f = [S : R]`
(`TauCeti.RamificationInertia.ramificationIdx_mul_inertiaDeg_eq_finrank_of_isLocalRing`) applied to
the norm of a uniformizer of `R`.

## Main results

* `TauCeti.IsDiscreteValuationRing.addVal_norm`: `v_R(N x) = f · v_S(x)`.
* `TauCeti.IsDiscreteValuationRing.residue_norm`: `res_R(N x) = N_{l/k}(res_S x) ^ e`.

## References

* P. Gille, T. Szamuely, *Central Simple Algebras and Galois Cohomology*, Lemma 7.3.10 and
  Proposition A.6.8.
* [Stacks: Tag 02MJ](https://stacks.math.columbia.edu/tag/02MJ)
-/

public section

open IsLocalRing Ideal

namespace TauCeti.IsDiscreteValuationRing

variable {R S : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [CommRing S] [IsDomain S] [IsDiscreteValuationRing S] [Algebra R S]
  [Module.Free R S] [Module.Finite R S]

/-- The extension of the maximal ideal of `R` to `S` is generated by `ϖ ^ e` for a uniformizer `ϖ`
of `S`. -/
private theorem map_maximalIdeal_eq_span_pow {ϖ : S} (hϖ : Irreducible ϖ) :
    (maximalIdeal R).map (algebraMap R S) = span {ϖ ^ (maximalIdeal S).ramificationIdx R} := by
  rw [map_maximalIdeal_eq_pow_ramificationIdx
      (map_ne_bot_of_ne_bot (IsDiscreteValuationRing.not_a_field R)),
    ← span_singleton_pow, ← hϖ.maximalIdeal_eq]

omit [IsDomain S] [IsDiscreteValuationRing S] [Module.Free R S] [Module.Finite R S] in
/-- The norm of a unit of `S` has valuation zero. -/
private theorem addVal_norm_unit (u : Sˣ) :
    IsDiscreteValuationRing.addVal R (Algebra.norm R (u : S)) = 0 := by
  simpa using IsDiscreteValuationRing.addVal_eq_zero_of_unit
    (Units.map (Algebra.norm R : S →* R) u)

/-- The norm of a uniformizer of `S` has valuation `f`, the residue degree. -/
private theorem addVal_norm_of_irreducible {ϖ : S} (hϖ : Irreducible ϖ) :
    IsDiscreteValuationRing.addVal R (Algebra.norm R ϖ) = (maximalIdeal S).inertiaDeg R := by
  set e := (maximalIdeal S).ramificationIdx R
  have he : 0 < e := Ideal.ramificationIdx_pos R (maximalIdeal S)
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  -- A uniformizer of `R` is `ϖ ^ e` times a unit of `S`; compare the valuations of the norms.
  have hassoc : Associated (ϖ ^ e) (algebraMap R S π) := by
    rw [← span_singleton_eq_span_singleton, ← map_maximalIdeal_eq_span_pow hϖ,
      hπ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  obtain ⟨u, hu⟩ := hassoc
  have h := congrArg (fun y => IsDiscreteValuationRing.addVal R (Algebra.norm R y)) hu
  simp only [map_mul, map_pow, Algebra.norm_algebraMap, IsDiscreteValuationRing.addVal_mul,
    IsDiscreteValuationRing.addVal_pow, IsDiscreteValuationRing.addVal_uniformizer hπ,
    addVal_norm_unit, add_zero,
    ← RamificationInertia.ramificationIdx_mul_inertiaDeg_eq_finrank_of_isLocalRing R] at h
  -- `h : e • v_R(N ϖ) = (e f) • 1`; cancel `e > 0` in `ℕ∞`.
  generalize IsDiscreteValuationRing.addVal R (Algebra.norm R ϖ) = a at h ⊢
  induction a using ENat.recTopCoe with
  | top =>
    rw [nsmul_eq_mul, ENat.mul_top (by exact_mod_cast he.ne'), nsmul_one] at h
    exact (ENat.natCast_ne_top _ h.symm).elim
  | coe m =>
    rw [nsmul_eq_mul, nsmul_eq_mul, mul_one] at h
    norm_cast at h ⊢
    exact Nat.eq_of_mul_eq_mul_left he h

/-- **The valuation of a norm in a finite free extension of discrete valuation rings**:
`v_R(N_{S/R}(x)) = f · v_S(x)` for every `x ∈ S`, where `f` is the residue degree. -/
@[simp]
theorem addVal_norm (x : S) :
    IsDiscreteValuationRing.addVal R (Algebra.norm R x) =
      (maximalIdeal S).inertiaDeg R • IsDiscreteValuationRing.addVal S x := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible S
  rcases eq_or_ne x 0 with rfl | hx
  · have hf : (maximalIdeal S).inertiaDeg R ≠ 0 := (Ideal.inertiaDeg_pos (maximalIdeal S) R).ne'
    simp [Algebra.norm_zero, hf]
  obtain ⟨m, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx hϖ
  simp only [map_mul, map_pow, IsDiscreteValuationRing.addVal_mul, addVal_norm_unit,
    IsDiscreteValuationRing.addVal_pow, addVal_norm_of_irreducible hϖ,
    IsDiscreteValuationRing.addVal_def' u hϖ m, zero_add, nsmul_eq_mul, mul_comm]

/-- **The residue of a norm in a finite free extension of discrete valuation rings**:
`res_R(N_{S/R}(x)) = N_{l/k}(res_S(x)) ^ e` for every `x ∈ S`, where `k` and `l` are the residue
fields and `e` is the ramification index. The residue field extension need not be separable. -/
@[simp]
theorem residue_norm (x : S) :
    residue R (Algebra.norm R x) =
      Algebra.norm (ResidueField R) (residue S x) ^ (maximalIdeal S).ramificationIdx R := by
  set e := (maximalIdeal S).ramificationIdx R
  set I := (maximalIdeal R).map (algebraMap R S)
  have he : 0 < e := Ideal.ramificationIdx_pos R (maximalIdeal S)
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible S
  have hIϖ : I = span {ϖ ^ e} := map_maximalIdeal_eq_span_pow hϖ
  -- Apply the filtration formula in `V = S ⧸ 𝔪_R S = S ⧸ ϖᵉ S` with `w` the class of `ϖ`.
  set w := Ideal.Quotient.mk I ϖ
  have hw : w ^ e = 0 := by
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, hIϖ]
    exact mem_span_singleton_self _
  have hker (y : S ⧸ I) (hy : w ^ (e - 1) * y = 0) : y ∈ span {w} := by
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
    have hsplit : ϖ ^ e = ϖ ^ (e - 1) * ϖ := by rw [← pow_succ, Nat.sub_add_cancel he]
    rw [← map_pow, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, hIϖ, mem_span_singleton,
      hsplit] at hy
    obtain ⟨t, rfl⟩ := (mul_dvd_mul_iff_left (pow_ne_zero _ hϖ.ne_zero)).mp hy
    rw [map_mul]
    exact mul_mem_right _ _ (mem_span_singleton_self _)
  let : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  have : Module.Finite (R ⧸ maximalIdeal R) (S ⧸ I) := .of_restrictScalars_finite R _ _
  have key := TauCeti.Algebra.norm_eq_norm_mk_span_singleton_pow (k := R ⧸ maximalIdeal R) e hw
    hker (Ideal.Quotient.mk I x)
  rw [TauCeti.Algebra.norm_quotient_mk] at key
  rw [residue_def, key]
  congr 1
  -- Identify `V ⧸ w V` with the residue field of `S`, over the residue field of `R`.
  have hle : I ≤ maximalIdeal S := map_le_iff_le_comap.mpr (le_of_eq Ideal.LiesOver.over)
  have hspan : span {w} = (maximalIdeal S).map (Ideal.Quotient.mkₐ R I) := by
    rw [hϖ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton, Ideal.Quotient.mkₐ_eq_mk]
  rw [hspan, TauCeti.Algebra.norm_mk_map_mkₐ_eq_norm Ideal.Quotient.mk_surjective
    (Ideal.Quotient.mkₐ R (maximalIdeal S)) (Ideal.Quotient.mkₐ_surjective R _)
    (Ideal.Quotient.mkₐ_ker R _) hle, Ideal.Quotient.mkₐ_eq_mk, ← residue_def]
  -- `ResidueField R` is defined as `R ⧸ maximalIdeal R`, with the field structure fixed above,
  -- and the algebra `ResidueField R → ResidueField S` is `Ideal.Quotient.algebraOfLiesOver`, the
  -- one acting on `S ⧸ maximalIdeal S` here.
  rfl

end TauCeti.IsDiscreteValuationRing
