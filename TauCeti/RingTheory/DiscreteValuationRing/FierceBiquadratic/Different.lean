module

public import TauCeti.RingTheory.DiscreteValuationRing.FierceBiquadratic.Basic
public import TauCeti.RingTheory.DedekindDomain.Different.Monogenic
import TauCeti.FieldTheory.Separable.SimpleRoot
import TauCeti.RingTheory.AdjoinRoot.Minpoly
import TauCeti.RingTheory.DedekindDomain.Different.Length

/-!
# The different of a fierce biquadratic extension

For the characteristic-two extension `B = A[y,z]` defined by
`y² + ty = s` and `z² + tz = u`, each quadratic step has different generated by `t`.
The tower formula therefore gives `differentIdeal A B = (t²)`. When the residues of
`s, u` are 2-independent and `t` is a uniformizer, the different exponent is two,
although the lower ramification groups have orders four and then one. Thus the
classical Hilbert sum would give three, not two: residue separability cannot be
omitted from that formula. The full residue degree is four, and the complementary
module modulo `B` has length eight over `A`.

The calculation uses the monogenic derivative formula and transitivity of the
different, as in J.-P. Serre, *Local Fields*, Chapter III, §6. No separability of
residue fields is assumed.
-/

public section

open Polynomial IsLocalRing

open scoped nonZeroDivisors

attribute [local instance] FractionRing.liftAlgebra FractionRing.isScalarTower_liftAlgebra

namespace TauCeti.FierceBiquadratic

variable {A : Type*} [CommRing A] [CharP A 2]

section Quadratic

variable [IsDomain A] {t s : A}

/-- The fraction-field extension of a quadratic step is separable whenever `t ≠ 0`,
even if the residue-field extension is inseparable. -/
theorem isSeparable_fractionRing_ringY [IsDomain (RingY t s)] (ht : t ≠ 0) :
    Algebra.IsSeparable (FractionRing A) (FractionRing (RingY t s)) := by
  let x := algebraMap (RingY t s) (FractionRing (RingY t s)) (AdjoinRoot.root (quadratic t s))
  have hp : aeval x ((quadratic t s).map (algebraMap A (FractionRing A))) = 0 := by
    simp only [x, aeval_map_algebraMap, aeval_algebraMap_apply,
      AdjoinRoot.aeval_eq, AdjoinRoot.mk_self, map_zero]
  have hd : aeval x (((quadratic t s).map (algebraMap A (FractionRing A))).derivative) ≠ 0 := by
    rw [Polynomial.derivative_map, derivative_quadratic, Polynomial.map_C, aeval_C]
    simpa only [Function.comp_apply, ← IsScalarTower.algebraMap_apply, map_zero] using
      ((IsFractionRing.injective (RingY t s) (FractionRing (RingY t s))).comp
        (FaithfulSMul.algebraMap_injective A (RingY t s))).ne ht
  have hgen := TauCeti.IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top
    (R := A) (K := FractionRing A) (L := FractionRing (RingY t s))
    (AdjoinRoot.adjoinRoot_eq_top (f := quadratic t s))
  exact (TauCeti.finiteDimensional_and_isSeparable_of_aeval_derivative_ne_zero hgen hp hd).2

variable [IsIntegrallyClosed A] [IsDedekindDomain (RingY t s)]

/-- Each quadratic step has different `(t)`, since its defining polynomial has
constant derivative `t` and the integral closure is monogenic. -/
theorem differentIdeal_ringY (ht : t ≠ 0) :
    differentIdeal A (RingY t s) = Ideal.span {algebraMap A (RingY t s) t} := by
  have := isSeparable_fractionRing_ringY (s := s) ht
  have : FiniteDimensional (FractionRing A) (FractionRing (RingY t s)) :=
    Module.Finite.of_isLocalization A (RingY t s) A⁰
  rw [TauCeti.differentIdeal_eq_span_aeval_derivative_minpoly A (FractionRing A)
    (FractionRing (RingY t s)) (RingY t s) (AdjoinRoot.root (quadratic t s))
    (AdjoinRoot.adjoinRoot_eq_top (f := quadratic t s)),
    AdjoinRoot.minpoly_root_of_monic (monic_quadratic t s),
    derivative_quadratic, aeval_C]

end Quadratic

section Tower

variable [IsDomain A] {t s u : A}

/-- The biquadratic fraction-field extension is separable for nonzero `t`,
regardless of residue inseparability. -/
theorem isSeparable_fractionRing_ringYZ [IsDomain (RingY t s)] [IsDomain (RingYZ t s u)]
    (ht : t ≠ 0) :
    Algebra.IsSeparable (FractionRing A) (FractionRing (RingYZ t s u)) := by
  have : CharP (RingY t s) 2 :=
    CharP.of_ringHom_of_ne_zero (algebraMap A (RingY t s)) 2 two_ne_zero
  have hT : algebraMap A (RingY t s) t ≠ 0 := by
    simpa using (FaithfulSMul.algebraMap_injective A (RingY t s)).ne ht
  have := isSeparable_fractionRing_ringY (s := s) ht
  have := isSeparable_fractionRing_ringY (A := RingY t s)
    (s := algebraMap A (RingY t s) u) hT
  exact Algebra.IsSeparable.trans (FractionRing A) (FractionRing (RingY t s)) _

variable [IsIntegrallyClosed A]
  [IsDedekindDomain (RingY t s)] [IsDedekindDomain (RingYZ t s u)]

/-- The different of the biquadratic algebra is `(t²)`. Both quadratic steps are
monogenic with different `(t)`; their residue fields need not be separable. -/
theorem differentIdeal_ringYZ (ht : t ≠ 0) :
    differentIdeal A (RingYZ t s u) = Ideal.span {(algebraMap A (RingYZ t s u) t) ^ 2} := by
  have : CharP (RingY t s) 2 :=
    CharP.of_ringHom_of_ne_zero (algebraMap A (RingY t s)) 2 two_ne_zero
  have hT : algebraMap A (RingY t s) t ≠ 0 := by
    simpa using (FaithfulSMul.algebraMap_injective A (RingY t s)).ne ht
  have := isSeparable_fractionRing_ringYZ (s := s) (u := u) ht
  rw [differentIdeal_eq_differentIdeal_mul_differentIdeal A (RingY t s) (RingYZ t s u),
    differentIdeal_ringY ht, differentIdeal_ringY hT, Ideal.map_span, Set.image_singleton,
    ← IsScalarTower.algebraMap_apply, Ideal.span_singleton_mul_span_singleton, ← pow_two]

end Tower

section Regression

variable [IsDomain A] [IsDiscreteValuationRing A] {t s u : A}
  [IsDomain (RingYZ t s u)] [IsLocalRing (RingYZ t s u)]
variable (ht : Irreducible t) (hs : ∀ a : ResidueField A, a ^ 2 ≠ residue A s)
  (hu : ∀ a b : ResidueField A, a ^ 2 + residue A s * b ^ 2 ≠ residue A u)
include ht hs hu

/-- The different exponent is two in the fierce biquadratic extension, not three. -/
theorem multiplicity_differentIdeal_ringYZ :
    letI := isDiscreteValuationRing_ringYZ ((mem_maximalIdeal t).mpr ht.not_isUnit) hs hu
    multiplicity (maximalIdeal (RingYZ t s u)) (differentIdeal A (RingYZ t s u)) = 2 := by
  have hmem := (mem_maximalIdeal t).mpr ht.not_isUnit
  have hred := irreducible_map_residue_quadratic hmem hs
  have : IsDomain (RingY t s) := (monic_quadratic t s).isDomain_adjoinRoot hred
  have : IsDiscreteValuationRing (RingY t s) :=
    (monic_quadratic t s).isDiscreteValuationRing_adjoinRoot hred
  have := isDiscreteValuationRing_ringYZ hmem hs hu
  have hT := irreducible_algebraMap_ringYZ ht hs hu
  rw [differentIdeal_ringYZ ht.ne_zero,
    ← Ideal.span_singleton_pow,
    ← (_root_.IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hT]
  have hne : maximalIdeal (RingYZ t s u) ≠ ⊥ := by
    rw [(_root_.IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hT]
    exact fun h ↦ hT.ne_zero (Ideal.span_singleton_eq_bot.mp h)
  exact multiplicity_pow_self_of_prime (Ideal.prime_of_isPrime hne inferInstance) 2

/-- The quotient by the different has length eight over the base DVR: the full
residue degree four multiplies the different exponent two. -/
theorem length_quotient_differentIdeal_ringYZ :
    letI := isDiscreteValuationRing_ringYZ ((mem_maximalIdeal t).mpr ht.not_isUnit) hs hu
    Module.length A (RingYZ t s u ⧸ differentIdeal A (RingYZ t s u)) = 8 := by
  have hmem := (mem_maximalIdeal t).mpr ht.not_isUnit
  have := isDiscreteValuationRing_ringYZ hmem hs hu
  have := isLocalHom_algebraMap_ringYZ hmem hs hu
  have hm := multiplicity_differentIdeal_ringYZ ht hs hu
  have hd : differentIdeal A (RingYZ t s u) ≠ ⊥ := by
    intro hd
    rw [hd, ← Ideal.zero_eq_bot, multiplicity_zero_right] at hm
    norm_num at hm
  rw [IsLocalRing.length_restrictScalars A (RingYZ t s u),
    Ideal.length_quotient_eq_multiplicity _ hd, hm, Module.length_eq_finrank,
    finrank_residueField_ringYZ hmem hs hu]
  norm_num

/-- The complementary module modulo the integral elements has length eight over
`A`, retaining the inseparable factor of the residue degree. -/
theorem length_traceDual_quotient_ringYZ :
    Module.length A
      ((Submodule.traceDual A (FractionRing A)
          (1 : Submodule (RingYZ t s u) (FractionRing (RingYZ t s u)))) ⧸
        (1 : Submodule (RingYZ t s u) (FractionRing (RingYZ t s u))).comap
          (Submodule.traceDual A (FractionRing A)
            (1 : Submodule (RingYZ t s u) (FractionRing (RingYZ t s u)))).subtype) = 8 := by
  have hmem := (mem_maximalIdeal t).mpr ht.not_isUnit
  have hred := irreducible_map_residue_quadratic hmem hs
  have : IsDomain (RingY t s) := (monic_quadratic t s).isDomain_adjoinRoot hred
  have := isDiscreteValuationRing_ringYZ hmem hs hu
  have := isSeparable_fractionRing_ringYZ (s := s) (u := u) ht.ne_zero
  have : FiniteDimensional (FractionRing A) (FractionRing (RingYZ t s u)) :=
    Module.Finite.of_isLocalization A (RingYZ t s u) A⁰
  rw [TauCeti.length_traceDual_quotient_eq_length_quotient_differentIdeal,
    length_quotient_differentIdeal_ringYZ ht hs hu]

omit [IsDomain (RingYZ t s u)] in
/-- The classical lower-group sum is three in this extension. It does not compute
the different exponent, because the residue-field extension is inseparable. -/
theorem finsum_card_ramificationGroup_sub_one_ringYZ :
    (∑ᶠ i : ℕ, (Nat.card (IsLocalRing.ramificationGroup
      (RingYZ t s u ≃ₐ[A] RingYZ t s u) (RingYZ t s u) i) - 1)) = 3 := by
  classical
  have hzero := ramificationGroup_zero_eq_top ((mem_maximalIdeal t).mpr ht.not_isUnit) hs hu
  have hone := ramificationGroup_one_eq_bot ht hs hu
  have hsingle : ∀ i : ℕ, i ≠ 0 → Nat.card (IsLocalRing.ramificationGroup
      (RingYZ t s u ≃ₐ[A] RingYZ t s u) (RingYZ t s u) i) - 1 = 0 := by
    intro i hi
    have hi' : (1 : ℤ) ≤ i := by omega
    have hle := IsLocalRing.ramificationGroup_antitone
      (RingYZ t s u ≃ₐ[A] RingYZ t s u) (RingYZ t s u) hi'
    have heq := eq_bot_iff.mpr (hle.trans_eq hone)
    rw [heq]
    simp
  rw [finsum_eq_single _ 0 hsingle, Nat.cast_zero, hzero,
    Nat.card_congr Subgroup.topEquiv.toEquiv,
    natCard_algEquiv ht hs hu]

/-- Hilbert's lower-ramification-group formula fails without separability of the
residue extension, even for this finite free extension of DVRs. -/
theorem multiplicity_differentIdeal_ne_finsum_ringYZ :
    letI := isDiscreteValuationRing_ringYZ ((mem_maximalIdeal t).mpr ht.not_isUnit) hs hu
    multiplicity (maximalIdeal (RingYZ t s u)) (differentIdeal A (RingYZ t s u)) ≠
      ∑ᶠ i : ℕ, (Nat.card (IsLocalRing.ramificationGroup
        (RingYZ t s u ≃ₐ[A] RingYZ t s u) (RingYZ t s u) i) - 1) := by
  rw [multiplicity_differentIdeal_ringYZ ht hs hu,
    finsum_card_ramificationGroup_sub_one_ringYZ ht hs hu]
  norm_num

end Regression

end TauCeti.FierceBiquadratic
