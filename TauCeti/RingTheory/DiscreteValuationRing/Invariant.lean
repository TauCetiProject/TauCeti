module

public import TauCeti.RingTheory.DiscreteValuationRing.Monogenic
public import TauCeti.RingTheory.Invariant.Basic
import TauCeti.RingTheory.LocalRing.FixedPoints

/-!
# Invariants of group and monoid actions on discrete valuation rings

For any monoid `G` acting on a DVR `B`, minimal additive valuation makes `FixedPoints.subring B G`
and `FixedPoints.subalgebra A B G` principal ideal rings. Under integrality (for instance when `G`
is a finite group) or over a local ring `A` with `(maximalIdeal A).map (algebraMap A B) ≠ ⊥`,
they are discrete valuation rings: divisibility in `B` between invariants holds in `B^G`, so every
nonzero ideal is generated by an element of least valuation in `B`, and `B^G` is not a field.
The action need not be faithful, and `A` is arbitrary.

If moreover `B` is finite over a Noetherian local ring `A`, by a local homomorphism with separable
residue extension, then so is `B^G`, and `B^G` is therefore generated over `A` by a single
element.

## Main results

* `TauCeti.instIsPrincipalIdealRingFixedPointsSubring` and
  `TauCeti.instIsPrincipalIdealRingFixedPointsSubalgebra`: the fixed-point subring and subalgebra
  of a DVR under any monoid action are principal ideal rings.
* `TauCeti.isDiscreteValuationRing_fixedPoints_subalgebra_of_isIntegral`,
  `TauCeti.isDiscreteValuationRing_fixedPoints_subalgebra_of_map_maximalIdeal_ne_bot`, and
  `TauCeti.isDiscreteValuationRing_fixedPoints_subalgebra_of_isDiscreteValuationRing`: DVR
  criteria for `FixedPoints.subalgebra A B G`.
* `TauCeti.FixedPoints.isDiscreteValuationRing_subalgebra` and
  `TauCeti.instIsDiscreteValuationRingFixedPointsSubring`: the invariants `B^G` of a finite group
  form a discrete valuation ring.
* `TauCeti.FixedPoints.exists_adjoin_eq_top`: for a finite local homomorphism `A → B` from a
  Noetherian local ring with separable residue extension, `B^G` is generated over `A` by a single
  element.
-/

public section

open IsLocalRing _root_.IsDiscreteValuationRing

namespace TauCeti

section Monoid

variable {B G : Type*} [CommRing B] [IsDomain B] [_root_.IsDiscreteValuationRing B]
  [Monoid G] [MulSemiringAction G B]

/-- The fixed-point subring of a DVR under any monoid action is a principal ideal ring. -/
instance instIsPrincipalIdealRingFixedPointsSubring :
    IsPrincipalIdealRing (FixedPoints.subring B G) where
  principal I := by
    by_cases hI : I = ⊥; · exact ⟨0, by simp [hI]⟩
    let s : Set (FixedPoints.subring B G) := {x | x ∈ I ∧ x ≠ 0}
    let f (x : FixedPoints.subring B G) := addVal B (x : B)
    have hs : s.Nonempty := Submodule.exists_mem_ne_zero_of_ne_bot hI
    have haI : Function.argminOn f s hs ∈ I := (Function.argminOn_mem f s hs).1
    refine ⟨Function.argminOn f s hs,
      le_antisymm (fun y hyI ↦ ?_) (Ideal.span_le.2 (Set.singleton_subset_iff.2 haI))⟩
    by_cases hy0 : y = 0; · simp [hy0]
    exact Ideal.mem_span_singleton.2 <| coe_dvd_coe_fixedPoints_subring_iff.1 <|
      addVal_le_iff_dvd.1 (Function.argminOn_le f s ⟨hyI, hy0⟩)

/-- The fixed-point subalgebra of a DVR under any monoid action is a principal ideal ring. -/
instance instIsPrincipalIdealRingFixedPointsSubalgebra {A : Type*} [CommSemiring A] [Algebra A B]
    [SMulCommClass G A B] : IsPrincipalIdealRing (FixedPoints.subalgebra A B G) :=
  IsPrincipalIdealRing.of_surjective (fixedPointsSubringEquivSubalgebra A B G).toRingHom
    (fixedPointsSubringEquivSubalgebra A B G).surjective

section FixedPointsDVR

variable {A : Type*} [CommRing A] [Algebra A B] [SMulCommClass G A B]

/-- If a DVR `B` is integral over `FixedPoints.subalgebra A B G` for a monoid `G`, then
`FixedPoints.subalgebra A B G` is a DVR. -/
theorem isDiscreteValuationRing_fixedPoints_subalgebra_of_isIntegral
    [Algebra.IsIntegral (FixedPoints.subalgebra A B G) B] :
    _root_.IsDiscreteValuationRing (FixedPoints.subalgebra A B G) where
  not_a_field' hbot := not_isField B <|
    (Algebra.IsIntegral.isField_iff_isField (R := FixedPoints.subalgebra A B G) (S := B)
      (FaithfulSMul.algebraMap_injective _ B)).mp (isField_iff_maximalIdeal_eq.2 hbot)

/-- When a DVR `B` lies locally over a local ring `A` whose maximal ideal has nonzero image in `B`,
`FixedPoints.subalgebra A B G` is a DVR for any monoid `G`. -/
theorem isDiscreteValuationRing_fixedPoints_subalgebra_of_map_maximalIdeal_ne_bot [IsLocalRing A]
    [IsLocalHom (algebraMap A B)] (h : (maximalIdeal A).map (algebraMap A B) ≠ ⊥) :
    _root_.IsDiscreteValuationRing (FixedPoints.subalgebra A B G) where
  not_a_field' hbot := h <| (Ideal.map_eq_bot_iff_le_ker _).2 fun a ha ↦ by
    have hmem := map_nonunit (algebraMap A (FixedPoints.subalgebra A B G)) a ha
    rw [hbot, Ideal.mem_bot] at hmem
    simp [IsScalarTower.algebraMap_apply A (FixedPoints.subalgebra A B G) B, hmem]

/-- When a DVR `B` lies locally and faithfully over a DVR `A`, `FixedPoints.subalgebra A B G` is a
DVR for any monoid `G`. -/
theorem isDiscreteValuationRing_fixedPoints_subalgebra_of_isDiscreteValuationRing [IsDomain A]
    [_root_.IsDiscreteValuationRing A] [IsLocalHom (algebraMap A B)] [FaithfulSMul A B] :
    _root_.IsDiscreteValuationRing (FixedPoints.subalgebra A B G) :=
  isDiscreteValuationRing_fixedPoints_subalgebra_of_map_maximalIdeal_ne_bot
    (Ideal.map_ne_bot_of_ne_bot (not_a_field A))

end FixedPointsDVR

end Monoid

namespace FixedPoints

variable {A B G : Type*} [CommRing A] [CommRing B] [IsDomain B] [_root_.IsDiscreteValuationRing B]
  [Algebra A B] [Group G] [Finite G] [MulSemiringAction G B] [SMulCommClass G A B]

/-- The invariants `B^G` of a finite group `G` acting on a discrete valuation ring `B` form a
discrete valuation ring. -/
instance isDiscreteValuationRing_subalgebra :
    _root_.IsDiscreteValuationRing (FixedPoints.subalgebra A B G) :=
  have : Algebra.IsIntegral (FixedPoints.subalgebra A B G) B :=
    Algebra.IsInvariant.isIntegral (FixedPoints.subalgebra A B G) B G
  isDiscreteValuationRing_fixedPoints_subalgebra_of_isIntegral

variable [IsLocalRing A] [IsNoetherianRing A] [Module.Finite A B] [IsLocalHom (algebraMap A B)]
  [Algebra.IsSeparable (ResidueField A) (ResidueField B)]

variable (A B G) in
/-- Let `B` be finite over a Noetherian local ring `A`, by a local homomorphism with separable
residue extension, and let a finite group `G` act on `B` by `A`-algebra automorphisms. Then the
invariants `B^G` are generated over `A` by a single element. -/
theorem exists_adjoin_eq_top :
    ∃ y : FixedPoints.subalgebra A B G, Algebra.adjoin A {y} = ⊤ := by
  have : Module.Finite A (FixedPoints.subalgebra A B G) :=
    Module.Finite.of_injective (Subalgebra.val _).toLinearMap Subtype.val_injective
  have := Algebra.isSeparable_tower_bot_of_isSeparable (ResidueField A)
    (ResidueField (FixedPoints.subalgebra A B G)) (ResidueField B)
  obtain ⟨π, hπ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible (FixedPoints.subalgebra A B G)
  exact TauCeti.IsLocalRing.exists_adjoin_eq_top_of_span_eq_maximalIdeal hπ.maximalIdeal_eq.symm

end FixedPoints

section FiniteGroup

variable {B G : Type*} [CommRing B] [IsDomain B] [_root_.IsDiscreteValuationRing B]
  [Group G] [Finite G] [MulSemiringAction G B]

/-- The fixed-point subring of a DVR under a finite group action is a DVR. -/
instance instIsDiscreteValuationRingFixedPointsSubring :
    _root_.IsDiscreteValuationRing (FixedPoints.subring B G) :=
  RingEquivClass.isDiscreteValuationRing (fixedPointsSubringEquivSubalgebra ℤ B G).symm

end FiniteGroup

end TauCeti
