module

public import TauCeti.RingTheory.DiscreteValuationRing.Monogenic
public import TauCeti.RingTheory.Invariant.Basic

/-!
# Invariants of a finite group acting on a discrete valuation ring

Let a finite group `G` act on a discrete valuation ring `B` by `A`-algebra automorphisms. The
fixed ring `B^G = FixedPoints.subalgebra A B G` is again a discrete valuation ring: divisibility
in `B` between invariants holds in `B^G`, so every nonzero ideal of `B^G` is generated by any of
its elements of least valuation in `B`, and `B^G` is not a field because `B` is integral over it.
The action need not be faithful, and `A` is arbitrary.

If moreover `B` is a finite extension of a discrete valuation ring `A` with separable residue
extension, then so is `B^G`, which is therefore generated over `A` by a single element.

## Main results

* `TauCeti.FixedPoints.isDiscreteValuationRing_subalgebra`: the invariants `B^G` form a discrete
  valuation ring.
* `TauCeti.FixedPoints.exists_adjoin_eq_top`: for a finite extension `B` of a discrete valuation
  ring `A` with separable residue extension, `B^G` is generated over `A` by a single element.
-/

public section

open IsLocalRing

namespace TauCeti.FixedPoints

variable {A B G : Type*} [CommRing A] [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
  [Algebra A B] [Group G] [Finite G] [MulSemiringAction G B] [SMulCommClass G A B]

/-- The invariants `B^G` of a finite group `G` acting on a discrete valuation ring `B` form a
discrete valuation ring. -/
instance isDiscreteValuationRing_subalgebra :
    IsDiscreteValuationRing (FixedPoints.subalgebra A B G) := by
  have := Algebra.IsInvariant.isIntegral (FixedPoints.subalgebra A B G) B G
  have hnf : ¬ IsField (FixedPoints.subalgebra A B G) := fun h ↦
    IsDiscreteValuationRing.not_isField B (isField_of_isIntegral_of_isField' h)
  -- Divisibility between invariants in `B` holds in `B^G`, since `B` is a domain.
  have hdvd : ∀ a b : FixedPoints.subalgebra A B G, (a : B) ∣ b → a ∣ b := by
    rintro a b ⟨c, hc⟩
    rcases eq_or_ne (a : B) 0 with ha | ha
    · rw [ha, zero_mul, ZeroMemClass.coe_eq_zero] at hc
      exact hc ▸ dvd_zero a
    refine ⟨⟨c, fun τ ↦ mul_left_cancel₀ ha ?_⟩, Subtype.ext hc⟩
    rw [← hc, ← b.2 τ, hc, smul_mul', a.2 τ]
  -- A nonzero ideal is generated by an element of least valuation in `B`.
  refine { principal := fun I ↦ ?_, not_a_field' := (isField_iff_maximalIdeal_eq.not.1 hnf) }
  rcases eq_or_ne I ⊥ with rfl | hI
  · exact bot_isPrincipal
  let s := {a | a ∈ I ∧ a ≠ 0}
  have hne : s.Nonempty := by
    obtain ⟨a, haI, ha⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
    exact ⟨a, haI, ha⟩
  let v := fun a : FixedPoints.subalgebra A B G ↦ IsDiscreteValuationRing.addVal B a
  refine ⟨Function.argminOn v s hne, le_antisymm (fun b hb ↦ Ideal.mem_span_singleton.2 ?_)
    (Ideal.span_le.2 (Set.singleton_subset_iff.2 (Function.argminOn_mem v s hne).1))⟩
  rcases eq_or_ne b 0 with rfl | hb0
  · exact dvd_zero _
  exact hdvd _ _ <| IsDiscreteValuationRing.addVal_le_iff_dvd.1 <|
    Function.argminOn_le v s (a := b) ⟨hb, hb0⟩

variable [IsDomain A] [IsDiscreteValuationRing A] [Module.Finite A B] [FaithfulSMul A B]
  [Algebra.IsSeparable (ResidueField A) (ResidueField B)]

variable (A B G) in
/-- Let `B` be a finite extension of a discrete valuation ring `A` with separable residue
extension, and let a finite group `G` act on `B` by `A`-algebra automorphisms. Then the
invariants `B^G` are generated over `A` by a single element. -/
theorem exists_adjoin_eq_top :
    ∃ y : FixedPoints.subalgebra A B G, Algebra.adjoin A {y} = ⊤ := by
  have : Module.Finite A (FixedPoints.subalgebra A B G) :=
    Module.Finite.of_injective (Subalgebra.val _).toLinearMap Subtype.val_injective
  have := FaithfulSMul.tower_bot A (FixedPoints.subalgebra A B G) B
  have := Algebra.isSeparable_tower_bot_of_isSeparable (ResidueField A)
    (ResidueField (FixedPoints.subalgebra A B G)) (ResidueField B)
  exact IsDiscreteValuationRing.exists_adjoin_eq_top

end TauCeti.FixedPoints
