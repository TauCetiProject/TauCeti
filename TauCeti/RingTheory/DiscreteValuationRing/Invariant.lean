module

public import TauCeti.RingTheory.DiscreteValuationRing.Monogenic
public import TauCeti.RingTheory.Invariant.Basic
import TauCeti.RingTheory.LocalRing.RingHom

/-!
# Invariants of a finite group acting on a discrete valuation ring

Let a monoid `G` act on a discrete valuation ring `B` by ring endomorphisms. Divisibility in `B`
between invariants holds in `B^G`, so every nonzero ideal of `B^G` is generated by any of its
elements of least valuation in `B`, making `B^G` a principal ideal ring. When `G` is a finite
group, `B^G` is not a field because `B` is integral over it, so `B^G` is a discrete valuation ring.
The action need not be faithful.

If moreover `B` is finite over a Noetherian local ring `A`, by a local homomorphism with separable
residue extension, then so is `B^G`, and `B^G` is therefore generated over `A` by a single
element.

## Main results

* `TauCeti.FixedPoints.instIsPrincipalIdealRingSubring`,
  `TauCeti.FixedPoints.instIsPrincipalIdealRingSubalgebra`: the invariants `B^G` of a monoid
  action on a discrete valuation ring form a principal ideal ring.
* `TauCeti.FixedPoints.instIsDiscreteValuationRingSubring`,
  `TauCeti.FixedPoints.isDiscreteValuationRing_subalgebra`: the invariants `B^G` of a finite group
  acting on a discrete valuation ring form a discrete valuation ring.
* `TauCeti.FixedPoints.exists_adjoin_eq_top`: for a finite local homomorphism `A → B` from a
  Noetherian local ring with separable residue extension, `B^G` is generated over `A` by a single
  element.
-/

public section

open IsLocalRing

namespace TauCeti.FixedPoints

/-- The fixed subring of any monoid action on a discrete valuation ring is a principal ideal ring:
every nonzero ideal is generated by an element minimizing the ambient additive valuation. -/
instance instIsPrincipalIdealRingSubring {B G : Type*} [CommRing B] [IsDomain B]
    [IsDiscreteValuationRing B] [Monoid G] [MulSemiringAction G B] :
    IsPrincipalIdealRing (FixedPoints.subring B G) where
  principal I := by
    classical
    rcases eq_or_ne I ⊥ with rfl | hI
    · exact bot_isPrincipal
    let s := {a : FixedPoints.subring B G | a ∈ I ∧ a ≠ 0}
    have hne : s.Nonempty := by
      obtain ⟨a, haI, ha⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
      exact ⟨a, haI, ha⟩
    let v := fun a : FixedPoints.subring B G ↦ IsDiscreteValuationRing.addVal B a
    refine ⟨Function.argminOn v s hne, le_antisymm (fun b hb ↦ Ideal.mem_span_singleton.2 ?_)
      (Ideal.span_le.2 (Set.singleton_subset_iff.2 (Function.argminOn_mem v s hne).1))⟩
    rcases eq_or_ne b 0 with rfl | hb0
    · exact dvd_zero _
    obtain ⟨c, hc⟩ := IsDiscreteValuationRing.addVal_le_iff_dvd.1 <|
      Function.argminOn_le v s (a := b) ⟨hb, hb0⟩
    have ha0 : ((Function.argminOn v s hne : FixedPoints.subring B G) : B) ≠ 0 := by
      simpa using (Function.argminOn_mem v s hne).2
    refine ⟨⟨c, fun τ ↦ mul_left_cancel₀ ha0 ?_⟩, Subtype.ext hc⟩
    rw [← hc, ← b.property τ, hc, smul_mul', (Function.argminOn v s hne).property τ]

/-- The fixed subalgebra of any monoid action on a discrete valuation ring is a principal ideal
ring. -/
instance instIsPrincipalIdealRingSubalgebra {A B G : Type*} [CommRing A] [CommRing B]
    [IsDomain B] [IsDiscreteValuationRing B] [Algebra A B] [Monoid G] [MulSemiringAction G B]
    [SMulCommClass G A B] : IsPrincipalIdealRing (FixedPoints.subalgebra A B G) :=
  inferInstanceAs (IsPrincipalIdealRing (FixedPoints.subring B G))

/-- The fixed subring of a finite group action on a discrete valuation ring is a discrete
valuation ring. -/
instance instIsDiscreteValuationRingSubring {B G : Type*} [CommRing B] [IsDomain B]
    [IsDiscreteValuationRing B] [Group G] [Finite G] [MulSemiringAction G B] :
    IsDiscreteValuationRing (FixedPoints.subring B G) where
  not_a_field' := by
    have := Algebra.IsInvariant.isIntegral (FixedPoints.subring B G) B G
    have hnf : ¬ IsField (FixedPoints.subring B G) := fun h ↦
      IsDiscreteValuationRing.not_isField B (isField_of_isIntegral_of_isField' h)
    exact isField_iff_maximalIdeal_eq.not.1 hnf

variable {A B G : Type*} [CommRing A] [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
  [Algebra A B] [Group G] [Finite G] [MulSemiringAction G B] [SMulCommClass G A B]

/-- The invariants `B^G` of a finite group `G` acting on a discrete valuation ring `B` form a
discrete valuation ring. -/
instance isDiscreteValuationRing_subalgebra :
    IsDiscreteValuationRing (FixedPoints.subalgebra A B G) :=
  inferInstanceAs (IsDiscreteValuationRing (FixedPoints.subring B G))

variable [IsLocalRing A] [IsNoetherianRing A] [Module.Finite A B] [IsLocalHom (algebraMap A B)]
  [Algebra.IsSeparable (ResidueField A) (ResidueField B)]

variable (A B G) in
/-- Let `B` be finite over a Noetherian local ring `A`, by a local homomorphism with separable
residue extension, and let a finite group `G` act on `B` by `A`-algebra automorphisms. Then the
invariants `B^G` are generated over `A` by a single element. -/
theorem exists_adjoin_eq_top :
    ∃ y : FixedPoints.subalgebra A B G, Algebra.adjoin A {y} = ⊤ := by
  have : Module.Finite A (FixedPoints.subalgebra A B G) :=
    Module.Finite.of_injective (Subalgebra.val _).toLinearMap Subtype.val_injective
  have := Algebra.isSeparable_tower_bot_of_isSeparable (ResidueField A)
    (ResidueField (FixedPoints.subalgebra A B G)) (ResidueField B)
  obtain ⟨π, hπ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible (FixedPoints.subalgebra A B G)
  exact TauCeti.IsLocalRing.exists_adjoin_eq_top_of_span_eq_maximalIdeal hπ.maximalIdeal_eq.symm

end TauCeti.FixedPoints
