/-!
# The Deligne–Serre eigenvalue lifting lemma

Let `O` be a discrete valuation ring with fraction field `K` and residue field `κ`, let `M` be a
finite free `O`-module, and let `(T i)` be a family of pairwise commuting endomorphisms of `M`.
If the reductions of the `T i` have a nonzero common eigenvector in `κ ⊗[O] M`, with eigenvalues
`a i`, then the eigenvalue system `(a i)` lifts to characteristic zero: there are a finite
extension `L` of `K`, a discrete valuation ring `V` of `L` dominating `O`, an embedding `j` of
residue fields, and a nonzero common eigenvector of the `T i` in `V ⊗[O] M` whose eigenvalues
`b i ∈ V` reduce to `j (a i)`.

The proof follows Deligne–Serre. The `O`-subalgebra `H` of `End_O(M)` generated by the `T i` is
commutative and finite free over `O`, even when the family is infinite. Every element of `H`
preserves the residual line, so the residual eigenvalues form a character `χ : H → κ`. That
character lifts to a character `ψ : H → V` with values in a DVR dominating `O`. The algebra
`L ⊗[O] H` acts faithfully on `L ⊗[O] M`, so the character of `L ⊗[O] H` induced by `ψ` occurs on
a nonzero vector, and clearing denominators gives the integral eigenvector.

The lifted eigenvector need not reduce to the given residual one, and the extension `L / K` may
have to be nontrivial, and even inseparable in characteristic two. Neither `L / K` separable nor
`V` finite over `O` is asserted.

## Main results

* `Module.End.apply_mem_span_singleton_of_mem_adjoin`: if every endomorphism in a set preserves
  the line through `f`, so does every element of the subalgebra the set generates.
* `AlgHom.exists_ne_zero_forall_baseChange_lsmul_apply_eq_smul`: a character `Λ → V` of a finite
  commutative algebra acting faithfully on a finitely generated flat module `M` occurs on a
  nonzero vector of `V ⊗[O] M`, for any domain `V` whose fraction field is flat over the base.
* `TauCeti.exists_valuationSubring_forall_baseChange_apply_eq_smul`: the Deligne–Serre eigenvalue
  lifting lemma.

## References

* P. Deligne and J.-P. Serre, *Formes modulaires de poids 1*, Ann. Sci. École Norm. Sup. (4) 7
  (1974), 507–530, Lemme 6.11 and its proof.
-/

public section

open IsLocalRing TensorProduct

namespace Module.End

variable {O k V : Type*} [CommSemiring O] [CommSemiring k] [Algebra O k] [AddCommMonoid V]
  [Module k V] [Module O V] [IsScalarTower O k V]

/-- **Invariant lines under a generated subalgebra.** If every `k`-linear endomorphism in `s`
maps `f` into the line `k ∙ f`, so does every element of the `O`-subalgebra generated by `s`. The
set `s` may be infinite and need not commute, and `f` may be zero. -/
theorem apply_mem_span_singleton_of_mem_adjoin {s : Set (Module.End k V)} {f : V}
    (hs : ∀ T ∈ s, T f ∈ k ∙ f) {T : Module.End k V} (hT : T ∈ Algebra.adjoin O s) :
    T f ∈ k ∙ f := by
  induction hT using Algebra.adjoin_induction with
  | mem T hT => exact hs T hT
  | algebraMap r =>
    rw [Module.algebraMap_end_apply, ← algebraMap_smul k r f]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self f)
  | add S T _ _ hS hT => exact Submodule.add_mem _ hS hT
  | mul S T _ _ hS hT =>
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.1 hT
    rw [mul_apply_eq_comp, ← hc, map_smul]
    exact Submodule.smul_mem _ _ hS

end Module.End

namespace AlgHom

variable {O : Type*} [CommRing O] {V : Type*} [CommRing V] [Algebra O V]
  {L : Type*} [Field L] [Algebra V L] [IsFractionRing V L] [Algebra O L] [IsScalarTower O V L]
  [Module.Flat O L]
  {Λ : Type*} [CommRing Λ] [Algebra O Λ] [Module.Finite O Λ]
  {M : Type*} [AddCommGroup M] [Module O M] [Module.Finite O M] [Module.Flat O M]
  [Module Λ M] [IsScalarTower O Λ M] [FaithfulSMul Λ M]

attribute [local instance low] TauCeti.CentralBaseChange.module

include L in
/-- **Occurrence of an integral character.** Let `Λ` be a finite commutative `O`-algebra acting
faithfully on a finitely generated flat `O`-module `M`, and let `V` be a domain over `O` whose
fraction field `L` is flat over `O`. Every `O`-algebra map `ψ : Λ → V` occurs on `V ⊗[O] M`: some
nonzero `n` satisfies `(l • ·).baseChange V n = ψ l • n` for every `l : Λ`. -/
theorem exists_ne_zero_forall_baseChange_lsmul_apply_eq_smul (ψ : Λ →ₐ[O] V) :
    ∃ n : V ⊗[O] M, n ≠ 0 ∧ ∀ l : Λ, (Algebra.lsmul O O M l).baseChange V n = ψ l • n := by
  -- The character of `L ⊗[O] Λ` induced by `ψ` occurs on the faithful module `L ⊗[O] M`.
  obtain ⟨v, hv0, hv⟩ :
      ∃ v : L ⊗[O] M, v ≠ 0 ∧ ∀ l : Λ, (Algebra.lsmul O O M l).baseChange L v =
        algebraMap V L (ψ l) • v := by
    let ψL : L ⊗[O] Λ →ₐ[L] L := Algebra.TensorProduct.lift (Algebra.ofId L L)
      ((IsScalarTower.toAlgHom O V L).comp ψ) fun _ _ ↦ Commute.all _ _
    have : IsArtinianRing (L ⊗[O] Λ) := IsArtinianRing.of_finite L _
    obtain ⟨v, hv0, hv⟩ := ψL.exists_ne_zero_forall_smul_eq_smul (V := L ⊗[O] M)
    refine ⟨v, hv0, fun l ↦ ?_⟩
    simpa [TauCeti.CentralBaseChange.smul_def, TauCeti.CentralBaseChange.lsmul_tmul, ψL]
      using hv (1 ⊗ₜ l)
  -- Clear the denominators of `v` along the localization `V ⊗[O] M → L ⊗[O] M`.
  let g : V ⊗[O] M →ₗ[V] L ⊗[O] M := AlgebraTensorModule.rTensor O M (Algebra.linearMap V L)
  have hg : Function.Injective g :=
    Module.Flat.rTensor_preserves_injective_linearMap ((Algebra.linearMap V L).restrictScalars O)
      (IsFractionRing.injective V L)
  obtain ⟨n, hn0, hn, -⟩ :=
    IsLocalizedModule.exists_ne_zero_forall_apply_eq_smul_of_injective (nonZeroDivisors V) hg
      (T := fun l : Λ ↦ (Algebra.lsmul O O M l).baseChange V)
      (T' := fun l : Λ ↦ ((Algebra.lsmul O O M l).baseChange L).restrictScalars V)
      (fun l ↦ by ext; simp [g]) hv0 (b := fun l ↦ ψ l) fun l ↦ by
        simpa [algebraMap_smul] using hv l
  exact ⟨n, hn0, hn⟩

end AlgHom

namespace TauCeti

section ResidualCharacter

variable {O : Type*} [CommRing O] {k : Type*} [Field k] [Algebra O k]
  {M : Type*} [AddCommGroup M] [Module O M]

/-- A nonzero common eigenvector of the base changes of a family `(T i)` of endomorphisms of `M`
defines a character of the `O`-subalgebra generated by the family, with value `a i` at `T i`. -/
private theorem exists_algHom_adjoin_apply_eq {ι : Type*} (T : ι → Module.End O M) (a : ι → k)
    {f : k ⊗[O] M} (hf : f ≠ 0) (heig : ∀ i, (T i).baseChange k f = a i • f) :
    ∃ χ : Algebra.adjoin O (Set.range T) →ₐ[O] k,
      ∀ i, χ ⟨T i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ = a i := by
  let H := Algebra.adjoin O (Set.range T)
  let ρ : H →ₐ[O] Module.End k (k ⊗[O] M) := (Module.End.baseChangeHom O k M).comp H.val
  -- `Module.End.baseChangeHom` is `LinearMap.baseChange` bundled as an algebra map.
  have hbc (g : Module.End O M) : Module.End.baseChangeHom O k M g = g.baseChange k := rfl
  -- Every element of `H` preserves the line through `f`.
  have hline (h : H) : ρ h f ∈ k ∙ f := by
    have hmem : Module.End.baseChangeHom O k M h ∈
        Algebra.adjoin O (Module.End.baseChangeHom O k M '' Set.range T) := by
      rw [← AlgHom.map_adjoin]
      exact Subalgebra.mem_map.2 ⟨h, h.property, rfl⟩
    refine Module.End.apply_mem_span_singleton_of_mem_adjoin ?_ hmem
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    exact Submodule.mem_span_singleton.2 ⟨a i, by rw [hbc, heig i]⟩
  choose χ hχ using fun h : H ↦ Submodule.mem_span_singleton.1 (hline h)
  refine ⟨ρ.eigenvalueHomOfJointEigenvector χ f hf fun h ↦
    Module.End.mem_eigenspace_iff.2 (hχ h).symm, fun i ↦ ?_⟩
  have := hχ ⟨T i, Algebra.subset_adjoin ⟨i, rfl⟩⟩
  rw [AlgHom.comp_apply, hbc, Subalgebra.coe_val, heig] at this
  rw [AlgHom.eigenvalueHomOfJointEigenvector_apply]
  exact smul_left_injective _ hf this

end ResidualCharacter

section DeligneSerre

variable {O : Type*} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  (K : Type*) [Field K] [Algebra O K] [IsFractionRing O K]
  {M : Type*} [AddCommGroup M] [Module O M] [Module.Finite O M] [Module.Free O M]

/-- **Deligne–Serre eigenvalue lifting.** Let `O` be a DVR with fraction field `K` and residue
field `κ`, let `M` be a finite free `O`-module and `(T i)` a family, possibly infinite, of pairwise
commuting endomorphisms of `M`. Suppose a nonzero `f : κ ⊗[O] M` satisfies
`(T i).baseChange κ f = a i • f` for every `i`. Then there are a finite extension `L` of `K` inside
an algebraic closure, a DVR `V` of `L` dominating `O` (its `O`-algebra structure being the
inclusion `O → K → L`), an embedding `j : κ → κ_V` compatible with the residue maps, scalars
`b i : V` and a nonzero `f' : V ⊗[O] M` with `(T i).baseChange V f' = b i • f'` and
`residue V (b i) = j (a i)` for every `i`. The extension `L / K` need not be separable, and `f'`
need not reduce to `f`. -/
theorem exists_valuationSubring_forall_baseChange_apply_eq_smul {ι : Type*}
    (T : ι → Module.End O M) (hcomm : ∀ i j, Commute (T i) (T j))
    (a : ι → ResidueField O) (f : ResidueField O ⊗[O] M) (hf : f ≠ 0)
    (heig : ∀ i, (T i).baseChange (ResidueField O) f = a i • f) :
    ∃ (L : IntermediateField K (AlgebraicClosure K)) (V : ValuationSubring L)
      (_ : Algebra O V) (j : ResidueField O →+* ResidueField V),
      Module.Finite K L ∧ IsDiscreteValuationRing V ∧
      Function.Injective (algebraMap O V) ∧ Function.Injective j ∧
      (∀ x : O, (algebraMap O V x : L) = algebraMap K L (algebraMap O K x)) ∧
      (residue V).comp (algebraMap O V) = j.comp (residue O) ∧
      Ideal.comap (algebraMap O V) (maximalIdeal V) = maximalIdeal O ∧
      ∃ (b : ι → V) (f' : V ⊗[O] M), f' ≠ 0 ∧
        ∀ t, (T t).baseChange V f' = b t • f' ∧ residue V (b t) = j (a t) := by
  open scoped IsMulCommutative in
  -- The operator algebra `H` generated by the `T i` is commutative and finite over `O`. As a
  -- submodule of the free module `End_O(M)` over the DVR `O` it is free, so it has going down.
  let H := Algebra.adjoin O (Set.range T)
  have : IsMulCommutative H := Algebra.isMulCommutative_adjoin O <| by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ -
    exact hcomm i j
  have : Module.Finite O H := Module.Finite.of_injective H.val.toLinearMap Subtype.val_injective
  -- The residual eigenvalues form a character `χ` of `H`.
  obtain ⟨χ, hχ⟩ := exists_algHom_adjoin_apply_eq T a hf heig
  -- The residual character lifts to a character `ψ` valued in a DVR `V` dominating `O`.
  obtain ⟨L, V, _, j, ψ, hL, hV, hinj, hj, hcompat, hres, hmax, hψ⟩ :=
    χ.exists_valuationSubring_lift K
  have : IsScalarTower O V L := IsScalarTower.of_algebraMap_eq fun x ↦
    (IsScalarTower.algebraMap_apply O K L x).trans (hcompat x).symm
  -- `L` is torsion-free, hence flat, over the DVR `O`.
  have : Module.IsTorsionFree O L := .trans_faithfulSMul O K L
  -- `ψ` occurs on a nonzero integral vector, which is a common eigenvector of the `T i`.
  obtain ⟨n, hn0, hn⟩ := ψ.exists_ne_zero_forall_baseChange_lsmul_apply_eq_smul (L := L) (M := M)
  have hT (i : ι) : Algebra.lsmul O O M (⟨T i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : H) = T i := by
    ext
    simp [Subalgebra.smul_def]
  refine ⟨L, V, _, j, hL, hV, hinj, hj, hcompat, hres, hmax,
    fun i ↦ ψ ⟨T i, Algebra.subset_adjoin ⟨i, rfl⟩⟩, n, hn0, fun i ↦ ⟨?_, by rw [hψ, hχ]⟩⟩
  rw [← hT i]
  exact hn _

end DeligneSerre

end TauCeti
