namespace TauCeti.IsDiscreteValuationRing

section UnramifiedMap

variable {R R' : Type*} [CommRing R] [IsDomain R] [_root_.IsDiscreteValuationRing R]
  [CommRing R'] [IsDomain R'] [_root_.IsDiscreteValuationRing R'] [Algebra R R']

/-- A homomorphism of discrete valuation rings under which `maximalIdeal R` generates
`maximalIdeal R'` is injective. -/
theorem algebraMap_injective_of_map_maximalIdeal_eq
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R') :
    Function.Injective (algebraMap R R') := by
  obtain ⟨ϖ, hϖ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible R
  exact injective_of_map_ne_zero (algebraMap R R') hϖ
    (irreducible_algebraMap_of_map_maximalIdeal_eq hmax hϖ).ne_zero

/-- A homomorphism of discrete valuation rings under which `maximalIdeal R` generates
`maximalIdeal R'` preserves the normalized additive valuation `addVal`. -/
theorem addVal_algebraMap_of_map_maximalIdeal_eq
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R') (a : R) :
    _root_.IsDiscreteValuationRing.addVal R' (algebraMap R R' a) =
      _root_.IsDiscreteValuationRing.addVal R a := by
  rcases eq_or_ne a 0 with rfl | ha
  · simp
  obtain ⟨ϖ, hϖ⟩ := _root_.IsDiscreteValuationRing.exists_irreducible R
  obtain ⟨n, u, rfl⟩ := _root_.IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha hϖ
  have hϖ' := irreducible_algebraMap_of_map_maximalIdeal_eq hmax hϖ
  let u' : R'ˣ := Units.map (algebraMap R R').toMonoidHom u
  have hmap : algebraMap R R' (↑u * ϖ ^ n) = ↑u' * (algebraMap R R' ϖ) ^ n := by simp [u']
  rw [hmap, _root_.IsDiscreteValuationRing.addVal_def' u' hϖ' n,
    _root_.IsDiscreteValuationRing.addVal_def' u hϖ n]

end UnramifiedMap

end TauCeti.IsDiscreteValuationRing

namespace Polynomial.IsEisensteinAt

/-! ### Stability of Eisenstein polynomials along unramified DVR maps -/

section MapDVR

variable {R R' : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [CommRing R'] [IsDomain R'] [IsDiscreteValuationRing R'] [Algebra R R']

/-- If `f : R[X]` is Eisenstein at `maximalIdeal R` and `maximalIdeal R` generates `maximalIdeal R'`
along a homomorphism of discrete valuation rings `R → R'`, then `f.map (algebraMap R R')` is
Eisenstein at `maximalIdeal R'`. -/
theorem map_of_map_maximalIdeal_eq {f : R[X]} (hf : f.IsEisensteinAt (maximalIdeal R))
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R') :
    (f.map (algebraMap R R')).IsEisensteinAt (maximalIdeal R') := by
  have hinj := TauCeti.IsDiscreteValuationRing.algebraMap_injective_of_map_maximalIdeal_eq hmax
  have hdeg : (f.map (algebraMap R R')).natDegree = f.natDegree :=
    natDegree_map_eq_of_injective hinj f
  refine
    { leading := ?_
      mem := fun {n} hn ↦ ?_
      notMem := ?_ }
  · rw [leadingCoeff_map_of_injective hinj, notMem_maximalIdeal]
    exact (notMem_maximalIdeal.mp hf.leading).map (algebraMap R R')
  · rw [coeff_map, ← hmax]
    exact Ideal.mem_map_of_mem _ (hf.mem (hn.trans_eq hdeg))
  · rw [coeff_map, TauCeti.IsDiscreteValuationRing.mem_maximalIdeal_pow_iff_le_addVal,
      TauCeti.IsDiscreteValuationRing.addVal_algebraMap_of_map_maximalIdeal_eq hmax,
      ← TauCeti.IsDiscreteValuationRing.mem_maximalIdeal_pow_iff_le_addVal]
    exact hf.notMem

end MapDVR

/-! ### Power-basis valuation formula and `AdjoinRoot` presentation -/

section PowerBasisValuation

variable {R B : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [CommRing B] [IsDomain B] [Algebra R B] [FaithfulSMul R B] {f : R[X]} {x : B}

/-- In a domain `B` generated over a discrete valuation ring `R` by a root `x` of a monic
Eisenstein polynomial `f`, the additive valuation on `R` scales by `f.natDegree` in `B`.
Note that `IsDiscreteValuationRing B` always holds by `hf.isDiscreteValuationRing_of_adjoin_eq_top`.
-/
theorem addVal_algebraMap [IsDiscreteValuationRing B] (hf : f.IsEisensteinAt (maximalIdeal R))
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤) (a : R) :
    IsDiscreteValuationRing.addVal B (algebraMap R B a) =
      f.natDegree • IsDiscreteValuationRing.addVal R a := by
  have hpos : 0 < f.natDegree := hmo.natDegree_pos.mpr (by rintro rfl; simp at hx)
  rcases eq_or_ne a 0 with rfl | ha
  · simp [hpos.ne']
  have hπ : Irreducible (f.coeff 0) := hf.irreducible_coeff_zero hpos
  have hx_irr : Irreducible x := hf.irreducible_of_adjoin_eq_top hx hadj
  obtain ⟨g, hg0, hg⟩ := hf.exists_pow_natDegree_eq hmo hx
  have hg_unit : IsUnit (aeval x g) := by
    by_contra hnu
    have hmem : aeval x g - 1 ∈ maximalIdeal B := by
      rw [eq_span_singleton_of_isMaximal hf hx hadj (maximalIdeal B), Ideal.mem_span_singleton]
      simpa [hg0] using _root_.map_dvd (aeval x) (X_dvd_sub_C (p := g))
    exact (maximalIdeal.isMaximal B).ne_top <| (Ideal.eq_top_iff_one _).mpr <| by
      simpa using (maximalIdeal B).sub_mem ((mem_maximalIdeal _).mpr hnu) hmem
  have hval_π : IsDiscreteValuationRing.addVal B (algebraMap R B (f.coeff 0)) = f.natDegree := by
    have hpow : IsDiscreteValuationRing.addVal B (x ^ f.natDegree) = f.natDegree := by
      rw [IsDiscreteValuationRing.addVal_pow, IsDiscreteValuationRing.addVal_uniformizer hx_irr,
        nsmul_one]
    rw [hg, (IsDiscreteValuationRing.addVal B).map_neg, IsDiscreteValuationRing.addVal_mul,
      IsDiscreteValuationRing.addVal_eq_zero_iff.mpr hg_unit, add_zero] at hpow
    exact hpow
  obtain ⟨n, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha hπ
  rw [(algebraMap R B).map_mul, (algebraMap R B).map_pow, IsDiscreteValuationRing.addVal_mul,
    IsDiscreteValuationRing.addVal_eq_zero_iff.mpr (u.isUnit.map (algebraMap R B)),
    zero_add, IsDiscreteValuationRing.addVal_pow, hval_π,
    IsDiscreteValuationRing.addVal_def' u hπ n, nsmul_eq_mul, nsmul_eq_mul]
  exact_mod_cast Nat.mul_comm n f.natDegree

/-- **Power-basis valuation formula.** If `B` is generated over a discrete valuation ring `R` by a
root `x` of a monic Eisenstein polynomial `f`, then for every `p : R[X]` with
`p.natDegree < f.natDegree`, the valuation of `aeval x p` is the minimum of
`f.natDegree • addVal R (p.coeff i) + i` over `i : Fin f.natDegree`. -/
theorem addVal_aeval_of_natDegree_lt [IsDiscreteValuationRing B]
    (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤) {p : R[X]}
    (hp : p.natDegree < f.natDegree) :
    IsDiscreteValuationRing.addVal B (aeval x p) =
      ⨅ i : Fin f.natDegree,
        (f.natDegree • IsDiscreteValuationRing.addVal R (p.coeff i) + (i : ℕ)) := by
  classical
  have hx_irr : Irreducible x := hf.irreducible_of_adjoin_eq_top hx hadj
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hexp : aeval x p =
      ∑ i : Fin f.natDegree, algebraMap R B (p.coeff i) * x ^ (i : ℕ) := by
    rw [aeval_eq_sum_range' hp]
    simp only [← Fin.sum_univ_eq_sum_range, Algebra.smul_def]
  have hterm (i : Fin f.natDegree) :
      IsDiscreteValuationRing.addVal B (algebraMap R B (p.coeff i) * x ^ (i : ℕ)) =
        f.natDegree • IsDiscreteValuationRing.addVal R (p.coeff i) + (i : ℕ) := by
    rw [IsDiscreteValuationRing.addVal_mul, hf.addVal_algebraMap hmo hx hadj,
      IsDiscreteValuationRing.addVal_pow, IsDiscreteValuationRing.addVal_uniformizer hx_irr,
      nsmul_one]
  have hdistinct : ∀ i ∈ (Finset.univ : Finset (Fin f.natDegree)),
      ∀ j ∈ (Finset.univ : Finset (Fin f.natDegree)), i ≠ j →
      IsDiscreteValuationRing.addVal B (algebraMap R B (p.coeff i) * x ^ (i : ℕ)) ≠ ⊤ →
      IsDiscreteValuationRing.addVal B (algebraMap R B (p.coeff j) * x ^ (j : ℕ)) ≠ ⊤ →
      IsDiscreteValuationRing.addVal B (algebraMap R B (p.coeff i) * x ^ (i : ℕ)) ≠
        IsDiscreteValuationRing.addVal B (algebraMap R B (p.coeff j) * x ^ (j : ℕ)) := by
    intro i _ j _ hij hi0 hj0 hval
    have hci : p.coeff i ≠ 0 := fun h ↦ hi0 (by simp [h])
    have hcj : p.coeff j ≠ 0 := fun h ↦ hj0 (by simp [h])
    obtain ⟨ni, ui, hci'⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hci hϖ
    obtain ⟨nj, uj, hcj'⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hcj hϖ
    rw [hterm i, hterm j, hci', hcj', IsDiscreteValuationRing.addVal_def' ui hϖ ni,
      IsDiscreteValuationRing.addVal_def' uj hϖ nj] at hval
    have hnat : f.natDegree * ni + (i : ℕ) = f.natDegree * nj + (j : ℕ) := by
      have hval' : ((f.natDegree * ni + (i : ℕ) : ℕ) : ℕ∞) =
          f.natDegree * nj + (j : ℕ) := by simpa [nsmul_eq_mul] using hval
      exact_mod_cast hval'
    have hmod := congrArg (· % f.natDegree) hnat
    exact hij (Fin.ext (by
      simpa [Nat.add_mod, Nat.mod_eq_of_lt i.isLt, Nat.mod_eq_of_lt j.isLt] using hmod))
  rw [hexp, (IsDiscreteValuationRing.addVal B).map_sum_eq_inf_of_ne Finset.univ _ hdistinct,
    Finset.inf_univ_eq_iInf]
  exact iInf_congr hterm

/-- Over a discrete valuation ring `R`, the kernel of `aeval x : R[X] →ₐ[R] B` at a root `x` of a
monic Eisenstein polynomial `f` generating `B` is `Ideal.span {f}`. -/
theorem ker_aeval_eq_span (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤) :
    RingHom.ker (aeval x : R[X] →ₐ[R] B) = Ideal.span {f} := by
  have := hf.isDiscreteValuationRing_of_adjoin_eq_top hx hadj
  have hpos : 0 < f.natDegree := hmo.natDegree_pos.mpr (by rintro rfl; simp at hx)
  ext p
  rw [RingHom.mem_ker, Ideal.mem_span_singleton, ← modByMonic_eq_zero_iff_dvd hmo]
  refine ⟨fun hp0 ↦ ?_, fun hmod ↦ ?_⟩
  · set r := p %ₘ f
    have hr_deg : r.natDegree < f.natDegree := by
      rcases eq_or_ne r 0 with hr0 | hr0
      · simp [hr0, hpos]
      · exact natDegree_lt_natDegree hr0 (degree_modByMonic_lt p hmo)
    have hr_eval : aeval x r = 0 := by
      have := congrArg (aeval x) (modByMonic_add_div p f)
      simpa [r, hx, hp0] using this
    have hval := hf.addVal_aeval_of_natDegree_lt hmo hx hadj hr_deg
    rw [hr_eval, IsDiscreteValuationRing.addVal_zero] at hval
    ext i
    rw [coeff_zero]
    by_cases hi : i < f.natDegree
    · have htop : f.natDegree • IsDiscreteValuationRing.addVal R (r.coeff i) + (i : ℕ) = ⊤ :=
        top_unique (hval ▸ iInf_le _ (⟨i, hi⟩ : Fin f.natDegree))
      by_contra hci
      obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
      obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hci hϖ
      rw [hu, IsDiscreteValuationRing.addVal_def' u hϖ n] at htop
      exact ENat.natCast_ne_top (f.natDegree * n + i) (by simpa [nsmul_eq_mul] using htop)
    · exact coeff_eq_zero_of_natDegree_lt (hr_deg.trans_le (Nat.le_of_not_gt hi))
  · rw [← modByMonic_add_div p f, hmod, zero_add, map_mul, hx, zero_mul]

/-- Canonical `R`-algebra isomorphism `AdjoinRoot f ≃ₐ[R] B` sending `AdjoinRoot.root f` to `x`. -/
def adjoinRootAlgEquiv (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤) :
    AdjoinRoot f ≃ₐ[R] B :=
  have hsurj : Function.Surjective (aeval x : R[X] →ₐ[R] B) := fun b ↦ by
    have hb : b ∈ Algebra.adjoin R {x} := hadj ▸ Algebra.mem_top
    rwa [Algebra.adjoin_singleton_eq_range_aeval] at hb
  (Ideal.quotientEquivAlgOfEq R (hf.ker_aeval_eq_span hmo hx hadj).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective hsurj)

/-- `adjoinRootAlgEquiv` evaluates `AdjoinRoot.mk f p` to `aeval x p`. -/
@[simp]
theorem adjoinRootAlgEquiv_apply_mk (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤) (p : R[X]) :
    hf.adjoinRootAlgEquiv hmo hx hadj (AdjoinRoot.mk f p) = aeval x p :=
  (rfl)

/-- `adjoinRootAlgEquiv` sends `AdjoinRoot.root f` to `x`. -/
@[simp]
theorem adjoinRootAlgEquiv_apply_root (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤) :
    hf.adjoinRootAlgEquiv hmo hx hadj (AdjoinRoot.root f) = x := by
  change aeval x X = x
  exact aeval_X x

end PowerBasisValuation

/-! ### Ring-level base change and preservation of lower ramification -/

section RingBaseChange

variable {R R' B B' : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [CommRing R'] [Algebra R R']
  [CommRing B] [IsDomain B] [Algebra R B] [FaithfulSMul R B]
  [CommRing B'] [Algebra R' B'] [Algebra R B'] [IsScalarTower R R' B']
  {f : R[X]} {x : B} {x' : B'}

/-- Canonical `R`-algebra homomorphism `B →ₐ[R] B'` sending the Eisenstein generator `x` to `x'`. -/
def baseChangeAlgHom (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hx' : aeval x' (f.map (algebraMap R R')) = 0) :
    B →ₐ[R] B' :=
  have hx'_R : f.eval₂ (Algebra.ofId R B') x' = 0 := by
    rw [Algebra.toRingHom_ofId, IsScalarTower.algebraMap_eq R R' B', ← eval₂_map, ← aeval_def, hx']
  (AdjoinRoot.liftAlgHom f (Algebra.ofId R B') x' hx'_R).comp
    (hf.adjoinRootAlgEquiv hmo hx hadj).symm.toAlgHom

/-- `baseChangeAlgHom` maps `aeval x p` to `aeval x' (p.map (algebraMap R R'))`. -/
theorem baseChangeAlgHom_aeval (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hx' : aeval x' (f.map (algebraMap R R')) = 0) (p : R[X]) :
    hf.baseChangeAlgHom hmo hx hadj hx' (aeval x p) =
      aeval x' (p.map (algebraMap R R')) := by
  have hm : (hf.adjoinRootAlgEquiv hmo hx hadj).symm (aeval x p) = AdjoinRoot.mk f p :=
    (hf.adjoinRootAlgEquiv hmo hx hadj).injective (by simp)
  dsimp only [baseChangeAlgHom, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
  rw [hm, AdjoinRoot.liftAlgHom_mk, Algebra.toRingHom_ofId,
    IsScalarTower.algebraMap_eq R R' B', ← eval₂_map, aeval_def]

/-- `baseChangeAlgHom` sends the Eisenstein generator `x` to `x'`. -/
@[simp]
theorem baseChangeAlgHom_apply_gen (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hx' : aeval x' (f.map (algebraMap R R')) = 0) :
    hf.baseChangeAlgHom hmo hx hadj hx' x = x' := by
  simpa using hf.baseChangeAlgHom_aeval hmo hx hadj hx' X

variable [IsDomain R'] [IsDiscreteValuationRing R'] [IsDomain B'] [FaithfulSMul R' B']

/-- Under an unramified map of discrete valuation rings `R → R'`, evaluating any `p : R[X]` at `x`
in `B` has the same normalized valuation as evaluating `p.map (algebraMap R R')` at `x'` in `B'`. -/
theorem addVal_aeval_map_eq [IsDiscreteValuationRing B] [IsDiscreteValuationRing B']
    (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hx' : aeval x' (f.map (algebraMap R R')) = 0) (hadj' : Algebra.adjoin R' {x'} = ⊤)
    (p : R[X]) :
    IsDiscreteValuationRing.addVal B' (aeval x' (p.map (algebraMap R R'))) =
      IsDiscreteValuationRing.addVal B (aeval x p) := by
  have hf' := hf.map_of_map_maximalIdeal_eq hmax
  have hmo' : (f.map (algebraMap R R')).Monic := hmo.map (algebraMap R R')
  have hpos : 0 < f.natDegree := hmo.natDegree_pos.mpr (by rintro rfl; simp at hx)
  have hdeg_f' : (f.map (algebraMap R R')).natDegree = f.natDegree := hmo.natDegree_map _
  set r := p %ₘ f
  have hr_deg : r.natDegree < f.natDegree := by
    rcases eq_or_ne r 0 with hr0 | hr0
    · simp [hr0, hpos]
    · exact natDegree_lt_natDegree hr0 (degree_modByMonic_lt p hmo)
  have hr'_deg : (r.map (algebraMap R R')).natDegree < (f.map (algebraMap R R')).natDegree :=
    natDegree_map_le.trans_lt (hr_deg.trans_eq hdeg_f'.symm)
  have hp_eq : aeval x p = aeval x r := by
    conv_lhs => rw [← modByMonic_add_div p f]
    simp [r, hx]
  have hp'_eq : aeval x' (p.map (algebraMap R R')) = aeval x' (r.map (algebraMap R R')) := by
    conv_lhs => rw [← modByMonic_add_div p f]
    simp [Polynomial.map_add, Polynomial.map_mul, r, hx']
  rw [hp_eq, hp'_eq, hf'.addVal_aeval_of_natDegree_lt hmo' hx' hadj' hr'_deg,
    hf.addVal_aeval_of_natDegree_lt hmo hx hadj hr_deg]
  let eFin : Fin (f.map (algebraMap R R')).natDegree ≃ Fin f.natDegree := finCongr hdeg_f'
  rw [← eFin.iInf_comp]
  refine iInf_congr fun i ↦ ?_
  simp only [eFin, finCongr_apply, Fin.val_cast, hdeg_f', coeff_map,
    TauCeti.IsDiscreteValuationRing.addVal_algebraMap_of_map_maximalIdeal_eq hmax]

/-- `baseChangeAlgHom` preserves the normalized additive valuation of every element of `B`. -/
theorem addVal_baseChangeAlgHom [IsDiscreteValuationRing B] [IsDiscreteValuationRing B']
    (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hx' : aeval x' (f.map (algebraMap R R')) = 0) (hadj' : Algebra.adjoin R' {x'} = ⊤) (b : B) :
    IsDiscreteValuationRing.addVal B' (hf.baseChangeAlgHom hmo hx hadj hx' b) =
      IsDiscreteValuationRing.addVal B b := by
  have hb : b ∈ Algebra.adjoin R {x} := hadj ▸ Algebra.mem_top
  rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range] at hb
  obtain ⟨p, rfl⟩ := hb
  rw [hf.baseChangeAlgHom_aeval hmo hx hadj hx']
  exact hf.addVal_aeval_map_eq hmo hx hadj hmax hx' hadj' p

/-- `baseChangeAlgHom` is injective. -/
theorem baseChangeAlgHom_injective (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hx' : aeval x' (f.map (algebraMap R R')) = 0) (hadj' : Algebra.adjoin R' {x'} = ⊤) :
    Function.Injective (hf.baseChangeAlgHom hmo hx hadj hx') := by
  have := hf.isDiscreteValuationRing_of_adjoin_eq_top hx hadj
  have := (hf.map_of_map_maximalIdeal_eq hmax).isDiscreteValuationRing_of_adjoin_eq_top hx' hadj'
  refine (injective_iff_map_eq_zero _).mpr fun b hb ↦ ?_
  rw [← IsDiscreteValuationRing.addVal_eq_top_iff,
    ← hf.addVal_baseChangeAlgHom hmo hx hadj hmax hx' hadj', hb,
    IsDiscreteValuationRing.addVal_zero]

section Equivariant

variable {H H' : Type*} [Group H] [Group H']
  [MulSemiringAction H B] [MulSemiringAction H' B']

/-- Normalized displacement valuation `addVal (σ • x - x)` is preserved along any group action map
intertwining `x` and `x'` via `baseChangeAlgHom`. -/
theorem addVal_smul_sub_eq [IsDiscreteValuationRing B] [IsDiscreteValuationRing B']
    (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hx' : aeval x' (f.map (algebraMap R R')) = 0) (hadj' : Algebra.adjoin R' {x'} = ⊤)
    {σ : H} {σ' : H'} (hσσ' : σ' • x' = hf.baseChangeAlgHom hmo hx hadj hx' (σ • x)) :
    IsDiscreteValuationRing.addVal B' (σ' • x' - x') =
      IsDiscreteValuationRing.addVal B (σ • x - x) := by
  have hsub : σ' • x' - x' = hf.baseChangeAlgHom hmo hx hadj hx' (σ • x - x) := by
    rw [map_sub, hσσ', hf.baseChangeAlgHom_apply_gen]
  rw [hsub]
  exact hf.addVal_baseChangeAlgHom hmo hx hadj hmax hx' hadj' (σ • x - x)

variable [SMulCommClass H R B] [SMulCommClass H' R' B']

/-- Serre's lower index `TauCeti.IsLocalRing.lowerIndex` is preserved under Eisenstein base change.
-/
theorem lowerIndex_eq [IsDiscreteValuationRing B] [IsDiscreteValuationRing B']
    (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hx' : aeval x' (f.map (algebraMap R R')) = 0) (hadj' : Algebra.adjoin R' {x'} = ⊤)
    {σ : H} {σ' : H'} (hσσ' : σ' • x' = hf.baseChangeAlgHom hmo hx hadj hx' (σ • x)) :
    TauCeti.IsLocalRing.lowerIndex B' σ' = TauCeti.IsLocalRing.lowerIndex B σ := by
  rw [TauCeti.IsLocalRing.lowerIndex_eq_addVal_of_adjoin_singleton_eq_top hadj',
    TauCeti.IsLocalRing.lowerIndex_eq_addVal_of_adjoin_singleton_eq_top hadj]
  exact hf.addVal_smul_sub_eq hmo hx hadj hmax hx' hadj' hσσ'

/-- Under an equivariant homomorphism `ρ : H →* H'` on the Eisenstein generator, the lower
ramification groups pull back to the lower ramification groups of `B`. -/
theorem comap_ramificationGroup [IsLocalRing B] [IsLocalRing B']
    (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hx' : aeval x' (f.map (algebraMap R R')) = 0) (hadj' : Algebra.adjoin R' {x'} = ⊤)
    (ρ : H →* H') (hρ : ∀ σ, ρ σ • x' = hf.baseChangeAlgHom hmo hx hadj hx' (σ • x)) (i : ℤ) :
    (TauCeti.IsLocalRing.ramificationGroup H' B' i).comap ρ =
      TauCeti.IsLocalRing.ramificationGroup H B i := by
  have := hf.isDiscreteValuationRing_of_adjoin_eq_top hx hadj
  have := (hf.map_of_map_maximalIdeal_eq hmax).isDiscreteValuationRing_of_adjoin_eq_top hx' hadj'
  ext σ
  rw [Subgroup.mem_comap, TauCeti.IsLocalRing.mem_ramificationGroup_iff_le_lowerIndex,
    TauCeti.IsLocalRing.mem_ramificationGroup_iff_le_lowerIndex,
    hf.lowerIndex_eq hmo hx hadj hmax hx' hadj' (hρ σ)]

/-- Real-indexed counterpart of `Polynomial.IsEisensteinAt.comap_ramificationGroup`. -/
theorem comap_ramificationGroupReal [IsLocalRing B] [IsLocalRing B']
    (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hx' : aeval x' (f.map (algebraMap R R')) = 0) (hadj' : Algebra.adjoin R' {x'} = ⊤)
    (ρ : H →* H') (hρ : ∀ σ, ρ σ • x' = hf.baseChangeAlgHom hmo hx hadj hx' (σ • x)) (u : ℝ) :
    (TauCeti.IsLocalRing.ramificationGroupReal H' B' u).comap ρ =
      TauCeti.IsLocalRing.ramificationGroupReal H B u := by
  rw [TauCeti.IsLocalRing.ramificationGroupReal_def,
    TauCeti.IsLocalRing.ramificationGroupReal_def]
  exact hf.comap_ramificationGroup hmo hx hadj hmax hx' hadj' ρ hρ ⌈u⌉

end Equivariant

end RingBaseChange

/-! ### Field and integral-closure properties of Eisenstein extensions -/

section SingleExtension

variable {R K E : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [Field K] [Algebra R K] [IsFractionRing R K]
  [Field E] [Algebra K E] [Algebra R E] [IsScalarTower R K E]
  {f : R[X]} {α : E}

/-- If `f : R[X]` is monic of positive degree and Eisenstein at `maximalIdeal R`, then
`f.map (algebraMap R K)` is irreducible over `K = Frac R`. -/
theorem irreducible_map_fractionRing (K : Type*) [Field K] [Algebra R K] [IsFractionRing R K]
    (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic) (hdeg : 0 < f.natDegree) :
    Irreducible (f.map (algebraMap R K)) :=
  (hmo.irreducible_iff_irreducible_map_fraction_map (K := K)).mp
    (hf.irreducible inferInstance hmo.isPrimitive hdeg)

/-- If `E = K⟮α⟯` is generated over `K = Frac R` by a root `α` of a monic Eisenstein polynomial
`f : R[X]`, then `[E : K] = f.natDegree`. -/
theorem finrank_eq_natDegree (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hα : aeval α f = 0) (hgen : K⟮α⟯ = ⊤) :
    Module.finrank K E = f.natDegree := by
  have := FaithfulSMul.trans R K E
  have hdeg : 0 < f.natDegree := hmo.natDegree_pos.mpr (by rintro rfl; simp at hα)
  have hirr : Irreducible (f.map (algebraMap R K)) := hf.irreducible_map_fractionRing K hmo hdeg
  have hroot : aeval α (f.map (algebraMap R K)) = 0 := by rwa [aeval_map_algebraMap]
  have hmin : f.map (algebraMap R K) = minpoly K α :=
    minpoly.eq_of_irreducible_of_monic hirr hroot (hmo.map _)
  have hint : IsIntegral K α := (show IsIntegral R α from ⟨f, hmo, hα⟩).tower_top
  rw [← IntermediateField.finrank_top', ← hgen, IntermediateField.adjoin.finrank hint, ← hmin,
    hmo.natDegree_map]

/-- If `E = K⟮α⟯` is generated over `K = Frac R` by a root `α` of a monic Eisenstein polynomial
`f : R[X]`, then the integral closure of `R` in `E` is `R[α]`. -/
theorem integralClosure_eq_adjoin (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hα : aeval α f = 0) (hgen : K⟮α⟯ = ⊤) :
    integralClosure R E = Algebra.adjoin R {α} := by
  have := FaithfulSMul.trans R K E
  have hint : IsIntegral R α := ⟨f, hmo, hα⟩
  set S : Subalgebra R E := Algebra.adjoin R {α}
  let αS : S := ⟨α, Algebra.self_mem_adjoin_singleton R α⟩
  have hxS : aeval αS f = 0 := Subtype.ext ((aeval_subalgebra_coe f S αS).trans hα)
  have hadjS : Algebra.adjoin R {αS} = ⊤ := by
    apply Subalgebra.map_injective (f := S.val) Subtype.val_injective
    rw [AlgHom.map_adjoin, Set.image_singleton, Algebra.map_top, Subalgebra.range_val]
    rfl
  have := hf.isDiscreteValuationRing_of_adjoin_eq_top hxS hadjS
  have : Algebra.IsIntegral R S :=
    have := Algebra.finite_adjoin_simple_of_isIntegral hint
    inferInstance
  have : IsFractionRing S E :=
    TauCeti.IntermediateField.isFractionRing_algebra_adjoin_of_adjoin_eq_top hgen
  refine le_antisymm (fun z hz ↦ ?_) (Algebra.adjoin_le (Set.singleton_subset_iff.mpr hint))
  obtain ⟨y, rfl⟩ := (IsIntegralClosure.isIntegral_iff (A := S)).mp hz
  exact y.2

/-- In the situation of `integralClosure_eq_adjoin`, the root `α` viewed in `integralClosure R E`
generates `integralClosure R E` as an `R`-algebra. -/
theorem adjoin_integralClosure_eq_top (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hα : aeval α f = 0) (hgen : K⟮α⟯ = ⊤) :
    Algebra.adjoin R {(⟨α, ⟨f, hmo, hα⟩⟩ : integralClosure R E)} = ⊤ := by
  apply Subalgebra.map_injective (f := (integralClosure R E).val) Subtype.val_injective
  rw [AlgHom.map_adjoin, Set.image_singleton, Algebra.map_top, Subalgebra.range_val]
  exact (hf.integralClosure_eq_adjoin hmo hα hgen).symm

/-- In the situation of `integralClosure_eq_adjoin`, `integralClosure R E` is a discrete valuation
ring. -/
theorem isDiscreteValuationRing_integralClosure (hf : f.IsEisensteinAt (maximalIdeal R))
    (hmo : f.Monic) (hα : aeval α f = 0) (hgen : K⟮α⟯ = ⊤) :
    IsDiscreteValuationRing (integralClosure R E) := by
  have : FaithfulSMul R E := FaithfulSMul.trans R K E
  have : FaithfulSMul R (integralClosure R E) :=
    FaithfulSMul.tower_bot R (integralClosure R E) E
  exact hf.isDiscreteValuationRing_of_adjoin_eq_top
    (Subtype.ext ((aeval_subalgebra_coe f (integralClosure R E)
      ⟨α, (mem_integralClosure_iff R E).mpr ⟨f, hmo, hα⟩⟩).trans hα))
    (hf.adjoin_integralClosure_eq_top hmo hα hgen)

end SingleExtension

section BaseExtension

variable {R E : Type*} [CommRing R] [IsDomain R] [Field E] [Algebra R E]

/-- If `E / K` is finite and `integralClosure R E` is generated over `R` by a single element `x`,
then any `K`-automorphism fixing `x` is the identity. -/
private theorem algEquiv_eq_one_of_smul_eq_self (K : Type*) [Field K] [Algebra R K]
    [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E] [FiniteDimensional K E]
    {x : integralClosure R E} (hadj : Algebra.adjoin R {x} = ⊤)
    {σ : E ≃ₐ[K] E} (hσ : σ • x = x) : σ = 1 := by
  have : IsFractionRing (integralClosure R E) E :=
    integralClosure.isFractionRing_of_finite_extension K E
  have hgenE : K⟮(x : E)⟯ = ⊤ := by
    simpa only [Subalgebra.algebraMap_apply] using
      TauCeti.IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top
        (R := R) (S := integralClosure R E) (K := K) (L := E) hadj
  refine TauCeti.IntermediateField.algEquiv_eq_one_of_adjoin_eq_top hgenE fun y hy ↦ ?_
  rw [Set.mem_singleton_iff.mp hy]
  exact congrArg Subtype.val hσ

variable [IsDiscreteValuationRing R]

/-- If `E / K` is finite with `integralClosure R E = R[x]` for an Eisenstein root `x` of `f`, then
`[E : K] = f.natDegree`. -/
theorem finrank_base_eq_natDegree {f : R[X]} (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    [FiniteDimensional K E] {x : integralClosure R E} (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤) :
    Module.finrank K E = f.natDegree := by
  have : IsFractionRing (integralClosure R E) E :=
    integralClosure.isFractionRing_of_finite_extension K E
  have hgenE : K⟮(x : E)⟯ = ⊤ := by
    simpa only [Subalgebra.algebraMap_apply] using
      TauCeti.IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top
        (R := R) (S := integralClosure R E) (K := K) (L := E) hadj
  have hxE : aeval (x : E) f = 0 := by
    rw [← aeval_subalgebra_coe f (integralClosure R E) x, hx, ZeroMemClass.coe_zero]
  exact hf.finrank_eq_natDegree hmo hxE hgenE

end BaseExtension

/-! ### `AdjoinRoot` helpers for base-changed polynomials -/

section AdjoinRootHelpers

/-- Over a field `K'`, the canonical root of an irreducible polynomial `g : K'[X]` generates
`AdjoinRoot g` as an intermediate field over `K'`. -/
theorem _root_.AdjoinRoot.adjoin_root_eq_top {K' : Type*} [Field K'] {g : K'[X]}
    [Fact (Irreducible g)] :
    K'⟮AdjoinRoot.root g⟯ = ⊤ :=
  IntermediateField.adjoin_eq_top_of_algebra K' {AdjoinRoot.root g} AdjoinRoot.adjoinRoot_eq_top

/-- In a scalar tower `R → R' → K'`, the canonical root of `f.map (algebraMap R K')` in
`AdjoinRoot (f.map (algebraMap R K'))` is a root of `f.map (algebraMap R R')`. -/
theorem _root_.AdjoinRoot.aeval_root_map_eq_zero {R R' K' : Type*} [CommRing R] [CommRing R']
    [CommRing K'] [Algebra R R'] [Algebra R' K'] [Algebra R K'] [IsScalarTower R R' K']
    (f : R[X]) :
    aeval (AdjoinRoot.root (f.map (algebraMap R K'))) (f.map (algebraMap R R')) = 0 := by
  rw [← aeval_map_algebraMap K', Polynomial.map_map, ← IsScalarTower.algebraMap_eq R R' K',
    AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]

end AdjoinRootHelpers

/-! ### Field and Galois base change along unramified DVR homomorphisms -/

section FieldBaseChange

variable {R R' K' : Type*}
  [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [CommRing R'] [IsDomain R'] [IsDiscreteValuationRing R'] [Field K'] [Algebra R' K']
  [IsFractionRing R' K'] [Algebra R R']

section Extension

variable {E' : Type*} [Field E'] [Algebra K' E'] [Algebra R' E'] [IsScalarTower R' K' E']
  {f : R[X]} {α : E'}

/-- If `E' = K'⟮α⟯` is generated over `K' = Frac R'` by a root `α` of `f.map (algebraMap R R')` for
a monic Eisenstein polynomial `f : R[X]`, then `[E' : K'] = f.natDegree`. -/
theorem finrank_eq_natDegree_of_map_maximalIdeal_eq (hf : f.IsEisensteinAt (maximalIdeal R))
    (hmo : f.Monic) (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) :
    Module.finrank K' E' = f.natDegree :=
  ((hf.map_of_map_maximalIdeal_eq hmax).finrank_eq_natDegree (hmo.map _) hα hgen).trans
    (hmo.natDegree_map _)

/-- If `E' = K'⟮α⟯` is generated over `K' = Frac R'` by a root `α` of `f.map (algebraMap R R')`,
then the integral closure of `R'` in `E'` is `R'[α]`. -/
theorem integralClosure_eq_adjoin_of_map_maximalIdeal_eq (hf : f.IsEisensteinAt (maximalIdeal R))
    (hmo : f.Monic) (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) :
    integralClosure R' E' = Algebra.adjoin R' {α} :=
  (hf.map_of_map_maximalIdeal_eq hmax).integralClosure_eq_adjoin (hmo.map _) hα hgen

/-- In the situation of `integralClosure_eq_adjoin_of_map_maximalIdeal_eq`, the root `α` viewed in
`integralClosure R' E'` generates `integralClosure R' E'` as an `R'`-algebra. -/
theorem adjoin_integralClosure_eq_top_of_map_maximalIdeal_eq
    (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) :
    Algebra.adjoin R'
      {(⟨α, (mem_integralClosure_iff R' E').mpr ⟨_, hmo.map _, hα⟩⟩ : integralClosure R' E')} = ⊤ :=
  (hf.map_of_map_maximalIdeal_eq hmax).adjoin_integralClosure_eq_top (hmo.map _) hα hgen

/-- In the situation of `integralClosure_eq_adjoin_of_map_maximalIdeal_eq`,
`integralClosure R' E'` is a discrete valuation ring. -/
theorem isDiscreteValuationRing_integralClosure_of_map_maximalIdeal_eq
    (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) :
    IsDiscreteValuationRing (integralClosure R' E') :=
  (hf.map_of_map_maximalIdeal_eq hmax).isDiscreteValuationRing_integralClosure (hmo.map _) hα hgen

end Extension

variable [Algebra R K'] [IsScalarTower R R' K']

/-- If `f : R[X]` is monic of positive degree and Eisenstein at `maximalIdeal R`, and
`maximalIdeal R` generates `maximalIdeal R'` along `R → R'`, then `f.map (algebraMap R K')` is
irreducible over `K'`. -/
theorem irreducible_map_fractionRing_of_map_maximalIdeal_eq {f : R[X]}
    (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic) (hdeg : 0 < f.natDegree)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R') :
    Irreducible (f.map (algebraMap R K')) := by
  have hdeg' : 0 < (f.map (algebraMap R R')).natDegree := by rwa [hmo.natDegree_map]
  rw [IsScalarTower.algebraMap_eq R R' K', ← Polynomial.map_map]
  exact (hf.map_of_map_maximalIdeal_eq hmax).irreducible_map_fractionRing K' (hmo.map _) hdeg'

/-! ### Galois group isomorphism and preservation of the ramification filtration -/

section Galois

variable {E E' : Type*}
  [Field E] [Algebra R E]
  [Field E'] [Algebra K' E'] [Algebra R' E'] [IsScalarTower R' K' E']
  {f : R[X]} {x : integralClosure R E} {α : E'}

/-- Canonical `K'`-algebra isomorphism `AdjoinRoot (f.map (algebraMap R K')) ≃ₐ[K'] E'` sending
`AdjoinRoot.root _` to `α`. -/
private def adjoinRootFieldEquiv (hf : f.IsEisensteinAt (maximalIdeal R)) (hmo : f.Monic)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) :
    AdjoinRoot (f.map (algebraMap R K')) ≃ₐ[K'] E' :=
  have := FaithfulSMul.trans R' K' E'
  have hdeg : 0 < f.natDegree := hmo.natDegree_pos.mpr (by rintro rfl; simp at hα)
  let g := f.map (algebraMap R K')
  let _ : Fact (Irreducible g) :=
    ⟨hf.irreducible_map_fractionRing_of_map_maximalIdeal_eq hmo hdeg hmax⟩
  have hroot : g.eval₂ (Algebra.ofId K' E') α = 0 := by
    rw [Algebra.toRingHom_ofId, ← aeval_def]
    dsimp only [g]
    rw [IsScalarTower.algebraMap_eq R R' K', ← Polynomial.map_map, aeval_map_algebraMap, hα]
  let φ : AdjoinRoot g →ₐ[K'] E' := AdjoinRoot.liftAlgHom g (Algebra.ofId K' E') α hroot
  AlgEquiv.ofBijective φ ⟨RingHom.injective φ.toRingHom, by
    rw [← AlgHom.fieldRange_eq_top]
    refine top_unique (hgen ▸ IntermediateField.adjoin_le_iff.mpr ?_)
    exact Set.singleton_subset_iff.mpr
      ⟨AdjoinRoot.root g, AdjoinRoot.liftAlgHom_root g (Algebra.ofId K' E') α hroot⟩⟩

private theorem adjoinRootFieldEquiv_apply_root (hf : f.IsEisensteinAt (maximalIdeal R))
    (hmo : f.Monic) (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) :
    hf.adjoinRootFieldEquiv hmo hmax hα hgen (AdjoinRoot.root (f.map (algebraMap R K'))) = α :=
  AdjoinRoot.liftAlgHom_root (f.map (algebraMap R K')) (Algebra.ofId K' E') α (by
    rw [Algebra.toRingHom_ofId, ← aeval_def, IsScalarTower.algebraMap_eq R R' K',
      ← Polynomial.map_map, aeval_map_algebraMap, hα])

variable [Algebra R E'] [IsScalarTower R R' E']

/-- Given any `σ : E ≃ₐ[K] E`, the image of `σ • x` under `baseChangeAlgHom` defines a unique
`K'`-automorphism of `E'` sending `α` to `(baseChangeAlgHom ... (σ • x) : E')`. -/
private def galHomAux (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤)
    (σ : E ≃ₐ[K] E) : E' ≃ₐ[K'] E' :=
  have : FaithfulSMul R E := FaithfulSMul.trans R K E
  have : FaithfulSMul R (integralClosure R E) :=
    FaithfulSMul.tower_bot R (integralClosure R E) E
  have : FaithfulSMul R' E' := FaithfulSMul.trans R' K' E'
  let x' : integralClosure R' E' := ⟨α, (mem_integralClosure_iff R' E').mpr ⟨_, hmo.map _, hα⟩⟩
  have hx' : aeval x' (f.map (algebraMap R R')) = 0 :=
    Subtype.ext ((aeval_subalgebra_coe (f.map (algebraMap R R')) (integralClosure R' E') x').trans
      hα)
  let j := hf.baseChangeAlgHom hmo hx hadj hx'
  let jE : integralClosure R E →ₐ[R] E' :=
    (IsScalarTower.toAlgHom R (integralClosure R' E') E').comp j
  have hdeg : 0 < f.natDegree := hmo.natDegree_pos.mpr (by rintro rfl; simp at hα)
  let g := f.map (algebraMap R K')
  let _ : Fact (Irreducible g) :=
    ⟨hf.irreducible_map_fractionRing_of_map_maximalIdeal_eq hmo hdeg hmax⟩
  have hj_root : g.eval₂ (Algebra.ofId K' E') (j (σ • x) : E') = 0 := by
    have hact : aeval (σ • x) f = σ • aeval x f :=
      aeval_algHom_apply (MulSemiringAction.toAlgHom R (integralClosure R E) σ) x f
    have hjf : aeval (jE (σ • x)) f = 0 := by
      rw [aeval_algHom_apply jE (σ • x) f, hact, hx, smul_zero, map_zero]
    rw [Algebra.toRingHom_ofId, ← aeval_def]
    dsimp only [g]
    rw [IsScalarTower.algebraMap_eq R R' K', ← Polynomial.map_map, aeval_map_algebraMap K',
      aeval_map_algebraMap R']
    exact hjf
  let eAdj := hf.adjoinRootFieldEquiv hmo hmax hα hgen
  let ψ : E' →ₐ[K'] E' :=
    (AdjoinRoot.liftAlgHom g (Algebra.ofId K' E') (j (σ • x) : E') hj_root).comp
      eAdj.symm.toAlgHom
  have : FiniteDimensional K' E' :=
    Module.finite_of_finrank_pos
      ((hf.finrank_eq_natDegree_of_map_maximalIdeal_eq hmo hmax hα hgen).symm ▸ hdeg)
  have hψ_inj : Function.Injective ψ.toLinearMap := RingHom.injective ψ.toRingHom
  AlgEquiv.ofBijective ψ ⟨hψ_inj, LinearMap.injective_iff_surjective.mp hψ_inj⟩

private theorem galHomAux_apply_gen (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    [FaithfulSMul R (integralClosure R E)]
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤)
    (σ : E ≃ₐ[K] E) :
    hf.galHomAux K hmo hx hadj hmax hα hgen σ α =
      (hf.baseChangeAlgHom hmo hx hadj
        (x' := ⟨α, (mem_integralClosure_iff R' E').mpr ⟨_, hmo.map _, hα⟩⟩)
        (Subtype.ext ((aeval_subalgebra_coe (f.map (algebraMap R R')) (integralClosure R' E')
          ⟨α, (mem_integralClosure_iff R' E').mpr ⟨_, hmo.map _, hα⟩⟩).trans hα))
        (σ • x) : E') := by
  let x' : integralClosure R' E' := ⟨α, (mem_integralClosure_iff R' E').mpr ⟨_, hmo.map _, hα⟩⟩
  have hx' : aeval x' (f.map (algebraMap R R')) = 0 :=
    Subtype.ext ((aeval_subalgebra_coe (f.map (algebraMap R R')) (integralClosure R' E') x').trans
      hα)
  let j := hf.baseChangeAlgHom hmo hx hadj hx'
  let jE : integralClosure R E →ₐ[R] E' :=
    (IsScalarTower.toAlgHom R (integralClosure R' E') E').comp j
  have hj_root : (f.map (algebraMap R K')).eval₂ (Algebra.ofId K' E') (j (σ • x) : E') = 0 := by
    have hact : aeval (σ • x) f = σ • aeval x f :=
      aeval_algHom_apply (MulSemiringAction.toAlgHom R (integralClosure R E) σ) x f
    have hjf : aeval (jE (σ • x)) f = 0 := by
      rw [aeval_algHom_apply jE (σ • x) f, hact, hx, smul_zero, map_zero]
    rw [Algebra.toRingHom_ofId, ← aeval_def, IsScalarTower.algebraMap_eq R R' K',
      ← Polynomial.map_map, aeval_map_algebraMap K', aeval_map_algebraMap R']
    exact hjf
  let eAdj := hf.adjoinRootFieldEquiv hmo hmax hα hgen
  have heAdj : eAdj.symm α = AdjoinRoot.root (f.map (algebraMap R K')) :=
    eAdj.injective ((eAdj.apply_symm_apply α).trans
      (hf.adjoinRootFieldEquiv_apply_root hmo hmax hα hgen).symm)
  exact (congrArg (AdjoinRoot.liftAlgHom (f.map (algebraMap R K')) (Algebra.ofId K' E')
    (j (σ • x) : E') hj_root) heAdj).trans
    (AdjoinRoot.liftAlgHom_root (f.map (algebraMap R K')) (Algebra.ofId K' E')
      (j (σ • x) : E') hj_root)

private theorem galHomAux_mul (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤)
    (σ τ : E ≃ₐ[K] E) :
    hf.galHomAux K hmo hx hadj hmax hα hgen (σ * τ) =
      hf.galHomAux K hmo hx hadj hmax hα hgen σ *
        hf.galHomAux K hmo hx hadj hmax hα hgen τ := by
  have : FaithfulSMul R E := FaithfulSMul.trans R K E
  have : FaithfulSMul R (integralClosure R E) :=
    FaithfulSMul.tower_bot R (integralClosure R E) E
  let x' : integralClosure R' E' := ⟨α, (mem_integralClosure_iff R' E').mpr ⟨_, hmo.map _, hα⟩⟩
  have hx' : aeval x' (f.map (algebraMap R R')) = 0 :=
    Subtype.ext ((aeval_subalgebra_coe (f.map (algebraMap R R')) (integralClosure R' E')
      x').trans hα)
  let j := hf.baseChangeAlgHom hmo hx hadj hx'
  let jE : integralClosure R E →ₐ[R] E' :=
    (IsScalarTower.toAlgHom R (integralClosure R' E') E').comp j
  refine TauCeti.IntermediateField.algEquiv_ext_of_adjoin_eq_top hgen fun y hy ↦ ?_
  rw [Set.mem_singleton_iff.mp hy, AlgEquiv.mul_apply,
    hf.galHomAux_apply_gen K hmo hx hadj hmax hα hgen,
    hf.galHomAux_apply_gen K hmo hx hadj hmax hα hgen]
  have hτ : τ • x ∈ Algebra.adjoin R {x} := hadj ▸ Algebra.mem_top
  rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range] at hτ
  obtain ⟨p, hp⟩ := hτ
  have hjx : jE x = α := by simp [jE, j, x']
  have hj_τ : (j (τ • x) : E') = aeval α (p.map (algebraMap R K')) := by
    change jE (τ • x) = _
    rw [← hp, ← aeval_algHom_apply jE x p, hjx,
      IsScalarTower.algebraMap_eq R R' K', ← Polynomial.map_map, aeval_map_algebraMap K',
      aeval_map_algebraMap R']
  have hj_mul : (j ((σ * τ) • x) : E') =
      aeval (j (σ • x) : E') (p.map (algebraMap R K')) := by
    have hact : σ • aeval x p = aeval (σ • x) p :=
      (aeval_algHom_apply (MulSemiringAction.toAlgHom R (integralClosure R E) σ) x p).symm
    change jE ((σ * τ) • x) = _
    rw [mul_smul, ← hp, hact, ← aeval_algHom_apply jE (σ • x) p,
      IsScalarTower.algebraMap_eq R R' K', ← Polynomial.map_map, aeval_map_algebraMap K',
      aeval_map_algebraMap R']
    rfl
  rw [hj_mul, hj_τ]
  let σ' := hf.galHomAux K hmo hx hadj hmax hα hgen σ
  have hσ' : σ' (aeval α (p.map (algebraMap R K'))) =
      aeval (σ' α) (p.map (algebraMap R K')) :=
    (aeval_algHom_apply σ' α (p.map (algebraMap R K'))).symm
  change _ = σ' (aeval α (p.map (algebraMap R K')))
  rw [hσ', show σ' α = (j (σ • x) : E') from hf.galHomAux_apply_gen K hmo hx hadj hmax hα hgen σ]

/-- Group homomorphism `(E ≃ₐ[K] E) →* (E' ≃ₐ[K'] E')` induced by Eisenstein base change. -/
def galHom (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) :
    (E ≃ₐ[K] E) →* (E' ≃ₐ[K'] E') where
  toFun := hf.galHomAux K hmo hx hadj hmax hα hgen
  map_one' := by
    have : FaithfulSMul R E := FaithfulSMul.trans R K E
    have : FaithfulSMul R (integralClosure R E) :=
      FaithfulSMul.tower_bot R (integralClosure R E) E
    refine TauCeti.IntermediateField.algEquiv_eq_one_of_adjoin_eq_top hgen fun y hy ↦ ?_
    rw [Set.mem_singleton_iff.mp hy, hf.galHomAux_apply_gen K hmo hx hadj hmax hα hgen,
      one_smul, hf.baseChangeAlgHom_apply_gen]
  map_mul' := hf.galHomAux_mul K hmo hx hadj hmax hα hgen

/-- `galHom` is injective whenever `E / K` is finite-dimensional. -/
theorem galHom_injective (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    [FiniteDimensional K E] (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) :
    Function.Injective (hf.galHom K hmo hx hadj hmax hα hgen) := by
  have : FaithfulSMul R E := FaithfulSMul.trans R K E
  have : FaithfulSMul R (integralClosure R E) :=
    FaithfulSMul.tower_bot R (integralClosure R E) E
  have : FaithfulSMul R' E' := FaithfulSMul.trans R' K' E'
  have : FaithfulSMul R' (integralClosure R' E') :=
    FaithfulSMul.tower_bot R' (integralClosure R' E') E'
  let x' : integralClosure R' E' := ⟨α, (mem_integralClosure_iff R' E').mpr ⟨_, hmo.map _, hα⟩⟩
  have hx' : aeval x' (f.map (algebraMap R R')) = 0 :=
    Subtype.ext ((aeval_subalgebra_coe (f.map (algebraMap R R')) (integralClosure R' E')
      x').trans hα)
  have hadj' : Algebra.adjoin R' {x'} = ⊤ :=
    hf.adjoin_integralClosure_eq_top_of_map_maximalIdeal_eq hmo hmax hα hgen
  refine (injective_iff_map_eq_one _).mpr fun σ hσ ↦ ?_
  have hα_eq : hf.galHom K hmo hx hadj hmax hα hgen σ α = α := by rw [hσ, AlgEquiv.one_apply]
  change hf.galHomAux K hmo hx hadj hmax hα hgen σ α = α at hα_eq
  rw [hf.galHomAux_apply_gen K hmo hx hadj hmax hα hgen] at hα_eq
  have hj_eq : hf.baseChangeAlgHom hmo hx hadj hx' (σ • x) =
      hf.baseChangeAlgHom hmo hx hadj hx' x := by
    apply Subtype.ext
    simpa [x'] using hα_eq
  exact algEquiv_eq_one_of_smul_eq_self K hadj
    (hf.baseChangeAlgHom_injective hmo hx hadj hmax hx' hadj' hj_eq)

/-- **Galois preservation under Eisenstein base change.** If `E / K` is Galois with
`integralClosure R E` generated over `R` by a root `x` of a monic Eisenstein polynomial `f`, and
`E' = K'⟮α⟯` is generated over `K'` by a root `α` of `f.map (algebraMap R R')` along an unramified
map of discrete valuation rings `R → R'`, then `E' / K'` is Galois. -/
theorem isGalois_of_map_maximalIdeal_eq (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    [FiniteDimensional K E] [IsGalois K E] (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) :
    IsGalois K' E' := by
  have := FaithfulSMul.trans R' K' E'
  have hdeg : 0 < f.natDegree := hmo.natDegree_pos.mpr (by rintro rfl; simp at hα)
  have hfinE' : Module.finrank K' E' = f.natDegree :=
    hf.finrank_eq_natDegree_of_map_maximalIdeal_eq hmo hmax hα hgen
  have : FiniteDimensional K' E' := Module.finite_of_finrank_pos (hfinE'.symm ▸ hdeg)
  have hcard_le : Nat.card (E' ≃ₐ[K'] E') ≤ Module.finrank K' E' := by
    rw [Nat.card_eq_fintype_card]
    exact AlgEquiv.card_le
  have hcard_ge : Module.finrank K' E' ≤ Nat.card (E' ≃ₐ[K'] E') := by
    rw [hfinE', ← hf.finrank_base_eq_natDegree K hmo hx hadj, ← IsGalois.card_aut_eq_finrank K E]
    exact Nat.card_le_card_of_injective _ (hf.galHom_injective K hmo hx hadj hmax hα hgen)
  exact IsGalois.of_card_aut_eq_finrank K' E' (le_antisymm hcard_le hcard_ge)

/-- **Galois group isomorphism under Eisenstein base change.** Canonical group isomorphism
`(E ≃ₐ[K] E) ≃* (E' ≃ₐ[K'] E')` sending `σ` to the unique `K'`-automorphism acting on `α` as
`baseChangeAlgHom` of `σ • x`. -/
def galMulEquiv (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    [FiniteDimensional K E] [IsGalois K E] (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) :
    (E ≃ₐ[K] E) ≃* (E' ≃ₐ[K'] E') := by
  have := FaithfulSMul.trans R' K' E'
  have hdeg : 0 < f.natDegree := hmo.natDegree_pos.mpr (by rintro rfl; simp at hα)
  have hfinE' : Module.finrank K' E' = f.natDegree :=
    hf.finrank_eq_natDegree_of_map_maximalIdeal_eq hmo hmax hα hgen
  have : FiniteDimensional K' E' := Module.finite_of_finrank_pos (hfinE'.symm ▸ hdeg)
  have : IsGalois K' E' := hf.isGalois_of_map_maximalIdeal_eq K hmo hx hadj hmax hα hgen
  have hinj := hf.galHom_injective K hmo hx hadj hmax hα hgen
  have hcard : Fintype.card (E ≃ₐ[K] E) = Fintype.card (E' ≃ₐ[K'] E') := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card,
      IsGalois.card_aut_eq_finrank K E, IsGalois.card_aut_eq_finrank K' E',
      hf.finrank_base_eq_natDegree K hmo hx hadj, hfinE']
  exact MulEquiv.ofBijective (hf.galHom K hmo hx hadj hmax hα hgen)
    ((Fintype.bijective_iff_injective_and_card _).mpr ⟨hinj, hcard⟩)

/-- `galMulEquiv` intertwines the Galois actions on the Eisenstein generators via
`baseChangeAlgHom`. -/
theorem galMulEquiv_smul_gen (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    [FiniteDimensional K E] [IsGalois K E] [FaithfulSMul R (integralClosure R E)]
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) (σ : E ≃ₐ[K] E) :
    (hf.galMulEquiv K hmo hx hadj hmax hα hgen σ) •
        (⟨α, (mem_integralClosure_iff R' E').mpr ⟨_, hmo.map _, hα⟩⟩ : integralClosure R' E') =
      hf.baseChangeAlgHom hmo hx hadj
        (Subtype.ext ((aeval_subalgebra_coe (f.map (algebraMap R R')) (integralClosure R' E')
          ⟨α, (mem_integralClosure_iff R' E').mpr ⟨_, hmo.map _, hα⟩⟩).trans hα))
        (σ • x) := by
  apply Subtype.ext
  exact hf.galHomAux_apply_gen K hmo hx hadj hmax hα hgen σ

/-- Action of `galMulEquiv σ` on the primitive element `α : E'`. -/
theorem galMulEquiv_apply_gen (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    [FiniteDimensional K E] [IsGalois K E] [FaithfulSMul R (integralClosure R E)]
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) (σ : E ≃ₐ[K] E) :
    hf.galMulEquiv K hmo hx hadj hmax hα hgen σ α =
      (hf.baseChangeAlgHom hmo hx hadj
        (Subtype.ext ((aeval_subalgebra_coe (f.map (algebraMap R R')) (integralClosure R' E')
          ⟨α, (mem_integralClosure_iff R' E').mpr ⟨_, hmo.map _, hα⟩⟩).trans hα))
        (σ • x) : E') :=
  hf.galHomAux_apply_gen K hmo hx hadj hmax hα hgen σ

/-- `galMulEquiv` preserves Serre's lower index on the integral closures.
Note that `IsDiscreteValuationRing` holds for both integral closures by
`hf.isDiscreteValuationRing_of_adjoin_eq_top` and
`hf.isDiscreteValuationRing_integralClosure_of_map_maximalIdeal_eq`. -/
theorem lowerIndex_galMulEquiv (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    [FiniteDimensional K E] [IsGalois K E]
    [IsDiscreteValuationRing (integralClosure R E)]
    [IsDiscreteValuationRing (integralClosure R' E')]
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) (σ : E ≃ₐ[K] E) :
    TauCeti.IsLocalRing.lowerIndex (integralClosure R' E')
        (hf.galMulEquiv K hmo hx hadj hmax hα hgen σ) =
      TauCeti.IsLocalRing.lowerIndex (integralClosure R E) σ := by
  have : FaithfulSMul R E := FaithfulSMul.trans R K E
  have : FaithfulSMul R (integralClosure R E) :=
    FaithfulSMul.tower_bot R (integralClosure R E) E
  have : FaithfulSMul R' E' := FaithfulSMul.trans R' K' E'
  have : FaithfulSMul R' (integralClosure R' E') :=
    FaithfulSMul.tower_bot R' (integralClosure R' E') E'
  exact hf.lowerIndex_eq hmo hx hadj hmax
    (Subtype.ext ((aeval_subalgebra_coe (f.map (algebraMap R R')) (integralClosure R' E')
      ⟨α, (mem_integralClosure_iff R' E').mpr ⟨_, hmo.map _, hα⟩⟩).trans hα))
    (hf.adjoin_integralClosure_eq_top_of_map_maximalIdeal_eq hmo hmax hα hgen)
    (hf.galMulEquiv_smul_gen K hmo hx hadj hmax hα hgen σ)

/-- `galMulEquiv` maps the `i`-th lower ramification group of `E / K` onto that of `E' / K'`. -/
theorem map_ramificationGroup_galMulEquiv (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    [FiniteDimensional K E] [IsGalois K E]
    [IsLocalRing (integralClosure R E)] [IsLocalRing (integralClosure R' E')]
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) (i : ℤ) :
    (TauCeti.IsLocalRing.ramificationGroup (E ≃ₐ[K] E) (integralClosure R E) i).map
        (hf.galMulEquiv K hmo hx hadj hmax hα hgen).toMonoidHom =
      TauCeti.IsLocalRing.ramificationGroup (E' ≃ₐ[K'] E') (integralClosure R' E') i := by
  have : FaithfulSMul R E := FaithfulSMul.trans R K E
  have : FaithfulSMul R (integralClosure R E) :=
    FaithfulSMul.tower_bot R (integralClosure R E) E
  have : FaithfulSMul R' E' := FaithfulSMul.trans R' K' E'
  have : FaithfulSMul R' (integralClosure R' E') :=
    FaithfulSMul.tower_bot R' (integralClosure R' E') E'
  let e := hf.galMulEquiv K hmo hx hadj hmax hα hgen
  rw [← hf.comap_ramificationGroup hmo hx hadj hmax
    (Subtype.ext ((aeval_subalgebra_coe (f.map (algebraMap R R')) (integralClosure R' E')
      ⟨α, (mem_integralClosure_iff R' E').mpr ⟨_, hmo.map _, hα⟩⟩).trans hα))
    (hf.adjoin_integralClosure_eq_top_of_map_maximalIdeal_eq hmo hmax hα hgen) e.toMonoidHom
    (hf.galMulEquiv_smul_gen K hmo hx hadj hmax hα hgen) i]
  exact Subgroup.map_comap_eq_self_of_surjective e.surjective _

/-- Real-indexed counterpart of `map_ramificationGroup_galMulEquiv`. -/
theorem map_ramificationGroupReal_galMulEquiv (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    [FiniteDimensional K E] [IsGalois K E]
    [IsLocalRing (integralClosure R E)] [IsLocalRing (integralClosure R' E')]
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) (u : ℝ) :
    (TauCeti.IsLocalRing.ramificationGroupReal (E ≃ₐ[K] E) (integralClosure R E) u).map
        (hf.galMulEquiv K hmo hx hadj hmax hα hgen).toMonoidHom =
      TauCeti.IsLocalRing.ramificationGroupReal (E' ≃ₐ[K'] E') (integralClosure R' E') u := by
  rw [TauCeti.IsLocalRing.ramificationGroupReal_def,
    TauCeti.IsLocalRing.ramificationGroupReal_def]
  exact hf.map_ramificationGroup_galMulEquiv K hmo hx hadj hmax hα hgen ⌈u⌉

/-- Cardinality of the `i`-th lower ramification group is preserved under Eisenstein base change.
-/
theorem card_ramificationGroup_eq (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    [FiniteDimensional K E] [IsGalois K E]
    [IsLocalRing (integralClosure R E)] [IsLocalRing (integralClosure R' E')]
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) (i : ℤ) :
    Nat.card (TauCeti.IsLocalRing.ramificationGroup (E' ≃ₐ[K'] E') (integralClosure R' E') i) =
      Nat.card (TauCeti.IsLocalRing.ramificationGroup (E ≃ₐ[K] E) (integralClosure R E) i) := by
  let e := hf.galMulEquiv K hmo hx hadj hmax hα hgen
  rw [← hf.map_ramificationGroup_galMulEquiv K hmo hx hadj hmax hα hgen i]
  exact (Nat.card_congr (e.subgroupMap _).toEquiv).symm

/-- Cardinality of the real-indexed lower ramification group `ramificationGroupReal` is preserved
under Eisenstein base change (and hence so is every step-function integrand built from the lower
ramification filtration). -/
theorem card_ramificationGroupReal_eq (hf : f.IsEisensteinAt (maximalIdeal R)) (K : Type*)
    [Field K] [Algebra R K] [IsFractionRing R K] [Algebra K E] [IsScalarTower R K E]
    [FiniteDimensional K E] [IsGalois K E]
    [IsLocalRing (integralClosure R E)] [IsLocalRing (integralClosure R' E')]
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin R {x} = ⊤)
    (hmax : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R')
    (hα : aeval α (f.map (algebraMap R R')) = 0) (hgen : K'⟮α⟯ = ⊤) (u : ℝ) :
    Nat.card (TauCeti.IsLocalRing.ramificationGroupReal (E' ≃ₐ[K'] E') (integralClosure R' E') u) =
      Nat.card (TauCeti.IsLocalRing.ramificationGroupReal (E ≃ₐ[K] E) (integralClosure R E) u) := by
  rw [TauCeti.IsLocalRing.ramificationGroupReal_def,
    TauCeti.IsLocalRing.ramificationGroupReal_def]
  exact hf.card_ramificationGroup_eq K hmo hx hadj hmax hα hgen ⌈u⌉

