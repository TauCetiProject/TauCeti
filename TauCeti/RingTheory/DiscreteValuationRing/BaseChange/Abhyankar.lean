/-!
# Unramifiedness of the Abhyankar model over a root extension

The local rings of the model `(B[y]/(y^e - u))[x]/(x^d - ϖ y)` have maximal ideal generated
by `x`. To read this as unramifiedness over a root extension of a smaller ring `A`, one must
also compare residue fields over that smaller ring, not just over `B`.

Here `A → B` is essentially of finite type with separable residue extension, and a local
`A`-algebra `R` acts on the model with a generator of its maximal ideal mapping to `x`.
Then each maximal localization of the
model is formally unramified over `R`. This applies to the Kummer base `R = A[π^(1/(ed))]`
when `π = u ϖ^e`: its root is a uniformizer and maps to `x`.

The argument is the local computation in SGA 1, Exposé X, Lemme 3.6 and
[Stacks Project, Lemma 15.116.4](https://stacks.math.columbia.edu/tag/0BRM).
-/

public section

noncomputable section

open IsLocalRing Polynomial

namespace TauCeti

section LocalModel

variable {A B R : Type*} [CommRing A] [IsLocalRing A]
  [CommRing B] [IsDomain B] [IsDiscreteValuationRing B] [Algebra A B]
  [IsLocalHom (algebraMap A B)] [Algebra.EssFiniteType A B]
  [Algebra.IsSeparable (ResidueField A) (ResidueField B)]
  [CommRing R] [IsLocalRing R] [Algebra A R]
  {ϖ u : B} {e d : ℕ}

/-- Over a local base whose maximal ideal is generated by the root, every maximal localization
of the Abhyankar model is formally unramified, provided the original residue extension is
separable. No invertibility of the multiplier `d` is required. -/
theorem formallyUnramified_abhyankarModel
    [Algebra R (abhyankarModel ϖ u e d)]
    [IsScalarTower A R (abhyankarModel ϖ u e d)]
    (hϖ : Irreducible ϖ) (hu : IsUnit u) (he : IsUnit (e : B)) (hd : d ≠ 0)
    {ρ : R} (hρ : maximalIdeal R = Ideal.span {ρ})
    (hroot : algebraMap R (abhyankarModel ϖ u e d) ρ = abhyankarModelRoot ϖ u e d)
    (M : Ideal (abhyankarModel ϖ u e d)) [M.IsMaximal] :
    Algebra.FormallyUnramified R (Localization.AtPrime M) := by
  let D := abhyankarModel ϖ u e d
  let S := Localization.AtPrime M
  have he₀ : e ≠ 0 := he.neZero_natCast.out
  have := (monic_X_pow_sub_C u he₀).finite_adjoinRoot
  have := (monic_X_pow_sub_C
    (algebraMap B (standardTameCover B u e) ϖ * AdjoinRoot.root (X ^ e - C u)) hd).finite_adjoinRoot
  have : Module.Finite B D := .trans (standardTameCover B u e) _
  have : M.LiesOver (maximalIdeal B) :=
    ⟨(eq_maximalIdeal (Ideal.IsMaximal.under B M)).symm⟩
  have hmax : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S := by
    rw [hρ, Ideal.map_span, Set.image_singleton,
      IsScalarTower.algebraMap_apply R D S, hroot]
    exact (maximalIdeal_eq_span_abhyankarModelRoot S M hϖ hu he hd).symm
  have : IsLocalHom (algebraMap R S) :=
    ((local_hom_tfae (algebraMap R S)).out 3 1).mp hmax.le
  have : Algebra.EssFiniteType A D := .comp A B D
  have : Algebra.EssFiniteType A S := .comp A D S
  have : Algebra.EssFiniteType R S := .of_comp A R S
  -- Compare the residue fields along A → B → D/M, then enlarge the scalar field to κ(R).
  let := Ideal.Quotient.field (maximalIdeal B)
  let := Ideal.Quotient.field M
  let : Algebra (ResidueField B) (D ⧸ M) :=
    inferInstanceAs (Algebra (B ⧸ maximalIdeal B) (D ⧸ M))
  have : IsScalarTower A (ResidueField B) (D ⧸ M) :=
    inferInstanceAs (IsScalarTower A (B ⧸ maximalIdeal B) (D ⧸ M))
  have : Algebra.IsSeparable (ResidueField B) (D ⧸ M) :=
    isSeparable_abhyankarModel_quotient M (hϖ.maximalIdeal_eq ▸ Ideal.mem_span_singleton_self ϖ)
      hu he hd
  have : Algebra.FormallyUnramified (ResidueField A) (ResidueField B) := .of_isSeparable _ _
  have : Algebra.FormallyUnramified A (ResidueField B) := .comp A (ResidueField A) _
  have : Algebra.FormallyUnramified (ResidueField B) (D ⧸ M) := .of_isSeparable _ _
  have : Algebra.FormallyUnramified A (D ⧸ M) := .comp A (ResidueField B) _
  have : Algebra.FormallyUnramified (D ⧸ M) M.ResidueField :=
    .of_isLocalization (nonZeroDivisors (D ⧸ M))
  have : Algebra.FormallyUnramified A M.ResidueField := .comp A (D ⧸ M) _
  have : Algebra.FormallyUnramified R M.ResidueField := .of_restrictScalars A R _
  have : Algebra.FormallyUnramified (ResidueField R) M.ResidueField := .of_restrictScalars R _ _
  have : Algebra.EssFiniteType R (ResidueField S) := .comp R S _
  have : Algebra.EssFiniteType (ResidueField R) (ResidueField S) := .of_comp R _ _
  have : Algebra.IsSeparable (ResidueField R) (ResidueField S) :=
    Algebra.FormallyUnramified.isSeparable _ _
  exact Algebra.FormallyUnramified.of_map_maximalIdeal hmax

end LocalModel

section Kummer

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
  {π : A} {ϖ u : B} {e d : ℕ}

variable [IsDomain A] [IsDiscreteValuationRing A]
  [IsDomain B] [IsDiscreteValuationRing B] [IsLocalHom (algebraMap A B)]
  [Algebra.EssFiniteType A B] [Algebra.IsSeparable (ResidueField A) (ResidueField B)]

/-- The Abhyankar model is unramified at each maximal ideal over the Kummer root ring
`A[π^(1/(ed))]`, if `π = u ϖ^e` for uniformizers `π, ϖ`, `e` is invertible in `B`, and the
residue extension of `B/A` is separable. The multiplier `d` may be divisible by the residue
characteristic. This is the Kummer-base local computation in Stacks, Lemma 15.116.4 (0BRM). -/
theorem formallyUnramified_abhyankarModelKummerHom
    (hπ : Irreducible π) (hϖ : Irreducible ϖ) (hu : IsUnit u)
    (he : IsUnit (e : B)) (hd : d ≠ 0) (hπB : algebraMap A B π = u * ϖ ^ e)
    (M : Ideal (abhyankarModel ϖ u e d)) [M.IsMaximal] :
    ((algebraMap _ (Localization.AtPrime M)).comp
      (abhyankarModelKummerHom (d := d) hπB).toRingHom).FormallyUnramified := by
  let R₁ := standardTameCover A π (e * d)
  let D := abhyankarModel ϖ u e d
  let φ := abhyankarModelKummerHom (d := d) hπB
  let : Algebra R₁ D := φ.toRingHom.toAlgebra
  have : IsScalarTower A R₁ D := .of_algebraMap_eq' φ.comp_algebraMap.symm
  have hn : e * d ≠ 0 := mul_ne_zero he.neZero_natCast.out hd
  have hπm : π ∈ maximalIdeal A := by
    rw [hπ.maximalIdeal_eq]
    exact Ideal.mem_span_singleton_self _
  have : IsLocalRing R₁ := standardTameCover_isLocalRing hπm hn
  have hmax : maximalIdeal R₁ = Ideal.span {AdjoinRoot.root (X ^ (e * d) - C π)} :=
    Polynomial.IsEisensteinAt.eq_span_singleton_of_isMaximal
      (isEisensteinAt_X_pow_sub_C_of_irreducible hπ (Nat.pos_of_ne_zero hn))
      (monic_X_pow_sub_C _ hn) (AdjoinRoot.eval₂_root _) AdjoinRoot.adjoinRoot_eq_top _
  have : Algebra.FormallyUnramified R₁ (Localization.AtPrime M) :=
    formallyUnramified_abhyankarModel (A := A) hϖ hu he hd hmax
      (abhyankarModelKummerHom_root hπB) M
  exact RingHom.formallyUnramified_algebraMap.mpr this

end Kummer

end TauCeti
