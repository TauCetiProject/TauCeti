/-!
# The local model in Abhyankar's lemma for discrete valuation rings

Let `A → B` be an extension of discrete valuation rings whose ramification index `e` is invertible
in `B`, so that a uniformizer `π` of `A` is `u ϖ ^ e` with `ϖ` a uniformizer of `B` and `u` a unit.
Abhyankar's lemma says that adjoining an `n`-th root of `π`, for a multiple `n = e d` of `e`, gives
an extension that is unramified over `A[π ^ (1 / n)]`. The local computation behind it is a
factorization of the root extraction: if `x ^ (e d) = u ϖ ^ e`, then `y = x ^ d / ϖ` satisfies
`y ^ e = u`, so the root extraction is the étale extension `B[y]/(y ^ e − u)` followed by the
Kummer extension `x ^ d = ϖ y` of it.

This file studies the ring

  `D = (B[y]/(y ^ e − u))[x]/(x ^ d − ϖ y)`,

`TauCeti.abhyankarModel ϖ u e d`, defined for an arbitrary commutative ring `B`. It is free of
rank `e d` over `B` (`TauCeti.abhyankarModel_free`), and after inverting `ϖ` it is the root
extraction `B[x]/(x ^ (e d) − u ϖ ^ e)` (`TauCeti.abhyankarModelAwayAlgEquiv`), with no hypothesis
on `B`. When `B` is a discrete valuation ring with uniformizer `ϖ`, `u` is a unit and `e` is
invertible, the local ring of `D` at every maximal ideal is a discrete valuation ring whose
maximal ideal is generated by `x`, and its residue field is separable over the residue field of
`B`. When `π = u ϖ ^ e` is a uniformizer of `A`, the element `x` with `x ^ n = π` is also a
uniformizer of the Kummer extension `A[π ^ (1 / n)]`
(`TauCeti.IsDiscreteValuationRing.irreducible_mk_of_pow_eq_of_irreducible`). Read over that
extension, these results say that the local rings of `D` have ramification index one and
separable residue fields.

## Main definitions

* `TauCeti.abhyankarModel ϖ u e d`: the ring `(B[y]/(y ^ e − u))[x]/(x ^ d − ϖ y)`.
* `TauCeti.abhyankarModelRoot ϖ u e d`: its element `x`.
* `TauCeti.abhyankarModelAwayAlgEquiv`: after inverting `ϖ`, the root extraction
  `B[x]/(x ^ (e d) − u ϖ ^ e)` is isomorphic to `D`, compatibly with the roots.

## Main results

* `TauCeti.abhyankarModelRoot_pow`, `TauCeti.abhyankarModelRoot_pow_mul`: `x ^ d = ϖ y` and
  `x ^ (e d) = u ϖ ^ e`.
* `TauCeti.abhyankarModel_free`: for `e, d ≥ 1` the model is free of rank `e d`.
* `TauCeti.abhyankarModelAwayAlgEquiv_root`: the isomorphism away from `ϖ` sends `x` to `x`.
* `TauCeti.abhyankarModelRoot_mem_nonZeroDivisors`: `x` is a nonzerodivisor when `ϖ` is.
* `TauCeti.isRegularLocalRing_abhyankarModel`, `TauCeti.isDiscreteValuationRing_abhyankarModel`,
  `TauCeti.maximalIdeal_eq_span_abhyankarModelRoot`: over a discrete valuation ring, the local
  rings at maximal ideals are discrete valuation rings with uniformizer `x`.
* `TauCeti.isSeparable_abhyankarModel_quotient`: over a local ring, the residue fields at maximal
  ideals are separable over the residue field of `B`.

## References

* A. Grothendieck, *Revêtements étales et groupe fondamental* (SGA 1), Exposé X, Lemme 3.6.
* [Stacks Project, Lemma 15.116.4](https://stacks.math.columbia.edu/tag/0BRM).
-/

public section

universe u

open Polynomial IsLocalRing

namespace TauCeti

variable {B : Type u} [CommRing B]

/-- The local model of Abhyankar's lemma, `(B[y]/(y ^ e − u))[x]/(x ^ d − ϖ y)`: the standard
cover of `B[y]/(y ^ e − u)` along `ϖ y` with exponent `d`. In it `x ^ (e d) = u ϖ ^ e`
(`TauCeti.abhyankarModelRoot_pow_mul`), and `y = x ^ d / ϖ` once `ϖ` is inverted. -/
abbrev abhyankarModel (ϖ u : B) (e d : ℕ) : Type u :=
  standardTameCover (standardTameCover B u e)
    (algebraMap B (standardTameCover B u e) ϖ * AdjoinRoot.root (X ^ e - C u)) d

/-- The root `x` of `x ^ d = ϖ y` in the Abhyankar model. -/
noncomputable abbrev abhyankarModelRoot (ϖ u : B) (e d : ℕ) : abhyankarModel ϖ u e d :=
  AdjoinRoot.root _

/-- The defining relation `x ^ d = ϖ y` of the Abhyankar model. -/
theorem abhyankarModelRoot_pow (ϖ u : B) (e d : ℕ) :
    abhyankarModelRoot ϖ u e d ^ d =
      algebraMap B (abhyankarModel ϖ u e d) ϖ *
        algebraMap (standardTameCover B u e) (abhyankarModel ϖ u e d)
          (AdjoinRoot.root (X ^ e - C u)) := by
  rw [abhyankarModelRoot, AdjoinRoot.root_X_pow_sub_C_pow, ← AdjoinRoot.algebraMap_eq, map_mul,
    ← IsScalarTower.algebraMap_apply]

/-- The root `x` of the Abhyankar model is an `e d`-th root of `u ϖ ^ e`. -/
theorem abhyankarModelRoot_pow_mul (ϖ u : B) (e d : ℕ) :
    abhyankarModelRoot ϖ u e d ^ (e * d) = algebraMap B (abhyankarModel ϖ u e d) (u * ϖ ^ e) := by
  have hy : AdjoinRoot.root (X ^ e - C u) ^ e = algebraMap B (standardTameCover B u e) u :=
    AdjoinRoot.root_X_pow_sub_C_pow e u
  rw [Nat.mul_comm e d, pow_mul, abhyankarModelRoot_pow, mul_pow, ← map_pow, ← map_pow, hy,
    ← IsScalarTower.algebraMap_apply, ← map_mul]
  exact congrArg _ (mul_comm _ _)

/-- For `e, d ≥ 1` the Abhyankar model is free of rank `e d` over `B`. -/
theorem abhyankarModel_free [Nontrivial B] (ϖ u : B) {e d : ℕ} (he : 1 ≤ e) (hd : 1 ≤ d) :
    Module.Free B (abhyankarModel ϖ u e d) ∧
      Module.finrank B (abhyankarModel ϖ u e d) = e * d := by
  obtain ⟨_, h₁⟩ := standardTameCover_free B u e he
  have : Nontrivial (standardTameCover B u e) :=
    Module.nontrivial_of_finrank_pos (R := B) (by omega)
  obtain ⟨_, h₂⟩ := standardTameCover_free (standardTameCover B u e)
    (algebraMap B (standardTameCover B u e) ϖ * AdjoinRoot.root (X ^ e - C u)) d hd
  exact ⟨.trans (S := standardTameCover B u e), by
    rw [← Module.finrank_mul_finrank B (standardTameCover B u e), h₁, h₂]⟩

section Away

variable (ϖ u : B) (e d : ℕ)

/-- The root extraction `B[x]/(x ^ (e d) − u ϖ ^ e)` maps to the Abhyankar model by `x ↦ x`. -/
private noncomputable def toAbhyankarModel :
    standardTameCover B (u * ϖ ^ e) (e * d) →ₐ[B] abhyankarModel ϖ u e d :=
  AdjoinRoot.liftAlgHom _ (Algebra.ofId B _) (abhyankarModelRoot ϖ u e d) (by
    simp [abhyankarModelRoot_pow_mul])

private theorem toAbhyankarModel_root :
    toAbhyankarModel ϖ u e d (AdjoinRoot.root (X ^ (e * d) - C (u * ϖ ^ e))) =
      abhyankarModelRoot ϖ u e d :=
  AdjoinRoot.liftAlgHom_root _ _ _ _

variable (Cϖ Dϖ : Type*) [CommRing Cϖ] [CommRing Dϖ]
  [Algebra (standardTameCover B (u * ϖ ^ e) (e * d)) Cϖ]
  [IsLocalization.Away (algebraMap B (standardTameCover B (u * ϖ ^ e) (e * d)) ϖ) Cϖ]
  [Algebra B Cϖ] [IsScalarTower B (standardTameCover B (u * ϖ ^ e) (e * d)) Cϖ]
  [Algebra (abhyankarModel ϖ u e d) Dϖ]
  [IsLocalization.Away (algebraMap B (abhyankarModel ϖ u e d) ϖ) Dϖ]
  [Algebra B Dϖ] [IsScalarTower B (abhyankarModel ϖ u e d) Dϖ]

include u e d in
/-- The image of `ϖ` in the localization of the root extraction away from `ϖ` is a unit. -/
private theorem isUnit_algebraMap_away_left : IsUnit (algebraMap B Cϖ ϖ) := by
  rw [IsScalarTower.algebraMap_apply B (standardTameCover B (u * ϖ ^ e) (e * d)) Cϖ]
  exact IsLocalization.Away.algebraMap_isUnit _

include u e d in
/-- The image of `ϖ` in the localization of the Abhyankar model away from `ϖ` is a unit. -/
private theorem isUnit_algebraMap_away_right : IsUnit (algebraMap B Dϖ ϖ) := by
  rw [IsScalarTower.algebraMap_apply B (abhyankarModel ϖ u e d) Dϖ]
  exact IsLocalization.Away.algebraMap_isUnit _

/-- The root `x` of the root extraction, in its localization away from `ϖ`. -/
private noncomputable abbrev awayRoot : Cϖ :=
  algebraMap (standardTameCover B (u * ϖ ^ e) (e * d)) Cϖ
    (AdjoinRoot.root (X ^ (e * d) - C (u * ϖ ^ e)))

omit [IsLocalization.Away (algebraMap B (standardTameCover B (u * ϖ ^ e) (e * d)) ϖ) Cϖ] in
private theorem awayRoot_pow_mul :
    awayRoot ϖ u e d Cϖ ^ (e * d) = algebraMap B Cϖ u * algebraMap B Cϖ ϖ ^ e := by
  rw [awayRoot, ← map_pow, AdjoinRoot.root_X_pow_sub_C_pow, ← AdjoinRoot.algebraMap_eq,
    ← IsScalarTower.algebraMap_apply, map_mul, map_pow]

/-- In the localization of the root extraction away from `ϖ`, the element `y = x ^ d / ϖ` is an
`e`-th root of `u`. -/
private noncomputable def fromAbhyankarModelBase : standardTameCover B u e →ₐ[B] Cϖ :=
  AdjoinRoot.liftAlgHom _ (Algebra.ofId B _)
    (awayRoot ϖ u e d Cϖ ^ d * (isUnit_algebraMap_away_left ϖ u e d Cϖ).unit⁻¹) (by
      rw [eval₂_sub, eval₂_X_pow, eval₂_C, sub_eq_zero, mul_pow, ← pow_mul, Nat.mul_comm d e,
        awayRoot_pow_mul, mul_assoc, ← mul_pow, IsUnit.mul_val_inv, one_pow, mul_one,
        AlgHom.coe_toRingHom, Algebra.ofId_apply])

private theorem fromAbhyankarModelBase_root :
    fromAbhyankarModelBase ϖ u e d Cϖ (AdjoinRoot.root (X ^ e - C u)) =
      awayRoot ϖ u e d Cϖ ^ d * (isUnit_algebraMap_away_left ϖ u e d Cϖ).unit⁻¹ :=
  AdjoinRoot.liftAlgHom_root _ _ _ _

/-- In the localization of the root extraction away from `ϖ`, the root `x` satisfies
`x ^ d = ϖ y`. -/
private noncomputable def fromAbhyankarModel : abhyankarModel ϖ u e d →ₐ[B] Cϖ :=
  AdjoinRoot.liftAlgHom _ (fromAbhyankarModelBase ϖ u e d Cϖ) (awayRoot ϖ u e d Cϖ) (by
    rw [eval₂_sub, eval₂_X_pow, eval₂_C, AlgHom.coe_toRingHom, map_mul, AlgHom.commutes,
      fromAbhyankarModelBase_root, mul_left_comm, IsUnit.mul_val_inv, mul_one, sub_self])

private theorem fromAbhyankarModel_root :
    fromAbhyankarModel ϖ u e d Cϖ (abhyankarModelRoot ϖ u e d) = awayRoot ϖ u e d Cϖ :=
  AdjoinRoot.liftAlgHom_root _ _ _ _

private theorem fromAbhyankarModel_of (b : standardTameCover B u e) :
    fromAbhyankarModel ϖ u e d Cϖ (AdjoinRoot.of _ b) =
      fromAbhyankarModelBase ϖ u e d Cϖ b :=
  AdjoinRoot.liftAlgHom_of _ _ _ _ _

omit [IsLocalization.Away (algebraMap B (standardTameCover B (u * ϖ ^ e) (e * d)) ϖ) Cϖ] in
private theorem isUnit_toAbhyankarModel_away :
    IsUnit (((IsScalarTower.toAlgHom B _ Dϖ).comp (toAbhyankarModel ϖ u e d))
      (algebraMap B (standardTameCover B (u * ϖ ^ e) (e * d)) ϖ)) := by
  rw [AlgHom.commutes]; exact isUnit_algebraMap_away_right ϖ u e d Dϖ

/-- **The Abhyankar model away from `ϖ`.** After inverting `ϖ`, the root extraction
`B[x]/(x ^ (e d) − u ϖ ^ e)` is isomorphic to the Abhyankar model
`(B[y]/(y ^ e − u))[x]/(x ^ d − ϖ y)`, by `x ↦ x` and `y ↦ x ^ d / ϖ`. -/
noncomputable def abhyankarModelAwayAlgEquiv : Cϖ ≃ₐ[B] Dϖ :=
  have hF₀ := isUnit_toAbhyankarModel_away ϖ u e d Dϖ
  have hG₀ : IsUnit (fromAbhyankarModel ϖ u e d Cϖ (algebraMap B (abhyankarModel ϖ u e d) ϖ)) := by
    rw [AlgHom.commutes]; exact isUnit_algebraMap_away_left ϖ u e d Cϖ
  let F := IsLocalization.Away.liftAlgHom (S := Cϖ) _ hF₀
  let G := IsLocalization.Away.liftAlgHom (S := Dϖ) _ hG₀
  have hF (z : standardTameCover B (u * ϖ ^ e) (e * d)) :
      F (algebraMap _ Cϖ z) = algebraMap _ Dϖ (toAbhyankarModel ϖ u e d z) :=
    IsLocalization.Away.lift_eq _ hF₀ z
  have hG (z : abhyankarModel ϖ u e d) :
      G (algebraMap _ Dϖ z) = fromAbhyankarModel ϖ u e d Cϖ z :=
    IsLocalization.Away.lift_eq _ hG₀ z
  -- `IsLocalization.algHom_ext` states its hypothesis with `Algebra.algHom`, which is
  -- `IsScalarTower.toAlgHom`; these restate its values as `algebraMap`.
  have hC (z : standardTameCover B (u * ϖ ^ e) (e * d)) :
      Algebra.algHom B _ Cϖ z = algebraMap _ Cϖ z := rfl
  have hD (z : abhyankarModel ϖ u e d) : Algebra.algHom B _ Dϖ z = algebraMap _ Dϖ z := rfl
  AlgEquiv.ofAlgHom F G
    (by
      apply IsLocalization.algHom_ext (.powers (algebraMap B (abhyankarModel ϖ u e d) ϖ))
      ext
      · simp only [AlgHom.comp_apply, AdjoinRoot.coe_ofAlgHom, AlgHom.id_apply, hD, hG,
          fromAbhyankarModel_of, fromAbhyankarModelBase_root]
        -- After multiplying by the unit `ϖ`, both sides are `x ^ d = ϖ y`.
        apply (isUnit_algebraMap_away_right ϖ u e d Dϖ).mul_left_injective
        simp only [← AdjoinRoot.algebraMap_eq]
        rw [← F.commutes ϖ, ← map_mul, mul_assoc, IsUnit.val_inv_mul, mul_one, map_pow, hF,
          toAbhyankarModel_root, ← map_pow, abhyankarModelRoot_pow, map_mul,
          ← IsScalarTower.algebraMap_apply, mul_comm, AlgHom.commutes]
      · simp only [AlgHom.comp_apply, AlgHom.id_apply, hD, hG, fromAbhyankarModel_root, hF,
          toAbhyankarModel_root])
    (by
      apply IsLocalization.algHom_ext
        (.powers (algebraMap B (standardTameCover B (u * ϖ ^ e) (e * d)) ϖ))
      ext
      simp only [AlgHom.comp_apply, AlgHom.id_apply, hC, hF, toAbhyankarModel_root, hG,
        fromAbhyankarModel_root])

/-- The isomorphism `abhyankarModelAwayAlgEquiv` sends the root `x` of the root extraction to the
root `x` of the Abhyankar model. -/
@[simp]
theorem abhyankarModelAwayAlgEquiv_root :
    abhyankarModelAwayAlgEquiv ϖ u e d Cϖ Dϖ
        (algebraMap _ Cϖ (AdjoinRoot.root (X ^ (e * d) - C (u * ϖ ^ e)))) =
      algebraMap _ Dϖ (abhyankarModelRoot ϖ u e d) :=
  (IsLocalization.Away.lift_eq _ (isUnit_toAbhyankarModel_away ϖ u e d Dϖ) _).trans
    (congrArg _ (toAbhyankarModel_root ϖ u e d))

end Away

section DiscreteValuationRing

variable {ϖ u : B} {e d : ℕ}

/-- The element `y` of `B[y]/(y ^ e − u)` is a unit when `u` is and `e ≠ 0`. -/
private theorem isUnit_root (hu : IsUnit u) (he : e ≠ 0) :
    IsUnit (AdjoinRoot.root (X ^ e - C u) : standardTameCover B u e) :=
  (isUnit_pow_iff he).mp (by
    rw [AdjoinRoot.root_X_pow_sub_C_pow, ← AdjoinRoot.algebraMap_eq]; exact hu.map _)

private theorem finite_abhyankarModel (he : e ≠ 0) (hd : d ≠ 0) :
    Module.Finite B (abhyankarModel ϖ u e d) :=
  have := (monic_X_pow_sub_C u he).finite_adjoinRoot
  have := (monic_X_pow_sub_C
    (algebraMap B (standardTameCover B u e) ϖ * AdjoinRoot.root (X ^ e - C u)) hd).finite_adjoinRoot
  .trans (standardTameCover B u e) _

/-- The quotient of the Abhyankar model by `x` is `B[y]/(y ^ e − u)` modulo `ϖ`. -/
private noncomputable def quotientSpanRootAlgEquiv (hu : IsUnit u) (he : e ≠ 0) (hd : d ≠ 0) :
    (abhyankarModel ϖ u e d ⧸ Ideal.span {abhyankarModelRoot ϖ u e d}) ≃ₐ[B]
      standardTameCover B u e ⧸ Ideal.span {algebraMap B (standardTameCover B u e) ϖ} :=
  ((standardTameCoverQuotientSpanRootAlgEquiv _ hd).trans (Ideal.quotientEquivAlgOfEq _
    (Ideal.span_singleton_mul_right_unit (isUnit_root hu he) _))).restrictScalars B

/-- If `ϖ` is a nonzerodivisor and `u` a unit, then the root `x` of the Abhyankar model is a
nonzerodivisor. -/
theorem abhyankarModelRoot_mem_nonZeroDivisors (hϖ : ϖ ∈ nonZeroDivisors B) (hu : IsUnit u)
    (he : e ≠ 0) (hd : d ≠ 0) :
    abhyankarModelRoot ϖ u e d ∈ nonZeroDivisors (abhyankarModel ϖ u e d) := by
  have := (monic_X_pow_sub_C u he).free_adjoinRoot
  have hreg : IsSMulRegular (standardTameCover B u e) ϖ :=
    Module.Flat.isSMulRegular_of_nonZeroDivisors hϖ
  refine (standardTameCover_root_mem_nonZeroDivisors_iff hd).mpr
    (mul_mem (mem_nonZeroDivisors_iff_right.mpr fun z hz ↦ hreg (?_ : ϖ • z = ϖ • 0))
      (isUnit_root hu he).mem_nonZeroDivisors)
  rw [smul_zero, Algebra.smul_def, mul_comm, hz]

/-- The quotient of the Abhyankar model by `x` is formally unramified over `B`: it is a quotient of
the étale algebra `B[y]/(y ^ e − u)`. -/
private theorem formallyUnramified_quotient_span_root (hu : IsUnit u) (he : IsUnit (e : B))
    (he₀ : e ≠ 0) (hd : d ≠ 0) :
    Algebra.FormallyUnramified B
      (abhyankarModel ϖ u e d ⧸ Ideal.span {abhyankarModelRoot ϖ u e d}) :=
  have := standardTameCover_etale hu he
  .of_equiv (quotientSpanRootAlgEquiv hu he₀ hd).symm

variable [IsDomain B] [IsDiscreteValuationRing B]

/-- Over a discrete valuation ring with uniformizer `ϖ`, `x` lies in every maximal ideal of the
Abhyankar model, and every prime containing `x` is maximal. -/
private theorem isMaximal_of_root_mem (hϖ : Irreducible ϖ) (hu : IsUnit u) (he : e ≠ 0)
    (hd : d ≠ 0) (P : Ideal (abhyankarModel ϖ u e d)) [P.IsPrime] :
    P.IsMaximal ↔ abhyankarModelRoot ϖ u e d ∈ P := by
  have := finite_abhyankarModel (ϖ := ϖ) (u := u) he hd
  have hy : IsUnit (algebraMap (standardTameCover B u e) (abhyankarModel ϖ u e d)
      (AdjoinRoot.root (X ^ e - C u))) := (isUnit_root hu he).map _
  have hm := hϖ.maximalIdeal_eq
  have : Algebra.IsIntegral B (abhyankarModel ϖ u e d) := inferInstance
  constructor
  · intro hP
    have := Ideal.isMaximal_under_of_isIntegral_of_isMaximal (R := B) P
    have hϖP : algebraMap B _ ϖ ∈ P := by
      rw [← Ideal.mem_comap, ← Ideal.under_def, IsLocalRing.eq_maximalIdeal this, hm]
      exact Ideal.mem_span_singleton_self ϖ
    refine ‹P.IsPrime›.mem_of_pow_mem d ?_
    rw [abhyankarModelRoot_pow]
    exact P.mul_mem_right _ hϖP
  · intro hx
    have hϖP : ϖ ∈ P.under B := by
      have := P.pow_mem_of_mem hx d (Nat.pos_of_ne_zero hd)
      rw [abhyankarModelRoot_pow] at this
      exact (‹P.IsPrime›.mem_or_mem this).resolve_right fun h ↦ ‹P.IsPrime›.ne_top
        (P.eq_top_of_isUnit_mem h hy)
    apply Ideal.isMaximal_of_isIntegral_of_isMaximal_under (R := B)
    rw [← (IsLocalRing.maximalIdeal.isMaximal B).eq_of_le (Ideal.IsPrime.under B P).ne_top
      (by rwa [hm, Ideal.span_singleton_le_iff_mem])]
    infer_instance

/-- Over a discrete valuation ring with uniformizer `ϖ`, the quotient of the Abhyankar model by `x`
is reduced: it is étale over the residue field. -/
private theorem isReduced_quotient_span_root (hϖ : Irreducible ϖ) (hu : IsUnit u)
    (he : IsUnit (e : B)) (hd : d ≠ 0) :
    IsReduced (abhyankarModel ϖ u e d ⧸ Ideal.span {abhyankarModelRoot ϖ u e d}) := by
  have he₀ : e ≠ 0 := by rintro rfl; simp at he
  have := standardTameCover_etale hu he
  have := (monic_X_pow_sub_C u he₀).finite_adjoinRoot
  have hspan : Ideal.span {algebraMap B (standardTameCover B u e) ϖ} =
      (maximalIdeal B).map (algebraMap B (standardTameCover B u e)) := by
    rw [hϖ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  let Q := standardTameCover B u e ⧸ (maximalIdeal B).map (algebraMap B (standardTameCover B u e))
  have : Algebra.FiniteType (B ⧸ maximalIdeal B) Q :=
    .of_restrictScalars_finiteType B _ _
  let := Ideal.Quotient.field (maximalIdeal B)
  have : IsReduced Q := Algebra.FormallyUnramified.isReduced_of_field (B ⧸ maximalIdeal B) Q
  exact isReduced_of_injective
    ((quotientSpanRootAlgEquiv hu he₀ hd).trans (Ideal.quotientEquivAlgOfEq B hspan)).toRingHom
    (AlgEquiv.injective _)

/-- Over a discrete valuation ring with uniformizer `ϖ`, every maximal ideal of the Abhyankar model
is minimal over `x`. -/
private theorem mem_minimalPrimes_span_root (hϖ : Irreducible ϖ) (hu : IsUnit u) (he : e ≠ 0)
    (hd : d ≠ 0) (M : Ideal (abhyankarModel ϖ u e d)) [M.IsMaximal] :
    M ∈ (Ideal.span {abhyankarModelRoot ϖ u e d}).minimalPrimes := by
  have hx := (isMaximal_of_root_mem hϖ hu he hd M).mp inferInstance
  refine ⟨⟨inferInstance, (Ideal.span_singleton_le_iff_mem M).mpr hx⟩, fun P ⟨_, hP⟩ hPM ↦ ?_⟩
  have := (isMaximal_of_root_mem hϖ hu he hd P).mpr ((Ideal.span_singleton_le_iff_mem P).mp hP)
  exact (this.eq_of_le ‹M.IsMaximal›.ne_top hPM).ge

variable (Dₘ : Type*) [CommRing Dₘ] [Algebra (abhyankarModel ϖ u e d) Dₘ]
  (M : Ideal (abhyankarModel ϖ u e d)) [M.IsMaximal] [IsLocalization.AtPrime Dₘ M] [IsLocalRing Dₘ]

include M in
/-- **`x` is a uniformizer of the Abhyankar model.** Let `B` be a discrete valuation ring with
uniformizer `ϖ`, let `u` be a unit and `e` invertible in `B`, and `d ≠ 0`. At every maximal ideal
of `(B[y]/(y ^ e − u))[x]/(x ^ d − ϖ y)`, the maximal ideal of the local ring is generated by
`x`. -/
theorem maximalIdeal_eq_span_abhyankarModelRoot (hϖ : Irreducible ϖ) (hu : IsUnit u)
    (he : IsUnit (e : B)) (hd : d ≠ 0) :
    maximalIdeal Dₘ = Ideal.span {algebraMap _ Dₘ (abhyankarModelRoot ϖ u e d)} :=
  have he₀ : e ≠ 0 := by rintro rfl; simp at he
  have := isReduced_quotient_span_root hϖ hu he hd
  maximalIdeal_eq_span_algebraMap_of_mem_minimalPrimes Dₘ
    (mem_minimalPrimes_span_root hϖ hu he₀ hd M)

include M in
/-- **The local rings of the Abhyankar model are regular.** Let `B` be a discrete valuation ring
with uniformizer `ϖ`, let `u` be a unit and `e` invertible in `B`, and `d ≠ 0`. The local ring of
`(B[y]/(y ^ e − u))[x]/(x ^ d − ϖ y)` at every maximal ideal is a regular local ring, in
particular a domain. -/
theorem isRegularLocalRing_abhyankarModel (hϖ : Irreducible ϖ) (hu : IsUnit u)
    (he : IsUnit (e : B)) (hd : d ≠ 0) : IsRegularLocalRing Dₘ :=
  have he₀ : e ≠ 0 := by rintro rfl; simp at he
  have := isReduced_quotient_span_root hϖ hu he hd
  have := finite_abhyankarModel (ϖ := ϖ) (u := u) he₀ hd
  isRegularLocalRing_of_mem_minimalPrimes Dₘ
    (abhyankarModelRoot_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hϖ.ne_zero) hu he₀ hd)
    (mem_minimalPrimes_span_root hϖ hu he₀ hd M)

include M in
/-- **The local rings of the Abhyankar model are discrete valuation rings.** Let `B` be a discrete
valuation ring with uniformizer `ϖ`, let `u` be a unit and `e` invertible in `B`, and `d ≠ 0`.
The local ring of `(B[y]/(y ^ e − u))[x]/(x ^ d − ϖ y)` at every maximal ideal is a discrete
valuation ring, with uniformizer `x` by `TauCeti.maximalIdeal_eq_span_abhyankarModelRoot`. It is a
domain by `TauCeti.isRegularLocalRing_abhyankarModel`. -/
theorem isDiscreteValuationRing_abhyankarModel [IsDomain Dₘ] (hϖ : Irreducible ϖ) (hu : IsUnit u)
    (he : IsUnit (e : B)) (hd : d ≠ 0) : IsDiscreteValuationRing Dₘ :=
  have he₀ : e ≠ 0 := by rintro rfl; simp at he
  have := isReduced_quotient_span_root hϖ hu he hd
  have := finite_abhyankarModel (ϖ := ϖ) (u := u) he₀ hd
  isDiscreteValuationRing_of_mem_minimalPrimes Dₘ
    (abhyankarModelRoot_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hϖ.ne_zero) hu he₀ hd)
    (mem_minimalPrimes_span_root hϖ hu he₀ hd M)

end DiscreteValuationRing

section LocalRing

variable [IsLocalRing B] {ϖ u : B} {e d : ℕ} (M : Ideal (abhyankarModel ϖ u e d)) [M.IsMaximal]

/-- **The residue fields of the Abhyankar model are separable.** Let `B` be a local ring, `ϖ` an
element of its maximal ideal, `u` a unit and `e` invertible in `B`, and `d ≠ 0`. The residue field
of `(B[y]/(y ^ e − u))[x]/(x ^ d − ϖ y)` at every maximal ideal over the maximal ideal of `B` is
separable over the residue field of `B`. -/
theorem isSeparable_abhyankarModel_quotient (hϖ : ϖ ∈ maximalIdeal B) (hu : IsUnit u)
    (he : IsUnit (e : B)) (hd : d ≠ 0) [M.LiesOver (maximalIdeal B)] :
    Algebra.IsSeparable (B ⧸ maximalIdeal B) (abhyankarModel ϖ u e d ⧸ M) := by
  have he₀ : e ≠ 0 := by rintro rfl; simp at he
  let := Ideal.Quotient.field (maximalIdeal B)
  let := Ideal.Quotient.field M
  -- `x ^ d = ϖ y` lies in `M` because `ϖ` does.
  have hx : abhyankarModelRoot ϖ u e d ∈ M := by
    refine ‹M.IsMaximal›.isPrime.mem_of_pow_mem d ?_
    rw [abhyankarModelRoot_pow]
    refine M.mul_mem_right _ ?_
    rw [← Ideal.mem_comap, ← Ideal.under_def, ← Ideal.over_def M (maximalIdeal B)]
    exact hϖ
  have hle := (Ideal.span_singleton_le_iff_mem M).mpr hx
  have := formallyUnramified_quotient_span_root (ϖ := ϖ) hu he he₀ hd
  have : Algebra.FormallyUnramified B (abhyankarModel ϖ u e d ⧸ M) :=
    .of_surjective (Ideal.Quotient.factorₐ B hle) (Ideal.Quotient.factor_surjective hle)
  have : Algebra.FormallyUnramified (B ⧸ maximalIdeal B) (abhyankarModel ϖ u e d ⧸ M) :=
    .of_restrictScalars B _ _
  have := finite_abhyankarModel (ϖ := ϖ) (u := u) he₀ hd
  have : Module.Finite (B ⧸ maximalIdeal B) (abhyankarModel ϖ u e d ⧸ M) := inferInstance
  exact Algebra.FormallyUnramified.isSeparable _ _

end LocalRing


end TauCeti
