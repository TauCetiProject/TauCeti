module

public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.DiscreteValuationRing.TFAE
import Mathlib.RingTheory.Ideal.Quotient.Nilpotent
import TauCeti.RingTheory.Ideal.MinimalPrime.Localization
import TauCeti.RingTheory.RegularLocalRing.Basic

/-!
# Localizing at a prime minimal over a reduced principal divisor

Let `A` be a Noetherian ring and `f ∈ A` a nonzerodivisor such that `A ⧸ (f)` is reduced, and let
`𝔭` be a prime of `A` minimal over `f`. Then the localization `A_𝔭` is a discrete valuation ring
with uniformizer `f`. This is one of the assertions of Stacks, Example 58.31.4, about the base
`Spec A` of a standard tamely ramified cover `A[x] ⧸ (x ^ e - f)`: the codimension-one points of
`V(f)` have discrete valuation rings as local rings, with local equation `f`.

The first step holds without finiteness hypotheses: `f` generates the maximal ideal of `A_𝔭`,
since `𝔭` is minimal over the radical ideal `(f)`
(`IsLocalization.AtPrime.map_eq_maximalIdeal_of_mem_minimalPrimes`). A Noetherian local ring
whose maximal ideal is generated by a nonzerodivisor is a regular local ring
(`TauCeti.IsRegularLocalRing.of_maximalIdeal_eq_span_singleton`), hence a domain.

## Main results

All statements are about a localization `Aₚ` of `A` at a prime `𝔭` minimal over `f`.

* `TauCeti.maximalIdeal_eq_span_algebraMap_of_mem_minimalPrimes`: if `A ⧸ (f)` is reduced, the
  maximal ideal of `Aₚ` is generated by `f`.
* `TauCeti.isRegularLocalRing_of_mem_minimalPrimes`: if moreover `A` is Noetherian and `f` is a
  nonzerodivisor, `Aₚ` is a regular local ring, in particular a domain.
* `TauCeti.isDiscreteValuationRing_of_mem_minimalPrimes` and
  `TauCeti.irreducible_algebraMap_of_mem_minimalPrimes`: `Aₚ` is a discrete valuation ring with
  uniformizer `f`.

## References

* [Stacks Project, Example 58.31.4](https://stacks.math.columbia.edu/tag/0EYF).
-/

public section

namespace TauCeti

open _root_.IsLocalRing Ideal

variable {A : Type*} [CommRing A] {f : A} {𝔭 : Ideal A} [𝔭.IsPrime] (Aₚ : Type*) [CommRing Aₚ]
  [Algebra A Aₚ] [IsLocalization.AtPrime Aₚ 𝔭] [IsLocalRing Aₚ]

/-- If `A ⧸ (f)` is reduced, then `f` generates the maximal ideal of the localization of `A` at a
prime minimal over `f`. -/
theorem maximalIdeal_eq_span_algebraMap_of_mem_minimalPrimes [IsReduced (A ⧸ span {f})]
    (h𝔭 : 𝔭 ∈ (span {f}).minimalPrimes) : maximalIdeal Aₚ = span {algebraMap A Aₚ f} := by
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal_of_mem_minimalPrimes Aₚ
    ((isRadical_iff_quotient_reduced _).mpr ‹_›) h𝔭, map_span, Set.image_singleton]

/-- Let `A` be a Noetherian ring and `f ∈ A` a nonzerodivisor with `A ⧸ (f)` reduced. Then the
localization of `A` at a prime minimal over `f` is a regular local ring, in particular a domain. -/
theorem isRegularLocalRing_of_mem_minimalPrimes [IsNoetherianRing A] [IsReduced (A ⧸ span {f})]
    (hf : f ∈ nonZeroDivisors A) (h𝔭 : 𝔭 ∈ (span {f}).minimalPrimes) : IsRegularLocalRing Aₚ :=
  have := IsLocalization.isNoetherianRing 𝔭.primeCompl Aₚ ‹_›
  IsRegularLocalRing.of_maximalIdeal_eq_span_singleton
    (IsLocalization.nonZeroDivisors_le_comap 𝔭.primeCompl Aₚ hf)
    (maximalIdeal_eq_span_algebraMap_of_mem_minimalPrimes Aₚ h𝔭)

/-- Let `A` be a ring and `f ∈ A` a nonzerodivisor with `A ⧸ (f)` reduced. If the localization of
`A` at a prime minimal over `f` is a domain, then `f` is a uniformizer of it. For `A` Noetherian
the localization is always a domain, by `TauCeti.isRegularLocalRing_of_mem_minimalPrimes`. -/
theorem irreducible_algebraMap_of_mem_minimalPrimes [IsDomain Aₚ] [IsReduced (A ⧸ span {f})]
    (hf : f ∈ nonZeroDivisors A) (h𝔭 : 𝔭 ∈ (span {f}).minimalPrimes) :
    Irreducible (algebraMap A Aₚ f) :=
  IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _
    (nonZeroDivisors.ne_zero (IsLocalization.nonZeroDivisors_le_comap 𝔭.primeCompl Aₚ hf))
    (maximalIdeal_eq_span_algebraMap_of_mem_minimalPrimes Aₚ h𝔭)

/-- **The local ring at a prime minimal over a reduced principal divisor is a discrete valuation
ring.** Let `A` be a Noetherian ring and `f ∈ A` a nonzerodivisor with `A ⧸ (f)` reduced. Then the
localization of `A` at a prime minimal over `f` is a discrete valuation ring; its uniformizer is
`f`, by `TauCeti.irreducible_algebraMap_of_mem_minimalPrimes`. The localization is a domain by
`TauCeti.isRegularLocalRing_of_mem_minimalPrimes`. -/
@[stacks 0EYF]
theorem isDiscreteValuationRing_of_mem_minimalPrimes [IsDomain Aₚ] [IsNoetherianRing A]
    [IsReduced (A ⧸ span {f})] (hf : f ∈ nonZeroDivisors A)
    (h𝔭 : 𝔭 ∈ (span {f}).minimalPrimes) : IsDiscreteValuationRing Aₚ := by
  have := IsLocalization.isNoetherianRing 𝔭.primeCompl Aₚ ‹_›
  have hm := maximalIdeal_eq_span_algebraMap_of_mem_minimalPrimes Aₚ h𝔭
  have hnf : ¬IsField Aₚ := by
    rw [isField_iff_maximalIdeal_eq, hm, span_singleton_eq_bot]
    exact nonZeroDivisors.ne_zero (IsLocalization.nonZeroDivisors_le_comap 𝔭.primeCompl Aₚ hf)
  exact ((IsDiscreteValuationRing.TFAE Aₚ hnf).out 1 5).mpr
    (⟨_, hm⟩ : (maximalIdeal Aₚ).IsPrincipal)

end TauCeti
