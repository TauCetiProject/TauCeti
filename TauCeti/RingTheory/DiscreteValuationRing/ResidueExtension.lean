module

public import Mathlib.RingTheory.AdicCompletion.LocalRing
public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import TauCeti.RingTheory.LocalRing.ResidueField.Extension
public import TauCeti.RingTheory.RegularLocalRing.Basic
import TauCeti.RingTheory.AdicCompletion.Flat.LocalRing
import TauCeti.RingTheory.AdicCompletion.Noetherian
import TauCeti.RingTheory.DiscreteValuationRing.Etale
import TauCeti.RingTheory.RegularLocalRing.Flat

/-!
# Completed local and discrete-valuation-ring extensions with prescribed residue field

Completing `TauCeti.IsLocalRing.ResidueExtension R L` along its maximal ideal produces a complete
faithfully flat local `R`-algebra `CompletedResidueExtension R L` over any Noetherian local ring
`R` and any field extension `L` of `ResidueField R` (*ÉGA III*, Chap. 0, Proposition 10.3.1,
completion remark):

* `CompletedResidueExtension R L` is a Noetherian complete local ring whose maximal ideal is
  generated by `maximalIdeal R` and whose residue field is `ResidueField R`-isomorphic to `L`.
* When `R` is a regular local ring, `CompletedResidueExtension R L` is a regular local ring (and in
  particular an integral domain).
* When `R` is a discrete valuation ring, `CompletedResidueExtension R L` is a complete discrete
  valuation ring in which every uniformizer of `R` remains a uniformizer. Taking
  `L = AlgebraicClosure (ResidueField R)` enlarges the residue field of any discrete valuation ring
  to an algebraically closed field without ramifying the base.

## Main definitions and results

* `TauCeti.IsLocalRing.CompletedResidueExtension R L`: the maximal-ideal completion of
  `ResidueExtension R L`.
* `TauCeti.IsLocalRing.CompletedResidueExtension.maximalIdeal_eq_map`: over a Noetherian local base
  `R`, the maximal ideal of `CompletedResidueExtension R L` is generated by `maximalIdeal R`.
* `TauCeti.IsLocalRing.CompletedResidueExtension.residueFieldEquiv`: `ResidueField R`-algebra
  isomorphism `ResidueField (CompletedResidueExtension R L) ≃ₐ[ResidueField R] L`.
* `TauCeti.IsLocalRing.CompletedResidueExtension.instIsRegularLocalRing`: regularity ascends from
  `R` to `CompletedResidueExtension R L`.
* `TauCeti.IsLocalRing.CompletedResidueExtension.instIsDiscreteValuationRing` and
  `TauCeti.IsLocalRing.CompletedResidueExtension.irreducible_algebraMap`: over a discrete valuation
  ring `R`, `CompletedResidueExtension R L` is a complete discrete valuation ring preserving every
  uniformizer of `R`.

## References

* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique III*, Chapitre 0,
  Proposition 10.3.1.
-/

public section

noncomputable section

universe u v

open IsLocalRing Polynomial

namespace TauCeti.IsLocalRing

/-- The maximal-ideal adic completion of `ResidueExtension R L`. Over a Noetherian local ring `R`
this is a complete Noetherian faithfully flat local `R`-algebra with residue field `L` and maximal
ideal generated by `maximalIdeal R`. -/
abbrev CompletedResidueExtension (R : Type u) [CommRing R] [IsLocalRing R]
    (L : Type v) [Field L] [Algebra (ResidueField R) L] : Type (max u v) :=
  AdicCompletion (maximalIdeal (ResidueExtension R L)) (ResidueExtension R L)

namespace CompletedResidueExtension

section LocalRing

variable (R : Type u) [CommRing R] [IsLocalRing R]
variable (L : Type v) [Field L] [Algebra (ResidueField R) L]

/-- If `maximalIdeal R` is finitely generated, `CompletedResidueExtension R L` is Noetherian. -/
theorem isNoetherianRing_of_fg (hR : (maximalIdeal R).FG) :
    IsNoetherianRing (CompletedResidueExtension R L) :=
  IsLocalRing.isNoetherianRing_adicCompletion_of_fg (ResidueExtension.maximalIdeal_fg R L hR)

/-- Over a Noetherian local base `R`, `CompletedResidueExtension R L` is Noetherian. -/
instance instIsNoetherianRing [IsNoetherianRing R] :
    IsNoetherianRing (CompletedResidueExtension R L) :=
  isNoetherianRing_of_fg R L (maximalIdeal R).fg_of_isNoetherianRing

/-- If `maximalIdeal R` is finitely generated, `CompletedResidueExtension R L` is a local ring. -/
theorem isLocalRing_of_fg (hR : (maximalIdeal R).FG) :
    IsLocalRing (CompletedResidueExtension R L) :=
  AdicCompletion.isLocalRing_of_fg (ResidueExtension.maximalIdeal_fg R L hR)

/-- Over a Noetherian local base `R`, `CompletedResidueExtension R L` is a local ring. -/
instance instIsLocalRing [IsNoetherianRing R] :
    IsLocalRing (CompletedResidueExtension R L) :=
  isLocalRing_of_fg R L (maximalIdeal R).fg_of_isNoetherianRing

/-- Over a Noetherian local base `R`, the completion map from `ResidueExtension R L` is local. -/
instance instIsLocalHom_residueExtension [IsNoetherianRing R] :
    IsLocalHom (algebraMap (ResidueExtension R L) (CompletedResidueExtension R L)) :=
  AdicCompletion.algebraMap_isLocalHom_of_fg
    (ResidueExtension.maximalIdeal_fg R L (maximalIdeal R).fg_of_isNoetherianRing)

/-- Over a Noetherian local base `R`, the maximal ideal of `CompletedResidueExtension R L` is
generated by `maximalIdeal R`. -/
theorem maximalIdeal_eq_map [IsNoetherianRing R] :
    maximalIdeal (CompletedResidueExtension R L) =
      (maximalIdeal R).map (algebraMap R (CompletedResidueExtension R L)) :=
  AdicCompletion.maximalIdeal_eq_map_base_of_map_maximalIdeal_eq
    (maximalIdeal R).fg_of_isNoetherianRing (ResidueExtension.maximalIdeal_eq_map R L).symm

/-- Over a Noetherian local base `R`, the structure map `R → CompletedResidueExtension R L` is a
local homomorphism. -/
instance instIsLocalHom [IsNoetherianRing R] :
    IsLocalHom (algebraMap R (CompletedResidueExtension R L)) :=
  AdicCompletion.isLocalHom_algebraMap_base_of_map_maximalIdeal_eq
    (maximalIdeal R).fg_of_isNoetherianRing (ResidueExtension.maximalIdeal_eq_map R L).symm

/-- Over a Noetherian local base `R`, `CompletedResidueExtension R L` is adically complete with
respect to its maximal ideal. -/
instance instIsAdicComplete [IsNoetherianRing R] :
    IsAdicComplete (maximalIdeal (CompletedResidueExtension R L))
      (CompletedResidueExtension R L) :=
  AdicCompletion.isAdicComplete_of_fg
    (ResidueExtension.maximalIdeal_fg R L (maximalIdeal R).fg_of_isNoetherianRing)

/-- Over a Noetherian local base `R`, `CompletedResidueExtension R L` is flat over `R`. -/
instance instFlat [IsNoetherianRing R] :
    Module.Flat R (CompletedResidueExtension R L) :=
  AdicCompletion.flat_of_map_maximalIdeal_eq (ResidueExtension.maximalIdeal_eq_map R L).symm

/-- Over a Noetherian local base `R`, `CompletedResidueExtension R L` is faithfully flat over `R`.
-/
instance instFaithfullyFlat [IsNoetherianRing R] :
    Module.FaithfullyFlat R (CompletedResidueExtension R L) :=
  Module.FaithfullyFlat.of_flat_of_isLocalHom

/-- Canonical `ResidueField R`-algebra isomorphism
`ResidueField (CompletedResidueExtension R L) ≃ₐ[ResidueField R] L`. -/
def residueFieldEquiv [IsNoetherianRing R] :
    ResidueField (CompletedResidueExtension R L) ≃ₐ[ResidueField R] L := by
  have hbij := AdicCompletion.residueField_map_bijective_of_fg
    (ResidueExtension.maximalIdeal_fg R L (maximalIdeal R).fg_of_isNoetherianRing)
  let eC : ResidueField (ResidueExtension R L) ≃+*
      ResidueField (CompletedResidueExtension R L) :=
    RingEquiv.ofBijective
      (ResidueField.map (algebraMap (ResidueExtension R L) (CompletedResidueExtension R L))) hbij
  refine AlgEquiv.ofRingEquiv
    (f := eC.symm.trans (ResidueExtension.residueFieldEquiv R L).toRingEquiv) fun x ↦ ?_
  obtain ⟨r, rfl⟩ := residue_surjective x
  change (ResidueExtension.residueFieldEquiv R L)
      (eC.symm (ResidueField.map (algebraMap R (CompletedResidueExtension R L)) (residue R r))) =
    algebraMap (ResidueField R) L (residue R r)
  have heC : eC (ResidueField.map (algebraMap R (ResidueExtension R L)) (residue R r)) =
      ResidueField.map (algebraMap R (CompletedResidueExtension R L)) (residue R r) := by
    change ResidueField.map (algebraMap (ResidueExtension R L) (CompletedResidueExtension R L))
        (ResidueField.map (algebraMap R (ResidueExtension R L)) (residue R r)) = _
    rw [ResidueField.map_residue, ResidueField.map_residue, ResidueField.map_residue,
      ← IsScalarTower.algebraMap_apply]
  rw [← heC, eC.symm_apply_apply]
  exact (ResidueExtension.residueFieldEquiv R L).commutes (residue R r)

/-- When `L` is algebraically closed, so is `ResidueField (CompletedResidueExtension R L)`. -/
instance instIsAlgClosedResidueField [IsNoetherianRing R] [IsAlgClosed L] :
    IsAlgClosed (ResidueField (CompletedResidueExtension R L)) :=
  IsAlgClosed.of_ringEquiv _ _ (RingEquiv.ofBijective _
    (AdicCompletion.residueField_map_bijective_of_fg
      (ResidueExtension.maximalIdeal_fg R L (maximalIdeal R).fg_of_isNoetherianRing)))

end LocalRing

section RegularAndDVR

variable (R : Type u) [CommRing R]

/-- When `R` is a regular local ring, `CompletedResidueExtension R L` is a regular local ring
(and hence an integral domain via `IsRegularLocalRing.isDomain`). -/
instance instIsRegularLocalRing [IsRegularLocalRing R]
    (L : Type v) [Field L] [Algebra (ResidueField R) L] :
    IsRegularLocalRing (CompletedResidueExtension R L) :=
  IsRegularLocalRing.of_flat_of_map_maximalIdeal_eq (maximalIdeal_eq_map R L).symm

/-- When `R` is a discrete valuation ring, `CompletedResidueExtension R L` is a complete discrete
valuation ring. -/
instance instIsDiscreteValuationRing [IsDomain R] [IsDiscreteValuationRing R]
    (L : Type v) [Field L] [Algebra (ResidueField R) L] :
    IsDiscreteValuationRing (CompletedResidueExtension R L) :=
  IsDiscreteValuationRing.of_flat_of_map_maximalIdeal_eq (maximalIdeal_eq_map R L).symm

/-- Every uniformizer of a discrete valuation ring `R` remains a uniformizer in
`CompletedResidueExtension R L`. -/
theorem irreducible_algebraMap {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (L : Type v) [Field L] [Algebra (ResidueField R) L] {π : R} (hπ : Irreducible π) :
    Irreducible (algebraMap R (CompletedResidueExtension R L) π) :=
  IsDiscreteValuationRing.irreducible_algebraMap_of_map_maximalIdeal_eq
    (maximalIdeal_eq_map R L).symm hπ

end RegularAndDVR

end CompletedResidueExtension

end TauCeti.IsLocalRing
