import TauCeti.RingTheory.Polynomial.Eisenstein.DiscreteValuationRing

/-!
# Extensions of a discrete valuation ring generated by an Eisenstein root

Let `A` be a discrete valuation ring and `B` a nontrivial `A`-algebra generated by a root `x` of
a monic polynomial `f` that is Eisenstein at the maximal ideal of `A`. Then `B` is a local ring
with maximal ideal `x B` and the residue field of `B` is that of `A`. If moreover `B` is a domain
and `A → B` is injective, then `B` is a discrete valuation ring with uniformizer `x`, in which the
uniformizer of `A` is `x ^ deg f` up to a unit. So `B / A` has ramification index `deg f` and
inertia degree one.

The point is that `f ≡ X ^ deg f` modulo the maximal ideal `𝔪` of `A`, so `x ^ deg f ∈ 𝔪 B` and
`x` lies in every maximal ideal of `B`; and `B / x B` is a quotient of `A / 𝔪`, because every
element of `B` is a polynomial in `x` and the constant coefficient `f(0)`, a uniformizer of `A`,
lies in `x B`. No completeness of `A` and no separability of `f` is needed. Applied to `X ^ n - ϖ`
for a uniformizer `ϖ`, this describes the integral closure of `A` in the field obtained by
adjoining an `n`-th root of `ϖ` (`TauCeti.RingTheory.DiscreteValuationRing.Kummer`).

## Main results

* `Polynomial.IsEisensteinAt.eq_span_singleton_of_isMaximal`: every maximal ideal of `B` is `x B`.
* `Polynomial.IsEisensteinAt.isLocalRing_of_adjoin_eq_top`: `B` is a local ring.
* `Polynomial.IsEisensteinAt.isDiscreteValuationRing_of_adjoin_eq_top`: if `A → B` is injective,
  `B` is a discrete valuation ring.
* `Polynomial.IsEisensteinAt.irreducible_of_adjoin_eq_top`: `x` is a uniformizer of `B`.
* `Polynomial.IsEisensteinAt.ramificationIdx_eq_natDegree`: the ramification index of the maximal
  ideal of `B` over `A` is the degree of `f`.
* `Polynomial.IsEisensteinAt.inertiaDeg_eq_one`: its inertia degree over `A` is one.

## References

* J.-P. Serre, *Corps locaux*, Chapter I, §6, Proposition 17.
* [Stacks Project, Lemma 15.116.2](https://stacks.math.columbia.edu/tag/09EV), parts (2)–(4).
-/

public section

open IsLocalRing Polynomial

namespace Polynomial.IsEisensteinAt

variable {A B : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
  [CommRing B] [Algebra A B] {f : A[X]} {x : B}

omit [IsDomain A] [IsDiscreteValuationRing A] in
/-- A root of a monic polynomial makes it nonconstant. -/
private theorem natDegree_pos [Nontrivial B] (hmo : f.Monic) (hx : aeval x f = 0) :
    0 < f.natDegree := by
  refine Nat.pos_of_ne_zero fun h ↦ ?_
  rw [hmo.natDegree_eq_zero.mp h, map_one] at hx
  exact one_ne_zero hx

/-- The constant coefficient of `f` is a uniformizer of `A`. -/
private theorem irreducible_coeff_zero_of_aeval_eq_zero [Nontrivial B]
    (hf : f.IsEisensteinAt (maximalIdeal A)) (hmo : f.Monic) (hx : aeval x f = 0) :
    Irreducible (f.coeff 0) :=
  hf.irreducible_coeff_zero (natDegree_pos hmo hx)

omit [IsDomain A] [IsDiscreteValuationRing A] in
/-- The constant coefficient `f(0)` of `f` becomes divisible by the root `x`. -/
private theorem dvd_algebraMap_coeff_zero (hx : aeval x f = 0) :
    x ∣ algebraMap A B (f.coeff 0) := by
  simpa [hx] using (_root_.map_dvd (aeval x) (X_dvd_sub_C (p := f))).neg_right

/-- Writing `f = X ^ deg f + f(0) g` with `g(0) = 1`, which is possible since every non-leading
coefficient of `f` is divisible by the uniformizer `f(0)`, gives `x ^ deg f = -f(0) g(x)`. -/
private theorem exists_pow_natDegree_eq [Nontrivial B] (hf : f.IsEisensteinAt (maximalIdeal A))
    (hmo : f.Monic) (hx : aeval x f = 0) :
    ∃ g : A[X], g.coeff 0 = 1 ∧
      x ^ f.natDegree = -(algebraMap A B (f.coeff 0) * aeval x g) := by
  have hdeg := natDegree_pos hmo hx
  have hirr := irreducible_coeff_zero_of_aeval_eq_zero hf hmo hx
  have hdvd : C (f.coeff 0) ∣ f - X ^ f.natDegree := by
    refine C_dvd_iff_dvd_coeff _ _ |>.mpr fun i ↦ ?_
    rcases lt_trichotomy i f.natDegree with hi | rfl | hi
    · have : (f - X ^ f.natDegree).coeff i = f.coeff i := by simp [coeff_X_pow, hi.ne]
      rw [this, ← Ideal.mem_span_singleton, ← hirr.maximalIdeal_eq]
      exact hf.mem hi
    · simp [hmo.coeff_natDegree]
    · simp [coeff_X_pow, hi.ne', coeff_eq_zero_of_natDegree_lt hi]
  obtain ⟨g, hg⟩ := hdvd
  refine ⟨g, ?_, ?_⟩
  · have := congrArg (coeff · 0) hg
    simp only [coeff_sub, coeff_X_pow, hdeg.ne, ite_false, sub_zero, coeff_C_mul] at this
    exact (mul_eq_left₀ hirr.ne_zero).mp this.symm
  · have := congrArg (aeval x) hg
    rw [map_sub, hx, map_pow, aeval_X, map_mul, aeval_C, zero_sub] at this
    rw [← this, neg_neg]

omit [IsDomain A] [IsDiscreteValuationRing A] in
/-- Every element of `B` is `p(x)` for some polynomial `p` over `A`. -/
private theorem exists_aeval_eq (hadj : Algebra.adjoin A {x} = ⊤) (z : B) :
    ∃ p : A[X], aeval x p = z := by
  have hz : z ∈ Algebra.adjoin A {x} := hadj ▸ Algebra.mem_top
  rwa [Algebra.adjoin_singleton_eq_range_aeval] at hz

omit [IsDomain A] [IsDiscreteValuationRing A] in
/-- `B` is a finite `A`-module. -/
private theorem moduleFinite (hmo : f.Monic) (hx : aeval x f = 0)
    (hadj : Algebra.adjoin A {x} = ⊤) : Module.Finite A B :=
  have hint : IsIntegral A x := ⟨f, hmo, by rwa [← aeval_def]⟩
  ⟨by simpa [hadj] using hint.fg_adjoin_singleton⟩

/-- **Every maximal ideal is generated by the Eisenstein root.** If `B` is generated over the
discrete valuation ring `A` by a root `x` of a monic polynomial which is Eisenstein at the maximal
ideal of `A`, then every maximal ideal of `B` is `x B`. -/
theorem eq_span_singleton_of_isMaximal [Nontrivial B] (hf : f.IsEisensteinAt (maximalIdeal A))
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin A {x} = ⊤) (P : Ideal B)
    [P.IsMaximal] : P = Ideal.span {x} := by
  have := moduleFinite hmo hx hadj
  have hspan := (irreducible_coeff_zero_of_aeval_eq_zero hf hmo hx).maximalIdeal_eq
  -- `P` lies over the maximal ideal of `A`, as `B` is integral over `A`.
  have hunder : P.comap (algebraMap A B) = maximalIdeal A :=
    eq_maximalIdeal (Ideal.IsMaximal.under A P)
  have hc0 : algebraMap A B (f.coeff 0) ∈ P := by
    rw [← Ideal.mem_comap, hunder, hspan]
    exact Ideal.mem_span_singleton_self _
  -- `x ^ deg f = -f(0) g(x)` lies in `P`, hence so does `x`.
  have hxP : x ∈ P := by
    obtain ⟨g, -, hg⟩ := exists_pow_natDegree_eq hf hmo hx
    refine (Ideal.IsMaximal.isPrime ‹_›).mem_of_pow_mem f.natDegree ?_
    rw [hg]
    exact P.neg_mem_iff.mpr (P.mul_mem_right _ hc0)
  refine le_antisymm (fun z hz ↦ ?_) ((Ideal.span_singleton_le_iff_mem P).mpr hxP)
  -- Write `z = p(x)`; then `p(0) ∈ 𝔪 = f(0) A`, and `x` divides both `z - p(0)` and `f(0)`.
  obtain ⟨p, rfl⟩ := exists_aeval_eq hadj z
  have hsub : x ∣ aeval x p - algebraMap A B (p.coeff 0) := by
    simpa using _root_.map_dvd (aeval x) (X_dvd_sub_C (p := p))
  have hp0 : p.coeff 0 ∈ maximalIdeal A := by
    rw [← hunder, Ideal.mem_comap]
    simpa using P.sub_mem hz (P.mem_of_dvd hsub hxP)
  rw [hspan, Ideal.mem_span_singleton] at hp0
  rw [Ideal.mem_span_singleton]
  simpa using dvd_add hsub
    ((dvd_algebraMap_coeff_zero hx).trans (_root_.map_dvd (algebraMap A B) hp0))

/-- The Eisenstein root generates a maximal ideal of `B`. -/
theorem isMaximal_span_singleton [Nontrivial B] (hf : f.IsEisensteinAt (maximalIdeal A))
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin A {x} = ⊤) :
    (Ideal.span {x}).IsMaximal := by
  obtain ⟨P, hP⟩ := Ideal.exists_maximal B
  exact eq_span_singleton_of_isMaximal hf hmo hx hadj P ▸ hP

/-- **An algebra generated by an Eisenstein root is local.** If a nontrivial ring `B` is generated
over the discrete valuation ring `A` by a root of a monic polynomial which is Eisenstein at the
maximal ideal of `A`, then `B` is a local ring. -/
theorem isLocalRing_of_adjoin_eq_top [Nontrivial B] (hf : f.IsEisensteinAt (maximalIdeal A))
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin A {x} = ⊤) : IsLocalRing B :=
  .of_unique_max_ideal ⟨_, isMaximal_span_singleton hf hmo hx hadj,
    fun _ _ ↦ eq_span_singleton_of_isMaximal hf hmo hx hadj _⟩

/-- **An algebra generated by an Eisenstein root has the residue field of `A`.** Every maximal
ideal of `B` has inertia degree one over `A`. -/
theorem inertiaDeg_eq_one [Nontrivial B] (hf : f.IsEisensteinAt (maximalIdeal A)) (hmo : f.Monic)
    (hx : aeval x f = 0) (hadj : Algebra.adjoin A {x} = ⊤) (P : Ideal B) [P.IsMaximal] :
    P.inertiaDeg A = 1 := by
  have := moduleFinite hmo hx hadj
  have : P.LiesOver (maximalIdeal A) :=
    ⟨(eq_maximalIdeal (Ideal.IsMaximal.under A P)).symm⟩
  let := Ideal.Quotient.field (maximalIdeal A)
  rw [Ideal.inertiaDeg_eq_of_isMaximal (maximalIdeal A) P,
    ← Subalgebra.bot_eq_top_iff_finrank_eq_one, ← Algebra.range_ofId, AlgHom.range_eq_top]
  -- The class of `p(x)` modulo `P = x B` is that of the constant `p(0)`.
  intro z
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨p, rfl⟩ := exists_aeval_eq hadj z
  refine ⟨Ideal.Quotient.mk _ (p.coeff 0), ?_⟩
  rw [Algebra.ofId_apply, Ideal.Quotient.algebraMap_mk_of_liesOver, Eq.comm,
    Ideal.Quotient.eq, eq_span_singleton_of_isMaximal hf hmo hx hadj P, Ideal.mem_span_singleton]
  simpa using _root_.map_dvd (aeval x) (X_dvd_sub_C (p := p))

/-- The Eisenstein root is nonzero when `A → B` is injective. -/
private theorem ne_zero [Nontrivial B] [FaithfulSMul A B] (hf : f.IsEisensteinAt (maximalIdeal A))
    (hmo : f.Monic) (hx : aeval x f = 0) : x ≠ 0 := by
  rintro rfl
  have := dvd_algebraMap_coeff_zero hx
  rw [zero_dvd_iff, map_eq_zero_iff _ (FaithfulSMul.algebraMap_injective A B)] at this
  exact (irreducible_coeff_zero_of_aeval_eq_zero hf hmo hx).ne_zero this

/-- **An algebra generated by an Eisenstein root is a discrete valuation ring.** If a domain `B`
containing the discrete valuation ring `A` is generated over `A` by a root of a monic polynomial
which is Eisenstein at the maximal ideal of `A`, then `B` is a discrete valuation ring. -/
theorem isDiscreteValuationRing_of_adjoin_eq_top [IsDomain B] [FaithfulSMul A B]
    (hf : f.IsEisensteinAt (maximalIdeal A)) (hmo : f.Monic) (hx : aeval x f = 0)
    (hadj : Algebra.adjoin A {x} = ⊤) : IsDiscreteValuationRing B := by
  have := moduleFinite hmo hx hadj
  have := IsNoetherianRing.of_finite A B
  have := isLocalRing_of_adjoin_eq_top hf hmo hx hadj
  have hmax : maximalIdeal B = Ideal.span {x} :=
    eq_span_singleton_of_isMaximal hf hmo hx hadj _
  have hfield : ¬IsField B := by
    rw [isField_iff_maximalIdeal_eq, hmax, Ideal.span_singleton_eq_bot]
    exact ne_zero hf hmo hx
  have : (maximalIdeal B).IsPrincipal := ⟨x, hmax⟩
  exact ((IsDiscreteValuationRing.TFAE B hfield).out 1 5).mpr this

/-- **An Eisenstein root is a uniformizer.** If a domain `B` containing the discrete valuation
ring `A` is generated over `A` by a root `x` of a monic polynomial which is Eisenstein at the
maximal ideal of `A`, then `x` is irreducible in `B`, that is, a uniformizer of `B`. -/
theorem irreducible_of_adjoin_eq_top [IsDomain B] [FaithfulSMul A B]
    (hf : f.IsEisensteinAt (maximalIdeal A)) (hmo : f.Monic) (hx : aeval x f = 0)
    (hadj : Algebra.adjoin A {x} = ⊤) : Irreducible x :=
  have := isLocalRing_of_adjoin_eq_top hf hmo hx hadj
  IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal x (ne_zero hf hmo hx)
    (eq_span_singleton_of_isMaximal hf hmo hx hadj _)

/-- **An algebra generated by an Eisenstein root is totally ramified.** If a domain `B` containing
the discrete valuation ring `A` is generated over `A` by a root of a monic polynomial `f` which is
Eisenstein at the maximal ideal of `A`, then every maximal ideal of `B` has ramification index
`deg f` over `A`. -/
theorem ramificationIdx_eq_natDegree [IsDomain B] [FaithfulSMul A B]
    (hf : f.IsEisensteinAt (maximalIdeal A)) (hmo : f.Monic) (hx : aeval x f = 0)
    (hadj : Algebra.adjoin A {x} = ⊤) (P : Ideal B) [P.IsMaximal] :
    P.ramificationIdx A = f.natDegree := by
  have := isLocalRing_of_adjoin_eq_top hf hmo hx hadj
  have := isDiscreteValuationRing_of_adjoin_eq_top hf hmo hx hadj
  have := moduleFinite hmo hx hadj
  have : P.LiesOver (maximalIdeal A) :=
    ⟨(eq_maximalIdeal (Ideal.IsMaximal.under A P)).symm⟩
  have hP : P = Ideal.span {x} := eq_span_singleton_of_isMaximal hf hmo hx hadj P
  -- `g(x)` is a unit, since `g(x) - 1 = g(x) - g(0)` lies in the maximal ideal `x B`.
  obtain ⟨g, hg0, hg⟩ := exists_pow_natDegree_eq hf hmo hx
  have hunit : IsUnit (aeval x g) := by
    by_contra hg'
    have hmem : aeval x g - 1 ∈ maximalIdeal B := by
      rw [← eq_maximalIdeal ‹P.IsMaximal›, hP, Ideal.mem_span_singleton]
      simpa [hg0] using _root_.map_dvd (aeval x) (X_dvd_sub_C (p := g))
    exact (maximalIdeal.isMaximal B).ne_top <| (Ideal.eq_top_iff_one _).mpr <| by
      simpa using (maximalIdeal B).sub_mem ((mem_maximalIdeal _).mpr hg') hmem
  -- So the maximal ideal of `A` generates `(x B) ^ deg f`.
  have hmap : (maximalIdeal A).map (algebraMap A B) = P ^ f.natDegree := by
    rw [(irreducible_coeff_zero_of_aeval_eq_zero hf hmo hx).maximalIdeal_eq, Ideal.map_span,
      Set.image_singleton, hP, Ideal.span_singleton_pow, Ideal.span_singleton_eq_span_singleton]
    exact ⟨hunit.neg.unit, by simp [hg]⟩
  have hP0 : P ≠ ⊥ := by rw [hP, ne_eq, Ideal.span_singleton_eq_bot]; exact ne_zero hf hmo hx
  rw [← Ideal.ramificationIdx'_eq_ramificationIdx' (maximalIdeal A) P
    (hmap ▸ pow_ne_zero _ hP0)]
  exact Ideal.ramificationIdx'_spec hmap.le (hmap ▸ (Ideal.pow_succ_lt_pow hP0 _).not_ge)

end Polynomial.IsEisensteinAt
