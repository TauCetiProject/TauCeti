/-!
# Extensions of a discrete valuation ring generated by an Eisenstein root

Let `A` be a discrete valuation ring and `B` a nontrivial `A`-algebra generated by a root `x` of
a polynomial `f` that is Eisenstein at the maximal ideal of `A`. Then `B` is a local ring
with maximal ideal `x B` and the residue field of `B` is that of `A`. If moreover `B` is a domain
and `A → B` is injective, then `B` is a discrete valuation ring with uniformizer `x`, in which the
uniformizer of `A` is `x ^ deg f` up to a unit. So `B / A` has ramification index `deg f` and
inertia degree one, the normalized additive valuation on `A` scales by `deg f` in `B`, and any
polynomial of degree `< deg f` evaluated at `x` has valuation determined by the valuations of its
coefficients. When `E = K(α)` is generated over `K = Frac A` by a root `α` of `f`, `A[α]` is the
integral closure of `A` in `E` and is a discrete valuation ring.

The point is that `f ≡ X ^ deg f` modulo the maximal ideal `𝔪` of `A`, so `x ^ deg f ∈ 𝔪 B` and
`x` lies in every maximal ideal of `B`; and `B / x B` is a quotient of `A / 𝔪`, because every
element of `B` is a polynomial in `x` and the constant coefficient `f(0)`, a uniformizer of `A`,
lies in `x B`. No completeness of `A` and no separability of `f` is needed. Applied to `X ^ n - ϖ`
for a uniformizer `ϖ`, this describes the integral closure of `A` in the field obtained by
adjoining an `n`-th root of `ϖ` (`TauCeti.RingTheory.DiscreteValuationRing.Kummer`).

## Main results

* `Polynomial.IsEisensteinAt.eq_span_singleton_of_isMaximal`: every maximal ideal of `B` is `x B`.
* `Polynomial.IsEisensteinAt.isLocalRing_of_adjoin_eq_top`: `B` is a local ring.
* `Polynomial.IsEisensteinAt.isDiscreteValuationRing_of_adjoin_eq_top`: if `A → B` is injective,
  `B` is a discrete valuation ring.
* `Polynomial.IsEisensteinAt.irreducible_of_adjoin_eq_top`: `x` is a uniformizer of `B`.
* `Polynomial.IsEisensteinAt.ramificationIdx_eq_natDegree`: the ramification index of the maximal
  ideal of `B` over `A` is the degree of `f`.
* `Polynomial.IsEisensteinAt.inertiaDeg_eq_one`: its inertia degree over `A` is one.
* `Polynomial.IsEisensteinAt.addVal_algebraMap` and
  `Polynomial.IsEisensteinAt.addVal_aeval_of_natDegree_lt`: valuation scaling and power-basis
  valuation formula when `B` is a domain with injective structure map from `A`.
* `Polynomial.IsEisensteinAt.integralClosure_eq_adjoin`,
  `Polynomial.IsEisensteinAt.adjoin_singleton_eq_top_integralClosure`, and
  `Polynomial.IsEisensteinAt.isDiscreteValuationRing_integralClosure`: `integralClosure A E = A[α]`,
  a discrete valuation ring generated over `A` by `α`, for `E = K(α)`.

## References

* J.-P. Serre, *Corps locaux*, Chapter I, §6, Proposition 17.
* [Stacks Project, Lemma 15.116.2](https://stacks.math.columbia.edu/tag/09EV), parts (2)–(4).
-/

public section

open IntermediateField IsLocalRing Polynomial

namespace Polynomial.IsEisensteinAt

variable {A B : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
  [CommRing B] [Algebra A B] {f : A[X]} {x : B}

/-- The constant coefficient of `f` is a uniformizer of `A`. -/
private theorem irreducible_coeff_zero_of_aeval_eq_zero [Nontrivial B]
    (hf : f.IsEisensteinAt (maximalIdeal A)) (hmo : f.Monic) (hx : aeval x f = 0) :
    Irreducible (f.coeff 0) :=
  hf.irreducible_coeff_zero (hmo.natDegree_pos.mpr (by rintro rfl; simp at hx))

/-- The monic case of `eq_span_singleton_of_isMaximal`. -/
private theorem eq_span_singleton_of_isMaximal_of_monic (hf : f.IsEisensteinAt (maximalIdeal A))
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin A {x} = ⊤) (P : Ideal B)
    [P.IsMaximal] : P = Ideal.span {x} := by
  have : Nontrivial B := (subsingleton_or_nontrivial B).resolve_left fun h ↦
    (Ideal.IsMaximal.ne_top ‹_›) (Subsingleton.elim _ _)
  have : Module.Finite A B :=
    ⟨by simpa [hadj] using (show IsIntegral A x from ⟨f, hmo, hx⟩).fg_adjoin_singleton⟩
  have hspan := (irreducible_coeff_zero_of_aeval_eq_zero hf hmo hx).maximalIdeal_eq
  -- `P` lies over the maximal ideal of `A`, as `B` is integral over `A`.
  have hunder : P.comap (algebraMap A B) = maximalIdeal A :=
    eq_maximalIdeal (Ideal.IsMaximal.under A P)
  have hc0 : algebraMap A B (f.coeff 0) ∈ P := by
    rw [← Ideal.mem_comap, hunder, hspan]
    exact Ideal.mem_span_singleton_self _
  -- `x ^ deg f = -f(0) g(x)` lies in `P`, hence so does `x`.
  have hxP : x ∈ P := by
    obtain ⟨g, -, hg⟩ := hf.exists_pow_natDegree_eq hmo hx
    refine (Ideal.IsMaximal.isPrime ‹_›).mem_of_pow_mem f.natDegree ?_
    rw [hg]
    exact P.neg_mem_iff.mpr (P.mul_mem_right _ hc0)
  refine le_antisymm (fun z hz ↦ ?_) ((Ideal.span_singleton_le_iff_mem P).mpr hxP)
  -- Write `z = p(x)`; then `p(0) ∈ 𝔪 = f(0) A`, and `x` divides both `z - p(0)` and `f(0)`.
  have hz : z ∈ Algebra.adjoin A {x} := hadj ▸ Algebra.mem_top
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hz
  obtain ⟨p, rfl⟩ := hz
  have hsub : x ∣ aeval x p - algebraMap A B (p.coeff 0) := by
    simpa using _root_.map_dvd (aeval x) (X_dvd_sub_C (p := p))
  have hp0 : p.coeff 0 ∈ maximalIdeal A := by
    rw [← hunder, Ideal.mem_comap]
    simpa using P.sub_mem hz (P.mem_of_dvd hsub hxP)
  rw [hspan, Ideal.mem_span_singleton] at hp0
  rw [Ideal.mem_span_singleton]
  have hc0 : x ∣ algebraMap A B (f.coeff 0) := by
    simpa [hx] using (_root_.map_dvd (aeval x) (X_dvd_sub_C (p := f))).neg_right
  simpa using dvd_add hsub (hc0.trans (_root_.map_dvd (algebraMap A B) hp0))

/-- The monic case of `isMaximal_span_singleton`. -/
private theorem isMaximal_span_singleton_of_monic [Nontrivial B]
    (hf : f.IsEisensteinAt (maximalIdeal A)) (hmo : f.Monic) (hx : aeval x f = 0)
    (hadj : Algebra.adjoin A {x} = ⊤) : (Ideal.span {x}).IsMaximal := by
  obtain ⟨P, hP⟩ := Ideal.exists_maximal B
  exact eq_span_singleton_of_isMaximal_of_monic hf hmo hx hadj P ▸ hP

/-- **Every maximal ideal is generated by the Eisenstein root.** If `B` is generated over the
discrete valuation ring `A` by a root `x` of a polynomial which is Eisenstein at the maximal ideal
of `A`, then every maximal ideal of `B` is `x B`. -/
theorem eq_span_singleton_of_isMaximal (hf : f.IsEisensteinAt (maximalIdeal A))
    (hx : aeval x f = 0) (hadj : Algebra.adjoin A {x} = ⊤) (P : Ideal B) [P.IsMaximal] :
    P = Ideal.span {x} :=
  let ⟨_, hmo, hg, hgx, _⟩ := hf.exists_monic_aeval_eq_zero hx
  eq_span_singleton_of_isMaximal_of_monic hg hmo hgx hadj P

/-- The Eisenstein root generates a maximal ideal of `B`. -/
theorem isMaximal_span_singleton [Nontrivial B] (hf : f.IsEisensteinAt (maximalIdeal A))
    (hx : aeval x f = 0) (hadj : Algebra.adjoin A {x} = ⊤) : (Ideal.span {x}).IsMaximal :=
  let ⟨_, hmo, hg, hgx, _⟩ := hf.exists_monic_aeval_eq_zero hx
  isMaximal_span_singleton_of_monic hg hmo hgx hadj

/-- **An algebra generated by an Eisenstein root is local.** If a nontrivial ring `B` is generated
over the discrete valuation ring `A` by a root of a polynomial which is Eisenstein at the
maximal ideal of `A`, then `B` is a local ring. -/
theorem isLocalRing_of_adjoin_eq_top [Nontrivial B] (hf : f.IsEisensteinAt (maximalIdeal A))
    (hx : aeval x f = 0) (hadj : Algebra.adjoin A {x} = ⊤) : IsLocalRing B :=
  .of_unique_max_ideal ⟨_, isMaximal_span_singleton hf hx hadj,
    fun _ _ ↦ eq_span_singleton_of_isMaximal hf hx hadj _⟩

/-- The monic case of `inertiaDeg_eq_one`. -/
private theorem inertiaDeg_eq_one_of_monic (hf : f.IsEisensteinAt (maximalIdeal A))
    (hmo : f.Monic) (hx : aeval x f = 0) (hadj : Algebra.adjoin A {x} = ⊤) (P : Ideal B)
    [P.IsMaximal] : P.inertiaDeg A = 1 := by
  have : Nontrivial B := (subsingleton_or_nontrivial B).resolve_left fun h ↦
    (Ideal.IsMaximal.ne_top ‹_›) (Subsingleton.elim _ _)
  have : Module.Finite A B :=
    ⟨by simpa [hadj] using (show IsIntegral A x from ⟨f, hmo, hx⟩).fg_adjoin_singleton⟩
  have : P.LiesOver (maximalIdeal A) :=
    ⟨(eq_maximalIdeal (Ideal.IsMaximal.under A P)).symm⟩
  let := Ideal.Quotient.field (maximalIdeal A)
  rw [Ideal.inertiaDeg_eq_of_isMaximal (maximalIdeal A) P,
    ← Subalgebra.bot_eq_top_iff_finrank_eq_one, ← Algebra.range_ofId, AlgHom.range_eq_top]
  -- The class of `p(x)` modulo `P = x B` is that of the constant `p(0)`.
  intro z
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
  have hz : z ∈ Algebra.adjoin A {x} := hadj ▸ Algebra.mem_top
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hz
  obtain ⟨p, rfl⟩ := hz
  refine ⟨Ideal.Quotient.mk _ (p.coeff 0), ?_⟩
  rw [Algebra.ofId_apply, Ideal.Quotient.algebraMap_mk_of_liesOver, Eq.comm,
    Ideal.Quotient.eq, eq_span_singleton_of_isMaximal_of_monic hf hmo hx hadj P,
    Ideal.mem_span_singleton]
  simpa using _root_.map_dvd (aeval x) (X_dvd_sub_C (p := p))

/-- **An algebra generated by an Eisenstein root has the residue field of `A`.** Every maximal
ideal of `B` has inertia degree one over `A`. -/
theorem inertiaDeg_eq_one (hf : f.IsEisensteinAt (maximalIdeal A)) (hx : aeval x f = 0)
    (hadj : Algebra.adjoin A {x} = ⊤) (P : Ideal B) [P.IsMaximal] : P.inertiaDeg A = 1 :=
  let ⟨_, hmo, hg, hgx, _⟩ := hf.exists_monic_aeval_eq_zero hx
  inertiaDeg_eq_one_of_monic hg hmo hgx hadj P

/-- **An algebra generated by an Eisenstein root is a discrete valuation ring.** If a domain `B`
containing the discrete valuation ring `A` is generated over `A` by a root of a polynomial
which is Eisenstein at the maximal ideal of `A`, then `B` is a discrete valuation ring. -/
theorem isDiscreteValuationRing_of_adjoin_eq_top [IsDomain B] [FaithfulSMul A B]
    (hf : f.IsEisensteinAt (maximalIdeal A)) (hx : aeval x f = 0)
    (hadj : Algebra.adjoin A {x} = ⊤) : IsDiscreteValuationRing B := by
  obtain ⟨g, hmo, hg, hgx, -⟩ := hf.exists_monic_aeval_eq_zero hx
  have : Module.Finite A B :=
    ⟨by simpa [hadj] using (show IsIntegral A x from ⟨g, hmo, hgx⟩).fg_adjoin_singleton⟩
  have := IsNoetherianRing.of_finite A B
  have := isLocalRing_of_adjoin_eq_top hf hx hadj
  have hmax : maximalIdeal B = Ideal.span {x} :=
    eq_span_singleton_of_isMaximal_of_monic hg hmo hgx hadj _
  have hfield : ¬IsField B := by
    rw [isField_iff_maximalIdeal_eq, hmax, Ideal.span_singleton_eq_bot]
    exact hg.ne_zero_of_aeval_eq_zero hmo hgx
  have : (maximalIdeal B).IsPrincipal := ⟨x, hmax⟩
  exact ((IsDiscreteValuationRing.TFAE B hfield).out 1 5).mpr this

/-- **An Eisenstein root is a uniformizer.** If a domain `B` containing the discrete valuation
ring `A` is generated over `A` by a root `x` of a polynomial which is Eisenstein at the
maximal ideal of `A`, then `x` is irreducible in `B`, that is, a uniformizer of `B`. -/
theorem irreducible_of_adjoin_eq_top [IsDomain B] [FaithfulSMul A B]
    (hf : f.IsEisensteinAt (maximalIdeal A)) (hx : aeval x f = 0)
    (hadj : Algebra.adjoin A {x} = ⊤) : Irreducible x :=
  let ⟨_, hmo, hg, hgx, _⟩ := hf.exists_monic_aeval_eq_zero hx
  have := isLocalRing_of_adjoin_eq_top hf hx hadj
  IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal x
    (hg.ne_zero_of_aeval_eq_zero hmo hgx)
    (eq_span_singleton_of_isMaximal hf hx hadj _)

/-- The monic case of `ramificationIdx_eq_natDegree`. -/
private theorem ramificationIdx_eq_natDegree_of_monic [IsDomain B] [FaithfulSMul A B]
    (hf : f.IsEisensteinAt (maximalIdeal A)) (hmo : f.Monic) (hx : aeval x f = 0)
    (hadj : Algebra.adjoin A {x} = ⊤) (P : Ideal B) [P.IsMaximal] :
    P.ramificationIdx A = f.natDegree := by
  have := isLocalRing_of_adjoin_eq_top hf hx hadj
  have := isDiscreteValuationRing_of_adjoin_eq_top hf hx hadj
  -- `A → B` is a local homomorphism, as `B` is integral over `A`.
  have : Module.Finite A B :=
    ⟨by simpa [hadj] using (show IsIntegral A x from ⟨f, hmo, hx⟩).fg_adjoin_singleton⟩
  obtain rfl := eq_maximalIdeal ‹P.IsMaximal›
  have hP : maximalIdeal B = Ideal.span {x} :=
    eq_span_singleton_of_isMaximal_of_monic hf hmo hx hadj _
  -- `g(x)` is a unit, since `g(x) - 1 = g(x) - g(0)` lies in the maximal ideal `x B`.
  obtain ⟨g, hg0, hg⟩ := hf.exists_pow_natDegree_eq hmo hx
  have hunit : IsUnit (aeval x g) := by
    by_contra hg'
    have hmem : aeval x g - 1 ∈ maximalIdeal B := by
      rw [hP, Ideal.mem_span_singleton]
      simpa [hg0] using _root_.map_dvd (aeval x) (X_dvd_sub_C (p := g))
    exact (maximalIdeal.isMaximal B).ne_top <| (Ideal.eq_top_iff_one _).mpr <| by
      simpa using (maximalIdeal B).sub_mem ((mem_maximalIdeal _).mpr hg') hmem
  -- So the maximal ideal of `A` generates `(x B) ^ deg f`.
  refine TauCeti.IsDiscreteValuationRing.ramificationIdx_eq_of_map_maximalIdeal_eq_pow ?_
  rw [(irreducible_coeff_zero_of_aeval_eq_zero hf hmo hx).maximalIdeal_eq, Ideal.map_span,
    Set.image_singleton, hP, Ideal.span_singleton_pow, Ideal.span_singleton_eq_span_singleton]
  exact ⟨hunit.neg.unit, by simp [hg]⟩

/-- **An algebra generated by an Eisenstein root is totally ramified.** If a domain `B` containing
the discrete valuation ring `A` is generated over `A` by a root of a polynomial `f` which is
Eisenstein at the maximal ideal of `A`, then every maximal ideal of `B` has ramification index
`deg f` over `A`. -/
theorem ramificationIdx_eq_natDegree [IsDomain B] [FaithfulSMul A B]
    (hf : f.IsEisensteinAt (maximalIdeal A)) (hx : aeval x f = 0)
    (hadj : Algebra.adjoin A {x} = ⊤) (P : Ideal B) [P.IsMaximal] :
    P.ramificationIdx A = f.natDegree :=
  let ⟨_, hmo, hg, hgx, hdeg⟩ := hf.exists_monic_aeval_eq_zero hx
  (ramificationIdx_eq_natDegree_of_monic hg hmo hgx hadj P).trans hdeg

/-- In a domain `B` with injective structure map from a discrete valuation ring `A`, generated over
`A` by a root `x` of an Eisenstein polynomial `f`, the normalized additive valuation on `A` scales
by `f.natDegree` in `B`. Here `IsDiscreteValuationRing B` always holds by
`Polynomial.IsEisensteinAt.isDiscreteValuationRing_of_adjoin_eq_top`. -/
theorem addVal_algebraMap [IsDomain B] [FaithfulSMul A B] [IsDiscreteValuationRing B]
    (hf : f.IsEisensteinAt (maximalIdeal A)) (hx : aeval x f = 0)
    (hadj : Algebra.adjoin A {x} = ⊤) (a : A) :
    IsDiscreteValuationRing.addVal B (algebraMap A B a) =
      f.natDegree • IsDiscreteValuationRing.addVal A a := by
  have : Module.Finite A B :=
    ⟨by simpa [hadj] using (hf.isIntegral_of_aeval_eq_zero hx).fg_adjoin_singleton⟩
  have hpos : 0 < f.natDegree := hf.natDegree_pos_of_aeval_eq_zero hx
  have hne : (maximalIdeal A).map (algebraMap A B) ≠ ⊥ := by
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible A
    intro h
    refine (FaithfulSMul.algebraMap_eq_zero_iff A B).not.mpr hϖ.ne_zero (Ideal.mem_bot.mp ?_)
    rw [← h, hϖ.maximalIdeal_eq]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self ϖ)
  have hmap : (maximalIdeal A).map (algebraMap A B) = maximalIdeal B ^ f.natDegree := by
    rw [TauCeti.IsDiscreteValuationRing.map_maximalIdeal_eq_pow_ramificationIdx hne,
      hf.ramificationIdx_eq_natDegree hx hadj]
  exact TauCeti.IsDiscreteValuationRing.addVal_algebraMap_of_map_maximalIdeal_eq_pow
    hpos.ne' hmap a

/-- **Power-basis valuation formula.** In a domain `B` with injective structure map from a discrete
valuation ring `A`, generated over `A` by a root `x` of an Eisenstein polynomial `f`, for every
`p : A[X]` with `p.natDegree < f.natDegree` the valuation of `aeval x p` is the minimum of
`f.natDegree • addVal A (p.coeff i) + i` over `i : Fin f.natDegree`. -/
theorem addVal_aeval_of_natDegree_lt [IsDomain B] [FaithfulSMul A B] [IsDiscreteValuationRing B]
    (hf : f.IsEisensteinAt (maximalIdeal A)) (hx : aeval x f = 0)
    (hadj : Algebra.adjoin A {x} = ⊤) {p : A[X]} (hp : p.natDegree < f.natDegree) :
    IsDiscreteValuationRing.addVal B (aeval x p) =
      ⨅ i : Fin f.natDegree,
        (f.natDegree • IsDiscreteValuationRing.addVal A (p.coeff i) + (i : ℕ)) :=
  TauCeti.IsDiscreteValuationRing.addVal_aeval_of_natDegree_lt
    (hf.addVal_algebraMap hx hadj) (hf.irreducible_of_adjoin_eq_top hx hadj) hp

section IntegralClosure

variable {K E : Type*} [Field K] [Algebra A K] [IsFractionRing A K]
  [Field E] [Algebra K E] [Algebra A E] [IsScalarTower A K E] {α : E}

/-- If `E = K⟮α⟯` is generated over `K = Frac A` by a root `α` of an Eisenstein polynomial
`f : A[X]`, then the integral closure of `A` in `E` is `A[α]`. -/
theorem integralClosure_eq_adjoin (hf : f.IsEisensteinAt (maximalIdeal A))
    (hα : aeval α f = 0) (hgen : K⟮α⟯ = ⊤) :
    integralClosure A E = Algebra.adjoin A {α} := by
  have := FaithfulSMul.trans A K E
  have hint : IsIntegral A α := hf.isIntegral_of_aeval_eq_zero hα
  set S : Subalgebra A E := Algebra.adjoin A {α}
  let αS : S := ⟨α, Algebra.self_mem_adjoin_singleton A α⟩
  have hxS : aeval αS f = 0 := Subtype.ext ((aeval_subalgebra_coe f S αS).trans hα)
  have hadjS : Algebra.adjoin A {αS} = ⊤ := by
    apply Subalgebra.map_injective (f := S.val) Subtype.val_injective
    rw [AlgHom.map_adjoin, Set.image_singleton, Algebra.map_top, Subalgebra.range_val,
      Subalgebra.coe_val]
  have := hf.isDiscreteValuationRing_of_adjoin_eq_top hxS hadjS
  have : Algebra.IsIntegral A S :=
    have := Algebra.finite_adjoin_simple_of_isIntegral hint
    inferInstance
  have : IsFractionRing S E :=
    TauCeti.IntermediateField.isFractionRing_algebra_adjoin_of_adjoin_eq_top hgen
  refine le_antisymm (fun z hz ↦ ?_) (Algebra.adjoin_le (Set.singleton_subset_iff.mpr hint))
  obtain ⟨y, rfl⟩ := (IsIntegralClosure.isIntegral_iff (A := S)).mp hz
  exact y.2

/-- In the situation of `Polynomial.IsEisensteinAt.integralClosure_eq_adjoin`, the root `α` viewed
in `integralClosure A E` generates `integralClosure A E` as an `A`-algebra. -/
theorem adjoin_singleton_eq_top_integralClosure (hf : f.IsEisensteinAt (maximalIdeal A))
    (hα : aeval α f = 0) (hgen : K⟮α⟯ = ⊤) :
    Algebra.adjoin A
      {(⟨α, (mem_integralClosure_iff A E).mpr (hf.isIntegral_of_aeval_eq_zero hα)⟩ :
        integralClosure A E)} = ⊤ := by
  apply Subalgebra.map_injective (f := (integralClosure A E).val) Subtype.val_injective
  rw [AlgHom.map_adjoin, Set.image_singleton, Algebra.map_top, Subalgebra.range_val,
    Subalgebra.coe_val]
  exact (hf.integralClosure_eq_adjoin hα hgen).symm

/-- In the situation of `Polynomial.IsEisensteinAt.integralClosure_eq_adjoin`,
`integralClosure A E` is a discrete valuation ring. -/
theorem isDiscreteValuationRing_integralClosure (hf : f.IsEisensteinAt (maximalIdeal A))
    (hα : aeval α f = 0) (hgen : K⟮α⟯ = ⊤) :
    IsDiscreteValuationRing (integralClosure A E) := by
  have : FaithfulSMul A E := FaithfulSMul.trans A K E
  have : FaithfulSMul A (integralClosure A E) :=
    FaithfulSMul.tower_bot A (integralClosure A E) E
  let x : integralClosure A E :=
    ⟨α, (mem_integralClosure_iff A E).mpr (hf.isIntegral_of_aeval_eq_zero hα)⟩
  have hx : aeval x f = 0 :=
    Subtype.ext ((aeval_subalgebra_coe f (integralClosure A E) x).trans hα)
  exact hf.isDiscreteValuationRing_of_adjoin_eq_top hx
    (hf.adjoin_singleton_eq_top_integralClosure hα hgen)

end IntegralClosure

end Polynomial.IsEisensteinAt
