module

public import Mathlib.NumberTheory.NumberField.Cyclotomic.Basic
public import TauCeti.RingTheory.Cyclotomic.Basic

/-!
# The cyclotomic field generated by the distinguished complex root

The cyclotomic field `ℚ⟮complexRoot e⟯ ⊆ ℂ`, generated by the distinguished complex root
`TauCeti.Cyclotomic.complexRoot e = exp (2πi/e)`, is a number field and a cyclotomic extension
of `ℚ`.

## Main definitions

* `TauCeti.Cyclotomic.complexField`: the cyclotomic field `ℚ⟮complexRoot e⟯ ⊆ ℂ`.
* `TauCeti.Cyclotomic.complexField.zeta`: its generator `complexRoot e`.
* `TauCeti.Cyclotomic.complexField.zetaInteger`: the generator as an algebraic integer.
-/

public section

noncomputable section

open IntermediateField NumberField

namespace TauCeti.Cyclotomic

variable (e : ℕ)

/-- The cyclotomic field `ℚ⟮complexRoot e⟯ ⊆ ℂ`. -/
def complexField : IntermediateField ℚ ℂ := ℚ⟮complexRoot e⟯

theorem complexField_def : complexField e = ℚ⟮complexRoot e⟯ := (rfl)

theorem complexRoot_mem_complexField : complexRoot e ∈ complexField e :=
  mem_adjoin_simple_self ℚ _

@[simp]
theorem complexField_one : complexField 1 = ⊥ := by
  rw [complexField_def, adjoin_simple_eq_bot_iff, complexRoot_one]
  exact one_mem _

/-- The generator `complexRoot e` of `complexField e`. -/
def complexField.zeta : complexField e := ⟨complexRoot e, complexRoot_mem_complexField e⟩

@[simp]
theorem complexField.coe_zeta : (complexField.zeta e : ℂ) = complexRoot e := (rfl)

variable [NeZero e]

instance isCyclotomicExtension_complexField : IsCyclotomicExtension {e} ℚ (complexField e) :=
  (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin e ℚ ℂ _
    isPrimitiveRoot_complexRoot).mpr rfl

instance numberField_complexField : NumberField (complexField e) :=
  IsCyclotomicExtension.numberField {e} ℚ _

theorem complexField.isPrimitiveRoot_zeta : IsPrimitiveRoot (complexField.zeta e) e :=
  IsPrimitiveRoot.coe_submonoidClass_iff.mp isPrimitiveRoot_complexRoot

/-- The generator `complexRoot e` of `complexField e`, as an algebraic integer. -/
def complexField.zetaInteger : 𝓞 (complexField e) :=
  (complexField.isPrimitiveRoot_zeta e).toInteger

theorem complexField.zetaInteger_eq_toInteger :
    complexField.zetaInteger e = (complexField.isPrimitiveRoot_zeta e).toInteger := (rfl)

@[simp]
theorem complexField.coe_zetaInteger_eq_zeta :
    (complexField.zetaInteger e : complexField e) = complexField.zeta e := (rfl)

theorem complexField.coe_zetaInteger :
    ((complexField.zetaInteger e : complexField e) : ℂ) = complexRoot e := by
  simp

theorem complexField.coe_zetaInteger_pow (k : ℕ) :
    ((complexField.zetaInteger e ^ k : 𝓞 (complexField e)) : ℂ) = complexRoot e ^ k := by
  rw [← complexField.coe_zetaInteger]
  norm_cast

theorem complexField.isPrimitiveRoot_zetaInteger :
    IsPrimitiveRoot (complexField.zetaInteger e) e :=
  (complexField.isPrimitiveRoot_zeta e).toInteger_isPrimitiveRoot

variable {e} in
/-- An algebraic integer of `complexField e` that is `complexRoot e'` in `ℂ`, with `e'` the part
of `e` prime to `p`, is the power of `complexField.zetaInteger e` by the `p`-part of `e`. -/
theorem complexField.zetaInteger_pow_ordProj_eq_of_coe_eq (p : ℕ) {x : 𝓞 (complexField e)}
    (hx : ((x : complexField e) : ℂ) = complexRoot (ordCompl[p] e)) :
    complexField.zetaInteger e ^ ordProj[p] e = x := by
  apply RingOfIntegers.ext
  apply Subtype.ext
  rw [complexField.coe_zetaInteger_pow, hx, complexRoot_pow_ordProj]

end TauCeti.Cyclotomic
