module

public import TauCeti.RingTheory.Discriminant.SquareClass
public import TauCeti.FieldTheory.IntermediateField.Quadratic
public import TauCeti.FieldTheory.Kummer.Extension
public import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure

/-!
# The discriminant root field

A finite separable extension `L/K` determines an intermediate field of `AlgebraicClosure K`:
adjoin a square root of the discriminant of any `K`-basis of `L`. The change-of-basis square
factor does not affect this field. It is the base field when the discriminant class is trivial,
and has degree two otherwise. This construction also works in characteristic two; no claim
that an arbitrary square-root extension is separable is needed here.

The definition uses the root set of a quadratic polynomial rather than choosing a square root.
`discriminantRootField_eq_adjoin` identifies it with the simple field generated by any square
root of any basis discriminant. In particular, neither that root nor the basis is part of the
invariant. Algebra equivalences of `L` preserve it as an actual subfield of the fixed closure.
The basis comparison and finiteness also hold for inseparable finite extensions, whose basis
discriminants vanish. The square-root field comparisons reuse
`IntermediateField.adjoin_rootSet_X_pow_two_sub_C` and the quadratic adjunction API in
`TauCeti.FieldTheory.IntermediateField.Quadratic`.

## References

* J.-P. Serre, *Local Fields*, Chapter III, §3.
-/

public section
noncomputable section

open Polynomial
open scoped IntermediateField

namespace TauCeti

variable (K L : Type*) [Field K] [Field L] [Algebra K L]
  [Module.Finite K L] [Algebra.IsSeparable K L]

/-- The subfield of the algebraic closure generated by a square root of a basis discriminant.
It depends only on the discriminant square class, not on a basis or a choice of square root. -/
def discriminantRootField : IntermediateField K (AlgebraicClosure K) :=
  IntermediateField.adjoin K
    (((X : K[X]) ^ 2 - C (Algebra.discr K (Module.finBasis K L))).rootSet (AlgebraicClosure K))

/-- A square root of any unit representing the discriminant class generates the discriminant
root field. Thus square factors can be removed from the radicand. -/
theorem discriminantRootField_eq_adjoin_of_discriminantClass_eq {u : Kˣ}
    (hu : discriminantClass K L = squareClassHom u) {δ : AlgebraicClosure K}
    (hδ : δ ^ 2 = algebraMap K (AlgebraicClosure K) (u : K)) :
    discriminantRootField K L = K⟮δ⟯ := by
  classical
  obtain ⟨γ, hγ⟩ := IsAlgClosed.exists_pow_nat_eq
    (algebraMap K (AlgebraicClosure K) (Algebra.discr K (Module.finBasis K L)))
    (by decide : 0 < (2 : ℕ))
  have hsq : IsSquare (Algebra.discr K (Module.finBasis K L) * (u : K)) :=
    (discriminantClass_eq_iff K L (Module.finBasis K L) u).mp hu
  rw [discriminantRootField, IntermediateField.adjoin_rootSet_X_pow_two_sub_C hγ]
  exact IntermediateField.adjoin_simple_eq_of_isSquare_mul hγ hδ
    (Algebra.discr_not_zero_of_basis K _) u.ne_zero hsq

omit [Algebra.IsSeparable K L] in
/-- A square root of the discriminant of any finite basis generates the discriminant root
field. This simultaneously gives independence of the basis and of the chosen square root. -/
theorem discriminantRootField_eq_adjoin {ι : Type*} [Fintype ι] [DecidableEq ι]
    (b : Module.Basis ι K L) {δ : AlgebraicClosure K}
    (hδ : δ ^ 2 = algebraMap K (AlgebraicClosure K) (Algebra.discr K b)) :
    discriminantRootField K L = K⟮δ⟯ := by
  classical
  by_cases hs : Algebra.IsSeparable K L
  · let := hs
    exact discriminantRootField_eq_adjoin_of_discriminantClass_eq K L
      (discriminantClass_eq K L b) hδ
  · let := b.index_nonempty
    let := (Module.finBasis K L).index_nonempty
    have hd := Algebra.discr_eq_zero_of_not_isSeparable K L b hs
    have hc := Algebra.discr_eq_zero_of_not_isSeparable K L (Module.finBasis K L) hs
    rw [discriminantRootField, hc]
    exact IntermediateField.adjoin_rootSet_X_pow_two_sub_C (hd ▸ hδ)

/-- The discriminant root field is the base field exactly when the discriminant square class
is trivial. -/
@[simp]
theorem discriminantRootField_eq_bot_iff :
    discriminantRootField K L = ⊥ ↔ discriminantClass K L = 1 := by
  classical
  obtain ⟨δ, hδ⟩ := IsAlgClosed.exists_pow_nat_eq
    (algebraMap K (AlgebraicClosure K) (Algebra.discr K (Module.finBasis K L)))
    (by decide : 0 < (2 : ℕ))
  rw [discriminantRootField_eq_adjoin K L (Module.finBasis K L) hδ,
    IntermediateField.adjoin_simple_eq_bot_iff_isSquare hδ,
    discriminantClass_eq_one_iff K L (Module.finBasis K L)]

/-- A nontrivial discriminant class gives a quadratic discriminant root field. -/
theorem finrank_discriminantRootField_eq_two (h : discriminantClass K L ≠ 1) :
    Module.finrank K (discriminantRootField K L) = 2 := by
  classical
  obtain ⟨δ, hδ⟩ := IsAlgClosed.exists_pow_nat_eq
    (algebraMap K (AlgebraicClosure K) (Algebra.discr K (Module.finBasis K L)))
    (by decide : 0 < (2 : ℕ))
  rw [discriminantRootField_eq_adjoin K L (Module.finBasis K L) hδ]
  exact IntermediateField.finrank_adjoin_simple_eq_two_of_not_isSquare hδ
    ((discriminantClass_eq_one_iff K L (Module.finBasis K L)).not.mp h)

open Classical in
/-- The discriminant root field has degree one or two, with degree two exactly for a
nontrivial discriminant class. -/
theorem finrank_discriminantRootField :
    Module.finrank K (discriminantRootField K L) =
      if discriminantClass K L = 1 then 1 else 2 := by
  classical
  split_ifs with h
  · rw [(discriminantRootField_eq_bot_iff K L).mpr h, IntermediateField.finrank_bot]
  · exact finrank_discriminantRootField_eq_two K L h

omit [Algebra.IsSeparable K L] in
/-- The discriminant root field is a finite extension of the base field. -/
instance : Module.Finite K (discriminantRootField K L) := by
  classical
  obtain ⟨δ, hδ⟩ := IsAlgClosed.exists_pow_nat_eq
    (algebraMap K (AlgebraicClosure K) (Algebra.discr K (Module.finBasis K L)))
    (by decide : 0 < (2 : ℕ))
  rw [discriminantRootField_eq_adjoin K L (Module.finBasis K L) hδ]
  infer_instance

/-- The identity extension has trivial discriminant root field. -/
@[simp]
theorem discriminantRootField_self : discriminantRootField K K = ⊥ := by
  simp only [discriminantRootField_eq_bot_iff, discriminantClass_self]

omit [Algebra.IsSeparable K L] in
/-- Algebra-equivalent finite extensions give the same discriminant root field inside the
fixed algebraic closure of the base. -/
theorem discriminantRootField_eq_of_algEquiv (M : Type*) [Field M] [Algebra K M]
    [Module.Finite K M] (e : L ≃ₐ[K] M) :
    discriminantRootField K L = discriminantRootField K M := by
  classical
  let b := Module.finBasis K L
  obtain ⟨δ, hδ⟩ := IsAlgClosed.exists_pow_nat_eq
    (algebraMap K (AlgebraicClosure K) (Algebra.discr K b)) (by decide : 0 < (2 : ℕ))
  have hd : Algebra.discr K b = Algebra.discr K (b.map e.toLinearEquiv) :=
    Algebra.discr_eq_discr_of_algEquiv b e
  rw [discriminantRootField_eq_adjoin K L b hδ,
    discriminantRootField_eq_adjoin K M (b.map e.toLinearEquiv) (hd ▸ hδ)]

end TauCeti
