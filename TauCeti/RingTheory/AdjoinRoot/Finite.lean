module

public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.FiniteType
import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

/-!
# Finite algebras are reached by adjoining roots of monic polynomials

A finite algebra `B` over a commutative ring `A` is generated by finitely many elements, each
integral over `A`. Adjoining them one at a time realises `B` as a surjective image of an iterated
extension `A[X₁] ⧸ (p₁)[X₂] ⧸ (p₂) ⋯`, with every `pᵢ` monic. Consequently a property of
algebras that is preserved by adjoining a root of a monic polynomial propagates from `A` to an
algebra mapping onto `B`. A class of algebras that is in addition closed under surjective images,
such as affinoid or dagger algebras, is therefore closed under finite extensions.

## Main results

* `TauCeti.exists_surjective_of_module_finite`: if `P` is preserved by `AdjoinRoot` of monic
  polynomials, `A` has `P` and `B` is a finite `A`-algebra, then some `R`-algebra with `P`, in the
  universe of `A`, maps onto `B`.
-/

public section

namespace TauCeti

open Polynomial

universe u v

variable {R : Type*} [CommRing R] {B : Type v} [CommRing B] [Algebra R B]
  (P : ∀ (A : Type u) [CommRing A] [Algebra R A], Prop)

/-- An integral algebra generated by a finite set is a surjective image of an algebra obtained
from the base by adjoining roots of monic polynomials. The generators are adjoined one at a time,
each step replacing the base `A` by `AdjoinRoot p`. -/
private theorem exists_surjective_of_adjoin_eq_top
    (hP : ∀ (A : Type u) [CommRing A] [Algebra R A] {p : A[X]}, p.Monic → P A →
      P (AdjoinRoot p)) (s : Finset B) :
    ∀ (A : Type u) [CommRing A] [Algebra R A] [Algebra A B] [IsScalarTower R A B]
      [Algebra.IsIntegral A B], P A → Algebra.adjoin A (s : Set B) = ⊤ →
      ∃ (A' : Type u) (_ : CommRing A') (_ : Algebra R A') (f : A' →ₐ[R] B),
        P A' ∧ Function.Surjective f := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    intro A _ _ _ _ _ hA hs
    refine ⟨A, inferInstance, inferInstance, IsScalarTower.toAlgHom R A B, hA, fun b ↦ ?_⟩
    have hb : b ∈ (⊥ : Subalgebra A B) := by
      rw [← Algebra.adjoin_empty, ← Finset.coe_empty, hs]
      exact Algebra.mem_top
    exact Algebra.mem_bot.mp hb
  | insert b s _ ih =>
    intro A _ _ _ _ _ hA hs
    obtain ⟨p, hpm, hpb⟩ := Algebra.IsIntegral.isIntegral (R := A) b
    let : Algebra (AdjoinRoot p) B := (AdjoinRoot.lift (algebraMap A B) b hpb).toAlgebra
    have hmap (x : AdjoinRoot p) :
        algebraMap (AdjoinRoot p) B x = AdjoinRoot.lift (algebraMap A B) b hpb x := by
      rw [RingHom.algebraMap_toAlgebra]
    have : IsScalarTower A (AdjoinRoot p) B :=
      IsScalarTower.of_algebraMap_eq fun a ↦ by
        rw [hmap, AdjoinRoot.algebraMap_eq, AdjoinRoot.lift_of]
    have : IsScalarTower R (AdjoinRoot p) B :=
      IsScalarTower.of_algebraMap_eq fun r ↦ by
        rw [IsScalarTower.algebraMap_apply R A (AdjoinRoot p),
          ← IsScalarTower.algebraMap_apply A (AdjoinRoot p) B,
          ← IsScalarTower.algebraMap_apply R A B]
    have : Algebra.IsIntegral (AdjoinRoot p) B := Algebra.IsIntegral.tower_top A
    refine ih (AdjoinRoot p) (hP A hpm hA) (eq_top_iff.mpr fun x _ ↦ ?_)
    have hle : Algebra.adjoin A (insert b (s : Set B)) ≤
        (Algebra.adjoin (AdjoinRoot p) (s : Set B)).restrictScalars A := by
      rw [Algebra.adjoin_le_iff, Set.insert_subset_iff]
      refine ⟨?_, Algebra.subset_adjoin⟩
      have hb : algebraMap (AdjoinRoot p) B (AdjoinRoot.root p) = b := by
        rw [hmap, AdjoinRoot.lift_root]
      rw [← hb, SetLike.mem_coe, Subalgebra.mem_restrictScalars]
      exact Subalgebra.algebraMap_mem _ _
    rw [← Finset.coe_insert, hs] at hle
    exact hle Algebra.mem_top

/-- **Finite algebras are images of iterated root adjunctions.** Let `P` be a property of
`R`-algebras preserved by adjoining a root of a monic polynomial. If `A` has `P` and `B` is a
finite `A`-algebra, compatibly with the `R`-algebra structures, then there is an `R`-algebra `A'`
with `P`, in the universe of `A`, and a surjective `R`-algebra homomorphism `A' → B`. -/
theorem exists_surjective_of_module_finite
    (hP : ∀ (A : Type u) [CommRing A] [Algebra R A] {p : A[X]}, p.Monic → P A →
      P (AdjoinRoot p))
    {A : Type u} [CommRing A] [Algebra R A] [Algebra A B] [IsScalarTower R A B]
    [Module.Finite A B] (hA : P A) :
    ∃ (A' : Type u) (_ : CommRing A') (_ : Algebra R A') (f : A' →ₐ[R] B),
      P A' ∧ Function.Surjective f := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := A) (A := B)
  exact exists_surjective_of_adjoin_eq_top P hP s A hA hs

end TauCeti
