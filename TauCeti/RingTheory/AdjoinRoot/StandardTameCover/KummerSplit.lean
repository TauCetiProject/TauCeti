section BaseChangeAndScaling

/-- Base change of a standard tamely ramified cover `A[x]/(x^e − f)` to an `A`-algebra `B` gives
the standard cover `B[x]/(x^e − f)` over `B`, sending `1 ⊗ x` to `x`. -/
noncomputable def standardTameCoverBaseChangeAlgEquiv {A : Type*} [CommRing A] (B : Type*)
    [CommRing B] [Algebra A B] (f : A) (e : ℕ) :
    B ⊗[A] standardTameCover A f e ≃ₐ[B] standardTameCover B (algebraMap A B f) e :=
  (AdjoinRoot.algebraTensorAlgEquiv B (X ^ e - Polynomial.C f)).trans
    (AdjoinRoot.mapAlgEquiv AlgEquiv.refl _ _ (.of_eq (by simp)))

/-- The base-change equivalence sends `1 ⊗ root` to `root`. -/
@[simp]
theorem standardTameCoverBaseChangeAlgEquiv_one_tmul_root {A : Type*} [CommRing A] (B : Type*)
    [CommRing B] [Algebra A B] (f : A) (e : ℕ) :
    standardTameCoverBaseChangeAlgEquiv B f e (1 ⊗ₜ AdjoinRoot.root _) = AdjoinRoot.root _ := by
  simp [standardTameCoverBaseChangeAlgEquiv]

/-- If `u` is a unit of `R` with `u ^ e = f`, scaling the root by `u` identifies the unit-radicand
cover `R[x]/(x^e − 1)` with `R[x]/(x^e − f)`: the class of `X` in `R[x]/(x^e − 1)` maps to
`u⁻¹ · root`, and the inverse sends `root` to `u · root`. -/
noncomputable def standardTameCoverOneAlgEquivOfPowEq {R : Type*} [CommRing R] {f u : R} {e : ℕ}
    (hu : IsUnit u) (huf : u ^ e = f) :
    standardTameCover R 1 e ≃ₐ[R] standardTameCover R f e :=
  let uinv : R := ↑hu.unit⁻¹
  have huinv_pow : uinv ^ e * f = 1 := by
    rw [← huf, ← mul_pow, hu.val_inv_mul, one_pow]
  let F : standardTameCover R 1 e →ₐ[R] standardTameCover R f e :=
    (AdjoinRoot.algHomEquiv _ _).symm
      ⟨algebraMap R _ uinv * AdjoinRoot.root _, by
        rw [map_sub, map_pow, aeval_X, aeval_C, mul_pow, AdjoinRoot.algebraMap_eq,
          AdjoinRoot.root_X_pow_sub_C_pow, ← map_pow, ← map_mul, huinv_pow,
          (AdjoinRoot.of _).map_one, sub_self]⟩
  let G : standardTameCover R f e →ₐ[R] standardTameCover R 1 e :=
    (AdjoinRoot.algHomEquiv _ _).symm
      ⟨algebraMap R _ u * AdjoinRoot.root _, by
        rw [map_sub, map_pow, aeval_X, aeval_C, mul_pow, AdjoinRoot.algebraMap_eq,
          AdjoinRoot.root_X_pow_sub_C_pow, (AdjoinRoot.of _).map_one, mul_one, ← map_pow, huf,
          sub_self]⟩
  AlgEquiv.ofAlgHom F G
    (AdjoinRoot.algHom_ext <| by
      simp only [F, G, uinv, AlgHom.comp_apply, AlgHom.id_apply,
        AdjoinRoot.algHomEquiv_symm_apply_root, map_mul, AlgHom.commutes]
      rw [← mul_assoc, ← map_mul, hu.mul_val_inv, (algebraMap R _).map_one, one_mul])
    (AdjoinRoot.algHom_ext <| by
      simp only [F, G, uinv, AlgHom.comp_apply, AlgHom.id_apply,
        AdjoinRoot.algHomEquiv_symm_apply_root, map_mul, AlgHom.commutes]
      rw [← mul_assoc, ← map_mul, hu.val_inv_mul, (algebraMap R _).map_one, one_mul])

/-- `standardTameCoverOneAlgEquivOfPowEq` sends the root of `X^e − 1` to `u⁻¹ · root`. -/
@[simp]
theorem standardTameCoverOneAlgEquivOfPowEq_root {R : Type*} [CommRing R] {f u : R} {e : ℕ}
    (hu : IsUnit u) (huf : u ^ e = f) :
    standardTameCoverOneAlgEquivOfPowEq hu huf (AdjoinRoot.root _) =
      algebraMap R _ (↑hu.unit⁻¹ : R) * AdjoinRoot.root _ :=
  AdjoinRoot.algHomEquiv_symm_apply_root _

/-- The inverse of `standardTameCoverOneAlgEquivOfPowEq` sends the root of `X^e − f` to
`u · root`. -/
@[simp]
theorem standardTameCoverOneAlgEquivOfPowEq_symm_root {R : Type*} [CommRing R] {f u : R} {e : ℕ}
    (hu : IsUnit u) (huf : u ^ e = f) :
    (standardTameCoverOneAlgEquivOfPowEq hu huf).symm (AdjoinRoot.root _) =
      algebraMap R _ u * AdjoinRoot.root _ :=
  AdjoinRoot.algHomEquiv_symm_apply_root _

end BaseChangeAndScaling

section RegularDivisorLocal

variable {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A] {f : A}

/-- In a Noetherian local ring `A`, a nonzerodivisor `f ∈ 𝔪_A` with `A ⧸ (f)` regular makes `A` a
regular local ring (hence an integrally closed domain) and `(f)` a prime ideal minimal over
itself. -/
private theorem isRegularLocalRing_and_isPrime_span (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) [IsRegularRing (A ⧸ Ideal.span {f})] :
    _root_.IsRegularLocalRing A ∧ (Ideal.span {f}).IsPrime ∧ Prime f ∧
      Ideal.span {f} ∈ (Ideal.span {f}).minimalPrimes := by
  have : Nontrivial (A ⧸ Ideal.span {f}) := Ideal.Quotient.nontrivial_iff.mpr fun h ↦
    (maximalIdeal.isMaximal A).ne_top
      (top_le_iff.mp (h ▸ (Ideal.span_singleton_le_iff_mem _).mpr hf))
  have : IsLocalRing (A ⧸ Ideal.span {f}) :=
    IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  have : _root_.IsRegularLocalRing (A ⧸ Ideal.span {f}) := .of_isRegularRing_of_isLocalRing _
  have hreg : _root_.IsRegularLocalRing A :=
    TauCeti.IsRegularLocalRing.of_quotient_nonZeroDivisor A hf hf₀
  have hprime : (Ideal.span {f}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp inferInstance
  have hfprime : Prime f := (Ideal.span_singleton_prime (nonZeroDivisors.ne_zero hf₀)).mp hprime
  exact ⟨hreg, hprime, hfprime, ⟨⟨hprime, le_rfl⟩, fun _ h _ ↦ h.2⟩⟩

/-- If `f` is a regular divisor parameter in a Noetherian local ring `A`, then `X ^ n - C f` is
irreducible over any fraction field `K` of `A` for `n ≠ 0`: localizing at the height-one prime `(f)`
gives a discrete valuation ring with uniformizer `f` and fraction field `K`, where `X ^ n - C f` is
Eisenstein. -/
theorem standardTameCover_irreducible_X_pow_sub_C (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) [IsRegularRing (A ⧸ Ideal.span {f})] {n : ℕ} (hn : n ≠ 0)
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K] :
    Irreducible (X ^ n - Polynomial.C (algebraMap A K f)) := by
  obtain ⟨_, _, -, hfmin⟩ := isRegularLocalRing_and_isPrime_span hf hf₀
  let Aₚ := Localization.AtPrime (Ideal.span {f})
  have : IsDiscreteValuationRing Aₚ := isDiscreteValuationRing_of_mem_minimalPrimes Aₚ hf₀ hfmin
  have hπ : Irreducible (algebraMap A Aₚ f) :=
    irreducible_algebraMap_of_mem_minimalPrimes Aₚ hf₀ hfmin
  rw [IsScalarTower.algebraMap_apply A Aₚ K]
  exact X_pow_sub_C_irreducible_of_irreducible hπ hn

/-- Over a Noetherian local ring `A` with regular divisor `f ∈ 𝔪_A`, the generic fibre
`K ⊗[A] A[x]/(x^n − f)` of a positive-degree standard cover is a field. -/
theorem standardTameCover_isField_tensorProduct (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) [IsRegularRing (A ⧸ Ideal.span {f})] {n : ℕ} (hn : n ≠ 0)
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K] :
    IsField (K ⊗[A] standardTameCover A f n) := by
  have : Fact (Irreducible (X ^ n - Polynomial.C (algebraMap A K f))) :=
    ⟨standardTameCover_irreducible_X_pow_sub_C hf hf₀ hn K⟩
  exact MulEquiv.isField (Field.toIsField (standardTameCover K (algebraMap A K f) n))
    (standardTameCoverBaseChangeAlgEquiv K f n).toMulEquiv

section SingleComponent

variable [IsRegularRing (A ⧸ Ideal.span {f})]
  {K L : Type*} [Field K] [Algebra A K] [IsFractionRing A K]
  [Field L] [Algebra A L] [Algebra K L] [IsScalarTower A K L]

/-- **Degree of a root extension along a regular divisor.** If `L = K(γ)` is generated over the
fraction field `K` of `A` by an `n`-th root `γ` of `f`, then `[L : K] = n`. Positivity of `n` is
automatic because `f ∈ 𝔪_A` is not `1`. -/
theorem finrank_eq_of_pow_eq_of_isRegularRing_quotient (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) {n : ℕ} {γ : L} (hγ : γ ^ n = algebraMap A L f)
    (hgen : K⟮γ⟯ = ⊤) : Module.finrank K L = n := by
  obtain ⟨_, _, -, hfmin⟩ := isRegularLocalRing_and_isPrime_span hf hf₀
  let Aₚ := Localization.AtPrime (Ideal.span {f})
  have : IsDiscreteValuationRing Aₚ := isDiscreteValuationRing_of_mem_minimalPrimes Aₚ hf₀ hfmin
  have hπ : Irreducible (algebraMap A Aₚ f) :=
    irreducible_algebraMap_of_mem_minimalPrimes Aₚ hf₀ hfmin
  let _ : Algebra Aₚ L := ((algebraMap K L).comp (algebraMap Aₚ K)).toAlgebra
  have : IsScalarTower Aₚ K L := .of_algebraMap_eq' rfl
  have hγ' : γ ^ n = algebraMap Aₚ L (algebraMap A Aₚ f) := by
    rw [RingHom.algebraMap_toAlgebra, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply A Aₚ K,
      ← IsScalarTower.algebraMap_apply A K L, hγ]
  exact IsDiscreteValuationRing.finrank_eq_of_pow_eq_of_irreducible hπ hγ' hgen

/-- **Generic degree of a standard tame cover along a regular divisor.** Any fraction field `K'` of
`A[x]/(x^e − f)` over a fraction field `K` of `A` has degree `[K' : K] = e` (positivity of `e` is
automatic because `f ∈ 𝔪_A` is not `1`). -/
theorem standardTameCover_finrank_fractionRing (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) {e : ℕ}
    [Algebra (standardTameCover A f e) L] [IsScalarTower A (standardTameCover A f e) L]
    [IsFractionRing (standardTameCover A f e) L] :
    Module.finrank K L = e := by
  let α : L := algebraMap (standardTameCover A f e) L (AdjoinRoot.root _)
  have hα : α ^ e = algebraMap A L f := by
    rw [← map_pow, AdjoinRoot.root_X_pow_sub_C_pow, ← AdjoinRoot.algebraMap_eq,
      ← IsScalarTower.algebraMap_apply A (standardTameCover A f e) L]
  have hgen : K⟮α⟯ = ⊤ :=
    IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top (R := A)
      (S := standardTameCover A f e) (K := K) (L := L) AdjoinRoot.adjoinRoot_eq_top
  exact finrank_eq_of_pow_eq_of_isRegularRing_quotient hf hf₀ hα hgen

/-- Evaluation at an `n`-th root `γ` of `f` in `L = K(γ)` embeds `A[x]/(x^n − f)` into `L` with
image `A[γ]` and makes `L` a fraction field of `A[x]/(x^n − f)`. -/
private theorem injective_and_isFractionRing_of_pow_eq (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) {n : ℕ} (hn : n ≠ 0) {γ : L}
    (ψ : standardTameCover A f n →ₐ[A] L) (hψ_root : ψ (AdjoinRoot.root _) = γ)
    (hgen : K⟮γ⟯ = ⊤) :
    Function.Injective ψ ∧
      @IsFractionRing (standardTameCover A f n) _ L _ ψ.toRingHom.toAlgebra := by
  have := (monic_X_pow_sub_C f hn).free_adjoinRoot
  let _ : Field (K ⊗[A] standardTameCover A f n) :=
    (standardTameCover_isField_tensorProduct hf hf₀ hn K).toField
  let ψK : K ⊗[A] standardTameCover A f n →ₐ[K] L :=
    Algebra.TensorProduct.lift (Algebra.ofId K L) ψ fun _ _ ↦ Commute.all _ _
  have hψ_inj : Function.Injective ψ := by
    have heq : (ψ : standardTameCover A f n → L) = ψK ∘ Algebra.TensorProduct.includeRight := by
      ext x
      simp [ψK]
    rw [heq]
    exact ψK.toRingHom.injective.comp
      (Algebra.TensorProduct.includeRight_injective (IsFractionRing.injective A K))
  have hrange : ψ.range = Algebra.adjoin A {γ} := by
    rw [← hψ_root, ← Set.image_singleton, ← AlgHom.map_adjoin,
      AdjoinRoot.adjoinRoot_eq_top, Algebra.map_top]
  have : IsFractionRing (Algebra.adjoin A {γ}) L :=
    IntermediateField.isFractionRing_algebra_adjoin_of_adjoin_eq_top hgen
  let _ : Algebra (standardTameCover A f n) L := ψ.toRingHom.toAlgebra
  have : FaithfulSMul (standardTameCover A f n) L :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hψ_inj
  refine ⟨hψ_inj, .of_field _ _ fun z ↦ ?_⟩
  obtain ⟨x, y, _, rfl⟩ := IsFractionRing.div_surjective (A := Algebra.adjoin A {γ}) z
  have hx_mem : (x : L) ∈ ψ.range := by rw [hrange]; exact x.2
  have hy_mem : (y : L) ∈ ψ.range := by rw [hrange]; exact y.2
  obtain ⟨x₀, hx₀⟩ := hx_mem
  obtain ⟨y₀, hy₀⟩ := hy_mem
  exact ⟨x₀, y₀, by rw [RingHom.algebraMap_toAlgebra, hx₀, hy₀]; rfl⟩

/-- **Single-component normalization along a regular divisor.** If `L = K(γ)` is generated over the
fraction field `K` of `A` by an `n`-th root `γ` of `f`, then the standard cover `A[x]/(x^n − f)` is
canonically `A`-isomorphic to `integralClosure A L`, sending the root `x` to `γ`. -/
noncomputable def standardTameCoverIntegralClosureAlgEquiv (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) {n : ℕ} {γ : L} (hγ : γ ^ n = algebraMap A L f)
    (hgen : K⟮γ⟯ = ⊤) :
    standardTameCover A f n ≃ₐ[A] integralClosure A L :=
  let ψ : standardTameCover A f n →ₐ[A] L :=
    (AdjoinRoot.algHomEquiv _ _).symm ⟨γ, by
      rw [map_sub, map_pow, aeval_X, aeval_C, hγ, sub_self]⟩
  AlgEquiv.ofBijective
    (ψ.codRestrict (integralClosure A L) fun x ↦ by
      have hn : n ≠ 0 := by
        obtain ⟨_, _, hfprime, -⟩ := isRegularLocalRing_and_isPrime_span hf hf₀
        have := FaithfulSMul.trans A K L
        rintro rfl
        exact hfprime.ne_one ((FaithfulSMul.algebraMap_injective A L) (by simpa using hγ.symm))
      have := (monic_X_pow_sub_C f hn).finite_adjoinRoot
      exact (Algebra.IsIntegral.isIntegral x).map ψ)
    (by
      obtain ⟨_, _, hfprime, -⟩ := isRegularLocalRing_and_isPrime_span hf hf₀
      have := FaithfulSMul.trans A K L
      have hn : n ≠ 0 := by
        rintro rfl
        exact hfprime.ne_one ((FaithfulSMul.algebraMap_injective A L) (by simpa using hγ.symm))
      have := (monic_X_pow_sub_C f hn).finite_adjoinRoot
      have := standardTameCover_isRegularLocalRing hf hf₀ hn
      have := standardTameCover_isIntegrallyClosed hf hf₀ hn
      let _ : Algebra (standardTameCover A f n) L := ψ.toRingHom.toAlgebra
      have : IsScalarTower A (standardTameCover A f n) L :=
        .of_algebraMap_eq' ψ.comp_algebraMap.symm
      obtain ⟨hψ_inj, hfrac⟩ := injective_and_isFractionRing_of_pow_eq hf hf₀ hn ψ
        (AdjoinRoot.algHomEquiv_symm_apply_root _) hgen
      have : IsFractionRing (standardTameCover A f n) L := hfrac
      refine ⟨fun a b h ↦ hψ_inj (congrArg Subtype.val h), fun ⟨z, hz⟩ ↦ ?_⟩
      obtain ⟨x, hx⟩ := (IsIntegralClosure.isIntegral_iff (A := standardTameCover A f n)).mp hz
      exact ⟨x, Subtype.ext hx⟩)

/-- `standardTameCoverIntegralClosureAlgEquiv` sends the root of `X^n − f` to `γ`. -/
@[simp]
theorem coe_standardTameCoverIntegralClosureAlgEquiv_root (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) {n : ℕ} {γ : L} (hγ : γ ^ n = algebraMap A L f)
    (hgen : K⟮γ⟯ = ⊤) :
    (standardTameCoverIntegralClosureAlgEquiv hf hf₀ hγ hgen (AdjoinRoot.root _) : L) = γ := by
  simp only [standardTameCoverIntegralClosureAlgEquiv, AlgEquiv.ofBijective_apply]
  exact AdjoinRoot.algHomEquiv_symm_apply_root _

end SingleComponent

section Subextension

variable [IsRegularRing (A ⧸ Ideal.span {f})] {e : ℕ}
  {K K' L : Type*} [Field K] [Algebra A K] [IsFractionRing A K]
  [Field K'] [Algebra A K'] [Algebra K K'] [IsScalarTower A K K']
  [Algebra (standardTameCover A f e) K'] [IsScalarTower A (standardTameCover A f e) K']
  [IsFractionRing (standardTameCover A f e) K']
  [Field L] [Algebra A L] [Algebra K L] [IsScalarTower A K L]

/-- **Subextensions of the fraction field of a tame root cover.** Let `A` be a Noetherian local ring
with regular divisor `f ∈ 𝔪_A` and `¬ f ∣ (e : A)`, and let `K'` be a fraction field of
`A[x]/(x^e − f)` over a fraction field `K` of `A`. For every `K`-algebra map `φ : L →ₐ[K] K'` from
a field `L`, the degree `[L : K]` divides `e` and `L` is generated over `K` by an `[L : K]`-th root
of `f`. -/
@[stacks 0EYG "subfields of the generic fibre of A[x]/(x^e - f)"]
theorem exists_pow_eq_and_adjoin_eq_top_of_algHom_standardTameCover (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) (hfe : ¬ f ∣ (e : A)) (φ : L →ₐ[K] K') :
    Module.finrank K L ∣ e ∧ ∃ γ : L, γ ^ Module.finrank K L = algebraMap A L f ∧ K⟮γ⟯ = ⊤ := by
  have he : e ≠ 0 := by rintro rfl; exact hfe (by simp)
  obtain ⟨_, _, -, hfmin⟩ := isRegularLocalRing_and_isPrime_span hf hf₀
  let Aₚ := Localization.AtPrime (Ideal.span {f})
  have : IsDiscreteValuationRing Aₚ := isDiscreteValuationRing_of_mem_minimalPrimes Aₚ hf₀ hfmin
  have hπ : Irreducible (algebraMap A Aₚ f) :=
    irreducible_algebraMap_of_mem_minimalPrimes Aₚ hf₀ hfmin
  -- `e ∉ (f)` becomes a unit in `A_{(f)}`, hence in its residue field.
  have he_notMem : (e : A) ∉ Ideal.span {f} := fun h ↦ hfe (Ideal.mem_span_singleton.mp h)
  have he_unit : IsUnit (e : Aₚ ⧸ maximalIdeal Aₚ) := by
    have he_unit_loc : IsUnit (e : Aₚ) := by
      simpa using IsLocalization.map_units Aₚ (⟨(e : A), he_notMem⟩ : (Ideal.span {f}).primeCompl)
    simpa using he_unit_loc.map (Ideal.Quotient.mk (maximalIdeal Aₚ))
  -- The root `α` of `A[x]/(x^e - f)` in `K'` generates `K'` over `K` and satisfies `α ^ e = f`.
  let α : K' := algebraMap (standardTameCover A f e) K' (AdjoinRoot.root _)
  have hα : α ^ e = algebraMap A K' f := by
    rw [← map_pow, AdjoinRoot.root_X_pow_sub_C_pow, ← AdjoinRoot.algebraMap_eq,
      ← IsScalarTower.algebraMap_apply A (standardTameCover A f e) K']
  have hgenK' : K⟮α⟯ = ⊤ :=
    IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top (R := A)
      (S := standardTameCover A f e) (K := K) (L := K') AdjoinRoot.adjoinRoot_eq_top
  let _ : Algebra Aₚ K' := ((algebraMap K K').comp (algebraMap Aₚ K)).toAlgebra
  have : IsScalarTower Aₚ K K' := .of_algebraMap_eq' rfl
  have hα' : α ^ e = algebraMap Aₚ K' (algebraMap A Aₚ f) := by
    rw [RingHom.algebraMap_toAlgebra, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply A Aₚ K,
      ← IsScalarTower.algebraMap_apply A K K', hα]
  -- Apply Stacks 09EV (6) to the intermediate field `φ.fieldRange` of `K' / K`.
  have hfinK' : Module.finrank K K' = e := standardTameCover_finrank_fractionRing hf hf₀
  have : FiniteDimensional K K' := Module.finite_of_finrank_pos (hfinK' ▸ Nat.pos_of_ne_zero he)
  let r := Module.finrank φ.fieldRange K'
  have hM : φ.fieldRange = K⟮α ^ r⟯ :=
    IsDiscreteValuationRing.eq_adjoin_pow_finrank_of_pow_eq_of_irreducible hπ he_unit hα' hgenK'
      φ.fieldRange
  have hmul : Module.finrank K L * r = e := by
    dsimp only [r]
    rw [φ.equivFieldRange.toLinearEquiv.finrank_eq,
      Module.finrank_mul_finrank K φ.fieldRange K', hfinK']
  obtain ⟨γ, hφγ⟩ := φ.mem_fieldRange.mp (by rw [hM]; exact mem_adjoin_simple_self K (α ^ r))
  have hφ_inj : Function.Injective φ := φ.injective
  have hγ_pow : γ ^ Module.finrank K L = algebraMap A L f := hφ_inj <| by
    rw [map_pow, hφγ, ← pow_mul, mul_comm, hmul, hα, IsScalarTower.algebraMap_apply A K L,
      AlgHom.commutes, ← IsScalarTower.algebraMap_apply A K K']
  have hmap : (K⟮γ⟯).map φ = φ.fieldRange := by
    rw [adjoin_map, Set.image_singleton, hφγ, ← hM]
  refine ⟨⟨r, hmul.symm⟩, γ, hγ_pow, eq_top_iff.mpr fun x _ ↦ ?_⟩
  have hx : φ x ∈ (K⟮γ⟯).map φ := by rw [hmap]; exact φ.mem_fieldRange.mpr ⟨x, rfl⟩
  obtain ⟨y, hy, hyx⟩ := hx
  exact hφ_inj hyx ▸ hy

/-- If `L` embeds over `K` into the fraction field of `A[x]/(x^e − f)` with `¬ f ∣ (e : A)`, then
`[L : K]` divides `e`. -/
theorem finrank_dvd_of_algHom_standardTameCover (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) (hfe : ¬ f ∣ (e : A)) (φ : L →ₐ[K] K') :
    Module.finrank K L ∣ e :=
  (exists_pow_eq_and_adjoin_eq_top_of_algHom_standardTameCover hf hf₀ hfe φ).1

/-- If `L` embeds over `K` into the fraction field of `A[x]/(x^e − f)` with `¬ f ∣ (e : A)`, then
`1 ≤ [L : K]`. -/
theorem finrank_pos_of_algHom_standardTameCover (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) (hfe : ¬ f ∣ (e : A)) (φ : L →ₐ[K] K') :
    1 ≤ Module.finrank K L := by
  have he : e ≠ 0 := by rintro rfl; exact hfe (by simp)
  exact Nat.pos_of_dvd_of_pos (finrank_dvd_of_algHom_standardTameCover hf hf₀ hfe φ)
    (Nat.pos_of_ne_zero he)

/-- If `L` embeds over `K` into the fraction field of `A[x]/(x^e − f)` with `¬ f ∣ (e : A)`, then
`f` does not divide `[L : K]` in `A`. -/
theorem not_dvd_natCast_finrank_of_algHom_standardTameCover (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) (hfe : ¬ f ∣ (e : A)) (φ : L →ₐ[K] K') :
    ¬ f ∣ (Module.finrank K L : A) := by
  intro hdvd
  obtain ⟨k, hk⟩ := finrank_dvd_of_algHom_standardTameCover hf hf₀ hfe φ
  exact hfe (by rw [hk, Nat.cast_mul]; exact dvd_mul_of_dvd_left hdvd _)

/-- **Integral closure in a subfield of a tame root cover.** Under the hypotheses of
`exists_pow_eq_and_adjoin_eq_top_of_algHom_standardTameCover`, the integral closure of `A` in `L`
is `A`-isomorphic to `A[x]/(x^{[L : K]} − f)`. -/
noncomputable def integralClosureAlgEquivStandardTameCover (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) (hfe : ¬ f ∣ (e : A)) (φ : L →ₐ[K] K') :
    integralClosure A L ≃ₐ[A] standardTameCover A f (Module.finrank K L) :=
  let h := (exists_pow_eq_and_adjoin_eq_top_of_algHom_standardTameCover hf hf₀ hfe φ).2
  (standardTameCoverIntegralClosureAlgEquiv hf hf₀ h.choose_spec.1 h.choose_spec.2).symm

/-- The inverse of `integralClosureAlgEquivStandardTameCover` maps the root of
`X^{[L : K]} − f` to an `[L : K]`-th root of `f` in `L`. -/
@[simp]
theorem coe_integralClosureAlgEquivStandardTameCover_symm_root_pow (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) (hfe : ¬ f ∣ (e : A)) (φ : L →ₐ[K] K') :
    ((integralClosureAlgEquivStandardTameCover hf hf₀ hfe φ).symm (AdjoinRoot.root _) : L) ^
        Module.finrank K L =
      algebraMap A L f := by
  rw [integralClosureAlgEquivStandardTameCover, AlgEquiv.symm_symm,
    coe_standardTameCoverIntegralClosureAlgEquiv_root]
  exact (exists_pow_eq_and_adjoin_eq_top_of_algHom_standardTameCover hf hf₀ hfe φ).2.choose_spec.1

end Subextension

section MultiComponent

variable [IsRegularRing (A ⧸ Ideal.span {f})]

/-- Localizing an `A`-algebra decomposition `C ≃ₐ[A] ∏ᵢ A[x]/(x^{eᵢ} − f)` away from `f` transfers
étaleness of `S_f` to each factor and descends invertibility of `eᵢ` from `A_f` to `A` when
`¬ f ∣ (eᵢ : A)`. -/
private theorem isFiniteProductOfStandardTameCovers_of_algEquiv_pi (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) (Af Sf : Type*) [CommRing Af] [Algebra A Af]
    [IsLocalization.Away f Af] [CommRing Sf] [Algebra A Sf] [Algebra Af Sf]
    [IsScalarTower A Af Sf] [Algebra.Etale Af Sf] [Module.Finite Af Sf]
    {C : Type*} [CommRing C] [Algebra A C] [Algebra C Sf] [IsScalarTower A C Sf]
    [IsIntegralClosure C A Sf] {ι : Type} [Finite ι] {e_idx : ι → ℕ}
    (he_pos : ∀ i, 1 ≤ e_idx i) (he_ndvd : ∀ i, ¬ f ∣ (e_idx i : A))
    (Φ : C ≃ₐ[A] ∀ i : ι, standardTameCover A f (e_idx i)) :
    IsFiniteProductOfStandardTameCovers A C f := by
  classical
  let _ := Fintype.ofFinite ι
  obtain ⟨_, _, hfprime, -⟩ := isRegularLocalRing_and_isPrime_span hf hf₀
  have : IsLocalization (Algebra.algebraMapSubmonoid C (.powers f)) Sf :=
    IsIntegralClosure.isLocalization_of_isIntegral Af
  have := (Algebra.isPushout_of_isLocalization (.powers f) Af C Sf).symm
  let Φf : Sf ≃ₐ[Af] ∀ i : ι, standardTameCover Af (algebraMap A Af f) (e_idx i) :=
    (Algebra.IsPushout.equiv A Af C Sf).symm.trans <|
      (Algebra.TensorProduct.congr AlgEquiv.refl Φ).trans <|
        (Algebra.TensorProduct.piRight A Af Af _).trans <|
          AlgEquiv.piCongrRight fun i ↦ standardTameCoverBaseChangeAlgEquiv Af f (e_idx i)
  have : Algebra.Etale Af (∀ i : ι, standardTameCover Af (algebraMap A Af f) (e_idx i)) :=
    .of_equiv Φf
  have hunram : ∀ i : ι,
      Algebra.FormallyUnramified Af (standardTameCover Af (algebraMap A Af f) (e_idx i)) :=
    (Algebra.FormallyUnramified.pi_iff _).mp inferInstance
  refine (isFiniteProductOfStandardTameCovers_iff f).mpr
    ⟨ι, inferInstance, e_idx, he_pos, fun i ↦ ?_, ⟨Φ⟩⟩
  have := hunram i
  exact hfprime.isUnit_natCast_of_formallyUnramified_adjoinRoot_X_pow_sub_C_away
    (algebraMap A Af f) (he_ndvd i)

/-- **Multi-component Kummer identification from generic-fibre embeddings.** Let `A` be a
Noetherian local ring with regular divisor `f ∈ 𝔪_A`, let `A_f` be a localization of `A` away from
`f`, let `S_f` be a finite étale `A_f`-algebra, and let `C` be the integral closure of `A` in
`S_f`. If every field factor `(K ⊗[A_f] S_f) ⧸ m` of the generic fibre admits a `K`-algebra map
into the fraction field `K'` of `A[x]/(x^e − f)` for some `e` with `¬ f ∣ (e : A)`, then `C` is a
finite product of standard tamely ramified covers along `f`. -/
@[stacks 0EYG "product of standard tame covers from generic-fibre embeddings"]
theorem isFiniteProductOfStandardTameCovers_of_forall_algHom (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) (Af Sf : Type*) [CommRing Af] [Algebra A Af]
    [IsLocalization.Away f Af] [CommRing Sf] [Algebra A Sf] [Algebra Af Sf]
    [IsScalarTower A Af Sf] [Algebra.Etale Af Sf] [Module.Finite Af Sf]
    {C : Type*} [CommRing C] [Algebra A C] [Algebra C Sf] [IsScalarTower A C Sf]
    [IsIntegralClosure C A Sf] {e : ℕ} (hfe : ¬ f ∣ (e : A))
    {K K' : Type*} [Field K] [Algebra A K] [Algebra Af K] [IsScalarTower A Af K]
    [IsFractionRing A K] [Field K'] [Algebra A K'] [Algebra K K'] [IsScalarTower A K K']
    [Algebra (standardTameCover A f e) K'] [IsScalarTower A (standardTameCover A f e) K']
    [IsFractionRing (standardTameCover A f e) K']
    (hsplit : ∀ m : MaximalSpectrum (K ⊗[Af] Sf),
      Nonempty (((K ⊗[Af] Sf) ⧸ m.asIdeal) →ₐ[K] K')) :
    IsFiniteProductOfStandardTameCovers A C f := by
  obtain ⟨_, -, -, -⟩ := isRegularLocalRing_and_isPrime_span hf hf₀
  have hsub : Submonoid.powers f ≤ nonZeroDivisors A := Submonoid.powers_le.mpr hf₀
  have : IsDomain Af := IsLocalization.isDomain_of_le_nonZeroDivisors Af hsub
  have : IsIntegrallyClosed Af := isIntegrallyClosed_of_isLocalization Af (.powers f) hsub
  have : IsFractionRing Af K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (.powers f) Af K
  -- Decompose `C` over `MaximalSpectrum (K ⊗[Af] Sf)` and identify each factor.
  let e₁ := IsIntegralClosure.equivPiIntegralClosureQuotient A K (R := Af) (S := Sf) (C := C)
  let L : MaximalSpectrum (K ⊗[Af] Sf) → Type _ := fun m ↦ (K ⊗[Af] Sf) ⧸ m.asIdeal
  let fld (m : MaximalSpectrum (K ⊗[Af] Sf)) : Field (L m) :=
    letI := m.isMaximal; Ideal.Quotient.field m.asIdeal
  let d : MaximalSpectrum (K ⊗[Af] Sf) → ℕ := fun m ↦ @Module.finrank K (L m) _ _ _
  have hd_pos (m : MaximalSpectrum (K ⊗[Af] Sf)) : 1 ≤ d m := by
    let _ := fld m
    exact finrank_pos_of_algHom_standardTameCover hf hf₀ hfe (hsplit m).some
  have hd_ndvd (m : MaximalSpectrum (K ⊗[Af] Sf)) : ¬ f ∣ (d m : A) := by
    let _ := fld m
    exact not_dvd_natCast_finrank_of_algHom_standardTameCover hf hf₀ hfe (hsplit m).some
  let e₂ (m : MaximalSpectrum (K ⊗[Af] Sf)) :
      integralClosure A (L m) ≃ₐ[A] standardTameCover A f (d m) := by
    letI := fld m
    exact integralClosureAlgEquivStandardTameCover hf hf₀ hfe (hsplit m).some
  -- Reindex to `Type 0` and apply `isFiniteProductOfStandardTameCovers_of_algEquiv_pi`.
  let σ := Finite.equivFin (MaximalSpectrum (K ⊗[Af] Sf))
  exact isFiniteProductOfStandardTameCovers_of_algEquiv_pi hf hf₀ Af Sf
    (fun i ↦ hd_pos (σ.symm i)) (fun i ↦ hd_ndvd (σ.symm i))
    (e₁.trans ((AlgEquiv.piCongrRight e₂).trans (AlgEquiv.piCongrLeft' A _ σ)))

/-- **Multi-component Kummer identification from splitting over the fraction field of the root
cover.** If `K' ⊗[Af] Sf` is totally split (`Algebra.IsFiniteSplit`) over the fraction field `K'`
of `A[x]/(x^e − f)` with `¬ f ∣ (e : A)`, then `C` is a finite product of standard tamely ramified
covers along `f`. -/
theorem isFiniteProductOfStandardTameCovers_of_isFiniteSplit_fractionRing
    (hf : f ∈ maximalIdeal A) (hf₀ : f ∈ nonZeroDivisors A) (Af Sf : Type*) [CommRing Af]
    [Algebra A Af] [IsLocalization.Away f Af] [CommRing Sf] [Algebra A Sf] [Algebra Af Sf]
    [IsScalarTower A Af Sf] [Algebra.Etale Af Sf] [Module.Finite Af Sf]
    {C : Type*} [CommRing C] [Algebra A C] [Algebra C Sf] [IsScalarTower A C Sf]
    [IsIntegralClosure C A Sf] {e : ℕ} (hfe : ¬ f ∣ (e : A))
    (K K' : Type*) [Field K] [Algebra A K] [Algebra Af K] [IsScalarTower A Af K]
    [IsFractionRing A K] [Field K'] [Algebra A K'] [Algebra Af K'] [Algebra K K']
    [IsScalarTower A K K'] [IsScalarTower Af K K'] [Algebra (standardTameCover A f e) K']
    [IsScalarTower A (standardTameCover A f e) K'] [IsFractionRing (standardTameCover A f e) K']
    [Algebra.IsFiniteSplit K' (K' ⊗[Af] Sf)] :
    IsFiniteProductOfStandardTameCovers A C f := by
  have : Algebra.IsFiniteSplit K' (K' ⊗[K] (K ⊗[Af] Sf)) :=
    .of_algEquiv (Algebra.TensorProduct.cancelBaseChange Af K K' K' Sf).symm
  refine isFiniteProductOfStandardTameCovers_of_forall_algHom hf hf₀ Af Sf hfe (K := K) (K' := K')
    fun m ↦ ?_
  have := m.isMaximal
  exact Algebra.IsFiniteSplit.nonempty_algHom_of_surjective (K := K) (K' := K')
    (Ideal.Quotient.mkₐ K m.asIdeal) Ideal.Quotient.mk_surjective

/-- **Multi-component Kummer identification from splitting away from the divisor.** Let `A'_f` be a
localization of `A' = A[x]/(x^e − f)` away from the image of `f` (with `¬ f ∣ (e : A)`). If
`A'_f ⊗[Af] Sf` is totally split over `A'_f`, then the integral closure `C` of `A` in `Sf` is a
finite product of standard tamely ramified covers along `f`. No fraction fields need to be supplied
by the caller. -/
@[stacks 0EYG "product of standard tame covers from splitting over A[x]/(x^e - f)_f"]
theorem isFiniteProductOfStandardTameCovers_of_isFiniteSplit_away
    (hf : f ∈ maximalIdeal A) (hf₀ : f ∈ nonZeroDivisors A) (Af Sf : Type*) [CommRing Af]
    [Algebra A Af] [IsLocalization.Away f Af] [CommRing Sf] [Algebra A Sf] [Algebra Af Sf]
    [IsScalarTower A Af Sf] [Algebra.Etale Af Sf] [Module.Finite Af Sf]
    {C : Type*} [CommRing C] [Algebra A C] [Algebra C Sf] [IsScalarTower A C Sf]
    [IsIntegralClosure C A Sf] {e : ℕ} (hfe : ¬ f ∣ (e : A))
    (A'f : Type*) [CommRing A'f] [Algebra A A'f] [Algebra Af A'f] [IsScalarTower A Af A'f]
    [Algebra (standardTameCover A f e) A'f] [IsScalarTower A (standardTameCover A f e) A'f]
    [IsLocalization.Away (algebraMap A (standardTameCover A f e) f) A'f]
    [Algebra.IsFiniteSplit A'f (A'f ⊗[Af] Sf)] :
    IsFiniteProductOfStandardTameCovers A C f := by
  have he : e ≠ 0 := by rintro rfl; exact hfe (by simp)
  obtain ⟨_, -, -, -⟩ := isRegularLocalRing_and_isPrime_span hf hf₀
  let A' := standardTameCover A f e
  have := standardTameCover_isRegularLocalRing hf hf₀ he
  have := (monic_X_pow_sub_C f he).free_adjoinRoot
  -- Construct `K = FractionRing A` and `K' = FractionRing A'` with compatible tower structures.
  let K := FractionRing A
  let K' := FractionRing A'
  let _ : Algebra Af K :=
    IsLocalization.localizationAlgebraOfSubmonoidLe _ _ (.powers f) (nonZeroDivisors A)
      (Submonoid.powers_le.mpr hf₀)
  have : IsScalarTower A Af K :=
    IsLocalization.localization_isScalarTower_of_submonoid_le _ _ (.powers f) (nonZeroDivisors A)
      (Submonoid.powers_le.mpr hf₀)
  have : FaithfulSMul A K' := FaithfulSMul.trans A A' K'
  let _ : Algebra K K' := FractionRing.liftAlgebra A K'
  let _ : Algebra Af K' := ((algebraMap K K').comp (algebraMap Af K)).toAlgebra
  have : IsScalarTower Af K K' := .of_algebraMap_eq' rfl
  have : IsScalarTower A Af K' := .of_algebraMap_eq fun a ↦ by
    rw [RingHom.algebraMap_toAlgebra, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply A Af K,
      ← IsScalarTower.algebraMap_apply A K K']
  have hfA' : algebraMap A A' f ∈ nonZeroDivisors A' := by
    refine mem_nonZeroDivisors_iff_right.mpr fun x hx ↦ ?_
    exact Module.Flat.isSMulRegular_of_nonZeroDivisors hf₀
      (by simpa [Algebra.smul_def, mul_comm] using hx)
  let _ : Algebra A'f K' :=
    IsLocalization.localizationAlgebraOfSubmonoidLe _ _ (.powers (algebraMap A A' f))
      (nonZeroDivisors A') (Submonoid.powers_le.mpr hfA')
  have : IsScalarTower A' A'f K' :=
    IsLocalization.localization_isScalarTower_of_submonoid_le _ _ (.powers (algebraMap A A' f))
      (nonZeroDivisors A') (Submonoid.powers_le.mpr hfA')
  have : IsScalarTower Af A'f K' := by
    refine .of_algebraMap_eq' <| IsLocalization.ringHom_ext (.powers f) <| RingHom.ext fun a ↦ ?_
    simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply A Af A'f,
      IsScalarTower.algebraMap_apply A A' A'f, ← IsScalarTower.algebraMap_apply A' A'f K',
      ← IsScalarTower.algebraMap_apply A A' K', ← IsScalarTower.algebraMap_apply A Af K']
  -- Base-change `IsFiniteSplit A'f (A'f ⊗[Af] Sf)` along `A'f → K'`.
  have : Algebra.IsFiniteSplit K' (K' ⊗[Af] Sf) :=
    .of_algEquiv (Algebra.TensorProduct.cancelBaseChange Af A'f K' K' Sf)
  exact isFiniteProductOfStandardTameCovers_of_isFiniteSplit_fractionRing
    hf hf₀ Af Sf hfe K K'

end MultiComponent

end RegularDivisorLocal

section StrictlyHenselian

/-- **Kummer-extension identification over a strictly henselian base (Stacks 0EYG).** Let `A` be a
strictly henselian Noetherian local ring with regular divisor `f ∈ 𝔪_A`, let `A_f` be a localization
of `A` away from `f`, let `S_f` be a finite étale `A_f`-algebra, and let `C` be the integral
closure of `A` in `S_f`. Suppose that after extracting an `e`-th root `A' = A[x]/(x^e − f)` with
`¬ f ∣ (e : A)` (in particular when `IsUnit (e : A)`), the pullback `A'_f ⊗[A_f] S_f` away from `f`
extends to a finite étale `A'`-algebra `T`. Then `C` is a finite product of standard tamely
ramified covers along `f`. -/
@[stacks 0EYG "local identification from a finite étale cover of A[x]/(x^e - f)"]
theorem isFiniteProductOfStandardTameCovers_of_exists_etale_standardTameCover
    {A : Type*} [CommRing A] [IsNoetherianRing A] [HenselianLocalRing A]
    [IsSepClosed (ResidueField A)] {f : A} (hf : f ∈ maximalIdeal A) (hf₀ : f ∈ nonZeroDivisors A)
    [IsRegularRing (A ⧸ Ideal.span {f})] (Af Sf : Type*) [CommRing Af] [Algebra A Af]
    [IsLocalization.Away f Af] [CommRing Sf] [Algebra A Sf] [Algebra Af Sf]
    [IsScalarTower A Af Sf] [Algebra.Etale Af Sf] [Module.Finite Af Sf]
    {C : Type*} [CommRing C] [Algebra A C] [Algebra C Sf] [IsScalarTower A C Sf]
    [IsIntegralClosure C A Sf] {e : ℕ} (hfe : ¬ f ∣ (e : A))
    (A'f : Type*) [CommRing A'f] [Algebra A A'f] [Algebra Af A'f] [IsScalarTower A Af A'f]
    [Algebra (standardTameCover A f e) A'f] [IsScalarTower A (standardTameCover A f e) A'f]
    [IsLocalization.Away (algebraMap A (standardTameCover A f e) f) A'f]
    {T : Type*} [CommRing T] [Algebra (standardTameCover A f e) T]
    [Algebra.Etale (standardTameCover A f e) T] [Module.Finite (standardTameCover A f e) T]
    (φ : A'f ⊗[standardTameCover A f e] T ≃ₐ[A'f] A'f ⊗[Af] Sf) :
    IsFiniteProductOfStandardTameCovers A C f := by
  have he : e ≠ 0 := by rintro rfl; exact hfe (by simp)
  have := standardTameCover_isLocalRing hf he
  have := standardTameCover_henselianLocalRing hf he
  have := standardTameCover_isSepClosed_residueField (e := e) hf
  have : Algebra.IsFiniteSplit (standardTameCover A f e) T := .of_henselianLocalRing _ T
  have : Algebra.IsFiniteSplit A'f (A'f ⊗[Af] Sf) := .of_algEquiv φ
  exact isFiniteProductOfStandardTameCovers_of_isFiniteSplit_away hf hf₀ Af Sf hfe A'f

end StrictlyHenselian

section Converse

/-- **Every finite product of standard tame covers becomes finite étale after a single tame root
extraction.** Over *any* commutative ring `A`, if `C` is a finite product of standard tame covers
`∏ᵢ A[x]/(x^{eᵢ} − f)` with `eᵢ ≥ 1` invertible in `A`, then for `e = ∏ᵢ eᵢ` (which satisfies
`1 ≤ e` and `IsUnit (e : A)`), the `A'`-algebra `T = ∏ᵢ A'[u]/(u^{eᵢ} − 1)` over
`A' = A[x]/(x^e − f)` is finite étale across all of `Spec A'`, and over any localization `A'_f` of
`A'` away from `f` there is an `A'_f`-algebra isomorphism `A'_f ⊗[A'] T ≃ₐ[A'_f] A'_f ⊗[A] C`. -/
theorem IsFiniteProductOfStandardTameCovers.exists_etale_standardTameCover_tensorProduct
    {A : Type u} [CommRing A] {C : Type*} [CommRing C] [Algebra A C] {f : A}
    (h : IsFiniteProductOfStandardTameCovers A C f) :
    ∃ (e : ℕ) (_ : 1 ≤ e) (_ : IsUnit (e : A)) (T : Type u) (_ : CommRing T)
      (_ : Algebra (standardTameCover A f e) T) (_ : Algebra.Etale (standardTameCover A f e) T)
      (_ : Module.Finite (standardTameCover A f e) T),
      ∀ (A'f : Type u) [CommRing A'f] [Algebra A A'f] [Algebra (standardTameCover A f e) A'f]
        [IsScalarTower A (standardTameCover A f e) A'f]
        [IsLocalization.Away (algebraMap A (standardTameCover A f e) f) A'f],
        Nonempty (A'f ⊗[standardTameCover A f e] T ≃ₐ[A'f] A'f ⊗[A] C) := by
  classical
  obtain ⟨ι, _, d, hd1, hdu, ⟨ψ⟩⟩ := (isFiniteProductOfStandardTameCovers_iff f).mp h
  let e : ℕ := ∏ i : ι, d i
  have he1 : 1 ≤ e := Finset.one_le_prod fun i _ ↦ hd1 i
  have heu : IsUnit (e : A) := by
    rw [Nat.cast_prod]
    exact Finset.prod_induction _ IsUnit (fun _ _ ↦ IsUnit.mul) isUnit_one fun i _ ↦ hdu i
  let A' : Type u := standardTameCover A f e
  let T : Type u := ∀ i : ι, standardTameCover A' 1 (d i)
  have hEt (i : ι) : Algebra.Etale A' (standardTameCover A' 1 (d i)) :=
    standardTameCover_etale isUnit_one (by simpa using (hdu i).map (algebraMap A A'))
  have hFin (i : ι) : Module.Finite A' (standardTameCover A' 1 (d i)) :=
    (monic_X_pow_sub_C 1 (Nat.ne_of_gt (hd1 i))).finite_adjoinRoot
  refine ⟨e, he1, heu, T, inferInstance, inferInstance, inferInstance, inferInstance,
    fun A'f _ _ _ _ _ ↦ ⟨?_⟩⟩
  -- Over `A'f`, `(x ^ (e / d i)) ^ d i = f` is a unit, so scaling identifies `X^{d i} - 1`
  -- with `X^{d i} - f`.
  let y : A' := AdjoinRoot.root (X ^ e - Polynomial.C f)
  have hu_pow (i : ι) : (algebraMap A' A'f (y ^ (e / d i))) ^ d i = algebraMap A A'f f := by
    rw [← map_pow, ← pow_mul, Nat.div_mul_cancel (Finset.dvd_prod_of_mem d (Finset.mem_univ i)),
      AdjoinRoot.root_X_pow_sub_C_pow, ← AdjoinRoot.algebraMap_eq,
      ← IsScalarTower.algebraMap_apply A A' A'f]
  have hu (i : ι) : IsUnit (algebraMap A' A'f (y ^ (e / d i))) := by
    rw [← isUnit_pow_iff (Nat.ne_of_gt (hd1 i)), hu_pow i, IsScalarTower.algebraMap_apply A A' A'f]
    exact IsLocalization.Away.algebraMap_isUnit (algebraMap A A' f)
  let eqFactor (i : ι) :
      A'f ⊗[A'] standardTameCover A' 1 (d i) ≃ₐ[A'f] A'f ⊗[A] standardTameCover A f (d i) :=
    (standardTameCoverBaseChangeAlgEquiv A'f (1 : A') (d i)).trans <|
      (AdjoinRoot.mapAlgEquiv AlgEquiv.refl _ (X ^ d i - Polynomial.C (1 : A'f))
        (.of_eq (by simp))).trans <|
        (standardTameCoverOneAlgEquivOfPowEq (hu i) (hu_pow i)).trans <|
          (standardTameCoverBaseChangeAlgEquiv A'f f (d i)).symm
  exact (Algebra.TensorProduct.piRight A' A'f A'f (fun i ↦ standardTameCover A' 1 (d i))).trans <|
    (AlgEquiv.piCongrRight eqFactor).trans <|
      (Algebra.TensorProduct.piRight A A'f A'f (fun i ↦ standardTameCover A f (d i))).symm.trans <|
        Algebra.TensorProduct.congr AlgEquiv.refl ψ.symm

/-- **Characterization of products of standard tame covers over a strictly henselian regular-divisor
local base.** Let `A` be a strictly henselian Noetherian local ring with regular divisor `f ∈ 𝔪_A`,
let `A_f` be a localization of `A` away from `f`, let `S_f` be a finite étale `A_f`-algebra, and
let `C` be the integral closure of `A` in `S_f`. Then `C` is a finite product of standard tamely
ramified covers along `f` if and only if there exist a unit exponent `e ≥ 1` in `A` and a finite
étale `(A[x]/(x^e − f))`-algebra `T` whose restriction away from `f` is isomorphic to the pullback
of `S_f`. -/
@[stacks 0EYG "characterization of standard tame covers via Kummer root extraction"]
theorem isFiniteProductOfStandardTameCovers_iff_exists_etale_standardTameCover
    {A : Type u} [CommRing A] [IsNoetherianRing A] [HenselianLocalRing A]
    [IsSepClosed (ResidueField A)] {f : A} (hf : f ∈ maximalIdeal A) (hf₀ : f ∈ nonZeroDivisors A)
    [IsRegularRing (A ⧸ Ideal.span {f})] (Af Sf : Type*) [CommRing Af] [Algebra A Af]
    [IsLocalization.Away f Af] [CommRing Sf] [Algebra A Sf] [Algebra Af Sf]
    [IsScalarTower A Af Sf] [Algebra.Etale Af Sf] [Module.Finite Af Sf]
    {C : Type*} [CommRing C] [Algebra A C] [Algebra C Sf] [IsScalarTower A C Sf]
    [IsIntegralClosure C A Sf] :
    IsFiniteProductOfStandardTameCovers A C f ↔
      ∃ (e : ℕ) (_ : 1 ≤ e) (_ : IsUnit (e : A)) (T : Type u) (_ : CommRing T)
        (_ : Algebra (standardTameCover A f e) T) (_ : Algebra.Etale (standardTameCover A f e) T)
        (_ : Module.Finite (standardTameCover A f e) T),
        ∀ (A'f : Type u) [CommRing A'f] [Algebra A A'f] [Algebra Af A'f] [IsScalarTower A Af A'f]
          [Algebra (standardTameCover A f e) A'f] [IsScalarTower A (standardTameCover A f e) A'f]
          [IsLocalization.Away (algebraMap A (standardTameCover A f e) f) A'f],
          Nonempty (A'f ⊗[standardTameCover A f e] T ≃ₐ[A'f] A'f ⊗[Af] Sf) := by
  constructor
  · intro hC
    obtain ⟨e, he1, heu, T, _, _, _, _, hT⟩ := hC.exists_etale_standardTameCover_tensorProduct
    have : IsLocalization (Algebra.algebraMapSubmonoid C (.powers f)) Sf :=
      IsIntegralClosure.isLocalization_of_isIntegral Af
    have := (Algebra.isPushout_of_isLocalization (.powers f) Af C Sf).symm
    refine ⟨e, he1, heu, T, inferInstance, inferInstance, inferInstance, inferInstance,
      fun A'f _ _ _ _ _ _ _ ↦ ?_⟩
    obtain ⟨φ₀⟩ := hT A'f
    exact ⟨φ₀.trans <| (Algebra.TensorProduct.cancelBaseChange A Af A'f A'f C).symm.trans <|
      Algebra.TensorProduct.congr AlgEquiv.refl (Algebra.IsPushout.equiv A Af C Sf)⟩
  · rintro ⟨e, -, heu, T, _, _, _, _, hT⟩
    have hfe : ¬ f ∣ (e : A) := fun hdvd ↦ hf (isUnit_of_dvd_unit hdvd heu)
    let A' := standardTameCover A f e
    let A'f := Localization.Away (algebraMap A A' f)
    let _ : Algebra Af A'f := (IsLocalization.Away.lift f
      (by
        rw [IsScalarTower.algebraMap_apply A A' A'f]
        exact IsLocalization.Away.algebraMap_isUnit (algebraMap A A' f))).toAlgebra
    have : IsScalarTower A Af A'f := .of_algebraMap_eq fun a ↦ by
      simp [RingHom.algebraMap_toAlgebra]
    obtain ⟨φ⟩ := hT A'f
    exact isFiniteProductOfStandardTameCovers_of_exists_etale_standardTameCover
      hf hf₀ Af Sf hfe A'f φ

end Converse

end TauCeti
