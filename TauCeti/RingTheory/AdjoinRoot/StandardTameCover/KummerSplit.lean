open IntermediateField IsLocalRing Polynomial TensorProduct

namespace TauCeti

section Helpers

private theorem ne_zero_of_not_dvd_natCast {A : Type*} [CommRing A] {f : A} {e : ℕ}
    (hfe : ¬ f ∣ (e : A)) : e ≠ 0 := by
  rintro rfl
  exact hfe (by simp)

private theorem isIntegral_of_pow_eq {A L : Type*} [CommRing A] [CommRing L] [Algebra A L] {f : A}
    {n : ℕ} (hn : n ≠ 0) {γ : L} (hγ : γ ^ n = algebraMap A L f) : IsIntegral A γ :=
  ⟨X ^ n - Polynomial.C f, monic_X_pow_sub_C f hn, by simp [hγ]⟩

private theorem mem_maximalIdeal_of_not_dvd {A : Type*} [CommRing A] [IsLocalRing A] {f a : A}
    (hfa : ¬ f ∣ a) : f ∈ maximalIdeal A :=
  of_not_not fun h ↦ hfa (notMem_maximalIdeal.mp h).dvd

/-- If `A ⧸ (f)` is reduced and `f` does not divide `a`, then some minimal prime of `(f)` does not
contain `a`. -/
private theorem exists_mem_minimalPrimes_notMem_of_not_dvd {A : Type*} [CommRing A] {f a : A}
    [IsReduced (A ⧸ Ideal.span {f})] (hfa : ¬ f ∣ a) :
    ∃ p ∈ (Ideal.span {f}).minimalPrimes, a ∉ p := by
  by_contra! hall
  have hrad : (Ideal.span {f}).radical = Ideal.span {f} :=
    ((Ideal.isRadical_iff_quotient_reduced _).mpr inferInstance).radical
  have ha : a ∈ Ideal.span {f} := by
    rw [← hrad, ← Ideal.sInf_minimalPrimes, Ideal.mem_sInf]
    exact hall
  exact hfa (Ideal.mem_span_singleton.mp ha)

/-- Localizing a Noetherian domain `A` at a prime `p` minimal over a reduced nonzerodivisor `(f)`
gives a discrete valuation ring in which the image of `f` is irreducible. -/
private theorem isDiscreteValuationRing_and_irreducible_atPrime {A : Type*} [CommRing A]
    [IsDomain A] [IsNoetherianRing A] {f : A} (hf₀ : f ∈ nonZeroDivisors A)
    [IsReduced (A ⧸ Ideal.span {f})] {p : Ideal A} [p.IsPrime]
    (hp : p ∈ (Ideal.span {f}).minimalPrimes) :
    IsDiscreteValuationRing (Localization.AtPrime p) ∧
      Irreducible (algebraMap A (Localization.AtPrime p) f) := by
  let Aₚ := Localization.AtPrime p
  have : _root_.IsRegularLocalRing Aₚ := isRegularLocalRing_of_mem_minimalPrimes Aₚ hf₀ hp
  exact ⟨isDiscreteValuationRing_of_mem_minimalPrimes Aₚ hf₀ hp,
    irreducible_algebraMap_of_mem_minimalPrimes Aₚ hf₀ hp⟩

end Helpers

section ReducedDivisor

variable {A : Type*} [CommRing A] [IsNoetherianRing A] {f : A} [IsReduced (A ⧸ Ideal.span {f})]

/-- If `f` is a non-unit nonzerodivisor in a Noetherian ring `A` with `A ⧸ (f)` reduced, then
`X ^ n - C f` is irreducible over any fraction field `K` of `A` for `n ≠ 0`: localizing at a
minimal prime of `(f)` gives a discrete valuation ring with uniformizer `f` and fraction field `K`,
where `X ^ n - C f` is Eisenstein. -/
theorem irreducible_X_pow_sub_C_of_isReduced_quotient (hf : ¬ IsUnit f)
    (hf₀ : f ∈ nonZeroDivisors A) {n : ℕ} (hn : n ≠ 0)
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K] :
    Irreducible (X ^ n - Polynomial.C (algebraMap A K f)) := by
  have : IsDomain A := (IsFractionRing.injective A K).isDomain _
  obtain ⟨p, hp, -⟩ := exists_mem_minimalPrimes_notMem_of_not_dvd (f := f) (a := 1)
    (mt isUnit_of_dvd_one hf)
  have : p.IsPrime := hp.1.1
  have ⟨_, hπ⟩ := isDiscreteValuationRing_and_irreducible_atPrime hf₀ hp
  rw [IsScalarTower.algebraMap_apply A (Localization.AtPrime p) K]
  exact X_pow_sub_C_irreducible_of_irreducible hπ hn

/-- Over a Noetherian ring `A` in which `f` is a non-unit nonzerodivisor with `A ⧸ (f)` reduced,
the generic fibre `K ⊗[A] A[x]/(x^n − f)` of a positive-degree standard cover is a field. -/
theorem standardTameCover_isField_tensorProduct (hf : ¬ IsUnit f)
    (hf₀ : f ∈ nonZeroDivisors A) {n : ℕ} (hn : n ≠ 0)
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K] :
    IsField (K ⊗[A] standardTameCover A f n) := by
  have : Fact (Irreducible (X ^ n - Polynomial.C (algebraMap A K f))) :=
    ⟨irreducible_X_pow_sub_C_of_isReduced_quotient hf hf₀ hn K⟩
  exact MulEquiv.isField (Field.toIsField (standardTameCover K (algebraMap A K f) n))
    (standardTameCoverBaseChangeAlgEquiv K f n).toMulEquiv

/-- **Degree of a root extension along a reduced divisor.** Let `A` be a Noetherian ring and `f` a
non-unit nonzerodivisor with `A ⧸ (f)` reduced. If `L = K(γ)` is generated over a fraction field
`K` of `A` by an `n`-th root `γ` of `f`, then `[L : K] = n`. -/
theorem finrank_eq_of_pow_eq_of_isReduced_quotient
    {K L : Type*} [Field K] [Algebra A K] [IsFractionRing A K]
    [Field L] [Algebra A L] [Algebra K L] [IsScalarTower A K L]
    (hf : ¬ IsUnit f) (hf₀ : f ∈ nonZeroDivisors A) {n : ℕ} {γ : L}
    (hγ : γ ^ n = algebraMap A L f) (hgen : K⟮γ⟯ = ⊤) :
    Module.finrank K L = n := by
  have : IsDomain A := (IsFractionRing.injective A K).isDomain _
  obtain ⟨p, hp, -⟩ := exists_mem_minimalPrimes_notMem_of_not_dvd (f := f) (a := 1)
    (mt isUnit_of_dvd_one hf)
  have : p.IsPrime := hp.1.1
  let Aₚ := Localization.AtPrime p
  have ⟨_, hπ⟩ := isDiscreteValuationRing_and_irreducible_atPrime hf₀ hp
  let _ : Algebra Aₚ L := ((algebraMap K L).comp (algebraMap Aₚ K)).toAlgebra
  have : IsScalarTower Aₚ K L := .of_algebraMap_eq' rfl
  have hγ' : γ ^ n = algebraMap Aₚ L (algebraMap A Aₚ f) := by
    rw [RingHom.algebraMap_toAlgebra, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply A Aₚ K,
      ← IsScalarTower.algebraMap_apply A K L, hγ]
  exact IsDiscreteValuationRing.finrank_eq_of_pow_eq_of_irreducible hπ hγ' hgen

/-- **Subextensions of the fraction field of a tame root cover.** Let `A` be a Noetherian ring and
`f` a nonzerodivisor with `A ⧸ (f)` reduced and `¬ f ∣ (e : A)`, and let `K'` be a fraction field of
`A[x]/(x^e − f)` over a fraction field `K` of `A`. For every `K`-algebra map `φ : L →ₐ[K] K'` from a
field `L`, `L` is generated over `K` by an `[L : K]`-th root `γ` of `f` whose image under `φ` is the
`(e / [L : K])`-th power of the root of `A[x]/(x^e − f)` in `K'`. -/
@[stacks 0EYG "subfields of the generic fibre of A[x]/(x^e - f)"]
theorem exists_pow_eq_and_adjoin_eq_top_of_algHom_standardTameCover {e : ℕ}
    {K K' L : Type*} [Field K] [Algebra A K] [IsFractionRing A K]
    [Field K'] [Algebra A K'] [Algebra K K'] [IsScalarTower A K K']
    [Algebra (standardTameCover A f e) K'] [IsScalarTower A (standardTameCover A f e) K']
    [IsFractionRing (standardTameCover A f e) K']
    [Field L] [Algebra A L] [Algebra K L] [IsScalarTower A K L]
    (hf₀ : f ∈ nonZeroDivisors A) (hfe : ¬ f ∣ (e : A)) (φ : L →ₐ[K] K') :
    ∃ γ : L, γ ^ Module.finrank K L = algebraMap A L f ∧ K⟮γ⟯ = ⊤ ∧
      φ γ = algebraMap (standardTameCover A f e) K'
        (AdjoinRoot.root _ ^ (e / Module.finrank K L)) := by
  have he : e ≠ 0 := ne_zero_of_not_dvd_natCast hfe
  have : IsDomain A := (IsFractionRing.injective A K).isDomain _
  obtain ⟨p, hp, he_notMem⟩ := exists_mem_minimalPrimes_notMem_of_not_dvd hfe
  have : p.IsPrime := hp.1.1
  let Aₚ := Localization.AtPrime p
  have ⟨_, hπ⟩ := isDiscreteValuationRing_and_irreducible_atPrime hf₀ hp
  -- `e ∉ p` becomes a unit in `Aₚ`, hence in its residue field.
  have he_unit : IsUnit (e : Aₚ ⧸ maximalIdeal Aₚ) := by
    have he_unit_loc : IsUnit (e : Aₚ) := by
      simpa using IsLocalization.map_units Aₚ (⟨(e : A), he_notMem⟩ : p.primeCompl)
    simpa using he_unit_loc.map (Ideal.Quotient.mk (maximalIdeal Aₚ))
  -- The root `α` of `A[x]/(x^e - f)` in `K'` generates `K'` over `K` and satisfies `α ^ e = f`.
  let α : K' := algebraMap (standardTameCover A f e) K' (AdjoinRoot.root _)
  have hα : α ^ e = algebraMap A K' f := standardTameCover_algebraMap_root_pow
  have hgenK' : K⟮α⟯ = ⊤ :=
    IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top (R := A)
      (S := standardTameCover A f e) (K := K) (L := K') AdjoinRoot.adjoinRoot_eq_top
  let _ : Algebra Aₚ K' := ((algebraMap K K').comp (algebraMap Aₚ K)).toAlgebra
  have : IsScalarTower Aₚ K K' := .of_algebraMap_eq' rfl
  have hα' : α ^ e = algebraMap Aₚ K' (algebraMap A Aₚ f) := by
    rw [RingHom.algebraMap_toAlgebra, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply A Aₚ K,
      ← IsScalarTower.algebraMap_apply A K K', hα]
  -- Apply Stacks 09EV (6) to the intermediate field `φ.fieldRange` of `K' / K`.
  have hfinK' : Module.finrank K K' = e :=
    standardTameCover_finrank_fractionRing f (Nat.one_le_iff_ne_zero.mpr he) K K'
  have : FiniteDimensional K K' := Module.finite_of_finrank_pos (hfinK' ▸ Nat.pos_of_ne_zero he)
  let r := Module.finrank φ.fieldRange K'
  have hM : φ.fieldRange = K⟮α ^ r⟯ :=
    IsDiscreteValuationRing.eq_adjoin_pow_finrank_of_pow_eq_of_irreducible hπ he_unit hα' hgenK'
      φ.fieldRange
  have hmul : Module.finrank K L * r = e := by
    dsimp only [r]
    rw [φ.equivFieldRange.toLinearEquiv.finrank_eq,
      Module.finrank_mul_finrank K φ.fieldRange K', hfinK']
  have hd_pos : 0 < Module.finrank K L :=
    Nat.pos_of_ne_zero fun h ↦ he (by simpa [h] using hmul.symm)
  have hr_eq : r = e / Module.finrank K L :=
    (Nat.div_eq_of_eq_mul_right hd_pos hmul.symm).symm
  obtain ⟨γ, hφγ⟩ := φ.mem_fieldRange.mp (by rw [hM]; exact mem_adjoin_simple_self K (α ^ r))
  have hφ_inj : Function.Injective φ := φ.injective
  have hγ_pow : γ ^ Module.finrank K L = algebraMap A L f := hφ_inj <| by
    rw [map_pow, hφγ, ← pow_mul, mul_comm, hmul, hα, IsScalarTower.algebraMap_apply A K L,
      AlgHom.commutes, ← IsScalarTower.algebraMap_apply A K K']
  have hmap : (K⟮γ⟯).map φ = φ.fieldRange := by
    rw [adjoin_map, Set.image_singleton, hφγ, ← hM]
  refine ⟨γ, hγ_pow, eq_top_iff.mpr fun x _ ↦ ?_, by rw [hφγ, hr_eq, map_pow]⟩
  have hx : φ x ∈ (K⟮γ⟯).map φ := by rw [hmap]; exact φ.mem_fieldRange.mpr ⟨x, rfl⟩
  obtain ⟨y, hy, hyx⟩ := hx
  exact hφ_inj hyx ▸ hy

end ReducedDivisor

section RegularDivisorLocal

variable {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A] {f : A}

/-- In a Noetherian local ring `A`, a nonzerodivisor `f ∈ 𝔪_A` with `A ⧸ (f)` regular makes `A` a
regular local ring (hence an integrally closed domain) and `f` a prime element. -/
private theorem isRegularLocalRing_and_prime (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) [IsRegularRing (A ⧸ Ideal.span {f})] :
    _root_.IsRegularLocalRing A ∧ Prime f := by
  have : Nontrivial (A ⧸ Ideal.span {f}) := Ideal.Quotient.nontrivial_iff.mpr fun h ↦
    (maximalIdeal.isMaximal A).ne_top
      (top_le_iff.mp (h ▸ (Ideal.span_singleton_le_iff_mem _).mpr hf))
  have : IsLocalRing (A ⧸ Ideal.span {f}) :=
    IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  have : _root_.IsRegularLocalRing (A ⧸ Ideal.span {f}) := .of_isRegularRing_of_isLocalRing _
  have hreg : _root_.IsRegularLocalRing A :=
    TauCeti.IsRegularLocalRing.of_quotient_nonZeroDivisor A hf hf₀
  have hprime : (Ideal.span {f}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp inferInstance
  exact ⟨hreg, (Ideal.span_singleton_prime (nonZeroDivisors.ne_zero hf₀)).mp hprime⟩

section SingleComponent

variable [IsRegularRing (A ⧸ Ideal.span {f})]
  {K L : Type*} [Field K] [Algebra A K] [IsFractionRing A K]
  [Field L] [Algebra A L] [Algebra K L] [IsScalarTower A K L]

/-- **Single-component normalization along a regular divisor.** If `L = K(γ)` is generated over a
fraction field `K` of `A` by an `n`-th root `γ` of `f ∈ 𝔪_A`, then the standard cover
`A[x]/(x^n − f)` is canonically `A`-isomorphic to `integralClosure A L`, sending the root `x` to
`γ`. -/
noncomputable def standardTameCoverIntegralClosureAlgEquiv (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) {n : ℕ} {γ : L} (hγ : γ ^ n = algebraMap A L f)
    (hgen : K⟮γ⟯ = ⊤) :
    standardTameCover A f n ≃ₐ[A] integralClosure A L := by
  obtain ⟨_, _⟩ := isRegularLocalRing_and_prime hf hf₀
  have := FaithfulSMul.trans A K L
  have hf_nu : ¬ IsUnit f := fun hu ↦ notMem_maximalIdeal.mpr hu hf
  have hn : n ≠ 0 :=
    Algebra.ne_zero_of_pow_eq_algebraMap_of_injective (a := f)
      (FaithfulSMul.algebraMap_injective A L) (fun h1 ↦ hf_nu (h1 ▸ isUnit_one)) hγ
  have hγ_int : IsIntegral A γ := isIntegral_of_pow_eq hn hγ
  have hminK : minpoly K γ = X ^ n - Polynomial.C (algebraMap A K f) :=
    (minpoly.eq_of_irreducible_of_monic
      (irreducible_X_pow_sub_C_of_isReduced_quotient hf_nu hf₀ hn K)
      (by simp [← IsScalarTower.algebraMap_apply A K L, hγ])
      (monic_X_pow_sub_C _ hn)).symm
  have hmin : X ^ n - Polynomial.C f = minpoly A γ :=
    Polynomial.map_injective (algebraMap A K) (IsFractionRing.injective A K) <| by
      rw [← minpoly.isIntegrallyClosed_eq_field_fractions' K hγ_int, hminK]
      simp
  have : Module.Finite A (Algebra.adjoin A ({γ} : Set L)) :=
    have : Module.Finite A (standardTameCover A f n) := (monic_X_pow_sub_C f hn).finite_adjoinRoot
    Module.Finite.equiv
      ((AdjoinRoot.algEquivOfEq A _ _ hmin).trans (minpoly.equivAdjoin hγ_int)).toLinearEquiv
  have : IsIntegrallyClosed (Algebra.adjoin A ({γ} : Set L)) :=
    have := standardTameCover_isIntegrallyClosed hf hf₀ hn
    IsIntegrallyClosed.of_equiv
      ((AdjoinRoot.algEquivOfEq A _ _ hmin).trans (minpoly.equivAdjoin hγ_int)).toRingEquiv
  have : IsFractionRing (Algebra.adjoin A ({γ} : Set L)) L :=
    IntermediateField.isFractionRing_algebra_adjoin_of_adjoin_eq_top hgen
  exact ((AdjoinRoot.algEquivOfEq A _ _ hmin).trans (minpoly.equivAdjoin hγ_int)).trans
    (IsIntegralClosure.equiv A (Algebra.adjoin A ({γ} : Set L)) L (integralClosure A L))

/-- `standardTameCoverIntegralClosureAlgEquiv` sends the root of `X^n − f` to `γ`. -/
@[simp]
theorem coe_standardTameCoverIntegralClosureAlgEquiv_root (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) {n : ℕ} {γ : L} (hγ : γ ^ n = algebraMap A L f)
    (hgen : K⟮γ⟯ = ⊤) :
    (standardTameCoverIntegralClosureAlgEquiv hf hf₀ hγ hgen (AdjoinRoot.root _) : L) = γ := by
  have h1 {_ : IsIntegralClosure (Algebra.adjoin A ({γ} : Set L)) A L}
      (x : Algebra.adjoin A ({γ} : Set L)) :
      (IsIntegralClosure.equiv A (Algebra.adjoin A ({γ} : Set L)) L (integralClosure A L) x : L) =
        (x : L) :=
    IsIntegralClosure.algebraMap_equiv A (Algebra.adjoin A ({γ} : Set L)) L (integralClosure A L) x
  rw [standardTameCoverIntegralClosureAlgEquiv, AlgEquiv.trans_apply, AlgEquiv.trans_apply, h1,
    AdjoinRoot.algEquivOfEq_root]
  simp

/-- The inverse of `standardTameCoverIntegralClosureAlgEquiv` sends `⟨γ, hγ_mem⟩` to the root of
`X^n − f`. -/
@[simp]
theorem standardTameCoverIntegralClosureAlgEquiv_symm_mk (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) {n : ℕ} {γ : L} (hγ : γ ^ n = algebraMap A L f)
    (hgen : K⟮γ⟯ = ⊤) (hγ_mem : γ ∈ integralClosure A L) :
    (standardTameCoverIntegralClosureAlgEquiv hf hf₀ hγ hgen).symm ⟨γ, hγ_mem⟩ =
      AdjoinRoot.root _ := by
  rw [AlgEquiv.symm_apply_eq]
  exact Subtype.ext (coe_standardTameCoverIntegralClosureAlgEquiv_root hf hf₀ hγ hgen).symm

end SingleComponent

section Subextension

variable [IsRegularRing (A ⧸ Ideal.span {f})] {e : ℕ}
  {K K' L : Type*} [Field K] [Algebra A K] [IsFractionRing A K]
  [Field K'] [Algebra A K'] [Algebra K K'] [IsScalarTower A K K']
  [Algebra (standardTameCover A f e) K'] [IsScalarTower A (standardTameCover A f e) K']
  [IsFractionRing (standardTameCover A f e) K']
  [Field L] [Algebra A L] [Algebra K L] [IsScalarTower A K L]

/-- **Integral closure in a subfield of a tame root cover.** Let `A` be a Noetherian local ring,
`f` a nonzerodivisor of `A` with `A ⧸ (f)` regular and `¬ f ∣ (e : A)`, and `φ : L →ₐ[K] K'` a
`K`-algebra embedding into a fraction field `K'` of `A[x]/(x^e − f)`. Then `integralClosure A L` is
`A`-isomorphic to `A[x]/(x^{[L : K]} − f)`. -/
noncomputable def integralClosureAlgEquivStandardTameCover
    (hf₀ : f ∈ nonZeroDivisors A) (hfe : ¬ f ∣ (e : A)) (φ : L →ₐ[K] K') :
    integralClosure A L ≃ₐ[A] standardTameCover A f (Module.finrank K L) :=
  let h := exists_pow_eq_and_adjoin_eq_top_of_algHom_standardTameCover hf₀ hfe φ
  (standardTameCoverIntegralClosureAlgEquiv (mem_maximalIdeal_of_not_dvd hfe) hf₀
    h.choose_spec.1 h.choose_spec.2.1).symm

/-- The inverse of `integralClosureAlgEquivStandardTameCover` maps the root of
`X^{[L : K]} − f` to an `[L : K]`-th root of `f` in `L`. -/
@[simp]
theorem coe_integralClosureAlgEquivStandardTameCover_symm_root_pow
    (hf₀ : f ∈ nonZeroDivisors A) (hfe : ¬ f ∣ (e : A)) (φ : L →ₐ[K] K') :
    ((integralClosureAlgEquivStandardTameCover hf₀ hfe φ).symm (AdjoinRoot.root _) : L) ^
        Module.finrank K L =
      algebraMap A L f := by
  rw [integralClosureAlgEquivStandardTameCover, AlgEquiv.symm_symm,
    coe_standardTameCoverIntegralClosureAlgEquiv_root]
  exact (exists_pow_eq_and_adjoin_eq_top_of_algHom_standardTameCover hf₀ hfe φ).choose_spec.1

/-- The image of the root under `(integralClosureAlgEquivStandardTameCover ...).symm` generates `L`
over `K`. -/
@[simp]
theorem adjoin_coe_integralClosureAlgEquivStandardTameCover_symm_root
    (hf₀ : f ∈ nonZeroDivisors A) (hfe : ¬ f ∣ (e : A)) (φ : L →ₐ[K] K') :
    K⟮((integralClosureAlgEquivStandardTameCover hf₀ hfe φ).symm (AdjoinRoot.root _) : L)⟯ = ⊤ := by
  rw [integralClosureAlgEquivStandardTameCover, AlgEquiv.symm_symm,
    coe_standardTameCoverIntegralClosureAlgEquiv_root]
  exact (exists_pow_eq_and_adjoin_eq_top_of_algHom_standardTameCover hf₀ hfe φ).choose_spec.2.1

/-- Under `φ : L →ₐ[K] K'`, the image of `(integralClosureAlgEquivStandardTameCover ...).symm` on
the root of `X^{[L : K]} − f` is the `(e / [L : K])`-th power of the root of `X^e − f` in `K'`. -/
@[simp]
theorem map_coe_integralClosureAlgEquivStandardTameCover_symm_root
    (hf₀ : f ∈ nonZeroDivisors A) (hfe : ¬ f ∣ (e : A)) (φ : L →ₐ[K] K') :
    φ ((integralClosureAlgEquivStandardTameCover hf₀ hfe φ).symm (AdjoinRoot.root _)) =
      algebraMap (standardTameCover A f e) K'
        (AdjoinRoot.root _ ^ (e / Module.finrank K L)) := by
  rw [integralClosureAlgEquivStandardTameCover, AlgEquiv.symm_symm,
    coe_standardTameCoverIntegralClosureAlgEquiv_root]
  exact (exists_pow_eq_and_adjoin_eq_top_of_algHom_standardTameCover hf₀ hfe φ).choose_spec.2.2

/-- `(integralClosureAlgEquivStandardTameCover ...).symm` intertwines `φ : L →ₐ[K] K'` with the
root-power transition map `standardTameCoverAlgHomOfDvd`. -/
theorem map_coe_integralClosureAlgEquivStandardTameCover_symm
    (hf₀ : f ∈ nonZeroDivisors A) (hfe : ¬ f ∣ (e : A)) (φ : L →ₐ[K] K')
    (hdvd : Module.finrank K L ∣ e) (x : standardTameCover A f (Module.finrank K L)) :
    φ ((integralClosureAlgEquivStandardTameCover hf₀ hfe φ).symm x) =
      algebraMap (standardTameCover A f e) K' (standardTameCoverAlgHomOfDvd f hdvd x) := by
  let ψ₁ : standardTameCover A f (Module.finrank K L) →ₐ[A] K' :=
    (φ.restrictScalars A).comp
      ((integralClosure A L).val.comp
        (integralClosureAlgEquivStandardTameCover hf₀ hfe φ).symm.toAlgHom)
  let ψ₂ : standardTameCover A f (Module.finrank K L) →ₐ[A] K' :=
    (IsScalarTower.toAlgHom A (standardTameCover A f e) K').comp
      (standardTameCoverAlgHomOfDvd f hdvd)
  have hψ : ψ₁ = ψ₂ := AdjoinRoot.algHom_ext <| by
    simp [ψ₁, ψ₂]
  exact DFunLike.congr_fun hψ x

end Subextension

section MultiComponent

variable [IsRegularRing (A ⧸ Ideal.span {f})]

/-- Localizing an `A`-algebra decomposition `C ≃ₐ[A] ∏ᵢ A[x]/(x^{eᵢ} − f)` away from `f` transfers
étaleness of `S_f` to each factor and descends invertibility of `eᵢ` from `A_f` to `A` when
`¬ f ∣ (eᵢ : A)`. -/
private theorem isFiniteProductOfStandardTameCovers_of_algEquiv_pi (hf : f ∈ maximalIdeal A)
    (hf₀ : f ∈ nonZeroDivisors A) (Af Sf : Type*) [CommRing Af] [Algebra A Af]
    [IsLocalization.Away f Af] [CommRing Sf] [Algebra A Sf] [Algebra Af Sf]
    [IsScalarTower A Af Sf] [Algebra.Etale Af Sf] [Module.Finite Af Sf]
    {C : Type*} [CommRing C] [Algebra A C] [Algebra C Sf] [IsScalarTower A C Sf]
    [IsIntegralClosure C A Sf] {ι : Type} [Finite ι] {e_idx : ι → ℕ}
    (he_pos : ∀ i, 1 ≤ e_idx i) (he_ndvd : ∀ i, ¬ f ∣ (e_idx i : A))
    (Φ : C ≃ₐ[A] ∀ i : ι, standardTameCover A f (e_idx i)) :
    IsFiniteProductOfStandardTameCovers A C f := by
  classical
  let _ := Fintype.ofFinite ι
  obtain ⟨_, hfprime⟩ := isRegularLocalRing_and_prime hf hf₀
  have : IsLocalization (Algebra.algebraMapSubmonoid C (.powers f)) Sf :=
    IsIntegralClosure.isLocalization_of_isIntegral Af
  have : Algebra.Etale Af (∀ i : ι, standardTameCover Af (algebraMap A Af f) (e_idx i)) :=
    .of_equiv (standardTameCoverPiAwayAlgEquiv f Af Sf Φ)
  have hunram : ∀ i : ι,
      Algebra.FormallyUnramified Af (standardTameCover Af (algebraMap A Af f) (e_idx i)) :=
    (Algebra.FormallyUnramified.pi_iff _).mp inferInstance
  refine (isFiniteProductOfStandardTameCovers_iff f).mpr
    ⟨ι, inferInstance, e_idx, he_pos, fun i ↦ ?_, ⟨Φ⟩⟩
  have := hunram i
  exact hfprime.isUnit_natCast_of_formallyUnramified_adjoinRoot_X_pow_sub_C_away
    (algebraMap A Af f) (he_ndvd i)

/-- **Multi-component Kummer identification from generic-fibre embeddings.** Let `A` be a
Noetherian local ring, `f` a nonzerodivisor of `A` with `A ⧸ (f)` regular, `A_f` a localization of
`A` away from `f`, `S_f` a finite étale `A_f`-algebra, and `C` the integral closure of `A` in
`S_f`. If every field factor `(K ⊗[A_f] S_f) ⧸ m` of the generic fibre admits a `K`-algebra map
into a fraction field `K'` of `A[x]/(x^e − f)` for some `e` with `¬ f ∣ (e : A)`, then `C` is a
finite product of standard tamely ramified covers along `f`. -/
@[stacks 0EYG "product of standard tame covers from generic-fibre embeddings"]
theorem isFiniteProductOfStandardTameCovers_of_forall_algHom
    (hf₀ : f ∈ nonZeroDivisors A) (Af Sf : Type*) [CommRing Af] [Algebra A Af]
    [IsLocalization.Away f Af] [CommRing Sf] [Algebra A Sf] [Algebra Af Sf]
    [IsScalarTower A Af Sf] [Algebra.Etale Af Sf] [Module.Finite Af Sf]
    {C : Type*} [CommRing C] [Algebra A C] [Algebra C Sf] [IsScalarTower A C Sf]
    [IsIntegralClosure C A Sf] {e : ℕ} (hfe : ¬ f ∣ (e : A))
    {K K' : Type*} [Field K] [Algebra A K] [Algebra Af K] [IsScalarTower A Af K]
    [IsFractionRing A K] [Field K'] [Algebra A K'] [Algebra K K'] [IsScalarTower A K K']
    [Algebra (standardTameCover A f e) K'] [IsScalarTower A (standardTameCover A f e) K']
    [IsFractionRing (standardTameCover A f e) K']
    (hsplit : ∀ m : MaximalSpectrum (K ⊗[Af] Sf),
      Nonempty (((K ⊗[Af] Sf) ⧸ m.asIdeal) →ₐ[K] K')) :
    IsFiniteProductOfStandardTameCovers A C f := by
  have hf : f ∈ maximalIdeal A := mem_maximalIdeal_of_not_dvd hfe
  obtain ⟨_, -⟩ := isRegularLocalRing_and_prime hf hf₀
  have hsub : Submonoid.powers f ≤ nonZeroDivisors A := Submonoid.powers_le.mpr hf₀
  have : IsDomain Af := IsLocalization.isDomain_of_le_nonZeroDivisors Af hsub
  have : IsIntegrallyClosed Af := isIntegrallyClosed_of_isLocalization Af (.powers f) hsub
  have : IsFractionRing Af K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (.powers f) Af K
  -- Decompose `C` over `MaximalSpectrum (K ⊗[Af] Sf)` and identify each factor.
  let e₁ := TauCeti.IsIntegralClosure.equivPiIntegralClosureQuotient A Af K Sf C
  let L : MaximalSpectrum (K ⊗[Af] Sf) → Type _ := fun m ↦ (K ⊗[Af] Sf) ⧸ m.asIdeal
  let (m : MaximalSpectrum (K ⊗[Af] Sf)) : Field (L m) := Ideal.Quotient.field m.asIdeal
  let d (m : MaximalSpectrum (K ⊗[Af] Sf)) : ℕ := Module.finrank K (L m)
  have hd_pos (m : MaximalSpectrum (K ⊗[Af] Sf)) : 1 ≤ d m := Module.finrank_pos
  have hd_ndvd (m : MaximalSpectrum (K ⊗[Af] Sf)) : ¬ f ∣ (d m : A) :=
    not_dvd_natCast_finrank_of_algHom_standardTameCover hfe (hsplit m).some
  let e₂ (m : MaximalSpectrum (K ⊗[Af] Sf)) :
      integralClosure A (L m) ≃ₐ[A] standardTameCover A f (d m) :=
    integralClosureAlgEquivStandardTameCover hf₀ hfe (hsplit m).some
  -- Reindex to `Type 0` and apply `isFiniteProductOfStandardTameCovers_of_algEquiv_pi`.
  let σ := Finite.equivFin (MaximalSpectrum (K ⊗[Af] Sf))
  exact isFiniteProductOfStandardTameCovers_of_algEquiv_pi hf hf₀ Af Sf
    (fun i ↦ hd_pos (σ.symm i)) (fun i ↦ hd_ndvd (σ.symm i))
    (e₁.trans ((AlgEquiv.piCongrRight e₂).trans (AlgEquiv.piCongrLeft' A _ σ)))

/-- **Multi-component Kummer identification from splitting over the fraction field of the root
cover.** If `K' ⊗[Af] Sf` is totally split (`Algebra.IsFiniteSplit`) over a fraction field `K'` of
`A[x]/(x^e − f)` with `¬ f ∣ (e : A)`, then `C` is a finite product of standard tamely ramified
covers along `f`. -/
theorem isFiniteProductOfStandardTameCovers_of_isFiniteSplit_fractionRing
    (hf₀ : f ∈ nonZeroDivisors A) (Af Sf : Type*) [CommRing Af]
    [Algebra A Af] [IsLocalization.Away f Af] [CommRing Sf] [Algebra A Sf] [Algebra Af Sf]
    [IsScalarTower A Af Sf] [Algebra.Etale Af Sf] [Module.Finite Af Sf]
    {C : Type*} [CommRing C] [Algebra A C] [Algebra C Sf] [IsScalarTower A C Sf]
    [IsIntegralClosure C A Sf] {e : ℕ} (hfe : ¬ f ∣ (e : A))
    (K K' : Type*) [Field K] [Algebra A K] [Algebra Af K] [IsScalarTower A Af K]
    [IsFractionRing A K] [Field K'] [Algebra A K'] [Algebra Af K'] [Algebra K K']
    [IsScalarTower A K K'] [IsScalarTower Af K K'] [Algebra (standardTameCover A f e) K']
    [IsScalarTower A (standardTameCover A f e) K'] [IsFractionRing (standardTameCover A f e) K']
    [Algebra.IsFiniteSplit K' (K' ⊗[Af] Sf)] :
    IsFiniteProductOfStandardTameCovers A C f := by
  have : Algebra.IsFiniteSplit K' (K' ⊗[K] (K ⊗[Af] Sf)) :=
    .of_algEquiv (Algebra.TensorProduct.cancelBaseChange Af K K' K' Sf).symm
  refine isFiniteProductOfStandardTameCovers_of_forall_algHom hf₀ Af Sf hfe (K := K) (K' := K')
    fun m ↦ ?_
  exact Algebra.IsFiniteSplit.nonempty_algHom_of_surjective (K := K) (K' := K')
    (Ideal.Quotient.mkₐ K m.asIdeal) Ideal.Quotient.mk_surjective

/-- **Multi-component Kummer identification from splitting away from the divisor.** Let `A'_f` be a
localization of `A' = A[x]/(x^e − f)` away from the image of `f` (with `¬ f ∣ (e : A)`). If
`A'_f ⊗[Af] Sf` is totally split over `A'_f`, then the integral closure `C` of `A` in `Sf` is a
finite product of standard tamely ramified covers along `f`. No fraction fields need to be supplied
by the caller. -/
@[stacks 0EYG "product of standard tame covers from splitting over A[x]/(x^e - f)_f"]
theorem isFiniteProductOfStandardTameCovers_of_isFiniteSplit_away
    (hf₀ : f ∈ nonZeroDivisors A) (Af Sf : Type*) [CommRing Af]
    [Algebra A Af] [IsLocalization.Away f Af] [CommRing Sf] [Algebra A Sf] [Algebra Af Sf]
    [IsScalarTower A Af Sf] [Algebra.Etale Af Sf] [Module.Finite Af Sf]
    {C : Type*} [CommRing C] [Algebra A C] [Algebra C Sf] [IsScalarTower A C Sf]
    [IsIntegralClosure C A Sf] {e : ℕ} (hfe : ¬ f ∣ (e : A))
    (A'f : Type*) [CommRing A'f] [Algebra A A'f] [Algebra Af A'f] [IsScalarTower A Af A'f]
    [Algebra (standardTameCover A f e) A'f] [IsScalarTower A (standardTameCover A f e) A'f]
    [IsLocalization.Away (algebraMap A (standardTameCover A f e) f) A'f]
    [Algebra.IsFiniteSplit A'f (A'f ⊗[Af] Sf)] :
    IsFiniteProductOfStandardTameCovers A C f := by
  have hf : f ∈ maximalIdeal A := mem_maximalIdeal_of_not_dvd hfe
  have he : e ≠ 0 := ne_zero_of_not_dvd_natCast hfe
  obtain ⟨_, -⟩ := isRegularLocalRing_and_prime hf hf₀
  let A' := standardTameCover A f e
  have := standardTameCover_isRegularLocalRing hf hf₀ he
  have := (monic_X_pow_sub_C f he).free_adjoinRoot
  -- Construct `K = FractionRing A` and `K' = FractionRing A'` with compatible tower structures.
  let K := FractionRing A
  let K' := FractionRing A'
  let _ : Algebra Af K :=
    IsLocalization.localizationAlgebraOfSubmonoidLe _ _ (.powers f) (nonZeroDivisors A)
      (Submonoid.powers_le.mpr hf₀)
  have : IsScalarTower A Af K :=
    IsLocalization.localization_isScalarTower_of_submonoid_le _ _ (.powers f) (nonZeroDivisors A)
      (Submonoid.powers_le.mpr hf₀)
  have : FaithfulSMul A K' := FaithfulSMul.trans A A' K'
  let _ : Algebra K K' := FractionRing.liftAlgebra A K'
  let _ : Algebra Af K' := ((algebraMap K K').comp (algebraMap Af K)).toAlgebra
  have : IsScalarTower Af K K' := .of_algebraMap_eq' rfl
  have : IsScalarTower A Af K' := .of_algebraMap_eq fun a ↦ by
    rw [RingHom.algebraMap_toAlgebra, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply A Af K,
      ← IsScalarTower.algebraMap_apply A K K']
  have hfA' : algebraMap A A' f ∈ nonZeroDivisors A' :=
    Module.Flat.algebraMap_mem_nonZeroDivisors hf₀
  let _ : Algebra A'f K' :=
    IsLocalization.localizationAlgebraOfSubmonoidLe _ _ (.powers (algebraMap A A' f))
      (nonZeroDivisors A') (Submonoid.powers_le.mpr hfA')
  have : IsScalarTower A' A'f K' :=
    IsLocalization.localization_isScalarTower_of_submonoid_le _ _ (.powers (algebraMap A A' f))
      (nonZeroDivisors A') (Submonoid.powers_le.mpr hfA')
  have : IsScalarTower Af A'f K' := by
    refine .of_algebraMap_eq' <| IsLocalization.ringHom_ext (.powers f) <| RingHom.ext fun a ↦ ?_
    simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply A Af A'f,
      IsScalarTower.algebraMap_apply A A' A'f, ← IsScalarTower.algebraMap_apply A' A'f K',
      ← IsScalarTower.algebraMap_apply A A' K', ← IsScalarTower.algebraMap_apply A Af K']
  -- Base-change `IsFiniteSplit A'f (A'f ⊗[Af] Sf)` along `A'f → K'`.
  have : Algebra.IsFiniteSplit K' (K' ⊗[Af] Sf) :=
    .of_algEquiv (Algebra.TensorProduct.cancelBaseChange Af A'f K' K' Sf)
  exact isFiniteProductOfStandardTameCovers_of_isFiniteSplit_fractionRing
    hf₀ Af Sf hfe K K'

end MultiComponent

end RegularDivisorLocal

section StrictlyHenselian

/-- **Kummer-extension identification over a strictly henselian base (Stacks 0EYG).** Let `A` be a
strictly henselian Noetherian local ring, `f` a nonzerodivisor of `A` with `A ⧸ (f)` regular,
`A_f` a localization of `A` away from `f`, `S_f` a finite étale `A_f`-algebra, and `C` the integral
closure of `A` in `S_f`. Suppose that for `A' = A[x]/(x^e − f)` with `¬ f ∣ (e : A)` (in particular
when `f ∈ 𝔪_A` and `IsUnit (e : A)`), the pullback `A'_f ⊗[A_f] S_f` away from `f` is
`A'_f`-isomorphic to `A'_f ⊗[A'] T` for a finite étale `A'`-algebra `T`. Then `C` is a finite
product of standard tamely ramified covers along `f`. -/
@[stacks 0EYG "local identification from a finite étale cover of A[x]/(x^e - f)"]
theorem isFiniteProductOfStandardTameCovers_of_etale_standardTameCover
    {A : Type*} [CommRing A] [IsNoetherianRing A] [HenselianLocalRing A]
    [IsSepClosed (ResidueField A)] {f : A} (hf₀ : f ∈ nonZeroDivisors A)
    [IsRegularRing (A ⧸ Ideal.span {f})] (Af Sf : Type*) [CommRing Af] [Algebra A Af]
    [IsLocalization.Away f Af] [CommRing Sf] [Algebra A Sf] [Algebra Af Sf]
    [IsScalarTower A Af Sf] [Algebra.Etale Af Sf] [Module.Finite Af Sf]
    {C : Type*} [CommRing C] [Algebra A C] [Algebra C Sf] [IsScalarTower A C Sf]
    [IsIntegralClosure C A Sf] {e : ℕ} (hfe : ¬ f ∣ (e : A))
    (A'f : Type*) [CommRing A'f] [Algebra A A'f] [Algebra Af A'f] [IsScalarTower A Af A'f]
    [Algebra (standardTameCover A f e) A'f] [IsScalarTower A (standardTameCover A f e) A'f]
    [IsLocalization.Away (algebraMap A (standardTameCover A f e) f) A'f]
    {T : Type*} [CommRing T] [Algebra (standardTameCover A f e) T]
    [Algebra.Etale (standardTameCover A f e) T] [Module.Finite (standardTameCover A f e) T]
    (φ : A'f ⊗[standardTameCover A f e] T ≃ₐ[A'f] A'f ⊗[Af] Sf) :
    IsFiniteProductOfStandardTameCovers A C f := by
  have hf : f ∈ maximalIdeal A := mem_maximalIdeal_of_not_dvd hfe
  have he : e ≠ 0 := ne_zero_of_not_dvd_natCast hfe
  have := standardTameCover_isLocalRing hf he
  have := standardTameCover_henselianLocalRing hf he
  have := standardTameCover_isSepClosed_residueField (e := e) hf
  have : Algebra.IsFiniteSplit (standardTameCover A f e) T := .of_henselianLocalRing _ T
  have : Algebra.IsFiniteSplit A'f (A'f ⊗[Af] Sf) := .of_algEquiv φ
  exact isFiniteProductOfStandardTameCovers_of_isFiniteSplit_away hf₀ Af Sf hfe A'f

end StrictlyHenselian

section Converse

/-- **Extension across the divisor after a tame root extraction.** Over any commutative ring `A`, if
`C` is a finite product of standard tame covers along `f`, then there exist an exponent `e ≥ 1`
invertible in `A` and a finite étale `(A[x]/(x^e − f))`-algebra `T` whose base change to any
localization `A'_f` of `A[x]/(x^e − f)` away from `f` is `A'_f`-isomorphic to `A'_f ⊗[A] C`. -/
theorem IsFiniteProductOfStandardTameCovers.exists_etale_standardTameCover_tensorProduct
    {A : Type u} [CommRing A] {C : Type*} [CommRing C] [Algebra A C] {f : A}
    (h : IsFiniteProductOfStandardTameCovers A C f) :
    ∃ (e : ℕ) (_ : 1 ≤ e) (_ : IsUnit (e : A)) (T : Type u) (_ : CommRing T)
      (_ : Algebra (standardTameCover A f e) T) (_ : Algebra.Etale (standardTameCover A f e) T)
      (_ : Module.Finite (standardTameCover A f e) T),
      ∀ (A'f : Type u) [CommRing A'f] [Algebra A A'f] [Algebra (standardTameCover A f e) A'f]
        [IsScalarTower A (standardTameCover A f e) A'f]
        [IsLocalization.Away (algebraMap A (standardTameCover A f e) f) A'f],
        Nonempty (A'f ⊗[standardTameCover A f e] T ≃ₐ[A'f] A'f ⊗[A] C) := by
  classical
  obtain ⟨ι, _, d, hd1, hdu, ⟨ψ⟩⟩ := (isFiniteProductOfStandardTameCovers_iff f).mp h
  let e : ℕ := ∏ i : ι, d i
  have he1 : 1 ≤ e := Finset.one_le_prod fun i _ ↦ hd1 i
  have heu : IsUnit (e : A) := by
    rw [Nat.cast_prod]
    exact Finset.prod_induction _ IsUnit (fun _ _ ↦ IsUnit.mul) isUnit_one fun i _ ↦ hdu i
  let A' : Type u := standardTameCover A f e
  let T : Type u := ∀ i : ι, standardTameCover A' 1 (d i)
  have hEt (i : ι) : Algebra.Etale A' (standardTameCover A' 1 (d i)) :=
    standardTameCover_etale isUnit_one (by simpa using (hdu i).map (algebraMap A A'))
  have hFin (i : ι) : Module.Finite A' (standardTameCover A' 1 (d i)) :=
    (monic_X_pow_sub_C 1 (Nat.ne_of_gt (hd1 i))).finite_adjoinRoot
  refine ⟨e, he1, heu, T, inferInstance, inferInstance, inferInstance, inferInstance,
    fun A'f _ _ _ _ _ ↦ ⟨?_⟩⟩
  -- Over `A'f`, `(x ^ (e / d i)) ^ d i = f` is a unit, so scaling identifies `X^{d i} - 1`
  -- with `X^{d i} - f`.
  let y : A' := AdjoinRoot.root (X ^ e - Polynomial.C f)
  have hu_pow (i : ι) : (algebraMap A' A'f (y ^ (e / d i))) ^ d i = algebraMap A A'f f := by
    rw [← map_pow, ← pow_mul, Nat.div_mul_cancel (Finset.dvd_prod_of_mem d (Finset.mem_univ i)),
      map_pow, standardTameCover_algebraMap_root_pow]
  have hu (i : ι) : IsUnit (algebraMap A' A'f (y ^ (e / d i))) := by
    rw [← isUnit_pow_iff (Nat.ne_of_gt (hd1 i)), hu_pow i, IsScalarTower.algebraMap_apply A A' A'f]
    exact IsLocalization.Away.algebraMap_isUnit (algebraMap A A' f)
  let eqFactor (i : ι) :
      A'f ⊗[A'] standardTameCover A' 1 (d i) ≃ₐ[A'f] A'f ⊗[A] standardTameCover A f (d i) :=
    (standardTameCoverBaseChangeAlgEquiv A'f (1 : A') (d i)).trans <|
      (standardTameCoverAlgEquivOfMulPowEq (hu i)
        (by rw [map_one, mul_one]; exact hu_pow i)).trans <|
        (standardTameCoverBaseChangeAlgEquiv A'f f (d i)).symm
  exact (Algebra.TensorProduct.piRight A' A'f A'f (fun i ↦ standardTameCover A' 1 (d i))).trans <|
    (AlgEquiv.piCongrRight eqFactor).trans <|
      (Algebra.TensorProduct.piRight A A'f A'f (fun i ↦ standardTameCover A f (d i))).symm.trans <|
        Algebra.TensorProduct.congr AlgEquiv.refl ψ.symm

/-- **Characterization of products of standard tame covers over a strictly henselian regular-divisor
local base.** Let `A` be a strictly henselian Noetherian local ring with regular divisor `f ∈ 𝔪_A`,
let `A_f` be a localization of `A` away from `f`, let `S_f` be a finite étale `A_f`-algebra, and
let `C` be the integral closure of `A` in `S_f`. Then `C` is a finite product of standard tamely
ramified covers along `f` if and only if there exist a unit exponent `e ≥ 1` in `A` and a finite
étale `(A[x]/(x^e − f))`-algebra `T` whose restriction away from `f` is isomorphic to the pullback
of `S_f`. -/
@[stacks 0EYG "characterization of standard tame covers via Kummer root extraction"]
theorem isFiniteProductOfStandardTameCovers_iff_exists_etale_standardTameCover
    {A : Type u} [CommRing A] [IsNoetherianRing A] [HenselianLocalRing A]
    [IsSepClosed (ResidueField A)] {f : A} (hf : f ∈ maximalIdeal A) (hf₀ : f ∈ nonZeroDivisors A)
    [IsRegularRing (A ⧸ Ideal.span {f})] (Af Sf : Type*) [CommRing Af] [Algebra A Af]
    [IsLocalization.Away f Af] [CommRing Sf] [Algebra A Sf] [Algebra Af Sf]
    [IsScalarTower A Af Sf] [Algebra.Etale Af Sf] [Module.Finite Af Sf]
    {C : Type*} [CommRing C] [Algebra A C] [Algebra C Sf] [IsScalarTower A C Sf]
    [IsIntegralClosure C A Sf] :
    IsFiniteProductOfStandardTameCovers A C f ↔
      ∃ (e : ℕ) (_ : 1 ≤ e) (_ : IsUnit (e : A)) (T : Type u) (_ : CommRing T)
        (_ : Algebra (standardTameCover A f e) T) (_ : Algebra.Etale (standardTameCover A f e) T)
        (_ : Module.Finite (standardTameCover A f e) T),
        ∀ (A'f : Type u) [CommRing A'f] [Algebra A A'f] [Algebra Af A'f] [IsScalarTower A Af A'f]
          [Algebra (standardTameCover A f e) A'f] [IsScalarTower A (standardTameCover A f e) A'f]
          [IsLocalization.Away (algebraMap A (standardTameCover A f e) f) A'f],
          Nonempty (A'f ⊗[standardTameCover A f e] T ≃ₐ[A'f] A'f ⊗[Af] Sf) := by
  constructor
  · intro hC
    obtain ⟨e, he1, heu, T, _, _, _, _, hT⟩ := hC.exists_etale_standardTameCover_tensorProduct
    have : IsLocalization (Algebra.algebraMapSubmonoid C (.powers f)) Sf :=
      IsIntegralClosure.isLocalization_of_isIntegral Af
    have := (Algebra.isPushout_of_isLocalization (.powers f) Af C Sf).symm
    refine ⟨e, he1, heu, T, inferInstance, inferInstance, inferInstance, inferInstance,
      fun A'f _ _ _ _ _ _ _ ↦ ?_⟩
    obtain ⟨φ₀⟩ := hT A'f
    exact ⟨φ₀.trans <| (Algebra.TensorProduct.cancelBaseChange A Af A'f A'f C).symm.trans <|
      Algebra.TensorProduct.congr AlgEquiv.refl (Algebra.IsPushout.equiv A Af C Sf)⟩
  · rintro ⟨e, -, heu, T, _, _, _, _, hT⟩
    have hfe : ¬ f ∣ (e : A) := fun hdvd ↦ notMem_maximalIdeal.mpr (isUnit_of_dvd_unit hdvd heu) hf
    let A' := standardTameCover A f e
    let A'f := Localization.Away (algebraMap A A' f)
    have : IsLocalization.Away ((Algebra.ofId A A') f) A'f :=
      inferInstanceAs (IsLocalization.Away (algebraMap A A' f) A'f)
    let fₐ := IsLocalization.Away.mapₐ Af A'f (Algebra.ofId A A') f
    let _ : Algebra Af A'f := fₐ.toRingHom.toAlgebra
    have : IsScalarTower A Af A'f := .of_algHom fₐ
    obtain ⟨φ⟩ := hT A'f
    exact isFiniteProductOfStandardTameCovers_of_etale_standardTameCover
      hf₀ Af Sf hfe A'f φ

end Converse

end TauCeti
