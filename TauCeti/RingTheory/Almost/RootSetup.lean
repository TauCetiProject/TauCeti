module

public import TauCeti.RingTheory.Almost.FilteredPrincipal
public import TauCeti.RingTheory.Ideal.CompatibleRoots
public import TauCeti.RingTheory.Ideal.Flat

/-!
# The basic setup of a compatible system of `p`-power roots

Let `V` be a commutative ring, `p ≥ 2` an integer and `ϖ : ℕ → V` a sequence with
`ϖ (n + 1) ^ p = ϖ n`. The ideal `m` generated by the `ϖ n` is the increasing union of the
principal ideals `ϖ n V`. It is idempotent and satisfies condition (A), so `m ⊗[V] m` is flat and
`(V, m)` is a basic setup, the *root setup* of `ϖ`. A `V`-module is almost zero for it iff every
`ϖ n` kills it.

The construction is purely algebraic: no topology, no perfectoid hypothesis and no regularity of
the roots enter. It is the setup used for a perfectoid Tate ring and a pseudouniformiser with
compatible `p`-power roots. When `ϖ 0` is a nonzerodivisor, `m` is itself flat and the
multiplication map `m ⊗[V] m → m` is bijective.

## Main definitions

* `TauCeti.Almost.BasicSetup.ofCompatibleRoots`: the root setup `(V, Ideal.span (Set.range ϖ))`.

## Main results

* `TauCeti.Almost.BasicSetup.mem_ofCompatibleRoots_ideal`: `x ∈ m` iff some `ϖ n` divides `x`;
  in particular every `ϖ n` lies in `m` (`root_mem_ofCompatibleRoots_ideal`).
* `TauCeti.Almost.BasicSetup.ofCompatibleRoots_isAlmostZero_iff`: a module is almost zero iff it
  is killed by every `ϖ n`.
* `TauCeti.Almost.BasicSetup.isFilteredPrincipal_ofCompatibleRoots`: the root setup satisfies
  condition (A).
* `TauCeti.Almost.BasicSetup.ofCompatibleRoots_shift`: dropping finitely many roots does not
  change the setup.
* `TauCeti.Almost.BasicSetup.flat_ofCompatibleRoots_ideal` and
  `TauCeti.Almost.BasicSetup.ofCompatibleRoots_tildeToIdeal_bijective`: if `ϖ 0` is a
  nonzerodivisor, then `m` is flat and `m~ → m` is bijective.

## References

* O. Gabber, L. Ramero, *Almost ring theory*, Lecture Notes in Mathematics 1800, §2.1, (2.1.6)
  and Proposition 2.1.7.
* B. Bhatt, *Lecture notes for a class on perfectoid spaces*, §4.1, Example 4.1.3.
* P. Scholze, *Étale cohomology of diamonds*, §3, Definition 3.21.
-/

public section

namespace TauCeti.Almost.BasicSetup

variable {V : Type*} [CommRing V] {p : ℕ} (hp : 2 ≤ p) {ϖ : ℕ → V}
  (hϖ : ∀ n, ϖ (n + 1) ^ p = ϖ n)

/-- The *root setup* of a sequence `ϖ` of compatible `p`-power roots, `ϖ (n + 1) ^ p = ϖ n` with
`p ≥ 2`: the basic setup whose ideal is generated by all the `ϖ n` (Bhatt, Example 4.1.3). Its
ideal is idempotent and satisfies condition (A), which makes `m~` flat. -/
def ofCompatibleRoots : BasicSetup V where
  ideal := Ideal.span (Set.range ϖ)
  isIdempotentElem := isIdempotentElem_span_range_compatible_roots hp hϖ
  flat_tilde := flat_tilde_of_isFilteredPrincipal
    (isIdempotentElem_span_range_compatible_roots hp hϖ) fun _ hx _ hy ↦
      have ⟨n, hn⟩ := exists_dvd_and_dvd_of_mem_span_range_compatible_roots hϖ hx hy
      ⟨ϖ n, Ideal.mem_span_range_self, hn⟩

@[simp]
theorem ofCompatibleRoots_ideal : (ofCompatibleRoots hp hϖ).ideal = Ideal.span (Set.range ϖ) :=
  (rfl)

/-- Every root `ϖ n` lies in the ideal of the root setup. -/
theorem root_mem_ofCompatibleRoots_ideal (n : ℕ) : ϖ n ∈ (ofCompatibleRoots hp hϖ).ideal :=
  Ideal.mem_span_range_self

/-- An element lies in the ideal of the root setup iff it is divisible by some root `ϖ n`. -/
theorem mem_ofCompatibleRoots_ideal {x : V} :
    x ∈ (ofCompatibleRoots hp hϖ).ideal ↔ ∃ n, ϖ n ∣ x := by
  rw [ofCompatibleRoots_ideal]
  exact mem_span_range_compatible_roots_iff hϖ

/-- The root setup satisfies condition (A): two elements of its ideal are divisible by a common
root `ϖ n`. -/
theorem isFilteredPrincipal_ofCompatibleRoots : (ofCompatibleRoots hp hϖ).IsFilteredPrincipal :=
  isFilteredPrincipal_iff.mpr fun _ hx _ hy ↦
    have ⟨n, hn⟩ := exists_dvd_and_dvd_of_mem_span_range_compatible_roots hϖ hx hy
    ⟨ϖ n, Ideal.mem_span_range_self, hn⟩

/-- A module is almost zero for the root setup iff every root `ϖ n` kills it. -/
theorem ofCompatibleRoots_isAlmostZero_iff {M : Type*} [AddCommGroup M] [Module V M] :
    (ofCompatibleRoots hp hϖ).IsAlmostZero M ↔ ∀ n (x : M), ϖ n • x = 0 := by
  refine ⟨fun h n x ↦ h.smul_eq_zero (root_mem_ofCompatibleRoots_ideal hp hϖ n) x, fun h ↦ ?_⟩
  refine isAlmostZero_iff.mpr fun ε hε x ↦ ?_
  obtain ⟨n, c, rfl⟩ := (mem_ofCompatibleRoots_ideal hp hϖ).mp hε
  rw [mul_comm, mul_smul, h, smul_zero]

/-- Dropping the first `k` roots does not change the root setup. -/
theorem ofCompatibleRoots_shift (k : ℕ) :
    ofCompatibleRoots hp (ϖ := fun n ↦ ϖ (n + k))
        (fun n ↦ by simpa [add_right_comm] using hϖ (n + k)) =
      ofCompatibleRoots hp hϖ :=
  BasicSetup.ext (span_range_compatible_roots_shift hϖ k)

/-- If `ϖ 0` is a nonzerodivisor, the ideal of the root setup is a flat `V`-module. -/
theorem flat_ofCompatibleRoots_ideal (hreg : IsSMulRegular V (ϖ 0)) :
    Module.Flat V (ofCompatibleRoots hp hϖ).ideal :=
  have : NeZero p := ⟨by omega⟩
  -- The ideal is defined as `Ideal.span (Set.range ϖ)`, and the coefficients of the element
  -- `⟨ϖ, hϖ⟩` of the perfection are the `ϖ n` by definition (`Perfection.coeffMonoidHom_mk`).
  Perfection.flat_span_range_of_isSMulRegular (⟨ϖ, hϖ⟩ : Perfection V p) hreg

/-- If `ϖ 0` is a nonzerodivisor, the multiplication map `m~ → m` of the root setup is
bijective. -/
theorem ofCompatibleRoots_tildeToIdeal_bijective (hreg : IsSMulRegular V (ϖ 0)) :
    Function.Bijective (ofCompatibleRoots hp hϖ).tildeToIdeal :=
  have := flat_ofCompatibleRoots_ideal hp hϖ hreg
  tildeToIdeal_bijective_of_flat _

end TauCeti.Almost.BasicSetup
