module

public import TauCeti.RingTheory.Almost.BasicSetup
import TauCeti.RingTheory.Flat.LocallyCyclic
import Mathlib.LinearAlgebra.TensorProduct.Quotient
import Mathlib.RingTheory.TensorProduct.DirectLimitFG
import Mathlib.Tactic.LinearCombination

/-!
# Flatness of `m ⊗ m` for directed unions of principal ideals

Let `I` be an ideal of a commutative ring `V` which is idempotent, `I * I = I`, and which is the
directed union of the principal ideals generated by its elements (Gabber–Ramero's condition (A):
any two elements of `I` have a common divisor in `I`). Then `I ⊗[V] I` is a flat `V`-module, so
`(V, I)` is a basic setup for almost mathematics. No element of `I` needs to be a nonzerodivisor.
This is the flatness input for the setup of an element with compatible `p`-power roots when the
element is not assumed regular, for instance when it is nilpotent; then `I` itself need not be
flat.

The tensor square is locally cyclic, every element being a multiple of some `x ⊗ₜ x` with
`x ∈ I`, so flatness reduces to relations `r • (x ⊗ₜ x) = 0`. Such a relation already holds in
`(V ∙ z) ⊗[V] I` for some `z ∈ I` dividing `x`, and `(V ∙ z) ⊗[V] I` is the quotient of `I` by
`J • I`, where `J` is the annihilator of `z`; idempotence of `I` then absorbs the remaining
factor.

## Main results

* `TauCeti.Almost.BasicSetup.flat_tilde_of_isFilteredPrincipal`: an idempotent ideal which is a
  directed union of principal ideals has flat tensor square.

## References

* O. Gabber and L. Ramero, *Almost ring theory*, Lecture Notes in Mathematics 1800, §2.1, (2.1.6)
  and Proposition 2.1.7(i).
-/

public section

open TensorProduct Submodule

namespace TauCeti.Almost.BasicSetup

variable {V : Type*} [CommRing V] {I : Ideal V}

/-- If `x = z * a` in an ideal `I`, then `x ⊗ₜ x = a ^ 2 • (z ⊗ₜ z)` in `I ⊗[V] I`. -/
private theorem tmul_self_eq_pow_smul {x z : I} {a : V} (h : (x : V) = z * a) :
    x ⊗ₜ[V] x = a ^ 2 • (z ⊗ₜ[V] z) := by
  have hx : x = a • z := Subtype.ext (by simp [h, mul_comm])
  rw [hx, smul_tmul_smul, sq]

section FilteredPrincipal

variable (hdir : ∀ x ∈ I, ∀ y ∈ I, ∃ z ∈ I, z ∣ x ∧ z ∣ y)
include hdir

/-- Under condition (A), every element of `I ⊗[V] I` is a multiple of some `x ⊗ₜ x`. -/
private theorem exists_eq_smul_tmul_self (t : I ⊗[V] I) :
    ∃ (x : I) (s : V), t = s • (x ⊗ₜ[V] x) := by
  induction t using TensorProduct.inductionOn with
  | tmul y z =>
    obtain ⟨w, hw, ⟨a, ha⟩, ⟨b, hb⟩⟩ := hdir y y.2 z z.2
    have hy : y = a • (⟨w, hw⟩ : I) := Subtype.ext (by simp [ha, mul_comm])
    have hz : z = b • (⟨w, hw⟩ : I) := Subtype.ext (by simp [hb, mul_comm])
    exact ⟨⟨w, hw⟩, a * b, by rw [hy, hz, smul_tmul_smul]⟩
  | add t t' ht ht' =>
    obtain ⟨x, s, rfl⟩ := ht
    obtain ⟨x', s', rfl⟩ := ht'
    obtain ⟨w, hw, ⟨a, ha⟩, ⟨b, hb⟩⟩ := hdir x x.2 x' x'.2
    refine ⟨⟨w, hw⟩, s * a ^ 2 + s' * b ^ 2, ?_⟩
    rw [tmul_self_eq_pow_smul (z := ⟨w, hw⟩) ha, tmul_self_eq_pow_smul (z := ⟨w, hw⟩) hb,
      smul_smul, smul_smul, add_smul]

/-- Under condition (A), the elements of `J • I`, for `J` the annihilator of `z ∈ I`, have the
form `j * w` with `j * z = 0` and `w ∈ I` a divisor of `z`. -/
private theorem exists_mul_of_mem_torsionOf_smul_top (z : I) {u : I}
    (hu : u ∈ (Ideal.torsionOf V I z • ⊤ : Submodule V I)) :
    ∃ w ∈ I, w ∣ (z : V) ∧ ∃ j : V, j * z = 0 ∧ (u : V) = j * w := by
  refine smul_induction_on hu (fun j hj y _ ↦ ?_) fun u u' hu hu' ↦ ?_
  · obtain ⟨w, hw, ⟨b, hb⟩, hwz⟩ := hdir y y.2 z z.2
    have hjz : j * (z : V) = 0 := by
      simpa using congrArg Subtype.val ((Ideal.mem_torsionOf_iff z j).mp hj)
    refine ⟨w, hw, hwz, j * b, by rw [mul_right_comm, hjz, zero_mul], ?_⟩
    simp [hb, mul_left_comm, mul_comm]
  · obtain ⟨w, hw, hwz, j, hj, hu⟩ := hu
    obtain ⟨w', hw', -, j', hj', hu'⟩ := hu'
    obtain ⟨v, hv, ⟨c, hc⟩, ⟨c', hc'⟩⟩ := hdir w hw w' hw'
    refine ⟨v, hv, (Dvd.intro c hc.symm).trans hwz, j * c + j' * c', ?_, ?_⟩
    · linear_combination c * hj + c' * hj'
    · rw [coe_add, hu, hu', hc, hc']
      ring

/-- Under conditions (A) and `I * I = I`, a relation `r • (x ⊗ₜ x) = 0` in `I ⊗[V] I` is trivial:
`x ⊗ₜ x = D • (v ⊗ₜ v)` for some `v ∈ I` and some `D` with `r * D = 0`
(Gabber–Ramero, proof of Proposition 2.1.7(i)). -/
private theorem exists_tmul_self_eq_smul_of_smul_eq_zero (hI : IsIdempotentElem I) {x : I}
    {r : V} (h : r • (x ⊗ₜ[V] x) = 0) :
    ∃ (v : I) (D : V), x ⊗ₜ[V] x = D • (v ⊗ₜ[V] v) ∧ r * D = 0 := by
  -- The relation already holds in `Q ⊗[V] I` for a finitely generated `Q ⊆ I` containing `x`.
  have hxP : x ∈ V ∙ x := mem_span_singleton_self x
  let t₀ : (V ∙ x) ⊗[V] I := (r • ⟨x, hxP⟩ : V ∙ x) ⊗ₜ x
  have ht₀ : LinearMap.rTensor I (V ∙ x).subtype t₀ = 0 := by
    simpa [t₀, smul_tmul'] using h
  obtain ⟨Q, hPQ, ⟨S, rfl⟩, hQ⟩ :=
    TensorProduct.eq_zero_of_fg_of_subtype_eq_zero (fg_span_singleton x) ht₀
  -- By condition (A), `Q` lies in a cyclic submodule `V ∙ z` of `I`, and `x = a • z`.
  obtain ⟨z, hz⟩ := (Ideal.directed_span_singleton_of_exists_dvd hdir).finset_le S
  have hQz : span V (S : Set I) ≤ V ∙ z :=
    span_le.mpr fun y hy ↦ hz y hy (mem_span_singleton_self y)
  have hPz := hPQ.trans hQz
  obtain ⟨a, ha⟩ := mem_span_singleton.mp (hPz hxP)
  have hinc : inclusion hPz = inclusion hQz ∘ₗ inclusion hPQ := rfl
  have h₁ : LinearMap.rTensor I (inclusion hPz) t₀ = 0 := by
    rw [hinc, LinearMap.rTensor_comp_apply, hQ, map_zero]
  -- Since `(V ∙ z) ⊗[V] I ≃ I ⧸ (J • I)` for `J` the annihilator of `z`, `(r * a) • x ∈ J • I`.
  have he : (Ideal.quotTorsionOfEquivSpanSingleton V I z).symm (inclusion hPz (r • ⟨x, hxP⟩)) =
      Ideal.Quotient.mk _ (r * a) := by
    rw [LinearEquiv.symm_apply_eq, ← Ideal.Quotient.mk_eq_mk,
      Ideal.quotTorsionOfEquivSpanSingleton_apply_mk]
    exact Subtype.ext (by simp [← ha, mul_smul])
  have hmem : (r * a) • x ∈ (Ideal.torsionOf V I z • ⊤ : Submodule V I) := by
    rw [← Submodule.Quotient.mk_eq_zero, ← quotTensorEquivQuotSMul_mk_tmul, ← he]
    simpa [t₀] using congrArg (quotTensorEquivQuotSMul I (Ideal.torsionOf V I z) ∘
      LinearMap.rTensor I (Ideal.quotTorsionOfEquivSpanSingleton V I z).symm.toLinearMap) h₁
  -- Writing `(r * a) * x = j * w` with `j * z = 0` and `z = w * c` gives `r * (a * c) ^ 2 * w = 0`.
  obtain ⟨w, hw, ⟨c, hc⟩, j, hj, hrw⟩ :=
    exists_mul_of_mem_torsionOf_smul_top hdir z hmem
  have hxz : (x : V) = a * z := by rw [← ha]; simp
  have hxw : (x : V) = w * (a * c) := by rw [hxz, hc]; ring
  have hrw' : r * (a * c) ^ 2 * w = 0 := by
    simp only [Submodule.coe_smul, smul_eq_mul] at hrw
    linear_combination c * hrw - r * a * c * hxz - (r * a ^ 2 * c + j) * hc + hj
  -- Idempotence: `w = v * (s * v)` for some `v ∈ I`, which absorbs the remaining factor `w`.
  obtain ⟨t, ht⟩ : w ∈ LinearMap.range (mulMap I I) := by rwa [mulMap_range, hI.eq]
  obtain ⟨v, s, rfl⟩ := exists_eq_smul_tmul_self hdir t
  have hwv : w = v * (s * v) := by
    simp only [map_smul, mulMap_tmul, smul_eq_mul] at ht
    rw [← ht]
    ring
  refine ⟨v, (a * c) ^ 2 * (s * v) ^ 2, ?_, ?_⟩
  · rw [tmul_self_eq_pow_smul (z := ⟨w, hw⟩) hxw, tmul_self_eq_pow_smul hwv, smul_smul]
  · linear_combination s * hrw' - r * (a * c) ^ 2 * s * hwv

end FilteredPrincipal

/-- **Gabber–Ramero, Proposition 2.1.7(i)**: an idempotent ideal `I` which is the directed union
of the principal ideals generated by its elements (condition (A): any two elements of `I` have a
common divisor in `I`) has flat tensor square `I ⊗[V] I`. Hence `(V, I)` is a basic setup. -/
theorem flat_tilde_of_isFilteredPrincipal (hI : IsIdempotentElem I)
    (hdir : ∀ x ∈ I, ∀ y ∈ I, ∃ z ∈ I, z ∣ x ∧ z ∣ y) : Module.Flat V (I ⊗[V] I) := by
  refine (Module.Flat.iff_forall_smul_eq_zero_of_directed fun t t' ↦ ?_).mpr fun r t hrt ↦ ?_
  · obtain ⟨x, s, rfl⟩ := exists_eq_smul_tmul_self hdir t
    obtain ⟨x', s', rfl⟩ := exists_eq_smul_tmul_self hdir t'
    obtain ⟨w, hw, ⟨a, ha⟩, ⟨b, hb⟩⟩ := hdir x x.2 x' x'.2
    refine ⟨(⟨w, hw⟩ : I) ⊗ₜ[V] ⟨w, hw⟩, ?_, ?_⟩ <;> dsimp only <;>
      rw [span_singleton_le_iff_mem, mem_span_singleton]
    · exact ⟨s * a ^ 2, by rw [tmul_self_eq_pow_smul (z := ⟨w, hw⟩) ha, smul_smul]⟩
    · exact ⟨s' * b ^ 2, by rw [tmul_self_eq_pow_smul (z := ⟨w, hw⟩) hb, smul_smul]⟩
  · obtain ⟨x, s, rfl⟩ := exists_eq_smul_tmul_self hdir t
    obtain ⟨v, D, hv, hD⟩ :=
      exists_tmul_self_eq_smul_of_smul_eq_zero hdir hI (r := r * s) (by rwa [mul_smul])
    exact ⟨s * D, v ⊗ₜ[V] v, by rw [hv, smul_smul], by rw [← mul_assoc, hD]⟩

end TauCeti.Almost.BasicSetup
