import Mathlib.RingTheory.Finiteness.Projective
import TauCeti.LinearAlgebra.Contraction

/-!
# Almost finite projective modules

Let `(V, m)` be a basic setup. A `V`-module `N` is *almost finite projective* if for every
`ε ∈ m` multiplication by `ε` on `N` factors through a finite free module: there are linear maps
`u : N → Vⁿ` and `v : Vⁿ → N` with `v ∘ u = ε • id`, where `n` may depend on `ε`. This is the
honest-module form of Gabber–Ramero's `ε`-factorisation criterion for almost projective, almost
finitely generated almost modules (Lemma 2.4.15). Classically, for
`ε = 1`, it says that `N` is a direct summand of some `Vⁿ`, that is, finite projective.

Since the maps `N → N` that factor through a finite free module are exactly the range of
`dualTensorHom` (`mem_range_dualTensorHom_iff`), the scalars `ε` for which `ε • id` factors form
an ideal of `V`, and the condition is checked on products. Together with the almost inverses of
almost isomorphisms (`TauCeti.Almost.BasicSetup.IsAlmostIso.exists_comp_eq_smul_id`), this shows
that the condition only depends on the almost module `N^a`: it is invariant under almost
isomorphisms. In particular the ideal `m` itself is almost finite projective in every setup,
though it need not be finitely generated.

## Main definitions

* `TauCeti.Almost.BasicSetup.IsAlmostFiniteProjective`: for every `ε ∈ m`, `ε • id` factors
  through a finite free module.

## Main results

* `TauCeti.Almost.BasicSetup.isAlmostFiniteProjective_iff_smul_id_mem_range`: the definition in
  terms of the range of `dualTensorHom`.
* `TauCeti.Almost.BasicSetup.IsAlmostFiniteProjective.almostFG`: almost finite projective modules
  are almost finitely generated.
* `TauCeti.Almost.BasicSetup.isAlmostFiniteProjective_of_finite_of_projective`: finite projective
  modules are almost finite projective for every setup;
  `TauCeti.Almost.BasicSetup.isAlmostFiniteProjective_classical_iff`: for the classical setup the
  converse holds.
* `TauCeti.Almost.BasicSetup.IsAlmostZero.isAlmostFiniteProjective`: almost zero modules are almost
  finite projective.
* `TauCeti.Almost.BasicSetup.IsAlmostIso.isAlmostFiniteProjective_iff`: almost finite projectivity
  is invariant under almost isomorphisms.

## References

* O. Gabber, L. Ramero, *Almost ring theory*, Lecture Notes in Mathematics 1800, §2.4:
  Definition 2.4.4 and Lemma 2.4.15.
* P. Scholze, *Perfectoid spaces*, Publ. Math. IHÉS 116 (2012), §4, Definition/Proposition 4.7.
-/

public section

open LinearMap Submodule

namespace TauCeti.Almost.BasicSetup

universe u

variable {V : Type u} [CommRing V] (S : BasicSetup V)

/-- A `V`-module `N` is *almost finite projective* for the basic setup `(V, m)` if for every
`ε ∈ m` there are linear maps `u : N → Vⁿ` and `v : Vⁿ → N` with `v ∘ u = ε • id`; the integer `n`
may depend on `ε`. This is the honest-module form of Gabber–Ramero's `ε`-factorisation criterion
for almost projective, almost finitely generated almost modules (Lemma 2.4.15). -/
def IsAlmostFiniteProjective (N : Type*) [AddCommGroup N] [Module V N] : Prop :=
  ∀ ε ∈ S.ideal, ∃ (n : ℕ) (u : N →ₗ[V] Fin n → V) (v : (Fin n → V) →ₗ[V] N),
    v ∘ₗ u = ε • LinearMap.id

variable {S} {M N : Type*} [AddCommGroup M] [Module V M] [AddCommGroup N] [Module V N]

theorem isAlmostFiniteProjective_iff : S.IsAlmostFiniteProjective N ↔
    ∀ ε ∈ S.ideal, ∃ (n : ℕ) (u : N →ₗ[V] Fin n → V) (v : (Fin n → V) →ₗ[V] N),
      v ∘ₗ u = ε • LinearMap.id :=
  Iff.rfl

/-- Almost finite projectivity in terms of `dualTensorHom`: for every `ε ∈ m`, the map `ε • id`
lies in the image of `Dual V N ⊗[V] N → (N →ₗ[V] N)`. -/
theorem isAlmostFiniteProjective_iff_smul_id_mem_range : S.IsAlmostFiniteProjective N ↔
    ∀ ε ∈ S.ideal, ε • LinearMap.id ∈ range (dualTensorHom V N N) :=
  forall₂_congr fun _ _ ↦ mem_range_dualTensorHom_iff.symm

/-! ### Finite generation -/

/-- An almost finite projective module is almost finitely generated. -/
theorem IsAlmostFiniteProjective.almostFG (h : S.IsAlmostFiniteProjective N) : S.AlmostFG N := by
  classical
  -- For `m₀ ≤ m` generated by `ε₁, …, εₖ`, the images of the maps `vᵢ : V^{nᵢ} → N` with
  -- `vᵢ ∘ uᵢ = εᵢ • id` together contain `m₀ • N`.
  rw [almostFG_iff_exists_fg]
  rintro _ hm ⟨s, rfl⟩
  induction s using Finset.induction_on with
  | empty => exact ⟨⊥, fg_bot, by simp⟩
  | insert a s _ ih =>
    rw [Finset.coe_insert, Ideal.span_insert] at hm ⊢
    obtain ⟨P, hP, hsP⟩ := ih (le_sup_right.trans hm)
    obtain ⟨n, u, v, huv⟩ := h a (hm (mem_sup_left (Ideal.mem_span_singleton_self a)))
    refine ⟨range v ⊔ P, ((fg_iff_exists_fin_linearMap _ _).mpr ⟨n, v, rfl⟩).sup hP, ?_⟩
    rw [sup_smul]
    refine sup_le_sup (smul_le.mpr fun r hr x _ ↦ ?_) hsP
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hr
    exact ⟨c • u x, by rw [map_smul, ← comp_apply, huv]; simp [mul_smul]⟩

/-! ### Finite projective modules and the classical setup -/

variable (S) in
/-- A finite projective module is almost finite projective for every setup: it is a direct summand
of some `Vⁿ`. -/
theorem isAlmostFiniteProjective_of_finite_of_projective [Module.Finite V N]
    [Module.Projective V N] : S.IsAlmostFiniteProjective N := fun ε _ ↦
  let ⟨n, f, g, _, _, hfg⟩ := Module.Finite.exists_comp_eq_id_of_projective V N
  ⟨n, ε • g, f, by rw [comp_smul, hfg]⟩

/-- For the classical setup, almost finite projectivity is finite projectivity. -/
@[simp]
theorem isAlmostFiniteProjective_classical_iff :
    (classical V).IsAlmostFiniteProjective N ↔ Module.Projective V N ∧ Module.Finite V N := by
  refine ⟨fun h ↦ ?_, fun ⟨_, _⟩ ↦ isAlmostFiniteProjective_of_finite_of_projective _⟩
  obtain ⟨n, u, v, huv⟩ := h 1 (by simp)
  rw [one_smul] at huv
  exact ⟨.of_split u v huv, .of_surjective v (surjective_of_comp_eq_id _ _ huv)⟩

/-! ### Almost zero modules -/

/-- An almost zero module is almost finite projective: every `ε • id` with `ε ∈ m` is zero. -/
theorem IsAlmostZero.isAlmostFiniteProjective (h : S.IsAlmostZero N) :
    S.IsAlmostFiniteProjective N := fun ε hε ↦
  ⟨0, 0, 0, LinearMap.ext fun x ↦ by simp [h.smul_eq_zero hε x]⟩

/-- For the zero setup every module is almost finite projective. -/
@[simp]
theorem isAlmostFiniteProjective_zero : (zero V).IsAlmostFiniteProjective N :=
  isAlmostZero_zero.isAlmostFiniteProjective

/-! ### Invariance under almost isomorphisms -/

/-- Almost finite projectivity passes from `M` to `N` as soon as, for every `δ ∈ m`, the map
`δ • id` on `N` factors through `M`. -/
theorem IsAlmostFiniteProjective.of_forall_exists_comp_eq_smul_id
    (h : S.IsAlmostFiniteProjective M)
    (hfg : ∀ δ ∈ S.ideal, ∃ (f : M →ₗ[V] N) (g : N →ₗ[V] M), f ∘ₗ g = δ • LinearMap.id) :
    S.IsAlmostFiniteProjective N := by
  rw [isAlmostFiniteProjective_iff_smul_id_mem_range]
  intro ε hε
  rw [← S.isIdempotentElem.eq] at hε
  -- The admissible `ε` form an ideal, so it suffices to treat the products `a * δ`.
  refine Submodule.mul_induction_on hε (fun a ha δ hδ ↦ ?_) fun x y hx hy ↦ ?_
  · obtain ⟨n, u, v, huv⟩ := h a ha
    obtain ⟨f, g, hfg⟩ := hfg δ hδ
    refine mem_range_dualTensorHom_iff.mpr ⟨n, u ∘ₗ g, f ∘ₗ v, ?_⟩
    rw [comp_assoc, ← comp_assoc g u v, huv, smul_comp, id_comp, comp_smul, hfg, smul_smul]
  · rw [add_smul]
    exact add_mem hx hy

/-- Almost finite projectivity is invariant under almost isomorphisms, so it is a property of the
almost module `N^a`. -/
theorem IsAlmostIso.isAlmostFiniteProjective_iff {f : M →ₗ[V] N} (hf : S.IsAlmostIso f) :
    S.IsAlmostFiniteProjective M ↔ S.IsAlmostFiniteProjective N :=
  ⟨fun h ↦ h.of_forall_exists_comp_eq_smul_id fun _ hδ ↦
      let ⟨g, hg, _⟩ := hf.exists_comp_eq_smul_id hδ
      ⟨f, g, hg⟩,
    fun h ↦ h.of_forall_exists_comp_eq_smul_id fun _ hδ ↦
      let ⟨g, _, hg⟩ := hf.exists_comp_eq_smul_id hδ
      ⟨g, f, hg⟩⟩

end TauCeti.Almost.BasicSetup
