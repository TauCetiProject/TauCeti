module

public import TauCeti.RingTheory.Frobenius.Splitting
public import Mathlib.RingTheory.Localization.FractionRing

/-!
# Frobenius closure of ideals and roots in total fraction rings

A Frobenius splitting contracts the ideal generated by the `p`-th powers of an ideal back
to that ideal. This is Frobenius closure, not radicality: it does not say that an arbitrary
ideal is compatible with the splitting. Iterating gives the same assertion for `p ^ n`-th
powers. In particular, divisibility of `p ^ n`-th powers implies divisibility of their bases.

Consequently a Frobenius-split ring is closed under taking `p ^ n`-th roots in its total
ring of fractions. Clearing a regular denominator reduces this assertion to the principal
ideal case. Thus an intermediate subalgebra of the total fraction ring, each of whose
elements has a `p`-power in the original ring, is the original ring. No domain, Noetherian,
finiteness or perfection assumption is needed. These are algebraic inputs to weak-normality
arguments; they do not by themselves assert that every Frobenius-split ring is normal.

## References

* M. Brion and S. Kumar, *Frobenius splitting methods in geometry and representation theory*,
  Birkhäuser (2005), §1.1 (splittings and their ring-theoretic consequences).
-/

public section

namespace TauCeti.FrobeniusSplitting

variable {R : Type*} [CommRing R] {p : ℕ} [Fact p.Prime]
  (σ : FrobeniusSplitting R p)

include σ

section Ideals

variable [CharP R p]

/-- Applying the splitting to the ideal generated by the `p`-th powers of `I` lands in `I`.
This holds for every ideal, without compatibility with the splitting. -/
theorem apply_mem_of_mem_map_frobenius (I : Ideal R) {a : R}
    (ha : a ∈ I.map (frobenius R p)) : σ a ∈ I := by
  have h : ∀ r : R, σ (r * a) ∈ I := by
    induction ha using Submodule.span_induction with
    | mem a ha =>
      obtain ⟨b, hb, rfl⟩ := ha
      intro r
      simpa only [frobenius_def, mul_comm r, σ.map_pow_mul] using
        I.mul_mem_right (σ r) hb
    | zero => simp
    | add a b _ _ ha hb =>
      intro r
      simpa only [mul_add, map_add] using I.add_mem (ha r) (hb r)
    | smul r a _ ha =>
      intro s
      simpa only [smul_eq_mul, ← mul_assoc] using ha (s * r)
  simpa using h 1

/-- Every ideal of a Frobenius-split ring is Frobenius closed. The extension in the left-hand
side is along Frobenius, not the ordinary ideal power `I ^ p`. -/
theorem comap_map_frobenius (I : Ideal R) :
    (I.map (frobenius R p)).comap (frobenius R p) = I := by
  apply le_antisymm
  · intro a ha
    simpa only [frobenius_def, σ.apply_pow] using σ.apply_mem_of_mem_map_frobenius I ha
  · exact Ideal.le_comap_map

/-- Extension along any iterate of Frobenius contracts back to the original ideal. -/
theorem comap_map_iterateFrobenius (I : Ideal R) (n : ℕ) :
    (I.map (iterateFrobenius R p n)).comap (iterateFrobenius R p n) = I := by
  induction n generalizing I with
  | zero => simp
  | succ n ih =>
    have he : iterateFrobenius R p (n + 1) =
        (frobenius R p).comp (iterateFrobenius R p n) := by
      simpa only [iterateFrobenius_one, Nat.add_comm n 1] using iterateFrobenius_add R p 1 n
    rw [he, ← Ideal.map_map, ← Ideal.comap_comap, σ.comap_map_frobenius, ih]

end Ideals

/-- Divisibility of `p`-th powers in a Frobenius-split ring implies divisibility of the bases.
Equivalently, every principal ideal is Frobenius closed. -/
theorem dvd_of_pow_dvd_pow {a b : R} (h : a ^ p ∣ b ^ p) : a ∣ b := by
  obtain ⟨c, hc⟩ := h
  exact ⟨σ c, by simpa only [σ.apply_pow, σ.map_pow_mul] using congrArg σ hc⟩

/-- A Frobenius splitting detects divisibility on `p ^ n`-th powers, including `n = 0`. -/
theorem pow_dvd_pow_iff (n : ℕ) (a b : R) : a ^ p ^ n ∣ b ^ p ^ n ↔ a ∣ b := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, pow_mul, pow_mul]
    exact ⟨fun h ↦ ih.mp (σ.dvd_of_pow_dvd_pow h), fun h ↦ pow_dvd_pow_of_dvd (ih.mpr h) p⟩

section TotalFractions

variable {Q : Type*} [CommRing Q] [Algebra R Q] [IsFractionRing R Q]

/-- A `p`-th root in the total fraction ring of an element of a Frobenius-split ring already
belongs to the original ring. Regular denominators suffice; the ring need not be a domain. -/
theorem mem_range_algebraMap_of_pow_mem_range {x : Q}
    (hx : x ^ p ∈ (algebraMap R Q).range) : x ∈ (algebraMap R Q).range := by
  obtain ⟨a, ha⟩ := hx
  obtain ⟨⟨b, s⟩, hs⟩ := IsLocalization.surj (nonZeroDivisors R) x
  have hab : a * (s : R) ^ p = b ^ p := by
    apply IsFractionRing.injective R Q
    simpa only [map_mul, map_pow, ha, mul_pow] using congrArg (· ^ p) hs
  have hdiv : (s : R) ∣ b :=
    σ.dvd_of_pow_dvd_pow ⟨a, by simpa only [mul_comm] using hab.symm⟩
  obtain ⟨c, hc⟩ := hdiv
  refine ⟨c, ?_⟩
  apply (IsLocalization.map_units Q s).mul_left_inj.mp
  rw [← map_mul, mul_comm c, ← hc, hs]

/-- A total fraction lies in the original Frobenius-split ring exactly when any given
`p ^ n`-th power does. -/
theorem pow_mem_range_algebraMap_iff (n : ℕ) (x : Q) :
    x ^ p ^ n ∈ (algebraMap R Q).range ↔ x ∈ (algebraMap R Q).range := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, pow_mul]
    exact ⟨fun h ↦ ih.mp (σ.mem_range_algebraMap_of_pow_mem_range h),
      fun h ↦ (algebraMap R Q).range.pow_mem (ih.mpr h) p⟩

/-- An intermediate subalgebra of the total fraction ring, each of whose elements has some
`p ^ n`-th power in the original Frobenius-split ring, is the original ring (`⊥`). The exponent
may depend on the element; neither integrality nor module finiteness is assumed. -/
theorem subalgebra_eq_bot_of_forall_exists_pow_mem_range (A : Subalgebra R Q)
    (hA : ∀ x ∈ A, ∃ n : ℕ, x ^ p ^ n ∈ (algebraMap R Q).range) : A = ⊥ := by
  apply le_bot_iff.mp
  intro x hx
  obtain ⟨n, hn⟩ := hA x hx
  exact (Algebra.mem_bot).mpr ((σ.pow_mem_range_algebraMap_iff n x).mp hn)

end TotalFractions

end TauCeti.FrobeniusSplitting
