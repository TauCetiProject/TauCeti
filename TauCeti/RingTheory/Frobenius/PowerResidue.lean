import TauCeti.RingTheory.RootsOfUnity.Basic

/-!
# Frobenius elements on `n`-th roots: the power residue criterion

Let `S/R` be an extension of commutative rings with `S` a domain, `Q` a prime of `S`, and `φ` an
arithmetic Frobenius at `Q`, so that `φ y ≡ y ^ q (mod Q)` with `q = #(R ⧸ Q ∩ R)`. Suppose `R`
contains an element `ζ` that is a primitive `n`-th root of unity in `S`, with `n ∉ Q`. If
`x ∈ S` is an `n`-th root of `a ∈ R` and `a ∉ Q`, then

`φ x = x ↔ a is an n-th power modulo Q ∩ R`

(`AlgHom.IsArithFrobAt.apply_eq_self_iff`). This is the Frobenius description of the `n`-th
power residue symbol: `φ x = ξ x` for the `n`-th root of unity `ξ ≡ a ^ ((q - 1) / n)`, and `ξ`
is trivial exactly when `a` is an `n`-th power in the residue field.

For a family of Frobenius elements `σ i` at primes `Q i`, the subgroup they generate fixes `x`
exactly when `a` is an `n`-th power modulo every `Q i ∩ R`
(`IsArithFrobAt.forall_mem_closure_smul_eq_self_iff`). This is the form in which Kummer theory
detects, through Frobenius elements, whether an `n`-th root of `a` lies in a given subfield.

At `n = 2` over `ℤ` the value `ξ = ±1` is the Legendre symbol, which is
`AlgHom.IsArithFrobAt.apply_sqrt`.

## Main results

* `Ideal.exists_pow_eq_mk_iff_pow_sub_one_mem`: Euler's criterion in a finite residue domain
  `R ⧸ P` with `n ∣ #(R ⧸ P) - 1`: the class of `a ∉ P` is an `n`-th power exactly when
  `a ^ ((#(R ⧸ P) - 1) / n) ≡ 1 (mod P)`.
* `AlgHom.IsArithFrobAt.dvd_card_sub_one`: `n ∣ q - 1` when `R` contains a primitive `n`-th root
  of unity of `S` and `n ∉ Q`.
* `AlgHom.IsArithFrobAt.sub_pow_mul_mem`: `φ x ≡ a ^ ((q - 1) / n) * x (mod Q)` for `x ^ n = a`.
* `AlgHom.IsArithFrobAt.apply_eq_self_iff`, `IsArithFrobAt.smul_eq_self_iff`: a Frobenius fixes an
  `n`-th root of `a` exactly when `a` is an `n`-th power modulo `Q ∩ R`.
* `IsArithFrobAt.forall_mem_closure_smul_eq_self_iff`: the same for the subgroup generated by a
  family of Frobenius elements.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter V, §3 (the `n`-th power residue symbol).
* J. S. Milne, *Class Field Theory*, v4.03, Chapter VII, proof of Lemma 6.3.
-/

public section

namespace Ideal

variable {R : Type*} [CommRing R]

/-- **Euler's criterion in a finite residue domain.** Let `P` be a prime of `R` with finite
quotient and `n ∣ #(R ⧸ P) - 1`. For `a ∉ P`, the class of `a` is an `n`-th power in `R ⧸ P`
exactly when `a ^ ((#(R ⧸ P) - 1) / n) ≡ 1 (mod P)`. -/
theorem exists_pow_eq_mk_iff_pow_sub_one_mem {P : Ideal R} [P.IsPrime] [Finite (R ⧸ P)] {n : ℕ}
    (hdvd : n ∣ Nat.card (R ⧸ P) - 1) {a : R} (ha : a ∉ P) :
    (∃ b : R ⧸ P, b ^ n = Ideal.Quotient.mk P a) ↔
      a ^ ((Nat.card (R ⧸ P) - 1) / n) - 1 ∈ P := by
  have : P.IsMaximal := Ideal.Quotient.maximal_of_isField P (Finite.isField_of_domain (R ⧸ P))
  let := Ideal.Quotient.field P
  have ha' : Ideal.Quotient.mk P a ≠ 0 := by rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
  rw [TauCeti.FiniteField.exists_pow_eq_iff_pow_card_sub_one_div_eq_one hdvd ha',
    ← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_pow, map_one, sub_eq_zero]

end Ideal

namespace AlgHom.IsArithFrobAt

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] {φ : S →ₐ[R] S} {Q : Ideal S}

/-- If `R` contains an element that is a primitive `n`-th root of unity in the domain `S` and
`n ∉ Q`, then `n` divides `q - 1`, where `q = #(R ⧸ Q ∩ R)` is the exponent of a Frobenius at
`Q`. -/
theorem dvd_card_sub_one [IsDomain S] (H : φ.IsArithFrobAt Q) {n : ℕ} {ζ : R}
    (hζ : IsPrimitiveRoot (algebraMap R S ζ) n) (hn : (n : S) ∉ Q) :
    n ∣ Nat.card (R ⧸ Q.under R) - 1 := by
  have hn0 : n ≠ 0 := by rintro rfl; exact hn (by simp)
  -- The Frobenius fixes the root of unity and raises it to its `q`-th power.
  have h := H.apply_of_pow_eq_one hζ.pow_eq_one hn
  rw [AlgHom.commutes] at h
  apply hζ.dvd_of_pow_eq_one
  refine mul_right_cancel₀ (hζ.ne_zero hn0) ?_
  rw [one_mul, ← pow_succ, Nat.sub_add_cancel H.card_pos, ← h]

/-- **The power residue congruence.** If `x ^ n = a` with `a ∈ R` and `n ∣ q - 1`, where
`q = #(R ⧸ Q ∩ R)`, then a Frobenius at `Q` multiplies `x` by `a ^ ((q - 1) / n)` modulo `Q`. -/
theorem sub_pow_mul_mem (H : φ.IsArithFrobAt Q) {n : ℕ}
    (hdvd : n ∣ Nat.card (R ⧸ Q.under R) - 1) {x : S} {a : R}
    (hx : x ^ n = algebraMap R S a) :
    φ x - algebraMap R S (a ^ ((Nat.card (R ⧸ Q.under R) - 1) / n)) * x ∈ Q := by
  have h := H x
  rwa [← Nat.sub_add_cancel H.card_pos, pow_succ, ← Nat.mul_div_cancel' hdvd, pow_mul, hx,
    ← map_pow] at h

/-- **A Frobenius fixes an `n`-th root exactly at an `n`-th power residue.** Let `S` be a domain,
`Q` a prime of `S`, and `φ` an arithmetic Frobenius at `Q`. Suppose that `ζ ∈ R` is a primitive
`n`-th root of unity in `S` and that `n ∉ Q`. If `x ^ n = a` with `a ∈ R` and `a ∉ Q`, then
`φ x = x` exactly when the class of `a` is an `n`-th power in `R ⧸ Q ∩ R`. -/
theorem apply_eq_self_iff [IsDomain S] [Q.IsPrime] (H : φ.IsArithFrobAt Q) {n : ℕ} {ζ : R}
    (hζ : IsPrimitiveRoot (algebraMap R S ζ) n) (hn : (n : S) ∉ Q) {x : S} {a : R}
    (hx : x ^ n = algebraMap R S a) (ha : algebraMap R S a ∉ Q) :
    φ x = x ↔ ∃ b : R ⧸ Q.under R, b ^ n = Ideal.Quotient.mk _ a := by
  have hn0 : n ≠ 0 := by rintro rfl; exact hn (by simp)
  have hdvd := H.dvd_card_sub_one hζ hn
  have := H.finite_quotient
  have hcong := H.sub_pow_mul_mem hdvd hx
  have hxQ : x ∉ Q := fun h ↦ ha (hx ▸ Q.pow_mem_of_mem h n (Nat.pos_of_ne_zero hn0))
  rw [Ideal.exists_pow_eq_mk_iff_pow_sub_one_mem hdvd (by rwa [Ideal.mem_comap]),
    Ideal.mem_comap, map_sub, map_one]
  constructor
  · intro h
    rw [h] at hcong
    have : (1 - algebraMap R S (a ^ ((Nat.card (R ⧸ Q.under R) - 1) / n))) * x ∈ Q := by
      rwa [sub_mul, one_mul]
    rw [← neg_sub, neg_mem_iff]
    exact (Ideal.IsPrime.mem_or_mem ‹_› this).resolve_right hxQ
  · intro h
    -- `φ x` is an `n`-th root of `a`, hence `ζ ^ i * x` for some `i`.
    have hroot : φ x ∈ Polynomial.nthRoots n (algebraMap R S a) := by
      rw [Polynomial.mem_nthRoots (Nat.pos_of_ne_zero hn0), ← map_pow, hx, AlgHom.commutes]
    rw [hζ.nthRoots_eq hx, Multiset.mem_map] at hroot
    obtain ⟨i, -, hi⟩ := hroot
    -- Modulo `Q`, `ζ ^ i * x ≡ a ^ ((q - 1) / n) * x ≡ x`, so `ζ ^ i ≡ 1` and hence `ζ ^ i = 1`.
    have hmem : (algebraMap R S ζ ^ i - 1) * x ∈ Q := by
      have := Q.add_mem hcong (Q.mul_mem_right x h)
      rw [← hi] at this
      convert this using 1
      ring
    have h1 := TauCeti.eq_one_of_pow_eq_one_of_sub_one_mem hn
      (by rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow])
      ((Ideal.IsPrime.mem_or_mem ‹_› hmem).resolve_right hxQ)
    rw [← hi, h1, one_mul]

end AlgHom.IsArithFrobAt

namespace IsArithFrobAt

variable {R S G : Type*} [CommRing R] [CommRing S] [Algebra R S] [IsDomain S]
  {n : ℕ} {ζ : R} {x : S} {a : R}

/-- **A Frobenius element fixes an `n`-th root exactly at an `n`-th power residue**, action form
of `AlgHom.IsArithFrobAt.apply_eq_self_iff`. -/
theorem smul_eq_self_iff [Monoid G] [MulSemiringAction G S] [SMulCommClass G R S] {Q : Ideal S}
    [Q.IsPrime] {σ : G} (H : IsArithFrobAt R σ Q)
    (hζ : IsPrimitiveRoot (algebraMap R S ζ) n) (hn : (n : S) ∉ Q)
    (hx : x ^ n = algebraMap R S a) (ha : algebraMap R S a ∉ Q) :
    σ • x = x ↔ ∃ b : R ⧸ Q.under R, b ^ n = Ideal.Quotient.mk _ a :=
  AlgHom.IsArithFrobAt.apply_eq_self_iff H hζ hn hx ha

/-- **The subgroup generated by Frobenius elements fixes an `n`-th root exactly at common `n`-th
power residues.** Let `σ i` be an arithmetic Frobenius at the prime `Q i` for every `i`. If
`x ^ n = a`, with `n` and `a` outside every `Q i` and `R` containing a primitive `n`-th root of
unity of `S`, then the subgroup generated by the `σ i` fixes `x` exactly when `a` is an `n`-th
power modulo every `Q i ∩ R`. -/
theorem forall_mem_closure_smul_eq_self_iff [Group G] [MulSemiringAction G S]
    [SMulCommClass G R S] {ι : Type*} {σ : ι → G} {Q : ι → Ideal S} [∀ i, (Q i).IsPrime]
    (H : ∀ i, IsArithFrobAt R (σ i) (Q i))
    (hζ : IsPrimitiveRoot (algebraMap R S ζ) n) (hn : ∀ i, (n : S) ∉ Q i)
    (hx : x ^ n = algebraMap R S a) (ha : ∀ i, algebraMap R S a ∉ Q i) :
    (∀ g ∈ Subgroup.closure (Set.range σ), g • x = x) ↔
      ∀ i, ∃ b : R ⧸ (Q i).under R, b ^ n = Ideal.Quotient.mk _ a := by
  rw [TauCeti.forall_mem_closure_smul_eq_self_iff, Set.forall_mem_range]
  exact forall_congr' fun i ↦ (H i).smul_eq_self_iff hζ (hn i) hx (ha i)

end IsArithFrobAt
