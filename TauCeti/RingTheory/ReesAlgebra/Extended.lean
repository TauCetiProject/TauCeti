module

public import Mathlib.Algebra.Polynomial.Laurent
public import Mathlib.RingTheory.ReesAlgebra
public import TauCeti.RingTheory.Ideal.AssociatedGraded
import TauCeti.Algebra.Polynomial.Laurent.Coeff

/-!
# The extended Rees algebra of an ideal

For an ideal `I` of a commutative ring `R`, the extended Rees algebra `R[It, t⁻¹]` is the
subalgebra of the Laurent polynomial ring `R[T;T⁻¹]` of the Laurent polynomials `∑ aₙ Tⁿ` with
`aₙ ∈ Iⁿ` for every `n ≥ 0` and no condition in negative degrees. Its part of nonnegative degree
is the ordinary Rees algebra `R[It]` (Mathlib's `reesAlgebra I`), and its quotient by the
parameter `t⁻¹` is the associated graded ring `gr_I R = ⨁ₙ Iⁿ ⧸ Iⁿ⁺¹`. This is the algebraic form
of the deformation to the normal cone: over the parameter `t⁻¹` the extended Rees algebra
degenerates `R` to `gr_I R`, and the identification of this special fibre is the main result.

Membership is stated as `aₙ ∈ I ^ n.toNat` for every `n : ℤ`; for negative `n` this is the empty
condition `aₙ ∈ I ^ 0 = R`.

## Main definitions

* `Ideal.extendedReesAlgebra I`: the extended Rees algebra `R[It, t⁻¹]` inside `R[T;T⁻¹]`.
* `Ideal.extendedReesAlgebra.tInv I`: the parameter `t⁻¹ = T (-1)`.
* `Ideal.extendedReesAlgebra.toAssociatedGraded I`: the symbol map `R[It, t⁻¹] → gr_I R`, whose
  degree `n` component sends `∑ aₖ Tᵏ` to the class of `aₙ` in `Iⁿ ⧸ Iⁿ⁺¹`.
* `Ideal.extendedReesAlgebra.quotientEquivAssociatedGraded I`: the `R`-algebra isomorphism
  `R[It, t⁻¹] ⧸ (t⁻¹) ≃ gr_I R`.

## Main results

* `Ideal.mem_extendedReesAlgebra_iff_forall_natCast`: only the coefficients of nonnegative degree
  are constrained.
* `Ideal.adjoin_eq_extendedReesAlgebra`: the extended Rees algebra is generated by `t⁻¹` and the
  elements `a t` with `a ∈ I`.
* `Ideal.comap_toLaurentAlg_extendedReesAlgebra` and `Ideal.map_toLaurentAlg_reesAlgebra`: the
  polynomials in the extended Rees algebra form the Rees algebra `reesAlgebra I`.
* `Ideal.extendedReesAlgebra.mem_span_tInv_iff`: an element is a multiple of `t⁻¹` exactly when
  its coefficient of degree `n` lies in `Iⁿ⁺¹` for every `n ≥ 0`.
* `Ideal.extendedReesAlgebra.ker_toAssociatedGraded`: the kernel of the symbol map is `(t⁻¹)`.

## References

* D. Eisenbud, *Commutative Algebra with a View Toward Algebraic Geometry*, §6.5.
* W. Bruns and J. Herzog, *Cohen–Macaulay Rings*, §4.5.
-/

public section

open LaurentPolynomial
open scoped Polynomial

namespace Ideal

variable {R : Type*} [CommRing R] (I : Ideal R)

/-- The extended Rees algebra `R[It, t⁻¹]` of an ideal `I`: the Laurent polynomials whose
coefficient of degree `n` lies in `Iⁿ` for every `n ≥ 0`. -/
def extendedReesAlgebra : Subalgebra R R[T;T⁻¹] where
  carrier := {f | ∀ n : ℤ, f.coeff n ∈ I ^ n.toNat}
  mul_mem' {f g} hf hg n := by
    classical
    rw [AddMonoidAlgebra.coeff_mul]
    refine Ideal.sum_mem _ fun i _ ↦ Ideal.sum_mem _ fun j _ ↦ ?_
    dsimp only
    split_ifs with h
    · refine Ideal.pow_le_pow_right (n := i.toNat + j.toNat) (by omega) ?_
      rw [pow_add]
      exact Ideal.mul_mem_mul (hf i) (hg j)
    · exact zero_mem _
  add_mem' hf hg n := by
    rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply]
    exact add_mem (hf n) (hg n)
  algebraMap_mem' r n := by
    rw [← LaurentPolynomial.C_eq_algebraMap, C_apply]
    split_ifs with h
    · simp [h]
    · exact zero_mem _

variable {I}

/-- The defining property of the extended Rees algebra. -/
@[simp]
theorem mem_extendedReesAlgebra_iff {f : R[T;T⁻¹]} :
    f ∈ I.extendedReesAlgebra ↔ ∀ n : ℤ, f.coeff n ∈ I ^ n.toNat :=
  Iff.rfl

/-- Only the coefficients of nonnegative degree of an element of the extended Rees algebra are
constrained: the one of degree `n ≥ 0` lies in `Iⁿ`. -/
theorem mem_extendedReesAlgebra_iff_forall_natCast {f : R[T;T⁻¹]} :
    f ∈ I.extendedReesAlgebra ↔ ∀ n : ℕ, f.coeff n ∈ I ^ n := by
  refine ⟨fun h n ↦ by simpa using h n, fun h n ↦ ?_⟩
  rcases le_or_gt 0 n with hn | hn
  · lift n to ℕ using hn
    simpa using h n
  · simp [Int.toNat_eq_zero.mpr hn.le]

/-- The coefficient of degree `n ≥ 0` of an element of the extended Rees algebra lies in `Iⁿ`. -/
theorem coeff_natCast_mem_pow {f : R[T;T⁻¹]} (hf : f ∈ I.extendedReesAlgebra) (n : ℕ) :
    f.coeff n ∈ I ^ n :=
  mem_extendedReesAlgebra_iff_forall_natCast.mp hf n

/-- The monomial `r Tⁿ` lies in the extended Rees algebra exactly when `r ∈ Iⁿ`, a condition
that is empty for `n < 0`. -/
theorem C_mul_T_mem_extendedReesAlgebra_iff {r : R} {n : ℤ} :
    C r * T n ∈ I.extendedReesAlgebra ↔ r ∈ I ^ n.toNat := by
  classical
  refine ⟨fun h ↦ by simpa [← single_eq_C_mul_T] using h n, fun h m ↦ ?_⟩
  rw [← single_eq_C_mul_T, AddMonoidAlgebra.coeff_single, Finsupp.single_apply]
  split_ifs with hm
  · exact hm ▸ h
  · exact zero_mem _

/-- The monomials `Tⁿ` of nonpositive degree lie in the extended Rees algebra. -/
theorem T_mem_extendedReesAlgebra_of_nonpos {n : ℤ} (hn : n ≤ 0) :
    T n ∈ I.extendedReesAlgebra := by
  simpa [Int.toNat_eq_zero.mpr hn] using
    C_mul_T_mem_extendedReesAlgebra_iff (I := I) (r := 1) (n := n)

variable (I)

/-- **Generators of the extended Rees algebra.** `R[It, t⁻¹]` is generated as an `R`-algebra by
`t⁻¹` and the elements `a t` with `a ∈ I`. -/
theorem adjoin_eq_extendedReesAlgebra :
    Algebra.adjoin R (insert (T (-1)) ((fun a ↦ C a * T 1) '' I)) = I.extendedReesAlgebra := by
  set A := Algebra.adjoin R (insert (T (-1) : R[T;T⁻¹]) ((fun a ↦ C a * T 1) '' I))
  refine le_antisymm (Algebra.adjoin_le ?_) fun f hf ↦ ?_
  · rintro _ (rfl | ⟨a, ha, rfl⟩)
    · exact T_mem_extendedReesAlgebra_of_nonpos (by norm_num)
    · exact C_mul_T_mem_extendedReesAlgebra_iff.mpr (by simpa using ha)
  -- The polynomials of the Rees algebra lie in `A`, being generated by the elements `a t`.
  have hrees : (reesAlgebra I).map Polynomial.toLaurentAlg ≤ A := by
    rw [← adjoin_monomial_eq_reesAlgebra, AlgHom.map_adjoin]
    refine Algebra.adjoin_mono (subset_trans ?_ (Set.subset_insert _ _))
    rintro _ ⟨_, ⟨a, ha, rfl⟩, rfl⟩
    exact ⟨a, ha, by simp [Polynomial.toLaurentAlg_apply, ← Polynomial.C_mul_X_eq_monomial]⟩
  rw [← AddMonoidAlgebra.sum_coeff_single f]
  refine Subalgebra.sum_mem _ fun n _ ↦ ?_
  rw [single_eq_C_mul_T]
  rcases le_or_gt 0 n with hn | hn
  · lift n to ℕ using hn
    refine hrees ⟨Polynomial.monomial n (f.coeff n), reesAlgebra.monomial_mem.mpr
      (coeff_natCast_mem_pow hf n), ?_⟩
    simp [Polynomial.toLaurentAlg_apply, ← Polynomial.C_mul_X_pow_eq_monomial]
  · -- In negative degree, `r Tⁿ = r (t⁻¹)⁻ⁿ`.
    obtain ⟨k, rfl⟩ := Int.exists_eq_neg_ofNat hn.le
    have hT : (T (-(k : ℤ)) : R[T;T⁻¹]) = T (-1) ^ k := by rw [T_pow]; ring_nf
    rw [hT, LaurentPolynomial.C_eq_algebraMap]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_insert _ _)) k)

/-- **The nonnegative part of the extended Rees algebra is the Rees algebra.** A polynomial lies
in the extended Rees algebra exactly when it lies in `reesAlgebra I`. -/
theorem comap_toLaurentAlg_extendedReesAlgebra :
    I.extendedReesAlgebra.comap Polynomial.toLaurentAlg = reesAlgebra I := by
  ext p
  rw [Subalgebra.mem_comap, mem_extendedReesAlgebra_iff_forall_natCast, mem_reesAlgebra_iff]
  refine forall_congr' fun n ↦ ?_
  rw [Polynomial.toLaurentAlg_apply, ← coeff_trunc, Polynomial.trunc_toLaurent]

/-- The image of the Rees algebra `reesAlgebra I` in `R[T;T⁻¹]` consists of the elements of the
extended Rees algebra that are polynomials. -/
theorem map_toLaurentAlg_reesAlgebra :
    (reesAlgebra I).map Polynomial.toLaurentAlg =
      I.extendedReesAlgebra ⊓ Polynomial.toLaurentAlg.range := by
  ext f
  refine ⟨?_, ?_⟩
  · rintro ⟨p, hp, rfl⟩
    refine ⟨?_, p, rfl⟩
    rw [← comap_toLaurentAlg_extendedReesAlgebra] at hp
    exact hp
  · rintro ⟨hf, p, rfl⟩
    refine ⟨p, ?_, rfl⟩
    rw [← comap_toLaurentAlg_extendedReesAlgebra]
    exact hf

namespace extendedReesAlgebra

/-- The parameter `t⁻¹ = T (-1)` of the extended Rees algebra. -/
noncomputable def tInv : I.extendedReesAlgebra :=
  ⟨T (-1), T_mem_extendedReesAlgebra_of_nonpos (by norm_num)⟩

/-- The parameter `t⁻¹` is the Laurent monomial `T (-1)`. -/
@[simp]
theorem coe_tInv : (tInv I : R[T;T⁻¹]) = T (-1) :=
  (rfl)

variable {I}

/-- **Multiples of `t⁻¹`.** An element of the extended Rees algebra is a multiple of `t⁻¹`
exactly when its coefficient of degree `n` lies in `Iⁿ⁺¹` for every `n ≥ 0`. -/
theorem mem_span_tInv_iff {f : I.extendedReesAlgebra} :
    f ∈ Ideal.span {tInv I} ↔ ∀ n : ℕ, (f : R[T;T⁻¹]).coeff n ∈ I ^ (n + 1) := by
  rw [Ideal.mem_span_singleton']
  refine ⟨?_, fun h ↦ ?_⟩
  · rintro ⟨g, rfl⟩ n
    rw [MulMemClass.coe_mul, coe_tInv, ← T_mul, coeff_T_mul, sub_neg_eq_add]
    exact_mod_cast coeff_natCast_mem_pow g.property (n + 1)
  · -- The quotient is `T * f`, whose coefficient of degree `n + 1` is that of `f` in degree `n`.
    have hg : T 1 * (f : R[T;T⁻¹]) ∈ I.extendedReesAlgebra := by
      refine mem_extendedReesAlgebra_iff_forall_natCast.mpr fun n ↦ ?_
      rw [coeff_T_mul]
      rcases n with _ | n
      · simp
      · simpa using h n
    refine ⟨⟨_, hg⟩, Subtype.ext ?_⟩
    rw [MulMemClass.coe_mul, coe_tInv, mul_comm, ← mul_assoc, ← T_add]
    simp [T_zero]

variable (I)

/-- The degree `n` part of the symbol of an element of the extended Rees algebra: the class of its
coefficient of degree `n` in `Iⁿ ⧸ Iⁿ⁺¹`. -/
private noncomputable def symbolTerm (f : I.extendedReesAlgebra) (n : ℕ) : I.AssociatedGraded :=
  AssociatedGraded.mk I n ⟨(f : R[T;T⁻¹]).coeff n, coeff_natCast_mem_pow f.property n⟩

private theorem symbolTerm_eq_zero {f : I.extendedReesAlgebra} {n : ℕ}
    (h : (f : R[T;T⁻¹]).coeff n = 0) : symbolTerm I f n = 0 := by
  simp [symbolTerm, h]

/-- The symbol of an element of the extended Rees algebra, as a function. -/
private noncomputable def symbolFun (f : I.extendedReesAlgebra) : I.AssociatedGraded :=
  ∑ n ∈ (trunc (f : R[T;T⁻¹])).support, symbolTerm I f n

/-- The symbol may be computed as a sum over any finite set of degrees containing every
nonnegative degree of a nonzero coefficient. -/
private theorem symbolFun_eq_sum (f : I.extendedReesAlgebra) {s : Finset ℕ}
    (hs : ∀ n ∉ s, (f : R[T;T⁻¹]).coeff n = 0) : symbolFun I f = ∑ n ∈ s, symbolTerm I f n := by
  refine (Finset.sum_subset Finset.subset_union_left fun n _ hn ↦ ?_).trans
    (Finset.sum_subset Finset.subset_union_right fun n _ hn ↦ symbolTerm_eq_zero I (hs n hn)).symm
  rw [Polynomial.notMem_support_iff, coeff_trunc] at hn
  exact symbolTerm_eq_zero I hn

private theorem symbolFun_add (f g : I.extendedReesAlgebra) :
    symbolFun I (f + g) = symbolFun I f + symbolFun I g := by
  set s := (trunc (f : R[T;T⁻¹])).support ∪ (trunc (g : R[T;T⁻¹])).support
  have hf (n) (hn : n ∉ s) : (f : R[T;T⁻¹]).coeff n = 0 := by
    simpa [s] using (Finset.notMem_union.mp hn).1
  have hg (n) (hn : n ∉ s) : (g : R[T;T⁻¹]).coeff n = 0 := by
    simpa [s] using (Finset.notMem_union.mp hn).2
  rw [symbolFun_eq_sum I (f + g) (s := s) fun n hn ↦ by simp [hf n hn, hg n hn],
    symbolFun_eq_sum I f hf, symbolFun_eq_sum I g hg, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rw [symbolTerm, symbolTerm, symbolTerm, ← map_add]
  exact congrArg _ (Subtype.ext (by simp))

private theorem symbolFun_smul (r : R) (f : I.extendedReesAlgebra) :
    symbolFun I (r • f) = r • symbolFun I f := by
  have hf (n) (hn : n ∉ (trunc (f : R[T;T⁻¹])).support) : (f : R[T;T⁻¹]).coeff n = 0 := by
    simpa using hn
  rw [symbolFun_eq_sum I (r • f) (s := (trunc (f : R[T;T⁻¹])).support) fun n hn ↦ by
      simp [LaurentPolynomial.smul_eq_C_mul, hf n hn],
    symbolFun_eq_sum I f hf, Finset.smul_sum]
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rw [symbolTerm, symbolTerm, ← map_smul]
  exact congrArg _ (Subtype.ext (by simp [LaurentPolynomial.smul_eq_C_mul]))

/-- The symbol of a monomial `r Tⁿ` is the class of `r` in degree `n` for `n ≥ 0`. -/
private theorem symbolFun_C_mul_T_natCast {n : ℕ} {r : R} (hr : r ∈ I ^ n) :
    symbolFun I ⟨C r * T n, C_mul_T_mem_extendedReesAlgebra_iff.mpr (by simpa using hr)⟩ =
      AssociatedGraded.mk I n ⟨r, hr⟩ := by
  classical
  rw [symbolFun_eq_sum I _ (s := {n}) fun m hm ↦ ?_, Finset.sum_singleton, symbolTerm]
  · congr 2
    simp [← single_eq_C_mul_T]
  · simp only [← single_eq_C_mul_T, AddMonoidAlgebra.coeff_single, Finsupp.single_apply]
    simp_all [eq_comm]

/-- The symbol of a monomial `r Tⁿ` of negative degree vanishes. -/
private theorem symbolFun_C_mul_T_of_neg {n : ℤ} (hn : n < 0) {r : R}
    (h : C r * T n ∈ I.extendedReesAlgebra) : symbolFun I ⟨C r * T n, h⟩ = 0 := by
  classical
  rw [symbolFun_eq_sum I _ (s := ∅) fun m _ ↦ ?_, Finset.sum_empty]
  simp only [← single_eq_C_mul_T, AddMonoidAlgebra.coeff_single, Finsupp.single_apply]
  split_ifs with h
  · omega
  · rfl

variable {I} in
/-- The product of two monomials of the extended Rees algebra is a monomial. -/
private theorem C_mul_T_mul_C_mul_T_mem {m n : ℤ} {a b : R}
    (ha : C a * T m ∈ I.extendedReesAlgebra) (hb : C b * T n ∈ I.extendedReesAlgebra) :
    C (a * b) * T (m + n) ∈ I.extendedReesAlgebra := by
  rw [show C (a * b) * T (m + n) = C a * T m * (C b * T n) by rw [map_mul, T_add]; ring]
  exact mul_mem ha hb

variable {I} in
private theorem mk_C_mul_T_mul_mk_C_mul_T {m n : ℤ} {a b : R}
    (ha : C a * T m ∈ I.extendedReesAlgebra) (hb : C b * T n ∈ I.extendedReesAlgebra) :
    (⟨C a * T m, ha⟩ * ⟨C b * T n, hb⟩ : I.extendedReesAlgebra) =
      ⟨C (a * b) * T (m + n), C_mul_T_mul_C_mul_T_mem ha hb⟩ := by
  ext1
  simp only [MulMemClass.coe_mul, map_mul, T_add]
  ring

/-- A product with a monomial of negative degree has symbol zero: its coefficient lies in a power
of `I` above its degree. -/
private theorem symbolFun_C_mul_T_mul_C_mul_T_of_neg {m n : ℤ} {a b : R}
    (ha : C a * T m ∈ I.extendedReesAlgebra) (hb : C b * T n ∈ I.extendedReesAlgebra)
    (hm : m < 0) : symbolFun I (⟨C a * T m, ha⟩ * ⟨C b * T n, hb⟩) = 0 := by
  rw [mk_C_mul_T_mul_mk_C_mul_T]
  rcases lt_or_ge (m + n) 0 with hmn | hmn
  · exact symbolFun_C_mul_T_of_neg I hmn _
  -- Here `n > m + n ≥ 0`, so `a * b ∈ Iⁿ ⊆ I ^ (m + n + 1)`.
  have hb' := C_mul_T_mem_extendedReesAlgebra_iff.mp hb
  lift m + n to ℕ using hmn with k hk
  have hab : a * b ∈ I ^ (k + 1) :=
    Ideal.pow_le_pow_right (by omega) (Ideal.mul_mem_left _ a hb')
  rw [symbolFun_C_mul_T_natCast I (Ideal.pow_le_pow_right k.le_succ hab),
    AssociatedGraded.mk_eq_zero_iff]
  exact hab

/-- The symbol is multiplicative on monomials: for nonnegative degrees this is the product rule
of `gr_I R`. -/
private theorem symbolFun_C_mul_T_mul_C_mul_T {m n : ℤ} {a b : R}
    (ha : C a * T m ∈ I.extendedReesAlgebra) (hb : C b * T n ∈ I.extendedReesAlgebra) :
    symbolFun I (⟨C a * T m, ha⟩ * ⟨C b * T n, hb⟩) =
      symbolFun I ⟨C a * T m, ha⟩ * symbolFun I ⟨C b * T n, hb⟩ := by
  rcases lt_or_ge m 0 with hm | hm
  · rw [symbolFun_C_mul_T_mul_C_mul_T_of_neg I ha hb hm, symbolFun_C_mul_T_of_neg I hm,
      zero_mul]
  rcases lt_or_ge n 0 with hn | hn
  · rw [mul_comm, symbolFun_C_mul_T_mul_C_mul_T_of_neg I hb ha hn,
      symbolFun_C_mul_T_of_neg I hn, mul_zero]
  have ha' := C_mul_T_mem_extendedReesAlgebra_iff.mp ha
  have hb' := C_mul_T_mem_extendedReesAlgebra_iff.mp hb
  rw [mk_C_mul_T_mul_mk_C_mul_T]
  lift m to ℕ using hm
  lift n to ℕ using hn
  simp only [Int.toNat_natCast] at ha' hb'
  simp only [← Nat.cast_add]
  rw [symbolFun_C_mul_T_natCast I ha', symbolFun_C_mul_T_natCast I hb',
    symbolFun_C_mul_T_natCast I (by rw [pow_add]; exact Ideal.mul_mem_mul ha' hb'),
    AssociatedGraded.mk_mul_mk]

variable {I} in
/-- An element of the extended Rees algebra is the sum of its monomials `aₙ Tⁿ`. -/
theorem as_sum_support (f : I.extendedReesAlgebra) :
    f = ∑ n ∈ (f : R[T;T⁻¹]).coeff.support, ⟨C ((f : R[T;T⁻¹]).coeff n) * T n,
      C_mul_T_mem_extendedReesAlgebra_iff.mpr (mem_extendedReesAlgebra_iff.mp f.property n)⟩ := by
  refine Subtype.ext ?_
  rw [AddSubmonoidClass.coe_finsetSum]
  conv_lhs => rw [← AddMonoidAlgebra.sum_coeff_single (f : R[T;T⁻¹])]
  simp [Finsupp.sum, single_eq_C_mul_T]

/-- The symbol map as an `R`-linear map. -/
private noncomputable def symbolLinearMap : I.extendedReesAlgebra →ₗ[R] I.AssociatedGraded where
  toFun := symbolFun I
  map_add' := symbolFun_add I
  map_smul' := symbolFun_smul I

private theorem symbolLinearMap_mul (f g : I.extendedReesAlgebra) :
    symbolLinearMap I (f * g) = symbolLinearMap I f * symbolLinearMap I g := by
  rw [as_sum_support f, as_sum_support g]
  simp only [Finset.sum_mul_sum, map_sum]
  exact Finset.sum_congr rfl fun _ _ ↦ Finset.sum_congr rfl fun _ _ ↦
    symbolFun_C_mul_T_mul_C_mul_T I _ _

/-- The **symbol map** `R[It, t⁻¹] → gr_I R`: the degree `n` component of the symbol of
`∑ aₖ Tᵏ` is the class of `aₙ ∈ Iⁿ` in `Iⁿ ⧸ Iⁿ⁺¹`, and the terms of negative degree are
forgotten. -/
noncomputable def toAssociatedGraded : I.extendedReesAlgebra →ₐ[R] I.AssociatedGraded :=
  AlgHom.ofLinearMap (symbolLinearMap I)
    (by
      have h := symbolFun_C_mul_T_natCast I (n := 0) (r := 1) (by simp)
      simp only [map_one, Nat.cast_zero, T_zero, mul_one] at h
      rw [← AssociatedGraded.mk_zero_one]
      exact h)
    (symbolLinearMap_mul I)

private theorem coe_toAssociatedGraded : ⇑(toAssociatedGraded I) = symbolFun I :=
  (rfl)

/-- The symbol of a monomial `r Tⁿ` with `n ≥ 0` and `r ∈ Iⁿ` is the class of `r` in degree
`n`. -/
@[simp]
theorem toAssociatedGraded_C_mul_T_natCast {n : ℕ} {r : R} (hr : r ∈ I ^ n) :
    toAssociatedGraded I
        ⟨C r * T n, C_mul_T_mem_extendedReesAlgebra_iff.mpr (by simpa using hr)⟩ =
      AssociatedGraded.mk I n ⟨r, hr⟩ := by
  rw [coe_toAssociatedGraded, symbolFun_C_mul_T_natCast]

/-- The symbol of a monomial of negative degree vanishes. -/
theorem toAssociatedGraded_C_mul_T_of_neg {n : ℤ} (hn : n < 0) {r : R}
    (h : C r * T n ∈ I.extendedReesAlgebra) : toAssociatedGraded I ⟨C r * T n, h⟩ = 0 := by
  rw [coe_toAssociatedGraded, symbolFun_C_mul_T_of_neg I hn]

/-- The parameter `t⁻¹` has symbol zero. -/
@[simp]
theorem toAssociatedGraded_tInv : toAssociatedGraded I (tInv I) = 0 := by
  have h := toAssociatedGraded_C_mul_T_of_neg I (n := -1) (by norm_num) (r := 1)
    (by simpa using T_mem_extendedReesAlgebra_of_nonpos (I := I) (n := -1) (by norm_num))
  simp only [map_one, one_mul] at h
  exact h

/-- The degree `n` component of the symbol of `f` is the class of the coefficient of degree `n`
of `f` in `Iⁿ ⧸ Iⁿ⁺¹`. -/
theorem toAssociatedGraded_apply (f : I.extendedReesAlgebra) (n : ℕ) :
    toAssociatedGraded I f n =
      Submodule.Quotient.mk ⟨(f : R[T;T⁻¹]).coeff n, coeff_natCast_mem_pow f.property n⟩ := by
  classical
  rw [coe_toAssociatedGraded,
    symbolFun_eq_sum I f (s := insert n (trunc (f : R[T;T⁻¹])).support) fun m hm ↦ by
      simpa using (not_or.mp (Finset.mem_insert.not.mp hm)).2,
    DFinsupp.finsetSum_apply, Finset.sum_eq_single_of_mem _ (Finset.mem_insert_self _ _)]
  · rw [symbolTerm, AssociatedGraded.mk_apply, DirectSum.of_eq_same]
  · intro m _ hm
    rw [symbolTerm, AssociatedGraded.mk_apply, DirectSum.of_eq_of_ne _ _ _ hm.symm]

/-- The symbol map is surjective: the class of `r ∈ Iⁿ` in degree `n` is the symbol of `r Tⁿ`. -/
theorem toAssociatedGraded_surjective : Function.Surjective (toAssociatedGraded I) := by
  intro x
  induction x using DirectSum.induction_on with
  | zero => exact ⟨0, map_zero _⟩
  | of n y =>
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y
    exact ⟨_, (toAssociatedGraded_C_mul_T_natCast I y.property).trans
      (AssociatedGraded.mk_apply n y)⟩
  | add x y hx hy =>
    obtain ⟨f, rfl⟩ := hx
    obtain ⟨g, rfl⟩ := hy
    exact ⟨f + g, map_add _ f g⟩

/-- **The kernel of the symbol map is generated by `t⁻¹`.** -/
theorem ker_toAssociatedGraded : RingHom.ker (toAssociatedGraded I) = Ideal.span {tInv I} := by
  ext f
  rw [RingHom.mem_ker, mem_span_tInv_iff, DirectSum.ext_iff]
  refine forall_congr' fun n ↦ ?_
  rw [toAssociatedGraded_apply, DirectSum.zero_apply, gradedPiece_mk_eq_zero_iff]

/-- **The special fibre of the extended Rees algebra is the associated graded ring.** The quotient
of `R[It, t⁻¹]` by `t⁻¹` is isomorphic to `gr_I R` through the symbol map. -/
noncomputable def quotientEquivAssociatedGraded :
    (I.extendedReesAlgebra ⧸ Ideal.span {tInv I}) ≃ₐ[R] I.AssociatedGraded :=
  (Ideal.quotientEquivAlgOfEq R (ker_toAssociatedGraded I).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (toAssociatedGraded_surjective I))

@[simp]
theorem quotientEquivAssociatedGraded_mk (f : I.extendedReesAlgebra) :
    quotientEquivAssociatedGraded I (Ideal.Quotient.mk _ f) = toAssociatedGraded I f :=
  (rfl)

/-- The inverse isomorphism sends the class of `r ∈ Iⁿ` in degree `n` to the class of `r Tⁿ`. -/
theorem quotientEquivAssociatedGraded_symm_mk {n : ℕ} {r : R} (hr : r ∈ I ^ n) :
    (quotientEquivAssociatedGraded I).symm (AssociatedGraded.mk I n ⟨r, hr⟩) =
      Ideal.Quotient.mk _
        ⟨C r * T n, C_mul_T_mem_extendedReesAlgebra_iff.mpr (by simpa using hr)⟩ := by
  rw [AlgEquiv.symm_apply_eq, quotientEquivAssociatedGraded_mk,
    toAssociatedGraded_C_mul_T_natCast]

end extendedReesAlgebra

end Ideal
