/-!
# Secant sequences and parameter completion

A finite sequence `r₁, …, rₛ` in a local ring `(R, 𝔪)` is *secant* for an `R`-module `M`
(`RingTheory.Sequence.IsSecant`) if every entry lies in `𝔪` and every step strictly lowers the
support dimension of the prefix quotient:
`supportDim R (M ⧸ (r₁, …, rᵢ) M) < supportDim R (M ⧸ (r₁, …, rᵢ₋₁) M)`.

For a nonzero finite module over a Noetherian local ring, `rs` is secant iff every entry lies in
`𝔪` and `supportDim R (M ⧸ (rs) M) + rs.length = supportDim R M`. This implies permanence under
permutations, reversal, positive powers, sublists, and truncated products `take i ++ [rᵢ * rⱼ]`,
that every `M`-regular sequence is secant, and parameter completion (`@[stacks 00KQ]`).

## Main definitions & results

* `RingTheory.Sequence.IsSecant`, `LinearEquiv.isSecant_iff`, `isSecant_append_iff`,
  `isSecant_cons_iff`, `isSecant_iff_supportDim_add_length_eq`.
* `IsSecant.perm`, `IsSecant.reverse`, `IsSecant.of_forall₂_pow`, `IsSecant.set_pow`,
  `IsSecant.sublist`, `IsSecant.take_append_mul`, `IsRegular.isSecant`.
* `exists_isSecant_supportDim_eq_zero`, `IsSecant.exists_append_supportDim_eq_zero`.

## References

* K. Česnavičius, *Macaulayfication of Noetherian schemes*, Duke Math. J. 170 (2021),
  Definition 3.1(i), Remark 3.2.
* [Stacks Project, Proposition 10.60.9](https://stacks.math.columbia.edu/tag/00KQ).
-/

public section

universe u v w

open IsLocalRing Pointwise

namespace RingTheory.Sequence

section Basic

variable {R : Type u} [CommRing R] [IsLocalRing R]

/-- A sequence `rs` in a local ring `(R, 𝔪)` is *secant* for an `R`-module `M` if every entry lies
in `𝔪` and every step strictly lowers the support dimension of the prefix quotient. Only the empty
list is secant for a subsingleton module. -/
def IsSecant (M : Type v) [AddCommGroup M] [Module R M] (rs : List R) : Prop :=
  (∀ r ∈ rs, r ∈ maximalIdeal R) ∧
    ∀ i : Fin rs.length,
      Module.supportDim R (M ⧸ Ideal.ofList (rs.take (i.val + 1)) • (⊤ : Submodule R M)) <
        Module.supportDim R (M ⧸ Ideal.ofList (rs.take i.val) • (⊤ : Submodule R M))

variable {M : Type v} [AddCommGroup M] [Module R M]

/-- Unfolds `RingTheory.Sequence.IsSecant`. -/
theorem isSecant_iff {rs : List R} :
    IsSecant M rs ↔
      (∀ r ∈ rs, r ∈ maximalIdeal R) ∧
        ∀ i : Fin rs.length,
          Module.supportDim R (M ⧸ Ideal.ofList (rs.take (i.val + 1)) • (⊤ : Submodule R M)) <
            Module.supportDim R (M ⧸ Ideal.ofList (rs.take i.val) • (⊤ : Submodule R M)) :=
  (Iff.rfl)

/-- Every entry of a secant sequence lies in the maximal ideal. -/
theorem IsSecant.mem_maximalIdeal {rs : List R} (h : IsSecant M rs) {r : R} (hr : r ∈ rs) :
    r ∈ maximalIdeal R :=
  h.1 r hr

/-- The ideal generated by a secant sequence is contained in the maximal ideal. -/
theorem IsSecant.ofList_le_maximalIdeal {rs : List R} (h : IsSecant M rs) :
    Ideal.ofList rs ≤ maximalIdeal R :=
  Ideal.span_le.mpr fun _ hr ↦ h.mem_maximalIdeal hr

/-- Each step of a secant sequence strictly lowers the support dimension of the prefix quotient. -/
theorem IsSecant.supportDim_take_succ_lt {rs : List R} (h : IsSecant M rs) (i : Fin rs.length) :
    Module.supportDim R (M ⧸ Ideal.ofList (rs.take (i.val + 1)) • (⊤ : Submodule R M)) <
      Module.supportDim R (M ⧸ Ideal.ofList (rs.take i.val) • (⊤ : Submodule R M)) :=
  h.2 i

/-- The empty list is secant for every module, including the zero module. -/
@[simp]
theorem isSecant_nil : IsSecant M ([] : List R) :=
  ⟨fun _ h ↦ (List.not_mem_nil h).elim, fun i ↦ Fin.elim0 i⟩

/-- For a secant sequence, every strict prefix quotient (at index `i : Fin rs.length`) is
nontrivial. -/
theorem IsSecant.nontrivial_quotient_take {rs : List R} (h : IsSecant M rs) (i : Fin rs.length) :
    Nontrivial (M ⧸ Ideal.ofList (rs.take i.val) • (⊤ : Submodule R M)) :=
  (Module.supportDim_ne_bot_iff_nontrivial R _).mp (ne_bot_of_gt (h.supportDim_take_succ_lt i))

/-- A module admitting a nonempty secant sequence is nontrivial. -/
theorem IsSecant.nontrivial_of_ne_nil {rs : List R} (h : IsSecant M rs) (hne : rs ≠ []) :
    Nontrivial M := by
  have hnt := h.nontrivial_quotient_take ⟨0, List.length_pos_of_ne_nil hne⟩
  rw [List.take_zero] at hnt
  exact (Submodule.quotOfListNilSMulTopEquiv R M).toEquiv.nontrivial_congr.mp hnt

/-- For a subsingleton module, only the empty list is secant. -/
theorem isSecant_iff_eq_nil_of_subsingleton [Subsingleton M] {rs : List R} :
    IsSecant M rs ↔ rs = [] := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ isSecant_nil⟩
  by_contra hne
  exact (not_subsingleton_iff_nontrivial.mpr (h.nontrivial_of_ne_nil hne)) ‹Subsingleton M›

/-- A singleton `[r]` is secant for `M` iff `r ∈ 𝔪` and
`supportDim R (QuotSMulTop r M) < supportDim R M`. -/
theorem isSecant_singleton_iff {r : R} :
    IsSecant M [r] ↔
      r ∈ maximalIdeal R ∧ Module.supportDim R (QuotSMulTop r M) < Module.supportDim R M := by
  rw [isSecant_iff]
  constructor
  · rintro ⟨hm, hd⟩
    refine ⟨hm r List.mem_cons_self, ?_⟩
    have h0 := hd ⟨0, by simp⟩
    rwa [show ([r] : List R).take 1 = [r] from rfl, show ([r] : List R).take 0 = [] from rfl,
      Module.supportDim_eq_of_equiv (Submodule.quotOfListSingletonSMulTopEquiv M r),
      Module.supportDim_eq_of_equiv (Submodule.quotOfListNilSMulTopEquiv R M)] at h0
  · rintro ⟨hr, hd⟩
    refine ⟨fun x hx ↦ (List.mem_singleton.mp hx) ▸ hr, fun i ↦ ?_⟩
    obtain rfl : i = ⟨0, by simp⟩ := Fin.ext (Nat.lt_one_iff.mp i.isLt)
    change Module.supportDim R (M ⧸ Ideal.ofList [r] • (⊤ : Submodule R M)) <
      Module.supportDim R (M ⧸ Ideal.ofList ([] : List R) • (⊤ : Submodule R M))
    rwa [Module.supportDim_eq_of_equiv (Submodule.quotOfListSingletonSMulTopEquiv M r),
      Module.supportDim_eq_of_equiv (Submodule.quotOfListNilSMulTopEquiv R M)]

end Basic

end RingTheory.Sequence

namespace LinearEquiv

variable {R : Type u} [CommRing R] [IsLocalRing R]
  {M : Type v} [AddCommGroup M] [Module R M]
  {N : Type w} [AddCommGroup N] [Module R N]

/-- Linearly equivalent modules have the same secant sequences. -/
theorem isSecant_iff (e : M ≃ₗ[R] N) (rs : List R) :
    RingTheory.Sequence.IsSecant M rs ↔ RingTheory.Sequence.IsSecant N rs := by
  simp only [RingTheory.Sequence.isSecant_iff]
  refine and_congr_right fun _ ↦ forall_congr' fun i ↦ ?_
  rw [Module.supportDim_eq_of_equiv (e.quotSMulTop (Ideal.ofList (rs.take (i.val + 1)))),
    Module.supportDim_eq_of_equiv (e.quotSMulTop (Ideal.ofList (rs.take i.val)))]

end LinearEquiv

namespace RingTheory.Sequence

section Append

variable {R : Type u} [CommRing R] [IsLocalRing R]
  {M : Type v} [AddCommGroup M] [Module R M]

omit [IsLocalRing R] in
private theorem supportDim_quot_ofList_congr {as bs : List R} (h : as = bs) :
    Module.supportDim R (M ⧸ Ideal.ofList as • (⊤ : Submodule R M)) =
      Module.supportDim R (M ⧸ Ideal.ofList bs • (⊤ : Submodule R M)) := by
  subst h; rfl

/-- Every prefix of a secant sequence is secant. -/
theorem IsSecant.take {rs : List R} (h : IsSecant M rs) (k : ℕ) : IsSecant M (rs.take k) := by
  refine ⟨fun r hr ↦ h.mem_maximalIdeal (List.mem_of_mem_take hr), fun i ↦ ?_⟩
  have hlt : i.val < min k rs.length := by simpa [List.length_take] using i.isLt
  have h1 : (rs.take k).take (i.val + 1) = rs.take (i.val + 1) := by
    rw [List.take_take, Nat.min_eq_left (by omega)]
  have h0 : (rs.take k).take i.val = rs.take i.val := by
    rw [List.take_take, Nat.min_eq_left (by omega)]
  rw [supportDim_quot_ofList_congr h1, supportDim_quot_ofList_congr h0]
  exact h.supportDim_take_succ_lt ⟨i.val, lt_of_lt_of_le hlt (Nat.min_le_right _ _)⟩

/-- Concatenation criterion: `rs ++ qs` is secant for `M` iff `rs` is secant for `M` and `qs` is
secant for `M ⧸ (rs) M`. -/
theorem isSecant_append_iff (rs qs : List R) :
    IsSecant M (rs ++ qs) ↔
      IsSecant M rs ∧ IsSecant (M ⧸ Ideal.ofList rs • (⊤ : Submodule R M)) qs := by
  constructor
  · intro h
    refine ⟨by simpa [List.take_left] using h.take rs.length,
      fun q hq ↦ h.mem_maximalIdeal (List.mem_append_right rs hq), fun j ↦ ?_⟩
    have hstep := h.supportDim_take_succ_lt ⟨rs.length + j.val, by rw [List.length_append]; omega⟩
    have ht1 : (rs ++ qs).take (rs.length + j.val + 1) = rs ++ qs.take (j.val + 1) := by
      rw [List.take_append, List.take_of_length_le (by omega), Nat.add_assoc,
        Nat.add_sub_cancel_left]
    have ht0 : (rs ++ qs).take (rs.length + j.val) = rs ++ qs.take j.val := by
      rw [List.take_append, List.take_of_length_le (by omega), Nat.add_sub_cancel_left]
    rwa [supportDim_quot_ofList_congr (M := M) ht1, supportDim_quot_ofList_congr (M := M) ht0,
      Module.supportDim_eq_of_equiv (Submodule.quotOfListAppendSMulTopEquiv M rs _),
      Module.supportDim_eq_of_equiv (Submodule.quotOfListAppendSMulTopEquiv M rs _)] at hstep
  · rintro ⟨hrs, hqs⟩
    refine ⟨fun r hr ↦ (List.mem_append.mp hr).elim hrs.mem_maximalIdeal hqs.mem_maximalIdeal,
      fun i ↦ ?_⟩
    by_cases hi : i.val < rs.length
    · rw [supportDim_quot_ofList_congr (M := M) (List.take_append_of_le_length (by omega)),
        supportDim_quot_ofList_congr (M := M) (List.take_append_of_le_length (by omega))]
      exact hrs.supportDim_take_succ_lt ⟨i.val, hi⟩
    · have hj_lt : i.val < rs.length + qs.length := by simpa [List.length_append] using i.isLt
      have ht1 : (rs ++ qs).take (i.val + 1) = rs ++ qs.take (i.val - rs.length + 1) := by
        rw [List.take_append, List.take_of_length_le (by omega)]; congr 2; omega
      have ht0 : (rs ++ qs).take i.val = rs ++ qs.take (i.val - rs.length) := by
        rw [List.take_append, List.take_of_length_le (by omega)]
      rw [supportDim_quot_ofList_congr (M := M) ht1, supportDim_quot_ofList_congr (M := M) ht0,
        Module.supportDim_eq_of_equiv (Submodule.quotOfListAppendSMulTopEquiv M rs _),
        Module.supportDim_eq_of_equiv (Submodule.quotOfListAppendSMulTopEquiv M rs _)]
      exact hqs.supportDim_take_succ_lt ⟨i.val - rs.length, by omega⟩

/-- Concatenating a secant sequence on `M` with a secant sequence on `M ⧸ (rs) M` produces a secant
sequence on `M`. -/
theorem IsSecant.append {rs qs : List R} (hrs : IsSecant M rs)
    (hqs : IsSecant (M ⧸ Ideal.ofList rs • (⊤ : Submodule R M)) qs) :
    IsSecant M (rs ++ qs) :=
  (isSecant_append_iff rs qs).mpr ⟨hrs, hqs⟩

/-- Inductive characterization of secancy on `r :: rs`. -/
theorem isSecant_cons_iff (r : R) (rs : List R) :
    IsSecant M (r :: rs) ↔
      r ∈ maximalIdeal R ∧ Module.supportDim R (QuotSMulTop r M) < Module.supportDim R M ∧
        IsSecant (QuotSMulTop r M) rs := by
  change IsSecant M ([r] ++ rs) ↔ _
  rw [isSecant_append_iff, isSecant_singleton_iff,
    (Submodule.quotOfListSingletonSMulTopEquiv M r).isSecant_iff, and_assoc]

/-- The suffix `rs.drop k` of a secant sequence is secant for the quotient `M ⧸ (rs.take k) M`. -/
theorem IsSecant.drop {rs : List R} (h : IsSecant M rs) (k : ℕ) :
    IsSecant (M ⧸ Ideal.ofList (rs.take k) • (⊤ : Submodule R M)) (rs.drop k) :=
  ((isSecant_append_iff (rs.take k) (rs.drop k)).mp
    (by simpa only [List.take_append_drop] using h)).2

end Append

section Finite

variable {R : Type u} [CommRing R] [IsLocalRing R]
  {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]

/-- By Nakayama's lemma, the terminal quotient of a nonzero finite module by a secant sequence is
nontrivial. -/
theorem IsSecant.nontrivial_quotient [Nontrivial M] {rs : List R} (h : IsSecant M rs) :
    Nontrivial (M ⧸ Ideal.ofList rs • (⊤ : Submodule R M)) :=
  Submodule.Quotient.nontrivial_iff.mpr
    (Submodule.top_ne_ideal_smul_of_le_jacobson_annihilator
      (h.ofList_le_maximalIdeal.trans (maximalIdeal_le_jacobson _))).symm

/-- If `[x]` and `[y]` are each secant for a finite module `M`, then `[x * y]` is secant for `M`. -/
theorem IsSecant.mul_singleton {x y : R} (hx : IsSecant M [x]) (hy : IsSecant M [y]) :
    IsSecant M [x * y] := by
  rw [isSecant_singleton_iff] at hx hy ⊢
  refine ⟨Ideal.mul_mem_right y (maximalIdeal R) hx.1, ?_⟩
  rw [Module.supportDim_quotSMulTop_mul]
  exact sup_lt_iff.mpr ⟨hx.2, hy.2⟩

end Finite

section Noetherian

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
  {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]

private theorem supportDim_quotSMulTop_add_one_eq_of_lt [Nontrivial M] {r : R}
    (hr : r ∈ maximalIdeal R)
    (hlt : Module.supportDim R (QuotSMulTop r M) < Module.supportDim R M) :
    Module.supportDim R (QuotSMulTop r M) + 1 = Module.supportDim R M := by
  have : Nontrivial (QuotSMulTop r M) := nontrivial_quotSMulTop_of_mem_maximalIdeal M hr
  obtain ⟨k, hk⟩ := Module.exists_supportDim_eq_natCast (R := R) (M := M)
  obtain ⟨m, hm⟩ := Module.exists_supportDim_eq_natCast (R := R) (M := QuotSMulTop r M)
  have hle : Module.supportDim R M ≤ Module.supportDim R (QuotSMulTop r M) + 1 :=
    Module.supportDim_le_supportDim_quotSMulTop_succ hr
  rw [hk, hm] at hlt hle ⊢
  norm_cast at hlt hle ⊢
  omega

/-- **Secant dimension formula.** Over a Noetherian local ring, a sequence `rs` is secant for a
nonzero finite module `M` iff its entries lie in `𝔪` and
`supportDim R (M ⧸ (rs) M) + rs.length = supportDim R M`.

The hypothesis `[Nontrivial M]` is essential: for `M = 0`, both sides of the dimension equality are
`⊥` for every list `rs`, while only `[]` is secant. -/
theorem isSecant_iff_supportDim_add_length_eq [Nontrivial M] (rs : List R) :
    IsSecant M rs ↔
      (∀ r ∈ rs, r ∈ maximalIdeal R) ∧
        Module.supportDim R (M ⧸ Ideal.ofList rs • (⊤ : Submodule R M)) + rs.length =
          Module.supportDim R M := by
  induction rs generalizing M with
  | nil =>
    simp [Module.supportDim_eq_of_equiv (Submodule.quotOfListNilSMulTopEquiv R M)]
  | cons r rs ih =>
    constructor
    · intro h
      obtain ⟨hr, hlt, hrs⟩ := (isSecant_cons_iff r rs).mp h
      have : Nontrivial (QuotSMulTop r M) := nontrivial_quotSMulTop_of_mem_maximalIdeal M hr
      have hstep := supportDim_quotSMulTop_add_one_eq_of_lt hr hlt
      obtain ⟨hrs_mem, hdim⟩ := (ih (M := QuotSMulTop r M)).mp hrs
      refine ⟨fun x hx ↦ ?_, ?_⟩
      · rcases List.mem_cons.mp hx with rfl | hx'
        · exact hr
        · exact hrs_mem x hx'
      · rw [Module.supportDim_eq_of_equiv
            (Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner M r rs),
          List.length_cons, Nat.cast_add_one, ← add_assoc, hdim, hstep]
    · rintro ⟨hmem, hdim⟩
      have hr : r ∈ maximalIdeal R := hmem r List.mem_cons_self
      have hrs_mem : ∀ x ∈ rs, x ∈ maximalIdeal R :=
        fun x hx ↦ hmem x (List.mem_cons_of_mem r hx)
      have : Nontrivial (QuotSMulTop r M) := nontrivial_quotSMulTop_of_mem_maximalIdeal M hr
      rw [Module.supportDim_eq_of_equiv
          (Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner M r rs),
        List.length_cons, Nat.cast_add_one, ← add_assoc] at hdim
      obtain ⟨k, hk⟩ := Module.exists_supportDim_eq_natCast (R := R) (M := M)
      have hlt : Module.supportDim R (QuotSMulTop r M) < Module.supportDim R M :=
        (Module.supportDim_le_supportDim_quotient_add_length rs hrs_mem).trans_lt
          (hk ▸ ENat.WithBot.lt_natCast_of_add_one_eq (hdim.trans hk))
      have hstep := supportDim_quotSMulTop_add_one_eq_of_lt hr hlt
      rw [← hstep, ENat.WithBot.add_one_cancel] at hdim
      exact (isSecant_cons_iff r rs).mpr ⟨hr, hlt, (ih (M := QuotSMulTop r M)).mpr ⟨hrs_mem, hdim⟩⟩

/-- For a nonzero finite module over a Noetherian local ring, a secant sequence drops the support
dimension by its length. -/
theorem IsSecant.supportDim_add_length_eq [Nontrivial M] {rs : List R} (h : IsSecant M rs) :
    Module.supportDim R (M ⧸ Ideal.ofList rs • (⊤ : Submodule R M)) + rs.length =
      Module.supportDim R M :=
  ((isSecant_iff_supportDim_add_length_eq rs).mp h).2

/-- For `i ≤ rs.length`, the `i`-th prefix quotient of a secant sequence on a nonzero finite module
has support dimension dropping by `i`. -/
theorem IsSecant.supportDim_take_add_eq [Nontrivial M] {rs : List R} (h : IsSecant M rs)
    {i : ℕ} (hi : i ≤ rs.length) :
    Module.supportDim R (M ⧸ Ideal.ofList (rs.take i) • (⊤ : Submodule R M)) + i =
      Module.supportDim R M := by
  simpa [List.length_take_of_le hi] using (h.take i).supportDim_add_length_eq

/-- The length of a secant sequence on a nonzero finite module is at most `supportDim R M`. -/
theorem IsSecant.length_le_supportDim [Nontrivial M] {rs : List R} (h : IsSecant M rs) :
    (rs.length : WithBot ℕ∞) ≤ Module.supportDim R M := by
  have := h.nontrivial_quotient
  obtain ⟨d, hd⟩ := Module.exists_supportDim_eq_natCast
    (R := R) (M := M ⧸ Ideal.ofList rs • (⊤ : Submodule R M))
  rw [← h.supportDim_add_length_eq, hd]
  exact_mod_cast Nat.le_add_left rs.length d

/-- Secancy depends only on membership in `𝔪`, the length of the list, and the radical of the ideal
it generates. -/
theorem IsSecant.of_radical_eq_of_length_eq {rs qs : List R} (h : IsSecant M rs)
    (hlen : qs.length = rs.length) (hq : ∀ q ∈ qs, q ∈ maximalIdeal R)
    (hrad : (Ideal.ofList qs).radical = (Ideal.ofList rs).radical) : IsSecant M qs := by
  cases subsingleton_or_nontrivial M with
  | inl _ =>
    rw [List.eq_nil_of_length_eq_zero
      (hlen.trans (by simp [isSecant_iff_eq_nil_of_subsingleton.mp h]))]
    exact isSecant_nil
  | inr _ =>
    rw [isSecant_iff_supportDim_add_length_eq] at h ⊢
    exact ⟨hq, by rw [Module.supportDim_quotient_eq_of_radical_eq hrad, hlen]; exact h.2⟩

/-- Any permutation of a secant sequence is secant. -/
theorem IsSecant.perm {rs qs : List R} (h : IsSecant M rs) (hp : rs.Perm qs) : IsSecant M qs :=
  h.of_radical_eq_of_length_eq hp.length_eq.symm
    (fun _ hq ↦ h.mem_maximalIdeal (hp.mem_iff.mpr hq))
    (congrArg Ideal.radical (Ideal.ofList_perm hp.symm))

/-- Reversing a secant sequence yields a secant sequence. -/
theorem IsSecant.reverse {rs : List R} (h : IsSecant M rs) : IsSecant M rs.reverse :=
  h.perm rs.reverse_perm.symm

/-- Replacing every entry of a secant sequence by a positive power of itself preserves secancy. -/
theorem IsSecant.of_forall₂_pow {rs qs : List R} (h : IsSecant M rs)
    (hp : List.Forall₂ (fun a b ↦ ∃ k : ℕ, 0 < k ∧ b = a ^ k) rs qs) : IsSecant M qs := by
  refine h.of_radical_eq_of_length_eq hp.length_eq.symm (fun q hq ↦ ?_)
    (Ideal.radical_ofList_eq_of_forall₂_pow hp).symm
  obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hq
  have hi' : i < rs.length := hp.length_eq.symm ▸ hi
  obtain ⟨k, hk, heq⟩ := hp.get hi' hi
  rw [List.get_eq_getElem, List.get_eq_getElem] at heq
  exact heq ▸ Ideal.pow_mem_of_mem _ (h.mem_maximalIdeal (List.getElem_mem hi')) k hk

/-- Replacing a single entry of a secant sequence by a positive power preserves secancy. -/
theorem IsSecant.set_pow {rs : List R} (h : IsSecant M rs) {i : ℕ} (hi : i < rs.length)
    {k : ℕ} (hk : 0 < k) : IsSecant M (rs.set i (rs[i] ^ k)) := by
  refine h.of_radical_eq_of_length_eq List.length_set (fun q hq ↦ ?_)
    (Ideal.radical_ofList_set_pow rs hi hk)
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hq
  by_cases hji : j = i
  · subst hji; rw [List.getElem_set_self]
    exact Ideal.pow_mem_of_mem _ (h.mem_maximalIdeal (List.getElem_mem hi)) k hk
  · rw [List.getElem_set_ne (Ne.symm hji)]
    exact h.mem_maximalIdeal (List.getElem_mem (by simpa using hj))

/-- Every sublist of a secant sequence is secant. -/
theorem IsSecant.sublist {rs qs : List R} (h : IsSecant M rs) (hsub : qs.Sublist rs) :
    IsSecant M qs := by
  obtain ⟨us, hus⟩ := hsub.exists_perm_append
  exact ((isSecant_append_iff qs us).mp (h.perm hus)).1

/-- **Truncated-product property.** If `r₁, …, rₛ` is secant for `M` and `i ≤ j < s`, then the
truncated list `r₁, …, rᵢ₋₁, rᵢ rⱼ` is secant for `M`. -/
theorem IsSecant.take_append_mul {rs : List R} (h : IsSecant M rs) {i j : ℕ} (hij : i ≤ j)
    (hj : j < rs.length) :
    IsSecant M (rs.take i ++ [rs[i]'(hij.trans_lt hj) * rs[j]'hj]) := by
  have hi : i < rs.length := hij.trans_lt hj
  have hmem_i : rs[i] ∈ rs.drop i :=
    List.mem_iff_getElem.mpr ⟨0, by rw [List.length_drop]; omega, by simp⟩
  have hmem_j : rs[j] ∈ rs.drop i :=
    List.mem_iff_getElem.mpr ⟨j - i, by rw [List.length_drop]; omega, by
      simp [Nat.add_sub_cancel' hij]⟩
  exact (h.take i).append <| ((h.drop i).sublist (List.singleton_sublist.mpr hmem_i)).mul_singleton
    ((h.drop i).sublist (List.singleton_sublist.mpr hmem_j))

/-- Every `M`-regular sequence on a finite module over a Noetherian local ring is secant. -/
theorem IsRegular.isSecant {rs : List R} (reg : IsRegular M rs) : IsSecant M rs := by
  have : Nontrivial M := reg.nontrivial
  exact (isSecant_iff_supportDim_add_length_eq rs).mpr
    ⟨fun _ hr ↦ reg.mem_maximalIdeal hr,
      Module.supportDim_add_length_eq_supportDim_of_isRegular rs reg⟩

omit [Module.Finite R M] in
private theorem exists_mem_maximalIdeal_notMem_minimalPrimes
    (hpos : 0 < Module.supportDim R M) :
    ∃ x ∈ maximalIdeal R, ∀ p ∈ (Module.annihilator R M).minimalPrimes, x ∉ p := by
  by_contra h; push Not at h
  have hsub : (maximalIdeal R : Set R) ⊆
      ⋃ p ∈ (Module.annihilator R M).minimalPrimes, (p : Set R) := fun x hx ↦
    let ⟨p, hp, hxp⟩ := h x hx; Set.mem_biUnion hp hxp
  have hfin := Ideal.finite_minimalPrimes_of_isNoetherianRing R (Module.annihilator R M)
  obtain ⟨p, hp, hle⟩ := (Ideal.subset_union_prime_finite hfin (f := id) ⊥ ⊥
    (fun _ hq _ _ ↦ hq.1.1)).mp hsub
  have hp_eq : p = maximalIdeal R := le_antisymm (le_maximalIdeal hp.1.1.ne_top) hle
  have key : ∀ q ∈ Module.support R M, q.asIdeal = maximalIdeal R := fun q hq ↦
    le_antisymm (le_maximalIdeal q.isPrime.ne_top) (hp_eq ▸
      hp.2 ⟨q.isPrime, Module.annihilator_le_of_mem_support hq⟩
        (hp_eq ▸ le_maximalIdeal q.isPrime.ne_top))
  have : Subsingleton (Module.support R M) :=
    ⟨fun q₁ q₂ ↦ Subtype.ext (PrimeSpectrum.ext ((key q₁.1 q₁.2).trans (key q₂.1 q₂.2).symm))⟩
  exact hpos.not_ge Order.krullDim_nonpos_of_subsingleton

private theorem exists_isSecant_supportDim_eq_zero_of_eq :
    ∀ (d : ℕ) (M : Type v) [AddCommGroup M] [Module R M] [Module.Finite R M] [Nontrivial M],
      Module.supportDim R M = d →
      ∃ qs : List R, IsSecant M qs ∧
        Module.supportDim R (M ⧸ Ideal.ofList qs • (⊤ : Submodule R M)) = 0
  | 0, M, _, _, _, _, hd => ⟨[], isSecant_nil, by
      rw [Module.supportDim_eq_of_equiv (Submodule.quotOfListNilSMulTopEquiv R M), hd]; rfl⟩
  | d + 1, M, _, _, _, _, hd => by
    obtain ⟨x, hx, hmin⟩ := exists_mem_maximalIdeal_notMem_minimalPrimes (M := M)
      (by rw [hd]; exact_mod_cast Nat.succ_pos d)
    have hdrop :=
      Module.supportDim_quotSMulTop_succ_eq_of_notMem_minimalPrimes_of_mem_maximalIdeal hmin hx
    have hdim_q : Module.supportDim R (QuotSMulTop x M) = d :=
      ENat.WithBot.add_one_cancel.mp (by rwa [hd, Nat.cast_add_one] at hdrop)
    have : Nontrivial (QuotSMulTop x M) := nontrivial_quotSMulTop_of_mem_maximalIdeal M hx
    obtain ⟨qs, hqs, hqdim⟩ := exists_isSecant_supportDim_eq_zero_of_eq d (QuotSMulTop x M) hdim_q
    refine ⟨x :: qs, (isSecant_cons_iff x qs).mpr
      ⟨hx, by rw [hdim_q, hd]; exact_mod_cast Nat.lt_succ_self d, hqs⟩, ?_⟩
    rwa [Module.supportDim_eq_of_equiv
      (Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner M x qs)]

/-- **Existence of a secant system of parameters.** Every nonzero finite module over a Noetherian
local ring admits a secant sequence whose terminal quotient has support dimension zero.
Stacks, Proposition 10.60.9 (00KQ). -/
@[stacks 00KQ]
theorem exists_isSecant_supportDim_eq_zero [Nontrivial M] :
    ∃ qs : List R, IsSecant M qs ∧
      Module.supportDim R (M ⧸ Ideal.ofList qs • (⊤ : Submodule R M)) = 0 := by
  obtain ⟨d, hd⟩ := Module.exists_supportDim_eq_natCast (R := R) (M := M)
  exact exists_isSecant_supportDim_eq_zero_of_eq d M hd

/-- **Secant parameter-completion theorem.** Over a Noetherian local ring, every secant sequence on
a nonzero finite module extends to a secant sequence whose terminal quotient has support dimension
zero. Stacks, Proposition 10.60.9 (00KQ). -/
@[stacks 00KQ]
theorem IsSecant.exists_append_supportDim_eq_zero [Nontrivial M] {rs : List R} (h : IsSecant M rs) :
    ∃ qs : List R, IsSecant M (rs ++ qs) ∧
      Module.supportDim R (M ⧸ Ideal.ofList (rs ++ qs) • (⊤ : Submodule R M)) = 0 := by
  have : Nontrivial (M ⧸ Ideal.ofList rs • (⊤ : Submodule R M)) := h.nontrivial_quotient
  obtain ⟨qs, hqs, hdim⟩ :=
    exists_isSecant_supportDim_eq_zero (R := R) (M := M ⧸ Ideal.ofList rs • (⊤ : Submodule R M))
  refine ⟨qs, h.append hqs, ?_⟩
  rwa [Module.supportDim_eq_of_equiv (Submodule.quotOfListAppendSMulTopEquiv M rs qs)]

end Noetherian

