/-!
# Splitting finite étale algebras

A finite étale algebra `A` over a field `K` becomes a product of copies of the ground field
after a finite Galois extension `L / K` whose degree divides `(finrank K A)!`. Thus all the
points of a finite étale scheme can be labelled over one finite separable extension, even when
the ground field is imperfect, and the degree of that extension is bounded in terms of the
number of geometric points alone.

Over a separably closed field `Ω`, the algebra `A` has exactly `finrank K A` points
(`TauCeti.Algebra.Etale.card_algHom_eq_finrank`). For `Ω` a separable closure, the splitting
field is the subfield generated by the values of all these points. It is stable under
`Gal(Ω / K)`, hence Galois over `K`, and its Galois group acts faithfully on the
`finrank K A` points of `A` with values in it, so its degree divides `(finrank K A)!`.

Over an arbitrary commutative ring `R`, a finite étale `R`-algebra `S` becomes a finite product
of copies of the base after an étale base change whose spectrum meets any given prime of `R`
(`Algebra.IsFiniteSplit.exists_liesOver_tensorProduct_of_etale`). The rank of `S` is locally
constant, so it is constant on a principal open `D(f)` around the prime, and over `R_f` Mathlib's
`Algebra.IsFiniteSplit.exists_tensorProduct_of_etale` supplies a finite, faithfully flat,
étale splitting algebra; faithful flatness provides a prime above the given one.

## References

* The Stacks Project, Tag 03QR (finite étale schemes over a field).
* The Stacks Project, Tag 04HN (finite étale morphisms split étale locally).
* H. W. Lenstra, *Galois theory for schemes*, Section 5.
-/

public section

open scoped TensorProduct

universe u v

namespace TauCeti.Algebra.Etale

variable (K : Type u) (A : Type v) [Field K] [CommRing A] [Algebra K A] [Algebra.Etale K A]

/-- **An étale algebra has as many separably closed points as its dimension.** A finite étale
algebra `A` over a field `K` has exactly `finrank K A` points with values in any separably
closed extension of `K`. -/
theorem card_algHom_eq_finrank (Ω : Type*) [Field Ω] [Algebra K Ω] [IsSepClosed Ω] :
    Nat.card (A →ₐ[K] Ω) = Module.finrank K A := by
  have : Module.Finite K A := Algebra.FormallyUnramified.finite_of_free K A
  rw [Nat.card_congr (AlgHom.liftEquiv K Ω A Ω), Algebra.IsFiniteSplit.card_algHom_eq_finrank,
    Module.finrank_baseChange]

/-- **A finite étale algebra over a field splits after a Galois extension of degree dividing
`(finrank K A)!`.** The extension is finite and Galois over `K`, and it lives in the universe
of `K`. -/
theorem exists_isFiniteSplit_tensorProduct :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L) (_ : Module.Finite K L) (_ : IsGalois K L),
      Module.finrank K L ∣ (Module.finrank K A).factorial ∧
        Algebra.IsFiniteSplit L (L ⊗[K] A) := by
  have : Module.Finite K A := Algebra.FormallyUnramified.finite_of_free K A
  let Ω := SeparableClosure K
  let b := Module.finBasis K A
  -- `L` is generated by the values of all `Ω`-points of `A` on a basis of `A`.
  let S : Set Ω := ⋃ φ : A →ₐ[K] Ω, Set.range (φ ∘ b)
  have : Finite S := Set.finite_iUnion (fun φ : A →ₐ[K] Ω ↦ Set.finite_range (φ ∘ b))
  let L := IntermediateField.adjoin K S
  have hmem (φ : A →ₐ[K] Ω) (a : A) : φ a ∈ L := by
    rw [← b.sum_repr a, map_sum]
    refine sum_mem fun i _ ↦ ?_
    rw [map_smul]
    exact L.smul_mem (IntermediateField.subset_adjoin K S (Set.mem_iUnion.2 ⟨φ, i, rfl⟩))
  have : FiniteDimensional K L := IntermediateField.finiteDimensional_adjoin
    fun x _ ↦ (Algebra.IsSeparable.isSeparable K x).isIntegral
  have : Normal K L := IntermediateField.normal_iff_forall_map_le.2 fun σ ↦ by
    rw [IntermediateField.adjoin_map, IntermediateField.adjoin_le_iff]
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨φ, i, rfl⟩ := Set.mem_iUnion.1 hx
    exact hmem (σ.comp φ) (b i)
  have : IsGalois K L := { }
  -- Every `Ω`-point of `A` takes values in `L`.
  let e : (A →ₐ[K] L) ≃ (A →ₐ[K] Ω) := Equiv.ofBijective (fun φ ↦ L.val.comp φ)
    ⟨fun φ ψ h ↦ AlgHom.ext fun a ↦ Subtype.ext congr($h a),
      fun φ ↦ ⟨φ.codRestrict L.toSubalgebra (hmem φ), rfl⟩⟩
  have hcard : Nat.card (A →ₐ[K] L) = Module.finrank K A :=
    (Nat.card_congr e).trans (card_algHom_eq_finrank K A Ω)
  refine ⟨L, inferInstance, inferInstance, inferInstance, inferInstance, ?_, ?_⟩
  · -- `Gal(L / K)` acts faithfully on the `L`-points of `A`.
    rw [← IsGalois.card_aut_eq_finrank, ← hcard, ← Nat.card_perm]
    refine Subgroup.card_dvd_of_injective (MulAction.toPermHom _ _) ?_
    rw [injective_iff_map_eq_one]
    intro σ hσ
    refine AlgEquiv.coe_toAlgHom_injective
      (IntermediateField.algHom_ext_of_eq_adjoin K (S := L) rfl fun x hx ↦ ?_)
    obtain ⟨φ, i, rfl⟩ := Set.mem_iUnion.1 hx
    have hφ : (⟨φ (b i), hmem φ (b i)⟩ : L) = e.symm φ (b i) :=
      Subtype.ext congr($((e.apply_symm_apply φ).symm) (b i))
    simp only [Function.comp_apply, hφ, AlgEquiv.coe_toAlgHom, AlgEquiv.one_apply]
    exact AlgEquiv.apply_of_smul_eq (Equiv.ext_iff.1 hσ (e.symm φ)) (b i)
  · refine .of_finrank_le_card_algHom ?_
    rw [← Nat.card_congr (AlgHom.liftEquiv K L A L), hcard, Module.finrank_baseChange]

end TauCeti.Algebra.Etale

/-- **A finite étale algebra splits étale locally.** If `S` is a finite étale `R`-algebra and
`p` is a prime of `R`, there is an étale `R`-algebra `T` with a prime `P` lying over `p` such that
`T ⊗[R] S` is isomorphic over `T` to a finite product of copies of `T`. This is the affine form of
Stacks, Lemma 41.18.3; unlike the constant-rank
`Algebra.IsFiniteSplit.exists_tensorProduct_of_etale`, the rank of `S` may vary on `Spec R`. -/
@[stacks 04HN "affine form"]
theorem Algebra.IsFiniteSplit.exists_liesOver_tensorProduct_of_etale {R : Type u} (S : Type u)
    [CommRing R] [CommRing S] [Algebra R S] [Algebra.Etale R S] [Module.Finite R S] (p : Ideal R)
    [p.IsPrime] :
    ∃ (T : Type u) (_ : CommRing T) (_ : Algebra R T) (_ : Algebra.Etale R T) (P : Ideal T)
      (_ : P.IsPrime), P.LiesOver p ∧ IsFiniteSplit T (T ⊗[R] S) := by
  have := Module.FinitePresentation.of_finite_of_finitePresentation R S
  -- The rank of `S` is locally constant, so it is constant on a principal open around `p`.
  let x : PrimeSpectrum R := ⟨p, inferInstance⟩
  obtain ⟨_, ⟨f, rfl⟩, hxf, hf⟩ :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open (a := x) rfl
      ((Module.isLocallyConstant_rankAtStalk (R := R) (M := S)).isOpen_fiber
        (Module.rankAtStalk S x))
  beta_reduce at hxf hf
  let Rf := Localization.Away f
  have hrank : Module.rankAtStalk (R := Rf) (Rf ⊗[R] S) = (Module.rankAtStalk S x : _) := by
    ext y
    rw [Module.rankAtStalk_baseChange]
    refine hf ?_
    rw [← PrimeSpectrum.localization_away_comap_range Rf f]
    exact ⟨y, rfl⟩
  obtain ⟨T, _, _, _, _, _, hT⟩ := IsFiniteSplit.exists_tensorProduct_of_etale hrank
  algebraize [(algebraMap Rf T).comp (algebraMap R Rf)]
  obtain ⟨y, hy⟩ : x ∈ Set.range (PrimeSpectrum.comap (algebraMap R Rf)) := by
    rw [PrimeSpectrum.localization_away_comap_range Rf f]
    exact hxf
  obtain ⟨z, rfl⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (B := T) y
  refine ⟨T, inferInstance, inferInstance, Algebra.Etale.comp R Rf T, z.asIdeal, inferInstance,
    ⟨?_⟩, .of_algEquiv (Algebra.TensorProduct.cancelBaseChange R Rf T T S)⟩
  rw [← Ideal.under_under (B := Rf)]
  exact congrArg PrimeSpectrum.asIdeal hy.symm
