module

public import TauCeti.RingTheory.MvPolynomial.Jacobian.Basic
public import TauCeti.RingTheory.Smooth.Jacobian
public import Mathlib.RingTheory.Smooth.StandardSmoothCotangent

/-!
# The Jacobian-open algebra of a square polynomial system

For a square system of polynomials `p : σ → MvPolynomial σ R`, with as many equations as
variables, `TauCeti.JacobianOpenAlgebra p` is the quotient `R[X] ⧸ (p i)` localized away from the
class of the Jacobian determinant `TauCeti.jacobian p`. Geometrically it is the open subscheme of
the zero locus of `p` on which the Jacobian does not vanish.

It is étale over `R` for every system, by Mathlib's submersive presentations: the naive
presentation of `R[X] ⧸ (p i)` has Jacobian the class of `jacobian p`, so it becomes submersive of
relative dimension zero once that class is inverted. No finiteness over `R` follows in general;
over a field, an étale algebra is a finite product of finite separable field extensions
(`Algebra.Etale.iff_exists_algEquiv_prod`).

Its `R`-algebra maps to an `R`-algebra `A` are its `A`-points: tuples `x : σ → A` at which every
equation vanishes and the Jacobian determinant is a unit (`TauCeti.JacobianOpenAlgebra.homEquiv`).
The map attached to `x` is `TauCeti.JacobianOpenAlgebra.lift`, which sends the class of a
polynomial `f` to `f(x)`; it is surjective as soon as polynomial evaluation at `x` is. For a field
`A` the unit condition says that the Jacobian determinant does not vanish at `x`.

A number field `K` generated over `ℚ` by a point `x` of a square system with nonzero Jacobian at
`x` is thereby a quotient of the Jacobian-open algebra of the system. Since `K` is étale over `ℚ`,
the kernel of that quotient map is generated by an idempotent
(`TauCeti.Algebra.Etale.exists_isIdempotentElem_ker_eq_span`), so `K` is an open and closed field
factor of a finite étale `ℚ`-algebra. This is how compact models of number fields are exhibited in
Couveignes' count of number fields.

## Main declarations

* `TauCeti.JacobianOpenAlgebra p`: the localization of `R[X] ⧸ (p i)` away from the class of
  `jacobian p`.
* `TauCeti.JacobianOpenAlgebra.ofMvPolynomial`: the canonical map from `R[X]`.
* `TauCeti.JacobianOpenAlgebra.etale`: the Jacobian-open algebra is étale over `R`.
* `TauCeti.JacobianOpenAlgebra.lift`: the algebra map attached to a point where the equations
  vanish and the Jacobian is a unit, with `lift_ofMvPolynomial` and `lift_surjective`.
* `TauCeti.JacobianOpenAlgebra.homEquiv`: algebra maps out of the Jacobian-open algebra are
  exactly such points.

## References

* J.-M. Couveignes, *Enumerating number fields*, Ann. of Math. 192 (2020), 487–497,
  Proposition 2, for the Jacobian-open model of a number field.
* Stacks Project, Tag 00T7, for standard smooth algebras, here of relative dimension zero.
-/

public section

namespace TauCeti

open MvPolynomial

variable {R σ : Type*} [CommRing R] [Fintype σ] [DecidableEq σ]

/-- The Jacobian-open algebra of a square system `p : σ → MvPolynomial σ R`: the quotient
`R[X] ⧸ (p i)` localized away from the class of the Jacobian determinant `jacobian p`. Its
`R`-algebra maps to `A` are the points of `A` at which every `p i` vanishes and the Jacobian
determinant is a unit. -/
abbrev JacobianOpenAlgebra (p : σ → MvPolynomial σ R) : Type _ :=
  Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range p)) (jacobian p))

namespace JacobianOpenAlgebra

variable (p : σ → MvPolynomial σ R)

/-- The naive presentation of `R[X] ⧸ (p i)`, with each equation matched to the variable of the
same index. -/
private noncomputable def presentation :
    Algebra.PreSubmersivePresentation R (MvPolynomial σ R ⧸ Ideal.span (Set.range p)) σ σ :=
  .naive id Function.injective_id

/-- The Jacobian of the naive presentation is the class of the Jacobian determinant: its Jacobian
matrix is the transpose of the matrix of partial derivatives. -/
private theorem presentation_jacobian :
    (presentation p).jacobian = Ideal.Quotient.mk _ (jacobian p) := by
  rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, jacobian_eq_det,
    ← Matrix.det_transpose]
  congr 2 with i j
  simp [presentation]

/-- The Jacobian-open algebra is standard smooth of relative dimension zero over `R`. -/
instance isStandardSmoothOfRelativeDimension :
    Algebra.IsStandardSmoothOfRelativeDimension 0 R (JacobianOpenAlgebra p) := by
  have : IsLocalization.Away (presentation p).jacobian (JacobianOpenAlgebra p) := by
    rw [presentation_jacobian]
    infer_instance
  simpa [Algebra.Presentation.dimension] using
    (presentation p).isStandardSmoothOfRelativeDimension_localizationAway (JacobianOpenAlgebra p)

/-- The Jacobian-open algebra of every square system is étale over the base ring. -/
instance etale : Algebra.Etale R (JacobianOpenAlgebra p) :=
  inferInstance

/-- The canonical map from polynomials to the Jacobian-open algebra: the quotient map followed by
the localization map. -/
noncomputable def ofMvPolynomial : MvPolynomial σ R →ₐ[R] JacobianOpenAlgebra p :=
  (IsScalarTower.toAlgHom R (MvPolynomial σ R ⧸ Ideal.span (Set.range p))
    (JacobianOpenAlgebra p)).comp (Ideal.Quotient.mkₐ R _)

theorem ofMvPolynomial_apply (f : MvPolynomial σ R) :
    ofMvPolynomial p f =
      algebraMap _ (JacobianOpenAlgebra p) (Ideal.Quotient.mk (Ideal.span (Set.range p)) f) :=
  (rfl)

/-- Every equation of the system vanishes in its Jacobian-open algebra. -/
@[simp]
theorem ofMvPolynomial_apply_self (i : σ) : ofMvPolynomial p (p i) = 0 := by
  rw [ofMvPolynomial_apply, Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.subset_span (Set.mem_range_self i)), map_zero]

/-- The Jacobian determinant is a unit in the Jacobian-open algebra. -/
theorem isUnit_ofMvPolynomial_jacobian : IsUnit (ofMvPolynomial p (jacobian p)) := by
  rw [ofMvPolynomial_apply]
  exact IsLocalization.Away.algebraMap_isUnit _

variable {p} {A : Type*} [CommRing A] [Algebra R A]

/-- Two algebra maps out of the Jacobian-open algebra agree if they agree on polynomials. -/
@[ext]
theorem algHom_ext {φ ψ : JacobianOpenAlgebra p →ₐ[R] A}
    (h : φ.comp (ofMvPolynomial p) = ψ.comp (ofMvPolynomial p)) : φ = ψ := by
  refine IsLocalization.algHom_ext
    (Submonoid.powers (Ideal.Quotient.mk (Ideal.span (Set.range p)) (jacobian p)))
    (Ideal.Quotient.algHom_ext R (AlgHom.ext fun f ↦ ?_))
  exact AlgHom.congr_fun h f

omit [Fintype σ] [DecidableEq σ] in
/-- Evaluation at a point where every equation vanishes kills the ideal of the equations. -/
private theorem aeval_eq_zero_of_mem_span {x : σ → A} (hx : ∀ i, aeval x (p i) = 0)
    (f : MvPolynomial σ R) (hf : f ∈ Ideal.span (Set.range p)) : aeval x f = 0 :=
  RingHom.mem_ker.mp <|
    Ideal.span_le.mpr (Set.range_subset_iff.mpr fun i ↦ RingHom.mem_ker.mpr (hx i)) hf

/-- Evaluation at a point where every equation vanishes, on the quotient by the equations. -/
private noncomputable def quotientLift (x : σ → A) (hx : ∀ i, aeval x (p i) = 0) :
    MvPolynomial σ R ⧸ Ideal.span (Set.range p) →ₐ[R] A :=
  Ideal.Quotient.liftₐ _ (aeval x) (aeval_eq_zero_of_mem_span hx)

omit [Fintype σ] [DecidableEq σ] in
/-- Evaluation on the quotient sends the class of `f` to `f(x)`. -/
private theorem quotientLift_mk (x : σ → A) (hx : ∀ i, aeval x (p i) = 0)
    (f : MvPolynomial σ R) :
    quotientLift x hx (Ideal.Quotient.mk (Ideal.span (Set.range p)) f) = aeval x f :=
  (rfl)

/-- The algebra map out of the Jacobian-open algebra attached to a point `x` at which every
equation vanishes and the Jacobian determinant is a unit. It sends the class of a polynomial `f`
to `f(x)`. -/
noncomputable def lift (x : σ → A) (hx : ∀ i, aeval x (p i) = 0)
    (hJ : IsUnit (aeval x (jacobian p))) : JacobianOpenAlgebra p →ₐ[R] A :=
  IsLocalization.Away.liftAlgHom (A := R)
    (Ideal.Quotient.mk (Ideal.span (Set.range p)) (jacobian p)) (f := quotientLift x hx)
    (by rwa [quotientLift_mk])

variable (x : σ → A) (hx : ∀ i, aeval x (p i) = 0) (hJ : IsUnit (aeval x (jacobian p)))

@[simp]
theorem lift_ofMvPolynomial (f : MvPolynomial σ R) :
    lift x hx hJ (ofMvPolynomial p f) = aeval x f := by
  rw [lift, ofMvPolynomial_apply, IsLocalization.Away.coe_liftAlgHom,
    IsLocalization.Away.lift_eq]
  exact quotientLift_mk x hx f

@[simp]
theorem lift_comp_ofMvPolynomial : (lift x hx hJ).comp (ofMvPolynomial p) = aeval x :=
  AlgHom.ext (lift_ofMvPolynomial x hx hJ)

/-- The attached map sends the inverse of the Jacobian determinant to the inverse of its value
at the point. -/
theorem lift_invSelf :
    lift x hx hJ
        (IsLocalization.Away.invSelf (Ideal.Quotient.mk (Ideal.span (Set.range p)) (jacobian p))) =
      ↑hJ.unit⁻¹ := by
  rw [← hJ.mul_right_inj, IsUnit.mul_val_inv, ← lift_ofMvPolynomial x hx hJ, ← map_mul,
    ofMvPolynomial_apply, IsLocalization.Away.mul_invSelf, map_one]

/-- The attached map is the only algebra map that agrees with evaluation at the point on
polynomials. -/
theorem eq_lift_iff (φ : JacobianOpenAlgebra p →ₐ[R] A) :
    φ = lift x hx hJ ↔ φ.comp (ofMvPolynomial p) = aeval x := by
  refine ⟨fun h ↦ h ▸ lift_comp_ofMvPolynomial x hx hJ, fun h ↦ algHom_ext ?_⟩
  rw [h, lift_comp_ofMvPolynomial]

/-- The attached map is surjective whenever evaluation of polynomials at the point is. -/
theorem lift_surjective (h : Function.Surjective (aeval x : MvPolynomial σ R →ₐ[R] A)) :
    Function.Surjective (lift x hx hJ) := fun a ↦ by
  obtain ⟨f, rfl⟩ := h a
  exact ⟨ofMvPolynomial p f, lift_ofMvPolynomial x hx hJ f⟩

variable (p A)

/-- The algebra maps from the Jacobian-open algebra to `A` are exactly the points of `A` at which
every equation vanishes and the Jacobian determinant is a unit. -/
noncomputable def homEquiv :
    (JacobianOpenAlgebra p →ₐ[R] A) ≃
      {x : σ → A // (∀ i, aeval x (p i) = 0) ∧ IsUnit (aeval x (jacobian p))} where
  toFun φ := ⟨fun i ↦ φ (ofMvPolynomial p (X i)), by
    have hφ : aeval (fun i ↦ φ (ofMvPolynomial p (X i))) = φ.comp (ofMvPolynomial p) :=
      (aeval_unique (φ.comp (ofMvPolynomial p))).symm
    refine ⟨fun i ↦ ?_, ?_⟩
    · rw [hφ, AlgHom.comp_apply, ofMvPolynomial_apply_self, map_zero]
    · rw [hφ, AlgHom.comp_apply]
      exact (isUnit_ofMvPolynomial_jacobian p).map φ⟩
  invFun x := lift x.val x.property.1 x.property.2
  left_inv φ := by
    refine ((eq_lift_iff _ _ _ φ).mpr ?_).symm
    exact aeval_unique (φ.comp (ofMvPolynomial p))
  right_inv x := by
    ext i
    simp

@[simp]
theorem homEquiv_apply_coe (φ : JacobianOpenAlgebra p →ₐ[R] A) (i : σ) :
    (homEquiv p A φ : σ → A) i = φ (ofMvPolynomial p (X i)) := (rfl)

@[simp]
theorem homEquiv_symm_apply
    (x : {x : σ → A // (∀ i, aeval x (p i) = 0) ∧ IsUnit (aeval x (jacobian p))}) :
    (homEquiv p A).symm x = lift x.val x.property.1 x.property.2 := (rfl)

end JacobianOpenAlgebra

end TauCeti
