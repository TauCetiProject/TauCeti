module

public import Mathlib.RingTheory.Etale.QuasiFinite

/-!
# Residue fields of a base change with trivial residue field extension

Let `R → R'` be a ring map and `P` a prime of `R'` over a prime `p` of `R` with `κ(p) = κ(P)`.
Mathlib's `Ideal.fiberIsoOfBijectiveResidueField` identifies the primes of `R' ⊗[R] S` over `P`
with the primes of `S` over `p`. This file adds that the identification does not change residue
fields: for a prime `Q` of `R' ⊗[R] S` over `P`, the map `κ(Q ∩ S) → κ(Q)` is bijective
(`Ideal.ResidueField.bijective_map_includeRight`).

This is how an étale neighbourhood `(R', P)` of `p` with trivial residue field extension, as
produced by Mathlib's `Algebra.exists_etale_isIdempotentElem_forall_liesOver_eq` (Stacks 00UJ),
also preserves the residue field at the point of `S` it isolates.
-/

public section

open TensorProduct

variable {R R' S : Type*} [CommRing R] [CommRing R'] [CommRing S] [Algebra R R'] [Algebra R S]

/-- If `P` is a prime of `R'` over `p` with `κ(p) = κ(P)`, and `Q` is a prime of `R' ⊗[R] S` over
`P` with contraction `q` to `S`, then `κ(q) → κ(Q)` is bijective. -/
theorem Ideal.ResidueField.bijective_map_includeRight (p : Ideal R) [p.IsPrime] (P : Ideal R')
    [P.IsPrime] [P.LiesOver p] (q : Ideal S) [q.IsPrime] (Q : Ideal (R' ⊗[R] S)) [Q.IsPrime]
    [Q.LiesOver P] (hQ : q = Q.comap Algebra.TensorProduct.includeRight.toRingHom)
    (H : Function.Bijective (Ideal.ResidueField.mapₐ p P (Algebra.ofId R R') (P.over_def p))) :
    Function.Bijective
      (Ideal.ResidueField.map q Q Algebra.TensorProduct.includeRight.toRingHom hQ) := by
  refine ⟨RingHom.injective _, ?_⟩
  set φ := Ideal.ResidueField.map q Q Algebra.TensorProduct.includeRight.toRingHom hQ
  have hq : q.LiesOver p := by
    constructor
    rw [hQ, Ideal.under, Ideal.comap_comap, P.over_def p, Q.over_def P, Ideal.under,
      Ideal.under, Ideal.comap_comap]
    congr 1
    ext r
    simp [Algebra.TensorProduct.algebraMap_apply]
  -- `κ(Q)` is generated by the images of `R'`, which lie in `κ(P) = κ(p)`, and of `S`; both lie
  -- in the image of `κ(q)`.
  have hR' (r : R') :
      algebraMap (R' ⊗[R] S) Q.ResidueField (algebraMap R' _ r) ∈ φ.fieldRange := by
    obtain ⟨c, hc⟩ := H.2 (algebraMap R' P.ResidueField r)
    have hcomp : (Ideal.ResidueField.map P Q (algebraMap R' (R' ⊗[R] S)) (Q.over_def P)).comp
        (Ideal.ResidueField.mapₐ p P (Algebra.ofId R R') (P.over_def p)).toRingHom =
        φ.comp (Ideal.ResidueField.map p q (algebraMap R S) (q.over_def p)) := by
      refine Ideal.ResidueField.ringHom_ext (RingHom.ext fun r₀ ↦ ?_)
      simp only [φ, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        Ideal.ResidueField.map_algebraMap, AlgHom.commutes]
      rw [IsScalarTower.algebraMap_apply R R' P.ResidueField, Ideal.ResidueField.map_algebraMap,
        ← IsScalarTower.algebraMap_apply R R' (R' ⊗[R] S)]
    refine ⟨Ideal.ResidueField.map p q (algebraMap R S) (q.over_def p) c, ?_⟩
    rw [← RingHom.comp_apply, ← hcomp, RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe, hc, Ideal.ResidueField.map_algebraMap]
  have hS (s : S) : algebraMap (R' ⊗[R] S) Q.ResidueField (1 ⊗ₜ s) ∈ φ.fieldRange :=
    ⟨algebraMap S q.ResidueField s, Ideal.ResidueField.map_algebraMap _ _ _ _ s⟩
  -- Hence so is the image of `R' ⊗[R] S`, which generates `κ(Q)` as a field.
  have key (t : R' ⊗[R] S) : algebraMap (R' ⊗[R] S) Q.ResidueField t ∈ φ.fieldRange := by
    induction t using TensorProduct.inductionOn with
    | tmul r s =>
      rw [← mul_one r, ← smul_eq_mul, ← TensorProduct.smul_tmul', Algebra.smul_def, map_mul]
      exact mul_mem (hR' r) (hS s)
    | add a b ha hb => rw [map_add]; exact add_mem ha hb
  intro y
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := (R' ⊗[R] S) ⧸ Q) y
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
  simp only [Ideal.algebraMap_quotient_residueField_mk]
  exact div_mem (key a) (key b)
