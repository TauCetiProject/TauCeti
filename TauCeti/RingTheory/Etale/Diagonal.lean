module

public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.Ideal.IdempotentFG
public import Mathlib.RingTheory.TensorProduct.Maps

/-!
# The diagonal of an étale algebra

For an étale algebra `S` over `R`, the kernel of the multiplication map
`S ⊗[R] S → S` is generated by an idempotent. This is the affine algebraic form of the
fact that the diagonal of an étale morphism is both open and closed.

## References

* [Stacks Project, Tag 02FL](https://stacks.math.columbia.edu/tag/02FL)
-/

public section

open scoped TensorProduct

universe u v

namespace Algebra.Etale

variable (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]

/-- The kernel of multiplication on the self-tensor product of an étale algebra is generated by
an idempotent. -/
theorem exists_isIdempotentElem_ker_lmul_eq_span [Algebra.Etale R S] :
    ∃ e : S ⊗[R] S, IsIdempotentElem e ∧
      RingHom.ker (Algebra.TensorProduct.lmul' R : S ⊗[R] S →ₐ[R] S).toRingHom =
        Ideal.span {e} := by
  let μ : S ⊗[R] S →ₐ[R] S := Algebra.TensorProduct.lmul' R
  have hμ : Function.Surjective μ := fun s ↦ ⟨s ⊗ₜ[R] 1, by simp [μ]⟩
  have : Algebra.Etale R (S ⊗[R] S) := Algebra.Etale.comp R S (S ⊗[R] S)
  let := μ.toAlgebra
  have : IsScalarTower R (S ⊗[R] S) S :=
    IsScalarTower.of_algebraMap_eq' μ.comp_algebraMap.symm
  obtain ⟨e, he, hker⟩ :=
    (Ideal.isIdempotentElem_iff_of_fg _
      (Algebra.FinitePresentation.ker_fG_of_surjective μ hμ)).mp
      ((Algebra.FormallyEtale.iff_of_surjective hμ).mp
        (Algebra.FormallyEtale.of_restrictScalars (R := R)))
  exact ⟨e, he, hker⟩

end Algebra.Etale
