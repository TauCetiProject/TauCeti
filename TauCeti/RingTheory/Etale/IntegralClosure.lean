/-!
# Integral closure in a quotient of the generic fibre of a finite étale algebra

Let `R` be a ring that is integrally closed in a field `K`, and let `S` be a finite étale
`R`-algebra. Its generic fibre `K ⊗[R] S` is a reduced finite `K`-algebra, hence a semisimple ring
(`TauCeti.Algebra.FormallyUnramified.isSemisimpleRing_field_tensorProduct`), so each of its ideals
is generated by an idempotent. For each ring `L` onto which `K ⊗[R] S` maps, for instance each of
its field factors, the integral closure of `R` in `L` is the image of `S`, and it is étale over
`R`, being the quotient of `S` by an idempotent. More generally, for any étale `R`-algebra `S`
over an `A`-algebra `R` integrally closed in `K`, any integral closure `C` of `A` in `S` is
canonically isomorphic to the product over the maximal spectrum of `K ⊗[R] S` of the integral
closures of `A` in the field factors `(K ⊗[R] S) ⧸ m`.

This is the step in the base change of unramified extensions of a discrete valuation ring
(Stacks, Lemma 15.116.9 (0EXY)) identifying the integral closure in a factor of `L ⊗_K K'` with
a factor of the étale algebra `B ⊗_A A'`. Its key input is that smooth base change commutes with
integral closure (Mathlib's `TensorProduct.toIntegralClosure_bijective_of_smooth`, Stacks 0CBF):
an element of `K ⊗[R] S` that is integral over `R` comes from `S`
(`IsIntegral.exists_includeRight_eq`). Multiplying a lift of an integral element of `L` by the
idempotent cutting out `L` keeps it integral.

## Main results

* `AlgHom.integralClosure_eq_range_of_surjective`: the integral closure of `R` in a quotient `L`
  of `K ⊗[R] S` is the image of `S`.
* `AlgHom.etale_integralClosure_of_surjective`: this integral closure is étale over `R`.
* `TauCeti.IsIntegralClosure.equivPiIntegralClosureQuotient`: if `R` is integrally closed in a
  field `K`, `S` is étale over `R`, and `C` is the integral closure of `A` in `S`, then
  `C ≃ₐ[A] ∀ m : MaximalSpectrum (K ⊗[R] S), integralClosure A ((K ⊗[R] S) ⧸ m.asIdeal)`.

## References

* [Stacks Project, Lemma 10.147.5](https://stacks.math.columbia.edu/tag/0CBF).
* [Stacks Project, Lemma 15.116.9](https://stacks.math.columbia.edu/tag/0EXY).
-/

public section

open Polynomial
open scoped TensorProduct

namespace AlgHom

section IntegralClosure

variable {R K S L : Type*} [CommRing R] [Field K] [Algebra R K] [IsIntegrallyClosedIn R K]
  [CommRing S] [Algebra R S] [Algebra.Etale R S] [Module.Finite R S]
  [CommRing L] [Algebra K L] [Algebra R L] [IsScalarTower R K L]

/-- Let `S` be a finite étale algebra over a ring `R` that is integrally closed in a field `K`. If
`χ` maps the generic fibre `K ⊗[R] S` onto a ring `L`, then the integral closure of `R` in `L` is
the image of `S`. -/
theorem integralClosure_eq_range_of_surjective (χ : K ⊗[R] S →ₐ[K] L)
    (hχ : Function.Surjective χ) :
    integralClosure R L =
      ((χ.restrictScalars R).comp Algebra.TensorProduct.includeRight).range := by
  obtain ⟨e₀, he₀, hker⟩ := IsSemisimpleRing.ideal_eq_span_idempotent (RingHom.ker χ)
  have hχe₀ : χ e₀ = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_span_singleton_self e₀
  refine le_antisymm (fun x hx ↦ ?_) ?_
  · -- Lift `x` to `y`; then `(1 - e₀) * y` is a lift integral over `R`, hence comes from `S`.
    obtain ⟨y, rfl⟩ := hχ x
    have hχz : χ ((1 - e₀) * y) = χ y := by
      rw [map_mul, map_sub, map_one, hχe₀, sub_zero, one_mul]
    -- If `p` kills `χ y`, then `X * p` kills `(1 - e₀) * y`, which lies in `(1 - e₀)` and in
    -- `ker χ = (e₀)`.
    have hz : IsIntegral R ((1 - e₀) * y) := by
      obtain ⟨p, hp, hpx⟩ := hx
      refine ⟨X * p, monic_X.mul hp, ?_⟩
      rw [eval₂_mul, eval₂_X, ← aeval_def]
      have hmem : (1 - e₀) * y * aeval ((1 - e₀) * y) p ∈ RingHom.ker χ := by
        have := Polynomial.aeval_algHom_apply (χ.restrictScalars R) ((1 - e₀) * y) p
        rw [AlgHom.restrictScalars_apply, AlgHom.restrictScalars_apply, hχz] at this
        rw [RingHom.mem_ker, map_mul, ← this, hχz, aeval_def, hpx, mul_zero]
      rw [hker, Ideal.mem_span_singleton'] at hmem
      obtain ⟨w, hw⟩ := hmem
      calc (1 - e₀) * y * aeval ((1 - e₀) * y) p
          = (1 - e₀) * ((1 - e₀) * y * aeval ((1 - e₀) * y) p) := by
            rw [← mul_assoc, ← mul_assoc, he₀.one_sub.eq, mul_assoc]
        _ = 0 := by rw [← hw, mul_left_comm, sub_mul, one_mul, he₀.eq, sub_self, mul_zero]
    obtain ⟨b, hb⟩ := hz.exists_includeRight_eq
    exact (AlgHom.mem_range _).mpr ⟨b, by
      rw [AlgHom.comp_apply, AlgHom.restrictScalars_apply, hb, hχz]⟩
  · intro x hx
    obtain ⟨b, rfl⟩ := (AlgHom.mem_range _).mp hx
    exact (Algebra.IsIntegral.isIntegral b).map _

/-- Let `S` be a finite étale algebra over a ring `R` that is integrally closed in a field `K`. If
`χ` maps the generic fibre `K ⊗[R] S` onto a ring `L`, then the integral closure of `R` in `L` is
étale over `R`: it is the image of `S`, which is the quotient of `S` by an idempotent. -/
theorem etale_integralClosure_of_surjective (χ : K ⊗[R] S →ₐ[K] L)
    (hχ : Function.Surjective χ) : Algebra.Etale R (integralClosure R L) := by
  let ψ : S →ₐ[R] L := (χ.restrictScalars R).comp Algebra.TensorProduct.includeRight
  have hinj : Function.Injective (Algebra.TensorProduct.includeRight : S →ₐ[R] K ⊗[R] S) :=
    Algebra.TensorProduct.includeRight_injective (isIntegrallyClosedIn_iff.mp ‹_›).1
  obtain ⟨e₀, he₀, hker⟩ := IsSemisimpleRing.ideal_eq_span_idempotent (RingHom.ker χ)
  -- The idempotent `1 - e₀`, being integral over `R`, comes from an idempotent `e` of `S`.
  have heint : IsIntegral R (1 - e₀) :=
    ⟨X ^ 2 - X, monic_X_pow_sub (degree_X_le.trans_lt (by norm_num)),
      by simp [pow_two, he₀.one_sub.eq]⟩
  obtain ⟨e, he⟩ := heint.exists_includeRight_eq
  have he' : IsIdempotentElem e :=
    isIdempotentElem_iff.mpr <| hinj <| by rw [map_mul, he, he₀.one_sub.eq]
  have h1e : Algebra.TensorProduct.includeRight (1 - e) = e₀ := by
    rw [map_sub, he, map_one, sub_sub_cancel]
  -- The kernel of `ψ : S → L` is generated by the idempotent `1 - e`.
  have hkerψ : RingHom.ker ψ = Ideal.span {1 - e} := by
    ext b
    rw [RingHom.mem_ker, AlgHom.comp_apply, AlgHom.restrictScalars_apply, ← RingHom.mem_ker, hker,
      Ideal.mem_span_singleton', Ideal.mem_span_singleton']
    constructor
    · rintro ⟨w, hw⟩
      refine ⟨b, hinj ?_⟩
      rw [map_mul, h1e, ← hw, mul_assoc, he₀.eq]
    · rintro ⟨w, rfl⟩
      exact ⟨Algebra.TensorProduct.includeRight w, by rw [← h1e, map_mul]⟩
  have := TauCeti.Algebra.Etale.quotient_span_singleton (R := R) he'.one_sub
  have : Algebra.Etale R ψ.range :=
    .of_equiv ((Ideal.quotientEquivAlgOfEq R hkerψ.symm).trans (Ideal.quotientKerEquivRange ψ))
  exact .of_equiv (Subalgebra.equivOfEq _ _ (integralClosure_eq_range_of_surjective χ hχ).symm)

end IntegralClosure

end AlgHom

namespace TauCeti.IsIntegralClosure

section EquivPi

variable (A R K S C : Type*)
  [CommRing A] [CommRing R] [Algebra A R]
  [Field K] [Algebra A K] [Algebra R K] [IsScalarTower A R K] [IsIntegrallyClosedIn R K]
  [CommRing S] [Algebra A S] [Algebra R S] [IsScalarTower A R S] [Algebra.Etale R S]
  [CommRing C] [Algebra A C] [Algebra C S] [IsScalarTower A C S] [IsIntegralClosure C A S]

private noncomputable def toIntegralClosureTensor :
    C →ₐ[A] integralClosure A (K ⊗[R] S) :=
  let j : C →ₐ[A] K ⊗[R] S :=
    ((Algebra.TensorProduct.includeRight (R := R) (A := K) (B := S)).restrictScalars A).comp
      (IsScalarTower.toAlgHom A C S)
  j.codRestrict (integralClosure A (K ⊗[R] S)) fun c ↦
    (mem_integralClosure_iff A (K ⊗[R] S)).mpr ((IsIntegralClosure.isIntegral A S c).map j)

omit [IsIntegrallyClosedIn R K] [Algebra.Etale R S] in
@[simp]
private theorem coe_toIntegralClosureTensor_apply (c : C) :
    (toIntegralClosureTensor A R K S C c : K ⊗[R] S) = 1 ⊗ₜ[R] algebraMap C S c := by
  simp [toIntegralClosureTensor]

private theorem bijective_toIntegralClosureTensor :
    Function.Bijective (toIntegralClosureTensor A R K S C) := by
  have hinc : Function.Injective
      (Algebra.TensorProduct.includeRight (R := R) (A := K) (B := S)) :=
    Algebra.TensorProduct.includeRight_injective (isIntegrallyClosedIn_iff.mp ‹_›).1
  refine ⟨fun a b h ↦ ?_, fun ⟨x, hx⟩ ↦ ?_⟩
  · apply IsIntegralClosure.algebraMap_injective C A S
    apply hinc
    simpa using congrArg Subtype.val h
  · obtain ⟨s, rfl⟩ := (hx.tower_top (A := R)).exists_includeRight_eq
    have hs : IsIntegral A s :=
      (isIntegral_algHom_iff
        ((Algebra.TensorProduct.includeRight (R := R) (A := K) (B := S)).restrictScalars A)
        hinc).mp hx
    obtain ⟨c, rfl⟩ := (IsIntegralClosure.isIntegral_iff (A := C)).mp hs
    exact ⟨c, Subtype.ext (by simp)⟩

/-- **Product decomposition of an integral closure in an étale algebra.** Let `R` be an
`A`-algebra that is integrally closed in a field `K`, let `S` be an étale `R`-algebra, and let `C`
be the integral closure of `A` in `S`. Then `C` is `A`-isomorphic to the product
`∀ m : MaximalSpectrum (K ⊗[R] S), integralClosure A ((K ⊗[R] S) ⧸ m.asIdeal)` of the integral
closures of `A` in the field factors of `K ⊗[R] S`, sending `c : C` at `m` to the class of
`1 ⊗ₜ[R] algebraMap C S c`. -/
noncomputable def equivPiIntegralClosureQuotient :
    C ≃ₐ[A] ∀ m : MaximalSpectrum (K ⊗[R] S), integralClosure A ((K ⊗[R] S) ⧸ m.asIdeal) :=
  (AlgEquiv.ofBijective (toIntegralClosureTensor A R K S C)
    (bijective_toIntegralClosureTensor A R K S C)).trans <|
    (((IsArtinianRing.equivPi (K ⊗[R] S)).restrictScalars A).mapIntegralClosure).trans <|
      TauCeti.integralClosurePiAlgEquiv A
        (fun m : MaximalSpectrum (K ⊗[R] S) ↦ (K ⊗[R] S) ⧸ m.asIdeal)

variable {A R K S C} in
/-- Evaluating `TauCeti.IsIntegralClosure.equivPiIntegralClosureQuotient` at a maximal ideal `m` of
`K ⊗[R] S` sends `c : C` to the class of `1 ⊗ₜ[R] algebraMap C S c` in `(K ⊗[R] S) ⧸ m.asIdeal`. -/
@[simp]
theorem coe_equivPiIntegralClosureQuotient_apply (c : C) (m : MaximalSpectrum (K ⊗[R] S)) :
    (equivPiIntegralClosureQuotient A R K S C c m : (K ⊗[R] S) ⧸ m.asIdeal) =
      Ideal.Quotient.mk m.asIdeal (1 ⊗ₜ[R] algebraMap C S c) := by
  simp [equivPiIntegralClosureQuotient, AlgEquiv.restrictScalars_apply]

end EquivPi

end TauCeti.IsIntegralClosure
