/-!
# Connected étale algebras over normal domains

Let `R` be a commutative ring integrally closed in a field `K`, and let `S` be an étale
`R`-algebra. Its generic fibre `K ⊗[R] S` is a finite reduced `K`-algebra, hence a semisimple
commutative ring (`TauCeti.Algebra.FormallyUnramified.isSemisimpleRing_field_tensorProduct`), so
each of its ideals is generated by an idempotent. Because smooth base change commutes with integral
closure (`IsIntegral.exists_includeRight_eq`), every idempotent of `K ⊗[R] S` comes from an
idempotent of `S`. When `Spec S` is connected, the only idempotents of `S` are `0` and `1`
(`IsIdempotentElem.eq_zero_or_eq_one_of_preconnectedSpace`), forcing every nonzero element of
`K ⊗[R] S` to be a unit. Thus `K ⊗[R] S` is a field, and `S`, which embeds into `K ⊗[R] S` by
flatness, is an integral domain. When `K` is moreover a fraction field of `R`, `K ⊗[R] S` is a
fraction field of `S` (`TauCeti.Algebra.Etale.isFractionRing_tensorProduct_of_connectedSpace`).

Conversely, if `K ⊗[R] S` is a field then `S` is a domain, so `Spec S` is irreducible and in
particular connected. Specializing to `K = FractionRing R` for an integrally closed domain `R`
shows that an étale `R`-algebra with connected prime spectrum is an integrally closed domain
(`TauCeti.Algebra.Etale.isDomain_of_connectedSpace`,
`TauCeti.Algebra.Etale.isIntegrallyClosed_of_connectedSpace`), with no Noetherian or characteristic
hypotheses.

## Main results

* `TauCeti.Algebra.Etale.isField_tensorProduct_of_connectedSpace`: for `R` integrally closed in a
  field `K` and an étale `R`-algebra `S` with connected `Spec S`, `K ⊗[R] S` is a field.
* `TauCeti.Algebra.Etale.isField_tensorProduct_iff_connectedSpace`,
  `TauCeti.Algebra.Etale.isDomain_iff_connectedSpace_of_isIntegrallyClosedIn`: for `R` integrally
  closed in a field `K` and `S` étale over `R`, `K ⊗[R] S` is a field if and only if `Spec S` is
  connected, if and only if `S` is a domain.
* `TauCeti.Algebra.Etale.isFractionRing_tensorProduct_of_connectedSpace`: when `R` is integrally
  closed in a fraction field `K` and `S` is a connected étale `R`-algebra, `K ⊗[R] S` is a
  fraction field of `S`.
* `TauCeti.Algebra.Etale.isDomain_of_connectedSpace`,
  `TauCeti.Algebra.Etale.isDomain_iff_connectedSpace`,
  `TauCeti.Algebra.Etale.isIntegrallyClosed_of_connectedSpace`: over an integrally closed domain
  `R`, an étale `R`-algebra with connected prime spectrum is an integrally closed domain.

## References

* [Stacks Project, Lemma 10.147.5](https://stacks.math.columbia.edu/tag/0CBF).
* [Stacks Project, Lemma 10.163.9](https://stacks.math.columbia.edu/tag/033C).
-/

public section

open Polynomial
open scoped TensorProduct

namespace TauCeti.Algebra.Etale

section IntegrallyClosedIn

variable (R K S : Type*) [CommRing R] [Field K] [Algebra R K] [CommRing S] [Algebra R S]

/-- **Connected étale algebras have field generic fibres.** Let `R` be integrally closed in a field
`K`, and let `S` be an étale `R`-algebra whose prime spectrum is connected. Then `K ⊗[R] S` is a
field: every principal ideal of the semisimple ring `K ⊗[R] S` is generated by an idempotent,
which is integral over `R`, hence comes from an idempotent of `S`, hence is `0` or `1`. -/
theorem isField_tensorProduct_of_connectedSpace [IsIntegrallyClosedIn R K] [Algebra.Etale R S]
    [ConnectedSpace (PrimeSpectrum S)] :
    IsField (K ⊗[R] S) := by
  have hinj : Function.Injective (Algebra.TensorProduct.includeRight : S →ₐ[R] K ⊗[R] S) :=
    Algebra.TensorProduct.includeRight_injective (isIntegrallyClosedIn_iff.mp ‹_›).1
  have : Nontrivial S := PrimeSpectrum.nonempty_iff_nontrivial.mp inferInstance
  have : Nontrivial (K ⊗[R] S) := hinj.nontrivial
  refine ⟨exists_pair_ne _, mul_comm, fun {x} hx ↦ ?_⟩
  obtain ⟨e₀, he₀, hspan⟩ := IsSemisimpleRing.ideal_eq_span_idempotent (Ideal.span {x})
  have heint : IsIntegral R e₀ :=
    ⟨X ^ 2 - X, monic_X_pow_sub (degree_X_le.trans_lt (by norm_num)),
      by simp [pow_two, he₀.eq]⟩
  obtain ⟨e, he⟩ := heint.exists_includeRight_eq
  have he' : IsIdempotentElem e :=
    isIdempotentElem_iff.mpr <| hinj <| by rw [map_mul, he, he₀.eq]
  rcases he'.eq_zero_or_eq_one_of_preconnectedSpace with rfl | rfl
  · exfalso
    apply hx
    have hxmem : x ∈ Ideal.span {e₀} := hspan ▸ Ideal.mem_span_singleton_self x
    simpa [← he] using hxmem
  · rw [map_one] at he
    exact isUnit_iff_exists_inv.mp
      (Ideal.span_singleton_eq_top.mp (hspan.symm ▸ he ▸ Ideal.span_singleton_one))

/-- For `R` integrally closed in a field `K` and `S` étale over `R`, the generic fibre `K ⊗[R] S`
is a field if and only if `Spec S` is connected. -/
theorem isField_tensorProduct_iff_connectedSpace [IsIntegrallyClosedIn R K] [Algebra.Etale R S] :
    IsField (K ⊗[R] S) ↔ ConnectedSpace (PrimeSpectrum S) := by
  refine ⟨fun hf ↦ ?_, fun _ ↦ isField_tensorProduct_of_connectedSpace R K S⟩
  let _ : Field (K ⊗[R] S) := hf.toField
  have : IsDomain S :=
    (Algebra.TensorProduct.includeRight_injective (B := S)
      (isIntegrallyClosedIn_iff.mp ‹_›).1).isDomain
      (Algebra.TensorProduct.includeRight : S →ₐ[R] K ⊗[R] S).toRingHom
  infer_instance

include K in
/-- For `R` integrally closed in a field `K` and `S` étale over `R`, `S` is a domain if and only if
`Spec S` is connected. -/
theorem isDomain_iff_connectedSpace_of_isIntegrallyClosedIn [IsIntegrallyClosedIn R K]
    [Algebra.Etale R S] :
    IsDomain S ↔ ConnectedSpace (PrimeSpectrum S) := by
  refine ⟨fun _ ↦ inferInstance, fun _ ↦ ?_⟩
  let _ : Field (K ⊗[R] S) := (isField_tensorProduct_of_connectedSpace R K S).toField
  exact (Algebra.TensorProduct.includeRight_injective (B := S)
    (isIntegrallyClosedIn_iff.mp ‹_›).1).isDomain
    (Algebra.TensorProduct.includeRight : S →ₐ[R] K ⊗[R] S).toRingHom

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- **The generic fibre of a connected étale algebra is its fraction field.** When `R` is
integrally closed in a fraction field `K` and `S` is a connected étale `R`-algebra, `K ⊗[R] S` is
a fraction field of `S`. -/
theorem isFractionRing_tensorProduct_of_connectedSpace [IsIntegrallyClosedIn R K]
    [IsFractionRing R K] [Algebra.Etale R S] [ConnectedSpace (PrimeSpectrum S)] :
    IsFractionRing S (K ⊗[R] S) := by
  let _ : Field (K ⊗[R] S) := (isField_tensorProduct_of_connectedSpace R K S).toField
  have hinjRK : Function.Injective (algebraMap R K) := (isIntegrallyClosedIn_iff.mp ‹_›).1
  have : IsDomain R := hinjRK.isDomain (algebraMap R K)
  have hinjSL : Function.Injective (algebraMap S (K ⊗[R] S)) :=
    Algebra.TensorProduct.includeRight_injective hinjRK
  have : IsDomain S := hinjSL.isDomain (algebraMap S (K ⊗[R] S))
  have hinjRS : Function.Injective (algebraMap R S) := fun r₁ r₂ hr ↦
    hinjRK <| (algebraMap K (K ⊗[R] S)).injective <| by
      rw [← IsScalarTower.algebraMap_apply R K (K ⊗[R] S),
        ← IsScalarTower.algebraMap_apply R K (K ⊗[R] S),
        IsScalarTower.algebraMap_apply R S (K ⊗[R] S),
        IsScalarTower.algebraMap_apply R S (K ⊗[R] S), hr]
  have : IsLocalization (Algebra.algebraMapSubmonoid S (nonZeroDivisors R)) (K ⊗[R] S) :=
    IsLocalization.tensorRight (S := S) K (nonZeroDivisors R)
  refine ⟨fun y ↦ isUnit_iff_ne_zero.mpr (map_ne_zero_of_mem_nonZeroDivisors _ hinjSL y.property),
    fun z ↦ ?_, fun {a b} hab ↦ ⟨1, by simp [hinjSL hab]⟩⟩
  obtain ⟨⟨s, _, ⟨r, hr, rfl⟩⟩, h⟩ :=
    IsLocalization.surj (Algebra.algebraMapSubmonoid S (nonZeroDivisors R)) z
  exact ⟨⟨s, ⟨algebraMap R S r, map_mem_nonZeroDivisors _ hinjRS hr⟩⟩, h⟩

end IntegrallyClosedIn

section IntegrallyClosed

variable (R S : Type*) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
  [CommRing S] [Algebra R S] [Algebra.Etale R S]

include R

/-- **A connected étale algebra over an integrally closed domain is a domain.** No Noetherian or
characteristic hypotheses are required. -/
theorem isDomain_of_connectedSpace [ConnectedSpace (PrimeSpectrum S)] : IsDomain S :=
  (isDomain_iff_connectedSpace_of_isIntegrallyClosedIn R (FractionRing R) S).mpr inferInstance

/-- Over an integrally closed domain `R`, an étale `R`-algebra `S` is a domain if and only if
`Spec S` is connected. -/
theorem isDomain_iff_connectedSpace : IsDomain S ↔ ConnectedSpace (PrimeSpectrum S) :=
  isDomain_iff_connectedSpace_of_isIntegrallyClosedIn R (FractionRing R) S

/-- **A connected étale algebra over an integrally closed domain is integrally closed.** Combines
`isDomain_of_connectedSpace` with `TauCeti.Algebra.Etale.isIntegrallyClosed`. -/
theorem isIntegrallyClosed_of_connectedSpace [ConnectedSpace (PrimeSpectrum S)] :
    IsIntegrallyClosed S :=
  have := isDomain_of_connectedSpace R S
  isIntegrallyClosed R S

end IntegrallyClosed

end TauCeti.Algebra.Etale
