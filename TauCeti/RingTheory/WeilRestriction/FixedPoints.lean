/-!
# Fixed-point subschemes of Weil restrictions and Edixhoven's smoothness theorem

Let `B` be a finite projective `A`-algebra and `C` a finitely presented `B`-algebra. Suppose a
monoid `Γ` acts on `B` by `A`-algebra automorphisms `ρB : Γ →* (B ≃ₐ[A] B)` and on `C` by ring
automorphisms `ρC : Γ →* RingAut C` semilinearly over `ρB`. By
`TauCeti.Algebra.WeilRestriction.inducedAction`, `Γ` acts on `WeilRestriction A B C` by `A`-algebra
automorphisms.

This file constructs the coordinate algebra `fixedCoordinateRing ρB ρC h` of the `Γ`-fixed closed
subscheme `(Res_{B/A} Spec C)^Γ`, cut out by the ideal `fixedIdeal ρB ρC h` generated by all
displacements `γ(x) - x`, and proves:

1. **Universal property (`fixedHomEquiv`):** `A`-algebra homomorphisms
   `fixedCoordinateRing ρB ρC h →ₐ[A] T` correspond bijectively to `Γ`-equivariant `B`-algebra
   homomorphisms `y : C →ₐ[B] B ⊗[A] T`, in the sense that `y (ρC γ c) = (ρB γ ⊗ id_T) (y c)` for
   all `γ : Γ` and `c : C`.
2. **Finite presentation (`instFinitePresentationFixedCoordinateRing`):** when `Γ` is finite,
   `fixedCoordinateRing ρB ρC h` is of finite presentation over `A`.
3. **Edixhoven's tame fixed-point theorem (`formallySmooth_fixedPoints`, `smooth_fixedPoints`):**
   when `Γ` is a finite group whose order `Nat.card Γ` is invertible in `A` and `C` is formally
   smooth (respectively, smooth) over `B`, `fixedCoordinateRing ρB ρC h` is formally smooth
   (respectively, smooth) over `A`. No Noetherian or Henselian assumption on `A` is needed; in
   particular the theorem applies over any discrete valuation ring `O` for a tame finite free
   extension `O'/O`.
4. **Checks:** a trivial action fixes the entire Weil restriction
   (`fixedCoordinateRingEquivOfEqOne`), and when `Γ` is a finite group of order invertible in `A`
   with `B^Γ = A`, the fixed-point subscheme of `Res_{B/A} 𝔸¹_B` under the coefficient action on
   `B[X]` is `𝔸¹_A` (`fixedCoordinateRingPolynomialEquiv`).

## Main definitions

* `TauCeti.Algebra.WeilRestriction.fixedIdeal ρB ρC h`: the displacement ideal in
  `WeilRestriction A B C` cutting out `(Res_{B/A} Spec C)^Γ`.
* `TauCeti.Algebra.WeilRestriction.fixedCoordinateRing ρB ρC h`: the quotient `A`-algebra
  `WeilRestriction A B C ⧸ fixedIdeal ρB ρC h`.
* `TauCeti.Algebra.WeilRestriction.fixedHomEquiv ρB ρC h T`: the universal property identifying
  `A`-points of the fixed subscheme with `Γ`-equivariant `B`-points of `C` in `B ⊗[A] T`.
* `TauCeti.Algebra.WeilRestriction.polynomialCoefficientAction ρB` and
  `TauCeti.Algebra.WeilRestriction.fixedCoordinateRingPolynomialEquiv`: the coefficient action on
  `B[X]` and the identification `(Res_{B/A} 𝔸¹_B)^Γ ≃ 𝔸¹_A` when `B^Γ = A` and `|Γ| ∈ Aˣ`.

## Main results

* `TauCeti.Algebra.WeilRestriction.instFinitePresentationFixedCoordinateRing`: finite presentation
  of `fixedCoordinateRing ρB ρC h` for finite `Γ`.
* `TauCeti.Algebra.WeilRestriction.formallySmooth_fixedPoints` and
  `TauCeti.Algebra.WeilRestriction.smooth_fixedPoints`: Edixhoven's formal smoothness and
  smoothness theorems for `(Res_{B/A} Spec C)^Γ`.
* `TauCeti.Algebra.WeilRestriction.fixedIdeal_eq_bot_of_eq_one` and
  `TauCeti.Algebra.WeilRestriction.fixedCoordinateRingEquivOfEqOne`: trivial actions fix the whole
  Weil restriction.

## References

* B. Edixhoven, *Néron models and tame ramification*, Compositio Math. 81 (1992), Proposition 3.1
  (p. 293) and Proposition 3.4 (pp. 294–295).
-/

public noncomputable section

open Algebra TensorProduct Polynomial

namespace TauCeti.Algebra.WeilRestriction

section General

variable {A B C : Type*} [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra B C]
  [Module.Finite A B] [Module.Projective A B] [FinitePresentation B C]
  {Γ : Type*} [Monoid Γ] (ρB : Γ →* (B ≃ₐ[A] B)) (ρC : Γ →* RingAut C)
  (h : ∀ γ b, ρC γ (algebraMap B C b) = algebraMap B C (ρB γ b))

/-- The **fixed-point ideal** of the induced `Γ`-action on `WeilRestriction A B C`: the ideal
generated by all displacements `inducedAction ρB ρC h γ x - x`. Contravariantly, it cuts out the
closed subscheme `(Res_{B/A} Spec C)^Γ` inside `Res_{B/A} Spec C`. -/
def fixedIdeal : Ideal (WeilRestriction A B C) :=
  ⨆ γ : Γ, Ideal.span (Set.range fun x : WeilRestriction A B C ↦ inducedAction ρB ρC h γ x - x)

/-- Explicit supremum-of-spans presentation of `fixedIdeal ρB ρC h`. -/
theorem fixedIdeal_def :
    fixedIdeal ρB ρC h =
      ⨆ γ : Γ,
        Ideal.span (Set.range fun x : WeilRestriction A B C ↦ inducedAction ρB ρC h γ x - x) :=
  (rfl)

/-- Every displacement `inducedAction ρB ρC h γ x - x` lies in `fixedIdeal ρB ρC h`. -/
@[grind ←]
theorem sub_mem_fixedIdeal (γ : Γ) (x : WeilRestriction A B C) :
    inducedAction ρB ρC h γ x - x ∈ fixedIdeal ρB ρC h :=
  Ideal.mem_iSup_of_mem γ (Ideal.subset_span ⟨x, rfl⟩)

/-- `fixedIdeal ρB ρC h` is the smallest ideal containing every displacement of `inducedAction`. -/
@[simp]
theorem fixedIdeal_le_iff {J : Ideal (WeilRestriction A B C)} :
    fixedIdeal ρB ρC h ≤ J ↔ ∀ (γ : Γ) (x : WeilRestriction A B C),
      inducedAction ρB ρC h γ x - x ∈ J := by
  rw [fixedIdeal_def, iSup_le_iff]
  refine forall_congr' fun γ ↦ ?_
  rw [Ideal.span_le, Set.range_subset_iff]
  rfl

/-- An `A`-algebra homomorphism `g : WeilRestriction A B C →ₐ[A] T` kills `fixedIdeal ρB ρC h` if
and only if the `B`-algebra homomorphism `homEquiv A B C T g : C →ₐ[B] B ⊗[A] T` it classifies is
`Γ`-equivariant. -/
theorem fixedIdeal_le_ker_iff {T : Type*} [CommRing T] [Algebra A T]
    (g : WeilRestriction A B C →ₐ[A] T) :
    fixedIdeal ρB ρC h ≤ RingHom.ker g.toRingHom ↔
      ∀ (γ : Γ) (c : C), homEquiv A B C T g (ρC γ c) =
        Algebra.TensorProduct.rTensor T (ρB γ : B →ₐ[A] B) (homEquiv A B C T g c) := by
  rw [fixedIdeal_le_iff]
  refine forall_congr' fun γ ↦ ?_
  rw [← comp_inducedAction_eq_iff ρB ρC h γ g, AlgHom.ext_iff]
  refine forall_congr' fun x ↦ ?_
  rw [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_sub, sub_eq_zero,
    AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]

/-- The **coordinate `A`-algebra of `(Res_{B/A} Spec C)^Γ`**: the quotient of
`WeilRestriction A B C` by `fixedIdeal ρB ρC h`. -/
abbrev fixedCoordinateRing : Type _ :=
  WeilRestriction A B C ⧸ fixedIdeal ρB ρC h

/-- The canonical surjective `A`-algebra quotient map onto `fixedCoordinateRing ρB ρC h`, dual to
the closed immersion `(Res_{B/A} Spec C)^Γ ↪ Res_{B/A} Spec C`. -/
def mkFixed : WeilRestriction A B C →ₐ[A] fixedCoordinateRing ρB ρC h :=
  Ideal.Quotient.mkₐ A (fixedIdeal ρB ρC h)

/-- The quotient map `mkFixed ρB ρC h` is surjective. -/
theorem mkFixed_surjective : Function.Surjective (mkFixed ρB ρC h) :=
  Ideal.Quotient.mkₐ_surjective A (fixedIdeal ρB ρC h)

/-- `mkFixed ρB ρC h` equalizes every `inducedAction ρB ρC h γ` with the identity. -/
theorem mkFixed_inducedAction_apply (γ : Γ) (x : WeilRestriction A B C) :
    mkFixed ρB ρC h (inducedAction ρB ρC h γ x) = mkFixed ρB ρC h x :=
  Ideal.Quotient.eq.mpr (sub_mem_fixedIdeal ρB ρC h γ x)

/-- Normal-form version of `mkFixed_inducedAction_apply` after `inducedAction_apply`. -/
@[simp]
theorem mkFixed_semilinearMap_apply (γ : Γ) (x : WeilRestriction A B C) :
    mkFixed ρB ρC h (semilinearMap (ρB γ) (ρC γ : C →+* C) (h γ) x) = mkFixed ρB ρC h x := by
  rw [← inducedAction_apply]
  exact mkFixed_inducedAction_apply ρB ρC h γ x

/-- The universal `Γ`-equivariant point `C →ₐ[B] B ⊗[A] fixedCoordinateRing ρB ρC h`. -/
def fixedUniversalPoint : C →ₐ[B] B ⊗[A] fixedCoordinateRing ρB ρC h :=
  homEquiv A B C (fixedCoordinateRing ρB ρC h) (mkFixed ρB ρC h)

/-- The universal point of `fixedCoordinateRing ρB ρC h` is `Γ`-equivariant. -/
theorem fixedUniversalPoint_equivariant (γ : Γ) (c : C) :
    fixedUniversalPoint ρB ρC h (ρC γ c) =
      Algebra.TensorProduct.rTensor (fixedCoordinateRing ρB ρC h) (ρB γ : B →ₐ[A] B)
        (fixedUniversalPoint ρB ρC h c) := by
  have hker : fixedIdeal ρB ρC h ≤ RingHom.ker (mkFixed ρB ρC h).toRingHom := by
    rw [mkFixed, AlgHom.toRingHom_eq_coe, Ideal.Quotient.mkₐ_ker]
  exact (fixedIdeal_le_ker_iff ρB ρC h (mkFixed ρB ρC h)).mp hker γ c

/-- **Universal property of `(Res_{B/A} Spec C)^Γ`** (Edixhoven, Proposition 3.1): `A`-algebra
homomorphisms `fixedCoordinateRing ρB ρC h →ₐ[A] T` correspond bijectively to `Γ`-equivariant
`B`-algebra homomorphisms `C →ₐ[B] B ⊗[A] T`. -/
def fixedHomEquiv (T : Type*) [CommRing T] [Algebra A T] :
    (fixedCoordinateRing ρB ρC h →ₐ[A] T) ≃
      { y : C →ₐ[B] B ⊗[A] T //
        ∀ (γ : Γ) (c : C), y (ρC γ c) =
          Algebra.TensorProduct.rTensor T (ρB γ : B →ₐ[A] B) (y c) } where
  toFun g :=
    ⟨homEquiv A B C T (g.comp (mkFixed ρB ρC h)), fun γ c ↦ by
      have hcomp : (g.comp (mkFixed ρB ρC h)).comp (inducedAction ρB ρC h γ : _ →ₐ[A] _) =
          g.comp (mkFixed ρB ρC h) :=
        AlgHom.ext fun x ↦ by
          rw [AlgHom.comp_apply, AlgHom.comp_apply, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
            mkFixed_inducedAction_apply]
      exact (comp_inducedAction_eq_iff ρB ρC h γ (g.comp (mkFixed ρB ρC h))).mp hcomp c⟩
  invFun y :=
    Ideal.Quotient.liftₐ (fixedIdeal ρB ρC h) ((homEquiv A B C T).symm y.1) fun x hx ↦ by
      have hker := (fixedIdeal_le_ker_iff ρB ρC h ((homEquiv A B C T).symm y.1)).mpr
        (by simpa using y.2)
      exact RingHom.mem_ker.mp (hker hx)
  left_inv g := AlgHom.ext fun x ↦ by
    obtain ⟨w, rfl⟩ := mkFixed_surjective ρB ρC h x
    exact DFunLike.congr_fun ((homEquiv A B C T).symm_apply_apply (g.comp (mkFixed ρB ρC h))) w
  right_inv y := Subtype.ext <| (homEquiv A B C T).apply_symm_apply y.1

/-- `fixedHomEquiv` acts by precomposing with `mkFixed` and applying `homEquiv`. -/
@[simp]
theorem fixedHomEquiv_apply_coe {T : Type*} [CommRing T] [Algebra A T]
    (g : fixedCoordinateRing ρB ρC h →ₐ[A] T) :
    (fixedHomEquiv ρB ρC h T g).1 = homEquiv A B C T (g.comp (mkFixed ρB ρC h)) :=
  (rfl)

/-- Base-change description of `fixedHomEquiv` in terms of `fixedUniversalPoint`. -/
theorem fixedHomEquiv_apply {T : Type*} [CommRing T] [Algebra A T]
    (g : fixedCoordinateRing ρB ρC h →ₐ[A] T) :
    (fixedHomEquiv ρB ρC h T g).1 =
      (Algebra.TensorProduct.lTensor (S := B) B g).comp (fixedUniversalPoint ρB ρC h) := by
  rw [fixedHomEquiv_apply_coe, homEquiv_comp, fixedUniversalPoint]

/-- Precomposing `(fixedHomEquiv ρB ρC h T).symm y` with `mkFixed` recovers
`(homEquiv A B C T).symm y.1`. -/
@[simp]
theorem fixedHomEquiv_symm_comp_mkFixed {T : Type*} [CommRing T] [Algebra A T]
    (y : { y : C →ₐ[B] B ⊗[A] T //
      ∀ (γ : Γ) (c : C), y (ρC γ c) =
        Algebra.TensorProduct.rTensor T (ρB γ : B →ₐ[A] B) (y c) }) :
    ((fixedHomEquiv ρB ρC h T).symm y).comp (mkFixed ρB ρC h) =
      (homEquiv A B C T).symm y.1 :=
  AlgHom.ext fun _ ↦ rfl

/-- If `Γ` acts trivially on `B` and on `C`, then `fixedIdeal ρB ρC h` vanishes. -/
theorem fixedIdeal_eq_bot_of_eq_one (hB : ρB = 1) (hC : ρC = 1) :
    fixedIdeal ρB ρC h = ⊥ := by
  rw [eq_bot_iff, fixedIdeal_le_iff]
  intro γ x
  rw [inducedAction_eq_one ρB ρC h hB hC, MonoidHom.one_apply, AlgEquiv.one_apply, sub_self,
    Submodule.mem_bot]

/-- A trivial semilinear action fixes the entire Weil restriction. -/
def fixedCoordinateRingEquivOfEqOne (hB : ρB = 1) (hC : ρC = 1) :
    fixedCoordinateRing ρB ρC h ≃ₐ[A] WeilRestriction A B C :=
  (Ideal.quotientEquivAlgOfEq A (fixedIdeal_eq_bot_of_eq_one ρB ρC h hB hC)).trans
    (AlgEquiv.quotientBot A (WeilRestriction A B C))

/-- `fixedCoordinateRingEquivOfEqOne` sends `mkFixed ρB ρC h x` to `x`. -/
@[simp]
theorem fixedCoordinateRingEquivOfEqOne_mkFixed (hB : ρB = 1) (hC : ρC = 1)
    (x : WeilRestriction A B C) :
    fixedCoordinateRingEquivOfEqOne ρB ρC h hB hC (mkFixed ρB ρC h x) = x := by
  simp [fixedCoordinateRingEquivOfEqOne, mkFixed]

/-- When `Γ` is finite, `fixedIdeal ρB ρC h` is finitely generated. -/
theorem fixedIdeal_fg [_root_.Finite Γ] : (fixedIdeal ρB ρC h).FG := by
  rw [fixedIdeal_def]
  exact AlgHom.fg_iSup_span_range_sub (R := A)
    (fun γ : Γ ↦ (inducedAction ρB ρC h γ).toAlgHom)
    (fun _ ↦ AlgHom.id A (WeilRestriction A B C))

/-- When `Γ` is finite, `fixedCoordinateRing ρB ρC h` is of finite presentation over `A`. -/
instance instFinitePresentationFixedCoordinateRing [_root_.Finite Γ] :
    FinitePresentation A (fixedCoordinateRing ρB ρC h) :=
  FinitePresentation.quotient (fixedIdeal_fg ρB ρC h)

end General

section Smoothness

variable {A B C : Type*} [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra B C]
  [Module.Finite A B] [Module.Projective A B] [FinitePresentation B C]
  {Γ : Type*} [Group Γ] [_root_.Finite Γ] (ρB : Γ →* (B ≃ₐ[A] B)) (ρC : Γ →* RingAut C)
  (h : ∀ γ b, ρC γ (algebraMap B C b) = algebraMap B C (ρB γ b))

/-- **Edixhoven's formal smoothness theorem for Weil restrictions** (Edixhoven, Proposition 3.4):
if `Γ` is a finite group whose order is invertible in `A` and `C` is formally smooth over `B`,
then `(Res_{B/A} Spec C)^Γ` is formally smooth over `A`. -/
theorem formallySmooth_fixedPoints [FormallySmooth B C] (hΓ : IsUnit (Nat.card Γ : A)) :
    FormallySmooth A (fixedCoordinateRing ρB ρC h) :=
  TauCeti.formallySmooth_quotient_of_eq_iSup_span_range_sub (inducedAction ρB ρC h) rfl hΓ

/-- **Edixhoven's tame fixed-point theorem for Weil restrictions** (Edixhoven, Propositions 3.1
and 3.4): if `Γ` is a finite group whose order is invertible in `A` and `C` is smooth over `B`,
then `(Res_{B/A} Spec C)^Γ` is smooth over `A`. Because `A` is an arbitrary commutative ring, this
applies over any discrete valuation ring `O` with no Henselian hypothesis. -/
theorem smooth_fixedPoints [Smooth B C] (hΓ : IsUnit (Nat.card Γ : A)) :
    Smooth A (fixedCoordinateRing ρB ρC h) :=
  TauCeti.smooth_quotient_of_eq_iSup_span_range_sub (inducedAction ρB ρC h) rfl hΓ

end Smoothness

section TameAffineLine

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
  {Γ : Type*} [Monoid Γ] (ρB : Γ →* (B ≃ₐ[A] B))

/-- The semilinear action of `Γ` on the polynomial ring `B[X]` through its coefficients, fixing the
indeterminate `X`. -/
def polynomialCoefficientAction : Γ →* RingAut B[X] where
  toFun γ := Polynomial.mapEquiv (ρB γ).toRingEquiv
  map_one' := by
    ext p n
    simp [map_one ρB]
  map_mul' γ δ := by
    ext p n
    simp [map_mul ρB]

/-- `polynomialCoefficientAction` acts on constant polynomials `C b` through `ρB`. -/
@[simp]
theorem polynomialCoefficientAction_C (γ : Γ) (b : B) :
    polynomialCoefficientAction ρB γ (Polynomial.C b) = Polynomial.C (ρB γ b) := by
  simp [polynomialCoefficientAction]

/-- `polynomialCoefficientAction` fixes the indeterminate `X`. -/
@[simp]
theorem polynomialCoefficientAction_X (γ : Γ) :
    polynomialCoefficientAction ρB γ Polynomial.X = Polynomial.X := by
  simp [polynomialCoefficientAction]

/-- Semilinearity of `polynomialCoefficientAction` over `ρB`. -/
theorem polynomialCoefficientAction_algebraMap (γ : Γ) (b : B) :
    polynomialCoefficientAction ρB γ (algebraMap B B[X] b) = algebraMap B B[X] (ρB γ b) := by
  simp

/-- A `B`-algebra map `y : B[X] →ₐ[B] B ⊗[A] T` is `Γ`-equivariant for the coefficient action if
and only if `y X` is fixed by every `ρB γ ⊗ id_T`. -/
theorem polynomialCoefficientAction_equivariant_iff {T : Type*} [CommRing T] [Algebra A T]
    (y : B[X] →ₐ[B] B ⊗[A] T) :
    (∀ (γ : Γ) (p : B[X]), y (polynomialCoefficientAction ρB γ p) =
        Algebra.TensorProduct.rTensor T (ρB γ : B →ₐ[A] B) (y p)) ↔
      ∀ γ : Γ, Algebra.TensorProduct.rTensor T (ρB γ : B →ₐ[A] B) (y Polynomial.X) =
        y Polynomial.X := by
  constructor
  · intro hy γ
    simpa using (hy γ Polynomial.X).symm
  · intro hX γ
    have hHom : y.toRingHom.comp (polynomialCoefficientAction ρB γ : B[X] →+* B[X]) =
        (Algebra.TensorProduct.rTensor T (ρB γ : B →ₐ[A] B)).toRingHom.comp y.toRingHom := by
      ext b
      · simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_comp, RingHom.coe_coe,
          Function.comp_apply, polynomialCoefficientAction_C]
        rw [← Polynomial.algebraMap_eq, y.commutes, y.commutes]
        simp
      · simpa using (hX γ).symm
    intro p
    exact DFunLike.congr_fun hHom p

-- Under `|Γ| ∈ Aˣ`, injectivity of `A → B`, and `B^Γ = A`, Reynolds averaging retracts `B` onto `A`
-- as an `A`-module.
private def reynoldsBaseProj {Γ : Type*} [Group Γ] [Fintype Γ] (ρB : Γ →* (B ≃ₐ[A] B))
    (u : Aˣ) (hinj : Function.Injective (algebraMap A B))
    (hinv : ∀ b : B, (∀ γ : Γ, ρB γ b = b) → b ∈ Set.range (algebraMap A B)) :
    B →ₗ[A] A :=
  let avg : B →ₗ[A] B := (↑u⁻¹ : A) • ∑ γ : Γ, (ρB γ).toAlgHom.toLinearMap
  have hmem (b : B) : avg b ∈ LinearMap.range (Algebra.linearMap A B) :=
    hinv (avg b) fun φ ↦ by
      simp only [avg, LinearMap.smul_apply, LinearMap.sum_apply, AlgHom.toLinearMap_apply,
        AlgEquiv.coe_toAlgHom, map_smul, map_sum, ← AlgEquiv.mul_apply, ← map_mul]
      congr 1
      exact Fintype.sum_equiv (Equiv.mulLeft φ) _ _ fun _ ↦ rfl
  (LinearEquiv.ofInjective (Algebra.linearMap A B) hinj).symm.toLinearMap.comp
    (avg.codRestrict (LinearMap.range (Algebra.linearMap A B)) hmem)

private theorem algebraMap_reynoldsBaseProj {Γ : Type*} [Group Γ] [Fintype Γ]
    (ρB : Γ →* (B ≃ₐ[A] B)) (u : Aˣ) (hinj : Function.Injective (algebraMap A B))
    (hinv : ∀ b : B, (∀ γ : Γ, ρB γ b = b) → b ∈ Set.range (algebraMap A B)) (b : B) :
    algebraMap A B (reynoldsBaseProj ρB u hinj hinv b) =
      (↑u⁻¹ : A) • ∑ γ : Γ, ρB γ b := by
  have key (c : LinearMap.range (Algebra.linearMap A B)) :
      algebraMap A B ((LinearEquiv.ofInjective (Algebra.linearMap A B) hinj).symm c) = c.1 :=
    congrArg Subtype.val ((LinearEquiv.ofInjective (Algebra.linearMap A B) hinj).apply_symm_apply c)
  unfold reynoldsBaseProj
  rw [LinearMap.comp_apply, LinearEquiv.coe_coe, key]
  simp

private theorem reynoldsBaseProj_algebraMap {Γ : Type*} [Group Γ] [Fintype Γ]
    (ρB : Γ →* (B ≃ₐ[A] B)) (u : Aˣ) (hu : (u : A) = (Fintype.card Γ : A))
    (hinj : Function.Injective (algebraMap A B))
    (hinv : ∀ b : B, (∀ γ : Γ, ρB γ b = b) → b ∈ Set.range (algebraMap A B)) (a : A) :
    reynoldsBaseProj ρB u hinj hinv (algebraMap A B a) = a := by
  have hunit : (↑u⁻¹ : A) * (Fintype.card Γ : A) = 1 := by
    rw [← hu, Units.inv_mul]
  apply hinj
  rw [algebraMap_reynoldsBaseProj ρB u hinj hinv]
  simp only [AlgEquiv.commutes, Finset.sum_const, Finset.card_univ,
    ← Nat.cast_smul_eq_nsmul A, smul_smul, hunit, one_smul]

-- Retract `B ⊗[A] T` onto `T` via `reynoldsBaseProj ⊗ id_T`; it splits `includeRight` and recovers
-- any `Γ`-invariant tensor.
private def reynoldsTensorProj {Γ : Type*} [Group Γ] [Fintype Γ] (ρB : Γ →* (B ≃ₐ[A] B))
    (u : Aˣ) (hinj : Function.Injective (algebraMap A B))
    (hinv : ∀ b : B, (∀ γ : Γ, ρB γ b = b) → b ∈ Set.range (algebraMap A B))
    (T : Type*) [CommRing T] [Algebra A T] : B ⊗[A] T →ₗ[A] T :=
  (TensorProduct.lid A T).toLinearMap.comp ((reynoldsBaseProj ρB u hinj hinv).rTensor T)

private theorem reynoldsTensorProj_includeRight {Γ : Type*} [Group Γ] [Fintype Γ]
    (ρB : Γ →* (B ≃ₐ[A] B)) (u : Aˣ) (hu : (u : A) = (Fintype.card Γ : A))
    (hinj : Function.Injective (algebraMap A B))
    (hinv : ∀ b : B, (∀ γ : Γ, ρB γ b = b) → b ∈ Set.range (algebraMap A B))
    {T : Type*} [CommRing T] [Algebra A T] (t : T) :
    reynoldsTensorProj ρB u hinj hinv T (Algebra.TensorProduct.includeRight t) = t := by
  rw [Algebra.TensorProduct.includeRight_apply, reynoldsTensorProj, LinearMap.comp_apply,
    LinearMap.rTensor_tmul, LinearEquiv.coe_coe, TensorProduct.lid_tmul,
    ← map_one (algebraMap A B), reynoldsBaseProj_algebraMap ρB u hu hinj hinv, one_smul]

private theorem includeRight_injective {Γ : Type*} [Group Γ] [Fintype Γ]
    (ρB : Γ →* (B ≃ₐ[A] B)) (u : Aˣ) (hu : (u : A) = (Fintype.card Γ : A))
    (hinj : Function.Injective (algebraMap A B))
    (hinv : ∀ b : B, (∀ γ : Γ, ρB γ b = b) → b ∈ Set.range (algebraMap A B))
    (T : Type*) [CommRing T] [Algebra A T] :
    Function.Injective (Algebra.TensorProduct.includeRight : T →ₐ[A] B ⊗[A] T) :=
  Function.LeftInverse.injective (reynoldsTensorProj_includeRight ρB u hu hinj hinv)

private theorem includeRight_reynoldsTensorProj_of_fixed {Γ : Type*} [Group Γ] [Fintype Γ]
    (ρB : Γ →* (B ≃ₐ[A] B)) (u : Aˣ) (hu : (u : A) = (Fintype.card Γ : A))
    (hinj : Function.Injective (algebraMap A B))
    (hinv : ∀ b : B, (∀ γ : Γ, ρB γ b = b) → b ∈ Set.range (algebraMap A B))
    {T : Type*} [CommRing T] [Algebra A T] {z : B ⊗[A] T}
    (hz : ∀ γ : Γ, Algebra.TensorProduct.rTensor T (ρB γ : B →ₐ[A] B) z = z) :
    Algebra.TensorProduct.includeRight (reynoldsTensorProj ρB u hinj hinv T z) = z := by
  have hunit : (↑u⁻¹ : A) * (Fintype.card Γ : A) = 1 := by
    rw [← hu, Units.inv_mul]
  let lhs : B ⊗[A] T →ₗ[A] B ⊗[A] T :=
    Algebra.TensorProduct.includeRight.toLinearMap.comp (reynoldsTensorProj ρB u hinj hinv T)
  let rhs : B ⊗[A] T →ₗ[A] B ⊗[A] T :=
    (↑u⁻¹ : A) • ∑ γ : Γ, (Algebra.TensorProduct.rTensor T (ρB γ : B →ₐ[A] B)).toLinearMap
  have hEq : lhs = rhs := by
    ext b t
    calc
      lhs (b ⊗ₜ[A] t)
          = 1 ⊗ₜ[A] (reynoldsBaseProj ρB u hinj hinv b • t) := by
              simp [lhs, reynoldsTensorProj]
      _ = algebraMap A B (reynoldsBaseProj ρB u hinj hinv b) ⊗ₜ[A] t := by
            rw [← TensorProduct.smul_tmul, Algebra.algebraMap_eq_smul_one]
      _ = ((↑u⁻¹ : A) • ∑ γ : Γ, ρB γ b) ⊗ₜ[A] t := by
            rw [algebraMap_reynoldsBaseProj ρB u hinj hinv b]
      _ = (↑u⁻¹ : A) • ∑ γ : Γ, (ρB γ b ⊗ₜ[A] t) := by
            rw [← TensorProduct.smul_tmul', TensorProduct.sum_tmul]
      _ = rhs (b ⊗ₜ[A] t) := by
            simp [rhs]
  calc
    Algebra.TensorProduct.includeRight (reynoldsTensorProj ρB u hinj hinv T z)
        = lhs z := rfl
    _ = rhs z := DFunLike.congr_fun hEq z
    _ = (↑u⁻¹ : A) • ∑ _γ : Γ, z := by
          simp only [rhs, LinearMap.smul_apply, LinearMap.sum_apply, AlgHom.toLinearMap_apply, hz]
    _ = z := by
          simp only [Finset.sum_const, Finset.card_univ, ← Nat.cast_smul_eq_nsmul A, smul_smul,
            hunit, one_smul]

private def toPolynomialAlgHom [Module.Finite A B] [Module.Projective A B]
    {Γ : Type*} [Monoid Γ] (ρB : Γ →* (B ≃ₐ[A] B)) :
    fixedCoordinateRing ρB (polynomialCoefficientAction ρB)
        (polynomialCoefficientAction_algebraMap ρB) →ₐ[A] A[X] :=
  (fixedHomEquiv ρB (polynomialCoefficientAction ρB)
    (polynomialCoefficientAction_algebraMap ρB) A[X]).symm
    ⟨Polynomial.aeval (Algebra.TensorProduct.includeRight Polynomial.X),
      (polynomialCoefficientAction_equivariant_iff ρB _).mpr fun _ ↦ by
        simp [Algebra.TensorProduct.includeRight_apply]⟩

private def fromPolynomialAlgHom [Module.Finite A B] [Module.Projective A B]
    {Γ : Type*} [Group Γ] [_root_.Finite Γ] (ρB : Γ →* (B ≃ₐ[A] B))
    (hΓ : IsUnit (Nat.card Γ : A)) (hinj : Function.Injective (algebraMap A B))
    (hinv : ∀ b : B, (∀ γ : Γ, ρB γ b = b) → b ∈ Set.range (algebraMap A B)) :
    A[X] →ₐ[A] fixedCoordinateRing ρB (polynomialCoefficientAction ρB)
        (polynomialCoefficientAction_algebraMap ρB) :=
  let _ : Fintype Γ := Fintype.ofFinite Γ
  Polynomial.aeval
    (reynoldsTensorProj ρB hΓ.unit hinj hinv _
      (fixedUniversalPoint ρB (polynomialCoefficientAction ρB)
        (polynomialCoefficientAction_algebraMap ρB) Polynomial.X))

private theorem lTensor_toPolynomialAlgHom_universalPoint_X
    [Module.Finite A B] [Module.Projective A B] {Γ : Type*} [Monoid Γ] (ρB : Γ →* (B ≃ₐ[A] B)) :
    (Algebra.TensorProduct.lTensor (S := B) B (toPolynomialAlgHom ρB))
        (fixedUniversalPoint ρB (polynomialCoefficientAction ρB)
          (polynomialCoefficientAction_algebraMap ρB) Polynomial.X) =
      Algebra.TensorProduct.includeRight Polynomial.X := by
  have hcomp := fixedHomEquiv_apply ρB (polynomialCoefficientAction ρB)
    (polynomialCoefficientAction_algebraMap ρB) (toPolynomialAlgHom ρB)
  have hX := congrArg (fun f : B[X] →ₐ[B] B ⊗[A] A[X] ↦ f Polynomial.X) hcomp
  have hlhs : (fixedHomEquiv ρB (polynomialCoefficientAction ρB)
      (polynomialCoefficientAction_algebraMap ρB) A[X] (toPolynomialAlgHom ρB)).1 Polynomial.X =
      Algebra.TensorProduct.includeRight Polynomial.X := by
    simp [toPolynomialAlgHom]
  exact hX.symm.trans hlhs

private theorem includeRight_fromPolynomialAlgHom_X [Module.Finite A B] [Module.Projective A B]
    {Γ : Type*} [Group Γ] [_root_.Finite Γ] (ρB : Γ →* (B ≃ₐ[A] B))
    (hΓ : IsUnit (Nat.card Γ : A)) (hinj : Function.Injective (algebraMap A B))
    (hinv : ∀ b : B, (∀ γ : Γ, ρB γ b = b) → b ∈ Set.range (algebraMap A B)) :
    Algebra.TensorProduct.includeRight (fromPolynomialAlgHom ρB hΓ hinj hinv Polynomial.X) =
      fixedUniversalPoint ρB (polynomialCoefficientAction ρB)
        (polynomialCoefficientAction_algebraMap ρB) Polynomial.X := by
  let _ : Fintype Γ := Fintype.ofFinite Γ
  have hu : (hΓ.unit : A) = (Fintype.card Γ : A) := by
    rw [IsUnit.unit_spec, Nat.card_eq_fintype_card]
  have huX := (polynomialCoefficientAction_equivariant_iff ρB _).mp
    (fixedUniversalPoint_equivariant ρB (polynomialCoefficientAction ρB)
      (polynomialCoefficientAction_algebraMap ρB))
  simpa only [fromPolynomialAlgHom, Polynomial.aeval_X] using
    includeRight_reynoldsTensorProj_of_fixed ρB hΓ.unit hu hinj hinv huX

/-- **Tame fixed points of the restricted affine line**: if `B` is finite projective over `A`, `Γ`
is a finite group whose order is invertible in `A`, `A → B` is injective, and `B^Γ = A`, then the
fixed-point subscheme `(Res_{B/A} 𝔸¹_B)^Γ` under the coefficient action on `B[X]` has coordinate
ring canonically isomorphic to `A[X]`. -/
def fixedCoordinateRingPolynomialEquiv [Module.Finite A B] [Module.Projective A B]
    {Γ : Type*} [Group Γ] [_root_.Finite Γ] (ρB : Γ →* (B ≃ₐ[A] B))
    (hΓ : IsUnit (Nat.card Γ : A)) (hinj : Function.Injective (algebraMap A B))
    (hinv : ∀ b : B, (∀ γ : Γ, ρB γ b = b) → b ∈ Set.range (algebraMap A B)) :
    fixedCoordinateRing ρB (polynomialCoefficientAction ρB)
        (polynomialCoefficientAction_algebraMap ρB) ≃ₐ[A] A[X] :=
  AlgEquiv.ofAlgHom (toPolynomialAlgHom ρB) (fromPolynomialAlgHom ρB hΓ hinj hinv)
    (by
      let _ : Fintype Γ := Fintype.ofFinite Γ
      have hu : (hΓ.unit : A) = (Fintype.card Γ : A) := by
        rw [IsUnit.unit_spec, Nat.card_eq_fintype_card]
      apply Polynomial.algHom_ext
      apply includeRight_injective ρB hΓ.unit hu hinj hinv A[X]
      rw [AlgHom.comp_apply, AlgHom.id_apply, ← lTensor_toPolynomialAlgHom_universalPoint_X ρB,
        ← includeRight_fromPolynomialAlgHom_X ρB hΓ hinj hinv]
      simp [Algebra.TensorProduct.includeRight_apply])
    (by
      apply (fixedHomEquiv ρB (polynomialCoefficientAction ρB)
        (polynomialCoefficientAction_algebraMap ρB) _).injective
      apply Subtype.ext
      apply Polynomial.algHom_ext
      have hlTensor (z : _) :
          Algebra.TensorProduct.lTensor (S := B) B
            ((fromPolynomialAlgHom ρB hΓ hinj hinv).comp (toPolynomialAlgHom ρB)) z =
          Algebra.TensorProduct.lTensor (S := B) B (fromPolynomialAlgHom ρB hΓ hinj hinv)
            (Algebra.TensorProduct.lTensor (S := B) B (toPolynomialAlgHom ρB) z) := by
        induction z using TensorProduct.inductionOn with
        | tmul b r => rfl
        | add x y hx hy => simp [hx, hy]
      rw [fixedHomEquiv_apply, fixedHomEquiv_apply, AlgHom.comp_apply, AlgHom.comp_apply,
        hlTensor, lTensor_toPolynomialAlgHom_universalPoint_X]
      simpa [Algebra.TensorProduct.includeRight_apply] using
        includeRight_fromPolynomialAlgHom_X ρB hΓ hinj hinv)

/-- Under the universal property `fixedHomEquiv`, `fixedCoordinateRingPolynomialEquiv` classifies
the canonical `Γ`-equivariant map `B[X] →ₐ[B] B ⊗[A] A[X]` sending `X` to `1 ⊗ₜ X`. -/
theorem fixedHomEquiv_fixedCoordinateRingPolynomialEquiv
    [Module.Finite A B] [Module.Projective A B]
    {Γ : Type*} [Group Γ] [_root_.Finite Γ] (ρB : Γ →* (B ≃ₐ[A] B))
    (hΓ : IsUnit (Nat.card Γ : A)) (hinj : Function.Injective (algebraMap A B))
    (hinv : ∀ b : B, (∀ γ : Γ, ρB γ b = b) → b ∈ Set.range (algebraMap A B)) :
    (fixedHomEquiv ρB (polynomialCoefficientAction ρB)
        (polynomialCoefficientAction_algebraMap ρB) A[X]
        (fixedCoordinateRingPolynomialEquiv ρB hΓ hinj hinv).toAlgHom).1 =
      Polynomial.aeval (Algebra.TensorProduct.includeRight Polynomial.X) := by
  have hcoe : (fixedCoordinateRingPolynomialEquiv ρB hΓ hinj hinv).toAlgHom =
      toPolynomialAlgHom ρB := by
    rw [fixedCoordinateRingPolynomialEquiv]
    ext x
    rfl
  rw [hcoe, toPolynomialAlgHom]
  exact congrArg Subtype.val ((fixedHomEquiv ρB (polynomialCoefficientAction ρB)
    (polynomialCoefficientAction_algebraMap ρB) A[X]).apply_symm_apply _)

end TameAffineLine

end TauCeti.Algebra.WeilRestriction
