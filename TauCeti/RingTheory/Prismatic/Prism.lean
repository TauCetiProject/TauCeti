public import Mathlib.RingTheory.PicardGroup
public import TauCeti.RingTheory.AdicCompletion.DerivedComplete.Module
public import TauCeti.RingTheory.DeltaRing.Basic

/-!
# Prisms

Fix a prime `p`. A *prism* (Bhatt and Scholze, Definition 3.2) is a `δ`-ring `B` together with an
ideal `J` such that

* `J` defines an effective Cartier divisor on `Spec B`: it is an invertible `B`-module
  (`Module.Invertible B J`), which for an ideal says that `J` is locally generated by a
  nonzerodivisor;
* `B` is derived `(p, J)`-complete;
* `p ∈ J + φ(J) B`, where `φ` is the Frobenius lift of the `δ`-structure.

A prism is *bounded* if `B ⧸ J` has bounded `p`-power torsion, and *perfect* if `φ` is bijective.
Perfectness is a property of the `δ`-ring alone (`TauCeti.DeltaRing.IsPerfect`).

Derived completeness puts `p` and `J` in the Jacobson radical of `B`
(`TauCeti.Prism.natCast_mem_jacobson`, `TauCeti.Prism.ideal_le_jacobson`), through the general
fact that a ring derived complete for an ideal `I` has `I` in its Jacobson radical
(`TauCeti.IsDerivedComplete.le_jacobson`). This is the input used to make distinguished
elements unique up to units in the rigidity of maps of prisms (Bhatt and Scholze, Lemma 3.5).

## Main definitions

* `TauCeti.Prism p B`: a prism structure on the `δ`-ring `B`.
* `TauCeti.Prism.IsBounded`: `B ⧸ J` has bounded `p`-power torsion.

## Main results

* `TauCeti.Prism.natCast_mem_jacobson` and `TauCeti.Prism.ideal_le_jacobson`: `p` and `J`
  lie in the Jacobson radical of `B`.
* `TauCeti.Prism.isBounded_of_isLeftRegular` and `TauCeti.Prism.isBounded_of_pow_eq_zero`:
  a prism is bounded if `B ⧸ J` has no `p`-torsion, or if a power of `p` vanishes in `B ⧸ J`.

## References

* B. Bhatt and P. Scholze, *Prisms and prismatic cohomology*, Ann. of Math. 196 (2022), §3,
  Definition 3.2 and Lemma 3.5.
-/

public section

namespace TauCeti

open DeltaRing

variable (p : ℕ) [Fact p.Prime] (B : Type*) [CommRing B] [DeltaRing p B]

/-- A **prism** structure on a `δ`-ring `B` (Bhatt and Scholze, Definition 3.2): an ideal `J` of
`B` defining an effective Cartier divisor (an invertible `B`-module), such that `B` is derived
`(p, J)`-complete and `p ∈ J + φ(J) B` for the Frobenius lift `φ`. -/
@[ext]
structure Prism where
  /-- The ideal `J` of the prism. -/
  ideal : Ideal B
  /-- `J` defines an effective Cartier divisor: it is an invertible `B`-module. -/
  invertible : Module.Invertible B ideal
  /-- `B` is derived `(p, J)`-complete. -/
  isDerivedComplete : IsDerivedComplete (Ideal.span {(p : B)} ⊔ ideal) B
  /-- `p ∈ J + φ(J) B`. -/
  natCast_mem_sup : (p : B) ∈ ideal ⊔ ideal.map (frobenius p B)

namespace Prism

variable {p B} (P : Prism p B)

/-- The ideal of a prism is an invertible module. -/
instance instInvertibleIdeal : Module.Invertible B P.ideal :=
  P.invertible

/-- A prism `(B, J)` is **bounded** if `B ⧸ J` has bounded `p`-power torsion: some power `p ^ n`
kills every element of `B ⧸ J` killed by a power of `p`. -/
def IsBounded : Prop :=
  ∃ n : ℕ, ∀ x : B ⧸ P.ideal, (∃ m : ℕ, (p : B ⧸ P.ideal) ^ m * x = 0) →
    (p : B ⧸ P.ideal) ^ n * x = 0

theorem isBounded_iff : P.IsBounded ↔ ∃ n : ℕ, ∀ x : B ⧸ P.ideal,
    (∃ m : ℕ, (p : B ⧸ P.ideal) ^ m * x = 0) → (p : B ⧸ P.ideal) ^ n * x = 0 :=
  Iff.rfl

/-- A prism `(B, J)` with `B ⧸ J` free of `p`-torsion is bounded. -/
theorem isBounded_of_isLeftRegular (h : IsLeftRegular (p : B ⧸ P.ideal)) : P.IsBounded :=
  ⟨0, fun x ⟨m, hm⟩ ↦ by
    simpa using (h.pow m) (hm.trans (mul_zero _).symm)⟩

/-- A prism `(B, J)` in which some power of `p` vanishes in `B ⧸ J` is bounded. -/
theorem isBounded_of_pow_eq_zero {n : ℕ} (h : (p : B ⧸ P.ideal) ^ n = 0) : P.IsBounded :=
  ⟨n, fun x _ ↦ by rw [h, zero_mul]⟩

/-- **The ideal of a prism lies in the Jacobson radical.** -/
theorem ideal_le_jacobson : P.ideal ≤ Ring.jacobson B :=
  le_sup_right.trans (IsDerivedComplete.le_jacobson P.isDerivedComplete)

/-- **`p` lies in the Jacobson radical of a prism.** -/
theorem natCast_mem_jacobson (P : Prism p B) : (p : B) ∈ Ring.jacobson B :=
  IsDerivedComplete.le_jacobson P.isDerivedComplete
    (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))

end Prism

end TauCeti
