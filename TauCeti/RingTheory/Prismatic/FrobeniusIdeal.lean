/-!
# The Frobenius ideals `I_r = ∏_{s < r} φ^s(I) A`

Let `A` be a commutative ring with a ring endomorphism `φ` and an ideal `I`; the case of interest
is a prism `(A, I)` with its Frobenius lift. For `r ≥ 0` put
`I_r = I · φ(I) A · φ^2(I) A ⋯ φ^(r - 1)(I) A`, the product of the ideals `φ^s(I) A` generated by
the images of `I` under the iterates of `φ`. These ideals form a decreasing chain starting at
`I_0 = A` and `I_1 = I`. Their conormal modules `I_r / I_r ^ 2`, with the transition maps divided
by `p`, define the Breuil–Kisin twist `A{1} = lim_r I_r / I_r ^ 2` of a transversal prism, and the
relation `I_(r + 1) = I · φ(I_r) A` is the one behind its Frobenius.

The ideals `I_r` are compatible with maps intertwining the endomorphisms, and for a principal
ideal `(d)` they are the principal ideals `(d · φ(d) ⋯ φ^(r - 1)(d))`. When `φ` lifts Frobenius
modulo `p`, so that `φ^s(x) ≡ x ^ (p ^ s)`, the image of `I_r` modulo `p` lies in the
`(1 + p + ⋯ + p ^ (r - 1))`-th power of the image of `I`, with equality for principal ideals, and
`φ^r(I) A ⊆ I_r + (p)`.

On the `q`-de Rham prism, where `φ(q) = q ^ p` and `I = ([p]_q)` with
`[n]_q = 1 + q + ⋯ + q ^ (n - 1)`, one has `φ^s([p]_q) = [p]_(q ^ (p ^ s))` and the product
telescopes: `I_r = ([p ^ r]_q)`. Moreover `[p ^ (r + 1)]_q ≡ p [p ^ r]_q` modulo `I_r ^ 2`, so the
classes of the `[p ^ r]_q` in `I_r / I_r ^ 2` are compatible under the transition maps divided by
`p`, which is how they define a generator of the Breuil–Kisin twist of the `q`-de Rham prism. Here
`[n]_q` is written as the finite sum `∑ i ∈ range n, q ^ i`.

## Main definitions

* `TauCeti.Prismatic.BKTwist.frobeniusIdeal`: the ideal `φ^r(I) A`.
* `TauCeti.Prismatic.BKTwist.Ir`: the ideal `I_r = ∏_{s < r} φ^s(I) A`.

## Main results

* `TauCeti.Prismatic.BKTwist.Ir_add`: `I_(r + s) = I_r · (φ^r(I) A)_s`.
* `TauCeti.Prismatic.BKTwist.Ir_succ'`: `I_(r + 1) = I · φ(I_r) A`.
* `TauCeti.Prismatic.BKTwist.Ir_map`: for `f ∘ φ = ψ ∘ f`, `(f(I) B)_r = f(I_r) B`.
* `TauCeti.Prismatic.BKTwist.Ir_span_singleton`: `(d)_r = (∏_{s < r} φ^s(d))`.
* `TauCeti.Prismatic.BKTwist.map_Ir_le_pow` and
  `TauCeti.Prismatic.BKTwist.map_Ir_span_singleton`: `I_r` modulo `p` for a Frobenius lift.
* `TauCeti.Prismatic.BKTwist.map_frobeniusIdeal_le_map_Ir`: `φ^r(I) A ⊆ I_r + (p)` for a
  Frobenius lift.
* `TauCeti.Prismatic.BKTwist.Ir_span_geom_sum`: `([p]_q)_r = ([p ^ r]_q)` when `φ(q) = q ^ p`.
* `TauCeti.Prismatic.BKTwist.geom_sum_pow_succ_sub_mem_Ir_sq`:
  `[p ^ (r + 1)]_q - p [p ^ r]_q ∈ I_r ^ 2` for `I = ([p]_q)`.

## References

* B. Bhatt and J. Lurie, *Absolute prismatic cohomology*, arXiv:2201.06120, §2.2 and
  Proposition 2.6.1.
-/

public section

namespace TauCeti.Prismatic.BKTwist

open Ideal Finset

section CommSemiring

variable {A : Type*} [CommSemiring A] (φ : A →+* A) (I : Ideal A)

/-- The ideal `φ^r(I) A` of `A` generated by the image of the ideal `I` under the `r`-th iterate
of the ring endomorphism `φ`. -/
def frobeniusIdeal (r : ℕ) : Ideal A :=
  I.map (φ ^ r)

theorem frobeniusIdeal_def (r : ℕ) : frobeniusIdeal φ I r = I.map (φ ^ r) := (rfl)

/-- `φ^0(I) A = I`. -/
@[simp]
theorem frobeniusIdeal_zero : frobeniusIdeal φ I 0 = I := by
  rw [frobeniusIdeal_def, pow_zero]
  exact map_id I

/-- `φ^1(I) A = φ(I) A`. -/
theorem frobeniusIdeal_one : frobeniusIdeal φ I 1 = I.map φ := by
  simp [frobeniusIdeal_def]

/-- `φ^(r + s)(I) A` is the ideal `φ^s(φ^r(I) A) A`. -/
theorem frobeniusIdeal_add (r s : ℕ) :
    frobeniusIdeal φ I (r + s) = frobeniusIdeal φ (frobeniusIdeal φ I r) s := by
  rw [frobeniusIdeal_def, frobeniusIdeal_def, frobeniusIdeal_def, Ideal.map_map, pow_add,
    (Commute.pow_pow_self φ r s).eq, RingHom.mul_def]

/-- `φ^(r + 1)(I) A = φ(φ^r(I) A) A`. -/
theorem frobeniusIdeal_succ (r : ℕ) :
    frobeniusIdeal φ I (r + 1) = (frobeniusIdeal φ I r).map φ := by
  rw [frobeniusIdeal_add, frobeniusIdeal_one]

/-- The image of an element of `I` under `φ^r` lies in `φ^r(I) A`. -/
theorem pow_apply_mem_frobeniusIdeal {x : A} (hx : x ∈ I) (r : ℕ) :
    (φ ^ r) x ∈ frobeniusIdeal φ I r :=
  mem_map_of_mem _ hx

variable {I} in
/-- `φ^r(I) A` is monotone in `I`. -/
theorem frobeniusIdeal_mono {J : Ideal A} (h : I ≤ J) (r : ℕ) :
    frobeniusIdeal φ I r ≤ frobeniusIdeal φ J r :=
  map_mono h

/-- `φ^r` of the ideal generated by a set is generated by the image of the set. -/
theorem frobeniusIdeal_span (s : Set A) (r : ℕ) :
    frobeniusIdeal φ (span s) r = span ((φ ^ r) '' s) :=
  map_span _ _

/-- `φ^r((d)) A = (φ^r(d))`. -/
@[simp]
theorem frobeniusIdeal_span_singleton (d : A) (r : ℕ) :
    frobeniusIdeal φ (span {d}) r = span {(φ ^ r) d} := by
  rw [frobeniusIdeal_span, Set.image_singleton]

/-- The ideal `I_r = I · φ(I) A ⋯ φ^(r - 1)(I) A`, the product of the ideals `φ^s(I) A` for
`s < r`. -/
def Ir (r : ℕ) : Ideal A :=
  ∏ s ∈ range r, frobeniusIdeal φ I s

theorem Ir_def (r : ℕ) : Ir φ I r = ∏ s ∈ range r, frobeniusIdeal φ I s := (rfl)

/-- `I_0 = A`. -/
@[simp]
theorem Ir_zero : Ir φ I 0 = ⊤ := by
  simp [Ir_def]

/-- `I_1 = I`. -/
@[simp]
theorem Ir_one : Ir φ I 1 = I := by
  simp [Ir_def]

/-- `I_(r + 1) = I_r · φ^r(I) A`. -/
theorem Ir_succ (r : ℕ) : Ir φ I (r + 1) = Ir φ I r * frobeniusIdeal φ I r :=
  prod_range_succ _ _

/-- `I_(r + s) = I_r · J_s` for `J = φ^r(I) A`. -/
theorem Ir_add (r s : ℕ) : Ir φ I (r + s) = Ir φ I r * Ir φ (frobeniusIdeal φ I r) s := by
  simp only [Ir_def, prod_range_add, frobeniusIdeal_add]

/-- The ideals `I_r` decrease: `I_(r + 1) ⊆ I_r`. -/
theorem Ir_succ_le (r : ℕ) : Ir φ I (r + 1) ≤ Ir φ I r := by
  rw [Ir_succ]
  exact Ideal.mul_le_left

/-- The ideals `I_r` form a decreasing chain. -/
theorem Ir_antitone : Antitone (Ir φ I) :=
  antitone_nat_of_succ_le (Ir_succ_le φ I)

/-- `I_r ⊆ φ^s(I) A` for `s < r`. -/
theorem Ir_le_frobeniusIdeal {r s : ℕ} (h : s < r) : Ir φ I r ≤ frobeniusIdeal φ I s :=
  prod_le_inf.trans (inf_le (mem_range.2 h))

/-- `I_r` lies in the intersection of the ideals `φ^s(I) A` for `s < r`. -/
theorem Ir_le_iInf (r : ℕ) : Ir φ I r ≤ ⨅ s < r, frobeniusIdeal φ I s :=
  le_iInf₂ fun _ h => Ir_le_frobeniusIdeal φ I h

/-- `I_r ⊆ I` for `r > 0`. -/
theorem Ir_le {r : ℕ} (hr : 0 < r) : Ir φ I r ≤ I :=
  (Ir_le_frobeniusIdeal φ I hr).trans_eq (frobeniusIdeal_zero φ I)

variable {I} in
/-- `I_r` is monotone in `I`. -/
theorem Ir_mono {J : Ideal A} (h : I ≤ J) (r : ℕ) : Ir φ I r ≤ Ir φ J r :=
  prod_le_prod fun s _ => frobeniusIdeal_mono φ h s

/-- For `x ∈ I`, the product `x · φ(x) ⋯ φ^(r - 1)(x)` lies in `I_r`. -/
theorem prod_pow_apply_mem_Ir {x : A} (hx : x ∈ I) (r : ℕ) :
    ∏ s ∈ range r, (φ ^ s) x ∈ Ir φ I r :=
  prod_mem_prod fun s _ => pow_apply_mem_frobeniusIdeal φ I hx s

/-- For a principal ideal, `(d)_r = (d · φ(d) ⋯ φ^(r - 1)(d))`. -/
@[simp]
theorem Ir_span_singleton (d : A) (r : ℕ) :
    Ir φ (span {d}) r = span {∏ s ∈ range r, (φ ^ s) d} := by
  simp [Ir_def, prod_span_singleton]

section Map

variable {B : Type*} [CommSemiring B] {ψ : B →+* B} {f : A →+* B}

/-- Ring maps intertwining the endomorphisms carry `φ^r(I) A` to `ψ^r(f(I) B) B`. -/
theorem frobeniusIdeal_map (hf : f.comp φ = ψ.comp f) (r : ℕ) :
    frobeniusIdeal ψ (I.map f) r = (frobeniusIdeal φ I r).map f := by
  have h : (ψ ^ r).comp f = f.comp (φ ^ r) := by
    ext x
    simpa using (Function.Semiconj.iterate_right (fun y => RingHom.congr_fun hf y) r x).symm
  rw [frobeniusIdeal_def, frobeniusIdeal_def, Ideal.map_map, Ideal.map_map, h]

/-- Ring maps intertwining the endomorphisms carry `I_r` to `J_r` for `J = f(I) B`. -/
theorem Ir_map (hf : f.comp φ = ψ.comp f) (r : ℕ) : Ir ψ (I.map f) r = (Ir φ I r).map f := by
  rw [Ir_def, Ir_def, map_finset_prod]
  exact prod_congr rfl fun s _ => frobeniusIdeal_map φ I hf s

end Map

/-- `I_(r + 1) = I · φ(I_r) A`. -/
theorem Ir_succ' (r : ℕ) : Ir φ I (r + 1) = I * (Ir φ I r).map φ := by
  rw [add_comm, Ir_add, Ir_one, frobeniusIdeal_one, Ir_map φ I rfl]

end CommSemiring

section FrobeniusLift

variable {A : Type*} [CommRing A] {p : ℕ} {φ : A →+* A} (I : Ideal A)

/-- For a Frobenius lift, `φ^r(I) A` modulo `p` lies in the `p ^ r`-th power of `I` modulo `p`. -/
theorem map_frobeniusIdeal_le_pow (hφ : DeltaRing.IsFrobeniusLift p φ) (r : ℕ) :
    (frobeniusIdeal φ I r).map (Ideal.Quotient.mk (span {(p : A)})) ≤
      I.map (Ideal.Quotient.mk (span {(p : A)})) ^ p ^ r := by
  rw [frobeniusIdeal_def, Ideal.map_map, map_le_iff_le_comap]
  intro x hx
  rw [mem_comap, RingHom.comp_apply, hφ.mk_pow_apply]
  exact pow_mem_pow (mem_map_of_mem _ hx) _

/-- For a Frobenius lift, `I_r` modulo `p` lies in the `(1 + p + ⋯ + p ^ (r - 1))`-th power of
`I` modulo `p`. -/
theorem map_Ir_le_pow (hφ : DeltaRing.IsFrobeniusLift p φ) (r : ℕ) :
    (Ir φ I r).map (Ideal.Quotient.mk (span {(p : A)})) ≤
      I.map (Ideal.Quotient.mk (span {(p : A)})) ^ ∑ s ∈ range r, p ^ s := by
  rw [Ir_def, map_finset_prod, ← prod_pow_eq_pow_sum]
  exact prod_le_prod fun s _ => map_frobeniusIdeal_le_pow I hφ s

/-- For a Frobenius lift and a principal ideal `(d)`, `(d)_r` modulo `p` is the
`(1 + p + ⋯ + p ^ (r - 1))`-th power of `(d)` modulo `p`. -/
theorem map_Ir_span_singleton (hφ : DeltaRing.IsFrobeniusLift p φ) (d : A) (r : ℕ) :
    (Ir φ (span {d}) r).map (Ideal.Quotient.mk (span {(p : A)})) =
      (span {d}).map (Ideal.Quotient.mk (span {(p : A)})) ^ ∑ s ∈ range r, p ^ s := by
  rw [Ir_span_singleton, map_span, map_span, Set.image_singleton, Set.image_singleton,
    span_singleton_pow, hφ.mk_prod_pow_apply]

/-- For a Frobenius lift, `φ^r(I) A ⊆ I_r + (p)`, stated as an inclusion of the images
modulo `p`. -/
theorem map_frobeniusIdeal_le_map_Ir (hφ : DeltaRing.IsFrobeniusLift p φ) (r : ℕ) :
    (frobeniusIdeal φ I r).map (Ideal.Quotient.mk (span {(p : A)})) ≤
      (Ir φ I r).map (Ideal.Quotient.mk (span {(p : A)})) := by
  rcases lt_or_ge p 2 with hp | hp
  · -- For `p < 2` the quotient `A / (p)` is the zero ring.
    have htop : span {(p : A)} = ⊤ := by
      interval_cases p
      · -- For `p = 0`, `φ(0) = 0 ^ 0 = 1` forces `A` to be the zero ring.
        have h01 : (0 : A) = 1 := by simpa [sub_eq_zero, eq_comm] using hφ.dvd_sub_pow 0
        rw [eq_top_iff_one, ← h01]
        exact zero_mem _
      · simp
    have : Subsingleton (A ⧸ span {(p : A)}) := Ideal.Quotient.subsingleton_iff.2 htop
    intro x _
    rw [Subsingleton.elim x 0]
    exact zero_mem _
  · -- Modulo `p`, `φ^r(x) = x ^ (p ^ r)` is a multiple of
    -- `x · φ(x) ⋯ φ^(r - 1)(x) = x ^ (1 + p + ⋯ + p ^ (r - 1))`.
    obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le
      (Nat.geomSum_lt hp (s := range r) fun _ hs => mem_range.1 hs).le
    rw [frobeniusIdeal_def, Ideal.map_map, map_le_iff_le_comap]
    intro x hx
    rw [mem_comap, RingHom.comp_apply, hφ.mk_pow_apply, hk, pow_add, ← hφ.mk_prod_pow_apply,
      ← map_pow, ← map_mul]
    exact mem_map_of_mem _ (mul_mem_right _ _ (prod_pow_apply_mem_Ir φ I hx r))

end FrobeniusLift

section QDeRham

variable {A : Type*} [CommSemiring A] {p : ℕ} {φ : A →+* A} {q : A}

/-- If `φ(q) = q ^ p` then for `I = ([p]_q)` one has `I_r = ([p ^ r]_q)`, where
`[n]_q = ∑ i ∈ range n, q ^ i`. -/
theorem Ir_span_geom_sum (hq : φ q = q ^ p) (r : ℕ) :
    Ir φ (span {∑ i ∈ range p, q ^ i}) r = span {∑ i ∈ range (p ^ r), q ^ i} := by
  rw [Ir_span_singleton, prod_pow_apply_geom_sum hq]

end QDeRham

/-- If `φ(q) = q ^ p` and `I = ([p]_q)`, then `[p ^ (r + 1)]_q ≡ p [p ^ r]_q` modulo `I_r ^ 2`,
where `[n]_q = ∑ i ∈ range n, q ^ i`. -/
theorem geom_sum_pow_succ_sub_mem_Ir_sq {A : Type*} [CommRing A] {p : ℕ} {φ : A →+* A} {q : A}
    (hq : φ q = q ^ p) (r : ℕ) :
    ∑ i ∈ range (p ^ (r + 1)), q ^ i - p * ∑ i ∈ range (p ^ r), q ^ i ∈
      Ir φ (span {∑ i ∈ range p, q ^ i}) r ^ 2 := by
  rw [Ir_span_geom_sum hq, span_singleton_pow, mem_span_singleton, pow_succ p r]
  exact sq_geom_sum_dvd_geom_sum_range_mul_sub q _ p

end TauCeti.Prismatic.BKTwist
