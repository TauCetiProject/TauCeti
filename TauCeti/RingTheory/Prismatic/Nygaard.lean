/-!
# The Nygaard filtration and the divided Frobenius

Given a ring map `φ : R →+* S` and a two-sided ideal `J` of `S`, the *Nygaard filtration* on `R`
is the pullback of the `J`-adic filtration along `φ`: its `i`-th step is
`Fil^i_N R = φ⁻¹(J ^ i) = {x | φ x ∈ J ^ i}`. For a prism `(B, J)`, take `φ` to be the Frobenius
lift on `B`; allowing distinct source and target also covers relative Frobenius.
It is a decreasing multiplicative filtration starting at `Fil^0_N R = R`. A commuting square
preserves the filtration when the target-side map preserves the ideals. For `φ = id` it is
`J`-adic, but in general it is not the filtration by powers of `Fil^1_N R`. For a ring equivalence
`φ` and `J = (φ e)` it is `(e)`-adic. When `S` is `J`-adically separated, the intersection of the
steps is the kernel of `φ`. For rings with commutative target, Frobenius restricts to
`Fil^i_N R → J ^ i` and induces an injective semilinear map `gr^i_N R → J ^ i / J ^ (i + 1)`.

For a commutative semiring `B` with endomorphism `φ` and `J = (d)` generated by a nonzerodivisor
`d`, every `x ∈ Fil^i_N B` has a unique `φ_i x` with `d ^ i * φ_i x = φ x`.
This *divided Frobenius* `φ_i = φ / d ^ i` is additive and
`φ`-semilinear, satisfies `φ_(i + j) (x * y) = φ_i x * φ_j y` and `φ_i = d * φ_(i + 1)` on
`Fil^(i + 1)_N B`, and is multiplied by `u⁻¹ ^ i` when `d` is replaced by `u * d` for a unit
`u`. Moreover `φ_i x ∈ (d)` exactly when `x ∈ Fil^(i + 1)_N B`, so `φ_i` induces an injection of
the graded piece `gr^i_N B = Fil^i_N B / Fil^(i + 1)_N B` into `B / (d)`.

## Main definitions

* `TauCeti.Prismatic.Nygaard.fil`: the ideal `Fil^i_N R = φ⁻¹(J ^ i)`.
* `TauCeti.Prismatic.Nygaard.filtration`: the Nygaard filtration as a decreasing multiplicative
  filtration `TauCeti.AlgFiltration`.
* `TauCeti.Prismatic.Nygaard.gr`: the graded piece `Fil^i_N R / Fil^(i + 1)_N R`.
* `TauCeti.Prismatic.Nygaard.frobeniusFil`: the semilinear restriction `Fil^i_N R → J ^ i`.
* `TauCeti.Prismatic.Nygaard.grFrobenius`: the induced map to the `J`-adic graded piece.
* `TauCeti.Prismatic.Nygaard.dividedFrobenius`: the divided Frobenius `φ_i = φ / d ^ i` on
  `Fil^i_N B`, for a nonzerodivisor `d`.
* `TauCeti.Prismatic.Nygaard.grDividedFrobenius`: the map `gr^i_N B → B / (d)` it induces.

## Main results

* `TauCeti.Prismatic.Nygaard.mul_mem_fil`: products add filtration orders.
* `TauCeti.Prismatic.Nygaard.fil_le_comap_fil`: functoriality of the filtration.
* `TauCeti.Prismatic.Nygaard.fil_span_singleton_of_ringEquiv`: for bijective `φ` with `φ e = d`,
  `Fil^i_N R = (e ^ i)`.
* `TauCeti.Prismatic.Nygaard.iInf_fil_eq_ker`: if the powers of `J` intersect in zero, the steps
  intersect in the kernel of `φ`.
* `TauCeti.Prismatic.Nygaard.dividedFrobenius_mul`,
  `TauCeti.Prismatic.Nygaard.dividedFrobenius_succ` and
  `TauCeti.Prismatic.Nygaard.dividedFrobenius_mem_span_singleton_iff`: the multiplicativity,
  transition and divisibility laws of the divided Frobenius.
* `TauCeti.Prismatic.Nygaard.grFrobenius_injective`: the intrinsic graded Frobenius is injective.
* `TauCeti.Prismatic.Nygaard.grDividedFrobenius_injective`: `φ_i` embeds `gr^i_N B` into `B / (d)`.

## References

* B. Bhatt and P. Scholze, *Prisms and prismatic cohomology*, Ann. of Math. 196 (2022),
  Definition 12.1, Theorem 12.2 and Proposition 12.10.
* J. Anschütz and A.-C. Le Bras, *Prismatic Dieudonné theory*, Forum Math. Pi 11 (2023), §3.4.
-/

public section

namespace TauCeti.Prismatic.Nygaard

open Ideal

section Filtration

variable {R S : Type*} [Semiring R] [Semiring S] (φ : R →+* S) (J : Ideal S)

/-- The `i`-th Nygaard ideal consists of elements whose image under `φ` lies in `J ^ i`. -/
def fil (i : ℕ) : Ideal R := (J ^ i).comap φ

/-- The `i`-th Nygaard ideal is the contraction of `J ^ i`. -/
theorem fil_def (i : ℕ) : fil φ J i = (J ^ i).comap φ := (rfl)

/-- The Nygaard filtration `i ↦ φ⁻¹(J ^ i)` is the pullback of the `J`-adic filtration. -/
def filtration [J.IsTwoSided] : AlgFiltration R := J.algFiltration.comap φ

variable {φ J}

/-- The terms of the bundled filtration are the Nygaard ideals. -/
@[simp]
theorem filtration_ideal [J.IsTwoSided] : (filtration φ J).ideal = fil φ J := by
  funext i
  simp only [filtration, AlgFiltration.comap_ideal, Ideal.algFiltration_ideal, fil_def]

/-- Membership in `Fil^i_N R`: `x ∈ Fil^i_N R` exactly when `φ x ∈ J ^ i`. -/
@[simp]
theorem mem_fil_iff {i : ℕ} {x : R} : x ∈ fil φ J i ↔ φ x ∈ J ^ i := Iff.rfl

/-- `Fil^0_N R = R`. -/
@[simp]
theorem fil_zero : fil φ J 0 = ⊤ := by
  simp [fil_def]

/-- The first Nygaard ideal is the contraction of `J` along Frobenius. -/
theorem fil_one : fil φ J 1 = J.comap φ := by
  rw [fil_def, Submodule.pow_one]

/-- The Nygaard filtration is decreasing. -/
theorem fil_antitone [J.IsTwoSided] : Antitone (fil φ J) := by
  simpa only [filtration_ideal] using (filtration φ J).antitone

/-- The Nygaard filtration is multiplicative: a product adds the filtration orders. -/
theorem mul_mem_fil [J.IsTwoSided] {i j : ℕ} {x y : R} (hx : x ∈ fil φ J i)
    (hy : y ∈ fil φ J j) : x * y ∈ fil φ J (i + j) := by
  rw [← filtration_ideal] at hx hy ⊢
  exact (filtration φ J).mul_mem hx hy

/-- The product of the ideals `Fil^i_N R` and `Fil^j_N R` lies in `Fil^(i + j)_N R`. -/
theorem fil_mul_le [J.IsTwoSided] (i j : ℕ) : fil φ J i * fil φ J j ≤ fil φ J (i + j) :=
  mul_le.2 fun _ hx _ hy => mul_mem_fil hx hy

/-- For the identity endomorphism the bundled Nygaard filtration is the `J`-adic filtration. -/
@[simp]
theorem filtration_id [J.IsTwoSided] : filtration (RingHom.id S) J = J.algFiltration :=
  AlgFiltration.comap_id _

/-- For the identity endomorphism the Nygaard ideals are the powers of `J`. -/
@[simp]
theorem fil_id (i : ℕ) : fil (RingHom.id S) J i = J ^ i :=
  comap_id _

/-- The intersection of the steps of the Nygaard filtration is the preimage of the intersection of
the powers of `J`. -/
theorem iInf_fil : ⨅ i, fil φ J i = (⨅ i, J ^ i).comap φ :=
  (comap_iInf _ _).symm

/-- If the powers of `J` intersect in zero, the steps of the Nygaard filtration intersect in the
kernel of `φ`. -/
theorem iInf_fil_eq_ker (h : ⨅ i, J ^ i = ⊥) : ⨅ i, fil φ J i = RingHom.ker φ := by
  rw [iInf_fil, h, RingHom.ker]

end Filtration

/-- A commuting square of ring maps preserves each Nygaard step if the target-side map
carries `J` into `K`. -/
theorem fil_le_comap_fil {R R' S S' : Type*} [Semiring R] [Semiring R'] [CommSemiring S]
    [CommSemiring S'] {φ : R →+* S} {ψ : R' →+* S'} {J : Ideal S} {K : Ideal S'}
    {f : R →+* R'} {g : S →+* S'} (hf : g.comp φ = ψ.comp f) (hJK : J ≤ K.comap g)
    (i : ℕ) : fil φ J i ≤ (fil ψ K i).comap f := by
  intro x hx
  rw [mem_comap, mem_fil_iff, ← RingHom.comp_apply, ← hf, RingHom.comp_apply]
  exact map_mem_pow_of_le_comap g hJK (mem_fil_iff.mp hx)

/-- The first Nygaard ideal is the kernel of Frobenius followed by reduction modulo `J`. -/
theorem fil_one_eq_ker {R S : Type*} [Semiring R] [Ring S] (φ : R →+* S)
    (J : Ideal S) [J.IsTwoSided] : fil φ J 1 = RingHom.ker ((Ideal.Quotient.mk J).comp φ) := by
  rw [fil_one, ← RingHom.comap_ker, Ideal.mk_ker]

section RingEquiv

variable {R S : Type*} [CommSemiring R] [CommSemiring S]

/-- For a ring equivalence `φ`, the Nygaard filtration of the ideal `φ(J)` is the `J`-adic
filtration. -/
theorem fil_map_ringEquiv (φ : R ≃+* S) (J : Ideal R) (i : ℕ) :
    fil (φ : R →+* S) (J.map φ) i = J ^ i := by
  rw [fil_def, ← Ideal.map_pow, comap_coe, comap_map_of_bijective _ φ.bijective]

/-- For a ring equivalence `φ` with `φ e = d`, as for a perfect prism, the Nygaard filtration
of `(d)` is the `e`-adic filtration. -/
theorem fil_span_singleton_of_ringEquiv (φ : R ≃+* S) {d : S} {e : R} (he : φ e = d) (i : ℕ) :
    fil (φ : R →+* S) (span {d}) i = span {e ^ i} := by
  rw [← he, ← span_singleton_pow, ← fil_map_ringEquiv φ, map_span, Set.image_singleton]

end RingEquiv

section DividedFrobenius

variable {B : Type*} [CommSemiring B] {φ : B →+* B} {d : B}

/-- For a principal ideal `(d)`, `x ∈ Fil^i_N B` exactly when `d ^ i` divides `φ x`. -/
theorem mem_fil_span_singleton_iff {i : ℕ} {x : B} :
    x ∈ fil φ (span {d}) i ↔ d ^ i ∣ φ x := by
  rw [mem_fil_iff, span_singleton_pow, mem_span_singleton]

/-- Replacing the generator `d` by `u * d` for a unit `u` does not change the Nygaard
filtration. -/
theorem fil_span_singleton_unit_mul (u : Bˣ) (i : ℕ) :
    fil φ (span {(u : B) * d}) i = fil φ (span {d}) i := by
  rw [span_singleton_mul_left_unit u.isUnit]

/-- Cancel a power `d ^ i` of a nonzerodivisor on the left. -/
private theorem pow_mul_left_cancel (hd : IsRegular d) {i : ℕ} {a b : B}
    (h : d ^ i * a = d ^ i * b) : a = b :=
  (hd.pow i).left h

/-- The quotient `φ x / d ^ i` chosen for `x ∈ Fil^i_N B`, defining the divided Frobenius. -/
private noncomputable def dividedFrobeniusFun {i : ℕ} (x : fil φ (span {d}) i) : B :=
  (mem_fil_span_singleton_iff.1 x.property).choose

private theorem pow_mul_dividedFrobeniusFun {i : ℕ} (x : fil φ (span {d}) i) :
    d ^ i * dividedFrobeniusFun x = φ x :=
  (mem_fil_span_singleton_iff.1 x.property).choose_spec.symm

variable (φ) in
/-- The divided Frobenius `φ_i = φ / d ^ i` on `Fil^i_N B`, for the ideal `(d)` generated by a
nonzerodivisor `d`: the unique element with `d ^ i * φ_i x = φ x`
(`pow_mul_dividedFrobenius`, `dividedFrobenius_eq_iff`). It is additive and `φ`-semilinear. -/
noncomputable def dividedFrobenius (hd : IsRegular d) (i : ℕ) :
    fil φ (span {d}) i →ₛₗ[φ] B where
  toFun := dividedFrobeniusFun
  map_add' x y := pow_mul_left_cancel hd <| by
    rw [mul_add, pow_mul_dividedFrobeniusFun, pow_mul_dividedFrobeniusFun,
      pow_mul_dividedFrobeniusFun, Submodule.coe_add, map_add]
  map_smul' a x := pow_mul_left_cancel hd <| by
    rw [smul_eq_mul, mul_left_comm, pow_mul_dividedFrobeniusFun, pow_mul_dividedFrobeniusFun,
      Submodule.coe_smul, smul_eq_mul, map_mul]

variable (hd : IsRegular d)

/-- The defining identity `d ^ i * φ_i x = φ x` of the divided Frobenius. -/
@[simp]
theorem pow_mul_dividedFrobenius {i : ℕ} (x : fil φ (span {d}) i) :
    d ^ i * dividedFrobenius φ hd i x = φ x :=
  pow_mul_dividedFrobeniusFun x

/-- The divided Frobenius is characterized by `d ^ i * φ_i x = φ x`. -/
theorem dividedFrobenius_eq_iff {i : ℕ} {x : fil φ (span {d}) i} {y : B} :
    dividedFrobenius φ hd i x = y ↔ d ^ i * y = φ x := by
  rw [← pow_mul_dividedFrobenius hd x]
  exact ⟨fun h => h ▸ rfl, fun h => (pow_mul_left_cancel hd h).symm⟩

/-- `φ_0 = φ`. -/
@[simp]
theorem dividedFrobenius_zero_apply (x : fil φ (span {d}) 0) :
    dividedFrobenius φ hd 0 x = φ x := by
  rw [dividedFrobenius_eq_iff, pow_zero, one_mul]

/-- The divided Frobenius is multiplicative across degrees: `φ_(i + j) (x * y) = φ_i x * φ_j y`. -/
theorem dividedFrobenius_mul {i j : ℕ} {x y : B} (hx : x ∈ fil φ (span {d}) i)
    (hy : y ∈ fil φ (span {d}) j) :
    dividedFrobenius φ hd (i + j) ⟨x * y, mul_mem_fil hx hy⟩ =
      dividedFrobenius φ hd i ⟨x, hx⟩ * dividedFrobenius φ hd j ⟨y, hy⟩ := by
  rw [dividedFrobenius_eq_iff, map_mul, ← pow_mul_dividedFrobenius hd ⟨x, hx⟩,
    ← pow_mul_dividedFrobenius hd ⟨y, hy⟩, pow_add]
  ring

/-- The transition law `φ_i = d * φ_(i + 1)` on `Fil^(i + 1)_N B`. -/
theorem dividedFrobenius_succ {i : ℕ} {x : B} (hx : x ∈ fil φ (span {d}) (i + 1)) :
    dividedFrobenius φ hd i ⟨x, fil_antitone i.le_succ hx⟩ =
      d * dividedFrobenius φ hd (i + 1) ⟨x, hx⟩ := by
  rw [dividedFrobenius_eq_iff, ← pow_mul_dividedFrobenius hd ⟨x, hx⟩, pow_succ, mul_assoc]

/-- `φ_i x` is divisible by `d` exactly when `x` lies in the next step of the filtration. -/
theorem dividedFrobenius_mem_span_singleton_iff {i : ℕ} (x : fil φ (span {d}) i) :
    dividedFrobenius φ hd i x ∈ span {d} ↔ (x : B) ∈ fil φ (span {d}) (i + 1) := by
  rw [mem_span_singleton', mem_fil_iff, span_singleton_pow, mem_span_singleton',
    ← pow_mul_dividedFrobenius hd x]
  refine ⟨fun ⟨a, ha⟩ => ⟨a, by rw [← ha, pow_succ]; ring⟩, fun ⟨a, ha⟩ =>
    ⟨a, pow_mul_left_cancel hd <| by rw [← ha, pow_succ]; ring⟩⟩

/-- For `x = e ^ i * a` with `φ e = d`, as for a perfect prism, `φ_i (e ^ i * a) = φ a`. -/
theorem dividedFrobenius_pow_mul {e : B} (he : φ e = d) (i : ℕ) (a : B)
    (hx : e ^ i * a ∈ fil φ (span {d}) i) :
    dividedFrobenius φ hd i ⟨e ^ i * a, hx⟩ = φ a := by
  rw [dividedFrobenius_eq_iff, map_mul, map_pow, he]

/-- Replacing the generator `d` by `u * d` for a unit `u` multiplies `φ_i` by `u⁻¹ ^ i`. -/
theorem dividedFrobenius_unit_mul (u : Bˣ) (hud : IsRegular ((u : B) * d)) {i : ℕ} {x : B}
    (hx : x ∈ fil φ (span {d}) i) (hx' : x ∈ fil φ (span {(u : B) * d}) i) :
    dividedFrobenius φ hud i ⟨x, hx'⟩ = (↑u⁻¹ : B) ^ i * dividedFrobenius φ hd i ⟨x, hx⟩ := by
  rw [dividedFrobenius_eq_iff, ← pow_mul_dividedFrobenius hd ⟨x, hx⟩]
  calc ((u : B) * d) ^ i * ((↑u⁻¹ : B) ^ i * dividedFrobenius φ hd i ⟨x, hx⟩)
      _ = ((u : B) ^ i * (↑u⁻¹ : B) ^ i) * (d ^ i * dividedFrobenius φ hd i ⟨x, hx⟩) := by ring
      _ = d ^ i * dividedFrobenius φ hd i ⟨x, hx⟩ := by
        rw [← mul_pow, Units.mul_inv, one_pow, one_mul]

end DividedFrobenius

section Graded

variable {R S : Type*} [Ring R] [Semiring S] (φ : R →+* S) (J : Ideal S)

/-- The `i`-th graded piece `gr^i_N R = Fil^i_N R / Fil^(i + 1)_N R` of the Nygaard filtration,
as an `R`-module. -/
abbrev gr (i : ℕ) : Type _ :=
  fil φ J i ⧸ Submodule.comap (fil φ J i).subtype (fil φ J (i + 1))

end Graded

section FrobeniusFil

variable {R S : Type*} [Semiring R] [Semiring S] (φ : R →+* S) (J : Ideal S)

/-- Frobenius restricted to the Nygaard ideal, taking values in the corresponding power of `J`. -/
def frobeniusFil (i : ℕ) : fil φ J i →ₛₗ[φ] ↥(J ^ i) :=
  φ.toSemilinearMap.restrict fun _ hx => mem_fil_iff.mp hx

/-- Restricted Frobenius has the same value in the ambient ring as the original map. -/
@[simp]
theorem coe_frobeniusFil_apply (i : ℕ) (x : fil φ J i) :
    (frobeniusFil φ J i x : S) = φ x := (rfl)

end FrobeniusFil

section GradedFrobenius

variable {R S : Type*} [Ring R] [CommRing S] (φ : R →+* S) (J : Ideal S)

/-- Frobenius induces a semilinear map from a Nygaard graded piece to the corresponding
adic graded piece. -/
def grFrobenius (i : ℕ) : gr φ J i →ₛₗ[φ] J.GradedPiece i :=
  Submodule.mapQ _ _ (frobeniusFil φ J i) fun _ hx => by
    simpa only [Submodule.mem_comap, Submodule.subtype_apply, coe_frobeniusFil_apply, mem_fil_iff]
      using hx

/-- On a class represented by `x`, graded Frobenius is represented by `φ x`. -/
@[simp]
theorem grFrobenius_mk (i : ℕ) (x : fil φ J i) :
    grFrobenius φ J i (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (frobeniusFil φ J i x) := (rfl)

/-- Graded Frobenius is injective: its values vanish precisely on representatives from the
next Nygaard level, regardless of the kernel of Frobenius on the ring. -/
theorem grFrobenius_injective (i : ℕ) : Function.Injective (grFrobenius φ J i) := by
  refine (injective_iff_map_eq_zero _).2 fun z => Submodule.Quotient.induction_on _ z fun x hx => ?_
  simpa only [grFrobenius_mk, Ideal.gradedPiece_mk_eq_zero_iff, coe_frobeniusFil_apply,
    Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply, mem_fil_iff]
    using hx

end GradedFrobenius

section GradedDividedFrobenius

variable {B : Type*} [CommRing B] (φ : B →+* B) {d : B} (hd : IsRegular d)

/-- The map `gr^i_N B → B / (d)` induced by the divided Frobenius `φ_i`; it is `φ`-semilinear and
injective (`grDividedFrobenius_injective`). -/
noncomputable def grDividedFrobenius (i : ℕ) : gr φ (span {d}) i →ₛₗ[φ] B ⧸ span {d} :=
  Submodule.liftQ _ ((span {d}).mkQ.comp (dividedFrobenius φ hd i)) fun x hx => by
    rw [LinearMap.mem_ker, LinearMap.comp_apply, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero]
    exact (dividedFrobenius_mem_span_singleton_iff hd x).2 hx

@[simp]
theorem grDividedFrobenius_mk {i : ℕ} (x : fil φ (span {d}) i) :
    grDividedFrobenius φ hd i (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (dividedFrobenius φ hd i x) :=
  (rfl)

/-- The divided Frobenius embeds the graded piece `gr^i_N B` into `B / (d)`. -/
theorem grDividedFrobenius_injective (i : ℕ) : Function.Injective (grDividedFrobenius φ hd i) := by
  refine (injective_iff_map_eq_zero _).2 fun x hx => ?_
  induction x using Submodule.Quotient.induction_on with
  | H x =>
    rw [grDividedFrobenius_mk, Submodule.Quotient.mk_eq_zero,
      dividedFrobenius_mem_span_singleton_iff] at hx
    rwa [Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply]

end GradedDividedFrobenius

end TauCeti.Prismatic.Nygaard
