/-!
# The Nygaard ideal filtration

For a prism with ideal `J` and Frobenius `φ`, the `i`-th Nygaard ideal is `φ⁻¹(J^i)`.
It is the pullback of `Ideal.algFiltration`, so it inherits the decreasing and multiplicative
filtration laws and can be used with ideal-filtration completions. No prism axioms are needed:
the same filtration applies to a map between different rings, as for a relative Frobenius
from a scalar twist. Nonpositive integer indices are interpreted by precomposing the ideal
family with `Int.toNat`.

* `TauCeti.Prismatic.Nygaard.fil`: the decreasing, multiplicative ideal filtration.
* `TauCeti.Prismatic.Nygaard.gr`: the quotient of consecutive steps.
* `TauCeti.Prismatic.Nygaard.grFrobenius`: the injective semilinear map to `J^i / J^(i+1)`.

Separation of the target for the `J`-adic filtration identifies the intersection of the
Nygaard ideals with the kernel of `φ`, not necessarily with zero.

## Reference

* B. Bhatt and P. Scholze, *Prisms and prismatic cohomology*, Ann. of Math. 196 (2022),
  Definition 12.1 and Theorem 12.2.
-/

public section

namespace TauCeti.Prismatic.Nygaard

section Semiring

variable {R S : Type*} [Semiring R] [Semiring S]

/-- The Nygaard filtration is the pullback of the `J`-adic filtration along Frobenius. -/
def fil (φ : R →+* S) (J : Ideal S) [J.IsTwoSided] : AlgFiltration R := J.algFiltration.comap φ

/-- The `i`-th Nygaard ideal is the contraction of the `i`-th power of `J`. -/
theorem fil_ideal (φ : R →+* S) (J : Ideal S) [J.IsTwoSided] (i : ℕ) :
    (fil φ J).ideal i = (J ^ i).comap φ := by
  simp [fil]

/-- An element is in a Nygaard ideal exactly when its image is in the corresponding ideal power. -/
@[simp]
theorem mem_fil {φ : R →+* S} {J : Ideal S} [J.IsTwoSided] {i : ℕ} {x : R} :
    x ∈ (fil φ J).ideal i ↔ φ x ∈ J ^ i := by
  rw [fil_ideal, Ideal.mem_comap]

/-- If Frobenius is the identity, the Nygaard filtration is the adic filtration. -/
@[simp]
theorem fil_id (J : Ideal R) [J.IsTwoSided] : fil (RingHom.id R) J = J.algFiltration := by
  unfold fil
  exact AlgFiltration.comap_id _

/-- The intersection of the Nygaard levels is the contraction of the adic intersection. -/
theorem iInf_fil (φ : R →+* S) (J : Ideal S) [J.IsTwoSided] :
    (⨅ i : ℕ, (fil φ J).ideal i) = (⨅ i : ℕ, J ^ i).comap φ := by
  simp only [fil_ideal, Ideal.comap_iInf]

/-- For a `J`-adically separated target, the intersection of the Nygaard levels is the
kernel of Frobenius. -/
theorem intersection_fil (φ : R →+* S) {J : Ideal S} [J.IsTwoSided]
    (hJ : (⨅ i : ℕ, J ^ i) = ⊥) : (⨅ i : ℕ, (fil φ J).ideal i) = RingHom.ker φ := by
  rw [iInf_fil, hJ, RingHom.ker]

end Semiring

/-- A commuting square of ring maps preserves Nygaard levels if the target-side map sends
`J` into `K`. -/
theorem map_fil_le {R S R' S' : Type*} [Semiring R] [Semiring R']
    [CommSemiring S] [CommSemiring S']
    {φ : R →+* S} {ψ : R' →+* S'} {J : Ideal S} {K : Ideal S'}
    (f : R →+* R') (g : S →+* S') (h : ψ.comp f = g.comp φ) (hJK : J ≤ K.comap g) (i : ℕ) :
    ((fil φ J).ideal i).map f ≤ (fil ψ K).ideal i := by
  refine Ideal.map_le_iff_le_comap.mpr fun x hx ↦ ?_
  rw [Ideal.mem_comap, mem_fil, ← RingHom.comp_apply, h, RingHom.comp_apply]
  exact Ideal.map_mem_pow_of_le_comap g hJK (mem_fil.mp hx)

/-- For an invertible Frobenius and a principal ideal, the Nygaard ideals are generated by
powers of the inverse image of the generator. -/
@[simp]
theorem fil_ideal_span_singleton_of_equiv {R S : Type*} [CommSemiring R] [CommSemiring S]
    (e : R ≃+* S) (d : S) (i : ℕ) :
    (fil (e : R →+* S) (Ideal.span {d})).ideal i = Ideal.span {e.symm d ^ i} := by
  calc
    (fil (e : R →+* S) (Ideal.span {d})).ideal i = (Ideal.span {d} ^ i).comap e := fil_ideal _ _ _
    _ = Ideal.span {e.symm d ^ i} := by
      simp only [← Ideal.map_symm e, Ideal.span_singleton_pow, Ideal.map_span, Set.image_singleton,
        map_pow]

/-- The first Nygaard ideal is the kernel of Frobenius followed by reduction modulo `J`. -/
theorem fil_ideal_one_eq_ker {R S : Type*} [Semiring R] [Ring S] (φ : R →+* S)
    (J : Ideal S) [J.IsTwoSided] :
    (fil φ J).ideal 1 = RingHom.ker ((Ideal.Quotient.mk J).comp φ) := by
  rw [fil_ideal, Submodule.pow_one, ← RingHom.comap_ker, Ideal.mk_ker]

section Graded

variable {R S : Type*} [Ring R] [CommRing S]

/-- The degree-`i` Nygaard graded piece, the quotient of level `i` by level `i + 1`. -/
abbrev gr (φ : R →+* S) (J : Ideal S) (i : ℕ) : Type _ :=
  ↥((fil φ J).ideal i) ⧸ Submodule.comap ((fil φ J).ideal i).subtype ((fil φ J).ideal (i + 1))

/-- The class of an element of level `i` vanishes precisely when it is in level `i + 1`. -/
theorem gr_mk_eq_zero_iff {φ : R →+* S} {J : Ideal S} {i : ℕ} (x : (fil φ J).ideal i) :
    (Submodule.Quotient.mk x : gr φ J i) = 0 ↔ (x : R) ∈ (fil φ J).ideal (i + 1) := by
  rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply]

/-- Frobenius restricted to the Nygaard ideal, taking values in the corresponding power of `J`. -/
def frobeniusFil (φ : R →+* S) (J : Ideal S) (i : ℕ) :
    ↥((fil φ J).ideal i) →ₛₗ[φ] ↥(J ^ i) :=
  φ.toSemilinearMap.restrict fun _ hx ↦ mem_fil.mp hx

/-- Restricted Frobenius has the same value in the ambient ring as the original map. -/
@[simp]
theorem coe_frobeniusFil_apply (φ : R →+* S) (J : Ideal S) (i : ℕ) (x : (fil φ J).ideal i) :
    (frobeniusFil φ J i x : S) = φ x := (rfl)

/-- Frobenius induces a semilinear map from a Nygaard graded piece to the corresponding
adic graded piece. -/
def grFrobenius (φ : R →+* S) (J : Ideal S) (i : ℕ) :
    gr φ J i →ₛₗ[φ] J.GradedPiece i :=
  Submodule.mapQ _ _ (frobeniusFil φ J i) fun x hx ↦ by
    simpa only [Submodule.mem_comap, Submodule.subtype_apply, coe_frobeniusFil_apply, mem_fil]
      using hx

/-- On a class represented by `x`, graded Frobenius is represented by `φ x`. -/
@[simp]
theorem grFrobenius_mk (φ : R →+* S) (J : Ideal S) (i : ℕ) (x : (fil φ J).ideal i) :
    grFrobenius φ J i (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (frobeniusFil φ J i x) := (rfl)

/-- Graded Frobenius is injective: its values vanish precisely on representatives from the
next Nygaard level, regardless of the kernel of Frobenius on the ring. -/
theorem grFrobenius_injective (φ : R →+* S) (J : Ideal S) (i : ℕ) :
    Function.Injective (grFrobenius φ J i) := by
  rw [← LinearMap.ker_eq_bot]
  refine eq_bot_iff.mpr fun z ↦ Submodule.Quotient.induction_on _ z fun x hx ↦ ?_
  simpa only [LinearMap.mem_ker, grFrobenius_mk, Ideal.gradedPiece_mk_eq_zero_iff,
    coe_frobeniusFil_apply, Submodule.mem_bot, gr_mk_eq_zero_iff, mem_fil] using hx

end Graded

end TauCeti.Prismatic.Nygaard
