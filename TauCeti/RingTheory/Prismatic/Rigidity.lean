module

public import TauCeti.RingTheory.Prismatic.Prism

/-!
# Rigidity of maps of prisms

If `(A, I) → (B, J)` is a map of prisms, that is, a `δ`-map `f : A → B` with `f(I) ⊆ J`, then
`I B = J`, and the natural map `B ⊗[A] I → J` is an isomorphism (Bhatt and Scholze, Lemma 3.5):
the ideal of the target is determined by the source.

The source proves this after a faithfully flat ind-Zariski localization making both ideals
principal, generated by distinguished elements (their Lemma 3.1), and then applies their
Lemma 2.24 to `d = e f`. Since `δ` does not pass to arbitrary localizations, the proof here stays
in `B` and argues one maximal ideal `m` at a time. An invertible ideal `J` is principal near `m`:
there are `e ∈ J` and `s ∉ m` with `s J ⊆ (e)` (`TauCeti.Ideal.exists_mul_mem_span_singleton`).
If `K = I B` were smaller than `J` at `m`, then `s K ⊆ e m`, and `p ∈ K + φ(K) B` gives an
equation `p w = e c` with `w ∉ m` and `c ∈ m`. Applying `δ`, the left side is `w ^ p` modulo `m`
(as `δ p = 1 - p ^ (p - 1)`) while the right side lies in `m`, a contradiction.

The argument uses only that `J` is invertible, that `J` and `p` lie in the Jacobson radical of
`B`, and that `p ∈ K + φ(K) B`; this is
`TauCeti.DeltaRing.eq_of_le_of_natCast_mem_sup_map_frobenius`.

## Main results

* `TauCeti.DeltaRing.eq_of_le_of_natCast_mem_sup_map_frobenius`: an ideal `K ⊆ J` of a `δ`-ring
  with `p ∈ K + φ(K) B`, where `J` is invertible and `J`, `p` lie in the Jacobson radical,
  equals `J`.
* `TauCeti.Prism.map_ideal_eq`: **rigidity**, `f(I) B = J` for a map of prisms `(A, I) → (B, J)`.
* `TauCeti.Prism.tensorIdealEquiv`: the isomorphism `B ⊗[A] I ≃ J` of `B`-modules, from
  `Module.Invertible.bijective_of_surjective`, as `J` is invertible.
* `TauCeti.Prism.eq_of_ideal_le`: prism structures on one `δ`-ring with comparable ideals are equal.

## References

* B. Bhatt and P. Scholze, *Prisms and prismatic cohomology*, Ann. of Math. 196 (2022), §3,
  Lemma 3.5.
-/

public section

namespace TauCeti

open DeltaRing TensorProduct

/-- An invertible ideal is principal near each prime: for `J` invertible and `m` prime there are
`e ∈ J` and `s ∉ m` such that `s x` is a multiple of `e` for every `x ∈ J`. -/
theorem Ideal.exists_mul_mem_span_singleton {B : Type*} [CommRing B] (J : Ideal B)
    [Module.Invertible B J] (m : Ideal B) [m.IsPrime] :
    ∃ e ∈ J, ∃ s ∉ m, ∀ x ∈ J, ∃ c, s * x = c * e := by
  classical
  obtain ⟨S, hS⟩ := ((Module.Invertible.linearEquiv B J).symm 1).exists_finset
  have h1 : (1 : B) = ∑ i ∈ S, i.1 i.2 := by
    simpa [Module.Invertible.linearEquiv] using (LinearEquiv.symm_apply_eq _).mp hS
  obtain ⟨i, -, hi⟩ : ∃ i ∈ S, i.1 i.2 ∉ m := by
    by_contra! h
    exact ‹m.IsPrime›.ne_top ((Ideal.eq_top_iff_one m).mpr (h1 ▸ m.sum_mem h))
  refine ⟨i.2, i.2.property, i.1 i.2, hi, fun x hx ↦ ⟨i.1 ⟨x, hx⟩, ?_⟩⟩
  have h2 : x • i.2 = (i.2 : B) • (⟨x, hx⟩ : J) := Subtype.ext (by simp [mul_comm])
  have h3 := i.1.map_smul x i.2
  rw [h2, map_smul, smul_eq_mul, smul_eq_mul] at h3
  rw [mul_comm, ← h3, mul_comm]

variable {p : ℕ} [hpf : Fact p.Prime] {A B : Type*} [CommRing A] [CommRing B] [DeltaRing p A]
  [DeltaRing p B]

/-- If `p` lies in a prime ideal `m` of a `δ`-ring, then `p w ≠ e c` for `e, c ∈ m` and `w ∉ m`:
applying `δ`, the left side is `w ^ p` modulo `m` (as `δ p = 1 - p ^ (p - 1)`), while the right
side lies in `m`. -/
theorem DeltaRing.natCast_mul_ne_mul {m : Ideal B} [hm : m.IsPrime] (hpm : (p : B) ∈ m)
    {e c w : B} (hem : e ∈ m) (hcm : c ∈ m) (hwm : w ∉ m) : (p : B) * w ≠ e * c := by
  intro hpw
  have hR : delta p (e * c) ∈ m := by
    rw [delta_mul]
    exact m.add_mem (m.add_mem (m.mul_mem_right _ (m.pow_mem_of_mem hem _ hpf.out.pos))
      (m.mul_mem_right _ (m.pow_mem_of_mem hcm _ hpf.out.pos)))
      (m.mul_mem_right _ (m.mul_mem_right _ hpm))
  have hp1 : (p : B) ^ (p - 1) ∈ m := m.pow_mem_of_mem hpm _ (Nat.sub_pos_of_lt hpf.out.one_lt)
  have hL : delta p ((p : B) * w) - w ^ p ∈ m := by
    rw [delta_mul, delta_natCast_self]
    have : (p : B) ^ p * delta p w + w ^ p * (1 - (p : B) ^ (p - 1)) +
        p * (1 - (p : B) ^ (p - 1)) * delta p w - w ^ p =
        (p : B) ^ p * delta p w - w ^ p * (p : B) ^ (p - 1) +
        p * (1 - (p : B) ^ (p - 1)) * delta p w := by ring
    rw [this]
    exact m.add_mem (m.sub_mem (m.mul_mem_right _ (m.pow_mem_of_mem hpm _ hpf.out.pos))
      (m.mul_mem_left _ hp1)) (m.mul_mem_right _ (m.mul_mem_right _ hpm))
  rw [hpw] at hL
  exact hwm (hm.mem_of_pow_mem p (by simpa using m.sub_mem hR hL))

/-- Let `m` be a prime ideal of a `δ`-ring containing `p` and `e`, and `K` an ideal with
`s K ⊆ e m` for some `s ∉ m`. Then `p ∉ K + φ(K) B`. -/
theorem DeltaRing.natCast_notMem_sup_map_frobenius {m K : Ideal B} [hm : m.IsPrime]
    (hpm : (p : B) ∈ m) {e s : B} (hem : e ∈ m) (hs : s ∉ m)
    (hK : ∀ k ∈ K, ∃ c ∈ m, s * k = e * c) : (p : B) ∉ K ⊔ K.map (frobenius p B) := by
  intro hpK
  have hφm : ∀ y ∈ m, frobenius p B y ∈ m := fun y hy ↦ by
    rw [frobenius_apply]
    exact m.add_mem (m.pow_mem_of_mem hy _ hpf.out.pos) (m.mul_mem_right _ hpm)
  have hφs : frobenius p B s ∉ m := fun h ↦ hs <| hm.mem_of_pow_mem p <| by
    have := m.sub_mem h (m.mul_mem_right (delta p s) hpm)
    rwa [frobenius_apply, add_sub_cancel_right] at this
  -- `s φ(s) (K + φ(K) B) ⊆ e m + φ(e) m`.
  set v := s * frobenius p B s
  set T : Ideal B := Ideal.span {e} * m ⊔ Ideal.span {frobenius p B e} * m
  have hle : K ⊔ K.map (frobenius p B) ≤ T.colon {v} := by
    refine sup_le (fun k hk ↦ ?_) (Ideal.map_le_iff_le_comap.mpr fun k hk ↦ ?_)
    · obtain ⟨c, hc, hkc⟩ := hK k hk
      refine Submodule.mem_colon_singleton.mpr (Submodule.mem_sup_left ?_)
      refine Ideal.mem_span_singleton_mul.mpr ⟨c * frobenius p B s, m.mul_mem_right _ hc, ?_⟩
      simp only [smul_eq_mul, v]
      linear_combination -frobenius p B s * hkc
    · obtain ⟨c, hc, hkc⟩ := hK k hk
      refine Submodule.mem_colon_singleton.mpr (Submodule.mem_sup_right ?_)
      refine Ideal.mem_span_singleton_mul.mpr ⟨frobenius p B c * s, m.mul_mem_right _ (hφm c hc),
        ?_⟩
      have := congrArg (frobenius p B) hkc
      simp only [map_mul] at this
      simp only [smul_eq_mul, v]
      linear_combination -s * this
  obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp (Submodule.mem_colon_singleton.mp (hle hpK))
  obtain ⟨a, ha, rfl⟩ := Ideal.mem_span_singleton_mul.mp hy
  obtain ⟨b, hb, rfl⟩ := Ideal.mem_span_singleton_mul.mp hz
  -- Rewrite as `p w = e c` with `w ∉ m` and `c ∈ m`.
  refine natCast_mul_ne_mul hpm hem (m.add_mem ha (m.mul_mem_left (e ^ (p - 1)) hb))
    (w := v - delta p e * b) (fun h ↦ hm.mul_notMem hs hφs ?_) ?_
  · simpa [v] using m.add_mem h (m.mul_mem_left (delta p e) hb)
  · have he : e ^ p = e * e ^ (p - 1) := by
      rw [← pow_succ', Nat.sub_add_cancel hpf.out.one_le]
    rw [smul_eq_mul, frobenius_apply, he] at hyz
    linear_combination -hyz

/-- The `δ`-ring core of the rigidity of prisms: if `K ⊆ J` are ideals of a `δ`-ring `B` with
`J` invertible, `J` and `p` in the Jacobson radical of `B`, and `p ∈ K + φ(K) B`, then `K = J`. -/
theorem DeltaRing.eq_of_le_of_natCast_mem_sup_map_frobenius {K J : Ideal B}
    [Module.Invertible B J] (hKJ : K ≤ J) (hJ : J ≤ Ring.jacobson B)
    (hp : (p : B) ∈ Ring.jacobson B) (hK : (p : B) ∈ K ⊔ K.map (frobenius p B)) : K = J := by
  refine le_antisymm hKJ fun x hx ↦ ?_
  -- It suffices that the colon ideal `(K : J)` is the unit ideal.
  suffices hC : K.colon (J : Set B) = ⊤ by
    have := Submodule.mem_colon.mp (hC ▸ Submodule.mem_top (x := (1 : B))) x hx
    rwa [one_smul] at this
  by_contra hC
  obtain ⟨m, hm, hCm⟩ := Ideal.exists_le_maximal _ hC
  have hjm := Ring.jacobson_le_of_isMaximal m
  obtain ⟨e, heJ, s, hs, hse⟩ := Ideal.exists_mul_mem_span_singleton J m
  refine natCast_notMem_sup_map_frobenius (hjm hp) (hjm (hJ heJ)) hs (fun k hk ↦ ?_) hK
  -- Near `m`, `K` lies in `e m`: otherwise `(K : J)` would contain an element outside `m`.
  obtain ⟨c, hc⟩ := hse k (hKJ hk)
  refine ⟨c, by_contra fun hcm ↦ hm.isPrime.mul_notMem hcm hs (hCm ?_), by rw [hc, mul_comm]⟩
  refine Submodule.mem_colon.mpr fun y hy ↦ ?_
  obtain ⟨c', hc'⟩ := hse y hy
  have : c * s * y = c' * (s * k) := by rw [hc, mul_assoc, hc']; ring
  rw [smul_eq_mul, this, ← mul_assoc]
  exact K.mul_mem_left _ hk

namespace Prism

/-- **Rigidity of maps of prisms** (Bhatt and Scholze, Lemma 3.5). If `f : A → B` is a `δ`-map
carrying the ideal `I` of a prism `(A, I)` into the ideal `J` of a prism `(B, J)`, then
`I B = J`. -/
theorem map_ideal_eq (P : Prism p A) (Q : Prism p B) {f : A →+* B} (hf : IsDeltaMap p f)
    (h : P.ideal.map f ≤ Q.ideal) : P.ideal.map f = Q.ideal := by
  refine eq_of_le_of_natCast_mem_sup_map_frobenius h Q.ideal_le_jacobson Q.natCast_mem_jacobson ?_
  have := Ideal.mem_map_of_mem f P.natCast_mem_sup
  rwa [map_natCast, Ideal.map_sup, Ideal.map_map, hf.comp_frobenius, ← Ideal.map_map] at this

/-- Two prism structures on the same `δ`-ring whose ideals are comparable are equal: rigidity for
the identity map. -/
theorem eq_of_ideal_le {P Q : Prism p B} (h : P.ideal ≤ Q.ideal) : P = Q := by
  ext1
  simpa using map_ideal_eq P Q (isDeltaMap_id p B) (by simpa using h)

section BaseChange

variable [Algebra A B] (P : Prism p A) (Q : Prism p B)
  (h : P.ideal.map (algebraMap A B) ≤ Q.ideal)

/-- For a map of prisms `(A, I) → (B, J)` given by an algebra `B` over `A`, the `B`-linear map
`B ⊗[A] I → J`, `b ⊗ x ↦ b x`. -/
noncomputable def tensorIdealToIdeal : B ⊗[A] P.ideal →ₗ[B] Q.ideal :=
  LinearMap.liftBaseChange B
    { toFun x := ⟨algebraMap A B x, h (Ideal.mem_map_of_mem _ x.property)⟩
      map_add' x y := Subtype.ext (map_add _ _ _)
      map_smul' a x := Subtype.ext (by simp [Algebra.smul_def]) }

@[simp]
theorem tensorIdealToIdeal_tmul (b : B) (x : P.ideal) :
    (tensorIdealToIdeal P Q h (b ⊗ₜ x) : B) = b * algebraMap A B x := by
  simp [tensorIdealToIdeal]

/-- **Rigidity of maps of prisms**, tensor form (Bhatt and Scholze, Lemma 3.5). For a map of
prisms `(A, I) → (B, J)` given by a `δ`-algebra `B` over `A`, the natural map `B ⊗[A] I → J` is
an isomorphism of `B`-modules. -/
theorem tensorIdealToIdeal_bijective (hf : IsDeltaMap p (algebraMap A B)) :
    Function.Bijective (tensorIdealToIdeal P Q h) := by
  refine Module.Invertible.bijective_of_surjective (LinearMap.range_eq_top.mp ?_)
  refine eq_top_iff.mpr fun y _ ↦ ?_
  have hle : P.ideal.map (algebraMap A B) ≤
      (LinearMap.range (tensorIdealToIdeal P Q h)).map Q.ideal.subtype := by
    refine Ideal.map_le_iff_le_comap.mpr fun x hx ↦ ⟨_, ⟨1 ⊗ₜ ⟨x, hx⟩, rfl⟩, ?_⟩
    simp
  have hy : (y : B) ∈ P.ideal.map (algebraMap A B) := by
    rw [map_ideal_eq P Q hf h]
    exact y.property
  obtain ⟨z, hz, hzy⟩ := hle hy
  rwa [Subtype.ext hzy] at hz

/-- **Rigidity of maps of prisms**, tensor form: the isomorphism `B ⊗[A] I ≃ J` of a map of
prisms `(A, I) → (B, J)` given by a `δ`-algebra `B` over `A`. -/
noncomputable def tensorIdealEquiv (hf : IsDeltaMap p (algebraMap A B)) :
    B ⊗[A] P.ideal ≃ₗ[B] Q.ideal :=
  .ofBijective _ (tensorIdealToIdeal_bijective P Q h hf)

@[simp]
theorem tensorIdealEquiv_apply (hf : IsDeltaMap p (algebraMap A B)) (x : B ⊗[A] P.ideal) :
    tensorIdealEquiv P Q h hf x = tensorIdealToIdeal P Q h x := by
  simp [tensorIdealEquiv]

end BaseChange

end Prism

