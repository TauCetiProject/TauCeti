public import TauCeti.RingTheory.Nilpotent.Exp

/-!
# Finite logarithms of unipotent elements

In an associative rational algebra, the finite logarithm of a unipotent element is nilpotent.
It is inverse to `IsNilpotent.exp`, and both maps commute with ring homomorphisms between rings
with a rational module structure. Thus the nilpotent elements and the elements whose difference
from one is nilpotent are in bijection. The bijection respects nilpotency bounds: if `a ^ n = 0`
then `(exp a - 1) ^ n = 0` (`IsNilpotent.pow_exp_sub_one_eq_zero`), and if `(u - 1) ^ n = 0` then
`log u ^ n = 0`, so for each `n` the exponential maps `{a | a ^ n = 0}` onto `{u | (u - 1) ^ n = 0}`
(`IsNilpotent.image_exp_setOf_pow_eq_zero`).
These polynomial identities apply in particular to strictly upper-triangular and
upper-unitriangular matrices, without topology or convergence assumptions.

The inverse identities use Mathlib's `PowerSeries.subst_exp_log` and
`PowerSeries.subst_log_exp_sub_one`, transported by finite substitution, first in a commutative
algebra and then in the subalgebra generated by one element.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, (1975).
-/

public section

namespace IsNilpotent

open scoped PowerSeries

open Finset

variable {A : Type*} [Ring A] [Module ℚ A]

/-- The finite logarithm, meaningful when `a - 1` is nilpotent.
When `a - 1` is not nilpotent, the sum is empty and `log a = 0`; this is a junk value. -/
noncomputable def log (a : A) : A :=
  ∑ i ∈ range (nilpotencyClass (a - 1)), ((-1 : ℚ) ^ (i + 1) / i) • (a - 1) ^ i

/-- The logarithm is the finite sum of powers of `a - 1` below its nilpotency class. -/
theorem log_def (a : A) :
    log a = ∑ i ∈ range (nilpotencyClass (a - 1)),
      ((-1 : ℚ) ^ (i + 1) / i) • (a - 1) ^ i := (rfl)

/-- Any vanishing power of `a - 1` gives a finite expansion for its logarithm. -/
theorem log_eq_sum {a : A} {n : ℕ} (hn : (a - 1) ^ n = 0) :
    log a = ∑ i ∈ range n, ((-1 : ℚ) ^ (i + 1) / i) • (a - 1) ^ i := by
  classical
  rw [log_def]
  apply sum_subset (range_mono (TauCeti.nilpotencyClass_le_of_pow_eq_zero hn))
  intro i hi hni
  rw [mem_range, not_lt] at hni
  rw [pow_eq_zero_of_le hni (pow_nilpotencyClass ⟨n, hn⟩), smul_zero]

/-- The logarithm of the identity is zero. -/
@[simp]
theorem log_one : log (1 : A) = 0 := by
  rw [log_eq_sum (n := 1) (by simp)]
  simp

/-- The logarithm commutes with ring homomorphisms between rings with a rational module
structure. -/
theorem map_log {B F : Type*} [Ring B] [Module ℚ B]
    [FunLike F A B] [RingHomClass F A B] {a : A}
    (ha : IsNilpotent (a - 1)) (f : F) : f (log a) = log (f a) := by
  obtain ⟨n, hn⟩ := ha
  have hn' : (f a - 1) ^ n = 0 := by simpa using congrArg f hn
  simp [log_eq_sum hn, log_eq_sum hn', map_rat_smul]

variable [IsScalarTower ℚ A A] [SMulCommClass ℚ A A]

/-- The finite logarithm of a unipotent element is nilpotent. -/
theorem isNilpotent_log {a : A} (ha : IsNilpotent (a - 1)) : IsNilpotent (log a) := by
  rw [log_def]
  apply Commute.isNilpotent_sum
  · intro i _
    by_cases hi : i = 0
    · simp [hi]
    · exact (ha.pow_of_pos hi).smul _
  · intro i j _ _
    exact (((Commute.refl (a - 1)).pow_pow i j).smul_left _).smul_right _

/-- The logarithm preserves nilpotency bounds: if `(a - 1) ^ n = 0`, then `log a ^ n = 0`. -/
theorem pow_log_eq_zero {a : A} {n : ℕ} (ha : (a - 1) ^ n = 0) : log a ^ n = 0 := by
  rw [log_eq_sum (pow_eq_zero_of_le n.le_succ ha), sum_range_succ']
  simpa using TauCeti.pow_sum_smul_pow_succ_eq_zero ha (range n)
    fun i => ((-1 : ℚ) ^ (i + 2) / (i + 1 : ℕ))

end IsNilpotent

namespace PowerSeries

variable {A : Type*} [CommRing A] [Algebra ℚ A]

/-- The formal exponential at a nilpotent constant is the finite exponential. -/
theorem subst_C_exp {a : A} (ha : IsNilpotent a) :
    (exp A).subst (C a) = C (IsNilpotent.exp a) := by
  obtain ⟨n, hn⟩ := ha
  rw [subst_C_eq_C_aeval_trunc hn, IsNilpotent.exp_eq_sum hn]
  congr 1
  rw [Polynomial.aeval_def, eval₂_trunc_eq_sum_range]
  simp [coeff_exp, Algebra.smul_def]

/-- The formal logarithm at a nilpotent constant is the finite logarithm of one plus it. -/
theorem subst_C_log {a : A} (ha : IsNilpotent a) :
    (log A).subst (C a) = C (IsNilpotent.log (1 + a)) := by
  obtain ⟨n, hn⟩ := ha
  rw [subst_C_eq_C_aeval_trunc hn, IsNilpotent.log_eq_sum (n := n) (by simpa using hn)]
  congr 1
  rw [Polynomial.aeval_def, eval₂_trunc_eq_sum_range]
  apply Finset.sum_congr rfl
  intro i _
  by_cases hi : i = 0 <;> simp [coeff_log, hi, Algebra.smul_def]

private theorem subst_C_exp_sub_one {a : A} (ha : IsNilpotent a) :
    (exp A - 1).subst (C a) = C (IsNilpotent.exp a - 1) := by
  simp only [subst_sub (HasSubst.C ha), subst_C_exp ha, subst_one (HasSubst.C ha),
    map_sub, map_one]

end PowerSeries

namespace IsNilpotent

open scoped PowerSeries

private theorem log_exp_comm {A : Type*} [CommRing A] [Algebra ℚ A]
    {a : A} (ha : IsNilpotent a) : log (exp a) = a := by
  have hC := PowerSeries.HasSubst.C ha
  have h := PowerSeries.subst_comp_subst_apply
    (R := A) (PowerSeries.HasSubst.exp_sub_one (A := A)) hC (PowerSeries.log A)
  apply PowerSeries.C_injective
  simpa only [PowerSeries.subst_log_exp_sub_one, PowerSeries.subst_X hC,
    PowerSeries.subst_C_exp_sub_one ha,
    PowerSeries.subst_C_log (isNilpotent_exp_sub_one ha), add_sub_cancel] using h.symm

private theorem exp_log_comm {A : Type*} [CommRing A] [Algebra ℚ A]
    {a : A} (ha : IsNilpotent (a - 1)) : exp (log a) = a := by
  have hC := PowerSeries.HasSubst.C ha
  have h := PowerSeries.subst_comp_subst_apply
    (R := A) (PowerSeries.HasSubst.log (A := A)) hC (PowerSeries.exp A)
  rw [PowerSeries.subst_exp_log, PowerSeries.subst_add hC,
    PowerSeries.subst_one hC, PowerSeries.subst_X hC] at h
  apply PowerSeries.C_injective
  simpa only [← map_one PowerSeries.C, ← map_add PowerSeries.C,
    PowerSeries.subst_C_log ha, add_sub_cancel,
    PowerSeries.subst_C_exp (isNilpotent_log ha)] using h.symm

open scoped IsMulCommutative

variable {A : Type*} [Ring A] [Algebra ℚ A]

private theorem exp_log_identities (a : A) :
    (IsNilpotent a → log (exp a) = a) ∧
      (IsNilpotent (a - 1) → exp (log a) = a) := by
  let S := Algebra.adjoin ℚ ({a} : Set A)
  let x : S := ⟨a, Algebra.subset_adjoin (by simp)⟩
  have hx : S.val x = a := rfl
  constructor
  · intro ha
    have hxnil : IsNilpotent x :=
      (IsNilpotent.map_iff (f := S.val) Subtype.val_injective).mp (hx.symm ▸ ha)
    simpa only [map_log (isNilpotent_exp_sub_one hxnil), map_exp hxnil, hx] using
      congrArg S.val (log_exp_comm hxnil)
  · intro ha
    have hxnil : IsNilpotent (x - 1) :=
      (IsNilpotent.map_iff (f := S.val) Subtype.val_injective).mp (by
        simpa only [map_sub, map_one, hx] using ha)
    simpa only [map_exp (isNilpotent_log hxnil), map_log hxnil, hx] using
      congrArg S.val (exp_log_comm hxnil)

/-- The finite logarithm undoes the exponential of a nilpotent element. -/
@[simp]
theorem log_exp {a : A} (ha : IsNilpotent a) : log (exp a) = a :=
  (exp_log_identities a).1 ha

/-- The finite exponential undoes the logarithm of a unipotent element. -/
@[simp]
theorem exp_log {a : A} (ha : IsNilpotent (a - 1)) : exp (log a) = a :=
  (exp_log_identities a).2 ha

/-- Finite exponential and logarithm identify nilpotent and unipotent elements of an
associative rational algebra. This is an equivalence of sets, not of groups. -/
noncomputable def expEquiv (A : Type*) [Ring A] [Algebra ℚ A] :
    {a : A // IsNilpotent a} ≃ {a : A // IsNilpotent (a - 1)} where
  toFun a := ⟨exp a, isNilpotent_exp_sub_one a.property⟩
  invFun a := ⟨log a, isNilpotent_log a.property⟩
  left_inv a := Subtype.ext (log_exp a.property)
  right_inv a := Subtype.ext (exp_log a.property)

/-- The forward map of the nilpotent/unipotent equivalence is the finite exponential. -/
@[simp]
theorem coe_expEquiv (a : {a : A // IsNilpotent a}) :
    (expEquiv A a : A) = exp (a : A) := (rfl)

/-- The inverse map of the nilpotent/unipotent equivalence is the finite logarithm. -/
@[simp]
theorem coe_expEquiv_symm (a : {a : A // IsNilpotent (a - 1)}) :
    ((expEquiv A).symm a : A) = log (a : A) := (rfl)

/-- The exponential maps the elements `a` with `a ^ n = 0` onto the elements `u` with
`(u - 1) ^ n = 0`; the logarithm is the inverse map. -/
theorem image_exp_setOf_pow_eq_zero (n : ℕ) :
    exp '' {a : A | a ^ n = 0} = {u | (u - 1) ^ n = 0} := by
  ext u
  refine ⟨?_, fun hu => ⟨log u, pow_log_eq_zero hu, exp_log ⟨n, hu⟩⟩⟩
  rintro ⟨a, ha, rfl⟩
  exact pow_exp_sub_one_eq_zero ha

end IsNilpotent

namespace TauCeti

/-- The logarithmic one-parameter group of a unipotent unit passes through that unit
at parameter one. -/
@[simp]
theorem expSMulHom_isNilpotent_log_ofAdd_one (R : Type*) [CommRing R]
    {A : Type*} [Ring A] [Algebra ℚ A] [Algebra R A]
    (g : Aˣ) (hg : IsNilpotent ((g : A) - 1)) :
    expSMulHom R (IsNilpotent.isNilpotent_log hg) (Multiplicative.ofAdd 1) = g := by
  apply Units.ext
  simp [IsNilpotent.exp_log hg]

end TauCeti
