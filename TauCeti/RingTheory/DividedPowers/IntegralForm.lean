module

public import TauCeti.RingTheory.DividedPowers.Basis
public import Mathlib.Algebra.Algebra.Operations
public import Mathlib.LinearAlgebra.TensorProduct.Basis
public import Mathlib.RingTheory.TensorProduct.Basic

/-!
# Integral divided-power algebras and their specialization

For an element `x` of an associative rational algebra, `dividedPowerIntegralForm x` is the
integral span of its divided powers, with its induced algebra structure. The binomial product
formula makes this span a subalgebra; it is exactly the algebra generated by those divided
powers. If the powers of `x` are rationally independent, its divided powers form an integral
basis, and after extension to any commutative ring they still form a basis with the same
binomial multiplication coefficients.

This is the single-root factor of an integral enveloping algebra. In the specialized algebra,
the symbols are pure tensors of integral divided powers, not factorial quotients. In particular
the factorial identity holds even when the factorial vanishes in the coefficient ring.

## Main declarations

* `TauCeti.Associative.dividedPowerIntegralForm`: the integral divided-power subalgebra.
* `TauCeti.Associative.dividedPowerIntegralForm_eq_adjoin`: its generated-algebra description.
* `TauCeti.Associative.dividedPowerLatticeBasis`: the existing integral basis of its carrier.
* `TauCeti.Associative.dividedPowerSpecializationBasis`: its basis after arbitrary base change.
* `TauCeti.Associative.dividedPowerSpecialization_mul`: the specialized multiplication law.
* `TauCeti.Associative.factorial_smul_dividedPowerSpecialization`: the factorial identity.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.Associative

open Set Submodule
open scoped TensorProduct

noncomputable section

variable {A : Type*} [Ring A] [Algebra ℚ A]

/-- The integral divided-power lattice is closed under multiplication. -/
theorem mul_mem_dividedPowerLattice (x : A) {a b : A}
    (ha : a ∈ dividedPowerLattice x) (hb : b ∈ dividedPowerLattice x) :
    a * b ∈ dividedPowerLattice x := by
  have hmul : dividedPowerLattice x * dividedPowerLattice x ≤ dividedPowerLattice x := by
    rw [dividedPowerLattice_def, Submodule.span_mul_span, Submodule.span_le]
    rintro _ ⟨_, ⟨m, rfl⟩, _, ⟨n, rfl⟩, rfl⟩
    dsimp only
    rw [← dividedPowerLattice_def, mul_dividedPower]
    exact (dividedPowerLattice x).nsmul_mem
      (dividedPower_mem_dividedPowerLattice x (m + n)) _
  exact hmul (Submodule.mul_mem_mul ha hb)

/-- The integral algebra spanned by all divided powers of an element of a rational algebra. -/
def dividedPowerIntegralForm (x : A) : Subalgebra ℤ A :=
  (dividedPowerLattice x).toSubalgebra
    (by simpa using dividedPower_mem_dividedPowerLattice x 0)
    (fun _ _ ha hb => mul_mem_dividedPowerLattice x ha hb)

/-- The underlying integral module of the divided-power algebra is its divided-power lattice. -/
@[simp]
theorem dividedPowerIntegralForm_toSubmodule (x : A) :
    (dividedPowerIntegralForm x).toSubmodule = dividedPowerLattice x :=
  (rfl)

/-- Membership in the integral divided-power algebra is membership in the integral lattice. -/
@[simp]
theorem mem_dividedPowerIntegralForm_iff (x a : A) :
    a ∈ dividedPowerIntegralForm x ↔ a ∈ dividedPowerLattice x :=
  Iff.rfl

/-- The integral divided-power algebra is generated by the divided powers. -/
theorem dividedPowerIntegralForm_eq_adjoin (x : A) :
    dividedPowerIntegralForm x = Algebra.adjoin ℤ (range fun n => dividedPower n x) := by
  apply le_antisymm
  · have hs : dividedPowerLattice x ≤
        (Algebra.adjoin ℤ (range fun n => dividedPower n x)).toSubmodule := by
      rw [dividedPowerLattice_def, Submodule.span_le]
      exact Algebra.subset_adjoin
    exact hs
  · apply Algebra.adjoin_le
    rintro _ ⟨n, rfl⟩
    exact dividedPower_mem_dividedPowerLattice x n

/-- The integral divided-power algebra is commutative even when the ambient algebra is not. -/
instance (x : A) : IsMulCommutative (dividedPowerIntegralForm x) := by
  rw [dividedPowerIntegralForm_eq_adjoin]
  apply Algebra.isMulCommutative_adjoin
  rintro _ ⟨m, rfl⟩ _ ⟨n, rfl⟩ _
  exact commute_dividedPower_dividedPower (Commute.refl x) m n

/-- A divided power, regarded as an element of its integral algebra. -/
def dividedPowerIntegral (x : A) (n : ℕ) : dividedPowerIntegralForm x :=
  ⟨dividedPower n x, dividedPower_mem_dividedPowerLattice x n⟩

@[simp]
theorem coe_dividedPowerIntegral (x : A) (n : ℕ) :
    (dividedPowerIntegral x n : A) = dividedPower n x :=
  (rfl)

@[simp]
theorem dividedPowerIntegral_zero (x : A) : dividedPowerIntegral x 0 = 1 := by
  ext
  simp

/-- Multiplication in the integral algebra has natural binomial coefficients. -/
theorem dividedPowerIntegral_mul (x : A) (m n : ℕ) :
    dividedPowerIntegral x m * dividedPowerIntegral x n =
      (m + n).choose m • dividedPowerIntegral x (m + n) := by
  ext
  simp [mul_dividedPower]

variable (R : Type*) [CommRing R]

/-- A specialized divided power is the scalar extension of the integral symbol, not division
by a factorial in the coefficient ring. -/
def dividedPowerSpecialization (x : A) (n : ℕ) :
    R ⊗[ℤ] dividedPowerIntegralForm x :=
  1 ⊗ₜ[ℤ] dividedPowerIntegral x n

/-- The defining pure-tensor description of a specialized divided power. -/
theorem dividedPowerSpecialization_def (x : A) (n : ℕ) :
    dividedPowerSpecialization R x n = 1 ⊗ₜ[ℤ] dividedPowerIntegral x n :=
  (rfl)

@[simp]
theorem dividedPowerSpecialization_zero (x : A) :
    dividedPowerSpecialization R x 0 = 1 := by
  simp [dividedPowerSpecialization_def, Algebra.TensorProduct.one_def]

/-- Binomial multiplication survives extension to every commutative ring. -/
theorem dividedPowerSpecialization_mul (x : A) (m n : ℕ) :
    dividedPowerSpecialization R x m * dividedPowerSpecialization R x n =
      (m + n).choose m • dividedPowerSpecialization R x (m + n) := by
  simp only [dividedPowerSpecialization_def, Algebra.TensorProduct.tmul_mul_tmul,
    one_mul, dividedPowerIntegral_mul, TensorProduct.tmul_smul]

/-- The factorial identity in a specialized integral algebra requires no invertibility of
factorials. -/
theorem factorial_smul_dividedPowerSpecialization (x : A) (n : ℕ) :
    n.factorial • dividedPowerSpecialization R x n =
      dividedPowerSpecialization R x 1 ^ n := by
  have hint : n.factorial • dividedPowerIntegral x n = dividedPowerIntegral x 1 ^ n := by
    apply Subtype.ext
    simpa only [Subalgebra.coe_smul, Subalgebra.coe_pow, coe_dividedPowerIntegral,
      dividedPower_one, Nat.cast_smul_eq_nsmul] using factorial_smul_dividedPower_eq_pow n x
  simpa only [dividedPowerSpecialization_def, TensorProduct.tmul_smul,
    Algebra.TensorProduct.tmul_pow, one_pow] using
    congrArg (fun a => (1 : R) ⊗ₜ[ℤ] a) hint

/-- The integral divided-power basis remains a basis after arbitrary scalar extension. -/
def dividedPowerSpecializationBasis (x : A)
    (h : LinearIndependent ℤ (fun n => dividedPower n x)) :
    Module.Basis ℕ R (R ⊗[ℤ] dividedPowerIntegralForm x) :=
  Module.Basis.baseChange (M := dividedPowerIntegralForm x) R (dividedPowerLatticeBasis x h)

@[simp]
theorem dividedPowerSpecializationBasis_apply (x : A)
    (h : LinearIndependent ℤ (fun n => dividedPower n x)) (n : ℕ) :
    dividedPowerSpecializationBasis R x h n = dividedPowerSpecialization R x n := by
  -- `Submodule.toSubalgebra` preserves the lattice carrier and its module structure
  -- definitionally. Expose that carrier here so `Module.Basis.baseChange_apply` and the
  -- lattice basis evaluation lemma apply to the integral-algebra tensor factors.
  change (dividedPowerLatticeBasis x h).baseChange R n =
    (1 : R) ⊗ₜ[ℤ] (⟨dividedPower n x, dividedPower_mem_dividedPowerLattice x n⟩ :
      dividedPowerLattice x)
  rw [Module.Basis.baseChange_apply]
  congr 1
  apply Subtype.ext
  exact coe_dividedPowerLatticeBasis_apply x h n

/-- Over a nonzero coefficient ring, no specialized basis divided power vanishes. This includes
indices whose factorial is zero in that ring. -/
theorem dividedPowerSpecialization_ne_zero [Nontrivial R] (x : A)
    (h : LinearIndependent ℤ (fun n => dividedPower n x)) (n : ℕ) :
    dividedPowerSpecialization R x n ≠ 0 := by
  rw [← dividedPowerSpecializationBasis_apply R x h n]
  exact (dividedPowerSpecializationBasis R x h).ne_zero n

end

end TauCeti.Associative
