/-!
# The principal Fontaine divided power envelope

Let `A` be a `ℤ_[p]`-algebra and `ξ ∈ A`. Every factorial `n !` is a unit of `A[1/p]`, because it
is a power of `p` times a natural number prime to `p`, which is a unit of `ℤ_[p]`. So the
fractions `ξ ^ n / n!` make sense in `A[1/p]`, and the **principal envelope**
`TauCeti.periodPDEnvelope p A ξ` is the `A`-subalgebra `D` of `A[1/p]` they generate. When
`A = W(𝒪_C♭)` is Fontaine's ring `A_inf` and `ξ` generates the kernel of Fontaine's map
`θ : A_inf → 𝒪_C`, its `p`-adic completion is the crystalline period ring `A_cris`.

This file constructs the divided powers of `D`. Let `J₀ ⊆ D` be the ideal generated by the
positive divided powers `ξ ^ n / n!`, `n ≥ 1` (`TauCeti.periodPDEnvelope.xiIdeal`), and
`J = J₀ + p D` (`TauCeti.periodPDEnvelope.pdIdeal`). Then `J` is stable under `x ↦ x ^ n / n!`,
computed in `A[1/p]`: on the generators this is the identity
`(ξ ^ m / m!) ^ n / n! = uniformBell n m * ξ ^ (n * m) / (n * m)!` and the fact that
`p ^ n / n!` lies in `p ℤ_[p]` for `n ≥ 1`. Hence `J` carries divided powers
`TauCeti.periodPDEnvelope.dividedPowers` given by `x ↦ x ^ n / n!`. They are the only divided
powers on `J`, since `D` has no `n!`-torsion. Both `J₀` and `p D` are sub-divided-power ideals,
`ξ` has the divided powers `ξ ^ n / n!`, and the canonical divided powers `p ^ n / n!` of
`(p) ⊆ ℤ_[p]` are compatible with those of `J`: the structure map `ℤ_[p] → D` is a divided power
morphism. Thus the divided powers of `J` extend both the principal divided powers of `J₀` and the
canonical divided powers of `p D`, which agree on `J₀ ∩ p D`.

The envelope is unchanged by unit multiples of `ξ`: for `a ∈ A` the envelope of `a * ξ` is
contained in that of `ξ` through a divided power morphism, and for a unit `u` the envelopes of
`u * ξ` and `ξ` coincide, with the same ideals `J₀` and `J`.

## Main definitions

* `TauCeti.periodPDEnvelope p A ξ`: the `A`-subalgebra of `A[1/p]` generated by the `ξ ^ n / n!`.
* `TauCeti.periodPDEnvelope.dp p A ξ n`: the element `ξ ^ n / n!` of the envelope.
* `TauCeti.periodPDEnvelope.xiIdeal p A ξ`: the ideal `J₀` generated by the `ξ ^ n / n!`, `n ≥ 1`.
* `TauCeti.periodPDEnvelope.pdIdeal p A ξ`: the ideal `J = J₀ + p D`.
* `TauCeti.periodPDEnvelope.dividedPowers p A ξ`: the divided powers `x ↦ x ^ n / n!` on `J`.

## Main results

* `TauCeti.periodPDEnvelope.coe_dividedPowers_dpow`: the divided powers of `J` are
  `x ↦ x ^ n / n!` in `A[1/p]`.
* `TauCeti.periodPDEnvelope.dividedPowers_dpow_algebraMap`: `ξ` has the divided powers
  `ξ ^ n / n!`.
* `TauCeti.periodPDEnvelope.isSubDPIdeal_xiIdeal`,
  `TauCeti.periodPDEnvelope.isSubDPIdeal_span_singleton_natCast`: `J₀` and `p D` are
  sub-divided-power ideals of `J`.
* `TauCeti.periodPDEnvelope.isDPMorphism_algebraMap`: the canonical divided powers of `p ℤ_[p]`
  are compatible with those of `J`.
* `TauCeti.periodPDEnvelope.isSMulRegular_natCast`: the envelope has no `p`-torsion.
* `TauCeti.periodPDEnvelope.dividedPowers_unique`: the divided powers of `J` are unique.
* `TauCeti.periodPDEnvelope.dp_mul_dp`, `TauCeti.periodPDEnvelope.dividedPowers_dpow_dp`: the
  divided power identities for the `ξ ^ n / n!`.
* `TauCeti.periodPDEnvelope_mul_left_le`, `TauCeti.periodPDEnvelope.isDPMorphism_inclusion`:
  the envelope of `a * ξ` maps to that of `ξ` by a divided power morphism.
* `TauCeti.periodPDEnvelope_mul_left_unit`, `TauCeti.periodPDEnvelope.map_inclusion_xiIdeal`,
  `TauCeti.periodPDEnvelope.map_inclusion_pdIdeal`: a unit multiple of `ξ` has the same envelope,
  with the same ideals `J₀` and `J`.

## References

* J.-M. Fontaine, *Le corps des périodes p-adiques*, Astérisque 223 (1994), §2.2 and §2.3.
* P. Berthelot and A. Ogus, *Notes on crystalline cohomology*, Princeton University Press, 1978,
  §3, Example 3.2(2) and Lemma 3.6.
* [Stacks Project, Section 07H7](https://stacks.math.columbia.edu/tag/07H7).
-/

public section

open DividedPowers Ideal Nat

namespace TauCeti

section Envelope

variable (p : ℕ) (A : Type*) [CommRing A] (ξ : A)

/-- The **principal Fontaine divided power envelope** of `ξ`: the `A`-subalgebra of `A[1/p]`
generated by the fractions `ξ ^ n / n!`. When `A` is a `ℤ_[p]`-algebra and `p` is prime, every
factorial `n !` is a unit of `A[1/p]` (`PadicInt.isUnit_factorial_localizationAway`), so these are
genuine divided powers; otherwise `Ring.inverse (n ! : A[1/p])` may be `0`. -/
noncomputable def periodPDEnvelope : Subalgebra A (Localization.Away (p : A)) :=
  Algebra.adjoin A (Set.range fun n : ℕ ↦
    Ring.inverse (n ! : Localization.Away (p : A)) * algebraMap A _ ξ ^ n)

namespace periodPDEnvelope

/-- The divided power `ξ ^ n / n!`, as an element of the principal envelope. -/
noncomputable def dp (n : ℕ) : periodPDEnvelope p A ξ :=
  ⟨Ring.inverse (n ! : Localization.Away (p : A)) * algebraMap A _ ξ ^ n,
    Algebra.subset_adjoin ⟨n, rfl⟩⟩

@[simp]
theorem coe_dp (n : ℕ) : (dp p A ξ n : Localization.Away (p : A)) =
    Ring.inverse (n ! : Localization.Away (p : A)) * algebraMap A _ ξ ^ n :=
  (rfl)

/-- The envelope is generated as an `A`-algebra by the divided powers of `ξ`. -/
theorem adjoin_range_dp : Algebra.adjoin A (Set.range (dp p A ξ)) = ⊤ := by
  apply Subalgebra.map_injective (f := (periodPDEnvelope p A ξ).val) Subtype.val_injective
  rw [AlgHom.map_adjoin, Algebra.map_top, Subalgebra.range_val, ← Set.range_comp]
  -- The coercions of the `dp p A ξ n` are, by definition, the generators of the envelope.
  rfl

@[simp]
theorem dp_zero : dp p A ξ 0 = 1 :=
  Subtype.val_injective (by simp)

@[simp]
theorem dp_one : dp p A ξ 1 = algebraMap A (periodPDEnvelope p A ξ) ξ :=
  Subtype.val_injective (by simp)

/-- The ideal `J₀` of the principal envelope generated by the positive divided powers
`ξ ^ n / n!`, `n ≥ 1`. -/
noncomputable def xiIdeal : Ideal (periodPDEnvelope p A ξ) :=
  span (Set.range fun n : ℕ ↦ dp p A ξ (n + 1))

/-- The divided power ideal `J = J₀ + p D` of the principal envelope `D`, generated by the positive
divided powers of `ξ` and by `p`. -/
noncomputable def pdIdeal : Ideal (periodPDEnvelope p A ξ) :=
  span (Set.range (fun n : ℕ ↦ dp p A ξ (n + 1)) ∪ {(p : periodPDEnvelope p A ξ)})

theorem pdIdeal_eq_sup : pdIdeal p A ξ = xiIdeal p A ξ ⊔ span {(p : periodPDEnvelope p A ξ)} :=
  span_union _ _

theorem dp_mem_xiIdeal {n : ℕ} (hn : n ≠ 0) : dp p A ξ n ∈ xiIdeal p A ξ := by
  obtain ⟨m, rfl⟩ := exists_eq_succ_of_ne_zero hn
  exact subset_span ⟨m, rfl⟩

theorem xiIdeal_le_pdIdeal : xiIdeal p A ξ ≤ pdIdeal p A ξ :=
  pdIdeal_eq_sup p A ξ ▸ le_sup_left

theorem natCast_mem_pdIdeal : (p : periodPDEnvelope p A ξ) ∈ pdIdeal p A ξ :=
  subset_span (Or.inr rfl)

theorem algebraMap_mem_xiIdeal : algebraMap A (periodPDEnvelope p A ξ) ξ ∈ xiIdeal p A ξ :=
  dp_one p A ξ ▸ dp_mem_xiIdeal p A ξ one_ne_zero

/-- The principal envelope has no `p`-torsion. -/
theorem isSMulRegular_natCast :
    IsSMulRegular (periodPDEnvelope p A ξ) (p : periodPDEnvelope p A ξ) :=
  Subalgebra.isSMulRegular_of_isUnit_coe <| by
    simpa using IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (p : A)) (p : A)

end periodPDEnvelope

variable {ξ}

/-- The envelope of a multiple `a * ξ` is contained in the envelope of `ξ`: its generators are
`(a * ξ) ^ n / n! = a ^ n * (ξ ^ n / n!)`. -/
theorem periodPDEnvelope_mul_left_le (a : A) :
    periodPDEnvelope p A (a * ξ) ≤ periodPDEnvelope p A ξ := by
  refine Algebra.adjoin_le ?_
  rintro _ ⟨n, rfl⟩
  have h := (periodPDEnvelope p A ξ).smul_mem (periodPDEnvelope.dp p A ξ n).property (a ^ n)
  rw [periodPDEnvelope.coe_dp, Algebra.smul_def, map_pow] at h
  simpa only [SetLike.mem_coe, map_mul, mul_pow, mul_left_comm] using h

/-- A unit multiple of `ξ` has the same principal envelope as `ξ`. -/
theorem periodPDEnvelope_mul_left_unit {u : A} (hu : IsUnit u) :
    periodPDEnvelope p A (u * ξ) = periodPDEnvelope p A ξ := by
  obtain ⟨u, rfl⟩ := hu
  exact le_antisymm (periodPDEnvelope_mul_left_le p A _) <| by
    simpa using periodPDEnvelope_mul_left_le p A (ξ := u * ξ) ↑u⁻¹

namespace periodPDEnvelope

/-- The inclusion of the envelope of `a * ξ` in the envelope of `ξ` sends `(a * ξ) ^ n / n!` to
`a ^ n * (ξ ^ n / n!)`. -/
theorem inclusion_dp (a : A) (n : ℕ) :
    Subalgebra.inclusion (periodPDEnvelope_mul_left_le p A a) (dp p A (a * ξ) n) =
      algebraMap A _ a ^ n * dp p A ξ n :=
  Subtype.val_injective <| by
    simp only [Subalgebra.coe_inclusion, coe_dp, Subalgebra.coe_mul, Subalgebra.coe_pow,
      Subalgebra.coe_algebraMap, map_mul, mul_pow]
    ring

/-- For a unit `u`, every divided power `ξ ^ n / n!` comes from the envelope of `u * ξ`. -/
private theorem dp_eq_inclusion (u : Aˣ) (n : ℕ) :
    dp p A ξ n = Subalgebra.inclusion (periodPDEnvelope_mul_left_le p A (u : A))
      (algebraMap A _ ↑u⁻¹ ^ n * dp p A (u * ξ) n) := by
  rw [map_mul, map_pow, AlgHom.commutes, inclusion_dp, ← mul_assoc, ← mul_pow, ← map_mul,
    Units.inv_mul, map_one, one_pow, one_mul]

theorem map_inclusion_xiIdeal_le (a : A) :
    (xiIdeal p A (a * ξ)).map (Subalgebra.inclusion (periodPDEnvelope_mul_left_le p A a)) ≤
      xiIdeal p A ξ := by
  rw [xiIdeal, map_span, span_le]
  rintro _ ⟨_, ⟨m, rfl⟩, rfl⟩
  rw [inclusion_dp]
  exact mul_mem_left _ _ (dp_mem_xiIdeal p A ξ m.succ_ne_zero)

theorem map_inclusion_pdIdeal_le (a : A) :
    (pdIdeal p A (a * ξ)).map (Subalgebra.inclusion (periodPDEnvelope_mul_left_le p A a)) ≤
      pdIdeal p A ξ := by
  rw [pdIdeal_eq_sup, pdIdeal_eq_sup, Ideal.map_sup, map_span, Set.image_singleton, map_natCast]
  exact sup_le_sup (map_inclusion_xiIdeal_le p A a) le_rfl

/-- For a unit `u`, the identification of the envelopes of `u * ξ` and `ξ` identifies their ideals
`J₀`. -/
theorem map_inclusion_xiIdeal (u : Aˣ) :
    (xiIdeal p A (u * ξ)).map (Subalgebra.inclusion (periodPDEnvelope_mul_left_le p A (u : A))) =
      xiIdeal p A ξ := by
  refine le_antisymm (map_inclusion_xiIdeal_le p A _) (span_le.mpr ?_)
  rintro _ ⟨m, rfl⟩
  dsimp only
  rw [SetLike.mem_coe, dp_eq_inclusion p A u]
  exact mem_map_of_mem _ (mul_mem_left _ _ (dp_mem_xiIdeal p A _ m.succ_ne_zero))

/-- For a unit `u`, the identification of the envelopes of `u * ξ` and `ξ` identifies their divided
power ideals `J`. -/
theorem map_inclusion_pdIdeal (u : Aˣ) :
    (pdIdeal p A (u * ξ)).map (Subalgebra.inclusion (periodPDEnvelope_mul_left_le p A (u : A))) =
      pdIdeal p A ξ := by
  rw [pdIdeal_eq_sup, pdIdeal_eq_sup, Ideal.map_sup, map_span, Set.image_singleton, map_natCast,
    map_inclusion_xiIdeal]

end periodPDEnvelope

end Envelope

section DividedPowers

variable (p : ℕ) [Fact p.Prime] (A : Type*) [CommRing A] [Algebra ℤ_[p] A]

variable (ξ : A)

namespace periodPDEnvelope

/-- The divided power `ξ ^ n / n!` times `n !` is `ξ ^ n`. -/
theorem factorial_mul_dp (n : ℕ) : (n ! : periodPDEnvelope p A ξ) * dp p A ξ n =
    algebraMap A (periodPDEnvelope p A ξ) ξ ^ n :=
  Subtype.val_injective <| by
    simp [← mul_assoc,
      Ring.mul_inverse_cancel _ (PadicInt.isUnit_factorial_localizationAway p A n)]

/-- Every factorial is a regular element of the principal envelope, which lies in `A[1/p]`,
where the factorials are units. -/
theorem isSMulRegular_factorial (n : ℕ) :
    IsSMulRegular (periodPDEnvelope p A ξ) (n ! : periodPDEnvelope p A ξ) :=
  Subalgebra.isSMulRegular_of_isUnit_coe (PadicInt.isUnit_factorial_localizationAway p A n)

/-- The divided powers `x ↦ x ^ n / n!` of the ideal of `A[1/p]` generated by `J`. -/
private noncomputable abbrev ambientDividedPowers :
    DividedPowers ((pdIdeal p A ξ).map (periodPDEnvelope p A ξ).val.toRingHom) :=
  ofIsUnitFactorial (PadicInt.isUnit_factorial_localizationAway p A) _

/-- The positive divided powers, computed in `A[1/p]`, of the generators of `J` lie in `J`. -/
private theorem exists_dpow_generator {n : ℕ} (hn : n ≠ 0) {s : periodPDEnvelope p A ξ}
    (hs : s ∈ Set.range (fun n : ℕ ↦ dp p A ξ (n + 1)) ∪ {(p : periodPDEnvelope p A ξ)}) :
    ∃ y ∈ pdIdeal p A ξ, (y : Localization.Away (p : A)) =
      Ring.inverse (n ! : Localization.Away (p : A)) * (s : Localization.Away (p : A)) ^ n := by
  have hB := PadicInt.isUnit_factorial_localizationAway p A
  rcases hs with ⟨m, rfl⟩ | rfl
  · -- `(ξ ^ (m + 1) / (m + 1)!) ^ n / n!` is a multiple of `ξ ^ (n * (m + 1)) / (n * (m + 1))!`.
    refine ⟨Nat.uniformBell n (m + 1) * dp p A ξ (n * (m + 1)),
      mul_mem_left _ _ (xiIdeal_le_pdIdeal p A ξ (dp_mem_xiIdeal p A ξ (by positivity))), ?_⟩
    have hcomp := (ofIsUnitFactorial hB (⊤ : Ideal (Localization.Away (p : A)))).dpow_comp
      (m := n) m.succ_ne_zero (Submodule.mem_top (x := algebraMap A _ ξ))
    simp only [ofIsUnitFactorial_dpow hB _ Submodule.mem_top] at hcomp
    simp [hcomp]
  · -- `p ^ n / n!` lies in `p ℤ_[p]`.
    obtain ⟨c, hc⟩ := mem_span_singleton'.mp
      ((PadicInt.dividedPowers p).dpow_mem hn (mem_span_singleton_self (p : ℤ_[p])))
    refine ⟨algebraMap A _ (algebraMap ℤ_[p] A c) * p,
      mul_mem_left _ _ (natCast_mem_pdIdeal p A ξ), ?_⟩
    have h := PadicInt.algebraMap_dpow_p p (by
      simpa using IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (p : A)) (p : A)) n
    rw [← hc, map_mul, map_natCast, IsScalarTower.algebraMap_apply ℤ_[p] A] at h
    simpa using h

/-- The principal envelope is a subring of `A[1/p]` whose ideal `J` is stable under the divided
powers `x ↦ x ^ n / n!` of `A[1/p]`. -/
private theorem exists_dpow_eq (n : ℕ) {x : periodPDEnvelope p A ξ} (hx : x ∈ pdIdeal p A ξ) :
    ∃ (y : periodPDEnvelope p A ξ) (_ : n ≠ 0 → y ∈ pdIdeal p A ξ),
      (periodPDEnvelope p A ξ).val.toRingHom y = (ambientDividedPowers p A ξ).dpow n
        ((periodPDEnvelope p A ξ).val.toRingHom x) := by
  refine exists_dpow_eq_of_mem_span (periodPDEnvelope p A ξ).val.toRingHom _
    (fun s hs ↦ mem_map_of_mem _ (subset_span hs)) (fun n hn s hs ↦ ?_) n hx
  have hs' : s ∈ pdIdeal p A ξ := subset_span hs
  obtain ⟨y, hy, hys⟩ := exists_dpow_generator p A ξ hn hs
  refine ⟨y, hy, ?_⟩
  rw [ofIsUnitFactorial_dpow _ _ (mem_map_of_mem (periodPDEnvelope p A ξ).val.toRingHom hs')]
  exact hys

/-- The divided powers `x ↦ x ^ n / n!` on the ideal `J = J₀ + p D` of the principal envelope,
induced from `A[1/p]`. -/
noncomputable def dividedPowers : DividedPowers (pdIdeal p A ξ) :=
  ofInjective (pdIdeal p A ξ) _ (periodPDEnvelope p A ξ).val.toRingHom Subtype.val_injective
    (ambientDividedPowers p A ξ) rfl (exists_dpow_eq p A ξ)

/-- The divided powers of `J` are `x ↦ x ^ n / n!`, computed in `A[1/p]`. -/
theorem coe_dividedPowers_dpow (n : ℕ) {x : periodPDEnvelope p A ξ} (hx : x ∈ pdIdeal p A ξ) :
    ((dividedPowers p A ξ).dpow n x : Localization.Away (p : A)) =
      Ring.inverse (n ! : Localization.Away (p : A)) * (x : Localization.Away (p : A)) ^ n :=
  ((isDPMorphism_ofInjective (pdIdeal p A ξ) (periodPDEnvelope p A ξ).val.toRingHom
    Subtype.val_injective (ambientDividedPowers p A ξ) rfl (exists_dpow_eq p A ξ)).map_dpow
    hx).trans (ofIsUnitFactorial_dpow _ _ (mem_map_of_mem _ hx))

/-- The divided powers of `ξ` are the `ξ ^ n / n!`. -/
@[simp]
theorem dividedPowers_dpow_algebraMap (n : ℕ) :
    (dividedPowers p A ξ).dpow n (algebraMap A (periodPDEnvelope p A ξ) ξ) = dp p A ξ n :=
  Subtype.val_injective <| by
    rw [coe_dividedPowers_dpow _ _ _ _ (xiIdeal_le_pdIdeal p A ξ (algebraMap_mem_xiIdeal p A ξ))]
    simp

/-- The product of the divided powers `ξ ^ m / m!` and `ξ ^ n / n!` is
`(m + n).choose m` times `ξ ^ (m + n) / (m + n)!`. -/
theorem dp_mul_dp (m n : ℕ) :
    dp p A ξ m * dp p A ξ n = (m + n).choose m * dp p A ξ (m + n) := by
  simpa using (dividedPowers p A ξ).mul_dpow (m := m) (n := n)
    (xiIdeal_le_pdIdeal p A ξ (algebraMap_mem_xiIdeal p A ξ))

/-- For `n ≠ 0`, the `m`-th divided power of `ξ ^ n / n!` is `uniformBell m n` times
`ξ ^ (m * n) / (m * n)!`. -/
theorem dividedPowers_dpow_dp (m : ℕ) {n : ℕ} (hn : n ≠ 0) :
    (dividedPowers p A ξ).dpow m (dp p A ξ n) = Nat.uniformBell m n * dp p A ξ (m * n) := by
  simpa using (dividedPowers p A ξ).dpow_comp (m := m) hn
    (xiIdeal_le_pdIdeal p A ξ (algebraMap_mem_xiIdeal p A ξ))

/-- The ideal `J₀` generated by the positive divided powers of `ξ` is a sub-divided-power ideal
of `J`. -/
theorem isSubDPIdeal_xiIdeal : (dividedPowers p A ξ).IsSubDPIdeal (xiIdeal p A ξ) := by
  rw [xiIdeal, span_isSubDPIdeal_iff (by
    rintro _ ⟨m, rfl⟩
    exact xiIdeal_le_pdIdeal p A ξ (dp_mem_xiIdeal p A ξ m.succ_ne_zero))]
  rintro n hn _ ⟨m, rfl⟩
  rw [dividedPowers_dpow_dp _ _ _ _ m.succ_ne_zero]
  exact mul_mem_left _ _ (dp_mem_xiIdeal p A ξ (by positivity))

/-- The canonical divided powers `p ^ n / n!` of `(p) ⊆ ℤ_[p]` are compatible with the divided
powers of `J`: the structure map `ℤ_[p] → D` is a divided power morphism. -/
theorem isDPMorphism_algebraMap :
    IsDPMorphism (PadicInt.dividedPowers p) (dividedPowers p A ξ)
      (algebraMap ℤ_[p] (periodPDEnvelope p A ξ)) := by
  refine IsDPMorphism.on_span _ _ rfl ?_ ?_
  · rintro _ rfl
    simpa using natCast_mem_pdIdeal p A ξ
  · rintro n _ rfl
    apply Subtype.val_injective
    rw [map_natCast, coe_dividedPowers_dpow _ _ _ _ (natCast_mem_pdIdeal p A ξ),
      Subalgebra.coe_algebraMap, PadicInt.algebraMap_dpow_p p (by
        simpa using IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (p : A)) (p : A))]
    simp

/-- The ideal `p D` is a sub-divided-power ideal of `J`. -/
theorem isSubDPIdeal_span_singleton_natCast :
    (dividedPowers p A ξ).IsSubDPIdeal (span {(p : periodPDEnvelope p A ξ)}) := by
  simpa [map_span] using isSubDPIdeal_map (isDPMorphism_algebraMap p A ξ)

/-- The divided powers `x ↦ x ^ n / n!` are the only divided powers on `J`. -/
theorem dividedPowers_unique (hJ : DividedPowers (pdIdeal p A ξ)) : hJ = dividedPowers p A ξ :=
  eq_of_isSMulRegular_factorial (isSMulRegular_factorial p A ξ) _ _

variable {ξ}

/-- The inclusion of the envelope of `a * ξ` in the envelope of `ξ` is a divided power morphism
for the divided powers of `J`. -/
theorem isDPMorphism_inclusion (a : A) :
    IsDPMorphism (dividedPowers p A (a * ξ)) (dividedPowers p A ξ)
      (Subalgebra.inclusion (periodPDEnvelope_mul_left_le p A a)).toRingHom := by
  have hmem {s : periodPDEnvelope p A (a * ξ)} (hs : s ∈ pdIdeal p A (a * ξ)) :
      Subalgebra.inclusion (periodPDEnvelope_mul_left_le p A a) s ∈ pdIdeal p A ξ :=
    map_inclusion_pdIdeal_le p A a (mem_map_of_mem _ hs)
  refine IsDPMorphism.on_span _ _ rfl (fun s hs ↦ hmem (subset_span hs)) fun {n} s hs ↦ ?_
  apply Subtype.val_injective
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.coe_inclusion,
    coe_dividedPowers_dpow _ _ _ _ (subset_span hs),
    coe_dividedPowers_dpow _ _ _ _ (hmem (subset_span hs))]

end periodPDEnvelope

end DividedPowers

end TauCeti
