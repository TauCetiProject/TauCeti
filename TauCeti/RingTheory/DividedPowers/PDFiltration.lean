/-!
# The divided power filtration of a divided power ideal

Let `R` be a commutative semiring, `I` an ideal of `R`, and `hI : DividedPowers I` a divided power
structure on `I`. For each natural number `n`, the `n`-th step of the *divided power filtration*
`hI.pdFiltration n` (often denoted `Fⁿ_γ I` or `I^[n]`) is the ideal generated by all finite
products `∏ j, hI.dpow e_j x_j` with `x_j ∈ I` and `∑ j, e_j ≥ n`, including the empty product of
value `1` and total weight `0`.

This filtration is fundamental in the theory of divided power ideals and crystalline cohomology:
it is decreasing, multiplicative (`Fᵐ · Fⁿ ≤ Fᵐ⁺ⁿ`), satisfies `F⁰ = ⊤` and `F¹ = I`, contains the
ordinary ideal powers `Iⁿ ≤ Fⁿ`, is stable under the divided power operations
(`hI.dpow m x ∈ Fᵐⁿ` for `x ∈ Fⁿ`, `n ≥ 1`, so each `Fⁿ` for `n ≥ 1` is a sub-dp-ideal of `I`),
and is functorial under divided power morphisms (with exact image `(Fⁿ).map f = Fⁿ_δ J` whenever
`I.map f = J`, without assuming surjectivity of `f`).

When `I` is generated by a set `S`, `hI.pdFiltration n` is generated by weighted products of
divided powers of elements of `S`. In particular, for a principal ideal `I = Ideal.span {a}`,
`hI.pdFiltration n` is generated simply by the single divided powers `hI.dpow m a` for `m ≥ n`.

When every divided power satisfies `hI.dpow m x ∈ I ^ m`—which holds over any `ℚ`-algebra as well
as for `OfInvertibleFactorial.dividedPowers`, `OfSquareZero.dividedPowers`,
`IsNilpotent.dividedPowers`, `CharP.dividedPowers`, and `dividedPowersBot`—the divided power
filtration coincides with the ordinary power filtration `I ^ n`.

## Main definitions

* `DividedPowers.pdFiltration`: the `n`-th step `I^[n]` of the divided power filtration.

## Main results

* `DividedPowers.pdFiltration_le_iff`: universal containment criterion `hI.pdFiltration n ≤ K`.
* `DividedPowers.mem_pdFiltration_iff`: elementwise membership characterization in
  `hI.pdFiltration n`.
* `DividedPowers.pdFiltration_zero`, `DividedPowers.pdFiltration_one`: `F⁰ = ⊤` and `F¹ = I`.
* `DividedPowers.pdFiltration_antitone`: `n ↦ hI.pdFiltration n` is antitone.
* `DividedPowers.pdFiltration_mul_le`:
  `hI.pdFiltration m * hI.pdFiltration n ≤ hI.pdFiltration (m + n)`.
* `DividedPowers.pow_le_pdFiltration`: `I ^ n ≤ hI.pdFiltration n`.
* `DividedPowers.dpow_mem_pdFiltration_mul`: for `n ≠ 0` and `x ∈ hI.pdFiltration n`,
  `hI.dpow m x ∈ hI.pdFiltration (m * n)`.
* `DividedPowers.isSubDPIdeal_pdFiltration`: for `n ≠ 0`, `hI.pdFiltration n` is a sub-dp-ideal.
* `DividedPowers.pdFiltration_eq_span_of_eq_span`: generator description when `I = Ideal.span S`.
* `DividedPowers.pdFiltration_eq_span_of_eq_span_singleton`: generator description for principal
  ideals `I = Ideal.span {a}`.
* `DividedPowers.IsDPMorphism.map_pdFiltration_le` and
  `DividedPowers.IsDPMorphism.map_pdFiltration_eq`: functoriality under divided power morphisms.
* `DividedPowers.pdFiltration_eq_pow_of_dpow_mem_pow` and `DividedPowers.pdFiltration_eq_pow_iff`:
  general criterion characterizing when `hI.pdFiltration n = I ^ n`.
* `DividedPowers.pdFiltration_eq_pow`: over a `ℚ`-algebra, `hI.pdFiltration n = I ^ n`.

## References

* Mathlib's `DividedPowers` formalization by A. Chambert-Loir and M. I. de Frutos-Fernández.
* [Stacks Project, Section 60.6 (Tag 07HQ)](https://stacks.math.columbia.edu/tag/07HQ),
  paragraph between Lemma 60.6.2 (Tag 07HS) and Lemma 60.6.3 (Tag 07HT).
* P. Berthelot, *Cohomologie cristalline des schémas de caractéristique $p > 0$*,
  Lecture Notes in Math. 407, Springer, 1974, Chapter I, §§1.3–1.4.
* P. Berthelot and A. Ogus, *Notes on crystalline cohomology*, Princeton Univ. Press, 1978, §3.
-/

public section

namespace DividedPowers

section Basic

variable {R : Type*} [CommSemiring R] {I : Ideal R} (hI : DividedPowers I)

/-- The `n`-th step of the divided power filtration `Fⁿ_γ I` (also denoted `I^[n]`): the ideal
generated by all finite products `∏ j, hI.dpow e_j x_j` over lists of pairs `(e_j, x_j)` with
`x_j ∈ I` and `∑ j, e_j ≥ n`, including the empty product of weight `0` and value `1`. -/
def pdFiltration (n : ℕ) : Ideal R :=
  Ideal.span { r : R | ∃ l : List (ℕ × R), (∀ p ∈ l, p.2 ∈ I) ∧ n ≤ (l.map Prod.fst).sum ∧
    (l.map fun p ↦ hI.dpow p.1 p.2).prod = r }

/-- Unfolding lemma for `DividedPowers.pdFiltration`. -/
theorem pdFiltration_def (n : ℕ) :
    hI.pdFiltration n =
      Ideal.span { r : R | ∃ l : List (ℕ × R), (∀ p ∈ l, p.2 ∈ I) ∧ n ≤ (l.map Prod.fst).sum ∧
        (l.map fun p ↦ hI.dpow p.1 p.2).prod = r } :=
  (rfl)

private theorem span_words_antitone (S : Set R) :
    Antitone fun n : ℕ ↦
      Ideal.span { r : R | ∃ l : List (ℕ × R), (∀ p ∈ l, p.2 ∈ S) ∧ n ≤ (l.map Prod.fst).sum ∧
        (l.map fun p ↦ hI.dpow p.1 p.2).prod = r } := by
  intro m n hmn
  refine Ideal.span_mono ?_
  rintro r ⟨l, hlS, hln, rfl⟩
  exact ⟨l, hlS, hmn.trans hln, rfl⟩

private theorem span_words_zero (S : Set R) :
    Ideal.span { r : R | ∃ l : List (ℕ × R), (∀ p ∈ l, p.2 ∈ S) ∧ 0 ≤ (l.map Prod.fst).sum ∧
      (l.map fun p ↦ hI.dpow p.1 p.2).prod = r } = ⊤ :=
  Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨[], by simp, by simp, by simp⟩) isUnit_one

private theorem span_words_mul_le (S : Set R) (m n : ℕ) :
    Ideal.span { r : R | ∃ l : List (ℕ × R), (∀ p ∈ l, p.2 ∈ S) ∧ m ≤ (l.map Prod.fst).sum ∧
        (l.map fun p ↦ hI.dpow p.1 p.2).prod = r } *
      Ideal.span { r : R | ∃ l : List (ℕ × R), (∀ p ∈ l, p.2 ∈ S) ∧ n ≤ (l.map Prod.fst).sum ∧
        (l.map fun p ↦ hI.dpow p.1 p.2).prod = r } ≤
      Ideal.span { r : R | ∃ l : List (ℕ × R), (∀ p ∈ l, p.2 ∈ S) ∧
        m + n ≤ (l.map Prod.fst).sum ∧ (l.map fun p ↦ hI.dpow p.1 p.2).prod = r } := by
  rw [Ideal.span_mul_span, Ideal.span_le]
  rintro r ⟨_, ⟨l₁, hl₁, hm, rfl⟩, _, ⟨l₂, hl₂, hn, rfl⟩, rfl⟩
  refine Ideal.subset_span ⟨l₁ ++ l₂, ?_, ?_, ?_⟩
  · intro p hp
    rcases List.mem_append.mp hp with hp | hp
    · exact hl₁ p hp
    · exact hl₂ p hp
  · simp only [List.map_append, List.sum_append]
    exact Nat.add_le_add hm hn
  · simp [List.map_append, List.prod_append]

/-- Universal containment criterion: `hI.pdFiltration n ≤ K` if and only if every finite weighted
product of divided powers of elements of `I` of total weight at least `n` lies in `K`. -/
theorem pdFiltration_le_iff {n : ℕ} {K : Ideal R} :
    hI.pdFiltration n ≤ K ↔
      ∀ l : List (ℕ × R), (∀ p ∈ l, p.2 ∈ I) → n ≤ (l.map Prod.fst).sum →
        (l.map fun p ↦ hI.dpow p.1 p.2).prod ∈ K := by
  rw [pdFiltration_def, Ideal.span_le]
  constructor
  · intro h l hl hn
    exact h ⟨l, hl, hn, rfl⟩
  · rintro h r ⟨l, hl, hn, rfl⟩
    exact h l hl hn

/-- Every finite weighted product of divided powers of elements of `I` of total weight at least `n`
belongs to `hI.pdFiltration n`. -/
theorem list_prod_dpow_mem_pdFiltration {n : ℕ} (l : List (ℕ × R)) (hl : ∀ p ∈ l, p.2 ∈ I)
    (hn : n ≤ (l.map Prod.fst).sum) :
    (l.map fun p ↦ hI.dpow p.1 p.2).prod ∈ hI.pdFiltration n :=
  (hI.pdFiltration_le_iff.mp le_rfl) l hl hn

/-- An element `x : R` belongs to `hI.pdFiltration n` if and only if it is a finite
`R`-linear combination of weighted products `∏ j, hI.dpow e_j x_j` with `x_j ∈ I` and
`∑ j, e_j ≥ n`. -/
theorem mem_pdFiltration_iff {n : ℕ} {x : R} :
    x ∈ hI.pdFiltration n ↔
      ∃ (k : ℕ) (c : Fin k → R) (l : Fin k → List (ℕ × R)),
        (∀ i, ∀ p ∈ l i, p.2 ∈ I) ∧ (∀ i, n ≤ ((l i).map Prod.fst).sum) ∧
        ∑ i, c i * ((l i).map fun p ↦ hI.dpow p.1 p.2).prod = x := by
  constructor
  · intro hx
    rw [pdFiltration_def] at hx
    induction hx using Submodule.span_induction with
    | mem r hr =>
      obtain ⟨l, hl, hn, rfl⟩ := hr
      exact ⟨1, fun _ ↦ 1, fun _ ↦ l, fun _ ↦ hl, fun _ ↦ hn, by simp⟩
    | zero =>
      exact ⟨0, Fin.elim0, Fin.elim0, fun i ↦ i.elim0, fun i ↦ i.elim0, by simp⟩
    | add x y _ _ ihx ihy =>
      obtain ⟨k₁, c₁, l₁, hl₁, hn₁, rfl⟩ := ihx
      obtain ⟨k₂, c₂, l₂, hl₂, hn₂, rfl⟩ := ihy
      refine ⟨k₁ + k₂, Fin.append c₁ c₂, Fin.append l₁ l₂, ?_, ?_, ?_⟩
      · intro i
        induction i using Fin.addCases with
        | left i => simpa using hl₁ i
        | right i => simpa using hl₂ i
      · intro i
        induction i using Fin.addCases with
        | left i => simpa using hn₁ i
        | right i => simpa using hn₂ i
      · simp [Fin.sum_univ_add]
    | smul r x _ ihx =>
      obtain ⟨k, c, l, hl, hn, rfl⟩ := ihx
      refine ⟨k, fun i ↦ r * c i, l, hl, hn, ?_⟩
      simp [Finset.mul_sum, mul_assoc]
  · rintro ⟨k, c, l, hl, hn, rfl⟩
    exact Submodule.sum_mem _ fun i _ ↦
      Ideal.mul_mem_left _ (c i) (hI.list_prod_dpow_mem_pdFiltration (l i) (hl i) (hn i))

/-- For `x ∈ I` and `n : ℕ`, `hI.dpow n x` belongs to `hI.pdFiltration n`. -/
theorem dpow_mem_pdFiltration {n : ℕ} {x : R} (hx : x ∈ I) :
    hI.dpow n x ∈ hI.pdFiltration n := by
  simpa using hI.list_prod_dpow_mem_pdFiltration [(n, x)] (by simpa using hx) (by simp)

/-- The divided power filtration is decreasing: if `m ≤ n`, then
`hI.pdFiltration n ≤ hI.pdFiltration m`. -/
theorem pdFiltration_antitone : Antitone hI.pdFiltration := by
  intro m n hmn
  rw [pdFiltration_def, pdFiltration_def]
  exact hI.span_words_antitone (I : Set R) hmn

/-- For `x ∈ I` and `n ≤ m`, `hI.dpow m x` belongs to `hI.pdFiltration n`. -/
theorem dpow_mem_pdFiltration_of_le {m n : ℕ} (hmn : n ≤ m) {x : R} (hx : x ∈ I) :
    hI.dpow m x ∈ hI.pdFiltration n :=
  hI.pdFiltration_antitone hmn (hI.dpow_mem_pdFiltration hx)

/-- The zeroth divided power filtration step is the unit ideal `⊤`. -/
@[simp]
theorem pdFiltration_zero : hI.pdFiltration 0 = ⊤ := by
  rw [pdFiltration_def]
  exact hI.span_words_zero (I : Set R)

/-- The first divided power filtration step is `I` itself. -/
@[simp]
theorem pdFiltration_one : hI.pdFiltration 1 = I := by
  refine le_antisymm ?_ ?_
  · rw [pdFiltration_le_iff]
    intro l hl hsum
    induction l with
    | nil => simp at hsum
    | cons p t ih =>
      simp only [List.map_cons, List.prod_cons]
      rcases eq_or_ne p.1 0 with hp0 | hp0
      · simp only [List.map_cons, List.sum_cons, hp0, zero_add] at hsum
        exact I.mul_mem_left _ (ih (fun q hq ↦ hl q (List.mem_cons_of_mem p hq)) hsum)
      · exact I.mul_mem_right _ (hI.dpow_mem hp0 (hl p List.mem_cons_self))
  · intro x hx
    simpa [hI.dpow_one hx] using hI.dpow_mem_pdFiltration (n := 1) hx

/-- Every positive step of the divided power filtration is contained in `I`. -/
theorem pdFiltration_le_self {n : ℕ} (hn : n ≠ 0) : hI.pdFiltration n ≤ I := by
  simpa using hI.pdFiltration_antitone (Nat.one_le_iff_ne_zero.mpr hn)

/-- The divided power filtration is multiplicative: `Fᵐ · Fⁿ ≤ Fᵐ⁺ⁿ`. -/
theorem pdFiltration_mul_le (m n : ℕ) :
    hI.pdFiltration m * hI.pdFiltration n ≤ hI.pdFiltration (m + n) := by
  rw [pdFiltration_def, pdFiltration_def, pdFiltration_def]
  exact hI.span_words_mul_le (I : Set R) m n

/-- A finite product of divided powers over a `Finset` belongs to `hI.pdFiltration n` whenever the
sum of weights is at least `n`. -/
theorem prod_dpow_mem_pdFiltration {ι : Type*} {s : Finset ι} {e : ι → ℕ} {x : ι → R}
    (hx : ∀ i ∈ s, x i ∈ I) {n : ℕ} (hn : n ≤ ∑ i ∈ s, e i) :
    (∏ i ∈ s, hI.dpow (e i) (x i)) ∈ hI.pdFiltration n := by
  classical
  have hsum : ∀ {t : Finset ι}, (∀ i ∈ t, x i ∈ I) →
      (∏ i ∈ t, hI.dpow (e i) (x i)) ∈ hI.pdFiltration (∑ i ∈ t, e i) := by
    intro t ht
    induction t using Finset.induction with
    | empty => simp
    | @insert a t hat ih =>
      rw [Finset.prod_insert hat, Finset.sum_insert hat]
      exact hI.pdFiltration_mul_le _ _ <|
        Ideal.mul_mem_mul (hI.dpow_mem_pdFiltration (ht a (Finset.mem_insert_self a t)))
          (ih fun i hi ↦ ht i (Finset.mem_insert_of_mem hi))
  exact hI.pdFiltration_antitone hn (hsum hx)

/-- Powers of a divided power filtration step satisfy `(Fⁿ)ᵐ ≤ Fᵐⁿ`. -/
theorem pdFiltration_pow_le (m n : ℕ) :
    hI.pdFiltration n ^ m ≤ hI.pdFiltration (m * n) := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [pow_succ, Nat.succ_mul]
    exact (Ideal.mul_mono_left ih).trans (hI.pdFiltration_mul_le (m * n) n)

/-- Ordinary ideal powers are contained in the divided power filtration: `I ^ n ≤ Fⁿ`. -/
theorem pow_le_pdFiltration (n : ℕ) : I ^ n ≤ hI.pdFiltration n := by
  simpa using hI.pdFiltration_pow_le n 1

private theorem list_prod_eq_one_of_sum_eq_zero (l : List (ℕ × R)) (hl : ∀ p ∈ l, p.2 ∈ I)
    (hsum : (l.map Prod.fst).sum = 0) :
    (l.map fun p ↦ hI.dpow p.1 p.2).prod = 1 := by
  induction l with
  | nil => simp
  | cons p t ih =>
    simp only [List.map_cons, List.sum_cons, Nat.add_eq_zero_iff] at hsum
    simp only [List.map_cons, List.prod_cons, hsum.1,
      hI.dpow_zero (hl p List.mem_cons_self), one_mul]
    exact ih (fun q hq ↦ hl q (List.mem_cons_of_mem p hq)) hsum.2

private theorem dpow_list_prod_mem_pdFiltration_mul {m : ℕ} (l : List (ℕ × R))
    (hl : ∀ p ∈ l, p.2 ∈ I) (hpos : (l.map Prod.fst).sum ≠ 0) :
    hI.dpow m (l.map fun p ↦ hI.dpow p.1 p.2).prod ∈
      hI.pdFiltration (m * (l.map Prod.fst).sum) := by
  induction l with
  | nil => simp at hpos
  | cons p t ih =>
    have hpI : p.2 ∈ I := hl p List.mem_cons_self
    have htI : ∀ q ∈ t, q.2 ∈ I := fun q hq ↦ hl q (List.mem_cons_of_mem p hq)
    simp only [List.map_cons, List.prod_cons, List.sum_cons]
    rcases eq_or_ne p.1 0 with hp0 | hp0
    · simp only [hp0, hI.dpow_zero hpI, one_mul, zero_add]
      exact ih htI (by simpa [hp0] using hpos)
    · rcases eq_or_ne (t.map Prod.fst).sum 0 with ht0 | ht0
      · rw [hI.list_prod_eq_one_of_sum_eq_zero t htI ht0, mul_one, ht0, add_zero,
          hI.dpow_comp hp0 hpI]
        exact (hI.pdFiltration (m * p.1)).mul_mem_left _ (hI.dpow_mem_pdFiltration hpI)
      · have hprodI : (t.map fun q ↦ hI.dpow q.1 q.2).prod ∈ I :=
          hI.pdFiltration_le_self ht0 (hI.list_prod_dpow_mem_pdFiltration t htI le_rfl)
        rw [hI.dpow_mul hprodI, mul_add]
        have hpow : hI.dpow p.1 p.2 ^ m ∈ hI.pdFiltration (m * p.1) :=
          hI.pdFiltration_pow_le m p.1 (Ideal.pow_mem_pow (hI.dpow_mem_pdFiltration hpI) m)
        exact hI.pdFiltration_mul_le (m * p.1) (m * (t.map Prod.fst).sum)
          (Ideal.mul_mem_mul hpow (ih htI ht0))

/-- For `n ≠ 0` and `x ∈ hI.pdFiltration n`, its `m`-th divided power lies in
`hI.pdFiltration (m * n)`. -/
theorem dpow_mem_pdFiltration_mul {m n : ℕ} (hn : n ≠ 0) {x : R}
    (hx : x ∈ hI.pdFiltration n) :
    hI.dpow m x ∈ hI.pdFiltration (m * n) := by
  let K : Ideal R :=
    { carrier := { y ∈ I | ∀ k : ℕ, hI.dpow k y ∈ hI.pdFiltration (k * n) }
      zero_mem' := by
        refine ⟨I.zero_mem, fun k ↦ ?_⟩
        rcases eq_or_ne k 0 with rfl | hk
        · simp
        · rw [hI.dpow_eval_zero hk]
          exact Ideal.zero_mem _
      add_mem' := by
        rintro a b ⟨haI, ha⟩ ⟨hbI, hb⟩
        refine ⟨I.add_mem haI hbI, fun k ↦ ?_⟩
        rw [hI.dpow_add haI hbI]
        refine Submodule.sum_mem _ fun p hp ↦ ?_
        have hmul : k * n = p.1 * n + p.2 * n := by
          rw [← add_mul, Finset.mem_antidiagonal.mp hp]
        rw [hmul]
        exact hI.pdFiltration_mul_le _ _ (Ideal.mul_mem_mul (ha p.1) (hb p.2))
      smul_mem' := by
        rintro c a ⟨haI, ha⟩
        refine ⟨I.mul_mem_left c haI, fun k ↦ ?_⟩
        rw [smul_eq_mul, hI.dpow_mul haI]
        exact (hI.pdFiltration (k * n)).mul_mem_left (c ^ k) (ha k) }
  have hle : hI.pdFiltration n ≤ K := by
    rw [pdFiltration_le_iff]
    intro l hl hsum
    have hpos : (l.map Prod.fst).sum ≠ 0 := by omega
    refine ⟨hI.pdFiltration_le_self hpos (hI.list_prod_dpow_mem_pdFiltration l hl le_rfl),
      fun k ↦ ?_⟩
    exact hI.pdFiltration_antitone (Nat.mul_le_mul_left k hsum)
      (hI.dpow_list_prod_mem_pdFiltration_mul l hl hpos)
  exact (hle hx).2 m

/-- Every positive step `hI.pdFiltration n` (`n ≠ 0`) is a sub-dp-ideal of `(I, hI)`. -/
theorem isSubDPIdeal_pdFiltration {n : ℕ} (hn : n ≠ 0) :
    hI.IsSubDPIdeal (hI.pdFiltration n) where
  isSubideal := hI.pdFiltration_le_self hn
  dpow_mem _ hm _ hx :=
    hI.pdFiltration_antitone (Nat.le_mul_of_pos_left n (Nat.pos_of_ne_zero hm))
      (hI.dpow_mem_pdFiltration_mul hn hx)

end Basic

section Generators

variable {R : Type*} [CommSemiring R] {I : Ideal R} (hI : DividedPowers I)

private theorem dpow_mem_span_words {S : Set R} (hS : I = Ideal.span S) {x : R} (hx : x ∈ I)
    (e : ℕ) :
    hI.dpow e x ∈
      Ideal.span { r : R | ∃ l : List (ℕ × R), (∀ p ∈ l, p.2 ∈ S) ∧ e ≤ (l.map Prod.fst).sum ∧
        (l.map fun p ↦ hI.dpow p.1 p.2).prod = r } := by
  rw [hS] at hx
  revert e
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
  · intro s hs e
    exact Ideal.subset_span ⟨[(e, s)], by simpa using hs, by simp, by simp⟩
  · intro e
    rcases eq_or_ne e 0 with rfl | he
    · rw [hI.dpow_zero I.zero_mem, hI.span_words_zero S]
      exact Submodule.mem_top
    · rw [hI.dpow_eval_zero he]
      exact Ideal.zero_mem _
  · intro a b ha hb iha ihb e
    rw [hI.dpow_add (hS ▸ ha) (hS ▸ hb)]
    refine Submodule.sum_mem _ fun p hp ↦ ?_
    rw [← Finset.mem_antidiagonal.mp hp]
    exact hI.span_words_mul_le S p.1 p.2 (Ideal.mul_mem_mul (iha p.1) (ihb p.2))
  · intro c a ha iha e
    rw [smul_eq_mul, hI.dpow_mul (hS ▸ ha)]
    exact Ideal.mul_mem_left _ (c ^ e) (iha e)

/-- If `I = Ideal.span S`, then `hI.pdFiltration n` is generated by the finite weighted products
of divided powers of elements of `S` of total weight at least `n`. -/
theorem pdFiltration_eq_span_of_eq_span {S : Set R} (hS : I = Ideal.span S) (n : ℕ) :
    hI.pdFiltration n =
      Ideal.span { r : R | ∃ l : List (ℕ × R), (∀ p ∈ l, p.2 ∈ S) ∧ n ≤ (l.map Prod.fst).sum ∧
        (l.map fun p ↦ hI.dpow p.1 p.2).prod = r } := by
  have hSI : S ⊆ (I : Set R) := hS ▸ Ideal.subset_span
  refine le_antisymm ?_ ?_
  · rw [pdFiltration_le_iff]
    intro l hl hn
    have hprod : ∀ {t : List (ℕ × R)}, (∀ p ∈ t, p.2 ∈ I) →
        (t.map fun p ↦ hI.dpow p.1 p.2).prod ∈
          Ideal.span { r : R | ∃ l : List (ℕ × R), (∀ p ∈ l, p.2 ∈ S) ∧
            (t.map Prod.fst).sum ≤ (l.map Prod.fst).sum ∧
            (l.map fun p ↦ hI.dpow p.1 p.2).prod = r } := by
      intro t ht
      induction t with
      | nil =>
        simp only [List.map_nil, List.prod_nil, List.sum_nil]
        rw [hI.span_words_zero S]
        exact Submodule.mem_top
      | cons p t ih =>
        simp only [List.map_cons, List.prod_cons, List.sum_cons]
        exact hI.span_words_mul_le S p.1 (t.map Prod.fst).sum
          (Ideal.mul_mem_mul (hI.dpow_mem_span_words hS (ht p List.mem_cons_self) p.1)
            (ih fun q hq ↦ ht q (List.mem_cons_of_mem p hq)))
    exact hI.span_words_antitone S hn (hprod hl)
  · rw [pdFiltration_def]
    refine Ideal.span_mono ?_
    rintro r ⟨l, hlS, hln, rfl⟩
    exact ⟨l, fun p hp ↦ hSI (hlS p hp), hln, rfl⟩

/-- Containment criterion for `hI.pdFiltration n` in terms of a generating set `S` of `I`. -/
theorem pdFiltration_le_iff_of_eq_span {S : Set R} (hS : I = Ideal.span S) {n : ℕ}
    {K : Ideal R} :
    hI.pdFiltration n ≤ K ↔
      ∀ l : List (ℕ × R), (∀ p ∈ l, p.2 ∈ S) → n ≤ (l.map Prod.fst).sum →
        (l.map fun p ↦ hI.dpow p.1 p.2).prod ∈ K := by
  rw [hI.pdFiltration_eq_span_of_eq_span hS n, Ideal.span_le]
  constructor
  · intro h l hl hn
    exact h ⟨l, hl, hn, rfl⟩
  · rintro h r ⟨l, hl, hn, rfl⟩
    exact h l hl hn

/-- For a principal ideal `I = Ideal.span {a}`, `hI.pdFiltration n` is generated by the divided
powers `hI.dpow m a` with `m ≥ n`. -/
theorem pdFiltration_eq_span_of_eq_span_singleton {a : R} (ha : I = Ideal.span {a}) (n : ℕ) :
    hI.pdFiltration n = Ideal.span ((fun m ↦ hI.dpow m a) '' Set.Ici n) := by
  have haI : a ∈ I := ha ▸ Ideal.subset_span (Set.mem_singleton a)
  refine le_antisymm ?_ ?_
  · rw [hI.pdFiltration_le_iff_of_eq_span ha]
    intro l hl hn
    have hprod : (l.map fun p ↦ hI.dpow p.1 p.2).prod =
        ∏ i : Fin l.length, hI.dpow l[i].1 a := by
      conv_lhs => rw [← List.ofFn_get l, List.map_ofFn, Fin.prod_ofFn]
      refine Finset.prod_congr rfl fun i _ ↦ ?_
      dsimp
      rw [Set.mem_singleton_iff.mp (hl l[↑i] (List.getElem_mem _))]
    have hsum : (l.map Prod.fst).sum = ∑ i : Fin l.length, l[i].1 := by
      conv_lhs => rw [← List.ofFn_get l, List.map_ofFn, Fin.sum_ofFn]
      rfl
    rw [hprod, hI.prod_dpow haI, ← hsum]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨(l.map Prod.fst).sum, hn, rfl⟩)
  · rw [Ideal.span_le]
    rintro _ ⟨m, hm, rfl⟩
    exact hI.dpow_mem_pdFiltration_of_le hm haI

/-- Containment criterion for `hI.pdFiltration n` when `I = Ideal.span {a}` is principal. -/
theorem pdFiltration_le_iff_of_eq_span_singleton {a : R} (ha : I = Ideal.span {a}) {n : ℕ}
    {K : Ideal R} :
    hI.pdFiltration n ≤ K ↔ ∀ m : ℕ, n ≤ m → hI.dpow m a ∈ K := by
  rw [hI.pdFiltration_eq_span_of_eq_span_singleton ha n, Ideal.span_le, Set.image_subset_iff]
  rfl

end Generators

section Functoriality

variable {R S : Type*} [CommSemiring R] [CommSemiring S] {I : Ideal R} {J : Ideal S}
  {hI : DividedPowers I} {hJ : DividedPowers J}

/-- A divided power morphism maps each filtration step into the corresponding step of the target:
`(hI.pdFiltration n).map f ≤ hJ.pdFiltration n`. -/
theorem IsDPMorphism.map_pdFiltration_le {f : R →+* S} (hf : IsDPMorphism hI hJ f) (n : ℕ) :
    (hI.pdFiltration n).map f ≤ hJ.pdFiltration n := by
  rw [Ideal.map_le_iff_le_comap, pdFiltration_le_iff]
  intro l hl hn
  rw [Ideal.mem_comap]
  have hmap : ∀ {t : List (ℕ × R)}, (∀ p ∈ t, p.2 ∈ I) →
      f (t.map fun p ↦ hI.dpow p.1 p.2).prod =
        ((t.map fun p ↦ (p.1, f p.2)).map fun q ↦ hJ.dpow q.1 q.2).prod := by
    intro t ht
    rw [map_list_prod]
    congr 1
    induction t with
    | nil => simp
    | cons p t ih =>
      simp only [List.map_cons, List.cons.injEq]
      exact ⟨hf.map_dpow (ht p List.mem_cons_self),
        ih fun q hq ↦ ht q (List.mem_cons_of_mem p hq)⟩
  rw [hmap hl]
  refine hJ.list_prod_dpow_mem_pdFiltration _ ?_ ?_
  · intro q hq
    obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hq
    exact hf.ideal_comp (Ideal.mem_map_of_mem f (hl p hp))
  · simpa [List.map_map, Function.comp_def] using hn

/-- If `f` is a divided power morphism with `I.map f = J` (no surjectivity on `f` required), then
`(hI.pdFiltration n).map f = hJ.pdFiltration n` for every `n`. -/
theorem IsDPMorphism.map_pdFiltration_eq {f : R →+* S} (hf : IsDPMorphism hI hJ f)
    (hIJ : I.map f = J) (n : ℕ) :
    (hI.pdFiltration n).map f = hJ.pdFiltration n := by
  refine le_antisymm (hf.map_pdFiltration_le n) ?_
  have hJspan : J = Ideal.span (f '' (I : Set R)) := hIJ.symm
  rw [hJ.pdFiltration_le_iff_of_eq_span hJspan]
  intro l hl hn
  have hlift : ∀ {t : List (ℕ × S)}, (∀ p ∈ t, p.2 ∈ f '' (I : Set R)) →
      ∃ t' : List (ℕ × R), (∀ p ∈ t', p.2 ∈ I) ∧
        (t'.map Prod.fst).sum = (t.map Prod.fst).sum ∧
        f (t'.map fun p ↦ hI.dpow p.1 p.2).prod = (t.map fun p ↦ hJ.dpow p.1 p.2).prod := by
    intro t ht
    induction t with
    | nil => exact ⟨[], by simp, by simp, by simp⟩
    | cons q t ih =>
      obtain ⟨x, hxI, hxq⟩ := ht q List.mem_cons_self
      obtain ⟨t', ht'I, hsum, hprod⟩ := ih fun p hp ↦ ht p (List.mem_cons_of_mem q hp)
      refine ⟨(q.1, x) :: t', ?_, ?_, ?_⟩
      · intro p hp
        rcases List.mem_cons.mp hp with rfl | hp
        · exact hxI
        · exact ht'I p hp
      · simp [hsum]
      · simp only [List.map_cons, List.prod_cons, map_mul, hprod, hf.map_dpow hxI, hxq]
  obtain ⟨l', hl'I, hsum, hprod⟩ := hlift hl
  rw [← hprod]
  exact Ideal.mem_map_of_mem f (hI.list_prod_dpow_mem_pdFiltration l' hl'I (hsum ▸ hn))

/-- The divided power filtration transfers along a ring equivalence via `Ideal.map`. -/
theorem pdFiltration_ofRingEquiv {e : R ≃+* S} (h : I.map e = J) (hI : DividedPowers I) (n : ℕ) :
    (ofRingEquiv h hI).pdFiltration n = (hI.pdFiltration n).map e := by
  have hf : IsDPMorphism hI (ofRingEquiv h hI) (e : R →+* S) :=
    ⟨le_of_eq h, fun a _ ↦ ofRingEquiv_dpow_apply h hI⟩
  exact (hf.map_pdFiltration_eq h n).symm

end Functoriality

section SpecialCases

variable {R : Type*} [CommSemiring R] {I : Ideal R}

/-- If `hI.dpow m x ∈ I ^ m` for every `m ≥ 2` and every `x ∈ I`, then the divided power filtration
coincides with the ordinary power filtration `I ^ n`. -/
theorem pdFiltration_eq_pow_of_dpow_mem_pow (hI : DividedPowers I)
    (h : ∀ m ≥ 2, ∀ x ∈ I, hI.dpow m x ∈ I ^ m) (n : ℕ) :
    hI.pdFiltration n = I ^ n := by
  have hall : ∀ m : ℕ, ∀ x ∈ I, hI.dpow m x ∈ I ^ m := by
    rintro (_ | _ | m) x hx
    · simp
    · simpa [hI.dpow_one hx] using hx
    · exact h (m + 2) (by omega) x hx
  refine le_antisymm ?_ (hI.pow_le_pdFiltration n)
  rw [pdFiltration_le_iff]
  intro l hl hn
  have hprod : ∀ {t : List (ℕ × R)}, (∀ p ∈ t, p.2 ∈ I) →
      (t.map fun p ↦ hI.dpow p.1 p.2).prod ∈ I ^ (t.map Prod.fst).sum := by
    intro t ht
    induction t with
    | nil => simp
    | cons p t ih =>
      simp only [List.map_cons, List.prod_cons, List.sum_cons, pow_add]
      exact Ideal.mul_mem_mul (hall p.1 p.2 (ht p List.mem_cons_self))
        (ih fun q hq ↦ ht q (List.mem_cons_of_mem p hq))
  exact Ideal.pow_le_pow_right hn (hprod hl)

/-- The divided power filtration coincides with the ordinary power filtration `I ^ n` for all `n`
if and only if `hI.dpow m x ∈ I ^ m` for every `m ≥ 2` and `x ∈ I`. -/
theorem pdFiltration_eq_pow_iff (hI : DividedPowers I) :
    (∀ n : ℕ, hI.pdFiltration n = I ^ n) ↔ ∀ m ≥ 2, ∀ x ∈ I, hI.dpow m x ∈ I ^ m :=
  ⟨fun h m _ _ hx ↦ h m ▸ hI.dpow_mem_pdFiltration hx, hI.pdFiltration_eq_pow_of_dpow_mem_pow⟩

/-- For the zero ideal equipped with `dividedPowersBot`, every filtration step equals `⊥ ^ n`. -/
theorem pdFiltration_bot (R : Type*) [CommSemiring R] (n : ℕ) :
    (dividedPowersBot R).pdFiltration n = (⊥ : Ideal R) ^ n := by
  refine pdFiltration_eq_pow_of_dpow_mem_pow (dividedPowersBot R) (fun m hm _ hx ↦ ?_) n
  rw [Ideal.mem_bot.mp hx, (dividedPowersBot R).dpow_eval_zero (by omega)]
  exact Ideal.zero_mem _

/-- For the zero ideal equipped with `dividedPowersBot`, every positive filtration step is `⊥`. -/
@[simp]
theorem pdFiltration_bot_of_ne_zero (R : Type*) [CommSemiring R] {n : ℕ} (hn : n ≠ 0) :
    (dividedPowersBot R).pdFiltration n = ⊥ := by
  rw [pdFiltration_bot, Ideal.zero_eq_bot.symm, zero_pow hn]

/-- In a `ℚ`-algebra, the divided power filtration of any divided power structure coincides with
the ordinary ideal power filtration `I ^ n`. -/
theorem pdFiltration_eq_pow [Algebra ℚ R] (hI : DividedPowers I) (n : ℕ) :
    hI.pdFiltration n = I ^ n := by
  refine hI.pdFiltration_eq_pow_of_dpow_mem_pow (fun m _ x hx ↦ ?_) n
  rw [RatAlgebra.dpow_eq_inv_fact_smul I hI hx, Algebra.smul_def]
  exact (I ^ m).mul_mem_left _ (Ideal.pow_mem_pow hx m)

namespace OfInvertibleFactorial

/-- For `OfInvertibleFactorial.dividedPowers`, the divided power filtration equals `I ^ n`. -/
theorem pdFiltration_eq_pow [DecidablePred (fun x : R ↦ x ∈ I)] {k : ℕ}
    (hk_fac : IsUnit ((k - 1).factorial : R)) (hkI : I ^ k = 0) (n : ℕ) :
    (OfInvertibleFactorial.dividedPowers hk_fac hkI).pdFiltration n = I ^ n := by
  refine pdFiltration_eq_pow_of_dpow_mem_pow _ (fun m _ x hx ↦ ?_) n
  rw [dpow_apply, ite_eq_left hx]
  exact (I ^ m).mul_mem_left _ (Ideal.pow_mem_pow hx m)

/-- For `OfInvertibleFactorial.dividedPowers`, the filtration vanishes from degree `k` onward. -/
theorem pdFiltration_eq_bot [DecidablePred (fun x : R ↦ x ∈ I)] {k : ℕ}
    (hk_fac : IsUnit ((k - 1).factorial : R)) (hkI : I ^ k = 0) {n : ℕ} (hn : k ≤ n) :
    (OfInvertibleFactorial.dividedPowers hk_fac hkI).pdFiltration n = ⊥ := by
  rw [pdFiltration_eq_pow hk_fac hkI n, ← Ideal.zero_eq_bot]
  exact eq_bot_iff.mpr ((Ideal.pow_le_pow_right hn).trans hkI.le)

end OfInvertibleFactorial

namespace OfSquareZero

/-- For `OfSquareZero.dividedPowers` on a square-zero ideal `I`, the divided power filtration
equals `I ^ n`. -/
theorem pdFiltration_eq_pow [DecidablePred (fun x : R ↦ x ∈ I)] (hI2 : I ^ 2 = 0) (n : ℕ) :
    (OfSquareZero.dividedPowers hI2).pdFiltration n = I ^ n :=
  OfInvertibleFactorial.pdFiltration_eq_pow (by simp) hI2 n

/-- For `OfSquareZero.dividedPowers` on a square-zero ideal `I`, the filtration vanishes from
degree `2` onward. -/
theorem pdFiltration_eq_bot [DecidablePred (fun x : R ↦ x ∈ I)] (hI2 : I ^ 2 = 0) {n : ℕ}
    (hn : 2 ≤ n) :
    (OfSquareZero.dividedPowers hI2).pdFiltration n = ⊥ :=
  OfInvertibleFactorial.pdFiltration_eq_bot (by simp) hI2 hn

end OfSquareZero

namespace IsNilpotent

/-- For `DividedPowers.IsNilpotent.dividedPowers`, the divided power filtration equals `I ^ n`. -/
theorem pdFiltration_eq_pow {A : Type*} [CommRing A] {p : ℕ} [Fact p.Prime]
    (hp : _root_.IsNilpotent (p : A)) {J : Ideal A} [DecidablePred (fun x ↦ x ∈ J)]
    (hJp : J ^ p = 0) (n : ℕ) :
    (DividedPowers.IsNilpotent.dividedPowers hp hJp).pdFiltration n = J ^ n :=
  OfInvertibleFactorial.pdFiltration_eq_pow _ hJp n

end IsNilpotent

namespace CharP

/-- For `DividedPowers.CharP.dividedPowers`, the divided power filtration equals `I ^ n`. -/
theorem pdFiltration_eq_pow (A : Type*) [CommRing A] (p : ℕ) [_root_.CharP A p] [Fact p.Prime]
    {J : Ideal A} [DecidablePred (fun x ↦ x ∈ J)] (hJp : J ^ p = 0) (n : ℕ) :
    (DividedPowers.CharP.dividedPowers A p hJp).pdFiltration n = J ^ n :=
  IsNilpotent.pdFiltration_eq_pow _ hJp n

end CharP

end SpecialCases

end DividedPowers
