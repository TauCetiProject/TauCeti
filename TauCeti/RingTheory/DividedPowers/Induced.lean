module

public import Mathlib.RingTheory.DividedPowers.DPMorphism
public import Mathlib.RingTheory.DividedPowers.Padic

/-!
# Divided powers induced from an overring

When every factorial `n !` is a unit of a commutative semiring `B`, every ideal of `B` carries the
divided powers `x ↦ x ^ n / n!`. Divided powers on an ideal of a subring of such a `B` are then
inherited from `B`, as soon as the subring ideal is stable under `x ↦ x ^ n / n!`. This is how
divided power envelopes are built inside a localization in which the factorials become units,
for instance the principal Fontaine envelope inside `A[1/p]` for a `ℤ_[p]`-algebra `A`.

Mathlib's `DividedPowers.ofInjective` induces divided powers on an ideal `I` of `A` along an
injective ring map `f : A →+* B`, from divided powers on `I.map f`, provided that each divided
power `hJ.dpow n (f x)` with `x ∈ I` is the image of an element of `A` which lies in `I` when
`n ≠ 0`. This file shows that this condition only has to be checked on a set of generators of
`I`, and that `f` is then a divided power morphism.

Divided powers are unique on an ideal of a ring in which every factorial is a regular element,
since `n! • dpow n x = x ^ n`; this applies to every subring of a ring in which the factorials are
units.

## Main definitions

* `DividedPowers.ofIsUnitFactorial`: the divided powers `x ↦ x ^ n / n!` on an ideal of a
  semiring in which every factorial is a unit.

## Main results

* `DividedPowers.ofIsUnitFactorial_dpow`: the formula for `DividedPowers.ofIsUnitFactorial`.
* `DividedPowers.exists_dpow_eq_of_mem_span`: the hypothesis of `DividedPowers.ofInjective` holds
  on an ideal as soon as it holds on a set of generators.
* `DividedPowers.isDPMorphism_ofInjective`: the induced divided powers make `f` a divided power
  morphism.
* `DividedPowers.eq_of_isSMulRegular_factorial`: divided powers are unique on an ideal of a ring
  in which every factorial is a regular element.

## References

The definition of `DividedPowers.ofIsUnitFactorial` follows Mathlib's
`DividedPowers.RatAlgebra.dividedPowers` (A. Chambert-Loir and M. I. de Frutos-Fernández), with
the invertibility of the factorials as a hypothesis in place of a `ℚ`-algebra structure, which
rings such as `A[1/p]` for a `ℤ_[p]`-algebra `A` do not carry as an instance. The span induction
in `DividedPowers.exists_dpow_eq_of_mem_span` follows Mathlib's
`DividedPowers.span_isSubDPIdeal_iff`.

* P. Berthelot and A. Ogus, *Notes on crystalline cohomology*, Princeton University Press, 1978,
  §3, Example 3.2(2) and Lemma 3.6.
-/

public section

open Finset Ideal Nat

namespace DividedPowers

section InvertibleFactorial

variable {B : Type*} [CommSemiring B]

/-- If every factorial is a unit of `B`, then every ideal `I` of `B` has the divided powers
`x ↦ x ^ n / n!`. Over a `ℚ`-algebra this is `DividedPowers.RatAlgebra.dividedPowers`. -/
noncomputable def ofIsUnitFactorial (h : ∀ n : ℕ, IsUnit (n ! : B)) (I : Ideal B) :
    DividedPowers I :=
  open scoped Classical in
  { dpow := OfInvertibleFactorial.dpow I
    dpow_null := OfInvertibleFactorial.dpow_null
    dpow_zero := OfInvertibleFactorial.dpow_zero
    dpow_one := OfInvertibleFactorial.dpow_one
    dpow_mem := fun hn hx ↦ OfInvertibleFactorial.dpow_mem hn hx
    dpow_add := fun {n} _ _ hx hy ↦
      OfInvertibleFactorial.dpow_add_of_lt (h _) n.lt_succ_self hx hy
    dpow_mul := OfInvertibleFactorial.dpow_mul
    mul_dpow := fun {m} k _ hx ↦
      OfInvertibleFactorial.dpow_mul_of_add_lt (h _) (m + k).lt_succ_self hx
    dpow_comp := fun hk hx ↦
      OfInvertibleFactorial.dpow_comp_of_mul_lt (h _) hk (lt_add_one _) hx }

/-- The divided powers `DividedPowers.ofIsUnitFactorial h I` are `x ↦ x ^ n / n!` on `I`. -/
theorem ofIsUnitFactorial_dpow (h : ∀ n : ℕ, IsUnit (n ! : B)) {I : Ideal B} (n : ℕ) {x : B}
    (hx : x ∈ I) : (ofIsUnitFactorial h I).dpow n x = Ring.inverse (n ! : B) * x ^ n := by
  classical
  exact OfInvertibleFactorial.dpow_eq_of_mem (I := I) (m := n) hx

end InvertibleFactorial

section Injective

variable {A B : Type*} [CommSemiring A] [CommSemiring B] {J : Ideal B}

/-- The hypothesis of `DividedPowers.ofInjective` holds on the ideal generated by a set `S` as soon
as it holds at every element of `S`: if each positive divided power `hJ.dpow n (f s)`, `s ∈ S`, is
the image of an element of `Ideal.span S`, then so is `hJ.dpow n (f x)` for every
`x ∈ Ideal.span S` and `n ≠ 0`. -/
theorem exists_dpow_eq_of_mem_span (f : A →+* B) (hJ : DividedPowers J) {S : Set A}
    (hSJ : ∀ s ∈ S, f s ∈ J)
    (hS : ∀ n ≠ 0, ∀ s ∈ S, ∃ y ∈ span S, f y = hJ.dpow n (f s))
    (n : ℕ) {x : A} (hx : x ∈ span S) :
    ∃ (y : A) (_ : n ≠ 0 → y ∈ span S), f y = hJ.dpow n (f x) := by
  have hmemJ {z : A} (hz : z ∈ span S) : f z ∈ J := by
    have hz' := mem_map_of_mem f hz
    rw [map_span] at hz'
    exact (span_le.mpr (by rintro _ ⟨s, hs, rfl⟩; exact hSJ s hs)) hz'
  -- In degree `0` the divided power is `1 = f 1`.
  have hzero {z : A} (hz : z ∈ span S) :
      ∃ (y : A) (_ : (0 : ℕ) ≠ 0 → y ∈ span S), f y = hJ.dpow 0 (f z) :=
    ⟨1, fun h ↦ absurd rfl h, by rw [map_one, hJ.dpow_zero (hmemJ hz)]⟩
  induction hx using Submodule.span_induction generalizing n with
  | mem s hs =>
    obtain rfl | hn := eq_or_ne n 0
    · exact hzero (subset_span hs)
    · obtain ⟨y, hy, hfy⟩ := hS n hn s hs
      exact ⟨y, fun _ ↦ hy, hfy⟩
  | zero =>
    obtain rfl | hn := eq_or_ne n 0
    · exact hzero (zero_mem _)
    · exact ⟨0, fun _ ↦ zero_mem _, by rw [map_zero, hJ.dpow_eval_zero hn]⟩
  | add x y hx hy ihx ihy =>
    choose gx hgx hfgx using ihx
    choose gy hgy hfgy using ihy
    refine ⟨∑ k ∈ antidiagonal n, gx k.1 * gy k.2, fun hn ↦ sum_mem fun k hk ↦ ?_, ?_⟩
    · obtain hk1 | hk1 := eq_or_ne k.1 0
      · have hk2 : k.2 ≠ 0 := by rw [mem_antidiagonal] at hk; omega
        exact mul_mem_left _ _ (hgy _ hk2)
      · exact mul_mem_right _ _ (hgx _ hk1)
    · simp only [map_sum, map_mul, hfgx, hfgy, map_add, hJ.dpow_add (hmemJ hx) (hmemJ hy)]
  | smul a x hx ihx =>
    obtain ⟨y, hy, hfy⟩ := ihx n
    refine ⟨a ^ n * y, fun hn ↦ mul_mem_left _ _ (hy hn), ?_⟩
    rw [smul_eq_mul, map_mul, map_mul, map_pow, hfy, hJ.dpow_mul (hmemJ hx)]

/-- The divided powers induced by `DividedPowers.ofInjective` along `f` make `f` a divided power
morphism. -/
theorem isDPMorphism_ofInjective (I : Ideal A) (f : A →+* B) (hf : Function.Injective f)
    (hJ : DividedPowers J) (hIJ : I.map f = J)
    (hmem : ∀ (n : ℕ) {x : A} (_ : x ∈ I), ∃ (y : A) (_ : n ≠ 0 → y ∈ I),
      f y = hJ.dpow n (f x)) :
    IsDPMorphism (ofInjective I J f hf hJ hIJ hmem) hJ f := by
  refine ⟨hIJ.le, fun {n} x hx ↦ ?_⟩
  simp only [ofInjective, hx, ↓reduceDIte]
  exact (Exists.choose_spec (hmem n hx)).2.symm

end Injective

/-- Divided powers on an ideal of a ring in which every factorial is a regular element are unique,
since `n! * dpow n x = x ^ n`. -/
theorem eq_of_isSMulRegular_factorial {A : Type*} [CommSemiring A] {I : Ideal A}
    (h : ∀ n : ℕ, IsSMulRegular A (n ! : A)) (hI hI' : DividedPowers I) : hI = hI' :=
  hI.ext hI' fun n x hx ↦ h n <| by
    simp only [smul_eq_mul, factorial_mul_dpow_eq_pow _ hx]

end DividedPowers
