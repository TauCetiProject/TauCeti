import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination

/-!
# Basis of the one-variable divided power pre-envelope

For a commutative ring `T` and a subset `J : Set T`, `TauCeti.pdPreEnvelope T J` is the
`T`-subalgebra of `T ⊗[ℤ] ℚ` generated by the divided powers `(x ^ n) ⊗ₜ (n ! : ℚ)⁻¹` for
`x ∈ J` and `n : ℕ`.

When `T` is a `B`-algebra with a `B`-basis `u a * v ^ n` (`a : I`, `n : ℕ`) and `z = t - v` for
some `t : B`, we first show that the involution `v ↦ t - v` produces a `B`-basis `u a * z ^ n`
of `T` (`TauCeti.basis_sub_of_basis_mul_pow`). Assuming `B` is flat over `ℤ` (equivalently
`ℤ`-torsion-free), we then show that `pdPreEnvelope T {z}` has a `B`-basis `u a * y n` where
`z ^ n = n ! * y n` (`TauCeti.exists_pdPreEnvelope_basis`).

## Main definitions and results

* `TauCeti.pdPreEnvelope`: the `T`-subalgebra of `T ⊗[ℤ] ℚ` generated by `x ^ n / n !` for
  `x ∈ J`.
* `TauCeti.basis_sub_of_basis_mul_pow`: change of basis from `u a * v ^ n` to
  `u a * (t - v) ^ n`.
* `TauCeti.exists_pdPreEnvelope_basis`: if `B` is `ℤ`-flat and `T` has `B`-basis `u a * v ^ n`,
  then `pdPreEnvelope T {t - v}` has `B`-basis `u a * y n` with `(t - v) ^ n = n ! * y n`.

## Provenance

Adapted from `grh-lean` (<https://github.com/lsernau/grh-lean>, commit
`72fead102f663d5c7a407964a13dc0cf9d977207`),
`src/Lib/PadicComparison/Crystalline/DividedPowerEnvelope.lean`
(`New.Variety.preEnvelope`, `New.Variety.exists_preEnvelope_basis`).
-/

public section

noncomputable section

namespace TauCeti

open Algebra Module Submodule TensorProduct Polynomial Nat

variable {B T I : Type*} [CommRing B] [CommRing T] [Algebra B T]

/-- The `T`-subalgebra of `T ⊗[ℤ] ℚ` generated by the divided powers `(x ^ n) ⊗ₜ (n ! : ℚ)⁻¹`
for `x ∈ J` and `n : ℕ`. -/
def pdPreEnvelope (T : Type*) [CommRing T] (J : Set T) : Subalgebra T (T ⊗[ℤ] ℚ) :=
  Algebra.adjoin T {(x ^ n) ⊗ₜ[ℤ] (n ! : ℚ)⁻¹ | (x ∈ J) (n : ℕ)}

/-- The `n`-th divided power `z ^ n / n !` inside `pdPreEnvelope T {z}`. -/
def pdPreEnvelope.dividedPow (z : T) (n : ℕ) : pdPreEnvelope T {z} :=
  ⟨(z ^ n) ⊗ₜ (n ! : ℚ)⁻¹, Algebra.subset_adjoin ⟨z, rfl, n, rfl⟩⟩

/-- The multiplication law for divided powers: `(z ^ n / n!) * (z ^ m / m!) = C(n+m, n) *
(z ^ (n+m) / (n+m)!)`. -/
theorem pdPreEnvelope.dividedPow_mul (z : T) (n m : ℕ) :
    dividedPow z n * dividedPow z m = (n + m).choose n * dividedPow z (n + m) := by
  ext
  simp only [MulMemClass.coe_mul, Algebra.TensorProduct.tmul_mul_tmul, pow_add,
    SubringClass.coe_natCast, Algebra.TensorProduct.natCast_def', Nat.cast_add_choose,
    one_mul, dividedPow]
  field_simp

/-- If `T` has a `B`-basis `b (a, n) = u a * v ^ n` and `z = t - v` with `t : B`, then the
elements `u a * z ^ n` also form a `B`-basis of `T`. -/
theorem basis_sub_of_basis_mul_pow (b : Basis (I × ℕ) B T) (u : I → T) {v z : T} {t : B}
    (hb : ∀ (a : I) (n : ℕ), b (a, n) = u a * v ^ n) (hz : algebraMap B T t - v = z) :
    ∃ b' : Basis (I × ℕ) B T, ∀ (a : I) (n : ℕ), b' (a, n) = u a * z ^ n := by
  let F : T →ₗ[B] T := b.constr B fun j ↦ u j.fst * z ^ j.snd
  have hF : F.comp F = LinearMap.id := by
    refine b.ext fun (a, n) ↦ ?_
    have h_aeval (w : T) : aeval w ((C t - X) ^ n) = (algebraMap B T t - w) ^ n := by
      simp [map_pow, map_sub]
    have h_expand (w : T) : u a * (algebraMap B T t - w) ^ n =
        ∑ i ∈ Finset.range (((C t - X) ^ n).natDegree + 1),
          ((C t - X) ^ n).coeff i • (u a * w ^ i) := by
      rw [← h_aeval w, aeval_eq_sum_range, Finset.mul_sum]
      simp_rw [Algebra.smul_def, mul_left_comm]
    simp only [LinearMap.comp_apply, LinearMap.id_apply, F, b.constr_basis, ← hz]
    rw [h_expand v, map_sum]
    simp_rw [map_smul, ← hb, b.constr_basis]
    rw [← h_expand (algebraMap B T t - v), sub_sub_cancel, hb]
  refine ⟨b.map (.ofInvolutive F fun x ↦ LinearMap.congr_fun hF x), fun a n ↦ ?_⟩
  exact b.constr_basis B (fun j ↦ u j.fst * z ^ j.snd) (a, n)

/-- If `T` has a `B`-basis `u a * z ^ n`, then the elements `u a * (z ^ n / n !)` span
`pdPreEnvelope T {z}` over `B`. -/
theorem span_pdPreEnvelope_eq_top (b' : Basis (I × ℕ) B T) (u : I → T) {z : T}
    (hb' : ∀ (a : I) (n : ℕ), b' (a, n) = u a * z ^ n) :
    span B (Set.range fun j : I × ℕ ↦
      algebraMap T (pdPreEnvelope T {z}) (u j.fst) * pdPreEnvelope.dividedPow z j.snd) = ⊤ := by
  let y := pdPreEnvelope.dividedPow z
  let w (j : I × ℕ) : pdPreEnvelope T {z} := algebraMap T _ (u j.fst) * y j.snd
  have hy (n : ℕ) : algebraMap T (pdPreEnvelope T {z}) z ^ n = n ! * y n :=
    Subtype.ext (by simp [y, pdPreEnvelope.dividedPow, Algebra.TensorProduct.natCast_def',
      Nat.factorial_ne_zero])
  let S' : Submodule B (T ⊗[ℤ] ℚ) :=
    (span B (Set.range w)).map ((pdPreEnvelope T {z}).val.toLinearMap.restrictScalars B)
  have hmul : ∀ {q : T ⊗[ℤ] ℚ}, q ∈ Submonoid.closure
      {(x' ^ n) ⊗ₜ[ℤ] (n ! : ℚ)⁻¹ | (x' ∈ ({z} : Set T)) (n : ℕ)} →
      ∀ (a : I) (n c : ℕ), (algebraMap T _ (u a) * (c * y n)).val * q ∈ S' := by
    intro q hq
    induction hq using Submonoid.closure_induction_left with
    | one => exact fun a n c ↦ ⟨(c : B) • w (a, n), smul_mem _ _ (subset_span ⟨(a, n), rfl⟩),
        by simp [w, Algebra.smul_def, mul_left_comm]⟩
    | mul_left g hg q' _ ih =>
      intro a n c
      obtain ⟨x', hx', m, rfl⟩ := hg
      rw [Set.mem_singleton_iff] at hx'; subst x'
      have hm := congrArg Subtype.val (pdPreEnvelope.dividedPow_mul z n m)
      have h_eq : (algebraMap T _ (u a) * (c * y n)).val * ((y m).val * q') =
          (algebraMap T _ (u a) * ((c * (n + m).choose n : ℕ) * y (n + m))).val * q' := by
        push_cast at hm ⊢
        linear_combination algebraMap T (T ⊗[ℤ] ℚ) (u a) * (c : T ⊗[ℤ] ℚ) * q' * hm
      exact h_eq ▸ ih a (n + m) (c * (n + m).choose n)
  refine top_unique fun x _ ↦ ?_
  suffices x.val ∈ S' by obtain ⟨x', hx', hxx'⟩ := this; exact Subtype.ext hxx' ▸ hx'
  have hx : x.val ∈ span T (Submonoid.closure
      {(x' ^ n) ⊗ₜ[ℤ] (n ! : ℚ)⁻¹ | (x' ∈ ({z} : Set T)) (n : ℕ)} : Set (T ⊗[ℤ] ℚ)) := by
    rw [← Algebra.adjoin_eq_span T]; exact x.property
  obtain ⟨m, f, g, hg⟩ := Submodule.mem_span_set'.mp hx
  refine hg ▸ sum_mem fun i _ ↦ ?_
  rw [← b'.linearCombination_repr (f i), Finsupp.linearCombination_apply, Finsupp.sum,
    Finset.sum_smul]
  refine sum_mem fun ⟨a, k⟩ _ ↦ ?_
  rw [smul_assoc, hb']
  refine smul_mem S' _ ?_
  have hsmul (t : T) (q : T ⊗[ℤ] ℚ) : t • q = (t ⊗ₜ[ℤ] (1 : ℚ)) * q := by
    induction q with
    | tmul _ _ => simp [smul_tmul']
    | add _ _ h1 h2 => simp [smul_add, mul_add, h1, h2]
  rw [hsmul]; simpa [← congrArg Subtype.val (hy k)] using hmul (g i).property a k k !

/-- If `B` is `ℤ`-flat, `T` has a `B`-basis `u a * v ^ n`, and `z = t - v` with `t : B`, then
`pdPreEnvelope T {z}` contains divided powers `y n` of `z` (`z ^ n = n ! * y n`) such that
`u a * y n` form a `B`-basis of `pdPreEnvelope T {z}`. -/
theorem exists_pdPreEnvelope_basis [Module.Flat ℤ B] (b : Basis (I × ℕ) B T) (u : I → T)
    {v z : T} {t : B} (hb : ∀ (a : I) (n : ℕ), b (a, n) = u a * v ^ n)
    (hz : algebraMap B T t - v = z) :
    ∃ (y : ℕ → pdPreEnvelope T {z}) (c : Basis (I × ℕ) B (pdPreEnvelope T {z})),
      (∀ (a : I) (n : ℕ), c (a, n) = algebraMap T _ (u a) * y n) ∧
      ∀ n : ℕ, algebraMap T _ z ^ n = n ! * y n := by
  classical
  obtain ⟨b', hb'⟩ := basis_sub_of_basis_mul_pow b u hb hz
  let y := pdPreEnvelope.dividedPow z
  have hy (n : ℕ) : algebraMap T (pdPreEnvelope T {z}) z ^ n = n ! * y n :=
    Subtype.ext (by simp [y, pdPreEnvelope.dividedPow, Algebra.TensorProduct.natCast_def',
      Nat.factorial_ne_zero])
  let w (j : I × ℕ) : pdPreEnvelope T {z} := algebraMap T _ (u j.fst) * y j.snd
  have h_indep : LinearIndependent B w := by
    refine LinearIndependent.of_comp
      ((pdPreEnvelope T {z}).val.toLinearMap.restrictScalars B)
      (linearIndependent_iff'.mpr fun s g hg i hi ↦ ?_)
    apply Algebra.TensorProduct.includeLeft_injective (R := ℤ) (S := ℤ) (A := B) (B := ℚ)
      (Int.cast_injective (α := ℚ))
    simpa [w, y, pdPreEnvelope.dividedPow, ← hb', Finsupp.single_apply, ite_tmul, hi,
      Algebra.TensorProduct.natCast_def', smul_tmul', Nat.factorial_ne_zero] using
      congrArg (fun e : T ⊗[ℤ] ℚ ↦
        AlgebraTensorModule.rTensor ℤ ℚ (b'.coord i) e * (i.snd ! : B ⊗[ℤ] ℚ)) hg
  have h_span : span B (Set.range w) = ⊤ := span_pdPreEnvelope_eq_top b' u hb'
  exact ⟨y, .mk h_indep h_span.ge, fun a n ↦ Basis.mk_apply h_indep h_span.ge (a, n), hy⟩

end TauCeti
