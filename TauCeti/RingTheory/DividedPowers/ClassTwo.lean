import Mathlib.Tactic.NoncommRing

/-!
# Integral ordered products for a class-two root system

Suppose `x * y = y * x + z`, with `z` commuting with both `x` and `y`. The ordered
monomials `y⁽ᵃ⁾ z⁽ᵇ⁾ x⁽ᶜ⁾` have explicit nonnegative integral multiplication coefficients.
Their additive integral span is exactly the subring generated by the divided powers of the
two elements `x` and `y`: all divided powers of the commutator `z` already lie there.
In particular this supplies the ordered spanning and multiplication rules for
the positive part of type A₂, with `x` and `y` the simple root vectors and `z = [x,y]`.
No linear independence is assumed or asserted, so the formulas also apply to representations.

The two-factor straightening rule is
`TauCeti.Associative.dividedPower_mul_dividedPower_of_commutator_eq`; this file combines it
with the same-root binomial product rule to collect arbitrary ordered monomials. Unlike a
rational spanning assertion, the resulting integral span is closed under multiplication
without dividing by any further integers.

## Main results

* `classTwoMonomial_mul`: the explicit finite multiplication formula.
* `mul_mem_classTwoSpan`: closure of the integral ordered span under multiplication.
* `Subring.dividedPower_mem_of_commutator_eq`: integrality of the commutator's divided powers.
* `toAddSubgroup_closure_dividedPower_pair_eq_classTwoSpan`: the integral ordered spanning theorem.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, 2nd ed., II.1.

The integral-span argument follows `TauCeti.Algebra.Lie.Sl2.Kostant.Span`.
-/

public section

namespace TauCeti.Associative

open Finset

section Semiring

variable {A : Type*} [Semiring A] [Algebra ℚ A]

/-- An ordered divided-power monomial for three class-two root vectors. -/
noncomputable def classTwoMonomial (x y z : A) (a b c : ℕ) : A :=
  dividedPower a y * dividedPower b z * dividedPower c x

/-- The ordered monomial is the product in `y`, `z`, `x` order. -/
theorem classTwoMonomial_def (x y z : A) (a b c : ℕ) :
    classTwoMonomial x y z a b c =
      dividedPower a y * dividedPower b z * dividedPower c x :=
  (rfl)

theorem classTwoMonomial_zero_zero_zero (x y z : A) :
    classTwoMonomial x y z 0 0 0 = 1 := by
  simp [classTwoMonomial]

@[simp]
theorem classTwoMonomial_left (x y z : A) (n : ℕ) :
    classTwoMonomial x y z n 0 0 = dividedPower n y := by
  simp [classTwoMonomial]

@[simp]
theorem classTwoMonomial_middle (x y z : A) (n : ℕ) :
    classTwoMonomial x y z 0 n 0 = dividedPower n z := by
  simp [classTwoMonomial]

@[simp]
theorem classTwoMonomial_right (x y z : A) (n : ℕ) :
    classTwoMonomial x y z 0 0 n = dividedPower n x := by
  simp [classTwoMonomial]

private theorem collect_classTwoMonomial (x y z : A)
    (hxz : Commute x z) (hyz : Commute y z) (a b c d e f k : ℕ) :
    dividedPower a y * dividedPower b z *
        (dividedPower (d - k) y * dividedPower k z * dividedPower (c - k) x) *
          dividedPower e z * dividedPower f x =
      (dividedPower a y * dividedPower (d - k) y) *
        (dividedPower b z * dividedPower k z * dividedPower e z) *
          (dividedPower (c - k) x * dividedPower f x) := by
  calc
    _ = dividedPower a y * (dividedPower b z * dividedPower (d - k) y) *
        dividedPower k z * (dividedPower (c - k) x * dividedPower e z) *
          dividedPower f x := by noncomm_ring
    _ = dividedPower a y * (dividedPower (d - k) y * dividedPower b z) *
        dividedPower k z * (dividedPower e z * dividedPower (c - k) x) *
          dividedPower f x := by
      rw [(commute_dividedPower_dividedPower hyz.symm b (d - k)).eq,
        (commute_dividedPower_dividedPower hxz (c - k) e).eq]
    _ = _ := by noncomm_ring

/-- Products of ordered class-two monomials have nonnegative integral coefficients. The sum
runs over exactly the possible numbers of commutations producing the middle root `z`. -/
theorem classTwoMonomial_mul {x y z : A}
    (hxy : x * y = y * x + z) (hxz : Commute x z) (hyz : Commute y z)
    (a b c d e f : ℕ) :
    classTwoMonomial x y z a b c * classTwoMonomial x y z d e f =
      ∑ k ∈ range (min c d + 1),
        (Nat.choose (a + (d - k)) a * Nat.choose (b + k) b *
          Nat.choose (b + k + e) (b + k) * Nat.choose ((c - k) + f) (c - k)) •
            classTwoMonomial x y z (a + (d - k)) (b + k + e) ((c - k) + f) := by
  have hfactor :
      classTwoMonomial x y z a b c * classTwoMonomial x y z d e f =
        dividedPower a y * dividedPower b z *
          (dividedPower c x * dividedPower d y) * dividedPower e z * dividedPower f x := by
    simp only [classTwoMonomial_def, mul_assoc]
  rw [hfactor, dividedPower_mul_dividedPower_of_commutator_eq hxy hxz hyz,
    mul_sum, sum_mul, sum_mul]
  apply sum_congr rfl
  intro k _
  rw [collect_classTwoMonomial x y z hxz hyz,
    mul_dividedPower a (d - k) y, mul_dividedPower b k z]
  simp only [smul_mul_assoc, mul_smul_comm]
  rw [mul_dividedPower (b + k) e z, mul_dividedPower (c - k) f x]
  simp only [classTwoMonomial_def, smul_mul_assoc, mul_smul_comm, smul_smul]
  congr 1
  ac_rfl

end Semiring

section Ring

variable {A : Type*} [Ring A] [Algebra ℚ A]

/-- The integral additive span of the ordered class-two divided-power monomials. -/
noncomputable def classTwoSpan (x y z : A) : AddSubgroup A :=
  AddSubgroup.closure (Set.range fun p : ℕ × ℕ × ℕ =>
    classTwoMonomial x y z p.1 p.2.1 p.2.2)

/-- The ordered span is the additive closure of the ordered divided-power monomials. -/
theorem classTwoSpan_def (x y z : A) :
    classTwoSpan x y z = AddSubgroup.closure (Set.range fun p : ℕ × ℕ × ℕ =>
      classTwoMonomial x y z p.1 p.2.1 p.2.2) :=
  (rfl)

/-- Containment of the ordered span is equivalent to containment of every ordered monomial. -/
@[simp]
theorem classTwoSpan_le_iff {x y z : A} {S : AddSubgroup A} :
    classTwoSpan x y z ≤ S ↔ ∀ a b c, classTwoMonomial x y z a b c ∈ S := by
  simp only [classTwoSpan, AddSubgroup.closure_le, Set.range_subset_iff, Prod.forall]
  rfl

/-- Every ordered monomial belongs to the integral ordered span. -/
@[simp]
theorem classTwoMonomial_mem_classTwoSpan (x y z : A) (a b c : ℕ) :
    classTwoMonomial x y z a b c ∈ classTwoSpan x y z :=
  AddSubgroup.subset_closure ⟨(a, b, c), rfl⟩

/-- The ordered span contains the unit. -/
@[simp]
theorem one_mem_classTwoSpan (x y z : A) : (1 : A) ∈ classTwoSpan x y z := by
  simpa using classTwoMonomial_mem_classTwoSpan x y z 0 0 0

/-- The integral ordered span is closed under products under the class-two relations. -/
theorem mul_mem_classTwoSpan {x y z u v : A}
    (hxy : x * y = y * x + z) (hxz : Commute x z) (hyz : Commute y z)
    (hu : u ∈ classTwoSpan x y z) (hv : v ∈ classTwoSpan x y z) :
    u * v ∈ classTwoSpan x y z := by
  rw [classTwoSpan] at hu hv ⊢
  refine AddSubgroup.mul_mem_closure_of_mul_mem ?_ hu hv
  rintro _ ⟨⟨a, b, c⟩, rfl⟩ _ ⟨⟨d, e, f⟩, rfl⟩
  rw [classTwoMonomial_mul hxy hxz hyz]
  exact sum_mem fun k _ =>
    AddSubgroup.nsmul_mem _ (classTwoMonomial_mem_classTwoSpan x y z _ _ _) _

/-- If a subring contains the divided powers of two elements whose commutator commutes with
both, it contains every divided power of that commutator. No factorials need be inverted in the
subring: triangular straightening expresses the new divided power with leading coefficient one. -/
theorem _root_.Subring.dividedPower_mem_of_commutator_eq (S : Subring A) {x y z : A}
    (hxy : x * y = y * x + z) (hxz : Commute x z) (hyz : Commute y z)
    (hx : ∀ n, dividedPower n x ∈ S) (hy : ∀ n, dividedPower n y ∈ S) (n : ℕ) :
    dividedPower n z ∈ S := by
  induction n using Nat.strong_induction_on with
  | ind n ih =>
    have hstraight := dividedPower_mul_dividedPower_of_commutator_eq hxy hxz hyz n n
    rw [min_self, sum_range_succ] at hstraight
    simp only [Nat.sub_self, dividedPower_zero, one_mul, mul_one] at hstraight
    have hlow : ∑ k ∈ range n,
        dividedPower (n - k) y * dividedPower k z * dividedPower (n - k) x ∈ S :=
      sum_mem fun k hk =>
        S.mul_mem (S.mul_mem (hy (n - k)) (ih k (mem_range.mp hk))) (hx (n - k))
    have hsub := S.sub_mem (S.mul_mem (hx n) (hy n)) hlow
    rwa [hstraight, add_sub_cancel_left] at hsub

/-- The subring generated by the divided powers of the two simple root vectors is additively
spanned by the ordered monomials in all three roots. This is an integral spanning result, not a
linear-independence assertion. -/
theorem toAddSubgroup_closure_dividedPower_pair_eq_classTwoSpan {x y z : A}
    (hxy : x * y = y * x + z) (hxz : Commute x z) (hyz : Commute y z) :
    (Subring.closure (Set.range (fun n => dividedPower n y) ∪
      Set.range (fun n => dividedPower n x))).toAddSubgroup = classTwoSpan x y z := by
  let S := Subring.closure (Set.range (fun n => dividedPower n y) ∪
    Set.range (fun n => dividedPower n x))
  have hy (n : ℕ) : dividedPower n y ∈ S := Subring.subset_closure (Or.inl ⟨n, rfl⟩)
  have hx (n : ℕ) : dividedPower n x ∈ S := Subring.subset_closure (Or.inr ⟨n, rfl⟩)
  apply le_antisymm
  · let T : Subring A :=
      { classTwoSpan x y z with
        one_mem' := one_mem_classTwoSpan x y z
        mul_mem' := mul_mem_classTwoSpan hxy hxz hyz }
    suffices h : S ≤ T from h
    apply Subring.closure_le.mpr
    rintro u (⟨n, rfl⟩ | ⟨n, rfl⟩)
    · simpa [T] using classTwoMonomial_mem_classTwoSpan x y z n 0 0
    · simpa [T] using classTwoMonomial_mem_classTwoSpan x y z 0 0 n
  · rw [classTwoSpan_le_iff]
    intro a b c
    rw [classTwoMonomial_def]
    exact S.mul_mem (S.mul_mem (hy a)
      (S.dividedPower_mem_of_commutator_eq hxy hxz hyz hx hy b)) (hx c)

end Ring

end TauCeti.Associative
