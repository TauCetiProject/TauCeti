module

public import TauCeti.RingTheory.DividedPowers.RootString.G2.Basic

/-!
# Simple divided-power generators in type G₂

In an associative rational algebra, let `x` and `y` model the short and long simple root
vectors of type G₂. Write `z`, `w`, `v`, and `s` for the root vectors of `α + β`,
`2α + β`, `3α + β`, and `3α + 2β`, respectively. Under the integral Chevalley relations,
the subring generated by the divided powers of `x` and `y` contains the divided powers
of all six positive root vectors.

The structure constants two and three are not inverted in this subring. Instead,
coefficient-one straightening isolates each required divided power. This identifies the
simple-generator and all-root versions of the positive integral enveloping form, without
assuming independence or nilpotence of the root vectors.

## Main results

* `Subring.dividedPower_mem_of_g2`: a subring containing the simple divided powers contains
  every nonsimple positive-root divided power.
* `TauCeti.Associative.G2.closure_dividedPowers_eq`: adjoining all positive-root divided
  powers gives the same subring as adjoining the two simple-root families.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

open Finset
open TauCeti.Associative

namespace TauCeti.Associative.G2

variable {A : Type*} [Ring A] [Algebra ℚ A]
variable {x y z w v s : A}

-- Extract a single coefficient-one term of the long-string straightening formula.
private theorem chain_term_mem (S : Subring A)
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : x * w = w * x + 3 • v) (hwz : w * z = z * w + 3 • s)
    (hxv : Commute x v) (hxs : Commute x s) (hyz : Commute y z)
    (hwv : Commute w v) (hzs : Commute z s) (hws : Commute w s) (hvs : Commute v s)
    (hx : ∀ n, dividedPower n x ∈ S) (hy : ∀ n, dividedPower n y ∈ S)
    (m n : ℕ) (p : ℕ × ℕ × ℕ × ℕ) (hp : p ∈ chainG2Index m n)
    (hrest : ∀ q ∈ (chainG2Index m n).erase p,
      dividedPower q.1 z ∈ S ∧ dividedPower q.2.1 w ∈ S ∧
        dividedPower q.2.2.1 v ∈ S ∧ dividedPower q.2.2.2 s ∈ S) :
    dividedPower (n - p.1 - p.2.1 - p.2.2.1 - 2 * p.2.2.2) y * dividedPower p.1 z *
      dividedPower p.2.1 w * dividedPower p.2.2.1 v * dividedPower p.2.2.2 s *
      dividedPower (m - p.1 - 2 * p.2.1 - 3 * p.2.2.1 - 3 * p.2.2.2) x ∈ S := by
  classical
  let f := fun q : ℕ × ℕ × ℕ × ℕ =>
    dividedPower (n - q.1 - q.2.1 - q.2.2.1 - 2 * q.2.2.2) y * dividedPower q.1 z *
      dividedPower q.2.1 w * dividedPower q.2.2.1 v * dividedPower q.2.2.2 s *
      dividedPower (m - q.1 - 2 * q.2.1 - 3 * q.2.2.1 - 3 * q.2.2.2) x
  have hsum : ∑ q ∈ chainG2Index m n, f q ∈ S := by
    rw [← dividedPower_mul_dividedPower_of_commutator_eq_three_nsmul
      hxy hxz hxw hwz hxv hxs hyz hwv hzs hws hvs]
    exact S.mul_mem (hx m) (hy n)
  have herase : ∑ q ∈ (chainG2Index m n).erase p, f q ∈ S := by
    refine S.sum_mem fun q hq => ?_
    obtain ⟨hz, hw, hv, hs⟩ := hrest q hq
    exact S.mul_mem (S.mul_mem (S.mul_mem (S.mul_mem
      (S.mul_mem (hy _) hz) hw) hv) hs) (hx _)
  rw [← sum_erase_add _ _ hp] at hsum
  exact (S.add_mem_cancel_left herase).mp hsum

-- The induction is simultaneous: first recover z⁽ⁿ⁾, then w⁽ⁿ⁾, then v⁽ⁿ⁾,
-- and finally s⁽ⁿ⁾. Every other term uses only earlier stages or smaller exponents.
private theorem dividedPowers_mem (S : Subring A)
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : x * w = w * x + 3 • v) (hyw : Commute y w)
    (hyv : y * v = v * y + s) (hxv : Commute x v) (hxs : Commute x s)
    (hyz : Commute y z) (hys : Commute y s) (hwv : Commute w v)
    (hzs : Commute z s) (hws : Commute w s) (hvs : Commute v s)
    (hx : ∀ n, dividedPower n x ∈ S) (hy : ∀ n, dividedPower n y ∈ S) (n : ℕ) :
    dividedPower n z ∈ S ∧ dividedPower n w ∈ S ∧
      dividedPower n v ∈ S ∧ dividedPower n s ∈ S := by
  classical
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hn : n = 0
    · subst n
      simp
    have hn : 0 < n := Nat.pos_of_ne_zero hn
    have hwz := commutator_eq_three_nsmul_of_commute hxy hxw hyw hyv
    have extract := chain_term_mem S hxy hxz hxw hwz hxv hxs hyz hwv hzs hws hvs hx hy
    have hz : dividedPower n z ∈ S := by
      have ht := extract n n (n, 0, 0, 0) (by simp) ?_
      · simpa using ht
      intro q hq
      obtain ⟨hne, hq⟩ := mem_erase.mp hq
      obtain ⟨ha, hb⟩ := mem_chainG2Index.mp hq
      have hqz : q.1 < n := by
        by_contra! h
        have : q = (n, 0, 0, 0) := by
          rcases q with ⟨a, b, c, d⟩
          dsimp at *
          ext <;> dsimp <;> omega
        exact hne this
      exact ⟨(ih _ hqz).1, (ih _ (by omega)).2.1,
        (ih _ (by omega)).2.2.1, (ih _ (by omega)).2.2.2⟩
    have hz' : ∀ k ≤ n, dividedPower k z ∈ S := by
      intro k hk
      obtain h | rfl := hk.lt_or_eq
      · exact (ih k h).1
      · exact hz
    have hw : dividedPower n w ∈ S := by
      have ht := extract (2 * n) n (0, n, 0, 0) (by simp) ?_
      · simpa using ht
      intro q hq
      obtain ⟨hne, hq⟩ := mem_erase.mp hq
      obtain ⟨ha, hb⟩ := mem_chainG2Index.mp hq
      have hqw : q.2.1 < n := by
        by_contra! h
        have : q = (0, n, 0, 0) := by
          rcases q with ⟨a, b, c, d⟩
          dsimp at *
          ext <;> dsimp <;> omega
        exact hne this
      exact ⟨hz' _ (by omega), (ih _ hqw).2.1,
        (ih _ (by omega)).2.2.1, (ih _ (by omega)).2.2.2⟩
    have hw' : ∀ k ≤ n, dividedPower k w ∈ S := by
      intro k hk
      obtain h | rfl := hk.lt_or_eq
      · exact (ih k h).2.1
      · exact hw
    have hv : dividedPower n v ∈ S := by
      have ht := extract (3 * n) n (0, 0, n, 0) (by simp) ?_
      · simpa using ht
      intro q hq
      obtain ⟨hne, hq⟩ := mem_erase.mp hq
      obtain ⟨ha, hb⟩ := mem_chainG2Index.mp hq
      have hqv : q.2.2.1 < n := by
        by_contra! h
        have : q = (0, 0, n, 0) := by
          rcases q with ⟨a, b, c, d⟩
          dsimp at *
          ext <;> dsimp <;> omega
        exact hne this
      exact ⟨hz' _ (by omega), hw' _ (by omega),
        (ih _ hqv).2.2.1, (ih _ (by omega)).2.2.2⟩
    refine ⟨hz, hw, hv, ?_⟩
    -- The highest root has coefficient one in [y,v], so class-two straightening
    -- isolates its divided power after the three long-string stages.
    have heq := dividedPower_mul_dividedPower_of_commutator_eq hyv hys hvs n n
    simp only [min_self] at heq
    have hsum : ∑ k ∈ range (n + 1),
        dividedPower (n - k) v * dividedPower k s * dividedPower (n - k) y ∈ S := by
      rw [← heq]
      exact S.mul_mem (hy n) hv
    rw [sum_range_succ] at hsum
    have hrest : ∑ k ∈ range n,
        dividedPower (n - k) v * dividedPower k s * dividedPower (n - k) y ∈ S := by
      refine S.sum_mem fun k hk => ?_
      have hv' : dividedPower (n - k) v ∈ S := by
        by_cases hk0 : k = 0
        · simpa [hk0] using hv
        · exact (ih _ (by omega)).2.2.1
      exact S.mul_mem (S.mul_mem hv' (ih _ (mem_range.mp hk)).2.2.2) (hy _)
    simpa using (S.add_mem_cancel_left hrest).mp hsum

end TauCeti.Associative.G2

namespace Subring

variable {A : Type*} [Ring A] [Algebra ℚ A] {x y z w v s : A}

/-- A subring containing the divided powers of the two simple root vectors of type G₂
contains the divided powers of every nonsimple positive root vector. No structure constant
is inverted inside the subring. -/
theorem dividedPower_mem_of_g2 (S : Subring A)
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : x * w = w * x + 3 • v) (hyw : Commute y w)
    (hyv : y * v = v * y + s) (hxv : Commute x v) (hxs : Commute x s)
    (hyz : Commute y z) (hys : Commute y s) (hwv : Commute w v)
    (hzs : Commute z s) (hws : Commute w s) (hvs : Commute v s)
    (hx : ∀ n, dividedPower n x ∈ S) (hy : ∀ n, dividedPower n y ∈ S)
    {a : A} (ha : a ∈ ({z, w, v, s} : Set A)) (n : ℕ) : dividedPower n a ∈ S := by
  have h := TauCeti.Associative.G2.dividedPowers_mem S
    hxy hxz hxw hyw hyv hxv hxs hyz hys hwv hzs hws hvs hx hy n
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
  rcases ha with rfl | rfl | rfl | rfl
  · exact h.1
  · exact h.2.1
  · exact h.2.2.1
  · exact h.2.2.2

end Subring

namespace TauCeti.Associative.G2

variable {A : Type*} [Ring A] [Algebra ℚ A] {x y z w v s : A}

/-- Adjoining the divided powers of all six positive G₂ root vectors gives exactly the
subring generated by the divided powers of the two simple root vectors. -/
theorem closure_dividedPowers_eq
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : x * w = w * x + 3 • v) (hyw : Commute y w)
    (hyv : y * v = v * y + s) (hxv : Commute x v) (hxs : Commute x s)
    (hyz : Commute y z) (hys : Commute y s) (hwv : Commute w v)
    (hzs : Commute z s) (hws : Commute w s) (hvs : Commute v s) :
    Subring.closure {a | ∃ r ∈ ({x, y, z, w, v, s} : Set A), ∃ n, dividedPower n r = a} =
      Subring.closure (Set.range (dividedPower · x) ∪ Set.range (dividedPower · y)) := by
  apply le_antisymm
  · refine Subring.closure_le.2 ?_
    rintro a ⟨r, hr, n, rfl⟩
    let S := Subring.closure (Set.range (dividedPower · x) ∪ Set.range (dividedPower · y))
    have hx : ∀ n, dividedPower n x ∈ S := fun n => Subring.subset_closure (Or.inl ⟨n, rfl⟩)
    have hy : ∀ n, dividedPower n y ∈ S := fun n => Subring.subset_closure (Or.inr ⟨n, rfl⟩)
    simp only [Set.mem_insert_iff] at hr
    rcases hr with rfl | rfl | hr
    · exact hx n
    · exact hy n
    · exact S.dividedPower_mem_of_g2
        hxy hxz hxw hyw hyv hxv hxs hyz hys hwv hzs hws hvs hx hy hr n
  · refine Subring.closure_mono ?_
    rintro a (⟨n, rfl⟩ | ⟨n, rfl⟩)
    · exact ⟨x, by simp, n, rfl⟩
    · exact ⟨y, by simp, n, rfl⟩

end TauCeti.Associative.G2
