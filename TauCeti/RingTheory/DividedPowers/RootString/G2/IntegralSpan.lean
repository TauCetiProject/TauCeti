module

public import TauCeti.RingTheory.DividedPowers.IntegralSpan
public import TauCeti.RingTheory.DividedPowers.RootString.G2.ShortPair

/-!
# Integral ordered spanning for the positive type-G₂ algebra

Write `x,y,z,w,v,s` for the positive Chevalley root vectors of degrees
`α, β, α+β, 2α+β, 3α+β, 3α+2β`, respectively, with `α` short. Under their integral
commutator table, the ring generated by their divided powers is the integral span of

`s⁽ᵃ⁾ y⁽ᵇ⁾ z⁽ᶜ⁾ w⁽ᵈ⁾ v⁽ᵉ⁾ x⁽ᶠ⁾`.

The central highest-root factor is placed first. This permits collection in stages: adjoin
`y,z,w,v` to its divided-power ring, and finally adjoin `x`. The last step uses both G₂
straightening rules, not just the root string through `β`. All correction coefficients are
integers; no independence or integral PBW basis is asserted.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.

The two-factor formulas are those of `RootString.G2.Basic` and `RootString.G2.ShortPair`;
collection through generated coefficient rings uses `DividedPowers.IntegralSpan`.
-/

public section

namespace TauCeti.Associative.G2

open TauCeti.Associative Subring

variable {A : Type*} [Ring A] [Algebra ℚ A]

/-- The six positive-root divided-power families in the type-G₂ algebra. -/
noncomputable def positiveGenerators (x y z w v s : A) : Set A :=
  ((((Set.range (fun n => dividedPower n s) ∪ Set.range (fun n => dividedPower n y)) ∪
    Set.range (fun n => dividedPower n z)) ∪ Set.range (fun n => dividedPower n w)) ∪
    Set.range (fun n => dividedPower n v)) ∪ Set.range (fun n => dividedPower n x)

/-- The integral span of the ordered six-root products, with the central highest root first.
Multiplication here is multiplication of integral submodules, not pointwise multiplication of
sets, so arbitrary finite integral combinations are included. -/
noncomputable def positiveIntegralSpan (x y z w v s : A) : Submodule ℤ A :=
  dividedPowerLattice s * dividedPowerLattice y * dividedPowerLattice z *
    dividedPowerLattice w * dividedPowerLattice v * dividedPowerLattice x

/-- Membership in the generating set is membership in one of its six divided-power families. -/
@[simp]
theorem mem_positiveGenerators {x y z w v s a : A} :
    a ∈ positiveGenerators x y z w v s ↔
      (∃ n, dividedPower n s = a) ∨ (∃ n, dividedPower n y = a) ∨
        (∃ n, dividedPower n z = a) ∨ (∃ n, dividedPower n w = a) ∨
          (∃ n, dividedPower n v = a) ∨ (∃ n, dividedPower n x = a) := by
  simp only [positiveGenerators, Set.mem_union, Set.mem_range]
  tauto

/-- Ordered six-root products belong to the integral span. -/
theorem orderedProduct_mem_positiveIntegralSpan (x y z w v s : A) (a b c d e f : ℕ) :
    dividedPower a s * dividedPower b y * dividedPower c z * dividedPower d w *
      dividedPower e v * dividedPower f x ∈ positiveIntegralSpan x y z w v s := by
  exact Submodule.mul_mem_mul (Submodule.mul_mem_mul (Submodule.mul_mem_mul
    (Submodule.mul_mem_mul (Submodule.mul_mem_mul
      (dividedPower_mem_dividedPowerLattice s a) (dividedPower_mem_dividedPowerLattice y b))
      (dividedPower_mem_dividedPowerLattice z c)) (dividedPower_mem_dividedPowerLattice w d))
      (dividedPower_mem_dividedPowerLattice v e)) (dividedPower_mem_dividedPowerLattice x f)

/-- The ordered span has exactly the universal property of integral combinations of ordered
six-root products. -/
@[simp]
theorem positiveIntegralSpan_le_iff {x y z w v s : A} {M : Submodule ℤ A} :
    positiveIntegralSpan x y z w v s ≤ M ↔
      ∀ a b c d e f : ℕ, dividedPower a s * dividedPower b y * dividedPower c z *
        dividedPower d w * dividedPower e v * dividedPower f x ∈ M := by
  simp only [positiveIntegralSpan, dividedPowerLattice_def,
    Submodule.span_mul_span, Submodule.span_le]
  constructor
  · intro h a b c d e f
    exact h ⟨_, ⟨_, ⟨_, ⟨_, ⟨_, ⟨a, rfl⟩, _, ⟨b, rfl⟩, rfl⟩,
      _, ⟨c, rfl⟩, rfl⟩, _, ⟨d, rfl⟩, rfl⟩, _, ⟨e, rfl⟩, rfl⟩, _, ⟨f, rfl⟩, rfl⟩
  · rintro h _ ⟨_, ⟨_, ⟨_, ⟨_, ⟨_, ⟨a, rfl⟩, _, ⟨b, rfl⟩, rfl⟩,
      _, ⟨c, rfl⟩, rfl⟩, _, ⟨d, rfl⟩, rfl⟩, _, ⟨e, rfl⟩, rfl⟩, _, ⟨f, rfl⟩, rfl⟩
    exact h a b c d e f

/-- Membership in the positive integral span means being a finite integral combination of
ordered six-root products. The six indices follow the order `s, y, z, w, v, x`. -/
theorem mem_positiveIntegralSpan_iff {x y z w v s u : A} :
    u ∈ positiveIntegralSpan x y z w v s ↔
      ∃ c : (ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) →₀ ℤ,
        c.sum (fun ⟨a, b, c, d, e, f⟩ r => r •
          (dividedPower a s * dividedPower b y * dividedPower c z * dividedPower d w *
            dividedPower e v * dividedPower f x)) = u := by
  let p : (ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) → A := fun ⟨a, b, c, d, e, f⟩ =>
    dividedPower a s * dividedPower b y * dividedPower c z * dividedPower d w *
      dividedPower e v * dividedPower f x
  have hspan : positiveIntegralSpan x y z w v s = Submodule.span ℤ (Set.range p) := by
    apply le_antisymm
    · rw [positiveIntegralSpan_le_iff]
      intro a b c d e f
      exact Submodule.subset_span ⟨⟨a, b, c, d, e, f⟩, rfl⟩
    · rw [Submodule.span_le]
      rintro _ ⟨⟨a, b, c, d, e, f⟩, rfl⟩
      exact orderedProduct_mem_positiveIntegralSpan x y z w v s a b c d e f
  rw [hspan]
  exact Finsupp.mem_span_range_iff_exists_finsupp

/-- Integral ordered spanning of the positive type-G₂ algebra. The hypotheses are its signed
Chevalley commutator table; in particular the highest-root correction occurs in both `[y,v]`
and `[w,z]`. No linear independence or characteristic-p division is implicit. -/
theorem toAddSubgroup_closure_positiveGenerators {x y z w v s : A}
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : x * w = w * x + 3 • v) (hyv : y * v = v * y + s)
    (hxv : Commute x v) (hxs : Commute x s) (hyz : Commute y z)
    (hyw : Commute y w) (hys : Commute y s) (hzv : Commute z v)
    (hzs : Commute z s) (hwv : Commute w v) (hws : Commute w s) (hvs : Commute v s) :
    (Subring.closure (positiveGenerators x y z w v s)).toAddSubgroup =
      (positiveIntegralSpan x y z w v s).toAddSubgroup := by
  have hwz := commutator_eq_three_nsmul_of_commute hxy hxw hyw hyv
  let D (a : A) := Set.range (fun n => dividedPower n a)
  let S₀ := D s
  let S₁ := S₀ ∪ D y
  let S₂ := S₁ ∪ D z
  let S₃ := S₂ ∪ D w
  let S₄ := S₃ ∪ D v
  -- First collect the five-root ideal: only the pairs (w,z) and (v,y) fail to commute.
  have hs := toAddSubgroup_closure_range_dividedPower s
  have hy : (Subring.closure S₁).toAddSubgroup =
      dividedPowerExtensionSpan (Subring.closure S₀) y := by
    apply toAddSubgroup_closure_union_range_dividedPower
    rintro _ ⟨k, rfl⟩ m
    exact dividedPower_mul_mem_extensionSpan_of_commute (Subring.closure S₀) hys
      (fun k => Subring.subset_closure ⟨k, rfl⟩) m k
  have hz : (Subring.closure S₂).toAddSubgroup =
      dividedPowerExtensionSpan (Subring.closure S₁) z := by
    apply toAddSubgroup_closure_union_range_dividedPower
    rintro _ (⟨k, rfl⟩ | ⟨k, rfl⟩) m
    · exact dividedPower_mul_mem_extensionSpan_of_commute _ hzs
        (fun k => Subring.subset_closure (Or.inl ⟨k, rfl⟩)) m k
    · exact dividedPower_mul_mem_extensionSpan_of_commute _ hyz.symm
        (fun k => Subring.subset_closure (Or.inr ⟨k, rfl⟩)) m k
  have hw : (Subring.closure S₃).toAddSubgroup =
      dividedPowerExtensionSpan (Subring.closure S₂) w := by
    apply toAddSubgroup_closure_union_range_dividedPower
    rintro _ ((⟨k, rfl⟩ | ⟨k, rfl⟩) | ⟨k, rfl⟩) m
    · exact dividedPower_mul_mem_extensionSpan_of_commute _ hws
        (fun k => Subring.subset_closure (Or.inl (Or.inl ⟨k, rfl⟩))) m k
    · exact dividedPower_mul_mem_extensionSpan_of_commute _ hyw.symm
        (fun k => Subring.subset_closure (Or.inl (Or.inr ⟨k, rfl⟩))) m k
    · exact dividedPower_mul_mem_extensionSpan_of_central_commutator _ 3
        (by simpa using hwz) hws hzs
        (fun k => Subring.subset_closure (Or.inr ⟨k, rfl⟩))
        (fun k => Subring.subset_closure (Or.inl (Or.inl ⟨k, rfl⟩))) m k
  have hv : (Subring.closure S₄).toAddSubgroup =
      dividedPowerExtensionSpan (Subring.closure S₃) v := by
    apply toAddSubgroup_closure_union_range_dividedPower
    rintro _ (((⟨k, rfl⟩ | ⟨k, rfl⟩) | ⟨k, rfl⟩) | ⟨k, rfl⟩) m
    · exact dividedPower_mul_mem_extensionSpan_of_commute _ hvs
        (fun k => Subring.subset_closure (Or.inl (Or.inl (Or.inl ⟨k, rfl⟩)))) m k
    · have hvy : v * y = y * v + (-1 : ℤ) • s := by
        rw [hyv]
        simp
      exact dividedPower_mul_mem_extensionSpan_of_central_commutator _ (-1) hvy hvs hys
        (fun k => Subring.subset_closure (Or.inl (Or.inl (Or.inr ⟨k, rfl⟩))))
        (fun k => Subring.subset_closure (Or.inl (Or.inl (Or.inl ⟨k, rfl⟩)))) m k
    · exact dividedPower_mul_mem_extensionSpan_of_commute _ hzv.symm
        (fun k => Subring.subset_closure (Or.inl (Or.inr ⟨k, rfl⟩))) m k
    · exact dividedPower_mul_mem_extensionSpan_of_commute _ hwv.symm
        (fun k => Subring.subset_closure (Or.inr ⟨k, rfl⟩)) m k
  let T := Subring.closure S₄
  have hd (g : A) (hg : g = s ∨ g = y ∨ g = z ∨ g = w ∨ g = v) (k : ℕ) :
      dividedPower k g ∈ T := by
    apply Subring.subset_closure
    rcases hg with rfl | rfl | rfl | rfl | rfl <;>
      simp [S₄, S₃, S₂, S₁, S₀, D]
  -- Adjoining the short simple root uses the full G₂ string and the short-pair formula.
  have hx : (Subring.closure (S₄ ∪ D x)).toAddSubgroup = dividedPowerExtensionSpan T x := by
    apply toAddSubgroup_closure_union_range_dividedPower
    rintro _ ((((⟨k, rfl⟩ | ⟨k, rfl⟩) | ⟨k, rfl⟩) | ⟨k, rfl⟩) | ⟨k, rfl⟩) m
    · exact dividedPower_mul_mem_extensionSpan_of_commute T hxs (hd s (by tauto)) m k
    · rw [dividedPower_mul_dividedPower_of_commutator_eq_three_nsmul
        hxy hxz hxw hwz hxv hxs hyz hwv hzs hws hvs]
      apply sum_mem
      intro p _
      exact mul_dividedPower_mem_extensionSpan T x
        (T.mul_mem (T.mul_mem (T.mul_mem (T.mul_mem
          (hd y (by tauto) _) (hd z (by tauto) _)) (hd w (by tauto) _))
            (hd v (by tauto) _)) (hd s (by tauto) _)) _
    · rw [dividedPower_mul_dividedPower_of_g2_short_pair hxz hxw hwz hxv hxs hzs hwv hws hvs]
      apply sum_mem
      intro p _
      apply AddSubgroup.nsmul_mem
      exact mul_dividedPower_mem_extensionSpan T x
        (T.mul_mem (T.mul_mem (T.mul_mem (hd z (by tauto) _) (hd w (by tauto) _))
          (hd v (by tauto) _)) (hd s (by tauto) _)) _
    · exact dividedPower_mul_mem_extensionSpan_of_central_commutator T 3
        (by simpa using hxw) hxv hwv
        (hd w (by tauto)) (hd v (by tauto)) m k
    · exact dividedPower_mul_mem_extensionSpan_of_commute T hxv (hd v (by tauto)) m k
  -- Rewrite each adjoining step in integral submodule form, starting at the outermost root.
  rw [positiveGenerators, hx, dividedPowerExtensionSpan_eq_mul, hv,
    dividedPowerExtensionSpan_eq_mul, hw, dividedPowerExtensionSpan_eq_mul, hz,
    dividedPowerExtensionSpan_eq_mul, hy, dividedPowerExtensionSpan_eq_mul, hs]
  simp only [Submodule.toAddSubgroup_toIntSubmodule, positiveIntegralSpan]

/-- The positive type-G₂ ordered integral span is multiplicatively closed. -/
theorem mul_mem_positiveIntegralSpan {x y z w v s a b : A}
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : x * w = w * x + 3 • v) (hyv : y * v = v * y + s)
    (hxv : Commute x v) (hxs : Commute x s) (hyz : Commute y z)
    (hyw : Commute y w) (hys : Commute y s) (hzv : Commute z v)
    (hzs : Commute z s) (hwv : Commute w v) (hws : Commute w s) (hvs : Commute v s)
    (ha : a ∈ positiveIntegralSpan x y z w v s) (hb : b ∈ positiveIntegralSpan x y z w v s) :
    a * b ∈ positiveIntegralSpan x y z w v s := by
  have heq := toAddSubgroup_closure_positiveGenerators hxy hxz hxw hyv
    hxv hxs hyz hyw hys hzv hzs hwv hws hvs
  have hmem (c : A) : c ∈ Subring.closure (positiveGenerators x y z w v s) ↔
      c ∈ positiveIntegralSpan x y z w v s := SetLike.ext_iff.mp heq c
  exact (hmem _).mp (mul_mem ((hmem _).mpr ha) ((hmem _).mpr hb))

end TauCeti.Associative.G2
