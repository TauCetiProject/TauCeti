module

public import TauCeti.RingTheory.DividedPowers.RootString.Basic

/-!
# The integral ordered span of the positive type-B₂ algebra

Let `x`, `y`, `z`, `w` satisfy the positive Chevalley relations
`[x,y] = z`, `[x,z] = 2w`, with all other brackets zero. The ordered products
`y⁽ᵃ⁾ z⁽ᵇ⁾ w⁽ᶜ⁾ x⁽ᵈ⁾` span over the integers the subring generated by the divided
powers of these four root vectors. In particular, collecting products introduces no
half-integers, despite the structure constant two.

`TauCeti.Associative.B2.dividedPower_mul_orderedMonomial` gives the finite integral
coefficients for inserting a divided power of the short simple root on the left.
The other three insertions use only commutation and the same-root binomial rule.
`TauCeti.Associative.B2.toAddSubgroup_closure_rootDividedPowers` identifies the resulting
ordered span with the generated subring. This is a spanning result, not an independence
assertion, and it does not construct a basis in positive characteristic by factorial division.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.

The two-factor collection uses
`TauCeti.Associative.dividedPower_mul_dividedPower_of_commutator_eq_two_nsmul`.
The integral-span argument follows the rank-one construction in
`TauCeti.Algebra.Lie.Sl2.Kostant.Span`.
-/

public section

namespace TauCeti.Associative.B2

open Finset

variable {A : Type*}

section Semiring

variable [Semiring A] [Algebra ℚ A] {x y z w : A}

/-- The positive type-B₂ ordered monomial `y⁽ᵃ⁾ z⁽ᵇ⁾ w⁽ᶜ⁾ x⁽ᵈ⁾`. -/
noncomputable def orderedMonomial (x y z w : A) (a b c d : ℕ) : A :=
  dividedPower a y * dividedPower b z * dividedPower c w * dividedPower d x

/-- The four factors of an ordered monomial. -/
theorem orderedMonomial_def (x y z w : A) (a b c d : ℕ) :
    orderedMonomial x y z w a b c d =
      dividedPower a y * dividedPower b z * dividedPower c w * dividedPower d x := (rfl)

/-- An ordered monomial with only its `y` exponent nonzero is a divided power of `y`. -/
@[simp]
theorem orderedMonomial_y (x y z w : A) (n : ℕ) :
    orderedMonomial x y z w n 0 0 0 = dividedPower n y := by
  simp [orderedMonomial_def]

/-- An ordered monomial with only its `z` exponent nonzero is a divided power of `z`. -/
@[simp]
theorem orderedMonomial_z (x y z w : A) (n : ℕ) :
    orderedMonomial x y z w 0 n 0 0 = dividedPower n z := by
  simp [orderedMonomial_def]

/-- An ordered monomial with only its `w` exponent nonzero is a divided power of `w`. -/
@[simp]
theorem orderedMonomial_w (x y z w : A) (n : ℕ) :
    orderedMonomial x y z w 0 0 n 0 = dividedPower n w := by
  simp [orderedMonomial_def]

/-- An ordered monomial with only its `x` exponent nonzero is a divided power of `x`. -/
@[simp]
theorem orderedMonomial_x (x y z w : A) (n : ℕ) :
    orderedMonomial x y z w 0 0 0 n = dividedPower n x := by
  simp [orderedMonomial_def]

/-- **Integral insertion of a short-root divided power.** The index `p` records the
`α+β` and `2α+β` factors released while crossing `y⁽ᵃ⁾`; `k` records the additional
`2α+β` factors released while crossing `z⁽ᵇ⁾`. All displayed coefficients are natural numbers. -/
theorem dividedPower_mul_orderedMonomial
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z) (n a b c d : ℕ) :
    dividedPower n x * orderedMonomial x y z w a b c d =
      ∑ p ∈ chainLeTwoIndex n a,
        ∑ k ∈ range (min (n - p.1 - 2 * p.2) b + 1),
          (2 ^ k * Nat.choose (p.1 + (b - k)) p.1 *
            Nat.choose (p.2 + k) p.2 * Nat.choose (p.2 + k + c) (p.2 + k) *
            Nat.choose (n - p.1 - 2 * p.2 - k + d) (n - p.1 - 2 * p.2 - k)) •
          orderedMonomial x y z w (a - p.1 - p.2) (p.1 + (b - k))
            (p.2 + k + c) (n - p.1 - 2 * p.2 - k + d) := by
  classical
  have hzw := hxw.of_commutator_eq_of_commutator_eq_smul (R := ℚ) (c := 2) hxy
    (by simpa only [← Nat.cast_smul_eq_nsmul ℚ, Nat.cast_ofNat] using hxz) hyz
    (isUnit_iff_ne_zero.mpr (by norm_num))
  -- First cross the long simple-root factor, releasing the two root-string factors.
  rw [orderedMonomial_def, ← mul_assoc, ← mul_assoc, ← mul_assoc,
    dividedPower_mul_dividedPower_of_commutator_eq_two_nsmul hxy hxz hxw hyz,
    sum_mul, sum_mul, sum_mul]
  refine sum_congr rfl fun p _ => ?_
  -- The remaining crossing has central commutator `2w`, accounting for `2 ^ k`.
  have hmove := dividedPower_mul_dividedPower_of_commutator_eq_nsmul hxz hxw hzw
    (n - p.1 - 2 * p.2) b
  simp only [mul_assoc] at ⊢
  rw [← mul_assoc (dividedPower (n - p.1 - 2 * p.2) x), hmove]
  simp only [mul_sum, sum_mul]
  refine sum_congr rfl fun k _ => ?_
  simp only [mul_smul_comm, smul_mul_assoc]
  have hzw' := commute_dividedPower_dividedPower hzw.symm p.2 (b - k)
  have hxw' := commute_dividedPower_dividedPower hxw (n - p.1 - 2 * p.2 - k) c
  -- Move the central factors together, then combine equal-root divided powers.
  have hreorder :
      dividedPower (a - p.1 - p.2) y *
          (dividedPower p.1 z * (dividedPower p.2 w *
            (dividedPower (b - k) z * dividedPower k w *
              dividedPower (n - p.1 - 2 * p.2 - k) x *
                (dividedPower c w * dividedPower d x)))) =
        dividedPower (a - p.1 - p.2) y *
          (dividedPower p.1 z * dividedPower (b - k) z) *
          ((dividedPower p.2 w * dividedPower k w) * dividedPower c w) *
          (dividedPower (n - p.1 - 2 * p.2 - k) x * dividedPower d x) := by
    simp only [mul_assoc]
    rw [hzw'.left_comm, hxw'.left_comm]
  rw [hreorder]
  simp only [mul_dividedPower, mul_smul_comm, smul_mul_assoc, smul_smul, orderedMonomial_def,
    mul_assoc]
  congr 1
  ac_rfl

end Semiring

section Ring

variable [Ring A] [Algebra ℚ A] {x y z w : A}

/-- The integer span of positive type-B₂ ordered monomials. -/
noncomputable def orderedSpan (x y z w : A) : AddSubgroup A :=
  AddSubgroup.closure {r | ∃ a b c d, orderedMonomial x y z w a b c d = r}

/-- Every ordered monomial belongs to its integer span. -/
@[simp]
theorem orderedMonomial_mem_orderedSpan (x y z w : A) (a b c d : ℕ) :
    orderedMonomial x y z w a b c d ∈ orderedSpan x y z w :=
  AddSubgroup.subset_closure ⟨a, b, c, d, rfl⟩

/-- The ordered span is contained in an additive subgroup precisely when every ordered
monomial is contained in it. -/
@[simp]
theorem orderedSpan_le_iff {S : AddSubgroup A} :
    orderedSpan x y z w ≤ S ↔ ∀ a b c d, orderedMonomial x y z w a b c d ∈ S := by
  exact ⟨fun h a b c d => h (orderedMonomial_mem_orderedSpan x y z w a b c d),
    fun h => (AddSubgroup.closure_le _).mpr fun _ ⟨a, b, c, d, heq⟩ => heq ▸ h a b c d⟩

/-- The four root divided-power families generating the positive integral type-B₂ algebra. -/
noncomputable def rootDividedPowers (x y z w : A) : Set A :=
  Set.range (fun n => dividedPower n y) ∪ Set.range (fun n => dividedPower n z) ∪
    Set.range (fun n => dividedPower n w) ∪ Set.range (fun n => dividedPower n x)

/-- Membership in the four root divided-power families. -/
@[simp]
theorem mem_rootDividedPowers_iff {r : A} :
    r ∈ rootDividedPowers x y z w ↔
      (∃ n, dividedPower n y = r) ∨ (∃ n, dividedPower n z = r) ∨
        (∃ n, dividedPower n w = r) ∨ ∃ n, dividedPower n x = r := by
  simp only [rootDividedPowers, Set.mem_union, Set.mem_range, or_assoc]

private theorem root_mul_orderedMonomial_mem
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z) (hyw : Commute y w) (hzw : Commute z w)
    {r : A} (hr : r ∈ rootDividedPowers x y z w) (a b c d : ℕ) :
    r * orderedMonomial x y z w a b c d ∈ orderedSpan x y z w := by
  rcases mem_rootDividedPowers_iff.mp hr with ⟨n, rfl⟩ | ⟨n, rfl⟩ | ⟨n, rfl⟩ | ⟨n, rfl⟩
  · rw [orderedMonomial_def, ← mul_assoc, ← mul_assoc, ← mul_assoc, mul_dividedPower]
    simpa only [smul_mul_assoc, orderedMonomial_def] using
      (orderedSpan x y z w).nsmul_mem (orderedMonomial_mem_orderedSpan x y z w (n + a) b c d)
        (Nat.choose (n + a) n)
  · have h := commute_dividedPower_dividedPower hyz.symm n a
    rw [orderedMonomial_def]
    simp only [mul_assoc]
    rw [h.left_comm, ← mul_assoc (dividedPower n z), mul_dividedPower]
    simpa only [mul_smul_comm, smul_mul_assoc, orderedMonomial_def, mul_assoc] using
      (orderedSpan x y z w).nsmul_mem (orderedMonomial_mem_orderedSpan x y z w a (n + b) c d)
        (Nat.choose (n + b) n)
  · have h₁ := commute_dividedPower_dividedPower hyw.symm n a
    have h₂ := commute_dividedPower_dividedPower hzw.symm n b
    rw [orderedMonomial_def]
    simp only [mul_assoc]
    rw [h₁.left_comm, h₂.left_comm, ← mul_assoc (dividedPower n w), mul_dividedPower]
    simpa only [mul_smul_comm, smul_mul_assoc, orderedMonomial_def, mul_assoc] using
      (orderedSpan x y z w).nsmul_mem (orderedMonomial_mem_orderedSpan x y z w a b (n + c) d)
        (Nat.choose (n + c) n)
  · rw [dividedPower_mul_orderedMonomial hxy hxz hxw hyz]
    exact sum_mem fun p _ => sum_mem fun k _ =>
      (orderedSpan x y z w).nsmul_mem (orderedMonomial_mem_orderedSpan x y z w _ _ _ _) _

/-- **Integral ordered spanning for the positive type-B₂ algebra.** The additive group of
the subring generated by all four root divided-power families is exactly their ordered
integer span. Only the four defining relations are needed; commutation of `w` with `y`
and `z` follows from them. -/
@[simp]
theorem toAddSubgroup_closure_rootDividedPowers
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z) :
    (Subring.closure (rootDividedPowers x y z w)).toAddSubgroup = orderedSpan x y z w := by
  have hxzQ : x * z = z * x + (2 : ℚ) • w := by
    simpa only [← Nat.cast_smul_eq_nsmul ℚ, Nat.cast_ofNat] using hxz
  have hunit : IsUnit (2 : ℚ) := isUnit_iff_ne_zero.mpr (by norm_num)
  have hyw := hyz.of_commutator_eq_of_commutator_eq_smul_left hxy hxzQ hunit
  have hzw := hxw.of_commutator_eq_of_commutator_eq_smul hxy hxzQ hyz hunit
  -- Invariance under each root divided power extends from monomials to their integer span.
  have hstable {r : A} (hr : r ∈ rootDividedPowers x y z w) {s : A}
      (hs : s ∈ orderedSpan x y z w) : r * s ∈ orderedSpan x y z w := by
    induction hs using AddSubgroup.closure_induction with
    | mem s hs =>
        obtain ⟨a, b, c, d, rfl⟩ := hs
        exact root_mul_orderedMonomial_mem hxy hxz hxw hyz hyw hzw hr a b c d
    | zero => simp
    | add s t _ _ hs ht => simpa only [mul_add] using add_mem hs ht
    | neg s _ hs => simpa only [mul_neg] using neg_mem hs
  apply le_antisymm
  · intro r hr
    -- Subring induction then gives invariance under every element of the generated algebra.
    have hmul : ∀ s ∈ orderedSpan x y z w, r * s ∈ orderedSpan x y z w := by
      induction hr using Subring.closure_induction with
      | mem r hr => exact fun s hs => hstable hr hs
      | zero => simp
      | one => simpa only [one_mul] using fun s hs => hs
      | add r t _ _ hr ht =>
          intro s hs
          simpa only [add_mul] using add_mem (hr s hs) (ht s hs)
      | neg r _ hr =>
          intro s hs
          simpa only [neg_mul] using neg_mem (hr s hs)
      | mul r t _ _ hr ht =>
          intro s hs
          simpa only [mul_assoc] using hr (t * s) (ht s hs)
    have hOne : (1 : A) ∈ orderedSpan x y z w := by
      simpa only [orderedMonomial_def, dividedPower_zero, mul_one] using
        orderedMonomial_mem_orderedSpan x y z w 0 0 0 0
    simpa only [mul_one] using hmul 1 hOne
  · rw [orderedSpan_le_iff]
    intro a b c d
    have hy n : dividedPower n y ∈ Subring.closure (rootDividedPowers x y z w) :=
      Subring.subset_closure (mem_rootDividedPowers_iff.mpr (Or.inl ⟨n, rfl⟩))
    have hz n : dividedPower n z ∈ Subring.closure (rootDividedPowers x y z w) :=
      Subring.subset_closure (mem_rootDividedPowers_iff.mpr (Or.inr (Or.inl ⟨n, rfl⟩)))
    have hw n : dividedPower n w ∈ Subring.closure (rootDividedPowers x y z w) :=
      Subring.subset_closure (mem_rootDividedPowers_iff.mpr (Or.inr (Or.inr (Or.inl ⟨n, rfl⟩))))
    have hx n : dividedPower n x ∈ Subring.closure (rootDividedPowers x y z w) :=
      Subring.subset_closure (mem_rootDividedPowers_iff.mpr (Or.inr (Or.inr (Or.inr ⟨n, rfl⟩))))
    exact Subring.mul_mem _ (Subring.mul_mem _ (Subring.mul_mem _ (hy a) (hz b)) (hw c)) (hx d)

/-- Membership in the positive integral type-B₂ algebra is membership in its ordered span. -/
@[simp]
theorem mem_closure_rootDividedPowers_iff
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z) {r : A} :
    r ∈ Subring.closure (rootDividedPowers x y z w) ↔ r ∈ orderedSpan x y z w := by
  rw [← Subring.mem_toAddSubgroup, toAddSubgroup_closure_rootDividedPowers hxy hxz hxw hyz]

/-- The ordered integer span is multiplicatively closed. -/
theorem mul_mem_orderedSpan
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z) {r s : A}
    (hr : r ∈ orderedSpan x y z w) (hs : s ∈ orderedSpan x y z w) :
    r * s ∈ orderedSpan x y z w := by
  rw [← toAddSubgroup_closure_rootDividedPowers hxy hxz hxw hyz] at hr hs ⊢
  exact Subring.mul_mem _ hr hs

end Ring

end TauCeti.Associative.B2
