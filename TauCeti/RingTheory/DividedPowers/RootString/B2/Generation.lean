module

public import TauCeti.RingTheory.DividedPowers.RootString.B2.Basic

/-!
# Simple divided powers generate the positive type-B₂ integral algebra

Suppose `[x,y] = z`, `[x,z] = 2w`, `[x,w] = [y,z] = 0` in a rational associative
algebra. Every divided power of `z` and `w` belongs to the subring generated by the
divided powers of `x` and `y`. In particular no inversion of the structure constant two
is needed inside that subring. Consequently the positive integral algebra generated by
the two simple-root families has the ordered integer span
`y⁽ᵃ⁾ z⁽ᵇ⁾ w⁽ᶜ⁾ x⁽ᵈ⁾`.

The coefficient-one root-string formula is triangular in the two nonsimple exponents.
First extract `z⁽ⁿ⁾` from `x⁽ⁿ⁾ y⁽ⁿ⁾` using smaller `z` and `w` powers, then extract
`w⁽ⁿ⁾` from `x⁽²ⁿ⁾ y⁽ⁿ⁾` using the just-recovered `z⁽ⁿ⁾` and smaller `w` powers.
This is an integral-generation and spanning result, not a linear-independence assertion.

## Main results

* `Subring.b2RootDividedPowers_subset`: stability under the simple divided powers implies
  stability under all four root families.
* `TauCeti.Associative.B2.closure_rootDividedPowers_eq_closure_simpleDividedPowers`:
  equality of the two generated subrings.
* `TauCeti.Associative.B2.toAddSubgroup_closure_simpleDividedPowers`: ordered integral spanning
  for the subring generated by the two simple-root families.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.

The proof uses the coefficient-one collection formula in
`TauCeti.RingTheory.DividedPowers.RootString.Basic` and the four-root spanning theorem in
`TauCeti.RingTheory.DividedPowers.RootString.B2.Basic`.
-/

public section

open Finset TauCeti.Associative

variable {A : Type*} [Ring A] [Algebra ℚ A] {x y z w : A}

-- Extract a single term of the B₂ collection formula from the remaining terms.
private theorem Subring.b2Collection_term_mem (S : Subring A)
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z)
    (hx : ∀ n, dividedPower n x ∈ S) (hy : ∀ n, dividedPower n y ∈ S)
    (m n : ℕ) {p : ℕ × ℕ} (hp : p ∈ chainLeTwoIndex m n)
    (hrest : ∀ q ∈ (chainLeTwoIndex m n).erase p,
      dividedPower (n - q.1 - q.2) y * dividedPower q.1 z * dividedPower q.2 w *
        dividedPower (m - q.1 - 2 * q.2) x ∈ S) :
    dividedPower (n - p.1 - p.2) y * dividedPower p.1 z * dividedPower p.2 w *
      dividedPower (m - p.1 - 2 * p.2) x ∈ S := by
  classical
  have hsum := S.mul_mem (hx m) (hy n)
  rw [dividedPower_mul_dividedPower_of_commutator_eq_two_nsmul hxy hxz hxw hyz,
    ← sum_erase_add _ _ hp] at hsum
  exact (S.add_mem_cancel_left (S.sum_mem hrest)).mp hsum

private theorem Subring.b2DividedPower_z_mem (S : Subring A)
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z)
    (hx : ∀ n, dividedPower n x ∈ S) (hy : ∀ n, dividedPower n y ∈ S)
    (n : ℕ) (ih : ∀ m < n, dividedPower m z ∈ S ∧ dividedPower m w ∈ S) :
    dividedPower n z ∈ S := by
  classical
  let f : ℕ × ℕ → A := fun p => dividedPower (n - p.1 - p.2) y *
    dividedPower p.1 z * dividedPower p.2 w * dividedPower (n - p.1 - 2 * p.2) x
  have htop : (n, 0) ∈ chainLeTwoIndex n n := by simp
  have hleading : f (n, 0) ∈ S := by
    apply S.b2Collection_term_mem hxy hxz hxw hyz hx hy n n htop
    intro p hp
    obtain ⟨hne, hp⟩ := mem_erase.mp hp
    have hb : p.1 < n := by
      have := mem_chainLeTwoIndex.mp hp
      have : p ≠ (n, 0) := hne
      contrapose! this
      ext <;> omega
    have hc : p.2 < n := by
      have := mem_chainLeTwoIndex.mp hp
      omega
    exact S.mul_mem (S.mul_mem (S.mul_mem (hy _) (ih _ hb).1) (ih _ hc).2) (hx _)
  simpa only [f, Nat.sub_self, Nat.sub_zero, mul_zero, dividedPower_zero,
    one_mul, mul_one] using hleading

private theorem Subring.b2DividedPower_w_mem (S : Subring A)
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z)
    (hx : ∀ n, dividedPower n x ∈ S) (hy : ∀ n, dividedPower n y ∈ S)
    (n : ℕ) (hz : ∀ m ≤ n, dividedPower m z ∈ S)
    (hw : ∀ m < n, dividedPower m w ∈ S) : dividedPower n w ∈ S := by
  classical
  let f : ℕ × ℕ → A := fun p => dividedPower (n - p.1 - p.2) y *
    dividedPower p.1 z * dividedPower p.2 w * dividedPower (2 * n - p.1 - 2 * p.2) x
  have htop : (0, n) ∈ chainLeTwoIndex (2 * n) n := by simp
  have hleading : f (0, n) ∈ S := by
    apply S.b2Collection_term_mem hxy hxz hxw hyz hx hy (2 * n) n htop
    intro p hp
    obtain ⟨hne, hp⟩ := mem_erase.mp hp
    have hb : p.1 ≤ n := by
      have := mem_chainLeTwoIndex.mp hp
      omega
    have hc : p.2 < n := by
      have := mem_chainLeTwoIndex.mp hp
      have : p ≠ (0, n) := hne
      contrapose! this
      ext <;> omega
    exact S.mul_mem (S.mul_mem (S.mul_mem (hy _) (hz _ hb)) (hw _ hc)) (hx _)
  simpa only [f, Nat.sub_zero, Nat.sub_self, dividedPower_zero, one_mul, mul_one]
    using hleading

/-- A subring containing the divided powers of the two simple root vectors in type B₂
contains those of every positive root, even though `[x,z] = 2w` has a nonunit integer
structure constant. No nilpotence or independence hypothesis is needed. -/
theorem Subring.b2RootDividedPowers_subset (S : Subring A)
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z)
    (hx : ∀ n, dividedPower n x ∈ S) (hy : ∀ n, dividedPower n y ∈ S) :
    B2.rootDividedPowers x y z w ⊆ S := by
  have hzw : ∀ n, dividedPower n z ∈ S ∧ dividedPower n w ∈ S := by
    intro n
    induction n using Nat.strong_induction_on with
    | ind n ih =>
      -- First extract the unique highest z-term, indexed by (n, 0).
      have hz := S.b2DividedPower_z_mem hxy hxz hxw hyz hx hy n ih
      refine ⟨hz, S.b2DividedPower_w_mem hxy hxz hxw hyz hx hy n ?_ (fun m hm => (ih m hm).2)⟩
      -- The highest w-term, indexed by (0, n), can use the just-recovered z-power.
      intro m hm
      rcases hm.eq_or_lt with rfl | hlt
      · exact hz
      · exact (ih m hlt).1
  intro r hr
  rcases B2.mem_rootDividedPowers_iff.mp hr with
    ⟨n, rfl⟩ | ⟨n, rfl⟩ | ⟨n, rfl⟩ | ⟨n, rfl⟩
  · exact hy n
  · exact (hzw n).1
  · exact (hzw n).2
  · exact hx n

namespace TauCeti.Associative.B2

/-- The divided powers of the two simple root vectors in type B₂. -/
noncomputable def simpleDividedPowers (x y : A) : Set A :=
  Set.range (fun n => dividedPower n x) ∪ Set.range (fun n => dividedPower n y)

@[simp]
theorem mem_simpleDividedPowers_iff {r : A} :
    r ∈ simpleDividedPowers x y ↔ (∃ n, dividedPower n x = r) ∨ ∃ n, dividedPower n y = r := by
  simp only [simpleDividedPowers, Set.mem_union, Set.mem_range]

/-- All positive-root divided powers in type B₂ are generated integrally by the two
simple-root divided-power families. -/
theorem closure_rootDividedPowers_eq_closure_simpleDividedPowers
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z) :
    Subring.closure (rootDividedPowers x y z w) =
      Subring.closure (simpleDividedPowers x y) := by
  apply le_antisymm
  · apply Subring.closure_le.mpr
    apply Subring.b2RootDividedPowers_subset _ hxy hxz hxw hyz
    · exact fun n => Subring.subset_closure (mem_simpleDividedPowers_iff.mpr (Or.inl ⟨n, rfl⟩))
    · exact fun n => Subring.subset_closure (mem_simpleDividedPowers_iff.mpr (Or.inr ⟨n, rfl⟩))
  · apply Subring.closure_mono
    intro r hr
    rcases mem_simpleDividedPowers_iff.mp hr with ⟨n, rfl⟩ | ⟨n, rfl⟩
    · exact mem_rootDividedPowers_iff.mpr (Or.inr (Or.inr (Or.inr ⟨n, rfl⟩)))
    · exact mem_rootDividedPowers_iff.mpr (Or.inl ⟨n, rfl⟩)

/-- The subring generated by the simple divided powers in type B₂ has the ordered integer
span of all four positive-root families as its additive group. -/
theorem toAddSubgroup_closure_simpleDividedPowers
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z) :
    (Subring.closure (simpleDividedPowers x y)).toAddSubgroup = orderedSpan x y z w := by
  rw [← closure_rootDividedPowers_eq_closure_simpleDividedPowers hxy hxz hxw hyz,
    toAddSubgroup_closure_rootDividedPowers hxy hxz hxw hyz]

/-- Membership in the subring generated by the simple divided powers in type B₂ is
membership in the ordered integer span of all four positive-root families. -/
theorem mem_closure_simpleDividedPowers_iff
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z) {r : A} :
    r ∈ Subring.closure (simpleDividedPowers x y) ↔ r ∈ orderedSpan x y z w := by
  rw [← Subring.mem_toAddSubgroup, toAddSubgroup_closure_simpleDividedPowers hxy hxz hxw hyz]

end TauCeti.Associative.B2
