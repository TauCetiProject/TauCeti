module

public import TauCeti.RingTheory.DividedPowers.RootString.B2.Basic

/-!
# Simple divided powers generate the positive type-B₂ integral algebra

Suppose `[x,y] = z`, `[x,z] = 2w`, `[x,w] = [y,z] = 0` in a rational associative
algebra. Every divided power of `z` and `w` belongs to the subring generated by the
divided powers of `x` and `y`. In particular no inversion of the structure constant two
is needed inside that subring. Consequently the positive integral algebra generated by
the two simple-root families has the ordered integer span
`y⁽ᵃ⁾ z⁽ᵇ⁾ w⁽ᶜ⁾ x⁽ᵈ⁾`.

The coefficient-one root-string formula is triangular in the two nonsimple exponents.
First extract `z⁽ⁿ⁾` from `x⁽ⁿ⁾ y⁽ⁿ⁾` using smaller `z` and `w` powers, then extract
`w⁽ⁿ⁾` from `x⁽²ⁿ⁾ y⁽ⁿ⁾` using the just-recovered `z⁽ⁿ⁾` and smaller `w` powers.
This is an integral-generation and spanning result, not a linear-independence assertion.

## Main results

* `Subring.b2_rootDividedPowers_subset`: stability under the simple divided powers implies
  stability under all four root families.
* `TauCeti.Associative.B2.closure_rootDividedPowers_eq_closure_simple`: equality of the two
  generated subrings.
* `TauCeti.Associative.B2.toAddSubgroup_closure_simpleDividedPowers`: ordered integral spanning
  for the subring generated by the two simple-root families.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.

The proof uses the coefficient-one collection formula in
`TauCeti.RingTheory.DividedPowers.RootString.Basic` and the four-root spanning theorem in
`TauCeti.RingTheory.DividedPowers.RootString.B2.Basic`.
-/

public section

open Finset TauCeti.Associative

variable {A : Type*} [Ring A] [Algebra ℚ A] {x y z w : A}

/-- A subring containing the divided powers of the two simple root vectors in type B₂
contains those of every positive root, even though `[x,z] = 2w` has a nonunit integer
structure constant. No nilpotence or independence hypothesis is needed. -/
theorem Subring.b2_rootDividedPowers_subset (S : Subring A)
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z)
    (hx : ∀ n, dividedPower n x ∈ S) (hy : ∀ n, dividedPower n y ∈ S) :
    B2.rootDividedPowers x y z w ⊆ S := by
  classical
  have hzw : ∀ n, dividedPower n z ∈ S ∧ dividedPower n w ∈ S := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      -- The unique term with z-exponent n is (n, 0); every other exponent is smaller.
      have hz : dividedPower n z ∈ S := by
        let f : ℕ × ℕ → A := fun p => dividedPower (n - p.1 - p.2) y *
          dividedPower p.1 z * dividedPower p.2 w * dividedPower (n - p.1 - 2 * p.2) x
        have htop : (n, 0) ∈ chainLeTwoIndex n n := by simp
        have hrest : ∑ p ∈ (chainLeTwoIndex n n).erase (n, 0), f p ∈ S := by
          apply S.sum_mem
          intro p hp
          obtain ⟨hne, hp⟩ := mem_erase.mp hp
          have hb : p.1 < n := by
            have := mem_chainLeTwoIndex.mp hp
            have : p ≠ (n, 0) := hne
            contrapose! this
            ext <;> omega
          have hc : p.2 < n := by
            have := mem_chainLeTwoIndex.mp hp
            omega
          exact S.mul_mem (S.mul_mem (S.mul_mem (hy _) (ih _ hb).1) (ih _ hc).2) (hx _)
        have hsum : ∑ p ∈ chainLeTwoIndex n n, f p ∈ S := by
          rw [← dividedPower_mul_dividedPower_of_commutator_eq_two_nsmul hxy hxz hxw hyz]
          exact S.mul_mem (hx n) (hy n)
        rw [← sum_erase_add _ _ htop] at hsum
        simpa [f] using S.sub_mem hsum hrest
      refine ⟨hz, ?_⟩
      -- Now (0, n) is the unique highest w-term. The z-exponent can equal n,
      -- which is why the preceding extraction must come first.
      let f : ℕ × ℕ → A := fun p => dividedPower (n - p.1 - p.2) y *
        dividedPower p.1 z * dividedPower p.2 w * dividedPower (2 * n - p.1 - 2 * p.2) x
      have htop : (0, n) ∈ chainLeTwoIndex (2 * n) n := by simp
      have hrest : ∑ p ∈ (chainLeTwoIndex (2 * n) n).erase (0, n), f p ∈ S := by
        apply S.sum_mem
        intro p hp
        obtain ⟨hne, hp⟩ := mem_erase.mp hp
        have hb : p.1 ≤ n := by
          have := mem_chainLeTwoIndex.mp hp
          omega
        have hc : p.2 < n := by
          have := mem_chainLeTwoIndex.mp hp
          have : p ≠ (0, n) := hne
          contrapose! this
          ext <;> omega
        have hzp : dividedPower p.1 z ∈ S := by
          rcases hb.eq_or_lt with heq | hlt
          · simpa [heq] using hz
          · exact (ih _ hlt).1
        exact S.mul_mem (S.mul_mem (S.mul_mem (hy _) hzp) (ih _ hc).2) (hx _)
      have hsum : ∑ p ∈ chainLeTwoIndex (2 * n) n, f p ∈ S := by
        rw [← dividedPower_mul_dividedPower_of_commutator_eq_two_nsmul hxy hxz hxw hyz]
        exact S.mul_mem (hx _) (hy n)
      rw [← sum_erase_add _ _ htop] at hsum
      simpa [f] using S.sub_mem hsum hrest
  intro r hr
  rcases B2.mem_rootDividedPowers_iff.mp hr with
    ⟨n, rfl⟩ | ⟨n, rfl⟩ | ⟨n, rfl⟩ | ⟨n, rfl⟩
  · exact hy n
  · exact (hzw n).1
  · exact (hzw n).2
  · exact hx n

namespace TauCeti.Associative.B2

/-- All positive-root divided powers in type B₂ are generated integrally by the two
simple-root divided-power families. -/
theorem closure_rootDividedPowers_eq_closure_simple
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z) :
    Subring.closure (rootDividedPowers x y z w) =
      Subring.closure (Set.range (fun n => dividedPower n x) ∪
        Set.range (fun n => dividedPower n y)) := by
  apply le_antisymm
  · apply Subring.closure_le.mpr
    apply Subring.b2_rootDividedPowers_subset _ hxy hxz hxw hyz
    · exact fun n => Subring.subset_closure (Or.inl ⟨n, rfl⟩)
    · exact fun n => Subring.subset_closure (Or.inr ⟨n, rfl⟩)
  · apply Subring.closure_mono
    rintro r (⟨n, rfl⟩ | ⟨n, rfl⟩)
    · exact mem_rootDividedPowers_iff.mpr (Or.inr (Or.inr (Or.inr ⟨n, rfl⟩)))
    · exact mem_rootDividedPowers_iff.mpr (Or.inl ⟨n, rfl⟩)

/-- The subring generated by the simple divided powers in type B₂ has the ordered integer
span of all four positive-root families as its additive group. -/
theorem toAddSubgroup_closure_simpleDividedPowers
    (hxy : x * y = y * x + z) (hxz : x * z = z * x + 2 • w)
    (hxw : Commute x w) (hyz : Commute y z) :
    (Subring.closure (Set.range (fun n => dividedPower n x) ∪
      Set.range (fun n => dividedPower n y))).toAddSubgroup = orderedSpan x y z w := by
  rw [← closure_rootDividedPowers_eq_closure_simple hxy hxz hxw hyz,
    toAddSubgroup_closure_rootDividedPowers hxy hxz hxw hyz]

end TauCeti.Associative.B2
