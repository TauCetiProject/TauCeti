module

public import TauCeti.RingTheory.DedekindDomain.SInteger.ClassGroup
public import TauCeti.RingTheory.DedekindDomain.SInteger.Localization
import TauCeti.RingTheory.ClassGroup.Extension
import TauCeti.RingTheory.DedekindDomain.Localization
import TauCeti.RingTheory.Localization.Defs

/-!
# The class group of a localization of a Dedekind domain

Let `R` be a Dedekind domain and `B` the localization of `R` at a submonoid `M` not containing
zero, so that `B` is again a Dedekind domain with the same fraction field. Extension of ideals
`ClassGroup.extendedHom R B : Cl(R) → Cl(B)` is surjective, and its kernel is generated by the
classes `[v]` of the height-one primes `v` of `R` meeting `M`: these are exactly the primes that
become the unit ideal in `B`.

This reduces to the corresponding statements for rings of `S`-integers,
`IsDedekindDomain.integer_extendedHom_surjective` and `IsDedekindDomain.ker_integer_extendedHom`:
`B` is the ring of `S`-integers for `S` the set of primes meeting `M`
(`IsDedekindDomain.integer_setOf_exists_mem_isLocalization`), and extension of ideal classes is
compatible with the resulting isomorphism of `R`-algebras (`ClassGroup.map_comp_extendedHom`).

## Main results

* `ClassGroup.extendedHom_surjective_of_isLocalization`: extension of ideal classes to a
  localization is surjective.
* `ClassGroup.ker_extendedHom_of_isLocalization`: its kernel is generated by the classes of the
  height-one primes meeting `M`.

## References

* C. A. Weibel, *The K-book: an introduction to algebraic K-theory*, Chapter I, Exercise 3.8,
  and Chapter II, Corollary 2.6.3.
-/

public section

open IsDedekindDomain

namespace ClassGroup

variable {R : Type*} [CommRing R] [IsDedekindDomain R] (M : Submonoid R) (B : Type*) [CommRing B]
  [IsDomain B] [Algebra R B] [Module.IsTorsionFree R B] [IsLocalization M B]

/-- Extension of ideal classes to a localization of `R` factors as extension of ideal classes to
the ring of `S`-integers for `S` the set of primes meeting `M`, followed by an isomorphism. -/
private lemma exists_mulEquiv_comp_extendedHom :
    ∃ e : ClassGroup B ≃* ClassGroup
        ({v : HeightOneSpectrum R | ∃ m ∈ M, m ∈ v.asIdeal}.integer (FractionRing R)),
      e.toMonoidHom.comp (extendedHom R B) = extendedHom R _ := by
  have hM := TauCeti.IsLocalization.le_nonZeroDivisors_of_nontrivial M B
  have := TauCeti.IsLocalization.isDedekindDomain_of_nontrivial M B
  have := integer_setOf_exists_mem_isLocalization (FractionRing R) M hM
  let g := IsLocalization.algEquiv M B
    ({v : HeightOneSpectrum R | ∃ m ∈ M, m ∈ v.asIdeal}.integer (FractionRing R))
  refine ⟨mulEquiv g.toRingEquiv, ?_⟩
  rw [← map_comp_extendedHom g.toAlgHom g.injective]
  -- `mulEquiv g` is `ClassGroup.map` along the underlying ring homomorphism of `g`
  -- (`ClassGroup.mulEquiv_apply`), which is that of `g.toAlgHom`.
  exact MonoidHom.ext fun x ↦ (mulEquiv_apply _ _).trans
    (DFunLike.congr_fun (map_congr rfl _ _) _)

include M in
/-- **Extension of ideal classes to a localization is surjective.** Every ideal class of
the localization `B` of `R` at `M` is the class of an ideal extended from `R`. -/
theorem extendedHom_surjective_of_isLocalization :
    Function.Surjective (extendedHom R B) := by
  obtain ⟨e, he⟩ := exists_mulEquiv_comp_extendedHom M B
  intro c
  obtain ⟨x, hx⟩ := integer_extendedHom_surjective (FractionRing R)
    {v : HeightOneSpectrum R | ∃ m ∈ M, m ∈ v.asIdeal} (e c)
  refine ⟨x, e.injective ?_⟩
  rw [← hx, ← he, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom]

/-- **The kernel of extension of ideal classes to a localization.** Extension of ideal classes
from `R` to its localization at `M` has kernel generated by the classes `[v]` of the height-one
primes `v` of `R` meeting `M`. -/
theorem ker_extendedHom_of_isLocalization :
    (extendedHom R B).ker =
      Subgroup.closure (HeightOneSpectrum.classGroupMk ''
        {v : HeightOneSpectrum R | ∃ m ∈ M, m ∈ v.asIdeal}) := by
  obtain ⟨e, he⟩ := exists_mulEquiv_comp_extendedHom M B
  rw [← ker_integer_extendedHom (FractionRing R), ← he,
    MonoidHom.ker_comp_of_injective _ _ e.injective]

end ClassGroup
