/-!
# Noether normalization of a cone by linear forms

Let `k` be a field, `L` a field over `k` and `g : ι → L` a finite tuple. A tuple `v` in a
`k`-algebra *lies on the cone* of `g` (`TauCeti.LiesOnCone k g v`) if every homogeneous
polynomial over `k` that vanishes at `g` vanishes at `v`. Linear forms `Λ j = ∑ i, Λ j i • X i`
over `k` are a *Noether normalization* of `g` (`TauCeti.IsNoetherNormalization k Λ g`) if their
values at `g` satisfy no nonzero homogeneous relation over `k`, and every tuple `v` in a field on
the cone of `g` has entries integral over every `k`-subalgebra containing the values `Λ j (v)`.

Over an infinite field (in particular in characteristic zero) every nonzero `g` has such linear
forms `Λ 0, …, Λ d` with `Λ 0 (g) ≠ 0`, and they serve for every nonzero multiple `u • g`
(`TauCeti.exists_isNoetherNormalization`). The proof applies Tau Ceti's linear Noether
normalization `TauCeti.exists_linear_normalization_of_finite` to the `k`-algebra generated by the
`g i • T` in `L[T]`. A polynomial vanishes at `(g i • T)` exactly when each of its homogeneous
components vanishes at `g` (`MvPolynomial.coeff_aeval_C_mul_X`), so every `v` on the
cone of `g` defines a map from that algebra sending `g i • T` to `v i`, along which integrality is
transported. There is at least one form, since `g i • T` is transcendental over `L` when
`g i ≠ 0`; and neither the cone nor the Noether normalizations change when `g` is scaled by a
unit (`TauCeti.liesOnCone_smul_left_iff`, `TauCeti.isNoetherNormalization_smul_iff`).

## Main definitions

* `TauCeti.LiesOnCone k g v`: `v` lies on the cone of `g` over `k`.
* `TauCeti.IsNoetherNormalization k Λ g`: the linear forms `Λ` are a Noether normalization
  of `g`, tested on fields in a fixed universe `w`.

## Main results

* `TauCeti.LiesOnCone.trans`, `TauCeti.LiesOnCone.map`, `TauCeti.LiesOnCone.smul_right`: the
  cone is transitive, stable under algebra maps and under scaling `v`.
* `TauCeti.liesOnCone_smul_left_iff`, `TauCeti.liesOnCone_smul_right_iff`: scaling `g`, or `v`,
  by a unit does not change whether `v` lies on the cone of `g`.
* `TauCeti.isNoetherNormalization_smul_iff`: scaling `g` by a unit does not change its Noether
  normalizations.
* `TauCeti.exists_isNoetherNormalization`: over an infinite field, a nonzero `g` has a
  Noether normalization `Λ 0, …, Λ d` with `Λ 0 (g) ≠ 0` that is one for every `u • g`, `u ≠ 0`.
* `TauCeti.exists_isNoetherNormalization_of_charZero`: the same in characteristic zero.

## References

* D. Eisenbud, *Commutative Algebra with a View Toward Algebraic Geometry*, Chapter 13
  (Noether normalization by linear forms over an infinite field).
* Cf. `New.Variety.CutsOutLocus.IsHomogeneousSolution`,
  `New.Variety.CutsOutLocus.IsNoetherNormalization` and
  `New.Variety.CutsOutLocus.exists_isNoetherNormalization`
  (`Lib/Cohomology/PointClass/NoetherNormalization`) in the folder `grh` of
  https://github.com/lsernau/grh-lean at commit 72fead102f663d5c7a407964a13dc0cf9d977207.
-/

public section

open scoped Polynomial

open MvPolynomial

namespace TauCeti

universe w

section Cone

variable (k : Type*) {ι A B C : Type*} [CommSemiring k] [CommSemiring A] [Algebra k A]
  [CommSemiring B] [Algebra k B] [CommSemiring C] [Algebra k C]

/-- A tuple `v` *lies on the cone* of a tuple `g` (over `k`) if every homogeneous polynomial over
`k` that vanishes at `g` vanishes at `v`. -/
def LiesOnCone (g : ι → A) (v : ι → B) : Prop :=
  ∀ (P : MvPolynomial ι k) (n : ℕ), P.IsHomogeneous n → aeval g P = 0 → aeval v P = 0

variable {k}

/-- Unfolding `LiesOnCone`. -/
theorem liesOnCone_iff {g : ι → A} {v : ι → B} :
    LiesOnCone k g v ↔
      ∀ (P : MvPolynomial ι k) (n : ℕ), P.IsHomogeneous n → aeval g P = 0 → aeval v P = 0 :=
  Iff.rfl

/-- Every tuple lies on its own cone. -/
@[simp]
theorem liesOnCone_refl (g : ι → A) : LiesOnCone k g g := fun _ _ _ h ↦ h

/-- A tuple on the cone of a tuple on the cone of `g` lies on the cone of `g`. -/
theorem LiesOnCone.trans {g : ι → A} {v : ι → B} {w : ι → C} (hv : LiesOnCone k g v)
    (hw : LiesOnCone k v w) : LiesOnCone k g w :=
  fun P n hP h ↦ hw P n hP (hv P n hP h)

/-- The image of a tuple on the cone of `g` under a `k`-algebra map lies on the cone of `g`. -/
theorem LiesOnCone.map {g : ι → A} {v : ι → B} (hv : LiesOnCone k g v) (f : B →ₐ[k] C) :
    LiesOnCone k g (f ∘ v) := fun P n hP h ↦ by
  rw [Function.comp_def, ← comp_aeval_apply, hv P n hP h, map_zero]

/-- A multiple of a tuple on the cone of `g` lies on the cone of `g`. -/
theorem LiesOnCone.smul_right {g : ι → A} {v : ι → B} (hv : LiesOnCone k g v) (c : B) :
    LiesOnCone k g (c • v) := fun P n hP h ↦ by
  rw [hP.aeval_smul_of_algebra, hv P n hP h, smul_zero]

/-- The cone of `g` does not change when `g` is scaled by a unit. -/
theorem liesOnCone_smul_left_iff {g : ι → A} {v : ι → B} {u : A} (hu : IsUnit u) :
    LiesOnCone k (u • g) v ↔ LiesOnCone k g v := by
  rw [liesOnCone_iff, liesOnCone_iff]
  refine forall₃_congr fun P n hP ↦ ?_
  rw [hP.aeval_smul_of_algebra, smul_eq_mul, (hu.pow n).mul_right_eq_zero]

/-- Scaling `v` by a unit does not change whether it lies on the cone of `g`. -/
theorem liesOnCone_smul_right_iff {g : ι → A} {v : ι → B} {c : B} (hc : IsUnit c) :
    LiesOnCone k g (c • v) ↔ LiesOnCone k g v := by
  refine ⟨fun hv ↦ ?_, fun hv ↦ hv.smul_right c⟩
  simpa [smul_smul] using hv.smul_right ↑hc.unit⁻¹

end Cone

section NoetherNormalization

variable (k : Type*) {κ ι L : Type*} [CommRing k] [Fintype ι] [CommRing L] [Algebra k L]

/-- Linear forms `Λ j = ∑ i, Λ j i • X i` over `k` are a *Noether normalization* of a tuple `g`
if their values at `g` satisfy no nonzero homogeneous relation over `k`, and for every tuple `v`
in a field `K` (in the universe `w`) on the cone of `g`, every entry of `v` is integral over every
`k`-subalgebra of `K` containing the values `Λ j (v)`. -/
def IsNoetherNormalization (Λ : κ → ι → k) (g : ι → L) : Prop :=
  (∀ (P : MvPolynomial κ k) (n : ℕ), P.IsHomogeneous n →
      aeval (fun j ↦ ∑ i, Λ j i • g i) P = 0 → P = 0) ∧
    ∀ (K : Type w) [Field K] [Algebra k K] (v : ι → K), LiesOnCone k g v →
      ∀ S : Subalgebra k K, (∀ j, ∑ i, Λ j i • v i ∈ S) → ∀ i, IsIntegral S (v i)

variable {k}

/-- Unfolding `IsNoetherNormalization`. -/
theorem isNoetherNormalization_iff {Λ : κ → ι → k} {g : ι → L} :
    IsNoetherNormalization.{w} k Λ g ↔
      (∀ (P : MvPolynomial κ k) (n : ℕ), P.IsHomogeneous n →
        aeval (fun j ↦ ∑ i, Λ j i • g i) P = 0 → P = 0) ∧
      ∀ (K : Type w) [Field K] [Algebra k K] (v : ι → K), LiesOnCone k g v →
        ∀ S : Subalgebra k K, (∀ j, ∑ i, Λ j i • v i ∈ S) → ∀ i, IsIntegral S (v i) :=
  Iff.rfl

/-- Scaling `g` by a unit does not change its Noether normalizations. -/
theorem isNoetherNormalization_smul_iff {Λ : κ → ι → k} {g : ι → L} {u : L} (hu : IsUnit u) :
    IsNoetherNormalization.{w} k Λ (u • g) ↔ IsNoetherNormalization.{w} k Λ g := by
  have e : (fun j ↦ ∑ i, Λ j i • (u • g) i) = u • fun j ↦ ∑ i, Λ j i • g i := by
    ext j
    simp [Finset.mul_sum]
  rw [isNoetherNormalization_iff, isNoetherNormalization_iff, e]
  refine and_congr (forall₃_congr fun P n hP ↦ ?_) ?_
  · rw [hP.aeval_smul_of_algebra, smul_eq_mul, (hu.pow n).mul_right_eq_zero]
  · simp only [liesOnCone_smul_left_iff hu]

end NoetherNormalization

section Existence

variable {k ι L : Type*} [Field k] [Field L] [Algebra k L]

/-- A tuple on the cone of `g` is a zero of every polynomial vanishing at `(g i • T)`. -/
private theorem aeval_eq_zero_of_liesOnCone {B : Type*} [CommRing B] [Algebra k B] {g : ι → L}
    {v : ι → B} (hv : LiesOnCone k g v) {P : MvPolynomial ι k}
    (hP : aeval (fun i ↦ Polynomial.C (g i) * Polynomial.X) P = 0) : aeval v P = 0 := by
  rw [← sum_homogeneousComponent P, map_sum]
  refine Finset.sum_eq_zero fun m _ ↦ hv _ m (homogeneousComponent_isHomogeneous m P) ?_
  -- The coefficient of `T ^ m`, computed over `L` after mapping the coefficients of `P`.
  have h := coeff_aeval_C_mul_X (P.map (algebraMap k L)) g m
  rw [aeval_map_algebraMap, hP, Polynomial.coeff_zero, ← map_homogeneousComponent, eval_map,
    ← aeval_def] at h
  exact h.symm

variable [Fintype ι]

/-- The linear forms of a linear Noether normalization of the algebra generated by the
`g i • T` in `L[T]`: no homogeneous relation among their values at `g`, and integrality of every
tuple on the cone of `g`, with values in any commutative ring. -/
private theorem exists_linear_forms [Infinite k] (g : ι → L) :
    ∃ (d : ℕ) (Λ : Fin d → ι → k),
      (∀ (P : MvPolynomial (Fin d) k) (n : ℕ), P.IsHomogeneous n →
        aeval (fun j ↦ ∑ i, Λ j i • g i) P = 0 → P = 0) ∧
      (∀ (B : Type w) [CommRing B] [Algebra k B] (v : ι → B), LiesOnCone k g v →
        ∀ i, (aeval (R := k) fun j ↦ ∑ i, Λ j i • v i).toRingHom.IsIntegralElem (v i)) ∧
      (d = 0 → ∀ i, g i = 0) := by
  classical
  set x : ι → L[X] := fun i ↦ Polynomial.C (g i) * Polynomial.X
  set I := RingHom.ker (aeval (R := k) x)
  have : Nontrivial (MvPolynomial ι k ⧸ I) :=
    Ideal.Quotient.nontrivial_iff.mpr (RingHom.ker_ne_top _)
  have hk (P : MvPolynomial ι k) :
      Ideal.kerLiftAlg (aeval (R := k) x) (Ideal.Quotient.mkₐ k I P) = aeval x P := by
    rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.kerLiftAlg_mk]
  have hgen : aeval (fun i ↦ Ideal.Quotient.mkₐ k I (X i)) = Ideal.Quotient.mkₐ k I :=
    (aeval_unique _).symm
  obtain ⟨d, -, Λ, hind, hfin, -⟩ := TauCeti.exists_linear_normalization_of_finite
    (fun i ↦ Ideal.Quotient.mkₐ k I (X i))
    (hgen ▸ AlgHom.Finite.of_surjective _ (Ideal.Quotient.mkₐ_surjective k I))
  set y : Fin d → MvPolynomial ι k ⧸ I := fun j ↦ ∑ i, Λ j i • Ideal.Quotient.mkₐ k I (X i)
  have hy (j : Fin d) : Ideal.kerLiftAlg (aeval (R := k) x) (y j) =
      Polynomial.C (∑ i, Λ j i • g i) * Polynomial.X := by
    simp only [y, map_sum, map_smul, hk, aeval_X, x, Finset.sum_mul, ← smul_mul_assoc,
      Polynomial.smul_C]
  refine ⟨d, Λ, fun P n hP h ↦ hind ?_, fun B _ _ v hv i ↦ ?_, fun hd i ↦ ?_⟩
  · refine Ideal.kerLiftAlg_injective _ ?_
    rw [comp_aeval_apply, map_zero]
    simp only [hy, hP.aeval_C_mul_X, h, map_zero, zero_mul]
  · let ψ := Ideal.Quotient.liftₐ I (aeval v) fun P hP ↦ aeval_eq_zero_of_liesOnCone hv hP
    have hψX (i : ι) : ψ (Ideal.Quotient.mkₐ k I (X i)) = v i := by
      rw [← AlgHom.comp_apply, Ideal.Quotient.liftₐ_comp, aeval_X]
    have hψ : ψ.comp (aeval y) = aeval fun j ↦ ∑ i, Λ j i • v i := by
      simp only [comp_aeval, y, map_sum, map_smul, hψX]
    rw [← hψ, ← hψX i]
    simpa [AlgHom.comp_toRingHom] using
      ((hfin.to_isIntegral) (Ideal.Quotient.mkₐ k I (X i))).map ψ.toRingHom
  · -- With no forms, the quotient is module-finite over `k`, so `g i • T` would be algebraic
    -- over `L`.
    subst hd
    by_contra hgi
    have : Module.Finite k (MvPolynomial ι k ⧸ I) := by
      rw [← RingHom.finite_algebraMap, ← (aeval y).comp_algebraMap]
      exact RingHom.Finite.comp hfin (RingHom.Finite.of_surjective _ (C_surjective (Fin 0)))
    have hint := ((Algebra.IsIntegral.isIntegral (R := k) (Ideal.Quotient.mkₐ k I (X i))).map
      (Ideal.kerLiftAlg (aeval (R := k) x))).tower_top (A := L)
    rw [hk, aeval_X] at hint
    exact Polynomial.transcendental (x i) (by simp [x, hgi])
      (by simp [x, hgi]) hint.isAlgebraic

/-- **Noether normalization of a cone by linear forms.** Over an infinite field `k`, a nonzero
tuple `g` in a field `L` over `k` has linear forms `Λ 0, …, Λ d` over `k`, with `Λ 0 (g) ≠ 0`,
that are a Noether normalization of `u • g` for every nonzero `u ∈ L`. -/
theorem exists_isNoetherNormalization [Infinite k] {g : ι → L} (hg : g ≠ 0) :
    ∃ (d : ℕ) (Λ : Fin (d + 1) → ι → k), ∑ i, Λ 0 i • g i ≠ 0 ∧
      ∀ u : L, u ≠ 0 → IsNoetherNormalization.{w} k Λ (u • g) := by
  obtain ⟨d, Λ, hrel, hint, hd⟩ := exists_linear_forms (k := k) g
  obtain ⟨d, rfl⟩ := Nat.exists_eq_succ_of_ne_zero fun h ↦ hg (funext (hd h))
  have hΛ : IsNoetherNormalization.{w} k Λ g := ⟨hrel, fun K _ _ v hv S hS i ↦
    (hint K v hv i).isIntegral_of_range_le
      (by rw [aeval_range]; exact Algebra.adjoin_le (Set.range_subset_iff.mpr hS))⟩
  exact ⟨d, Λ, fun h ↦ X_ne_zero (R := k) (0 : Fin (d + 1))
      (hrel _ 1 (isHomogeneous_X k 0) (by simpa using h)),
    fun u hu ↦ (isNoetherNormalization_smul_iff hu.isUnit).mpr hΛ⟩

/-- **Noether normalization of a cone by linear forms** over a field of characteristic zero, a
special case of `exists_isNoetherNormalization` (such a field is infinite). -/
theorem exists_isNoetherNormalization_of_charZero [CharZero k] {g : ι → L} (hg : g ≠ 0) :
    ∃ (d : ℕ) (Λ : Fin (d + 1) → ι → k), ∑ i, Λ 0 i • g i ≠ 0 ∧
      ∀ u : L, u ≠ 0 → IsNoetherNormalization.{w} k Λ (u • g) :=
  have : Infinite k := Infinite.of_injective _ Nat.cast_injective
  exists_isNoetherNormalization hg

end Existence

end TauCeti
