module

public import Mathlib.RingTheory.ZMod.UnitsCyclic

/-!
# The units modulo a power of two

For every `e`, the unit group `(ℤ/2^(e+3))ˣ` is the internal direct product of the subgroup
`{±1}` and the cyclic subgroup of order `2 ^ (e + 1)` generated by the class of `5`. Concretely,
`ZMod.unitsTwoPowEquiv e` is a group isomorphism
`(ZMod (2 ^ (e + 3)))ˣ ≃* Multiplicative (ZMod 2 × ZMod (2 ^ (e + 1)))` sending `-1` to `(1, 0)`
and `5` to `(0, 1)`; its inverse sends `(s, k)` to `(-1) ^ s * 5 ^ k`. The indexing by `e + 3`
encodes that the modulus is at least `8`: for the moduli `1`, `2` and `4` the unit group is
cyclic (`ZMod.isCyclic_units_two_pow_iff`).

This explicit form, rather than the bare isomorphism type, is what reads off characters of
two-power level from their values at `-1` and `5`.

## Main definitions and results

* `ZMod.unitsTwoPowFive`: the class of `5` in `(ZMod (2 ^ (e + 3)))ˣ`.
* `ZMod.orderOf_unitsTwoPowFive`: it has order `2 ^ (e + 1)`.
* `ZMod.unitsMap_unitsTwoPowFive`: reduction modulo `4` sends `5` to `1`.
* `ZMod.neg_one_notMem_zpowers_unitsTwoPowFive`: `-1` is not a power of `5`.
* `ZMod.unitsTwoPowEquiv`: the isomorphism with `ℤ/2 × ℤ/2^(e+1)`.
* `ZMod.unitsTwoPowEquiv_symm_apply`, `ZMod.unitsTwoPowEquiv_neg_one`,
  `ZMod.unitsTwoPowEquiv_five`: its values.

## Reference

Victor Shoup, *A Computational Introduction to Number Theory and Algebra* (2nd ed.),
Theorem 7.28 and its proof for `p = 2`.
-/

public section

namespace ZMod

open Multiplicative

variable (e : ℕ)

/-- The class of `5` in the units modulo `2 ^ (e + 3)`. -/
def unitsTwoPowFive : (ZMod (2 ^ (e + 3)))ˣ :=
  ZMod.unitOfCoprime 5 (Nat.Coprime.pow_right _ (by decide))

/-- The unit `ZMod.unitsTwoPowFive e` is the residue `5`. -/
@[simp]
theorem coe_unitsTwoPowFive : (unitsTwoPowFive e : ZMod (2 ^ (e + 3))) = 5 := by
  simp [unitsTwoPowFive]

/-- The unit `5` modulo `2 ^ (e + 3)` has order `2 ^ (e + 1)`; this is Mathlib's
`ZMod.orderOf_five` read in the unit group. -/
theorem orderOf_unitsTwoPowFive : orderOf (unitsTwoPowFive e) = 2 ^ (e + 1) := by
  rw [← orderOf_units, coe_unitsTwoPowFive]
  exact ZMod.orderOf_five (e + 1)

/-- Reduction modulo `4` sends the unit `5` modulo `2 ^ (e + 3)` to `1`. -/
@[simp]
theorem unitsMap_unitsTwoPowFive (h : 4 ∣ 2 ^ (e + 3)) : unitsMap h (unitsTwoPowFive e) = 1 := by
  ext
  rw [unitsMap_val, coe_unitsTwoPowFive,
    show (5 : ZMod (2 ^ (e + 3))) = ((5 : ℕ) : ZMod (2 ^ (e + 3))) by norm_num, cast_natCast h]
  decide

/-- The unit `-1` modulo `2 ^ (e + 3)` is not a power of `5`. -/
theorem neg_one_notMem_zpowers_unitsTwoPowFive :
    -1 ∉ Subgroup.zpowers (unitsTwoPowFive e) := by
  -- Reduction modulo `4` kills `5` but not `-1`.
  have h4 : 4 ∣ 2 ^ (e + 3) := ⟨2 ^ (e + 1), by ring⟩
  have hle : Subgroup.zpowers (unitsTwoPowFive e) ≤ (unitsMap h4).ker := by
    rw [Subgroup.zpowers_le, MonoidHom.mem_ker, unitsMap_unitsTwoPowFive]
  intro h
  have h' := hle h
  have hneg : unitsMap h4 (-1) = -1 := by
    simpa only [unitsMap_def] using Units.map_neg_one (castHom h4 (ZMod 4))
  rw [MonoidHom.mem_ker, hneg] at h'
  exact absurd h' (by decide)

/-- The homomorphism `(s, k) ↦ (-1) ^ s * 5 ^ k`, well defined since `(-1) ^ 2 = 1` and
`5 ^ (2 ^ (e + 1)) = 1`. -/
private noncomputable def unitsTwoPowHom :
    Multiplicative (ZMod 2 × ZMod (2 ^ (e + 1))) →* (ZMod (2 ^ (e + 3)))ˣ :=
  AddMonoidHom.toMultiplicativeLeft <|
    (ZMod.lift 2 ⟨zmultiplesHom _ (Additive.ofMul (-1)), by
      simp [← ofMul_zpow]⟩).coprod
    (ZMod.lift (2 ^ (e + 1)) ⟨zmultiplesHom _ (Additive.ofMul (unitsTwoPowFive e)), by
      simp only [zmultiplesHom_apply, ← ofMul_zpow, zpow_natCast, ← orderOf_unitsTwoPowFive,
        pow_orderOf_eq_one, ofMul_one]⟩)

private theorem unitsTwoPowHom_apply (s : ZMod 2) (k : ZMod (2 ^ (e + 1))) :
    unitsTwoPowHom e (ofAdd (s, k)) = (-1) ^ s.val * unitsTwoPowFive e ^ k.val := by
  have hs : s = ((s.val : ℤ) : ZMod 2) := by simp
  have hk : k = ((k.val : ℤ) : ZMod (2 ^ (e + 1))) := by simp
  conv_lhs => rw [hs, hk]
  simp only [unitsTwoPowHom, AddMonoidHom.toMultiplicativeLeft_apply_apply, toAdd_ofAdd,
    AddMonoidHom.coprod_apply, ZMod.lift_coe, zmultiplesHom_apply]
  simp [-ZMod.natCast_val]

private theorem unitsTwoPowHom_injective : Function.Injective (unitsTwoPowHom e) := by
  rw [injective_iff_map_eq_one]
  intro x hx
  obtain ⟨⟨s, k⟩, rfl⟩ : ∃ y, ofAdd y = x := ⟨x.toAdd, rfl⟩
  rw [unitsTwoPowHom_apply] at hx
  obtain rfl | rfl := (by decide : ∀ t : ZMod 2, t = 0 ∨ t = 1) s
  · -- For `s = 0`, the order of `5` divides `k.val`, so `k = 0`.
    simp only [ZMod.val_zero, pow_zero, one_mul] at hx
    rw [← orderOf_dvd_iff_pow_eq_one, orderOf_unitsTwoPowFive] at hx
    simpa [← ZMod.natCast_eq_zero_iff] using hx
  · -- For `s = 1`, `-1` would be a power of `5`.
    rw [ZMod.val_one'' (by decide), pow_one] at hx
    refine absurd ?_ (neg_one_notMem_zpowers_unitsTwoPowFive e)
    rw [eq_inv_of_mul_eq_one_left hx]
    exact Subgroup.inv_mem _ (Subgroup.npow_mem_zpowers _ _)

private theorem unitsTwoPowHom_bijective : Function.Bijective (unitsTwoPowHom e) := by
  refine (Fintype.bijective_iff_injective_and_card _).2 ⟨unitsTwoPowHom_injective e, ?_⟩
  rw [ZMod.card_units_eq_totient, Nat.totient_prime_pow Nat.prime_two (by omega)]
  simp [ZMod.card, pow_succ, mul_comm]

/-- **The units modulo `2 ^ (e + 3)`.** The group `(ℤ/2^(e+3))ˣ` is isomorphic to
`ℤ/2 × ℤ/2^(e+1)`, with `-1` corresponding to `(1, 0)` and `5` to `(0, 1)`. The inverse is
`(s, k) ↦ (-1) ^ s * 5 ^ k` (`unitsTwoPowEquiv_symm_apply`). -/
noncomputable def unitsTwoPowEquiv :
    (ZMod (2 ^ (e + 3)))ˣ ≃* Multiplicative (ZMod 2 × ZMod (2 ^ (e + 1))) :=
  (MulEquiv.ofBijective _ (unitsTwoPowHom_bijective e)).symm

/-- The inverse of `ZMod.unitsTwoPowEquiv` sends `(s, k)` to `(-1) ^ s * 5 ^ k`, with `s`
and `k` read through their canonical representatives. -/
@[simp]
theorem unitsTwoPowEquiv_symm_apply (s : ZMod 2) (k : ZMod (2 ^ (e + 1))) :
    (unitsTwoPowEquiv e).symm (ofAdd (s, k)) = (-1) ^ s.val * unitsTwoPowFive e ^ k.val := by
  simp [unitsTwoPowEquiv, unitsTwoPowHom_apply]

/-- `ZMod.unitsTwoPowEquiv` sends `-1` to `(1, 0)`. -/
@[simp]
theorem unitsTwoPowEquiv_neg_one : unitsTwoPowEquiv e (-1) = ofAdd (1, 0) := by
  rw [← MulEquiv.eq_symm_apply, unitsTwoPowEquiv_symm_apply, ZMod.val_one'' (by decide)]
  simp

/-- `ZMod.unitsTwoPowEquiv` sends `5` to `(0, 1)`. -/
@[simp]
theorem unitsTwoPowEquiv_five :
    unitsTwoPowEquiv e (unitsTwoPowFive e) = ofAdd (0, 1) := by
  rw [← MulEquiv.eq_symm_apply, unitsTwoPowEquiv_symm_apply,
    ZMod.val_one'' (Nat.one_lt_two_pow (by omega)).ne']
  simp

/-! ### Examples -/

/-- Modulo `8` every unit squares to `1`. -/
example : ∀ u : (ZMod 8)ˣ, u ^ 2 = 1 := by decide

/-- Modulo `16` the class of `5` has order `4`, not `8`. -/
example : orderOf (unitsTwoPowFive 1) = 4 := orderOf_unitsTwoPowFive 1

/-- Modulo `16` the class of `7` has order `2`, so it cannot replace `5` as the generator of the
cyclic factor. -/
example : orderOf (ZMod.unitOfCoprime 7 (by decide) : (ZMod 16)ˣ) = 2 :=
  orderOf_eq_prime (by decide) (by decide)

/-- The units modulo `2 ^ (e + 3)` are never cyclic. -/
example : ¬ IsCyclic (ZMod (2 ^ (e + 3)))ˣ := by
  rw [ZMod.isCyclic_units_two_pow_iff]
  omega

end ZMod
