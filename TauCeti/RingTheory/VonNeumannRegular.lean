/-!
# Von Neumann regular rings

A ring is von Neumann regular if each element `a` admits `b` with `a * b * a = a`.
This is equivalent to every finitely generated left ideal being generated by an idempotent,
and hence to every finitely generated left ideal being a direct summand of the regular module.
The same criteria apply to right ideals by passage to the opposite ring.

See Stenström, *Purity in functor categories*, §5, Theorem 4 and its one-generator specialization.
-/

public section

namespace TauCeti

/-- A ring is von Neumann regular if each element `a` has an inner inverse `b`. -/
class IsVonNeumannRegularRing (R : Type*) [Ring R] : Prop where
  exists_mul_mul_eq_self (a : R) : ∃ b : R, a * b * a = a

namespace IsVonNeumannRegularRing

variable {R : Type*}

/-- A Boolean ring is von Neumann regular. -/
instance [BooleanRing R] : IsVonNeumannRegularRing R :=
  ⟨fun a ↦ ⟨1, by simp [BooleanRing.mul_self]⟩⟩

variable [Ring R]

/-- Von Neumann regularity is invariant under passing to the opposite ring. -/
@[simp]
theorem mulOpposite_iff : IsVonNeumannRegularRing Rᵐᵒᵖ ↔ IsVonNeumannRegularRing R := by
  constructor
  · intro h
    constructor
    intro a
    obtain ⟨b, hb⟩ := h.exists_mul_mul_eq_self (MulOpposite.op a)
    refine ⟨b.unop, ?_⟩
    simpa only [MulOpposite.unop_mul, MulOpposite.unop_op, mul_assoc]
      using congrArg MulOpposite.unop hb
  · intro h
    constructor
    intro a
    obtain ⟨b, hb⟩ := h.exists_mul_mul_eq_self a.unop
    exact ⟨MulOpposite.op b, MulOpposite.unop_injective (by simpa only
      [MulOpposite.unop_mul, MulOpposite.unop_op, mul_assoc] using hb)⟩

/-- A semisimple ring is von Neumann regular. -/
instance [IsSemisimpleRing R] : IsVonNeumannRegularRing R :=
  ⟨IsSemisimpleRing.exists_mul_mul_eq_self⟩

end IsVonNeumannRegularRing

variable {R : Type*} [Ring R]

/-- A principal left ideal is generated by an idempotent exactly when its generator has an inner
inverse. -/
theorem exists_isIdempotentElem_span_singleton_eq_iff (a : R) :
    (∃ e : R, IsIdempotentElem e ∧ Ideal.span {a} = Ideal.span {e}) ↔
      ∃ b : R, a * b * a = a := by
  constructor
  · rintro ⟨e, he, hspan⟩
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp (hspan ▸ Ideal.mem_span_singleton_self e)
    refine ⟨b, ?_⟩
    rw [mul_assoc, hb]
    exact (mem_span_singleton_iff_mul_eq_self he).mp
      (hspan ▸ Ideal.mem_span_singleton_self a)
  · rintro ⟨b, hb⟩
    refine ⟨b * a, ?_, le_antisymm ?_ ?_⟩
    · rw [IsIdempotentElem, mul_assoc b, ← mul_assoc a, hb]
    · exact (Ideal.span_singleton_le_iff_mem _).mpr
        (Ideal.mem_span_singleton'.mpr ⟨a, by rwa [← mul_assoc]⟩)
    · exact (Ideal.span_singleton_le_iff_mem _).mpr (Ideal.mem_span_singleton'.mpr ⟨b, rfl⟩)

namespace IsVonNeumannRegularRing

/-- A von Neumann regular ring has zero Jacobson radical. -/
theorem jacobson_eq_bot [IsVonNeumannRegularRing R] : Ring.jacobson R = ⊥ := by
  refine eq_bot_iff.mpr fun a ha ↦ ?_
  obtain ⟨e, he, hspan⟩ :=
    (exists_isIdempotentElem_span_singleton_eq_iff a).mpr (exists_mul_mul_eq_self a)
  have hle := (Ideal.span_singleton_le_iff_mem _).mpr ha
  rw [hspan, Ideal.span_singleton_le_iff_mem] at hle
  rw [he.eq_zero_of_mem_jacobson hle, Ideal.span_singleton_zero] at hspan
  exact hspan ▸ Ideal.mem_span_singleton_self a

/-- The sum of an idempotent-generated left ideal and a principal left ideal in a regular ring
is idempotent-generated. -/
private theorem exists_span_singleton_eq_sup [IsVonNeumannRegularRing R] {e : R}
    (he : IsIdempotentElem e) (a : R) :
    ∃ p : R, IsIdempotentElem p ∧ Ideal.span {e} ⊔ Ideal.span {a} = Ideal.span {p} := by
  let x := a * (1 - e)
  obtain ⟨f, hf, hspan⟩ :=
    (exists_isIdempotentElem_span_singleton_eq_iff x).mpr (exists_mul_mul_eq_self x)
  have hx : x * e = 0 := by simp [x, mul_assoc, he.one_sub_mul_self]
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hspan ▸ Ideal.mem_span_singleton_self f)
  have hfe : f * e = 0 := by rw [← hc, mul_assoc, hx, mul_zero]
  -- Replace `f` by a generator of the same ideal orthogonal to `e`.
  let q := (1 - e) * f
  have hfq : f * q = f := by
    rw [← mul_assoc]
    simp [mul_sub, hfe, hf.eq]
  have heq : e * q = 0 := by rw [← mul_assoc, he.mul_one_sub_self, zero_mul]
  have hqe : q * e = 0 := by rw [mul_assoc, hfe, mul_zero]
  have hqq : q * q = q := by rw [mul_assoc, hfq]
  have hp : IsIdempotentElem (e + q) := by
    rw [IsIdempotentElem]
    simp [add_mul, mul_add, he.eq, heq, hqe, hqq]
  refine ⟨e + q, hp, le_antisymm (sup_le ?_ ?_) ?_⟩
  · rw [Ideal.span_singleton_le_iff_mem, mem_span_singleton_iff_mul_eq_self hp]
    simp [mul_add, he.eq, heq]
  · rw [Ideal.span_singleton_le_iff_mem, mem_span_singleton_iff_mul_eq_self hp]
    have hxf := (mem_span_singleton_iff_mul_eq_self hf).mp
      (hspan ▸ Ideal.mem_span_singleton_self x)
    have haq : a * q = x := by
      calc
        a * q = x * f := (mul_assoc _ _ _).symm
        _ = x := hxf
    rw [mul_add, haq]
    simp [x, mul_sub]
  · rw [Ideal.span_singleton_le_iff_mem]
    have he' : e ∈ Ideal.span {e} ⊔ Ideal.span {a} :=
      (le_sup_left : Ideal.span {e} ≤ Ideal.span {e} ⊔ Ideal.span {a})
        (Ideal.mem_span_singleton_self e)
    have hx' : x ∈ Ideal.span {e} ⊔ Ideal.span {a} := by
      have ha' : a ∈ Ideal.span {e} ⊔ Ideal.span {a} :=
        (le_sup_right : Ideal.span {a} ≤ Ideal.span {e} ⊔ Ideal.span {a})
          (Ideal.mem_span_singleton_self a)
      simpa only [x, mul_sub, mul_one] using sub_mem ha' (Ideal.mul_mem_left _ a he')
    exact add_mem he' (Ideal.mul_mem_left _ _ (hc ▸ Ideal.mul_mem_left _ c hx'))

/-- Every finitely generated left ideal of a von Neumann regular ring has an idempotent
generator. -/
theorem exists_isIdempotentElem_span_singleton_eq_of_fg [IsVonNeumannRegularRing R]
    (I : Ideal R) (hI : I.FG) :
    ∃ e : R, IsIdempotentElem e ∧ I = Ideal.span {e} := by
  refine Submodule.fg_sup_span_induction (motive := fun J _ ↦
    ∃ e : R, IsIdempotentElem e ∧ J = Ideal.span {e}) ?_ ?_ I hI
  · exact ⟨0, by simp [IsIdempotentElem], by simp⟩
  · intro J a _ hJ
    obtain ⟨e, he, rfl⟩ := hJ
    exact exists_span_singleton_eq_sup he a

end IsVonNeumannRegularRing

/-- A ring is von Neumann regular exactly when every finitely generated left ideal is generated
by an idempotent. -/
theorem isVonNeumannRegularRing_iff_forall_fg_exists_isIdempotentElem :
    IsVonNeumannRegularRing R ↔
      ∀ I : Ideal R, I.FG → ∃ e : R, IsIdempotentElem e ∧ I = Ideal.span {e} := by
  constructor
  · intro h
    exact h.exists_isIdempotentElem_span_singleton_eq_of_fg
  · intro h
    constructor
    intro a
    exact (exists_isIdempotentElem_span_singleton_eq_iff a).mp
      (h (Ideal.span {a}) (Submodule.fg_span_singleton a))

/-- A ring is von Neumann regular exactly when its finitely generated left ideals are direct
summands of the left regular module. -/
theorem isVonNeumannRegularRing_iff_forall_fg_exists_isCompl :
    IsVonNeumannRegularRing R ↔ ∀ I : Ideal R, I.FG → ∃ J : Ideal R, IsCompl I J := by
  rw [isVonNeumannRegularRing_iff_forall_fg_exists_isIdempotentElem]
  constructor
  · intro h I hI
    obtain ⟨e, he, rfl⟩ := h I hI
    exact ⟨_, he.isCompl_span_singleton_one_sub⟩
  · intro h I hI
    obtain ⟨J, hJ⟩ := h I hI
    -- Use the projection construction of Mathlib's `IsSemisimpleRing.ideal_eq_span_idempotent`.
    obtain ⟨f, hf, rfl⟩ := I.isIdempotentElemEquiv.symm (I.isComplEquivProj ⟨J, hJ⟩)
    exact ⟨f 1, LinearMap.isIdempotentElem_map_one_iff.mpr hf, by
      rw [LinearMap.range_eq_map, ← Ideal.span_one, ← Ideal.submodule_span_eq, LinearMap.map_span,
        Set.image_one, Ideal.submodule_span_eq]⟩

end TauCeti
