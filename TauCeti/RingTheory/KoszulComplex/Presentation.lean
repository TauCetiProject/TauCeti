module

public import TauCeti.RingTheory.KoszulComplex.Basic
public import Mathlib.Algebra.Module.FinitePresentation

/-!
# Koszul relations and the Stacks 05ED exact sequence

For a linear functional `φ : M →ₗ[R] R`, quotient `M` by the Koszul relations
`φ(u) • v - φ(v) • u`. The resulting module maps onto the ideal `φ(M)`, and its kernel
is annihilated by that ideal. Thus it gives an exact sequence `0 → K → P → φ(M) → 0`
with `φ(M) K = 0`. The quotient `P` need not be isomorphic to `φ(M)`. When `M` is finite
free and `φ` lists generators of an ideal `I`, this exact sequence is used to compare
extensions by `R/I` with Koszul cohomology.

No regularity of the functional or its generators is assumed.

## References

* [Stacks Project, Lemma 15.91.5](https://stacks.math.columbia.edu/tag/05ED).
-/

public section

noncomputable section

open CliffordAlgebra

namespace TauCeti

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- The submodule of Koszul relations, the image of `⋀² M → M`. -/
def koszulRelations (φ : Module.Dual R M) : Submodule R M :=
  LinearMap.range ((exteriorPower.oneEquiv R M).toLinearMap ∘ₗ koszulDifferential φ 1)

/-- The Koszul relation submodule is the range of the degree-one differential,
identified with a map to `M` by `exteriorPower.oneEquiv`. -/
theorem koszulRelations_def (φ : Module.Dual R M) :
    koszulRelations φ =
      LinearMap.range ((exteriorPower.oneEquiv R M).toLinearMap ∘ₗ koszulDifferential φ 1) :=
  (rfl)

/-- Each elementary Koszul relation belongs to the relation submodule. -/
theorem smul_sub_smul_mem_koszulRelations (φ : Module.Dual R M) (u v : M) :
    φ u • v - φ v • u ∈ koszulRelations φ := by
  exact ⟨exteriorPower.ιMulti R 2 ![u, v], oneEquiv_koszulDifferential_one φ ![u, v]⟩

/-- A spanning family suffices to generate all Koszul relations. In particular, with a
basis `eᵢ` and `φ(eᵢ) = fᵢ`, these are precisely the relations `fᵢ eⱼ - fⱼ eᵢ`. -/
theorem koszulRelations_eq_span_of_span_eq_top (φ : Module.Dual R M)
    {ι : Type*} (v : ι → M) (hv : Submodule.span R (Set.range v) = ⊤) :
    koszulRelations φ =
      Submodule.span R {w | ∃ i j, φ (v i) • v j - φ (v j) • v i = w} := by
  apply le_antisymm
  · rw [koszulRelations, LinearMap.range_eq_map,
      ← exteriorPower.ιMulti_span_of_span R 2 M hv, Submodule.map_span,
      Submodule.span_le]
    rintro _ ⟨_, ⟨w, hw, rfl⟩, rfl⟩
    obtain ⟨i, hi⟩ := hw (Set.mem_range_self (0 : Fin 2))
    obtain ⟨j, hj⟩ := hw (Set.mem_range_self (1 : Fin 2))
    exact Submodule.subset_span ⟨i, j, by
      simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply,
        oneEquiv_koszulDifferential_one]
      rw [hi, hj]⟩
  · rw [Submodule.span_le]
    rintro _ ⟨i, j, rfl⟩
    exact smul_sub_smul_mem_koszulRelations φ (v i) (v j)

/-- The Koszul relations are generated by `φ(u) v - φ(v) u`. -/
theorem koszulRelations_eq_span (φ : Module.Dual R M) :
    koszulRelations φ = Submodule.span R {w | ∃ u v : M, φ u • v - φ v • u = w} :=
  koszulRelations_eq_span_of_span_eq_top φ id (by simp)

/-- A linear map factors through the Koszul presentation exactly when it respects the
Koszul relations. Use this criterion with `Submodule.liftQ` to construct the factorization. -/
theorem koszulRelations_le_ker_iff (φ : Module.Dual R M) {N : Type*}
    [AddCommGroup N] [Module R N] (f : M →ₗ[R] N) :
    koszulRelations φ ≤ LinearMap.ker f ↔ ∀ u v, φ u • f v = φ v • f u := by
  rw [koszulRelations_eq_span, Submodule.span_le]
  constructor
  · intro h u v
    have := h ⟨u, v, rfl⟩
    simpa [sub_eq_zero] using this
  · rintro h _ ⟨u, v, rfl⟩
    simpa using sub_eq_zero.mpr (h u v)

/-- Every Koszul relation is a relation among the values of `φ`. -/
theorem koszulRelations_le_ker (φ : Module.Dual R M) : koszulRelations φ ≤ LinearMap.ker φ := by
  rw [koszulRelations_le_ker_iff]
  intro u v
  simp [mul_comm]

/-- The quotient of `M` by the Koszul relations. It surjects onto `φ(M)` via
`koszulPresentation.toRange`, with kernel annihilated by `φ(M)` (Stacks 05ED). -/
abbrev koszulPresentation (φ : Module.Dual R M) := M ⧸ koszulRelations φ

namespace koszulPresentation

variable (φ : Module.Dual R M)

/-- The Koszul presentation of a finitely presented module is finitely presented:
its relation module is an image of the finite module `⋀² M`. -/
instance [Module.FinitePresentation R M] :
    Module.FinitePresentation R (koszulPresentation φ) := by
  apply Module.finitePresentation_of_surjective (koszulRelations φ).mkQ
    (koszulRelations φ).mkQ_surjective
  rw [Submodule.ker_mkQ]
  simpa only [koszulRelations, Submodule.map_top] using
    (Module.Finite.fg_top (R := R) (M := ⋀[R]^2 M)).map
      ((exteriorPower.oneEquiv R M).toLinearMap ∘ₗ koszulDifferential φ 1)

/-- The canonical surjection from the Koszul presentation onto the image ideal. -/
def toRange : koszulPresentation φ →ₗ[R] LinearMap.range φ :=
  (koszulRelations φ).liftQ φ.rangeRestrict (by
    simpa only [LinearMap.ker_rangeRestrict] using koszulRelations_le_ker φ)

/-- The class of a vector maps to its value under the functional. -/
@[simp]
theorem toRange_mk (m : M) :
    toRange φ (Submodule.Quotient.mk m) = φ.rangeRestrict m :=
  (rfl)

/-- The canonical map from the Koszul presentation onto the image ideal is surjective:
every `φ m` is the image of the class of `m`. -/
theorem toRange_surjective : Function.Surjective (toRange φ) := by
  rintro ⟨r, m, rfl⟩
  exact ⟨(koszulRelations φ).mkQ m, rfl⟩

/-- In the presentation, `φ(u)` times the class of `v` equals `φ(v)` times the class of `u`. -/
theorem smul_mkQ_eq (u v : M) :
    φ u • (Submodule.Quotient.mk v : koszulPresentation φ) =
      φ v • Submodule.Quotient.mk u := by
  exact (koszulRelations_le_ker_iff φ (koszulRelations φ).mkQ).mp
    (by rw [Submodule.ker_mkQ]) u v

/-- The image ideal annihilates the kernel of the Koszul presentation. Together with
`toRange_surjective`, this gives the exact sequence of Stacks, Lemma 15.91.5 (05ED). -/
@[stacks 05ED "the canonical surjection has kernel annihilated by the image ideal"]
theorem smul_eq_zero_of_mem_ker {r : R} (hr : r ∈ LinearMap.range φ)
    {z : koszulPresentation φ} (hz : z ∈ LinearMap.ker (toRange φ)) : r • z = 0 := by
  obtain ⟨u, rfl⟩ := hr
  obtain ⟨v, rfl⟩ := (koszulRelations φ).mkQ_surjective z
  have hv : φ v = 0 := by
    simpa [toRange_mk, Subtype.ext_iff] using LinearMap.mem_ker.mp hz
  simpa only [Submodule.mkQ_apply] using (smul_mkQ_eq φ u v).trans (by rw [hv, zero_smul])

end koszulPresentation

end TauCeti
