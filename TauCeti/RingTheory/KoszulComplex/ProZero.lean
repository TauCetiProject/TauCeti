module

public import TauCeti.RingTheory.KoszulComplex.PowerTower
public import TauCeti.Algebra.Homology.ArtinRees
public import TauCeti.CategoryTheory.Functor.ProZero

/-!
# Pro-vanishing of higher Koszul homology

Over a Noetherian commutative ring, the inverse system of positive-degree homology modules
of `K(x₁ⁿ, …, xᵣⁿ)` is pro-zero for every finite family `x`. No regularity is required.
The transitions are those of `powerTower`, with degree-one map `eᵢ ↦ xᵢ eᵢ` at successive
exponents. This is the homology input for comparing derived Koszul quotients with ordinary
quotients in derived completion.

We combine the ideal-adic image estimate for `powerMap` with
`HomologicalComplex.exists_homologyMap_eq_zero_of_range_le_pow_smul`. The ideal generated by
`xᵢⁿ` annihilates homology by the existing Koszul homotopies; a sufficiently late transition
has all its positive-degree diagonal entries in a sufficiently high power of this ideal.

## References

* The Stacks Project, Tag 0921, proof of Lemma 15.96.1.
-/

public section

noncomputable section

open CategoryTheory Opposite

namespace TauCeti.koszulComplex

universe u v

variable {R : Type u} [CommRing R] [IsNoetherianRing R]
  {ι : Type v} [Fintype ι] (x : ι → R)

/-- Higher homology of the Koszul power tower is pro-zero over a Noetherian ring. In
cohomological indexing these are precisely the negative-degree cohomology towers. The family
need not be regular. -/
theorem isProZero_homology_powerTower (k : ℕ) (hk : 0 < k) :
    (powerTower x ⋙ HomologicalComplex.homologyFunctor (ModuleCat.{max u v} R)
      (ComplexShape.down ℕ) k).IsProZero := by
  rw [Functor.isProZero_iff_forall_exists_le]
  intro n
  classical
  let φ := Fintype.linearCombination R (fun i ↦ x i ^ n)
  let J : Ideal R := Ideal.span (Set.range fun i ↦ x i ^ n)
  have hφ : (LinearMap.range φ : Ideal R) = J :=
    Fintype.range_linearCombination R (fun i ↦ x i ^ n)
  have : Module.Finite R ((koszulComplex φ).X k) := by
    rw [koszulComplex_X]
    infer_instance
  have hJ : ∀ r ∈ J, ∀ z : (koszulComplex φ).homology k, r • z = 0 := by
    intro r hr z
    rw [← hφ] at hr
    obtain ⟨v, rfl⟩ := hr
    exact smul_homology_eq_zero φ v k z
  obtain ⟨t, ht⟩ :=
    HomologicalComplex.exists_homologyMap_eq_zero_of_range_le_pow_smul
      (koszulComplex φ) k J hJ
  refine ⟨n + n * t, Nat.le_add_right n (n * t), ht _ _ ?_⟩
  rintro _ ⟨z, rfl⟩
  apply powerMap_mem_smul x _ hk (J ^ t) _ z
  intro i
  have hi : x i ^ n ∈ J := Ideal.subset_span ⟨i, rfl⟩
  simpa only [Nat.add_sub_cancel_left, pow_mul] using Ideal.pow_mem_pow hi t

end TauCeti.koszulComplex
