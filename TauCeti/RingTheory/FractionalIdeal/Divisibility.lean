module

public import Mathlib.RingTheory.FractionalIdeal.Operations

/-!
# Divisibility by an invertible ideal

An ideal of a commutative ring which is invertible as a fractional ideal (over the total ring of
fractions) divides every invertible ideal it contains, the cofactor being the integral ideal
representing `A * I⁻¹`. In particular it divides every principal ideal it contains that is
generated by a non-zero-divisor.

Over a Dedekind domain this is subsumed by `Ideal.dvd_iff_le` ("to contain is to divide"), which
holds for *every* nonzero ideal. The statement here assumes neither a Dedekind hypothesis nor
even that the ring is a domain, only that the divisor is invertible, so it also applies to rings
that are not integrally closed — coordinate rings of possibly singular affine curves, for
instance.

## Main results

* `Ideal.exists_isUnit_eq_mul_of_le`: an invertible ideal divides every invertible ideal it
  contains.
* `Ideal.exists_isUnit_span_singleton_eq_mul`: the case of a principal ideal generated by a
  non-zero-divisor, which is invertible; the cofactor is then invertible and nonzero.
-/

-- Design provenance (not API documentation): the argument was extracted from
-- `TauCeti/AlgebraicGeometry/EllipticCurve/Affine/Point/ToClass.lean`, itself ported from the
-- AINTLIB `HasseWeil` project (`github.com/CBirkbeck/AINTLIB`, Apache-2.0) at
-- `dev/hasse-weil @ 513e83879e2f`, file `HasseWeil/Pic0/ToClassSurjective.lean`
-- (by Chris Birkbeck), where it sat inline inside the codimension-reduction step.

open scoped nonZeroDivisors

namespace Ideal

public section

variable {R : Type*} [CommRing R] {K : Type*} [CommRing K] [Algebra R K] [IsFractionRing R K]

/-- **An invertible ideal divides every invertible ideal it contains.** If `A ≤ I` are ideals
whose images in the fractional ideals are units, then `A = I * J` for an invertible `J`, namely
the integral ideal representing `A * I⁻¹`. -/
theorem exists_isUnit_eq_mul_of_le {A I : Ideal R} (hAunit : IsUnit (A : FractionalIdeal R⁰ K))
    (hIunit : IsUnit (I : FractionalIdeal R⁰ K)) (hle : A ≤ I) :
    ∃ J : Ideal R, IsUnit (J : FractionalIdeal R⁰ K) ∧ A = I * J := by
  -- `A * I⁻¹ ≤ I * I⁻¹ = 1`, so it is (the image of) an integral ideal `J`.
  obtain ⟨J, hJ⟩ := FractionalIdeal.le_one_iff_exists_coeIdeal.mp <|
    calc (A : FractionalIdeal R⁰ K) * ↑hIunit.unit⁻¹ ≤ I * ↑hIunit.unit⁻¹ := by gcongr
      _ = 1 := hIunit.mul_val_inv
  have hA : A = I * J := FractionalIdeal.coeIdeal_injective' (P := K) le_rfl <| by
    simp only [FractionalIdeal.coeIdeal_mul, hJ]
    rw [mul_left_comm, hIunit.mul_val_inv, mul_one]
  have hIJ : IsUnit ((I : FractionalIdeal R⁰ K) * J) := by
    rwa [← FractionalIdeal.coeIdeal_mul, ← hA]
  exact ⟨J, (IsUnit.mul_iff.mp hIJ).2, hA⟩

/-- **An invertible ideal divides every principal ideal it contains that is generated by a
non-zero-divisor**, such an ideal being invertible. The cofactor `J` is again invertible, and it is
nonzero since `R` is nontrivial. -/
theorem exists_isUnit_span_singleton_eq_mul [Nontrivial R] (I : Ideal R)
    (hIunit : IsUnit (I : FractionalIdeal R⁰ K)) {a : R} (ha : a ∈ R⁰) (ha_mem : a ∈ I) :
    ∃ J : Ideal R, IsUnit (J : FractionalIdeal R⁰ K) ∧ J ≠ ⊥ ∧ Ideal.span {a} = I * J := by
  have hspanUnit : IsUnit (Ideal.span {a} : FractionalIdeal R⁰ K) := by
    rw [FractionalIdeal.coeIdeal_span_singleton]
    exact (IsLocalization.map_units K ⟨a, ha⟩).map _
  obtain ⟨J, hJunit, hJ⟩ := exists_isUnit_eq_mul_of_le hspanUnit hIunit
    ((Ideal.span_singleton_le_iff_mem I).mpr ha_mem)
  refine ⟨J, hJunit, ?_, hJ⟩
  rintro rfl
  rw [mul_bot, span_singleton_eq_bot] at hJ
  exact nonZeroDivisors.ne_zero ha hJ

end

end Ideal
