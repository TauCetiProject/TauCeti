/-!
# Finiteness of the normalization of a polynomial ring

Let `R` be a Noetherian Japanese domain, for instance a field, let `P = R[X_1, …, X_r]` be a
polynomial ring in finitely many variables, `K` its fraction field and `L / K` a finite field
extension. This file proves that the integral closure of `P` in `L` is a **finite `P`-module**,
with no separability hypothesis on `L / K`: the polynomial ring `P` is again Japanese (Stacks,
Lemma 10.161.13 (032O)). For one variable over a field this is the finiteness of the
normalization of `k[x]` in an algebraic function field: the integral closure of `k[x]` in a finite
extension of `k(x)` is a finitely generated `k[x]`-module, including when `k` is imperfect and the
extension is inseparable.

Mathlib's `IsIntegralClosure.finite` needs `L / K` separable, since it works through the trace
form. The purely inseparable case is supplied by
`TauCeti.IsIntegralClosure.finite_mvPolynomial_of_isPurelyInseparable`, and for a Noetherian
domain such as `P` the purely inseparable extensions are the only ones that need testing
(`TauCeti.Ring.IsJapanese.of_isPurelyInseparable`, Stacks, Lemma 10.161.12 (032N)). So `P` is
Japanese.

## Main results

* `TauCeti.Ring.IsJapanese.mvPolynomial`: a polynomial ring in finitely many variables over a
  Noetherian Japanese domain is Japanese.
* `TauCeti.Ring.IsJapanese.polynomial`: the one-variable form, for `R[X]`.
* `TauCeti.IsIntegralClosure.finite_mvPolynomial`: the integral closure of a polynomial ring in
  finitely many variables over a Noetherian Japanese domain, in a finite extension of its fraction
  field, is a finite module.
* `TauCeti.IsIntegralClosure.finite_polynomial`: the one-variable form over `R[X]`.
* `TauCeti.IsIntegralClosure.finite_adjoin_of_transcendental`: the same form over the subring
  `k[x]` generated by a transcendental element `x` of a field, with `k(x)` as fraction field.

## References

* Stacks Project, Lemma 10.161.12 (tag 032N) and Lemma 10.161.13 (tag 032O), whose argument
  (reduce to purely inseparable extensions) is the one followed here.
-/

public section

open Polynomial

namespace TauCeti

section Japanese

variable {R : Type*} [CommRing R] [IsDomain R] [IsNoetherianRing R] [Ring.IsJapanese R]

/-- A polynomial ring `R[X_1, …, X_r]` in finitely many variables over a Noetherian Japanese
domain `R`, for instance a field, is Japanese: its integral closure in every finite extension of
its fraction field, inseparable ones included, is a finite module. Stacks, Lemma 10.161.13 (032O),
for any finite number of variables. -/
@[stacks 032O "N-2 part, for finitely many variables"]
instance Ring.IsJapanese.mvPolynomial {σ : Type*} [Finite σ] :
    Ring.IsJapanese (MvPolynomial σ R) :=
  .of_isPurelyInseparable (FractionRing (MvPolynomial σ R)) fun M _ _ _ _ _ _ ↦
    IsIntegralClosure.finite_mvPolynomial_of_isPurelyInseparable R
      (FractionRing (MvPolynomial σ R)) M _

/-- The polynomial ring `R[X]` over a Noetherian Japanese domain `R` is Japanese. Stacks,
Lemma 10.161.13 (032O). -/
@[stacks 032O "N-2 part"]
instance Ring.IsJapanese.polynomial : Ring.IsJapanese R[X] :=
  (MvPolynomial.uniqueAlgEquiv R Unit).toRingEquiv.isJapanese

namespace IsIntegralClosure

variable (R) {σ : Type*} [Finite σ] (K : Type*) [Field K] [Algebra (MvPolynomial σ R) K]
  [IsFractionRing (MvPolynomial σ R) K]

/-- **Finiteness of normalization** for a polynomial ring over a Noetherian Japanese domain. Let
`P = R[X_1, …, X_r]` be a polynomial ring in finitely many variables over a Noetherian Japanese
domain `R`, for instance a field, with fraction field `K`, and let `L / K` be a finite extension.
Then any integral closure `C` of `P` in `L` is a finite `P`-module. No separability of `L / K` is
assumed. -/
theorem finite_mvPolynomial (L : Type*) [Field L] [Algebra K L]
    [Algebra (MvPolynomial σ R) L] [IsScalarTower (MvPolynomial σ R) K L] [FiniteDimensional K L]
    (C : Type*) [CommRing C] [Algebra (MvPolynomial σ R) C] [Algebra C L]
    [IsScalarTower (MvPolynomial σ R) C L] [IsIntegralClosure C (MvPolynomial σ R) L] :
    Module.Finite (MvPolynomial σ R) C :=
  have := Ring.IsJapanese.finite_integralClosure (R := MvPolynomial σ R) K L
  .equiv (IsIntegralClosure.equiv (MvPolynomial σ R) (integralClosure (MvPolynomial σ R) L) L
    C).toLinearEquiv

/-- **Finiteness of normalization** for `R[X]`: the integral closure of the polynomial ring `R[X]`
over a Noetherian Japanese domain `R`, for instance a field, in a finite extension `L` of its
fraction field `K` is a finite `R[X]`-module. No separability of `L / K` is assumed. For `R = k` a
field, `K = k(X)` and `L` an algebraic function field this is the finiteness of the normalization
of `k[x]` in `L`. -/
theorem finite_polynomial (K : Type*) [Field K] [Algebra R[X] K] [IsFractionRing R[X] K]
    (L : Type*) [Field L] [Algebra K L] [Algebra R[X] L] [IsScalarTower R[X] K L]
    [FiniteDimensional K L] (C : Type*) [CommRing C] [Algebra R[X] C] [Algebra C L]
    [IsScalarTower R[X] C L] [IsIntegralClosure C R[X] L] :
    Module.Finite R[X] C :=
  have := Ring.IsJapanese.finite_integralClosure (R := R[X]) K L
  .equiv (IsIntegralClosure.equiv R[X] (integralClosure R[X] L) L C).toLinearEquiv

end IsIntegralClosure

end Japanese

namespace IsIntegralClosure

variable (k : Type*) [Field k]

section Adjoin

open _root_.IntermediateField _root_.IntermediateField.algebraAdjoinAdjoin

/-- **Finiteness of normalization** for the subring `k[x]` generated by an element `x` of a field
`E` transcendental over `k`: the integral closure of `k[x]` in a finite extension `L` of
`k(x) = k⟮x⟯` is a finite `k[x]`-module. No separability of `L / k(x)` is assumed. When `E` is
an algebraic function field over `k`, this is the finiteness of the normalization of `k[x]` in
any finite extension of `E`, with `x` taken inside `E` rather than as an abstract variable. -/
theorem finite_adjoin_of_transcendental {E : Type*} [Field E] [Algebra k E] {x : E}
    (hx : Transcendental k x) (L : Type*) [Field L] [Algebra k⟮x⟯ L]
    [Algebra (Algebra.adjoin k {x}) L] [IsScalarTower (Algebra.adjoin k {x}) k⟮x⟯ L]
    [FiniteDimensional k⟮x⟯ L] (C : Type*) [CommRing C] [Algebra (Algebra.adjoin k {x}) C]
    [Algebra C L] [IsScalarTower (Algebra.adjoin k {x}) C L]
    [IsIntegralClosure C (Algebra.adjoin k {x}) L] :
    Module.Finite (Algebra.adjoin k {x}) C := by
  -- transport every structure along `k[X] ≃ k[x]`, which holds as `x` is transcendental
  let e := (Polynomial.algEquivOfTranscendental k x hx).toRingEquiv
  let _ : Algebra k[X] (Algebra.adjoin k {x}) := e.toRingHom.toAlgebra
  let _ : Algebra k[X] k⟮x⟯ :=
    ((algebraMap (Algebra.adjoin k {x}) k⟮x⟯).comp e.toRingHom).toAlgebra
  let _ : Algebra k[X] L := ((algebraMap (Algebra.adjoin k {x}) L).comp e.toRingHom).toAlgebra
  let _ : Algebra k[X] C := ((algebraMap (Algebra.adjoin k {x}) C).comp e.toRingHom).toAlgebra
  have : IsScalarTower k[X] (Algebra.adjoin k {x}) C := IsScalarTower.of_algebraMap_eq' rfl
  have : IsScalarTower k[X] (Algebra.adjoin k {x}) L := IsScalarTower.of_algebraMap_eq' rfl
  have : IsScalarTower k[X] k⟮x⟯ L := IsScalarTower.of_algebraMap_eq fun a ↦ by
    simp only [RingHom.algebraMap_toAlgebra, RingHom.comp_apply]
    exact IsScalarTower.algebraMap_apply (Algebra.adjoin k {x}) k⟮x⟯ L _
  have : IsScalarTower k[X] C L := IsScalarTower.of_algebraMap_eq fun a ↦ by
    simp only [RingHom.algebraMap_toAlgebra, RingHom.comp_apply]
    exact IsScalarTower.algebraMap_apply (Algebra.adjoin k {x}) C L _
  have : IsFractionRing k[X] k⟮x⟯ :=
    (IsFractionRing.isFractionRing_iff_of_base_ringEquiv (R := Algebra.adjoin k {x})
      (S := k⟮x⟯) (h := e.symm)).mp inferInstance
  have : Algebra.IsIntegral k[X] (Algebra.adjoin k {x}) := ⟨fun b ↦ by
    have hb : algebraMap k[X] (Algebra.adjoin k {x}) (e.symm b) = b := e.apply_symm_apply b
    exact hb ▸ isIntegral_algebraMap⟩
  have : IsIntegralClosure C k[X] L := IsIntegralClosure.tower_bot (A := Algebra.adjoin k {x})
  have : Module.Finite k[X] C := finite_polynomial k k⟮x⟯ L C
  exact Module.Finite.of_restrictScalars_finite k[X] (Algebra.adjoin k {x}) C

/-- For `x` transcendental over `k`, the integral closure in `L` of the integral closure `R` of
`k[x]` in `E` is a finite `R`-module: it is also the integral closure of `k[x]` in `L`, which
is finite over `k[x]` with no separability hypothesis. -/
theorem finite_integralClosure_integralClosure_adjoin {E : Type*} [Field E] [Algebra k E]
    {x : E} (hx : Transcendental k x) (L : Type*) [Field L] [Algebra E L]
    [FiniteDimensional k⟮x⟯ L] :
    Module.Finite (integralClosure (Algebra.adjoin k {x}) E)
      (integralClosure (integralClosure (Algebra.adjoin k {x}) E) L) := by
  let R := integralClosure (Algebra.adjoin k {x}) E
  let S := integralClosure R L
  have : IsIntegralClosure S (Algebra.adjoin k {x}) L := IsIntegralClosure.tower_bot (A := R)
  have : Module.Finite (Algebra.adjoin k {x}) S := finite_adjoin_of_transcendental k hx L S
  exact Module.Finite.of_restrictScalars_finite (Algebra.adjoin k {x}) R S

end Adjoin

end IsIntegralClosure

end TauCeti
