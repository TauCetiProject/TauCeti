module

public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.IntegralClosure.Algebra.Basic

import TauCeti.RingTheory.IntegralClosure.IsIntegral.Basic

/-!
# Integrality over an adjoined subalgebra from a supremum of integral closures

In a tower of commutative rings S → T → K with T → K injective, if the image of x : T in K
lies in the subring generated by the integral closures of the single-element extensions S[u] for
u ∈ X, then x is integral over the S-subalgebra S[X] of T.

## Main results

* TauCeti.isIntegral_adjoin_of_mem_iSup_integralClosure: general form for an arbitrary subset
  X : Set T and the supremum of integral closures of S[u] in K over u ∈ X.
* TauCeti.isIntegral_adjoin_pair_of_mem_sup_integralClosure: binary specialization for two
  elements s, t : T and the join of the integral closures of S[s] and S[t].

## Provenance

Adapted from grh-lean (https://github.com/lsernau/grh-lean at commit
72fead102f663d5c7a407964a13dc0cf9d977207, Apache 2.0, Copyright 2026 Anthropic, PBC), file
src/Lib/Cohomology/ProperBaseChange/SubringSplitting.lean
(New.Variety.isIntegral_adjoin_pair_of_le_sup), generalized from subrings of a field and a pair
of elements to arbitrary towers of commutative rings with injective top map and arbitrary sets of
generators.
-/

@[expose] public section

namespace TauCeti

/-- In a tower of commutative rings S → T → K with lgebraMap T K injective, let X : Set T.
If lgebraMap T K x lies in the subring of K generated by the integral closures of
Algebra.adjoin S {algebraMap T K u} for u ∈ X, then x is integral over Algebra.adjoin S X. -/
theorem isIntegral_adjoin_of_mem_iSup_integralClosure {S T K : Type*} [CommRing S] [CommRing T]
    [CommRing K] [Algebra S T] [Algebra T K] [Algebra S K] [IsScalarTower S T K]
    (hTK : Function.Injective (algebraMap T K)) (X : Set T) {x : T}
    (hx : algebraMap T K x ∈
      ⨆ u ∈ X, (integralClosure (Algebra.adjoin S {algebraMap T K u}) K).toSubring) :
    IsIntegral (Algebra.adjoin S X) x := by
  let L : Subalgebra S T := Algebra.adjoin S X
  let N : Subalgebra L K := integralClosure L K
  have hle : (⨆ u ∈ X, (integralClosure (Algebra.adjoin S {algebraMap T K u}) K).toSubring) ≤
      N.toSubring := by
    refine iSup₂_le fun u hu z hz ↦ ?_
    have hAu : ∀ a : Algebra.adjoin S {algebraMap T K u}, IsIntegral L (a : K) := by
      intro a
      have ha_mem : (a : K) ∈ (N.restrictScalars S) := by
        have hsub : Algebra.adjoin S {algebraMap T K u} ≤ N.restrictScalars S := by
          refine Algebra.adjoin_le ?_
          rw [Set.singleton_subset_iff]
          exact N.algebraMap_mem ⟨u, Algebra.subset_adjoin hu⟩
        exact hsub a.property
      exact ha_mem
    exact isIntegral_trans_common hAu hz
  have hxK : IsIntegral L (algebraMap T K x) := hle hx
  exact hxK.tower_bot hTK

/-- Binary specialization of TauCeti.isIntegral_adjoin_of_mem_iSup_integralClosure: if
lgebraMap T K x lies in the join of the integral closures of S[s] and S[t] in K, then x
is integral over Algebra.adjoin S {s, t}. -/
theorem isIntegral_adjoin_pair_of_mem_sup_integralClosure {S T K : Type*} [CommRing S]
    [CommRing T] [CommRing K] [Algebra S T] [Algebra T K] [Algebra S K] [IsScalarTower S T K]
    (hTK : Function.Injective (algebraMap T K)) (s t : T) {x : T}
    (hx : algebraMap T K x ∈
      (integralClosure (Algebra.adjoin S {algebraMap T K s}) K).toSubring ⊔
      (integralClosure (Algebra.adjoin S {algebraMap T K t}) K).toSubring) :
    IsIntegral (Algebra.adjoin S {s, t}) x := by
  refine isIntegral_adjoin_of_mem_iSup_integralClosure hTK {s, t} ?_
  have hle : (integralClosure (Algebra.adjoin S {algebraMap T K s}) K).toSubring ⊔
      (integralClosure (Algebra.adjoin S {algebraMap T K t}) K).toSubring ≤
      ⨆ u ∈ ({s, t} : Set T),
        (integralClosure (Algebra.adjoin S {algebraMap T K u}) K).toSubring :=
    sup_le (le_biSup (f := fun u : T ↦
        (integralClosure (Algebra.adjoin S {algebraMap T K u}) K).toSubring)
        (Set.mem_insert s {t}))
      (le_biSup (f := fun u : T ↦
        (integralClosure (Algebra.adjoin S {algebraMap T K u}) K).toSubring)
        (Set.mem_insert_of_mem s rfl))
  exact hle hx

end TauCeti
