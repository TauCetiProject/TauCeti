module

public import Mathlib.Algebra.Category.ModuleCat.Projective
public import Mathlib.CategoryTheory.Generator.Basic
public import Mathlib.CategoryTheory.Preadditive.Projective.Basic
public import TauCeti.RingTheory.Idempotented.NondegMod
public import TauCeti.RingTheory.Idempotents.Hom
public import TauCeti.RingTheory.Idempotents.Module
public import TauCeti.RingTheory.Idempotents.Primitive.Basic
public import TauCeti.RingTheory.Idempotents.Projective

/-!
# The principal objects `He` are finitely generated projective generators

Let `H` be an idempotented algebra over a commutative ring `A`. For `e ∈ H` the principal left
ideal `He`, the ideal of the unitization `A ⊕ H` generated by `e`, is a nondegenerate module
(`TauCeti.isNondegenerate_span_singleton`), hence an object `TauCeti.principalNondegMod A e` of
`NondegMod A H`. It is generated by `e`, so finitely generated.

For an idempotent `e`, evaluation at the generator is an additive equivalence between the
morphisms `He → M` and `eM`, the vectors of `M` fixed by `e`
(`TauCeti.principalNondegModHomEquiv`). As `He` is a projective module and the inclusion into
modules is fully faithful and preserves epimorphisms, `He` is a projective object of
`NondegMod A H`; every vector of a nondegenerate module is fixed by some idempotent, so the `He`
for `e` idempotent form a separating family. These are Bernstein's projective generators of the
category of nondegenerate modules.

## Main declarations

* `TauCeti.principalNondegMod A e`: the principal object `He` of `NondegMod A H`.
* `TauCeti.principalNondegModHomEquiv`: for idempotent `e`, `Hom(He, M) ≃+ eM`.
* `TauCeti.projective_principalNondegMod`: `He` is projective for idempotent `e`.
* `TauCeti.isSeparating_principalNondegMod`: the `He`, `e` idempotent, form a separating family.

## References

* J. N. Bernstein, *Le "centre" de Bernstein*, edited by P. Deligne, in *Représentations des groupes
  réductifs sur un corps local*, Hermann, Paris (1984), §1.1–§1.2.
-/

public section

universe u₁ u₂

open CategoryTheory Limits Pointwise

namespace TauCeti

variable {A : Type u₁} {H : Type u₂} [CommRing A] [NonUnitalRing H] [Module A H]
  [IsScalarTower A H H] [SMulCommClass A H H] [IsIdempotented H]

variable (A) in
/-- The principal object `He` of `NondegMod A H`: the left ideal of the unitization `A ⊕ H`
generated by `e`, a nondegenerate module by `TauCeti.isNondegenerate_span_singleton`. -/
@[expose] noncomputable def principalNondegMod (e : H) : NondegMod.{max u₁ u₂} A H :=
  ⟨ModuleCat.of _ (Ideal.span {(e : Unitization A H)}),
    (nondegenerateModuleProperty_iff _).2 (isNondegenerate_span_singleton e)⟩

theorem principalNondegMod_obj (e : H) :
    (principalNondegMod A e).obj = ModuleCat.of _ (Ideal.span {(e : Unitization A H)}) :=
  (rfl)

/-- The principal object `He` is finitely generated, by `e`. -/
instance (e : H) : Module.Finite (Unitization A H) (principalNondegMod A e).obj :=
  inferInstanceAs
    (Module.Finite _ (Submodule.span (Unitization A H) {(e : Unitization A H)}))

/-- **Morphisms out of `He` are the vectors of `eM`**: evaluation at the generator `e`, an
additive equivalence onto `e • ⊤`, the vectors fixed by `e`
(`IsIdempotentElem.mem_smul_top_iff_smul_eq_self`). The inverse sends `m` to `x ↦ x • m`. This is
`IsIdempotentElem.spanSingletonHomEquivSMulTop` read through the inclusion into modules. -/
noncomputable def principalNondegModHomEquiv {e : H} (he : IsIdempotentElem e)
    (M : NondegMod.{max u₁ u₂} A H) :
    (principalNondegMod A e ⟶ M) ≃+ ↥((e : Unitization A H) • (⊤ : Submodule ℤ M.obj)) :=
  AddEquiv.mk' ((nondegenerateModuleProperty A H).fullyFaithfulι.homEquiv.trans <|
    (ModuleCat.homEquiv (M := ModuleCat.of _ (Ideal.span {(e : Unitization A H)}))).trans
      ((Unitization.IsIdempotentElem.inr A he).spanSingletonHomEquivSMulTop (k := ℤ)).toEquiv)
    fun φ ψ ↦ map_add ((Unitization.IsIdempotentElem.inr A he).spanSingletonHomEquivSMulTop
      (k := ℤ)) φ.hom.hom ψ.hom.hom

@[simp]
theorem coe_principalNondegModHomEquiv_apply {e : H} (he : IsIdempotentElem e)
    {M : NondegMod.{max u₁ u₂} A H} (φ : principalNondegMod A e ⟶ M) :
    (principalNondegModHomEquiv he M φ : M.obj) =
      φ.hom.hom (spanSingletonGenerator (e : Unitization A H)) :=
  (Unitization.IsIdempotentElem.inr A he).coe_spanSingletonHomEquivSMulTop_apply (k := ℤ) φ.hom.hom

@[simp]
theorem principalNondegModHomEquiv_symm_apply {e : H} (he : IsIdempotentElem e)
    {M : NondegMod.{max u₁ u₂} A H} (m : ↥((e : Unitization A H) • (⊤ : Submodule ℤ M.obj)))
    (x : Ideal.span {(e : Unitization A H)}) :
    ((principalNondegModHomEquiv he M).symm m).hom.hom x = (x : Unitization A H) • (m : M.obj) :=
  (Unitization.IsIdempotentElem.inr A he).spanSingletonHomEquivSMulTop_symm_apply (k := ℤ) _ x

/-- Two morphisms out of `He` agree as soon as they agree at the generator `e`. -/
theorem principalNondegMod_hom_ext {e : H} {M : NondegMod.{max u₁ u₂} A H}
    {φ ψ : principalNondegMod A e ⟶ M}
    (h : φ.hom.hom (spanSingletonGenerator (e : Unitization A H)) =
      ψ.hom.hom (spanSingletonGenerator (e : Unitization A H))) : φ = ψ := by
  refine ObjectProperty.hom_ext _ (ModuleCat.hom_ext (LinearMap.ext
    fun (x : Ideal.span {(e : Unitization A H)}) ↦ ?_))
  obtain ⟨r, rfl⟩ := exists_smul_spanSingletonGenerator x
  exact (φ.hom.hom.map_smul r _).trans ((congrArg (r • ·) h).trans (ψ.hom.hom.map_smul r _).symm)

/-- **The principal objects `He` are projective** for `e` idempotent: `He` is a projective module,
and the inclusion of `NondegMod A H` into modules is fully faithful and preserves epimorphisms. -/
theorem projective_principalNondegMod {e : H} (he : IsIdempotentElem e) :
    Projective (principalNondegMod A e) :=
  (nondegenerateModuleProperty A H).ι.projective_of_map_projective
    ((IsProjective.iff_projective _).1
      (Unitization.IsIdempotentElem.inr A he).projective_span_singleton)

/-- **The principal objects `He`, `e` idempotent, form a separating family** of `NondegMod A H`:
every vector `m` of a nondegenerate module is fixed by some idempotent `e`, and is the image of
the generator under the morphism `He → M` it defines. -/
theorem isSeparating_principalNondegMod :
    (ObjectProperty.ofObj fun e : {e : H // IsIdempotentElem e} ↦
      principalNondegMod A e.val).IsSeparating := by
  intro M N f g hfg
  refine ObjectProperty.hom_ext _ (ModuleCat.hom_ext (LinearMap.ext fun m ↦ ?_))
  have hM : IsNondegenerate A H M.obj := (nondegenerateModuleProperty_iff _).1 M.property
  obtain ⟨e, he, hem⟩ := isNondegenerate_iff.mp hM m
  let φ := (principalNondegModHomEquiv he M).symm
    ⟨m, (Unitization.IsIdempotentElem.inr A he).mem_smul_top_iff_smul_eq_self.2 hem⟩
  obtain ⟨x, hx⟩ : ∃ x : (principalNondegMod A e).obj, φ.hom.hom x = m :=
    ⟨spanSingletonGenerator (e : Unitization A H), by
      rw [principalNondegModHomEquiv_symm_apply, coe_spanSingletonGenerator]
      exact hem⟩
  have hG : ObjectProperty.ofObj (fun e : {e : H // IsIdempotentElem e} ↦
      principalNondegMod A e.val) (principalNondegMod A e) :=
    ObjectProperty.ofObj_apply _ (⟨e, he⟩ : {e : H // IsIdempotentElem e})
  simpa [hx] using congr(($(hfg (principalNondegMod A e) hG φ)).hom.hom x)

end TauCeti
