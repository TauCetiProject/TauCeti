public import Mathlib.RingTheory.Smooth.Basic
public import TauCeti.RingTheory.FiniteType.EqualizerIdeal

/-!
# Coinvariant ideals and smoothness of fixed-point subschemes

Let a type `Θ` act on a commutative ring `A`. The **coinvariant ideal** `coinvariantIdeal Θ A`
is the ideal of `A` generated by all displacements `θ • a - a` (`θ : Θ`, `a : A`). Contravariantly,
when `A` is an `R`-algebra and `Θ` acts by `R`-algebra endomorphisms, the quotient algebra
`A ⧸ coinvariantIdeal Θ A` represents the fixed-point subscheme `(Spec A)^Θ`: `R`-algebra
homomorphisms `A ⧸ coinvariantIdeal Θ A →ₐ[R] B` correspond bijectively to `Θ`-invariant
`R`-algebra homomorphisms `A →ₐ[R] B` (`coinvariantAlgHomEquiv`).

When `Θ` is a finite monoid acting on `A` by `R`-algebra endomorphisms and `A` is of finite type
over `R`, `coinvariantIdeal Θ A` is finitely generated (`coinvariantIdeal_fg`), so quotienting a
finitely presented `R`-algebra by `coinvariantIdeal Θ A` preserves finite presentation
(`instFinitePresentationQuotientCoinvariantIdeal`), with no Noetherian hypothesis on `R`.

When `Θ` is a finite group whose order `Nat.card Θ` is a unit in `R`, Reynolds averaging modulo
`coinvariantIdeal Θ A ^ 2` defines a `Θ`-invariant `R`-algebra homomorphism
`reynoldsInfinitesimalLift : A →ₐ[R] A ⧸ coinvariantIdeal Θ A ^ 2`. Multiplicativity holds
because for any `a, b : A` and `θ, φ : Θ` the product `(θ • a - a) * (φ • b - b)` lies in
`coinvariantIdeal Θ A ^ 2`, so the averaged displacement map acts as a derivation into a
square-zero ideal. Passing to the quotient produces an explicit `R`-algebra retraction
`reynoldsInfinitesimalSection` of the first-order thickening
`A ⧸ coinvariantIdeal Θ A ^ 2 →ₐ[R] A ⧸ coinvariantIdeal Θ A` without any smoothness assumption
on `A`. When `A` is formally smooth (respectively, smooth) over `R`,
`Algebra.FormallySmooth.of_split` concludes that `A ⧸ coinvariantIdeal Θ A` is formally smooth
(respectively, smooth) over `R` (`formallySmooth_quotient_coinvariantIdeal`,
`smooth_quotient_coinvariantIdeal`).

## Main definitions

* `TauCeti.coinvariantIdeal Θ A`: the ideal of `A` generated by all `θ • a - a`.
* `TauCeti.coinvariantAlgHomEquiv`: universal property identifying `R`-algebra maps out of
  `A ⧸ coinvariantIdeal Θ A` with `Θ`-invariant `R`-algebra maps out of `A`.
* `TauCeti.reynoldsInfinitesimalLift` and `TauCeti.reynoldsInfinitesimalSection`: the Reynolds
  `R`-algebra retraction `A ⧸ coinvariantIdeal Θ A →ₐ[R] A ⧸ coinvariantIdeal Θ A ^ 2` when
  `IsUnit (Nat.card Θ : R)`.

## Main results

* `TauCeti.coinvariantIdeal_fg` and `TauCeti.instFinitePresentationQuotientCoinvariantIdeal`:
  finiteness of `Θ` and finite type / finite presentation of `A` pass to `coinvariantIdeal Θ A`
  and `A ⧸ coinvariantIdeal Θ A`.
* `TauCeti.factor_comp_reynoldsInfinitesimalSection`: `reynoldsInfinitesimalSection` splits the
  first-order thickening `A ⧸ coinvariantIdeal Θ A ^ 2 →ₐ[R] A ⧸ coinvariantIdeal Θ A`.
* `TauCeti.formallySmooth_quotient_coinvariantIdeal` and
  `TauCeti.smooth_quotient_coinvariantIdeal`: Edixhoven's theorem that the fixed-point subscheme
  of a finite group of invertible order acting on a formally smooth or smooth affine scheme over
  any commutative ring is formally smooth or smooth.

## References

* B. Edixhoven, *Néron models and tame ramification*, Compositio Math. 81 (1992), Proposition 3.1
  (p. 293) and Proposition 3.4 (pp. 294–295).
-/

public section

namespace TauCeti

section SMul

variable (Θ A : Type*) [CommRing A] [SMul Θ A]

/-- The **coinvariant ideal** of an action of `Θ` on a commutative ring `A`: the ideal generated
by all displacements `θ • a - a`. Contravariantly, `A ⧸ coinvariantIdeal Θ A` cuts out the
fixed-point closed subscheme of `Spec A`. -/
def coinvariantIdeal : Ideal A :=
  Ideal.span { x : A | ∃ (θ : Θ) (a : A), θ • a - a = x }

/-- Explicit span presentation of `coinvariantIdeal Θ A`. -/
theorem coinvariantIdeal_def :
    coinvariantIdeal Θ A = Ideal.span { x : A | ∃ (θ : Θ) (a : A), θ • a - a = x } :=
  (rfl)

/-- The coinvariant ideal is the supremum over `θ : Θ` of the single-element displacement ideals. -/
theorem coinvariantIdeal_eq_iSup :
    coinvariantIdeal Θ A = ⨆ θ : Θ, Ideal.span (Set.range fun a : A ↦ θ • a - a) := by
  rw [coinvariantIdeal_def, ← Ideal.span_iUnion]
  congr 1
  ext x
  simp [Set.mem_iUnion]

variable {Θ A}

/-- Every displacement `θ • a - a` belongs to `coinvariantIdeal Θ A`. -/
@[grind ←]
theorem sub_mem_coinvariantIdeal (θ : Θ) (a : A) :
    θ • a - a ∈ coinvariantIdeal Θ A :=
  Ideal.subset_span ⟨θ, a, rfl⟩

/-- `coinvariantIdeal Θ A` is the smallest ideal of `A` containing every displacement
`θ • a - a`. -/
@[simp]
theorem coinvariantIdeal_le_iff {J : Ideal A} :
    coinvariantIdeal Θ A ≤ J ↔ ∀ (θ : Θ) (a : A), θ • a - a ∈ J := by
  rw [coinvariantIdeal_def, Ideal.span_le]
  constructor
  · intro h θ a
    exact h ⟨θ, a, rfl⟩
  · rintro h _ ⟨θ, a, rfl⟩
    exact h θ a

/-- A ring homomorphism out of `A` kills `coinvariantIdeal Θ A` if and only if it is
`Θ`-invariant. -/
theorem coinvariantIdeal_le_ker_iff {B : Type*} [Ring B] (f : A →+* B) :
    coinvariantIdeal Θ A ≤ RingHom.ker f ↔ ∀ (θ : Θ) (a : A), f (θ • a) = f a := by
  rw [coinvariantIdeal_le_iff]
  refine forall₂_congr fun θ a ↦ ?_
  rw [RingHom.mem_ker, map_sub, sub_eq_zero]

/-- In `A ⧸ coinvariantIdeal Θ A`, every `θ • a` has the same residue class as `a`. -/
@[simp]
theorem mk_smul_coinvariantIdeal (θ : Θ) (a : A) :
    Ideal.Quotient.mk (coinvariantIdeal Θ A) (θ • a) =
      Ideal.Quotient.mk (coinvariantIdeal Θ A) a :=
  Ideal.Quotient.eq.mpr (sub_mem_coinvariantIdeal θ a)

/-- Algebra-map quotient form of `mk_smul_coinvariantIdeal`. -/
@[simp]
theorem mkₐ_smul_coinvariantIdeal (R : Type*) [CommRing R] [Algebra R A] (θ : Θ) (a : A) :
    Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A) (θ • a) =
      Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A) a :=
  mk_smul_coinvariantIdeal θ a

/-- The coinvariant ideal vanishes if and only if `Θ` acts trivially on `A`. -/
@[simp]
theorem coinvariantIdeal_eq_bot_iff :
    coinvariantIdeal Θ A = ⊥ ↔ ∀ (θ : Θ) (a : A), θ • a = a := by
  rw [eq_bot_iff, coinvariantIdeal_le_iff]
  simp [sub_eq_zero]

/-- Universal property of the coinvariant quotient algebra (Edixhoven, Proposition 3.1):
`R`-algebra homomorphisms `A ⧸ coinvariantIdeal Θ A →ₐ[R] B` correspond bijectively to
`Θ`-invariant `R`-algebra homomorphisms `A →ₐ[R] B`. -/
def coinvariantAlgHomEquiv (R Θ A B : Type*) [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] [SMul Θ A] :
    (A ⧸ coinvariantIdeal Θ A →ₐ[R] B) ≃
      { f : A →ₐ[R] B // ∀ (θ : Θ) (a : A), f (θ • a) = f a } where
  toFun g := ⟨g.comp (Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A)), fun θ a ↦ by simp⟩
  invFun f := Ideal.Quotient.liftₐ (coinvariantIdeal Θ A) f.1 fun x hx ↦
    RingHom.mem_ker.mp ((coinvariantIdeal_le_ker_iff f.1.toRingHom).mpr f.2 hx)
  left_inv g := by
    ext x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    rfl
  right_inv f := Subtype.ext <| AlgHom.ext fun _ ↦ rfl

/-- The forward direction of `coinvariantAlgHomEquiv` precomposes with the quotient map. -/
@[simp]
theorem coinvariantAlgHomEquiv_apply {R Θ A B : Type*} [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] [SMul Θ A] (g : A ⧸ coinvariantIdeal Θ A →ₐ[R] B) :
    (coinvariantAlgHomEquiv R Θ A B g).1 =
      g.comp (Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A)) :=
  (rfl)

/-- Evaluating `(coinvariantAlgHomEquiv R Θ A B).symm f` on the quotient class of `a` recovers
`f.1 a`. -/
@[simp]
theorem coinvariantAlgHomEquiv_symm_mk {R Θ A B : Type*} [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] [SMul Θ A]
    (f : { f : A →ₐ[R] B // ∀ (θ : Θ) (a : A), f (θ • a) = f a }) (a : A) :
    (coinvariantAlgHomEquiv R Θ A B).symm f (Ideal.Quotient.mk (coinvariantIdeal Θ A) a) =
      f.1 a :=
  (rfl)

/-- Algebra-map quotient form of `coinvariantAlgHomEquiv_symm_mk`. -/
theorem coinvariantAlgHomEquiv_symm_mkₐ {R Θ A B : Type*} [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] [SMul Θ A]
    (f : { f : A →ₐ[R] B // ∀ (θ : Θ) (a : A), f (θ • a) = f a }) (a : A) :
    (coinvariantAlgHomEquiv R Θ A B).symm f (Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A) a) =
      f.1 a :=
  (rfl)

/-- Precomposing with the quotient map `A →ₐ[R] A ⧸ coinvariantIdeal Θ A` identifies its image
in `A →ₐ[R] B` with the set of `Θ`-invariant `R`-algebra homomorphisms. -/
theorem range_comp_mkₐ_coinvariantIdeal (R Θ A B : Type*) [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] [SMul Θ A] :
    Set.range (fun g : A ⧸ coinvariantIdeal Θ A →ₐ[R] B ↦
        g.comp (Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A))) =
      { f : A →ₐ[R] B | ∀ (θ : Θ) (a : A), f (θ • a) = f a } := by
  ext f
  constructor
  · rintro ⟨g, rfl⟩ θ a
    simp
  · intro hf
    exact ⟨(coinvariantAlgHomEquiv R Θ A B).symm ⟨f, hf⟩, AlgHom.ext fun _ ↦ rfl⟩

end SMul

section MonoidAction

variable {R Θ A : Type*} [CommRing R] [CommRing A] [Algebra R A] [Monoid Θ]

/-- Action of a subsingleton monoid produces the zero coinvariant ideal. -/
@[simp]
theorem coinvariantIdeal_of_subsingleton [MulAction Θ A] [Subsingleton Θ] :
    coinvariantIdeal Θ A = ⊥ :=
  coinvariantIdeal_eq_bot_iff.mpr fun θ a ↦ by
    rw [Subsingleton.elim θ 1, one_smul]

/-- Under a multiplicative semiring action of a monoid `Θ` on `A`, the coinvariant ideal is
`Θ`-stable. -/
theorem smul_mem_coinvariantIdeal [MulSemiringAction Θ A] (θ : Θ) {x : A}
    (hx : x ∈ coinvariantIdeal Θ A) : θ • x ∈ coinvariantIdeal Θ A := by
  rw [coinvariantIdeal_def] at hx
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
  · rintro _ ⟨φ, a, rfl⟩
    have hEq : θ • (φ • a - a) = ((θ * φ) • a - a) - (θ • a - a) := by
      rw [smul_sub, mul_smul]
      abel
    rw [hEq]
    exact sub_mem (sub_mem_coinvariantIdeal (θ * φ) a) (sub_mem_coinvariantIdeal θ a)
  · simp
  · intro y z _ _ hy hz
    rw [smul_add]
    exact add_mem hy hz
  · intro r y _ hy
    rw [smul_eq_mul, smul_mul']
    exact Ideal.mul_mem_left _ (θ • r) hy

/-- For an `R`-linear semiring action, pointwise `Θ`-invariance of `f : A →ₐ[R] B` is equivalent
to `f.comp (MulSemiringAction.toAlgHom R A θ) = f` for every `θ : Θ`. -/
theorem forall_smul_eq_iff_comp_toAlgHom {B : Type*} [CommRing B] [Algebra R B]
    [MulSemiringAction Θ A] [SMulCommClass Θ R A] (f : A →ₐ[R] B) :
    (∀ (θ : Θ) (a : A), f (θ • a) = f a) ↔
      ∀ θ : Θ, f.comp (MulSemiringAction.toAlgHom R A θ) = f := by
  refine forall_congr' fun θ ↦ ?_
  simp [AlgHom.ext_iff]

/-- When a finite monoid `Θ` acts on a finite-type `R`-algebra `A` by `R`-algebra endomorphisms,
the coinvariant ideal `coinvariantIdeal Θ A` is finitely generated. -/
theorem coinvariantIdeal_fg [Finite Θ] [MulSemiringAction Θ A] [SMulCommClass Θ R A]
    [Algebra.FiniteType R A] : (coinvariantIdeal Θ A).FG := by
  rw [coinvariantIdeal_eq_iSup]
  exact AlgHom.fg_iSup_span_range_sub
    (fun θ : Θ ↦ MulSemiringAction.toAlgHom R A θ) (fun _ ↦ AlgHom.id R A)

/-- Quotienting a finitely presented `R`-algebra `A` by the coinvariant ideal of a finite monoid
action preserves finite presentation over `R`. -/
instance instFinitePresentationQuotientCoinvariantIdeal [Finite Θ] [MulSemiringAction Θ A]
    [SMulCommClass Θ R A] [Algebra.FinitePresentation R A] :
    Algebra.FinitePresentation R (A ⧸ coinvariantIdeal Θ A) :=
  Algebra.FinitePresentation.quotient (coinvariantIdeal_fg (R := R))

end MonoidAction

section TameGroupAction

/-- In `A ⧸ (coinvariantIdeal Θ A ^ 2)`, the product of any two displacements vanishes. -/
private theorem mk_sub_mul_mk_sub_eq_zero {R Θ A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    [SMul Θ A] (θ φ : Θ) (a b : A) :
    Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A ^ 2) (θ • a - a) *
        Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A ^ 2) (φ • b - b) = 0 := by
  rw [← map_mul, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem, pow_two]
  exact Ideal.mul_mem_mul (sub_mem_coinvariantIdeal θ a) (sub_mem_coinvariantIdeal φ b)

/-- The averaged displacement operator `a ↦ |Θ|⁻¹ • ∑ θ, [θ • a - a]` into
`A ⧸ (coinvariantIdeal Θ A ^ 2)`. -/
private noncomputable def reynoldsDisplacement (Θ : Type*) {R A : Type*} [CommRing R]
    [CommRing A] [Algebra R A] [SMul Θ A] [Fintype Θ] (u : Rˣ) (a : A) :
    A ⧸ (coinvariantIdeal Θ A ^ 2) :=
  (↑u⁻¹ : R) • ∑ θ : Θ, Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A ^ 2) (θ • a - a)

private theorem mkₐ_add_reynoldsDisplacement {R Θ A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] [SMul Θ A] [Fintype Θ] (u : Rˣ)
    (hu : (u : R) = (Fintype.card Θ : R)) (a : A) :
    Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A ^ 2) a + reynoldsDisplacement Θ u a =
      (↑u⁻¹ : R) • ∑ θ : Θ, Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A ^ 2) (θ • a) := by
  have hinv : (↑u⁻¹ : R) * (Fintype.card Θ : R) = 1 := by
    rw [← hu, Units.inv_mul]
  rw [reynoldsDisplacement]
  simp only [map_sub, Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ,
    ← Nat.cast_smul_eq_nsmul R, smul_sub, smul_smul, hinv, one_smul]
  abel

private theorem reynoldsDisplacement_mul_reynoldsDisplacement {R Θ A : Type*} [CommRing R]
    [CommRing A] [Algebra R A] [SMul Θ A] [Fintype Θ] (u : Rˣ) (a b : A) :
    reynoldsDisplacement Θ u a * reynoldsDisplacement Θ u b = 0 := by
  rw [reynoldsDisplacement, reynoldsDisplacement, smul_mul_smul_comm, Finset.sum_mul_sum]
  simp only [mk_sub_mul_mk_sub_eq_zero, Finset.sum_const_zero, smul_zero]

private theorem reynoldsDisplacement_mul_apply {R Θ A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] [Monoid Θ] [MulSemiringAction Θ A] [Fintype Θ] (u : Rˣ) (a b : A) :
    reynoldsDisplacement Θ u (a * b) =
      Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A ^ 2) a * reynoldsDisplacement Θ u b +
        reynoldsDisplacement Θ u a * Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A ^ 2) b := by
  rw [reynoldsDisplacement, reynoldsDisplacement, reynoldsDisplacement]
  set q := Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A ^ 2)
  have hterm (θ : Θ) : q (θ • (a * b) - a * b) = q a * q (θ • b - b) + q (θ • a - a) * q b := by
    have hring : θ • (a * b) - a * b =
        a * (θ • b - b) + (θ • a - a) * b + (θ • a - a) * (θ • b - b) := by
      rw [smul_mul']
      ring
    rw [hring, map_add, map_add, map_mul, map_mul, map_mul, mk_sub_mul_mk_sub_eq_zero, add_zero]
  simp only [hterm, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.sum_mul, smul_add,
    mul_smul_comm, smul_mul_assoc]

variable {R Θ A : Type*} [CommRing R] [CommRing A] [Algebra R A]
  [Group Θ] [Finite Θ] [MulSemiringAction Θ A] [SMulCommClass Θ R A]

/-- The **Reynolds infinitesimal lift**: when `Nat.card Θ` is invertible in `R`, averaging the
translates `[θ • a]` modulo `coinvariantIdeal Θ A ^ 2` defines a `Θ`-invariant `R`-algebra
homomorphism `A →ₐ[R] A ⧸ (coinvariantIdeal Θ A ^ 2)`. -/
noncomputable def reynoldsInfinitesimalLift (hΘ : IsUnit (Nat.card Θ : R)) :
    A →ₐ[R] A ⧸ (coinvariantIdeal Θ A ^ 2) where
  toFun a :=
    let _ : Fintype Θ := Fintype.ofFinite Θ
    (↑hΘ.unit⁻¹ : R) • ∑ θ : Θ, Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A ^ 2) (θ • a)
  map_one' := by
    let _ : Fintype Θ := Fintype.ofFinite Θ
    have hcard : (Fintype.card Θ : R) = (hΘ.unit : R) := by
      rw [IsUnit.unit_spec, Nat.card_eq_fintype_card]
    have hinv : (↑hΘ.unit⁻¹ : R) * (Fintype.card Θ : R) = 1 := by
      rw [hcard, Units.inv_mul]
    simp only [smul_one, map_one, Finset.sum_const, Finset.card_univ,
      ← Nat.cast_smul_eq_nsmul R, smul_smul, hinv, one_smul]
  map_mul' a b := by
    let _ : Fintype Θ := Fintype.ofFinite Θ
    let q := Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A ^ 2)
    have hu : (hΘ.unit : R) = (Fintype.card Θ : R) := by
      rw [IsUnit.unit_spec, Nat.card_eq_fintype_card]
    dsimp only
    rw [← mkₐ_add_reynoldsDisplacement hΘ.unit hu, ← mkₐ_add_reynoldsDisplacement hΘ.unit hu,
      ← mkₐ_add_reynoldsDisplacement hΘ.unit hu, map_mul, reynoldsDisplacement_mul_apply]
    calc
      q a * q b +
          (q a * reynoldsDisplacement Θ hΘ.unit b + reynoldsDisplacement Θ hΘ.unit a * q b)
          = q a * q b + q a * reynoldsDisplacement Θ hΘ.unit b +
              reynoldsDisplacement Θ hΘ.unit a * q b +
              reynoldsDisplacement Θ hΘ.unit a * reynoldsDisplacement Θ hΘ.unit b := by
            rw [reynoldsDisplacement_mul_reynoldsDisplacement, add_zero, add_assoc]
      _ = (q a + reynoldsDisplacement Θ hΘ.unit a) *
            (q b + reynoldsDisplacement Θ hΘ.unit b) := by ring
  map_zero' := by
    let _ : Fintype Θ := Fintype.ofFinite Θ
    simp
  map_add' a b := by
    let _ : Fintype Θ := Fintype.ofFinite Θ
    simp only [smul_add, map_add, Finset.sum_add_distrib]
  commutes' r := by
    let _ : Fintype Θ := Fintype.ofFinite Θ
    have hcard : (Fintype.card Θ : R) = (hΘ.unit : R) := by
      rw [IsUnit.unit_spec, Nat.card_eq_fintype_card]
    have hinv : (↑hΘ.unit⁻¹ : R) * (Fintype.card Θ : R) = 1 := by
      rw [hcard, Units.inv_mul]
    have hsmul (θ : Θ) : θ • algebraMap R A r = algebraMap R A r := by
      rw [Algebra.algebraMap_eq_smul_one, smul_comm, smul_one]
    simp only [hsmul, AlgHom.commutes, Finset.sum_const, Finset.card_univ,
      ← Nat.cast_smul_eq_nsmul R, smul_smul, hinv, one_smul]

/-- Explicit summation formula for `reynoldsInfinitesimalLift` when `Θ` carries a `Fintype`
instance. -/
theorem reynoldsInfinitesimalLift_apply {Θ : Type*} [Group Θ] [Fintype Θ]
    [MulSemiringAction Θ A] [SMulCommClass Θ R A] (hΘ : IsUnit (Nat.card Θ : R)) (a : A) :
    reynoldsInfinitesimalLift hΘ a =
      (↑hΘ.unit⁻¹ : R) • ∑ θ : Θ, Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A ^ 2) (θ • a) := by
  have hft : Fintype.ofFinite Θ = ‹Fintype Θ› := Subsingleton.elim _ _
  rw [reynoldsInfinitesimalLift]
  dsimp only [AlgHom.coe_mk, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk]
  rw [hft]

/-- `reynoldsInfinitesimalLift` is `Θ`-invariant. -/
@[simp]
theorem reynoldsInfinitesimalLift_smul (hΘ : IsUnit (Nat.card Θ : R)) (φ : Θ) (a : A) :
    reynoldsInfinitesimalLift hΘ (φ • a) = reynoldsInfinitesimalLift hΘ a := by
  let _ : Fintype Θ := Fintype.ofFinite Θ
  simp only [reynoldsInfinitesimalLift_apply, ← mul_smul]
  congr 1
  exact Fintype.sum_equiv (Equiv.mulRight φ) _ _ fun _ ↦ rfl

/-- Modulo `coinvariantIdeal Θ A`, `reynoldsInfinitesimalLift` reduces to the quotient map. -/
theorem factor_reynoldsInfinitesimalLift_apply (hΘ : IsUnit (Nat.card Θ : R)) (a : A) :
    Ideal.Quotient.factorₐ R (Ideal.pow_le_self two_ne_zero)
        (reynoldsInfinitesimalLift hΘ a) =
      Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A) a := by
  let _ : Fintype Θ := Fintype.ofFinite Θ
  have hcard : (Fintype.card Θ : R) = (hΘ.unit : R) := by
    rw [IsUnit.unit_spec, Nat.card_eq_fintype_card]
  have hinv : (↑hΘ.unit⁻¹ : R) * (Fintype.card Θ : R) = 1 := by
    rw [hcard, Units.inv_mul]
  simp only [reynoldsInfinitesimalLift_apply, map_smul, map_sum, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.factorₐ_apply, Ideal.Quotient.factor_mk, mk_smul_coinvariantIdeal,
    Finset.sum_const, Finset.card_univ, ← Nat.cast_smul_eq_nsmul R, smul_smul, hinv, one_smul]

/-- Ring-hom quotient form of `factor_reynoldsInfinitesimalLift_apply`. -/
@[simp]
theorem factor_reynoldsInfinitesimalLift_mk (hΘ : IsUnit (Nat.card Θ : R)) (a : A) :
    Ideal.Quotient.factor (Ideal.pow_le_self two_ne_zero)
        (reynoldsInfinitesimalLift hΘ a) =
      Ideal.Quotient.mk (coinvariantIdeal Θ A) a :=
  factor_reynoldsInfinitesimalLift_apply hΘ a

/-- The **Reynolds infinitesimal section**: when `Nat.card Θ` is invertible in `R`, the first-order
thickening `A ⧸ (coinvariantIdeal Θ A ^ 2) →ₐ[R] A ⧸ coinvariantIdeal Θ A` admits a canonical
`R`-algebra section, with no smoothness assumption on `A`. -/
noncomputable def reynoldsInfinitesimalSection (hΘ : IsUnit (Nat.card Θ : R)) :
    A ⧸ coinvariantIdeal Θ A →ₐ[R] A ⧸ (coinvariantIdeal Θ A ^ 2) :=
  (coinvariantAlgHomEquiv R Θ A (A ⧸ (coinvariantIdeal Θ A ^ 2))).symm
    ⟨reynoldsInfinitesimalLift hΘ, reynoldsInfinitesimalLift_smul hΘ⟩

/-- Evaluating `reynoldsInfinitesimalSection` on the quotient class of `a` gives
`reynoldsInfinitesimalLift hΘ a`. -/
@[simp]
theorem reynoldsInfinitesimalSection_mk (hΘ : IsUnit (Nat.card Θ : R)) (a : A) :
    reynoldsInfinitesimalSection hΘ (Ideal.Quotient.mk (coinvariantIdeal Θ A) a) =
      reynoldsInfinitesimalLift hΘ a :=
  (rfl)

/-- Algebra-map quotient form of `reynoldsInfinitesimalSection_mk`. -/
theorem reynoldsInfinitesimalSection_mkₐ (hΘ : IsUnit (Nat.card Θ : R)) (a : A) :
    reynoldsInfinitesimalSection hΘ (Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A) a) =
      reynoldsInfinitesimalLift hΘ a :=
  (rfl)

/-- `reynoldsInfinitesimalSection` is a right inverse to the canonical surjection
`A ⧸ (coinvariantIdeal Θ A ^ 2) →ₐ[R] A ⧸ coinvariantIdeal Θ A`. -/
@[simp]
theorem factor_comp_reynoldsInfinitesimalSection (hΘ : IsUnit (Nat.card Θ : R)) :
    (Ideal.Quotient.factorₐ R (Ideal.pow_le_self two_ne_zero)).comp
        (reynoldsInfinitesimalSection hΘ) =
      AlgHom.id R (A ⧸ coinvariantIdeal Θ A) := by
  ext x
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact factor_reynoldsInfinitesimalLift_apply hΘ a

/-- **Edixhoven's formal smoothness theorem** (Edixhoven, Proposition 3.4): if a finite group `Θ`
whose order is invertible in `R` acts by `R`-algebra automorphisms on a formally smooth
`R`-algebra `A`, then the coinvariant algebra `A ⧸ coinvariantIdeal Θ A` is formally smooth
over `R`. -/
theorem formallySmooth_quotient_coinvariantIdeal [Algebra.FormallySmooth R A]
    (hΘ : IsUnit (Nat.card Θ : R)) :
    Algebra.FormallySmooth R (A ⧸ coinvariantIdeal Θ A) := by
  let f : A →ₐ[R] A ⧸ coinvariantIdeal Θ A := Ideal.Quotient.mkₐ R (coinvariantIdeal Θ A)
  have hker : coinvariantIdeal Θ A ^ 2 = RingHom.ker f.toRingHom ^ 2 := by
    congr 1
    exact (Ideal.Quotient.mkₐ_ker R (coinvariantIdeal Θ A)).symm
  let e : (A ⧸ (coinvariantIdeal Θ A ^ 2)) ≃ₐ[R] (A ⧸ (RingHom.ker f.toRingHom ^ 2)) :=
    Ideal.quotientEquivAlgOfEq R hker
  refine Algebra.FormallySmooth.of_split f (e.toAlgHom.comp (reynoldsInfinitesimalSection hΘ)) ?_
  ext x
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mkₐ_surjective R (coinvariantIdeal Θ A) x
  have hlift (z : A ⧸ (coinvariantIdeal Θ A ^ 2)) :
      f.kerSquareLift (e z) = Ideal.Quotient.factorₐ R (Ideal.pow_le_self two_ne_zero) z := by
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
    rfl
  rw [AlgHom.comp_apply, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
    reynoldsInfinitesimalSection_mkₐ, hlift, factor_reynoldsInfinitesimalLift_apply,
    AlgHom.id_apply]

/-- **Edixhoven's smoothness theorem** (Edixhoven, Propositions 3.1 and 3.4): if a finite group `Θ`
whose order is invertible in `R` acts by `R`-algebra automorphisms on a smooth `R`-algebra `A`,
then the coordinate ring `A ⧸ coinvariantIdeal Θ A` of the fixed-point closed subscheme `(Spec A)^Θ`
is smooth over `R`. -/
theorem smooth_quotient_coinvariantIdeal [Algebra.Smooth R A]
    (hΘ : IsUnit (Nat.card Θ : R)) :
    Algebra.Smooth R (A ⧸ coinvariantIdeal Θ A) :=
  let _ := formallySmooth_quotient_coinvariantIdeal (R := R) (A := A) hΘ
  { }

end TameGroupAction

section AlgEquivAction

variable {R Θ A : Type*} [CommRing R] [CommRing A] [Algebra R A] [Group Θ] [Finite Θ]

/-- Explicit-homomorphism form of `formallySmooth_quotient_coinvariantIdeal`: if
`ρ : Θ →* (A ≃ₐ[R] A)` is an action of a finite group whose order is invertible in `R` on a
formally smooth `R`-algebra `A`, and `I` is the supremum of the displacement ideals `⟨ρ θ a - a⟩`,
then `A ⧸ I` is formally smooth over `R`. -/
theorem formallySmooth_quotient_of_eq_iSup_span_range_sub [Algebra.FormallySmooth R A]
    (ρ : Θ →* (A ≃ₐ[R] A)) {I : Ideal A}
    (hI : I = ⨆ θ : Θ, Ideal.span (Set.range fun a : A ↦ ρ θ a - a))
    (hΘ : IsUnit (Nat.card Θ : R)) :
    Algebra.FormallySmooth R (A ⧸ I) := by
  let _ : MulSemiringAction Θ A := MulSemiringAction.compHom A ρ
  let _ : SMulCommClass Θ R A := SMul.comp.smulCommClass ρ
  have hEq : coinvariantIdeal Θ A = I := (coinvariantIdeal_eq_iSup Θ A).trans hI.symm
  have _ : Algebra.FormallySmooth R (A ⧸ coinvariantIdeal Θ A) :=
    formallySmooth_quotient_coinvariantIdeal (R := R) (A := A) hΘ
  exact Algebra.FormallySmooth.of_equiv (Ideal.quotientEquivAlgOfEq R hEq)

/-- Explicit-homomorphism form of `smooth_quotient_coinvariantIdeal`: if `ρ : Θ →* (A ≃ₐ[R] A)` is
an action of a finite group whose order is invertible in `R` on a smooth `R`-algebra `A`, and `I` is
the supremum of the displacement ideals `⟨ρ θ a - a⟩`, then `A ⧸ I` is smooth over `R`. -/
theorem smooth_quotient_of_eq_iSup_span_range_sub [Algebra.Smooth R A]
    (ρ : Θ →* (A ≃ₐ[R] A)) {I : Ideal A}
    (hI : I = ⨆ θ : Θ, Ideal.span (Set.range fun a : A ↦ ρ θ a - a))
    (hΘ : IsUnit (Nat.card Θ : R)) :
    Algebra.Smooth R (A ⧸ I) := by
  let _ : MulSemiringAction Θ A := MulSemiringAction.compHom A ρ
  let _ : SMulCommClass Θ R A := SMul.comp.smulCommClass ρ
  have hEq : coinvariantIdeal Θ A = I := (coinvariantIdeal_eq_iSup Θ A).trans hI.symm
  have _ : Algebra.Smooth R (A ⧸ coinvariantIdeal Θ A) :=
    smooth_quotient_coinvariantIdeal (R := R) (A := A) hΘ
  exact Algebra.Smooth.of_equiv (Ideal.quotientEquivAlgOfEq R hEq)

end AlgEquivAction

end TauCeti
