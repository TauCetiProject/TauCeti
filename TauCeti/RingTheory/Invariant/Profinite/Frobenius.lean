module

public import Mathlib.RingTheory.Frobenius
public import TauCeti.RingTheory.Invariant.Profinite.Basic

import Mathlib.FieldTheory.Finite.Basic
import TauCeti.FieldTheory.Finite.FrobeniusFixed

/-!
# Frobenius elements for profinite actions

Let a compact totally disconnected group `G` act continuously on a commutative ring `S` with the
discrete topology, with invariant ring `R` (`Algebra.IsInvariant R S G`), and let `Q` be a prime
of `S` whose contraction `P = Q ∩ R` has finite residue ring `R ⧸ P`, with `q` elements. An
arithmetic Frobenius at `Q` (Mathlib's `IsArithFrobAt R σ Q`) is a `σ : G` with
`σ • x ≡ x ^ q (mod Q)` for all `x : S`.

Mathlib proves that a Frobenius exists when `G` is finite and `S ⧸ Q` is finite
(`IsArithFrobAt.exists_of_isInvariant`). For a profinite group the residue field `S ⧸ Q` is
usually infinite (an algebraic closure of `𝔽_p` for the integral closure of `ℤ` in an algebraic
closure of `ℚ`), and only the base residue field is finite. This file proves existence under that
hypothesis alone, and shows that a Frobenius and the inertia group together topologically
generate the decomposition group: every `g ∈ D_Q` is `s * i` with `s` in the closure of the
powers of `σ` and `i ∈ I_Q`. For a finite Galois extension of number fields, where the closure
of `⟨σ⟩` is `⟨σ⟩` itself, this is Tau Ceti's
`Ideal.zpowers_sup_inertia_eq_stabilizer_of_isArithFrobAt`. The generation statements do not use
the invariance hypothesis: they hold for any ring `R` whose image in `S` is fixed by `G`, once a
Frobenius is given.

Both proofs go through Mathlib's `Ideal.Quotient.stabilizerHom_surjective_of_profinite`. For
existence it is applied to the residue Frobenius `x ↦ x ^ q`, an automorphism of the algebraic
extension `S ⧸ Q` of the finite field `R ⧸ P`. For generation it is applied to the closed, hence
compact, subgroup `H` topologically generated by `σ`, acting on `S` with invariants `S^H`: the
residue class of an element of `S^H` is fixed by `x ↦ x ^ q`, so it lies in `R ⧸ P`, and every
automorphism of `S ⧸ Q` over `R ⧸ P` is one over the residue ring of `S^H`, hence comes from `H`.

## Main results

* `IsArithFrobAt.exists_of_isInvariant_of_profinite`: an arithmetic Frobenius at `Q` exists.
* `Ideal.Quotient.stabilizerHom_topologicalClosure_zpowers_surjective`: the closed subgroup
  generated by a Frobenius surjects onto the automorphisms of the residue extension.
* `Ideal.topologicalClosure_zpowers_mul_inertia_eq_stabilizer_of_isArithFrobAt` and
  `Ideal.topologicalClosure_zpowers_sup_inertia_eq_stabilizer_of_isArithFrobAt`:
  `D_Q = cl⟨σ⟩ · I_Q`.

## References

* [J. Neukirch, *Algebraic Number Theory*][Neukirch1992], Chapter I, §9 (Frobenius elements for
  finite Galois extensions) and Chapter II, §9 (the decomposition and inertia groups of infinite
  Galois extensions).
* The generation argument, applying `Ideal.Quotient.stabilizerHom_surjective_of_profinite` a
  second time to the closure of `⟨σ⟩`, follows `New.IsLocalGalois.denseRange_frob_pow_mul_inertia`
  in the riemann-hypothesis project
  (https://github.com/leanprover-community/riemann-hypothesis, file
  `src/Lib/ClassField/Places/LocalFields.lean` at commit
  e38782a68eb5f6ee793739847c703aa16080ef6c).
-/

public section

open MulAction Pointwise

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
  {G : Type*} [Group G] [MulSemiringAction G S] [SMulCommClass G R S]
  [TopologicalSpace G] [CompactSpace G] [TotallyDisconnectedSpace G] [IsTopologicalGroup G]
  [TopologicalSpace S] [DiscreteTopology S] [ContinuousSMul G S]

variable (R G) in
attribute [local instance] Ideal.Quotient.field in
/-- **Arithmetic Frobenius elements exist for profinite actions.** If `Q` is a prime of `S` and
the residue ring `R ⧸ Q ∩ R` of the base is finite, there is a `σ : G` with
`σ • x ≡ x ^ #(R ⧸ Q ∩ R) (mod Q)` for every `x : S`.

This is the profinite form of Mathlib's `IsArithFrobAt.exists_of_isInvariant`, which assumes `G`
and `S ⧸ Q` finite. Here only the residue field of the base is assumed finite; `S ⧸ Q` is then
algebraic over it and may be infinite. Without that hypothesis the statement fails, since an
infinite residue ring gives the exponent `Nat.card = 0`. -/
theorem IsArithFrobAt.exists_of_isInvariant_of_profinite [Algebra.IsInvariant R S G]
    (Q : Ideal S) [Q.IsPrime] [Finite (R ⧸ Q.under R)] : ∃ σ : G, IsArithFrobAt R σ Q := by
  have := Algebra.IsInvariant.isIntegral_of_profinite (A := R) (B := S) (G := G)
  have hP := Ideal.Quotient.maximal_of_isField _ (Finite.isField_of_domain (R ⧸ Q.under R))
  have := Ideal.isMaximal_of_isIntegral_of_isMaximal_under (R := R) Q hP
  have := Fintype.ofFinite (R ⧸ Q.under R)
  have : Algebra.IsAlgebraic (R ⧸ Q.under R) (S ⧸ Q) := Algebra.IsIntegral.isAlgebraic
  obtain ⟨σ, hσ⟩ := Ideal.Quotient.stabilizerHom_surjective_of_profinite (G := G) (Q.under R) Q
    (FiniteField.frobeniusAlgEquivOfAlgebraic (R ⧸ Q.under R) (S ⧸ Q))
  refine ⟨σ, fun x ↦ ?_⟩
  rw [← Ideal.Quotient.eq, Nat.card_eq_fintype_card]
  simpa [Ideal.Quotient.stabilizerHom_apply, FiniteField.coe_frobeniusAlgEquivOfAlgebraic,
    Subgroup.smul_def] using congr($hσ (Ideal.Quotient.mk Q x))

attribute [local instance] Ideal.Quotient.field in
/-- **The closed subgroup generated by a Frobenius surjects onto the residue automorphisms.** If
`σ` is an arithmetic Frobenius at a prime `Q`, every automorphism of `S ⧸ Q` over `R ⧸ Q ∩ R` is
induced by an element of the closure of `⟨σ⟩` stabilizing `Q`. No invariance hypothesis on
`R ⊆ S` is needed. -/
theorem Ideal.Quotient.stabilizerHom_topologicalClosure_zpowers_surjective (Q : Ideal S)
    [Q.IsPrime] {σ : G} (hσ : IsArithFrobAt R σ Q) :
    Function.Surjective
      (stabilizerHom Q (Q.under R) (Subgroup.zpowers σ).topologicalClosure) := by
  set H := (Subgroup.zpowers σ).topologicalClosure
  have : CompactSpace H :=
    isCompact_iff_compactSpace.mp (Subgroup.isClosed_topologicalClosure _).isCompact
  have := AlgHom.IsArithFrobAt.finite_quotient hσ
  have := Ideal.Quotient.maximal_of_isField _ (Finite.isField_of_domain (R ⧸ Q.under R))
  let R' := FixedPoints.subalgebra R S H
  intro τ
  let τ' : (S ⧸ Q) ≃ₐ[R' ⧸ Q.under R'] (S ⧸ Q) :=
    { τ with
      commutes' := by
        refine Quotient.ind fun a ↦ ?_
        have hσa : σ • (a : S) = a := a.property ⟨σ, subset_closure (Subgroup.mem_zpowers σ)⟩
        have hfix : Ideal.Quotient.mk Q (a : S) ^ Nat.card (R ⧸ Q.under R) =
            Ideal.Quotient.mk Q (a : S) := by
          rw [← map_pow, eq_comm, Ideal.Quotient.eq]
          simpa [hσa] using hσ a
        obtain ⟨r, hr⟩ :=
          (TauCeti.FiniteField.pow_natCard_eq_self_iff_mem_range_algebraMap _).mp hfix
        -- `τ'` has the underlying function of `τ`, and the algebra map `R' ⧸ Q.under R' → S ⧸ Q`
        -- sends the class of `a` to the class of `(a : S)`, both by definition.
        change τ (Ideal.Quotient.mk Q (a : S)) = Ideal.Quotient.mk Q (a : S)
        rw [← hr, AlgEquiv.commutes] }
  obtain ⟨h, hh⟩ := stabilizerHom_surjective_of_profinite (G := H) (Q.under R') Q τ'
  refine ⟨h, AlgEquiv.ext fun x ↦ ?_⟩
  obtain ⟨x, rfl⟩ := Quotient.mk_surjective x
  simpa [Ideal.Quotient.stabilizerHom_apply, τ'] using congr($hh (Quotient.mk Q x))

/-- **A Frobenius and the inertia group generate the decomposition group**, as a product of
subsets: every element of the decomposition group `D_Q` of a prime `Q` is `s * i` with `s` in the
closure of the powers of an arithmetic Frobenius `σ` at `Q` and `i` in the inertia group `I_Q`.
No invariance hypothesis on `R ⊆ S` is needed. -/
theorem Ideal.topologicalClosure_zpowers_mul_inertia_eq_stabilizer_of_isArithFrobAt
    (Q : Ideal S) [Q.IsPrime] {σ : G} (hσ : IsArithFrobAt R σ Q) :
    ((Subgroup.zpowers σ).topologicalClosure : Set G) * Q.inertia G = stabilizer G Q := by
  have hH : (Subgroup.zpowers σ).topologicalClosure ≤ stabilizer G Q :=
    Subgroup.topologicalClosure_minimal _ (Subgroup.zpowers_le.mpr hσ.mem_stabilizer)
      Q.isClosed_stabilizer
  refine subset_antisymm ?_ fun g hg ↦ ?_
  · rintro _ ⟨s, hs, i, hi, rfl⟩
    exact mul_mem (hH hs) (Q.inertia_le_stabilizer hi)
  obtain ⟨s, hs⟩ := Quotient.stabilizerHom_topologicalClosure_zpowers_surjective Q hσ
    (Quotient.stabilizerHom Q (Q.under R) G ⟨g, hg⟩)
  refine ⟨s, s.val.property, (s : G)⁻¹ * g, ?_, mul_inv_cancel_left _ _⟩
  let s' : stabilizer G Q := ⟨s, s.property⟩
  have : s'⁻¹ * ⟨g, hg⟩ ∈ Q.inertia (stabilizer G Q) := by
    rw [← Quotient.ker_stabilizerHom Q (Q.under R) G, MonoidHom.mem_ker, map_mul, map_inv,
      inv_mul_eq_one, ← hs]
    ext x
    obtain ⟨x, rfl⟩ := Quotient.mk_surjective x
    simp [s', Subgroup.smul_def]
  exact coe_mem_inertia.mpr this

/-- **A Frobenius and the inertia group generate the decomposition group**: for an arithmetic
Frobenius `σ` at a prime `Q`, the decomposition group of `Q` is generated by the closure of
`⟨σ⟩` and the inertia group of `Q`. This is the profinite form of Tau Ceti's
`Ideal.zpowers_sup_inertia_eq_stabilizer_of_isArithFrobAt` for finite Galois extensions of number
fields. -/
theorem Ideal.topologicalClosure_zpowers_sup_inertia_eq_stabilizer_of_isArithFrobAt
    (Q : Ideal S) [Q.IsPrime] {σ : G} (hσ : IsArithFrobAt R σ Q) :
    (Subgroup.zpowers σ).topologicalClosure ⊔ Q.inertia G = stabilizer G Q := by
  have h := topologicalClosure_zpowers_mul_inertia_eq_stabilizer_of_isArithFrobAt Q hσ
  refine le_antisymm (sup_le (fun s hs ↦ ?_) Q.inertia_le_stabilizer) fun g hg ↦ ?_
  · rw [← SetLike.mem_coe, ← h]
    exact ⟨s, hs, 1, one_mem _, mul_one s⟩
  · rw [← SetLike.mem_coe, ← h] at hg
    obtain ⟨s, hs, i, hi, rfl⟩ := hg
    exact Subgroup.mul_mem_sup hs hi
