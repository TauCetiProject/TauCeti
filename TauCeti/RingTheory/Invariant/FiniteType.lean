/-!
# Finite generation of invariant algebras of finite groups

Let a finite group `G` act on a commutative `R`-algebra `A` by `R`-algebra automorphisms, and let
`A^G = FixedPoints.subalgebra R A G` be the invariant subalgebra. This file proves that `A^G` is
finitely generated whenever `A` is, in two forms.

**Noether's finiteness theorem.** If `A` is of finite type over `R`, it is integral over `A^G`
(Mathlib's `Algebra.IsInvariant.isIntegral`, through the monic orbit polynomial), hence a finite
`A^G`-module. If moreover `R` is Noetherian, the Artin–Tate lemma `fg_of_fg_of_fg` makes `A^G` of
finite type over `R`. Nothing is assumed about the characteristic, so this includes the modular
case, where the order of `G` is not invertible in `R`.

**Noether's degree bound.** If `R` is a `ℚ`-algebra and `A` is generated by `x₁, …, xₙ`, then
`A^G` is generated by the orbit sums `∑_{g ∈ G} g • x^d` of the monomials `x^d` of total degree at
most `|G|`. For the polynomial functions `A = Sym(V*)`, with `G` acting through a linear action
on `V*` and `x` a basis of `V*`, these are homogeneous invariants of degree at most `|G|`; an
arbitrary algebra automorphism of `Sym(V*)` need not preserve the grading. This bounds the
degrees of *some* generating set; it is not the list of degrees of a system of basic invariants,
which need not exist, and the bound says nothing about how many generators are needed. Here `R`
need not be Noetherian. The bound also holds when only `|G|` is invertible in a field
(Fleischmann, Fogarty), which is not proved here.

The proof of the degree bound is Noether's. In the polynomial ring `A[u₁, …, uₙ]` put
`y_g = ∑ᵢ (g • xᵢ) uᵢ` for `g ∈ G`. The coefficient of `u^d` in the power sum `∑_g y_g^k` is
`multinomial(d) • ∑_g g • x^d` when `d` has degree `k`, and zero otherwise. By Newton's identities
for the `|G|` elements `y_g`, every power sum lies in the subalgebra generated over `R` by the
first `|G|` power sums, and so has all its coefficients in the subalgebra generated by the orbit
sums of monomials of degree at most `|G|`. Dividing by the multinomial coefficient, the orbit sum
of every monomial lies there. Finally every invariant `f` is `|G|⁻¹ ∑_g g • f`, a linear
combination of orbit sums of monomials.

## Main results

* `TauCeti.FixedPoints.moduleFinite_subalgebra`: a finite-type `R`-algebra is a finite module
  over its invariants under a finite group.
* `TauCeti.FixedPoints.finiteType_subalgebra`: **Noether's finiteness theorem**: over a Noetherian
  base, the invariants of a finite group acting on a finite-type algebra form a finite-type
  algebra.
* `TauCeti.sum_smul_prod_pow_mem_adjoin`: over a `ℚ`-algebra, the orbit sum of every monomial in
  `x` is a polynomial in the orbit sums of the monomials of degree at most `|G|`.
* `TauCeti.FixedPoints.subalgebra_eq_adjoin_sum_smul_prod_pow`: **Noether's degree bound**: if
  `x` generates `A` over a `ℚ`-algebra `R`, the orbit sums of the monomials in `x` of degree at
  most `|G|` generate `A^G`.
* `TauCeti.FixedPoints.finiteType_subalgebra_of_algebraRat`: over any `ℚ`-algebra, Noetherian or
  not, the invariants of a finite group acting on a finite-type algebra form a finite-type
  algebra.

## References

* E. Noether, *Der Endlichkeitssatz der Invarianten endlicher Gruppen*, Math. Ann. **77** (1916),
  89–92.
* M. F. Atiyah and I. G. Macdonald, *Introduction to Commutative Algebra*, Proposition 7.8
  (Artin–Tate) and Chapter 7, Exercise 5.
* P. Fleischmann, *The Noether bound in invariant theory of finite groups*, Adv. Math. **156**
  (2000), 23–32; J. Fogarty, *On Noether's bound for polynomial invariants of a finite group*,
  Electron. Res. Announc. Amer. Math. Soc. **7** (2001), 5–7.
-/

public section

open Finset MvPolynomial

namespace TauCeti.FixedPoints

section Finiteness

variable (R A G : Type*) [CommRing R] [CommRing A] [Algebra R A] [Group G]
  [MulSemiringAction G A] [SMulCommClass G R A]

/-- A finite-type `R`-algebra is a finite module over its invariants under a finite group. -/
instance moduleFinite_subalgebra [Algebra.FiniteType R A] [Finite G] :
    Module.Finite (FixedPoints.subalgebra R A G) A := by
  have : Algebra.IsIntegral (FixedPoints.subalgebra R A G) A :=
    Algebra.IsInvariant.isIntegral _ A G
  have : Algebra.FiniteType (FixedPoints.subalgebra R A G) A :=
    .of_restrictScalars_finiteType R _ A
  exact Algebra.IsIntegral.finite

/-- **Noether's finiteness theorem.** Over a Noetherian base ring `R`, the invariants of a finite
group acting on a finite-type `R`-algebra form a finite-type `R`-algebra. -/
instance finiteType_subalgebra [IsNoetherianRing R] [Algebra.FiniteType R A] [Finite G] :
    Algebra.FiniteType R (FixedPoints.subalgebra R A G) :=
  ⟨fg_of_fg_of_fg R (FixedPoints.subalgebra R A G) A Algebra.FiniteType.out Module.Finite.fg_top
    Subtype.val_injective⟩

end Finiteness

end TauCeti.FixedPoints

section DegreeBound

variable {R A G : Type*} [CommRing R] [Algebra ℚ R] [CommRing A] [Algebra R A] [Fintype G]
  {ι : Type*} [Finite ι]

namespace TauCeti

variable [Monoid G] [MulSemiringAction G A]

/-- Over a `ℚ`-algebra `R`, the orbit sum `∑_{g ∈ G} g • x^d` of every monomial `x^d` in a family
`x` is a polynomial over `R` in the orbit sums of the monomials of total degree at most `|G|`. -/
theorem sum_smul_prod_pow_mem_adjoin (x : ι → A) (d : ι →₀ ℕ) :
    ∑ g : G, g • d.prod (fun i n ↦ x i ^ n) ∈ Algebra.adjoin R
      ((fun e : ι →₀ ℕ ↦ ∑ g : G, g • e.prod fun i n ↦ x i ^ n) ''
        {e | e.degree ≤ Fintype.card G}) := by
  classical
  have := Fintype.ofFinite ι
  set B := Algebra.adjoin R ((fun e : ι →₀ ℕ ↦ ∑ g : G, g • e.prod fun i n ↦ x i ^ n) ''
    {e | e.degree ≤ Fintype.card G})
  -- The linear forms `y g = ∑ i, (g • x i) • u i` in the polynomial ring `A[u]`.
  let y : G → MvPolynomial ι A := fun g ↦ ∑ i, (g • x i) • X i
  -- The coefficients of their power sums are multinomial multiples of orbit sums of monomials.
  have hcoeff (k : ℕ) (e : ι →₀ ℕ) : (∑ g, y g ^ k).coeff e =
      if e.degree = k then (e.multinomial : A) * ∑ g : G, g • e.prod fun i n ↦ x i ^ n
      else 0 := by
    simp only [y, coeff_sum, coeff_linearCombination_X_pow_of_fintype]
    have hdeg : (e.sum fun _ m ↦ m) = e.degree := (Finsupp.degree_apply e).symm
    rw [hdeg]
    split_ifs
    · rw [mul_sum]
      refine sum_congr rfl fun g _ ↦ ?_
      rw [Finsupp.prod, Finsupp.prod, smul_prod']
      simp only [smul_pow']
    · simp
  -- The polynomials over `A` with all coefficients in `B`.
  let T : Subalgebra R (MvPolynomial ι A) := (mapAlgHom B.val).range
  have hT (P : MvPolynomial ι A) : P ∈ T ↔ ∀ e, P.coeff e ∈ B := by
    rw [← Subalgebra.mem_toSubmodule, range_mapAlgHom, mem_coeffsIn, Subalgebra.range_val]
    simp only [Subalgebra.mem_toSubmodule]
  -- By Newton's identities for the `|G|` elements `y g`, every power sum of them lies in `T`.
  let s : Multiset (MvPolynomial ι A) := univ.val.map y
  have hps (k : ℕ) : (s.map (· ^ k)).sum = ∑ g, y g ^ k := by
    simp only [s, Multiset.map_map, Function.comp_def, sum_map_val]
  have hcard : Multiset.card s = Fintype.card G := by simp [s]
  have hmem (k : ℕ) : ∑ g, y g ^ k ∈ T := by
    rw [← hps]
    refine s.sum_map_pow_mem_of_sum_map_pow_mem
      (TauCeti.isUnit_natCast_of_ne_zero (Nat.factorial_ne_zero _)) (fun j _ hj ↦ ?_) k
    rw [hps, hT]
    intro e
    rw [hcoeff]
    split_ifs with he
    · exact mul_mem (natCast_mem B _) (Algebra.subset_adjoin ⟨e, by grind, rfl⟩)
    · exact zero_mem B
  -- Compare the coefficients of `u ^ d` and divide by the multinomial coefficient.
  have hd := (hT _).1 (hmem d.degree) d
  simp only [hcoeff, ↓reduceIte] at hd
  refine (B.natCast_mul_mem_iff (TauCeti.isUnit_natCast_of_ne_zero ?_)).1 hd
  rw [Finsupp.multinomial_eq]
  exact (Nat.multinomial_pos _ _).ne'

end TauCeti

namespace TauCeti.FixedPoints

variable [Group G] [MulSemiringAction G A] [SMulCommClass G R A]

/-- **Noether's degree bound.** If a family `x` generates a commutative algebra `A` over a
`ℚ`-algebra `R`, then the invariants of a finite group `G` acting on `A` are generated by the orbit
sums `∑_{g ∈ G} g • x^d` of the monomials `x^d` of total degree at most `|G|`. -/
theorem subalgebra_eq_adjoin_sum_smul_prod_pow (x : ι → A)
    (hx : Algebra.adjoin R (Set.range x) = ⊤) :
    FixedPoints.subalgebra R A G = Algebra.adjoin R
      ((fun d : ι →₀ ℕ ↦ ∑ g : G, g • d.prod fun i n ↦ x i ^ n) ''
        {d | d.degree ≤ Fintype.card G}) := by
  refine le_antisymm (fun f hf ↦ ?_) (Algebra.adjoin_le ?_)
  · obtain ⟨P, rfl⟩ : ∃ P : MvPolynomial ι R, aeval x P = f := by
      rw [← AlgHom.mem_range, ← Algebra.adjoin_range_eq_range_aeval, hx]
      trivial
    -- An invariant is `|G|⁻¹` times its orbit sum, a combination of orbit sums of monomials.
    have hsum : ∑ g : G, g • aeval x P = (Fintype.card G : A) * aeval x P := by
      simp [FixedPoints.mem_subalgebra.1 hf, nsmul_eq_mul]
    have hmono (d : ι →₀ ℕ) : ∑ g : G, g • aeval x (monomial d (P.coeff d)) =
        P.coeff d • ∑ g : G, g • d.prod fun i n ↦ x i ^ n := by
      rw [aeval_monomial, ← Algebra.smul_def, smul_sum]
      exact sum_congr rfl fun g _ ↦ smul_comm g (P.coeff d) _
    rw [← Subalgebra.natCast_mul_mem_iff _
        (TauCeti.isUnit_natCast_of_ne_zero (Fintype.card_ne_zero (α := G))),
      ← hsum, P.as_sum, map_sum]
    simp_rw [smul_sum]
    rw [sum_comm]
    exact sum_mem fun d _ ↦ hmono d ▸
      Subalgebra.smul_mem _ (TauCeti.sum_smul_prod_pow_mem_adjoin x d) _
  · rintro _ ⟨d, -, rfl⟩
    exact FixedPoints.mem_subalgebra.2 fun h ↦ TauCeti.smul_sum_smul h _

end TauCeti.FixedPoints

end DegreeBound

namespace TauCeti.FixedPoints

variable (R A G : Type*) [CommRing R] [Algebra ℚ R] [CommRing A] [Algebra R A] [Group G]
  [MulSemiringAction G A] [SMulCommClass G R A]

/-- Over a `ℚ`-algebra `R`, Noetherian or not, the invariants of a finite group acting on a
finite-type `R`-algebra form a finite-type `R`-algebra. This follows from Noether's degree bound. -/
instance finiteType_subalgebra_of_algebraRat [Algebra.FiniteType R A] [Finite G] :
    Algebra.FiniteType R (FixedPoints.subalgebra R A G) := by
  obtain ⟨t, ht⟩ := Algebra.FiniteType.out (R := R) (A := A)
  let _ : Fintype G := .ofFinite G
  rw [← Subalgebra.fg_iff_finiteType, subalgebra_eq_adjoin_sum_smul_prod_pow
    (fun i : t ↦ (i : A)) (by simpa using ht)]
  exact Subalgebra.fg_def.2 ⟨_, (Finsupp.finite_of_degree_le _).image _, rfl⟩

end TauCeti.FixedPoints
