module

public import Mathlib.RingTheory.Etale.Locus
public import TauCeti.RingTheory.Invariant.Free
public import TauCeti.RingTheory.Invariant.Localization
import TauCeti.RingTheory.Invariant.Basic

/-!
# Invariant rings are étale away from the ramification locus

Let a finite group `G` act on a commutative ring `B`. The quotient map `Spec B → Spec Bᴳ` is
étale at every point with trivial inertia group: if `q` is a prime of `B` and no `g ≠ 1` acts
trivially on `B ⧸ q`, then `B` is étale over `Bᴳ` at `q`
(`Ideal.isEtaleAt_of_inertia_eq_bot`). Apart from finiteness of `G`, no finiteness, Noetherian
or characteristic hypothesis is needed.

The proof reduces to free actions, for which `B` is étale over `Bᴳ` by the theorem of Chase,
Harrison and Rosenberg (`TauCeti.MulSemiringAction.etale`). For `g ≠ 1`, let `J_g` be the ideal
generated by the displacements `g • b - b`; trivial inertia says `J_g ⊄ q`. The ideal
`J = ⋂_{g ≠ 1} J_g` is not contained in any translate `h • q`, so by prime avoidance it contains an
element `t` outside all of them. The norm `r = ∏_h h • t` is then an invariant outside `q`, and
since `t` divides `r`, every `J_g` becomes the unit ideal in `B[1/r]`: the action of `G` on
`B[1/r]` is free (`Ideal.exists_span_smul_sub_eq_top_of_inertia_eq_bot`). The
invariants of `B[1/r]` are `Bᴳ[1/r]` (`TauCeti.FixedPoints.isLocalization`), so `B[1/r]` is étale
over `Bᴳ`, and `q` lies in the basic open set of `r`.

Geometrically, `Spec B → Spec Bᴳ` is étale over the complement of the branch locus. For instance,
for the action of `{±1}` on `k[x, y]` by `f(x, y) ↦ f(-x, -y)` with `2` invertible in `k`, the
displacement of `x` is `-2x` and that of `y` is `-2y`, so `k[x, y]` is étale over
`k[x², xy, y²]` away from the origin.

## Main results

* `Ideal.exists_span_smul_sub_eq_top_of_inertia_eq_bot`: at a prime with trivial
  inertia there is an invariant `r` outside the prime such that `G` acts freely on `B[1/r]`.
* `Ideal.isEtaleAt_of_inertia_eq_bot`: `B` is étale over `Bᴳ` at every prime with
  trivial inertia.

## References

* A. Grothendieck, *Revêtements étales et groupe fondamental* (SGA 1), Exposé V, §2: the quotient
  of an affine scheme by a finite group is étale at the points with trivial inertia group.
* S. U. Chase, D. K. Harrison, A. Rosenberg, *Galois theory and Galois cohomology of commutative
  rings*, Mem. Amer. Math. Soc. 52 (1965), Theorem 1.3, for free actions.
-/

public section

namespace Ideal

variable {B G : Type*} [CommRing B] [Group G] [MulSemiringAction G B]

/-- At a prime `q` with trivial inertia, some element `t` lies in every displacement ideal
`J_g = (g • b - b)_b` with `g ≠ 1` and avoids every translate of `q`. -/
private theorem exists_mem_span_smul_sub_forall_smul_notMem [Finite G] (q : Ideal B) [q.IsPrime]
    (hq : q.inertia G = ⊥) :
    ∃ t : B, (∀ g : G, g ≠ 1 → t ∈ Ideal.span (Set.range fun b : B ↦ g • b - b)) ∧
      ∀ h : G, h • t ∉ q := by
  classical
  have := Fintype.ofFinite G
  -- Trivial inertia gives, for each `g ≠ 1`, an element whose displacement is not in `q`.
  have hdisp (g : G) (hg : g ≠ 1) : ∃ b : B, g • b - b ∉ q := by
    by_contra! h
    exact hg ((Subgroup.mem_bot (G := G)).mp (hq ▸ (Ideal.mem_inertia (G := G)).mpr h))
  choose b hb using hdisp
  set J : Ideal B := ⨅ g : {g : G // g ≠ 1}, Ideal.span (Set.range fun x : B ↦ g.1 • x - x)
  -- `J` is not contained in any of the primes `h⁻¹ • q`.
  have hJ (h : G) : ¬ J ≤ q.comap (MulSemiringAction.toRingHom G B h) := by
    intro hsub
    -- A finite intersection of ideals lies in a prime only if one of the ideals does.
    obtain ⟨g, -, hg⟩ := ((Ideal.comap_isPrime (MulSemiringAction.toRingHom G B h) q).inf_le'
      (s := (Finset.univ : Finset {g : G // g ≠ 1}))).mp (by rwa [Finset.inf_univ_eq_iInf])
    -- The displacement by `g` of `h⁻¹ • b_{h g h⁻¹}` is carried by `h` to a displacement by
    -- the conjugate `h g h⁻¹ ≠ 1`, which lies outside `q`.
    have hconj : h * g.1 * h⁻¹ ≠ 1 := fun h1 ↦ g.2 (by rwa [mul_inv_eq_one, mul_eq_left] at h1)
    have hx := Ideal.mem_comap.mp (hg (Ideal.subset_span ⟨h⁻¹ • b _ hconj, rfl⟩))
    refine hb _ hconj ?_
    simpa [smul_sub, mul_smul] using hx
  -- Prime avoidance for the finitely many primes `h⁻¹ • q`.
  obtain ⟨t, htJ, ht⟩ := q.exists_mem_forall_smul_notMem hJ
  exact ⟨t, fun g hg ↦ Ideal.mem_iInf.mp htJ ⟨g, hg⟩, ht⟩

/-- **Free actions near points with trivial inertia.** Let a finite group `G` act on `B` and let
`q` be a prime of `B` whose inertia group is trivial. Then there is an invariant `r` outside `q`
such that `G` acts freely on `B[1/r]`: for every `g ≠ 1`, the displacements `g • s - s` generate
the unit ideal of `B[1/r]`. -/
theorem exists_span_smul_sub_eq_top_of_inertia_eq_bot [Finite G] (q : Ideal B) [q.IsPrime]
    (hq : q.inertia G = ⊥) :
    ∃ r : FixedPoints.subring B G, (r : B) ∉ q ∧ ∀ g : G, g ≠ 1 →
      Ideal.span (Set.range fun s : Localization
        (Algebra.algebraMapSubmonoid B (Submonoid.powers r)) ↦ g • s - s) = ⊤ := by
  obtain ⟨t, htJ, ht⟩ := exists_mem_span_smul_sub_forall_smul_notMem q hq
  -- The norm `r = ∏_h h • t` is invariant, lies outside `q`, and is divisible by `t`.
  obtain ⟨r, hrq, htr⟩ := q.exists_notMem_dvd_of_forall_smul_notMem ht
  refine ⟨r, hrq, fun g hg ↦ ?_⟩
  let S := Localization (Algebra.algebraMapSubmonoid B (Submonoid.powers r))
  -- The image of `t` is a unit of `B[1/r]` lying in the ideal generated by displacements.
  have hunit : IsUnit (algebraMap B S t) := isUnit_of_dvd_unit (map_dvd _ htr)
    (IsLocalization.map_units S ⟨(r : B), Algebra.mem_algebraMapSubmonoid_of_mem
      ⟨r, Submonoid.mem_powers r⟩⟩)
  refine Ideal.eq_top_of_isUnit_mem _ ?_ hunit
  have hmap : (Ideal.span (Set.range fun b : B ↦ g • b - b)).map (algebraMap B S) ≤
      Ideal.span (Set.range fun s : S ↦ g • s - s) := by
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨b, rfl⟩, rfl⟩
    refine Ideal.subset_span ⟨algebraMap B S b, ?_⟩
    simp [S, map_sub]
  exact hmap (Ideal.mem_map_of_mem _ (htJ g hg))

/-- The invariant ring `Bᴳ` case of `Ideal.isEtaleAt_of_inertia_eq_bot`. -/
private theorem isEtaleAt_fixedPoints_of_inertia_eq_bot [Finite G] (q : Ideal B) [q.IsPrime]
    (hq : q.inertia G = ⊥) : Algebra.IsEtaleAt (FixedPoints.subring B G) q := by
  obtain ⟨r, hrq, hfree⟩ := exists_span_smul_sub_eq_top_of_inertia_eq_bot q hq
  let M := Submonoid.powers r
  let S := Localization (Algebra.algebraMapSubmonoid B M)
  let R' := FixedPoints.subring S G
  -- `B[1/r]` is étale over its invariants `Bᴳ[1/r]`, which are étale over `Bᴳ`.
  have : Algebra.Etale R' S := TauCeti.MulSemiringAction.etale hfree
  have : Algebra.FormallyEtale (FixedPoints.subring B G) R' := .of_isLocalization M
  have : IsScalarTower (FixedPoints.subring B G) R' S := .of_algebraMap_eq fun a ↦ by
    rw [IsScalarTower.algebraMap_apply (FixedPoints.subring B G) B S]
    exact (TauCeti.FixedPoints.coe_algebraMap_localization M a).symm
  have : Algebra.FormallyEtale (FixedPoints.subring B G) S := .comp _ R' _
  -- `B[1/r]` is the localization of `B` away from `r`.
  have : IsLocalization.Away (r : B) S := by
    have hM : Algebra.algebraMapSubmonoid B M = Submonoid.powers (r : B) :=
      Submonoid.map_powers _ r
    rw [IsLocalization.Away, ← hM]
    exact Localization.isLocalization
  have : Algebra.FormallyEtale (FixedPoints.subring B G) (Localization.Away (r : B)) :=
    .of_equiv ((IsLocalization.algEquiv (Submonoid.powers (r : B)) S
      (Localization.Away (r : B))).restrictScalars (FixedPoints.subring B G))
  exact Algebra.mem_etaleLocus_iff.mp (Algebra.basicOpen_subset_etaleLocus_iff.mpr this
    ((PrimeSpectrum.mem_basicOpen _ ⟨q, ‹_›⟩).mpr hrq))

/-- **The quotient by a finite group is étale at points with trivial inertia.** Let a finite
group `G` act on a commutative ring `B`, and let `R → B` be injective with image the invariants
`Bᴳ`, for instance `R = Bᴳ`. Then `B` is étale over `R` at every prime `q` of `B` whose inertia
group is trivial, that is, such that no `g ≠ 1` acts trivially on `B ⧸ q`. -/
theorem isEtaleAt_of_inertia_eq_bot {R : Type*} [CommRing R] [Algebra R B] [SMulCommClass G R B]
    [Algebra.IsInvariant R B G] [FaithfulSMul R B] [Finite G] (q : Ideal B) [q.IsPrime]
    (hq : q.inertia G = ⊥) : Algebra.IsEtaleAt R q := by
  have := isEtaleAt_fixedPoints_of_inertia_eq_bot q hq
  -- `R → Bᴳ` is an isomorphism.
  let e : R ≃+* FixedPoints.subring B G := RingEquiv.ofBijective
    ((algebraMap R B).codRestrict _ fun r g ↦ smul_algebraMap g r)
    ⟨fun _ _ h ↦ FaithfulSMul.algebraMap_injective R B (congrArg Subtype.val h), fun b ↦ by
      obtain ⟨r, hr⟩ := Algebra.IsInvariant.isInvariant (A := R) (b : B) b.2
      exact ⟨r, Subtype.ext hr⟩⟩
  let := e.toRingHom.toAlgebra
  -- `e` is by definition the corestriction of `R → B` to `Bᴳ`.
  have he (r : R) : (e r : B) = algebraMap R B r :=
    RingHom.codRestrict_apply (algebraMap R B) _ (fun r g ↦ smul_algebraMap g r) r
  have : IsScalarTower R (FixedPoints.subring B G) (Localization.AtPrime q) :=
    .of_algebraMap_eq fun r ↦ by
      rw [IsScalarTower.algebraMap_apply R B (Localization.AtPrime q),
        IsScalarTower.algebraMap_apply (FixedPoints.subring B G) B (Localization.AtPrime q)]
      simp [RingHom.algebraMap_toAlgebra, Algebra.algebraMap_ofSubsemiring_apply, he]
  have : Algebra.FormallyEtale R (FixedPoints.subring B G) :=
    .of_equiv (AlgEquiv.ofRingEquiv (f := e) fun r ↦ by simp [RingHom.algebraMap_toAlgebra])
  exact Algebra.FormallyEtale.comp R (FixedPoints.subring B G) (Localization.AtPrime q)

end Ideal
