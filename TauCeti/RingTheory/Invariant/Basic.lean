module

public import Mathlib.Algebra.Polynomial.Roots
public import Mathlib.RingTheory.Invariant.Basic

/-!
# Invariant rings and characteristic polynomials of group actions

The fixed subring and fixed subalgebra are invariant extensions, so the integral-extension
and prime-orbit theorems apply to them. We also record general consequences of the prime-orbit
theorem for contractions along invariant extensions.

Let a finite group `G` act on an integral domain `B`. Mathlib's
`MulSemiringAction.charpoly G b = ∏ g : G, (X - C (g • b))` is the monic polynomial whose roots
are the translates of `b`. When those translates are pairwise distinct, it divides every
polynomial vanishing on all of them. This is the step that turns "vanishes on the orbit" into
an explicit factorization, for instance when comparing the displacement of a generator of an
intermediate ring with a product of displacements of a generator of the top ring.

For a finite group `G` and an invariant extension `A → B`, the orbit polynomial of an element `b`
of a `G`-stable ideal `J` of `B` is `X ^ #G` modulo `J`, so `b ^ #G` lies in the ideal of `B`
generated by the invariants in `J`. Thus this ideal has the same radical as `J`. For the irrelevant
ideal of a polynomial ring over a reduced base, it shows that the irrelevant ideal is the radical
of the ideal generated by the invariants of positive degree.

## Main results

* The fixed-subring instance of `Algebra.IsInvariant` complements Mathlib's fixed-subalgebra
  instance.
* `Ideal.under_eq_iff_mem_orbit`: two primes have the same contraction to an invariant ring
  exactly when they lie in the same orbit.
* `Ideal.primesOver_under_eq_singleton_of_le_stabilizer`: a prime is alone above its contraction
  to the invariant ring of a subgroup fixing it.
* `Ideal.exists_smul_under_eq`: every prime of an intermediate ring above a base prime is the
  contraction of a translate of a chosen prime above it.
* `Ideal.card_primesOver_eq_index_stabilizer`: the primes above a base prime are counted by
  the index of the decomposition group of any one of them.
* `Ideal.pow_card_mem_map_under`, `Ideal.radical_map_under`: a `G`-stable ideal and the ideal
  generated by its invariants have the same radical.
* `TauCeti.smul_sum_smul`: the trace `∑ g, g • m` under a finite group is invariant.
* `TauCeti.MulSemiringAction.charpoly_dvd`: if `g ↦ g • b` is injective and `f` vanishes at every
  `g • b`, then `charpoly G b ∣ f`.
* `TauCeti.MulSemiringAction.eval_smul_charpoly`: evaluating `σ • charpoly H b` at `b` gives the
  product of the displacements `b - σ • τ • b`.
-/

public section

open Polynomial

namespace TauCeti.Algebra.IsInvariant

/-- The fixed subring is an invariant extension: every fixed element lies in its image. -/
instance (A G : Type*) [CommRing A] [Group G] [MulSemiringAction G A] :
    Algebra.IsInvariant (FixedPoints.subring A G) A G where
  isInvariant a ha := ⟨⟨a, ha⟩, rfl⟩

end TauCeti.Algebra.IsInvariant

namespace Ideal

open MulAction
open scoped Pointwise

variable {A B G : Type*} [CommRing A] [CommRing B] [Algebra A B]
  [Group G] [MulSemiringAction G B]

section Fibres

variable (Q : Ideal B) [Q.IsPrime] (H : Subgroup G) (C : Type*) [CommRing C] [Algebra C B]
  [Finite H] [Algebra.IsInvariant C B H] [SMulCommClass H C B]

/-- **Same contraction means same `H`-orbit.** Two primes of `B` contract to the same prime of
the `H`-invariant ring `C` exactly when one is an `H`-translate of the other. -/
theorem under_eq_iff_mem_orbit (R R' : Ideal B) [R.IsPrime] [R'.IsPrime] :
    R.under C = R'.under C ↔ R ∈ orbit H R' := by
  rw [mem_orbit_iff]
  constructor
  · intro h
    obtain ⟨h, hh⟩ := Algebra.IsInvariant.exists_smul_of_under_eq C B H R' R h.symm
    exact ⟨h, hh.symm⟩
  · rintro ⟨h, rfl⟩
    exact under_smul (G := H) C R' h

variable {H} in
/-- **A prime is alone above its contraction to the invariant ring of a subgroup fixing it.**
If `H` lies in the stabilizer of `Q`, then `Q` is the only prime of `B` above `Q ∩ C`: the other
primes above it are the `H`-translates of `Q`, which all equal `Q`. -/
theorem primesOver_under_eq_singleton_of_le_stabilizer (hH : H ≤ stabilizer G Q) :
    (Q.under C).primesOver B = {Q} := by
  refine Set.eq_singleton_iff_unique_mem.2 ⟨⟨inferInstance, inferInstance⟩, ?_⟩
  rintro R ⟨_, hR⟩
  obtain ⟨h, rfl⟩ := mem_orbit_iff.1 ((under_eq_iff_mem_orbit H C R Q).1 hR.over.symm)
  exact mem_stabilizer_iff.1 (hH h.2)

end Fibres

section Lifting

variable [Finite G] [Algebra.IsInvariant A B G] [SMulCommClass G A B]
  (Q : Ideal B) [Q.IsPrime] (p : Ideal A) [Q.LiesOver p]
  (C : Type*) [CommRing C] [Algebra A C] [Algebra C B] [IsScalarTower A C B]
  [FaithfulSMul C B]

variable (G) in
/-- **Every prime of `C` above `p` is the contraction of a translate of `Q`**, for any ring `C`
between `A` and `B`. -/
theorem exists_smul_under_eq (q : Ideal C) [q.IsPrime] [q.LiesOver p] :
    ∃ σ : G, (σ • Q).under C = q := by
  have := Algebra.IsInvariant.isIntegral A B G
  have := Algebra.IsIntegral.tower_top (R := A) (S := C) (T := B)
  -- Lift `q` to a prime `R` of `B`; transitivity of `G` on the primes above `p` makes `R` a
  -- translate of `Q`.
  obtain ⟨⟨R, hR, hRq⟩⟩ := q.nonempty_primesOver (S := B)
  have : R.LiesOver p := LiesOver.trans R q p
  have hRp : R ∈ p.primesOver B := ⟨hR, inferInstance⟩
  rw [← Algebra.IsInvariant.orbit_eq_primesOver A B G p Q, mem_orbit_iff] at hRp
  obtain ⟨σ, hσ⟩ := hRp
  exact ⟨σ, by rw [hσ]; exact hRq.over.symm⟩

/-- **The Galois count.** The primes of `B` above `p` are counted by the index `[G : D]` of the
decomposition group `D` of `Q`. -/
theorem card_primesOver_eq_index_stabilizer :
    Nat.card (p.primesOver B) = (stabilizer G Q).index := by
  rw [index_stabilizer, ← Algebra.IsInvariant.orbit_eq_primesOver A B G p Q,
    Nat.card_coe_set_eq]

end Lifting

section Radical

variable (A G) [Finite G] [Algebra.IsInvariant A B G]

/-- **Stable ideals are nil over their contraction.** If an ideal `J` of `B` is stable under a
finite group `G`, then for every `b ∈ J` the power `b ^ #G` lies in the ideal of `B` generated by
the invariants in `J`: the lower coefficients of the orbit polynomial `∏ g, (X - C (g • b))` are
invariant and lie in `J`. -/
theorem pow_card_mem_map_under {J : Ideal B} (hJ : ∀ g : G, ∀ b ∈ J, g • b ∈ J) {b : B}
    (hb : b ∈ J) : b ^ Nat.card G ∈ (J.under A).map (algebraMap A B) := by
  cases nonempty_fintype G
  -- Modulo `J` every translate of `b` vanishes, so the orbit polynomial reduces to `X ^ #G`;
  -- hence the coefficients of `charpoly G b - X ^ #G` lie in `J`, and they are invariant.
  have hr (i : ℕ) : (MulSemiringAction.charpoly G b - X ^ Nat.card G).coeff i ∈
      (J.under A).map (algebraMap A B) := by
    obtain ⟨a, ha⟩ := Algebra.IsInvariant.isInvariant (A := A) (G := G) _ fun g ↦ by
      rw [← coeff_smul g (MulSemiringAction.charpoly G b - X ^ Nat.card G), smul_sub,
        MulSemiringAction.smul_charpoly, smul_pow', smul_X]
    have hJi : (MulSemiringAction.charpoly G b - X ^ Nat.card G).coeff i ∈ J := by
      rw [← Quotient.eq_zero_iff_mem, ← coeff_map]
      simp [MulSemiringAction.charpoly_eq, Polynomial.map_prod,
        Quotient.eq_zero_iff_mem.2 (hJ _ _ hb), Nat.card_eq_fintype_card]
    rw [← ha] at hJi ⊢
    exact mem_map_of_mem _ ((mem_under A J).2 hJi)
  have h : b ^ Nat.card G = -(MulSemiringAction.charpoly G b - X ^ Nat.card G).eval b := by
    rw [eval_sub, MulSemiringAction.eval_charpoly, eval_pow, eval_X, zero_sub, neg_neg]
  rw [h, eval_eq_sum, Polynomial.sum_def]
  exact neg_mem <| Ideal.sum_mem _ fun i _ ↦ mul_mem_right _ _ (hr i)

/-- The radical of the ideal generated by the invariants in a `G`-stable ideal `J` is the radical
of `J`. -/
theorem radical_map_under {J : Ideal B} (hJ : ∀ g : G, ∀ b ∈ J, g • b ∈ J) :
    ((J.under A).map (algebraMap A B)).radical = J.radical :=
  le_antisymm (radical_mono map_comap_le) <| radical_le_radical_iff.2 fun _ hb ↦
    ⟨_, pow_card_mem_map_under A G hJ hb⟩

end Radical

end Ideal

namespace TauCeti

/-- The trace `∑ g, g • m` of an element under a finite group is invariant. -/
theorem smul_sum_smul {G M : Type*} [Group G] [Fintype G] [AddCommMonoid M]
    [DistribMulAction G M] (h : G) (m : M) :
    h • ∑ g : G, g • m = ∑ g : G, g • m := by
  rw [Finset.smul_sum]
  simp_rw [smul_smul]
  exact Fintype.sum_equiv (Equiv.mulLeft h) _ _ fun _ ↦ rfl

end TauCeti

namespace TauCeti.MulSemiringAction

section

variable {G B : Type*} [Group G] [Fintype G] [CommRing B] [IsDomain B] [MulSemiringAction G B]

/-- The characteristic polynomial of a point with pairwise distinct translates divides every
polynomial vanishing on its orbit. -/
theorem charpoly_dvd {b : B} (hb : Function.Injective fun g : G ↦ g • b) {f : B[X]}
    (hf : ∀ g : G, f.eval (g • b) = 0) : MulSemiringAction.charpoly G b ∣ f := by
  rcases eq_or_ne f 0 with rfl | hf0
  · exact dvd_zero _
  convert (Multiset.prod_X_sub_C_dvd_iff_le_roots hf0 _).2
    ((Multiset.le_iff_subset (Finset.univ.nodup.map hb)).2 fun a ha ↦ ?_)
  · simp [MulSemiringAction.charpoly_eq]
  obtain ⟨g, -, rfl⟩ := Multiset.mem_map.1 ha
  exact (mem_roots hf0).2 (hf g)

end

variable {G H B : Type*} [Monoid G] [Group H] [Fintype H] [CommRing B]
  [MulSemiringAction G B] [MulSemiringAction H B]

/-- Evaluating a transformed characteristic polynomial at the point gives the product of its
displacements: `(σ • charpoly H b)(b) = ∏ τ, (b - σ • τ • b)`. -/
theorem eval_smul_charpoly (σ : G) (b : B) :
    (σ • MulSemiringAction.charpoly H b).eval b = ∏ τ : H, (b - σ • τ • b) := by
  simp [MulSemiringAction.charpoly_eq, Finset.smul_prod', eval_prod, smul_sub, smul_C]

end TauCeti.MulSemiringAction
