/-!
# Fixed-point ideals and Edixhoven's smoothness theorem

Let `Γ` be a monoid acting on a commutative ring `A` by ring endomorphisms
(`MulSemiringAction Γ A`). This file introduces the **fixed-point ideal**
`TauCeti.MulSemiringAction.fixedPointIdeal Γ A`, generated by the displacements `γ • a - a` for
`γ : Γ` and `a : A`.

A ring homomorphism out of `A` kills `fixedPointIdeal Γ A` precisely when it is `Γ`-invariant
(`TauCeti.MulSemiringAction.fixedPointIdeal_le_ker_iff`). Geometrically, when `A` is a commutative
`R`-algebra and `Γ` acts by `R`-algebra endomorphisms, the quotient `A ⧸ fixedPointIdeal Γ A` is the
coordinate ring of the closed subscheme `(Spec A)^Γ` of fixed points: for every `R`-algebra `B`,
`R`-algebra homomorphisms `A ⧸ fixedPointIdeal Γ A →ₐ[R] B` correspond bijectively to `Γ`-fixed
points in `A →ₐ[R] B` (`TauCeti.MulSemiringAction.quotientFixedPointIdealAlgHomEquiv`). This is
distinct from the invariant subalgebra `MulSemiringAction.FixedPoints.subalgebra R A Γ`, which is
the coordinate ring of the coarse quotient rather than of the fixed-point subscheme.

Two finiteness and smoothness results hold over an arbitrary base ring `R`, with no Noetherian
hypothesis:

* **Finite generation and finite presentation.** Because
  `γ • (a * b) - a * b = (γ • a - a) * (γ • b) + a * (γ • b - b)`, the elements whose
  `Γ`-displacements lie in a given ideal of `A` form a subalgebra. Consequently, if `A` is generated
  as an `R`-algebra by a set `S`, then `fixedPointIdeal Γ A` is generated as an ideal by the
  displacements of `S` (`TauCeti.MulSemiringAction.fixedPointIdeal_eq_span_of_adjoin_eq_top`). When
  `Γ` is finite and `A` is of finite type (respectively, finitely presented) over `R`, the
  fixed-point ideal is finitely generated (`TauCeti.MulSemiringAction.fixedPointIdeal_fg`) and the
  fixed-point quotient is finitely presented
  (`TauCeti.MulSemiringAction.finitePresentation_quotient_fixedPointIdeal`).
* **Edixhoven's formal smoothness and smoothness theorems.** Suppose `Γ` is a finite group whose
  order `#Γ` is invertible in `R`, and `A` is formally smooth over `R`. Given an `R`-algebra map
  `f : A ⧸ fixedPointIdeal Γ A →ₐ[R] C ⧸ J` with `J ^ 2 = ⊥`, formal smoothness of `A` supplies a
  lift `φ : A →ₐ[R] C` whose displacements `d_γ(a) = φ(γ • a) - φ(a)` lie in `J`. Since
  `J ^ 2 = ⊥`, each `d_γ` satisfies the `φ`-derivation identity
  `d_γ(a * b) = φ(a) d_γ(b) + d_γ(a) φ(b)`, so the Reynolds average
  `ψ(a) = (#Γ)⁻¹ • ∑ᶠ γ, φ(γ • a)` (`TauCeti.MulSemiringAction.reynoldsAlgHom`) is a `Γ`-invariant
  `R`-algebra homomorphism lifting `f`. Thus `A ⧸ fixedPointIdeal Γ A` is formally smooth
  (`TauCeti.MulSemiringAction.formallySmooth_quotient_fixedPointIdeal`), and smooth whenever `A` is
  smooth (`TauCeti.MulSemiringAction.smooth_quotient_fixedPointIdeal`).

## Main definitions

* `TauCeti.MulSemiringAction.fixedPointIdeal`: the ideal generated by `γ • a - a`.
* `TauCeti.MulSemiringAction.quotientFixedPointIdealAlgHomEquiv`: the universal bijection between
  `R`-algebra maps out of `A ⧸ fixedPointIdeal Γ A` and `Γ`-invariant `R`-algebra maps out of `A`.
* `TauCeti.MulSemiringAction.reynoldsAlgHom`: the Reynolds average of a homomorphism that is
  `Γ`-invariant modulo a square-zero ideal, as an `R`-algebra homomorphism.

## Main results

* `TauCeti.MulSemiringAction.fixedPointIdeal_le_ker_iff`: universal property for ring homomorphisms.
* `TauCeti.MulSemiringAction.fixedPointIdeal_fg` and
  `TauCeti.MulSemiringAction.finitePresentation_quotient_fixedPointIdeal`: finite generation of the
  fixed-point ideal and finite presentation of its quotient for finite `Γ`.
* `TauCeti.MulSemiringAction.formallySmooth_quotient_fixedPointIdeal` and
  `TauCeti.MulSemiringAction.smooth_quotient_fixedPointIdeal`: Edixhoven's formal smoothness and
  smoothness theorems for fixed-point quotients under finite groups of invertible order.

## References

* B. Edixhoven, *Néron models and tame ramification*, Compositio Math. 81 (1992), Proposition 3.1
  (p. 293) and Proposition 3.4 (pp. 294–295).
-/

public section

namespace TauCeti.MulSemiringAction

universe u v w x

section Basic

variable (Γ : Type v) (A : Type w) [Monoid Γ] [CommRing A] [_root_.MulSemiringAction Γ A]

/-- The **fixed-point ideal** of a monoid `Γ` acting on a commutative ring `A` by ring
endomorphisms: the ideal generated by all displacements `γ • a - a`. When `A` is a commutative
`R`-algebra on which `Γ` acts by `R`-algebra endomorphisms, `A ⧸ fixedPointIdeal Γ A` represents the
closed subscheme `(Spec A)^Γ` of `Γ`-fixed points. -/
def fixedPointIdeal : Ideal A :=
  Ideal.span {x : A | ∃ (γ : Γ) (a : A), γ • a - a = x}

variable {Γ A}

/-- Explicit span formula for `fixedPointIdeal`. -/
theorem fixedPointIdeal_def :
    fixedPointIdeal Γ A = Ideal.span {x : A | ∃ (γ : Γ) (a : A), γ • a - a = x} :=
  (rfl)

/-- Every displacement `γ • a - a` belongs to the fixed-point ideal. -/
theorem smul_sub_mem_fixedPointIdeal (γ : Γ) (a : A) :
    γ • a - a ∈ fixedPointIdeal Γ A :=
  Ideal.subset_span ⟨γ, a, rfl⟩

/-- Every opposite displacement `a - γ • a` belongs to the fixed-point ideal. -/
theorem sub_smul_mem_fixedPointIdeal (γ : Γ) (a : A) :
    a - γ • a ∈ fixedPointIdeal Γ A := by
  rw [← neg_sub]
  exact neg_mem (smul_sub_mem_fixedPointIdeal γ a)

/-- In the quotient by `fixedPointIdeal Γ A`, the action of `Γ` becomes trivial. -/
@[simp]
theorem mk_fixedPointIdeal_smul (γ : Γ) (a : A) :
    Ideal.Quotient.mk (fixedPointIdeal Γ A) (γ • a) =
      Ideal.Quotient.mk (fixedPointIdeal Γ A) a :=
  Ideal.Quotient.eq.mpr (smul_sub_mem_fixedPointIdeal γ a)

/-- The fixed-point ideal is the smallest ideal containing all displacements `γ • a - a`. -/
theorem fixedPointIdeal_le_iff {I : Ideal A} :
    fixedPointIdeal Γ A ≤ I ↔ ∀ (γ : Γ) (a : A), γ • a - a ∈ I := by
  rw [fixedPointIdeal_def, Ideal.span_le]
  constructor
  · intro h γ a
    exact h ⟨γ, a, rfl⟩
  · rintro h _ ⟨γ, a, rfl⟩
    exact h γ a

/-- **Universal property of the fixed-point ideal**: a ring homomorphism out of `A` kills
`fixedPointIdeal Γ A` if and only if it is `Γ`-invariant. -/
theorem fixedPointIdeal_le_ker_iff {B : Type x} [Ring B] (f : A →+* B) :
    fixedPointIdeal Γ A ≤ RingHom.ker f ↔ ∀ (γ : Γ) (a : A), f (γ • a) = f a := by
  rw [fixedPointIdeal_le_iff]
  refine forall₂_congr fun γ a ↦ ?_
  rw [RingHom.mem_ker, map_sub, sub_eq_zero]

/-- The fixed-point ideal vanishes if and only if `Γ` acts trivially on `A`. -/
@[simp]
theorem fixedPointIdeal_eq_bot_iff :
    fixedPointIdeal Γ A = ⊥ ↔ ∀ (γ : Γ) (a : A), γ • a = a := by
  rw [← le_bot_iff, fixedPointIdeal_le_iff]
  refine forall₂_congr fun γ a ↦ ?_
  rw [Ideal.mem_bot, sub_eq_zero]

/-- A subsingleton monoid acts trivially, so its fixed-point ideal is `⊥`. -/
@[simp]
theorem fixedPointIdeal_of_subsingleton [Subsingleton Γ] :
    fixedPointIdeal Γ A = ⊥ :=
  fixedPointIdeal_eq_bot_iff.mpr fun γ a ↦ by
    rw [Subsingleton.elim γ 1, one_smul]

end Basic

section Algebra

variable {R : Type u} {Γ : Type v} {A : Type w} [CommSemiring R] [Monoid Γ] [CommRing A]
  [Algebra R A] [_root_.MulSemiringAction Γ A]

/-- An `R`-algebra homomorphism out of `A` kills `fixedPointIdeal Γ A` if and only if it is
`Γ`-invariant on elements. -/
theorem fixedPointIdeal_le_ker_algHom_iff {B : Type x} [Ring B] [Algebra R B] (f : A →ₐ[R] B) :
    fixedPointIdeal Γ A ≤ RingHom.ker f ↔ ∀ (γ : Γ) (a : A), f (γ • a) = f a :=
  fixedPointIdeal_le_ker_iff f.toRingHom

/-- When `Γ` acts by `R`-algebra endomorphisms, an `R`-algebra map kills `fixedPointIdeal Γ A`
if and only if precomposing it with each `γ : Γ` leaves it unchanged. -/
theorem fixedPointIdeal_le_ker_iff_comp_toAlgHom_eq [SMulCommClass Γ R A]
    {B : Type x} [CommRing B] [Algebra R B] (f : A →ₐ[R] B) :
    fixedPointIdeal Γ A ≤ RingHom.ker f ↔
      ∀ γ : Γ, f.comp (_root_.MulSemiringAction.toAlgHom R A γ) = f := by
  rw [fixedPointIdeal_le_ker_algHom_iff]
  refine forall_congr' fun γ ↦ ?_
  rw [AlgHom.ext_iff]
  rfl

/-- In the quotient `A ⧸ fixedPointIdeal Γ A`, the canonical `R`-algebra projection is
`Γ`-invariant. -/
@[simp]
theorem mkₐ_fixedPointIdeal_smul (γ : Γ) (a : A) :
    Ideal.Quotient.mkₐ R (fixedPointIdeal Γ A) (γ • a) =
      Ideal.Quotient.mkₐ R (fixedPointIdeal Γ A) a :=
  mk_fixedPointIdeal_smul γ a

variable (R Γ A) in
/-- **Representability of fixed points on affine schemes** (Edixhoven, Proposition 3.1):
`R`-algebra homomorphisms out of `A ⧸ fixedPointIdeal Γ A` into `B` correspond bijectively to
`Γ`-invariant `R`-algebra homomorphisms `A →ₐ[R] B`. -/
def quotientFixedPointIdealAlgHomEquiv (B : Type x) [CommRing B] [Algebra R B] :
    (A ⧸ fixedPointIdeal Γ A →ₐ[R] B) ≃ {f : A →ₐ[R] B // ∀ (γ : Γ) (a : A), f (γ • a) = f a} where
  toFun g := ⟨g.comp (Ideal.Quotient.mkₐ R (fixedPointIdeal Γ A)), fun γ a ↦ by
    rw [AlgHom.comp_apply, AlgHom.comp_apply, mkₐ_fixedPointIdeal_smul]⟩
  invFun f := Ideal.Quotient.liftₐ (fixedPointIdeal Γ A) f.1 fun a ha ↦
    (fixedPointIdeal_le_ker_algHom_iff f.1).mpr f.2 ha
  left_inv g := Ideal.Quotient.algHom_ext R rfl
  right_inv f := Subtype.ext (Ideal.Quotient.liftₐ_comp (fixedPointIdeal Γ A) f.1 _)

/-- Forward direction of `quotientFixedPointIdealAlgHomEquiv`: precomposition with the quotient
map. -/
@[simp]
theorem quotientFixedPointIdealAlgHomEquiv_apply {B : Type x} [CommRing B] [Algebra R B]
    (g : A ⧸ fixedPointIdeal Γ A →ₐ[R] B) :
    (quotientFixedPointIdealAlgHomEquiv R Γ A B g).1 =
      g.comp (Ideal.Quotient.mkₐ R (fixedPointIdeal Γ A)) :=
  (rfl)

/-- Inverse direction of `quotientFixedPointIdealAlgHomEquiv` evaluated on a quotient class. -/
@[simp]
theorem quotientFixedPointIdealAlgHomEquiv_symm_apply_mk {B : Type x} [CommRing B] [Algebra R B]
    (f : {f : A →ₐ[R] B // ∀ (γ : Γ) (a : A), f (γ • a) = f a}) (a : A) :
    (quotientFixedPointIdealAlgHomEquiv R Γ A B).symm f
        (Ideal.Quotient.mk (fixedPointIdeal Γ A) a) = f.1 a :=
  (rfl)

/-! ### Finite generation and finite presentation -/

/-- If `S` generates `A` as an `R`-algebra and `Γ` acts by `R`-algebra endomorphisms, then
`fixedPointIdeal Γ A` is already generated as an ideal by the displacements `γ • s - s` for
`γ : Γ` and `s ∈ S`. -/
theorem fixedPointIdeal_eq_span_of_adjoin_eq_top [SMulCommClass Γ R A] {S : Set A}
    (hS : Algebra.adjoin R S = ⊤) :
    fixedPointIdeal Γ A = Ideal.span {x : A | ∃ (γ : Γ), ∃ s ∈ S, γ • s - s = x} := by
  set J : Ideal A := Ideal.span {x : A | ∃ (γ : Γ), ∃ s ∈ S, γ • s - s = x}
  refine le_antisymm ?_ (Ideal.span_mono fun _ ⟨γ, s, _, h⟩ ↦ ⟨γ, s, h⟩)
  -- Elements whose `Γ`-displacements lie in `J` form an `R`-subalgebra containing `S`.
  let A₀ : Subalgebra R A :=
    { carrier := {a : A | ∀ γ : Γ, γ • a - a ∈ J}
      mul_mem' {a b} ha hb γ := by
        have key : γ • (a * b) - a * b = (γ • a - a) * (γ • b) + a * (γ • b - b) := by
          rw [smul_mul']
          ring
        rw [key]
        exact J.add_mem (J.mul_mem_right (γ • b) (ha γ)) (J.mul_mem_left a (hb γ))
      one_mem' γ := by simp only [smul_one, sub_self, J.zero_mem]
      add_mem' {a b} ha hb γ := by
        have key : γ • (a + b) - (a + b) = (γ • a - a) + (γ • b - b) := by
          rw [smul_add]
          abel
        rw [key]
        exact J.add_mem (ha γ) (hb γ)
      zero_mem' γ := by simp only [smul_zero, sub_self, J.zero_mem]
      algebraMap_mem' r γ := by
        rw [Algebra.algebraMap_eq_smul_one, smul_comm, smul_one, sub_self]
        exact J.zero_mem }
  have htop : A₀ = ⊤ := eq_top_iff.mpr (hS ▸ Algebra.adjoin_le fun s hs γ ↦
    Ideal.subset_span ⟨γ, s, hs, rfl⟩)
  refine fixedPointIdeal_le_iff.mpr fun γ a ↦ ?_
  have ha : a ∈ A₀ := htop ▸ Algebra.mem_top
  exact ha γ

/-- **Finite generation of the fixed-point ideal**: when `Γ` is finite and `A` is a finite-type
`R`-algebra, `fixedPointIdeal Γ A` is a finitely generated ideal of `A`, with no Noetherian
assumption on `R`. -/
theorem fixedPointIdeal_fg [SMulCommClass Γ R A] [Finite Γ] [Algebra.FiniteType R A] :
    (fixedPointIdeal Γ A).FG := by
  obtain ⟨S, hS⟩ := Algebra.FiniteType.out (R := R) (A := A)
  rw [fixedPointIdeal_eq_span_of_adjoin_eq_top (R := R) hS]
  have hfin : ({x : A | ∃ (γ : Γ), ∃ s ∈ (S : Set A), γ • s - s = x}).Finite := by
    refine ((Set.finite_univ (α := Γ)).prod S.finite_toSet).image
      (fun p : Γ × A ↦ p.1 • p.2 - p.2) |>.subset ?_
    rintro _ ⟨γ, s, hs, rfl⟩
    exact ⟨(γ, s), ⟨Set.mem_univ γ, hs⟩, rfl⟩
  exact Submodule.fg_span hfin

/-- When `Γ` is finite and `A` is finitely presented over `R`, the fixed-point quotient
`A ⧸ fixedPointIdeal Γ A` is finitely presented over `R`. -/
instance finitePresentation_quotient_fixedPointIdeal {R : Type u} [CommRing R] [Algebra R A]
    [SMulCommClass Γ R A] [Finite Γ] [Algebra.FinitePresentation R A] :
    Algebra.FinitePresentation R (A ⧸ fixedPointIdeal Γ A) :=
  Algebra.FinitePresentation.quotient (fixedPointIdeal_fg (R := R))

end Algebra

/-! ### Reynolds averaging on first-order lifts and Edixhoven's smoothness theorem -/

section Smooth

variable {R : Type u} {Γ : Type v} {A : Type w} [CommRing R] [CommRing A] [Algebra R A]
  [Group Γ] [Finite Γ] [_root_.MulSemiringAction Γ A] [SMulCommClass Γ R A]

section Reynolds

variable [Invertible (Nat.card Γ : R)]
variable {C : Type x} [CommRing C] [Algebra R C]

/-- Underlying `R`-linear Reynolds average `a ↦ (#Γ)⁻¹ • ∑ᶠ γ, φ(γ • a)` of an `R`-algebra map
`φ : A →ₐ[R] C`. -/
private noncomputable def reynoldsLinearMap (φ : A →ₐ[R] C) : A →ₗ[R] C where
  toFun a := ⅟(Nat.card Γ : R) • ∑ᶠ γ : Γ, φ (γ • a)
  map_add' a b := by
    cases nonempty_fintype Γ
    simp only [finsum_eq_sum_of_fintype, smul_add, map_add, Finset.sum_add_distrib]
  map_smul' r a := by
    cases nonempty_fintype Γ
    simp only [finsum_eq_sum_of_fintype, RingHom.id_apply, smul_comm _ r a, map_smul,
      ← Finset.smul_sum, smul_comm (⅟(Nat.card Γ : R)) r]

/-- The displacement `reynoldsLinearMap φ a - φ a` is the Reynolds average of the individual
displacements `φ(γ • a) - φ(a)`. -/
private theorem reynoldsLinearMap_sub_apply (φ : A →ₐ[R] C) (a : A) :
    reynoldsLinearMap (Γ := Γ) φ a - φ a =
      ⅟(Nat.card Γ : R) • ∑ᶠ γ : Γ, (φ (γ • a) - φ a) := by
  cases nonempty_fintype Γ
  simp only [reynoldsLinearMap, LinearMap.coe_mk, AddHom.coe_mk, finsum_eq_sum_of_fintype,
    Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
    smul_sub]
  congr 1
  rw [← Nat.cast_smul_eq_nsmul R, smul_smul, invOf_mul_self, one_smul]

/-- If every displacement `φ(γ • a) - φ(a)` lies in an ideal `J`, so does the averaged
displacement `reynoldsLinearMap φ a - φ a`. -/
private theorem reynoldsLinearMap_sub_mem {J : Ideal C} (φ : A →ₐ[R] C)
    (hφ : ∀ (γ : Γ) (a : A), φ (γ • a) - φ a ∈ J) (a : A) :
    reynoldsLinearMap (Γ := Γ) φ a - φ a ∈ J := by
  cases nonempty_fintype Γ
  rw [reynoldsLinearMap_sub_apply, finsum_eq_sum_of_fintype, Algebra.smul_def]
  exact J.mul_mem_left _ (Submodule.sum_mem J fun γ _ ↦ hφ γ a)

/-- When `J ^ 2 = ⊥` and every `φ(γ • a) - φ(a) ∈ J`, the averaged displacement
`δ(a) = reynoldsLinearMap φ a - φ a` is a `φ`-derivation. -/
private theorem reynoldsLinearMap_sub_mul {J : Ideal C} (hJ : J ^ 2 = ⊥) (φ : A →ₐ[R] C)
    (hφ : ∀ (γ : Γ) (a : A), φ (γ • a) - φ a ∈ J) (a b : A) :
    reynoldsLinearMap (Γ := Γ) φ (a * b) - φ (a * b) =
      φ a * (reynoldsLinearMap (Γ := Γ) φ b - φ b) +
        (reynoldsLinearMap (Γ := Γ) φ a - φ a) * φ b := by
  cases nonempty_fintype Γ
  have hleib (γ : Γ) :
      φ (γ • (a * b)) - φ (a * b) =
        φ a * (φ (γ • b) - φ b) + (φ (γ • a) - φ a) * φ b := by
    have hprod : (φ (γ • a) - φ a) * (φ (γ • b) - φ b) = 0 :=
      Ideal.mem_bot.mp (hJ ▸ pow_two J ▸ Ideal.mul_mem_mul (hφ γ a) (hφ γ b))
    calc
      φ (γ • (a * b)) - φ (a * b)
          = φ a * (φ (γ • b) - φ b) + (φ (γ • a) - φ a) * φ b +
              (φ (γ • a) - φ a) * (φ (γ • b) - φ b) := by
            rw [smul_mul', map_mul, map_mul]
            ring
      _ = φ a * (φ (γ • b) - φ b) + (φ (γ • a) - φ a) * φ b := by rw [hprod, add_zero]
  simp only [reynoldsLinearMap_sub_apply, finsum_eq_sum_of_fintype, hleib,
    Finset.sum_add_distrib, smul_add, ← Finset.mul_sum, ← Finset.sum_mul, mul_smul_comm,
    smul_mul_assoc]

/-- **Reynolds averaging of a first-order lift**: if `φ : A →ₐ[R] C` is `Γ`-invariant modulo a
square-zero ideal `J` (`J ^ 2 = ⊥`), then `a ↦ (#Γ)⁻¹ • ∑ᶠ γ, φ(γ • a)` is an `R`-algebra
homomorphism `A →ₐ[R] C`. -/
noncomputable def reynoldsAlgHom {J : Ideal C} (hJ : J ^ 2 = ⊥) (φ : A →ₐ[R] C)
    (hφ : ∀ (γ : Γ) (a : A), φ (γ • a) - φ a ∈ J) : A →ₐ[R] C :=
  AlgHom.ofLinearMap (reynoldsLinearMap (Γ := Γ) φ)
    (by
      cases nonempty_fintype Γ
      simp only [reynoldsLinearMap, LinearMap.coe_mk, AddHom.coe_mk, finsum_eq_sum_of_fintype,
        smul_one, map_one, Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card]
      rw [← Nat.cast_smul_eq_nsmul R, smul_smul, invOf_mul_self, one_smul])
    (fun a b ↦ by
      let δ : A → C := fun x ↦ reynoldsLinearMap (Γ := Γ) φ x - φ x
      have hδ : δ a * δ b = 0 :=
        Ideal.mem_bot.mp (hJ ▸ pow_two J ▸ Ideal.mul_mem_mul
          (reynoldsLinearMap_sub_mem φ hφ a) (reynoldsLinearMap_sub_mem φ hφ b))
      have hmul : δ (a * b) = φ a * δ b + δ a * φ b := reynoldsLinearMap_sub_mul hJ φ hφ a b
      have hexp (x : A) : reynoldsLinearMap (Γ := Γ) φ x = φ x + δ x := (add_sub_cancel _ _).symm
      rw [hexp (a * b), hexp a, hexp b]
      calc
        φ (a * b) + δ (a * b) = φ a * φ b + (φ a * δ b + δ a * φ b) := by rw [map_mul, hmul]
        _ = (φ a + δ a) * (φ b + δ b) := by
          trans φ a * φ b + (φ a * δ b + δ a * φ b) + δ a * δ b
          · rw [hδ, add_zero]
          · ring)

/-- Explicit formula for `reynoldsAlgHom`. -/
theorem reynoldsAlgHom_apply {J : Ideal C} (hJ : J ^ 2 = ⊥) (φ : A →ₐ[R] C)
    (hφ : ∀ (γ : Γ) (a : A), φ (γ • a) - φ a ∈ J) (a : A) :
    reynoldsAlgHom hJ φ hφ a = ⅟(Nat.card Γ : R) • ∑ᶠ γ : Γ, φ (γ • a) :=
  (rfl)

/-- Finite-sum formula for `reynoldsAlgHom` when `Γ` carries a `Fintype` instance. -/
theorem reynoldsAlgHom_apply_fintype [Fintype Γ] {J : Ideal C} (hJ : J ^ 2 = ⊥) (φ : A →ₐ[R] C)
    (hφ : ∀ (γ : Γ) (a : A), φ (γ • a) - φ a ∈ J) (a : A) :
    reynoldsAlgHom hJ φ hφ a = ⅟(Nat.card Γ : R) • ∑ γ : Γ, φ (γ • a) := by
  rw [reynoldsAlgHom_apply, finsum_eq_sum_of_fintype]

/-- The Reynolds average `reynoldsAlgHom` is `Γ`-invariant. -/
@[simp]
theorem reynoldsAlgHom_smul {J : Ideal C} (hJ : J ^ 2 = ⊥) (φ : A →ₐ[R] C)
    (hφ : ∀ (γ : Γ) (a : A), φ (γ • a) - φ a ∈ J) (τ : Γ) (a : A) :
    reynoldsAlgHom hJ φ hφ (τ • a) = reynoldsAlgHom hJ φ hφ a := by
  cases nonempty_fintype Γ
  simp only [reynoldsAlgHom_apply_fintype, ← mul_smul]
  congr 1
  exact Equiv.sum_comp (Equiv.mulRight τ) fun γ ↦ φ (γ • a)

/-- The Reynolds average `reynoldsAlgHom` agrees with `φ` modulo `J`. -/
theorem reynoldsAlgHom_sub_mem {J : Ideal C} (hJ : J ^ 2 = ⊥) (φ : A →ₐ[R] C)
    (hφ : ∀ (γ : Γ) (a : A), φ (γ • a) - φ a ∈ J) (a : A) :
    reynoldsAlgHom hJ φ hφ a - φ a ∈ J :=
  reynoldsLinearMap_sub_mem φ hφ a

/-- Composing `reynoldsAlgHom` with the quotient map `C →ₐ[R] C ⧸ J` recovers the reduction of
`φ`. -/
@[simp]
theorem mkₐ_comp_reynoldsAlgHom {J : Ideal C} (hJ : J ^ 2 = ⊥) (φ : A →ₐ[R] C)
    (hφ : ∀ (γ : Γ) (a : A), φ (γ • a) - φ a ∈ J) :
    (Ideal.Quotient.mkₐ R J).comp (reynoldsAlgHom hJ φ hφ) = (Ideal.Quotient.mkₐ R J).comp φ := by
  ext a
  exact Ideal.Quotient.eq.mpr (reynoldsAlgHom_sub_mem hJ φ hφ a)

end Reynolds

/-- **Edixhoven's formal smoothness theorem** (Proposition 3.4): if `A` is a formally smooth
`R`-algebra and `Γ` is a finite group of order invertible in `R` acting on `A` by `R`-algebra
automorphisms, then the fixed-point quotient `A ⧸ fixedPointIdeal Γ A` is formally smooth over
`R`. -/
instance formallySmooth_quotient_fixedPointIdeal [Algebra.FormallySmooth R A]
    [Invertible (Nat.card Γ : R)] :
    Algebra.FormallySmooth R (A ⧸ fixedPointIdeal Γ A) := by
  refine Algebra.FormallySmooth.of_comp_surjective fun C _ _ J hJ f ↦ ?_
  -- Lift the given invariant point across `C → C ⧸ J` to an arbitrary `R`-algebra map `φ`.
  obtain ⟨φ, hφ⟩ := Algebra.FormallySmooth.comp_surjective R A J hJ
    (f.comp (Ideal.Quotient.mkₐ R (fixedPointIdeal Γ A)))
  have hφJ (γ : Γ) (a : A) : φ (γ • a) - φ a ∈ J := by
    rw [← Ideal.Quotient.eq, ← Ideal.Quotient.mkₐ_eq_mk R, ← AlgHom.comp_apply,
      ← AlgHom.comp_apply, hφ, AlgHom.comp_apply, AlgHom.comp_apply, mkₐ_fixedPointIdeal_smul]
  -- Average `φ` over `Γ` to make the lift `Γ`-invariant without changing its reduction mod `J`.
  let ψ := reynoldsAlgHom (Γ := Γ) hJ φ hφJ
  have hψ : fixedPointIdeal Γ A ≤ RingHom.ker ψ :=
    (fixedPointIdeal_le_ker_algHom_iff ψ).mpr (reynoldsAlgHom_smul hJ φ hφJ)
  refine ⟨Ideal.Quotient.liftₐ (fixedPointIdeal Γ A) ψ fun a ha ↦ RingHom.mem_ker.mp (hψ ha),
    Ideal.Quotient.algHom_ext R ?_⟩
  rw [AlgHom.comp_assoc, Ideal.Quotient.liftₐ_comp, mkₐ_comp_reynoldsAlgHom, hφ]

/-- Variant of `formallySmooth_quotient_fixedPointIdeal` taking `IsUnit (Nat.card Γ : R)`
explicitly. -/
theorem formallySmooth_quotient_fixedPointIdeal_of_isUnit [Algebra.FormallySmooth R A]
    (hΓ : IsUnit (Nat.card Γ : R)) :
    Algebra.FormallySmooth R (A ⧸ fixedPointIdeal Γ A) := by
  have := hΓ.nonempty_invertible.some
  exact formallySmooth_quotient_fixedPointIdeal

/-- **Edixhoven's smoothness theorem** (Proposition 3.4): if `A` is a smooth `R`-algebra and `Γ`
is a finite group of order invertible in `R` acting on `A` by `R`-algebra automorphisms, then the
fixed-point quotient `A ⧸ fixedPointIdeal Γ A` is smooth over `R`. -/
instance smooth_quotient_fixedPointIdeal [Algebra.Smooth R A] [Invertible (Nat.card Γ : R)] :
    Algebra.Smooth R (A ⧸ fixedPointIdeal Γ A) where

/-- Variant of `smooth_quotient_fixedPointIdeal` taking `IsUnit (Nat.card Γ : R)` explicitly. -/
theorem smooth_quotient_fixedPointIdeal_of_isUnit [Algebra.Smooth R A]
    (hΓ : IsUnit (Nat.card Γ : R)) :
    Algebra.Smooth R (A ⧸ fixedPointIdeal Γ A) := by
  have := hΓ.nonempty_invertible.some
  exact smooth_quotient_fixedPointIdeal

end Smooth

