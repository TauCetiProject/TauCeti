/-!
# Fixed-point ideals of actions on algebras

Let a type `G` act on a commutative `R`-algebra `A`. Contravariantly, each element of `G` acts on
`X = Spec A`, and the closed subscheme `Xᴳ` of fixed points is cut out by the **fixed-point ideal**
`fixedPointIdeal G A`: the ideal of `A` generated by all displacements `g • a - a`.

This ideal is distinct from the fixed-point subalgebra `FixedPoints.subalgebra R A G`: in geometric
terms, the fixed-point subalgebra is the coordinate ring of the invariant quotient `X / G`, whereas
`A ⧸ fixedPointIdeal G A` is the coordinate ring of the fixed-point closed subscheme `Xᴳ`.

A ring or `R`-algebra homomorphism out of `A` kills `fixedPointIdeal G A` if and only if it is
constant on `G`-orbits (`fixedPointIdeal_le_ker_iff`), so `R`-algebra points of the quotient
`A ⧸ fixedPointIdeal G A` biject naturally with `G`-invariant `R`-algebra points of `A`
(`quotientFixedPointIdealAlgHomEquiv`). When `G` is a monoid acting by `R`-algebra endomorphisms,
it suffices to take displacements on any set of `R`-algebra generators of `A`
(`fixedPointIdeal_eq_span_of_adjoin_eq_top`). Consequently, when `G` is finite and `A` is of
finite type (respectively of finite presentation) over `R`, the fixed-point ideal is finitely
generated (`fg_fixedPointIdeal`) and the fixed-point quotient is of finite presentation over `R`
(`finitePresentation_quotient_fixedPointIdeal`).

We also compute the fixed-point quotient of `A ⊗[R] A` under the factor-swapping involution: for
every commutative `R`-algebra `A`, multiplication `A ⊗[R] A →ₐ[R] A` identifies this quotient with
`A`, contravariantly identifying the swap-fixed subscheme of `X × X` with the diagonal `X`
(`quotientSwapFixedPointIdealAlgEquiv`).

## Main definitions

* `TauCeti.MulSemiringAction.fixedPointIdeal G A`: the ideal of `A` generated by all displacements
  `g • a - a`.
* `TauCeti.MulSemiringAction.quotientFixedPointIdealAlgHomEquiv`: natural equivalence between
  `(A ⧸ fixedPointIdeal G A) →ₐ[R] B` and `{f : A →ₐ[R] B // ∀ g a, f (g • a) = f a}`.
* `TauCeti.MulSemiringAction.quotientFixedPointIdealAlgEquivOfTrivial`:
  `(A ⧸ fixedPointIdeal G A) ≃ₐ[R] A` when `G` acts trivially on `A`.
* `TauCeti.MulSemiringAction.quotientSwapFixedPointIdealAlgEquiv`: for the swap action on
  `A ⊗[R] A`, the quotient by the fixed-point ideal is isomorphic as an `R`-algebra to `A`.

## Main results

* `TauCeti.MulSemiringAction.fixedPointIdeal_le_ker_iff`: a ring homomorphism vanishes on
  `fixedPointIdeal G A` if and only if it is `G`-invariant.
* `TauCeti.MulSemiringAction.fixedPointIdeal_closure_eq_span`: the fixed-point ideal of
  `Subgroup.closure s` is generated by the displacements of elements of `s`.
* `TauCeti.MulSemiringAction.fixedPointIdeal_eq_span_of_adjoin_eq_top`: when `G` acts by
  `R`-algebra endomorphisms, `fixedPointIdeal G A` is generated by the displacements of any
  `R`-algebra generating set.
* `TauCeti.MulSemiringAction.fg_fixedPointIdeal`: `fixedPointIdeal G A` is finitely generated when
  `G` is finite and `A` is of finite type over `R`.
* `TauCeti.MulSemiringAction.finitePresentation_quotient_fixedPointIdeal`:
  `A ⧸ fixedPointIdeal G A` is finitely presented over `R` when `G` is finite and `A` is finitely
  presented over `R`.

## References

* B. Edixhoven, *Néron models and tame ramification*, Compositio Math. 81 (1992), Proposition 3.1,
  p. 293.
-/

public section

open scoped TensorProduct

namespace TauCeti.MulSemiringAction

section Basic

variable (G A : Type*) [SMul G A]

/-- The **fixed-point ideal** of an action of `G` on a ring `A`: the left ideal generated by all
displacements `g • a - a`. When `A` is a commutative `R`-algebra on which `G` acts by `R`-algebra
automorphisms, `A ⧸ fixedPointIdeal G A` is the coordinate ring of the closed subscheme of
`G`-fixed points of `Spec A`. -/
def fixedPointIdeal [Ring A] : Ideal A :=
  Ideal.span {x : A | ∃ (g : G) (a : A), g • a - a = x}

variable {G A}

section Ring

variable [Ring A]

/-- `fixedPointIdeal G A` is spanned by all displacements `g • a - a`. -/
theorem fixedPointIdeal_def :
    fixedPointIdeal G A = Ideal.span {x : A | ∃ (g : G) (a : A), g • a - a = x} :=
  (rfl)

/-- `fixedPointIdeal G A` is the supremum over `g : G` of the ideals generated by the
`g`-displacements `g • a - a`. -/
theorem fixedPointIdeal_eq_iSup :
    fixedPointIdeal G A = ⨆ g : G, Ideal.span (Set.range fun a : A ↦ g • a - a) := by
  apply le_antisymm
  · rw [fixedPointIdeal_def, Ideal.span_le]
    rintro _ ⟨g, a, rfl⟩
    exact Submodule.mem_iSup_of_mem g (Ideal.subset_span ⟨a, rfl⟩)
  · refine iSup_le fun g ↦ Ideal.span_le.mpr ?_
    rintro _ ⟨a, rfl⟩
    exact Ideal.subset_span ⟨g, a, rfl⟩

/-- Every displacement `g • a - a` belongs to `fixedPointIdeal G A`. -/
theorem smul_sub_mem_fixedPointIdeal (g : G) (a : A) :
    g • a - a ∈ fixedPointIdeal G A :=
  Ideal.subset_span ⟨g, a, rfl⟩

/-- Every negated displacement `a - g • a` belongs to `fixedPointIdeal G A`. -/
theorem sub_smul_mem_fixedPointIdeal (g : G) (a : A) :
    a - g • a ∈ fixedPointIdeal G A := by
  rw [← neg_sub]
  exact neg_mem (smul_sub_mem_fixedPointIdeal g a)

/-- Universal property of `fixedPointIdeal G A` among left ideals of `A`. -/
theorem fixedPointIdeal_le_iff {J : Ideal A} :
    fixedPointIdeal G A ≤ J ↔ ∀ (g : G) (a : A), g • a - a ∈ J := by
  rw [fixedPointIdeal_def, Ideal.span_le]
  constructor
  · exact fun h g a ↦ h ⟨g, a, rfl⟩
  · rintro h _ ⟨g, a, rfl⟩
    exact h g a

/-- The fixed-point ideal vanishes if and only if `G` fixes every element of `A`. -/
@[simp]
theorem fixedPointIdeal_eq_bot_iff :
    fixedPointIdeal G A = ⊥ ↔ ∀ (g : G) (a : A), g • a = a := by
  rw [eq_bot_iff, fixedPointIdeal_le_iff]
  simp only [Ideal.mem_bot, sub_eq_zero]

/-- A subsingleton monoid fixes every element, so its fixed-point ideal vanishes. -/
theorem fixedPointIdeal_eq_bot_of_subsingleton {M : Type*} [Monoid M] [MulAction M A]
    [Subsingleton M] : fixedPointIdeal M A = ⊥ :=
  fixedPointIdeal_eq_bot_iff.mpr fun g a ↦ by
    rw [Subsingleton.elim g 1, one_smul]

/-- For a subgroup generated by a subset `s : Set G`, the fixed-point ideal of `Subgroup.closure s`
is generated by the displacements of elements of `s`. -/
theorem fixedPointIdeal_closure_eq_span {G : Type*} [Group G] [MulAction G A] (s : Set G) :
    fixedPointIdeal (Subgroup.closure s) A =
      Ideal.span {x : A | ∃ g ∈ s, ∃ a : A, g • a - a = x} := by
  let J := Ideal.span {x : A | ∃ g ∈ s, ∃ a : A, g • a - a = x}
  apply le_antisymm
  · rw [fixedPointIdeal_le_iff]
    rintro ⟨g, hg⟩
    induction hg using Subgroup.closure_induction with
    | mem g hg => exact fun a ↦ Ideal.subset_span ⟨g, hg, a, rfl⟩
    | one => simp [one_smul]
    | mul g₁ g₂ _ _ ih₁ ih₂ =>
      intro a
      have hdecomp : (g₁ * g₂) • a - a = (g₁ • (g₂ • a) - g₂ • a) + (g₂ • a - a) := by
        rw [mul_smul, sub_add_sub_cancel]
      exact hdecomp ▸ J.add_mem (ih₁ (g₂ • a)) (ih₂ a)
    | inv g _ ih =>
      intro a
      have hdecomp : g⁻¹ • a - a = -(g • (g⁻¹ • a) - g⁻¹ • a) := by
        rw [smul_inv_smul, neg_sub]
      exact hdecomp ▸ J.neg_mem (ih (g⁻¹ • a))
  · rw [Ideal.span_le]
    rintro _ ⟨g, hg, a, rfl⟩
    exact smul_sub_mem_fixedPointIdeal (⟨g, Subgroup.subset_closure hg⟩ : Subgroup.closure s) a

/-- For a cyclic subgroup `Subgroup.zpowers g`, the fixed-point ideal is generated by the
displacements `g • a - a` of the single generator `g`. -/
theorem fixedPointIdeal_zpowers_eq_span {G : Type*} [Group G] [MulAction G A] (g : G) :
    fixedPointIdeal (Subgroup.zpowers g) A = Ideal.span (Set.range fun a : A ↦ g • a - a) := by
  rw [Subgroup.zpowers_eq_closure, fixedPointIdeal_closure_eq_span]
  congr 1
  ext x
  simp

end Ring

section CommRing

variable [CommRing A]

/-- Modulo `fixedPointIdeal G A`, every `g • a` is congruent to `a`. -/
@[simp]
theorem mk_smul_eq (g : G) (a : A) :
    Ideal.Quotient.mk (fixedPointIdeal G A) (g • a) =
      Ideal.Quotient.mk (fixedPointIdeal G A) a :=
  Ideal.Quotient.eq.mpr (smul_sub_mem_fixedPointIdeal g a)

/-- Modulo `fixedPointIdeal G A`, the `R`-algebra quotient map sends `g • a` to the class of `a`. -/
@[simp]
theorem mkₐ_smul_eq (R : Type*) [CommSemiring R] [Algebra R A] (g : G) (a : A) :
    Ideal.Quotient.mkₐ R (fixedPointIdeal G A) (g • a) =
      Ideal.Quotient.mkₐ R (fixedPointIdeal G A) a :=
  mk_smul_eq g a

/-- A ring homomorphism out of `A` kills `fixedPointIdeal G A` if and only if it is constant on
`G`-orbits. -/
theorem fixedPointIdeal_le_ker_iff {F B : Type*} [Ring B] [FunLike F A B] [RingHomClass F A B]
    (φ : F) :
    fixedPointIdeal G A ≤ RingHom.ker φ ↔ ∀ (g : G) (a : A), φ (g • a) = φ a := by
  rw [fixedPointIdeal_le_iff]
  refine forall₂_congr fun g a ↦ ?_
  rw [RingHom.mem_ker, map_sub, sub_eq_zero]

/-- **Universal property of the fixed-point quotient (Edixhoven, Proposition 3.1).** For every
`R`-algebra `B`, `R`-algebra homomorphisms `(A ⧸ fixedPointIdeal G A) →ₐ[R] B` correspond
bijectively via precomposition with the quotient map to `G`-invariant `R`-algebra homomorphisms
`A →ₐ[R] B`. -/
def quotientFixedPointIdealAlgHomEquiv (R G A B : Type*) [CommSemiring R] [CommRing A]
    [Algebra R A] [Ring B] [Algebra R B] [SMul G A] :
    ((A ⧸ fixedPointIdeal G A) →ₐ[R] B) ≃
      {f : A →ₐ[R] B // ∀ (g : G) (a : A), f (g • a) = f a} where
  toFun φ := ⟨φ.comp (Ideal.Quotient.mkₐ R (fixedPointIdeal G A)), fun g a ↦ by
    simp only [AlgHom.comp_apply, mkₐ_smul_eq]⟩
  invFun f := Ideal.Quotient.liftₐ (fixedPointIdeal G A) f.1 fun x hx ↦
    show f.1.toRingHom x = 0 from
      RingHom.mem_ker.mp (((fixedPointIdeal_le_ker_iff (G := G) f.1).mpr f.2) hx)
  left_inv φ := by
    ext x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    rfl
  right_inv f := by
    ext a
    rfl

@[simp]
theorem quotientFixedPointIdealAlgHomEquiv_apply {R B : Type*} [CommSemiring R] [Algebra R A]
    [Ring B] [Algebra R B] (φ : (A ⧸ fixedPointIdeal G A) →ₐ[R] B) (a : A) :
    (quotientFixedPointIdealAlgHomEquiv R G A B φ).1 a =
      φ (Ideal.Quotient.mk (fixedPointIdeal G A) a) :=
  (rfl)

@[simp]
theorem quotientFixedPointIdealAlgHomEquiv_symm_apply_mk {R B : Type*} [CommSemiring R]
    [Algebra R A] [Ring B] [Algebra R B]
    (f : {f : A →ₐ[R] B // ∀ (g : G) (a : A), f (g • a) = f a}) (a : A) :
    (quotientFixedPointIdealAlgHomEquiv R G A B).symm f
        (Ideal.Quotient.mk (fixedPointIdeal G A) a) = f.1 a :=
  (rfl)

/-- When `G` acts trivially on `A`, the fixed-point quotient `A ⧸ fixedPointIdeal G A` is
isomorphic as an `R`-algebra to `A`. -/
noncomputable def quotientFixedPointIdealAlgEquivOfTrivial (R : Type*) [CommSemiring R]
    [Algebra R A] (htriv : ∀ (g : G) (a : A), g • a = a) :
    (A ⧸ fixedPointIdeal G A) ≃ₐ[R] A :=
  (Ideal.quotientEquivAlgOfEq R (fixedPointIdeal_eq_bot_iff.mpr htriv)).trans
    (AlgEquiv.quotientBot R A)

@[simp]
theorem quotientFixedPointIdealAlgEquivOfTrivial_mk (R : Type*) [CommSemiring R] [Algebra R A]
    (htriv : ∀ (g : G) (a : A), g • a = a) (a : A) :
    quotientFixedPointIdealAlgEquivOfTrivial R htriv
        (Ideal.Quotient.mk (fixedPointIdeal G A) a) = a :=
  (rfl)

@[simp]
theorem quotientFixedPointIdealAlgEquivOfTrivial_symm_apply (R : Type*) [CommSemiring R]
    [Algebra R A] (htriv : ∀ (g : G) (a : A), g • a = a) (a : A) :
    (quotientFixedPointIdealAlgEquivOfTrivial R htriv).symm a =
      Ideal.Quotient.mk (fixedPointIdeal G A) a :=
  (rfl)

end CommRing

end Basic

section FinitePresentation

variable {R M A : Type*} [CommSemiring R] [Monoid M] [CommRing A] [Algebra R A]
  [MulSemiringAction M A] [SMulCommClass M R A]

/-- For a monoid acting on `A` by `R`-algebra endomorphisms, the elements `a : A` whose
`m`-displacement `m • a - a` lies in a given ideal `J` form an `R`-subalgebra of `A`. -/
private def displacementMemSubalgebra (m : M) (J : Ideal A) : Subalgebra R A where
  carrier := {a : A | m • a - a ∈ J}
  algebraMap_mem' r := by
    change m • algebraMap R A r - algebraMap R A r ∈ J
    rw [smul_algebraMap, sub_self]
    exact J.zero_mem
  add_mem' {a b} ha hb := by
    change m • (a + b) - (a + b) ∈ J
    rw [smul_add, add_sub_add_comm]
    exact J.add_mem ha hb
  mul_mem' {a b} ha hb := by
    change m • (a * b) - a * b ∈ J
    have hmul : m • (a * b) - a * b = m • a * (m • b - b) + (m • a - a) * b := by
      rw [smul_mul']
      ring
    rw [hmul]
    exact J.add_mem (J.mul_mem_left (m • a) hb) (J.mul_mem_right b ha)

/-- When `M` acts on `A` by `R`-algebra endomorphisms and `s` generates `A` as an `R`-algebra,
`fixedPointIdeal M A` is already generated as an ideal by the displacements `m • a - a` with
`a ∈ s`. -/
theorem fixedPointIdeal_eq_span_of_adjoin_eq_top {s : Set A} (hs : Algebra.adjoin R s = ⊤) :
    fixedPointIdeal M A = Ideal.span {x : A | ∃ m : M, ∃ a ∈ s, m • a - a = x} := by
  refine le_antisymm (fixedPointIdeal_le_iff.mpr fun m a ↦ ?_) (Ideal.span_mono ?_)
  · set J : Ideal A := Ideal.span {x : A | ∃ m : M, ∃ a ∈ s, m • a - a = x}
    have hsJ : s ≤ displacementMemSubalgebra (R := R) m J :=
      fun x hx ↦ Ideal.subset_span ⟨m, x, hx, rfl⟩
    have htop : displacementMemSubalgebra (R := R) m J = ⊤ :=
      top_unique (hs ▸ Algebra.adjoin_le hsJ)
    exact (htop.symm ▸ Algebra.mem_top : a ∈ displacementMemSubalgebra (R := R) m J)
  · rintro _ ⟨m, a, -, rfl⟩
    exact ⟨m, a, rfl⟩

/-- If `M` is finite and `A` is a finite-type `R`-algebra, then `fixedPointIdeal M A` is a
finitely generated ideal of `A`. -/
theorem fg_fixedPointIdeal [Finite M] [Algebra.FiniteType R A] :
    (fixedPointIdeal M A).FG := by
  classical
  have := Fintype.ofFinite M
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := A)
  rw [fixedPointIdeal_eq_span_of_adjoin_eq_top hs]
  refine ⟨Finset.biUnion Finset.univ fun m : M ↦ s.image fun a : A ↦ m • a - a, ?_⟩
  congr 1
  ext x
  simp

/-- If `M` is finite and `A` is finitely presented over `R`, then the fixed-point quotient
`A ⧸ fixedPointIdeal M A` is finitely presented over `R`. -/
theorem finitePresentation_quotient_fixedPointIdeal {R M A : Type*} [CommRing R] [Monoid M]
    [Finite M] [CommRing A] [Algebra R A] [MulSemiringAction M A] [SMulCommClass M R A]
    [Algebra.FinitePresentation R A] :
    Algebra.FinitePresentation R (A ⧸ fixedPointIdeal M A) :=
  Algebra.FinitePresentation.quotient (fg_fixedPointIdeal (R := R) (M := M) (A := A))

end FinitePresentation

section SwapDiagonal

variable (R A : Type*) [CommRing R] [CommRing A] [Algebra R A]

/-- The subgroup of `(A ⊗[R] A) ≃ₐ[R] (A ⊗[R] A)` generated by the factor-swapping involution
`Algebra.TensorProduct.comm R A A`. -/
abbrev tensorSwapSubgroup : Subgroup ((A ⊗[R] A) ≃ₐ[R] (A ⊗[R] A)) :=
  Subgroup.zpowers (Algebra.TensorProduct.comm R A A)

/-- The fixed-point ideal of the factor-swapping action on `A ⊗[R] A` equals the kernel of the
multiplication map `A ⊗[R] A →ₐ[R] A`. -/
theorem fixedPointIdeal_tensorSwapSubgroup_eq_ker_lmul' :
    fixedPointIdeal (tensorSwapSubgroup R A) (A ⊗[R] A) =
      RingHom.ker (Algebra.TensorProduct.lmul' R (S := A)) := by
  let I := fixedPointIdeal (tensorSwapSubgroup R A) (A ⊗[R] A)
  apply le_antisymm
  · rw [fixedPointIdeal_zpowers_eq_span, Ideal.span_le]
    rintro _ ⟨w, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, sub_eq_zero, AlgEquiv.smul_def]
    induction w using TensorProduct.inductionOn with
    | tmul a b => simp [mul_comm]
    | add x y hx hy => simp [map_add, hx, hy]
  · intro z hz
    rw [RingHom.mem_ker] at hz
    let σ : tensorSwapSubgroup R A :=
      ⟨Algebra.TensorProduct.comm R A A, Subgroup.mem_zpowers _⟩
    have hmk (x : A ⊗[R] A) :
        Ideal.Quotient.mk I x =
          Ideal.Quotient.mk I
            (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := A)
              (Algebra.TensorProduct.lmul' R x)) := by
      induction x using TensorProduct.inductionOn with
      | tmul a b =>
        have hswap : Ideal.Quotient.mk I ((1 : A) ⊗ₜ[R] b) =
            Ideal.Quotient.mk I (b ⊗ₜ[R] (1 : A)) :=
          (mk_smul_eq σ ((1 : A) ⊗ₜ[R] b)).symm
        have hprod : a ⊗ₜ[R] b = (a ⊗ₜ[R] (1 : A)) * ((1 : A) ⊗ₜ[R] b) := by simp
        rw [hprod, map_mul, hswap, ← map_mul]
        simp
      | add x y hx hy => simp [map_add, hx, hy]
    rw [← Ideal.Quotient.eq_zero_iff_mem, hmk z, hz, map_zero, map_zero]

/-- **Diagonal fixed points of the swap involution.** For every commutative `R`-algebra `A`,
multiplication `A ⊗[R] A →ₐ[R] A` induces an `R`-algebra isomorphism from the quotient of
`A ⊗[R] A` by the swap fixed-point ideal onto `A`. Contravariantly, the fixed-point subscheme of
`Spec A ×_{Spec R} Spec A` under exchanging the two factors is the diagonal `Spec A`. -/
def quotientSwapFixedPointIdealAlgEquiv :
    ((A ⊗[R] A) ⧸ fixedPointIdeal (tensorSwapSubgroup R A) (A ⊗[R] A)) ≃ₐ[R] A :=
  (Ideal.quotientEquivAlgOfEq R (fixedPointIdeal_tensorSwapSubgroup_eq_ker_lmul' R A)).trans
    (Ideal.quotientKerAlgEquivOfRightInverse
      (f := Algebra.TensorProduct.lmul' R (S := A))
      (g := Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := A))
      fun a ↦ by simp)

@[simp]
theorem quotientSwapFixedPointIdealAlgEquiv_mk (z : A ⊗[R] A) :
    quotientSwapFixedPointIdealAlgEquiv R A
        (Ideal.Quotient.mk (fixedPointIdeal (tensorSwapSubgroup R A) (A ⊗[R] A)) z) =
      Algebra.TensorProduct.lmul' R z :=
  (rfl)

@[simp]
theorem quotientSwapFixedPointIdealAlgEquiv_symm_apply (a : A) :
    (quotientSwapFixedPointIdealAlgEquiv R A).symm a =
      Ideal.Quotient.mk (fixedPointIdeal (tensorSwapSubgroup R A) (A ⊗[R] A)) (a ⊗ₜ[R] 1) :=
  (rfl)

end SwapDiagonal

end TauCeti.MulSemiringAction
