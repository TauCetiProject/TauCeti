module

public import TauCeti.RingTheory.StrictHenselization.MaximalIdeal
public import TauCeti.RingTheory.AdicCompletion.Noetherian

/-!
# Completed strict henselizations

Let `R` be a local ring with a local map to a field `Ω`. If the maximal ideal of `R` is
finitely generated, the completion of the colimit of pointed étale neighbourhoods of `R → Ω`
is Noetherian. In particular, over a Noetherian base the completed strict henselization is a
Noetherian complete local ring, and its completion map is local.

The maximal ideal of the pointed colimit is generated by the base maximal ideal. Its finite
generation suffices for the completion results; Noetherianity of the colimit itself is not
assumed. No separability or algebraicity condition on the pointing field is needed.

## References

* [Stacks Project, Lemma 15.46.3](https://stacks.math.columbia.edu/tag/06LJ), assertion (a).
-/

public section

open IsLocalRing

universe u

namespace TauCeti.StrictHenselization

variable (R Ω : Type u) [CommRing R] [IsLocalRing R] [Field Ω] [Algebra R Ω]
  [IsLocalHom (algebraMap R Ω)]

/-- The completed pointed étale colimit is Noetherian if the base maximal ideal is finitely
generated. This does not require Noetherianity of the pointed colimit. -/
@[stacks 06LJ "(a), strict henselization"]
theorem isNoetherianRing_adicCompletion_of_fg (hR : (maximalIdeal R).FG) :
    IsNoetherianRing (AdicCompletion (maximalIdeal (algebra R Ω)) (algebra R Ω)) :=
  IsLocalRing.isNoetherianRing_adicCompletion_of_fg (maximalIdeal_fg R Ω hR)

/-- Over a Noetherian local base, the completed pointed étale colimit is Noetherian. -/
instance isNoetherianRing_adicCompletion [IsNoetherianRing R] :
    IsNoetherianRing (AdicCompletion (maximalIdeal (algebra R Ω)) (algebra R Ω)) :=
  isNoetherianRing_adicCompletion_of_fg R Ω (IsNoetherian.noetherian _)

/-- Over a Noetherian local base, the completed pointed étale colimit is local. -/
instance isLocalRing_adicCompletion [IsNoetherianRing R] :
    IsLocalRing (AdicCompletion (maximalIdeal (algebra R Ω)) (algebra R Ω)) :=
  AdicCompletion.isLocalRing_of_fg (maximalIdeal_fg R Ω (IsNoetherian.noetherian _))

/-- The completion map of the pointed étale colimit over a Noetherian local base is local. -/
instance isLocalHom_adicCompletion [IsNoetherianRing R] :
    IsLocalHom (algebraMap (algebra R Ω)
      (AdicCompletion (maximalIdeal (algebra R Ω)) (algebra R Ω))) :=
  AdicCompletion.algebraMap_isLocalHom_of_fg
    (maximalIdeal_fg R Ω (IsNoetherian.noetherian _))

/-- Over a Noetherian local base, the completed pointed étale colimit is complete for its own
maximal ideal. -/
instance isAdicComplete_adicCompletion [IsNoetherianRing R] :
    IsAdicComplete
      (maximalIdeal (AdicCompletion (maximalIdeal (algebra R Ω)) (algebra R Ω)))
      (AdicCompletion (maximalIdeal (algebra R Ω)) (algebra R Ω)) :=
  AdicCompletion.isAdicComplete_of_fg (maximalIdeal_fg R Ω (IsNoetherian.noetherian _))

end TauCeti.StrictHenselization
