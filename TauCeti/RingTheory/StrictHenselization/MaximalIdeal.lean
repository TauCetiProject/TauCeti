module

public import TauCeti.RingTheory.StrictHenselization.Local
public import Mathlib.RingTheory.Unramified.LocalRing

/-!
# The maximal ideal of the strict henselization

For a local ring `R` and a field-valued local pointing `R → Ω`, the maximal ideal of the
colimit of pointed étale neighbourhoods is generated by the maximal ideal of `R`.
No algebraicity or separable-closedness hypothesis on `Ω` is needed for this assertion.

This identifies the closed fibre of the strict henselization as a field, before identifying
that field with the chosen separable closure. It also supplies the ideal comparison used
when completing the strict henselization at its maximal ideal.

The argument localizes each étale neighbourhood at the kernel of its point and uses
Mathlib's `Algebra.FormallyUnramified.map_maximalIdeal` on that local algebra.

## References

* Stacks Project, Tag 04GP, property (4).
-/

public section

open IsLocalRing

universe u

namespace TauCeti.StrictHenselization

variable (R Ω : Type u) [CommRing R] [IsLocalRing R] [Field Ω] [Algebra R Ω]
  [IsLocalHom (algebraMap R Ω)]

/-- An element of a pointed étale stage that vanishes at the point belongs, in the colimit,
to the ideal generated by the base maximal ideal. -/
private theorem stage_mem_map_maximalIdeal (B : Neighbourhood R Ω) (b : B.obj.left)
    (hb : toTarget R Ω (stage R Ω B b) = 0) :
    stage R Ω B b ∈ (maximalIdeal R).map (algebraMap R (algebra R Ω)) := by
  let point := (toTarget R Ω).comp (stage R Ω B)
  let q := RingHom.ker point.toRingHom
  have : q.IsPrime := RingHom.ker_isPrime point.toRingHom
  let L := Localization.AtPrime q
  have hunits (s : q.primeCompl) : IsUnit (stage R Ω B s) := by
    apply (isUnit_iff_isUnit_toTarget R Ω _).mpr
    exact isUnit_iff_ne_zero.mpr s.property
  let lift : L →ₐ[R] algebra R Ω := IsLocalization.liftAlgHom hunits
  let localPoint := (toTarget R Ω).comp lift
  have hcomp : localPoint.toRingHom.comp (algebraMap R L) = algebraMap R Ω := by
    ext r
    exact localPoint.commutes r
  have : IsLocalHom (localPoint.toRingHom.comp (algebraMap R L)) := hcomp ▸ inferInstance
  have : IsLocalHom (algebraMap R L) :=
    isLocalHom_of_comp (algebraMap R L) localPoint.toRingHom
  have : Algebra.FormallyUnramified R L :=
    Algebra.FormallyUnramified.comp R B.obj.left L
  have hbL : algebraMap B.obj.left L b ∈ maximalIdeal L :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff L q b).mpr hb
  rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := R)] at hbL
  have hmem := Ideal.mem_map_of_mem lift.toRingHom hbL
  have hliftcomp : lift.toRingHom.comp (algebraMap R L) =
      algebraMap R (algebra R Ω) := by
    ext r
    exact lift.commutes r
  rw [Ideal.map_map, hliftcomp] at hmem
  have hlift : lift (algebraMap B.obj.left L b) = stage R Ω B b :=
    IsLocalization.lift_eq hunits b
  simpa only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hlift] using hmem

/-- The maximal ideal of the colimit of pointed étale neighbourhoods is the extension of the
base maximal ideal. In particular this applies to the strict henselization of a local ring
with respect to a separable closure of its residue field. -/
@[stacks 04GP "(4)"]
theorem maximalIdeal_eq_map :
    maximalIdeal (algebra R Ω) = (maximalIdeal R).map (algebraMap R (algebra R Ω)) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨B, b, rfl⟩ := exists_stage_eq R Ω x
    apply stage_mem_map_maximalIdeal R Ω B b
    rwa [← ker_toTarget_eq_maximalIdeal R Ω, RingHom.mem_ker] at hx
  · exact map_maximalIdeal_le (algebraMap R (algebra R Ω))

end TauCeti.StrictHenselization
