/-!
# Generic freeness

Let `A` be a reduced Noetherian ring, `B` a finitely generated `A`-algebra and `M` a finite
`B`-module. Then `M`, viewed as an `A`-module, is free at every prime of an open neighbourhood of
the minimal primes of `A`; in particular the interior of its free locus is dense in `Spec A`.
Over a Noetherian domain this says that `M_q` is free over `A_q` for every prime `q` in some
nonempty basic open set.

The module `M` is usually not finitely generated over `A`, so openness of the free locus of a
finitely presented module does not apply directly. Instead, the proof is by induction on the
number of generators of `B`. A finite module `M` over a polynomial ring `R[X]`, with generators
`m₁, …, mₜ`, is filtered by the `R`-submodules `F j` spanned by the `X ^ i • mₖ` with `i < j`.
Each subquotient `F (j + 1) ⧸ F j` is a quotient of `Rᵗ` by the submodule `K j` of coefficient
vectors `c` with `∑ cₖ • X ^ j • mₖ ∈ F j`. Multiplication by `X` shows that `K j` increases with
`j`, so by Noetherianity only finitely many distinct subquotients occur. The induction hypothesis
makes each of them free on an open neighbourhood of the minimal primes, and the finite
intersection of these sets is an open neighbourhood on which every subquotient, hence `M` itself,
is free.

Over a domain `A` that need not be Noetherian, the same conclusion holds by reduction to the
Noetherian case. Present `M` over a polynomial ring `P = A[x₁, …, xₙ]` as a quotient of `Pᵗ` by a
submodule `K`. Over the fraction field `K` becomes finitely generated, so finitely many elements of
`K` span it up to torsion. The quotient `M'` of `Pᵗ` by these finitely many relations is the base
change of a module over a polynomial ring over the finitely generated, hence Noetherian, subring of
`A` generated by the coefficients of the relations, so `M'` is free near the generic point. Since
the kernel of `M' → M` is torsion, it vanishes wherever `M'` is free.

## Main declarations

* `Module.freeLocus_mem_nhds_of_mem_minimalPrimes`: a finite module over a finitely generated
  algebra over a reduced Noetherian ring is free over that ring near every minimal prime.
* `Module.dense_interior_freeLocus_of_finiteType`: such a module is free over the base on a
  dense open subset of its spectrum.
* `Module.freeLocus_mem_nhds_of_mem_minimalPrimes_of_isDomain`,
  `Module.dense_interior_freeLocus_of_finiteType_of_isDomain`: the same over a domain, which need
  not be Noetherian.

## References

* H. Matsumura, *Commutative Ring Theory*, Theorem 24.1.
* The Stacks Project, Tags 051R and 051S.
-/

public section

open Polynomial Topology

namespace Module

universe uA uR uM

variable {A : Type uA} [CommRing A]

/-- If every finite `R`-module is free over `A` near each minimal prime of `A`, then so is every
finite module over the polynomial ring `R[X]`. -/
private theorem freeLocus_mem_nhds_polynomial {R : Type uR} [CommRing R] [Algebra A R]
    [IsNoetherianRing R]
    (hR : ∀ (N : Type uR) [AddCommGroup N] [Module R N] [Module A N] [IsScalarTower A R N]
      [Module.Finite R N] (p : Ideal A) (hp : p ∈ minimalPrimes A),
      freeLocus A N ∈ 𝓝 ⟨p, hp.1.1⟩)
    (M : Type uM) [AddCommGroup M] [Module R[X] M] [Module A M] [IsScalarTower A R[X] M]
    [Module.Finite R[X] M] (p : Ideal A) (hp : p ∈ minimalPrimes A) :
    freeLocus A M ∈ 𝓝 ⟨p, hp.1.1⟩ := by
  classical
  let _ : Module R M := Module.restrictScalars R R[X] M
  have : IsScalarTower R R[X] M := IsScalarTower.restrictScalars R R[X] M
  have : IsScalarTower A R M := IsScalarTower.of_algebraMap_smul fun a m ↦
    (congrArg (fun q : R[X] ↦ q • m)
      (IsScalarTower.algebraMap_apply A R R[X] a).symm).trans
      (IsScalarTower.algebraMap_smul R[X] a m)
  obtain ⟨t, m, hm⟩ := Module.Finite.exists_fin (R := R[X]) (M := M)
  -- `φ j c = ∑ cₖ • X ^ j • mₖ`, and `F j` is spanned by the images of `φ i` for `i < j`.
  let φ : ℕ → (Fin t → R) →ₗ[R] M := fun j ↦
    Fintype.linearCombination R fun k ↦ (X ^ j : R[X]) • m k
  let F : ℕ → Submodule R M := fun j ↦ ⨆ i < j, LinearMap.range (φ i)
  let lX : M →ₗ[R] M := Algebra.lsmul R R M (X : R[X])
  have hφX (j : ℕ) : φ (j + 1) = lX ∘ₗ φ j := by
    ext c
    simp only [φ, lX, LinearMap.comp_apply, Algebra.lsmul_apply,
      Fintype.linearCombination_apply, Finset.smul_sum, pow_succ', mul_smul]
    exact Finset.sum_congr rfl fun k _ ↦ (smul_comm _ _ _).symm
  have hFmono : Monotone F := fun i j hij ↦
    biSup_mono fun _ hk ↦ lt_of_lt_of_le hk hij
  have hF0 : F 0 = ⊥ := by simp [F]
  have hFX (j : ℕ) : (F j).map lX ≤ F (j + 1) := by
    simp only [F, Submodule.map_iSup, iSup_le_iff]
    intro i hi
    rw [← LinearMap.range_comp, ← hφX]
    exact le_iSup₂_of_le (i + 1) (by omega) le_rfl
  have hFtop : ⨆ j, F j = ⊤ := by
    rw [eq_top_iff, ← Submodule.restrictScalars_top R R[X] M, ← hm,
      ← TauCeti.iSup_span_range_X_pow_smul m, iSup_le_iff]
    exact fun i ↦ (Fintype.range_linearCombination R _).ge.trans
      (le_iSup_of_le (i + 1) (le_iSup₂_of_le i (Nat.lt_succ_self i) le_rfl))
  -- `K j` is the module of relations of the `j`-th subquotient; it increases with `j`.
  let K : ℕ →o Submodule R (Fin t → R) :=
    ⟨fun j ↦ (F j).comap (φ j), monotone_nat_of_le_succ fun j c hc ↦ by
      rw [Submodule.mem_comap, hφX, LinearMap.comp_apply]
      exact hFX j (Submodule.mem_map_of_mem hc)⟩
  obtain ⟨j₀, hj₀⟩ := monotone_stabilizes_iff_noetherian.mpr inferInstance K
  -- The `j`-th subquotient of the filtration, viewed over `A`, is `Rᵗ ⧸ K j`.
  let N : ℕ → Submodule A M := fun j ↦ (F j).restrictScalars A
  have hNmono : Monotone N := fun _ _ hij ↦ Submodule.restrictScalars_mono A (hFmono hij)
  have hsub (j : ℕ) : freeLocus A ((Fin t → R) ⧸ K j) =
      freeLocus A (N (j + 1) ⧸ (N j).submoduleOf (N (j + 1))) := by
    have hFsucc : F j ⊔ LinearMap.range (φ j) = F (j + 1) := (Nat.iSup_lt_succ _ j).symm
    have e := Submodule.quotientComapEquivSupQuotient (F j) (φ j)
    generalize F j ⊔ LinearMap.range (φ j) = G at e hFsucc
    subst hFsucc
    exact freeLocus_congr (e.restrictScalars A ≪≫ₗ
      (Submodule.Quotient.restrictScalarsEquiv A ((F j).submoduleOf (F (j + 1)))).symm)
  -- Only the finitely many subquotients with `j ≤ j₀` matter.
  let U := ⋂ j ∈ Finset.range (j₀ + 1), interior (freeLocus A ((Fin t → R) ⧸ K j))
  have hU : U ∈ 𝓝 ⟨p, hp.1.1⟩ :=
    (isOpen_biInter_finset fun _ _ ↦ isOpen_interior).mem_nhds <| Set.mem_iInter₂.mpr
      fun j _ ↦ mem_interior_iff_mem_nhds.mpr (hR ((Fin t → R) ⧸ K j) p hp)
  refine Filter.mem_of_superset hU (subset_trans ?_ (iInter_freeLocus_subquotient_subset_freeLocus
    N hNmono (by simp [N, hF0]) ?_))
  · have hstab := TauCeti.iInf_mem_range_succ_eq_iInf (fun j ↦ freeLocus A ((Fin t → R) ⧸ K j))
      j₀ fun j hj ↦ by rw [hj₀ j hj]
    simp only [Set.iInf_eq_iInter] at hstab
    exact ((Set.iInter₂_mono fun _ _ ↦ interior_subset).trans hstab.subset).trans_eq
      (Set.iInter_congr hsub)
  · simp only [N, ← Submodule.restrictScalars_iSup, hFtop, Submodule.restrictScalars_top]

/-- Freeness of finite modules near the minimal primes of `A` transfers along a surjective
algebra map. -/
private theorem freeLocus_mem_nhds_of_surjective {R S : Type*} [CommRing R] [CommRing S]
    [Algebra A R] [Algebra A S] (f : R →ₐ[A] S) (hf : Function.Surjective f)
    (hR : ∀ (N : Type uM) [AddCommGroup N] [Module R N] [Module A N] [IsScalarTower A R N]
      [Module.Finite R N] (p : Ideal A) (hp : p ∈ minimalPrimes A),
      freeLocus A N ∈ 𝓝 ⟨p, hp.1.1⟩)
    (M : Type uM) [AddCommGroup M] [Module S M] [Module A M] [IsScalarTower A S M]
    [Module.Finite S M] (p : Ideal A) (hp : p ∈ minimalPrimes A) :
    freeLocus A M ∈ 𝓝 ⟨p, hp.1.1⟩ := by
  let _ : Algebra R S := f.toRingHom.toAlgebra
  let _ : Module R M := Module.compHom M f.toRingHom
  have : IsScalarTower R S M := IsScalarTower.of_compHom R S M
  have : IsScalarTower A R M := IsScalarTower.of_algebraMap_smul fun a m ↦
    (congrArg (fun s : S ↦ s • m) (f.commutes a)).trans
      (IsScalarTower.algebraMap_smul S a m)
  have : Module.Finite R S := Module.Finite.of_surjective (Algebra.linearMap R S) hf
  have : Module.Finite R M := Module.Finite.trans S M
  exact hR M p hp

/-- **Generic freeness.** Let `A` be a reduced Noetherian ring, `B` a finitely generated
`A`-algebra and `M` a finite `B`-module. Then `M` is free over `A` on a neighbourhood of every
minimal prime of `A`.

For a Noetherian domain `A` this means that there is a nonzero `a : A` such that `M_q` is free
over `A_q` for every prime `q` not containing `a`. -/
theorem freeLocus_mem_nhds_of_mem_minimalPrimes [IsNoetherianRing A] [IsReduced A]
    {B : Type*} [CommRing B] [Algebra A B] [Algebra.FiniteType A B]
    (M : Type uM) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]
    [Module.Finite B M] {p : Ideal A} (hp : p ∈ minimalPrimes A) :
    freeLocus A M ∈ 𝓝 ⟨p, hp.1.1⟩ := by
  -- Finite modules over polynomial rings in finitely many variables.
  have key (n : ℕ) : ∀ (N : Type uA) [AddCommGroup N] [Module (MvPolynomial (Fin n) A) N]
      [Module A N] [IsScalarTower A (MvPolynomial (Fin n) A) N]
      [Module.Finite (MvPolynomial (Fin n) A) N] (p : Ideal A) (hp : p ∈ minimalPrimes A),
      freeLocus A N ∈ 𝓝 ⟨p, hp.1.1⟩ := by
    induction n with
    | zero =>
      intro N _ _ _ _ _ p hp
      have : Module.Finite A (MvPolynomial (Fin 0) A) :=
        Module.Finite.equiv (MvPolynomial.isEmptyAlgEquiv A (Fin 0)).symm.toLinearEquiv
      have : Module.Finite A N := Module.Finite.trans (MvPolynomial (Fin 0) A) N
      have : FinitePresentation A N := Module.finitePresentation_of_finite A N
      exact isOpen_freeLocus.mem_nhds (mem_freeLocus_of_mem_minimalPrimes N hp)
    | succ n ih =>
      exact freeLocus_mem_nhds_of_surjective (MvPolynomial.finSuccEquiv A n).symm.toAlgHom
        (MvPolynomial.finSuccEquiv A n).symm.surjective (freeLocus_mem_nhds_polynomial ih)
  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType A B›
  refine freeLocus_mem_nhds_of_surjective (aevalTower f 0) (fun b ↦ ?_)
    (freeLocus_mem_nhds_polynomial (key n)) M p hp
  obtain ⟨q, rfl⟩ := hf b
  exact ⟨C q, aevalTower_C _ _ _⟩

/-- **Generic freeness.** Let `A` be a reduced Noetherian ring, `B` a finitely generated
`A`-algebra and `M` a finite `B`-module. Then `M` is free over `A` on a dense open subset of
`Spec A`. -/
theorem dense_interior_freeLocus_of_finiteType [IsNoetherianRing A] [IsReduced A]
    {B : Type*} [CommRing B] [Algebra A B] [Algebra.FiniteType A B]
    (M : Type uM) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]
    [Module.Finite B M] : Dense (interior (freeLocus A M)) :=
  PrimeSpectrum.dense_of_forall_mem_minimalPrimes fun _ hp ↦
    mem_interior_iff_mem_nhds.mpr (freeLocus_mem_nhds_of_mem_minimalPrimes (B := B) M hp)

/-- Over a domain, a surjection whose kernel consists of torsion elements is an isomorphism after
localizing at any prime where its source is free, so its target is free there too. -/
theorem mem_freeLocus_of_surjective_of_isTorsion [IsDomain A] {M N : Type*}
    [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N] (q : M →ₗ[A] N)
    (hq : Function.Surjective q) (htors : ∀ x, q x = 0 → ∃ b ∈ nonZeroDivisors A, b • x = 0)
    {p : PrimeSpectrum A} (hp : p ∈ freeLocus A M) : p ∈ freeLocus A N := by
  rw [mem_freeLocus] at hp ⊢
  let φ := LocalizedModule.map p.asIdeal.primeCompl q
  have hsurj : Function.Surjective φ := by
    intro y
    induction y using LocalizedModule.induction_on with
    | h y s =>
      obtain ⟨x, rfl⟩ := hq y
      exact ⟨LocalizedModule.mk x s, by simp [φ, LocalizedModule.map_mk]⟩
  have hinj : Function.Injective φ := by
    rw [← LinearMap.ker_eq_bot, eq_bot_iff]
    intro y hy
    induction y using LocalizedModule.induction_on with
    | h x s =>
      simp only [LinearMap.mem_ker, φ, LocalizedModule.map_mk] at hy
      rw [← LocalizedModule.zero_mk (1 : p.asIdeal.primeCompl), LocalizedModule.mk_eq] at hy
      obtain ⟨u, hu⟩ := hy
      simp only [one_smul, smul_zero, Submonoid.smul_def] at hu
      obtain ⟨b, hb, hbx⟩ := htors ((u : A) • x) (by rw [map_smul]; exact hu)
      have hne : algebraMap A (Localization.AtPrime p.asIdeal) (b * u) ≠ 0 := by
        rw [Ne, ← map_zero (algebraMap A (Localization.AtPrime p.asIdeal)),
          (IsLocalization.injective _ p.asIdeal.primeCompl_le_nonZeroDivisors).eq_iff]
        exact mul_ne_zero (nonZeroDivisors.ne_zero hb) (fun h ↦ u.2 (h ▸ p.asIdeal.zero_mem))
      have h0 : algebraMap A (Localization.AtPrime p.asIdeal) (b * u) •
          LocalizedModule.mk x s = 0 := by
        rw [algebraMap_smul, LocalizedModule.smul'_mk, mul_smul, hbx, LocalizedModule.zero_mk]
      exact (smul_eq_zero.mp h0).resolve_left hne
  exact Module.Free.of_equiv (LinearEquiv.ofBijective φ ⟨hinj, hsurj⟩)

attribute [local instance] MvPolynomial.algebraMvPolynomial in
/-- Over a domain `A`, every submodule `K` of `(MvPolynomial σ A)ⁱ` is finitely generated up to
torsion: some finite subset of `K` spans a submodule containing a nonzero multiple of each element
of `K`. This holds because `K` becomes finitely generated over the Noetherian ring
`MvPolynomial σ (FractionRing A)`. -/
private theorem exists_finset_smul_mem_span_of_isDomain [IsDomain A] {σ ι : Type*} [Finite σ]
    [Finite ι] (K : Submodule (MvPolynomial σ A) (ι → MvPolynomial σ A)) :
    ∃ s : Finset (ι → MvPolynomial σ A), (s : Set (ι → MvPolynomial σ A)) ⊆ K ∧
      ∀ x ∈ K, ∃ b ∈ nonZeroDivisors A,
        b • x ∈ Submodule.span (MvPolynomial σ A) (s : Set (ι → MvPolynomial σ A)) := by
  classical
  let F := FractionRing A
  let P := MvPolynomial σ A
  let PK := MvPolynomial σ F
  let S : Submonoid P := (nonZeroDivisors A).map (MvPolynomial.C (σ := σ))
  let f : (ι → P) →ₗ[P] (ι → PK) := (Algebra.linearMap P PK).compLeft ι
  have hf : Function.Injective f := fun x y h ↦ funext fun i ↦
    MvPolynomial.map_injective _ (IsFractionRing.injective A F) (congrFun h i)
  obtain ⟨_, ⟨s, hsK, rfl⟩, hmax⟩ := set_has_maximal_iff_noetherian.mpr
    (inferInstance : IsNoetherian PK (ι → PK))
    {N | ∃ s : Finset (ι → P), (s : Set (ι → P)) ⊆ K ∧ N = Submodule.span PK (f '' s)}
    ⟨_, ∅, by simp, rfl⟩
  refine ⟨s, hsK, fun x hx ↦ ?_⟩
  -- A maximal `span` among finite subsets of `K` contains the image of all of `K`.
  have hfx : f x ∈ Submodule.span PK (f '' s) := by
    by_contra hnot
    refine hmax _ ⟨insert x s, ?_, rfl⟩
      (lt_of_le_of_ne (Submodule.span_mono (Set.image_mono ?_)) fun h ↦ hnot ?_)
    · rw [Finset.coe_insert, Set.insert_subset_iff]
      exact ⟨hx, hsK⟩
    · simp
    · rw [h]
      exact Submodule.subset_span ⟨x, by simp, rfl⟩
  rw [← Finset.coe_image, Submodule.mem_span_finset] at hfx
  obtain ⟨c, -, hc⟩ := hfx
  -- Clear the denominators of the coefficients.
  rw [Finset.sum_image fun y _ z _ h ↦ hf h] at hc
  obtain ⟨⟨b, hb⟩, hbc⟩ := IsLocalization.exist_integer_multiples_of_finset S
    (s.image fun y ↦ c (f y))
  choose a ha using fun y (hy : y ∈ s) ↦ hbc _ (Finset.mem_image_of_mem _ hy)
  obtain ⟨b, hb', rfl⟩ := hb
  refine ⟨b, hb', ?_⟩
  have key : f (∑ y ∈ s.attach, a y y.2 • y.1) = f (b • x) := by
    simp only [map_sum, map_smul] at ha ⊢
    rw [← IsScalarTower.algebraMap_smul P b x, map_smul, ← hc, Finset.smul_sum]
    rw [← Finset.sum_attach s]
    refine Finset.sum_congr rfl fun y _ ↦ ?_
    rw [← algebraMap_smul PK (a y y.2), ha y y.2, smul_assoc]
    rfl
  rw [← hf key]
  exact Submodule.sum_mem _ fun y _ ↦ Submodule.smul_mem _ _ (Submodule.subset_span y.2)

attribute [local instance] MvPolynomial.algebraMvPolynomial in
/-- Generic freeness over a domain for a finitely presented module over a polynomial ring. The
relations have coefficients in a finitely generated subring `R₀` of `A`, which is Noetherian; the
module is the base change of a module over `MvPolynomial σ R₀`, to which the Noetherian case
applies. -/
private theorem freeLocus_quotient_range_mem_nhds_bot [IsDomain A] {σ ι κ : Type*} [Finite σ]
    [Fintype ι] [Finite κ] (v : ι → κ → MvPolynomial σ A) :
    freeLocus A ((κ → MvPolynomial σ A) ⧸
      LinearMap.range (Fintype.linearCombination (MvPolynomial σ A) v)) ∈
        𝓝 ⟨⊥, Ideal.isPrime_bot⟩ := by
  classical
  have := Fintype.ofFinite κ
  -- The coefficients of the relations generate a Noetherian subring `R₀` of `A`.
  let R₀ : Subalgebra ℤ A := Algebra.adjoin ℤ
    (Finset.univ.biUnion fun i ↦ Finset.univ.biUnion fun k ↦ (v i k).coeffs : Finset A)
  have : Algebra.FiniteType ℤ R₀ := Algebra.FiniteType.adjoin_of_finite (Finset.finite_toSet _)
  have : IsNoetherianRing R₀ := Algebra.FiniteType.isNoetherianRing ℤ R₀
  let P₀ := MvPolynomial σ R₀
  let P := MvPolynomial σ A
  have hv (i : ι) (k : κ) : v i k ∈ Set.range (MvPolynomial.map (algebraMap R₀ A)) := by
    rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
    intro a ha
    exact ⟨⟨a, Algebra.subset_adjoin <| Finset.mem_coe.mpr <| Finset.mem_biUnion.mpr
      ⟨i, Finset.mem_univ _, Finset.mem_biUnion.mpr ⟨k, Finset.mem_univ _, ha⟩⟩⟩, rfl⟩
  choose w hw using hv
  -- The module is the base change of the cokernel `M₀` of the lifted relations.
  let f₀ := Fintype.linearCombination P₀ w
  let f₁ := Fintype.linearCombination P v
  let M₀ := (κ → P₀) ⧸ LinearMap.range f₀
  let M := (κ → P) ⧸ LinearMap.range f₁
  let h₁ : (ι → P₀) →ₗ[R₀] (ι → P) := (IsScalarTower.toAlgHom R₀ P₀ P).toLinearMap.compLeft ι
  let h₂ : (κ → P₀) →ₗ[R₀] (κ → P) := (IsScalarTower.toAlgHom R₀ P₀ P).toLinearMap.compLeft κ
  have comm₁ : h₂ ∘ₗ f₀.restrictScalars R₀ = (f₁.restrictScalars R₀) ∘ₗ h₁ := by
    refine LinearMap.ext fun c ↦ funext fun k ↦ ?_
    simp [h₁, h₂, f₀, f₁, P₀, P, Fintype.linearCombination_apply, Algebra.smul_def, hw]
  have hle : (LinearMap.range f₀).restrictScalars R₀ ≤
      LinearMap.ker ((LinearMap.range f₁).mkQ.restrictScalars R₀ ∘ₗ h₂) := by
    rintro _ ⟨c, rfl⟩
    have := congr($comm₁ c)
    simp only [LinearMap.coe_comp, LinearMap.coe_restrictScalars, Function.comp_apply] at this
    simp [this]
  let h₃ : M₀ →ₗ[R₀] M :=
    ((LinearMap.range f₀).restrictScalars R₀).liftQ _ hle ∘ₗ
      (Submodule.Quotient.restrictScalarsEquiv R₀ (LinearMap.range f₀)).symm.toLinearMap
  have comm₂ : h₃ ∘ₗ (LinearMap.range f₀).mkQ.restrictScalars R₀ =
      (((LinearMap.range f₁).mkQ.restrictScalars A).restrictScalars R₀) ∘ₗ h₂ :=
    LinearMap.ext fun x ↦
      Submodule.liftQ_apply ((LinearMap.range f₀).restrictScalars R₀)
        ((LinearMap.range f₁).mkQ.restrictScalars R₀ ∘ₗ h₂) (h := hle) x
  have hb₁ : IsBaseChange A h₁ := IsBaseChange.finitePow ι Algebra.IsPushout.out
  have hb₂ : IsBaseChange A h₂ := IsBaseChange.finitePow κ Algebra.IsPushout.out
  have e₀ : Function.Exact (f₀.restrictScalars R₀) ((LinearMap.range f₀).mkQ.restrictScalars R₀) :=
    LinearMap.exact_map_mkQ_range f₀
  have s₀ : Function.Surjective ((LinearMap.range f₀).mkQ.restrictScalars R₀) :=
    Submodule.mkQ_surjective (LinearMap.range f₀)
  have e₁ : Function.Exact (f₁.restrictScalars A) ((LinearMap.range f₁).mkQ.restrictScalars A) :=
    LinearMap.exact_map_mkQ_range f₁
  have s₁ : Function.Surjective ((LinearMap.range f₁).mkQ.restrictScalars A) :=
    Submodule.mkQ_surjective (LinearMap.range f₁)
  have hb₃ : IsBaseChange A h₃ := IsBaseChange.of_right_exact A h₁ h₂ h₃
    (f := f₀.restrictScalars R₀) (g := (LinearMap.range f₀).mkQ.restrictScalars R₀)
    (f' := f₁.restrictScalars A) (g' := (LinearMap.range f₁).mkQ.restrictScalars A)
    comm₁ comm₂ hb₁ hb₂ e₀ s₀ e₁ s₁
  have hbot : (⊥ : Ideal R₀) ∈ minimalPrimes R₀ := by
    rw [IsDomain.minimalPrimes_eq_singleton_bot]; rfl
  have h₀ := freeLocus_mem_nhds_of_mem_minimalPrimes (B := P₀) M₀ hbot
  have hcomap : PrimeSpectrum.comap (algebraMap R₀ A) ⟨⊥, Ideal.isPrime_bot⟩ =
      ⟨⊥, hbot.1.1⟩ := by
    ext1
    exact Ideal.comap_bot_of_injective _ Subtype.val_injective
  refine Filter.mem_of_superset
    ((PrimeSpectrum.continuous_comap (algebraMap R₀ A)).continuousAt.preimage_mem_nhds
      (hcomap ▸ h₀)) fun p hp ↦ ?_
  rw [← freeLocus_congr hb₃.equiv]
  exact comap_freeLocus_le hp

/-- Generic freeness over a domain for a finite module over a polynomial ring: present the module,
replace the relations by finitely many of them up to torsion, and apply the finitely presented
case. -/
private theorem freeLocus_mem_nhds_bot_mvPolynomial [IsDomain A] {σ : Type*} [Finite σ]
    (N : Type*) [AddCommGroup N] [Module (MvPolynomial σ A) N] [Module A N]
    [IsScalarTower A (MvPolynomial σ A) N] [Module.Finite (MvPolynomial σ A) N] :
    freeLocus A N ∈ 𝓝 ⟨⊥, Ideal.isPrime_bot⟩ := by
  classical
  obtain ⟨t, π, hπ⟩ := Module.Finite.exists_fin' (MvPolynomial σ A) N
  obtain ⟨s, hsK, hs⟩ := exists_finset_smul_mem_span_of_isDomain (LinearMap.ker π)
  let v : s → Fin t → MvPolynomial σ A := (↑)
  let f₁ := Fintype.linearCombination (MvPolynomial σ A) v
  have hrange : LinearMap.range f₁ = Submodule.span _ (s : Set (Fin t → MvPolynomial σ A)) := by
    rw [Fintype.range_linearCombination, Subtype.range_coe_subtype]
    rfl
  have hle : LinearMap.range f₁ ≤ LinearMap.ker π := hrange ▸ Submodule.span_le.mpr hsK
  let q := ((LinearMap.range f₁).liftQ π hle).restrictScalars A
  refine Filter.mem_of_superset (freeLocus_quotient_range_mem_nhds_bot v) fun p hp ↦
    mem_freeLocus_of_surjective_of_isTorsion q ?_ ?_ hp
  · intro y
    obtain ⟨x, rfl⟩ := hπ y
    exact ⟨Submodule.Quotient.mk x, rfl⟩
  · intro y hy
    induction y using Submodule.Quotient.induction_on with
    | H x =>
      obtain ⟨b, hb, hbx⟩ := hs x hy
      refine ⟨b, hb, ?_⟩
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, hrange]
      exact hbx

/-- **Generic freeness over a domain.** Let `A` be a domain, `B` a finitely generated `A`-algebra
and `M` a finite `B`-module. Then `M` is free over `A` on a neighbourhood of the generic point of
`Spec A`: there is a nonzero `a : A` such that `M_q` is free over `A_q` for every prime `q` not
containing `a`. Unlike `freeLocus_mem_nhds_of_mem_minimalPrimes`, `A` need not be Noetherian. -/
theorem freeLocus_mem_nhds_of_mem_minimalPrimes_of_isDomain [IsDomain A]
    {B : Type*} [CommRing B] [Algebra A B] [Algebra.FiniteType A B]
    (M : Type uM) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]
    [Module.Finite B M] {p : Ideal A} (hp : p ∈ minimalPrimes A) :
    freeLocus A M ∈ 𝓝 ⟨p, hp.1.1⟩ := by
  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType A B›
  refine freeLocus_mem_nhds_of_surjective f hf (fun N _ _ _ _ _ q hq ↦ ?_) M p hp
  obtain rfl : q = ⊥ := by simpa [IsDomain.minimalPrimes_eq_singleton_bot] using hq
  exact freeLocus_mem_nhds_bot_mvPolynomial (σ := Fin n) N

/-- **Generic freeness over a domain.** Let `A` be a domain, `B` a finitely generated `A`-algebra
and `M` a finite `B`-module. Then `M` is free over `A` on a dense open subset of `Spec A`. -/
theorem dense_interior_freeLocus_of_finiteType_of_isDomain [IsDomain A]
    {B : Type*} [CommRing B] [Algebra A B] [Algebra.FiniteType A B]
    (M : Type uM) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]
    [Module.Finite B M] : Dense (interior (freeLocus A M)) :=
  PrimeSpectrum.dense_of_forall_mem_minimalPrimes fun _ hp ↦
    mem_interior_iff_mem_nhds.mpr
      (freeLocus_mem_nhds_of_mem_minimalPrimes_of_isDomain (B := B) M hp)

end Module
