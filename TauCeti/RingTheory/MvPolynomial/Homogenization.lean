module

public import TauCeti.RingTheory.GradedAlgebra.HomogeneousLocalization.Dehomogenization
import TauCeti.RingTheory.MvPolynomial.Homogeneous

/-!
# The homogenization of an ideal of a polynomial ring

Let `J` be an ideal of `R[Y₀, …, Yₙ₋₁]` and `i : Fin (n + 1)`. Its homogenization with respect to
the coordinate `Xᵢ` is the homogeneous ideal `Jʰ` of `R[X₀, …, Xₙ]`, graded by total degree,
generated by the homogeneous polynomials whose dehomogenization `Xᵢ = 1`
(`TauCeti.dehomogenize i`) lies in `J`. It is the largest homogeneous ideal whose
dehomogenization is contained in `J` (`Ideal.le_homogenization_iff`), and a polynomial lies in
`Jʰ` exactly when all its homogeneous components dehomogenize into `J`
(`Ideal.mem_homogenization_iff`).

Dehomogenizing `Jʰ` recovers `J` (`Ideal.map_dehomogenize_homogenization`), because every
polynomial is the dehomogenization of a homogeneous one. The ideal `Jʰ` is saturated with respect
to `Xᵢ` (`Ideal.X_mul_mem_homogenization_iff`), so `Xᵢ` is a nonzerodivisor modulo `Jʰ`
(`Ideal.mk_X_mem_nonZeroDivisors_homogenization`).

Geometrically, `Proj (R[X₀, …, Xₙ] ⧸ Jʰ)` is the projective closure of the affine scheme
`Spec (R[Y₀, …, Yₙ₋₁] ⧸ J)`. Its standard chart `D₊(Xᵢ)` is the spectrum of the degree-zero part
of the localization away from `Xᵢ`, which is `R[Y₀, …, Yₙ₋₁] ⧸ J`
(`Ideal.homogenizationAwayEquiv`), and the chart is scheme-theoretically dense because `Xᵢ` is a
nonzerodivisor.

## Main definitions

* `Ideal.homogenization J i`: the homogenization of `J` with respect to `Xᵢ`.
* `Ideal.homogenizationAwayEquiv J i`: the degree-zero part of `(R[X₀, …, Xₙ] ⧸ Jʰ)[1/Xᵢ]` is
  `R[Y₀, …, Yₙ₋₁] ⧸ J`.

## Main results

* `Ideal.le_homogenization_iff`: a homogeneous ideal lies in `Jʰ` if and only if its
  dehomogenization lies in `J`.
* `Ideal.mem_homogenization_iff`: membership in `Jʰ` is tested on homogeneous components.
* `Ideal.map_dehomogenize_homogenization`: the dehomogenization of `Jʰ` is `J`.
* `Ideal.X_mul_mem_homogenization_iff`: `Jʰ` is saturated with respect to `Xᵢ`.

## References

* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Exercise I.2.9 (projective closure
  of an affine variety).
* D. Cox, J. Little, D. O'Shea, *Ideals, Varieties, and Algorithms*, 4th ed., Springer, 2015,
  Section 8.4 (the projective closure and homogenization of an ideal).
-/

public section

open MvPolynomial HomogeneousLocalization TauCeti

attribute [local instance] MvPolynomial.gradedAlgebra

namespace Ideal

variable {R : Type*} [CommRing R] {n : ℕ}

/-- The homogenization of an ideal `J` of `R[Y₀, …, Yₙ₋₁]` with respect to the coordinate `Xᵢ`:
the homogeneous ideal of `R[X₀, …, Xₙ]` generated by the homogeneous polynomials whose
dehomogenization at `Xᵢ = 1` lies in `J`. -/
noncomputable def homogenization (J : Ideal (MvPolynomial (Fin n) R)) (i : Fin (n + 1)) :
    HomogeneousIdeal (homogeneousSubmodule (Fin (n + 1)) R) :=
  (J.comap (dehomogenize i)).homogeneousCore (homogeneousSubmodule (Fin (n + 1)) R)

variable {J : Ideal (MvPolynomial (Fin n) R)} {i : Fin (n + 1)}

/-- **Universal property of the homogenization.** A homogeneous ideal lies in the homogenization
of `J` if and only if its dehomogenization lies in `J`. -/
theorem le_homogenization_iff {I : HomogeneousIdeal (homogeneousSubmodule (Fin (n + 1)) R)} :
    I ≤ J.homogenization i ↔ I.toIdeal.map (dehomogenize i) ≤ J := by
  rw [homogenization, ← (homogeneousCore.gc _).le_iff_le, map_le_iff_le_comap]

/-- Every element of the homogenization of `J` dehomogenizes into `J`. -/
theorem dehomogenize_mem_of_mem_homogenization {q : MvPolynomial (Fin (n + 1)) R}
    (hq : q ∈ J.homogenization i) : dehomogenize i q ∈ J :=
  (J.comap (dehomogenize i)).toIdeal_homogeneousCore_le _ hq

/-- A homogeneous polynomial lies in the homogenization of `J` if and only if its
dehomogenization lies in `J`. -/
theorem mem_homogenization_iff_of_isHomogeneous {q : MvPolynomial (Fin (n + 1)) R} {d : ℕ}
    (hq : q.IsHomogeneous d) :
    q ∈ J.homogenization i ↔ dehomogenize i q ∈ J :=
  ⟨dehomogenize_mem_of_mem_homogenization,
    fun h ↦ mem_homogeneousCore_of_homogeneous_of_mem ⟨d, hq⟩ h⟩

/-- A polynomial lies in the homogenization of `J` if and only if each of its homogeneous
components dehomogenizes into `J`. -/
theorem mem_homogenization_iff {q : MvPolynomial (Fin (n + 1)) R} :
    q ∈ J.homogenization i ↔ ∀ d, dehomogenize i (homogeneousComponent d q) ∈ J := by
  rw [← HomogeneousIdeal.mem_iff,
    mem_iff_homogeneousComponent_mem (J.homogenization i).isHomogeneous]
  exact forall_congr' fun d ↦
    mem_homogenization_iff_of_isHomogeneous (homogeneousComponent_isHomogeneous d q)

/-- **Dehomogenizing the homogenization of `J` recovers `J`.** -/
@[simp]
theorem map_dehomogenize_homogenization :
    (J.homogenization i).toIdeal.map (dehomogenize i) = J := by
  refine le_antisymm (le_homogenization_iff.mp le_rfl) fun p hp ↦ ?_
  obtain ⟨q, hq, rfl⟩ := exists_isHomogeneous_dehomogenize_eq i (le_refl p.totalDegree)
  exact mem_map_of_mem _ ((mem_homogenization_iff_of_isHomogeneous hq).mpr hp)

/-- **The homogenization is saturated with respect to `Xᵢ`.** -/
@[simp]
theorem X_mul_mem_homogenization_iff {q : MvPolynomial (Fin (n + 1)) R} :
    X i * q ∈ J.homogenization i ↔ q ∈ J.homogenization i := by
  refine ⟨fun h ↦ mem_homogenization_iff.mpr fun d ↦ ?_, Ideal.mul_mem_left _ _⟩
  -- The component of degree `d + 1` of `Xᵢ q` is `Xᵢ` times the component of degree `d` of `q`.
  have hc : homogeneousComponent (d + 1) (q * X i) = homogeneousComponent d q * X i := by
    simpa using (isHomogeneous_X R i).homogeneousComponent_mul_right q (d + 1)
  have := mem_homogenization_iff.mp h (d + 1)
  rwa [mul_comm, hc, map_mul, dehomogenize_X, Fin.insertNth_apply_same, mul_one] at this

/-- The class of `Xᵢ` is a nonzerodivisor modulo the homogenization of `J` with respect to
`Xᵢ`. -/
theorem mk_X_mem_nonZeroDivisors_homogenization :
    Ideal.Quotient.mk (J.homogenization i).toIdeal (X i) ∈
      nonZeroDivisors (MvPolynomial (Fin (n + 1)) R ⧸ (J.homogenization i).toIdeal) := by
  refine mem_nonZeroDivisors_iff_left.mpr fun x hx ↦ ?_
  obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [← map_mul] at hx
  rw [Ideal.Quotient.eq_zero_iff_mem] at hx ⊢
  exact X_mul_mem_homogenization_iff.mp hx

/-- **The standard chart of the projective closure.** The degree-zero part of the localization of
`R[X₀, …, Xₙ] ⧸ Jʰ` away from the class of `Xᵢ` is `R[Y₀, …, Yₙ₋₁] ⧸ J`. -/
noncomputable def homogenizationAwayEquiv (J : Ideal (MvPolynomial (Fin n) R)) (i : Fin (n + 1)) :
    Away (J.homogenization i).quotientGrading (Ideal.Quotient.mk (J.homogenization i).toIdeal (X i))
      ≃ₐ[R] MvPolynomial (Fin n) R ⧸ J :=
  ((J.homogenization i).awayEquivDehomogenize i).trans
    (quotientEquivAlgOfEq R map_dehomogenize_homogenization)

/-- `homogenizationAwayEquiv` sends the fraction `p / Xᵢᵐ` to the class of `p` with `Xᵢ` set to
`1`. -/
@[simp]
theorem homogenizationAwayEquiv_mk {m : ℕ} {p : MvPolynomial (Fin (n + 1)) R}
    (hp : Ideal.Quotient.mk (J.homogenization i).toIdeal p ∈
      (J.homogenization i).quotientGrading (m • 1)) :
    J.homogenizationAwayEquiv i
        (Away.mk _ ((J.homogenization i).mk_X_mem_quotientGrading i) m _ hp) =
      Ideal.Quotient.mk J (dehomogenize i p) := by
  simp [homogenizationAwayEquiv]

end Ideal
