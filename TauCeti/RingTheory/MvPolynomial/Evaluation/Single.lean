module

public import Mathlib.Algebra.MvPolynomial.Variables
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Single-variable evaluations vanishing on polynomial ideals

Evaluating a multivariate polynomial `p` at `Pi.single i t` (sending `X i` to `t` and every other
variable to `0`) reduces to its constant coefficient whenever `i ∉ p.vars`. Consequently, an ideal
generated by polynomials with zero constant coefficient that omit `X i` lies in the kernel of
`MvPolynomial.eval₂Hom f (Pi.single i t)`.

## Main results

* `MvPolynomial.span_le_ker_eval₂Hom_single`: if every `p ∈ s` has `constantCoeff p = 0` and
  `i ∉ p.vars`, then `Ideal.span s ≤ RingHom.ker (eval₂Hom f (Pi.single i t))`.
-/

public section

namespace MvPolynomial

/-- An ideal generated by polynomials with zero constant coefficient that do not involve `X i` is
killed by any evaluation sending `X i` to `t` and every other variable to `0`. -/
theorem span_le_ker_eval₂Hom_single {R S σ : Type*} [CommSemiring R] [CommSemiring S]
    [DecidableEq σ] (f : R →+* S) {s : Set (MvPolynomial σ R)} {i : σ} (t : S)
    (h0 : ∀ p ∈ s, constantCoeff p = 0) (hi : ∀ p ∈ s, i ∉ p.vars) :
    Ideal.span s ≤ RingHom.ker (eval₂Hom f (Pi.single i t)) := by
  refine Ideal.span_le.mpr fun p hp ↦ ?_
  have hvars : ∀ j ∈ p.vars, (Pi.single i t : σ → S) j = 0 := fun j hj ↦
    Pi.single_eq_of_ne (M := fun _ ↦ S) (ne_of_mem_of_not_mem hj (hi p hp)) t
  rw [SetLike.mem_coe, RingHom.mem_ker, eval₂Hom_eq_constantCoeff_of_vars f hvars,
    h0 p hp, map_zero]

end MvPolynomial
