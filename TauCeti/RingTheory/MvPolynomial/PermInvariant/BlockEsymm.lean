/-!
# Block elementary symmetric polynomials and the positive SAGBI direction

For a permutation subgroup `G ≤ Equiv.Perm σ` on a finite type `σ` and a commutative semiring `R`,
the elementary symmetric polynomials in the variables of each `G`-orbit
(`TauCeti.MvPolynomial.blockEsymm R G o j`) are `G`-invariant. Over any commutative semiring `R`
and for any monomial order `m : MonomialOrder σ`, the nontrivial block elementary symmetric
polynomials (`TauCeti.MvPolynomial.blockEsymmSet R G`) are monic and form a finite `m`-SAGBI basis
of `TauCeti.MvPolynomial.permInvariants R G` whenever `G` is generated by transpositions
(`MonomialOrder.isSAGBIBasis_blockEsymmSet`).

## Main definitions

* `TauCeti.MvPolynomial.blockEsymm`: the `j`-th elementary symmetric polynomial in the variables of
  a single `G`-orbit.
* `TauCeti.MvPolynomial.blockEsymmSet`: the finite set of nontrivial block elementary symmetric
  polynomials.

## Main results

* `TauCeti.MvPolynomial.blockEsymm_eq_sum`: finite-sum expansion of `blockEsymm R G o j`.
* `MonomialOrder.exists_equiv_fin_strictAnti_single`: any finite type injecting into `σ` admits
  an `m`-decreasing enumeration with respect to unit monomials.
* `MonomialOrder.degree_blockEsymm`, `MonomialOrder.leadingCoeff_blockEsymm`, and
  `MonomialOrder.leadingTerm_blockEsymm`: the `m`-degree, leading coefficient, and leading term of
  `blockEsymm R G o j` with respect to any `m`-decreasing enumeration of the orbit `o`.
* `MonomialOrder.isSAGBIBasis_blockEsymmSet`: if `G` is generated by transpositions, the block
  elementary symmetric polynomials form a finite `m`-SAGBI basis over any commutative semiring `R`.
-/

public section

open Equiv

/-! ### Block elementary symmetric polynomials -/

namespace TauCeti.MvPolynomial

open _root_.MvPolynomial

variable {σ : Type*}

/-- The `j`-th elementary symmetric polynomial in the variables belonging to a single `G`-orbit
`o`. -/
noncomputable def blockEsymm [Finite σ] (R : Type*) [CommSemiring R] (G : Subgroup (Perm σ))
    (o : MulAction.orbitRel.Quotient G σ) (j : ℕ) : MvPolynomial σ R :=
  letI : Fintype {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} := Fintype.ofFinite _
  rename Subtype.val (esymm {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} R j)

/-- Defining formula for a block elementary symmetric polynomial with an explicit `Fintype`
instance on the orbit. -/
theorem blockEsymm_def [Finite σ] (R : Type*) [CommSemiring R] (G : Subgroup (Perm σ))
    (o : MulAction.orbitRel.Quotient G σ) (j : ℕ)
    [Fintype {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}] :
    blockEsymm R G o j =
      rename Subtype.val (esymm {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} R j) := by
  rw [blockEsymm, Subsingleton.elim (Fintype.ofFinite _) ‹_›]

/-- Finite-sum expansion of a block elementary symmetric polynomial. -/
theorem blockEsymm_eq_sum [Finite σ] (R : Type*) [CommSemiring R] (G : Subgroup (Perm σ))
    (o : MulAction.orbitRel.Quotient G σ) (j : ℕ)
    [Fintype {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}] :
    blockEsymm R G o j =
      ∑ T ∈ (Finset.univ :
          Finset {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}).powersetCard j,
        monomial (∑ i ∈ T, Finsupp.single (i : σ) 1) (1 : R) := by
  rw [blockEsymm_def, esymm_eq_sum_monomial, map_sum]
  simp_rw [rename_monomial, Finsupp.mapDomain_finsetSum, Finsupp.mapDomain_single]

/-- The `0`-th block elementary symmetric polynomial on any orbit is `1`. -/
@[simp]
theorem blockEsymm_zero [Finite σ] (R : Type*) [CommSemiring R] (G : Subgroup (Perm σ))
    (o : MulAction.orbitRel.Quotient G σ) :
    blockEsymm R G o 0 = 1 := by
  rw [blockEsymm, esymm_zero, map_one]

/-- A block elementary symmetric polynomial vanishes when the degree exceeds the orbit size. -/
@[simp]
theorem blockEsymm_eq_zero_of_lt [Finite σ] (R : Type*) [CommSemiring R] (G : Subgroup (Perm σ))
    (o : MulAction.orbitRel.Quotient G σ) {j : ℕ}
    (hj : Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} < j) :
    blockEsymm R G o j = 0 := by
  let _ : Fintype {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} := Fintype.ofFinite _
  rw [blockEsymm_eq_sum, Finset.powersetCard_eq_empty.mpr
    (by simpa [Nat.card_eq_fintype_card] using hj), Finset.sum_empty]

/-- A block elementary symmetric polynomial is invariant under `G`. -/
theorem blockEsymm_mem_permInvariants [Finite σ] (R : Type*) [CommSemiring R]
    (G : Subgroup (Perm σ)) (o : MulAction.orbitRel.Quotient G σ) (j : ℕ) :
    blockEsymm R G o j ∈ permInvariants R G := by
  rw [mem_permInvariants]
  intro g hg
  let _ : Fintype {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} := Fintype.ofFinite _
  have hfib := TauCeti.mem_fiberSubgroup.mp (G.le_fiberSubgroup_orbitRel hg)
  let go : Perm {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} :=
    g.subtypePerm fun i => by rw [hfib i]
  have hcomp : (⇑g ∘ Subtype.val) = Subtype.val ∘ ⇑go :=
    funext fun i => congrArg Subtype.val (g.subtypePerm_apply _ i).symm
  rw [blockEsymm, rename_rename, hcomp, ← rename_rename, esymm_isSymmetric _ _ _ go]

/-- The set of nontrivial block elementary symmetric polynomials `blockEsymm R G o j` as `o` ranges
over the `G`-orbits of `σ` and `1 ≤ j ≤ |o|`. -/
def blockEsymmSet [Finite σ] (R : Type*) [CommSemiring R] (G : Subgroup (Perm σ)) :
    Set (MvPolynomial σ R) :=
  {p | ∃ (o : MulAction.orbitRel.Quotient G σ) (j : ℕ),
    1 ≤ j ∧ j ≤ Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} ∧
      p = blockEsymm R G o j}

/-- Membership characterization for `blockEsymmSet R G`. -/
@[simp]
theorem mem_blockEsymmSet_iff [Finite σ] (R : Type*) [CommSemiring R] (G : Subgroup (Perm σ))
    {p : MvPolynomial σ R} :
    p ∈ blockEsymmSet R G ↔
      ∃ (o : MulAction.orbitRel.Quotient G σ) (j : ℕ),
        1 ≤ j ∧ j ≤ Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} ∧
          p = blockEsymm R G o j :=
  Iff.rfl

theorem blockEsymmSet_subset_permInvariants [Finite σ] (R : Type*) [CommSemiring R]
    (G : Subgroup (Perm σ)) :
    blockEsymmSet R G ⊆ (permInvariants R G : Set (MvPolynomial σ R)) := by
  rintro _ ⟨o, j, -, -, rfl⟩
  exact blockEsymm_mem_permInvariants R G o j

theorem blockEsymmSet_finite [Finite σ] (R : Type*) [CommSemiring R] (G : Subgroup (Perm σ)) :
    (blockEsymmSet R G).Finite := by
  cases nonempty_fintype σ
  have : Finite (MulAction.orbitRel.Quotient G σ) := Quotient.finite _
  refine (Set.finite_univ.image fun p : MulAction.orbitRel.Quotient G σ × Fin (Fintype.card σ + 1)
      => blockEsymm R G p.fst p.snd).subset ?_
  rintro _ ⟨o, j, -, hj, rfl⟩
  have hle : Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} ≤ Fintype.card σ := by
    let _ : Fintype {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} := Fintype.ofFinite _
    rw [Nat.card_eq_fintype_card]; exact Fintype.card_subtype_le _
  exact ⟨(o, ⟨j, by omega⟩), Set.mem_univ _, rfl⟩

end TauCeti.MvPolynomial

/-! ### Leading terms and the positive SAGBI direction -/

namespace MonomialOrder

open MvPolynomial TauCeti.MvPolynomial

section Positive

variable {σ R : Type*}

/-- Expansion, `m`-degree, and leading coefficient `1` for `blockEsymm R G o j` with respect to an
`m`-decreasing enumeration `x` of the orbit `o`. -/
private theorem degree_blockEsymm_and_coeff [Finite σ] (m : MonomialOrder σ)
    (R : Type*) [CommSemiring R] [Nontrivial R] (G : Subgroup (Perm σ))
    (o : MulAction.orbitRel.Quotient G σ) (j : ℕ)
    (hj : j ≤ Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o})
    (x : Fin (Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}) ≃
      {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o})
    (hx : ∀ {k₁ k₂}, k₁ < k₂ →
      Finsupp.single (x k₂ : σ) 1 ≺[m] Finsupp.single (x k₁ : σ) 1) :
    m.degree (blockEsymm R G o j) =
      ∑ k : Fin j, Finsupp.single (x (Fin.castLE hj k) : σ) 1 ∧
      (blockEsymm R G o j).coeff
        (∑ k : Fin j, Finsupp.single (x (Fin.castLE hj k) : σ) 1) = 1 := by
  classical
  let _ : Fintype {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} := Fintype.ofFinite _
  let S := {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}
  let e : Finset S → (σ →₀ ℕ) := fun T => ∑ i ∈ T, Finsupp.single (i : σ) 1
  have he_inj : Function.Injective e :=
    Finsupp.finsetSum_single_injective Subtype.val_injective fun _ => one_ne_zero
  let T0 : Finset S := Finset.univ.image fun k : Fin j => x (Fin.castLE hj k)
  have hT0_inj : Function.Injective fun k : Fin j => x (Fin.castLE hj k) :=
    x.injective.comp (Fin.castLE_injective hj)
  have hT0_mem : T0 ∈ (Finset.univ : Finset S).powersetCard j :=
    Finset.mem_powersetCard.mpr ⟨Finset.subset_univ _, by
      rw [Finset.card_image_of_injective _ hT0_inj, Finset.card_univ, Fintype.card_fin]⟩
  have hcoeff_T0 : (blockEsymm R G o j).coeff (e T0) = 1 := by
    rw [blockEsymm_eq_sum, coeff_sum]
    simp_rw [coeff_monomial]
    rw [Finset.sum_congr rfl fun T _ =>
      if_congr (he_inj.eq_iff : e T = e T0 ↔ T = T0) rfl rfl]
    rw [Finset.sum_ite_eq']
    simp [hT0_mem]
  have hsupp : (blockEsymm R G o j).support = (Finset.univ.powersetCard j).image e := by
    rw [blockEsymm_def, support_rename_of_injective Subtype.val_injective, support_esymm,
      Finset.image_image]
    refine Finset.image_congr fun T _ => ?_
    simp only [Function.comp_apply, Finsupp.mapDomain_finsetSum, Finsupp.mapDomain_single]
    rfl
  have hdeg : m.degree (blockEsymm R G o j) = e T0 := by
    apply m.toSyn.injective
    refine le_antisymm (m.degree_le_iff.2 fun d hd => ?_) (m.le_degree <| by simp [hcoeff_T0])
    rw [hsupp] at hd
    obtain ⟨T, hT, rfl⟩ := Finset.mem_image.mp hd
    rcases eq_or_ne T T0 with rfl | hne
    · exact le_rfl
    · simp only [e, map_sum]
      exact (TauCeti.sum_lt_sum_image_castLE_of_strictAnti
        (fun i : S => m.toSyn (Finsupp.single (i : σ) 1)) x (fun _ _ h => hx h) hj
        (Finset.mem_powersetCard.mp hT).right hne).le
  have heT0 : e T0 = ∑ k : Fin j, Finsupp.single (x (Fin.castLE hj k) : σ) 1 :=
    Finset.sum_image fun _ _ _ _ h => hT0_inj h
  exact ⟨hdeg.trans heT0, heT0 ▸ hcoeff_T0⟩

/-- The `m`-degree of `blockEsymm R G o j` (`j ≤ |o|`) with respect to any `m`-decreasing
enumeration `e` of the orbit `o` is the sum of the `j` largest unit vectors. -/
theorem degree_blockEsymm [Finite σ] (m : MonomialOrder σ) (R : Type*) [CommSemiring R]
    [Nontrivial R] (G : Subgroup (Perm σ)) (o : MulAction.orbitRel.Quotient G σ) (j : ℕ)
    (hj : j ≤ Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o})
    (e : Fin (Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}) ≃
      {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o})
    (he : ∀ {k₁ k₂}, k₁ < k₂ →
      Finsupp.single (e k₂ : σ) 1 ≺[m] Finsupp.single (e k₁ : σ) 1) :
    m.degree (blockEsymm R G o j) =
      ∑ k : Fin j, Finsupp.single (e (Fin.castLE hj k) : σ) 1 :=
  (degree_blockEsymm_and_coeff m R G o j hj e he).left

/-- Any finite type `S` injecting into `σ` admits an `m`-decreasing enumeration
`Fin (Nat.card S) ≃ S` with respect to the unit monomials `Finsupp.single (f i) 1`. -/
theorem exists_equiv_fin_strictAnti_single {S : Type*} [Finite S] (m : MonomialOrder σ)
    {f : S → σ} (hf : Function.Injective f) :
    ∃ x : Fin (Nat.card S) ≃ S,
      ∀ {k₁ k₂}, k₁ < k₂ → Finsupp.single (f (x k₂)) 1 ≺[m] Finsupp.single (f (x k₁)) 1 := by
  have hk : Function.Injective fun i : S => m.toSyn (Finsupp.single (f i) 1) := fun _ _ h =>
    hf ((Finsupp.single_left_inj (one_ne_zero : (1 : ℕ) ≠ 0)).mp (m.toSyn.injective h))
  obtain ⟨x, hx⟩ := Finite.exists_equiv_fin_strictAnti hk
  exact ⟨x, fun h => hx h⟩

/-- A nontrivial block elementary symmetric polynomial `blockEsymm R G o j` (`j ≤ |o|`) is monic
for every monomial order `m`. -/
@[simp]
theorem leadingCoeff_blockEsymm [Finite σ] (m : MonomialOrder σ) (R : Type*) [CommSemiring R]
    [Nontrivial R] (G : Subgroup (Perm σ)) (o : MulAction.orbitRel.Quotient G σ) (j : ℕ)
    (hj : j ≤ Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}) :
    m.leadingCoeff (blockEsymm R G o j) = 1 := by
  obtain ⟨x, hx⟩ := m.exists_equiv_fin_strictAnti_single (Subtype.val_injective (p :=
    fun i : σ => Quotient.mk (MulAction.orbitRel G σ) i = o))
  have h := degree_blockEsymm_and_coeff m R G o j hj x hx
  rw [leadingCoeff, h.left, h.right]

/-- The `m`-leading term of `blockEsymm R G o j` (`j ≤ |o|`) with respect to any `m`-decreasing
enumeration `e` of the orbit `o` is the monic product of its `j` largest variables. -/
theorem leadingTerm_blockEsymm [Finite σ] (m : MonomialOrder σ) (R : Type*) [CommSemiring R]
    [Nontrivial R] (G : Subgroup (Perm σ)) (o : MulAction.orbitRel.Quotient G σ) (j : ℕ)
    (hj : j ≤ Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o})
    (e : Fin (Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}) ≃
      {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o})
    (he : ∀ {k₁ k₂}, k₁ < k₂ →
      Finsupp.single (e k₂ : σ) 1 ≺[m] Finsupp.single (e k₁ : σ) 1) :
    m.leadingTerm (blockEsymm R G o j) =
      monomial (∑ k : Fin j, Finsupp.single (e (Fin.castLE hj k) : σ) 1) (1 : R) := by
  rw [leadingTerm, m.degree_blockEsymm R G o j hj e he, m.leadingCoeff_blockEsymm R G o j hj]

/-- If `d` is `m`-maximal in its `G`-orbit and `Equiv.swap a b ∈ G` with `X_a ≺_m X_b`, then
`d a ≤ d b`. -/
private theorem apply_le_of_swap_mem_of_mem_maxOrbitExponents [DecidableEq σ]
    (m : MonomialOrder σ) {G : Subgroup (Perm σ)} {d : σ →₀ ℕ}
    (hd : d ∈ m.maxOrbitExponents G) {a b : σ} (hswap : swap a b ∈ G)
    (hsingle : Finsupp.single a 1 ≺[m] Finsupp.single b 1) :
    d a ≤ d b := by
  by_contra! hlt
  let k : ℕ := d a - d b
  have hk : 0 < k := Nat.sub_pos_of_lt hlt
  have hab : a ≠ b := fun h => by rw [h] at hlt; exact lt_irrefl _ hlt
  have heq : d + k • Finsupp.single b 1 =
      d.mapDomain (swap a b) + k • Finsupp.single a 1 := by
    ext x
    simp only [Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, Finsupp.single_apply,
      ← Finsupp.equivMapDomain_eq_mapDomain, Finsupp.equivMapDomain_apply, Equiv.symm_swap]
    by_cases hxa : x = a
    · subst hxa; simp [hab.symm, k]; omega
    · by_cases hxb : x = b
      · subst hxb; simp [hab, k]; omega
      · simp [swap_apply_of_ne_of_ne hxa hxb, Ne.symm hxa, Ne.symm hxb]
  have hstrict : m.toSyn (d.mapDomain (swap a b) + k • Finsupp.single a 1) <
      m.toSyn (d + k • Finsupp.single b 1) := by
    rw [map_add, map_add, map_nsmul, map_nsmul]
    exact add_lt_add_of_le_of_lt ((m.mem_maxOrbitExponents_iff G d).mp hd (swap a b) hswap)
      (nsmul_lt_nsmul_right hk.ne' hsingle)
  exact (ne_of_lt hstrict) (congrArg m.toSyn heq.symm)

/-- On a single `G`-orbit `o`, any `m`-maximal exponent for a transposition-generated subgroup `G`
telescopes as a nonnegative integer combination of prefix sums of the sorted orbit variables. -/
private theorem orbit_part_monomial_mem_adjoin [Finite σ] [DecidableEq σ] (m : MonomialOrder σ)
    (R : Type*) [CommSemiring R] [Nontrivial R] (G : Subgroup (Perm σ))
    (hG : Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} = G)
    {d : σ →₀ ℕ} (hd : d ∈ m.maxOrbitExponents G) (o : MulAction.orbitRel.Quotient G σ)
    (orb : Finset σ) (horb_mem : ∀ i : σ, i ∈ orb ↔ Quotient.mk (MulAction.orbitRel G σ) i = o) :
    monomial (∑ i ∈ orb, Finsupp.single i (d i)) (1 : R) ∈
      Algebra.adjoin R (m.leadingTerm '' blockEsymmSet R G) := by
  let _ : Fintype {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} := Fintype.ofFinite _
  let S := {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}
  obtain ⟨x, hx⟩ := m.exists_equiv_fin_strictAnti_single (Subtype.val_injective (p :=
    fun i : σ => Quotient.mk (MulAction.orbitRel G σ) i = o))
  have hanti : Antitone (fun k : Fin (Nat.card S) => d (x k : σ)) := fun k₁ k₂ hk' => by
    rcases eq_or_lt_of_le hk' with rfl | hlt
    · exact le_rfl
    · exact apply_le_of_swap_mem_of_mem_maxOrbitExponents m hd
        (G.swap_mem_of_orbitRel_of_closure_isSwap_eq hG
          (Quotient.exact ((x k₂).property.trans (x k₁).property.symm)))
        (hx hlt)
  obtain ⟨w, hw⟩ := Fin.exists_forall_eq_sum_filter_le_of_antitone (fun k => d (x k : σ)) hanti
  have horb_eq : (∑ i ∈ orb, Finsupp.single i (d i)) =
      ∑ k : Fin (Nat.card S), Finsupp.single (x k : σ) (d (x k : σ)) :=
    Finset.sum_bij (fun i hi => x.symm ⟨i, (horb_mem i).mp hi⟩) (fun _ _ => Finset.mem_univ _)
      (fun _ _ _ _ h => Subtype.mk.inj (x.symm.injective h))
      (fun k _ => ⟨x k, (horb_mem _).mpr (x k).property, by simp⟩)
      (fun _ _ => by simp)
  rw [horb_eq, Finsupp.finsetSum_single_eq_sum_smul_prefix (fun k => (x k : σ)) _ w hw,
    monomial_sum_one]
  refine Subalgebra.prod_mem _ fun k _ => ?_
  have hpow : monomial (w k • ∑ t : Fin ((k : ℕ) + 1),
        Finsupp.single (x (Fin.castLE (Nat.succ_le_of_lt k.isLt) t) : σ) 1) (1 : R) =
      (monomial (∑ t : Fin ((k : ℕ) + 1),
        Finsupp.single (x (Fin.castLE (Nat.succ_le_of_lt k.isLt) t) : σ) 1) (1 : R)) ^ w k := by
    rw [monomial_pow, one_pow]
  rw [hpow]
  refine Subalgebra.pow_mem _ ?_ _
  have hcard_le : (k : ℕ) + 1 ≤ Nat.card S := Nat.succ_le_of_lt k.isLt
  rw [← m.leadingTerm_blockEsymm R G o ((k : ℕ) + 1) hcard_le x hx]
  exact Algebra.subset_adjoin ⟨blockEsymm R G o ((k : ℕ) + 1),
    ⟨o, (k : ℕ) + 1, Nat.succ_pos _, hcard_le, rfl⟩, rfl⟩

/-- **Positive direction of the permutation SAGBI criterion.** If `G ≤ Equiv.Perm σ` is generated by
transpositions on a finite type `σ`, then for every monomial order `m` and every commutative
semiring `R`, the finite set `TauCeti.MvPolynomial.blockEsymmSet R G` of block elementary symmetric
polynomials is an `m`-SAGBI basis of `TauCeti.MvPolynomial.permInvariants R G`. -/
theorem isSAGBIBasis_blockEsymmSet [Finite σ] [DecidableEq σ] (m : MonomialOrder σ)
    (R : Type*) [CommSemiring R] (G : Subgroup (Perm σ))
    (hG : Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} = G) :
    m.IsSAGBIBasis (blockEsymmSet R G) (permInvariants R G) := by
  classical
  cases nonempty_fintype σ
  rw [isSAGBIBasis_iff_initialAlgebra_le]
  refine ⟨blockEsymmSet_subset_permInvariants R G, ?_⟩
  rcases subsingleton_or_nontrivial R with _ | _
  · intro p _; rw [Subsingleton.elim p 0]; exact zero_mem _
  rw [initialAlgebra_def, Algebra.adjoin_le_iff]
  rintro _ ⟨p, hp, rfl⟩
  rcases eq_or_ne p 0 with rfl | _
  · simp
  let d : σ →₀ ℕ := m.degree p
  have hd : d ∈ m.maxOrbitExponents G := (m.mem_maxOrbitExponents_iff G d).mpr fun g hg =>
    m.toSyn_mapDomain_degree_le_of_mem_permInvariants hp hg
  let _ : Fintype (MulAction.orbitRel.Quotient G σ) := Fintype.ofFinite _
  let orb : MulAction.orbitRel.Quotient G σ → Finset σ :=
    fun o => Finset.univ.filter fun i : σ => Quotient.mk (MulAction.orbitRel G σ) i = o
  have horb_mem : ∀ o i, i ∈ orb o ↔ Quotient.mk (MulAction.orbitRel G σ) i = o :=
    fun _ _ => by simp [orb]
  have hd_eq : d = ∑ o : MulAction.orbitRel.Quotient G σ,
      ∑ i ∈ orb o, Finsupp.single i (d i) :=
    (Finsupp.univ_sum_single d).symm.trans
      (Finset.sum_fiberwise Finset.univ (Quotient.mk (MulAction.orbitRel G σ))
        (fun i => Finsupp.single i (d i))).symm
  have hmon : monomial d (1 : R) ∈ Algebra.adjoin R (m.leadingTerm '' blockEsymmSet R G) := by
    rw [hd_eq, monomial_sum_one]
    exact Subalgebra.prod_mem _ fun o _ =>
      orbit_part_monomial_mem_adjoin m R G hG hd o (orb o) (horb_mem o)
  rw [leadingTerm, ← mul_one (m.leadingCoeff p), ← smul_eq_mul, ← smul_monomial]
  exact Subalgebra.smul_mem _ hmon _

end Positive

end MonomialOrder
