/-!
# Block elementary symmetric polynomials and the positive SAGBI direction

For a permutation subgroup `G ≤ Equiv.Perm σ` and a monomial order `m : MonomialOrder σ`, the
additive submonoid `MonomialOrder.maxOrbitExponents m G` consists of the exponent vectors
`d : σ →₀ ℕ` that are `m`-maximal in their `G`-orbit. It equals
`m.leadingExponents (MvPolynomial.permInvariantSubalgebra G R)` over any nontrivial commutative
semiring without zero divisors, and is finitely generated whenever
`MvPolynomial.permInvariantSubalgebra G R` has a finite `m`-SAGBI basis.

Conversely, over an arbitrary commutative semiring `R`, when `G` is generated by transpositions on a
finite type `σ`, the elementary symmetric polynomials in the variables of each `G`-orbit
(`MvPolynomial.blockEsymm`) are monic and form a finite `m`-SAGBI basis
(`MonomialOrder.isSAGBIBasis_blockEsymmSet`).

## Main definitions

* `MonomialOrder.maxOrbitExponents`: the additive submonoid of `m`-maximal orbit exponents.
* `MvPolynomial.blockEsymm`: the `j`-th elementary symmetric polynomial in the variables of a
  single `G`-orbit.
* `MvPolynomial.blockEsymmSet`: the finite set of nontrivial block elementary symmetric polynomials.

## Main results

* `MonomialOrder.leadingExponents_permInvariantSubalgebra_eq`:
  `m.leadingExponents (permInvariantSubalgebra G R) = m.maxOrbitExponents G`.
* `MonomialOrder.degree_blockEsymm`, `MonomialOrder.leadingCoeff_blockEsymm`, and
  `MonomialOrder.leadingTerm_blockEsymm`: the `m`-degree, leading coefficient, and leading term of
  `blockEsymm G R o j` with respect to any `m`-decreasing enumeration of the orbit `o`.
* `MonomialOrder.isSAGBIBasis_blockEsymmSet`: if `G` is generated by transpositions, the block
  elementary symmetric polynomials form a finite `m`-SAGBI basis over any commutative semiring `R`.
-/

public section

open Equiv

/-! ### The monoid of `m`-maximal orbit exponents -/

namespace MonomialOrder

open MvPolynomial

variable {σ R : Type*}

/-- The additive submonoid of exponent vectors `d : σ →₀ ℕ` that are `m`-maximal in their
`G`-orbit. -/
def maxOrbitExponents (m : MonomialOrder σ) (G : Subgroup (Perm σ)) : AddSubmonoid (σ →₀ ℕ) where
  carrier := {d | ∀ g ∈ G, d.equivMapDomain g ≼[m] d}
  zero_mem' g _ := by simp
  add_mem' {a b} ha hb g hg := by
    have hadd : (a + b).equivMapDomain g = a.equivMapDomain g + b.equivMapDomain g := by
      simp [Finsupp.equivMapDomain_eq_mapDomain, Finsupp.mapDomain_add]
    rw [hadd, map_add, map_add]
    exact add_le_add (ha g hg) (hb g hg)

@[simp]
theorem mem_maxOrbitExponents_iff (m : MonomialOrder σ) (G : Subgroup (Perm σ)) (d : σ →₀ ℕ) :
    d ∈ m.maxOrbitExponents G ↔ ∀ g ∈ G, d.equivMapDomain g ≼[m] d :=
  Iff.rfl

/-- The leading-exponent monoid of `permInvariantSubalgebra G R` is `m.maxOrbitExponents G`. -/
theorem leadingExponents_permInvariantSubalgebra_eq (m : MonomialOrder σ)
    (G : Subgroup (Perm σ)) [Finite G] (R : Type*) [CommSemiring R] [NoZeroDivisors R]
    [Nontrivial R] :
    m.leadingExponents (permInvariantSubalgebra G R) = m.maxOrbitExponents G :=
  AddSubmonoid.ext fun _ => m.mem_leadingExponents_permInvariantSubalgebra_iff

end MonomialOrder

/-! ### Block elementary symmetric polynomials and the positive SAGBI direction -/

namespace MvPolynomial

variable {σ R : Type*}

/-- The `j`-th elementary symmetric polynomial in the variables belonging to a single `G`-orbit
`o`. -/
noncomputable def blockEsymm [Finite σ] (G : Subgroup (Perm σ)) (R : Type*) [CommSemiring R]
    (o : MulAction.orbitRel.Quotient G σ) (j : ℕ) : MvPolynomial σ R :=
  letI : Fintype {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} := Fintype.ofFinite _
  rename Subtype.val (esymm {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} R j)

/-- A block elementary symmetric polynomial is invariant under `G`. -/
theorem blockEsymm_mem_permInvariantSubalgebra [Finite σ] (G : Subgroup (Perm σ))
    [CommSemiring R] (o : MulAction.orbitRel.Quotient G σ) (j : ℕ) :
    blockEsymm G R o j ∈ permInvariantSubalgebra G R := by
  rw [mem_permInvariantSubalgebra]
  intro g hg
  let _ : Fintype {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} := Fintype.ofFinite _
  have hfib := TauCeti.mem_fiberSubgroup.mp (G.le_fiberSubgroup_orbitRel hg)
  let go : Perm {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} :=
    g.subtypePerm fun i => by rw [hfib i]
  have hcomp : (⇑g ∘ Subtype.val) = Subtype.val ∘ ⇑go :=
    funext fun i => congrArg Subtype.val (g.subtypePerm_apply _ i).symm
  rw [blockEsymm, rename_rename, hcomp, ← rename_rename, esymm_isSymmetric _ _ _ go]

/-- The set of nontrivial block elementary symmetric polynomials `blockEsymm G R o j` as `o` ranges
over the `G`-orbits of `σ` and `1 ≤ j ≤ |o|`. -/
def blockEsymmSet [Finite σ] (G : Subgroup (Perm σ)) (R : Type*) [CommSemiring R] :
    Set (MvPolynomial σ R) :=
  {p | ∃ (o : MulAction.orbitRel.Quotient G σ) (j : ℕ),
    1 ≤ j ∧ j ≤ Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} ∧
      p = blockEsymm G R o j}

theorem blockEsymmSet_subset_permInvariantSubalgebra [Finite σ] (G : Subgroup (Perm σ))
    (R : Type*) [CommSemiring R] :
    blockEsymmSet G R ⊆ (permInvariantSubalgebra G R : Set (MvPolynomial σ R)) := by
  rintro _ ⟨o, j, -, -, rfl⟩
  exact blockEsymm_mem_permInvariantSubalgebra G o j

theorem blockEsymmSet_finite [Finite σ] (G : Subgroup (Perm σ)) (R : Type*) [CommSemiring R] :
    (blockEsymmSet G R).Finite := by
  cases nonempty_fintype σ
  have : Finite (MulAction.orbitRel.Quotient G σ) := Quotient.finite _
  refine (Set.finite_univ.image fun p : MulAction.orbitRel.Quotient G σ × Fin (Fintype.card σ + 1)
      => blockEsymm G R p.1 p.2).subset ?_
  rintro _ ⟨o, j, -, hj, rfl⟩
  have hle : Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} ≤ Fintype.card σ := by
    let _ : Fintype {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} := Fintype.ofFinite _
    rw [Nat.card_eq_fintype_card]; exact Fintype.card_subtype_le _
  exact ⟨(o, ⟨j, by omega⟩), Set.mem_univ _, rfl⟩

end MvPolynomial

namespace MonomialOrder

open MvPolynomial

section Positive

variable {σ R : Type*}

/-- Ordering a finite subtype `S ↪ σ` in strictly decreasing `m`-order of unit vectors. -/
private noncomputable def sortOrbitDesc (m : MonomialOrder σ) (S : Type*) [Finite S]
    (emb : S ↪ σ) :
    { e : Fin (Nat.card S) ≃ S //
      ∀ {k₁ k₂}, k₁ < k₂ → Finsupp.single (emb (e k₂)) 1 ≺[m] Finsupp.single (emb (e k₁)) 1 } := by
  classical
  let _ : Fintype S := Fintype.ofFinite S
  let f : S → m.syn := fun i => m.toSyn (Finsupp.single (emb i) 1)
  have hf : Function.Injective f := fun _ _ hab =>
    emb.injective ((Finsupp.single_left_inj (one_ne_zero : (1 : ℕ) ≠ 0)).mp (m.toSyn.injective hab))
  let img : Finset m.syn := Finset.univ.image f
  have hcard : img.card = Nat.card S := by
    rw [Finset.card_image_of_injective _ hf, Finset.card_univ, Nat.card_eq_fintype_card]
  let ord : Fin (Nat.card S) ↪o m.syn := img.orderEmbOfFin hcard
  let g : Fin (Nat.card S) → S :=
    fun k => (Finset.mem_image.mp (Finset.orderEmbOfFin_mem img hcard k.rev)).choose
  have hfg : ∀ k, f (g k) = ord k.rev :=
    fun k => (Finset.mem_image.mp (Finset.orderEmbOfFin_mem img hcard k.rev)).choose_spec.2
  have hg_inj : Function.Injective g := fun k₁ k₂ h =>
    Fin.rev_injective (ord.injective (by rw [← hfg k₁, ← hfg k₂, h]))
  refine ⟨Equiv.ofBijective g ((Fintype.bijective_iff_injective_and_card g).mpr
    ⟨hg_inj, by rw [Fintype.card_fin, Nat.card_eq_fintype_card]⟩), fun {k₁ k₂} hk => ?_⟩
  -- Unfold `≺[m]` to `<` on `m.syn`, matching the definition of `f`.
  change f (g k₂) < f (g k₁)
  rw [hfg k₂, hfg k₁]
  exact ord.strictMono (Fin.rev_lt_rev.mpr hk)

/-- Among all `j`-element subsets of `S ↪ σ`, the `j` largest elements for `m` uniquely maximize
the sum of their unit vectors. -/
private theorem sum_single_lt_topPrefix (m : MonomialOrder σ) {S : Type*} [Finite S]
    [DecidableEq S] (emb : S ↪ σ) (x : Fin (Nat.card S) ≃ S)
    (hx : ∀ {k₁ k₂}, k₁ < k₂ →
      Finsupp.single (emb (x k₂)) 1 ≺[m] Finsupp.single (emb (x k₁)) 1)
    {j : ℕ} (hj : j ≤ Nat.card S) {T : Finset S} (hT : T.card = j)
    (hne : T ≠ Finset.univ.image fun k : Fin j => x (Fin.castLE hj k)) :
    (∑ i ∈ T, Finsupp.single (emb i) 1) ≺[m]
      (∑ i ∈ Finset.univ.image fun k : Fin j => x (Fin.castLE hj k),
        Finsupp.single (emb i) 1) := by
  let _ : Fintype S := Fintype.ofFinite S
  let T0 : Finset S := Finset.univ.image fun k : Fin j => x (Fin.castLE hj k)
  have hT0_card : T0.card = j := by
    rw [Finset.card_image_of_injective _ (fun _ _ h => Fin.castLE_injective hj (x.injective h)),
      Finset.card_univ, Fintype.card_fin]
  let A := T \ T0
  let B := T0 \ T
  have hAB_card : A.card = B.card := by
    have h1 := Finset.card_inter_add_card_sdiff T T0
    have h2 := Finset.card_inter_add_card_sdiff T0 T
    rw [Finset.inter_comm] at h2; dsimp only [A, B]; omega
  have hA_nonempty : A.Nonempty := by
    by_contra hemp
    rw [Finset.not_nonempty_iff_eq_empty, Finset.sdiff_eq_empty_iff_subset] at hemp
    exact hne (Finset.eq_of_subset_of_card_le hemp (by rw [hT, hT0_card]))
  let φ : A ≃ B := Fintype.equivOfCardEq (by simp [hAB_card])
  have hT_eq : (T ∩ T0) ∪ A = T := by
    ext z; simp only [A, Finset.mem_union, Finset.mem_inter, Finset.mem_sdiff]; tauto
  have hT0_eq : (T0 ∩ T) ∪ B = T0 := by
    ext z; simp only [B, Finset.mem_union, Finset.mem_inter, Finset.mem_sdiff]; tauto
  have hdecomp1 : (∑ i ∈ T, Finsupp.single (emb i) 1) =
      (∑ i ∈ T ∩ T0, Finsupp.single (emb i) 1) + ∑ a ∈ A, Finsupp.single (emb a) 1 := by
    rw [← Finset.sum_union (disjoint_sdiff_self_right.mono_left Finset.inter_subset_right), hT_eq]
  have hdecomp2 : (∑ i ∈ T0, Finsupp.single (emb i) 1) =
      (∑ i ∈ T ∩ T0, Finsupp.single (emb i) 1) + ∑ b ∈ B, Finsupp.single (emb b) 1 := by
    rw [Finset.inter_comm,
      ← Finset.sum_union (disjoint_sdiff_self_right.mono_left Finset.inter_subset_right), hT0_eq]
  have hpair_lt : ∀ a : A, m.toSyn (Finsupp.single (emb a.1) 1) <
      m.toSyn (Finsupp.single (emb (φ a).1) 1) := by
    intro a
    have ha : ¬ ((x.symm a.1 : ℕ) < j) := fun hlt =>
      (Finset.mem_sdiff.mp a.2).2 (Finset.mem_image.mpr
        ⟨⟨x.symm a.1, hlt⟩, Finset.mem_univ _, x.apply_symm_apply _⟩)
    have hb : (x.symm (φ a).1 : ℕ) < j := by
      obtain ⟨k, -, hkx⟩ := Finset.mem_image.mp (Finset.mem_sdiff.mp (φ a).2).1
      rw [← hkx, x.symm_apply_apply]; exact k.isLt
    simpa only [Equiv.apply_symm_apply] using
      hx (Fin.lt_def.mpr (by omega) : x.symm (φ a).1 < x.symm a.1)
  -- Unfold `≺[m]` to `<` on `m.syn`.
  change m.toSyn (∑ i ∈ T, Finsupp.single (emb i) 1) <
    m.toSyn (∑ i ∈ T0, Finsupp.single (emb i) 1)
  rw [hdecomp1, hdecomp2, map_add, map_add]
  refine add_lt_add_of_le_of_lt le_rfl ?_
  have hsum_eq : ∑ b ∈ B, m.toSyn (Finsupp.single (emb b) 1) =
      ∑ a ∈ A.attach, m.toSyn (Finsupp.single (emb (φ a).1) 1) := by
    rw [← Finset.sum_attach B]
    exact (Equiv.sum_comp φ fun b : B => m.toSyn (Finsupp.single (emb b.1) 1)).symm
  rw [map_sum, map_sum, hsum_eq, ← Finset.sum_attach A]
  exact Finset.sum_lt_sum_of_nonempty (Finset.attach_nonempty_iff.mpr hA_nonempty)
    fun a _ => hpair_lt a

/-- Expansion, `m`-degree, and leading coefficient `1` for `blockEsymm G R o j` with respect to an
`m`-decreasing enumeration `e` of the orbit `o`. -/
private theorem degree_blockEsymm_and_coeff [Finite σ] (m : MonomialOrder σ)
    (G : Subgroup (Perm σ)) (R : Type*) [CommSemiring R] [Nontrivial R]
    (o : MulAction.orbitRel.Quotient G σ) (j : ℕ)
    (hj : j ≤ Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o})
    (x : Fin (Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}) ≃
      {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o})
    (hx : ∀ {k₁ k₂}, k₁ < k₂ →
      Finsupp.single (x k₂ : σ) 1 ≺[m] Finsupp.single (x k₁ : σ) 1) :
    m.degree (blockEsymm G R o j) =
      ∑ k : Fin j, Finsupp.single (x (Fin.castLE hj k) : σ) 1 ∧
      (blockEsymm G R o j).coeff
        (∑ k : Fin j, Finsupp.single (x (Fin.castLE hj k) : σ) 1) = 1 := by
  classical
  let _ : Fintype {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o} := Fintype.ofFinite _
  let S := {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}
  let emb : S ↪ σ := ⟨Subtype.val, Subtype.val_injective⟩
  let e : Finset S → (σ →₀ ℕ) := fun T => ∑ i ∈ T, Finsupp.single (emb i) 1
  have he_inj : Function.Injective e :=
    Finsupp.finsetSum_single_injective emb.injective fun _ => one_ne_zero
  have hsum : blockEsymm G R o j =
      ∑ T ∈ (Finset.univ : Finset S).powersetCard j, monomial (e T) (1 : R) := by
    rw [blockEsymm, esymm, map_sum]
    refine Finset.sum_congr rfl fun T _ => ?_
    -- Identify `MvPolynomial.X (emb i)` with `monomial (Finsupp.single (emb i) 1) 1`.
    simp only [map_prod, rename_X, e, monomial_sum_one]
    exact Finset.prod_congr rfl fun _ _ => rfl
  let T0 : Finset S := Finset.univ.image fun k : Fin j => x (Fin.castLE hj k)
  have hT0_inj : Function.Injective fun k : Fin j => x (Fin.castLE hj k) :=
    x.injective.comp (Fin.castLE_injective hj)
  have hT0_mem : T0 ∈ (Finset.univ : Finset S).powersetCard j :=
    Finset.mem_powersetCard.mpr ⟨Finset.subset_univ _, by
      rw [Finset.card_image_of_injective _ hT0_inj, Finset.card_univ, Fintype.card_fin]⟩
  have hcoeff_T0 : (blockEsymm G R o j).coeff (e T0) = 1 := by
    rw [hsum, coeff_sum]
    simp_rw [coeff_monomial, he_inj.eq_iff]
    rw [Finset.sum_ite_eq']
    simp [hT0_mem]
  have hdeg : m.degree (blockEsymm G R o j) = e T0 := by
    apply m.toSyn.injective
    refine le_antisymm (m.degree_le_iff.2 fun d hd => ?_) (m.le_degree <| by simp [hcoeff_T0])
    rw [hsum] at hd
    obtain ⟨T, hT, hdT⟩ := Finset.mem_biUnion.mp (support_sum hd)
    rw [Finset.mem_singleton.mp (support_monomial_subset hdT)]
    rcases eq_or_ne T T0 with rfl | hne
    · exact le_rfl
    · exact (sum_single_lt_topPrefix m emb x hx hj
        (Finset.mem_powersetCard.mp hT).2 hne).le
  have heT0 : e T0 = ∑ k : Fin j, Finsupp.single (x (Fin.castLE hj k) : σ) 1 :=
    Finset.sum_image fun _ _ _ _ h => hT0_inj h
  exact ⟨hdeg.trans heT0, heT0 ▸ hcoeff_T0⟩

/-- The `m`-degree of `blockEsymm G R o j` (`j ≤ |o|`) with respect to any `m`-decreasing
enumeration `e` of the orbit `o` is the sum of the `j` largest unit vectors. -/
theorem degree_blockEsymm [Finite σ] (m : MonomialOrder σ) (G : Subgroup (Perm σ))
    (R : Type*) [CommSemiring R] [Nontrivial R]
    (o : MulAction.orbitRel.Quotient G σ) (j : ℕ)
    (hj : j ≤ Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o})
    (e : Fin (Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}) ≃
      {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o})
    (he : ∀ {k₁ k₂}, k₁ < k₂ →
      Finsupp.single (e k₂ : σ) 1 ≺[m] Finsupp.single (e k₁ : σ) 1) :
    m.degree (blockEsymm G R o j) =
      ∑ k : Fin j, Finsupp.single (e (Fin.castLE hj k) : σ) 1 :=
  (degree_blockEsymm_and_coeff m G R o j hj e he).1

/-- A nontrivial block elementary symmetric polynomial `blockEsymm G R o j` (`j ≤ |o|`) is monic
for every monomial order `m`. -/
theorem leadingCoeff_blockEsymm [Finite σ] (m : MonomialOrder σ) (G : Subgroup (Perm σ))
    (R : Type*) [CommSemiring R] [Nontrivial R]
    (o : MulAction.orbitRel.Quotient G σ) (j : ℕ)
    (hj : j ≤ Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}) :
    m.leadingCoeff (blockEsymm G R o j) = 1 := by
  let S := {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}
  obtain ⟨x, hx⟩ := sortOrbitDesc m S ⟨Subtype.val, Subtype.val_injective⟩
  have h := degree_blockEsymm_and_coeff m G R o j hj x hx
  rw [leadingCoeff, h.1, h.2]

/-- The `m`-leading term of `blockEsymm G R o j` (`j ≤ |o|`) with respect to any `m`-decreasing
enumeration `e` of the orbit `o` is the monic product of its `j` largest variables. -/
theorem leadingTerm_blockEsymm [Finite σ] (m : MonomialOrder σ) (G : Subgroup (Perm σ))
    (R : Type*) [CommSemiring R] [Nontrivial R]
    (o : MulAction.orbitRel.Quotient G σ) (j : ℕ)
    (hj : j ≤ Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o})
    (e : Fin (Nat.card {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}) ≃
      {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o})
    (he : ∀ {k₁ k₂}, k₁ < k₂ →
      Finsupp.single (e k₂ : σ) 1 ≺[m] Finsupp.single (e k₁ : σ) 1) :
    m.leadingTerm (blockEsymm G R o j) =
      monomial (∑ k : Fin j, Finsupp.single (e (Fin.castLE hj k) : σ) 1) (1 : R) := by
  rw [leadingTerm, m.degree_blockEsymm G R o j hj e he, m.leadingCoeff_blockEsymm G R o j hj]

/-- If `d` is `m`-maximal in its `G`-orbit and `Equiv.swap a b ∈ G` with `X_a ≺_m X_b`, then
`d a ≤ d b`. -/
private theorem apply_le_of_swap_mem_of_mem_maxOrbitExponents [DecidableEq σ]
    (m : MonomialOrder σ) {G : Subgroup (Perm σ)} {d : σ →₀ ℕ}
    (hd : d ∈ m.maxOrbitExponents G) {a b : σ} (hswap : swap a b ∈ G)
    (hsingle : Finsupp.single a 1 ≺[m] Finsupp.single b 1) :
    d a ≤ d b := by
  by_contra hlt
  push Not at hlt
  let k : ℕ := d a - d b
  have hk : 0 < k := Nat.sub_pos_of_lt hlt
  have hab : a ≠ b := fun h => by rw [h] at hlt; exact lt_irrefl _ hlt
  have heq : d + k • Finsupp.single b 1 =
      d.equivMapDomain (swap a b) + k • Finsupp.single a 1 := by
    ext x
    simp only [Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, Finsupp.single_apply,
      Finsupp.equivMapDomain_apply, Equiv.symm_swap]
    by_cases hxa : x = a
    · subst hxa; simp [hab.symm, k]; omega
    · by_cases hxb : x = b
      · subst hxb; simp [hab, k]; omega
      · simp [swap_apply_of_ne_of_ne hxa hxb, Ne.symm hxa, Ne.symm hxb]
  have hstrict : m.toSyn (d.equivMapDomain (swap a b) + k • Finsupp.single a 1) <
      m.toSyn (d + k • Finsupp.single b 1) := by
    rw [map_add, map_add, map_nsmul, map_nsmul]
    exact add_lt_add_of_le_of_lt (hd (swap a b) hswap) (nsmul_lt_nsmul_right hk.ne' hsingle)
  exact (ne_of_lt hstrict) (congrArg m.toSyn heq.symm)

/-- On a single `G`-orbit `o`, any `m`-maximal exponent for a transposition-generated subgroup `G`
telescopes as a nonnegative integer combination of prefix sums of the sorted orbit variables. -/
private theorem orbit_part_monomial_mem_adjoin [Finite σ] [DecidableEq σ] (m : MonomialOrder σ)
    (G : Subgroup (Perm σ)) (R : Type*) [CommSemiring R] [Nontrivial R]
    (hG : Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} = G)
    {d : σ →₀ ℕ} (hd : d ∈ m.maxOrbitExponents G) (o : MulAction.orbitRel.Quotient G σ)
    (orb : Finset σ) (horb_mem : ∀ i : σ, i ∈ orb ↔ Quotient.mk (MulAction.orbitRel G σ) i = o) :
    monomial (∑ i ∈ orb, Finsupp.single i (d i)) (1 : R) ∈
      Algebra.adjoin R (m.leadingTerm '' blockEsymmSet G R) := by
  let S := {i : σ // Quotient.mk (MulAction.orbitRel G σ) i = o}
  let emb : S ↪ σ := ⟨Subtype.val, Subtype.val_injective⟩
  obtain ⟨x, hx⟩ := sortOrbitDesc m S emb
  have hanti : Antitone (fun k : Fin (Nat.card S) => d (x k : σ)) := fun k₁ k₂ hk => by
    rcases eq_or_lt_of_le hk with rfl | hlt
    · exact le_rfl
    · exact apply_le_of_swap_mem_of_mem_maxOrbitExponents m hd
        (G.swap_mem_of_orbitRel_of_closure_isSwap_eq hG
          (Quotient.exact ((x k₂).2.trans (x k₁).2.symm)))
        (hx hlt)
  obtain ⟨w, hw⟩ := Fin.antitone_eq_sum_filter_le (fun k => d (x k : σ)) hanti
  have hsum_eq :
      (∑ i ∈ orb, Finsupp.single i (d i)) =
      ∑ k : Fin (Nat.card S), w k • ∑ t : Fin ((k : ℕ) + 1),
        Finsupp.single (x (Fin.castLE (Nat.succ_le_of_lt k.isLt) t) : σ) 1 := by
    ext a
    simp only [Finsupp.finsetSum_apply, Finsupp.smul_apply, smul_eq_mul, Finsupp.single_apply,
      Finset.sum_ite_eq']
    by_cases ha : Quotient.mk (MulAction.orbitRel G σ) a = o
    · let t₀ : Fin (Nat.card S) := x.symm ⟨a, ha⟩
      have ha_eq : d a = d (x t₀ : σ) :=
        congrArg d (congrArg Subtype.val (x.apply_symm_apply ⟨a, ha⟩).symm)
      simp only [(horb_mem a).mpr ha, ↓reduceIte]
      rw [ha_eq, hw t₀]
      have hinner : ∀ k : Fin (Nat.card S),
          w k * (∑ t : Fin ((k : ℕ) + 1),
            if (x (Fin.castLE (Nat.succ_le_of_lt k.isLt) t) : σ) = a then 1 else 0) =
          if t₀ ≤ k then w k else 0 := fun k => by
        have hcond : ∀ t : Fin ((k : ℕ) + 1),
            ((x (Fin.castLE (Nat.succ_le_of_lt k.isLt) t) : σ) = a) ↔ (t : ℕ) = (t₀ : ℕ) :=
          fun t => ⟨fun h => congrArg Fin.val (x.injective (Subtype.ext (h.trans (by simp [t₀])))),
            fun h => by rw [(Fin.ext h : Fin.castLE _ t = t₀)]; simp [t₀]⟩
        simp_rw [hcond]
        split_ifs with hk
        · rw [Finset.sum_eq_single_of_mem ⟨t₀, Nat.lt_succ_of_le (Fin.le_def.mp hk)⟩
            (Finset.mem_univ _) fun b _ hb => by simp [mt Fin.ext hb]]
          simp
        · rw [Finset.sum_eq_zero fun t _ => by
            have hne : (t : ℕ) ≠ t₀ := by have := t.isLt; simp only [Fin.le_def] at hk; omega
            simp [hne], mul_zero]
      simp_rw [hinner, ← Finset.sum_filter]
    · simp only [mt (horb_mem a).mp ha, ↓reduceIte]
      symm
      exact Finset.sum_eq_zero fun k _ => mul_eq_zero_of_right _ (Finset.sum_eq_zero fun t _ => by
        have hne : (x (Fin.castLE (Nat.succ_le_of_lt k.isLt) t) : σ) ≠ a :=
          fun h => ha (h ▸ (x _).2)
        simp [hne])
  rw [hsum_eq, monomial_sum_one]
  refine Subalgebra.prod_mem _ fun k _ => ?_
  have hpow : monomial (w k • ∑ t : Fin ((k : ℕ) + 1),
        Finsupp.single (x (Fin.castLE (Nat.succ_le_of_lt k.isLt) t) : σ) 1) (1 : R) =
      (monomial (∑ t : Fin ((k : ℕ) + 1),
        Finsupp.single (x (Fin.castLE (Nat.succ_le_of_lt k.isLt) t) : σ) 1) (1 : R)) ^ w k := by
    rw [monomial_pow, one_pow]
  rw [hpow]
  refine Subalgebra.pow_mem _ ?_ _
  have hcard_le : (k : ℕ) + 1 ≤ Nat.card S := Nat.succ_le_of_lt k.isLt
  rw [← m.leadingTerm_blockEsymm G R o ((k : ℕ) + 1) hcard_le x hx]
  exact Algebra.subset_adjoin ⟨blockEsymm G R o ((k : ℕ) + 1),
    ⟨o, (k : ℕ) + 1, Nat.succ_pos _, hcard_le, rfl⟩, rfl⟩

/-- **Positive direction of the permutation SAGBI criterion.** If `G ≤ Equiv.Perm σ` is generated by
transpositions on a finite type `σ`, then for every monomial order `m` and every commutative
semiring `R`, the finite set `MvPolynomial.blockEsymmSet G R` of block elementary symmetric
polynomials is an `m`-SAGBI basis of `MvPolynomial.permInvariantSubalgebra G R`. -/
theorem isSAGBIBasis_blockEsymmSet [Finite σ] [DecidableEq σ] (m : MonomialOrder σ)
    (G : Subgroup (Perm σ)) (R : Type*) [CommSemiring R]
    (hG : Subgroup.closure {τ : Perm σ | τ ∈ G ∧ τ.IsSwap} = G) :
    m.IsSAGBIBasis (blockEsymmSet G R) (permInvariantSubalgebra G R) := by
  classical
  cases nonempty_fintype σ
  rw [isSAGBIBasis_iff_initialAlgebra_le]
  refine ⟨blockEsymmSet_subset_permInvariantSubalgebra G R, ?_⟩
  rcases subsingleton_or_nontrivial R with _ | _
  · intro p _; rw [Subsingleton.elim p 0]; exact zero_mem _
  rw [initialAlgebra_def, Algebra.adjoin_le_iff]
  rintro _ ⟨p, hp, rfl⟩
  rcases eq_or_ne p 0 with rfl | hp0
  · simp
  let d : σ →₀ ℕ := m.degree p
  have hd : d ∈ m.maxOrbitExponents G := fun g hg =>
    m.equivMapDomain_degree_le_of_mem_permInvariantSubalgebra hp hp0 hg
  let _ : Fintype (MulAction.orbitRel.Quotient G σ) := Fintype.ofFinite _
  let orb : MulAction.orbitRel.Quotient G σ → Finset σ :=
    fun o => Finset.univ.filter fun i : σ => Quotient.mk (MulAction.orbitRel G σ) i = o
  have horb_mem : ∀ o i, i ∈ orb o ↔ Quotient.mk (MulAction.orbitRel G σ) i = o :=
    fun _ _ => by simp [orb]
  have hd_eq : d = ∑ o : MulAction.orbitRel.Quotient G σ,
      ∑ i ∈ orb o, Finsupp.single i (d i) := by
    ext a
    simp only [Finsupp.finsetSum_apply, Finsupp.single_apply, Finset.sum_ite_eq']
    rw [Finset.sum_eq_single (Quotient.mk (MulAction.orbitRel G σ) a)]
    · simp [horb_mem]
    · intro o _ ho; simp [horb_mem, Ne.symm ho]
    · intro hnot; exact absurd (Finset.mem_univ _) hnot
  have hmon : monomial d (1 : R) ∈ Algebra.adjoin R (m.leadingTerm '' blockEsymmSet G R) := by
    rw [hd_eq, monomial_sum_one]
    exact Subalgebra.prod_mem _ fun o _ =>
      orbit_part_monomial_mem_adjoin m G R hG hd o (orb o) (horb_mem o)
  rw [leadingTerm, ← mul_one (m.leadingCoeff p), ← smul_eq_mul, ← smul_monomial]
  exact Subalgebra.smul_mem _ hmon _

end Positive

end MonomialOrder
